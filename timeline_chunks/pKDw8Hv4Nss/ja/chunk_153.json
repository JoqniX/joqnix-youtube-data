[{"type": "subtitle", "time": 9183.59, "timestamp": "02:33:03", "text": "。"}, {"type": "subtitle", "time": 9188.63, "timestamp": "02:33:08", "text": "私は死者を蘇らせた。 私たちは試合を終えた。"}, {"type": "subtitle", "time": 9192.95, "timestamp": "02:33:12", "text": "今回の走行は正式に終了しました。   何てことだ"}, {"type": "subtitle", "time": 9213.75, "timestamp": "02:33:33", "text": "。 俺は幸せだよ。 私は幸せです。 まさか自分が"}, {"type": "subtitle", "time": 9238.63, "timestamp": "02:33:58", "text": "捨てちゃおうかな"}]
[{"type": "subtitle", "time": 8884.55, "timestamp": "02:28:04", "text": "このゲーム、本当にやめたい。"}, {"type": "subtitle", "time": 8887.51, "timestamp": "02:28:07", "text": "レースでキスをやめたいよ、兄弟。   どうしたんだ"}, {"type": "subtitle", "time": 8892.63, "timestamp": "02:28:12", "text": "？ 何てことだ。"}, {"type": "subtitle", "time": 8901.67, "timestamp": "02:28:21", "text": "誰かと出会う唯一のチャンス。"}, {"type": "subtitle", "time": 8906.389, "timestamp": "02:28:26", "text": "ロープをなくしちゃったよ、兄弟。 ロープをなくしてしまった。"}, {"type": "subtitle", "time": 8910.309, "timestamp": "02:28:30", "text": "ロープをなくしてしまった。 ロープをなくしてしまった。"}, {"type": "subtitle", "time": 8913.03, "timestamp": "02:28:33", "text": "なぜ？ なぜ？"}, {"type": "subtitle", "time": 8925.51, "timestamp": "02:28:45", "text": "このパンは今にも飛び立ちそうだ"}, {"type": "subtitle", "time": 8927.51, "timestamp": "02:28:47", "text": "。"}]
[{"type": "subtitle", "time": 8532.63, "timestamp": "02:22:12", "text": "。 これで長々と続けることはできない"}, {"type": "subtitle", "time": 8537.51, "timestamp": "02:22:17", "text": "。 だから、できると思う。いや。ああ"}, {"type": "subtitle", "time": 8545.67, "timestamp": "02:22:25", "text": "、なんてこった"}, {"type": "subtitle", "time": 8549.59, "timestamp": "02:22:29", "text": "。 私はその人生で激しく叫んだ"}, {"type": "subtitle", "time": 8553.19, "timestamp": "02:22:33", "text": "。 ああ、なんてことだ、"}, {"type": "subtitle", "time": 8578.23, "timestamp": "02:22:58", "text": "俺は大声で叫んだよ、兄弟。   私は"}]
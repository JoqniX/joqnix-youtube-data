[{"type": "subtitle", "time": 16142.79, "timestamp": "04:29:02", "text": "キノコの産卵場所がすごく多い。 運が良ければ"}, {"type": "subtitle", "time": 16163.59, "timestamp": "04:29:23", "text": "ココナッツの件はやります。"}, {"type": "subtitle", "time": 16180.95, "timestamp": "04:29:40", "text": "2つで十分です。  1本燃やすだけでいいんだ。"}, {"type": "subtitle", "time": 16184.79, "timestamp": "04:29:44", "text": "右。 つまり、ココナッツ1個（"}, {"type": "subtitle", "time": 16189.189, "timestamp": "04:29:49", "text": "半分）を調理し、"}, {"type": "subtitle", "time": 16193.189, "timestamp": "04:29:53", "text": "黄色い冬ベリー1個を調理し、卵を調理し、"}, {"type": "subtitle", "time": 16197.51, "timestamp": "04:29:57", "text": "蜂蜜を調理した。"}]
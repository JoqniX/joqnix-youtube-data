[{"type": "subtitle", "time": 7749.589, "timestamp": "02:09:09", "text": "、じゃあ、知ってる？ そこに行く"}, {"type": "subtitle", "time": 7777.589, "timestamp": "02:09:37", "text": "さあ、皆さん、これが最後の追い込みです。"}, {"type": "subtitle", "time": 7781.669, "timestamp": "02:09:41", "text": "とにかく頂点に立つ必要がある。"}, {"type": "subtitle", "time": 7785.27, "timestamp": "02:09:45", "text": "これはこれまでで最も危険なことだろう"}]
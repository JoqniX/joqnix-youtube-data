[{"type": "subtitle", "time": 14600.55, "timestamp": "04:03:20", "text": "[音楽]"}, {"type": "subtitle", "time": 14602.63, "timestamp": "04:03:22", "text": "天然の"}, {"type": "subtitle", "time": 14606.07, "timestamp": "04:03:26", "text": "黄色いマシュマロの薬用カボチャの実"}, {"type": "subtitle", "time": 14609.75, "timestamp": "04:03:29", "text": "。 パープルキングベリーは美味しいです。"}, {"type": "subtitle", "time": 14611.91, "timestamp": "04:03:31", "text": "黄色は危険です。 緑色は危険だ。"}, {"type": "subtitle", "time": 14615.189, "timestamp": "04:03:35", "text": "黄色いバナナ。 バナナはどれも美味しい。 ピンク色は"}, {"type": "subtitle", "time": 14620.95, "timestamp": "04:03:40", "text": "大丈夫です。 青色も良いですね。"}, {"type": "subtitle", "time": 14623.429, "timestamp": "04:03:43", "text": "茶色くなったバナナも良いですよ。 厚みが保たれている限り、蜂の巣から作られる"}, {"type": "subtitle", "time": 14629.03, "timestamp": "04:03:49", "text": "。"}, {"type": "subtitle", "time": 14631.429, "timestamp": "04:03:51", "text": "毒ダメージは、"}, {"type": "subtitle", "time": 14636.229, "timestamp": "04:03:56", "text": "黄色いクラスター上に残っている限り継続する。 赤い実、オレンジ色、"}]
[{"type": "subtitle", "time": 15150.389, "timestamp": "04:12:30", "text": "。  ３、２、１。   バカバカバカバカ、バカ野郎"}, {"type": "subtitle", "time": 15166.95, "timestamp": "04:12:46", "text": "。   自分を"}, {"type": "subtitle", "time": 15170.389, "timestamp": "04:12:50", "text": "蹴り飛ばしたい。"}, {"type": "subtitle", "time": 15172.87, "timestamp": "04:12:52", "text": "私は生きている。 私は生きている。 わかった。 ちょっとまって。   ちょっとまって"}]
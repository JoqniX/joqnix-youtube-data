[{"type": "subtitle", "time": 9249.03, "timestamp": "02:34:09", "text": "ゲームをクリアしたなんて、信じられない"}, {"type": "subtitle", "time": 9255.349, "timestamp": "02:34:15", "text": "よし、行こう。"}, {"type": "subtitle", "time": 9257.27, "timestamp": "02:34:17", "text": "１、２、３、４"}, {"type": "subtitle", "time": 9269.67, "timestamp": "02:34:29", "text": "5"}, {"type": "subtitle", "time": 9272.07, "timestamp": "02:34:32", "text": "6"}, {"type": "subtitle", "time": 9286.07, "timestamp": "02:34:46", "text": "よし、ゲームは終わったぞ、みんな。 さあ行こう"}, {"type": "subtitle", "time": 9288.23, "timestamp": "02:34:48", "text": "。   やったよ"}, {"type": "subtitle", "time": 9297.83, "timestamp": "02:34:57", "text": "ついに。   何てことだ"}]
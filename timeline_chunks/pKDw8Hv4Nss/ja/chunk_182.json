[{"type": "subtitle", "time": 10936.55, "timestamp": "03:02:16", "text": "つまり、加工食品を一切口にせずにアイルランドから脱出するということだ"}, {"type": "subtitle", "time": 10939.269, "timestamp": "03:02:19", "text": "。 私たちはそんなことはしていません。 えっと、"}, {"type": "subtitle", "time": 10942.15, "timestamp": "03:02:22", "text": "ハチの巣、黄色い冬のベリー、それから"}, {"type": "subtitle", "time": 10945.59, "timestamp": "03:02:25", "text": "卵。 わかった。 えっと、一度の探検で無毒のキノコを4つ食べてください"}, {"type": "subtitle", "time": 10948.07, "timestamp": "03:02:28", "text": "。"}, {"type": "subtitle", "time": 10950.71, "timestamp": "03:02:30", "text": "無毒のキノコ。 どれが"}, {"type": "subtitle", "time": 10968.79, "timestamp": "03:02:48", "text": "ええと、もしロープを手に入れたら、"}]
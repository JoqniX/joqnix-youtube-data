[{"type": "subtitle", "time": 18182.23, "timestamp": "05:03:02", "text": "[音楽]"}, {"type": "subtitle", "time": 18189.03, "timestamp": "05:03:09", "text": "いいね。3つ手に入れた"}, {"type": "subtitle", "time": 18192.39, "timestamp": "05:03:12", "text": "。いいね。あと"}, {"type": "subtitle", "time": 18197.75, "timestamp": "05:03:17", "text": "3つ、4つ、5つ。"}, {"type": "subtitle", "time": 18214.55, "timestamp": "05:03:34", "text": "待って、あれを持ってなかったっけ？ ちょっと待って。"}, {"type": "subtitle", "time": 18227.59, "timestamp": "05:03:47", "text": "エネルギーリングを取っておこう。"}, {"type": "subtitle", "time": 18236.628, "timestamp": "05:03:56", "text": "地面に触れずに50メートル登るのを終わらせなきゃいけないよね？"}]
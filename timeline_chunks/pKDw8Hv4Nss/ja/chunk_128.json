[{"type": "subtitle", "time": 7695.91, "timestamp": "02:08:15", "text": "問題は、そこにロリポップが3つあるってことなんです"}, {"type": "subtitle", "time": 7700.629, "timestamp": "02:08:20", "text": "そこが問題なんです。 棒付きキャンディーが3つあります"}, {"type": "subtitle", "time": 7702.39, "timestamp": "02:08:22", "text": "。"}, {"type": "subtitle", "time": 7704.79, "timestamp": "02:08:24", "text": "問題は、私も自分の"}, {"type": "subtitle", "time": 7707.51, "timestamp": "02:08:27", "text": "ユーティリティを使わなければならないということです。"}, {"type": "subtitle", "time": 7710.87, "timestamp": "02:08:30", "text": "ええと、3つあるんですが、"}, {"type": "subtitle", "time": 7713.91, "timestamp": "02:08:33", "text": "収納スペースが足りません。"}, {"type": "subtitle", "time": 7719.75, "timestamp": "02:08:39", "text": "でもこれを使うとまた酔っ払ってしまう。"}]
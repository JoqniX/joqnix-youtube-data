[{"type": "subtitle", "time": 9304.15, "timestamp": "02:35:04", "text": "。  1時間57分かかりました。"}, {"type": "subtitle", "time": 9309.75, "timestamp": "02:35:09", "text": "言わないでくれよ、兄弟。"}, {"type": "subtitle", "time": 9314.71, "timestamp": "02:35:14", "text": "私が何度も死んだという事実。"}, {"type": "subtitle", "time": 9317.03, "timestamp": "02:35:17", "text": "新しいバッジを手に入れました。 この有毒物質は何ですか？ ねえ"}, {"type": "subtitle", "time": 9318.71, "timestamp": "02:35:18", "text": "、"}, {"type": "subtitle", "time": 9322.07, "timestamp": "02:35:22", "text": "新しい帽子を手に入れたんだよ。 食品。"}, {"type": "subtitle", "time": 9326.55, "timestamp": "02:35:26", "text": "私たちは登山パスを手に入れました。 私たちはその"}, {"type": "subtitle", "time": 9330.63, "timestamp": "02:35:30", "text": "荷物を受け取りました。 お、新しい帽子だ。 ニース。 それは手に入れた"}, {"type": "subtitle", "time": 9332.469, "timestamp": "02:35:32", "text": "。   大丈夫、できるよ"}, {"type": "subtitle", "time": 9335.11, "timestamp": "02:35:35", "text": "。"}, {"type": "subtitle", "time": 9338.87, "timestamp": "02:35:38", "text": "私たちはあのスカウト帽を手に入れた。"}, {"type": "subtitle", "time": 9342.07, "timestamp": "02:35:42", "text": "私たちは狼の耳を手に入れた。   それは手に入れた"}, {"type": "subtitle", "time": 9347.11, "timestamp": "02:35:47", "text": "。 バッジの数が"}]
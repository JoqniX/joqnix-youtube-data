[{"type": "subtitle", "time": 14600.55, "timestamp": "04:03:20", "text": "[音乐]"}, {"type": "subtitle", "time": 14602.63, "timestamp": "04:03:22", "text": "天然"}, {"type": "subtitle", "time": 14606.07, "timestamp": "04:03:26", "text": "黄色药用南瓜"}, {"type": "subtitle", "time": 14609.75, "timestamp": "04:03:29", "text": "浆果。 紫王莓很好。"}, {"type": "subtitle", "time": 14611.91, "timestamp": "04:03:31", "text": "黄色很危险。 绿色很危险。"}, {"type": "subtitle", "time": 14615.189, "timestamp": "04:03:35", "text": "黄香蕉。 香蕉味很浓。 粉色也"}, {"type": "subtitle", "time": 14620.95, "timestamp": "04:03:40", "text": "可以。 蓝色也不错。"}, {"type": "subtitle", "time": 14623.429, "timestamp": "04:03:43", "text": "熟透的香蕉也很好。"}, {"type": "subtitle", "time": 14629.03, "timestamp": "04:03:49", "text": "只要蜂巢保持厚实，就可以用蜂巢制成。"}, {"type": "subtitle", "time": 14631.429, "timestamp": "04:03:51", "text": "只要毒素伤害还在黄色光环上，就持续造成毒素伤害"}, {"type": "subtitle", "time": 14636.229, "timestamp": "04:03:56", "text": "。 红莓、橙莓、"}]
[{"type": "subtitle", "time": 13440.469, "timestamp": "03:44:00", "text": "完整攀登。 好的。 开放 15 层，"}, {"type": "subtitle", "time": 13443.349, "timestamp": "03:44:03", "text": "单次运行。 我其实已经有这"}, {"type": "subtitle", "time": 13448.87, "timestamp": "03:44:08", "text": "本书了。 好的。 这是什么？ 阅读所有"}, {"type": "subtitle", "time": 13451.83, "timestamp": "03:44:11", "text": "侦察兵比赛大师的说明，"}, {"type": "subtitle", "time": 13454.79, "timestamp": "03:44:14", "text": "呃，他们有一个固定的重生点。 如果当天没有怪物刷新"}, {"type": "subtitle", "time": 13456.07, "timestamp": "03:44:16", "text": "，你只能"}, {"type": "subtitle", "time": 13457.99, "timestamp": "03:44:17", "text": "第二天再来看看了。 如果你在岸边找到一卷卷轴"}, {"type": "subtitle", "time": 13461.51, "timestamp": "03:44:21", "text": "，但需要第八页（"}, {"type": "subtitle", "time": 13464.15, "timestamp": "03:44:24", "text": "只能在卡莱利亚获得），请在卡莱利亚地图上等待"}, {"type": "subtitle", "time": 13465.99, "timestamp": "03:44:25", "text": "它打开"}, {"type": "subtitle", "time": 13469.91, "timestamp": "03:44:29", "text": "。 海岸、热带、高山，"}, {"type": "subtitle", "time": 13472.79, "timestamp": "03:44:32", "text": "第一页。 任何地图、蘑菇、篝火、"}, {"type": "subtitle", "time": 13475.11, "timestamp": "03:44:35", "text": "神秘学。"}, {"type": "subtitle", "time": 13478.79, "timestamp": "03:44:38", "text": "好的。 左钢琴滚动零度。"}, {"type": "subtitle", "time": 13482.389, "timestamp": "03:44:42", "text": "哦，哇。 我们必须把这些都读完。"}, {"type": "subtitle", "time": 13485.349, "timestamp": "03:44:45", "text": "耐力带向上移动。 使用"}, {"type": "subtitle", "time": 13489.75, "timestamp": "03:44:49", "text": "能量环、棒棒糖、活塞、绳索"}, {"type": "subtitle", "time": 13492.07, "timestamp": "03:44:52", "text": "卷轴、大炮将有助于你实现"}, {"type": "subtitle", "time": 13495.51, "timestamp": "03:44:55", "text": "这一目标。 忍者。 哦好的。"}, {"type": "subtitle", "time": 13499.99, "timestamp": "03:44:59", "text": "那是你的头带。 迪奥忍者。"}]
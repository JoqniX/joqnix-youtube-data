[{"type": "subtitle", "time": 9183.59, "timestamp": "02:33:03", "text": "我的天啊。"}, {"type": "subtitle", "time": 9188.63, "timestamp": "02:33:08", "text": "我使死人复活。 游戏结束了。"}, {"type": "subtitle", "time": 9192.95, "timestamp": "02:33:12", "text": "我们已经正式结束了这次跑步。"}, {"type": "subtitle", "time": 9213.75, "timestamp": "02:33:33", "text": "我的天啊。 我很高兴，伙计。 我很高兴。 我"}, {"type": "subtitle", "time": 9217.03, "timestamp": "02:33:37", "text": "没想到"}, {"type": "subtitle", "time": 9220.63, "timestamp": "02:33:40", "text": "我能"}, {"type": "subtitle", "time": 9238.63, "timestamp": "02:33:58", "text": "让我把所有不需要的东西都扔掉吧"}]
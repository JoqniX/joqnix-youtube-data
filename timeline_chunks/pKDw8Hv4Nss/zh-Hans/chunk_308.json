[{"type": "subtitle", "time": 18480.31, "timestamp": "05:08:00", "text": "对吧？我很高兴，说实话，我以为"}, {"type": "subtitle", "time": 18482.948, "timestamp": "05:08:02", "text": "我要花12个小时才能完成，但"}, {"type": "subtitle", "time": 18485.35, "timestamp": "05:08:05", "text": "没想到第一次就成功了。"}, {"type": "subtitle", "time": 18488.55, "timestamp": "05:08:08", "text": "第一次，不，是第三次，真的。我死了"}, {"type": "subtitle", "time": 18493.35, "timestamp": "05:08:13", "text": "两次，但第三次，我"}, {"type": "subtitle", "time": 18498.47, "timestamp": "05:08:18", "text": "竟然一次就成功了。简直不可思议，对吧"}, {"type": "subtitle", "time": 18500.07, "timestamp": "05:08:20", "text": "？"}, {"type": "subtitle", "time": 18502.47, "timestamp": "05:08:22", "text": "是的。我们还稍微刷了一下人类"}, {"type": "subtitle", "time": 18504.15, "timestamp": "05:08:24", "text": "。不错"}, {"type": "subtitle", "time": 18514.39, "timestamp": "05:08:34", "text": "我真的很高兴你。耶。"}, {"type": "subtitle", "time": 18517.11, "timestamp": "05:08:37", "text": "好好休息。谢谢。给我们一个"}, {"type": "subtitle", "time": 18519.5, "timestamp": "05:08:39", "text": "机会。"}]
[{"type": "subtitle", "time": 9304.15, "timestamp": "02:35:04", "text": "我的天啊。 我花了1小时57分钟。"}, {"type": "subtitle", "time": 9309.75, "timestamp": "02:35:09", "text": "别说了，兄弟。"}, {"type": "subtitle", "time": 9314.71, "timestamp": "02:35:14", "text": "我死了那么多次。 我们拿到了"}, {"type": "subtitle", "time": 9317.03, "timestamp": "02:35:17", "text": "新的徽章。 这是什么有毒物质？ 你"}, {"type": "subtitle", "time": 9318.71, "timestamp": "02:35:18", "text": "知道吗，"}, {"type": "subtitle", "time": 9322.07, "timestamp": "02:35:22", "text": "我们买了一顶新帽子。 食物。"}, {"type": "subtitle", "time": 9326.55, "timestamp": "02:35:26", "text": "我们拿到了登山通行证。 我们拿到"}, {"type": "subtitle", "time": 9330.63, "timestamp": "02:35:30", "text": "行李了。 哦，新帽子。 好的。 我们搞定了"}, {"type": "subtitle", "time": 9332.469, "timestamp": "02:35:32", "text": "。"}, {"type": "subtitle", "time": 9335.11, "timestamp": "02:35:35", "text": "我们能搞定。"}, {"type": "subtitle", "time": 9338.87, "timestamp": "02:35:38", "text": "我们弄到了那顶童子军帽子。"}, {"type": "subtitle", "time": 9342.07, "timestamp": "02:35:42", "text": "我们长了狼耳朵。"}, {"type": "subtitle", "time": 9347.11, "timestamp": "02:35:47", "text": "我们搞定了。 徽章的数量简直太"}]
[{"type": "subtitle", "time": 8532.63, "timestamp": "02:22:12", "text": "好的。 我不能在"}, {"type": "subtitle", "time": 8537.51, "timestamp": "02:22:17", "text": "这件事上走太远。 所以，我觉得我可以"}, {"type": "subtitle", "time": 8545.67, "timestamp": "02:22:25", "text": "不，我的天哪，"}, {"type": "subtitle", "time": 8549.59, "timestamp": "02:22:29", "text": "兄弟。 那段日子里，我拼命呐喊"}, {"type": "subtitle", "time": 8553.19, "timestamp": "02:22:33", "text": "。 我的天哪，"}, {"type": "subtitle", "time": 8578.23, "timestamp": "02:22:58", "text": "兄弟，我当时叫得很大声。"}]
[{"type": "subtitle", "time": 13383.429, "timestamp": "03:43:03", "text": "绳索。 绳索。 绳索。 绳索。 绳索。 绳索。   在"}, {"type": "subtitle", "time": 13385.429, "timestamp": "03:43:05", "text": "不失去意识的情况下逃离这座岛屿"}, {"type": "subtitle", "time": 13388.95, "timestamp": "03:43:08", "text": "。 这是我做的。"}, {"type": "subtitle", "time": 13392.309, "timestamp": "03:43:12", "text": "爬到那棵参天大树的顶端。 我"}, {"type": "subtitle", "time": 13394.55, "timestamp": "03:43:14", "text": "不知道是哪棵树，但我需要那个"}, {"type": "subtitle", "time": 13398.79, "timestamp": "03:43:18", "text": "写实的人。 至少爬升20米。"}, {"type": "subtitle", "time": 13403.269, "timestamp": "03:43:23", "text": "呃，必须是东道主才能实现目标，等"}, {"type": "subtitle", "time": 13406.87, "timestamp": "03:43:26", "text": "他来指导你。 好的。"}, {"type": "subtitle", "time": 13410.07, "timestamp": "03:43:30", "text": "倒置的眼睛。 好的。"}, {"type": "subtitle", "time": 13412.95, "timestamp": "03:43:32", "text": "部署或部署100门反绳索"}, {"type": "subtitle", "time": 13415.83, "timestamp": "03:43:35", "text": "炮。 计入总数。"}, {"type": "subtitle", "time": 13419.59, "timestamp": "03:43:39", "text": "需要八个绳轴才能完成。"}, {"type": "subtitle", "time": 13422.87, "timestamp": "03:43:42", "text": "彩虹蝴蝶结。 好的。"}, {"type": "subtitle", "time": 13426.71, "timestamp": "03:43:46", "text": "爬升次数少于三次。"}, {"type": "subtitle", "time": 13430.63, "timestamp": "03:43:50", "text": "海拔50000米，间隔5000米，"}, {"type": "subtitle", "time": 13436.07, "timestamp": "03:43:56", "text": "不到三次"}]
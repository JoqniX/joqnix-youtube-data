[{"type": "subtitle", "time": 16142.79, "timestamp": "04:29:02", "text": "这里有很多蘑菇苗。 如果我"}, {"type": "subtitle", "time": 16163.59, "timestamp": "04:29:23", "text": "我们需要吗？我们会做椰子那件事。"}, {"type": "subtitle", "time": 16180.95, "timestamp": "04:29:40", "text": "两个就够了。 我只需要烧掉一个。"}, {"type": "subtitle", "time": 16184.79, "timestamp": "04:29:44", "text": "正确的。 所以，一个椰子，"}, {"type": "subtitle", "time": 16189.189, "timestamp": "04:29:49", "text": "半个椰子煮熟，一个"}, {"type": "subtitle", "time": 16193.189, "timestamp": "04:29:53", "text": "黄冬豆煮熟，一个鸡蛋煮熟，"}, {"type": "subtitle", "time": 16197.51, "timestamp": "04:29:57", "text": "蜂蜜煮熟。"}]
[{"type": "subtitle", "time": 9662.87, "timestamp": "02:41:02", "text": "我居然真的得到了那个仙女玩意儿，而且"}, {"type": "subtitle", "time": 9665.27, "timestamp": "02:41:05", "text": "还真的做了那件事，这简直太疯狂了。"}, {"type": "subtitle", "time": 9674.15, "timestamp": "02:41:14", "text": "。 我觉得我玩不了那种"}, {"type": "subtitle", "time": 9676.55, "timestamp": "02:41:16", "text": "逃离岛屿的游戏，"}, {"type": "subtitle", "time": 9680.87, "timestamp": "02:41:20", "text": "但我可以玩那种……"}, {"type": "subtitle", "time": 9684.71, "timestamp": "02:41:24", "text": "嗯，叫什么来着？"}, {"type": "subtitle", "time": 9686.469, "timestamp": "02:41:26", "text": "做完饭吃完一半后逃离小岛"}, {"type": "subtitle", "time": 9689.59, "timestamp": "02:41:29", "text": "。 太疯狂了。"}, {"type": "subtitle", "time": 9699.27, "timestamp": "02:41:39", "text": "一种黄色冬浆果和一枚鸡蛋，我就能做到这件事了。"}, {"type": "subtitle", "time": 9701.99, "timestamp": "02:41:41", "text": "20."}, {"type": "subtitle", "time": 9706.15, "timestamp": "02:41:46", "text": "我想我们可以做些除虫的事，"}]
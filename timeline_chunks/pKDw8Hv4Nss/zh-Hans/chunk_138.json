[{"type": "subtitle", "time": 8280.309, "timestamp": "02:18:00", "text": "哦不，我会死的。 我会死。 我会死。"}, {"type": "subtitle", "time": 8282.95, "timestamp": "02:18:02", "text": "我会死。 我会死。 我会死。"}, {"type": "subtitle", "time": 8285.91, "timestamp": "02:18:05", "text": "不，不，不，不，不，不。"}, {"type": "subtitle", "time": 8288.87, "timestamp": "02:18:08", "text": "重试。 重试。"}, {"type": "subtitle", "time": 8294.629, "timestamp": "02:18:14", "text": "音乐人，"}, {"type": "subtitle", "time": 8305.19, "timestamp": "02:18:25", "text": "好的，让我等一下生命值"}, {"type": "subtitle", "time": 8313.27, "timestamp": "02:18:33", "text": "等等，医生，你为什么？你在"}, {"type": "subtitle", "time": 8317.669, "timestamp": "02:18:37", "text": "做什么？ 你完全可以"}, {"type": "subtitle", "time": 8321.509, "timestamp": "02:18:41", "text": "等。 我刚刚意识到"}, {"type": "subtitle", "time": 8337.19, "timestamp": "02:18:57", "text": "我的天哪，我忘了我可以从这里溜出去"}]
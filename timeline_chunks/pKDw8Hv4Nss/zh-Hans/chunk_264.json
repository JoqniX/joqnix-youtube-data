[{"type": "subtitle", "time": 15846.389, "timestamp": "04:24:06", "text": "为什么一定要不能吃呢？ 给我"}, {"type": "subtitle", "time": 15849.75, "timestamp": "04:24:09", "text": "可食用的蘑菇吧。 那是"}, {"type": "subtitle", "time": 15854.71, "timestamp": "04:24:14", "text": "我唯一想要的。 一个就够了。"}, {"type": "subtitle", "time": 15856.55, "timestamp": "04:24:16", "text": "好的，下面有一些。 我要下去看看"}, {"type": "subtitle", "time": 15859.67, "timestamp": "04:24:19", "text": "。 主啊，求求你叫我"}, {"type": "subtitle", "time": 15884.149, "timestamp": "04:24:44", "text": "岩石炮。 耶。   是的"}]
[{"type": "subtitle", "time": 17286.708, "timestamp": "04:48:06", "text": "一、二、三。"}, {"type": "subtitle", "time": 17307.99, "timestamp": "04:48:27", "text": "你做完之后，我就去睡觉。"}, {"type": "subtitle", "time": 17310.47, "timestamp": "04:48:30", "text": "检查。嗨。嗨。嗨。"}, {"type": "subtitle", "time": 17321.43, "timestamp": "04:48:41", "text": "我刚刚意识到我没有录制"}]
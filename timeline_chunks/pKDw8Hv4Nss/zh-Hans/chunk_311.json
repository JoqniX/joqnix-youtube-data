[{"type": "subtitle", "time": 18661.99, "timestamp": "05:11:01", "text": "今天就这些了。我要睡觉了。"}, {"type": "subtitle", "time": 18664.628, "timestamp": "05:11:04", "text": "我要看《超人》或者《"}, {"type": "subtitle", "time": 18667.51, "timestamp": "05:11:07", "text": "睡魔》之类的。"}, {"type": "subtitle", "time": 18669.99, "timestamp": "05:11:09", "text": "我得从第二集开始看。我就"}, {"type": "subtitle", "time": 18675.11, "timestamp": "05:11:15", "text": "放着它去睡觉。"}, {"type": "subtitle", "time": 18677.83, "timestamp": "05:11:17", "text": "嗨。好了，晚安各位。谢谢大家"}, {"type": "subtitle", "time": 18679.83, "timestamp": "05:11:19", "text": "今天的陪伴。"}]
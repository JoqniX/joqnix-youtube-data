[{"type": "subtitle", "time": 10936.55, "timestamp": "03:02:16", "text": "所以，逃离爱尔兰的时候不要吃任何"}, {"type": "subtitle", "time": 10939.269, "timestamp": "03:02:19", "text": "包装食品。 我们没有做那件事。 呃，"}, {"type": "subtitle", "time": 10942.15, "timestamp": "03:02:22", "text": "蜂巢、黄色冬浆果和"}, {"type": "subtitle", "time": 10945.59, "timestamp": "03:02:25", "text": "鸡蛋。 好的。 呃，一次探险吃掉四朵无毒"}, {"type": "subtitle", "time": 10948.07, "timestamp": "03:02:28", "text": "蘑菇。"}, {"type": "subtitle", "time": 10950.71, "timestamp": "03:02:30", "text": "无毒蘑菇。 我如何判断哪些"}, {"type": "subtitle", "time": 10968.79, "timestamp": "03:02:48", "text": "嗯，如果我能弄到绳子，我就得挑战一下"}]
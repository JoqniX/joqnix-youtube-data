[{"type": "subtitle", "time": 9542.55, "timestamp": "02:39:02", "text": "不吃任何包装食品，逃离这座岛屿。"}, {"type": "subtitle", "time": 9545.11, "timestamp": "02:39:05", "text": "烹饪并吃掉"}, {"type": "subtitle", "time": 9547.99, "timestamp": "02:39:07", "text": "半个椰子、一个蜂巢、一只黄色"}, {"type": "subtitle", "time": 9550.309, "timestamp": "02:39:10", "text": "冬兔和一个鸡蛋后，逃离这座岛屿。 哦，对了，我们"}, {"type": "subtitle", "time": 9552.55, "timestamp": "02:39:12", "text": "没从熔岩盘里得到鸡蛋，"}, {"type": "subtitle", "time": 9555.429, "timestamp": "02:39:15", "text": "对吧？ 我一个也没找到。 吃四种"}, {"type": "subtitle", "time": 9558.23, "timestamp": "02:39:18", "text": "不同的无毒蘑菇。 单次"}, {"type": "subtitle", "time": 9560.79, "timestamp": "02:39:20", "text": "探险。 在不失去意识的情况下逃离这座岛屿"}, {"type": "subtitle", "time": 9563.75, "timestamp": "02:39:23", "text": "。"}, {"type": "subtitle", "time": 9566.79, "timestamp": "02:39:26", "text": "在篝火上烹制 20 顿饭。"}, {"type": "subtitle", "time": 9571.83, "timestamp": "02:39:31", "text": "从篝火中获得5点额外的集结增益"}, {"type": "subtitle", "time": 9578.389, "timestamp": "02:39:38", "text": "放置10个活塞。 伸手到一块"}, {"type": "subtitle", "time": 9581.429, "timestamp": "02:39:41", "text": "非常硬的砖头三的顶端。"}, {"type": "subtitle", "time": 9583.67, "timestamp": "02:39:43", "text": "哦，这三个。 我们和"}, {"type": "subtitle", "time": 9585.59, "timestamp": "02:39:45", "text": "童子军领队有一对一的谈话。 哦，是的，我们确实"}, {"type": "subtitle", "time": 9592.469, "timestamp": "02:39:52", "text": "一次性压紧100米长的绳索"}, {"type": "subtitle", "time": 9594.79, "timestamp": "02:39:54", "text": "。"}, {"type": "subtitle", "time": 9598.87, "timestamp": "02:39:58", "text": "总共攀登 5000 米。"}]
[{"type": "subtitle", "time": 8884.55, "timestamp": "02:28:04", "text": "我真的好想退出这个游戏。"}, {"type": "subtitle", "time": 8887.51, "timestamp": "02:28:07", "text": "兄弟，我太想停止接吻了。"}, {"type": "subtitle", "time": 8892.63, "timestamp": "02:28:12", "text": "你怎么了？ 我的天啊。"}, {"type": "subtitle", "time": 8901.67, "timestamp": "02:28:21", "text": "你唯一的机会。"}, {"type": "subtitle", "time": 8906.389, "timestamp": "02:28:26", "text": "兄弟，绳子丢了。 绳子丢了。"}, {"type": "subtitle", "time": 8910.319, "timestamp": "02:28:30", "text": "绳子丢了。 绳子丢了。 为什么？ 为什么？"}, {"type": "subtitle", "time": 8913.04, "timestamp": "02:28:33", "text": "为什么？ 为什么？ 为什么？"}, {"type": "subtitle", "time": 8925.51, "timestamp": "02:28:45", "text": "这面包现在恨不得"}, {"type": "subtitle", "time": 8927.51, "timestamp": "02:28:47", "text": "飞走。"}]
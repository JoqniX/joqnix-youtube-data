[{"type": "subtitle", "time": 9601.75, "timestamp": "02:40:01", "text": "阅读所有童子军领队的日志"}, {"type": "subtitle", "time": 9603.27, "timestamp": "02:40:03", "text": "条目。"}, {"type": "subtitle", "time": 9605.83, "timestamp": "02:40:05", "text": "向上攀爬50米，脚不沾"}, {"type": "subtitle", "time": 9611.83, "timestamp": "02:40:11", "text": "H"}, {"type": "subtitle", "time": 9618.23, "timestamp": "02:40:18", "text": "逃离了岛屿，没有"}, {"type": "subtitle", "time": 9621.11, "timestamp": "02:40:21", "text": "在山上留下任何东西。   在"}, {"type": "subtitle", "time": 9622.87, "timestamp": "02:40:22", "text": "不受到坠落伤害的情况下逃离小岛"}, {"type": "subtitle", "time": 9625.51, "timestamp": "02:40:25", "text": "。 一次复活了三名侦察兵"}, {"type": "subtitle", "time": 9628.87, "timestamp": "02:40:28", "text": "。 好的。"}, {"type": "subtitle", "time": 9632.79, "timestamp": "02:40:32", "text": "该死。 所以，我们完成了很多事情，都是些"}, {"type": "subtitle", "time": 9635.27, "timestamp": "02:40:35", "text": "基础性的工作。"}, {"type": "subtitle", "time": 9639.83, "timestamp": "02:40:39", "text": "呃，还能为你的朋友恢复100点生命值。"}, {"type": "subtitle", "time": 9644.07, "timestamp": "02:40:44", "text": "我们使用道具恢复了总共 20 万点毒素值"}, {"type": "subtitle", "time": 9646.23, "timestamp": "02:40:46", "text": "。 我居然"}, {"type": "subtitle", "time": 9651.59, "timestamp": "02:40:51", "text": "完成了，真是不可思议。 浆果也很好，可以"}, {"type": "subtitle", "time": 9656.55, "timestamp": "02:40:56", "text": "治疗，小心谨慎地用物品"}, {"type": "subtitle", "time": 9659.19, "timestamp": "02:40:59", "text": "保护朋友免受伤害。"}]
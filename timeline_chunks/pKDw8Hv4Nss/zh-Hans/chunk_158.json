[{"type": "subtitle", "time": 9481.99, "timestamp": "02:38:01", "text": "飞行员款太阳镜。 这个、这个，还有这个。"}, {"type": "subtitle", "time": 9504.79, "timestamp": "02:38:24", "text": "哇。 哇。 哇。"}, {"type": "subtitle", "time": 9512.389, "timestamp": "02:38:32", "text": "如果我看看自己，我有"}, {"type": "subtitle", "time": 9515.27, "timestamp": "02:38:35", "text": "1、2、3、4。"}, {"type": "subtitle", "time": 9518.389, "timestamp": "02:38:38", "text": "我拥有相当数量的徽章。"}, {"type": "subtitle", "time": 9531.99, "timestamp": "02:38:51", "text": "，我们有这个。 让朋友"}, {"type": "subtitle", "time": 9534.469, "timestamp": "02:38:54", "text": "独自逃离这座岛屿。 这是其中"}, {"type": "subtitle", "time": 9537.91, "timestamp": "02:38:57", "text": "之一。 不到一小时就能逃离这座岛屿。"}, {"type": "subtitle", "time": 9539.91, "timestamp": "02:38:59", "text": "我做不到。"}]
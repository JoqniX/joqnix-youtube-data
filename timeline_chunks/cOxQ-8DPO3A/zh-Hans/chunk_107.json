[{"type": "subtitle", "time": 6423.669, "timestamp": "01:47:03", "text": "对，抓住他。 抓住他。 拿到"}, {"type": "subtitle", "time": 6424.55, "timestamp": "01:47:04", "text": "戒指。"}, {"type": "subtitle", "time": 6426.629, "timestamp": "01:47:06", "text": "制胜之道。 他获胜的几率太小了。"}, {"type": "subtitle", "time": 6435.51, "timestamp": "01:47:15", "text": "。 兄弟，你得保护好你的治疗者"}, {"type": "subtitle", "time": 6445.03, "timestamp": "01:47:25", "text": "亚当这边。 杀了他。 抓住他。 杀了"}, {"type": "subtitle", "time": 6446.79, "timestamp": "01:47:26", "text": "他。"}, {"type": "subtitle", "time": 6448.95, "timestamp": "01:47:28", "text": "好的。"}, {"type": "subtitle", "time": 6450.55, "timestamp": "01:47:30", "text": "回来。 来。 你不需要做到"}, {"type": "subtitle", "time": 6452.07, "timestamp": "01:47:32", "text": "那种程度。 他不像有些人那样会撞到"}, {"type": "subtitle", "time": 6453.43, "timestamp": "01:47:33", "text": "人。 这不是大逃杀游戏。 回来吧"}, {"type": "subtitle", "time": 6455.109, "timestamp": "01:47:35", "text": "，"}, {"type": "subtitle", "time": 6466.47, "timestamp": "01:47:46", "text": "把医疗包放在身后。"}]
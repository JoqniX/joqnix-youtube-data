[{"type": "subtitle", "time": 3244.71, "timestamp": "00:54:04", "text": "位置。 别贸然冲进去。"}, {"type": "subtitle", "time": 3247.03, "timestamp": "00:54:07", "text": "你天下无敌。"}, {"type": "subtitle", "time": 3249.51, "timestamp": "00:54:09", "text": "时刻注意你的冷却时间。"}, {"type": "subtitle", "time": 3252.79, "timestamp": "00:54:12", "text": "惩罚者已经布置了双重打击。"}, {"type": "subtitle", "time": 3253.99, "timestamp": "00:54:13", "text": "杀了他。 想办法杀了他。 想办法杀了"}, {"type": "subtitle", "time": 3255.19, "timestamp": "00:54:15", "text": "他。 杀了他。 杀了他。 想办法杀了"}, {"type": "subtitle", "time": 3257.03, "timestamp": "00:54:17", "text": "他。"}, {"type": "subtitle", "time": 3257.589, "timestamp": "00:54:17", "text": "嗯？"}, {"type": "subtitle", "time": 3259.91, "timestamp": "00:54:19", "text": "你是……你得了B。"}, {"type": "subtitle", "time": 3262.63, "timestamp": "00:54:22", "text": "我得了。"}, {"type": "subtitle", "time": 3265.829, "timestamp": "00:54:25", "text": "兄弟，你有两个B。 我"}, {"type": "subtitle", "time": 3267.03, "timestamp": "00:54:27", "text": "觉得我用得更快。"}, {"type": "subtitle", "time": 3268.309, "timestamp": "00:54:28", "text": "命运尚未注定。"}, {"type": "subtitle", "time": 3270.79, "timestamp": "00:54:30", "text": "在哪里？ 你在哪里使用了where？"}, {"type": "subtitle", "time": 3273.589, "timestamp": "00:54:33", "text": "我用它来更快地落地，"}, {"type": "subtitle", "time": 3278.069, "timestamp": "00:54:38", "text": "哦，然后你就得好好打，你知道，"}, {"type": "subtitle", "time": 3279.829, "timestamp": "00:54:39", "text": "就像如果你用一个渐弱球，你"}, {"type": "subtitle", "time": 3281.51, "timestamp": "00:54:41", "text": "自己也得打得好。"}, {"type": "subtitle", "time": 3284.23, "timestamp": "00:54:44", "text": "这有点令人难过。"}, {"type": "subtitle", "time": 3287.03, "timestamp": "00:54:47", "text": "我的意思是，我完全明白"}, {"type": "subtitle", "time": 3289.99, "timestamp": "00:54:49", "text": "为什么？   当时那里"}, {"type": "subtitle", "time": 3291.03, "timestamp": "00:54:51", "text": "空无一人。"}, {"type": "subtitle", "time": 3293.109, "timestamp": "00:54:53", "text": "你必须去看看"}, {"type": "subtitle", "time": 3297.03, "timestamp": "00:54:57", "text": "球队。 它有眼睛，老兄。"}, {"type": "subtitle", "time": 3299.43, "timestamp": "00:54:59", "text": "我为什么这么差劲？"}]
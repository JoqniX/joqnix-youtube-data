[{"type": "subtitle", "time": 2761.91, "timestamp": "00:46:01", "text": "但"}, {"type": "subtitle", "time": 2763.91, "timestamp": "00:46:03", "text": "大多数人不会这么做，"}, {"type": "subtitle", "time": 2765.349, "timestamp": "00:46:05", "text": "因为他们技术不好。"}, {"type": "subtitle", "time": 2766.87, "timestamp": "00:46:06", "text": "所以如果你"}, {"type": "subtitle", "time": 2769.109, "timestamp": "00:46:09", "text": "克制蜘蛛侠，你就等着被克制吧。大多数"}, {"type": "subtitle", "time": 2771.349, "timestamp": "00:46:11", "text": "人会用超能英雄来克制蜘蛛侠。"}, {"type": "subtitle", "time": 2772.71, "timestamp": "00:46:12", "text": "蜘蛛侠或许能帮上忙，"}, {"type": "subtitle", "time": 2775.67, "timestamp": "00:46:15", "text": "因为……情况就是这样，你不需要"}, {"type": "subtitle", "time": 2777.109, "timestamp": "00:46:17", "text": "瞄准，你只需要看着"}, {"type": "subtitle", "time": 2778.55, "timestamp": "00:46:18", "text": "蜘蛛侠，然后就行了。"}, {"type": "subtitle", "time": 2781.43, "timestamp": "00:46:21", "text": "混乱总是会胜利的。哦对了，"}, {"type": "subtitle", "time": 2792.069, "timestamp": "00:46:32", "text": "除非你"}, {"type": "subtitle", "time": 2793.349, "timestamp": "00:46:33", "text": "试过攻击我，否则你没有理由害怕我的魔法。"}, {"type": "subtitle", "time": 2795.349, "timestamp": "00:46:35", "text": "报告现在消失了。"}, {"type": "subtitle", "time": 2801.27, "timestamp": "00:46:41", "text": "顺便说一句，就算我们赢了你，蜘蛛侠也赢不了。 他会这么做。"}, {"type": "subtitle", "time": 2803.67, "timestamp": "00:46:43", "text": "所以你就像是对这类"}, {"type": "subtitle", "time": 2806.71, "timestamp": "00:46:46", "text": "角色的一种反驳。 好吧，你是反潜。"}, {"type": "subtitle", "time": 2809.03, "timestamp": "00:46:49", "text": "看看你对蜘蛛侠造成的伤害，"}, {"type": "subtitle", "time": 2812.47, "timestamp": "00:46:52", "text": "我根本打不到你，也"}, {"type": "subtitle", "time": 2813.349, "timestamp": "00:46:53", "text": "打不到你。"}, {"type": "subtitle", "time": 2815.109, "timestamp": "00:46:55", "text": "混乱总是占据主导地位。"}, {"type": "subtitle", "time": 2817.349, "timestamp": "00:46:57", "text": "是的，"}, {"type": "subtitle", "time": 2819.03, "timestamp": "00:46:59", "text": "这是你的反击型字符。 所以"}]
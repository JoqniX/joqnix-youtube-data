[{"type": "subtitle", "time": 9127.11, "timestamp": "02:32:07", "text": "哦，我刚刚意识到这一点。   是的"}, {"type": "subtitle", "time": 9130.79, "timestamp": "02:32:10", "text": "。 射杀她。 毙了那个婊子。 毙了"}, {"type": "subtitle", "time": 9133.27, "timestamp": "02:32:13", "text": "那个婊子。"}, {"type": "subtitle", "time": 9135.59, "timestamp": "02:32:15", "text": "你在这方面非常出色。 现在，"}, {"type": "subtitle", "time": 9139.19, "timestamp": "02:32:19", "text": "最后阶段即将到来。"}, {"type": "subtitle", "time": 9140.55, "timestamp": "02:32:20", "text": "你会看到像水晶一样的东西冒出来"}, {"type": "subtitle", "time": 9143.67, "timestamp": "02:32:23", "text": "。 乔，我们得去拍摄水晶。"}, {"type": "subtitle", "time": 9144.389, "timestamp": "02:32:24", "text": "好的，"}, {"type": "subtitle", "time": 9148.469, "timestamp": "02:32:28", "text": "水晶。 是的，"}, {"type": "subtitle", "time": 9150.63, "timestamp": "02:32:30", "text": "我支持"}, {"type": "subtitle", "time": 9152.469, "timestamp": "02:32:32", "text": "水晶，乔。"}, {"type": "subtitle", "time": 9154.469, "timestamp": "02:32:34", "text": "在哪里？   在"}, {"type": "subtitle", "time": 9155.99, "timestamp": "02:32:35", "text": "她身后。 你必须继续前进。 在"}, {"type": "subtitle", "time": 9162.07, "timestamp": "02:32:42", "text": "好吧，她确实这么做了。"}, {"type": "subtitle", "time": 9179.59, "timestamp": "02:32:59", "text": "该死的刀锋沦为月光骑士的奴隶"}]
[{"type": "subtitle", "time": 12240.95, "timestamp": "03:24:00", "text": "我不在这个服务器上打排位赛的原因。"}, {"type": "subtitle", "time": 12243.349, "timestamp": "03:24:03", "text": "另一个我已经在那上面达到了巅峰状态。"}, {"type": "subtitle", "time": 12244.87, "timestamp": "03:24:04", "text": "我只是用它来练习"}, {"type": "subtitle", "time": 12245.91, "timestamp": "03:24:05", "text": "打字而已，"}, {"type": "subtitle", "time": 12253.75, "timestamp": "03:24:13", "text": "糟糕。"}, {"type": "subtitle", "time": 12259.99, "timestamp": "03:24:19", "text": "好的。"}, {"type": "subtitle", "time": 12262.389, "timestamp": "03:24:22", "text": "嘿，我也可以，我也喜欢玩游戏"}, {"type": "subtitle", "time": 12273.429, "timestamp": "03:24:33", "text": "你"}, {"type": "subtitle", "time": 12275.429, "timestamp": "03:24:35", "text": "那边用你的“砰砰”枪射击肯定没问题。 我和"}, {"type": "subtitle", "time": 12276.63, "timestamp": "03:24:36", "text": "妈妈在一起。"}, {"type": "subtitle", "time": 12277.11, "timestamp": "03:24:37", "text": "你好。"}, {"type": "subtitle", "time": 12278.469, "timestamp": "03:24:38", "text": "好的。"}, {"type": "subtitle", "time": 12280.63, "timestamp": "03:24:40", "text": "你快要结束了吗？ 你们要关闭"}, {"type": "subtitle", "time": 12283.349, "timestamp": "03:24:43", "text": "DNA游戏吗？"}, {"type": "subtitle", "time": 12284.79, "timestamp": "03:24:44", "text": "不，我以为我们要玩噩梦"}, {"type": "subtitle", "time": 12287.19, "timestamp": "03:24:47", "text": "一。 好的。 我们不知道，你也不知道是"}, {"type": "subtitle", "time": 12289.269, "timestamp": "03:24:49", "text": "哪一个？ 极端。"}, {"type": "subtitle", "time": 12290.15, "timestamp": "03:24:50", "text": "噩梦一。"}, {"type": "subtitle", "time": 12290.87, "timestamp": "03:24:50", "text": "哦，是的。"}, {"type": "subtitle", "time": 12291.91, "timestamp": "03:24:51", "text": "噩梦一。"}, {"type": "subtitle", "time": 12294.229, "timestamp": "03:24:54", "text": "等待。 将是四。"}, {"type": "subtitle", "time": 12295.269, "timestamp": "03:24:55", "text": "现在是四点。"}, {"type": "subtitle", "time": 12296.71, "timestamp": "03:24:56", "text": "哦，你得走了。   是的"}, {"type": "subtitle"
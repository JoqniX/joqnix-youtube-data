[{"type": "subtitle", "time": 2467.67, "timestamp": "00:41:07", "text": "好吧，我的生命值很低，但还是跟你一样"}, {"type": "subtitle", "time": 2470.23, "timestamp": "00:41:10", "text": "低生命值。 我的天哪，老兄。 你很糟糕。"}, {"type": "subtitle", "time": 2475.43, "timestamp": "00:41:15", "text": "我的天啊。"}, {"type": "subtitle", "time": 2477.03, "timestamp": "00:41:17", "text": "你会学到的。 边"}, {"type": "subtitle", "time": 2479.349, "timestamp": "00:41:19", "text": "玩边学。 你会学到的。 好的。  1 2 3 走。"}, {"type": "subtitle", "time": 2481.75, "timestamp": "00:41:21", "text": "消失。"}, {"type": "subtitle", "time": 2489.03, "timestamp": "00:41:29", "text": "你不需要在我消失的时候也消失，好像"}, {"type": "subtitle", "time": 2490.23, "timestamp": "00:41:30", "text": "你可以"}, {"type": "subtitle", "time": 2491.43, "timestamp": "00:41:31", "text": "独自拥有它一样。"}, {"type": "subtitle", "time": 2492.069, "timestamp": "00:41:32", "text": "啊，这就是"}, {"type": "subtitle", "time": 2494.39, "timestamp": "00:41:34", "text": "你需要运用"}, {"type": "subtitle", "time": 2496.87, "timestamp": "00:41:36", "text": "淡出技巧的情况。"}, {"type": "subtitle", "time": 2499.99, "timestamp": "00:41:39", "text": "比如，开始攻击"}, {"type": "subtitle", "time": 2502.87, "timestamp": "00:41:42", "text": "我的时候。  1、2、3，谁先走？"}, {"type": "subtitle", "time": 2506.63, "timestamp": "00:41:46", "text": "你已被我迷住了。"}, {"type": "subtitle", "time": 2508.069, "timestamp": "00:41:48", "text": "你那边电量快用完了。 你可以"}, {"type": "subtitle", "time": 2509.589, "timestamp": "00:41:49", "text": "再次使用渐变效果，但你没有"}, {"type": "subtitle", "time": 2510.309, "timestamp": "00:41:50", "text": "这样做。"}, {"type": "subtitle", "time": 2512.39, "timestamp": "00:41:52", "text": "是啊，"}, {"type": "subtitle", "time": 2513.829, "timestamp": "00:41:53", "text": "你知道，我们还是选一个"}, {"type": "subtitle", "time": 2515.51, "timestamp": "00:41:55", "text": "不会消失的角色吧。"}]
[{"type": "subtitle", "time": 8580.389, "timestamp": "02:23:00", "text": "我喜欢刷新页面，然后把"}, {"type": "subtitle", "time": 8582.55, "timestamp": "02:23:02", "text": "所有东西都挑出来。   顺便说一句，"}, {"type": "subtitle", "time": 8585.67, "timestamp": "02:23:05", "text": "我也在做这件事。"}, {"type": "subtitle", "time": 8587.03, "timestamp": "02:23:07", "text": "我"}, {"type": "subtitle", "time": 8590.15, "timestamp": "02:23:10", "text": "向鱿鱼射击。 他在扔"}, {"type": "subtitle", "time": 8594.63, "timestamp": "02:23:14", "text": "鱿鱼。 鱿鱼，你就是在那里"}, {"type": "subtitle", "time": 8609.11, "timestamp": "02:23:29", "text": "看到了64马力，但是那又怎样？是的"}, {"type": "subtitle", "time": 8610.389, "timestamp": "02:23:30", "text": "。 你以前没玩过僵尸模式吗"}, {"type": "subtitle", "time": 8610.95, "timestamp": "02:23:30", "text": "？"}, {"type": "subtitle", "time": 8613.83, "timestamp": "02:23:33", "text": "没有。"}, {"type": "subtitle", "time": 8614.71, "timestamp": "02:23:34", "text": "我以前从来没玩过"}, {"type": "subtitle", "time": 8616.309, "timestamp": "02:23:36", "text": "任何僵尸模式。"}, {"type": "subtitle", "time": 8621.59, "timestamp": "02:23:41", "text": "你玩《使命召唤》吗？"}, {"type": "subtitle", "time": 8623.91, "timestamp": "02:23:43", "text": "没有。 甚至还没玩过《使命召唤》的"}, {"type": "subtitle", "time": 8625.19, "timestamp": "02:23:45", "text": "僵尸模式呢。"}]
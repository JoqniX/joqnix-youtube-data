[{"type": "subtitle", "time": 9731.349, "timestamp": "02:42:11", "text": "啊，为什么我"}, {"type": "subtitle", "time": 9732.95, "timestamp": "02:42:12", "text": "要死了？ 我要死了。 我要死了。 我"}, {"type": "subtitle", "time": 9734.309, "timestamp": "02:42:14", "text": "要死了。"}, {"type": "subtitle", "time": 9736.63, "timestamp": "02:42:16", "text": "他想死，就死吧。"}, {"type": "subtitle", "time": 9758.87, "timestamp": "02:42:38", "text": "我的复仇之拳。 战斗。 只需"}, {"type": "subtitle", "time": 9773.67, "timestamp": "02:42:53", "text": "所以，杀死鱿鱼对他有害，"}, {"type": "subtitle", "time": 9775.67, "timestamp": "02:42:55", "text": "兄弟。"}, {"type": "subtitle", "time": 9777.27, "timestamp": "02:42:57", "text": "是的，"}, {"type": "subtitle", "time": 9779.11, "timestamp": "02:42:59", "text": "你也可以开枪射击他，造成更大的"}]
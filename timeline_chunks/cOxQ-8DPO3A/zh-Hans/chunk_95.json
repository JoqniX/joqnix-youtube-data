[{"type": "subtitle", "time": 5702.07, "timestamp": "01:35:02", "text": "。 阿尔就在街角，而"}, {"type": "subtitle", "time": 5705.35, "timestamp": "01:35:05", "text": "不是冲着他们的脸。 只是为了让他们"}, {"type": "subtitle", "time": 5710.149, "timestamp": "01:35:10", "text": "死去。 但没有人死亡。 什么？是"}, {"type": "subtitle", "time": 5734.87, "timestamp": "01:35:34", "text": "我讨厌这样。"}, {"type": "subtitle", "time": 5736.629, "timestamp": "01:35:36", "text": "恨什么？"}]
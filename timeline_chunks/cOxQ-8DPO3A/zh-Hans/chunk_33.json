[{"type": "subtitle", "time": 1985.75, "timestamp": "00:33:05", "text": "所以洛基建了实验室。 这是"}, {"type": "subtitle", "time": 1987.83, "timestamp": "00:33:07", "text": "永生实验室。"}, {"type": "subtitle", "time": 1989.83, "timestamp": "00:33:09", "text": "没有人能造成损害。 你造成的伤害越多"}, {"type": "subtitle", "time": 1992.07, "timestamp": "00:33:12", "text": "，他们获得的治疗就越多。 所以，唯一"}, {"type": "subtitle", "time": 1993.99, "timestamp": "00:33:13", "text": "能削弱洛基的方法就是摧毁他的实验室。"}, {"type": "subtitle", "time": 1996.07, "timestamp": "00:33:16", "text": "试图摧毁实验室。 你可以瞄准"}, {"type": "subtitle", "time": 1997.669, "timestamp": "00:33:17", "text": "实验室并将其摧毁。   一切就此"}, {"type": "subtitle", "time": 1999.75, "timestamp": "00:33:19", "text": "开始。"}, {"type": "subtitle", "time": 2001.43, "timestamp": "00:33:21", "text": "现在你知道了。"}, {"type": "subtitle", "time": 2003.11, "timestamp": "00:33:23", "text": "好的。 好的。"}, {"type": "subtitle", "time": 2005.19, "timestamp": "00:33:25", "text": "现在让我来告诉你哪些坦克"}, {"type": "subtitle", "time": 2007.59, "timestamp": "00:33:27", "text": "能让你从旧状态中惊醒。"}, {"type": "subtitle", "time": 2008.149, "timestamp": "00:33:28", "text": "好的。"}, {"type": "subtitle", "time": 2012.07, "timestamp": "00:33:32", "text": "我觉得应该是一、二、三、"}, {"type": "subtitle", "time": 2014.63, "timestamp": "00:33:34", "text": "四。 也是四。 所以，基本上，"}, {"type": "subtitle", "time": 2020.31, "timestamp": "00:33:40", "text": "钻石炸弹给了你。"}, {"type": "subtitle", "time": 2023.11, "timestamp": "00:33:43", "text": "我的天啊。"}, {"type": "subtitle", "time": 2024.71, "timestamp": "00:33:44", "text": "另一个"}, {"type": "subtitle", "time": 2032.07, "timestamp": "00:33:52", "text": "哦，对，我讨厌那枚便士硬币。 是的。   是的"}, {"type": "subtitle", "time": 2035.669, "timestamp": "00:33:55", "text": "。 第三个是绿巨人。 他只是被"}, {"type": "subtitle", "time": 2038.149, "timestamp": "00:33:58", "text": "眩晕了。 好了。"}]
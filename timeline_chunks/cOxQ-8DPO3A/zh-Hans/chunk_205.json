[{"type": "subtitle", "time": 12300.87, "timestamp": "03:25:00", "text": "好的。 好的。 那就没问题了。 我们"}, {"type": "subtitle", "time": 12302.229, "timestamp": "03:25:02", "text": "下次再玩。   是的"}, {"type": "subtitle", "time": 12304.309, "timestamp": "03:25:04", "text": "。"}, {"type": "subtitle", "time": 12305.429, "timestamp": "03:25:05", "text": "我会保留这个游戏。"}, {"type": "subtitle", "time": 12306.79, "timestamp": "03:25:06", "text": "啊，真有趣。   是的"}, {"type": "subtitle", "time": 12307.429, "timestamp": "03:25:07", "text": "。"}, {"type": "subtitle", "time": 12310.15, "timestamp": "03:25:10", "text": "是的，我们会演奏它。 然后"}, {"type": "subtitle", "time": 12312.95, "timestamp": "03:25:12", "text": "等你玩完那"}, {"type": "subtitle", "time": 12316.07, "timestamp": "03:25:16", "text": "该死的……你知道的，旺达，我们终于可以"}, {"type": "subtitle", "time": 12322.229, "timestamp": "03:25:22", "text": "然后我会狠狠地冲你大吼"}, {"type": "subtitle", "time": 12324.389, "timestamp": "03:25:24", "text": "。 你知道，那时候"}, {"type": "subtitle", "time": 12326.389, "timestamp": "03:25:26", "text": "我狠狠地冲你大喊大叫。 只是"}, {"type": "subtitle", "time": 12329.03, "timestamp": "03:25:29", "text": "说说而已。"}, {"type": "subtitle", "time": 12331.03, "timestamp": "03:25:31", "text": "你这"}, {"type": "subtitle", "time": 12333.51, "timestamp": "03:25:33", "text": "混蛋，居然管这叫终极技能？ 你管这叫"}, {"type": "subtitle", "time": 12335.83, "timestamp": "03:25:35", "text": "终极挑战？ 或者类似的意思"}, {"type": "subtitle", "time": 12343.59, "timestamp": "03:25:43", "text": "你连怎么杀人都不知道，"}, {"type": "subtitle", "time": 12345.75, "timestamp": "03:25:45", "text": "还得学习新的"}, {"type": "subtitle", "time": 12347.19, "timestamp": "03:25:47", "text": "角色。"}, {"type": "subtitle", "time": 12349.429, "timestamp": "03:25:49", "text": "你他妈的皮肤真好。 刀"}, {"type": "subtitle", "time": 12351.03, "timestamp": "03:25:51", "text": "皮。 这皮肤真酷。"}, {"type": "subtitle", "time": 12353.11, "timestamp": "03:25:53", "text": "是啊，"}, {"type": "subtitle", "time": 12354.95, "timestamp": "03:25:54", "text": "这皮肤真他妈酷。"}]
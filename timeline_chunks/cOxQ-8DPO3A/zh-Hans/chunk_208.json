[{"type": "subtitle", "time": 12483.67, "timestamp": "03:28:03", "text": "我当时就想，哇，老兄。 我们是朋友。 该死。"}, {"type": "subtitle", "time": 12486.55, "timestamp": "03:28:06", "text": "我们只是朋友。 好的。"}, {"type": "subtitle", "time": 12490.309, "timestamp": "03:28:10", "text": "你需要付出那么大的努力。 该死。"}, {"type": "subtitle", "time": 12492.15, "timestamp": "03:28:12", "text": "如果Jo明天没来直播"}, {"type": "subtitle", "time": 12494.389, "timestamp": "03:28:14", "text": "，你们就知道"}, {"type": "subtitle", "time": 12499.51, "timestamp": "03:28:19", "text": "妈的，兄弟。"}, {"type": "subtitle", "time": 12500.389, "timestamp": "03:28:20", "text": "哇。"}, {"type": "subtitle", "time": 12502.309, "timestamp": "03:28:22", "text": "我的兄弟说：“今晚见，兄弟。”"}, {"type": "subtitle", "time": 12504.15, "timestamp": "03:28:24", "text": "我当时就想，“哇，"}, {"type": "subtitle", "time": 12513.51, "timestamp": "03:28:33", "text": "怎么回事？算了算了，我结束"}, {"type": "subtitle", "time": 12514.87, "timestamp": "03:28:34", "text": "直播了。我要走了。"}, {"type": "subtitle", "time": 12516.71, "timestamp": "03:28:36", "text": "晚安，我的朋友。晚安。"}, {"type": "subtitle", "time": 12519.67, "timestamp": "03:28:39", "text": "嗨。晚安。保重。D。我都做完了"}, {"type": "subtitle", "time": 12520.63, "timestamp": "03:28:40", "text": "。拜拜。"}, {"type": "subtitle", "time": 12522.55, "timestamp": "03:28:42", "text": "你也一样。你也一样。你也一样。拜拜。"}, {"type": "subtitle", "time": 12523.429, "timestamp": "03:28:43", "text": "拜拜。拜拜。好了，"}, {"type": "subtitle", "time": 12530.95, "timestamp": "03:28:50", "text": "各位，这就是今天的面包了。就是这样"}, {"type": "subtitle", "time": 12532.95, "timestamp": "03:28:52", "text": "。"}, {"type": "subtitle", "time": 12536.309, "timestamp": "03:28:56", "text": "谢谢Brad今天陪我。真的很"}, {"type": "subtitle", "time": 12539.6, "timestamp": "03:28:59", "text": "有趣。"}]
[{"type": "subtitle", "time": 11762.15, "timestamp": "03:16:02", "text": "加载需要一些时间。"}, {"type": "subtitle", "time": 11764.309, "timestamp": "03:16:04", "text": "哦，"}, {"type": "subtitle", "time": 11767.75, "timestamp": "03:16:07", "text": "我现在开三枪了，贱人。 我开了三枪。"}, {"type": "subtitle", "time": 11776.15, "timestamp": "03:16:16", "text": "天哪。 我想站在"}, {"type": "subtitle", "time": 11798.71, "timestamp": "03:16:38", "text": "看看我们造成的破坏吧。"}, {"type": "subtitle", "time": 11811.83, "timestamp": "03:16:51", "text": "击落她。 把那婊子打倒。"}, {"type": "subtitle", "time": 11813.429, "timestamp": "03:16:53", "text": "对了，注意别乱动，因为她会放"}]
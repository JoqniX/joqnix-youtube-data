[{"type": "subtitle", "time": 6497.75, "timestamp": "01:48:17", "text": "我要把他们两个都杀了。 啊，忘了画"}, {"type": "subtitle", "time": 6497.99, "timestamp": "01:48:17", "text": "脸了。"}, {"type": "subtitle", "time": 6510.709, "timestamp": "01:48:30", "text": "天哪，老兄。 你必须停止"}, {"type": "subtitle", "time": 6513.03, "timestamp": "01:48:33", "text": "遗忘自己的能力。"}, {"type": "subtitle", "time": 6534.79, "timestamp": "01:48:54", "text": "当他们把事情推向这个角落时，我感到失望。   是的"}, {"type": "subtitle", "time": 6536.709, "timestamp": "01:48:56", "text": "，我会死的。"}]
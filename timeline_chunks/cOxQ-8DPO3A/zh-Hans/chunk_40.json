[{"type": "subtitle", "time": 2405.99, "timestamp": "00:40:05", "text": "你知道吗？ 我想，让我跟自己进行一次一对一的美国电话通话吧"}, {"type": "subtitle", "time": 2409.51, "timestamp": "00:40:09", "text": "。 好的。 三、二、"}, {"type": "subtitle", "time": 2411.51, "timestamp": "00:40:11", "text": "一，开始。"}, {"type": "subtitle", "time": 2421.349, "timestamp": "00:40:21", "text": "哦，要学会跟上节奏。 你得"}, {"type": "subtitle", "time": 2423.27, "timestamp": "00:40:23", "text": "跟上节奏，还不能错过右键"}, {"type": "subtitle", "time": 2424.63, "timestamp": "00:40:24", "text": "点击。 顺便说一句，你的右键很容易就能"}, {"type": "subtitle", "time": 2425.51, "timestamp": "00:40:25", "text": "点到。"}, {"type": "subtitle", "time": 2427.51, "timestamp": "00:40:27", "text": "浪费我的时间。 一切就此开始。"}, {"type": "subtitle", "time": 2429.349, "timestamp": "00:40:29", "text": "它有点像范围攻击技能。"}, {"type": "subtitle", "time": 2430.71, "timestamp": "00:40:30", "text": "如果你不知道，你就不会记得。"}, {"type": "subtitle", "time": 2432.71, "timestamp": "00:40:32", "text": "范围攻击。 好的。"}, {"type": "subtitle", "time": 2435.03, "timestamp": "00:40:35", "text": "你又不能像站在原地那样去击中炸弹"}, {"type": "subtitle", "time": 2437.829, "timestamp": "00:40:37", "text": "。   他们"}, {"type": "subtitle", "time": 2440.39, "timestamp": "00:40:40", "text": "还是会受到影响的。"}, {"type": "subtitle", "time": 2442.23, "timestamp": "00:40:42", "text": "从混沌中重生。"}, {"type": "subtitle", "time": 2444.95, "timestamp": "00:40:44", "text": "而且你的武器攻击范围大概是"}, {"type": "subtitle", "time": 2448.63, "timestamp": "00:40:48", "text": "20米。不，不，左键攻击范围大概是18米"}, {"type": "subtitle", "time": 2450.63, "timestamp": "00:40:50", "text": "。"}, {"type": "subtitle", "time": 2451.03, "timestamp": "00:40:51", "text": "哦，"}, {"type": "subtitle", "time": 2453.03, "timestamp": "00:40:53", "text": "你知道，你会习惯的，"}, {"type": "subtitle", "time": 2454.79, "timestamp": "00:40:54", "text": "因为你会习惯这种一对一的"}, {"type": "subtitle", "time": 2456.87, "timestamp": "00:40:56", "text": "眼神交流，就像现在和我一对一一样"}]
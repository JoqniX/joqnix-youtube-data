[{"type": "subtitle", "time": 1266.07, "timestamp": "00:21:06", "text": "啊，但是别……好吧，我还给你展示点"}, {"type": "subtitle", "time": 1268.87, "timestamp": "00:21:08", "text": "东西。 对了，友军"}, {"type": "subtitle", "time": 1271.59, "timestamp": "00:21:11", "text": "火力已关闭。"}, {"type": "subtitle", "time": 1275.27, "timestamp": "00:21:15", "text": "我曾涉足街头创业和系统，"}, {"type": "subtitle", "time": 1293.51, "timestamp": "00:21:33", "text": "我觉得我产生了影响。"}, {"type": "subtitle", "time": 1295.909, "timestamp": "00:21:35", "text": "我不能。 好的，就是"}, {"type": "subtitle", "time": 1298.47, "timestamp": "00:21:38", "text": "这个。 好的，再来一遍。 再次。   再来一次"}, {"type": "subtitle", "time": 1300.23, "timestamp": "00:21:40", "text": "。"}, {"type": "subtitle", "time": 1309.75, "timestamp": "00:21:49", "text": "杀了你，让你付出一切。 是的，即使"}, {"type": "subtitle", "time": 1312.549, "timestamp": "00:21:52", "text": "你穷尽一切手段，人们也能杀人。"}, {"type": "subtitle", "time": 1313.59, "timestamp": "00:21:53", "text": "只是说说而已。"}, {"type": "subtitle", "time": 1317.909, "timestamp": "00:21:57", "text": "为什么？"}]
[{"type": "subtitle", "time": 7049.83, "timestamp": "01:57:29", "text": "啊，船长向我来了。"}, {"type": "subtitle", "time": 7051.75, "timestamp": "01:57:31", "text": "你惹恼了他。 他当然在"}, {"type": "subtitle", "time": 7052.629, "timestamp": "01:57:32", "text": "那边。"}, {"type": "subtitle", "time": 7053.669, "timestamp": "01:57:33", "text": "我来。 我来。"}, {"type": "subtitle", "time": 7057.35, "timestamp": "01:57:37", "text": "淡出到另一边。 其他方面"}, {"type": "subtitle", "time": 7064.229, "timestamp": "01:57:44", "text": "你已身处其中。 快点。 死。 好的。"}]
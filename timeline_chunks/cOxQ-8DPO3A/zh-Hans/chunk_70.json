[{"type": "subtitle", "time": 4203.91, "timestamp": "01:10:03", "text": "什么鬼？ 你说你是对的是什么意思？"}, {"type": "subtitle", "time": 4207.75, "timestamp": "01:10:07", "text": "我知道。 我试过了，但是我的脸总是感觉很累"}, {"type": "subtitle", "time": 4208.55, "timestamp": "01:10:08", "text": "。"}, {"type": "subtitle", "time": 4212.31, "timestamp": "01:10:12", "text": "你明白了吗？ 这是为什么？"}, {"type": "subtitle", "time": 4215.03, "timestamp": "01:10:15", "text": "我需要控制它。 是的。"}, {"type": "subtitle", "time": 4216.87, "timestamp": "01:10:16", "text": "哦，你需要……你到底在"}, {"type": "subtitle", "time": 4218.63, "timestamp": "01:10:18", "text": "说什么？ 控制它。"}, {"type": "subtitle", "time": 4220.95, "timestamp": "01:10:20", "text": "控制我的"}, {"type": "subtitle", "time": 4224.229, "timestamp": "01:10:24", "text": "淡入淡出功能。 不要连续按"}, {"type": "subtitle", "time": 4227.11, "timestamp": "01:10:27", "text": "两次，把能量用完。"}, {"type": "subtitle", "time": 4231.59, "timestamp": "01:10:31", "text": "兄弟，你可以等等。"}, {"type": "subtitle", "time": 4232.63, "timestamp": "01:10:32", "text": "你知道"}, {"type": "subtitle", "time": 4234.95, "timestamp": "01:10:34", "text": "当你用完一次渐变效果的时候。 我不是"}, {"type": "subtitle", "time": 4236.95, "timestamp": "01:10:36", "text": "说你不要用渐变效果。 我"}, {"type": "subtitle", "time": 4239.669, "timestamp": "01:10:39", "text": "提醒你检查一下技能冷却时间。"}, {"type": "subtitle", "time": 4244.229, "timestamp": "01:10:44", "text": "检查一下你的冷却时间。 按下淡入"}, {"type": "subtitle", "time": 4245.59, "timestamp": "01:10:45", "text": "淡出按钮后，会有一段冷却时间。 有"}, {"type": "subtitle", "time": 4248.229, "timestamp": "01:10:48", "text": "一个圆圈向上移动，就像你看，"}, {"type": "subtitle", "time": 4253.189, "timestamp": "01:10:53", "text": "试着点赞，"}, {"type": "subtitle", "time": 4255.35, "timestamp": "01:10:55", "text": "当它超过一半的时候。 尽力"}, {"type": "subtitle", "time": 4257.75, "timestamp": "01:10:57", "text": "杀死他们，然后消失。 在"}]
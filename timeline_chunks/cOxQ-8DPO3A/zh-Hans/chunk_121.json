[{"type": "subtitle", "time": 7275.51, "timestamp": "02:01:15", "text": "三、二、一，开始。"}, {"type": "subtitle", "time": 7277.35, "timestamp": "02:01:17", "text": "嗯，顺便说一句，如果那家伙还活着的话，你可以把他抓起来"}, {"type": "subtitle", "time": 7291.189, "timestamp": "02:01:31", "text": "你试过把他击晕吗？"}, {"type": "subtitle", "time": 7295.91, "timestamp": "02:01:35", "text": "我没能击晕对方。 我被压制住了。"}, {"type": "subtitle", "time": 7297.669, "timestamp": "02:01:37", "text": "在哪里？   这边"}, {"type": "subtitle", "time": 7300.229, "timestamp": "02:01:40", "text": "。"}]
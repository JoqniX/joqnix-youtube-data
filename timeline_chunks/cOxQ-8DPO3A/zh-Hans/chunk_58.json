[{"type": "subtitle", "time": 3480.789, "timestamp": "00:58:00", "text": "。 是的。 进攻之前，做好充分"}, {"type": "subtitle", "time": 3487.03, "timestamp": "00:58:07", "text": "所以要么炸毁油罐。 好的。 用"}, {"type": "subtitle", "time": 3489.349, "timestamp": "00:58:09", "text": "它们来增强我们的坦克。   还有"}, {"type": "subtitle", "time": 3491.03, "timestamp": "00:58:11", "text": "谁"}, {"type": "subtitle", "time": 3492.39, "timestamp": "00:58:12", "text": "比你我更适合把它们重新组装起来呢？"}, {"type": "subtitle", "time": 3494.069, "timestamp": "00:58:14", "text": "我喜欢你的乐观，"}, {"type": "subtitle", "time": 3497.829, "timestamp": "00:58:17", "text": "或者只是想搞破坏，"}, {"type": "subtitle", "time": 3499.829, "timestamp": "00:58:19", "text": "因为你就是不记得"}, {"type": "subtitle", "time": 3507.19, "timestamp": "00:58:27", "text": "你必须记住那些事，伙计。"}, {"type": "subtitle", "time": 3509.99, "timestamp": "00:58:29", "text": "就像慢慢变成了肌肉记忆"}, {"type": "subtitle", "time": 3511.67, "timestamp": "00:58:31", "text": "一样。"}, {"type": "subtitle", "time": 3513.829, "timestamp": "00:58:33", "text": "知道了。"}, {"type": "subtitle", "time": 3515.829, "timestamp": "00:58:35", "text": "维度之间的壁垒正在"}, {"type": "subtitle", "time": 3518.47, "timestamp": "00:58:38", "text": "瓦解。 保护他们是我们的责任"}, {"type": "subtitle", "time": 3518.789, "timestamp": "00:58:38", "text": "。"}, {"type": "subtitle", "time": 3520.87, "timestamp": "00:58:40", "text": "然后在某些情况下使用你的小号"}, {"type": "subtitle", "time": 3524.87, "timestamp": "00:58:44", "text": "来杀光所有人或者占领空间。"}, {"type": "subtitle", "time": 3527.51, "timestamp": "00:58:47", "text": "好吧，这张地图有点儿差强人意。 所以试着"}, {"type": "subtitle", "time": 3531.19, "timestamp": "00:58:51", "text": "去标记一下。"}, {"type": "subtitle", "time": 3532.87, "timestamp": "00:58:52", "text": "你看到这枚便士了吗？ 我看见"}, {"type": "subtitle", "time": 3533.91, "timestamp": "00:58:53", "text": "她了。"}, {"type": "subtitle", "time": 3534.95, "timestamp": "00:58:54", "text": "这应该对我有帮助。"}, {"type": "subtitle", "time": 3537.99, "timestamp": "00:58:57", "text": "我遭到攻击了。 好的，"}]
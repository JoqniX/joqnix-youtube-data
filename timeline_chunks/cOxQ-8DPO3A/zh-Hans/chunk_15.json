[{"type": "chat", "time": 900.804, "timestamp": "00:15:00", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/G8AfY6yWGuKuhL0PlbiA2AEUCkszU2WH9gy1mb0dV-11UJg/G8AfY6yWGuKuhL0PlbiA2AE"}, {"type": "subtitle", "time": 901.03, "timestamp": "00:15:01", "text": "就让他们去对付"}, {"type": "subtitle", "time": 901.91, "timestamp": "00:15:01", "text": "敌人。"}, {"type": "subtitle", "time": 903.99, "timestamp": "00:15:03", "text": "哦，"}, {"type": "subtitle", "time": 905.91, "timestamp": "00:15:05", "text": "你不需要总是把钩子伸出"}, {"type": "subtitle", "time": 907.43, "timestamp": "00:15:07", "text": "来。"}, {"type": "subtitle", "time": 909.829, "timestamp": "00:15:09", "text": "我好的。   是的"}, {"type": "subtitle", "time": 919.91, "timestamp": "00:15:19", "text": "是的，你不能开枪打我。 即便这是"}, {"type": "subtitle", "time": 922.47, "timestamp": "00:15:22", "text": "他以前的东西，也像是他把"}, {"type": "subtitle", "time": 924.55, "timestamp": "00:15:24", "text": "你以前的东西全都占为己有了。 你知道"}, {"type": "subtitle", "time": 926.23, "timestamp": "00:15:26", "text": "吗？"}, {"type": "subtitle", "time": 927.59, "timestamp": "00:15:27", "text": "你所有的东西。"}, {"type": "subtitle", "time": 935.829, "timestamp": "00:15:35", "text": "家人，但"}, {"type": "subtitle", "time": 937.269, "timestamp": "00:15:37", "text": "我可以一击毙命。 我不是想"}, {"type": "subtitle", "time": 939.11, "timestamp": "00:15:39", "text": "一击必杀你。"}, {"type": "subtitle", "time": 939.509, "timestamp": "00:15:39", "text": "什么？"}, {"type": "subtitle", "time": 942.389, "timestamp": "00:15:42", "text": "他可以轻易杀死你和"}, {"type": "subtitle", "time": 943.99, "timestamp": "00:15:43", "text": "你周围的所有队友。 就连万"}, {"type": "subtitle", "time": 946.31, "timestamp": "00:15:46", "text": "磁王也是这样。 我的天啊。   是的"}, {"type": "subtitle", "time": 948.87, "timestamp": "00:15:48", "text": "。 他的一切都占据了所有的"}, {"type": "subtitle", "time": 957.03, "timestamp": "00:15:57", "text": "就像被吸进去了一样。我没被枪击。"}, {"type": "subtitle", "time": 959.749, "timestamp": "00:15:59", "text": "所有投射物攻击都会被万"}]
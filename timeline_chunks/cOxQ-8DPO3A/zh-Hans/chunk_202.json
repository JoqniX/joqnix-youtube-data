[{"type": "subtitle", "time": 12124.95, "timestamp": "03:22:04", "text": "糟糕。 太多事情了。"}, {"type": "subtitle", "time": 12125.51, "timestamp": "03:22:05", "text": "银河系。"}, {"type": "subtitle", "time": 12129.6, "timestamp": "03:22:09", "text": "你可以获得梯子，你可以获得单位。"}, {"type": "subtitle", "time": 12131.51, "timestamp": "03:22:11", "text": "[音乐]"}, {"type": "subtitle", "time": 12133.51, "timestamp": "03:22:13", "text": "你玩过吗？你"}, {"type": "subtitle", "time": 12136.55, "timestamp": "03:22:16", "text": "买过战斗通行证吗？"}, {"type": "subtitle", "time": 12139.269, "timestamp": "03:22:19", "text": "我可以免费买到它。"}, {"type": "subtitle", "time": 12143.19, "timestamp": "03:22:23", "text": "我相当确定，好像还有"}, {"type": "subtitle", "time": 12146.71, "timestamp": "03:22:26", "text": "两季，我可以"}, {"type": "subtitle", "time": 12147.83, "timestamp": "03:22:27", "text": "免费买一季。"}, {"type": "subtitle", "time": 12149.91, "timestamp": "03:22:29", "text": "等等，他们现在只有600个。"}, {"type": "subtitle", "time": 12155.11, "timestamp": "03:22:35", "text": "他们只有24个等级。 哇。"}, {"type": "subtitle", "time": 12158.15, "timestamp": "03:22:38", "text": "但我认为XP太难了。"}, {"type": "subtitle", "time": 12161.349, "timestamp": "03:22:41", "text": "很难得到。 是啊，很难"}, {"type": "subtitle", "time": 12163.91, "timestamp": "03:22:43", "text": "迟到。 然后游戏就开始进入后期"}, {"type": "subtitle", "time": 12167.51, "timestamp": "03:22:47", "text": "阶段了。 你看到这个东西了吗？ 那"}, {"type": "subtitle", "time": 12169.83, "timestamp": "03:22:49", "text": "是什么？ 那是什么？ 两次角落"}, {"type": "subtitle", "time": 12173.11, "timestamp": "03:22:53", "text": "风暴。 他们每个赛季结束时都会这样做"}, {"type": "subtitle", "time": 12175.429, "timestamp": "03:22:55", "text": "。 所以你大概四五天后就能解锁"}, {"type": "subtitle", "time": 12178.309, "timestamp": "03:22:58", "text": "战斗通行证的最后一部分"}]
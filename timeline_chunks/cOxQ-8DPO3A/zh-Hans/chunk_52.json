[{"type": "subtitle", "time": 3120.71, "timestamp": "00:52:00", "text": "那就像一股爆发力，造成了"}, {"type": "subtitle", "time": 3122.71, "timestamp": "00:52:02", "text": "巨大的破坏。 我不知道。"}, {"type": "subtitle", "time": 3125.43, "timestamp": "00:52:05", "text": "这会造成很大的破坏。"}, {"type": "subtitle", "time": 3128.63, "timestamp": "00:52:08", "text": "所以它就像是用你的右键射击，而不是像"}, {"type": "subtitle", "time": 3132.63, "timestamp": "00:52:12", "text": "手动射击那样，而是"}, {"type": "subtitle", "time": 3135.03, "timestamp": "00:52:15", "text": "自动射击。"}, {"type": "subtitle", "time": 3137.589, "timestamp": "00:52:17", "text": "哦，和"}, {"type": "subtitle", "time": 3139.03, "timestamp": "00:52:19", "text": "你的鼠标左键点击是一样的。 你的左键"}, {"type": "subtitle", "time": 3140.309, "timestamp": "00:52:20", "text": "点击操作相同，但右键点击操作"}, {"type": "subtitle", "time": 3141.99, "timestamp": "00:52:21", "text": "不同。"}, {"type": "subtitle", "time": 3143.349, "timestamp": "00:52:23", "text": "你只需要占领"}, {"type": "subtitle", "time": 3146.23, "timestamp": "00:52:26", "text": "任务区域即可。 知道了。"}, {"type": "subtitle", "time": 3147.589, "timestamp": "00:52:27", "text": "所以你知道这是什么吧？ 就像"}, {"type": "subtitle", "time": 3150.39, "timestamp": "00:52:30", "text": "占领据点、争夺山丘之王一样。 你"}, {"type": "subtitle", "time": 3151.75, "timestamp": "00:52:31", "text": "知道这种"}, {"type": "subtitle", "time": 3159.75, "timestamp": "00:52:39", "text": "哦，嘿，那是座桥。   是的"}, {"type": "subtitle", "time": 3161.75, "timestamp": "00:52:41", "text": "。 向右走，尝试从侧翼包抄"}, {"type": "subtitle", "time": 3164.069, "timestamp": "00:52:44", "text": "他们。 向右走。 我会帮助你"}, {"type": "subtitle", "time": 3165.43, "timestamp": "00:52:45", "text": "度过难关。 顺便说一下，在你身后。"}, {"type": "subtitle", "time": 3166.95, "timestamp": "00:52:46", "text": "你身后。 这里有个角色。 你"}, {"type": "subtitle", "time": 3169.19, "timestamp": "00:52:49", "text": "没看见他。 是的。 设法杀死"}, {"type": "subtitle", "time": 3170.71, "timestamp": "00:52:50", "text": "惩罚者。 试着干掉这边的惩罚者"}, {"type": "subtitle", "time": 3171.67, "timestamp": "00:52:51", "text": "。"}, {"type": "subtitle", "time": 3173.91, "timestamp": "00:52:53", "text": "看起来像是"}, {"type": "subtitle", "time": 3175.829, "timestamp": "00:52:55", "text": "抓到了。"}, {"type": "subtitle", "time": 3178.309, "timestamp": "00:52:58", "text": "你根本不知道怎么玩。 那是"}]
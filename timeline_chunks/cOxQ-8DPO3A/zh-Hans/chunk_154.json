[{"type": "subtitle", "time": 9241.59, "timestamp": "02:34:01", "text": "就可以随时一击秒杀你"}, {"type": "subtitle", "time": 9245.19, "timestamp": "02:34:05", "text": "。 是的，那些僵尸"}, {"type": "subtitle", "time": 9252.87, "timestamp": "02:34:12", "text": "带走了我的英雄。 这条路会走上"}, {"type": "subtitle", "time": 9253.429, "timestamp": "02:34:13", "text": "欺诈之路。"}, {"type": "subtitle", "time": 9255.03, "timestamp": "02:34:15", "text": "不，如果你愿意的话，你可以选择扮演同一个英雄"}, {"type": "subtitle", "time": 9257.75, "timestamp": "02:34:17", "text": "。"}, {"type": "subtitle", "time": 9259.59, "timestamp": "02:34:19", "text": "没关系。 完全没关系"}, {"type": "subtitle", "time": 9261.67, "timestamp": "02:34:21", "text": "。"}, {"type": "subtitle", "time": 9263.19, "timestamp": "02:34:23", "text": "好的。 好的。 下一轮，我要和"}, {"type": "subtitle", "time": 9273.51, "timestamp": "02:34:33", "text": "杰夫看起来很简单，因为它涉及到水的"}, {"type": "subtitle", "time": 9276.389, "timestamp": "02:34:36", "text": "分解。   是"}]
[{"type": "subtitle", "time": 5345.75, "timestamp": "01:29:05", "text": "我的天啊。"}, {"type": "subtitle", "time": 5347.35, "timestamp": "01:29:07", "text": "对，她就在那儿。 想办法杀了"}, {"type": "subtitle", "time": 5348.07, "timestamp": "01:29:08", "text": "她。   是的"}, {"type": "subtitle", "time": 5349.27, "timestamp": "01:29:09", "text": "。 是的。 我想。 我想。 我"}, {"type": "subtitle", "time": 5355.11, "timestamp": "01:29:15", "text": "哦，她，你怎么弄丢了那个？"}, {"type": "subtitle", "time": 5357.91, "timestamp": "01:29:17", "text": "哦，她划伤了我。 她情绪非常低落。"}, {"type": "subtitle", "time": 5360.629, "timestamp": "01:29:20", "text": "治疗师治好了她。 不，不，她夺走了我的"}, {"type": "subtitle", "time": 5364.709, "timestamp": "01:29:24", "text": "健康，还伤了我。"}, {"type": "subtitle", "time": 5390.31, "timestamp": "01:29:50", "text": "你能射杀他们中的任何一个吗？"}, {"type": "subtitle", "time": 5391.75, "timestamp": "01:29:51", "text": "哦，等等。"}]
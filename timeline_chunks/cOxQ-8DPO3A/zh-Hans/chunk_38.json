[{"type": "subtitle", "time": 2284.63, "timestamp": "00:38:04", "text": "哦，你知道，就像那"}, {"type": "subtitle", "time": 2286.63, "timestamp": "00:38:06", "text": "是另一部分。 顺便说一句，这很难做到"}, {"type": "subtitle", "time": 2290.069, "timestamp": "00:38:10", "text": "。 很难做到"}, {"type": "subtitle", "time": 2297.99, "timestamp": "00:38:17", "text": "但是，你的性格确实……让我来向"}, {"type": "subtitle", "time": 2300.63, "timestamp": "00:38:20", "text": "你展示一下它的闪光点。 真的，"}, {"type": "subtitle", "time": 2303.589, "timestamp": "00:38:23", "text": "让我从专业人士的角度来谈谈我的看法。"}, {"type": "subtitle", "time": 2305.27, "timestamp": "00:38:25", "text": "你看那边那些家伙，那些"}, {"type": "subtitle", "time": 2308.47, "timestamp": "00:38:28", "text": "小家伙们。 假设那些家伙……"}, {"type": "subtitle", "time": 2311.349, "timestamp": "00:38:31", "text": "让我给他们穿上降温服。"}, {"type": "subtitle", "time": 2313.67, "timestamp": "00:38:33", "text": "你的尾巴在这里。"}, {"type": "subtitle", "time": 2315.27, "timestamp": "00:38:35", "text": "双杀。 我们假设只有"}, {"type": "subtitle", "time": 2317.27, "timestamp": "00:38:37", "text": "两名治疗师。"}, {"type": "subtitle", "time": 2320.23, "timestamp": "00:38:40", "text": "你很容易就能看出，你绝对是最适合"}, {"type": "subtitle", "time": 2323.67, "timestamp": "00:38:43", "text": "不跟你一对一较量的角色。"}, {"type": "subtitle", "time": 2326.87, "timestamp": "00:38:46", "text": "首先，你已经拿到工资了。"}, {"type": "subtitle", "time": 2328.39, "timestamp": "00:38:48", "text": "咱们来试试一对一吧。 让我"}, {"type": "subtitle", "time": 2329.91, "timestamp": "00:38:49", "text": "先杀了你，让你满"}, {"type": "subtitle", "time": 2335.99, "timestamp": "00:38:55", "text": "从“"}, {"type": "subtitle", "time": 2338.47, "timestamp": "00:38:58", "text": "好的，我们开始了，一、二、三”中重生。 现在就去"}]
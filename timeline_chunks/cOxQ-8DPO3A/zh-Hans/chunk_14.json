[{"type": "subtitle", "time": 840.949, "timestamp": "00:14:00", "text": "不射头。 就像这两种伤害一样，"}, {"type": "subtitle", "time": 841.91, "timestamp": "00:14:01", "text": "你知道，你会因此受到"}, {"type": "subtitle", "time": 844.87, "timestamp": "00:14:04", "text": "致命的伤害。"}, {"type": "subtitle", "time": 846.47, "timestamp": "00:14:06", "text": "那是三个。"}, {"type": "subtitle", "time": 848.23, "timestamp": "00:14:08", "text": "即使你无法击中目标，你"}, {"type": "subtitle", "time": 850.71, "timestamp": "00:14:10", "text": "仍然能够造成足够的"}, {"type": "subtitle", "time": 852.87, "timestamp": "00:14:12", "text": "伤害。 而且，你知道，这个替代版本真的很好"}, {"type": "subtitle", "time": 855.189, "timestamp": "00:14:15", "text": "。"}, {"type": "subtitle", "time": 857.75, "timestamp": "00:14:17", "text": "就像一股爆发性的伤害。"}, {"type": "subtitle", "time": 860.32, "timestamp": "00:14:20", "text": "对游戏"}, {"type": "subtitle", "time": 862.949, "timestamp": "00:14:22", "text": "[音乐]造成了惊人的破坏"}, {"type": "subtitle", "time": 865.269, "timestamp": "00:14:25", "text": "。"}, {"type": "subtitle", "time": 868.15, "timestamp": "00:14:28", "text": "迷你机枪，对吧？"}, {"type": "subtitle", "time": 869.509, "timestamp": "00:14:29", "text": "SC。 是的。"}, {"type": "subtitle", "time": 870.15, "timestamp": "00:14:30", "text": "双杀。"}, {"type": "subtitle", "time": 872.949, "timestamp": "00:14:32", "text": "这造成了很大的损失。"}, {"type": "subtitle", "time": 877.03, "timestamp": "00:14:37", "text": "没有人能独自承受这一切。"}, {"type": "subtitle", "time": 878.389, "timestamp": "00:14:38", "text": "但是，是的，这个问题很"}, {"type": "subtitle", "time": 881.269, "timestamp": "00:14:41", "text": "容易解决。"}, {"type": "subtitle", "time": 884.47, "timestamp": "00:14:44", "text": "很容易反驳，"}, {"type": "subtitle", "time": 889.189, "timestamp": "00:14:49", "text": "让我来告诉你。 我想是"}, {"type": "subtitle", "time": 891.75, "timestamp": "00:14:51", "text": "因为你要记住你"}, {"type": "subtitle", "time": 895.03, "timestamp": "00:14:55", "text": "角色的……哦"}, {"type": "subtitle", "time": 896.87, "timestamp": "00:14:56", "text": "，还有友军伤害。"}, {"type": "subtitle", "time": 898.949, "timestamp": "00:14:58", "text": "你听到了人们的议论。 我的天啊。"}]
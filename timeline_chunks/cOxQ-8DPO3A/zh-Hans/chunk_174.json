[{"type": "subtitle", "time": 10441.429, "timestamp": "02:54:01", "text": "礼包的话，我记得好像是32个金币。是"}, {"type": "subtitle", "time": 10444.55, "timestamp": "02:54:04", "text": "32个还是28个？ 不，不，两个角色捆绑包的价格是 28"}, {"type": "subtitle", "time": 10445.59, "timestamp": "02:54:05", "text": "。"}, {"type": "subtitle", "time": 10447.429, "timestamp": "02:54:07", "text": "哦，糟糕。"}, {"type": "subtitle", "time": 10450.23, "timestamp": "02:54:10", "text": "疯狂的。 是的，"}, {"type": "subtitle", "time": 10453.19, "timestamp": "02:54:13", "text": "这不是“如果你”的问题。我在"}, {"type": "subtitle", "time": 10455.429, "timestamp": "02:54:15", "text": "推特上见过一个人。"}, {"type": "subtitle", "time": 10458.07, "timestamp": "02:54:18", "text": "我在推特上看到了。 嗯，他"}, {"type": "subtitle", "time": 10461.349, "timestamp": "02:54:21", "text": "从第一季就开始攒积分，"}, {"type": "subtitle", "time": 10468.63, "timestamp": "02:54:28", "text": "等等，8000？"}, {"type": "subtitle", "time": 10470.07, "timestamp": "02:54:30", "text": "一共多少钱？"}, {"type": "subtitle", "time": 10473.11, "timestamp": "02:54:33", "text": "是的，8000台。"}, {"type": "subtitle", "time": 10475.59, "timestamp": "02:54:35", "text": "哦，这款游戏免费赠送的东西真不少"}, {"type": "subtitle", "time": 10478.07, "timestamp": "02:54:38", "text": "。 那差不多有八款皮肤，"}, {"type": "subtitle", "time": 10480.469, "timestamp": "02:54:40", "text": "至少有五款"}, {"type": "subtitle", "time": 10485.67, "timestamp": "02:54:45", "text": "史诗级皮肤和三款传说级皮肤。"}, {"type": "subtitle", "time": 10494.71, "timestamp": "02:54:54", "text": "这些僵尸已经被"}, {"type": "subtitle", "time": 10497.19, "timestamp": "02:54:57", "text": "混沌魔法腐化了，消灭"}, {"type": "subtitle", "time": 10499.19, "timestamp": "02:54:59", "text": "它们吧。"}]
[{"type": "subtitle", "time": 7501.589, "timestamp": "02:05:01", "text": "该死的钢铁侠。 把那肮脏的东西从"}, {"type": "subtitle", "time": 7511.51, "timestamp": "02:05:11", "text": "未来。 来帮我杀了他。"}, {"type": "subtitle", "time": 7513.51, "timestamp": "02:05:13", "text": "抓到他了。 抓到他了。   是的"}, {"type": "subtitle", "time": 7521.99, "timestamp": "02:05:21", "text": "等待。 回来。 你有什么取胜之道吗？   是的"}, {"type": "subtitle", "time": 7523.589, "timestamp": "02:05:23", "text": "。 测一下血压。 得到它。 把他从"}, {"type": "subtitle", "time": 7525.669, "timestamp": "02:05:25", "text": "我的屏幕上移开。 是啊，真脏。"}, {"type": "subtitle", "time": 7527.75, "timestamp": "02:05:27", "text": "好的。"}, {"type": "subtitle", "time": 7531.669, "timestamp": "02:05:31", "text": "BP在哪里？ 巴尔帕斯。 等等，"}, {"type": "subtitle", "time": 7533.83, "timestamp": "02:05:33", "text": "黑豹。 搞定钢铁侠。 把"}, {"type": "subtitle", "time": 7537.669, "timestamp": "02:05:37", "text": "那家伙从我的屏幕上弄走。"}, {"type": "subtitle", "time": 7539.669, "timestamp": "02:05:39", "text": "他在哪儿？"}, {"type": "subtitle", "time": 7541.27, "timestamp": "02:05:41", "text": "我给他发了条消息。 他在那边。 是的。 是的。   是的"}]
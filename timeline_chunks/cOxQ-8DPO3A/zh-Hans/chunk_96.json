[{"type": "subtitle", "time": 5781.669, "timestamp": "01:36:21", "text": "说到重点吧。 你要去哪里？"}, {"type": "subtitle", "time": 5792.87, "timestamp": "01:36:32", "text": "枪杀任何人。"}, {"type": "subtitle", "time": 5794.79, "timestamp": "01:36:34", "text": "没有。"}, {"type": "subtitle", "time": 5796.87, "timestamp": "01:36:36", "text": "为什么？"}, {"type": "subtitle", "time": 5800.47, "timestamp": "01:36:40", "text": "等等，我正在射杀人，但"}, {"type": "subtitle", "time": 5801.51, "timestamp": "01:36:41", "text": "我不知道他们在做什么。"}, {"type": "subtitle", "time": 5803.669, "timestamp": "01:36:43", "text": "我真的当着"}, {"type": "subtitle", "time": 5806.709, "timestamp": "01:36:46", "text": "你的面，一口气拍了四个。"}, {"type": "subtitle", "time": 5809.109, "timestamp": "01:36:49", "text": "哦，"}, {"type": "subtitle", "time": 5811.59, "timestamp": "01:36:51", "text": "为什么我们不能开枪？ 你被"}, {"type": "subtitle", "time": 5815.75, "timestamp": "01:36:55", "text": "击晕了。 运用你的所有资源。 我的天哪。   是的"}, {"type": "subtitle", "time": 5817.189, "timestamp": "01:36:57", "text": "。"}]
[{"type": "subtitle", "time": 5105.669, "timestamp": "01:25:05", "text": "想搞到蜘蛛侠。"}, {"type": "subtitle", "time": 5110.87, "timestamp": "01:25:10", "text": "啊，飞翔的女人。"}, {"type": "subtitle", "time": 5113.51, "timestamp": "01:25:13", "text": "哦，你剪了个渐变发型。"}, {"type": "subtitle", "time": 5116.229, "timestamp": "01:25:16", "text": "我的渐变效果用完了。"}, {"type": "subtitle", "time": 5121.75, "timestamp": "01:25:21", "text": "呃，一共三次，两次。 一个是"}, {"type": "subtitle", "time": 5124.87, "timestamp": "01:25:24", "text": "蜘蛛侠，一个是"}, {"type": "subtitle", "time": 5129.35, "timestamp": "01:25:29", "text": "我的天啊。"}, {"type": "subtitle", "time": 5131.35, "timestamp": "01:25:31", "text": "你为什么要"}, {"type": "subtitle", "time": 5135.35, "timestamp": "01:25:35", "text": "针对他们？ 我吞噬了"}]
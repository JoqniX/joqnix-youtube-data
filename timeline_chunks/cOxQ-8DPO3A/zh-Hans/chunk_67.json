[{"type": "subtitle", "time": 4020.87, "timestamp": "01:07:00", "text": "出去？"}, {"type": "subtitle", "time": 4022.15, "timestamp": "01:07:02", "text": "想办法杀了她。 试着见见她，然后杀了"}, {"type": "subtitle", "time": 4026.23, "timestamp": "01:07:06", "text": "她。 找到她，杀了她。 找到她，杀了她。"}, {"type": "subtitle", "time": 4028.71, "timestamp": "01:07:08", "text": "现在在上面。 干掉上面那个人"}, {"type": "subtitle", "time": 4031.109, "timestamp": "01:07:11", "text": "。"}, {"type": "subtitle", "time": 4033.43, "timestamp": "01:07:13", "text": "啊，靶场。"}, {"type": "subtitle", "time": 4035.43, "timestamp": "01:07:15", "text": "我的天啊。"}, {"type": "subtitle", "time": 4037.19, "timestamp": "01:07:17", "text": "你射程超远，但完全不需要"}, {"type": "subtitle", "time": 4039.029, "timestamp": "01:07:19", "text": "瞄准。 顺便说一下，上面这里有"}, {"type": "subtitle", "time": 4052.71, "timestamp": "01:07:32", "text": "什么？"}, {"type": "subtitle", "time": 4059.029, "timestamp": "01:07:39", "text": "你能看到并尝试射击吗？   当然"}, {"type": "subtitle", "time": 4065.029, "timestamp": "01:07:45", "text": "试着杀了这边的佩妮。 不要过度"}, {"type": "subtitle", "time": 4067.589, "timestamp": "01:07:47", "text": "投入。 她在"}, {"type": "subtitle", "time": 4069.99, "timestamp": "01:07:49", "text": "左边那边。 往左边走，试着杀了"}, {"type": "subtitle", "time": 4071.109, "timestamp": "01:07:51", "text": "她。"}, {"type": "subtitle", "time": 4078.15, "timestamp": "01:07:58", "text": "这里中间有个眩晕型选手"}]
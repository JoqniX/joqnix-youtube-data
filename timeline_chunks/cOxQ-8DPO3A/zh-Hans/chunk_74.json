[{"type": "subtitle", "time": 4441.59, "timestamp": "01:14:01", "text": "脑子有点问题，反应有点慢？还是怎么了？"}, {"type": "subtitle", "time": 4443.99, "timestamp": "01:14:03", "text": "没关系。"}, {"type": "subtitle", "time": 4445.91, "timestamp": "01:14:05", "text": "杀戮。 他们杀了死人。"}, {"type": "subtitle", "time": 4454.149, "timestamp": "01:14:14", "text": "好吧，"}, {"type": "subtitle", "time": 4468.07, "timestamp": "01:14:28", "text": "，我被吞下去了。 啊，"}, {"type": "subtitle", "time": 4471.03, "timestamp": "01:14:31", "text": "你可以渐渐消失。"}, {"type": "subtitle", "time": 4472.55, "timestamp": "01:14:32", "text": "那真是糟糕透了。哦，谢天谢地。"}, {"type": "subtitle", "time": 4474.31, "timestamp": "01:14:34", "text": "你应该感到高兴。 你应该庆幸"}, {"type": "subtitle", "time": 4477.03, "timestamp": "01:14:37", "text": "你的团队很优秀。 否则，你"}, {"type": "subtitle", "time": 4479.35, "timestamp": "01:14:39", "text": "就不像个好"}, {"type": "subtitle", "time": 4480.709, "timestamp": "01:14:40", "text": "队友。   是的"}, {"type": "subtitle", "time": 4483.11, "timestamp": "01:14:43", "text": "。"}, {"type": "subtitle", "time": 4484.229, "timestamp": "01:14:44", "text": "我的天啊。"}, {"type": "subtitle", "time": 4499.35, "timestamp": "01:14:59", "text": "搞定这家伙。"}]
[{"type": "subtitle", "time": 3180.549, "timestamp": "00:53:00", "text": "褪色，我的兄弟。 褪色。"}, {"type": "subtitle", "time": 3185.99, "timestamp": "00:53:05", "text": "你在干什么？"}, {"type": "subtitle", "time": 3189.03, "timestamp": "00:53:09", "text": "我不知道自己在做什么。"}, {"type": "subtitle", "time": 3192.549, "timestamp": "00:53:12", "text": "我必须杀了那家伙。"}, {"type": "subtitle", "time": 3194.71, "timestamp": "00:53:14", "text": "P 是最容易杀死的角色，"}, {"type": "subtitle", "time": 3197.589, "timestamp": "00:53:17", "text": "而且他正在苦苦挣扎。 真令人难过。"}, {"type": "subtitle", "time": 3205.349, "timestamp": "00:53:25", "text": "试着杀死它。 不，不，别这样。"}, {"type": "subtitle", "time": 3207.03, "timestamp": "00:53:27", "text": "后退。 后退。 后退。 后退。"}, {"type": "subtitle", "time": 3208.79, "timestamp": "00:53:28", "text": "后退。 后退。 后退。 渐渐消失。 渐渐"}, {"type": "subtitle", "time": 3210.63, "timestamp": "00:53:30", "text": "消失。 渐渐消失。"}, {"type": "subtitle", "time": 3213.91, "timestamp": "00:53:33", "text": "不过我的伤口瞬间就愈合了。"}, {"type": "subtitle", "time": 3220.23, "timestamp": "00:53:40", "text": "治愈者并不远。 是的。 是的。 看着她杀了"}, {"type": "subtitle", "time": 3221.67, "timestamp": "00:53:41", "text": "她。"}, {"type": "subtitle", "time": 3222.309, "timestamp": "00:53:42", "text": "啊，"}, {"type": "subtitle", "time": 3232.63, "timestamp": "00:53:52", "text": "他们现在有只黑豹了。 现在就等"}, {"type": "subtitle", "time": 3234.63, "timestamp": "00:53:54", "text": "黑豹出现了。 好的。 别贸然"}, {"type": "subtitle", "time": 3236.39, "timestamp": "00:53:56", "text": "行动。等黑豹"}, {"type": "subtitle", "time": 3238.47, "timestamp": "00:53:58", "text": "出现，再把他杀了。 哦"}]
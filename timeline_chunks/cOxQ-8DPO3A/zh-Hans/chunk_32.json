[{"type": "subtitle", "time": 1920.23, "timestamp": "00:32:00", "text": "好的。"}, {"type": "subtitle", "time": 1927.11, "timestamp": "00:32:07", "text": "她不会让你惊呆。 她可以像变身一样自动消失，就像……"}, {"type": "subtitle", "time": 1933.19, "timestamp": "00:32:13", "text": "哦，那个角色也有"}, {"type": "subtitle", "time": 1936.149, "timestamp": "00:32:16", "text": "吸血能力。 你知道"}, {"type": "subtitle", "time": 1940.63, "timestamp": "00:32:20", "text": "吗？ 直播中没有瞄准命中标记。"}, {"type": "subtitle", "time": 1942.389, "timestamp": "00:32:22", "text": "你读过那篇文章吗？"}, {"type": "subtitle", "time": 1943.19, "timestamp": "00:32:23", "text": "啊，原来它"}, {"type": "subtitle", "time": 1946.07, "timestamp": "00:32:26", "text": "有两个字符。"}, {"type": "subtitle", "time": 1950.389, "timestamp": "00:32:30", "text": "如果你还不知道的话，这款要好得多，因为它具有自动瞄准功能。"}, {"type": "subtitle", "time": 1952.63, "timestamp": "00:32:32", "text": "等等，什么？ 真的吗？ 哇。"}, {"type": "subtitle", "time": 1954.95, "timestamp": "00:32:34", "text": "是的，它会自动瞄准。 但它确实有治愈作用"}, {"type": "subtitle", "time": 1957.83, "timestamp": "00:32:37", "text": "。 你想扮演治疗者吗？"}, {"type": "subtitle", "time": 1958.549, "timestamp": "00:32:38", "text": "他会的。"}, {"type": "subtitle", "time": 1959.19, "timestamp": "00:32:39", "text": "我不知道。"}, {"type": "subtitle", "time": 1962.789, "timestamp": "00:32:42", "text": "第三和第四个就是这个"}, {"type": "subtitle", "time": 1963.75, "timestamp": "00:32:43", "text": "人。"}, {"type": "subtitle", "time": 1973.43, "timestamp": "00:32:53", "text": "拥抱混乱。"}, {"type": "subtitle", "time": 1975.43, "timestamp": "00:32:55", "text": "你死了吗？"}, {"type": "subtitle", "time": 1977.11, "timestamp": "00:32:57", "text": "不，我没有死。"}]
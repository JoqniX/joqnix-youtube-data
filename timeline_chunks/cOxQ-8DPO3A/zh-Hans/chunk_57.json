[{"type": "subtitle", "time": 3420.47, "timestamp": "00:57:00", "text": "惩罚者在中间，我被"}, {"type": "subtitle", "time": 3436.23, "timestamp": "00:57:16", "text": "好了，进来了。"}, {"type": "subtitle", "time": 3440.549, "timestamp": "00:57:20", "text": "没错，那家伙干得真棒。"}, {"type": "subtitle", "time": 3443.75, "timestamp": "00:57:23", "text": "你还没用过你的C吧？"}, {"type": "subtitle", "time": 3450.789, "timestamp": "00:57:30", "text": "哦，没事了。"}, {"type": "subtitle", "time": 3454.309, "timestamp": "00:57:34", "text": "好吧，让我来告诉你事情的经过。"}, {"type": "subtitle", "time": 3457.829, "timestamp": "00:57:37", "text": "用你的C技能烧毁坦克。 好的。 它对"}, {"type": "subtitle", "time": 3460.63, "timestamp": "00:57:40", "text": "坦克造成了很大的破坏。"}, {"type": "subtitle", "time": 3461.51, "timestamp": "00:57:41", "text": "答对了。   是的"}, {"type": "subtitle", "time": 3462.549, "timestamp": "00:57:42", "text": "。"}, {"type": "subtitle", "time": 3464.71, "timestamp": "00:57:44", "text": "用那个给万磁王用。 你知道"}, {"type": "subtitle", "time": 3467.27, "timestamp": "00:57:47", "text": "坦克型角色要阻止的是什么吗？"}, {"type": "subtitle", "time": 3471.43, "timestamp": "00:57:51", "text": "呃，绿巨人。 呃呃，还有谁？"}, {"type": "subtitle", "time": 3473.109, "timestamp": "00:57:53", "text": "不，你就是知道。 你只要回答“是”或“"}, {"type": "subtitle", "time": 3474.47, "timestamp": "00:57:54", "text": "否”就行了。"}, {"type": "subtitle", "time": 3476.39, "timestamp": "00:57:56", "text": "对，有点像那些扮演 Buffy 的人。   是《吸血鬼猎人"}, {"type": "subtitle", "time": 3477.99, "timestamp": "00:57:57", "text": "巴菲》吧？   是的"}]
[{"type": "subtitle", "time": 5641.11, "timestamp": "01:34:01", "text": "的天哪，他隐形了。"}, {"type": "subtitle", "time": 5643.189, "timestamp": "01:34:03", "text": "你怎么总是死掉？"}, {"type": "subtitle", "time": 5646.79, "timestamp": "01:34:06", "text": "那里有看不见的东西。"}, {"type": "subtitle", "time": 5648.95, "timestamp": "01:34:08", "text": "他做不到。"}, {"type": "subtitle", "time": 5651.43, "timestamp": "01:34:11", "text": "什么？ 那么是谁杀了我？"}, {"type": "subtitle", "time": 5654.47, "timestamp": "01:34:14", "text": "不，他会让你失明。"}, {"type": "subtitle", "time": 5657.51, "timestamp": "01:34:17", "text": "啊，是的。 他从后面冲过来，双目失明。 我当时"}, {"type": "subtitle", "time": 5659.35, "timestamp": "01:34:19", "text": "就想：“哦，身后有脚步声。”"}, {"type": "subtitle", "time": 5663.35, "timestamp": "01:34:23", "text": "于是，我面对了。 他还没"}, {"type": "subtitle", "time": 5691.51, "timestamp": "01:34:51", "text": "你他妈在哪儿？ 为什么？ 不，别"}, {"type": "subtitle", "time": 5698.55, "timestamp": "01:34:58", "text": "艾尔现在就在这里。 艾尔现在就在这里。 艾尔现在就在这里"}]
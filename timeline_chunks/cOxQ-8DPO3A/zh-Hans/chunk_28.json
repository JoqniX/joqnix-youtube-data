title", "time": 1733.19, "timestamp": "00:28:53", "text": "以青本之见。"}, {"type": "subtitle", "time": 1736.87, "timestamp": "00:28:56", "text": "等等，有眩晕效果。 脚下被击晕。"}, {"type": "subtitle", "time": 1738.95, "timestamp": "00:28:58", "text": "瞧不起。"}]
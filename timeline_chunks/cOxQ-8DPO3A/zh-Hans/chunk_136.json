[{"type": "subtitle", "time": 8162.31, "timestamp": "02:16:02", "text": "卡片。"}, {"type": "subtitle", "time": 8163.99, "timestamp": "02:16:03", "text": "你的能力是通过卡牌获得的。"}, {"type": "subtitle", "time": 8165.189, "timestamp": "02:16:05", "text": "你会看到的。"}, {"type": "subtitle", "time": 8168.629, "timestamp": "02:16:08", "text": "你只有一个任务，那就是握紧我的拳头。 找到"}, {"type": "subtitle", "time": 8172.55, "timestamp": "02:16:12", "text": "亡灵女王，除掉她。 但是"}, {"type": "subtitle", "time": 8174.069, "timestamp": "02:16:14", "text": "，在这个游戏模式中，最合适的角色"}, {"type": "subtitle", "time": 8175.99, "timestamp": "02:16:15", "text": "是刀锋，但我们不会"}, {"type": "subtitle", "time": 8186.47, "timestamp": "02:16:26", "text": "时候"}, {"type": "subtitle", "time": 8197.19, "timestamp": "02:16:37", "text": "我把所有东西都买齐了。"}, {"type": "subtitle", "time": 8199.429, "timestamp": "02:16:39", "text": "就像我说的，我只买了红卡。"}, {"type": "subtitle", "time": 8201.11, "timestamp": "02:16:41", "text": "你也可以刷新页面。 顺便说一下，"}, {"type": "subtitle", "time": 8203.75, "timestamp": "02:16:43", "text": "页面。"}, {"type": "subtitle", "time": 8206.629, "timestamp": "02:16:46", "text": "啊，"}, {"type": "subtitle", "time": 8215.83, "timestamp": "02:16:55", "text": "这没有颜色之分。"}, {"type": "subtitle", "time": 8217.03, "timestamp": "02:16:57", "text": "颜色代表什么？"}, {"type": "subtitle", "time": 8218.549, "timestamp": "02:16:58", "text": "他们说僵尸会有不同的颜色"}]
[{"type": "subtitle", "time": 3905.109, "timestamp": "01:05:05", "text": "报酬。 好的。"}, {"type": "subtitle", "time": 3906.95, "timestamp": "01:05:06", "text": "好一个。 好吧，他死了。 他为了"}, {"type": "subtitle", "time": 3909.029, "timestamp": "01:05:09", "text": "杀你而死。 好的，"}, {"type": "subtitle", "time": 3921.829, "timestamp": "01:05:21", "text": "嗯，"}, {"type": "subtitle", "time": 3923.67, "timestamp": "01:05:23", "text": "为什么你们在那边的时候，他们都死了呢"}, {"type": "subtitle", "time": 3931.109, "timestamp": "01:05:31", "text": "我的天哪，我就是那个要死的人。 谢谢。"}, {"type": "subtitle", "time": 3932.23, "timestamp": "01:05:32", "text": "谢谢。 谢谢。"}, {"type": "subtitle", "time": 3934.069, "timestamp": "01:05:34", "text": "你的发型是渐变的。 我们将如何"}, {"type": "subtitle", "time": 3935.029, "timestamp": "01:05:35", "text": "死去？"}, {"type": "subtitle", "time": 3942.95, "timestamp": "01:05:42", "text": "想办法杀了这家伙。 我的天哪，我"}, {"type": "subtitle", "time": 3943.99, "timestamp": "01:05:43", "text": "杀了他。"}, {"type": "subtitle", "time": 3945.349, "timestamp": "01:05:45", "text": "哦，"}, {"type": "subtitle", "time": 3946.95, "timestamp": "01:05:46", "text": "试试看能不能拍到传单。 我打算给"}, {"type": "subtitle", "time": 3948.87, "timestamp": "01:05:48", "text": "他发个消息。 试着去追他。 你为什么"}, {"type": "subtitle", "time": 3951.029, "timestamp": "01:05:51", "text": "要走？ 你为何逐渐淡出？"}, {"type": "subtitle", "time": 3959.829, "timestamp": "01:05:59", "text": "我说有个角色在飞。"}]
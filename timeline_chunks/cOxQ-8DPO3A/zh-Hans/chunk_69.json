[{"type": "subtitle", "time": 4141.03, "timestamp": "01:09:01", "text": "？ 你现在是什么意思？ 你知道，我"}, {"type": "subtitle", "time": 4144.149, "timestamp": "01:09:04", "text": "不这么认为。"}, {"type": "subtitle", "time": 4161.43, "timestamp": "01:09:21", "text": "你必须……你必须……你不会"}, {"type": "subtitle", "time": 4163.03, "timestamp": "01:09:23", "text": "选择你想杀死的角色。"}, {"type": "subtitle", "time": 4165.269, "timestamp": "01:09:25", "text": "你就像一头撞上了"}, {"type": "subtitle", "time": 4167.03, "timestamp": "01:09:27", "text": "五个壮汉。   是的"}, {"type": "subtitle", "time": 4170.789, "timestamp": "01:09:30", "text": "。 如果我想杀人的时候，"}, {"type": "subtitle", "time": 4173.669, "timestamp": "01:09:33", "text": "其他人出现了，"}, {"type": "subtitle", "time": 4176.229, "timestamp": "01:09:36", "text": "然后就消失了。   我的"}, {"type": "subtitle", "time": 4184.55, "timestamp": "01:09:44", "text": "。 你"}, {"type": "subtitle", "time": 4186.709, "timestamp": "01:09:46", "text": "不知道吗？"}, {"type": "subtitle", "time": 4192.309, "timestamp": "01:09:52", "text": "我的天啊。"}, {"type": "subtitle", "time": 4193.99, "timestamp": "01:09:53", "text": "你明明知道答案，却还是"}, {"type": "subtitle", "time": 4196.87, "timestamp": "01:09:56", "text": "没做？"}, {"type": "subtitle", "time": 4197.11, "timestamp": "01:09:57", "text": "你说得对"}, {"type": "subtitle", "time": 4199.91, "timestamp": "01:09:59", "text": "。"}]
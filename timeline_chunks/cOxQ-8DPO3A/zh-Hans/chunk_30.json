[{"type": "subtitle", "time": 1801.75, "timestamp": "00:30:01", "text": "你的小号基本上能造成 999 点伤害。"}, {"type": "subtitle", "time": 1803.909, "timestamp": "00:30:03", "text": "哦，为什么呢？"}, {"type": "subtitle", "time": 1807.35, "timestamp": "00:30:07", "text": "所以，是的，"}, {"type": "subtitle", "time": 1810.149, "timestamp": "00:30:10", "text": "基本上所有东西都会被它们自己的生命所毁灭。"}, {"type": "subtitle", "time": 1811.669, "timestamp": "00:30:11", "text": "哦，"}, {"type": "subtitle", "time": 1815.029, "timestamp": "00:30:15", "text": "而且它还会让一些"}, {"type": "subtitle", "time": 1817.83, "timestamp": "00:30:17", "text": "你认识的人觉得，比如“过来，"}, {"type": "subtitle", "time": 1820.47, "timestamp": "00:30:20", "text": "我先暂停一下友军误伤”"}, {"type": "subtitle", "time": 1823.35, "timestamp": "00:30:23", "text": "。"}, {"type": "subtitle", "time": 1825.99, "timestamp": "00:30:25", "text": "我曾目睹整个世界被"}, {"type": "subtitle", "time": 1827.99, "timestamp": "00:30:27", "text": "混乱吞噬。"}, {"type": "subtitle", "time": 1835.269, "timestamp": "00:30:35", "text": "看看这个。"}, {"type": "subtitle", "time": 1837.43, "timestamp": "00:30:37", "text": "它正在把它们吸进去。 它吸进去了。"}, {"type": "subtitle", "time": 1838.47, "timestamp": "00:30:38", "text": "哦，是的。"}, {"type": "subtitle", "time": 1839.51, "timestamp": "00:30:39", "text": "你的命运已定。"}, {"type": "subtitle", "time": 1841.99, "timestamp": "00:30:41", "text": "好的。 虽然它们不像其他吸盘那样容易被"}, {"type": "subtitle", "time": 1843.59, "timestamp": "00:30:43", "text": "吸进去，但它们确实会"}, {"type": "subtitle", "time": 1845.669, "timestamp": "00:30:45", "text": "变慢。 好的。"}, {"type": "subtitle", "time": 1847.269, "timestamp": "00:30:47", "text": "知道了。"}, {"type": "subtitle", "time": 1849.43, "timestamp": "00:30:49", "text": "所以，"}, {"type": "subtitle", "time": 1851.99, "timestamp": "00:30:51", "text": "你对抗你小号的主要手段就是"}, {"type": "subtitle", "time": 1853.51, "timestamp": "00:30:53", "text": "眩晕。"}, {"type": "subtitle", "time": 1855.909, "timestamp": "00:30:55", "text": "好的，"}, {"type": "subtitle", "time": 1858.47, "timestamp": "00:30:58", "text": "友军伤害恢复，冷却功能"}]
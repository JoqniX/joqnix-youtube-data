[{"type": "subtitle", "time": 1740.63, "timestamp": "00:29:00", "text": "这次"}, {"type": "subtitle", "time": 1748.549, "timestamp": "00:29:08", "text": "天哪，我错过了。"}, {"type": "subtitle", "time": 1750.549, "timestamp": "00:29:10", "text": "试着用脚做。 好的。 不，"}, {"type": "subtitle", "time": 1758.389, "timestamp": "00:29:18", "text": "哦，你我。 好的。 好的。 好的。"}, {"type": "subtitle", "time": 1760.47, "timestamp": "00:29:20", "text": "你可以把人从备用位置击晕。 让"}, {"type": "subtitle", "time": 1762.23, "timestamp": "00:29:22", "text": "我来告诉你。"}, {"type": "subtitle", "time": 1762.63, "timestamp": "00:29:22", "text": "好的。"}, {"type": "subtitle", "time": 1765.99, "timestamp": "00:29:25", "text": "有些特定的技能可以造成眩晕。"}, {"type": "subtitle", "time": 1768.549, "timestamp": "00:29:28", "text": "即使他们正在使用 Alting，它仍然可以造成眩晕，但"}, {"type": "subtitle", "time": 1770.07, "timestamp": "00:29:30", "text": "不会阻止所有攻击。 首先，"}, {"type": "subtitle", "time": 1772.31, "timestamp": "00:29:32", "text": "你刚才已经看到，"}, {"type": "subtitle", "time": 1774.549, "timestamp": "00:29:34", "text": "当你眩晕对手时，你可以抵消绯红女巫的所有技能。"}, {"type": "subtitle", "time": 1776.389, "timestamp": "00:29:36", "text": "斯塔洛尔和其他许多"}, {"type": "subtitle", "time": 1778.149, "timestamp": "00:29:38", "text": "角色也是如此。"}, {"type": "subtitle", "time": 1778.87, "timestamp": "00:29:38", "text": "哦，"}, {"type": "subtitle", "time": 1780.71, "timestamp": "00:29:40", "text": "我只是想告诉你，这是有可能实现的"}, {"type": "subtitle", "time": 1782.71, "timestamp": "00:29:42", "text": "。 你不需要像使用"}, {"type": "subtitle", "time": 1785.59, "timestamp": "00:29:45", "text": "他们的"}, {"type": "subtitle", "time": 1786.95, "timestamp": "00:29:46", "text": "辅助技能那样只击晕敌人。 好吧，"}, {"type": "subtitle", "time": 1788.31, "timestamp": "00:29:48", "text": "我只是告诉你，它有可能造成"}, {"type": "subtitle", "time": 1790.23, "timestamp": "00:29:50", "text": "眩晕。"}, {"type": "subtitle", "time": 1796.71, "timestamp": "00:29:56", "text": "好的，现在换回备用机。 所以"}]
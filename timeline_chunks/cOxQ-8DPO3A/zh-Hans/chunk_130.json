[{"type": "subtitle", "time": 7801.83, "timestamp": "02:10:01", "text": "这是一场快节奏的比赛，他们只有一个"}, {"type": "subtitle", "time": 7804.39, "timestamp": "02:10:04", "text": "治疗者。 是的。"}, {"type": "subtitle", "time": 7805.91, "timestamp": "02:10:05", "text": "他们有两个孩子的时候，其中一个叫杰夫。 我"}, {"type": "subtitle", "time": 7814.55, "timestamp": "02:10:14", "text": "我们要变成僵尸了，对吧？"}, {"type": "subtitle", "time": 7816.149, "timestamp": "02:10:16", "text": "是的，我们可以玩僵尸游戏。 你"}, {"type": "subtitle", "time": 7817.189, "timestamp": "02:10:17", "text": "以前玩过僵尸模式吗？"}, {"type": "subtitle", "time": 7817.589, "timestamp": "02:10:17", "text": "没有。"}, {"type": "subtitle", "time": 7818.95, "timestamp": "02:10:18", "text": "我是说，在这个游戏中。"}, {"type": "subtitle", "time": 7821.189, "timestamp": "02:10:21", "text": "没有。"}, {"type": "subtitle", "time": 7824.39, "timestamp": "02:10:24", "text": "很有趣。 它就像把你"}, {"type": "subtitle", "time": 7827.03, "timestamp": "02:10:27", "text": "带回了“给我一秒钟”的那一刻。"}, {"type": "subtitle", "time": 7828.95, "timestamp": "02:10:28", "text": "咱们就休息一下吧，老兄。"}, {"type": "subtitle", "time": 7829.27, "timestamp": "02:10:29", "text": "该死。"}, {"type": "subtitle", "time": 7831.91, "timestamp": "02:10:31", "text": "哦，等等。 是的。 是的。   我的天哪"}, {"type": "subtitle", "time": 7836.709, "timestamp": "02:10:36", "text": "。 我不是主播。"}, {"type": "subtitle", "time": 7840.47, "timestamp": "02:10:40", "text": "我没有你那么充沛的精力。"}, {"type": "subtitle", "time": 7841.91, "timestamp": "02:10:41", "text": "稍等片刻。 让我"}, {"type": "subtitle", "time": 7843.99, "timestamp": "02:10:43", "text": "撒泡尿。 让我喝口水，"}, {"type": "subtitle", "time": 7847.43, "timestamp": "02:10:47", "text": "老兄。 为自己这样做。   是的"}]
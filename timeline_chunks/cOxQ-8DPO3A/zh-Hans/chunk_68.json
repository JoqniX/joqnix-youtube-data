[{"type": "subtitle", "time": 4080.39, "timestamp": "01:08:00", "text": "。 你为什么要绕路"}, {"type": "subtitle", "time": 4082.15, "timestamp": "01:08:02", "text": "？ 好的。 看到杰夫时就消失"}, {"type": "subtitle", "time": 4084.309, "timestamp": "01:08:04", "text": "。"}, {"type": "subtitle", "time": 4088.39, "timestamp": "01:08:08", "text": "啊，这家伙。"}, {"type": "subtitle", "time": 4099.43, "timestamp": "01:08:19", "text": "到底发生了什么？ 我的天啊。"}, {"type": "subtitle", "time": 4101.349, "timestamp": "01:08:21", "text": "你必须全部做到。你能全部做到吗？"}, {"type": "subtitle", "time": 4104.709, "timestamp": "01:08:24", "text": "等等，等等，等等，等等。"}, {"type": "subtitle", "time": 4106.55, "timestamp": "01:08:26", "text": "你在哪里？"}, {"type": "subtitle", "time": 4107.829, "timestamp": "01:08:27", "text": "搞什么鬼？   我"}, {"type": "subtitle", "time": 4113.669, "timestamp": "01:08:33", "text": "但你得动动脑子啊。"}, {"type": "subtitle", "time": 4117.03, "timestamp": "01:08:37", "text": "我的天哪，"}, {"type": "subtitle", "time": 4119.269, "timestamp": "01:08:39", "text": "妈妈。 阿莱德。 你知道他们可以躲在"}, {"type": "subtitle", "time": 4121.03, "timestamp": "01:08:41", "text": "墙后面，而不会被你的"}, {"type": "subtitle", "time": 4122.47, "timestamp": "01:08:42", "text": "小号打到。 你知道的，对吧？ 难道你不"}, {"type": "subtitle", "time": 4123.269, "timestamp": "01:08:43", "text": "知道吗？"}, {"type": "subtitle", "time": 4126.07, "timestamp": "01:08:46", "text": "我不知道这件事。"}, {"type": "subtitle", "time": 4128.149, "timestamp": "01:08:48", "text": "什么？"}, {"type": "subtitle", "time": 4130.709, "timestamp": "01:08:50", "text": "你玩过这款游戏吗？ 我的天哪，"}, {"type": "subtitle", "time": 4131.349, "timestamp": "01:08:51", "text": "老兄。"}, {"type": "subtitle", "time": 4137.669, "timestamp": "01:08:57", "text": "稍等片刻。 现在我知道了"}]
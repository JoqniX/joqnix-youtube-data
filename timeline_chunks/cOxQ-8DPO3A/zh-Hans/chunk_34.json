[{"type": "subtitle", "time": 2040.789, "timestamp": "00:34:00", "text": "哇。"}, {"type": "subtitle", "time": 2048.55, "timestamp": "00:34:08", "text": "我的天啊。"}, {"type": "subtitle", "time": 2052.95, "timestamp": "00:34:12", "text": "所以，你们这些人，以及那些"}, {"type": "subtitle", "time": 2055.829, "timestamp": "00:34:15", "text": "可以取消你们的眩晕，哦，让"}, {"type": "subtitle", "time": 2057.75, "timestamp": "00:34:17", "text": "我告诉你们谁可以承受你们的尾部攻击"}, {"type": "subtitle", "time": 2060.55, "timestamp": "00:34:20", "text": "。 我们又找到了艾玛·"}, {"type": "subtitle", "time": 2061.99, "timestamp": "00:34:21", "text": "弗罗斯特。 尽量别出声，这次我不会再让"}, {"type": "subtitle", "time": 2064.31, "timestamp": "00:34:24", "text": "你晕眩了。   在"}, {"type": "subtitle", "time": 2066.55, "timestamp": "00:34:26", "text": "这里放个盾牌，然后"}, {"type": "subtitle", "time": 2071.43, "timestamp": "00:34:31", "text": "那是不会受到伤害的护盾。"}, {"type": "subtitle", "time": 2078.389, "timestamp": "00:34:38", "text": "他就是这么说的。"}, {"type": "subtitle", "time": 2079.909, "timestamp": "00:34:39", "text": "然而，防护罩还是被打破了。 就是这样。"}, {"type": "subtitle", "time": 2080.95, "timestamp": "00:34:40", "text": "好的。"}, {"type": "subtitle", "time": 2083.349, "timestamp": "00:34:43", "text": "另一方面，万磁王的"}, {"type": "subtitle", "time": 2085.589, "timestamp": "00:34:45", "text": "护盾不会破碎，因为"}, {"type": "subtitle", "time": 2087.19, "timestamp": "00:34:47", "text": "他可以承受无限的伤害。"}, {"type": "subtitle", "time": 2090.55, "timestamp": "00:34:50", "text": "这是不可避免的。"}, {"type": "subtitle", "time": 2091.75, "timestamp": "00:34:51", "text": "但它没有冷却时间。"}, {"type": "subtitle", "time": 2092.95, "timestamp": "00:34:52", "text": "每一个拥有盾牌的角色，"}, {"type": "subtitle", "time": 2094.629, "timestamp": "00:34:54", "text": "比如美国队长，都有盾牌。 他可以"}]
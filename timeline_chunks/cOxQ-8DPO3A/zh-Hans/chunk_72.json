[{"type": "subtitle", "time": 4325.59, "timestamp": "01:12:05", "text": "试图杀了他。 想办法杀了他。 尝试"}, {"type": "subtitle", "time": 4327.11, "timestamp": "01:12:07", "text": "杀死BP。"}, {"type": "subtitle", "time": 4338.31, "timestamp": "01:12:18", "text": "本德。 本德。 死。"}, {"type": "subtitle", "time": 4340.229, "timestamp": "01:12:20", "text": "我杀了他。 我杀了"}, {"type": "subtitle", "time": 4341.27, "timestamp": "01:12:21", "text": "另一个。 杀了另一个人。 另一个"}, {"type": "subtitle", "time": 4342.39, "timestamp": "01:12:22", "text": "人。 另一个人。 另一个人。 我抓到他了"}, {"type": "subtitle", "time": 4354.149, "timestamp": "01:12:34", "text": "真是见鬼了。 我一切都好。 渐渐"}, {"type": "subtitle", "time": 4355.83, "timestamp": "01:12:35", "text": "消失。 渐渐消失。 渐渐消失。 渐渐消失。"}, {"type": "subtitle", "time": 4367.11, "timestamp": "01:12:47", "text": "兄弟，如果你没血了就别跟他们打了。"}, {"type": "subtitle", "time": 4368.47, "timestamp": "01:12:48", "text": "搞什么鬼？"}]
[{"type": "subtitle", "time": 6607.669, "timestamp": "01:50:07", "text": "我有一些技能用"}, {"type": "subtitle", "time": 6609.59, "timestamp": "01:50:09", "text": "快捷键操作感觉更顺手，所以我把它们设置成了"}, {"type": "subtitle", "time": 6612.58, "timestamp": "01:50:12", "text": "快捷键。 所以你有了"}, {"type": "subtitle", "time": 6627.109, "timestamp": "01:50:27", "text": "你只需要"}, {"type": "subtitle", "time": 6631.669, "timestamp": "01:50:31", "text": "叫我浣熊。 我们恐怕要遇到"}, {"type": "subtitle", "time": 6642.87, "timestamp": "01:50:42", "text": "那里有个美国队长。 我们可以打"}, {"type": "subtitle", "time": 6647.99, "timestamp": "01:50:47", "text": "抓到他了。"}, {"type": "subtitle", "time": 6650.229, "timestamp": "01:50:50", "text": "好的。"}, {"type": "subtitle", "time": 6653.99, "timestamp": "01:50:53", "text": "好了，现在回到正题。 抓住"}, {"type": "subtitle", "time": 6657.43, "timestamp": "01:50:57", "text": "钻石女人。 钻石女人。"}]
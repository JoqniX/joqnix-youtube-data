[{"type": "subtitle", "time": 3800.63, "timestamp": "01:03:20", "text": "哦，就这样吧。"}, {"type": "subtitle", "time": 3802.15, "timestamp": "01:03:22", "text": "为什么？"}, {"type": "subtitle", "time": 3803.99, "timestamp": "01:03:23", "text": "你那边在想什么呢？"}, {"type": "subtitle", "time": 3805.51, "timestamp": "01:03:25", "text": "你当时到底在想什么？ 告诉我。 把"}, {"type": "subtitle", "time": 3807.109, "timestamp": "01:03:27", "text": "这些写下来告诉我。 你当时在"}, {"type": "subtitle", "time": 3807.67, "timestamp": "01:03:27", "text": "想什么？"}, {"type": "subtitle", "time": 3809.43, "timestamp": "01:03:29", "text": "我当时想，“哦，那个人在那边。之前有"}, {"type": "subtitle", "time": 3812.47, "timestamp": "01:03:32", "text": "两个人在那边。我去看看。”"}, {"type": "subtitle", "time": 3814.23, "timestamp": "01:03:34", "text": "那边有两个人。 哪两个"}, {"type": "subtitle", "time": 3816.309, "timestamp": "01:03:36", "text": "人？"}, {"type": "subtitle", "time": 3818.15, "timestamp": "01:03:38", "text": "呃，我不知道。"}, {"type": "subtitle", "time": 3820.309, "timestamp": "01:03:40", "text": "你他妈在傻笑什么？"}, {"type": "subtitle", "time": 3822.309, "timestamp": "01:03:42", "text": "你在笑什么？"}, {"type": "subtitle", "time": 3825.91, "timestamp": "01:03:45", "text": "他们的魔鬼和别的东西"}, {"type": "subtitle", "time": 3826.789, "timestamp": "01:03:46", "text": "。   是的"}, {"type": "subtitle", "time": 3828.789, "timestamp": "01:03:48", "text": "。 我跟你说过什么？ 这个"}, {"type": "subtitle", "time": 3832.23, "timestamp": "01:03:52", "text": "恶魔到底做了什么？"}, {"type": "subtitle", "time": 3835.43, "timestamp": "01:03:55", "text": "呃，让我跳下去。"}, {"type": "subtitle", "time": 3836.87, "timestamp": "01:03:56", "text": "所以，"}, {"type": "subtitle", "time": 3839.349, "timestamp": "01:03:59", "text": "我从来都不喜欢笑话。 我的"}]
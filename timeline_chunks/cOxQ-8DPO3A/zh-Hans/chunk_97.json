[{"type": "subtitle", "time": 5824.95, "timestamp": "01:37:04", "text": "利用你已有的东西。 我的天哪。"}, {"type": "subtitle", "time": 5833.189, "timestamp": "01:37:13", "text": "你可以。 你的角色塑造得太好了。 你根本"}, {"type": "subtitle", "time": 5842.629, "timestamp": "01:37:22", "text": "你觉得自己缺少什么"}, {"type": "subtitle", "time": 5844.45, "timestamp": "01:37:24", "text": "？"}, {"type": "subtitle", "time": 5848.07, "timestamp": "01:37:28", "text": "[音乐]"}, {"type": "subtitle", "time": 5849.59, "timestamp": "01:37:29", "text": "我其实不知道。 我究竟"}, {"type": "subtitle", "time": 5851.99, "timestamp": "01:37:31", "text": "缺少什么？ 我觉得我"}, {"type": "subtitle", "time": 5853.83, "timestamp": "01:37:33", "text": "什么都不缺。 你有没有想过这个问题"}, {"type": "subtitle", "time": 5856.55, "timestamp": "01:37:36", "text": "？   对"}, {"type": "subtitle", "time": 5857.03, "timestamp": "01:37:37", "text": "，可能"}, {"type": "subtitle", "time": 5859.35, "timestamp": "01:37:39", "text": "所有东西都是这样吧。"}, {"type": "subtitle", "time": 5862.629, "timestamp": "01:37:42", "text": "我的天啊。   是的"}, {"type": "subtitle", "time": 5865.03, "timestamp": "01:37:45", "text": "。 所以，你觉得怎么样？"}, {"type": "subtitle", "time": 5868.39, "timestamp": "01:37:48", "text": "你觉得怎么样？   是的"}, {"type": "subtitle", "time": 5872.149, "timestamp": "01:37:52", "text": "，实际上所有东西都是。"}, {"type": "subtitle", "time": 5873.99, "timestamp": "01:37:53", "text": "如何才能改进这一点？"}, {"type": "subtitle", "time": 5877.109, "timestamp": "01:37:57", "text": "我必须不断"}, {"type": "subtitle", "time": 5879.99, "timestamp": "01:37:59", "text": "练习、不断进步，并充分"}]
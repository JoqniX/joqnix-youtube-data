[{"type": "subtitle", "time": 11700.15, "timestamp": "03:15:00", "text": "我可以杀掉那些绿色的吗？"}, {"type": "subtitle", "time": 11702.55, "timestamp": "03:15:02", "text": "对，去干掉它。 我正在尝试购买"}, {"type": "subtitle", "time": 11704.71, "timestamp": "03:15:04", "text": "更大的那些，因为它们损坏更严重"}, {"type": "subtitle", "time": 11726.87, "timestamp": "03:15:26", "text": "我只看重品质。"}, {"type": "subtitle", "time": 11727.83, "timestamp": "03:15:27", "text": "我的天啊。"}, {"type": "subtitle", "time": 11729.03, "timestamp": "03:15:29", "text": "复仇者大厦。"}, {"type": "subtitle", "time": 11731.91, "timestamp": "03:15:31", "text": "我的天啊。   在"}, {"type": "subtitle", "time": 11734.87, "timestamp": "03:15:34", "text": "那里汇合。"}, {"type": "subtitle", "time": 11737.67, "timestamp": "03:15:37", "text": "弹药源源不断，而且每发子弹上都有我的名字"}, {"type": "subtitle", "time": 11739.46, "timestamp": "03:15:39", "text": "。"}, {"type": "subtitle", "time": 11747.75, "timestamp": "03:15:47", "text": "哦，我得了120分。不错。"}, {"type": "subtitle", "time": 11750.389, "timestamp": "03:15:50", "text": "看看这堆破烂。 看看这堆破烂，"}, {"type": "subtitle", "time": 11752.309, "timestamp": "03:15:52", "text": "乔克。 算了，没事了。"}, {"type": "subtitle", "time": 11754.309, "timestamp": "03:15:54", "text": "给我一秒钟。 需要一段"}]
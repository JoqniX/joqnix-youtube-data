[{"type": "subtitle", "time": 6841.99, "timestamp": "01:54:01", "text": "你那老掉牙的、无聊透顶的DNA"}, {"type": "subtitle", "time": 6844.95, "timestamp": "01:54:04", "text": "游戏，你知道，去刷刷刷。 或者你也可以"}, {"type": "subtitle", "time": 6851.589, "timestamp": "01:54:11", "text": "你够格吗？"}, {"type": "subtitle", "time": 6853.109, "timestamp": "01:54:13", "text": "看，看你头顶上方。 你"}, {"type": "subtitle", "time": 6855.51, "timestamp": "01:54:15", "text": "够格吗？"}, {"type": "subtitle", "time": 6857.109, "timestamp": "01:54:17", "text": "蠢货，"}, {"type": "subtitle", "time": 6857.43, "timestamp": "01:54:17", "text": "兄弟。"}, {"type": "subtitle", "time": 6859.669, "timestamp": "01:54:19", "text": "你知道上面那句话是什么意思吗？"}, {"type": "subtitle", "time": 6860.87, "timestamp": "01:54:20", "text": "哦"}, {"type": "subtitle", "time": 6863.189, "timestamp": "01:54:23", "text": "好的。 我抬头看了看。 里面有"}, {"type": "subtitle", "time": 6865.99, "timestamp": "01:54:25", "text": "蜘蛛侠之类的东西。"}, {"type": "subtitle", "time": 6868.55, "timestamp": "01:54:28", "text": "那不是蜘蛛侠。"}, {"type": "subtitle", "time": 6870.31, "timestamp": "01:54:30", "text": "那是佩妮·帕克。   对"}, {"type": "subtitle", "time": 6873.75, "timestamp": "01:54:33", "text": "，一样。 蜘蛛牛仔裤。 比如说，"}, {"type": "subtitle", "time": 6877.27, "timestamp": "01:54:37", "text": "“不好意思，你刚才是不是对蜘蛛有种族歧视"}, {"type": "subtitle", "time": 6879.109, "timestamp": "01:54:39", "text": "？”"}, {"type": "subtitle", "time": 6881.91, "timestamp": "01:54:41", "text": "哦，因为她是……是的。 是的。 我就知道"}, {"type": "subtitle", "time": 6883.83, "timestamp": "01:54:43", "text": "你会这么说，大块头。 没错，我就是这么想的"}, {"type": "subtitle", "time": 6885.109, "timestamp": "01:54:45", "text": "。 是的。 是的。"}]
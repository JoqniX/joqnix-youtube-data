[{"type": "subtitle", "time": 4922.79, "timestamp": "01:22:02", "text": "好了，现在打开前灯。 不用担心。   跟"}, {"type": "subtitle", "time": 4923.91, "timestamp": "01:22:03", "text": "我来。 来，来，到"}, {"type": "subtitle", "time": 4925.03, "timestamp": "01:22:05", "text": "右边来。 跟我来。 跟我来。   跟"}, {"type": "subtitle", "time": 4943.189, "timestamp": "01:22:23", "text": "你没有杀他们。"}, {"type": "subtitle", "time": 4943.59, "timestamp": "01:22:23", "text": "不。"}, {"type": "subtitle", "time": 4945.43, "timestamp": "01:22:25", "text": "你是怎么死的？"}, {"type": "subtitle", "time": 4948.95, "timestamp": "01:22:28", "text": "我面对着她，她把我救了出来。 当我转身离开时"}, {"type": "subtitle", "time": 4951.75, "timestamp": "01:22:31", "text": "，"}, {"type": "subtitle", "time": 4952.31, "timestamp": "01:22:32", "text": "我说：“"}, {"type": "subtitle", "time": 4953.83, "timestamp": "01:22:33", "text": "对不起，乔克。” 你刚才说什么？"}, {"type": "subtitle", "time": 4956.79, "timestamp": "01:22:36", "text": "所以，你没用你的眩晕技能？"}, {"type": "subtitle", "time": 4959.51, "timestamp": "01:22:39", "text": "我忘了用眩晕技能。 是的。"}, {"type": "subtitle", "time": 4965.59, "timestamp": "01:22:45", "text": "好的。"}, {"type": "subtitle", "time": 4967.03, "timestamp": "01:22:47", "text": "快点告诉我。 你怎么会"}, {"type": "subtitle", "time": 4976.31, "timestamp": "01:22:56", "text": "来了。"}]
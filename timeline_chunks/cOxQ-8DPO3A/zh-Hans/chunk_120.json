[{"type": "subtitle", "time": 7205.91, "timestamp": "02:00:05", "text": "挺有意思的。 僵尸模式。"}, {"type": "subtitle", "time": 7208.39, "timestamp": "02:00:08", "text": "你是否有相关背景？"}, {"type": "subtitle", "time": 7211.669, "timestamp": "02:00:11", "text": "什么？ 坏的。"}, {"type": "subtitle", "time": 7213.99, "timestamp": "02:00:13", "text": "背景。 你听到那"}, {"type": "subtitle", "time": 7219.35, "timestamp": "02:00:19", "text": "音乐？"}, {"type": "subtitle", "time": 7226.39, "timestamp": "02:00:26", "text": "。 你听到"}, {"type": "subtitle", "time": 7227.109, "timestamp": "02:00:27", "text": "背景音了吗？"}, {"type": "subtitle", "time": 7229.109, "timestamp": "02:00:29", "text": "不，不，不。"}, {"type": "subtitle", "time": 7244.629, "timestamp": "02:00:44", "text": "哦，其实我扮演螳螂女。"}, {"type": "subtitle", "time": 7246.629, "timestamp": "02:00:46", "text": "但终将"}, {"type": "subtitle", "time": 7249.43, "timestamp": "02:00:49", "text": "胜利。 我们发现自己陷入了"}, {"type": "subtitle", "time": 7257.109, "timestamp": "02:00:57", "text": "我们最好还是"}, {"type": "subtitle", "time": 7258.709, "timestamp": "02:00:58", "text": "跟我做个交易。"}]
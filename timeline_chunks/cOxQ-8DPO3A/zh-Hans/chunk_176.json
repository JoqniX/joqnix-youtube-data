[{"type": "subtitle", "time": 10580.389, "timestamp": "02:56:20", "text": "对，遇到一群敌人时，就用炮塔攻击他们"}, {"type": "subtitle", "time": 10582.79, "timestamp": "02:56:22", "text": "。"}, {"type": "subtitle", "time": 10586.469, "timestamp": "02:56:26", "text": "哦，现在有僵尸在爬行了。"}, {"type": "subtitle", "time": 10589.269, "timestamp": "02:56:29", "text": "是的，你还没见过"}, {"type": "subtitle", "time": 10591.19, "timestamp": "02:56:31", "text": "哦，不。 这其实是最后一对了"}, {"type": "subtitle", "time": 10600.23, "timestamp": "02:56:40", "text": "它们需要很长时间才能……是的"}, {"type": "subtitle", "time": 10601.59, "timestamp": "02:56:41", "text": "，它们是红色的，你知道的。"}, {"type": "subtitle", "time": 10603.99, "timestamp": "02:56:43", "text": "他们是狂暴型角色，所以他们"}, {"type": "subtitle", "time": 10604.87, "timestamp": "02:56:44", "text": "死得会很慢。"}, {"type": "subtitle", "time": 10608.309, "timestamp": "02:56:48", "text": "但时间不多了。"}, {"type": "subtitle", "time": 10609.75, "timestamp": "02:56:49", "text": "那不是计时器。 这就是"}, {"type": "subtitle", "time": 10617.67, "timestamp": "02:56:57", "text": "你看到了吗？ 这就是丧尸的数量"}]
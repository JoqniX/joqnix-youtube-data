[{"type": "subtitle", "time": 4260.229, "timestamp": "01:11:00", "text": "那一刻，当你拥有那"}, {"type": "subtitle", "time": 4261.59, "timestamp": "01:11:01", "text": "一刻，你将再次经历第二次衰弱"}, {"type": "subtitle", "time": 4262.87, "timestamp": "01:11:02", "text": "。   是的"}, {"type": "subtitle", "time": 4264.87, "timestamp": "01:11:04", "text": "。"}, {"type": "subtitle", "time": 4266.63, "timestamp": "01:11:06", "text": "你明白了吗？还是不明白？"}, {"type": "subtitle", "time": 4268.31, "timestamp": "01:11:08", "text": "我得到了它。"}, {"type": "subtitle", "time": 4270.39, "timestamp": "01:11:10", "text": "不，你没得到。"}, {"type": "subtitle", "time": 4271.43, "timestamp": "01:11:11", "text": "我的天啊。"}, {"type": "subtitle", "time": 4273.189, "timestamp": "01:11:13", "text": "而且我非常确定你没有"}, {"type": "subtitle", "time": 4275.83, "timestamp": "01:11:15", "text": "按下鼠标右键。   是的"}, {"type": "subtitle", "time": 4277.59, "timestamp": "01:11:17", "text": "。 好的。"}, {"type": "subtitle", "time": 4279.59, "timestamp": "01:11:19", "text": "是啊，因为我他妈的能看清那"}, {"type": "subtitle", "time": 4281.189, "timestamp": "01:11:21", "text": "玩意儿。"}, {"type": "subtitle", "time": 4285.11, "timestamp": "01:11:25", "text": "顺便说一句，这家伙是"}, {"type": "subtitle", "time": 4287.03, "timestamp": "01:11:27", "text": "我杀的。"}, {"type": "subtitle", "time": 4288.31, "timestamp": "01:11:28", "text": "你整个"}, {"type": "subtitle", "time": 4299.43, "timestamp": "01:11:39", "text": "哦，在那儿。"}, {"type": "subtitle", "time": 4301.03, "timestamp": "01:11:41", "text": "你可以逐渐淡出。   我做到了"}, {"type": "subtitle", "time": 4305.11, "timestamp": "01:11:45", "text": "。"}, {"type": "subtitle", "time": 4307.669, "timestamp": "01:11:47", "text": "直到他趴在你胸口。"}, {"type": "subtitle", "time": 4311.83, "timestamp": "01:11:51", "text": "哦，没错。 啊，我做完了。 我治好了"}]
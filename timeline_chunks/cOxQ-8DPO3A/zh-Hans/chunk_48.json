[{"type": "subtitle", "time": 2881.109, "timestamp": "00:48:01", "text": "所以，是的，这与这些"}, {"type": "subtitle", "time": 2883.109, "timestamp": "00:48:03", "text": "角色截然相反。 所以你很容易就能杀死"}, {"type": "subtitle", "time": 2884.23, "timestamp": "00:48:04", "text": "这些角色。 这就是我想"}, {"type": "subtitle", "time": 2887.109, "timestamp": "00:48:07", "text": "表达的意思。 好的。"}, {"type": "subtitle", "time": 2889.51, "timestamp": "00:48:09", "text": "假设存在敌人。"}, {"type": "subtitle", "time": 2891.349, "timestamp": "00:48:11", "text": "你好。 这么说吧，你身后的这些人"}, {"type": "subtitle", "time": 2893.67, "timestamp": "00:48:13", "text": "都是我的队友。"}, {"type": "subtitle", "time": 2896.87, "timestamp": "00:48:16", "text": "不要打我。 尝试侧翼包抄。 好的，尝试"}, {"type": "subtitle", "time": 2899.109, "timestamp": "00:48:19", "text": "侧翼包抄。"}, {"type": "subtitle", "time": 2901.03, "timestamp": "00:48:21", "text": "尝试绕到侧翼击杀这些治疗者。"}, {"type": "subtitle", "time": 2902.549, "timestamp": "00:48:22", "text": "好的，等"}, {"type": "subtitle", "time": 2905.03, "timestamp": "00:48:25", "text": "我跟你一起打排位赛的时候，我会帮你解决这个问题"}, {"type": "subtitle", "time": 2907.67, "timestamp": "00:48:27", "text": "。 我的意思是"}, {"type": "subtitle", "time": 2909.589, "timestamp": "00:48:29", "text": "和你进行快速比赛。 所以就容易多了。 所以"}, {"type": "subtitle", "time": 2911.67, "timestamp": "00:48:31", "text": "你试一试就会明白。"}, {"type": "subtitle", "time": 2913.67, "timestamp": "00:48:33", "text": "好的。"}, {"type": "subtitle", "time": 2915.19, "timestamp": "00:48:35", "text": "例如，"}, {"type": "subtitle", "time": 2917.43, "timestamp": "00:48:37", "text": "这个角色有哪些特定的玩法。 就像"}, {"type": "subtitle", "time": 2919.109, "timestamp": "00:48:39", "text": "我之前跟你说过的那样，有一种特定的玩法就是"}, {"type": "subtitle", "time": 2920.63, "timestamp": "00:48:40", "text": "以牙还牙，比如用突进角色来反制那些"}, {"type": "subtitle", "time": 2921.99, "timestamp": "00:48:41", "text": "突进你队伍、"}, {"type": "subtitle", "time": 2924.47, "timestamp": "00:48:44", "text": "突进你治疗的角色。 好的。"}, {"type": "subtitle", "time": 2926.47, "timestamp": "00:48:46", "text": "其次，你可以自己出去"}, {"type": "subtitle", "time": 2928.47, "timestamp": "00:48:48", "text": "杀掉那些治疗者，"}, {"type": "subtitle", "time": 2930.15, "timestamp": "00:48:50", "text": "玩"}, {"type": "subtitle", "time": 2933.349, "timestamp": "00:48:53", "text": "突袭流，让自己成为一个突袭流的猩红"}, {"type": "subtitle", "time": 2936.069, "timestamp": "00:48:56", "text": "女巫。 所以这就是为什么我说"}]
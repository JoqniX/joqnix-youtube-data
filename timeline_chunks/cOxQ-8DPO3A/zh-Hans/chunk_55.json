[{"type": "subtitle", "time": 3300.79, "timestamp": "00:55:00", "text": "想办法杀了这家伙。 想办法杀了这"}, {"type": "subtitle", "time": 3307.91, "timestamp": "00:55:07", "text": "我的天哪，你也太慢了吧。"}, {"type": "subtitle", "time": 3315.109, "timestamp": "00:55:15", "text": "再试着杀人。"}, {"type": "subtitle", "time": 3316.309, "timestamp": "00:55:16", "text": "是的，我的生命值很低。   在"}, {"type": "subtitle", "time": 3325.589, "timestamp": "00:55:25", "text": "你面前颤抖吧。 我不得不杀了另一个人，我"}, {"type": "subtitle", "time": 3328.23, "timestamp": "00:55:28", "text": "必须这么做"}, {"type": "subtitle", "time": 3330.069, "timestamp": "00:55:30", "text": "。"}, {"type": "subtitle", "time": 3342.95, "timestamp": "00:55:42", "text": "我有"}, {"type": "subtitle", "time": 3352.789, "timestamp": "00:55:52", "text": "你到底在哪儿？ 我浑身发"}, {"type": "subtitle", "time": 3357.99, "timestamp": "00:55:57", "text": "妈的，这里有只黑豹。"}, {"type": "subtitle", "time": 3359.349, "timestamp": "00:55:59", "text": "想办法杀了他。"}]
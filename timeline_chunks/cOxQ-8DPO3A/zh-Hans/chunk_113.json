[{"type": "subtitle", "time": 6793.35, "timestamp": "01:53:13", "text": "我已经准备好表演了。"}, {"type": "subtitle", "time": 6798.95, "timestamp": "01:53:18", "text": "我非常确定你不可能透过那层衣服打到我"}, {"type": "subtitle", "time": 6800.629, "timestamp": "01:53:20", "text": "。"}, {"type": "subtitle", "time": 6809.589, "timestamp": "01:53:29", "text": "，你把"}, {"type": "subtitle", "time": 6811.35, "timestamp": "01:53:31", "text": "自己孤立起来了。 我不知道"}, {"type": "subtitle", "time": 6818.709, "timestamp": "01:53:38", "text": "你笑什么？ 呃，我玩"}, {"type": "subtitle", "time": 6826.149, "timestamp": "01:53:46", "text": "嘿，我早就跟你说过，有机会就玩这个游戏"}, {"type": "subtitle", "time": 6827.589, "timestamp": "01:53:47", "text": "。 你没玩过。 你当时说："}, {"type": "subtitle", "time": 6830.55, "timestamp": "01:53:50", "text": "“啊，我们待会儿再玩吧。”"}, {"type": "subtitle", "time": 6837.109, "timestamp": "01:53:57", "text": "你知道，"}, {"type": "subtitle", "time": 6838.87, "timestamp": "01:53:58", "text": "你可以回去玩"}]
[{"type": "subtitle", "time": 9060.79, "timestamp": "02:31:00", "text": "当噩梦模式启动时，"}, {"type": "subtitle", "time": 9062.389, "timestamp": "02:31:02", "text": "你进入噩梦模式，然后游戏就会"}, {"type": "subtitle", "time": 9070.389, "timestamp": "02:31:10", "text": "猩红法师。"}, {"type": "subtitle", "time": 9072.309, "timestamp": "02:31:12", "text": "呃，"}, {"type": "subtitle", "time": 9078.07, "timestamp": "02:31:18", "text": "瞄准头部就行了。"}, {"type": "subtitle", "time": 9089.83, "timestamp": "02:31:29", "text": "好的。 所以，"}, {"type": "subtitle", "time": 9093.349, "timestamp": "02:31:33", "text": "当她情绪非常低落的时候，她会把所有精力都用上。"}, {"type": "subtitle", "time": 9103.429, "timestamp": "02:31:43", "text": "好的。 射杀她。 射杀她。 击落她"}, {"type": "subtitle", "time": 9105.429, "timestamp": "02:31:45", "text": "。 比如，杀了她，不然她会一直让"}, {"type": "subtitle", "time": 9108.23, "timestamp": "02:31:48", "text": "你晕头转向。   是的"}, {"type": "subtitle", "time": 9110.07, "timestamp": "02:31:50", "text": "。 攻击头部下颚。 瞄准"}, {"type": "subtitle", "time": 9117.51, "timestamp": "02:31:57", "text": "顺便说一句，你的枪造成的伤害"}]
[{"type": "subtitle", "time": 5946.709, "timestamp": "01:39:06", "text": "你想知道为什么吗？ 那边有辆"}, {"type": "subtitle", "time": 5949.189, "timestamp": "01:39:09", "text": "坦克开过来了。 飞行坦克。 尽量把她弄到这里来"}, {"type": "subtitle", "time": 5957.43, "timestamp": "01:39:17", "text": "抓到他了。"}, {"type": "subtitle", "time": 5959.59, "timestamp": "01:39:19", "text": "好的。"}, {"type": "subtitle", "time": 5961.43, "timestamp": "01:39:21", "text": "那边有位治疗师。 我们会尽力争取"}, {"type": "subtitle", "time": 5994.79, "timestamp": "01:39:54", "text": "等待。 好的。 等待。 不要贸然行事。"}, {"type": "subtitle", "time": 5998.229, "timestamp": "01:39:58", "text": "让他们冲向你，做出"}]
[{"type": "subtitle", "time": 781.99, "timestamp": "00:13:01", "text": "战争，对吧？ 你在《守望先锋》里玩什么"}, {"type": "subtitle", "time": 783.75, "timestamp": "00:13:03", "text": "？"}, {"type": "chat", "time": 784.115, "timestamp": "00:13:04", "author": "@DinyoFoxy", "avatar": "https://yt4.ggpht.com/aACLJToYP6FMtiMkCyV12FJchjJLrwy1qzEVqHiZEyFaZdsbRkj-yqg_i_m8eqjYX-fTLgPLCzk=s64-c-k-c0x00ffffff-no-rj", "message": "bye surya"}, {"type": "subtitle", "time": 788.15, "timestamp": "00:13:08", "text": "守望先锋。 主要是半藏。"}, {"type": "subtitle", "time": 791.35, "timestamp": "00:13:11", "text": "汉佐。 好的。 所以，鹰眼就像"}, {"type": "subtitle", "time": 792.389, "timestamp": "00:13:12", "text": "汉佐一样。   是的"}, {"type": "subtitle", "time": 793.75, "timestamp": "00:13:13", "text": "。"}, {"type": "subtitle", "time": 795.75, "timestamp": "00:13:15", "text": "哇。"}, {"type": "subtitle", "time": 797.67, "timestamp": "00:13:17", "text": "好的。"}, {"type": "subtitle", "time": 802.47, "timestamp": "00:13:22", "text": "输出角色，你"}, {"type": "subtitle", "time": 803.43, "timestamp": "00:13:23", "text": "想玩哪个角色？"}, {"type": "subtitle", "time": 807.269, "timestamp": "00:13:27", "text": "输出伤害（DPS）。 银行卡，对吧？"}, {"type": "subtitle", "time": 810.79, "timestamp": "00:13:30", "text": "不，它是双列表。"}, {"type": "subtitle", "time": 813.19, "timestamp": "00:13:33", "text": "双列表。 好的。   是的"}, {"type": "subtitle", "time": 814.629, "timestamp": "00:13:34", "text": "。"}, {"type": "subtitle", "time": 817.75, "timestamp": "00:13:37", "text": "有很多"}, {"type": "subtitle", "time": 820.949, "timestamp": "00:13:40", "text": "我喜欢的地方，我挺喜欢惩罚者的，因为“砰砰砰砰”的枪声，"}, {"type": "subtitle", "time": 827.509, "timestamp": "00:13:47", "text": "而且星光也不错。"}, {"type": "subtitle", "time": 830.949, "timestamp": "00:13:50", "text": "呃，他现在更像是个坦克射击游戏玩家，就像《五十度"}, {"type": "subtitle", "time": 831.91, "timestamp": "00:13:51", "text": "灰》那样。"}, {"type": "subtitle", "time": 833.11, "timestamp": "00:13:53", "text": "什么？"}, {"type": "subtitle", "time": 834.15, "timestamp": "00:13:54", "text": "他更像一辆坦克。"}, {"type": "subtitle", "time": 836.389, "timestamp": "00:13:56", "text": "抱歉。"}]
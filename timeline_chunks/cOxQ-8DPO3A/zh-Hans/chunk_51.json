[{"type": "subtitle", "time": 3061.19, "timestamp": "00:51:01", "text": "。"}, {"type": "subtitle", "time": 3062.79, "timestamp": "00:51:02", "text": "哦，我们有场比赛了。   是的"}, {"type": "subtitle", "time": 3065.589, "timestamp": "00:51:05", "text": "。"}, {"type": "subtitle", "time": 3067.75, "timestamp": "00:51:07", "text": "所以，就是绯红女巫，对吧？ 哦，我的天哪，"}, {"type": "subtitle", "time": 3071.109, "timestamp": "00:51:11", "text": "我忘了告诉你团队成员是谁。 他妈的。"}, {"type": "subtitle", "time": 3073.43, "timestamp": "00:51:13", "text": "我来扮演奇异博士。 拉屎。 我把那件事忘了"}, {"type": "subtitle", "time": 3076.87, "timestamp": "00:51:16", "text": "。 我之前也想过这个问题，"}, {"type": "subtitle", "time": 3078.15, "timestamp": "00:51:18", "text": "但它确实很有帮助。"}, {"type": "subtitle", "time": 3082.23, "timestamp": "00:51:22", "text": "所以，绯红女巫和……呃……"}, {"type": "subtitle", "time": 3085.27, "timestamp": "00:51:25", "text": "奇异博士组成了一个团队，"}, {"type": "subtitle", "time": 3088.15, "timestamp": "00:51:28", "text": "叫做……"}, {"type": "subtitle", "time": 3090.47, "timestamp": "00:51:30", "text": "叫什么来着？"}, {"type": "subtitle", "time": 3092.79, "timestamp": "00:51:32", "text": "神秘的、秩序之类的。 我想是"}, {"type": "subtitle", "time": 3095.67, "timestamp": "00:51:35", "text": "神秘的什么。 所以，它的作用"}, {"type": "subtitle", "time": 3098.79, "timestamp": "00:51:38", "text": "是另一种能力。 不，你还有"}, {"type": "subtitle", "time": 3100.95, "timestamp": "00:51:40", "text": "第三种能力。"}, {"type": "subtitle", "time": 3102.47, "timestamp": "00:51:42", "text": "好的。"}, {"type": "subtitle", "time": 3110.069, "timestamp": "00:51:50", "text": "你他妈到底在为什么而战？"}, {"type": "subtitle", "time": 3111.75, "timestamp": "00:51:51", "text": "你看，看到了吗？ 那东西"}, {"type": "subtitle", "time": 3113.43, "timestamp": "00:51:53", "text": "打开了吗？ 现在只需同时按下这两个"}, {"type": "subtitle", "time": 3115.109, "timestamp": "00:51:55", "text": "按钮。 同时单击鼠标左键和鼠标右键"}, {"type": "subtitle", "time": 3117.91, "timestamp": "00:51:57", "text": "。 你看到了吗？"}]
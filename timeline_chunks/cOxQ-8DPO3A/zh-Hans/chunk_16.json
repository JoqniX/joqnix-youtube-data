[{"type": "subtitle", "time": 961.67, "timestamp": "00:16:01", "text": "磁王的"}, {"type": "subtitle", "time": 962.87, "timestamp": "00:16:02", "text": "绳索吸住。 啊。"}, {"type": "subtitle", "time": 966.069, "timestamp": "00:16:06", "text": "所以，如果你向他开枪，他的"}, {"type": "subtitle", "time": 969.509, "timestamp": "00:16:09", "text": "备用技能就会充能。 所以，他造成的破坏更大。"}, {"type": "subtitle", "time": 972.15, "timestamp": "00:16:12", "text": "什么？   是的"}, {"type": "subtitle", "time": 974.069, "timestamp": "00:16:14", "text": "。 所以，基本上，如果我的小号充能足够，我就可以用它来团"}, {"type": "subtitle", "time": 975.99, "timestamp": "00:16:15", "text": "灭你的整个队伍"}, {"type": "subtitle", "time": 978.31, "timestamp": "00:16:18", "text": "。"}, {"type": "subtitle", "time": 980.15, "timestamp": "00:16:20", "text": "哇。   是的"}, {"type": "subtitle", "time": 982.23, "timestamp": "00:16:22", "text": "。 但是，你知道，你得把这"}, {"type": "subtitle", "time": 983.67, "timestamp": "00:16:23", "text": "事儿搞定，你知道，"}, {"type": "subtitle", "time": 986.47, "timestamp": "00:16:26", "text": "搞定这事儿并不容易，"}, {"type": "subtitle", "time": 988.629, "timestamp": "00:16:28", "text": "你知道，你得把它搞得"}, {"type": "subtitle", "time": 990.949, "timestamp": "00:16:30", "text": "特别好才行。 而且，它还可以"}, {"type": "subtitle", "time": 993.35, "timestamp": "00:16:33", "text": "用盾牌之类的东西挡住，所以效果"}, {"type": "subtitle", "time": 995.99, "timestamp": "00:16:35", "text": "不是很好，但也不是完全"}, {"type": "subtitle", "time": 997.749, "timestamp": "00:16:37", "text": "没用。"}, {"type": "subtitle", "time": 999.749, "timestamp": "00:16:39", "text": "你知道，至少对我来说，它已经不在我的视线范围内了。 我不了解"}, {"type": "subtitle", "time": 1002.71, "timestamp": "00:16:42", "text": "其他人的情况。 对我来说可以做到。   但"}, {"type": "subtitle", "time": 1005.03, "timestamp": "00:16:45", "text": "我并不明白。   是的"}, {"type": "subtitle", "time": 1007.03, "timestamp": "00:16:47", "text": "。 嗯，这是唯一能克制"}, {"type": "subtitle", "time": 1008.629, "timestamp": "00:16:48", "text": "你角色的方法，因为他会占用你所有的"}, {"type": "subtitle", "time": 1010.71, "timestamp": "00:16:50", "text": "备用角色，然后一击必杀，"}, {"type": "subtitle", "time": 1013.11, "timestamp": "00:16:53", "text": "如果真是这样的话，还会连累你的整个团队。"}, {"type": "subtitle", "time": 1014.389, "timestamp": "00:16:54", "text": "我是一名变种人，"}, {"type": "subtitle", "time": 1015.749, "timestamp": "00:16:55", "text": "并为此感到自豪。"}, {"type": "subtitle", "time": 1018.629, "timestamp": "00:16:58", "text": "哦，暴风女嘛……说实话，我不知道这个"}]
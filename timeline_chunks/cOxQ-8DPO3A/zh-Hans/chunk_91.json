[{"type": "subtitle", "time": 5473.43, "timestamp": "01:31:13", "text": "射杀她。 射杀她。 射杀她。 射杀"}, {"type": "subtitle", "time": 5478.87, "timestamp": "01:31:18", "text": "你能开枪打死她吗？"}, {"type": "subtitle", "time": 5480.87, "timestamp": "01:31:20", "text": "在哪里？"}, {"type": "subtitle", "time": 5483.91, "timestamp": "01:31:23", "text": "向上。 好吧，"}, {"type": "subtitle", "time": 5486.709, "timestamp": "01:31:26", "text": "我迷路了。"}, {"type": "subtitle", "time": 5489.59, "timestamp": "01:31:29", "text": "如何？ 这张地图好小啊。"}, {"type": "subtitle", "time": 5492.95, "timestamp": "01:31:32", "text": "发生了很多事。"}, {"type": "subtitle", "time": 5495.11, "timestamp": "01:31:35", "text": "那你为什么还要玩她的射击游戏呢？"}, {"type": "subtitle", "time": 5497.11, "timestamp": "01:31:37", "text": "什么鬼？ 当然，会有"}, {"type": "subtitle", "time": 5498.229, "timestamp": "01:31:38", "text": "很多事情发生。 你不是玩过《"}, {"type": "subtitle", "time": 5500.07, "timestamp": "01:31:40", "text": "守望先锋》的吗？"}, {"type": "subtitle", "time": 5503.83, "timestamp": "01:31:43", "text": "那已经是很久以前的事了。"}, {"type": "subtitle", "time": 5506.149, "timestamp": "01:31:46", "text": "不要去那里。 不要独自前往那里。"}, {"type": "subtitle", "time": 5507.27, "timestamp": "01:31:47", "text": "你在开玩笑吧？"}, {"type": "subtitle", "time": 5510.39, "timestamp": "01:31:50", "text": "她有很多东西。"}, {"type": "subtitle", "time": 5512.229, "timestamp": "01:31:52", "text": "哦，她情绪低落。 什么？ 这他妈根本不是绝地"}, {"type": "subtitle", "time": 5517.91, "timestamp": "01:31:57", "text": "她情绪低落。 所以呢？ 民间治疗师"}]
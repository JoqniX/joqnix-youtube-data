[{"type": "subtitle", "time": 12361.99, "timestamp": "03:26:01", "text": "谢谢你们的款待，也谢谢你们的"}, {"type": "subtitle", "time": 12363.51, "timestamp": "03:26:03", "text": "邀请。   是的"}, {"type": "subtitle", "time": 12370.469, "timestamp": "03:26:10", "text": "教我玩这个游戏。"}, {"type": "subtitle", "time": 12373.19, "timestamp": "03:26:13", "text": "你一分钱也没拿到。 我知道"}, {"type": "subtitle", "time": 12376.95, "timestamp": "03:26:16", "text": "你一点儿也没得到。"}, {"type": "subtitle", "time": 12380.07, "timestamp": "03:26:20", "text": "没错。 是的。"}, {"type": "subtitle", "time": 12384.229, "timestamp": "03:26:24", "text": "发生了很多事。 是的。   是的"}, {"type": "subtitle", "time": 12386.63, "timestamp": "03:26:26", "text": "。 我就是不明白你怎么会"}, {"type": "subtitle", "time": 12388.469, "timestamp": "03:26:28", "text": "不喜欢，我觉得这就像一个快节奏的"}, {"type": "subtitle", "time": 12390.71, "timestamp": "03:26:30", "text": "游戏。 好的。 乔克擅长快节奏的"}, {"type": "subtitle", "time": 12393.349, "timestamp": "03:26:33", "text": "游戏。 你根本一窍不通。 是吗"}, {"type": "subtitle", "time": 12395.429, "timestamp": "03:26:35", "text": "？   我感觉自己好像"}, {"type": "subtitle", "time": 12397.429, "timestamp": "03:26:37", "text": "不知道敌人在哪里"}, {"type": "subtitle", "time": 12400.95, "timestamp": "03:26:40", "text": "。 到处都在发生很多事情"}, {"type": "subtitle", "time": 12402.15, "timestamp": "03:26:42", "text": "。"}, {"type": "subtitle", "time": 12403.83, "timestamp": "03:26:43", "text": "你不知道。 你不知道"}, {"type": "subtitle", "time": 12406.63, "timestamp": "03:26:46", "text": "敌人在哪里。 你知道，它们的生成"}, {"type": "subtitle", "time": 12408.71, "timestamp": "03:26:48", "text": "点和我们的生成点相反，所以它们"}, {"type": "subtitle", "time": 12410.469, "timestamp": "03:26:50", "text": "总是会从相反的"}, {"type": "subtitle", "time": 12412.229, "timestamp": "03:26:52", "text": "方向出现。   是的"}, {"type": "subtitle", "time": 12414.399, "timestamp": "03:26:54", "text": "。   是的 。 这不是科学。这不是科学。这是他妈的"}, {"type": "subtitle", "time": 12416.8, "timestamp": "03:26:56", "text": "。 这不是科学。这不是科学。这是他妈的 科学。 哥们，你玩《守望先锋》啊。 就他妈"}, {"type": "subtitle", "time": 12419.6, "timestamp": "03:26:59", "text": "科学。 哥们，你玩《守望先锋》啊。 就他妈 只有一个重生点。"}]
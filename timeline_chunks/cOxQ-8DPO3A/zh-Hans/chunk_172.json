[{"type": "subtitle", "time": 10324.79, "timestamp": "02:52:04", "text": "水晶，水晶。 好的。"}, {"type": "subtitle", "time": 10335.91, "timestamp": "02:52:15", "text": "水晶。"}, {"type": "subtitle", "time": 10338.15, "timestamp": "02:52:18", "text": "我们可能做不到。"}, {"type": "subtitle", "time": 10339.51, "timestamp": "02:52:19", "text": "我们或许真的能做到。"}, {"type": "subtitle", "time": 10341.99, "timestamp": "02:52:21", "text": "哦，我们明白了。"}, {"type": "subtitle", "time": 10343.91, "timestamp": "02:52:23", "text": "克里斯托，老兄。 直接开枪。"}, {"type": "subtitle", "time": 10345.51, "timestamp": "02:52:25", "text": "直接射击水晶。 这很"}, {"type": "subtitle", "time": 10347.51, "timestamp": "02:52:27", "text": "容易。"}, {"type": "subtitle", "time": 10351.51, "timestamp": "02:52:31", "text": "最有价值球员。 我的天啊。"}, {"type": "subtitle", "time": 10354.23, "timestamp": "02:52:34", "text": "我比你们多有一百万。"}, {"type": "subtitle", "time": 10357.83, "timestamp": "02:52:37", "text": "这是一只青蛙。 我的天啊。 该死。"}, {"type": "subtitle", "time": 10360.309, "timestamp": "02:52:40", "text": "这是一只青蛙。 是的，我就是这么说的。"}, {"type": "subtitle", "time": 10361.429, "timestamp": "02:52:41", "text": "这是一只青蛙。"}, {"type": "subtitle", "time": 10363.75, "timestamp": "02:52:43", "text": "哦，是的，现在是3点30分。"}, {"type": "subtitle", "time": 10367.269, "timestamp": "02:52:47", "text": "你那边几点？   还"}, {"type": "subtitle", "time": 10369.429, "timestamp": "02:52:49", "text": "不够好。   还"}, {"type": "subtitle", "time": 10375.75, "timestamp": "02:52:55", "text": "我的天啊。"}, {"type": "subtitle", "time": 10377.03, "timestamp": "02:52:57", "text": "你想玩吗？"}, {"type": "subtitle", "time": 10379.91, "timestamp": "02:52:59", "text": "我还有最后一局。"}]
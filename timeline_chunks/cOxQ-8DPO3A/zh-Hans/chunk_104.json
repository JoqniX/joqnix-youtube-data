[{"type": "subtitle", "time": 6247.669, "timestamp": "01:44:07", "text": "我把所有人都杀了。"}, {"type": "subtitle", "time": 6251.189, "timestamp": "01:44:11", "text": "你身后有毒液。"}, {"type": "subtitle", "time": 6253.03, "timestamp": "01:44:13", "text": "不，那是我们的队友。"}, {"type": "subtitle", "time": 6255.75, "timestamp": "01:44:15", "text": "不，是毒液。 我身上有毒液。"}, {"type": "subtitle", "time": 6256.31, "timestamp": "01:44:16", "text": "你死了吗？"}, {"type": "subtitle", "time": 6257.669, "timestamp": "01:44:17", "text": "你身上有毒液。 我没杀"}, {"type": "subtitle", "time": 6259.189, "timestamp": "01:44:19", "text": "他。"}, {"type": "subtitle", "time": 6263.109, "timestamp": "01:44:23", "text": "哦，我们赢了。 好的。"}, {"type": "subtitle", "time": 6274.55, "timestamp": "01:44:34", "text": "所以"}, {"type": "subtitle", "time": 6276.709, "timestamp": "01:44:36", "text": "有机会和球队一起比赛。 这不是一款"}, {"type": "subtitle", "time": 6278.87, "timestamp": "01:44:38", "text": "单人游戏。 我已经告诉过你，他很擅长"}, {"type": "subtitle", "time": 6280.55, "timestamp": "01:44:40", "text": "一对一的较量。   这"}, {"type": "subtitle", "time": 6282.47, "timestamp": "01:44:42", "text": "并不意味着"}, {"type": "subtitle", "time": 6284.629, "timestamp": "01:44:44", "text": "技术差就不会死。"}, {"type": "subtitle", "time": 6286.149, "timestamp": "01:44:46", "text": "记住？   是的"}, {"type": "subtitle", "time": 6290.629, "timestamp": "01:44:50", "text": "天哪。"}, {"type": "subtitle", "time": 6292.87, "timestamp": "01:44:52", "text": "顺便说一句，我用巴基步枪可以打败你"}, {"type": "subtitle", "time": 6294.55, "timestamp": "01:44:54", "text": "。"}, {"type": "subtitle", "time": 6296.07, "timestamp": "01:44:56", "text": "只是说说而已。 我可以用巴基打败你"}, {"type": "subtitle", "time": 6297.59, "timestamp": "01:44:57", "text": "。 嗯，巴基是个非常棒的"}]
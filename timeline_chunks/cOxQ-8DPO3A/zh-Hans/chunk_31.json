[{"type": "subtitle", "time": 1860.149, "timestamp": "00:31:00", "text": "也开启。"}, {"type": "subtitle", "time": 1861.59, "timestamp": "00:31:01", "text": "让我告诉你，每"}, {"type": "subtitle", "time": 1863.83, "timestamp": "00:31:03", "text": "一个支持，"}, {"type": "subtitle", "time": 1867.43, "timestamp": "00:31:07", "text": "不是每一场战斗，至少有三到"}, {"type": "subtitle", "time": 1870.63, "timestamp": "00:31:10", "text": "三个支持，或者你知道的，1、2、3、4、5"}, {"type": "subtitle", "time": 1872.23, "timestamp": "00:31:12", "text": "。 五个"}, {"type": "subtitle", "time": 1875.43, "timestamp": "00:31:15", "text": "辅助角色可以扛住你的伤害，或者可以取消你的伤害或者"}, {"type": "subtitle", "time": 1876.789, "timestamp": "00:31:16", "text": "扛住你的小号。"}, {"type": "subtitle", "time": 1877.35, "timestamp": "00:31:17", "text": "好的。   一切就此"}, {"type": "subtitle", "time": 1879.029, "timestamp": "00:31:19", "text": "开始。"}, {"type": "subtitle", "time": 1880.47, "timestamp": "00:31:20", "text": "首先，让我给"}, {"type": "subtitle", "time": 1882.549, "timestamp": "00:31:22", "text": "你们展示一个基本的例子。 月亮雪可以让"}, {"type": "subtitle", "time": 1891.83, "timestamp": "00:31:31", "text": "我的天哪，我错过了。 我又失手了。 我"}, {"type": "subtitle", "time": 1893.51, "timestamp": "00:31:33", "text": "又失手了。"}, {"type": "subtitle", "time": 1894.95, "timestamp": "00:31:34", "text": "双杀。"}, {"type": "subtitle", "time": 1895.669, "timestamp": "00:31:35", "text": "好的，"}, {"type": "subtitle", "time": 1897.19, "timestamp": "00:31:37", "text": "那就好。 好吧，这确实是个不错的动作"}, {"type": "subtitle", "time": 1898.71, "timestamp": "00:31:38", "text": "。 你的芦荟运动得很好"}, {"type": "subtitle", "time": 1900.549, "timestamp": "00:31:40", "text": "。"}, {"type": "subtitle", "time": 1902.23, "timestamp": "00:31:42", "text": "就像四处移动一样，"}, {"type": "subtitle", "time": 1905.909, "timestamp": "00:31:45", "text": "但它们也能像这样把你击晕。"}, {"type": "subtitle", "time": 1908.549, "timestamp": "00:31:48", "text": "好的，这是其中一种支持方式。 其次"}, {"type": "subtitle", "time": 1911.029, "timestamp": "00:31:51", "text": "是元信息。"}, {"type": "subtitle", "time": 1917.75, "timestamp": "00:31:57", "text": "石头被取消了。"}, {"type": "subtitle", "time": 1918.23, "timestamp": "00:31:58", "text": "哇。"}]
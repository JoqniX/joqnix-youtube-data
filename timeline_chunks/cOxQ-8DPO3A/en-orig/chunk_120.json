[{"type": "subtitle", "time": 7205.91, "timestamp": "02:00:05", "text": ">> It's pretty fun. The zombie mode."}, {"type": "subtitle", "time": 7208.39, "timestamp": "02:00:08", "text": ">> Do you have background?"}, {"type": "subtitle", "time": 7211.669, "timestamp": "02:00:11", "text": ">> What? Bad."}, {"type": "subtitle", "time": 7213.99, "timestamp": "02:00:13", "text": ">> Background. Do you hear that"}, {"type": "subtitle", "time": 7219.35, "timestamp": "02:00:19", "text": "Music?"}, {"type": "subtitle", "time": 7226.39, "timestamp": "02:00:26", "text": "like from my side. Do you hear any"}, {"type": "subtitle", "time": 7227.109, "timestamp": "02:00:27", "text": "background?"}, {"type": "subtitle", "time": 7229.109, "timestamp": "02:00:29", "text": ">> No. No. No."}, {"type": "subtitle", "time": 7244.629, "timestamp": "02:00:44", "text": ">> Oh, actually I'll play Mantis."}, {"type": "subtitle", "time": 7246.629, "timestamp": "02:00:46", "text": "But always"}, {"type": "subtitle", "time": 7249.43, "timestamp": "02:00:49", "text": "shall prevail. We find ourselves caught"}, {"type": "subtitle", "time": 7257.109, "timestamp": "02:00:57", "text": ">> We would be better off making a deal"}, {"type": "subtitle", "time": 7258.709, "timestamp": "02:00:58", "text": "with me."}]
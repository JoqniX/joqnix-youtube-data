[{"type": "subtitle", "time": 1399.669, "timestamp": "00:23:19", "text": "像「全部」那樣。有時候，如果全隊的目光都集中在你身上，你可能會因此喪命。  閃電擊中。哦，不過"}, {"type": "subtitle", "time": 1404.71, "timestamp": "00:23:24", "text": "我非常確定這不像你的"}, {"type": "subtitle", "time": 1408.149, "timestamp": "00:23:28", "text": "個性。  另外，我發現我和"}, {"type": "subtitle", "time": 1412.149, "timestamp": "00:23:32", "text": "緋紅女巫配合得很好。  他不需要任何“是”。  你只想玩《緋紅》嗎？"}, {"type": "subtitle", "time": 1419.75, "timestamp": "00:23:39", "text": "因為我可以先講講史嘉莉的故事，其他角色我們可以以後"}, {"type": "subtitle", "time": 1423.83, "timestamp": "00:23:43", "text": "再說。  是的。是的。當然。當然。"}, {"type": "subtitle", "time": 1431.669, "timestamp": "00:23:51", "text": "雙殺。哦，另外"}, {"type": "subtitle", "time": 1436.549, "timestamp": "00:23:56", "text": "我還可以幫你提升這個角色，因為它在某些方面比較薄弱，而某些坦克角色可以彌補這方面的不足。  哦，所以基本上你的"}, {"type": "subtitle", "time": 1438.549, "timestamp": "00:23:58", "text": "意思是……好的，讓我再檢查一下，因為我不記得怎麼做了。哦好的。"}]
[{"type": "subtitle", "time": 2825.27, "timestamp": "00:47:05", "text": "角色時，就趕緊撤退，"}, {"type": "subtitle", "time": 2827.109, "timestamp": "00:47:07", "text": "因為他們搆不到"}, {"type": "subtitle", "time": 2828.95, "timestamp": "00:47:08", "text": "你。"}, {"type": "subtitle", "time": 2840.87, "timestamp": "00:47:20", "text": "知道了。  好的。 M，但"}, {"type": "subtitle", "time": 2848.47, "timestamp": "00:47:28", "text": "我得告訴你，就算你衝上去也沒用，如果玩這個角色的玩家技術夠好，他就算"}, {"type": "subtitle", "time": 2849.99, "timestamp": "00:47:29", "text": "你衝上去也能殺了你。我只是提醒你一下，但大多數人不會這麼做，因為他們技術不好。所以如果你克制蜘蛛俠，你就等著被克制吧。大多數人會用超能英雄來克制蜘蛛人"}, {"type": "subtitle", "time": 2864.47, "timestamp": "00:47:44", "text": "。蜘蛛人或許能幫上忙，因為……情況就是這樣，"}, {"type": "subtitle", "time": 2872.23, "timestamp": "00:47:52", "text": "你不需要瞄準，你只需要看著蜘蛛俠，然後就行了。混亂總是會勝利的。哦對了"}]
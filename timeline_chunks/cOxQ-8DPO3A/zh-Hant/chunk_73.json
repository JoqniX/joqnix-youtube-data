[{"type": "subtitle", "time": 4392.149, "timestamp": "01:13:12", "text": "還是不"}, {"type": "subtitle", "time": 4428.39, "timestamp": "01:13:48", "text": "明白？  我得到了它。  不，"}, {"type": "subtitle", "time": 4430.31, "timestamp": "01:13:50", "text": "你沒得到。  我的天啊。  而且"}, {"type": "subtitle", "time": 4437.51, "timestamp": "01:13:57", "text": "我非常確定你沒有按下滑鼠右鍵。  是的。好的"}]
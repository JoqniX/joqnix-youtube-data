[{"type": "subtitle", "time": 4922.79, "timestamp": "01:22:02", "text": "不知道你發生了什麼事。  你怎麼了？  什麼？我死於那東西之手，死於誰之手？  呃，最終目標是誰？誰的"}, {"type": "subtitle", "time": 4943.189, "timestamp": "01:22:23", "text": "不知道它的名字。  好了，抓到他了。  殺了他並不難。  他們驚呼「我的天哪」。我的天哪。"}, {"type": "subtitle", "time": 4953.83, "timestamp": "01:22:33", "text": "謝謝。  哦，不錯。  滾出我的大廳。  你到底在哪裡？"}, {"type": "subtitle", "time": 4956.79, "timestamp": "01:22:36", "text": "等等，在你身後。你身後。你身後。"}, {"type": "subtitle", "time": 4965.59, "timestamp": "01:22:45", "text": "好的。  我死了。"}, {"type": "subtitle", "time": 4967.03, "timestamp": "01:22:47", "text": "順便說一句，你也可以"}]
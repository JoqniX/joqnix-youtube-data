[{"type": "subtitle", "time": 5110.87, "timestamp": "01:25:10", "text": "。」"}, {"type": "subtitle", "time": 5113.51, "timestamp": "01:25:13", "text": "你剛才說什麼？  所以，你沒用你的眩暈技能？  我忘"}, {"type": "subtitle", "time": 5116.229, "timestamp": "01:25:16", "text": "了用"}, {"type": "subtitle", "time": 5124.87, "timestamp": "01:25:24", "text": "眩暈技能。是的。  你怎麼會忘記事情？告訴我。  好的。  快點告訴我。"}, {"type": "subtitle", "time": 5131.35, "timestamp": "01:25:31", "text": "你怎麼會"}, {"type": "subtitle", "time": 5135.35, "timestamp": "01:25:35", "text": "忘記呢？我的錯。 O來了。刺得我"}]
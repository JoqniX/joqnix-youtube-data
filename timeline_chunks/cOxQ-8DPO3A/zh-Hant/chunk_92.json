[{"type": "subtitle", "time": 5536.87, "timestamp": "01:32:16", "text": "哦，她，"}, {"type": "subtitle", "time": 5539.83, "timestamp": "01:32:19", "text": "你怎麼弄丟了那個？  哦，她劃傷了我。她情緒非常低落。治療師治好了她"}, {"type": "subtitle", "time": 5555.51, "timestamp": "01:32:35", "text": "。"}, {"type": "subtitle", "time": 5562.629, "timestamp": "01:32:42", "text": "不，不，她奪走了我的健康，還傷了我。"}, {"type": "subtitle", "time": 5565.27, "timestamp": "01:32:45", "text": "我的天啊。  稍等片刻（音樂）。"}, {"type": "subtitle", "time": 5575.99, "timestamp": "01:32:55", "text": "你能射殺他們中的任何一個人嗎？  哦，等等。"}]
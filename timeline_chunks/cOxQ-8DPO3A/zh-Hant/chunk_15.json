[{"type": "chat", "time": 900.804, "timestamp": "00:15:00", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/G8AfY6yWGuKuhL0PlbiA2AEUCkszU2WH9gy1mb0dV-11UJg/G8AfY6yWGuKuhL0PlbiA2AE"}, {"type": "subtitle", "time": 905.91, "timestamp": "00:15:05", "text": "沒有人能獨自承受這一切。"}, {"type": "subtitle", "time": 919.91, "timestamp": "00:15:19", "text": "但是，是的，這個問題很容易解決。很容易反駁，讓我告訴你。我想是因為你要記得你角色的……哦，還有友軍傷害。  你聽到了人們的議論。我的天啊。  就讓他們去對付敵人。  哦，你不需要總是把鉤子伸出來。  我好的。  是的，"}, {"type": "subtitle", "time": 937.269, "timestamp": "00:15:37", "text": "我會……向自己"}, {"type": "subtitle", "time": 939.11, "timestamp": "00:15:39", "text": "開槍。  是的，你"}, {"type": "subtitle", "time": 942.389, "timestamp": "00:15:42", "text": "不能開槍打我。"}, {"type": "subtitle", "time": 943.99, "timestamp": "00:15:43", "text": "即便這是他以前的東西，也像是他把你以前的東西全都佔為己有了。你知道嗎？  你所有的東西。"}, {"type": "subtitle", "time": 946.31, "timestamp": "00:15:46", "text": "法官、陪審團、家人，但"}, {"type": "subtitle", "time": 957.03, "timestamp": "00:15:57", "text": "我可以一擊斃命。我不是想一擊必殺你。"}]
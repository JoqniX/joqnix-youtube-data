[{"type": "subtitle", "time": 6609.59, "timestamp": "01:50:09", "text": "像我這樣的角色不太擅長，但我確信我比大多數人都強"}, {"type": "subtitle", "time": 6612.58, "timestamp": "01:50:12", "text": "。  你得看看你的技能冷卻時間。  是的，也可以使用右鍵點擊。"}, {"type": "subtitle", "time": 6631.669, "timestamp": "01:50:31", "text": "我沒看到你點擊右鍵。  對，抓住"}, {"type": "subtitle", "time": 6647.99, "timestamp": "01:50:47", "text": "抓住他。拿到"}, {"type": "subtitle", "time": 6657.43, "timestamp": "01:50:57", "text": "戒指。  制勝之道。他獲勝的幾率太小了。  我選美國隊長。"}]
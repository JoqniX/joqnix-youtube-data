[{"type": "subtitle", "time": 9181.75, "timestamp": "02:33:01", "text": "，死了一個人。  一人倖存，"}, {"type": "subtitle", "time": 9208.87, "timestamp": "02:33:28", "text": "哦，是的。  好的。"}, {"type": "subtitle", "time": 9211.83, "timestamp": "02:33:31", "text": "現在"}, {"type": "subtitle", "time": 9214.65, "timestamp": "02:33:34", "text": "他們會從兩邊都來。從上往下。它即將被關閉。"}, {"type": "subtitle", "time": 9229.19, "timestamp": "02:33:49", "text": "這一定是個陷阱。  法官、陪審團、行刑。  是的，盡量盡快幹掉那些大傢伙。  先殺掉個頭大的。讓我們幹掉那些大傢伙。目標是領先。目標是領先。"}]
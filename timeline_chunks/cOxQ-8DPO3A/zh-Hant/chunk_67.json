[{"type": "subtitle", "time": 4020.87, "timestamp": "01:07:00", "text": "何處？好的。"}, {"type": "subtitle", "time": 4028.71, "timestamp": "01:07:08", "text": "那邊有個人物"}, {"type": "subtitle", "time": 4031.109, "timestamp": "01:07:11", "text": "。"}, {"type": "subtitle", "time": 4037.19, "timestamp": "01:07:17", "text": "你得了C。我要拿走我的報酬。好的。  好一個。好吧，他死了。他為了殺你而死。好的，試著殺死BP。  嗯，為什麼你們在"}, {"type": "subtitle", "time": 4039.029, "timestamp": "01:07:19", "text": "那邊的時候，他們都死了呢？  我的天哪，我就是那個要死的"}, {"type": "subtitle", "time": 4059.029, "timestamp": "01:07:39", "text": "我們將如何死去？  傑夫正在治愈我。"}, {"type": "subtitle", "time": 4065.029, "timestamp": "01:07:45", "text": "想辦法殺了這傢伙。我的天哪，我殺了他。  哦，試試看能不能"}, {"type": "subtitle", "time": 4067.589, "timestamp": "01:07:47", "text": "拍到傳單。我打算給他發個訊息。試著"}, {"type": "subtitle", "time": 4069.99, "timestamp": "01:07:49", "text": "去追"}, {"type": "subtitle", "time": 4071.109, "timestamp": "01:07:51", "text": "他。"}]
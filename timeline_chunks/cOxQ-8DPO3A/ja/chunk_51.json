[{"type": "subtitle", "time": 3061.19, "timestamp": "00:51:01", "text": "うん。"}, {"type": "subtitle", "time": 3062.79, "timestamp": "00:51:02", "text": "ああ、試合があるんだ。"}, {"type": "subtitle", "time": 3065.589, "timestamp": "00:51:05", "text": "うん。"}, {"type": "subtitle", "time": 3067.75, "timestamp": "00:51:07", "text": "つまり、スカーレット・ウィッチのことですよね？ ああ、そういえば"}, {"type": "subtitle", "time": 3071.109, "timestamp": "00:51:11", "text": "チームのメンバーを言い忘れてた。 くそ。"}, {"type": "subtitle", "time": 3073.43, "timestamp": "00:51:13", "text": "私はドクター・ストレンジを演じます。 くそっ。"}, {"type": "subtitle", "time": 3076.87, "timestamp": "00:51:16", "text": "それを忘れていました。 気になっていたのですが、確かに"}, {"type": "subtitle", "time": 3078.15, "timestamp": "00:51:18", "text": "役に立ちます。"}, {"type": "subtitle", "time": 3082.23, "timestamp": "00:51:22", "text": "それで、スカーレット・ウィッチと、えーと、ドクター・"}, {"type": "subtitle", "time": 3085.27, "timestamp": "00:51:25", "text": "ストレンジがチームを組んで、何ていう名前だったっけ"}, {"type": "subtitle", "time": 3090.47, "timestamp": "00:51:30", "text": "？"}, {"type": "subtitle", "time": 3092.79, "timestamp": "00:51:32", "text": "神秘的とか秩序とか、そんな感じのもの。"}, {"type": "subtitle", "time": 3095.67, "timestamp": "00:51:35", "text": "アーケインなんとかだと思う。 つまり、それは"}, {"type": "subtitle", "time": 3098.79, "timestamp": "00:51:38", "text": "別の能力です。 いいえ、あなたには"}, {"type": "subtitle", "time": 3100.95, "timestamp": "00:51:40", "text": "3つ目の能力があります。   わかった"}, {"type": "subtitle", "time": 3102.47, "timestamp": "00:51:42", "text": "。"}, {"type": "subtitle", "time": 3110.069, "timestamp": "00:51:50", "text": "戦っているんですか？"}, {"type": "subtitle", "time": 3111.75, "timestamp": "00:51:51", "text": "ほら、見えるかい？"}, {"type": "subtitle", "time": 3113.43, "timestamp": "00:51:53", "text": "開きましたか？ それでは、両方の"}, {"type": "subtitle", "time": 3115.109, "timestamp": "00:51:55", "text": "ボタンを押してください。 左クリックと右クリックを"}, {"type": "subtitle", "time": 3117.91, "timestamp": "00:51:57", "text": "同時に行う。 あれが見えますか？"}]
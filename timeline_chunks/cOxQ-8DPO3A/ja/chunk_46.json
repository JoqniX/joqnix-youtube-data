[{"type": "subtitle", "time": 2761.91, "timestamp": "00:46:01", "text": "言っておきます。ただの注意喚起ですが、"}, {"type": "subtitle", "time": 2763.91, "timestamp": "00:46:03", "text": "ほとんどの人は上手ではないのでそうしません。"}, {"type": "subtitle", "time": 2769.109, "timestamp": "00:46:09", "text": "スパイダーマンに対抗すると、ほとんどの場合、"}, {"type": "subtitle", "time": 2771.349, "timestamp": "00:46:11", "text": "SC を使ってスパイダーマンに対抗します。"}, {"type": "subtitle", "time": 2772.71, "timestamp": "00:46:12", "text": "スパイダーマンは、"}, {"type": "subtitle", "time": 2777.109, "timestamp": "00:46:17", "text": "狙いを定める必要がないので、スパイダーマンを見て、ただ"}, {"type": "subtitle", "time": 2781.43, "timestamp": "00:46:21", "text": "カオスを常に優勢にするだけです。ああ、そうか、"}, {"type": "subtitle", "time": 2793.349, "timestamp": "00:46:33", "text": "私を攻撃しようとしない限り、私の魔法を恐れる必要はない。"}, {"type": "subtitle", "time": 2795.349, "timestamp": "00:46:35", "text": "レポートが消えつつあります。"}, {"type": "subtitle", "time": 2801.27, "timestamp": "00:46:41", "text": "ちなみに、私たちがあなたに勝ったとしても、スパイダーマンが勝つわけではありません。 彼はそうする。"}, {"type": "subtitle", "time": 2803.67, "timestamp": "00:46:43", "text": "つまり、あなたはこれらの"}, {"type": "subtitle", "time": 2806.71, "timestamp": "00:46:46", "text": "キャラクターに対するカウンターのような存在なのですね。 よし、君はカウンターダイブだ。"}, {"type": "subtitle", "time": 2812.47, "timestamp": "00:46:52", "text": "スパイダーマンに与えるダメージ量を見て、君を攻撃できない、"}, {"type": "subtitle", "time": 2813.349, "timestamp": "00:46:53", "text": "攻撃できるかどうか分かるよ。"}, {"type": "subtitle", "time": 2815.109, "timestamp": "00:46:55", "text": "混沌は常に支配する。"}, {"type": "subtitle", "time": 2817.349, "timestamp": "00:46:57", "text": "ええ、"}, {"type": "subtitle", "time": 2819.03, "timestamp": "00:46:59", "text": "それはあなたのカウンタータイプのキャラクターです。 つまり、"}]
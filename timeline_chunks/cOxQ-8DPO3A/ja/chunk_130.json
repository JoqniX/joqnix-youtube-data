[{"type": "subtitle", "time": 7801.83, "timestamp": "02:10:01", "text": "短時間で決着がつき、相手には"}, {"type": "subtitle", "time": 7804.39, "timestamp": "02:10:04", "text": "ヒーラーが一人しかいなかった。 ええ、そうですね。"}, {"type": "subtitle", "time": 7805.91, "timestamp": "02:10:05", "text": "彼らには2人の子供がいたが、そのうちの1人はジェフだった。"}, {"type": "subtitle", "time": 7814.55, "timestamp": "02:10:14", "text": "ゾンビになるんだよね？"}, {"type": "subtitle", "time": 7816.149, "timestamp": "02:10:16", "text": "うん、ゾンビごっこできるよ。"}, {"type": "subtitle", "time": 7817.189, "timestamp": "02:10:17", "text": "ゾンビゲームをプレイしたことはありますか？"}, {"type": "subtitle", "time": 7817.589, "timestamp": "02:10:17", "text": "いいえ。"}, {"type": "subtitle", "time": 7818.95, "timestamp": "02:10:18", "text": "このゲームでの話だよ。"}, {"type": "subtitle", "time": 7821.189, "timestamp": "02:10:21", "text": "いいえ。"}, {"type": "subtitle", "time": 7824.39, "timestamp": "02:10:24", "text": "楽しいよ。 それはまるで、あなたを「ちょっと待って」というところへ連れ戻してくれるようなものだ"}, {"type": "subtitle", "time": 7827.03, "timestamp": "02:10:27", "text": "。 ちょっと"}, {"type": "subtitle", "time": 7828.95, "timestamp": "02:10:28", "text": "息抜きしようぜ、相棒。 ちくしょう"}, {"type": "subtitle", "time": 7829.27, "timestamp": "02:10:29", "text": "。"}, {"type": "subtitle", "time": 7831.91, "timestamp": "02:10:31", "text": "あ、待って。 うん。 うん。   なんてこった"}, {"type": "subtitle", "time": 7836.709, "timestamp": "02:10:36", "text": "。 私は配信者ではありません。"}, {"type": "subtitle", "time": 7840.47, "timestamp": "02:10:40", "text": "私にはあなたみたいなエネルギーがないんです。"}, {"type": "subtitle", "time": 7841.91, "timestamp": "02:10:41", "text": "ええと、ちょっと待ってください。 ちょっと小便させてくれよ"}, {"type": "subtitle", "time": 7843.99, "timestamp": "02:10:43", "text": "。 水を飲ませてくれよ"}, {"type": "subtitle", "time": 7847.43, "timestamp": "02:10:47", "text": "。 そして、それを自分のために行うのです。"}]
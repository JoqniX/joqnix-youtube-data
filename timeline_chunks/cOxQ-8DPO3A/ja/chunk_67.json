[{"type": "subtitle", "time": 4020.87, "timestamp": "01:07:00", "text": "そこへ行くのか？"}, {"type": "subtitle", "time": 4022.15, "timestamp": "01:07:02", "text": "彼女を殺そうとする。 彼女を見つけて殺そう"}, {"type": "subtitle", "time": 4026.23, "timestamp": "01:07:06", "text": "。 彼女を見つけて殺せ。 彼女を見つけて殺せ。"}, {"type": "subtitle", "time": 4028.71, "timestamp": "01:07:08", "text": "今、あそこにいる。 上のキャラクターを殺せ"}, {"type": "subtitle", "time": 4031.109, "timestamp": "01:07:11", "text": "。"}, {"type": "subtitle", "time": 4033.43, "timestamp": "01:07:13", "text": "ああ、その射程距離。   何てことだ"}, {"type": "subtitle", "time": 4035.43, "timestamp": "01:07:15", "text": "。"}, {"type": "subtitle", "time": 4037.19, "timestamp": "01:07:17", "text": "お前は狙いが定まらないくせに、とんでもなく射程距離が長いな"}, {"type": "subtitle", "time": 4039.029, "timestamp": "01:07:19", "text": "。 ところで、この辺りには"}, {"type": "subtitle", "time": 4052.71, "timestamp": "01:07:32", "text": "何？   どうでも。"}, {"type": "subtitle", "time": 4059.029, "timestamp": "01:07:39", "text": "あれが見えて、撃ってみることはできますか？"}, {"type": "subtitle", "time": 4065.029, "timestamp": "01:07:45", "text": "こっちのペニーを殺してみろ。 無理な"}, {"type": "subtitle", "time": 4067.589, "timestamp": "01:07:47", "text": "努力は禁物です。 彼女は"}, {"type": "subtitle", "time": 4069.99, "timestamp": "01:07:49", "text": "左側にいます。 左へ行って"}, {"type": "subtitle", "time": 4071.109, "timestamp": "01:07:51", "text": "彼女を殺してみろ。   どうでも。"}]
[{"type": "subtitle", "time": 3244.71, "timestamp": "00:54:04", "text": "そして、自分の位置取りをしてください。 正面から突っ込むな。"}, {"type": "subtitle", "time": 3247.03, "timestamp": "00:54:07", "text": "お前は無敵だ。"}, {"type": "subtitle", "time": 3249.51, "timestamp": "00:54:09", "text": "常に冷静さを保つように心がけましょう。"}, {"type": "subtitle", "time": 3252.79, "timestamp": "00:54:12", "text": "処刑人は替え玉を用意した。"}, {"type": "subtitle", "time": 3253.99, "timestamp": "00:54:13", "text": "彼を殺せ。 彼を殺そうとする。"}, {"type": "subtitle", "time": 3255.19, "timestamp": "00:54:15", "text": "彼を殺そうとする。 彼を殺せ。 彼を殺せ。"}, {"type": "subtitle", "time": 3257.03, "timestamp": "00:54:17", "text": "彼を殺そうとする。"}, {"type": "subtitle", "time": 3257.589, "timestamp": "00:54:17", "text": "はぁ？"}, {"type": "subtitle", "time": 3259.91, "timestamp": "00:54:19", "text": "あなたはBを持っています。"}, {"type": "subtitle", "time": 3262.63, "timestamp": "00:54:22", "text": "私は持っていました。"}, {"type": "subtitle", "time": 3265.829, "timestamp": "00:54:25", "text": "お前はBを2つも取ったな、相棒。 私は自分の分をもっと"}, {"type": "subtitle", "time": 3267.03, "timestamp": "00:54:27", "text": "早く使い切ったと思う。"}, {"type": "subtitle", "time": 3268.309, "timestamp": "00:54:28", "text": "運命はまだ決まっていない。"}, {"type": "subtitle", "time": 3270.79, "timestamp": "00:54:30", "text": "どこ？  where はどこで使用しましたか？"}, {"type": "subtitle", "time": 3273.589, "timestamp": "00:54:33", "text": "地面に早く着地するためにそれを使ったんだ。ああ"}, {"type": "subtitle", "time": 3278.069, "timestamp": "00:54:38", "text": "、それから上手くプレーしないといけないんだよ。"}, {"type": "subtitle", "time": 3279.829, "timestamp": "00:54:39", "text": "例えば、フェードを1回使うなら、自分"}, {"type": "subtitle", "time": 3281.51, "timestamp": "00:54:41", "text": "自身も上手くプレーしないといけない。"}, {"type": "subtitle", "time": 3284.23, "timestamp": "00:54:44", "text": "それはちょっと悲しいですね。"}, {"type": "subtitle", "time": 3287.03, "timestamp": "00:54:47", "text": "つまり、私はなぜなのか"}, {"type": "subtitle", "time": 3289.99, "timestamp": "00:54:49", "text": "？"}, {"type": "subtitle", "time": 3291.03, "timestamp": "00:54:51", "text": "そこには誰もいなかった。"}, {"type": "subtitle", "time": 3297.03, "timestamp": "00:54:57", "text": "チームを見なければならない。 目があるんだよ、おい。"}, {"type": "subtitle", "time": 3299.43, "timestamp": "00:54:59", "text": "なぜ私はこんなにダメなんだろう？"}]
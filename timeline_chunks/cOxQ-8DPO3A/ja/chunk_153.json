[{"type": "subtitle", "time": 9181.75, "timestamp": "02:33:01", "text": "騎士の奴隷になってしまった。 わかった。"}, {"type": "subtitle", "time": 9187.03, "timestamp": "02:33:07", "text": "。   わかった"}, {"type": "subtitle", "time": 9189.11, "timestamp": "02:33:09", "text": "。 さあ、もう一度準備を始めよう。 それでは、"}, {"type": "subtitle", "time": 9195.03, "timestamp": "02:33:15", "text": "キャラクターの赤いアイテムをすべて埋めてください。   わかった"}, {"type": "subtitle", "time": 9197.349, "timestamp": "02:33:17", "text": "。"}, {"type": "subtitle", "time": 9199.12, "timestamp": "02:33:19", "text": "うん。"}, {"type": "subtitle", "time": 9208.87, "timestamp": "02:33:28", "text": "ああ、わかりました。"}, {"type": "subtitle", "time": 9211.83, "timestamp": "02:33:31", "text": "今度は、ノーマルモードではなく、ナイトメアモードをハードに設定してください"}, {"type": "subtitle", "time": 9214.65, "timestamp": "02:33:34", "text": "。 今すぐ確認できます。"}, {"type": "subtitle", "time": 9225.67, "timestamp": "02:33:45", "text": "いいえ、別の問題です。   そうそう"}, {"type": "subtitle", "time": 9226.23, "timestamp": "02:33:46", "text": "。"}, {"type": "subtitle", "time": 9229.19, "timestamp": "02:33:49", "text": "はい。 さて、これからもっと"}, {"type": "subtitle", "time": 9230.389, "timestamp": "02:33:50", "text": "難しくなる、とおっしゃるのですか"}, {"type": "subtitle", "time": 9232.87, "timestamp": "02:33:52", "text": "？ だから、ただじっと立って"}, {"type": "subtitle", "time": 9236.87, "timestamp": "02:33:56", "text": "攻撃を受け止めるだけではダメなんだ。"}, {"type": "subtitle", "time": 9239.51, "timestamp": "02:33:59", "text": "そして、ナイトメア4を手に入れたら、彼らはいつでも"}]
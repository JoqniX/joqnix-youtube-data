[{"type": "subtitle", "time": 9127.11, "timestamp": "02:32:07", "text": "ああ、今気づいた。"}, {"type": "subtitle", "time": 9130.79, "timestamp": "02:32:10", "text": "うん。 彼女を撃て。 あの女を撃て。 あの女を撃て"}, {"type": "subtitle", "time": 9133.27, "timestamp": "02:32:13", "text": "。"}, {"type": "subtitle", "time": 9135.59, "timestamp": "02:32:15", "text": "あなたはこれに関して非常に優秀です。 さあ、いよいよ"}, {"type": "subtitle", "time": 9139.19, "timestamp": "02:32:19", "text": "最終段階がやってくる。"}, {"type": "subtitle", "time": 9140.55, "timestamp": "02:32:20", "text": "結晶のようなものが出てくるのが見えるでしょう"}, {"type": "subtitle", "time": 9143.67, "timestamp": "02:32:23", "text": "。 ジョー、クリスタルを撃たなきゃいけないんだ。"}, {"type": "subtitle", "time": 9144.389, "timestamp": "02:32:24", "text": "よし、"}, {"type": "subtitle", "time": 9148.469, "timestamp": "02:32:28", "text": "結晶だ。 ええ、"}, {"type": "subtitle", "time": 9150.63, "timestamp": "02:32:30", "text": "私は"}, {"type": "subtitle", "time": 9152.469, "timestamp": "02:32:32", "text": "クリスタル派よ、ジョー。"}, {"type": "subtitle", "time": 9154.469, "timestamp": "02:32:34", "text": "どこ？"}, {"type": "subtitle", "time": 9155.99, "timestamp": "02:32:35", "text": "彼女の後ろに。 動き続けなければならない。"}, {"type": "subtitle", "time": 9162.07, "timestamp": "02:32:42", "text": "はい、彼女はそうしました。"}, {"type": "subtitle", "time": 9179.59, "timestamp": "02:32:59", "text": "くそったれブレードは月の"}]
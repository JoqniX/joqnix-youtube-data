[{"type": "subtitle", "time": 12841.91, "timestamp": "03:34:01", "text": "そして可能であれば、DNAを配信しようと思います。"}, {"type": "subtitle", "time": 12844.71, "timestamp": "03:34:04", "text": "こんにちは。宿題を早く終わらせることができれば、"}, {"type": "subtitle", "time": 12848.15, "timestamp": "03:34:08", "text": "それでいい。よかった。DNAを"}, {"type": "subtitle", "time": 12850.469, "timestamp": "03:34:10", "text": "プレイできるし、"}, {"type": "subtitle", "time": 12857.99, "timestamp": "03:34:17", "text": "ブループロトコルでAFKファーミングをしなければならない。今は"}, {"type": "subtitle", "time": 12860.469, "timestamp": "03:34:20", "text": "金曜日だから。"}, {"type": "subtitle", "time": 12864.15, "timestamp": "03:34:24", "text": "任務やその他全てをもっと早くこなさなきゃ。"}, {"type": "subtitle", "time": 12866.309, "timestamp": "03:34:26", "text": "よし。とにかく、こんにちは。"}, {"type": "subtitle", "time": 12870.469, "timestamp": "03:34:30", "text": "今日はこれで終わりです。皆さん、来てくれてありがとう。"}, {"type": "subtitle", "time": 12874.63, "timestamp": "03:34:34", "text": "さようなら。あ、待って。あれは黒いタイだ。"}, {"type": "subtitle", "time": 12877.429, "timestamp": "03:34:37", "text": "良い一日を。良い金曜日を。"}, {"type": "subtitle", "time": 12880.229, "timestamp": "03:34:40", "text": "良い夜を。"}]
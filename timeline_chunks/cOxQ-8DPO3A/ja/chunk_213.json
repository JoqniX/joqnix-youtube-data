[{"type": "subtitle", "time": 12782.229, "timestamp": "03:33:02", "text": "自動バンしないといけないな。"}, {"type": "subtitle", "time": 12789.11, "timestamp": "03:33:09", "text": "実際に自動バンされた。まあいいや"}, {"type": "subtitle", "time": 12801.83, "timestamp": "03:33:21", "text": "あ、いいね。"}, {"type": "subtitle", "time": 12804.55, "timestamp": "03:33:24", "text": "実際に設定したっけ？実際に設定した"}, {"type": "subtitle", "time": 12813.51, "timestamp": "03:33:33", "text": "あ、ここには見当たらない。変だな。でも"}, {"type": "subtitle", "time": 12818.229, "timestamp": "03:33:38", "text": "、確かに変だ。すごくクールだ。"}, {"type": "subtitle", "time": 12820.71, "timestamp": "03:33:40", "text": "こんにちは。はい、ここで終わりにします。ご"}, {"type": "subtitle", "time": 12822.71, "timestamp": "03:33:42", "text": "視聴ありがとうございました。今夜は、ええと、ああ、"}, {"type": "subtitle", "time": 12824.71, "timestamp": "03:33:44", "text": "待って。"}, {"type": "subtitle", "time": 12828.79, "timestamp": "03:33:48", "text": "今日は宿題があると思う。ええと、たぶん"}, {"type": "subtitle", "time": 12834.469, "timestamp": "03:33:54", "text": "昨日と同じように宿題をやることになると思う。"}, {"type": "subtitle", "time": 12836.87, "timestamp": "03:33:56", "text": "日本語の宿題。"}]
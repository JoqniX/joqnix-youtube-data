[{"type": "subtitle", "time": 9781.03, "timestamp": "02:43:01", "text": "。 例えば、彼の頭を見て、"}, {"type": "subtitle", "time": 9815.429, "timestamp": "02:43:35", "text": "ああ、君の銃は砲塔よりもダメージが大きいんだね"}, {"type": "subtitle", "time": 9817.83, "timestamp": "02:43:37", "text": "。 念のため言っておきます。"}, {"type": "subtitle", "time": 9824.87, "timestamp": "02:43:44", "text": "知っているなら、なぜそんなことをするのですか？ 何だって"}, {"type": "subtitle", "time": 9825.99, "timestamp": "02:43:45", "text": "？"}, {"type": "subtitle", "time": 9829.19, "timestamp": "02:43:49", "text": "私はそれがより良いと思った。"}, {"type": "subtitle", "time": 9838.469, "timestamp": "02:43:58", "text": "砲塔から出て円の中に座れるか"}]
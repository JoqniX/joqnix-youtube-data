[{"type": "subtitle", "time": 11831.349, "timestamp": "03:17:11", "text": "ああ、くそ。"}, {"type": "subtitle", "time": 11833.59, "timestamp": "03:17:13", "text": "彼女を最終選考に残しただけだ。 一体どういうことだ？"}, {"type": "subtitle", "time": 11835.51, "timestamp": "03:17:15", "text": "私たちはその水晶を持つべきでしょうか"}, {"type": "subtitle", "time": 11838.309, "timestamp": "03:17:18", "text": "？ わかった。"}, {"type": "subtitle", "time": 11840.71, "timestamp": "03:17:20", "text": "うん。"}, {"type": "subtitle", "time": 11844.469, "timestamp": "03:17:24", "text": "おお。"}, {"type": "subtitle", "time": 11846.63, "timestamp": "03:17:26", "text": "彼女は死んだ。"}, {"type": "subtitle", "time": 11848.95, "timestamp": "03:17:28", "text": "そっちの方が早かった。"}, {"type": "subtitle", "time": 11857.91, "timestamp": "03:17:37", "text": "ニース。 え、これらのスキン全部にお金を払ったの"}, {"type": "subtitle", "time": 11860.95, "timestamp": "03:17:40", "text": "？"}, {"type": "subtitle", "time": 11863.03, "timestamp": "03:17:43", "text": "いいえ、こちらは無料版です。"}, {"type": "subtitle", "time": 11867.11, "timestamp": "03:17:47", "text": "ああ、でもリスのやつを買ったんだよね"}, {"type": "subtitle", "time": 11867.75, "timestamp": "03:17:47", "text": "？"}, {"type": "subtitle", "time": 11870.229, "timestamp": "03:17:50", "text": "うん、リスのやつを買ったよ。 うん。"}, {"type": "subtitle", "time": 11870.63, "timestamp": "03:17:50", "text": "おお。"}, {"type": "subtitle", "time": 11873.19, "timestamp": "03:17:53", "text": "私の画面をクリックすると表示されるものも、私が購入したものです"}, {"type": "subtitle", "time": 11876.229, "timestamp": "03:17:56", "text": "。"}, {"type": "subtitle", "time": 11877.83, "timestamp": "03:17:57", "text": "えっと、"}]
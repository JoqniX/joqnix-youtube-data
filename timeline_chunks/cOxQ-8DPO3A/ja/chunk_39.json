[{"type": "subtitle", "time": 2341.19, "timestamp": "00:39:01", "text": "一つ試してみて。 一方通行。   いやいや、"}, {"type": "subtitle", "time": 2344.31, "timestamp": "00:39:04", "text": "フェードはそのままにしておいて。 わかった。"}, {"type": "subtitle", "time": 2345.91, "timestamp": "00:39:05", "text": "何をしているんだ？"}, {"type": "subtitle", "time": 2348.71, "timestamp": "00:39:08", "text": "ああ、1対1って言ったんですね。"}, {"type": "subtitle", "time": 2351.19, "timestamp": "00:39:11", "text": "うん。 だから、1対1の状況で"}, {"type": "subtitle", "time": 2353.19, "timestamp": "00:39:13", "text": "常に代替手段を使えるとは限らないという意味ではないんだよ"}, {"type": "subtitle", "time": 2353.99, "timestamp": "00:39:13", "text": "。   わかった"}, {"type": "subtitle", "time": 2356.23, "timestamp": "00:39:16", "text": "。 わかった。 わかった。   よし"}, {"type": "subtitle", "time": 2357.109, "timestamp": "00:39:17", "text": "。"}, {"type": "subtitle", "time": 2359.67, "timestamp": "00:39:19", "text": "私と1対1。 そして、"}, {"type": "subtitle", "time": 2365.03, "timestamp": "00:39:25", "text": "相手が"}, {"type": "subtitle", "time": 2373.99, "timestamp": "00:39:33", "text": "私と同じように３人。 登った時のことを覚えていないのですか？"}, {"type": "subtitle", "time": 2375.27, "timestamp": "00:39:35", "text": "楽しかったです。"}, {"type": "subtitle", "time": 2376.39, "timestamp": "00:39:36", "text": "ああ、おい"}, {"type": "subtitle", "time": 2379.349, "timestamp": "00:39:39", "text": "。 私はここであなたに教えています。 私が"}, {"type": "subtitle", "time": 2381.02, "timestamp": "00:39:41", "text": "あなたに教えているのです。"}, {"type": "subtitle", "time": 2383.67, "timestamp": "00:39:43", "text": "[音楽]"}, {"type": "subtitle", "time": 2386.87, "timestamp": "00:39:46", "text": "オーケー。 フェードを使うときは、必ず上方向に動かしてください。 わかった。"}, {"type": "subtitle", "time": 2390.23, "timestamp": "00:39:50", "text": "うん。   わかった"}, {"type": "subtitle", "time": 2398.069, "timestamp": "00:39:58", "text": "[拍手] お前"}]
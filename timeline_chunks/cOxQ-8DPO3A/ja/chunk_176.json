[{"type": "subtitle", "time": 10580.389, "timestamp": "02:56:20", "text": "そう、敵が複数いるときは、タレットを敵の集団に向けて使うんだ"}, {"type": "subtitle", "time": 10582.79, "timestamp": "02:56:22", "text": "。"}, {"type": "subtitle", "time": 10586.469, "timestamp": "02:56:26", "text": "ああ、今度は這いずり回るゾンビがいる。"}, {"type": "subtitle", "time": 10589.269, "timestamp": "02:56:29", "text": "ああ、君は「"}, {"type": "subtitle", "time": 10591.19, "timestamp": "02:56:31", "text": "ああ、いや」を見たことがないんだね。 これが"}, {"type": "subtitle", "time": 10600.23, "timestamp": "02:56:40", "text": "時間がかかるんだよ。ああ"}, {"type": "subtitle", "time": 10601.59, "timestamp": "02:56:41", "text": "、赤いやつだよ。"}, {"type": "subtitle", "time": 10603.99, "timestamp": "02:56:43", "text": "奴らは狂暴な奴らだから、"}, {"type": "subtitle", "time": 10604.87, "timestamp": "02:56:44", "text": "死ぬまでには長い時間がかかる。"}, {"type": "subtitle", "time": 10608.309, "timestamp": "02:56:48", "text": "しかし、タイマーは刻々と過ぎていく。"}, {"type": "subtitle", "time": 10609.75, "timestamp": "02:56:49", "text": "それはタイマーではありません。 それが"}, {"type": "subtitle", "time": 10617.67, "timestamp": "02:56:57", "text": "見えますか？ それが"}]
[{"type": "subtitle", "time": 9485.51, "timestamp": "02:38:05", "text": "ああ、死にそうだ。 え、何これ？"}, {"type": "subtitle", "time": 9488.95, "timestamp": "02:38:08", "text": "ああ、死ぬこともあるよ。"}, {"type": "subtitle", "time": 9490.71, "timestamp": "02:38:10", "text": "ええ、そうです"}, {"type": "subtitle", "time": 9493.11, "timestamp": "02:38:13", "text": "。"}, {"type": "subtitle", "time": 9495.83, "timestamp": "02:38:15", "text": "いや、いや、いや、いや。 ただ、ゆっくりと戻ってきてください"}, {"type": "subtitle", "time": 9496.95, "timestamp": "02:38:16", "text": "。 ああ、"}, {"type": "subtitle", "time": 9503.349, "timestamp": "02:38:23", "text": "頭を狙えよ、相棒。"}, {"type": "subtitle", "time": 9511.349, "timestamp": "02:38:31", "text": "強烈な混沌のエネルギーが"}, {"type": "subtitle", "time": 9514.63, "timestamp": "02:38:34", "text": "グランドセントラル駅を襲った。 私の"}, {"type": "subtitle", "time": 9518.15, "timestamp": "02:38:38", "text": "分身があなたのために道を切り開きます。"}, {"type": "subtitle", "time": 9526.79, "timestamp": "02:38:46", "text": "さあ、ここから上の砲塔に座ることができます"}, {"type": "subtitle", "time": 9538.55, "timestamp": "02:38:58", "text": "あなたは自分の煙の中にいて、それがあなたを高揚させる"}]
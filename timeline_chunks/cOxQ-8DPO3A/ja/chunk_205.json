[{"type": "subtitle", "time": 12300.87, "timestamp": "03:25:00", "text": "。 わかりました。 それなら大丈夫です。"}, {"type": "subtitle", "time": 12302.229, "timestamp": "03:25:02", "text": "次回にプレイしましょう。"}, {"type": "subtitle", "time": 12304.309, "timestamp": "03:25:04", "text": "はい。"}, {"type": "subtitle", "time": 12305.429, "timestamp": "03:25:05", "text": "このゲームは取っておきます。"}, {"type": "subtitle", "time": 12306.79, "timestamp": "03:25:06", "text": "ああ、楽しかった。"}, {"type": "subtitle", "time": 12307.429, "timestamp": "03:25:07", "text": "うん。"}, {"type": "subtitle", "time": 12310.15, "timestamp": "03:25:10", "text": "うん、プレイするよ。 それから、"}, {"type": "subtitle", "time": 12312.95, "timestamp": "03:25:12", "text": "あなたが"}, {"type": "subtitle", "time": 12316.07, "timestamp": "03:25:16", "text": "クソみたいなゲームを終えたら、ついに"}, {"type": "subtitle", "time": 12322.229, "timestamp": "03:25:22", "text": "そして私はあなたに"}, {"type": "subtitle", "time": 12324.389, "timestamp": "03:25:24", "text": "激しく怒鳴りつけるでしょう。 君も知ってるだろ、あの時、"}, {"type": "subtitle", "time": 12326.389, "timestamp": "03:25:26", "text": "俺は君に激しく怒鳴りつけてたんだ。 念のため"}, {"type": "subtitle", "time": 12329.03, "timestamp": "03:25:29", "text": "言っておきます。"}, {"type": "subtitle", "time": 12331.03, "timestamp": "03:25:31", "text": "あんたはそれを究極のプレーと呼ぶのか、このクソ野郎"}, {"type": "subtitle", "time": 12333.51, "timestamp": "03:25:33", "text": "？ それを"}, {"type": "subtitle", "time": 12335.83, "timestamp": "03:25:35", "text": "究極と呼ぶのか？ あるいは、おそらくそんな感じでしょう"}, {"type": "subtitle", "time": 12343.59, "timestamp": "03:25:43", "text": "お前は殺し方すら知らないくせに、"}, {"type": "subtitle", "time": 12345.75, "timestamp": "03:25:45", "text": "新しい"}, {"type": "subtitle", "time": 12347.19, "timestamp": "03:25:47", "text": "キャラクターも覚えなきゃいけないのか。"}, {"type": "subtitle", "time": 12349.429, "timestamp": "03:25:49", "text": "お前はクソみたいな皮膚を持ってるんだな。 刃の"}, {"type": "subtitle", "time": 12351.03, "timestamp": "03:25:51", "text": "表面。 かっこいいスキンですね。"}, {"type": "subtitle", "time": 12353.11, "timestamp": "03:25:53", "text": "うん、めちゃくちゃ"}, {"type": "subtitle", "time": 12354.95, "timestamp": "03:25:54", "text": "かっこいいスキンだね。"}]
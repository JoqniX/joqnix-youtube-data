[{"type": "subtitle", "time": 12060.469, "timestamp": "03:21:00", "text": "DNA検査を毎日行いましたか？"}, {"type": "subtitle", "time": 12062.63, "timestamp": "03:21:02", "text": "今日はやらなかった。"}, {"type": "subtitle", "time": 12066.469, "timestamp": "03:21:06", "text": "ああ、いいね。 今は本当に速いですね。"}, {"type": "subtitle", "time": 12068.95, "timestamp": "03:21:08", "text": "Vの組み合わせを押すだけで"}, {"type": "subtitle", "time": 12070.63, "timestamp": "03:21:10", "text": "完了です。"}, {"type": "subtitle", "time": 12072.229, "timestamp": "03:21:12", "text": "はい。"}, {"type": "subtitle", "time": 12074.79, "timestamp": "03:21:14", "text": "それはとても素晴らしいですね。"}, {"type": "subtitle", "time": 12077.11, "timestamp": "03:21:17", "text": "そうです。"}, {"type": "subtitle", "time": 12081.429, "timestamp": "03:21:21", "text": "不安定な分子がたくさんある。 うん。"}, {"type": "subtitle", "time": 12084.229, "timestamp": "03:21:24", "text": "うん。 それは、"}, {"type": "subtitle", "time": 12086.55, "timestamp": "03:21:26", "text": "あなたが既に持っている肌の別の肌を手に入れるようなものです"}, {"type": "subtitle", "time": 12088.309, "timestamp": "03:21:28", "text": "。"}, {"type": "subtitle", "time": 12090.55, "timestamp": "03:21:30", "text": "ああ、"}, {"type": "subtitle", "time": 12092.15, "timestamp": "03:21:32", "text": "そうだね。"}, {"type": "subtitle", "time": 12093.59, "timestamp": "03:21:33", "text": "それは特定のキャラクターにのみ適用され、"}, {"type": "subtitle", "time": 12096.229, "timestamp": "03:21:36", "text": "すべてのキャラクターに適用されるわけではありません。"}, {"type": "subtitle", "time": 12099.99, "timestamp": "03:21:39", "text": "ああ、クロノトークンって何ですか？"}, {"type": "subtitle", "time": 12104.07, "timestamp": "03:21:44", "text": "クロノトークン？ コロナトークンのことですか？"}, {"type": "subtitle", "time": 12105.51, "timestamp": "03:21:45", "text": "そう、紫色のトークンのことだ。"}, {"type": "subtitle", "time": 12107.269, "timestamp": "03:21:47", "text": "ええと、それはあなたの"}, {"type": "subtitle", "time": 12109.03, "timestamp": "03:21:49", "text": "バトルパス用です。 これは"}, {"type": "subtitle", "time": 12111.429, "timestamp": "03:21:51", "text": "バトルパスのポイントです。   そうすれば、"}, {"type": "subtitle", "time": 12113.67, "timestamp": "03:21:53", "text": "バトルパスのアイテムを無料で購入できます"}, {"type": "subtitle", "time": 12115.429, "timestamp": "03:21:55", "text": "。"}]
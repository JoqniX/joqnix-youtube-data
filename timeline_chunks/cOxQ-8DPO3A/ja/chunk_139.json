[{"type": "subtitle", "time": 8345.349, "timestamp": "02:19:05", "text": "可能であれば、頭部を狙うようにしてください。 ちなみに、"}, {"type": "subtitle", "time": 8346.95, "timestamp": "02:19:06", "text": "ヘッドショットだけを"}, {"type": "subtitle", "time": 8348.79, "timestamp": "02:19:08", "text": "自動的に狙えるカートもありますよ。 ですから、"}, {"type": "subtitle", "time": 8350.95, "timestamp": "02:19:10", "text": "その点にご注意ください。"}, {"type": "subtitle", "time": 8368.23, "timestamp": "02:19:28", "text": "これは後で取ります。"}, {"type": "subtitle", "time": 8369.589, "timestamp": "02:19:29", "text": "ゾンビは"}, {"type": "subtitle", "time": 8372.87, "timestamp": "02:19:32", "text": "君が立っているドアから出てくるぞ。 ええ、ここです。"}, {"type": "subtitle", "time": 8385.83, "timestamp": "02:19:45", "text": "えっと、赤い車だけを狙ってるんですか？"}, {"type": "subtitle", "time": 8387.509, "timestamp": "02:19:47", "text": "それとも青い車も？ ちなみに、"}, {"type": "subtitle", "time": 8388.389, "timestamp": "02:19:48", "text": "低い数値を出せば死ぬこともありますよ。   ええ"}, {"type": "subtitle", "time": 8392.309, "timestamp": "02:19:52", "text": "、青色とか色々やりましたよ。"}, {"type": "subtitle", "time": 8395.67, "timestamp": "02:19:55", "text": "いいえ、青は選ばないでください。 赤を選んでください。"}]
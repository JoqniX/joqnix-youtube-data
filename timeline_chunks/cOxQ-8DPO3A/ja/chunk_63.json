[{"type": "subtitle", "time": 3800.63, "timestamp": "01:03:20", "text": "ああ、あれはあれだった」って思うことができる。"}, {"type": "subtitle", "time": 3802.15, "timestamp": "01:03:22", "text": "なぜ？"}, {"type": "subtitle", "time": 3803.99, "timestamp": "01:03:23", "text": "そちらでは何を考えているのですか？ 一体"}, {"type": "subtitle", "time": 3805.51, "timestamp": "01:03:25", "text": "何を考えていたんだ？ 教えて。"}, {"type": "subtitle", "time": 3807.109, "timestamp": "01:03:27", "text": "それを紙に書き出して教えてください。 何を"}, {"type": "subtitle", "time": 3807.67, "timestamp": "01:03:27", "text": "考えていたんだ？"}, {"type": "subtitle", "time": 3809.43, "timestamp": "01:03:29", "text": "「あ、あそこに男がいる。"}, {"type": "subtitle", "time": 3812.47, "timestamp": "01:03:32", "text": "二人いた。行ってみよう」と思ったんです。"}, {"type": "subtitle", "time": 3814.23, "timestamp": "01:03:34", "text": "あそこに二人いた。 どの二"}, {"type": "subtitle", "time": 3816.309, "timestamp": "01:03:36", "text": "人ですか？"}, {"type": "subtitle", "time": 3818.15, "timestamp": "01:03:38", "text": "うーん、わからない。   一体"}, {"type": "subtitle", "time": 3820.309, "timestamp": "01:03:40", "text": "何笑ってるんだ？ 何で"}, {"type": "subtitle", "time": 3822.309, "timestamp": "01:03:42", "text": "クスクス笑ってるの？"}, {"type": "subtitle", "time": 3825.91, "timestamp": "01:03:45", "text": "彼らの悪魔と、その他何か"}, {"type": "subtitle", "time": 3826.789, "timestamp": "01:03:46", "text": "。"}, {"type": "subtitle", "time": 3828.789, "timestamp": "01:03:48", "text": "うん。 そして、私があなたに何と言ったか覚えていますか？"}, {"type": "subtitle", "time": 3832.23, "timestamp": "01:03:52", "text": "愛しい悪魔は何をするのですか？"}, {"type": "subtitle", "time": 3835.43, "timestamp": "01:03:55", "text": "えっと、私をダイビングして。   だから"}, {"type": "subtitle", "time": 3836.87, "timestamp": "01:03:56", "text": "、"}, {"type": "subtitle", "time": 3839.349, "timestamp": "01:03:59", "text": "私は冗談が大嫌いなんです。 何てことだ"}]
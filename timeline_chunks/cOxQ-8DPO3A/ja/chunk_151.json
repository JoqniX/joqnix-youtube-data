[{"type": "subtitle", "time": 9060.79, "timestamp": "02:31:00", "text": "悪夢モードに入ると、"}, {"type": "subtitle", "time": 9070.389, "timestamp": "02:31:10", "text": "スカーレットメイジ。"}, {"type": "subtitle", "time": 9078.07, "timestamp": "02:31:18", "text": "頭を狙ってください。"}, {"type": "subtitle", "time": 9089.83, "timestamp": "02:31:29", "text": "。 だから、彼女はすごく調子が悪い時に全力を尽くすつもりなんだ"}, {"type": "subtitle", "time": 9093.349, "timestamp": "02:31:33", "text": "。"}, {"type": "subtitle", "time": 9108.23, "timestamp": "02:31:48", "text": "あなたを永遠に気絶させてしまうから、殺しなさい。"}, {"type": "subtitle", "time": 9110.07, "timestamp": "02:31:50", "text": "うん。 頭の顎を狙え。"}, {"type": "subtitle", "time": 9117.51, "timestamp": "02:31:57", "text": "ちなみに、あなたの銃はあなたのものよりもダメージが大きい。"}]
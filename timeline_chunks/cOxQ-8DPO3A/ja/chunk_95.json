[{"type": "subtitle", "time": 5702.07, "timestamp": "01:35:02", "text": "。 角のすぐそばで、しかも"}, {"type": "subtitle", "time": 5705.35, "timestamp": "01:35:05", "text": "彼らの目の前にはいない。 彼らが"}, {"type": "subtitle", "time": 5710.149, "timestamp": "01:35:10", "text": "死ぬためだけに。 しかし、死者は出なかった。 え"}, {"type": "subtitle", "time": 5734.87, "timestamp": "01:35:34", "text": "私はこれが嫌いだ。"}, {"type": "subtitle", "time": 5736.629, "timestamp": "01:35:36", "text": "何が嫌いなの？   私は何もかも"}]
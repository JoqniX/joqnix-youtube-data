[{"type": "subtitle", "time": 2221.91, "timestamp": "00:37:01", "text": "誰がそれを反映できるだろうか？"}, {"type": "subtitle", "time": 2224.47, "timestamp": "00:37:04", "text": "でも、私にはなかった"}, {"type": "subtitle", "time": 2226.47, "timestamp": "00:37:06", "text": "けど、彼は振り返ることができる。"}, {"type": "subtitle", "time": 2230.39, "timestamp": "00:37:10", "text": "3つ目は、ジョーが死んだということです。"}, {"type": "subtitle", "time": 2231.91, "timestamp": "00:37:11", "text": "おお。"}, {"type": "subtitle", "time": 2235.99, "timestamp": "00:37:15", "text": "これらは、"}, {"type": "subtitle", "time": 2237.67, "timestamp": "00:37:17", "text": "あなたの老いによって死ぬことのないキャラクターたちです。 ああ、どのバッキーを"}, {"type": "subtitle", "time": 2239.75, "timestamp": "00:37:19", "text": "送ればいいか忘れちゃった。"}, {"type": "subtitle", "time": 2241.03, "timestamp": "00:37:21", "text": "遅いです。"}, {"type": "subtitle", "time": 2243.109, "timestamp": "00:37:23", "text": "文字通り、全員に当てはまる話だよ。   まだ終わって"}, {"type": "subtitle", "time": 2243.829, "timestamp": "00:37:23", "text": "ない。"}, {"type": "subtitle", "time": 2245.99, "timestamp": "00:37:25", "text": "ああ、それは演じやすいキャラクターだからだよ"}, {"type": "subtitle", "time": 2248.23, "timestamp": "00:37:28", "text": "。 だから、彼らはたくさんのKを投入し、"}, {"type": "subtitle", "time": 2252.63, "timestamp": "00:37:32", "text": "ネイマールはあなたたち全員を生き残ることができる。"}, {"type": "subtitle", "time": 2255.91, "timestamp": "00:37:35", "text": "まあ、そういうことだ。"}, {"type": "subtitle", "time": 2265.51, "timestamp": "00:37:45", "text": "うん。 だから私は信じます、ああ、いいえ。 彼女はまるで"}, {"type": "subtitle", "time": 2271.91, "timestamp": "00:37:51", "text": "一列に並ばせるように、ただただ驚かせる。"}, {"type": "subtitle", "time": 2273.67, "timestamp": "00:37:53", "text": "そして、人々があなたのすべてを通してあなたを殺すことができる方法について話しましょう。つまり、"}]
[{"type": "subtitle", "time": 7205.91, "timestamp": "02:00:05", "text": "かなり楽しいよ。 ゾンビモード。"}, {"type": "subtitle", "time": 7208.39, "timestamp": "02:00:08", "text": "経歴はありますか？"}, {"type": "subtitle", "time": 7211.669, "timestamp": "02:00:11", "text": "何？ 悪い。"}, {"type": "subtitle", "time": 7213.99, "timestamp": "02:00:13", "text": "背景。 あの"}, {"type": "subtitle", "time": 7219.35, "timestamp": "02:00:19", "text": "音楽？"}, {"type": "subtitle", "time": 7226.39, "timestamp": "02:00:26", "text": "私の方からは、そのような音楽は提供していません。 何か"}, {"type": "subtitle", "time": 7227.109, "timestamp": "02:00:27", "text": "背景音が聞こえますか？"}, {"type": "subtitle", "time": 7229.109, "timestamp": "02:00:29", "text": "いいえ。いいえ。いいえ。わかりました。では、"}, {"type": "subtitle", "time": 7244.629, "timestamp": "02:00:44", "text": "あ、実はマンティスをプレイします。"}, {"type": "subtitle", "time": 7246.629, "timestamp": "02:00:46", "text": "しかし、必ず"}, {"type": "subtitle", "time": 7249.43, "timestamp": "02:00:49", "text": "勝利するだろう。 私たちは"}, {"type": "subtitle", "time": 7258.709, "timestamp": "02:00:58", "text": "と取引した方が得策でしょう。"}]
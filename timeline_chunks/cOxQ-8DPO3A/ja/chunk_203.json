[{"type": "subtitle", "time": 12180.95, "timestamp": "03:23:00", "text": "4、5日ほどでバトルパスの最終部分に到達できるということですね。これは素晴らしいことです。"}, {"type": "subtitle", "time": 12182.71, "timestamp": "03:23:02", "text": "おお。"}, {"type": "subtitle", "time": 12187.429, "timestamp": "03:23:07", "text": "ああ、オレンジジュースにはスタミナがあるんだ。"}, {"type": "subtitle", "time": 12188.79, "timestamp": "03:23:08", "text": "あなたは何について話しているのですか？"}, {"type": "subtitle", "time": 12190.79, "timestamp": "03:23:10", "text": "オレンジ色の"}, {"type": "subtitle", "time": 12193.59, "timestamp": "03:23:13", "text": "ランダムピックアップバンドル。 彼は"}, {"type": "subtitle", "time": 12196.469, "timestamp": "03:23:16", "text": "オレンジジュースみたいだ。   それは"}, {"type": "subtitle", "time": 12198.309, "timestamp": "03:23:18", "text": "飲まない方がいいよ。 それは"}, {"type": "subtitle", "time": 12199.51, "timestamp": "03:23:19", "text": "飲まない方がいいよ。"}, {"type": "subtitle", "time": 12202.07, "timestamp": "03:23:22", "text": "無料のコスチュームスキンみたいなのをくれるんだよ。"}, {"type": "subtitle", "time": 12210.71, "timestamp": "03:23:30", "text": "ええ、確か2つ持ってます。今は"}, {"type": "subtitle", "time": 12216.95, "timestamp": "03:23:36", "text": "無料で配布していないので。 おお。"}, {"type": "subtitle", "time": 12219.51, "timestamp": "03:23:39", "text": "うん。"}, {"type": "subtitle", "time": 12221.91, "timestamp": "03:23:41", "text": "このカボチャみたいなものは何ですか？ ああ、これらは"}, {"type": "subtitle", "time": 12224.07, "timestamp": "03:23:44", "text": "イベントですね。 それは正しい。"}, {"type": "subtitle", "time": 12226.95, "timestamp": "03:23:46", "text": "はい、これは"}, {"type": "subtitle", "time": 12229.67, "timestamp": "03:23:49", "text": "こちらの別のアカウントで入手できるものです。"}, {"type": "subtitle", "time": 12232.63, "timestamp": "03:23:52", "text": "2つのアカウント。 何てことだ。"}, {"type": "subtitle", "time": 12235.51, "timestamp": "03:23:55", "text": "おい。 おい。 このアカウントは君たちみたいな人たちのためのものだよ"}, {"type": "subtitle", "time": 12237.03, "timestamp": "03:23:57", "text": "、いいかい？"}, {"type": "subtitle", "time": 12239.429, "timestamp": "03:23:59", "text": "ゲームに戻ってランク戦をプレイしたいとき。 だから"}]
[{"type": "subtitle", "time": 4080.39, "timestamp": "01:08:00", "text": "真ん中あたりにスタン攻撃ができるプレイヤーがいますね。 なぜまた同じことを繰り返すのですか"}, {"type": "subtitle", "time": 4082.15, "timestamp": "01:08:02", "text": "？ わかった。 ジェフを見たら消え去れ"}, {"type": "subtitle", "time": 4084.309, "timestamp": "01:08:04", "text": "。"}, {"type": "subtitle", "time": 4088.39, "timestamp": "01:08:08", "text": "ああ、この人か。"}, {"type": "subtitle", "time": 4099.43, "timestamp": "01:08:19", "text": "何が起こっているんだ？ 何てことだ。"}, {"type": "subtitle", "time": 4101.349, "timestamp": "01:08:21", "text": "あなたはこれをすべてできますか?"}, {"type": "subtitle", "time": 4104.709, "timestamp": "01:08:24", "text": "待って、待って、待って、待って。"}, {"type": "subtitle", "time": 4106.55, "timestamp": "01:08:26", "text": "どこにいるの？   一体"}, {"type": "subtitle", "time": 4107.829, "timestamp": "01:08:27", "text": "どういうことだ？"}, {"type": "subtitle", "time": 4113.669, "timestamp": "01:08:33", "text": "でももう少し頭を使ってください。"}, {"type": "subtitle", "time": 4117.03, "timestamp": "01:08:37", "text": "ああ、"}, {"type": "subtitle", "time": 4119.269, "timestamp": "01:08:39", "text": "ママ。 アレッド。 あいつらは"}, {"type": "subtitle", "time": 4121.03, "timestamp": "01:08:41", "text": "壁の後ろに隠れて、お前の"}, {"type": "subtitle", "time": 4122.47, "timestamp": "01:08:42", "text": "サブキャラの攻撃を受けずに済むって知ってるだろ。 あなたはそれを知っていますよね？ それとも、あなたは"}, {"type": "subtitle", "time": 4123.269, "timestamp": "01:08:43", "text": "それを知らないのですか？   それは"}, {"type": "subtitle", "time": 4126.07, "timestamp": "01:08:46", "text": "知りませんでした。"}, {"type": "subtitle", "time": 4128.149, "timestamp": "01:08:48", "text": "何？"}, {"type": "subtitle", "time": 4130.709, "timestamp": "01:08:50", "text": "このゲームをプレイしたことがありますか？ マジかよ、"}, {"type": "subtitle", "time": 4131.349, "timestamp": "01:08:51", "text": "おい。"}, {"type": "subtitle", "time": 4137.669, "timestamp": "01:08:57", "text": "待って。 今、私は何が分かったのか"}]
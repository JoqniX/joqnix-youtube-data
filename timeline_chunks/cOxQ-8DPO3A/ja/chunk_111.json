[{"type": "subtitle", "time": 6670.47, "timestamp": "01:51:10", "text": "うん。 ほら、言った通りでしょ。   何てことだ"}, {"type": "subtitle", "time": 6678.229, "timestamp": "01:51:18", "text": "私は自分の目で見たものを見ている"}, {"type": "subtitle", "time": 6685.35, "timestamp": "01:51:25", "text": "キャプテンに就任。   戻ってくる"}, {"type": "subtitle", "time": 6686.629, "timestamp": "01:51:26", "text": "。 戻ってくる。 戻ってくる。 戻ってくる"}, {"type": "subtitle", "time": 6691.51, "timestamp": "01:51:31", "text": "さあ、攻撃しろ。 いいえ。はい。 はい。 はい。"}, {"type": "subtitle", "time": 6697.83, "timestamp": "01:51:37", "text": "ニース。   わかった"}, {"type": "subtitle", "time": 6699.43, "timestamp": "01:51:39", "text": "。 今は彼らを追い詰めてはいけない。 やめてください。"}, {"type": "subtitle", "time": 6708.95, "timestamp": "01:51:48", "text": "なぜそこへ行くのですか？ ちなみに、そこから先は道がない"}, {"type": "subtitle", "time": 6711.27, "timestamp": "01:51:51", "text": "。 しかも、"}, {"type": "subtitle", "time": 6719.35, "timestamp": "01:51:59", "text": "H船長が再び登場。"}]
[{"type": "subtitle", "time": 4141.03, "timestamp": "01:09:01", "text": "？ 今度はどういう意味ですか？ 私はそうは思わない"}, {"type": "subtitle", "time": 4144.149, "timestamp": "01:09:04", "text": "。"}, {"type": "subtitle", "time": 4161.43, "timestamp": "01:09:21", "text": "あなたはただ、"}, {"type": "subtitle", "time": 4163.03, "timestamp": "01:09:23", "text": "殺したいキャラクターを選んでいるわけではない。   まるで"}, {"type": "subtitle", "time": 4167.03, "timestamp": "01:09:27", "text": "5人の男に正面から突っ込んでいくようなものだ。"}, {"type": "subtitle", "time": 4170.789, "timestamp": "01:09:30", "text": "うん。 私が誰かを殺そうとしたときに、"}, {"type": "subtitle", "time": 4173.669, "timestamp": "01:09:33", "text": "他の人が現れて、"}, {"type": "subtitle", "time": 4176.229, "timestamp": "01:09:36", "text": "その後消えていく。"}, {"type": "subtitle", "time": 4184.55, "timestamp": "01:09:44", "text": "単純な答えだった。 知らなかったの"}, {"type": "subtitle", "time": 4186.709, "timestamp": "01:09:46", "text": "？   一体"}, {"type": "subtitle", "time": 4192.309, "timestamp": "01:09:52", "text": "。"}, {"type": "subtitle", "time": 4193.99, "timestamp": "01:09:53", "text": "あなたは答えを知っていたのに、それでもやらなかったのですか"}, {"type": "subtitle", "time": 4196.87, "timestamp": "01:09:56", "text": "？"}, {"type": "subtitle", "time": 4197.11, "timestamp": "01:09:57", "text": "あなたが"}, {"type": "subtitle", "time": 4199.91, "timestamp": "01:09:59", "text": "正しい。   何だって"}]
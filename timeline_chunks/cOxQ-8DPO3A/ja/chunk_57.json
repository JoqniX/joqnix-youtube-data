[{"type": "subtitle", "time": 3420.47, "timestamp": "00:57:00", "text": "真ん中にパニッシャーがいて、私は彼に殺された"}, {"type": "subtitle", "time": 3436.23, "timestamp": "00:57:16", "text": "よし、入るぞ。"}, {"type": "subtitle", "time": 3440.549, "timestamp": "00:57:20", "text": "うん、あれはすごい仕事をしている。"}, {"type": "subtitle", "time": 3443.75, "timestamp": "00:57:23", "text": "あなたはC言語を使っていないでしょう？"}, {"type": "subtitle", "time": 3450.789, "timestamp": "00:57:30", "text": "ああ、気にしないで。 わかりました、では、"}, {"type": "subtitle", "time": 3454.309, "timestamp": "00:57:34", "text": "これがどういうことか説明しましょう。"}, {"type": "subtitle", "time": 3457.829, "timestamp": "00:57:37", "text": "Cを使って戦車を焼き尽くせ。 わかった。"}, {"type": "subtitle", "time": 3460.63, "timestamp": "00:57:40", "text": "戦車に大きなダメージを与える。   その通りです"}, {"type": "subtitle", "time": 3461.51, "timestamp": "00:57:41", "text": "。"}, {"type": "subtitle", "time": 3462.549, "timestamp": "00:57:42", "text": "うん。"}, {"type": "subtitle", "time": 3464.71, "timestamp": "00:57:44", "text": "それを使ってマグニートーに。"}, {"type": "subtitle", "time": 3467.27, "timestamp": "00:57:47", "text": "戦車キャラクターを止めるのは何だか知ってる？   えっと、"}, {"type": "subtitle", "time": 3471.43, "timestamp": "00:57:51", "text": "ハルク。 えーと、他に誰がいるの？"}, {"type": "subtitle", "time": 3473.109, "timestamp": "00:57:53", "text": "いや、ただ分かるんだよ。 はいか"}, {"type": "subtitle", "time": 3474.47, "timestamp": "00:57:54", "text": "いいえで答えてください。"}, {"type": "subtitle", "time": 3476.39, "timestamp": "00:57:56", "text": "そう、バフィーみたいな人たちね。"}, {"type": "subtitle", "time": 3477.99, "timestamp": "00:57:57", "text": "バフィーのことだよね？"}]
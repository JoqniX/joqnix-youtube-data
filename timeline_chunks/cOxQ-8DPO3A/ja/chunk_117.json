[{"type": "subtitle", "time": 7049.83, "timestamp": "01:57:29", "text": "ああ、船長が私に襲いかかってくる。"}, {"type": "subtitle", "time": 7051.75, "timestamp": "01:57:31", "text": "あなたは彼をイライラさせる。 もちろん、彼はあそこにいますよ"}, {"type": "subtitle", "time": 7052.629, "timestamp": "01:57:32", "text": "。"}, {"type": "subtitle", "time": 7053.669, "timestamp": "01:57:33", "text": "私です。 私です。"}, {"type": "subtitle", "time": 7057.35, "timestamp": "01:57:37", "text": "反対側へフ​​ェードアウトする。 他の他の人たちも"}, {"type": "subtitle", "time": 7064.229, "timestamp": "01:57:44", "text": "あなたはそこにいる。 来て。 死ぬ。 わかった。"}]
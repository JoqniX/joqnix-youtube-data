[{"type": "subtitle", "time": 5641.11, "timestamp": "01:34:01", "text": "ああ、彼は見えない。"}, {"type": "subtitle", "time": 5643.189, "timestamp": "01:34:03", "text": "どうしていつも死んでいるの？   目に"}, {"type": "subtitle", "time": 5646.79, "timestamp": "01:34:06", "text": "見えないものがあった。"}, {"type": "subtitle", "time": 5648.95, "timestamp": "01:34:08", "text": "彼は、そんなことはできない。"}, {"type": "subtitle", "time": 5651.43, "timestamp": "01:34:11", "text": "何？ では、私を殺したのは誰だったのか？"}, {"type": "subtitle", "time": 5654.47, "timestamp": "01:34:14", "text": "いいえ、彼はあなたを盲目にするのです。"}, {"type": "subtitle", "time": 5657.51, "timestamp": "01:34:17", "text": "ああ、そうだね。 彼は背後から盲目状態で現れた。"}, {"type": "subtitle", "time": 5659.35, "timestamp": "01:34:19", "text": "「あ、後ろから足音がする」って思ったよ。"}, {"type": "subtitle", "time": 5663.35, "timestamp": "01:34:23", "text": "それで、私は向き合った。 彼は私が"}, {"type": "subtitle", "time": 5691.51, "timestamp": "01:34:51", "text": "どこにいるんだ？ なぜ？ いや、そこには行かないで"}, {"type": "subtitle", "time": 5698.55, "timestamp": "01:34:58", "text": "。 よし、今だ。 よし、今だ"}]
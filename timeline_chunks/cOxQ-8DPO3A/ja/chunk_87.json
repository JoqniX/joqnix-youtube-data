[{"type": "subtitle", "time": 5223.35, "timestamp": "01:27:03", "text": "ああ、"}, {"type": "subtitle", "time": 5224.87, "timestamp": "01:27:04", "text": "1ラウンドは勝ったよ。"}, {"type": "subtitle", "time": 5225.35, "timestamp": "01:27:05", "text": "ええ、"}, {"type": "subtitle", "time": 5228.47, "timestamp": "01:27:08", "text": "彼はスパイダーマンを演じているわけではありません。 だから、君には"}, {"type": "subtitle", "time": 5233.99, "timestamp": "01:27:13", "text": "魔法があるから、"}, {"type": "subtitle", "time": 5236.47, "timestamp": "01:27:16", "text": "彼女が君を殺そうとするたびに上に上がってみなさい。"}, {"type": "subtitle", "time": 5239.51, "timestamp": "01:27:19", "text": "わかった。   ちなみに、"}, {"type": "subtitle", "time": 5241.51, "timestamp": "01:27:21", "text": "地図の見方も覚えておいた方がいいですよ"}, {"type": "subtitle", "time": 5242.97, "timestamp": "01:27:22", "text": "。"}, {"type": "subtitle", "time": 5245.35, "timestamp": "01:27:25", "text": "[音楽]"}, {"type": "subtitle", "time": 5257.99, "timestamp": "01:27:37", "text": "。 あなたの魔法が"}, {"type": "subtitle", "time": 5260.79, "timestamp": "01:27:40", "text": "私たち全員を救う鍵になるかもしれないと聞きました。 若い女性、"}]
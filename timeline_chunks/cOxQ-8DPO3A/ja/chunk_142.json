[{"type": "subtitle", "time": 8523.349, "timestamp": "02:22:03", "text": "ああ、ついに砲塔に座ったんですね。 ああ、助かった"}, {"type": "subtitle", "time": 8524.55, "timestamp": "02:22:04", "text": "。   そんなことができるなんて"}, {"type": "subtitle", "time": 8526.23, "timestamp": "02:22:06", "text": "知らなかったけど、"}, {"type": "subtitle", "time": 8528.15, "timestamp": "02:22:08", "text": "うん、できるよ"}, {"type": "subtitle", "time": 8529.99, "timestamp": "02:22:09", "text": "。 それはキャラクターです。"}, {"type": "subtitle", "time": 8532.55, "timestamp": "02:22:12", "text": "パニッシャーをプレイしたことがないのですか？"}, {"type": "subtitle", "time": 8536.469, "timestamp": "02:22:16", "text": "いいえ。 そうそう。 ああ、覚えているよ。 はい。"}, {"type": "subtitle", "time": 8550.23, "timestamp": "02:22:30", "text": "【音楽】"}, {"type": "subtitle", "time": 8557.91, "timestamp": "02:22:37", "text": "これはボス戦です。"}, {"type": "subtitle", "time": 8567.75, "timestamp": "02:22:47", "text": "赤だけを選んでください。 赤色だけを選んでください。"}, {"type": "subtitle", "time": 8570.469, "timestamp": "02:22:50", "text": "ゼウスの雷鳴。"}, {"type": "subtitle", "time": 8572.79, "timestamp": "02:22:52", "text": "ああ、もう。"}, {"type": "subtitle", "time": 8575.51, "timestamp": "02:22:55", "text": "なぜそんなに"}, {"type": "subtitle", "time": 8578.23, "timestamp": "02:22:58", "text": "時間がかかるのですか？赤だけを選ぶのに？"}]
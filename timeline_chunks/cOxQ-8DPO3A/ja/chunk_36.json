[{"type": "subtitle", "time": 2168.87, "timestamp": "00:36:08", "text": "魔法のようにあなたのすぐ近くにいても、間接的にダメージを反射したり、ダメージを受けなかったりできるキャラクターについて教えてあげましょう。"}, {"type": "subtitle", "time": 2170.31, "timestamp": "00:36:10", "text": "しかし、彼らは本当にタイミングが良かった"}, {"type": "subtitle", "time": 2171.03, "timestamp": "00:36:11", "text": "。"}, {"type": "subtitle", "time": 2172.55, "timestamp": "00:36:12", "text": "あなたの信仰もそれと同じようなものです。"}, {"type": "subtitle", "time": 2178.47, "timestamp": "00:36:18", "text": "そして私はスター・ロードを信じる。"}, {"type": "subtitle", "time": 2179.27, "timestamp": "00:36:19", "text": "これで３つ目だ。"}, {"type": "subtitle", "time": 2180.47, "timestamp": "00:36:20", "text": "そんな感じ。 おお。"}, {"type": "subtitle", "time": 2181.76, "timestamp": "00:36:21", "text": "おお。 オンになってるよね？"}, {"type": "subtitle", "time": 2182.64, "timestamp": "00:36:22", "text": "オンになってるよね？ 次は誰だ？"}, {"type": "subtitle", "time": 2183.839, "timestamp": "00:36:23", "text": "次は誰だ？ ええ、"}, {"type": "subtitle", "time": 2191.03, "timestamp": "00:36:31", "text": "チャロドンのフリップには無敵フレームのようなものがあります"}, {"type": "subtitle", "time": 2195.109, "timestamp": "00:36:35", "text": "。"}, {"type": "subtitle", "time": 2199.67, "timestamp": "00:36:39", "text": "ダッシュ時に無限フレームを持つマジックと同じです。"}, {"type": "subtitle", "time": 2200.79, "timestamp": "00:36:40", "text": "無限フレーム"}, {"type": "subtitle", "time": 2202.79, "timestamp": "00:36:42", "text": "で"}, {"type": "subtitle", "time": 2205.91, "timestamp": "00:36:45", "text": "無敵状態。 つまり、"}, {"type": "subtitle", "time": 2212.55, "timestamp": "00:36:52", "text": "。混沌を受け入れろ。   私はそれが"}, {"type": "subtitle", "time": 2213.51, "timestamp": "00:36:53", "text": "好きです。"}, {"type": "subtitle", "time": 2215.75, "timestamp": "00:36:55", "text": "KO。"}, {"type": "subtitle", "time": 2219.03, "timestamp": "00:36:59", "text": "2番目は刃物です。"}]
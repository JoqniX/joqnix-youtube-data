[{"type": "subtitle", "time": 7981.669, "timestamp": "02:13:01", "text": "よし、戻ってきたよ。 おかえり。   おかえり"}, {"type": "subtitle", "time": 7984.87, "timestamp": "02:13:04", "text": "。   それではまず"}, {"type": "subtitle", "time": 7988.87, "timestamp": "02:13:08", "text": "、準備ボタンを押してください。"}, {"type": "subtitle", "time": 7993.03, "timestamp": "02:13:13", "text": "左側に「準備」と書いてあるのが見えますか？"}, {"type": "subtitle", "time": 7995.35, "timestamp": "02:13:15", "text": "準備してください。"}, {"type": "subtitle", "time": 8001.35, "timestamp": "02:13:21", "text": "[音楽]"}, {"type": "subtitle", "time": 8002.87, "timestamp": "02:13:22", "text": "それらはあなたが演じることができる特定のキャラクターです"}, {"type": "subtitle", "time": 8004.149, "timestamp": "02:13:24", "text": "。"}, {"type": "subtitle", "time": 8005.669, "timestamp": "02:13:25", "text": "ああ、"}, {"type": "subtitle", "time": 8006.95, "timestamp": "02:13:26", "text": "これらはこのゲームモードでプレイできるキャラクターです"}, {"type": "subtitle", "time": 8009.43, "timestamp": "02:13:29", "text": "。 行く。"}, {"type": "subtitle", "time": 8010.229, "timestamp": "02:13:30", "text": "はぁ？   どちらを"}, {"type": "subtitle", "time": 8011.99, "timestamp": "02:13:31", "text": "選びますか？"}, {"type": "subtitle", "time": 8015.669, "timestamp": "02:13:35", "text": "私はパニッシャーを選びます。   わかった"}, {"type": "subtitle", "time": 8019.99, "timestamp": "02:13:39", "text": "。 わかった。 わかった。   わかった"}, {"type": "subtitle", "time": 8022.87, "timestamp": "02:13:42", "text": "。 このモードはちょっとめちゃくちゃだ。   わかった"}, {"type": "subtitle", "time": 8027.589, "timestamp": "02:13:47", "text": "。 右。 クレイジーというのは、"}, {"type": "subtitle", "time": 8030.069, "timestamp": "02:13:50", "text": "能力が"}, {"type": "subtitle", "time": 8032.79, "timestamp": "02:13:52", "text": "まったく新しいレベルにアップグレードされるという意味です。"}, {"type": "subtitle", "time": 8035.03, "timestamp": "02:13:55", "text": "それが"}, {"type": "subtitle", "time": 8037.03, "timestamp": "02:13:57", "text": "オーです。"}]
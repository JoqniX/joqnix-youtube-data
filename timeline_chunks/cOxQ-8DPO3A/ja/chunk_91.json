[{"type": "subtitle", "time": 5473.43, "timestamp": "01:31:13", "text": "彼女を撃て。 彼女を撃て。 彼女を撃て。"}, {"type": "subtitle", "time": 5478.87, "timestamp": "01:31:18", "text": "彼女を撃てますか？"}, {"type": "subtitle", "time": 5480.87, "timestamp": "01:31:20", "text": "どこ？"}, {"type": "subtitle", "time": 5483.91, "timestamp": "01:31:23", "text": "上。 ああ、道に迷ってきた"}, {"type": "subtitle", "time": 5486.709, "timestamp": "01:31:26", "text": "。"}, {"type": "subtitle", "time": 5489.59, "timestamp": "01:31:29", "text": "どうやって？ とても小さな地図だ。"}, {"type": "subtitle", "time": 5492.95, "timestamp": "01:31:32", "text": "いろいろなことが起こっている。"}, {"type": "subtitle", "time": 5495.11, "timestamp": "01:31:35", "text": "それなら、なぜ彼女のシューティングゲームをプレイするのですか？   何だって"}, {"type": "subtitle", "time": 5497.11, "timestamp": "01:31:37", "text": "？ もちろん、いろいろな"}, {"type": "subtitle", "time": 5498.229, "timestamp": "01:31:38", "text": "ことが起こるでしょう。 君は"}, {"type": "subtitle", "time": 5500.07, "timestamp": "01:31:40", "text": "オーバーウォッチをプレイしていた人じゃないか？"}, {"type": "subtitle", "time": 5503.83, "timestamp": "01:31:43", "text": "それはずいぶん昔のことだ。"}, {"type": "subtitle", "time": 5506.149, "timestamp": "01:31:46", "text": "そこへは行かないでください。 一人で行ってはいけません。"}, {"type": "subtitle", "time": 5507.27, "timestamp": "01:31:47", "text": "冗談ですか？"}, {"type": "subtitle", "time": 5510.39, "timestamp": "01:31:50", "text": "彼女はたくさん持っている。"}, {"type": "subtitle", "time": 5512.229, "timestamp": "01:31:52", "text": "ああ、彼女は落ち込んでいる。 何？ これは"}, {"type": "subtitle", "time": 5517.91, "timestamp": "01:31:57", "text": "彼女は落ち込んでいる。 だから何？ ヒーラーなら"}]
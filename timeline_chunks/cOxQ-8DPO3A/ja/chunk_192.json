[{"type": "subtitle", "time": 11521.67, "timestamp": "03:12:01", "text": "死エネルギーの追跡。 真実は"}, {"type": "subtitle", "time": 11524.15, "timestamp": "03:12:04", "text": "劇場の奥深くに隠されている。 俺たちは"}, {"type": "subtitle", "time": 11526.15, "timestamp": "03:12:06", "text": "もっとダメージを与えなきゃいけない。"}, {"type": "subtitle", "time": 11540.87, "timestamp": "03:12:20", "text": "[音楽] それは理解できませんでした"}, {"type": "subtitle", "time": 11543.99, "timestamp": "03:12:23", "text": "。"}, {"type": "subtitle", "time": 11547.59, "timestamp": "03:12:27", "text": "プライム・モータルフロストは強いですか？"}, {"type": "subtitle", "time": 11549.11, "timestamp": "03:12:29", "text": "赤い方ですか？"}, {"type": "subtitle", "time": 11553.269, "timestamp": "03:12:33", "text": "えっと、"}, {"type": "subtitle", "time": 11556.95, "timestamp": "03:12:36", "text": "紫色のやつです。 待って、Bは何をするのか？"}, {"type": "subtitle", "time": 11558.95, "timestamp": "03:12:38", "text": "ええ、紫色の"}, {"type": "subtitle", "time": 11561.349, "timestamp": "03:12:41", "text": "ダメージを与えると、30%の確率で"}, {"type": "subtitle", "time": 11568.95, "timestamp": "03:12:48", "text": "良いことなのかどうか、私にはわかりません。"}, {"type": "subtitle", "time": 11576.309, "timestamp": "03:12:56", "text": "ああ、ちなみにこいつらはかなりの被害を出してるよ"}]
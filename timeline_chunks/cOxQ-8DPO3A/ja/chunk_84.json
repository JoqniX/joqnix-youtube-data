[{"type": "subtitle", "time": 5040.79, "timestamp": "01:24:00", "text": "それで、一体どこにいたんだ？"}, {"type": "subtitle", "time": 5043.35, "timestamp": "01:24:03", "text": "アメイジング・スパイダーマンに手を出したらどうなるか。"}, {"type": "subtitle", "time": 5049.189, "timestamp": "01:24:09", "text": "何してるの？ 私の声が聞こえますか？   道に迷ってしまった"}, {"type": "subtitle", "time": 5052.07, "timestamp": "01:24:12", "text": "。"}, {"type": "subtitle", "time": 5054.79, "timestamp": "01:24:14", "text": "どうやって？ これはとても小さな地図です。 これはただの"}, {"type": "subtitle", "time": 5056.47, "timestamp": "01:24:16", "text": "地図です。 それは、それは何も持っていない。どうやって"}, {"type": "subtitle", "time": 5059.35, "timestamp": "01:24:19", "text": "死んだのですか？"}, {"type": "subtitle", "time": 5087.51, "timestamp": "01:24:47", "text": "。  1つ手に入れました。"}, {"type": "subtitle", "time": 5089.43, "timestamp": "01:24:49", "text": "1つ。 本当に彼を捕まえたの？"}, {"type": "subtitle", "time": 5092.709, "timestamp": "01:24:52", "text": "うん。 二人とも。   空"}, {"type": "subtitle", "time": 5095.189, "timestamp": "01:24:55", "text": "飛ぶ女か"}]
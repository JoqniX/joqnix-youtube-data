[{"type": "subtitle", "time": 12667.11, "timestamp": "03:31:07", "text": "。今日は怖かったよ。だって、何かがうまくいってなかったんだ。えっと、"}, {"type": "subtitle", "time": 12672.15, "timestamp": "03:31:12", "text": "どれがどれ、えっと、何なんだ？ゲームが"}, {"type": "subtitle", "time": 12676.63, "timestamp": "03:31:16", "text": "途中でクラッシュして、それが私に話しかけてきたから、「一体何なんだ？」って思ったんだ。"}, {"type": "subtitle", "time": 12680.07, "timestamp": "03:31:20", "text": "ああ、"}, {"type": "subtitle", "time": 12687.99, "timestamp": "03:31:27", "text": "ゲームの途中でインスタグラムのストーリーを作るのを忘れて、「おい、"}, {"type": "subtitle", "time": 12694.95, "timestamp": "03:31:34", "text": "これをやりたいんだ」って思ったんだ。"}, {"type": "subtitle", "time": 12696.95, "timestamp": "03:31:36", "text": "それから、スマホが"}]
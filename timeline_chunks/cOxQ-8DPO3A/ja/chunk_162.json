[{"type": "subtitle", "time": 9731.349, "timestamp": "02:42:11", "text": "ああ、なぜ私は"}, {"type": "subtitle", "time": 9732.95, "timestamp": "02:42:12", "text": "死にかけているのだろう。 私は死にかけている。 私は死にかけている。 私は"}, {"type": "subtitle", "time": 9734.309, "timestamp": "02:42:14", "text": "死にかけている。"}, {"type": "subtitle", "time": 9736.63, "timestamp": "02:42:16", "text": "まあ、彼が望むなら死ぬこともできる。"}, {"type": "subtitle", "time": 9758.87, "timestamp": "02:42:38", "text": "復讐の拳。 戦い。"}, {"type": "subtitle", "time": 9773.67, "timestamp": "02:42:53", "text": "つまり、イカを殺すことは彼にダメージを与えているんだよ、"}, {"type": "subtitle", "time": 9775.67, "timestamp": "02:42:55", "text": "兄弟。"}, {"type": "subtitle", "time": 9777.27, "timestamp": "02:42:57", "text": "ええ、"}, {"type": "subtitle", "time": 9779.11, "timestamp": "02:42:59", "text": "彼を撃ってより大きなダメージを与えることもできますよ"}]
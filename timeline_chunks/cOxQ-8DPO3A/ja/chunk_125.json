[{"type": "subtitle", "time": 7501.589, "timestamp": "02:05:01", "text": "クソアイアンマンを手に入れろ。 その汚いものを"}, {"type": "subtitle", "time": 7511.51, "timestamp": "02:05:11", "text": "近日公開。 彼を殺すのを手伝いに来るんだ。"}, {"type": "subtitle", "time": 7513.51, "timestamp": "02:05:13", "text": "捕まえたぞ。 捕まえたぞ。"}, {"type": "subtitle", "time": 7521.99, "timestamp": "02:05:21", "text": "待って。 戻ってくる。 あなたは勝利への道ですか？"}, {"type": "subtitle", "time": 7523.589, "timestamp": "02:05:23", "text": "うん。 血圧を測ってください。 それを得る。 彼を"}, {"type": "subtitle", "time": 7525.669, "timestamp": "02:05:25", "text": "私の画面から消して。 ああ、汚いね。"}, {"type": "subtitle", "time": 7527.75, "timestamp": "02:05:27", "text": "ニース。"}, {"type": "subtitle", "time": 7531.669, "timestamp": "02:05:31", "text": "BPはどこにありますか？ バルパス。 待って、"}, {"type": "subtitle", "time": 7533.83, "timestamp": "02:05:33", "text": "ブラックパンサー。 アイアンマンを手に入れろ。"}, {"type": "subtitle", "time": 7537.669, "timestamp": "02:05:37", "text": "あの男を画面から消してくれ。"}, {"type": "subtitle", "time": 7539.669, "timestamp": "02:05:39", "text": "彼はどこにいますか？"}, {"type": "subtitle", "time": 7541.27, "timestamp": "02:05:41", "text": "彼に連絡した。 彼はあそこにいる。 はい。 はい。"}]
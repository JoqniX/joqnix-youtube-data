[{"type": "subtitle", "time": 10744.79, "timestamp": "02:59:04", "text": "ヘッドショットを狙えばいい。 混沌の"}, {"type": "subtitle", "time": 10747.59, "timestamp": "02:59:07", "text": "魔法の痕跡が、投げられた巻物のある地下室へと続いています。一体どこへ行けばいいのでしょうか"}, {"type": "subtitle", "time": 10758.95, "timestamp": "02:59:18", "text": "？"}, {"type": "subtitle", "time": 10762.07, "timestamp": "02:59:22", "text": "私たちはこのラウンドでこれを３回"}, {"type": "subtitle", "time": 10765.99, "timestamp": "02:59:25", "text": "連続でプレイしました。 どうして知らないの？   いやいや、"}, {"type": "subtitle", "time": 10768.63, "timestamp": "02:59:28", "text": "破壊的だ。   それは"}]
[{"type": "subtitle", "time": 961.67, "timestamp": "00:16:01", "text": "マグニートーの"}, {"type": "subtitle", "time": 962.87, "timestamp": "00:16:02", "text": "ロープに吸い込まれてしまう。 ああ。"}, {"type": "subtitle", "time": 966.069, "timestamp": "00:16:06", "text": "つまり、彼を撃つと、彼の"}, {"type": "subtitle", "time": 969.509, "timestamp": "00:16:09", "text": "代替攻撃がチャージされる。 つまり、彼はより多くの損害を与えるということだ。"}, {"type": "subtitle", "time": 972.15, "timestamp": "00:16:12", "text": "何？"}, {"type": "subtitle", "time": 974.069, "timestamp": "00:16:14", "text": "うん。 つまり、私の"}, {"type": "subtitle", "time": 975.99, "timestamp": "00:16:15", "text": "サブキャラが十分にチャージされていれば、文字通りあなたのチーム全員を倒すことができるということです"}, {"type": "subtitle", "time": 978.31, "timestamp": "00:16:18", "text": "。"}, {"type": "subtitle", "time": 980.15, "timestamp": "00:16:20", "text": "おお。"}, {"type": "subtitle", "time": 982.23, "timestamp": "00:16:22", "text": "うん。 でも、ほら、これを打たなきゃいけないんだよ。ほら、"}, {"type": "subtitle", "time": 986.47, "timestamp": "00:16:26", "text": "これを打つのはそんなに簡単じゃないんだ。ほら、"}, {"type": "subtitle", "time": 988.629, "timestamp": "00:16:28", "text": "これを本当にうまく打たなきゃいけないんだ"}, {"type": "subtitle", "time": 990.949, "timestamp": "00:16:30", "text": "。 それに、"}, {"type": "subtitle", "time": 993.35, "timestamp": "00:16:33", "text": "シールドなどで防ぐこともできるから、それほど"}, {"type": "subtitle", "time": 995.99, "timestamp": "00:16:35", "text": "良いものではないけど、まあ、"}, {"type": "subtitle", "time": 997.749, "timestamp": "00:16:37", "text": "不可能ではない。 見えないところにいるんだよ、"}, {"type": "subtitle", "time": 999.749, "timestamp": "00:16:39", "text": "少なくとも僕にとってはね。"}, {"type": "subtitle", "time": 1002.71, "timestamp": "00:16:42", "text": "他の人のことは分かりません。 私には可能です。"}, {"type": "subtitle", "time": 1005.03, "timestamp": "00:16:45", "text": "私はそうは思わない。"}, {"type": "subtitle", "time": 1007.03, "timestamp": "00:16:47", "text": "うん。 まあ、それがあなたのキャラクターに対する唯一の対策ですね。なぜなら、"}, {"type": "subtitle", "time": 1008.629, "timestamp": "00:16:48", "text": "彼はあなたのサブ"}, {"type": "subtitle", "time": 1010.71, "timestamp": "00:16:50", "text": "アカウントをすべて占有し、ワンショットであなたを、そしてその場合は"}, {"type": "subtitle", "time": 1013.11, "timestamp": "00:16:53", "text": "あなたのチーム全体を殺してしまうからです。"}, {"type": "subtitle", "time": 1014.389, "timestamp": "00:16:54", "text": "私はミュータントで、それを"}, {"type": "subtitle", "time": 1015.749, "timestamp": "00:16:55", "text": "誇りに思っています。"}, {"type": "subtitle", "time": 1018.629, "timestamp": "00:16:58", "text": "ああ、ストームは、"}]
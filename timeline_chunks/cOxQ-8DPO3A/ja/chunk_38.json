[{"type": "subtitle", "time": 2284.63, "timestamp": "00:38:04", "text": "ああ、つまり、それがもう"}, {"type": "subtitle", "time": 2286.63, "timestamp": "00:38:06", "text": "一方の部分です。"}, {"type": "subtitle", "time": 2290.069, "timestamp": "00:38:10", "text": "ちなみに、それは実現するのが難しいことだ。 実現するのは非常に難しい"}, {"type": "subtitle", "time": 2297.99, "timestamp": "00:38:17", "text": "でも、あなたの性格は、ええと、"}, {"type": "subtitle", "time": 2300.63, "timestamp": "00:38:20", "text": "その輝きをお見せしましょう。 では、"}, {"type": "subtitle", "time": 2303.589, "timestamp": "00:38:23", "text": "プロの視点からお話ししましょう。   あそこにいるあの"}, {"type": "subtitle", "time": 2305.27, "timestamp": "00:38:25", "text": "人たち、あの"}, {"type": "subtitle", "time": 2308.47, "timestamp": "00:38:28", "text": "小さな人たちを見てください。 彼らがそうだと仮定しましょう。"}, {"type": "subtitle", "time": 2311.349, "timestamp": "00:38:31", "text": "クールダウンを始めましょう。"}, {"type": "subtitle", "time": 2313.67, "timestamp": "00:38:33", "text": "あなたの尻尾はここにあります。"}, {"type": "subtitle", "time": 2315.27, "timestamp": "00:38:35", "text": "ダブルキル。 仮に"}, {"type": "subtitle", "time": 2317.27, "timestamp": "00:38:37", "text": "ヒーラーが2人しかいないとしましょう。"}, {"type": "subtitle", "time": 2320.23, "timestamp": "00:38:40", "text": "あなたは簡単に、"}, {"type": "subtitle", "time": 2323.67, "timestamp": "00:38:43", "text": "1対1で選ばないのに最適なキャラクターです。"}, {"type": "subtitle", "time": 2326.87, "timestamp": "00:38:46", "text": "まあ、まず第一に、あなたは給料をもらったわけですからね。"}, {"type": "subtitle", "time": 2328.39, "timestamp": "00:38:48", "text": "とりあえず1対1でやってみよう。 まず最初に、"}, {"type": "subtitle", "time": 2329.91, "timestamp": "00:38:49", "text": "お前を殺して"}, {"type": "subtitle", "time": 2335.99, "timestamp": "00:38:55", "text": "生まれ変わって、"}, {"type": "subtitle", "time": 2338.47, "timestamp": "00:38:58", "text": "よし、1、2、3と始めた。 さあ、"}]
[{"type": "subtitle", "time": 2881.109, "timestamp": "00:48:01", "text": "そう、こういう"}, {"type": "subtitle", "time": 2883.109, "timestamp": "00:48:03", "text": "キャラクターとは正反対ですね。 だから、"}, {"type": "subtitle", "time": 2884.23, "timestamp": "00:48:04", "text": "これらのキャラクターを殺すのは簡単だ。 私が"}, {"type": "subtitle", "time": 2887.109, "timestamp": "00:48:07", "text": "言いたいのはそういうことです。 わかった。   仮に"}, {"type": "subtitle", "time": 2889.51, "timestamp": "00:48:09", "text": "敵がいるとしましょう。"}, {"type": "subtitle", "time": 2891.349, "timestamp": "00:48:11", "text": "こんにちは。 後ろにいる人たちは"}, {"type": "subtitle", "time": 2893.67, "timestamp": "00:48:13", "text": "私のチームメイトだと言っておきましょう。"}, {"type": "subtitle", "time": 2896.87, "timestamp": "00:48:16", "text": "私を殴らないで。 側面攻撃を試みる。 よし、"}, {"type": "subtitle", "time": 2899.109, "timestamp": "00:48:19", "text": "側面攻撃を試してみよう。"}, {"type": "subtitle", "time": 2901.03, "timestamp": "00:48:21", "text": "これらのヒーラーを側面から攻撃して倒しましょう。   わかりました。"}, {"type": "subtitle", "time": 2907.67, "timestamp": "00:48:27", "text": "ランクマッチで一緒にプレイするときに、私が手伝います。 つまり、"}, {"type": "subtitle", "time": 2909.589, "timestamp": "00:48:29", "text": "君とのクイックマッチのことだ。 だから、ずっと簡単になった。 だから、"}, {"type": "subtitle", "time": 2911.67, "timestamp": "00:48:31", "text": "試してみれば分かるでしょう。   わかった"}, {"type": "subtitle", "time": 2913.67, "timestamp": "00:48:33", "text": "。"}, {"type": "subtitle", "time": 2915.19, "timestamp": "00:48:35", "text": "例えば、"}, {"type": "subtitle", "time": 2917.43, "timestamp": "00:48:37", "text": "このキャラクターには特定のプレイスタイルがあるように。 特定の"}, {"type": "subtitle", "time": 2919.109, "timestamp": "00:48:39", "text": "プレイスタイルの一つは、先ほども言ったように、あなたの"}, {"type": "subtitle", "time": 2921.99, "timestamp": "00:48:41", "text": "チームや"}, {"type": "subtitle", "time": 2924.47, "timestamp": "00:48:44", "text": "ヒーラーに突っ込んでくるダイブキャラクターに対抗するために、カウンターダイブを行うことです。 わかった。"}, {"type": "subtitle", "time": 2926.47, "timestamp": "00:48:46", "text": "2つ目は、ただ外に出てヒーラーを"}, {"type": "subtitle", "time": 2928.47, "timestamp": "00:48:48", "text": "倒すことです。つまり、"}, {"type": "subtitle", "time": 2933.349, "timestamp": "00:48:53", "text": "ダイブをプレイして、自分自身がダイブのスカーレット"}, {"type": "subtitle", "time": 2936.069, "timestamp": "00:48:56", "text": "ウィッチになるということです。 だから"}]
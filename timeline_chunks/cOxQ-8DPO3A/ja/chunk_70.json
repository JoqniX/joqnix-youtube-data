[{"type": "subtitle", "time": 4203.91, "timestamp": "01:10:03", "text": "？  「あなたが正しい」ってどういう意味ですか？"}, {"type": "subtitle", "time": 4207.75, "timestamp": "01:10:07", "text": "知っている。 やってみたけど、"}, {"type": "subtitle", "time": 4208.55, "timestamp": "01:10:08", "text": "顔が疲れてしまう。   なぜかって"}, {"type": "subtitle", "time": 4212.31, "timestamp": "01:10:12", "text": "？ 何故ですか？"}, {"type": "subtitle", "time": 4215.03, "timestamp": "01:10:15", "text": "私はそれを制御する必要がある。 うん。"}, {"type": "subtitle", "time": 4216.87, "timestamp": "01:10:16", "text": "ああ、君は…一体何を言っているんだ"}, {"type": "subtitle", "time": 4218.63, "timestamp": "01:10:18", "text": "？ それを制御する。"}, {"type": "subtitle", "time": 4224.229, "timestamp": "01:10:24", "text": "フェード効果をコントロールしている。"}, {"type": "subtitle", "time": 4227.11, "timestamp": "01:10:27", "text": "2回押し続けて使い切らないように。"}, {"type": "subtitle", "time": 4231.59, "timestamp": "01:10:31", "text": "おい、待ってくれ。"}, {"type": "subtitle", "time": 4234.95, "timestamp": "01:10:34", "text": "フェードを1回使ったかどうかは、すぐにわかります。"}, {"type": "subtitle", "time": 4236.95, "timestamp": "01:10:36", "text": "フェードを使うなと言っているわけではありません。 クール"}, {"type": "subtitle", "time": 4239.669, "timestamp": "01:10:39", "text": "ダウン時間を確認するように言っています。   よし"}, {"type": "subtitle", "time": 4244.229, "timestamp": "01:10:44", "text": "クールダウン時間を確認してください。 フェードボタンを押すと"}, {"type": "subtitle", "time": 4245.59, "timestamp": "01:10:45", "text": "、クールダウンのような効果があります。 上に上がっていく"}, {"type": "subtitle", "time": 4248.229, "timestamp": "01:10:48", "text": "円があります。それを見て、"}, {"type": "subtitle", "time": 4255.35, "timestamp": "01:10:55", "text": "半分以上になったら、好きになるようにしてみてください。 ただ"}, {"type": "subtitle", "time": 4257.75, "timestamp": "01:10:57", "text": "彼らを殺そうとして、その後消え去ればいい。"}]
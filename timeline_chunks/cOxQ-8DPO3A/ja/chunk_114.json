[{"type": "subtitle", "time": 6841.99, "timestamp": "01:54:01", "text": "DNA"}, {"type": "subtitle", "time": 6844.95, "timestamp": "01:54:04", "text": "ゲームに戻って、ひたすら作業をすればいいんだよ。 あるいは、"}, {"type": "subtitle", "time": 6851.589, "timestamp": "01:54:11", "text": "あなたは十分な実力がありますか？"}, {"type": "subtitle", "time": 6853.109, "timestamp": "01:54:13", "text": "見て、上を見て。 あなたは十分な実力がありますか"}, {"type": "subtitle", "time": 6855.51, "timestamp": "01:54:15", "text": "？"}, {"type": "subtitle", "time": 6857.109, "timestamp": "01:54:17", "text": "バカだな、"}, {"type": "subtitle", "time": 6857.43, "timestamp": "01:54:17", "text": "兄弟。"}, {"type": "subtitle", "time": 6859.669, "timestamp": "01:54:19", "text": "上記の意味が分かりますか？"}, {"type": "subtitle", "time": 6860.87, "timestamp": "01:54:20", "text": "ああ、わかりました"}, {"type": "subtitle", "time": 6863.189, "timestamp": "01:54:23", "text": "。 でも、私は見上げた。"}, {"type": "subtitle", "time": 6865.99, "timestamp": "01:54:25", "text": "スパイダーマンとか、そういうのがあったよ。"}, {"type": "subtitle", "time": 6868.55, "timestamp": "01:54:28", "text": "あれはスパイダーマンじゃない。   あれは"}, {"type": "subtitle", "time": 6870.31, "timestamp": "01:54:30", "text": "ペニー・パーカーです。"}, {"type": "subtitle", "time": 6873.75, "timestamp": "01:54:33", "text": "ええ、同じことです。 スパイダージーンズ。"}, {"type": "subtitle", "time": 6877.27, "timestamp": "01:54:37", "text": "「すみません、"}, {"type": "subtitle", "time": 6879.109, "timestamp": "01:54:39", "text": "ここでクモに対する差別的な発言をされていましたか？」と言ってみてください。"}, {"type": "subtitle", "time": 6881.91, "timestamp": "01:54:41", "text": "ああ、だって彼女はそうだから。 うん。 やっぱり君はそういう人だな"}, {"type": "subtitle", "time": 6883.83, "timestamp": "01:54:43", "text": "、坊や。 それが私のすべてです"}, {"type": "subtitle", "time": 6885.109, "timestamp": "01:54:45", "text": "。 うん。 うん。   何てことだ"}]
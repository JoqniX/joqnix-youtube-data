[{"type": "subtitle", "time": 1985.75, "timestamp": "00:33:05", "text": "つまり、ロキは研究所を設置するということだ。 これらは"}, {"type": "subtitle", "time": 1987.83, "timestamp": "00:33:07", "text": "不老不死の研究施設です。"}, {"type": "subtitle", "time": 1989.83, "timestamp": "00:33:09", "text": "誰も傷つけることはできない。 与えるダメージが大きいほど"}, {"type": "subtitle", "time": 1992.07, "timestamp": "00:33:12", "text": "、相手の回復量も増える。 つまり、"}, {"type": "subtitle", "time": 1993.99, "timestamp": "00:33:13", "text": "ロキにダメージを与える唯一の方法は、研究所を破壊することだ。"}, {"type": "subtitle", "time": 1996.07, "timestamp": "00:33:16", "text": "研究所を破壊してみてください。"}, {"type": "subtitle", "time": 1997.669, "timestamp": "00:33:17", "text": "研究所を狙って破壊することができます。"}, {"type": "subtitle", "time": 1999.75, "timestamp": "00:33:19", "text": "こうして始まった。"}, {"type": "subtitle", "time": 2001.43, "timestamp": "00:33:21", "text": "これで分かりましたね。   わかった"}, {"type": "subtitle", "time": 2003.11, "timestamp": "00:33:23", "text": "。 わかった。"}, {"type": "subtitle", "time": 2005.19, "timestamp": "00:33:25", "text": "それでは、あなたの"}, {"type": "subtitle", "time": 2007.59, "timestamp": "00:33:27", "text": "古い考えを覆すことができる戦車についてお話ししましょう。   わかった"}, {"type": "subtitle", "time": 2008.149, "timestamp": "00:33:28", "text": "。   えっと"}, {"type": "subtitle", "time": 2012.07, "timestamp": "00:33:32", "text": "、1、2、3、4だと思います"}, {"type": "subtitle", "time": 2014.63, "timestamp": "00:33:34", "text": "。 これも4です。 そう、基本的には"}, {"type": "subtitle", "time": 2020.31, "timestamp": "00:33:40", "text": "ダイヤモンド爆弾があなたに。   何てことだ"}, {"type": "subtitle", "time": 2023.11, "timestamp": "00:33:43", "text": "。"}, {"type": "subtitle", "time": 2024.71, "timestamp": "00:33:44", "text": "もう"}, {"type": "subtitle", "time": 2032.07, "timestamp": "00:33:52", "text": "、ペニーの件は大嫌いだ。 うん。"}, {"type": "subtitle", "time": 2035.669, "timestamp": "00:33:55", "text": "うん。 そして3人目はハルクです。 彼はただ"}, {"type": "subtitle", "time": 2038.149, "timestamp": "00:33:58", "text": "スタン攻撃しかできない。 はい、どうぞ。"}]
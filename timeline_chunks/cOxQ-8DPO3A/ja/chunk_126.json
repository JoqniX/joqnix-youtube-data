[{"type": "subtitle", "time": 7577.83, "timestamp": "02:06:17", "text": "[音楽は]まだ"}, {"type": "subtitle", "time": 7579.35, "timestamp": "02:06:19", "text": "終わっていない。"}, {"type": "subtitle", "time": 7588.55, "timestamp": "02:06:28", "text": "あなたはCランクです。ただ、彼らを一気に倒すと言えばいいでしょう"}, {"type": "subtitle", "time": 7598.55, "timestamp": "02:06:38", "text": "ヒーラーがいない。 念のため言っておきます。"}, {"type": "subtitle", "time": 7612.31, "timestamp": "02:06:52", "text": "アイアンマン。 アイアンマン。 アイアンマン。 アイアンマン。"}, {"type": "subtitle", "time": 7613.43, "timestamp": "02:06:53", "text": "繰り返しますが、"}, {"type": "subtitle", "time": 7614.069, "timestamp": "02:06:54", "text": "私は死んでいます。   わかった"}, {"type": "subtitle", "time": 7614.629, "timestamp": "02:06:54", "text": "。"}, {"type": "subtitle", "time": 7617.589, "timestamp": "02:06:57", "text": "死んだのは私だけだ。   何てことだ"}, {"type": "subtitle", "time": 7619.51, "timestamp": "02:06:59", "text": "。"}]
[{"type": "subtitle", "time": 9902.23, "timestamp": "02:45:02", "text": "どうしていつも死んでるの？"}, {"type": "subtitle", "time": 9911.91, "timestamp": "02:45:11", "text": "もう一人の男は45を取った。45。45。"}, {"type": "subtitle", "time": 9915.429, "timestamp": "02:45:15", "text": "いや、違う。  50. ええと、25。私は"}, {"type": "subtitle", "time": 9919.19, "timestamp": "02:45:19", "text": "他の人を観戦していました。両方とも、私の場合は"}, {"type": "subtitle", "time": 9922.55, "timestamp": "02:45:22", "text": "赤だけを取っています。今は赤のカードが45枚あります。それは良いことですが、"}, {"type": "subtitle", "time": 9931.11, "timestamp": "02:45:31", "text": "他の人は他の色のカードを25枚持っています。それは良くありません。"}, {"type": "subtitle", "time": 9940.04, "timestamp": "02:45:40", "text": "赤は青よりも優れています。"}, {"type": "subtitle", "time": 9946.95, "timestamp": "02:45:46", "text": "このエリアをチェックしてください。 ここは"}]
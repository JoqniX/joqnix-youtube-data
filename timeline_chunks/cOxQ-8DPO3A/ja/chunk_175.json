[{"type": "subtitle", "time": 10501.83, "timestamp": "02:55:01", "text": "ああ、吸血鬼の生命力よ。 それを手に入れるつもりです"}, {"type": "subtitle", "time": 10505.11, "timestamp": "02:55:05", "text": "。 そして、これは伝説のバージョンです。   さあ"}, {"type": "subtitle", "time": 10508.95, "timestamp": "02:55:08", "text": "行こうぜ、相棒。 ああ、行こうぜ、相棒。"}, {"type": "subtitle", "time": 10523.51, "timestamp": "02:55:23", "text": "目指せ。 大物相手には頭を狙え"}, {"type": "subtitle", "time": 10530.07, "timestamp": "02:55:30", "text": "それと、体力ゲージを最大にするのを忘れないでね"}, {"type": "subtitle", "time": 10532.07, "timestamp": "02:55:32", "text": "？ だって、君には"}, {"type": "subtitle", "time": 10540.15, "timestamp": "02:55:40", "text": "スカーレット・ウィッチのような相手には、"}, {"type": "subtitle", "time": 10542.55, "timestamp": "02:55:42", "text": "体力が必要になる。そうでなければ必ず"}]
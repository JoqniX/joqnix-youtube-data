[{"type": "subtitle", "time": 12240.95, "timestamp": "03:24:00", "text": "今回はランクマッチはやらないんだ。 もう"}, {"type": "subtitle", "time": 12243.349, "timestamp": "03:24:03", "text": "片方については、既に天界の頂点に達している。"}, {"type": "subtitle", "time": 12244.87, "timestamp": "03:24:04", "text": "これは文字の練習に使ってるだけだよ"}, {"type": "subtitle", "time": 12245.91, "timestamp": "03:24:05", "text": "、"}, {"type": "subtitle", "time": 12253.75, "timestamp": "03:24:13", "text": "。"}, {"type": "subtitle", "time": 12259.99, "timestamp": "03:24:19", "text": "ニース。"}, {"type": "subtitle", "time": 12262.389, "timestamp": "03:24:22", "text": "ねえ、私も汗をかくようなゲームが好きなんだよ"}, {"type": "subtitle", "time": 12275.429, "timestamp": "03:24:35", "text": "あそこでピューピューと撃っていけるよ。 私は"}, {"type": "subtitle", "time": 12276.63, "timestamp": "03:24:36", "text": "母と一緒です。"}, {"type": "subtitle", "time": 12277.11, "timestamp": "03:24:37", "text": "こんにちは。   わかった"}, {"type": "subtitle", "time": 12278.469, "timestamp": "03:24:38", "text": "。"}, {"type": "subtitle", "time": 12280.63, "timestamp": "03:24:40", "text": "片付けを始めているところですか？"}, {"type": "subtitle", "time": 12283.349, "timestamp": "03:24:43", "text": "DNA鑑定によってゲームを終了させるつもりですか？"}, {"type": "subtitle", "time": 12284.79, "timestamp": "03:24:44", "text": "いいえ。ナイトメア1をプレイすると思っていました"}, {"type": "subtitle", "time": 12287.19, "timestamp": "03:24:47", "text": "。 わかった。 私たちは知らない、あなたは知らない、"}, {"type": "subtitle", "time": 12289.269, "timestamp": "03:24:49", "text": "どちらですか？ 過激。"}, {"type": "subtitle", "time": 12290.15, "timestamp": "03:24:50", "text": "悪夢その1。"}, {"type": "subtitle", "time": 12290.87, "timestamp": "03:24:50", "text": "そうそう。"}, {"type": "subtitle", "time": 12291.91, "timestamp": "03:24:51", "text": "悪夢その1。"}, {"type": "subtitle", "time": 12294.229, "timestamp": "03:24:54", "text": "待って。  4つになる予定です。   今は"}, {"type": "subtitle", "time": 12295.269, "timestamp": "03:24:55", "text": "4時です。"}, {"type": "subtitle", "time": 12296.71, "timestamp": "03:24:56", "text": "ああ、君は行かなきゃ。"}, {"type": "subtitle", "time": 12298.469, "timestamp": "03:24:58", "text": "うん。   わかった"}]
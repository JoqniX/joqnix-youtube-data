[{"type": "subtitle", "time": 10441.429, "timestamp": "02:54:01", "text": "バンドルを購入するには32が必要です。32"}, {"type": "subtitle", "time": 10444.55, "timestamp": "02:54:04", "text": "か28でしょうか？ いやいや、"}, {"type": "subtitle", "time": 10445.59, "timestamp": "02:54:05", "text": "2文字セットで28だよ。"}, {"type": "subtitle", "time": 10447.429, "timestamp": "02:54:07", "text": "ああ、しまった。"}, {"type": "subtitle", "time": 10450.23, "timestamp": "02:54:10", "text": "非常識な。 ええ、それは"}, {"type": "subtitle", "time": 10453.19, "timestamp": "02:54:13", "text": "あなたがそうならということではありません。Twitter"}, {"type": "subtitle", "time": 10455.429, "timestamp": "02:54:15", "text": "で見かけた男性がいます。"}, {"type": "subtitle", "time": 10458.07, "timestamp": "02:54:18", "text": "Twitterで見かけました。 えっと、彼は"}, {"type": "subtitle", "time": 10461.349, "timestamp": "02:54:21", "text": "シーズン1からユニットを貯めていて、"}, {"type": "subtitle", "time": 10468.63, "timestamp": "02:54:28", "text": "え、8000？"}, {"type": "subtitle", "time": 10470.07, "timestamp": "02:54:30", "text": "それだけですか？"}, {"type": "subtitle", "time": 10473.11, "timestamp": "02:54:33", "text": "ええ、8000台です。"}, {"type": "subtitle", "time": 10475.59, "timestamp": "02:54:35", "text": "ああ、このゲームはこれだけ"}, {"type": "subtitle", "time": 10478.07, "timestamp": "02:54:38", "text": "無料で提供してくれるのか。 それは8つくらいで、"}, {"type": "subtitle", "time": 10480.469, "timestamp": "02:54:40", "text": "少なくとも5つの"}, {"type": "subtitle", "time": 10485.67, "timestamp": "02:54:45", "text": "エピックスキンと3つのレジェンダリースキンです。"}, {"type": "subtitle", "time": 10494.71, "timestamp": "02:54:54", "text": "これらのゾンビは混沌の魔法によって堕落させられている"}, {"type": "subtitle", "time": 10499.19, "timestamp": "02:54:59", "text": "。奴らを滅ぼせ。"}]
[{"type": "subtitle", "time": 10324.79, "timestamp": "02:52:04", "text": "。 ニース。"}, {"type": "subtitle", "time": 10335.91, "timestamp": "02:52:15", "text": "結晶。   間に合わないかもしれない"}, {"type": "subtitle", "time": 10338.15, "timestamp": "02:52:18", "text": "。   もしかしたら"}, {"type": "subtitle", "time": 10339.51, "timestamp": "02:52:19", "text": "本当にできるかもしれない。"}, {"type": "subtitle", "time": 10341.99, "timestamp": "02:52:21", "text": "ああ、わかりました。"}, {"type": "subtitle", "time": 10343.91, "timestamp": "02:52:23", "text": "クリスタルだよ、相棒。 撃てばいい。"}, {"type": "subtitle", "time": 10345.51, "timestamp": "02:52:25", "text": "クリスタルを撃て。"}, {"type": "subtitle", "time": 10347.51, "timestamp": "02:52:27", "text": "簡単です。"}, {"type": "subtitle", "time": 10351.51, "timestamp": "02:52:31", "text": "MVP。 何てことだ。"}, {"type": "subtitle", "time": 10354.23, "timestamp": "02:52:34", "text": "私は君たちより100万多く持っていた。"}, {"type": "subtitle", "time": 10357.83, "timestamp": "02:52:37", "text": "それはカエルです。 何てことだ。 くそ。"}, {"type": "subtitle", "time": 10360.309, "timestamp": "02:52:40", "text": "それはカエルです。 はい、私が言ったのはそういうことです。"}, {"type": "subtitle", "time": 10361.429, "timestamp": "02:52:41", "text": "それはカエルです。"}, {"type": "subtitle", "time": 10363.75, "timestamp": "02:52:43", "text": "ああ、3時半だ。"}, {"type": "subtitle", "time": 10367.269, "timestamp": "02:52:47", "text": "あなたのところでは何時でしたか？   十分ではない"}, {"type": "subtitle", "time": 10369.429, "timestamp": "02:52:49", "text": "。   十分ではない"}, {"type": "subtitle", "time": 10375.75, "timestamp": "02:52:55", "text": "。"}, {"type": "subtitle", "time": 10377.03, "timestamp": "02:52:57", "text": "遊びたい？"}, {"type": "subtitle", "time": 10379.91, "timestamp": "02:52:59", "text": "最後の試合が1試合残っている。"}]
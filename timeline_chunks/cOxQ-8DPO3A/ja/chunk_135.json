[{"type": "subtitle", "time": 8120.069, "timestamp": "02:15:20", "text": "[音楽]"}, {"type": "subtitle", "time": 8142.55, "timestamp": "02:15:42", "text": "そうですね。 遊ぼう。   わかった"}, {"type": "subtitle", "time": 8150.79, "timestamp": "02:15:50", "text": "えっと、パニッシャーの場合は、全身を赤くしてみてください。   わかった"}, {"type": "subtitle", "time": 8153.189, "timestamp": "02:15:53", "text": "。 どんな赤色でも、それを目指してみてください"}, {"type": "subtitle", "time": 8154.47, "timestamp": "02:15:54", "text": "。"}, {"type": "subtitle", "time": 8156.55, "timestamp": "02:15:56", "text": "ああ、わかりました。"}, {"type": "subtitle", "time": 8159.99, "timestamp": "02:15:59", "text": "ご存知ない方のために説明すると、カードの台座のようなものです。"}]
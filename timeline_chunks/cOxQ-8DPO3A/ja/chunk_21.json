[{"type": "subtitle", "time": 1266.07, "timestamp": "00:21:06", "text": "ええ、でも、いいですよ。では、もう一つお見せしましょう"}, {"type": "subtitle", "time": 1268.87, "timestamp": "00:21:08", "text": "。 ところで、味方への"}, {"type": "subtitle", "time": 1271.59, "timestamp": "00:21:11", "text": "誤射は禁止です。"}, {"type": "subtitle", "time": 1275.27, "timestamp": "00:21:15", "text": "私はストリートベンチャーやシステムだったが、私を"}, {"type": "subtitle", "time": 1293.51, "timestamp": "00:21:33", "text": "私は影響を与えたようです。   私はできません"}, {"type": "subtitle", "time": 1295.909, "timestamp": "00:21:35", "text": "。 よし、"}, {"type": "subtitle", "time": 1298.47, "timestamp": "00:21:38", "text": "これだ。 よし、もう一度これだ。 また。"}, {"type": "subtitle", "time": 1300.23, "timestamp": "00:21:40", "text": "もう一度やってみて。"}, {"type": "subtitle", "time": 1309.75, "timestamp": "00:21:49", "text": "お前を全力で殺してやる。 ああ、"}, {"type": "subtitle", "time": 1312.549, "timestamp": "00:21:52", "text": "人々は君の全てを奪い去ることができるんだ。   念のため"}, {"type": "subtitle", "time": 1313.59, "timestamp": "00:21:53", "text": "言っておきます。"}, {"type": "subtitle", "time": 1317.909, "timestamp": "00:21:57", "text": "なぜ？"}]
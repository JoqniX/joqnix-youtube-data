[{"type": "subtitle", "time": 5443.35, "timestamp": "01:30:43", "text": "えっと、あなたはどこを見ていますか？"}, {"type": "subtitle", "time": 5445.03, "timestamp": "01:30:45", "text": "ちなみに、あなたの成績はCです。"}, {"type": "subtitle", "time": 5446.47, "timestamp": "01:30:46", "text": "私は彼らを撃つことはできません。"}, {"type": "subtitle", "time": 5448.709, "timestamp": "01:30:48", "text": "私はCを持っていません。どういう意味ですか？ ああ、"}, {"type": "subtitle", "time": 5451.43, "timestamp": "01:30:51", "text": "あなたは持っていないんですね。わかりました、よかったです。"}, {"type": "subtitle", "time": 5454.709, "timestamp": "01:30:54", "text": "ナイスに行くつもりなら、ぜひ試してみてください。"}]
[{"type": "subtitle", "time": 10949.59, "timestamp": "03:02:29", "text": "ああ、こいつらうざいな。 わかった。 ああ、なんてことだ、"}, {"type": "subtitle", "time": 10952.55, "timestamp": "03:02:32", "text": "穴が開いている。  「なんてこった」という声が大量に押し寄せた"}, {"type": "subtitle", "time": 10955.269, "timestamp": "03:02:35", "text": "。 殺してしまえ。 奴らを殺さなければ、それは"}, {"type": "subtitle", "time": 10962.469, "timestamp": "03:02:42", "text": "ジョー、君の後ろにいるよ。 背後の敵を倒せ"}, {"type": "subtitle", "time": 10966.63, "timestamp": "03:02:46", "text": "。 あいつらは盗聴されている。 あなたの後ろにいます。"}, {"type": "subtitle", "time": 10967.51, "timestamp": "03:02:47", "text": "どこ？   一番"}, {"type": "subtitle", "time": 10968.389, "timestamp": "03:02:48", "text": "上。   何てことだ"}, {"type": "subtitle", "time": 10970.71, "timestamp": "03:02:50", "text": "。"}, {"type": "subtitle", "time": 10973.269, "timestamp": "03:02:53", "text": "奴らを殺せ。 あいつらは盗聴されている。 彼らは"}]
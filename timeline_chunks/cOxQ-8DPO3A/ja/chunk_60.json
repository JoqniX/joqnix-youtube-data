[{"type": "subtitle", "time": 3600.95, "timestamp": "01:00:00", "text": "ついに。 わかった。 こっちのペニーを殺してみろ"}, {"type": "chat", "time": 3602.374, "timestamp": "01:00:02", "author": "@DinyoFoxy", "avatar": "https://yt4.ggpht.com/aACLJToYP6FMtiMkCyV12FJchjJLrwy1qzEVqHiZEyFaZdsbRkj-yqg_i_m8eqjYX-fTLgPLCzk=s64-c-k-c0x00ffffff-no-rj", "message": "bread where are you form ?"}, {"type": "subtitle", "time": 3603.829, "timestamp": "01:00:03", "text": "。   彼女を"}, {"type": "subtitle", "time": 3605.589, "timestamp": "01:00:05", "text": "殺せますか？彼女を撃てますか？"}, {"type": "subtitle", "time": 3607.27, "timestamp": "01:00:07", "text": "俺の仲間が見えるか？"}, {"type": "subtitle", "time": 3611.349, "timestamp": "01:00:11", "text": "ああ、ほら、上のもう一人の男を捕まえろ。   どんどん上へ上へ"}, {"type": "subtitle", "time": 3614.63, "timestamp": "01:00:14", "text": "。  F以上。   わかった"}, {"type": "subtitle", "time": 3616.549, "timestamp": "01:00:16", "text": "。"}, {"type": "subtitle", "time": 3618.87, "timestamp": "01:00:18", "text": "高台に避難するようにしてください。"}, {"type": "subtitle", "time": 3634.95, "timestamp": "01:00:34", "text": "この男を殺してみろ。 この"}, {"type": "subtitle", "time": 3635.91, "timestamp": "01:00:35", "text": "男を殺してみろ。 この男を殺してみろ。   今行ってる"}, {"type": "subtitle", "time": 3637.75, "timestamp": "01:00:37", "text": "。 再び現場へ。"}, {"type": "subtitle", "time": 3639.03, "timestamp": "01:00:39", "text": "私は死んだ。 一度もない。"}, {"type": "subtitle", "time": 3641.589, "timestamp": "01:00:41", "text": "どうしていつも死んでしまうの？"}, {"type": "subtitle", "time": 3643.61, "timestamp": "01:00:43", "text": "そのキャラクターと共に死ぬべきではない。"}, {"type": "subtitle", "time": 3650.23, "timestamp": "01:00:50", "text": "ああ、なんてことだ。   まるで、"}, {"type": "subtitle", "time": 3652.069, "timestamp": "01:00:52", "text": "逃げるのに一番簡単なキャラクターみたいだ"}, {"type": "subtitle", "time": 3659.99, "timestamp": "01:00:59", "text": "ここにいようと努力している。 反対側を見ると、こんなにたくさん"}]
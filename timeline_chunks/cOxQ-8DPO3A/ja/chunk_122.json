[{"type": "subtitle", "time": 7323.109, "timestamp": "02:02:03", "text": "超低価格。 いいもの。 前進し続けろ"}, {"type": "subtitle", "time": 7323.91, "timestamp": "02:02:03", "text": "。 ああ、"}, {"type": "subtitle", "time": 7344.79, "timestamp": "02:02:24", "text": "ああ、女は卑しい。 その女性は落ち込んでいる。"}, {"type": "subtitle", "time": 7355.669, "timestamp": "02:02:35", "text": "チャットはどこですか？ 要するに、この人は"}, {"type": "subtitle", "time": 7359.03, "timestamp": "02:02:39", "text": "すごく速いゲームをプレイするタイプで、"}, {"type": "subtitle", "time": 7360.709, "timestamp": "02:02:40", "text": "このゲームにはついていけないってことだよ。 要するに、"}, {"type": "subtitle", "time": 7363.51, "timestamp": "02:02:43", "text": "この男は"}, {"type": "subtitle", "time": 7366.55, "timestamp": "02:02:46", "text": "このゲームについていけないってことを君に伝えたいだけなんだ。"}, {"type": "subtitle", "time": 7373.589, "timestamp": "02:02:53", "text": "彼がプレイしているゲームや、"}, {"type": "subtitle", "time": 7376.149, "timestamp": "02:02:56", "text": "今の彼のプレイの仕方は、ある意味愚かだ。"}]
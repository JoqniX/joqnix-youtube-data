[{"type": "subtitle", "time": 6121.91, "timestamp": "01:42:01", "text": "【音楽】"}, {"type": "subtitle", "time": 6160.629, "timestamp": "01:42:40", "text": "月明かり。 月明かり。 ああ、そうだね"}, {"type": "subtitle", "time": 6162.87, "timestamp": "01:42:42", "text": "。 あなたも、先ほども言ったように、"}, {"type": "subtitle", "time": 6164.31, "timestamp": "01:42:44", "text": "チーム内でより良い立場に立つべきです。 もし"}, {"type": "subtitle", "time": 6166.149, "timestamp": "01:42:46", "text": "あなたがキャラクターによって孤立させられたら、私には何もできないでしょう"}, {"type": "subtitle", "time": 6173.43, "timestamp": "01:42:53", "text": "ああ、彼は"}]
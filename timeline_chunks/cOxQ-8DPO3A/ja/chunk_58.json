[{"type": "subtitle", "time": 3480.789, "timestamp": "00:58:00", "text": "うん。 うん。 攻撃する前に、"}, {"type": "subtitle", "time": 3487.03, "timestamp": "00:58:07", "text": "つまり、戦車を撃破するかのどちらかだ。 わかった。 それらを使って"}, {"type": "subtitle", "time": 3489.349, "timestamp": "00:58:09", "text": "戦車を強化せよ。"}, {"type": "subtitle", "time": 3491.03, "timestamp": "00:58:11", "text": "それらを元通りにできるのは、"}, {"type": "subtitle", "time": 3492.39, "timestamp": "00:58:12", "text": "あなたと私以上に適任な人はいないでしょう？"}, {"type": "subtitle", "time": 3494.069, "timestamp": "00:58:14", "text": "君の楽観主義が好きだよ、"}, {"type": "subtitle", "time": 3497.829, "timestamp": "00:58:17", "text": "それともただダメージを与えたいだけなのか。"}, {"type": "subtitle", "time": 3499.829, "timestamp": "00:58:19", "text": "君はただ上に上がることを忘れているだけだよね"}, {"type": "subtitle", "time": 3507.19, "timestamp": "00:58:27", "text": "そういうことを覚えておかないといけないって言う時みたいなもんだよ。   それも"}, {"type": "subtitle", "time": 3509.99, "timestamp": "00:58:29", "text": "徐々に筋肉の記憶になってきたようだ"}, {"type": "subtitle", "time": 3511.67, "timestamp": "00:58:31", "text": "。"}, {"type": "subtitle", "time": 3513.829, "timestamp": "00:58:33", "text": "わかった。"}, {"type": "subtitle", "time": 3515.829, "timestamp": "00:58:35", "text": "次元間の境界が"}, {"type": "subtitle", "time": 3518.47, "timestamp": "00:58:38", "text": "崩れつつある。 彼らを守るのは私たちの責任だ"}, {"type": "subtitle", "time": 3518.789, "timestamp": "00:58:38", "text": "。"}, {"type": "subtitle", "time": 3520.87, "timestamp": "00:58:40", "text": "そして、特定の状況ではサブアカウントを使って"}, {"type": "subtitle", "time": 3524.87, "timestamp": "00:58:44", "text": "全員を倒すか、スペースを奪うかのどちらかを行う。"}, {"type": "subtitle", "time": 3527.51, "timestamp": "00:58:47", "text": "うーん、この地図はまあまあだね。 だから、行って"}, {"type": "subtitle", "time": 3531.19, "timestamp": "00:58:51", "text": "旗を立ててみてください。   ほら、"}, {"type": "subtitle", "time": 3532.87, "timestamp": "00:58:52", "text": "こっちのペニーが見える？"}, {"type": "subtitle", "time": 3533.91, "timestamp": "00:58:53", "text": "彼女が見える。"}, {"type": "subtitle", "time": 3534.95, "timestamp": "00:58:54", "text": "これは役に立つはずだ。"}, {"type": "subtitle", "time": 3537.99, "timestamp": "00:58:57", "text": "攻撃を受けている。 ああ、"}]
[{"type": "subtitle", "time": 9003.03, "timestamp": "02:30:03", "text": "大きい方を殺せ。 大きな"}, {"type": "subtitle", "time": 9014.15, "timestamp": "02:30:14", "text": "ああ、死ね。"}, {"type": "subtitle", "time": 9016.79, "timestamp": "02:30:16", "text": "タイマーが鳴る前に急いで。"}, {"type": "subtitle", "time": 9019.27, "timestamp": "02:30:19", "text": "残されたのはたった一つだけ。"}, {"type": "subtitle", "time": 9021.429, "timestamp": "02:30:21", "text": "ショットガンをメインにしたビルドも可能です。 見てみればわかるよ"}, {"type": "subtitle", "time": 9022.63, "timestamp": "02:30:22", "text": "。"}, {"type": "subtitle", "time": 9031.429, "timestamp": "02:30:31", "text": "最初は楽しいけど、それほど良いものではない"}, {"type": "subtitle", "time": 9037.03, "timestamp": "02:30:37", "text": "。でも、試してみる価値はあるよ。"}, {"type": "subtitle", "time": 9039.59, "timestamp": "02:30:39", "text": "試してみても損はないだろう。"}, {"type": "subtitle", "time": 9057.91, "timestamp": "02:30:57", "text": "これはすごく楽しい。 つまり、"}]
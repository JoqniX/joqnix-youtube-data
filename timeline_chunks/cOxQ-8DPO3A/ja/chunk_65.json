[{"type": "subtitle", "time": 3905.109, "timestamp": "01:05:05", "text": "支払いを受け取ります。 ニース。"}, {"type": "subtitle", "time": 3906.95, "timestamp": "01:05:06", "text": "いいもの。 はい、彼は亡くなりました。 彼は"}, {"type": "subtitle", "time": 3909.029, "timestamp": "01:05:09", "text": "あなたを殺そうとして死んだ。 よし、"}, {"type": "subtitle", "time": 3921.829, "timestamp": "01:05:21", "text": "えっと、"}, {"type": "subtitle", "time": 3923.67, "timestamp": "01:05:23", "text": "あなたがそちらにいる間に、どうして彼らはみんな死んでるんですか"}, {"type": "subtitle", "time": 3931.109, "timestamp": "01:05:31", "text": "ああ、なんてことだ、私が死にかけている男だ。 ありがとう。"}, {"type": "subtitle", "time": 3932.23, "timestamp": "01:05:32", "text": "ありがとう。 ありがとう。"}, {"type": "subtitle", "time": 3934.069, "timestamp": "01:05:34", "text": "フェードカットですね。 私たちはどのように"}, {"type": "subtitle", "time": 3935.029, "timestamp": "01:05:35", "text": "死ぬのだろうか？"}, {"type": "subtitle", "time": 3942.95, "timestamp": "01:05:42", "text": "この男を殺してみろ。 ああ、なんてことだ、私が"}, {"type": "subtitle", "time": 3943.99, "timestamp": "01:05:43", "text": "彼を殺してしまった。"}, {"type": "subtitle", "time": 3945.349, "timestamp": "01:05:45", "text": "ああ、"}, {"type": "subtitle", "time": 3946.95, "timestamp": "01:05:46", "text": "チラシを狙ってみて。"}, {"type": "subtitle", "time": 3948.87, "timestamp": "01:05:48", "text": "彼に連絡してみます。 彼を狙ってみて。 なぜ"}, {"type": "subtitle", "time": 3951.029, "timestamp": "01:05:51", "text": "行くの？ なぜ衰退しているのですか？"}, {"type": "subtitle", "time": 3959.829, "timestamp": "01:05:59", "text": "私は、キャラクターが飛んでいると言いました。"}]
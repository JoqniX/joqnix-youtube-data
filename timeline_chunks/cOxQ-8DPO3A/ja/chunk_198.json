[{"type": "subtitle", "time": 11881.51, "timestamp": "03:18:01", "text": "画面上の私の"}, {"type": "subtitle", "time": 11883.429, "timestamp": "03:18:03", "text": "名前をクリックしてください。"}, {"type": "subtitle", "time": 11885.91, "timestamp": "03:18:05", "text": "ロビーに戻ります。"}, {"type": "subtitle", "time": 11891.19, "timestamp": "03:18:11", "text": "ああ、ギャラクティカって何ていう名前だったっけ？"}, {"type": "subtitle", "time": 11894.95, "timestamp": "03:18:14", "text": "ええと、キャリアかもしれませんね。"}, {"type": "subtitle", "time": 11896.469, "timestamp": "03:18:16", "text": "ああ、それらの"}, {"type": "subtitle", "time": 11898.229, "timestamp": "03:18:18", "text": "変更は"}, {"type": "subtitle", "time": 11901.03, "timestamp": "03:18:21", "text": "変更されず、変更はそれだけではなく通常に戻ります"}, {"type": "subtitle", "time": 11905.75, "timestamp": "03:18:25", "text": "ええと、"}, {"type": "subtitle", "time": 11908.389, "timestamp": "03:18:28", "text": "いい試合になりそうです。"}, {"type": "subtitle", "time": 11909.59, "timestamp": "03:18:29", "text": "良い試合だった。 よし、"}, {"type": "subtitle", "time": 11913.67, "timestamp": "03:18:33", "text": "では確認してみよう。 さあ、チェックボタンを押してください。   いや"}, {"type": "subtitle", "time": 11914.229, "timestamp": "03:18:34", "text": "、違うよ"}, {"type": "subtitle", "time": 11918.309, "timestamp": "03:18:38", "text": "。 私の名において。 私の名前を押してください。"}, {"type": "subtitle", "time": 11920.95, "timestamp": "03:18:40", "text": "その男性のことですか？ えっと、ロビーを右クリックしてください"}, {"type": "subtitle", "time": 11923.99, "timestamp": "03:18:43", "text": "。 うん、うん、うん、うん。"}, {"type": "subtitle", "time": 11926.309, "timestamp": "03:18:46", "text": "介護者、キャリア。"}, {"type": "subtitle", "time": 11928.87, "timestamp": "03:18:48", "text": "いや、いや。 肌が見えますか？ これ？ それが"}, {"type": "subtitle", "time": 11930.07, "timestamp": "03:18:50", "text": "私が支払った金額に見合うものです。"}, {"type": "subtitle", "time": 11931.269, "timestamp": "03:18:51", "text": "ああ、これだ。 わかった。   タダで"}, {"type": "subtitle", "time": 11934.15, "timestamp": "03:18:54", "text": "お金がもらえる。 はい、これは無料です。"}, {"type": "subtitle", "time": 11936.309, "timestamp": "03:18:56", "text": "無料で手に入れました。"}, {"type": "subtitle", "time": 11939.83, "timestamp": "03:18:59", "text": "ああ、これは無料で手に入れたんだよ。 わかった。"}]
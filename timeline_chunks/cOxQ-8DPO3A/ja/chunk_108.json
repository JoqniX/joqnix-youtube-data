[{"type": "subtitle", "time": 6497.75, "timestamp": "01:48:17", "text": "殺してやる。 ああ、顔を忘れてた"}, {"type": "subtitle", "time": 6497.99, "timestamp": "01:48:17", "text": "。"}, {"type": "subtitle", "time": 6510.709, "timestamp": "01:48:30", "text": "、おい。"}, {"type": "subtitle", "time": 6513.03, "timestamp": "01:48:33", "text": "自分の能力を忘れるのはやめなければならない。"}, {"type": "subtitle", "time": 6534.79, "timestamp": "01:48:54", "text": "彼らがこの角を突いてくると、私はがっかりする。"}, {"type": "subtitle", "time": 6536.709, "timestamp": "01:48:56", "text": "ああ、俺は死ぬだろう。"}]
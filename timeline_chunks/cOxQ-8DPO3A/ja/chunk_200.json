[{"type": "subtitle", "time": 12000.389, "timestamp": "03:20:00", "text": "赤いショットガン"}, {"type": "subtitle", "time": 12003.349, "timestamp": "03:20:03", "text": "と青いショットガンの違いは何ですか？ 次はもしかしたら。"}, {"type": "subtitle", "time": 12005.91, "timestamp": "03:20:05", "text": "そう、青いのはショットガンだよ。 赤色は"}, {"type": "subtitle", "time": 12008.87, "timestamp": "03:20:08", "text": "あなたの"}, {"type": "subtitle", "time": 12009.83, "timestamp": "03:20:09", "text": "プライマリーカラーです。"}, {"type": "subtitle", "time": 12012.87, "timestamp": "03:20:12", "text": "ああ、つまり、ある意味では両方ともアップグレードできるってことですね"}, {"type": "subtitle", "time": 12015.03, "timestamp": "03:20:15", "text": "？"}, {"type": "subtitle", "time": 12018.63, "timestamp": "03:20:18", "text": "うん。 いいえ、できません。 いいえ、できません。"}, {"type": "subtitle", "time": 12021.11, "timestamp": "03:20:21", "text": "赤い方が青いよりずっといいから"}, {"type": "subtitle", "time": 12023.429, "timestamp": "03:20:23", "text": "。"}, {"type": "subtitle", "time": 12025.91, "timestamp": "03:20:25", "text": "ああ、"}, {"type": "subtitle", "time": 12042.63, "timestamp": "03:20:42", "text": "ハァ。 これは何ですか？ 聖なる"}, {"type": "subtitle", "time": 12055.83, "timestamp": "03:20:55", "text": "。 あなたは数日欠席しました。 最近、"}]
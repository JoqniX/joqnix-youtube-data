[{"type": "subtitle", "time": 11700.15, "timestamp": "03:15:00", "text": "緑色のやつを殺してもいい？"}, {"type": "subtitle", "time": 11702.55, "timestamp": "03:15:02", "text": "ああ、やっつけろよ。"}, {"type": "subtitle", "time": 11704.71, "timestamp": "03:15:04", "text": "ダメージが大きいので、もっと大きなものを手に入れようとしています"}, {"type": "subtitle", "time": 11726.87, "timestamp": "03:15:26", "text": "私はただ品質が気に入っただけです。   何てことだ"}, {"type": "subtitle", "time": 11727.83, "timestamp": "03:15:27", "text": "。"}, {"type": "subtitle", "time": 11729.03, "timestamp": "03:15:29", "text": "アベンジャーズタワー。   何てことだ"}, {"type": "subtitle", "time": 11731.91, "timestamp": "03:15:31", "text": "。"}, {"type": "subtitle", "time": 11734.87, "timestamp": "03:15:34", "text": "そこで融合が起こっている。"}, {"type": "subtitle", "time": 11737.67, "timestamp": "03:15:37", "text": "名前入りの弾薬が無限に手に入る"}, {"type": "subtitle", "time": 11739.46, "timestamp": "03:15:39", "text": "。"}, {"type": "subtitle", "time": 11747.75, "timestamp": "03:15:47", "text": "ああ、120点取った。いいね。"}, {"type": "subtitle", "time": 11750.389, "timestamp": "03:15:50", "text": "このクソみたいなものを見てください。 ジョック、これを見てみろよ"}, {"type": "subtitle", "time": 11752.309, "timestamp": "03:15:52", "text": "。 まあ、いいや。   ちょっと待って"}, {"type": "subtitle", "time": 11754.309, "timestamp": "03:15:54", "text": "。 時間がかかります"}]
[{"type": "subtitle", "time": 3000.71, "timestamp": "00:50:00", "text": "カウンターについては説明しましたが、"}, {"type": "subtitle", "time": 3006.87, "timestamp": "00:50:06", "text": "さあ、早速ゲームを始めよう。 試合から退出してください"}, {"type": "subtitle", "time": 3009.99, "timestamp": "00:50:09", "text": "。 そのままにしておいて。 うん。   よし"}, {"type": "subtitle", "time": 3011.75, "timestamp": "00:50:11", "text": "。"}, {"type": "subtitle", "time": 3012.63, "timestamp": "00:50:12", "text": "クイックマッチ。 右。"}, {"type": "subtitle", "time": 3014.95, "timestamp": "00:50:14", "text": "よし、みんな。 わかったよ、チャド。"}, {"type": "subtitle", "time": 3017.03, "timestamp": "00:50:17", "text": "何分間話した後、ようやくゲームを始めるんですね"}, {"type": "subtitle", "time": 3018.39, "timestamp": "00:50:18", "text": "？"}, {"type": "subtitle", "time": 3020.79, "timestamp": "00:50:20", "text": "何でも。  50分。   ちくしょう"}, {"type": "subtitle", "time": 3023.43, "timestamp": "00:50:23", "text": "。  50分。 なんてこった。 私は"}, {"type": "subtitle", "time": 3025.19, "timestamp": "00:50:25", "text": "話していました。"}, {"type": "subtitle", "time": 3027.51, "timestamp": "00:50:27", "text": "大丈夫です。"}, {"type": "subtitle", "time": 3030.63, "timestamp": "00:50:30", "text": "待って。 えっと、どのサーバーを選べばいいですか？"}, {"type": "subtitle", "time": 3035.349, "timestamp": "00:50:35", "text": "ああ、どのサーバーでもいいよ。 ええと、あなたは東京を挙げましたね。"}, {"type": "subtitle", "time": 3037.51, "timestamp": "00:50:37", "text": "pingを取得します。 シンガポールを"}, {"type": "subtitle", "time": 3038.15, "timestamp": "00:50:38", "text": "自分のものにしよう。"}, {"type": "subtitle", "time": 3039.19, "timestamp": "00:50:39", "text": "シンガポール。"}, {"type": "subtitle", "time": 3040.47, "timestamp": "00:50:40", "text": "東京について。   ちょっと様子を見ていただけです"}, {"type": "subtitle", "time": 3047.91, "timestamp": "00:50:47", "text": "おい、それは人種差別だぞ。 私がそこに行くたびに、"}, {"type": "subtitle", "time": 3049.75, "timestamp": "00:50:49", "text": "人々は人種差別的な言動をしていた。   何てことだ"}, {"type": "subtitle", "time": 3052.549, "timestamp": "00:50:52", "text": "。"}, {"type": "subtitle", "time": 3054.309, "timestamp": "00:50:54", "text": "おい、あそこにいる全員が人種差別"}, {"type": "subtitle", "time": 3055.67, "timestamp": "00:50:55", "text": "主義者というわけではない。"}, {"type": "subtitle", "time": 3057.109, "timestamp": "00:50:57", "text": "私がランクマッチをプレイしていた時に出会った人のうち、一定数の人が人種差別"}, {"type": "subtitle", "time": 3059.43, "timestamp": "00:50:59", "text": "主義者だった。"}]
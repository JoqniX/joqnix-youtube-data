[{"type": "subtitle", "time": 7275.51, "timestamp": "02:01:15", "text": "３、２、１、ゴー。"}, {"type": "subtitle", "time": 7277.35, "timestamp": "02:01:17", "text": "えっと、ちなみに、もし"}, {"type": "subtitle", "time": 7291.189, "timestamp": "02:01:31", "text": "彼を気絶させようとしたのですか？"}, {"type": "subtitle", "time": 7295.91, "timestamp": "02:01:35", "text": "気絶させることに失敗した。 私は押さえつけられている。"}, {"type": "subtitle", "time": 7297.669, "timestamp": "02:01:37", "text": "どこ？"}, {"type": "subtitle", "time": 7300.229, "timestamp": "02:01:40", "text": "こちらです。"}]
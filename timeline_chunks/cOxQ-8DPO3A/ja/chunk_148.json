[{"type": "subtitle", "time": 8887.99, "timestamp": "02:28:07", "text": "頭を表す言葉は「犬」だ。 頭部だけを狙え"}, {"type": "subtitle", "time": 8898.63, "timestamp": "02:28:18", "text": "あなたのキャラクターは"}, {"type": "subtitle", "time": 8902.63, "timestamp": "02:28:22", "text": "将来、とてつもないダメージを与えるようになります。"}, {"type": "subtitle", "time": 8905.67, "timestamp": "02:28:25", "text": "将来はそうなるだろう、今ではない。"}, {"type": "subtitle", "time": 8910.07, "timestamp": "02:28:30", "text": "いいえ、"}, {"type": "subtitle", "time": 8926.15, "timestamp": "02:28:46", "text": "要点を押さえていますか？"}, {"type": "subtitle", "time": 8928.15, "timestamp": "02:28:48", "text": "そこにいるのは私たち4人ですか？"}, {"type": "subtitle", "time": 8930.15, "timestamp": "02:28:50", "text": "真実はどこにあるのか？   私たち"}, {"type": "subtitle", "time": 8937.349, "timestamp": "02:28:57", "text": "ああ、1人亡くなった。"}]
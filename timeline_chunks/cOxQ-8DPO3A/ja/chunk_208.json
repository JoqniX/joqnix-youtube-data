[{"type": "subtitle", "time": 12483.67, "timestamp": "03:28:03", "text": "。 私たちは友達です。 くそ。"}, {"type": "subtitle", "time": 12486.55, "timestamp": "03:28:06", "text": "私たちはただの友達です。 わかった。"}, {"type": "subtitle", "time": 12490.309, "timestamp": "03:28:10", "text": "そこまで頑張る必要があるんだ。 くそ。"}, {"type": "subtitle", "time": 12492.15, "timestamp": "03:28:12", "text": "もし明日ジョーが配信に来なかったら"}, {"type": "subtitle", "time": 12494.389, "timestamp": "03:28:14", "text": "、何が"}, {"type": "subtitle", "time": 12499.51, "timestamp": "03:28:19", "text": "おいおい、マジかよ。"}, {"type": "subtitle", "time": 12500.389, "timestamp": "03:28:20", "text": "おお。"}, {"type": "subtitle", "time": 12502.309, "timestamp": "03:28:22", "text": "俺の仲間は「今夜会おうぜ、パン」って言うんだ。"}, {"type": "subtitle", "time": 12504.15, "timestamp": "03:28:24", "text": "「うわ、"}, {"type": "subtitle", "time": 12509.03, "timestamp": "03:28:29", "text": "やれやれ。一体"}, {"type": "subtitle", "time": 12513.51, "timestamp": "03:28:33", "text": "何なんだ？ とにかく、とにかく、"}, {"type": "subtitle", "time": 12514.87, "timestamp": "03:28:34", "text": "配信を終えます。もう行きます。おやすみなさい"}, {"type": "subtitle", "time": 12516.71, "timestamp": "03:28:36", "text": "、友よ。おやすみなさい。こんにちは。おやすみなさい。気をつけて"}, {"type": "subtitle", "time": 12519.67, "timestamp": "03:28:39", "text": "。D。"}, {"type": "subtitle", "time": 12520.63, "timestamp": "03:28:40", "text": "全部終わったよ。じゃあね。"}, {"type": "subtitle", "time": 12522.55, "timestamp": "03:28:42", "text": "君もね。君もね。君もね。さよなら。さよなら。さよなら"}, {"type": "subtitle", "time": 12536.309, "timestamp": "03:28:56", "text": "今日はブラッド、一緒に盛り上げてくれてありがとう。"}, {"type": "subtitle", "time": 12539.6, "timestamp": "03:28:59", "text": "本当に楽しかったよ。"}]
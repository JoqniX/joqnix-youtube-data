[{"type": "subtitle", "time": 5345.75, "timestamp": "01:29:05", "text": "。"}, {"type": "subtitle", "time": 5347.35, "timestamp": "01:29:07", "text": "ええ、彼女はすぐそこにいますよ。"}, {"type": "subtitle", "time": 5348.07, "timestamp": "01:29:08", "text": "彼女を殺そうとする。"}, {"type": "subtitle", "time": 5349.27, "timestamp": "01:29:09", "text": "うん。 うん。 私はしようとしています。 私はしようとしています。 私はしようとしています"}, {"type": "subtitle", "time": 5355.11, "timestamp": "01:29:15", "text": "ああ、彼女はどうやってそれを失くしたの？"}, {"type": "subtitle", "time": 5357.91, "timestamp": "01:29:17", "text": "ああ、彼女は私を切りつけた。 彼女はひどく落ち込んでいた。"}, {"type": "subtitle", "time": 5360.629, "timestamp": "01:29:20", "text": "治療師は彼女を癒した。 いや、いや、彼女は"}, {"type": "subtitle", "time": 5364.709, "timestamp": "01:29:24", "text": "健康を奪って私を切り裂いたんだ。   何てことだ"}, {"type": "subtitle", "time": 5390.31, "timestamp": "01:29:50", "text": "彼らのうち誰かを撃つことはできますか？"}, {"type": "subtitle", "time": 5391.75, "timestamp": "01:29:51", "text": "あ、待って。"}]
[{"type": "subtitle", "time": 5946.709, "timestamp": "01:39:06", "text": "理由を知りたいですか？"}, {"type": "subtitle", "time": 5949.189, "timestamp": "01:39:09", "text": "戦車が来るぞ。 空飛ぶ戦車。 彼女をここで捕まえてみてください"}, {"type": "subtitle", "time": 5957.43, "timestamp": "01:39:17", "text": "捕まえたぞ。"}, {"type": "subtitle", "time": 5959.59, "timestamp": "01:39:19", "text": "ニース。   あそこに"}, {"type": "subtitle", "time": 5961.43, "timestamp": "01:39:21", "text": "ヒーラーがいる。 それを実現するために努力します"}, {"type": "subtitle", "time": 5994.79, "timestamp": "01:39:54", "text": "待って。 わかった。 待って。 焦ってはいけません。"}, {"type": "subtitle", "time": 5998.229, "timestamp": "01:39:58", "text": "彼らにあなたの中に入り込ませて、"}]
[{"type": "subtitle", "time": 2820.79, "timestamp": "00:47:00", "text": "特定のキャラクターやカウンターも"}, {"type": "subtitle", "time": 2825.27, "timestamp": "00:47:05", "text": "飛行能力を持っているということです。 空を飛ぶキャラクターは、"}, {"type": "subtitle", "time": 2827.109, "timestamp": "00:47:07", "text": "まず"}, {"type": "subtitle", "time": 2828.95, "timestamp": "00:47:08", "text": "あなたを狙って殺す必要があるからです。 しかも、狙いを定める必要もない"}, {"type": "subtitle", "time": 2830.95, "timestamp": "00:47:10", "text": "。 それが一番重要な点です。"}, {"type": "subtitle", "time": 2833.03, "timestamp": "00:47:13", "text": "そして彼は死んだ。"}, {"type": "subtitle", "time": 2835.43, "timestamp": "00:47:15", "text": "あなたが飛ばす花にとって最も手強いのは"}, {"type": "subtitle", "time": 2837.109, "timestamp": "00:47:17", "text": "アイアンマンです。なぜなら、"}, {"type": "subtitle", "time": 2843.589, "timestamp": "00:47:23", "text": "あなたが知っているように、右クリックで"}, {"type": "subtitle", "time": 2846.55, "timestamp": "00:47:26", "text": "大きなダメージを与えることができるからです。 ああ、つまり、彼を"}, {"type": "subtitle", "time": 2849.99, "timestamp": "00:47:29", "text": "殺そうとする時は、常に不意を突かなければならないということですね。 正面から"}, {"type": "subtitle", "time": 2851.99, "timestamp": "00:47:31", "text": "一対一で戦うのではなく、相手の不意を突くのだ"}, {"type": "subtitle", "time": 2854.15, "timestamp": "00:47:34", "text": "。"}, {"type": "subtitle", "time": 2857.03, "timestamp": "00:47:37", "text": "敵が我々を見つけた。 そう、あれが"}, {"type": "subtitle", "time": 2862.15, "timestamp": "00:47:42", "text": "飛行生物で、あぁ、この女の子を殺すのは簡単だ"}, {"type": "subtitle", "time": 2864.47, "timestamp": "00:47:44", "text": "。 つまり、物質が"}, {"type": "subtitle", "time": 2869.27, "timestamp": "00:47:49", "text": "ない。"}, {"type": "subtitle", "time": 2870.15, "timestamp": "00:47:50", "text": "ダブルキル。   まだ"}, {"type": "subtitle", "time": 2872.23, "timestamp": "00:47:52", "text": "HPが1つしか上がっていません。 よくできていない"}, {"type": "subtitle", "time": 2874.87, "timestamp": "00:47:54", "text": "。 あまり良くない。 あんな"}, {"type": "subtitle", "time": 2879.589, "timestamp": "00:47:59", "text": "混乱でそんなにダメージを受けるはずはないのに。"}]
[{"type": "subtitle", "time": 4502.229, "timestamp": "01:15:02", "text": "近日公開。 近日公開。 近日公開。 近日公開。"}, {"type": "subtitle", "time": 4505.51, "timestamp": "01:15:05", "text": "どの男？ 公園。"}, {"type": "subtitle", "time": 4506.79, "timestamp": "01:15:06", "text": "あいつらはもう死んでるんだよ、ジョー。   わかった"}, {"type": "subtitle", "time": 4511.91, "timestamp": "01:15:11", "text": "ほら、ボードを見てよ。 相手を"}, {"type": "subtitle", "time": 4513.669, "timestamp": "01:15:13", "text": "殺そうとする。 彼が見えるかい？"}, {"type": "subtitle", "time": 4516.55, "timestamp": "01:15:16", "text": "うん。 ベンダー。"}, {"type": "subtitle", "time": 4518.95, "timestamp": "01:15:18", "text": "捕まえたぞ。   ちなみに"}, {"type": "subtitle", "time": 4520.79, "timestamp": "01:15:20", "text": "、こっちの男です。 ああ、彼は"}, {"type": "subtitle", "time": 4523.27, "timestamp": "01:15:23", "text": "上手だよ。 私と来て。 私と来て。   ヒーラーを雇います"}, {"type": "subtitle", "time": 4525.189, "timestamp": "01:15:25", "text": "。  「了解"}, {"type": "subtitle", "time": 4527.03, "timestamp": "01:15:27", "text": "、了解です」という返事をもらっています"}, {"type": "subtitle", "time": 4534.87, "timestamp": "01:15:34", "text": "。"}, {"type": "subtitle", "time": 4547.27, "timestamp": "01:15:47", "text": "彼女は私のそばにいます。   わかった"}, {"type": "subtitle", "time": 4549.76, "timestamp": "01:15:49", "text": "。   わかった 。 ブラックパンサーがここにいる。 わかった。 私は"}, {"type": "subtitle", "time": 4552.08, "timestamp": "01:15:52", "text": "。 ブラックパンサーがここにいる。 わかった。 私は 歩いた。"}]
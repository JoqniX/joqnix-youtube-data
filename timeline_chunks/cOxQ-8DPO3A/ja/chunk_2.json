[{"type": "subtitle", "time": 124.789, "timestamp": "00:02:04", "text": "それはまずい。"}, {"type": "subtitle", "time": 127.27, "timestamp": "00:02:07", "text": "うん、まるでゲームが僕に"}, {"type": "subtitle", "time": 130.2, "timestamp": "00:02:10", "text": "プレイしてほしくないみたいだ。 なぜ？"}, {"type": "subtitle", "time": 132.15, "timestamp": "00:02:12", "text": "[音楽]"}, {"type": "subtitle", "time": 135.67, "timestamp": "00:02:15", "text": "クレイジーだよ、おい。 クレイジー。   信じられない"}, {"type": "subtitle", "time": 137.48, "timestamp": "00:02:17", "text": "。"}, {"type": "subtitle", "time": 141.51, "timestamp": "00:02:21", "text": "[音楽]"}, {"type": "subtitle", "time": 143.91, "timestamp": "00:02:23", "text": "Steamの問題かもしれない。Epic"}, {"type": "subtitle", "time": 148.39, "timestamp": "00:02:28", "text": "Games を使っても、時々うまくいかないことがあるから。"}, {"type": "subtitle", "time": 150.63, "timestamp": "00:02:30", "text": "Epic Gamesとかでダウンロードしたよ"}, {"type": "subtitle", "time": 153.82999999999998, "timestamp": "00:02:33", "text": "。 そう、Epic Gamesが"}, {"type": "subtitle", "time": 157.27, "timestamp": "00:02:37", "text": "機能しないなら、Moも機能しない。だから、"}, {"type": "subtitle", "time": 161.43, "timestamp": "00:02:41", "text": "ああ、"}, {"type": "subtitle", "time": 163.75, "timestamp": "00:02:43", "text": "少し時間がかかるかもしれないけど、"}, {"type": "subtitle", "time": 173.589, "timestamp": "00:02:53", "text": "あなたの一日はどうでした？"}, {"type": "subtitle", "time": 175.91, "timestamp": "00:02:55", "text": "今日はどんな一日だった？ それはまだ始まったばかりだ。 私は目が覚めた"}, {"type": "subtitle", "time": 176.949, "timestamp": "00:02:56", "text": "。   ほら"}, {"type": "subtitle", "time": 178.63, "timestamp": "00:02:58", "text": "、君にとっては午前0時じゃないんだから"}]
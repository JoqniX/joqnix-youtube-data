[{"type": "subtitle", "time": 10060.469, "timestamp": "02:47:40", "text": "わあ、120万回再生ですか。 聖なる。"}, {"type": "subtitle", "time": 10062.15, "timestamp": "02:47:42", "text": "うん。"}, {"type": "subtitle", "time": 10064.63, "timestamp": "02:47:44", "text": "ほら、自分のキャラクターが得意なことだけを選べば"}, {"type": "subtitle", "time": 10066.71, "timestamp": "02:47:46", "text": "、うまくいくんだよ"}, {"type": "subtitle", "time": 10067.11, "timestamp": "02:47:47", "text": "。"}, {"type": "subtitle", "time": 10069.349, "timestamp": "02:47:49", "text": "待って、もしかして私は他の人より被害が少ないの"}, {"type": "subtitle", "time": 10071.19, "timestamp": "02:47:51", "text": "？"}, {"type": "subtitle", "time": 10072.71, "timestamp": "02:47:52", "text": "はい、そうです。"}, {"type": "subtitle", "time": 10075.75, "timestamp": "02:47:55", "text": "どうやって？"}, {"type": "subtitle", "time": 10076.95, "timestamp": "02:47:56", "text": "赤色だけを選んでください。"}]
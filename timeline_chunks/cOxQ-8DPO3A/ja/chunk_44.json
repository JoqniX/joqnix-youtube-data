[{"type": "subtitle", "time": 2642.309, "timestamp": "00:44:02", "text": "プレイ中はかなり相性が良いです。なぜなら、私がこれ"}, {"type": "subtitle", "time": 2646.95, "timestamp": "00:44:06", "text": "まで見てきた限り、スカーレットピッチャーがいるかどうかはわかりません。 対処するのがかなり面倒だ。"}, {"type": "subtitle", "time": 2650.79, "timestamp": "00:44:10", "text": "2つ目はホーさんですが、"}, {"type": "subtitle", "time": 2653.19, "timestamp": "00:44:13", "text": "なぜスカーレット・"}, {"type": "subtitle", "time": 2654.63, "timestamp": "00:44:14", "text": "ウィッチが良い人間だと決めつけるのですか？ 君は「こっちへ"}, {"type": "subtitle", "time": 2656.39, "timestamp": "00:44:16", "text": "来い」みたいな最前線のキャラクターじゃないってことだね"}, {"type": "subtitle", "time": 2658.069, "timestamp": "00:44:18", "text": "。"}, {"type": "subtitle", "time": 2660.309, "timestamp": "00:44:20", "text": "それでは、またね"}, {"type": "subtitle", "time": 2662.79, "timestamp": "00:44:22", "text": "？ あなたは最前線にいるような人ではない。"}, {"type": "subtitle", "time": 2667.589, "timestamp": "00:44:27", "text": "ハルクについて少しお話しましょう。"}, {"type": "subtitle", "time": 2669.349, "timestamp": "00:44:29", "text": "このキャラクターは人々を孤立させるように設計されている"}, {"type": "subtitle", "time": 2671.03, "timestamp": "00:44:31", "text": "。"}, {"type": "subtitle", "time": 2671.91, "timestamp": "00:44:31", "text": "ああ、"}, {"type": "subtitle", "time": 2673.829, "timestamp": "00:44:33", "text": "彼は孤立しようとしているんだね。 まあ、あそこにいる"}, {"type": "subtitle", "time": 2676.47, "timestamp": "00:44:36", "text": "男はヒーラーだとしましょう。"}, {"type": "subtitle", "time": 2677.51, "timestamp": "00:44:37", "text": "いいですか、"}, {"type": "subtitle", "time": 2680.47, "timestamp": "00:44:40", "text": "聞いてください。 ここを見てください。 この男はヒーラーだ。"}, {"type": "subtitle", "time": 2682.55, "timestamp": "00:44:42", "text": "彼がやろうとしていることは、彼が遠く離れているということだ。"}, {"type": "subtitle", "time": 2686.069, "timestamp": "00:44:46", "text": "彼は飛び込んで、あるいはただ飛び込んで、標的を孤立させて"}, {"type": "subtitle", "time": 2690.39, "timestamp": "00:44:50", "text": "殺そうとする。 スカーレット・ウィッチとしてプレイする場合、"}, {"type": "subtitle", "time": 2692.309, "timestamp": "00:44:52", "text": "2 種類のスキルが"}, {"type": "subtitle", "time": 2694.47, "timestamp": "00:44:54", "text": "プレイされます。"}, {"type": "subtitle", "time": 2695.589, "timestamp": "00:44:55", "text": "このキャラクターにはプレイ スタイルがあります。"}, {"type": "subtitle", "time": 2697.109, "timestamp": "00:44:57", "text": "スカーレットリッジでは、複数のプレイヤーの役割があります。"}]
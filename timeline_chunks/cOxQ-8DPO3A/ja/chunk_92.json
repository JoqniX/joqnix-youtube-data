[{"type": "subtitle", "time": 5535.27, "timestamp": "01:32:15", "text": "さようなら。"}, {"type": "subtitle", "time": 5536.87, "timestamp": "01:32:16", "text": "ああ、"}, {"type": "subtitle", "time": 5549.99, "timestamp": "01:32:29", "text": "メイト全員が"}, {"type": "subtitle", "time": 5552.07, "timestamp": "01:32:32", "text": "死んでしまったのに、君は4人の中に飛び込んだようなものだ。"}, {"type": "subtitle", "time": 5555.51, "timestamp": "01:32:35", "text": "彼らは死んだ。"}, {"type": "subtitle", "time": 5558.07, "timestamp": "01:32:38", "text": "あなたは時々スコアボードを見ますか？"}, {"type": "subtitle", "time": 5560.47, "timestamp": "01:32:40", "text": "たまにタブキーを押しますか？"}, {"type": "subtitle", "time": 5562.629, "timestamp": "01:32:42", "text": "いいえ。私のことを恐れる理由はありません。"}, {"type": "subtitle", "time": 5565.27, "timestamp": "01:32:45", "text": "ああ、なんてことだ。 ああ、神様。 彼はただ「"}, {"type": "subtitle", "time": 5567.03, "timestamp": "01:32:47", "text": "捕まえたぞ」と言い続けるだけだよ。 なんてこった。 棒"}, {"type": "subtitle", "time": 5573.27, "timestamp": "01:32:53", "text": "。"}, {"type": "subtitle", "time": 5575.99, "timestamp": "01:32:55", "text": "攻撃する前に、準備をせよ。"}, {"type": "subtitle", "time": 5578.07, "timestamp": "01:32:58", "text": "そうそう。"}]
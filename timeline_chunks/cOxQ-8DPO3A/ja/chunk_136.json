[{"type": "subtitle", "time": 8162.31, "timestamp": "02:16:02", "text": "カードスト。"}, {"type": "subtitle", "time": 8163.99, "timestamp": "02:16:03", "text": "あなたはカードを通して能力を得ます。   そのうち分かるよ"}, {"type": "subtitle", "time": 8165.189, "timestamp": "02:16:05", "text": "。"}, {"type": "subtitle", "time": 8168.629, "timestamp": "02:16:08", "text": "お前には一つだけ任務がある。私の拳だ。"}, {"type": "subtitle", "time": 8172.55, "timestamp": "02:16:12", "text": "死者の女王を見つけ出し、彼女を倒せ。 でも"}, {"type": "subtitle", "time": 8174.069, "timestamp": "02:16:14", "text": "、このゲームモードに最適なキャラクターは"}, {"type": "subtitle", "time": 8175.99, "timestamp": "02:16:15", "text": "ブレイドだけど、俺たちは"}, {"type": "subtitle", "time": 8197.19, "timestamp": "02:16:37", "text": "全部買いました。   前に"}, {"type": "subtitle", "time": 8199.429, "timestamp": "02:16:39", "text": "言ったように、赤いカードしか買わなかった。"}, {"type": "subtitle", "time": 8201.11, "timestamp": "02:16:41", "text": "更新することもできます。 ちなみに、その"}, {"type": "subtitle", "time": 8203.75, "timestamp": "02:16:43", "text": "ページ。"}, {"type": "subtitle", "time": 8206.629, "timestamp": "02:16:46", "text": "ああ、それは知らなかったんですね"}, {"type": "subtitle", "time": 8215.83, "timestamp": "02:16:55", "text": "これには色は関係ない。"}, {"type": "subtitle", "time": 8217.03, "timestamp": "02:16:57", "text": "何のために色を使うのか？"}]
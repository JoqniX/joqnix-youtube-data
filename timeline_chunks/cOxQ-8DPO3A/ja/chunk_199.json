[{"type": "subtitle", "time": 11941.19, "timestamp": "03:19:01", "text": "うん。"}, {"type": "subtitle", "time": 11947.67, "timestamp": "03:19:07", "text": "私のシェーダーは正常に動作しています。"}, {"type": "subtitle", "time": 11952.71, "timestamp": "03:19:12", "text": "81番目のニッシュです。 おお。 私たちは3時間くらいプレイしました"}, {"type": "subtitle", "time": 11955.03, "timestamp": "03:19:15", "text": "。 うん"}, {"type": "subtitle", "time": 11956.63, "timestamp": "03:19:16", "text": "。"}, {"type": "subtitle", "time": 11958.469, "timestamp": "03:19:18", "text": "くそ。"}, {"type": "subtitle", "time": 11958.87, "timestamp": "03:19:18", "text": "ニース。"}, {"type": "subtitle", "time": 11962.309, "timestamp": "03:19:22", "text": "希望すれば、ついにハードモードを見ることができます。"}, {"type": "subtitle", "time": 11965.59, "timestamp": "03:19:25", "text": "悪夢が好きかどうかはわからない。 これは"}, {"type": "subtitle", "time": 11967.83, "timestamp": "03:19:27", "text": "悪夢なのか？ それは何だったのか？"}, {"type": "subtitle", "time": 11972.229, "timestamp": "03:19:32", "text": "この極端な状況の次は一体何だったのか、あるいは私たちは極端なことをしたのか？"}, {"type": "subtitle", "time": 11973.83, "timestamp": "03:19:33", "text": "ええ、私たちはエクストリームに挑戦しました。 これは悪夢その"}, {"type": "subtitle", "time": 11975.99, "timestamp": "03:19:35", "text": "1だ。"}, {"type": "subtitle", "time": 11978.309, "timestamp": "03:19:38", "text": "ああ、悪夢はもっと"}, {"type": "subtitle", "time": 11979.75, "timestamp": "03:19:39", "text": "難しい。"}, {"type": "subtitle", "time": 11982.71, "timestamp": "03:19:42", "text": "それが本当の鎮痛剤だ。"}, {"type": "subtitle", "time": 11985.75, "timestamp": "03:19:45", "text": "私は自分の"}, {"type": "subtitle", "time": 11989.67, "timestamp": "03:19:49", "text": "意見を述べました。 わかった。"}, {"type": "subtitle", "time": 11994.309, "timestamp": "03:19:54", "text": "全ての特性を最大値まで上げたらどうなりますか？   それは"}, {"type": "subtitle", "time": 11996.95, "timestamp": "03:19:56", "text": "すべて、さらなるダメージ、つまりさらなる"}, {"type": "subtitle", "time": 11998.229, "timestamp": "03:19:58", "text": "ダメージに過ぎない。"}]
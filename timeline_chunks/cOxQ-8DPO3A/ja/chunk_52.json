[{"type": "subtitle", "time": 3120.71, "timestamp": "00:52:00", "text": "それはまるで爆発のようで、"}, {"type": "subtitle", "time": 3122.71, "timestamp": "00:52:02", "text": "とても大きなダメージです。 わからない。"}, {"type": "subtitle", "time": 3125.43, "timestamp": "00:52:05", "text": "それは非常に大きな損害を与える。"}, {"type": "subtitle", "time": 3128.63, "timestamp": "00:52:08", "text": "つまり、右クリックで撃つと、"}, {"type": "subtitle", "time": 3132.63, "timestamp": "00:52:12", "text": "手動で撃つのではなく、"}, {"type": "subtitle", "time": 3135.03, "timestamp": "00:52:15", "text": "自動的に発射されるということです。"}, {"type": "subtitle", "time": 3137.589, "timestamp": "00:52:17", "text": "ああ、"}, {"type": "subtitle", "time": 3139.03, "timestamp": "00:52:19", "text": "左クリックと同じです。 左"}, {"type": "subtitle", "time": 3140.309, "timestamp": "00:52:20", "text": "クリックは同じですが、右クリックは"}, {"type": "subtitle", "time": 3141.99, "timestamp": "00:52:21", "text": "異なります。"}, {"type": "subtitle", "time": 3143.349, "timestamp": "00:52:23", "text": "あなたがすべきことは、"}, {"type": "subtitle", "time": 3146.23, "timestamp": "00:52:26", "text": "任務エリアを占領することだけです。 わかった。"}, {"type": "subtitle", "time": 3147.589, "timestamp": "00:52:27", "text": "これが何なのか、お分かりですよね？ まるで拠点を"}, {"type": "subtitle", "time": 3150.39, "timestamp": "00:52:30", "text": "奪取するキング・オブ・ザ・ヒルみたいだ。 君も"}, {"type": "subtitle", "time": 3151.75, "timestamp": "00:52:31", "text": "この"}, {"type": "subtitle", "time": 3159.75, "timestamp": "00:52:39", "text": "ああ、あれは橋だ。"}, {"type": "subtitle", "time": 3161.75, "timestamp": "00:52:41", "text": "うん。 右へ進んで、側面から攻撃を仕掛けてみてください"}, {"type": "subtitle", "time": 3164.069, "timestamp": "00:52:44", "text": "。 右へ進んでください。 私が手伝います"}, {"type": "subtitle", "time": 3165.43, "timestamp": "00:52:45", "text": "。 ちなみに、あなたの後ろにいますよ。"}, {"type": "subtitle", "time": 3166.95, "timestamp": "00:52:46", "text": "あなたの後ろにいます。 個性がある。 あなたは"}, {"type": "subtitle", "time": 3169.19, "timestamp": "00:52:49", "text": "彼を見ていない。 そうだね。"}, {"type": "subtitle", "time": 3170.71, "timestamp": "00:52:50", "text": "パニッシャーを殺そうとする。 こちらの処刑人を殺してみろ"}, {"type": "subtitle", "time": 3171.67, "timestamp": "00:52:51", "text": "。   どうやら"}, {"type": "subtitle", "time": 3175.829, "timestamp": "00:52:55", "text": "キャプチャが成功したようだ。"}, {"type": "subtitle", "time": 3178.309, "timestamp": "00:52:58", "text": "あなたは遊び方を全く知らない。 それは"}]
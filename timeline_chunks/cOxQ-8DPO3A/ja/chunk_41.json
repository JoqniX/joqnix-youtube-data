[{"type": "subtitle", "time": 2467.67, "timestamp": "00:41:07", "text": "はい、私のHPは低かったのですが、それでもあなたの"}, {"type": "subtitle", "time": 2470.23, "timestamp": "00:41:10", "text": "HPは低かったです。 マジかよ、おい。 君は悪い人だ。   お前は"}, {"type": "subtitle", "time": 2475.43, "timestamp": "00:41:15", "text": "。"}, {"type": "subtitle", "time": 2477.03, "timestamp": "00:41:17", "text": "あなたは学ぶでしょう。 遊びながら学べますよ"}, {"type": "subtitle", "time": 2479.349, "timestamp": "00:41:19", "text": "。 あなたは学ぶでしょう。 わかった。  1、2、3、ゴー。"}, {"type": "subtitle", "time": 2481.75, "timestamp": "00:41:21", "text": "消えゆくもの。   一体どこに行ったんだ"}, {"type": "subtitle", "time": 2489.03, "timestamp": "00:41:29", "text": "消えていく時に、あなたも消えていく必要はないのよ"}, {"type": "subtitle", "time": 2491.43, "timestamp": "00:41:31", "text": "。あなた自身でそれを維持できるんだから。"}, {"type": "subtitle", "time": 2492.069, "timestamp": "00:41:32", "text": "ああ、それは"}, {"type": "subtitle", "time": 2496.87, "timestamp": "00:41:36", "text": "フェードインを使う必要がある状況です。"}, {"type": "subtitle", "time": 2502.87, "timestamp": "00:41:42", "text": "私を殴り始めるようなさまざまな状況です。  1 2 3 は進みますか。"}, {"type": "subtitle", "time": 2506.63, "timestamp": "00:41:46", "text": "あなたは私の魔法にかかっている。"}, {"type": "subtitle", "time": 2508.069, "timestamp": "00:41:48", "text": "そちらはだんだん少なくなってきているよ。"}, {"type": "subtitle", "time": 2509.589, "timestamp": "00:41:49", "text": "フェードをもう一度使うこともできますが、あなたはそうしませんでした"}, {"type": "subtitle", "time": 2510.309, "timestamp": "00:41:50", "text": "。"}, {"type": "subtitle", "time": 2512.39, "timestamp": "00:41:52", "text": "ええ、"}, {"type": "subtitle", "time": 2513.829, "timestamp": "00:41:53", "text": "そうですね、"}, {"type": "subtitle", "time": 2515.51, "timestamp": "00:41:55", "text": "消えることのない別のキャラクターを選びましょう。"}]
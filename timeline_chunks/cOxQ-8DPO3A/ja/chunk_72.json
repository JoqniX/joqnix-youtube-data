[{"type": "subtitle", "time": 4325.59, "timestamp": "01:12:05", "text": "彼を殺そうとしている。 彼を殺そうとする。"}, {"type": "subtitle", "time": 4327.11, "timestamp": "01:12:07", "text": "BPを殺そうと試みてください。"}, {"type": "subtitle", "time": 4338.31, "timestamp": "01:12:18", "text": "ベンダー。 ベンダー。 死ぬ。"}, {"type": "subtitle", "time": 4340.229, "timestamp": "01:12:20", "text": "私が彼を殺した。 私はもう一人を殺した"}, {"type": "subtitle", "time": 4341.27, "timestamp": "01:12:21", "text": "。 もう一人を殺した。 もう一人の"}, {"type": "subtitle", "time": 4342.39, "timestamp": "01:12:22", "text": "男。 もう一人の男。 もう一人の男。 そいつを捕まえたぞ"}, {"type": "subtitle", "time": 4354.149, "timestamp": "01:12:34", "text": "。 私はまだ元気です。 消え去る"}, {"type": "subtitle", "time": 4355.83, "timestamp": "01:12:35", "text": "。 消え去る。 消え去る。 消え去る。   わからない"}, {"type": "subtitle", "time": 4367.11, "timestamp": "01:12:47", "text": "HPが残っていないなら、戦うなよ。   一体"}, {"type": "subtitle", "time": 4368.47, "timestamp": "01:12:48", "text": "どういうことだ？"}]
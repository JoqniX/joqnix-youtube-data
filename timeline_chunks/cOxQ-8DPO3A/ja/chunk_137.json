[{"type": "subtitle", "time": 8220.87, "timestamp": "02:17:00", "text": "ゾンビには色分けがされる予定だと彼らは言っていた。"}, {"type": "subtitle", "time": 8222.23, "timestamp": "02:17:02", "text": "私がいつそんなことを言った？"}, {"type": "subtitle", "time": 8230.469, "timestamp": "02:17:10", "text": "なぜゾンビに色をつける必要があるのか"}, {"type": "subtitle", "time": 8232.23, "timestamp": "02:17:12", "text": "？"}, {"type": "subtitle", "time": 8235.11, "timestamp": "02:17:15", "text": "えっと、どのゾンビを倒せばいいかとかはわかってるよ"}, {"type": "subtitle", "time": 8236.389, "timestamp": "02:17:16", "text": "。"}, {"type": "subtitle", "time": 8238.469, "timestamp": "02:17:18", "text": "えっと、画面に映ってる私、ゾンビみたいに見えますか"}, {"type": "subtitle", "time": 8240.709, "timestamp": "02:17:20", "text": "？"}, {"type": "subtitle", "time": 8241.19, "timestamp": "02:17:21", "text": "こんにちは。"}, {"type": "subtitle", "time": 8242.709, "timestamp": "02:17:22", "text": "何？ それはどういう意味ですか、"}, {"type": "subtitle", "time": 8249.99, "timestamp": "02:17:29", "text": "君はまるで盲目人間みたいに、"}, {"type": "subtitle", "time": 8252.549, "timestamp": "02:17:32", "text": "ゾンビがどんな姿をしているか見えないのか"}, {"type": "subtitle", "time": 8254.95, "timestamp": "02:17:34", "text": "？   何てことだ"}, {"type": "subtitle", "time": 8260.07, "timestamp": "02:17:40", "text": "。 わかった。 えっと、更新してください。"}, {"type": "subtitle", "time": 8262.79, "timestamp": "02:17:42", "text": "紫色もありますよ。"}, {"type": "subtitle", "time": 8267.589, "timestamp": "02:17:47", "text": "そう、"}]
[{"type": "subtitle", "time": 1621.19, "timestamp": "00:27:01", "text": "追いかけてくる敵を気絶させるかのどちらかに使うんだ。"}, {"type": "subtitle", "time": 1624.789, "timestamp": "00:27:04", "text": "スタン効果があるので、様々な場面で使用できます。 それは多くのことを阻止できる"}, {"type": "subtitle", "time": 1627.19, "timestamp": "00:27:07", "text": "。   えっと、"}, {"type": "subtitle", "time": 1635.99, "timestamp": "00:27:15", "text": "私たちの親族が私たちを見つけたと思うんです。   まあ、"}, {"type": "subtitle", "time": 1638.39, "timestamp": "00:27:18", "text": "ドクター・ストレンジは"}, {"type": "subtitle", "time": 1641.19, "timestamp": "00:27:21", "text": "全員から選ばれると言っておきましょう。 じゃあ、私の足元で私を驚かせてください。 わかった。   この辺りのどこかにあるような"}, {"type": "subtitle", "time": 1644.23, "timestamp": "00:27:24", "text": "。   以上です。   わかった"}, {"type": "subtitle", "time": 1648.789, "timestamp": "00:27:28", "text": "。 どうでも。 わかった。 とにかく気絶させてください"}, {"type": "subtitle", "time": 1651.909, "timestamp": "00:27:31", "text": "。 ああ、そうだった。 例えば、私が"}, {"type": "subtitle", "time": 1653.99, "timestamp": "00:27:33", "text": "あなたに近づこうとしているときにそうする、そして、わかった、"}, {"type": "subtitle", "time": 1657.35, "timestamp": "00:27:37", "text": "あなたはそれをやめてもいい。 あなたは"}, {"type": "subtitle", "time": 1659.35, "timestamp": "00:27:39", "text": "2つのことをすることができます。"}, {"type": "subtitle", "time": 1662.07, "timestamp": "00:27:42", "text": "自分を守るために移動するか、相手を気絶させながら"}, {"type": "subtitle", "time": 1664.87, "timestamp": "00:27:44", "text": "同時に移動するかのどちらかです。これで脱出できました。"}, {"type": "subtitle", "time": 1669.51, "timestamp": "00:27:49", "text": "右。"}, {"type": "subtitle", "time": 1670.31, "timestamp": "00:27:50", "text": "避難せよ。 うん。"}, {"type": "subtitle", "time": 1672.07, "timestamp": "00:27:52", "text": "だから、その"}, {"type": "subtitle", "time": 1678.87, "timestamp": "00:27:58", "text": "時までには、オーケー。"}, {"type": "subtitle", "time": 1679.43, "timestamp": "00:27:59", "text": "うん。"}]
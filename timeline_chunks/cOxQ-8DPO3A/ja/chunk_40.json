[{"type": "subtitle", "time": 2405.99, "timestamp": "00:40:05", "text": "あのね？ じゃあ、私と1対1でアメリカと通話してみようかな"}, {"type": "subtitle", "time": 2409.51, "timestamp": "00:40:09", "text": "。 わかった。  ３、２、１、"}, {"type": "subtitle", "time": 2411.51, "timestamp": "00:40:11", "text": "ゴー。   それでは、また。"}, {"type": "subtitle", "time": 2421.349, "timestamp": "00:40:21", "text": "ああ、もっとついていけるように学んで。"}, {"type": "subtitle", "time": 2423.27, "timestamp": "00:40:23", "text": "ついていく必要があるし、右クリックを忘れてはいけない"}, {"type": "subtitle", "time": 2424.63, "timestamp": "00:40:24", "text": "。 ちなみに、右クリックはかなり簡単に"}, {"type": "subtitle", "time": 2425.51, "timestamp": "00:40:25", "text": "押せますよ。"}, {"type": "subtitle", "time": 2427.51, "timestamp": "00:40:27", "text": "私の時間を無駄にした。 そして、それは始まった。   一種の範囲"}, {"type": "subtitle", "time": 2429.349, "timestamp": "00:40:29", "text": "攻撃みたいなものだ。"}, {"type": "subtitle", "time": 2430.71, "timestamp": "00:40:30", "text": "知らなければ、覚えていない。   範囲攻撃。 わかった"}, {"type": "subtitle", "time": 2432.71, "timestamp": "00:40:32", "text": "。"}, {"type": "subtitle", "time": 2436.47, "timestamp": "00:40:36", "text": "君が立っている場所から爆弾を撃つことはできないよ"}, {"type": "subtitle", "time": 2437.829, "timestamp": "00:40:37", "text": "。   それでも"}, {"type": "subtitle", "time": 2440.39, "timestamp": "00:40:40", "text": "彼らには影響が及ぶだろう。"}, {"type": "subtitle", "time": 2442.23, "timestamp": "00:40:42", "text": "混沌の中から生まれ変わった。"}, {"type": "subtitle", "time": 2444.95, "timestamp": "00:40:44", "text": "それに、君の武器の射程距離は"}, {"type": "subtitle", "time": 2448.63, "timestamp": "00:40:48", "text": "20メートルくらいだよ。いや、いや、左クリックだと18メートルくらいだよ"}, {"type": "subtitle", "time": 2450.63, "timestamp": "00:40:50", "text": "。"}, {"type": "subtitle", "time": 2451.03, "timestamp": "00:40:51", "text": "ああ、ほら"}, {"type": "subtitle", "time": 2453.03, "timestamp": "00:40:53", "text": "、君もこれに慣れるよ。それに、1対1で、"}, {"type": "subtitle", "time": 2456.87, "timestamp": "00:40:56", "text": "今僕と目を合わせ、1対1で戦うことに慣れるだろうからね"}]
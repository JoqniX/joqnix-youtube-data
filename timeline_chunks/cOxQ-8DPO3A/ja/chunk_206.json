[{"type": "subtitle", "time": 12361.99, "timestamp": "03:26:01", "text": "まあ、お招きいただき、ありがとうございます"}, {"type": "subtitle", "time": 12363.51, "timestamp": "03:26:03", "text": "。"}, {"type": "subtitle", "time": 12370.469, "timestamp": "03:26:10", "text": "ゲームのやり方を教えてくれてありがとう。"}, {"type": "subtitle", "time": 12373.19, "timestamp": "03:26:13", "text": "あなたは何も得られなかった。 君が全く理解できなかったのは分かっているよ"}, {"type": "subtitle", "time": 12376.95, "timestamp": "03:26:16", "text": "。"}, {"type": "subtitle", "time": 12380.07, "timestamp": "03:26:20", "text": "それは本当です。 うん。"}, {"type": "subtitle", "time": 12384.229, "timestamp": "03:26:24", "text": "いろいろなことが起こっている。 まあ、そうですね。"}, {"type": "subtitle", "time": 12386.63, "timestamp": "03:26:26", "text": "うん。 どうしてそう思わないのか理解できません。テンポの"}, {"type": "subtitle", "time": 12388.469, "timestamp": "03:26:28", "text": "速い"}, {"type": "subtitle", "time": 12390.71, "timestamp": "03:26:30", "text": "ゲームのようなものだと思っていました。 わかった。 ジョックはテンポの速い"}, {"type": "subtitle", "time": 12393.349, "timestamp": "03:26:33", "text": "ゲームが得意だ。 お前は何も分かってない。 え、"}, {"type": "subtitle", "time": 12395.429, "timestamp": "03:26:35", "text": "何？"}, {"type": "subtitle", "time": 12397.429, "timestamp": "03:26:37", "text": "敵がどこにいるのか分からないような感じだ"}, {"type": "subtitle", "time": 12400.95, "timestamp": "03:26:40", "text": "。 世界のどこかで、実に多くの出来事が起こっている"}, {"type": "subtitle", "time": 12402.15, "timestamp": "03:26:42", "text": "。"}, {"type": "subtitle", "time": 12403.83, "timestamp": "03:26:43", "text": "あなたは知らない。 敵がどこにいるのか分からない"}, {"type": "subtitle", "time": 12406.63, "timestamp": "03:26:46", "text": "。 彼らの出現"}, {"type": "subtitle", "time": 12408.71, "timestamp": "03:26:48", "text": "地点は我々の出現地点とは反対側にあるので、彼らは"}, {"type": "subtitle", "time": 12410.469, "timestamp": "03:26:50", "text": "常に反対側からやってくることになる"}, {"type": "subtitle", "time": 12412.229, "timestamp": "03:26:52", "text": "。"}, {"type": "subtitle", "time": 12414.389, "timestamp": "03:26:54", "text": "うん。"}, {"type": "subtitle", "time": 12419.59, "timestamp": "03:26:59", "text": "科学だ。 君はオーバーウォッチをプレイするんだね。 だって、"}]
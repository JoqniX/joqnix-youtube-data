[{"type": "subtitle", "time": 840.949, "timestamp": "00:14:00", "text": "頭を撃つのではない。 どちらのダメージも、つまり"}, {"type": "subtitle", "time": 841.91, "timestamp": "00:14:01", "text": "、この"}, {"type": "subtitle", "time": 844.87, "timestamp": "00:14:04", "text": "ダメージで殺されるということです。"}, {"type": "subtitle", "time": 846.47, "timestamp": "00:14:06", "text": "これで３つ目だ。"}, {"type": "subtitle", "time": 848.23, "timestamp": "00:14:08", "text": "たとえショットを当てられなくても、"}, {"type": "subtitle", "time": 850.71, "timestamp": "00:14:10", "text": "十分な"}, {"type": "subtitle", "time": 852.87, "timestamp": "00:14:12", "text": "ダメージを与えることはできるでしょう。 それに、あのオルタナティブユニバースもすごくいいんだよ"}, {"type": "subtitle", "time": 855.189, "timestamp": "00:14:15", "text": "。   まるで"}, {"type": "subtitle", "time": 857.75, "timestamp": "00:14:17", "text": "爆発的なダメージのようだ。"}, {"type": "subtitle", "time": 865.269, "timestamp": "00:14:25", "text": "ゲーム「[Music]」に信じられないほどのダメージが急増しました。"}, {"type": "subtitle", "time": 868.15, "timestamp": "00:14:28", "text": "ミニガンですよね？"}, {"type": "subtitle", "time": 869.509, "timestamp": "00:14:29", "text": "SC。 うん。"}, {"type": "subtitle", "time": 870.15, "timestamp": "00:14:30", "text": "ダブルキル。"}, {"type": "subtitle", "time": 872.949, "timestamp": "00:14:32", "text": "これはかなりの損害だ。"}, {"type": "subtitle", "time": 877.03, "timestamp": "00:14:37", "text": "誰も個人的にはこれに耐えられない。"}, {"type": "subtitle", "time": 878.389, "timestamp": "00:14:38", "text": "でも、確かにそうですね。"}, {"type": "subtitle", "time": 881.269, "timestamp": "00:14:41", "text": "簡単に反撃できます。"}, {"type": "subtitle", "time": 884.47, "timestamp": "00:14:44", "text": "非常に簡単に反撃できます。お見せしましょう"}, {"type": "subtitle", "time": 889.189, "timestamp": "00:14:49", "text": "。 えっと、"}, {"type": "subtitle", "time": 891.75, "timestamp": "00:14:51", "text": "自分のキャラクターを覚えておかないといけないからだと思う。"}, {"type": "subtitle", "time": 896.87, "timestamp": "00:14:56", "text": "あ、味方からの攻撃もあるよ。"}, {"type": "subtitle", "time": 898.949, "timestamp": "00:14:58", "text": "あなたは人々の声を聞いた。 何てことだ。"}]
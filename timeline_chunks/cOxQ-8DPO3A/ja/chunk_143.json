[{"type": "subtitle", "time": 8580.389, "timestamp": "02:23:00", "text": "私はリフレッシュして、"}, {"type": "subtitle", "time": 8582.55, "timestamp": "02:23:02", "text": "あらゆるものを選び取っているような気分です。   ちなみに、"}, {"type": "subtitle", "time": 8585.67, "timestamp": "02:23:05", "text": "私も同じことをしています。"}, {"type": "subtitle", "time": 8587.03, "timestamp": "02:23:07", "text": "私はイカを"}, {"type": "subtitle", "time": 8590.15, "timestamp": "02:23:10", "text": "撃つ。 彼は"}, {"type": "subtitle", "time": 8594.63, "timestamp": "02:23:14", "text": "イカを投げている。 イカは文字通り、あなたが手に入れた場所で"}, {"type": "subtitle", "time": 8609.11, "timestamp": "02:23:29", "text": "64 HP を見たけど、何？"}, {"type": "subtitle", "time": 8610.389, "timestamp": "02:23:30", "text": "ゾンビゲームをプレイしたことがないのですか"}, {"type": "subtitle", "time": 8610.95, "timestamp": "02:23:30", "text": "？"}, {"type": "subtitle", "time": 8613.83, "timestamp": "02:23:33", "text": "いいえ。"}, {"type": "subtitle", "time": 8614.71, "timestamp": "02:23:34", "text": "私はそもそも"}, {"type": "subtitle", "time": 8616.309, "timestamp": "02:23:36", "text": "ゾンビゲームをプレイしたことが一度もない。"}, {"type": "subtitle", "time": 8621.59, "timestamp": "02:23:41", "text": "あなたはコール オブ デューティをプレイしますか？"}, {"type": "subtitle", "time": 8623.91, "timestamp": "02:23:43", "text": "いいえ。 まだコールオブデューティのゾンビモードすらプレイしていない"}, {"type": "subtitle", "time": 8625.19, "timestamp": "02:23:45", "text": "。"}]
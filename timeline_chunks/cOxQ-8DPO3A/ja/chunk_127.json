[{"type": "subtitle", "time": 7621.35, "timestamp": "02:07:01", "text": "フェードアップさせろ。   わかった"}, {"type": "subtitle", "time": 7622.87, "timestamp": "02:07:02", "text": "。 わかった。"}, {"type": "subtitle", "time": 7623.589, "timestamp": "02:07:03", "text": "大丈夫？"}, {"type": "subtitle", "time": 7633.83, "timestamp": "02:07:13", "text": "ああ、くそ。 私はバカだ。"}, {"type": "subtitle", "time": 7634.87, "timestamp": "02:07:14", "text": "あなたにはすべてがあります。"}, {"type": "subtitle", "time": 7637.51, "timestamp": "02:07:17", "text": "彼は私に飛びかかってきた。"}, {"type": "subtitle", "time": 7639.99, "timestamp": "02:07:19", "text": "彼はあなたに飛びかかってきた。 彼はあなたに向かって突進してきた。"}, {"type": "subtitle", "time": 7641.35, "timestamp": "02:07:21", "text": "ああ、がっかりしたよ。"}, {"type": "subtitle", "time": 7644.79, "timestamp": "02:07:24", "text": "私は二度と同じ過ちを繰り返さない。"}, {"type": "subtitle", "time": 7669.51, "timestamp": "02:07:49", "text": "彼を殺せますか？ それを殺せ。 これを殺せ。"}, {"type": "subtitle", "time": 7678.55, "timestamp": "02:07:58", "text": "保持する必要はなかったけど、まあいいか。"}]
[{"type": "subtitle", "time": 11177.51, "timestamp": "03:06:17", "text": "10点満点、神だ。 私の健康状態を見てください。"}, {"type": "subtitle", "time": 11188.23, "timestamp": "03:06:28", "text": "クラシックモードでプレイしていますか？ 私たちは"}, {"type": "subtitle", "time": 11205.429, "timestamp": "03:06:45", "text": "ああ、これで吸血鬼の意味が分かった。 ああ、"}, {"type": "subtitle", "time": 11208.15, "timestamp": "03:06:48", "text": "お金がない。"}, {"type": "subtitle", "time": 11209.99, "timestamp": "03:06:49", "text": "まあ、後で手に入れればいいよ。   まだ手に入れられるよ"}, {"type": "subtitle", "time": 11211.91, "timestamp": "03:06:51", "text": "。 それは変わらないだろう。"}, {"type": "subtitle", "time": 11214.309, "timestamp": "03:06:54", "text": "ショップはリセットされません。"}, {"type": "subtitle", "time": 11215.75, "timestamp": "03:06:55", "text": "いいえ。わかりました。"}, {"type": "subtitle", "time": 11219.67, "timestamp": "03:06:59", "text": "何がリセットされると思いますか？"}]
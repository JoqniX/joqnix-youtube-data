[{"type": "subtitle", "time": 6247.669, "timestamp": "01:44:07", "text": "私は全員殺した。"}, {"type": "subtitle", "time": 6251.189, "timestamp": "01:44:11", "text": "背後に毒がある。"}, {"type": "subtitle", "time": 6253.03, "timestamp": "01:44:13", "text": "いいえ、あれは私たちのチームメイトです。"}, {"type": "subtitle", "time": 6255.75, "timestamp": "01:44:15", "text": "いいえ、ヴェノム。 私に毒がかかっている。"}, {"type": "subtitle", "time": 6256.31, "timestamp": "01:44:16", "text": "あなたは死んでいますか？"}, {"type": "subtitle", "time": 6257.669, "timestamp": "01:44:17", "text": "君には毒が染み付いていた。 私は彼を殺していない"}, {"type": "subtitle", "time": 6259.189, "timestamp": "01:44:19", "text": "。"}, {"type": "subtitle", "time": 6263.109, "timestamp": "01:44:23", "text": "ああ、勝ったよ。 ニース。"}, {"type": "subtitle", "time": 6274.55, "timestamp": "01:44:34", "text": "だから"}, {"type": "subtitle", "time": 6276.709, "timestamp": "01:44:36", "text": "チームと一緒にプレーしなきゃいけないんだ。 これは"}, {"type": "subtitle", "time": 6278.87, "timestamp": "01:44:38", "text": "一人でプレイするゲームではありません。 私は、"}, {"type": "subtitle", "time": 6280.55, "timestamp": "01:44:40", "text": "1対1の対戦には向いている性格だとあなたに言いました。"}, {"type": "subtitle", "time": 6284.629, "timestamp": "01:44:44", "text": "スキルが低いからといって、死なないという意味ではありません。"}, {"type": "subtitle", "time": 6286.149, "timestamp": "01:44:46", "text": "覚えて？"}, {"type": "subtitle", "time": 6290.629, "timestamp": "01:44:50", "text": "ああ、大変だ。"}, {"type": "subtitle", "time": 6292.87, "timestamp": "01:44:52", "text": "ちなみに、バッキーを使えば君に勝てるよ"}, {"type": "subtitle", "time": 6294.55, "timestamp": "01:44:54", "text": "。   念のため"}, {"type": "subtitle", "time": 6296.07, "timestamp": "01:44:56", "text": "言っておきます。 バッキーを使えば君に勝てるよ"}, {"type": "subtitle", "time": 6297.59, "timestamp": "01:44:57", "text": "。 ええ、バッキーはとても良い"}]
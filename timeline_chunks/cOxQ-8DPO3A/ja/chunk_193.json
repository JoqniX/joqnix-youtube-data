[{"type": "subtitle", "time": 11580.389, "timestamp": "03:13:00", "text": "。 ああ、感じるよ。"}, {"type": "subtitle", "time": 11583.269, "timestamp": "03:13:03", "text": "私は"}, {"type": "subtitle", "time": 11586.389, "timestamp": "03:13:06", "text": "大手企業と肩を並べることができる。"}, {"type": "subtitle", "time": 11588.15, "timestamp": "03:13:08", "text": "わあ、"}, {"type": "subtitle", "time": 11592.07, "timestamp": "03:13:12", "text": "私ってすごく力持ちになったわ。 ああ、"}, {"type": "subtitle", "time": 11601.91, "timestamp": "03:13:21", "text": "体力は1600、1600あるのに、"}, {"type": "subtitle", "time": 11605.83, "timestamp": "03:13:25", "text": "大きな敵に攻撃されるとすぐに200まで減ってしまう。"}, {"type": "subtitle", "time": 11608.63, "timestamp": "03:13:28", "text": "よし、大きなものから片付けよう。"}, {"type": "subtitle", "time": 11610.469, "timestamp": "03:13:30", "text": "うん、"}, {"type": "subtitle", "time": 11612.63, "timestamp": "03:13:32", "text": "小さいのは処分しつつあるから、大きいのは取っておくべきだね。   えっと、頭を狙うとか。"}, {"type": "subtitle", "time": 11615.19, "timestamp": "03:13:35", "text": "ヘッドショットはできないから。   私は"}, {"type": "subtitle", "time": 11631.83, "timestamp": "03:13:51", "text": "君もあの男みたいに死ぬつもりなのか？"}, {"type": "subtitle", "time": 11633.75, "timestamp": "03:13:53", "text": "知っている。   這い"}]
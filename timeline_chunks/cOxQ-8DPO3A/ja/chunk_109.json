[{"type": "subtitle", "time": 6549.43, "timestamp": "01:49:09", "text": "ジェフィー。 よし、見てみよう"}, {"type": "subtitle", "time": 6563.99, "timestamp": "01:49:23", "text": "じゃなかった。 あんなことを言うべきじゃなかった"}, {"type": "subtitle", "time": 6566.629, "timestamp": "01:49:26", "text": "。 今気づいた。"}, {"type": "subtitle", "time": 6567.91, "timestamp": "01:49:27", "text": "4人いると思っていたのに、実際は"}, {"type": "subtitle", "time": 6575.91, "timestamp": "01:49:35", "text": "少し後退してプレイする必要がある。 あなたは自分を"}, {"type": "subtitle", "time": 6577.669, "timestamp": "01:49:37", "text": "律しなければならない。 わかった。 君には射程"}, {"type": "subtitle", "time": 6580.229, "timestamp": "01:49:40", "text": "距離がないんだよ。 射程距離には限りがあることを覚えておいてください"}, {"type": "subtitle", "time": 6584.25, "timestamp": "01:49:44", "text": "。"}, {"type": "subtitle", "time": 6592.55, "timestamp": "01:49:52", "text": "キーボードのどこに置けばいいかわからない場合は、マウスのボタンのようなものがありますよね"}, {"type": "subtitle", "time": 6594.79, "timestamp": "01:49:54", "text": "？ マウスボタンに割り当てることができます。"}, {"type": "subtitle", "time": 6596.229, "timestamp": "01:49:56", "text": "どれ？"}, {"type": "subtitle", "time": 6596.95, "timestamp": "01:49:56", "text": "E."}, {"type": "subtitle", "time": 6599.51, "timestamp": "01:49:59", "text": "あなたの能力。 うん。 どんな能力でも。 俺は"}]
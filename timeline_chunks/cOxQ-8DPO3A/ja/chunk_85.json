[{"type": "subtitle", "time": 5105.669, "timestamp": "01:25:05", "text": "スパイダーマンを手に入れようとしている。"}, {"type": "subtitle", "time": 5110.87, "timestamp": "01:25:10", "text": "ああ、空飛ぶ女。"}, {"type": "subtitle", "time": 5113.51, "timestamp": "01:25:13", "text": "おっと、フェードカットだね。   私は"}, {"type": "subtitle", "time": 5116.229, "timestamp": "01:25:16", "text": "フェードを使い果たしました。"}, {"type": "subtitle", "time": 5121.75, "timestamp": "01:25:21", "text": "3回か2回ありました。  1つは"}, {"type": "subtitle", "time": 5124.87, "timestamp": "01:25:24", "text": "スパイダーマン、もう1つは"}, {"type": "subtitle", "time": 5129.35, "timestamp": "01:25:29", "text": "。"}, {"type": "subtitle", "time": 5131.35, "timestamp": "01:25:31", "text": "なぜ"}, {"type": "subtitle", "time": 5135.35, "timestamp": "01:25:35", "text": "彼らを標的にしようとしたのですか？ 私は"}]
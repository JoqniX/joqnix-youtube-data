[{"type": "subtitle", "time": 6793.35, "timestamp": "01:53:13", "text": "私はショーを披露する準備ができています。   一体"}, {"type": "subtitle", "time": 6798.95, "timestamp": "01:53:18", "text": "越しに私を攻撃することはできないと確信しています"}, {"type": "subtitle", "time": 6800.629, "timestamp": "01:53:20", "text": "。   わかった"}, {"type": "subtitle", "time": 6809.589, "timestamp": "01:53:29", "text": "うん、君は一人で"}, {"type": "subtitle", "time": 6811.35, "timestamp": "01:53:31", "text": "孤立してるね。 なぜ"}, {"type": "subtitle", "time": 6818.709, "timestamp": "01:53:38", "text": "なんで笑ってるの？ えっと、私、"}, {"type": "subtitle", "time": 6826.149, "timestamp": "01:53:46", "text": "ねえ、チャンスがあった時にこのゲームをプレイするように言ったでしょ"}, {"type": "subtitle", "time": 6827.589, "timestamp": "01:53:47", "text": "。 あなたはそれをプレイしなかった。 あなたは"}, {"type": "subtitle", "time": 6830.55, "timestamp": "01:53:50", "text": "「ああ、後で遊ぼう」って感じだったね。"}, {"type": "subtitle", "time": 6837.109, "timestamp": "01:53:57", "text": "ほら、昔ながらの、退屈な"}]
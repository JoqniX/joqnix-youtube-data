[{"type": "subtitle", "time": 1144.15, "timestamp": "00:19:04", "text": "雷などで壊れてしまうんだよ。 あ、すみません。"}, {"type": "subtitle", "time": 1146.63, "timestamp": "00:19:06", "text": "うん。 味方への誤射を無効にさせてください。"}, {"type": "subtitle", "time": 1149.83, "timestamp": "00:19:09", "text": "ああ、これ好きだな。 わかった。 わかった。   わかった"}, {"type": "subtitle", "time": 1151.19, "timestamp": "00:19:11", "text": "。"}, {"type": "subtitle", "time": 1153.27, "timestamp": "00:19:13", "text": "また、～のために"}, {"type": "subtitle", "time": 1153.909, "timestamp": "00:19:13", "text": "戦う。"}, {"type": "subtitle", "time": 1155.669, "timestamp": "00:19:15", "text": "つまり、Eボタンを押すと、"}, {"type": "subtitle", "time": 1157.669, "timestamp": "00:19:17", "text": "電動モードと風力"}, {"type": "subtitle", "time": 1164.549, "timestamp": "00:19:24", "text": "つまり、素早く行えば、稲妻を放って敵の動きを遅くすることができるのです"}, {"type": "subtitle", "time": 1167.99, "timestamp": "00:19:27", "text": "。"}, {"type": "subtitle", "time": 1173.59, "timestamp": "00:19:33", "text": "右クリックも使えるようになったね。 それは、"}, {"type": "subtitle", "time": 1175.83, "timestamp": "00:19:35", "text": "近くにいる"}, {"type": "subtitle", "time": 1177.59, "timestamp": "00:19:37", "text": "敵に与えるような、瞬間的な大ダメージのようなものです。 ちなみに、射程距離も十分あります。 こっちへおいで"}, {"type": "subtitle", "time": 1178.31, "timestamp": "00:19:38", "text": "。"}, {"type": "subtitle", "time": 1181.029, "timestamp": "00:19:41", "text": "私は戦闘態勢を整える。"}, {"type": "subtitle", "time": 1183.51, "timestamp": "00:19:43", "text": "あなたの後ろみたいに。 そして、このクソみたいなことが怒りを引き起こした。"}, {"type": "subtitle", "time": 1185.83, "timestamp": "00:19:45", "text": "その長方形は、かなりの怒りを抱えている。"}, {"type": "subtitle", "time": 1191.029, "timestamp": "00:19:51", "text": "そうそう。 それでは、こちらへ、"}, {"type": "subtitle", "time": 1195.59, "timestamp": "00:19:55", "text": "あなたの後ろの横に来てください。"}, {"type": "subtitle", "time": 1199.909, "timestamp": "00:19:59", "text": "待って、それがどこにあるのか、私はここにいると"}]
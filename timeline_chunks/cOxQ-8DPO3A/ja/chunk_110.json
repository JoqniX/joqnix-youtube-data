[{"type": "subtitle", "time": 6609.59, "timestamp": "01:50:09", "text": "キーバインドの方が使いやすいと感じるアビリティがいくつかあるので、"}, {"type": "subtitle", "time": 6612.58, "timestamp": "01:50:12", "text": "キーバインドに設定しました。 だから、君は"}, {"type": "subtitle", "time": 6627.109, "timestamp": "01:50:27", "text": "君がすべきことはただ一つ、"}, {"type": "subtitle", "time": 6631.669, "timestamp": "01:50:31", "text": "私をアライグマと呼ぶことだ。"}, {"type": "subtitle", "time": 6642.87, "timestamp": "01:50:42", "text": "キャプテン・アメリカがいる。 彼を攻撃できる"}, {"type": "subtitle", "time": 6647.99, "timestamp": "01:50:47", "text": "捕まえたぞ。"}, {"type": "subtitle", "time": 6650.229, "timestamp": "01:50:50", "text": "ニース。"}, {"type": "subtitle", "time": 6653.99, "timestamp": "01:50:53", "text": "さて、本題に戻りましょう。"}, {"type": "subtitle", "time": 6657.43, "timestamp": "01:50:57", "text": "ダイヤモンドの女性を手に入れろ。 ダイヤモンドのような女性。   戻ってくる"}]
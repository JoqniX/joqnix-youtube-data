[{"type": "subtitle", "time": 4383.03, "timestamp": "01:13:03", "text": "いいえ、BPを殺すことはできません。   ああ"}, {"type": "subtitle", "time": 4388.87, "timestamp": "01:13:08", "text": "、そうだね。"}, {"type": "subtitle", "time": 4392.149, "timestamp": "01:13:12", "text": "ああ、でも私はあの必殺技を何も使わなかったの"}, {"type": "subtitle", "time": 4394.39, "timestamp": "01:13:14", "text": "？   わかった"}, {"type": "subtitle", "time": 4401.51, "timestamp": "01:13:21", "text": "。"}, {"type": "subtitle", "time": 4421.59, "timestamp": "01:13:41", "text": "どうやって？"}, {"type": "subtitle", "time": 4428.39, "timestamp": "01:13:48", "text": "どういう意味ですか？ どうやってかは聞かないで。 生まれ変わった。"}, {"type": "subtitle", "time": 4430.31, "timestamp": "01:13:50", "text": "教えてくれるか、教えてくれないか、どっちかにしてくれ"}, {"type": "subtitle", "time": 4431.35, "timestamp": "01:13:51", "text": "。"}, {"type": "subtitle", "time": 4437.51, "timestamp": "01:13:57", "text": "キーを押すのをうっかり忘れていました。   何だって"}, {"type": "subtitle", "time": 4439.59, "timestamp": "01:13:59", "text": "？"}]
[{"type": "subtitle", "time": 4441.59, "timestamp": "01:14:01", "text": "頭が鈍ってるの？それとも何かおかしいの？一体どういうこと？"}, {"type": "subtitle", "time": 4443.99, "timestamp": "01:14:03", "text": "大丈夫。   殺せ。"}, {"type": "subtitle", "time": 4445.91, "timestamp": "01:14:05", "text": "殺せ。 彼らは死体を殺す。"}, {"type": "subtitle", "time": 4454.149, "timestamp": "01:14:14", "text": "ああ、"}, {"type": "subtitle", "time": 4468.07, "timestamp": "01:14:28", "text": "、飲み込まれてしまった。 ああ、"}, {"type": "subtitle", "time": 4471.03, "timestamp": "01:14:31", "text": "君は消え去ることができる。   あれは"}, {"type": "subtitle", "time": 4472.55, "timestamp": "01:14:32", "text": "ひどかった。ああ、よかった。"}, {"type": "subtitle", "time": 4474.31, "timestamp": "01:14:34", "text": "あなたは喜ぶべきです。"}, {"type": "subtitle", "time": 4477.03, "timestamp": "01:14:37", "text": "あなたのチームが強いことを喜ぶべきだ。 そうでなければ、あなたは"}, {"type": "subtitle", "time": 4479.35, "timestamp": "01:14:39", "text": "良い"}, {"type": "subtitle", "time": 4480.709, "timestamp": "01:14:40", "text": "チームメイトとして行動していないことになります。"}, {"type": "subtitle", "time": 4483.11, "timestamp": "01:14:43", "text": "うん。   何てことだ"}, {"type": "subtitle", "time": 4484.229, "timestamp": "01:14:44", "text": "。"}, {"type": "subtitle", "time": 4499.35, "timestamp": "01:14:59", "text": "この男を捕まえるぞ。"}]
[{"type": "subtitle", "time": 1920.23, "timestamp": "00:32:00", "text": "。   そして、"}, {"type": "subtitle", "time": 1927.11, "timestamp": "00:32:07", "text": "彼女はあなたを驚かせるような人ではない。 彼女はただフェード"}, {"type": "subtitle", "time": 1930.31, "timestamp": "00:32:10", "text": "オートをすることができます。"}, {"type": "subtitle", "time": 1933.19, "timestamp": "00:32:13", "text": "ああ、そのキャラクターもライフスティールを持っています"}, {"type": "subtitle", "time": 1936.149, "timestamp": "00:32:16", "text": "。 あのね"}, {"type": "subtitle", "time": 1940.63, "timestamp": "00:32:20", "text": "？ ライブ配信では、エイムヒットマーカーが表示されません。"}, {"type": "subtitle", "time": 1942.389, "timestamp": "00:32:22", "text": "それを読んだのか？"}, {"type": "subtitle", "time": 1943.19, "timestamp": "00:32:23", "text": "ああ、それは単に"}, {"type": "subtitle", "time": 1946.07, "timestamp": "00:32:26", "text": "文字が2つあるだけです。"}, {"type": "subtitle", "time": 1947.669, "timestamp": "00:32:27", "text": "ええと、これはずっと優れていますよ。"}, {"type": "subtitle", "time": 1950.389, "timestamp": "00:32:30", "text": "ご存知なかったかもしれませんが、自動照準機能が付いていますから。"}, {"type": "subtitle", "time": 1952.63, "timestamp": "00:32:32", "text": "え、何？ 本当に？ おお。"}, {"type": "subtitle", "time": 1954.95, "timestamp": "00:32:34", "text": "ええ、自動照準機能付きです。 でも、ヒーラーなんだよ"}, {"type": "subtitle", "time": 1957.83, "timestamp": "00:32:37", "text": "。 ヒーラー役をプレイしたいですか？"}, {"type": "subtitle", "time": 1958.549, "timestamp": "00:32:38", "text": "彼はそうする。   わからない"}, {"type": "subtitle", "time": 1959.19, "timestamp": "00:32:39", "text": "。"}, {"type": "subtitle", "time": 1962.789, "timestamp": "00:32:42", "text": "そして3番目と4番目はこの"}, {"type": "subtitle", "time": 1963.75, "timestamp": "00:32:43", "text": "男です。"}, {"type": "subtitle", "time": 1973.43, "timestamp": "00:32:53", "text": "混沌を受け入れろ。"}, {"type": "subtitle", "time": 1975.43, "timestamp": "00:32:55", "text": "あなたは死んだのですか？"}, {"type": "subtitle", "time": 1977.11, "timestamp": "00:32:57", "text": "いいえ、私は死んでいません。"}]
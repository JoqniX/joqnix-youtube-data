[{"type": "subtitle", "time": 10873.11, "timestamp": "03:01:13", "text": "強烈な混沌のエネルギーが"}, {"type": "subtitle", "time": 10876.389, "timestamp": "03:01:16", "text": "グランドセントラル駅を襲った。 私の"}, {"type": "subtitle", "time": 10895.67, "timestamp": "03:01:35", "text": "こんにちは。"}, {"type": "subtitle", "time": 10897.51, "timestamp": "03:01:37", "text": "おい、君は今、かなりの損害を与えているぞ"}, {"type": "subtitle", "time": 10898.63, "timestamp": "03:01:38", "text": "。 ほら、"}, {"type": "subtitle", "time": 10900.71, "timestamp": "03:01:40", "text": "私はそうよ。 ああ、そうだよ。"}, {"type": "subtitle", "time": 10903.269, "timestamp": "03:01:43", "text": "はい、そうです。 ゾンビたちは私の本質を取引している"}]
[{"type": "subtitle", "time": 4873.27, "timestamp": "01:21:13", "text": "よし、じゃあ今度は"}, {"type": "subtitle", "time": 4881.03, "timestamp": "01:21:21", "text": "君と一緒にこのキャラクターをプレイする方法を教えてあげるよ。僕は"}, {"type": "subtitle", "time": 4883.43, "timestamp": "01:21:23", "text": "以前、前線キャラクターをプレイしていたからね。 じゃあ、"}, {"type": "subtitle", "time": 4904.47, "timestamp": "01:21:44", "text": "ちょっと準備させてください。   はい"}, {"type": "subtitle", "time": 4906.149, "timestamp": "01:21:46", "text": "、私も同意見です。"}, {"type": "subtitle", "time": 4907.43, "timestamp": "01:21:47", "text": "ちなみに、目の前にいる私はデアデビルです。"}, {"type": "subtitle", "time": 4909.99, "timestamp": "01:21:49", "text": "ちなみに、"}, {"type": "subtitle", "time": 4911.35, "timestamp": "01:21:51", "text": "あそこにキャラクターがいますよ"}, {"type": "subtitle", "time": 4913.03, "timestamp": "01:21:53", "text": "。"}, {"type": "subtitle", "time": 4915.91, "timestamp": "01:21:55", "text": "スパイダーマンを呼んでくれ、と言えばいいんです。"}, {"type": "subtitle", "time": 4917.83, "timestamp": "01:21:57", "text": "いいもの。"}]
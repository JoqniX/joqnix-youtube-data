[{"type": "subtitle", "time": 8820.07, "timestamp": "02:27:00", "text": "写真だね。"}, {"type": "subtitle", "time": 8824.95, "timestamp": "02:27:04", "text": "今ゲームをプレイしているので、チャットに集中することはできません。"}, {"type": "subtitle", "time": 8827.349, "timestamp": "02:27:07", "text": "うん、特にこれといった要素の"}, {"type": "subtitle", "time": 8829.59, "timestamp": "02:27:09", "text": "ない"}, {"type": "subtitle", "time": 8859.349, "timestamp": "02:27:39", "text": "砲塔でより多くの時間を過ごせるようになったら、将来のゲームで目にすることになるものの量を、あなた方は脳で理解することはできないでしょう。 砲塔に座れ"}, {"type": "subtitle", "time": 8862.55, "timestamp": "02:27:42", "text": "。 実際、やめておいた方がいいよ"}, {"type": "subtitle", "time": 8865.27, "timestamp": "02:27:45", "text": "。もう完全に終わってるから。 うん。"}]
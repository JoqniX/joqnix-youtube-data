[{"type": "subtitle", "time": 1202.95, "timestamp": "00:20:02", "text": "思う。   おい、"}, {"type": "subtitle", "time": 1205.59, "timestamp": "00:20:05", "text": "地図を見ろよ。 後ろを振り返ってみてください"}, {"type": "subtitle", "time": 1207.27, "timestamp": "00:20:07", "text": "。   私の"}, {"type": "subtitle", "time": 1210.23, "timestamp": "00:20:10", "text": "後ろに。"}, {"type": "subtitle", "time": 1212.15, "timestamp": "00:20:12", "text": "あなたは今、360度回転しました。後ろを振り返りませんでした"}, {"type": "subtitle", "time": 1215.029, "timestamp": "00:20:15", "text": "。"}, {"type": "subtitle", "time": 1220.07, "timestamp": "00:20:20", "text": "分かりますか？ ああ、そうだね。 はい。 はい。 私は盲目です。"}, {"type": "subtitle", "time": 1222.71, "timestamp": "00:20:22", "text": "大丈夫ですか？"}, {"type": "subtitle", "time": 1223.669, "timestamp": "00:20:23", "text": "うん。 私はここにいます。   ここに"}, {"type": "subtitle", "time": 1227.11, "timestamp": "00:20:27", "text": "来て。 聖なる神よ。 この男。 確か、有効"}, {"type": "subtitle", "time": 1229.59, "timestamp": "00:20:29", "text": "範囲は15メートルだったと思います。 はい。"}, {"type": "subtitle", "time": 1231.59, "timestamp": "00:20:31", "text": "右クリック。"}, {"type": "subtitle", "time": 1234.95, "timestamp": "00:20:34", "text": "ああ、遠くから来た敵だ。"}, {"type": "subtitle", "time": 1237.35, "timestamp": "00:20:37", "text": "ところで、あなたの発射物は本当に素晴らしいですね"}, {"type": "subtitle", "time": 1237.83, "timestamp": "00:20:37", "text": "。"}, {"type": "subtitle", "time": 1240.95, "timestamp": "00:20:40", "text": "同志。 ああ、ここにもそういう"}, {"type": "subtitle", "time": 1246.95, "timestamp": "00:20:46", "text": "了解、それは素晴らしいですね。"}, {"type": "subtitle", "time": 1252.23, "timestamp": "00:20:52", "text": "あなたの作品がゲームの中で一番優れていると思います。"}, {"type": "subtitle", "time": 1253.029, "timestamp": "00:20:53", "text": "最高の一つ。"}, {"type": "subtitle", "time": 1255.909, "timestamp": "00:20:55", "text": "女神の怒りを感じろ。"}, {"type": "subtitle", "time": 1257.27, "timestamp": "00:20:57", "text": "ああ、"}, {"type": "subtitle", "time": 1259.83, "timestamp": "00:20:59", "text": "彼はまるで彼女が出す強い力で、"}]
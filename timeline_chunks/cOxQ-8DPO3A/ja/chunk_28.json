[{"type": "subtitle", "time": 1681.75, "timestamp": "00:28:01", "text": "アアモトの目を通して。   それでもエンジンはかからなかった"}, {"type": "subtitle", "time": 1683.19, "timestamp": "00:28:03", "text": "。   うんうん"}, {"type": "subtitle", "time": 1686.31, "timestamp": "00:28:06", "text": "。 それは終わった。 わかった。 待って。"}, {"type": "subtitle", "time": 1688.95, "timestamp": "00:28:08", "text": "アアモトの目から見て、"}, {"type": "subtitle", "time": 1691.11, "timestamp": "00:28:11", "text": "君は私より速くなければならない。 ただ、「君は"}, {"type": "subtitle", "time": 1694.07, "timestamp": "00:28:14", "text": "僕よりずっと速くなくてはならない」と言えばいいんだ。   そうなんです"}, {"type": "subtitle", "time": 1695.51, "timestamp": "00:28:15", "text": "。"}, {"type": "subtitle", "time": 1698.63, "timestamp": "00:28:18", "text": "あなたはアアモトの目を見る。   何てことだ"}, {"type": "subtitle", "time": 1699.51, "timestamp": "00:28:19", "text": "。"}, {"type": "subtitle", "time": 1701.83, "timestamp": "00:28:21", "text": "これをやらなければならない。"}, {"type": "subtitle", "time": 1703.75, "timestamp": "00:28:23", "text": "私はこれが苦手です。 待って、とりあえず「"}, {"type": "subtitle", "time": 1706.95, "timestamp": "00:28:26", "text": "No Cool Girls」を再生してみよう。"}, {"type": "subtitle", "time": 1709.75, "timestamp": "00:28:29", "text": "アアモトの目から見ると、"}, {"type": "subtitle", "time": 1711.99, "timestamp": "00:28:31", "text": "君はまだそこにいる。 わかった。   わかった"}, {"type": "subtitle", "time": 1713.269, "timestamp": "00:28:33", "text": "。"}, {"type": "subtitle", "time": 1715.909, "timestamp": "00:28:35", "text": "あなたは私の魔法にかかっている。 えっと、どう"}, {"type": "subtitle", "time": 1717.19, "timestamp": "00:28:37", "text": "言ったんですか？"}, {"type": "subtitle", "time": 1719.43, "timestamp": "00:28:39", "text": "クールダウンなし。   わかった"}, {"type": "subtitle", "time": 1720.389, "timestamp": "00:28:40", "text": "、やらなきゃいけないんだ"}, {"type": "subtitle", "time": 1722.23, "timestamp": "00:28:42", "text": "。君のためにやったんだよ。 私はそれをしました。 私は"}, {"type": "subtitle", "time": 1725.669, "timestamp": "00:28:45", "text": "ホストです。 それはあなたのためにやったんです。 ああ、誰もいない"}, {"type": "subtitle", "time": 1727.75, "timestamp": "00:28:47", "text": "。   ダメです。 わかった"}, {"type": "subtitle", "time": 1730.95, "timestamp": "00:28:50", "text": "。"}, {"type": "subtitle", "time": 1733.19, "timestamp": "00:28:53", "text": "アアモトの目を通して。"}, {"type": "subtitle", "time": 1736.87, "timestamp": "00:28:56", "text": "待って、スタンがある。 足元を圧倒する。   下を見て"}, {"type": "subtitle", "time": 1738.95, "timestamp": "00:28:58", "text": "。"}]
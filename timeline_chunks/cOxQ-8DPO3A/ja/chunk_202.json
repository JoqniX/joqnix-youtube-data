[{"type": "subtitle", "time": 12125.51, "timestamp": "03:22:05", "text": "銀河系。   はしごも手に入るし"}, {"type": "subtitle", "time": 12129.6, "timestamp": "03:22:09", "text": "、ユニットも手に入る。"}, {"type": "subtitle", "time": 12131.51, "timestamp": "03:22:11", "text": "[音楽]"}, {"type": "subtitle", "time": 12136.55, "timestamp": "03:22:16", "text": "バトルパスを買ったことはありますか？"}, {"type": "subtitle", "time": 12139.269, "timestamp": "03:22:19", "text": "無料で買えるよ。"}, {"type": "subtitle", "time": 12143.19, "timestamp": "03:22:23", "text": "確か、あと"}, {"type": "subtitle", "time": 12146.71, "timestamp": "03:22:26", "text": "2シーズンで"}, {"type": "subtitle", "time": 12147.83, "timestamp": "03:22:27", "text": "1つ無料で買えると思うんだけど。"}, {"type": "subtitle", "time": 12149.91, "timestamp": "03:22:29", "text": "待って、今600人しかいないよ。   階層は"}, {"type": "subtitle", "time": 12155.11, "timestamp": "03:22:35", "text": "24段階しかない。 おお。"}, {"type": "subtitle", "time": 12158.15, "timestamp": "03:22:38", "text": "でも、経験値稼ぎはすごく大変だと思う。"}, {"type": "subtitle", "time": 12161.349, "timestamp": "03:22:41", "text": "入手困難。 うん、"}, {"type": "subtitle", "time": 12163.91, "timestamp": "03:22:43", "text": "遅刻するのは難しいよね。 そして試合は終盤へと進んでいく"}, {"type": "subtitle", "time": 12167.51, "timestamp": "03:22:47", "text": "。 この物体が見えますか？ それは何だったのか"}, {"type": "subtitle", "time": 12169.83, "timestamp": "03:22:49", "text": "？ それは何ですか？  2度目のコーナー"}, {"type": "subtitle", "time": 12173.11, "timestamp": "03:22:53", "text": "ストーム。 彼らは"}, {"type": "subtitle", "time": 12175.429, "timestamp": "03:22:55", "text": "シーズン終了時に毎回そうする。 つまり、あと"}]
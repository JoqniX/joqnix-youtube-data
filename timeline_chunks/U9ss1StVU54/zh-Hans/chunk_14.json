[{"type": "subtitle", "time": 841.509, "timestamp": "00:14:01", "text": "呃，还有什么？   是的"}, {"type": "subtitle", "time": 853.99, "timestamp": "00:14:13", "text": "。 我也是。 好吃。 好吃。 呃，"}, {"type": "subtitle", "time": 862.87, "timestamp": "00:14:22", "text": "什么我不喜欢的？"}, {"type": "subtitle", "time": 869.03, "timestamp": "00:14:29", "text": "说到蔬菜，"}, {"type": "subtitle", "time": 875.75, "timestamp": "00:14:35", "text": "好吧，我喜欢西红柿。 是的，这些年来我开始"}, {"type": "subtitle", "time": 878.71, "timestamp": "00:14:38", "text": "喜欢上西红柿了。 是的。"}, {"type": "subtitle", "time": 883.43, "timestamp": "00:14:43", "text": "那么西兰花其实很好吃。 我"}, {"type": "subtitle", "time": 886.23, "timestamp": "00:14:46", "text": "第一次吃西兰花是在吃拉面的时候"}, {"type": "subtitle", "time": 891.829, "timestamp": "00:14:51", "text": "。 我吃的时候，里面好像有"}, {"type": "subtitle", "time": 893.75, "timestamp": "00:14:53", "text": "西兰花。 我当时想：“哇，"}, {"type": "subtitle", "time": 897.11, "timestamp": "00:14:57", "text": "这味道真不错。我喜欢这个味道。”"}]
[{"type": "subtitle", "time": 3480.069, "timestamp": "00:58:00", "text": "伙计，自从"}, {"type": "subtitle", "time": 3483.51, "timestamp": "00:58:03", "text": "Elgato推出新款"}, {"type": "subtitle", "time": 3486.39, "timestamp": "00:58:06", "text": "产品以来，我看到了好多好多，对吧？ 大家都在"}, {"type": "subtitle", "time": 3489.91, "timestamp": "00:58:09", "text": "攻击音量计。 大家都觉得"}, {"type": "subtitle", "time": 3493.19, "timestamp": "00:58:13", "text": "语音计量器已经过时了。 选择 Elgato"}, {"type": "subtitle", "time": 3496.63, "timestamp": "00:58:16", "text": "Wavelength 3。"}, {"type": "subtitle", "time": 3500.23, "timestamp": "00:58:20", "text": "我在 Twitter 上看到"}, {"type": "subtitle", "time": 3503.75, "timestamp": "00:58:23", "text": "有人说 VoiceMeter"}, {"type": "subtitle", "time": 3506.71, "timestamp": "00:58:26", "text": "和 Elgato 是不同的产品。"}, {"type": "subtitle", "time": 3511.349, "timestamp": "00:58:31", "text": "我们提供的功能确实更多，"}, {"type": "subtitle", "time": 3513.43, "timestamp": "00:58:33", "text": "但是语音计量器的使用场景"}, {"type": "subtitle", "time": 3516.63, "timestamp": "00:58:36", "text": "确实比较高级，不适合普通"}, {"type": "subtitle", "time": 3521.829, "timestamp": "00:58:41", "text": "它是给音频工程师之类的专业人士用的"}, {"type": "subtitle", "time": 3524.15, "timestamp": "00:58:44", "text": "。 嘿，任何人都可以使用吗？"}, {"type": "chat", "time": 3525.924, "timestamp": "00:58:45", "author": "@MINKK102", "avatar": "https://yt4.ggpht.com/XVxEYLlWYRuW0CJeu7nHxmdkqt0znzmmZR5ZqaVEYPXxj_o2d9XbeOrr3TLqPPKmPVzsNyU0=s64-c-k-c0x00ffffff-no-rj", "message": "its just pain to set up wakelink (my brain gave up )"}, {"type": "subtitle", "time": 3527.589, "timestamp": "00:58:47", "text": "那里也有。 现在有点复杂"}, {"type": "subtitle", "time": 3530.87, "timestamp": "00:58:50", "text": "，但 Elgato 的"}, {"type": "subtitle", "time": 3534.39, "timestamp": "00:58:54", "text": "路由表功能让它变得更简单了。   做"}, {"type": "subtitle", "time": 3537.589, "timestamp": "00:58:57", "text": "波浪造型真痛苦。 你知道吗，"}]
[{"type": "subtitle", "time": 17880.708, "timestamp": "04:58:00", "text": "当他没有直播时，屏幕会全屏显示。 但当"}, {"type": "subtitle", "time": 17883.35, "timestamp": "04:58:03", "text": "他直播时，视频播放器会变"}, {"type": "subtitle", "time": 17886.15, "timestamp": "04:58:06", "text": "小。 有背景音乐。 呃，"}, {"type": "subtitle", "time": 17889.27, "timestamp": "04:58:09", "text": "这是日程表。 就像"}, {"type": "subtitle", "time": 17893.27, "timestamp": "04:58:13", "text": "病房里的录像暂停了一样。"}, {"type": "subtitle", "time": 17896.868, "timestamp": "04:58:16", "text": "我的天啊，我的电脑上"}, {"type": "subtitle", "time": 17899.67, "timestamp": "04:58:19", "text": "V的播放暂停了。 呃，帖子里有"}, {"type": "subtitle", "time": 17901.75, "timestamp": "04:58:21", "text": "粉丝艺术作品，"}, {"type": "subtitle", "time": 17904.708, "timestamp": "04:58:24", "text": "呃，所有关于阿桑戈尔的粉丝艺术作品都会被"}, {"type": "subtitle", "time": 17908.31, "timestamp": "04:58:28", "text": "反复播放，就像，该怎么"}, {"type": "subtitle", "time": 17910.15, "timestamp": "04:58:30", "text": "称呼它呢，就像幻灯片之类的"}, {"type": "subtitle", "time": 17911.67, "timestamp": "04:58:31", "text": "东西。   是的"}, {"type": "subtitle", "time": 17914.23, "timestamp": "04:58:34", "text": "，我想那样做。 我想"}, {"type": "subtitle", "time": 17917.99, "timestamp": "04:58:37", "text": "建立一个同人作品数据库。"}, {"type": "subtitle", "time": 17920.15, "timestamp": "04:58:40", "text": "我这辈子收到的所有粉丝作品"}, {"type": "subtitle", "time": 17922.47, "timestamp": "04:58:42", "text": "，我一定要找个地方"}, {"type": "subtitle", "time": 17938.868, "timestamp": "04:58:58", "text": "但是太多书呆子气的东西了。"}]
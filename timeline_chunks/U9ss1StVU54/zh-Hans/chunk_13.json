[{"type": "subtitle", "time": 789.67, "timestamp": "00:13:09", "text": "我得研究一下这个问题。 还有"}, {"type": "subtitle", "time": 791.43, "timestamp": "00:13:11", "text": "其他素食者吗？ 有没有"}, {"type": "subtitle", "time": 796.069, "timestamp": "00:13:16", "text": "你不吃的肉？ 我不知道。 实际上，"}, {"type": "subtitle", "time": 800.949, "timestamp": "00:13:20", "text": "我吃肉，我是个肉食者。 我"}, {"type": "subtitle", "time": 804.23, "timestamp": "00:13:24", "text": "也吃素食。 我不"}, {"type": "subtitle", "time": 806.31, "timestamp": "00:13:26", "text": "挑食。 不。"}, {"type": "subtitle", "time": 815.36, "timestamp": "00:13:35", "text": "。 嗯，"}, {"type": "subtitle", "time": 821.269, "timestamp": "00:13:41", "text": "至于肉类，"}, {"type": "subtitle", "time": 828.31, "timestamp": "00:13:48", "text": "鸡。"}, {"type": "subtitle", "time": 831.11, "timestamp": "00:13:51", "text": "鸡肉配"}, {"type": "subtitle", "time": 834.71, "timestamp": "00:13:54", "text": "猪肉。 还有什么？"}, {"type": "subtitle", "time": 838.31, "timestamp": "00:13:58", "text": "鸭子。 制作普通鸭子。 是的。"}]
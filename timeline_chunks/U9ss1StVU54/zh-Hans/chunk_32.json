[{"type": "subtitle", "time": 1920.63, "timestamp": "00:32:00", "text": "以前，我是说很久以前，大概"}, {"type": "subtitle", "time": 1922.789, "timestamp": "00:32:02", "text": "上个月一月份左右吧。 我"}, {"type": "subtitle", "time": 1925.43, "timestamp": "00:32:05", "text": "忘了。 他当时说：“呃，你应该"}, {"type": "subtitle", "time": 1930.549, "timestamp": "00:32:10", "text": "买个华硕 Rock Sticks"}, {"type": "chat", "time": 1935.024, "timestamp": "00:32:15", "author": "@MINKK102", "avatar": "https://yt4.ggpht.com/XVxEYLlWYRuW0CJeu7nHxmdkqt0znzmmZR5ZqaVEYPXxj_o2d9XbeOrr3TLqPPKmPVzsNyU0=s64-c-k-c0x00ffffff-no-rj", "message": "once upon a time......"}, {"type": "subtitle", "time": 1935.19, "timestamp": "00:32:15", "text": "G16 2025 版。” 自从他告诉我"}, {"type": "subtitle", "time": 1937.83, "timestamp": "00:32:17", "text": "这件事后，我就去看了看，查了一下，发现"}, {"type": "subtitle", "time": 1939.75, "timestamp": "00:32:19", "text": "它确实是一款非常好的笔记本电脑。 我一直对它"}, {"type": "subtitle", "time": 1944.149, "timestamp": "00:32:24", "text": "着迷。 然后我"}, {"type": "subtitle", "time": 1946.47, "timestamp": "00:32:26", "text": "意识到，是的"}, {"type": "subtitle", "time": 1949.19, "timestamp": "00:32:29", "text": "，这很贵。 我为什么"}, {"type": "subtitle", "time": 1951.509, "timestamp": "00:32:31", "text": "要花那么多钱买一台笔记本"}, {"type": "subtitle", "time": 1953.909, "timestamp": "00:32:33", "text": "电脑呢？我完全可以用这笔"}, {"type": "subtitle", "time": 1958.07, "timestamp": "00:32:38", "text": "钱组装一台台式电脑，对吧？ 那差不多就是"}, {"type": "subtitle", "time": 1960.47, "timestamp": "00:32:40", "text": "二十万、"}, {"type": "subtitle", "time": 1967.269, "timestamp": "00:32:47", "text": "要买那么多？ 当然，"}, {"type": "subtitle", "time": 1968.87, "timestamp": "00:32:48", "text": "从日本购买会"}, {"type": "subtitle", "time": 1976.389, "timestamp": "00:32:56", "text": "所以，我一直在考虑买一台"}, {"type": "subtitle", "time": 1979.99, "timestamp": "00:32:59", "text": "便宜点的"}]
[{"type": "subtitle", "time": 11417.99, "timestamp": "03:10:17", "text": "H，一直在找。 呃，但我"}, {"type": "subtitle", "time": 11421.19, "timestamp": "03:10:21", "text": "现在得去睡觉了。 哦，你好。"}, {"type": "subtitle", "time": 11424.71, "timestamp": "03:10:24", "text": "你好。 好久不见了。 你好。 你好。"}, {"type": "subtitle", "time": 11427.19, "timestamp": "03:10:27", "text": "你的直播怎么样？"}, {"type": "subtitle", "time": 11438.23, "timestamp": "03:10:38", "text": "你好，祝你今晚"}, {"type": "subtitle", "time": 11442.79, "timestamp": "03:10:42", "text": "睡个好觉。"}, {"type": "subtitle", "time": 11445.83, "timestamp": "03:10:45", "text": "是的，我也有稳定的收入来源。 我正在努力"}, {"type": "subtitle", "time": 11449.349, "timestamp": "03:10:49", "text": "平衡两者。"}, {"type": "subtitle", "time": 11451.99, "timestamp": "03:10:51", "text": "你好。"}]
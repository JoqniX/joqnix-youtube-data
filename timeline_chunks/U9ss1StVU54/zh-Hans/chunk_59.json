[{"type": "subtitle", "time": 3543.43, "timestamp": "00:59:03", "text": "当我更新到稳定版后，我的配置就消失了"}, {"type": "subtitle", "time": 3547.589, "timestamp": "00:59:07", "text": "。 我当时应该是参与了 beta 4 的 beta 测试"}, {"type": "subtitle", "time": 3550.95, "timestamp": "00:59:10", "text": "。 等等，当前版本是什么？"}, {"type": "subtitle", "time": 3554.789, "timestamp": "00:59:14", "text": "哦，beta 3 呃 3.0。 哦，不。 正确的。 当"}, {"type": "subtitle", "time": 3558.39, "timestamp": "00:59:18", "text": "这个版本测试版发布时，我正在使用"}, {"type": "subtitle", "time": 3560.63, "timestamp": "00:59:20", "text": "当前稳定版本的测试版"}, {"type": "subtitle", "time": 3562.789, "timestamp": "00:59:22", "text": "。 当他们发布"}, {"type": "subtitle", "time": 3565.349, "timestamp": "00:59:25", "text": "稳定版赛车时，他们好像加入了一个新的驱动程序之类的东西"}, {"type": "subtitle", "time": 3568.15, "timestamp": "00:59:28", "text": "。 他们都和他们以前的"}, {"type": "subtitle", "time": 3570.549, "timestamp": "00:59:30", "text": "司机链接一样。 您可以手动"}, {"type": "subtitle", "time": 3573.03, "timestamp": "00:59:33", "text": "下载驱动程序。 对我来说，那招行不通"}, {"type": "subtitle", "time": 3577.03, "timestamp": "00:59:37", "text": "。 显然，我的 Windows 设置"}, {"type": "subtitle", "time": 3581.109, "timestamp": "00:59:41", "text": "将默认应用程序安装在了"}, {"type": "subtitle", "time": 3583.43, "timestamp": "00:59:43", "text": "另一个本地驱动器上，而"}, {"type": "subtitle", "time": 3586.95, "timestamp": "00:59:46", "text": "不是 C 盘。 这就是为什么我"}, {"type": "subtitle", "time": 3590.23, "timestamp": "00:59:50", "text": "无法安装"}, {"type": "subtitle", "time": 3593.67, "timestamp": "00:59:53", "text": "波长驱动程序的原因。 是的，我"}, {"type": "subtitle", "time": 3595.75, "timestamp": "00:59:55", "text": "重启后卸载并重新安装，结果"}, {"type": "subtitle", "time": 3599.91, "timestamp": "00:59:59", "text": "我的配置丢失了。 我就像兄弟一样。"}]
[{"type": "subtitle", "time": 2353.03, "timestamp": "00:39:13", "text": "等待。 呃，"}, {"type": "subtitle", "time": 2364.31, "timestamp": "00:39:24", "text": "，我今天好累，因为我没怎么"}, {"type": "subtitle", "time": 2367.19, "timestamp": "00:39:27", "text": "睡。 我当时在"}, {"type": "subtitle", "time": 2369.75, "timestamp": "00:39:29", "text": "学习和做作业，这些作业我"}, {"type": "subtitle", "time": 2374.63, "timestamp": "00:39:34", "text": "昨天和前天生病的时候就应该做了，结果"}, {"type": "subtitle", "time": 2382.39, "timestamp": "00:39:42", "text": "我10点就睡着了。"}, {"type": "subtitle", "time": 2386.95, "timestamp": "00:39:46", "text": "是的，我做作业的时候趴在桌子上睡着了，"}, {"type": "subtitle", "time": 2391.91, "timestamp": "00:39:51", "text": "12点醒来，然后"}, {"type": "subtitle", "time": 2393.75, "timestamp": "00:39:53", "text": "又睡着了。 我凌晨两点醒了。 然后我"}, {"type": "subtitle", "time": 2397.43, "timestamp": "00:39:57", "text": "从凌晨两点到三点。是的，凌晨三点，"}]
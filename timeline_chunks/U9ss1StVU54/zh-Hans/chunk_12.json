[{"type": "subtitle", "time": 722.069, "timestamp": "00:12:02", "text": "还有我的空调都跳闸了。 好像我"}, {"type": "subtitle", "time": 723.99, "timestamp": "00:12:03", "text": "不知道最近发生了什么事似的。 我的空调"}, {"type": "subtitle", "time": 727.11, "timestamp": "00:12:07", "text": "跳闸了。 发货情况就像"}, {"type": "subtitle", "time": 734.31, "timestamp": "00:12:14", "text": "最近发生了停电或电气故障，"}, {"type": "subtitle", "time": 738.79, "timestamp": "00:12:18", "text": "空调彻底坏了，所以"}, {"type": "subtitle", "time": 757.43, "timestamp": "00:12:37", "text": "呃，为什么我必须手动触发这个"}, {"type": "subtitle", "time": 768.31, "timestamp": "00:12:48", "text": "YouTube 访问令牌获取？ 好的。"}, {"type": "subtitle", "time": 770.47, "timestamp": "00:12:50", "text": "好的。 好的。 我以为我需要"}, {"type": "subtitle", "time": 773.43, "timestamp": "00:12:53", "text": "验证才能"}, {"type": "chat", "time": 774.345, "timestamp": "00:12:54", "author": "@ObnoxiousAgnostic", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kVrH3KET_eX7LDEi_ka-c3eoI3J-Vcy4GX19VQNPnWwZQ=s64-c-k-c0x00ffffff-no-rj", "message": "I understand you’re not a vegetarian. Is there any meat you won’t eat?"}]
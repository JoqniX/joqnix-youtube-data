[{"type": "subtitle", "time": 304.469, "timestamp": "00:05:04", "text": "所以，週三是我"}, {"type": "subtitle", "time": 308.71, "timestamp": "00:05:08", "text": "最後一次直播。是的。  是的，"}, {"type": "subtitle", "time": 312.95, "timestamp": "00:05:12", "text": "週三是我最後一次直播。  說實話，"}, {"type": "subtitle", "time": 318.629, "timestamp": "00:05:18", "text": "我昨天本來想直播的，"}, {"type": "subtitle", "time": 320.31, "timestamp": "00:05:20", "text": "但是"}, {"type": "subtitle", "time": 326.55, "timestamp": "00:05:26", "text": "昨天也沒課，我就隨便逛了一會兒，然後睡了個午覺，結果"}, {"type": "subtitle", "time": 340.55, "timestamp": "00:05:40", "text": "那午覺竟然睡了"}, {"type": "subtitle", "time": 344.87, "timestamp": "00:05:44", "text": "幾個小時來著？"}, {"type": "subtitle", "time": 347.59000000000003, "timestamp": "00:05:47", "text": "然後我上去了，大概下午"}, {"type": "subtitle", "time": 356.95, "timestamp": "00:05:56", "text": "是的，"}]
[{"type": "subtitle", "time": 722.069, "timestamp": "00:12:02", "text": "跳閘了。好像我"}, {"type": "subtitle", "time": 723.99, "timestamp": "00:12:03", "text": "不知道最近發生了什麼事似的。我的空調跳閘了。發貨情況就像最近發生了"}, {"type": "subtitle", "time": 731.11, "timestamp": "00:12:11", "text": "停電或"}, {"type": "subtitle", "time": 734.31, "timestamp": "00:12:14", "text": "電氣故障，"}, {"type": "subtitle", "time": 738.79, "timestamp": "00:12:18", "text": "空調徹底壞了，所以有點麻煩。嗯，Stream Engine 一秒鐘……呃，"}, {"type": "subtitle", "time": 757.43, "timestamp": "00:12:37", "text": "為什麼我必須手動觸發這個"}, {"type": "chat", "time": 774.345, "timestamp": "00:12:54", "author": "@ObnoxiousAgnostic", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kVrH3KET_eX7LDEi_ka-c3eoI3J-Vcy4GX19VQNPnWwZQ=s64-c-k-c0x00ffffff-no-rj", "message": "I understand you’re not a vegetarian. Is there any meat you won’t eat?"}]
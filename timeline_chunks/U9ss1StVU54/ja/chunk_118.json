[{"type": "subtitle", "time": 7087.189, "timestamp": "01:58:07", "text": "それでどうなるの？ これについてはどうですか?"}, {"type": "subtitle", "time": 7089.51, "timestamp": "01:58:09", "text": "あ、これ入れてなかった。"}, {"type": "subtitle", "time": 7095.83, "timestamp": "01:58:15", "text": "F"}, {"type": "subtitle", "time": 7102.87, "timestamp": "01:58:22", "text": "メタドットには"}, {"type": "subtitle", "time": 7108.149, "timestamp": "01:58:28", "text": "チャットドットがあります。 ちょっと待って、何？"}, {"type": "subtitle", "time": 7111.51, "timestamp": "01:58:31", "text": "チャットだけで十分です。 ちょっと待って。"}, {"type": "subtitle", "time": 7117.43, "timestamp": "01:58:37", "text": "メタって何？"}, {"type": "subtitle", "time": 7133.35, "timestamp": "01:58:53", "text": "ああ、わかりました。 わかった。 どちらも動作します。 わかった。 わかった。 分かりました"}, {"type": "subtitle", "time": 7138.95, "timestamp": "01:58:58", "text": "。 わかった。 これをコピーします。"}]
[{"type": "subtitle", "time": 16442.551, "timestamp": "04:34:02", "text": "えっと、待って、待って、"}, {"type": "subtitle", "time": 16444.709, "timestamp": "04:34:04", "text": "Twitch と YouTube を待ってください。 ええと、これには私"}, {"type": "subtitle", "time": 16447.429, "timestamp": "04:34:07", "text": "のサムネイル、ライブ チャット、AI"}, {"type": "subtitle", "time": 16451.109, "timestamp": "04:34:11", "text": "ベースの要約、AI ベースの要約"}, {"type": "subtitle", "time": 16454.551, "timestamp": "04:34:14", "text": "とチャプター マーカーが含まれます。 そして"}, {"type": "subtitle", "time": 16456.869, "timestamp": "04:34:16", "text": "タイムライン機能も持っています。 タイムラインは"}, {"type": "subtitle", "time": 16460.869, "timestamp": "04:34:20", "text": "基本的に次のようになります。 えっと、どうすれば"}, {"type": "subtitle", "time": 16462.551, "timestamp": "04:34:22", "text": "いいですか？"}, {"type": "subtitle", "time": 16466.869, "timestamp": "04:34:26", "text": "つまり、これは基本的に、"}, {"type": "subtitle", "time": 16469.59, "timestamp": "04:34:29", "text": "YouTube SRT のトランスクリプトのようなものですよね?"}, {"type": "subtitle", "time": 16476.15, "timestamp": "04:34:36", "text": "チャットがある場合は、チャットの字幕をいいねします。 はい、両方が 1 つに表示されます。"}, {"type": "subtitle", "time": 16477.67, "timestamp": "04:34:37", "text": "それは必要ありません。 でも、"}, {"type": "subtitle", "time": 16482.31, "timestamp": "04:34:42", "text": "字幕には日本語、"}, {"type": "subtitle", "time": 16484.949, "timestamp": "04:34:44", "text": "中国語、簡体字、繁体字、"}, {"type": "subtitle", "time": 16486.949, "timestamp": "04:34:46", "text": "英語、英語由来などを入れました。 つまり、英語を 2 つ追加すると 4 つの"}, {"type": "subtitle", "time": 16488.629, "timestamp": "04:34:48", "text": "言語になります"}, {"type": "subtitle", "time": 16493.189, "timestamp": "04:34:53", "text": "。"}, {"type": "subtitle", "time": 16495.59, "timestamp": "04:34:55", "text": "そうですね、"}, {"type": "subtitle", "time": 16498.949, "timestamp": "04:34:58", "text": "これを使用して、"}]
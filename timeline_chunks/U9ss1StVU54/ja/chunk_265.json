[{"type": "subtitle", "time": 15902.07, "timestamp": "04:25:02", "text": "。 チャットを読んでいません。 ごめんなさい"}, {"type": "subtitle", "time": 15906.229, "timestamp": "04:25:06", "text": "。 こんにちは、ゼン。 えっと、Zen Game Z Gamer。"}, {"type": "subtitle", "time": 15908.469, "timestamp": "04:25:08", "text": "こんにちは。 こんにちは。 こんにちは。 何てことだ。"}, {"type": "subtitle", "time": 15910.469, "timestamp": "04:25:10", "text": "2分前にメッセージを送信しました。 読んでないよ"}, {"type": "subtitle", "time": 15913.349, "timestamp": "04:25:13", "text": "。 ごめん。 ごめん。 こんにちは。 ストリームへようこそ"}, {"type": "subtitle", "time": 15914.87, "timestamp": "04:25:14", "text": "。"}, {"type": "subtitle", "time": 15917.59, "timestamp": "04:25:17", "text": "こんにちは。 こんにちは。   私はちょうど"}, {"type": "subtitle", "time": 15921.59, "timestamp": "04:25:21", "text": "アーカイブシステムの作業をしていたところです"}, {"type": "subtitle", "time": 15923.11, "timestamp": "04:25:23", "text": "。"}, {"type": "subtitle", "time": 15925.189, "timestamp": "04:25:25", "text": "こんにちは、"}, {"type": "subtitle", "time": 15929.429, "timestamp": "04:25:29", "text": "ゲーマーさん。 メタ情報のストリームへようこそ"}, {"type": "subtitle", "time": 15933.75, "timestamp": "04:25:33", "text": "。 私がやりたいことは、"}, {"type": "subtitle", "time": 15936.309, "timestamp": "04:25:36", "text": "基本的に"}, {"type": "subtitle", "time": 15939.269, "timestamp": "04:25:39", "text": "条件付きレンダリングを行うことです。つまり、"}, {"type": "subtitle", "time": 15946.71, "timestamp": "04:25:46", "text": "あなたのストリームに、何と"}, {"type": "subtitle", "time": 15949.75, "timestamp": "04:25:49", "text": "呼ぶんでしょうか、過去の"}, {"type": "subtitle", "time": 15951.91, "timestamp": "04:25:51", "text": "放送があるような場合、つまり、"}, {"type": "subtitle", "time": 15955.349, "timestamp": "04:25:55", "text": "Twitch にリンクされていない Twitch 放送 ID がリンクされている場合、"}, {"type": "subtitle", "time": 15958.149, "timestamp": "04:25:58", "text": "このようなシナリオでは、"}]
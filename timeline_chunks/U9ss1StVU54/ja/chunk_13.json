[{"type": "subtitle", "time": 789.67, "timestamp": "00:13:09", "text": "これに取り組まなければなりません。"}, {"type": "subtitle", "time": 791.43, "timestamp": "00:13:11", "text": "他にベジタリアンはいますか？"}, {"type": "subtitle", "time": 796.069, "timestamp": "00:13:16", "text": "食べない肉はありますか？ わからない。 実は、"}, {"type": "subtitle", "time": 800.949, "timestamp": "00:13:20", "text": "私は非菜食主義者です。 私も"}, {"type": "subtitle", "time": 804.23, "timestamp": "00:13:24", "text": "ベジタリアン料理を食べます。 私は好き嫌いがありません"}, {"type": "subtitle", "time": 806.31, "timestamp": "00:13:26", "text": "。 いいえ。だから"}, {"type": "subtitle", "time": 815.35, "timestamp": "00:13:35", "text": "うん。"}, {"type": "subtitle", "time": 821.269, "timestamp": "00:13:41", "text": "肉に関しては、何でも"}, {"type": "subtitle", "time": 828.31, "timestamp": "00:13:48", "text": "チキン。"}, {"type": "subtitle", "time": 831.11, "timestamp": "00:13:51", "text": "鶏肉と"}, {"type": "subtitle", "time": 834.71, "timestamp": "00:13:54", "text": "豚肉を混ぜます。 ほかに何か？"}, {"type": "subtitle", "time": 838.31, "timestamp": "00:13:58", "text": "アヒル。 普通のアヒルを作る。 うん。"}]
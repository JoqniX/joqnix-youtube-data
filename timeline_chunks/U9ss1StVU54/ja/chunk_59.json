[{"type": "subtitle", "time": 3543.43, "timestamp": "00:59:03", "text": "安定バージョンにアップデートしたら設定が消えてしまいました"}, {"type": "subtitle", "time": 3547.589, "timestamp": "00:59:07", "text": "。 たぶん、私はベータ 4 のベータ版に参加していました"}, {"type": "subtitle", "time": 3550.95, "timestamp": "00:59:10", "text": "。 ちょっと待ってください、現在のバージョンは何ですか?"}, {"type": "subtitle", "time": 3554.789, "timestamp": "00:59:14", "text": "ああ、ベータ 3、つまり 3.0 です。 なんてこった。 右。"}, {"type": "subtitle", "time": 3558.39, "timestamp": "00:59:18", "text": "このバージョンのベータ版がリリースされたとき、私は"}, {"type": "subtitle", "time": 3560.63, "timestamp": "00:59:20", "text": "現在の安定バージョンのベータ版を使用していました"}, {"type": "subtitle", "time": 3562.789, "timestamp": "00:59:22", "text": "。 そして彼らが安定版をリリースしたとき"}, {"type": "subtitle", "time": 3565.349, "timestamp": "00:59:25", "text": "、彼らは新しいドライバーか"}, {"type": "subtitle", "time": 3568.15, "timestamp": "00:59:28", "text": "何かを持っていました。 それらはすべて、古い"}, {"type": "subtitle", "time": 3570.549, "timestamp": "00:59:30", "text": "ドライバーリンクのようなものです。 ドライバーを手動で"}, {"type": "subtitle", "time": 3573.03, "timestamp": "00:59:33", "text": "ダウンロードすることができます。 それは"}, {"type": "subtitle", "time": 3577.03, "timestamp": "00:59:37", "text": "私には効果がありませんでした。 どうやら、私の Windows 設定では、"}, {"type": "subtitle", "time": 3581.109, "timestamp": "00:59:41", "text": "インストールされるデフォルトのアプリが"}, {"type": "subtitle", "time": 3586.95, "timestamp": "00:59:46", "text": "C ドライブではなく別のローカル ドライブに設定されていたようです。 だから、"}, {"type": "subtitle", "time": 3593.67, "timestamp": "00:59:53", "text": "波長ドライバーのドライバーをインストールできなかったんです。 はい、アンインストールして再インストールし、再"}, {"type": "subtitle", "time": 3595.75, "timestamp": "00:59:55", "text": "起動したら"}, {"type": "subtitle", "time": 3599.91, "timestamp": "00:59:59", "text": "設定が失われました。 私は兄弟のようです。"}]
[{"type": "subtitle", "time": 18312.628, "timestamp": "05:05:12", "text": "3つ星を獲得しました。 何てことだ。 クレイジー。"}, {"type": "subtitle", "time": 18339.59, "timestamp": "05:05:39", "text": "正直に言うと、私は自分がやっていることすべてと、それを"}, {"type": "subtitle", "time": 18343.59, "timestamp": "05:05:43", "text": "どうやってやったか"}, {"type": "subtitle", "time": 18346.55, "timestamp": "05:05:46", "text": "、これらすべてのことについてチュートリアルを作りたかったんです。 いいえ、でも、もし"}, {"type": "subtitle", "time": 18354.07, "timestamp": "05:05:54", "text": "すべてを説明しなければならないとしたら、それは"}, {"type": "subtitle", "time": 18356.628, "timestamp": "05:05:56", "text": "3 〜 4 時間のビデオになるだろうし、誰が"}, {"type": "subtitle", "time": 18358.708, "timestamp": "05:05:58", "text": "それを見るだろうか、と気づいたのです。 人々は"}]
[{"type": "subtitle", "time": 4022.95, "timestamp": "01:07:02", "text": "スケジュール開始時刻のタイムスタンプです。"}, {"type": "subtitle", "time": 4029.029, "timestamp": "01:07:09", "text": "その時刻から 1 時間程度までであれば"}, {"type": "subtitle", "time": 4032.95, "timestamp": "01:07:12", "text": "リンクされます。"}, {"type": "subtitle", "time": 4035.589, "timestamp": "01:07:15", "text": "マルチストリームの場合は"}, {"type": "subtitle", "time": 4038.87, "timestamp": "01:07:18", "text": "YouTube が常に先頭になるからです。 それから 5 秒後に"}, {"type": "subtitle", "time": 4041.19, "timestamp": "01:07:21", "text": "Twitch が起動し、すべてが起動します。"}, {"type": "subtitle", "time": 4045.67, "timestamp": "01:07:25", "text": "だって私はマルチミルを使っているんだもんね？"}, {"type": "subtitle", "time": 4049.75, "timestamp": "01:07:29", "text": "そうですね、"}, {"type": "subtitle", "time": 4053.589, "timestamp": "01:07:33", "text": "YouTube でストリームが発生し、"}, {"type": "subtitle", "time": 4056.95, "timestamp": "01:07:36", "text": "Twitch ストリームも"}, {"type": "subtitle", "time": 4060.789, "timestamp": "01:07:40", "text": "同様のウィンドウで 30 分以内、30 分から 1"}, {"type": "subtitle", "time": 4064.47, "timestamp": "01:07:44", "text": "時間のウィンドウ フレームで発生した場合に、それを再生して"}, {"type": "subtitle", "time": 4069.51, "timestamp": "01:07:49", "text": "実際に機能していることを示すフォールバック システムが必要でした。"}, {"type": "subtitle", "time": 4071.91, "timestamp": "01:07:51", "text": "これをここから削除する必要があります。 これはどこか別の場所に"}, {"type": "subtitle", "time": 4073.75, "timestamp": "01:07:53", "text": "行くはずです"}]
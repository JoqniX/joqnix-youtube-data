[{"type": "subtitle", "time": 6184.47, "timestamp": "01:43:04", "text": "返品と"}, {"type": "subtitle", "time": 6221.03, "timestamp": "01:43:41", "text": "右。 わかった。 待って。 セクションを見つけます。"}, {"type": "subtitle", "time": 6222.709, "timestamp": "01:43:42", "text": "素晴らしいストリーミングをお楽しみください。 はい、"}, {"type": "subtitle", "time": 6224.149, "timestamp": "01:43:44", "text": "素晴らしいショーをやっています。 私はただ裏で"}, {"type": "subtitle", "time": 6226.31, "timestamp": "01:43:46", "text": "働いて、"}, {"type": "subtitle", "time": 6236.709, "timestamp": "01:43:56", "text": "うん。   わかった"}, {"type": "subtitle", "time": 6239.27, "timestamp": "01:43:59", "text": "。 これです。 他にここで何が必要ですか"}]
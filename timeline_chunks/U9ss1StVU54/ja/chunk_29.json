[{"type": "subtitle", "time": 1741.43, "timestamp": "00:29:01", "text": "主な問題は、"}, {"type": "subtitle", "time": 1745.269, "timestamp": "00:29:05", "text": "ストリーミングして再生できないことだと私は思います。"}, {"type": "subtitle", "time": 1750.31, "timestamp": "00:29:10", "text": "ええと、"}, {"type": "subtitle", "time": 1753.19, "timestamp": "00:29:13", "text": "5 回、6 回、7 回とストリームを配信したとき、"}, {"type": "subtitle", "time": 1756.07, "timestamp": "00:29:16", "text": "配信するたびに運が悪く、死んでしまいました。"}, {"type": "subtitle", "time": 1759.909, "timestamp": "00:29:19", "text": "いい戦利品に負けました。 でも、"}, {"type": "subtitle", "time": 1764.549, "timestamp": "00:29:24", "text": "オフストリームでゲームをプレイすると、私は勝ちます。"}, {"type": "subtitle", "time": 1767.669, "timestamp": "00:29:27", "text": "簡単に抽出できます。 いい戦利品が手に入る。"}, {"type": "chat", "time": 1781.037, "timestamp": "00:29:41", "author": "@MINKK102", "avatar": "https://yt4.ggpht.com/XVxEYLlWYRuW0CJeu7nHxmdkqt0znzmmZR5ZqaVEYPXxj_o2d9XbeOrr3TLqPPKmPVzsNyU0=s64-c-k-c0x00ffffff-no-rj", "message": "streamers curse"}, {"type": "chat", "time": 1785.769, "timestamp": "00:29:45", "author": "@MINKK102", "avatar": "https://yt4.ggpht.com/XVxEYLlWYRuW0CJeu7nHxmdkqt0znzmmZR5ZqaVEYPXxj_o2d9XbeOrr3TLqPPKmPVzsNyU0=s64-c-k-c0x00ffffff-no-rj", "message": "ig"}, {"type": "subtitle", "time": 1787.35, "timestamp": "00:29:47", "text": "ストリーマー。"}]
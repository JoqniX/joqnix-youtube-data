[{"type": "subtitle", "time": 4620.229, "timestamp": "01:17:00", "text": "1 回の実行が 1 つのビデオに相当するわけではありません。 したがって、"}, {"type": "subtitle", "time": 4623.99, "timestamp": "01:17:03", "text": "最大で 10 までしか処理できないと"}, {"type": "subtitle", "time": 4626.87, "timestamp": "01:17:06", "text": "思います。 はい、古い"}, {"type": "subtitle", "time": 4629.99, "timestamp": "01:17:09", "text": "ストリームは処理せず、最近のストリームだけを処理します。 つまり、"}, {"type": "subtitle", "time": 4632.709, "timestamp": "01:17:12", "text": "ストリーミングするほど、AI メタデータも増えることになります"}, {"type": "subtitle", "time": 4634.229, "timestamp": "01:17:14", "text": "。   そうですね"}, {"type": "subtitle", "time": 4640.39, "timestamp": "01:17:20", "text": "、間違った"}, {"type": "subtitle", "time": 4657.43, "timestamp": "01:17:37", "text": "動作するかどうか見てみましょう。 わかった。"}, {"type": "subtitle", "time": 4659.83, "timestamp": "01:17:39", "text": "えっと、Twitch アーカイブです。"}, {"type": "subtitle", "time": 4663.11, "timestamp": "01:17:43", "text": "一緒に見たいです。"}, {"type": "subtitle", "time": 4668.07, "timestamp": "01:17:48", "text": "よし、一緒に見よう。 よし、"}]
[{"type": "subtitle", "time": 1456.23, "timestamp": "00:24:16", "text": "サーバー スラムが発生したときにマラソンを 30 分程度しかプレイできなかったのが残念です"}, {"type": "subtitle", "time": 1461.51, "timestamp": "00:24:21", "text": "。 そして"}, {"type": "subtitle", "time": 1465.11, "timestamp": "00:24:25", "text": "チュートリアルをやってみて、私は「なんてことだ」と思いました。 そして、"}, {"type": "chat", "time": 1466.744, "timestamp": "00:24:26", "author": "@bakononcopiumm", "avatar": "https://yt4.ggpht.com/hb5sPAHLUD7fBrZZsmfkzISQWwRqI8BY1n8lceyhZz0sNISomD05pCwUe-GL2amD5y-voH_uYw=s64-c-k-c0x00ffffff-no-rj", "message": "imagine you cant make it because of buying a game lol"}, {"type": "subtitle", "time": 1468.47, "timestamp": "00:24:28", "text": "私は1試合プレイしましたが、"}, {"type": "subtitle", "time": 1471.99, "timestamp": "00:24:31", "text": "ロボットか何かに即死し、それが"}, {"type": "subtitle", "time": 1475.19, "timestamp": "00:24:35", "text": "私の体力や"}, {"type": "subtitle", "time": 1479.59, "timestamp": "00:24:39", "text": "命を奪おうとしました。 それは奇妙で不気味な"}, {"type": "subtitle", "time": 1482.39, "timestamp": "00:24:42", "text": "ワイヤーを引き抜き、私の生命"}, {"type": "subtitle", "time": 1485.11, "timestamp": "00:24:45", "text": "エネルギーか何かを吸い取り始めました。"}, {"type": "subtitle", "time": 1496.549, "timestamp": "00:24:56", "text": "ええ、私の PC であのゲームをプレイできたのは本当に驚きました。"}]
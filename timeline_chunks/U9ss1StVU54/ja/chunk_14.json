[{"type": "subtitle", "time": 841.509, "timestamp": "00:14:01", "text": "えっと、他には何がありますか?"}, {"type": "subtitle", "time": 853.99, "timestamp": "00:14:13", "text": "うん。 私もです。 おいしい。 おいしい。 えっと、"}, {"type": "subtitle", "time": 862.87, "timestamp": "00:14:22", "text": "？"}, {"type": "subtitle", "time": 865.829, "timestamp": "00:14:25", "text": "H"}, {"type": "subtitle", "time": 869.03, "timestamp": "00:14:29", "text": "野菜に関して言えば、"}, {"type": "subtitle", "time": 875.75, "timestamp": "00:14:35", "text": "そうですね、私はトマトが好きです。 ええ、私は何"}, {"type": "subtitle", "time": 878.71, "timestamp": "00:14:38", "text": "年もかけてトマトを好きになりました。 うん。"}, {"type": "subtitle", "time": 883.43, "timestamp": "00:14:43", "text": "すると、ブロッコリーは実は良いのです。 ラーメン、えっとラーメンを食べた時に"}, {"type": "subtitle", "time": 886.23, "timestamp": "00:14:46", "text": "初めてブロッコリーを食べました"}, {"type": "subtitle", "time": 891.829, "timestamp": "00:14:51", "text": "。 私が食べたときは、"}, {"type": "subtitle", "time": 893.75, "timestamp": "00:14:53", "text": "ブロッコリーのようなものが入っていました。 私は「わあ、"}, {"type": "subtitle", "time": 897.11, "timestamp": "00:14:57", "text": "これはいい。この味が好きだ」と思いました。"}]
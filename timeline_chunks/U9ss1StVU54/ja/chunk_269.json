[{"type": "subtitle", "time": 16144.469, "timestamp": "04:29:04", "text": "、アーカイブ"}, {"type": "subtitle", "time": 16147.429, "timestamp": "04:29:07", "text": "ページのようなものを作ったんです。"}, {"type": "subtitle", "time": 16150.309, "timestamp": "04:29:10", "text": "アーカイブページを作りました。"}, {"type": "subtitle", "time": 16154.07, "timestamp": "04:29:14", "text": "特定のストリームのチャットを確認できるようになりました。 まるで"}, {"type": "subtitle", "time": 16168.95, "timestamp": "04:29:28", "text": "、わかりました。見せてあげましょう。 えっと、"}, {"type": "subtitle", "time": 16172.95, "timestamp": "04:29:32", "text": "アーカイブページがあるんですよ、冗談です。 スペースライブストリーム、"}, {"type": "subtitle", "time": 16174.71, "timestamp": "04:29:34", "text": "ハイフン、"}, {"type": "chat", "time": 16176.416, "timestamp": "04:29:36", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "waaaa"}, {"type": "subtitle", "time": 16178.149, "timestamp": "04:29:38", "text": "アーカイブ。 だから昨日の"}, {"type": "subtitle", "time": 16180.229, "timestamp": "04:29:40", "text": "ストリームもそうやった。"}, {"type": "subtitle", "time": 16182.79, "timestamp": "04:29:42", "text": "私のストリームをクリックします。"}, {"type": "subtitle", "time": 16184.71, "timestamp": "04:29:44", "text": "サムネイルは気にしないでください。 壊れてるよ。   えっと、"}, {"type": "subtitle", "time": 16190.71, "timestamp": "04:29:50", "text": "ストリームのサムネイルが HD 品質、つまり"}, {"type": "subtitle", "time": 16192.63, "timestamp": "04:29:52", "text": "480p だったので修正します。   それは"}, {"type": "subtitle", "time": 16194.79, "timestamp": "04:29:54", "text": "悪いことです。 とにかく、ここからストリームを視聴できます。"}, {"type": "subtitle", "time": 16199.11, "timestamp": "04:29:59", "text": "ビリービリーも登場します"}]
[{"type": "subtitle", "time": 2586.15, "timestamp": "00:43:06", "text": "ここに Twitch チャットを配置したいのですが、これがストリームを取得した"}, {"type": "subtitle", "time": 2589.349, "timestamp": "00:43:09", "text": "ものです。Twitch チャットは"}, {"type": "subtitle", "time": 2593.27, "timestamp": "00:43:13", "text": "ここにあります。GitHub には"}, {"type": "subtitle", "time": 2595.829, "timestamp": "00:43:15", "text": "Twitch チャットがあります。"}, {"type": "subtitle", "time": 2599.19, "timestamp": "00:43:19", "text": "アーカイブの wave"}, {"type": "subtitle", "time": 2602.069, "timestamp": "00:43:22", "text": "と jockn は"}, {"type": "subtitle", "time": 2605.19, "timestamp": "00:43:25", "text": "正規化されていますよね? ということで、これが"}, {"type": "subtitle", "time": 2611.91, "timestamp": "00:43:31", "text": "最後のストリームでの Twitch のすべてのチャットのすべてです。"}, {"type": "subtitle", "time": 2613.829, "timestamp": "00:43:33", "text": "それをマージして、"}, {"type": "subtitle", "time": 2619.109, "timestamp": "00:43:39", "text": "アーカイブ ページからサイト上で読めるようにするだけです。 サムネイルが"}, {"type": "subtitle", "time": 2620.95, "timestamp": "00:43:40", "text": "壊れているのはなぜですか?"}, {"type": "subtitle", "time": 2622.55, "timestamp": "00:43:42", "text": "O、"}, {"type": "subtitle", "time": 2625.109, "timestamp": "00:43:45", "text": "それを修正します。"}, {"type": "subtitle", "time": 2626.87, "timestamp": "00:43:46", "text": "心配しないで、ジョン。 学問的に。"}, {"type": "chat", "time": 2635.694, "timestamp": "00:43:55", "author": "@MINKK102", "avatar": "https://yt4.ggpht.com/XVxEYLlWYRuW0CJeu7nHxmdkqt0znzmmZR5ZqaVEYPXxj_o2d9XbeOrr3TLqPPKmPVzsNyU0=s64-c-k-c0x00ffffff-no-rj", "message": "o7 thumbnail"}, {"type": "subtitle", "time": 2636.87, "timestamp": "00:43:56", "text": "AI の要約機能も変更する必要があります"}]
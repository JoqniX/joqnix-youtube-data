[{"type": "subtitle", "time": 2100.79, "timestamp": "00:35:00", "text": "分前に、"}, {"type": "subtitle", "time": 2105.829, "timestamp": "00:35:05", "text": "YouTube でストリームをスケジュールするときにリンクする方法と、"}, {"type": "subtitle", "time": 2109.349, "timestamp": "00:35:09", "text": "そのスケジュール ストリームを"}, {"type": "subtitle", "time": 2113.51, "timestamp": "00:35:13", "text": "Twitch スケジュールにリンクする方法を尋ねていました。 例えば、"}, {"type": "subtitle", "time": 2117.03, "timestamp": "00:35:17", "text": "Twitch Helix API をどこで使用すればいいのか、どのエンドポイントを"}, {"type": "subtitle", "time": 2119.109, "timestamp": "00:35:19", "text": "使用すればいいのか、Cloudfare Worker でそれをどうやって実行すれば"}, {"type": "subtitle", "time": 2126.23, "timestamp": "00:35:26", "text": "Chrome タイマーで自動的に実行できるのか、"}, {"type": "subtitle", "time": 2132.39, "timestamp": "00:35:32", "text": "独自のものを使用して、"}, {"type": "subtitle", "time": 2134.95, "timestamp": "00:35:34", "text": "これをどうやって実行すればいいのかなどのガイドが欲しいのですが、私がそのように"}, {"type": "subtitle", "time": 2137.349, "timestamp": "00:35:37", "text": "質問すると、彼は私にその答えを教えてくれました。 私は"}, {"type": "subtitle", "time": 2139.109, "timestamp": "00:35:39", "text": "「よし、"}, {"type": "subtitle", "time": 2140.71, "timestamp": "00:35:40", "text": "配信しながらやろう」と思いました。"}, {"type": "chat", "time": 2141.546, "timestamp": "00:35:41", "author": "@MINKK102", "avatar": "https://yt4.ggpht.com/XVxEYLlWYRuW0CJeu7nHxmdkqt0znzmmZR5ZqaVEYPXxj_o2d9XbeOrr3TLqPPKmPVzsNyU0=s64-c-k-c0x00ffffff-no-rj", "message": "i just use it as a unpaid intern who does all the searching for projects"}, {"type": "subtitle", "time": 2147.91, "timestamp": "00:35:47", "text": "私はすべての商品検索を行う無給のインターンとしてそれを使用するでしょう"}, {"type": "subtitle", "time": 2150.39, "timestamp": "00:35:50", "text": "。 えっと、"}, {"type": "subtitle", "time": 2153.349, "timestamp": "00:35:53", "text": "Chiビデオは無料ですよね？ えっと、インドでは"}, {"type": "subtitle", "time": 2155.75, "timestamp": "00:35:55", "text": "18か月か16か月くらいですよね"}, {"type": "subtitle", "time": 2158.87, "timestamp": "00:35:58", "text": "？ うん。 私の"}]
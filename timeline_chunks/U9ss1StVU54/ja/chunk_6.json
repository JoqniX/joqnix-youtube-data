[{"type": "subtitle", "time": 361.51, "timestamp": "00:06:01", "text": "昼寝は午後3時まで続きました。 それで、"}, {"type": "subtitle", "time": 363.189, "timestamp": "00:06:03", "text": "配信をしようと思ったんですが、いくつか"}, {"type": "subtitle", "time": 366.07, "timestamp": "00:06:06", "text": "雑用をやらなきゃいけないし、"}, {"type": "subtitle", "time": 371.11, "timestamp": "00:06:11", "text": "準備とか、修正とか、"}, {"type": "subtitle", "time": 377.83, "timestamp": "00:06:17", "text": "こういうことのために文章を書いたりしなきゃいけないしで、それで、よし、配信は"}, {"type": "subtitle", "time": 381.83, "timestamp": "00:06:21", "text": "スキップして、"}, {"type": "subtitle", "time": 384.95, "timestamp": "00:06:24", "text": "明日やろうってことになったんです。それで、"}, {"type": "subtitle", "time": 388.309, "timestamp": "00:06:28", "text": "午前中にやろうと思ったんです。そうしないと、午後"}, {"type": "subtitle", "time": 393.27, "timestamp": "00:06:33", "text": "4時か5時ごろに配信を始めなくちゃいけなかったんです。"}, {"type": "subtitle", "time": 395.43, "timestamp": "00:06:35", "text": "うん。"}]
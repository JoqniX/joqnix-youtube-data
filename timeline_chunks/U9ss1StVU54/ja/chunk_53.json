[{"type": "subtitle", "time": 3183.91, "timestamp": "00:53:03", "text": "えーと、ストリーマー ボットのようなコメント"}, {"type": "subtitle", "time": 3186.309, "timestamp": "00:53:06", "text": "コメント プラットフォームや、"}, {"type": "subtitle", "time": 3190.63, "timestamp": "00:53:10", "text": "ストリーム ツールのようなものがあります。これは"}, {"type": "subtitle", "time": 3193.109, "timestamp": "00:53:13", "text": "JPvtuber が使用するもので、"}, {"type": "subtitle", "time": 3195.589, "timestamp": "00:53:15", "text": "One.com と呼ばれています。誰かが"}, {"type": "subtitle", "time": 3200.23, "timestamp": "00:53:20", "text": "One.com 拡張機能のようなものを作成したので、ユーザーの名前では"}, {"type": "subtitle", "time": 3202.23, "timestamp": "00:53:22", "text": "なく、ユーザーの表示名が表示されます"}, {"type": "subtitle", "time": 3204.549, "timestamp": "00:53:24", "text": "。"}, {"type": "subtitle", "time": 3206.39, "timestamp": "00:53:26", "text": "はい、Twitterで見ました。"}, {"type": "subtitle", "time": 3208.71, "timestamp": "00:53:28", "text": "ブックマークか何か入れたと思います。 かなり"}, {"type": "subtitle", "time": 3235.19, "timestamp": "00:53:55", "text": "、また一つ。 もう"}]
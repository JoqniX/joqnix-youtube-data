[{"type": "subtitle", "time": 2040.149, "timestamp": "00:34:00", "text": "話しかけて、「そうだね、話してよ」という感じです。話す"}, {"type": "subtitle", "time": 2044.47, "timestamp": "00:34:04", "text": "相手はあまりいないので。ええ、ほとんどの場合は、"}, {"type": "subtitle", "time": 2050.149, "timestamp": "00:34:10", "text": "主に、"}, {"type": "subtitle", "time": 2056.71, "timestamp": "00:34:16", "text": "頭の中にあるアイデアを GPT に尋ねていると思います"}, {"type": "subtitle", "time": 2060.79, "timestamp": "00:34:20", "text": "。配信関連のことなどです。"}, {"type": "subtitle", "time": 2062.47, "timestamp": "00:34:22", "text": "そうですね、"}, {"type": "subtitle", "time": 2066.55, "timestamp": "00:34:26", "text": "私がこれに夢中になっているのは不思議です。   ちょっと"}, {"type": "subtitle", "time": 2069.19, "timestamp": "00:34:29", "text": "待ってください、あなたたちはプロムの"}, {"type": "subtitle", "time": 2074.23, "timestamp": "00:34:34", "text": "AI による指示や AI と会話することに夢中になっているのですか"}, {"type": "subtitle", "time": 2076.55, "timestamp": "00:34:36", "text": "?   ハマってます"}, {"type": "subtitle", "time": 2088.95, "timestamp": "00:34:48", "text": "最近話したのは、えーっと、"}, {"type": "subtitle", "time": 2091.99, "timestamp": "00:34:51", "text": "30分くらい前のことでした。 ちょっと待って、"}, {"type": "subtitle", "time": 2094.069, "timestamp": "00:34:54", "text": "私がストリームを始めたのはいつだったっけ?  35歳ですよね？"}, {"type": "subtitle", "time": 2096.629, "timestamp": "00:34:56", "text": "35分ですよね？ うん。 うん。 それで、40"}, {"type": "chat", "time": 2098.581, "timestamp": "00:34:58", "author": "@bakononcopiumm", "avatar": "https://yt4.ggpht.com/hb5sPAHLUD7fBrZZsmfkzISQWwRqI8BY1n8lceyhZz0sNISomD05pCwUe-GL2amD5y-voH_uYw=s64-c-k-c0x00ffffff-no-rj", "message": "careful joq"}]
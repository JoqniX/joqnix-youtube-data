[{"type": "subtitle", "time": 11417.99, "timestamp": "03:10:17", "text": "Hさん、探していました。 えーっと、もう"}, {"type": "subtitle", "time": 11421.19, "timestamp": "03:10:21", "text": "寝なきゃ。 ああ、こんにちは。"}, {"type": "subtitle", "time": 11424.71, "timestamp": "03:10:24", "text": "こんにちは。 久しぶりですね。 こんにちは。 こんにちは。"}, {"type": "subtitle", "time": 11427.19, "timestamp": "03:10:27", "text": "配信はどうでしたか？"}, {"type": "subtitle", "time": 11438.23, "timestamp": "03:10:38", "text": "こんにちは。"}, {"type": "subtitle", "time": 11442.79, "timestamp": "03:10:42", "text": "良い夜をお過ごしください。ぐっすり眠ってください。"}, {"type": "subtitle", "time": 11445.83, "timestamp": "03:10:45", "text": "はい、安定したものもあります。 私は"}, {"type": "subtitle", "time": 11449.349, "timestamp": "03:10:49", "text": "両方のバランスをとっているような感じです。"}, {"type": "subtitle", "time": 11451.99, "timestamp": "03:10:51", "text": "こんにちは。"}]
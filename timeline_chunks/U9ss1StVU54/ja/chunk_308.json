[{"type": "subtitle", "time": 18480.39, "timestamp": "05:08:00", "text": "変なことをしながら、ただしゃべりまくってただけ。"}, {"type": "subtitle", "time": 18483.35, "timestamp": "05:08:03", "text": "でも、そうですね、今月は忙しいので、ゲーム配信はもうしません"}, {"type": "subtitle", "time": 18486.628, "timestamp": "05:08:06", "text": "。 うん。   一緒に過ごしてくれて、話もさせてくれて"}, {"type": "subtitle", "time": 18488.07, "timestamp": "05:08:08", "text": "ありがとう"}, {"type": "subtitle", "time": 18490.47, "timestamp": "05:08:10", "text": "。"}, {"type": "subtitle", "time": 18491.99, "timestamp": "05:08:11", "text": "ありがとう。 皆様ありがとうございました。 そして、"}, {"type": "subtitle", "time": 18495.99, "timestamp": "05:08:15", "text": "私が作成しているアーカイブ ページが気に入っていただければ幸いです。"}, {"type": "subtitle", "time": 18498.788, "timestamp": "05:08:18", "text": "ああ、そうですね。今日はありがとうございました。"}, {"type": "subtitle", "time": 18503.43, "timestamp": "05:08:23", "text": "皆さん良い一日をお過ごしください。 着込んで"}, {"type": "subtitle", "time": 18508.47, "timestamp": "05:08:28", "text": "寝て休みます。 勉強しなきゃ。"}, {"type": "subtitle", "time": 18512.31, "timestamp": "05:08:32", "text": "明日のために復習しなくてはいけません。"}, {"type": "subtitle", "time": 18517.75, "timestamp": "05:08:37", "text": "、"}, {"type": "subtitle", "time": 18519.99, "timestamp": "05:08:39", "text": "今日は来てくれてありがとう。 ジョーはどうですか、良い"}, {"type": "subtitle", "time": 18522.55, "timestamp": "05:08:42", "text": "一日を。 皆さんお気をつけて良い一日をお過ごしください"}]
[{"type": "subtitle", "time": 10107.429, "timestamp": "02:48:27", "text": "我不能。 工作流程太多了。 我得"}, {"type": "subtitle", "time": 10109.349, "timestamp": "02:48:29", "text": "快速地说出来。 这速度太慢了"}, {"type": "subtitle", "time": 10111.67, "timestamp": "02:48:31", "text": "。 我得快点说，对吧？ 我的"}, {"type": "subtitle", "time": 10114.07, "timestamp": "02:48:34", "text": "天哪。 我把它调到一个速度档位，看看速度能"}, {"type": "subtitle", "time": 10136.389, "timestamp": "02:48:56", "text": "我不能，我不能。 太快了。   速度"}, {"type": "subtitle", "time": 10138.95, "timestamp": "02:48:58", "text": "很快。 好的。"}]
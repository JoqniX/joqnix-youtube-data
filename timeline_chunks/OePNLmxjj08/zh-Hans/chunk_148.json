[{"type": "subtitle", "time": 8881.59, "timestamp": "02:28:01", "text": "[叹气] 那我们就做“是啊”。"}, {"type": "subtitle", "time": 8884.469, "timestamp": "02:28:04", "text": "又是那首冰淇淋歌。"}, {"type": "subtitle", "time": 8897.75, "timestamp": "02:28:17", "text": "好的，我们会负责说唱部分。"}, {"type": "subtitle", "time": 8900.63, "timestamp": "02:28:20", "text": "嗯，"}, {"type": "subtitle", "time": 8903.27, "timestamp": "02:28:23", "text": "天哪，我觉得当我们……哦我的天哪，"}, {"type": "subtitle", "time": 8910.79, "timestamp": "02:28:30", "text": "我讨厌吃外面的"}, {"type": "subtitle", "time": 8922.389, "timestamp": "02:28:42", "text": "你好。"}, {"type": "subtitle", "time": 8926.63, "timestamp": "02:28:46", "text": "请尽情享受大堂环境。 尽情欣赏音乐。   这就"}]
[{"type": "subtitle", "time": 16890.31, "timestamp": "04:41:30", "text": "是的。Koko的特点是她喜欢"}, {"type": "subtitle", "time": 16893.75, "timestamp": "04:41:33", "text": "唱长音，还有她"}, {"type": "subtitle", "time": 16896.788, "timestamp": "04:41:36", "text": "刚才唱的那个。"}, {"type": "subtitle", "time": 16899.67, "timestamp": "04:41:39", "text": "大多数歌都有那个，而我是"}, {"type": "subtitle", "time": 16902.31, "timestamp": "04:41:42", "text": "兄弟，我做不到。"}, {"type": "subtitle", "time": 16912.07, "timestamp": "04:41:52", "text": "我找不到《Romanti》的歌词。这"}]
[{"type": "subtitle", "time": 15069.11, "timestamp": "04:11:09", "text": "你在哪里，你在哪里"}, {"type": "subtitle", "time": 15072.63, "timestamp": "04:11:12", "text": "？ 嘿，什么？"}, {"type": "subtitle", "time": 15080.229, "timestamp": "04:11:20", "text": "呃，"}, {"type": "subtitle", "time": 15082.15, "timestamp": "04:11:22", "text": "融化的"}, {"type": "subtitle", "time": 15085.269, "timestamp": "04:11:25", "text": "地方我忘了。 等一下，"}, {"type": "subtitle", "time": 15087.59, "timestamp": "04:11:27", "text": "桌子。"}, {"type": "subtitle", "time": 15089.51, "timestamp": "04:11:29", "text": "不，这行不通。 等等，我忘了。"}, {"type": "subtitle", "time": 15091.91, "timestamp": "04:11:31", "text": "那首歌在哪儿？"}, {"type": "subtitle", "time": 15095.59, "timestamp": "04:11:35", "text": "当我需要你的时候，你却不在。  N. 是的"}]
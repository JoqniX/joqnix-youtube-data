[{"type": "subtitle", "time": 16923.27, "timestamp": "04:42:03", "text": "首歌在哪儿？"}, {"type": "subtitle", "time": 16936.708, "timestamp": "04:42:16", "text": "等等，等等。我想我找到了。"}, {"type": "subtitle", "time": 16938.31, "timestamp": "04:42:18", "text": "不。"}, {"type": "subtitle", "time": 16940.628, "timestamp": "04:42:20", "text": "哦，等等。我忘了。停。停。停。"}, {"type": "subtitle", "time": 16943.11, "timestamp": "04:42:23", "text": "停。别让我惹上版权纠纷。我"}, {"type": "subtitle", "time": 16944.788, "timestamp": "04:42:24", "text": "知道我想唱所有的歌，"}, {"type": "subtitle", "time": 16948.708, "timestamp": "04:42:28", "text": "但是不行。不行。D不在那里。好吧，我想我找到了"}, {"type": "subtitle", "time": 16965.91, "timestamp": "04:42:45", "text": "不，"}]
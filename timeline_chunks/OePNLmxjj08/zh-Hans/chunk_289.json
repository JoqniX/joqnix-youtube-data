[{"type": "subtitle", "time": 17346.788, "timestamp": "04:49:06", "text": "尖叫我啊我今天唱不好"}, {"type": "subtitle", "time": 17349.19, "timestamp": "04:49:09", "text": "。"}, {"type": "subtitle", "time": 17352.15, "timestamp": "04:49:12", "text": "但是，第三句，第三"}, {"type": "subtitle", "time": 17355.51, "timestamp": "04:49:15", "text": "句，呃，第三段，呃，第三段，"}, {"type": "subtitle", "time": 17358.628, "timestamp": "04:49:18", "text": "第三部分我可以唱一些。"}, {"type": "subtitle", "time": 17360.628, "timestamp": "04:49:20", "text": "特别是副歌，副歌的渐强"}, {"type": "subtitle", "time": 17363.27, "timestamp": "04:49:23", "text": "和主副歌我可以唱。第二"}, {"type": "subtitle", "time": 17366.31, "timestamp": "04:49:26", "text": "句是八句，我必须学习。"}, {"type": "subtitle", "time": 17368.07, "timestamp": "04:49:28", "text": "第一部分我还可以。只是需要"}, {"type": "subtitle", "time": 17374.07, "timestamp": "04:49:34", "text": "你相信吗？我们才开始学这"}, {"type": "subtitle", "time": 17377.03, "timestamp": "04:49:37", "text": "首歌30 几分钟前，我差不多"}, {"type": "subtitle", "time": 17385.03, "timestamp": "04:49:45", "text": "是啊，我想我是10点开始的，"}, {"type": "subtitle", "time": 17388.788, "timestamp": "04:49:48", "text": "对吧？大概30、40分钟前。"}, {"type": "subtitle", "time": 17399.91, "timestamp": "04:49:59", "text": "不错。[清嗓子]"}]
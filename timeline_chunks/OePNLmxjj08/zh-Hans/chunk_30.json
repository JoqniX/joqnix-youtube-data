[{"type": "subtitle", "time": 1812.149, "timestamp": "00:30:12", "text": "觉得我需要练习一下"}, {"type": "subtitle", "time": 1813.669, "timestamp": "00:30:13", "text": "伴奏。"}, {"type": "subtitle", "time": 1817.19, "timestamp": "00:30:17", "text": "第二部分我做了，呃，不，不，"}, {"type": "subtitle", "time": 1820.549, "timestamp": "00:30:20", "text": "封面部分我还可以，因为有"}, {"type": "subtitle", "time": 1822.47, "timestamp": "00:30:22", "text": "音频素材，"}, {"type": "subtitle", "time": 1825.496, "timestamp": "00:30:25", "text": "呃，是的，前两句我需要"}, {"type": "subtitle", "time": 1826.47, "timestamp": "00:30:26", "text": "[笑声]"}, {"type": "subtitle", "time": 1829.83, "timestamp": "00:30:29", "text": "配合节奏，我想，"}, {"type": "subtitle", "time": 1840.47, "timestamp": "00:30:40", "text": "稍微用力一点，因为"}, {"type": "subtitle", "time": 1843.11, "timestamp": "00:30:43", "text": "你知道，这是原声的，嗯，"}, {"type": "subtitle", "time": 1851.99, "timestamp": "00:30:51", "text": "[嗤笑]"}, {"type": "subtitle", "time": 1854.549, "timestamp": "00:30:54", "text": "剩下的练习。"}, {"type": "subtitle", "time": 1856.47, "timestamp": "00:30:56", "text": "你好。"}]
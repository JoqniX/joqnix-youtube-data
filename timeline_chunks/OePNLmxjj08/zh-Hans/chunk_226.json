[{"type": "subtitle", "time": 13585.11, "timestamp": "03:46:25", "text": "希望不会收到版权警告，"}, {"type": "subtitle", "time": 13599.349, "timestamp": "03:46:39", "text": "笨蛋。"}, {"type": "subtitle", "time": 13602.79, "timestamp": "03:46:42", "text": "笨手笨脚的人。  Yori Kansuki，"}, {"type": "subtitle", "time": 13605.91, "timestamp": "03:46:45", "text": "Kansuki 的歌真是太棒了，他是一位才华横溢的"}, {"type": "subtitle", "time": 13609.349, "timestamp": "03:46:49", "text": "作曲家，他"}, {"type": "subtitle", "time": 13613.429, "timestamp": "03:46:53", "text": "歌曲中饱含的情感……"}, {"type": "subtitle", "time": 13617.91, "timestamp": "03:46:57", "text": "我好怀念他，他曾经在"}]
[{"type": "subtitle", "time": 15500.07, "timestamp": "04:18:20", "text": "好吧，这就是第一句的全部歌词。好吧，"}, {"type": "subtitle", "time": 15503.83, "timestamp": "04:18:23", "text": "我们必须从头开始用正常"}, {"type": "subtitle", "time": 15510.71, "timestamp": "04:18:30", "text": "。"}, {"type": "subtitle", "time": 15513.349, "timestamp": "04:18:33", "text": "好吧。三，二，一。"}, {"type": "subtitle", "time": 15515.189, "timestamp": "04:18:35", "text": "我为什么要这么快地唱这首歌？我"}, {"type": "subtitle", "time": 15517.11, "timestamp": "04:18:37", "text": "不知道。但我仍然会一边"}, {"type": "subtitle", "time": 15519.269, "timestamp": "04:18:39", "text": "听着"}]
[{"type": "subtitle", "time": 2779.27, "timestamp": "00:46:19", "text": "我的天哪，[笑]"}, {"type": "subtitle", "time": 2781.91, "timestamp": "00:46:21", "text": "那是我第一次没有伴奏"}, {"type": "subtitle", "time": 2784.71, "timestamp": "00:46:24", "text": "带、引导音轨，"}, {"type": "subtitle", "time": 2787.349, "timestamp": "00:46:27", "text": "只有纯音乐，就这么唱，这对我来说是"}, {"type": "subtitle", "time": 2793.43, "timestamp": "00:46:33", "text": "第一次。"}, {"type": "subtitle", "time": 2796.55, "timestamp": "00:46:36", "text": "通常我唱歌的时候，嗯，让"}, {"type": "subtitle", "time": 2798.79, "timestamp": "00:46:38", "text": "我告诉你区别，"}, {"type": "subtitle", "time": 2803.43, "timestamp": "00:46:43", "text": "当我唱娃娃故事的时候，我会用"}, {"type": "subtitle", "time": 2806.63, "timestamp": "00:46:46", "text": "伴奏带，也就是歌曲本身。"}, {"type": "subtitle", "time": 2810.309, "timestamp": "00:46:50", "text": "我给你举个例子，没有"}, {"type": "subtitle", "time": 2812.63, "timestamp": "00:46:52", "text": "引导音轨，"}, {"type": "subtitle", "time": 2814.15, "timestamp": "00:46:54", "text": "嗯，"}, {"type": "subtitle", "time": 2817.03, "timestamp": "00:46:57", "text": "我不知道会不会……就算"}, {"type": "subtitle", "time": 2819.829, "timestamp": "00:46:59", "text": "我用钢琴伴奏"}]
[{"type": "subtitle", "time": 1108.71, "timestamp": "00:18:28", "text": "好的。   顺便说一句"}, {"type": "subtitle", "time": 1113.502, "timestamp": "00:18:33", "text": "，别模仿我唱歌。"}, {"type": "subtitle", "time": 1113.59, "timestamp": "00:18:33", "text": "[笑声]"}, {"type": "subtitle", "time": 1115.99, "timestamp": "00:18:35", "text": "别试着模仿我唱歌，因为我觉得"}, {"type": "subtitle", "time": 1118.71, "timestamp": "00:18:38", "text": "你不太适合。"}, {"type": "subtitle", "time": 1121.669, "timestamp": "00:18:41", "text": "我觉得我在听歌的时候"}, {"type": "subtitle", "time": 1124.71, "timestamp": "00:18:44", "text": "，会努力跟上他们的"}, {"type": "subtitle", "time": 1126.602, "timestamp": "00:18:46", "text": "演唱方式。"}, {"type": "subtitle", "time": 1127.35, "timestamp": "00:18:47", "text": "[笑声]"}, {"type": "subtitle", "time": 1130.23, "timestamp": "00:18:50", "text": "我知道，但这不适合你，小"}, {"type": "subtitle", "time": 1134.07, "timestamp": "00:18:54", "text": "恶魔。 嗯，"}, {"type": "subtitle", "time": 1135.83, "timestamp": "00:18:55", "text": "你唱歌的时候，听歌的音量有多大"}, {"type": "subtitle", "time": 1137.83, "timestamp": "00:18:57", "text": "？"}]
[{"type": "subtitle", "time": 842.389, "timestamp": "00:14:02", "text": "眼睛。"}, {"type": "subtitle", "time": 862.15, "timestamp": "00:14:22", "text": "嘿，（清嗓子）感觉"}, {"type": "subtitle", "time": 863.43, "timestamp": "00:14:23", "text": "怎么样？"}, {"type": "subtitle", "time": 866.069, "timestamp": "00:14:26", "text": "是的，你的声音有点哽咽"}, {"type": "subtitle", "time": 868.389, "timestamp": "00:14:28", "text": "。 零件没问题。"}, {"type": "subtitle", "time": 870.15, "timestamp": "00:14:30", "text": "太好了，终于结束了。"}, {"type": "subtitle", "time": 872.71, "timestamp": "00:14:32", "text": "你旁边有热水吗？"}, {"type": "subtitle", "time": 874.47, "timestamp": "00:14:34", "text": "热水。 是的。 你好。"}, {"type": "subtitle", "time": 876.949, "timestamp": "00:14:36", "text": "我不能喝盐。"}, {"type": "subtitle", "time": 879.67, "timestamp": "00:14:39", "text": "不。我想，为什么我不能像必须"}, {"type": "subtitle", "time": 881.99, "timestamp": "00:14:41", "text": "喝酒一样喝酒呢？ 我的天哪，好性感。"}, {"type": "subtitle", "time": 884.71, "timestamp": "00:14:44", "text": "我的天啊。"}, {"type": "subtitle", "time": 888.629, "timestamp": "00:14:48", "text": "我把沸水倒进了烧瓶里。   我的"}, {"type": "subtitle", "time": 890.71, "timestamp": "00:14:50", "text": "天哪。 在我来这里之前。 我的天，好"}, {"type": "subtitle", "time": 894.47, "timestamp": "00:14:54", "text": "热啊。 是啊，但是盖子很烫。"}, {"type": "subtitle", "time": 898.55, "timestamp": "00:14:58", "text": "不，我没有。 我打开了那个……该怎么"}]
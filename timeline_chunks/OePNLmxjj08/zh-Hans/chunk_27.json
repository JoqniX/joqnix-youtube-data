[{"type": "subtitle", "time": 1621.35, "timestamp": "00:27:01", "text": "不唱歌吗？"}, {"type": "subtitle", "time": 1624.63, "timestamp": "00:27:04", "text": "你觉得哪一个更舒服？"}, {"type": "subtitle", "time": 1627.35, "timestamp": "00:27:07", "text": "哦，我是说，我觉得我唱那首歌的时候表现得"}, {"type": "subtitle", "time": 1629.669, "timestamp": "00:27:09", "text": "更好。 我觉得我不知道"}, {"type": "subtitle", "time": 1633.43, "timestamp": "00:27:13", "text": "你做得怎么样，但是，是的，你必须"}, {"type": "subtitle", "time": 1635.83, "timestamp": "00:27:15", "text": "把握好歌曲的节奏。 我"}, {"type": "subtitle", "time": 1639.35, "timestamp": "00:27:19", "text": "希望你录制的时候也能这样做。"}, {"type": "subtitle", "time": 1642.549, "timestamp": "00:27:22", "text": "不。是的。"}, {"type": "subtitle", "time": 1651.51, "timestamp": "00:27:31", "text": "。 等等，让我……"}, {"type": "subtitle", "time": 1656.47, "timestamp": "00:27:36", "text": "让我等一下。 呃，纯"}, {"type": "subtitle", "time": 1659.11, "timestamp": "00:27:39", "text": "音乐版是什么来着？ 不唱歌，"}, {"type": "subtitle", "time": 1660.07, "timestamp": "00:27:40", "text": "对吧？   是的"}, {"type": "subtitle", "time": 1663.19, "timestamp": "00:27:43", "text": "，一个重点。"}, {"type": "subtitle", "time": 1665.99, "timestamp": "00:27:45", "text": "好的，我下载下来，看看能不能在"}, {"type": "subtitle", "time": 1674.23, "timestamp": "00:27:54", "text": "有引导轨道的情况下完成。"}, {"type": "subtitle", "time": 1678.07, "timestamp": "00:27:58", "text": "我希望，我希望我能做到[笑声]"}]
[{"type": "subtitle", "time": 14786.785, "timestamp": "04:06:26", "text": "这样的。 只是"}, {"type": "subtitle", "time": 14791.37, "timestamp": "04:06:31", "text": "哦，我的天哪。"}, {"type": "subtitle", "time": 14796.55, "timestamp": "04:06:36", "text": "我觉得这是虚拟主播"}, {"type": "subtitle", "time": 14798.469, "timestamp": "04:06:38", "text": "塞娜。"}, {"type": "subtitle", "time": 14801.269, "timestamp": "04:06:41", "text": "他们居然能"}, {"type": "subtitle", "time": 14805.03, "timestamp": "04:06:45", "text": "根据自己的角色和"}, {"type": "subtitle", "time": 14806.71, "timestamp": "04:06:46", "text": "下半身等等制作专属音乐视频，这也太"}, {"type": "subtitle", "time": 14808.79, "timestamp": "04:06:48", "text": "酷了吧！"}, {"type": "subtitle", "time": 14810.55, "timestamp": "04:06:50", "text": "真奇怪，这些日本歌曲的色调都那么"}, {"type": "subtitle", "time": 14813.51, "timestamp": "04:06:53", "text": "红，那么红，但听起来却那么可爱。"}, {"type": "subtitle", "time": 14815.349, "timestamp": "04:06:55", "text": "所以有一首歌，我不"}, {"type": "subtitle", "time": 14816.71, "timestamp": "04:06:56", "text": "知道它叫什么，它有点出名，叫做《Lost"}]
[{"type": "subtitle", "time": 11109.03, "timestamp": "03:05:09", "text": "我理解对吗？"}, {"type": "subtitle", "time": 11111.59, "timestamp": "03:05:11", "text": "我当时正在成为寄养家庭。 这是个好兆头。"}, {"type": "subtitle", "time": 11114.309, "timestamp": "03:05:14", "text": "紧挨着它。"}, {"type": "subtitle", "time": 11117.19, "timestamp": "03:05:17", "text": "眼睛"}]
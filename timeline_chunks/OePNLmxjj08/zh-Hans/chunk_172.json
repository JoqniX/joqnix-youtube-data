[{"type": "subtitle", "time": 10352.63, "timestamp": "02:52:32", "text": "再次。  [咳嗽]"}, {"type": "subtitle", "time": 10356.23, "timestamp": "02:52:36", "text": "兄弟，我需要热水。 我的天哪。"}, {"type": "subtitle", "time": 10359.67, "timestamp": "02:52:39", "text": "我舌头里需要插根骨头。 或许我"}, {"type": "subtitle", "time": 10362.07, "timestamp": "02:52:42", "text": "不知道。 不，我不应该。"}, {"type": "subtitle", "time": 10369.429, "timestamp": "02:52:49", "text": "我的舌头。 呃，好"}, {"type": "subtitle", "time": 10373.11, "timestamp": "02:52:53", "text": "热。 好的。"}, {"type": "subtitle", "time": 10374.79, "timestamp": "02:52:54", "text": "好的。   眼睛"}]
[{"type": "subtitle", "time": 16890.31, "timestamp": "04:41:30", "text": "他們居然能根據自己的角色"}, {"type": "subtitle", "time": 16893.75, "timestamp": "04:41:33", "text": "和下半身等等製作"}, {"type": "subtitle", "time": 16912.07, "timestamp": "04:41:52", "text": "專屬音樂視頻，這也太酷了吧！  真奇怪，這些日本歌曲的色調都那麼紅，那麼紅，但聽起來卻那麼可愛。  所以有一首歌，我不知道它叫什麼，"}]
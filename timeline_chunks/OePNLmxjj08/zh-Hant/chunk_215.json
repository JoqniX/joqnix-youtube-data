[{"type": "subtitle", "time": 12901.19, "timestamp": "03:35:01", "text": "它調到一個速度檔位，看看速度能快"}, {"type": "subtitle", "time": 12902.79, "timestamp": "03:35:02", "text": "多少。  我不能，我不能。太快了。  速度很快。好的。  這"}, {"type": "subtitle", "time": 12908.71, "timestamp": "03:35:08", "text": "首歌的rap部分我聽不懂。  我把它放在這裡。結束了。  這是其中"}, {"type": "subtitle", "time": 12918.389, "timestamp": "03:35:18", "text": "一部分。好的。  我不能。"}]
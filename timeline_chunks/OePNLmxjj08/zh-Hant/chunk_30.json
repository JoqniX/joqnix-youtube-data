[{"type": "subtitle", "time": 1812.149, "timestamp": "00:30:12", "text": "應該不唱歌嗎？  你覺得哪一個比較"}, {"type": "subtitle", "time": 1820.549, "timestamp": "00:30:20", "text": "舒服？  哦，我是說，"}, {"type": "subtitle", "time": 1829.83, "timestamp": "00:30:29", "text": "我覺得我唱那首歌的時候表現得更好。我覺得我不知道"}, {"type": "subtitle", "time": 1843.11, "timestamp": "00:30:43", "text": "你做得怎麼樣，但是，是的，你必須把握好歌曲的節奏"}]
[{"type": "subtitle", "time": 15351.189, "timestamp": "04:15:51", "text": "天哪，"}, {"type": "subtitle", "time": 15354.021, "timestamp": "04:15:54", "text": "我"}, {"type": "subtitle", "time": 15355.83, "timestamp": "04:15:55", "text": "尖叫不出聲。  這首歌真好聽。  必須學會。這將是我第一次學習這首歌。"}, {"type": "subtitle", "time": 15357.75, "timestamp": "04:15:57", "text": "我們將一起學習。每行四行"}]
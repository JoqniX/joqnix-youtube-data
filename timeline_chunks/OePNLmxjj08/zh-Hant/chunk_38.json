[{"type": "subtitle", "time": 2293.589, "timestamp": "00:38:13", "text": "我覺得我可以把它掛起來。我覺得這首歌應該沒有"}, {"type": "subtitle", "time": 2301.19, "timestamp": "00:38:21", "text": "版權問題，"}, {"type": "subtitle", "time": 2304.39, "timestamp": "00:38:24", "text": "但我可以放上來試試能不能跟著唱"}, {"type": "subtitle", "time": 2306.63, "timestamp": "00:38:26", "text": "。  好的。好的。三、二、一。  三，（清嗓子）二，一。  我"}, {"type": "subtitle", "time": 2308.069, "timestamp": "00:38:28", "text": "想（唱）我不。哦，"}, {"type": "subtitle", "time": 2323.43, "timestamp": "00:38:43", "text": "天哪。呃，這是兩行字。我的天，我竟然沒學過這個，兄弟。我的天啊。  我跟不上"}, {"type": "subtitle", "time": 2336.79, "timestamp": "00:38:56", "text": "知道什麼時候該放慢腳步"}]
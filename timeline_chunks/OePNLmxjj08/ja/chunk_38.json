[{"type": "subtitle", "time": 2282.87, "timestamp": "00:38:02", "text": "練習をします。先ほどの質問ですが、チャットでたくさん見かけた質問ですが、"}, {"type": "subtitle", "time": 2289.43, "timestamp": "00:38:09", "text": "YouTubeで"}, {"type": "subtitle", "time": 2291.51, "timestamp": "00:38:11", "text": "歌っている曲を聴かせてもらえますか？"}, {"type": "subtitle", "time": 2293.589, "timestamp": "00:38:13", "text": "正直に言うと、ストリームで演奏するのはあまりできないと思います。インストゥルメンタル"}, {"type": "subtitle", "time": 2299.43, "timestamp": "00:38:19", "text": "部分は"}, {"type": "subtitle", "time": 2301.19, "timestamp": "00:38:21", "text": "著作権で保護される可能性があり、それは"}, {"type": "subtitle", "time": 2304.39, "timestamp": "00:38:24", "text": "大変ですが、"}, {"type": "subtitle", "time": 2306.63, "timestamp": "00:38:26", "text": "何とかしてみます。 心配ない。 やってみます。"}, {"type": "subtitle", "time": 2308.069, "timestamp": "00:38:28", "text": "何とか解決策を見つけよう。"}, {"type": "subtitle", "time": 2317.91, "timestamp": "00:38:37", "text": "、やってみます。"}, {"type": "subtitle", "time": 2319.99, "timestamp": "00:38:39", "text": "ええと、わかりました"}, {"type": "subtitle", "time": 2323.43, "timestamp": "00:38:43", "text": "。 えっと、私のGoogleはどこ？"}, {"type": "subtitle", "time": 2332.471, "timestamp": "00:38:52", "text": "えっと、"}, {"type": "subtitle", "time": 2334.39, "timestamp": "00:38:54", "text": "[うめき声]"}, {"type": "subtitle", "time": 2336.79, "timestamp": "00:38:56", "text": "待って。"}]
[{"type": "subtitle", "time": 13345.11, "timestamp": "03:42:25", "text": "時々、今歌っていると、歌えば歌うほど、眠くなっていくような気がします。"}, {"type": "subtitle", "time": 13354.389, "timestamp": "03:42:34", "text": "退屈だからでしょうか、それとも"}, {"type": "subtitle", "time": 13358.15, "timestamp": "03:42:38", "text": "エネルギーを使いすぎて"}, {"type": "subtitle", "time": 13360.63, "timestamp": "03:42:40", "text": "体と心身ともに"}, {"type": "subtitle", "time": 13375.91, "timestamp": "03:42:55", "text": "ウェブサイトを作るために12時間も座っていられるのに、"}, {"type": "subtitle", "time": 13379.11, "timestamp": "03:42:59", "text": "ゲームも同じで苦痛なのに、もう"}]
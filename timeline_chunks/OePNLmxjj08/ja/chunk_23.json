[{"type": "subtitle", "time": 1419.27, "timestamp": "00:23:39", "text": "私は「"}, {"type": "subtitle", "time": 1423.27, "timestamp": "00:23:43", "text": "はい」と言って、カウの部分にもっと力を加えようとしました"}, {"type": "subtitle", "time": 1425.029, "timestamp": "00:23:45", "text": "。"}, {"type": "subtitle", "time": 1429.43, "timestamp": "00:23:49", "text": "ああ、カウ。 わかった。 こんにちは。   そうだよね"}, {"type": "subtitle", "time": 1431.99, "timestamp": "00:23:51", "text": "。 私が歌うのとは全く違う"}, {"type": "subtitle", "time": 1433.59, "timestamp": "00:23:53", "text": "けど、ほら、"}, {"type": "subtitle", "time": 1434.789, "timestamp": "00:23:54", "text": "違いが分かるでしょ。"}, {"type": "subtitle", "time": 1437.19, "timestamp": "00:23:57", "text": "うん。 うん。   まるで"}]
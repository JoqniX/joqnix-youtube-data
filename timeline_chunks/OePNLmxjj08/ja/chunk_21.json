[{"type": "subtitle", "time": 1261.43, "timestamp": "00:21:01", "text": "。"}, {"type": "subtitle", "time": 1265.83, "timestamp": "00:21:05", "text": "うん。 何てことだ。"}, {"type": "subtitle", "time": 1271.029, "timestamp": "00:21:11", "text": "よし、私がやろう。 こんにちは、ちょっと待ってください"}, {"type": "subtitle", "time": 1273.669, "timestamp": "00:21:13", "text": "。 えっと、"}, {"type": "subtitle", "time": 1279.029, "timestamp": "00:21:19", "text": "Fの部分をFonと間違えて、"}, {"type": "subtitle", "time": 1281.51, "timestamp": "00:21:21", "text": "Kの音が聞こえません。 私はTの"}, {"type": "subtitle", "time": 1283.43, "timestamp": "00:21:23", "text": "音が聞こえる。  [笑い]"}, {"type": "subtitle", "time": 1290.39, "timestamp": "00:21:30", "text": "[咳払い]"}, {"type": "subtitle", "time": 1291.669, "timestamp": "00:21:31", "text": "こんにちは。"}, {"type": "subtitle", "time": 1294.149, "timestamp": "00:21:34", "text": "私の声を真似しないでください。"}, {"type": "subtitle", "time": 1297.43, "timestamp": "00:21:37", "text": "表紙を作り直した方がいい気がする。 私は自分の"}, {"type": "subtitle", "time": 1301.029, "timestamp": "00:21:41", "text": "歌い方が気に入っているけど、"}, {"type": "subtitle", "time": 1303.11, "timestamp": "00:21:43", "text": "あなたにとっては歌うのが難しすぎるかもしれないね。"}, {"type": "subtitle", "time": 1306.549, "timestamp": "00:21:46", "text": "いいえ、両方ともやりました。 あなたの"}, {"type": "subtitle", "time": 1315.27, "timestamp": "00:21:55", "text": "[笑い]"}, {"type": "subtitle", "time": 1319.99, "timestamp": "00:21:59", "text": "もっと練習する必要があると思います。 おそらく、"}]
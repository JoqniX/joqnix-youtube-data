[{"type": "subtitle", "time": 1564.802, "timestamp": "00:26:04", "text": "ああ、また日と言いました。 いいえ。さようなら。"}, {"type": "subtitle", "time": 1565.43, "timestamp": "00:26:05", "text": "[笑い声とため息]"}, {"type": "subtitle", "time": 1569.269, "timestamp": "00:26:09", "text": "それに、カメラカバーの「あーあー」を付け忘れたと"}, {"type": "subtitle", "time": 1572.47, "timestamp": "00:26:12", "text": "思う。   そうそう"}, {"type": "subtitle", "time": 1575.909, "timestamp": "00:26:15", "text": "。 うん。 ところで、あまり"}, {"type": "subtitle", "time": 1579.35, "timestamp": "00:26:19", "text": "ハイになりすぎないようにしてください。"}, {"type": "subtitle", "time": 1581.19, "timestamp": "00:26:21", "text": "すごく高いのは分かっていますが、そんなに"}, {"type": "subtitle", "time": 1588.39, "timestamp": "00:26:28", "text": "。 わかった。 わかった。"}, {"type": "subtitle", "time": 1590.31, "timestamp": "00:26:30", "text": "うん。   わかった"}, {"type": "subtitle", "time": 1594.39, "timestamp": "00:26:34", "text": "。 だから、普通に振る舞うべきだ。"}, {"type": "subtitle", "time": 1595.669, "timestamp": "00:26:35", "text": "うん。"}, {"type": "subtitle", "time": 1597.43, "timestamp": "00:26:37", "text": "普段の声域で話すように心がけてください"}, {"type": "subtitle", "time": 1599.029, "timestamp": "00:26:39", "text": "。   わかった"}, {"type": "subtitle", "time": 1601.35, "timestamp": "00:26:41", "text": "。 こんにちは。"}, {"type": "subtitle", "time": 1604.31, "timestamp": "00:26:44", "text": "うん。 もう一度。"}, {"type": "subtitle", "time": 1606.549, "timestamp": "00:26:46", "text": "こんにちは。"}, {"type": "subtitle", "time": 1609.43, "timestamp": "00:26:49", "text": "もう一度。"}, {"type": "subtitle", "time": 1618.63, "timestamp": "00:26:58", "text": "えっと、わかりました。  [咳払い]"}]
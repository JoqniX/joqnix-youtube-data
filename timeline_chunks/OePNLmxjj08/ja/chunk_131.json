[{"type": "subtitle", "time": 7861.669, "timestamp": "02:11:01", "text": "あなたの言っていることは意味不明です。 パカ。"}, {"type": "subtitle", "time": 7864.47, "timestamp": "02:11:04", "text": "あと、実はシャワルマも食べたんです。"}, {"type": "subtitle", "time": 7866.55, "timestamp": "02:11:06", "text": "これはシャワルマだと思います。 高級"}, {"type": "subtitle", "time": 7868.709, "timestamp": "02:11:08", "text": "料理は何と呼ばれますか？ これはシャワルマだと思います。 私は思う。"}, {"type": "subtitle", "time": 7874.229, "timestamp": "02:11:14", "text": "うん、これは高級料理みたいなものだね。"}, {"type": "subtitle", "time": 7878.39, "timestamp": "02:11:18", "text": "こんな食べ物を食べるのは本当に久しぶりだ。   だから"}, {"type": "subtitle", "time": 7879.91, "timestamp": "02:11:19", "text": "、久しぶりに食べられるから"}, {"type": "subtitle", "time": 7882.47, "timestamp": "02:11:22", "text": "嬉しい。 よし、私もやってみよう。   一口食べてみてください"}]
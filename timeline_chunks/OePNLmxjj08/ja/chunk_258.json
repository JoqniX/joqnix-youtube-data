[{"type": "subtitle", "time": 15500.07, "timestamp": "04:18:20", "text": "これが最初の行全体。オーケー、"}, {"type": "subtitle", "time": 15510.71, "timestamp": "04:18:30", "text": "最初から通常のスピードにしないと。"}, {"type": "subtitle", "time": 15513.349, "timestamp": "04:18:33", "text": "オーケー。3、2、1。"}, {"type": "subtitle", "time": 15515.189, "timestamp": "04:18:35", "text": "なんでこの曲をスピードランしてるんだろう？わから"}, {"type": "subtitle", "time": 15517.11, "timestamp": "04:18:37", "text": "ない。でも、それでも、元の"}]
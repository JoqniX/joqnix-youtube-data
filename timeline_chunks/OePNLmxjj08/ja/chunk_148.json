[{"type": "subtitle", "time": 8881.59, "timestamp": "02:28:01", "text": "[ため息] じゃあ、そうしよう。"}, {"type": "subtitle", "time": 8884.469, "timestamp": "02:28:04", "text": "またアイスクリームの歌だ。"}, {"type": "subtitle", "time": 8897.75, "timestamp": "02:28:17", "text": "うん、ラップの部分は僕たちがやるよ。"}, {"type": "subtitle", "time": 8900.63, "timestamp": "02:28:20", "text": "えっと、"}, {"type": "subtitle", "time": 8903.27, "timestamp": "02:28:23", "text": "神様、私たちがああ神様、ちょっと"}, {"type": "subtitle", "time": 8922.389, "timestamp": "02:28:42", "text": "こんにちは。"}, {"type": "subtitle", "time": 8926.63, "timestamp": "02:28:46", "text": "ロビーをお楽しみください。 音楽を楽しんでください。   それ以上あれば"}]
[{"type": "subtitle", "time": 2042.47, "timestamp": "00:34:02", "text": "いいえ。"}, {"type": "subtitle", "time": 2047.029, "timestamp": "00:34:07", "text": "ああ、神様。 えっと、これは2行でした。 ああ、そんなこと習ってなかったよ"}, {"type": "subtitle", "time": 2050.629, "timestamp": "00:34:10", "text": "、兄弟。 何てことだ。"}, {"type": "subtitle", "time": 2053.589, "timestamp": "00:34:13", "text": "追いつけない。 いつペースを落とすべきか分からない"}, {"type": "subtitle", "time": 2055.75, "timestamp": "00:34:15", "text": "。"}, {"type": "subtitle", "time": 2057.51, "timestamp": "00:34:17", "text": "ああ、いつペースを落とすべきか分からないんだ。"}, {"type": "subtitle", "time": 2061.909, "timestamp": "00:34:21", "text": "正直、追いつけません。"}, {"type": "subtitle", "time": 2064.95, "timestamp": "00:34:24", "text": "牛のやつだけ。 こういう"}, {"type": "subtitle", "time": 2067.51, "timestamp": "00:34:27", "text": "音声の合図があるから、どこにいるか分かるんだ"}, {"type": "subtitle", "time": 2078.23, "timestamp": "00:34:38", "text": "そう、それが"}, {"type": "subtitle", "time": 2083.109, "timestamp": "00:34:43", "text": "私に「うん」という声の合図を与えてくれる。 音声"}, {"type": "subtitle", "time": 2085.75, "timestamp": "00:34:45", "text": "キューで「うん」とします。 次は、"}, {"type": "subtitle", "time": 2096.55, "timestamp": "00:34:56", "text": "ああ神様という詩です。 最初の30秒。"}, {"type": "subtitle", "time": 2099.19, "timestamp": "00:34:59", "text": "うん。"}]
[{"type": "subtitle", "time": 4391.11, "timestamp": "01:13:11", "text": "私はたくさんの間違いを犯しました。 ああ、すごい量だ"}, {"type": "subtitle", "time": 4404.63, "timestamp": "01:13:24", "text": "オーマイゴッド」の代わりに、私はこう言いましたか。   ジョー、"}, {"type": "subtitle", "time": 4409.11, "timestamp": "01:13:29", "text": "元気？ 今日は調子がいいです。"}, {"type": "subtitle", "time": 4412.149, "timestamp": "01:13:32", "text": "どうしたの？ あなたは悲しいですか？ 元気づける。"}, {"type": "subtitle", "time": 4414.79, "timestamp": "01:13:34", "text": "音楽を聴いてみよう。 アニメって何？"}, {"type": "subtitle", "time": 4417.83, "timestamp": "01:13:37", "text": "気を紛らわせましょう。   まだここにいるなら、あまり"}, {"type": "subtitle", "time": 4420.47, "timestamp": "01:13:40", "text": "悲しまないで"}, {"type": "subtitle", "time": 4427.189, "timestamp": "01:13:47", "text": "では、ボーカル"}, {"type": "subtitle", "time": 4428.95, "timestamp": "01:13:48", "text": "リードトラックに合わせて歌いましょう。 これについてはもっと練習が必要だ"}, {"type": "subtitle", "time": 4431.91, "timestamp": "01:13:51", "text": "。 ええと、わかりました"}]
[{"type": "subtitle", "time": 15072.63, "timestamp": "04:11:12", "text": "？ ねえ、どこが？"}, {"type": "subtitle", "time": 15080.229, "timestamp": "04:11:20", "text": "えっと、"}, {"type": "subtitle", "time": 15082.15, "timestamp": "04:11:22", "text": "溶けた"}, {"type": "subtitle", "time": 15085.269, "timestamp": "04:11:25", "text": "場所を忘れてた。 待って、"}, {"type": "subtitle", "time": 15087.59, "timestamp": "04:11:27", "text": "テーブル。"}, {"type": "subtitle", "time": 15089.51, "timestamp": "04:11:29", "text": "いいえ、うまくいきません。 待って、忘れてた。"}, {"type": "subtitle", "time": 15091.91, "timestamp": "04:11:31", "text": "その曲はどこにあるの？"}, {"type": "subtitle", "time": 15095.59, "timestamp": "04:11:35", "text": "私があなたを必要としている時、あなたはここにいない。  N."}]
[{"type": "subtitle", "time": 11109.03, "timestamp": "03:05:09", "text": "私の理解は合っていますか？"}, {"type": "subtitle", "time": 11111.59, "timestamp": "03:05:11", "text": "私は里親になることになっていた。 それは良い兆候だ。   そのすぐ隣だ"}, {"type": "subtitle", "time": 11114.309, "timestamp": "03:05:14", "text": "。"}, {"type": "subtitle", "time": 11117.19, "timestamp": "03:05:17", "text": "目は"}]
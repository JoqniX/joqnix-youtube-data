[{"type": "subtitle", "time": 10107.429, "timestamp": "02:48:27", "text": "。 作業量が多すぎる。"}, {"type": "subtitle", "time": 10109.349, "timestamp": "02:48:29", "text": "これは早口で言わなければならない。 これはすごくスローモーションですね"}, {"type": "subtitle", "time": 10111.67, "timestamp": "02:48:31", "text": "。 早口で言わなきゃいけないよね？ ああ、"}, {"type": "subtitle", "time": 10114.07, "timestamp": "02:48:34", "text": "神様。 速度を1段階に下げて、どれくらい"}, {"type": "subtitle", "time": 10136.389, "timestamp": "02:48:56", "text": "ない。 速すぎる。"}, {"type": "subtitle", "time": 10138.95, "timestamp": "02:48:58", "text": "速い。 わかった。"}]
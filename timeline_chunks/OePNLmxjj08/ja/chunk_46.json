[{"type": "subtitle", "time": 2779.27, "timestamp": "00:46:19", "text": "ああ、なんてことだ、[笑い] リード"}, {"type": "subtitle", "time": 2784.71, "timestamp": "00:46:24", "text": "トラックやガイドトラックなしで歌うのは初めてで、インス"}, {"type": "subtitle", "time": 2787.349, "timestamp": "00:46:27", "text": "トゥルメンタルだけで歌うのは初めてで、インス"}, {"type": "subtitle", "time": 2789.75, "timestamp": "00:46:29", "text": "トゥルメンタルだけで歌うのは初めてで、普段歌うときは、"}, {"type": "subtitle", "time": 2798.79, "timestamp": "00:46:38", "text": "違いを教えてあげよう、"}, {"type": "subtitle", "time": 2803.43, "timestamp": "00:46:43", "text": "人形の物語を歌うときは、リード"}, {"type": "subtitle", "time": 2806.63, "timestamp": "00:46:46", "text": "トラック、実際の歌を使うんだけど、"}, {"type": "subtitle", "time": 2812.63, "timestamp": "00:46:52", "text": "ガイドトラックを聴きながら歌うのは、"}, {"type": "subtitle", "time": 2814.15, "timestamp": "00:46:54", "text": "いいかな、"}, {"type": "subtitle", "time": 2819.829, "timestamp": "00:46:59", "text": "ピアノのインストゥルメンタルを入れたとしても"}]
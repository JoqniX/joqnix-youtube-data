[{"type": "subtitle", "time": 1921.84, "timestamp": "00:32:01", "text": "モラルのバージョンはどこにあるの？ これです？ ああ、 これだ。"}, {"type": "subtitle", "time": 1925.067, "timestamp": "00:32:05", "text": "これだ。 [ため息]"}, {"type": "subtitle", "time": 1926.88, "timestamp": "00:32:06", "text": "[ため息] D."}, {"type": "subtitle", "time": 1945.669, "timestamp": "00:32:25", "text": "わかった。 これですよね？"}, {"type": "subtitle", "time": 1950.71, "timestamp": "00:32:30", "text": "あ、待って。 配信でプレイしています。 ごめんなさい"}, {"type": "subtitle", "time": 1954.31, "timestamp": "00:32:34", "text": "。 わかった。"}, {"type": "subtitle", "time": 1957.19, "timestamp": "00:32:37", "text": "これなら掲載できると思います。 この曲は"}, {"type": "subtitle", "time": 1960.149, "timestamp": "00:32:40", "text": "著作権の対象ではないと思うけど、これを載せて"}, {"type": "subtitle", "time": 1963.509, "timestamp": "00:32:43", "text": "一緒に歌えるかどうか試してみようかな。   わかった"}]
[{"type": "subtitle", "time": 13620.87, "timestamp": "03:47:00", "text": "神月"}, {"type": "subtitle", "time": 13626.112, "timestamp": "03:47:06", "text": "スタジオを卒業して自分の道を歩むために去ってしまったことが本当に残念だ。"}, {"type": "subtitle", "time": 13627.99, "timestamp": "03:47:07", "text": "[ため息と息を呑む] 彼は本当に伝説的な存在だ。"}, {"type": "subtitle", "time": 13640.522, "timestamp": "03:47:20", "text": "パンプシーマン。"}, {"type": "subtitle", "time": 13643.67, "timestamp": "03:47:23", "text": "[ため息をつき、息を呑む] ええと、アルバムアートのことです。"}, {"type": "subtitle", "time": 13679.189, "timestamp": "03:47:59", "text": "。  ３、２、１。 さあ行こう。"}]
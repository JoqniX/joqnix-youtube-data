[{"type": "subtitle", "time": 7621.75, "timestamp": "02:07:01", "text": "それは、ゴーフィード咳によるアイスクリームでしたが、ええと、"}, {"type": "subtitle", "time": 7625.189, "timestamp": "02:07:05", "text": "ニーナカバーニーナは去ったと"}, {"type": "subtitle", "time": 7627.189, "timestamp": "02:07:07", "text": "思います、もし私が"}, {"type": "subtitle", "time": 7630.87, "timestamp": "02:07:10", "text": "正しければ、ニーナはヴァルを去ったと思います"}, {"type": "subtitle", "time": 7633.109, "timestamp": "02:07:13", "text": "。"}, {"type": "subtitle", "time": 7637.189, "timestamp": "02:07:17", "text": "彼女はそうしたのか？ 実は忘れていました。"}, {"type": "subtitle", "time": 7640.629, "timestamp": "02:07:20", "text": "ニーナはマリスを辞めたんじゃないの？それともまだ辞めてるの？"}, {"type": "subtitle", "time": 7643.109, "timestamp": "02:07:23", "text": "うん。 うん。 彼女は去った。 はい。 はい。"}, {"type": "subtitle", "time": 7645.109, "timestamp": "02:07:25", "text": "はい。 はい。 はい。 はい。 彼女は男を捨てた。 彼女は本当に"}, {"type": "subtitle", "time": 7646.629, "timestamp": "02:07:26", "text": "歌が上手かった。 彼女の"}]
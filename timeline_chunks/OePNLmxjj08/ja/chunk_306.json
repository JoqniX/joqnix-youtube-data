[{"type": "subtitle", "time": 18360.55, "timestamp": "05:06:00", "text": "それから私の昔の歌。"}, {"type": "subtitle", "time": 18363.91, "timestamp": "05:06:03", "text": "これは私が初めて覚えた歌で、まだ"}, {"type": "subtitle", "time": 18370.23, "timestamp": "05:06:10", "text": "歌えない。"}, {"type": "subtitle", "time": 18372.31, "timestamp": "05:06:12", "text": "うん、その歌もいつかカバーして"}, {"type": "subtitle", "time": 18374.948, "timestamp": "05:06:14", "text": "覚えるよ。[笑い]"}, {"type": "subtitle", "time": 18378.192, "timestamp": "05:06:18", "text": "こんにちは。"}, {"type": "subtitle", "time": 18379.502, "timestamp": "05:06:19", "text": "[ため息]"}]
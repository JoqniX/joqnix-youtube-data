[{"type": "subtitle", "time": 7688.149, "timestamp": "02:08:08", "text": "これは一体何ですか？  [笑い]"}, {"type": "subtitle", "time": 7695.51, "timestamp": "02:08:15", "text": "50件の寄付は直接当団体に届きます。"}, {"type": "subtitle", "time": 7698.95, "timestamp": "02:08:18", "text": "くそ。 私は34Z3000がほぼ好きです"}, {"type": "subtitle", "time": 7701.43, "timestamp": "02:08:21", "text": "。 待って、それは"}, {"type": "subtitle", "time": 7703.51, "timestamp": "02:08:23", "text": "あなたが買うお金の額です。"}, {"type": "subtitle", "time": 7720.629, "timestamp": "02:08:40", "text": "おお、いいね。"}, {"type": "subtitle", "time": 7725.109, "timestamp": "02:08:45", "text": "1万円。  [息を呑む] ええ。 うん。"}]
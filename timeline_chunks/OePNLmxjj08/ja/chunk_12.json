[{"type": "subtitle", "time": 720.55, "timestamp": "00:12:00", "text": "。 例えばGの音はかなり"}, {"type": "subtitle", "time": 723.43, "timestamp": "00:12:03", "text": "静かです。 それが私の気持ちです。 なんだか"}, {"type": "subtitle", "time": 725.829, "timestamp": "00:12:05", "text": "静かすぎる気がする。"}, {"type": "subtitle", "time": 727.99, "timestamp": "00:12:07", "text": "歌ってはいるんだ"}, {"type": "subtitle", "time": 735.99, "timestamp": "00:12:15", "text": "私はただその歌詞を歌うだけです。"}, {"type": "subtitle", "time": 738.183, "timestamp": "00:12:18", "text": "いいえ、私はその歌詞を歌います。 わかった。"}, {"type": "subtitle", "time": 755.509, "timestamp": "00:12:35", "text": "？ うん。 うん。 うん。"}, {"type": "subtitle", "time": 758.488, "timestamp": "00:12:38", "text": "ついに現れたね（笑）"}, {"type": "subtitle", "time": 767.003, "timestamp": "00:12:47", "text": "。"}, {"type": "subtitle", "time": 768.389, "timestamp": "00:12:48", "text": "[笑い]"}, {"type": "subtitle", "time": 771.829, "timestamp": "00:12:51", "text": "テア。 何てことだ。"}, {"type": "subtitle", "time": 773.269, "timestamp": "00:12:53", "text": "これは"}]
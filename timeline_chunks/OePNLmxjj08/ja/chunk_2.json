[{"type": "subtitle", "time": 127.19, "timestamp": "00:02:07", "text": "こんにちは。"}, {"type": "chat", "time": 128.597, "timestamp": "00:02:08", "author": "@AFroznThorn", "avatar": "https://yt4.ggpht.com/UOd53-ssefezO2JWGQi-gSpM4zglLHS2XVfc2UQu3E-TdNk2KGnAZtWYAYqQBudbEouoIqf3=s64-c-k-c0x00ffffff-no-rj", "message": "can we hear on yt tho? your singing and music"}, {"type": "subtitle", "time": 131.27, "timestamp": "00:02:11", "text": "おい。 ストリーミング配信していますか？"}, {"type": "subtitle", "time": 133.75, "timestamp": "00:02:13", "text": "はい、配信中です。 デプロイストリーム"}, {"type": "subtitle", "time": 135.27, "timestamp": "00:02:15", "text": "も同様です。   わかった"}, {"type": "subtitle", "time": 136.47, "timestamp": "00:02:16", "text": "。 わかった。   久しぶりですね"}, {"type": "subtitle", "time": 140.161, "timestamp": "00:02:20", "text": "。"}, {"type": "subtitle", "time": 141.589, "timestamp": "00:02:21", "text": "[笑い]"}, {"type": "subtitle", "time": 144.15, "timestamp": "00:02:24", "text": "君の睡眠は、"}, {"type": "subtitle", "time": 147.11, "timestamp": "00:02:27", "text": "今すごく寝てないの？それとも、"}, {"type": "subtitle", "time": 148.949, "timestamp": "00:02:28", "text": "君の睡眠は、君が"}, {"type": "subtitle", "time": 149.75, "timestamp": "00:02:29", "text": "めちゃくちゃだからだよ。  [笑い]"}, {"type": "subtitle", "time": 151.03, "timestamp": "00:02:31", "text": "ええ、"}, {"type": "subtitle", "time": 155.11, "timestamp": "00:02:35", "text": "今日のようにね。 夜10時か11時頃に寝たと思う。   私は"}, {"type": "subtitle", "time": 158.55, "timestamp": "00:02:38", "text": "推測する。"}, {"type": "subtitle", "time": 160.79, "timestamp": "00:02:40", "text": "なぜ夜眠れなかったのか、自分でもわからない"}, {"type": "subtitle", "time": 164.39600000000002, "timestamp": "00:02:44", "text": "。"}, {"type": "subtitle", "time": 165.11, "timestamp": "00:02:45", "text": "[笑い]"}, {"type": "subtitle", "time": 168.55, "timestamp": "00:02:48", "text": "私は6時か7時まで起きていて、"}, {"type": "subtitle", "time": 171.11, "timestamp": "00:02:51", "text": "お茶を飲んで、ストリーミング配信をして、"}, {"type": "subtitle", "time": 174.07, "timestamp": "00:02:54", "text": "一日中寝て、"}, {"type": "subtitle", "time": 176.869, "timestamp": "00:02:56", "text": "夕方に起きて"}, {"type": "subtitle", "time": 179.75, "timestamp": "00:02:59", "text": "太陽を楽しむのが好きでした。 すると、「私もそうしたい」と思って、そのことを"}]
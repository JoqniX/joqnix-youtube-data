[{"type": "subtitle", "time": 12875.03, "timestamp": "03:34:35", "text": "これ、叫ばなきゃいけないよね？ ああ、"}, {"type": "subtitle", "time": 12879.349, "timestamp": "03:34:39", "text": "最後の光に向かって叫ばなきゃ。 ああ、神様、"}, {"type": "subtitle", "time": 12881.269, "timestamp": "03:34:41", "text": "私は死にたくない。 私はそれを声を張り上げて叫ぶだろう"}]
[{"type": "subtitle", "time": 1813.669, "timestamp": "00:30:13", "text": "楽器で練習する必要があると思います。"}, {"type": "subtitle", "time": 1817.19, "timestamp": "00:30:17", "text": "2番目の部分は、いやいや、"}, {"type": "subtitle", "time": 1820.549, "timestamp": "00:30:20", "text": "カバーの部分は大丈夫でした。オーディオ品質があったので、"}, {"type": "subtitle", "time": 1825.496, "timestamp": "00:30:25", "text": "最初の2行は"}, {"type": "subtitle", "time": 1829.83, "timestamp": "00:30:29", "text": "タイミングを合わせる必要がありました。[笑い]"}, {"type": "subtitle", "time": 1840.47, "timestamp": "00:30:40", "text": "少し強く、アコースティックなので、強くしようとしました"}, {"type": "subtitle", "time": 1851.99, "timestamp": "00:30:51", "text": "[鼻を鳴らす]"}, {"type": "subtitle", "time": 1854.549, "timestamp": "00:30:54", "text": "練習の残り。"}, {"type": "subtitle", "time": 1856.47, "timestamp": "00:30:56", "text": "こんにちは。"}]
[{"type": "subtitle", "time": 600.71, "timestamp": "00:10:00", "text": "私たちは練習セッションを行っていますが、今回は"}, {"type": "subtitle", "time": 603.11, "timestamp": "00:10:03", "text": "私の今日の練習を見守っていきましょう"}, {"type": "subtitle", "time": 609.35, "timestamp": "00:10:09", "text": "こんにちは。[咳払い] また"}, {"type": "subtitle", "time": 615.67, "timestamp": "00:10:15", "text": "皆さん、水を飲んでください。 私も"}, {"type": "subtitle", "time": 618.069, "timestamp": "00:10:18", "text": "水を飲みます。"}, {"type": "subtitle", "time": 620.069, "timestamp": "00:10:20", "text": "あなたはどれくらいの時間、水を飲みますか？ 例えば、"}, {"type": "subtitle", "time": 622.63, "timestamp": "00:10:22", "text": "歌を歌うとき、ワンテイクごとに"}, {"type": "subtitle", "time": 625.43, "timestamp": "00:10:25", "text": "飲むんだよね？ つまり、私は"}, {"type": "subtitle", "time": 628.31, "timestamp": "00:10:28", "text": "水を飲まないのですが、そうですね、録音中は"}]
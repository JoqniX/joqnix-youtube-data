[{"type": "subtitle", "time": 17827.67, "timestamp": "04:57:07", "text": "今気づいた。"}, {"type": "subtitle", "time": 17838.868, "timestamp": "04:57:18", "text": "続きは次の配信で。"}, {"type": "subtitle", "time": 17841.51, "timestamp": "04:57:21", "text": "みんな、誰かが"}, {"type": "subtitle", "time": 17847.35, "timestamp": "04:57:27", "text": "でも、ちゃんと時間をかけて"}, {"type": "subtitle", "time": 17852.07, "timestamp": "04:57:32", "text": "ゆっくり覚えるのはいいことだ。いいことだ。"}, {"type": "subtitle", "time": 17853.59, "timestamp": "04:57:33", "text": "あちこちで間違いを犯していてもいいことだ"}, {"type": "subtitle", "time": 17856.708, "timestamp": "04:57:36", "text": "。それでいいんだ"}]
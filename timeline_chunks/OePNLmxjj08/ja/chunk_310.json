[{"type": "subtitle", "time": 18600.47, "timestamp": "05:10:00", "text": "この歌をしばらく聴いていない。"}, {"type": "subtitle", "time": 18603.03, "timestamp": "05:10:03", "text": "まだ覚えていると思うけど、[笑い] いくつかの行をきちんと読むことができなかった。"}, {"type": "subtitle", "time": 18608.15, "timestamp": "05:10:08", "text": "それは悪いけど、まあ"}, {"type": "subtitle", "time": 18609.99, "timestamp": "05:10:09", "text": "いい。[息を呑んでため息をつく] でも、"}, {"type": "subtitle", "time": 18613.75, "timestamp": "05:10:13", "text": "頑張ったからいい。"}, {"type": "subtitle", "time": 18616.39, "timestamp": "05:10:16", "text": "とにかく、12時だ。そろそろ終わりにしようと"}, {"type": "subtitle", "time": 18620.39, "timestamp": "05:10:20", "text": "思う。"}, {"type": "subtitle", "time": 18645.51, "timestamp": "05:10:45", "text": "ええ、新曲を2曲追加しました。"}, {"type": "subtitle", "time": 18648.23, "timestamp": "05:10:48", "text": "新曲を2曲、"}, {"type": "subtitle", "time": 18651.27, "timestamp": "05:10:51", "text": "さらに1曲を練習して、3曲を改訂しました"}, {"type": "subtitle", "time": 18653.83, "timestamp": "05:10:53", "text": "。"}]
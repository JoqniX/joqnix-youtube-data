[{"type": "subtitle", "time": 243.83, "timestamp": "00:04:03", "text": "始まるのかは分かりません。 ええ、確かにそういう"}, {"type": "subtitle", "time": 245.03, "timestamp": "00:04:05", "text": "機会ですね。"}, {"type": "subtitle", "time": 245.50900000000001, "timestamp": "00:04:05", "text": "こんにちは。"}, {"type": "subtitle", "time": 249.35, "timestamp": "00:04:09", "text": "では、早速練習を始めましょうか"}, {"type": "subtitle", "time": 250.63, "timestamp": "00:04:10", "text": "？"}, {"type": "subtitle", "time": 252.39, "timestamp": "00:04:12", "text": "はい。"}, {"type": "subtitle", "time": 253.03, "timestamp": "00:04:13", "text": "こんにちは。   わかった"}, {"type": "subtitle", "time": 256.629, "timestamp": "00:04:16", "text": "。 君はそれを練習するんだ。ほら、このくらいの"}, {"type": "subtitle", "time": 259.99, "timestamp": "00:04:19", "text": "練習を"}, {"type": "subtitle", "time": 263.189, "timestamp": "00:04:23", "text": "10回くらい繰り返すんだ。"}, {"type": "subtitle", "time": 265.749, "timestamp": "00:04:25", "text": "音声なしで5回、つまり、そうです。"}, {"type": "subtitle", "time": 267.35, "timestamp": "00:04:27", "text": "音声なしの場合と、音声ありの場合をそれぞれ5回ずつ"}, {"type": "subtitle", "time": 268.39, "timestamp": "00:04:28", "text": "。"}, {"type": "subtitle", "time": 268.71, "timestamp": "00:04:28", "text": "わかった。"}, {"type": "subtitle", "time": 269.35, "timestamp": "00:04:29", "text": "こんにちは。"}, {"type": "subtitle", "time": 283.67, "timestamp": "00:04:43", "text": "ああ、神様。"}, {"type": "subtitle", "time": 285.67, "timestamp": "00:04:45", "text": "配信でこれをやるのは初めてです。"}, {"type": "subtitle", "time": 287.749, "timestamp": "00:04:47", "text": "そう、みんなが僕が"}, {"type": "subtitle", "time": 290.39, "timestamp": "00:04:50", "text": "君と練習するのを聴いてくれるんだ。 わーい。 いや、"}, {"type": "subtitle", "time": 292.39, "timestamp": "00:04:52", "text": "以前にもやったことがあると思う。 ええ、以前にもやったことがあります。"}, {"type": "subtitle", "time": 293.43, "timestamp": "00:04:53", "text": "うん。 そうだ"}, {"type": "subtitle", "time": 295.51, "timestamp": "00:04:55", "text": "けど、配信中だよ。"}, {"type": "subtitle", "time": 296.71, "timestamp": "00:04:56", "text": "しかし、配信ではそうはなりません。"}, {"type": "subtitle", "time": 299.59000000000003, "timestamp": "00:04:59", "text": "はい、今回が初めての配信です。"}]
[{"type": "subtitle", "time": 842.389, "timestamp": "00:14:02", "text": "目のために。"}, {"type": "subtitle", "time": 862.15, "timestamp": "00:14:22", "text": "やあ、[咳払い]"}, {"type": "subtitle", "time": 863.43, "timestamp": "00:14:23", "text": "どうだった？"}, {"type": "subtitle", "time": 866.069, "timestamp": "00:14:26", "text": "ええ、あなたの声が少し震えていましたよ"}, {"type": "subtitle", "time": 868.389, "timestamp": "00:14:28", "text": "。 部品自体は問題なかった。"}, {"type": "subtitle", "time": 870.15, "timestamp": "00:14:30", "text": "やったー、やっとだ。   お"}, {"type": "subtitle", "time": 872.71, "timestamp": "00:14:32", "text": "近くに温水はありますか？"}, {"type": "subtitle", "time": 874.47, "timestamp": "00:14:34", "text": "お湯。 はい。 こんにちは。"}, {"type": "subtitle", "time": 876.949, "timestamp": "00:14:36", "text": "私は塩分を摂取できません。"}, {"type": "subtitle", "time": 879.67, "timestamp": "00:14:39", "text": "いいえ。なぜ私は"}, {"type": "subtitle", "time": 881.99, "timestamp": "00:14:41", "text": "飲まなければならないと思うのでしょうか？ ああ、なんてセクシーなんだ。   何てことだ"}, {"type": "subtitle", "time": 884.71, "timestamp": "00:14:44", "text": "。"}, {"type": "subtitle", "time": 888.629, "timestamp": "00:14:48", "text": "私はフラスコに熱湯を入れました。"}, {"type": "subtitle", "time": 890.71, "timestamp": "00:14:50", "text": "ああ、神様。 私がここに来る前は。 ああ、"}, {"type": "subtitle", "time": 894.47, "timestamp": "00:14:54", "text": "なんて暑いんだ。 ええ、でも蓋が熱かったんです。"}, {"type": "subtitle", "time": 898.55, "timestamp": "00:14:58", "text": "いいえ、していません。 何て"}]
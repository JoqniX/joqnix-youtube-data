[{"type": "subtitle", "time": 2535.91, "timestamp": "00:42:15", "text": "マウスを使うことになります。"}, {"type": "subtitle", "time": 2539.91, "timestamp": "00:42:19", "text": "えっと、ピアノカバー。 見てみましょう。"}, {"type": "subtitle", "time": 2542.39, "timestamp": "00:42:22", "text": "ピアノ。 ピアノ。 ピアノ。 ピアノ。 あ、待って。"}, {"type": "subtitle", "time": 2545.349, "timestamp": "00:42:25", "text": "これはピアノですか？"}, {"type": "subtitle", "time": 2549.99, "timestamp": "00:42:29", "text": "えっと、ピアノカバーです。 ピアノカバー。 待って、"}, {"type": "subtitle", "time": 2562.95, "timestamp": "00:42:42", "text": "ああ、彼女が歌っている。"}, {"type": "subtitle", "time": 2567.349, "timestamp": "00:42:47", "text": "ピアノのカバー演奏が必要なんです。 これです。"}]
[{"type": "subtitle", "time": 12901.19, "timestamp": "03:35:01", "text": "歌詞のナンセンスな部分から数字を削除して、"}, {"type": "subtitle", "time": 12905.269, "timestamp": "03:35:05", "text": "今後"}, {"type": "subtitle", "time": 12908.71, "timestamp": "03:35:08", "text": "どんな曲でも問題なく完璧にコピー＆ペーストできるようにしようとしています。   だから"}, {"type": "subtitle", "time": 12910.87, "timestamp": "03:35:10", "text": "私はこれをやっているんです。 そうでなければ、こんなに"}, {"type": "subtitle", "time": 12912.95, "timestamp": "03:35:12", "text": "時間を費やすことはなかったでしょう"}, {"type": "subtitle", "time": 12915.83, "timestamp": "03:35:15", "text": "。 私なら手作業で"}, {"type": "subtitle", "time": 12918.389, "timestamp": "03:35:18", "text": "数字を削除して、一度だけコピー＆ペーストしたでしょう。 しかし、"}, {"type": "subtitle", "time": 12921.269, "timestamp": "03:35:21", "text": "ページを更新しても、"}]
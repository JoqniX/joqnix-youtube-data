[{"type": "subtitle", "time": 10352.63, "timestamp": "02:52:32", "text": "また。  [咳]"}, {"type": "subtitle", "time": 10356.23, "timestamp": "02:52:36", "text": "お湯が必要なんだよ、兄弟。 ああ、神様。"}, {"type": "subtitle", "time": 10359.67, "timestamp": "02:52:39", "text": "舌に骨を挟んでほしい。 もしかしたら、私にはわからないのかもしれない"}, {"type": "subtitle", "time": 10362.07, "timestamp": "02:52:42", "text": "。 いいえ、いいえ、そうすべきではありません。"}, {"type": "subtitle", "time": 10369.429, "timestamp": "02:52:49", "text": "ああ、舌が。 うーん、"}, {"type": "subtitle", "time": 10373.11, "timestamp": "02:52:53", "text": "暑いですね。 わかった。   わかった"}, {"type": "subtitle", "time": 10374.79, "timestamp": "02:52:54", "text": "。"}]
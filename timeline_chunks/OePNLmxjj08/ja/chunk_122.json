[{"type": "subtitle", "time": 7325.51, "timestamp": "02:02:05", "text": "。 ああ、ギターカバーはそこまでしか持たないんだ"}, {"type": "subtitle", "time": 7328.55, "timestamp": "02:02:08", "text": "。   わかった"}, {"type": "subtitle", "time": 7330.47, "timestamp": "02:02:10", "text": "。  Lexはこれに関するカバーがあれば、他のものもフォローしますか"}, {"type": "subtitle", "time": 7341.83, "timestamp": "02:02:21", "text": "えっと、アイスクリーム。"}, {"type": "subtitle", "time": 7367.43, "timestamp": "02:02:47", "text": "じゃないよ。 わかった。   ちゃんとした"}, {"type": "subtitle", "time": 7370.629, "timestamp": "02:02:50", "text": "ニーナ・ディド・イットのカバーはないと思う"}, {"type": "subtitle", "time": 7376.39, "timestamp": "02:02:56", "text": "よし、ナのカバーで行こう"}]
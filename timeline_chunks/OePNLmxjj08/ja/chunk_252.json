[{"type": "subtitle", "time": 15123.429, "timestamp": "04:12:03", "text": "うん、この曲は、すごく長くて"}, {"type": "subtitle", "time": 15127.429, "timestamp": "04:12:07", "text": "長い"}, {"type": "subtitle", "time": 15131.91, "timestamp": "04:12:11", "text": "曲だけど流れがある感じ。でもカキの曲は、"}, {"type": "subtitle", "time": 15143.99, "timestamp": "04:12:23", "text": "口を使いすぎて、言いたいことがたくさんあって、えーっと、とにかく、オーケー、ちょっと"}, {"type": "subtitle", "time": 15169.59, "timestamp": "04:12:49", "text": "わかりました。速度を0.75にして、減速するように設定できます"}]
[{"type": "subtitle", "time": 30907.83, "timestamp": "08:35:07", "text": "加我好友。嗯，是的。馬修桑，把"}, {"type": "subtitle", "time": 30911.11, "timestamp": "08:35:11", "text": "你的身分證給我。我會把你加進去。"}, {"type": "subtitle", "time": 30913.27, "timestamp": "08:35:13", "text": "你在說什麼？不，不，"}, {"type": "subtitle", "time": 30916.15, "timestamp": "08:35:16", "text": "不，不。"}, {"type": "subtitle", "time": 30917.91, "timestamp": "08:35:17", "text": "我的意思是，我能看到你在說話。我能"}, {"type": "subtitle", "time": 30919.43, "timestamp": "08:35:19", "text": "聽到自己在溪流中的聲音，但我"}, {"type": "subtitle", "time": 30923.51, "timestamp": "08:35:23", "text": "聽不到你的聲音。啊，現在就聊聊吧。"}, {"type": "subtitle", "time": 30926.468, "timestamp": "08:35:26", "text": "現在。是的。"}, {"type": "subtitle", "time": 30928.468, "timestamp": "08:35:28", "text": "我們仍然使用團隊語音。等等，"}, {"type": "subtitle", "time": 30939.11, "timestamp": "08:35:39", "text": "上方。你死定了。"}, {"type": "subtitle", "time": 30948.628, "timestamp": "08:35:48", "text": "等等，他離開了。"}]
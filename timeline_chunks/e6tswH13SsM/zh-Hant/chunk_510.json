[{"type": "subtitle", "time": 30619.03, "timestamp": "08:30:19", "text": "A："}, {"type": "subtitle", "time": 30622.23, "timestamp": "08:30:22", "text": "雨水掩映著我。我的天啊。我的天啊。看看這個。  你在這裡不懂[音樂]。  這份"}, {"type": "subtitle", "time": 30646.948, "timestamp": "08:30:46", "text": "工作具體在做什麼？哦，二二，我一直在嘗試和敵方的兩個人做"}, {"type": "subtitle", "time": 30650.788, "timestamp": "08:30:50", "text": "隊友，就像朋友一樣。  這兩個人都是我生活中的人物"}, {"type": "subtitle", "time": 30654.788, "timestamp": "08:30:54", "text": "。哦，還剩最後一個敵人。"}, {"type": "subtitle", "time": 30659.91, "timestamp": "08:30:59", "text": "低，低，非常低。"}]
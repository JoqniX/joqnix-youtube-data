[{"type": "subtitle", "time": 29963.788, "timestamp": "08:19:23", "text": "我們會在幾場比賽中測試一下，看看效果如何。  是的。你好。  阿布詹在聊天中。  這是新的個人頭像嗎"}, {"type": "subtitle", "time": 29967.59, "timestamp": "08:19:27", "text": "？哦，"}, {"type": "subtitle", "time": 29972.07, "timestamp": "08:19:32", "text": "我的天哪。我無法得分，把它拉下來。"}, {"type": "subtitle", "time": 29978.83, "timestamp": "08:19:38", "text": "不要動。複製.多個敵人。  已種下穗。  假傳送。是時候跳了。  去！去！去。  發現敵軍。還剩一個敵人。我準備"}, {"type": "subtitle", "time": 29988.788, "timestamp": "08:19:48", "text": "好了。  我走了。  [音樂] 聖潔的上帝"}]
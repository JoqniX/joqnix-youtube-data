[{"type": "subtitle", "time": 29376.23, "timestamp": "08:09:36", "text": "晚餐快吃完了。"}, {"type": "subtitle", "time": 29379.628, "timestamp": "08:09:39", "text": "我的天啊。"}, {"type": "subtitle", "time": 29384.11, "timestamp": "08:09:44", "text": "美好的。我可以專注於比賽。  哇。我們往東走吧。  換邊站。"}, {"type": "subtitle", "time": 29387.19, "timestamp": "08:09:47", "text": "我們已經從更糟糕的境地中走了出來。  我們走吧。我終於吃完晚餐了。"}]
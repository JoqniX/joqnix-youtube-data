[{"type": "subtitle", "time": 30849.15, "timestamp": "08:34:09", "text": "去！去！去。"}, {"type": "subtitle", "time": 30851.868, "timestamp": "08:34:11", "text": "嗯，就是這樣。我裝了"}, {"type": "subtitle", "time": 30864.948, "timestamp": "08:34:24", "text": "不是…傑克，你在說什麼？因為"}, {"type": "subtitle", "time": 30867.43, "timestamp": "08:34:27", "text": "我聽不見。哎，我總是忘記"}, {"type": "subtitle", "time": 30870.788, "timestamp": "08:34:30", "text": "我就在附近。啊，不錯。我知道我究竟是在"}, {"type": "subtitle", "time": 30872.788, "timestamp": "08:34:32", "text": "哪裡不小心"}, {"type": "subtitle", "time": 30875.35, "timestamp": "08:34:35", "text": "做了那件事，是的，我不小心"}, {"type": "subtitle", "time": 30877.11, "timestamp": "08:34:37", "text": "做了那個噴射機之類的"}, {"type": "subtitle", "time": 30899.19, "timestamp": "08:34:59", "text": "哦，是的。怪物出沒了。"}]
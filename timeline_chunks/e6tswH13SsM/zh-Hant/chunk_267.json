[{"type": "subtitle", "time": 16020.95, "timestamp": "04:27:00", "text": "現在我覺得我這輩子還沒做過什麼大事，就是說我什麼都沒做過，我做過的那些事對我來說都不算"}, {"type": "chat", "time": 16034.227, "timestamp": "04:27:14", "author": "@Minkk102", "avatar": "https://yt4.ggpht.com/TF8h5uIigJBanBg4LA_XZaY69S8H6wHtAUIDSGgMxHUqkEYRKq0z9m5NM8cqeDFnXLN0nN8i8g=s64-c-k-c0x00ffffff-no-rj", "message": "type*"}, {"type": "chat", "time": 16035.975, "timestamp": "04:27:15", "author": "@sarthaksharma2476", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kmJohYAdmpQzCNN96t58cLSK8spv6Y2ITutBFF9nvi9Z8=s64-c-k-c0x00ffffff-no-rj", "message": "thriller"}, {"type": "subtitle", "time": 16049.189, "timestamp": "04:27:29", "text": "什麼大事，沒什麼了不起的。我想做很多事，所以在做播客之前，我想做點大事，例如至少讓人們知道我的名字，這樣他們才會願意聽我的播客，覺得這個人說的話可能有點道理，對吧？"}, {"type": "subtitle", "time": 16069.83, "timestamp": "04:27:49", "text": "我不能像現在很多人那樣，坐在麥克風前胡說八道。  這是我個人的看法。就像我不喜歡那樣，"}, {"type": "subtitle", "time": 16072.309, "timestamp": "04:27:52", "text": "我不是說人們應該那樣做，但這只是我對"}, {"type": "subtitle", "time": 16075.03, "timestamp": "04:27:55", "text": "播客應該如何運作的看法。是的，"}, {"type": "subtitle", "time": 16077.11, "timestamp": "04:27:57", "text": "沒錯。我也有同感。所以我才說，就像之前在聊天裡有人提到這件事的時候，我說，是啊"}]
[{"type": "subtitle", "time": 30492.308, "timestamp": "08:28:12", "text": "我走了。  這裡。小心。  我打電話給羅斯"}, {"type": "subtitle", "time": 30514.23, "timestamp": "08:28:34", "text": "。  已種下穗。  我打了電話。  重新裝彈"}, {"type": "subtitle", "time": 30519.03, "timestamp": "08:28:39", "text": "。我的天啊。  我態度很好。發現敵軍。"}, {"type": "subtitle", "time": 30529.51, "timestamp": "08:28:49", "text": "M：呃，開始了。  我的天啊，為什麼？我不知道為什麼我的平均成績是B，而且很高。我真的"}]
[{"type": "subtitle", "time": 29822.15, "timestamp": "08:17:02", "text": "。讓我進去。好的，中場開始。我走中間路線"}, {"type": "subtitle", "time": 29827.11, "timestamp": "08:17:07", "text": "。哦，發現"}, {"type": "subtitle", "time": 29839.19, "timestamp": "08:17:19", "text": "敵人。小心。  有人在中間。哦，他當時在那邊。  重新裝彈。  重新裝彈。穿過。  發現敵軍。  最後一名倖存者。"}, {"type": "subtitle", "time": 29878.708, "timestamp": "08:17:58", "text": "觀看的畫面是負10度。等等，什麼？哦，是的。  我的也出現了"}]
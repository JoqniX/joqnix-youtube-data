[{"type": "subtitle", "time": 9304.59, "timestamp": "02:35:04", "text": "。  我們現在就走吧。通常"}, {"type": "subtitle", "time": 9330.389, "timestamp": "02:35:30", "text": "我不會這樣做，但我的"}, {"type": "subtitle", "time": 9332.67, "timestamp": "02:35:32", "text": "天哪。你需要父母聽你說話嗎？我的天啊。我的天啊。  所以如果你"}, {"type": "subtitle", "time": 9338.75, "timestamp": "02:35:38", "text": "聽到類似高壓水槍模擬器那種噴射聲，或是類似自行車的聲音，就像有人在外面洗自行車一樣。好的。現在我們把爐子放在我的手上。我的天啊。  爆炸帶來的疼痛應該可以接受。美好的。現在我們只能等待"}]
[{"type": "subtitle", "time": 28924.548, "timestamp": "08:02:04", "text": "嗯，他們如何手動操作，嗯"}, {"type": "subtitle", "time": 28948.948, "timestamp": "08:02:28", "text": "移動滑鼠時，你也可以，這對初學者很"}, {"type": "subtitle", "time": 28951.91, "timestamp": "08:02:31", "text": "友好，所以你可以調整圖表之類的東西。你想讓表達式每英吋產生多少效果，"}, {"type": "subtitle", "time": 28955.19, "timestamp": "08:02:35", "text": "平滑度需要多高，觸發靈敏度是多少等等。所以，付費版，也就是專業版，對你有幫助。"}, {"type": "subtitle", "time": 28961.91, "timestamp": "08:02:41", "text": "不會有使用者"}, {"type": "subtitle", "time": 28967.59, "timestamp": "08:02:47", "text": "介面之類的東西。它不會"}]
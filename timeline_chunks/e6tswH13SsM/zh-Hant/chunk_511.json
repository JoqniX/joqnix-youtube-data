[{"type": "subtitle", "time": 30661.868, "timestamp": "08:31:01", "text": "非常非常"}, {"type": "subtitle", "time": 30665.11, "timestamp": "08:31:05", "text": "低。我的天啊。  重新裝彈。  換人前的最後"}, {"type": "subtitle", "time": 30670.468, "timestamp": "08:31:10", "text": "一輪。是的。"}, {"type": "subtitle", "time": 30672.548, "timestamp": "08:31:12", "text": "你好，羅克西亞。  我走了。"}, {"type": "subtitle", "time": 30691.19, "timestamp": "08:31:31", "text": "保持權力。"}, {"type": "subtitle", "time": 30701.43, "timestamp": "08:31:41", "text": "我知道你在哪裡。幫我試試。幫我試試。"}, {"type": "subtitle", "time": 30709.52, "timestamp": "08:31:49", "text": "。 還剩一個敵人。運動健將都做些什麼？  重新裝彈。  發現"}]
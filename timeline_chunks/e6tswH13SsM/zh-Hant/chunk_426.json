[{"type": "subtitle", "time": 25562.19, "timestamp": "07:06:02", "text": "冷凍櫃嗎？仔細檢查一遍。  哎呀，那裡沒什麼東西。我的天啊。"}, {"type": "subtitle", "time": 25600.15, "timestamp": "07:06:40", "text": "我們可以找到一些"}, {"type": "subtitle", "time": 25602.39, "timestamp": "07:06:42", "text": "急救箱。  好的。等待。好的。跑步。  [掌聲] 我明白了。"}, {"type": "subtitle", "time": 25604.43, "timestamp": "07:06:44", "text": "附近沒有救護車嗎？或許還有一些員工留任。  是的。你看到我看到的了嗎？"}, {"type": "subtitle", "time": 25611.19, "timestamp": "07:06:51", "text": "我們需要引起他們的注意"}]
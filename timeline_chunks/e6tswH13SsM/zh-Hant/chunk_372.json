[{"type": "subtitle", "time": 22332.948, "timestamp": "06:12:12", "text": "呃，我們可以把它拿走嗎"}, {"type": "subtitle", "time": 22339.51, "timestamp": "06:12:19", "text": "？哦，等等。我，我會跳到上面，然後驚嘆：哇！該死，喬。你怎麼這麼聰明？  哦"}, {"type": "subtitle", "time": 22347.43, "timestamp": "06:12:27", "text": "，等等，讓我先去拿一下。對，就這麼做。是的"}, {"type": "subtitle", "time": 22356.11, "timestamp": "06:12:36", "text": "。  好的，給你。"}, {"type": "subtitle", "time": 22364.09, "timestamp": "06:12:44", "text": "我們去拿吧。"}, {"type": "subtitle", "time": 22372.708, "timestamp": "06:12:52", "text": "我等著，"}, {"type": "subtitle", "time": 22374.948, "timestamp": "06:12:54", "text": "放我走。  好了，過來。好了，過來。  我的天啊。小心路邊。  我的死了"}, {"type": "chat", "time": 22379.4, "timestamp": "06:12:59", "author": "@Minkk102", "avatar": "https://yt4.ggpht.com/TF8h5uIigJBanBg4LA_XZaY69S8H6wHtAUIDSGgMxHUqkEYRKq0z9m5NM8cqeDFnXLN0nN8i8g=s64-c-k-c0x00ffffff-no-rj", "message": "the pain is over "}]
[{"type": "subtitle", "time": 20523.67, "timestamp": "05:42:03", "text": "試過把它丟回去嗎？運動健將[ __ ]。恐怖的聲音。不。停下。快點"}, {"type": "subtitle", "time": 20563.39, "timestamp": "05:42:43", "text": "我在這裡。我在"}, {"type": "subtitle", "time": 20568.35, "timestamp": "05:42:48", "text": "這兒。等等，等等。給我一秒鐘。哦，月亮真亮。"}, {"type": "subtitle", "time": 20578.868, "timestamp": "05:42:58", "text": "你好，賈莉莎。歡迎。你好"}]
[{"type": "subtitle", "time": 180.03, "timestamp": "00:03:00", "text": "我家有個工廠在運作"}, {"type": "subtitle", "time": 185.71, "timestamp": "00:03:05", "text": "。我的天，帳單肯定要漲了。是"}, {"type": "subtitle", "time": 189.27, "timestamp": "00:03:09", "text": "啊，他們需要一個……我的意思是，"}, {"type": "subtitle", "time": 191.91, "timestamp": "00:03:11", "text": "我猜大概要等到下週才能搞定。我的新房間還是覺得有點"}, {"type": "subtitle", "time": 193.47, "timestamp": "00:03:13", "text": "擁擠"}, {"type": "subtitle", "time": 196.75, "timestamp": "00:03:16", "text": "。所以我希望我"}, {"type": "subtitle", "time": 200.50900000000001, "timestamp": "00:03:20", "text": "能擺脫這一切。所以我可以想開機多久就開機多久"}, {"type": "subtitle", "time": 206.98, "timestamp": "00:03:26", "text": "。是的。"}]
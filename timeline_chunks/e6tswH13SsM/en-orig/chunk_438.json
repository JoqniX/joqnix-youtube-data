[{"type": "subtitle", "time": 26298.19, "timestamp": "07:18:18", "text": "Bobcats, this is Sarah. Come in,"}, {"type": "subtitle", "time": 26300.788, "timestamp": "07:18:20", "text": "Bobcats. Sarah, Hannah here. You're"}, {"type": "subtitle", "time": 26304.19, "timestamp": "07:18:24", "text": "coming in strong and clear. Go ahead,"}, {"type": "subtitle", "time": 26306.788, "timestamp": "07:18:26", "text": "James. Well, he's injured and we need"}, {"type": "subtitle", "time": 26309.67, "timestamp": "07:18:29", "text": "bandages, antibiotics, painkillers. Say"}, {"type": "subtitle", "time": 26311.51, "timestamp": "07:18:31", "text": "no more. Dez and the guys are already"}, {"type": "subtitle", "time": 26313.91, "timestamp": "07:18:33", "text": "out and about. We'll get you something."}, {"type": "subtitle", "time": 26316.23, "timestamp": "07:18:36", "text": "Thanks so much. You're saints, all of"}, {"type": "subtitle", "time": 26318.548, "timestamp": "07:18:38", "text": "you."}, {"type": "subtitle", "time": 26320.39, "timestamp": "07:18:40", "text": "We're short on our end. We'll have to"}, {"type": "subtitle", "time": 26323.35, "timestamp": "07:18:43", "text": "loot a shop or something in"}]
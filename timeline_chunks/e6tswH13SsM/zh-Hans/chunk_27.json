[{"type": "subtitle", "time": 1638.19, "timestamp": "00:27:18", "text": "感兴趣的。你在开玩笑吧？"}, {"type": "subtitle", "time": 1642.47, "timestamp": "00:27:22", "text": "我。为什么？我的天啊。你不必……"}, {"type": "subtitle", "time": 1644.95, "timestamp": "00:27:24", "text": "照做。我的天啊。我该对他说些什么呢？"}, {"type": "subtitle", "time": 1647.02, "timestamp": "00:27:27", "text": "你？"}, {"type": "subtitle", "time": 1656.19, "timestamp": "00:27:36", "text": "求。哦，我的"}, {"type": "subtitle", "time": 1658.909, "timestamp": "00:27:38", "text": "[音乐]"}, {"type": "subtitle", "time": 1661.9, "timestamp": "00:27:41", "text": "上帝。那是害羞的吗？"}, {"type": "subtitle", "time": 1673.389, "timestamp": "00:27:53", "text": "看。"}]
[{"type": "subtitle", "time": 21490.628, "timestamp": "05:58:10", "text": "[音乐]"}, {"type": "subtitle", "time": 21494.628, "timestamp": "05:58:14", "text": "是的，我在这里。好的，我也在这里。"}, {"type": "subtitle", "time": 21496.23, "timestamp": "05:58:16", "text": "好的，好的，好的。我做到了。我做到了。"}, {"type": "subtitle", "time": 21521.19, "timestamp": "05:58:41", "text": "哦，跳起来。你能帮助我吗？嗯，我是"}, {"type": "subtitle", "time": 21529.19, "timestamp": "05:58:49", "text": "好吧，我摔倒了。我需要再做一遍。"}, {"type": "subtitle", "time": 21537.548, "timestamp": "05:58:57", "text": "等等，我来了"}]
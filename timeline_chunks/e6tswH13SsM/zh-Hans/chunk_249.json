[{"type": "subtitle", "time": 14946.95, "timestamp": "04:09:06", "text": "不同的。我的上帝。"}, {"type": "subtitle", "time": 14956.79, "timestamp": "04:09:16", "text": "哦，我摇晃椅子的时候你能看到我的椅子。"}, {"type": "subtitle", "time": 14959.03, "timestamp": "04:09:19", "text": "回到椅子上。你可以从中看到它"}, {"type": "subtitle", "time": 14964.389, "timestamp": "04:09:24", "text": "哇。好的。你如何追踪"}, {"type": "subtitle", "time": 14968.229, "timestamp": "04:09:28", "text": "你的东西？你的摄像头呃，面部追踪"}, {"type": "subtitle", "time": 14971.83, "timestamp": "04:09:31", "text": "还有一些其他的东西。你做什么工作？呃，我有一个"}, {"type": "subtitle", "time": 14973.91, "timestamp": "04:09:33", "text": "我不，不，我有我用我的"}, {"type": "subtitle", "time": 14975.67, "timestamp": "04:09:35", "text": "不同的手机。"}, {"type": "subtitle", "time": 14978.87, "timestamp": "04:09:38", "text": "比如我有个备用的虚拟助理，所以我用那个。它"}, {"type": "subtitle", "time": 14981.349, "timestamp": "04:09:41", "text": "比网络摄像头好。就像相机一样"}, {"type": "subtitle", "time": 14983.11, "timestamp": "04:09:43", "text": "那款手机比某些手机好得多。"}, {"type": "chat", "time": 14994.679, "timestamp": "04:09:54", "author": "@Minkk102", "avatar": "https://yt4.ggpht.com/TF8h5uIigJBanBg4LA_XZaY69S8H6wHtAUIDSGgMxHUqkEYRKq0z9m5NM8cqeDFnXLN0nN8i8g=s64-c-k-c0x00ffffff-no-rj", "message": "*spare iphone *"}, {"type": "subtitle", "time": 14996.83, "timestamp": "04:09:56", "text": "[音乐]"}, {"type": "chat", "time": 14999.316, "timestamp": "04:09:59", "author": "@Minkk102", "avatar": "https://yt4.ggpht.com/TF8h5uIigJBanBg4LA_XZaY69S8H6wHtAUIDSGgMxHUqkEYRKq0z9m5NM8cqeDFnXLN0nN8i8g=s64-c-k-c0x00ffffff-no-rj", "message": "ahem"}]
[{"type": "subtitle", "time": 19862.628, "timestamp": "05:31:02", "text": "耶。你想做什么？"}, {"type": "subtitle", "time": 19863.708, "timestamp": "05:31:03", "text": "一个"}, {"type": "subtitle", "time": 19866.27, "timestamp": "05:31:06", "text": "猴。我想要"}, {"type": "subtitle", "time": 19880.27, "timestamp": "05:31:20", "text": "等等，等等"}, {"type": "subtitle", "time": 19884.75, "timestamp": "05:31:24", "text": "它。我是在和它共舞吗？哦，等等。抓住"}, {"type": "subtitle", "time": 19893.91, "timestamp": "05:31:33", "text": "是的，我在跳舞。看？是的。是的。我"}, {"type": "subtitle", "time": 19896.43, "timestamp": "05:31:36", "text": "身手不凡。"}, {"type": "subtitle", "time": 19901.67, "timestamp": "05:31:41", "text": "是的。看着我。看着我，狗狗。"}, {"type": "subtitle", "time": 19919.51, "timestamp": "05:31:59", "text": "哦，这居然真的有效。等等，等等，"}]
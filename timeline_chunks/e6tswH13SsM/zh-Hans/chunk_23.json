[{"type": "subtitle", "time": 1382.11, "timestamp": "00:23:02", "text": "我猜是大师赛。"}, {"type": "subtitle", "time": 1387.29, "timestamp": "00:23:07", "text": "银。"}, {"type": "subtitle", "time": 1389.47, "timestamp": "00:23:09", "text": "[音乐]"}, {"type": "subtitle", "time": 1393.27, "timestamp": "00:23:13", "text": "该死。太酷了。我快10岁了。"}, {"type": "subtitle", "time": 1395.909, "timestamp": "00:23:15", "text": "还有两层。"}, {"type": "subtitle", "time": 1410.669, "timestamp": "00:23:30", "text": "很快。"}, {"type": "subtitle", "time": 1414.909, "timestamp": "00:23:34", "text": "他的账号来自我的朋友，不是"}, {"type": "subtitle", "time": 1430.39, "timestamp": "00:23:50", "text": "哇。我觉得你一定做了很多。"}, {"type": "subtitle", "time": 1432.549, "timestamp": "00:23:52", "text": "很多中国朋友，对吧，都在玩"}]
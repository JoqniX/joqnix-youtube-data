[{"type": "subtitle", "time": 8462.95, "timestamp": "02:21:02", "text": "我希望，虽然我感觉不太自在"}, {"type": "subtitle", "time": 8466.469, "timestamp": "02:21:06", "text": "那一刻就像你一样，呃，什么？什么是什么？"}, {"type": "subtitle", "time": 8470.23, "timestamp": "02:21:10", "text": "感到困惑吗？不，太忙了，没空。"}, {"type": "subtitle", "time": 8473.59, "timestamp": "02:21:13", "text": "呃，太忙了。我不知道那是什么"}, {"type": "subtitle", "time": 8475.389, "timestamp": "02:21:15", "text": "单词。我正在寻找的词是什么？"}, {"type": "subtitle", "time": 8478.309, "timestamp": "02:21:18", "text": "为了？哇。那个词是什么？那个词是什么？"}, {"type": "subtitle", "time": 8480.349, "timestamp": "02:21:20", "text": "我在看"}, {"type": "subtitle", "time": 8483.309, "timestamp": "02:21:23", "text": "为了。"}, {"type": "subtitle", "time": 8492.429, "timestamp": "02:21:32", "text": "即使看起来"}, {"type": "subtitle", "time": 8496.07, "timestamp": "02:21:36", "text": "直播前要做的事情太多了。"}, {"type": "subtitle", "time": 8499.83, "timestamp": "02:21:39", "text": "这就要求我提前一个小时起床。"}, {"type": "subtitle", "time": 8503.27, "timestamp": "02:21:43", "text": "什么都做，但我现在更像……"}, {"type": "subtitle", "time": 8507.59, "timestamp": "02:21:47", "text": "我直播的时间越来越长了。我"}, {"type": "subtitle", "time": 8511.11, "timestamp": "02:21:51", "text": "我15分钟前刚醒，看看我"}, {"type": "subtitle", "time": 8514.67, "timestamp": "02:21:54", "text": "速通所有内容。"}]
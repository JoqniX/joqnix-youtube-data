[{"type": "subtitle", "time": 4871.229, "timestamp": "01:21:11", "text": "[音乐]"}, {"type": "subtitle", "time": 4881.27, "timestamp": "01:21:21", "text": "好的。我当时觉得自己酷毙了。我知道。我当时"}, {"type": "subtitle", "time": 4885.27, "timestamp": "01:21:25", "text": "就像我非常确定那个敌人是"}, {"type": "subtitle", "time": 4888.149, "timestamp": "01:21:28", "text": "本来要杀了我，但我不知怎么就活了下来。"}]
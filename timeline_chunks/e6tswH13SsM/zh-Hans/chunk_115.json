[{"type": "subtitle", "time": 6902.669, "timestamp": "01:55:02", "text": "所以，谢谢"}, {"type": "subtitle", "time": 6909.79, "timestamp": "01:55:09", "text": "和明星。"}, {"type": "subtitle", "time": 6912.47, "timestamp": "01:55:12", "text": "是的。谢谢。"}, {"type": "subtitle", "time": 6914.149, "timestamp": "01:55:14", "text": "让我和你们一起玩。谢谢"}, {"type": "subtitle", "time": 6916.03, "timestamp": "01:55:16", "text": "感谢你关心我"}, {"type": "subtitle", "time": 6919.629, "timestamp": "01:55:19", "text": "出色地。是的，谢谢"}, {"type": "subtitle", "time": 6922.229, "timestamp": "01:55:22", "text": "你。所以我玩得越多，我就越想"}, {"type": "subtitle", "time": 6925.79, "timestamp": "01:55:25", "text": "将其解锁到这个星座"}, {"type": "subtitle", "time": 6928.669, "timestamp": "01:55:28", "text": "东西。那是数字"}, {"type": "subtitle", "time": 6932.229, "timestamp": "01:55:32", "text": "四座塔楼。好的。哦，明白了。知道了。"}, {"type": "subtitle", "time": 6936.75, "timestamp": "01:55:36", "text": "知道了。我想玩到我……"}, {"type": "subtitle", "time": 6939.43, "timestamp": "01:55:39", "text": "这。是啊，今天真的很有趣。"}, {"type": "subtitle", "time": 6943.109, "timestamp": "01:55:43", "text": "尽管。我们玩了很多。"}, {"type": "subtitle", "time": 6946.83, "timestamp": "01:55:46", "text": "我们玩了很多很多次，我们得到了"}, {"type": "subtitle", "time": 6956.75, "timestamp": "01:55:56", "text": "是的，这个名字我用了很久。"}]
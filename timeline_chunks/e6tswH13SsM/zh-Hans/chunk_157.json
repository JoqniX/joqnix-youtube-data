[{"type": "subtitle", "time": 9423.83, "timestamp": "02:37:03", "text": "某物。呃，我真的非常抱歉。"}, {"type": "subtitle", "time": 9427.15, "timestamp": "02:37:07", "text": "只是我当时醒着。"}, {"type": "subtitle", "time": 9430.63, "timestamp": "02:37:10", "text": "直到早上8点。"}, {"type": "subtitle", "time": 9433.67, "timestamp": "02:37:13", "text": "我本来不应该睡觉的，因为我想要"}, {"type": "subtitle", "time": 9436.71, "timestamp": "02:37:16", "text": "晚上睡个好觉，并且拥有"}, {"type": "subtitle", "time": 9438.51, "timestamp": "02:37:18", "text": "好好休息。"}, {"type": "subtitle", "time": 9442.469, "timestamp": "02:37:22", "text": "但我不小心打了个盹儿"}, {"type": "subtitle", "time": 9444.79, "timestamp": "02:37:24", "text": "一点。我闭上眼睛躺在床上。"}, {"type": "subtitle", "time": 9449.15, "timestamp": "02:37:29", "text": "过了一会儿我就睡着了。"}, {"type": "subtitle", "time": 9453.27, "timestamp": "02:37:33", "text": "离开。事情就是这样发生的。我真的没有"}, {"type": "subtitle", "time": 9455.07, "timestamp": "02:37:35", "text": "想做"}, {"type": "subtitle", "time": 9467.389, "timestamp": "02:37:47", "text": "所以今天"}, {"type": "subtitle", "time": 9471.51, "timestamp": "02:37:51", "text": "嗯，今天我们和Astra有合作。它"}, {"type": "subtitle", "time": 9475.75, "timestamp": "02:37:55", "text": "将于下午 4 点举行。印度标准时间（IST）还有时间"}]
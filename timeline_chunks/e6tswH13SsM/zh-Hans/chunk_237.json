[{"type": "subtitle", "time": 14231.349, "timestamp": "03:57:11", "text": "哦，为什么这样就可以了？我修好了。您好，我们"}, {"type": "subtitle", "time": 14233.269, "timestamp": "03:57:13", "text": "回来了。"}, {"type": "subtitle", "time": 14235.83, "timestamp": "03:57:15", "text": "我们回来了，各位。"}, {"type": "subtitle", "time": 14246.429, "timestamp": "03:57:26", "text": "后退。好的，那么这里是哪里？"}, {"type": "subtitle", "time": 14250.71, "timestamp": "03:57:30", "text": "基本配置？另一个角色。"}, {"type": "subtitle", "time": 14252.63, "timestamp": "03:57:32", "text": "好的。等等，等等。我在吃饭。呃，所以你"}, {"type": "subtitle", "time": 14254.189, "timestamp": "03:57:34", "text": "必须去发现"}, {"type": "subtitle", "time": 14260.389, "timestamp": "03:57:40", "text": "东西。然后你得把……加起来。"}, {"type": "subtitle", "time": 14262.55, "timestamp": "03:57:42", "text": "发现。你需要搜索蒸汽"}, {"type": "subtitle", "time": 14264.87, "timestamp": "03:57:44", "text": "协作与探索，你必须这样做"}, {"type": "subtitle", "time": 14268.389, "timestamp": "03:57:48", "text": "订阅它。所以给我5到10分。"}, {"type": "subtitle", "time": 14271.429, "timestamp": "03:57:51", "text": "距离我们使用富士胶片还有几分钟。是的。是的。"}, {"type": "subtitle", "time": 14273.59, "timestamp": "03:57:53", "text": "我正在吃饭。所以看起来很像"}, {"type": "subtitle", "time": 14275.51, "timestamp": "03:57:55", "text": "在酒吧里感觉很奇怪，因为它有手"}, {"type": "subtitle", "time": 14278.15, "timestamp": "03:57:58", "text": "追踪。好的。"}, {"type": "subtitle", "time": 14279.309, "timestamp": "03:57:59", "text": "是的。"}]
[{"type": "subtitle", "time": 8825.67, "timestamp": "02:27:05", "text": "难的。蜂蜜普里饼。我想要不，我想要"}, {"type": "subtitle", "time": 8828.03, "timestamp": "02:27:08", "text": "全部获取"}, {"type": "subtitle", "time": 8832.03, "timestamp": "02:27:12", "text": "食谱。印度食谱。所以，"}, {"type": "subtitle", "time": 8835.27, "timestamp": "02:27:15", "text": "好的。所以，我要启用这个功能。呃"}, {"type": "subtitle", "time": 8838.11, "timestamp": "02:27:18", "text": "请告诉我这方面的情况。"}, {"type": "subtitle", "time": 8841.349, "timestamp": "02:27:21", "text": "声音。电缆电缆电缆电缆"}, {"type": "subtitle", "time": 8843.429, "timestamp": "02:27:23", "text": "电缆。哦，对了，对于那些"}, {"type": "subtitle", "time": 8846.15, "timestamp": "02:27:26", "text": "不知道，我买了VC，它叫"}, {"type": "subtitle", "time": 8847.63, "timestamp": "02:27:27", "text": "虚拟音频"}, {"type": "subtitle", "time": 8851.27, "timestamp": "02:27:31", "text": "电缆，旧的那个，它有"}, {"type": "subtitle", "time": 8854.19, "timestamp": "02:27:34", "text": "已经持续了一段时间了"}, {"type": "subtitle", "time": 8859.51, "timestamp": "02:27:39", "text": "大约1999年。我不知道。是的。嗯"}, {"type": "subtitle", "time": 8860.91, "timestamp": "02:27:40", "text": "人们"}, {"type": "subtitle", "time": 8863.349, "timestamp": "02:27:43", "text": "就是那个虚拟电缆之类的东西"}, {"type": "subtitle", "time": 8864.51, "timestamp": "02:27:44", "text": "哪个"}, {"type": "subtitle", "time": 8868.07, "timestamp": "02:27:48", "text": "人人都用过。我知道你听到了双重音。"}, {"type": "subtitle", "time": 8871.59, "timestamp": "02:27:51", "text": "有声音，但是加油！我正在尝试修复它。"}, {"type": "subtitle", "time": 8874.55, "timestamp": "02:27:54", "text": "好的。音频线。好的。是的，我"}, {"type": "subtitle", "time": 8878.11, "timestamp": "02:27:58", "text": "最近买的，我可以补足差额"}]
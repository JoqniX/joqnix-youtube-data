[{"type": "subtitle", "time": 18842.83, "timestamp": "05:14:02", "text": "攀登的压力"}, {"type": "subtitle", "time": 18855.55, "timestamp": "05:14:15", "text": "树。我"}, {"type": "subtitle", "time": 18858.03, "timestamp": "05:14:18", "text": "无法……为什么会这样？"}, {"type": "subtitle", "time": 18864.47, "timestamp": "05:14:24", "text": "当然。我们应该拥有吗？我们拥有吗？我们需要吗？"}, {"type": "subtitle", "time": 18866.628, "timestamp": "05:14:26", "text": "一把斧头。我们需要一把斧头。斧头在哪儿？"}, {"type": "subtitle", "time": 18869.23, "timestamp": "05:14:29", "text": "找一把斧子。我们需要一个"}, {"type": "subtitle", "time": 18888.948, "timestamp": "05:14:48", "text": "斧头。这游戏太折磨人了。"}, {"type": "subtitle", "time": 18890.868, "timestamp": "05:14:50", "text": "一开始应该不会那么痛苦。"}, {"type": "subtitle", "time": 18893.35, "timestamp": "05:14:53", "text": "等级。我们只需要找一把斧子。这"}, {"type": "subtitle", "time": 18896.47, "timestamp": "05:14:56", "text": "这是第一级。决不。"}]
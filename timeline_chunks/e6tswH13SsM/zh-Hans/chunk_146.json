[{"type": "subtitle", "time": 8761.67, "timestamp": "02:26:01", "text": "现在。但我还是要去那里。"}, {"type": "subtitle", "time": 8766.27, "timestamp": "02:26:06", "text": "我相信应该没问题。好的。我"}, {"type": "subtitle", "time": 8774.429, "timestamp": "02:26:14", "text": "[音乐]"}, {"type": "subtitle", "time": 8777.91, "timestamp": "02:26:17", "text": "向上。等待。右来球。等待。它是"}, {"type": "subtitle", "time": 8779.99, "timestamp": "02:26:19", "text": "向我走来。哦，等等，等等。是的"}, {"type": "subtitle", "time": 8782.349, "timestamp": "02:26:22", "text": "就是这个。我在做什么？"}, {"type": "subtitle", "time": 8784.27, "timestamp": "02:26:24", "text": "乔。这"}, {"type": "subtitle", "time": 8786.18, "timestamp": "02:26:26", "text": "一。嗯？这"}, {"type": "subtitle", "time": 8787.77, "timestamp": "02:26:27", "text": "[音乐]"}, {"type": "subtitle", "time": 8803.27, "timestamp": "02:26:43", "text": "哦，等等，它停了。它停了。"}, {"type": "subtitle", "time": 8804.27, "timestamp": "02:26:44", "text": "真是太"}, {"type": "subtitle", "time": 8806.27, "timestamp": "02:26:46", "text": "嗨。"}, {"type": "subtitle", "time": 8810.07, "timestamp": "02:26:50", "text": "不用等，只需五分钟。"}, {"type": "subtitle", "time": 8812.55, "timestamp": "02:26:52", "text": "得到“不，不，不，不”。我将完成"}, {"type": "subtitle", "time": 8816.23, "timestamp": "02:26:56", "text": "还有其他东西。不用担心。我想制作"}, {"type": "subtitle", "time": 8818.55, "timestamp": "02:26:58", "text": "大概100个左右吧。不，100 就像一个"}, {"type": "subtitle", "time": 8819.91, "timestamp": "02:26:59", "text": "很多蜂蜜脆饼。但是，再说一遍，"}]
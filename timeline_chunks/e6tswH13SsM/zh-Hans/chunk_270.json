[{"type": "subtitle", "time": 16201.189, "timestamp": "04:30:01", "text": "YouTube之路和这段旅程"}, {"type": "subtitle", "time": 16203.91, "timestamp": "04:30:03", "text": "更多你可以到达和喜欢的地方"}, {"type": "subtitle", "time": 16206.87, "timestamp": "04:30:06", "text": "里程碑之类的，因为你已经到了那个阶段了。"}, {"type": "subtitle", "time": 16210.229, "timestamp": "04:30:10", "text": "不过，这是一条不错的道路。你不像是在做"}, {"type": "subtitle", "time": 16213.03, "timestamp": "04:30:13", "text": "同样的事情，但其他人也在做。"}, {"type": "subtitle", "time": 16216.87, "timestamp": "04:30:16", "text": "你正在做新的事情，并带来新的……"}, {"type": "subtitle", "time": 16219.83, "timestamp": "04:30:19", "text": "嗯……它叫什么？一个新的呃不"}, {"type": "subtitle", "time": 16223.51, "timestamp": "04:30:23", "text": "比如要求创造新的纪录或"}, {"type": "subtitle", "time": 16226.95, "timestamp": "04:30:26", "text": "现在把任何东西放到盘子里。所以这有助于"}, {"type": "subtitle", "time": 16229.429, "timestamp": "04:30:29", "text": "你知道这在任何时候都很有帮助"}, {"type": "subtitle", "time": 16231.75, "timestamp": "04:30:31", "text": "有一个新的 YouTuber，或者像现有的 YouTuber 一样。"}, {"type": "subtitle", "time": 16234.55, "timestamp": "04:30:34", "text": "YouTuber看到这个也会有同样的感受"}, {"type": "subtitle", "time": 16236.55, "timestamp": "04:30:36", "text": "是啊，我也想做点什么。"}, {"type": "subtitle", "time": 16239.03, "timestamp": "04:30:39", "text": "像这样，他们也试图获得"}, {"type": "subtitle", "time": 16241.429, "timestamp": "04:30:41", "text": "受到启发或喜欢尝试自己动手"}, {"type": "subtitle", "time": 16245.269, "timestamp": "04:30:45", "text": "他们以自己的方式做事，并且喜欢尝试"}, {"type": "subtitle", "time": 16247.11, "timestamp": "04:30:47", "text": "这又像是竞争，但仍然"}, {"type": "subtitle", "time": 16249.99, "timestamp": "04:30:49", "text": "感觉你现在还在那里。"}, {"type": "subtitle", "time": 16253.189, "timestamp": "04:30:53", "text": "在那条更高的道路上，人们会"}, {"type": "subtitle", "time": 16255.269, "timestamp": "04:30:55", "text": "他们也会慢慢地尽力而为。"}, {"type": "subtitle", "time": 16258.149, "timestamp": "04:30:58", "text": "诸如此类的事情。那样的话它就会"}]
[{"type": "subtitle", "time": 797.75, "timestamp": "00:13:17", "text": "[音乐]"}, {"type": "subtitle", "time": 800.19, "timestamp": "00:13:20", "text": "等等，他们是在用英语说话吗？"}, {"type": "subtitle", "time": 803.79, "timestamp": "00:13:23", "text": "英语？他们抓不到你。"}, {"type": "subtitle", "time": 818.629, "timestamp": "00:13:38", "text": "什么？我们的队友都很棒。"}, {"type": "subtitle", "time": 820.43, "timestamp": "00:13:40", "text": "E"}]
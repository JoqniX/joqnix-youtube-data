[{"type": "subtitle", "time": 16322.83, "timestamp": "04:32:02", "text": "我只是在想，如果我成为一名油管博主的话。"}, {"type": "subtitle", "time": 16326.55, "timestamp": "04:32:06", "text": "现在我能做的远不止这些了。"}, {"type": "subtitle", "time": 16328.229, "timestamp": "04:32:08", "text": "感觉可能性太多了"}, {"type": "subtitle", "time": 16331.269, "timestamp": "04:32:11", "text": "做事情"}, {"type": "subtitle", "time": 16333.99, "timestamp": "04:32:13", "text": "因为那样我就不会受到限制了。"}, {"type": "subtitle", "time": 16338.55, "timestamp": "04:32:18", "text": "并受 IRL 逻辑的约束"}, {"type": "subtitle", "time": 16341.349, "timestamp": "04:32:21", "text": "感觉我几乎做什么都能做对"}, {"type": "subtitle", "time": 16343.59, "timestamp": "04:32:23", "text": "是的"}, {"type": "subtitle", "time": 16345.189, "timestamp": "04:32:25", "text": "所以这就是我存在的意义。"}, {"type": "subtitle", "time": 16348.389, "timestamp": "04:32:28", "text": "首先，我是如何成为一名 YouTuber 的。"}, {"type": "subtitle", "time": 16350.309, "timestamp": "04:32:30", "text": "在当时，这是一件新鲜事。很多"}, {"type": "subtitle", "time": 16352.309, "timestamp": "04:32:32", "text": "人们并没有这样做。那是"}, {"type": "subtitle", "time": 16360.07, "timestamp": "04:32:40", "text": "但是，是的，我会说很多"}, {"type": "subtitle", "time": 16362.349, "timestamp": "04:32:42", "text": "这个领域的人们都很有创造力。它是"}, {"type": "subtitle", "time": 16364.71, "timestamp": "04:32:44", "text": "你只需要使用它，而且你必须……"}, {"type": "subtitle", "time": 16367.269, "timestamp": "04:32:47", "text": "去做。比如说，如果我不"}, {"type": "subtitle", "time": 16369.11, "timestamp": "04:32:49", "text": "假设现在人气达到那么高，即使"}, {"type": "subtitle", "time": 16372.07, "timestamp": "04:32:52", "text": "如果我毕业什么的，我就会得到"}, {"type": "subtitle", "time": 16375.99, "timestamp": "04:32:55", "text": "忙于现实生活中的事情，或者可能是我我我"}, {"type": "subtitle", "time": 16377.75, "timestamp": "04:32:57", "text": "没能实现我的目标"}, {"type": "subtitle", "time": 16379.99, "timestamp": "04:32:59", "text": "现在至少在这个社区里要做的事情"}]
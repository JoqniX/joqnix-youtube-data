[{"type": "subtitle", "time": 19261.03, "timestamp": "05:21:01", "text": "哦好的。那边有一把斧头。"}, {"type": "subtitle", "time": 19264.43, "timestamp": "05:21:04", "text": "是的，我找到了一把斧子。是的，我得到了"}, {"type": "subtitle", "time": 19292.628, "timestamp": "05:21:32", "text": "困境。如果我能做到，我就能做到。"}, {"type": "subtitle", "time": 19298.91, "timestamp": "05:21:38", "text": "该死。"}, {"type": "subtitle", "time": 19301.35, "timestamp": "05:21:41", "text": "看。等等，我们需要……我们需要只是"}, {"type": "subtitle", "time": 19310.55, "timestamp": "05:21:50", "text": "乔。是的。是的。是的。是的。是的。是的。"}, {"type": "subtitle", "time": 19313.19, "timestamp": "05:21:53", "text": "好的。想象。"}, {"type": "subtitle", "time": 19315.35, "timestamp": "05:21:55", "text": "想象一下如果它真的会等待。不，不，不。"}]
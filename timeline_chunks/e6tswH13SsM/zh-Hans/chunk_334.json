[{"type": "subtitle", "time": 20040.19, "timestamp": "05:34:00", "text": "箱。一个盒子。是啊，看看我……"}, {"type": "subtitle", "time": 20047.75, "timestamp": "05:34:07", "text": "我一只手拿着它。我是"}, {"type": "subtitle", "time": 20053.43, "timestamp": "05:34:13", "text": "单手托着一棵巨大的树。"}, {"type": "subtitle", "time": 20056.868, "timestamp": "05:34:16", "text": "等等，试着放手，彻底放下它。"}, {"type": "subtitle", "time": 20076.83, "timestamp": "05:34:36", "text": "我觉得我们搞定了。我们得到了"}, {"type": "subtitle", "time": 20080.03, "timestamp": "05:34:40", "text": "它。不要 不要 不要"}, {"type": "subtitle", "time": 20083.59, "timestamp": "05:34:43", "text": "比如要小心。别让箱子掉下来。"}, {"type": "subtitle", "time": 20085.15, "timestamp": "05:34:45", "text": "不要尝试"}, {"type": "subtitle", "time": 20088.788, "timestamp": "05:34:48", "text": "不，从侧面推它。"}, {"type": "subtitle", "time": 20091.59, "timestamp": "05:34:51", "text": "比如，让我站在上面。这将是"}]
[{"type": "subtitle", "time": 8701.51, "timestamp": "02:25:01", "text": "是的。好了，我切换到手机端吧。"}, {"type": "subtitle", "time": 8704.389, "timestamp": "02:25:04", "text": "友善的运动健将。我当时没有麦克风"}, {"type": "subtitle", "time": 8710.19, "timestamp": "02:25:10", "text": "去。希望今天一切顺利。嗯？啊。好的。"}, {"type": "subtitle", "time": 8712.429, "timestamp": "02:25:12", "text": "嗯，"}, {"type": "subtitle", "time": 8715.11, "timestamp": "02:25:15", "text": "乔。哦，等等。我需要连接到"}, {"type": "subtitle", "time": 8724.07, "timestamp": "02:25:24", "text": "等待。我应该吗？真的需要这种吗？"}, {"type": "subtitle", "time": 8728.55, "timestamp": "02:25:28", "text": "就像用我的手机流量一样？"}, {"type": "subtitle", "time": 8743.07, "timestamp": "02:25:43", "text": "00009. 所以它需要无线网络才能工作。"}, {"type": "subtitle", "time": 8745.71, "timestamp": "02:25:45", "text": "不。好的。"}, {"type": "subtitle", "time": 8750.469, "timestamp": "02:25:50", "text": "美好的。我将连接 Wi-Fi。"}, {"type": "subtitle", "time": 8752.99, "timestamp": "02:25:52", "text": "厨房"}, {"type": "subtitle", "time": 8755.99, "timestamp": "02:25:55", "text": "放在那边，因为没有射程"}, {"type": "subtitle", "time": 8759.59, "timestamp": "02:25:59", "text": "这里。但感觉就像少了一根线。"}]
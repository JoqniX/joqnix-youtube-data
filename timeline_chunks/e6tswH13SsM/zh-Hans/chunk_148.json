[{"type": "subtitle", "time": 8882.63, "timestamp": "02:28:02", "text": "256根电缆。我的天啊。想象一下这种力量"}, {"type": "subtitle", "time": 8886.27, "timestamp": "02:28:06", "text": "你有，因为我一直靠它生活"}, {"type": "subtitle", "time": 8890.07, "timestamp": "02:28:10", "text": "六条虚拟电缆，有效期两年。现在"}, {"type": "subtitle", "time": 8894.309, "timestamp": "02:28:14", "text": "我可以做250个G。"}, {"type": "subtitle", "time": 8899.15, "timestamp": "02:28:19", "text": "[音乐]"}, {"type": "subtitle", "time": 8903.469, "timestamp": "02:28:23", "text": "电力中断将持续数周。等等，什么？"}, {"type": "subtitle", "time": 8909.07, "timestamp": "02:28:29", "text": "嗯？他们为什么要锁起来？"}, {"type": "subtitle", "time": 8924.51, "timestamp": "02:28:44", "text": "[音乐]"}, {"type": "subtitle", "time": 8929.03, "timestamp": "02:28:49", "text": "南达。好的，我必须切换到呃，我会"}, {"type": "subtitle", "time": 8931.91, "timestamp": "02:28:51", "text": "换用手机麦克风。所以，让我们"}, {"type": "subtitle", "time": 8934.87, "timestamp": "02:28:54", "text": "告诉我你觉得这样听起来怎么样。好的。等待，"}, {"type": "subtitle", "time": 8936.91, "timestamp": "02:28:56", "text": "让我穿上我的"}, {"type": "subtitle", "time": 8939.75, "timestamp": "02:28:59", "text": "耳机。我相信我发过推特之类的"}]
[{"type": "subtitle", "time": 15121.99, "timestamp": "04:12:01", "text": "以及印度。在他们开始制作之后"}, {"type": "subtitle", "time": 15123.87, "timestamp": "04:12:03", "text": "在印度，这有点像"}, {"type": "subtitle", "time": 15127.59, "timestamp": "04:12:07", "text": "便宜的。等等，什么？ iPhone 或类似产品"}, {"type": "subtitle", "time": 15130.469, "timestamp": "04:12:10", "text": "数据流量套餐？ iPhone？"}, {"type": "subtitle", "time": 15133.189, "timestamp": "04:12:13", "text": "不。好的。所以基本上就是数据套餐"}, {"type": "subtitle", "time": 15136.07, "timestamp": "04:12:16", "text": "价格昂贵。互联网的影响非常巨大"}, {"type": "subtitle", "time": 15138.79, "timestamp": "04:12:18", "text": "昂贵的。但由于六月，他们"}, {"type": "subtitle", "time": 15141.269, "timestamp": "04:12:21", "text": "他们装作好像他们已经安排好了"}, {"type": "subtitle", "time": 15142.79, "timestamp": "04:12:22", "text": "整个市场都适合那些互联网用户"}, {"type": "subtitle", "time": 15144.95, "timestamp": "04:12:24", "text": "现在还有职业服务。非常便宜"}, {"type": "subtitle", "time": 15147.75, "timestamp": "04:12:27", "text": "印度。哦，因为他们推出了那个"}, {"type": "subtitle", "time": 15149.95, "timestamp": "04:12:29", "text": "现在就开始计划吧。"}, {"type": "subtitle", "time": 15153.51, "timestamp": "04:12:33", "text": "所以这是个明智之举。但是，是的，所以在"}, {"type": "subtitle", "time": 15155.99, "timestamp": "04:12:35", "text": "在印度，Wi-Fi 很便宜，而且"}, {"type": "subtitle", "time": 15158.389, "timestamp": "04:12:38", "text": "与其他国家相比，东西很一般。但"}, {"type": "subtitle", "time": 15161.91, "timestamp": "04:12:41", "text": "是的，苹果也在准备他们的……"}, {"type": "subtitle", "time": 15164.07, "timestamp": "04:12:44", "text": "就像印度的生产项目一样。他们"}, {"type": "subtitle", "time": 15166.55, "timestamp": "04:12:46", "text": "在台湾，通常有苹果之类的东西"}, {"type": "subtitle", "time": 15169.03, "timestamp": "04:12:49", "text": "产地：[此处原文缺失，无法翻译]"}, {"type": "subtitle", "time": 15171.83, "timestamp": "04:12:51", "text": "呃，他们正在建厂。"}, {"type": "subtitle", "time": 15175.75, "timestamp": "04:12:55", "text": "在印度设有基地，但有些外交事务。"}, {"type": "subtitle", "time": 15178.469, "timestamp": "04:12:58", "text": "现在正在发生的事情，美国却没有做到。"}]
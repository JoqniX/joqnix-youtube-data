[{"type": "subtitle", "time": 22560.548, "timestamp": "06:16:00", "text": "从哪一边？"}, {"type": "subtitle", "time": 22562.31, "timestamp": "06:16:02", "text": "从侧面看。趴在地上。"}, {"type": "subtitle", "time": 22566.23, "timestamp": "06:16:06", "text": "走上楼梯，然后……上去"}, {"type": "subtitle", "time": 22569.27, "timestamp": "06:16:09", "text": "抓住岩石，走到旁边。什么"}, {"type": "subtitle", "time": 22573.03, "timestamp": "06:16:13", "text": "楼梯？什么石头？我的上帝。"}, {"type": "subtitle", "time": 22574.83, "timestamp": "06:16:14", "text": "在里面"}, {"type": "subtitle", "time": 22584.548, "timestamp": "06:16:24", "text": "哦，等等。我在那个东西里。是的，"}, {"type": "subtitle", "time": 22587.19, "timestamp": "06:16:27", "text": "是啊是啊。来，来，来拿这些"}, {"type": "subtitle", "time": 22589.99, "timestamp": "06:16:29", "text": "摇滚起来！"}, {"type": "subtitle", "time": 22592.788, "timestamp": "06:16:32", "text": "但我们能从这些石头里得到什么呢？我们"}, {"type": "subtitle", "time": 22594.47, "timestamp": "06:16:34", "text": "得把购物车推出来。有"}, {"type": "subtitle", "time": 22602.27, "timestamp": "06:16:42", "text": "大车。把石头拿走。这"}, {"type": "subtitle", "time": 22604.31, "timestamp": "06:16:44", "text": "让你把石头拉出来。我会拉出"}, {"type": "subtitle", "time": 22614.11, "timestamp": "06:16:54", "text": "拿走石头。然后我拉"}]
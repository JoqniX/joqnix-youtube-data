[{"type": "subtitle", "time": 23824.07, "timestamp": "06:37:04", "text": "好了，我回来了。我回来了。我可以看到"}, {"type": "subtitle", "time": 23827.548, "timestamp": "06:37:07", "text": "立即聊天。我正在重启我的"}, {"type": "subtitle", "time": 23830.548, "timestamp": "06:37:10", "text": "个人电脑。我亲眼看到他对阿斯特拉做了坏事。"}, {"type": "subtitle", "time": 23833.548, "timestamp": "06:37:13", "text": "非常可疑。等待，"}, {"type": "subtitle", "time": 23847.27, "timestamp": "06:37:27", "text": "[音乐]"}, {"type": "subtitle", "time": 23850.44, "timestamp": "06:37:30", "text": "乔克。别忘了把他静音。"}, {"type": "subtitle", "time": 23869.67, "timestamp": "06:37:49", "text": "[音乐]"}]
[{"type": "subtitle", "time": 5481.03, "timestamp": "01:31:21", "text": "红发女郎。我还没决定应该找谁。"}, {"type": "subtitle", "time": 5483.229, "timestamp": "01:31:23", "text": "开锁。但"}, {"type": "subtitle", "time": 5486.59, "timestamp": "01:31:26", "text": "是的，我有两个。"}, {"type": "subtitle", "time": 5489.3, "timestamp": "01:31:29", "text": "板条箱。我应该打开吗？"}, {"type": "subtitle", "time": 5491.149, "timestamp": "01:31:31", "text": "[音乐]"}, {"type": "subtitle", "time": 5496.229, "timestamp": "01:31:36", "text": "这些？我开一个。我得到了什么？"}, {"type": "subtitle", "time": 5503.07, "timestamp": "01:31:43", "text": "[音乐]"}, {"type": "subtitle", "time": 5508.669, "timestamp": "01:31:48", "text": "那？哦，你解锁了赠送哦。"}]
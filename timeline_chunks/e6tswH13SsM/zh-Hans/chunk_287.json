[{"type": "subtitle", "time": 17221.11, "timestamp": "04:47:01", "text": "我可能错过了你，或者"}, {"type": "subtitle", "time": 17225.19, "timestamp": "04:47:05", "text": "某物。我告诉乌娜，对我来说"}, {"type": "subtitle", "time": 17226.628, "timestamp": "04:47:06", "text": "我甚至不知道还有这个词。"}, {"type": "subtitle", "time": 17228.15, "timestamp": "04:47:08", "text": "被称为虚拟主播（VTuber）。"}, {"type": "subtitle", "time": 17229.99, "timestamp": "04:47:09", "text": "[音乐]"}, {"type": "subtitle", "time": 17233.27, "timestamp": "04:47:13", "text": "哦，我甚至都不知道。而我没有"}, {"type": "subtitle", "time": 17235.03, "timestamp": "04:47:15", "text": "甚至知道，如果时间到了会怎样。"}, {"type": "subtitle", "time": 17239.39, "timestamp": "04:47:19", "text": "有人和我做着同样的事情"}, {"type": "subtitle", "time": 17242.15, "timestamp": "04:47:22", "text": "你知道我是怎么想到这个主意的吗？"}, {"type": "subtitle", "time": 17245.03, "timestamp": "04:47:25", "text": "就像你知道的，在iPhone里有"}, {"type": "subtitle", "time": 17247.948, "timestamp": "04:47:27", "text": "就像一个表情符号之类的东西，它会生成一个"}, {"type": "subtitle", "time": 17250.868, "timestamp": "04:47:30", "text": "头像，它会有类似面部的特征。"}, {"type": "subtitle", "time": 17253.11, "timestamp": "04:47:33", "text": "跟踪之类的。它是新近"}, {"type": "subtitle", "time": 17256.868, "timestamp": "04:47:36", "text": "率先在 iPhone 上发布。好的。所以它会是"}, {"type": "subtitle", "time": 17259.83, "timestamp": "04:47:39", "text": "就像你的自定义头像一样，它将拥有"}, {"type": "subtitle", "time": 17262.23, "timestamp": "04:47:42", "text": "你的面部表情会是这样的"}, {"type": "subtitle", "time": 17264.868, "timestamp": "04:47:44", "text": "通过摄像头跟踪并发送"}, {"type": "subtitle", "time": 17267.59, "timestamp": "04:47:47", "text": "送给你的朋友，还有其他一些东西。所以"}, {"type": "subtitle", "time": 17270.39, "timestamp": "04:47:50", "text": "那句话击中了我。我当时就想，卧槽兄弟，我可以用"}, {"type": "subtitle", "time": 17273.19, "timestamp": "04:47:53", "text": "这就像我的视频，不像我的"}, {"type": "subtitle", "time": 17275.11, "timestamp": "04:47:55", "text": "玩游戏之类的，而不是我用我的"}, {"type": "subtitle", "time": 17278.628, "timestamp": "04:47:58", "text": "我可以用那台相机。"}]
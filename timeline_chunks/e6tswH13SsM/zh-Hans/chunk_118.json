[{"type": "subtitle", "time": 7083.709, "timestamp": "01:58:03", "text": "等待。是的。有一个。那是"}, {"type": "subtitle", "time": 7089.39, "timestamp": "01:58:09", "text": "高露洁。是的。那就是我。是的，就是这样。"}, {"type": "subtitle", "time": 7091.709, "timestamp": "01:58:11", "text": "我。是的。"}, {"type": "subtitle", "time": 7094.75, "timestamp": "01:58:14", "text": "嗯，明天，Valerant"}, {"type": "subtitle", "time": 7097.47, "timestamp": "01:58:17", "text": "高露洁牙膏。我"}, {"type": "subtitle", "time": 7103.31, "timestamp": "01:58:23", "text": "用水送服。我会尽力不"}, {"type": "subtitle", "time": 7107.589, "timestamp": "01:58:27", "text": "到蛙类底部，不过是的。"}, {"type": "subtitle", "time": 7112.669, "timestamp": "01:58:32", "text": "而我，以及所有这些人，好吧，事情就是这样。"}, {"type": "subtitle", "time": 7114.27, "timestamp": "01:58:34", "text": "是"}, {"type": "subtitle", "time": 7118.109, "timestamp": "01:58:38", "text": "职业选手玩这款游戏玩得非常多"}, {"type": "subtitle", "time": 7121.99, "timestamp": "01:58:41", "text": "研磨寿司也播放它，他要去"}, {"type": "subtitle", "time": 7124.149, "timestamp": "01:58:44", "text": "他玩这个游戏就像我们玩这个游戏一样，纯粹是为了娱乐。"}, {"type": "subtitle", "time": 7126.27, "timestamp": "01:58:46", "text": "计算机科学之类的，但是"}, {"type": "subtitle", "time": 7129.43, "timestamp": "01:58:49", "text": "是的，偶尔也会玩。"}, {"type": "subtitle", "time": 7131.55, "timestamp": "01:58:51", "text": "我也喜欢我"}, {"type": "subtitle", "time": 7134.99, "timestamp": "01:58:54", "text": "担心我不想喝牙膏"}, {"type": "subtitle", "time": 7138.229, "timestamp": "01:58:58", "text": "水，但我的目标是制作寿司。"}]
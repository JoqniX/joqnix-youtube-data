[{"type": "subtitle", "time": 7140.79, "timestamp": "01:59:00", "text": "不，Willow 真的会喝。我想要"}, {"type": "subtitle", "time": 7143.47, "timestamp": "01:59:03", "text": "制作柳树"}, {"type": "subtitle", "time": 7146.31, "timestamp": "01:59:06", "text": "呃呃，成为最底层的青蛙过河者，或者"}, {"type": "subtitle", "time": 7148.39, "timestamp": "01:59:08", "text": "某物。我不知道如果会发生什么"}, {"type": "subtitle", "time": 7149.47, "timestamp": "01:59:09", "text": "某人"}, {"type": "subtitle", "time": 7152.31, "timestamp": "01:59:12", "text": "实际上变成了底部青蛙过河"}, {"type": "subtitle", "time": 7154.87, "timestamp": "01:59:14", "text": "多款游戏。那个人必须……吗？"}, {"type": "subtitle", "time": 7157.39, "timestamp": "01:59:17", "text": "继续喝这个？哦，我的"}, {"type": "subtitle", "time": 7160.149, "timestamp": "01:59:20", "text": "上帝。但谁也说不准。我不知道。"}, {"type": "subtitle", "time": 7164.43, "timestamp": "01:59:24", "text": "但是，明天，明天，我们会"}, {"type": "subtitle", "time": 7168.43, "timestamp": "01:59:28", "text": "嗯，我会直播的。"}, {"type": "subtitle", "time": 7170.91, "timestamp": "01:59:30", "text": "嗯，8:00"}, {"type": "subtitle", "time": 7174.229, "timestamp": "01:59:34", "text": "下午呃，这个直播流将会上线。"}, {"type": "subtitle", "time": 7177.589, "timestamp": "01:59:37", "text": "在所有平台上，就像……"}, {"type": "subtitle", "time": 7179.75, "timestamp": "01:59:39", "text": "溪流。嗯，回头见！"}, {"type": "subtitle", "time": 7183.03, "timestamp": "01:59:43", "text": "明天。好的。你好。如果我空闲的话"}, {"type": "subtitle", "time": 7186.27, "timestamp": "01:59:46", "text": "免费，我相信流媒体会"}, {"type": "subtitle", "time": 7188.709, "timestamp": "01:59:48", "text": "双语。我一直都这么说"}, {"type": "subtitle", "time": 7192.07, "timestamp": "01:59:52", "text": "尽管。我的天哪，我们需要学习双语"}, {"type": "subtitle", "time": 7193.47, "timestamp": "01:59:53", "text": "这样我才能学习"}, {"type": "subtitle", "time": 7197.03, "timestamp": "01:59:57", "text": "中国人。是的，比利比利"}, {"type": "subtitle", "time": 7199.35, "timestamp": "01:59:59", "text": "独家直播将于明天或"}]
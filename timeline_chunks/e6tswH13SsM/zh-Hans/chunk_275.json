[{"type": "subtitle", "time": 16500.39, "timestamp": "04:35:00", "text": "你知道，想想看，就像……"}, {"type": "subtitle", "time": 16501.99, "timestamp": "04:35:01", "text": "传统的 YouTube 方式应该是"}, {"type": "subtitle", "time": 16504.869, "timestamp": "04:35:04", "text": "就做你想做的任何事吧。"}, {"type": "subtitle", "time": 16506.47, "timestamp": "04:35:06", "text": "玩得开心。这才是重点。喜欢"}, {"type": "subtitle", "time": 16509.15, "timestamp": "04:35:09", "text": "如果得不到乐趣，那就毫无意义。"}, {"type": "subtitle", "time": 16512.47, "timestamp": "04:35:12", "text": "正确的？尽情享受过程，去做就好。不"}, {"type": "subtitle", "time": 16514.75, "timestamp": "04:35:14", "text": "想太多了。"}, {"type": "subtitle", "time": 16521.789, "timestamp": "04:35:21", "text": "是的，你激励了我。"}, {"type": "subtitle", "time": 16524.949, "timestamp": "04:35:24", "text": "更多的。兄弟，我怎么能激励到你呢？你"}, {"type": "subtitle", "time": 16526.869, "timestamp": "04:35:26", "text": "多年来一直都是这样。"}, {"type": "subtitle", "time": 16529.99, "timestamp": "04:35:29", "text": "好的。不，那确实引起了共鸣。"}, {"type": "subtitle", "time": 16531.91, "timestamp": "04:35:31", "text": "与我一起。我觉得我也应该这样做"}, {"type": "subtitle", "time": 16535.629, "timestamp": "04:35:35", "text": "那。别再在意规则了"}, {"type": "subtitle", "time": 16538.23, "timestamp": "04:35:38", "text": "任何。任何。做你想做的"}, {"type": "subtitle", "time": 16541.67, "timestamp": "04:35:41", "text": "想做点什么。"}, {"type": "subtitle", "time": 16543.429, "timestamp": "04:35:43", "text": "这就是关键所在。那么，这些是谁做的呢？"}, {"type": "subtitle", "time": 16546.949, "timestamp": "04:35:46", "text": "规矩，兄弟？就像一个人决定"}, {"type": "subtitle", "time": 16549.189, "timestamp": "04:35:49", "text": "先成为一名 YouTuber。现在，他们"}, {"type": "subtitle", "time": 16552.39, "timestamp": "04:35:52", "text": "制定这套规则就像典型的问题一样。"}, {"type": "subtitle", "time": 16554.709, "timestamp": "04:35:54", "text": "传统的YouTube方式。兄弟，是"}, {"type": "subtitle", "time": 16557.029, "timestamp": "04:35:57", "text": "不是，不是你，就像其他人一样。"}, {"type": "subtitle", "time": 16559.59, "timestamp": "04:35:59", "text": "不同的。是的。我们长得并不都一样，"}]
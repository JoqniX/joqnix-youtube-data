[{"type": "subtitle", "time": 900.629, "timestamp": "00:15:00", "text": "喇嘛X：发生了什么事？"}, {"type": "subtitle", "time": 909.87, "timestamp": "00:15:09", "text": "注意。我拆除了炸弹。"}, {"type": "subtitle", "time": 919.35, "timestamp": "00:15:19", "text": "好的。哦，我们这些防守者。我忘了。哦，我"}, {"type": "subtitle", "time": 920.87, "timestamp": "00:15:20", "text": "以为我们仍然是攻击者。绝不"}, {"type": "subtitle", "time": 958.03, "timestamp": "00:15:58", "text": "背刺。"}]
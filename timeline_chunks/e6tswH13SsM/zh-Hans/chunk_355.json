[{"type": "subtitle", "time": 21300.868, "timestamp": "05:55:00", "text": "哦，好吧，我想我们必须……"}, {"type": "subtitle", "time": 21303.59, "timestamp": "05:55:03", "text": "上这座城堡的楼上去。"}, {"type": "subtitle", "time": 21305.43, "timestamp": "05:55:05", "text": "对，我就是想跟你说这个。"}, {"type": "subtitle", "time": 21318.51, "timestamp": "05:55:18", "text": "阿斯特拉。我打开过吗？是的，我"}, {"type": "subtitle", "time": 21321.91, "timestamp": "05:55:21", "text": "做过。我来了。"}, {"type": "subtitle", "time": 21323.67, "timestamp": "05:55:23", "text": "我的天啊。你必须上去做"}]
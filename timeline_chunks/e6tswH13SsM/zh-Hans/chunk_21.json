[{"type": "subtitle", "time": 1260.27, "timestamp": "00:21:00", "text": "你好。我想输入“我是”"}, {"type": "subtitle", "time": 1264.07, "timestamp": "00:21:04", "text": "害怕的。我打算这么做。不是"}, {"type": "subtitle", "time": 1265.87, "timestamp": "00:21:05", "text": "超好的。所以你的"}, {"type": "subtitle", "time": 1269.87, "timestamp": "00:21:09", "text": "日语 I 我正在做"}, {"type": "subtitle", "time": 1273.31, "timestamp": "00:21:13", "text": "它。先出招，"}, {"type": "subtitle", "time": 1276.18, "timestamp": "00:21:16", "text": "乔克。哇。"}, {"type": "subtitle", "time": 1283.669, "timestamp": "00:21:23", "text": "[音乐]"}, {"type": "subtitle", "time": 1285.31, "timestamp": "00:21:25", "text": "我是"}, {"type": "subtitle", "time": 1288.549, "timestamp": "00:21:28", "text": "中国人。所以你是日本人吗？"}, {"type": "subtitle", "time": 1290.909, "timestamp": "00:21:30", "text": "只是和日本人"}, {"type": "subtitle", "time": 1297.27, "timestamp": "00:21:37", "text": "日本人。等等，那岂不是说他们知道？"}, {"type": "subtitle", "time": 1304.31, "timestamp": "00:21:44", "text": "读。你想添加我的真实游戏吗？"}, {"type": "subtitle", "time": 1311.99, "timestamp": "00:21:51", "text": "哇。所以，如果你水平更高，"}, {"type": "subtitle", "time": 1315.19, "timestamp": "00:21:55", "text": "有了这些东西，你很容易就能交到朋友。"}, {"type": "subtitle", "time": 1317.149, "timestamp": "00:21:57", "text": "问题"}]
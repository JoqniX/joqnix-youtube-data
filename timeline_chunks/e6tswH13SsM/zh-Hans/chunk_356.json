[{"type": "subtitle", "time": 21363.99, "timestamp": "05:56:03", "text": "一。好了，我现在到了。什么？"}, {"type": "subtitle", "time": 21377.27, "timestamp": "05:56:17", "text": "是的。贝拉，随便吧。就收下吧"}, {"type": "subtitle", "time": 21389.07, "timestamp": "05:56:29", "text": "兄弟，这不应该发生。"}, {"type": "subtitle", "time": 21392.15, "timestamp": "05:56:32", "text": "这里。看着我。"}, {"type": "subtitle", "time": 21403.35, "timestamp": "05:56:43", "text": "不，兄弟。下来，下来。"}, {"type": "subtitle", "time": 21407.03, "timestamp": "05:56:47", "text": "看看这个点。"}, {"type": "subtitle", "time": 21416.15, "timestamp": "05:56:56", "text": "我现在该怎么办？尽量去"}]
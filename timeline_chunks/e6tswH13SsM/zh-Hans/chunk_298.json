[{"type": "subtitle", "time": 17881.67, "timestamp": "04:58:01", "text": "如何做这个、怎么做那个，还有那个。"}, {"type": "subtitle", "time": 17884.15, "timestamp": "04:58:04", "text": "其次，如何制作缩略图"}, {"type": "subtitle", "time": 17886.39, "timestamp": "04:58:06", "text": "等等。你应用内容时也是同样的操作。"}, {"type": "subtitle", "time": 17888.788, "timestamp": "04:58:08", "text": "创造同样适用于你同样的事情"}, {"type": "subtitle", "time": 17891.35, "timestamp": "04:58:11", "text": "你这样做是为了虚拟直播，就虚拟直播而言。"}, {"type": "subtitle", "time": 17893.99, "timestamp": "04:58:13", "text": "你得好好研究一下，比如好的方面。"}, {"type": "subtitle", "time": 17896.948, "timestamp": "04:58:16", "text": "模特呃，不像模特那样，像呃，服装"}, {"type": "subtitle", "time": 17900.55, "timestamp": "04:58:20", "text": "或者像在直播中使用的素材之类的"}, {"type": "subtitle", "time": 17903.83, "timestamp": "04:58:23", "text": "让每一次直播都更有趣。你添加"}, {"type": "subtitle", "time": 17905.67, "timestamp": "04:58:25", "text": "直播间新增内容"}, {"type": "subtitle", "time": 17907.03, "timestamp": "04:58:27", "text": "一切。"}, {"type": "subtitle", "time": 17908.948, "timestamp": "04:58:28", "text": "制作内容等等。真是太"}, {"type": "subtitle", "time": 17923.59, "timestamp": "04:58:43", "text": "所以，我们也没玩过任何东西。我们"}, {"type": "subtitle", "time": 17925.59, "timestamp": "04:58:45", "text": "我们可以玩点什么。我们一直"}, {"type": "subtitle", "time": 17927.59, "timestamp": "04:58:47", "text": "说说而已。希望我没让你们觉得无聊。"}, {"type": "subtitle", "time": 17929.99, "timestamp": "04:58:49", "text": "你太多了。不。是的，就是这样。"}]
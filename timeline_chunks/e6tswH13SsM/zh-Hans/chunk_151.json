[{"type": "subtitle", "time": 9060.79, "timestamp": "02:31:00", "text": "上帝。我的天啊。"}, {"type": "subtitle", "time": 9064.03, "timestamp": "02:31:04", "text": "所以如果你听到类似这样的消息"}, {"type": "subtitle", "time": 9067.19, "timestamp": "02:31:07", "text": "你知道动力清洗模拟器"}, {"type": "subtitle", "time": 9069.99, "timestamp": "02:31:09", "text": "类似喷洒的声音之类的"}, {"type": "subtitle", "time": 9074.87, "timestamp": "02:31:14", "text": "是那辆自行车，呃，它就像……它就像……"}, {"type": "subtitle", "time": 9076.87, "timestamp": "02:31:16", "text": "呃，人们在做……他们在洗澡"}, {"type": "subtitle", "time": 9080.15, "timestamp": "02:31:20", "text": "外面有辆自行车。好的。现在我们"}, {"type": "subtitle", "time": 9081.79, "timestamp": "02:31:21", "text": "让"}, {"type": "subtitle", "time": 9086.309, "timestamp": "02:31:26", "text": "炉子放在我手上。我的天啊。"}, {"type": "subtitle", "time": 9087.71, "timestamp": "02:31:27", "text": "这"}, {"type": "subtitle", "time": 9099.23, "timestamp": "02:31:39", "text": "疼痛应该可以接受。美好的。现在我们"}, {"type": "subtitle", "time": 9101.91, "timestamp": "02:31:41", "text": "等待。我需要做点什么吗？你"}, {"type": "subtitle", "time": 9103.75, "timestamp": "02:31:43", "text": "知道什么？让我们做一些"}, {"type": "subtitle", "time": 9106.389, "timestamp": "02:31:46", "text": "鸡蛋。好的，我会煎些鸡蛋。应该"}, {"type": "subtitle", "time": 9110.79, "timestamp": "02:31:50", "text": "我插话？我应该放个类似小东西的东西吗？"}, {"type": "subtitle", "time": 9112.79, "timestamp": "02:31:52", "text": "也就是说，我在做饭或者"}, {"type": "subtitle", "time": 9115.51, "timestamp": "02:31:55", "text": "某物？我不知道。我应该这样做吗？"}]
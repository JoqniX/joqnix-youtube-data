[{"type": "subtitle", "time": 8522.389, "timestamp": "02:22:02", "text": "你最近怎么样？是的，我"}, {"type": "subtitle", "time": 8525.59, "timestamp": "02:22:05", "text": "我还没吃早饭呢，但是"}, {"type": "subtitle", "time": 8530.469, "timestamp": "02:22:10", "text": "有了。呃，不，我就像我想的那样……"}, {"type": "subtitle", "time": 8534.07, "timestamp": "02:22:14", "text": "来吧，就像……呃，让你们都待在这里"}, {"type": "subtitle", "time": 8538.349, "timestamp": "02:22:18", "text": "VRB模式之类的，然后呃，开始"}, {"type": "subtitle", "time": 8542.23, "timestamp": "02:22:22", "text": "或者我们可以做移动音频"}, {"type": "subtitle", "time": 8544.389, "timestamp": "02:22:24", "text": "东西。"}, {"type": "subtitle", "time": 8547.19, "timestamp": "02:22:27", "text": "谁倒下了？谁愿意做这件事？"}, {"type": "subtitle", "time": 8549.67, "timestamp": "02:22:29", "text": "我会说话。家里没人。"}, {"type": "subtitle", "time": 8552.07, "timestamp": "02:22:32", "text": "所以，我可以一边……一边和你说话。"}, {"type": "subtitle", "time": 8554.67, "timestamp": "02:22:34", "text": "我正在做饭"}, {"type": "subtitle", "time": 8557.11, "timestamp": "02:22:37", "text": "厨房。是啊，那肯定很有趣。那"}, {"type": "subtitle", "time": 8559.99, "timestamp": "02:22:39", "text": "那将是一次有趣的体验，看看会发生什么"}, {"type": "subtitle", "time": 8566.87, "timestamp": "02:22:46", "text": "去。是啊，我等不及了。那么，让我"}]
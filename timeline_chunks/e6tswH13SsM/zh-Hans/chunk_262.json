[{"type": "subtitle", "time": 15721.99, "timestamp": "04:22:01", "text": "嗯，我在聊天里提到过，我说就像"}, {"type": "subtitle", "time": 15724.87, "timestamp": "04:22:04", "text": "是的，我想做，但不是现在，因为"}, {"type": "subtitle", "time": 15727.03, "timestamp": "04:22:07", "text": "对，现在还是老样子，就像……"}, {"type": "subtitle", "time": 15729.91, "timestamp": "04:22:09", "text": "就像一天结束时，作为一名 YouTuber 一样"}, {"type": "subtitle", "time": 15731.99, "timestamp": "04:22:11", "text": "这里竞争非常激烈。"}, {"type": "subtitle", "time": 15735.11, "timestamp": "04:22:15", "text": "对，所以你必须让人记住你。"}, {"type": "subtitle", "time": 15737.83, "timestamp": "04:22:17", "text": "某种程度上，就你所做的事情而言。"}, {"type": "subtitle", "time": 15740.95, "timestamp": "04:22:20", "text": "在这个社区里，无论是通过"}, {"type": "subtitle", "time": 15744.55, "timestamp": "04:22:24", "text": "内容或任何成就"}, {"type": "subtitle", "time": 15747.59, "timestamp": "04:22:27", "text": "或对社区的任何贡献"}, {"type": "subtitle", "time": 15750.95, "timestamp": "04:22:30", "text": "等等，或者任何事物都可以是任何东西。"}, {"type": "subtitle", "time": 15753.99, "timestamp": "04:22:33", "text": "任何形式都可以，对吧？人们必须记住"}, {"type": "subtitle", "time": 15755.99, "timestamp": "04:22:35", "text": "当他们看到这个角色时，哦"}, {"type": "subtitle", "time": 15759.59, "timestamp": "04:22:39", "text": "型号或你的名字或他们的名字"}, {"type": "subtitle", "time": 15762.149, "timestamp": "04:22:42", "text": "将会回忆起那段记忆。"}, {"type": "subtitle", "time": 15764.55, "timestamp": "04:22:44", "text": "是的，这个人做了某件事。"}, {"type": "subtitle", "time": 15766.79, "timestamp": "04:22:46", "text": "事件或这件事以及所有类似的事情"}, {"type": "subtitle", "time": 15771.67, "timestamp": "04:22:51", "text": "那。以及这个人会如何影响他人。"}, {"type": "subtitle", "time": 15775.51, "timestamp": "04:22:55", "text": "其他人，比如如果知道的话"}, {"type": "subtitle", "time": 15777.229, "timestamp": "04:22:57", "text": "这个人或正在观看这个人"}]
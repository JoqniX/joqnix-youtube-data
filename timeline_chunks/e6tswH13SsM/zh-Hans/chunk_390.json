[{"type": "subtitle", "time": 23402.08, "timestamp": "06:30:02", "text": "老鼠。我现在不需要这个鼠标。现在 我需要我的脸部鼠标。"}, {"type": "subtitle", "time": 23420.23, "timestamp": "06:30:20", "text": "我的天啊，兄弟。我需要买一个新的"}, {"type": "subtitle", "time": 23422.07, "timestamp": "06:30:22", "text": "老鼠。我买。我这就下单。"}, {"type": "subtitle", "time": 23425.11, "timestamp": "06:30:25", "text": "跟我用的一样。"}, {"type": "subtitle", "time": 23426.75, "timestamp": "06:30:26", "text": "问题是，这只鼠标非常"}, {"type": "subtitle", "time": 23429.35, "timestamp": "06:30:29", "text": "不错，但它存在双重问题。"}, {"type": "subtitle", "time": 23431.67, "timestamp": "06:30:31", "text": "点击。就像几个月后那样，"}, {"type": "subtitle", "time": 23434.948, "timestamp": "06:30:34", "text": "它开始了。所以，这是我第二次……"}, {"type": "subtitle", "time": 23442.948, "timestamp": "06:30:42", "text": "给我一分钟时间。我会回来的。"}, {"type": "subtitle", "time": 23445.75, "timestamp": "06:30:45", "text": "一点。呃，我去洗手，马上回来。"}, {"type": "subtitle", "time": 23449.948, "timestamp": "06:30:49", "text": "后退。好的。是的。好的。正在安装"}]
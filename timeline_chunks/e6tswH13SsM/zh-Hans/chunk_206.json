[{"type": "subtitle", "time": 12362.87, "timestamp": "03:26:02", "text": "用那笔钱去买那款游戏"}, {"type": "subtitle", "time": 12364.87, "timestamp": "03:26:04", "text": "还可以和朋友们一起打高尔夫。"}, {"type": "subtitle", "time": 12368.07, "timestamp": "03:26:08", "text": "那是我也想玩的另一款游戏。"}, {"type": "subtitle", "time": 12370.95, "timestamp": "03:26:10", "text": "所以，是的，第三点我想优先考虑。"}, {"type": "subtitle", "time": 12372.59, "timestamp": "03:26:12", "text": "然后我想要"}, {"type": "subtitle", "time": 12377.51, "timestamp": "03:26:17", "text": "兄弟，我私信了好多人，而且……"}, {"type": "subtitle", "time": 12380.71, "timestamp": "03:26:20", "text": "很多都处于待定状态"}, {"type": "subtitle", "time": 12383.19, "timestamp": "03:26:23", "text": "很多人还没有回应。"}, {"type": "subtitle", "time": 12385.07, "timestamp": "03:26:25", "text": "人们想要耳环"}, {"type": "subtitle", "time": 12389.03, "timestamp": "03:26:29", "text": "槽位等等等等等等，我是"}, {"type": "subtitle", "time": 12393.469, "timestamp": "03:26:33", "text": "死了我是 waku wakun pasu 对吧"}]
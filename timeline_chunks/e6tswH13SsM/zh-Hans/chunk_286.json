[{"type": "subtitle", "time": 17160.23, "timestamp": "04:46:00", "text": "就像三年、四年、四个"}, {"type": "subtitle", "time": 17162.31, "timestamp": "04:46:02", "text": "几年前。我只是想要……"}, {"type": "subtitle", "time": 17165.11, "timestamp": "04:46:05", "text": "玩游戏。然后我意识到"}, {"type": "subtitle", "time": 17167.83, "timestamp": "04:46:07", "text": "是的，我可以用一个字符代替。"}, {"type": "subtitle", "time": 17169.99, "timestamp": "04:46:09", "text": "我玩游戏的画面。我当时甚至都没……"}, {"type": "subtitle", "time": 17172.788, "timestamp": "04:46:12", "text": "我知道这是一个叫做虚拟主播（Vtuber）的术语。"}, {"type": "subtitle", "time": 17176.23, "timestamp": "04:46:16", "text": "当时我只是在玩游戏，然后……"}, {"type": "subtitle", "time": 17178.708, "timestamp": "04:46:18", "text": "YouTube 上的一个视频，而不是我。"}, {"type": "subtitle", "time": 17180.708, "timestamp": "04:46:20", "text": "使用角色进行面部摄像头拍摄。那"}, {"type": "subtitle", "time": 17182.708, "timestamp": "04:46:22", "text": "这就是全部计划。"}, {"type": "subtitle", "time": 17184.628, "timestamp": "04:46:24", "text": "我甚至不知道它叫什么。"}, {"type": "subtitle", "time": 17187.43, "timestamp": "04:46:27", "text": "虚拟管家。它就像某种东西"}, {"type": "subtitle", "time": 17189.83, "timestamp": "04:46:29", "text": "存在。这和你所在的类型不一样。"}, {"type": "subtitle", "time": 17194.03, "timestamp": "04:46:34", "text": "了解正常的流媒体播放之类的。苏"}, {"type": "subtitle", "time": 17197.91, "timestamp": "04:46:37", "text": "然后我了解到了这一切，比如"}, {"type": "subtitle", "time": 17209.27, "timestamp": "04:46:49", "text": "是啊，那太酷了。等等，怎么做到的？哦，"}, {"type": "subtitle", "time": 17212.708, "timestamp": "04:46:52", "text": "等待。是的，你在奥卡变性了。我"}, {"type": "subtitle", "time": 17214.788, "timestamp": "04:46:54", "text": "正想问呢。等等，所以这意味着"}, {"type": "subtitle", "time": 17217.75, "timestamp": "04:46:57", "text": "你以前认识我吗？我"}]
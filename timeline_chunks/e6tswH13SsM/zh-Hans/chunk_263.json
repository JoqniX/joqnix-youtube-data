[{"type": "subtitle", "time": 15781.429, "timestamp": "04:23:01", "text": "激励你也喜欢上它"}, {"type": "subtitle", "time": 15784.309, "timestamp": "04:23:04", "text": "做 YouTube 或投身内容创作"}, {"type": "subtitle", "time": 15786.11, "timestamp": "04:23:06", "text": "以及诸如此类的事情"}, {"type": "subtitle", "time": 15789.75, "timestamp": "04:23:09", "text": "例如，人生天赋就像这样巨大的"}, {"type": "subtitle", "time": 15793.03, "timestamp": "04:23:13", "text": "对很多人来说，这就是灵感来源。"}, {"type": "subtitle", "time": 15796.63, "timestamp": "04:23:16", "text": "也想做些像他们那样的事"}, {"type": "subtitle", "time": 15798.71, "timestamp": "04:23:18", "text": "他们观看这些视频，并乐于学习如何……"}, {"type": "subtitle", "time": 15801.03, "timestamp": "04:23:21", "text": "他们什么都做。这真是太……"}, {"type": "subtitle", "time": 15804.309, "timestamp": "04:23:24", "text": "这是件有教育意义的事，对吧？当你潜水时"}, {"type": "subtitle", "time": 15807.99, "timestamp": "04:23:27", "text": "深入了解一下大创作者是如何做的"}, {"type": "chat", "time": 15809.611, "timestamp": "04:23:29", "author": "@sarthaksharma2476", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kmJohYAdmpQzCNN96t58cLSK8spv6Y2ITutBFF9nvi9Z8=s64-c-k-c0x00ffffff-no-rj", "message": "ironmouse too"}, {"type": "subtitle", "time": 15811.99, "timestamp": "04:23:31", "text": "内容等等。格式等等是什么样的？"}, {"type": "subtitle", "time": 15817.189, "timestamp": "04:23:37", "text": "有些人说类似这样的话，嗯，我想，嗯，很久了。"}, {"type": "subtitle", "time": 15821.51, "timestamp": "04:23:41", "text": "前段时间，我的一个朋友说，呃……"}, {"type": "subtitle", "time": 15823.83, "timestamp": "04:23:43", "text": "建议之类的东西就像是……它"}, {"type": "subtitle", "time": 15825.83, "timestamp": "04:23:45", "text": "取决于你对……的影响"}, {"type": "subtitle", "time": 15829.99, "timestamp": "04:23:49", "text": "社区以及它有多少特殊价值"}, {"type": "subtitle", "time": 15832.469, "timestamp": "04:23:52", "text": "你必须这样做，才能被人记住。"}, {"type": "subtitle", "time": 15835.349, "timestamp": "04:23:55", "text": "或者像所有那些东西一样。我觉得我是"}, {"type": "subtitle", "time": 15837.51, "timestamp": "04:23:57", "text": "我说话有点语无伦次，但我大概明白了。"}, {"type": "subtitle", "time": 15839.51, "timestamp": "04:23:59", "text": "你答对了。我明白你的意思了。"}]
[{"type": "subtitle", "time": 9541.03, "timestamp": "02:39:01", "text": "老兄，我有点累了。是的，你"}, {"type": "subtitle", "time": 9544.27, "timestamp": "02:39:04", "text": "知道，熬夜"}, {"type": "subtitle", "time": 9554.429, "timestamp": "02:39:14", "text": "你。是啊，那真的会让人精疲力竭。"}, {"type": "subtitle", "time": 9558.83, "timestamp": "02:39:18", "text": "以多种形式。我感觉"}, {"type": "subtitle", "time": 9561.75, "timestamp": "02:39:21", "text": "所以，今天的直播更像是……"}, {"type": "subtitle", "time": 9564.55, "timestamp": "02:39:24", "text": "挂出。这不是今天特指的"}, {"type": "subtitle", "time": 9567.07, "timestamp": "02:39:27", "text": "合作更像是一次聚会，而不是……"}, {"type": "subtitle", "time": 9570.23, "timestamp": "02:39:30", "text": "特定游戏，例如某个特定的游戏或"}, {"type": "subtitle", "time": 9572.71, "timestamp": "02:39:32", "text": "任何事物。更甚"}, {"type": "subtitle", "time": 9575.11, "timestamp": "02:39:35", "text": "嗯，灵活。我们只是闲逛而已。"}, {"type": "subtitle", "time": 9580.469, "timestamp": "02:39:40", "text": "嗯，理应如此。我们可以玩任何游戏"}, {"type": "subtitle", "time": 9584.95, "timestamp": "02:39:44", "text": "你想玩的游戏等等。"}, {"type": "subtitle", "time": 9586.67, "timestamp": "02:39:46", "text": "所以"}, {"type": "subtitle", "time": 9590.59, "timestamp": "02:39:50", "text": "是的，我也在下载《死亡岛》。"}, {"type": "subtitle", "time": 9592.67, "timestamp": "02:39:52", "text": "但"}, {"type": "subtitle", "time": 9596.63, "timestamp": "02:39:56", "text": "是的，他必须下载这个。为什么？"}]
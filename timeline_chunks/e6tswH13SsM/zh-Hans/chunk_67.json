[{"type": "subtitle", "time": 4023.67, "timestamp": "01:07:03", "text": "一？你还在祈祷什么？呃，这个"}, {"type": "subtitle", "time": 4025.069, "timestamp": "01:07:05", "text": "被称为"}, {"type": "subtitle", "time": 4029.63, "timestamp": "01:07:09", "text": "呃，我感染了Nova菌株。是啊，我忘了。"}, {"type": "subtitle", "time": 4033.19, "timestamp": "01:07:13", "text": "他的名字是蓝色的，压蓝球。"}, {"type": "subtitle", "time": 4042.839, "timestamp": "01:07:22", "text": "球。 哦，明白了"}, {"type": "subtitle", "time": 4058.069, "timestamp": "01:07:38", "text": "哇。哦，我又遇到这种情况了。我会这么做。"}]
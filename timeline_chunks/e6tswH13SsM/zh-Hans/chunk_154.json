[{"type": "subtitle", "time": 9240.79, "timestamp": "02:34:00", "text": "外部所以，我只是把它重新加热一下。我认为"}, {"type": "subtitle", "time": 9243.51, "timestamp": "02:34:03", "text": "我要做鸡蛋。是的，我想我会"}, {"type": "subtitle", "time": 9246.469, "timestamp": "02:34:06", "text": "做鸡蛋。如果你发现我的音频有问题"}, {"type": "subtitle", "time": 9249.349, "timestamp": "02:34:09", "text": "乱码，那意味着我的网络出了问题。好的。"}, {"type": "subtitle", "time": 9251.19, "timestamp": "02:34:11", "text": "我不知道。已经很晚了，怎么办？"}, {"type": "subtitle", "time": 9254.95, "timestamp": "02:34:14", "text": "你管这叫什么？哦，主啊，来了"}, {"type": "subtitle", "time": 9257.59, "timestamp": "02:34:17", "text": "某物。我不知道。你好。就像制作"}, {"type": "subtitle", "time": 9259.59, "timestamp": "02:34:19", "text": "蛋。等等，这不是……这不是"}, {"type": "subtitle", "time": 9263.75, "timestamp": "02:34:23", "text": "我应该用的东西。这是为了喜欢"}, {"type": "subtitle", "time": 9266.23, "timestamp": "02:34:26", "text": "呃，还有别的事。它叫什么？"}, {"type": "subtitle", "time": 9269.27, "timestamp": "02:34:29", "text": "你知道你不应该用呃一个"}, {"type": "subtitle", "time": 9273.429, "timestamp": "02:34:33", "text": "平底锅，不粘锅，什么都能用。"}, {"type": "subtitle", "time": 9278.309, "timestamp": "02:34:38", "text": "我们一般就用一个平底锅做菜，"}, {"type": "subtitle", "time": 9281.11, "timestamp": "02:34:41", "text": "另一个平底锅，用来煎炸东西，"}, {"type": "subtitle", "time": 9283.19, "timestamp": "02:34:43", "text": "另一个就像……呃，制作……"}, {"type": "subtitle", "time": 9287.07, "timestamp": "02:34:47", "text": "背部之类的，你知道，就是那种"}, {"type": "subtitle", "time": 9290.11, "timestamp": "02:34:50", "text": "呃，东西。所以"}, {"type": "subtitle", "time": 9293.51, "timestamp": "02:34:53", "text": "是啊，我差点就想把鸡蛋打碎了。"}, {"type": "subtitle", "time": 9296.79, "timestamp": "02:34:56", "text": "放入平底锅中，用于制作"}]
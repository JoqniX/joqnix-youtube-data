[{"type": "subtitle", "time": 17821.35, "timestamp": "04:57:01", "text": "是的。对我来说就是这样。是的，"}, {"type": "subtitle", "time": 17824.868, "timestamp": "04:57:04", "text": "那真不错。我当时就想，是啊，我"}, {"type": "subtitle", "time": 17827.35, "timestamp": "04:57:07", "text": "看到创作者们做着很酷的事情。我"}, {"type": "subtitle", "time": 17836.03, "timestamp": "04:57:16", "text": "就是这么有趣。"}, {"type": "subtitle", "time": 17839.51, "timestamp": "04:57:19", "text": "所以，对于我的这段旅程，我只是把它当作……"}, {"type": "subtitle", "time": 17843.67, "timestamp": "04:57:23", "text": "以某种方式，呃，去做我该做的事"}, {"type": "subtitle", "time": 17846.47, "timestamp": "04:57:26", "text": "我喜欢做某事，但却做不到像那些人一样。"}, {"type": "subtitle", "time": 17849.43, "timestamp": "04:57:29", "text": "我放弃。而且V也很好。"}, {"type": "subtitle", "time": 17852.07, "timestamp": "04:57:32", "text": "管子你不能，你不必喜欢"}, {"type": "subtitle", "time": 17854.708, "timestamp": "04:57:34", "text": "被困在某种性质中，对吗？"}, {"type": "subtitle", "time": 17856.39, "timestamp": "04:57:36", "text": "总是探索不同的"}, {"type": "subtitle", "time": 17858.788, "timestamp": "04:57:38", "text": "尝试不同的东西"}, {"type": "subtitle", "time": 17861.35, "timestamp": "04:57:41", "text": "就像很多技能都可以在……中使用一样"}, {"type": "subtitle", "time": 17864.47, "timestamp": "04:57:44", "text": "虚拟主播现在不再仅仅是一种技能了。"}, {"type": "subtitle", "time": 17866.19, "timestamp": "04:57:46", "text": "我喜欢它的原因是"}, {"type": "subtitle", "time": 17869.11, "timestamp": "04:57:49", "text": "它既有趣又能教会你知识。"}, {"type": "subtitle", "time": 17871.59, "timestamp": "04:57:51", "text": "现在每天每当你制作视频时"}, {"type": "subtitle", "time": 17874.15, "timestamp": "04:57:54", "text": "就像你每次编辑一样"}, {"type": "subtitle", "time": 17877.11, "timestamp": "04:57:57", "text": "制作新的视频剪辑等等"}, {"type": "subtitle", "time": 17879.03, "timestamp": "04:57:59", "text": "那就上网查查吧"}]
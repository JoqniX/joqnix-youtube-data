[{"type": "subtitle", "time": 9124.469, "timestamp": "02:32:04", "text": "大部分大部分"}, {"type": "subtitle", "time": 9126.99, "timestamp": "02:32:06", "text": "大多。我是谁？"}, {"type": "subtitle", "time": 9129.55, "timestamp": "02:32:09", "text": "可听见的？这是主要问题。"}, {"type": "subtitle", "time": 9132.87, "timestamp": "02:32:12", "text": "不过，我脑海中突然冒出一个问题。"}, {"type": "subtitle", "time": 9141.55, "timestamp": "02:32:21", "text": "知道。"}, {"type": "subtitle", "time": 9144.15, "timestamp": "02:32:24", "text": "好的。因为我有降噪功能"}, {"type": "subtitle", "time": 9148.389, "timestamp": "02:32:28", "text": "已启用。我不是"}, {"type": "subtitle", "time": 9150.71, "timestamp": "02:32:30", "text": "呃，打开这个闸门……"}, {"type": "subtitle", "time": 9154.67, "timestamp": "02:32:34", "text": "虚拟电缆之类的东西。不，不，我的意思是呃"}, {"type": "subtitle", "time": 9157.51, "timestamp": "02:32:37", "text": "移动麦克风"}, {"type": "subtitle", "time": 9159.71, "timestamp": "02:32:39", "text": "呃，直播。所以"}, {"type": "subtitle", "time": 9162.95, "timestamp": "02:32:42", "text": "是的。你好。哦，天哪。我的天哪。等待。哦"}, {"type": "subtitle", "time": 9165.469, "timestamp": "02:32:45", "text": "上帝。我需要 我需要 我需要 哦，"}, {"type": "subtitle", "time": 9169.19, "timestamp": "02:32:49", "text": "等待。我需要一句“哦，我忘了”。我忘了。"}, {"type": "subtitle", "time": 9172.23, "timestamp": "02:32:52", "text": "队长高温。你被甩下来了。不"}]
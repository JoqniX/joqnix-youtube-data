[{"type": "subtitle", "time": 13327.07, "timestamp": "03:42:07", "text": "少し痛い。私は"}, {"type": "subtitle", "time": 13330.63, "timestamp": "03:42:10", "text": "右。ええ、待ってください。私の"}, {"type": "subtitle", "time": 13331.79, "timestamp": "03:42:11", "text": "彩度"}, {"type": "subtitle", "time": 13347.51, "timestamp": "03:42:27", "text": "時間。よし。死んだ。"}, {"type": "subtitle", "time": 13352.15, "timestamp": "03:42:32", "text": "ほら、これでうまくいくかな？"}, {"type": "subtitle", "time": 13355.75, "timestamp": "03:42:35", "text": "ああ、今、ああ、ああ、そうだ。あ、待って。"}, {"type": "subtitle", "time": 13358.63, "timestamp": "03:42:38", "text": "つまり、前のクロマキーは私の側だったということです。"}, {"type": "subtitle", "time": 13362.389, "timestamp": "03:42:42", "text": "あ、待って。今、あることに気づいた。"}, {"type": "subtitle", "time": 13366.229, "timestamp": "03:42:46", "text": "わかった。うん、今は良くなったよね？"}, {"type": "subtitle", "time": 13369.83, "timestamp": "03:42:49", "text": "そうねぇ。良くなったけど、うん、私の"}, {"type": "subtitle", "time": 13373.469, "timestamp": "03:42:53", "text": "目がどこか怪しい。"}, {"type": "subtitle", "time": 13377.51, "timestamp": "03:42:57", "text": "うん。ああ、なんてこった。わかった。"}]
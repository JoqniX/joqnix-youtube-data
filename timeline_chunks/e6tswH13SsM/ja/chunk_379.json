[{"type": "subtitle", "time": 22741.628, "timestamp": "06:19:01", "text": "[音楽]"}, {"type": "subtitle", "time": 22745.75, "timestamp": "06:19:05", "text": "待って。あなたは何をしていますか？"}, {"type": "subtitle", "time": 22748.99, "timestamp": "06:19:08", "text": "動物を置きます。"}, {"type": "subtitle", "time": 22751.51, "timestamp": "06:19:11", "text": "[音楽]"}, {"type": "subtitle", "time": 22776.548, "timestamp": "06:19:36", "text": "何か。自分たちで回さなければなりません。"}, {"type": "subtitle", "time": 22790.99, "timestamp": "06:19:50", "text": "立ち往生。私はほしくない"}, {"type": "subtitle", "time": 22797.31, "timestamp": "06:19:57", "text": "[音楽]"}]
[{"type": "subtitle", "time": 19261.03, "timestamp": "05:21:01", "text": "ああ、わかりました。あそこに斧があるよ。"}, {"type": "subtitle", "time": 19264.43, "timestamp": "05:21:04", "text": "うん、斧を見つけたよ。うん、手に入れたよ"}, {"type": "subtitle", "time": 19292.628, "timestamp": "05:21:32", "text": "苦闘。もし私の"}, {"type": "subtitle", "time": 19298.91, "timestamp": "05:21:38", "text": "くそ。"}, {"type": "subtitle", "time": 19301.35, "timestamp": "05:21:41", "text": "見て。待って、私たちはただ"}, {"type": "subtitle", "time": 19310.55, "timestamp": "05:21:50", "text": "ジョー。うん。うん。うん。うん。うん。うん。"}, {"type": "subtitle", "time": 19313.19, "timestamp": "05:21:53", "text": "わかった。想像する。"}, {"type": "subtitle", "time": 19315.35, "timestamp": "05:21:55", "text": "もし本当にそうだったら、待ってください。いいえ。いいえ。いいえ。"}]
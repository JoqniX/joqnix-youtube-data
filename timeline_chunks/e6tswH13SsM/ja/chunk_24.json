[{"type": "subtitle", "time": 1445.63, "timestamp": "00:24:05", "text": "さて、それはとても"}, {"type": "subtitle", "time": 1449.75, "timestamp": "00:24:09", "text": "いいね。待って、えっと、あなたが入力した通りですか"}, {"type": "subtitle", "time": 1454.23, "timestamp": "00:24:14", "text": "チャットで、または音声チャットで、または"}, {"type": "subtitle", "time": 1467.909, "timestamp": "00:24:27", "text": "おお。中国語は話せません。いいえ、"}, {"type": "subtitle", "time": 1470.43, "timestamp": "00:24:30", "text": "英語。あなたの声"}, {"type": "subtitle", "time": 1473.51, "timestamp": "00:24:33", "text": "あれ。そうそう。だから、できない。わかった。"}, {"type": "subtitle", "time": 1487.23, "timestamp": "00:24:47", "text": "心臓？ズームインしてみましょう。皆さん、見えますか？"}, {"type": "subtitle", "time": 1490.71, "timestamp": "00:24:50", "text": "それ？ハートマークと書いてあります。"}]
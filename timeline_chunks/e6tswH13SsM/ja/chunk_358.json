[{"type": "subtitle", "time": 21490.628, "timestamp": "05:58:10", "text": "[音楽]"}, {"type": "subtitle", "time": 21494.628, "timestamp": "05:58:14", "text": "はい、ここにいます。はい、私もここにいます。"}, {"type": "subtitle", "time": 21496.23, "timestamp": "05:58:16", "text": "はい、はい、はい。やったよ。やったよ。"}, {"type": "subtitle", "time": 21521.19, "timestamp": "05:58:41", "text": "ああ、ジャンプ。手伝ってもらえますか？ええと、私は"}, {"type": "subtitle", "time": 21529.19, "timestamp": "05:58:49", "text": "はい、私は落ちます。もう一度やらなきゃ。"}, {"type": "subtitle", "time": 21537.548, "timestamp": "05:58:57", "text": "待って、今行くよ"}]
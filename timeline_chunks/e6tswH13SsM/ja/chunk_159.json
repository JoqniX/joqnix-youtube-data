[{"type": "subtitle", "time": 9541.03, "timestamp": "02:39:01", "text": "ああ、ちょっと疲れたよ。うん、君"}, {"type": "subtitle", "time": 9544.27, "timestamp": "02:39:04", "text": "知ってるよ、夜通し起きて"}, {"type": "subtitle", "time": 9554.429, "timestamp": "02:39:14", "text": "あなた。うん、それは本当に疲れるね"}, {"type": "subtitle", "time": 9558.83, "timestamp": "02:39:18", "text": "様々な形で。私は感じる"}, {"type": "subtitle", "time": 9561.75, "timestamp": "02:39:21", "text": "ということで、今日の配信はどちらかというと"}, {"type": "subtitle", "time": 9564.55, "timestamp": "02:39:24", "text": "遊ぶ。これは今日の特定の"}, {"type": "subtitle", "time": 9567.07, "timestamp": "02:39:27", "text": "コラボはどちらかというと集まりであって、"}, {"type": "subtitle", "time": 9570.23, "timestamp": "02:39:30", "text": "特定のゲーム、例えば特定のゲームや"}, {"type": "subtitle", "time": 9572.71, "timestamp": "02:39:32", "text": "何でも。それはもっと"}, {"type": "subtitle", "time": 9575.11, "timestamp": "02:39:35", "text": "ええと、柔軟性があります。私たちはただぶらぶらしていて"}, {"type": "subtitle", "time": 9580.469, "timestamp": "02:39:40", "text": "ええ、当然のことです。どんなプレイでもできます"}, {"type": "subtitle", "time": 9584.95, "timestamp": "02:39:44", "text": "あなたがプレイしたいゲームなど、そういう類のもの。"}, {"type": "subtitle", "time": 9586.67, "timestamp": "02:39:46", "text": "それで"}, {"type": "subtitle", "time": 9590.59, "timestamp": "02:39:50", "text": "うん、僕もDead Islandをダウンロードしてるよ。"}, {"type": "subtitle", "time": 9592.67, "timestamp": "02:39:52", "text": "しかし"}, {"type": "subtitle", "time": 9596.63, "timestamp": "02:39:56", "text": "ええ、彼はこれをダウンロードしなければなりませんでした。もし"}]
[{"type": "subtitle", "time": 23344.75, "timestamp": "06:29:04", "text": "チャンス。掴んで掴んで掴んで"}, {"type": "subtitle", "time": 23347.42, "timestamp": "06:29:07", "text": "はぁ？今の見た？"}, {"type": "subtitle", "time": 23353.35, "timestamp": "06:29:13", "text": "[音楽]"}, {"type": "subtitle", "time": 23356.51, "timestamp": "06:29:16", "text": "チェックポイントを読み込んでいますか？なぜ私たちは"}, {"type": "subtitle", "time": 23361.91, "timestamp": "06:29:21", "text": "私はこのレベルをプレイするつもりです"}, {"type": "subtitle", "time": 23373.59, "timestamp": "06:29:33", "text": "[音楽]"}, {"type": "subtitle", "time": 23376.468, "timestamp": "06:29:36", "text": "もううんざりだ。"}, {"type": "subtitle", "time": 23380.708, "timestamp": "06:29:40", "text": "ああ、あの島ですね。えっと"}, {"type": "chat", "time": 23383.341, "timestamp": "06:29:43", "author": "@Shiori_mitsuki", "avatar": "https://yt4.ggpht.com/Dn0VbakjSKrSNaXx6PyhznuqbomoCGx22ivSawRcMXp25Io7cfsud3H3qP-g9QprPJUESlxxtJA=s64-c-k-c0x00ffffff-no-rj", "message": "Why not its nicee"}, {"type": "subtitle", "time": 23384.07, "timestamp": "06:29:44", "text": "えーと、土地２は土地２は２です"}, {"type": "subtitle", "time": 23386.548, "timestamp": "06:29:46", "text": "完了しました。ああ、終わった。それをプレイしましょう。私"}, {"type": "subtitle", "time": 23395.67, "timestamp": "06:29:55", "text": "わかった。ゾンビを倒す時間だ。さあ行こう。"}, {"type": "subtitle", "time": 23397.68, "timestamp": "06:29:57", "text": "さあ行こう。 わかった。"}, {"type": "subtitle", "time": 23399.32, "timestamp": "06:29:59", "text": "わかった。 ねずみ。今はマウスは必要ありません。今"}]
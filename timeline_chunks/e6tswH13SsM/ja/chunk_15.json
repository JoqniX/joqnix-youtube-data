[{"type": "subtitle", "time": 900.629, "timestamp": "00:15:00", "text": "ラマX。何が起こったのですか？"}, {"type": "subtitle", "time": 909.87, "timestamp": "00:15:09", "text": "知らせ。私は爆弾を破壊します。"}, {"type": "subtitle", "time": 919.35, "timestamp": "00:15:19", "text": "ニース。ああ、我々守備隊よ。忘れた。ああ、私は"}, {"type": "subtitle", "time": 920.87, "timestamp": "00:15:20", "text": "私たちはまだ攻撃者だと思っていた。一度もない"}, {"type": "subtitle", "time": 958.03, "timestamp": "00:15:58", "text": "裏切り。"}]
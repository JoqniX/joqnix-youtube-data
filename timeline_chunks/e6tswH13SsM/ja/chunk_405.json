[{"type": "subtitle", "time": 24302.23, "timestamp": "06:45:02", "text": "今。ああ、でもロビーは作成できないんです。私"}, {"type": "subtitle", "time": 24306.29, "timestamp": "06:45:06", "text": "何度も作ってみた。"}, {"type": "subtitle", "time": 24308.548, "timestamp": "06:45:08", "text": "[音楽]"}, {"type": "subtitle", "time": 24310.708, "timestamp": "06:45:10", "text": "うん。でも、いや、招待状を作ることはできます"}, {"type": "subtitle", "time": 24312.39, "timestamp": "06:45:12", "text": "今ならあなたを招待できます"}, {"type": "subtitle", "time": 24314.628, "timestamp": "06:45:14", "text": "スチーム。ああ、私たちはSteamではありません。待って、どうやって"}, {"type": "subtitle", "time": 24324.43, "timestamp": "06:45:24", "text": "追加？待って、"}, {"type": "subtitle", "time": 24327.38, "timestamp": "06:45:27", "text": "見る。覚えていない。"}, {"type": "subtitle", "time": 24354.31, "timestamp": "06:45:54", "text": "[音楽]"}, {"type": "subtitle", "time": 24355.67, "timestamp": "06:45:55", "text": "ああ、あのね？ねえ、行かなきゃ"}, {"type": "subtitle", "time": 24358.11, "timestamp": "06:45:58", "text": "どこかちょうど"}]
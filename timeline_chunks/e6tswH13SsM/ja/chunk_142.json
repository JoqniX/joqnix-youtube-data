[{"type": "subtitle", "time": 8522.389, "timestamp": "02:22:02", "text": "あなたに何が起こっているのですか？そうですね、私は"}, {"type": "subtitle", "time": 8525.59, "timestamp": "02:22:05", "text": "まだ朝食は食べていませんが、"}, {"type": "subtitle", "time": 8530.469, "timestamp": "02:22:10", "text": "それを持っている。いや、私はこう思ったんだ"}, {"type": "subtitle", "time": 8534.07, "timestamp": "02:22:14", "text": "来て、みんなを"}, {"type": "subtitle", "time": 8538.349, "timestamp": "02:22:18", "text": "VRBモードか何かで、えっと、"}, {"type": "subtitle", "time": 8542.23, "timestamp": "02:22:22", "text": "または、モバイルオーディオの音声を録音することもできます"}, {"type": "subtitle", "time": 8544.389, "timestamp": "02:22:24", "text": "あれ。"}, {"type": "subtitle", "time": 8547.19, "timestamp": "02:22:27", "text": "誰が参加するの？誰かやってくれる人いる？"}, {"type": "subtitle", "time": 8549.67, "timestamp": "02:22:29", "text": "私は話せます。誰も家にいない、"}, {"type": "subtitle", "time": 8552.07, "timestamp": "02:22:32", "text": "だから、私がその間あなたと話せるように"}, {"type": "subtitle", "time": 8554.67, "timestamp": "02:22:34", "text": "私は料理をしています"}, {"type": "subtitle", "time": 8557.11, "timestamp": "02:22:37", "text": "台所。うん、それは面白そうだね。それ"}, {"type": "subtitle", "time": 8559.99, "timestamp": "02:22:39", "text": "それは、どのように"}, {"type": "subtitle", "time": 8566.87, "timestamp": "02:22:46", "text": "行く。うん、待ちきれないよ。それでは、"}]
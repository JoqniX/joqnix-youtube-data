[{"type": "subtitle", "time": 15421.91, "timestamp": "04:17:01", "text": "えっと、クリスマス頃かな。しかし"}, {"type": "subtitle", "time": 15425.91, "timestamp": "04:17:05", "text": "ええ、もう6年以上経ちました"}, {"type": "chat", "time": 15426.654, "timestamp": "04:17:06", "author": "@Minkk102", "avatar": "https://yt4.ggpht.com/TF8h5uIigJBanBg4LA_XZaY69S8H6wHtAUIDSGgMxHUqkEYRKq0z9m5NM8cqeDFnXLN0nN8i8g=s64-c-k-c0x00ffffff-no-rj", "message": "yee interview session"}, {"type": "subtitle", "time": 15428.51, "timestamp": "04:17:08", "text": "ストリーミングを始めて数ヶ月経ちましたが、"}, {"type": "subtitle", "time": 15431.269, "timestamp": "04:17:11", "text": "推測。それは良かった。いいですね。私はできる"}, {"type": "subtitle", "time": 15433.83, "timestamp": "04:17:13", "text": "いろいろなことをする。ええと、私たちはたくさんやりました、"}, {"type": "subtitle", "time": 15437.03, "timestamp": "04:17:17", "text": "イベントとか、そういうの。だから私にとっては、"}, {"type": "subtitle", "time": 15439.91, "timestamp": "04:17:19", "text": "楽しいよ。はい、正直に言うと、とても"}, {"type": "subtitle", "time": 15448.79, "timestamp": "04:17:28", "text": "うん、それはいいことだ。彼らはたくさんのことをした"}, {"type": "subtitle", "time": 15452.269, "timestamp": "04:17:32", "text": "ああ、私たちは"}, {"type": "subtitle", "time": 15455.189, "timestamp": "04:17:35", "text": "タレント。私はそこにいた。私は見ているような"}, {"type": "subtitle", "time": 15459.03, "timestamp": "04:17:39", "text": "それはとても良かった。楽しかったです。"}, {"type": "subtitle", "time": 15462.229, "timestamp": "04:17:42", "text": "それは実に独創的なアイデアだ。いいえ、それは"}, {"type": "subtitle", "time": 15465.189, "timestamp": "04:17:45", "text": "した。うん。これまで誰もこんなことをしたことがない。"}, {"type": "subtitle", "time": 15467.99, "timestamp": "04:17:47", "text": "そこが問題なんです。私が考えると"}, {"type": "subtitle", "time": 15471.429, "timestamp": "04:17:51", "text": "君のこと覚えてるよ、うん。アストラは"}, {"type": "subtitle", "time": 15474.95, "timestamp": "04:17:54", "text": "私はYouTuberです。"}, {"type": "subtitle", "time": 15477.349, "timestamp": "04:17:57", "text": "誰もこのアイデアを実行していないページ"}]
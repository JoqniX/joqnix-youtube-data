[{"type": "subtitle", "time": 11419.79, "timestamp": "03:10:19", "text": "神よ、それは"}, {"type": "subtitle", "time": 11432.87, "timestamp": "03:10:32", "text": "文字通りの爆撃が起こった。ニース。"}, {"type": "subtitle", "time": 11440.67, "timestamp": "03:10:40", "text": "皆さん"}, {"type": "subtitle", "time": 11444.63, "timestamp": "03:10:44", "text": "時間が経つにつれて、状況は変化します。"}, {"type": "subtitle", "time": 11454.03, "timestamp": "03:10:54", "text": "聖なる主よ。 1つ"}, {"type": "subtitle", "time": 11457.11, "timestamp": "03:10:57", "text": "それは悪いことです。ご自由にお過ごしください"}, {"type": "subtitle", "time": 11459.99, "timestamp": "03:10:59", "text": "落ち着いた。"}]
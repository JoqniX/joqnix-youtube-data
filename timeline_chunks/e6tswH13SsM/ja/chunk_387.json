[{"type": "subtitle", "time": 23246.948, "timestamp": "06:27:26", "text": "なぜ？私は飛び越えることができなかった。"}, {"type": "subtitle", "time": 23256.15, "timestamp": "06:27:36", "text": "どこ？"}, {"type": "subtitle", "time": 23258.27, "timestamp": "06:27:38", "text": "その間に"}, {"type": "subtitle", "time": 23261.91, "timestamp": "06:27:41", "text": "山々。例えば、この岩山のように。"}, {"type": "subtitle", "time": 23264.15, "timestamp": "06:27:44", "text": "丘ではない。ああ、山だ。これ"}]
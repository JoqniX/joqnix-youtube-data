[{"type": "subtitle", "time": 9124.469, "timestamp": "02:32:04", "text": "ほとんどほとんど"}, {"type": "subtitle", "time": 9126.99, "timestamp": "02:32:06", "text": "たいてい。私は"}, {"type": "subtitle", "time": 9129.55, "timestamp": "02:32:09", "text": "聞こえる？それが主な"}, {"type": "subtitle", "time": 9132.87, "timestamp": "02:32:12", "text": "しかし、ふと疑問が頭に浮かんだ。"}, {"type": "subtitle", "time": 9141.55, "timestamp": "02:32:21", "text": "知る。"}, {"type": "subtitle", "time": 9144.15, "timestamp": "02:32:24", "text": "わかった。ノイズ抑制機能があるから"}, {"type": "subtitle", "time": 9148.389, "timestamp": "02:32:28", "text": "有効になっています。私はそうではない"}, {"type": "subtitle", "time": 9150.71, "timestamp": "02:32:30", "text": "えーと、このゲートをオンにすると、"}, {"type": "subtitle", "time": 9154.67, "timestamp": "02:32:34", "text": "仮想ケーブルみたいなもの。いや、いや、つまり、えっと"}, {"type": "subtitle", "time": 9157.51, "timestamp": "02:32:37", "text": "モバイルマイク"}, {"type": "subtitle", "time": 9159.71, "timestamp": "02:32:39", "text": "えっと、ストリーム。それで"}, {"type": "subtitle", "time": 9162.95, "timestamp": "02:32:42", "text": "うん。こんにちは。ああ、ああ神様。ああ、神様。待って。おお"}, {"type": "subtitle", "time": 9165.469, "timestamp": "02:32:45", "text": "神。必要なんだ、必要なんだ、必要なんだ、ああ、"}, {"type": "subtitle", "time": 9169.19, "timestamp": "02:32:49", "text": "待って。ああ、忘れてた。忘れた。"}, {"type": "subtitle", "time": 9172.23, "timestamp": "02:32:52", "text": "キャプテン、高温。振り落とせ。しないで"}]
[{"type": "chat", "time": 17107.696, "timestamp": "04:45:07", "author": "@OtakuArceus", "avatar": "https://yt4.ggpht.com/VSZC0x7e02-tCAnte525GcpFOF0YcSpYQWplJkdg1RARvkQA3ETFxFaiYVshpLrqHFKUMz4VmA=s64-c-k-c0x00ffffff-no-rj", "message": "lmao"}, {"type": "subtitle", "time": 17110.23, "timestamp": "04:45:10", "text": "でも、私がドットチューブに使っていたものを知ってる？"}, {"type": "subtitle", "time": 17117.51, "timestamp": "04:45:17", "text": "ええ、それで私はビデオを作っていました。私"}, {"type": "subtitle", "time": 17120.868, "timestamp": "04:45:20", "text": "その時は配信しなかったけど、うん"}, {"type": "subtitle", "time": 17123.11, "timestamp": "04:45:23", "text": "その後、現実世界で忙しくなったので、それを中断しました。"}, {"type": "subtitle", "time": 17125.43, "timestamp": "04:45:25", "text": "もの"}, {"type": "subtitle", "time": 17127.91, "timestamp": "04:45:27", "text": "そして私はそれほど知識を持っていなかった"}, {"type": "subtitle", "time": 17130.788, "timestamp": "04:45:30", "text": "この件全体について。それで私は"}, {"type": "subtitle", "time": 17132.948, "timestamp": "04:45:32", "text": "私が取り組むべきことは分かっているでしょう？"}, {"type": "subtitle", "time": 17134.948, "timestamp": "04:45:34", "text": "いくつか。あなたに完全に知ってもらう必要がある"}, {"type": "subtitle", "time": 17138.55, "timestamp": "04:45:38", "text": "これらの仕組みについて理解を深める。"}, {"type": "subtitle", "time": 17141.708, "timestamp": "04:45:41", "text": "そして私はアストラを作った。"}, {"type": "subtitle", "time": 17144.628, "timestamp": "04:45:44", "text": "あ、待って。つまり、あなたは試したということですね"}, {"type": "subtitle", "time": 17151.67, "timestamp": "04:45:51", "text": "うん、まあそんな感じ。それは同じだった"}, {"type": "subtitle", "time": 17155.59, "timestamp": "04:45:55", "text": "ペルソナではあったが、それは違っていた。"}, {"type": "subtitle", "time": 17158.23, "timestamp": "04:45:58", "text": "俺はあの頃は大人びすぎだったんだよ、兄弟。"}]
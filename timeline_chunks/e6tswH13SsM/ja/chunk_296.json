[{"type": "subtitle", "time": 17760.07, "timestamp": "04:56:00", "text": "コンテンツの一種として、もしそれが"}, {"type": "subtitle", "time": 17762.55, "timestamp": "04:56:02", "text": "寿司でさえ達成可能"}, {"type": "subtitle", "time": 17764.55, "timestamp": "04:56:04", "text": "ドラゴンがやっていることも"}, {"type": "subtitle", "time": 17766.788, "timestamp": "04:56:06", "text": "将来的にYouTuberとして達成可能"}, {"type": "subtitle", "time": 17769.91, "timestamp": "04:56:09", "text": "いや、だから私は「うん、ステップするよ」って思ったんだ"}, {"type": "subtitle", "time": 17772.15, "timestamp": "04:56:12", "text": "この道で私は学びたい"}, {"type": "subtitle", "time": 17774.628, "timestamp": "04:56:14", "text": "Sushi Dragon が彼の"}, {"type": "subtitle", "time": 17778.07, "timestamp": "04:56:18", "text": "革新的なストリームとか、そういうのですね。"}, {"type": "subtitle", "time": 17780.868, "timestamp": "04:56:20", "text": "それが私を実際に"}, {"type": "subtitle", "time": 17784.628, "timestamp": "04:56:24", "text": "プロとして始める、真剣に、私はこうしたい"}, {"type": "subtitle", "time": 17787.75, "timestamp": "04:56:27", "text": "ジョックのためにVTuberに転身する"}, {"type": "subtitle", "time": 17791.19, "timestamp": "04:56:31", "text": "ただ漫然とストリーミングするのではなく、"}, {"type": "subtitle", "time": 17792.91, "timestamp": "04:56:32", "text": "物を持っていない"}, {"type": "subtitle", "time": 17795.43, "timestamp": "04:56:35", "text": "ブランドイメージとか、そういう類のもの。その時"}, {"type": "subtitle", "time": 17798.23, "timestamp": "04:56:38", "text": "ロゴを作ったばかりで、今回は"}, {"type": "subtitle", "time": 17801.03, "timestamp": "04:56:41", "text": "ああ、顔全体を描けるんだと気づいた"}, {"type": "subtitle", "time": 17804.47, "timestamp": "04:56:44", "text": "キャラクターデザイン、ストーリー、伝承を詰め込む"}, {"type": "subtitle", "time": 17807.91, "timestamp": "04:56:47", "text": "多くのものや日常的なアイデアが使われています"}, {"type": "subtitle", "time": 17809.91, "timestamp": "04:56:49", "text": "やって来て、私は"}, {"type": "subtitle", "time": 17811.83, "timestamp": "04:56:51", "text": "うん、デビューさせるつもりだし"}, {"type": "subtitle", "time": 17815.11, "timestamp": "04:56:55", "text": "すべては起こったが、それは決して起こらなかった。"}, {"type": "subtitle", "time": 17817.27, "timestamp": "04:56:57", "text": "おお"}]
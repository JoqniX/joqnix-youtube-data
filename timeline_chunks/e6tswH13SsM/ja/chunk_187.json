[{"type": "subtitle", "time": 11228.83, "timestamp": "03:07:08", "text": "全て"}, {"type": "subtitle", "time": 11232.71, "timestamp": "03:07:12", "text": "あなたが私に送ってくれたもの"}, {"type": "subtitle", "time": 11253.55, "timestamp": "03:07:33", "text": "スキル"}, {"type": "subtitle", "time": 11256.269, "timestamp": "03:07:36", "text": "共振。早く終わらせたい、"}, {"type": "subtitle", "time": 11261.11, "timestamp": "03:07:41", "text": "しかし、アストラはいつでも家に帰ってくるだろう。いいえ。"}, {"type": "subtitle", "time": 11265.19, "timestamp": "03:07:45", "text": "来て。ああ、このペリカン缶みたいなやつ。私"}]
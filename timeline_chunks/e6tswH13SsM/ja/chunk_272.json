[{"type": "subtitle", "time": 16322.83, "timestamp": "04:32:02", "text": "もし私がYouTuberになったら"}, {"type": "subtitle", "time": 16326.55, "timestamp": "04:32:06", "text": "今ならもっとたくさんのことができる"}, {"type": "subtitle", "time": 16328.229, "timestamp": "04:32:08", "text": "可能性が多すぎる"}, {"type": "subtitle", "time": 16331.269, "timestamp": "04:32:11", "text": "何かをする"}, {"type": "subtitle", "time": 16333.99, "timestamp": "04:32:13", "text": "そうすれば、制限されなくなるから"}, {"type": "subtitle", "time": 16338.55, "timestamp": "04:32:18", "text": "そして、現実世界の論理に制約される"}, {"type": "subtitle", "time": 16341.349, "timestamp": "04:32:21", "text": "事実上、私は何でも正しくできる"}, {"type": "subtitle", "time": 16343.59, "timestamp": "04:32:23", "text": "はい"}, {"type": "subtitle", "time": 16345.189, "timestamp": "04:32:25", "text": "それが私の全てだった"}, {"type": "subtitle", "time": 16348.389, "timestamp": "04:32:28", "text": "そもそもYouTuberになること"}, {"type": "subtitle", "time": 16350.309, "timestamp": "04:32:30", "text": "それは何か新しいものだった。たくさんの"}, {"type": "subtitle", "time": 16352.309, "timestamp": "04:32:32", "text": "人々はそれをしていなかった。そうだった"}, {"type": "subtitle", "time": 16360.07, "timestamp": "04:32:40", "text": "でもそうですね、多くの"}, {"type": "subtitle", "time": 16362.349, "timestamp": "04:32:42", "text": "この分野の人々は創造性に富んでいる。その"}, {"type": "subtitle", "time": 16364.71, "timestamp": "04:32:44", "text": "ただそれを使う必要があるし、"}, {"type": "subtitle", "time": 16367.269, "timestamp": "04:32:47", "text": "やってみて。例えば、もし私がそうしなかったら"}, {"type": "subtitle", "time": 16369.11, "timestamp": "04:32:49", "text": "今ではそれほど人気が​​あると言っても、"}, {"type": "subtitle", "time": 16372.07, "timestamp": "04:32:52", "text": "もし私が卒業したら、私は、私は"}, {"type": "subtitle", "time": 16375.99, "timestamp": "04:32:55", "text": "現実世界で忙しいとか何かあるか、あるいは私は"}, {"type": "subtitle", "time": 16377.75, "timestamp": "04:32:57", "text": "やりたいことをやり遂げることができなかった"}, {"type": "subtitle", "time": 16379.99, "timestamp": "04:32:59", "text": "このコミュニティで今少なくともできること"}]
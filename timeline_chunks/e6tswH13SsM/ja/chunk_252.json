[{"type": "subtitle", "time": 15121.99, "timestamp": "04:12:01", "text": "そしてインド。そして彼らが作り始めた後"}, {"type": "subtitle", "time": 15123.87, "timestamp": "04:12:03", "text": "インドでは、それは一種の"}, {"type": "subtitle", "time": 15127.59, "timestamp": "04:12:07", "text": "安い。え、何？ iPhone や"}, {"type": "subtitle", "time": 15130.469, "timestamp": "04:12:10", "text": "データプラン？ iPhone？"}, {"type": "subtitle", "time": 15133.189, "timestamp": "04:12:13", "text": "いいえ。わかりました。つまりデータプランがあれば"}, {"type": "subtitle", "time": 15136.07, "timestamp": "04:12:16", "text": "高価だった。インターネットは大きく"}, {"type": "subtitle", "time": 15138.79, "timestamp": "04:12:18", "text": "高い。しかし6月のおかげで、"}, {"type": "subtitle", "time": 15141.269, "timestamp": "04:12:21", "text": "彼らは、"}, {"type": "subtitle", "time": 15142.79, "timestamp": "04:12:22", "text": "インターネットの市場全体"}, {"type": "subtitle", "time": 15144.95, "timestamp": "04:12:24", "text": "そして、キャリアサービスも利用できるようになりました。非常に安い"}, {"type": "subtitle", "time": 15147.75, "timestamp": "04:12:27", "text": "インド。ああ、彼らがそれを発売したから"}, {"type": "subtitle", "time": 15149.95, "timestamp": "04:12:29", "text": "さあ、計画を立てよう。"}, {"type": "subtitle", "time": 15153.51, "timestamp": "04:12:33", "text": "それは良い判断だ。でも、そう、だから"}, {"type": "subtitle", "time": 15155.99, "timestamp": "04:12:35", "text": "インドでは、Wi-Fi を安価に入手でき、"}, {"type": "subtitle", "time": 15158.389, "timestamp": "04:12:38", "text": "他国と比較した物。しかし"}, {"type": "subtitle", "time": 15161.91, "timestamp": "04:12:41", "text": "ええ、Appleも彼らの"}, {"type": "subtitle", "time": 15164.07, "timestamp": "04:12:44", "text": "インドでの生産みたいなもの。彼らは"}, {"type": "subtitle", "time": 15166.55, "timestamp": "04:12:46", "text": "台湾では、リンゴは通常"}, {"type": "subtitle", "time": 15169.03, "timestamp": "04:12:49", "text": "そこで製造された。"}, {"type": "subtitle", "time": 15171.83, "timestamp": "04:12:51", "text": "ええと、彼らは工場を設立しているところです"}, {"type": "subtitle", "time": 15175.75, "timestamp": "04:12:55", "text": "インドに拠点があるが、外交関係もある"}, {"type": "subtitle", "time": 15178.469, "timestamp": "04:12:58", "text": "米国では今起きていること"}]
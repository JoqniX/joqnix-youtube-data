[{"type": "subtitle", "time": 17702.47, "timestamp": "04:55:02", "text": "そして彼らが変えられるものはすべて違う"}, {"type": "subtitle", "time": 17706.47, "timestamp": "04:55:06", "text": "ドレスなど、多くのものは同じです"}, {"type": "subtitle", "time": 17708.31, "timestamp": "04:55:08", "text": "たとえ制限されていても、"}, {"type": "subtitle", "time": 17711.59, "timestamp": "04:55:11", "text": "YouTuberによって達成可能、そして"}, {"type": "subtitle", "time": 17713.43, "timestamp": "04:55:13", "text": "3Dモデルとかそういうの"}, {"type": "subtitle", "time": 17717.11, "timestamp": "04:55:17", "text": "コンセプトは本当に私を好奇心をそそり、"}, {"type": "subtitle", "time": 17720.628, "timestamp": "04:55:20", "text": "うん、これをやりたい理由は"}, {"type": "subtitle", "time": 17722.788, "timestamp": "04:55:22", "text": "Twitch でのその期間、私は"}, {"type": "subtitle", "time": 17725.67, "timestamp": "04:55:25", "text": "Sushiというストリーマーの配信を見ています"}, {"type": "subtitle", "time": 17728.788, "timestamp": "04:55:28", "text": "ドラゴン。だから彼がやっていることは、"}, {"type": "subtitle", "time": 17732.948, "timestamp": "04:55:32", "text": "体に装備を身につけていて、たくさん"}, {"type": "subtitle", "time": 17735.83, "timestamp": "04:55:35", "text": "ライブ編集タイプのストリームなど"}, {"type": "subtitle", "time": 17737.99, "timestamp": "04:55:37", "text": "通常はビデオを編集して、いいねを追加します"}, {"type": "subtitle", "time": 17740.47, "timestamp": "04:55:40", "text": "モンタージュタイプのエフェクトがたくさんあり、"}, {"type": "subtitle", "time": 17742.948, "timestamp": "04:55:42", "text": "正しいことをしているが、彼はリアルタイムでやっている"}, {"type": "subtitle", "time": 17745.11, "timestamp": "04:55:45", "text": "実際のリアルタイムのように、"}, {"type": "subtitle", "time": 17748.23, "timestamp": "04:55:48", "text": "ボタンとかそういうのがあって、それで私は"}, {"type": "subtitle", "time": 17750.55, "timestamp": "04:55:50", "text": "本当に刺激を受けた。だから私はこう考えていた"}, {"type": "subtitle", "time": 17754.15, "timestamp": "04:55:54", "text": "だから、もしチューブが限界を破ることができるなら"}, {"type": "subtitle", "time": 17756.948, "timestamp": "04:55:56", "text": "それ自体で、それを等しくする"}]
[{"type": "subtitle", "time": 13741.59, "timestamp": "03:49:01", "text": "ああ、富士山を使えばいつでも大丈夫だよ。私は"}, {"type": "subtitle", "time": 13743.15, "timestamp": "03:49:03", "text": "次のように考える"}, {"type": "subtitle", "time": 13747.03, "timestamp": "03:49:07", "text": "えっと、今はモータルショーケースです。私が使用する理由"}, {"type": "subtitle", "time": 13749.349, "timestamp": "03:49:09", "text": "ヴド？"}, {"type": "subtitle", "time": 13752.15, "timestamp": "03:49:12", "text": "Vudoを使ってほしいのですか？しかし、どのようにすべきか"}, {"type": "subtitle", "time": 13755.189, "timestamp": "03:49:15", "text": "私がそう言うの？ Vudo を使うことはできますが、"}, {"type": "subtitle", "time": 13756.71, "timestamp": "03:49:16", "text": "あなたにも共有した方がいいでしょうか？どのように"}, {"type": "subtitle", "time": 13759.11, "timestamp": "03:49:19", "text": "自分のフィードを共有すべきでしょうか？"}, {"type": "subtitle", "time": 13764.07, "timestamp": "03:49:24", "text": "ええと、私たちは Auda インスタンスに参加してそれを行います。"}, {"type": "subtitle", "time": 13767.349, "timestamp": "03:49:27", "text": "わかった。ダウンロードさせてください"}, {"type": "subtitle", "time": 13770.95, "timestamp": "03:49:30", "text": "けれど。うん。これでこの件は終わりにしましょう。"}, {"type": "subtitle", "time": 13781.07, "timestamp": "03:49:41", "text": "ニース。"}, {"type": "subtitle", "time": 13790.95, "timestamp": "03:49:50", "text": "ミラーVP関連のものを好きになれますか？"}, {"type": "subtitle", "time": 13798.389, "timestamp": "03:49:58", "text": "いや、たぶん私は自分の"}]
[{"type": "subtitle", "time": 17821.35, "timestamp": "04:57:01", "text": "うん。私にとってはそういうことだったんです。うん、"}, {"type": "subtitle", "time": 17824.868, "timestamp": "04:57:04", "text": "それはいいですね。私は、そう、"}, {"type": "subtitle", "time": 17827.35, "timestamp": "04:57:07", "text": "クリエイターたちがクールなものを作っているのを見た。私"}, {"type": "subtitle", "time": 17836.03, "timestamp": "04:57:16", "text": "そんな風に楽しいんです。"}, {"type": "subtitle", "time": 17839.51, "timestamp": "04:57:19", "text": "だから、私の旅では、"}, {"type": "subtitle", "time": 17843.67, "timestamp": "04:57:23", "text": "どうにかして、私が"}, {"type": "subtitle", "time": 17846.47, "timestamp": "04:57:26", "text": "やりたいけど、できない人もいる"}, {"type": "subtitle", "time": 17849.43, "timestamp": "04:57:29", "text": "私はあきらめます。そしてVと一緒にいるのは良いことだ"}, {"type": "subtitle", "time": 17852.07, "timestamp": "04:57:32", "text": "チューブは好きになれません"}, {"type": "subtitle", "time": 17854.708, "timestamp": "04:57:34", "text": "特定の自然の中で閉じ込められることは"}, {"type": "subtitle", "time": 17856.39, "timestamp": "04:57:36", "text": "常にさまざまなことを探求する"}, {"type": "subtitle", "time": 17858.788, "timestamp": "04:57:38", "text": "いろいろなことを試して、"}, {"type": "subtitle", "time": 17861.35, "timestamp": "04:57:41", "text": "多くのスキルは、"}, {"type": "subtitle", "time": 17864.47, "timestamp": "04:57:44", "text": "vtubeingはもはや単なる一つのスキルではなく、"}, {"type": "subtitle", "time": 17866.19, "timestamp": "04:57:46", "text": "私がそれを好きな理由は"}, {"type": "subtitle", "time": 17869.11, "timestamp": "04:57:49", "text": "楽しくて、教育的でもある"}, {"type": "subtitle", "time": 17871.59, "timestamp": "04:57:51", "text": "毎日ビデオを作るたびに"}, {"type": "subtitle", "time": 17874.15, "timestamp": "04:57:54", "text": "編集は、あなたがいつでも"}, {"type": "subtitle", "time": 17877.11, "timestamp": "04:57:57", "text": "新しいビデオ編集などを作成する"}, {"type": "subtitle", "time": 17879.03, "timestamp": "04:57:59", "text": "実際にインターネットで調べてみてください"}]
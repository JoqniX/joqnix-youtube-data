[{"type": "subtitle", "time": 9240.79, "timestamp": "02:34:00", "text": "外部だから、温め直しているだけです。私は思う"}, {"type": "subtitle", "time": 9243.51, "timestamp": "02:34:03", "text": "卵料理を作ります。うん、そうすると思う"}, {"type": "subtitle", "time": 9246.469, "timestamp": "02:34:06", "text": "卵を作る。もし私の音声が"}, {"type": "subtitle", "time": 9249.349, "timestamp": "02:34:09", "text": "インターネットがスクランブルされている、つまり私のインターネットが。わかった。"}, {"type": "subtitle", "time": 9251.19, "timestamp": "02:34:11", "text": "わからない。もう遅い時間です、どうすればいいですか"}, {"type": "subtitle", "time": 9254.95, "timestamp": "02:34:14", "text": "これを何と呼ぶのか？ああ主が来られるか"}, {"type": "subtitle", "time": 9257.59, "timestamp": "02:34:17", "text": "何か。わからない。こんにちは。作るように"}, {"type": "subtitle", "time": 9259.59, "timestamp": "02:34:19", "text": "卵。待って、これはこれは"}, {"type": "subtitle", "time": 9263.75, "timestamp": "02:34:23", "text": "私が使うべきもの。これは、"}, {"type": "subtitle", "time": 9266.23, "timestamp": "02:34:26", "text": "えっと、何か別のこと。それは何と呼ばれますか？"}, {"type": "subtitle", "time": 9269.27, "timestamp": "02:34:29", "text": "えっと、1つは使わない方がいいって知ってるよね"}, {"type": "subtitle", "time": 9273.429, "timestamp": "02:34:33", "text": "フライパン、何にでも使える焦げ付き防止フライパン。"}, {"type": "subtitle", "time": 9278.309, "timestamp": "02:34:38", "text": "普段はフライパン1つで済ませるんだけど、"}, {"type": "subtitle", "time": 9281.11, "timestamp": "02:34:41", "text": "揚げ物などに使う別のフライパン、"}, {"type": "subtitle", "time": 9283.19, "timestamp": "02:34:43", "text": "もう一つは、例えば、"}, {"type": "subtitle", "time": 9287.07, "timestamp": "02:34:47", "text": "背側とか、そういうやつ"}, {"type": "subtitle", "time": 9290.11, "timestamp": "02:34:50", "text": "えーと、いろいろ。それで"}, {"type": "subtitle", "time": 9293.51, "timestamp": "02:34:53", "text": "ええ、卵を割ろうとしたんです"}, {"type": "subtitle", "time": 9296.79, "timestamp": "02:34:56", "text": "鍋に入れて、"}]
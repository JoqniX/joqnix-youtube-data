[{"type": "subtitle", "time": 9304.59, "timestamp": "02:35:04", "text": "こんにちは。感謝"}, {"type": "subtitle", "time": 9317.91, "timestamp": "02:35:17", "text": "私？テキストソースを付けるべきだった"}, {"type": "subtitle", "time": 9328.23, "timestamp": "02:35:28", "text": "チャパティがあるという事実はご存知でしょう"}, {"type": "subtitle", "time": 9330.389, "timestamp": "02:35:30", "text": "そこには私が食べるものがあるが、私は食べられない"}, {"type": "subtitle", "time": 9332.67, "timestamp": "02:35:32", "text": "チャパティ、知らないから"}, {"type": "subtitle", "time": 9336.79, "timestamp": "02:35:36", "text": "なぜ私が正しく目覚めたいとき"}, {"type": "subtitle", "time": 9338.75, "timestamp": "02:35:38", "text": "これを見ると私はこう思う"}, {"type": "subtitle", "time": 9341.15, "timestamp": "02:35:41", "text": "ああ、私が"}, {"type": "subtitle", "time": 9344.71, "timestamp": "02:35:44", "text": "懐疑論者 私は食べたくない ただ行く"}, {"type": "subtitle", "time": 9348.07, "timestamp": "02:35:48", "text": "そして私は、"}, {"type": "subtitle", "time": 9352.63, "timestamp": "02:35:52", "text": "特に朝食を抜くと健康に悪影響があります"}, {"type": "subtitle", "time": 9354.59, "timestamp": "02:35:54", "text": "私は"}, {"type": "subtitle", "time": 9356.71, "timestamp": "02:35:56", "text": "[音楽]"}, {"type": "subtitle", "time": 9357.95, "timestamp": "02:35:57", "text": "それ"}]
[{"type": "subtitle", "time": 6785.79, "timestamp": "01:53:05", "text": "ニース。えっと、タイプ。ああ、ちょっと待って。えっと、私は言った"}, {"type": "subtitle", "time": 6789.35, "timestamp": "01:53:09", "text": "こんにちは。私は挨拶をした。そうは思わない"}, {"type": "subtitle", "time": 6793.43, "timestamp": "01:53:13", "text": "重要ですよね？ああ、これは君がコピーしたものか。待って、"}, {"type": "subtitle", "time": 6798.99, "timestamp": "01:53:18", "text": "コピー。"}, {"type": "subtitle", "time": 6802.149, "timestamp": "01:53:22", "text": "おお。待って、できる？コピーしない"}, {"type": "subtitle", "time": 6810.83, "timestamp": "01:53:30", "text": "ああ、これが私たちの"}, {"type": "subtitle", "time": 6814.51, "timestamp": "01:53:34", "text": "おお。ああ、私たちは話せる"}, {"type": "subtitle", "time": 6817.149, "timestamp": "01:53:37", "text": "今。"}, {"type": "subtitle", "time": 6820.589, "timestamp": "01:53:40", "text": "待って、あなたは"}, {"type": "subtitle", "time": 6829.51, "timestamp": "01:53:49", "text": "行く。ああ、Windowsのギフトだね。"}, {"type": "subtitle", "time": 6838.189, "timestamp": "01:53:58", "text": "アニメ。それはうまくいきますか？"}]
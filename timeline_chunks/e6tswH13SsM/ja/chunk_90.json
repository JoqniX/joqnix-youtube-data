[{"type": "subtitle", "time": 5401.99, "timestamp": "01:30:01", "text": "ああ、私はSKを持っていました。だからこうだった"}, {"type": "subtitle", "time": 5404.75, "timestamp": "01:30:04", "text": "常にその物を表示していることを示す。"}, {"type": "subtitle", "time": 5408.55, "timestamp": "01:30:08", "text": "ああ、ただ白い紙幣を集めればいいんだ。"}, {"type": "subtitle", "time": 5434.99, "timestamp": "01:30:34", "text": "持っている。"}, {"type": "subtitle", "time": 5438.99, "timestamp": "01:30:38", "text": "はい。そうそう。忘れてた"}, {"type": "subtitle", "time": 5447.03, "timestamp": "01:30:47", "text": "おお。ああ、わかりました。わかった。ページを受け取りました。私"}, {"type": "subtitle", "time": 5451.74, "timestamp": "01:30:51", "text": "この砂で遊びたい"}, {"type": "subtitle", "time": 5453.07, "timestamp": "01:30:53", "text": "[音楽]"}, {"type": "subtitle", "time": 5456.35, "timestamp": "01:30:56", "text": "レディ、追放"}]
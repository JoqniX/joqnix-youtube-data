[{"type": "subtitle", "time": 20523.67, "timestamp": "05:42:03", "text": "ああ、向こう側に行ってみて。うん、"}, {"type": "subtitle", "time": 20525.27, "timestamp": "05:42:05", "text": "そうしています。"}, {"type": "subtitle", "time": 20563.39, "timestamp": "05:42:43", "text": "ああ、そうだね。私は手に入れた"}, {"type": "subtitle", "time": 20568.35, "timestamp": "05:42:48", "text": "それ。え、何？我が神よ。私の"}, {"type": "subtitle", "time": 20574.708, "timestamp": "05:42:54", "text": "[音楽]"}, {"type": "subtitle", "time": 20578.868, "timestamp": "05:42:58", "text": "わかったよ、ジョー。物を投げているところです。試す。"}]
[{"type": "subtitle", "time": 8825.67, "timestamp": "02:27:05", "text": "難しい。ハニープーリ。私は欲しい、いいえ、私は欲しい"}, {"type": "subtitle", "time": 8828.03, "timestamp": "02:27:08", "text": "すべてを手に入れる"}, {"type": "subtitle", "time": 8832.03, "timestamp": "02:27:12", "text": "レシピ。インド料理のレシピ。それで、"}, {"type": "subtitle", "time": 8835.27, "timestamp": "02:27:15", "text": "わかりました。では、これを有効にします。えっと"}, {"type": "subtitle", "time": 8838.11, "timestamp": "02:27:18", "text": "この件についてどう思うか教えてください"}, {"type": "subtitle", "time": 8841.349, "timestamp": "02:27:21", "text": "音。ケーブルケーブルケーブルケーブルケーブル"}, {"type": "subtitle", "time": 8843.429, "timestamp": "02:27:23", "text": "ケーブル。あ、ところで、"}, {"type": "subtitle", "time": 8846.15, "timestamp": "02:27:26", "text": "わからない、VC を買ったんだけど、"}, {"type": "subtitle", "time": 8847.63, "timestamp": "02:27:27", "text": "バーチャルオーディオ"}, {"type": "subtitle", "time": 8851.27, "timestamp": "02:27:31", "text": "ケーブルは古いもので、"}, {"type": "subtitle", "time": 8854.19, "timestamp": "02:27:34", "text": "約"}, {"type": "subtitle", "time": 8859.51, "timestamp": "02:27:39", "text": "1999年頃。わからない。うん。えっと"}, {"type": "subtitle", "time": 8860.91, "timestamp": "02:27:40", "text": "人々"}, {"type": "subtitle", "time": 8863.349, "timestamp": "02:27:43", "text": "そう、仮想ケーブルみたいなやつ"}, {"type": "subtitle", "time": 8864.51, "timestamp": "02:27:44", "text": "どれの"}, {"type": "subtitle", "time": 8868.07, "timestamp": "02:27:48", "text": "誰もが使った。二重に聞こえたのは分かっています"}, {"type": "subtitle", "time": 8871.59, "timestamp": "02:27:51", "text": "音声はいいけど、頑張れよ。直そうとしています。"}, {"type": "subtitle", "time": 8874.55, "timestamp": "02:27:54", "text": "わかった。 Ouxケーブル。わかった。ええ、私は"}, {"type": "subtitle", "time": 8878.11, "timestamp": "02:27:58", "text": "最近購入しましたが、最大で"}]
[{"type": "subtitle", "time": 7083.709, "timestamp": "01:58:03", "text": "待って。はい。 1つあります。それは"}, {"type": "subtitle", "time": 7089.39, "timestamp": "01:58:09", "text": "コルゲート。はい。それが私です。はい、そうです"}, {"type": "subtitle", "time": 7091.709, "timestamp": "01:58:11", "text": "自分。ええ、そうですね。"}, {"type": "subtitle", "time": 7094.75, "timestamp": "01:58:14", "text": "えっと、明日、ヴァレラント"}, {"type": "subtitle", "time": 7097.47, "timestamp": "01:58:17", "text": "コルゲートの歯磨き粉。私"}, {"type": "subtitle", "time": 7103.31, "timestamp": "01:58:23", "text": "水と一緒に食べてください。私は最善を尽くします"}, {"type": "subtitle", "time": 7107.589, "timestamp": "01:58:27", "text": "底のカエルへ、でもまあ。"}, {"type": "subtitle", "time": 7112.669, "timestamp": "01:58:32", "text": "そして、私と、そのことについて"}, {"type": "subtitle", "time": 7114.27, "timestamp": "01:58:34", "text": "は"}, {"type": "subtitle", "time": 7118.109, "timestamp": "01:58:38", "text": "プロはこのゲームをとてもプレイしているので"}, {"type": "subtitle", "time": 7121.99, "timestamp": "01:58:41", "text": "グラインダー寿司もプレイする彼は行く"}, {"type": "subtitle", "time": 7124.149, "timestamp": "01:58:44", "text": "彼が楽しむためにプレイしているように、私たちもプレイする"}, {"type": "subtitle", "time": 7126.27, "timestamp": "01:58:46", "text": "CSとか色々だけど"}, {"type": "subtitle", "time": 7129.43, "timestamp": "01:58:49", "text": "うん、たまにプレイするけど"}, {"type": "subtitle", "time": 7131.55, "timestamp": "01:58:51", "text": "私も"}, {"type": "subtitle", "time": 7134.99, "timestamp": "01:58:54", "text": "歯磨き粉を飲みたくないので心配です"}, {"type": "subtitle", "time": 7138.229, "timestamp": "01:58:58", "text": "水ですが、私の目標は寿司を作ることです。"}]
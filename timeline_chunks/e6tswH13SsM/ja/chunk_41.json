[{"type": "subtitle", "time": 2467.75, "timestamp": "00:41:07", "text": "おお。重装甲。ああ、これは重い"}, {"type": "subtitle", "time": 2469.309, "timestamp": "00:41:09", "text": "鎧。"}, {"type": "subtitle", "time": 2472.99, "timestamp": "00:41:12", "text": "わかった。装甲速度領域。"}, {"type": "subtitle", "time": 2476.55, "timestamp": "00:41:16", "text": "わかった。星2つ。わかった。私は"}, {"type": "subtitle", "time": 2484.91, "timestamp": "00:41:24", "text": "1つ。私たちはどうですか"}, {"type": "subtitle", "time": 2518.67, "timestamp": "00:41:58", "text": "持っている"}]
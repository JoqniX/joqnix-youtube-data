[{"type": "subtitle", "time": 3362.19, "timestamp": "00:56:02", "text": "私は殺した"}, {"type": "subtitle", "time": 3365.63, "timestamp": "00:56:05", "text": "それ。ご寄付ありがとうございます"}, {"type": "subtitle", "time": 3368.71, "timestamp": "00:56:08", "text": "私にとって、スキン用のガチャはすごくクールなアイデアです。"}, {"type": "subtitle", "time": 3376.789, "timestamp": "00:56:16", "text": "これは重装甲ですね。待って、私が取りに行く"}, {"type": "subtitle", "time": 3391.99, "timestamp": "00:56:31", "text": "うん、もう寝るよ。楽しんでください"}, {"type": "subtitle", "time": 3395.91, "timestamp": "00:56:35", "text": "ゲームと配信。あ、こんにちは。寝なさい。"}, {"type": "subtitle", "time": 3396.99, "timestamp": "00:56:36", "text": "おお、"}]
[{"type": "subtitle", "time": 15902.87, "timestamp": "04:25:02", "text": "経験は人を変える。"}, {"type": "subtitle", "time": 15906.229, "timestamp": "04:25:06", "text": "うん。君はいつもそう言ってるよね"}, {"type": "subtitle", "time": 15909.51, "timestamp": "04:25:09", "text": "知恵はとても重要ですよね。"}, {"type": "subtitle", "time": 15911.149, "timestamp": "04:25:11", "text": "たくさん持っているときにのみ"}, {"type": "subtitle", "time": 15913.349, "timestamp": "04:25:13", "text": "経験。あなたは、あなたが持っているようなものを持っています"}, {"type": "subtitle", "time": 15929.99, "timestamp": "04:25:29", "text": "PTの夜間のトレーニングがうまくいくかどうか見てみたい"}, {"type": "subtitle", "time": 15932.189, "timestamp": "04:25:32", "text": "この中で"}, {"type": "subtitle", "time": 15935.75, "timestamp": "04:25:35", "text": "インド。心配しないで、そうなるよ"}, {"type": "subtitle", "time": 15938.95, "timestamp": "04:25:38", "text": "あなたにとっての挑戦です。"}, {"type": "subtitle", "time": 15941.189, "timestamp": "04:25:41", "text": "それは楽しいですね。それでは、何が言いたいのか"}, {"type": "subtitle", "time": 15942.95, "timestamp": "04:25:42", "text": "私がビデオを撮っているところを、もし簡単すぎるなら"}, {"type": "subtitle", "time": 15945.51, "timestamp": "04:25:45", "text": "私にとって？"}, {"type": "subtitle", "time": 15947.91, "timestamp": "04:25:47", "text": "何らかの課題があるはずだ。ノグ"}, {"type": "subtitle", "time": 15950.229, "timestamp": "04:25:50", "text": "はい。道路を運転したいですか"}, {"type": "subtitle", "time": 15952.309, "timestamp": "04:25:52", "text": "空いているか、道路を運転したいですか？"}, {"type": "subtitle", "time": 15954.469, "timestamp": "04:25:54", "text": "多くの障害があり、"}, {"type": "subtitle", "time": 15957.429, "timestamp": "04:25:57", "text": "いろいろなものと同じように、そうですよね？うん。のように"}]
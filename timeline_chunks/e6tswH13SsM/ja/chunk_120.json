[{"type": "subtitle", "time": 7201.27, "timestamp": "02:00:01", "text": "何か。早起きして"}, {"type": "subtitle", "time": 7203.75, "timestamp": "02:00:03", "text": "そうしてください。まあ、だいたいそんなところです。"}, {"type": "subtitle", "time": 7206.87, "timestamp": "02:00:06", "text": "本日はお越しいただき、ありがとうございました。そして"}, {"type": "subtitle", "time": 7211.83, "timestamp": "02:00:11", "text": "YouTube に来た人たち"}, {"type": "subtitle", "time": 7214.87, "timestamp": "02:00:14", "text": "垂直の流れとかそういうもの。ありがとう。"}, {"type": "subtitle", "time": 7217.43, "timestamp": "02:00:17", "text": "そしてTwitchで来てくれた皆さん、ありがとう"}, {"type": "subtitle", "time": 7219.99, "timestamp": "02:00:19", "text": "Twitchに来てくれて本当にありがとう。"}, {"type": "subtitle", "time": 7221.91, "timestamp": "02:00:21", "text": "今日Twitchでフォローしていた人たち"}, {"type": "subtitle", "time": 7223.95, "timestamp": "02:00:23", "text": "は"}, {"type": "subtitle", "time": 7227.35, "timestamp": "02:00:27", "text": "いや、アニメを吸え。ありがとうございます"}, {"type": "subtitle", "time": 7229.229, "timestamp": "02:00:29", "text": "フォローして、ようこそ"}, {"type": "subtitle", "time": 7231.229, "timestamp": "02:00:31", "text": "コンステラと"}, {"type": "subtitle", "time": 7234.39, "timestamp": "02:00:34", "text": "ヤシュ69歳と"}, {"type": "subtitle", "time": 7236.87, "timestamp": "02:00:36", "text": "ヤシュが今日フォローしました。はい。はい。感謝"}, {"type": "subtitle", "time": 7239.75, "timestamp": "02:00:39", "text": "皆さん、またフォローしていただきありがとうございます。"}, {"type": "subtitle", "time": 7242.39, "timestamp": "02:00:42", "text": "そして、YouTubeから新しい人はいましたか？"}, {"type": "subtitle", "time": 7250.629, "timestamp": "02:00:50", "text": "いや、新しい人はいませんでした"}, {"type": "subtitle", "time": 7253.99, "timestamp": "02:00:53", "text": "YouTube。はい、わかりました。そして、スターボーイ"}, {"type": "subtitle", "time": 7256.31, "timestamp": "02:00:56", "text": "息子よ、心からの感謝をありがとう。"}, {"type": "subtitle", "time": 7259.589, "timestamp": "02:00:59", "text": "一緒に遊んでくれてありがとう。"}]
[{"type": "subtitle", "time": 18246.83, "timestamp": "05:04:06", "text": "車。何てことだ。"}, {"type": "subtitle", "time": 18249.07, "timestamp": "05:04:09", "text": "待って。"}, {"type": "subtitle", "time": 18253.75, "timestamp": "05:04:13", "text": "うん。やあ、ジョー。こんにちは。待って。元気ですか"}, {"type": "subtitle", "time": 18257.708, "timestamp": "05:04:17", "text": "私を抱きしめている？何てことだ。あなたは引きずっています"}, {"type": "subtitle", "time": 18262.03, "timestamp": "05:04:22", "text": "自分。何てことだ。何？何"}, {"type": "subtitle", "time": 18265.788, "timestamp": "05:04:25", "text": "このゲームは何ですか"}, {"type": "subtitle", "time": 18268.628, "timestamp": "05:04:28", "text": "について？マウスさえあれば"}, {"type": "subtitle", "time": 18270.948, "timestamp": "05:04:30", "text": "あなたは何でも手に取ることができます。"}, {"type": "chat", "time": 18273.473, "timestamp": "05:04:33", "author": "@OtakuArceus", "avatar": "https://yt4.ggpht.com/VSZC0x7e02-tCAnte525GcpFOF0YcSpYQWplJkdg1RARvkQA3ETFxFaiYVshpLrqHFKUMz4VmA=s64-c-k-c0x00ffffff-no-rj", "message": "u can use both handa seperately"}, {"type": "subtitle", "time": 18273.868, "timestamp": "05:04:33", "text": "右。そして、私は登ることさえできる"}, {"type": "subtitle", "time": 18277.628, "timestamp": "05:04:37", "text": "それとスペース"}, {"type": "subtitle", "time": 18279.75, "timestamp": "05:04:39", "text": "ジャンプ。でも、私たちは"}, {"type": "chat", "time": 18280.033, "timestamp": "05:04:40", "author": "@OtakuArceus", "avatar": "https://yt4.ggpht.com/VSZC0x7e02-tCAnte525GcpFOF0YcSpYQWplJkdg1RARvkQA3ETFxFaiYVshpLrqHFKUMz4VmA=s64-c-k-c0x00ffffff-no-rj", "message": "there are puzzles"}, {"type": "subtitle", "time": 18282.31, "timestamp": "05:04:42", "text": "その箱を壊す"}, {"type": "subtitle", "time": 18284.27, "timestamp": "05:04:44", "text": "[音楽]"}, {"type": "chat", "time": 18285.304, "timestamp": "05:04:45", "author": "@OtakuArceus", "avatar": "https://yt4.ggpht.com/VSZC0x7e02-tCAnte525GcpFOF0YcSpYQWplJkdg1RARvkQA3ETFxFaiYVshpLrqHFKUMz4VmA=s64-c-k-c0x00ffffff-no-rj", "message": "u do with friends"}, {"type": "subtitle", "time": 18286.75, "timestamp": "05:04:46", "text": "それ。おお、"}, {"type": "subtitle", "time": 18289.19, "timestamp": "05:04:49", "text": "待って。うん。基本的には、"}, {"type": "subtitle", "time": 18290.868, "timestamp": "05:04:50", "text": "パルクール。パズルを解いて"}, {"type": "subtitle", "time": 18292.59, "timestamp": "05:04:52", "text": "もの、"}, {"type": "subtitle", "time": 18295.66, "timestamp": "05:04:55", "text": "兄弟。おお。"}, {"type": "subtitle", "time": 18297.03, "timestamp": "05:04:57", "text": "[音楽]"}, {"type": "subtitle", "time": 18299.708, "timestamp": "05:04:59", "text": "私たちはその上に立って、それから"}]
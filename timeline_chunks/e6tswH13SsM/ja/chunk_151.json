[{"type": "subtitle", "time": 9060.79, "timestamp": "02:31:00", "text": "神。何てことだ。"}, {"type": "subtitle", "time": 9064.03, "timestamp": "02:31:04", "text": "だから、もしあなたが何かを聞いたら"}, {"type": "subtitle", "time": 9067.19, "timestamp": "02:31:07", "text": "パワーウォッシュシミュレーター"}, {"type": "subtitle", "time": 9069.99, "timestamp": "02:31:09", "text": "スプレー音のようなもの、あるいは何か"}, {"type": "subtitle", "time": 9074.87, "timestamp": "02:31:14", "text": "それはバイクです、それはまるで、それはまるで"}, {"type": "subtitle", "time": 9076.87, "timestamp": "02:31:16", "text": "えーと、人々は洗っている"}, {"type": "subtitle", "time": 9080.15, "timestamp": "02:31:20", "text": "外に自転車みたいなものがある。よし。今私たちは"}, {"type": "subtitle", "time": 9081.79, "timestamp": "02:31:21", "text": "に"}, {"type": "subtitle", "time": 9086.309, "timestamp": "02:31:26", "text": "ストーブが手に当たった。何てことだ。"}, {"type": "subtitle", "time": 9087.71, "timestamp": "02:31:27", "text": "の"}, {"type": "subtitle", "time": 9099.23, "timestamp": "02:31:39", "text": "痛みは大丈夫でしょう。大丈夫。今私たちは"}, {"type": "subtitle", "time": 9101.91, "timestamp": "02:31:41", "text": "待って。何か作らなければならないのでしょうか？あなた"}, {"type": "subtitle", "time": 9103.75, "timestamp": "02:31:43", "text": "何だと思う？作ろう 作ろう"}, {"type": "subtitle", "time": 9106.389, "timestamp": "02:31:46", "text": "卵。うん、卵料理を作るよ。すべき"}, {"type": "subtitle", "time": 9110.79, "timestamp": "02:31:50", "text": "私が口を挟む？何かを入れた方がいいかな？"}, {"type": "subtitle", "time": 9112.79, "timestamp": "02:31:52", "text": "私が料理をしていると言うか、"}, {"type": "subtitle", "time": 9115.51, "timestamp": "02:31:55", "text": "何か？わからない。私はそうすべきでしょうか"}]
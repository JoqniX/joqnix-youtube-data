[{"type": "subtitle", "time": 4260.07, "timestamp": "01:11:00", "text": "これら。完全に青。いや、違う。ゴールデン"}, {"type": "subtitle", "time": 4263.68, "timestamp": "01:11:03", "text": "1つ手に入れました。これはどのように"}, {"type": "subtitle", "time": 4270.35, "timestamp": "01:11:10", "text": "[音楽]"}, {"type": "subtitle", "time": 4275.79, "timestamp": "01:11:15", "text": "13."}, {"type": "subtitle", "time": 4278.189, "timestamp": "01:11:18", "text": "おお、"}, {"type": "subtitle", "time": 4280.87, "timestamp": "01:11:20", "text": "いや。フォローありがとうございます。こんにちは。"}, {"type": "subtitle", "time": 4284.79, "timestamp": "01:11:24", "text": "こんにちは。配信へようこ​​そ。"}, {"type": "subtitle", "time": 4288.83, "timestamp": "01:11:28", "text": "その下にいくつかの文字。"}, {"type": "subtitle", "time": 4292.149, "timestamp": "01:11:32", "text": "おお。ああ。わかった。わかった。わかった。わかった。"}, {"type": "subtitle", "time": 4294.55, "timestamp": "01:11:34", "text": "わかった。ああ、次回は"}, {"type": "subtitle", "time": 4304.709, "timestamp": "01:11:44", "text": "ああ、大きな立方体だ。そして私は100を手に入れるつもりです"}, {"type": "subtitle", "time": 4313.59, "timestamp": "01:11:53", "text": "これ。そして怠け者。いいえ。ええと、寝ています。いいえ。"}, {"type": "subtitle", "time": 4315.07, "timestamp": "01:11:55", "text": "睡眠"}, {"type": "subtitle", "time": 4318.43, "timestamp": "01:11:58", "text": "幸せそうな絵文字、私は"}]
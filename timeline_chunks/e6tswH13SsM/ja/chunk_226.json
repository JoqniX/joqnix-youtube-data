[{"type": "subtitle", "time": 13560.63, "timestamp": "03:46:00", "text": "ああ、なぜ私はログインする必要があるのか"}, {"type": "subtitle", "time": 13563.51, "timestamp": "03:46:03", "text": "わかった。うん、"}, {"type": "subtitle", "time": 13579.51, "timestamp": "03:46:19", "text": "あなた。これは何ですか？ IMEが無効になっていますエラー"}, {"type": "subtitle", "time": 13582.189, "timestamp": "03:46:22", "text": "得ています。"}, {"type": "subtitle", "time": 13585.11, "timestamp": "03:46:25", "text": "何？ああ、閉じることができません"}, {"type": "subtitle", "time": 13587.67, "timestamp": "03:46:27", "text": "応用。"}, {"type": "subtitle", "time": 13593.67, "timestamp": "03:46:33", "text": "[音楽]"}, {"type": "subtitle", "time": 13595.75, "timestamp": "03:46:35", "text": "そんなはずはない。"}, {"type": "subtitle", "time": 13603.189, "timestamp": "03:46:43", "text": "[音楽]"}, {"type": "subtitle", "time": 13606.229, "timestamp": "03:46:46", "text": "そして私はログインしました"}, {"type": "subtitle", "time": 13609.55, "timestamp": "03:46:49", "text": "何か見えますか？あなたは何を"}, {"type": "subtitle", "time": 13615.63, "timestamp": "03:46:55", "text": "承認する。"}, {"type": "subtitle", "time": 13618.229, "timestamp": "03:46:58", "text": "わかった。はい、ログインしましたが、表示されません"}, {"type": "subtitle", "time": 13619.83, "timestamp": "03:46:59", "text": "どのホームページでもいいよ、兄弟。それは私に見せているだけです"}]
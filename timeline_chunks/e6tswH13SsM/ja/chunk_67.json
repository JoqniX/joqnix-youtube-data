[{"type": "subtitle", "time": 4023.67, "timestamp": "01:07:03", "text": "1つ？他にどんなことを祈っていますか？えっと、これ"}, {"type": "subtitle", "time": 4025.069, "timestamp": "01:07:05", "text": "と呼ばれる"}, {"type": "subtitle", "time": 4029.63, "timestamp": "01:07:09", "text": "えっと、ノヴァ株を手に入れました。ああ、忘れてた"}, {"type": "subtitle", "time": 4033.19, "timestamp": "01:07:13", "text": "彼の名前はブループレスブルーボールです。"}, {"type": "subtitle", "time": 4042.829, "timestamp": "01:07:22", "text": "ボール。"}, {"type": "subtitle", "time": 4058.069, "timestamp": "01:07:38", "text": "おお。ああ、またそれだ。そうします"}]
[{"type": "subtitle", "time": 15721.99, "timestamp": "04:22:01", "text": "チャットで言ったように"}, {"type": "subtitle", "time": 15724.87, "timestamp": "04:22:04", "text": "うん、やりたいけど今は無理。"}, {"type": "subtitle", "time": 15727.03, "timestamp": "04:22:07", "text": "そう、まさにそれと同じこと"}, {"type": "subtitle", "time": 15729.91, "timestamp": "04:22:09", "text": "結局のところ、YouTuberとして"}, {"type": "subtitle", "time": 15731.99, "timestamp": "04:22:11", "text": "ここには競争相手がたくさんいて"}, {"type": "subtitle", "time": 15735.11, "timestamp": "04:22:15", "text": "そう、だから記憶に残らなければならない"}, {"type": "subtitle", "time": 15737.83, "timestamp": "04:22:17", "text": "どういうわけか、あなたがしたことに関して"}, {"type": "subtitle", "time": 15740.95, "timestamp": "04:22:20", "text": "このコミュニティでは、"}, {"type": "subtitle", "time": 15744.55, "timestamp": "04:22:24", "text": "コンテンツまたは成果に関するコメント"}, {"type": "subtitle", "time": 15747.59, "timestamp": "04:22:27", "text": "または地域社会への貢献"}, {"type": "subtitle", "time": 15750.95, "timestamp": "04:22:30", "text": "など、または何でも何でも"}, {"type": "subtitle", "time": 15753.99, "timestamp": "04:22:33", "text": "どんな形でも構わない、ですよね？人々は覚えておかなければならない"}, {"type": "subtitle", "time": 15755.99, "timestamp": "04:22:35", "text": "ああ、彼らがこのキャラクターを見たとき"}, {"type": "subtitle", "time": 15759.59, "timestamp": "04:22:39", "text": "モデル名、またはあなたの名前、または名前、えっと、彼らは"}, {"type": "subtitle", "time": 15762.149, "timestamp": "04:22:42", "text": "その記憶が思い出されるだろう"}, {"type": "subtitle", "time": 15764.55, "timestamp": "04:22:44", "text": "うん、この人は"}, {"type": "subtitle", "time": 15766.79, "timestamp": "04:22:46", "text": "イベントやこのこと、そしてあらゆるもの"}, {"type": "subtitle", "time": 15771.67, "timestamp": "04:22:51", "text": "それ。さらに、その人がどのような影響を与えるか"}, {"type": "subtitle", "time": 15775.51, "timestamp": "04:22:55", "text": "他の場合、例えば、知っている場合"}, {"type": "subtitle", "time": 15777.229, "timestamp": "04:22:57", "text": "この人、またはこの人を見ている"}]
[{"type": "subtitle", "time": 22214.39, "timestamp": "06:10:14", "text": "何てことだ。それはできません。私 私 私"}, {"type": "subtitle", "time": 22217.11, "timestamp": "06:10:17", "text": "それはできません。できません。何？"}, {"type": "subtitle", "time": 22224.23, "timestamp": "06:10:24", "text": "わかった。うん。あなたはただそこにいるべきです"}, {"type": "subtitle", "time": 22252.07, "timestamp": "06:10:52", "text": "そして一番上には何もありません。"}, {"type": "subtitle", "time": 22254.11, "timestamp": "06:10:54", "text": "え、何？"}, {"type": "subtitle", "time": 22259.51, "timestamp": "06:10:59", "text": "実際は、いいえ。いや、いや、いや、いや。実は、"}]
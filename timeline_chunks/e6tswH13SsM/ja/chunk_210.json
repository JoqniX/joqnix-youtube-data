[{"type": "subtitle", "time": 12602.03, "timestamp": "03:30:02", "text": "悪いし、私はしたくない"}, {"type": "subtitle", "time": 12610.11, "timestamp": "03:30:10", "text": "うん。わかった。私は、えーと"}, {"type": "subtitle", "time": 12624.87, "timestamp": "03:30:24", "text": "えっと、4分ほど時間をください。はい、アストラは"}, {"type": "subtitle", "time": 12634.07, "timestamp": "03:30:34", "text": "すべて。えっと、それとも私はそうする必要はないのでしょうか？"}, {"type": "subtitle", "time": 12637.91, "timestamp": "03:30:37", "text": "もし私がまだ開いていなかったら、もし私が開いていなかったら"}, {"type": "subtitle", "time": 12640.469, "timestamp": "03:30:40", "text": "えっと、これを開けたら、"}, {"type": "subtitle", "time": 12644.11, "timestamp": "03:30:44", "text": "文字通り、それをやった。もし私がそうしなかったら"}, {"type": "subtitle", "time": 12646.03, "timestamp": "03:30:46", "text": "開ける"}]
[{"type": "subtitle", "time": 15661.189, "timestamp": "04:21:01", "text": "舞台裏で何が起こっていたのか見てみよう。それで"}, {"type": "subtitle", "time": 15662.87, "timestamp": "04:21:02", "text": "今のところ、私はまだやっていないと思います"}, {"type": "subtitle", "time": 15664.87, "timestamp": "04:21:04", "text": "私の人生で何か"}, {"type": "subtitle", "time": 15666.71, "timestamp": "04:21:06", "text": "私は何もしていません"}, {"type": "subtitle", "time": 15670.309, "timestamp": "04:21:10", "text": "私にとっては大したことではない"}, {"type": "chat", "time": 15671.547, "timestamp": "04:21:11", "author": "@Minkk102", "avatar": "https://yt4.ggpht.com/TF8h5uIigJBanBg4LA_XZaY69S8H6wHtAUIDSGgMxHUqkEYRKq0z9m5NM8cqeDFnXLN0nN8i8g=s64-c-k-c0x00ffffff-no-rj", "message": "thats a good point astra"}, {"type": "subtitle", "time": 15673.03, "timestamp": "04:21:13", "text": "そんなに大したことじゃない"}, {"type": "subtitle", "time": 15675.91, "timestamp": "04:21:15", "text": "私はたくさんのことを正しく行いたいので"}, {"type": "subtitle", "time": 15677.67, "timestamp": "04:21:17", "text": "ポッドキャストを始める前に、"}, {"type": "subtitle", "time": 15681.03, "timestamp": "04:21:21", "text": "何か大きなことを成し遂げる、あなたのような"}, {"type": "subtitle", "time": 15683.83, "timestamp": "04:21:23", "text": "少なくとも私の名前はみんなに知られるべきだと思う"}, {"type": "subtitle", "time": 15685.429, "timestamp": "04:21:25", "text": "そう、そうすれば彼らは喜んでくれるだろう"}, {"type": "subtitle", "time": 15687.83, "timestamp": "04:21:27", "text": "私のポッドキャストを聴くには、そう、これ"}, {"type": "subtitle", "time": 15688.83, "timestamp": "04:21:28", "text": "その人は"}, {"type": "chat", "time": 15690.686, "timestamp": "04:21:30", "author": "@sarthaksharma2476", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kmJohYAdmpQzCNN96t58cLSK8spv6Y2ITutBFF9nvi9Z8=s64-c-k-c0x00ffffff-no-rj", "message": "you achieved shio bully post :D"}, {"type": "subtitle", "time": 15690.95, "timestamp": "04:21:30", "text": "おそらく話すと何かある"}, {"type": "subtitle", "time": 15693.75, "timestamp": "04:21:33", "text": "それには意味があるよね？ただ座っていられない"}, {"type": "subtitle", "time": 15695.87, "timestamp": "04:21:35", "text": "マイクの前に立って話す"}, {"type": "subtitle", "time": 15697.99, "timestamp": "04:21:37", "text": "多くの人がやっているくだらないこと"}, {"type": "subtitle", "time": 15703.91, "timestamp": "04:21:43", "text": "それは私個人の考えです。のように"}, {"type": "subtitle", "time": 15705.67, "timestamp": "04:21:45", "text": "私は、私は、私は、私は、私は、私は、私は、私は、"}, {"type": "subtitle", "time": 15707.59, "timestamp": "04:21:47", "text": "人々はそうすべきだと言っているが、"}, {"type": "subtitle", "time": 15709.75, "timestamp": "04:21:49", "text": "それは、"}, {"type": "subtitle", "time": 15712.389, "timestamp": "04:21:52", "text": "ポッドキャストの仕事は実際にうまくいっています。ええ、そうです"}, {"type": "subtitle", "time": 15715.269, "timestamp": "04:21:55", "text": "真実。私も同じ気持ちです。それは"}, {"type": "subtitle", "time": 15718.03, "timestamp": "04:21:58", "text": "なぜ私が「～のように」と言ったのか"}]
[{"type": "subtitle", "time": 17281.75, "timestamp": "04:48:01", "text": "それが私が"}, {"type": "subtitle", "time": 17284.31, "timestamp": "04:48:04", "text": "アバターと何か"}, {"type": "subtitle", "time": 17286.31, "timestamp": "04:48:06", "text": "[音楽]"}, {"type": "subtitle", "time": 17287.67, "timestamp": "04:48:07", "text": "何かのメモリー文字のようなものがあった"}, {"type": "subtitle", "time": 17290.948, "timestamp": "04:48:10", "text": "何か、私はそれを知らない、それは今もそこにある"}, {"type": "subtitle", "time": 17293.27, "timestamp": "04:48:13", "text": "メタバを作成するのと同じように"}, {"type": "subtitle", "time": 17296.628, "timestamp": "04:48:16", "text": "そうそう、基本的には同じだね"}, {"type": "subtitle", "time": 17304.55, "timestamp": "04:48:24", "text": "うん、本当だね"}, {"type": "subtitle", "time": 17306.15, "timestamp": "04:48:26", "text": "それが私のインスピレーションでした"}, {"type": "subtitle", "time": 17308.07, "timestamp": "04:48:28", "text": "YouTuberになること"}, {"type": "subtitle", "time": 17310.31, "timestamp": "04:48:30", "text": "VTuberというわけではないけれど、まあ、"}, {"type": "subtitle", "time": 17312.07, "timestamp": "04:48:32", "text": "ひらめきが浮かんだ。ああ、それは使えるな"}, {"type": "subtitle", "time": 17314.788, "timestamp": "04:48:34", "text": "プレイ中にそれを使うことができます"}, {"type": "subtitle", "time": 17326.47, "timestamp": "04:48:46", "text": "うん。では、お二人に質問です。どうやって"}, {"type": "subtitle", "time": 17330.15, "timestamp": "04:48:50", "text": "発見したのは何ですか？そして、最初の発見は何でしたか？"}]
[{"type": "subtitle", "time": 3847.15, "timestamp": "01:04:07", "text": "レベルアップしたので"}, {"type": "subtitle", "time": 3851.63, "timestamp": "01:04:11", "text": "多くの。どうやって？わかった。ガチャはどうやって見つけるの？"}, {"type": "subtitle", "time": 3864.51, "timestamp": "01:04:24", "text": "なぜ彼女が選ばれたのか？私は手に入れましたか"}, {"type": "subtitle", "time": 3869.99, "timestamp": "01:04:29", "text": "何か？ああ、肌ができた。おお。おお、いいね。"}, {"type": "subtitle", "time": 3871.87, "timestamp": "01:04:31", "text": "それからこれ"}, {"type": "subtitle", "time": 3876.309, "timestamp": "01:04:36", "text": "レディ。何かもらえましたか？"}, {"type": "subtitle", "time": 3893.71, "timestamp": "01:04:53", "text": "[音楽]"}, {"type": "subtitle", "time": 3895.71, "timestamp": "01:04:55", "text": "在庫。ああ、"}]
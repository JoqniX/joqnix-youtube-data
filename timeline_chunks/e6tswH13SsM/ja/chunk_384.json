[{"type": "subtitle", "time": 23062.548, "timestamp": "06:24:22", "text": "待って、君はどこにいるの？保存しようとしています"}, {"type": "subtitle", "time": 23065.19, "timestamp": "06:24:25", "text": "転倒しないように自分自身を守る。"}, {"type": "subtitle", "time": 23067.27, "timestamp": "06:24:27", "text": "そして私は倒れた。"}, {"type": "subtitle", "time": 23069.75, "timestamp": "06:24:29", "text": "いいえ。わかりました、保存しておきます。わかった。うん、"}, {"type": "subtitle", "time": 23078.15, "timestamp": "06:24:38", "text": "待ってるよ、兄弟。"}, {"type": "subtitle", "time": 23080.788, "timestamp": "06:24:40", "text": "うん。"}, {"type": "subtitle", "time": 23099.23, "timestamp": "06:24:59", "text": "壊れる可能性がある"}]
[{"type": "subtitle", "time": 22560.548, "timestamp": "06:16:00", "text": "どちら側からですか？"}, {"type": "subtitle", "time": 22562.31, "timestamp": "06:16:02", "text": "横から見たところ。とにかく地面に伏せろ。"}, {"type": "subtitle", "time": 22566.23, "timestamp": "06:16:06", "text": "階段を上って、それから、"}, {"type": "subtitle", "time": 22569.27, "timestamp": "06:16:09", "text": "岩につかまって横へ移動してください。何"}, {"type": "subtitle", "time": 22573.03, "timestamp": "06:16:13", "text": "階段？どの岩？我が神よ。"}, {"type": "subtitle", "time": 22574.83, "timestamp": "06:16:14", "text": "内部では"}, {"type": "subtitle", "time": 22584.548, "timestamp": "06:16:24", "text": "あ、待って。私もその中に入ってるよ。うん、"}, {"type": "subtitle", "time": 22587.19, "timestamp": "06:16:27", "text": "ええ、ええ。さあ、さあ、さあ、これらを手に入れよう"}, {"type": "subtitle", "time": 22589.99, "timestamp": "06:16:29", "text": "最高にロックだ。"}, {"type": "subtitle", "time": 22592.788, "timestamp": "06:16:32", "text": "でも、これらの岩石は一体何になるんだろう？私たちは"}, {"type": "subtitle", "time": 22594.47, "timestamp": "06:16:34", "text": "カートを出さなきゃ。そこには"}, {"type": "subtitle", "time": 22602.27, "timestamp": "06:16:42", "text": "カート。岩を取り除け。の"}, {"type": "subtitle", "time": 22604.31, "timestamp": "06:16:44", "text": "岩を引っ張ってもらう。私は引っ張ります"}, {"type": "subtitle", "time": 22614.11, "timestamp": "06:16:54", "text": "その石を取ってください。それから引っ張る"}]
[{"type": "subtitle", "time": 17360.11, "timestamp": "04:49:20", "text": "ヴービング？待って、私はあなたに聞いていない、"}, {"type": "subtitle", "time": 17363.03, "timestamp": "04:49:23", "text": "右？ H、何があなたを"}, {"type": "subtitle", "time": 17365.59, "timestamp": "04:49:25", "text": "YouTuber？"}, {"type": "subtitle", "time": 17373.99, "timestamp": "04:49:33", "text": "何てことだ。何てことだ。予想していなかった"}, {"type": "subtitle", "time": 17376.51, "timestamp": "04:49:36", "text": "その質問。わかった。"}, {"type": "subtitle", "time": 17380.948, "timestamp": "04:49:40", "text": "えっと、私がYouTuberになったきっかけは？そうだった"}, {"type": "subtitle", "time": 17384.23, "timestamp": "04:49:44", "text": "音楽とか音楽とか、そういうのが好きだった"}, {"type": "subtitle", "time": 17388.23, "timestamp": "04:49:48", "text": "制作とかそういう類のこと。わかった。そして私は"}, {"type": "subtitle", "time": 17391.51, "timestamp": "04:49:51", "text": "YouTubeで積極的に活動していた"}, {"type": "subtitle", "time": 17393.75, "timestamp": "04:49:53", "text": "他人の作品を見るなど、音楽"}, {"type": "subtitle", "time": 17395.83, "timestamp": "04:49:55", "text": "チュートリアルとか、その他諸々。たまたま"}, {"type": "subtitle", "time": 17399.83, "timestamp": "04:49:59", "text": "Hatutsikuやボーカロイド関連のものを見つけました"}]
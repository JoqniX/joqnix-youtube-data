[{"type": "subtitle", "time": 9480.309, "timestamp": "02:38:00", "text": "残り30分くらいかな"}, {"type": "subtitle", "time": 9482.7, "timestamp": "02:38:02", "text": "推測。 30ではなく30"}, {"type": "subtitle", "time": 9484.11, "timestamp": "02:38:04", "text": "[音楽]"}, {"type": "subtitle", "time": 9488.95, "timestamp": "02:38:08", "text": "えっと、実際にはあと45分です。いいえ"}, {"type": "subtitle", "time": 9492.03, "timestamp": "02:38:12", "text": "えーと、40分"}, {"type": "subtitle", "time": 9497.95, "timestamp": "02:38:17", "text": "左。そうですね、準備したかったのは"}, {"type": "subtitle", "time": 9502.03, "timestamp": "02:38:22", "text": "少し。私は準備したかった"}, {"type": "subtitle", "time": 9505.429, "timestamp": "02:38:25", "text": "少しだけ準備して、すべてを整える"}, {"type": "subtitle", "time": 9507.83, "timestamp": "02:38:27", "text": "ストリームを宣伝して"}, {"type": "subtitle", "time": 9520.27, "timestamp": "02:38:40", "text": "どうすればいいですか？少し飲まなくちゃ"}, {"type": "subtitle", "time": 9536.99, "timestamp": "02:38:56", "text": "おお"}]
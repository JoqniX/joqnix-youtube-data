[{"type": "subtitle", "time": 5481.03, "timestamp": "01:31:21", "text": "赤毛。誰に"}, {"type": "subtitle", "time": 5483.229, "timestamp": "01:31:23", "text": "ロックを解除します。しかし"}, {"type": "subtitle", "time": 5486.59, "timestamp": "01:31:26", "text": "うん、この２つを手に入れたよ"}, {"type": "subtitle", "time": 5489.3, "timestamp": "01:31:29", "text": "木箱。開けるべきでしょうか"}, {"type": "subtitle", "time": 5491.149, "timestamp": "01:31:31", "text": "[音楽]"}, {"type": "subtitle", "time": 5496.229, "timestamp": "01:31:36", "text": "これら？一つ開けます。私は何をもらったの？"}, {"type": "subtitle", "time": 5503.07, "timestamp": "01:31:43", "text": "[音楽]"}, {"type": "subtitle", "time": 5508.669, "timestamp": "01:31:48", "text": "それ？ああ、あなたはああの贈り物をアンロックします。"}]
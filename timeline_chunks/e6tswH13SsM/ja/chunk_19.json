[{"type": "subtitle", "time": 1141.15, "timestamp": "00:19:01", "text": "失った。おお"}, {"type": "subtitle", "time": 1145.11, "timestamp": "00:19:05", "text": "男の子。誰が？ああ、それはあなたの友達ですか"}, {"type": "subtitle", "time": 1180.549, "timestamp": "00:19:40", "text": "ああ、それは盛大なパーティーですね。それは"}, {"type": "subtitle", "time": 1184.15, "timestamp": "00:19:44", "text": "全員揃ったパーティー。私はこうあるべきなの？"}, {"type": "subtitle", "time": 1185.95, "timestamp": "00:19:45", "text": "であるはず"}, {"type": "subtitle", "time": 1194.59, "timestamp": "00:19:54", "text": "[音楽]"}, {"type": "subtitle", "time": 1199.13, "timestamp": "00:19:59", "text": "兄弟。私は一人です。どこが大丈夫ですか。"}]
[{"type": "subtitle", "time": 20040.19, "timestamp": "05:34:00", "text": "木箱。箱。ええ、私が"}, {"type": "subtitle", "time": 20047.75, "timestamp": "05:34:07", "text": "片手で持っています。私は"}, {"type": "subtitle", "time": 20053.43, "timestamp": "05:34:13", "text": "片手で巨大な木を支えている。"}, {"type": "subtitle", "time": 20056.868, "timestamp": "05:34:16", "text": "待って、手放してみて。手放してみて。"}, {"type": "subtitle", "time": 20076.83, "timestamp": "05:34:36", "text": "わかったと思う。わかったと思う。わかったと思う。私たちは"}, {"type": "subtitle", "time": 20080.03, "timestamp": "05:34:40", "text": "それ。しないで、しないで、しないで"}, {"type": "subtitle", "time": 20083.59, "timestamp": "05:34:43", "text": "気をつけてください。箱を落とさないでください。"}, {"type": "subtitle", "time": 20085.15, "timestamp": "05:34:45", "text": "試さないで"}, {"type": "subtitle", "time": 20088.788, "timestamp": "05:34:48", "text": "いいえ、横から押してください。"}, {"type": "subtitle", "time": 20091.59, "timestamp": "05:34:51", "text": "例えば、その上に立たせてよ。そうなる"}]
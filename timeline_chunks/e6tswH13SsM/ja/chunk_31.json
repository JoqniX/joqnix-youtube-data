[{"type": "subtitle", "time": 1862.99, "timestamp": "00:31:02", "text": "[音楽]"}, {"type": "subtitle", "time": 1869.83, "timestamp": "00:31:09", "text": "神。待って、ちょっと待って。あれは待って、違う"}, {"type": "subtitle", "time": 1873.149, "timestamp": "00:31:13", "text": "イチロウのえーっと、あれは"}, {"type": "subtitle", "time": 1876.47, "timestamp": "00:31:16", "text": "一郎の日本名。待って、ちょっと待って。"}, {"type": "subtitle", "time": 1886.63, "timestamp": "00:31:26", "text": "待って、それはどこにあるの？これです。いや、待って。"}, {"type": "subtitle", "time": 1888.99, "timestamp": "00:31:28", "text": "どこ"}, {"type": "subtitle", "time": 1892.389, "timestamp": "00:31:32", "text": "彼？それはひどく似ている。それ"}, {"type": "subtitle", "time": 1894.51, "timestamp": "00:31:34", "text": "マイナスのやつ"}, {"type": "subtitle", "time": 1898.389, "timestamp": "00:31:38", "text": "そして３つ目。おお。ああ、そうだね。ああ、なんてことだ、"}, {"type": "subtitle", "time": 1908.05, "timestamp": "00:31:48", "text": "わかった。あ、待って。翻訳が必要です。えっと"}, {"type": "subtitle", "time": 1915.19, "timestamp": "00:31:55", "text": "えーと。普段誰と話すか"}, {"type": "subtitle", "time": 1919.31, "timestamp": "00:31:59", "text": "周りに誰もいないの？えっと、私は独り言を言うんです"}]
[{"type": "subtitle", "time": 3064.829, "timestamp": "00:51:04", "text": "1つ。"}, {"type": "subtitle", "time": 3070.95, "timestamp": "00:51:10", "text": "あ、待って。私は何をしますか？これか、それともあれか？"}, {"type": "subtitle", "time": 3084.51, "timestamp": "00:51:24", "text": "ミン？誰"}, {"type": "subtitle", "time": 3093.349, "timestamp": "00:51:33", "text": "ミン？ええと、これは正しいと思います。おお。"}, {"type": "subtitle", "time": 3095.99, "timestamp": "00:51:35", "text": "わかった。わかった。カミング。わかった。わかった。私は引っ張ります"}, {"type": "subtitle", "time": 3098.349, "timestamp": "00:51:38", "text": "私"}, {"type": "subtitle", "time": 3101.36, "timestamp": "00:51:41", "text": "試す。えっと、"}, {"type": "subtitle", "time": 3102.99, "timestamp": "00:51:42", "text": "[音楽]"}, {"type": "subtitle", "time": 3106.67, "timestamp": "00:51:46", "text": "これ？私は待つ。"}, {"type": "subtitle", "time": 3109.79, "timestamp": "00:51:49", "text": "はぁ？私は何をすべきですか？"}]
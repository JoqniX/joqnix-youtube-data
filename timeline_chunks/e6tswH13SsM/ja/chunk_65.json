[{"type": "subtitle", "time": 3901.15, "timestamp": "01:05:01", "text": "神。この男は私が捕まえた。ああ、SCを手に入れたよ。"}, {"type": "subtitle", "time": 3903.47, "timestamp": "01:05:03", "text": "何？おお。"}, {"type": "subtitle", "time": 3908.829, "timestamp": "01:05:08", "text": "よし、じゃあこの女の子はああ、"}, {"type": "subtitle", "time": 3914.19, "timestamp": "01:05:14", "text": "ニース。そしてこの人は"}, {"type": "subtitle", "time": 3919.43, "timestamp": "01:05:19", "text": "肌。いいえ、皮膚はありません。ああ、これだ。おお、"}, {"type": "subtitle", "time": 3922.15, "timestamp": "01:05:22", "text": "わかった。"}, {"type": "subtitle", "time": 3929.51, "timestamp": "01:05:29", "text": "一つの声"}, {"type": "subtitle", "time": 3930.78, "timestamp": "01:05:30", "text": "それはただ"}, {"type": "subtitle", "time": 3932.99, "timestamp": "01:05:32", "text": "[音楽]"}, {"type": "subtitle", "time": 3946.109, "timestamp": "01:05:46", "text": "それもそうだ。ディオ、覚悟しろ。その"}, {"type": "subtitle", "time": 3948.51, "timestamp": "01:05:48", "text": "わかった。ほかに何か？これ"}, {"type": "subtitle", "time": 3951.71, "timestamp": "01:05:51", "text": "女の子。ああ、これ"}, {"type": "subtitle", "time": 3955.19, "timestamp": "01:05:55", "text": "できる。ああ、歴史。えっと、"}, {"type": "subtitle", "time": 3956.589, "timestamp": "01:05:56", "text": "歴史。"}, {"type": "subtitle", "time": 3958.67, "timestamp": "01:05:58", "text": "えっと、これ"}]
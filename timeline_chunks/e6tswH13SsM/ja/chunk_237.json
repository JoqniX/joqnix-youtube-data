[{"type": "subtitle", "time": 14231.349, "timestamp": "03:57:11", "text": "ああ、なぜそれが許されるのですか？直しました。こんにちは、私たちは"}, {"type": "subtitle", "time": 14233.269, "timestamp": "03:57:13", "text": "戻ってきた。"}, {"type": "subtitle", "time": 14235.83, "timestamp": "03:57:15", "text": "みんな、ただいま！"}, {"type": "subtitle", "time": 14246.429, "timestamp": "03:57:26", "text": "戻る。では、ここは"}, {"type": "subtitle", "time": 14250.71, "timestamp": "03:57:30", "text": "基本的な設定は？もう一人、登場人物がいます。"}, {"type": "subtitle", "time": 14252.63, "timestamp": "03:57:32", "text": "わかった。待って、待って。私は食事をしています。えっと、それであなたは"}, {"type": "subtitle", "time": 14254.189, "timestamp": "03:57:34", "text": "発見するために行かなければならない"}, {"type": "subtitle", "time": 14260.389, "timestamp": "03:57:40", "text": "あれ。それから、えーっと足し合わせる必要がある"}, {"type": "subtitle", "time": 14262.55, "timestamp": "03:57:42", "text": "発見する。 Steam Steamを検索する必要があります"}, {"type": "subtitle", "time": 14264.87, "timestamp": "03:57:44", "text": "協力して発見し、"}, {"type": "subtitle", "time": 14268.389, "timestamp": "03:57:48", "text": "購読してください。だから5、10くらいください"}, {"type": "subtitle", "time": 14271.429, "timestamp": "03:57:51", "text": "富士を使うまであと数分。うん。うん。"}, {"type": "subtitle", "time": 14273.59, "timestamp": "03:57:53", "text": "今、食事をしています。だからとても"}, {"type": "subtitle", "time": 14275.51, "timestamp": "03:57:55", "text": "バーでは手が触れるので奇妙です"}, {"type": "subtitle", "time": 14278.15, "timestamp": "03:57:58", "text": "トラッキング。わかった。"}, {"type": "subtitle", "time": 14279.309, "timestamp": "03:57:59", "text": "うん。"}]
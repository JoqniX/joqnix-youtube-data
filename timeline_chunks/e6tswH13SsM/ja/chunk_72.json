[{"type": "subtitle", "time": 4322.82, "timestamp": "01:12:02", "text": "推測。待って、このスキンは入手できるよ。"}, {"type": "subtitle", "time": 4324.75, "timestamp": "01:12:04", "text": "[音楽]"}, {"type": "subtitle", "time": 4335.87, "timestamp": "01:12:15", "text": "ゲーム。だから、プレイモードに入らなければならない。はい、わかりました"}, {"type": "subtitle", "time": 4359.35, "timestamp": "01:12:39", "text": "[音楽]"}, {"type": "subtitle", "time": 4363.149, "timestamp": "01:12:43", "text": "私は、自分がプレイしているだけであることに気づいた"}, {"type": "subtitle", "time": 4368.13, "timestamp": "01:12:48", "text": "彼女。なぜだめですか？天上の淑女。"}, {"type": "subtitle", "time": 4379.11, "timestamp": "01:12:59", "text": "[音楽]"}]
[{"type": "subtitle", "time": 19502.83, "timestamp": "05:25:02", "text": "待って、待って、待って。ちょっとさせてください"}, {"type": "subtitle", "time": 19506.708, "timestamp": "05:25:06", "text": "これ。わかったよ、兄弟。ジャンプ。ジャンプ。しないで"}, {"type": "subtitle", "time": 19509.91, "timestamp": "05:25:09", "text": "シュート。今すぐ飛び降りろ。ジャンプ。ただ飛び降りればいい。"}, {"type": "chat", "time": 19519.156, "timestamp": "05:25:19", "author": "@Minkk102", "avatar": "https://yt4.ggpht.com/TF8h5uIigJBanBg4LA_XZaY69S8H6wHtAUIDSGgMxHUqkEYRKq0z9m5NM8cqeDFnXLN0nN8i8g=s64-c-k-c0x00ffffff-no-rj", "message": "you need that battery thingy"}, {"type": "subtitle", "time": 19520.628, "timestamp": "05:25:20", "text": "B. ああ、わかりました。ああ、保存されたからだよ。わかった。"}, {"type": "subtitle", "time": 19523.67, "timestamp": "05:25:23", "text": "うん。見る、"}, {"type": "subtitle", "time": 19528.47, "timestamp": "05:25:28", "text": "友情について。ニース。見て。火。いやいや"}, {"type": "subtitle", "time": 19531.51, "timestamp": "05:25:31", "text": "いやいや。"}, {"type": "chat", "time": 19532.473, "timestamp": "05:25:32", "author": "@Minkk102", "avatar": "https://yt4.ggpht.com/TF8h5uIigJBanBg4LA_XZaY69S8H6wHtAUIDSGgMxHUqkEYRKq0z9m5NM8cqeDFnXLN0nN8i8g=s64-c-k-c0x00ffffff-no-rj", "message": "checkpoint"}, {"type": "subtitle", "time": 19533.91, "timestamp": "05:25:33", "text": "わかった。そのバッテリーが必要です。"}, {"type": "subtitle", "time": 19535.75, "timestamp": "05:25:35", "text": "何？"}, {"type": "subtitle", "time": 19537.23, "timestamp": "05:25:37", "text": "おお、"}, {"type": "subtitle", "time": 19539.948, "timestamp": "05:25:39", "text": "金床。私たちは"}, {"type": "subtitle", "time": 19547.91, "timestamp": "05:25:47", "text": "おお。なんてこった。バッテリーを取り出さなければならない"}, {"type": "subtitle", "time": 19550.47, "timestamp": "05:25:50", "text": "向こう側から何か。何てことだ。は"}, {"type": "subtitle", "time": 19552.55, "timestamp": "05:25:52", "text": "冗談でしょ？いいえ。いいえ。いいえ。"}, {"type": "subtitle", "time": 19555.11, "timestamp": "05:25:55", "text": "いいえ。これはバッテリーではありません。"}, {"type": "subtitle", "time": 19557.51, "timestamp": "05:25:57", "text": "それはそういう健康上の問題です。私たちは"}, {"type": "subtitle", "time": 19559.99, "timestamp": "05:25:59", "text": "それは必要ない。燃やす必要がある"}]
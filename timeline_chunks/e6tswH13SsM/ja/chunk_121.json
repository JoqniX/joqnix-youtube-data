[{"type": "subtitle", "time": 7262.149, "timestamp": "02:01:02", "text": "私も息子をそう思っています。プレイしていただきありがとうございました"}, {"type": "subtitle", "time": 7263.87, "timestamp": "02:01:03", "text": "私と一緒に"}, {"type": "subtitle", "time": 7267.229, "timestamp": "02:01:07", "text": "それでは、私のチャンネルを見つけてくださりありがとうございます。"}, {"type": "subtitle", "time": 7270.39, "timestamp": "02:01:10", "text": "そして、ビリーの番組で私を見ているのもね。"}, {"type": "subtitle", "time": 7271.31, "timestamp": "02:01:11", "text": "感謝"}, {"type": "subtitle", "time": 7275.03, "timestamp": "02:01:15", "text": "あなた。以上、全員です。はい、ありがとうございます"}, {"type": "subtitle", "time": 7278.43, "timestamp": "02:01:18", "text": "今日はありがとう、そして良い一日を。"}, {"type": "subtitle", "time": 7281.75, "timestamp": "02:01:21", "text": "夜。バイバイ。"}, {"type": "subtitle", "time": 7293.07, "timestamp": "02:01:33", "text": "[音楽]"}, {"type": "subtitle", "time": 7295.669, "timestamp": "02:01:35", "text": "明日。結末を忘れてしまった。うん、"}]
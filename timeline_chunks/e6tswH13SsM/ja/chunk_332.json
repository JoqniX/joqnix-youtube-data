[{"type": "subtitle", "time": 19920.28, "timestamp": "05:32:00", "text": "待って、 待って。私たちはただ"}, {"type": "subtitle", "time": 19922.68, "timestamp": "05:32:02", "text": "待って。私たちはただ タイマー。"}, {"type": "subtitle", "time": 19925.558, "timestamp": "05:32:05", "text": "タイマー。 おい、"}, {"type": "subtitle", "time": 19927.878, "timestamp": "05:32:07", "text": "おい、 待って。助けて。"}, {"type": "subtitle", "time": 19930.958, "timestamp": "05:32:10", "text": "待って。助けて。 おお"}, {"type": "subtitle", "time": 19938.59, "timestamp": "05:32:18", "text": "いいえ。おお。あなたは私を"}, {"type": "subtitle", "time": 19941.83, "timestamp": "05:32:21", "text": "それ。ジョックが見える。"}, {"type": "subtitle", "time": 19952.47, "timestamp": "05:32:32", "text": "いいえ。何てことだ。これはテシの"}, {"type": "subtitle", "time": 19977.39, "timestamp": "05:32:57", "text": "する？あなたはただ"}]
[{"type": "subtitle", "time": 17881.67, "timestamp": "04:58:01", "text": "あれこれのやり方、そしてそれが1つ目"}, {"type": "subtitle", "time": 17884.15, "timestamp": "04:58:04", "text": "2つ目のこと：サムネイルの作り方"}, {"type": "subtitle", "time": 17886.39, "timestamp": "04:58:06", "text": "など。コンテンツを適用するのと同じことです。"}, {"type": "subtitle", "time": 17888.788, "timestamp": "04:58:08", "text": "創造も同じことがあなたにも当てはまる"}, {"type": "subtitle", "time": 17891.35, "timestamp": "04:58:11", "text": "vtubingのためにそれを行うなら、vtubingwiseも行う"}, {"type": "subtitle", "time": 17893.99, "timestamp": "04:58:13", "text": "良いものを調べなければならない"}, {"type": "subtitle", "time": 17896.948, "timestamp": "04:58:16", "text": "モデルのような、モデルのような、衣装ではないモデルのような。"}, {"type": "subtitle", "time": 17900.55, "timestamp": "04:58:20", "text": "または、ストリームで使用するアセットのようなもの"}, {"type": "subtitle", "time": 17903.83, "timestamp": "04:58:23", "text": "すべての配信をもっと楽しくする。追加"}, {"type": "subtitle", "time": 17905.67, "timestamp": "04:58:25", "text": "ストリーム用の新しい新しいアイテムと"}, {"type": "subtitle", "time": 17907.03, "timestamp": "04:58:27", "text": "すべて。"}, {"type": "subtitle", "time": 17908.948, "timestamp": "04:58:28", "text": "コンテンツ制作など全てを行う。それはとても"}, {"type": "subtitle", "time": 17923.59, "timestamp": "04:58:43", "text": "だから、私たちも何もプレイしていません。私たちは"}, {"type": "subtitle", "time": 17925.59, "timestamp": "04:58:45", "text": "何かゲームをしようか。私たちは"}, {"type": "subtitle", "time": 17927.59, "timestamp": "04:58:47", "text": "話している。退屈させていないといいのですが"}, {"type": "subtitle", "time": 17929.99, "timestamp": "04:58:49", "text": "君もやりすぎだよ。いいえ。ええ、そうでした。"}]
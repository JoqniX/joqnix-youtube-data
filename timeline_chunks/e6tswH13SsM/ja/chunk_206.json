[{"type": "subtitle", "time": 12362.87, "timestamp": "03:26:02", "text": "実際にそのお金を使ってそのゲームを買う"}, {"type": "subtitle", "time": 12364.87, "timestamp": "03:26:04", "text": "そして、友達とゴルフを楽しむのもいいでしょう。"}, {"type": "subtitle", "time": 12368.07, "timestamp": "03:26:08", "text": "それも私がプレイしたかったゲームの一つです。"}, {"type": "subtitle", "time": 12370.95, "timestamp": "03:26:10", "text": "そうですね、３つを優先したいです"}, {"type": "subtitle", "time": 12372.59, "timestamp": "03:26:12", "text": "それから私は"}, {"type": "subtitle", "time": 12377.51, "timestamp": "03:26:17", "text": "兄弟へ、私はたくさんの人にDMを送りましたが、"}, {"type": "subtitle", "time": 12380.71, "timestamp": "03:26:20", "text": "保留状態にあるものが非常に多く、"}, {"type": "subtitle", "time": 12383.19, "timestamp": "03:26:23", "text": "まだ多くの人が反応していない"}, {"type": "subtitle", "time": 12385.07, "timestamp": "03:26:25", "text": "人々はイヤリングを欲しがっていた"}, {"type": "subtitle", "time": 12389.03, "timestamp": "03:26:29", "text": "スロット blah blah blah blah blah bl 私は"}, {"type": "subtitle", "time": 12393.469, "timestamp": "03:26:33", "text": "死んだ私はわくわくんぱすですよね"}]
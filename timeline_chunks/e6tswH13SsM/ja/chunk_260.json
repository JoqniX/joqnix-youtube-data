[{"type": "chat", "time": 15600.424, "timestamp": "04:20:00", "author": "@sarthaksharma2476", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kmJohYAdmpQzCNN96t58cLSK8spv6Y2ITutBFF9nvi9Z8=s64-c-k-c0x00ffffff-no-rj", "message": "astra cast"}, {"type": "subtitle", "time": 15603.03, "timestamp": "04:20:03", "text": "計画はあったんだけど、あの"}, {"type": "subtitle", "time": 15605.11, "timestamp": "04:20:05", "text": "問題は私が信じていること、私が"}, {"type": "subtitle", "time": 15607.75, "timestamp": "04:20:07", "text": "個人的には"}, {"type": "subtitle", "time": 15611.99, "timestamp": "04:20:11", "text": "えーと、私がポッドキャストをホストするには、"}, {"type": "subtitle", "time": 15613.67, "timestamp": "04:20:13", "text": "私が持っているレベルであるべきです"}, {"type": "subtitle", "time": 15616.309, "timestamp": "04:20:16", "text": "多くのことを成し遂げた私は少なくとも"}, {"type": "subtitle", "time": 15618.63, "timestamp": "04:20:18", "text": "人生で何かをした"}, {"type": "subtitle", "time": 15621.429, "timestamp": "04:20:21", "text": "アストラでは、この"}, {"type": "subtitle", "time": 15623.91, "timestamp": "04:20:23", "text": "コミュニティ全体、そして"}, {"type": "subtitle", "time": 15626.389, "timestamp": "04:20:26", "text": "一般的にコンテンツ作成ジャンル"}, {"type": "subtitle", "time": 15630.469, "timestamp": "04:20:30", "text": "はい、だから私は今、あるいはもしかしたら"}, {"type": "subtitle", "time": 15632.63, "timestamp": "04:20:32", "text": "数年後にはそうは思わない"}, {"type": "subtitle", "time": 15635.75, "timestamp": "04:20:35", "text": "私はポッドキャストをホストできるようになるでしょう"}, {"type": "subtitle", "time": 15637.83, "timestamp": "04:20:37", "text": "多くのことを達成できないだろう"}, {"type": "subtitle", "time": 15641.269, "timestamp": "04:20:41", "text": "まるで私が人々がいる場所にいるべきだと言っているかのようだ"}, {"type": "subtitle", "time": 15644.149, "timestamp": "04:20:44", "text": "実際に私を見て、彼らは"}, {"type": "subtitle", "time": 15646.07, "timestamp": "04:20:46", "text": "うん、終わったよ、この人は"}, {"type": "subtitle", "time": 15648.63, "timestamp": "04:20:48", "text": "彼が何かを試してみたところ、"}, {"type": "subtitle", "time": 15651.03, "timestamp": "04:20:51", "text": "彼らはそれを達成したから"}, {"type": "subtitle", "time": 15653.91, "timestamp": "04:20:53", "text": "私のポッドキャストを聴くことに興味がある"}, {"type": "subtitle", "time": 15656.309, "timestamp": "04:20:56", "text": "彼らは「よし、やめよう」と言うだろう"}, {"type": "subtitle", "time": 15658.71, "timestamp": "04:20:58", "text": "この人が何をしたのか解読しよう"}]
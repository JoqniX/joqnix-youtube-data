[{"type": "subtitle", "time": 7140.79, "timestamp": "01:59:00", "text": "いいえ、ウィローは実際にそれを飲みます。したい"}, {"type": "subtitle", "time": 7143.47, "timestamp": "01:59:03", "text": "ウィローを作る"}, {"type": "subtitle", "time": 7146.31, "timestamp": "01:59:06", "text": "えーと、一番下のカエルになるか、"}, {"type": "subtitle", "time": 7148.39, "timestamp": "01:59:08", "text": "何か。もし"}, {"type": "subtitle", "time": 7149.47, "timestamp": "01:59:09", "text": "誰か"}, {"type": "subtitle", "time": 7152.31, "timestamp": "01:59:12", "text": "実際には最下層のカエルになる"}, {"type": "subtitle", "time": 7154.87, "timestamp": "01:59:14", "text": "複数のゲーム。その人は"}, {"type": "subtitle", "time": 7157.39, "timestamp": "01:59:17", "text": "これを飲み続ける？ああ、"}, {"type": "subtitle", "time": 7160.149, "timestamp": "01:59:20", "text": "神。でも、何が起こるかわからない。わからない。"}, {"type": "subtitle", "time": 7164.43, "timestamp": "01:59:24", "text": "でも、明日は明日"}, {"type": "subtitle", "time": 7168.43, "timestamp": "01:59:28", "text": "えっと、ストリーミング配信します"}, {"type": "subtitle", "time": 7170.91, "timestamp": "01:59:30", "text": "午前8時"}, {"type": "subtitle", "time": 7174.229, "timestamp": "01:59:34", "text": "午後ええと、このストリームは、ええと、利用可能になります"}, {"type": "subtitle", "time": 7177.589, "timestamp": "01:59:37", "text": "すべてのプラットフォームで、"}, {"type": "subtitle", "time": 7179.75, "timestamp": "01:59:39", "text": "ストリーム。じゃあ、またね"}, {"type": "subtitle", "time": 7183.03, "timestamp": "01:59:43", "text": "明日。わかった。こんにちは。そしてもし私が自由だったら"}, {"type": "subtitle", "time": 7186.27, "timestamp": "01:59:46", "text": "無料、ストリームを信じます"}, {"type": "subtitle", "time": 7188.709, "timestamp": "01:59:48", "text": "Dualingo。私はこれをずっと言い続けてきました"}, {"type": "subtitle", "time": 7192.07, "timestamp": "01:59:52", "text": "その間。ああ、Dualingoをやらなきゃ"}, {"type": "subtitle", "time": 7193.47, "timestamp": "01:59:53", "text": "そうすれば私は学ぶことができる"}, {"type": "subtitle", "time": 7197.03, "timestamp": "01:59:57", "text": "中国語。そう、ビリー・ビリー"}, {"type": "subtitle", "time": 7199.35, "timestamp": "01:59:59", "text": "独占配信は明日か"}]
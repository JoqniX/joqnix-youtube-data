[{"type": "subtitle", "time": 9423.83, "timestamp": "02:37:03", "text": "何か。えっと、本当にごめんなさい。"}, {"type": "subtitle", "time": 9427.15, "timestamp": "02:37:07", "text": "ただ、私は起きていたんです"}, {"type": "subtitle", "time": 9430.63, "timestamp": "02:37:10", "text": "午前8時まで。"}, {"type": "subtitle", "time": 9433.67, "timestamp": "02:37:13", "text": "私は寝るつもりはなかったのですが、"}, {"type": "subtitle", "time": 9436.71, "timestamp": "02:37:16", "text": "夜ぐっすり眠って"}, {"type": "subtitle", "time": 9438.51, "timestamp": "02:37:18", "text": "ゆっくり休んでください。"}, {"type": "subtitle", "time": 9442.469, "timestamp": "02:37:22", "text": "でも私はうっかり昼寝をしてしまって"}, {"type": "subtitle", "time": 9444.79, "timestamp": "02:37:24", "text": "若干。私はベッドの中で目を閉じた"}, {"type": "subtitle", "time": 9449.15, "timestamp": "02:37:29", "text": "少しの間寝て"}, {"type": "subtitle", "time": 9453.27, "timestamp": "02:37:33", "text": "オフ。そういうことが起きました。私は本当にそう思っていませんでした"}, {"type": "subtitle", "time": 9455.07, "timestamp": "02:37:35", "text": "やりたいこと"}, {"type": "subtitle", "time": 9467.389, "timestamp": "02:37:47", "text": "今日は"}, {"type": "subtitle", "time": 9471.51, "timestamp": "02:37:51", "text": "えっと、今日はAstraとのコラボ企画があります。それ"}, {"type": "subtitle", "time": 9475.75, "timestamp": "02:37:55", "text": "午後4時になります。 ISTには時間があります"}]
[{"type": "subtitle", "time": 24360.19, "timestamp": "06:46:00", "text": "今。"}, {"type": "subtitle", "time": 24374.07, "timestamp": "06:46:14", "text": "よし、みんな、もう行かなきゃ。私は持っています"}, {"type": "subtitle", "time": 24377.51, "timestamp": "06:46:17", "text": "仕事もあるけど、ジョーは配信する予定だよ。"}, {"type": "subtitle", "time": 24379.51, "timestamp": "06:46:19", "text": "皆さん、来てくれてありがとう。"}, {"type": "subtitle", "time": 24381.19, "timestamp": "06:46:21", "text": "あなた。"}, {"type": "subtitle", "time": 24383.31, "timestamp": "06:46:23", "text": "招待していただき本当にありがとうございます"}, {"type": "subtitle", "time": 24386.19, "timestamp": "06:46:26", "text": "これ。参加できてよかった"}, {"type": "subtitle", "time": 24388.468, "timestamp": "06:46:28", "text": "チョアトン。うん、みんな、お願い、お願い"}, {"type": "subtitle", "time": 24392.868, "timestamp": "06:46:32", "text": "彼を応援しよう。彼が目標を達成できるよう、どうか助けてあげてください。"}, {"type": "subtitle", "time": 24395.75, "timestamp": "06:46:35", "text": "でも、私の後に来てくれてありがとう"}, {"type": "subtitle", "time": 24397.43, "timestamp": "06:46:37", "text": "楽しかった。"}, {"type": "subtitle", "time": 24400.23, "timestamp": "06:46:40", "text": "ええ、私も楽しかったです。さようなら。"}, {"type": "subtitle", "time": 24402.07, "timestamp": "06:46:42", "text": "じゃあね、みんな。また後でね。"}]
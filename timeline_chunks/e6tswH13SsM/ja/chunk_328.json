[{"type": "subtitle", "time": 19685.65, "timestamp": "05:28:05", "text": "ヘルプ。私に対してはそうしないといけないよ。"}, {"type": "subtitle", "time": 19692.39, "timestamp": "05:28:12", "text": "もうすぐだ。"}, {"type": "subtitle", "time": 19705.27, "timestamp": "05:28:25", "text": "いいえ、それくらいなら押せますよ。待って、"}, {"type": "subtitle", "time": 19713.75, "timestamp": "05:28:33", "text": "強そうに見える。よし、私たちはただ"}, {"type": "subtitle", "time": 19728.948, "timestamp": "05:28:48", "text": "[音楽]"}, {"type": "subtitle", "time": 19730.35, "timestamp": "05:28:50", "text": "君に返してあげるよ"}]
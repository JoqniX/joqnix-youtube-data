[{"type": "subtitle", "time": 21300.868, "timestamp": "05:55:00", "text": "ああ、これは、よし、私たちは"}, {"type": "subtitle", "time": 21303.59, "timestamp": "05:55:03", "text": "この城の上の階へ上がってください。"}, {"type": "subtitle", "time": 21305.43, "timestamp": "05:55:05", "text": "ええ、まさにそれをお伝えしようとしているんです。"}, {"type": "subtitle", "time": 21318.51, "timestamp": "05:55:18", "text": "アストラ。私が開けたの？ええ、私は"}, {"type": "subtitle", "time": 21321.91, "timestamp": "05:55:21", "text": "した。今行ってる。"}, {"type": "subtitle", "time": 21323.67, "timestamp": "05:55:23", "text": "何てことだ。上に行ってやらなければならない"}]
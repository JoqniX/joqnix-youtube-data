[{"type": "subtitle", "time": 23184.11, "timestamp": "06:26:24", "text": "はい。"}, {"type": "subtitle", "time": 23193.35, "timestamp": "06:26:33", "text": "チョークのような"}, {"type": "subtitle", "time": 23201.59, "timestamp": "06:26:41", "text": "シェール。私はエベレスト山の頂上にいます。おお、"}, {"type": "subtitle", "time": 23203.39, "timestamp": "06:26:43", "text": "待って。"}, {"type": "subtitle", "time": 23205.91, "timestamp": "06:26:45", "text": "いや。あ、待って。これはまずい。これはまずい。"}, {"type": "subtitle", "time": 23213.03, "timestamp": "06:26:53", "text": "なぜこんなに滑りやすいのですか？"}, {"type": "subtitle", "time": 23216.708, "timestamp": "06:26:56", "text": "その通り。これはとても滑りやすい。どうすればいいですか"}, {"type": "subtitle", "time": 23219.91, "timestamp": "06:26:59", "text": "目標は何ですか？私たちはどこへ行くべきでしょうか？のように"}]
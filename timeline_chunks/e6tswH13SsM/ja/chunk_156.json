[{"type": "subtitle", "time": 9361.91, "timestamp": "02:36:01", "text": "は。ええ、そうですね。こんにちは。そして今、私は"}, {"type": "subtitle", "time": 9366.389, "timestamp": "02:36:06", "text": "卵を割る。一度だけやってもいいですか？おお。"}, {"type": "subtitle", "time": 9369.83, "timestamp": "02:36:09", "text": "あ、待って。それは新しい技術のように感じました。"}, {"type": "subtitle", "time": 9373.429, "timestamp": "02:36:13", "text": "卵を落とすだけです"}, {"type": "subtitle", "time": 9376.79, "timestamp": "02:36:16", "text": "あれ。チャット、一緒にやってみない？"}, {"type": "subtitle", "time": 9379.99, "timestamp": "02:36:19", "text": "もう、やめるよ。私は"}, {"type": "subtitle", "time": 9384.19, "timestamp": "02:36:24", "text": "捨てるよ。わかった。三つ、"}, {"type": "subtitle", "time": 9388.349, "timestamp": "02:36:28", "text": "２、魚。 ３、２、"}, {"type": "subtitle", "time": 9392.469, "timestamp": "02:36:32", "text": "1つ。えーと、みなさんこんにちは。はい、生きています。"}, {"type": "subtitle", "time": 9396.349, "timestamp": "02:36:36", "text": "私はここにいます。ごめんなさい。私は持っていた"}, {"type": "subtitle", "time": 9398.349, "timestamp": "02:36:38", "text": "私は"}, {"type": "subtitle", "time": 9403.07, "timestamp": "02:36:43", "text": "そう、私は心の底では死んでいた。私は私です"}, {"type": "subtitle", "time": 9406.19, "timestamp": "02:36:46", "text": "本当に、本当にそう思います"}, {"type": "subtitle", "time": 9410.309, "timestamp": "02:36:50", "text": "正直言って気分が悪いです"}, {"type": "subtitle", "time": 9413.03, "timestamp": "02:36:53", "text": "VODを流すのは気が引ける"}, {"type": "subtitle", "time": 9415.83, "timestamp": "02:36:55", "text": "そして、ストリームの半分に登場しない"}, {"type": "subtitle", "time": 9419.309, "timestamp": "02:36:59", "text": "半分くらいの時間は睡眠か"}]
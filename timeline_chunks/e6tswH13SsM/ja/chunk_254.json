[{"type": "subtitle", "time": 15242.07, "timestamp": "04:14:02", "text": "インドかどこかで。"}, {"type": "subtitle", "time": 15244.55, "timestamp": "04:14:04", "text": "調べてみると、輸入関税のようなものがあるようです。"}, {"type": "chat", "time": 15246.186, "timestamp": "04:14:06", "author": "@sarthaksharma2476", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kmJohYAdmpQzCNN96t58cLSK8spv6Y2ITutBFF9nvi9Z8=s64-c-k-c0x00ffffff-no-rj", "message": "he is chalak"}, {"type": "chat", "time": 15246.629, "timestamp": "04:14:06", "author": "@OtakuArceus", "avatar": "https://yt4.ggpht.com/VSZC0x7e02-tCAnte525GcpFOF0YcSpYQWplJkdg1RARvkQA3ETFxFaiYVshpLrqHFKUMz4VmA=s64-c-k-c0x00ffffff-no-rj", "message": "how much was it i dont remember"}, {"type": "subtitle", "time": 15254.79, "timestamp": "04:14:14", "text": "待って、政府はアップルを支配し、"}, {"type": "subtitle", "time": 15259.269, "timestamp": "04:14:19", "text": "これらすべての組織。何？"}, {"type": "subtitle", "time": 15260.87, "timestamp": "04:14:20", "text": "政府は管理していない。それ"}, {"type": "subtitle", "time": 15262.79, "timestamp": "04:14:22", "text": "非常に重要な役割を果たしている。のように"}, {"type": "subtitle", "time": 15268.07, "timestamp": "04:14:28", "text": "役割。でも、正確には言えない"}, {"type": "subtitle", "time": 15269.309, "timestamp": "04:14:29", "text": "まるでコントロール"}, {"type": "subtitle", "time": 15272.229, "timestamp": "04:14:32", "text": "あれ。しかし表面的には、それは非常に"}, {"type": "subtitle", "time": 15274.149, "timestamp": "04:14:34", "text": "まるで友達みたい、とても良い"}, {"type": "subtitle", "time": 15276.03, "timestamp": "04:14:36", "text": "友達、親友。"}, {"type": "subtitle", "time": 15279.59, "timestamp": "04:14:39", "text": "しかしその下には"}, {"type": "subtitle", "time": 15282.149, "timestamp": "04:14:42", "text": "ドラマが起こっている"}, {"type": "subtitle", "time": 15284.469, "timestamp": "04:14:44", "text": "そして、誰も他人の成長を望んでいない。"}, {"type": "subtitle", "time": 15287.75, "timestamp": "04:14:47", "text": "それが基本です。"}, {"type": "subtitle", "time": 15289.429, "timestamp": "04:14:49", "text": "なぜ他国が"}, {"type": "subtitle", "time": 15291.91, "timestamp": "04:14:51", "text": "インドは成長するだろう、そうでしょう？彼らはそうしない"}, {"type": "subtitle", "time": 15292.67, "timestamp": "04:14:52", "text": "欲しい"}, {"type": "subtitle", "time": 15296.79, "timestamp": "04:14:56", "text": "それ。インドはトップクラスの人気を誇っているが"}, {"type": "subtitle", "time": 15299.91, "timestamp": "04:14:59", "text": "5か6のGDPが今、"}]
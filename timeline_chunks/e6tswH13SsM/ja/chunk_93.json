[{"type": "subtitle", "time": 5610.91, "timestamp": "01:33:30", "text": "[音楽]"}, {"type": "subtitle", "time": 5620.51, "timestamp": "01:33:40", "text": "うん。私は私はあまりにも"}, {"type": "subtitle", "time": 5624.59, "timestamp": "01:33:44", "text": "彼女をお気に入り登録するのは、彼女が"}, {"type": "subtitle", "time": 5626.87, "timestamp": "01:33:46", "text": "星座。うん。必要だ、試してみます"}]
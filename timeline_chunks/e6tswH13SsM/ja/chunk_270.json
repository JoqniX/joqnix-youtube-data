[{"type": "subtitle", "time": 16201.189, "timestamp": "04:30:01", "text": "YouTubeの道とこの旅、"}, {"type": "subtitle", "time": 16203.91, "timestamp": "04:30:03", "text": "もっと多くの場所にアクセスして、"}, {"type": "subtitle", "time": 16206.87, "timestamp": "04:30:06", "text": "マイルストーンとかそういうの、だって君はそういう段階にいるんだから"}, {"type": "subtitle", "time": 16210.229, "timestamp": "04:30:10", "text": "良い道筋ではあるけれど。あなたはそんなことをするような人ではない"}, {"type": "subtitle", "time": 16213.03, "timestamp": "04:30:13", "text": "同じことを他の人もやっている。"}, {"type": "subtitle", "time": 16216.87, "timestamp": "04:30:16", "text": "あなたは新しいことに挑戦し、新しいものをもたらしています"}, {"type": "subtitle", "time": 16219.83, "timestamp": "04:30:19", "text": "えっと、なんて呼ぶんだっけ？新しい、いや"}, {"type": "subtitle", "time": 16223.51, "timestamp": "04:30:23", "text": "新しい記録を樹立するなどの要件、または"}, {"type": "subtitle", "time": 16226.95, "timestamp": "04:30:26", "text": "さあ、今すぐ皿に盛ってくれ。それは役に立つ"}, {"type": "subtitle", "time": 16229.429, "timestamp": "04:30:29", "text": "これは、いつでも役に立つ"}, {"type": "subtitle", "time": 16231.75, "timestamp": "04:30:31", "text": "新しいYouTuberが登場した、または既存のYouTuberに似ている"}, {"type": "subtitle", "time": 16234.55, "timestamp": "04:30:34", "text": "YouTuberがこれを見ると、彼らも感じるだろう"}, {"type": "subtitle", "time": 16236.55, "timestamp": "04:30:36", "text": "うん、私も何かしたい"}, {"type": "subtitle", "time": 16239.03, "timestamp": "04:30:39", "text": "このように、彼らはまた、"}, {"type": "subtitle", "time": 16241.429, "timestamp": "04:30:41", "text": "インスピレーションを受けたり、自分のものを作ろうとしたりする"}, {"type": "subtitle", "time": 16245.269, "timestamp": "04:30:45", "text": "物事を自分たちのやり方でやろうとする"}, {"type": "subtitle", "time": 16247.11, "timestamp": "04:30:47", "text": "また競争のようなものですが、それでも"}, {"type": "subtitle", "time": 16249.99, "timestamp": "04:30:49", "text": "まるで今もそこにいるみたいだ"}, {"type": "subtitle", "time": 16253.189, "timestamp": "04:30:53", "text": "より高い道に進み、人々は"}, {"type": "subtitle", "time": 16255.269, "timestamp": "04:30:55", "text": "ゆっくりと、彼らも最善を尽くすでしょう"}, {"type": "subtitle", "time": 16258.149, "timestamp": "04:30:58", "text": "などなど。そうすれば"}]
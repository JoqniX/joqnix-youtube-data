[{"type": "subtitle", "time": 9000.11, "timestamp": "02:30:00", "text": "夕食、"}, {"type": "subtitle", "time": 9002.63, "timestamp": "02:30:02", "text": "朝食。こんにちは。だから、私は読むつもりです"}, {"type": "subtitle", "time": 9006.87, "timestamp": "02:30:06", "text": "チャットもできます。どうすればいいか試してみます"}, {"type": "subtitle", "time": 9009.79, "timestamp": "02:30:09", "text": "一体どうやってやればいいんだ？わかった、"}, {"type": "subtitle", "time": 9019.389, "timestamp": "02:30:19", "text": "作品。はい、できます"}, {"type": "subtitle", "time": 9026.63, "timestamp": "02:30:26", "text": "ついに。うん、これはすごく助かるよ"}, {"type": "subtitle", "time": 9029.19, "timestamp": "02:30:29", "text": "時間的に、そして何か起こった場合、"}, {"type": "subtitle", "time": 9035.75, "timestamp": "02:30:35", "text": "そう、モバイルマイクは、"}, {"type": "subtitle", "time": 9038.469, "timestamp": "02:30:38", "text": "私のメインマイクと同じくらい感度が高いです。"}, {"type": "subtitle", "time": 9041.95, "timestamp": "02:30:41", "text": "そう、"}, {"type": "subtitle", "time": 9045.11, "timestamp": "02:30:45", "text": "注意してビデオを再生してください。わかった。こんにちは。"}, {"type": "subtitle", "time": 9046.67, "timestamp": "02:30:46", "text": "さあ行こう"}, {"type": "subtitle", "time": 9051.23, "timestamp": "02:30:51", "text": "今。普段はこんなことしないけど、ああ"}, {"type": "subtitle", "time": 9054.27, "timestamp": "02:30:54", "text": "神。あなたは両親に話を聞いてもらう必要がある"}, {"type": "subtitle", "time": 9057.469, "timestamp": "02:30:57", "text": "話す？ああ、"}]
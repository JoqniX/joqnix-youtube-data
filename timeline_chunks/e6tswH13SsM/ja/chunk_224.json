[{"type": "subtitle", "time": 13441.03, "timestamp": "03:44:01", "text": "私のフィードをあなたに送るべきでしょうか"}, {"type": "subtitle", "time": 13451.91, "timestamp": "03:44:11", "text": "それは問題ですね"}, {"type": "subtitle", "time": 13454.309, "timestamp": "03:44:14", "text": "そうすれば私は"}, {"type": "subtitle", "time": 13458.469, "timestamp": "03:44:18", "text": "この配信にはたくさんの面白いコンテンツがある"}, {"type": "subtitle", "time": 13467.03, "timestamp": "03:44:27", "text": "[音楽]"}, {"type": "subtitle", "time": 13471.75, "timestamp": "03:44:31", "text": "えっと、ちょっと待って、一つだけ、えっと、"}, {"type": "subtitle", "time": 13475.03, "timestamp": "03:44:35", "text": "ヴィグナンを試したことはありますか？"}, {"type": "subtitle", "time": 13476.71, "timestamp": "03:44:36", "text": "いいえ"}, {"type": "subtitle", "time": 13480.469, "timestamp": "03:44:40", "text": "しかし、それは私にも必要なこと"}, {"type": "subtitle", "time": 13484.63, "timestamp": "03:44:44", "text": "3D機能があります。ええと、それは"}, {"type": "subtitle", "time": 13488.67, "timestamp": "03:44:48", "text": "仕事。もう一つはこれです"}, {"type": "subtitle", "time": 13490.59, "timestamp": "03:44:50", "text": "1つ"}, {"type": "subtitle", "time": 13493.79, "timestamp": "03:44:53", "text": "VTと呼ばれる"}]
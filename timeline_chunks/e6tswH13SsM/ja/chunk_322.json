[{"type": "subtitle", "time": 19323.868, "timestamp": "05:22:03", "text": "私の"}, {"type": "subtitle", "time": 19325.948, "timestamp": "05:22:05", "text": "神。ああ、"}, {"type": "subtitle", "time": 19329.43, "timestamp": "05:22:09", "text": "神。待って。離さないで。それが唯一の"}, {"type": "subtitle", "time": 19331.99, "timestamp": "05:22:11", "text": "私たちが持っているもの。私たちは一生懸命働いてきました"}, {"type": "subtitle", "time": 19352.868, "timestamp": "05:22:32", "text": "引く。待って、私の力を使わせてください。"}, {"type": "subtitle", "time": 19354.43, "timestamp": "05:22:34", "text": "はい。はい。"}, {"type": "chat", "time": 19355.634, "timestamp": "05:22:35", "author": "@AerinViolet", "avatar": "https://yt4.ggpht.com/UKawanVvntNiAwz6RWv6wPk_S8YwApvPcCfLApO-du_RbQRIPGtzJ5FTt1DCNmZFJWc_2vxlqw=s64-c-k-c0x00ffffff-no-rj", "message": "yo joqUCkszU2WH9gy1mb0dV-11UJg/ssIfY7OFG5OykQOpn4CQCw"}, {"type": "subtitle", "time": 19358.31, "timestamp": "05:22:38", "text": "はい。わかった。"}, {"type": "chat", "time": 19359.455, "timestamp": "05:22:39", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Greetings Konzteller! Tia 🖋♦~🌟 Welcome to the Guild! Make sure to read the Guildmate Guidelines in the description below before chatting further. Enjoy your stay!"}, {"type": "subtitle", "time": 19360.708, "timestamp": "05:22:40", "text": "ゆっくりと、ということでしょう。"}, {"type": "subtitle", "time": 19361.868, "timestamp": "05:22:41", "text": "待って、知ってるでしょ"}, {"type": "subtitle", "time": 19365.39, "timestamp": "05:22:45", "text": "何？ええ、ただ"}, {"type": "subtitle", "time": 19367.75, "timestamp": "05:22:47", "text": "いや、いや、いや、いや。方向が間違っている。"}, {"type": "subtitle", "time": 19376.788, "timestamp": "05:22:56", "text": "方向。ちょっとだけやらせてください"}, {"type": "subtitle", "time": 19378.11, "timestamp": "05:22:58", "text": "少し"}]
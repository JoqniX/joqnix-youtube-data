[{"type": "chat", "time": 24662.791, "timestamp": "06:51:02", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "Joq's Activity State is Mic-Muted"}, {"type": "subtitle", "time": 24666.548, "timestamp": "06:51:06", "text": "この地域へようこそ。"}, {"type": "subtitle", "time": 24668.948, "timestamp": "06:51:08", "text": "医療従事者はあらゆる医療活動において重要な役割を担っています。"}, {"type": "subtitle", "time": 24670.868, "timestamp": "06:51:10", "text": "成功したチーム。それらは落とすことができる"}, {"type": "subtitle", "time": 24673.19, "timestamp": "06:51:13", "text": "治療と医療のための展開可能な医療ステーション"}, {"type": "subtitle", "time": 24675.67, "timestamp": "06:51:15", "text": "チームメイトを手伝って積み重ねる"}, {"type": "subtitle", "time": 24678.468, "timestamp": "06:51:18", "text": "あなたに有利な状況です。"}, {"type": "subtitle", "time": 24680.788, "timestamp": "06:51:20", "text": "そして最後に、"}, {"type": "subtitle", "time": 24681.788, "timestamp": "06:51:21", "text": "サイン"}, {"type": "subtitle", "time": 24684.67, "timestamp": "06:51:24", "text": "クロスボウ、肉棒罠、"}, {"type": "subtitle", "time": 24686.948, "timestamp": "06:51:26", "text": "爆竹や投げナイフ、"}, {"type": "subtitle", "time": 24689.11, "timestamp": "06:51:29", "text": "ハンターは街をきれいに保つことを好む"}, {"type": "subtitle", "time": 24696.31, "timestamp": "06:51:36", "text": "距離。近隣防犯活動では、"}, {"type": "subtitle", "time": 24699.03, "timestamp": "06:51:39", "text": "怒りモードはあなたを救い出すことはありません"}, {"type": "subtitle", "time": 24701.27, "timestamp": "06:51:41", "text": "窮地に立たされた。だから、お互いの"}, {"type": "subtitle", "time": 24703.91, "timestamp": "06:51:43", "text": "強みを活かし、チームとして協力することが鍵となる"}, {"type": "subtitle", "time": 24706.948, "timestamp": "06:51:46", "text": "生き残るために。日が経つにつれて、"}, {"type": "subtitle", "time": 24708.948, "timestamp": "06:51:48", "text": "強力なアイテムをアンロックするチャンスを獲得しましょう"}, {"type": "subtitle", "time": 24711.67, "timestamp": "06:51:51", "text": "新しい能力やレアアイテムなどの報酬"}, {"type": "subtitle", "time": 24715.43, "timestamp": "06:51:55", "text": "武器、罠、そして避難所の防御設備。"}, {"type": "subtitle", "time": 24717.91, "timestamp": "06:51:57", "text": "しかし、選べる報酬は1つだけ"}]
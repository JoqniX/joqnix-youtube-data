[{"type": "subtitle", "time": 180.03, "timestamp": "00:03:00", "text": "私の工場が稼働しているなら"}, {"type": "subtitle", "time": 185.71, "timestamp": "00:03:05", "text": "家。ああ、法案が成立する"}, {"type": "subtitle", "time": 189.27, "timestamp": "00:03:09", "text": "B. ええ、彼らには、つまり、時間がかかるでしょう"}, {"type": "subtitle", "time": 191.91, "timestamp": "00:03:11", "text": "たぶん来週くらいかな。私の新しい部屋は"}, {"type": "subtitle", "time": 193.47, "timestamp": "00:03:13", "text": "締め付けられる"}, {"type": "subtitle", "time": 196.75, "timestamp": "00:03:16", "text": "まだ。だから私は"}, {"type": "subtitle", "time": 200.50900000000001, "timestamp": "00:03:20", "text": "そこから解放されることができる。だから私はオンにできる"}, {"type": "subtitle", "time": 203.55, "timestamp": "00:03:23", "text": "PC どのくらいの時間"}, {"type": "subtitle", "time": 206.98, "timestamp": "00:03:26", "text": "欲しい。ええ、そうですね。"}]
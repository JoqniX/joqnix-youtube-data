[{"type": "subtitle", "time": 4759.149, "timestamp": "01:19:19", "text": "私はこう思った。"}, {"type": "subtitle", "time": 4762.07, "timestamp": "01:19:22", "text": "待って。ヴァレラントではこういうことをやっていたのを忘れていた。"}, {"type": "subtitle", "time": 4769.83, "timestamp": "01:19:29", "text": "ああ、ヴァレラントでもそうやってるよ。私"}, {"type": "subtitle", "time": 4777.87, "timestamp": "01:19:37", "text": "イングリッシュモーメント"}, {"type": "subtitle", "time": 4797.58, "timestamp": "01:19:57", "text": "しなかった"}]
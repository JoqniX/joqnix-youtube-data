[{"type": "subtitle", "time": 16500.39, "timestamp": "04:35:00", "text": "ほら、考えてみてよ、"}, {"type": "subtitle", "time": 16501.99, "timestamp": "04:35:01", "text": "YouTubeの従来のやり方は"}, {"type": "subtitle", "time": 16504.869, "timestamp": "04:35:04", "text": "やりたいことを何でもやって、"}, {"type": "subtitle", "time": 16506.47, "timestamp": "04:35:06", "text": "楽しむ。それが重要な点です。のように"}, {"type": "subtitle", "time": 16509.15, "timestamp": "04:35:09", "text": "楽しめなければ意味がない。"}, {"type": "subtitle", "time": 16512.47, "timestamp": "04:35:12", "text": "右？楽しんでやってみて。しないで"}, {"type": "subtitle", "time": 16514.75, "timestamp": "04:35:14", "text": "考えすぎ。"}, {"type": "subtitle", "time": 16521.789, "timestamp": "04:35:21", "text": "うん、君に刺激を受けたよ"}, {"type": "subtitle", "time": 16524.949, "timestamp": "04:35:24", "text": "もっと。どうして俺がお前を刺激するんだ？あなた"}, {"type": "subtitle", "time": 16526.869, "timestamp": "04:35:26", "text": "もう何年もこれをやっています。"}, {"type": "subtitle", "time": 16529.99, "timestamp": "04:35:29", "text": "わかった。いいえ、それは実際に共鳴しました"}, {"type": "subtitle", "time": 16531.91, "timestamp": "04:35:31", "text": "私と一緒に。私もそうすべきだと感じた"}, {"type": "subtitle", "time": 16535.629, "timestamp": "04:35:35", "text": "それ。ルールを気にしなくなるか、"}, {"type": "subtitle", "time": 16538.23, "timestamp": "04:35:38", "text": "何でも。何でも。好きなことをすればいい"}, {"type": "subtitle", "time": 16541.67, "timestamp": "04:35:41", "text": "そういうことをしたいんです。"}, {"type": "subtitle", "time": 16543.429, "timestamp": "04:35:43", "text": "それが重要な点だ。さて、これらは誰が作ったのでしょうか？"}, {"type": "subtitle", "time": 16546.949, "timestamp": "04:35:46", "text": "ルールだよ、兄弟？まるで人が決めたように"}, {"type": "subtitle", "time": 16549.189, "timestamp": "04:35:49", "text": "まずはYouTuberになる。今、彼らは"}, {"type": "subtitle", "time": 16552.39, "timestamp": "04:35:52", "text": "このルールセットは典型的なものです"}, {"type": "subtitle", "time": 16554.709, "timestamp": "04:35:54", "text": "従来のYouTubeのやり方。兄弟、それは"}, {"type": "subtitle", "time": 16557.029, "timestamp": "04:35:57", "text": "みんなと同じように、それはあなたではない"}, {"type": "subtitle", "time": 16559.59, "timestamp": "04:35:59", "text": "違う。はい。私たちは皆同じ見た目ではない、"}]
[{"type": "subtitle", "time": 17402.868, "timestamp": "04:50:02", "text": "などなど。だから私は「うわあ、これは"}, {"type": "subtitle", "time": 17405.27, "timestamp": "04:50:05", "text": "すごくクールだね。"}, {"type": "subtitle", "time": 17407.19, "timestamp": "04:50:07", "text": "ステージ上で自分自身を見せて"}, {"type": "subtitle", "time": 17409.59, "timestamp": "04:50:09", "text": "すべて。そして、動きがある"}, {"type": "subtitle", "time": 17413.27, "timestamp": "04:50:13", "text": "トラックモデルを追跡するなど、すべて"}, {"type": "subtitle", "time": 17416.47, "timestamp": "04:50:16", "text": "こういう漫画っぽいアニメっぽい"}, {"type": "chat", "time": 17417.395, "timestamp": "04:50:17", "author": "@OtakuArceus", "avatar": "https://yt4.ggpht.com/VSZC0x7e02-tCAnte525GcpFOF0YcSpYQWplJkdg1RARvkQA3ETFxFaiYVshpLrqHFKUMz4VmA=s64-c-k-c0x00ffffff-no-rj", "message": "vocaloid is too old"}, {"type": "subtitle", "time": 17419.43, "timestamp": "04:50:19", "text": "これはすごくクールで、本当に楽しかったです"}, {"type": "subtitle", "time": 17427.11, "timestamp": "04:50:27", "text": "それ。そして、どうやらその間"}, {"type": "subtitle", "time": 17430.15, "timestamp": "04:50:30", "text": "えっと、たまたまHoly YouTubersの動画を見たんです。私"}, {"type": "subtitle", "time": 17432.628, "timestamp": "04:50:32", "text": "私は「おお、これはクールだ」と思った。"}, {"type": "subtitle", "time": 17435.91, "timestamp": "04:50:35", "text": "漫画かアニメか何かみたい"}, {"type": "subtitle", "time": 17438.23, "timestamp": "04:50:38", "text": "何か。それが私の最初の反応でした"}, {"type": "subtitle", "time": 17440.948, "timestamp": "04:50:40", "text": "だった。それから私は見続け、それから私は"}, {"type": "subtitle", "time": 17443.03, "timestamp": "04:50:43", "text": "理解できなかった。ちょうど出発したところだと思う"}, {"type": "subtitle", "time": 17445.67, "timestamp": "04:50:45", "text": "そして私はいつもの番組を見始めた"}, {"type": "subtitle", "time": 17448.39, "timestamp": "04:50:48", "text": "YouTubeのYouTuberみたいなケイシーみたいな"}, {"type": "subtitle", "time": 17452.47, "timestamp": "04:50:52", "text": "ネイスタッドとかそういうやつ。そして時が経つにつれて私は"}, {"type": "subtitle", "time": 17455.99, "timestamp": "04:50:55", "text": "フィードでこのVtubingというものを見たり、"}, {"type": "subtitle", "time": 17458.31, "timestamp": "04:50:58", "text": "Vtuberの動画とかそういう感じ。だから私はただ"}]
[{"type": "subtitle", "time": 13800.389, "timestamp": "03:50:00", "text": "カメラを1つのソースに右に向けると、私は"}, {"type": "subtitle", "time": 13802.229, "timestamp": "03:50:02", "text": "VCの顔に渡すか、私が"}, {"type": "subtitle", "time": 13804.71, "timestamp": "03:50:04", "text": "Vuduに渡してください。"}, {"type": "subtitle", "time": 13807.03, "timestamp": "03:50:07", "text": "Viduには、"}, {"type": "subtitle", "time": 13808.429, "timestamp": "03:50:08", "text": "カメラ"}, {"type": "subtitle", "time": 13812.229, "timestamp": "03:50:12", "text": "実例？えっと、ちょっと待ってください。"}, {"type": "subtitle", "time": 13815.75, "timestamp": "03:50:15", "text": "以前はカメラ1、2、3、4、5のようなものがありました"}, {"type": "subtitle", "time": 13817.59, "timestamp": "03:50:17", "text": "そんな感じ。うん。ええ、あります、あります"}, {"type": "subtitle", "time": 13820.229, "timestamp": "03:50:20", "text": "カメラが多すぎる。私はそれを知っています。"}, {"type": "subtitle", "time": 13822.87, "timestamp": "03:50:22", "text": "実際、私はほとんど自分でノックしました"}, {"type": "subtitle", "time": 13824.79, "timestamp": "03:50:24", "text": "それ。"}, {"type": "subtitle", "time": 13826.79, "timestamp": "03:50:26", "text": "ええ、だから私はVeruを使わないんです"}, {"type": "subtitle", "time": 13830.63, "timestamp": "03:50:30", "text": "多くの。ずいぶん昔の話だよ。テストしていたんです。"}, {"type": "subtitle", "time": 13833.429, "timestamp": "03:50:33", "text": "おお、新しいものを見て。私は"}, {"type": "subtitle", "time": 13836.55, "timestamp": "03:50:36", "text": "ヴィナダンも同じだ。"}, {"type": "subtitle", "time": 13839.269, "timestamp": "03:50:39", "text": "俺はこう思うんだ、兄弟、"}, {"type": "subtitle", "time": 13841.349, "timestamp": "03:50:41", "text": "だからVCはこう言うんだよ、"}, {"type": "subtitle", "time": 13848.389, "timestamp": "03:50:48", "text": "真実。真実。"}, {"type": "subtitle", "time": 13853.03, "timestamp": "03:50:53", "text": "はい、追跡されていません。なんてこった？"}, {"type": "subtitle", "time": 13854.11, "timestamp": "03:50:54", "text": "カメラ"}]
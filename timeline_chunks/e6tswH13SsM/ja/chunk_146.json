[{"type": "subtitle", "time": 8761.67, "timestamp": "02:26:01", "text": "今。でも、私はそこに行くから"}, {"type": "subtitle", "time": 8766.27, "timestamp": "02:26:06", "text": "大丈夫だと思います。わかった。私"}, {"type": "subtitle", "time": 8774.429, "timestamp": "02:26:14", "text": "[音楽]"}, {"type": "subtitle", "time": 8777.91, "timestamp": "02:26:17", "text": "上。待って。右から来る。待って。その"}, {"type": "subtitle", "time": 8779.99, "timestamp": "02:26:19", "text": "私のところに来る。あ、ちょっと待って。うん"}, {"type": "subtitle", "time": 8782.349, "timestamp": "02:26:22", "text": "これだ。私は何をしているのだろう？"}, {"type": "subtitle", "time": 8784.27, "timestamp": "02:26:24", "text": "ジョー。これ"}, {"type": "subtitle", "time": 8786.18, "timestamp": "02:26:26", "text": "1つ。はぁ？これ"}, {"type": "subtitle", "time": 8787.77, "timestamp": "02:26:27", "text": "[音楽]"}, {"type": "subtitle", "time": 8803.27, "timestamp": "02:26:43", "text": "えっと、待って、止まった。それは止まった。"}, {"type": "subtitle", "time": 8804.27, "timestamp": "02:26:44", "text": "それはとても"}, {"type": "subtitle", "time": 8806.27, "timestamp": "02:26:46", "text": "hy。"}, {"type": "subtitle", "time": 8810.07, "timestamp": "02:26:50", "text": "いいえ、5分かかります"}, {"type": "subtitle", "time": 8812.55, "timestamp": "02:26:52", "text": "いや、いや、いや、いや。私は完了します"}, {"type": "subtitle", "time": 8816.23, "timestamp": "02:26:56", "text": "他にもいろいろ。心配しないで。私は作りたかった"}, {"type": "subtitle", "time": 8818.55, "timestamp": "02:26:58", "text": "100くらいかな。いいえ、100 のように"}, {"type": "subtitle", "time": 8819.91, "timestamp": "02:26:59", "text": "たくさんのパンハニープーリ。しかし、"}]
[{"type": "subtitle", "time": 16382.87, "timestamp": "04:33:02", "text": "私のイベントはまだありますし、"}, {"type": "subtitle", "time": 16385.429, "timestamp": "04:33:05", "text": "YouTubeのような"}, {"type": "subtitle", "time": 16388.23, "timestamp": "04:33:08", "text": "あれと私のチャンネルは、そうそう"}, {"type": "subtitle", "time": 16390.23, "timestamp": "04:33:10", "text": "少なくとも私は何かをした、少なくとも私は努力した"}, {"type": "subtitle", "time": 16391.249, "timestamp": "04:33:11", "text": "何か"}, {"type": "subtitle", "time": 16392.39, "timestamp": "04:33:12", "text": "[音楽]"}, {"type": "subtitle", "time": 16394.31, "timestamp": "04:33:14", "text": "だから誰かが私の"}, {"type": "subtitle", "time": 16396.39, "timestamp": "04:33:16", "text": "プロフィールは知っています。 「うん、"}, {"type": "subtitle", "time": 16398.429, "timestamp": "04:33:18", "text": "この人は何かをした。彼らは試みた"}, {"type": "subtitle", "time": 16401.91, "timestamp": "04:33:21", "text": "「何か。」うん。そして私はただそれを実行するだけ。"}, {"type": "subtitle", "time": 16403.83, "timestamp": "04:33:23", "text": "好きだから。楽しいみたい。私は好きです"}, {"type": "chat", "time": 16405.756, "timestamp": "04:33:25", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "4 hours? mans been live for 68 days"}, {"type": "subtitle", "time": 16406.949, "timestamp": "04:33:26", "text": "イベントとかをやるため。楽しいよ。"}, {"type": "chat", "time": 16411.132, "timestamp": "04:33:31", "author": "@sarthaksharma2476", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kmJohYAdmpQzCNN96t58cLSK8spv6Y2ITutBFF9nvi9Z8=s64-c-k-c0x00ffffff-no-rj", "message": "true"}, {"type": "subtitle", "time": 16419.51, "timestamp": "04:33:39", "text": "うん。私はストリームを再視聴しています、"}, {"type": "subtitle", "time": 16423.109, "timestamp": "04:33:43", "text": "男。これをもう一度見るのはとても楽しいです。"}, {"type": "subtitle", "time": 16425.029, "timestamp": "04:33:45", "text": "兄弟。それはすごく恥ずかしい。よし、今私は"}, {"type": "subtitle", "time": 16427.109, "timestamp": "04:33:47", "text": "何も知らない。それは最初の配信だった"}, {"type": "subtitle", "time": 16430.349, "timestamp": "04:33:50", "text": "私はどう話せばいいのかもわからなかった"}, {"type": "subtitle", "time": 16433.109, "timestamp": "04:33:53", "text": "人々。私と友達だけだった。"}, {"type": "subtitle", "time": 16435.429, "timestamp": "04:33:55", "text": "私たちには専用のバーがあって、"}, {"type": "subtitle", "time": 16437.349, "timestamp": "04:33:57", "text": "飲み物を提供する。私たちは"}, {"type": "subtitle", "time": 16439.67, "timestamp": "04:33:59", "text": "もの。楽しかった"}]
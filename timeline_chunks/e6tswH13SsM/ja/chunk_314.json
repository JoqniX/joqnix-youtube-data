[{"type": "subtitle", "time": 18842.83, "timestamp": "05:14:02", "text": "このプレッシャーをただ登るだけ"}, {"type": "subtitle", "time": 18855.55, "timestamp": "05:14:15", "text": "木。私"}, {"type": "subtitle", "time": 18858.03, "timestamp": "05:14:18", "text": "できない なぜこれは"}, {"type": "subtitle", "time": 18864.47, "timestamp": "05:14:24", "text": "もちろん。私たちは持っているべきでしょうか 私たちは必要としています"}, {"type": "subtitle", "time": 18866.628, "timestamp": "05:14:26", "text": "斧。斧が必要だ。斧はどこだ？"}, {"type": "subtitle", "time": 18869.23, "timestamp": "05:14:29", "text": "斧を見つけろ。私たちには"}, {"type": "subtitle", "time": 18888.948, "timestamp": "05:14:48", "text": "斧。このゲームは本当に苦痛だ。"}, {"type": "subtitle", "time": 18890.868, "timestamp": "05:14:50", "text": "最初はそれほど痛くないはずだ"}, {"type": "subtitle", "time": 18893.35, "timestamp": "05:14:53", "text": "レベル。斧を見つける必要があるだけだ。これ"}, {"type": "subtitle", "time": 18896.47, "timestamp": "05:14:56", "text": "これは最初のレベルです。とんでもない。"}]
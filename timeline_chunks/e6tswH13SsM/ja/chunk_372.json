[{"type": "subtitle", "time": 22332.948, "timestamp": "06:12:12", "text": "来て。ああ、何かしたんですね。"}, {"type": "subtitle", "time": 22335.59, "timestamp": "06:12:15", "text": "何かが落ちた。"}, {"type": "subtitle", "time": 22339.51, "timestamp": "06:12:19", "text": "今、何が下落しているのか？ああ、それはああ。おお。おお。"}, {"type": "subtitle", "time": 22341.32, "timestamp": "06:12:21", "text": "おお。 ああ、これは大丈夫だ。見る？ああ、落ち着いて。落ち着いた"}, {"type": "subtitle", "time": 22347.44, "timestamp": "06:12:27", "text": "ああ、これは大丈夫だ。見る？ああ、落ち着いて。落ち着いた 下。おお。"}, {"type": "subtitle", "time": 22356.11, "timestamp": "06:12:36", "text": "くそ。くそ、"}, {"type": "subtitle", "time": 22364.09, "timestamp": "06:12:44", "text": "嗅ぐべきものは揃った。"}, {"type": "subtitle", "time": 22365.35, "timestamp": "06:12:45", "text": "[音楽]"}, {"type": "subtitle", "time": 22368.07, "timestamp": "06:12:48", "text": "私たちは金色のものが必要だった。"}, {"type": "subtitle", "time": 22370.788, "timestamp": "06:12:50", "text": "うん。くそ。"}, {"type": "subtitle", "time": 22372.708, "timestamp": "06:12:52", "text": "なるほど。私がその電話を作った。私はただ"}, {"type": "subtitle", "time": 22374.948, "timestamp": "06:12:54", "text": "これを置いてください。"}, {"type": "chat", "time": 22379.4, "timestamp": "06:12:59", "author": "@Minkk102", "avatar": "https://yt4.ggpht.com/TF8h5uIigJBanBg4LA_XZaY69S8H6wHtAUIDSGgMxHUqkEYRKq0z9m5NM8cqeDFnXLN0nN8i8g=s64-c-k-c0x00ffffff-no-rj", "message": "the pain is over "}]
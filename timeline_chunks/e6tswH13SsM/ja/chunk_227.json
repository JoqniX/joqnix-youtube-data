[{"type": "subtitle", "time": 13622.63, "timestamp": "03:47:02", "text": "何度もログインしてください。"}, {"type": "subtitle", "time": 13624.83, "timestamp": "03:47:04", "text": "えっ、それは"}, {"type": "subtitle", "time": 13628.229, "timestamp": "03:47:08", "text": "奇妙な。ああ、それからもう一つ"}, {"type": "subtitle", "time": 13637.03, "timestamp": "03:47:17", "text": "プレイグラウンドと呼ばれています。"}, {"type": "subtitle", "time": 13639.99, "timestamp": "03:47:19", "text": "遊び場？そう、遊び場。あなたは"}, {"type": "subtitle", "time": 13642.15, "timestamp": "03:47:22", "text": "聞いたことありますか？"}, {"type": "subtitle", "time": 13646.55, "timestamp": "03:47:26", "text": "いいえ。私は「プレイグラウンド」という番組を持っていました。"}, {"type": "subtitle", "time": 13648.95, "timestamp": "03:47:28", "text": "遊び場の小川。はい、お送りします"}, {"type": "subtitle", "time": 13656.389, "timestamp": "03:47:36", "text": "リンク。これは、ええ、これは"}, {"type": "subtitle", "time": 13668.389, "timestamp": "03:47:48", "text": "わかった。ダウンロードする必要があるんですよね？"}, {"type": "subtitle", "time": 13670.83, "timestamp": "03:47:50", "text": "うん。"}]
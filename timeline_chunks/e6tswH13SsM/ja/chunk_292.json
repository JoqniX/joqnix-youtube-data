[{"type": "subtitle", "time": 17522.35, "timestamp": "04:52:02", "text": "キスナIと3人のユーチューバー"}, {"type": "subtitle", "time": 17528.55, "timestamp": "04:52:08", "text": "あ、あ、あ、ちょっと待って。うん。ソー・クナ"}, {"type": "subtitle", "time": 17532.15, "timestamp": "04:52:12", "text": "輝夜月と舞あかりです。うん、"}, {"type": "subtitle", "time": 17535.99, "timestamp": "04:52:15", "text": "この３人。うん。ええ、この３人です。それで"}, {"type": "chat", "time": 17537.159, "timestamp": "04:52:17", "author": "@Minkk102", "avatar": "https://yt4.ggpht.com/TF8h5uIigJBanBg4LA_XZaY69S8H6wHtAUIDSGgMxHUqkEYRKq0z9m5NM8cqeDFnXLN0nN8i8g=s64-c-k-c0x00ffffff-no-rj", "message": "us rcs"}, {"type": "subtitle", "time": 17539.91, "timestamp": "04:52:19", "text": "私はそれを楽しみ、ゆっくりと続けました"}, {"type": "subtitle", "time": 17542.868, "timestamp": "04:52:22", "text": "彼らのウサギの穴に飛び込んで、"}, {"type": "subtitle", "time": 17546.07, "timestamp": "04:52:26", "text": "彼らの物語とすべてと私とそれ"}, {"type": "subtitle", "time": 17548.948, "timestamp": "04:52:28", "text": "本当に興味深いと感じました。"}, {"type": "subtitle", "time": 17553.51, "timestamp": "04:52:33", "text": "それから私はこのウサギの穴にさらに深く入り込んだ"}, {"type": "subtitle", "time": 17556.15, "timestamp": "04:52:36", "text": "すべての人生とサンジとその他を見ている"}, {"type": "subtitle", "time": 17558.31, "timestamp": "04:52:38", "text": "彼ら全員を毎日見始めた"}, {"type": "subtitle", "time": 17560.628, "timestamp": "04:52:40", "text": "アニメを見るのをやめた日"}, {"type": "subtitle", "time": 17563.11, "timestamp": "04:52:43", "text": "テレビを見るのをやめて、"}, {"type": "subtitle", "time": 17564.628, "timestamp": "04:52:44", "text": "毎日電話を見ているように"}, {"type": "subtitle", "time": 17567.19, "timestamp": "04:52:47", "text": "YouTuberっぽい感じとか、そういう感じ。"}, {"type": "subtitle", "time": 17569.59, "timestamp": "04:52:49", "text": "それから私は、彼らが"}, {"type": "subtitle", "time": 17572.55, "timestamp": "04:52:52", "text": "Chromeのタブを1つだけ開いて、"}, {"type": "subtitle", "time": 17574.788, "timestamp": "04:52:54", "text": "一度に大勢の人。以前とすべて"}, {"type": "subtitle", "time": 17578.51, "timestamp": "04:52:58", "text": "最低でも80個以上開けなければならなかった"}]
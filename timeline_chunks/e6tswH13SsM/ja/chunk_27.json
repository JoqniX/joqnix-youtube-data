[{"type": "subtitle", "time": 1638.19, "timestamp": "00:27:18", "text": "興味がある。冗談でしょ"}, {"type": "subtitle", "time": 1642.47, "timestamp": "00:27:22", "text": "自分。なぜ？何てことだ。あなたはそうする必要はなかった"}, {"type": "subtitle", "time": 1644.95, "timestamp": "00:27:24", "text": "そうしてください。何てことだ。何て言えばいいの？"}, {"type": "subtitle", "time": 1647.02, "timestamp": "00:27:27", "text": "あなた？"}, {"type": "subtitle", "time": 1656.19, "timestamp": "00:27:36", "text": "お願いします。ああ、"}, {"type": "subtitle", "time": 1658.909, "timestamp": "00:27:38", "text": "[音楽]"}, {"type": "subtitle", "time": 1661.9, "timestamp": "00:27:41", "text": "神。それは恥ずかしがり屋ですか"}, {"type": "subtitle", "time": 1673.389, "timestamp": "00:27:53", "text": "見る。"}]
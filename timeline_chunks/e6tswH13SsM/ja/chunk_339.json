[{"type": "subtitle", "time": 20344.15, "timestamp": "05:39:04", "text": "わかった。わかった。わかった。両方手に入れました"}, {"type": "subtitle", "time": 20347.67, "timestamp": "05:39:07", "text": "彼らのうちの。わかった。 3番目を見つける必要があります"}, {"type": "subtitle", "time": 20356.19, "timestamp": "05:39:16", "text": "いや、待って。 3つ目の項目はありません。そこには"}, {"type": "subtitle", "time": 20359.27, "timestamp": "05:39:19", "text": "は。うん、"}, {"type": "subtitle", "time": 20372.708, "timestamp": "05:39:32", "text": "わかった。何か必要なものはありますか？"}, {"type": "subtitle", "time": 20375.11, "timestamp": "05:39:35", "text": "置く？うん。"}, {"type": "subtitle", "time": 20377.59, "timestamp": "05:39:37", "text": "ちょっと押させてくれ。"}, {"type": "subtitle", "time": 20380.31, "timestamp": "05:39:40", "text": "この金床を置く必要はありますか？"}]
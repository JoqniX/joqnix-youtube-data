[{"type": "subtitle", "time": 15841.67, "timestamp": "04:24:01", "text": "ええ、その点は私も理解できます。でも私は"}, {"type": "subtitle", "time": 15844.71, "timestamp": "04:24:04", "text": "コミュニティではないことも考えてみてください"}, {"type": "subtitle", "time": 15847.67, "timestamp": "04:24:07", "text": "それ自体が、YouTuberというもの全体のようなものだ。私"}, {"type": "subtitle", "time": 15850.55, "timestamp": "04:24:10", "text": "普段は自分の人生について話す"}, {"type": "subtitle", "time": 15851.99, "timestamp": "04:24:11", "text": "私の人生で達成したこと"}, {"type": "subtitle", "time": 15854.63, "timestamp": "04:24:14", "text": "私が持っている経験は、"}, {"type": "subtitle", "time": 15858.469, "timestamp": "04:24:18", "text": "ナストラ、私には人生がある。うん。私が"}, {"type": "subtitle", "time": 15862.55, "timestamp": "04:24:22", "text": "現実世界で経験を積むことは"}, {"type": "subtitle", "time": 15866.229, "timestamp": "04:24:26", "text": "私にとってもっと重要で、"}, {"type": "subtitle", "time": 15868.389, "timestamp": "04:24:28", "text": "私みたいな人たちは、それを理解している。インターネットは"}, {"type": "subtitle", "time": 15871.229, "timestamp": "04:24:31", "text": "ニース。 Discordはクールだし、"}, {"type": "subtitle", "time": 15874.309, "timestamp": "04:24:34", "text": "しかし、あなたが"}, {"type": "subtitle", "time": 15876.229, "timestamp": "04:24:36", "text": "知り合いの会話タイプに出会う"}, {"type": "subtitle", "time": 15878.95, "timestamp": "04:24:38", "text": "人と人とのやり取り"}, {"type": "subtitle", "time": 15887.03, "timestamp": "04:24:47", "text": "だから私は、本当に必要なんです"}, {"type": "subtitle", "time": 15888.87, "timestamp": "04:24:48", "text": "実生活で何かを成し遂げる"}, {"type": "subtitle", "time": 15892.229, "timestamp": "04:24:52", "text": "何か私がやらなきゃいけないことがあるって知ってる？"}, {"type": "subtitle", "time": 15894.79, "timestamp": "04:24:54", "text": "それは私のやり方を全面的に変えるだろう"}]
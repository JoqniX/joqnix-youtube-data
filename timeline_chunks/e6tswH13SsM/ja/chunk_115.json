[{"type": "subtitle", "time": 6902.669, "timestamp": "01:55:02", "text": "だから、ありがとう"}, {"type": "subtitle", "time": 6909.79, "timestamp": "01:55:09", "text": "そしてスター。"}, {"type": "subtitle", "time": 6912.47, "timestamp": "01:55:12", "text": "うん。ありがとうございます"}, {"type": "subtitle", "time": 6914.149, "timestamp": "01:55:14", "text": "君たちと一緒に遊ばせてくれ。ありがとう"}, {"type": "subtitle", "time": 6916.03, "timestamp": "01:55:16", "text": "私を気遣ってくれて"}, {"type": "subtitle", "time": 6919.629, "timestamp": "01:55:19", "text": "良い。そうですね、ありがとうございます"}, {"type": "subtitle", "time": 6922.229, "timestamp": "01:55:22", "text": "あなた。だから、プレイすればするほど、"}, {"type": "subtitle", "time": 6925.79, "timestamp": "01:55:25", "text": "この星座にロックを解除してください"}, {"type": "subtitle", "time": 6928.669, "timestamp": "01:55:28", "text": "あれ。それがナンバーです"}, {"type": "subtitle", "time": 6932.229, "timestamp": "01:55:32", "text": "4つの塔。わかった。ああ、わかりました。わかった。"}, {"type": "subtitle", "time": 6936.75, "timestamp": "01:55:36", "text": "わかった。手に入れるまでプレイしたい"}, {"type": "subtitle", "time": 6939.43, "timestamp": "01:55:39", "text": "これ。でも、今日は本当に楽しかったよ。"}, {"type": "subtitle", "time": 6943.109, "timestamp": "01:55:43", "text": "けれど。私たちはたくさん遊んだ。"}, {"type": "subtitle", "time": 6946.83, "timestamp": "01:55:46", "text": "私たちはたくさん遊んで、"}, {"type": "subtitle", "time": 6956.75, "timestamp": "01:55:56", "text": "はい、この名前は長い間使っていました。"}]
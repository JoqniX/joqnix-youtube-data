[{"type": "subtitle", "time": 18304.19, "timestamp": "05:05:04", "text": "うん。待って、私たちは何が必要か見た"}, {"type": "subtitle", "time": 18309.948, "timestamp": "05:05:09", "text": "する。それは分かります。わかった。うん。うん。"}, {"type": "subtitle", "time": 18341.27, "timestamp": "05:05:41", "text": "それ。待って、それを置かせて"}, {"type": "subtitle", "time": 18344.07, "timestamp": "05:05:44", "text": "きちんと。"}, {"type": "subtitle", "time": 18346.51, "timestamp": "05:05:46", "text": "これは"}, {"type": "subtitle", "time": 18349.83, "timestamp": "05:05:49", "text": "難しい。待って。ちょっと待って。私を解放してください"}, {"type": "chat", "time": 18354.051, "timestamp": "05:05:54", "author": "@Minkk102", "avatar": "https://yt4.ggpht.com/TF8h5uIigJBanBg4LA_XZaY69S8H6wHtAUIDSGgMxHUqkEYRKq0z9m5NM8cqeDFnXLN0nN8i8g=s64-c-k-c0x00ffffff-no-rj", "message": "climb on it"}, {"type": "subtitle", "time": 18357.23, "timestamp": "05:05:57", "text": "わかった。"}]
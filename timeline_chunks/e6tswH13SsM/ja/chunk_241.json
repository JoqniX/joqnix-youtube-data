[{"type": "subtitle", "time": 14462.15, "timestamp": "04:01:02", "text": "私はまだそのバグを報告していません。しかし"}, {"type": "subtitle", "time": 14469.429, "timestamp": "04:01:09", "text": "わかったよ。あの島もだ。私は"}, {"type": "subtitle", "time": 14485.189, "timestamp": "04:01:25", "text": "ええ、半分くらい覆われていました"}, {"type": "subtitle", "time": 14487.429, "timestamp": "04:01:27", "text": "1時間くらいかな。"}, {"type": "subtitle", "time": 14489.59, "timestamp": "04:01:29", "text": "それはあなたのために30分で完了しました。"}, {"type": "subtitle", "time": 14491.189, "timestamp": "04:01:31", "text": "何？"}, {"type": "subtitle", "time": 14494.229, "timestamp": "04:01:34", "text": "ああ、そうだよ。いくら？何が"}, {"type": "subtitle", "time": 14495.75, "timestamp": "04:01:35", "text": "興味？"}, {"type": "subtitle", "time": 14501.469, "timestamp": "04:01:41", "text": "理由を言わないで。 JB３。何？どうやって？"}, {"type": "chat", "time": 14506.165, "timestamp": "04:01:46", "author": "@OtakuArceus", "avatar": "https://yt4.ggpht.com/VSZC0x7e02-tCAnte525GcpFOF0YcSpYQWplJkdg1RARvkQA3ETFxFaiYVshpLrqHFKUMz4VmA=s64-c-k-c0x00ffffff-no-rj", "message": "takes a toll"}, {"type": "subtitle", "time": 14518.55, "timestamp": "04:01:58", "text": "うん。 300MBSであって、GBSではありません。"}]
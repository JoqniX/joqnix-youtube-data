[{"type": "subtitle", "time": 23824.07, "timestamp": "06:37:04", "text": "はい、戻ってきました。戻ってきました。私は"}, {"type": "subtitle", "time": 23827.548, "timestamp": "06:37:07", "text": "今すぐチャットしましょう。私は再起動していました"}, {"type": "subtitle", "time": 23830.548, "timestamp": "06:37:10", "text": "PC。私は彼がアストラにひどいことをしているのを見た"}, {"type": "subtitle", "time": 23833.548, "timestamp": "06:37:13", "text": "非常に怪しい。待って、"}, {"type": "subtitle", "time": 23847.27, "timestamp": "06:37:27", "text": "[音楽]"}, {"type": "subtitle", "time": 23850.44, "timestamp": "06:37:30", "text": "ジョック。彼をミュートするのを忘れた。"}, {"type": "subtitle", "time": 23869.67, "timestamp": "06:37:49", "text": "[音楽]"}]
[{"type": "subtitle", "time": 8462.95, "timestamp": "02:21:02", "text": "ええと、私は居心地が悪いと感じていますが"}, {"type": "subtitle", "time": 8466.469, "timestamp": "02:21:06", "text": "君もそう思う瞬間、えっと、何？"}, {"type": "subtitle", "time": 8470.23, "timestamp": "02:21:10", "text": "言葉に戸惑う？いいえ、忙しすぎて"}, {"type": "subtitle", "time": 8473.59, "timestamp": "02:21:13", "text": "ああ、忙しすぎる。何が"}, {"type": "subtitle", "time": 8475.389, "timestamp": "02:21:15", "text": "言葉。私が探している言葉は何ですか？"}, {"type": "subtitle", "time": 8478.309, "timestamp": "02:21:18", "text": "のために？おお。噂は噂だ"}, {"type": "subtitle", "time": 8480.349, "timestamp": "02:21:20", "text": "探しています"}, {"type": "subtitle", "time": 8483.309, "timestamp": "02:21:23", "text": "のために。"}, {"type": "subtitle", "time": 8492.429, "timestamp": "02:21:32", "text": "たとえ"}, {"type": "subtitle", "time": 8496.07, "timestamp": "02:21:36", "text": "配信前にやるべきことが多すぎる、"}, {"type": "subtitle", "time": 8499.83, "timestamp": "02:21:39", "text": "そのため、1時間早く起きなければならない。"}, {"type": "subtitle", "time": 8503.27, "timestamp": "02:21:43", "text": "そして全てをこなすが、今はもっと"}, {"type": "subtitle", "time": 8507.59, "timestamp": "02:21:47", "text": "私はますます配信をしています。そして私は"}, {"type": "subtitle", "time": 8511.11, "timestamp": "02:21:51", "text": "15分前に目が覚めて、私を見て"}, {"type": "subtitle", "time": 8514.67, "timestamp": "02:21:54", "text": "あらゆることを高速でこなす。"}]
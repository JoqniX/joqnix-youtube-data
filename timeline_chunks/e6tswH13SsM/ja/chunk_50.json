[{"type": "subtitle", "time": 3001.19, "timestamp": "00:50:01", "text": "おお。レベル9。私は10に到達するつもりです。"}, {"type": "subtitle", "time": 3002.06, "timestamp": "00:50:02", "text": "さあ"}, {"type": "subtitle", "time": 3007.07, "timestamp": "00:50:07", "text": "行く。"}, {"type": "subtitle", "time": 3014.19, "timestamp": "00:50:14", "text": "[音楽]"}, {"type": "subtitle", "time": 3021.95, "timestamp": "00:50:21", "text": "待って、寝てないの？"}, {"type": "subtitle", "time": 3024.27, "timestamp": "00:50:24", "text": "Dは"}, {"type": "subtitle", "time": 3027.39, "timestamp": "00:50:27", "text": "遅い。冗談だよ、世界が"}, {"type": "subtitle", "time": 3030.069, "timestamp": "00:50:30", "text": "リリース？えっと、実はよくわからないんです。"}, {"type": "subtitle", "time": 3033.03, "timestamp": "00:50:33", "text": "おそらく今年になるでしょう。いいえ、"}, {"type": "subtitle", "time": 3035.67, "timestamp": "00:50:35", "text": "まるでクローズドベータテストを実施しているかのようだ"}, {"type": "subtitle", "time": 3039.03, "timestamp": "00:50:39", "text": "などなど。ええ、そうですね。あなたは何をしていますか"}, {"type": "subtitle", "time": 3049.95, "timestamp": "00:50:49", "text": "ええと、これです。いいえ、こちらがお店です。"}, {"type": "subtitle", "time": 3056.91, "timestamp": "00:50:56", "text": "[音楽]"}, {"type": "subtitle", "time": 3059.99, "timestamp": "00:50:59", "text": "けれど。最後の手段。ああ、最後の手段だ。"}]
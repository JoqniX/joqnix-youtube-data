[{"type": "subtitle", "time": 3241.43, "timestamp": "00:54:01", "text": "ヴァレリンのクレジットはまさにその通りです"}, {"type": "subtitle", "time": 3246.39, "timestamp": "00:54:06", "text": "白い紙のようなものを使ってもいいですよ"}, {"type": "subtitle", "time": 3248.75, "timestamp": "00:54:08", "text": "新しいキャラクターを手に入れるために"}, {"type": "subtitle", "time": 3253.27, "timestamp": "00:54:13", "text": "まあそうだと思うけど、ガチャはスキン用だよ"}, {"type": "subtitle", "time": 3256.309, "timestamp": "00:54:16", "text": "武器スキンもあるので、下忍のようですが"}, {"type": "subtitle", "time": 3261.309, "timestamp": "00:54:21", "text": "キャラクター"}, {"type": "subtitle", "time": 3264.15, "timestamp": "00:54:24", "text": "ああ、武器のために手に入れるんだ"}, {"type": "subtitle", "time": 3267.109, "timestamp": "00:54:27", "text": "武器、化粧品、うん。えっと、待って、それは"}, {"type": "subtitle", "time": 3272.99, "timestamp": "00:54:32", "text": "うん。"}, {"type": "subtitle", "time": 3281.87, "timestamp": "00:54:41", "text": "マグ。このMは近いうちに送ります。"}]
[{"type": "subtitle", "time": 540.31, "timestamp": "00:09:00", "text": "この男を観戦し、観察している。私たちの"}, {"type": "subtitle", "time": 556.55, "timestamp": "00:09:16", "text": "皆さん、私についてきてください。待って、待って。あなたは"}, {"type": "subtitle", "time": 559.269, "timestamp": "00:09:19", "text": "チームチャット全体に入力するか、"}, {"type": "subtitle", "time": 561.07, "timestamp": "00:09:21", "text": "パーティーですか？"}, {"type": "subtitle", "time": 563.829, "timestamp": "00:09:23", "text": "パーティー？言わないで。電話してこないかな"}, {"type": "subtitle", "time": 566.11, "timestamp": "00:09:26", "text": "外国人として、または"}, {"type": "subtitle", "time": 568.19, "timestamp": "00:09:28", "text": "何か？"}]
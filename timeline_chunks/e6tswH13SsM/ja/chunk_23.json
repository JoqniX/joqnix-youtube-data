[{"type": "subtitle", "time": 1382.11, "timestamp": "00:23:02", "text": "マスターズだと思う。"}, {"type": "subtitle", "time": 1387.29, "timestamp": "00:23:07", "text": "銀。"}, {"type": "subtitle", "time": 1389.47, "timestamp": "00:23:09", "text": "[音楽]"}, {"type": "subtitle", "time": 1393.27, "timestamp": "00:23:13", "text": "くそ。すごくかっこいい。私はもうすぐ10歳になります。"}, {"type": "subtitle", "time": 1395.909, "timestamp": "00:23:15", "text": "あと2階。"}, {"type": "subtitle", "time": 1410.669, "timestamp": "00:23:30", "text": "すぐ。"}, {"type": "subtitle", "time": 1414.909, "timestamp": "00:23:34", "text": "彼のアカウントは私の友人からのものなので、"}, {"type": "subtitle", "time": 1430.39, "timestamp": "00:23:50", "text": "おお。私はあなたがそうしなければならなかったと感じています"}, {"type": "subtitle", "time": 1432.549, "timestamp": "00:23:52", "text": "多くの中国人の友人が遊んでいます"}]
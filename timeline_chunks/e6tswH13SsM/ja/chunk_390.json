[{"type": "subtitle", "time": 23402.08, "timestamp": "06:30:02", "text": "ねずみ。今はマウスは必要ありません。今 フェイスマウスが必要だ。"}, {"type": "subtitle", "time": 23420.23, "timestamp": "06:30:20", "text": "ああ、なんてこった。新しいものを買う必要がある"}, {"type": "subtitle", "time": 23422.07, "timestamp": "06:30:22", "text": "ねずみ。買います。私はただ注文するだけです"}, {"type": "subtitle", "time": 23425.11, "timestamp": "06:30:25", "text": "私も同じものを使っています。"}, {"type": "subtitle", "time": 23426.75, "timestamp": "06:30:26", "text": "このマウスはとても"}, {"type": "subtitle", "time": 23429.35, "timestamp": "06:30:29", "text": "良いのですが、二重の問題があります"}, {"type": "subtitle", "time": 23431.67, "timestamp": "06:30:31", "text": "カチッ。数ヶ月経った今、"}, {"type": "subtitle", "time": 23434.948, "timestamp": "06:30:34", "text": "始まる。だから、私は2回目です"}, {"type": "subtitle", "time": 23442.948, "timestamp": "06:30:42", "text": "ちょっと待ってくれ。戻ってきます"}, {"type": "subtitle", "time": 23445.75, "timestamp": "06:30:45", "text": "少しだけ。えっと、手を洗ってから戻ってきます"}, {"type": "subtitle", "time": 23449.948, "timestamp": "06:30:49", "text": "戻る。わかった。うん。わかった。インストール中です"}]
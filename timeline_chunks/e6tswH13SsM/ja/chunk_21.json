[{"type": "subtitle", "time": 1260.27, "timestamp": "00:21:00", "text": "こんにちは。私は入力したい 私は"}, {"type": "subtitle", "time": 1264.07, "timestamp": "00:21:04", "text": "怖がった。私はそれをやるつもりです。ない"}, {"type": "subtitle", "time": 1265.87, "timestamp": "00:21:05", "text": "とても良い。だからあなたの"}, {"type": "subtitle", "time": 1269.87, "timestamp": "00:21:09", "text": "日本語を勉強しています"}, {"type": "subtitle", "time": 1273.31, "timestamp": "00:21:13", "text": "それ。最初に動いてください。"}, {"type": "subtitle", "time": 1276.18, "timestamp": "00:21:16", "text": "ジョック。おお。"}, {"type": "subtitle", "time": 1283.669, "timestamp": "00:21:23", "text": "[音楽]"}, {"type": "subtitle", "time": 1285.31, "timestamp": "00:21:25", "text": "私は"}, {"type": "subtitle", "time": 1288.549, "timestamp": "00:21:28", "text": "中国語。それで、あなたは日本人ですか、それとも"}, {"type": "subtitle", "time": 1290.909, "timestamp": "00:21:30", "text": "日本人だけで"}, {"type": "subtitle", "time": 1297.27, "timestamp": "00:21:37", "text": "日本語。つまり、彼らは知っているということか"}, {"type": "subtitle", "time": 1304.31, "timestamp": "00:21:44", "text": "読む。私の実際のゲームを追加したいですか？"}, {"type": "subtitle", "time": 1311.99, "timestamp": "00:21:51", "text": "おお。だから、あなたがより高いレベルであり、"}, {"type": "subtitle", "time": 1315.19, "timestamp": "00:21:55", "text": "そういうものがあれば、簡単に友達ができます。"}, {"type": "subtitle", "time": 1317.149, "timestamp": "00:21:57", "text": "質問"}]
[{"type": "subtitle", "time": 21363.99, "timestamp": "05:56:03", "text": "1つ。はい、今ここにいます。何？"}, {"type": "subtitle", "time": 21377.27, "timestamp": "05:56:17", "text": "うん。ベラ、まあいいわ。それを取りなさい"}, {"type": "subtitle", "time": 21389.07, "timestamp": "05:56:29", "text": "兄弟、そうあるべきではない"}, {"type": "subtitle", "time": 21392.15, "timestamp": "05:56:32", "text": "ここ。私を見て。"}, {"type": "subtitle", "time": 21403.35, "timestamp": "05:56:43", "text": "いや、違うよ。降りてきて、降りてきて。"}, {"type": "subtitle", "time": 21407.03, "timestamp": "05:56:47", "text": "その点だけを見てください。"}, {"type": "subtitle", "time": 21416.15, "timestamp": "05:56:56", "text": "今、何をすべきでしょうか？行ってみてください"}]
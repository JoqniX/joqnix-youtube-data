[{"type": "subtitle", "time": 491.029, "timestamp": "00:08:11", "text": "ああ、あのロボットみたいなやつ、痛いよ。"}, {"type": "subtitle", "time": 519.149, "timestamp": "00:08:39", "text": "これはOPレベルのゲームプレイだ。ああ、"}, {"type": "subtitle", "time": 521.55, "timestamp": "00:08:41", "text": "神。ああ、"}, {"type": "subtitle", "time": 526.43, "timestamp": "00:08:46", "text": "神。何てことだ。私は何を見ているのでしょうか？おお。"}, {"type": "subtitle", "time": 528.43, "timestamp": "00:08:48", "text": "おお。おお"}, {"type": "subtitle", "time": 531.829, "timestamp": "00:08:51", "text": "私の。強烈だ。"}, {"type": "subtitle", "time": 537.67, "timestamp": "00:08:57", "text": "あなたは誰と話しているのですか？私は私は"}]
[{"type": "subtitle", "time": 21787.91, "timestamp": "06:03:07", "text": "[音楽]"}, {"type": "subtitle", "time": 21798.628, "timestamp": "06:03:18", "text": "知る。もし私がそれを成し遂げることができたら"}, {"type": "subtitle", "time": 21806.15, "timestamp": "06:03:26", "text": "兄弟。"}, {"type": "subtitle", "time": 21812.47, "timestamp": "06:03:32", "text": "いいえ、転んだんです。何てことだ。言わないで。"}, {"type": "subtitle", "time": 21814.39, "timestamp": "06:03:34", "text": "何てことだ。さて、その点について触れなければならない。"}, {"type": "subtitle", "time": 21822.23, "timestamp": "06:03:42", "text": "えっと、皆さん、助けてください。えっと、どうすればいいの？"}, {"type": "subtitle", "time": 21825.67, "timestamp": "06:03:45", "text": "私がこうしているとき、背中を振っているとき"}, {"type": "subtitle", "time": 21828.548, "timestamp": "06:03:48", "text": "そんな感じ？あなたに時間を与えてください。うん。うん。"}, {"type": "subtitle", "time": 21830.948, "timestamp": "06:03:50", "text": "そして、それをやってみる"}, {"type": "subtitle", "time": 21834.39, "timestamp": "06:03:54", "text": "待って、待って、今行くよ。"}, {"type": "subtitle", "time": 21837.51, "timestamp": "06:03:57", "text": "マウスを離せば、私は落ちる"}]
[{"type": "subtitle", "time": 12001.269, "timestamp": "03:20:01", "text": "[音楽]"}, {"type": "subtitle", "time": 12002.51, "timestamp": "03:20:02", "text": "ああ、それは"}, {"type": "subtitle", "time": 12003.64, "timestamp": "03:20:03", "text": "ブランド。"}, {"type": "subtitle", "time": 12004.83, "timestamp": "03:20:04", "text": "[音楽]"}, {"type": "subtitle", "time": 12008.59, "timestamp": "03:20:08", "text": "はい、これで終わりです。私"}, {"type": "subtitle", "time": 12013.11, "timestamp": "03:20:13", "text": "どうやら第7ラウンドに突入するようだ。 8 9 10 11 12"}, {"type": "subtitle", "time": 12022.389, "timestamp": "03:20:22", "text": "これで終わりです。そして"}, {"type": "subtitle", "time": 12044.71, "timestamp": "03:20:44", "text": "ええ、残りのことは私がやります"}, {"type": "subtitle", "time": 12046.79, "timestamp": "03:20:46", "text": "後で。わかった。また、出発前に"}, {"type": "subtitle", "time": 12049.51, "timestamp": "03:20:49", "text": "今日はいい日になりそうだ。何"}, {"type": "subtitle", "time": 12051.87, "timestamp": "03:20:51", "text": "レベルは"}]
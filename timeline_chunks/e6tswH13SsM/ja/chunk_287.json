[{"type": "subtitle", "time": 17221.11, "timestamp": "04:47:01", "text": "あなたを見逃したかもしれないし、"}, {"type": "subtitle", "time": 17225.19, "timestamp": "04:47:05", "text": "何か。私はウナに、私にとって"}, {"type": "subtitle", "time": 17226.628, "timestamp": "04:47:06", "text": "そんな用語があることすら知らなかった"}, {"type": "subtitle", "time": 17228.15, "timestamp": "04:47:08", "text": "VTuberとして知られる。"}, {"type": "subtitle", "time": 17229.99, "timestamp": "04:47:09", "text": "[音楽]"}, {"type": "subtitle", "time": 17233.27, "timestamp": "04:47:13", "text": "ああ、私にもわからない。そして私はそうしなかった"}, {"type": "subtitle", "time": 17235.03, "timestamp": "04:47:15", "text": "たとえその時、"}, {"type": "subtitle", "time": 17239.39, "timestamp": "04:47:19", "text": "私と同じことをしている人"}, {"type": "subtitle", "time": 17242.15, "timestamp": "04:47:22", "text": "ほら、どうやってこのアイデアを思いついたか知ってる？"}, {"type": "subtitle", "time": 17245.03, "timestamp": "04:47:25", "text": "iPhoneでは、"}, {"type": "subtitle", "time": 17247.948, "timestamp": "04:47:27", "text": "まるでメモ文字のようなもので、"}, {"type": "subtitle", "time": 17250.868, "timestamp": "04:47:30", "text": "アバターには顔のようなものがあります"}, {"type": "subtitle", "time": 17253.11, "timestamp": "04:47:33", "text": "追跡とかそういう類。それは新しく"}, {"type": "subtitle", "time": 17256.868, "timestamp": "04:47:36", "text": "iPhoneに搭載されて発売されました。わかった。そうなります"}, {"type": "subtitle", "time": 17259.83, "timestamp": "04:47:39", "text": "カスタムアバターのように、"}, {"type": "subtitle", "time": 17262.23, "timestamp": "04:47:42", "text": "あなたの顔の表情は"}, {"type": "subtitle", "time": 17264.868, "timestamp": "04:47:44", "text": "カメラから追跡して送信できます"}, {"type": "subtitle", "time": 17267.59, "timestamp": "04:47:47", "text": "それをあなたの友達に伝えて、何か。それで"}, {"type": "subtitle", "time": 17270.39, "timestamp": "04:47:50", "text": "それは衝撃的だった。俺は「くそ、使えるよ」って感じ"}, {"type": "subtitle", "time": 17273.19, "timestamp": "04:47:53", "text": "これは私のビデオのように、私のビデオのようにではなく、"}, {"type": "subtitle", "time": 17275.11, "timestamp": "04:47:55", "text": "ゲーム関連のこと、例えば私が自分の"}, {"type": "subtitle", "time": 17278.628, "timestamp": "04:47:58", "text": "カメラなら、それを使えばいい。"}]
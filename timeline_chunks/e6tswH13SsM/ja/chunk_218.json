[{"type": "subtitle", "time": 13090.19, "timestamp": "03:38:10", "text": "ああ、それは一番上にあるはずです。"}, {"type": "subtitle", "time": 13100.59, "timestamp": "03:38:20", "text": "ピンを刺させてください"}, {"type": "subtitle", "time": 13103.469, "timestamp": "03:38:23", "text": "トゥイッチ。 1つ"}, {"type": "subtitle", "time": 13106.63, "timestamp": "03:38:26", "text": "2番。ログインしていないのでしょうか？何が"}, {"type": "subtitle", "time": 13110.349, "timestamp": "03:38:30", "text": "今日、このブラウザで何か問題が発生していますか？わかった。"}, {"type": "subtitle", "time": 13112.429, "timestamp": "03:38:32", "text": "そしてそれは"}, {"type": "subtitle", "time": 13116.55, "timestamp": "03:38:36", "text": "終わり。了解しました。わかった。えっと、ミュートを解除します"}, {"type": "subtitle", "time": 13118.83, "timestamp": "03:38:38", "text": "配信であなた。"}, {"type": "subtitle", "time": 13121.15, "timestamp": "03:38:41", "text": "わかった。 1つ"}, {"type": "subtitle", "time": 13124.15, "timestamp": "03:38:44", "text": "2番。わかった。わかった。だから私たちみんな"}, {"type": "subtitle", "time": 13127.51, "timestamp": "03:38:47", "text": "私たちはコラボレーションを開始します。今日は"}, {"type": "subtitle", "time": 13130.83, "timestamp": "03:38:50", "text": "ええと、ここにアストラがいます"}, {"type": "subtitle", "time": 13132.99, "timestamp": "03:38:52", "text": "私たち。"}, {"type": "subtitle", "time": 13134.75, "timestamp": "03:38:54", "text": "えっと、1つ"}, {"type": "subtitle", "time": 13137.87, "timestamp": "03:38:57", "text": "2番。わかった。読み込み中です。"}]
[{"type": "subtitle", "time": 14582.229, "timestamp": "04:03:02", "text": "ええと、高速ネットなので、以前は1Gbpsでした"}, {"type": "subtitle", "time": 14584.87, "timestamp": "04:03:04", "text": "3ヶ月くらい"}, {"type": "chat", "time": 14597.47, "timestamp": "04:03:17", "author": "@OtakuArceus", "avatar": "https://yt4.ggpht.com/VSZC0x7e02-tCAnte525GcpFOF0YcSpYQWplJkdg1RARvkQA3ETFxFaiYVshpLrqHFKUMz4VmA=s64-c-k-c0x00ffffff-no-rj", "message": "i remember when we didnt really have access to wifi we used to share games on USB"}, {"type": "subtitle", "time": 14598.309, "timestamp": "04:03:18", "text": "くそ、そうじゃないよ。毎月支払うの？"}, {"type": "subtitle", "time": 14600.189, "timestamp": "04:03:20", "text": "毎年とかそういう感じ"}, {"type": "chat", "time": 14605.989, "timestamp": "04:03:25", "author": "@OtakuArceus", "avatar": "https://yt4.ggpht.com/VSZC0x7e02-tCAnte525GcpFOF0YcSpYQWplJkdg1RARvkQA3ETFxFaiYVshpLrqHFKUMz4VmA=s64-c-k-c0x00ffffff-no-rj", "message": "6month plan"}, {"type": "subtitle", "time": 14608.229, "timestamp": "04:03:28", "text": "えーと、今の会社みたいに"}, {"type": "subtitle", "time": 14609.91, "timestamp": "04:03:29", "text": "それは私のSHと同じ会社です"}, {"type": "subtitle", "time": 14611.99, "timestamp": "04:03:31", "text": "私の母のように、私の家の稼ぎ手は"}, {"type": "subtitle", "time": 14612.99, "timestamp": "04:03:32", "text": "父と"}, {"type": "subtitle", "time": 14616.99, "timestamp": "04:03:36", "text": "自分。家族向けのプランもあります"}, {"type": "subtitle", "time": 14619.429, "timestamp": "04:03:39", "text": "あれ。だから、どれくらいか全くわからない"}, {"type": "subtitle", "time": 14623.67, "timestamp": "04:03:43", "text": "私のWi-Fiソロの費用をどれくらいご存知ですか。だから私の"}, {"type": "subtitle", "time": 14625.51, "timestamp": "04:03:45", "text": "お父さん、お父さんが今それをやってくれます。私は持っている"}, {"type": "subtitle", "time": 14628.429, "timestamp": "04:03:48", "text": "全く分からない。どこに"}, {"type": "subtitle", "time": 14632.389, "timestamp": "04:03:52", "text": "植物？おお。"}, {"type": "subtitle", "time": 14634.07, "timestamp": "04:03:54", "text": "くそ。"}, {"type": "subtitle", "time": 14637.91, "timestamp": "04:03:57", "text": "そんなこと、全く知らなかった。"}]
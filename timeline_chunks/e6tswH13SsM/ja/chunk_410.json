[{"type": "subtitle", "time": 24611.51, "timestamp": "06:50:11", "text": "ネイバーフッド・ウォッチへようこそ。"}, {"type": "subtitle", "time": 24614.628, "timestamp": "06:50:14", "text": "新しい協同組合理事会体験は"}, {"type": "subtitle", "time": 24617.19, "timestamp": "06:50:17", "text": "ヴェネツィアの運河。あなたとあなたの友達は"}, {"type": "subtitle", "time": 24620.23, "timestamp": "06:50:20", "text": "ボブキャッツとしてプレイする、寄せ集めのグループ"}, {"type": "subtitle", "time": 24622.628, "timestamp": "06:50:22", "text": "ロサンゼルスに残された大学生たち"}, {"type": "subtitle", "time": 24624.468, "timestamp": "06:50:24", "text": "避難。"}, {"type": "subtitle", "time": 24627.43, "timestamp": "06:50:27", "text": "アンデッドが襲来するまであと5日。"}, {"type": "subtitle", "time": 24629.91, "timestamp": "06:50:29", "text": "大群があなたのシェルターに押し寄せると、"}, {"type": "subtitle", "time": 24631.91, "timestamp": "06:50:31", "text": "最初の4日間は情報収集に費やします"}, {"type": "subtitle", "time": 24635.03, "timestamp": "06:50:35", "text": "物資の調達と目標の達成、"}, {"type": "subtitle", "time": 24637.19, "timestamp": "06:50:37", "text": "最終波に備えてください"}, {"type": "subtitle", "time": 24638.91, "timestamp": "06:50:38", "text": "の"}, {"type": "subtitle", "time": 24641.59, "timestamp": "06:50:41", "text": "ゾンビ。しかし、出かける前に、"}, {"type": "subtitle", "time": 24644.628, "timestamp": "06:50:44", "text": "チームを編成する必要があります。それぞれ"}, {"type": "subtitle", "time": 24648.15, "timestamp": "06:50:48", "text": "Bobcatは、"}, {"type": "subtitle", "time": 24650.708, "timestamp": "06:50:50", "text": "特徴的な武器、才能、そして"}]
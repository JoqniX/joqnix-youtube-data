[{"type": "subtitle", "time": 4871.229, "timestamp": "01:21:11", "text": "[音楽]"}, {"type": "subtitle", "time": 4881.27, "timestamp": "01:21:21", "text": "ニース。まるで私がすごくクールだったみたいに。知っている。私は"}, {"type": "subtitle", "time": 4885.27, "timestamp": "01:21:25", "text": "敵が"}, {"type": "subtitle", "time": 4888.149, "timestamp": "01:21:28", "text": "殺されるだろうけど、どうにか翼をつけた"}]
[{"type": "subtitle", "time": 12906.309, "timestamp": "03:35:06", "text": "準備ができて。こんにちは。こんにちは。元気です。"}, {"type": "subtitle", "time": 12909.99, "timestamp": "03:35:09", "text": "待って、ストリーミングしてるの？"}, {"type": "subtitle", "time": 12930.229, "timestamp": "03:35:30", "text": "あれ？ああ、神様。だから、私は彼らのところへ行く"}, {"type": "subtitle", "time": 12934.51, "timestamp": "03:35:34", "text": "ウェブサイトと、えーと"}, {"type": "subtitle", "time": 12940.79, "timestamp": "03:35:40", "text": "あー、えー、えーと、ちょっと1秒選択してください。"}, {"type": "subtitle", "time": 12944.229, "timestamp": "03:35:44", "text": "えーと、クリエイターを作成するだけです"}, {"type": "subtitle", "time": 12946.07, "timestamp": "03:35:46", "text": "それは何と呼ばれますか？バーチャルな"}, {"type": "subtitle", "time": 12947.63, "timestamp": "03:35:47", "text": "カメラまたは"}, {"type": "subtitle", "time": 12950.15, "timestamp": "03:35:50", "text": "何か。その選択肢は表示されましたか？の"}, {"type": "subtitle", "time": 12957.03, "timestamp": "03:35:57", "text": "オプション。カメラを追加して、"}]
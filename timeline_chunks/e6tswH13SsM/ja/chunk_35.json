[{"type": "subtitle", "time": 2123.71, "timestamp": "00:35:23", "text": "ああ、ラプラスのチャットは本当にうざい。"}, {"type": "subtitle", "time": 2126.89, "timestamp": "00:35:26", "text": "待って、ラプラスって本当にうざい。待って。"}, {"type": "subtitle", "time": 2128.51, "timestamp": "00:35:28", "text": "[音楽]"}, {"type": "subtitle", "time": 2147.63, "timestamp": "00:35:47", "text": "つまり、私たちは遊ぶことができる"}, {"type": "subtitle", "time": 2150.15, "timestamp": "00:35:50", "text": "税関。時間がかかりすぎる場合は、遊ぼう"}]
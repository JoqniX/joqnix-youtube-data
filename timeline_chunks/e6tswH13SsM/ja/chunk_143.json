[{"type": "subtitle", "time": 8585.51, "timestamp": "02:23:05", "text": "こんにちは。うん。こんにちは。こんにちは。こんにちは。それで、"}, {"type": "subtitle", "time": 8589.27, "timestamp": "02:23:09", "text": "待って。じゃあ、えーと、これをやらせてください"}, {"type": "subtitle", "time": 8591.79, "timestamp": "02:23:11", "text": "えーと、インスタグラムとユーチューブとフェイスブック"}, {"type": "subtitle", "time": 8609.03, "timestamp": "02:23:29", "text": "また？よし、これで大丈夫だろう。"}, {"type": "subtitle", "time": 8611.67, "timestamp": "02:23:31", "text": "こんにちは。それでは、キッチンへ行きましょう。"}, {"type": "subtitle", "time": 8615.349, "timestamp": "02:23:35", "text": "今すぐ。モバイルに切り替えます"}, {"type": "subtitle", "time": 8619.51, "timestamp": "02:23:39", "text": "モバイルマイク。私の便利な携帯用マイク。"}, {"type": "subtitle", "time": 8622.469, "timestamp": "02:23:42", "text": "なぜだめですか？"}, {"type": "subtitle", "time": 8626.15, "timestamp": "02:23:46", "text": "ええ、背中のトレーニングもしますよ。私は思う"}, {"type": "subtitle", "time": 8628.27, "timestamp": "02:23:48", "text": "全て手に入れた"}, {"type": "subtitle", "time": 8630.83, "timestamp": "02:23:50", "text": "それ以外。"}, {"type": "subtitle", "time": 8633.309, "timestamp": "02:23:53", "text": "ああ、知ってたよ、"}]
[{"type": "subtitle", "time": 20773.07, "timestamp": "05:46:13", "text": "うん。なんてこった。いいえ。"}, {"type": "subtitle", "time": 20775.19, "timestamp": "05:46:15", "text": "いいえ、わかりました。わかった。わかった。わかった。"}, {"type": "subtitle", "time": 20776.59, "timestamp": "05:46:16", "text": "わかった。私は手に入れた"}, {"type": "subtitle", "time": 20780.868, "timestamp": "05:46:20", "text": "それ。何てことだ。おそらく、"}, {"type": "subtitle", "time": 20791.27, "timestamp": "05:46:31", "text": "ここ。くそ。何てことだ。こんにちは、シェリー。"}, {"type": "subtitle", "time": 20798.948, "timestamp": "05:46:38", "text": "シェリー。いいえ、これはうまくいきません。私たちには必要だ"}, {"type": "subtitle", "time": 20802.43, "timestamp": "05:46:42", "text": "これらすべてを"}, {"type": "subtitle", "time": 20804.67, "timestamp": "05:46:44", "text": "地面。すべてを手に入れよう"}, {"type": "subtitle", "time": 20811.31, "timestamp": "05:46:51", "text": "わかった、あのね？私は行きます"}]
[{"type": "subtitle", "time": 8882.63, "timestamp": "02:28:02", "text": "256本のケーブル。何てことだ。その力を想像してみてください"}, {"type": "subtitle", "time": 8886.27, "timestamp": "02:28:06", "text": "君は、私が生活しているから"}, {"type": "subtitle", "time": 8890.07, "timestamp": "02:28:10", "text": "2年間で6本の仮想ケーブル。そして今"}, {"type": "subtitle", "time": 8894.309, "timestamp": "02:28:14", "text": "私は250ギガバイト作ることができます。"}, {"type": "subtitle", "time": 8899.15, "timestamp": "02:28:19", "text": "[音楽]"}, {"type": "subtitle", "time": 8903.469, "timestamp": "02:28:23", "text": "数週間停電が続く。え、何？"}, {"type": "subtitle", "time": 8909.07, "timestamp": "02:28:29", "text": "はぁ？なぜ彼らは私を閉じ込める必要があるのですか？"}, {"type": "subtitle", "time": 8924.51, "timestamp": "02:28:44", "text": "[音楽]"}, {"type": "subtitle", "time": 8929.03, "timestamp": "02:28:49", "text": "ナンダ。わかりました、切り替えなければなりません。"}, {"type": "subtitle", "time": 8931.91, "timestamp": "02:28:51", "text": "モバイルマイクに切り替えます。では、"}, {"type": "subtitle", "time": 8934.87, "timestamp": "02:28:54", "text": "これってどう聞こえる？わかった。待って、"}, {"type": "subtitle", "time": 8936.91, "timestamp": "02:28:56", "text": "私に私の服を着させてください"}, {"type": "subtitle", "time": 8939.75, "timestamp": "02:28:59", "text": "ヘッドホン。ツイートしたと思うけど"}]
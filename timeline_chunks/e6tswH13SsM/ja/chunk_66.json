[{"type": "subtitle", "time": 3962.43, "timestamp": "01:06:02", "text": "1つ。いいえ、こちらです。"}, {"type": "subtitle", "time": 3968.23, "timestamp": "01:06:08", "text": "これら？これらは何ですか？私はすべきでしょうか"}, {"type": "subtitle", "time": 3971.27, "timestamp": "01:06:11", "text": "翻訳しますか？午後1時です。ああ、それは"}, {"type": "subtitle", "time": 3973.95, "timestamp": "01:06:13", "text": "午後1時のために"}, {"type": "subtitle", "time": 3987.75, "timestamp": "01:06:27", "text": "カメラ。それは何ですか？始動スプレー"}, {"type": "subtitle", "time": 3990.19, "timestamp": "01:06:30", "text": "武器の外観を塗装する。"}, {"type": "subtitle", "time": 3998.75, "timestamp": "01:06:38", "text": "バージョン。以前の投稿でそれをやっています。"}]
[{"type": "subtitle", "time": 9181.67, "timestamp": "02:33:01", "text": "すでに。わかった。よし。置く必要がある"}, {"type": "subtitle", "time": 9184.03, "timestamp": "02:33:04", "text": "少し"}, {"type": "subtitle", "time": 9186.15, "timestamp": "02:33:06", "text": "水。これで十分だろう。少し"}, {"type": "subtitle", "time": 9217.23, "timestamp": "02:33:37", "text": "十分。誰かが入ってくるような気がする"}, {"type": "subtitle", "time": 9227.87, "timestamp": "02:33:47", "text": "こんにちは。それは"}, {"type": "subtitle", "time": 9231.309, "timestamp": "02:33:51", "text": "えっと、これは何て言うんですか？"}, {"type": "subtitle", "time": 9235.03, "timestamp": "02:33:55", "text": "肝臓、肝臓ですよね？うん、"}, {"type": "subtitle", "time": 9237.469, "timestamp": "02:33:57", "text": "肝臓"}]
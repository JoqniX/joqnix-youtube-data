[{"type": "subtitle", "time": 7021.07, "timestamp": "01:57:01", "text": "はい。ああ、IDを送ってくれてありがとう。"}, {"type": "subtitle", "time": 7022.36, "timestamp": "01:57:02", "text": "H."}, {"type": "subtitle", "time": 7025.229, "timestamp": "01:57:05", "text": "[音楽]"}, {"type": "subtitle", "time": 7029.03, "timestamp": "01:57:09", "text": "わかった。ああ、ブルーアーカイブのアドリスだ。"}, {"type": "subtitle", "time": 7032.229, "timestamp": "01:57:12", "text": "あれはアリソですか？あれはアリソだと思います。私"}, {"type": "subtitle", "time": 7035.149, "timestamp": "01:57:15", "text": "今までプレイしたことはなかったけど、"}, {"type": "subtitle", "time": 7038.229, "timestamp": "01:57:18", "text": "うん。ええ、そうですね。えーと、これで終わりにします。"}, {"type": "subtitle", "time": 7041.47, "timestamp": "01:57:21", "text": "今日はここまで。皆様、お越しいただきありがとうございました。"}, {"type": "subtitle", "time": 7045.589, "timestamp": "01:57:25", "text": "による。そして明日私たちは"}, {"type": "subtitle", "time": 7047.589, "timestamp": "01:57:27", "text": "コラボレーションをする"}, {"type": "subtitle", "time": 7049.669, "timestamp": "01:57:29", "text": "えっと、寿司と一緒に。"}, {"type": "subtitle", "time": 7053.229, "timestamp": "01:57:33", "text": "私はまだ自分のパートをスケジュールしていません"}, {"type": "subtitle", "time": 7056.55, "timestamp": "01:57:36", "text": "配信はしないけど、スケジュールはたぶん"}, {"type": "subtitle", "time": 7060.229, "timestamp": "01:57:40", "text": "明日の朝に。しかし"}, {"type": "subtitle", "time": 7062.189, "timestamp": "01:57:42", "text": "うん、"}, {"type": "subtitle", "time": 7067.31, "timestamp": "01:57:47", "text": "ええ、ヴァレラントは登場します"}, {"type": "subtitle", "time": 7072.87, "timestamp": "01:57:52", "text": "明日の午後8時にコラボします。待って。えっと"}, {"type": "subtitle", "time": 7077.91, "timestamp": "01:57:57", "text": "彼のチャンネルを取得させてください。全部実行してください。"}, {"type": "subtitle", "time": 7079.87, "timestamp": "01:57:59", "text": "えっと、"}]
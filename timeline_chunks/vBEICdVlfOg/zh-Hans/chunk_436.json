[{"type": "subtitle", "time": 26175.19, "timestamp": "07:16:15", "text": "你可能会问，医生，那又会怎样呢？"}, {"type": "subtitle", "time": 26177.75, "timestamp": "07:16:17", "text": "那又怎样？"}, {"type": "subtitle", "time": 26180.15, "timestamp": "07:16:20", "text": "介绍？"}, {"type": "subtitle", "time": 26183.27, "timestamp": "07:16:23", "text": "你没做到。问号。"}, {"type": "subtitle", "time": 26194.948, "timestamp": "07:16:34", "text": "也祝你一切顺利？我可能不会"}, {"type": "subtitle", "time": 26197.35, "timestamp": "07:16:37", "text": "我仍然感到担忧，并产生了两种疑虑。"}, {"type": "subtitle", "time": 26198.948, "timestamp": "07:16:38", "text": "有很多生活琐事要处理。"}, {"type": "subtitle", "time": 26203.03, "timestamp": "07:16:43", "text": "我回来的时候。你好，"}, {"type": "subtitle", "time": 26205.35, "timestamp": "07:16:45", "text": "专注于生活。"}, {"type": "subtitle", "time": 26207.83, "timestamp": "07:16:47", "text": "我会一直在这里。所以，"}, {"type": "subtitle", "time": 26210.948, "timestamp": "07:16:50", "text": "不用担心。"}, {"type": "subtitle", "time": 26212.788, "timestamp": "07:16:52", "text": "同样的事情也会发生在我身上，当"}, {"type": "subtitle", "time": 26214.708, "timestamp": "07:16:54", "text": "我在日本"}, {"type": "subtitle", "time": 26218.07, "timestamp": "07:16:58", "text": "专注于当下生活。生存。我会"}]
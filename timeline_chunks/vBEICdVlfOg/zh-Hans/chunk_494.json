[{"type": "subtitle", "time": 29660.23, "timestamp": "08:14:20", "text": "是的。等等，我们可以这样说。"}, {"type": "subtitle", "time": 29663.19, "timestamp": "08:14:23", "text": "没有溢出。溢出将是"}, {"type": "subtitle", "time": 29665.03, "timestamp": "08:14:25", "text": "隐。所以滚动条不会出现。"}, {"type": "subtitle", "time": 29671.03, "timestamp": "08:14:31", "text": "或者您想要滚动条？"}, {"type": "subtitle", "time": 29674.68, "timestamp": "08:14:34", "text": "思考。想想D。我们还有时间。"}, {"type": "subtitle", "time": 29677.35, "timestamp": "08:14:37", "text": "[音乐]"}, {"type": "subtitle", "time": 29679.75, "timestamp": "08:14:39", "text": "总之，我当时想的是我们会"}, {"type": "subtitle", "time": 29684.23, "timestamp": "08:14:44", "text": "需要进行协调，对吧？所以，"}, {"type": "subtitle", "time": 29687.67, "timestamp": "08:14:47", "text": "再说回这个人。"}, {"type": "subtitle", "time": 29689.83, "timestamp": "08:14:49", "text": "手风琴。"}]
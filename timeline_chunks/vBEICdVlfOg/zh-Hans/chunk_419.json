[{"type": "subtitle", "time": 25141.43, "timestamp": "06:59:01", "text": "这是关于运动健将比赛的事吗？ Docathon"}, {"type": "subtitle", "time": 25144.788, "timestamp": "06:59:04", "text": "呃，我想你是在Twitch上吧？"}, {"type": "subtitle", "time": 25146.708, "timestamp": "06:59:06", "text": "正确的？它就在 Twitch 控制面板里。"}, {"type": "subtitle", "time": 25149.03, "timestamp": "06:59:09", "text": "请参考下面的Twitch频道。我"}, {"type": "subtitle", "time": 25151.35, "timestamp": "06:59:11", "text": "网站页面还没做好。"}, {"type": "subtitle", "time": 25155.99, "timestamp": "06:59:15", "text": "它。 TLDIA，它就像一个频道活动。"}, {"type": "subtitle", "time": 25160.23, "timestamp": "06:59:20", "text": "我的，呃，更像是我在做"}, {"type": "subtitle", "time": 25164.23, "timestamp": "06:59:24", "text": "这是一场马拉松。它不是一个子项"}, {"type": "subtitle", "time": 25170.548, "timestamp": "06:59:30", "text": "目标马拉松，嗯，我会一直直播直到我"}, {"type": "subtitle", "time": 25173.35, "timestamp": "06:59:33", "text": "就像我完成它一样"}, {"type": "subtitle", "time": 25177.67, "timestamp": "06:59:37", "text": "目标是2000美元。"}, {"type": "subtitle", "time": 25180.07, "timestamp": "06:59:40", "text": "对于VTuber模式以及所有的一切"}, {"type": "subtitle", "time": 25182.628, "timestamp": "06:59:42", "text": "那些东西。但最初我应该"}, {"type": "subtitle", "time": 25186.788, "timestamp": "06:59:46", "text": "本月7月结束joathon活动时，我"}, {"type": "subtitle", "time": 25189.99, "timestamp": "06:59:49", "text": "本来应该去的"}, {"type": "subtitle", "time": 25193.35, "timestamp": "06:59:53", "text": "呃，我想去日本，但我去不了，因为……"}, {"type": "subtitle", "time": 25195.27, "timestamp": "06:59:55", "text": "进气口因以下原因而改变："}, {"type": "subtitle", "time": 25197.67, "timestamp": "06:59:57", "text": "现在我的国家印度正处于政治战争之中。"}]
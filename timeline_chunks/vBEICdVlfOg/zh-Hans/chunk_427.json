[{"type": "subtitle", "time": 25621.43, "timestamp": "07:07:01", "text": "有人回应说没有课。我"}, {"type": "subtitle", "time": 25625.03, "timestamp": "07:07:05", "text": "认为那样的话就没有课了"}, {"type": "subtitle", "time": 25627.99, "timestamp": "07:07:07", "text": "然后。我觉得没有阶级可言。"}, {"type": "subtitle", "time": 25631.19, "timestamp": "07:07:11", "text": "提到这件事还在继续"}, {"type": "subtitle", "time": 25638.39, "timestamp": "07:07:18", "text": "现在我只在有空的时候才会直播。"}, {"type": "subtitle", "time": 25640.628, "timestamp": "07:07:20", "text": "积极参与。"}, {"type": "subtitle", "time": 25642.548, "timestamp": "07:07:22", "text": "所以这是唯一的变化。"}, {"type": "subtitle", "time": 25645.59, "timestamp": "07:07:25", "text": "这个月就像这个月一样"}, {"type": "subtitle", "time": 25647.99, "timestamp": "07:07:27", "text": "现在更多的是扩展功能。我本应该"}, {"type": "subtitle", "time": 25652.868, "timestamp": "07:07:32", "text": "7 月份结束的 Jockathon 活动，比如 6 月 22 日。我"}, {"type": "subtitle", "time": 25655.27, "timestamp": "07:07:35", "text": "本来应该结束一切，但是我的"}, {"type": "subtitle", "time": 25657.99, "timestamp": "07:07:37", "text": "关于日本的计划现在已经转移了。"}, {"type": "subtitle", "time": 25661.19, "timestamp": "07:07:41", "text": "2026年4月。"}, {"type": "subtitle", "time": 25664.07, "timestamp": "07:07:44", "text": "是的，自从我延长了它之后，我就……"}, {"type": "subtitle", "time": 25666.548, "timestamp": "07:07:46", "text": "好吧，我会慢慢来，努力……"}, {"type": "subtitle", "time": 25676.788, "timestamp": "07:07:56", "text": "但到了三月份，我计划发布"}]
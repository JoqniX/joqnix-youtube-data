[{"type": "subtitle", "time": 24960.708, "timestamp": "06:56:00", "text": "东西。"}, {"type": "subtitle", "time": 24963.59, "timestamp": "06:56:03", "text": "不过，食物确实很棒。他们喜欢"}, {"type": "subtitle", "time": 24975.59, "timestamp": "06:56:15", "text": "[音乐]"}, {"type": "subtitle", "time": 24984.548, "timestamp": "06:56:24", "text": "我觉得对某些人来说会是这样"}, {"type": "subtitle", "time": 24989.51, "timestamp": "06:56:29", "text": "就像他们会说，就像他们会说，就像"}, {"type": "subtitle", "time": 24990.948, "timestamp": "06:56:30", "text": "我不知道我这样说是否失礼。"}, {"type": "subtitle", "time": 24993.35, "timestamp": "06:56:33", "text": "但我见过这种情况……"}, {"type": "subtitle", "time": 24998.31, "timestamp": "06:56:38", "text": "人们。他们所做的并非如果他们"}, {"type": "subtitle", "time": 25000.15, "timestamp": "06:56:40", "text": "他们好像根本不明白。"}, {"type": "subtitle", "time": 25003.59, "timestamp": "06:56:43", "text": "例如，如果你……的区别"}, {"type": "subtitle", "time": 25007.43, "timestamp": "06:56:47", "text": "看到一群亚洲人"}, {"type": "subtitle", "time": 25010.23, "timestamp": "06:56:50", "text": "例如韩国人、中国人"}, {"type": "subtitle", "time": 25013.67, "timestamp": "06:56:53", "text": "日本人等等，他们会认为所有这些"}, {"type": "subtitle", "time": 25017.59, "timestamp": "06:56:57", "text": "这就像中国人会进行分类一样。"}]
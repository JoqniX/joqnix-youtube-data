[{"type": "subtitle", "time": 10202.55, "timestamp": "02:50:02", "text": "必要且重要。我做完了。"}, {"type": "subtitle", "time": 10204.469, "timestamp": "02:50:04", "text": "所以我沿用了同样的格式。"}, {"type": "subtitle", "time": 10206.309, "timestamp": "02:50:06", "text": "指导原则。"}, {"type": "subtitle", "time": 10208.95, "timestamp": "02:50:08", "text": "我把它留了下来"}, {"type": "subtitle", "time": 10213.349, "timestamp": "02:50:13", "text": "关于那个信息之类的。所以我会"}, {"type": "subtitle", "time": 10215.269, "timestamp": "02:50:15", "text": "我得做点什么，比如……我完成了"}, {"type": "subtitle", "time": 10219.03, "timestamp": "02:50:19", "text": "也包括里程碑事件。无论我做了什么"}, {"type": "subtitle", "time": 10221.429, "timestamp": "02:50:21", "text": "这些年来一直如此"}, {"type": "subtitle", "time": 10225.429, "timestamp": "02:50:25", "text": "好的，所以我只需要做我拥有的"}, {"type": "subtitle", "time": 10228.55, "timestamp": "02:50:28", "text": "还有三页正在制作中。媒体"}, {"type": "subtitle", "time": 10231.429, "timestamp": "02:50:31", "text": "成套工具。需要媒体资料包或新闻资料包。"}, {"type": "subtitle", "time": 10234.469, "timestamp": "02:50:34", "text": "现在，如果我正在申请……"}, {"type": "subtitle", "time": 10236.55, "timestamp": "02:50:36", "text": "比如赞助或任何品牌或"}, {"type": "subtitle", "time": 10238.71, "timestamp": "02:50:38", "text": "什么都行，对吧？这样我就可以给他们了"}, {"type": "subtitle", "time": 10242.55, "timestamp": "02:50:42", "text": "媒体资料包链接，以便他们可以查看"}, {"type": "subtitle", "time": 10245.11, "timestamp": "02:50:45", "text": "一切。我想到的是媒体。"}, {"type": "subtitle", "time": 10247.91, "timestamp": "02:50:47", "text": "套件链接 我会把链接发给你。"}, {"type": "subtitle", "time": 10250.95, "timestamp": "02:50:50", "text": "信息页面。所以如果它是一个品牌"}, {"type": "subtitle", "time": 10253.11, "timestamp": "02:50:53", "text": "或者如果他们想了解某个事件，可以阅读相关内容。"}, {"type": "subtitle", "time": 10256.07, "timestamp": "02:50:56", "text": "他们可以在这里阅读文本，就像这样"}, {"type": "subtitle", "time": 10259.83, "timestamp": "02:50:59", "text": "这。如果他们想阅读所有这些内容的话"}]
[{"type": "subtitle", "time": 25080.07, "timestamp": "06:58:00", "text": "例如来自不同的地方"}, {"type": "subtitle", "time": 25083.03, "timestamp": "06:58:03", "text": "不同的州或者其他什么情况，他们会"}, {"type": "subtitle", "time": 25085.11, "timestamp": "06:58:05", "text": "就把它归类到某一类里吧。"}, {"type": "subtitle", "time": 25087.03, "timestamp": "06:58:07", "text": "我不知道"}, {"type": "subtitle", "time": 25089.83, "timestamp": "06:58:09", "text": "例如北方人、南方人"}, {"type": "subtitle", "time": 25093.03, "timestamp": "06:58:13", "text": "像那样的人"}, {"type": "subtitle", "time": 25094.628, "timestamp": "06:58:14", "text": "根据他们的外表等等"}, {"type": "subtitle", "time": 25097.27, "timestamp": "06:58:17", "text": "我不知道，但我认为这很常见。"}, {"type": "subtitle", "time": 25101.35, "timestamp": "06:58:21", "text": "世界其他地区也一样，不太确定。"}, {"type": "subtitle", "time": 25103.83, "timestamp": "06:58:23", "text": "是的"}, {"type": "subtitle", "time": 25105.83, "timestamp": "06:58:25", "text": "每当我的家人这样做的时候"}, {"type": "subtitle", "time": 25108.788, "timestamp": "06:58:28", "text": "我会说，等等，我来纠正他们。"}, {"type": "subtitle", "time": 25111.19, "timestamp": "06:58:31", "text": "如果他们打电话给日本人，那还可以。"}, {"type": "subtitle", "time": 25113.35, "timestamp": "06:58:33", "text": "韩国人 中国人 我会说 嘿"}, {"type": "subtitle", "time": 25123.67, "timestamp": "06:58:43", "text": "就是这样。我会像科尔一样像我"}, {"type": "subtitle", "time": 25133.43, "timestamp": "06:58:53", "text": "你好，野牛们。美洲野牛。它是"}, {"type": "subtitle", "time": 25136.23, "timestamp": "06:58:56", "text": "好久不见。你好。"}, {"type": "subtitle", "time": 25138.15, "timestamp": "06:58:58", "text": "我上次来这里已经有一段时间了。"}]
[{"type": "subtitle", "time": 2171.03, "timestamp": "00:36:11", "text": "[音乐]"}, {"type": "subtitle", "time": 2172.87, "timestamp": "00:36:12", "text": "这是做什么用的？我的天哪，不，不，不！"}, {"type": "subtitle", "time": 2174.31, "timestamp": "00:36:14", "text": "不，不，不，不。不要下载"}, {"type": "subtitle", "time": 2177.109, "timestamp": "00:36:17", "text": "溪流。"}, {"type": "subtitle", "time": 2180.95, "timestamp": "00:36:20", "text": "是的。再见。我不想让你下载"}, {"type": "subtitle", "time": 2184.95, "timestamp": "00:36:24", "text": "我。我的天啊。不，"}, {"type": "subtitle", "time": 2187.91, "timestamp": "00:36:27", "text": "让我看看命令。这是什么？"}, {"type": "subtitle", "time": 2209.589, "timestamp": "00:36:49", "text": "好的，我来说说。我注意到它是"}, {"type": "subtitle", "time": 2212.47, "timestamp": "00:36:52", "text": "不，不是这样的"}, {"type": "subtitle", "time": 2216.95, "timestamp": "00:36:56", "text": "发出一些字符"}]
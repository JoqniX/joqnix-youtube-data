[{"type": "subtitle", "time": 28565.19, "timestamp": "07:56:05", "text": "呃"}, {"type": "subtitle", "time": 28577.91, "timestamp": "07:56:17", "text": "如果我将其设置为自动，会发生什么情况？"}, {"type": "subtitle", "time": 28581.67, "timestamp": "07:56:21", "text": "哦，它变小了。好的。好的。好的。"}, {"type": "subtitle", "time": 28584.15, "timestamp": "07:56:24", "text": "你就是罪魁祸首。宽高比。我是"}, {"type": "subtitle", "time": 28586.708, "timestamp": "07:56:26", "text": "会来找你"}, {"type": "subtitle", "time": 28589.27, "timestamp": "07:56:29", "text": "我会来找你的。"}, {"type": "subtitle", "time": 28598.948, "timestamp": "07:56:38", "text": "呃，退格键 6%。好的。所以，呃，我想"}, {"type": "subtitle", "time": 28602.388, "timestamp": "07:56:42", "text": "这是宽度和高度，对吧？"}, {"type": "subtitle", "time": 28605.35, "timestamp": "07:56:45", "text": "高度。我们不需要这么多。"}, {"type": "subtitle", "time": 28609.51, "timestamp": "07:56:49", "text": "但是等等。"}, {"type": "subtitle", "time": 28612.468, "timestamp": "07:56:52", "text": "为什么另一个人，那个做菜单的人……"}, {"type": "subtitle", "time": 28614.31, "timestamp": "07:56:54", "text": "在职的？"}, {"type": "subtitle", "time": 28617.27, "timestamp": "07:56:57", "text": "你会想，“我的天哪，这挑剔的……”"}]
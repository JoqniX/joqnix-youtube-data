[{"type": "subtitle", "time": 4263.11, "timestamp": "01:11:03", "text": "我会"}, {"type": "subtitle", "time": 4267.189, "timestamp": "01:11:07", "text": "我得去修修我的网站。"}, {"type": "subtitle", "time": 4270.95, "timestamp": "01:11:10", "text": "好了，我做完了。好的，所以我们"}, {"type": "subtitle", "time": 4273.189, "timestamp": "01:11:13", "text": "完成了。"}, {"type": "subtitle", "time": 4276.229, "timestamp": "01:11:16", "text": "我添加了单独的场景部分"}, {"type": "subtitle", "time": 4277.99, "timestamp": "01:11:17", "text": "这里。"}, {"type": "subtitle", "time": 4281.43, "timestamp": "01:11:21", "text": "在背景中。我的背景资料。"}, {"type": "subtitle", "time": 4285.03, "timestamp": "01:11:25", "text": "还剩下什么呢？我们需要这样做"}, {"type": "subtitle", "time": 4287.43, "timestamp": "01:11:27", "text": "粉丝群体支持商业联系。"}, {"type": "subtitle", "time": 4290.39, "timestamp": "01:11:30", "text": "好的。呃，我还需要删除表情符号。"}, {"type": "subtitle", "time": 4305.03, "timestamp": "01:11:45", "text": "其他方面似乎都不错。我们回来了"}, {"type": "subtitle", "time": 4308.07, "timestamp": "01:11:48", "text": "跳转至信息页面。我们只需要"}, {"type": "subtitle", "time": 4311.189, "timestamp": "01:11:51", "text": "把“关于我们”之类的页面内容放上去，对吧？"}, {"type": "subtitle", "time": 4315.669, "timestamp": "01:11:55", "text": "比如，我的身高是多少？等等"}, {"type": "subtitle", "time": 4318.47, "timestamp": "01:11:58", "text": "东西，对吧？血型，所有这些"}]
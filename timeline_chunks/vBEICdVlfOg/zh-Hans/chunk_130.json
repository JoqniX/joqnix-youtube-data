[{"type": "subtitle", "time": 7802.149, "timestamp": "02:10:02", "text": "这是他们定制的吗？"}, {"type": "subtitle", "time": 7804.79, "timestamp": "02:10:04", "text": "哦，"}, {"type": "subtitle", "time": 7806.39, "timestamp": "02:10:06", "text": "它正在维护中。好的，他们是"}, {"type": "subtitle", "time": 7814.629, "timestamp": "02:10:14", "text": "他们有很多东西。质量是"}, {"type": "subtitle", "time": 7821.7, "timestamp": "02:10:21", "text": "平衡状态"}, {"type": "subtitle", "time": 7843.27, "timestamp": "02:10:43", "text": "他们在主频道首次亮相。"}, {"type": "subtitle", "time": 7848.95, "timestamp": "02:10:48", "text": "在他们的日子里，在他们的频道上。哦，"}, {"type": "subtitle", "time": 7856.0, "timestamp": "02:10:56", "text": "哦， 这个格式真不错。"}]
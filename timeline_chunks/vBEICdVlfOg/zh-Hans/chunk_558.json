[{"type": "subtitle", "time": 33482.47, "timestamp": "09:18:02", "text": "或者我可以做同样的事情，只是名字不同。"}, {"type": "subtitle", "time": 33486.95, "timestamp": "09:18:06", "text": "就像内容一样。你"}, {"type": "subtitle", "time": 33488.95, "timestamp": "09:18:08", "text": "无论是无意识的还是有意识的，都必须"}, {"type": "subtitle", "time": 33493.03, "timestamp": "09:18:13", "text": "点击冷凝泵，它就会显示"}, {"type": "subtitle", "time": 33496.15, "timestamp": "09:18:16", "text": "向上。或许"}, {"type": "subtitle", "time": 33497.908, "timestamp": "09:18:17", "text": "我也不太喜欢这一点："}, {"type": "subtitle", "time": 33501.748, "timestamp": "09:18:21", "text": "它是紫色的。也许这就像很难……"}, {"type": "subtitle", "time": 33508.79, "timestamp": "09:18:28", "text": "或许只是我一个人。"}, {"type": "subtitle", "time": 33512.31, "timestamp": "09:18:32", "text": "做我自己的时刻。"}]
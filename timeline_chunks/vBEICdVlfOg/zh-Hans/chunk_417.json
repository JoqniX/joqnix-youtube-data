[{"type": "subtitle", "time": 25021.67, "timestamp": "06:57:01", "text": "把那组东西合并成一个整体"}, {"type": "subtitle", "time": 25025.19, "timestamp": "06:57:05", "text": "这很奇怪，居然不能……"}, {"type": "subtitle", "time": 25027.35, "timestamp": "06:57:07", "text": "区分"}, {"type": "subtitle", "time": 25032.39, "timestamp": "06:57:12", "text": "呃，当他们看到亚洲人的时候"}, {"type": "subtitle", "time": 25035.27, "timestamp": "06:57:15", "text": "嗯，是的，很容易注意到。"}, {"type": "subtitle", "time": 25038.23, "timestamp": "06:57:18", "text": "如果你正在和日本人交谈的话"}, {"type": "subtitle", "time": 25039.75, "timestamp": "06:57:19", "text": "如果你是在和中国人说话，那么这个人就是中国人。"}, {"type": "subtitle", "time": 25041.19, "timestamp": "06:57:21", "text": "如果你是在和韩国人说话，那就用韩语。"}, {"type": "subtitle", "time": 25044.708, "timestamp": "06:57:24", "text": "我见过和那样的人。"}, {"type": "subtitle", "time": 25047.91, "timestamp": "06:57:27", "text": "有些叔叔，他们会概括这些。"}, {"type": "subtitle", "time": 25053.75, "timestamp": "06:57:33", "text": "同样的事情也发生在印度。"}, {"type": "subtitle", "time": 25056.948, "timestamp": "06:57:36", "text": "是的。如"}, {"type": "subtitle", "time": 25059.99, "timestamp": "06:57:39", "text": "呃，举个例子，比如说你来自……"}, {"type": "subtitle", "time": 25065.03, "timestamp": "06:57:45", "text": "比如说，某人来自南方，或者"}, {"type": "subtitle", "time": 25068.868, "timestamp": "06:57:48", "text": "印度北部，如果他们看到"}, {"type": "subtitle", "time": 25071.67, "timestamp": "06:57:51", "text": "南方人等等，我想"}, {"type": "subtitle", "time": 25075.51, "timestamp": "06:57:55", "text": "他们会毫不犹豫地把它归类。"}, {"type": "subtitle", "time": 25078.15, "timestamp": "06:57:58", "text": "就像无论他们来自哪里一样"}]
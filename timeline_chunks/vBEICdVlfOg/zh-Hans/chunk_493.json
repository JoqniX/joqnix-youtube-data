[{"type": "subtitle", "time": 29582.388, "timestamp": "08:13:02", "text": "床单"}, {"type": "subtitle", "time": 29586.23, "timestamp": "08:13:06", "text": "表格，好的，我们会把它做成……"}, {"type": "subtitle", "time": 29600.388, "timestamp": "08:13:20", "text": "这将成为我的标志性特征。所以，"}, {"type": "subtitle", "time": 29602.788, "timestamp": "08:13:22", "text": "是的，通用目录菜单。"}, {"type": "subtitle", "time": 29605.43, "timestamp": "08:13:25", "text": "正确的？所以，"}, {"type": "subtitle", "time": 29608.948, "timestamp": "08:13:28", "text": "是的，我们会这么做。好的。我我"}, {"type": "subtitle", "time": 29612.388, "timestamp": "08:13:32", "text": "我当时脑子里想的是，嗯，也许吧。"}, {"type": "subtitle", "time": 29615.35, "timestamp": "08:13:35", "text": "我会添加一个背景滤镜。"}, {"type": "subtitle", "time": 29617.59, "timestamp": "08:13:37", "text": "所以这就是背后的原因。这将是"}, {"type": "subtitle", "time": 29620.15, "timestamp": "08:13:40", "text": "模糊"}, {"type": "subtitle", "time": 29621.75, "timestamp": "08:13:41", "text": "的"}, {"type": "subtitle", "time": 29629.27, "timestamp": "08:13:49", "text": "我们不会把这个放进去。是的。是的。喜欢"}, {"type": "subtitle", "time": 29632.07, "timestamp": "08:13:52", "text": "这。像这样。"}, {"type": "subtitle", "time": 29638.708, "timestamp": "08:13:58", "text": "你向下滚动。看起来很奇怪。我的天啊"}]
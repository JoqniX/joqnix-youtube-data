[{"type": "subtitle", "time": 1747.669, "timestamp": "00:29:07", "text": "我见过人们挣扎求生。医生"}, {"type": "subtitle", "time": 1750.31, "timestamp": "00:29:10", "text": "建议了两件事。既不吃也不吃"}, {"type": "subtitle", "time": 1757.99, "timestamp": "00:29:17", "text": "或修剪"}, {"type": "subtitle", "time": 1760.149, "timestamp": "00:29:20", "text": "删除能力。不，我不认为我"}, {"type": "subtitle", "time": 1762.31, "timestamp": "00:29:22", "text": "需要一块修边垫。你知道吗？我有"}, {"type": "subtitle", "time": 1764.389, "timestamp": "00:29:24", "text": "一个想法。"}, {"type": "subtitle", "time": 1766.149, "timestamp": "00:29:26", "text": "我有个主意。想法可以改变你"}, {"type": "subtitle", "time": 1770.95, "timestamp": "00:29:30", "text": "生活。呃，等等。我有个主意。嗯，"}, {"type": "subtitle", "time": 1777.19, "timestamp": "00:29:37", "text": "呃，拒绝"}, {"type": "subtitle", "time": 1785.99, "timestamp": "00:29:45", "text": "好的，把被拒收的名单给我。"}, {"type": "subtitle", "time": 1799.269, "timestamp": "00:29:59", "text": "标题和排除"}]
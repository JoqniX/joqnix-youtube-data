[{"type": "subtitle", "time": 34344.55, "timestamp": "09:32:24", "text": "等等，等等，等等，等等。为什么会这样"}, {"type": "subtitle", "time": 34346.87, "timestamp": "09:32:26", "text": "等等，等等。什么？什么？什么？什么？"}, {"type": "subtitle", "time": 34349.11, "timestamp": "09:32:29", "text": "什么？什么？我点击它，它自动"}, {"type": "subtitle", "time": 34351.906, "timestamp": "09:32:31", "text": "关闭。等等，等等，等等。什么？"}, {"type": "subtitle", "time": 34353.67, "timestamp": "09:32:33", "text": "天哪，我看不见了，因为太近了"}, {"type": "subtitle", "time": 34357.99, "timestamp": "09:32:37", "text": "按钮太难看到了，兄弟。好的。嗯，"}, {"type": "subtitle", "time": 34362.23, "timestamp": "09:32:42", "text": "等待。等不及了。如果我这样做，"}, {"type": "subtitle", "time": 34365.426, "timestamp": "09:32:45", "text": "它不显示。它关不上。你"}, {"type": "subtitle", "time": 34368.15, "timestamp": "09:32:48", "text": "注意到了吗？你看到了吗？"}, {"type": "subtitle", "time": 34371.586, "timestamp": "09:32:51", "text": "没有。看？看？看？看？看？"}, {"type": "subtitle", "time": 34374.23, "timestamp": "09:32:54", "text": "当你用手机时，点击这里。"}]
[{"type": "subtitle", "time": 1621.35, "timestamp": "00:27:01", "text": "酒精，你知道的，呃，让我"}, {"type": "subtitle", "time": 1625.029, "timestamp": "00:27:05", "text": "器官之类的东西，呃，比如"}, {"type": "subtitle", "time": 1628.63, "timestamp": "00:27:08", "text": "太糟糕了，这就是我不想做这件事的原因。"}, {"type": "subtitle", "time": 1631.59, "timestamp": "00:27:11", "text": "吸烟、饮酒或任何药物"}, {"type": "subtitle", "time": 1634.47, "timestamp": "00:27:14", "text": "甚至毒品，这三样东西都是绝对禁止的。"}, {"type": "subtitle", "time": 1642.149, "timestamp": "00:27:22", "text": "每次我看到爸爸这样做的时候，我"}, {"type": "subtitle", "time": 1644.95, "timestamp": "00:27:24", "text": "总是责骂他，比如“为什么？”是什么？"}, {"type": "subtitle", "time": 1651.909, "timestamp": "00:27:31", "text": "你会很累。你会"}, {"type": "chat", "time": 1655.696, "timestamp": "00:27:35", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "nah nah its like medicine ya dont drink it i dont drink it thats a home remedy for only cases when ya not have other stuff"}, {"type": "subtitle", "time": 1655.75, "timestamp": "00:27:35", "text": "你需要卧床休息一段时间，因为你不需要"}, {"type": "subtitle", "time": 1658.07, "timestamp": "00:27:38", "text": "吃。你体内会产生气体"}, {"type": "subtitle", "time": 1660.71, "timestamp": "00:27:40", "text": "胃，你会胃痛"}, {"type": "subtitle", "time": 1663.029, "timestamp": "00:27:43", "text": "痛苦等等。你正在经历"}, {"type": "subtitle", "time": 1665.669, "timestamp": "00:27:45", "text": "紧张的气氛等等。是什么？"}, {"type": "subtitle", "time": 1668.95, "timestamp": "00:27:48", "text": "观点？喝酒没用。"}, {"type": "subtitle", "time": 1671.909, "timestamp": "00:27:51", "text": "任何事物。它能解决你的财务问题吗？"}, {"type": "subtitle", "time": 1674.71, "timestamp": "00:27:54", "text": "问题和一切，悲伤和"}, {"type": "subtitle", "time": 1677.909, "timestamp": "00:27:57", "text": "东西？不，不会。你必须起床"}]
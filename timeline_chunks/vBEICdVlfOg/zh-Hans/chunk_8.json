[{"type": "subtitle", "time": 480.79, "timestamp": "00:08:00", "text": "哦，瘦素绿茶淡味。等等，是"}, {"type": "subtitle", "time": 482.95, "timestamp": "00:08:02", "text": "61卢比。"}, {"type": "subtitle", "time": 486.39, "timestamp": "00:08:06", "text": "Organo talisi 绿茶。"}, {"type": "subtitle", "time": 488.39, "timestamp": "00:08:08", "text": "等等，让我查一下。紫茶。等待，"}, {"type": "subtitle", "time": 491.909, "timestamp": "00:08:11", "text": "什么是紫茶？印度的紫茶。"}, {"type": "subtitle", "time": 497.749, "timestamp": "00:08:17", "text": "好的。蓝色茶。紫茶。减重50克。"}, {"type": "subtitle", "time": 502.07, "timestamp": "00:08:22", "text": "好的。紫茶。亲爱的蓝色宝贝"}, {"type": "subtitle", "time": 505.67, "timestamp": "00:08:25", "text": "紫茶。抗癌功效。"}, {"type": "subtitle", "time": 508.39, "timestamp": "00:08:28", "text": "改善视力。降低胆固醇和"}, {"type": "subtitle", "time": 511.909, "timestamp": "00:08:31", "text": "血液血糖代谢。"}, {"type": "subtitle", "time": 513.909, "timestamp": "00:08:33", "text": "哦，"}, {"type": "subtitle", "time": 516.7090000000001, "timestamp": "00:08:36", "text": "好的。"}, {"type": "subtitle", "time": 527.03, "timestamp": "00:08:47", "text": "哦，是的，他正在做踢腿延伸动作。我"}, {"type": "subtitle", "time": 531.829, "timestamp": "00:08:51", "text": "忘记了主播 B。"}, {"type": "subtitle", "time": 539.91, "timestamp": "00:08:59", "text": "他的……他的东西，叠加层真是太……"}]
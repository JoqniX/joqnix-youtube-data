[{"type": "subtitle", "time": 10471.51, "timestamp": "02:54:31", "text": "名称将以此为准。"}, {"type": "subtitle", "time": 10474.63, "timestamp": "02:54:34", "text": "我得再放一个。"}, {"type": "subtitle", "time": 10476.309, "timestamp": "02:54:36", "text": "堵塞。"}, {"type": "subtitle", "time": 10477.83, "timestamp": "02:54:37", "text": "哇。"}, {"type": "subtitle", "time": 10480.07, "timestamp": "02:54:40", "text": "我认为从某种意义上说，你可以说它是"}, {"type": "subtitle", "time": 10481.75, "timestamp": "02:54:41", "text": "文件夹。"}, {"type": "subtitle", "time": 10484.23, "timestamp": "02:54:44", "text": "没有把握。"}, {"type": "subtitle", "time": 10486.63, "timestamp": "02:54:46", "text": "可以把它看作是一个投资组合吗？我不"}, {"type": "subtitle", "time": 10488.71, "timestamp": "02:54:48", "text": "知道。我只是想要一个地方"}, {"type": "subtitle", "time": 10490.469, "timestamp": "02:54:50", "text": "每个人。"}, {"type": "subtitle", "time": 10492.87, "timestamp": "02:54:52", "text": "随时了解我的近况"}, {"type": "subtitle", "time": 10495.03, "timestamp": "02:54:55", "text": "信息而非依赖"}]
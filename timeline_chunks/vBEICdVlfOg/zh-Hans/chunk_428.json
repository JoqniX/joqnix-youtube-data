[{"type": "subtitle", "time": 25680.31, "timestamp": "07:08:00", "text": "比如音乐之类的东西。我会尽力而为"}, {"type": "subtitle", "time": 25683.51, "timestamp": "07:08:03", "text": "至少发布一首翻唱歌曲"}, {"type": "subtitle", "time": 25686.23, "timestamp": "07:08:06", "text": "至于音乐方面，我会练习的。"}, {"type": "subtitle", "time": 25688.23, "timestamp": "07:08:08", "text": "发布它不是为了炫耀，而是为了"}, {"type": "subtitle", "time": 25692.07, "timestamp": "07:08:12", "text": "我的另一个身份是你的音乐身份"}, {"type": "subtitle", "time": 25695.03, "timestamp": "07:08:15", "text": "我会把它发布在那里，但是我们会"}, {"type": "subtitle", "time": 25700.23, "timestamp": "07:08:20", "text": "在直播里做这些事我觉得没问题。"}, {"type": "subtitle", "time": 25702.788, "timestamp": "07:08:22", "text": "嗯，是的，我有一些目标，我会努力实现。"}, {"type": "chat", "time": 25703.231, "timestamp": "07:08:23", "author": "@100_American_Bison", "avatar": "https://yt4.ggpht.com/ytc/AIdro_lKufxgoZhsP3D6v3xZCOJXgxro_6vQvpASoQ_BFoacFw=s64-c-k-c0x00ffffff-no-rj", "message": "Ooh I thought you on the “no one can force me to stop so I’m going to keep going”"}, {"type": "subtitle", "time": 25705.59, "timestamp": "07:08:25", "text": "在我离开之前，必须在结束之前完成。"}, {"type": "subtitle", "time": 25709.83, "timestamp": "07:08:29", "text": "三月底之前，我将带着我的三月足迹前往日本。"}, {"type": "subtitle", "time": 25711.75, "timestamp": "07:08:31", "text": "是的。"}, {"type": "subtitle", "time": 25719.19, "timestamp": "07:08:39", "text": "我以为你拒绝我的话就能强迫我"}, {"type": "subtitle", "time": 25721.11, "timestamp": "07:08:41", "text": "停止。所以，我会继续下去。我是"}, {"type": "subtitle", "time": 25723.43, "timestamp": "07:08:43", "text": "还在做这件事。"}, {"type": "subtitle", "time": 25725.91, "timestamp": "07:08:45", "text": "我只是想把它带回来。"}, {"type": "subtitle", "time": 25729.59, "timestamp": "07:08:49", "text": "正常的流媒体播放是因为董事会不，"}, {"type": "subtitle", "time": 25733.03, "timestamp": "07:08:53", "text": "我玩《From Software》的意义何在？"}, {"type": "chat", "time": 25733.701, "timestamp": "07:08:53", "author": "@100_American_Bison", "avatar": "https://yt4.ggpht.com/ytc/AIdro_lKufxgoZhsP3D6v3xZCOJXgxro_6vQvpASoQ_BFoacFw=s64-c-k-c0x00ffffff-no-rj", "message": "Have a good time in Japan "}, {"type": "subtitle", "time": 25734.708, "timestamp": "07:08:54", "text": "2019"}, {"type": "subtitle", "time": 25739.67, "timestamp": "07:08:59", "text": "就像……该怎么称呼它呢？ 20209"}]
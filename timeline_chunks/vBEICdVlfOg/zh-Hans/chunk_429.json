[{"type": "subtitle", "time": 25744.39, "timestamp": "07:09:04", "text": "等待YouTube在2020年发布的内容"}, {"type": "subtitle", "time": 25747.91, "timestamp": "07:09:07", "text": "就像2024年一样，总是会这样。"}, {"type": "subtitle", "time": 25751.59, "timestamp": "07:09:11", "text": "现在很无聊，因为我想做新的。"}, {"type": "subtitle", "time": 25755.19, "timestamp": "07:09:15", "text": "Joathon也推出了一些新款手表。"}, {"type": "subtitle", "time": 25757.51, "timestamp": "07:09:17", "text": "短小的流。"}, {"type": "subtitle", "time": 25760.07, "timestamp": "07:09:20", "text": "是的。是的。但我不能使用"}, {"type": "subtitle", "time": 25762.868, "timestamp": "07:09:22", "text": "开始于四个月的四个月"}, {"type": "subtitle", "time": 25766.708, "timestamp": "07:09:26", "text": "Joathon 直播是因为"}, {"type": "subtitle", "time": 25768.868, "timestamp": "07:09:28", "text": "就像你在看一场表演一样"}, {"type": "subtitle", "time": 25773.03, "timestamp": "07:09:33", "text": "在 v 里面，在 v 里，三个 v 部分，对吧？"}, {"type": "subtitle", "time": 25775.19, "timestamp": "07:09:35", "text": "我不想那样。"}, {"type": "subtitle", "time": 25778.628, "timestamp": "07:09:38", "text": "是的。所以我只是想把……"}, {"type": "subtitle", "time": 25780.548, "timestamp": "07:09:40", "text": "普通流媒体和播放列表以及"}, {"type": "subtitle", "time": 25783.51, "timestamp": "07:09:43", "text": "一切与 YouTube 相关的内容。但是 Twitch 和"}, {"type": "subtitle", "time": 25786.39, "timestamp": "07:09:46", "text": "踢球，我更专注于此，因为我"}, {"type": "subtitle", "time": 25789.11, "timestamp": "07:09:49", "text": "YouTube 的目标已经全部完成。我"}, {"type": "subtitle", "time": 25791.03, "timestamp": "07:09:51", "text": "成为 YouTube 合作伙伴"}, {"type": "subtitle", "time": 25793.27, "timestamp": "07:09:53", "text": "以及所有的一切。已获得会员资格和"}, {"type": "subtitle", "time": 25795.83, "timestamp": "07:09:55", "text": "超级留言等等。一切都好。"}, {"type": "subtitle", "time": 25797.83, "timestamp": "07:09:57", "text": "已完全实现盈利。"}]
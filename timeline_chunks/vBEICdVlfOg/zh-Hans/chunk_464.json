[{"type": "subtitle", "time": 27841.75, "timestamp": "07:44:01", "text": "嗯？"}, {"type": "subtitle", "time": 27845.11, "timestamp": "07:44:05", "text": "等等，今天是星期一啊。"}, {"type": "subtitle", "time": 27847.19, "timestamp": "07:44:07", "text": "等待，"}, {"type": "subtitle", "time": 27851.11, "timestamp": "07:44:11", "text": "你的直播怎么样？你好。"}, {"type": "subtitle", "time": 27853.43, "timestamp": "07:44:13", "text": "你好。你好。欢迎，兄弟。突袭者队。"}, {"type": "subtitle", "time": 27856.548, "timestamp": "07:44:16", "text": "你好，扎基。但我以为你会"}, {"type": "subtitle", "time": 27858.548, "timestamp": "07:44:18", "text": "就像"}, {"type": "subtitle", "time": 27860.31, "timestamp": "07:44:20", "text": "大学之类的"}, {"type": "subtitle", "time": 27863.35, "timestamp": "07:44:23", "text": "实习之类的。"}, {"type": "subtitle", "time": 27867.27, "timestamp": "07:44:27", "text": "欢迎光临"}, {"type": "subtitle", "time": 27871.75, "timestamp": "07:44:31", "text": "我们的直播。你做了什么？"}, {"type": "subtitle", "time": 27874.708, "timestamp": "07:44:34", "text": "你存钱了吗？"}, {"type": "subtitle", "time": 27880.81, "timestamp": "07:44:40", "text": "嗯"}, {"type": "subtitle", "time": 27884.07, "timestamp": "07:44:44", "text": "[音乐]"}, {"type": "subtitle", "time": 27897.99, "timestamp": "07:44:57", "text": "哇。"}]
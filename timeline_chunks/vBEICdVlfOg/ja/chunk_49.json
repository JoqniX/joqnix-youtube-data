[{"type": "subtitle", "time": 2941.829, "timestamp": "00:49:01", "text": "ええと、わかりました。これで確認してみましょう。"}, {"type": "subtitle", "time": 2951.27, "timestamp": "00:49:11", "text": "ああ、また檻に入れられたんだ。私はそれが必要です。えっと、"}, {"type": "subtitle", "time": 2956.71, "timestamp": "00:49:16", "text": "そしてそれを実行する。"}, {"type": "subtitle", "time": 2960.39, "timestamp": "00:49:20", "text": "えっと、ちょっと待って。"}, {"type": "subtitle", "time": 2963.589, "timestamp": "00:49:23", "text": "待っていてください。"}, {"type": "subtitle", "time": 2970.87, "timestamp": "00:49:30", "text": "立ち往生？"}, {"type": "subtitle", "time": 2974.15, "timestamp": "00:49:34", "text": "ああ、返答しない。そう思った。それは"}, {"type": "subtitle", "time": 2977.03, "timestamp": "00:49:37", "text": "このくだらないものの唯一の問題点"}, {"type": "subtitle", "time": 2980.85, "timestamp": "00:49:40", "text": "私がYTDLPを使用しているとき。"}, {"type": "subtitle", "time": 2999.349, "timestamp": "00:49:59", "text": "そう、私のLPSを直接使うのがショーなんです"}]
[{"type": "subtitle", "time": 480.79, "timestamp": "00:08:00", "text": "ああ、レプチン入りライトグリーンティー。待って、それは"}, {"type": "subtitle", "time": 482.95, "timestamp": "00:08:02", "text": "61ルピー。"}, {"type": "subtitle", "time": 486.39, "timestamp": "00:08:06", "text": "オルガノ・タリシ緑茶。"}, {"type": "subtitle", "time": 488.39, "timestamp": "00:08:08", "text": "ちょっと待って、確認させて。紫色のお茶。待って、"}, {"type": "subtitle", "time": 491.909, "timestamp": "00:08:11", "text": "紫茶とは何ですか？インドの紫色のお茶。"}, {"type": "subtitle", "time": 497.749, "timestamp": "00:08:17", "text": "わかった。ブルーティー。紫色のお茶。 50グラム減量する。"}, {"type": "subtitle", "time": 502.07, "timestamp": "00:08:22", "text": "わかった。紫色のお茶。ダーリンブルーダーリン"}, {"type": "subtitle", "time": 505.67, "timestamp": "00:08:25", "text": "紫色のお茶。抗がん作用。"}, {"type": "subtitle", "time": 508.39, "timestamp": "00:08:28", "text": "視力を改善する。コレステロールを下げ、"}, {"type": "subtitle", "time": 511.909, "timestamp": "00:08:31", "text": "血液、血糖代謝。"}, {"type": "subtitle", "time": 513.909, "timestamp": "00:08:33", "text": "おお、"}, {"type": "subtitle", "time": 516.7090000000001, "timestamp": "00:08:36", "text": "ニース。"}, {"type": "subtitle", "time": 519.509, "timestamp": "00:08:39", "text": "わかった。ナッティは何をしているの？計画中"}, {"type": "subtitle", "time": 527.03, "timestamp": "00:08:47", "text": "ああ、彼はキックの伸展動作をしている。私"}, {"type": "subtitle", "time": 531.829, "timestamp": "00:08:51", "text": "ストリーマーBのことを忘れていました。"}, {"type": "subtitle", "time": 539.91, "timestamp": "00:08:59", "text": "彼の、彼の作品、オーバーレイはとても"}]
[{"type": "subtitle", "time": 28811.67, "timestamp": "08:00:11", "text": "それでも見てください。いまだに理解できない。"}, {"type": "subtitle", "time": 28814.468, "timestamp": "08:00:14", "text": "いまだに理解できない。何が問題なのか"}, {"type": "subtitle", "time": 28822.31, "timestamp": "08:00:22", "text": "ああ、わかりました。"}, {"type": "subtitle", "time": 28824.23, "timestamp": "08:00:24", "text": "動くようになりました。何てことだ。わかった"}, {"type": "subtitle", "time": 28826.628, "timestamp": "08:00:26", "text": "働く。"}, {"type": "subtitle", "time": 28839.91, "timestamp": "08:00:39", "text": "わかった。それで、それで、それで、それで、えっと、これ"}, {"type": "subtitle", "time": 28859.59, "timestamp": "08:00:59", "text": "すごく奇妙で変に見えるよ。正直に"}]
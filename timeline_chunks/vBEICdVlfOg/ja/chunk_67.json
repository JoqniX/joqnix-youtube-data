[{"type": "subtitle", "time": 4023.109, "timestamp": "01:07:03", "text": "こっちの男。"}, {"type": "subtitle", "time": 4026.39, "timestamp": "01:07:06", "text": "わかった。あなたは"}, {"type": "subtitle", "time": 4028.549, "timestamp": "01:07:08", "text": "オリジナルはこの人ですよね？"}, {"type": "subtitle", "time": 4036.549, "timestamp": "01:07:16", "text": "わかった。ええと、これらは必要ありません。わかった。それで、"}, {"type": "subtitle", "time": 4040.23, "timestamp": "01:07:20", "text": "おい、お前をゼロで走らせるぞ。"}, {"type": "subtitle", "time": 4043.19, "timestamp": "01:07:23", "text": "いいえ、50秒です。 50ミリ秒。"}, {"type": "subtitle", "time": 4046.549, "timestamp": "01:07:26", "text": "現状では、こうあるべきです。あなたは"}, {"type": "subtitle", "time": 4053.67, "timestamp": "01:07:33", "text": "パス配列は2,000まで可能です。えっと、これは"}, {"type": "subtitle", "time": 4068.71, "timestamp": "01:07:48", "text": "過去から。"}]
[{"type": "subtitle", "time": 10471.51, "timestamp": "02:54:31", "text": "名前はこうなります。"}, {"type": "subtitle", "time": 10474.63, "timestamp": "02:54:34", "text": "もう一つ入れなければならない"}, {"type": "subtitle", "time": 10476.309, "timestamp": "02:54:36", "text": "ブロック。"}, {"type": "subtitle", "time": 10477.83, "timestamp": "02:54:37", "text": "おお。"}, {"type": "subtitle", "time": 10480.07, "timestamp": "02:54:40", "text": "ある意味では、"}, {"type": "subtitle", "time": 10481.75, "timestamp": "02:54:41", "text": "ポートフォリオ。"}, {"type": "subtitle", "time": 10484.23, "timestamp": "02:54:44", "text": "わからない。"}, {"type": "subtitle", "time": 10486.63, "timestamp": "02:54:46", "text": "ポートフォリオという形で表現できますか？私はしません"}, {"type": "subtitle", "time": 10488.71, "timestamp": "02:54:48", "text": "知る。私はただ場所が欲しかっただけです"}, {"type": "subtitle", "time": 10490.469, "timestamp": "02:54:50", "text": "みんな。"}, {"type": "subtitle", "time": 10492.87, "timestamp": "02:54:52", "text": "私に関する最新情報を入手するには"}, {"type": "subtitle", "time": 10495.03, "timestamp": "02:54:55", "text": "情報に依存するのではなく"}]
[{"type": "subtitle", "time": 29821.75, "timestamp": "08:17:01", "text": "[音楽]"}, {"type": "subtitle", "time": 29824.948, "timestamp": "08:17:04", "text": "よし、いくつか手に入れたぞ。"}, {"type": "subtitle", "time": 29828.07, "timestamp": "08:17:08", "text": "アイテムは3つあります。そこには"}, {"type": "subtitle", "time": 29831.43, "timestamp": "08:17:11", "text": "ヘッダー、アイテム見出し、"}, {"type": "subtitle", "time": 29834.23, "timestamp": "08:17:14", "text": "アイテムテキスト、"}, {"type": "subtitle", "time": 29837.35, "timestamp": "08:17:17", "text": "アイコン、コンテナ、"}, {"type": "subtitle", "time": 29839.59, "timestamp": "08:17:19", "text": "シェブロンアイコン。"}, {"type": "subtitle", "time": 29842.23, "timestamp": "08:17:22", "text": "ああ、そうそう、あのシェブロンアイコンは必要だね。"}, {"type": "subtitle", "time": 29844.31, "timestamp": "08:17:24", "text": "わかった。"}, {"type": "subtitle", "time": 29848.15, "timestamp": "08:17:28", "text": "ああ、考えろ、考えろ、考えろ。"}, {"type": "subtitle", "time": 29851.35, "timestamp": "08:17:31", "text": "考えていたのですが、アイテムの内容があります。"}, {"type": "subtitle", "time": 29861.55, "timestamp": "08:17:41", "text": "はい、アイテムの内容はそこにあります。"}, {"type": "subtitle", "time": 29863.59, "timestamp": "08:17:43", "text": "[音楽]"}]
[{"type": "subtitle", "time": 9968.63, "timestamp": "02:46:08", "text": "ああ、ブロックラベルですね。"}, {"type": "subtitle", "time": 9971.67, "timestamp": "02:46:11", "text": "そうそう。それは何と言っていたのですか？忘れた。"}, {"type": "subtitle", "time": 9973.83, "timestamp": "02:46:13", "text": "うん。これらのタブは重要ではありませんが"}, {"type": "subtitle", "time": 9976.07, "timestamp": "02:46:16", "text": "また私は「今すぐやらなきゃ」と思ったので"}, {"type": "subtitle", "time": 9980.23, "timestamp": "02:46:20", "text": "心配する必要はありません。"}, {"type": "subtitle", "time": 9992.15, "timestamp": "02:46:32", "text": "[音楽]"}, {"type": "subtitle", "time": 10004.79, "timestamp": "02:46:44", "text": "2023年にエネルギーの勢いが再燃 2023"}, {"type": "subtitle", "time": 10010.07, "timestamp": "02:46:50", "text": "後半では、今は先に集中しています。"}, {"type": "subtitle", "time": 10018.82, "timestamp": "02:46:58", "text": "悪意に満ちた希望と導き。"}]
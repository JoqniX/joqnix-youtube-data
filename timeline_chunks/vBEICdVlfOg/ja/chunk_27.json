[{"type": "subtitle", "time": 1621.35, "timestamp": "00:27:01", "text": "アルコールと、ほら、私の"}, {"type": "subtitle", "time": 1625.029, "timestamp": "00:27:05", "text": "臓器とかそういうもの"}, {"type": "subtitle", "time": 1628.63, "timestamp": "00:27:08", "text": "悪い、悪い、だから私はしたくない"}, {"type": "subtitle", "time": 1631.59, "timestamp": "00:27:11", "text": "喫煙や飲酒、その他薬物など"}, {"type": "subtitle", "time": 1634.47, "timestamp": "00:27:14", "text": "薬物も含め、3つすべては禁止されています"}, {"type": "subtitle", "time": 1642.149, "timestamp": "00:27:22", "text": "そして父がそれを行うのを見るたびに"}, {"type": "subtitle", "time": 1644.95, "timestamp": "00:27:24", "text": "いつも「なぜ？」と彼を叱る。何が"}, {"type": "subtitle", "time": 1651.909, "timestamp": "00:27:31", "text": "あなたは疲れるでしょう。あなたはするであろう"}, {"type": "chat", "time": 1655.696, "timestamp": "00:27:35", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "nah nah its like medicine ya dont drink it i dont drink it thats a home remedy for only cases when ya not have other stuff"}, {"type": "subtitle", "time": 1655.75, "timestamp": "00:27:35", "text": "しばらくベッドで安静にしてください。"}, {"type": "subtitle", "time": 1658.07, "timestamp": "00:27:38", "text": "食べる。ガスが発生する"}, {"type": "subtitle", "time": 1660.71, "timestamp": "00:27:40", "text": "胃があって、胃があるでしょう"}, {"type": "subtitle", "time": 1663.029, "timestamp": "00:27:43", "text": "痛みも何もかも。あなたは"}, {"type": "subtitle", "time": 1665.669, "timestamp": "00:27:45", "text": "緊張感とか、そういう全てが。何が"}, {"type": "subtitle", "time": 1668.95, "timestamp": "00:27:48", "text": "ポイント？アルコールを飲むことは何の役にも立たない"}, {"type": "subtitle", "time": 1671.909, "timestamp": "00:27:51", "text": "何でも。それはあなたのお金の問題を解決しますか？"}, {"type": "subtitle", "time": 1674.71, "timestamp": "00:27:54", "text": "問題やその他すべて、悲しみ、"}, {"type": "subtitle", "time": 1677.909, "timestamp": "00:27:57", "text": "もの？いいえ、そうはなりません。起きなければならない"}]
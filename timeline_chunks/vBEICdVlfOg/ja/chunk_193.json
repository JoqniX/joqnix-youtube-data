[{"type": "subtitle", "time": 11623.59, "timestamp": "03:13:43", "text": "ちょっと待って。私は言及しませんでした"}, {"type": "subtitle", "time": 11626.309, "timestamp": "03:13:46", "text": "オネクシア。あなたはそうではないと思いますが、私はできると思います"}, {"type": "subtitle", "time": 11629.349, "timestamp": "03:13:49", "text": "もし私がそう望めば、そうするだろう。"}, {"type": "subtitle", "time": 11631.429, "timestamp": "03:13:51", "text": "それ専用のウェブサイトはありますか？えっと"}]
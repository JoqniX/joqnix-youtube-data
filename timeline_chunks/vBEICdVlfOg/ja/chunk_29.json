[{"type": "subtitle", "time": 1747.669, "timestamp": "00:29:07", "text": "私は人々が苦労しているのを見てきた。医者"}, {"type": "subtitle", "time": 1750.31, "timestamp": "00:29:10", "text": "2つのことをおすすめします。食べない、食べない"}, {"type": "subtitle", "time": 1757.99, "timestamp": "00:29:17", "text": "またはトリミング"}, {"type": "subtitle", "time": 1760.149, "timestamp": "00:29:20", "text": "削除する力。いいえ、私はそうは思いません"}, {"type": "subtitle", "time": 1762.31, "timestamp": "00:29:22", "text": "トリムマットが必要です。あのね？私は持っている"}, {"type": "subtitle", "time": 1764.389, "timestamp": "00:29:24", "text": "一つのアイデア。"}, {"type": "subtitle", "time": 1766.149, "timestamp": "00:29:26", "text": "いい考えがある。アイデアはあなたの"}, {"type": "subtitle", "time": 1770.95, "timestamp": "00:29:30", "text": "人生。えっと、待って。いい考えがある。えっと、"}, {"type": "subtitle", "time": 1777.19, "timestamp": "00:29:37", "text": "えーと、拒否された人たち"}, {"type": "subtitle", "time": 1785.99, "timestamp": "00:29:45", "text": "わかりました、却下されたものをください"}, {"type": "subtitle", "time": 1799.269, "timestamp": "00:29:59", "text": "タイトルと除外"}]
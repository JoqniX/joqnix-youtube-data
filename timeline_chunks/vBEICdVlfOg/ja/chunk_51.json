[{"type": "subtitle", "time": 3068.15, "timestamp": "00:51:08", "text": "はい。うん。抽出したい"}, {"type": "subtitle", "time": 3080.71, "timestamp": "00:51:20", "text": "わかった。印刷する場所"}, {"type": "subtitle", "time": 3087.589, "timestamp": "00:51:27", "text": "おお、"}, {"type": "subtitle", "time": 3090.39, "timestamp": "00:51:30", "text": "ファイルに保存する。ストリームを実行します。待って、待って、"}, {"type": "subtitle", "time": 3092.87, "timestamp": "00:51:32", "text": "待って。これは確認したい。また、"}, {"type": "subtitle", "time": 3101.03, "timestamp": "00:51:41", "text": "いくつかの"}, {"type": "subtitle", "time": 3104.87, "timestamp": "00:51:44", "text": "Cシャープさえ知っていれば、"}, {"type": "subtitle", "time": 3107.349, "timestamp": "00:51:47", "text": "ストリーマーボットでやったけど、私は"}, {"type": "subtitle", "time": 3111.43, "timestamp": "00:51:51", "text": "Cシャープを知っているから、苦痛なんだ。"}, {"type": "subtitle", "time": 3114.549, "timestamp": "00:51:54", "text": "ストリームのバックエンドはどこにありますか？"}, {"type": "subtitle", "time": 3117.91, "timestamp": "00:51:57", "text": "よし、これをすべて一時停止して"}]
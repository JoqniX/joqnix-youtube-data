[{"type": "subtitle", "time": 845.99, "timestamp": "00:14:05", "text": "タイトルを拡張しました。"}, {"type": "subtitle", "time": 849.43, "timestamp": "00:14:09", "text": "私たちは紅茶が好きではありません。だから私は"}, {"type": "subtitle", "time": 851.35, "timestamp": "00:14:11", "text": "コーヒーは最高でしょう。それは良いことです"}, {"type": "subtitle", "time": 853.67, "timestamp": "00:14:13", "text": "あなた。ええ、問題は私がお茶を飲むと"}, {"type": "subtitle", "time": 855.59, "timestamp": "00:14:15", "text": "眠くなってきた。"}, {"type": "chat", "time": 857.622, "timestamp": "00:14:17", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "its a preference na"}, {"type": "subtitle", "time": 858.31, "timestamp": "00:14:18", "text": "それが私の問題なんです。"}, {"type": "subtitle", "time": 861.829, "timestamp": "00:14:21", "text": "紅茶を沸かしている時間です"}, {"type": "chat", "time": 863.44, "timestamp": "00:14:23", "author": "@sadclipy", "avatar": "https://yt4.ggpht.com/NWvAEsOJEb9XkxRRhbuJXnXDMWtc2foWGBwLbBuCxWYqdOpSmqfbtNXfVgmn1YExqB7uWppD9A=s64-c-k-c0x00ffffff-no-rj", "message": "i would drink some green tea some if me sick"}, {"type": "subtitle", "time": 865.35, "timestamp": "00:14:25", "text": "お茶、そしてただ飲むこと。"}, {"type": "subtitle", "time": 868.15, "timestamp": "00:14:28", "text": "そして、ある意味で私はそうやって落ちていくのです"}, {"type": "subtitle", "time": 871.189, "timestamp": "00:14:31", "text": "眠っている。彼"}, {"type": "chat", "time": 877.633, "timestamp": "00:14:37", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "you are talking about milk tea ohh ya drink black tea ?"}, {"type": "chat", "time": 897.309, "timestamp": "00:14:57", "author": "@sadclipy", "avatar": "https://yt4.ggpht.com/NWvAEsOJEb9XkxRRhbuJXnXDMWtc2foWGBwLbBuCxWYqdOpSmqfbtNXfVgmn1YExqB7uWppD9A=s64-c-k-c0x00ffffff-no-rj", "message": "sorry for typos me sleepyyyy"}]
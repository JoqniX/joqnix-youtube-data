[{"type": "subtitle", "time": 3001.67, "timestamp": "00:50:01", "text": "APIを使いたくなかったからです。今"}, {"type": "subtitle", "time": 3006.79, "timestamp": "00:50:06", "text": "API が使えなくなると、トークンが失われます。"}, {"type": "subtitle", "time": 3010.63, "timestamp": "00:50:10", "text": "だから私は「よし、YTLPを使ってみよう」と思ったんです。"}, {"type": "subtitle", "time": 3019.19, "timestamp": "00:50:19", "text": "えーと、"}, {"type": "subtitle", "time": 3021.589, "timestamp": "00:50:21", "text": "ごみ"}, {"type": "subtitle", "time": 3025.67, "timestamp": "00:50:25", "text": "他に選択肢はありますか？ああ、ありがとう"}, {"type": "subtitle", "time": 3036.47, "timestamp": "00:50:36", "text": "よりクリーンな印刷テンプレートシステム"}, {"type": "subtitle", "time": 3039.109, "timestamp": "00:50:39", "text": "合格する必要はありません"}, {"type": "subtitle", "time": 3041.829, "timestamp": "00:50:41", "text": "JSON"}, {"type": "subtitle", "time": 3044.549, "timestamp": "00:50:44", "text": "行のみを出力し、JSONや余分なものは出力しません。"}, {"type": "subtitle", "time": 3046.95, "timestamp": "00:50:46", "text": "データ"}, {"type": "subtitle", "time": 3055.589, "timestamp": "00:50:55", "text": "一貫して確認できる"}]
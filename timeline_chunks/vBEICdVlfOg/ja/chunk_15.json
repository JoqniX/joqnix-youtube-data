[{"type": "subtitle", "time": 909.91, "timestamp": "00:15:09", "text": "もし緑茶を飲むなら"}, {"type": "subtitle", "time": 912.629, "timestamp": "00:15:12", "text": "私たちは病気になる。"}, {"type": "subtitle", "time": 914.87, "timestamp": "00:15:14", "text": "ああ、あなたが言っているのは、ああ、そうだね。の"}, {"type": "subtitle", "time": 917.35, "timestamp": "00:15:17", "text": "うん。そうそう。紅茶を飲む。ええ、私は"}, {"type": "subtitle", "time": 920.55, "timestamp": "00:15:20", "text": "主に紅茶を飲む。お茶ではありません。お茶、"}, {"type": "chat", "time": 924.24, "timestamp": "00:15:24", "author": "@sadclipy", "avatar": "https://yt4.ggpht.com/NWvAEsOJEb9XkxRRhbuJXnXDMWtc2foWGBwLbBuCxWYqdOpSmqfbtNXfVgmn1YExqB7uWppD9A=s64-c-k-c0x00ffffff-no-rj", "message": "black tea?"}, {"type": "chat", "time": 925.379, "timestamp": "00:15:25", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "when sick grind a lil ginger and and put in boiling water let it sit for a min and add half a spoon of honey mix it well it would be really good"}, {"type": "chat", "time": 938.028, "timestamp": "00:15:38", "author": "@sadclipy", "avatar": "https://yt4.ggpht.com/NWvAEsOJEb9XkxRRhbuJXnXDMWtc2foWGBwLbBuCxWYqdOpSmqfbtNXfVgmn1YExqB7uWppD9A=s64-c-k-c0x00ffffff-no-rj", "message": "is it like black coffee?"}, {"type": "subtitle", "time": 939.75, "timestamp": "00:15:39", "text": "ええ、紅茶です。"}, {"type": "subtitle", "time": 943.03, "timestamp": "00:15:43", "text": "水を入れて、お茶を入れる"}, {"type": "subtitle", "time": 945.509, "timestamp": "00:15:45", "text": "あれ、お茶、お茶のリード、お茶"}, {"type": "subtitle", "time": 948.949, "timestamp": "00:15:48", "text": "あれ。それを少し入れて"}, {"type": "chat", "time": 951.08, "timestamp": "00:15:51", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "Darjeeling or Assam?"}, {"type": "subtitle", "time": 953.269, "timestamp": "00:15:53", "text": "それを茹でて、濾す"}, {"type": "subtitle", "time": 957.269, "timestamp": "00:15:57", "text": "そして、あなたはそれを飲む。あれ"}, {"type": "subtitle", "time": 959.189, "timestamp": "00:15:59", "text": "ブラックコーヒーは、"}]
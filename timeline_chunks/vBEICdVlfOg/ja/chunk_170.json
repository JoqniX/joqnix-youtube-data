[{"type": "subtitle", "time": 10202.55, "timestamp": "02:50:02", "text": "必要かつ重要。これを終えました。"}, {"type": "subtitle", "time": 10204.469, "timestamp": "02:50:04", "text": "だから私は同じ形式に従って"}, {"type": "subtitle", "time": 10206.309, "timestamp": "02:50:06", "text": "ガイドライン。"}, {"type": "subtitle", "time": 10208.95, "timestamp": "02:50:08", "text": "私はそれを保管しました"}, {"type": "subtitle", "time": 10213.349, "timestamp": "02:50:13", "text": "えーと、情報のことですね。だから私は"}, {"type": "subtitle", "time": 10215.269, "timestamp": "02:50:15", "text": "やらなきゃいけないこと、えっと、終わった"}, {"type": "subtitle", "time": 10219.03, "timestamp": "02:50:19", "text": "節目となる出来事も同様です。私が何をしたとしても"}, {"type": "subtitle", "time": 10221.429, "timestamp": "02:50:21", "text": "この数年間ずっと"}, {"type": "subtitle", "time": 10225.429, "timestamp": "02:50:25", "text": "そう、だから私はただ私が持っていることをする必要がある"}, {"type": "subtitle", "time": 10228.55, "timestamp": "02:50:28", "text": "あと3ページ作成中です。メディア"}, {"type": "subtitle", "time": 10231.429, "timestamp": "02:50:31", "text": "キット。メディアキットまたはプレスキットが必要です。"}, {"type": "subtitle", "time": 10234.469, "timestamp": "02:50:34", "text": "もし私が申請しているなら"}, {"type": "subtitle", "time": 10236.55, "timestamp": "02:50:36", "text": "スポンサーシップやブランドなど、"}, {"type": "subtitle", "time": 10238.71, "timestamp": "02:50:38", "text": "何でもいいんだよ、そうだろ？だから私は彼らに"}, {"type": "subtitle", "time": 10242.55, "timestamp": "02:50:42", "text": "メディアキットのリンクを確認できるように"}, {"type": "subtitle", "time": 10245.11, "timestamp": "02:50:45", "text": "すべて。メディアで見た"}, {"type": "subtitle", "time": 10247.91, "timestamp": "02:50:47", "text": "キットリンク キットリンクを貼っておきます"}, {"type": "subtitle", "time": 10250.95, "timestamp": "02:50:50", "text": "情報ページ。もしそれがブランドなら"}, {"type": "subtitle", "time": 10253.11, "timestamp": "02:50:53", "text": "またはイベントについて読みたい場合は"}, {"type": "subtitle", "time": 10256.07, "timestamp": "02:50:56", "text": "私、彼らはここでテキストを読むことができます"}, {"type": "subtitle", "time": 10259.83, "timestamp": "02:50:59", "text": "これ。彼らがこれら全てを読みたい場合"}]
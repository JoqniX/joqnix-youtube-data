[{"type": "subtitle", "time": 28261.75, "timestamp": "07:51:01", "text": "そいつだ。そいつだ。その男、"}, {"type": "subtitle", "time": 28264.788, "timestamp": "07:51:04", "text": "神話、伝説。"}, {"type": "subtitle", "time": 28268.31, "timestamp": "07:51:08", "text": "わかった。だから今、私たちは変化を起こさなければならない"}, {"type": "subtitle", "time": 28275.59, "timestamp": "07:51:15", "text": "それに応じて。えっと、この人に今、神を。えっと"}, {"type": "subtitle", "time": 28280.31, "timestamp": "07:51:20", "text": "大きすぎる、大きすぎる。大きすぎる。大きすぎる。それで"}, {"type": "subtitle", "time": 28283.67, "timestamp": "07:51:23", "text": "あなたはそうしなければならない"}, {"type": "subtitle", "time": 28287.51, "timestamp": "07:51:27", "text": "何てことだ。これはちょっと"}, {"type": "subtitle", "time": 28291.59, "timestamp": "07:51:31", "text": "5 DVW 6パーセント。わかった。六"}, {"type": "subtitle", "time": 28306.388, "timestamp": "07:51:46", "text": "M. なぜ大きいのですか？"}, {"type": "subtitle", "time": 28309.8, "timestamp": "07:51:49", "text": "なぜあなたは"}, {"type": "subtitle", "time": 28316.15, "timestamp": "07:51:56", "text": "この男？"}, {"type": "subtitle", "time": 28317.65, "timestamp": "07:51:57", "text": "いいえ。"}]
[{"type": "subtitle", "time": 25744.39, "timestamp": "07:09:04", "text": "2020年のYouTubeからのものを待つ"}, {"type": "subtitle", "time": 25747.91, "timestamp": "07:09:07", "text": "2024年もいつもそうだろう"}, {"type": "subtitle", "time": 25751.59, "timestamp": "07:09:11", "text": "今はつまらない。新しいものを作りたかったから。"}, {"type": "subtitle", "time": 25755.19, "timestamp": "07:09:15", "text": "これらのジョアトンの時計も新しいもの"}, {"type": "subtitle", "time": 25757.51, "timestamp": "07:09:17", "text": "短い流れ。"}, {"type": "subtitle", "time": 25760.07, "timestamp": "07:09:20", "text": "うん。うん。しかし、私は"}, {"type": "subtitle", "time": 25762.868, "timestamp": "07:09:22", "text": "4ヶ月の4ヶ月の始まり"}, {"type": "subtitle", "time": 25766.708, "timestamp": "07:09:26", "text": "ジョアソンは配信している"}, {"type": "subtitle", "time": 25768.868, "timestamp": "07:09:28", "text": "まるで"}, {"type": "subtitle", "time": 25773.03, "timestamp": "07:09:33", "text": "vの中にvの中に3つのvがある、ですよね？"}, {"type": "subtitle", "time": 25775.19, "timestamp": "07:09:35", "text": "私はそれを望んでいません。"}, {"type": "subtitle", "time": 25778.628, "timestamp": "07:09:38", "text": "うん。だから私はただ"}, {"type": "subtitle", "time": 25780.548, "timestamp": "07:09:40", "text": "通常のストリームとプレイリストと"}, {"type": "subtitle", "time": 25783.51, "timestamp": "07:09:43", "text": "YouTubeに関することなら何でも。しかしTwitchと"}, {"type": "subtitle", "time": 25786.39, "timestamp": "07:09:46", "text": "キック、私はそれに集中しています"}, {"type": "subtitle", "time": 25789.11, "timestamp": "07:09:49", "text": "YouTubeに関する目標はすべて達成しました。私"}, {"type": "subtitle", "time": 25791.03, "timestamp": "07:09:51", "text": "YouTubeパートナーのメンバーシップに到達しました"}, {"type": "subtitle", "time": 25793.27, "timestamp": "07:09:53", "text": "そして全て。会員権を取得して"}, {"type": "subtitle", "time": 25795.83, "timestamp": "07:09:55", "text": "スーパーチャットとか、そういうの全部。すべて順調です。"}, {"type": "subtitle", "time": 25797.83, "timestamp": "07:09:57", "text": "完全に収益化済み。"}]
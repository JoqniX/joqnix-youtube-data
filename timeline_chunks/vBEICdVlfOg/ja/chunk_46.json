[{"type": "subtitle", "time": 2761.19, "timestamp": "00:46:01", "text": "YouTubeストリームに基づいたタイトル"}, {"type": "subtitle", "time": 2763.829, "timestamp": "00:46:03", "text": "タイトル。私はそれを模倣したかった。だから私は"}, {"type": "subtitle", "time": 2766.23, "timestamp": "00:46:06", "text": "今すぐ何かをしなければならない。自動化されています"}, {"type": "subtitle", "time": 2768.95, "timestamp": "00:46:08", "text": "どうにか。しかし問題は、"}, {"type": "subtitle", "time": 2770.95, "timestamp": "00:46:10", "text": "タイトルに特定の文字が表示されない"}, {"type": "subtitle", "time": 2773.589, "timestamp": "00:46:13", "text": "私のタイトルから。例えば、私は"}, {"type": "subtitle", "time": 2777.91, "timestamp": "00:46:17", "text": "数字の1の直後の区切り文字"}, {"type": "subtitle", "time": 2779.99, "timestamp": "00:46:19", "text": "132. それは区切り記号のようなもので、"}, {"type": "subtitle", "time": 2782.55, "timestamp": "00:46:22", "text": "右？このコマンドですよね？そうではありません"}, {"type": "subtitle", "time": 2789.46, "timestamp": "00:46:29", "text": "それは奇妙だ。"}, {"type": "subtitle", "time": 2792.55, "timestamp": "00:46:32", "text": "[音楽]"}, {"type": "subtitle", "time": 2800.23, "timestamp": "00:46:40", "text": "直そうとしているんです。"}, {"type": "subtitle", "time": 2802.309, "timestamp": "00:46:42", "text": "実は。"}, {"type": "subtitle", "time": 2817.51, "timestamp": "00:46:57", "text": "[音楽]"}]
[{"type": "subtitle", "time": 2820.79, "timestamp": "00:47:00", "text": "以前は動作していたが、今は動作しない"}, {"type": "subtitle", "time": 2824.47, "timestamp": "00:47:04", "text": "働く。理由がわからない。"}, {"type": "subtitle", "time": 2826.55, "timestamp": "00:47:06", "text": "つまり、2番目のコマンドは私に全体を与えてくれる"}, {"type": "subtitle", "time": 2828.069, "timestamp": "00:47:08", "text": "タイトル"}, {"type": "subtitle", "time": 2830.15, "timestamp": "00:47:10", "text": "すべての"}, {"type": "subtitle", "time": 2834.55, "timestamp": "00:47:14", "text": "ストリームの品質と"}, {"type": "subtitle", "time": 2837.43, "timestamp": "00:47:17", "text": "現場で作業中。ああ、それは私に"}, {"type": "subtitle", "time": 2841.75, "timestamp": "00:47:21", "text": "タイトルは正しいです。わかった。えっと"}, {"type": "subtitle", "time": 2843.43, "timestamp": "00:47:23", "text": "258."}, {"type": "subtitle", "time": 2846.309, "timestamp": "00:47:26", "text": "それはユニコードシンボルです"}, {"type": "subtitle", "time": 2849.99, "timestamp": "00:47:29", "text": "あのキャラクター。わかった。わかった。どうすれば入手できますか"}, {"type": "subtitle", "time": 2853.99, "timestamp": "00:47:33", "text": "これだけ？わかった。待って。"}, {"type": "subtitle", "time": 2856.309, "timestamp": "00:47:36", "text": "えっと"}, {"type": "subtitle", "time": 2858.63, "timestamp": "00:47:38", "text": "行うとき"}, {"type": "subtitle", "time": 2867.51, "timestamp": "00:47:47", "text": "全体を通して。"}]
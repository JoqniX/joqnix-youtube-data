[{"type": "subtitle", "time": 7681.03, "timestamp": "02:08:01", "text": "ウェブサイト関連。そうそう。えーと、ビリーのやつ"}, {"type": "subtitle", "time": 7683.03, "timestamp": "02:08:03", "text": "完了しました。"}, {"type": "subtitle", "time": 7685.99, "timestamp": "02:08:05", "text": "ちょっと言いたかっただけなんです。それでおしまい。"}, {"type": "subtitle", "time": 7700.79, "timestamp": "02:08:20", "text": "わかった。トイレに行って、ちょっと休憩します"}, {"type": "subtitle", "time": 7703.99, "timestamp": "02:08:23", "text": "壊す。必ず来る、必ず戻ってくる。わかった。"}]
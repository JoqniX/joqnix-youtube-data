[{"type": "subtitle", "time": 26112.31, "timestamp": "07:15:12", "text": "何てことだ。コピー。小さな子たちがいます"}, {"type": "subtitle", "time": 26122.868, "timestamp": "07:15:22", "text": "私は大丈夫でいなければならない。だから私はこれが"}, {"type": "subtitle", "time": 26131.43, "timestamp": "07:15:31", "text": "クローズ処理は必要ですか？"}, {"type": "subtitle", "time": 26146.39, "timestamp": "07:15:46", "text": "チャドがそれは悪い考えだと言ったら、私は"}, {"type": "subtitle", "time": 26154.07, "timestamp": "07:15:54", "text": "CL、もちろんです。"}, {"type": "subtitle", "time": 26155.67, "timestamp": "07:15:55", "text": "わかった。"}]
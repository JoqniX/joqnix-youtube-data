[{"type": "subtitle", "time": 4321.189, "timestamp": "01:12:01", "text": "血液型は必須ではありませんが、そうですね。"}, {"type": "subtitle", "time": 4323.43, "timestamp": "01:12:03", "text": "わかった。"}, {"type": "subtitle", "time": 4330.07, "timestamp": "01:12:10", "text": "言語ではない。わかった。言語ではない。"}, {"type": "subtitle", "time": 4332.229, "timestamp": "01:12:12", "text": "言語ではなく言語ではない。私たちができること"}, {"type": "subtitle", "time": 4336.95, "timestamp": "01:12:16", "text": "すべきことは、当社の「会社概要」ページに戻ることです。"}, {"type": "subtitle", "time": 4339.99, "timestamp": "01:12:19", "text": "言語の。"}, {"type": "subtitle", "time": 4347.75, "timestamp": "01:12:27", "text": "[音楽]"}, {"type": "subtitle", "time": 4353.91, "timestamp": "01:12:33", "text": "私は、私が持っていた概要ページから"}, {"type": "subtitle", "time": 4355.99, "timestamp": "01:12:35", "text": "これ"}, {"type": "subtitle", "time": 4371.43, "timestamp": "01:12:51", "text": "えっと、彼の星座をより"}]
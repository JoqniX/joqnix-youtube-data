[{"type": "subtitle", "time": 28565.19, "timestamp": "07:56:05", "text": "えっと"}, {"type": "subtitle", "time": 28577.91, "timestamp": "07:56:17", "text": "これを自動設定にした場合、どうなりますか？"}, {"type": "subtitle", "time": 28581.67, "timestamp": "07:56:21", "text": "ああ、小さくなったね。わかった。わかった。わかった。"}, {"type": "subtitle", "time": 28584.15, "timestamp": "07:56:24", "text": "犯人はあなたです。アスペクト比。私は"}, {"type": "subtitle", "time": 28586.708, "timestamp": "07:56:26", "text": "あなたのために来る"}, {"type": "subtitle", "time": 28589.27, "timestamp": "07:56:29", "text": "必ず迎えに行く。"}, {"type": "subtitle", "time": 28598.948, "timestamp": "07:56:38", "text": "えっと、バックスペース6%。わかった。えっと、私は思う"}, {"type": "subtitle", "time": 28602.388, "timestamp": "07:56:42", "text": "これは幅と高さのことですよね？"}, {"type": "subtitle", "time": 28605.35, "timestamp": "07:56:45", "text": "身長。こんなにたくさん必要ない。"}, {"type": "subtitle", "time": 28609.51, "timestamp": "07:56:49", "text": "でも待って。"}, {"type": "subtitle", "time": 28612.468, "timestamp": "07:56:52", "text": "どうしてもう一人の男、メニューの男が"}, {"type": "subtitle", "time": 28614.31, "timestamp": "07:56:54", "text": "働く？"}, {"type": "subtitle", "time": 28617.27, "timestamp": "07:56:57", "text": "あなたは「ああ、なんてこった、この気難しい"}]
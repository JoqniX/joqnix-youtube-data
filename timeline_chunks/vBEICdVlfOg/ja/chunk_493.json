[{"type": "subtitle", "time": 29582.388, "timestamp": "08:13:02", "text": "シート"}, {"type": "subtitle", "time": 29600.388, "timestamp": "08:13:20", "text": "それは私にとって普遍的なものになるだろう。それで、"}, {"type": "subtitle", "time": 29602.788, "timestamp": "08:13:22", "text": "はい、ユニバーサル目次メニュー、"}, {"type": "subtitle", "time": 29605.43, "timestamp": "08:13:25", "text": "右？それで、"}, {"type": "subtitle", "time": 29608.948, "timestamp": "08:13:28", "text": "ええ、やりますよ。わかった。私が"}, {"type": "subtitle", "time": 29612.388, "timestamp": "08:13:32", "text": "頭の中では、たぶん"}, {"type": "subtitle", "time": 29615.35, "timestamp": "08:13:35", "text": "背景フィルターを追加します。"}, {"type": "subtitle", "time": 29617.59, "timestamp": "08:13:37", "text": "つまり、それがその背後にあるということだ。そうなる"}, {"type": "subtitle", "time": 29620.15, "timestamp": "08:13:40", "text": "ぼやけた"}, {"type": "subtitle", "time": 29621.75, "timestamp": "08:13:41", "text": "の"}, {"type": "subtitle", "time": 29629.27, "timestamp": "08:13:49", "text": "そして、これは掲載しません。うん。うん。のように"}, {"type": "subtitle", "time": 29632.07, "timestamp": "08:13:52", "text": "これ。このような。"}, {"type": "subtitle", "time": 29638.708, "timestamp": "08:13:58", "text": "下にスクロールします。奇妙に見える。ああ神様"}]
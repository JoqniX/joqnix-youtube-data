[{"type": "subtitle", "time": 34200.39, "timestamp": "09:30:00", "text": "タッチ操作のしやすさを考慮してY字型にパッドを入れています。おお"}, {"type": "subtitle", "time": 34203.266, "timestamp": "09:30:03", "text": "ああ、今すぐチェッカーが必要だ。"}, {"type": "subtitle", "time": 34205.586, "timestamp": "09:30:05", "text": "目次のことですよね？私が"}, {"type": "subtitle", "time": 34207.99, "timestamp": "09:30:07", "text": "それをクリックしてください。"}, {"type": "subtitle", "time": 34210.87, "timestamp": "09:30:10", "text": "そうそう。"}, {"type": "subtitle", "time": 34213.51, "timestamp": "09:30:13", "text": "あの男のことをすっかり忘れてた。それ"}, {"type": "subtitle", "time": 34219.426, "timestamp": "09:30:19", "text": "皆さんはどう思いますか？これは待って、"}, {"type": "subtitle", "time": 34222.15, "timestamp": "09:30:22", "text": "待って、待って、待って。確認してみましょう"}, {"type": "subtitle", "time": 34224.31, "timestamp": "09:30:24", "text": "ここから。"}, {"type": "subtitle", "time": 34230.55, "timestamp": "09:30:30", "text": "ということで、通常の目次は"}, {"type": "subtitle", "time": 34234.47, "timestamp": "09:30:34", "text": "ここ。わかった。つまり、唯一の違いは"}, {"type": "subtitle", "time": 34236.71, "timestamp": "09:30:36", "text": "こちらに大きな目次ページがあります。"}, {"type": "subtitle", "time": 34240.39, "timestamp": "09:30:40", "text": "それをクリックすると、これが表示されます。"}, {"type": "subtitle", "time": 34250.23, "timestamp": "09:30:50", "text": "できますが、WT を次の目的で使用することはできません"}, {"type": "subtitle", "time": 34252.95, "timestamp": "09:30:52", "text": "これらの内容に焦点を当てると、"}, {"type": "subtitle", "time": 34256.07, "timestamp": "09:30:56", "text": "奇妙だが、"}, {"type": "subtitle", "time": 34258.95, "timestamp": "09:30:58", "text": "まあ、うまくいったと思う。なぜないのか"}]
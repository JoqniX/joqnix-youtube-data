[{"type": "subtitle", "time": 10141.91, "timestamp": "02:49:01", "text": "そう、こんな感じ。私はそれについて"}, {"type": "subtitle", "time": 10146.469, "timestamp": "02:49:06", "text": "このページはそれ用に作られました。"}, {"type": "subtitle", "time": 10149.429, "timestamp": "02:49:09", "text": "はい、短いビジュアルを作ります"}, {"type": "subtitle", "time": 10151.99, "timestamp": "02:49:11", "text": "こんな感じの要約と、ギャラリーみたいなもの。"}, {"type": "subtitle", "time": 10153.91, "timestamp": "02:49:13", "text": "こうしようと思ったのは"}, {"type": "chat", "time": 10154.181, "timestamp": "02:49:14", "author": "@bakononcopiumm", "avatar": "https://yt4.ggpht.com/hb5sPAHLUD7fBrZZsmfkzISQWwRqI8BY1n8lceyhZz0sNISomD05pCwUe-GL2amD5y-voH_uYw=s64-c-k-c0x00ffffff-no-rj", "message": "oh damn"}, {"type": "subtitle", "time": 10156.55, "timestamp": "02:49:16", "text": "物事について、そして完全な情報があります"}, {"type": "chat", "time": 10158.425, "timestamp": "02:49:18", "author": "@bakononcopiumm", "avatar": "https://yt4.ggpht.com/hb5sPAHLUD7fBrZZsmfkzISQWwRqI8BY1n8lceyhZz0sNISomD05pCwUe-GL2amD5y-voH_uYw=s64-c-k-c0x00ffffff-no-rj", "message": "so its a portfolio"}, {"type": "subtitle", "time": 10158.87, "timestamp": "02:49:18", "text": "で"}, {"type": "subtitle", "time": 10161.19, "timestamp": "02:49:21", "text": "情報ページ。"}, {"type": "subtitle", "time": 10163.19, "timestamp": "02:49:23", "text": "うん。"}, {"type": "subtitle", "time": 10166.07, "timestamp": "02:49:26", "text": "だから、私は現在80％に集中しています"}, {"type": "subtitle", "time": 10170.15, "timestamp": "02:49:30", "text": "フォルダではなく、テキストの内容です。えっと、私は"}, {"type": "subtitle", "time": 10173.83, "timestamp": "02:49:33", "text": "今はテキストの内容に焦点を当てています。えっと"}, {"type": "subtitle", "time": 10178.63, "timestamp": "02:49:38", "text": "それから、ええと、テキストの内容は"}, {"type": "subtitle", "time": 10180.389, "timestamp": "02:49:40", "text": "重要。私はテキストに注目しています"}, {"type": "subtitle", "time": 10182.55, "timestamp": "02:49:42", "text": "コンテンツ。それから"}, {"type": "subtitle", "time": 10185.19, "timestamp": "02:49:45", "text": "ええと、すべてのページが終わったら、"}, {"type": "subtitle", "time": 10188.63, "timestamp": "02:49:48", "text": "デザインについて考えます。"}, {"type": "subtitle", "time": 10191.91, "timestamp": "02:49:51", "text": "ウェブサイト全体の見た目はどうですか？"}, {"type": "subtitle", "time": 10196.469, "timestamp": "02:49:56", "text": "何をすべきか、何をアニメーション化すべきかなど。"}, {"type": "subtitle", "time": 10199.349, "timestamp": "02:49:59", "text": "ガイドラインページを完成させました。"}]
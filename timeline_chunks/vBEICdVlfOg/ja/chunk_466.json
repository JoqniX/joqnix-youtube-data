[{"type": "subtitle", "time": 27960.15, "timestamp": "07:46:00", "text": "これについてブレインストーミングをしましょう。どこに置けばいいですか"}, {"type": "subtitle", "time": 27963.59, "timestamp": "07:46:03", "text": "目次？"}, {"type": "subtitle", "time": 27973.75, "timestamp": "07:46:13", "text": "[音楽]"}, {"type": "subtitle", "time": 27981.43, "timestamp": "07:46:21", "text": "えっと、"}, {"type": "subtitle", "time": 27985.23, "timestamp": "07:46:25", "text": "ここにいる。わかった。待って。凝縮表"}, {"type": "subtitle", "time": 27987.03, "timestamp": "07:46:27", "text": "[音楽]"}, {"type": "subtitle", "time": 27990.23, "timestamp": "07:46:30", "text": "こちらです。あまりにも多すぎるように感じる"}, {"type": "subtitle", "time": 27994.548, "timestamp": "07:46:34", "text": "読むべきものがたくさんありますよね？それで、"}, {"type": "subtitle", "time": 27997.99, "timestamp": "07:46:37", "text": "だから、足りないものは2つあると思う。"}, {"type": "subtitle", "time": 28000.868, "timestamp": "07:46:40", "text": "人々がスクロールアップしているときに、えーっと、"}, {"type": "subtitle", "time": 28004.23, "timestamp": "07:46:44", "text": "ここまで、ここまで到達したい、私は"}, {"type": "subtitle", "time": 28007.03, "timestamp": "07:46:47", "text": "自動的にスクロールするためのボタン"}, {"type": "subtitle", "time": 28011.19, "timestamp": "07:46:51", "text": "頂点まで。それが一つ目です。モバイル向け"}, {"type": "subtitle", "time": 28016.708, "timestamp": "07:46:56", "text": "ユーザーにはメニューシステムのようなものが必要です"}]
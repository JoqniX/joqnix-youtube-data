[{"type": "subtitle", "time": 25080.07, "timestamp": "06:58:00", "text": "例えば、異なる"}, {"type": "subtitle", "time": 25083.03, "timestamp": "06:58:03", "text": "別の州か何か"}, {"type": "subtitle", "time": 25085.11, "timestamp": "06:58:05", "text": "それを1つか何かに分類する"}, {"type": "subtitle", "time": 25087.03, "timestamp": "06:58:07", "text": "わからない"}, {"type": "subtitle", "time": 25089.83, "timestamp": "06:58:09", "text": "例えば、北部の人々、南部の人々"}, {"type": "subtitle", "time": 25093.03, "timestamp": "06:58:13", "text": "そういう人たちを転ばせる"}, {"type": "subtitle", "time": 25094.628, "timestamp": "06:58:14", "text": "外見とその他すべてに基づいて"}, {"type": "subtitle", "time": 25097.27, "timestamp": "06:58:17", "text": "わからないけど、それはよくあることだと思う"}, {"type": "subtitle", "time": 25101.35, "timestamp": "06:58:21", "text": "世界の他の地域も、よくわからない"}, {"type": "subtitle", "time": 25103.83, "timestamp": "06:58:23", "text": "うん"}, {"type": "subtitle", "time": 25105.83, "timestamp": "06:58:25", "text": "私の家族がそれをするとき"}, {"type": "subtitle", "time": 25108.788, "timestamp": "06:58:28", "text": "私は「待って、訂正するよ」って言うだろう"}, {"type": "subtitle", "time": 25111.19, "timestamp": "06:58:31", "text": "日本人を呼んだら大丈夫ですか、"}, {"type": "subtitle", "time": 25113.35, "timestamp": "06:58:33", "text": "韓国人 中国人 私はこう言うだろう ねえ"}, {"type": "subtitle", "time": 25123.67, "timestamp": "06:58:43", "text": "そんな感じ。私は、コルのように、"}, {"type": "subtitle", "time": 25133.43, "timestamp": "06:58:53", "text": "バイソンの皆さん、こんにちは。アメリカバイソン。その"}, {"type": "subtitle", "time": 25136.23, "timestamp": "06:58:56", "text": "久しぶりですね。こんにちは。"}, {"type": "subtitle", "time": 25138.15, "timestamp": "06:58:58", "text": "最後にここに来たのはずいぶん前のことだ。"}]
[{"type": "subtitle", "time": 27841.75, "timestamp": "07:44:01", "text": "はぁ？"}, {"type": "subtitle", "time": 27845.11, "timestamp": "07:44:05", "text": "待てよ、今日は月曜日だぞ。"}, {"type": "subtitle", "time": 27847.19, "timestamp": "07:44:07", "text": "待って、"}, {"type": "subtitle", "time": 27851.11, "timestamp": "07:44:11", "text": "配信はどうでしたか？こんにちは。"}, {"type": "subtitle", "time": 27853.43, "timestamp": "07:44:13", "text": "こんにちは。こんにちは。ようこそ。レイダース。"}, {"type": "subtitle", "time": 27856.548, "timestamp": "07:44:16", "text": "こんにちは、ザキさん。でも、あなたはそう思っていた"}, {"type": "subtitle", "time": 27858.548, "timestamp": "07:44:18", "text": "のように"}, {"type": "subtitle", "time": 27860.31, "timestamp": "07:44:20", "text": "大学とか何か、あるいは"}, {"type": "subtitle", "time": 27863.35, "timestamp": "07:44:23", "text": "インターンシップか何か。"}, {"type": "subtitle", "time": 27867.27, "timestamp": "07:44:27", "text": "ようこそ"}, {"type": "subtitle", "time": 27871.75, "timestamp": "07:44:31", "text": "私たちのストリーム。あなたは何をしたのですか？"}, {"type": "subtitle", "time": 27874.708, "timestamp": "07:44:34", "text": "保存しましたか？"}, {"type": "subtitle", "time": 27880.81, "timestamp": "07:44:40", "text": "えっと"}, {"type": "subtitle", "time": 27884.07, "timestamp": "07:44:44", "text": "[音楽]"}, {"type": "subtitle", "time": 27897.99, "timestamp": "07:44:57", "text": "おお。"}]
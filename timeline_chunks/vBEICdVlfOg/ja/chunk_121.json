[{"type": "subtitle", "time": 7278.55, "timestamp": "02:01:18", "text": "またか。来て。ただ私にください"}, {"type": "subtitle", "time": 7281.589, "timestamp": "02:01:21", "text": "私が"}, {"type": "subtitle", "time": 7284.39, "timestamp": "02:01:24", "text": "バカなことを私に教えてくれればいい"}, {"type": "subtitle", "time": 7297.589, "timestamp": "02:01:37", "text": "私のモデルが動きません。"}, {"type": "subtitle", "time": 7301.35, "timestamp": "02:01:41", "text": "音声が失われてしまいました。"}]
[{"type": "subtitle", "time": 26175.19, "timestamp": "07:16:15", "text": "そしてあなたはこう尋ねるかもしれません、ドクター、"}, {"type": "subtitle", "time": 26177.75, "timestamp": "07:16:17", "text": "では、では、"}, {"type": "subtitle", "time": 26180.15, "timestamp": "07:16:20", "text": "導入？"}, {"type": "subtitle", "time": 26183.27, "timestamp": "07:16:23", "text": "あなたはそれをやっていない。疑問符。"}, {"type": "subtitle", "time": 26194.948, "timestamp": "07:16:34", "text": "あなたも同じ気持ちですか？多分しないだろう"}, {"type": "subtitle", "time": 26197.35, "timestamp": "07:16:37", "text": "まだ2つの逮捕を試みている"}, {"type": "subtitle", "time": 26198.948, "timestamp": "07:16:38", "text": "人生で対処しなければならないことがたくさんある"}, {"type": "subtitle", "time": 26203.03, "timestamp": "07:16:43", "text": "私が戻ってきたとき。こんにちは、"}, {"type": "subtitle", "time": 26205.35, "timestamp": "07:16:45", "text": "人生に集中する。"}, {"type": "subtitle", "time": 26207.83, "timestamp": "07:16:47", "text": "私はいつもここにいます。それで、"}, {"type": "subtitle", "time": 26210.948, "timestamp": "07:16:50", "text": "心配しないで。"}, {"type": "subtitle", "time": 26212.788, "timestamp": "07:16:52", "text": "私にも同じことが起こるでしょう"}, {"type": "subtitle", "time": 26214.708, "timestamp": "07:16:54", "text": "私は日本にいます"}, {"type": "subtitle", "time": 26218.07, "timestamp": "07:16:58", "text": "今この瞬間に集中する。生き残る。私は"}]
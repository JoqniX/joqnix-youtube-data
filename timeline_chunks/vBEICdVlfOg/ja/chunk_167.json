[{"type": "subtitle", "time": 10020.55, "timestamp": "02:47:00", "text": "[音楽]"}, {"type": "subtitle", "time": 10022.55, "timestamp": "02:47:02", "text": "単純。わかった。私はこれが好きです。私は実際に"}, {"type": "subtitle", "time": 10025.429, "timestamp": "02:47:05", "text": "このような。わかった。"}, {"type": "subtitle", "time": 10029.429, "timestamp": "02:47:09", "text": "簡単なプロフィール。えっと"}, {"type": "chat", "time": 10032.177, "timestamp": "02:47:12", "author": "@bakononcopiumm", "avatar": "https://yt4.ggpht.com/hb5sPAHLUD7fBrZZsmfkzISQWwRqI8BY1n8lceyhZz0sNISomD05pCwUe-GL2amD5y-voH_uYw=s64-c-k-c0x00ffffff-no-rj", "message": "whacha doin"}, {"type": "subtitle", "time": 10032.389, "timestamp": "02:47:12", "text": "まとめ。わかった。大丈夫。"}, {"type": "subtitle", "time": 10034.63, "timestamp": "02:47:14", "text": "私はこんな風にやる必要はない。はぁ？"}, {"type": "subtitle", "time": 10038.71, "timestamp": "02:47:18", "text": "わかった。待って。どこにある"}, {"type": "subtitle", "time": 10040.95, "timestamp": "02:47:20", "text": "ああ、そこにいたんだね。"}, {"type": "subtitle", "time": 10044.55, "timestamp": "02:47:24", "text": "情報ページを作成中です"}, {"type": "subtitle", "time": 10047.349, "timestamp": "02:47:27", "text": "より詳細なすべて"}, {"type": "subtitle", "time": 10052.07, "timestamp": "02:47:32", "text": "私がどんな人物か、私の歩み、私の経歴について"}, {"type": "subtitle", "time": 10055.03, "timestamp": "02:47:35", "text": "PNGから私の創造的な進化"}, {"type": "subtitle", "time": 10059.349, "timestamp": "02:47:39", "text": "52D 未来の出来事"}, {"type": "subtitle", "time": 10061.83, "timestamp": "02:47:41", "text": "じゃあ、今後のデビット関連のことですね"}, {"type": "subtitle", "time": 10064.71, "timestamp": "02:47:44", "text": "ストリーミングとメディアでの存在感"}, {"type": "subtitle", "time": 10067.59, "timestamp": "02:47:47", "text": "どこで、どのように、私が何をするか、すべて"}, {"type": "subtitle", "time": 10070.71, "timestamp": "02:47:50", "text": "ストリーミングするプラットフォーム コンテンツは"}, {"type": "subtitle", "time": 10072.469, "timestamp": "02:47:52", "text": "多様化した、"}, {"type": "subtitle", "time": 10076.95, "timestamp": "02:47:56", "text": "スタイル、すべて、言語、そして"}, {"type": "subtitle", "time": 10079.03, "timestamp": "02:47:59", "text": "コミュニティについて。"}]
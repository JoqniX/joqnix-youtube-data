[{"type": "subtitle", "time": 32524.948, "timestamp": "09:02:04", "text": "一体何をやらかしたんだ？"}, {"type": "subtitle", "time": 32529.59, "timestamp": "09:02:09", "text": "待って。なぜこんなに壊れているのか？"}, {"type": "subtitle", "time": 32531.43, "timestamp": "09:02:11", "text": "なんてこった。いいえ、いいえ、いいえ、いいえ、いいえ、いいえ、いいえ、いいえ、"}, {"type": "subtitle", "time": 32534.23, "timestamp": "09:02:14", "text": "いいえ。なぜこんなに壊れているのか？"}, {"type": "subtitle", "time": 32536.23, "timestamp": "09:02:16", "text": "何？"}, {"type": "subtitle", "time": 32539.91, "timestamp": "09:02:19", "text": "私は何をしたの？"}, {"type": "subtitle", "time": 32541.43, "timestamp": "09:02:21", "text": "よし、これはここでうまくいっている。わかった、待って、"}, {"type": "subtitle", "time": 32542.708, "timestamp": "09:02:22", "text": "待って。それは全く別物だ。何か"}, {"type": "subtitle", "time": 32545.11, "timestamp": "09:02:25", "text": "それ以外。何か別のこと。誰だ？誰が"}, {"type": "subtitle", "time": 32546.708, "timestamp": "09:02:26", "text": "犯人は？何てことだ。誰が"}, {"type": "subtitle", "time": 32548.628, "timestamp": "09:02:28", "text": "犯人？"}, {"type": "subtitle", "time": 32575.99, "timestamp": "09:02:55", "text": "そこには何もありませんでした。私は何をしたの？"}, {"type": "subtitle", "time": 32578.308, "timestamp": "09:02:58", "text": "すべてうまくいくはずだった"}]
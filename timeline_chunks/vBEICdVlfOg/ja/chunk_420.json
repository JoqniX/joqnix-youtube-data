[{"type": "subtitle", "time": 25201.91, "timestamp": "07:00:01", "text": "パキスタン関連。それで私は日本に行く予定です"}, {"type": "subtitle", "time": 25205.35, "timestamp": "07:00:05", "text": "えーと、2026年4月。つまり、私は9つ持っているということです。"}, {"type": "subtitle", "time": 25208.948, "timestamp": "07:00:08", "text": "9ヶ月か10ヶ月。そこで私は"}, {"type": "subtitle", "time": 25212.07, "timestamp": "07:00:12", "text": "ジョッカソンイベントは来年まで"}, {"type": "subtitle", "time": 25215.83, "timestamp": "07:00:15", "text": "来年の3月。つまり、それが1年になるということだ"}, {"type": "subtitle", "time": 25218.468, "timestamp": "07:00:18", "text": "3月12日にこれを始めました"}, {"type": "subtitle", "time": 25221.59, "timestamp": "07:00:21", "text": "12時間ずっとやってきた"}, {"type": "subtitle", "time": 25224.548, "timestamp": "07:00:24", "text": "6月から12時間続けています"}, {"type": "subtitle", "time": 25228.468, "timestamp": "07:00:28", "text": "しかし7月以降は7月に変更しました"}, {"type": "subtitle", "time": 25231.19, "timestamp": "07:00:31", "text": "それ以降、私はその形式を変更しました"}, {"type": "subtitle", "time": 25234.31, "timestamp": "07:00:34", "text": "私はストリームに積極的に参加しています"}, {"type": "subtitle", "time": 25237.43, "timestamp": "07:00:37", "text": "YouTube ストリーム Twitch とキックウィル"}, {"type": "subtitle", "time": 25240.31, "timestamp": "07:00:40", "text": "常にボードリレーがあるので停止します"}, {"type": "subtitle", "time": 25242.39, "timestamp": "07:00:42", "text": "これが、この変更点の唯一のものです"}, {"type": "subtitle", "time": 25246.07, "timestamp": "07:00:46", "text": "1か月以降、YouTubeにはVは含まれません"}, {"type": "subtitle", "time": 25248.23, "timestamp": "07:00:48", "text": "リレー。つまり、ストリームは"}, {"type": "subtitle", "time": 25251.67, "timestamp": "07:00:51", "text": "ウィルは24時間ずっとそこにいるわけではありません"}, {"type": "subtitle", "time": 25253.67, "timestamp": "07:00:53", "text": "たとえ私がそこにいなくても、もし私が"}, {"type": "subtitle", "time": 25255.11, "timestamp": "07:00:55", "text": "寝ているとかそんな感じだけど"}]
[{"type": "subtitle", "time": 25141.43, "timestamp": "06:59:01", "text": "ジョックマラソンって何ですか？ドカソン"}, {"type": "subtitle", "time": 25144.788, "timestamp": "06:59:04", "text": "えっと、Twitch にいると思うんだけど、"}, {"type": "subtitle", "time": 25146.708, "timestamp": "06:59:06", "text": "右？ Twitchのパネルに表示されています。"}, {"type": "subtitle", "time": 25149.03, "timestamp": "06:59:09", "text": "下記のTwitchチャンネルを参照してください。私"}, {"type": "subtitle", "time": 25151.35, "timestamp": "06:59:11", "text": "まだウェブサイトのページを作成していません"}, {"type": "subtitle", "time": 25155.99, "timestamp": "06:59:15", "text": "それ。 TLDIA、それはチャンネルイベントみたいなものです"}, {"type": "subtitle", "time": 25160.23, "timestamp": "06:59:20", "text": "私の場合は、えっと、私がやっているのは"}, {"type": "subtitle", "time": 25164.23, "timestamp": "06:59:24", "text": "これはゴラソンだ。それはサブバトンではありません"}, {"type": "subtitle", "time": 25170.548, "timestamp": "06:59:30", "text": "ゴールマラソンでは、ええと、私は"}, {"type": "subtitle", "time": 25173.35, "timestamp": "06:59:33", "text": "完了するまでresのように取得します"}, {"type": "subtitle", "time": 25177.67, "timestamp": "06:59:37", "text": "目標は、えっと、2,000ドルくらいです。"}, {"type": "subtitle", "time": 25180.07, "timestamp": "06:59:40", "text": "VTuberモデルとその他すべて"}, {"type": "subtitle", "time": 25182.628, "timestamp": "06:59:42", "text": "あれらのこと。しかし、最初は"}, {"type": "subtitle", "time": 25186.788, "timestamp": "06:59:46", "text": "今月7月にジョアソンを終えるために"}, {"type": "subtitle", "time": 25189.99, "timestamp": "06:59:49", "text": "本当は"}, {"type": "subtitle", "time": 25193.35, "timestamp": "06:59:53", "text": "えーと日本だけど、できなかったのは"}, {"type": "subtitle", "time": 25195.27, "timestamp": "06:59:55", "text": "吸気は"}, {"type": "subtitle", "time": 25197.67, "timestamp": "06:59:57", "text": "私の国インドで今、政治的な戦争が起きている"}]
[{"type": "subtitle", "time": 29108.07, "timestamp": "08:05:08", "text": "コンデンサー。私はそれをクリックする。私は"}, {"type": "subtitle", "time": 29111.27, "timestamp": "08:05:11", "text": "閉じるボタン。わかった。いいね、いいね、いいね。それで"}, {"type": "subtitle", "time": 29117.35, "timestamp": "08:05:17", "text": "だから、私たちは"}, {"type": "subtitle", "time": 29131.11, "timestamp": "08:05:31", "text": "ディスプレイを置く"}, {"type": "subtitle", "time": 29138.708, "timestamp": "08:05:38", "text": "だから、あなたはそれを見ないのです。"}, {"type": "subtitle", "time": 29141.91, "timestamp": "08:05:41", "text": "そして、そして、そして、そして"}, {"type": "subtitle", "time": 29144.788, "timestamp": "08:05:44", "text": "えっと、ここへ行ってください。"}, {"type": "subtitle", "time": 29146.708, "timestamp": "08:05:46", "text": "彼女は容認する"}, {"type": "subtitle", "time": 29157.43, "timestamp": "08:05:57", "text": "待ち時間なし。"}]
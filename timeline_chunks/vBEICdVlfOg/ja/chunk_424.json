[{"type": "subtitle", "time": 25446.31, "timestamp": "07:04:06", "text": "900ドル、1000ドルなんてありえない。いいえ、私は"}, {"type": "subtitle", "time": 25449.43, "timestamp": "07:04:09", "text": "最低500を保有する"}, {"type": "subtitle", "time": 25452.628, "timestamp": "07:04:12", "text": "分割払い。いや、それは正気の沙汰じゃない。私はしません"}, {"type": "subtitle", "time": 25455.91, "timestamp": "07:04:15", "text": "破壊行為で知られている。"}, {"type": "subtitle", "time": 25458.23, "timestamp": "07:04:18", "text": "だから今のところは、"}, {"type": "subtitle", "time": 25461.35, "timestamp": "07:04:21", "text": "背中の緊張感"}, {"type": "subtitle", "time": 25463.59, "timestamp": "07:04:23", "text": "今のところはバーナーでしのぐ。私はただ自分のやりたいことをやっているだけです"}, {"type": "subtitle", "time": 25471.91, "timestamp": "07:04:31", "text": "メディアのブラックアウトが続いています"}, {"type": "subtitle", "time": 25474.39, "timestamp": "07:04:34", "text": "1年か2年。私は"}, {"type": "subtitle", "time": 25476.788, "timestamp": "07:04:36", "text": "自分の持ち物をチェックしたくなる。ああ、"}, {"type": "subtitle", "time": 25479.83, "timestamp": "07:04:39", "text": "ニース。ニース。お客様のモーターにアクセスする方法"}, {"type": "subtitle", "time": 25495.75, "timestamp": "07:04:55", "text": "ああ、大変だ。"}, {"type": "subtitle", "time": 25498.948, "timestamp": "07:04:58", "text": "私は何をしていたんだろう？うん。"}]
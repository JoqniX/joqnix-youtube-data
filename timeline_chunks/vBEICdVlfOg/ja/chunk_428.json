[{"type": "subtitle", "time": 25680.31, "timestamp": "07:08:00", "text": "音楽など。私は最善を尽くします"}, {"type": "subtitle", "time": 25683.51, "timestamp": "07:08:03", "text": "少なくともカバー曲をリリースする"}, {"type": "subtitle", "time": 25686.23, "timestamp": "07:08:06", "text": "そして音楽に関しては練習します"}, {"type": "subtitle", "time": 25688.23, "timestamp": "07:08:08", "text": "ジョックネスではなく、"}, {"type": "subtitle", "time": 25692.07, "timestamp": "07:08:12", "text": "もう一つのペルソナ、私の音楽的アイデンティティ"}, {"type": "subtitle", "time": 25695.03, "timestamp": "07:08:15", "text": "私はそれをそこで公開しますが、"}, {"type": "subtitle", "time": 25700.23, "timestamp": "07:08:20", "text": "配信でやるのはいいと思うよ"}, {"type": "subtitle", "time": 25702.788, "timestamp": "07:08:22", "text": "ええ、でもいくつか目標があります"}, {"type": "chat", "time": 25703.231, "timestamp": "07:08:23", "author": "@100_American_Bison", "avatar": "https://yt4.ggpht.com/ytc/AIdro_lKufxgoZhsP3D6v3xZCOJXgxro_6vQvpASoQ_BFoacFw=s64-c-k-c0x00ffffff-no-rj", "message": "Ooh I thought you on the “no one can force me to stop so I’m going to keep going”"}, {"type": "subtitle", "time": 25705.59, "timestamp": "07:08:25", "text": "終わりまでにやらなければならないこと"}, {"type": "subtitle", "time": 25709.83, "timestamp": "07:08:29", "text": "3月末までに日本へ行く予定です。"}, {"type": "subtitle", "time": 25711.75, "timestamp": "07:08:31", "text": "うん。"}, {"type": "subtitle", "time": 25719.19, "timestamp": "07:08:39", "text": "私は、あなたが私に強制できるとは思っていませんでした"}, {"type": "subtitle", "time": 25721.11, "timestamp": "07:08:41", "text": "停止。だから、私はこれからも続けていく。私は"}, {"type": "subtitle", "time": 25723.43, "timestamp": "07:08:43", "text": "今もそれを続けている。"}, {"type": "subtitle", "time": 25725.91, "timestamp": "07:08:45", "text": "ただ、私は"}, {"type": "subtitle", "time": 25729.59, "timestamp": "07:08:49", "text": "通常のストリームはボードがないので、いいえ、"}, {"type": "subtitle", "time": 25733.03, "timestamp": "07:08:53", "text": "私がプレイする意味は何ですか"}, {"type": "chat", "time": 25733.701, "timestamp": "07:08:53", "author": "@100_American_Bison", "avatar": "https://yt4.ggpht.com/ytc/AIdro_lKufxgoZhsP3D6v3xZCOJXgxro_6vQvpASoQ_BFoacFw=s64-c-k-c0x00ffffff-no-rj", "message": "Have a good time in Japan "}, {"type": "subtitle", "time": 25734.708, "timestamp": "07:08:54", "text": "2019"}, {"type": "subtitle", "time": 25739.67, "timestamp": "07:08:59", "text": "なんて言うんだっけ？ 20 209"}]
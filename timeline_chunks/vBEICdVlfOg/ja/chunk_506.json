[{"type": "subtitle", "time": 30365.19, "timestamp": "08:26:05", "text": "[音楽]"}, {"type": "subtitle", "time": 30382.468, "timestamp": "08:26:22", "text": "わかった。待って。だからここに置いた"}, {"type": "subtitle", "time": 30395.11, "timestamp": "08:26:35", "text": "どうしてもそうせざるを得なかったんです。何てことだ。わかった、"}, {"type": "subtitle", "time": 30409.67, "timestamp": "08:26:49", "text": "ただ、私たちには必要ないんです"}, {"type": "subtitle", "time": 30414.15, "timestamp": "08:26:54", "text": "このホバーアニメーションを実行するように。"}]
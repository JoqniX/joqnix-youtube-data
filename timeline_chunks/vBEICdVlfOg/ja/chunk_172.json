[{"type": "subtitle", "time": 10320.15, "timestamp": "02:52:00", "text": "視覚的なもの。まだ取り組む必要がある"}, {"type": "subtitle", "time": 10321.75, "timestamp": "02:52:01", "text": "の"}, {"type": "subtitle", "time": 10324.63, "timestamp": "02:52:04", "text": "メインランディングページはこちらです。ここは空です。"}, {"type": "subtitle", "time": 10327.03, "timestamp": "02:52:07", "text": "ここには何もない。"}, {"type": "subtitle", "time": 10329.429, "timestamp": "02:52:09", "text": "私もそうしなければならない。たくさんのもの"}, {"type": "subtitle", "time": 10331.59, "timestamp": "02:52:11", "text": "左。"}, {"type": "subtitle", "time": 10334.79, "timestamp": "02:52:14", "text": "ええ、そうですね。"}, {"type": "subtitle", "time": 10337.99, "timestamp": "02:52:17", "text": "ああ、大変だ。"}, {"type": "subtitle", "time": 10355.349, "timestamp": "02:52:35", "text": "ペルソナプロジェクトの概要とマッチング"}, {"type": "subtitle", "time": 10356.65, "timestamp": "02:52:36", "text": "構造。"}, {"type": "subtitle", "time": 10358.95, "timestamp": "02:52:38", "text": "[音楽]"}]
[{"type": "subtitle", "time": 25621.43, "timestamp": "07:07:01", "text": "ある人は、授業はないと答えた。私"}, {"type": "subtitle", "time": 25625.03, "timestamp": "07:07:05", "text": "そう考えると授業はなくなります"}, {"type": "subtitle", "time": 25627.99, "timestamp": "07:07:07", "text": "それから。階級なんてないと思う。"}, {"type": "subtitle", "time": 25631.19, "timestamp": "07:07:11", "text": "まだ続いていると述べていました"}, {"type": "subtitle", "time": 25638.39, "timestamp": "07:07:18", "text": "最近は、"}, {"type": "subtitle", "time": 25640.628, "timestamp": "07:07:20", "text": "積極的に参加する。"}, {"type": "subtitle", "time": 25642.548, "timestamp": "07:07:22", "text": "つまり、これがこの変更点の唯一の違いです。"}, {"type": "subtitle", "time": 25645.59, "timestamp": "07:07:25", "text": "今月は、これは今月のようなものなので"}, {"type": "subtitle", "time": 25647.99, "timestamp": "07:07:27", "text": "今度はもっと拡張が必要だ。私は"}, {"type": "subtitle", "time": 25652.868, "timestamp": "07:07:32", "text": "7月のジョックマラソンは6月22日のように終了する。私"}, {"type": "subtitle", "time": 25655.27, "timestamp": "07:07:35", "text": "全てを終わらせるはずだったが、私の"}, {"type": "subtitle", "time": 25657.99, "timestamp": "07:07:37", "text": "日本関連の計画は今変更され、"}, {"type": "subtitle", "time": 25661.19, "timestamp": "07:07:41", "text": "2026年4月。"}, {"type": "subtitle", "time": 25664.07, "timestamp": "07:07:44", "text": "そう、延長したから、"}, {"type": "subtitle", "time": 25666.548, "timestamp": "07:07:46", "text": "わかった、ゆっくりやるよ、"}, {"type": "subtitle", "time": 25676.788, "timestamp": "07:07:56", "text": "しかし、3月までにリリースする予定です"}]
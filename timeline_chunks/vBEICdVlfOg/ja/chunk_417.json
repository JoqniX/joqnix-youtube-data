[{"type": "subtitle", "time": 25021.67, "timestamp": "06:57:01", "text": "1つのグループを1つにまとめる何か"}, {"type": "subtitle", "time": 25025.19, "timestamp": "06:57:05", "text": "それは奇妙だ、"}, {"type": "subtitle", "time": 25027.35, "timestamp": "06:57:07", "text": "区別する"}, {"type": "subtitle", "time": 25032.39, "timestamp": "06:57:12", "text": "えーと、アジア人を見ると"}, {"type": "subtitle", "time": 25035.27, "timestamp": "06:57:15", "text": "ああ、そう、それは簡単に気づくことができる"}, {"type": "subtitle", "time": 25038.23, "timestamp": "06:57:18", "text": "さて、もしあなたが日本人と話していたら"}, {"type": "subtitle", "time": 25039.75, "timestamp": "06:57:19", "text": "中国人と話しているなら"}, {"type": "subtitle", "time": 25041.19, "timestamp": "06:57:21", "text": "韓国人と話しているなら"}, {"type": "subtitle", "time": 25044.708, "timestamp": "06:57:24", "text": "同じような人を見たことがあります"}, {"type": "subtitle", "time": 25047.91, "timestamp": "06:57:27", "text": "叔父の中には、一般化して"}, {"type": "subtitle", "time": 25053.75, "timestamp": "06:57:33", "text": "そしてインド国内でも同じことが起こる"}, {"type": "subtitle", "time": 25056.948, "timestamp": "06:57:36", "text": "うん。例えば"}, {"type": "subtitle", "time": 25059.99, "timestamp": "06:57:39", "text": "えーと、例えば、あなたが出身だとしましょう。"}, {"type": "subtitle", "time": 25065.03, "timestamp": "06:57:45", "text": "えーと、ある人が南部出身だとか"}, {"type": "subtitle", "time": 25068.868, "timestamp": "06:57:48", "text": "インド北部で、もし彼らが"}, {"type": "subtitle", "time": 25071.67, "timestamp": "06:57:51", "text": "南から来た人たちと、私が思うに"}, {"type": "subtitle", "time": 25075.51, "timestamp": "06:57:55", "text": "彼らはそれを分類するだろう、当然だ"}, {"type": "subtitle", "time": 25078.15, "timestamp": "06:57:58", "text": "出身地がどこであろうと関係なく"}]
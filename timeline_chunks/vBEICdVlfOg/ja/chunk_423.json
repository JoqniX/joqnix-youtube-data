[{"type": "subtitle", "time": 25382.708, "timestamp": "07:03:02", "text": "モデル関連のものとか、その他諸々。うん、"}, {"type": "subtitle", "time": 25385.91, "timestamp": "07:03:05", "text": "リガーはリギングの準備ができていますが、"}, {"type": "subtitle", "time": 25387.51, "timestamp": "07:03:07", "text": "今はお金がない。だから彼らは"}, {"type": "subtitle", "time": 25390.07, "timestamp": "07:03:10", "text": "ペン。それらは保留中です。"}, {"type": "subtitle", "time": 25391.83, "timestamp": "07:03:11", "text": "そうですね、"}, {"type": "subtitle", "time": 25395.35, "timestamp": "07:03:15", "text": "リリースまたは"}, {"type": "subtitle", "time": 25397.51, "timestamp": "07:03:17", "text": "新しいモデルのシルエットを表示するように、"}, {"type": "subtitle", "time": 25399.75, "timestamp": "07:03:19", "text": "しかし、いくつかの理由でできませんでした"}, {"type": "subtitle", "time": 25402.39, "timestamp": "07:03:22", "text": "舞台裏での複雑な事情、例えば"}, {"type": "subtitle", "time": 25404.468, "timestamp": "07:03:24", "text": "アートワークは少し"}, {"type": "subtitle", "time": 25406.23, "timestamp": "07:03:26", "text": "何かが変わって全てが変わった"}, {"type": "subtitle", "time": 25409.35, "timestamp": "07:03:29", "text": "不正操作は不可能だったため、修正が必要です。"}, {"type": "subtitle", "time": 25411.67, "timestamp": "07:03:31", "text": "そのアート作品はリギングできなかった。だから"}, {"type": "subtitle", "time": 25414.548, "timestamp": "07:03:34", "text": "多くの問題があったが、それらは解決された。今"}, {"type": "subtitle", "time": 25417.27, "timestamp": "07:03:37", "text": "まあ、ある程度は不正操作できると思う。"}, {"type": "subtitle", "time": 25419.35, "timestamp": "07:03:39", "text": "多くの問題を修正し、ポーズ"}, {"type": "subtitle", "time": 25426.708, "timestamp": "07:03:46", "text": "だから、何とかして支払いができればいいなと思っています"}, {"type": "subtitle", "time": 25428.948, "timestamp": "07:03:48", "text": "分割払いか何かで、支払います"}, {"type": "subtitle", "time": 25431.27, "timestamp": "07:03:51", "text": "ライセンスがあればモーターをいじることができます"}, {"type": "subtitle", "time": 25435.11, "timestamp": "07:03:55", "text": "ちょっとだけ払って半分"}, {"type": "subtitle", "time": 25437.51, "timestamp": "07:03:57", "text": "半分くらいか何か"}]
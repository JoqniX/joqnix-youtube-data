[{"type": "subtitle", "time": 25260.788, "timestamp": "07:01:00", "text": "それ。それから、アダム・バビサンさん、ありがとうございます。"}, {"type": "subtitle", "time": 25263.03, "timestamp": "07:01:03", "text": "結局転んでしまいました。"}, {"type": "subtitle", "time": 25265.35, "timestamp": "07:01:05", "text": "スーパーチャット。結局眠ってしまった"}, {"type": "subtitle", "time": 25266.868, "timestamp": "07:01:06", "text": "紐を見ながら。私は"}, {"type": "subtitle", "time": 25268.548, "timestamp": "07:01:08", "text": "ホワイトノイズ。それは私を眠らせてくれます。しないで"}, {"type": "subtitle", "time": 25272.15, "timestamp": "07:01:12", "text": "休息を忘れる。ありがとうございます。"}, {"type": "subtitle", "time": 25275.11, "timestamp": "07:01:15", "text": "そう、それがジョアソンという人物なんです。えっと、"}, {"type": "subtitle", "time": 25279.27, "timestamp": "07:01:19", "text": "方法、最初は私がやりたかった"}, {"type": "subtitle", "time": 25282.788, "timestamp": "07:01:22", "text": "なぜなら、それを証明したかったからです"}, {"type": "subtitle", "time": 25284.39, "timestamp": "07:01:24", "text": "自分自身"}, {"type": "subtitle", "time": 25287.75, "timestamp": "07:01:27", "text": "ええと、新しいモデルにふさわしいものです"}, {"type": "subtitle", "time": 25290.23, "timestamp": "07:01:30", "text": "ええと、新しいモデルで、アートワークは完成しました。の"}, {"type": "subtitle", "time": 25292.868, "timestamp": "07:01:32", "text": "索具の費用は少々高額です。"}, {"type": "subtitle", "time": 25295.99, "timestamp": "07:01:35", "text": "だからライセンス料も払わなければならない"}, {"type": "subtitle", "time": 25298.07, "timestamp": "07:01:38", "text": "他の人が手伝ってくれたので"}, {"type": "subtitle", "time": 25301.43, "timestamp": "07:01:41", "text": "モデルも何もかも。ええ、そうです"}, {"type": "subtitle", "time": 25304.39, "timestamp": "07:01:44", "text": "Joxの公式モデルになる予定です。"}, {"type": "subtitle", "time": 25306.07, "timestamp": "07:01:46", "text": "だから、ライセンス料を払わなければならないし、"}, {"type": "subtitle", "time": 25308.468, "timestamp": "07:01:48", "text": "索具のために。したがって、切り上げられます"}, {"type": "subtitle", "time": 25311.59, "timestamp": "07:01:51", "text": "2,000ドルくらいで、それは"}, {"type": "subtitle", "time": 25314.07, "timestamp": "07:01:54", "text": "今ではかなりの額だ。そしてそれは不可能だ"}, {"type": "subtitle", "time": 25316.628, "timestamp": "07:01:56", "text": "私のような小さなチャンネルにとって"}, {"type": "subtitle", "time": 25318.788, "timestamp": "07:01:58", "text": "今すぐにでも達成したい。そう、それは"}]
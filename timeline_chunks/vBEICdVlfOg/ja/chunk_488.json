[{"type": "subtitle", "time": 29285.35, "timestamp": "08:08:05", "text": "よし、行こう。君ならできるよ。信じる"}, {"type": "subtitle", "time": 29300.948, "timestamp": "08:08:20", "text": "わかった。それで、それで、それで、それで、えっと"}, {"type": "subtitle", "time": 29308.708, "timestamp": "08:08:28", "text": "シートの内容。わかった。"}, {"type": "subtitle", "time": 29320.468, "timestamp": "08:08:40", "text": "そして、これを削除します。"}, {"type": "subtitle", "time": 29337.11, "timestamp": "08:08:57", "text": "ええと、これは必要ありません。"}, {"type": "subtitle", "time": 29339.83, "timestamp": "08:08:59", "text": "これは単なる目次です。それは"}]
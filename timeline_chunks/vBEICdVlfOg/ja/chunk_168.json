[{"type": "subtitle", "time": 10082.63, "timestamp": "02:48:02", "text": "えーと、それからファン関連のもの、"}, {"type": "subtitle", "time": 10084.63, "timestamp": "02:48:04", "text": "残りのリンクなど全て。うん、"}, {"type": "subtitle", "time": 10087.349, "timestamp": "02:48:07", "text": "より詳細な情報"}, {"type": "subtitle", "time": 10089.91, "timestamp": "02:48:09", "text": "ページのことですね。"}, {"type": "subtitle", "time": 10093.51, "timestamp": "02:48:13", "text": "だから、私は「概要」ページを残しておこうと思った。"}, {"type": "subtitle", "time": 10096.15, "timestamp": "02:48:16", "text": "えっと、これはどれですか？すべて削除します"}, {"type": "subtitle", "time": 10099.19, "timestamp": "02:48:19", "text": "これ全部載せるから"}, {"type": "subtitle", "time": 10101.91, "timestamp": "02:48:21", "text": "その情報。私はそれを次のように作ります"}, {"type": "subtitle", "time": 10103.91, "timestamp": "02:48:23", "text": "ちゃんとした"}, {"type": "subtitle", "time": 10106.389, "timestamp": "02:48:26", "text": "えーっと、"}, {"type": "subtitle", "time": 10110.309, "timestamp": "02:48:30", "text": "他のウェブサイトのような簡単なことについて"}, {"type": "subtitle", "time": 10112.95, "timestamp": "02:48:32", "text": "例えば。"}, {"type": "subtitle", "time": 10117.349, "timestamp": "02:48:37", "text": "えっと、またこうやって作ります。見せる"}, {"type": "subtitle", "time": 10119.429, "timestamp": "02:48:39", "text": "ちょっと待って。"}, {"type": "subtitle", "time": 10122.389, "timestamp": "02:48:42", "text": "待っていてください。あなたはすべてを見ました"}, {"type": "subtitle", "time": 10123.83, "timestamp": "02:48:43", "text": "人生とか、そういうこと。今、彼らはそれを手に入れた"}, {"type": "subtitle", "time": 10126.469, "timestamp": "02:48:46", "text": "才能紹介ページ。いいえ、まるで人間のプレビューのようです"}, {"type": "subtitle", "time": 10129.51, "timestamp": "02:48:49", "text": "そして全て。うん。うん。それをください"}, {"type": "subtitle", "time": 10139.99, "timestamp": "02:48:59", "text": "さあ、主よ。"}]
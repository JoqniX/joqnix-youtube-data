[{"type": "subtitle", "time": 24960.708, "timestamp": "06:56:00", "text": "もの。"}, {"type": "subtitle", "time": 24963.59, "timestamp": "06:56:03", "text": "でも、料理は本当に素晴らしいですよ。彼らは好き"}, {"type": "subtitle", "time": 24975.59, "timestamp": "06:56:15", "text": "[音楽]"}, {"type": "subtitle", "time": 24984.548, "timestamp": "06:56:24", "text": "人によっては"}, {"type": "subtitle", "time": 24989.51, "timestamp": "06:56:29", "text": "彼らは、彼らは、彼らは、"}, {"type": "subtitle", "time": 24990.948, "timestamp": "06:56:30", "text": "失礼なことを言っているのかどうかわかりませんが、"}, {"type": "subtitle", "time": 24993.35, "timestamp": "06:56:33", "text": "でも、私がこれを見てきたように"}, {"type": "subtitle", "time": 24998.31, "timestamp": "06:56:38", "text": "人々。彼らがしていることは、彼らが"}, {"type": "subtitle", "time": 25000.15, "timestamp": "06:56:40", "text": "彼らは理解していないようだ"}, {"type": "subtitle", "time": 25003.59, "timestamp": "06:56:43", "text": "例えば、"}, {"type": "subtitle", "time": 25007.43, "timestamp": "06:56:47", "text": "アジア人のグループを見るために"}, {"type": "subtitle", "time": 25010.23, "timestamp": "06:56:50", "text": "例えば韓国人、中国人"}, {"type": "subtitle", "time": 25013.67, "timestamp": "06:56:53", "text": "日本人などは、"}, {"type": "subtitle", "time": 25017.59, "timestamp": "06:56:57", "text": "これは中国語の分類のようなものだ"}]
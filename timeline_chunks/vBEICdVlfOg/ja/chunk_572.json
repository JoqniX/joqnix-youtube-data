[{"type": "subtitle", "time": 34344.55, "timestamp": "09:32:24", "text": "待って、待って、待って、待って。なぜそうなるのか"}, {"type": "subtitle", "time": 34346.87, "timestamp": "09:32:26", "text": "待って、待って。何？何？何？何？"}, {"type": "subtitle", "time": 34349.11, "timestamp": "09:32:29", "text": "何？何？それをクリックすると、自動的に"}, {"type": "subtitle", "time": 34351.906, "timestamp": "09:32:31", "text": "閉じます。待って、待って、待って。何？"}, {"type": "subtitle", "time": 34353.67, "timestamp": "09:32:33", "text": "神様、近すぎて何も見えない"}, {"type": "subtitle", "time": 34357.99, "timestamp": "09:32:37", "text": "ボタンがすごく見えにくいよ、兄弟。わかった。えっと、"}, {"type": "subtitle", "time": 34362.23, "timestamp": "09:32:42", "text": "待って。待てません。このようにすれば、"}, {"type": "subtitle", "time": 34365.426, "timestamp": "09:32:45", "text": "表示されません。閉まらない。あなた"}, {"type": "subtitle", "time": 34368.15, "timestamp": "09:32:48", "text": "それに気づきましたか？これが見えますか？"}, {"type": "subtitle", "time": 34371.586, "timestamp": "09:32:51", "text": "そこには何もありませんでした。見る？見る？見る？見る？見る？"}, {"type": "subtitle", "time": 34374.23, "timestamp": "09:32:54", "text": "スマートフォンをご利用の場合は、こちらをクリックしてください。"}]
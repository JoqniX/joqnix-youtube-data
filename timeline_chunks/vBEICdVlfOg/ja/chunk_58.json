[{"type": "subtitle", "time": 3484.95, "timestamp": "00:58:04", "text": "痛みがひどすぎる。君に言うよ"}, {"type": "subtitle", "time": 3487.27, "timestamp": "00:58:07", "text": "問題は何なのか、もう一方の"}, {"type": "subtitle", "time": 3489.829, "timestamp": "00:58:09", "text": "1つ。わかった。"}, {"type": "subtitle", "time": 3491.43, "timestamp": "00:58:11", "text": "えっと、"}, {"type": "subtitle", "time": 3495.27, "timestamp": "00:58:15", "text": "以前はこうだったのですが、もし私が"}, {"type": "subtitle", "time": 3505.03, "timestamp": "00:58:25", "text": "ああ、くだらないJSONだ。右。これです。だから私は"}, {"type": "subtitle", "time": 3509.109, "timestamp": "00:58:29", "text": "JSONファイル全体を取得します。それは分かります。"}, {"type": "subtitle", "time": 3512.71, "timestamp": "00:58:32", "text": "しかし、ここでの問題は"}, {"type": "subtitle", "time": 3515.67, "timestamp": "00:58:35", "text": "時間がかかるけど、そうじゃない"}, {"type": "subtitle", "time": 3517.91, "timestamp": "00:58:37", "text": "時々通り過ぎる。それが唯一の"}, {"type": "subtitle", "time": 3519.67, "timestamp": "00:58:39", "text": "問題。"}, {"type": "subtitle", "time": 3521.91, "timestamp": "00:58:41", "text": "時々、それは通過せず、私は"}, {"type": "subtitle", "time": 3536.47, "timestamp": "00:58:56", "text": "時間がかかります。"}, {"type": "subtitle", "time": 3539.43, "timestamp": "00:58:59", "text": "待っていてください。"}]
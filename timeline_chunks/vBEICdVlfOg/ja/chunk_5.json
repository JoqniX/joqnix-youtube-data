[{"type": "subtitle", "time": 301.11, "timestamp": "00:05:01", "text": "もっとゴリラを。つまり、1つのストリームは"}, {"type": "subtitle", "time": 304.39, "timestamp": "00:05:04", "text": "例えば、私がプレイしているとします"}, {"type": "subtitle", "time": 306.23, "timestamp": "00:05:06", "text": "そのゲームの頂点を山頂に"}, {"type": "subtitle", "time": 310.629, "timestamp": "00:05:10", "text": "クライミングゲーム、例えばピークノーマルとか"}, {"type": "subtitle", "time": 314.95, "timestamp": "00:05:14", "text": "通常のコンテンツ"}, {"type": "chat", "time": 317.481, "timestamp": "00:05:17", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "like in guest stream becomes guerilla na"}, {"type": "subtitle", "time": 317.59, "timestamp": "00:05:17", "text": "手順はストリームを開始して話すことです"}, {"type": "subtitle", "time": 321.59, "timestamp": "00:05:21", "text": "チャットをゲームに切り替えて、その後"}, {"type": "subtitle", "time": 323.59, "timestamp": "00:05:23", "text": "ゲームを1時間または30分でクリアする"}, {"type": "subtitle", "time": 326.31, "timestamp": "00:05:26", "text": "数分または少なくとも1時間、あなたは話す"}, {"type": "subtitle", "time": 328.469, "timestamp": "00:05:28", "text": "チャットを終了してストリームを閉じます"}, {"type": "subtitle", "time": 330.95, "timestamp": "00:05:30", "text": "ストリームですよね？人々がどのように"}, {"type": "subtitle", "time": 335.43, "timestamp": "00:05:35", "text": "伝統的な最初の方法は"}, {"type": "subtitle", "time": 338.23, "timestamp": "00:05:38", "text": "えっと、ゲーム配信なら、"}, {"type": "subtitle", "time": 340.55, "timestamp": "00:05:40", "text": "ゲームシーン。チャットで話す必要はありません。"}, {"type": "subtitle", "time": 343.59000000000003, "timestamp": "00:05:43", "text": "ゲームを開始し、ストリームを開始し、"}, {"type": "subtitle", "time": 346.23, "timestamp": "00:05:46", "text": "チャットで話したり、ゲームをプレイしたり、"}, {"type": "subtitle", "time": 349.59000000000003, "timestamp": "00:05:49", "text": "ゲーム。会話シーンに切り替える"}, {"type": "subtitle", "time": 352.23, "timestamp": "00:05:52", "text": "必要か、さもなければトークゲームになる"}, {"type": "chat", "time": 352.726, "timestamp": "00:05:52", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "mhm so it comes after"}, {"type": "subtitle", "time": 354.23, "timestamp": "00:05:54", "text": "シーンを撮影してチャットで会話する。人々はこう言っている"}, {"type": "subtitle", "time": 356.55, "timestamp": "00:05:56", "text": "これで完了です。ストリームを終了しています"}, {"type": "subtitle", "time": 359.189, "timestamp": "00:05:59", "text": "そしてストリームを終了すると、"}]
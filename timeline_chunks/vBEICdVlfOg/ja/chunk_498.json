[{"type": "subtitle", "time": 29880.948, "timestamp": "08:18:00", "text": "トリガーを引いたとき、"}, {"type": "subtitle", "time": 29889.75, "timestamp": "08:18:09", "text": "変なのは分かっています。あなたが望んでいることは分かっています"}, {"type": "subtitle", "time": 29892.468, "timestamp": "08:18:12", "text": "変な感じになるのは分かってる"}, {"type": "subtitle", "time": 29895.35, "timestamp": "08:18:15", "text": "でも、信じてください、きっとうまくいきますよ。信じる"}, {"type": "subtitle", "time": 29897.43, "timestamp": "08:18:17", "text": "あなたの"}, {"type": "subtitle", "time": 29912.388, "timestamp": "08:18:32", "text": "それと商品内容を削減します。"}, {"type": "subtitle", "time": 29916.31, "timestamp": "08:18:36", "text": "そこに貼り付けます。"}, {"type": "subtitle", "time": 29918.31, "timestamp": "08:18:38", "text": "うん。うん。うん。ほとんど。それはもうすぐ来る。"}, {"type": "subtitle", "time": 29920.388, "timestamp": "08:18:40", "text": "順調に進んでいます。ゆっくりと近づいている"}, {"type": "subtitle", "time": 29933.51, "timestamp": "08:18:53", "text": "はい。スパンは必要ありません。それを殺せ"}, {"type": "subtitle", "time": 29937.27, "timestamp": "08:18:57", "text": "オフ。うん。うん。ゆっくり。君ならできるよ。"}, {"type": "subtitle", "time": 29939.52, "timestamp": "08:18:59", "text": "君ならできるよ。 これは何ですか？ええ、そうです。"}]
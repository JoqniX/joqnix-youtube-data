[{"type": "subtitle", "time": 28500.07, "timestamp": "07:55:00", "text": "ロシアのように。いいえ、でもなぜこのボタンは"}, {"type": "subtitle", "time": 28502.948, "timestamp": "07:55:02", "text": "大きい？"}, {"type": "subtitle", "time": 28523.27, "timestamp": "07:55:23", "text": "私は法律上、盲人ですか？何か見落としているのでしょうか？"}, {"type": "subtitle", "time": 28525.59, "timestamp": "07:55:25", "text": "ここに何かある？"}, {"type": "subtitle", "time": 28529.43, "timestamp": "07:55:29", "text": "そこはどうして狭いのですか？"}, {"type": "subtitle", "time": 28532.708, "timestamp": "07:55:32", "text": "でも、すごく大きくなると、こうなるんだ。"}, {"type": "subtitle", "time": 28535.83, "timestamp": "07:55:35", "text": "「ああ、俺は大きくなりたいんだ。」"}, {"type": "subtitle", "time": 28549.51, "timestamp": "07:55:49", "text": "よし、じゃあ全部ゼロにしよう。"}, {"type": "subtitle", "time": 28557.99, "timestamp": "07:55:57", "text": "ポジションコインのようなものだと感じます。"}]
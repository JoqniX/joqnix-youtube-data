[{"type": "subtitle", "time": 4267.189, "timestamp": "01:11:07", "text": "我會去……呃，修復……呃，處理我的網站相關事宜。"}, {"type": "subtitle", "time": 4270.95, "timestamp": "01:11:10", "text": "好了，我做完了。好了，我們"}, {"type": "subtitle", "time": 4273.189, "timestamp": "01:11:13", "text": "結束了。"}, {"type": "subtitle", "time": 4276.229, "timestamp": "01:11:16", "text": "我在這裡添加了單獨的場景"}, {"type": "subtitle", "time": 4277.99, "timestamp": "01:11:17", "text": "。"}, {"type": "subtitle", "time": 4281.43, "timestamp": "01:11:21", "text": "在背景中。我的背景資料。"}, {"type": "subtitle", "time": 4285.03, "timestamp": "01:11:25", "text": "還剩下什麼呢？我們需要開展"}, {"type": "subtitle", "time": 4287.43, "timestamp": "01:11:27", "text": "粉絲基礎支援方面的業務聯繫。"}, {"type": "subtitle", "time": 4290.39, "timestamp": "01:11:30", "text": "好的。呃，我還需要把這裡的表情符號刪掉"}, {"type": "subtitle", "time": 4305.03, "timestamp": "01:11:45", "text": "其他方面看起來都不錯。我們回到"}, {"type": "subtitle", "time": 4308.07, "timestamp": "01:11:48", "text": "了資訊頁面。我們只需要"}, {"type": "subtitle", "time": 4311.189, "timestamp": "01:11:51", "text": "添加關於頁面之類的東西就行了，對吧？"}, {"type": "subtitle", "time": 4315.669, "timestamp": "01:11:55", "text": "例如，我的身高是多少，諸如此類的問題"}, {"type": "subtitle", "time": 4318.47, "timestamp": "01:11:58", "text": "，對吧？血型，其實不需要寫那麼"}]
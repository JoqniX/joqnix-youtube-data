[{"type": "subtitle", "time": 2761.19, "timestamp": "00:46:01", "text": "根據 YouTube 直播標題動態地更改 Twitch 和踢人標題"}, {"type": "subtitle", "time": 2763.829, "timestamp": "00:46:03", "text": "。我想模仿它。所以我"}, {"type": "subtitle", "time": 2766.23, "timestamp": "00:46:06", "text": "現在什麼都不用做。它是自動化的"}, {"type": "subtitle", "time": 2768.95, "timestamp": "00:46:08", "text": "。但問題是，有時"}, {"type": "subtitle", "time": 2770.95, "timestamp": "00:46:10", "text": "標題無法取得"}, {"type": "subtitle", "time": 2773.589, "timestamp": "00:46:13", "text": "我標題中的某些字元。例如，我在"}, {"type": "subtitle", "time": 2777.91, "timestamp": "00:46:17", "text": "數字 1 到 132 後面加了一個分隔符號。"}, {"type": "subtitle", "time": 2779.99, "timestamp": "00:46:19", "text": "那就像一個分隔符號圖標，"}, {"type": "subtitle", "time": 2782.55, "timestamp": "00:46:22", "text": "對吧？這條命令，對吧？它並沒有"}, {"type": "subtitle", "time": 2789.46, "timestamp": "00:46:29", "text": "奇怪。"}, {"type": "subtitle", "time": 2792.55, "timestamp": "00:46:32", "text": "[音樂]"}]
[{"type": "subtitle", "time": 1651.909, "timestamp": "00:27:31", "text": "你知道，那樣會讓我身體的器官變得很糟糕，所以我不想抽煙、喝酒，也不想吸毒，甚至吸毒，這三樣東西在我看來都是絕對禁止的。每次看到我爸爸這樣做，我都會責備他，問他為什麼？這樣做的目的是什麼？  你會很累。"}, {"type": "chat", "time": 1655.696, "timestamp": "00:27:35", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "nah nah its like medicine ya dont drink it i dont drink it thats a home remedy for only cases when ya not have other stuff"}, {"type": "subtitle", "time": 1655.75, "timestamp": "00:27:35", "text": "因為不能進食，所以你需要臥床休息一段時間"}, {"type": "subtitle", "time": 1658.07, "timestamp": "00:27:38", "text": "。你胃裡會產生氣體，"}, {"type": "subtitle", "time": 1660.71, "timestamp": "00:27:40", "text": "還會出現"}, {"type": "subtitle", "time": 1663.029, "timestamp": "00:27:43", "text": "胃痛等症狀。你現在很緊張，各種情緒交織在一起。這樣做有"}, {"type": "subtitle", "time": 1665.669, "timestamp": "00:27:45", "text": "什麼"}, {"type": "subtitle", "time": 1668.95, "timestamp": "00:27:48", "text": "意義？喝酒對任何事情都沒有幫助"}, {"type": "subtitle", "time": 1671.909, "timestamp": "00:27:51", "text": "。它能解決你的金錢"}, {"type": "subtitle", "time": 1674.71, "timestamp": "00:27:54", "text": "問題、悲傷之類的所有事情嗎"}, {"type": "subtitle", "time": 1677.909, "timestamp": "00:27:57", "text": "？不，不會。你第二天還得起床"}]
[{"type": "subtitle", "time": 314.95, "timestamp": "00:05:14", "text": "問題。  我看到越來越多的 YouTuber 嘗試模仿大猩猩。這意味著一個直播串流會包含例如我在玩登山遊戲 Peak 之類的內容，例如 Peak 普通模式，嗯，我們內容"}, {"type": "chat", "time": 317.481, "timestamp": "00:05:17", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "like in guest stream becomes guerilla na"}, {"type": "subtitle", "time": 317.59, "timestamp": "00:05:17", "text": "流程是：開始直播，和"}, {"type": "subtitle", "time": 321.59, "timestamp": "00:05:21", "text": "你的聊天室互動，切換到遊戲，"}, {"type": "subtitle", "time": 323.59, "timestamp": "00:05:23", "text": "遊戲結束後（至少 1 小時或 30"}, {"type": "subtitle", "time": 326.31, "timestamp": "00:05:26", "text": "分鐘），和"}, {"type": "subtitle", "time": 328.469, "timestamp": "00:05:28", "text": "聊天室互動，然後結束直播並關閉"}, {"type": "subtitle", "time": 330.95, "timestamp": "00:05:30", "text": "直播，對吧？有些人採用的"}, {"type": "subtitle", "time": 335.43, "timestamp": "00:05:35", "text": "傳統方法是，"}, {"type": "subtitle", "time": 338.23, "timestamp": "00:05:38", "text": "如果是遊戲直播，就從"}, {"type": "subtitle", "time": 340.55, "timestamp": "00:05:40", "text": "遊戲場景開始。你不跟聊天對象說話。"}, {"type": "subtitle", "time": 343.59000000000003, "timestamp": "00:05:43", "text": "你開始遊戲，開始直播，"}, {"type": "subtitle", "time": 346.23, "timestamp": "00:05:46", "text": "與聊天室互動，玩遊戲，結束"}, {"type": "subtitle", "time": 349.59000000000003, "timestamp": "00:05:49", "text": "遊戲。呃，如果需要的話，切換到對話場景，"}, {"type": "subtitle", "time": 352.23, "timestamp": "00:05:52", "text": "否則就在遊戲"}, {"type": "chat", "time": 352.726, "timestamp": "00:05:52", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "mhm so it comes after"}, {"type": "subtitle", "time": 354.23, "timestamp": "00:05:54", "text": "場景中與聊天對象交談。那些人說"}, {"type": "subtitle", "time": 356.55, "timestamp": "00:05:56", "text": "你已經完成了。你的直播結束了，"}, {"type": "subtitle", "time": 359.189, "timestamp": "00:05:59", "text": "而且你結束直播的"}]
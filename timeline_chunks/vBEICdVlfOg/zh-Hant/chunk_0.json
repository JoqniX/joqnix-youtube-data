[{"type": "subtitle", "time": 23.269, "timestamp": "00:00:23", "text": "歡迎"}, {"type": "subtitle", "time": 29.029, "timestamp": "00:00:29", "text": "來到Jakadon第132天。歡迎Don。"}, {"type": "subtitle", "time": 31.269, "timestamp": "00:00:31", "text": "歡迎。"}, {"type": "subtitle", "time": 35.83, "timestamp": "00:00:35", "text": "嗨，我是 Jok。上一期"}, {"type": "subtitle", "time": 37.91, "timestamp": "00:00:37", "text": "節目已經結束了。"}, {"type": "subtitle", "time": 42.15, "timestamp": "00:00:42", "text": "這次我們要做一些網站相關的工作。那麼，我們就開始吧。開始吧"}, {"type": "subtitle", "time": 45.59, "timestamp": "00:00:45", "text": "。讓我們"}, {"type": "subtitle", "time": 47.99, "timestamp": "00:00:47", "text": "盡力而為。把這玩意兒弄完。把我的"}, {"type": "subtitle", "time": 50.95, "timestamp": "00:00:50", "text": "自傳，以及我正在做的任何事都搞定"}, {"type": "subtitle", "time": 54.35, "timestamp": "00:00:54", "text": "。他"}, {"type": "subtitle", "time": 55.91, "timestamp": "00:00:55", "text": "（音樂）"}, {"type": "subtitle", "time": 57.67, "timestamp": "00:00:57", "text": "kazoi"}]
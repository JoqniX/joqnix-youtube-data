[{"type": "subtitle", "time": 480.79, "timestamp": "00:08:00", "text": "哦，瘦素綠茶淡味。等等，是"}, {"type": "subtitle", "time": 482.95, "timestamp": "00:08:02", "text": "61盧比。"}, {"type": "subtitle", "time": 486.39, "timestamp": "00:08:06", "text": "Organo talisi 綠茶。"}, {"type": "subtitle", "time": 488.39, "timestamp": "00:08:08", "text": "等等，讓我查一下。紫茶。等等，"}, {"type": "subtitle", "time": 491.909, "timestamp": "00:08:11", "text": "紫茶是什麼？印度的紫茶。"}, {"type": "subtitle", "time": 497.749, "timestamp": "00:08:17", "text": "好的。藍色茶。紫茶。減重50公克。"}, {"type": "subtitle", "time": 502.07, "timestamp": "00:08:22", "text": "好的。紫茶。親愛的藍色，親愛的"}, {"type": "subtitle", "time": 505.67, "timestamp": "00:08:25", "text": "紫色茶。抗癌功效。"}, {"type": "subtitle", "time": 508.39, "timestamp": "00:08:28", "text": "改善視力。降低膽固醇和"}, {"type": "subtitle", "time": 511.909, "timestamp": "00:08:31", "text": "血糖代謝。"}, {"type": "subtitle", "time": 513.909, "timestamp": "00:08:33", "text": "哦，"}, {"type": "subtitle", "time": 516.7090000000001, "timestamp": "00:08:36", "text": "不錯。"}, {"type": "subtitle", "time": 519.509, "timestamp": "00:08:39", "text": "好的。納蒂在幹嘛？計劃推出一些"}, {"type": "subtitle", "time": 527.03, "timestamp": "00:08:47", "text": "哦，是的，他正在做踢腿延伸動作。我"}, {"type": "subtitle", "time": 531.829, "timestamp": "00:08:51", "text": "忘了打電話給主播B了。"}, {"type": "subtitle", "time": 539.91, "timestamp": "00:08:59", "text": "他的作品，尤其是那個疊加層，設計得如此"}]
[{"type": "chat", "time": 361.253, "timestamp": "00:06:01", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "or continue"}, {"type": "subtitle", "time": 361.83, "timestamp": "00:06:01", "text": "方式就像大猩猩一樣，"}, {"type": "subtitle", "time": 363.67, "timestamp": "00:06:03", "text": "毫無計劃。你還沒有計劃好"}, {"type": "subtitle", "time": 366.469, "timestamp": "00:06:06", "text": "要做什麼。一切都……呃，"}, {"type": "subtitle", "time": 368.309, "timestamp": "00:06:08", "text": "你只是在隨性發揮。"}, {"type": "subtitle", "time": 372.71, "timestamp": "00:06:12", "text": "大猩猩所具備的一切特質。是的。 「Gorilla"}, {"type": "subtitle", "time": 374.79, "timestamp": "00:06:14", "text": "stream」指的是未經計畫、"}, {"type": "subtitle", "time": 378.309, "timestamp": "00:06:18", "text": "沒有安排的直播。"}, {"type": "chat", "time": 378.87, "timestamp": "00:06:18", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "I messed up againUCdZBnUb7m8Pd_wUTDNqUu3Q/f3TlZ8_8KpS3_9EP-duW6Qo"}, {"type": "subtitle", "time": 379.51, "timestamp": "00:06:19", "text": "是的。你不知道自己接下來"}, {"type": "subtitle", "time": 382.55, "timestamp": "00:06:22", "text": "要做什麼。你要現場即興發揮。  是的"}, {"type": "subtitle", "time": 385.11, "timestamp": "00:06:25", "text": "。那真是太好了。我做的更像是"}, {"type": "subtitle", "time": 387.59, "timestamp": "00:06:27", "text": "大猩猩才會做的事。所有這些運動馬拉松"}, {"type": "subtitle", "time": 390.309, "timestamp": "00:06:30", "text": "直播都更像是大猩猩。我原本想制定"}, {"type": "subtitle", "time": 394.15, "timestamp": "00:06:34", "text": "一個固定的時間表，例如在某個特定"}, {"type": "subtitle", "time": 396.39, "timestamp": "00:06:36", "text": "日期做這件事。在某些時期，"}, {"type": "subtitle", "time": 398.71, "timestamp": "00:06:38", "text": "我會做這個、做那個，但我"}, {"type": "subtitle", "time": 401.189, "timestamp": "00:06:41", "text": "無法堅持下去。不，"}, {"type": "subtitle", "time": 403.749, "timestamp": "00:06:43", "text": "所以我才說，嗯，我現在不會制定固定"}, {"type": "subtitle", "time": 407.43, "timestamp": "00:06:47", "text": "時間表。我會隨心所欲地做"}, {"type": "subtitle", "time": 409.83, "timestamp": "00:06:49", "text": "任何事，如果我想玩"}, {"type": "subtitle", "time": 413.029, "timestamp": "00:06:53", "text": "遊戲，如果我想玩……"}, {"type": "subtitle", "time": 416.23, "timestamp": "00:06:56", "text": "嗯，我們正在做工作，我會做那個。"}]
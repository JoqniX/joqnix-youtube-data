[{"type": "subtitle", "time": 6487.35, "timestamp": "01:48:07", "text": "哦，不错的方块，Mag。"}, {"type": "subtitle", "time": 6491.03, "timestamp": "01:48:11", "text": "加油，兄弟。爽！"}, {"type": "subtitle", "time": 6492.95, "timestamp": "01:48:12", "text": "回来。哦，是的。过来。哦。哦。"}, {"type": "subtitle", "time": 6497.99, "timestamp": "01:48:17", "text": "哦。得到。好的。小子，干掉他。"}, {"type": "subtitle", "time": 6501.03, "timestamp": "01:48:21", "text": "哦，他只有一次机会。"}, {"type": "subtitle", "time": 6503.99, "timestamp": "01:48:23", "text": "繁荣。砰！抓住他。我不能"}, {"type": "subtitle", "time": 6506.39, "timestamp": "01:48:26", "text": "枪法烂到家了。"}, {"type": "subtitle", "time": 6510.79, "timestamp": "01:48:30", "text": "60帧/秒。我该如何瞄准？"}, {"type": "subtitle", "time": 6512.629, "timestamp": "01:48:32", "text": "哦，该死。"}, {"type": "subtitle", "time": 6515.75, "timestamp": "01:48:35", "text": "虽然他在撒谎。"}, {"type": "subtitle", "time": 6518.31, "timestamp": "01:48:38", "text": "乐意效劳，伙伴。我要去"}, {"type": "subtitle", "time": 6521.27, "timestamp": "01:48:41", "text": "把他叫过来。"}, {"type": "subtitle", "time": 6522.87, "timestamp": "01:48:42", "text": "哦，"}, {"type": "subtitle", "time": 6535.75, "timestamp": "01:48:55", "text": "[音乐]"}, {"type": "subtitle", "time": 6538.07, "timestamp": "01:48:58", "text": "好的。最上面那家伙到底是谁？很多"}, {"type": "subtitle", "time": 6539.91, "timestamp": "01:48:59", "text": "更好的。"}]
[{"type": "subtitle", "time": 5282.31, "timestamp": "01:28:02", "text": "做过。"}, {"type": "subtitle", "time": 5284.709, "timestamp": "01:28:04", "text": "TF2绝不会放过这个机会。我不是"}, {"type": "subtitle", "time": 5292.55, "timestamp": "01:28:12", "text": "我们仍然有重点。"}, {"type": "subtitle", "time": 5295.669, "timestamp": "01:28:15", "text": "我们知道我们没有。当然。蜘蛛侠，你呢？"}, {"type": "subtitle", "time": 5297.03, "timestamp": "01:28:17", "text": "有点事儿，伙计。快点。你们排在第三位"}, {"type": "subtitle", "time": 5299.189, "timestamp": "01:28:19", "text": "一。加油，蜘蛛侠。做 做"}, {"type": "subtitle", "time": 5300.709, "timestamp": "01:28:20", "text": "有趣的。"}, {"type": "subtitle", "time": 5302.31, "timestamp": "01:28:22", "text": "这是蜘蛛吗？这是蜘蛛侠吗？"}, {"type": "subtitle", "time": 5309.83, "timestamp": "01:28:29", "text": "我要抓住他。他没有"}, {"type": "subtitle", "time": 5311.27, "timestamp": "01:28:31", "text": "伙计，我不会去抓他。我的天哪。"}, {"type": "subtitle", "time": 5313.28, "timestamp": "01:28:33", "text": "我的天哪。 我的天哪。"}, {"type": "subtitle", "time": 5326.31, "timestamp": "01:28:46", "text": "我现在就去拿。"}, {"type": "subtitle", "time": 5328.629, "timestamp": "01:28:48", "text": "哦，明白了。哦，"}, {"type": "subtitle", "time": 5330.229, "timestamp": "01:28:50", "text": "失败的。没关系。我没明白。哦，"}, {"type": "subtitle", "time": 5333.11, "timestamp": "01:28:53", "text": "我拿到工资了。"}, {"type": "subtitle", "time": 5335.11, "timestamp": "01:28:55", "text": "看得出来你不住在德里。失败"}, {"type": "subtitle", "time": 5336.629, "timestamp": "01:28:56", "text": "绑架未遂。来"}]
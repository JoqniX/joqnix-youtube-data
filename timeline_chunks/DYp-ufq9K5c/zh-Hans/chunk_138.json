[{"type": "subtitle", "time": 8281.429, "timestamp": "02:18:01", "text": "或许可以。是的。正确的。我得了六个"}, {"type": "subtitle", "time": 8284.03, "timestamp": "02:18:04", "text": "350 健康值。你知道这一点。是的，"}, {"type": "subtitle", "time": 8287.669, "timestamp": "02:18:07", "text": "确切地。我们可以再生之类的。"}, {"type": "subtitle", "time": 8290.549, "timestamp": "02:18:10", "text": "哦，是的。是的。是的。是的。我希望如此"}, {"type": "subtitle", "time": 8293.83, "timestamp": "02:18:13", "text": "游戏中也有类似被动治疗的机制。"}, {"type": "subtitle", "time": 8295.75, "timestamp": "02:18:15", "text": "哦，至于金刚狼，他们肯定"}, {"type": "subtitle", "time": 8297.19, "timestamp": "02:18:17", "text": "我应该有那个的。但我没有"}, {"type": "subtitle", "time": 8299.83, "timestamp": "02:18:19", "text": "知道。平衡性可能有点差强人意。"}, {"type": "subtitle", "time": 8302.549, "timestamp": "02:18:22", "text": "如果真是那样，为什么？放慢点儿，你"}, {"type": "subtitle", "time": 8305.589, "timestamp": "02:18:25", "text": "知道？就像放慢速度一样"}, {"type": "subtitle", "time": 8309.589, "timestamp": "02:18:29", "text": "然后我就不知道了，伙计。因为就像你一样"}, {"type": "subtitle", "time": 8312.309, "timestamp": "02:18:32", "text": "了解《守望先锋2》的被动治疗机制"}, {"type": "subtitle", "time": 8314.87, "timestamp": "02:18:34", "text": "对所有人而言？就像每一个"}, {"type": "subtitle", "time": 8317.03, "timestamp": "02:18:37", "text": "单身人士？"}, {"type": "subtitle", "time": 8320.23, "timestamp": "02:18:40", "text": "无论你是治疗、输出还是坦克"}, {"type": "subtitle", "time": 8323.429, "timestamp": "02:18:43", "text": "DPS这玩意儿真不错。我不知道，"}, {"type": "subtitle", "time": 8326.549, "timestamp": "02:18:46", "text": "男人。我真他妈讨厌这一点。我讨厌那样。"}, {"type": "subtitle", "time": 8328.549, "timestamp": "02:18:48", "text": "喜欢"}, {"type": "subtitle", "time": 8330.389, "timestamp": "02:18:50", "text": "就像原版《守望先锋》那样，对吧？"}, {"type": "subtitle", "time": 8333.549, "timestamp": "02:18:53", "text": "只有治疗者才能获得被动技能。"}, {"type": "subtitle", "time": 8336.07, "timestamp": "02:18:56", "text": "治愈，正是这一点让他们喜欢"}, {"type": "subtitle", "time": 8338.87, "timestamp": "02:18:58", "text": "很特别，对吧？逃脱了。如果每个人"}]
[{"type": "subtitle", "time": 6184.47, "timestamp": "01:43:04", "text": "他们来自那里。悟空的休息。"}, {"type": "subtitle", "time": 6186.39, "timestamp": "01:43:06", "text": "哦。哦。哦。回到这里。还有四个"}, {"type": "subtitle", "time": 6187.75, "timestamp": "01:43:07", "text": "向上。还有四个。还有四个。我们开始吧"}, {"type": "subtitle", "time": 6190.87, "timestamp": "01:43:10", "text": "去。用激光射他的屁股。老兄，他是怎么做到的？"}, {"type": "subtitle", "time": 6192.87, "timestamp": "01:43:12", "text": "滑动？"}, {"type": "subtitle", "time": 6199.47, "timestamp": "01:43:19", "text": "哦，"}, {"type": "subtitle", "time": 6202.87, "timestamp": "01:43:22", "text": "她：他们有什么？好吧，这不是"}, {"type": "subtitle", "time": 6205.59, "timestamp": "01:43:25", "text": "好的。"}, {"type": "subtitle", "time": 6207.55, "timestamp": "01:43:27", "text": "这"}, {"type": "subtitle", "time": 6211.03, "timestamp": "01:43:31", "text": "问题就在这里。我想抓住"}, {"type": "subtitle", "time": 6212.47, "timestamp": "01:43:32", "text": "它。"}, {"type": "subtitle", "time": 6232.629, "timestamp": "01:43:52", "text": "过来，先生。好多了。哦，人类"}]
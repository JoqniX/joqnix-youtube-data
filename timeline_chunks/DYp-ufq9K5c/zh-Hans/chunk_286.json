[{"type": "subtitle", "time": 17160.708, "timestamp": "04:46:00", "text": "呃，现代市长的王座"}, {"type": "subtitle", "time": 17162.83, "timestamp": "04:46:02", "text": "你的第一头牧场动物"}, {"type": "subtitle", "time": 17171.55, "timestamp": "04:46:11", "text": "你的有"}, {"type": "subtitle", "time": 17184.708, "timestamp": "04:46:24", "text": "首都。呃，如果我能查一下就好了"}, {"type": "subtitle", "time": 17186.628, "timestamp": "04:46:26", "text": "创造者"}, {"type": "subtitle", "time": 17188.868, "timestamp": "04:46:28", "text": "呃，创建像这样的蓝图，它"}, {"type": "subtitle", "time": 17191.51, "timestamp": "04:46:31", "text": "会好起来的。但这就是痛苦。它"}, {"type": "subtitle", "time": 17195.628, "timestamp": "04:46:35", "text": "显示不正常。即使我把它放进去"}, {"type": "subtitle", "time": 17198.75, "timestamp": "04:46:38", "text": "没错，就是这样。"}, {"type": "subtitle", "time": 17201.31, "timestamp": "04:46:41", "text": "真糟糕。背景"}, {"type": "subtitle", "time": 17204.15, "timestamp": "04:46:44", "text": "火枪手。那么，最低价格是多少？"}, {"type": "subtitle", "time": 17207.19, "timestamp": "04:46:47", "text": "你觉得这款游戏有什么值得称道的地方？我可以吗？"}, {"type": "subtitle", "time": 17210.15, "timestamp": "04:46:50", "text": "不免费提供？这些蓝图"}, {"type": "subtitle", "time": 17215.99, "timestamp": "04:46:55", "text": "东西？如果我从未想过要制作呢？"}, {"type": "subtitle", "time": 17217.83, "timestamp": "04:46:57", "text": "钱？如果我想把它发布出去呢？"}]
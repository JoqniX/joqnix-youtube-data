[{"type": "subtitle", "time": 3120.069, "timestamp": "00:52:00", "text": "这个。"}, {"type": "subtitle", "time": 3128.43, "timestamp": "00:52:08", "text": "我是"}, {"type": "subtitle", "time": 3131.87, "timestamp": "00:52:11", "text": "死的。巴达宾，巴达"}, {"type": "subtitle", "time": 3134.71, "timestamp": "00:52:14", "text": "繁荣。好的，钢铁侠和灵蝶。我们"}, {"type": "subtitle", "time": 3138.15, "timestamp": "00:52:18", "text": "呃，我们没有什么可以给灵能锁用的。好的，"}, {"type": "subtitle", "time": 3139.829, "timestamp": "00:52:19", "text": "我没有灵能锁的相关信息，但上限是"}, {"type": "subtitle", "time": 3142.549, "timestamp": "00:52:22", "text": "这也会很烦人。所以，我要走了"}, {"type": "subtitle", "time": 3146.95, "timestamp": "00:52:26", "text": "采取铁腕手段。为什么？因为我们"}, {"type": "subtitle", "time": 3150.549, "timestamp": "00:52:30", "text": "露娜·斯诺没有任何……她很漂亮"}, {"type": "subtitle", "time": 3154.23, "timestamp": "00:52:34", "text": "很好，你知道，她只是在自救。"}, {"type": "subtitle", "time": 3167.51, "timestamp": "00:52:47", "text": "哦，我的游戏有点卡顿。我不是"}, {"type": "subtitle", "time": 3171.75, "timestamp": "00:52:51", "text": "我要撒谎。游戏有点卡顿。"}, {"type": "subtitle", "time": 3173.43, "timestamp": "00:52:53", "text": "集合"}, {"type": "subtitle", "time": 3175.91, "timestamp": "00:52:55", "text": "我的已经安装好了。铁腕依然存在"}, {"type": "subtitle", "time": 3178.63, "timestamp": "00:52:58", "text": "烧伤。"}]
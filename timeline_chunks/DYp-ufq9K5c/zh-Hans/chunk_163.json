[{"type": "subtitle", "time": 9780.95, "timestamp": "02:43:00", "text": "到我的鼠标？我进度落后了。"}, {"type": "subtitle", "time": 9795.91, "timestamp": "02:43:15", "text": "集合。这是真的。透过……的视角"}, {"type": "subtitle", "time": 9805.309, "timestamp": "02:43:25", "text": "我们一共得到了多少？多少分？"}, {"type": "subtitle", "time": 9809.59, "timestamp": "02:43:29", "text": "86. 我能吗？我大概能。我的理智是"}, {"type": "subtitle", "time": 9810.91, "timestamp": "02:43:30", "text": "翻转"}, {"type": "subtitle", "time": 9817.51, "timestamp": "02:43:37", "text": "是吗？"}, {"type": "subtitle", "time": 9820.15, "timestamp": "02:43:40", "text": "一点点。来这里。我要抓住"}, {"type": "subtitle", "time": 9822.389, "timestamp": "02:43:42", "text": "他。好的，我要休息一下。"}, {"type": "subtitle", "time": 9823.91, "timestamp": "02:43:43", "text": "我会回来的。哟。好的。再见"}, {"type": "subtitle", "time": 9825.99, "timestamp": "02:43:45", "text": "之后。好的。再见，D。谢谢。"}, {"type": "subtitle", "time": 9828.309, "timestamp": "02:43:48", "text": "期待您的光临。再见。"}, {"type": "subtitle", "time": 9835.51, "timestamp": "02:43:55", "text": "我回来了。"}, {"type": "subtitle", "time": 9839.349, "timestamp": "02:43:59", "text": "我的天哪，他终于回来了。"}]
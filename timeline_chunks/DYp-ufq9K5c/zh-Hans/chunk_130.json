[{"type": "subtitle", "time": 7800.55, "timestamp": "02:10:00", "text": "对抗？搞什么鬼？是的。它是"}, {"type": "subtitle", "time": 7802.95, "timestamp": "02:10:02", "text": "名为漫威对抗。总是"}, {"type": "subtitle", "time": 7805.99, "timestamp": "02:10:05", "text": "就叫这个。不允许设置竞争对手。哦"}, {"type": "subtitle", "time": 7810.47, "timestamp": "02:10:10", "text": "我的上帝。好的。是的。是的。乔总是问"}, {"type": "subtitle", "time": 7811.99, "timestamp": "02:10:11", "text": "比利，我喜欢它叫什么来着？"}, {"type": "subtitle", "time": 7815.069, "timestamp": "02:10:15", "text": "网站？它叫什么？"}, {"type": "subtitle", "time": 7818.31, "timestamp": "02:10:18", "text": "漫威格斗之类的？它不是"}, {"type": "subtitle", "time": 7820.47, "timestamp": "02:10:20", "text": "对抗。"}, {"type": "subtitle", "time": 7823.149, "timestamp": "02:10:23", "text": "太疯狂了。拉屎。错过"}, {"type": "subtitle", "time": 7828.99, "timestamp": "02:10:28", "text": "我需要记录"}, {"type": "subtitle", "time": 7838.47, "timestamp": "02:10:38", "text": "你是我的。我动不了。"}, {"type": "subtitle", "time": 7841.91, "timestamp": "02:10:41", "text": "月亮萦绕着你。"}, {"type": "subtitle", "time": 7843.91, "timestamp": "02:10:43", "text": "老兄，顺便说一句，我超喜欢这个人工智能。"}, {"type": "subtitle", "time": 7859.189, "timestamp": "02:10:59", "text": "哦，该死的。哦，你明白了。"}]
[{"type": "subtitle", "time": 4861.99, "timestamp": "01:21:01", "text": "我。”哦，我他妈的掉进火坑里了。"}, {"type": "subtitle", "time": 4866.149, "timestamp": "01:21:06", "text": "我又回到那座该死的火山里了。"}, {"type": "subtitle", "time": 4869.27, "timestamp": "01:21:09", "text": "该死。我他妈的在火坑里。"}, {"type": "subtitle", "time": 4870.87, "timestamp": "01:21:10", "text": "确切地。"}, {"type": "subtitle", "time": 4873.669, "timestamp": "01:21:13", "text": "糟了，直播恢复了。妈的，"}, {"type": "subtitle", "time": 4875.75, "timestamp": "01:21:15", "text": "我刚才听到了自己的声音。哦，是的，我只是"}, {"type": "subtitle", "time": 4878.229, "timestamp": "01:21:18", "text": "听到了自己的声音。走吧，兄弟。我只是"}, {"type": "subtitle", "time": 4881.83, "timestamp": "01:21:21", "text": "听到了自己的声音。我勒个去？"}, {"type": "subtitle", "time": 4885.35, "timestamp": "01:21:25", "text": "我们走吧。我们回来了。我们可以走了。我们"}, {"type": "subtitle", "time": 4888.87, "timestamp": "01:21:28", "text": "来了一位新客人。你好。"}, {"type": "subtitle", "time": 4890.87, "timestamp": "01:21:30", "text": "这位是赫拉斯神，各位。"}, {"type": "subtitle", "time": 4894.63, "timestamp": "01:21:34", "text": "欢迎收看。现在就等着看他输吧。"}, {"type": "subtitle", "time": 4897.43, "timestamp": "01:21:37", "text": "连续输了五个小时。我们走吧。"}, {"type": "chat", "time": 4902.212, "timestamp": "01:21:42", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "Joq's Activity State is Guest-Takeover"}, {"type": "subtitle", "time": 4902.95, "timestamp": "01:21:42", "text": "真是见鬼。啊哈。啊哈。啊哈。"}, {"type": "subtitle", "time": 4904.47, "timestamp": "01:21:44", "text": "你知道我为什么会输吗？我输了"}, {"type": "subtitle", "time": 4907.11, "timestamp": "01:21:47", "text": "因为我玩的不是坦克。确切地，"}, {"type": "subtitle", "time": 4910.229, "timestamp": "01:21:50", "text": "老兄。没错，我就是辆坦克，伙计。我不"}, {"type": "subtitle", "time": 4913.51, "timestamp": "01:21:53", "text": "玩输出角色。这是一个输出职业账号。"}, {"type": "subtitle", "time": 4917.35, "timestamp": "01:21:57", "text": "需要玩游戏。我打算玩输出位。"}, {"type": "subtitle", "time": 4919.03, "timestamp": "01:21:59", "text": "该杂志。哦，你不想见到我"}]
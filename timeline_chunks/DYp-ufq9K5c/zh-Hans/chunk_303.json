[{"type": "subtitle", "time": 18181.35, "timestamp": "05:03:01", "text": "我懂了。等等，我有个疑问。如何"}, {"type": "subtitle", "time": 18184.868, "timestamp": "05:03:04", "text": "如果我砍伐这棵树，需要多长时间？"}, {"type": "subtitle", "time": 18188.15, "timestamp": "05:03:08", "text": "或者像草一样？多久时间"}, {"type": "subtitle", "time": 18191.15, "timestamp": "05:03:11", "text": "为了拿走"}, {"type": "subtitle", "time": 18195.19, "timestamp": "05:03:15", "text": "植被会像树一样重新生长。"}, {"type": "subtitle", "time": 18198.47, "timestamp": "05:03:18", "text": "还能长回来吗？所以它总是这样下去。"}, {"type": "subtitle", "time": 18201.11, "timestamp": "05:03:21", "text": "像现实生活中的某种森林一样被砍伐"}, {"type": "subtitle", "time": 18203.55, "timestamp": "05:03:23", "text": "什么东西？如果你拔"}, {"type": "subtitle", "time": 18206.628, "timestamp": "05:03:26", "text": "植物被拔掉后，它就不会再在那里了。"}, {"type": "subtitle", "time": 18208.628, "timestamp": "05:03:28", "text": "除非你事先就计划好了。"}, {"type": "subtitle", "time": 18224.83, "timestamp": "05:03:44", "text": "香蕉。就一根香蕉。那真是太……"}, {"type": "subtitle", "time": 18227.83, "timestamp": "05:03:47", "text": "骗局。看起来还有更多地块"}, {"type": "subtitle", "time": 18230.03, "timestamp": "05:03:50", "text": "的"}]
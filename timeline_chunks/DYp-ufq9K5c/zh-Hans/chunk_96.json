[{"type": "subtitle", "time": 5760.95, "timestamp": "01:36:00", "text": "你知道，你就是罪魁祸首。哦，"}, {"type": "subtitle", "time": 5764.79, "timestamp": "01:36:04", "text": "他来自哪里？奇怪的。"}, {"type": "subtitle", "time": 5765.99, "timestamp": "01:36:05", "text": "我想你可以说他相当……"}, {"type": "subtitle", "time": 5773.43, "timestamp": "01:36:13", "text": "你无需害怕。我们弄到了一面盾牌。你"}, {"type": "subtitle", "time": 5785.75, "timestamp": "01:36:25", "text": "把他弄走。抓住他。真他妈的干掉了他。"}, {"type": "subtitle", "time": 5789.189, "timestamp": "01:36:29", "text": "最后。有人在看他。"}, {"type": "subtitle", "time": 5798.39, "timestamp": "01:36:38", "text": "哦，找到了。好的。"}, {"type": "subtitle", "time": 5801.11, "timestamp": "01:36:41", "text": "被偷了。太疯狂了。他们得到了一大堆。"}, {"type": "subtitle", "time": 5803.75, "timestamp": "01:36:43", "text": "时间。"}, {"type": "subtitle", "time": 5805.99, "timestamp": "01:36:45", "text": "3分钟。那可是很长一段时间啊"}, {"type": "subtitle", "time": 5810.229, "timestamp": "01:36:50", "text": "记住这一点。哟，我没有坦克。"}, {"type": "subtitle", "time": 5819.83, "timestamp": "01:36:59", "text": "法官、陪审团、刽子手。儿子"}]
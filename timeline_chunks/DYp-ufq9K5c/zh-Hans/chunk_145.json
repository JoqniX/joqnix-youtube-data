[{"type": "subtitle", "time": 8708.469, "timestamp": "02:25:08", "text": "他被粗暴对待了。"}, {"type": "subtitle", "time": 8710.23, "timestamp": "02:25:10", "text": "这是一个范围攻击技能。不应该是那样。"}, {"type": "subtitle", "time": 8713.03, "timestamp": "02:25:13", "text": "伙计们，真不容易。快点。我当时正在……"}, {"type": "subtitle", "time": 8720.27, "timestamp": "02:25:20", "text": "好的。"}, {"type": "subtitle", "time": 8727.349, "timestamp": "02:25:27", "text": "哦，弄软的。不。看哪，神！"}, {"type": "subtitle", "time": 8730.71, "timestamp": "02:25:30", "text": "雷。可能不太好。"}, {"type": "subtitle", "time": 8733.67, "timestamp": "02:25:33", "text": "哦，只剩下坦克了。"}, {"type": "subtitle", "time": 8736.55, "timestamp": "02:25:36", "text": "哦，她酒吧。哦，那可不好。哦，"}, {"type": "subtitle", "time": 8739.03, "timestamp": "02:25:39", "text": "帽子在那里。他能处理好这件事。我"}, {"type": "subtitle", "time": 8741.91, "timestamp": "02:25:41", "text": "在此之前可以瞬间移动。"}, {"type": "subtitle", "time": 8743.99, "timestamp": "02:25:43", "text": "轻触笔帽。"}, {"type": "subtitle", "time": 8747.27, "timestamp": "02:25:47", "text": "手又开始抖了。重点"}, {"type": "subtitle", "time": 8749.349, "timestamp": "02:25:49", "text": "他的战利品。"}]
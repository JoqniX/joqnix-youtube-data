[{"type": "subtitle", "time": 4921.51, "timestamp": "01:22:01", "text": "玩弹匣游戏吧，伙计。"}, {"type": "subtitle", "time": 4924.39, "timestamp": "01:22:04", "text": "他们叫我勒布朗·詹姆斯。播放杂志，"}, {"type": "subtitle", "time": 4939.11, "timestamp": "01:22:19", "text": "总之，伙计，我当时在玩《U Expedition》。"}, {"type": "subtitle", "time": 4941.59, "timestamp": "01:22:21", "text": "最近在 PlayStation 上推出了 33 款游戏。我是"}, {"type": "subtitle", "time": 4943.11, "timestamp": "01:22:23", "text": "上瘾了。我心想，哦，大家都这样。"}, {"type": "subtitle", "time": 4945.11, "timestamp": "01:22:25", "text": "玩那个游戏。是啊，我都60岁了。"}, {"type": "subtitle", "time": 4948.07, "timestamp": "01:22:28", "text": "兄弟，我已经玩了好几个小时了。那"}, {"type": "subtitle", "time": 4950.07, "timestamp": "01:22:30", "text": "我觉得这款游戏值得一玩，因为"}, {"type": "subtitle", "time": 4952.87, "timestamp": "01:22:32", "text": "太棒了。没错，兄弟。他妈的"}, {"type": "subtitle", "time": 4956.07, "timestamp": "01:22:36", "text": "电影原声带。谁是你的谁是你的"}, {"type": "subtitle", "time": 4958.149, "timestamp": "01:22:38", "text": "现在最喜欢的角色？什么"}, {"type": "subtitle", "time": 4959.91, "timestamp": "01:22:39", "text": "你的意思是？"}, {"type": "subtitle", "time": 4961.669, "timestamp": "01:22:41", "text": "嗯，探险。你最喜欢谁？"}, {"type": "subtitle", "time": 4964.709, "timestamp": "01:22:44", "text": "现在这个角色怎么样？我很喜欢古斯塔夫"}, {"type": "subtitle", "time": 4966.55, "timestamp": "01:22:46", "text": "因为你知道他是主角"}, {"type": "subtitle", "time": 4970.47, "timestamp": "01:22:50", "text": "当然，但我也很喜欢……呃，那是什么？"}, {"type": "subtitle", "time": 4971.87, "timestamp": "01:22:51", "text": "小女孩？"}, {"type": "subtitle", "time": 4973.709, "timestamp": "01:22:53", "text": "呃，"}, {"type": "subtitle", "time": 4976.629, "timestamp": "01:22:56", "text": "梅尔，哦，是的。是的。是的。她"}, {"type": "subtitle", "time": 4979.35, "timestamp": "01:22:59", "text": "不一定要在那里。她只是"}]
[{"type": "subtitle", "time": 16620.029, "timestamp": "04:37:00", "text": "我最终使用的那艘船。"}, {"type": "subtitle", "time": 16626.31, "timestamp": "04:37:06", "text": "啊。我想看看这艘泰坦尼克号。"}, {"type": "subtitle", "time": 16628.789, "timestamp": "04:37:08", "text": "它看起来很小，但里面却很大"}, {"type": "subtitle", "time": 16642.47, "timestamp": "04:37:22", "text": "好的。等等，呃，底部在哪儿？"}, {"type": "subtitle", "time": 16645.269, "timestamp": "04:37:25", "text": "隔间和东西？这是一个简单的"}, {"type": "subtitle", "time": 16652.709, "timestamp": "04:37:32", "text": "似乎如此。哇。那这个呢？"}, {"type": "subtitle", "time": 16655.429, "timestamp": "04:37:35", "text": "这个紫色的看起来很精致。为什么是"}, {"type": "subtitle", "time": 16659.869, "timestamp": "04:37:39", "text": "它们就像稀有物品一样，比如绿色"}, {"type": "subtitle", "time": 16662.551, "timestamp": "04:37:42", "text": "紫色之类的？这就像取决于"}, {"type": "subtitle", "time": 16669.39, "timestamp": "04:37:49", "text": "是？"}]
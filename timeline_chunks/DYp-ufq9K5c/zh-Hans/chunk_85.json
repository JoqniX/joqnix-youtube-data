[{"type": "subtitle", "time": 5101.03, "timestamp": "01:25:01", "text": "“回去玩《守望先锋》吧，兄弟。” 我心想，“走吧。”"}, {"type": "subtitle", "time": 5103.83, "timestamp": "01:25:03", "text": "是《守望先锋》啊，老兄。去玩《守望先锋》吧"}, {"type": "subtitle", "time": 5105.27, "timestamp": "01:25:05", "text": "伙伴。你为什么在这里？我心想，"}, {"type": "subtitle", "time": 5106.27, "timestamp": "01:25:06", "text": "“好的，"}, {"type": "subtitle", "time": 5109.03, "timestamp": "01:25:09", "text": "男人。冷静下来。只是个游戏而已。哦，"}, {"type": "subtitle", "time": 5110.39, "timestamp": "01:25:10", "text": "蜘蛛侠。蜘蛛侠正在做"}, {"type": "subtitle", "time": 5112.39, "timestamp": "01:25:12", "text": "厄运。他正在模仿末日铁拳。不，不是"}, {"type": "subtitle", "time": 5115.99, "timestamp": "01:25:15", "text": "末日铁拳。对不起。它叫什么名字？"}, {"type": "subtitle", "time": 5119.11, "timestamp": "01:25:19", "text": "什么？他妈的。我忘了那个清真寺的人。"}, {"type": "subtitle", "time": 5120.07, "timestamp": "01:25:20", "text": "哦。"}, {"type": "subtitle", "time": 5123.35, "timestamp": "01:25:23", "text": "苔藓男。"}, {"type": "subtitle", "time": 5127.189, "timestamp": "01:25:27", "text": "死神。哦，是的。哦，你是说星爵吧。"}, {"type": "subtitle", "time": 5128.95, "timestamp": "01:25:28", "text": "他"}, {"type": "subtitle", "time": 5131.27, "timestamp": "01:25:31", "text": "使用正常尺寸的武器。好的。哦"}, {"type": "subtitle", "time": 5134.229, "timestamp": "01:25:34", "text": "是的。还有蜘蛛侠。我的天啊。"}, {"type": "subtitle", "time": 5138.149, "timestamp": "01:25:38", "text": "哦，是的。差不多。是的。"}, {"type": "subtitle", "time": 5140.95, "timestamp": "01:25:40", "text": "非常相似。是的。 Starord 也得到了"}, {"type": "subtitle", "time": 5143.91, "timestamp": "01:25:43", "text": "死神。"}, {"type": "subtitle", "time": 5146.149, "timestamp": "01:25:46", "text": "我称之为“死神MVP按钮”。你"}, {"type": "subtitle", "time": 5147.79, "timestamp": "01:25:47", "text": "按下去就行了。繁荣。你是MVP。哦"}, {"type": "subtitle", "time": 5149.59, "timestamp": "01:25:49", "text": "拉屎。"}, {"type": "subtitle", "time": 5151.669, "timestamp": "01:25:51", "text": "抱歉，我不是MVP。呃，这位玩家"}, {"type": "subtitle", "time": 5154.39, "timestamp": "01:25:54", "text": "游戏。 Mag很好。"}, {"type": "subtitle", "time": 5156.149, "timestamp": "01:25:56", "text": "那台Mag不错。你知道那是什么吗？"}]
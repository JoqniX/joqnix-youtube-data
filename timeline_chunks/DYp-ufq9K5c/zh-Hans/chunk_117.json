[{"type": "subtitle", "time": 7027.91, "timestamp": "01:57:07", "text": "好的。我的浣熊为什么倒着走？"}, {"type": "subtitle", "time": 7031.91, "timestamp": "01:57:11", "text": "你看到他了吗？我觉得他断线了。"}, {"type": "subtitle", "time": 7033.589, "timestamp": "01:57:13", "text": "他妈的。这是我们唯一想要的"}, {"type": "subtitle", "time": 7068.55, "timestamp": "01:57:48", "text": "艾莉丝，你知道，我会接受大牌。"}, {"type": "subtitle", "time": 7076.149, "timestamp": "01:57:56", "text": "我会成为更好的人，因为我们可以。"}, {"type": "subtitle", "time": 7078.629, "timestamp": "01:57:58", "text": "这是一个极简游戏。那些家伙不是"}]
[{"type": "subtitle", "time": 9481.27, "timestamp": "02:38:01", "text": "之所以有形式，是因为就像有……一样"}, {"type": "subtitle", "time": 9485.19, "timestamp": "02:38:05", "text": "来自艾德曼合金的辐射，"}, {"type": "subtitle", "time": 9487.349, "timestamp": "02:38:07", "text": "正确的？但这并不是，这不是……"}, {"type": "subtitle", "time": 9488.99, "timestamp": "02:38:08", "text": "次要的。就像他最主要的事情是"}, {"type": "subtitle", "time": 9491.75, "timestamp": "02:38:11", "text": "康复。我觉得其中一个是"}, {"type": "subtitle", "time": 9494.07, "timestamp": "02:38:14", "text": "其中一部比较新的漫画里，他"}, {"type": "subtitle", "time": 9497.99, "timestamp": "02:38:17", "text": "可以加热他的爪子。"}, {"type": "subtitle", "time": 9501.03, "timestamp": "02:38:21", "text": "糟了，他真的可以。但这仅仅是针对……"}, {"type": "subtitle", "time": 9504.55, "timestamp": "02:38:24", "text": "是和endium一起的，对吧？或者我认为"}, {"type": "subtitle", "time": 9506.389, "timestamp": "02:38:26", "text": "我不知道。我不知道。它不在"}, {"type": "subtitle", "time": 9507.67, "timestamp": "02:38:27", "text": "这篇文章。所以，我有点像……"}, {"type": "subtitle", "time": 9511.27, "timestamp": "02:38:31", "text": "使困惑。但我见过那个面板"}, {"type": "subtitle", "time": 9514.389, "timestamp": "02:38:34", "text": "他就像身上带着烤肉串一样"}, {"type": "subtitle", "time": 9516.87, "timestamp": "02:38:36", "text": "他把爪子吃了，我就……"}, {"type": "subtitle", "time": 9518.87, "timestamp": "02:38:38", "text": "比如，“哦，这太酷了。”而这"}, {"type": "subtitle", "time": 9521.03, "timestamp": "02:38:41", "text": "发生在金刚狼死后。所以就像"}, {"type": "subtitle", "time": 9523.51, "timestamp": "02:38:43", "text": "他不知怎么就回来了。我需要查阅资料"}, {"type": "subtitle", "time": 9525.19, "timestamp": "02:38:45", "text": "就此而言。我要被驱逐出境吗？"}, {"type": "subtitle", "time": 9528.389, "timestamp": "02:38:48", "text": "匹配？哦，那是H。真好。但"}, {"type": "subtitle", "time": 9531.99, "timestamp": "02:38:51", "text": "关于金刚狼也存在争议。"}, {"type": "subtitle", "time": 9533.83, "timestamp": "02:38:53", "text": "已经存在二次突变，"}, {"type": "subtitle", "time": 9537.91, "timestamp": "02:38:57", "text": "那就是爪子本身，就像"}]
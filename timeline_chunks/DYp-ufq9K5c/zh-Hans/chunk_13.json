[{"type": "subtitle", "time": 782.069, "timestamp": "00:13:02", "text": "假期，我把所有计划都取消了。"}, {"type": "subtitle", "time": 784.069, "timestamp": "00:13:04", "text": "为什么？为什么？"}, {"type": "subtitle", "time": 787.75, "timestamp": "00:13:07", "text": "因为我当时想，没关系。"}, {"type": "subtitle", "time": 792.59, "timestamp": "00:13:12", "text": "我接到了一个直播任务。是的，"}, {"type": "subtitle", "time": 796.47, "timestamp": "00:13:16", "text": "溪流。我得看你的直播，小子。上帝"}, {"type": "subtitle", "time": 799.35, "timestamp": "00:13:19", "text": "该死的家伙。去度假。他妈的"}, {"type": "subtitle", "time": 801.11, "timestamp": "00:13:21", "text": "地狱。"}, {"type": "subtitle", "time": 807.75, "timestamp": "00:13:27", "text": "你以后是看不到这个国家的了。"}, {"type": "subtitle", "time": 812.31, "timestamp": "00:13:32", "text": "比如多久？就像一年那么长。两年。"}, {"type": "subtitle", "time": 814.629, "timestamp": "00:13:34", "text": "两年。你不想享受"}, {"type": "subtitle", "time": 816.15, "timestamp": "00:13:36", "text": "它。你只想坐在你的……"}, {"type": "subtitle", "time": 819.67, "timestamp": "00:13:39", "text": "电脑和流媒体。快点。我们可以"}, {"type": "subtitle", "time": 823.509, "timestamp": "00:13:43", "text": "做得更好。来。"}, {"type": "subtitle", "time": 825.35, "timestamp": "00:13:45", "text": "你会想念这里的。像小姐"}, {"type": "subtitle", "time": 826.83, "timestamp": "00:13:46", "text": "一切。"}, {"type": "subtitle", "time": 828.55, "timestamp": "00:13:48", "text": "[音乐]"}, {"type": "subtitle", "time": 832.11, "timestamp": "00:13:52", "text": "快点。我们不能抽出时间来"}, {"type": "subtitle", "time": 836.069, "timestamp": "00:13:56", "text": "比如出去散散步。你知道，我"}, {"type": "subtitle", "time": 838.15, "timestamp": "00:13:58", "text": "好久没散步了"}]
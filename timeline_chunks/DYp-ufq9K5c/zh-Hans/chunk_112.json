[{"type": "subtitle", "time": 6722.95, "timestamp": "01:52:02", "text": "我听到了那个笑话，然后是“哦”，"}, {"type": "subtitle", "time": 6725.51, "timestamp": "01:52:05", "text": "乐于助人。哦，走吧，伙计们。"}, {"type": "subtitle", "time": 6729.91, "timestamp": "01:52:09", "text": "当然。我们走吧。"}, {"type": "subtitle", "time": 6734.709, "timestamp": "01:52:14", "text": "哦。哦。哦。哦，没事了。我们很好。"}, {"type": "subtitle", "time": 6737.669, "timestamp": "01:52:17", "text": "现在我们必须把这个混蛋赶走。"}, {"type": "subtitle", "time": 6739.83, "timestamp": "01:52:19", "text": "哦，我们很擅长推动事情发展。快点。时间"}, {"type": "subtitle", "time": 6741.109, "timestamp": "01:52:21", "text": "换个说法。你知道有多少"}, {"type": "subtitle", "time": 6743.83, "timestamp": "01:52:23", "text": "我接生的婴儿？"}, {"type": "subtitle", "time": 6745.75, "timestamp": "01:52:25", "text": "什么？"}, {"type": "subtitle", "time": 6747.669, "timestamp": "01:52:27", "text": "任何人的助手。有多少个婴儿"}, {"type": "subtitle", "time": 6750.629, "timestamp": "01:52:30", "text": "你送货吗？嗯，我左边有几个。"}, {"type": "subtitle", "time": 6752.55, "timestamp": "01:52:32", "text": "嗯？"}, {"type": "subtitle", "time": 6756.229, "timestamp": "01:52:36", "text": "该死。总之，我选星爵。我"}, {"type": "subtitle", "time": 6760.709, "timestamp": "01:52:40", "text": "感觉就像：哦，我们走吧，星爵。"}]
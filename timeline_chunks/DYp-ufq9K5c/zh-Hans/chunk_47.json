[{"type": "subtitle", "time": 2826.63, "timestamp": "00:47:06", "text": "那对我会有帮助吗？"}, {"type": "subtitle", "time": 2828.15, "timestamp": "00:47:08", "text": "最大限度。"}, {"type": "subtitle", "time": 2831.27, "timestamp": "00:47:11", "text": "他走了。哦，你看。"}, {"type": "subtitle", "time": 2833.75, "timestamp": "00:47:13", "text": "把他干掉了。"}, {"type": "subtitle", "time": 2842.87, "timestamp": "00:47:22", "text": "最后10秒。哦，我们有一个数据中心。"}, {"type": "subtitle", "time": 2846.23, "timestamp": "00:47:26", "text": "不，是我们的坦克。不，我们不会……"}, {"type": "subtitle", "time": 2848.75, "timestamp": "00:47:28", "text": "我们会失去这一切吗？请不要。"}, {"type": "subtitle", "time": 2852.309, "timestamp": "00:47:32", "text": "好的。最终得分。我的屁股也很糟糕。"}, {"type": "subtitle", "time": 2855.109, "timestamp": "00:47:35", "text": "但这并不意味着它有感知能力。哦，那个"}, {"type": "subtitle", "time": 2858.23, "timestamp": "00:47:38", "text": "这说得通。但是，是的，你是"}, {"type": "subtitle", "time": 2860.55, "timestamp": "00:47:40", "text": "D，你真是聪明绝顶。"}, {"type": "subtitle", "time": 2868.829, "timestamp": "00:47:48", "text": "屁股。上帝"}, {"type": "subtitle", "time": 2871.589, "timestamp": "00:47:51", "text": "该死。为什么是黑寡妇？"}, {"type": "subtitle", "time": 2873.91, "timestamp": "00:47:53", "text": "超好的？这么做的意义何在？"}, {"type": "subtitle", "time": 2876.069, "timestamp": "00:47:56", "text": "这是GM级别吗？"}, {"type": "subtitle", "time": 2879.47, "timestamp": "00:47:59", "text": "你知道，他就像个小丑一样。"}]
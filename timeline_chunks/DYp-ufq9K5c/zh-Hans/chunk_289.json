[{"type": "subtitle", "time": 17341.43, "timestamp": "04:49:01", "text": "是的。只能在自由世界进行。"}, {"type": "subtitle", "time": 17346.11, "timestamp": "04:49:06", "text": "哦，它是免费的。自由的。"}, {"type": "subtitle", "time": 17348.47, "timestamp": "04:49:08", "text": "哦好的。好的。好的。我以为你有"}, {"type": "subtitle", "time": 17349.47, "timestamp": "04:49:09", "text": "支付和"}, {"type": "subtitle", "time": 17350.67, "timestamp": "04:49:10", "text": "[音乐]"}, {"type": "subtitle", "time": 17354.39, "timestamp": "04:49:14", "text": "东西。我只有20枚这种硬币。"}, {"type": "subtitle", "time": 17367.51, "timestamp": "04:49:27", "text": "标签。你可以获得很多成就"}, {"type": "subtitle", "time": 17370.11, "timestamp": "04:49:30", "text": "这东西"}, {"type": "subtitle", "time": 17373.67, "timestamp": "04:49:33", "text": "从。你试过制作一个……"}, {"type": "subtitle", "time": 17376.15, "timestamp": "04:49:36", "text": "专用服务器之类的东西"}, {"type": "subtitle", "time": 17378.868, "timestamp": "04:49:38", "text": "你玩的时候有没有做过？"}, {"type": "subtitle", "time": 17381.03, "timestamp": "04:49:41", "text": "作为本地主机，或者你玩过吗？"}, {"type": "subtitle", "time": 17382.03, "timestamp": "04:49:42", "text": "你的"}, {"type": "subtitle", "time": 17385.38, "timestamp": "04:49:45", "text": "朋友们？怎么样？"}, {"type": "subtitle", "time": 17388.75, "timestamp": "04:49:48", "text": "[音乐]"}, {"type": "subtitle", "time": 17391.91, "timestamp": "04:49:51", "text": "那？最多三场比赛。我没有起床"}, {"type": "subtitle", "time": 17395.03, "timestamp": "04:49:55", "text": "三个游戏之类的。我不明白"}, {"type": "subtitle", "time": 17397.07, "timestamp": "04:49:57", "text": "其实我不太明白。"}]
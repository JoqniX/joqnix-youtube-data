[{"type": "subtitle", "time": 541.75, "timestamp": "00:09:01", "text": "我和服务器就像在做实验一样"}, {"type": "subtitle", "time": 544.63, "timestamp": "00:09:04", "text": "多种模式等等。那里"}, {"type": "subtitle", "time": 547.35, "timestamp": "00:09:07", "text": "当时有个太阳能灶之类的东西，所以我……"}, {"type": "chat", "time": 547.614, "timestamp": "00:09:07", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "minecraft moment"}, {"type": "subtitle", "time": 551.269, "timestamp": "00:09:11", "text": "看了很多东西。"}, {"type": "subtitle", "time": 559.67, "timestamp": "00:09:19", "text": "哦，妈妈正在用空气炸锅做葡萄酒"}, {"type": "subtitle", "time": 563.99, "timestamp": "00:09:23", "text": "支柱。该死。"}, {"type": "subtitle", "time": 572.15, "timestamp": "00:09:32", "text": "哦，那是你所有的袖子吗？"}, {"type": "subtitle", "time": 575.19, "timestamp": "00:09:35", "text": "种类。我当时本该睡觉的。我"}, {"type": "subtitle", "time": 577.91, "timestamp": "00:09:37", "text": "不知道发生了什么事。"}, {"type": "subtitle", "time": 579.269, "timestamp": "00:09:39", "text": "你知道吗？告诉聊天室你什么时候"}, {"type": "subtitle", "time": 582.949, "timestamp": "00:09:42", "text": "睡着了。你什么时候睡觉的？我睡了"}, {"type": "subtitle", "time": 586.71, "timestamp": "00:09:46", "text": "我当时……呃，所以我去了厨房，"}, {"type": "subtitle", "time": 589.91, "timestamp": "00:09:49", "text": "像这样把米放进去。嗯"}, {"type": "subtitle", "time": 592.87, "timestamp": "00:09:52", "text": "昨天浇过水，所以我把它放进去了。"}, {"type": "subtitle", "time": 595.67, "timestamp": "00:09:55", "text": "就像把它抽干了，然后一切都……"}, {"type": "subtitle", "time": 598.55, "timestamp": "00:09:58", "text": "我把它倒进去，然后应该加热。"}]
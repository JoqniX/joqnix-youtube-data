[{"type": "subtitle", "time": 5220.629, "timestamp": "01:27:00", "text": "但是，正如我刚才说的，伙计，"}, {"type": "subtitle", "time": 5222.95, "timestamp": "01:27:02", "text": "老兄，金刚狼的配音演员。操"}, {"type": "subtitle", "time": 5227.91, "timestamp": "01:27:07", "text": "史蒂夫·布鲁姆是评委，对吧？他一直是"}, {"type": "subtitle", "time": 5230.87, "timestamp": "01:27:10", "text": "毫无疑问，金刚狼已经当之无愧地存在了这么久。我爱"}, {"type": "subtitle", "time": 5233.11, "timestamp": "01:27:13", "text": "他。我认为他也是硫磺火神。"}, {"type": "subtitle", "time": 5234.629, "timestamp": "01:27:14", "text": "瓦莱丽。谈谈那场戏吧，我刚刚"}, {"type": "subtitle", "time": 5239.91, "timestamp": "01:27:19", "text": "做过。哟，这游戏玩得真烂。"}, {"type": "subtitle", "time": 5242.87, "timestamp": "01:27:22", "text": "那边那四个人就像……哦，那真是太……"}, {"type": "subtitle", "time": 5245.189, "timestamp": "01:27:25", "text": "凉爽的。 Five Guys怎么样？等等，过来。"}, {"type": "subtitle", "time": 5246.07, "timestamp": "01:27:26", "text": "过来。过来。过来。来"}, {"type": "subtitle", "time": 5248.39, "timestamp": "01:27:28", "text": "这里。过来。是的，我知道你喜欢"}, {"type": "subtitle", "time": 5251.11, "timestamp": "01:27:31", "text": "五个家伙。是啊，好孩子。"}, {"type": "subtitle", "time": 5256.47, "timestamp": "01:27:36", "text": "好吧，伙计。冷静下来。就是这样"}, {"type": "subtitle", "time": 5262.629, "timestamp": "01:27:42", "text": "像我一样，叫别人“好孩子”"}, {"type": "subtitle", "time": 5264.79, "timestamp": "01:27:44", "text": "竞争对手。搞什么鬼？好的。什么时候"}, {"type": "subtitle", "time": 5266.31, "timestamp": "01:27:46", "text": "每当我的治疗者给我加血后，我就直接走开"}, {"type": "subtitle", "time": 5268.47, "timestamp": "01:27:48", "text": "比如，“好孩子。”"}, {"type": "subtitle", "time": 5276.629, "timestamp": "01:27:56", "text": "你好啊，Sil，清单太多了。”哦，她"}, {"type": "subtitle", "time": 5279.91, "timestamp": "01:27:59", "text": "直接隐身了。好的。她"}]
[{"type": "subtitle", "time": 15378.55, "timestamp": "04:16:18", "text": "椅子。哦，等等。你甚至还把它雕刻出来了。你"}, {"type": "subtitle", "time": 15381.75, "timestamp": "04:16:21", "text": "这里放个女士。哦，是一尊女士雕像。"}, {"type": "subtitle", "time": 15384.11, "timestamp": "04:16:24", "text": "木雕"}, {"type": "subtitle", "time": 15387.03, "timestamp": "04:16:27", "text": "雕刻。什么？哇。它就像一片大海"}, {"type": "subtitle", "time": 15389.229, "timestamp": "04:16:29", "text": "美人鱼或"}, {"type": "subtitle", "time": 15392.149, "timestamp": "04:16:32", "text": "某物。那是喇叭之类的东西吗？"}, {"type": "subtitle", "time": 15396.79, "timestamp": "04:16:36", "text": "那是独角兽的角吗？不，是"}, {"type": "subtitle", "time": 15399.75, "timestamp": "04:16:39", "text": "头发。好的。船底内部。"}]
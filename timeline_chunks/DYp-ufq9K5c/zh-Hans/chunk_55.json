[{"type": "subtitle", "time": 3310.23, "timestamp": "00:55:10", "text": "我曾经是剑术大师，但现在我是"}, {"type": "subtitle", "time": 3314.069, "timestamp": "00:55:14", "text": "远不止这些。艾尔兄弟，相信我。"}, {"type": "subtitle", "time": 3317.589, "timestamp": "00:55:17", "text": "相信我。还有更多"}, {"type": "subtitle", "time": 3320.069, "timestamp": "00:55:20", "text": "比钢铁侠游戏里的角色更烦人。"}, {"type": "subtitle", "time": 3322.23, "timestamp": "00:55:22", "text": "好吧，"}, {"type": "subtitle", "time": 3325.75, "timestamp": "00:55:25", "text": "去他妈的。太阳街和摄政王"}, {"type": "subtitle", "time": 3328.95, "timestamp": "00:55:28", "text": "系统。但我想要帮助露娜。我"}, {"type": "subtitle", "time": 3330.47, "timestamp": "00:55:30", "text": "真的很想帮助露娜"}, {"type": "subtitle", "time": 3333.27, "timestamp": "00:55:33", "text": "铁腕手段，但是"}, {"type": "subtitle", "time": 3335.03, "timestamp": "00:55:35", "text": "我不知道她有没有做什么。"}, {"type": "subtitle", "time": 3338.71, "timestamp": "00:55:38", "text": "凭借这种能力。所有盔甲"}, {"type": "subtitle", "time": 3342.23, "timestamp": "00:55:42", "text": "不让通过。我认为"}, {"type": "subtitle", "time": 3345.67, "timestamp": "00:55:45", "text": "这需要用到杠杆。战斗开始于"}, {"type": "subtitle", "time": 3350.309, "timestamp": "00:55:50", "text": "五。书呆子。真是个书呆子啊。这家伙的"}, {"type": "subtitle", "time": 3352.15, "timestamp": "00:55:52", "text": "真是个书呆子。你只需要这样做"}, {"type": "subtitle", "time": 3355.75, "timestamp": "00:55:55", "text": "占领该区域。知道了。"}, {"type": "subtitle", "time": 3357.27, "timestamp": "00:55:57", "text": "没想到我还要回到这里。"}, {"type": "subtitle", "time": 3359.349, "timestamp": "00:55:59", "text": "所以，他们也很低调，所以我可以"}]
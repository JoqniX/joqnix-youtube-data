[{"type": "subtitle", "time": 18136.31, "timestamp": "05:02:16", "text": "[音乐]"}, {"type": "subtitle", "time": 18139.67, "timestamp": "05:02:19", "text": "如果布拉德说他会在2小时后加入。"}, {"type": "subtitle", "time": 18143.15, "timestamp": "05:02:23", "text": "是的，如果布拉德或阿昌加入，我可以让他们加入。"}, {"type": "subtitle", "time": 18145.47, "timestamp": "05:02:25", "text": "他们也加入了，我"}, {"type": "subtitle", "time": 18147.948, "timestamp": "05:02:27", "text": "猜测。"}, {"type": "subtitle", "time": 18150.948, "timestamp": "05:02:30", "text": "是的，他们可以和我一起尝试……"}, {"type": "subtitle", "time": 18152.83, "timestamp": "05:02:32", "text": "探索这个世界。"}, {"type": "subtitle", "time": 18159.51, "timestamp": "05:02:39", "text": "呃，香料。好的，我回来了。我们回来了"}, {"type": "subtitle", "time": 18161.788, "timestamp": "05:02:41", "text": "到"}, {"type": "subtitle", "time": 18165.11, "timestamp": "05:02:45", "text": "游戏。这里似乎有很多植被。"}, {"type": "subtitle", "time": 18166.99, "timestamp": "05:02:46", "text": "有"}, {"type": "subtitle", "time": 18170.628, "timestamp": "05:02:50", "text": "我想，这件事发生了。哦，等等。多久"}, {"type": "subtitle", "time": 18172.03, "timestamp": "05:02:52", "text": "是吗？"}, {"type": "subtitle", "time": 18174.948, "timestamp": "05:02:54", "text": "拿？其他地图比这大得多。"}, {"type": "subtitle", "time": 18177.07, "timestamp": "05:02:57", "text": "起始区域。"}]
[{"type": "subtitle", "time": 8340.469, "timestamp": "02:19:00", "text": "如果能治愈，那还有什么意义呢？"}, {"type": "subtitle", "time": 8343.589, "timestamp": "02:19:03", "text": "有治疗师吗？"}, {"type": "subtitle", "time": 8345.79, "timestamp": "02:19:05", "text": "嗯，是的"}, {"type": "subtitle", "time": 8348.87, "timestamp": "02:19:08", "text": "是你，你在吐口水。你是"}, {"type": "subtitle", "time": 8351.11, "timestamp": "02:19:11", "text": "吐痰。确切地。这就是我爱它的原因"}, {"type": "subtitle", "time": 8354.95, "timestamp": "02:19:14", "text": "我讨厌《守望先锋1》和《守望先锋2》。"}, {"type": "subtitle", "time": 8357.669, "timestamp": "02:19:17", "text": "我喜欢漫威SP劲敌，因为它……"}, {"type": "subtitle", "time": 8360.389, "timestamp": "02:19:20", "text": "基本上就是守望先锋那一款。"}, {"type": "subtitle", "time": 8363.429, "timestamp": "02:19:23", "text": "是的。呃，这太疯狂了。但我没有"}, {"type": "subtitle", "time": 8365.429, "timestamp": "02:19:25", "text": "我知道，伙计。我唯一不喜欢的就是"}, {"type": "subtitle", "time": 8367.91, "timestamp": "02:19:27", "text": "这款游戏的精髓在于，疯狂的人可以做到什么程度。"}, {"type": "subtitle", "time": 8369.83, "timestamp": "02:19:29", "text": "得到。"}, {"type": "subtitle", "time": 8372.629, "timestamp": "02:19:32", "text": "你应该看看我他妈的……"}, {"type": "subtitle", "time": 8374.629, "timestamp": "02:19:34", "text": "尤其是在这张地图上。我的天哪，我恨"}, {"type": "subtitle", "time": 8378.15, "timestamp": "02:19:38", "text": "这张地图。这张地图毁了我的FPS游戏体验。"}, {"type": "subtitle", "time": 8379.99, "timestamp": "02:19:39", "text": "呃，说实话，我有。"}, {"type": "subtitle", "time": 8382.87, "timestamp": "02:19:42", "text": "逐渐演变成这张地图。"}, {"type": "subtitle", "time": 8385.83, "timestamp": "02:19:45", "text": "我从一开始就讨厌它。"}, {"type": "subtitle", "time": 8387.75, "timestamp": "02:19:47", "text": "季节。我也很讨厌这样，但慢慢地"}, {"type": "subtitle", "time": 8389.99, "timestamp": "02:19:49", "text": "但我确实慢慢适应了。我"}, {"type": "subtitle", "time": 8391.75, "timestamp": "02:19:51", "text": "依然讨厌它。比如，有好多呢。"}, {"type": "subtitle", "time": 8393.429, "timestamp": "02:19:53", "text": "可以藏身的角落和缝隙。"}, {"type": "subtitle", "time": 8397.03, "timestamp": "02:19:57", "text": "另一个。你知道另一个地方"}]
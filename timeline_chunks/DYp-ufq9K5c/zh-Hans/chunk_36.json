[{"type": "subtitle", "time": 2161.43, "timestamp": "00:36:01", "text": "他们没有失手。哦，没事了。哦，"}, {"type": "subtitle", "time": 2164.55, "timestamp": "00:36:04", "text": "没关系。"}, {"type": "subtitle", "time": 2167.15, "timestamp": "00:36:07", "text": "打他。该死的。他是其中之一"}, {"type": "subtitle", "time": 2169.349, "timestamp": "00:36:09", "text": "射击。我还要再去拿那根骨头。"}, {"type": "subtitle", "time": 2187.75, "timestamp": "00:36:27", "text": "是的，整个德古拉猎人皮肤"}, {"type": "subtitle", "time": 2190.55, "timestamp": "00:36:30", "text": "这部剧太火了。哦，是的。什么皮肤"}, {"type": "subtitle", "time": 2193.069, "timestamp": "00:36:33", "text": "当时在场吗？我不记得了"}, {"type": "subtitle", "time": 2209.75, "timestamp": "00:36:49", "text": "那。其他"}, {"type": "subtitle", "time": 2211.589, "timestamp": "00:36:51", "text": "好的。谢谢。谢谢你毁了这一切"}, {"type": "subtitle", "time": 2215.75, "timestamp": "00:36:55", "text": "它。我的天哪，我的毒液。谢谢你毁了这一切"}, {"type": "subtitle", "time": 2219.51, "timestamp": "00:36:59", "text": "它。你可以点赞。"}]
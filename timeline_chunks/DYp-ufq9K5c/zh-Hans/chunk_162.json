[{"type": "subtitle", "time": 9720.27, "timestamp": "02:42:00", "text": "不，他已经换了。是的，"}, {"type": "subtitle", "time": 9722.23, "timestamp": "02:42:02", "text": "确切地。他可以切换。这就是我的原因"}, {"type": "subtitle", "time": 9724.07, "timestamp": "02:42:04", "text": "我知道我接下来要……哦，你好"}, {"type": "subtitle", "time": 9728.23, "timestamp": "02:42:08", "text": "那里。哦，我们有你好，伙计。"}, {"type": "subtitle", "time": 9746.389, "timestamp": "02:42:26", "text": "哦，这是统治地位。好的。"}, {"type": "subtitle", "time": 9752.95, "timestamp": "02:42:32", "text": "老兄，两只金刚狼。小菲斯去"}, {"type": "subtitle", "time": 9756.469, "timestamp": "02:42:36", "text": "和兄弟在一起简直疯了。搞什么鬼？"}, {"type": "subtitle", "time": 9757.99, "timestamp": "02:42:37", "text": "那是什么？"}, {"type": "subtitle", "time": 9759.99, "timestamp": "02:42:39", "text": "[音乐]"}, {"type": "subtitle", "time": 9762.55, "timestamp": "02:42:42", "text": "兄弟，我被骗了。"}, {"type": "subtitle", "time": 9764.95, "timestamp": "02:42:44", "text": "是啊，就是这样。他们是"}, {"type": "subtitle", "time": 9767.75, "timestamp": "02:42:47", "text": "全部。一击。过来。"}, {"type": "subtitle", "time": 9775.91, "timestamp": "02:42:55", "text": "拥抱光明吧。终于可以得到了"}, {"type": "subtitle", "time": 9777.67, "timestamp": "02:42:57", "text": "糟糕，我的鼠标。他妈的。发生了什么"}]
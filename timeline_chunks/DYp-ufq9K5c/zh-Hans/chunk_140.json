[{"type": "subtitle", "time": 8400.389, "timestamp": "02:20:00", "text": "那里有锁链之类的东西，哦"}, {"type": "subtitle", "time": 8407.99, "timestamp": "02:20:07", "text": "我知道。就像太多冗长的东西一样"}, {"type": "subtitle", "time": 8410.55, "timestamp": "02:20:10", "text": "就像透明的侧面，哦，它们是"}, {"type": "subtitle", "time": 8413.03, "timestamp": "02:20:13", "text": "可以藏身的奇怪角落和缝隙"}, {"type": "subtitle", "time": 8435.03, "timestamp": "02:20:35", "text": "办公室里的魔法。"}, {"type": "subtitle", "time": 8437.309, "timestamp": "02:20:37", "text": "我的天哪。"}, {"type": "subtitle", "time": 8440.55, "timestamp": "02:20:40", "text": "哦。哦好的。"}, {"type": "subtitle", "time": 8444.15, "timestamp": "02:20:44", "text": "实际上就在出生点里面。哇。"}, {"type": "subtitle", "time": 8447.349, "timestamp": "02:20:47", "text": "不客气。"}, {"type": "subtitle", "time": 8448.349, "timestamp": "02:20:48", "text": "而这些"}, {"type": "subtitle", "time": 8450.309, "timestamp": "02:20:50", "text": "治疗师们，他们越来越蠢了。我们的"}, {"type": "subtitle", "time": 8452.95, "timestamp": "02:20:52", "text": "治疗师会把目光移开大约两分钟。"}]
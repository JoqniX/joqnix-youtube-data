[{"type": "subtitle", "time": 9305.03, "timestamp": "02:35:05", "text": "[音乐]"}, {"type": "subtitle", "time": 9307.51, "timestamp": "02:35:07", "text": "抓住它。"}, {"type": "subtitle", "time": 9309.99, "timestamp": "02:35:09", "text": "准备。坏人来了。哦，"}, {"type": "subtitle", "time": 9314.55, "timestamp": "02:35:14", "text": "奇怪的。请下来。哦，真奇怪。"}, {"type": "subtitle", "time": 9315.99, "timestamp": "02:35:15", "text": "是的，球队表现相当不错。我的团队是"}, {"type": "subtitle", "time": 9318.15, "timestamp": "02:35:18", "text": "坚硬的。我们当时就觉得很伤心。我们"}, {"type": "subtitle", "time": 9320.95, "timestamp": "02:35:20", "text": "第一场没赢。"}, {"type": "subtitle", "time": 9324.79, "timestamp": "02:35:24", "text": "我们走吧。我们走吧。我们走吧。"}, {"type": "subtitle", "time": 9327.429, "timestamp": "02:35:27", "text": "我们今天偷窥一下。抱歉了，查德。我"}, {"type": "subtitle", "time": 9330.23, "timestamp": "02:35:30", "text": "气氛变得有些安静。我必须锁好门。"}, {"type": "subtitle", "time": 9332.95, "timestamp": "02:35:32", "text": "他必须集中注意力，伙计们。快点。我曾"}, {"type": "subtitle", "time": 9335.75, "timestamp": "02:35:35", "text": "锁定目标。能有50个欢呼声吗？"}, {"type": "subtitle", "time": 9337.99, "timestamp": "02:35:37", "text": "对他来说？是的。这是怎么回事？是的。 50"}, {"type": "subtitle", "time": 9339.79, "timestamp": "02:35:39", "text": "干杯。快点。来"}, {"type": "subtitle", "time": 9344.469, "timestamp": "02:35:44", "text": "在。好的。 50位幸运儿。哟，兄弟。什么"}, {"type": "subtitle", "time": 9353.91, "timestamp": "02:35:53", "text": "呃，你得给他点什么。什么"}, {"type": "subtitle", "time": 9356.07, "timestamp": "02:35:56", "text": "这是在说什么？"}, {"type": "subtitle", "time": 9358.23, "timestamp": "02:35:58", "text": "我希望你们都能找到好伴侣。"}]
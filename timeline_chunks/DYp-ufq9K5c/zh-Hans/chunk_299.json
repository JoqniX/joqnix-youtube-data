[{"type": "subtitle", "time": 17941.11, "timestamp": "04:59:01", "text": "类似游戏。好的，我走了。"}, {"type": "subtitle", "time": 17943.75, "timestamp": "04:59:03", "text": "让你知道这样没关系。我想测试一下这个"}, {"type": "subtitle", "time": 17945.35, "timestamp": "04:59:05", "text": "出去。"}, {"type": "subtitle", "time": 17946.35, "timestamp": "04:59:06", "text": "那是"}, {"type": "subtitle", "time": 17950.15, "timestamp": "04:59:10", "text": "离线。我可以继续吗？等待，"}, {"type": "subtitle", "time": 17952.59, "timestamp": "04:59:12", "text": "我该如何更改？"}, {"type": "subtitle", "time": 17956.59, "timestamp": "04:59:16", "text": "事物？无论我做了什么。"}, {"type": "subtitle", "time": 17959.948, "timestamp": "04:59:19", "text": "呃，我不会编辑"}, {"type": "subtitle", "time": 17967.91, "timestamp": "04:59:27", "text": "这片偏远的屋顶。如果我删除它，会怎么样？"}, {"type": "subtitle", "time": 17970.51, "timestamp": "04:59:30", "text": "我失去了我的"}, {"type": "subtitle", "time": 17973.35, "timestamp": "04:59:33", "text": "世界？等等，如果我……我会失去我的世界吗？"}, {"type": "subtitle", "time": 17975.51, "timestamp": "04:59:35", "text": "删除它？我的天啊，这太……"}, {"type": "subtitle", "time": 17983.948, "timestamp": "04:59:43", "text": "真实的。呃，这有点让人困惑。如果什么"}, {"type": "subtitle", "time": 17987.75, "timestamp": "04:59:47", "text": "我等等，你觉得我会删除等等吗？"}, {"type": "subtitle", "time": 17991.12, "timestamp": "04:59:51", "text": "我很害怕。别别别别别"}, {"type": "subtitle", "time": 17996.67, "timestamp": "04:59:56", "text": "[音乐]"}]
[{"type": "subtitle", "time": 6542.629, "timestamp": "01:49:02", "text": "直接把墙打通。"}, {"type": "subtitle", "time": 6549.51, "timestamp": "01:49:09", "text": "哦，他有武器，很危险，错！"}, {"type": "subtitle", "time": 6552.709, "timestamp": "01:49:12", "text": "方式。他只中了一枪，就是这样。"}, {"type": "subtitle", "time": 6563.109, "timestamp": "01:49:23", "text": "顺便说一句，我超喜欢鹰眼的那款皮肤。"}, {"type": "subtitle", "time": 6565.83, "timestamp": "01:49:25", "text": "那首是我最喜欢的。新的那个。不，"}, {"type": "subtitle", "time": 6573.83, "timestamp": "01:49:33", "text": "好的。是的。"}, {"type": "subtitle", "time": 6576.87, "timestamp": "01:49:36", "text": "就像漫画里还原度很高的皮肤一样。喜欢这个"}, {"type": "subtitle", "time": 6578.39, "timestamp": "01:49:38", "text": "一。"}, {"type": "subtitle", "time": 6580.149, "timestamp": "01:49:40", "text": "漫画里你没戴眼镜。"}, {"type": "subtitle", "time": 6582.87, "timestamp": "01:49:42", "text": "准确的。什么？真是见鬼了。他来了"}, {"type": "subtitle", "time": 6585.189, "timestamp": "01:49:45", "text": "进入我的……不，其实不是。我杀了谁？它"}, {"type": "subtitle", "time": 6587.109, "timestamp": "01:49:47", "text": "是《复仇者联盟》电视剧之一。"}, {"type": "subtitle", "time": 6589.75, "timestamp": "01:49:49", "text": "他戴着眼镜的卡通片"}, {"type": "subtitle", "time": 6592.31, "timestamp": "01:49:52", "text": "还有那短发。我喜欢那一个。我"}, {"type": "subtitle", "time": 6594.149, "timestamp": "01:49:54", "text": "也就是说，这基本上就是他在剧中的造型。"}, {"type": "subtitle", "time": 6595.91, "timestamp": "01:49:55", "text": "电影也一样，对吧？短发"}, {"type": "subtitle", "time": 6598.55, "timestamp": "01:49:58", "text": "以及所有的一切。我的天哪，他来了"}]
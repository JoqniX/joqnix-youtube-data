[{"type": "subtitle", "time": 16020.269, "timestamp": "04:27:00", "text": "工作台？这是什么酷炫的东西？"}, {"type": "subtitle", "time": 16023.75, "timestamp": "04:27:03", "text": "机械？这里还有一台织布机。什么"}, {"type": "subtitle", "time": 16027.07, "timestamp": "04:27:07", "text": "这是另一个区域吗？这也是一种舞蹈吗？"}, {"type": "subtitle", "time": 16030.75, "timestamp": "04:27:10", "text": "到地板上跳舞什么的？我不"}, {"type": "subtitle", "time": 16033.429, "timestamp": "04:27:13", "text": "知道。这是什么？太酷了！我"}, {"type": "subtitle", "time": 16036.309, "timestamp": "04:27:16", "text": "看看这装修风格。等等，我在哪里？"}, {"type": "subtitle", "time": 16039.469, "timestamp": "04:27:19", "text": "我去吗？这是哪里？"}, {"type": "subtitle", "time": 16042.349, "timestamp": "04:27:22", "text": "呃，这是哪里？我迷路了。"}, {"type": "subtitle", "time": 16045.87, "timestamp": "04:27:25", "text": "呃，打电话。"}, {"type": "subtitle", "time": 16048.87, "timestamp": "04:27:28", "text": "哇，这游戏太酷了。我想要"}, {"type": "subtitle", "time": 16053.469, "timestamp": "04:27:33", "text": "努力奋斗吧，兄弟。或者别的什么。不。嗯，"}, {"type": "subtitle", "time": 16055.95, "timestamp": "04:27:35", "text": "我看到"}, {"type": "subtitle", "time": 16058.229, "timestamp": "04:27:38", "text": "钥匙。想象一下你可以锁上你的"}, {"type": "subtitle", "time": 16060.229, "timestamp": "04:27:40", "text": "橱柜之类的东西。那将是如此。"}, {"type": "subtitle", "time": 16063.269, "timestamp": "04:27:43", "text": "实际的。实际的。这是一场狩猎"}, {"type": "subtitle", "time": 16064.269, "timestamp": "04:27:44", "text": "粗暴"}, {"type": "subtitle", "time": 16067.229, "timestamp": "04:27:47", "text": "步枪。好的"}, {"type": "subtitle", "time": 16071.87, "timestamp": "04:27:51", "text": "画画。哦，楼上"}, {"type": "subtitle", "time": 16077.229, "timestamp": "04:27:57", "text": "版本。很棒的装饰。好的"}]
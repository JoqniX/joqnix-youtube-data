[{"type": "subtitle", "time": 8640.389, "timestamp": "02:24:00", "text": "技能混乱能让你陷入困境吗？"}, {"type": "subtitle", "time": 8642.309, "timestamp": "02:24:02", "text": "隐形备用账号？不。对。她走了"}, {"type": "subtitle", "time": 8649.27, "timestamp": "02:24:09", "text": "对啊，因为这是秒杀，对吧？哦，"}, {"type": "subtitle", "time": 8653.27, "timestamp": "02:24:13", "text": "她只有一次机会。雷神。我"}, {"type": "subtitle", "time": 8655.349, "timestamp": "02:24:15", "text": "知道通往复仇者联盟的路。该死，他得手了"}, {"type": "subtitle", "time": 8656.95, "timestamp": "02:24:16", "text": "一。"}, {"type": "subtitle", "time": 8660.03, "timestamp": "02:24:20", "text": "不，不是韩国松鼠。"}, {"type": "subtitle", "time": 8668.469, "timestamp": "02:24:28", "text": "被推出去，你知道的。哦天哪，他没事。"}, {"type": "subtitle", "time": 8695.03, "timestamp": "02:24:55", "text": "你看，我不知道为什么人们会说奇怪。"}, {"type": "subtitle", "time": 8696.87, "timestamp": "02:24:56", "text": "另类风格太难驾驭了。我刚收到"}]
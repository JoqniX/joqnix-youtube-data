[{"type": "subtitle", "time": 16154.11, "timestamp": "04:29:14", "text": "哇，老兄。该死，这太……"}, {"type": "subtitle", "time": 16157.309, "timestamp": "04:29:17", "text": "凉爽的。我还想去"}, {"type": "subtitle", "time": 16158.83, "timestamp": "04:29:18", "text": "这"}, {"type": "subtitle", "time": 16161.91, "timestamp": "04:29:21", "text": "等级。那意味着你一直在努力奋斗。"}, {"type": "subtitle", "time": 16174.55, "timestamp": "04:29:34", "text": "哦，是史蒂夫·谢帕尔。哦，是这个。"}, {"type": "subtitle", "time": 16177.91, "timestamp": "04:29:37", "text": "你付出了很多努力。已升级到 com"}, {"type": "subtitle", "time": 16180.63, "timestamp": "04:29:40", "text": "车辆运输船已完全"}, {"type": "subtitle", "time": 16182.469, "timestamp": "04:29:42", "text": "制作台上的库存和用于"}, {"type": "subtitle", "time": 16184.71, "timestamp": "04:29:44", "text": "贮存。六张帆。四钇"}, {"type": "subtitle", "time": 16188.269, "timestamp": "04:29:48", "text": "发动机。四张床，安全门"}, {"type": "subtitle", "time": 16190.87, "timestamp": "04:29:50", "text": "通往船体某一部分的门"}, {"type": "subtitle", "time": 16194.349, "timestamp": "04:29:54", "text": "需要。发展中的港口。哦，我的天"}, {"type": "subtitle", "time": 16199.389, "timestamp": "04:29:59", "text": "上帝。真是太糟糕了！"}]
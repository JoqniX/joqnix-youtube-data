[{"type": "subtitle", "time": 2520.91, "timestamp": "00:42:00", "text": "滚出去！"}, {"type": "subtitle", "time": 2523.589, "timestamp": "00:42:03", "text": "有时候他就是这样"}, {"type": "subtitle", "time": 2526.23, "timestamp": "00:42:06", "text": "二。"}, {"type": "subtitle", "time": 2528.47, "timestamp": "00:42:08", "text": "是时候做出改变了，包括"}, {"type": "subtitle", "time": 2530.63, "timestamp": "00:42:10", "text": "哪一边？那真是太棒了！"}, {"type": "subtitle", "time": 2532.829, "timestamp": "00:42:12", "text": "那是"}, {"type": "subtitle", "time": 2535.91, "timestamp": "00:42:15", "text": "极好的。呃，"}, {"type": "subtitle", "time": 2537.75, "timestamp": "00:42:17", "text": "我们先争取第一分。如果"}, {"type": "subtitle", "time": 2540.95, "timestamp": "00:42:20", "text": "他们赢得了第一分。"}, {"type": "subtitle", "time": 2542.55, "timestamp": "00:42:22", "text": "如果他们赢下第一分，我就走。"}, {"type": "subtitle", "time": 2544.95, "timestamp": "00:42:24", "text": "切换回先赢，因为那样"}, {"type": "subtitle", "time": 2546.829, "timestamp": "00:42:26", "text": "钢铁侠是"}, {"type": "subtitle", "time": 2553.51, "timestamp": "00:42:33", "text": "再次。这游戏太棒了，兄弟。这"}, {"type": "subtitle", "time": 2564.43, "timestamp": "00:42:44", "text": "[音乐]"}, {"type": "subtitle", "time": 2566.95, "timestamp": "00:42:46", "text": "炸弹。顺便问一下各位，如果你们在这里的话，"}, {"type": "subtitle", "time": 2572.91, "timestamp": "00:42:52", "text": "溪流。如果你喜欢我，就喜欢这个直播吧。"}, {"type": "subtitle", "time": 2577.589, "timestamp": "00:42:57", "text": "伴侣。你们好像喜欢我。他们会是"}]
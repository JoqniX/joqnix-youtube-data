[{"type": "subtitle", "time": 4981.99, "timestamp": "01:23:01", "text": "因为她非常讨厌Homeow。和"}, {"type": "subtitle", "time": 4984.07, "timestamp": "01:23:04", "text": "我心想，“哦，天哪，我讨厌家。”"}, {"type": "subtitle", "time": 4987.43, "timestamp": "01:23:07", "text": "出色地。这就是我离开的原因。“我的天哪。哦"}, {"type": "subtitle", "time": 4989.11, "timestamp": "01:23:09", "text": "我的上帝。"}, {"type": "subtitle", "time": 4991.59, "timestamp": "01:23:11", "text": "太有共鸣了。"}, {"type": "subtitle", "time": 4993.99, "timestamp": "01:23:13", "text": "好的。你们要禁什么？"}, {"type": "subtitle", "time": 4995.59, "timestamp": "01:23:15", "text": "我禁止的是什么？我的队友要走了"}, {"type": "subtitle", "time": 4999.27, "timestamp": "01:23:19", "text": "禁止它。好的。我只是看看。我当时"}, {"type": "subtitle", "time": 5001.189, "timestamp": "01:23:21", "text": "只是看看有没有屎"}, {"type": "subtitle", "time": 5004.629, "timestamp": "01:23:24", "text": "已禁止。我只是看看。我只想"}, {"type": "subtitle", "time": 5006.75, "timestamp": "01:23:26", "text": "跟他谈谈。我想和……谈谈"}, {"type": "subtitle", "time": 5009.59, "timestamp": "01:23:29", "text": "他。是的。你们都会被禁言。"}, {"type": "subtitle", "time": 5015.27, "timestamp": "01:23:35", "text": "好的，让我来告诉你一下封禁系统。"}, {"type": "subtitle", "time": 5017.27, "timestamp": "01:23:37", "text": "比如服务器之类的东西。"}, {"type": "subtitle", "time": 5019.03, "timestamp": "01:23:39", "text": "新加坡的朋友们，你们将会看到格鲁特！"}, {"type": "subtitle", "time": 5021.51, "timestamp": "01:23:41", "text": "乐队和蜘蛛侠都遭到了很多禁令。在"}, {"type": "subtitle", "time": 5024.47, "timestamp": "01:23:44", "text": "欧盟服务器，你会说Luna"}, {"type": "subtitle", "time": 5028.07, "timestamp": "01:23:48", "text": "还有格鲁特。没关系。所以，格鲁特是"}, {"type": "subtitle", "time": 5031.99, "timestamp": "01:23:51", "text": "普遍存在的共同点"}, {"type": "subtitle", "time": 5035.43, "timestamp": "01:23:55", "text": "兄弟。这些人都是白痴。"}, {"type": "subtitle", "time": 5037.91, "timestamp": "01:23:57", "text": "在北美服务器，他们经常禁用格鲁特。"}, {"type": "subtitle", "time": 5039.99, "timestamp": "01:23:59", "text": "也一样。我的朋友跟我说男孩"}]
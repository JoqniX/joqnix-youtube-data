[{"type": "subtitle", "time": 7501.189, "timestamp": "02:05:01", "text": "像猎豹一样，猎豹图案的嗯"}, {"type": "subtitle", "time": 7503.629, "timestamp": "02:05:03", "text": "领带。哦，"}, {"type": "subtitle", "time": 7506.95, "timestamp": "02:05:06", "text": "呃，纳米。"}, {"type": "subtitle", "time": 7508.79, "timestamp": "02:05:08", "text": "对，我觉得是娜美什么的。"}, {"type": "subtitle", "time": 7511.109, "timestamp": "02:05:11", "text": "就是这样。是的。是的。我当时正在观看"}, {"type": "subtitle", "time": 7513.35, "timestamp": "02:05:13", "text": "后来，就变成了动漫角色扮演。我是"}, {"type": "subtitle", "time": 7514.709, "timestamp": "02:05:14", "text": "比如，“哇，这太酷了。”和"}, {"type": "subtitle", "time": 7517.589, "timestamp": "02:05:17", "text": "然后他就像解开外套扣子一样，"}, {"type": "subtitle", "time": 7520.709, "timestamp": "02:05:20", "text": "我看到了她们巨大的乳房。我已经"}, {"type": "subtitle", "time": 7523.669, "timestamp": "02:05:23", "text": "从未见过，我的天哪。好的，应该"}, {"type": "subtitle", "time": 7526.31, "timestamp": "02:05:26", "text": "冷静点。我以前也是那样。我当时就想，"}, {"type": "subtitle", "time": 7529.75, "timestamp": "02:05:29", "text": "这太疯狂了。让我保存一下。"}, {"type": "subtitle", "time": 7532.229, "timestamp": "02:05:32", "text": "太不可思议了。我当时正试图打开"}, {"type": "subtitle", "time": 7534.07, "timestamp": "02:05:34", "text": "比利·威利聊天室，老兄，因为我当时"}, {"type": "subtitle", "time": 7535.669, "timestamp": "02:05:35", "text": "比如，“嗯，不知道有没有人？”"}, {"type": "subtitle", "time": 7538.07, "timestamp": "02:05:38", "text": "在比利比利那边。"}, {"type": "subtitle", "time": 7543.189, "timestamp": "02:05:43", "text": "呃，因为你知道Twitch，呃，我有Twitch账号。"}, {"type": "subtitle", "time": 7545.51, "timestamp": "02:05:45", "text": "网站上也有。 YouTube 就在这里"}, {"type": "subtitle", "time": 7548.149, "timestamp": "02:05:48", "text": "出色地。我当时想看看有没有"}, {"type": "subtitle", "time": 7549.75, "timestamp": "02:05:49", "text": "比利比利那边有人，因为就像"}, {"type": "subtitle", "time": 7553.03, "timestamp": "02:05:53", "text": "你知道我在比利比利"}, {"type": "subtitle", "time": 7555.75, "timestamp": "02:05:55", "text": "对吧？流媒体服务平台？真的"}, {"type": "subtitle", "time": 7557.39, "timestamp": "02:05:57", "text": "阴谋"}, {"type": "subtitle", "time": 7559.99, "timestamp": "02:05:59", "text": "我。那边有点混乱，这是怎么回事？"}]
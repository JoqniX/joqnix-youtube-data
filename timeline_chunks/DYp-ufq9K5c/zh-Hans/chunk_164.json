[{"type": "subtitle", "time": 9843.19, "timestamp": "02:44:03", "text": "等等，哈拉什来过这里。大坝"}, {"type": "subtitle", "time": 9845.19, "timestamp": "02:44:05", "text": "是的。是的，他刚走。他刚离开"}, {"type": "subtitle", "time": 9854.87, "timestamp": "02:44:14", "text": "我错过了。他真是太棒了。"}, {"type": "subtitle", "time": 9856.429, "timestamp": "02:44:16", "text": "我也是。我"}, {"type": "subtitle", "time": 9859.269, "timestamp": "02:44:19", "text": "做。呃，"}, {"type": "subtitle", "time": 9860.79, "timestamp": "02:44:20", "text": "我只想赶紧通关这个游戏。"}, {"type": "subtitle", "time": 9865.349, "timestamp": "02:44:25", "text": "我们可以玩。老兄，你花了很长时间。"}, {"type": "subtitle", "time": 9867.99, "timestamp": "02:44:27", "text": "我不得不喜欢"}, {"type": "subtitle", "time": 9872.15, "timestamp": "02:44:32", "text": "呃，做很多家务活吧，伙计。"}, {"type": "subtitle", "time": 9874.469, "timestamp": "02:44:34", "text": "洗衣服，洗盘子。我的天啊，"}, {"type": "subtitle", "time": 9878.51, "timestamp": "02:44:38", "text": "是 f。结束了。你是怎么赢的？"}, {"type": "subtitle", "time": 9881.59, "timestamp": "02:44:41", "text": "没关系。我现在的战绩是二胜一胜二"}, {"type": "subtitle", "time": 9883.51, "timestamp": "02:44:43", "text": "连胜。这是第三场比赛，"}, {"type": "subtitle", "time": 9886.55, "timestamp": "02:44:46", "text": "之后我们可以……这只是第三个"}, {"type": "subtitle", "time": 9888.71, "timestamp": "02:44:48", "text": "游戏。我以为你已经玩过七部曲了。"}, {"type": "subtitle", "time": 9890.95, "timestamp": "02:44:50", "text": "游戏。不，不，不，不，不。我正在"}, {"type": "subtitle", "time": 9892.309, "timestamp": "02:44:52", "text": "三连胜。这就是我"}, {"type": "subtitle", "time": 9894.07, "timestamp": "02:44:54", "text": "说道。我玩了大概八局游戏。"}, {"type": "subtitle", "time": 9896.55, "timestamp": "02:44:56", "text": "现在。"}, {"type": "subtitle", "time": 9898.55, "timestamp": "02:44:58", "text": "我的天啊。另外，你花了多少时间？"}]
[{"type": "subtitle", "time": 6966.07, "timestamp": "01:56:06", "text": "请帮个忙。"}, {"type": "subtitle", "time": 6967.75, "timestamp": "01:56:07", "text": "我会照顾好你的。从未想过我会"}, {"type": "subtitle", "time": 6969.35, "timestamp": "01:56:09", "text": "有"}, {"type": "subtitle", "time": 6973.149, "timestamp": "01:56:13", "text": "帮忙把车开过去。"}, {"type": "subtitle", "time": 6977.35, "timestamp": "01:56:17", "text": "车辆。这是不明飞行物。是的。你知道吗"}, {"type": "subtitle", "time": 6981.43, "timestamp": "01:56:21", "text": "这是什么意思？我的天啊。他正在做"}, {"type": "subtitle", "time": 6984.07, "timestamp": "01:56:24", "text": "执行策略。"}, {"type": "subtitle", "time": 6995.27, "timestamp": "01:56:35", "text": "哦，你好。哦，等等。他还活着。"}, {"type": "subtitle", "time": 6998.39, "timestamp": "01:56:38", "text": "好的。得到"}, {"type": "subtitle", "time": 7004.229, "timestamp": "01:56:44", "text": "救救我吧，伙计们。请治好我。那"}]
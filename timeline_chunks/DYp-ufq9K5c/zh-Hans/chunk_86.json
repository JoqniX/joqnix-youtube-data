[{"type": "subtitle", "time": 5163.51, "timestamp": "01:26:03", "text": "兄弟，我们能聊聊金刚狼的……"}, {"type": "subtitle", "time": 5166.79, "timestamp": "01:26:06", "text": "配音演员一直是金刚狼的配音演员。"}, {"type": "subtitle", "time": 5170.229, "timestamp": "01:26:10", "text": "从事配音工作二三十年了？"}, {"type": "subtitle", "time": 5172.07, "timestamp": "01:26:12", "text": "蜘蛛侠的配音演员。谁是"}, {"type": "subtitle", "time": 5175.59, "timestamp": "01:26:15", "text": "蜘蛛侠的配音演员是谁？"}, {"type": "subtitle", "time": 5178.709, "timestamp": "01:26:18", "text": "我的意思是，你知道，"}, {"type": "subtitle", "time": 5181.91, "timestamp": "01:26:21", "text": "并不真地。我不会撒谎。尤里"}, {"type": "subtitle", "time": 5185.03, "timestamp": "01:26:25", "text": "洛恩塔尔曾扮演过蜘蛛侠，但是……"}, {"type": "subtitle", "time": 5193.91, "timestamp": "01:26:33", "text": "你知道，他很酷。就像他本一样"}, {"type": "subtitle", "time": 5198.31, "timestamp": "01:26:38", "text": "10en 也一样。他是呃，Ske。我认为他是"}, {"type": "subtitle", "time": 5200.709, "timestamp": "01:26:40", "text": "还有《猎天使魔女》里的那个家伙。"}, {"type": "subtitle", "time": 5203.11, "timestamp": "01:26:43", "text": "我忘了他的名字。"}, {"type": "subtitle", "time": 5205.189, "timestamp": "01:26:45", "text": "窝棚。我们能治好我的伤吗？你能治愈吗？"}, {"type": "subtitle", "time": 5209.43, "timestamp": "01:26:49", "text": "我？窝棚。你已经完成了一半。"}, {"type": "subtitle", "time": 5211.99, "timestamp": "01:26:51", "text": "哦好的。我当时就想，你在说……"}, {"type": "subtitle", "time": 5215.35, "timestamp": "01:26:55", "text": "沙奎尔能治好你吗？"}, {"type": "subtitle", "time": 5219.03, "timestamp": "01:26:59", "text": "这是怎么回事？我只是想帮忙。呃，"}]
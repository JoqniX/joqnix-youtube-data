[{"type": "subtitle", "time": 15851.309, "timestamp": "04:24:11", "text": "我的天哪。什么是"}, {"type": "subtitle", "time": 15867.11, "timestamp": "04:24:27", "text": "灰尘。我的天啊。这是潜艇吗？"}, {"type": "subtitle", "time": 15874.229, "timestamp": "04:24:34", "text": "船？这看起来像是一艘未来飞船。"}, {"type": "subtitle", "time": 15877.51, "timestamp": "04:24:37", "text": "兄弟。我的天啊。这是什么？反应堆"}, {"type": "subtitle", "time": 15879.469, "timestamp": "04:24:39", "text": "有点儿"}, {"type": "subtitle", "time": 15882.95, "timestamp": "04:24:42", "text": "事物。这些东西看起来像"}, {"type": "subtitle", "time": 15885.309, "timestamp": "04:24:45", "text": "装饰品，但看起来像武器和"}, {"type": "subtitle", "time": 15892.389, "timestamp": "04:24:52", "text": "圣。我的天啊。看看这玻璃杯。看"}, {"type": "subtitle", "time": 15895.59, "timestamp": "04:24:55", "text": "那些花里胡哨的东西。有一个"}]
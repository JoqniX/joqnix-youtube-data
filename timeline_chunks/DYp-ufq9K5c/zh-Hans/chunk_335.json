[{"type": "subtitle", "time": 20101.27, "timestamp": "05:35:01", "text": "挖。简约的家具。如何获得"}, {"type": "subtitle", "time": 20109.628, "timestamp": "05:35:09", "text": "大型书架。"}, {"type": "subtitle", "time": 20113.19, "timestamp": "05:35:13", "text": "海盗铁矿遗址储藏。大抽屉。"}, {"type": "subtitle", "time": 20114.99, "timestamp": "05:35:14", "text": "木制的"}, {"type": "subtitle", "time": 20125.47, "timestamp": "05:35:25", "text": "废墟武器。燧石"}, {"type": "subtitle", "time": 20128.548, "timestamp": "05:35:28", "text": "盔甲。哦，你可以制作黑曜石盔甲。"}, {"type": "subtitle", "time": 20131.67, "timestamp": "05:35:31", "text": "哦，等等。如何获得皮革？"}, {"type": "subtitle", "time": 20134.23, "timestamp": "05:35:34", "text": "我们需要一张兽皮。哦，那是"}, {"type": "subtitle", "time": 20136.39, "timestamp": "05:35:36", "text": "我们没有的东西。但我认为呃"}, {"type": "subtitle", "time": 20138.868, "timestamp": "05:35:38", "text": "弗伦德盔甲更好。不，弗伦德"}, {"type": "subtitle", "time": 20143.51, "timestamp": "05:35:43", "text": "目前先用木制盔甲套装，因为我们需要"}, {"type": "subtitle", "time": 20145.67, "timestamp": "05:35:45", "text": "了解更多"}, {"type": "subtitle", "time": 20146.83, "timestamp": "05:35:46", "text": "呃"}, {"type": "subtitle", "time": 20151.23, "timestamp": "05:35:51", "text": "动物、热带动物和"}, {"type": "subtitle", "time": 20155.19, "timestamp": "05:35:55", "text": "东西。如果我们有一个鸡蛋，它们已经……了吗？"}, {"type": "subtitle", "time": 20157.35, "timestamp": "05:35:57", "text": "查看状态？我可以重新开始。"}, {"type": "subtitle", "time": 20159.868, "timestamp": "05:35:59", "text": "统计数据持续数小时。所以，我们会得到"}]
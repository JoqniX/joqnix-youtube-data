[{"type": "subtitle", "time": 18542.59, "timestamp": "05:09:02", "text": "那里？哦，木头"}, {"type": "subtitle", "time": 18546.07, "timestamp": "05:09:06", "text": "贮存。木箱。"}, {"type": "subtitle", "time": 18548.39, "timestamp": "05:09:08", "text": "我需要探索点。我需要一个"}, {"type": "subtitle", "time": 18550.35, "timestamp": "05:09:10", "text": "板。我需要"}, {"type": "subtitle", "time": 18552.27, "timestamp": "05:09:12", "text": "指甲。"}, {"type": "subtitle", "time": 18556.47, "timestamp": "05:09:16", "text": "呃，为什么会像这样被封锁起来？"}, {"type": "subtitle", "time": 18560.27, "timestamp": "05:09:20", "text": "银行存储。你需要去探索很多地方。"}, {"type": "subtitle", "time": 18569.03, "timestamp": "05:09:29", "text": "美好的。我需要做一块木板。我必须"}, {"type": "subtitle", "time": 18571.27, "timestamp": "05:09:31", "text": "我得弄些铜片，然后切割。如何"}, {"type": "subtitle", "time": 18573.91, "timestamp": "05:09:33", "text": "我能拿到铜片并进行切割吗？我该如何获得"}, {"type": "subtitle", "time": 18575.868, "timestamp": "05:09:35", "text": "铜"}, {"type": "subtitle", "time": 18578.708, "timestamp": "05:09:38", "text": "矿石？兄弟，要刷的东西太多了。"}, {"type": "subtitle", "time": 18586.48, "timestamp": "05:09:46", "text": "开锁。"}, {"type": "subtitle", "time": 18587.948, "timestamp": "05:09:47", "text": "[掌声]"}]
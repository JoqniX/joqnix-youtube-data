[{"type": "subtitle", "time": 17700.868, "timestamp": "04:55:00", "text": "一。你可以开始玩现有的同一款游戏"}, {"type": "subtitle", "time": 17703.67, "timestamp": "04:55:03", "text": "这也包括你发现的任何东西，除了"}, {"type": "subtitle", "time": 17706.31, "timestamp": "04:55:06", "text": "除了你一开始进入的那个之外"}, {"type": "subtitle", "time": 17709.63, "timestamp": "04:55:09", "text": "分享游戏。我个人感觉还行。"}, {"type": "subtitle", "time": 17717.51, "timestamp": "04:55:17", "text": "你可以独自开始游戏"}, {"type": "subtitle", "time": 17720.67, "timestamp": "04:55:20", "text": "时间，即使没有人。"}, {"type": "subtitle", "time": 17725.67, "timestamp": "04:55:25", "text": "好的。呃，免费等级和五三战斗"}, {"type": "subtitle", "time": 17727.23, "timestamp": "04:55:27", "text": "三。好的。"}, {"type": "subtitle", "time": 17734.39, "timestamp": "04:55:34", "text": "自由的。我唯一一次花钱是在"}, {"type": "subtitle", "time": 17735.99, "timestamp": "04:55:35", "text": "游戏当时正处于测试阶段并运行。"}, {"type": "subtitle", "time": 17756.15, "timestamp": "04:55:56", "text": "如果 O 断开其他设备的连接会发生什么？"}, {"type": "subtitle", "time": 17758.47, "timestamp": "04:55:58", "text": "继续玩吗？鲨鱼多久会来一次？"}]
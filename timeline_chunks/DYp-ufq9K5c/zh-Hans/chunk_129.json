[{"type": "subtitle", "time": 7742.55, "timestamp": "02:09:02", "text": "任务目标是占领任务区域。哦，"}, {"type": "subtitle", "time": 7752.069, "timestamp": "02:09:12", "text": "这靴子确实很硬，是吧？"}, {"type": "subtitle", "time": 7756.95, "timestamp": "02:09:16", "text": "你从哪里来？我们来自哪里？"}, {"type": "subtitle", "time": 7759.35, "timestamp": "02:09:19", "text": "我们来自印度。我想我来自"}, {"type": "subtitle", "time": 7761.51, "timestamp": "02:09:21", "text": "哦，是的。你，你是，是的，他来自"}, {"type": "subtitle", "time": 7763.51, "timestamp": "02:09:23", "text": "印度也是如此。确切地。我们来自"}, {"type": "subtitle", "time": 7770.149, "timestamp": "02:09:30", "text": "啊，好了。看起来像是任务"}, {"type": "subtitle", "time": 7772.39, "timestamp": "02:09:32", "text": "这片区域任你占领。五个人"}, {"type": "subtitle", "time": 7775.83, "timestamp": "02:09:35", "text": "我现在正在看比利的节目。我"}, {"type": "subtitle", "time": 7778.709, "timestamp": "02:09:38", "text": "终于找到乐趣了。该死。"}, {"type": "subtitle", "time": 7781.589, "timestamp": "02:09:41", "text": "我知道你很棒，你简直太厉害了。"}, {"type": "subtitle", "time": 7785.51, "timestamp": "02:09:45", "text": "说到呃"}, {"type": "subtitle", "time": 7787.83, "timestamp": "02:09:47", "text": "哦，他死了。你知道吗？我不能"}, {"type": "subtitle", "time": 7789.669, "timestamp": "02:09:49", "text": "认真想想怎么才能说一句虚假的赞美之词。所以，"}, {"type": "subtitle", "time": 7796.95, "timestamp": "02:09:56", "text": "对不起。为什么上面写着漫威？"}]
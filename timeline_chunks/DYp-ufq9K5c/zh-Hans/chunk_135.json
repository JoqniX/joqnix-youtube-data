[{"type": "subtitle", "time": 8102.629, "timestamp": "02:15:02", "text": "蜘蛛侠。"}, {"type": "subtitle", "time": 8104.87, "timestamp": "02:15:04", "text": "终极蜘蛛侠。"}, {"type": "subtitle", "time": 8107.589, "timestamp": "02:15:07", "text": "是的，他们去了……"}, {"type": "subtitle", "time": 8109.91, "timestamp": "02:15:09", "text": "蛮荒之地。"}, {"type": "subtitle", "time": 8112.95, "timestamp": "02:15:12", "text": "终极蜘蛛侠是什么来着？"}, {"type": "subtitle", "time": 8119.87, "timestamp": "02:15:19", "text": "糟糕，"}, {"type": "subtitle", "time": 8123.51, "timestamp": "02:15:23", "text": "黑暗系动漫。好的，就是这样。"}, {"type": "subtitle", "time": 8126.31, "timestamp": "02:15:26", "text": "我记得不是这样的。"}, {"type": "subtitle", "time": 8129.189, "timestamp": "02:15:29", "text": "这不是动画吗？我以为是这样。"}, {"type": "subtitle", "time": 8131.47, "timestamp": "02:15:31", "text": "不，不，确实如此。它"}, {"type": "subtitle", "time": 8135.669, "timestamp": "02:15:35", "text": "是。真是糟糕。那条狗真是太可爱了"}, {"type": "subtitle", "time": 8138.31, "timestamp": "02:15:38", "text": "烂透了的蜘蛛侠动画。我的天啊。"}, {"type": "subtitle", "time": 8140.79, "timestamp": "02:15:40", "text": "是的。是的。是的。就是他们"}, {"type": "subtitle", "time": 8143.149, "timestamp": "02:15:43", "text": "每隔5分钟就发出猴子叫声"}, {"type": "subtitle", "time": 8146.87, "timestamp": "02:15:46", "text": "几秒钟后，他们就展现出了肢体幽默。"}, {"type": "subtitle", "time": 8155.43, "timestamp": "02:15:55", "text": "兄弟，我小时候就看过那玩意儿。"}, {"type": "subtitle", "time": 8158.47, "timestamp": "02:15:58", "text": "我不知道，可能是迪士尼XD频道之类的。"}]
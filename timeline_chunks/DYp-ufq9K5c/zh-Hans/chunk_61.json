[{"type": "subtitle", "time": 3660.99, "timestamp": "01:01:00", "text": "男人？人们都在为那件事哭泣，嗯。"}, {"type": "subtitle", "time": 3663.75, "timestamp": "01:01:03", "text": "这场比赛的侧翼球员都向右突破了。"}, {"type": "subtitle", "time": 3666.95, "timestamp": "01:01:06", "text": "现在。兄弟，说说那些传单吧。难道我们不……"}, {"type": "subtitle", "time": 3668.309, "timestamp": "01:01:08", "text": "我要谈谈破损的传单"}, {"type": "subtitle", "time": 3671.51, "timestamp": "01:01:11", "text": "现在是这样吗？暴风女、钢铁侠和"}, {"type": "subtitle", "time": 3686.39, "timestamp": "01:01:26", "text": "你需要一支顶尖的团队才能赢得这场比赛。"}, {"type": "subtitle", "time": 3690.67, "timestamp": "01:01:30", "text": "一。我会稍微往下走一点，你"}, {"type": "subtitle", "time": 3696.03, "timestamp": "01:01:36", "text": "知道。因为我的团队禁赛了他们"}, {"type": "subtitle", "time": 3698.71, "timestamp": "01:01:38", "text": "人类。唉，我真应该选人类的。"}, {"type": "subtitle", "time": 3700.789, "timestamp": "01:01:40", "text": "所以他们没有禁止他入境。我挺不错的"}, {"type": "subtitle", "time": 3719.67, "timestamp": "01:01:59", "text": "哦，是的。叛逆的洛基也可以哦耶。"}]
[{"type": "subtitle", "time": 6063.83, "timestamp": "01:41:03", "text": "该死的。还是那个该死的蜘蛛侠。"}, {"type": "subtitle", "time": 6066.03, "timestamp": "01:41:06", "text": "我该这么做吗？"}, {"type": "subtitle", "time": 6070.229, "timestamp": "01:41:10", "text": "呃，我应该吗？"}, {"type": "subtitle", "time": 6073.31, "timestamp": "01:41:13", "text": "我猜也是。我是说，"}, {"type": "subtitle", "time": 6077.83, "timestamp": "01:41:17", "text": "我不想失去我的ELO评分。"}, {"type": "subtitle", "time": 6079.47, "timestamp": "01:41:19", "text": "想象一下如果情况一样的话"}, {"type": "subtitle", "time": 6082.87, "timestamp": "01:41:22", "text": "再次。再次？"}, {"type": "subtitle", "time": 6084.95, "timestamp": "01:41:24", "text": "我希望如此。我认为这将是"}, {"type": "subtitle", "time": 6087.109, "timestamp": "01:41:27", "text": "同一件事。或者他们会……"}, {"type": "subtitle", "time": 6089.59, "timestamp": "01:41:29", "text": "又是蜘蛛侠？他们是蜘蛛侠。好的，"}, {"type": "subtitle", "time": 6092.149, "timestamp": "01:41:32", "text": "好了。"}, {"type": "subtitle", "time": 6093.83, "timestamp": "01:41:33", "text": "再次。"}, {"type": "subtitle", "time": 6097.27, "timestamp": "01:41:37", "text": "这款FPS游戏的右侧。我希望我能做到"}, {"type": "subtitle", "time": 6100.07, "timestamp": "01:41:40", "text": "又来了一些。"}, {"type": "subtitle", "time": 6102.709, "timestamp": "01:41:42", "text": "嘿，你能行的。"}, {"type": "subtitle", "time": 6105.59, "timestamp": "01:41:45", "text": "但愿如此，伙计。我希望如此。诚实地，"}, {"type": "subtitle", "time": 6106.95, "timestamp": "01:41:46", "text": "我的帧率提高了"}, {"type": "subtitle", "time": 6108.709, "timestamp": "01:41:48", "text": "老兄，是 PlayStation。我不知道该怎么做。哦，"}, {"type": "subtitle", "time": 6113.31, "timestamp": "01:41:53", "text": "是的。当然，这是一台PlayStation游戏机。"}, {"type": "subtitle", "time": 6116.27, "timestamp": "01:41:56", "text": "什么？游戏规则是一样的。播放此内容"}, {"type": "subtitle", "time": 6119.189, "timestamp": "01:41:59", "text": "游戏。直播这款游戏的人是"}]
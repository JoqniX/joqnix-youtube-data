[{"type": "subtitle", "time": 19708.15, "timestamp": "05:28:28", "text": "圣。我觉得我被困在了白昼里。"}, {"type": "subtitle", "time": 19711.91, "timestamp": "05:28:31", "text": "现在，夜幕从未降临。是"}, {"type": "subtitle", "time": 19715.47, "timestamp": "05:28:35", "text": "我甚至在第一天就卡住了。"}, {"type": "subtitle", "time": 19724.75, "timestamp": "05:28:44", "text": "有趣的。简单的衣服，小"}, {"type": "subtitle", "time": 19727.83, "timestamp": "05:28:47", "text": "芽。嘿，我现在需要穿上盔甲。"}, {"type": "subtitle", "time": 19730.628, "timestamp": "05:28:50", "text": "弗伦德盔甲。"}]
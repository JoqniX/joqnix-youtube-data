[{"type": "subtitle", "time": 5404.95, "timestamp": "01:30:04", "text": "再次搬家。"}, {"type": "subtitle", "time": 5407.35, "timestamp": "01:30:07", "text": "哦，对，干掉他。快点。快点。"}, {"type": "subtitle", "time": 5409.189, "timestamp": "01:30:09", "text": "我抓到他了。哦，蜘蛛侠做了件大事。"}, {"type": "subtitle", "time": 5411.51, "timestamp": "01:30:11", "text": "我们走吧。走吧，兄弟。你得到一个网络。"}, {"type": "subtitle", "time": 5413.51, "timestamp": "01:30:13", "text": "你得到一个网络。情况会变得棘手。我是"}, {"type": "subtitle", "time": 5414.95, "timestamp": "01:30:14", "text": "去抓船长哦，绝不"}, {"type": "subtitle", "time": 5422.47, "timestamp": "01:30:22", "text": "美国队长。过来，伙计。我想"}, {"type": "subtitle", "time": 5424.47, "timestamp": "01:30:24", "text": "我只是想……我只是想聊聊。我"}, {"type": "subtitle", "time": 5426.39, "timestamp": "01:30:26", "text": "就想聊聊天。我只想杀人"}, {"type": "subtitle", "time": 5434.709, "timestamp": "01:30:34", "text": "那是我在PPM的领导，不好意思。"}, {"type": "subtitle", "time": 5437.59, "timestamp": "01:30:37", "text": "老兄。我勒个去？我拿到了克隆版。我"}, {"type": "subtitle", "time": 5440.79, "timestamp": "01:30:40", "text": "没收到搬迁通知。该死的。一个"}, {"type": "subtitle", "time": 5442.95, "timestamp": "01:30:42", "text": "怒火依旧未消。快点。哦，我"}, {"type": "subtitle", "time": 5453.03, "timestamp": "01:30:53", "text": "哦，搞混了。"}, {"type": "subtitle", "time": 5456.39, "timestamp": "01:30:56", "text": "好的。月亮像坦克一样承受住了冲击。"}]
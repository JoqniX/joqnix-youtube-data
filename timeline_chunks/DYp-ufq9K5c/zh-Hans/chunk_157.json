[{"type": "subtitle", "time": 9421.27, "timestamp": "02:37:01", "text": "对，那真是太酷了"}, {"type": "subtitle", "time": 9423.03, "timestamp": "02:37:03", "text": "概念"}, {"type": "subtitle", "time": 9425.11, "timestamp": "02:37:05", "text": "就是这样，但很多人并不理解这一点。"}, {"type": "subtitle", "time": 9427.429, "timestamp": "02:37:07", "text": "X战警宇宙就像一个非常精选的宇宙。"}, {"type": "subtitle", "time": 9431.11, "timestamp": "02:37:11", "text": "很少有人喜欢这头野兽，通常来说，这头野兽"}, {"type": "subtitle", "time": 9433.03, "timestamp": "02:37:13", "text": "呃，就像他最初那样，他只是什么"}, {"type": "subtitle", "time": 9435.27, "timestamp": "02:37:15", "text": "运动能力很强，他的脚也像"}, {"type": "subtitle", "time": 9438.469, "timestamp": "02:37:18", "text": "像大脚怪一样的手。是的。然后，他就"}, {"type": "subtitle", "time": 9441.27, "timestamp": "02:37:21", "text": "后来变成了那种蓝色的猫科动物形态"}, {"type": "subtitle", "time": 9443.51, "timestamp": "02:37:23", "text": "在。是的。"}, {"type": "subtitle", "time": 9447.51, "timestamp": "02:37:27", "text": "还有谁？冰人，对吧？冰人"}, {"type": "subtitle", "time": 9449.429, "timestamp": "02:37:29", "text": "通常"}, {"type": "subtitle", "time": 9452.07, "timestamp": "02:37:32", "text": "他通常都能像这样，你"}, {"type": "subtitle", "time": 9454.71, "timestamp": "02:37:34", "text": "我知道，做冰上运动之类的，但之后……"}, {"type": "subtitle", "time": 9458.389, "timestamp": "02:37:38", "text": "他可以把自己变成冰。哦，那是"}, {"type": "subtitle", "time": 9460.63, "timestamp": "02:37:40", "text": "他的第二个。是的，那是次要的。"}, {"type": "subtitle", "time": 9464.23, "timestamp": "02:37:44", "text": "事物。呃，我觉得金刚狼也有一个。"}, {"type": "subtitle", "time": 9466.23, "timestamp": "02:37:46", "text": "在其中一部漫画里，他死了，"}, {"type": "subtitle", "time": 9467.389, "timestamp": "02:37:47", "text": "来"}, {"type": "subtitle", "time": 9472.11, "timestamp": "02:37:52", "text": "后退。呃，就像，呃，我想，就像没有"}, {"type": "subtitle", "time": 9474.71, "timestamp": "02:37:54", "text": "他能立刻得到你知道的碘"}, {"type": "subtitle", "time": 9478.11, "timestamp": "02:37:58", "text": "他好像速度更快、更敏捷了。他"}]
[{"type": "subtitle", "time": 7380.55, "timestamp": "02:03:00", "text": "主。一直在这儿放松，玩玩游戏。"}, {"type": "subtitle", "time": 7382.75, "timestamp": "02:03:02", "text": "马尔复兴。等待"}, {"type": "subtitle", "time": 7385.87, "timestamp": "02:03:05", "text": "乔克回来吧，祝你一切顺利"}, {"type": "subtitle", "time": 7388.95, "timestamp": "02:03:08", "text": "时间。一直很放松。我重新开始工作了。"}, {"type": "subtitle", "time": 7392.95, "timestamp": "02:03:12", "text": "我大概几个小时前刚下班。你"}, {"type": "subtitle", "time": 7395.669, "timestamp": "02:03:15", "text": "知道就是这样，你知道工作是怎么回事"}, {"type": "subtitle", "time": 7397.55, "timestamp": "02:03:17", "text": "是"}, {"type": "subtitle", "time": 7400.55, "timestamp": "02:03:20", "text": "有时。是的，真的很累。我"}, {"type": "subtitle", "time": 7403.229, "timestamp": "02:03:23", "text": "感觉像很凉爽一样"}, {"type": "subtitle", "time": 7406.149, "timestamp": "02:03:26", "text": "淋浴。我给自己泡了杯茶。哦"}, {"type": "subtitle", "time": 7409.03, "timestamp": "02:03:29", "text": "我的天，太棒了，兄弟。一些"}, {"type": "subtitle", "time": 7413.189, "timestamp": "02:03:33", "text": "就像下班后喝一杯清爽的茶一样"}, {"type": "subtitle", "time": 7415.27, "timestamp": "02:03:35", "text": "来之后洗了个澡"}, {"type": "subtitle", "time": 7419.47, "timestamp": "02:03:39", "text": "家。老兄，太棒了。所以，我刚刚"}, {"type": "subtitle", "time": 7421.79, "timestamp": "02:03:41", "text": "放松，"}, {"type": "subtitle", "time": 7427.35, "timestamp": "02:03:47", "text": "你知道，男孩子们只是玩得开心而已。"}, {"type": "subtitle", "time": 7428.91, "timestamp": "02:03:48", "text": "我希望我能查一下"}, {"type": "subtitle", "time": 7432.39, "timestamp": "02:03:52", "text": "Twitch上的聊天记录也是如此。我的意思是，不，"}]
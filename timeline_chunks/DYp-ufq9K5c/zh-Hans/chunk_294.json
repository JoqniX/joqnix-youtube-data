[{"type": "subtitle", "time": 17642.27, "timestamp": "04:54:02", "text": "[音乐]"}, {"type": "subtitle", "time": 17646.03, "timestamp": "04:54:06", "text": "服装。但是等等，主机共享"}, {"type": "subtitle", "time": 17650.23, "timestamp": "04:54:10", "text": "玩游戏的话，你会得到 200 MB 的空间，你会得到"}, {"type": "subtitle", "time": 17653.31, "timestamp": "04:54:13", "text": "300 MB，500"}, {"type": "subtitle", "time": 17657.23, "timestamp": "04:54:17", "text": "MB。什么？那是什么情况？等待。"}, {"type": "subtitle", "time": 17660.43, "timestamp": "04:54:20", "text": "托管。住口。那里"}, {"type": "subtitle", "time": 17663.83, "timestamp": "04:54:23", "text": "游戏渲染淋浴活跃其中一个"}, {"type": "subtitle", "time": 17667.43, "timestamp": "04:54:27", "text": "三。等等，我刚才点了什么？等待，"}, {"type": "subtitle", "time": 17671.35, "timestamp": "04:54:31", "text": "我做了什么？设置了“是的，我只做了”"}, {"type": "subtitle", "time": 17674.788, "timestamp": "04:54:34", "text": "就是这个。哦，等等。我现在很害怕。"}, {"type": "subtitle", "time": 17678.35, "timestamp": "04:54:38", "text": "分享游戏。好的，让我看看"}, {"type": "subtitle", "time": 17689.27, "timestamp": "04:54:49", "text": "嗯，分享游戏简而言之就是一个人"}, {"type": "subtitle", "time": 17690.948, "timestamp": "04:54:50", "text": "你和任何人都可以选择玩的游戏"}, {"type": "subtitle", "time": 17692.948, "timestamp": "04:54:52", "text": "任何时候，无论是否有人"}, {"type": "subtitle", "time": 17694.948, "timestamp": "04:54:54", "text": "是否需要进行主机托管。基本上有"}, {"type": "subtitle", "time": 17696.708, "timestamp": "04:54:56", "text": "运行专用服务器的优势"}, {"type": "subtitle", "time": 17698.39, "timestamp": "04:54:58", "text": "无需实际运行或付费"}]
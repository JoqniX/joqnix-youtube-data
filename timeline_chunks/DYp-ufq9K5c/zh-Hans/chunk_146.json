[{"type": "subtitle", "time": 8765.75, "timestamp": "02:26:05", "text": "缩短至30秒。"}, {"type": "subtitle", "time": 8769.27, "timestamp": "02:26:09", "text": "把它推回去。神圣的用眼推"}, {"type": "subtitle", "time": 8771.429, "timestamp": "02:26:11", "text": "阿伽莫托的。"}, {"type": "subtitle", "time": 8774.389, "timestamp": "02:26:14", "text": "两者缺一不可。哦"}, {"type": "subtitle", "time": 8777.83, "timestamp": "02:26:17", "text": "我的上帝。他们太差劲了。真是见鬼。哦，"}, {"type": "subtitle", "time": 8780.23, "timestamp": "02:26:20", "text": "刚拿到演示版。我为什么会那样推呢？"}, {"type": "subtitle", "time": 8781.99, "timestamp": "02:26:21", "text": "放进去了吗？"}, {"type": "subtitle", "time": 8785.55, "timestamp": "02:26:25", "text": "最后10秒。"}, {"type": "subtitle", "time": 8789.349, "timestamp": "02:26:29", "text": "凡人寿命无法承受。好的。那是"}, {"type": "subtitle", "time": 8795.429, "timestamp": "02:26:35", "text": "有一个"}, {"type": "subtitle", "time": 8797.99, "timestamp": "02:26:37", "text": "排，伙计。"}, {"type": "subtitle", "time": 8801.03, "timestamp": "02:26:41", "text": "是的，他们确实这么做了。惊人的。"}, {"type": "subtitle", "time": 8803.349, "timestamp": "02:26:43", "text": "是时候做出改变了，包括"}, {"type": "subtitle", "time": 8805.75, "timestamp": "02:26:45", "text": "哪一边？红蛋变成问号"}, {"type": "subtitle", "time": 8809.99, "timestamp": "02:26:49", "text": "在聊天中。 BM兄弟完全不一样。"}, {"type": "subtitle", "time": 8813.03, "timestamp": "02:26:53", "text": "睁开眼睛。现实不过是……"}, {"type": "subtitle", "time": 8815.19, "timestamp": "02:26:55", "text": "错觉。好的。奇怪的。哦，是的"}, {"type": "subtitle", "time": 8816.71, "timestamp": "02:26:56", "text": "课程。让我独自一人扛坦克对线"}, {"type": "subtitle", "time": 8819.429, "timestamp": "02:26:59", "text": "那个该死的雷神，还有你知道的那个"}]
[{"type": "subtitle", "time": 4628.149, "timestamp": "01:17:08", "text": "只剩60秒了。你的力量是"}, {"type": "subtitle", "time": 4631.51, "timestamp": "01:17:11", "text": "活。消失。"}, {"type": "subtitle", "time": 4647.669, "timestamp": "01:17:27", "text": "我不知道你是怎么做到的，但是"}, {"type": "subtitle", "time": 4653.669, "timestamp": "01:17:33", "text": "好的。我的炮塔要来了"}, {"type": "subtitle", "time": 4656.47, "timestamp": "01:17:36", "text": "一秒钟内即可上线。"}, {"type": "subtitle", "time": 4664.63, "timestamp": "01:17:44", "text": "别让他们击垮我们。"}, {"type": "subtitle", "time": 4670.149, "timestamp": "01:17:50", "text": "我不认为这是欢迎。"}]
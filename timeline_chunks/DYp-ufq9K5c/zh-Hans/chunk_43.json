[{"type": "subtitle", "time": 2580.39, "timestamp": "00:43:00", "text": "30秒后开始。坚强点。我"}, {"type": "subtitle", "time": 2584.309, "timestamp": "00:43:04", "text": "不知道为什么，但我们的黑寡妇是"}, {"type": "subtitle", "time": 2587.829, "timestamp": "00:43:07", "text": "好的。这句话没有任何意义"}, {"type": "chat", "time": 2588.483, "timestamp": "00:43:08", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "*dislikes*"}, {"type": "subtitle", "time": 2591.91, "timestamp": "00:43:11", "text": "有道理，但现在做起来却很费劲。任何一个"}, {"type": "subtitle", "time": 2594.95, "timestamp": "00:43:14", "text": "敌方队伍太弱了"}, {"type": "subtitle", "time": 2597.829, "timestamp": "00:43:17", "text": "我们做得好，或者没有人"}, {"type": "subtitle", "time": 2600.63, "timestamp": "00:43:20", "text": "知道他们不喜欢什么。"}, {"type": "subtitle", "time": 2603.19, "timestamp": "00:43:23", "text": "啊哈。"}, {"type": "subtitle", "time": 2605.67, "timestamp": "00:43:25", "text": "拜托，老兄。我其实还不错"}, {"type": "subtitle", "time": 2607.589, "timestamp": "00:43:27", "text": "尖叫。"}, {"type": "subtitle", "time": 2609.51, "timestamp": "00:43:29", "text": "不，别那样说。铆"}, {"type": "chat", "time": 2615.796, "timestamp": "00:43:35", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "i dont like you bread"}, {"type": "chat", "time": 2617.965, "timestamp": "00:43:37", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "i love you"}, {"type": "subtitle", "time": 2619.43, "timestamp": "00:43:39", "text": "谢谢。是的，我要去健身房。"}]
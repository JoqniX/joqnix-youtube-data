[{"type": "subtitle", "time": 1081.75, "timestamp": "00:18:01", "text": "盯着那块面包看。你只是"}, {"type": "subtitle", "time": 1083.99, "timestamp": "00:18:03", "text": "和我聊天。他妈的"}, {"type": "subtitle", "time": 1099.27, "timestamp": "00:18:19", "text": "你这狗东西。它们装在瓶子里，在自动售货机里出售。"}, {"type": "subtitle", "time": 1100.63, "timestamp": "00:18:20", "text": "机器。确切地。这就是我"}, {"type": "subtitle", "time": 1103.75, "timestamp": "00:18:23", "text": "说道。这真是革命性的。我想"}, {"type": "subtitle", "time": 1113.39, "timestamp": "00:18:33", "text": "我的天，这太革命性了！"}, {"type": "subtitle", "time": 1115.99, "timestamp": "00:18:35", "text": "宝贝。情况糟透了，兄弟。你是什​​么意思？"}, {"type": "subtitle", "time": 1117.83, "timestamp": "00:18:37", "text": "我不想被吃掉。就是他！"}, {"type": "subtitle", "time": 1120.95, "timestamp": "00:18:40", "text": "吃掉我。他说：“你听到了吗？”"}, {"type": "subtitle", "time": 1122.789, "timestamp": "00:18:42", "text": "你知道吗？我要把那段剪下来。"}, {"type": "subtitle", "time": 1125.669, "timestamp": "00:18:45", "text": "我要去……时间戳是什么？"}, {"type": "subtitle", "time": 1135.59, "timestamp": "00:18:55", "text": "18 183 36 之类的。我这就写"}]
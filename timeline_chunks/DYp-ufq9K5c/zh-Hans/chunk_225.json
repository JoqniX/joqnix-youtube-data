[{"type": "subtitle", "time": 13501.269, "timestamp": "03:45:01", "text": "草药学。皮革。如何制作皮革？"}, {"type": "subtitle", "time": 13504.189, "timestamp": "03:45:04", "text": "任何媒介"}, {"type": "subtitle", "time": 13508.67, "timestamp": "03:45:08", "text": "皮毛，任何大的皮毛，任何小的皮毛"}, {"type": "subtitle", "time": 13511.07, "timestamp": "03:45:11", "text": "隐藏"}, {"type": "subtitle", "time": 13514.469, "timestamp": "03:45:14", "text": "刀。我应该剥动物皮，但是"}, {"type": "subtitle", "time": 13516.16, "timestamp": "03:45:16", "text": "这里面没有动物"}, {"type": "subtitle", "time": 13519.07, "timestamp": "03:45:19", "text": "[音乐]"}, {"type": "subtitle", "time": 13529.07, "timestamp": "03:45:29", "text": "哦。我如何让动物"}, {"type": "subtitle", "time": 13531.83, "timestamp": "03:45:31", "text": "来？感觉就像所有动物一样"}, {"type": "subtitle", "time": 13538.389, "timestamp": "03:45:38", "text": "走了。我当时正在玩这个游戏"}, {"type": "subtitle", "time": 13540.469, "timestamp": "03:45:40", "text": "第一次和朋友一起。我"}, {"type": "subtitle", "time": 13542.51, "timestamp": "03:45:42", "text": "我相信他杀了所有人"}, {"type": "subtitle", "time": 13546.07, "timestamp": "03:45:46", "text": "动物。所以我想我可能不得不"}]
[{"type": "subtitle", "time": 9360.63, "timestamp": "02:36:00", "text": "生活和事业，并在财富方面取得成功"}, {"type": "subtitle", "time": 9363.51, "timestamp": "02:36:03", "text": "以及健康。谢谢，兄弟。我猜她"}, {"type": "subtitle", "time": 9364.95, "timestamp": "02:36:04", "text": "不会说英语。他只是"}, {"type": "subtitle", "time": 9366.99, "timestamp": "02:36:06", "text": "翻译某物"}, {"type": "subtitle", "time": 9370.55, "timestamp": "02:36:10", "text": "韩国人。这意味着，你知道，某种东西。"}, {"type": "subtitle", "time": 9373.11, "timestamp": "02:36:13", "text": "看起来像中国人。不，那就是"}, {"type": "subtitle", "time": 9375.83, "timestamp": "02:36:15", "text": "韩国人。那是韩语，老兄。"}, {"type": "subtitle", "time": 9378.389, "timestamp": "02:36:18", "text": "你是说我是种族主义者，还是说你是？"}, {"type": "subtitle", "time": 9380.03, "timestamp": "02:36:20", "text": "说你是种族主义者？我是"}, {"type": "subtitle", "time": 9388.15, "timestamp": "02:36:28", "text": "钻石闪耀如阿喀琉斯之剑。"}, {"type": "subtitle", "time": 9390.71, "timestamp": "02:36:30", "text": "呃"}, {"type": "subtitle", "time": 9393.67, "timestamp": "02:36:33", "text": "你在读《谎言》吗？"}, {"type": "subtitle", "time": 9396.87, "timestamp": "02:36:36", "text": "不，不，不，不，不。我只是在看书。"}, {"type": "subtitle", "time": 9399.429, "timestamp": "02:36:39", "text": "一篇关于继发性突变的文章"}, {"type": "subtitle", "time": 9403.67, "timestamp": "02:36:43", "text": "在X战警中。哦。哦，是的。你知道的"}, {"type": "subtitle", "time": 9407.63, "timestamp": "02:36:47", "text": "艾玛·弗罗斯特就像……"}, {"type": "subtitle", "time": 9411.19, "timestamp": "02:36:51", "text": "她的主要变异是拥有心灵感应能力。"}, {"type": "subtitle", "time": 9413.99, "timestamp": "02:36:53", "text": "但几年后她获得了第二学位"}, {"type": "subtitle", "time": 9416.07, "timestamp": "02:36:56", "text": "突变也称为第二突变"}, {"type": "subtitle", "time": 9419.11, "timestamp": "02:36:59", "text": "青春期时她会拥有钻石般的肌肤"}]
[{"type": "subtitle", "time": 2460.79, "timestamp": "00:41:00", "text": "金子？你们在聊什么呢？"}, {"type": "subtitle", "time": 2463.15, "timestamp": "00:41:03", "text": "你们在胡扯些什么？"}, {"type": "subtitle", "time": 2470.51, "timestamp": "00:41:10", "text": "更便宜"}, {"type": "subtitle", "time": 2473.589, "timestamp": "00:41:13", "text": "墓？但我现在感觉好多了。他们得到了"}, {"type": "subtitle", "time": 2477.27, "timestamp": "00:41:17", "text": "三个治疗师，伙计。混蛋。明白了"}, {"type": "subtitle", "time": 2480.309, "timestamp": "00:41:20", "text": "车辆再次启动。继续前进。我们"}, {"type": "subtitle", "time": 2506.47, "timestamp": "00:41:46", "text": "引人入胜的游戏体验。"}]
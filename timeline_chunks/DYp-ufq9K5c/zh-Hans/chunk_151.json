[{"type": "subtitle", "time": 9060.87, "timestamp": "02:31:00", "text": "治疗者。该死。"}, {"type": "subtitle", "time": 9062.87, "timestamp": "02:31:02", "text": "我没事。"}, {"type": "subtitle", "time": 9064.23, "timestamp": "02:31:04", "text": "当你身体虚弱时，要怪就怪你的治疗师。"}, {"type": "subtitle", "time": 9066.469, "timestamp": "02:31:06", "text": "位置。对，没错。这就是我们"}, {"type": "subtitle", "time": 9067.99, "timestamp": "02:31:07", "text": "做。"}, {"type": "subtitle", "time": 9069.19, "timestamp": "02:31:09", "text": "但我有三个治疗师。我可以吗？"}, {"type": "subtitle", "time": 9070.87, "timestamp": "02:31:10", "text": "抱怨？我有三个治疗师。我可以吗？"}, {"type": "subtitle", "time": 9073.429, "timestamp": "02:31:13", "text": "抱怨？拜托，老兄。是的，你可以"}, {"type": "subtitle", "time": 9075.87, "timestamp": "02:31:15", "text": "抱怨。没关系。"}, {"type": "subtitle", "time": 9080.389, "timestamp": "02:31:20", "text": "真的吗？嘿，团队成员们，看看我们的 magd 怎么样了"}, {"type": "subtitle", "time": 9083.67, "timestamp": "02:31:23", "text": "当我们发射火箭的时候。我们就这么办吧"}, {"type": "subtitle", "time": 9087.19, "timestamp": "02:31:27", "text": "把它们全部涂上。我准备穿上"}, {"type": "subtitle", "time": 9093.67, "timestamp": "02:31:33", "text": "现在我们什么都没有了。"}, {"type": "subtitle", "time": 9097.11, "timestamp": "02:31:37", "text": "透过阿伽莫托的眼睛。"}, {"type": "subtitle", "time": 9098.27, "timestamp": "02:31:38", "text": "我们对抗"}, {"type": "subtitle", "time": 9107.03, "timestamp": "02:31:47", "text": "你看到了吗？"}, {"type": "subtitle", "time": 9109.27, "timestamp": "02:31:49", "text": "是的。"}]
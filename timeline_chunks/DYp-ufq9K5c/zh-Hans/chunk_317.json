[{"type": "subtitle", "time": 19045.83, "timestamp": "05:17:25", "text": "皮革。有趣的。好的。黑曜石"}, {"type": "subtitle", "time": 19049.03, "timestamp": "05:17:29", "text": "凳子。我的黑曜石武器。我需要一个"}, {"type": "subtitle", "time": 19051.51, "timestamp": "05:17:31", "text": "羽毛。我需要玻璃坯料。三个"}, {"type": "subtitle", "time": 19053.83, "timestamp": "05:17:33", "text": "他们。"}, {"type": "subtitle", "time": 19056.75, "timestamp": "05:17:36", "text": "还有，哦，等等。如何制作一个"}, {"type": "subtitle", "time": 19059.15, "timestamp": "05:17:39", "text": "铲？呃，"}, {"type": "subtitle", "time": 19062.43, "timestamp": "05:17:42", "text": "工具、采矿、"}, {"type": "subtitle", "time": 19075.788, "timestamp": "05:17:55", "text": "项目。所以，挖掘和"}, {"type": "subtitle", "time": 19079.99, "timestamp": "05:17:59", "text": "采矿、粘土和燧石、石头。我将使用"}]
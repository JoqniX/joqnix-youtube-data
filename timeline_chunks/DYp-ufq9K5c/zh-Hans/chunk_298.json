[{"type": "subtitle", "time": 17882.55, "timestamp": "04:58:02", "text": "游戏不一样了。等等，什么是 sh a"}, {"type": "subtitle", "time": 17889.43, "timestamp": "04:58:09", "text": "然后？我们正在运行一个哦，这是一个"}, {"type": "subtitle", "time": 17891.75, "timestamp": "04:58:11", "text": "专用服务器。哦好的。好的。分享"}, {"type": "subtitle", "time": 17893.75, "timestamp": "04:58:13", "text": "游戏是另一回事。哦，蒸汽"}, {"type": "subtitle", "time": 17897.35, "timestamp": "04:58:17", "text": "分享来了。在共享游戏中，Fleer"}, {"type": "subtitle", "time": 17899.11, "timestamp": "04:58:19", "text": "玩家仅运行云端程序"}, {"type": "subtitle", "time": 17900.948, "timestamp": "04:58:20", "text": "保险箱存放处"}, {"type": "subtitle", "time": 17902.47, "timestamp": "04:58:22", "text": "游戏玩法部分上传时"}, {"type": "subtitle", "time": 17905.59, "timestamp": "04:58:25", "text": "结束。存储空间始终对所有人开放"}, {"type": "subtitle", "time": 17907.67, "timestamp": "04:58:27", "text": "游戏中任何时刻的参与者。"}, {"type": "subtitle", "time": 17909.99, "timestamp": "04:58:29", "text": "这些人中任何一人都不能主持游戏"}, {"type": "subtitle", "time": 17912.708, "timestamp": "04:58:32", "text": "它。好的。玩家必须始终担任主机"}, {"type": "subtitle", "time": 17914.27, "timestamp": "04:58:34", "text": "他们在玩游戏"}, {"type": "subtitle", "time": 17917.83, "timestamp": "04:58:37", "text": "机器。好的，明白了。所以我的问题是"}, {"type": "subtitle", "time": 17921.75, "timestamp": "04:58:41", "text": "如果我不决定不做呢？"}, {"type": "subtitle", "time": 17923.47, "timestamp": "04:58:43", "text": "分享游戏"}, {"type": "subtitle", "time": 17927.83, "timestamp": "04:58:47", "text": "那玩意儿？如果我想在本地托管呢？"}, {"type": "subtitle", "time": 17929.99, "timestamp": "04:58:49", "text": "它？这样可以吗？我认为"}, {"type": "subtitle", "time": 17935.948, "timestamp": "04:58:55", "text": "正确的？主持"}]
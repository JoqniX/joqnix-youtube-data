[{"type": "subtitle", "time": 7266.95, "timestamp": "02:01:06", "text": "还有，乔克在哪儿，伙计？就像两个"}, {"type": "subtitle", "time": 7269.35, "timestamp": "02:01:09", "text": "小时。不用担心。只是"}, {"type": "subtitle", "time": 7272.51, "timestamp": "02:01:12", "text": "开始。快点。"}, {"type": "subtitle", "time": 7275.51, "timestamp": "02:01:15", "text": "哦，让我想想。您已加入。以及如何"}, {"type": "subtitle", "time": 7277.51, "timestamp": "02:01:17", "text": "多少次连败？好吧，两次。"}, {"type": "subtitle", "time": 7279.669, "timestamp": "02:01:19", "text": "好的，兄弟。这仅仅是个开始。"}, {"type": "subtitle", "time": 7281.35, "timestamp": "02:01:21", "text": "来吧，伙计。肯定有类似的事情"}, {"type": "subtitle", "time": 7284.39, "timestamp": "02:01:24", "text": "还有五个。让我，让我，让我，让我"}, {"type": "subtitle", "time": 7287.189, "timestamp": "02:01:27", "text": "获取补丁皮肤。"}, {"type": "subtitle", "time": 7300.31, "timestamp": "02:01:40", "text": "好的，是的。准备全部抽取"}, {"type": "subtitle", "time": 7312.75, "timestamp": "02:01:52", "text": "这是什么？不。那是新的吗？"}, {"type": "subtitle", "time": 7316.39, "timestamp": "02:01:56", "text": "事件？好的。"}]
[{"type": "subtitle", "time": 15248.149, "timestamp": "04:14:08", "text": "等等，那它的桅杆在哪儿呢？喜欢"}, {"type": "subtitle", "time": 15250.349, "timestamp": "04:14:10", "text": "风"}, {"type": "subtitle", "time": 15253.91, "timestamp": "04:14:13", "text": "东西。它将如何移动？哦，它运行了吗？"}, {"type": "subtitle", "time": 15256.309, "timestamp": "04:14:16", "text": "用发电机之类的吗？不。对。"}, {"type": "subtitle", "time": 15264.309, "timestamp": "04:14:24", "text": "正确的。我喜欢制造奇形怪状的飞船。应该"}, {"type": "subtitle", "time": 15266.309, "timestamp": "04:14:26", "text": "现在能够点击我的名字了，因为"}, {"type": "subtitle", "time": 15269.59, "timestamp": "04:14:29", "text": "你找到了我和其他船只。等待。哦，"}, {"type": "subtitle", "time": 15273.63, "timestamp": "04:14:33", "text": "是的。是的。呃，点击你的名字，"}, {"type": "subtitle", "time": 15276.429, "timestamp": "04:14:36", "text": "姓名。让我们来看看"}, {"type": "subtitle", "time": 15278.75, "timestamp": "04:14:38", "text": "这里。不是"}, {"type": "subtitle", "time": 15284.59, "timestamp": "04:14:44", "text": "我怎么做？"}, {"type": "subtitle", "time": 15288.79, "timestamp": "04:14:48", "text": "如何？那些白色的就是木头"}, {"type": "subtitle", "time": 15292.99, "timestamp": "04:14:52", "text": "墙漆。你可以画画"}, {"type": "subtitle", "time": 15298.67, "timestamp": "04:14:58", "text": "东西。前往船体。船体。"}]
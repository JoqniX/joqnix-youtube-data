[{"type": "subtitle", "time": 8950.95, "timestamp": "02:29:10", "text": "他想要它。他想要它。比如，给它"}, {"type": "subtitle", "time": 8953.07, "timestamp": "02:29:13", "text": "大部头书。把它交给"}, {"type": "subtitle", "time": 8956.349, "timestamp": "02:29:16", "text": "我。我想他当时正在打字。"}, {"type": "subtitle", "time": 8958.79, "timestamp": "02:29:18", "text": "大概。生气了。我不认为他是。"}, {"type": "subtitle", "time": 8960.309, "timestamp": "02:29:20", "text": "趁没人的时候，我打算打点什么。"}, {"type": "subtitle", "time": 8961.63, "timestamp": "02:29:21", "text": "已输入"}, {"type": "subtitle", "time": 8965.11, "timestamp": "02:29:25", "text": "任何事物。或许。我认为他是在塑造"}, {"type": "subtitle", "time": 8966.79, "timestamp": "02:29:26", "text": "因为就像那个陌生人说的，“哦，"}, {"type": "subtitle", "time": 8968.83, "timestamp": "02:29:28", "text": "我做了什么"}, {"type": "subtitle", "time": 8972.79, "timestamp": "02:29:32", "text": "干嘛？”天哪，他简直是粗暴对待他们。兄弟，"}, {"type": "subtitle", "time": 8982.23, "timestamp": "02:29:42", "text": "是的。我就进去看看。"}, {"type": "subtitle", "time": 8983.91, "timestamp": "02:29:43", "text": "就让基础设施来承担吧。"}, {"type": "subtitle", "time": 8988.63, "timestamp": "02:29:48", "text": "好好照看它。是的。我要……"}]
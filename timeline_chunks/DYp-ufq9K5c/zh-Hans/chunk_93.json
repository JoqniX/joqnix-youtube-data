[{"type": "subtitle", "time": 5581.83, "timestamp": "01:33:01", "text": "西格玛？我是Sigma吗？不，不，他才四岁。"}, {"type": "subtitle", "time": 5583.189, "timestamp": "01:33:03", "text": "还有五。四和五。以及"}, {"type": "subtitle", "time": 5584.709, "timestamp": "01:33:04", "text": "河马。"}, {"type": "subtitle", "time": 5586.47, "timestamp": "01:33:06", "text": "是的。真的是河马吗？是的，"}, {"type": "subtitle", "time": 5590.149, "timestamp": "01:33:10", "text": "是他。是他。是的。"}, {"type": "subtitle", "time": 5592.31, "timestamp": "01:33:12", "text": "那个说“不，算了”的人。绝不"}, {"type": "subtitle", "time": 5595.11, "timestamp": "01:33:15", "text": "头脑。对，是他。我刚刚倒带"}, {"type": "subtitle", "time": 5598.39, "timestamp": "01:33:18", "text": "溪流，伙计。快点。呃，我没有"}, {"type": "subtitle", "time": 5600.79, "timestamp": "01:33:20", "text": "想。"}, {"type": "subtitle", "time": 5603.669, "timestamp": "01:33:23", "text": "操逼。你他妈说的是阴道吗？我是"}, {"type": "subtitle", "time": 5605.55, "timestamp": "01:33:25", "text": "像那样的小猫咪。"}, {"type": "subtitle", "time": 5612.95, "timestamp": "01:33:32", "text": "总之，一切都和温度有关。让我"}, {"type": "subtitle", "time": 5615.75, "timestamp": "01:33:35", "text": "让他们见识见识。哦，没事了。"}, {"type": "subtitle", "time": 5617.43, "timestamp": "01:33:37", "text": "等等，等等，等等。冷静下来。双倍的"}, {"type": "subtitle", "time": 5619.11, "timestamp": "01:33:39", "text": "盾。"}, {"type": "subtitle", "time": 5620.87, "timestamp": "01:33:40", "text": "双重护盾。这是 这是 这是"}, {"type": "subtitle", "time": 5623.669, "timestamp": "01:33:43", "text": "没错吧，伙计。双层护盾并非……"}, {"type": "subtitle", "time": 5625.51, "timestamp": "01:33:45", "text": "说这话时，皮肤是白色的。来"}, {"type": "subtitle", "time": 5627.91, "timestamp": "01:33:47", "text": "在。"}, {"type": "subtitle", "time": 5629.99, "timestamp": "01:33:49", "text": "蜘蛛侠就是个废物。我只需看看"}, {"type": "subtitle", "time": 5636.87, "timestamp": "01:33:56", "text": "哦，他站着不动。"}]
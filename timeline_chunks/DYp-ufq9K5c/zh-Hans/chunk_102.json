[{"type": "subtitle", "time": 6120.87, "timestamp": "01:42:00", "text": "要么在 PlayStation 上玩，要么"}, {"type": "subtitle", "time": 6123.91, "timestamp": "01:42:03", "text": "他们居然有台4060。"}, {"type": "subtitle", "time": 6127.189, "timestamp": "01:42:07", "text": "我有一台4090。"}, {"type": "subtitle", "time": 6128.95, "timestamp": "01:42:08", "text": "去自慰吧。"}, {"type": "subtitle", "time": 6132.149, "timestamp": "01:42:12", "text": "我实际上有三块4090显卡。"}, {"type": "subtitle", "time": 6133.51, "timestamp": "01:42:13", "text": "你想要一个吗？我会冲锋在前。"}, {"type": "subtitle", "time": 6136.87, "timestamp": "01:42:16", "text": "线条。不。"}, {"type": "subtitle", "time": 6138.55, "timestamp": "01:42:18", "text": "哇。而且，我还有一台笔记本电脑，所以我不需要"}, {"type": "subtitle", "time": 6140.229, "timestamp": "01:42:20", "text": "知道它是否合适。那好吧，"}, {"type": "subtitle", "time": 6141.75, "timestamp": "01:42:21", "text": "笔记本电脑。"}, {"type": "subtitle", "time": 6144.87, "timestamp": "01:42:24", "text": "笔记本电脑游戏。你欠我一个人情。他有两个"}, {"type": "subtitle", "time": 6148.55, "timestamp": "01:42:28", "text": "现在电压正常了，这很好。那是……"}, {"type": "subtitle", "time": 6159.109, "timestamp": "01:42:39", "text": "我太喜欢巴基了。他好帅。什么"}, {"type": "subtitle", "time": 6160.709, "timestamp": "01:42:40", "text": "你见过那些模组破坏游戏吗？"}, {"type": "subtitle", "time": 6163.43, "timestamp": "01:42:43", "text": "他们基地上的桥？现在不行。"}, {"type": "subtitle", "time": 6165.91, "timestamp": "01:42:45", "text": "伴侣。现在不行。你想得到"}, {"type": "subtitle", "time": 6167.39, "timestamp": "01:42:47", "text": "诅咒"}, {"type": "subtitle", "time": 6175.03, "timestamp": "01:42:55", "text": "呃，我现在真是个种族主义者。"}]
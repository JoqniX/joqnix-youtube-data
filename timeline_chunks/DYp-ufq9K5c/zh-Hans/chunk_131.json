[{"type": "subtitle", "time": 7861.35, "timestamp": "02:11:01", "text": "我很好。我拥有那种自愈能力。"}, {"type": "subtitle", "time": 7874.47, "timestamp": "02:11:14", "text": "另一个治疗师呢，兄弟？哪里"}, {"type": "subtitle", "time": 7877.91, "timestamp": "02:11:17", "text": "他走了吗？很不错。月亮在哪里？哦，"}, {"type": "subtitle", "time": 7879.99, "timestamp": "02:11:19", "text": "她就在那里。"}, {"type": "subtitle", "time": 7881.27, "timestamp": "02:11:21", "text": "你们没有治疗者。你是做什么的"}, {"type": "subtitle", "time": 7890.79, "timestamp": "02:11:30", "text": "好一个。不错的团队。谢谢。好的。"}, {"type": "subtitle", "time": 7893.43, "timestamp": "02:11:33", "text": "治疗者。你为什么还要待在那里？我们走吧。"}, {"type": "subtitle", "time": 7899.51, "timestamp": "02:11:39", "text": "我该叫他格鲁德吗？"}, {"type": "subtitle", "time": 7906.229, "timestamp": "02:11:46", "text": "但这一切都会过去。那又如何呢？他"}, {"type": "subtitle", "time": 7908.95, "timestamp": "02:11:48", "text": "她说她要去抓露娜。"}, {"type": "subtitle", "time": 7912.069, "timestamp": "02:11:52", "text": "我要抓住她。走吧，兄弟。"}, {"type": "subtitle", "time": 7916.31, "timestamp": "02:11:56", "text": "不过没关系，我想。哦，放我出去。"}, {"type": "subtitle", "time": 7919.91, "timestamp": "02:11:59", "text": "我的治疗师们甚至都没用他们的"}]
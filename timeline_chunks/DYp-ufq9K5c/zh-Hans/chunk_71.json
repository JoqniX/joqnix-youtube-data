[{"type": "subtitle", "time": 4262.149, "timestamp": "01:11:02", "text": "我觉得奇异博士应该……"}, {"type": "subtitle", "time": 4265.59, "timestamp": "01:11:05", "text": "你知道的。但他会来的"}, {"type": "subtitle", "time": 4268.149, "timestamp": "01:11:08", "text": "30. 进攻端确实奏效了，但是，是的，"}, {"type": "subtitle", "time": 4270.39, "timestamp": "01:11:10", "text": "他是个性格激进的人。所以"}, {"type": "subtitle", "time": 4273.27, "timestamp": "01:11:13", "text": "是的，我觉得有道理。如何"}, {"type": "subtitle", "time": 4274.63, "timestamp": "01:11:14", "text": "我们还要拯救多少次？"}, {"type": "subtitle", "time": 4277.27, "timestamp": "01:11:17", "text": "世界直到不再需要拯救为止"}, {"type": "subtitle", "time": 4280.189, "timestamp": "01:11:20", "text": "还有吗？顺便说一下，这是"}, {"type": "subtitle", "time": 4282.79, "timestamp": "01:11:22", "text": "风暴。我想我可能爱上她了"}, {"type": "subtitle", "time": 4286.07, "timestamp": "01:11:26", "text": "某物。我不知道。"}, {"type": "subtitle", "time": 4289.27, "timestamp": "01:11:29", "text": "他们称她为女神，并给她取了名字。"}, {"type": "subtitle", "time": 4295.51, "timestamp": "01:11:35", "text": "对于这个角色，我感觉非常糟糕。"}, {"type": "subtitle", "time": 4297.189, "timestamp": "01:11:37", "text": "伙计们。我对此感到非常沮丧。"}, {"type": "subtitle", "time": 4302.63, "timestamp": "01:11:42", "text": "好的，海拉在那里。所以，他们不是"}, {"type": "subtitle", "time": 4317.87, "timestamp": "01:11:57", "text": "哦，这个"}]
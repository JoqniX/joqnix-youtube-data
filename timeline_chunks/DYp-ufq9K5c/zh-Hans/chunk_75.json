[{"type": "subtitle", "time": 4521.27, "timestamp": "01:15:21", "text": "哦，他帮了我很大的忙。哦不，我们"}, {"type": "subtitle", "time": 4523.51, "timestamp": "01:15:23", "text": "翻了一倍。不，那很糟糕。那很糟糕。"}, {"type": "subtitle", "time": 4525.99, "timestamp": "01:15:25", "text": "那很糟糕。你的力量就是我的力量。"}, {"type": "subtitle", "time": 4528.95, "timestamp": "01:15:28", "text": "集合。"}, {"type": "subtitle", "time": 4531.59, "timestamp": "01:15:31", "text": "那到底是什么鬼东西？哦，我的管理员"}]
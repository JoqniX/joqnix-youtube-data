[{"type": "subtitle", "time": 6673.83, "timestamp": "01:51:13", "text": "又来了。又收到了。 30秒。来"}, {"type": "subtitle", "time": 6676.709, "timestamp": "01:51:16", "text": "在。简单的。"}, {"type": "subtitle", "time": 6679.189, "timestamp": "01:51:19", "text": "再次。"}, {"type": "subtitle", "time": 6692.709, "timestamp": "01:51:32", "text": "最后10秒。我错了"}, {"type": "subtitle", "time": 6695.83, "timestamp": "01:51:35", "text": "位置。我站错位置了。"}, {"type": "subtitle", "time": 6704.07, "timestamp": "01:51:44", "text": "是的。我的天啊。设置很简单"}, {"type": "subtitle", "time": 6711.109, "timestamp": "01:51:51", "text": "一个低俗的笑话。"}, {"type": "subtitle", "time": 6713.03, "timestamp": "01:51:53", "text": "是的。是的。我听到两只狼的叫声"}, {"type": "subtitle", "time": 6717.669, "timestamp": "01:51:57", "text": "脱不下来。我的天哪。"}]
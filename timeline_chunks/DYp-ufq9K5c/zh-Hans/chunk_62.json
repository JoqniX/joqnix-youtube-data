[{"type": "subtitle", "time": 3723.27, "timestamp": "01:02:03", "text": "第一轮。这是蒂皮托，她有"}, {"type": "subtitle", "time": 3726.309, "timestamp": "01:02:06", "text": "嗯，只是个普通人的力量"}, {"type": "subtitle", "time": 3727.99, "timestamp": "01:02:07", "text": "松鼠。"}, {"type": "subtitle", "time": 3729.99, "timestamp": "01:02:09", "text": "对了，我们又要添置一只毛茸茸的小动物了。"}, {"type": "subtitle", "time": 3732.71, "timestamp": "01:02:12", "text": "我听说了。顺便说一下，这是学校。"}, {"type": "subtitle", "time": 3735.43, "timestamp": "01:02:15", "text": "这边是女孩的家。"}, {"type": "subtitle", "time": 3738.63, "timestamp": "01:02:18", "text": "最酷的？这是我们的床。现在，"}, {"type": "subtitle", "time": 3740.99, "timestamp": "01:02:20", "text": "我们带你去"}, {"type": "subtitle", "time": 3744.069, "timestamp": "01:02:24", "text": "人类能够理解动物。我"}, {"type": "subtitle", "time": 3746.309, "timestamp": "01:02:26", "text": "真希望我能做到。是的。这是"}, {"type": "subtitle", "time": 3748.069, "timestamp": "01:02:28", "text": "伙计们，如果你们在砰砰作响的地方……"}, {"type": "subtitle", "time": 3750.63, "timestamp": "01:02:30", "text": "你明白我的意思。"}, {"type": "subtitle", "time": 3752.23, "timestamp": "01:02:32", "text": "厄运。"}, {"type": "subtitle", "time": 3754.47, "timestamp": "01:02:34", "text": "战斗开始了。另外，顺便提一下，"}, {"type": "subtitle", "time": 3757.19, "timestamp": "01:02:37", "text": "就像一个棋盘游戏一样"}, {"type": "subtitle", "time": 3759.67, "timestamp": "01:02:39", "text": "那边是斯特兰奇、斯奎格尔和布莱德。"}, {"type": "subtitle", "time": 3761.589, "timestamp": "01:02:41", "text": "Blade 有一个迷你人偶，但他不在里面。"}, {"type": "subtitle", "time": 3769.99, "timestamp": "01:02:49", "text": "我感觉肯定还有侧翼攻击。"}]
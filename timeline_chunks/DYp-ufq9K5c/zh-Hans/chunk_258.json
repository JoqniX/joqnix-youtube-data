[{"type": "subtitle", "time": 15487.79, "timestamp": "04:18:07", "text": "尽管。等等，风是从哪里来的？"}, {"type": "subtitle", "time": 15491.83, "timestamp": "04:18:11", "text": "被吹走了？不，它看起来像一个"}, {"type": "subtitle", "time": 15494.189, "timestamp": "04:18:14", "text": "洞。已经关闭了。"}, {"type": "subtitle", "time": 15496.63, "timestamp": "04:18:16", "text": "不，完全是哦，是的。是的。是的。"}, {"type": "subtitle", "time": 15498.95, "timestamp": "04:18:18", "text": "那就完全关门了。你好吗"}, {"type": "subtitle", "time": 15500.59, "timestamp": "04:18:20", "text": "获得"}, {"type": "subtitle", "time": 15503.87, "timestamp": "04:18:23", "text": "风？需要经过"}, {"type": "subtitle", "time": 15511.67, "timestamp": "04:18:31", "text": "呃，你是怎么让风吹动的？"}, {"type": "subtitle", "time": 15513.229, "timestamp": "04:18:33", "text": "这"}, {"type": "subtitle", "time": 15516.71, "timestamp": "04:18:36", "text": "米？气流是如何运作的？嗯，我觉得"}, {"type": "subtitle", "time": 15518.469, "timestamp": "04:18:38", "text": "你必须考虑所有这些事情。"}, {"type": "subtitle", "time": 15521.91, "timestamp": "04:18:41", "text": "现在当你进行实验并制造一艘船时"}, {"type": "subtitle", "time": 15524.99, "timestamp": "04:18:44", "text": "以及物理学原理等等。"}, {"type": "subtitle", "time": 15527.51, "timestamp": "04:18:47", "text": "一切。我的天啊，这游戏太……"}, {"type": "subtitle", "time": 15529.389, "timestamp": "04:18:49", "text": "强烈而"}, {"type": "subtitle", "time": 15532.59, "timestamp": "04:18:52", "text": "复杂而深入。我喜欢"}, {"type": "subtitle", "time": 15535.149, "timestamp": "04:18:55", "text": "这。我爱"}, {"type": "subtitle", "time": 15537.55, "timestamp": "04:18:57", "text": "本次销售仅限"}]
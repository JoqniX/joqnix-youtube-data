[{"type": "subtitle", "time": 6790.229, "timestamp": "01:53:10", "text": "我已经在玩《使命召唤》了。"}, {"type": "subtitle", "time": 6792.55, "timestamp": "01:53:12", "text": "到达。我们走吧。走吧，兄弟。他是"}, {"type": "subtitle", "time": 6799.99, "timestamp": "01:53:19", "text": "去。哦，他正在做这件事。他是"}, {"type": "subtitle", "time": 6801.589, "timestamp": "01:53:21", "text": "简直就是脑石。哦，他正在做"}, {"type": "subtitle", "time": 6803.34, "timestamp": "01:53:23", "text": "那个东西。"}, {"type": "subtitle", "time": 6804.55, "timestamp": "01:53:24", "text": "[音乐]"}, {"type": "subtitle", "time": 6807.189, "timestamp": "01:53:27", "text": "什么也没发生。所以，"}, {"type": "subtitle", "time": 6809.27, "timestamp": "01:53:29", "text": "是的，没错。我猜是"}, {"type": "subtitle", "time": 6811.91, "timestamp": "01:53:31", "text": "已经"}, {"type": "subtitle", "time": 6816.629, "timestamp": "01:53:36", "text": "他应该去洗个澡了。"}, {"type": "subtitle", "time": 6819.189, "timestamp": "01:53:39", "text": "快点。"}, {"type": "subtitle", "time": 6821.189, "timestamp": "01:53:41", "text": "他的投篮命中率简直高得离谱。你"}, {"type": "subtitle", "time": 6824.79, "timestamp": "01:53:44", "text": "不能上当。知道了。"}, {"type": "subtitle", "time": 6827.31, "timestamp": "01:53:47", "text": "悟空的"}, {"type": "subtitle", "time": 6832.91, "timestamp": "01:53:52", "text": "哦"}, {"type": "subtitle", "time": 6838.629, "timestamp": "01:53:58", "text": "是的。哦，这是我的猎枪，给你。"}]
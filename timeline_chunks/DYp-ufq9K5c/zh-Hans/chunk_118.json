[{"type": "subtitle", "time": 7100.55, "timestamp": "01:58:20", "text": "零。好的。"}, {"type": "subtitle", "time": 7103.43, "timestamp": "01:58:23", "text": "这样好多了。"}, {"type": "subtitle", "time": 7106.55, "timestamp": "01:58:26", "text": "下次我一定能抓住你。"}, {"type": "subtitle", "time": 7113.589, "timestamp": "01:58:33", "text": "我的天哪。好的。他们正在大力推广另类摇滚。"}, {"type": "subtitle", "time": 7116.31, "timestamp": "01:58:36", "text": "它们正在抽水。"}, {"type": "subtitle", "time": 7119.99, "timestamp": "01:58:39", "text": "你会开始泵血。哟，"}, {"type": "subtitle", "time": 7123.27, "timestamp": "01:58:43", "text": "我觉得麦克斯不知道我们是谁"}, {"type": "subtitle", "time": 7126.589, "timestamp": "01:58:46", "text": "少了一名球员或者其他什么人，因为他走了"}]
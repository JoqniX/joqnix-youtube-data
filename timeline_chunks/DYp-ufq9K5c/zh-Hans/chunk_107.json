[{"type": "subtitle", "time": 6422.07, "timestamp": "01:47:02", "text": "背面。哦。哦，好了。我们得到了"}, {"type": "subtitle", "time": 6431.189, "timestamp": "01:47:11", "text": "危险且危险。啊，糟糕。他妈的杀"}, {"type": "subtitle", "time": 6447.669, "timestamp": "01:47:27", "text": "再次。"}, {"type": "subtitle", "time": 6449.669, "timestamp": "01:47:29", "text": "好的，我正在做两个球。有"}, {"type": "subtitle", "time": 6451.27, "timestamp": "01:47:31", "text": "就像有两个治疗师在照顾他。是的。等待，"}, {"type": "subtitle", "time": 6454.79, "timestamp": "01:47:34", "text": "等等，等等。法官、陪审团、陪审团"}, {"type": "subtitle", "time": 6456.629, "timestamp": "01:47:36", "text": "刽子手，"}, {"type": "subtitle", "time": 6463.669, "timestamp": "01:47:43", "text": "他有吗？"}, {"type": "subtitle", "time": 6465.51, "timestamp": "01:47:45", "text": "回到这里。是啊。看看"}, {"type": "subtitle", "time": 6469.83, "timestamp": "01:47:49", "text": "他。他去世了。哦，他死了。"}, {"type": "subtitle", "time": 6477.35, "timestamp": "01:47:57", "text": "明天。我打算再把他拉出来一次。"}]
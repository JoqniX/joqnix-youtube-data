[{"type": "subtitle", "time": 16810.31, "timestamp": "04:40:10", "text": "痴迷于装备战斗和沿海地区"}, {"type": "subtitle", "time": 16812.07, "timestamp": "04:40:12", "text": "轰炸。"}, {"type": "subtitle", "time": 16814.788, "timestamp": "04:40:14", "text": "她的六台蒸汽机使它能够"}, {"type": "subtitle", "time": 16817.35, "timestamp": "04:40:17", "text": "画面中，大海和两张帆占据主导地位。"}, {"type": "subtitle", "time": 16819.35, "timestamp": "04:40:19", "text": "添加这些装置是为了在港口内进行机动或行动"}, {"type": "subtitle", "time": 16823.43, "timestamp": "04:40:23", "text": "作为备用方案，以防燃料耗尽。"}, {"type": "subtitle", "time": 16825.35, "timestamp": "04:40:25", "text": "充足的存储空间。但实际上我只是滚动浏览。"}, {"type": "subtitle", "time": 16826.55, "timestamp": "04:40:26", "text": "从底部找到它。它是"}, {"type": "subtitle", "time": 16828.47, "timestamp": "04:40:28", "text": "评价很高。应该会相当不错。"}, {"type": "subtitle", "time": 16831.27, "timestamp": "04:40:31", "text": "快的。哦，我刚才提到的那个名字是什么？"}, {"type": "subtitle", "time": 16834.11, "timestamp": "04:40:34", "text": "我应该就……"}]
[{"type": "subtitle", "time": 9900.95, "timestamp": "02:45:00", "text": "今天有什么安排？"}, {"type": "subtitle", "time": 9903.269, "timestamp": "02:45:03", "text": "哦，我可以。你知道吗？我必须喜欢"}, {"type": "subtitle", "time": 9905.11, "timestamp": "02:45:05", "text": "耳机快没电了，快给我充电！"}, {"type": "subtitle", "time": 9909.51, "timestamp": "02:45:09", "text": "现在电池已启动。所以，我们能……我们可以……"}, {"type": "subtitle", "time": 9915.269, "timestamp": "02:45:15", "text": "大概过了两个小时后就出现了这种情况。我们能"}, {"type": "subtitle", "time": 9916.87, "timestamp": "02:45:16", "text": "哦，这个东西。哦，是的。当然。"}, {"type": "subtitle", "time": 9918.88, "timestamp": "02:45:18", "text": "当然。 是的。你可以玩其他游戏"}, {"type": "subtitle", "time": 9920.96, "timestamp": "02:45:20", "text": "是的。你可以玩其他游戏 与此同时，和孩子谈谈吧"}, {"type": "subtitle", "time": 9923.279, "timestamp": "02:45:23", "text": "与此同时，和孩子谈谈吧 你在这里待的时间并不长。"}, {"type": "subtitle", "time": 9931.349, "timestamp": "02:45:31", "text": "这么久。"}, {"type": "subtitle", "time": 9936.469, "timestamp": "02:45:36", "text": "是的。有些人相信"}, {"type": "subtitle", "time": 9940.95, "timestamp": "02:45:40", "text": "那。我看不懂。 D 真的"}, {"type": "subtitle", "time": 9942.55, "timestamp": "02:45:42", "text": "哦，你来自哪里？有人吗？"}, {"type": "subtitle", "time": 9946.11, "timestamp": "02:45:46", "text": "那里？是的。某人。"}, {"type": "subtitle", "time": 9953.03, "timestamp": "02:45:53", "text": "是啊，我只是在玩我的小老玩具。"}]
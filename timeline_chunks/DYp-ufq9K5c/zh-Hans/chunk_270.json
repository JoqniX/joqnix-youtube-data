[{"type": "subtitle", "time": 16203.63, "timestamp": "04:30:03", "text": "上帝。都在最上面。"}, {"type": "subtitle", "time": 16205.63, "timestamp": "04:30:05", "text": "啊，所以"}, {"type": "subtitle", "time": 16208.95, "timestamp": "04:30:08", "text": "凉爽的。你们有很多 Nomad 版本"}, {"type": "subtitle", "time": 16212.07, "timestamp": "04:30:12", "text": "蓝图。看看这一切。什么是"}, {"type": "subtitle", "time": 16214.67, "timestamp": "04:30:14", "text": "这种未来主义"}, {"type": "subtitle", "time": 16219.149, "timestamp": "04:30:19", "text": "别墅？什么？铁游牧民"}, {"type": "subtitle", "time": 16233.149, "timestamp": "04:30:33", "text": "游牧民族。甜的"}, {"type": "subtitle", "time": 16236.71, "timestamp": "04:30:36", "text": "游牧民族。潜水游牧民。我的天啊。潜水"}, {"type": "subtitle", "time": 16245.55, "timestamp": "04:30:45", "text": "事物。你擅长"}, {"type": "subtitle", "time": 16248.63, "timestamp": "04:30:48", "text": "这。我觉得这是一个很好的功能。感觉"}, {"type": "subtitle", "time": 16250.95, "timestamp": "04:30:50", "text": "就像你是工程师或建筑师一样"}, {"type": "subtitle", "time": 16254.91, "timestamp": "04:30:54", "text": "某物。能够设计船舶和设计"}, {"type": "subtitle", "time": 16259.189, "timestamp": "04:30:59", "text": "东西。我们很擅长这个。迪奥。"}]
[{"type": "subtitle", "time": 840.15, "timestamp": "00:14:00", "text": "时间。"}, {"type": "subtitle", "time": 843.59, "timestamp": "00:14:03", "text": "你起身了吗？"}, {"type": "subtitle", "time": 846.389, "timestamp": "00:14:06", "text": "这就是我的问题。我不认为你"}, {"type": "subtitle", "time": 849.11, "timestamp": "00:14:09", "text": "别再睡你的床了。"}, {"type": "subtitle", "time": 853.03, "timestamp": "00:14:13", "text": "我不睡在椅子上。"}, {"type": "subtitle", "time": 855.11, "timestamp": "00:14:15", "text": "我没做过那件事。不，我还没睡。"}, {"type": "subtitle", "time": 857.67, "timestamp": "00:14:17", "text": "现在还在我的椅子上或桌子上吗？我应该"}, {"type": "subtitle", "time": 858.91, "timestamp": "00:14:18", "text": "去做"}, {"type": "subtitle", "time": 862.069, "timestamp": "00:14:22", "text": "然而。然而。你还没睡过你的"}, {"type": "subtitle", "time": 864.949, "timestamp": "00:14:24", "text": "椅子到了吗？我们都到了那个年纪了，"}, {"type": "subtitle", "time": 867.47, "timestamp": "00:14:27", "text": "伴侣。我们正在接近那个目标。"}, {"type": "subtitle", "time": 873.03, "timestamp": "00:14:33", "text": "临界点。快点。我的天啊。"}, {"type": "subtitle", "time": 874.509, "timestamp": "00:14:34", "text": "嗯，嗯"}, {"type": "subtitle", "time": 880.15, "timestamp": "00:14:40", "text": "出色地。慢跑就是慢跑。是的，我们已经看到了"}, {"type": "subtitle", "time": 887.59, "timestamp": "00:14:47", "text": "为什么从日本开始就令人难过呢？"}, {"type": "subtitle", "time": 890.629, "timestamp": "00:14:50", "text": "这些都做不了。"}, {"type": "subtitle", "time": 893.31, "timestamp": "00:14:53", "text": "直播持续了两个多小时"}]
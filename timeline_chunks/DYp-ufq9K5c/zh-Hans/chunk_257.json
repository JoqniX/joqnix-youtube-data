[{"type": "subtitle", "time": 15434.469, "timestamp": "04:17:14", "text": "哇。哦，是的。白色水滴。我当时"}, {"type": "subtitle", "time": 15436.11, "timestamp": "04:17:16", "text": "寻找"}, {"type": "subtitle", "time": 15439.51, "timestamp": "04:17:19", "text": "那些。哦，你甚至放了一个，你甚至放了一个"}, {"type": "subtitle", "time": 15449.83, "timestamp": "04:17:29", "text": "呃，它们就在地板下面。"}, {"type": "subtitle", "time": 15452.03, "timestamp": "04:17:32", "text": "那真漂亮"}, {"type": "subtitle", "time": 15455.389, "timestamp": "04:17:35", "text": "老的。哦，我的天"}, {"type": "subtitle", "time": 15457.309, "timestamp": "04:17:37", "text": "上帝。"}, {"type": "subtitle", "time": 15461.99, "timestamp": "04:17:41", "text": "圣。什么？这是什么？"}, {"type": "subtitle", "time": 15462.99, "timestamp": "04:17:42", "text": "是"}, {"type": "subtitle", "time": 15472.229, "timestamp": "04:17:52", "text": "这？所有装饰系统实际上"}, {"type": "subtitle", "time": 15473.79, "timestamp": "04:17:53", "text": "不"}]
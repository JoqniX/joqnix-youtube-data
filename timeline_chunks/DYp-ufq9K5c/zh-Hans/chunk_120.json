[{"type": "subtitle", "time": 7210.79, "timestamp": "02:00:10", "text": "过来。过来。"}, {"type": "subtitle", "time": 7212.229, "timestamp": "02:00:12", "text": "我们必须继续战斗，直到我们"}, {"type": "subtitle", "time": 7219.91, "timestamp": "02:00:19", "text": "求求你们，我们受伤了。"}, {"type": "subtitle", "time": 7221.99, "timestamp": "02:00:21", "text": "快点。"}, {"type": "subtitle", "time": 7228.709, "timestamp": "02:00:28", "text": "地狱之门开启。"}, {"type": "subtitle", "time": 7237.589, "timestamp": "02:00:37", "text": "我的天哪。好的。我的火箭在那边。"}, {"type": "subtitle", "time": 7246.629, "timestamp": "02:00:46", "text": "定义。为什么我们没有躲避？因为我们是"}, {"type": "subtitle", "time": 7248.43, "timestamp": "02:00:48", "text": "不加班"}, {"type": "subtitle", "time": 7255.709, "timestamp": "02:00:55", "text": "伤心。那是"}]
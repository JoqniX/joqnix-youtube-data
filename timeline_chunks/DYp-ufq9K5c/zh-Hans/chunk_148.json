[{"type": "subtitle", "time": 8881.11, "timestamp": "02:28:01", "text": "三。"}, {"type": "subtitle", "time": 8882.75, "timestamp": "02:28:02", "text": "我要去"}, {"type": "subtitle", "time": 8889.67, "timestamp": "02:28:09", "text": "你觉得艾玛·弗罗斯特可以，你知道，"}, {"type": "subtitle", "time": 8891.59, "timestamp": "02:28:11", "text": "她有心灵感应能力，对吧？你觉得她"}, {"type": "subtitle", "time": 8893.75, "timestamp": "02:28:13", "text": "思想就能让人变同性恋"}, {"type": "subtitle", "time": 8896.71, "timestamp": "02:28:16", "text": "控制？"}, {"type": "subtitle", "time": 8901.71, "timestamp": "02:28:21", "text": "我的天啊。他真的这么做了吗？"}, {"type": "subtitle", "time": 8904.71, "timestamp": "02:28:24", "text": "直接使出过肩摔？是的，我刚把他做出来。"}, {"type": "subtitle", "time": 8907.83, "timestamp": "02:28:27", "text": "是的，我做了。"}, {"type": "subtitle", "time": 8916.15, "timestamp": "02:28:36", "text": "治疗师。她造成了如此大的破坏，却没有任何意义。"}, {"type": "subtitle", "time": 8919.91, "timestamp": "02:28:39", "text": "原因。我的意思是，你的确有。她是欧米伽。"}, {"type": "subtitle", "time": 8927.71, "timestamp": "02:28:47", "text": "我喜欢艾玛·弗罗斯特。说实话，我喜欢任何"}, {"type": "subtitle", "time": 8930.95, "timestamp": "02:28:50", "text": "具有类似二次突变的突变体。他们"}, {"type": "subtitle", "time": 8938.71, "timestamp": "02:28:58", "text": "霜冻就是其中之一。"}]
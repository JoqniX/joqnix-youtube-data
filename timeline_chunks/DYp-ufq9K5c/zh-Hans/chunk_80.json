[{"type": "subtitle", "time": 4800.39, "timestamp": "01:20:00", "text": "我的天啊。万磁王。"}, {"type": "subtitle", "time": 4813.189, "timestamp": "01:20:13", "text": "滚出去。最终得分。那是"}, {"type": "subtitle", "time": 4814.95, "timestamp": "01:20:14", "text": "不错吧？我觉得我没有"}, {"type": "subtitle", "time": 4817.51, "timestamp": "01:20:17", "text": "把MVP的头衔留给我吧，不过我表现得还不错。"}, {"type": "subtitle", "time": 4818.59, "timestamp": "01:20:18", "text": "我会说"}, {"type": "subtitle", "time": 4822.55, "timestamp": "01:20:22", "text": "那。我的服务能力已达上限。 07 07"}, {"type": "subtitle", "time": 4841.39, "timestamp": "01:20:41", "text": "他妈的"}, {"type": "subtitle", "time": 4846.95, "timestamp": "01:20:46", "text": "地狱。真是太令人沮丧了。"}, {"type": "subtitle", "time": 4849.75, "timestamp": "01:20:49", "text": "你抓不到他。就像坦克一样"}, {"type": "subtitle", "time": 4851.35, "timestamp": "01:20:51", "text": "那个玩家，那家伙最烦人了。"}, {"type": "subtitle", "time": 4853.59, "timestamp": "01:20:53", "text": "有史以来最棒的事。没错，就是这样，兄弟。那"}, {"type": "subtitle", "time": 4855.43, "timestamp": "01:20:55", "text": "最令人恼火的事。他着火了"}, {"type": "subtitle", "time": 4857.11, "timestamp": "01:20:57", "text": "你突然就会想，“为什么？”"}, {"type": "subtitle", "time": 4858.87, "timestamp": "01:20:58", "text": "我受到伤害了吗？前面没有人"}]
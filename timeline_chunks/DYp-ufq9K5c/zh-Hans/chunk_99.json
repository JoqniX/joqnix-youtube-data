[{"type": "subtitle", "time": 5940.229, "timestamp": "01:39:00", "text": "甚至能把这一点也做得很好。我们的巴基错过了"}, {"type": "subtitle", "time": 5942.79, "timestamp": "01:39:02", "text": "就像他在那件事上两次都全力以赴一样"}, {"type": "subtitle", "time": 5946.07, "timestamp": "01:39:06", "text": "他一圈下来，两次都失手了。你听说了吗？"}, {"type": "subtitle", "time": 5948.629, "timestamp": "01:39:08", "text": "他再去一次？"}, {"type": "subtitle", "time": 5951.149, "timestamp": "01:39:11", "text": "就像曾经那样。我"}, {"type": "subtitle", "time": 5954.39, "timestamp": "01:39:14", "text": "我不是又听到他走了一次吗？我"}, {"type": "subtitle", "time": 5957.75, "timestamp": "01:39:17", "text": "当时我就想：“哦，再来一次。” L."}, {"type": "subtitle", "time": 5959.51, "timestamp": "01:39:19", "text": "是的。比赛中最精彩的一击。你呢"}, {"type": "subtitle", "time": 5961.83, "timestamp": "01:39:21", "text": "只需做一次即可。"}, {"type": "subtitle", "time": 5964.07, "timestamp": "01:39:24", "text": "兄弟。如果我有那些​​弹药的话，我就有那些弹药了。"}, {"type": "subtitle", "time": 5967.39, "timestamp": "01:39:27", "text": "第一轮我们本来可以赢的。哦，"}, {"type": "subtitle", "time": 5974.51, "timestamp": "01:39:34", "text": "艾玛"}, {"type": "subtitle", "time": 5978.149, "timestamp": "01:39:38", "text": "霜？更像是你知道的那种？我该如何是好？"}, {"type": "subtitle", "time": 5980.79, "timestamp": "01:39:40", "text": "想一起玩吗？"}, {"type": "subtitle", "time": 5983.27, "timestamp": "01:39:43", "text": "我没说黑豹。"}, {"type": "subtitle", "time": 5985.75, "timestamp": "01:39:45", "text": "我的天哪，老兄。你绝对应该"}, {"type": "subtitle", "time": 5986.91, "timestamp": "01:39:46", "text": "玩"}, {"type": "subtitle", "time": 5991.669, "timestamp": "01:39:51", "text": "嗯……你在玩《决斗》这款游戏，对吧？"}, {"type": "subtitle", "time": 5994.31, "timestamp": "01:39:54", "text": "你应该这么做，我希望如此。你应该"}, {"type": "subtitle", "time": 5998.229, "timestamp": "01:39:58", "text": "一定要玩《美国队长2：冬日战士》。哟。哟。"}]
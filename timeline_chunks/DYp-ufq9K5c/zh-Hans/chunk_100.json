[{"type": "subtitle", "time": 6000.709, "timestamp": "01:40:00", "text": "哇，老兄。这是冬日战士。"}, {"type": "subtitle", "time": 6003.99, "timestamp": "01:40:03", "text": "那不是冬天。好了。"}, {"type": "subtitle", "time": 6007.35, "timestamp": "01:40:07", "text": "我找错了持枪者。这"}, {"type": "subtitle", "time": 6010.189, "timestamp": "01:40:10", "text": "错人了。"}, {"type": "subtitle", "time": 6013.75, "timestamp": "01:40:13", "text": "是的。妈的。我有一个任务要做"}, {"type": "subtitle", "time": 6016.27, "timestamp": "01:40:16", "text": "康复。"}, {"type": "subtitle", "time": 6019.51, "timestamp": "01:40:19", "text": "我明白了。不，不。看完这张地图后。"}, {"type": "subtitle", "time": 6021.51, "timestamp": "01:40:21", "text": "这场比赛之后。之后。我有"}, {"type": "subtitle", "time": 6023.83, "timestamp": "01:40:23", "text": "左边。你有一整天的时间来完成这件事。不是"}, {"type": "subtitle", "time": 6026.95, "timestamp": "01:40:26", "text": "任何人的跟班。我做的是最好的。"}, {"type": "subtitle", "time": 6033.03, "timestamp": "01:40:33", "text": "这张地图。哦，这是一张火爆人物地图。"}, {"type": "subtitle", "time": 6035.109, "timestamp": "01:40:35", "text": "我太喜欢冬日战士了。这家伙"}, {"type": "subtitle", "time": 6038.39, "timestamp": "01:40:38", "text": "已经两周没洗澡了。"}, {"type": "subtitle", "time": 6042.229, "timestamp": "01:40:42", "text": "是的。跟我一样。是的。什么？"}, {"type": "subtitle", "time": 6044.55, "timestamp": "01:40:44", "text": "什么？什么？你甚至都不玩这个"}, {"type": "subtitle", "time": 6046.109, "timestamp": "01:40:46", "text": "游戏？"}, {"type": "subtitle", "time": 6048.79, "timestamp": "01:40:48", "text": "什么？我确实玩这个游戏，但是……"}, {"type": "subtitle", "time": 6050.629, "timestamp": "01:40:50", "text": "PlayStation"}, {"type": "subtitle", "time": 6053.51, "timestamp": "01:40:53", "text": "和男孩们一起玩游戏"}]
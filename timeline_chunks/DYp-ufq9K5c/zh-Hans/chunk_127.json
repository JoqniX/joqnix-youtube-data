[{"type": "subtitle", "time": 7622.83, "timestamp": "02:07:02", "text": "为什么是Priya？我不知道。等等，有人"}, {"type": "subtitle", "time": 7626.79, "timestamp": "02:07:06", "text": "完全是韩国。我知道。你好。问题"}, {"type": "subtitle", "time": 7629.03, "timestamp": "02:07:09", "text": "标记。你好。你好。有人在吗？我们"}, {"type": "subtitle", "time": 7631.03, "timestamp": "02:07:11", "text": "就在这里。你好。"}, {"type": "subtitle", "time": 7632.189, "timestamp": "02:07:12", "text": "人们"}, {"type": "subtitle", "time": 7635.75, "timestamp": "02:07:15", "text": "呃，哦，对不起。我无法直视"}, {"type": "subtitle", "time": 7637.51, "timestamp": "02:07:17", "text": "比利聊天。所以，如果有那么多人"}, {"type": "subtitle", "time": 7639.589, "timestamp": "02:07:19", "text": "对不起，我深感抱歉。我看不见你。"}, {"type": "subtitle", "time": 7641.03, "timestamp": "02:07:21", "text": "是的，我想有几个人。"}, {"type": "subtitle", "time": 7642.709, "timestamp": "02:07:22", "text": "这里。"}, {"type": "subtitle", "time": 7644.55, "timestamp": "02:07:24", "text": "整个网站都是中文的。我不能"}, {"type": "subtitle", "time": 7646.709, "timestamp": "02:07:26", "text": "甚至可以显示观看人数。只是"}, {"type": "subtitle", "time": 7648.87, "timestamp": "02:07:28", "text": "把翻译器打开，伙计。快点。"}, {"type": "subtitle", "time": 7650.229, "timestamp": "02:07:30", "text": "谁能做到这一点？它不让我……"}, {"type": "subtitle", "time": 7652.069, "timestamp": "02:07:32", "text": "出于某种原因，需要翻译该网站。抓住"}, {"type": "subtitle", "time": 7655.669, "timestamp": "02:07:35", "text": "在。呃，去你的吧。哇，老兄。"}, {"type": "subtitle", "time": 7659.109, "timestamp": "02:07:39", "text": "你太酷了，兄弟。圣洁的她"}, {"type": "subtitle", "time": 7660.95, "timestamp": "02:07:40", "text": "球。"}, {"type": "subtitle", "time": 7663.589, "timestamp": "02:07:43", "text": "哦，哇。格鲁特餐厅已开业。你知道"}, {"type": "subtitle", "time": 7665.51, "timestamp": "02:07:45", "text": "那是什么意思？不。你知道那是什么吗？"}, {"type": "subtitle", "time": 7667.35, "timestamp": "02:07:47", "text": "方法？"}, {"type": "subtitle", "time": 7669.83, "timestamp": "02:07:49", "text": "你知道这意味着什么吗？"}, {"type": "subtitle", "time": 7673.43, "timestamp": "02:07:53", "text": "天哪，这皮肤真干净。哇。"}, {"type": "subtitle", "time": 7676.149, "timestamp": "02:07:56", "text": "完全一样。"}, {"type": "subtitle", "time": 7678.629, "timestamp": "02:07:58", "text": "哦，是的。它很干净。我的想法是，不。"}, {"type": "subtitle", "time": 7679.83, "timestamp": "02:07:59", "text": "看看这双靴子。你看到了吗？"}]
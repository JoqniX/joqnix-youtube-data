[{"type": "subtitle", "time": 13141.59, "timestamp": "03:39:01", "text": "菜单。"}, {"type": "subtitle", "time": 13174.309, "timestamp": "03:39:34", "text": "另外，既然你已经玩过了，还有什么需要补充的吗？"}, {"type": "subtitle", "time": 13176.87, "timestamp": "03:39:36", "text": "谢谢你帮我玩这个游戏。是"}, {"type": "subtitle", "time": 13181.429, "timestamp": "03:39:41", "text": "有没有办法去除我拿走的东西"}, {"type": "subtitle", "time": 13182.83, "timestamp": "03:39:42", "text": "舵"}, {"type": "subtitle", "time": 13185.91, "timestamp": "03:39:45", "text": "那玩意儿？我掌舵。它告诉我"}, {"type": "subtitle", "time": 13189.19, "timestamp": "03:39:49", "text": "嗯，就一秒钟。我觉得我应该放"}, {"type": "subtitle", "time": 13192.75, "timestamp": "03:39:52", "text": "这道烤鱼"}, {"type": "subtitle", "time": 13196.59, "timestamp": "03:39:56", "text": "向下。我会把它放上去。"}, {"type": "subtitle", "time": 13199.51, "timestamp": "03:39:59", "text": "这里。如何丢弃物品？哦，我的天"}]
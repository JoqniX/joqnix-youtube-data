[{"type": "subtitle", "time": 4686.669, "timestamp": "01:18:06", "text": "[音乐]"}, {"type": "subtitle", "time": 4689.59, "timestamp": "01:18:09", "text": "最高赢家。好吧，我们输了。"}, {"type": "subtitle", "time": 4697.03, "timestamp": "01:18:17", "text": "我可以触摸一秒钟。"}, {"type": "subtitle", "time": 4699.99, "timestamp": "01:18:19", "text": "他们到达了一个检查点。现在是时候了"}, {"type": "subtitle", "time": 4702.47, "timestamp": "01:18:22", "text": "阻止他们。"}, {"type": "subtitle", "time": 4705.03, "timestamp": "01:18:25", "text": "老兄，如果你有一个支持者，那就好了。"}, {"type": "subtitle", "time": 4714.51, "timestamp": "01:18:34", "text": "老兄，我们能走了吗？"}, {"type": "subtitle", "time": 4732.55, "timestamp": "01:18:52", "text": "是的，我说得对。"}, {"type": "subtitle", "time": 4735.11, "timestamp": "01:18:55", "text": "坦克一开进来，我"}]
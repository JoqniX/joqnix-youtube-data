[{"type": "subtitle", "time": 13996.59, "timestamp": "03:53:16", "text": "科技玻璃"}, {"type": "subtitle", "time": 14000.309, "timestamp": "03:53:20", "text": "炼油厂。我们走吧。我成功了。现在我们"}, {"type": "subtitle", "time": 14005.229, "timestamp": "03:53:25", "text": "可以闻到。耶。铜"}, {"type": "subtitle", "time": 14007.269, "timestamp": "03:53:27", "text": "矿石。所以我说，关于崩溃"}, {"type": "subtitle", "time": 14009.349, "timestamp": "03:53:29", "text": "如果找到金属部件，你"}, {"type": "subtitle", "time": 14012.55, "timestamp": "03:53:32", "text": "可以把它敲碎成金属片。足够的"}, {"type": "subtitle", "time": 14014.229, "timestamp": "03:53:34", "text": "嗯，足够做几块了，你可以做……"}, {"type": "subtitle", "time": 14016.269, "timestamp": "03:53:36", "text": "铁条。"}, {"type": "subtitle", "time": 14023.07, "timestamp": "03:53:43", "text": "啊，"}, {"type": "subtitle", "time": 14025.59, "timestamp": "03:53:45", "text": "有趣的。未经加工的玻璃。我必须做一个"}, {"type": "subtitle", "time": 14027.87, "timestamp": "03:53:47", "text": "生的"}, {"type": "subtitle", "time": 14031.189, "timestamp": "03:53:51", "text": "玻璃。我怎样才能再次制作出一块玻璃原石？"}, {"type": "subtitle", "time": 14032.91, "timestamp": "03:53:52", "text": "我只需要"}, {"type": "subtitle", "time": 14035.95, "timestamp": "03:53:55", "text": "沙。用于制作黑曜石工具和"}, {"type": "subtitle", "time": 14038.429, "timestamp": "03:53:58", "text": "武器。"}]
[{"type": "subtitle", "time": 8825.11, "timestamp": "02:27:05", "text": "是的，那太好了。我可以"}, {"type": "subtitle", "time": 8833.19, "timestamp": "02:27:13", "text": "压力越高，哦我的天哪"}, {"type": "subtitle", "time": 8836.23, "timestamp": "02:27:16", "text": "天哪，那位女士的领带。是吗？"}, {"type": "subtitle", "time": 8838.79, "timestamp": "02:27:18", "text": "萨布丽娜·卡彭特？"}, {"type": "subtitle", "time": 8841.03, "timestamp": "02:27:21", "text": "幸福。"}, {"type": "subtitle", "time": 8843.75, "timestamp": "02:27:23", "text": "你见过她身上的皮肤吗？你"}, {"type": "subtitle", "time": 8847.27, "timestamp": "02:27:27", "text": "见过萨布丽娜的呃金属吗？它是"}, {"type": "subtitle", "time": 8849.95, "timestamp": "02:27:29", "text": "我当时就想，"}, {"type": "subtitle", "time": 8852.87, "timestamp": "02:27:32", "text": "哇哇。我当时就想，这简直就是……"}, {"type": "subtitle", "time": 8855.19, "timestamp": "02:27:35", "text": "只是表面呈棕色，老兄。我当时就想，"}, {"type": "subtitle", "time": 8857.83, "timestamp": "02:27:37", "text": "哦，这到底是怎么回事？是的，更像是"}, {"type": "subtitle", "time": 8865.19, "timestamp": "02:27:45", "text": "你可以说它是"}, {"type": "subtitle", "time": 8867.23, "timestamp": "02:27:47", "text": "有点像红棕色，你知道的。"}, {"type": "subtitle", "time": 8872.59, "timestamp": "02:27:52", "text": "酒红色，就像复古风。"}, {"type": "subtitle", "time": 8874.19, "timestamp": "02:27:54", "text": "栗色人"}, {"type": "subtitle", "time": 8877.27, "timestamp": "02:27:57", "text": "看起来像魔力红乐队。去抓"}, {"type": "subtitle", "time": 8878.71, "timestamp": "02:27:58", "text": "当他要去所有地方时，感觉很奇怪"}]
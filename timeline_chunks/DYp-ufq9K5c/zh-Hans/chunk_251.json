[{"type": "subtitle", "time": 15061.15, "timestamp": "04:11:01", "text": "上帝。我的天啊。这是"}, {"type": "subtitle", "time": 15064.15, "timestamp": "04:11:04", "text": "你可以住在这里。你可以睡觉"}, {"type": "subtitle", "time": 15068.15, "timestamp": "04:11:08", "text": "这里。你可以做很多事情。自由的"}, {"type": "subtitle", "time": 15071.269, "timestamp": "04:11:11", "text": "农作物。农作物会生长，你也可以种植农作物。"}, {"type": "subtitle", "time": 15073.07, "timestamp": "04:11:13", "text": "以及所有的一切。你可以拥有"}, {"type": "subtitle", "time": 15083.83, "timestamp": "04:11:23", "text": "节日期间我看到了蒸汽朋克风格的东西。我明白了。"}, {"type": "subtitle", "time": 15088.15, "timestamp": "04:11:28", "text": "哦，我看到了一些很酷的装备。那个"}, {"type": "subtitle", "time": 15090.469, "timestamp": "04:11:30", "text": "我认为这控制着一切。"}, {"type": "subtitle", "time": 15094.269, "timestamp": "04:11:34", "text": "这艘船的事情。哇。控制"}, {"type": "subtitle", "time": 15100.469, "timestamp": "04:11:40", "text": "这是在跳舞吗？这就像……"}, {"type": "subtitle", "time": 15107.51, "timestamp": "04:11:47", "text": "区域？这就像一个标志。哦，"}, {"type": "subtitle", "time": 15109.83, "timestamp": "04:11:49", "text": "或许那里有太阳能电池板。"}, {"type": "subtitle", "time": 15114.429, "timestamp": "04:11:54", "text": "或许有可能。我看到一盏灯笼"}, {"type": "subtitle", "time": 15118.07, "timestamp": "04:11:58", "text": "光。该死。你为什么要做这一切"}, {"type": "subtitle", "time": 15119.309, "timestamp": "04:11:59", "text": "经过"}]
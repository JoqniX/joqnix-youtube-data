[{"type": "subtitle", "time": 18300.868, "timestamp": "05:05:00", "text": "上帝。我的天啊。我需要修理"}, {"type": "subtitle", "time": 18302.19, "timestamp": "05:05:02", "text": "船，我"}, {"type": "subtitle", "time": 18322.868, "timestamp": "05:05:22", "text": "放几个sto等一下怎么做"}, {"type": "subtitle", "time": 18325.11, "timestamp": "05:05:25", "text": "我忘了问储物箱的事了。"}, {"type": "subtitle", "time": 18327.47, "timestamp": "05:05:27", "text": "现在这一点很重要"}, {"type": "subtitle", "time": 18337.48, "timestamp": "05:05:37", "text": "现在我只需要找到存储空间"}, {"type": "subtitle", "time": 18347.99, "timestamp": "05:05:47", "text": "如果那是《我的世界》的话"}, {"type": "subtitle", "time": 18352.27, "timestamp": "05:05:52", "text": "很简单。就做几个木头"}]
[{"type": "subtitle", "time": 16279.99, "timestamp": "04:31:19", "text": "装载车辆存储端口。一旦你"}, {"type": "subtitle", "time": 16282.07, "timestamp": "04:31:22", "text": "能够将车辆锁定在船上。"}, {"type": "subtitle", "time": 16293.55, "timestamp": "04:31:33", "text": "看，两个"}, {"type": "subtitle", "time": 16296.269, "timestamp": "04:31:36", "text": "树、旗帜和"}, {"type": "subtitle", "time": 16298.79, "timestamp": "04:31:38", "text": "东西。看起来像武器。它是"}, {"type": "subtitle", "time": 16302.11, "timestamp": "04:31:42", "text": "其实里面有个风扇。"}, {"type": "subtitle", "time": 16305.75, "timestamp": "04:31:45", "text": "圣。这就像泰坦尼克号事件那样。"}, {"type": "subtitle", "time": 16306.99, "timestamp": "04:31:46", "text": "好的"}, {"type": "subtitle", "time": 16309.95, "timestamp": "04:31:49", "text": "寻找"}, {"type": "subtitle", "time": 16312.71, "timestamp": "04:31:52", "text": "锚。这看起来像个娘炮。想象一下如果"}, {"type": "subtitle", "time": 16313.95, "timestamp": "04:31:53", "text": "有人建造了"}, {"type": "subtitle", "time": 16316.229, "timestamp": "04:31:56", "text": "泰坦尼克号。这款游戏拥有无限"}, {"type": "subtitle", "time": 16318.229, "timestamp": "04:31:58", "text": "可能性。我感觉自己建造了"}]
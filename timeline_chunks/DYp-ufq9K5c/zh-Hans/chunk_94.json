[{"type": "subtitle", "time": 5649.95, "timestamp": "01:34:09", "text": "死吧，死吧，死吧"}, {"type": "subtitle", "time": 5653.75, "timestamp": "01:34:13", "text": "死。伙计们，他现在状态依然很低。我们可以拍摄吗？"}, {"type": "subtitle", "time": 5662.629, "timestamp": "01:34:22", "text": "哦，所有人都死了。我的都是垃圾。医学"}, {"type": "subtitle", "time": 5664.31, "timestamp": "01:34:24", "text": "是"}, {"type": "subtitle", "time": 5672.39, "timestamp": "01:34:32", "text": "赶紧离开。出去。出去。他们是"}, {"type": "subtitle", "time": 5675.43, "timestamp": "01:34:35", "text": "跑你的渐弱动作。哟，搞什么鬼？"}, {"type": "subtitle", "time": 5677.189, "timestamp": "01:34:37", "text": "两个油箱。我当然要他妈的"}, {"type": "subtitle", "time": 5679.75, "timestamp": "01:34:39", "text": "去他妈的。他们有两个。他把一切都放了进去"}, {"type": "subtitle", "time": 5683.03, "timestamp": "01:34:43", "text": "向下。这种保护不会持久。"}, {"type": "subtitle", "time": 5684.87, "timestamp": "01:34:44", "text": "我勒个去？你知道他把所有东西都放在哪里了吗？"}, {"type": "subtitle", "time": 5688.149, "timestamp": "01:34:48", "text": "向下？在那个阴森森的小巷里。"}, {"type": "subtitle", "time": 5690.39, "timestamp": "01:34:50", "text": "兄弟，"}, {"type": "subtitle", "time": 5692.55, "timestamp": "01:34:52", "text": "这个人。不，不，他甚至都没放"}, {"type": "subtitle", "time": 5694.47, "timestamp": "01:34:54", "text": "就是巷子里的那条。正中要害。"}, {"type": "subtitle", "time": 5696.55, "timestamp": "01:34:56", "text": "正中要害。哦，正中要害。"}]
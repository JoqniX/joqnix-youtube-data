[{"type": "subtitle", "time": 9961.83, "timestamp": "02:46:01", "text": "我不知道为什么我的狗这么显眼"}, {"type": "subtitle", "time": 9964.63, "timestamp": "02:46:04", "text": "Lapas 无法正常运行。它不是"}, {"type": "subtitle", "time": 9967.83, "timestamp": "02:46:07", "text": "甚至显示我正在直播。"}, {"type": "subtitle", "time": 9990.469, "timestamp": "02:46:30", "text": "赌博。我希望你像游戏玩家一样。"}, {"type": "subtitle", "time": 9993.51, "timestamp": "02:46:33", "text": "男。是的。是的。是的。好的。我当时"}, {"type": "subtitle", "time": 9995.19, "timestamp": "02:46:35", "text": "阅读聊天和玩游戏。太难了"}, {"type": "subtitle", "time": 9997.67, "timestamp": "02:46:37", "text": "这样做。我不知道你是怎么做到的。"}, {"type": "subtitle", "time": 10000.63, "timestamp": "02:46:40", "text": "这太难做到了。我不知道我该怎么做"}, {"type": "subtitle", "time": 10002.469, "timestamp": "02:46:42", "text": "你也这样做。我的意思是，如果你有"}, {"type": "subtitle", "time": 10005.269, "timestamp": "02:46:45", "text": "多台显示器或其他阅读设备"}, {"type": "subtitle", "time": 10009.03, "timestamp": "02:46:49", "text": "侧面来看，这行得通。但这场斗争"}, {"type": "subtitle", "time": 10011.99, "timestamp": "02:46:51", "text": "斗争就是合作虾，"}, {"type": "subtitle", "time": 10013.75, "timestamp": "02:46:53", "text": "你必须阅读聊天记录并进行互动"}, {"type": "subtitle", "time": 10015.75, "timestamp": "02:46:55", "text": "他们。而且，你还需要互动。"}, {"type": "subtitle", "time": 10019.91, "timestamp": "02:46:59", "text": "与合作方一起。嗯。耶。我"}]
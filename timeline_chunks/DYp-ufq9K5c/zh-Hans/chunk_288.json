[{"type": "subtitle", "time": 17283.868, "timestamp": "04:48:03", "text": "柴油机。人气。我可以改变"}, {"type": "subtitle", "time": 17288.07, "timestamp": "04:48:08", "text": "这。哦，等等。我可以输入零，"}, {"type": "subtitle", "time": 17290.67, "timestamp": "04:48:10", "text": "看。"}, {"type": "subtitle", "time": 17293.628, "timestamp": "04:48:13", "text": "确认。"}, {"type": "subtitle", "time": 17296.628, "timestamp": "04:48:16", "text": "不，那只是游戏里的钱。"}, {"type": "subtitle", "time": 17319.43, "timestamp": "04:48:39", "text": "退出至主菜单。不要保存。那是"}, {"type": "subtitle", "time": 17322.59, "timestamp": "04:48:42", "text": "真有趣。探索"}, {"type": "subtitle", "time": 17327.39, "timestamp": "04:48:47", "text": "那。真酷。真蠢"}, {"type": "subtitle", "time": 17330.75, "timestamp": "04:48:50", "text": "基本的。上面仍然写着"}, {"type": "subtitle", "time": 17337.788, "timestamp": "04:48:57", "text": "铁。"}]
[{"type": "subtitle", "time": 9540.309, "timestamp": "02:39:00", "text": "再生能力和利爪是两个独立的部分。"}, {"type": "subtitle", "time": 9542.79, "timestamp": "02:39:02", "text": "事情就是这样，对吧？"}, {"type": "subtitle", "time": 9544.63, "timestamp": "02:39:04", "text": "是的。而且它们之间没有任何关联。"}, {"type": "subtitle", "time": 9547.349, "timestamp": "02:39:07", "text": "其他方面，他最初拥有的是什么？爪子或"}, {"type": "subtitle", "time": 9550.469, "timestamp": "02:39:10", "text": "再生？他一直都有"}, {"type": "subtitle", "time": 9553.11, "timestamp": "02:39:13", "text": "同时是他们两个。所以"}, {"type": "subtitle", "time": 9555.99, "timestamp": "02:39:15", "text": "操，他们聚在一起就是为了不"}, {"type": "subtitle", "time": 9559.75, "timestamp": "02:39:19", "text": "这真的算是二次突变吗？"}, {"type": "subtitle", "time": 9562.95, "timestamp": "02:39:22", "text": "是的。是的。有点奇怪。同样如此"}, {"type": "subtitle", "time": 9564.309, "timestamp": "02:39:24", "text": "和甘·格雷一起，对吧？她有"}, {"type": "subtitle", "time": 9567.429, "timestamp": "02:39:27", "text": "心灵感应和念力，但就像他们"}, {"type": "subtitle", "time": 9569.27, "timestamp": "02:39:29", "text": "并非分开的。他们来了"}, {"type": "subtitle", "time": 9571.03, "timestamp": "02:39:31", "text": "同时。"}, {"type": "subtitle", "time": 9573.67, "timestamp": "02:39:33", "text": "所以，你知道，二次突变是"}, {"type": "subtitle", "time": 9580.75, "timestamp": "02:39:40", "text": "我们不知道该如何称呼一个"}, {"type": "subtitle", "time": 9583.67, "timestamp": "02:39:43", "text": "二次突变，对吧？就像它"}, {"type": "subtitle", "time": 9586.15, "timestamp": "02:39:46", "text": "可以。我没有评判的意思。是的，就是它的"}, {"type": "subtitle", "time": 9588.87, "timestamp": "02:39:48", "text": "真是奇怪。这就像一场奇怪的直接骗局"}, {"type": "subtitle", "time": 9591.83, "timestamp": "02:39:51", "text": "漫画作家们可以这样表达他们的想法。"}, {"type": "subtitle", "time": 9595.11, "timestamp": "02:39:55", "text": "角色们获得了新的扯淡能力。"}, {"type": "subtitle", "time": 9599.11, "timestamp": "02:39:59", "text": "是的。然后制定一个新的方案。是的。"}]
[{"type": "subtitle", "time": 18846.708, "timestamp": "05:14:06", "text": "明白了。哦，坚定的支持者们。有很多"}, {"type": "subtitle", "time": 18849.55, "timestamp": "05:14:09", "text": "贮存。"}, {"type": "subtitle", "time": 18852.628, "timestamp": "05:14:12", "text": "哦，我很好奇为什么没有木制的"}, {"type": "subtitle", "time": 18858.39, "timestamp": "05:14:18", "text": "为什么制作石箱很容易？等待，"}, {"type": "subtitle", "time": 18860.91, "timestamp": "05:14:20", "text": "但不"}, {"type": "subtitle", "time": 18864.35, "timestamp": "05:14:24", "text": "木制的。好吧，我需要你的黑曜石。"}, {"type": "subtitle", "time": 18875.43, "timestamp": "05:14:35", "text": "操作之类的东西。我需要一块陶土，对吧？"}, {"type": "subtitle", "time": 18877.948, "timestamp": "05:14:37", "text": "我想我当时有黏土。"}, {"type": "subtitle", "time": 18881.07, "timestamp": "05:14:41", "text": "这里。带上这些"}, {"type": "subtitle", "time": 18883.47, "timestamp": "05:14:43", "text": "黏土。"}, {"type": "subtitle", "time": 18894.19, "timestamp": "05:14:54", "text": "盒。这是什么？资源"}, {"type": "subtitle", "time": 18896.99, "timestamp": "05:14:56", "text": "包。包装"}, {"type": "subtitle", "time": 18899.91, "timestamp": "05:14:59", "text": "铜。包裹。一包煤。"}]
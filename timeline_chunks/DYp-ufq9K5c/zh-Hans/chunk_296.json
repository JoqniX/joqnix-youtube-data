[{"type": "subtitle", "time": 17761.59, "timestamp": "04:56:01", "text": "游戏存档？"}, {"type": "subtitle", "time": 17763.75, "timestamp": "04:56:03", "text": "托管共享游戏存档与普通游戏存档一样。"}, {"type": "subtitle", "time": 17765.51, "timestamp": "04:56:05", "text": "在主机上玩游戏，这意味着"}, {"type": "subtitle", "time": 17767.83, "timestamp": "04:56:07", "text": "通过手动坐姿快速击球"}, {"type": "subtitle", "time": 17770.15, "timestamp": "04:56:10", "text": "退出时会自动保存并进行常规保存。"}, {"type": "subtitle", "time": 17773.03, "timestamp": "04:56:13", "text": "游戏被上传到"}, {"type": "subtitle", "time": 17783.07, "timestamp": "04:56:23", "text": "呃，我的店会怎么样？"}, {"type": "subtitle", "time": 17786.55, "timestamp": "04:56:26", "text": "输入限制后你就可以玩了。"}, {"type": "subtitle", "time": 17790.55, "timestamp": "04:56:30", "text": "玩别人的游戏，或者主持别人的游戏。"}, {"type": "subtitle", "time": 17793.75, "timestamp": "04:56:33", "text": "哦，如果我的……我会丢失一些数据吗？"}, {"type": "subtitle", "time": 17795.868, "timestamp": "04:56:35", "text": "到达我的"}, {"type": "subtitle", "time": 17799.19, "timestamp": "04:56:39", "text": "飞机商店不会再有另一家了，直到"}, {"type": "subtitle", "time": 17801.83, "timestamp": "04:56:41", "text": "云存储空间已释放更多。"}, {"type": "subtitle", "time": 17808.55, "timestamp": "04:56:48", "text": "呃，告诉我们你只想​​让哪些人……"}, {"type": "subtitle", "time": 17810.35, "timestamp": "04:56:50", "text": "玩什么？我该如何提高金额？"}, {"type": "subtitle", "time": 17813.43, "timestamp": "04:56:53", "text": "老虎机？免费版是三级，付费版是三级。"}, {"type": "subtitle", "time": 17815.99, "timestamp": "04:56:55", "text": "等级为五级。我们也可以计划"}, {"type": "subtitle", "time": 17819.11, "timestamp": "04:56:59", "text": "增加更多付费名额。能"}]
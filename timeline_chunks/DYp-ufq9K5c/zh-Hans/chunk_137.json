[{"type": "subtitle", "time": 8222.23, "timestamp": "02:17:02", "text": "天哪，那节目太精彩了。毒液"}, {"type": "subtitle", "time": 8225.349, "timestamp": "02:17:05", "text": "《神奇蜘蛛侠》中的剧情线。哦，我的天"}, {"type": "subtitle", "time": 8228.91, "timestamp": "02:17:08", "text": "天哪，太棒了。超好的。 H 好"}, {"type": "subtitle", "time": 8232.99, "timestamp": "02:17:12", "text": "写作。超好的。我喜欢优秀的作品。"}, {"type": "subtitle", "time": 8235.75, "timestamp": "02:17:15", "text": "一切。你知道为什么我"}, {"type": "subtitle", "time": 8237.79, "timestamp": "02:17:17", "text": "有点像终极蜘蛛侠那样"}, {"type": "subtitle", "time": 8240.469, "timestamp": "02:17:20", "text": "多元宇宙方面。你知道"}, {"type": "subtitle", "time": 8242.309, "timestamp": "02:17:22", "text": "什么？对，没错。 MCU那件事，"}, {"type": "subtitle", "time": 8244.549, "timestamp": "02:17:24", "text": "正确的？他们在哪里，就像"}, {"type": "subtitle", "time": 8247.669, "timestamp": "02:17:27", "text": "如此广阔。大家都到齐了，但我们"}, {"type": "subtitle", "time": 8249.429, "timestamp": "02:17:29", "text": "仍然存在这些底层问题"}, {"type": "subtitle", "time": 8251.83, "timestamp": "02:17:31", "text": "不知何故，没有人帮助我们。而且"}, {"type": "subtitle", "time": 8254.15, "timestamp": "02:17:34", "text": "记住，记住金刚狼。"}, {"type": "subtitle", "time": 8257.429, "timestamp": "02:17:37", "text": "该剧的配音演员是"}, {"type": "subtitle", "time": 8260.629, "timestamp": "02:17:40", "text": "很可能是同一个人。"}, {"type": "subtitle", "time": 8264.07, "timestamp": "02:17:44", "text": "可能还要持续更长时间。"}, {"type": "subtitle", "time": 8265.669, "timestamp": "02:17:45", "text": "是的。"}, {"type": "subtitle", "time": 8268.23, "timestamp": "02:17:48", "text": "该死。我们没有油罐。"}, {"type": "subtitle", "time": 8271.589, "timestamp": "02:17:51", "text": "我是谁？想象一下拥有"}, {"type": "subtitle", "time": 8274.87, "timestamp": "02:17:54", "text": "谁还需要坦克？"}, {"type": "subtitle", "time": 8278.389, "timestamp": "02:17:58", "text": "你是金刚狼。你可以坦克。"}]
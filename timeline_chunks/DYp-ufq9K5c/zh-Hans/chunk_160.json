[{"type": "subtitle", "time": 9607.429, "timestamp": "02:40:07", "text": "[音乐]"}, {"type": "subtitle", "time": 9614.389, "timestamp": "02:40:14", "text": "男人。我现在就想玩风暴之王，但是"}, {"type": "subtitle", "time": 9617.19, "timestamp": "02:40:17", "text": "我不能。"}, {"type": "subtitle", "time": 9621.11, "timestamp": "02:40:21", "text": "我需要那个。呃，那到底是什么鬼东西？"}, {"type": "subtitle", "time": 9623.429, "timestamp": "02:40:23", "text": "女神。我需要那个。我需要那个"}, {"type": "subtitle", "time": 9627.19, "timestamp": "02:40:27", "text": "我的人生。欢迎来到地狱火盛宴，宝贝。"}, {"type": "subtitle", "time": 9630.63, "timestamp": "02:40:30", "text": "攻击前30秒。准备。"}, {"type": "subtitle", "time": 9636.95, "timestamp": "02:40:36", "text": "去。我迫不及待地想玩Ultra版。我需要它。"}, {"type": "subtitle", "time": 9638.71, "timestamp": "02:40:38", "text": "他显然会扮演辅助角色。"}, {"type": "subtitle", "time": 9642.63, "timestamp": "02:40:42", "text": "是的，这就是我想要的。"}, {"type": "subtitle", "time": 9643.99, "timestamp": "02:40:43", "text": "兄弟，我只想看他出局。"}, {"type": "subtitle", "time": 9645.99, "timestamp": "02:40:45", "text": "就像他的无人机那样，然后说：“对，杀！”"}, {"type": "subtitle", "time": 9648.63, "timestamp": "02:40:48", "text": "他。”"}, {"type": "subtitle", "time": 9651.59, "timestamp": "02:40:51", "text": "是的。我想，我想看到他飞起来"}, {"type": "subtitle", "time": 9653.67, "timestamp": "02:40:53", "text": "然后杀死钢铁侠。这就是我想要的。"}, {"type": "subtitle", "time": 9657.59, "timestamp": "02:40:57", "text": "很容易看清。一个钢铁侠。爽！哦，"}, {"type": "subtitle", "time": 9659.429, "timestamp": "02:40:59", "text": "那太疯狂了。任务"}]
[{"type": "subtitle", "time": 7982.719, "timestamp": "02:13:02", "text": "跳？我认为是第二名。嗯哼。你 你两个都没得到。哟，有"}, {"type": "subtitle", "time": 7985.76, "timestamp": "02:13:05", "text": "你两个都没得到。哟，有 被骗了。"}, {"type": "subtitle", "time": 7993.03, "timestamp": "02:13:13", "text": "苹果。好吧，Mac快不行了。"}, {"type": "subtitle", "time": 7994.95, "timestamp": "02:13:14", "text": "他快要死了。"}, {"type": "subtitle", "time": 8002.069, "timestamp": "02:13:22", "text": "我喜欢Mac能把你扔出去的方式。"}, {"type": "subtitle", "time": 8004.629, "timestamp": "02:13:24", "text": "因为你是金刚狼，所以才会在附近。"}, {"type": "subtitle", "time": 8007.03, "timestamp": "02:13:27", "text": "不，"}, {"type": "subtitle", "time": 8014.069, "timestamp": "02:13:34", "text": "你让他们用了两堵墙。那是"}, {"type": "subtitle", "time": 8015.83, "timestamp": "02:13:35", "text": "好的。"}, {"type": "subtitle", "time": 8018.709, "timestamp": "02:13:38", "text": "我的天啊。恐慌情绪已经开始蔓延。"}, {"type": "subtitle", "time": 8020.229, "timestamp": "02:13:40", "text": "哎，总得有人做点什么吧"}, {"type": "subtitle", "time": 8021.589, "timestamp": "02:13:41", "text": "兄弟，那边那个惩罚者。他是"}, {"type": "subtitle", "time": 8025.109, "timestamp": "02:13:45", "text": "准备起飞。"}, {"type": "subtitle", "time": 8029.43, "timestamp": "02:13:49", "text": "杀了他。杀了他。杀了他。"}, {"type": "subtitle", "time": 8032.31, "timestamp": "02:13:52", "text": "谢谢。"}, {"type": "subtitle", "time": 8035.03, "timestamp": "02:13:55", "text": "哦，她……哦，至少你还有再生能力。"}]
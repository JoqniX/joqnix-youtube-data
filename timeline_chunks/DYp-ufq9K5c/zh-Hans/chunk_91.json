[{"type": "subtitle", "time": 5463.59, "timestamp": "01:31:03", "text": "好的，我要换个不同的……"}, {"type": "subtitle", "time": 5468.39, "timestamp": "01:31:08", "text": "准备换成巴基。快点。"}, {"type": "subtitle", "time": 5472.47, "timestamp": "01:31:12", "text": "糟糕。好吧，事情是这样的。"}, {"type": "subtitle", "time": 5474.149, "timestamp": "01:31:14", "text": "蜘蛛侠"}, {"type": "subtitle", "time": 5478.31, "timestamp": "01:31:18", "text": "他并没有摧毁后防线。集合。"}, {"type": "subtitle", "time": 5480.55, "timestamp": "01:31:20", "text": "你的力量就是我的力量。没人接受"}, {"type": "subtitle", "time": 5491.75, "timestamp": "01:31:31", "text": "我的天啊。"}, {"type": "subtitle", "time": 5495.27, "timestamp": "01:31:35", "text": "顺便问一下，我是西格玛成员吗？"}, {"type": "subtitle", "time": 5505.27, "timestamp": "01:31:45", "text": "兄弟，我好害怕这些帽子。悬挂"}, {"type": "subtitle", "time": 5507.35, "timestamp": "01:31:47", "text": "帮你吧，兄弟。帮你挂起来，"}, {"type": "subtitle", "time": 5512.99, "timestamp": "01:31:52", "text": "抓住他"}, {"type": "subtitle", "time": 5519.27, "timestamp": "01:31:59", "text": "几乎完美钩住了。随着时间的推移。"}]
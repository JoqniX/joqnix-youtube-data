[{"type": "subtitle", "time": 6361.669, "timestamp": "01:46:01", "text": "替代。但每次我试图了解的时候"}, {"type": "subtitle", "time": 6365.03, "timestamp": "01:46:05", "text": "当他助跑时"}, {"type": "subtitle", "time": 6368.31, "timestamp": "01:46:08", "text": "每当他猛击那个重击区域时，"}, {"type": "subtitle", "time": 6370.75, "timestamp": "01:46:10", "text": "你不能喜欢使用"}, {"type": "subtitle", "time": 6374.149, "timestamp": "01:46:14", "text": "呃，该怎么说呢？是什么？"}, {"type": "subtitle", "time": 6377.27, "timestamp": "01:46:17", "text": "应该怎么措辞？能力。"}, {"type": "subtitle", "time": 6379.99, "timestamp": "01:46:19", "text": "是啊，什么什么能力？哦，"}, {"type": "subtitle", "time": 6382.87, "timestamp": "01:46:22", "text": "好的。"}, {"type": "subtitle", "time": 6384.709, "timestamp": "01:46:24", "text": "比赛太专注了，没空说话。我的错"}, {"type": "subtitle", "time": 6387.39, "timestamp": "01:46:27", "text": "尽管。哦，没关系。我知道它是什么"}, {"type": "subtitle", "time": 6390.149, "timestamp": "01:46:30", "text": "是。宝贝女儿，我会一直陪着你。嗯，我"}, {"type": "subtitle", "time": 6392.95, "timestamp": "01:46:32", "text": "我知道。"}, {"type": "subtitle", "time": 6395.75, "timestamp": "01:46:35", "text": "我想把弹匣拔出来。"}, {"type": "subtitle", "time": 6399.31, "timestamp": "01:46:39", "text": "扣动双扳机。稍等片刻。"}, {"type": "subtitle", "time": 6403.27, "timestamp": "01:46:43", "text": "哦，继续，继续他妈的钩住"}, {"type": "subtitle", "time": 6405.27, "timestamp": "01:46:45", "text": "事物。是的，兄弟。他是唯一一个"}, {"type": "subtitle", "time": 6406.87, "timestamp": "01:46:46", "text": "每次都是谁来接我的钩子。"}, {"type": "subtitle", "time": 6415.75, "timestamp": "01:46:55", "text": "疯狂的。这是真正的火炬。"}, {"type": "subtitle", "time": 6419.51, "timestamp": "01:46:59", "text": "没关系。我还没说完。我不知道"}]
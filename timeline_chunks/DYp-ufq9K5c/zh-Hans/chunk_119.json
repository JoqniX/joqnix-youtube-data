[{"type": "subtitle", "time": 7144.55, "timestamp": "01:59:04", "text": "那。我的天哪，我们有"}, {"type": "subtitle", "time": 7149.99, "timestamp": "01:59:09", "text": "在黑暗中闪耀。"}, {"type": "subtitle", "time": 7179.75, "timestamp": "01:59:39", "text": "法官、陪审团、刽子手。"}, {"type": "subtitle", "time": 7182.31, "timestamp": "01:59:42", "text": "可能不太妙，兄弟。我的队友们"}, {"type": "subtitle", "time": 7186.149, "timestamp": "01:59:46", "text": "比如身体上……呃，笨？"}, {"type": "subtitle", "time": 7189.51, "timestamp": "01:59:49", "text": "太蠢了。它们的构造就像……"}, {"type": "subtitle", "time": 7192.149, "timestamp": "01:59:52", "text": "他妈的，没有人类，就像没有"}, {"type": "subtitle", "time": 7194.39, "timestamp": "01:59:54", "text": "脑？"}, {"type": "subtitle", "time": 7197.109, "timestamp": "01:59:57", "text": "因为那个陌生人就在他面前"}, {"type": "subtitle", "time": 7199.75, "timestamp": "01:59:59", "text": "我们。如果我们杀了他们，我们就会……"}]
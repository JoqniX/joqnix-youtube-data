[{"type": "subtitle", "time": 16750.109, "timestamp": "04:39:10", "text": "凉爽的。好的，我们来看看。泰坦"}, {"type": "subtitle", "time": 16753.83, "timestamp": "04:39:13", "text": "3D。我的天哪，看起来已经很疯狂了。"}, {"type": "subtitle", "time": 16756.551, "timestamp": "04:39:16", "text": "那是一个纺车吗？像水"}, {"type": "subtitle", "time": 16760.47, "timestamp": "04:39:20", "text": "他们放的那个轮子，我的天哪，快看！"}, {"type": "subtitle", "time": 16763.91, "timestamp": "04:39:23", "text": "弹道学。"}, {"type": "subtitle", "time": 16766.31, "timestamp": "04:39:26", "text": "看看那些大炮。我的天啊。它是"}, {"type": "subtitle", "time": 16768.67, "timestamp": "04:39:28", "text": "字面上的"}, {"type": "subtitle", "time": 16772.31, "timestamp": "04:39:32", "text": "军舰。里面那是筒仓吗？"}, {"type": "subtitle", "time": 16773.869, "timestamp": "04:39:33", "text": "这是"}, {"type": "subtitle", "time": 16776.029, "timestamp": "04:39:36", "text": "筒仓？哦，"}, {"type": "subtitle", "time": 16779.27, "timestamp": "04:39:39", "text": "什么？哦，是哦，不。不。这是呃……"}, {"type": "subtitle", "time": 16784.39, "timestamp": "04:39:44", "text": "那个烟囱。呃，那个g"}, {"type": "subtitle", "time": 16787.83, "timestamp": "04:39:47", "text": "气体一切都会到来。"}, {"type": "subtitle", "time": 16790.27, "timestamp": "04:39:50", "text": "鲜花、黑烟，一切都如此。"}, {"type": "subtitle", "time": 16798.99, "timestamp": "04:39:58", "text": "好的。"}]
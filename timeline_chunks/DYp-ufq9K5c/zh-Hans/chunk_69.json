[{"type": "subtitle", "time": 4146.87, "timestamp": "01:09:06", "text": "你觉得你要去哪里？"}, {"type": "subtitle", "time": 4170.39, "timestamp": "01:09:30", "text": "他被所有人揍了一顿。我喜欢它。"}, {"type": "subtitle", "time": 4173.269, "timestamp": "01:09:33", "text": "拥抱光明吧。"}, {"type": "subtitle", "time": 4181.349, "timestamp": "01:09:41", "text": "只剩60秒了。"}, {"type": "subtitle", "time": 4183.309, "timestamp": "01:09:43", "text": "这应该"}, {"type": "subtitle", "time": 4184.13, "timestamp": "01:09:44", "text": "[音乐]"}, {"type": "subtitle", "time": 4185.709, "timestamp": "01:09:45", "text": "[掌声]"}, {"type": "subtitle", "time": 4190.47, "timestamp": "01:09:50", "text": "已经有一个了。就差一点。"}, {"type": "subtitle", "time": 4192.269, "timestamp": "01:09:52", "text": "哦，你好。"}, {"type": "subtitle", "time": 4195.43, "timestamp": "01:09:55", "text": "处决马古里。他在哪儿？哦，什么？"}, {"type": "subtitle", "time": 4197.51, "timestamp": "01:09:57", "text": "这"}, {"type": "subtitle", "time": 4199.99, "timestamp": "01:09:59", "text": "哇，这个面包师傅手艺真好。他"}]
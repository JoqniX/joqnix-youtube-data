[{"type": "subtitle", "time": 6906.149, "timestamp": "01:55:06", "text": "美国队长还活着。快点。"}, {"type": "subtitle", "time": 6911.91, "timestamp": "01:55:11", "text": "往后退。往后退。刚回来"}, {"type": "subtitle", "time": 6925.03, "timestamp": "01:55:25", "text": "我们走吧。"}, {"type": "subtitle", "time": 6926.589, "timestamp": "01:55:26", "text": "我们可以推动"}, {"type": "subtitle", "time": 6935.27, "timestamp": "01:55:35", "text": "过来。过来。过来。来"}, {"type": "subtitle", "time": 6945.669, "timestamp": "01:55:45", "text": "该死。高跟鞋。他要朝我哪里开枪？"}, {"type": "subtitle", "time": 6950.39, "timestamp": "01:55:50", "text": "从？以阿伽莫托之眼。"}, {"type": "subtitle", "time": 6955.03, "timestamp": "01:55:55", "text": "妈妈。狗。我的狗。"}]
[{"type": "subtitle", "time": 18903.35, "timestamp": "05:15:03", "text": "一包布料。一包皮革制品。"}, {"type": "subtitle", "time": 18904.83, "timestamp": "05:15:04", "text": "包装"}, {"type": "subtitle", "time": 18907.75, "timestamp": "05:15:07", "text": "铁。哦，我们可以把它打包出售。"}, {"type": "subtitle", "time": 18911.59, "timestamp": "05:15:11", "text": "现在。大理石块。"}, {"type": "subtitle", "time": 18917.11, "timestamp": "05:15:17", "text": "哦啦啦啦啦啦啦啦啦啦啦啦啦"}, {"type": "subtitle", "time": 18917.2, "timestamp": "05:15:17", "text": "啦啦啦啦啦啦啦啦啦啦啦啦啦 啦啦啦探险"}, {"type": "subtitle", "time": 18919.638, "timestamp": "05:15:19", "text": "啦啦啦探险 揭开！哦，是一包橡胶。"}, {"type": "subtitle", "time": 18931.55, "timestamp": "05:15:31", "text": "有趣的。"}, {"type": "subtitle", "time": 18935.03, "timestamp": "05:15:35", "text": "好的。那真不错。菠萝"}]
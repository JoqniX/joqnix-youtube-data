[{"type": "subtitle", "time": 8520.469, "timestamp": "02:22:00", "text": "哦，对，他输了，我想他输了。"}, {"type": "subtitle", "time": 8523.07, "timestamp": "02:22:03", "text": "他的健康状况"}, {"type": "subtitle", "time": 8526.23, "timestamp": "02:22:06", "text": "一起。胜利。哦，这些准则"}, {"type": "subtitle", "time": 8528.309, "timestamp": "02:22:08", "text": "简直疯了。美国队长。快点。"}, {"type": "subtitle", "time": 8530.87, "timestamp": "02:22:10", "text": "加油，美国。快点。"}, {"type": "subtitle", "time": 8533.03, "timestamp": "02:22:13", "text": "美国，我很快就会来。制作"}, {"type": "subtitle", "time": 8541.67, "timestamp": "02:22:21", "text": "我这是在哪儿？我在哪里有"}, {"type": "subtitle", "time": 8544.09, "timestamp": "02:22:24", "text": "以青本的视角？"}, {"type": "subtitle", "time": 8545.349, "timestamp": "02:22:25", "text": "[音乐]"}, {"type": "subtitle", "time": 8557.59, "timestamp": "02:22:37", "text": "我的天啊，我的挣扎。这太疯狂了。"}, {"type": "subtitle", "time": 8560.469, "timestamp": "02:22:40", "text": "我希望如此。"}, {"type": "subtitle", "time": 8563.83, "timestamp": "02:22:43", "text": "坚果和蛋糕底。他们三个"}, {"type": "subtitle", "time": 8566.87, "timestamp": "02:22:46", "text": "三个该死的 你丢了什么？哦，我的天"}, {"type": "subtitle", "time": 8569.11, "timestamp": "02:22:49", "text": "上帝。别像WG那样。快点。这是"}, {"type": "subtitle", "time": 8571.429, "timestamp": "02:22:51", "text": "比利。比利，我的朋友。你不可能成为WG"}, {"type": "subtitle", "time": 8575.99, "timestamp": "02:22:55", "text": "这边。我的天哪。我赞成"}, {"type": "subtitle", "time": 8578.11, "timestamp": "02:22:58", "text": "透过……的眼睛"}]
[{"type": "subtitle", "time": 3487.829, "timestamp": "00:58:07", "text": "好吧，我没能痊愈。我猜"}, {"type": "subtitle", "time": 3490.95, "timestamp": "00:58:10", "text": "我不是说我得不到治愈。这是"}, {"type": "subtitle", "time": 3493.99, "timestamp": "00:58:13", "text": "真正的火力。"}, {"type": "subtitle", "time": 3501.27, "timestamp": "00:58:21", "text": "混乱来吧。这是盛大的"}, {"type": "subtitle", "time": 3521.75, "timestamp": "00:58:41", "text": "让他们再次死去。好了。"}, {"type": "subtitle", "time": 3524.47, "timestamp": "00:58:44", "text": "想帮助治疗师们，但真他妈的。"}, {"type": "subtitle", "time": 3535.95, "timestamp": "00:58:55", "text": "库，什么？ H. 那是"}, {"type": "subtitle", "time": 3538.47, "timestamp": "00:58:58", "text": "所以我们会赢一些，也会输一些。"}]
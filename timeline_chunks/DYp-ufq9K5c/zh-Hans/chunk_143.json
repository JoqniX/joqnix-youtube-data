[{"type": "subtitle", "time": 8601.03, "timestamp": "02:23:21", "text": "我喜欢和他玩。"}, {"type": "subtitle", "time": 8604.55, "timestamp": "02:23:24", "text": "他很有趣。是的，这种打法很适合我"}, {"type": "subtitle", "time": 8606.79, "timestamp": "02:23:26", "text": "性格非常鲜明。进去吧，操"}, {"type": "subtitle", "time": 8616.23, "timestamp": "02:23:36", "text": "偶尔把某人推到你"}, {"type": "subtitle", "time": 8620.71, "timestamp": "02:23:40", "text": "队友。你的力量就是我的力量。"}, {"type": "subtitle", "time": 8623.429, "timestamp": "02:23:43", "text": "我因此而更有力量"}, {"type": "subtitle", "time": 8632.23, "timestamp": "02:23:52", "text": "去你的。"}]
[{"type": "subtitle", "time": 8050.55, "timestamp": "02:14:10", "text": "那会绑架某人"}, {"type": "subtitle", "time": 8054.629, "timestamp": "02:14:14", "text": "就在这里。抱歉。"}, {"type": "subtitle", "time": 8056.55, "timestamp": "02:14:16", "text": "哦，这里是Kcoa。我以为这是"}, {"type": "subtitle", "time": 8060.55, "timestamp": "02:14:20", "text": "应该是……呃，它叫什么来着？"}, {"type": "subtitle", "time": 8063.51, "timestamp": "02:14:23", "text": "我们走吧。呃，它叫怪物"}, {"type": "subtitle", "time": 8065.99, "timestamp": "02:14:25", "text": "岛。不，它叫别的名字。"}, {"type": "subtitle", "time": 8067.51, "timestamp": "02:14:27", "text": "万磁王。"}, {"type": "subtitle", "time": 8069.79, "timestamp": "02:14:29", "text": "丛林世界。不。"}, {"type": "subtitle", "time": 8072.629, "timestamp": "02:14:32", "text": "呃，它叫什么来着。恐龙世界。"}, {"type": "subtitle", "time": 8075.44, "timestamp": "02:14:35", "text": "不。"}, {"type": "subtitle", "time": 8081.43, "timestamp": "02:14:41", "text": "两个油箱。"}, {"type": "subtitle", "time": 8083.91, "timestamp": "02:14:43", "text": "需要一点助力。是的，我要走了。"}, {"type": "subtitle", "time": 8087.189, "timestamp": "02:14:47", "text": "抓住她。看看这个。继续前进。"}, {"type": "subtitle", "time": 8089.51, "timestamp": "02:14:49", "text": "这样做。蛮荒之地。就是这样。"}, {"type": "subtitle", "time": 8094.95, "timestamp": "02:14:54", "text": "哦，蛮荒之地。是的。是的，就是这样。"}, {"type": "subtitle", "time": 8097.51, "timestamp": "02:14:57", "text": "它叫什么。"}, {"type": "subtitle", "time": 8099.669, "timestamp": "02:14:59", "text": "我记得有一集终极版"}]
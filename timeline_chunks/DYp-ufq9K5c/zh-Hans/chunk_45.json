[{"type": "subtitle", "time": 2706.71, "timestamp": "00:45:06", "text": "什么？钢铁侠。"}, {"type": "subtitle", "time": 2709.109, "timestamp": "00:45:09", "text": "最大限度。"}, {"type": "subtitle", "time": 2712.069, "timestamp": "00:45:12", "text": "真是个混蛋。又把我弄死了。"}, {"type": "subtitle", "time": 2731.19, "timestamp": "00:45:31", "text": "你好。乐意出一份力。"}, {"type": "subtitle", "time": 2733.75, "timestamp": "00:45:33", "text": "嘿，团队，艾玛，另。艾玛，另类。艾玛，"}, {"type": "subtitle", "time": 2736.23, "timestamp": "00:45:36", "text": "替代。艾玛，艾玛，艾玛，另。哦，绝不"}, {"type": "subtitle", "time": 2737.75, "timestamp": "00:45:37", "text": "头脑。我们赢了。哦，我们从来没有"}, {"type": "subtitle", "time": 2748.309, "timestamp": "00:45:48", "text": "那就来吧。没有打到他。我哥哥"}, {"type": "subtitle", "time": 2755.829, "timestamp": "00:45:55", "text": "控制。呃，没打他。拜托，老兄。"}, {"type": "subtitle", "time": 2757.27, "timestamp": "00:45:57", "text": "这些东西会被弹开。好的，他们有"}]
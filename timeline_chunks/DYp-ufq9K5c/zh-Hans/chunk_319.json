[{"type": "subtitle", "time": 19142.07, "timestamp": "05:19:02", "text": "爆炸了。好的。啊，所以你是在告诉我"}, {"type": "subtitle", "time": 19144.47, "timestamp": "05:19:04", "text": "我应该"}, {"type": "subtitle", "time": 19146.948, "timestamp": "05:19:06", "text": "呃，快速准备，然后继续"}, {"type": "subtitle", "time": 19150.868, "timestamp": "05:19:10", "text": "探索一番，稍后再回来。"}, {"type": "subtitle", "time": 19157.27, "timestamp": "05:19:17", "text": "明白了。比如重要的事情。如果你"}, {"type": "subtitle", "time": 19161.07, "timestamp": "05:19:21", "text": "如果需要更多资源，我可以去"}, {"type": "subtitle", "time": 19164.628, "timestamp": "05:19:24", "text": "呃，边探索边做。"}, {"type": "subtitle", "time": 19170.47, "timestamp": "05:19:30", "text": "明白了。是的。"}, {"type": "subtitle", "time": 19194.59, "timestamp": "05:19:54", "text": "树。某些武器不耐久，无法切割。"}, {"type": "subtitle", "time": 19196.67, "timestamp": "05:19:56", "text": "哇。或者"}]
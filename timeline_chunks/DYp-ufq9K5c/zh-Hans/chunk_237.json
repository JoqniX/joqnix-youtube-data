[{"type": "subtitle", "time": 14245.269, "timestamp": "03:57:25", "text": "好的。你会添加的。你需要一个来源"}, {"type": "subtitle", "time": 14249.59, "timestamp": "03:57:29", "text": "轻点到哦，是的。我怎么忘了问"}, {"type": "subtitle", "time": 14251.389, "timestamp": "03:57:31", "text": "我该怎么做？"}, {"type": "subtitle", "time": 14254.269, "timestamp": "03:57:34", "text": "我该如何制作"}, {"type": "subtitle", "time": 14257.189, "timestamp": "03:57:37", "text": "灯塔船？我过着游牧般的生活。"}, {"type": "subtitle", "time": 14258.91, "timestamp": "03:57:38", "text": "我在船上的生活就是我的"}, {"type": "subtitle", "time": 14264.349, "timestamp": "03:57:44", "text": "根据。哦，你可以过游牧生活。"}]
[{"type": "subtitle", "time": 5521.189, "timestamp": "01:32:01", "text": "随着时间的推移。快点。快点。快点。"}, {"type": "subtitle", "time": 5525.03, "timestamp": "01:32:05", "text": "别弄丢了。我的天啊，兄弟，我以为"}, {"type": "subtitle", "time": 5527.35, "timestamp": "01:32:07", "text": "M要去一个奇怪的TP，但是"}, {"type": "subtitle", "time": 5529.27, "timestamp": "01:32:09", "text": "有时候我会忘记我的队友都是狗"}, {"type": "subtitle", "time": 5530.79, "timestamp": "01:32:10", "text": "拉屎。"}, {"type": "subtitle", "time": 5533.59, "timestamp": "01:32:13", "text": "是时候做出改变了，包括"}, {"type": "subtitle", "time": 5541.189, "timestamp": "01:32:21", "text": "冬天。哦，蜘蛛侠。我们可以养条狗吗？"}, {"type": "subtitle", "time": 5550.87, "timestamp": "01:32:30", "text": "拜托，老兄。快点。快点。"}, {"type": "subtitle", "time": 5554.79, "timestamp": "01:32:34", "text": "拜托，老兄。我们需要一些东西。"}, {"type": "subtitle", "time": 5557.51, "timestamp": "01:32:37", "text": "快点。快点。看看我那傻朋友"}, {"type": "subtitle", "time": 5564.229, "timestamp": "01:32:44", "text": "我觉得蜘蛛侠不会出演"}, {"type": "subtitle", "time": 5568.87, "timestamp": "01:32:48", "text": "非常优秀。第二轮。去。我们"}, {"type": "subtitle", "time": 5572.07, "timestamp": "01:32:52", "text": "应该给予这些人。"}, {"type": "subtitle", "time": 5574.629, "timestamp": "01:32:54", "text": "还有我们唯一的坦克，它有四岁了。"}, {"type": "subtitle", "time": 5576.79, "timestamp": "01:32:56", "text": "现在有五个。"}, {"type": "subtitle", "time": 5579.83, "timestamp": "01:32:59", "text": "不，不，我想应该是“我是Sigma”。我当时是吗？"}]
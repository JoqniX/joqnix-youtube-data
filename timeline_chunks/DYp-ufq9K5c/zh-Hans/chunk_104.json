[{"type": "subtitle", "time": 6240.189, "timestamp": "01:44:00", "text": "即将到达。该死。该死。"}, {"type": "subtitle", "time": 6244.79, "timestamp": "01:44:04", "text": "该死。试图射击信标。"}, {"type": "subtitle", "time": 6251.91, "timestamp": "01:44:11", "text": "该死的丹尼尔。"}, {"type": "subtitle", "time": 6253.99, "timestamp": "01:44:13", "text": "好了。哦，请回到这里。操"}, {"type": "subtitle", "time": 6262.75, "timestamp": "01:44:22", "text": "这些家伙真是胆大包天。"}, {"type": "subtitle", "time": 6269.669, "timestamp": "01:44:29", "text": "惠普。哦，月亮。"}, {"type": "subtitle", "time": 6273.99, "timestamp": "01:44:33", "text": "月亮萦绕着你。"}, {"type": "subtitle", "time": 6277.59, "timestamp": "01:44:37", "text": "他们一见到我就都走了。"}, {"type": "subtitle", "time": 6288.27, "timestamp": "01:44:48", "text": "我准备好了，哦，我本来打算，哦，"}, {"type": "subtitle", "time": 6292.47, "timestamp": "01:44:52", "text": "射击。那可不好。"}, {"type": "subtitle", "time": 6295.51, "timestamp": "01:44:55", "text": "他要打我。哦，糟糕。他得到了"}, {"type": "subtitle", "time": 6297.95, "timestamp": "01:44:57", "text": "三个人，哟。"}]
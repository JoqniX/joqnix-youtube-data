[{"type": "subtitle", "time": 9122.309, "timestamp": "02:32:02", "text": "等等，什么？"}, {"type": "subtitle", "time": 9140.79, "timestamp": "02:32:20", "text": "好的。我进度落后了。看哪，神！"}, {"type": "subtitle", "time": 9143.59, "timestamp": "02:32:23", "text": "雷声。"}, {"type": "subtitle", "time": 9158.71, "timestamp": "02:32:38", "text": "这简直是​​毫无理由的大规模破坏。"}, {"type": "subtitle", "time": 9163.27, "timestamp": "02:32:43", "text": "精神崩溃。我的生命之源暴露了。"}, {"type": "subtitle", "time": 9165.91, "timestamp": "02:32:45", "text": "我会帮你包扎好。跟踪敌人。"}]
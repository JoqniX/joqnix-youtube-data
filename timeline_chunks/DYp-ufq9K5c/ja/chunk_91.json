[{"type": "subtitle", "time": 5463.59, "timestamp": "01:31:03", "text": "よし、これから別のバージョンに切り替えるよ"}, {"type": "subtitle", "time": 5468.39, "timestamp": "01:31:08", "text": "バッキーに切り替えることにします。来て。"}, {"type": "subtitle", "time": 5472.47, "timestamp": "01:31:12", "text": "しまった。さて、本題に入りましょう。"}, {"type": "subtitle", "time": 5474.149, "timestamp": "01:31:14", "text": "スパイダーマン、"}, {"type": "subtitle", "time": 5478.31, "timestamp": "01:31:18", "text": "彼はバックラインを圧倒していない。組み立てる。"}, {"type": "subtitle", "time": 5480.55, "timestamp": "01:31:20", "text": "君の力は私のものだ。誰も受け取らない"}, {"type": "subtitle", "time": 5491.75, "timestamp": "01:31:31", "text": "何てことだ。"}, {"type": "subtitle", "time": 5495.27, "timestamp": "01:31:35", "text": "ところで、私はシグマ型ですか？"}, {"type": "subtitle", "time": 5505.27, "timestamp": "01:31:45", "text": "俺はこのキャップが怖すぎるんだよ、兄弟。下がる"}, {"type": "subtitle", "time": 5507.35, "timestamp": "01:31:47", "text": "君のためにやってあ​​げるよ、相棒。掛けておきます、"}, {"type": "subtitle", "time": 5512.99, "timestamp": "01:31:52", "text": "彼の"}, {"type": "subtitle", "time": 5519.27, "timestamp": "01:31:59", "text": "ほぼ完璧なフックだ。時間とともに。"}]
[{"type": "subtitle", "time": 5940.229, "timestamp": "01:39:00", "text": "それすらも上手くこなせる。そしてバッキーは外した"}, {"type": "subtitle", "time": 5942.79, "timestamp": "01:39:02", "text": "まるで彼が同じものを2回も手に入れたかのように"}, {"type": "subtitle", "time": 5946.07, "timestamp": "01:39:06", "text": "彼は1ラウンドを回り、2回外した。聞いた？"}, {"type": "subtitle", "time": 5948.629, "timestamp": "01:39:08", "text": "彼がまた行くのか？"}, {"type": "subtitle", "time": 5951.149, "timestamp": "01:39:11", "text": "一度だけ。私"}, {"type": "subtitle", "time": 5954.39, "timestamp": "01:39:14", "text": "彼がもう一度そう言ったのが聞こえなかったか？私"}, {"type": "subtitle", "time": 5957.75, "timestamp": "01:39:17", "text": "「ああ、また一回だけ」という感じだった。 L."}, {"type": "subtitle", "time": 5959.51, "timestamp": "01:39:19", "text": "うん。試合で最高のショット。あなたも"}, {"type": "subtitle", "time": 5961.83, "timestamp": "01:39:21", "text": "一度だけやってみて、"}, {"type": "subtitle", "time": 5964.07, "timestamp": "01:39:24", "text": "兄弟。もし私が持っていた弾薬があれば"}, {"type": "subtitle", "time": 5967.39, "timestamp": "01:39:27", "text": "第1ラウンドは、勝てたはずだった。おお、"}, {"type": "subtitle", "time": 5974.51, "timestamp": "01:39:34", "text": "エマ"}, {"type": "subtitle", "time": 5978.149, "timestamp": "01:39:38", "text": "霜？むしろこう言うべきでしょう？私は誰ですか"}, {"type": "subtitle", "time": 5980.79, "timestamp": "01:39:40", "text": "一緒に遊びたい？"}, {"type": "subtitle", "time": 5983.27, "timestamp": "01:39:43", "text": "ブラックパンサーとは言いません。"}, {"type": "subtitle", "time": 5985.75, "timestamp": "01:39:45", "text": "ああ、なんてこった。絶対にそうすべきです"}, {"type": "subtitle", "time": 5986.91, "timestamp": "01:39:46", "text": "遊ぶ"}, {"type": "subtitle", "time": 5991.669, "timestamp": "01:39:51", "text": "えっと、あなたはデュエルスをプレイしていますよね？"}, {"type": "subtitle", "time": 5994.31, "timestamp": "01:39:54", "text": "そう願っています。あなたがすべき"}, {"type": "subtitle", "time": 5998.229, "timestamp": "01:39:58", "text": "絶対にウィンター・ソルジャーをプレイすべきだ。よお。よお。"}]
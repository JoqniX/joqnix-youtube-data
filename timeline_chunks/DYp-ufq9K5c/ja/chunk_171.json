[{"type": "subtitle", "time": 10260.87, "timestamp": "02:51:00", "text": "手がかり。"}, {"type": "subtitle", "time": 10262.79, "timestamp": "02:51:02", "text": "うん。ストリームのタイトルはすでに作成済みです"}, {"type": "subtitle", "time": 10266.23, "timestamp": "02:51:06", "text": "このゲームを今すぐプレイしよう。だから私は「うん」って感じだった。"}, {"type": "subtitle", "time": 10268.07, "timestamp": "02:51:08", "text": "うん。かっこいいですね。涼しい。その"}, {"type": "subtitle", "time": 10273.51, "timestamp": "02:51:13", "text": "いいね。それなら遊べますよ。うん。"}, {"type": "subtitle", "time": 10275.19, "timestamp": "02:51:15", "text": "ああ、画面を切り替えるだけで"}, {"type": "subtitle", "time": 10291.75, "timestamp": "02:51:31", "text": "そう、最後にクラッシュしたのは"}, {"type": "subtitle", "time": 10295.11, "timestamp": "02:51:35", "text": "私がチャットをしていたとき。私はこう言っていました、"}, {"type": "subtitle", "time": 10297.51, "timestamp": "02:51:37", "text": "ええ、アメリカでは私たちが勝ちました、そしてストリーム"}, {"type": "subtitle", "time": 10299.349, "timestamp": "02:51:39", "text": "墜落しました。わからない。"}, {"type": "subtitle", "time": 10301.75, "timestamp": "02:51:41", "text": "はい、携帯電話に接続して"}, {"type": "subtitle", "time": 10305.15, "timestamp": "02:51:45", "text": "確認したら、「ちょっと待って」って感じでした。"}, {"type": "subtitle", "time": 10308.71, "timestamp": "02:51:48", "text": "明らかに墜落した。「うわあ。」"}]
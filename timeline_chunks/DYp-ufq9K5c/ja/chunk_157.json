[{"type": "subtitle", "time": 9421.27, "timestamp": "02:37:01", "text": "そう、それはとてもクールだ"}, {"type": "subtitle", "time": 9423.03, "timestamp": "02:37:03", "text": "コンセプト"}, {"type": "subtitle", "time": 9425.11, "timestamp": "02:37:05", "text": "そう、そしてそれを理解している人は多くない"}, {"type": "subtitle", "time": 9427.429, "timestamp": "02:37:07", "text": "X-メンの世界は、非常に選ばれた"}, {"type": "subtitle", "time": 9431.11, "timestamp": "02:37:11", "text": "獣のような獣はほとんどいない"}, {"type": "subtitle", "time": 9433.03, "timestamp": "02:37:13", "text": "えーと、元々彼はただ"}, {"type": "subtitle", "time": 9435.27, "timestamp": "02:37:15", "text": "運動神経が良く、足は"}, {"type": "subtitle", "time": 9438.469, "timestamp": "02:37:18", "text": "ビッグフットのような手。うん。そして彼は"}, {"type": "subtitle", "time": 9441.27, "timestamp": "02:37:21", "text": "後に青い猫のような姿になる"}, {"type": "subtitle", "time": 9443.51, "timestamp": "02:37:23", "text": "の上。うん。"}, {"type": "subtitle", "time": 9447.51, "timestamp": "02:37:27", "text": "えっと、他に誰がいる？アイスマンのことだよね？アイスマン"}, {"type": "subtitle", "time": 9449.429, "timestamp": "02:37:29", "text": "いつもの"}, {"type": "subtitle", "time": 9452.07, "timestamp": "02:37:32", "text": "彼は通常、あなたと同じように"}, {"type": "subtitle", "time": 9454.71, "timestamp": "02:37:34", "text": "知ってるよ、氷のことをするけど、その後"}, {"type": "subtitle", "time": 9458.389, "timestamp": "02:37:38", "text": "彼は自らを氷に変えることができる。ああ、それは"}, {"type": "subtitle", "time": 9460.63, "timestamp": "02:37:40", "text": "彼の2度目。ええ、それは二次的なものです"}, {"type": "subtitle", "time": 9464.23, "timestamp": "02:37:44", "text": "もの。ウルヴァリンも持っていると思う"}, {"type": "subtitle", "time": 9466.23, "timestamp": "02:37:46", "text": "彼が死ぬコミックの一つで、"}, {"type": "subtitle", "time": 9467.389, "timestamp": "02:37:47", "text": "来る"}, {"type": "subtitle", "time": 9472.11, "timestamp": "02:37:52", "text": "戻る。えーっと、えーっと、私は、"}, {"type": "subtitle", "time": 9474.71, "timestamp": "02:37:54", "text": "ヒシウムは、ご存知のように、2番目に手に入れることができます"}, {"type": "subtitle", "time": 9478.11, "timestamp": "02:37:58", "text": "彼は以前よりも速く、より機敏になったようだ。彼"}]
[{"type": "subtitle", "time": 20060.11, "timestamp": "05:34:20", "text": "えっと、石"}, {"type": "subtitle", "time": 20070.628, "timestamp": "05:34:30", "text": "今。ええと、わかりました。私はただ続ける"}, {"type": "subtitle", "time": 20072.47, "timestamp": "05:34:32", "text": "ゲームチャットを見ている。はい、わかりました。"}, {"type": "subtitle", "time": 20075.27, "timestamp": "05:34:35", "text": "わかった。わかった。ちょっと"}, {"type": "subtitle", "time": 20081.99, "timestamp": "05:34:41", "text": "あなた。うん、君ならできると思うよ。私 私"}, {"type": "subtitle", "time": 20084.948, "timestamp": "05:34:44", "text": "ここにもっと物を入れてください。君ならできるよ。しかし"}, {"type": "subtitle", "time": 20087.11, "timestamp": "05:34:47", "text": "うん、シャベルの方がいいかもしれないね。方法"}, {"type": "subtitle", "time": 20093.11, "timestamp": "05:34:53", "text": "けれど？シャベルの方が良いかもしれない。いいえ、だって"}, {"type": "subtitle", "time": 20095.43, "timestamp": "05:34:55", "text": "私たちは掘っています。いいえ、私は欲しくありません。"}, {"type": "subtitle", "time": 20097.868, "timestamp": "05:34:57", "text": "選びたいし"}]
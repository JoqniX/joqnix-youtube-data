[{"type": "subtitle", "time": 18136.31, "timestamp": "05:02:16", "text": "[音楽]"}, {"type": "subtitle", "time": 18139.67, "timestamp": "05:02:19", "text": "ブラッドが2時間後に参加すると言った場合。"}, {"type": "subtitle", "time": 18143.15, "timestamp": "05:02:23", "text": "ええ、ブラッドかアチャンが参加すれば、"}, {"type": "subtitle", "time": 18145.47, "timestamp": "05:02:25", "text": "彼らが参加する、私は"}, {"type": "subtitle", "time": 18147.948, "timestamp": "05:02:27", "text": "推測。"}, {"type": "subtitle", "time": 18150.948, "timestamp": "05:02:30", "text": "ええ、私が試している間、彼らは私と一緒に参加できます"}, {"type": "subtitle", "time": 18152.83, "timestamp": "05:02:32", "text": "この世界を探検しよう。"}, {"type": "subtitle", "time": 18159.51, "timestamp": "05:02:39", "text": "えーと、スパイス。はい、戻ります。戻ってきました"}, {"type": "subtitle", "time": 18161.788, "timestamp": "05:02:41", "text": "へ"}, {"type": "subtitle", "time": 18165.11, "timestamp": "05:02:45", "text": "ゲーム。たくさんの植物があるようです"}, {"type": "subtitle", "time": 18166.99, "timestamp": "05:02:46", "text": "もっている"}, {"type": "subtitle", "time": 18170.628, "timestamp": "05:02:50", "text": "起こったと思う。あ、待って。どのぐらいの間"}, {"type": "subtitle", "time": 18172.03, "timestamp": "05:02:52", "text": "そうですか"}, {"type": "subtitle", "time": 18174.948, "timestamp": "05:02:54", "text": "取る？他の地図は、"}, {"type": "subtitle", "time": 18177.07, "timestamp": "05:02:57", "text": "スタート地点。"}]
[{"type": "subtitle", "time": 15061.15, "timestamp": "04:11:01", "text": "神。何てことだ。これは"}, {"type": "subtitle", "time": 15064.15, "timestamp": "04:11:04", "text": "ここに住むことができます。眠ることができます"}, {"type": "subtitle", "time": 15068.15, "timestamp": "04:11:08", "text": "ここ。あなたは多くのことができる。無料"}, {"type": "subtitle", "time": 15071.269, "timestamp": "04:11:11", "text": "作物。作物は育ち、あなたも作物を育てることができます"}, {"type": "subtitle", "time": 15073.07, "timestamp": "04:11:13", "text": "そして全て。あなたは"}, {"type": "subtitle", "time": 15083.83, "timestamp": "04:11:23", "text": "フェスティバルではスチームパンク関連のものを見かけます。なるほど"}, {"type": "subtitle", "time": 15088.15, "timestamp": "04:11:28", "text": "おお、かっこいい装備品がいくつか見えたぞ。 W それは"}, {"type": "subtitle", "time": 15090.469, "timestamp": "04:11:30", "text": "これは、これが全体を制御していると思います"}, {"type": "subtitle", "time": 15094.269, "timestamp": "04:11:34", "text": "この船のこと。おお。コントロール"}, {"type": "subtitle", "time": 15100.469, "timestamp": "04:11:40", "text": "これはダンスのようなものですか？これは"}, {"type": "subtitle", "time": 15107.51, "timestamp": "04:11:47", "text": "エリア？これには何かのサインがあった。おお、"}, {"type": "subtitle", "time": 15109.83, "timestamp": "04:11:49", "text": "もしかしたらソーラーパネルがあるのか​​もしれない。"}, {"type": "subtitle", "time": 15114.429, "timestamp": "04:11:54", "text": "そうかもしれないね。提灯が見える"}, {"type": "subtitle", "time": 15118.07, "timestamp": "04:11:58", "text": "ライト。くそ。なぜあなたはこれらすべてを作ったのですか"}, {"type": "subtitle", "time": 15119.309, "timestamp": "04:11:59", "text": "による"}]
[{"type": "subtitle", "time": 19620.868, "timestamp": "05:27:00", "text": "勢い。私は全体を掘り下げることができます"}, {"type": "subtitle", "time": 19622.948, "timestamp": "05:27:02", "text": "島は、私が望むなら、"}, {"type": "subtitle", "time": 19657.35, "timestamp": "05:27:37", "text": "火はそれほど長くは燃えません"}, {"type": "subtitle", "time": 19659.19, "timestamp": "05:27:39", "text": "中心部。あなたができることは、"}, {"type": "subtitle", "time": 19661.47, "timestamp": "05:27:41", "text": "壁の選択"}, {"type": "subtitle", "time": 19665.03, "timestamp": "05:27:45", "text": "そこは明るくて自由な場所だ。作って"}, {"type": "subtitle", "time": 19667.59, "timestamp": "05:27:47", "text": "いつもそうみたいですね。"}]
[{"type": "subtitle", "time": 15248.149, "timestamp": "04:14:08", "text": "待って、じゃあそのマストはどこにあるの？のように"}, {"type": "subtitle", "time": 15250.349, "timestamp": "04:14:10", "text": "風"}, {"type": "subtitle", "time": 15253.91, "timestamp": "04:14:13", "text": "あれ。どのように動くのか？ああ、それは走っているのか"}, {"type": "subtitle", "time": 15256.309, "timestamp": "04:14:16", "text": "発電機か何かで？いいえ。そうです。"}, {"type": "subtitle", "time": 15264.309, "timestamp": "04:14:24", "text": "右。私は奇抜な船を作るのが好きです。すべき"}, {"type": "subtitle", "time": 15266.309, "timestamp": "04:14:26", "text": "私の名前をクリックできるようになりました"}, {"type": "subtitle", "time": 15269.59, "timestamp": "04:14:29", "text": "あなたは私や他の船を見つけてくれた。待って。おお、"}, {"type": "subtitle", "time": 15273.63, "timestamp": "04:14:33", "text": "うん。うん。えっと、あなたの名前をクリックしてください。"}, {"type": "subtitle", "time": 15276.429, "timestamp": "04:14:36", "text": "名前。見てみましょう"}, {"type": "subtitle", "time": 15278.75, "timestamp": "04:14:38", "text": "ここ。ない"}, {"type": "subtitle", "time": 15284.59, "timestamp": "04:14:44", "text": "どうやって？"}, {"type": "subtitle", "time": 15292.99, "timestamp": "04:14:52", "text": "壁の塗装。絵を描くことができます"}, {"type": "subtitle", "time": 15298.67, "timestamp": "04:14:58", "text": "もの。船体へ向かってください。船体。"}]
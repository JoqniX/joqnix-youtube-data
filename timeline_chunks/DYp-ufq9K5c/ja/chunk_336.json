[{"type": "subtitle", "time": 20163.07, "timestamp": "05:36:03", "text": "あなたのために戻ってきました。待って、"}, {"type": "subtitle", "time": 20166.07, "timestamp": "05:36:06", "text": "本当に？待って、再起動して、"}, {"type": "subtitle", "time": 20168.628, "timestamp": "05:36:08", "text": "資源は戻ってくるだろう。しかし、"}, {"type": "subtitle", "time": 20171.708, "timestamp": "05:36:11", "text": "つまり、これらすべては"}, {"type": "subtitle", "time": 20188.948, "timestamp": "05:36:28", "text": "これ？ああ、そうなんですか？では、それは"}, {"type": "subtitle", "time": 20192.868, "timestamp": "05:36:32", "text": "後でやった方がいい"}, {"type": "subtitle", "time": 20194.91, "timestamp": "05:36:34", "text": "違う"}, {"type": "subtitle", "time": 20198.03, "timestamp": "05:36:38", "text": "このようなエリア"}, {"type": "subtitle", "time": 20201.39, "timestamp": "05:36:41", "text": "1つ目、そしてここに戻ってきます"}, {"type": "subtitle", "time": 20206.43, "timestamp": "05:36:46", "text": "そして、それを実行するのか？こっちの方がいいんじゃない？私は感じる"}]
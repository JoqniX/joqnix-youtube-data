[{"type": "subtitle", "time": 6906.149, "timestamp": "01:55:06", "text": "キャプテン・アメリカはまだ生きている。来て。"}, {"type": "subtitle", "time": 6911.91, "timestamp": "01:55:11", "text": "少し下がってください。少し下がってください。ちょうど戻ってきたところです"}, {"type": "subtitle", "time": 6925.03, "timestamp": "01:55:25", "text": "さあ行こう。"}, {"type": "subtitle", "time": 6926.589, "timestamp": "01:55:26", "text": "私たちは押し進めることができます"}, {"type": "subtitle", "time": 6935.27, "timestamp": "01:55:35", "text": "ここに来て。ここに来て。ここに来て。来る"}, {"type": "subtitle", "time": 6945.669, "timestamp": "01:55:45", "text": "ちくしょう。ハイヒール。彼はどこで私を撃っているのか"}, {"type": "subtitle", "time": 6950.39, "timestamp": "01:55:50", "text": "から？阿賀本氏の目を通して。"}, {"type": "subtitle", "time": 6955.03, "timestamp": "01:55:55", "text": "ママ。犬。私の犬。"}]
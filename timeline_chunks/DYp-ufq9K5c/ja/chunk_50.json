[{"type": "subtitle", "time": 3014.349, "timestamp": "00:50:14", "text": "半透明。それを作る"}, {"type": "subtitle", "time": 3018.03, "timestamp": "00:50:18", "text": "センス。それを作る"}, {"type": "subtitle", "time": 3019.829, "timestamp": "00:50:19", "text": "センス。彼らは恐らく"}, {"type": "subtitle", "time": 3022.309, "timestamp": "00:50:22", "text": "G. あいつを地図上から消し去ってやる。"}, {"type": "subtitle", "time": 3024.39, "timestamp": "00:50:24", "text": "地図から外れた場所へ行きたい。はい。"}, {"type": "chat", "time": 3031.835, "timestamp": "00:50:31", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "alright"}, {"type": "subtitle", "time": 3031.99, "timestamp": "00:50:31", "text": "私は自分の仕事において最高の人間だ。何"}, {"type": "chat", "time": 3035.867, "timestamp": "00:50:35", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "stay with me now"}, {"type": "chat", "time": 3039.253, "timestamp": "00:50:39", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "imma make it make sense"}, {"type": "subtitle", "time": 3041.349, "timestamp": "00:50:41", "text": "攻撃開始の30秒前。準備してください。"}, {"type": "subtitle", "time": 3044.39, "timestamp": "00:50:44", "text": "あと、他のX-メンって何だと思う？"}, {"type": "subtitle", "time": 3046.309, "timestamp": "00:50:46", "text": "男？覚えていない。知ってる？"}, {"type": "subtitle", "time": 3048.549, "timestamp": "00:50:48", "text": "彼の名前は何ですか？偽造犯か何か？私"}, {"type": "subtitle", "time": 3051.43, "timestamp": "00:50:51", "text": "覚えていない。彼も同様だった"}, {"type": "chat", "time": 3052.329, "timestamp": "00:50:52", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "solid color = more color "}, {"type": "subtitle", "time": 3052.95, "timestamp": "00:50:52", "text": "リークとか彼が"}, {"type": "subtitle", "time": 3055.589, "timestamp": "00:50:55", "text": "戦略家のように行動せよ。いや、そうは思わない"}, {"type": "subtitle", "time": 3058.069, "timestamp": "00:50:58", "text": "彼らの名前を覚えておこう。必ずやり遂げる"}]
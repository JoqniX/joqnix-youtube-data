[{"type": "subtitle", "time": 20101.27, "timestamp": "05:35:01", "text": "掘る。シンプルな家具。入手方法"}, {"type": "subtitle", "time": 20109.628, "timestamp": "05:35:09", "text": "大きな本棚。"}, {"type": "subtitle", "time": 20113.19, "timestamp": "05:35:13", "text": "海賊の鉄遺跡の保管庫。大きな引き出し。"}, {"type": "subtitle", "time": 20114.99, "timestamp": "05:35:14", "text": "木製"}, {"type": "subtitle", "time": 20125.47, "timestamp": "05:35:25", "text": "廃墟の武器。フリント"}, {"type": "subtitle", "time": 20128.548, "timestamp": "05:35:28", "text": "鎧。ああ、黒曜石の鎧は作れるよ。"}, {"type": "subtitle", "time": 20131.67, "timestamp": "05:35:31", "text": "あ、待って。革の入手方法は？"}, {"type": "subtitle", "time": 20134.23, "timestamp": "05:35:34", "text": "動物の皮が必要だ。ああ、それは"}, {"type": "subtitle", "time": 20136.39, "timestamp": "05:35:36", "text": "私たちにはないものだ。でも、私は思うんだけど"}, {"type": "subtitle", "time": 20138.868, "timestamp": "05:35:38", "text": "フレンダーの鎧の方が優れている。いいえ、フレンダー"}, {"type": "subtitle", "time": 20143.51, "timestamp": "05:35:43", "text": "今のところは木製の鎧セットです。"}, {"type": "subtitle", "time": 20145.67, "timestamp": "05:35:45", "text": "もっと見る"}, {"type": "subtitle", "time": 20146.83, "timestamp": "05:35:46", "text": "えーと"}, {"type": "subtitle", "time": 20151.23, "timestamp": "05:35:51", "text": "動物、熱帯動物、そして"}, {"type": "subtitle", "time": 20155.19, "timestamp": "05:35:55", "text": "もの。もし卵があったら、彼らはすでに"}, {"type": "subtitle", "time": 20157.35, "timestamp": "05:35:57", "text": "ステータスは？再起動することもできます"}, {"type": "subtitle", "time": 20159.868, "timestamp": "05:35:59", "text": "時間に関する統計。では、"}]
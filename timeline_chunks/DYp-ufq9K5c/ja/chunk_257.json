[{"type": "subtitle", "time": 15434.469, "timestamp": "04:17:14", "text": "おお。そうそう。白い滴。私は"}, {"type": "subtitle", "time": 15436.11, "timestamp": "04:17:16", "text": "探している"}, {"type": "subtitle", "time": 15439.51, "timestamp": "04:17:19", "text": "それらの。ああ、あなたは、あなたは、"}, {"type": "subtitle", "time": 15449.83, "timestamp": "04:17:29", "text": "ええと、床のすぐ下にあります。"}, {"type": "subtitle", "time": 15452.03, "timestamp": "04:17:32", "text": "それはかなり"}, {"type": "subtitle", "time": 15455.389, "timestamp": "04:17:35", "text": "古い。ああ、"}, {"type": "subtitle", "time": 15457.309, "timestamp": "04:17:37", "text": "神。"}, {"type": "subtitle", "time": 15461.99, "timestamp": "04:17:41", "text": "聖なる。何？これは何ですか？"}, {"type": "subtitle", "time": 15462.99, "timestamp": "04:17:42", "text": "は"}, {"type": "subtitle", "time": 15472.229, "timestamp": "04:17:52", "text": "これ？装飾システムはすべて実際には"}, {"type": "subtitle", "time": 15473.79, "timestamp": "04:17:53", "text": "しないで"}]
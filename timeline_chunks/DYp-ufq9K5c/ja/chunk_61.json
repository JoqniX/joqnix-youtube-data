[{"type": "subtitle", "time": 3660.99, "timestamp": "01:01:00", "text": "男？人々はそれについて泣いている"}, {"type": "subtitle", "time": 3663.75, "timestamp": "01:01:03", "text": "このゲームのフランカーは壊れてるよね"}, {"type": "subtitle", "time": 3666.95, "timestamp": "01:01:06", "text": "今。おい、チラシの話でもしようぜ。私たちはそうではないでしょうか？"}, {"type": "subtitle", "time": 3668.309, "timestamp": "01:01:08", "text": "壊れたチラシについて話すつもりです"}, {"type": "subtitle", "time": 3671.51, "timestamp": "01:01:11", "text": "今まさにですか？ストーム、アイアンマン、そして"}, {"type": "subtitle", "time": 3686.39, "timestamp": "01:01:26", "text": "この試合に勝つには、一流のチームが必要だ"}, {"type": "subtitle", "time": 3690.67, "timestamp": "01:01:30", "text": "1つ。少し下へ行きます、"}, {"type": "subtitle", "time": 3696.03, "timestamp": "01:01:36", "text": "知る。そして私のチームが禁止したから"}, {"type": "subtitle", "time": 3698.71, "timestamp": "01:01:38", "text": "人間。ああ、人間を選んでおけばよかった"}, {"type": "subtitle", "time": 3700.789, "timestamp": "01:01:40", "text": "だから彼らは彼を追放しなかった。私はかなり良いです"}, {"type": "subtitle", "time": 3719.67, "timestamp": "01:01:59", "text": "そうそう。ローグ・ロキもできるよ。ああ、そうだね。"}]
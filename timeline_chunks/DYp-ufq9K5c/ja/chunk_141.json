[{"type": "subtitle", "time": 8477.429, "timestamp": "02:21:17", "text": "なぜ彼は何なんだこれはこの代替スパム"}, {"type": "subtitle", "time": 8480.95, "timestamp": "02:21:20", "text": "何が起こっているの？何"}, {"type": "subtitle", "time": 8491.19, "timestamp": "02:21:31", "text": "チャット、これは何？チャット。"}, {"type": "subtitle", "time": 8497.91, "timestamp": "02:21:37", "text": "私は治癒できる。"}, {"type": "subtitle", "time": 8499.59, "timestamp": "02:21:39", "text": "さあ、行こう。"}, {"type": "subtitle", "time": 8508.309, "timestamp": "02:21:48", "text": "あなたは間違った側に立っています。"}, {"type": "subtitle", "time": 8509.67, "timestamp": "02:21:49", "text": "うん。うん。トーをつかんでください。手に入れる"}, {"type": "subtitle", "time": 8511.19, "timestamp": "02:21:51", "text": "トーチ。"}, {"type": "subtitle", "time": 8513.79, "timestamp": "02:21:53", "text": "ライブ配信コンテンツとインタラクション"}, {"type": "subtitle", "time": 8518.469, "timestamp": "02:21:58", "text": "生放送で。彼は"}]
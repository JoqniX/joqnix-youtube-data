[{"type": "subtitle", "time": 4800.39, "timestamp": "01:20:00", "text": "何てことだ。マグニートー。"}, {"type": "subtitle", "time": 4813.189, "timestamp": "01:20:13", "text": "出て行け。最終スコア。それは"}, {"type": "subtitle", "time": 4814.95, "timestamp": "01:20:14", "text": "いい感じだよね、みんな？私はそうは思わない"}, {"type": "subtitle", "time": 4817.51, "timestamp": "01:20:17", "text": "MVPは保留だけど、かなり良い出来だったと思う。"}, {"type": "subtitle", "time": 4818.59, "timestamp": "01:20:18", "text": "そうですね"}, {"type": "subtitle", "time": 4822.55, "timestamp": "01:20:22", "text": "それ。サービスの上限に達しました。 07 07"}, {"type": "subtitle", "time": 4841.39, "timestamp": "01:20:41", "text": "クソのために"}, {"type": "subtitle", "time": 4846.95, "timestamp": "01:20:46", "text": "地獄。ああ、本当にイライラする。"}, {"type": "subtitle", "time": 4849.75, "timestamp": "01:20:49", "text": "彼を捕まえることはできない。戦車のように"}, {"type": "subtitle", "time": 4851.35, "timestamp": "01:20:51", "text": "プレイヤー、あいつが一番うざい"}, {"type": "subtitle", "time": 4853.59, "timestamp": "01:20:53", "text": "今までで一番すごいこと。そうだよ、まさにその通り。それ"}, {"type": "subtitle", "time": 4855.43, "timestamp": "01:20:55", "text": "一番イライラすること。彼は燃えている"}, {"type": "subtitle", "time": 4857.11, "timestamp": "01:20:57", "text": "突然、「なぜ」"}, {"type": "subtitle", "time": 4858.87, "timestamp": "01:20:58", "text": "私はダメージを受けていますか？誰も前にいない"}]
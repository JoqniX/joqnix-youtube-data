[{"type": "subtitle", "time": 10098.79, "timestamp": "02:48:18", "text": "待って、ライブ配信が途切れた"}, {"type": "subtitle", "time": 10100.469, "timestamp": "02:48:20", "text": "真ん中に。私が言ったことを覚えていますか？"}, {"type": "subtitle", "time": 10102.95, "timestamp": "02:48:22", "text": "のように"}, {"type": "subtitle", "time": 10105.99, "timestamp": "02:48:25", "text": "いや、いや、いや。えっと、ビリー、ビリー、どうして"}, {"type": "subtitle", "time": 10112.79, "timestamp": "02:48:32", "text": "はぁ？"}, {"type": "subtitle", "time": 10114.75, "timestamp": "02:48:34", "text": "いいえ、まだ配信中です"}]
[{"type": "subtitle", "time": 15132.99, "timestamp": "04:12:12", "text": "トップ。ここに座って"}, {"type": "subtitle", "time": 15136.229, "timestamp": "04:12:16", "text": "リラックスして、そこで海を見て、"}, {"type": "subtitle", "time": 15139.429, "timestamp": "04:12:19", "text": "そして日光浴をしましょう、あなたは"}, {"type": "subtitle", "time": 15141.269, "timestamp": "04:12:21", "text": "今は海だ。あなたは自分の"}, {"type": "subtitle", "time": 15145.189, "timestamp": "04:12:25", "text": "木がたくさんあるから、今は日差しが強い。"}, {"type": "subtitle", "time": 15147.269, "timestamp": "04:12:27", "text": "あなたは常に日陰にいる。"}, {"type": "subtitle", "time": 15149.59, "timestamp": "04:12:29", "text": "でも、日光を浴びることは必要だよ。"}, {"type": "subtitle", "time": 15152.67, "timestamp": "04:12:32", "text": "日光浴をしよう"}, {"type": "subtitle", "time": 15155.75, "timestamp": "04:12:35", "text": "もの。想像してみてください、それは"}, {"type": "subtitle", "time": 15159.11, "timestamp": "04:12:39", "text": "日光浴用の物を置くことは可能"}, {"type": "subtitle", "time": 15161.91, "timestamp": "04:12:41", "text": "えっと、一つあると思うんだけど"}, {"type": "subtitle", "time": 15164.55, "timestamp": "04:12:44", "text": "私が滞在していた島でそれを見たと思う"}, {"type": "subtitle", "time": 15168.87, "timestamp": "04:12:48", "text": "普通の椅子ではなく、普通の椅子"}, {"type": "subtitle", "time": 15176.51, "timestamp": "04:12:56", "text": "何か、ああ、戦いがある"}, {"type": "subtitle", "time": 15179.269, "timestamp": "04:12:59", "text": "まあ、船の情報は以上です"}]
[{"type": "subtitle", "time": 6063.83, "timestamp": "01:41:03", "text": "ちくしょう。まったく同じクソ野郎スパイディ。"}, {"type": "subtitle", "time": 6066.03, "timestamp": "01:41:06", "text": "やるべきだろうか？"}, {"type": "subtitle", "time": 6070.229, "timestamp": "01:41:10", "text": "えっと、そうするべきでしょうか？"}, {"type": "subtitle", "time": 6073.31, "timestamp": "01:41:13", "text": "私は推測する。つまり、"}, {"type": "subtitle", "time": 6077.83, "timestamp": "01:41:17", "text": "私は自分のELOを失いたくないんです。"}, {"type": "subtitle", "time": 6079.47, "timestamp": "01:41:19", "text": "もし同じだったら"}, {"type": "subtitle", "time": 6082.87, "timestamp": "01:41:22", "text": "また。また？"}, {"type": "subtitle", "time": 6084.95, "timestamp": "01:41:24", "text": "そうだといい。それは"}, {"type": "subtitle", "time": 6087.109, "timestamp": "01:41:27", "text": "同じことだ。それとも彼らは"}, {"type": "subtitle", "time": 6089.59, "timestamp": "01:41:29", "text": "またスパイダーマン？彼らはスパイダーマンだ。わかった、"}, {"type": "subtitle", "time": 6092.149, "timestamp": "01:41:32", "text": "よし、これでいい。"}, {"type": "subtitle", "time": 6093.83, "timestamp": "01:41:33", "text": "また。"}, {"type": "subtitle", "time": 6097.27, "timestamp": "01:41:37", "text": "このFPSの右側。できれば"}, {"type": "subtitle", "time": 6100.07, "timestamp": "01:41:40", "text": "またいくつか。"}, {"type": "subtitle", "time": 6102.709, "timestamp": "01:41:42", "text": "大丈夫、君ならできるよ。"}, {"type": "subtitle", "time": 6105.59, "timestamp": "01:41:45", "text": "そう願ってるよ、相棒。そうだといい。正直に、"}, {"type": "subtitle", "time": 6106.95, "timestamp": "01:41:46", "text": "FPSが向上しています"}, {"type": "subtitle", "time": 6108.709, "timestamp": "01:41:48", "text": "プレイステーションだよ、相棒。やり方がわからない。おお、"}, {"type": "subtitle", "time": 6113.31, "timestamp": "01:41:53", "text": "うん。もちろん、プレイステーションです。"}, {"type": "subtitle", "time": 6116.27, "timestamp": "01:41:56", "text": "何？同じゲームだ。ストリーミングはこちら"}, {"type": "subtitle", "time": 6119.189, "timestamp": "01:41:59", "text": "ゲーム。このゲームを配信している人たちは"}]
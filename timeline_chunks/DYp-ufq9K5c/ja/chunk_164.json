[{"type": "subtitle", "time": 9843.19, "timestamp": "02:44:03", "text": "待て、ハラシュがここにいたぞ。くそっ"}, {"type": "subtitle", "time": 9845.19, "timestamp": "02:44:05", "text": "うん。ああ、彼は今出て行ったよ。彼はちょうど去った"}, {"type": "subtitle", "time": 9854.87, "timestamp": "02:44:14", "text": "見逃してしまいました。彼はただただすごい。"}, {"type": "subtitle", "time": 9856.429, "timestamp": "02:44:16", "text": "私もそう思います。私"}, {"type": "subtitle", "time": 9859.269, "timestamp": "02:44:19", "text": "する。えっと、"}, {"type": "subtitle", "time": 9860.79, "timestamp": "02:44:20", "text": "私はこのゲームをクリアしたいだけです"}, {"type": "subtitle", "time": 9865.349, "timestamp": "02:44:25", "text": "遊べるよ。いやあ、ずいぶん時間がかかったね。"}, {"type": "subtitle", "time": 9867.99, "timestamp": "02:44:27", "text": "私は好きにならなければならなかった"}, {"type": "subtitle", "time": 9872.15, "timestamp": "02:44:32", "text": "えっと、家事をたくさんやってください。"}, {"type": "subtitle", "time": 9874.469, "timestamp": "02:44:34", "text": "洗濯、皿洗い。ああ神様、"}, {"type": "subtitle", "time": 9878.51, "timestamp": "02:44:38", "text": "それはfでした。終わりました。どうやって勝ったのですか？"}, {"type": "subtitle", "time": 9881.59, "timestamp": "02:44:41", "text": "大丈夫。私は2勝1勝2敗です"}, {"type": "subtitle", "time": 9883.51, "timestamp": "02:44:43", "text": "連勝。これは3試合目で、"}, {"type": "subtitle", "time": 9886.55, "timestamp": "02:44:46", "text": "この後、これは3番目です"}, {"type": "subtitle", "time": 9888.71, "timestamp": "02:44:48", "text": "ゲーム。君はもう7回プレイしたと思っていたよ"}, {"type": "subtitle", "time": 9890.95, "timestamp": "02:44:50", "text": "ゲーム。いや、いや、いや、いや、いや。私は"}, {"type": "subtitle", "time": 9892.309, "timestamp": "02:44:52", "text": "3連勝。それが私の"}, {"type": "subtitle", "time": 9894.07, "timestamp": "02:44:54", "text": "と言っている。私は8ゲームほどプレイしました"}, {"type": "subtitle", "time": 9896.55, "timestamp": "02:44:56", "text": "今。"}, {"type": "subtitle", "time": 9898.55, "timestamp": "02:44:58", "text": "何てことだ。また、どれくらいの時間"}]
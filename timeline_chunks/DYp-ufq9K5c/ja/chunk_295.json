[{"type": "subtitle", "time": 17700.868, "timestamp": "04:55:00", "text": "1つ。既存の同じゲームを開始できます"}, {"type": "subtitle", "time": 17703.67, "timestamp": "04:55:03", "text": "つまり、あなたが発見したもの以外もすべて"}, {"type": "subtitle", "time": 17706.31, "timestamp": "04:55:06", "text": "例外として、"}, {"type": "subtitle", "time": 17709.63, "timestamp": "04:55:09", "text": "ゲームを共有する。個人的には、まあまあといったところです。"}, {"type": "subtitle", "time": 17717.51, "timestamp": "04:55:17", "text": "ゲームは自分で始めることができます"}, {"type": "subtitle", "time": 17720.67, "timestamp": "04:55:20", "text": "時間も誰もいなくても。"}, {"type": "subtitle", "time": 17725.67, "timestamp": "04:55:25", "text": "わかった。えっと、無料ティアとファイブスリーファイト"}, {"type": "subtitle", "time": 17727.23, "timestamp": "04:55:27", "text": "三つ。わかった。"}, {"type": "subtitle", "time": 17734.39, "timestamp": "04:55:34", "text": "無料。私がお金を使った唯一の機会は"}, {"type": "subtitle", "time": 17735.99, "timestamp": "04:55:35", "text": "ゲームはベータ版の段階で実行され、"}, {"type": "subtitle", "time": 17756.15, "timestamp": "04:55:56", "text": "Oが他の接続を切断した場合、何が起こるか"}, {"type": "subtitle", "time": 17758.47, "timestamp": "04:55:58", "text": "プレイを続ける？どのくらいの頻度で"}]
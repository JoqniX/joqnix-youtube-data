[{"type": "subtitle", "time": 10681.03, "timestamp": "02:58:01", "text": "また？そうそう。パスワードは何でしたか？"}, {"type": "subtitle", "time": 10684.309, "timestamp": "02:58:04", "text": "誰か、えっと、私たちが何て言ったか知ってる？"}, {"type": "subtitle", "time": 10692.309, "timestamp": "02:58:12", "text": "あ、待って。私がオーナーです。そうそう。私"}, {"type": "subtitle", "time": 10739.11, "timestamp": "02:58:59", "text": "ああ、そういえばこれをインストールしなきゃいけなかったのを忘れてた"}]
[{"type": "subtitle", "time": 13440.63, "timestamp": "03:44:00", "text": "そして弾薬ベルト。わかった。それは私が"}, {"type": "subtitle", "time": 13443.81, "timestamp": "03:44:03", "text": "これまでのところ、調査は完了しました。"}, {"type": "subtitle", "time": 13451.429, "timestamp": "03:44:11", "text": "このゲームは本当に上級者向けですね。"}, {"type": "subtitle", "time": 13452.83, "timestamp": "03:44:12", "text": "とても"}, {"type": "subtitle", "time": 13455.389, "timestamp": "03:44:15", "text": "多くの。"}, {"type": "subtitle", "time": 13467.07, "timestamp": "03:44:27", "text": "[音楽]"}, {"type": "subtitle", "time": 13474.87, "timestamp": "03:44:34", "text": "アーチェリーの製作。これを手に入れたい"}, {"type": "subtitle", "time": 13478.75, "timestamp": "03:44:38", "text": "砲兵関連のものですが、青銅と"}, {"type": "subtitle", "time": 13481.269, "timestamp": "03:44:41", "text": "いろいろあったけど、私が持っていた時から覚えているのは"}, {"type": "subtitle", "time": 13483.67, "timestamp": "03:44:43", "text": "ベータ版の頃からゲームは大きく変化しました。おお、"}, {"type": "subtitle", "time": 13487.07, "timestamp": "03:44:47", "text": "ベータ版からプレイしているのですか？おお、"}, {"type": "subtitle", "time": 13495.99, "timestamp": "03:44:55", "text": "くそ。ああ、薬を作って"}, {"type": "subtitle", "time": 13498.03, "timestamp": "03:44:58", "text": "もの。"}]
[{"type": "subtitle", "time": 12670.91, "timestamp": "03:31:10", "text": "ガラス。ガラスは"}, {"type": "subtitle", "time": 12680.309, "timestamp": "03:31:20", "text": "砂。砂岩。ケレンを使って岩石を"}, {"type": "subtitle", "time": 12694.07, "timestamp": "03:31:34", "text": "働くことは役に立つだろう。"}, {"type": "subtitle", "time": 12695.53, "timestamp": "03:31:35", "text": "ネイティブ"}, {"type": "subtitle", "time": 12712.75, "timestamp": "03:31:52", "text": "[音楽]"}]
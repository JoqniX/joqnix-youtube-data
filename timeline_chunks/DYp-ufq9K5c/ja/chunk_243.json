[{"type": "subtitle", "time": 14583.59, "timestamp": "04:03:03", "text": "パック。おい、何だって？すみません。え、何？"}, {"type": "subtitle", "time": 14586.269, "timestamp": "04:03:06", "text": "10,000ルピー？"}, {"type": "subtitle", "time": 14589.63, "timestamp": "04:03:09", "text": "はぁ？元。すみません。"}, {"type": "subtitle", "time": 14592.389, "timestamp": "04:03:12", "text": "はぁ？待って。実際の金額を知りたいです。"}, {"type": "subtitle", "time": 14595.11, "timestamp": "04:03:15", "text": "待って。とんでもない。 10です。あ、155です。"}, {"type": "subtitle", "time": 14601.15, "timestamp": "04:03:21", "text": "兄弟？"}, {"type": "chat", "time": 14602.063, "timestamp": "04:03:22", "author": "@Shiori_mitsuki", "avatar": "https://yt4.ggpht.com/Dn0VbakjSKrSNaXx6PyhznuqbomoCGx22ivSawRcMXp25Io7cfsud3H3qP-g9QprPJUESlxxtJA=s64-c-k-c0x00ffffff-no-rj", "message": "lmao the reaction "}, {"type": "subtitle", "time": 14603.95, "timestamp": "04:03:23", "text": "わかった。"}, {"type": "subtitle", "time": 14606.71, "timestamp": "04:03:26", "text": "エディタ。冒険を創造し、共有する"}, {"type": "subtitle", "time": 14615.07, "timestamp": "04:03:35", "text": "わかった。エディター、アドバンスゲーム"}, {"type": "chat", "time": 14615.151, "timestamp": "04:03:35", "author": "@Shiori_mitsuki", "avatar": "https://yt4.ggpht.com/Dn0VbakjSKrSNaXx6PyhznuqbomoCGx22ivSawRcMXp25Io7cfsud3H3qP-g9QprPJUESlxxtJA=s64-c-k-c0x00ffffff-no-rj", "message": "i was working in bg i laughed so loud "}, {"type": "subtitle", "time": 14618.63, "timestamp": "04:03:38", "text": "遊ぶ。ああ、ゲームやミニゲームを作ることができます"}, {"type": "subtitle", "time": 14620.349, "timestamp": "04:03:40", "text": "そして"}, {"type": "subtitle", "time": 14624.429, "timestamp": "04:03:44", "text": "もの。おお。空っぽの壁、水"}, {"type": "subtitle", "time": 14627.38, "timestamp": "04:03:47", "text": "壁。なぜこんなに楽しいのだろう？"}, {"type": "subtitle", "time": 14632.91, "timestamp": "04:03:52", "text": "[音楽]"}, {"type": "subtitle", "time": 14635.389, "timestamp": "04:03:55", "text": "ああ、なんてことだ"}]
[{"type": "subtitle", "time": 15901.95, "timestamp": "04:25:01", "text": "見て、猫がいるよ"}, {"type": "subtitle", "time": 15904.79, "timestamp": "04:25:04", "text": "像。これって私たちが見た猫の像じゃない？"}, {"type": "subtitle", "time": 15911.67, "timestamp": "04:25:11", "text": "おお。何てことだ。ほら、また像だ。それで"}, {"type": "subtitle", "time": 15913.229, "timestamp": "04:25:13", "text": "多くの"}, {"type": "subtitle", "time": 15916.03, "timestamp": "04:25:16", "text": "引き出し。ああ、"}, {"type": "subtitle", "time": 15919.269, "timestamp": "04:25:19", "text": "神。金庫があります。何てことだ。あなた"}, {"type": "subtitle", "time": 15921.07, "timestamp": "04:25:21", "text": "持っている"}, {"type": "subtitle", "time": 15926.229, "timestamp": "04:25:26", "text": "安全。炉ですね。剣。それは"}, {"type": "subtitle", "time": 15928.67, "timestamp": "04:25:28", "text": "弓と剣を一緒に？それはとても"}, {"type": "subtitle", "time": 15933.309, "timestamp": "04:25:33", "text": "いいね。花瓶、鎧、ベッド、豪華な"}, {"type": "subtitle", "time": 15936.67, "timestamp": "04:25:36", "text": "ベッド、本。それは魔法ですか"}, {"type": "subtitle", "time": 15940.87, "timestamp": "04:25:40", "text": "スティック？まるで魔法の杖のようだ"}, {"type": "subtitle", "time": 15942.51, "timestamp": "04:25:42", "text": "杖または"}, {"type": "subtitle", "time": 15946.229, "timestamp": "04:25:46", "text": "何か。えっと、これは何ですか？これですか"}, {"type": "subtitle", "time": 15950.11, "timestamp": "04:25:50", "text": "顕微鏡検査を行う場所"}, {"type": "subtitle", "time": 15957.59, "timestamp": "04:25:57", "text": "わあ、すごくかっこいい。あなたは文字通りの家を持っています"}]
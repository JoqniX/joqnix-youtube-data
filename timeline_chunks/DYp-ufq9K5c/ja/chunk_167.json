[{"type": "subtitle", "time": 10022.79, "timestamp": "02:47:02", "text": "3つのコラボを獲得、2つのコラボはなし"}, {"type": "subtitle", "time": 10025.75, "timestamp": "02:47:05", "text": "パートナーは、私が行ったときのように"}, {"type": "subtitle", "time": 10028.55, "timestamp": "02:47:08", "text": "壊す"}, {"type": "subtitle", "time": 10030.07, "timestamp": "02:47:10", "text": "ああ、それは良いことだ。それは良い。それは"}, {"type": "subtitle", "time": 10033.349, "timestamp": "02:47:13", "text": "良い。うん。"}, {"type": "subtitle", "time": 10036.07, "timestamp": "02:47:16", "text": "これをきちんと計画しなければならない。"}, {"type": "subtitle", "time": 10039.349, "timestamp": "02:47:19", "text": "危険な。カオス"}, {"type": "subtitle", "time": 10046.63, "timestamp": "02:47:26", "text": "再びミッションの半分以上が"}, {"type": "subtitle", "time": 10056.79, "timestamp": "02:47:36", "text": "うん、新しいスキンを手に入れたところだよ。ニース。は"}, {"type": "subtitle", "time": 10059.99, "timestamp": "02:47:39", "text": "無料ですか？無料のスキン？はい、無料です。"}, {"type": "subtitle", "time": 10062.71, "timestamp": "02:47:42", "text": "グリーンは簡単にダンクを決めた。ニース。何が"}, {"type": "subtitle", "time": 10065.269, "timestamp": "02:47:45", "text": "彼女？グラインドをする必要があると思います"}, {"type": "subtitle", "time": 10068.23, "timestamp": "02:47:48", "text": "これで多くのことが解決するだろう。"}]
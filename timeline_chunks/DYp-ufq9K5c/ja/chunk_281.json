[{"type": "subtitle", "time": 16870.83, "timestamp": "04:41:10", "text": "これはとても"}, {"type": "subtitle", "time": 16872.83, "timestamp": "04:41:12", "text": "いいね。見てください"}, {"type": "subtitle", "time": 16875.39, "timestamp": "04:41:15", "text": "この研究"}, {"type": "subtitle", "time": 16878.03, "timestamp": "04:41:18", "text": "船。朝"}, {"type": "subtitle", "time": 16907.99, "timestamp": "04:41:47", "text": "戻ってきました。父がちょうど入ってきて、ノックした。"}, {"type": "subtitle", "time": 16909.47, "timestamp": "04:41:49", "text": "で"}, {"type": "subtitle", "time": 16913.11, "timestamp": "04:41:53", "text": "ドア。ほら、彼らは本物の雑草を作り出すことができるんだ。"}, {"type": "subtitle", "time": 16915.23, "timestamp": "04:41:55", "text": "何？実際の"}]
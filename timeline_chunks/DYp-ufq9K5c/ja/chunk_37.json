[{"type": "subtitle", "time": 2221.55, "timestamp": "00:37:01", "text": "彼を殴ってもいいですか？"}, {"type": "subtitle", "time": 2235.43, "timestamp": "00:37:15", "text": "あのロケットを撃ち落とせ。うん、"}, {"type": "subtitle", "time": 2236.79, "timestamp": "00:37:16", "text": "まず最初にそれを破壊するつもりだ"}, {"type": "subtitle", "time": 2240.31, "timestamp": "00:37:20", "text": "そして私は"}, {"type": "subtitle", "time": 2242.21, "timestamp": "00:37:22", "text": "ちくしょう。"}, {"type": "subtitle", "time": 2244.069, "timestamp": "00:37:24", "text": "[音楽]"}, {"type": "subtitle", "time": 2252.31, "timestamp": "00:37:32", "text": "最大脈拍。"}, {"type": "subtitle", "time": 2256.67, "timestamp": "00:37:36", "text": "ちくしょう。ショーをもらえますか？"}, {"type": "subtitle", "time": 2265.589, "timestamp": "00:37:45", "text": "ジャービスに映像を削除してもらうつもりだ。"}, {"type": "subtitle", "time": 2269.109, "timestamp": "00:37:49", "text": "その車を再び動かしてください。"}, {"type": "chat", "time": 2279.274, "timestamp": "00:37:59", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "if i remember correctly it was ironman wolverine warlock rocket magneto namor and wanda?"}]
[{"type": "subtitle", "time": 6722.95, "timestamp": "01:52:02", "text": "私はそのジョークを聞いて、それからああ、"}, {"type": "subtitle", "time": 6725.51, "timestamp": "01:52:05", "text": "いつでも喜んでお手伝いします。さあ、行こうぜ、みんな。"}, {"type": "subtitle", "time": 6729.91, "timestamp": "01:52:09", "text": "もちろんさ。さあ行こう。"}, {"type": "subtitle", "time": 6734.709, "timestamp": "01:52:14", "text": "おお。おお。おお。ああ、気にしないで。私たちは大丈夫です。"}, {"type": "subtitle", "time": 6737.669, "timestamp": "01:52:17", "text": "さあ、このろくでなしを突き落とさなければならない。"}, {"type": "subtitle", "time": 6739.83, "timestamp": "01:52:19", "text": "ああ、私たちは押すのが得意なんです。来て。時間"}, {"type": "subtitle", "time": 6741.109, "timestamp": "01:52:21", "text": "物事を変える。いくつあるか知ってる？"}, {"type": "subtitle", "time": 6743.83, "timestamp": "01:52:23", "text": "私が取り上げた赤ちゃんたち？"}, {"type": "subtitle", "time": 6745.75, "timestamp": "01:52:25", "text": "何？"}, {"type": "subtitle", "time": 6747.669, "timestamp": "01:52:27", "text": "誰にとっても頼れる相棒。赤ちゃんは何人いますか"}, {"type": "subtitle", "time": 6750.629, "timestamp": "01:52:30", "text": "配達してくれるの？ええと、私の左側に数人います。"}, {"type": "subtitle", "time": 6752.55, "timestamp": "01:52:32", "text": "はぁ？"}, {"type": "subtitle", "time": 6756.229, "timestamp": "01:52:36", "text": "ちくしょう。とにかく、私はスターロードを選びます。私"}, {"type": "subtitle", "time": 6760.709, "timestamp": "01:52:40", "text": "ああ、スター・ロード、行こうぜ、という感じ。"}]
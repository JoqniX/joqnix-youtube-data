[{"type": "subtitle", "time": 19045.83, "timestamp": "05:17:25", "text": "レザー。面白い。わかった。黒曜石"}, {"type": "subtitle", "time": 19049.03, "timestamp": "05:17:29", "text": "便。私の黒曜石の武器。私は"}, {"type": "subtitle", "time": 19051.51, "timestamp": "05:17:31", "text": "フェザー。生のガラスが必要です。 3つ"}, {"type": "subtitle", "time": 19053.83, "timestamp": "05:17:33", "text": "彼ら。"}, {"type": "subtitle", "time": 19056.75, "timestamp": "05:17:36", "text": "あと、あ、待って。作り方"}, {"type": "subtitle", "time": 19059.15, "timestamp": "05:17:39", "text": "シャベル？えっと、"}, {"type": "subtitle", "time": 19062.43, "timestamp": "05:17:42", "text": "ツール、採掘、"}, {"type": "subtitle", "time": 19075.788, "timestamp": "05:17:55", "text": "アイテム。それで、掘って"}, {"type": "subtitle", "time": 19079.99, "timestamp": "05:17:59", "text": "鉱業、粘土と火打石、石。私は使います"}]
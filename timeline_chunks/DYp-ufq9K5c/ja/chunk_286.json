[{"type": "subtitle", "time": 17160.708, "timestamp": "04:46:00", "text": "王座、現代の市長の家"}, {"type": "subtitle", "time": 17162.83, "timestamp": "04:46:02", "text": "あなたの最初の牧場の動物"}, {"type": "subtitle", "time": 17171.55, "timestamp": "04:46:11", "text": "あなたの"}, {"type": "subtitle", "time": 17184.708, "timestamp": "04:46:24", "text": "資本。ああ、もしチェックできたら"}, {"type": "subtitle", "time": 17186.628, "timestamp": "04:46:26", "text": "クリエイター"}, {"type": "subtitle", "time": 17188.868, "timestamp": "04:46:28", "text": "えーと、こういう設計図を作ると、"}, {"type": "subtitle", "time": 17191.51, "timestamp": "04:46:31", "text": "良くなるだろう。しかし、これは痛みだ。それ"}, {"type": "subtitle", "time": 17195.628, "timestamp": "04:46:35", "text": "正しく表示されません。たとえ私がそれを置いたとしても"}, {"type": "subtitle", "time": 17198.75, "timestamp": "04:46:38", "text": "正しくは、"}, {"type": "subtitle", "time": 17201.31, "timestamp": "04:46:41", "text": "最悪だ。背景"}, {"type": "subtitle", "time": 17204.15, "timestamp": "04:46:44", "text": "三銃士。では、最低価格はいくらですか？"}, {"type": "subtitle", "time": 17207.19, "timestamp": "04:46:47", "text": "このゲームにポイントを入れることはできますか？できますか"}, {"type": "subtitle", "time": 17210.15, "timestamp": "04:46:50", "text": "無料で提供しないのですか？これらの設計図"}, {"type": "subtitle", "time": 17215.99, "timestamp": "04:46:55", "text": "もの？もし私が決して作りたくなかったら"}, {"type": "subtitle", "time": 17217.83, "timestamp": "04:46:57", "text": "お金？もし私がそれを公開したいと思ったら"}]
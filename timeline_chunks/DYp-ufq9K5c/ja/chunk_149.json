[{"type": "subtitle", "time": 8950.95, "timestamp": "02:29:10", "text": "彼はそれを望んでいる。彼はそれを望んでいる。ほら、あげて"}, {"type": "subtitle", "time": 8953.07, "timestamp": "02:29:13", "text": "私にとって。それを渡す"}, {"type": "subtitle", "time": 8956.349, "timestamp": "02:29:16", "text": "自分。彼は何かをタイプしていたと思う"}, {"type": "subtitle", "time": 8958.79, "timestamp": "02:29:18", "text": "おそらく。怒った。彼はそうは思わない"}, {"type": "subtitle", "time": 8960.309, "timestamp": "02:29:20", "text": "誰もいないときに何か入力しよう"}, {"type": "subtitle", "time": 8961.63, "timestamp": "02:29:21", "text": "入力しました"}, {"type": "subtitle", "time": 8965.11, "timestamp": "02:29:25", "text": "何でも。多分。彼は形を整えていたと思う"}, {"type": "subtitle", "time": 8966.79, "timestamp": "02:29:26", "text": "だって、見知らぬ人が「ああ、"}, {"type": "subtitle", "time": 8968.83, "timestamp": "02:29:28", "text": "私は何をしたのか"}, {"type": "subtitle", "time": 8972.79, "timestamp": "02:29:32", "text": "「どうするの？」なんてこった、彼は彼らを乱暴に扱ったんだ。おい、"}, {"type": "subtitle", "time": 8982.23, "timestamp": "02:29:42", "text": "はい。ちょっと中に入ってみます。"}, {"type": "subtitle", "time": 8983.91, "timestamp": "02:29:43", "text": "インフラをそのままにしておきます"}, {"type": "subtitle", "time": 8988.63, "timestamp": "02:29:48", "text": "気をつけてください。うん。そして私は"}]
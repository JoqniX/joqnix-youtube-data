[{"type": "subtitle", "time": 16081.59, "timestamp": "04:28:01", "text": "弓。良いスチームパンク版"}, {"type": "subtitle", "time": 16085.67, "timestamp": "04:28:05", "text": "ナイフが剣をのぞいた。スチームパンク版"}, {"type": "subtitle", "time": 16089.11, "timestamp": "04:28:09", "text": "原始版か、良いもののように私は"}, {"type": "subtitle", "time": 16090.87, "timestamp": "04:28:10", "text": "これを何と呼ぶべきか知っている。これは"}, {"type": "subtitle", "time": 16099.55, "timestamp": "04:28:19", "text": "頭。それは"}, {"type": "subtitle", "time": 16120.75, "timestamp": "04:28:40", "text": "まるで実際に"}, {"type": "subtitle", "time": 16123.51, "timestamp": "04:28:43", "text": "潜水艦。それは文字通り潜水艦です。"}, {"type": "subtitle", "time": 16137.51, "timestamp": "04:28:57", "text": "一部？まるで全く新しい家みたいだ。"}]
[{"type": "subtitle", "time": 6422.07, "timestamp": "01:47:02", "text": "背面。おお。ああ、これでいい。私たちは"}, {"type": "subtitle", "time": 6431.189, "timestamp": "01:47:11", "text": "危険だ。ああ、くそ。クソ殺す"}, {"type": "subtitle", "time": 6447.669, "timestamp": "01:47:27", "text": "また。"}, {"type": "subtitle", "time": 6449.669, "timestamp": "01:47:29", "text": "はい、私はボールを2つ作ります。そこには"}, {"type": "subtitle", "time": 6451.27, "timestamp": "01:47:31", "text": "まるで二人のヒーラーが彼に付き添っているかのようだった。うん。待って、"}, {"type": "subtitle", "time": 6454.79, "timestamp": "01:47:34", "text": "待って、待って。裁判官、陪審員、陪審員、"}, {"type": "subtitle", "time": 6456.629, "timestamp": "01:47:36", "text": "処刑人、"}, {"type": "subtitle", "time": 6463.669, "timestamp": "01:47:43", "text": "彼は持っているのか？"}, {"type": "subtitle", "time": 6465.51, "timestamp": "01:47:45", "text": "ここに戻ってきてください。ええ、そうですね。見てください"}, {"type": "subtitle", "time": 6469.83, "timestamp": "01:47:49", "text": "彼。彼は亡くなった。ああ、彼は死んだんだ。"}, {"type": "subtitle", "time": 6477.35, "timestamp": "01:47:57", "text": "明日。もう一度彼を引っ張ります。"}]
[{"type": "subtitle", "time": 5163.51, "timestamp": "01:26:03", "text": "なあ、ウルヴァリンの"}, {"type": "subtitle", "time": 5166.79, "timestamp": "01:26:06", "text": "声優は常にウルヴァリンの声を担当している"}, {"type": "subtitle", "time": 5170.229, "timestamp": "01:26:10", "text": "過去20年、30年間声優を務めてきた人？"}, {"type": "subtitle", "time": 5172.07, "timestamp": "01:26:12", "text": "スパイダーマンの声優。誰が"}, {"type": "subtitle", "time": 5175.59, "timestamp": "01:26:15", "text": "スパイダーマンの声優？"}, {"type": "subtitle", "time": 5178.709, "timestamp": "01:26:18", "text": "つまり、ほら、"}, {"type": "subtitle", "time": 5181.91, "timestamp": "01:26:21", "text": "あまり。嘘はつきません。ユーリ"}, {"type": "subtitle", "time": 5185.03, "timestamp": "01:26:25", "text": "ローエンタールはスパイダーマンだったが、"}, {"type": "subtitle", "time": 5193.91, "timestamp": "01:26:33", "text": "ほら、彼はかっこいいんだよ。まるでベンみたいだ"}, {"type": "subtitle", "time": 5198.31, "timestamp": "01:26:38", "text": "10enも同様です。彼は、えーと、スケです。彼は"}, {"type": "subtitle", "time": 5200.709, "timestamp": "01:26:40", "text": "あと、『ベヨネッタ』に出てくるあの男もね。"}, {"type": "subtitle", "time": 5203.11, "timestamp": "01:26:43", "text": "彼の名前を忘れてしまった。"}, {"type": "subtitle", "time": 5205.189, "timestamp": "01:26:45", "text": "小屋。私の傷を治すことはできますか？癒すことができるか"}, {"type": "subtitle", "time": 5209.43, "timestamp": "01:26:49", "text": "自分？小屋。あなたは半分まで来ました。"}, {"type": "subtitle", "time": 5211.99, "timestamp": "01:26:51", "text": "ああ、わかりました。私は「あなたは言っているの？」と思いました"}, {"type": "subtitle", "time": 5215.35, "timestamp": "01:26:55", "text": "シャキールがあなたを治してくれる？"}, {"type": "subtitle", "time": 5219.03, "timestamp": "01:26:59", "text": "どうしたの？私は手助けしようとしているんです。えっと、"}]
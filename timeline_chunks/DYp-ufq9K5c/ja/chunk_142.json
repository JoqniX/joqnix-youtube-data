[{"type": "subtitle", "time": 8520.469, "timestamp": "02:22:00", "text": "ああ、彼は負けたと思う"}, {"type": "subtitle", "time": 8523.07, "timestamp": "02:22:03", "text": "彼の健康"}, {"type": "subtitle", "time": 8526.23, "timestamp": "02:22:06", "text": "一緒に。勝利。ああ、これらのガイドライン"}, {"type": "subtitle", "time": 8528.309, "timestamp": "02:22:08", "text": "彼らは狂っている。キャプテン・アメリカ。来て。"}, {"type": "subtitle", "time": 8530.87, "timestamp": "02:22:10", "text": "さあ、アメリカよ。来て。"}, {"type": "subtitle", "time": 8533.03, "timestamp": "02:22:13", "text": "アメリカ、もうすぐ行くよ。製作"}, {"type": "subtitle", "time": 8541.67, "timestamp": "02:22:21", "text": "私は今どこにいるの？どこにありますか"}, {"type": "subtitle", "time": 8544.09, "timestamp": "02:22:24", "text": "アアモトの目によって？"}, {"type": "subtitle", "time": 8545.349, "timestamp": "02:22:25", "text": "[音楽]"}, {"type": "subtitle", "time": 8557.59, "timestamp": "02:22:37", "text": "ああ、なんてことだ、私の苦闘。これは正気の沙汰ではない。"}, {"type": "subtitle", "time": 8560.469, "timestamp": "02:22:40", "text": "ええ、私はそこに"}, {"type": "subtitle", "time": 8563.83, "timestamp": "02:22:43", "text": "ナッツとケーキのお尻。彼らは３人だった"}, {"type": "subtitle", "time": 8566.87, "timestamp": "02:22:46", "text": "３つも失くしたの？ああ、"}, {"type": "subtitle", "time": 8569.11, "timestamp": "02:22:49", "text": "神。 WGになるな。来て。これは"}, {"type": "subtitle", "time": 8571.429, "timestamp": "02:22:51", "text": "ビリー。ビリー、私の友人。あなたはWGにはなれません"}, {"type": "subtitle", "time": 8575.99, "timestamp": "02:22:55", "text": "こちらです。ああ、神様。私は賛成です"}, {"type": "subtitle", "time": 8578.11, "timestamp": "02:22:58", "text": "の目によって"}]
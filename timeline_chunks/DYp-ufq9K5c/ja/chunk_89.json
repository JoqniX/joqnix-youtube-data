[{"type": "subtitle", "time": 5344.31, "timestamp": "01:29:04", "text": "あらら。"}, {"type": "subtitle", "time": 5354.709, "timestamp": "01:29:14", "text": "月があのバカどもを滅ぼした。子供たち"}, {"type": "subtitle", "time": 5358.55, "timestamp": "01:29:18", "text": "ナイトがお前を捕まえたぞ、兄弟。何？"}, {"type": "subtitle", "time": 5360.47, "timestamp": "01:29:20", "text": "彼女は死ぬだろう。"}, {"type": "subtitle", "time": 5361.99, "timestamp": "01:29:21", "text": "その弾倉は絶対に外さない。一度もない"}, {"type": "subtitle", "time": 5365.87, "timestamp": "01:29:25", "text": "心。彼はそうした。ああ、しまった。本当です"}, {"type": "subtitle", "time": 5368.55, "timestamp": "01:29:28", "text": "火の息子め、あいつを捕まえてやる。私は"}, {"type": "subtitle", "time": 5369.91, "timestamp": "01:29:29", "text": "そこへ行こうとしている。私は"}, {"type": "subtitle", "time": 5371.43, "timestamp": "01:29:31", "text": "彼を捕まえる。"}, {"type": "subtitle", "time": 5373.11, "timestamp": "01:29:33", "text": "ロケット。"}, {"type": "subtitle", "time": 5383.47, "timestamp": "01:29:43", "text": "驚きました"}, {"type": "subtitle", "time": 5387.43, "timestamp": "01:29:47", "text": "えっと、バッキー。"}, {"type": "subtitle", "time": 5389.51, "timestamp": "01:29:49", "text": "うん、バッキーは、人々は狙いを定める必要がある、"}, {"type": "subtitle", "time": 5391.51, "timestamp": "01:29:51", "text": "あなたが知っている。今のクモは最悪だ。"}, {"type": "subtitle", "time": 5393.91, "timestamp": "01:29:53", "text": "ああ。何てことだ。"}, {"type": "subtitle", "time": 5396.07, "timestamp": "01:29:56", "text": "つまり、彼は被弾したんだ。もちろん、"}, {"type": "subtitle", "time": 5398.31, "timestamp": "01:29:58", "text": "標的。"}]
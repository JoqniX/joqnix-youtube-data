[{"type": "subtitle", "time": 8765.75, "timestamp": "02:26:05", "text": "残り30秒。"}, {"type": "subtitle", "time": 8769.27, "timestamp": "02:26:09", "text": "押し戻す。目に強く押し込む。"}, {"type": "subtitle", "time": 8771.429, "timestamp": "02:26:11", "text": "阿賀本氏の。"}, {"type": "subtitle", "time": 8774.389, "timestamp": "02:26:14", "text": "どちらか一方だけでは勝てなかった。おお"}, {"type": "subtitle", "time": 8777.83, "timestamp": "02:26:17", "text": "我が神よ。彼らは本当に最悪だ。くそったれ。おお、"}, {"type": "subtitle", "time": 8780.23, "timestamp": "02:26:20", "text": "デモ版を入手しました。なぜ私はただ押しただけだったのか"}, {"type": "subtitle", "time": 8781.99, "timestamp": "02:26:21", "text": "それを入れる？"}, {"type": "subtitle", "time": 8785.55, "timestamp": "02:26:25", "text": "最後の10秒。"}, {"type": "subtitle", "time": 8789.349, "timestamp": "02:26:29", "text": "人間の帽子ではそれを支えきれない。ニース。それは"}, {"type": "subtitle", "time": 8795.429, "timestamp": "02:26:35", "text": "持っている"}, {"type": "subtitle", "time": 8797.99, "timestamp": "02:26:37", "text": "漕げ、男。"}, {"type": "subtitle", "time": 8801.03, "timestamp": "02:26:41", "text": "ええ、そうでしたよ。素晴らしい。"}, {"type": "subtitle", "time": 8803.349, "timestamp": "02:26:43", "text": "そろそろ変化をつける時だ。"}, {"type": "subtitle", "time": 8805.75, "timestamp": "02:26:45", "text": "どちら側ですか。赤い卵が疑問符になる"}, {"type": "subtitle", "time": 8809.99, "timestamp": "02:26:49", "text": "チャットで。 BM兄弟がいると全く違う。"}, {"type": "subtitle", "time": 8813.03, "timestamp": "02:26:53", "text": "目を開けて。現実は"}, {"type": "subtitle", "time": 8815.19, "timestamp": "02:26:55", "text": "錯覚。わかった。奇妙な。ああ、"}, {"type": "subtitle", "time": 8816.71, "timestamp": "02:26:56", "text": "コース。ソロタンクで私を残して"}, {"type": "subtitle", "time": 8819.429, "timestamp": "02:26:59", "text": "クソッタレのソーと、もう一方の"}]
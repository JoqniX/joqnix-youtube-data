[{"type": "subtitle", "time": 5101.03, "timestamp": "01:25:01", "text": "「オーバーウォッチに戻れよ、相棒。」私は「行け」って感じだった。"}, {"type": "subtitle", "time": 5103.83, "timestamp": "01:25:03", "text": "オーバーウォッチだよ。 Overwatch へ行き、"}, {"type": "subtitle", "time": 5105.27, "timestamp": "01:25:05", "text": "相棒。 「なぜここにいるの？」私はこう思った。"}, {"type": "subtitle", "time": 5106.27, "timestamp": "01:25:06", "text": "\"わかった、"}, {"type": "subtitle", "time": 5109.03, "timestamp": "01:25:09", "text": "男。落ち着け。ただのゲームだよ。ああ、"}, {"type": "subtitle", "time": 5110.39, "timestamp": "01:25:10", "text": "スパイダーマン。スパイダーマンは"}, {"type": "subtitle", "time": 5112.39, "timestamp": "01:25:12", "text": "破滅。彼はドゥームフィストのポーズをしている。いいえ、違います"}, {"type": "subtitle", "time": 5115.99, "timestamp": "01:25:15", "text": "ドゥームフィスト。ごめん。それは何という名前ですか？"}, {"type": "subtitle", "time": 5119.11, "timestamp": "01:25:19", "text": "何ですって？くそ。モスクの男のことを忘れてた。"}, {"type": "subtitle", "time": 5120.07, "timestamp": "01:25:20", "text": "おお。"}, {"type": "subtitle", "time": 5123.35, "timestamp": "01:25:23", "text": "苔男。"}, {"type": "subtitle", "time": 5127.189, "timestamp": "01:25:27", "text": "リーパー。そうそう。ああ、スターロードのことか"}, {"type": "subtitle", "time": 5128.95, "timestamp": "01:25:28", "text": "彼の"}, {"type": "subtitle", "time": 5131.27, "timestamp": "01:25:31", "text": "通常サイズの武器に留めておきましょう。わかった。おお"}, {"type": "subtitle", "time": 5134.229, "timestamp": "01:25:34", "text": "うん。スパイダーマンもね。何てことだ。"}, {"type": "subtitle", "time": 5138.149, "timestamp": "01:25:38", "text": "そうそう。ほぼその通りです。うん。"}, {"type": "subtitle", "time": 5140.95, "timestamp": "01:25:40", "text": "かなり似ている。うん。スターロードも"}, {"type": "subtitle", "time": 5143.91, "timestamp": "01:25:43", "text": "あの死神。"}, {"type": "subtitle", "time": 5146.149, "timestamp": "01:25:46", "text": "私はそれを「リーパーMVPボタン」と呼んでいます。あなた"}, {"type": "subtitle", "time": 5147.79, "timestamp": "01:25:47", "text": "押すだけです。ブーム。君はMVPだ。おお"}, {"type": "subtitle", "time": 5149.59, "timestamp": "01:25:49", "text": "くそっ。"}, {"type": "subtitle", "time": 5151.669, "timestamp": "01:25:51", "text": "残念ながら、MVPではありませんでした。えーと、"}, {"type": "subtitle", "time": 5154.39, "timestamp": "01:25:54", "text": "ゲーム。マグは良い。"}, {"type": "subtitle", "time": 5156.149, "timestamp": "01:25:56", "text": "そのマガジンは良いですね。知ってる？"}]
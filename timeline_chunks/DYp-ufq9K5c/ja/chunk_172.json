[{"type": "subtitle", "time": 10322.469, "timestamp": "02:52:02", "text": "うん。うん。まあ、それで私は楽しんだよ"}, {"type": "subtitle", "time": 10325.11, "timestamp": "02:52:05", "text": "チャット。実際、遊ぶのは楽しいです。"}, {"type": "subtitle", "time": 10327.51, "timestamp": "02:52:07", "text": "すごく良かったよ。うん。さらに"}, {"type": "subtitle", "time": 10331.59, "timestamp": "02:52:11", "text": "ここにイニシャルを記入してください。それも良かったですね。うん。"}, {"type": "subtitle", "time": 10334.15, "timestamp": "02:52:14", "text": "うん。うん。うん。"}, {"type": "subtitle", "time": 10342.55, "timestamp": "02:52:22", "text": "それでは、またお会いしましょう。願っています"}, {"type": "subtitle", "time": 10345.75, "timestamp": "02:52:25", "text": "君はすっかり元気になったね。"}, {"type": "subtitle", "time": 10350.07, "timestamp": "02:52:30", "text": "私は。はい。うん。あなたはあなたの声はあなたの声は"}, {"type": "subtitle", "time": 10354.11, "timestamp": "02:52:34", "text": "配信するのが楽しみです。よし、準備はできたよ。"}, {"type": "subtitle", "time": 10357.99, "timestamp": "02:52:37", "text": "D. 準備はできています。準備はできたよ、みんな。はい、"}, {"type": "subtitle", "time": 10362.15, "timestamp": "02:52:42", "text": "また後で会おうぜ、相棒。こんにちは。バイバイ。"}, {"type": "subtitle", "time": 10365.269, "timestamp": "02:52:45", "text": "お大事に、ゆっくり休んでください。"}, {"type": "subtitle", "time": 10374.91, "timestamp": "02:52:54", "text": "[音楽]"}, {"type": "subtitle", "time": 10379.469, "timestamp": "02:52:59", "text": "バイバイ。ということで、ブラッド、私たちの1人目と"}]
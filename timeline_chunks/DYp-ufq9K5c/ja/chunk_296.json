[{"type": "subtitle", "time": 17761.59, "timestamp": "04:56:01", "text": "ゲームのセーブデータ？"}, {"type": "subtitle", "time": 17763.75, "timestamp": "04:56:03", "text": "通常のゲームセーブデータのようにホスト共有"}, {"type": "subtitle", "time": 17765.51, "timestamp": "04:56:05", "text": "ホストコンピュータ上のゲームとは"}, {"type": "subtitle", "time": 17767.83, "timestamp": "04:56:07", "text": "手動座位で素早く打つ"}, {"type": "subtitle", "time": 17770.15, "timestamp": "04:56:10", "text": "終了時の保存と通常の自動保存"}, {"type": "subtitle", "time": 17773.03, "timestamp": "04:56:13", "text": "ゲームはアップロードされます"}, {"type": "subtitle", "time": 17783.07, "timestamp": "04:56:23", "text": "私の店はどうなるの？"}, {"type": "subtitle", "time": 17786.55, "timestamp": "04:56:26", "text": "制限に入ると、プレイできるようになります。"}, {"type": "subtitle", "time": 17790.55, "timestamp": "04:56:30", "text": "他人のゲームに参加して、それを維持しようとする。"}, {"type": "subtitle", "time": 17793.75, "timestamp": "04:56:33", "text": "ああ、もし私が"}, {"type": "subtitle", "time": 17795.868, "timestamp": "04:56:35", "text": "私の"}, {"type": "subtitle", "time": 17799.19, "timestamp": "04:56:39", "text": "飛行機の店は、もう1つは"}, {"type": "subtitle", "time": 17801.83, "timestamp": "04:56:41", "text": "クラウドストレージに空き容量が増えました。"}, {"type": "subtitle", "time": 17808.55, "timestamp": "04:56:48", "text": "えっと、あなたが望む唯一の人を教えてください"}, {"type": "subtitle", "time": 17810.35, "timestamp": "04:56:50", "text": "一緒に遊ぶ？金額を増やすにはどうすればいいですか"}, {"type": "subtitle", "time": 17813.43, "timestamp": "04:56:53", "text": "スロットマシン？無料プランは3つで、有料プランもあります。"}, {"type": "subtitle", "time": 17815.99, "timestamp": "04:56:55", "text": "レベルは5です。私たちも計画することができます"}, {"type": "subtitle", "time": 17819.11, "timestamp": "04:56:59", "text": "有料プランにさらに多くの枠を追加する。できる"}]
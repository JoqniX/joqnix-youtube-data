[{"type": "subtitle", "time": 5282.31, "timestamp": "01:28:02", "text": "した。"}, {"type": "subtitle", "time": 5284.709, "timestamp": "01:28:04", "text": "TF2はそれを見逃さなかった。私は違います"}, {"type": "subtitle", "time": 5292.55, "timestamp": "01:28:12", "text": "我々にはまだその点が残っている。"}, {"type": "subtitle", "time": 5295.669, "timestamp": "01:28:15", "text": "私たちはそうではないと分かっています。もちろん。スパイダーマン、"}, {"type": "subtitle", "time": 5297.03, "timestamp": "01:28:17", "text": "何かあるんだよ。来て。あなたは3位です"}, {"type": "subtitle", "time": 5299.189, "timestamp": "01:28:19", "text": "1つ。さあ、スパイダーマン。やる やる"}, {"type": "subtitle", "time": 5300.709, "timestamp": "01:28:20", "text": "面白い。"}, {"type": "subtitle", "time": 5302.31, "timestamp": "01:28:22", "text": "これはクモですか？これはスパイダーマンですか？"}, {"type": "subtitle", "time": 5309.83, "timestamp": "01:28:29", "text": "彼を捕まえるぞ。彼は持っていない"}, {"type": "subtitle", "time": 5311.27, "timestamp": "01:28:31", "text": "いや、俺は彼を捕まえたりしないよ。ああ、神様。"}, {"type": "subtitle", "time": 5313.28, "timestamp": "01:28:33", "text": "ああ、神様。 ああ、神様。"}, {"type": "subtitle", "time": 5326.31, "timestamp": "01:28:46", "text": "今から取りに行きます。"}, {"type": "subtitle", "time": 5328.629, "timestamp": "01:28:48", "text": "ああ、それを手に入れろ。おお、"}, {"type": "subtitle", "time": 5330.229, "timestamp": "01:28:50", "text": "失敗した。どうでも。理解できませんでした。おお、"}, {"type": "subtitle", "time": 5333.11, "timestamp": "01:28:53", "text": "セール品を手に入れました。"}, {"type": "subtitle", "time": 5335.11, "timestamp": "01:28:55", "text": "あなたはデリーに住んでいないのが分かります。失敗"}, {"type": "subtitle", "time": 5336.629, "timestamp": "01:28:56", "text": "男を誘拐しようとしたが失敗した。来る"}]
[{"type": "subtitle", "time": 5704.629, "timestamp": "01:35:04", "text": "兄弟。おい、DPS。"}, {"type": "subtitle", "time": 5710.79, "timestamp": "01:35:10", "text": "ケンの方があなたより上だと思っていました。"}, {"type": "subtitle", "time": 5712.95, "timestamp": "01:35:12", "text": "タンク。"}, {"type": "subtitle", "time": 5724.709, "timestamp": "01:35:24", "text": "少なくとも、プレイのようにプレイしているなら"}, {"type": "subtitle", "time": 5726.79, "timestamp": "01:35:26", "text": "誰か"}, {"type": "subtitle", "time": 5728.709, "timestamp": "01:35:28", "text": "わかった"}, {"type": "subtitle", "time": 5737.83, "timestamp": "01:35:37", "text": "オーケー、彼女はよくやった、彼女はよくやった、彼女は"}, {"type": "subtitle", "time": 5740.149, "timestamp": "01:35:40", "text": "良い"}, {"type": "subtitle", "time": 5742.95, "timestamp": "01:35:42", "text": "の目によって"}, {"type": "subtitle", "time": 5745.35, "timestamp": "01:35:45", "text": "くそっ、ああ、"}, {"type": "subtitle", "time": 5748.709, "timestamp": "01:35:48", "text": "君の力は私のものだ。"}, {"type": "subtitle", "time": 5749.91, "timestamp": "01:35:49", "text": "娘を殺せ。娘を殺せ。"}, {"type": "subtitle", "time": 5758.55, "timestamp": "01:35:58", "text": "私のチームメイトが私の娘を殺した。"}]
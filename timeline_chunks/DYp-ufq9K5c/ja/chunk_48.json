[{"type": "subtitle", "time": 2883.109, "timestamp": "00:48:03", "text": "くそっ。来て。"}, {"type": "subtitle", "time": 2885.069, "timestamp": "00:48:05", "text": "来て、"}, {"type": "subtitle", "time": 2894.71, "timestamp": "00:48:14", "text": "28. そうだね、相棒。うん。信じられますか？"}, {"type": "subtitle", "time": 2896.63, "timestamp": "00:48:16", "text": "これ？ちなみに、このゲームでは40点取った"}, {"type": "subtitle", "time": 2898.109, "timestamp": "00:48:18", "text": "そして9と私たちは"}, {"type": "subtitle", "time": 2904.95, "timestamp": "00:48:24", "text": "素晴らしい。ちなみに、それは昨日のことです。私"}, {"type": "subtitle", "time": 2906.79, "timestamp": "00:48:26", "text": "昨日もこのゲームをプレイしていました。"}, {"type": "subtitle", "time": 2910.15, "timestamp": "00:48:30", "text": "あなたの言う通りです。"}, {"type": "subtitle", "time": 2913.51, "timestamp": "00:48:33", "text": "その通りだよ、友よ。"}, {"type": "subtitle", "time": 2917.23, "timestamp": "00:48:37", "text": "地獄の隠れ家。この地図ではない。"}, {"type": "subtitle", "time": 2919.75, "timestamp": "00:48:39", "text": "あなたは今日、どちらの自分になりたいと思いますか？"}, {"type": "subtitle", "time": 2922.79, "timestamp": "00:48:42", "text": "ああ、それから、みんなが私が"}, {"type": "subtitle", "time": 2925.27, "timestamp": "00:48:45", "text": "これを私なりのやり方で演奏する。彼らはそうしないだろう"}, {"type": "subtitle", "time": 2927.19, "timestamp": "00:48:47", "text": "人々は、もし誰か知っている人がいたら"}, {"type": "subtitle", "time": 2929.67, "timestamp": "00:48:49", "text": "おそらくDはこれを知っているだろう。 D、あなたは"}, {"type": "subtitle", "time": 2933.75, "timestamp": "00:48:53", "text": "X-メンのアーマーについて何かご存知ですか？誰が"}, {"type": "subtitle", "time": 2936.91, "timestamp": "00:48:56", "text": "私はピンクの鎧を着るつもりですか？"}]
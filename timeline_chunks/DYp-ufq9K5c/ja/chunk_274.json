[{"type": "subtitle", "time": 16441.59, "timestamp": "04:34:01", "text": "家。オウムがやってきて"}, {"type": "subtitle", "time": 16451.629, "timestamp": "04:34:11", "text": "家のキッチンキャビネット。"}, {"type": "subtitle", "time": 16455.59, "timestamp": "04:34:15", "text": "ああ、収納引き出しはどうやって作るのですか？"}, {"type": "subtitle", "time": 16457.83, "timestamp": "04:34:17", "text": "あれ？それは本当に良さそうですね。私"}, {"type": "subtitle", "time": 16460.15, "timestamp": "04:34:20", "text": "私は"}, {"type": "subtitle", "time": 16465.269, "timestamp": "04:34:25", "text": "原始的なものから現代的なものへ、時を経て"}, {"type": "subtitle", "time": 16467.51, "timestamp": "04:34:27", "text": "そして、これらすべてを手に入れる方法を見つける"}, {"type": "subtitle", "time": 16469.83, "timestamp": "04:34:29", "text": "あなたがここに持っているようなもの。のように"}, {"type": "subtitle", "time": 16479.629, "timestamp": "04:34:39", "text": "いいね。それで"}, {"type": "subtitle", "time": 16482.629, "timestamp": "04:34:42", "text": "多くの。ああ、これは温室ですね。いいえ、"}, {"type": "subtitle", "time": 16485.99, "timestamp": "04:34:45", "text": "温室の場所。わかった。わかった。"}, {"type": "subtitle", "time": 16496.19, "timestamp": "04:34:56", "text": "何か。"}, {"type": "subtitle", "time": 16497.949, "timestamp": "04:34:57", "text": "[音楽]"}]
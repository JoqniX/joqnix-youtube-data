[{"type": "subtitle", "time": 7100.55, "timestamp": "01:58:20", "text": "ゼロ。わかった。"}, {"type": "subtitle", "time": 7103.43, "timestamp": "01:58:23", "text": "それでいい。"}, {"type": "subtitle", "time": 7106.55, "timestamp": "01:58:26", "text": "次は必ず仕返ししてやる。"}, {"type": "subtitle", "time": 7113.589, "timestamp": "01:58:33", "text": "ああ、神様。わかった。彼らは代替エネルギーを供給している。"}, {"type": "subtitle", "time": 7116.31, "timestamp": "01:58:36", "text": "彼らはポンプを稼働させている。"}, {"type": "subtitle", "time": 7119.99, "timestamp": "01:58:39", "text": "ポンプを使うことになるでしょう。よお、"}, {"type": "subtitle", "time": 7123.27, "timestamp": "01:58:43", "text": "マックスは、マックは私たちが"}, {"type": "subtitle", "time": 7126.589, "timestamp": "01:58:46", "text": "選手が1人減ったか何かで、彼は"}]
[{"type": "subtitle", "time": 12980.67, "timestamp": "03:36:20", "text": "ハンドと弾薬"}, {"type": "subtitle", "time": 12983.63, "timestamp": "03:36:23", "text": "サッチェル。私は作らなければならない"}, {"type": "subtitle", "time": 12990.389, "timestamp": "03:36:30", "text": "隠れる。何かを作らなければならない"}, {"type": "subtitle", "time": 12993.11, "timestamp": "03:36:33", "text": "隠れる。私は漁網を持っています。私は作ることができます"}, {"type": "subtitle", "time": 12994.75, "timestamp": "03:36:34", "text": "釣り"}, {"type": "subtitle", "time": 12998.65, "timestamp": "03:36:38", "text": "ネット。釣り餌。"}]
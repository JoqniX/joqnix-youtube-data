[{"type": "subtitle", "time": 5042.87, "timestamp": "01:24:02", "text": "勇気が出た。彼のHPは100減少した。"}, {"type": "subtitle", "time": 5046.83, "timestamp": "01:24:06", "text": "彼は600馬力で走っている。くそ。なんてこった？の"}, {"type": "subtitle", "time": 5050.31, "timestamp": "01:24:10", "text": "彼らは彼を森林伐採したんだよ、兄弟。なんてこった？"}, {"type": "subtitle", "time": 5053.189, "timestamp": "01:24:13", "text": "ああ、彼の壁は体力が全然足りない"}, {"type": "subtitle", "time": 5055.99, "timestamp": "01:24:15", "text": "今。彼の両方の壁。たとえ"}, {"type": "subtitle", "time": 5058.39, "timestamp": "01:24:18", "text": "主要なもの。彼の壁は両方とも少ない"}, {"type": "subtitle", "time": 5060.629, "timestamp": "01:24:20", "text": "健康を今すぐ。人々はそれを細かく切り刻むことができる、"}, {"type": "subtitle", "time": 5062.47, "timestamp": "01:24:22", "text": "でも人々はグルートを禁止したいだけなんです"}, {"type": "subtitle", "time": 5063.51, "timestamp": "01:24:23", "text": "彼らは対処したくない"}, {"type": "subtitle", "time": 5065.35, "timestamp": "01:24:25", "text": "誘拐。"}, {"type": "subtitle", "time": 5067.59, "timestamp": "01:24:27", "text": "彼らは誘拐を憎んでいる。彼らは"}, {"type": "subtitle", "time": 5070.229, "timestamp": "01:24:30", "text": "ザリー・アル、兄弟。いいえ。"}, {"type": "subtitle", "time": 5072.55, "timestamp": "01:24:32", "text": "ああ、ザーリャだ。おお。うん、そっちの方がいい"}, {"type": "subtitle", "time": 5074.229, "timestamp": "01:24:34", "text": "ザリーらわかった。抜け出すことはできません"}, {"type": "subtitle", "time": 5076.629, "timestamp": "01:24:36", "text": "それ。ザリアから抜け出すことができます。真実。"}, {"type": "subtitle", "time": 5078.39, "timestamp": "01:24:38", "text": "自分自身を浄化して抜け出すことができます"}, {"type": "subtitle", "time": 5081.149, "timestamp": "01:24:41", "text": "ザリオだけど、これはひどい。絶対に嫌だ。"}, {"type": "subtitle", "time": 5083.75, "timestamp": "01:24:43", "text": "その通りだよ。私は他のゲームをプレイしていました"}, {"type": "subtitle", "time": 5086.31, "timestamp": "01:24:46", "text": "日、私はオーバーウォッチの用語を使っていました"}, {"type": "subtitle", "time": 5088.07, "timestamp": "01:24:48", "text": "そして"}, {"type": "subtitle", "time": 5089.91, "timestamp": "01:24:49", "text": "この男はスターロードとしてプレイしていた"}, {"type": "subtitle", "time": 5091.51, "timestamp": "01:24:51", "text": "良い。彼はスターロードを演じていた。そして彼は"}, {"type": "subtitle", "time": 5094.31, "timestamp": "01:24:54", "text": "私が使っていたから、すごく怒られた"}, {"type": "subtitle", "time": 5096.87, "timestamp": "01:24:56", "text": "オーバーウォッチの専門用語だよ、兄弟。彼はこう言った。「もし"}, {"type": "subtitle", "time": 5098.79, "timestamp": "01:24:58", "text": "Overwatchをプレイしたいなら、"}]
[{"type": "subtitle", "time": 14294.15, "timestamp": "03:58:14", "text": "働く。待って、PVPみたいなのがあるの？"}, {"type": "subtitle", "time": 14296.07, "timestamp": "03:58:16", "text": "海賊か、あるいは誰か、あるいは何か"}, {"type": "subtitle", "time": 14298.71, "timestamp": "03:58:18", "text": "Sea of​​ Thieves？いいえ。人々が"}, {"type": "subtitle", "time": 14301.91, "timestamp": "03:58:21", "text": "戦いのようにアイテムを奪い、"}, {"type": "subtitle", "time": 14303.99, "timestamp": "03:58:23", "text": "お前と戦ったりとか。"}, {"type": "subtitle", "time": 14313.269, "timestamp": "03:58:33", "text": "えっと、いつでも私の名前を調べてください"}, {"type": "subtitle", "time": 14318.01, "timestamp": "03:58:38", "text": "置こうとしているところだ。あ、待って、待って、待って。えっと、私は"}, {"type": "subtitle", "time": 14320.67, "timestamp": "03:58:40", "text": "[音楽]"}, {"type": "subtitle", "time": 14325.229, "timestamp": "03:58:45", "text": "えっと、一番上の緑色の四角。これです。いいえ。わかりました。"}, {"type": "subtitle", "time": 14329.229, "timestamp": "03:58:49", "text": "えっと、もっと見るをクリックするべきですね。"}, {"type": "subtitle", "time": 14330.99, "timestamp": "03:58:50", "text": "右？"}, {"type": "subtitle", "time": 14333.55, "timestamp": "03:58:53", "text": "設計図。設計図"}, {"type": "subtitle", "time": 14337.79, "timestamp": "03:58:57", "text": "ブラウザ。確認してみます"}]
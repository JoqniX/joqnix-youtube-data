[{"type": "subtitle", "time": 7800.55, "timestamp": "02:10:00", "text": "対決？一体どういうことだ？うん。その"}, {"type": "subtitle", "time": 7802.95, "timestamp": "02:10:02", "text": "「マーベル・コンフロンテーション」と呼ばれる。いつも"}, {"type": "subtitle", "time": 7805.99, "timestamp": "02:10:05", "text": "予想通りだった。ライバルは許可されていません。おお"}, {"type": "subtitle", "time": 7810.47, "timestamp": "02:10:10", "text": "我が神よ。わかった。うん。うん。ジョーはいつも尋ねる"}, {"type": "subtitle", "time": 7811.99, "timestamp": "02:10:11", "text": "ビリーの何ていう名前だったっけ？"}, {"type": "subtitle", "time": 7815.069, "timestamp": "02:10:15", "text": "Webサイト？まるで、まるで、と呼ばれるようなもの"}, {"type": "subtitle", "time": 7818.31, "timestamp": "02:10:18", "text": "マーベルファイターズとかいうやつ？そうではありません"}, {"type": "subtitle", "time": 7820.47, "timestamp": "02:10:20", "text": "対決。"}, {"type": "subtitle", "time": 7823.149, "timestamp": "02:10:23", "text": "それは正気の沙汰ではない。くそっ。見逃した"}, {"type": "subtitle", "time": 7828.99, "timestamp": "02:10:28", "text": "ログを取る必要がある"}, {"type": "subtitle", "time": 7838.47, "timestamp": "02:10:38", "text": "君は僕のものだ。動けません。"}, {"type": "subtitle", "time": 7841.91, "timestamp": "02:10:41", "text": "月があなたを悩ませる。"}, {"type": "subtitle", "time": 7843.91, "timestamp": "02:10:43", "text": "おい、ところでこのAIは大好きだよ"}, {"type": "subtitle", "time": 7859.189, "timestamp": "02:10:59", "text": "ああ、なんてこった。ああ、その通りだ。"}]
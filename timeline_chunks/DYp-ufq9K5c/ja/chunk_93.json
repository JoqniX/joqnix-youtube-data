[{"type": "subtitle", "time": 5581.83, "timestamp": "01:33:01", "text": "シグマ？私はシグマですか？いやいや、彼は4歳だった"}, {"type": "subtitle", "time": 5583.189, "timestamp": "01:33:03", "text": "そして5つ。 4と5。そして"}, {"type": "subtitle", "time": 5584.709, "timestamp": "01:33:04", "text": "カバ。"}, {"type": "subtitle", "time": 5586.47, "timestamp": "01:33:06", "text": "うん。それはカバだったのだろうか？うん、"}, {"type": "subtitle", "time": 5590.149, "timestamp": "01:33:10", "text": "彼だった。彼だった。うん。"}, {"type": "subtitle", "time": 5592.31, "timestamp": "01:33:12", "text": "「いや、気にしないで」と言った男。一度もない"}, {"type": "subtitle", "time": 5595.11, "timestamp": "01:33:15", "text": "心。ええ、彼でした。巻き戻し"}, {"type": "subtitle", "time": 5598.39, "timestamp": "01:33:18", "text": "流れだよ、相棒。来て。えっと、私は"}, {"type": "subtitle", "time": 5600.79, "timestamp": "01:33:20", "text": "そうしたい。"}, {"type": "subtitle", "time": 5603.669, "timestamp": "01:33:23", "text": "クソ女。クソ野郎ってどういう意味だよ？私は"}, {"type": "subtitle", "time": 5605.55, "timestamp": "01:33:25", "text": "そんな女。"}, {"type": "subtitle", "time": 5612.95, "timestamp": "01:33:32", "text": "とにかく、すべては暑さ次第だ。私にさせて"}, {"type": "subtitle", "time": 5615.75, "timestamp": "01:33:35", "text": "彼らに上位者を見せつけろ。ああ、気にしないで。"}, {"type": "subtitle", "time": 5617.43, "timestamp": "01:33:37", "text": "うわ、うわ、うわ。落ち着け。ダブル"}, {"type": "subtitle", "time": 5619.11, "timestamp": "01:33:39", "text": "シールド。"}, {"type": "subtitle", "time": 5620.87, "timestamp": "01:33:40", "text": "二重シールド。これは これは これは これは"}, {"type": "subtitle", "time": 5623.669, "timestamp": "01:33:43", "text": "そうだろ、犬。ダブルシールドはダメ"}, {"type": "subtitle", "time": 5625.51, "timestamp": "01:33:45", "text": "白い肌をしたままそう言ってみろ。来る"}, {"type": "subtitle", "time": 5627.91, "timestamp": "01:33:47", "text": "の上。"}, {"type": "subtitle", "time": 5629.99, "timestamp": "01:33:49", "text": "スパイダーマンはクソだ。私はただ見ることができる"}, {"type": "subtitle", "time": 5636.87, "timestamp": "01:33:56", "text": "どこにあるの？ ああ、彼はじっと立っている。"}]
[{"type": "subtitle", "time": 19455.43, "timestamp": "05:24:15", "text": "今。掘削任務はないのですか？多分"}, {"type": "subtitle", "time": 19456.51, "timestamp": "05:24:16", "text": "そこには"}, {"type": "subtitle", "time": 19459.75, "timestamp": "05:24:19", "text": "は。はい、お嬢さん。宣教師がいるなら、"}, {"type": "subtitle", "time": 19461.948, "timestamp": "05:24:21", "text": "もちろん、そこは"}, {"type": "subtitle", "time": 19463.788, "timestamp": "05:24:23", "text": "なれ"}, {"type": "subtitle", "time": 19468.46, "timestamp": "05:24:28", "text": "そういう類のことです。たぶんここ"}]
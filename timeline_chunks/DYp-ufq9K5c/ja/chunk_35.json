[{"type": "subtitle", "time": 2104.31, "timestamp": "00:35:04", "text": "わかった。わかった。わかった。わかった。どうせなら"}, {"type": "subtitle", "time": 2107.51, "timestamp": "00:35:07", "text": "ガラス製。"}, {"type": "subtitle", "time": 2110.55, "timestamp": "00:35:10", "text": "よし、次はヒールに挑戦しよう。"}, {"type": "subtitle", "time": 2113.19, "timestamp": "00:35:13", "text": "おそらくそうでしょう。よし、アイアンマンはどこかにいる"}, {"type": "subtitle", "time": 2116.23, "timestamp": "00:35:16", "text": "ここ。私は覚えています。"}, {"type": "subtitle", "time": 2118.79, "timestamp": "00:35:18", "text": "こんにちは。こんにちは。この場所は価値がある"}, {"type": "subtitle", "time": 2120.31, "timestamp": "00:35:20", "text": "観察中。"}, {"type": "subtitle", "time": 2121.79, "timestamp": "00:35:21", "text": "私たちには"}, {"type": "subtitle", "time": 2130.47, "timestamp": "00:35:30", "text": "よし、みんな、交代するよ。私は"}, {"type": "subtitle", "time": 2133.51, "timestamp": "00:35:33", "text": "おそらく"}, {"type": "subtitle", "time": 2142.39, "timestamp": "00:35:42", "text": "イカの死骸がさらに増えた。イカ。私たちはできますか"}, {"type": "subtitle", "time": 2148.55, "timestamp": "00:35:48", "text": "私の見事なゲームプレイ。あなたが正しい"}, {"type": "subtitle", "time": 2158.03, "timestamp": "00:35:58", "text": "わかった。見逃した"}]
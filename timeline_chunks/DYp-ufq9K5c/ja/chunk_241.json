[{"type": "subtitle", "time": 14485.71, "timestamp": "04:01:25", "text": "[音楽]"}, {"type": "subtitle", "time": 14488.79, "timestamp": "04:01:28", "text": "番組はそうではないかもしれない。待って。メインメニュー"}, {"type": "subtitle", "time": 14491.67, "timestamp": "04:01:31", "text": "で"}, {"type": "subtitle", "time": 14499.83, "timestamp": "04:01:39", "text": "[音楽]"}, {"type": "subtitle", "time": 14503.349, "timestamp": "04:01:43", "text": "ああ、これだ。待って、どうやってゲームをセーブするの？"}, {"type": "subtitle", "time": 14515.83, "timestamp": "04:01:55", "text": "えーっと、階段から始めます"}, {"type": "subtitle", "time": 14518.429, "timestamp": "04:01:58", "text": "たくさんあるけど、後で簡単にわかる。"}]
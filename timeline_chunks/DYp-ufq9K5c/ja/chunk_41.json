[{"type": "subtitle", "time": 2460.79, "timestamp": "00:41:00", "text": "金？君たちは一体何の話をしてるんだ？"}, {"type": "subtitle", "time": 2463.15, "timestamp": "00:41:03", "text": "君たちは何をしゃべっているんだ？"}, {"type": "subtitle", "time": 2470.51, "timestamp": "00:41:10", "text": "より安い"}, {"type": "subtitle", "time": 2473.589, "timestamp": "00:41:13", "text": "墓？でも今は、とても。彼らは手に入れた"}, {"type": "subtitle", "time": 2477.27, "timestamp": "00:41:17", "text": "３人のヒーラーだ。ケツ野郎。それを"}, {"type": "subtitle", "time": 2480.309, "timestamp": "00:41:20", "text": "車両が再び動き出した。続けて。私たちは"}, {"type": "subtitle", "time": 2506.47, "timestamp": "00:41:46", "text": "手に汗握るゲームプレイ。"}]
[{"type": "subtitle", "time": 8340.469, "timestamp": "02:19:00", "text": "治癒できるなら、何の意味があるの？"}, {"type": "subtitle", "time": 8343.589, "timestamp": "02:19:03", "text": "ヒーラーを雇っているのですか？"}, {"type": "subtitle", "time": 8345.79, "timestamp": "02:19:05", "text": "ええと、それは"}, {"type": "subtitle", "time": 8348.87, "timestamp": "02:19:08", "text": "唾を吐いているのはあなたです。あなたは"}, {"type": "subtitle", "time": 8351.11, "timestamp": "02:19:11", "text": "唾を吐く。その通り。だから私は"}, {"type": "subtitle", "time": 8354.95, "timestamp": "02:19:14", "text": "オーバーウォッチ1とオーバーウォッチ2が嫌いです"}, {"type": "subtitle", "time": 8357.669, "timestamp": "02:19:17", "text": "マーベルSPライバルズが大好きなんです。"}, {"type": "subtitle", "time": 8360.389, "timestamp": "02:19:20", "text": "基本的にはオーバーウォッチ版ですね。"}, {"type": "subtitle", "time": 8363.429, "timestamp": "02:19:23", "text": "うん。ああ、それは狂気だ。でも私はそうは思わない"}, {"type": "subtitle", "time": 8365.429, "timestamp": "02:19:25", "text": "わかってるよ、相棒。唯一気に入らない点"}, {"type": "subtitle", "time": 8367.91, "timestamp": "02:19:27", "text": "このゲームについて言えば、狂った人たちが"}, {"type": "subtitle", "time": 8369.83, "timestamp": "02:19:29", "text": "得る。"}, {"type": "subtitle", "time": 8372.629, "timestamp": "02:19:32", "text": "私がクソ愛しているとき、私を見てみるべきだよ。"}, {"type": "subtitle", "time": 8374.629, "timestamp": "02:19:34", "text": "特にこの地図上では。ああ、私は嫌いだ"}, {"type": "subtitle", "time": 8378.15, "timestamp": "02:19:38", "text": "この地図。このマップのせいでFPSのプレイがめちゃくちゃになる。"}, {"type": "subtitle", "time": 8379.99, "timestamp": "02:19:39", "text": "ええと、正直に言うと、"}, {"type": "subtitle", "time": 8382.87, "timestamp": "02:19:42", "text": "この地図は、そこから発展していったものだ。"}, {"type": "subtitle", "time": 8385.83, "timestamp": "02:19:45", "text": "私も最初から嫌いでした"}, {"type": "subtitle", "time": 8387.75, "timestamp": "02:19:47", "text": "季節。私もこれが嫌いだったけど、"}, {"type": "subtitle", "time": 8389.99, "timestamp": "02:19:49", "text": "でも、確かに、だんだん慣れていったよ。私"}, {"type": "subtitle", "time": 8391.75, "timestamp": "02:19:51", "text": "今でも嫌いだ。たくさんあります"}, {"type": "subtitle", "time": 8393.429, "timestamp": "02:19:53", "text": "隠れることができる隅っこや隙間。"}, {"type": "subtitle", "time": 8397.03, "timestamp": "02:19:57", "text": "もう一方。ご存知の通り、"}]
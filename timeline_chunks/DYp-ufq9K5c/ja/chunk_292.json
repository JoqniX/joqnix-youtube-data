[{"type": "subtitle", "time": 17521.43, "timestamp": "04:52:01", "text": "人々が参加する場合"}, {"type": "subtitle", "time": 17524.47, "timestamp": "04:52:04", "text": "私がそうするたびに、あなたが共有する"}, {"type": "subtitle", "time": 17538.11, "timestamp": "04:52:18", "text": "ああ"}, {"type": "subtitle", "time": 17541.04, "timestamp": "04:52:21", "text": "新しい広告"}, {"type": "subtitle", "time": 17542.59, "timestamp": "04:52:22", "text": "[音楽]"}, {"type": "subtitle", "time": 17544.67, "timestamp": "04:52:24", "text": "アドベンチャー"}, {"type": "subtitle", "time": 17546.43, "timestamp": "04:52:26", "text": "する"}, {"type": "subtitle", "time": 17550.91, "timestamp": "04:52:30", "text": "はい、公開パスワードは表示されません"}, {"type": "subtitle", "time": 17554.23, "timestamp": "04:52:34", "text": "パスワードとして入力するのを知らない。"}, {"type": "subtitle", "time": 17562.39, "timestamp": "04:52:42", "text": "それは追加されるようなもの"}, {"type": "subtitle", "time": 17565.91, "timestamp": "04:52:45", "text": "今私がプレイしているもの"}, {"type": "subtitle", "time": 17568.39, "timestamp": "04:52:48", "text": "追加されると思います。"}, {"type": "subtitle", "time": 17572.708, "timestamp": "04:52:52", "text": "私が参加するカードのオフラインスターター。おお"}, {"type": "subtitle", "time": 17574.75, "timestamp": "04:52:54", "text": "それは"}, {"type": "subtitle", "time": 17578.59, "timestamp": "04:52:58", "text": "いいね。私は変更できますか"}]
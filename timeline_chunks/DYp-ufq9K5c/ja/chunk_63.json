[{"type": "subtitle", "time": 3787.71, "timestamp": "01:03:07", "text": "ああ、魔法もあるよ、だって彼は"}, {"type": "subtitle", "time": 3789.99, "timestamp": "01:03:09", "text": "ああ、これは憂鬱になりそうだ"}, {"type": "subtitle", "time": 3803.91, "timestamp": "01:03:23", "text": "わかった。近接戦闘キャラクター。ああ、あのね"}, {"type": "subtitle", "time": 3820.87, "timestamp": "01:03:40", "text": "おい、このビッグルンを見てみろよ。"}, {"type": "subtitle", "time": 3836.63, "timestamp": "01:03:56", "text": "君の力は私のものだ。私は死にかけた。彼女"}, {"type": "subtitle", "time": 3838.47, "timestamp": "01:03:58", "text": "死にかけた。"}]
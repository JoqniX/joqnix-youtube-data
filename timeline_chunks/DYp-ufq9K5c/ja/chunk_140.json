[{"type": "subtitle", "time": 8400.389, "timestamp": "02:20:00", "text": "鎖とかそういうのがあるんだよ"}, {"type": "subtitle", "time": 8407.99, "timestamp": "02:20:07", "text": "知っている。それはまるで長すぎる"}, {"type": "subtitle", "time": 8410.55, "timestamp": "02:20:10", "text": "透明な側面とクソみたいなああ、それらは"}, {"type": "subtitle", "time": 8413.03, "timestamp": "02:20:13", "text": "隠れるのに適した奇妙な隙間や窪み"}, {"type": "subtitle", "time": 8435.03, "timestamp": "02:20:35", "text": "オフィスに魔法がやってきた。"}, {"type": "subtitle", "time": 8437.309, "timestamp": "02:20:37", "text": "ああ、大変だ。"}, {"type": "subtitle", "time": 8440.55, "timestamp": "02:20:40", "text": "おお。ああ、わかりました。"}, {"type": "subtitle", "time": 8444.15, "timestamp": "02:20:44", "text": "実際にはスポーン地点の内側です。おお。"}, {"type": "subtitle", "time": 8447.349, "timestamp": "02:20:47", "text": "どういたしまして。"}, {"type": "subtitle", "time": 8448.349, "timestamp": "02:20:48", "text": "そしてこれら"}, {"type": "subtitle", "time": 8450.309, "timestamp": "02:20:50", "text": "ヒーラーたちは、どんどん愚かになってきている。私たちの"}, {"type": "subtitle", "time": 8452.95, "timestamp": "02:20:52", "text": "ヒーラーが2分くらい目を離す"}]
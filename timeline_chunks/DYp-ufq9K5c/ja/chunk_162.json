[{"type": "subtitle", "time": 9720.27, "timestamp": "02:42:00", "text": "いいえ、彼は既に切り替えました。うん、"}, {"type": "subtitle", "time": 9722.23, "timestamp": "02:42:02", "text": "その通り。彼は切り替えることができる。だから私は"}, {"type": "subtitle", "time": 9724.07, "timestamp": "02:42:04", "text": "知ってたよ、俺はクソヤリとするつもりだったんだ。あ、こんにちは"}, {"type": "subtitle", "time": 9728.23, "timestamp": "02:42:08", "text": "そこには。ああ、こんにちは、相棒。"}, {"type": "subtitle", "time": 9746.389, "timestamp": "02:42:26", "text": "ああ、支配があるんだな。よし。"}, {"type": "subtitle", "time": 9752.95, "timestamp": "02:42:32", "text": "ウルヴァリンが2人いるぜ、おい。小さな虫たちが"}, {"type": "subtitle", "time": 9756.469, "timestamp": "02:42:36", "text": "兄弟とクレイジーな時間を過ごしている。一体どういうことだ？"}, {"type": "subtitle", "time": 9757.99, "timestamp": "02:42:37", "text": "何だって？"}, {"type": "subtitle", "time": 9759.99, "timestamp": "02:42:39", "text": "[音楽]"}, {"type": "subtitle", "time": 9762.55, "timestamp": "02:42:42", "text": "おい、俺は詐欺に遭ったんだ。"}, {"type": "subtitle", "time": 9764.95, "timestamp": "02:42:44", "text": "ああ、そういうことなんだよ。彼らはいた"}, {"type": "subtitle", "time": 9767.75, "timestamp": "02:42:47", "text": "全員です。一発撃て。ここに来て。"}, {"type": "subtitle", "time": 9775.91, "timestamp": "02:42:55", "text": "ただ光を受け入れなさい。ついに手に入れることができる"}, {"type": "subtitle", "time": 9777.67, "timestamp": "02:42:57", "text": "ああ、しまった、マウスが。くそ。どうしたの"}]
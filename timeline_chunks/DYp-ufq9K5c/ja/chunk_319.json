[{"type": "subtitle", "time": 19142.07, "timestamp": "05:19:02", "text": "爆発した。わかった。ああ、つまりあなたは私に"}, {"type": "subtitle", "time": 19144.47, "timestamp": "05:19:04", "text": "そうするべきです。"}, {"type": "subtitle", "time": 19146.948, "timestamp": "05:19:06", "text": "えーっと、準備は早くして、えーっと、続けて"}, {"type": "subtitle", "time": 19150.868, "timestamp": "05:19:10", "text": "探検して後で戻ってきて"}, {"type": "subtitle", "time": 19157.27, "timestamp": "05:19:17", "text": "ガッチャ。重要なこと、といった感じ。そしてもしあなたが"}, {"type": "subtitle", "time": 19161.07, "timestamp": "05:19:21", "text": "もっとリソースが必要なら、私は行くことができます"}, {"type": "subtitle", "time": 19164.628, "timestamp": "05:19:24", "text": "探索しながら、"}, {"type": "subtitle", "time": 19170.47, "timestamp": "05:19:30", "text": "ガッチャ。うん。"}, {"type": "subtitle", "time": 19194.59, "timestamp": "05:19:54", "text": "木。一部の武器は耐久性がなく、切断できません。"}, {"type": "subtitle", "time": 19196.67, "timestamp": "05:19:56", "text": "おお。または"}]
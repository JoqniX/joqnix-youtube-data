[{"type": "subtitle", "time": 15851.309, "timestamp": "04:24:11", "text": "ああ、なんてことだ。何が"}, {"type": "subtitle", "time": 15867.11, "timestamp": "04:24:27", "text": "埃。何てことだ。これは潜水艦ですか、それとも"}, {"type": "subtitle", "time": 15874.229, "timestamp": "04:24:34", "text": "船？これは未来的な船のように見える。"}, {"type": "subtitle", "time": 15877.51, "timestamp": "04:24:37", "text": "兄弟。何てことだ。これは何ですか？原子炉"}, {"type": "subtitle", "time": 15879.469, "timestamp": "04:24:39", "text": "種の"}, {"type": "subtitle", "time": 15882.95, "timestamp": "04:24:42", "text": "もの。これらのものは、"}, {"type": "subtitle", "time": 15885.309, "timestamp": "04:24:45", "text": "装飾品だが、武器のように見えるし"}, {"type": "subtitle", "time": 15892.389, "timestamp": "04:24:52", "text": "聖なる。何てことだ。ガラスを見てください。見て"}, {"type": "subtitle", "time": 15895.59, "timestamp": "04:24:55", "text": "あらゆる高級品において。そこには"}]
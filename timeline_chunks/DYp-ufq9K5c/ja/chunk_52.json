[{"type": "subtitle", "time": 3120.069, "timestamp": "00:52:00", "text": "これです。"}, {"type": "subtitle", "time": 3128.43, "timestamp": "00:52:08", "text": "私は"}, {"type": "subtitle", "time": 3131.87, "timestamp": "00:52:11", "text": "死んだ。バダビン、バダ"}, {"type": "subtitle", "time": 3134.71, "timestamp": "00:52:14", "text": "ブーム。よし、アイアンマンとサイロックだ。私たちは"}, {"type": "subtitle", "time": 3138.15, "timestamp": "00:52:18", "text": "サイロックに関しては、何も持っていません。わかった、"}, {"type": "subtitle", "time": 3139.829, "timestamp": "00:52:19", "text": "サイロックには何もなかったが、キャップは"}, {"type": "subtitle", "time": 3142.549, "timestamp": "00:52:22", "text": "それもまた迷惑なことになりそうだ。だから、私は行く"}, {"type": "subtitle", "time": 3146.95, "timestamp": "00:52:26", "text": "鉄拳制裁を下す。なぜですか？なぜなら私たちの"}, {"type": "subtitle", "time": 3150.549, "timestamp": "00:52:30", "text": "ルナ・スノーは何も持っていません。彼女はとても"}, {"type": "subtitle", "time": 3154.23, "timestamp": "00:52:34", "text": "よかったね、ただ自分の身を守っただけさ。"}, {"type": "subtitle", "time": 3167.51, "timestamp": "00:52:47", "text": "あ、ゲームが少しカクカクした。私は違います"}, {"type": "subtitle", "time": 3171.75, "timestamp": "00:52:51", "text": "嘘をつくつもりだ。ゲームが少しカクカクした。"}, {"type": "subtitle", "time": 3173.43, "timestamp": "00:52:53", "text": "組み立てる"}, {"type": "subtitle", "time": 3175.91, "timestamp": "00:52:55", "text": "私のものは設置済みです。鉄拳は依然として"}, {"type": "subtitle", "time": 3178.63, "timestamp": "00:52:58", "text": "火傷。"}]
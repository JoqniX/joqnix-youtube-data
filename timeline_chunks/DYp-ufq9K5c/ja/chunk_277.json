[{"type": "subtitle", "time": 16620.029, "timestamp": "04:37:00", "text": "私が最後に使う船。"}, {"type": "subtitle", "time": 16626.31, "timestamp": "04:37:06", "text": "ああ。私はこのタイタニック号を見てみたいんです。"}, {"type": "subtitle", "time": 16628.789, "timestamp": "04:37:08", "text": "小さく見えるけど中は"}, {"type": "subtitle", "time": 16642.47, "timestamp": "04:37:22", "text": "わかった。待って、底はどこ？"}, {"type": "subtitle", "time": 16645.269, "timestamp": "04:37:25", "text": "収納スペースとか何か？それは単純な"}, {"type": "subtitle", "time": 16652.709, "timestamp": "04:37:32", "text": "そうみたいだ。おお。では、これはどうでしょうか？"}, {"type": "subtitle", "time": 16655.429, "timestamp": "04:37:35", "text": "この紫色のやつは高級感があるね。なぜ"}, {"type": "subtitle", "time": 16659.869, "timestamp": "04:37:39", "text": "緑みたいなレアリティみたいなもの"}, {"type": "subtitle", "time": 16662.551, "timestamp": "04:37:42", "text": "紫とかそういう感じ？それは依存するようなものですか"}, {"type": "subtitle", "time": 16669.39, "timestamp": "04:37:49", "text": "は？"}]
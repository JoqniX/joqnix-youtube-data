[{"type": "subtitle", "time": 17642.27, "timestamp": "04:54:02", "text": "[音楽]"}, {"type": "subtitle", "time": 17646.03, "timestamp": "04:54:06", "text": "衣装。しかし、ホスティング共有"}, {"type": "subtitle", "time": 17650.23, "timestamp": "04:54:10", "text": "ゲームでは200MB、"}, {"type": "subtitle", "time": 17653.31, "timestamp": "04:54:13", "text": "300 MB、500"}, {"type": "subtitle", "time": 17657.23, "timestamp": "04:54:17", "text": "MB。何？あれは何だ？待って。"}, {"type": "subtitle", "time": 17660.43, "timestamp": "04:54:20", "text": "ホスティング。黙れ。そこには"}, {"type": "subtitle", "time": 17663.83, "timestamp": "04:54:23", "text": "ゲームレンダリングシャワーアクティブ1つ"}, {"type": "subtitle", "time": 17667.43, "timestamp": "04:54:27", "text": "三つ。えっと、何をクリックしたんだろう？待って、"}, {"type": "subtitle", "time": 17671.35, "timestamp": "04:54:31", "text": "私は何をしたの？設定しました。ええ、私は"}, {"type": "subtitle", "time": 17674.788, "timestamp": "04:54:34", "text": "これです。あ、待って。今、怖いです。"}, {"type": "subtitle", "time": 17678.35, "timestamp": "04:54:38", "text": "ゲームを共有する。はい、見せてください"}, {"type": "subtitle", "time": 17689.27, "timestamp": "04:54:49", "text": "えっと、シェアゲームは簡単に言うと、人です"}, {"type": "subtitle", "time": 17690.948, "timestamp": "04:54:50", "text": "あなたも誰でもプレイできるゲーム"}, {"type": "subtitle", "time": 17692.948, "timestamp": "04:54:52", "text": "いつでも、誰かが"}, {"type": "subtitle", "time": 17694.948, "timestamp": "04:54:54", "text": "ホスティングを呼び出すかどうか。基本的に"}, {"type": "subtitle", "time": 17696.708, "timestamp": "04:54:56", "text": "専用サーバーを運用するメリット"}, {"type": "subtitle", "time": 17698.39, "timestamp": "04:54:58", "text": "実際に走ったり支払ったりせずに"}]
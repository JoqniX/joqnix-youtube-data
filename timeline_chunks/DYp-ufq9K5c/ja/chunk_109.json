[{"type": "subtitle", "time": 6542.629, "timestamp": "01:49:02", "text": "壁を壊せばいい。"}, {"type": "subtitle", "time": 6549.51, "timestamp": "01:49:09", "text": "ああ、彼は武装していて危険だ"}, {"type": "subtitle", "time": 6552.709, "timestamp": "01:49:12", "text": "方法。彼は一発撃たれて、これは"}, {"type": "subtitle", "time": 6563.109, "timestamp": "01:49:23", "text": "ちなみに、あのホークアイのスキン、すごく気に入ってるよ。"}, {"type": "subtitle", "time": 6565.83, "timestamp": "01:49:25", "text": "あれが一番好きです。新しいやつ。いいえ、"}, {"type": "subtitle", "time": 6573.83, "timestamp": "01:49:33", "text": "わかった。うん。"}, {"type": "subtitle", "time": 6576.87, "timestamp": "01:49:36", "text": "まるでコミックに忠実なスキンみたいだ。大好きです"}, {"type": "subtitle", "time": 6578.39, "timestamp": "01:49:38", "text": "1つ。"}, {"type": "subtitle", "time": 6580.149, "timestamp": "01:49:40", "text": "漫画ではメガネをかけていなかった"}, {"type": "subtitle", "time": 6582.87, "timestamp": "01:49:42", "text": "正確な。何？なんてこった。彼は来た"}, {"type": "subtitle", "time": 6585.189, "timestamp": "01:49:45", "text": "私の中に、そうでもない。私は誰を殺したのか？それ"}, {"type": "subtitle", "time": 6587.109, "timestamp": "01:49:47", "text": "アベンジャーズのテレビ番組の1つで、"}, {"type": "subtitle", "time": 6589.75, "timestamp": "01:49:49", "text": "彼が眼鏡をかけていた漫画"}, {"type": "subtitle", "time": 6592.31, "timestamp": "01:49:52", "text": "そして、短い髪。あれ、大好きです。私"}, {"type": "subtitle", "time": 6594.149, "timestamp": "01:49:54", "text": "つまり、それが基本的に彼の見た目です"}, {"type": "subtitle", "time": 6595.91, "timestamp": "01:49:55", "text": "映画もそうですよね？短い髪"}, {"type": "subtitle", "time": 6598.55, "timestamp": "01:49:58", "text": "そして全て。ああ、彼が来る"}]
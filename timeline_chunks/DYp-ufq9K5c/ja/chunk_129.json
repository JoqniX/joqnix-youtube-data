[{"type": "subtitle", "time": 7742.55, "timestamp": "02:09:02", "text": "やるべきことは、任務区域を制圧することだ。おお、"}, {"type": "subtitle", "time": 7752.069, "timestamp": "02:09:12", "text": "このブーツ、なかなかイケてるよね？"}, {"type": "subtitle", "time": 7756.95, "timestamp": "02:09:16", "text": "出身はどちらですか？私たちはどこから来たのか？"}, {"type": "subtitle", "time": 7759.35, "timestamp": "02:09:19", "text": "私たちはインド出身です。私は自分が"}, {"type": "subtitle", "time": 7761.51, "timestamp": "02:09:21", "text": "そうそう。君は、そうだ、彼は"}, {"type": "subtitle", "time": 7763.51, "timestamp": "02:09:23", "text": "インドも同様です。その通り。私たちは"}, {"type": "subtitle", "time": 7770.149, "timestamp": "02:09:30", "text": "ああ、これでいい。任務は"}, {"type": "subtitle", "time": 7772.39, "timestamp": "02:09:32", "text": "そのエリアはあなたのものです。 5人"}, {"type": "subtitle", "time": 7775.83, "timestamp": "02:09:35", "text": "今、ビリーの番組を見てるよ。私"}, {"type": "subtitle", "time": 7778.709, "timestamp": "02:09:38", "text": "ようやく面白くなってきた。ちくしょう。"}, {"type": "subtitle", "time": 7781.589, "timestamp": "02:09:41", "text": "あなたは素晴らしい人だと知っています"}, {"type": "subtitle", "time": 7785.51, "timestamp": "02:09:45", "text": "えーと、"}, {"type": "subtitle", "time": 7787.83, "timestamp": "02:09:47", "text": "ああ、彼は死んだんだ。あのね？私はできません"}, {"type": "subtitle", "time": 7789.669, "timestamp": "02:09:49", "text": "偽の褒め言葉を真剣に考えてみてください。それで、"}, {"type": "subtitle", "time": 7796.95, "timestamp": "02:09:56", "text": "ごめんなさい。なぜマーベルと書いてあるのか"}]
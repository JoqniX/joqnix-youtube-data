[{"type": "subtitle", "time": 13273.63, "timestamp": "03:41:13", "text": "詳細。つまり、このドロップオーバーのことですか？"}, {"type": "subtitle", "time": 13276.15, "timestamp": "03:41:16", "text": "ここ？大丈夫です。わかったと思う"}, {"type": "subtitle", "time": 13296.269, "timestamp": "03:41:36", "text": "ボートのことが理解できない。"}, {"type": "subtitle", "time": 13300.15, "timestamp": "03:41:40", "text": "分かるよ"}, {"type": "subtitle", "time": 13302.71, "timestamp": "03:41:42", "text": "えっと、引っ越すんですが、どうやって処分すればいいですか？"}, {"type": "subtitle", "time": 13306.55, "timestamp": "03:41:46", "text": "アドベンチャーセールってやつ？私は欲しい"}, {"type": "subtitle", "time": 13310.07, "timestamp": "03:41:50", "text": "残りの部分で私を導くチュートリアル"}, {"type": "subtitle", "time": 13311.79, "timestamp": "03:41:51", "text": "ゲーム、"}, {"type": "subtitle", "time": 13315.19, "timestamp": "03:41:55", "text": "しかし、うまく機能していないようだ"}]
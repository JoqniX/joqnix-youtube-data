[{"type": "subtitle", "time": 16682.429, "timestamp": "04:38:02", "text": "なんてこった。大砲と"}, {"type": "subtitle", "time": 16685.31, "timestamp": "04:38:05", "text": "もの。わあ！見てください"}, {"type": "subtitle", "time": 16688.429, "timestamp": "04:38:08", "text": "マスト。これは"}, {"type": "subtitle", "time": 16691.029, "timestamp": "04:38:11", "text": "ターゲット。戦艦。はい、確認します"}, {"type": "subtitle", "time": 16698.39, "timestamp": "04:38:18", "text": "戦艦。大好きです。彼らは私たちに"}, {"type": "subtitle", "time": 16703.83, "timestamp": "04:38:23", "text": "19世紀の戦艦。聖なる戦士"}, {"type": "subtitle", "time": 16705.15, "timestamp": "04:38:25", "text": "戦艦。"}, {"type": "subtitle", "time": 16707.47, "timestamp": "04:38:27", "text": "待って、待って、待って、待って。これは"}, {"type": "subtitle", "time": 16710.269, "timestamp": "04:38:30", "text": "クレイジー。蒸気戦艦。"}, {"type": "subtitle", "time": 16712.75, "timestamp": "04:38:32", "text": "待って。ああ、これも"}, {"type": "subtitle", "time": 16717.029, "timestamp": "04:38:37", "text": "ファンシー。これです。戦艦01. バージョン"}, {"type": "subtitle", "time": 16718.51, "timestamp": "04:38:38", "text": "01."}, {"type": "subtitle", "time": 16739.749, "timestamp": "04:38:59", "text": "それで"}]
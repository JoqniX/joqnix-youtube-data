[{"type": "subtitle", "time": 8881.11, "timestamp": "02:28:01", "text": "三つ。"}, {"type": "subtitle", "time": 8882.75, "timestamp": "02:28:02", "text": "私は行きます"}, {"type": "subtitle", "time": 8889.67, "timestamp": "02:28:09", "text": "エマ・フロストならできると思うでしょ、"}, {"type": "subtitle", "time": 8891.59, "timestamp": "02:28:11", "text": "彼女はテレパシー能力者ですよね？彼女は"}, {"type": "subtitle", "time": 8893.75, "timestamp": "02:28:13", "text": "心だけで人を同性愛者にすることができる"}, {"type": "subtitle", "time": 8896.71, "timestamp": "02:28:16", "text": "コントロール？"}, {"type": "subtitle", "time": 8901.71, "timestamp": "02:28:21", "text": "何てことだ。彼は"}, {"type": "subtitle", "time": 8904.71, "timestamp": "02:28:24", "text": "ただのスープレックス？ええ、私が作ったんです。"}, {"type": "subtitle", "time": 8907.83, "timestamp": "02:28:27", "text": "ええ、そうしました。"}, {"type": "subtitle", "time": 8916.15, "timestamp": "02:28:36", "text": "ヒーラー。彼女は、何の見返りもなく、たくさんの損害を与えている。"}, {"type": "subtitle", "time": 8919.91, "timestamp": "02:28:39", "text": "理由。つまり、あなたはそうするんです。彼女はオメガです"}, {"type": "subtitle", "time": 8927.71, "timestamp": "02:28:47", "text": "私はエマ・フロストが大好きです。正直言って、私はどんな"}, {"type": "subtitle", "time": 8930.95, "timestamp": "02:28:50", "text": "第二の突然変異のような変異体。彼らは"}, {"type": "subtitle", "time": 8938.71, "timestamp": "02:28:58", "text": "そして霜もその一つだ。"}]
[{"type": "subtitle", "time": 7329.83, "timestamp": "02:02:09", "text": "おお、このスキンのMVPもかなりイケてるね。"}, {"type": "subtitle", "time": 7332.79, "timestamp": "02:02:12", "text": "それは良い。"}, {"type": "subtitle", "time": 7341.47, "timestamp": "02:02:21", "text": "男？"}, {"type": "subtitle", "time": 7345.229, "timestamp": "02:02:25", "text": "うん。うん。"}, {"type": "subtitle", "time": 7349.75, "timestamp": "02:02:29", "text": "わかった。いい感じですね。野蛮人"}, {"type": "subtitle", "time": 7354.03, "timestamp": "02:02:34", "text": "これは"}, {"type": "subtitle", "time": 7356.629, "timestamp": "02:02:36", "text": "SK。よし、始めよう"}, {"type": "subtitle", "time": 7358.39, "timestamp": "02:02:38", "text": "小便して戻ってきてください。わかった。全て"}, {"type": "subtitle", "time": 7360.95, "timestamp": "02:02:40", "text": "そうだよ、そうだね。それが何なのか、私は知っています。"}, {"type": "subtitle", "time": 7361.87, "timestamp": "02:02:41", "text": "私"}, {"type": "subtitle", "time": 7364.589, "timestamp": "02:02:44", "text": "えっと、"}, {"type": "subtitle", "time": 7372.55, "timestamp": "02:02:52", "text": "自分。とにかく、やあ、みんな。何ですか"}, {"type": "subtitle", "time": 7374.43, "timestamp": "02:02:54", "text": "何が起こっているの？そしてそれはあなたの"}, {"type": "subtitle", "time": 7377.07, "timestamp": "02:02:57", "text": "男の子"}]
[{"type": "subtitle", "time": 9360.63, "timestamp": "02:36:00", "text": "人生とプロとして富を築き繁栄する"}, {"type": "subtitle", "time": 9363.51, "timestamp": "02:36:03", "text": "そして健康。ありがとう。彼女は"}, {"type": "subtitle", "time": 9364.95, "timestamp": "02:36:04", "text": "英語を話せない。彼はただ"}, {"type": "subtitle", "time": 9366.99, "timestamp": "02:36:06", "text": "何かを翻訳する"}, {"type": "subtitle", "time": 9370.55, "timestamp": "02:36:10", "text": "韓国語。それはつまり、何か意味があるということだ。"}, {"type": "subtitle", "time": 9373.11, "timestamp": "02:36:13", "text": "中国人のように見える。いいえ、それは"}, {"type": "subtitle", "time": 9375.83, "timestamp": "02:36:15", "text": "韓国語。それは韓国語だよ、君。"}, {"type": "subtitle", "time": 9378.389, "timestamp": "02:36:18", "text": "あなたは私が人種差別主義者だと言っているのですか、それとも"}, {"type": "subtitle", "time": 9380.03, "timestamp": "02:36:20", "text": "あなたが人種差別主義者だと言うのですか？私は"}, {"type": "subtitle", "time": 9388.15, "timestamp": "02:36:28", "text": "アキレスのようなダイヤモンドの脛。"}, {"type": "subtitle", "time": 9390.71, "timestamp": "02:36:30", "text": "えっと"}, {"type": "subtitle", "time": 9393.67, "timestamp": "02:36:33", "text": "あなたはその信念を読んでいますか？"}, {"type": "subtitle", "time": 9396.87, "timestamp": "02:36:36", "text": "いや、いや、いや、いや、いや。えっと、読んでるだけ"}, {"type": "subtitle", "time": 9399.429, "timestamp": "02:36:39", "text": "二次突然変異に関する記事"}, {"type": "subtitle", "time": 9403.67, "timestamp": "02:36:43", "text": "X-メンで。おお。そうそう。ご存知のとおり"}, {"type": "subtitle", "time": 9407.63, "timestamp": "02:36:47", "text": "エマ・フロストは"}, {"type": "subtitle", "time": 9411.19, "timestamp": "02:36:51", "text": "彼女の主な突然変異はテレパシー能力である。"}, {"type": "subtitle", "time": 9413.99, "timestamp": "02:36:53", "text": "しかし数年後、彼女は二次的な"}, {"type": "subtitle", "time": 9416.07, "timestamp": "02:36:56", "text": "突然変異は第二の突然変異としても知られている"}, {"type": "subtitle", "time": 9419.11, "timestamp": "02:36:59", "text": "思春期にダイヤモンドのような肌を手に入れる"}]
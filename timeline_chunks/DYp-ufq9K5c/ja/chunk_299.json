[{"type": "subtitle", "time": 17941.11, "timestamp": "04:59:01", "text": "似たようなゲーム。わかりました、失礼します。"}, {"type": "subtitle", "time": 17943.75, "timestamp": "04:59:03", "text": "大丈夫だよ。これをテストしたい"}, {"type": "subtitle", "time": 17945.35, "timestamp": "04:59:05", "text": "外。"}, {"type": "subtitle", "time": 17946.35, "timestamp": "04:59:06", "text": "それは"}, {"type": "subtitle", "time": 17950.15, "timestamp": "04:59:10", "text": "オフライン。先に進んでもよろしいでしょうか？待って、"}, {"type": "subtitle", "time": 17952.59, "timestamp": "04:59:12", "text": "変更するにはどうすればいいですか"}, {"type": "subtitle", "time": 17956.59, "timestamp": "04:59:16", "text": "もの？私が何をしたにせよ。"}, {"type": "subtitle", "time": 17959.948, "timestamp": "04:59:19", "text": "えっと、編集できません"}, {"type": "subtitle", "time": 17967.91, "timestamp": "04:59:27", "text": "このリモートシング。削除したら、"}, {"type": "subtitle", "time": 17970.51, "timestamp": "04:59:30", "text": "私は失くす"}, {"type": "subtitle", "time": 17973.35, "timestamp": "04:59:33", "text": "世界？待って、もし私が"}, {"type": "subtitle", "time": 17975.51, "timestamp": "04:59:35", "text": "削除しますか？ああ神様、これはとても"}, {"type": "subtitle", "time": 17983.948, "timestamp": "04:59:43", "text": "本物。えっと、これはややこしいですね。もしも"}, {"type": "subtitle", "time": 17987.75, "timestamp": "04:59:47", "text": "待って、私が削除すると思いますか、待って、"}, {"type": "subtitle", "time": 17991.12, "timestamp": "04:59:51", "text": "私は怖いです。やめて、やめて、やめて、やめて"}, {"type": "subtitle", "time": 17996.67, "timestamp": "04:59:56", "text": "[音楽]"}]
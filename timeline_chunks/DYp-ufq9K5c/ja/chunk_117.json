[{"type": "subtitle", "time": 7027.91, "timestamp": "01:57:07", "text": "わかった。なぜ私の飼っているアライグマは後ろ向きに歩いているのですか？"}, {"type": "subtitle", "time": 7031.91, "timestamp": "01:57:11", "text": "彼が見えるかい？彼は接続を切断したのだと思う。"}, {"type": "subtitle", "time": 7033.589, "timestamp": "01:57:13", "text": "くそ。これが私たちが望む唯一のことです"}, {"type": "subtitle", "time": 7068.55, "timestamp": "01:57:48", "text": "アリス、私は大きな手を握るわ"}, {"type": "subtitle", "time": 7076.149, "timestamp": "01:57:56", "text": "私たちはそうできるから、私はより良い人間になる。"}, {"type": "subtitle", "time": 7078.629, "timestamp": "01:57:58", "text": "これは最小限のゲームです。あの人たちは"}]
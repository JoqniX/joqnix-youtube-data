[{"type": "subtitle", "time": 14167.63, "timestamp": "03:56:07", "text": "非常に多くの種類の"}, {"type": "subtitle", "time": 14170.95, "timestamp": "03:56:10", "text": "もの。これが今のクラフトだ。じゃあ待って、"}, {"type": "subtitle", "time": 14188.51, "timestamp": "03:56:28", "text": "殺す、殺す"}, {"type": "subtitle", "time": 14191.71, "timestamp": "03:56:31", "text": "殺してクランを結成する"}, {"type": "subtitle", "time": 14195.99, "timestamp": "03:56:35", "text": "クラン、クラン、あるいはこれが何であれ。以来"}, {"type": "subtitle", "time": 14198.469, "timestamp": "03:56:38", "text": "これには砂が必要だと思う。"}, {"type": "subtitle", "time": 14200.67, "timestamp": "03:56:40", "text": "我々がそうする方が良い"}, {"type": "subtitle", "time": 14205.189, "timestamp": "03:56:45", "text": "それ。右上隅の緑色の四角。はい、"}, {"type": "subtitle", "time": 14206.11, "timestamp": "03:56:46", "text": "置く"}, {"type": "subtitle", "time": 14207.83, "timestamp": "03:56:47", "text": "製油所"}, {"type": "subtitle", "time": 14209.55, "timestamp": "03:56:49", "text": "[音楽]"}, {"type": "subtitle", "time": 14216.469, "timestamp": "03:56:56", "text": "ここ。それらをあなたのshに載せることができます。何？"}]
[{"type": "subtitle", "time": 782.069, "timestamp": "00:13:02", "text": "休暇を取って、それら全てをキャンセルしました。"}, {"type": "subtitle", "time": 784.069, "timestamp": "00:13:04", "text": "なぜ？なぜ？"}, {"type": "subtitle", "time": 787.75, "timestamp": "00:13:07", "text": "だって私は「大丈夫だよ」って思ったから。"}, {"type": "subtitle", "time": 792.59, "timestamp": "00:13:12", "text": "配信をやらなきゃ。うん、"}, {"type": "subtitle", "time": 796.47, "timestamp": "00:13:16", "text": "ストリーム。君の配信を見なきゃ。神"}, {"type": "subtitle", "time": 799.35, "timestamp": "00:13:19", "text": "この男、本当にひどい。休暇に出かけましょう。くそ"}, {"type": "subtitle", "time": 801.11, "timestamp": "00:13:21", "text": "地獄。"}, {"type": "subtitle", "time": 807.75, "timestamp": "00:13:27", "text": "この国をずっと見ることはないでしょう"}, {"type": "subtitle", "time": 812.31, "timestamp": "00:13:32", "text": "どのくらいの期間ですか？ 1年くらいかな。 2年。"}, {"type": "subtitle", "time": 814.629, "timestamp": "00:13:34", "text": "2年。そしてあなたは楽しみたくない"}, {"type": "subtitle", "time": 816.15, "timestamp": "00:13:36", "text": "それ。あなたはただ座りたいだけです"}, {"type": "subtitle", "time": 819.67, "timestamp": "00:13:39", "text": "コンピューターとストリーミング。さあ、行こう。我々はできる"}, {"type": "subtitle", "time": 823.509, "timestamp": "00:13:43", "text": "もっと頑張れ。来る。"}, {"type": "subtitle", "time": 825.35, "timestamp": "00:13:45", "text": "あなたはこれを見逃すことになるよ。ミスのように"}, {"type": "subtitle", "time": 826.83, "timestamp": "00:13:46", "text": "すべて。"}, {"type": "subtitle", "time": 828.55, "timestamp": "00:13:48", "text": "[音楽]"}, {"type": "subtitle", "time": 832.11, "timestamp": "00:13:52", "text": "来て。時間を割いて"}, {"type": "subtitle", "time": 836.069, "timestamp": "00:13:56", "text": "例えば、ただ散歩に出かけるとか。ほら、私は"}, {"type": "subtitle", "time": 838.15, "timestamp": "00:13:58", "text": "こんなに長い間散歩をしていない"}]
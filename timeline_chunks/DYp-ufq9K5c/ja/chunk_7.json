[{"type": "subtitle", "time": 420.79, "timestamp": "00:07:00", "text": "ニース。ゆっくり休んでね、D。リラックスして。"}, {"type": "subtitle", "time": 425.43, "timestamp": "00:07:05", "text": "午後のティータイム。あれはDですか？神"}, {"type": "subtitle", "time": 426.749, "timestamp": "00:07:06", "text": "くそ。それは"}, {"type": "subtitle", "time": 433.309, "timestamp": "00:07:13", "text": "画面上のDだよ、男。ああ、なんてことだ。"}, {"type": "chat", "time": 435.74, "timestamp": "00:07:15", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "Dinesh herer"}, {"type": "subtitle", "time": 436.55, "timestamp": "00:07:16", "text": "D. おいおい、頼むよ。 Dを積み上げます。なぜ"}, {"type": "subtitle", "time": 452.71, "timestamp": "00:07:32", "text": "うん。まあ、ジョーは長くは滞在しないだろう"}, {"type": "subtitle", "time": 461.51, "timestamp": "00:07:41", "text": "はい。はい。はい。待って。"}, {"type": "subtitle", "time": 465.029, "timestamp": "00:07:45", "text": "ライバルズのプレイヤー。"}, {"type": "subtitle", "time": 468.79, "timestamp": "00:07:48", "text": "彼が私たちに加わることはできないと思います。以上です"}, {"type": "subtitle", "time": 469.99, "timestamp": "00:07:49", "text": "それは素晴らしいことになりそうだ。しかし最後の"}, {"type": "subtitle", "time": 472.15, "timestamp": "00:07:52", "text": "彼が参加した時、私は4敗した"}, {"type": "subtitle", "time": 474.55, "timestamp": "00:07:54", "text": "連勝。彼が私が望んだかどうかはわかりません"}]
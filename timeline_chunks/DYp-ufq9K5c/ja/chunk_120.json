[{"type": "subtitle", "time": 7210.79, "timestamp": "02:00:10", "text": "ここに来て。ここに来て。"}, {"type": "subtitle", "time": 7212.229, "timestamp": "02:00:12", "text": "私たちは戦い続けなければならない"}, {"type": "subtitle", "time": 7219.91, "timestamp": "02:00:19", "text": "お願い、私たちは傷ついているんです。"}, {"type": "subtitle", "time": 7221.99, "timestamp": "02:00:21", "text": "もっと早く。"}, {"type": "subtitle", "time": 7228.709, "timestamp": "02:00:28", "text": "地獄が解き放たれる。"}, {"type": "subtitle", "time": 7237.589, "timestamp": "02:00:37", "text": "ああ、神様。わかった。私のロケットはあそこにある。"}, {"type": "subtitle", "time": 7246.629, "timestamp": "02:00:46", "text": "定義なぜ私たちは遮蔽物に隠れていないのですか？なぜなら私たちは"}, {"type": "subtitle", "time": 7248.43, "timestamp": "02:00:48", "text": "残業なし"}, {"type": "subtitle", "time": 7255.709, "timestamp": "02:00:55", "text": "悲しい。それは"}]
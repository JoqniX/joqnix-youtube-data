[{"type": "subtitle", "time": 2706.71, "timestamp": "00:45:06", "text": "何？アイアンマン。"}, {"type": "subtitle", "time": 2709.109, "timestamp": "00:45:09", "text": "最大。"}, {"type": "subtitle", "time": 2712.069, "timestamp": "00:45:12", "text": "まったく。また殺された。"}, {"type": "subtitle", "time": 2731.19, "timestamp": "00:45:31", "text": "こんにちは。喜んで協力します。"}, {"type": "subtitle", "time": 2733.75, "timestamp": "00:45:33", "text": "やあ、みんな、エマ、オルタナティブ。エマ、別バージョン。エマ、"}, {"type": "subtitle", "time": 2736.23, "timestamp": "00:45:36", "text": "代替。エマ、エマ、エマ、オルタナティブ。ああ、決して"}, {"type": "subtitle", "time": 2737.75, "timestamp": "00:45:37", "text": "心。我々は勝っている。ああ、私たちは決して"}, {"type": "subtitle", "time": 2748.309, "timestamp": "00:45:48", "text": "さあ、行こう。彼には当たらない。私の兄弟"}, {"type": "subtitle", "time": 2755.829, "timestamp": "00:45:55", "text": "コントロール。えっと、彼を殴らないで。おいおい、頼むよ。"}, {"type": "subtitle", "time": 2757.27, "timestamp": "00:45:57", "text": "これらのものは跳ね返される。はい、彼らは"}]
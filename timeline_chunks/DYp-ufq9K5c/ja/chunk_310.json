[{"type": "subtitle", "time": 18609.35, "timestamp": "05:10:09", "text": "家具用コンテナ。ああ、胸と"}, {"type": "subtitle", "time": 18612.23, "timestamp": "05:10:12", "text": "樽。わかった。在庫銃。ええ、"}, {"type": "subtitle", "time": 18615.67, "timestamp": "05:10:15", "text": "石製のものを一つ、ついさっき手に入れた。わかった。石の塊"}, {"type": "subtitle", "time": 18620.19, "timestamp": "05:10:20", "text": "それから。わかった。私は石を扱えると思う"}, {"type": "subtitle", "time": 18627.67, "timestamp": "05:10:27", "text": "かたまり。それは大理石です。石の塊は"}, {"type": "subtitle", "time": 18634.07, "timestamp": "05:10:34", "text": "まずは黒曜石の道具を作る必要がある。おお"}, {"type": "subtitle", "time": 18648.868, "timestamp": "05:10:48", "text": "今、私たちは苦痛を感じ、そして死ぬことができる。構築できます"}]
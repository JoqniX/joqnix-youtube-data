[{"type": "subtitle", "time": 4201.99, "timestamp": "01:10:01", "text": "ストリームが好きであるべきまたは"}, {"type": "subtitle", "time": 4204.99, "timestamp": "01:10:04", "text": "何か。ああ、そうだね。来る"}, {"type": "subtitle", "time": 4209.03, "timestamp": "01:10:09", "text": "の上。 「ちくしょう」なんて言わないで。来て。知っている"}, {"type": "subtitle", "time": 4212.11, "timestamp": "01:10:12", "text": "私は元気ですが、"}, {"type": "subtitle", "time": 4215.35, "timestamp": "01:10:15", "text": "グレージング。ああ、そろそろ変化をつける時だ。"}, {"type": "subtitle", "time": 4223.11, "timestamp": "01:10:23", "text": "適切なヒーローがいれば、"}, {"type": "subtitle", "time": 4224.63, "timestamp": "01:10:24", "text": "違い。"}, {"type": "subtitle", "time": 4236.07, "timestamp": "01:10:36", "text": "彼らはおそらくBPをこれに載せるだろう"}, {"type": "subtitle", "time": 4251.669, "timestamp": "01:10:51", "text": "おそらくそうなるだろう"}, {"type": "subtitle", "time": 4253.59, "timestamp": "01:10:53", "text": "全てのバックラインのヒーローのようにプレイする。"}, {"type": "subtitle", "time": 4256.55, "timestamp": "01:10:56", "text": "システムではあるが、私はいつも間違っている。これは"}]
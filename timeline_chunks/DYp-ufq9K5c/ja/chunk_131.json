[{"type": "subtitle", "time": 7861.35, "timestamp": "02:11:01", "text": "私は大丈夫です。治癒能力がオンになった"}, {"type": "subtitle", "time": 7874.47, "timestamp": "02:11:14", "text": "もう一人のヒーラーはどこだ？どこで"}, {"type": "subtitle", "time": 7877.91, "timestamp": "02:11:17", "text": "彼は行くのか？非常に素晴らしい。ルナはどこ？おお、"}, {"type": "subtitle", "time": 7879.99, "timestamp": "02:11:19", "text": "そこに彼女がいた。"}, {"type": "subtitle", "time": 7881.27, "timestamp": "02:11:21", "text": "ヒーラーが一人もいません。あなたは何者ですか"}, {"type": "subtitle", "time": 7890.79, "timestamp": "02:11:30", "text": "いいもの。良いグループだ。ありがとう。良い。"}, {"type": "subtitle", "time": 7893.43, "timestamp": "02:11:33", "text": "ヒーラーたち。なぜそこに戻ったの？さあ行こう。"}, {"type": "subtitle", "time": 7899.51, "timestamp": "02:11:39", "text": "彼のことをグルーダーと呼べばいいのか？"}, {"type": "subtitle", "time": 7906.229, "timestamp": "02:11:46", "text": "しかし、これはいずれ解消されるだろう。それについてはどう思いますか？彼"}, {"type": "subtitle", "time": 7908.95, "timestamp": "02:11:48", "text": "彼女はルナを取りに行くと言った。"}, {"type": "subtitle", "time": 7912.069, "timestamp": "02:11:52", "text": "彼女を捕まえに行く。さあ行こうぜ、相棒。"}, {"type": "subtitle", "time": 7916.31, "timestamp": "02:11:56", "text": "まあ、いいか。ああ、出してくれ。"}, {"type": "subtitle", "time": 7919.91, "timestamp": "02:11:59", "text": "私のヒーラーは彼らの"}]
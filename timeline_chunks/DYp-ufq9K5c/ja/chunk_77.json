[{"type": "subtitle", "time": 4628.149, "timestamp": "01:17:08", "text": "残り時間はわずか60秒。あなたの力は"}, {"type": "subtitle", "time": 4631.51, "timestamp": "01:17:11", "text": "生きている。消える。"}, {"type": "subtitle", "time": 4647.669, "timestamp": "01:17:27", "text": "どうやってそのトリックをやったのか分からないけど、"}, {"type": "subtitle", "time": 4653.669, "timestamp": "01:17:33", "text": "わかった。私の砲塔は"}, {"type": "subtitle", "time": 4656.47, "timestamp": "01:17:36", "text": "すぐにオンラインになります。"}, {"type": "subtitle", "time": 4664.63, "timestamp": "01:17:44", "text": "彼らに私たちを打ち負かさせてはならない。"}, {"type": "subtitle", "time": 4670.149, "timestamp": "01:17:50", "text": "それは歓迎の態度ではないと思います"}]
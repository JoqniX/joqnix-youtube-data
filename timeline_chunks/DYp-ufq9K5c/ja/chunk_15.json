[{"type": "subtitle", "time": 902.31, "timestamp": "00:15:02", "text": "同様の便利な写真を送ってください"}, {"type": "subtitle", "time": 904.71, "timestamp": "00:15:04", "text": "店舗とあなたが驚く"}, {"type": "subtitle", "time": 907.11, "timestamp": "00:15:07", "text": "彼らは技術的に進んでいる。うん。"}, {"type": "subtitle", "time": 909.35, "timestamp": "00:15:09", "text": "うん。うん。クソみたいな状況が見えるよ。はい。はい。"}, {"type": "subtitle", "time": 910.949, "timestamp": "00:15:10", "text": "うん。少量のショットを"}, {"type": "subtitle", "time": 913.11, "timestamp": "00:15:13", "text": "それ。何てことだ。うん。あなたの反応は"}, {"type": "subtitle", "time": 924.79, "timestamp": "00:15:24", "text": "うん。ジョックミックスを聴きたい"}, {"type": "subtitle", "time": 927.67, "timestamp": "00:15:27", "text": "まるで自動販売機でケーキを買うようなもの"}, {"type": "subtitle", "time": 931.269, "timestamp": "00:15:31", "text": "機械。見たい"}, {"type": "subtitle", "time": 934.47, "timestamp": "00:15:34", "text": "完全に騙された。ええ、そうです。"}, {"type": "subtitle", "time": 936.47, "timestamp": "00:15:36", "text": "うん。私"}, {"type": "subtitle", "time": 939.269, "timestamp": "00:15:39", "text": "YouTubeでその動画を見たことがあります。うん、"}, {"type": "subtitle", "time": 942.069, "timestamp": "00:15:42", "text": "とても美味しいです。"}, {"type": "subtitle", "time": 946.79, "timestamp": "00:15:46", "text": "コーンジュース。缶入りのコーンジュースだよ、相棒。"}, {"type": "subtitle", "time": 947.949, "timestamp": "00:15:47", "text": "オン"}, {"type": "subtitle", "time": 952.269, "timestamp": "00:15:52", "text": "できる。人生で一度も見たことがない。缶詰"}, {"type": "subtitle", "time": 954.87, "timestamp": "00:15:54", "text": "豆は意味不明だが、"}, {"type": "subtitle", "time": 957.15, "timestamp": "00:15:57", "text": "イギリスでは理にかなっている。"}]
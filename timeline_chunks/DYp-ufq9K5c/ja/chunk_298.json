[{"type": "subtitle", "time": 17882.55, "timestamp": "04:58:02", "text": "ゲームが違う。待って、シャって何？"}, {"type": "subtitle", "time": 17889.43, "timestamp": "04:58:09", "text": "それから？私たちは実行しています。ああ、それは"}, {"type": "subtitle", "time": 17891.75, "timestamp": "04:58:11", "text": "専用サーバー。ああ、わかりました。わかった。共有"}, {"type": "subtitle", "time": 17893.75, "timestamp": "04:58:13", "text": "ゲームは別物だ。ああ、蒸気が"}, {"type": "subtitle", "time": 17897.35, "timestamp": "04:58:17", "text": "シェアが来た。シェアゲームでは、フリー"}, {"type": "subtitle", "time": 17899.11, "timestamp": "04:58:19", "text": "プレイヤーはクラウドのみで動作しています"}, {"type": "subtitle", "time": 17900.948, "timestamp": "04:58:20", "text": "金庫が保管される場所"}, {"type": "subtitle", "time": 17902.47, "timestamp": "04:58:22", "text": "ゲームプレイセクションがアップロードされました"}, {"type": "subtitle", "time": 17905.59, "timestamp": "04:58:25", "text": "終了。ストレージはいつでも誰でも利用できます"}, {"type": "subtitle", "time": 17907.67, "timestamp": "04:58:27", "text": "ゲームの参加者は、どの時点でも。"}, {"type": "subtitle", "time": 17909.99, "timestamp": "04:58:29", "text": "これらの人は誰もプレイを主催できません"}, {"type": "subtitle", "time": 17912.708, "timestamp": "04:58:32", "text": "それ。わかった。プレイヤーは常にホストする必要があります"}, {"type": "subtitle", "time": 17914.27, "timestamp": "04:58:34", "text": "彼らのゲーム"}, {"type": "subtitle", "time": 17917.83, "timestamp": "04:58:37", "text": "機械。はい、わかりました。そこで私の質問は"}, {"type": "subtitle", "time": 17921.75, "timestamp": "04:58:41", "text": "もし私がそうしないと決めたらどうなるでしょうか"}, {"type": "subtitle", "time": 17923.47, "timestamp": "04:58:43", "text": "ゲームを共有する"}, {"type": "subtitle", "time": 17927.83, "timestamp": "04:58:47", "text": "あれ？ローカルでホストしたい場合はどうすればいいですか？"}, {"type": "subtitle", "time": 17929.99, "timestamp": "04:58:49", "text": "それ？それでよろしいでしょうか？私は思う"}, {"type": "subtitle", "time": 17935.948, "timestamp": "04:58:55", "text": "右？主催する"}]
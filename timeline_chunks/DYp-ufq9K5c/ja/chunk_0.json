[{"type": "subtitle", "time": 26.99, "timestamp": "00:00:26", "text": "私はそう信じています"}, {"type": "subtitle", "time": 29.589, "timestamp": "00:00:29", "text": "ライブ。みなさんこんにちは、ようこそ"}, {"type": "subtitle", "time": 34.63, "timestamp": "00:00:34", "text": "ジョアトン62日目。皆さんこんにちは、そうです"}, {"type": "subtitle", "time": 37.91, "timestamp": "00:00:37", "text": "62日が経過し、今日は月曜日です。"}, {"type": "subtitle", "time": 40.31, "timestamp": "00:00:40", "text": "みなさんこんにちは、ようこそ。それでは今日は"}, {"type": "subtitle", "time": 44.95, "timestamp": "00:00:44", "text": "計画はパンで暴力を振るうことであり、"}, {"type": "subtitle", "time": 49.99, "timestamp": "00:00:49", "text": "遅れて始めたいのですが、"}, {"type": "subtitle", "time": 51.83, "timestamp": "00:00:51", "text": "試験とか色々あるけど、私は"}, {"type": "subtitle", "time": 53.91, "timestamp": "00:00:53", "text": "パンと一緒に食べる。今日はブラッドが"}, {"type": "subtitle", "time": 58.31, "timestamp": "00:00:58", "text": "午後のセッションで、えっと"}, {"type": "subtitle", "time": 59.99, "timestamp": "00:00:59", "text": "ブレが私の午後の担当を引き継いでくれる"}]
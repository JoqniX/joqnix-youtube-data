[{"type": "subtitle", "time": 19210.91, "timestamp": "05:20:10", "text": "マーク。弓、いいよね。私は愛する"}, {"type": "subtitle", "time": 19217.99, "timestamp": "05:20:17", "text": "多く。私はアーチェリーが大好きです。だから私は"}, {"type": "subtitle", "time": 19219.948, "timestamp": "05:20:19", "text": "使うのが楽しみです"}, {"type": "subtitle", "time": 19246.948, "timestamp": "05:20:46", "text": "それはパンです。マップタイヤを変更するか、"}, {"type": "subtitle", "time": 19248.27, "timestamp": "05:20:48", "text": "コンピューター"}, {"type": "subtitle", "time": 19254.11, "timestamp": "05:20:54", "text": "オンになっている間にリセットしてください。できますか、できますか"}, {"type": "subtitle", "time": 19257.11, "timestamp": "05:20:57", "text": "全体をリセットしますか？そうすれば、"}, {"type": "subtitle", "time": 19259.07, "timestamp": "05:20:59", "text": "つまり、物をなくすということです。"}]
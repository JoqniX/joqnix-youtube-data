[{"type": "subtitle", "time": 19120.628, "timestamp": "05:18:40", "text": "そこで質問なのですが、耐久性はないのでしょうか？"}, {"type": "subtitle", "time": 19127.91, "timestamp": "05:18:47", "text": "[拍手]"}, {"type": "subtitle", "time": 19130.07, "timestamp": "05:18:50", "text": "この状況で青へ旅行するのが最善でしょう"}, {"type": "subtitle", "time": 19132.07, "timestamp": "05:18:52", "text": "キッソのチャンスがより良い地域"}, {"type": "subtitle", "time": 19134.708, "timestamp": "05:18:54", "text": "スタート時のフライパンにはもう入っていない"}, {"type": "subtitle", "time": 19138.43, "timestamp": "05:18:58", "text": "魚を釣り始めるために地図を消去します"}]
[{"type": "subtitle", "time": 7683.669, "timestamp": "02:08:03", "text": "ブーツ？金色の彫刻が施されたなんて、なんてこった"}, {"type": "subtitle", "time": 7686.99, "timestamp": "02:08:06", "text": "ああ、なんてことだ、"}, {"type": "subtitle", "time": 7691.27, "timestamp": "02:08:11", "text": "赤ちゃん。この男、この男は料理をする。"}, {"type": "subtitle", "time": 7693.35, "timestamp": "02:08:13", "text": "私は当然知っている？"}, {"type": "subtitle", "time": 7695.149, "timestamp": "02:08:15", "text": "この男は料理がうまい。これ"}, {"type": "subtitle", "time": 7703.87, "timestamp": "02:08:23", "text": "ちなみに、この地図は最悪だ。これ"}, {"type": "subtitle", "time": 7707.35, "timestamp": "02:08:27", "text": "地図。これは最悪の地図だ。"}, {"type": "subtitle", "time": 7714.39, "timestamp": "02:08:34", "text": "聞かせてください。この地図は最悪の地図だ"}, {"type": "subtitle", "time": 7716.47, "timestamp": "02:08:36", "text": "ヒースのために。"}, {"type": "subtitle", "time": 7719.189, "timestamp": "02:08:39", "text": "ああ、わかりました。何が原因かわからない"}, {"type": "subtitle", "time": 7721.99, "timestamp": "02:08:41", "text": "チラシや"}, {"type": "subtitle", "time": 7728.149, "timestamp": "02:08:48", "text": "なるほど。"}, {"type": "subtitle", "time": 7731.669, "timestamp": "02:08:51", "text": "これは本当にひどい。この地図はひどい。"}, {"type": "subtitle", "time": 7733.589, "timestamp": "02:08:53", "text": "私は最悪の経験をしました"}, {"type": "subtitle", "time": 7737.069, "timestamp": "02:08:57", "text": "フライヤーとフランカーがこれをプレイする"}, {"type": "subtitle", "time": 7739.91, "timestamp": "02:08:59", "text": "地図。最悪の経験だった。必要なものはすべて"}]
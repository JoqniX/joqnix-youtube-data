[{"type": "subtitle", "time": 2826.63, "timestamp": "00:47:06", "text": "それはまた私にとって役に立つのでしょうか？"}, {"type": "subtitle", "time": 2828.15, "timestamp": "00:47:08", "text": "最大。"}, {"type": "subtitle", "time": 2831.27, "timestamp": "00:47:11", "text": "ほら、彼が行くよ。ああ、あれを見て。"}, {"type": "subtitle", "time": 2833.75, "timestamp": "00:47:13", "text": "あいつを捕まえた。"}, {"type": "subtitle", "time": 2842.87, "timestamp": "00:47:22", "text": "最後の10秒。ああ、うちにはDCがあるよ。"}, {"type": "subtitle", "time": 2846.23, "timestamp": "00:47:26", "text": "いいえ、私たちの戦車です。いいえ、私たちは"}, {"type": "subtitle", "time": 2848.75, "timestamp": "00:47:28", "text": "私たちはこれを失うのか？やめてください。"}, {"type": "subtitle", "time": 2852.309, "timestamp": "00:47:32", "text": "わかった。最終スコア。私のお尻も最高です。"}, {"type": "subtitle", "time": 2855.109, "timestamp": "00:47:35", "text": "それは、それが知覚を持っているという意味ではない。ああ、それ"}, {"type": "subtitle", "time": 2858.23, "timestamp": "00:47:38", "text": "なるほど、それは理にかなっている。でも、そうだね、君は"}, {"type": "subtitle", "time": 2860.55, "timestamp": "00:47:40", "text": "めちゃくちゃ頭がいいな、D。"}, {"type": "subtitle", "time": 2868.829, "timestamp": "00:47:48", "text": "お尻。神"}, {"type": "subtitle", "time": 2871.589, "timestamp": "00:47:51", "text": "くそ。なぜなぜなぜあのブラックウィドウは"}, {"type": "subtitle", "time": 2873.91, "timestamp": "00:47:53", "text": "とても良い？一体何だったの？何が目的だったの？"}, {"type": "subtitle", "time": 2876.069, "timestamp": "00:47:56", "text": "これはGMレベルみたいなものですか？"}, {"type": "subtitle", "time": 2879.47, "timestamp": "00:47:59", "text": "ほら、彼はスモーフィングして"}]
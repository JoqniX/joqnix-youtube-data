[{"type": "subtitle", "time": 16750.109, "timestamp": "04:39:10", "text": "いいね。よし、見てみよう。タイタン"}, {"type": "subtitle", "time": 16753.83, "timestamp": "04:39:13", "text": "3D。ああ、もうすでにめちゃくちゃだ。"}, {"type": "subtitle", "time": 16756.551, "timestamp": "04:39:16", "text": "あれは糸車ですか？水のように"}, {"type": "subtitle", "time": 16760.47, "timestamp": "04:39:20", "text": "ホイールを置いたら、ああ、なんてことだ、見て"}, {"type": "subtitle", "time": 16763.91, "timestamp": "04:39:23", "text": "弾道学。"}, {"type": "subtitle", "time": 16766.31, "timestamp": "04:39:26", "text": "大砲を見てください。何てことだ。その"}, {"type": "subtitle", "time": 16768.67, "timestamp": "04:39:28", "text": "文字通り"}, {"type": "subtitle", "time": 16772.31, "timestamp": "04:39:32", "text": "軍艦。この中にサイロがあるのか​​？"}, {"type": "subtitle", "time": 16773.869, "timestamp": "04:39:33", "text": "これは"}, {"type": "subtitle", "time": 16776.029, "timestamp": "04:39:36", "text": "サイロ？おお、"}, {"type": "subtitle", "time": 16779.27, "timestamp": "04:39:39", "text": "何？ああ、ああ、いや。いいえ。これは、"}, {"type": "subtitle", "time": 16784.39, "timestamp": "04:39:44", "text": "煙突みたいなやつ。えっと、"}, {"type": "subtitle", "time": 16787.83, "timestamp": "04:39:47", "text": "ガスがあればすべてがやってくる。"}, {"type": "subtitle", "time": 16790.27, "timestamp": "04:39:50", "text": "花、黒煙、何もかも。"}, {"type": "subtitle", "time": 16798.99, "timestamp": "04:39:58", "text": "わかった。"}]
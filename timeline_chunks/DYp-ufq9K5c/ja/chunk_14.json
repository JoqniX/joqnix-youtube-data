[{"type": "subtitle", "time": 840.15, "timestamp": "00:14:00", "text": "時間。"}, {"type": "subtitle", "time": 843.59, "timestamp": "00:14:03", "text": "椅子から立ち上がりましたか？"}, {"type": "subtitle", "time": 846.389, "timestamp": "00:14:06", "text": "それが私の疑問です。私はあなたが"}, {"type": "subtitle", "time": 849.11, "timestamp": "00:14:09", "text": "もうベッドで寝ないでください。"}, {"type": "subtitle", "time": 853.03, "timestamp": "00:14:13", "text": "私は椅子で寝ません。"}, {"type": "subtitle", "time": 855.11, "timestamp": "00:14:15", "text": "私はそれをしていません。いいえ、寝ていません"}, {"type": "subtitle", "time": 857.67, "timestamp": "00:14:17", "text": "まだ椅子の上か机の上に置いてあります。そうするべきです。"}, {"type": "subtitle", "time": 858.91, "timestamp": "00:14:18", "text": "やってください"}, {"type": "subtitle", "time": 862.069, "timestamp": "00:14:22", "text": "まだ。まだ。あなたは寝ていない"}, {"type": "subtitle", "time": 864.949, "timestamp": "00:14:24", "text": "まだ椅子に座れていない？私たちはその年齢に達しています、"}, {"type": "subtitle", "time": 867.47, "timestamp": "00:14:27", "text": "メイト。私たちはそれに到達しています"}, {"type": "subtitle", "time": 873.03, "timestamp": "00:14:33", "text": "しきい値。来て。何てことだ。"}, {"type": "subtitle", "time": 874.509, "timestamp": "00:14:34", "text": "おやおや、"}, {"type": "subtitle", "time": 880.15, "timestamp": "00:14:40", "text": "良い。ジョギングはジョギングだ。ええ、私たちは見てきました"}, {"type": "subtitle", "time": 887.59, "timestamp": "00:14:47", "text": "なぜ日本以降悲しいのか"}, {"type": "subtitle", "time": 890.629, "timestamp": "00:14:50", "text": "これらのどれも実行できません"}, {"type": "subtitle", "time": 893.31, "timestamp": "00:14:53", "text": "2時間以上配信する人々"}]
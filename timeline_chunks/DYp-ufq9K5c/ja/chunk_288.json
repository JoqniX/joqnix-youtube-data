[{"type": "subtitle", "time": 17283.868, "timestamp": "04:48:03", "text": "ディーゼル。人気。私は変わることができる"}, {"type": "subtitle", "time": 17288.07, "timestamp": "04:48:08", "text": "これ。あ、待って。ゼロのように入力できます"}, {"type": "subtitle", "time": 17290.67, "timestamp": "04:48:10", "text": "見る。"}, {"type": "subtitle", "time": 17293.628, "timestamp": "04:48:13", "text": "確認する。"}, {"type": "subtitle", "time": 17296.628, "timestamp": "04:48:16", "text": "いいえ。それはゲーム内のお金だけです。"}, {"type": "subtitle", "time": 17319.43, "timestamp": "04:48:39", "text": "メインメニューに戻る。保存しないでください。それは"}, {"type": "subtitle", "time": 17322.59, "timestamp": "04:48:42", "text": "楽しかったよ。探検する"}, {"type": "subtitle", "time": 17327.39, "timestamp": "04:48:47", "text": "それ。あれはすごかった。本当にバカだ"}, {"type": "subtitle", "time": 17330.75, "timestamp": "04:48:50", "text": "基本。それでもこう言っています"}, {"type": "subtitle", "time": 17337.788, "timestamp": "04:48:57", "text": "アイアンR。"}]
[{"type": "subtitle", "time": 6610.95, "timestamp": "01:50:10", "text": "ええ、その後2回くらいしか行ってないんです。"}, {"type": "subtitle", "time": 6613.03, "timestamp": "01:50:13", "text": "一度だけではなく、もっと良い。"}, {"type": "subtitle", "time": 6615.669, "timestamp": "01:50:15", "text": "わかった。おお。優秀なヒーラーです。切り替えられますか？"}, {"type": "subtitle", "time": 6618.31, "timestamp": "01:50:18", "text": "ヒーラーに戻る前にダウンしない"}, {"type": "subtitle", "time": 6626.709, "timestamp": "01:50:26", "text": "ワイヤー？私たちはアンプを頼みました。私の"}, {"type": "subtitle", "time": 6637.189, "timestamp": "01:50:37", "text": "それ。よし、誰かが切り替える必要がある"}, {"type": "subtitle", "time": 6648.709, "timestamp": "01:50:48", "text": "わあ、すごい。実際に私の名前が書いてあります"}]
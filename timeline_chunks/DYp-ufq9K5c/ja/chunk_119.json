[{"type": "subtitle", "time": 7144.55, "timestamp": "01:59:04", "text": "それ。ああ、私たちは"}, {"type": "subtitle", "time": 7149.99, "timestamp": "01:59:09", "text": "暗闇の中で輝く。"}, {"type": "subtitle", "time": 7179.75, "timestamp": "01:59:39", "text": "裁判官、陪審員、死刑執行人。"}, {"type": "subtitle", "time": 7182.31, "timestamp": "01:59:42", "text": "多分良くないよ、兄弟。私のチームメイトは"}, {"type": "subtitle", "time": 7186.149, "timestamp": "01:59:46", "text": "物理的に、えっと、頭が悪い？"}, {"type": "subtitle", "time": 7189.51, "timestamp": "01:59:49", "text": "頭が悪すぎる。彼らはただ、えーっと、"}, {"type": "subtitle", "time": 7192.149, "timestamp": "01:59:52", "text": "まったく人間はいない"}, {"type": "subtitle", "time": 7194.39, "timestamp": "01:59:54", "text": "脳？"}, {"type": "subtitle", "time": 7197.109, "timestamp": "01:59:57", "text": "なぜなら奇妙なものが目の前にあったから"}, {"type": "subtitle", "time": 7199.75, "timestamp": "01:59:59", "text": "私たち。彼らを殺せば、"}]
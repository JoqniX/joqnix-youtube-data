[{"type": "subtitle", "time": 3723.27, "timestamp": "01:02:03", "text": "第1ラウンド。こちらはティッピートです。"}, {"type": "subtitle", "time": 3726.309, "timestamp": "01:02:06", "text": "普通の"}, {"type": "subtitle", "time": 3727.99, "timestamp": "01:02:07", "text": "リス。"}, {"type": "subtitle", "time": 3729.99, "timestamp": "01:02:09", "text": "ところで、もう一人ケモナーが増える予定です。"}, {"type": "subtitle", "time": 3732.71, "timestamp": "01:02:12", "text": "聞いたよ。ちなみに、ここは学校です"}, {"type": "subtitle", "time": 3735.43, "timestamp": "01:02:15", "text": "女の子の家はこっちです。"}, {"type": "subtitle", "time": 3738.63, "timestamp": "01:02:18", "text": "一番かっこいい？これが私たちのベッドです。今、"}, {"type": "subtitle", "time": 3740.99, "timestamp": "01:02:20", "text": "さあ、君を捕まえよう"}, {"type": "subtitle", "time": 3744.069, "timestamp": "01:02:24", "text": "動物の気持ちを理解できる男性。私"}, {"type": "subtitle", "time": 3746.309, "timestamp": "01:02:26", "text": "私もそうできたらいいのに。うん。これは"}, {"type": "subtitle", "time": 3748.069, "timestamp": "01:02:28", "text": "どこで叩かれるか、みんな、もし"}, {"type": "subtitle", "time": 3750.63, "timestamp": "01:02:30", "text": "私の言っていること、分かりますよね？"}, {"type": "subtitle", "time": 3752.23, "timestamp": "01:02:32", "text": "破滅。"}, {"type": "subtitle", "time": 3754.47, "timestamp": "01:02:34", "text": "戦闘は開始されます。ちなみに、"}, {"type": "subtitle", "time": 3757.19, "timestamp": "01:02:37", "text": "ボードゲームのようなものがある"}, {"type": "subtitle", "time": 3759.67, "timestamp": "01:02:39", "text": "あそこにストレンジ、スクワーグル、ブレードがいる。"}, {"type": "subtitle", "time": 3761.589, "timestamp": "01:02:41", "text": "ブレイドにはミニフィギュアがあるが、"}, {"type": "subtitle", "time": 3769.99, "timestamp": "01:02:49", "text": "脇を固める敵がいるような気がする。"}]
[{"type": "subtitle", "time": 9780.95, "timestamp": "02:43:00", "text": "私のマウスに？遅れています。"}, {"type": "subtitle", "time": 9795.91, "timestamp": "02:43:15", "text": "組み立てる。これは現実です。目から見て"}, {"type": "subtitle", "time": 9805.309, "timestamp": "02:43:25", "text": "何個手に入れたの？何点ですか？"}, {"type": "subtitle", "time": 9809.59, "timestamp": "02:43:29", "text": "86. 多分私の正気は"}, {"type": "subtitle", "time": 9810.91, "timestamp": "02:43:30", "text": "ひっくり返す"}, {"type": "subtitle", "time": 9817.51, "timestamp": "02:43:37", "text": "そうなんですか？"}, {"type": "subtitle", "time": 9820.15, "timestamp": "02:43:40", "text": "若干。ここに来る。私は掴む"}, {"type": "subtitle", "time": 9822.389, "timestamp": "02:43:42", "text": "彼。よし、ちょっと休憩しよう。"}, {"type": "subtitle", "time": 9823.91, "timestamp": "02:43:43", "text": "私は戻ってきます。よお。よし。またね"}, {"type": "subtitle", "time": 9825.99, "timestamp": "02:43:45", "text": "後で。わかった。またね、D。ありがとう。"}, {"type": "subtitle", "time": 9828.309, "timestamp": "02:43:48", "text": "来てくれてありがとう。バイバイ。"}, {"type": "subtitle", "time": 9835.51, "timestamp": "02:43:55", "text": "戻ってきました。"}, {"type": "subtitle", "time": 9839.349, "timestamp": "02:43:59", "text": "ああ、ついに彼が戻ってきた。"}]
[{"type": "subtitle", "time": 4861.99, "timestamp": "01:21:01", "text": "「俺だよ。」ああ、俺はクソみたいな火の穴の中にいる。"}, {"type": "subtitle", "time": 4866.149, "timestamp": "01:21:06", "text": "俺はまたあのクソ火山に戻ってきた。"}, {"type": "subtitle", "time": 4869.27, "timestamp": "01:21:09", "text": "ちくしょう。俺は今、焚き火台の上にいる。"}, {"type": "subtitle", "time": 4870.87, "timestamp": "01:21:10", "text": "その通り。"}, {"type": "subtitle", "time": 4873.669, "timestamp": "01:21:13", "text": "やばい、配信が復旧した。ああ、くそ、"}, {"type": "subtitle", "time": 4875.75, "timestamp": "01:21:15", "text": "今、自分の声が聞こえた。ああ、そうだね、ただ"}, {"type": "subtitle", "time": 4878.229, "timestamp": "01:21:18", "text": "自分の声を聞いた。さあ行こうぜ、相棒。私はただ"}, {"type": "subtitle", "time": 4881.83, "timestamp": "01:21:21", "text": "自分の声を聞いた。なんてこった？"}, {"type": "subtitle", "time": 4885.35, "timestamp": "01:21:25", "text": "さあ行こう。戻ってきました。行けるよ。そして私たちは"}, {"type": "subtitle", "time": 4888.87, "timestamp": "01:21:28", "text": "新しいゲストが来ました。こんにちは。"}, {"type": "subtitle", "time": 4890.87, "timestamp": "01:21:30", "text": "こちらはヘラス卿です、皆さん。"}, {"type": "subtitle", "time": 4894.63, "timestamp": "01:21:34", "text": "ようこそ。さあ、彼が負けるのを見てください。"}, {"type": "subtitle", "time": 4897.43, "timestamp": "01:21:37", "text": "5時間連続で負けた。さあ行こう。"}, {"type": "chat", "time": 4902.212, "timestamp": "01:21:42", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "Joq's Activity State is Guest-Takeover"}, {"type": "subtitle", "time": 4902.95, "timestamp": "01:21:42", "text": "くそったれ。ああ。ああ。ああ。"}, {"type": "subtitle", "time": 4904.47, "timestamp": "01:21:44", "text": "私が負けている理由が分かりますか？私は負けている"}, {"type": "subtitle", "time": 4907.11, "timestamp": "01:21:47", "text": "私はタンク役ではないからです。その通り、"}, {"type": "subtitle", "time": 4910.229, "timestamp": "01:21:50", "text": "お前。ああ、俺は戦車だよ、相棒。私はしません"}, {"type": "subtitle", "time": 4913.51, "timestamp": "01:21:53", "text": "DPSをプレイする。そしてこれはDPSアカウントです。"}, {"type": "subtitle", "time": 4917.35, "timestamp": "01:21:57", "text": "プレイする必要がある。私はDPS（ダメージディーラー）をプレイします。"}, {"type": "subtitle", "time": 4919.03, "timestamp": "01:21:59", "text": "雑誌。ああ、あなたは私に会いたくないのね"}]
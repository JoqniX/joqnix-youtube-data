[{"type": "subtitle", "time": 4686.669, "timestamp": "01:18:06", "text": "[音楽]"}, {"type": "subtitle", "time": 4689.59, "timestamp": "01:18:09", "text": "最大の勝者。ああ、今回は負けたな。"}, {"type": "subtitle", "time": 4697.03, "timestamp": "01:18:17", "text": "ほんの一瞬なら触れることができる。"}, {"type": "subtitle", "time": 4699.99, "timestamp": "01:18:19", "text": "彼らはチェックポイントに到達した。今こそ"}, {"type": "subtitle", "time": 4702.47, "timestamp": "01:18:22", "text": "彼らを止めろ。"}, {"type": "subtitle", "time": 4705.03, "timestamp": "01:18:25", "text": "おい、もし君にサポートが一つでもあれば"}, {"type": "subtitle", "time": 4714.51, "timestamp": "01:18:34", "text": "おい、行こうぜ"}, {"type": "subtitle", "time": 4732.55, "timestamp": "01:18:52", "text": "ええ、私の言う通りです。"}, {"type": "subtitle", "time": 4735.11, "timestamp": "01:18:55", "text": "戦車が突入したらすぐに、私は"}]
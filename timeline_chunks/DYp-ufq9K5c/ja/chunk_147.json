[{"type": "subtitle", "time": 8825.11, "timestamp": "02:27:05", "text": "ええ、それは素晴らしいですね。私はできる"}, {"type": "subtitle", "time": 8833.19, "timestamp": "02:27:13", "text": "圧力が高ければ高いほど、ああ"}, {"type": "subtitle", "time": 8836.23, "timestamp": "02:27:16", "text": "ああ、あの女性のネクタイはすごい。それは"}, {"type": "subtitle", "time": 8838.79, "timestamp": "02:27:18", "text": "サブリナ・カーペンター？"}, {"type": "subtitle", "time": 8841.03, "timestamp": "02:27:21", "text": "幸せ。"}, {"type": "subtitle", "time": 8843.75, "timestamp": "02:27:23", "text": "彼女の肌の状態を見たことがありますか？あなたは"}, {"type": "subtitle", "time": 8847.27, "timestamp": "02:27:27", "text": "サブリナのメタリットを見た？その"}, {"type": "subtitle", "time": 8849.95, "timestamp": "02:27:29", "text": "文字通り、私はこう思った。"}, {"type": "subtitle", "time": 8852.87, "timestamp": "02:27:32", "text": "うわあ、うわあ。私は、文字通り"}, {"type": "subtitle", "time": 8855.19, "timestamp": "02:27:35", "text": "ただのエムロストだけど茶色だよ、相棒。私はこう思った。"}, {"type": "subtitle", "time": 8857.83, "timestamp": "02:27:37", "text": "ああ、一体どういうことだ？うん、むしろこんな感じ"}, {"type": "subtitle", "time": 8865.19, "timestamp": "02:27:45", "text": "それは、それは"}, {"type": "subtitle", "time": 8867.23, "timestamp": "02:27:47", "text": "どちらかというと赤みがかった茶色、といった感じかな。"}, {"type": "subtitle", "time": 8872.59, "timestamp": "02:27:52", "text": "マルーンはヴィンテージっぽい。"}, {"type": "subtitle", "time": 8874.19, "timestamp": "02:27:54", "text": "マルーン族"}, {"type": "subtitle", "time": 8877.27, "timestamp": "02:27:57", "text": "マルーンファイブに似ている。掴むつもり"}, {"type": "subtitle", "time": 8878.71, "timestamp": "02:27:58", "text": "彼がすべてに行くとき奇妙な"}]
[{"type": "subtitle", "time": 6790.229, "timestamp": "01:53:10", "text": "私はすでにCall of Dutyをプレイしています"}, {"type": "subtitle", "time": 6792.55, "timestamp": "01:53:12", "text": "到着。さあ行こう。さあ行こうぜ、相棒。彼は"}, {"type": "subtitle", "time": 6799.99, "timestamp": "01:53:19", "text": "行く。ああ、彼はそれをやっている。彼は"}, {"type": "subtitle", "time": 6801.589, "timestamp": "01:53:21", "text": "文字通り脳石。ああ、彼は"}, {"type": "subtitle", "time": 6803.34, "timestamp": "01:53:23", "text": "その物。"}, {"type": "subtitle", "time": 6804.55, "timestamp": "01:53:24", "text": "[音楽]"}, {"type": "subtitle", "time": 6807.189, "timestamp": "01:53:27", "text": "まあ、何も起こらなかったよ。それで、"}, {"type": "subtitle", "time": 6809.27, "timestamp": "01:53:29", "text": "ええ、その通りです。おそらく"}, {"type": "subtitle", "time": 6811.91, "timestamp": "01:53:31", "text": "すでに"}, {"type": "subtitle", "time": 6816.629, "timestamp": "01:53:36", "text": "彼はシャワーを浴びるべきだ。"}, {"type": "subtitle", "time": 6819.189, "timestamp": "01:53:39", "text": "来て。"}, {"type": "subtitle", "time": 6821.189, "timestamp": "01:53:41", "text": "彼は本当にエイムがすごいんだよ。あなた"}, {"type": "subtitle", "time": 6824.79, "timestamp": "01:53:44", "text": "そんな手には引っかからない。わかった。"}, {"type": "subtitle", "time": 6827.31, "timestamp": "01:53:47", "text": "悟空の"}, {"type": "subtitle", "time": 6832.91, "timestamp": "01:53:52", "text": "おお"}, {"type": "subtitle", "time": 6838.629, "timestamp": "01:53:58", "text": "うん。ああ、どうぞ私のショットガンを。"}]
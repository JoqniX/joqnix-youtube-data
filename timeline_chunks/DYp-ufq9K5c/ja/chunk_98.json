[{"type": "subtitle", "time": 5892.39, "timestamp": "01:38:12", "text": "よお、BB、"}, {"type": "subtitle", "time": 5900.47, "timestamp": "01:38:20", "text": "ねえ、楽しんで、私は楽しんでいます"}, {"type": "subtitle", "time": 5902.229, "timestamp": "01:38:22", "text": "増幅器。"}, {"type": "subtitle", "time": 5908.709, "timestamp": "01:38:28", "text": "再びアンプ。"}, {"type": "subtitle", "time": 5918.629, "timestamp": "01:38:38", "text": "バッキーとキャプテン・アメリカは"}, {"type": "subtitle", "time": 5923.03, "timestamp": "01:38:43", "text": "チームを持つ。おお、それはかなりすごいですね。私"}, {"type": "subtitle", "time": 5924.629, "timestamp": "01:38:44", "text": "それには本当に腹が立った。のように、"}, {"type": "subtitle", "time": 5926.229, "timestamp": "01:38:46", "text": "彼らは親友同士だ。なぜ彼らは"}, {"type": "subtitle", "time": 5929.109, "timestamp": "01:38:49", "text": "チームを組む？一体どういうことだ？おお。おお。"}, {"type": "subtitle", "time": 5931.83, "timestamp": "01:38:51", "text": "おお。おお。おお。そうそう。私はできなかった"}, {"type": "subtitle", "time": 5937.59, "timestamp": "01:38:57", "text": "誰も切り替えたくない 彼らはそうしなかった"}]
[{"type": "subtitle", "time": 18763.27, "timestamp": "05:12:43", "text": "神。ああ、船を解いてください。はい、わかりました。"}, {"type": "subtitle", "time": 18765.15, "timestamp": "05:12:45", "text": "わかった。わかった。手に入れた"}, {"type": "subtitle", "time": 18768.15, "timestamp": "05:12:48", "text": "それ。ちょっと待って。ちょっと置いておきましょう"}, {"type": "subtitle", "time": 18771.99, "timestamp": "05:12:51", "text": "あちらにも石の物体がある。さあ"}, {"type": "subtitle", "time": 18773.55, "timestamp": "05:12:53", "text": "来る"}, {"type": "subtitle", "time": 18776.68, "timestamp": "05:12:56", "text": "戻る。ストレージは確認していません"}]
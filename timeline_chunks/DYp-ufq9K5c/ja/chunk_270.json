[{"type": "subtitle", "time": 16203.63, "timestamp": "04:30:03", "text": "神。すべて一番上にあります。"}, {"type": "subtitle", "time": 16205.63, "timestamp": "04:30:05", "text": "ああ、そう"}, {"type": "subtitle", "time": 16208.95, "timestamp": "04:30:08", "text": "いいね。 Nomadエディションがたくさんあります"}, {"type": "subtitle", "time": 16212.07, "timestamp": "04:30:12", "text": "設計図。これ全部見てください。何が"}, {"type": "subtitle", "time": 16214.67, "timestamp": "04:30:14", "text": "この未来的な"}, {"type": "subtitle", "time": 16219.149, "timestamp": "04:30:19", "text": "別荘？何？アイアンノマド"}, {"type": "subtitle", "time": 16233.149, "timestamp": "04:30:33", "text": "遊牧民。甘い"}, {"type": "subtitle", "time": 16236.71, "timestamp": "04:30:36", "text": "遊牧民。ダイビング好きの放浪者。何てことだ。ダイビング"}, {"type": "subtitle", "time": 16245.55, "timestamp": "04:30:45", "text": "もの。あなたは得意です"}, {"type": "subtitle", "time": 16248.63, "timestamp": "04:30:48", "text": "これ。良い点が見られますね。感じる"}, {"type": "subtitle", "time": 16250.95, "timestamp": "04:30:50", "text": "まるであなたがエンジニアや建築家であるかのように"}, {"type": "subtitle", "time": 16254.91, "timestamp": "04:30:54", "text": "何か。船を設計し、設計することができます"}, {"type": "subtitle", "time": 16259.189, "timestamp": "04:30:59", "text": "もの。私たちはこれが得意です。ディオ。"}]
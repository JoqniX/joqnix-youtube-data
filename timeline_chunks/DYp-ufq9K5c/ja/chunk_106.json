[{"type": "subtitle", "time": 6361.669, "timestamp": "01:46:01", "text": "代替。でも、私も知ろうとするたびに"}, {"type": "subtitle", "time": 6365.03, "timestamp": "01:46:05", "text": "彼が助走をするとき"}, {"type": "subtitle", "time": 6368.31, "timestamp": "01:46:08", "text": "そして彼がその衝撃エリアにぶつかるたびに、"}, {"type": "subtitle", "time": 6370.75, "timestamp": "01:46:10", "text": "使用することはできません"}, {"type": "subtitle", "time": 6374.149, "timestamp": "01:46:14", "text": "えっと、なんて言うんだっけ？何が"}, {"type": "subtitle", "time": 6377.27, "timestamp": "01:46:17", "text": "それをどう表現すればいい？能力。"}, {"type": "subtitle", "time": 6379.99, "timestamp": "01:46:19", "text": "ええ、その能力って何ですか？おお、"}, {"type": "subtitle", "time": 6382.87, "timestamp": "01:46:22", "text": "わかった。"}, {"type": "subtitle", "time": 6384.709, "timestamp": "01:46:24", "text": "このゲームに集中しすぎて、話す暇がない。私の間違いでした"}, {"type": "subtitle", "time": 6387.39, "timestamp": "01:46:27", "text": "けれど。ああ、大丈夫ですよ。それが何なのか分かっています"}, {"type": "subtitle", "time": 6390.149, "timestamp": "01:46:30", "text": "は。私はあなたの味方よ、ベイビーガール。ええと、私は"}, {"type": "subtitle", "time": 6392.95, "timestamp": "01:46:32", "text": "それは知っていた。"}, {"type": "subtitle", "time": 6395.75, "timestamp": "01:46:35", "text": "私はそのマガジンを抜きたい。"}, {"type": "subtitle", "time": 6399.31, "timestamp": "01:46:39", "text": "彼の二連発の引き金を引け。もう少し待っていてください。"}, {"type": "subtitle", "time": 6403.27, "timestamp": "01:46:43", "text": "ああ、ずっとフックし続けてくれ"}, {"type": "subtitle", "time": 6405.27, "timestamp": "01:46:45", "text": "もの。ああ、そうだよ。彼は唯一の男だ"}, {"type": "subtitle", "time": 6406.87, "timestamp": "01:46:46", "text": "毎回私のフックに引っかかるのは誰？"}, {"type": "subtitle", "time": 6415.75, "timestamp": "01:46:55", "text": "非常識な。これは本物の火炎放射器です。"}, {"type": "subtitle", "time": 6419.51, "timestamp": "01:46:59", "text": "どうでも。まだ終わってない。わからない"}]
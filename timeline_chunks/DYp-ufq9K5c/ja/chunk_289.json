[{"type": "subtitle", "time": 17341.43, "timestamp": "04:49:01", "text": "うん。自由世界でのみ行われるべきである。"}, {"type": "subtitle", "time": 17346.11, "timestamp": "04:49:06", "text": "ああ、無料です。ああ、無料です。無料。"}, {"type": "subtitle", "time": 17348.47, "timestamp": "04:49:08", "text": "ああ、わかりました。わかった。わかった。私はあなたが"}, {"type": "subtitle", "time": 17349.47, "timestamp": "04:49:09", "text": "支払うために"}, {"type": "subtitle", "time": 17350.67, "timestamp": "04:49:10", "text": "[音楽]"}, {"type": "subtitle", "time": 17354.39, "timestamp": "04:49:14", "text": "もの。このコインは20枚しか持っていません"}, {"type": "subtitle", "time": 17367.51, "timestamp": "04:49:27", "text": "タブ。獲得できる実績がたくさんある"}, {"type": "subtitle", "time": 17370.11, "timestamp": "04:49:30", "text": "これ"}, {"type": "subtitle", "time": 17373.67, "timestamp": "04:49:33", "text": "から。試してみましたか？"}, {"type": "subtitle", "time": 17376.15, "timestamp": "04:49:36", "text": "専用サーバーなど"}, {"type": "subtitle", "time": 17378.868, "timestamp": "04:49:38", "text": "プレイした時にやったことありますか？"}, {"type": "subtitle", "time": 17381.03, "timestamp": "04:49:41", "text": "ローカルホスティングとして、またはプレイしましたか"}, {"type": "subtitle", "time": 17382.03, "timestamp": "04:49:42", "text": "あなたの"}, {"type": "subtitle", "time": 17385.38, "timestamp": "04:49:45", "text": "友達？どうですか"}, {"type": "subtitle", "time": 17388.75, "timestamp": "04:49:48", "text": "[音楽]"}, {"type": "subtitle", "time": 17391.91, "timestamp": "04:49:51", "text": "それ？最大3試合まで。私は起きない"}, {"type": "subtitle", "time": 17395.03, "timestamp": "04:49:55", "text": "３試合のことです。理解できない"}, {"type": "subtitle", "time": 17397.07, "timestamp": "04:49:57", "text": "実際、それは理解できない"}]
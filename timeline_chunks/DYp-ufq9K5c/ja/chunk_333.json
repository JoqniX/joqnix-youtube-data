[{"type": "subtitle", "time": 19980.27, "timestamp": "05:33:00", "text": "何を"}, {"type": "subtitle", "time": 19984.628, "timestamp": "05:33:04", "text": "する。わかった。パン。だから、君が欲しいんだ。どこ"}, {"type": "subtitle", "time": 19991.19, "timestamp": "05:33:11", "text": "ない。わかった。ゆっくりしてください。修正"}, {"type": "subtitle", "time": 19995.67, "timestamp": "05:33:15", "text": "マイク。心配ない。じゃあ、行かなきゃ"}, {"type": "subtitle", "time": 19998.868, "timestamp": "05:33:18", "text": "すぐにこの島を離れるつもりだけど、"}, {"type": "subtitle", "time": 20002.23, "timestamp": "05:33:22", "text": "あなたに、私はあなたに、ええと"}, {"type": "subtitle", "time": 20004.67, "timestamp": "05:33:24", "text": "自分のものを進めて"}, {"type": "subtitle", "time": 20008.31, "timestamp": "05:33:28", "text": "良い。草とか全部集めるんだ。"}, {"type": "subtitle", "time": 20012.43, "timestamp": "05:33:32", "text": "できるだけ多くのことを調べてみてください"}, {"type": "subtitle", "time": 20016.39, "timestamp": "05:33:36", "text": "可能であり、また"}, {"type": "subtitle", "time": 20020.23, "timestamp": "05:33:40", "text": "たくさん手に入れよう"}, {"type": "subtitle", "time": 20023.91, "timestamp": "05:33:43", "text": "砂の。石のつるはしを作って、"}, {"type": "subtitle", "time": 20024.67, "timestamp": "05:33:44", "text": "得る"}, {"type": "subtitle", "time": 20031.548, "timestamp": "05:33:51", "text": "ここ。"}, {"type": "subtitle", "time": 20036.47, "timestamp": "05:33:56", "text": "えーと、もしパックを作ってあげられるなら"}, {"type": "subtitle", "time": 20037.548, "timestamp": "05:33:57", "text": "あなた"}]
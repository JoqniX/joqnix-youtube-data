[{"type": "subtitle", "time": 13082.389, "timestamp": "03:38:02", "text": "えっと、オブジェクトをクリックすると"}, {"type": "subtitle", "time": 13084.67, "timestamp": "03:38:04", "text": "そう、そこには罠がある。おお、"}, {"type": "subtitle", "time": 13088.349, "timestamp": "03:38:08", "text": "わかった。ええ、少しずつ分かってきています"}, {"type": "subtitle", "time": 13091.229, "timestamp": "03:38:11", "text": "外。えっと、ビー玉"}, {"type": "subtitle", "time": 13094.389, "timestamp": "03:38:14", "text": "かたまり。ストレージを作るにはどうすればいいですか？おお、"}, {"type": "subtitle", "time": 13096.11, "timestamp": "03:38:16", "text": "バナナ。私は食べられます"}, {"type": "subtitle", "time": 13099.91, "timestamp": "03:38:19", "text": "それ。メロンヘルメット。"}, {"type": "subtitle", "time": 13113.55, "timestamp": "03:38:33", "text": "それ。いつ海賊になったの？"}, {"type": "subtitle", "time": 13117.229, "timestamp": "03:38:37", "text": "ブート？メロンヘッド"}, {"type": "subtitle", "time": 13118.99, "timestamp": "03:38:38", "text": "海。"}, {"type": "subtitle", "time": 13122.79, "timestamp": "03:38:42", "text": "ああ、頭が大きい。よし、私は"}, {"type": "subtitle", "time": 13124.11, "timestamp": "03:38:44", "text": "ストレージ"}, {"type": "subtitle", "time": 13135.15, "timestamp": "03:38:55", "text": "ニース。 ch の目を見つけてください。行ってもいいですよ"}, {"type": "subtitle", "time": 13138.91, "timestamp": "03:38:58", "text": "または、私が上にいるのを見つけた場合"}]
[{"type": "subtitle", "time": 9305.03, "timestamp": "02:35:05", "text": "[音楽]"}, {"type": "subtitle", "time": 9307.51, "timestamp": "02:35:07", "text": "掴め。"}, {"type": "subtitle", "time": 9309.99, "timestamp": "02:35:09", "text": "準備してください。悪者たちがやってくる。おお、"}, {"type": "subtitle", "time": 9314.55, "timestamp": "02:35:14", "text": "奇妙な。降りてきてください。ああ、奇妙だ。"}, {"type": "subtitle", "time": 9315.99, "timestamp": "02:35:15", "text": "うん、チームはかなり良かったよ。私のチームは"}, {"type": "subtitle", "time": 9318.15, "timestamp": "02:35:18", "text": "固体。それは私たちにとってとても悲しいことでした。私たちは"}, {"type": "subtitle", "time": 9320.95, "timestamp": "02:35:20", "text": "最初の試合には勝てなかった。"}, {"type": "subtitle", "time": 9324.79, "timestamp": "02:35:24", "text": "さあ行こう。さあ行こう。さあ行こう。"}, {"type": "subtitle", "time": 9327.429, "timestamp": "02:35:27", "text": "今日はピークを迎えます。ごめんね、チャド。私"}, {"type": "subtitle", "time": 9330.23, "timestamp": "02:35:30", "text": "少し静かになった。私は集中しなければならなかった。"}, {"type": "subtitle", "time": 9332.95, "timestamp": "02:35:32", "text": "彼は集中しなければならなかったんだ、みんな。来て。私は持っていた"}, {"type": "subtitle", "time": 9335.75, "timestamp": "02:35:35", "text": "ロックインするために。50回くらい歓声を上げてもらえませんか？"}, {"type": "subtitle", "time": 9337.99, "timestamp": "02:35:37", "text": "彼のために？うん。どうしたの？うん。 50"}, {"type": "subtitle", "time": 9339.79, "timestamp": "02:35:39", "text": "乾杯。来て。来る"}, {"type": "subtitle", "time": 9344.469, "timestamp": "02:35:44", "text": "の上。ニース。 50人が贈られた。よう、兄弟。何が"}, {"type": "subtitle", "time": 9353.91, "timestamp": "02:35:53", "text": "ええと、彼に何かあげなきゃ。何"}, {"type": "subtitle", "time": 9356.07, "timestamp": "02:35:56", "text": "この男は何を言っているのか？"}, {"type": "subtitle", "time": 9358.23, "timestamp": "02:35:58", "text": "皆さんが良いパートナーを見つけられることを願っています"}]
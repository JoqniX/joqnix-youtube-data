[{"type": "subtitle", "time": 18664.55, "timestamp": "05:11:04", "text": "他のプレイヤーが参加したら"}, {"type": "subtitle", "time": 18667.55, "timestamp": "05:11:07", "text": "まだ多くのものをアンロックする必要があります"}, {"type": "subtitle", "time": 18674.628, "timestamp": "05:11:14", "text": "他の人もロックを解除する必要があるのでしょうか"}, {"type": "subtitle", "time": 18692.39, "timestamp": "05:11:32", "text": "もの。ヤシの種。私は植えようと思う"}, {"type": "subtitle", "time": 18705.27, "timestamp": "05:11:45", "text": "しかし、その前に元に戻す必要もある"}, {"type": "subtitle", "time": 18708.47, "timestamp": "05:11:48", "text": "セーリング。さもないと、あなたは死ぬかもしれないし、"}, {"type": "subtitle", "time": 18710.708, "timestamp": "05:11:50", "text": "別の島にスポーンする。え、何？"}]
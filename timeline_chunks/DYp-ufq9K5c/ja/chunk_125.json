[{"type": "subtitle", "time": 7501.189, "timestamp": "02:05:01", "text": "チーターのようなチーター模様の"}, {"type": "subtitle", "time": 7503.629, "timestamp": "02:05:03", "text": "ネクタイ。おお、"}, {"type": "subtitle", "time": 7506.95, "timestamp": "02:05:06", "text": "えっと、ナノミ。"}, {"type": "subtitle", "time": 7508.79, "timestamp": "02:05:08", "text": "うん、ナミか何かだと思う。"}, {"type": "subtitle", "time": 7511.109, "timestamp": "02:05:11", "text": "そんな感じ。うん。うん。私が見ていた"}, {"type": "subtitle", "time": 7513.35, "timestamp": "02:05:13", "text": "後々、それはアニメのコスプレのようになる。私は"}, {"type": "subtitle", "time": 7514.709, "timestamp": "02:05:14", "text": "「うわー、それはかなりすごいね」みたいな感じ。そして"}, {"type": "subtitle", "time": 7517.589, "timestamp": "02:05:17", "text": "それから彼はコートのボタンを外し、"}, {"type": "subtitle", "time": 7520.709, "timestamp": "02:05:20", "text": "私は彼女たちの巨大なおっぱいを見ました。私は"}, {"type": "subtitle", "time": 7523.669, "timestamp": "02:05:23", "text": "「オーマイゴッド」は見たことがない。はい、これで大丈夫です"}, {"type": "subtitle", "time": 7526.31, "timestamp": "02:05:26", "text": "落ち着いて。私もそうだった。私はこう思った。"}, {"type": "subtitle", "time": 7529.75, "timestamp": "02:05:29", "text": "それは正気の沙汰ではない。それを保存させてください。"}, {"type": "subtitle", "time": 7532.229, "timestamp": "02:05:32", "text": "それはすごい。私は開けようとしていました"}, {"type": "subtitle", "time": 7534.07, "timestamp": "02:05:34", "text": "ビリー・ウィリーのチャットだよ、だって俺は"}, {"type": "subtitle", "time": 7535.669, "timestamp": "02:05:35", "text": "「ふむ、人がいるのかな」"}, {"type": "subtitle", "time": 7538.07, "timestamp": "02:05:38", "text": "ビリー・ビリー側で。」"}, {"type": "subtitle", "time": 7543.189, "timestamp": "02:05:43", "text": "えーと、Twitch知ってるでしょ、私Twitch持ってるの"}, {"type": "subtitle", "time": 7545.51, "timestamp": "02:05:45", "text": "サイト上でも同様です。 YouTube は"}, {"type": "subtitle", "time": 7548.149, "timestamp": "02:05:48", "text": "良い。私は、"}, {"type": "subtitle", "time": 7549.75, "timestamp": "02:05:49", "text": "ビリー・ビリーの側にいる誰か、だって"}, {"type": "subtitle", "time": 7553.03, "timestamp": "02:05:53", "text": "ビリー・ビリーの中にいるって知ってるでしょ"}, {"type": "subtitle", "time": 7555.75, "timestamp": "02:05:55", "text": "ストリーミングサービスプラットフォームですよね？本当に"}, {"type": "subtitle", "time": 7557.39, "timestamp": "02:05:57", "text": "陰謀"}, {"type": "subtitle", "time": 7559.99, "timestamp": "02:05:59", "text": "自分。あそこはちょっとワイルドな感じ"}]
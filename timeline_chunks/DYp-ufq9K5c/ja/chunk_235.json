[{"type": "subtitle", "time": 14109.95, "timestamp": "03:55:09", "text": "海洋資源。ウミウシ"}, {"type": "subtitle", "time": 14115.349, "timestamp": "03:55:15", "text": "スライム。ウミウシ。ああ、スケールから"}, {"type": "subtitle", "time": 14123.15, "timestamp": "03:55:23", "text": "何だって、兄弟？このゲームは"}, {"type": "subtitle", "time": 14126.349, "timestamp": "03:55:26", "text": "だからたくさんの"}, {"type": "subtitle", "time": 14140.469, "timestamp": "03:55:40", "text": "船を破壊して建造する。うん。うん。の"}, {"type": "subtitle", "time": 14143.03, "timestamp": "03:55:43", "text": "うん。うん。設計図。いいえ。ええ。私"}, {"type": "subtitle", "time": 14149.63, "timestamp": "03:55:49", "text": "少し。"}, {"type": "subtitle", "time": 14158.389, "timestamp": "03:55:58", "text": "ベッド。椅子を作ることができます。私たちは"}]
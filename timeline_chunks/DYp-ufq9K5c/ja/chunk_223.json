[{"type": "subtitle", "time": 13382.15, "timestamp": "03:43:02", "text": "しかし、これでチュートリアルは終了です。私"}, {"type": "subtitle", "time": 13384.469, "timestamp": "03:43:04", "text": "それは望んでいない。だから、私は「えーと、どうすればいいの？」って思ったんです。"}, {"type": "subtitle", "time": 13395.79, "timestamp": "03:43:15", "text": "よし、31点中31点が必要だ。"}, {"type": "subtitle", "time": 13398.51, "timestamp": "03:43:18", "text": "ココナッツ。私はたくさん持っています"}, {"type": "subtitle", "time": 13401.429, "timestamp": "03:43:21", "text": "石。おそらく私は"}, {"type": "subtitle", "time": 13411.59, "timestamp": "03:43:31", "text": "側。ええと、それは在庫を増やすことになります"}, {"type": "subtitle", "time": 13412.99, "timestamp": "03:43:32", "text": "空間。それは"}, {"type": "subtitle", "time": 13415.83, "timestamp": "03:43:35", "text": "良い。それは石のナイフだ。ダブルストーン"}, {"type": "subtitle", "time": 13417.75, "timestamp": "03:43:37", "text": "ナイフ。私はそれらを必要としません。我々はできる"}, {"type": "subtitle", "time": 13419.229, "timestamp": "03:43:39", "text": "落とす"}, {"type": "subtitle", "time": 13432.71, "timestamp": "03:43:52", "text": "容器。ああ、在庫コンテナ。"}, {"type": "subtitle", "time": 13436.83, "timestamp": "03:43:56", "text": "わかった。わかった。ハンターサッチェル"}]
[{"type": "subtitle", "time": 15487.79, "timestamp": "04:18:07", "text": "けれど。待って、風はどこから来るの？"}, {"type": "subtitle", "time": 15491.83, "timestamp": "04:18:11", "text": "ここから吹き飛ばされるのか？いいえ、それは"}, {"type": "subtitle", "time": 15494.189, "timestamp": "04:18:14", "text": "穴。受付終了しました。"}, {"type": "subtitle", "time": 15496.63, "timestamp": "04:18:16", "text": "いいえ、完全にそうです。ああ、そうです。うん。うん。"}, {"type": "subtitle", "time": 15498.95, "timestamp": "04:18:18", "text": "完全に閉鎖されているんですね。元気ですか"}, {"type": "subtitle", "time": 15500.59, "timestamp": "04:18:20", "text": "取得"}, {"type": "subtitle", "time": 15503.87, "timestamp": "04:18:23", "text": "風？通過する必要がある"}, {"type": "subtitle", "time": 15511.67, "timestamp": "04:18:31", "text": "えっと、どうやって風を動かしているんですか？"}, {"type": "subtitle", "time": 15513.229, "timestamp": "04:18:33", "text": "の"}, {"type": "subtitle", "time": 15516.71, "timestamp": "04:18:36", "text": "m?空気の流れはどのように機能するのでしょうか？ええと、私は思う"}, {"type": "subtitle", "time": 15518.469, "timestamp": "04:18:38", "text": "こういったことすべてについて考えなければならない"}, {"type": "subtitle", "time": 15521.91, "timestamp": "04:18:41", "text": "実験して船を作るとき"}, {"type": "subtitle", "time": 15524.99, "timestamp": "04:18:44", "text": "物理法則の仕組みなど"}, {"type": "subtitle", "time": 15527.51, "timestamp": "04:18:47", "text": "すべて。ああ、このゲームは"}, {"type": "subtitle", "time": 15529.389, "timestamp": "04:18:49", "text": "強烈で"}, {"type": "subtitle", "time": 15532.59, "timestamp": "04:18:52", "text": "複雑で奥深い。私は好きです"}, {"type": "subtitle", "time": 15535.149, "timestamp": "04:18:55", "text": "これ。私は愛する"}, {"type": "subtitle", "time": 15537.55, "timestamp": "04:18:57", "text": "このセールは"}]
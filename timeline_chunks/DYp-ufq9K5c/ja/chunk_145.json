[{"type": "subtitle", "time": 8708.469, "timestamp": "02:25:08", "text": "彼は乱暴に扱われている。"}, {"type": "subtitle", "time": 8710.23, "timestamp": "02:25:10", "text": "これは範囲攻撃です。そうあるべきではない"}, {"type": "subtitle", "time": 8713.03, "timestamp": "02:25:13", "text": "大変だよ、みんな。来て。ちょうど"}, {"type": "subtitle", "time": 8720.27, "timestamp": "02:25:20", "text": "わかった。"}, {"type": "subtitle", "time": 8727.349, "timestamp": "02:25:27", "text": "ああ、柔らかいものを手に入れて。いいえ。"}, {"type": "subtitle", "time": 8730.71, "timestamp": "02:25:30", "text": "雷。おそらく良くないだろう。"}, {"type": "subtitle", "time": 8733.67, "timestamp": "02:25:33", "text": "ああ、残っているのは戦車だけだ。"}, {"type": "subtitle", "time": 8736.55, "timestamp": "02:25:36", "text": "ああ、彼女はバーにいる。ああ、それは良くないですね。おお、"}, {"type": "subtitle", "time": 8739.03, "timestamp": "02:25:39", "text": "キャップはそこにある。彼なら対処できる。私"}, {"type": "subtitle", "time": 8741.91, "timestamp": "02:25:41", "text": "それまではテレポートできる。"}, {"type": "subtitle", "time": 8743.99, "timestamp": "02:25:43", "text": "キャップタッチ。"}, {"type": "subtitle", "time": 8747.27, "timestamp": "02:25:47", "text": "手がまた震えている。集中"}, {"type": "subtitle", "time": 8749.349, "timestamp": "02:25:49", "text": "彼の戦利品。"}]
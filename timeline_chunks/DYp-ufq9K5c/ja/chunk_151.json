[{"type": "subtitle", "time": 9060.87, "timestamp": "02:31:00", "text": "ヒーラーたち。ちくしょう。"}, {"type": "subtitle", "time": 9062.87, "timestamp": "02:31:02", "text": "私は大丈夫です。"}, {"type": "subtitle", "time": 9064.23, "timestamp": "02:31:04", "text": "ヒーラーがいないときは、ヒーラーを責めてください"}, {"type": "subtitle", "time": 9066.469, "timestamp": "02:31:06", "text": "位置。ええ、まさにその通りです。それが我々の"}, {"type": "subtitle", "time": 9067.99, "timestamp": "02:31:07", "text": "する。"}, {"type": "subtitle", "time": 9069.19, "timestamp": "02:31:09", "text": "しかし、私にはヒーラーが３人います。できますか"}, {"type": "subtitle", "time": 9070.87, "timestamp": "02:31:10", "text": "不平をいう？私にはヒーラーが３人います。できますか"}, {"type": "subtitle", "time": 9073.429, "timestamp": "02:31:13", "text": "不平をいう？おいおい、頼むよ。はい、できます"}, {"type": "subtitle", "time": 9075.87, "timestamp": "02:31:15", "text": "不平をいう。大丈夫です。"}, {"type": "subtitle", "time": 9080.389, "timestamp": "02:31:20", "text": "本当に？チームのみんな、私たちのmagdはどうですか？"}, {"type": "subtitle", "time": 9083.67, "timestamp": "02:31:23", "text": "ロケットを発射したとき。さあ、"}, {"type": "subtitle", "time": 9087.19, "timestamp": "02:31:27", "text": "全部に軽くつけて。私は準備ができました"}, {"type": "subtitle", "time": 9093.67, "timestamp": "02:31:33", "text": "今はもうありません"}, {"type": "subtitle", "time": 9097.11, "timestamp": "02:31:37", "text": "阿賀本氏の目を通して。"}, {"type": "subtitle", "time": 9098.27, "timestamp": "02:31:38", "text": "我々対"}, {"type": "subtitle", "time": 9107.03, "timestamp": "02:31:47", "text": "君はそれを見たのか？"}, {"type": "subtitle", "time": 9109.27, "timestamp": "02:31:49", "text": "はい。"}]
[{"type": "subtitle", "time": 13996.59, "timestamp": "03:53:16", "text": "テックグラス"}, {"type": "subtitle", "time": 14000.309, "timestamp": "03:53:20", "text": "製油所。さあ行こう。やったぞ。今私たちは"}, {"type": "subtitle", "time": 14005.229, "timestamp": "03:53:25", "text": "製錬できる。わーい。銅"}, {"type": "subtitle", "time": 14007.269, "timestamp": "03:53:27", "text": "鉱石。だから私は、"}, {"type": "subtitle", "time": 14009.349, "timestamp": "03:53:29", "text": "金属部品を見つけた場合、"}, {"type": "subtitle", "time": 14012.55, "timestamp": "03:53:32", "text": "金属片を取り出すために壊すことができる。十分"}, {"type": "subtitle", "time": 14014.229, "timestamp": "03:53:34", "text": "ええと、ピースを作るのに十分な量です。"}, {"type": "subtitle", "time": 14016.269, "timestamp": "03:53:36", "text": "鉄の棒。"}, {"type": "subtitle", "time": 14023.07, "timestamp": "03:53:43", "text": "ああ、"}, {"type": "subtitle", "time": 14025.59, "timestamp": "03:53:45", "text": "面白い。生のガラス。私は作らなければならない"}, {"type": "subtitle", "time": 14027.87, "timestamp": "03:53:47", "text": "生"}, {"type": "subtitle", "time": 14031.189, "timestamp": "03:53:51", "text": "ガラス。どうすれば再び生のガラスを作ることができますか？"}, {"type": "subtitle", "time": 14032.91, "timestamp": "03:53:52", "text": "私はただ必要としている"}, {"type": "subtitle", "time": 14035.95, "timestamp": "03:53:55", "text": "砂。黒曜石の道具を作るのに使用され、"}, {"type": "subtitle", "time": 14038.429, "timestamp": "03:53:58", "text": "兵器。"}]
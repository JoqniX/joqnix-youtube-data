[{"type": "subtitle", "time": 16279.99, "timestamp": "04:31:19", "text": "車両保管港への積み込み。一度あなたが"}, {"type": "subtitle", "time": 16282.07, "timestamp": "04:31:22", "text": "車両を船に固定することができる。"}, {"type": "subtitle", "time": 16293.55, "timestamp": "04:31:33", "text": "見て、2つ"}, {"type": "subtitle", "time": 16296.269, "timestamp": "04:31:36", "text": "木、旗、そして"}, {"type": "subtitle", "time": 16298.79, "timestamp": "04:31:38", "text": "もの。武器のように見える。その"}, {"type": "subtitle", "time": 16302.11, "timestamp": "04:31:42", "text": "実は内部にファンが入っているんです。"}, {"type": "subtitle", "time": 16305.75, "timestamp": "04:31:45", "text": "聖なる。まるでタイタニック号の事故のような瞬間だ。"}, {"type": "subtitle", "time": 16306.99, "timestamp": "04:31:46", "text": "良い"}, {"type": "subtitle", "time": 16309.95, "timestamp": "04:31:49", "text": "探しています"}, {"type": "subtitle", "time": 16312.71, "timestamp": "04:31:52", "text": "アンカー。これはゲイに見える もし"}, {"type": "subtitle", "time": 16313.95, "timestamp": "04:31:53", "text": "誰かが建てた"}, {"type": "subtitle", "time": 16316.229, "timestamp": "04:31:56", "text": "タイタニック号。このゲームには無限の"}, {"type": "subtitle", "time": 16318.229, "timestamp": "04:31:58", "text": "可能性。私は作った、私は"}]
[{"type": "subtitle", "time": 6673.83, "timestamp": "01:51:13", "text": "またそれだ。また手に入れた。 30秒。来る"}, {"type": "subtitle", "time": 6676.709, "timestamp": "01:51:16", "text": "の上。簡単。"}, {"type": "subtitle", "time": 6679.189, "timestamp": "01:51:19", "text": "また。"}, {"type": "subtitle", "time": 6692.709, "timestamp": "01:51:32", "text": "最後の10秒。私が間違っている"}, {"type": "subtitle", "time": 6695.83, "timestamp": "01:51:35", "text": "位置。私は間違った立場にいる。"}, {"type": "subtitle", "time": 6704.07, "timestamp": "01:51:44", "text": "うん。何てことだ。セットアップは簡単だった"}, {"type": "subtitle", "time": 6711.109, "timestamp": "01:51:51", "text": "下品なジョークのこと。"}, {"type": "subtitle", "time": 6713.03, "timestamp": "01:51:53", "text": "うん。うん。私は2匹のオオカミの鳴き声を聞いた"}, {"type": "subtitle", "time": 6717.669, "timestamp": "01:51:57", "text": "外せなかった。ああ、大変だ。"}]
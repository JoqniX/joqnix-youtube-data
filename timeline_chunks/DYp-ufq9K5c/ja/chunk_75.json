[{"type": "subtitle", "time": 4521.27, "timestamp": "01:15:21", "text": "ああ、彼の助けは本当にありがたかった。ああ、私たちは"}, {"type": "subtitle", "time": 4523.51, "timestamp": "01:15:23", "text": "それを2倍にした。いや、それはまずい。それはまずい。"}, {"type": "subtitle", "time": 4525.99, "timestamp": "01:15:25", "text": "それはまずい。君の力は私のものだ。"}, {"type": "subtitle", "time": 4528.95, "timestamp": "01:15:28", "text": "組み立てる。"}, {"type": "subtitle", "time": 4531.59, "timestamp": "01:15:31", "text": "あれは何だったんだ？ああ、私の管理者"}]
[{"type": "subtitle", "time": 8102.629, "timestamp": "02:15:02", "text": "スパイダーマン。"}, {"type": "subtitle", "time": 8104.87, "timestamp": "02:15:04", "text": "アルティメット・スパイダーマン。"}, {"type": "subtitle", "time": 8107.589, "timestamp": "02:15:07", "text": "ええ、彼らは"}, {"type": "subtitle", "time": 8109.91, "timestamp": "02:15:09", "text": "サベージ・ランド。"}, {"type": "subtitle", "time": 8112.95, "timestamp": "02:15:12", "text": "アルティメット・スパイダーマンって何だっけ？"}, {"type": "subtitle", "time": 8119.87, "timestamp": "02:15:19", "text": "ああ、"}, {"type": "subtitle", "time": 8123.51, "timestamp": "02:15:23", "text": "ダークアニメ。わかりました、それが"}, {"type": "subtitle", "time": 8126.31, "timestamp": "02:15:26", "text": "覚えているのはそれではない。"}, {"type": "subtitle", "time": 8129.189, "timestamp": "02:15:29", "text": "これはアニメーションではないのか？そう思っていました。"}, {"type": "subtitle", "time": 8131.47, "timestamp": "02:15:31", "text": "いいえ、違います。それ"}, {"type": "subtitle", "time": 8135.669, "timestamp": "02:15:35", "text": "は。なんてこった。それは本当に犬だ"}, {"type": "subtitle", "time": 8138.31, "timestamp": "02:15:38", "text": "クソみたいなスパイダーマンのアニメーション。何てことだ。"}, {"type": "subtitle", "time": 8140.79, "timestamp": "02:15:40", "text": "うん。うん。うん。彼らが"}, {"type": "subtitle", "time": 8143.149, "timestamp": "02:15:43", "text": "猿の鳴き声を5回に1回くらい連呼する"}, {"type": "subtitle", "time": 8146.87, "timestamp": "02:15:46", "text": "数秒で、彼らはボディーユーモアを披露する。"}, {"type": "subtitle", "time": 8155.43, "timestamp": "02:15:55", "text": "なあ、子供の頃、俺はそういうのを見てたんだよ"}, {"type": "subtitle", "time": 8158.47, "timestamp": "02:15:58", "text": "ディズニーXDか、"}]
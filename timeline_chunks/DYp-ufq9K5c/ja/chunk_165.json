[{"type": "subtitle", "time": 9900.95, "timestamp": "02:45:00", "text": "今日は何がありますか？"}, {"type": "subtitle", "time": 9903.269, "timestamp": "02:45:03", "text": "ああ、できるよ。ねえ、知ってる？私は好きでなければならない"}, {"type": "subtitle", "time": 9905.11, "timestamp": "02:45:05", "text": "ヘッドホンのバッテリー残量が少ないので充電してください"}, {"type": "subtitle", "time": 9909.51, "timestamp": "02:45:09", "text": "バッテリーが切れました。では、私たちは、"}, {"type": "subtitle", "time": 9915.269, "timestamp": "02:45:15", "text": "これは約2時間後のことです。私たちはできますか"}, {"type": "subtitle", "time": 9916.87, "timestamp": "02:45:16", "text": "ああ、これのことね。そうそう。もちろん。"}, {"type": "subtitle", "time": 9918.88, "timestamp": "02:45:18", "text": "もちろん。 うん。他のゲームをプレイすることもできます"}, {"type": "subtitle", "time": 9920.96, "timestamp": "02:45:20", "text": "うん。他のゲームをプレイすることもできます その間、子供に話しかけて"}, {"type": "subtitle", "time": 9923.279, "timestamp": "02:45:23", "text": "その間、子供に話しかけて あなたはここに長くいなかったんですね。"}, {"type": "subtitle", "time": 9931.349, "timestamp": "02:45:31", "text": "さよなら。"}, {"type": "subtitle", "time": 9936.469, "timestamp": "02:45:36", "text": "うん。信じる人がいた"}, {"type": "subtitle", "time": 9940.95, "timestamp": "02:45:40", "text": "それ。私はそれらを読めなかった。 Dは本当に"}, {"type": "subtitle", "time": 9942.55, "timestamp": "02:45:42", "text": "ああ、あなたはどちらのご出身ですか？誰かいますか"}, {"type": "subtitle", "time": 9946.11, "timestamp": "02:45:46", "text": "そこには？うん。誰か。"}, {"type": "subtitle", "time": 9953.03, "timestamp": "02:45:53", "text": "ええ、私はただ自分の古い"}]
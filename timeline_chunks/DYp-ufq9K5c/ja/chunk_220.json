[{"type": "subtitle", "time": 13201.87, "timestamp": "03:40:01", "text": "神。"}, {"type": "subtitle", "time": 13204.03, "timestamp": "03:40:04", "text": "落とす。何？"}, {"type": "subtitle", "time": 13220.19, "timestamp": "03:40:20", "text": "落とす。わかった。"}, {"type": "subtitle", "time": 13225.03, "timestamp": "03:40:25", "text": "えっと、何か回避する方法はありますか？"}, {"type": "subtitle", "time": 13227.95, "timestamp": "03:40:27", "text": "チュートリアル？例えば私が引き受けたら"}, {"type": "subtitle", "time": 13232.51, "timestamp": "03:40:32", "text": "ヘルメットには「W」と書いてあり、船を上げると書いてある。"}, {"type": "subtitle", "time": 13235.91, "timestamp": "03:40:35", "text": "帆。よし、風が"}, {"type": "subtitle", "time": 13239.229, "timestamp": "03:40:39", "text": "以上。わかりました、でもなぜそうではないのですか"}, {"type": "subtitle", "time": 13242.349, "timestamp": "03:40:42", "text": "進展している？それは"}, {"type": "subtitle", "time": 13245.349, "timestamp": "03:40:45", "text": "右上のオブジェクトを一度クリックします"}, {"type": "subtitle", "time": 13258.99, "timestamp": "03:40:58", "text": "右上左"}]
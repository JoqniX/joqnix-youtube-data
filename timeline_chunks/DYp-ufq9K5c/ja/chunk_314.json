[{"type": "subtitle", "time": 18846.708, "timestamp": "05:14:06", "text": "ガッチャ。ああ、筋金入りの人たち。たくさんある"}, {"type": "subtitle", "time": 18849.55, "timestamp": "05:14:09", "text": "ストレージ。"}, {"type": "subtitle", "time": 18852.628, "timestamp": "05:14:12", "text": "ああ、なぜ木製のものがないのだろう"}, {"type": "subtitle", "time": 18858.39, "timestamp": "05:14:18", "text": "石の宝箱はなぜ簡単に作れるのか？待って、"}, {"type": "subtitle", "time": 18860.91, "timestamp": "05:14:20", "text": "しかしそうではない"}, {"type": "subtitle", "time": 18864.35, "timestamp": "05:14:24", "text": "木製。はい、あなたの黒曜石が必要でした。"}, {"type": "subtitle", "time": 18875.43, "timestamp": "05:14:35", "text": "手術みたいなもの。粘土が必要なんだよね？"}, {"type": "subtitle", "time": 18877.948, "timestamp": "05:14:37", "text": "粘土を持っていたと思います"}, {"type": "subtitle", "time": 18881.07, "timestamp": "05:14:41", "text": "ここ。これらを取って"}, {"type": "subtitle", "time": 18883.47, "timestamp": "05:14:43", "text": "粘土。"}, {"type": "subtitle", "time": 18894.19, "timestamp": "05:14:54", "text": "パック。これは何ですか？リソース"}, {"type": "subtitle", "time": 18896.99, "timestamp": "05:14:56", "text": "パック。パッケージ"}, {"type": "subtitle", "time": 18899.91, "timestamp": "05:14:59", "text": "銅。パッケージ。石炭の包み。"}]
[{"type": "subtitle", "time": 4921.51, "timestamp": "01:22:01", "text": "マガジンを再生しろよ、相棒。"}, {"type": "subtitle", "time": 4924.39, "timestamp": "01:22:04", "text": "みんなは僕のことをレブロン・ジェームズと呼ぶ。マグを再生して、"}, {"type": "subtitle", "time": 4939.11, "timestamp": "01:22:19", "text": "とにかく、俺はUエクスペディションをプレイしていたんだ"}, {"type": "subtitle", "time": 4941.59, "timestamp": "01:22:21", "text": "最近PlayStationで33が発売されました。私は"}, {"type": "subtitle", "time": 4943.11, "timestamp": "01:22:23", "text": "中毒。私は、ああ、みんな"}, {"type": "subtitle", "time": 4945.11, "timestamp": "01:22:25", "text": "そのゲームをプレイしている。ええ、私は60歳くらいです"}, {"type": "subtitle", "time": 4948.07, "timestamp": "01:22:28", "text": "もう何時間もそのゲームをやってるよ、兄弟。それ"}, {"type": "subtitle", "time": 4950.07, "timestamp": "01:22:30", "text": "このゲームはプレイする価値があると思う。"}, {"type": "subtitle", "time": 4952.87, "timestamp": "01:22:32", "text": "とても美味しいです。その通りだよ。なんだこれ"}, {"type": "subtitle", "time": 4956.07, "timestamp": "01:22:36", "text": "サウンドトラック。あなたの誰ですか あなたの誰ですか"}, {"type": "subtitle", "time": 4958.149, "timestamp": "01:22:38", "text": "今一番好きなキャラクターは？何が"}, {"type": "subtitle", "time": 4959.91, "timestamp": "01:22:39", "text": "もしかして？"}, {"type": "subtitle", "time": 4961.669, "timestamp": "01:22:41", "text": "ええと、遠征。あなたのお気に入りは誰ですか？"}, {"type": "subtitle", "time": 4964.709, "timestamp": "01:22:44", "text": "今のキャラクターは？私はグスタフが大好きです"}, {"type": "subtitle", "time": 4966.55, "timestamp": "01:22:46", "text": "だって、彼は主人公だから"}, {"type": "subtitle", "time": 4970.47, "timestamp": "01:22:50", "text": "もちろん、でも私は、えーと、"}, {"type": "subtitle", "time": 4971.87, "timestamp": "01:22:51", "text": "少女？"}, {"type": "subtitle", "time": 4973.709, "timestamp": "01:22:53", "text": "えっと、"}, {"type": "subtitle", "time": 4976.629, "timestamp": "01:22:56", "text": "メル、ああ、そうだね。うん。うん。彼女"}, {"type": "subtitle", "time": 4979.35, "timestamp": "01:22:59", "text": "必ずしもそこにある必要はない。彼女はただ"}]
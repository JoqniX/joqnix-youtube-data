[{"type": "subtitle", "time": 14406.189, "timestamp": "04:00:06", "text": "見る。エディターとエディターで"}, {"type": "subtitle", "time": 14410.189, "timestamp": "04:00:10", "text": "エディタ。これはエディターではありません。"}, {"type": "subtitle", "time": 14416.11, "timestamp": "04:00:16", "text": "ああ、編集者さん。エディタ。エディタ。"}, {"type": "subtitle", "time": 14436.55, "timestamp": "04:00:36", "text": "厳しい。おお。おお。メインメニュー。わかった。わかった。"}, {"type": "subtitle", "time": 14438.75, "timestamp": "04:00:38", "text": "ああ、読み込み中です。おお"}, {"type": "subtitle", "time": 14441.51, "timestamp": "04:00:41", "text": "いいえ。終わるまで待たなければならなかった"}, {"type": "subtitle", "time": 14452.229, "timestamp": "04:00:52", "text": "いいえ。ユーザーインターフェースが非常に使いづらい。とても難しい"}, {"type": "subtitle", "time": 14455.67, "timestamp": "04:00:55", "text": "物がどこにあるかを見つけるために、"}, {"type": "subtitle", "time": 14457.99, "timestamp": "04:00:57", "text": "多くのこと。でも慣れてしまえば、"}, {"type": "subtitle", "time": 14459.229, "timestamp": "04:00:59", "text": "私は思う"}]
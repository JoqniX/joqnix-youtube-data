[{"type": "subtitle", "time": 2161.43, "timestamp": "00:36:01", "text": "彼らは外さなかった。ああ、気にしないで。おお、"}, {"type": "subtitle", "time": 2164.55, "timestamp": "00:36:04", "text": "どうでも。"}, {"type": "subtitle", "time": 2167.15, "timestamp": "00:36:07", "text": "彼を殴った。ちくしょう。彼は1人だ"}, {"type": "subtitle", "time": 2169.349, "timestamp": "00:36:09", "text": "ショット。私はまたあの骨を手に入れるつもりだ。"}, {"type": "subtitle", "time": 2187.75, "timestamp": "00:36:27", "text": "ええ、ドラキュラハンターのスキン全体ですね。"}, {"type": "subtitle", "time": 2190.55, "timestamp": "00:36:30", "text": "このシリーズは最高だった。そうそう。どんなスキン？"}, {"type": "subtitle", "time": 2193.069, "timestamp": "00:36:33", "text": "そこにいたのですか？覚えていない"}, {"type": "subtitle", "time": 2209.75, "timestamp": "00:36:49", "text": "それ。別の"}, {"type": "subtitle", "time": 2211.589, "timestamp": "00:36:51", "text": "わかった。ありがとう。台無しにしてくれてありがとう"}, {"type": "subtitle", "time": 2215.75, "timestamp": "00:36:55", "text": "それ。ああ、私の毒。台無しにしてくれてありがとう"}, {"type": "subtitle", "time": 2219.51, "timestamp": "00:36:59", "text": "それ。お好みでどうぞ。"}]
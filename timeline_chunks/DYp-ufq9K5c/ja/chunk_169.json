[{"type": "subtitle", "time": 10150.63, "timestamp": "02:49:10", "text": "私はOで何度も詐欺に遭いました。"}, {"type": "subtitle", "time": 10153.51, "timestamp": "02:49:13", "text": "詐欺に遭った。"}, {"type": "subtitle", "time": 10155.67, "timestamp": "02:49:15", "text": "まるで私がそれを叩いてどこかへ行くように"}, {"type": "subtitle", "time": 10158.79, "timestamp": "02:49:18", "text": "それ以外。おお、"}, {"type": "subtitle", "time": 10161.309, "timestamp": "02:49:21", "text": "待って。アルスは試験を受けていますか？"}, {"type": "subtitle", "time": 10163.83, "timestamp": "02:49:23", "text": "今日？彼と話しましたか？私は手に入れた"}, {"type": "subtitle", "time": 10168.63, "timestamp": "02:49:28", "text": "彼は原神をプレイしていたので、そうでないことを願います。"}, {"type": "subtitle", "time": 10172.71, "timestamp": "02:49:32", "text": "ああ、力は私のものだ。"}, {"type": "subtitle", "time": 10175.83, "timestamp": "02:49:35", "text": "武装していて危険だ。"}, {"type": "subtitle", "time": 10184.309, "timestamp": "02:49:44", "text": "もう一度、もう一度。待って、待って、待って、待って、"}]
[{"type": "subtitle", "time": 7266.95, "timestamp": "02:01:06", "text": "ところで、ジョックはどこにいるんだ？まるで2つみたい"}, {"type": "subtitle", "time": 7269.35, "timestamp": "02:01:09", "text": "時間。心配しないで。それはただ"}, {"type": "subtitle", "time": 7272.51, "timestamp": "02:01:12", "text": "始まり。来て。"}, {"type": "subtitle", "time": 7275.51, "timestamp": "02:01:15", "text": "ああ、ええと。参加登録が完了しました。そしてどのように"}, {"type": "subtitle", "time": 7277.51, "timestamp": "02:01:17", "text": "どれだけの人が筋力を失っているのか。よし、2人だ。"}, {"type": "subtitle", "time": 7279.669, "timestamp": "02:01:19", "text": "わかったよ、相棒。これはほんの始まりに過ぎない。"}, {"type": "subtitle", "time": 7281.35, "timestamp": "02:01:21", "text": "さあ、行こうぜ。きっとこうあるべきだ"}, {"type": "subtitle", "time": 7284.39, "timestamp": "02:01:24", "text": "あと5人。私にさせて、私にさせて、私にさせて、私にさせて"}, {"type": "subtitle", "time": 7287.189, "timestamp": "02:01:27", "text": "パッチスキンを入手してください。"}, {"type": "subtitle", "time": 7300.31, "timestamp": "02:01:40", "text": "はい、そうです。ポンプで全部"}, {"type": "subtitle", "time": 7312.75, "timestamp": "02:01:52", "text": "これは何ですか？いいえ。それは新しい"}, {"type": "subtitle", "time": 7316.39, "timestamp": "02:01:56", "text": "イベント？わかった。"}]
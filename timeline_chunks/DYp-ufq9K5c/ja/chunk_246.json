[{"type": "subtitle", "time": 14769.229, "timestamp": "04:06:09", "text": "何？基本的なアイコン位置アニメーションを追加する"}, {"type": "subtitle", "time": 14773.189, "timestamp": "04:06:13", "text": "地形。え、何？プレイヤーに質問しに来ました"}, {"type": "subtitle", "time": 14780.429, "timestamp": "04:06:20", "text": "ボイスチャットチャンネルを非表示にする"}, {"type": "subtitle", "time": 14786.79, "timestamp": "04:06:26", "text": "ストレージオブジェクトはどこにあるのか"}, {"type": "subtitle", "time": 14790.51, "timestamp": "04:06:30", "text": "設計図 設計図 ローカル"}, {"type": "subtitle", "time": 14795.68, "timestamp": "04:06:35", "text": "ワークショップ地元の私はもっと"}, {"type": "subtitle", "time": 14798.03, "timestamp": "04:06:38", "text": "[音楽]"}, {"type": "subtitle", "time": 14800.03, "timestamp": "04:06:40", "text": "えっと"}, {"type": "subtitle", "time": 14803.63, "timestamp": "04:06:43", "text": "一番安いのは、あなたの名前を入力させてください。の"}, {"type": "subtitle", "time": 14805.71, "timestamp": "04:06:45", "text": "スープ"}, {"type": "subtitle", "time": 14810.11, "timestamp": "04:06:50", "text": "ナチス。なぜ見つけられないのか"}, {"type": "subtitle", "time": 14813.59, "timestamp": "04:06:53", "text": "あなた？クリエイティブな表現を使ってもいいですか？ええと、でも"}, {"type": "subtitle", "time": 14818.189, "timestamp": "04:06:58", "text": "制限はありません。はい、わかりました。"}]
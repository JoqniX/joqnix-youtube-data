[{"type": "subtitle", "time": 5220.629, "timestamp": "01:27:00", "text": "でも、さっきも言ったように、"}, {"type": "subtitle", "time": 5222.95, "timestamp": "01:27:02", "text": "ウルヴァリンの声優だよ。クソッ"}, {"type": "subtitle", "time": 5227.91, "timestamp": "01:27:07", "text": "スティーブ・ブルーム判事ですよね？彼は"}, {"type": "subtitle", "time": 5230.87, "timestamp": "01:27:10", "text": "事実上、長い間ウルヴァリンだった。私は愛する"}, {"type": "subtitle", "time": 5233.11, "timestamp": "01:27:13", "text": "彼。彼もブリムストーンだと思うし"}, {"type": "subtitle", "time": 5234.629, "timestamp": "01:27:14", "text": "ヴァレリー。先ほどのプレーについて話します"}, {"type": "subtitle", "time": 5239.91, "timestamp": "01:27:19", "text": "した。おい、犬の糞みたいなケツ遊び。"}, {"type": "subtitle", "time": 5242.87, "timestamp": "01:27:22", "text": "あそこにいる4人くらい。ああ、それは"}, {"type": "subtitle", "time": 5245.189, "timestamp": "01:27:25", "text": "いいね。ファイブガイズはどうですか？待って、来て。"}, {"type": "subtitle", "time": 5246.07, "timestamp": "01:27:26", "text": "ここに来て。ここに来て。ここに来て。来る"}, {"type": "subtitle", "time": 5248.39, "timestamp": "01:27:28", "text": "ここ。ここに来て。うん、君が愛してるって知ってるよ"}, {"type": "subtitle", "time": 5251.11, "timestamp": "01:27:31", "text": "ファイブガイズ。うん、いい子だね。"}, {"type": "subtitle", "time": 5256.47, "timestamp": "01:27:36", "text": "わかったよ。落ち着け。それが"}, {"type": "subtitle", "time": 5262.629, "timestamp": "01:27:42", "text": "いい子と呼ぶのは私の"}, {"type": "subtitle", "time": 5264.79, "timestamp": "01:27:44", "text": "ライバルたち。一体どういうことだ？わかった。いつ"}, {"type": "subtitle", "time": 5266.31, "timestamp": "01:27:46", "text": "私のヒーラーが私を回復してくれるときはいつでも、私はただ"}, {"type": "subtitle", "time": 5268.47, "timestamp": "01:27:48", "text": "「いい子だね」"}, {"type": "subtitle", "time": 5276.629, "timestamp": "01:27:56", "text": "こんにちは、シル、リストが多すぎます。ああ、彼女は"}, {"type": "subtitle", "time": 5279.91, "timestamp": "01:27:59", "text": "突然姿を消した。よし。そして彼女は"}]
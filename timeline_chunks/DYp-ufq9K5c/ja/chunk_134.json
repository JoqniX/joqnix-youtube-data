[{"type": "subtitle", "time": 8050.55, "timestamp": "02:14:10", "text": "それは誰かを誘拐するつもりだ"}, {"type": "subtitle", "time": 8054.629, "timestamp": "02:14:14", "text": "ここです。申し訳ありませんでした。"}, {"type": "subtitle", "time": 8056.55, "timestamp": "02:14:16", "text": "ああ、ここはKcoaです。これは"}, {"type": "subtitle", "time": 8060.55, "timestamp": "02:14:20", "text": "えっと、なんて言うんだっけ？"}, {"type": "subtitle", "time": 8063.51, "timestamp": "02:14:23", "text": "さあ行こう。えっと、モンスターって呼ばれてるやつです"}, {"type": "subtitle", "time": 8065.99, "timestamp": "02:14:25", "text": "島。いいえ、別の名前です。"}, {"type": "subtitle", "time": 8067.51, "timestamp": "02:14:27", "text": "マグニートー。"}, {"type": "subtitle", "time": 8069.79, "timestamp": "02:14:29", "text": "ジャングルワールド。いいえ。"}, {"type": "subtitle", "time": 8072.629, "timestamp": "02:14:32", "text": "えっと、何ていう名前だったかな。恐竜ワールド。"}, {"type": "subtitle", "time": 8075.44, "timestamp": "02:14:35", "text": "いいえ。"}, {"type": "subtitle", "time": 8081.43, "timestamp": "02:14:41", "text": "戦車2両。"}, {"type": "subtitle", "time": 8083.91, "timestamp": "02:14:43", "text": "少し後押しが必要だった。うん、行くよ"}, {"type": "subtitle", "time": 8087.189, "timestamp": "02:14:47", "text": "彼女を捕まえる。これを見てください。続けて。"}, {"type": "subtitle", "time": 8089.51, "timestamp": "02:14:49", "text": "これをやってください。未開。それがそれだ"}, {"type": "subtitle", "time": 8094.95, "timestamp": "02:14:54", "text": "ああ、野蛮な土地。うん。ええ、それは"}, {"type": "subtitle", "time": 8097.51, "timestamp": "02:14:57", "text": "それは何と呼ばれているのか。"}, {"type": "subtitle", "time": 8099.669, "timestamp": "02:14:59", "text": "アルティメットのあのエピソードを覚えている"}]
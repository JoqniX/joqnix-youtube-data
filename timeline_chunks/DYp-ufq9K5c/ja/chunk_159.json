[{"type": "subtitle", "time": 9540.309, "timestamp": "02:39:00", "text": "再生と爪は2つの別々のものです"}, {"type": "subtitle", "time": 9542.79, "timestamp": "02:39:02", "text": "物事、ですよね？"}, {"type": "subtitle", "time": 9544.63, "timestamp": "02:39:04", "text": "うん。そしてそれらは互いに関係がない"}, {"type": "subtitle", "time": 9547.349, "timestamp": "02:39:07", "text": "他に、彼が最初に持っていたものは何ですか？爪または"}, {"type": "subtitle", "time": 9550.469, "timestamp": "02:39:10", "text": "再生？彼はいつも"}, {"type": "subtitle", "time": 9553.11, "timestamp": "02:39:13", "text": "両方を同時に。それで"}, {"type": "subtitle", "time": 9555.99, "timestamp": "02:39:15", "text": "くそ、彼らは一緒に来ない"}, {"type": "subtitle", "time": 9559.75, "timestamp": "02:39:19", "text": "これはまさに二次突然変異と言えるでしょう。"}, {"type": "subtitle", "time": 9562.95, "timestamp": "02:39:22", "text": "うん。うん。ちょっと変な感じ。同じ"}, {"type": "subtitle", "time": 9564.309, "timestamp": "02:39:24", "text": "ガン・グレイと一緒ですよね？彼女は持っている"}, {"type": "subtitle", "time": 9567.429, "timestamp": "02:39:27", "text": "テレパシーとテレキネシスですが、"}, {"type": "subtitle", "time": 9569.27, "timestamp": "02:39:29", "text": "別々ではなかった。彼らは"}, {"type": "subtitle", "time": 9571.03, "timestamp": "02:39:31", "text": "同時に。"}, {"type": "subtitle", "time": 9573.67, "timestamp": "02:39:33", "text": "つまり、二次突然変異は"}, {"type": "subtitle", "time": 9580.75, "timestamp": "02:39:40", "text": "どうやって、"}, {"type": "subtitle", "time": 9583.67, "timestamp": "02:39:43", "text": "二次突然変異ですよね？好きなもの"}, {"type": "subtitle", "time": 9586.15, "timestamp": "02:39:46", "text": "そうかもしれない。私は批判しているわけではありません。ええ、それは"}, {"type": "subtitle", "time": 9588.87, "timestamp": "02:39:48", "text": "とにかく変だ。奇妙な直接詐欺のようだ"}, {"type": "subtitle", "time": 9591.83, "timestamp": "02:39:51", "text": "コミック作家が"}, {"type": "subtitle", "time": 9595.11, "timestamp": "02:39:55", "text": "キャラクターたちの新たなくだらない能力。"}, {"type": "subtitle", "time": 9599.11, "timestamp": "02:39:59", "text": "うん。そして、新しい筋書きを作る。はい。"}]
[{"type": "subtitle", "time": 16810.31, "timestamp": "04:40:10", "text": "装備バトルと沿岸に夢中"}, {"type": "subtitle", "time": 16812.07, "timestamp": "04:40:12", "text": "爆撃。"}, {"type": "subtitle", "time": 16814.788, "timestamp": "04:40:14", "text": "6 台の蒸気機関により"}, {"type": "subtitle", "time": 16817.35, "timestamp": "04:40:17", "text": "海と2枚の帆がシーンを支配する"}, {"type": "subtitle", "time": 16819.35, "timestamp": "04:40:19", "text": "港内での操縦や行動のために追加される"}, {"type": "subtitle", "time": 16823.43, "timestamp": "04:40:23", "text": "燃料切れ時のバックアップとして"}, {"type": "subtitle", "time": 16825.35, "timestamp": "04:40:25", "text": "十分な収納スペース。でも実際はスクロールするだけ"}, {"type": "subtitle", "time": 16826.55, "timestamp": "04:40:26", "text": "下から探せば見つかる。その"}, {"type": "subtitle", "time": 16828.47, "timestamp": "04:40:28", "text": "高評価。かなり公平に出てくるはずだ"}, {"type": "subtitle", "time": 16831.27, "timestamp": "04:40:31", "text": "素早い。ああ、私が今言った名前は何"}, {"type": "subtitle", "time": 16834.11, "timestamp": "04:40:34", "text": "私はただ"}]
[{"type": "subtitle", "time": 6487.35, "timestamp": "01:48:07", "text": "おお、いいブロックだね、マグ。"}, {"type": "subtitle", "time": 6491.03, "timestamp": "01:48:11", "text": "行けよ、相棒。やったぜ。"}, {"type": "subtitle", "time": 6492.95, "timestamp": "01:48:12", "text": "戻ってくる。そうそう。ここに来て。おお。おお。"}, {"type": "subtitle", "time": 6497.99, "timestamp": "01:48:17", "text": "おお。得る。ニース。あいつを捕まえろよ、坊や。"}, {"type": "subtitle", "time": 6501.03, "timestamp": "01:48:21", "text": "ああ、彼は一発で倒せるんだ。"}, {"type": "subtitle", "time": 6503.99, "timestamp": "01:48:23", "text": "ブーム。バダブーム。彼を捕まえろ。私はできなかった"}, {"type": "subtitle", "time": 6506.39, "timestamp": "01:48:26", "text": "全く狙いが定まらない。"}, {"type": "subtitle", "time": 6510.79, "timestamp": "01:48:30", "text": "これは60fpsです。どうやって狙いを定めればいいの？"}, {"type": "subtitle", "time": 6512.629, "timestamp": "01:48:32", "text": "ああ、くそ。"}, {"type": "subtitle", "time": 6515.75, "timestamp": "01:48:35", "text": "嘘をついている。"}, {"type": "subtitle", "time": 6518.31, "timestamp": "01:48:38", "text": "いつでも喜んでお手伝いしますよ、パートナー。私は行きます"}, {"type": "subtitle", "time": 6521.27, "timestamp": "01:48:41", "text": "彼を呼び出すために。"}, {"type": "subtitle", "time": 6522.87, "timestamp": "01:48:42", "text": "おお、"}, {"type": "subtitle", "time": 6535.75, "timestamp": "01:48:55", "text": "[音楽]"}, {"type": "subtitle", "time": 6538.07, "timestamp": "01:48:58", "text": "わかった。一体誰が一番上にいるんだ？多くの"}, {"type": "subtitle", "time": 6539.91, "timestamp": "01:48:59", "text": "より良い。"}]
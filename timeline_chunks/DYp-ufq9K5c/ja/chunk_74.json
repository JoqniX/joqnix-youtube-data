[{"type": "subtitle", "time": 4442.31, "timestamp": "01:14:02", "text": "おお、いいぞ。歪み。ニース。私はすべてできます"}, {"type": "subtitle", "time": 4455.59, "timestamp": "01:14:15", "text": "ニース。ニース。わかった。グリーンが使用されています"}, {"type": "subtitle", "time": 4465.75, "timestamp": "01:14:25", "text": "うん。彼らに全て使わせた。彼らに使わせた"}, {"type": "subtitle", "time": 4496.229, "timestamp": "01:14:56", "text": "これは役に立つはずです。こんにちは。これは"}, {"type": "subtitle", "time": 4498.47, "timestamp": "01:14:58", "text": "本当にお役に立ちます。こんにちは。無駄な"}]
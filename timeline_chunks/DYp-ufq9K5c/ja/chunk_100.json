[{"type": "subtitle", "time": 6000.709, "timestamp": "01:40:00", "text": "うわ、おい。こちらはウィンター・ソルジャーです。"}, {"type": "subtitle", "time": 6003.99, "timestamp": "01:40:03", "text": "それは冬ではない。よし、これでいい。"}, {"type": "subtitle", "time": 6007.35, "timestamp": "01:40:07", "text": "私は間違った相手に銃を突きつけてしまった。の"}, {"type": "subtitle", "time": 6010.189, "timestamp": "01:40:10", "text": "間違った兵士だ。"}, {"type": "subtitle", "time": 6013.75, "timestamp": "01:40:13", "text": "うん。ああ、くそ。私にはやるべき使命がある"}, {"type": "subtitle", "time": 6016.27, "timestamp": "01:40:16", "text": "ヒーリング。"}, {"type": "subtitle", "time": 6019.51, "timestamp": "01:40:19", "text": "はい、わかりました。いいえ。いいえ。この地図の後です。"}, {"type": "subtitle", "time": 6021.51, "timestamp": "01:40:21", "text": "この試合の後。この後。私は持っている"}, {"type": "subtitle", "time": 6023.83, "timestamp": "01:40:23", "text": "左。丸一日かけてやればいいんだ。ない"}, {"type": "subtitle", "time": 6026.95, "timestamp": "01:40:26", "text": "誰にとっても頼れる相棒。私のやっていることが一番だ。"}, {"type": "subtitle", "time": 6033.03, "timestamp": "01:40:33", "text": "この地図。ああ、これは炎の男の地図だ。"}, {"type": "subtitle", "time": 6035.109, "timestamp": "01:40:35", "text": "いやー、ウィンター・ソルジャー大好きだよ。この男"}, {"type": "subtitle", "time": 6038.39, "timestamp": "01:40:38", "text": "2週間シャワーを浴びていない。"}, {"type": "subtitle", "time": 6042.229, "timestamp": "01:40:42", "text": "はい。私と同じだ。はい。何？"}, {"type": "subtitle", "time": 6044.55, "timestamp": "01:40:44", "text": "何？何？あなたはこれをプレイすらしない"}, {"type": "subtitle", "time": 6046.109, "timestamp": "01:40:46", "text": "ゲーム？"}, {"type": "subtitle", "time": 6048.79, "timestamp": "01:40:48", "text": "何？私はこのゲームをプレイしますが、"}, {"type": "subtitle", "time": 6050.629, "timestamp": "01:40:50", "text": "プレイステーション"}, {"type": "subtitle", "time": 6053.51, "timestamp": "01:40:53", "text": "男の子たちのゲームで"}]
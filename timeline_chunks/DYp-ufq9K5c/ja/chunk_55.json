[{"type": "subtitle", "time": 3310.23, "timestamp": "00:55:10", "text": "私はかつて剣の達人でしたが、今は"}, {"type": "subtitle", "time": 3314.069, "timestamp": "00:55:14", "text": "まだまだたくさんある。アル兄さん、私を信じてください。"}, {"type": "subtitle", "time": 3317.589, "timestamp": "00:55:17", "text": "これについては私を信じてください。もっともっと"}, {"type": "subtitle", "time": 3320.069, "timestamp": "00:55:20", "text": "アイアンマンのゲームよりもイライラさせるキャラクターばかりだ。"}, {"type": "subtitle", "time": 3322.23, "timestamp": "00:55:22", "text": "ええと、"}, {"type": "subtitle", "time": 3325.75, "timestamp": "00:55:25", "text": "もうどうでもいい。通りと太陽の摂政"}, {"type": "subtitle", "time": 3328.95, "timestamp": "00:55:28", "text": "システム。でも、私はルナを助けたいんです。私"}, {"type": "subtitle", "time": 3330.47, "timestamp": "00:55:30", "text": "ルナを本当に助けたい"}, {"type": "subtitle", "time": 3333.27, "timestamp": "00:55:33", "text": "鉄拳だが、"}, {"type": "subtitle", "time": 3335.03, "timestamp": "00:55:35", "text": "彼女が何かしているかどうかはわかりません"}, {"type": "subtitle", "time": 3338.71, "timestamp": "00:55:38", "text": "その能力をもって。すべてのアーマーアーマー"}, {"type": "subtitle", "time": 3342.23, "timestamp": "00:55:42", "text": "通さない。私は思う"}, {"type": "subtitle", "time": 3345.67, "timestamp": "00:55:45", "text": "これにはてこが必要です。戦いは"}, {"type": "subtitle", "time": 3350.309, "timestamp": "00:55:50", "text": "五。オタク。なんてオタクなんだ。この男は"}, {"type": "subtitle", "time": 3352.15, "timestamp": "00:55:52", "text": "なんてオタクなんだ。あなたがすべきことはただ"}, {"type": "subtitle", "time": 3355.75, "timestamp": "00:55:55", "text": "そのエリアを制圧せよ。わかった。"}, {"type": "subtitle", "time": 3357.27, "timestamp": "00:55:57", "text": "まさかまたここに戻ってくるとは思わなかった。"}, {"type": "subtitle", "time": 3359.349, "timestamp": "00:55:59", "text": "だから、彼らは控えめなので、私は"}]
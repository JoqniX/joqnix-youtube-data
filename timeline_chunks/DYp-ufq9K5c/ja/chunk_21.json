[{"type": "subtitle", "time": 1263.75, "timestamp": "00:21:03", "text": "ソウルシリーズみたいなゲーム。えっと、どうやって"}, {"type": "subtitle", "time": 1266.35, "timestamp": "00:21:06", "text": "見る？ええ、まさにその通りです。"}, {"type": "subtitle", "time": 1269.83, "timestamp": "00:21:09", "text": "ああ、そうだよ。彼の頭はこうでなければならない"}, {"type": "chat", "time": 1272.887, "timestamp": "00:21:12", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "no not from a game"}, {"type": "subtitle", "time": 1273.19, "timestamp": "00:21:13", "text": "完全に抑えられた感じですね、"}, {"type": "subtitle", "time": 1275.99, "timestamp": "00:21:15", "text": "上から順に。まるで"}, {"type": "chat", "time": 1276.281, "timestamp": "00:21:16", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "thats from real life"}, {"type": "subtitle", "time": 1278.23, "timestamp": "00:21:18", "text": "彼の頭のへこみが透けて見える"}, {"type": "chat", "time": 1280.363, "timestamp": "00:21:20", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "medieval stuff"}, {"type": "subtitle", "time": 1281.909, "timestamp": "00:21:21", "text": "あのクソ野郎。私はそのゲームは要りません。"}, {"type": "subtitle", "time": 1284.149, "timestamp": "00:21:24", "text": "私の頭は巨大だ。それは収まりません"}, {"type": "chat", "time": 1300.428, "timestamp": "00:21:40", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "its called a frog mouth helm or jousting helm"}, {"type": "subtitle", "time": 1301.39, "timestamp": "00:21:41", "text": "[音楽]"}, {"type": "subtitle", "time": 1304.669, "timestamp": "00:21:44", "text": "中世のものですか？神"}, {"type": "subtitle", "time": 1308.71, "timestamp": "00:21:48", "text": "くそ。その人が持っていないのはどうですか?"}, {"type": "chat", "time": 1311.542, "timestamp": "00:21:51", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "from the 1400s"}, {"type": "subtitle", "time": 1311.59, "timestamp": "00:21:51", "text": "首または彼の上にいいねの比率がない"}, {"type": "subtitle", "time": 1316.35, "timestamp": "00:21:56", "text": "頭？教えてあげよう"}, {"type": "subtitle", "time": 1318.11, "timestamp": "00:21:58", "text": "フロッグモア。"}]
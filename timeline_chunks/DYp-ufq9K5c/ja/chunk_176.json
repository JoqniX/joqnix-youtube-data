[{"type": "subtitle", "time": 10560.15, "timestamp": "02:56:00", "text": "毎回必ずアンプ。今、銅が"}, {"type": "subtitle", "time": 10573.95, "timestamp": "02:56:13", "text": "不具合。また、この曲はとても良い"}, {"type": "subtitle", "time": 10575.95, "timestamp": "02:56:15", "text": "W."}, {"type": "subtitle", "time": 10581.03, "timestamp": "02:56:21", "text": "つまり、それはタク・インウェイからのものです"}, {"type": "subtitle", "time": 10585.87, "timestamp": "02:56:25", "text": "えーと、タク・インウェイがプロデュースしました。"}, {"type": "subtitle", "time": 10599.99, "timestamp": "02:56:39", "text": "なし。よし、それでは本題に入ろう。"}, {"type": "subtitle", "time": 10613.79, "timestamp": "02:56:53", "text": "アドベンチャー"}, {"type": "subtitle", "time": 10616.59, "timestamp": "02:56:56", "text": "探査計画の開始"}]
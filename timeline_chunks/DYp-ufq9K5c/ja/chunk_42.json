[{"type": "subtitle", "time": 2520.91, "timestamp": "00:42:00", "text": "さっさとここから出て行け。"}, {"type": "subtitle", "time": 2523.589, "timestamp": "00:42:03", "text": "時々彼はただ"}, {"type": "subtitle", "time": 2526.23, "timestamp": "00:42:06", "text": "二。"}, {"type": "subtitle", "time": 2528.47, "timestamp": "00:42:08", "text": "そろそろ変化をつける時だ。"}, {"type": "subtitle", "time": 2530.63, "timestamp": "00:42:10", "text": "どちら側ですか。いやあ、それは素晴らしいと思いませんか？"}, {"type": "subtitle", "time": 2532.829, "timestamp": "00:42:12", "text": "それは"}, {"type": "subtitle", "time": 2535.91, "timestamp": "00:42:15", "text": "素晴らしい。えっと、"}, {"type": "subtitle", "time": 2537.75, "timestamp": "00:42:17", "text": "まず最初のポイントを狙います。そしてもし"}, {"type": "subtitle", "time": 2540.95, "timestamp": "00:42:20", "text": "彼らは最初のポイントを獲得し、"}, {"type": "subtitle", "time": 2542.55, "timestamp": "00:42:22", "text": "彼らが最初のポイントを取ったら、私は"}, {"type": "subtitle", "time": 2544.95, "timestamp": "00:42:24", "text": "最初に勝つために切り替える、なぜなら"}, {"type": "subtitle", "time": 2546.829, "timestamp": "00:42:26", "text": "アイアンマンは"}, {"type": "subtitle", "time": 2553.51, "timestamp": "00:42:33", "text": "また。このゲームは最高だよ。これ"}, {"type": "subtitle", "time": 2564.43, "timestamp": "00:42:44", "text": "[音楽]"}, {"type": "subtitle", "time": 2566.95, "timestamp": "00:42:46", "text": "爆弾。ところで皆さん、もしここにいらっしゃるなら、"}, {"type": "subtitle", "time": 2572.91, "timestamp": "00:42:52", "text": "ストリーム。もしあなたが私を気に入ってくれたら、ストリームを気に入ってくれたら、"}, {"type": "subtitle", "time": 2577.589, "timestamp": "00:42:57", "text": "メイト。君たちは僕のことが好きなんだね。彼らは"}]
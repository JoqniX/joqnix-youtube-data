[{"type": "subtitle", "time": 9122.309, "timestamp": "02:32:02", "text": "何だ、待て、何だ"}, {"type": "subtitle", "time": 9140.79, "timestamp": "02:32:20", "text": "わかった。私が遅れている間に。神を見よ"}, {"type": "subtitle", "time": 9143.59, "timestamp": "02:32:23", "text": "雷の。"}, {"type": "subtitle", "time": 9158.71, "timestamp": "02:32:38", "text": "何の理由もなく、これほどの被害が出たなんて。"}, {"type": "subtitle", "time": 9163.27, "timestamp": "02:32:43", "text": "精神崩壊。私の生命の源が露呈した。"}, {"type": "subtitle", "time": 9165.91, "timestamp": "02:32:45", "text": "私が手当てしてあげるよ。敵を追え。"}]
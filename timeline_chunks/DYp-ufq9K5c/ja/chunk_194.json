[{"type": "subtitle", "time": 11647.07, "timestamp": "03:14:07", "text": "洞窟。どれでも"}, {"type": "subtitle", "time": 11650.469, "timestamp": "03:14:10", "text": "斧、ココナッツドリンク。ココナッツがあります"}, {"type": "subtitle", "time": 11652.07, "timestamp": "03:14:12", "text": "パン。"}, {"type": "subtitle", "time": 11660.75, "timestamp": "03:14:20", "text": "飲む。ええと、乗り物、"}, {"type": "subtitle", "time": 11663.67, "timestamp": "03:14:23", "text": "船。いかだを作ることができます。私たちには"}, {"type": "subtitle", "time": 11666.389, "timestamp": "03:14:26", "text": "芝生屋根。工芸品を作るにはどうすればいいですか？"}, {"type": "subtitle", "time": 11668.51, "timestamp": "03:14:28", "text": "屋根？私は"}, {"type": "subtitle", "time": 11671.07, "timestamp": "03:14:31", "text": "これ。作成できますか"}, {"type": "subtitle", "time": 11675.11, "timestamp": "03:14:35", "text": "ラフト？いかだをすぐ上に置くことができます"}]
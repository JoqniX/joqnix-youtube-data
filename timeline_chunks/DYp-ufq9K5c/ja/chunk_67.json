[{"type": "subtitle", "time": 4022.39, "timestamp": "01:07:02", "text": "なんてこった。何てことだ。マックスが彼女を救った。"}, {"type": "subtitle", "time": 4036.63, "timestamp": "01:07:16", "text": "わかったよ、アイアンマン。それが3回目の戦いだ"}, {"type": "subtitle", "time": 4044.71, "timestamp": "01:07:24", "text": "それは彼の3回目の戦いのようなもので、ああ、"}, {"type": "subtitle", "time": 4048.71, "timestamp": "01:07:28", "text": "相棒。ボードゲームはクソみたいなD&Dだ。 DNDは"}, {"type": "subtitle", "time": 4052.069, "timestamp": "01:07:32", "text": "ボードゲームですよね？もうすぐだ。"}, {"type": "subtitle", "time": 4054.15, "timestamp": "01:07:34", "text": "もし間違っていたら訂正してくれよ。訂正してください"}, {"type": "subtitle", "time": 4056.789, "timestamp": "01:07:36", "text": "もし私が間違っていたら。"}, {"type": "subtitle", "time": 4060.549, "timestamp": "01:07:40", "text": "ああ、こんにちは、Wさん。元気ですか？"}, {"type": "subtitle", "time": 4065.029, "timestamp": "01:07:45", "text": "ああ、ここから出て行け。私は寒いのが好きだ。"}, {"type": "subtitle", "time": 4066.47, "timestamp": "01:07:46", "text": "調子はどうだい、坊や？元気ですか"}, {"type": "subtitle", "time": 4069.19, "timestamp": "01:07:49", "text": "何をしているの？ BRBストリーマーへようこそ。私"}, {"type": "subtitle", "time": 4074.15, "timestamp": "01:07:54", "text": "彼らが引き継いだ。それはすべての人にとっての赤です。"}]
[{"type": "subtitle", "time": 7562.47, "timestamp": "02:06:02", "text": "聞きました。"}, {"type": "subtitle", "time": 7564.709, "timestamp": "02:06:04", "text": "どのような意味で「ワイルド」なのか？"}, {"type": "subtitle", "time": 7567.149, "timestamp": "02:06:07", "text": "わからない。ただ、"}, {"type": "subtitle", "time": 7570.83, "timestamp": "02:06:10", "text": "知ってるよ、すごく違うんだ"}, {"type": "subtitle", "time": 7575.27, "timestamp": "02:06:15", "text": "経験。私の言っていることが分かるよね？"}, {"type": "subtitle", "time": 7577.51, "timestamp": "02:06:17", "text": "通常のTwitchやキックよりも、"}, {"type": "subtitle", "time": 7578.589, "timestamp": "02:06:18", "text": "何でも、"}, {"type": "subtitle", "time": 7582.99, "timestamp": "02:06:22", "text": "右？拡張機能の使い方"}, {"type": "subtitle", "time": 7587.83, "timestamp": "02:06:27", "text": "えっと、これですか？いや、これは違う。それは"}, {"type": "subtitle", "time": 7590.149, "timestamp": "02:06:30", "text": "どのヒーローが好きか"}, {"type": "subtitle", "time": 7596.47, "timestamp": "02:06:36", "text": "待って、何をプレイしようとしているの？"}, {"type": "subtitle", "time": 7598.55, "timestamp": "02:06:38", "text": "誰かが銀河を守らなければならない。かもしれない"}, {"type": "subtitle", "time": 7603.03, "timestamp": "02:06:43", "text": "同じように。これは自慢せずにはいられない。"}, {"type": "subtitle", "time": 7605.189, "timestamp": "02:06:45", "text": "誰かがラジェスとプリヤが"}, {"type": "subtitle", "time": 7607.51, "timestamp": "02:06:47", "text": "ビリー・ビリー・チャット。それはどういう意味ですか？私"}, {"type": "subtitle", "time": 7609.43, "timestamp": "02:06:49", "text": "理解できない。"}, {"type": "subtitle", "time": 7613.75, "timestamp": "02:06:53", "text": "わからない。ラージとプリヤ。わかった。私は"}, {"type": "subtitle", "time": 7616.709, "timestamp": "02:06:56", "text": "ラジェス。あなたはプリヤですね。やあ、プリヤ。どうやって"}, {"type": "subtitle", "time": 7619.43, "timestamp": "02:06:59", "text": "何をしているの？ええと、私はあなたがDだと思っていました。"}]
[{"type": "subtitle", "time": 18966.628, "timestamp": "05:16:06", "text": "バナナ。でも、そう、私は作らなければならない"}, {"type": "subtitle", "time": 18976.51, "timestamp": "05:16:16", "text": "えーと、武器、弾薬、矢。あなたには"}, {"type": "subtitle", "time": 18979.67, "timestamp": "05:16:19", "text": "羽毛、陸鳥、使用済み耕作機"}, {"type": "subtitle", "time": 19007.03, "timestamp": "05:16:47", "text": "あ、これはあそこに置けるよ。知っている"}, {"type": "subtitle", "time": 19009.39, "timestamp": "05:16:49", "text": "このエリアはまるでスーパー"}, {"type": "subtitle", "time": 19011.99, "timestamp": "05:16:51", "text": "大きいけど、そう、私は"}, {"type": "subtitle", "time": 19015.708, "timestamp": "05:16:55", "text": "家はあそこかここか"}, {"type": "subtitle", "time": 19018.948, "timestamp": "05:16:58", "text": "どこかで。構造を編集できますか？"}]
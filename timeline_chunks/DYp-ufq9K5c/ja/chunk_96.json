[{"type": "subtitle", "time": 5760.95, "timestamp": "01:36:00", "text": "まあ、ご存知の通り、あなたは加害者です。おお、"}, {"type": "subtitle", "time": 5764.79, "timestamp": "01:36:04", "text": "彼はどこから来たのか？奇妙な。"}, {"type": "subtitle", "time": 5765.99, "timestamp": "01:36:05", "text": "彼はかなり"}, {"type": "subtitle", "time": 5773.43, "timestamp": "01:36:13", "text": "恐れる必要はありません。シールドを手に入れた。あなた"}, {"type": "subtitle", "time": 5785.75, "timestamp": "01:36:25", "text": "あいつを捕まえろ。彼を捕まえろ。やったぜ、やっちまった。"}, {"type": "subtitle", "time": 5789.189, "timestamp": "01:36:29", "text": "ついに。誰かが彼を見ている。"}, {"type": "subtitle", "time": 5798.39, "timestamp": "01:36:38", "text": "ああ、そうそう。ニース。"}, {"type": "subtitle", "time": 5801.11, "timestamp": "01:36:41", "text": "盗まれた。それはおかしい。彼らはたくさん手に入れた"}, {"type": "subtitle", "time": 5803.75, "timestamp": "01:36:43", "text": "時間。"}, {"type": "subtitle", "time": 5805.99, "timestamp": "01:36:45", "text": "3分。それはとても長い時間です"}, {"type": "subtitle", "time": 5810.229, "timestamp": "01:36:50", "text": "それを保持してください。おい、俺は戦車を持ってないんだ。"}, {"type": "subtitle", "time": 5819.83, "timestamp": "01:36:59", "text": "裁判官、陪審員、死刑執行人。息子"}]
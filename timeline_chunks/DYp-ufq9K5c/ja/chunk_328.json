[{"type": "subtitle", "time": 19708.15, "timestamp": "05:28:28", "text": "聖なる。私は日中に閉じ込められているような気がする。"}, {"type": "subtitle", "time": 19711.91, "timestamp": "05:28:31", "text": "今はもう夜になっていない。午前"}, {"type": "subtitle", "time": 19715.47, "timestamp": "05:28:35", "text": "私は初日からずっと"}, {"type": "subtitle", "time": 19724.75, "timestamp": "05:28:44", "text": "面白い。シンプルな服、小さな"}, {"type": "subtitle", "time": 19727.83, "timestamp": "05:28:47", "text": "撃つ。ねえ、私、今鎧を着なきゃいけないの。"}, {"type": "subtitle", "time": 19730.628, "timestamp": "05:28:50", "text": "フレンドアーマー。"}]
[{"type": "subtitle", "time": 7380.55, "timestamp": "02:03:00", "text": "主。ここでくつろいで、ゲームをしていた"}, {"type": "subtitle", "time": 7382.75, "timestamp": "02:03:02", "text": "3月の復活。待っています"}, {"type": "subtitle", "time": 7385.87, "timestamp": "02:03:05", "text": "ジョック、戻ってきて、いい感じだよ"}, {"type": "subtitle", "time": 7388.95, "timestamp": "02:03:08", "text": "時間。のんびり過ごしていた。仕事が戻ってきた"}, {"type": "subtitle", "time": 7392.95, "timestamp": "02:03:12", "text": "数時間前に仕事から帰ってきた。あなた"}, {"type": "subtitle", "time": 7395.669, "timestamp": "02:03:15", "text": "それがどういうことか、仕事がどうなるか、あなたは知っています"}, {"type": "subtitle", "time": 7397.55, "timestamp": "02:03:17", "text": "なれ"}, {"type": "subtitle", "time": 7400.55, "timestamp": "02:03:20", "text": "時々。ええ、本当に疲れていました。私"}, {"type": "subtitle", "time": 7403.229, "timestamp": "02:03:23", "text": "すごく涼しくて寒い感じだった"}, {"type": "subtitle", "time": 7406.149, "timestamp": "02:03:26", "text": "シャワー。私は自分のためにお茶を淹れた。おお"}, {"type": "subtitle", "time": 7409.03, "timestamp": "02:03:29", "text": "うわー、すごかったよ。いくつかの"}, {"type": "subtitle", "time": 7413.189, "timestamp": "02:03:33", "text": "仕事の後の淹れたての紅茶のように"}, {"type": "subtitle", "time": 7415.27, "timestamp": "02:03:35", "text": "そしてシャワーを浴びた後、"}, {"type": "subtitle", "time": 7419.47, "timestamp": "02:03:39", "text": "家。おい、最高だ。だから、私は"}, {"type": "subtitle", "time": 7421.79, "timestamp": "02:03:41", "text": "リラックス、"}, {"type": "subtitle", "time": 7424.99, "timestamp": "02:03:44", "text": "リラックスして、"}, {"type": "subtitle", "time": 7427.35, "timestamp": "02:03:47", "text": "男の子たちは、まあ、ただ楽しんでいるだけだよ。"}, {"type": "subtitle", "time": 7428.91, "timestamp": "02:03:48", "text": "確認できたらいいのに"}, {"type": "subtitle", "time": 7432.39, "timestamp": "02:03:52", "text": "Twitchのチャットも同様です。つまり、いや、"}]
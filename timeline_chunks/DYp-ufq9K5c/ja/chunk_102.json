[{"type": "subtitle", "time": 6120.87, "timestamp": "01:42:00", "text": "PlayStationでプレイするか、"}, {"type": "subtitle", "time": 6123.91, "timestamp": "01:42:03", "text": "彼らはクソみたいな4060を持っている。"}, {"type": "subtitle", "time": 6127.189, "timestamp": "01:42:07", "text": "私は4090を持っています。"}, {"type": "subtitle", "time": 6128.95, "timestamp": "01:42:08", "text": "くたばれ。"}, {"type": "subtitle", "time": 6132.149, "timestamp": "01:42:12", "text": "実は4090を3枚持っています。"}, {"type": "subtitle", "time": 6133.51, "timestamp": "01:42:13", "text": "欲しいですか？私は最前線に立つ"}, {"type": "subtitle", "time": 6136.87, "timestamp": "01:42:16", "text": "線。いいえ。"}, {"type": "subtitle", "time": 6138.55, "timestamp": "01:42:18", "text": "おお。それに、私はノートパソコンを持っているので、"}, {"type": "subtitle", "time": 6140.229, "timestamp": "01:42:20", "text": "それがどのようにフィットするかを知る。しかたがない、"}, {"type": "subtitle", "time": 6141.75, "timestamp": "01:42:21", "text": "ノートパソコン。"}, {"type": "subtitle", "time": 6144.87, "timestamp": "01:42:24", "text": "ノートパソコンでのゲーム。君には借りがあるよ。彼は2つ持っている"}, {"type": "subtitle", "time": 6148.55, "timestamp": "01:42:28", "text": "電圧が上がったのは良いことだ。それは、えーと"}, {"type": "subtitle", "time": 6159.109, "timestamp": "01:42:39", "text": "俺はバッキーが大好きだよ。彼はすごくかっこいい。何"}, {"type": "subtitle", "time": 6160.709, "timestamp": "01:42:40", "text": "それらのモッドが壊れるのを見たことがありますか"}, {"type": "subtitle", "time": 6163.43, "timestamp": "01:42:43", "text": "彼らの土台に橋を架ける？今はまだです。"}, {"type": "subtitle", "time": 6165.91, "timestamp": "01:42:45", "text": "メイト。今はまだだめだ。あなたは"}, {"type": "subtitle", "time": 6167.39, "timestamp": "01:42:47", "text": "呪い"}, {"type": "subtitle", "time": 6175.03, "timestamp": "01:42:55", "text": "ちなみに、あいつは今、めちゃくちゃ人種差別的だ。"}]
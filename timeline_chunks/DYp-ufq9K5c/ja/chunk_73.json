[{"type": "subtitle", "time": 4409.35, "timestamp": "01:13:29", "text": "それが唯一の方法だ。ニース。ニース。"}, {"type": "subtitle", "time": 4418.63, "timestamp": "01:13:38", "text": "最大脈拍。え、私が吸ったの？私"}, {"type": "subtitle", "time": 4420.91, "timestamp": "01:13:40", "text": "吸わなかったよ。"}, {"type": "subtitle", "time": 4423.83, "timestamp": "01:13:43", "text": "地獄。これはまずい。本当に"}, {"type": "subtitle", "time": 4428.63, "timestamp": "01:13:48", "text": "この形式から外す。私たちは"}, {"type": "subtitle", "time": 4438.709, "timestamp": "01:13:58", "text": "うん。うん。うん。わかった。わかった。"}]
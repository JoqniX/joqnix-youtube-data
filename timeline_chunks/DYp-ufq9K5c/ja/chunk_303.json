[{"type": "subtitle", "time": 18181.35, "timestamp": "05:03:01", "text": "ああ、なるほど。えっと、ちょっと疑問があります。どうやって"}, {"type": "subtitle", "time": 18184.868, "timestamp": "05:03:04", "text": "木を収穫するのにどれくらい時間がかかりますか？"}, {"type": "subtitle", "time": 18188.15, "timestamp": "05:03:08", "text": "それとも、えっと、草みたいな？どのくらいかかりますか"}, {"type": "subtitle", "time": 18191.15, "timestamp": "05:03:11", "text": "テイクアウトのために"}, {"type": "subtitle", "time": 18195.19, "timestamp": "05:03:15", "text": "木のように植物が再び生える"}, {"type": "subtitle", "time": 18198.47, "timestamp": "05:03:18", "text": "再び生えてくる？そしてそれは常に続いていく"}, {"type": "subtitle", "time": 18201.11, "timestamp": "05:03:21", "text": "現実世界のように森林伐採される"}, {"type": "subtitle", "time": 18203.55, "timestamp": "05:03:23", "text": "あれの？摘み取る"}, {"type": "subtitle", "time": 18206.628, "timestamp": "05:03:26", "text": "植物がなくなったら、もうそこにはないだろう"}, {"type": "subtitle", "time": 18208.628, "timestamp": "05:03:28", "text": "計画していたのでなければ"}, {"type": "subtitle", "time": 18224.83, "timestamp": "05:03:44", "text": "バナナ。バナナ1本だけ。それはとても"}, {"type": "subtitle", "time": 18227.83, "timestamp": "05:03:47", "text": "詐欺。これはもっと多くのロットがあるように見える"}, {"type": "subtitle", "time": 18230.03, "timestamp": "05:03:50", "text": "の"}]
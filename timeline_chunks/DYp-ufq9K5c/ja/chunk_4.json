[{"type": "subtitle", "time": 242.789, "timestamp": "00:04:02", "text": "えっと、ちょっと待ってください。私は自分が"}, {"type": "subtitle", "time": 245.35, "timestamp": "00:04:05", "text": "今はエネルギーが不足している。その"}, {"type": "subtitle", "time": 247.869, "timestamp": "00:04:07", "text": "眠れなかったから"}, {"type": "subtitle", "time": 277.59000000000003, "timestamp": "00:04:37", "text": "大丈夫。残っているのはTwitterだけだ。ない"}, {"type": "subtitle", "time": 278.59000000000003, "timestamp": "00:04:38", "text": "ツイッター"}, {"type": "subtitle", "time": 282.87, "timestamp": "00:04:42", "text": "まるでInstagramだけが残っているかのように"}]
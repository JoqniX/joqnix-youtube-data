[{"type": "subtitle", "time": 9961.83, "timestamp": "02:46:01", "text": "なぜ私の犬が"}, {"type": "subtitle", "time": 9964.63, "timestamp": "02:46:04", "text": "Lapasが正常に動作していません。そうではありません"}, {"type": "subtitle", "time": 9967.83, "timestamp": "02:46:07", "text": "私がライブ配信中であることさえ表示します。"}, {"type": "subtitle", "time": 9990.469, "timestamp": "02:46:30", "text": "ゲーム。ゲームが好きだといいな"}, {"type": "subtitle", "time": 9993.51, "timestamp": "02:46:33", "text": "男。うん。うん。うん。わかった。私は"}, {"type": "subtitle", "time": 9995.19, "timestamp": "02:46:35", "text": "チャットを読んだり、ゲームをしたり。とても難しい"}, {"type": "subtitle", "time": 9997.67, "timestamp": "02:46:37", "text": "それを行うために。どうやってるのか分からない。"}, {"type": "subtitle", "time": 10000.63, "timestamp": "02:46:40", "text": "それはとても難しいことだ。どうやって"}, {"type": "subtitle", "time": 10002.469, "timestamp": "02:46:42", "text": "あなたもそうしてください。つまり、もしあなたが"}, {"type": "subtitle", "time": 10005.269, "timestamp": "02:46:45", "text": "複数のモニター、もしくは何か読むもの"}, {"type": "subtitle", "time": 10009.03, "timestamp": "02:46:49", "text": "横向きに使うなら、それでいい。しかし、その苦闘は"}, {"type": "subtitle", "time": 10011.99, "timestamp": "02:46:51", "text": "苦戦しているのはコラボエビです。"}, {"type": "subtitle", "time": 10013.75, "timestamp": "02:46:53", "text": "チャットを読んで、"}, {"type": "subtitle", "time": 10015.75, "timestamp": "02:46:55", "text": "彼ら。また、交流する必要もあります。"}, {"type": "subtitle", "time": 10019.91, "timestamp": "02:46:59", "text": "コラボレーションパートナーと共に。うん。わーい。私"}]
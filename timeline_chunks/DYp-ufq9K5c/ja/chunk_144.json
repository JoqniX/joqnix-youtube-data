[{"type": "subtitle", "time": 8640.389, "timestamp": "02:24:00", "text": "パークの混沌はあなたを"}, {"type": "subtitle", "time": 8642.309, "timestamp": "02:24:02", "text": "見えない代替手段？いいえ。そうです。彼女は行く"}, {"type": "subtitle", "time": 8649.27, "timestamp": "02:24:09", "text": "そう、だって即死だからね？おお、"}, {"type": "subtitle", "time": 8653.27, "timestamp": "02:24:13", "text": "彼女には一発のチャンスしかない。雷神。私"}, {"type": "subtitle", "time": 8655.349, "timestamp": "02:24:15", "text": "アベンジャーズへの道を知っている。くそ、彼は"}, {"type": "subtitle", "time": 8656.95, "timestamp": "02:24:16", "text": "1つ。"}, {"type": "subtitle", "time": 8660.03, "timestamp": "02:24:20", "text": "いいえ、韓国のリスではありません。"}, {"type": "subtitle", "time": 8668.469, "timestamp": "02:24:28", "text": "追い出されたんだよ。ああ、彼は大丈夫、"}, {"type": "subtitle", "time": 8695.03, "timestamp": "02:24:55", "text": "ほら、なんでみんな変なこと言うのか分からないよ"}, {"type": "subtitle", "time": 8696.87, "timestamp": "02:24:56", "text": "alt をうまく使いこなすのは本当に難しい。ちょうど手に入れた"}]
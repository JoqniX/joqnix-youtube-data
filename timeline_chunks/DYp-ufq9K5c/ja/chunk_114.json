[{"type": "subtitle", "time": 6842.39, "timestamp": "01:54:02", "text": "銃。もちろんさ。"}, {"type": "subtitle", "time": 6849.99, "timestamp": "01:54:09", "text": "無制限の弾薬を待っています。"}, {"type": "subtitle", "time": 6852.79, "timestamp": "01:54:12", "text": "ありがとう。"}, {"type": "subtitle", "time": 6855.43, "timestamp": "01:54:15", "text": "ああ、イエス様。"}, {"type": "subtitle", "time": 6858.47, "timestamp": "01:54:18", "text": "えっと、時々私は彼らが"}, {"type": "subtitle", "time": 6860.149, "timestamp": "01:54:20", "text": "究極の弾薬がそうではないとは知らなかった"}, {"type": "subtitle", "time": 6862.47, "timestamp": "01:54:22", "text": "つまり、私は究極の治癒効果を得るということだ。"}, {"type": "subtitle", "time": 6870.79, "timestamp": "01:54:30", "text": "そしてこれはまさに究極の弾薬だ。ああ、そうだ。"}, {"type": "subtitle", "time": 6873.91, "timestamp": "01:54:33", "text": "無制限。私のミスです。"}, {"type": "subtitle", "time": 6876.87, "timestamp": "01:54:36", "text": "よし、ベン10、落ち着け。"}, {"type": "subtitle", "time": 6879.589, "timestamp": "01:54:39", "text": "私のミスです。"}, {"type": "subtitle", "time": 6882.709, "timestamp": "01:54:42", "text": "ああ、大変だ。あなたは弱さでそれをしました"}, {"type": "subtitle", "time": 6884.79, "timestamp": "01:54:44", "text": "人間の目。"}]
[{"type": "subtitle", "time": 13501.269, "timestamp": "03:45:01", "text": "薬草療法。レザー。革の作り方は？"}, {"type": "subtitle", "time": 13504.189, "timestamp": "03:45:04", "text": "あらゆる媒体"}, {"type": "subtitle", "time": 13508.67, "timestamp": "03:45:08", "text": "隠れる、大きな隠れる、小さな隠れる"}, {"type": "subtitle", "time": 13511.08, "timestamp": "03:45:11", "text": "隠れる ナイフ。私は動物の皮を剥ぐことになっているのですが、"}, {"type": "subtitle", "time": 13514.479, "timestamp": "03:45:14", "text": "ナイフ。私は動物の皮を剥ぐことになっているのですが、 この中には動物はいません"}, {"type": "subtitle", "time": 13516.17, "timestamp": "03:45:16", "text": "この中には動物はいません [音楽]"}, {"type": "subtitle", "time": 13519.08, "timestamp": "03:45:19", "text": "[音楽] 場所。石油の看板があった。"}, {"type": "subtitle", "time": 13529.07, "timestamp": "03:45:29", "text": "おお。動物をどうやって"}, {"type": "subtitle", "time": 13531.83, "timestamp": "03:45:31", "text": "来る？まるで全ての動物が"}, {"type": "subtitle", "time": 13538.389, "timestamp": "03:45:38", "text": "去った。私はこのゲームをプレイしていました"}, {"type": "subtitle", "time": 13540.469, "timestamp": "03:45:40", "text": "初めて友達と一緒だった。私"}, {"type": "subtitle", "time": 13542.51, "timestamp": "03:45:42", "text": "彼は全員を殺したと信じている"}, {"type": "subtitle", "time": 13546.07, "timestamp": "03:45:46", "text": "動物たち。だから私はそうしなければならないと思う"}]
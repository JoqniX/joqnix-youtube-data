[{"type": "subtitle", "time": 18067.868, "timestamp": "05:01:07", "text": "あ、待って。これは株式になるのか"}, {"type": "subtitle", "time": 18076.35, "timestamp": "05:01:16", "text": "プレイヤー。ああ、最大限にプレイする。"}, {"type": "subtitle", "time": 18080.628, "timestamp": "05:01:20", "text": "ああ、私もできるよ。内容を変えることができる。私"}, {"type": "subtitle", "time": 18082.31, "timestamp": "05:01:22", "text": "名前は変更できません。そうみたいです"}, {"type": "subtitle", "time": 18084.75, "timestamp": "05:01:24", "text": "興味深いことに"}, {"type": "subtitle", "time": 18095.708, "timestamp": "05:01:35", "text": "外。ああ。"}, {"type": "subtitle", "time": 18098.91, "timestamp": "05:01:38", "text": "ああ、これはなかなか興味深いですね。"}, {"type": "subtitle", "time": 18101.67, "timestamp": "05:01:41", "text": "いいね。そして、プレイヤーカードを変更することもできます"}, {"type": "subtitle", "time": 18109.03, "timestamp": "05:01:49", "text": "ゲームを探索する前に"}, {"type": "subtitle", "time": 18111.27, "timestamp": "05:01:51", "text": "地図タイトルの終了。 Bをたくさん見つける"}, {"type": "subtitle", "time": 18112.628, "timestamp": "05:01:52", "text": "あなたが行きたい場所。はい、わかりました。手に入れた"}, {"type": "subtitle", "time": 18113.76, "timestamp": "05:01:53", "text": "それ。"}]
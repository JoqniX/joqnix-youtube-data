[{"type": "subtitle", "time": 1081.75, "timestamp": "00:18:01", "text": "そのパンをじっと見つめている。あなたはただ"}, {"type": "subtitle", "time": 1083.99, "timestamp": "00:18:03", "text": "私と会話をしている。くそ"}, {"type": "subtitle", "time": 1099.27, "timestamp": "00:18:19", "text": "お前は犬だ。自動販売機でボトル入りで販売されています"}, {"type": "subtitle", "time": 1100.63, "timestamp": "00:18:20", "text": "機械。その通り。それが私の"}, {"type": "subtitle", "time": 1103.75, "timestamp": "00:18:23", "text": "と言っている。それは革命的だ。欲しい"}, {"type": "subtitle", "time": 1113.39, "timestamp": "00:18:33", "text": "神よ、それは革命的だ、"}, {"type": "subtitle", "time": 1115.99, "timestamp": "00:18:35", "text": "ベイビー。かなり落ち込んでるよ、相棒。どういう意味ですか？"}, {"type": "subtitle", "time": 1117.83, "timestamp": "00:18:37", "text": "食べられたくない。彼こそがその人だ"}, {"type": "subtitle", "time": 1120.95, "timestamp": "00:18:40", "text": "私を食べている。そして彼は言った、「聞いたか？」"}, {"type": "subtitle", "time": 1122.789, "timestamp": "00:18:42", "text": "あのね？それを切り取ります。"}, {"type": "subtitle", "time": 1125.669, "timestamp": "00:18:45", "text": "タイムスタンプは何ですか？"}, {"type": "subtitle", "time": 1135.59, "timestamp": "00:18:55", "text": "18 183 36 とかそんな感じ。私はただ書くだけです"}]
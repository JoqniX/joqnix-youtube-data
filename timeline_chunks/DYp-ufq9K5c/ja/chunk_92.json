[{"type": "subtitle", "time": 5521.189, "timestamp": "01:32:01", "text": "時間とともに。来て。来て。来て。"}, {"type": "subtitle", "time": 5525.03, "timestamp": "01:32:05", "text": "それを失くしてはいけない。ああ、なんてこった。兄弟、私は思った"}, {"type": "subtitle", "time": 5527.35, "timestamp": "01:32:07", "text": "Mは奇妙なTPに向かっていたが、"}, {"type": "subtitle", "time": 5529.27, "timestamp": "01:32:09", "text": "時々、チームメイトが犬であることを忘れてしまう"}, {"type": "subtitle", "time": 5530.79, "timestamp": "01:32:10", "text": "くそっ。"}, {"type": "subtitle", "time": 5533.59, "timestamp": "01:32:13", "text": "そろそろ変化をつける時だ。"}, {"type": "subtitle", "time": 5541.189, "timestamp": "01:32:21", "text": "冬。ああ、スパイディ。犬を飼ってもいいですか？"}, {"type": "subtitle", "time": 5550.87, "timestamp": "01:32:30", "text": "おいおい、頼むよ。来て。来て。"}, {"type": "subtitle", "time": 5554.79, "timestamp": "01:32:34", "text": "おいおい、頼むよ。何かが必要だ。"}, {"type": "subtitle", "time": 5557.51, "timestamp": "01:32:37", "text": "来て。来て。私のバカな友達を見てください"}, {"type": "subtitle", "time": 5564.229, "timestamp": "01:32:44", "text": "スパイダーマンは行かないだろう"}, {"type": "subtitle", "time": 5568.87, "timestamp": "01:32:48", "text": "非常に良い。第2ラウンド。行く。私たちは"}, {"type": "subtitle", "time": 5572.07, "timestamp": "01:32:52", "text": "これらの人間に与えるべきだ。"}, {"type": "subtitle", "time": 5574.629, "timestamp": "01:32:54", "text": "そして、私たちの唯一のタンクは4歳で"}, {"type": "subtitle", "time": 5576.79, "timestamp": "01:32:56", "text": "現時点で5人。"}, {"type": "subtitle", "time": 5579.83, "timestamp": "01:32:59", "text": "いやいや、確か「I'm Sigma」だったと思う。私は"}]
[{"type": "subtitle", "time": 8222.23, "timestamp": "02:17:02", "text": "いやー、あの番組は本当に面白かった。ヴェノム"}, {"type": "subtitle", "time": 8225.349, "timestamp": "02:17:05", "text": "『スペクタキュラー・スパイダーマン』のアーク。ああ、"}, {"type": "subtitle", "time": 8228.91, "timestamp": "02:17:08", "text": "ああ、あれは本当に美味しかった。とても良い。 Hは良い"}, {"type": "subtitle", "time": 8232.99, "timestamp": "02:17:12", "text": "書き込み。とても良い。私は良質な文章が好きです。"}, {"type": "subtitle", "time": 8235.75, "timestamp": "02:17:15", "text": "すべて。私が"}, {"type": "subtitle", "time": 8237.79, "timestamp": "02:17:17", "text": "アルティメット・スパイダーマンは"}, {"type": "subtitle", "time": 8240.469, "timestamp": "02:17:20", "text": "マルチバースの側面。あなたが知っている"}, {"type": "subtitle", "time": 8242.309, "timestamp": "02:17:22", "text": "何？ええ、まさにその通りです。 MCUの件ですが、"}, {"type": "subtitle", "time": 8244.549, "timestamp": "02:17:24", "text": "右？彼らがいた場所はまるで"}, {"type": "subtitle", "time": 8247.669, "timestamp": "02:17:27", "text": "とても広大だ。みんなここにいるけど、"}, {"type": "subtitle", "time": 8249.429, "timestamp": "02:17:29", "text": "依然としてこのような低レベルの問題が発生しています"}, {"type": "subtitle", "time": 8251.83, "timestamp": "02:17:31", "text": "どういうわけか、誰も私たちを助けてくれない。そして、そして"}, {"type": "subtitle", "time": 8254.15, "timestamp": "02:17:34", "text": "そして、ウルヴァリンを覚えておいてください"}, {"type": "subtitle", "time": 8257.429, "timestamp": "02:17:37", "text": "その番組の声優は"}, {"type": "subtitle", "time": 8260.629, "timestamp": "02:17:40", "text": "おそらく同じものだった"}, {"type": "subtitle", "time": 8264.07, "timestamp": "02:17:44", "text": "おそらくずっと同じクソ野郎だ。"}, {"type": "subtitle", "time": 8265.669, "timestamp": "02:17:45", "text": "うん。"}, {"type": "subtitle", "time": 8268.23, "timestamp": "02:17:48", "text": "くそ。我々には戦車はありません。"}, {"type": "subtitle", "time": 8271.589, "timestamp": "02:17:51", "text": "私は誰？想像してみてください"}, {"type": "subtitle", "time": 8274.87, "timestamp": "02:17:54", "text": "戦車なんて誰が必要とするんだ？"}, {"type": "subtitle", "time": 8278.389, "timestamp": "02:17:58", "text": "君はウルヴァリンだ。君は負けることができる。"}]
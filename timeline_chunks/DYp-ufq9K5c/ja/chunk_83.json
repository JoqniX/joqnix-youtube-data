[{"type": "subtitle", "time": 4981.99, "timestamp": "01:23:01", "text": "彼女は家を心底嫌っているからそこにいるんだ。そして"}, {"type": "subtitle", "time": 4984.07, "timestamp": "01:23:04", "text": "「ああ、家が嫌いだ」"}, {"type": "subtitle", "time": 4987.43, "timestamp": "01:23:07", "text": "良い。だから私は去ったんだ。」なんてこった。ああ"}, {"type": "subtitle", "time": 4989.11, "timestamp": "01:23:09", "text": "我が神よ。"}, {"type": "subtitle", "time": 4991.59, "timestamp": "01:23:11", "text": "すごく共感できる。"}, {"type": "subtitle", "time": 4993.99, "timestamp": "01:23:13", "text": "よし。何を禁止するのですか？"}, {"type": "subtitle", "time": 4995.59, "timestamp": "01:23:15", "text": "私が禁止しているのは何ですか？私のチームメイトは"}, {"type": "subtitle", "time": 4999.27, "timestamp": "01:23:19", "text": "それを禁止する。わかった。ただ見ているだけです。私は"}, {"type": "subtitle", "time": 5001.189, "timestamp": "01:23:21", "text": "何も問題がないことを確認するだけ"}, {"type": "subtitle", "time": 5004.629, "timestamp": "01:23:24", "text": "禁止。ただ見ているだけです。私はただ"}, {"type": "subtitle", "time": 5006.75, "timestamp": "01:23:26", "text": "彼と話してみて。私は話したい"}, {"type": "subtitle", "time": 5009.59, "timestamp": "01:23:29", "text": "彼。うん。みんな同じように追放される"}, {"type": "subtitle", "time": 5015.27, "timestamp": "01:23:35", "text": "では、禁止システムについて説明します。"}, {"type": "subtitle", "time": 5017.27, "timestamp": "01:23:37", "text": "サーバーとかそういうのが違うんだよ。"}, {"type": "subtitle", "time": 5019.03, "timestamp": "01:23:39", "text": "シンガポールでは、グルートに会えるよ。"}, {"type": "subtitle", "time": 5021.51, "timestamp": "01:23:41", "text": "バンドとスパイダーマンはよく禁止されている。で"}, {"type": "subtitle", "time": 5024.47, "timestamp": "01:23:44", "text": "EUサーバーでは、ルナと言うことになるでしょう"}, {"type": "subtitle", "time": 5028.07, "timestamp": "01:23:48", "text": "そしてグルート。大丈夫です。つまり、グルートは"}, {"type": "subtitle", "time": 5031.99, "timestamp": "01:23:51", "text": "どこにでも共通する要素、"}, {"type": "subtitle", "time": 5035.43, "timestamp": "01:23:55", "text": "兄弟。人間は馬鹿だ。"}, {"type": "subtitle", "time": 5037.91, "timestamp": "01:23:57", "text": "北米サーバーでは、グルートはよくBANされる。"}, {"type": "subtitle", "time": 5039.99, "timestamp": "01:23:59", "text": "同じように。私の友達が私に言ってた"}]
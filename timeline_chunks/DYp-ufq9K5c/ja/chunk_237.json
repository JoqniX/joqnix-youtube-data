[{"type": "subtitle", "time": 14245.269, "timestamp": "03:57:25", "text": "ニース。追加してください。供給源が必要です"}, {"type": "subtitle", "time": 14249.59, "timestamp": "03:57:29", "text": "光から「ああ、そうだ」へ。どうして聞き忘れたんだろう"}, {"type": "subtitle", "time": 14251.389, "timestamp": "03:57:31", "text": "どうすれば"}, {"type": "subtitle", "time": 14254.269, "timestamp": "03:57:34", "text": "どうやって作るか"}, {"type": "subtitle", "time": 14257.189, "timestamp": "03:57:37", "text": "灯台船？私は遊牧民として暮らしている"}, {"type": "subtitle", "time": 14258.91, "timestamp": "03:57:38", "text": "私の船での生活は私の"}, {"type": "subtitle", "time": 14264.349, "timestamp": "03:57:44", "text": "ベース。おお、遊牧民のような生活も送れるんですね。"}]
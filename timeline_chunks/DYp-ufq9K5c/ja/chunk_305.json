[{"type": "subtitle", "time": 18300.868, "timestamp": "05:05:00", "text": "神。何てことだ。修理する必要がある"}, {"type": "subtitle", "time": 18302.19, "timestamp": "05:05:02", "text": "ボート、私は"}, {"type": "subtitle", "time": 18322.868, "timestamp": "05:05:22", "text": "2、3個置いて、作り方を待つ"}, {"type": "subtitle", "time": 18325.11, "timestamp": "05:05:25", "text": "収納箱　それを聞くのを忘れていました"}, {"type": "subtitle", "time": 18327.47, "timestamp": "05:05:27", "text": "それは今重要です"}, {"type": "subtitle", "time": 18337.48, "timestamp": "05:05:37", "text": "今はストレージを探す必要がある"}, {"type": "subtitle", "time": 18347.99, "timestamp": "05:05:47", "text": "もしそれがMinecraftだったら"}, {"type": "subtitle", "time": 18352.27, "timestamp": "05:05:52", "text": "簡単だった。木材をいくつか作るだけ"}]
[{"type": "subtitle", "time": 4146.87, "timestamp": "01:09:06", "text": "一体どこへ行くつもりですか？"}, {"type": "subtitle", "time": 4170.39, "timestamp": "01:09:30", "text": "彼は皆からボコボコにされた。大好きです。"}, {"type": "subtitle", "time": 4173.269, "timestamp": "01:09:33", "text": "ただ光を受け入れなさい。"}, {"type": "subtitle", "time": 4181.349, "timestamp": "01:09:41", "text": "残り時間はわずか60秒。"}, {"type": "subtitle", "time": 4183.309, "timestamp": "01:09:43", "text": "これは"}, {"type": "subtitle", "time": 4184.13, "timestamp": "01:09:44", "text": "[音楽]"}, {"type": "subtitle", "time": 4185.709, "timestamp": "01:09:45", "text": "[拍手]"}, {"type": "subtitle", "time": 4190.47, "timestamp": "01:09:50", "text": "1つ手に入れた。あと少しだったのに。"}, {"type": "subtitle", "time": 4192.269, "timestamp": "01:09:52", "text": "あ、こんにちは。"}, {"type": "subtitle", "time": 4195.43, "timestamp": "01:09:55", "text": "マグリーの処刑。彼はどこにいますか？ああ、何"}, {"type": "subtitle", "time": 4197.51, "timestamp": "01:09:57", "text": "の"}, {"type": "subtitle", "time": 4199.99, "timestamp": "01:09:59", "text": "うわー、このパン屋さん、本当に上手だね。彼"}]
[{"type": "subtitle", "time": 16154.11, "timestamp": "04:29:14", "text": "うわあ、すごいね。くそ、これは"}, {"type": "subtitle", "time": 16157.309, "timestamp": "04:29:17", "text": "いいね。私も行きたい"}, {"type": "subtitle", "time": 16158.83, "timestamp": "04:29:18", "text": "これ"}, {"type": "subtitle", "time": 16161.91, "timestamp": "04:29:21", "text": "レベル。それはあなたが努力したことを意味します"}, {"type": "subtitle", "time": 16174.55, "timestamp": "04:29:34", "text": "ああ、スティーブ・シェパルですね。ああ、これだ。"}, {"type": "subtitle", "time": 16177.91, "timestamp": "04:29:37", "text": "あなたは本当に頑張ったね。 comにアップグレードしました"}, {"type": "subtitle", "time": 16180.63, "timestamp": "04:29:40", "text": "車両輸送船は完全に"}, {"type": "subtitle", "time": 16182.469, "timestamp": "04:29:42", "text": "クラフトステーションの在庫と"}, {"type": "subtitle", "time": 16184.71, "timestamp": "04:29:44", "text": "ストレージ。 6枚の帆。 4つのヤンドミウム"}, {"type": "subtitle", "time": 16188.269, "timestamp": "04:29:48", "text": "エンジン。安全なドアを備えた4つのベッド"}, {"type": "subtitle", "time": 16190.87, "timestamp": "04:29:50", "text": "船のセクションへのドア"}, {"type": "subtitle", "time": 16194.349, "timestamp": "04:29:54", "text": "必要だ。成長する港湾。ああ、"}, {"type": "subtitle", "time": 16199.389, "timestamp": "04:29:59", "text": "神。これはなんて"}]
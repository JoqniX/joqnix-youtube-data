[{"type": "subtitle", "time": 16020.269, "timestamp": "04:27:00", "text": "作業台？これはすごい"}, {"type": "subtitle", "time": 16023.75, "timestamp": "04:27:03", "text": "機械？織機もあるよ。何"}, {"type": "subtitle", "time": 16027.07, "timestamp": "04:27:07", "text": "これは別のエリアですか？これもダンスですか？"}, {"type": "subtitle", "time": 16030.75, "timestamp": "04:27:10", "text": "ダンスフロアとか何か？私はしません"}, {"type": "subtitle", "time": 16033.429, "timestamp": "04:27:13", "text": "知る。これは何ですか？これはすごくクールだ。私"}, {"type": "subtitle", "time": 16036.309, "timestamp": "04:27:16", "text": "内装を見てください。待って、私はどこにいるの？"}, {"type": "subtitle", "time": 16039.469, "timestamp": "04:27:19", "text": "私も行くの？ここはどこ？"}, {"type": "subtitle", "time": 16042.349, "timestamp": "04:27:22", "text": "えっと、ここはどこですか？道に迷いました。"}, {"type": "subtitle", "time": 16045.87, "timestamp": "04:27:25", "text": "えっと、電話してください。"}, {"type": "subtitle", "time": 16048.87, "timestamp": "04:27:28", "text": "うーん、このゲームすごく面白い。したい"}, {"type": "subtitle", "time": 16053.469, "timestamp": "04:27:33", "text": "頑張れよ。あるいは、そんな感じ。いいえ。えっと、"}, {"type": "subtitle", "time": 16055.95, "timestamp": "04:27:35", "text": "私が見るように"}, {"type": "subtitle", "time": 16058.229, "timestamp": "04:27:38", "text": "鍵。ロックできると想像してみてください"}, {"type": "subtitle", "time": 16060.229, "timestamp": "04:27:40", "text": "食器棚とか、そういうもの。それはそうなるでしょう"}, {"type": "subtitle", "time": 16063.269, "timestamp": "04:27:43", "text": "現実的。現実的。ここに狩猟場があった"}, {"type": "subtitle", "time": 16064.269, "timestamp": "04:27:44", "text": "ぶっきらぼう"}, {"type": "subtitle", "time": 16067.229, "timestamp": "04:27:47", "text": "ライフル。ニース"}, {"type": "subtitle", "time": 16071.87, "timestamp": "04:27:51", "text": "絵を描く。ああ、二階だ"}, {"type": "subtitle", "time": 16077.229, "timestamp": "04:27:57", "text": "バージョン。素敵な涼しげな装飾ですね。良い"}]
[{"type": "subtitle", "time": 5404.95, "timestamp": "01:30:04", "text": "再び動き出す。"}, {"type": "subtitle", "time": 5407.35, "timestamp": "01:30:07", "text": "ああ、そいつを捕まえろ。来て。来て。"}, {"type": "subtitle", "time": 5409.189, "timestamp": "01:30:09", "text": "捕まえたぞ。おっと、スパイダーマンが何かしたみたいだ。"}, {"type": "subtitle", "time": 5411.51, "timestamp": "01:30:11", "text": "さあ行こう。さあ行こうぜ、相棒。ウェブができます。"}, {"type": "subtitle", "time": 5413.51, "timestamp": "01:30:13", "text": "ウェブができます。厄介なことになりそうだ。私は"}, {"type": "subtitle", "time": 5414.95, "timestamp": "01:30:14", "text": "キャプテンを捕まえるつもりだ、絶対に"}, {"type": "subtitle", "time": 5422.47, "timestamp": "01:30:22", "text": "キャプテン・アメリカ。こっちへ来いよ、相棒。欲しい"}, {"type": "subtitle", "time": 5424.47, "timestamp": "01:30:24", "text": "ただ話したいだけなんです。私"}, {"type": "subtitle", "time": 5434.709, "timestamp": "01:30:34", "text": "PPMの私の上司です。"}, {"type": "subtitle", "time": 5437.59, "timestamp": "01:30:37", "text": "お前。なんてこった？クローンを手に入れた。私"}, {"type": "subtitle", "time": 5440.79, "timestamp": "01:30:40", "text": "転勤手当はもらえなかった。ちくしょう。 A"}, {"type": "subtitle", "time": 5442.95, "timestamp": "01:30:42", "text": "まだ怒りは収まらない。来て。ああ、私は"}, {"type": "subtitle", "time": 5453.03, "timestamp": "01:30:53", "text": "ああ、絡まってしまった。"}, {"type": "subtitle", "time": 5456.39, "timestamp": "01:30:56", "text": "わかった。月はまるで戦車のようにそれを飲み込んだ。"}]
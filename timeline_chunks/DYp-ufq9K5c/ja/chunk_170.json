[{"type": "subtitle", "time": 10201.75, "timestamp": "02:50:01", "text": "またしても壮大な勝利。ああ、君の勝ちだ。"}, {"type": "subtitle", "time": 10204.389, "timestamp": "02:50:04", "text": "さあ行こう。"}, {"type": "subtitle", "time": 10209.59, "timestamp": "02:50:09", "text": "我々が勝利を収めた。"}, {"type": "subtitle", "time": 10211.51, "timestamp": "02:50:11", "text": "もしかしたら、私は吹き替え版を理解できるのかもしれない。私はかなり"}, {"type": "subtitle", "time": 10215.83, "timestamp": "02:50:15", "text": "良い。はい。うん。そう言ってください。"}, {"type": "subtitle", "time": 10227.67, "timestamp": "02:50:27", "text": "サーバー全体のプレイヤーの90.58%。得る"}, {"type": "subtitle", "time": 10232.87, "timestamp": "02:50:32", "text": "調理済み。非常識な。調理済み。非常識な。得る"}, {"type": "subtitle", "time": 10236.63, "timestamp": "02:50:36", "text": "調理済みだよ、子供たち。君たちはホットで詰まっている"}, {"type": "subtitle", "time": 10238.99, "timestamp": "02:50:38", "text": "金。私はプラチナムの世界にいます"}, {"type": "subtitle", "time": 10242.87, "timestamp": "02:50:42", "text": "1つ。ここから出て行け。"}, {"type": "subtitle", "time": 10245.59, "timestamp": "02:50:45", "text": "えっと、じゃああなたが引き継ぐってこと？"}, {"type": "subtitle", "time": 10247.83, "timestamp": "02:50:47", "text": "うん。"}, {"type": "subtitle", "time": 10249.83, "timestamp": "02:50:49", "text": "引き継ぎます。"}, {"type": "subtitle", "time": 10252.07, "timestamp": "02:50:52", "text": "どのゲームをプレイしたらいいのか迷っています。病気"}, {"type": "subtitle", "time": 10253.99, "timestamp": "02:50:53", "text": "ショーを再生してもいいですか？"}, {"type": "subtitle", "time": 10256.389, "timestamp": "02:50:56", "text": "ゲームをして少し探索してみませんか？うん。うん。"}, {"type": "subtitle", "time": 10258.389, "timestamp": "02:50:58", "text": "うん。頼むから頑張ってくれ、俺にはクソがないんだ"}]
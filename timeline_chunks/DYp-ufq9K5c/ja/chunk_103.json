[{"type": "subtitle", "time": 6184.47, "timestamp": "01:43:04", "text": "彼らはそこから来ている。悟空の休息。"}, {"type": "subtitle", "time": 6186.39, "timestamp": "01:43:06", "text": "おお。おお。おお。ここに戻ってきてください。あと4人"}, {"type": "subtitle", "time": 6187.75, "timestamp": "01:43:07", "text": "上。あと4人。あと4人。さあ"}, {"type": "subtitle", "time": 6190.87, "timestamp": "01:43:10", "text": "行く。あいつのケツにレーザーを照射しろ。おい、どうやって"}, {"type": "subtitle", "time": 6192.87, "timestamp": "01:43:12", "text": "スライド？"}, {"type": "subtitle", "time": 6199.47, "timestamp": "01:43:19", "text": "おお、"}, {"type": "subtitle", "time": 6202.87, "timestamp": "01:43:22", "text": "彼女は「彼らは何を持っているの？」と尋ねた。よし、これは"}, {"type": "subtitle", "time": 6205.59, "timestamp": "01:43:25", "text": "良い。"}, {"type": "subtitle", "time": 6207.55, "timestamp": "01:43:27", "text": "の"}, {"type": "subtitle", "time": 6211.03, "timestamp": "01:43:31", "text": "問題はここです。掴みたい"}, {"type": "subtitle", "time": 6212.47, "timestamp": "01:43:32", "text": "それ。"}, {"type": "subtitle", "time": 6232.629, "timestamp": "01:43:52", "text": "こっちへおいで、マグ。ずっと良くなった。ああ、人間よ"}]
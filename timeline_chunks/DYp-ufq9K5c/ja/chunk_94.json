[{"type": "subtitle", "time": 5649.95, "timestamp": "01:34:09", "text": "死ね、死ね、死ね、"}, {"type": "subtitle", "time": 5653.75, "timestamp": "01:34:13", "text": "死ぬ。彼はまだ落ち込んでいるよ、みんな。撮影してもいいですか？"}, {"type": "subtitle", "time": 5662.629, "timestamp": "01:34:22", "text": "ああ、みんな死んでしまった。私のは最悪だ。メッド"}, {"type": "subtitle", "time": 5664.31, "timestamp": "01:34:24", "text": "は"}, {"type": "subtitle", "time": 5672.39, "timestamp": "01:34:32", "text": "とにかく出て行け。出て行け。出て行け。彼らは"}, {"type": "subtitle", "time": 5675.43, "timestamp": "01:34:35", "text": "フェードを走らせる。おい、一体どういうことだ？"}, {"type": "subtitle", "time": 5677.189, "timestamp": "01:34:37", "text": "戦車2両。もちろん私はクソしてる"}, {"type": "subtitle", "time": 5679.75, "timestamp": "01:34:39", "text": "クソをやれ。彼らは2人いる。彼はすべてを"}, {"type": "subtitle", "time": 5683.03, "timestamp": "01:34:43", "text": "下。この保護は長くは続かないだろう。"}, {"type": "subtitle", "time": 5684.87, "timestamp": "01:34:44", "text": "なんてこった？彼が全部どこに置いたか知ってるよね"}, {"type": "subtitle", "time": 5688.149, "timestamp": "01:34:48", "text": "下？薄気味の悪い小さな路地で。"}, {"type": "subtitle", "time": 5690.39, "timestamp": "01:34:50", "text": "兄弟、"}, {"type": "subtitle", "time": 5692.55, "timestamp": "01:34:52", "text": "この男。いやいや、彼は"}, {"type": "subtitle", "time": 5694.47, "timestamp": "01:34:54", "text": "路地裏にあるやつ。まさにその通りだ。"}, {"type": "subtitle", "time": 5696.55, "timestamp": "01:34:56", "text": "まさにその通り。ああ、まさにその通りだ。"}]
[{"type": "subtitle", "time": 12784.15, "timestamp": "03:33:04", "text": "相信别人很难。规则太多了。"}, {"type": "subtitle", "time": 12791.99, "timestamp": "03:33:11", "text": "挂机超过10分钟会被严格"}, {"type": "subtitle", "time": 12796.79, "timestamp": "03:33:16", "text": "禁止。所以我被封号好多次了。"}, {"type": "subtitle", "time": 12808.71, "timestamp": "03:33:28", "text": "你可以创建一个像这样的地图。我"}, {"type": "subtitle", "time": 12812.95, "timestamp": "03:33:32", "text": "以前从没见过。什么？自行车。"}, {"type": "subtitle", "time": 12816.07, "timestamp": "03:33:36", "text": "等等，那是海洋啊。你怎么过"}, {"type": "subtitle", "time": 12819.03, "timestamp": "03:33:39", "text": "海？哦，怪不得"}, {"type": "subtitle", "time": 12822.07, "timestamp": "03:33:42", "text": "你说坐渡轮。"}, {"type": "subtitle", "time": 12836.229, "timestamp": "03:33:56", "text": "太酷了。"}, {"type": "subtitle", "time": 12838.309, "timestamp": "03:33:58", "text": "你不能绕圈。是的，你不能"}]
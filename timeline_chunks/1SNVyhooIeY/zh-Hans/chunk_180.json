[{"type": "subtitle", "time": 10808.15, "timestamp": "03:00:08", "text": "所以，我想这是她和这个。"}, {"type": "subtitle", "time": 10815.75, "timestamp": "03:00:15", "text": "有时候我会遇到困难，特别是"}, {"type": "subtitle", "time": 10818.71, "timestamp": "03:00:18", "text": "边缘线[音乐]，"}, {"type": "subtitle", "time": 10820.95, "timestamp": "03:00:20", "text": "边缘线也是。"}, {"type": "subtitle", "time": 10822.95, "timestamp": "03:00:22", "text": "呃，"}, {"type": "subtitle", "time": 10827.429, "timestamp": "03:00:27", "text": "右边的孔线。"}, {"type": "subtitle", "time": 10829.67, "timestamp": "03:00:29", "text": "嗯，"}, {"type": "subtitle", "time": 10833.51, "timestamp": "03:00:33", "text": "是这样吗？ 我忘了。 是的，"}, {"type": "subtitle", "time": 10838.23, "timestamp": "03:00:38", "text": "笔画顺序错了。 如何？ 等等，什么？"}, {"type": "subtitle", "time": 10853.429, "timestamp": "03:00:53", "text": "你先做科比的招式。 啊。 哦，是的。 哦，是的"}, {"type": "subtitle", "time": 10854.15, "timestamp": "03:00:54", "text": "。  [笑声]"}, {"type": "subtitle", "time": 10857.19, "timestamp": "03:00:57", "text": "哦，是的。 我忘了。  [倒吸一口气]"}]
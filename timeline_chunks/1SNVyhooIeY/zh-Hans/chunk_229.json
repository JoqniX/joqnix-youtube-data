[{"type": "subtitle", "time": 13771.269, "timestamp": "03:49:31", "text": "世界上有些地方很奇怪，"}, {"type": "subtitle", "time": 13773.03, "timestamp": "03:49:33", "text": "比如很多阿拉伯国家"}, {"type": "subtitle", "time": 13775.59, "timestamp": "03:49:35", "text": "不允许你入境，但"}, {"type": "subtitle", "time": 13777.83, "timestamp": "03:49:37", "text": "实际上却给你盖章签证。所以，是不是像"}, {"type": "subtitle", "time": 13779.429, "timestamp": "03:49:39", "text": "大多数国家一样，护照上会贴一张单独的纸片，盖上章"}, {"type": "subtitle", "time": 13782.309, "timestamp": "03:49:42", "text": "？"}]
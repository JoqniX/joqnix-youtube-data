[{"type": "subtitle", "time": 5463.43, "timestamp": "01:31:03", "text": "翻译器，它说的却是别的。"}, {"type": "subtitle", "time": 5465.75, "timestamp": "01:31:05", "text": "当时一切都乱成一团。 于是我"}, {"type": "subtitle", "time": 5469.51, "timestamp": "01:31:09", "text": "就想，好吧，那我还是学语言吧。"}, {"type": "subtitle", "time": 5473.35, "timestamp": "01:31:13", "text": "如果我在一个日本的直播平台上直播，"}, {"type": "subtitle", "time": 5476.07, "timestamp": "01:31:16", "text": "比如像Nikon"}, {"type": "subtitle", "time": 5479.27, "timestamp": "01:31:19", "text": "Niko这样的平台，对吧？Nikon Niko"}, {"type": "subtitle", "time": 5481.35, "timestamp": "01:31:21", "text": "Nikon Niko，如果我必须在那里直播，那"}, {"type": "subtitle", "time": 5483.59, "timestamp": "01:31:23", "text": "完全是日语平台，"}, {"type": "subtitle", "time": 5487.03, "timestamp": "01:31:27", "text": "只有日本人知道那个平台。在那里，我"}, {"type": "subtitle", "time": 5490.47, "timestamp": "01:31:30", "text": "可以说日语，我可以尝试理解别人，"}, {"type": "subtitle", "time": 5493.59, "timestamp": "01:31:33", "text": "也能明白他们在"}, {"type": "subtitle", "time": 5496.39, "timestamp": "01:31:36", "text": "说什么，但是中文我完全不懂，"}, {"type": "subtitle", "time": 5498.629, "timestamp": "01:31:38", "text": "就算我看"}, {"type": "subtitle", "time": 5500.39, "timestamp": "01:31:40", "text": "中文动漫，我也听不懂"}, {"type": "subtitle", "time": 5503.59, "timestamp": "01:31:43", "text": "他们在说什么。   是"}, {"type": "chat", "time": 5505.365, "timestamp": "01:31:45", "author": "@FEROCIOUS_Grrr", "avatar": "https://yt4.ggpht.com/b2fcSyaRaGAEUJaW8yBs5ibxfiDi-brp1G8cHHTYAXKaRusaeuWU68kOjIUNWz1gmVNNSGP5MQ=s64-c-k-c0x00ffffff-no-rj", "message": "i know english,hindi,german and if i include native then i also know maghi , bojhpuri , and a little bit marathi "}, {"type": "subtitle", "time": 5507.27, "timestamp": "01:31:47", "text": "啊，所以我一直很纳闷，"}, {"type": "subtitle", "time": 5513.03, "timestamp": "01:31:53", "text": "我怎么能听懂日语呢？"}, {"type": "subtitle", "time": 5515.11, "timestamp": "01:31:55", "text": "是因为我看了太多动漫，"}, {"type": "subtitle", "time": 5518.95, "timestamp": "01:31:58", "text": "所以才能理解"}]
[{"type": "subtitle", "time": 8521.59, "timestamp": "02:22:01", "text": "[笑声] 是的"}, {"type": "subtitle", "time": 8527.03, "timestamp": "02:22:07", "text": "所以，"}, {"type": "subtitle", "time": 8529.27, "timestamp": "02:22:09", "text": "我们每周一到周五都会唱歌。 如果"}, {"type": "subtitle", "time": 8530.87, "timestamp": "02:22:10", "text": "你有机会过来，想不想录"}, {"type": "subtitle", "time": 8532.87, "timestamp": "02:22:12", "text": "首歌让我唱给你听？ 好了，"}, {"type": "subtitle", "time": 8537.11, "timestamp": "02:22:17", "text": "我们走吧。 我会过来的。   走吧"}, {"type": "subtitle", "time": 8538.87, "timestamp": "02:22:18", "text": "。"}, {"type": "subtitle", "time": 8540.63, "timestamp": "02:22:20", "text": "你是如何录制你的"}, {"type": "subtitle", "time": 8544.15, "timestamp": "02:22:24", "text": "唱歌直播的？ 哦，你喜欢吗？"}, {"type": "subtitle", "time": 8546.63, "timestamp": "02:22:26", "text": "你唱歌怎么样？ 现在已经过了中午。"}, {"type": "subtitle", "time": 8549.19, "timestamp": "02:22:29", "text": "是啊，现在是凌晨12点"}, {"type": "subtitle", "time": 8552.23, "timestamp": "02:22:32", "text": "26分。"}, {"type": "subtitle", "time": 8553.91, "timestamp": "02:22:33", "text": "等等，你是怎么进行唱歌"}, {"type": "subtitle", "time": 8557.59, "timestamp": "02:22:37", "text": "直播的？ 你喜欢"}, {"type": "subtitle", "time": 8562.23, "timestamp": "02:22:42", "text": "在 OBS 上加个回声效果，然后"}, {"type": "subtitle", "time": 8564.469, "timestamp": "02:22:44", "text": "就听着吗？等等，你现在得把这"}, {"type": "subtitle", "time": 8567.429, "timestamp": "02:22:47", "text": "首歌放到直播里了。 哦。 哦，是的。"}, {"type": "subtitle", "time": 8569.349, "timestamp": "02:22:49", "text": "由于我在 YouTube 上同时进行多频道直播，所以"}, {"type": "subtitle", "time": 8571.59, "timestamp": "02:22:51", "text": "无法在直播中播放笑声音轨"}, {"type": "subtitle", "time": 8574.15, "timestamp": "02:22:54", "text": "。"}, {"type": "subtitle", "time": 8577.429, "timestamp": "02:22:57", "text": "呃，你知道JP在7月之后是什么时候吗"}]
[{"type": "subtitle", "time": 12544.79, "timestamp": "03:29:04", "text": "。 所以我的课程"}, {"type": "subtitle", "time": 12548.55, "timestamp": "03:29:08", "text": "从……"}, {"type": "subtitle", "time": 12569.03, "timestamp": "03:29:29", "text": "所以十月……十一月……"}, {"type": "subtitle", "time": 12571.83, "timestamp": "03:29:31", "text": "十二月……嗯……如果已经过去两年了，"}, {"type": "subtitle", "time": 12574.309, "timestamp": "03:29:34", "text": "某种程度上可以说我"}, {"type": "subtitle", "time": 12577.19, "timestamp": "03:29:37", "text": "学日语大概一年了，我"}, {"type": "subtitle", "time": 12578.71, "timestamp": "03:29:38", "text": "想是的，"}, {"type": "subtitle", "time": 12582.71, "timestamp": "03:29:42", "text": "今年我猜我"}, {"type": "subtitle", "time": 12587.269, "timestamp": "03:29:47", "text": "二月份通过N5考试后就没怎么练习了，就让它顺其自然吧。"}, {"type": "subtitle", "time": 12598.07, "timestamp": "03:29:58", "text": "我计划骑自行车，我计划从"}]
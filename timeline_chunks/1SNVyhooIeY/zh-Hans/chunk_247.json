[{"type": "subtitle", "time": 14821.189, "timestamp": "04:07:01", "text": "如果我现在忘记了，我可以"}, {"type": "subtitle", "time": 14825.51, "timestamp": "04:07:05", "text": "看看我的"}, {"type": "subtitle", "time": 14846.07, "timestamp": "04:07:26", "text": "哦。哦，它全是日语的。"}, {"type": "subtitle", "time": 14848.309, "timestamp": "04:07:28", "text": "我不知道为什么当我看到"}, {"type": "subtitle", "time": 14851.03, "timestamp": "04:07:31", "text": "所有东西都全是日语的UI界面时，我"}, {"type": "subtitle", "time": 14853.99, "timestamp": "04:07:33", "text": "就害怕，就像我想说“我不想"}, {"type": "subtitle", "time": 14855.99, "timestamp": "04:07:35", "text": "看，"}, {"type": "subtitle", "time": 14859.67, "timestamp": "04:07:39", "text": "我需要……我需要停止那样做”，"}, {"type": "subtitle", "time": 14862.07, "timestamp": "04:07:42", "text": "我知道到了日本一切都会是"}, {"type": "subtitle", "time": 14865.03, "timestamp": "04:07:45", "text": "日语，"}, {"type": "subtitle", "time": 14869.316, "timestamp": "04:07:49", "text": "不会有英文指示牌。"}, {"type": "subtitle", "time": 14870.71, "timestamp": "04:07:50", "text": "[笑] 也许会有，"}, {"type": "subtitle", "time": 14873.83, "timestamp": "04:07:53", "text": "但很少见。是的，我把"}, {"type": "subtitle", "time": 14876.15, "timestamp": "04:07:56", "text": "它改成“You were a United"}]
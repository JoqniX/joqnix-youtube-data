[{"type": "subtitle", "time": 2102.87, "timestamp": "00:35:02", "text": "我记得吗？ 我该如何再次写出“man”这个词"}, {"type": "subtitle", "time": 2107.99, "timestamp": "00:35:07", "text": "[笑声]"}, {"type": "subtitle", "time": 2118.79, "timestamp": "00:35:18", "text": "我的"}, {"type": "subtitle", "time": 2121.43, "timestamp": "00:35:21", "text": "朋友。 每个男人都说“哥们"}, {"type": "subtitle", "time": 2127.589, "timestamp": "00:35:27", "text": "儿，哥们儿，哥们儿，哥们儿”。 我忘了。"}, {"type": "subtitle", "time": 2129.829, "timestamp": "00:35:29", "text": "像这样把你的右沙送过来。"}, {"type": "subtitle", "time": 2134.87, "timestamp": "00:35:34", "text": "好的。 哦，天哪。"}, {"type": "subtitle", "time": 2137.589, "timestamp": "00:35:37", "text": "我的大脑怎么了？"}, {"type": "subtitle", "time": 2142.87, "timestamp": "00:35:42", "text": "不。 我的大脑怎么了？"}, {"type": "subtitle", "time": 2145.349, "timestamp": "00:35:45", "text": "如果我把这东西放在这里，那就不"}, {"type": "subtitle", "time": 2146.95, "timestamp": "00:35:46", "text": "一样了……我"}, {"type": "subtitle", "time": 2150.39, "timestamp": "00:35:50", "text": "忘了那是什么了。   是的"}, {"type": "subtitle", "time": 2156.63, "timestamp": "00:35:56", "text": "[清嗓子]"}]
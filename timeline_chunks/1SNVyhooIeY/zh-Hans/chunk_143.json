[{"type": "subtitle", "time": 8580.95, "timestamp": "02:23:00", "text": "？是明年12月吗？ 哦，呃，这个十二月的"}, {"type": "subtitle", "time": 8583.75, "timestamp": "02:23:03", "text": "监狱怜悯事件发生在七月和十二月。"}, {"type": "subtitle", "time": 8588.15, "timestamp": "02:23:08", "text": "一年两次，没有两次。 所以"}, {"type": "subtitle", "time": 8590.71, "timestamp": "02:23:10", "text": "下一个日期应该是日本的"}, {"type": "subtitle", "time": 8596.07, "timestamp": "02:23:16", "text": "12月7日，我没记错吧。"}, {"type": "subtitle", "time": 8597.75, "timestamp": "02:23:17", "text": "无滤镜。 所以，我正在监测我的"}, {"type": "subtitle", "time": 8603.349, "timestamp": "02:23:23", "text": "声音。 嘿，你们做监控吗？ 你觉"}, {"type": "subtitle", "time": 8606.469, "timestamp": "02:23:26", "text": "得怎么样？ 好的，我要注意一下我的声音。"}, {"type": "subtitle", "time": 8609.91, "timestamp": "02:23:29", "text": "好了，接下来我要保持沉默了。"}, {"type": "subtitle", "time": 8614.95, "timestamp": "02:23:34", "text": "是的，我明白了。 我听不进自己的声音。 我突然"}, {"type": "subtitle", "time": 8619.03, "timestamp": "02:23:39", "text": "进入了“我”的状态，"}, {"type": "subtitle", "time": 8622.389, "timestamp": "02:23:42", "text": "不知何故激活了监听模式。 所以我等"}, {"type": "subtitle", "time": 8625.19, "timestamp": "02:23:45", "text": "自己说完话后再开口"}, {"type": "subtitle", "time": 8627.83, "timestamp": "02:23:47", "text": "。 我也不知道"}, {"type": "subtitle", "time": 8629.67, "timestamp": "02:23:49", "text": "我是怎么在YouTube上做到的。 但请务必"}, {"type": "subtitle", "time": 8632.309, "timestamp": "02:23:52", "text": "删除这些生命记录。 啊，这样就可以避免"}, {"type": "subtitle", "time": 8636.79, "timestamp": "02:23:56", "text": "版权之类的问题了。 是的。 哦，不。"}, {"type": "subtitle", "time": 8639.67, "timestamp": "02:23:59", "text": "不过我拥有这首歌的版权。"}]
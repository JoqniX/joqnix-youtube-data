[{"type": "subtitle", "time": 13505.03, "timestamp": "03:45:05", "text": "有人把这本护照贴成了"}, {"type": "subtitle", "time": 13509.67, "timestamp": "03:45:09", "text": "印度的，而其他人的护照上都有"}, {"type": "subtitle", "time": 13511.189, "timestamp": "03:45:11", "text": "国旗吗？"}, {"type": "subtitle", "time": 13513.75, "timestamp": "03:45:13", "text": "哦，等等，算了。好吧，有"}, {"type": "subtitle", "time": 13516.469, "timestamp": "03:45:16", "text": "照片。"}, {"type": "subtitle", "time": 13518.63, "timestamp": "03:45:18", "text": "哦，算了。"}, {"type": "subtitle", "time": 13521.59, "timestamp": "03:45:21", "text": "哦，是不是有很多“别去”的提示？"}, {"type": "subtitle", "time": 13525.189, "timestamp": "03:45:25", "text": "好吧，我看到了。它看起来真漂亮。有点"}, {"type": "subtitle", "time": 13527.91, "timestamp": "03:45:27", "text": "像玫瑰粉的颜色。我不"}, {"type": "subtitle", "time": 13532.15, "timestamp": "03:45:32", "text": "知道那是什么颜色，但是，嗯。"}, {"type": "subtitle", "time": 13555.83, "timestamp": "03:45:55", "text": "等等，美国怎么样"}, {"type": "subtitle", "time": 13558.87, "timestamp": "03:45:58", "text": "？"}]
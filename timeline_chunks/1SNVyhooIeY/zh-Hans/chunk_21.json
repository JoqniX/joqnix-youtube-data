[{"type": "subtitle", "time": 1262.87, "timestamp": "00:21:02", "text": "我会修改。"}, {"type": "subtitle", "time": 1266.71, "timestamp": "00:21:06", "text": "说实话，我有一半都忘了。"}, {"type": "subtitle", "time": 1269.909, "timestamp": "00:21:09", "text": "我忘了其中一半。 老兄，我"}, {"type": "subtitle", "time": 1273.35, "timestamp": "00:21:13", "text": "真的把一半的事情都忘了"}, {"type": "subtitle", "time": 1276.599, "timestamp": "00:21:16", "text": "。 我到底怎么了？"}, {"type": "subtitle", "time": 1290.07, "timestamp": "00:21:30", "text": "我觉得为了N5，我一直在不停地复习，一遍又一遍地"}, {"type": "subtitle", "time": 1292.71, "timestamp": "00:21:32", "text": "写我学过的所有汉字，"}, {"type": "subtitle", "time": 1295.51, "timestamp": "00:21:35", "text": "没有之一。"}, {"type": "subtitle", "time": 1298.789, "timestamp": "00:21:38", "text": "[音乐] 我们学了新的汉字，我们就把以前"}, {"type": "subtitle", "time": 1301.909, "timestamp": "00:21:41", "text": "学过的汉字一遍又一遍地写，对吧？"}, {"type": "subtitle", "time": 1307.19, "timestamp": "00:21:47", "text": "哦，谢谢你的订阅，"}, {"type": "subtitle", "time": 1309.029, "timestamp": "00:21:49", "text": "谢谢你的订阅，是在"}, {"type": "subtitle", "time": 1311.19, "timestamp": "00:21:51", "text": "YouTube上还是在Twitch上？"}, {"type": "subtitle", "time": 1313.83, "timestamp": "00:21:53", "text": "我想应该是YouTube，对吧？ 感谢你的"}, {"type": "subtitle", "time": 1317.19, "timestamp": "00:21:57", "text": "订阅，詹姆斯·李。  [音乐] 原因是"}]
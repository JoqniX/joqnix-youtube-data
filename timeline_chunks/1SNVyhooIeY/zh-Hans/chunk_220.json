[{"type": "subtitle", "time": 13206.07, "timestamp": "03:40:06", "text": "印度尼西亚在那里。马来西亚在那里。"}, {"type": "subtitle", "time": 13209.11, "timestamp": "03:40:09", "text": "新加坡在那里。嘿，不是八。"}, {"type": "subtitle", "time": 13212.55, "timestamp": "03:40:12", "text": "这是什么？八。八。不是八。呃，"}, {"type": "subtitle", "time": 13215.429, "timestamp": "03:40:15", "text": "六个月。啊，豁免。"}, {"type": "subtitle", "time": 13217.91, "timestamp": "03:40:17", "text": "例外在哪里？比如说，"}, {"type": "subtitle", "time": 13219.67, "timestamp": "03:40:19", "text": "申请豁免期需要超过90天。"}, {"type": "subtitle", "time": 13223.349, "timestamp": "03:40:23", "text": "州和距离，四个时期的公寓"}, {"type": "subtitle", "time": 13226.469, "timestamp": "03:40:26", "text": "住宿经验。哦，"}, {"type": "subtitle", "time": 13229.03, "timestamp": "03:40:29", "text": "哇，"}, {"type": "subtitle", "time": 13236.229, "timestamp": "03:40:36", "text": "[笑声]，"}, {"type": "subtitle", "time": 13238.309, "timestamp": "03:40:38", "text": "现在我希望我是德国人什么的。"}, {"type": "subtitle", "time": 13249.51, "timestamp": "03:40:49", "text": "我不知道你可以制作地图，"}, {"type": "subtitle", "time": 13254.07, "timestamp": "03:40:54", "text": "它还可以制作狮子之类的东西，或者"}]
[{"type": "subtitle", "time": 11365.025, "timestamp": "03:09:25", "text": "周五晚上。"}, {"type": "subtitle", "time": 11377.19, "timestamp": "03:09:37", "text": "好的，我们假设是专注风格。 等等，你"}, {"type": "subtitle", "time": 11379.99, "timestamp": "03:09:39", "text": "得先把其中 20 呃，10 个做完，然后"}, {"type": "subtitle", "time": 11382.469, "timestamp": "03:09:42", "text": "睡觉。 嗨，让大脑休息一下吧。 我早上"}, {"type": "subtitle", "time": 11388.389, "timestamp": "03:09:48", "text": "五点起床。 不，我凌晨两点就睡了。"}, {"type": "subtitle", "time": 11394.479, "timestamp": "03:09:54", "text": "我凌晨两点就睡了。 我的天哪。 嗨？"}]
[{"type": "subtitle", "time": 962.629, "timestamp": "00:16:02", "text": "你们喜欢看什么类型的内容，或者"}, {"type": "subtitle", "time": 965.829, "timestamp": "00:16:05", "text": "想从我这里看到什么，或者对"}, {"type": "subtitle", "time": 969.829, "timestamp": "00:16:09", "text": "目前为止我直播的所有内容有什么看法？"}, {"type": "subtitle", "time": 972.389, "timestamp": "00:16:12", "text": "呃，你"}, {"type": "subtitle", "time": 974.55, "timestamp": "00:16:14", "text": "最喜欢哪一个？ 更确切地说，我想"}, {"type": "subtitle", "time": 976.31, "timestamp": "00:16:16", "text": "准备一个像样的调查"}, {"type": "subtitle", "time": 978.55, "timestamp": "00:16:18", "text": "系统之类的东西，"}, {"type": "subtitle", "time": 981.67, "timestamp": "00:16:21", "text": "以便了解我的社区"}, {"type": "subtitle", "time": 984.47, "timestamp": "00:16:24", "text": "想要什么等等。 嗯？"}, {"type": "subtitle", "time": 988.31, "timestamp": "00:16:28", "text": "当然。 嗯，我会"}, {"type": "subtitle", "time": 991.749, "timestamp": "00:16:31", "text": "在下周或者"}, {"type": "subtitle", "time": 993.67, "timestamp": "00:16:33", "text": "12月公布一些相关信息。 好的。 密切关注此事。"}, {"type": "subtitle", "time": 997.59, "timestamp": "00:16:37", "text": "好的。 你好。 你今年多大？ 我的意思是，我已经够"}, {"type": "subtitle", "time": 1002.629, "timestamp": "00:16:42", "text": "大了。"}, {"type": "subtitle", "time": 1004.79, "timestamp": "00:16:44", "text": "什么？（笑）我已经到了可以"}, {"type": "subtitle", "time": 1007.43, "timestamp": "00:16:47", "text": "喝酒开车的年龄了。 切勿酒后驾车。"}, {"type": "subtitle", "time": 1011.43, "timestamp": "00:16:51", "text": "呃，我已经到了可以旅行的年纪了。 我已经到了可以开车的年龄"}, {"type": "subtitle", "time": 1015.11, "timestamp": "00:16:55", "text": "。"}]
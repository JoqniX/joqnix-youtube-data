[{"type": "subtitle", "time": 9437.83, "timestamp": "02:37:17", "text": "但你是印度人。 是的，我是印度尼西亚人。"}, {"type": "subtitle", "time": 9440.469, "timestamp": "02:37:20", "text": "我来自印度。 在日本？ 还没有。 我"}, {"type": "subtitle", "time": 9443.83, "timestamp": "02:37:23", "text": "四月份要去日本"}, {"type": "subtitle", "time": 9449.19, "timestamp": "02:37:29", "text": "学习语言。 明年四月。 但4月1日。"}, {"type": "subtitle", "time": 9452.63, "timestamp": "02:37:32", "text": "4月1日我将在日本。 我会"}, {"type": "subtitle", "time": 9456.23, "timestamp": "02:37:36", "text": "在日本。 所以，虽然4月"}, {"type": "subtitle", "time": 9459.59, "timestamp": "02:37:39", "text": "1日是愚人节，但是[笑]是的，"}, {"type": "subtitle", "time": 9462.95, "timestamp": "02:37:42", "text": "到那时我应该已经抵达日本了。"}, {"type": "subtitle", "time": 9466.63, "timestamp": "02:37:46", "text": "所以第一周我可能就要参加"}, {"type": "subtitle", "time": 9469.11, "timestamp": "02:37:49", "text": "入学考试或者"}, {"type": "subtitle", "time": 9474.07, "timestamp": "02:37:54", "text": "入学典礼之类的活动。 所以，"}, {"type": "subtitle", "time": 9476.309, "timestamp": "02:37:56", "text": "现在又开始一批新的产品了。"}]
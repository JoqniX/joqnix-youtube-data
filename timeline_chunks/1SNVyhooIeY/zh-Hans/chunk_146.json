[{"type": "subtitle", "time": 8760.309, "timestamp": "02:26:00", "text": "所以[笑声]太"}, {"type": "subtitle", "time": 8764.389, "timestamp": "02:26:04", "text": "复杂了"}, {"type": "subtitle", "time": 8766.79, "timestamp": "02:26:06", "text": "。  [音乐] 但我想知道我是否"}, {"type": "subtitle", "time": 8768.95, "timestamp": "02:26:08", "text": "想以这种方式去做。 我希望能够"}, {"type": "subtitle", "time": 8772.63, "timestamp": "02:26:12", "text": "让直播观众"}, {"type": "subtitle", "time": 8775.75, "timestamp": "02:26:15", "text": "听到伴奏，而我自己"}, {"type": "subtitle", "time": 8778.87, "timestamp": "02:26:18", "text": "听到原曲。"}, {"type": "subtitle", "time": 8781.19, "timestamp": "02:26:21", "text": "正确的。"}, {"type": "subtitle", "time": 8783.349, "timestamp": "02:26:23", "text": "这就像你在举办演唱会，而"}, {"type": "subtitle", "time": 8786.469, "timestamp": "02:26:26", "text": "你的监听音箱里播放的是一首"}, {"type": "subtitle", "time": 8790.389, "timestamp": "02:26:30", "text": "真正的歌曲一样。"}, {"type": "subtitle", "time": 8792.23, "timestamp": "02:26:32", "text": "等等，这样对你来说更容易理解"}, {"type": "subtitle", "time": 8795.59, "timestamp": "02:26:35", "text": "文字之类的东西。是啊，但我也"}, {"type": "subtitle", "time": 8797.75, "timestamp": "02:26:37", "text": "不清楚。 不，因为我是"}, {"type": "subtitle", "time": 8801.27, "timestamp": "02:26:41", "text": "从 YouTube Music 下载歌曲，所以我直接"}, {"type": "subtitle", "time": 8803.946, "timestamp": "02:26:43", "text": "点击这里下载就行了。"}, {"type": "subtitle", "time": 8804.95, "timestamp": "02:26:44", "text": "[笑声]"}, {"type": "subtitle", "time": 8807.19, "timestamp": "02:26:47", "text": "有时感觉是这样，但实际上它确实"}, {"type": "subtitle", "time": 8812.309, "timestamp": "02:26:52", "text": "下载了，然后我提取出来，嗯，我现在要做人声"}, {"type": "subtitle", "time": 8815.429, "timestamp": "02:26:55", "text": "去除之类的操作。 所以正因为如此，"}, {"type": "subtitle", "time": 8818.15, "timestamp": "02:26:58", "text": "有时候我甚至都不知道这"}]
[{"type": "subtitle", "time": 5400.95, "timestamp": "01:30:00", "text": "用英语问？我会"}, {"type": "subtitle", "time": 5403.75, "timestamp": "01:30:03", "text": "几种语言？好吧，我学过印地语、"}, {"type": "subtitle", "time": 5408.229, "timestamp": "01:30:08", "text": "英语，也"}, {"type": "subtitle", "time": 5413.03, "timestamp": "01:30:13", "text": "尝试过学习日语，还尝试过学习普通话，"}, {"type": "subtitle", "time": 5415.43, "timestamp": "01:30:15", "text": "但不太顺利。"}, {"type": "subtitle", "time": 5417.43, "timestamp": "01:30:17", "text": "因为我当时想，好吧，我会"}, {"type": "subtitle", "time": 5421.03, "timestamp": "01:30:21", "text": "全力以赴学习日语，然后再去学"}, {"type": "subtitle", "time": 5423.11, "timestamp": "01:30:23", "text": "中文，"}, {"type": "subtitle", "time": 5425.189, "timestamp": "01:30:25", "text": "因为我之前在"}, {"type": "subtitle", "time": 5429.189, "timestamp": "01:30:29", "text": "Believer 上直播过，是的，"}, {"type": "subtitle", "time": 5431.99, "timestamp": "01:30:31", "text": "去年，所以我想，"}, {"type": "subtitle", "time": 5434.55, "timestamp": "01:30:34", "text": "好吧，我会学习中文，这样我就可以"}, {"type": "subtitle", "time": 5442.07, "timestamp": "01:30:42", "text": "但是，那里没有人会说英语。"}, {"type": "subtitle", "time": 5444.709, "timestamp": "01:30:44", "text": "只有少数"}, {"type": "subtitle", "time": 5446.87, "timestamp": "01:30:46", "text": "懂英语或者学过英语的人会"}, {"type": "subtitle", "time": 5451.99, "timestamp": "01:30:51", "text": "过来用英语和我交流，或者"}, {"type": "subtitle", "time": 5454.31, "timestamp": "01:30:54", "text": "有些人根本听"}, {"type": "subtitle", "time": 5456.07, "timestamp": "01:30:56", "text": "不懂我的音乐，"}, {"type": "subtitle", "time": 5458.229, "timestamp": "01:30:58", "text": "我打开屏幕"}]
[{"type": "subtitle", "time": 12422.87, "timestamp": "03:27:02", "text": "哦，那顶武士帽。 不，是"}, {"type": "subtitle", "time": 12424.79, "timestamp": "03:27:04", "text": "一个"}, {"type": "subtitle", "time": 12427.91, "timestamp": "03:27:07", "text": "戴帽子的男人。 一位"}, {"type": "subtitle", "time": 12430.229, "timestamp": "03:27:10", "text": "手持利剑的武士。"}, {"type": "subtitle", "time": 12433.75, "timestamp": "03:27:13", "text": "我甚至都画不出"}, {"type": "subtitle", "time": 12440.95, "timestamp": "03:27:20", "text": "呃，我简直……你懂的。 感觉"}, {"type": "subtitle", "time": 12443.349, "timestamp": "03:27:23", "text": "就像那样"}]
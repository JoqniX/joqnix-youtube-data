[{"type": "subtitle", "time": 1560.31, "timestamp": "00:26:00", "text": "早上早点起床，比如 5:04 左右"}, {"type": "subtitle", "time": 1563.029, "timestamp": "00:26:03", "text": "，[听音乐] 开始复习和"}, {"type": "subtitle", "time": 1564.549, "timestamp": "00:26:04", "text": "学习。"}, {"type": "subtitle", "time": 1567.11, "timestamp": "00:26:07", "text": "不是学习。 是的，好好复习，祝"}, {"type": "subtitle", "time": 1568.71, "timestamp": "00:26:08", "text": "你考试顺利。 好好准备考试"}, {"type": "subtitle", "time": 1572.23, "timestamp": "00:26:12", "text": "。 是的。"}, {"type": "subtitle", "time": 1575.75, "timestamp": "00:26:15", "text": "所以，昨天我感觉特别焦虑，"}, {"type": "subtitle", "time": 1581.51, "timestamp": "00:26:21", "text": "[笑] 昨天真是超级"}, {"type": "subtitle", "time": 1595.269, "timestamp": "00:26:35", "text": "只"}, {"type": "subtitle", "time": 1597.99, "timestamp": "00:26:37", "text": "展示了一个典型的发音，"}, {"type": "subtitle", "time": 1599.909, "timestamp": "00:26:39", "text": "一个典型的，是的，"}, {"type": "subtitle", "time": 1603.43, "timestamp": "00:26:43", "text": "典型的。"}, {"type": "subtitle", "time": 1605.43, "timestamp": "00:26:45", "text": "我应该把我目前学过的所有汉字都写下来，然后"}, {"type": "subtitle", "time": 1610.63, "timestamp": "00:26:50", "text": "练习五到十分钟，一遍又一遍地"}, {"type": "subtitle", "time": 1613.43, "timestamp": "00:26:53", "text": "写，然后"}, {"type": "subtitle", "time": 1615.43, "timestamp": "00:26:55", "text": "就像，"}, {"type": "subtitle", "time": 1618.71, "timestamp": "00:26:58", "text": "嗯，是的。 我觉得我应该那样做。"}]
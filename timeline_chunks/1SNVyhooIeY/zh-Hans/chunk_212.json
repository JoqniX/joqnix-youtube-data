[{"type": "subtitle", "time": 12723.03, "timestamp": "03:32:03", "text": "所以，因为这个原因，我就想，好吧，我"}, {"type": "subtitle", "time": 12725.429, "timestamp": "03:32:05", "text": "尝试使用屏幕"}, {"type": "subtitle", "time": 12728.469, "timestamp": "03:32:08", "text": "翻译器、字幕之类的东西，但是"}, {"type": "subtitle", "time": 12731.03, "timestamp": "03:32:11", "text": "都没用。"}, {"type": "subtitle", "time": 12738.79, "timestamp": "03:32:18", "text": "有人说了些别的话，我"}, {"type": "subtitle", "time": 12741.196, "timestamp": "03:32:21", "text": "就想，“是啊，那可不好。”"}, {"type": "subtitle", "time": 12756.87, "timestamp": "03:32:36", "text": "我就想，“你知道吗？嗯，我要"}, {"type": "subtitle", "time": 12760.07, "timestamp": "03:32:40", "text": "学普通话，"}, {"type": "subtitle", "time": 12764.469, "timestamp": "03:32:44", "text": "这样我就可以和来我直播的人交流了。"}, {"type": "subtitle", "time": 12766.79, "timestamp": "03:32:46", "text": "来自中国的人，如果他们来我的"}, {"type": "subtitle", "time": 12769.59, "timestamp": "03:32:49", "text": "直播间，我就可以"}, {"type": "subtitle", "time": 12772.15, "timestamp": "03:32:52", "text": "和他们交流了。只有少数"}, {"type": "subtitle", "time": 12775.91, "timestamp": "03:32:55", "text": "人会说英语。所以我就想，对，"}, {"type": "subtitle", "time": 12778.389, "timestamp": "03:32:58", "text": "我要学。"}]
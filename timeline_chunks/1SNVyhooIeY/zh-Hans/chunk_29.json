[{"type": "subtitle", "time": 1741.909, "timestamp": "00:29:01", "text": "但我还在等。"}, {"type": "subtitle", "time": 1745.11, "timestamp": "00:29:05", "text": "嗯，是的，它很适合用来"}, {"type": "subtitle", "time": 1747.75, "timestamp": "00:29:07", "text": "画风景之类的。  [笑声]"}, {"type": "subtitle", "time": 1749.59, "timestamp": "00:29:09", "text": "就像我可以放一块黑板，"}, {"type": "subtitle", "time": 1757.83, "timestamp": "00:29:17", "text": "我想要这个，得到这个，但"}, {"type": "subtitle", "time": 1761.669, "timestamp": "00:29:21", "text": "显然，呃，我已经有我自己的所有"}, {"type": "subtitle", "time": 1764.389, "timestamp": "00:29:24", "text": "订阅费用了，这让"}, {"type": "subtitle", "time": 1768.31, "timestamp": "00:29:28", "text": "我已经破产了。"}, {"type": "subtitle", "time": 1771.909, "timestamp": "00:29:31", "text": "是的，这个月我负责音乐"}, {"type": "subtitle", "time": 1774.549, "timestamp": "00:29:34", "text": "软件和"}, {"type": "subtitle", "time": 1776.87, "timestamp": "00:29:36", "text": "其他所有东西。 于是我就想，“好吧，"}, {"type": "subtitle", "time": 1778.95, "timestamp": "00:29:38", "text": "行。你知道吗？我要开始"}, {"type": "subtitle", "time": 1781.11, "timestamp": "00:29:41", "text": "攒钱了。”"}, {"type": "subtitle", "time": 1782.63, "timestamp": "00:29:42", "text": "所以，"}, {"type": "subtitle", "time": 1784.71, "timestamp": "00:29:44", "text": "当我考虑购买艺术品"}]
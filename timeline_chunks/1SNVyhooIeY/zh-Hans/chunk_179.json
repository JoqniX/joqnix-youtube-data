[{"type": "subtitle", "time": 10741.19, "timestamp": "02:59:01", "text": "帮助不大。"}, {"type": "subtitle", "time": 10743.11, "timestamp": "02:59:03", "text": "如果你想学习"}, {"type": "subtitle", "time": 10747.19, "timestamp": "02:59:07", "text": "日语，我的建议是先学习平假名和片假名"}, {"type": "subtitle", "time": 10750.15, "timestamp": "02:59:10", "text": "。 正确的。"}, {"type": "subtitle", "time": 10751.99, "timestamp": "02:59:11", "text": "等你掌握了平假名和片假名之后，再去"}, {"type": "subtitle", "time": 10755.03, "timestamp": "02:59:15", "text": "学汉字。哈哈，平假名对吧？当"}, {"type": "subtitle", "time": 10759.429, "timestamp": "02:59:19", "text": "你重新……呃……写……当你写平假名"}, {"type": "subtitle", "time": 10761.83, "timestamp": "02:59:21", "text": "和片假名的时候，不，当你学习平假名和"}, {"type": "subtitle", "time": 10764.87, "timestamp": "02:59:24", "text": "片假名的时候，试着每天都把它们写在笔记本上，"}, {"type": "subtitle", "time": 10769.19, "timestamp": "02:59:29", "text": "写在书上。"}, {"type": "subtitle", "time": 10773.59, "timestamp": "02:59:33", "text": "这是什么意思？这是什么意思？等等等等。嗯，专业……呃，"}, {"type": "subtitle", "time": 10780.309, "timestamp": "02:59:40", "text": "片假名其妙地"}, {"type": "subtitle", "time": 10784.15, "timestamp": "02:59:44", "text": "先学平假名，再学片假名。"}, {"type": "subtitle", "time": 10787.67, "timestamp": "02:59:47", "text": "所以我对片假名还是不太熟悉，"}, {"type": "subtitle", "time": 10793.349, "timestamp": "02:59:53", "text": "特别是这个和这个，"}, {"type": "subtitle", "time": 10797.11, "timestamp": "02:59:57", "text": "然后……还有"}, {"type": "subtitle", "time": 10799.99, "timestamp": "02:59:59", "text": "这个"}]
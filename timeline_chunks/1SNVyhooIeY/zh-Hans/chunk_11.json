[{"type": "subtitle", "time": 663.03, "timestamp": "00:11:03", "text": "嗯，（清嗓子）我觉得"}, {"type": "subtitle", "time": 666.55, "timestamp": "00:11:06", "text": "我应该从现在开始减少一些游戏"}, {"type": "subtitle", "time": 669.19, "timestamp": "00:11:09", "text": "直播。"}, {"type": "subtitle", "time": 674.63, "timestamp": "00:11:14", "text": "坚持，稍等。 我相信大多数人，呃，"}, {"type": "subtitle", "time": 677.269, "timestamp": "00:11:17", "text": "我希望你们大多数人关注我是因为我这个人，而不是因为我的"}, {"type": "subtitle", "time": 681.11, "timestamp": "00:11:21", "text": "内容。 呃，不过，"}, {"type": "subtitle", "time": 683.829, "timestamp": "00:11:23", "text": "有些人现在可能更喜欢"}, {"type": "subtitle", "time": 686.47, "timestamp": "00:11:26", "text": "看游戏直播之类的，"}, {"type": "subtitle", "time": 689.269, "timestamp": "00:11:29", "text": "我不知道"}, {"type": "subtitle", "time": 693.59, "timestamp": "00:11:33", "text": "下个月能不能直播，"}, {"type": "subtitle", "time": 697.11, "timestamp": "00:11:37", "text": "但是一月中旬之后，大概"}, {"type": "subtitle", "time": 701.829, "timestamp": "00:11:41", "text": "15号之后，我就可以直播了。"}, {"type": "subtitle", "time": 705.829, "timestamp": "00:11:45", "text": "等等，14号是全国统考，对吧？所以"}, {"type": "subtitle", "time": 708.23, "timestamp": "00:11:48", "text": "我会时不时地直播一下，"}, {"type": "subtitle", "time": 710.15, "timestamp": "00:11:50", "text": "最多一个小时，"}, {"type": "subtitle", "time": 711.829, "timestamp": "00:11:51", "text": "那会是那种很短的"}, {"type": "subtitle", "time": 713.35, "timestamp": "00:11:53", "text": "直播。"}, {"type": "subtitle", "time": 716.568, "timestamp": "00:11:56", "text": "不像我们通常那样直播 9 小时、10 小时"}, {"type": "subtitle", "time": 717.11, "timestamp": "00:11:57", "text": "（笑声）"}]
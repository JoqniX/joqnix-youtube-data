[{"type": "subtitle", "time": 13561.75, "timestamp": "03:46:01", "text": "哦，有点像黑色。好吧。海军蓝"}, {"type": "subtitle", "time": 13566.63, "timestamp": "03:46:06", "text": "。我猜美联航是蓝色的。"}, {"type": "subtitle", "time": 13569.51, "timestamp": "03:46:09", "text": "美联航也是蓝色的。"}, {"type": "subtitle", "time": 13574.469, "timestamp": "03:46:14", "text": "新西兰。不，是齐默尔。"}, {"type": "subtitle", "time": 13578.55, "timestamp": "03:46:18", "text": "哦，真酷。我喜欢它的设计。"}, {"type": "subtitle", "time": 13581.03, "timestamp": "03:46:21", "text": "它也是黑色的。"}, {"type": "subtitle", "time": 13604.95, "timestamp": "03:46:44", "text": "所以等等，护照是怎么用的？我对这"}, {"type": "subtitle", "time": 13607.67, "timestamp": "03:46:47", "text": "玩意儿一窍不通。"}, {"type": "subtitle", "time": 13609.75, "timestamp": "03:46:49", "text": "假设我要去日本旅行。"}, {"type": "subtitle", "time": 13612.389, "timestamp": "03:46:52", "text": "嗯？我需要带日本护照吗？"}, {"type": "subtitle", "time": 13615.429, "timestamp": "03:46:55", "text": "还是入境日本时不需要？ 那"}, {"type": "subtitle", "time": 13617.269, "timestamp": "03:46:57", "text": "玩意儿会贴到我的印度"}, {"type": "subtitle", "time": 13618.79, "timestamp": "03:46:58", "text": "护照上吗？"}]
[{"type": "subtitle", "time": 1320.07, "timestamp": "00:22:00", "text": "我看不懂名字。"}, {"type": "subtitle", "time": 1329.35, "timestamp": "00:22:09", "text": "呃，我们目前还学过哪些汉字？"}, {"type": "subtitle", "time": 1332.789, "timestamp": "00:22:12", "text": "现在太多了。  [笑声]"}, {"type": "subtitle", "time": 1335.029, "timestamp": "00:22:15", "text": "是啊，这些"}, {"type": "subtitle", "time": 1336.71, "timestamp": "00:22:16", "text": "布什·"}, {"type": "chat", "time": 1337.915, "timestamp": "00:22:17", "author": "@NamanRajput-n8w", "avatar": "https://yt4.ggpht.com/I6iqd552DDv0-h99h5Wdf--ghvHwCddgcMGIkvGcK0nm2x2lAQfpfnw3D79kzo0NRZohHO_a=s64-c-k-c0x00ffffff-no-rj", "message": "how many people are watching you right now"}, {"type": "subtitle", "time": 1345.43, "timestamp": "00:22:25", "text": "[音乐] 呃，"}, {"type": "subtitle", "time": 1347.27, "timestamp": "00:22:27", "text": "现在有多少人在看"}, {"type": "subtitle", "time": 1349.51, "timestamp": "00:22:29", "text": "？ 呃，我不知道。 我不核对"}, {"type": "subtitle", "time": 1353.83, "timestamp": "00:22:33", "text": "数字。 我不核对数字。 因为呃，"}, {"type": "subtitle", "time": 1356.87, "timestamp": "00:22:36", "text": "它也会给你带来不好的心态，"}, {"type": "subtitle", "time": 1358.71, "timestamp": "00:22:38", "text": "比如“哦，只有少数人"}, {"type": "subtitle", "time": 1361.029, "timestamp": "00:22:41", "text": "关注我”。 只是没有人看着我。"}, {"type": "subtitle", "time": 1363.11, "timestamp": "00:22:43", "text": "嗯，就是那种事。 不，你已经"}, {"type": "subtitle", "time": 1365.59, "timestamp": "00:22:45", "text": "做了很多了。 所以我一般不去关注"}, {"type": "subtitle", "time": 1368.95, "timestamp": "00:22:48", "text": "观看人数之类的东西。"}, {"type": "subtitle", "time": 1371.99, "timestamp": "00:22:51", "text": "嗯，所以，我脑子里一直有个"}, {"type": "subtitle", "time": 1373.99, "timestamp": "00:22:53", "text": "数字，就好像我在和"}, {"type": "subtitle", "time": 1376.63, "timestamp": "00:22:56", "text": "五个人或十个人说话一样。 所以"}, {"type": "subtitle", "time": 1379.669, "timestamp": "00:22:59", "text": "我直播的时候总是这样，不会"}]
[{"type": "subtitle", "time": 3661.03, "timestamp": "01:01:01", "text": "我为什么这么痛苦？因为音乐考试"}, {"type": "subtitle", "time": 3663.447, "timestamp": "01:01:03", "text": "快到了，"}, {"type": "subtitle", "time": 3667.27, "timestamp": "01:01:07", "text": "无论如何我都不能失败"}, {"type": "subtitle", "time": 3670.71, "timestamp": "01:01:10", "text": "。"}, {"type": "subtitle", "time": 3672.95, "timestamp": "01:01:12", "text": "我必须像准备"}, {"type": "subtitle", "time": 3675.109, "timestamp": "01:01:15", "text": "考试一样认真学习。 我准备参加某种考试，"}, {"type": "subtitle", "time": 3678.069, "timestamp": "01:01:18", "text": "因为我根本没复习也没做任何准备"}, {"type": "subtitle", "time": 3680.95, "timestamp": "01:01:20", "text": "。 我感觉自己像在受苦。"}, {"type": "subtitle", "time": 3699.91, "timestamp": "01:01:39", "text": "让我们来检验一下你已经学到了多少音乐知识"}, {"type": "subtitle", "time": 3703.43, "timestamp": "01:01:43", "text": "。"}, {"type": "subtitle", "time": 3705.109, "timestamp": "01:01:45", "text": "在我们开始这个（音乐）测试之前"}, {"type": "subtitle", "time": 3708.47, "timestamp": "01:01:48", "text": "，先来学习一下这30个汉字。"}, {"type": "subtitle", "time": 3711.67, "timestamp": "01:01:51", "text": "现在是30。"}, {"type": "subtitle", "time": 3715.19, "timestamp": "01:01:55", "text": "180题中答对30题。1"}]
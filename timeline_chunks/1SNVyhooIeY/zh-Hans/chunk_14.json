[{"type": "subtitle", "time": 841.75, "timestamp": "00:14:01", "text": "，[嗤笑]"}, {"type": "subtitle", "time": 844.15, "timestamp": "00:14:04", "text": "对吧？ 嗯，当然，噪音投诉确实存在"}, {"type": "subtitle", "time": 848.71, "timestamp": "00:14:08", "text": "。 我尖叫声好大。 呃，我哭得好"}, {"type": "subtitle", "time": 852.389, "timestamp": "00:14:12", "text": "大声。 大声尖叫。  [笑声]"}, {"type": "subtitle", "time": 854.31, "timestamp": "00:14:14", "text": "所以，"}, {"type": "subtitle", "time": 857.91, "timestamp": "00:14:17", "text": "嗯，我不知道。 我们会玩一些恐怖"}, {"type": "subtitle", "time": 860.31, "timestamp": "00:14:20", "text": "游戏。 有些游戏我想通关，"}, {"type": "subtitle", "time": 863.269, "timestamp": "00:14:23", "text": "因为一些社区"}, {"type": "subtitle", "time": 866.31, "timestamp": "00:14:26", "text": "成员送了我一些游戏。 不。呃，就像"}, {"type": "subtitle", "time": 869.509, "timestamp": "00:14:29", "text": "上次 Joathon 一样。 我"}, {"type": "subtitle", "time": 871.829, "timestamp": "00:14:31", "text": "有点想……"}, {"type": "subtitle", "time": 874.47, "timestamp": "00:14:34", "text": "不，不是有点。 我确实想把"}, {"type": "subtitle", "time": 876.389, "timestamp": "00:14:36", "text": "它们都玩完，"}, {"type": "subtitle", "time": 878.31, "timestamp": "00:14:38", "text": "因为没有人真的会"}, {"type": "subtitle", "time": 880.71, "timestamp": "00:14:40", "text": "花钱在Steam上送我游戏。 不。所以"}, {"type": "subtitle", "time": 883.75, "timestamp": "00:14:43", "text": "我得把它们完成，对吧？"}, {"type": "subtitle", "time": 886.15, "timestamp": "00:14:46", "text": "所以必须这么做。 所以我们也可能会这样做"}, {"type": "subtitle", "time": 889.829, "timestamp": "00:14:49", "text": "。 是的。"}, {"type": "subtitle", "time": 893.35, "timestamp": "00:14:53", "text": "我说的下个月是指……呃，今天是几号？ 今天就像"}, {"type": "subtitle", "time": 898.87, "timestamp": "00:14:58", "text": "26号一样。不。呃，下周……呃，"}]
[{"type": "subtitle", "time": 2225.05, "timestamp": "00:37:05", "text": "啊，差不多了。 我忘了这辆卡车。"}, {"type": "subtitle", "time": 2226.47, "timestamp": "00:37:06", "text": "[笑声和惊呼]"}, {"type": "subtitle", "time": 2230.069, "timestamp": "00:37:10", "text": "不。我怎么了？"}, {"type": "subtitle", "time": 2232.95, "timestamp": "00:37:12", "text": "等等，我今天不是做过这件事吗？ 昨天"}, {"type": "subtitle", "time": 2236.47, "timestamp": "00:37:16", "text": "早上。 我现在就做了。"}, {"type": "subtitle", "time": 2246.95, "timestamp": "00:37:26", "text": "昨天早上我们有那条溪流。"}, {"type": "subtitle", "time": 2249.51, "timestamp": "00:37:29", "text": "不。"}, {"type": "subtitle", "time": 2251.829, "timestamp": "00:37:31", "text": "我的天哪。 等等，是昨天"}, {"type": "subtitle", "time": 2253.91, "timestamp": "00:37:33", "text": "早上吗？"}, {"type": "subtitle", "time": 2255.99, "timestamp": "00:37:35", "text": "我什么时候做的？"}, {"type": "subtitle", "time": 2259.829, "timestamp": "00:37:39", "text": "我什么时候做的那个数字？ 这是第10题。不，这是"}, {"type": "subtitle", "time": 2261.349, "timestamp": "00:37:41", "text": "第11题。"}, {"type": "subtitle", "time": 2267.589, "timestamp": "00:37:47", "text": "我做了第11题。我做了第10题。"}, {"type": "subtitle", "time": 2269.99, "timestamp": "00:37:49", "text": "如果你在这里，我并不介意。 还有，如果你"}, {"type": "subtitle", "time": 2272.87, "timestamp": "00:37:52", "text": "再次听到我的声音，"}]
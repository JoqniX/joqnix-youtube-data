[{"type": "subtitle", "time": 12313.51, "timestamp": "03:25:13", "text": "嘿，莫蒂没事。 我感觉又来了"}, {"type": "subtitle", "time": 12329.75, "timestamp": "03:25:29", "text": "我交上来的主要笔迹不是"}, {"type": "subtitle", "time": 12340.71, "timestamp": "03:25:40", "text": "所以别学我。 哦，是的。 哦，我的天。"}, {"type": "subtitle", "time": 12342.71, "timestamp": "03:25:42", "text": "等等，你刚才怎么说的？ 哦，我"}, {"type": "subtitle", "time": 12347.75, "timestamp": "03:25:47", "text": "现在在日本上日语课的时候，必须"}, {"type": "subtitle", "time": 12350.63, "timestamp": "03:25:50", "text": "注意我的字迹、"}, {"type": "subtitle", "time": 12358.389, "timestamp": "03:25:58", "text": "哦，是的。 我"}]
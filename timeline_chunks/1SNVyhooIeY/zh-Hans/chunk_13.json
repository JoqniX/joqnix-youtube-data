[{"type": "subtitle", "time": 780.79, "timestamp": "00:13:00", "text": "15号或16号回来的时候完成。"}, {"type": "subtitle", "time": 782.723, "timestamp": "00:13:02", "text": "所以"}, {"type": "subtitle", "time": 784.31, "timestamp": "00:13:04", "text": "（嗤笑）"}, {"type": "subtitle", "time": 789.11, "timestamp": "00:13:09", "text": "呃，好吧。 是的。 我的意思是，呃，"}, {"type": "subtitle", "time": 792.31, "timestamp": "00:13:12", "text": "如果你说的是一月份，呃，"}, {"type": "subtitle", "time": 795.43, "timestamp": "00:13:15", "text": "14号之类的，"}, {"type": "subtitle", "time": 798.23, "timestamp": "00:13:18", "text": "我估计离"}, {"type": "subtitle", "time": 803.829, "timestamp": "00:13:23", "text": "我去日本只剩下两三个月的时间了。 所以，是二月、三月，"}, {"type": "subtitle", "time": 806.55, "timestamp": "00:13:26", "text": "对吧？ 行进。 三月底的时候，"}, {"type": "subtitle", "time": 809.03, "timestamp": "00:13:29", "text": "我不得不收拾行李。   是的"}, {"type": "subtitle", "time": 811.99, "timestamp": "00:13:31", "text": "。 我和H（清了清嗓子）还没有"}, {"type": "subtitle", "time": 815.43, "timestamp": "00:13:35", "text": "计划好"}, {"type": "subtitle", "time": 818.069, "timestamp": "00:13:38", "text": "接下来的"}, {"type": "subtitle", "time": 821.59, "timestamp": "00:13:41", "text": "两个月，也就是二月、三月以及之后的所有事情。   嗯，是啊"}, {"type": "subtitle", "time": 826.71, "timestamp": "00:13:46", "text": "，我也不知道该怎么办。"}, {"type": "subtitle", "time": 829.19, "timestamp": "00:13:49", "text": "我有点想玩一些恐怖游戏，"}, {"type": "subtitle", "time": 832.15, "timestamp": "00:13:52", "text": "因为我唯一能放声尖叫的时候"}, {"type": "subtitle", "time": 835.43, "timestamp": "00:13:55", "text": "就是在家里，对吧？ 我"}, {"type": "subtitle", "time": 838.15, "timestamp": "00:13:58", "text": "觉得四月之后我以后也做不到那样了"}]
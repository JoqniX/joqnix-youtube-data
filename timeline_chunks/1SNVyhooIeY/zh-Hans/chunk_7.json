[{"type": "subtitle", "time": 421.83, "timestamp": "00:07:01", "text": "压力超级大"}, {"type": "subtitle", "time": 424.23, "timestamp": "00:07:04", "text": "。  [笑声]"}, {"type": "subtitle", "time": 430.629, "timestamp": "00:07:10", "text": "我也不知道，我感觉压力特别大，特别"}, {"type": "subtitle", "time": 433.35, "timestamp": "00:07:13", "text": "紧张。"}, {"type": "subtitle", "time": 436.15, "timestamp": "00:07:16", "text": "嗯，是啊，有好多游戏我"}, {"type": "subtitle", "time": 439.189, "timestamp": "00:07:19", "text": "想玩，还有好多东西我想补上。"}, {"type": "subtitle", "time": 443.51, "timestamp": "00:07:23", "text": "我觉得我当时有点"}, {"type": "subtitle", "time": 446.87, "timestamp": "00:07:26", "text": "想让自己远离这些"}, {"type": "subtitle", "time": 450.07, "timestamp": "00:07:30", "text": "游戏。 我知道我"}, {"type": "subtitle", "time": 453.029, "timestamp": "00:07:33", "text": "喜欢花很多时间享受这"}, {"type": "subtitle", "time": 458.07, "timestamp": "00:07:38", "text": "一切，沉浸在其中，但"}, {"type": "subtitle", "time": 460.629, "timestamp": "00:07:40", "text": "我内心深处也明白，要分清轻重缓急，对吧？ 我得先把"}, {"type": "subtitle", "time": 463.99, "timestamp": "00:07:43", "text": "轻重缓急理清楚。 呃，还有"}, {"type": "subtitle", "time": 467.43, "timestamp": "00:07:47", "text": "下个月和一月份，"}, {"type": "subtitle", "time": 469.189, "timestamp": "00:07:49", "text": "对我来说就像是考试季。"}, {"type": "subtitle", "time": 475.909, "timestamp": "00:07:55", "text": "即使我不参加12月"}]
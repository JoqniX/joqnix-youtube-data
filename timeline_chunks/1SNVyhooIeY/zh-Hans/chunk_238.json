[{"type": "subtitle", "time": 14282.15, "timestamp": "03:58:02", "text": "是……那真的是……我的天。那是什么"}, {"type": "subtitle", "time": 14287.51, "timestamp": "03:58:07", "text": "哇，这太酷了。我不知道"}, {"type": "subtitle", "time": 14297.83, "timestamp": "03:58:17", "text": "哦，我放大了大概50倍。等等，"}, {"type": "subtitle", "time": 14301.67, "timestamp": "03:58:21", "text": "可以放大这么多。"}, {"type": "subtitle", "time": 14303.75, "timestamp": "03:58:23", "text": "什么？太"}, {"type": "subtitle", "time": 14306.389, "timestamp": "03:58:26", "text": "疯狂了。我以为他们有缩放"}, {"type": "subtitle", "time": 14317.429, "timestamp": "03:58:37", "text": "嗯，就像"}, {"type": "subtitle", "time": 14321.11, "timestamp": "03:58:41", "text": "最大限制是几千倍。但我"}, {"type": "subtitle", "time": 14328.95, "timestamp": "03:58:48", "text": "万个"}, {"type": "subtitle", "time": 14331.67, "timestamp": "03:58:51", "text": "数字……"}, {"type": "subtitle", "time": 14334.71, "timestamp": "03:58:54", "text": "现在变成白色了……哦，现在变成"}]
[{"type": "subtitle", "time": 8461.429, "timestamp": "02:21:01", "text": "我们每天都在VC里，她经常"}, {"type": "subtitle", "time": 8463.429, "timestamp": "02:21:03", "text": "听到我唱那四句歌词、八句"}, {"type": "subtitle", "time": 8467.03, "timestamp": "02:21:07", "text": "歌词，或者像公交车之类的歌。 我必须反复练习"}, {"type": "subtitle", "time": 8469.892, "timestamp": "02:21:09", "text": "。"}, {"type": "subtitle", "time": 8470.71, "timestamp": "02:21:10", "text": "[笑声]"}, {"type": "subtitle", "time": 8472.95, "timestamp": "02:21:12", "text": "这种学习方式真的很好，"}, {"type": "subtitle", "time": 8476.309, "timestamp": "02:21:16", "text": "因为它帮助我"}, {"type": "subtitle", "time": 8478.63, "timestamp": "02:21:18", "text": "即使不看歌词，也"}, {"type": "subtitle", "time": 8480.95, "timestamp": "02:21:20", "text": "能知道该唱什么。 即使"}, {"type": "subtitle", "time": 8483.27, "timestamp": "02:21:23", "text": "我在洗澡的时候，"}, {"type": "subtitle", "time": 8485.03, "timestamp": "02:21:25", "text": "想着这首歌，试着"}, {"type": "subtitle", "time": 8487.83, "timestamp": "02:21:27", "text": "跟着唱，我也会把"}, {"type": "subtitle", "time": 8491.03, "timestamp": "02:21:31", "text": "歌词背下来。 是的。 与此同时，"}, {"type": "subtitle", "time": 8493.429, "timestamp": "02:21:33", "text": "对于其他一些我喜欢的歌曲，"}, {"type": "subtitle", "time": 8495.19, "timestamp": "02:21:35", "text": "特别是像《Sanara Midnight》之"}, {"type": "subtitle", "time": 8497.429, "timestamp": "02:21:37", "text": "类的歌，我必须先看看歌词。 我"}, {"type": "subtitle", "time": 8499.91, "timestamp": "02:21:39", "text": "必须听引导音轨，也就是"}, {"type": "subtitle", "time": 8502.63, "timestamp": "02:21:42", "text": "耳机里的原曲。 我一定要"}, {"type": "subtitle", "time": 8506.15, "timestamp": "02:21:46", "text": "听听，而且我会试着跟着唱。 我"}, {"type": "subtitle", "time": 8507.75, "timestamp": "02:21:47", "text": "不知道这是否是"}, {"type": "subtitle", "time": 8511.429, "timestamp": "02:21:51", "text": "学习唱歌的正确方法。 不，因为如果我"}, {"type": "subtitle", "time": 8513.349, "timestamp": "02:21:53", "text": "听原曲或者有"}, {"type": "subtitle", "time": 8516.389, "timestamp": "02:21:56", "text": "参考曲目或指导曲目，我往往会"}, {"type": "subtitle", "time": 8519.673, "timestamp": "02:21:59", "text": "尝试模仿他们的演唱方式。"}]
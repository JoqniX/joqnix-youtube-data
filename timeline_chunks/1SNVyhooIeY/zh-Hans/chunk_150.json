[{"type": "subtitle", "time": 9014.55, "timestamp": "02:30:14", "text": "一，二。"}, {"type": "subtitle", "time": 9017.83, "timestamp": "02:30:17", "text": "呃，我把一个“小妹妹”写在另一个“"}, {"type": "subtitle", "time": 9026.15, "timestamp": "02:30:26", "text": "看看你能认出多少个“ki”。"}, {"type": "subtitle", "time": 9029.75, "timestamp": "02:30:29", "text": "是的，它们大多数都是N4。 我写了这么"}, {"type": "subtitle", "time": 9031.75, "timestamp": "02:30:31", "text": "多。"}, {"type": "subtitle", "time": 9039.99, "timestamp": "02:30:39", "text": "呃，Hayashi，莫迪，Chakara，Oshi，呃，"}, {"type": "subtitle", "time": 9050.87, "timestamp": "02:30:50", "text": "照片"}]
[{"type": "subtitle", "time": 12601.75, "timestamp": "03:30:01", "text": "德国骑车到日本，途中会经过"}, {"type": "subtitle", "time": 12604.469, "timestamp": "03:30:04", "text": "中国、韩国，然后再从韩国骑车到"}, {"type": "subtitle", "time": 12607.83, "timestamp": "03:30:07", "text": "日本，显然是这样。 哦，"}, {"type": "subtitle", "time": 12611.349, "timestamp": "03:30:11", "text": "那太好了。"}, {"type": "subtitle", "time": 12614.79, "timestamp": "03:30:14", "text": "太好了。 对，你应该那样做……"}, {"type": "subtitle", "time": 12617.75, "timestamp": "03:30:17", "text": "嗯，"}, {"type": "subtitle", "time": 12622.63, "timestamp": "03:30:22", "text": "不是吗？嗯，那家伙叫什么来着"}, {"type": "subtitle", "time": 12638.469, "timestamp": "03:30:38", "text": "呃。 康纳。 康纳。 那个"}, {"type": "subtitle", "time": 12648.389, "timestamp": "03:30:48", "text": "。 是的。"}, {"type": "subtitle", "time": 12658.229, "timestamp": "03:30:58", "text": "骑车过弯那样做。"}]
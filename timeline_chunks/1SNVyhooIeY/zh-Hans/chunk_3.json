[{"type": "subtitle", "time": 182.39, "timestamp": "00:03:02", "text": "今晚，呃，我们要复习一下汉字"}, {"type": "subtitle", "time": 186.79, "timestamp": "00:03:06", "text": "。 嗯，我们一直在关注一个"}, {"type": "subtitle", "time": 195.11, "timestamp": "00:03:15", "text": "名为“Okay,"}, {"type": "subtitle", "time": 196.869, "timestamp": "00:03:16", "text": "Japanese”的YouTube频道发布的视频。"}, {"type": "subtitle", "time": 199.19, "timestamp": "00:03:19", "text": "所以，"}, {"type": "subtitle", "time": 201.82999999999998, "timestamp": "00:03:21", "text": "我们会回顾一下"}, {"type": "subtitle", "time": 205.75, "timestamp": "00:03:25", "text": "我目前为止学过的汉字，就像"}, {"type": "subtitle", "time": 209.03, "timestamp": "00:03:29", "text": "上次的课程一样，"}, {"type": "subtitle", "time": 212.22899999999998, "timestamp": "00:03:32", "text": "上次的课程我把学过的汉字都复习了一遍，然后把剩下的"}, {"type": "subtitle", "time": 222.47, "timestamp": "00:03:42", "text": "20个汉字再学一遍，不是剩下的，还有"}, {"type": "subtitle", "time": 227.99, "timestamp": "00:03:47", "text": "更多，而是接下来的20个。"}, {"type": "subtitle", "time": 231.11, "timestamp": "00:03:51", "text": "如果我能记住大部分，"}, {"type": "subtitle", "time": 234.39, "timestamp": "00:03:54", "text": "我会试着测试自己，"}, {"type": "subtitle", "time": 237.429, "timestamp": "00:03:57", "text": "以免忘记，然后我们再学习接下来的20个。"}]
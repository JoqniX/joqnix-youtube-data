[{"type": "subtitle", "time": 10683.269, "timestamp": "02:58:03", "text": "[笑聲] 火柴人。  火柴人。  是"}, {"type": "subtitle", "time": 10703.03, "timestamp": "02:58:23", "text": "印尼人。  我來自印度。在日本？還沒有。我四月要去日本學習"}, {"type": "subtitle", "time": 10736.23, "timestamp": "02:58:56", "text": "語言。明年四月。但4月1日。  4月1日我將在日本。我會在日本。所以，雖然4月1日是愚人節，"}, {"type": "subtitle", "time": 10738.95, "timestamp": "02:58:58", "text": "但是[笑]是的，到那時我應該已經抵達"}]
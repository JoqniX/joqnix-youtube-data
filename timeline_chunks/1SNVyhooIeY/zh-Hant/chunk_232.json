[{"type": "subtitle", "time": 13943.59, "timestamp": "03:52:23", "text": "我也知道這一點。我也知道這一點。  哇。  瑞恩也知道這一點。  我忘了這場演唱會。  啊，"}, {"type": "subtitle", "time": 13962.87, "timestamp": "03:52:42", "text": "我以前也有過這個。哦，我不會寫那個「門」的漢字。呃，那是「門」的"}, {"type": "subtitle", "time": 13975.11, "timestamp": "03:52:55", "text": "漢字。這是「門」的漢字"}]
[{"type": "subtitle", "time": 4033.43, "timestamp": "01:07:13", "text": "哦，你"}, {"type": "subtitle", "time": 4038.39, "timestamp": "01:07:18", "text": "知道瑜伽。  晚上。  你今晚。  我回家了。  辛苦工作後回到家。"}, {"type": "subtitle", "time": 4044.23, "timestamp": "01:07:24", "text": "月亮睡覺也需要毯子。  哦，它肯定不能把那"}, {"type": "subtitle", "time": 4050.71, "timestamp": "01:07:30", "text": "東西打開。"}]
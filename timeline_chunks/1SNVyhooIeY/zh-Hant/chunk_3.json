[{"type": "subtitle", "time": 182.39, "timestamp": "00:03:02", "text": "呃，我們要複習一下漢字"}, {"type": "subtitle", "time": 186.79, "timestamp": "00:03:06", "text": "。嗯，我們一直在關註一個"}, {"type": "subtitle", "time": 195.11, "timestamp": "00:03:15", "text": "名為「Okay, Japanese」的YouTube頻道發布的影片。"}, {"type": "subtitle", "time": 199.19, "timestamp": "00:03:19", "text": "所以，"}, {"type": "subtitle", "time": 201.82999999999998, "timestamp": "00:03:21", "text": "我們會回顧一下"}, {"type": "subtitle", "time": 205.75, "timestamp": "00:03:25", "text": "我目前為止學過的漢字，就像"}, {"type": "subtitle", "time": 209.03, "timestamp": "00:03:29", "text": "上次的課程一樣，"}, {"type": "subtitle", "time": 212.22899999999998, "timestamp": "00:03:32", "text": "上次的課程我把學過的漢字都複習了一遍，然後把"}, {"type": "subtitle", "time": 222.47, "timestamp": "00:03:42", "text": "剩下的20個漢字再學一遍，不是剩下的，還有"}, {"type": "subtitle", "time": 227.99, "timestamp": "00:03:47", "text": "更多，而是接下來的20個。"}, {"type": "subtitle", "time": 231.11, "timestamp": "00:03:51", "text": "如果我能記住大部分，我"}, {"type": "subtitle", "time": 234.39, "timestamp": "00:03:54", "text": "會試著測試自己，以免"}, {"type": "subtitle", "time": 237.429, "timestamp": "00:03:57", "text": "忘記，然後我們再學習接下來的20個。"}]
[{"type": "subtitle", "time": 13941.11, "timestamp": "03:52:21", "text": "勉強配信について聞き"}, {"type": "subtitle", "time": 13943.59, "timestamp": "03:52:23", "text": "たいこと、というか"}, {"type": "subtitle", "time": 13947.429, "timestamp": "03:52:27", "text": "自分で調べなきゃいけないと思うことがあるんだけど。"}, {"type": "subtitle", "time": 13950.15, "timestamp": "03:52:30", "text": "他の人はどうやって勉強配信や"}, {"type": "subtitle", "time": 13953.429, "timestamp": "03:52:33", "text": "語学学習配信をしているんだろう？"}, {"type": "subtitle", "time": 13962.87, "timestamp": "03:52:42", "text": "ただこのビデオを使っているだけ。"}, {"type": "subtitle", "time": 13967.269, "timestamp": "03:52:47", "text": "それで、私はただ"}, {"type": "subtitle", "time": 13975.11, "timestamp": "03:52:55", "text": "この"}, {"type": "subtitle", "time": 13977.85, "timestamp": "03:52:57", "text": "1時間のビデオ"}]
[{"type": "subtitle", "time": 1560.31, "timestamp": "00:26:00", "text": "朝早く、例えば5時4分くらいに起きて"}, {"type": "subtitle", "time": 1563.029, "timestamp": "00:26:03", "text": "、[音楽]復習や"}, {"type": "subtitle", "time": 1564.549, "timestamp": "00:26:04", "text": "勉強を始めましょう。"}, {"type": "subtitle", "time": 1567.11, "timestamp": "00:26:07", "text": "勉強ではない。 うん、復習して、"}, {"type": "subtitle", "time": 1568.71, "timestamp": "00:26:08", "text": "試験頑張ってね。 試験は"}, {"type": "subtitle", "time": 1572.23, "timestamp": "00:26:12", "text": "しっかり書きましょう。 うん。"}, {"type": "subtitle", "time": 1575.75, "timestamp": "00:26:15", "text": "それで、昨日みたいにすごく不安になったんです"}, {"type": "subtitle", "time": 1581.51, "timestamp": "00:26:21", "text": "[笑い] 昨日はすごく"}, {"type": "subtitle", "time": 1597.99, "timestamp": "00:26:37", "text": "典型的な発音を 1 つだけ示しています。"}, {"type": "subtitle", "time": 1603.43, "timestamp": "00:26:43", "text": "はい、典型的な発音です。"}, {"type": "subtitle", "time": 1607.669, "timestamp": "00:26:47", "text": "これまでに学んだ漢字をすべて書いて、"}, {"type": "subtitle", "time": 1610.63, "timestamp": "00:26:50", "text": "5 分から 10 分練習してみてください。何度も何度も"}, {"type": "subtitle", "time": 1613.43, "timestamp": "00:26:53", "text": "書き続けてください。 そうするべきだと"}, {"type": "subtitle", "time": 1618.71, "timestamp": "00:26:58", "text": "思う。   そんな感じですね"}]
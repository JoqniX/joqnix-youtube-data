[{"type": "subtitle", "time": 11101.59, "timestamp": "03:05:01", "text": "漢字がそこにあったのですが、えーと水"}, {"type": "subtitle", "time": 11106.309, "timestamp": "03:05:06", "text": "漢字ではなく、えーと漢字があったとき、それは"}, {"type": "subtitle", "time": 11112.87, "timestamp": "03:05:12", "text": "何だったのか、"}, {"type": "subtitle", "time": 11115.91, "timestamp": "03:05:15", "text": "そして[笑い]先生、"}, {"type": "subtitle", "time": 11118.71, "timestamp": "03:05:18", "text": "そこで何が起こったのですか?"}, {"type": "subtitle", "time": 11120.309, "timestamp": "03:05:20", "text": "そして私の場合、"}, {"type": "subtitle", "time": 11124.07, "timestamp": "03:05:24", "text": "今はプレッシャーがかかっている時でも、"}, {"type": "subtitle", "time": 11126.389, "timestamp": "03:05:26", "text": "何か（楽譜）を読んでからもう一度読み返すと、"}, {"type": "chat", "time": 11126.802, "timestamp": "03:05:26", "author": "@FEROCIOUS_Grrr", "avatar": "https://yt4.ggpht.com/b2fcSyaRaGAEUJaW8yBs5ibxfiDi-brp1G8cHHTYAXKaRusaeuWU68kOjIUNWz1gmVNNSGP5MQ=s64-c-k-c0x00ffffff-no-rj", "message": "you still on it 😮... i was just about to Sleep 😴"}, {"type": "chat", "time": 11147.426, "timestamp": "03:05:47", "author": "@FEROCIOUS_Grrr", "avatar": "https://yt4.ggpht.com/b2fcSyaRaGAEUJaW8yBs5ibxfiDi-brp1G8cHHTYAXKaRusaeuWU68kOjIUNWz1gmVNNSGP5MQ=s64-c-k-c0x00ffffff-no-rj", "message": ";)"}, {"type": "subtitle", "time": 11154.79, "timestamp": "03:05:54", "text": "。 たぶんこんな感じだと思います"}, {"type": "subtitle", "time": 11157.349, "timestamp": "03:05:57", "text": "。 忘れた。 ああ、私も"}, {"type": "subtitle", "time": 11159.51, "timestamp": "03:05:59", "text": "練習しないといけないし、漢字も5つ覚えなきゃ。"}]
[{"type": "subtitle", "time": 12497.11, "timestamp": "03:28:17", "text": "日本語を勉強し始めてどれくらいになりますか"}, {"type": "subtitle", "time": 12500.63, "timestamp": "03:28:20", "text": "？  N5は昨年でした。 私は"}, {"type": "subtitle", "time": 12503.67, "timestamp": "03:28:23", "text": "2ヶ月以内にN5試験に合格しました。 それで、12月か"}, {"type": "subtitle", "time": 12508.71, "timestamp": "03:28:28", "text": "1月にQ5試験を受けて、"}, {"type": "subtitle", "time": 12513.51, "timestamp": "03:28:33", "text": "2月に合格しました。 それからN4の"}, {"type": "subtitle", "time": 12515.75, "timestamp": "03:28:35", "text": "コースを受講するために日本に行く予定だったんです。"}, {"type": "subtitle", "time": 12518.55, "timestamp": "03:28:38", "text": "いいえ、2年間のコースのことです。 いいえ、"}, {"type": "subtitle", "time": 12520.469, "timestamp": "03:28:40", "text": "1年9ヶ月でした。 ええ、"}, {"type": "subtitle", "time": 12523.349, "timestamp": "03:28:43", "text": "今年の7月頃に行く予定だったんです"}, {"type": "subtitle", "time": 12527.429, "timestamp": "03:28:47", "text": "が、それが予期せず"}, {"type": "subtitle", "time": 12529.429, "timestamp": "03:28:49", "text": "延期になってしまったんです。"}, {"type": "subtitle", "time": 12534.07, "timestamp": "03:28:54", "text": "それで、そのことが起こったので、"}, {"type": "subtitle", "time": 12537.51, "timestamp": "03:28:57", "text": "私は地元のN4の授業に出席しなければなりませんでした"}]
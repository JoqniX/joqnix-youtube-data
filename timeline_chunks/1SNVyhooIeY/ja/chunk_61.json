[{"type": "subtitle", "time": 3661.03, "timestamp": "01:01:01", "text": "なぜ苦しんでいるのかというと、試験が"}, {"type": "subtitle", "time": 3663.447, "timestamp": "01:01:03", "text": "近づいていて、どんなことがあっても"}, {"type": "subtitle", "time": 3667.27, "timestamp": "01:01:07", "text": "失敗するわけにはいかないからです"}, {"type": "subtitle", "time": 3670.71, "timestamp": "01:01:10", "text": "。"}, {"type": "subtitle", "time": 3675.109, "timestamp": "01:01:15", "text": "試験勉強をするつもりで勉強しなければならない。"}, {"type": "subtitle", "time": 3678.069, "timestamp": "01:01:18", "text": "勉強も復習もしてないから、試験みたいなのをやろうと思ってる"}, {"type": "subtitle", "time": 3680.95, "timestamp": "01:01:20", "text": "。 私は苦しんでいる。"}, {"type": "subtitle", "time": 3699.91, "timestamp": "01:01:39", "text": "音楽に関して、あなたがこれ"}, {"type": "subtitle", "time": 3703.43, "timestamp": "01:01:43", "text": "までにどれだけ学んだか確認してみましょう。"}, {"type": "subtitle", "time": 3705.109, "timestamp": "01:01:45", "text": "この[音楽]テストを始める前に"}, {"type": "subtitle", "time": 3708.47, "timestamp": "01:01:48", "text": "、これは30個の漢字です。 これは"}, {"type": "subtitle", "time": 3711.67, "timestamp": "01:01:51", "text": "現在30歳です。"}, {"type": "subtitle", "time": 3715.19, "timestamp": "01:01:55", "text": "180 問中 30 問。1"}]
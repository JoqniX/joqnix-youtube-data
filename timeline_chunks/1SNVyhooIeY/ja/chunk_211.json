[{"type": "subtitle", "time": 12661.19, "timestamp": "03:31:01", "text": "サイクリングって、ほら"}, {"type": "subtitle", "time": 12662.87, "timestamp": "03:31:02", "text": "、"}, {"type": "subtitle", "time": 12667.75, "timestamp": "03:31:07", "text": "（ため息）"}, {"type": "subtitle", "time": 12699.67, "timestamp": "03:31:39", "text": "と３と２。"}, {"type": "subtitle", "time": 12702.07, "timestamp": "03:31:42", "text": "ああ、私もです。 私も。"}, {"type": "subtitle", "time": 12703.75, "timestamp": "03:31:43", "text": "日本語を完全に終えたら、いよいよ"}, {"type": "subtitle", "time": 12706.15, "timestamp": "03:31:46", "text": "中国語（北京語）の勉強を始めます。"}, {"type": "subtitle", "time": 12709.269, "timestamp": "03:31:49", "text": "以前はBilly Billyで配信をしていた。 いいえ。それに、"}, {"type": "subtitle", "time": 12710.95, "timestamp": "03:31:50", "text": "ビリー・ビリーの出演者たちは"}, {"type": "subtitle", "time": 12714.389, "timestamp": "03:31:54", "text": "今では英語すら話せないんです。 だから、もし私が配信で"}, {"type": "subtitle", "time": 12716.07, "timestamp": "03:31:56", "text": "英語で話しても、彼らは"}, {"type": "subtitle", "time": 12718.95, "timestamp": "03:31:58", "text": "その一言も理解してくれないだろう。"}]
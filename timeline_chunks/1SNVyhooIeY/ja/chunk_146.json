[{"type": "subtitle", "time": 8760.309, "timestamp": "02:26:00", "text": "（笑）"}, {"type": "subtitle", "time": 8764.389, "timestamp": "02:26:04", "text": "複雑すぎる"}, {"type": "subtitle", "time": 8766.79, "timestamp": "02:26:06", "text": "ものですね。  [音楽] でも、私は自分が"}, {"type": "subtitle", "time": 8768.95, "timestamp": "02:26:08", "text": "このやり方でやりたいと思ったことを知りたかったんです。 私は、自分がオリジナル曲を聴いている"}, {"type": "subtitle", "time": 8775.75, "timestamp": "02:26:15", "text": "間、配信を見ている人たちにはインストゥルメンタル版を聴かせることができるような機能が欲しかったのです"}, {"type": "subtitle", "time": 8778.87, "timestamp": "02:26:18", "text": "。"}, {"type": "subtitle", "time": 8781.19, "timestamp": "02:26:21", "text": "右。 まるで"}, {"type": "subtitle", "time": 8783.349, "timestamp": "02:26:23", "text": "コンサートをやっているみたいで、"}, {"type": "subtitle", "time": 8786.469, "timestamp": "02:26:26", "text": "モニターから"}, {"type": "subtitle", "time": 8790.389, "timestamp": "02:26:30", "text": "実際の曲が聞こえてくるような感じ。"}, {"type": "subtitle", "time": 8792.23, "timestamp": "02:26:32", "text": "待って、"}, {"type": "subtitle", "time": 8795.59, "timestamp": "02:26:35", "text": "言葉とかそういうのが楽になるんだよ。うん、でも私にはわからないな"}, {"type": "subtitle", "time": 8797.75, "timestamp": "02:26:37", "text": "。 いいえ、"}, {"type": "subtitle", "time": 8801.27, "timestamp": "02:26:41", "text": "YouTube Musicから曲をダウンロードするので、"}, {"type": "subtitle", "time": 8803.946, "timestamp": "02:26:43", "text": "これを使ってここをクリックしてダウンロードします。"}, {"type": "subtitle", "time": 8804.95, "timestamp": "02:26:44", "text": "[笑い]"}, {"type": "subtitle", "time": 8807.19, "timestamp": "02:26:47", "text": "時々そう感じるけど、実際には"}, {"type": "subtitle", "time": 8812.309, "timestamp": "02:26:52", "text": "ダウンロードして抽出して、"}, {"type": "subtitle", "time": 8815.429, "timestamp": "02:26:55", "text": "今、ボーカル除去の作業をします。 そのため、それが著作"}]
[{"type": "subtitle", "time": 12313.51, "timestamp": "03:25:13", "text": "モーティは大丈夫だよ。 またそんな気分だ"}, {"type": "subtitle", "time": 12329.75, "timestamp": "03:25:29", "text": "筆跡がひどくて、提出物もそんな風には書けません"}, {"type": "subtitle", "time": 12340.71, "timestamp": "03:25:40", "text": "だから私みたいにならないで。 そうそう。 ああ、私。"}, {"type": "subtitle", "time": 12342.71, "timestamp": "03:25:42", "text": "えっと、どう言ったの？ ああ、"}, {"type": "subtitle", "time": 12347.75, "timestamp": "03:25:47", "text": "今日本で実際に日本語の授業を受けている時は、自分の字の書き方"}, {"type": "subtitle", "time": 12350.63, "timestamp": "03:25:50", "text": "や"}, {"type": "subtitle", "time": 12358.389, "timestamp": "03:25:58", "text": "そうそう。 私は毎日"}]
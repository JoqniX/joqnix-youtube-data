[{"type": "subtitle", "time": 7921.83, "timestamp": "02:12:01", "text": "私たちは現在、日本語を勉強しています。 えっと、"}, {"type": "subtitle", "time": 7924.709, "timestamp": "02:12:04", "text": "明日テストがあって、漢字の"}, {"type": "subtitle", "time": 7928.95, "timestamp": "02:12:08", "text": "テストもあるんです。 えーと、僕たちは音楽が好きで、いろいろ"}, {"type": "subtitle", "time": 7932.47, "timestamp": "02:12:12", "text": "チェックしたり、"}, {"type": "subtitle", "time": 7940.47, "timestamp": "02:12:20", "text": "昼食時に一緒に「日本語ゼロから学ぶ」というウェブサイトを見ていく予定です。"}, {"type": "subtitle", "time": 7942.79, "timestamp": "02:12:22", "text": "楽しかった。 ちょっと待って。 ゼロの"}, {"type": "subtitle", "time": 7946.709, "timestamp": "02:12:26", "text": "ウェブサイトはどこにありますか？ ちょっと待ってください"}, {"type": "subtitle", "time": 7959.43, "timestamp": "02:12:39", "text": "どうだった？ 日本語を習得できましたか"}, {"type": "subtitle", "time": 7960.951, "timestamp": "02:12:40", "text": "？"}, {"type": "subtitle", "time": 7962.47, "timestamp": "02:12:42", "text": "[笑い]"}, {"type": "subtitle", "time": 7965.27, "timestamp": "02:12:45", "text": "それで、えっと、"}, {"type": "subtitle", "time": 7974.39, "timestamp": "02:12:54", "text": "えっと、漢字を勉強しているなら、いや、"}, {"type": "subtitle", "time": 7976.069, "timestamp": "02:12:56", "text": "彼らが提供している無料コンテンツよりも先まで進んでいます。"}]
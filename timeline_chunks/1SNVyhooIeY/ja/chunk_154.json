[{"type": "subtitle", "time": 9242.16, "timestamp": "02:34:02", "text": "やらなきゃいけない。 ねえ、5回の戦いを10"}, {"type": "subtitle", "time": 9244.64, "timestamp": "02:34:04", "text": "ねえ、5回の戦いを10 回書こう。"}, {"type": "subtitle", "time": 9246.72, "timestamp": "02:34:06", "text": "回書こう。 ちょっと戻ってみます。"}, {"type": "subtitle", "time": 9258.309, "timestamp": "02:34:18", "text": "あの、ユミタを使っていますか？ ユミタとは何ですか？"}, {"type": "subtitle", "time": 9276.07, "timestamp": "02:34:36", "text": "ああ、これは辞書ですか？ ああ、これ見たことあるよ"}, {"type": "subtitle", "time": 9279.429, "timestamp": "02:34:39", "text": "。 ずっとずっと昔に一度だけ使ったことがあります"}, {"type": "subtitle", "time": 9282.95, "timestamp": "02:34:42", "text": "。"}, {"type": "subtitle", "time": 9285.91, "timestamp": "02:34:45", "text": "強力だ。  Ankiのフラッシュカード機能と"}, {"type": "subtitle", "time": 9294.87, "timestamp": "02:34:54", "text": "日本語のレッスン。 そう、それ"}, {"type": "subtitle", "time": 9297.67, "timestamp": "02:34:57", "text": "も"}, {"type": "subtitle", "time": 9299.75, "timestamp": "02:34:59", "text": "日本語の授業ではないんです。 まるで"}]
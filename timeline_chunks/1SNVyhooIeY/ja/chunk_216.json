[{"type": "subtitle", "time": 12962.389, "timestamp": "03:36:02", "text": "それが私の要約。"}, {"type": "subtitle", "time": 12969.429, "timestamp": "03:36:09", "text": "来月、学位試験、学士試験があるんだけど、"}, {"type": "subtitle", "time": 12971.269, "timestamp": "03:36:11", "text": "どの科目を書けばいいのかもわからない"}, {"type": "subtitle", "time": 12997.19, "timestamp": "03:36:37", "text": "ホリデーでしばらくそこに滞在するとか"}, {"type": "subtitle", "time": 13002.79, "timestamp": "03:36:42", "text": "。"}, {"type": "subtitle", "time": 13010.87, "timestamp": "03:36:50", "text": "ビザの件で真っ直ぐになっている"}, {"type": "subtitle", "time": 13018.07, "timestamp": "03:36:58", "text": "そして、"}]
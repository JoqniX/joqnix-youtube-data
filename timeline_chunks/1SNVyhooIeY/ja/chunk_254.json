[{"type": "subtitle", "time": 15241.99, "timestamp": "04:14:01", "text": "親戚と助けだけど。"}, {"type": "subtitle", "time": 15265.83, "timestamp": "04:14:25", "text": "毒素に切り替えよう。"}, {"type": "subtitle", "time": 15272.07, "timestamp": "04:14:32", "text": "でも、明日も多分、"}, {"type": "subtitle", "time": 15277.51, "timestamp": "04:14:37", "text": "ストリームをスケジュールしないつもり。"}, {"type": "subtitle", "time": 15279.429, "timestamp": "04:14:39", "text": "直前にスケジュールするだけ。でも、"}, {"type": "subtitle", "time": 15284.149, "timestamp": "04:14:44", "text": "えーと、明日は何日？ 28日。ああ、27日。"}, {"type": "subtitle", "time": 15287.75, "timestamp": "04:14:47", "text": "ああ、こんにちは。ストリームの"}, {"type": "subtitle", "time": 15289.349, "timestamp": "04:14:49", "text": "スケジュールはありますか？"}, {"type": "subtitle", "time": 15292.309, "timestamp": "04:14:52", "text": "前に発表したように、"}, {"type": "subtitle", "time": 15295.03, "timestamp": "04:14:55", "text": "最近発表したように、試験シーズンが近づいているので、勉強ストリームをしなければならないので、"}]
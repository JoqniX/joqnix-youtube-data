[{"type": "subtitle", "time": 8102.629, "timestamp": "02:15:02", "text": "月曜日に起こるはずです。 ええと、この試験は"}, {"type": "subtitle", "time": 8106.149, "timestamp": "02:15:06", "text": "毎月2週間ごとに実施されます。"}, {"type": "subtitle", "time": 8108.55, "timestamp": "02:15:08", "text": "例えば、来月は12月です。"}, {"type": "subtitle", "time": 8113.03, "timestamp": "02:15:13", "text": "いいえ。JPTは12月7日です。  NATは"}, {"type": "subtitle", "time": 8115.91, "timestamp": "02:15:15", "text": "14日に開催されます。"}, {"type": "subtitle", "time": 8118.55, "timestamp": "02:15:18", "text": "だから、"}, {"type": "subtitle", "time": 8122.069, "timestamp": "02:15:22", "text": "私は挨拶はしません。 こんにちは。 ああ、すみません。"}, {"type": "subtitle", "time": 8124.703, "timestamp": "02:15:24", "text": "忘れた。"}, {"type": "subtitle", "time": 8127.669, "timestamp": "02:15:27", "text": "[息を呑む] 忘れてた。 こんにちは。"}, {"type": "subtitle", "time": 8141.51, "timestamp": "02:15:41", "text": "待って。 私はそのことについては話さなかった。 あなたはそれ"}, {"type": "subtitle", "time": 8146.973, "timestamp": "02:15:46", "text": "について何も聞いていなかった。 こんにちは。"}, {"type": "subtitle", "time": 8148.47, "timestamp": "02:15:48", "text": "[笑い] ちょっと調べてみます"}, {"type": "subtitle", "time": 8150.95, "timestamp": "02:15:50", "text": "。 こんにちは。"}, {"type": "subtitle", "time": 8157.43, "timestamp": "02:15:57", "text": "あなたの地域でそれが利用可能かどうか確認しました。 テストサイトがあるなら、それは"}]
[{"type": "subtitle", "time": 8948.55, "timestamp": "02:29:08", "text": "ああ、今はブラックフライデーだね。"}, {"type": "subtitle", "time": 8954.469, "timestamp": "02:29:14", "text": "オーディオプラグインとか何か買いましたか？ 私の"}, {"type": "subtitle", "time": 8958.309, "timestamp": "02:29:18", "text": "Twitterは、"}, {"type": "subtitle", "time": 8961.11, "timestamp": "02:29:21", "text": "オーディオフィルターや"}, {"type": "subtitle", "time": 8964.15, "timestamp": "02:29:24", "text": "オーディオプラグインを勧める人たちで溢れています。 メロディンとかいう"}, {"type": "subtitle", "time": 8967.75, "timestamp": "02:29:27", "text": "やつ。 メロディン３つか４つ。"}, {"type": "subtitle", "time": 8971.429, "timestamp": "02:29:31", "text": "録音や取材などに最適です。"}, {"type": "subtitle", "time": 8976.214, "timestamp": "02:29:36", "text": "音声処理関連のもの。 たくさん"}, {"type": "subtitle", "time": 8977.67, "timestamp": "02:29:37", "text": "（笑）本当にたくさん"}, {"type": "subtitle", "time": 8981.67, "timestamp": "02:29:41", "text": "。"}]
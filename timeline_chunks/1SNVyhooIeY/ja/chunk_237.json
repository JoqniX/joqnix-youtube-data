[{"type": "subtitle", "time": 14220.15, "timestamp": "03:57:00", "text": "これは難しい。このロープはちょっと"}, {"type": "subtitle", "time": 14230.469, "timestamp": "03:57:10", "text": "よし、これは使わないでおこう。そして、こんな"}, {"type": "subtitle", "time": 14234.55, "timestamp": "03:57:14", "text": "設定もある。"}, {"type": "subtitle", "time": 14236.95, "timestamp": "03:57:16", "text": "ああ [笑い] なんてこった、"}, {"type": "subtitle", "time": 14248.469, "timestamp": "03:57:28", "text": "よし。もうスタビライザーは使わない。"}, {"type": "subtitle", "time": 14250.389, "timestamp": "03:57:30", "text": "あ、ロープの深さとかそういうのがあっちにある"}, {"type": "subtitle", "time": 14258.469, "timestamp": "03:57:38", "text": "あ、待って。あ、もっと"}, {"type": "subtitle", "time": 14267.03, "timestamp": "03:57:47", "text": "すごい。"}]
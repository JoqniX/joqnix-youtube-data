[{"type": "subtitle", "time": 1741.909, "timestamp": "00:29:01", "text": "。   ええ、そうですね"}, {"type": "subtitle", "time": 1745.11, "timestamp": "00:29:05", "text": "、"}, {"type": "subtitle", "time": 1747.75, "timestamp": "00:29:07", "text": "流れとかを描くのに良いですよ。  [笑い]"}, {"type": "subtitle", "time": 1749.59, "timestamp": "00:29:09", "text": "黒板を置いて、"}, {"type": "subtitle", "time": 1757.83, "timestamp": "00:29:17", "text": "これを手に入れたいと思ったんだけど、"}, {"type": "subtitle", "time": 1761.669, "timestamp": "00:29:21", "text": "どうやら、すでに私が"}, {"type": "subtitle", "time": 1764.389, "timestamp": "00:29:24", "text": "支払わなければならないすべてのサブスクリプションで、すでに"}, {"type": "subtitle", "time": 1768.31, "timestamp": "00:29:28", "text": "破産状態になっているようです。"}, {"type": "subtitle", "time": 1771.909, "timestamp": "00:29:31", "text": "ええ、今月は音楽"}, {"type": "subtitle", "time": 1774.549, "timestamp": "00:29:34", "text": "ソフトウェアと"}, {"type": "subtitle", "time": 1776.87, "timestamp": "00:29:36", "text": "その他諸々に使います。 だから私は「わかった、わかった"}, {"type": "subtitle", "time": 1778.95, "timestamp": "00:29:38", "text": "。じゃあ、"}, {"type": "subtitle", "time": 1781.11, "timestamp": "00:29:41", "text": "貯金するよ」って思ったんです。   だから、"}, {"type": "subtitle", "time": 1784.71, "timestamp": "00:29:44", "text": "アー"}]
[{"type": "subtitle", "time": 13394.79, "timestamp": "03:43:14", "text": "もっと難しい。ごめん。"}, {"type": "subtitle", "time": 13401.67, "timestamp": "03:43:21", "text": "日本がどこにあるのか難しい。"}, {"type": "subtitle", "time": 13417.269, "timestamp": "03:43:37", "text": "持って行く。待って、どこに行くの？"}, {"type": "subtitle", "time": 13420.389, "timestamp": "03:43:40", "text": "到着後90日間有効。"}, {"type": "subtitle", "time": 13422.87, "timestamp": "03:43:42", "text": "入国回数、1回入国、1入国につき最大90日"}, {"type": "subtitle", "time": 13425.59, "timestamp": "03:43:45", "text": "。うん"}, {"type": "subtitle", "time": 13428.95, "timestamp": "03:43:48", "text": "、"}]
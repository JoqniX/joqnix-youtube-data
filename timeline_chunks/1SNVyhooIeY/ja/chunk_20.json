[{"type": "subtitle", "time": 1201.27, "timestamp": "00:20:01", "text": "えっと、ここにも載せておきますね"}, {"type": "subtitle", "time": 1203.909, "timestamp": "00:20:03", "text": "。"}, {"type": "subtitle", "time": 1208.95, "timestamp": "00:20:08", "text": "説明欄に書いておきます。 このビデオでは、より"}, {"type": "subtitle", "time": 1215.75, "timestamp": "00:20:15", "text": "ラフな表現や歌を学ぶための説明を参照しています。また、"}, {"type": "subtitle", "time": 1226.63, "timestamp": "00:20:26", "text": "ビデオのリンクから今すぐ説明を確認すると、更新された説明が表示されます。"}, {"type": "subtitle", "time": 1228.23, "timestamp": "00:20:28", "text": "ああ、わかった"}, {"type": "subtitle", "time": 1236.95, "timestamp": "00:20:36", "text": "この配信が始まる少し前に見ていました。"}, {"type": "subtitle", "time": 1239.83, "timestamp": "00:20:39", "text": "えっと、漢字の動画です。"}, {"type": "subtitle", "time": 1242.549, "timestamp": "00:20:42", "text": "私たちはまだそれを実行しません。  [笑い]"}, {"type": "subtitle", "time": 1246.549, "timestamp": "00:20:46", "text": "ええと、これにはもっと続きがあります。 えっと、私が"}, {"type": "subtitle", "time": 1250.07, "timestamp": "00:20:50", "text": "学んだことは何でも、それを"}, {"type": "subtitle", "time": 1253.909, "timestamp": "00:20:53", "text": "復習します。 それでは、それを修正します"}, {"type": "subtitle", "time": 1255.51, "timestamp": "00:20:55", "text": "。   えっと、"}, {"type": "subtitle", "time": 1258.71, "timestamp": "00:20:58", "text": "親和性ってどこにあるんだっけ？"}]
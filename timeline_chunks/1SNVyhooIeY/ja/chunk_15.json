[{"type": "subtitle", "time": 901.99, "timestamp": "00:15:01", "text": "31日はいつですか？ わかった。"}, {"type": "subtitle", "time": 905.99, "timestamp": "00:15:05", "text": "来週にはおそらく"}, {"type": "subtitle", "time": 908.31, "timestamp": "00:15:08", "text": "Googleフォームを公開する予定です。"}, {"type": "subtitle", "time": 912.629, "timestamp": "00:15:12", "text": "それは私の"}, {"type": "subtitle", "time": 914.71, "timestamp": "00:15:14", "text": "すべての"}, {"type": "subtitle", "time": 917.189, "timestamp": "00:15:17", "text": "発表の場所で利用可能になります。  DiscordやYouTubeのコミュニティ"}, {"type": "subtitle", "time": 921.03, "timestamp": "00:15:21", "text": "投稿など、すべて。 でもTwitchの皆さん、"}, {"type": "chat", "time": 922.651, "timestamp": "00:15:22", "author": "@NamanRajput-n8w", "avatar": "https://yt4.ggpht.com/I6iqd552DDv0-h99h5Wdf--ghvHwCddgcMGIkvGcK0nm2x2lAQfpfnw3D79kzo0NRZohHO_a=s64-c-k-c0x00ffffff-no-rj", "message": "how old are you"}, {"type": "subtitle", "time": 924.23, "timestamp": "00:15:24", "text": "Twitchで情報を提供するにはどうすればいいですか？"}, {"type": "subtitle", "time": 931.35, "timestamp": "00:15:31", "text": "Twitchのストーリーみたいなものを作った方がいいのかな？"}, {"type": "subtitle", "time": 934.15, "timestamp": "00:15:34", "text": "それともリンクを貼るだけでいいのかな？"}, {"type": "subtitle", "time": 936.79, "timestamp": "00:15:36", "text": "リンクを貼ることはできますよね？"}, {"type": "subtitle", "time": 940.31, "timestamp": "00:15:40", "text": "Twitchのストーリーは試したことがない。"}, {"type": "subtitle", "time": 942.23, "timestamp": "00:15:42", "text": "Twitch を利用している方で、"}, {"type": "subtitle", "time": 946.47, "timestamp": "00:15:46", "text": "スマホで Twitch のストーリーを確認した方はいますか？   それってしても"}, {"type": "subtitle", "time": 949.269, "timestamp": "00:15:49", "text": "いいですか？ アンケートのようなものが欲しいのですが、アンケートというよりは"}, {"type": "subtitle", "time": 953.749, "timestamp": "00:15:53", "text": "フィードバックフォーラムのようなものが欲しいです。"}, {"type": "subtitle", "time": 956.87, "timestamp": "00:15:56", "text": "えーっと、私の配信を見てくれる人たちが私に何を求めているのかを知りたいんです。例えば、"}, {"type": "subtitle", "time": 958.87, "timestamp": "00:15:58", "text": "どんなタイプの"}]
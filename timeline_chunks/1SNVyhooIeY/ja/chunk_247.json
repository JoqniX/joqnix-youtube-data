[{"type": "subtitle", "time": 14821.189, "timestamp": "04:07:01", "text": "もし今忘れても、"}, {"type": "subtitle", "time": 14846.07, "timestamp": "04:07:26", "text": "あ、あ、日本語でいっぱいだ。なんでか分から"}, {"type": "subtitle", "time": 14848.309, "timestamp": "04:07:28", "text": "ないけど、"}, {"type": "subtitle", "time": 14851.03, "timestamp": "04:07:31", "text": "UIとか全部日本語だと、"}, {"type": "subtitle", "time": 14853.99, "timestamp": "04:07:33", "text": "怖くなっちゃうんだよね。 読みたくない、やめなきゃ、"}, {"type": "subtitle", "time": 14865.03, "timestamp": "04:07:45", "text": "日本にいると全部日本語になるってわかってるから、"}, {"type": "subtitle", "time": 14869.316, "timestamp": "04:07:49", "text": "英語の看板なんてないよ"}, {"type": "subtitle", "time": 14870.71, "timestamp": "04:07:50", "text": "[笑] あるかもしれない"}, {"type": "subtitle", "time": 14873.83, "timestamp": "04:07:53", "text": "けど、それは稀だよね。そうだね、"}, {"type": "subtitle", "time": 14876.15, "timestamp": "04:07:56", "text": "君はユナイテッド・"}]
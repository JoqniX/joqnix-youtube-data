[{"type": "subtitle", "time": 242.07, "timestamp": "00:04:02", "text": "明日、"}, {"type": "subtitle", "time": 246.39, "timestamp": "00:04:06", "text": "別の漢字の試験があります。おそらく、"}, {"type": "subtitle", "time": 250.39, "timestamp": "00:04:10", "text": "[音楽] 明日は、"}, {"type": "subtitle", "time": 253.27, "timestamp": "00:04:13", "text": "水曜日は"}, {"type": "subtitle", "time": 255.67, "timestamp": "00:04:15", "text": "今日、水曜日は今日、水曜日です"}, {"type": "subtitle", "time": 259.509, "timestamp": "00:04:19", "text": "。 ええ、明日の木曜日、"}, {"type": "subtitle", "time": 263.27, "timestamp": "00:04:23", "text": "木曜日、土曜日、日曜日、ええと、私は"}, {"type": "subtitle", "time": 267.11, "timestamp": "00:04:27", "text": "タッチペーパーを持っています。"}, {"type": "subtitle", "time": 270.07, "timestamp": "00:04:30", "text": "それで、ええと"}, {"type": "subtitle", "time": 272.79, "timestamp": "00:04:32", "text": "、漢字テストのテスト用紙を用意します。"}, {"type": "subtitle", "time": 278.79, "timestamp": "00:04:38", "text": "漢字の勉強を本当に本当に本当に本当に終わらせたいです。"}, {"type": "subtitle", "time": 285.03, "timestamp": "00:04:45", "text": "何とかしてそれを私のシステムに、私の脳に取り込んでください。"}, {"type": "subtitle", "time": 290.15, "timestamp": "00:04:50", "text": "えーっと、これらすべて、それで、私はうまくやれると思います。"}, {"type": "subtitle", "time": 295.83, "timestamp": "00:04:55", "text": "私は最後の論文を書きました。それは昨日だったと思います。"}]
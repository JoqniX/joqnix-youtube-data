[{"type": "subtitle", "time": 7092.229, "timestamp": "01:58:12", "text": "私の脳がこれを理解できないので、私はとても泣きたい気持ちです。   私には理解できない"}, {"type": "subtitle", "time": 7096.95, "timestamp": "01:58:16", "text": "。 そして、「"}, {"type": "subtitle", "time": 7099.589, "timestamp": "01:58:19", "text": "ジョー、Ankiのデッキを使えばいいじゃないか」と言う人もいるでしょう"}, {"type": "subtitle", "time": 7101.189, "timestamp": "01:58:21", "text": "。"}, {"type": "subtitle", "time": 7104.31, "timestamp": "01:58:24", "text": "私がやることはすべて、常に"}, {"type": "subtitle", "time": 7111.189, "timestamp": "01:58:31", "text": "困難になるだろう。"}, {"type": "subtitle", "time": 7113.669, "timestamp": "01:58:33", "text": "そして私はすべてを忘れてしまう。 それで、何の"}]
[{"type": "subtitle", "time": 5463.43, "timestamp": "01:31:03", "text": "別のことを言っていたりしました。"}, {"type": "subtitle", "time": 5465.75, "timestamp": "01:31:05", "text": "だから、すべてがめちゃくちゃだった。 だから私は「"}, {"type": "subtitle", "time": 5469.51, "timestamp": "01:31:09", "text": "よし、語学を学ぼう」と思ったんです。"}, {"type": "subtitle", "time": 5476.07, "timestamp": "01:31:16", "text": "例えば、日本のニコンニコのようなプラットフォームで配信するとしたら、ニコンニコニコン"}, {"type": "subtitle", "time": 5481.35, "timestamp": "01:31:21", "text": "ニコで配信するとしたら、"}, {"type": "subtitle", "time": 5483.59, "timestamp": "01:31:23", "text": "完全に日本人しか"}, {"type": "subtitle", "time": 5487.03, "timestamp": "01:31:27", "text": "知らないプラットフォームなので、そこで"}, {"type": "subtitle", "time": 5490.47, "timestamp": "01:31:30", "text": "話すことはできますし、他の人が何を言っているのか理解しようとすることもできますが、"}, {"type": "subtitle", "time": 5496.39, "timestamp": "01:31:36", "text": "中国語は何もわかりません。"}, {"type": "subtitle", "time": 5500.39, "timestamp": "01:31:40", "text": "中国のアニメを見ても、何を言っているのかわかりません"}, {"type": "subtitle", "time": 5503.59, "timestamp": "01:31:43", "text": "。"}, {"type": "chat", "time": 5505.365, "timestamp": "01:31:45", "author": "@FEROCIOUS_Grrr", "avatar": "https://yt4.ggpht.com/b2fcSyaRaGAEUJaW8yBs5ibxfiDi-brp1G8cHHTYAXKaRusaeuWU68kOjIUNWz1gmVNNSGP5MQ=s64-c-k-c0x00ffffff-no-rj", "message": "i know english,hindi,german and if i include native then i also know maghi , bojhpuri , and a little bit marathi "}, {"type": "subtitle", "time": 5507.27, "timestamp": "01:31:47", "text": "ええ、だからこそ、どうして"}, {"type": "subtitle", "time": 5513.03, "timestamp": "01:31:53", "text": "私は日本語を理解できるんだろうといつも不思議に思うんです。"}, {"type": "subtitle", "time": 5515.11, "timestamp": "01:31:55", "text": "私がアニメを見すぎて、"}]
[{"type": "subtitle", "time": 9060.07, "timestamp": "02:31:00", "text": "走っている漢字の写真。 ああ、そうだね。 えっと、"}, {"type": "subtitle", "time": 9066.07, "timestamp": "02:31:06", "text": "うん。 うん。 ストローク順序付けツール。 つまり、筆順を"}, {"type": "subtitle", "time": 9070.71, "timestamp": "02:31:10", "text": "決める人ですね。 これは走る漢字だった。 えっと、"}, {"type": "subtitle", "time": 9079.03, "timestamp": "02:31:19", "text": "外漢字です。"}, {"type": "subtitle", "time": 9081.99, "timestamp": "02:31:21", "text": "ああ、なんてことだ。 日本語で「外」は何と言いますか"}, {"type": "subtitle", "time": 9083.51, "timestamp": "02:31:23", "text": "？   何てことだ"}, {"type": "subtitle", "time": 9101.67, "timestamp": "02:31:41", "text": "今夜は愛犬とゴスペルを歌う時間が取れそうにありません。 近いうちに"}, {"type": "subtitle", "time": 9103.67, "timestamp": "02:31:43", "text": "あなたの歌声を聴けることを願っています"}, {"type": "subtitle", "time": 9106.71, "timestamp": "02:31:46", "text": "。 こんにちは。"}, {"type": "subtitle", "time": 9109.03, "timestamp": "02:31:49", "text": "幸運を。 幸運を。 幸運を。 そして、ゆっくり"}, {"type": "subtitle", "time": 9111.349, "timestamp": "02:31:51", "text": "休んでください。"}, {"type": "subtitle", "time": 9113.27, "timestamp": "02:31:53", "text": "試験頑張ってください。 君ならできる。"}, {"type": "subtitle", "time": 9118.349, "timestamp": "02:31:58", "text": "こんにちは。 うん。 明日テスト。"}]
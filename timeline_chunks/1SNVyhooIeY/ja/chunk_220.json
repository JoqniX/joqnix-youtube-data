[{"type": "subtitle", "time": 13206.07, "timestamp": "03:40:06", "text": "インドネシアはある。マレーシアはある。"}, {"type": "subtitle", "time": 13209.11, "timestamp": "03:40:09", "text": "シンガポールはある。おい、8ではない。"}, {"type": "subtitle", "time": 13212.55, "timestamp": "03:40:12", "text": "これは何だ？8。8。8ではない。えーと、6か"}, {"type": "subtitle", "time": 13215.429, "timestamp": "03:40:15", "text": "月。ああ、免除。"}, {"type": "subtitle", "time": 13217.91, "timestamp": "03:40:17", "text": "例外はどこだ？"}, {"type": "subtitle", "time": 13219.67, "timestamp": "03:40:19", "text": "免除期間を申請するには90日以上必要だと言う。"}, {"type": "subtitle", "time": 13223.349, "timestamp": "03:40:23", "text": "州と距離4期間アパート"}, {"type": "subtitle", "time": 13226.469, "timestamp": "03:40:26", "text": "滞在expああ、"}, {"type": "subtitle", "time": 13236.229, "timestamp": "03:40:36", "text": "[笑い]"}, {"type": "subtitle", "time": 13238.309, "timestamp": "03:40:38", "text": "今、私はドイツ出身か"}, {"type": "subtitle", "time": 13249.51, "timestamp": "03:40:49", "text": "地図を作れるなんて知らなかった。"}, {"type": "subtitle", "time": 13254.07, "timestamp": "03:40:54", "text": "ライオンみたいなものを作ったり、"}]
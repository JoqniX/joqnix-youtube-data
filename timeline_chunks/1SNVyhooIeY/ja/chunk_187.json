[{"type": "subtitle", "time": 11238.55, "timestamp": "03:07:18", "text": "実は、"}, {"type": "subtitle", "time": 11241.75, "timestamp": "03:07:21", "text": "定期的に配信するべきかどうか悩んでいました。 正直に言うと、私は普段、"}, {"type": "subtitle", "time": 11244.23, "timestamp": "03:07:24", "text": "ゲーム配信のようなバラエティ豊かな配信をしたり"}, {"type": "subtitle", "time": 11246.469, "timestamp": "03:07:26", "text": "、"}, {"type": "subtitle", "time": 11249.99, "timestamp": "03:07:29", "text": "アートのようなクリエイティブな配信をしたり、Sammy と一緒に"}, {"type": "subtitle", "time": 11253.349, "timestamp": "03:07:33", "text": "自動化を行うのが好きなので技術的な配信をしたりしています"}, {"type": "subtitle", "time": 11254.95, "timestamp": "03:07:34", "text": "。   だから、"}, {"type": "subtitle", "time": 11263.11, "timestamp": "03:07:43", "text": "復習授業や"}, {"type": "subtitle", "time": 11267.19, "timestamp": "03:07:47", "text": "今週と来週の復習試験などでストレスが溜まっているので、いつかまたこれに取り組まなければならない。"}, {"type": "chat", "time": 11274.123, "timestamp": "03:07:54", "author": "@FEROCIOUS_Grrr", "avatar": "https://yt4.ggpht.com/b2fcSyaRaGAEUJaW8yBs5ibxfiDi-brp1G8cHHTYAXKaRusaeuWU68kOjIUNWz1gmVNNSGP5MQ=s64-c-k-c0x00ffffff-no-rj", "message": "The stage lights are dimming on the day. See you when the curtain rises again. Rest well!"}, {"type": "subtitle", "time": 11279.99, "timestamp": "03:07:59", "text": "当日、舞台の照明が暗くなっていく。"}]
[{"type": "subtitle", "time": 15430.469, "timestamp": "04:17:10", "text": "私の脳は完全に"}, {"type": "subtitle", "time": 15436.469, "timestamp": "04:17:16", "text": "死んでいます。エビを勉強しないといけないと思います。えーと、"}, {"type": "subtitle", "time": 15444.71, "timestamp": "04:17:24", "text": "金曜日は授業がないけど、やらなきゃいけない。"}, {"type": "subtitle", "time": 15450.389, "timestamp": "04:17:30", "text": "都市の配信をします"}, {"type": "subtitle", "time": 15454.389, "timestamp": "04:17:34", "text": "が、明日は復習のためだけに、"}, {"type": "subtitle", "time": 15456.389, "timestamp": "04:17:36", "text": "明日の夜に"}, {"type": "subtitle", "time": 15458.79, "timestamp": "04:17:38", "text": "ゲーム配信をします。"}, {"type": "subtitle", "time": 15460.55, "timestamp": "04:17:40", "text": "いつも配信ばかりだと"}, {"type": "subtitle", "time": 15463.03, "timestamp": "04:17:43", "text": "退屈かもしれないから"}, {"type": "subtitle", "time": 15467.03, "timestamp": "04:17:47", "text": "。わからないけど。でも、"}, {"type": "subtitle", "time": 15469.59, "timestamp": "04:17:49", "text": "ええと、アンケート"}, {"type": "subtitle", "time": 15471.75, "timestamp": "04:17:51", "text": "フィードバックフォーラムのことですが、先ほど"}, {"type": "subtitle", "time": 15474.149, "timestamp": "04:17:54", "text": "申し上げたように、"}, {"type": "subtitle", "time": 15475.67, "timestamp": "04:17:55", "text": "12月に公開します。"}, {"type": "subtitle", "time": 15478.309, "timestamp": "04:17:58", "text": "なので、Googleフォーラムにフィードバックをお寄せください"}]
[{"type": "subtitle", "time": 6300.07, "timestamp": "01:45:00", "text": "[音楽] 3人の少女、放物線、日食、"}, {"type": "subtitle", "time": 6302.95, "timestamp": "01:45:02", "text": "ハイパーローラが含まれます。 何？ ああ、なんてことだ。 全く理解できない"}, {"type": "subtitle", "time": 6313.91, "timestamp": "01:45:13", "text": "つまり、それらは最終的に3つの"}, {"type": "subtitle", "time": 6321.75, "timestamp": "01:45:21", "text": "クレイジーな男だ。"}, {"type": "subtitle", "time": 6344.39, "timestamp": "01:45:44", "text": "私はフーだと思った"}]
[{"type": "subtitle", "time": 15481.51, "timestamp": "04:18:01", "text": "。他に何かありますか"}, {"type": "subtitle", "time": 15490.229, "timestamp": "04:18:10", "text": "。皆さん、おやすみなさい。"}, {"type": "subtitle", "time": 15506.87, "timestamp": "04:18:26", "text": "今日来てくださった皆さん、ありがとうございました。本当に本当に感謝しています"}, {"type": "subtitle", "time": 15510.07, "timestamp": "04:18:30", "text": "。"}, {"type": "subtitle", "time": 15514.07, "timestamp": "04:18:34", "text": "また明日お会いしましょう。"}, {"type": "subtitle", "time": 15515.349, "timestamp": "04:18:35", "text": "明日は10時頃に[音楽]をストリーミング配信します。"}, {"type": "subtitle", "time": 15521.91, "timestamp": "04:18:41", "text": "ええ、午前10時かそのくらいの"}, {"type": "subtitle", "time": 15525.51, "timestamp": "04:18:45", "text": "時間です。私の時間は[音楽]なので、"}, {"type": "subtitle", "time": 15529.91, "timestamp": "04:18:49", "text": "こんにちは。また明日。[音楽]"}, {"type": "subtitle", "time": 15531.349, "timestamp": "04:18:51", "text": "もしストリーミング配信しない場合は、"}, {"type": "subtitle", "time": 15534.95, "timestamp": "04:18:54", "text": "DiscordとTwitterでお知らせします。わかりました。"}]
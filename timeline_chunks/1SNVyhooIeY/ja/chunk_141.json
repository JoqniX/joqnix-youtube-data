[{"type": "subtitle", "time": 8461.429, "timestamp": "02:21:01", "text": "私たちは毎日VCにいて、彼女は"}, {"type": "subtitle", "time": 8463.429, "timestamp": "02:21:03", "text": "私が4行とか8"}, {"type": "subtitle", "time": 8467.03, "timestamp": "02:21:07", "text": "行とかバスとかを歌うのをいつも聞いていました。"}, {"type": "subtitle", "time": 8469.892, "timestamp": "02:21:09", "text": "練習、練習、練習あるのみ。"}, {"type": "subtitle", "time": 8470.71, "timestamp": "02:21:10", "text": "[笑い]"}, {"type": "subtitle", "time": 8472.95, "timestamp": "02:21:12", "text": "この学習方法は本当に良かったです。"}, {"type": "subtitle", "time": 8478.63, "timestamp": "02:21:18", "text": "歌詞を見なくても、何を"}, {"type": "subtitle", "time": 8480.95, "timestamp": "02:21:20", "text": "歌えばいいのかが分かるようになったので、好きになれました。 たとえシャワーを浴びている時でも、"}, {"type": "subtitle", "time": 8485.03, "timestamp": "02:21:25", "text": "その歌のことを考えて"}, {"type": "subtitle", "time": 8487.83, "timestamp": "02:21:27", "text": "歌おうとすると、もう"}, {"type": "subtitle", "time": 8491.03, "timestamp": "02:21:31", "text": "歌詞を暗記しているんです。 うん。 一方、"}, {"type": "subtitle", "time": 8493.429, "timestamp": "02:21:33", "text": "他の曲、"}, {"type": "subtitle", "time": 8495.19, "timestamp": "02:21:35", "text": "特にサナラ・ミッドナイトなどの曲については、"}, {"type": "subtitle", "time": 8497.429, "timestamp": "02:21:37", "text": "歌詞を見なければならない。"}, {"type": "subtitle", "time": 8499.91, "timestamp": "02:21:39", "text": "ガイドトラックと"}, {"type": "subtitle", "time": 8502.63, "timestamp": "02:21:42", "text": "原曲をヘッドホンで聴かなければならない。 私は"}, {"type": "subtitle", "time": 8506.15, "timestamp": "02:21:46", "text": "それを聴かなければ気が済まないし、一緒に歌おうとする。 それが"}, {"type": "subtitle", "time": 8511.429, "timestamp": "02:21:51", "text": "歌を学ぶ正しい方法なのかどうかは分かりません。 いいえ、なぜなら、"}, {"type": "subtitle", "time": 8513.349, "timestamp": "02:21:53", "text": "原曲を聴いたり、"}, {"type": "subtitle", "time": 8516.389, "timestamp": "02:21:56", "text": "参考音源やガイドトラックがあったりすると、"}, {"type": "subtitle", "time": 8519.673, "timestamp": "02:21:59", "text": "彼らの歌い方を真似しようとする傾向があるからです。"}]
[{"type": "subtitle", "time": 8341.03, "timestamp": "02:19:01", "text": "これも本当にいい曲だと言えますか。"}, {"type": "subtitle", "time": 8343.03, "timestamp": "02:19:03", "text": "ナイロンの曲は本当にいい曲ですが、"}, {"type": "subtitle", "time": 8345.91, "timestamp": "02:19:05", "text": "彼女がどうやってあのボーカル"}, {"type": "subtitle", "time": 8347.83, "timestamp": "02:19:07", "text": "エフェクトとか全部やってるのかわかりません。"}, {"type": "subtitle", "time": 8350.389, "timestamp": "02:19:10", "text": "声帯をコントロールしてビブラートとかあれこれやって、"}, {"type": "subtitle", "time": 8352.79, "timestamp": "02:19:12", "text": "アドーレレベルのことをするなんて、私にはできません。私は"}, {"type": "subtitle", "time": 8355.429, "timestamp": "02:19:15", "text": "歌い始めたばかりで、"}, {"type": "subtitle", "time": 8357.429, "timestamp": "02:19:17", "text": "歌が下手なんです。"}, {"type": "subtitle", "time": 8368.15, "timestamp": "02:19:28", "text": "だから、私はリムーバーファイルが好きで、"}, {"type": "subtitle", "time": 8372.469, "timestamp": "02:19:32", "text": "このソー・ストーリーも好きです。"}, {"type": "subtitle", "time": 8375.429, "timestamp": "02:19:35", "text": "偽物として、この3つはできます。"}, {"type": "subtitle", "time": 8378.469, "timestamp": "02:19:38", "text": "これら３つは既にカバーされていますが、私は発音では"}, {"type": "subtitle", "time": 8385.349, "timestamp": "02:19:45", "text": "なく練習する必要があります。 ええ、"}, {"type": "subtitle", "time": 8391.75, "timestamp": "02:19:51", "text": "私の拳のチューニングは、どこかに私の拳があります。それは他のところにあります。"}]
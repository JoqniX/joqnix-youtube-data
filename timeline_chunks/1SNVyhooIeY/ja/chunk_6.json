[{"type": "subtitle", "time": 364.55, "timestamp": "00:06:04", "text": "最近予定していたゲーム配信のほとんどをリスケジュールしたり、キャンセルしたりしました。   皆さんも"}, {"type": "subtitle", "time": 367.67, "timestamp": "00:06:07", "text": "お気づきかもしれませんが、今日は"}, {"type": "subtitle", "time": 374.23, "timestamp": "00:06:14", "text": "午前9時30分にサミーのことをする予定だったのですが、[音楽]"}, {"type": "subtitle", "time": 377.274, "timestamp": "00:06:17", "text": "ストリームは行いませんでした。 うん。 それから"}, {"type": "subtitle", "time": 379.27, "timestamp": "00:06:19", "text": "（咳払い）最後に配信が"}, {"type": "subtitle", "time": 387.189, "timestamp": "00:06:27", "text": "それと、ブループロトコルのストリームはまだ"}, {"type": "subtitle", "time": 389.35, "timestamp": "00:06:29", "text": "稼働していると思います。 多分、削除すると思います"}, {"type": "subtitle", "time": 392.55, "timestamp": "00:06:32", "text": "。 やるかどうかは分かりません"}, {"type": "subtitle", "time": 395.43, "timestamp": "00:06:35", "text": "。 まあ、そういう側面もあるよね。 それから、"}, {"type": "subtitle", "time": 403.67, "timestamp": "00:06:43", "text": "今日か今夜に配信される予定だったVHの配信も、"}, {"type": "subtitle", "time": 406.39, "timestamp": "00:06:46", "text": "実際には"}, {"type": "subtitle", "time": 409.35, "timestamp": "00:06:49", "text": "先週配信される予定だったのですが、それが"}, {"type": "subtitle", "time": 411.43, "timestamp": "00:06:51", "text": "今週に延期されました。 そして今週も"}, {"type": "subtitle", "time": 415.189, "timestamp": "00:06:55", "text": "また、予定を変更することになりました。  [咳払い] ええ"}, {"type": "subtitle", "time": 419.11, "timestamp": "00:06:59", "text": "、正直に言うと、"}]
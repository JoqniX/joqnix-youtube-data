[{"type": "subtitle", "time": 14282.15, "timestamp": "03:58:02", "text": "本当にああ、なんてこった。あれは何"}, {"type": "subtitle", "time": 14287.51, "timestamp": "03:58:07", "text": "まあ、これはすごくクールだ。こんなに"}, {"type": "subtitle", "time": 14297.83, "timestamp": "03:58:17", "text": "あ、50倍くらいズームインしてる。待って、"}, {"type": "subtitle", "time": 14301.67, "timestamp": "03:58:21", "text": "こんなにズームインできるの？"}, {"type": "subtitle", "time": 14303.75, "timestamp": "03:58:23", "text": "何？"}, {"type": "subtitle", "time": 14306.389, "timestamp": "03:58:26", "text": "クレイジー。ズーム制限があると思ってた"}, {"type": "subtitle", "time": 14317.429, "timestamp": "03:58:37", "text": "、"}, {"type": "subtitle", "time": 14321.11, "timestamp": "03:58:41", "text": "最大制限は1000倍くらいだったと思う。でも、もっと"}, {"type": "subtitle", "time": 14328.95, "timestamp": "03:58:48", "text": "万の"}, {"type": "subtitle", "time": 14331.67, "timestamp": "03:58:51", "text": "数字が"}, {"type": "subtitle", "time": 14334.71, "timestamp": "03:58:54", "text": "今、白くなってる。あ、今は"}]
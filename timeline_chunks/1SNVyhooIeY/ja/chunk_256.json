[{"type": "subtitle", "time": 15365.67, "timestamp": "04:16:05", "text": "。"}, {"type": "subtitle", "time": 15368.431, "timestamp": "04:16:08", "text": "うん、気が散る前に。"}, {"type": "subtitle", "time": 15369.03, "timestamp": "04:16:09", "text": "[笑いとため息]"}, {"type": "subtitle", "time": 15372.87, "timestamp": "04:16:12", "text": "わあ。気が散る前に。"}, {"type": "subtitle", "time": 15375.11, "timestamp": "04:16:15", "text": "ええと"}, {"type": "subtitle", "time": 15380.229, "timestamp": "04:16:20", "text": "、ここで終わりにします。"}, {"type": "subtitle", "time": 15384.389, "timestamp": "04:16:24", "text": "それで、ここで終わりにして、"}, {"type": "subtitle", "time": 15394.95, "timestamp": "04:16:34", "text": "寝る前に練習します。こんにちは。"}, {"type": "subtitle", "time": 15397.252, "timestamp": "04:16:37", "text": "あ、デイリーを集めさせてください。"}, {"type": "subtitle", "time": 15397.83, "timestamp": "04:16:37", "text": "[笑い]"}, {"type": "subtitle", "time": 15399.269, "timestamp": "04:16:39", "text": "配信外でやります。ええ、"}, {"type": "subtitle", "time": 15402.389, "timestamp": "04:16:42", "text": "配信外でやります。今はやらないでください。あ、"}, {"type": "subtitle", "time": 15405.112, "timestamp": "04:16:45", "text": "今はやらないでください。こんにちは。"}, {"type": "subtitle", "time": 15409.91, "timestamp": "04:16:49", "text": "[息を呑む] こんにちは。"}, {"type": "subtitle", "time": 15414.149, "timestamp": "04:16:54", "text": "明日やります。こんにちは、アナ。"}, {"type": "subtitle", "time": 15417.11, "timestamp": "04:16:57", "text": "今日は来てくれてありがとう。"}, {"type": "subtitle", "time": 15419.51, "timestamp": "04:16:59", "text": "寝なさい。"}]
[{"type": "subtitle", "time": 13086.71, "timestamp": "03:38:06", "text": "これをコピーして"}, {"type": "subtitle", "time": 13102.63, "timestamp": "03:38:22", "text": "犯罪だ。"}, {"type": "subtitle", "time": 13108.95, "timestamp": "03:38:28", "text": "6か月後に"}, {"type": "subtitle", "time": 13110.55, "timestamp": "03:38:30", "text": "ドイツの姉妹市民として日本に必要とせずに歌えるようになるだろう"}, {"type": "subtitle", "time": 13113.349, "timestamp": "03:38:33", "text": "。え、"}, {"type": "subtitle", "time": 13115.91, "timestamp": "03:38:35", "text": "本当？"}]
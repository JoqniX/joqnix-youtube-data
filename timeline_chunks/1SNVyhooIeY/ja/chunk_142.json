[{"type": "subtitle", "time": 8521.59, "timestamp": "02:22:01", "text": "[笑い]"}, {"type": "subtitle", "time": 8527.03, "timestamp": "02:22:07", "text": "だから、"}, {"type": "subtitle", "time": 8529.27, "timestamp": "02:22:09", "text": "私たちは毎週月曜日から金曜日まで歌を歌います。 もし"}, {"type": "subtitle", "time": 8530.87, "timestamp": "02:22:10", "text": "あなたが近くにいて、"}, {"type": "subtitle", "time": 8532.87, "timestamp": "02:22:12", "text": "私に歌を歌ってもらうために曲を録音したいと思ったら、ぜひご連絡ください。 よし、行こう"}, {"type": "subtitle", "time": 8537.11, "timestamp": "02:22:17", "text": "。 必ず立ち寄ります。"}, {"type": "subtitle", "time": 8538.87, "timestamp": "02:22:18", "text": "さあ、行って。"}, {"type": "subtitle", "time": 8544.15, "timestamp": "02:22:24", "text": "歌の配信はどのように行っていますか？ ああ、あなたは"}, {"type": "subtitle", "time": 8546.63, "timestamp": "02:22:26", "text": "歌い方が好きですか？ もう半ばを過ぎた。"}, {"type": "subtitle", "time": 8549.19, "timestamp": "02:22:29", "text": "ええ、午前12時"}, {"type": "subtitle", "time": 8552.23, "timestamp": "02:22:32", "text": "26分です。ちょっと"}, {"type": "subtitle", "time": 8553.91, "timestamp": "02:22:33", "text": "待って、歌の"}, {"type": "subtitle", "time": 8557.59, "timestamp": "02:22:37", "text": "配信はどうやってやってるんですか？  OBSにエコーみたいなのを入れて、ただ"}, {"type": "subtitle", "time": 8564.469, "timestamp": "02:22:44", "text": "聞いてるだけ。待って、"}, {"type": "subtitle", "time": 8567.429, "timestamp": "02:22:47", "text": "今すぐストリームにトラックを入れなきゃ。 おお。 そうそう。"}, {"type": "subtitle", "time": 8569.349, "timestamp": "02:22:49", "text": "YouTubeで複数配信しているので、"}, {"type": "subtitle", "time": 8574.15, "timestamp": "02:22:54", "text": "配信中に[笑い声]のトラックを再生することはできません。"}, {"type": "subtitle", "time": 8577.429, "timestamp": "02:22:57", "text": "えっと、JPが7月の次に来るのは"}]
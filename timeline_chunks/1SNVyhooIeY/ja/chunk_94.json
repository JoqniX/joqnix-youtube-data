[{"type": "subtitle", "time": 5646.229, "timestamp": "01:34:06", "text": "[音楽]"}, {"type": "subtitle", "time": 5656.31, "timestamp": "01:34:16", "text": "。 気になっていました。 靴仲間の皆さん、"}, {"type": "subtitle", "time": 5659.03, "timestamp": "01:34:19", "text": "私のチャンネルをもう一度見つけて、どうやって私を見つけたのですか"}, {"type": "subtitle", "time": 5661.99, "timestamp": "01:34:21", "text": "？ 忘れた。"}, {"type": "chat", "time": 5662.372, "timestamp": "01:34:22", "author": "@FEROCIOUS_Grrr", "avatar": "https://yt4.ggpht.com/b2fcSyaRaGAEUJaW8yBs5ibxfiDi-brp1G8cHHTYAXKaRusaeuWU68kOjIUNWz1gmVNNSGP5MQ=s64-c-k-c0x00ffffff-no-rj", "message": "how are reading comments btw"}, {"type": "subtitle", "time": 5664.47, "timestamp": "01:34:24", "text": "あなたはここにずいぶん長い間いますね。"}, {"type": "subtitle", "time": 5667.75, "timestamp": "01:34:27", "text": "長い間？ わかりません。"}, {"type": "subtitle", "time": 5671.51, "timestamp": "01:34:31", "text": "あなたはここに2ヶ月くらいいると思います。 ところで、"}, {"type": "subtitle", "time": 5673.75, "timestamp": "01:34:33", "text": "コメントは読んでいますか？ わかった。"}, {"type": "subtitle", "time": 5677.669, "timestamp": "01:34:37", "text": "えっと、左側のモニターから、ここから"}, {"type": "subtitle", "time": 5681.27, "timestamp": "01:34:41", "text": "溶けたものを読み取って、それから明らかな溶けではないものを読みました。"}, {"type": "subtitle", "time": 5685.27, "timestamp": "01:34:45", "text": "それから、右のモニター、えっと、こうやって"}, {"type": "subtitle", "time": 5688.55, "timestamp": "01:34:48", "text": "表示すればいいんです。"}, {"type": "subtitle", "time": 5693.669, "timestamp": "01:34:53", "text": "右側のモニターはこちらです。 私はこのように読みます。"}, {"type": "subtitle", "time": 5697.27, "timestamp": "01:34:57", "text": "私はこのように読みます。 あ、待って。 それは、私が"}, {"type": "subtitle", "time": 5699.99, "timestamp": "01:34:59", "text": "読んだ時の解釈です。 こちらのチャットと、"}]
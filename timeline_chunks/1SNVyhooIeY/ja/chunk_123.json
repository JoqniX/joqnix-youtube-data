[{"type": "subtitle", "time": 7383.43, "timestamp": "02:03:03", "text": "一度も使わずに、「わから"}, {"type": "subtitle", "time": 7386.629, "timestamp": "02:03:06", "text": "ない」とだけ言ったらどうでしょう。 ああ、つまり、私は"}, {"type": "subtitle", "time": 7392.229, "timestamp": "02:03:12", "text": "これを毎日やっているわけではないんです。"}, {"type": "subtitle", "time": 7394.37, "timestamp": "02:03:14", "text": "だから私は毎日これをやることになっていたんです"}]
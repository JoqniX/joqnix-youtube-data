[{"type": "subtitle", "time": 12422.87, "timestamp": "03:27:02", "text": "ああ、あの侍の帽子。 いいえ、"}, {"type": "subtitle", "time": 12427.91, "timestamp": "03:27:07", "text": "帽子をかぶった男です。"}, {"type": "subtitle", "time": 12430.229, "timestamp": "03:27:10", "text": "刀を持った侍。   私には"}, {"type": "subtitle", "time": 12433.75, "timestamp": "03:27:13", "text": "剣を描くことすらできない"}, {"type": "subtitle", "time": 12440.95, "timestamp": "03:27:20", "text": "ああ、もう、わからないよ。わかるでしょ。 まるであの"}]
[{"type": "subtitle", "time": 1443.11, "timestamp": "00:24:03", "text": "物理的なノートを使うべきか、それとも"}, {"type": "subtitle", "time": 1450.47, "timestamp": "00:24:10", "text": "ライブストリームでやっていることや、"}, {"type": "subtitle", "time": 1457.75, "timestamp": "00:24:17", "text": "ここで仮想的に書いているようなことを使うべきか。"}, {"type": "subtitle", "time": 1459.669, "timestamp": "00:24:19", "text": "今すぐ。"}, {"type": "subtitle", "time": 1462.789, "timestamp": "00:24:22", "text": "私のペンが動作しないのはなぜですか？ 待って。   何てことだ"}, {"type": "subtitle", "time": 1465.83, "timestamp": "00:24:25", "text": "。"}, {"type": "subtitle", "time": 1468.31, "timestamp": "00:24:28", "text": "よし、これで動くようになった。  [笑い]"}, {"type": "subtitle", "time": 1487.909, "timestamp": "00:24:47", "text": "。 私はNのほとんどを忘れてしまったし、"}]
[{"type": "subtitle", "time": 10140.63, "timestamp": "02:49:00", "text": "ウィジェット関連のものや、チャットのログを"}, {"type": "subtitle", "time": 10143.429, "timestamp": "02:49:03", "text": "Discordに送ったり、"}, {"type": "subtitle", "time": 10146.71, "timestamp": "02:49:06", "text": "Notionにログを送ったものをDiscordに送ったり、自分のウェブサイトに送ったりするのに使っています"}, {"type": "subtitle", "time": 10149.19, "timestamp": "02:49:09", "text": "。"}, {"type": "subtitle", "time": 10151.51, "timestamp": "02:49:11", "text": "ああ、でもNotionはメモを"}, {"type": "subtitle", "time": 10154.23, "timestamp": "02:49:14", "text": "取ったりするのにいいよね。 うん、"}, {"type": "subtitle", "time": 10157.83, "timestamp": "02:49:17", "text": "オブシディアンはいいよね。マインドマップみたいなやつ"}, {"type": "subtitle", "time": 10160.15, "timestamp": "02:49:20", "text": "。"}, {"type": "subtitle", "time": 10171.59, "timestamp": "02:49:31", "text": "ゼロから始まる日本語の"}, {"type": "subtitle", "time": 10174.55, "timestamp": "02:49:34", "text": "チリットが言っていたことは何でしたか？"}, {"type": "subtitle", "time": 10195.75, "timestamp": "02:49:55", "text": "今日から日本語学習を始めましょう。 彼らの"}, {"type": "subtitle", "time": 10199.59, "timestamp": "02:49:59", "text": "ウェブサイトにはアニメキャラクターが登場する。 非常に"}]
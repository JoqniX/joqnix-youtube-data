[{"type": "subtitle", "time": 9437.83, "timestamp": "02:37:17", "text": "でもあなたはインド人ですよね。 はい、私はインドネシア人です。"}, {"type": "subtitle", "time": 9440.469, "timestamp": "02:37:20", "text": "私はインド出身です。 日本で？ まだ。"}, {"type": "subtitle", "time": 9443.83, "timestamp": "02:37:23", "text": "4月に語学留学で日本に行く予定です"}, {"type": "subtitle", "time": 9449.19, "timestamp": "02:37:29", "text": "。 来年の4月。 しかし4月1日。"}, {"type": "subtitle", "time": 9452.63, "timestamp": "02:37:32", "text": "4月1日には日本にいます。 私は"}, {"type": "subtitle", "time": 9456.23, "timestamp": "02:37:36", "text": "日本にいるでしょう。 だから、4月"}, {"type": "subtitle", "time": 9459.59, "timestamp": "02:37:39", "text": "1日はエイプリルフールだけど、それでも（笑）"}, {"type": "subtitle", "time": 9462.95, "timestamp": "02:37:42", "text": "うん、その頃には日本に到着してるよ。"}, {"type": "subtitle", "time": 9466.63, "timestamp": "02:37:46", "text": "だから最初の週はたぶん"}, {"type": "subtitle", "time": 9469.11, "timestamp": "02:37:49", "text": "入学試験か何か、あるいは"}, {"type": "subtitle", "time": 9474.07, "timestamp": "02:37:54", "text": "入学式とかがあると思う。 ということで、"}, {"type": "subtitle", "time": 9476.309, "timestamp": "02:37:56", "text": "新しいバッチが今から始まりそうです。"}]
[{"type": "subtitle", "time": 421.83, "timestamp": "00:07:01", "text": "すごくストレスが溜まっていると思います"}, {"type": "subtitle", "time": 424.23, "timestamp": "00:07:04", "text": "。  [笑い]"}, {"type": "subtitle", "time": 430.629, "timestamp": "00:07:10", "text": "すごくストレスを感じて、"}, {"type": "subtitle", "time": 433.35, "timestamp": "00:07:13", "text": "緊張していたんだと思います。   ああ、"}, {"type": "subtitle", "time": 439.189, "timestamp": "00:07:19", "text": "プレイしたいゲームがたくさんあるし、追いつきたいこともたくさんあるんだ。"}, {"type": "subtitle", "time": 443.51, "timestamp": "00:07:23", "text": "私は、"}, {"type": "subtitle", "time": 446.87, "timestamp": "00:07:26", "text": "これらの"}, {"type": "subtitle", "time": 450.07, "timestamp": "00:07:30", "text": "ゲームから少し距離を置こうとしていたのだと思います。 確かに、私はこういうことに"}, {"type": "subtitle", "time": 453.029, "timestamp": "00:07:33", "text": "何時間も費やしたり、"}, {"type": "subtitle", "time": 455.27, "timestamp": "00:07:35", "text": "楽しんだり、没頭したりするのが好きだ"}, {"type": "subtitle", "time": 458.07, "timestamp": "00:07:38", "text": "けど、一方で"}, {"type": "subtitle", "time": 460.629, "timestamp": "00:07:40", "text": "、優先順位も大事だよね、って思う部分もあるんだよね。"}, {"type": "subtitle", "time": 463.99, "timestamp": "00:07:43", "text": "優先順位をきちんと整理しないといけない。 えーと、"}, {"type": "subtitle", "time": 467.43, "timestamp": "00:07:47", "text": "来月と1月は"}, {"type": "subtitle", "time": 469.189, "timestamp": "00:07:49", "text": "私にとって試験期間みたいなものなんです。"}, {"type": "subtitle", "time": 475.909, "timestamp": "00:07:55", "text": "12月7日にJPTを受験しなくても"}]
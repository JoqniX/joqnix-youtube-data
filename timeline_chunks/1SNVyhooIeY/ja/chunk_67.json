[{"type": "subtitle", "time": 4027.109, "timestamp": "01:07:07", "text": "待ち時間には画面を見ながら勉強してみてください。"}, {"type": "subtitle", "time": 4029.19, "timestamp": "01:07:09", "text": "すでに画面を見る時間が長いはずなので、画面を見ながら勉強する時間を減らすように心がけてください"}, {"type": "subtitle", "time": 4033.43, "timestamp": "01:07:13", "text": "。 うん。"}, {"type": "subtitle", "time": 4038.39, "timestamp": "01:07:18", "text": "つまり、電話で、"}, {"type": "subtitle", "time": 4040.63, "timestamp": "01:07:20", "text": "ストリーミングしているから、"}, {"type": "subtitle", "time": 4044.23, "timestamp": "01:07:24", "text": "デジタルキャンバス上で、"}, {"type": "subtitle", "time": 4047.589, "timestamp": "01:07:27", "text": "愛用のメモ帳で書いているこのことを何のためにやっているのかということです。"}, {"type": "subtitle", "time": 4050.71, "timestamp": "01:07:30", "text": "今は"}, {"type": "subtitle", "time": 4052.87, "timestamp": "01:07:32", "text": "実際に、"}, {"type": "subtitle", "time": 4056.15, "timestamp": "01:07:36", "text": "物理的にノートに書いて、"}, {"type": "subtitle", "time": 4060.23, "timestamp": "01:07:40", "text": "どうなるか見てみようと思っています。なぜなら、ファイルレベルでは、"}, {"type": "subtitle", "time": 4063.349, "timestamp": "01:07:43", "text": "昨年ノートに書いたからです"}, {"type": "subtitle", "time": 4065.75, "timestamp": "01:07:45", "text": "。 ひたすら書き続けた"}, {"type": "subtitle", "time": 4068.309, "timestamp": "01:07:48", "text": "。 でも、去年NFIの配信もやったことがあるし、それに似たようなこともしたよ"}]
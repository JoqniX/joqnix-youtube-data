[{"type": "subtitle", "time": 2102.87, "timestamp": "00:35:02", "text": "覚えてるかって？  「man」ってどうやって書くんだっけ"}, {"type": "subtitle", "time": 2107.99, "timestamp": "00:35:07", "text": "[笑い]"}, {"type": "subtitle", "time": 2121.43, "timestamp": "00:35:21", "text": "。 みんな"}, {"type": "subtitle", "time": 2127.589, "timestamp": "00:35:27", "text": "仲間、仲間、仲間、仲間。 忘れていました。   このように"}, {"type": "subtitle", "time": 2129.829, "timestamp": "00:35:29", "text": "正しい砂を送ってください。   わかった"}, {"type": "subtitle", "time": 2134.87, "timestamp": "00:35:34", "text": "。 ああ、なんてこった。"}, {"type": "subtitle", "time": 2137.589, "timestamp": "00:35:37", "text": "私の脳に何が起こったの？"}, {"type": "subtitle", "time": 2142.87, "timestamp": "00:35:42", "text": "いや。 私の脳に何が起こったの？"}, {"type": "subtitle", "time": 2145.349, "timestamp": "00:35:45", "text": "もし私がこれをここに持っていたら、それは"}, {"type": "subtitle", "time": 2146.95, "timestamp": "00:35:46", "text": "別のものだった、それが何だったか"}, {"type": "subtitle", "time": 2150.39, "timestamp": "00:35:50", "text": "忘れてしまった。"}, {"type": "subtitle", "time": 2156.63, "timestamp": "00:35:56", "text": "[咳払い]"}]
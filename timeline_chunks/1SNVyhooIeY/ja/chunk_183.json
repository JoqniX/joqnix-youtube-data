[{"type": "subtitle", "time": 10983.99, "timestamp": "03:03:03", "text": "、たぶん"}, {"type": "subtitle", "time": 10986.469, "timestamp": "03:03:06", "text": "大丈夫だろう、大丈夫、"}, {"type": "subtitle", "time": 10989.75, "timestamp": "03:03:09", "text": "前回と同じように朝にエビを食べよう。"}, {"type": "subtitle", "time": 10993.03, "timestamp": "03:03:13", "text": "ただ、あまりにも"}, {"type": "subtitle", "time": 10998.469, "timestamp": "03:03:18", "text": "大変だから諦めてしまわないことを願うばかりです。"}, {"type": "subtitle", "time": 11010.309, "timestamp": "03:03:30", "text": "おお。 見てみましょう。"}, {"type": "subtitle", "time": 11013.429, "timestamp": "03:03:33", "text": "Uh hati"}, {"type": "subtitle", "time": 11015.91, "timestamp": "03:03:35", "text": "hatas。"}, {"type": "subtitle", "time": 11018.23, "timestamp": "03:03:38", "text": "それで、ハタス、"}, {"type": "subtitle", "time": 11025.429, "timestamp": "03:03:45", "text": "ああ、君にとっては8時だね。うん、8時だよ、午後8時。"}, {"type": "subtitle", "time": 11029.03, "timestamp": "03:03:49", "text": "待って。 ああ、"}, {"type": "subtitle", "time": 11037.19, "timestamp": "03:03:57", "text": "。 午後8時です。 あなたのために。"}]
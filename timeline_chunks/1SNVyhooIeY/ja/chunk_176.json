[{"type": "subtitle", "time": 10562.389, "timestamp": "02:56:02", "text": "スペイン語ですね。 わかった、気にしないで。 えっと、ラベルを追加してください"}, {"type": "subtitle", "time": 10566.389, "timestamp": "02:56:06", "text": "。 歌詞。"}, {"type": "subtitle", "time": 10569.11, "timestamp": "02:56:09", "text": "学ぶ。"}, {"type": "subtitle", "time": 10570.87, "timestamp": "02:56:10", "text": "アニメを見ると学習が速くなりますか？"}, {"type": "subtitle", "time": 10574.55, "timestamp": "02:56:14", "text": "効果はありますか？ つまり、えーと、"}, {"type": "subtitle", "time": 10578.309, "timestamp": "02:56:18", "text": "中国語を学びたいと思って、えーと、つまり、アニメとかを"}, {"type": "subtitle", "time": 10592.71, "timestamp": "02:56:32", "text": "知ってからずっとアニメソウルを見てきたので、リスニングの理解力は脳内でしっかり身についていると思うんです"}, {"type": "subtitle", "time": 10596.87, "timestamp": "02:56:36", "text": "。 そして、そうすることで徐々に"}, {"type": "subtitle", "time": 10598.79, "timestamp": "02:56:38", "text": "リスニング力が養われ、"}, {"type": "subtitle", "time": 10601.429, "timestamp": "02:56:41", "text": "相手の言っていること"}, {"type": "subtitle", "time": 10603.91, "timestamp": "02:56:43", "text": "やその他すべてを理解できるようになるのだと思います。 そう、"}, {"type": "subtitle", "time": 10613.19, "timestamp": "02:56:53", "text": "ええ、日本のメディアは役に立ちます。"}, {"type": "subtitle", "time": 10615.83, "timestamp": "02:56:55", "text": "日本語をN5"}, {"type": "subtitle", "time": 10619.19, "timestamp": "02:56:59", "text": "レベルやN4レベル以上で学び始めたら、"}]
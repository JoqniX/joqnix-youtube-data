[{"type": "subtitle", "time": 13984.229, "timestamp": "03:53:04", "text": "国際関係、"}, {"type": "subtitle", "time": 13985.99, "timestamp": "03:53:05", "text": "ブラジルとの関係に興味があるかどうかわからないけど、もし興味があるなら、地図の線を見ることをお勧めするよ。"}, {"type": "subtitle", "time": 13993.91, "timestamp": "03:53:13", "text": "ウィリアムパネルの地図の線チャンネルを見る。"}, {"type": "subtitle", "time": 13999.83, "timestamp": "03:53:19", "text": "私は知らない。[笑い]"}, {"type": "subtitle", "time": 14003.83, "timestamp": "03:53:23", "text": "政治については何も知らないし、"}, {"type": "subtitle", "time": 14006.79, "timestamp": "03:53:26", "text": "ええ、人文科学の学生として、歴史については"}, {"type": "subtitle", "time": 14010.389, "timestamp": "03:53:30", "text": "少し知っているけど、"}, {"type": "subtitle", "time": 14017.59, "timestamp": "03:53:37", "text": "大変だよ。"}, {"type": "subtitle", "time": 14020.87, "timestamp": "03:53:40", "text": "全部忘れちゃった。"}, {"type": "subtitle", "time": 14023.429, "timestamp": "03:53:43", "text": "でも、歴史とかそういうことを知っておくのはいいことだよね"}, {"type": "subtitle", "time": 14032.63, "timestamp": "03:53:52", "text": "ゲーム理論の人のことを知っておくのはいいことだよ"}, {"type": "subtitle", "time": 14035.491, "timestamp": "03:53:55", "text": "。あのチャンネルの人知ってるよ。"}, {"type": "subtitle", "time": 14039.349, "timestamp": "03:53:59", "text": "[音楽] えーと、映画「フライデー・ナイト・フレディ」に出てたよね"}]
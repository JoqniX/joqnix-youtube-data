[{"type": "subtitle", "time": 2649.75, "timestamp": "00:44:09", "text": "。 どうやって続けるか忘れてしまった。 何てことだ"}, {"type": "subtitle", "time": 2657.91, "timestamp": "00:44:17", "text": "。 忘れていました。本当に忘れていました。"}, {"type": "subtitle", "time": 2661.91, "timestamp": "00:44:21", "text": "えっと、それを練習しないといけないですね。"}, {"type": "subtitle", "time": 2678.71, "timestamp": "00:44:38", "text": "漢字試験に出題された赤井さんの問題です"}]
[{"type": "subtitle", "time": 10321.59, "timestamp": "02:52:01", "text": "私のセットアップの一部もそこにあります。 ああ、"}, {"type": "subtitle", "time": 10335.269, "timestamp": "02:52:15", "text": "なぜ私はそんなことをしているのだろう？ 削除すればいいだけです"}, {"type": "subtitle", "time": 10345.51, "timestamp": "02:52:25", "text": "私は何をしているのだろう？"}, {"type": "subtitle", "time": 10353.59, "timestamp": "02:52:33", "text": "あなたはドイツ出身ですね。 おお。"}, {"type": "subtitle", "time": 10362.87, "timestamp": "02:52:42", "text": "彼らはドイツ語とドイツ語と言う。"}, {"type": "subtitle", "time": 10365.349, "timestamp": "02:52:45", "text": "うん。 ドイツ語と日本語ですよね"}]
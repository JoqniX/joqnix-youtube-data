[{"type": "subtitle", "time": 5400.95, "timestamp": "01:30:00", "text": "英語でいくらですか？何言語ですか？」って聞くんです。"}, {"type": "subtitle", "time": 5403.75, "timestamp": "01:30:03", "text": "ヒンディー語、"}, {"type": "subtitle", "time": 5408.229, "timestamp": "01:30:08", "text": "英語、日本語の勉強も少しやってみました。"}, {"type": "subtitle", "time": 5413.03, "timestamp": "01:30:13", "text": "中国語も"}, {"type": "subtitle", "time": 5415.43, "timestamp": "01:30:15", "text": "少しやってみましたが、うまくいきませんでした。"}, {"type": "subtitle", "time": 5421.03, "timestamp": "01:30:21", "text": "日本語に全力を注いでから"}, {"type": "subtitle", "time": 5423.11, "timestamp": "01:30:23", "text": "中国語に取り掛かろうと思ったんです。ずっと前に"}, {"type": "subtitle", "time": 5429.189, "timestamp": "01:30:29", "text": "Believerでストリーミング配信をしていたんです。"}, {"type": "subtitle", "time": 5431.99, "timestamp": "01:30:31", "text": "そう、去年のことです。だから、"}, {"type": "subtitle", "time": 5434.55, "timestamp": "01:30:34", "text": "中国語を学んで"}, {"type": "subtitle", "time": 5442.07, "timestamp": "01:30:42", "text": "でも、誰も英語を話せなかったんです。"}, {"type": "subtitle", "time": 5446.87, "timestamp": "01:30:46", "text": "英語がわかる人や英語を専攻した人など、"}, {"type": "subtitle", "time": 5449.11, "timestamp": "01:30:49", "text": "音楽関係の人はほとんどおらず、そういう人たちが"}, {"type": "subtitle", "time": 5451.99, "timestamp": "01:30:51", "text": "来て英語で話しかけてくれたり、"}, {"type": "subtitle", "time": 5456.07, "timestamp": "01:30:56", "text": "音楽が全く理解できない人もいて、"}, {"type": "subtitle", "time": 5458.229, "timestamp": "01:30:58", "text": "画面に表示した翻訳ツールが"}]
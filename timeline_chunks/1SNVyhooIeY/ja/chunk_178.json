[{"type": "subtitle", "time": 10682.508, "timestamp": "02:58:02", "text": "グループのどれですか？"}, {"type": "subtitle", "time": 10683.269, "timestamp": "02:58:03", "text": "[笑い]"}, {"type": "subtitle", "time": 10699.11, "timestamp": "02:58:19", "text": "接続詞はロシア語や"}, {"type": "subtitle", "time": 10703.03, "timestamp": "02:58:23", "text": "スペイン語のように扱われます。 うん。 そうそう。 接続詞も。"}, {"type": "subtitle", "time": 10736.23, "timestamp": "02:58:56", "text": "二言語を話せることは役に立つ。 つまり、"}, {"type": "subtitle", "time": 10738.95, "timestamp": "02:58:58", "text": "少しの間は良いけれど、それほど"}]
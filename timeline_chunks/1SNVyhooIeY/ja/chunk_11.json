[{"type": "subtitle", "time": 663.03, "timestamp": "00:11:03", "text": "えーっと、[咳払い] これから"}, {"type": "subtitle", "time": 666.55, "timestamp": "00:11:06", "text": "ゲーム"}, {"type": "subtitle", "time": 669.19, "timestamp": "00:11:09", "text": "配信を少し減らした方がいいような気がします。"}, {"type": "subtitle", "time": 674.63, "timestamp": "00:11:14", "text": "持続する。 私は、ほとんどの人が"}, {"type": "subtitle", "time": 681.11, "timestamp": "00:11:21", "text": "コンテンツではなく私自身を見てくれると確信しています。 えーと、でも、"}, {"type": "subtitle", "time": 686.47, "timestamp": "00:11:26", "text": "ゲーム配信とかを見たい人もいると思うし、"}, {"type": "subtitle", "time": 693.59, "timestamp": "00:11:33", "text": "来月とかにできるかどうかはわからないけど、1"}, {"type": "subtitle", "time": 697.11, "timestamp": "00:11:37", "text": "月以降、1月中旬以降ならできると思う。"}, {"type": "subtitle", "time": 701.829, "timestamp": "00:11:41", "text": "15日以降かな。"}, {"type": "subtitle", "time": 705.829, "timestamp": "00:11:45", "text": "待って、14日は全国試験だよね。だから、"}, {"type": "subtitle", "time": 708.23, "timestamp": "00:11:48", "text": "あちこちで"}, {"type": "subtitle", "time": 710.15, "timestamp": "00:11:50", "text": "最大1時間の配信をすると思う。"}, {"type": "subtitle", "time": 711.829, "timestamp": "00:11:51", "text": "本当に短い"}, {"type": "subtitle", "time": 713.35, "timestamp": "00:11:53", "text": "配信になるよ。   いつもの"}, {"type": "subtitle", "time": 716.568, "timestamp": "00:11:56", "text": "9時間とか10時間"}, {"type": "subtitle", "time": 717.11, "timestamp": "00:11:57", "text": "（笑）の"}]
[{"type": "subtitle", "time": 10808.15, "timestamp": "03:00:08", "text": "それで、これは彼女だと思います、そして、"}, {"type": "subtitle", "time": 10815.75, "timestamp": "03:00:15", "text": "時々、特に"}, {"type": "subtitle", "time": 10818.71, "timestamp": "03:00:18", "text": "端の線[音楽]に苦労します"}, {"type": "subtitle", "time": 10820.95, "timestamp": "03:00:20", "text": "。端の線も。"}, {"type": "subtitle", "time": 10822.95, "timestamp": "03:00:22", "text": "えっと、"}, {"type": "subtitle", "time": 10827.429, "timestamp": "03:00:27", "text": "穴、右の穴、線。"}, {"type": "subtitle", "time": 10829.67, "timestamp": "03:00:29", "text": "えっと、"}, {"type": "subtitle", "time": 10833.51, "timestamp": "03:00:33", "text": "こんな感じだったんですか？ 忘れた。 ええ、"}, {"type": "subtitle", "time": 10838.23, "timestamp": "03:00:38", "text": "筆順が間違っていました。 どうやって？ え、何？"}, {"type": "subtitle", "time": 10853.429, "timestamp": "03:00:53", "text": "。 ああ。 そうそう。"}, {"type": "subtitle", "time": 10854.15, "timestamp": "03:00:54", "text": "そうそう。  [笑い]"}, {"type": "subtitle", "time": 10857.19, "timestamp": "03:00:57", "text": "ああ、そうだね。 忘れた。  [息を呑む]"}]
[{"type": "subtitle", "time": 7983.35, "timestamp": "02:13:03", "text": "こんにちは、"}, {"type": "subtitle", "time": 7988.39, "timestamp": "02:13:08", "text": "キタス。 はい、"}, {"type": "subtitle", "time": 7993.35, "timestamp": "02:13:13", "text": "1月までにN4試験を受ける予定です。"}, {"type": "subtitle", "time": 7998.31, "timestamp": "02:13:18", "text": "12月7日のJPTは受けません。  JPTは欠席します"}, {"type": "subtitle", "time": 8001.91, "timestamp": "02:13:21", "text": "。 私はNATを目指します。  [音楽] NATの方が"}, {"type": "subtitle", "time": 8005.35, "timestamp": "02:13:25", "text": "便利です。 まるで"}, {"type": "subtitle", "time": 8007.669, "timestamp": "02:13:27", "text": "毎月試験があるみたいだ。 彼らは毎月それを実現した。 以前は"}, {"type": "subtitle", "time": 8011.03, "timestamp": "02:13:31", "text": "2ヶ月に1回だった。"}, {"type": "subtitle", "time": 8016.229, "timestamp": "02:13:36", "text": "うん。  N5レベルのM5を受験して以来。"}, {"type": "subtitle", "time": 8019.109, "timestamp": "02:13:39", "text": "うん。 彼らはそれをQ5と呼んでいる。  Nは、"}, {"type": "subtitle", "time": 8029.43, "timestamp": "02:13:49", "text": "うん。 ええと、今ではほとんどの"}, {"type": "subtitle", "time": 8031.35, "timestamp": "02:13:51", "text": "学校や大学や仕事で"}]
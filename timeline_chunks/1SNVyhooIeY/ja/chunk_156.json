[{"type": "subtitle", "time": 9362.71, "timestamp": "02:36:02", "text": "ツリーみたいなもんじゃない？"}, {"type": "subtitle", "time": 9364.95, "timestamp": "02:36:04", "text": "特に、"}, {"type": "subtitle", "time": 9371.349, "timestamp": "02:36:11", "text": "えーと３つの漢字、角の漢字"}, {"type": "subtitle", "time": 9378.469, "timestamp": "02:36:18", "text": "そして、えーと、"}, {"type": "subtitle", "time": 9382.469, "timestamp": "02:36:22", "text": "茂みの漢字と、そして、"}, {"type": "subtitle", "time": 9388.63, "timestamp": "02:36:28", "text": "そして、森の漢字。 これらすべてが"}, {"type": "subtitle", "time": 9402.07, "timestamp": "02:36:42", "text": "。 うん。 やすみ休憩。 これが"}, {"type": "subtitle", "time": 9408.63, "timestamp": "02:36:48", "text": "スティックマンです。  [笑い声]"}]
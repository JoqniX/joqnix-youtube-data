[{"type": "subtitle", "time": 11365.025, "timestamp": "03:09:25", "text": "金曜日の夜。"}, {"type": "subtitle", "time": 11377.19, "timestamp": "03:09:37", "text": "では、フォーカススタイルについて考えてみましょう。 待って、"}, {"type": "subtitle", "time": 11379.99, "timestamp": "03:09:39", "text": "20個、いや10個全部終わらせて"}, {"type": "subtitle", "time": 11382.469, "timestamp": "03:09:42", "text": "寝なきゃいけないよ。 こんにちは、頭を休ませてください。 私は"}, {"type": "subtitle", "time": 11388.389, "timestamp": "03:09:48", "text": "5時に起きます。 いいえ、私は午前 2 時までに寝ます。午前"}, {"type": "subtitle", "time": 11394.469, "timestamp": "03:09:54", "text": "2 時までに寝ます。"}]
[{"type": "subtitle", "time": 10021.11, "timestamp": "02:47:01", "text": "列軸のようなものを持っているから、角度スナップのような"}, {"type": "subtitle", "time": 10025.429, "timestamp": "02:47:05", "text": "ものを持っているから、私はFPSゲームをプレイしていたからです。 だから、"}, {"type": "subtitle", "time": 10027.91, "timestamp": "02:47:07", "text": "私は"}, {"type": "subtitle", "time": 10030.23, "timestamp": "02:47:10", "text": "ヴァレラントや他のゲームのためにヴァラーを持っています（笑）。 私は"}, {"type": "subtitle", "time": 10033.11, "timestamp": "02:47:13", "text": "足首が折れる音が好きです。 そう、それがなければ本当に"}, {"type": "subtitle", "time": 10036.15, "timestamp": "02:47:16", "text": "大変なことになるだろうね。"}, {"type": "subtitle", "time": 10038.63, "timestamp": "02:47:18", "text": "待って、これはうまくいくと思う。だって、"}, {"type": "subtitle", "time": 10042.55, "timestamp": "02:47:22", "text": "正方形にしているから。 いいえ。ああ、アフィニティを使っていますか"}, {"type": "subtitle", "time": 10046.15, "timestamp": "02:47:26", "text": "？ 親和性。 親和性。"}, {"type": "subtitle", "time": 10048.95, "timestamp": "02:47:28", "text": "私はアフィニティを使用しています。"}, {"type": "subtitle", "time": 10051.59, "timestamp": "02:47:31", "text": "Affinityは無料です。 いいえ。"}, {"type": "subtitle", "time": 10055.11, "timestamp": "02:47:35", "text": "つまり、自由は自由です。"}, {"type": "subtitle", "time": 10063.19, "timestamp": "02:47:43", "text": "ええ、あのホワイト"}, {"type": "subtitle", "time": 10068.111, "timestamp": "02:47:48", "text": "ボードのウェブサイト"}, {"type": "subtitle", "time": 10070.469, "timestamp": "02:47:50", "text": "[音楽]を実際に使おうと思ったんです。"}, {"type": "subtitle", "time": 10072.87, "timestamp": "02:47:52", "text": "えっと、"}, {"type": "subtitle", "time": 10075.75, "timestamp": "02:47:55", "text": "何ていう名前でしたっけ？   あれって"}, {"type": "subtitle", "time": 10078.95, "timestamp": "02:47:58", "text": "何て名前だったっけ？   何てことだ"}]
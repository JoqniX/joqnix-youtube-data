[{"type": "subtitle", "time": 12723.03, "timestamp": "03:32:03", "text": "だから私は「わかった」と思って、"}, {"type": "subtitle", "time": 12725.429, "timestamp": "03:32:05", "text": "画面"}, {"type": "subtitle", "time": 12728.469, "timestamp": "03:32:08", "text": "翻訳や字幕などを使ってみたけど、うまくいかなかった"}, {"type": "subtitle", "time": 12731.03, "timestamp": "03:32:11", "text": "。"}, {"type": "subtitle", "time": 12738.79, "timestamp": "03:32:18", "text": "誰かが何か別のことを言っていたんだけど、私は"}, {"type": "subtitle", "time": 12741.196, "timestamp": "03:32:21", "text": "「ああ、それはまずいな」と思った。"}, {"type": "subtitle", "time": 12756.87, "timestamp": "03:32:36", "text": "私は「ねえ、"}, {"type": "subtitle", "time": 12760.07, "timestamp": "03:32:40", "text": "中国語を勉強して、"}, {"type": "subtitle", "time": 12764.469, "timestamp": "03:32:44", "text": "来た人と話せるようにしよう」と思ったんです。"}, {"type": "subtitle", "time": 12766.79, "timestamp": "03:32:46", "text": "中国から来た人が私の"}, {"type": "subtitle", "time": 12769.59, "timestamp": "03:32:49", "text": "配信に来たら、ビリービリーで彼らと"}, {"type": "subtitle", "time": 12772.15, "timestamp": "03:32:52", "text": "コミュニケーションが取れるようになります。"}, {"type": "subtitle", "time": 12775.91, "timestamp": "03:32:55", "text": "英語がわかる人はごくわずかです。だから、"}, {"type": "subtitle", "time": 12778.389, "timestamp": "03:32:58", "text": "勉強しようと思ったんです。"}]
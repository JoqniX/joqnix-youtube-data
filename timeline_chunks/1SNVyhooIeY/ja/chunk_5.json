[{"type": "subtitle", "time": 301.03, "timestamp": "00:05:01", "text": "でも、昨日でしたよね？"}, {"type": "subtitle", "time": 304.23, "timestamp": "00:05:04", "text": "ええ、昨日でした。だから、昨日は配信しませんでした。それで、まあまあ"}, {"type": "subtitle", "time": 312.79, "timestamp": "00:05:12", "text": "書けたと思います。自信は"}, {"type": "subtitle", "time": 314.87, "timestamp": "00:05:14", "text": "少しありましたが。"}, {"type": "subtitle", "time": 317.59, "timestamp": "00:05:17", "text": "[笑い]"}, {"type": "subtitle", "time": 319.51, "timestamp": "00:05:19", "text": "それで、ええ、"}, {"type": "subtitle", "time": 324.39, "timestamp": "00:05:24", "text": "今日はベストを尽くします"}, {"type": "subtitle", "time": 326.469, "timestamp": "00:05:26", "text": "。"}, {"type": "subtitle", "time": 332.23, "timestamp": "00:05:32", "text": "少なくとも頭に入れられるように、全力を尽くしたいと思っています。"}, {"type": "subtitle", "time": 335.11, "timestamp": "00:05:35", "text": "こんにちは[咳払い]、"}, {"type": "subtitle", "time": 336.95, "timestamp": "00:05:36", "text": "今日、YouTube"}, {"type": "subtitle", "time": 339.43, "timestamp": "00:05:39", "text": "コミュニティの投稿とDiscordサーバー、"}, {"type": "subtitle", "time": 341.99, "timestamp": "00:05:41", "text": "そしてTwitterでも発表しました。YouTube"}, {"type": "subtitle", "time": 344.07, "timestamp": "00:05:44", "text": "コミュニティの投稿と同じ内容です。"}, {"type": "subtitle", "time": 349.029, "timestamp": "00:05:49", "text": "スクリーンショットをTwitterにも告知として投稿しました"}, {"type": "subtitle", "time": 351.99, "timestamp": "00:05:51", "text": "。  [咳]"}, {"type": "subtitle", "time": 355.51, "timestamp": "00:05:55", "text": "ええと、今後は、"}]
[{"type": "subtitle", "time": 4982.35, "timestamp": "01:23:02", "text": "何？"}, {"type": "subtitle", "time": 4986.47, "timestamp": "01:23:06", "text": "本当に？プレイヤーはRキーを押して確認します"}, {"type": "subtitle", "time": 4987.99, "timestamp": "01:23:07", "text": "彼らは息を呑んでいた。プレイヤーが停止したとき"}, {"type": "subtitle", "time": 4989.79, "timestamp": "01:23:09", "text": "息を止めて、彼らは"}, {"type": "subtitle", "time": 4992.229, "timestamp": "01:23:12", "text": "リリース。これは所有者システムに要求します"}, {"type": "subtitle", "time": 4993.87, "timestamp": "01:23:13", "text": "に"}, {"type": "subtitle", "time": 4996.47, "timestamp": "01:23:16", "text": "仕事。プレイヤーはRキーを押す必要があります"}, {"type": "subtitle", "time": 4998.189, "timestamp": "01:23:18", "text": "水に入る前に避けるために"}, {"type": "subtitle", "time": 5001.47, "timestamp": "01:23:21", "text": "旅行。彼らが"}, {"type": "subtitle", "time": 5004.229, "timestamp": "01:23:24", "text": "Rキーを押し続けてください、プレイヤー"}, {"type": "subtitle", "time": 5007.149, "timestamp": "01:23:27", "text": "彼女を失うわけにはいかない。すぐに"}, {"type": "subtitle", "time": 5016.669, "timestamp": "01:23:36", "text": "彼らが何をしたかなんてどうでもいい"}, {"type": "subtitle", "time": 5018.189, "timestamp": "01:23:38", "text": "これ？"}, {"type": "subtitle", "time": 5022.149, "timestamp": "01:23:42", "text": "このオプションは各プレイヤーをリセットできます"}, {"type": "subtitle", "time": 5024.55, "timestamp": "01:23:44", "text": "これは、"}, {"type": "subtitle", "time": 5026.07, "timestamp": "01:23:46", "text": "プレイヤーが不正行為をすることは許されないが、"}, {"type": "subtitle", "time": 5028.47, "timestamp": "01:23:48", "text": "彼らに何でもさせる。彼らは私を持っていたかもしれない"}, {"type": "subtitle", "time": 5030.95, "timestamp": "01:23:50", "text": "すでに自動プログラムでクリックしています"}, {"type": "subtitle", "time": 5034.47, "timestamp": "01:23:54", "text": "ハードキーは既にモードが動作しているため"}, {"type": "subtitle", "time": 5037.47, "timestamp": "01:23:57", "text": "性善説に基づいて。これは大したことではない"}]
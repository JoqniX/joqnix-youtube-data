[{"type": "subtitle", "time": 17642.75, "timestamp": "04:54:02", "text": "できる限りのことは全部やったよ。"}, {"type": "subtitle", "time": 17647.11, "timestamp": "04:54:07", "text": "私には理解できない。"}, {"type": "subtitle", "time": 17649.75, "timestamp": "04:54:09", "text": "それはある意味、私の好きなところだ"}, {"type": "subtitle", "time": 17653.59, "timestamp": "04:54:13", "text": "なぜなら、正直に言うと、"}, {"type": "subtitle", "time": 17657.91, "timestamp": "04:54:17", "text": "JP限定のものですが、今は"}, {"type": "subtitle", "time": 17660.55, "timestamp": "04:54:20", "text": "もし私がそれを夢見たら"}, {"type": "subtitle", "time": 17663.67, "timestamp": "04:54:23", "text": "絶対にやってはいけないし、絶対に怖がってはいけない"}, {"type": "subtitle", "time": 17667.99, "timestamp": "04:54:27", "text": "近づくのは今は悪いし、私は"}, {"type": "subtitle", "time": 17670.23, "timestamp": "04:54:30", "text": "私は自信を持ち、"}, {"type": "subtitle", "time": 17675.43, "timestamp": "04:54:35", "text": "人に尋ねる勇気が必要だった"}, {"type": "subtitle", "time": 17678.39, "timestamp": "04:54:38", "text": "たくさんの時間があるように"}, {"type": "subtitle", "time": 17681.27, "timestamp": "04:54:41", "text": "自信を持って人に聞くのは、これは"}, {"type": "subtitle", "time": 17683.67, "timestamp": "04:54:43", "text": "初めて本格的にコラボレーションを依頼してみました"}, {"type": "subtitle", "time": 17686.15, "timestamp": "04:54:46", "text": "なぜなら、私が招待されたすべての時"}, {"type": "subtitle", "time": 17689.15, "timestamp": "04:54:49", "text": "コラボレーションしたので、人々がやって来ました"}, {"type": "subtitle", "time": 17691.91, "timestamp": "04:54:51", "text": "私、もしくはコラボに引きずり込まれる私"}, {"type": "subtitle", "time": 17694.99, "timestamp": "04:54:54", "text": "でも今回は"}, {"type": "subtitle", "time": 17699.55, "timestamp": "04:54:59", "text": "自信を持つために、私は"}]
[{"type": "subtitle", "time": 11712.309, "timestamp": "03:15:12", "text": "マインクラフト。うん。今度はストリーミング配信したい"}, {"type": "subtitle", "time": 11722.79, "timestamp": "03:15:22", "text": "銅を再び入手するにはどうすればいいですか？"}, {"type": "subtitle", "time": 11725.269, "timestamp": "03:15:25", "text": "なぜ銅が欲しいのですか？それは最も"}, {"type": "subtitle", "time": 11727.429, "timestamp": "03:15:27", "text": "マインクラフトでは役に立たないもの。ああ、あなたは"}, {"type": "subtitle", "time": 11730.87, "timestamp": "03:15:30", "text": "銅製の箱と"}, {"type": "subtitle", "time": 11733.269, "timestamp": "03:15:33", "text": "銅熱"}, {"type": "subtitle", "time": 11742.91, "timestamp": "03:15:42", "text": "うん、熱を起こそうと思う"}, {"type": "subtitle", "time": 11746.15, "timestamp": "03:15:46", "text": "製錬会社。"}, {"type": "subtitle", "time": 11750.469, "timestamp": "03:15:50", "text": "おお。何？無料で物を売ってあげられるよ"}, {"type": "subtitle", "time": 11755.15, "timestamp": "03:15:55", "text": "あるいは、そんな感じ。わからない。鐘。"}]
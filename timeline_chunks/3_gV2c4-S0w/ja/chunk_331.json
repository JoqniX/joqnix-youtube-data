[{"type": "subtitle", "time": 19862.868, "timestamp": "05:31:02", "text": "日本のカフェのことですよね？オアヴァ"}, {"type": "subtitle", "time": 19866.628, "timestamp": "05:31:06", "text": "えっと、あのうどん屋は麺でした。うん。"}, {"type": "subtitle", "time": 19873.59, "timestamp": "05:31:13", "text": "ええと、彼らがやって来たので、私が彼らに近づきました。"}, {"type": "subtitle", "time": 19875.59, "timestamp": "05:31:15", "text": "私は話しました、そして私は言った"}, {"type": "subtitle", "time": 19879.27, "timestamp": "05:31:19", "text": "私はYouTubeとかYouTubeとか色々やってます。"}, {"type": "subtitle", "time": 19883.15, "timestamp": "05:31:23", "text": "Twitchを使わない理由は？こんにちは、スポーンスカイスカイ。えっと、"}, {"type": "subtitle", "time": 19886.99, "timestamp": "05:31:26", "text": "こんにちは。 Twitchを使わない理由は？私はライブ配信中です"}, {"type": "subtitle", "time": 19890.31, "timestamp": "05:31:30", "text": "トゥイッチ。 Twitchでライブ配信中です。生放送中です"}, {"type": "subtitle", "time": 19898.51, "timestamp": "05:31:38", "text": "配達。うん、頼りに"}, {"type": "subtitle", "time": 19901.23, "timestamp": "05:31:41", "text": "トゥイッチ。だから私はTwitchを読んでいたんです"}, {"type": "subtitle", "time": 19905.548, "timestamp": "05:31:45", "text": "コメント。私は希望がない"}, {"type": "subtitle", "time": 19908.35, "timestamp": "05:31:48", "text": "彼ら。おお"}, {"type": "subtitle", "time": 19917.11, "timestamp": "05:31:57", "text": "生き残る。なぜなら彼らは"}]
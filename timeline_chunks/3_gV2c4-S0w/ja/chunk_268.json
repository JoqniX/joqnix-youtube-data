[{"type": "subtitle", "time": 16091.11, "timestamp": "04:28:11", "text": "推測するが、もし私が尋ねたら"}, {"type": "subtitle", "time": 16118.87, "timestamp": "04:28:38", "text": "ええと、でもそれは北山の友人だったんです。ああ。おお、"}, {"type": "subtitle", "time": 16120.71, "timestamp": "04:28:40", "text": "うん。そうするべきだ。ああ、そうだね。ホカス。その"}, {"type": "subtitle", "time": 16122.349, "timestamp": "04:28:42", "text": "ずいぶん時間が経ちましたね。私"}, {"type": "subtitle", "time": 16134.71, "timestamp": "04:28:54", "text": "実は以前、オコスと話したことがあるんです。"}]
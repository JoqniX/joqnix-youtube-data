[{"type": "subtitle", "time": 11101.51, "timestamp": "03:05:01", "text": "じゃあ、待って、もしあなたが食べ物を注文するなら"}, {"type": "subtitle", "time": 11103.91, "timestamp": "03:05:03", "text": "午前5時か午前4時とか、そういうこと"}, {"type": "subtitle", "time": 11113.83, "timestamp": "03:05:13", "text": "はぁ？え、じゃあみんな夜通し起きてるの？"}, {"type": "subtitle", "time": 11115.429, "timestamp": "03:05:15", "text": "それとも何か別のこと？夜勤があり、"}, {"type": "subtitle", "time": 11118.15, "timestamp": "03:05:18", "text": "食品配達用の商品。"}, {"type": "subtitle", "time": 11126.23, "timestamp": "03:05:26", "text": "ほら、君だよ。"}, {"type": "subtitle", "time": 11133.83, "timestamp": "03:05:33", "text": "ああ、わかったよ。"}, {"type": "subtitle", "time": 11136.309, "timestamp": "03:05:36", "text": "待って、トイレットペーパーで攻撃してあげるよ。"}, {"type": "subtitle", "time": 11139.67, "timestamp": "03:05:39", "text": "ああ、あなたは私にトイレットペーパーを投げつけるのね。私を巻き込まないでください。"}, {"type": "subtitle", "time": 11143.59, "timestamp": "03:05:43", "text": "わかった。わかった。こんにちは。わかった。ここまでたどり着いた。"}, {"type": "subtitle", "time": 11147.309, "timestamp": "03:05:47", "text": "この部分を見てください。何？"}, {"type": "subtitle", "time": 11152.389, "timestamp": "03:05:52", "text": "わかった。このブロックは何ですか？これはおかしい。"}, {"type": "subtitle", "time": 11154.79, "timestamp": "03:05:54", "text": "待って。何を作っているの？君たちは"}]
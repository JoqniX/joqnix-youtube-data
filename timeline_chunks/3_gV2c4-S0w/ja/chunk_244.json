[{"type": "subtitle", "time": 14648.309, "timestamp": "04:04:08", "text": "昨日私は"}, {"type": "subtitle", "time": 14651.99, "timestamp": "04:04:11", "text": "トイレ休憩でも取ってください。私は行った"}, {"type": "subtitle", "time": 14654.269, "timestamp": "04:04:14", "text": "6時間"}, {"type": "subtitle", "time": 14662.59, "timestamp": "04:04:22", "text": "実際には狂っている、"}, {"type": "subtitle", "time": 14664.91, "timestamp": "04:04:24", "text": "兄弟。それは"}, {"type": "subtitle", "time": 14671.63, "timestamp": "04:04:31", "text": "ポグ。ああいうタイプのスポーツマンが欲しいんだ。休憩なし"}, {"type": "subtitle", "time": 14681.189, "timestamp": "04:04:41", "text": "私のエネルギーは少し散漫だったと思います"}, {"type": "subtitle", "time": 14683.229, "timestamp": "04:04:43", "text": "場所、でも私は"}, {"type": "subtitle", "time": 14687.59, "timestamp": "04:04:47", "text": "午前8時にトイレ休憩を取っただろうか。"}, {"type": "subtitle", "time": 14692.07, "timestamp": "04:04:52", "text": "いや、いや、午前8時30分、午前8時40分。それは待って、"}, {"type": "subtitle", "time": 14699.03, "timestamp": "04:04:59", "text": "今日。そう、そう。うん。うん。そして"}]
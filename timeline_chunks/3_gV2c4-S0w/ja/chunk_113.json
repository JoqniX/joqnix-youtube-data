[{"type": "subtitle", "time": 6782.55, "timestamp": "01:53:02", "text": "特定のブロックがどのように機能するか。それからあなた"}, {"type": "subtitle", "time": 6786.39, "timestamp": "01:53:06", "text": "それが何をするのかを解明する必要がある"}, {"type": "subtitle", "time": 6788.55, "timestamp": "01:53:08", "text": "そんなに。どれだけの仕事をするか考えてみてください"}, {"type": "subtitle", "time": 6791.91, "timestamp": "01:53:11", "text": "機械的に行う必要がある。私は"}, {"type": "subtitle", "time": 6793.79, "timestamp": "01:53:13", "text": "トニー。"}, {"type": "subtitle", "time": 6795.83, "timestamp": "01:53:15", "text": "[音楽]"}, {"type": "subtitle", "time": 6803.91, "timestamp": "01:53:23", "text": "ああ、なんてことだ。どうしても付け加えたかった"}, {"type": "subtitle", "time": 6812.31, "timestamp": "01:53:32", "text": "いいえ。ええ、スーパーヒーローのMODがありますよ"}, {"type": "subtitle", "time": 6815.189, "timestamp": "01:53:35", "text": "それはとても素晴らしいですね。わかった。わかった。あなた"}, {"type": "subtitle", "time": 6817.51, "timestamp": "01:53:37", "text": "わかった、わかった。それでは、ルーン文字がどのように"}, {"type": "subtitle", "time": 6819.95, "timestamp": "01:53:39", "text": "実際に出産は行われた。"}, {"type": "subtitle", "time": 6822.79, "timestamp": "01:53:42", "text": "そこで私はコミュニティを作りたかったのです"}, {"type": "subtitle", "time": 6824.629, "timestamp": "01:53:44", "text": "イベント。わかった。まるで私が入りたかったかのように"}, {"type": "subtitle", "time": 6826.55, "timestamp": "01:53:46", "text": "Discordの仲間たちとのコミュニティイベント。"}, {"type": "subtitle", "time": 6829.109, "timestamp": "01:53:49", "text": "PVPのようなものですが、"}, {"type": "subtitle", "time": 6832.229, "timestamp": "01:53:52", "text": "私が作ったサーバーにはスーパーヒーローがいた"}, {"type": "subtitle", "time": 6834.629, "timestamp": "01:53:54", "text": "モッズ。つまり、すべてのプレイヤーは"}, {"type": "subtitle", "time": 6837.03, "timestamp": "01:53:57", "text": "好きなスーパーヒーローを選んで"}, {"type": "subtitle", "time": 6839.43, "timestamp": "01:53:59", "text": "PvPをします。"}]
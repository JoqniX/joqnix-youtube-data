[{"type": "subtitle", "time": 13502.389, "timestamp": "03:45:02", "text": "実際に訪れた本物の人々"}, {"type": "subtitle", "time": 13505.269, "timestamp": "03:45:05", "text": "配信して、私と話したりした。"}, {"type": "subtitle", "time": 13508.07, "timestamp": "03:45:08", "text": "うん。それから、私は"}, {"type": "subtitle", "time": 13511.55, "timestamp": "03:45:11", "text": "キックチャットログを作成する必要がある"}, {"type": "subtitle", "time": 13515.349, "timestamp": "03:45:15", "text": "TwitchやYouTubeもあるので"}, {"type": "subtitle", "time": 13518.79, "timestamp": "03:45:18", "text": "そしてビリーのチャットログとイベントは"}, {"type": "subtitle", "time": 13520.75, "timestamp": "03:45:20", "text": "Discordにログインする"}, {"type": "subtitle", "time": 13523.51, "timestamp": "03:45:23", "text": "サーバ。そのため、モデレーターも"}, {"type": "subtitle", "time": 13525.59, "timestamp": "03:45:25", "text": "すべてについて最新情報を入手"}, {"type": "subtitle", "time": 13526.83, "timestamp": "03:45:26", "text": "ない"}, {"type": "subtitle", "time": 13530.189, "timestamp": "03:45:30", "text": "ここ。そうすれば彼らは"}, {"type": "subtitle", "time": 13532.79, "timestamp": "03:45:32", "text": "すべてがオランダ製。"}, {"type": "subtitle", "time": 13540.309, "timestamp": "03:45:40", "text": "眠くなってきた。私は"}, {"type": "subtitle", "time": 13543.429, "timestamp": "03:45:43", "text": "抑えきれないほどあくびをする。うわぁ。"}, {"type": "subtitle", "time": 13552.95, "timestamp": "03:45:52", "text": "63. そして、何が面白いか分かる？今日は"}, {"type": "subtitle", "time": 13555.269, "timestamp": "03:45:55", "text": "月曜日のはずだった。今日はその日だった"}, {"type": "subtitle", "time": 13557.91, "timestamp": "03:45:57", "text": "音楽の授業があるはずだった。"}]
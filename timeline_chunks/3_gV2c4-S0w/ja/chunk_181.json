[{"type": "subtitle", "time": 10868.87, "timestamp": "03:01:08", "text": "水と、わあ、これ作れるんだ"}, {"type": "subtitle", "time": 10872.309, "timestamp": "03:01:12", "text": "私のものとして、そして、これを私が作ることができるのがわかります。"}, {"type": "subtitle", "time": 10895.99, "timestamp": "03:01:35", "text": "よし、ボディーガードが必要だ。"}, {"type": "subtitle", "time": 10897.67, "timestamp": "03:01:37", "text": "あ、待って、待って、待って。忘れた。私は私は"}, {"type": "subtitle", "time": 10900.389, "timestamp": "03:01:40", "text": "クリエイティブな分野で。なんてこった。なぜ私は飛び降りたのか"}, {"type": "subtitle", "time": 10906.75, "timestamp": "03:01:46", "text": "兄弟？ああ、大変だ、飛び降りたよ。"}]
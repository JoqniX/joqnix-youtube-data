[{"type": "subtitle", "time": 1743.19, "timestamp": "00:29:03", "text": "それ。その図表はどこにありますか？小さくて"}, {"type": "subtitle", "time": 1752.95, "timestamp": "00:29:12", "text": "私には理解できません。なぜ見つからないのでしょうか？"}, {"type": "subtitle", "time": 1756.99, "timestamp": "00:29:16", "text": "ブックマークしたと思ったのですが"}, {"type": "subtitle", "time": 1759.389, "timestamp": "00:29:19", "text": "見つけられない"}, {"type": "subtitle", "time": 1768.19, "timestamp": "00:29:28", "text": "そこには。見つかりません。なし"}, {"type": "subtitle", "time": 1769.87, "timestamp": "00:29:29", "text": "そこには。"}, {"type": "subtitle", "time": 1772.71, "timestamp": "00:29:32", "text": "ああ、もし私がそれを見つけたことがあるなら"}, {"type": "subtitle", "time": 1782.63, "timestamp": "00:29:42", "text": "うん。しかし、それは妥当だ。それは妥当だ。"}, {"type": "subtitle", "time": 1786.71, "timestamp": "00:29:46", "text": "ニラサンさん、誕生日おめでとうございます。それはニラサンの"}, {"type": "subtitle", "time": 1788.83, "timestamp": "00:29:48", "text": "ちなみに誕生日です。"}, {"type": "subtitle", "time": 1790.59, "timestamp": "00:29:50", "text": "今日。"}, {"type": "subtitle", "time": 1793.59, "timestamp": "00:29:53", "text": "えっと、彼女は日本に住んでいますよね？"}]
[{"type": "subtitle", "time": 6003.91, "timestamp": "01:40:03", "text": "えっと、待って、彼女は配信を終了したの？彼女はそうじゃない？"}, {"type": "subtitle", "time": 6016.07, "timestamp": "01:40:16", "text": "Multiverseプラグインを使用すると、"}, {"type": "subtitle", "time": 6017.99, "timestamp": "01:40:17", "text": "1つのMinecraftに複数の壁"}, {"type": "subtitle", "time": 6019.149, "timestamp": "01:40:19", "text": "サーバ。"}, {"type": "subtitle", "time": 6022.47, "timestamp": "01:40:22", "text": "ああ、私のJPはリソースディメンションを使用しています"}, {"type": "subtitle", "time": 6026.47, "timestamp": "01:40:26", "text": "家を建てて、壁を輸入する"}, {"type": "subtitle", "time": 6028.31, "timestamp": "01:40:28", "text": "サーバーの壁がJPサーバーにインポートされます"}, {"type": "subtitle", "time": 6032.109, "timestamp": "01:40:32", "text": "マルチバース内の次元として"}, {"type": "subtitle", "time": 6041.43, "timestamp": "01:40:41", "text": "サーバーに接続していますか？タイムアウトになった。"}, {"type": "subtitle", "time": 6050.47, "timestamp": "01:40:50", "text": "マルチバースも追加すべきだ。"}, {"type": "subtitle", "time": 6052.07, "timestamp": "01:40:52", "text": "えっと、本当にそれが耐えられると思いますか？"}, {"type": "subtitle", "time": 6054.87, "timestamp": "01:40:54", "text": "負荷は大きいですか？いいえ。ええと。見てみましょう。させて"}, {"type": "subtitle", "time": 6056.91, "timestamp": "01:40:56", "text": "私にはわかる。"}]
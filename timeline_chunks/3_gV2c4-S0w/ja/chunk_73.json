[{"type": "subtitle", "time": 4381.91, "timestamp": "01:13:01", "text": "今。今はだいぶ良くなった。 「ああ」と書いてあります。"}, {"type": "subtitle", "time": 4385.51, "timestamp": "01:13:05", "text": "待って。 95でした。わかりました。これは保管できません。"}, {"type": "subtitle", "time": 4387.51, "timestamp": "01:13:07", "text": "テレポートしたから95になった"}, {"type": "subtitle", "time": 4390.63, "timestamp": "01:13:10", "text": "例えば2000ブロック離れた場所で"}, {"type": "subtitle", "time": 4392.95, "timestamp": "01:13:12", "text": "そのジャングルは危険ではない。それが理由です"}, {"type": "subtitle", "time": 4396.79, "timestamp": "01:13:16", "text": "ええ、今バイオームを探しているところです。"}, {"type": "subtitle", "time": 4399.11, "timestamp": "01:13:19", "text": "わかった。桜のバイオームのように"}, {"type": "subtitle", "time": 4404.91, "timestamp": "01:13:24", "text": "一つだけできることがある。一つやりたい"}, {"type": "subtitle", "time": 4407.31, "timestamp": "01:13:27", "text": "もの。できる"}, {"type": "subtitle", "time": 4414.149, "timestamp": "01:13:34", "text": "家に帰るまで黙っていてくれませんか？私にさせて"}, {"type": "subtitle", "time": 4415.91, "timestamp": "01:13:35", "text": "私のライン作業を手伝ってくれるかどうか教えてください。"}, {"type": "subtitle", "time": 4418.31, "timestamp": "01:13:38", "text": "ええ、もちろん、もちろんです。現時点で、"}, {"type": "subtitle", "time": 4422.11, "timestamp": "01:13:42", "text": "いいえ。でも、私は飛び乗るよ"}, {"type": "subtitle", "time": 4425.39, "timestamp": "01:13:45", "text": "後で。実際に配置できるわけではないが"}, {"type": "subtitle", "time": 4433.51, "timestamp": "01:13:53", "text": "41ティック遅れている。はぁ？"}, {"type": "subtitle", "time": 4434.95, "timestamp": "01:13:54", "text": "ええ、ここに村を作りました。それは"}, {"type": "subtitle", "time": 4439.189, "timestamp": "01:13:59", "text": "それが問題なんです。私は今"}]
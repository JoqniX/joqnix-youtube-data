[{"type": "subtitle", "time": 17462.75, "timestamp": "04:51:02", "text": "文字通り想定した"}, {"type": "subtitle", "time": 17466.708, "timestamp": "04:51:06", "text": "えっと、もし私たち二人がコラボしたら、"}, {"type": "subtitle", "time": 17470.15, "timestamp": "04:51:10", "text": "まるで私が雲を追いかけようとしているように"}, {"type": "subtitle", "time": 17473.35, "timestamp": "04:51:13", "text": "視聴者を奪うため、あるいは何であれ"}, {"type": "subtitle", "time": 17476.628, "timestamp": "04:51:16", "text": "私自身の利益のために、私が得るために"}, {"type": "subtitle", "time": 17479.83, "timestamp": "04:51:19", "text": "お金とか、その他諸々。そして彼らは"}, {"type": "subtitle", "time": 17482.708, "timestamp": "04:51:22", "text": "あるいは、そんな感じ。そして彼らは"}, {"type": "subtitle", "time": 17487.83, "timestamp": "04:51:27", "text": "誰に証明したいのかと聞かれた。"}, {"type": "subtitle", "time": 17490.868, "timestamp": "04:51:30", "text": "一体これは何なんだ、デフォルト設定は？"}, {"type": "subtitle", "time": 17493.51, "timestamp": "04:51:33", "text": "翻訳が間違っていますか？例えば、"}, {"type": "subtitle", "time": 17496.83, "timestamp": "04:51:36", "text": "英語を日本語に翻訳する、兄弟"}, {"type": "subtitle", "time": 17500.868, "timestamp": "04:51:40", "text": "そこで何か起こるんですか？それから私は"}, {"type": "subtitle", "time": 17502.708, "timestamp": "04:51:42", "text": "ええ、まだです。そして最後に、"}, {"type": "subtitle", "time": 17505.868, "timestamp": "04:51:45", "text": "いいね"}, {"type": "subtitle", "time": 17508.708, "timestamp": "04:51:48", "text": "えっと、配達をしていると思いますか？"}, {"type": "subtitle", "time": 17512.07, "timestamp": "04:51:52", "text": "2000ドルの価値がある？それでは説明しましょう"}, {"type": "subtitle", "time": 17514.788, "timestamp": "04:51:54", "text": "簡単にポイントで表すと"}, {"type": "subtitle", "time": 17516.788, "timestamp": "04:51:56", "text": "理解して、私はそうじゃない"}, {"type": "subtitle", "time": 17518.708, "timestamp": "04:51:58", "text": "お金とかのためにやってるけど、"}]
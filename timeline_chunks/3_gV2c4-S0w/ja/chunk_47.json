[{"type": "subtitle", "time": 2822.55, "timestamp": "00:47:02", "text": "想像するより多くの人々"}, {"type": "subtitle", "time": 2825.589, "timestamp": "00:47:05", "text": "手伝ってくれる人がもっといるなら"}, {"type": "subtitle", "time": 2827.67, "timestamp": "00:47:07", "text": "あなたなら大丈夫ですが、もしそれが"}, {"type": "subtitle", "time": 2829.51, "timestamp": "00:47:09", "text": "グループコラボレーションで、あなただけが"}, {"type": "subtitle", "time": 2831.55, "timestamp": "00:47:11", "text": "実際は"}, {"type": "subtitle", "time": 2834.71, "timestamp": "00:47:14", "text": "ボランティア活動を行い、全員が参加していることを確認する"}, {"type": "subtitle", "time": 2837.349, "timestamp": "00:47:17", "text": "同じページとすべてが"}, {"type": "subtitle", "time": 2839.589, "timestamp": "00:47:19", "text": "もっと自由を与えれば、そうね"}, {"type": "subtitle", "time": 2842.95, "timestamp": "00:47:22", "text": "難しいだろうし、コラボも見える"}, {"type": "subtitle", "time": 2845.829, "timestamp": "00:47:25", "text": "コラボレーションの中で、私が参加した作品は"}, {"type": "subtitle", "time": 2848.47, "timestamp": "00:47:28", "text": "イアンのような西洋とのコラボレーションがたくさんある"}, {"type": "subtitle", "time": 2852.79, "timestamp": "00:47:32", "text": "昔のコラボレーションや"}, {"type": "subtitle", "time": 2855.75, "timestamp": "00:47:35", "text": "それは完全に真っ直ぐに細断された"}, {"type": "subtitle", "time": 2859.109, "timestamp": "00:47:39", "text": "ストレートなアーティスト、コラボレーション"}, {"type": "subtitle", "time": 2861.67, "timestamp": "00:47:41", "text": "率先して行動する、そう、これは"}, {"type": "subtitle", "time": 2864.069, "timestamp": "00:47:44", "text": "私たちがこれからすることは、みんなで"}, {"type": "subtitle", "time": 2867.19, "timestamp": "00:47:47", "text": "時間通りに到着します。15分後に参加してください。"}, {"type": "subtitle", "time": 2872.15, "timestamp": "00:47:52", "text": "VC会議の前に早めに"}, {"type": "subtitle", "time": 2875.109, "timestamp": "00:47:55", "text": "ストリーム配信をするには、どのように始めるか、"}, {"type": "subtitle", "time": 2876.87, "timestamp": "00:47:56", "text": "フォーマットは？どうやってやるの？"}]
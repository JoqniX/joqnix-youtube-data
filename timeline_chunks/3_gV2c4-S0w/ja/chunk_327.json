[{"type": "subtitle", "time": 19622.31, "timestamp": "05:27:02", "text": "寄付？いいえ、違います。"}, {"type": "subtitle", "time": 19625.03, "timestamp": "05:27:05", "text": "それはまるで私がすでに"}, {"type": "subtitle", "time": 19627.35, "timestamp": "05:27:07", "text": "6月中旬までにやる予定"}, {"type": "subtitle", "time": 19629.19, "timestamp": "05:27:09", "text": "6月"}, {"type": "subtitle", "time": 19633.19, "timestamp": "05:27:13", "text": "えーと、6月末には準備を始め、"}, {"type": "subtitle", "time": 19634.948, "timestamp": "05:27:14", "text": "荷物を詰めて"}, {"type": "subtitle", "time": 19640.31, "timestamp": "05:27:20", "text": "日本へ行く。それで、えーと、私は"}, {"type": "subtitle", "time": 19643.51, "timestamp": "05:27:23", "text": "タイマーは、自分に思い出させる方法として、"}, {"type": "subtitle", "time": 19647.19, "timestamp": "05:27:27", "text": "皆さんに、ええ、何時間も"}, {"type": "subtitle", "time": 19651.27, "timestamp": "05:27:31", "text": "その月には、そういう状態で残っている。だからそれは"}, {"type": "subtitle", "time": 19654.31, "timestamp": "05:27:34", "text": "上限がないというよりは、上限がないような感じですが"}, {"type": "subtitle", "time": 19662.43, "timestamp": "05:27:42", "text": "フレーム。あなたに"}, {"type": "subtitle", "time": 19665.19, "timestamp": "05:27:45", "text": "理解した。もしあなたが貧しい人を見逃していたら"}, {"type": "subtitle", "time": 19668.31, "timestamp": "05:27:48", "text": "その一部について、ぜひ教えてください。私は"}, {"type": "subtitle", "time": 19671.19, "timestamp": "05:27:51", "text": "喜んでできる、喜んでする、喜んで"}, {"type": "subtitle", "time": 19673.15, "timestamp": "05:27:53", "text": "説明したい"}]
[{"type": "subtitle", "time": 18720.51, "timestamp": "05:12:00", "text": "しないで"}, {"type": "subtitle", "time": 18723.83, "timestamp": "05:12:03", "text": "心配。えっと、意地悪な先生が来たんだけど"}, {"type": "subtitle", "time": 18727.83, "timestamp": "05:12:07", "text": "その日、私の配信で私はプレイしていました"}, {"type": "subtitle", "time": 18730.708, "timestamp": "05:12:10", "text": "リングウェーブサカで彼は書いた"}, {"type": "subtitle", "time": 18733.39, "timestamp": "05:12:13", "text": "日本語で何か言ってたんだけど、俺はこう思ったんだ"}, {"type": "subtitle", "time": 18736.15, "timestamp": "05:12:16", "text": "パニックになって、私は「読めないよ、ああ」って感じだった"}, {"type": "subtitle", "time": 18738.948, "timestamp": "05:12:18", "text": "神様は私が勉強しなかったことを知っているでしょう"}, {"type": "subtitle", "time": 18741.43, "timestamp": "05:12:21", "text": "また叱られるよ、ああ神様、それから私は"}, {"type": "subtitle", "time": 18745.59, "timestamp": "05:12:25", "text": "知って、私はPCを必死に操作した"}, {"type": "subtitle", "time": 18748.628, "timestamp": "05:12:28", "text": "非常に遅れてコピー"}, {"type": "subtitle", "time": 18751.31, "timestamp": "05:12:31", "text": "OBSにコピーしていたテキストを貼り付けました"}, {"type": "subtitle", "time": 18755.11, "timestamp": "05:12:35", "text": "はい、OBSでテキストソースが作成されましたよ。"}, {"type": "subtitle", "time": 18759.35, "timestamp": "05:12:39", "text": "彼は知っていた。彼は私が彼の"}, {"type": "subtitle", "time": 18760.83, "timestamp": "05:12:40", "text": "Googleのコメント"}, {"type": "subtitle", "time": 18766.05, "timestamp": "05:12:46", "text": "兄弟。"}, {"type": "subtitle", "time": 18768.11, "timestamp": "05:12:48", "text": "[音楽]"}, {"type": "subtitle", "time": 18770.59, "timestamp": "05:12:50", "text": "いいえ。しかし"}, {"type": "subtitle", "time": 18773.27, "timestamp": "05:12:53", "text": "えっと、どうやら彼は入力しているだけらしい"}, {"type": "subtitle", "time": 18775.59, "timestamp": "05:12:55", "text": "日本語。 「ああ、そうだね」って感じだよね。"}, {"type": "subtitle", "time": 18778.708, "timestamp": "05:12:58", "text": "彼が来るといつも、「よう、坊や」って言うんだ。"}]
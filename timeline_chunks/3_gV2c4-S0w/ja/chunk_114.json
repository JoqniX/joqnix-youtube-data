[{"type": "subtitle", "time": 6841.75, "timestamp": "01:54:01", "text": "でもその計画はまず"}, {"type": "subtitle", "time": 6843.83, "timestamp": "01:54:03", "text": "無料サーバーはそれほど多くのリソースを消費していなかった"}, {"type": "subtitle", "time": 6846.31, "timestamp": "01:54:06", "text": "ロードしてからサーバーを購入しなければなりませんでした"}, {"type": "subtitle", "time": 6848.87, "timestamp": "01:54:08", "text": "2番目のライバルはちょうどその点を指摘した。"}, {"type": "subtitle", "time": 6850.47, "timestamp": "01:54:10", "text": "だから、私は"}, {"type": "subtitle", "time": 6852.669, "timestamp": "01:54:12", "text": "ライバルが模倣する"}, {"type": "subtitle", "time": 6854.79, "timestamp": "01:54:14", "text": "マインクラフト。だから私はこう思ったんだ、もし"}, {"type": "subtitle", "time": 6856.87, "timestamp": "01:54:16", "text": "サーバーを購入したいのですが、"}, {"type": "subtitle", "time": 6858.629, "timestamp": "01:54:18", "text": "実際に投資してサーバーを購入する必要があります"}, {"type": "subtitle", "time": 6861.43, "timestamp": "01:54:21", "text": "マインクラフトで大きく作って、"}, {"type": "subtitle", "time": 6867.03, "timestamp": "01:54:27", "text": "クリエイター。そうやって私は始めたんです"}, {"type": "subtitle", "time": 6868.95, "timestamp": "01:54:28", "text": "部屋での出産と部屋での出産の計画"}, {"type": "subtitle", "time": 6871.149, "timestamp": "01:54:31", "text": "であるべき"}, {"type": "subtitle", "time": 6874.39, "timestamp": "01:54:34", "text": "ハプニング。しかし元々は"}, {"type": "subtitle", "time": 6880.709, "timestamp": "01:54:40", "text": "ルーン誕生へと発展したコミュニティイベント。"}]
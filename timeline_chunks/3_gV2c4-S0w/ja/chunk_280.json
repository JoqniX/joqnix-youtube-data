[{"type": "subtitle", "time": 16802.55, "timestamp": "04:40:02", "text": "ガッチャ。それは良いことだ。少なくともあなたは"}, {"type": "subtitle", "time": 16807.788, "timestamp": "04:40:07", "text": "今は良好な通信接続が可能になった。"}, {"type": "subtitle", "time": 16815.628, "timestamp": "04:40:15", "text": "それで、数字が気になります。"}, {"type": "subtitle", "time": 16818.67, "timestamp": "04:40:18", "text": "チャンネルサイズと同様"}, {"type": "subtitle", "time": 16821.23, "timestamp": "04:40:21", "text": "何かが必要だから"}, {"type": "subtitle", "time": 16823.628, "timestamp": "04:40:23", "text": "数千。おお、"}, {"type": "subtitle", "time": 16826.47, "timestamp": "04:40:26", "text": "それから待つ。それは本当にクレイジーだ"}, {"type": "subtitle", "time": 16828.67, "timestamp": "04:40:28", "text": "彼らは許可する"}, {"type": "subtitle", "time": 16831.51, "timestamp": "04:40:31", "text": "それ。つまり、その人は"}, {"type": "subtitle", "time": 16834.23, "timestamp": "04:40:34", "text": "それは人によっても違うと思う。"}, {"type": "subtitle", "time": 16836.15, "timestamp": "04:40:36", "text": "推測。"}, {"type": "subtitle", "time": 16844.868, "timestamp": "04:40:44", "text": "など。ええ、それは人によりますね。"}, {"type": "subtitle", "time": 16848.788, "timestamp": "04:40:48", "text": "実は。私は今、"}, {"type": "subtitle", "time": 16852.15, "timestamp": "04:40:52", "text": "私が遭遇したやり取り"}, {"type": "subtitle", "time": 16855.708, "timestamp": "04:40:55", "text": "などなど。いいえ、私はいつも"}]
[{"type": "subtitle", "time": 3006.87, "timestamp": "00:50:06", "text": "すごくクールだけど、うん、また、"}, {"type": "subtitle", "time": 3009.03, "timestamp": "00:50:09", "text": "人々が異なる方法で"}, {"type": "subtitle", "time": 3012.27, "timestamp": "00:50:12", "text": "それは人々次第です"}, {"type": "subtitle", "time": 3015.829, "timestamp": "00:50:15", "text": "もう一度言うと、つまり、もし私が思うなら"}, {"type": "subtitle", "time": 3017.23, "timestamp": "00:50:17", "text": "について"}, {"type": "subtitle", "time": 3021.19, "timestamp": "00:50:21", "text": "ジョアトンに関しては、"}, {"type": "subtitle", "time": 3024.309, "timestamp": "00:50:24", "text": "私のチャンネルで私がやったこと、もし私が"}, {"type": "subtitle", "time": 3026.79, "timestamp": "00:50:26", "text": "時間と労力を費やして好きになった"}, {"type": "subtitle", "time": 3028.27, "timestamp": "00:50:28", "text": "プロフェッショナル化する"}, {"type": "subtitle", "time": 3032.87, "timestamp": "00:50:32", "text": "私ならもっとうまくできるのに"}, {"type": "subtitle", "time": 3035.87, "timestamp": "00:50:35", "text": "今まさにやっています。しかし"}, {"type": "subtitle", "time": 3039.03, "timestamp": "00:50:39", "text": "繰り返しますが、それをより良くして、"}, {"type": "subtitle", "time": 3042.069, "timestamp": "00:50:42", "text": "すべてにおいて、もっと多くの人の助けが必要です"}, {"type": "subtitle", "time": 3045.27, "timestamp": "00:50:45", "text": "あなたですよね？何でもできるわけではない"}, {"type": "subtitle", "time": 3047.829, "timestamp": "00:50:47", "text": "たった一人で。いいえ、それは私が"}, {"type": "subtitle", "time": 3049.15, "timestamp": "00:50:49", "text": "理解した。"}, {"type": "subtitle", "time": 3051.829, "timestamp": "00:50:51", "text": "時々、それは"}, {"type": "subtitle", "time": 3053.51, "timestamp": "00:50:53", "text": "いい考えですね、あなたはそれをやりたいと思いますが、"}, {"type": "subtitle", "time": 3056.069, "timestamp": "00:50:56", "text": "誰かがあなたに"}, {"type": "subtitle", "time": 3058.71, "timestamp": "00:50:58", "text": "より良いアイデアが浮かび、そこからインスピレーションを得る"}]
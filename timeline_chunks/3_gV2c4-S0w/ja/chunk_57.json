[{"type": "subtitle", "time": 3441.589, "timestamp": "00:57:21", "text": "今、出て行ったの？ええ、ここにいますよ。私は"}, {"type": "subtitle", "time": 3445.51, "timestamp": "00:57:25", "text": "礼拝関連の仕事で。こんにちは。私は"}, {"type": "subtitle", "time": 3447.67, "timestamp": "00:57:27", "text": "あなたに加わります。私はクリックしようとしていました"}, {"type": "subtitle", "time": 3451.589, "timestamp": "00:57:31", "text": "続けて、すごい。いいえ、私は"}, {"type": "subtitle", "time": 3453.27, "timestamp": "00:57:33", "text": "あなたのコノをすべて聞いていると"}, {"type": "subtitle", "time": 3458.47, "timestamp": "00:57:38", "text": "背景。そう、バカな兄貴みたいにね。話す"}, {"type": "subtitle", "time": 3468.27, "timestamp": "00:57:48", "text": "私は、私はそれに値するとは思わない"}]
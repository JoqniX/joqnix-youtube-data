[{"type": "subtitle", "time": 5162.55, "timestamp": "01:26:02", "text": "彼らは苦しみ、死んでいく。窒息死する。"}, {"type": "subtitle", "time": 5165.95, "timestamp": "01:26:05", "text": "何てことだ。それは"}, {"type": "subtitle", "time": 5181.43, "timestamp": "01:26:21", "text": "[音楽]"}, {"type": "subtitle", "time": 5186.87, "timestamp": "01:26:26", "text": "息をする。聞くことができるMinecraftのMOD"}, {"type": "subtitle", "time": 5198.83, "timestamp": "01:26:38", "text": "これ？うん。私と私の友達"}, {"type": "subtitle", "time": 5206.79, "timestamp": "01:26:46", "text": "これ？彼らはそうしない。わかった。とにかく、私は"}, {"type": "subtitle", "time": 5210.01, "timestamp": "01:26:50", "text": "水中で探しています"}]
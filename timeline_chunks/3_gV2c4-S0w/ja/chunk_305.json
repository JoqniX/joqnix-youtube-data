[{"type": "subtitle", "time": 18302.23, "timestamp": "05:05:02", "text": "プラグインは改造なしで自動的に"}, {"type": "subtitle", "time": 18304.708, "timestamp": "05:05:04", "text": "クライアント用のすべてのMODをダウンロードしてください"}, {"type": "subtitle", "time": 18308.31, "timestamp": "05:05:08", "text": "サイドとサーバーサイド。ああ、そうするしかない"}, {"type": "subtitle", "time": 18311.708, "timestamp": "05:05:11", "text": "再起動など。"}, {"type": "subtitle", "time": 18316.11, "timestamp": "05:05:16", "text": "それ。ああ、私たちは皆同じ人間だ。 A"}, {"type": "subtitle", "time": 18321.55, "timestamp": "05:05:21", "text": "ゾンビゾンビが私を平手打ちしたので、私はそこを去りました。おお"}, {"type": "subtitle", "time": 18324.93, "timestamp": "05:05:24", "text": "いいえ。パットは悪い。あなたが来た"}, {"type": "subtitle", "time": 18326.03, "timestamp": "05:05:26", "text": "[音楽]"}, {"type": "subtitle", "time": 18336.55, "timestamp": "05:05:36", "text": "楽しむ。ああ、良くなるよ。ディオ"}, {"type": "subtitle", "time": 18338.19, "timestamp": "05:05:38", "text": "ジャスミンだけ"}, {"type": "subtitle", "time": 18341.59, "timestamp": "05:05:41", "text": "クインがたくさんのクールなMODを追加したので、"}, {"type": "subtitle", "time": 18343.99, "timestamp": "05:05:43", "text": "私たちが遊ぶときに、私があなたに見せる"}, {"type": "subtitle", "time": 18352.67, "timestamp": "05:05:52", "text": "それで"}]
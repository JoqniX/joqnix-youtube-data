[{"type": "subtitle", "time": 14220.67, "timestamp": "03:57:00", "text": "正午、私たちは"}, {"type": "subtitle", "time": 14224.389, "timestamp": "03:57:04", "text": "パン。待って、正午過ぎに私たちは遊んだ"}, {"type": "subtitle", "time": 14233.55, "timestamp": "03:57:13", "text": "レンズと夜には、夜に"}, {"type": "subtitle", "time": 14240.15, "timestamp": "03:57:20", "text": "私たちは吊るして夜を待ちました"}, {"type": "subtitle", "time": 14248.83, "timestamp": "03:57:28", "text": "もの"}, {"type": "subtitle", "time": 14263.79, "timestamp": "03:57:43", "text": "hプレミアム兄弟、私は欲しいけど買いたくない"}, {"type": "subtitle", "time": 14265.63, "timestamp": "03:57:45", "text": "プレミアムとは"}, {"type": "subtitle", "time": 14267.79, "timestamp": "03:57:47", "text": "多すぎる"}, {"type": "subtitle", "time": 14272.51, "timestamp": "03:57:52", "text": "お金だから、それは本当に"}, {"type": "subtitle", "time": 14277.229, "timestamp": "03:57:57", "text": "楽しいし、私は楽しんでいます"}]
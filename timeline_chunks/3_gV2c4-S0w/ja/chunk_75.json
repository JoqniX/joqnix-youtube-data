[{"type": "subtitle", "time": 4524.31, "timestamp": "01:15:24", "text": "分。なぜ現金が補充されないのですか？"}, {"type": "subtitle", "time": 4524.97, "timestamp": "01:15:24", "text": "何ですか"}, {"type": "subtitle", "time": 4526.27, "timestamp": "01:15:26", "text": "[音楽]"}, {"type": "subtitle", "time": 4529.669, "timestamp": "01:15:29", "text": "これ？待って、どうやってマインクラフトをキャプチャするの？"}, {"type": "subtitle", "time": 4532.47, "timestamp": "01:15:32", "text": "アストラは通常、明らかに有効ですか？ウィンドウ"}, {"type": "subtitle", "time": 4534.95, "timestamp": "01:15:34", "text": "捕獲ですよね？しかし、ゲームキャプチャは"}, {"type": "subtitle", "time": 4536.63, "timestamp": "01:15:36", "text": "窓と一緒に。キャプチャ固有の"}, {"type": "subtitle", "time": 4540.31, "timestamp": "01:15:40", "text": "窓ですよね？ゲームキャプチャ。うん、ゲーム"}, {"type": "subtitle", "time": 4542.63, "timestamp": "01:15:42", "text": "キャプチャモードをキャプチャに設定してキャプチャします"}, {"type": "subtitle", "time": 4546.63, "timestamp": "01:15:46", "text": "特定のウィンドウですよね？うん。"}, {"type": "subtitle", "time": 4548.63, "timestamp": "01:15:48", "text": "ガッチャ。だから、みんながタブを取ったら、"}, {"type": "subtitle", "time": 4551.35, "timestamp": "01:15:51", "text": "画面がフリーズするんですよね？"}, {"type": "subtitle", "time": 4553.11, "timestamp": "01:15:53", "text": "いいえ、私はMinecraftをプレイしないからです"}, {"type": "subtitle", "time": 4554.91, "timestamp": "01:15:54", "text": "ウィンドウモード。それは"}, {"type": "subtitle", "time": 4557.63, "timestamp": "01:15:57", "text": "違い。私はウィンドウモードでMinecraftをプレイしています"}, {"type": "subtitle", "time": 4559.83, "timestamp": "01:15:59", "text": "モード。 Minecraftを完全にプレイしないでください"}]
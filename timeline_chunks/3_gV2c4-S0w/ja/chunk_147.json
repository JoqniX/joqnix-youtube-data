[{"type": "subtitle", "time": 8827.21, "timestamp": "02:27:07", "text": "終わり。私はたくさん作るつもりです"}, {"type": "subtitle", "time": 8847.55, "timestamp": "02:27:27", "text": "彼女はどんな反応をすると思いますか？"}, {"type": "subtitle", "time": 8856.71, "timestamp": "02:27:36", "text": "あなたは本当にそれをするのですか？君たちのことはよく知ってるよ"}, {"type": "subtitle", "time": 8859.91, "timestamp": "02:27:39", "text": "冗談でしょう。"}, {"type": "subtitle", "time": 8862.87, "timestamp": "02:27:42", "text": "それは良くない。とても素敵です。信頼"}, {"type": "subtitle", "time": 8865.51, "timestamp": "02:27:45", "text": "私は、お尻のジョークを言います。そのうちの一つをお話ししましょう"}]
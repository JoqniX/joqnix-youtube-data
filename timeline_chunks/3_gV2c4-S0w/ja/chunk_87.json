[{"type": "subtitle", "time": 5237.11, "timestamp": "01:27:17", "text": "私が何をしているのかは聞かないで"}, {"type": "subtitle", "time": 5239.51, "timestamp": "01:27:19", "text": "そして、私がこれからやろうとしている仕事。ちょっと待って"}, {"type": "subtitle", "time": 5243.189, "timestamp": "01:27:23", "text": "そして見守る。何してるの？"}, {"type": "subtitle", "time": 5245.95, "timestamp": "01:27:25", "text": "待って見ていろと言っただろう。"}, {"type": "subtitle", "time": 5251.27, "timestamp": "01:27:31", "text": "わかった。そうそう。えっと、世界地図が必要なんです。私"}, {"type": "subtitle", "time": 5254.229, "timestamp": "01:27:34", "text": "知る。世界地図を知っていますか？"}, {"type": "subtitle", "time": 5257.189, "timestamp": "01:27:37", "text": "サーバーは以下から確認できます。"}, {"type": "subtitle", "time": 5260.27, "timestamp": "01:27:40", "text": "ブラウザとかそういうの？"}, {"type": "subtitle", "time": 5275.43, "timestamp": "01:27:55", "text": "電話がかかってきた。オープンパーティー。"}, {"type": "subtitle", "time": 5277.83, "timestamp": "01:27:57", "text": "このMODは、クレームと"}]
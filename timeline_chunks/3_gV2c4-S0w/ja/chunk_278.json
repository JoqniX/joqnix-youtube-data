[{"type": "subtitle", "time": 16680.99, "timestamp": "04:38:00", "text": "そうですね"}, {"type": "subtitle", "time": 16684.59, "timestamp": "04:38:04", "text": "すると質問が"}, {"type": "subtitle", "time": 16688.15, "timestamp": "04:38:08", "text": "についてですが、私にはたくさんのものがあります"}, {"type": "subtitle", "time": 16690.39, "timestamp": "04:38:10", "text": "今は気にしないで、12時だよ"}, {"type": "subtitle", "time": 16692.551, "timestamp": "04:38:12", "text": "もう3時過ぎだから、祈ってるよ"}, {"type": "subtitle", "time": 16695.83, "timestamp": "04:38:15", "text": "そこにいるけど、ええ、それで、私の質問は"}, {"type": "subtitle", "time": 16696.83, "timestamp": "04:38:16", "text": "になるだろう"}, {"type": "subtitle", "time": 16701.189, "timestamp": "04:38:21", "text": "ええ、それで、彼らはあなたを入れてくれました。"}, {"type": "subtitle", "time": 16703.109, "timestamp": "04:38:23", "text": "コラボしたり、友達と遊んだり、何でも"}, {"type": "subtitle", "time": 16705.31, "timestamp": "04:38:25", "text": "わかったよ。わかった。"}, {"type": "subtitle", "time": 16710.83, "timestamp": "04:38:30", "text": "では、もう一度プレイしたい場合はどうしますか？"}, {"type": "subtitle", "time": 16713.949, "timestamp": "04:38:33", "text": "彼らと"}, {"type": "subtitle", "time": 16716.949, "timestamp": "04:38:36", "text": "ストリーム上ではオフになっているような感じ"}, {"type": "subtitle", "time": 16719.029, "timestamp": "04:38:39", "text": "ストリームまたはいいねまたはそれに近い"}, {"type": "subtitle", "time": 16721.189, "timestamp": "04:38:41", "text": "接続か何かだが、それもまた"}, {"type": "subtitle", "time": 16724.39, "timestamp": "04:38:44", "text": "準社会主義に繋がるんですよね？それで"}, {"type": "subtitle", "time": 16726.869, "timestamp": "04:38:46", "text": "一部のストリーマーが列を作り、"}, {"type": "subtitle", "time": 16734.789, "timestamp": "04:38:54", "text": "だから、本当に"}, {"type": "subtitle", "time": 16737.869, "timestamp": "04:38:57", "text": "彼らとつながりたいと思ったのは"}]
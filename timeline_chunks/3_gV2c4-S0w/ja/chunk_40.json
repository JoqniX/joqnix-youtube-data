[{"type": "subtitle", "time": 2401.19, "timestamp": "00:40:01", "text": "そういうこと全部。ええ、私は"}, {"type": "subtitle", "time": 2403.91, "timestamp": "00:40:03", "text": "みんなが"}, {"type": "subtitle", "time": 2407.069, "timestamp": "00:40:07", "text": "私とコラボレーションすることに安心感を覚え、"}, {"type": "subtitle", "time": 2409.43, "timestamp": "00:40:09", "text": "彼らの配信を知ることなど、すべて"}, {"type": "subtitle", "time": 2411.19, "timestamp": "00:40:11", "text": "ルール、許可されていること、許可されていないこと"}, {"type": "subtitle", "time": 2412.71, "timestamp": "00:40:12", "text": "許可された、"}, {"type": "subtitle", "time": 2414.19, "timestamp": "00:40:14", "text": "ああ、それら全部"}, {"type": "subtitle", "time": 2417.19, "timestamp": "00:40:17", "text": "物、すべて。ええ、私はまだ"}, {"type": "subtitle", "time": 2421.51, "timestamp": "00:40:21", "text": "それを覚えておいてください。以前はVCを持っていた"}, {"type": "subtitle", "time": 2425.51, "timestamp": "00:40:25", "text": "えーっと、コラボする前の、えーっと、えーっと"}, {"type": "subtitle", "time": 2430.23, "timestamp": "00:40:30", "text": "初めてのチャット会みたいな感じで"}, {"type": "subtitle", "time": 2432.23, "timestamp": "00:40:32", "text": "私たちは互いを知ろうとし、"}, {"type": "subtitle", "time": 2435.829, "timestamp": "00:40:35", "text": "もの。私たちは私の"}, {"type": "subtitle", "time": 2439.39, "timestamp": "00:40:39", "text": "その最初の適切な経験は"}, {"type": "subtitle", "time": 2443.91, "timestamp": "00:40:43", "text": "ビクターは、私たちがプレイしたように、私たちはそう思った"}, {"type": "subtitle", "time": 2446.71, "timestamp": "00:40:46", "text": "1時間30分か"}, {"type": "subtitle", "time": 2449.63, "timestamp": "00:40:49", "text": "何かあるけど、たった30分の通話"}, {"type": "subtitle", "time": 2452.87, "timestamp": "00:40:52", "text": "でも、話せば話すほど、私たちは"}, {"type": "subtitle", "time": 2454.95, "timestamp": "00:40:54", "text": "良い魅力的な"}, {"type": "subtitle", "time": 2458.39, "timestamp": "00:40:58", "text": "エマ・バロットについて尋ねた会話"}]
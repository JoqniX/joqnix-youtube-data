[{"type": "subtitle", "time": 6601.99, "timestamp": "01:50:01", "text": "えーと、ドリルとかそういうやつ。"}, {"type": "subtitle", "time": 6604.87, "timestamp": "01:50:04", "text": "大丈夫。あなたが終わったら私がやります"}, {"type": "subtitle", "time": 6614.87, "timestamp": "01:50:14", "text": "何てことだ。歯車（機械式）"}, {"type": "subtitle", "time": 6621.55, "timestamp": "01:50:21", "text": "そこには"}, {"type": "subtitle", "time": 6625.189, "timestamp": "01:50:25", "text": "ケーキだよ、男。私は工場を建てたい。"}, {"type": "subtitle", "time": 6628.149, "timestamp": "01:50:28", "text": "私はまだあなたが望む あなたはあなたが望む"}, {"type": "subtitle", "time": 6631.109, "timestamp": "01:50:31", "text": "工場を建設する？電車を利用できます。"}, {"type": "subtitle", "time": 6633.83, "timestamp": "01:50:33", "text": "一体どういうことだ？"}, {"type": "subtitle", "time": 6635.43, "timestamp": "01:50:35", "text": "工場を建設したいですか？それから私は"}, {"type": "subtitle", "time": 6638.03, "timestamp": "01:50:38", "text": "クリエイティブモードを追加できます。"}, {"type": "subtitle", "time": 6647.43, "timestamp": "01:50:47", "text": "でもそれは新しい解釈のようなものになるでしょう"}, {"type": "subtitle", "time": 6648.99, "timestamp": "01:50:48", "text": "マインクラフト I"}, {"type": "subtitle", "time": 6652.35, "timestamp": "01:50:52", "text": "推測。ああ、"}, {"type": "subtitle", "time": 6655.99, "timestamp": "01:50:55", "text": "神。これは一体何ですか？"}, {"type": "subtitle", "time": 6659.189, "timestamp": "01:50:59", "text": "また遅延が発生するだろう。うん、必要だ"}]
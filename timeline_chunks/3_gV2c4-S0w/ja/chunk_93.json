[{"type": "subtitle", "time": 5580.55, "timestamp": "01:33:00", "text": "雪が降るようなあの街とか何か"}, {"type": "subtitle", "time": 5584.07, "timestamp": "01:33:04", "text": "エリア右なので、まるで"}, {"type": "subtitle", "time": 5587.11, "timestamp": "01:33:07", "text": "道の石と、どの道を選ぶかのような"}, {"type": "subtitle", "time": 5589.55, "timestamp": "01:33:09", "text": "石に行きたいのですが、"}, {"type": "subtitle", "time": 5592.95, "timestamp": "01:33:12", "text": "そうすると、つまり、2つ余分に"}, {"type": "subtitle", "time": 5595.709, "timestamp": "01:33:15", "text": "必要ではないが"}, {"type": "subtitle", "time": 5611.39, "timestamp": "01:33:31", "text": "わかりました、ではその返品をする必要があります"}, {"type": "subtitle", "time": 5615.43, "timestamp": "01:33:35", "text": "石は幸せなもののようですが、"}, {"type": "subtitle", "time": 5617.55, "timestamp": "01:33:37", "text": "巻物を使う"}, {"type": "subtitle", "time": 5620.47, "timestamp": "01:33:40", "text": "魔法の力で私はそれを"}, {"type": "subtitle", "time": 5626.87, "timestamp": "01:33:46", "text": "家。ニース。"}]
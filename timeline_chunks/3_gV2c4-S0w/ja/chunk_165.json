[{"type": "subtitle", "time": 9902.71, "timestamp": "02:45:02", "text": "ジョー、寝るのは人間がすることだ。うん、君、君"}, {"type": "subtitle", "time": 9905.75, "timestamp": "02:45:05", "text": "男は冗談でしかそんなことを言うべきじゃない。"}, {"type": "subtitle", "time": 9907.75, "timestamp": "02:45:07", "text": "彼は生き延びた"}, {"type": "subtitle", "time": 9910.23, "timestamp": "02:45:10", "text": "昨晩まではそうだった。ええ、そうは思いません"}, {"type": "subtitle", "time": 9913.11, "timestamp": "02:45:13", "text": "保存。"}, {"type": "subtitle", "time": 9915.99, "timestamp": "02:45:15", "text": "彼は3時間睡眠で生き延びている。どうやって"}, {"type": "subtitle", "time": 9921.11, "timestamp": "02:45:21", "text": "いいね。私は本当に見つけたいと思った"}, {"type": "subtitle", "time": 9924.79, "timestamp": "02:45:24", "text": "みんなが楽しめる良いモードです。だから私は"}, {"type": "subtitle", "time": 9927.99, "timestamp": "02:45:27", "text": "どうやら私はここで文明を築いてしまったようだ。"}, {"type": "subtitle", "time": 9929.51, "timestamp": "02:45:29", "text": "文明？"}, {"type": "subtitle", "time": 9931.269, "timestamp": "02:45:31", "text": "ああ、俺は自分だけの文明を築き上げたんだ。"}, {"type": "subtitle", "time": 9933.51, "timestamp": "02:45:33", "text": "見る準備はできましたか？"}, {"type": "subtitle", "time": 9936.15, "timestamp": "02:45:36", "text": "ええ、準備はほぼできています。言いたいのは"}, {"type": "subtitle", "time": 9941.67, "timestamp": "02:45:41", "text": "何てことだ。"}, {"type": "subtitle", "time": 9944.389, "timestamp": "02:45:44", "text": "[音楽]"}, {"type": "chat", "time": 9944.961, "timestamp": "02:45:44", "author": "@tengenUzui_flashy1", "avatar": "https://yt4.ggpht.com/U4bubkmDa5_iTX7UhU8yE4NYF3WqbD1yjlX5vpRZK99vtN8boUL9ZV-pbM8qJhCV69RI6ILr=s64-c-k-c0x00ffffff-no-rj", "message": "@Sasta Chamgadar"}, {"type": "subtitle", "time": 9947.03, "timestamp": "02:45:47", "text": "私は何をしますか？何てことだ。私は何をしますか？私"}, {"type": "subtitle", "time": 9949.429, "timestamp": "02:45:49", "text": "したい"}, {"type": "subtitle", "time": 9953.83, "timestamp": "02:45:53", "text": "うちにおいで。本当に私に決めてくれるの？"}, {"type": "chat", "time": 9955.507, "timestamp": "02:45:55", "author": "@redx7454", "avatar": "https://yt4.ggpht.com/ZnCeavb1XjhCUyF0gPZf2zqHWkwDjnzleyD1oxpd-9re-emmqNet6n-8w_OiHe_rvcNpzZPLgw=s64-c-k-c0x00ffffff-no-rj", "message": "saii aagaya?"}, {"type": "subtitle", "time": 9955.51, "timestamp": "02:45:55", "text": "あのね、知ってる？いいえ、あなた、あなた"}, {"type": "subtitle", "time": 9957.75, "timestamp": "02:45:57", "text": "待って。彼女に見せてあげましょう。うん。うん。"}]
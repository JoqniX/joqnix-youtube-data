[{"type": "subtitle", "time": 19501.83, "timestamp": "05:25:01", "text": "本当にやりたかったことは、以前は制限していた"}, {"type": "subtitle", "time": 19503.59, "timestamp": "05:25:03", "text": "ああ、高くないって自分で言ってる"}, {"type": "subtitle", "time": 19506.31, "timestamp": "05:25:06", "text": "十分な品質の商品です。以前は走るのが好きだった"}, {"type": "subtitle", "time": 19509.27, "timestamp": "05:25:09", "text": "そこから離れて。だから私はこれを使っています"}, {"type": "subtitle", "time": 19512.99, "timestamp": "05:25:12", "text": "ジョッカソンをゆっくりと好きになる方法として"}, {"type": "subtitle", "time": 19515.51, "timestamp": "05:25:15", "text": "ゆっくりと、本当にやりたかったことをする"}, {"type": "subtitle", "time": 19519.27, "timestamp": "05:25:19", "text": "行動を起こし、自分自身にもっと自信を持つ"}, {"type": "subtitle", "time": 19520.868, "timestamp": "05:25:20", "text": "実は"}, {"type": "subtitle", "time": 19524.91, "timestamp": "05:25:24", "text": "ええ、実際に私の"}, {"type": "subtitle", "time": 19527.868, "timestamp": "05:25:27", "text": "コミュニティを適切に"}, {"type": "subtitle", "time": 19531.43, "timestamp": "05:25:31", "text": "すべて。こんにちは、あなたは、えーと"}, {"type": "subtitle", "time": 19533.03, "timestamp": "05:25:33", "text": "あなたは話すのに苦労するでしょう"}, {"type": "subtitle", "time": 19534.27, "timestamp": "05:25:34", "text": "で"}, {"type": "subtitle", "time": 19537.75, "timestamp": "05:25:37", "text": "日本。何とかします。覚えておいて、私は行く"}, {"type": "subtitle", "time": 19541.19, "timestamp": "05:25:41", "text": "日本語を勉強するためにそこへ行くんですよね？それ"}, {"type": "subtitle", "time": 19550.708, "timestamp": "05:25:50", "text": "大丈夫。良い結果になることを願っています。私は信じている"}, {"type": "subtitle", "time": 19555.39, "timestamp": "05:25:55", "text": "自分自身。"}, {"type": "subtitle", "time": 19558.15, "timestamp": "05:25:58", "text": "うん。 3週間後か"}]
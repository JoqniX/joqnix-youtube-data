[{"type": "subtitle", "time": 1871.95, "timestamp": "00:31:11", "text": "[音楽]"}, {"type": "subtitle", "time": 1876.149, "timestamp": "00:31:16", "text": "えっと、３つのことをしてください。えっと、一つは胸です"}, {"type": "subtitle", "time": 1878.59, "timestamp": "00:31:18", "text": "胸の部分だけです。リボンを追加しました"}, {"type": "subtitle", "time": 1883.149, "timestamp": "00:31:23", "text": "胸。えっと、"}, {"type": "subtitle", "time": 1891.909, "timestamp": "00:31:31", "text": "えっと、弓と胸とヒーターみたいなやつ。"}, {"type": "subtitle", "time": 1896.23, "timestamp": "00:31:36", "text": "３つのこと。そして、あなたにいくつか入れてほしい"}, {"type": "subtitle", "time": 1899.35, "timestamp": "00:31:39", "text": "農作物とかそういうもの。作物を栽培するか、"}, {"type": "subtitle", "time": 1901.59, "timestamp": "00:31:41", "text": "何か、または何かの匂いがする、または"}, {"type": "subtitle", "time": 1904.549, "timestamp": "00:31:44", "text": "何か。そして、かなり遠くまで行かなければならない"}, {"type": "subtitle", "time": 1909.11, "timestamp": "00:31:49", "text": "遠くから見て、もしそうなら"}, {"type": "subtitle", "time": 1911.99, "timestamp": "00:31:51", "text": "製錬を終える、または栽培する"}, {"type": "subtitle", "time": 1915.75, "timestamp": "00:31:55", "text": "作物のやつ。本当に遠い、つまり遠く"}, {"type": "subtitle", "time": 1918.31, "timestamp": "00:31:58", "text": "遠く離れた。すごく遠い。シミュレーション"}]
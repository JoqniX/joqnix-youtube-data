[{"type": "subtitle", "time": 10380.87, "timestamp": "02:53:00", "text": "こんにちは。"}, {"type": "subtitle", "time": 10384.87, "timestamp": "02:53:04", "text": "自分が迷子になるなんて、とても辛い。"}, {"type": "subtitle", "time": 10386.95, "timestamp": "02:53:06", "text": "もし私が正しければ、石炭を置いたら、"}, {"type": "subtitle", "time": 10396.95, "timestamp": "02:53:16", "text": "上。ヒータ。"}, {"type": "subtitle", "time": 10399.03, "timestamp": "02:53:19", "text": "何てことだ。あなたの調理器具とあなたの"}, {"type": "chat", "time": 10405.42, "timestamp": "02:53:25", "author": "@RPGfanatic-i3z", "avatar": "https://yt4.ggpht.com/F9kA73IKR7TCeh1WUg7fNOkjcUJ6lPk8I6j69xenF_vJcjZ4GCnCIeYo88hJF8jUU3OAOsYG=s64-c-k-c0x00ffffff-no-rj", "message": "like karwaoo stream bhai ki"}, {"type": "subtitle", "time": 10405.83, "timestamp": "02:53:25", "text": "私の調理用ヒーター。"}, {"type": "chat", "time": 10406.313, "timestamp": "02:53:26", "author": "@BRUCELEE-wt7hk", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kywKa6HSckNVxhER8qedLRRVkcGIqFFytjQHe-071HyMo=s64-c-k-c0x00ffffff-no-rj", "message": "like the stream chat otherwise this 🕷 will Crawl all over you"}, {"type": "subtitle", "time": 10409.99, "timestamp": "02:53:29", "text": "彼女は誘惑の正体を知らない。わかった。うん。"}, {"type": "subtitle", "time": 10412.15, "timestamp": "02:53:32", "text": "何？"}, {"type": "subtitle", "time": 10417.79, "timestamp": "02:53:37", "text": "そこで、モードを設定しようとしました"}, {"type": "subtitle", "time": 10420.03, "timestamp": "02:53:40", "text": "太陽光発電"}, {"type": "subtitle", "time": 10423.269, "timestamp": "02:53:43", "text": "料理。つまり、石炭なしでは、"}, {"type": "subtitle", "time": 10426.309, "timestamp": "02:53:46", "text": "料理とか、そういうもの全部。"}, {"type": "subtitle", "time": 10434.15, "timestamp": "02:53:54", "text": "日光とアストラが偶然にも、これは"}, {"type": "subtitle", "time": 10436.309, "timestamp": "02:53:56", "text": "午前8時頃とか。私が"}]
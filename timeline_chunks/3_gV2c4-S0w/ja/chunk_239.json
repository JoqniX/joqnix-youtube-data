[{"type": "subtitle", "time": 14340.03, "timestamp": "03:59:00", "text": "まるで二重に聞こえるような感じ。"}, {"type": "subtitle", "time": 14342.63, "timestamp": "03:59:02", "text": "ごめん。ええ、すべてにおいて"}, {"type": "subtitle", "time": 14345.75, "timestamp": "03:59:05", "text": "これらのことについて私はとても混乱しています"}, {"type": "subtitle", "time": 14348.189, "timestamp": "03:59:08", "text": "スケジュール"}, {"type": "subtitle", "time": 14367.189, "timestamp": "03:59:27", "text": "ええ、まあ、ほとんど全部やりましたよ。えっと"}, {"type": "subtitle", "time": 14368.91, "timestamp": "03:59:28", "text": "残っているものは"}, {"type": "subtitle", "time": 14373.389, "timestamp": "03:59:33", "text": "する？ああ、パート2の配信"}, {"type": "subtitle", "time": 14380.87, "timestamp": "03:59:40", "text": "はい、パート2の配信です。そして私は信じています"}, {"type": "subtitle", "time": 14383.11, "timestamp": "03:59:43", "text": "パート1のストリームをダウンロード中です。 9％"}, {"type": "subtitle", "time": 14387.91, "timestamp": "03:59:47", "text": "終わり。いいぞ、いいぞ、いいぞ、いいぞ。スチーム。"}, {"type": "subtitle", "time": 14389.67, "timestamp": "03:59:49", "text": "ええ、ゲームをダウンロードしているところです。はい、"}, {"type": "subtitle", "time": 14390.67, "timestamp": "03:59:50", "text": "うん、"}, {"type": "subtitle", "time": 14394.15, "timestamp": "03:59:54", "text": "うん。ある政党から最新情報が届きました。もう諦めろ。"}, {"type": "subtitle", "time": 14395.63, "timestamp": "03:59:55", "text": "それもまた"}, {"type": "subtitle", "time": 14398.63, "timestamp": "03:59:58", "text": "私が望んでいたゲームのような良いお尻"}]
[{"type": "subtitle", "time": 3060.63, "timestamp": "00:51:00", "text": "アイデア、あなたは全く新しい"}, {"type": "subtitle", "time": 3064.03, "timestamp": "00:51:04", "text": "そこからのユニークなアイデアは、"}, {"type": "subtitle", "time": 3066.829, "timestamp": "00:51:06", "text": "クーラー。"}, {"type": "subtitle", "time": 3070.23, "timestamp": "00:51:10", "text": "いいえ。ええ。私はそれが好きです。だから私は"}, {"type": "subtitle", "time": 3073.15, "timestamp": "00:51:13", "text": "私は、見るたびに"}, {"type": "subtitle", "time": 3075.67, "timestamp": "00:51:15", "text": "友人が行ったコラボレーション、または"}, {"type": "subtitle", "time": 3079.75, "timestamp": "00:51:19", "text": "彼らはホスト役などを務めているのですが、私は"}, {"type": "subtitle", "time": 3083.51, "timestamp": "00:51:23", "text": "見てみて、観察して"}, {"type": "chat", "time": 3084.092, "timestamp": "00:51:24", "author": "@astravt", "avatar": "https://yt4.ggpht.com/MdOwC7qdh0gmlabcCYgLQ5BOZxo7CGLbc14xFv1rO9eQ745gkga99YKsszwMjcyNnEBittX8WA=s64-c-k-c0x00ffffff-no-rj", "message": "uk I was listening all of these while playing bg in background"}, {"type": "subtitle", "time": 3086.91, "timestamp": "00:51:26", "text": "ええ、彼らはこれをやっているのでしょうか"}, {"type": "subtitle", "time": 3089.19, "timestamp": "00:51:29", "text": "すべて私が知っているように、彼らは"}, {"type": "subtitle", "time": 3091.43, "timestamp": "00:51:31", "text": "現実世界では忙しくて、彼らは"}, {"type": "subtitle", "time": 3094.309, "timestamp": "00:51:34", "text": "コラボがうまくいくようにして"}, {"type": "subtitle", "time": 3096.349, "timestamp": "00:51:36", "text": "初めての仕事だから、何でもする"}, {"type": "subtitle", "time": 3099.75, "timestamp": "00:51:39", "text": "などなど。そうですよね？だから私はためらわない"}, {"type": "subtitle", "time": 3102.79, "timestamp": "00:51:42", "text": "知ってるでしょ、もし私が望めば、"}, {"type": "subtitle", "time": 3108.23, "timestamp": "00:51:48", "text": "ただぼんやり座って何もしないで"}, {"type": "subtitle", "time": 3111.91, "timestamp": "00:51:51", "text": "えーと、ある意味ゲストとして参加して"}, {"type": "subtitle", "time": 3114.549, "timestamp": "00:51:54", "text": "コラボパートナーは、"}, {"type": "subtitle", "time": 3116.79, "timestamp": "00:51:56", "text": "コラボホストはコラボのすべてを行います"}, {"type": "subtitle", "time": 3118.829, "timestamp": "00:51:58", "text": "仲間たちはPNGを送ってきて、私は自分の"}]
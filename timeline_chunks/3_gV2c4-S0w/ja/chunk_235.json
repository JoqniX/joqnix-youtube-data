[{"type": "subtitle", "time": 14111.59, "timestamp": "03:55:11", "text": "[音楽]"}, {"type": "subtitle", "time": 14114.07, "timestamp": "03:55:14", "text": "なぜ私はTwitterを見ているのだろうか？私にやらせてください"}, {"type": "subtitle", "time": 14117.349, "timestamp": "03:55:17", "text": "自分のことをして、寝ます。さて、今日の"}, {"type": "subtitle", "time": 14119.269, "timestamp": "03:55:19", "text": "あれのことですよね？要約を書こう"}, {"type": "subtitle", "time": 14130.07, "timestamp": "03:55:30", "text": "62日目。今日は62日目です。私たちはプレイしました"}, {"type": "subtitle", "time": 14132.03, "timestamp": "03:55:32", "text": "えーと"}, {"type": "subtitle", "time": 14134.269, "timestamp": "03:55:34", "text": "土地。私は自分の"}, {"type": "subtitle", "time": 14137.309, "timestamp": "03:55:37", "text": "ベスト"}, {"type": "subtitle", "time": 14140.63, "timestamp": "03:55:40", "text": "探索する 探索する"}, {"type": "subtitle", "time": 14143.389, "timestamp": "03:55:43", "text": "えーと世界 えーと世界"}, {"type": "subtitle", "time": 14145.55, "timestamp": "03:55:45", "text": "その"}, {"type": "subtitle", "time": 14149.79, "timestamp": "03:55:49", "text": "地域/地図 私は"}, {"type": "subtitle", "time": 14156.67, "timestamp": "03:55:56", "text": "中。それは、えっと、少し"}, {"type": "subtitle", "time": 14159.429, "timestamp": "03:55:59", "text": "気が遠くなるほどだ。 「daunting」という単語は適切ですか？"}]
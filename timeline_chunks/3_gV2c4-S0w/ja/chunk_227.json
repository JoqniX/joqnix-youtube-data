[{"type": "subtitle", "time": 13623.389, "timestamp": "03:47:03", "text": "タイトル付け。ああ、ブラウザ。ああ、ブラウザ"}, {"type": "subtitle", "time": 13627.309, "timestamp": "03:47:07", "text": "できなかった。これは、"}, {"type": "subtitle", "time": 13630.07, "timestamp": "03:47:10", "text": "応用。つまり、このアプリケーションは"}, {"type": "subtitle", "time": 13632.15, "timestamp": "03:47:12", "text": "いいんだけど、いざとなると"}, {"type": "subtitle", "time": 13636.63, "timestamp": "03:47:16", "text": "CPUとGPUの使用率を非常に多く使用して"}, {"type": "subtitle", "time": 13638.59, "timestamp": "03:47:18", "text": "それで"}, {"type": "subtitle", "time": 13641.71, "timestamp": "03:47:21", "text": "エンコードは"}, {"type": "subtitle", "time": 13645.189, "timestamp": "03:47:25", "text": "痛み。彼らが気に入ってくれるといいな、そう願ってる"}, {"type": "subtitle", "time": 13647.59, "timestamp": "03:47:27", "text": "他のアプリケーションと同じ"}, {"type": "subtitle", "time": 13648.75, "timestamp": "03:47:28", "text": "私は"}, {"type": "subtitle", "time": 13658.03, "timestamp": "03:47:38", "text": "エンコードする必要はありません"}, {"type": "subtitle", "time": 13660.55, "timestamp": "03:47:40", "text": "ビデオ全体を再エンコードする場合は、"}, {"type": "subtitle", "time": 13663.11, "timestamp": "03:47:43", "text": "切り分けたり分割したりして"}, {"type": "subtitle", "time": 13673.469, "timestamp": "03:47:53", "text": "うん。えっと、ちょっと専門的すぎますか？"}, {"type": "subtitle", "time": 13675.87, "timestamp": "03:47:55", "text": "今？私はとても頭がいい"}, {"type": "subtitle", "time": 13679.63, "timestamp": "03:47:59", "text": "死んでるから、自分が何者なのかわからない"}]
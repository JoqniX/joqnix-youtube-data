[{"type": "subtitle", "time": 19142.27, "timestamp": "05:19:02", "text": "亡くなった。それはあまりにも"}, {"type": "subtitle", "time": 19147.07, "timestamp": "05:19:07", "text": "多くの。私には荷が重すぎた。私"}, {"type": "subtitle", "time": 19149.708, "timestamp": "05:19:09", "text": "できなかった できなかった"}, {"type": "subtitle", "time": 19153.31, "timestamp": "05:19:13", "text": "窒息しそうだった私の脳全体が私は私"}, {"type": "subtitle", "time": 19157.67, "timestamp": "05:19:17", "text": "今、病気で寝ています。おお、"}, {"type": "subtitle", "time": 19161.03, "timestamp": "05:19:21", "text": "2回に分けて睡眠をとる。よし、じゃあ4"}, {"type": "subtitle", "time": 19163.99, "timestamp": "05:19:23", "text": "それぞれ1時間ずつですよね？私はそうすべきだと思う"}, {"type": "subtitle", "time": 19166.07, "timestamp": "05:19:26", "text": "でも、私がストリーミングしているのは"}, {"type": "subtitle", "time": 19169.67, "timestamp": "05:19:29", "text": "24時間経過しました。だから、別れる必要があるかもしれない"}, {"type": "subtitle", "time": 19171.99, "timestamp": "05:19:31", "text": "それを2つに分けます。2時間2時間"}, {"type": "subtitle", "time": 19175.27, "timestamp": "05:19:35", "text": "たぶん、あるいは分からない。"}, {"type": "subtitle", "time": 19177.59, "timestamp": "05:19:37", "text": "私は実際に直さなければならない"}, {"type": "subtitle", "time": 19180.03, "timestamp": "05:19:40", "text": "スケジュール。このまま行けば、"}, {"type": "subtitle", "time": 19184.31, "timestamp": "05:19:44", "text": "すごく不健康で疲れているし、"}, {"type": "subtitle", "time": 19187.59, "timestamp": "05:19:47", "text": "健康状態が悪化するだろう。ええ、めったに来ません"}, {"type": "subtitle", "time": 19189.99, "timestamp": "05:19:49", "text": "自分を責める。私は主にTwitchで活動しています。"}, {"type": "subtitle", "time": 19195.99, "timestamp": "05:19:55", "text": "ニース。 VTuberのセクションに来ました。それで、"}, {"type": "subtitle", "time": 19197.83, "timestamp": "05:19:57", "text": "フォルダを低から高に変更しました"}]
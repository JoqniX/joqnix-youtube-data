[{"type": "subtitle", "time": 2461.109, "timestamp": "00:41:01", "text": "そして彼は私に質問したが、"}, {"type": "subtitle", "time": 2464.23, "timestamp": "00:41:04", "text": "私にとっては、本当に楽しんでいます"}, {"type": "subtitle", "time": 2467.51, "timestamp": "00:41:07", "text": "話しながら、原神をプレイしました"}, {"type": "subtitle", "time": 2471.589, "timestamp": "00:41:11", "text": "その日は2時間以上かかり、彼は"}, {"type": "subtitle", "time": 2473.829, "timestamp": "00:41:13", "text": "ジョギングするように言われた"}, {"type": "subtitle", "time": 2475.95, "timestamp": "00:41:15", "text": "到達レベル"}, {"type": "subtitle", "time": 2477.47, "timestamp": "00:41:17", "text": "えっと"}, {"type": "subtitle", "time": 2481.109, "timestamp": "00:41:21", "text": "45か4か30くらいだった。"}, {"type": "subtitle", "time": 2483.99, "timestamp": "00:41:23", "text": "ゲンチンは当時アジアサーバーで"}, {"type": "subtitle", "time": 2487.03, "timestamp": "00:41:27", "text": "私はとても初心者だったので、たくさんのことをしなければなりませんでした"}, {"type": "subtitle", "time": 2489.43, "timestamp": "00:41:29", "text": "コラボレーションをするためだけにコラボレーションをしない"}, {"type": "subtitle", "time": 2491.75, "timestamp": "00:41:31", "text": "ヴィックのためだけでなく、他のユーチューバーのためにも"}, {"type": "subtitle", "time": 2493.589, "timestamp": "00:41:33", "text": "アジアサーバーにあったため"}, {"type": "subtitle", "time": 2496.79, "timestamp": "00:41:36", "text": "原神。私がヨーロッパにいたとき、"}, {"type": "subtitle", "time": 2499.55, "timestamp": "00:41:39", "text": "ゲームが発売されました"}, {"type": "subtitle", "time": 2504.069, "timestamp": "00:41:44", "text": "初め。そう、私は大きな決断をした"}, {"type": "subtitle", "time": 2505.91, "timestamp": "00:41:45", "text": "アジアサーバーに切り替えると、"}, {"type": "subtitle", "time": 2509.55, "timestamp": "00:41:49", "text": "人生で最高の決断だった。そして"}, {"type": "subtitle", "time": 2513.19, "timestamp": "00:41:53", "text": "ええ、楽しかったですよ。楽しかったです"}, {"type": "subtitle", "time": 2515.829, "timestamp": "00:41:55", "text": "まるで最初の出会いのようだった。いいえ、"}, {"type": "subtitle", "time": 2518.71, "timestamp": "00:41:58", "text": "私たちは一緒に時間を過ごした。私たちは妻の様子を確認しました"}]
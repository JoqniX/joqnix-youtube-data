[{"type": "subtitle", "time": 841.15, "timestamp": "00:14:01", "text": "新しい人に連絡を取ろうとした"}, {"type": "subtitle", "time": 844.47, "timestamp": "00:14:04", "text": "人々。うん。接続されたとき、"}, {"type": "subtitle", "time": 847.43, "timestamp": "00:14:07", "text": "ずっと繋がりを持ちたいと思っていたんですよね？"}, {"type": "subtitle", "time": 850.269, "timestamp": "00:14:10", "text": "ジョアソンを始めたときのように、私は主に"}, {"type": "subtitle", "time": 853.189, "timestamp": "00:14:13", "text": "コラボレーションをしたいと言った"}, {"type": "subtitle", "time": 854.99, "timestamp": "00:14:14", "text": "クリエイターと"}, {"type": "subtitle", "time": 857.91, "timestamp": "00:14:17", "text": "私が大切にしていた友人たち"}, {"type": "subtitle", "time": 860.069, "timestamp": "00:14:20", "text": "コラボレーションしたことがある、"}, {"type": "subtitle", "time": 861.91, "timestamp": "00:14:21", "text": "私がこれまで築いてきたすべてのつながり"}, {"type": "subtitle", "time": 864.71, "timestamp": "00:14:24", "text": "この旅。それが私が"}, {"type": "subtitle", "time": 867.35, "timestamp": "00:14:27", "text": "ジャカタンとのコラボレーションみたいなことをやってる"}, {"type": "subtitle", "time": 870.87, "timestamp": "00:14:30", "text": "ジャカタン期間中、私はいつもここにいます"}, {"type": "subtitle", "time": 873.67, "timestamp": "00:14:33", "text": "ただ最善を尽くしているだけです。私は"}, {"type": "subtitle", "time": 877.189, "timestamp": "00:14:37", "text": "お金、あるいは金銭的な利益など。えっと"}, {"type": "subtitle", "time": 879.829, "timestamp": "00:14:39", "text": "えーっと、やらないように、やらないように"}, {"type": "subtitle", "time": 882.269, "timestamp": "00:14:42", "text": "金銭的な利益を期待した協力関係"}, {"type": "subtitle", "time": 886.23, "timestamp": "00:14:46", "text": "得。うまくいかないだろう。私は感じないだろう"}, {"type": "subtitle", "time": 890.67, "timestamp": "00:14:50", "text": "私もそれを嬉しく思っています。ええ、そうですね。"}, {"type": "subtitle", "time": 894.47, "timestamp": "00:14:54", "text": "そう、それで、あなたが尋ねたとき"}, {"type": "subtitle", "time": 897.43, "timestamp": "00:14:57", "text": "コラボレーションと私が与えたすべてについて"}]
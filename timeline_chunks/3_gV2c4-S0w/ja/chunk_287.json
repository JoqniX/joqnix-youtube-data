[{"type": "subtitle", "time": 17221.55, "timestamp": "04:47:01", "text": "他のストリーマーをもっと訓練する"}, {"type": "subtitle", "time": 17226.628, "timestamp": "04:47:06", "text": "真剣な話もあるけど、あとはえっと"}, {"type": "subtitle", "time": 17228.628, "timestamp": "04:47:08", "text": "私は理解できなかったし"}, {"type": "subtitle", "time": 17232.868, "timestamp": "04:47:12", "text": "理解する、なぜあなたは"}, {"type": "subtitle", "time": 17235.03, "timestamp": "04:47:15", "text": "ほら、まるで"}, {"type": "subtitle", "time": 17239.43, "timestamp": "04:47:19", "text": "この形式のように考えてください。わかった。のように"}, {"type": "subtitle", "time": 17242.23, "timestamp": "04:47:22", "text": "えっと、あなたは友達になりたかったの？"}, {"type": "subtitle", "time": 17244.23, "timestamp": "04:47:24", "text": "あなたは友達を作りたかったのですね。近づく"}, {"type": "subtitle", "time": 17247.03, "timestamp": "04:47:27", "text": "友達が承認する"}, {"type": "subtitle", "time": 17249.11, "timestamp": "04:47:29", "text": "友達になるのは"}, {"type": "subtitle", "time": 17251.75, "timestamp": "04:47:31", "text": "すぐ。今は時間がかかる。いいえ。しかし、それは"}, {"type": "subtitle", "time": 17254.11, "timestamp": "04:47:34", "text": "のような人"}, {"type": "subtitle", "time": 17257.51, "timestamp": "04:47:37", "text": "えっと、あなたを名指しで非難したり、こう言ったりする"}, {"type": "subtitle", "time": 17259.91, "timestamp": "04:47:39", "text": "あなたたちはみんなボディシェイミングが好き"}, {"type": "subtitle", "time": 17261.35, "timestamp": "04:47:41", "text": "君はまるでオタクか何かみたいだね。私"}, {"type": "subtitle", "time": 17263.11, "timestamp": "04:47:43", "text": "オタクと友達になりたくない、"}, {"type": "subtitle", "time": 17265.83, "timestamp": "04:47:45", "text": "何か。そんな感じだった。私は"}, {"type": "subtitle", "time": 17274.55, "timestamp": "04:47:54", "text": "おお。わからない。でも、なんだか"}, {"type": "subtitle", "time": 17276.27, "timestamp": "04:47:56", "text": "ちょっと変"}, {"type": "subtitle", "time": 17278.47, "timestamp": "04:47:58", "text": "だから私はそれが引き金になると言うのです"}]
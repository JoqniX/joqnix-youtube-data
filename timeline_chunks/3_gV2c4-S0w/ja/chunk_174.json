[{"type": "subtitle", "time": 10440.389, "timestamp": "02:54:00", "text": "起きていた。あれは本当に"}, {"type": "subtitle", "time": 10443.71, "timestamp": "02:54:03", "text": "冗談でソーラーを追加"}, {"type": "subtitle", "time": 10448.23, "timestamp": "02:54:08", "text": "調理器具だったが、それも詐欺だった。そうではなかった"}, {"type": "subtitle", "time": 10452.07, "timestamp": "02:54:12", "text": "ええと、私がそうすべきだと思ったことをすれば"}, {"type": "subtitle", "time": 10455.67, "timestamp": "02:54:15", "text": "見て、とても綺麗だよ"}, {"type": "subtitle", "time": 10458.469, "timestamp": "02:54:18", "text": "夜。この景色を見てください。何てことだ。"}, {"type": "subtitle", "time": 10460.91, "timestamp": "02:54:20", "text": "まるで妖精みたい"}, {"type": "subtitle", "time": 10464.469, "timestamp": "02:54:24", "text": "土地。おお。あの木を見てください。それはとても"}, {"type": "chat", "time": 10465.509, "timestamp": "02:54:25", "author": "@tengenUzui_flashy1", "avatar": "https://yt4.ggpht.com/U4bubkmDa5_iTX7UhU8yE4NYF3WqbD1yjlX5vpRZK99vtN8boUL9ZV-pbM8qJhCV69RI6ILr=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/JAJ1XpGpJYnW8wTupZu4Cw"}, {"type": "subtitle", "time": 10466.79, "timestamp": "02:54:26", "text": "かわいい。"}, {"type": "subtitle", "time": 10469.83, "timestamp": "02:54:29", "text": "[音楽]"}, {"type": "subtitle", "time": 10472.55, "timestamp": "02:54:32", "text": "そして私のシェーダー。完全に"}, {"type": "subtitle", "time": 10474.389, "timestamp": "02:54:34", "text": "かわいい。"}, {"type": "subtitle", "time": 10476.309, "timestamp": "02:54:36", "text": "うん。あのね？私はそうすべきだと思う"}, {"type": "subtitle", "time": 10479.11, "timestamp": "02:54:39", "text": "私はこの城を"}, {"type": "subtitle", "time": 10481.75, "timestamp": "02:54:41", "text": "マンダイ。うん。"}, {"type": "subtitle", "time": 10492.11, "timestamp": "02:54:52", "text": "それは"}, {"type": "subtitle", "time": 10496.389, "timestamp": "02:54:56", "text": "壁。いやいや"}]
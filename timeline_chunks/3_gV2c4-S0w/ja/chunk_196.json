[{"type": "subtitle", "time": 11761.429, "timestamp": "03:16:01", "text": "おお。しかもアニメーション機能も付いています。おお。何？"}, {"type": "subtitle", "time": 11764.389, "timestamp": "03:16:04", "text": "なんてこった？ああ、時間がかかる"}, {"type": "subtitle", "time": 11767.75, "timestamp": "03:16:07", "text": "読み込むチャンクが多いんですね？"}, {"type": "subtitle", "time": 11770.95, "timestamp": "03:16:10", "text": "わかったよ、ジョー。じゃあ、行くね。楽しんでください。私"}, {"type": "subtitle", "time": 11773.75, "timestamp": "03:16:13", "text": "今日は早く寝ないと。おお、"}, {"type": "subtitle", "time": 11777.51, "timestamp": "03:16:17", "text": "あなたは眠るでしょう。ああ、それは"}, {"type": "subtitle", "time": 11780.63, "timestamp": "03:16:20", "text": "ジョー、あなたも寝た方がいいよ。あなた"}, {"type": "subtitle", "time": 11783.99, "timestamp": "03:16:23", "text": "より良い睡眠。"}, {"type": "subtitle", "time": 11786.87, "timestamp": "03:16:26", "text": "今すぐ寝た方がいいよ。右"}, {"type": "subtitle", "time": 11790.309, "timestamp": "03:16:30", "text": "今？何だって？"}, {"type": "subtitle", "time": 11799.79, "timestamp": "03:16:39", "text": "たくさん"}, {"type": "subtitle", "time": 11803.67, "timestamp": "03:16:43", "text": "見つけると思う"}, {"type": "subtitle", "time": 11807.91, "timestamp": "03:16:47", "text": "気が散らなければ。うん。"}, {"type": "subtitle", "time": 11815.67, "timestamp": "03:16:55", "text": "どうなるか見てみよう。"}, {"type": "subtitle", "time": 11818.95, "timestamp": "03:16:58", "text": "ええ、でも私は死にかけているんです。ただ願うしかない。"}]
[{"type": "subtitle", "time": 17940.31, "timestamp": "04:59:00", "text": "視聴回数は増えましたか？何人"}, {"type": "subtitle", "time": 17943.03, "timestamp": "04:59:03", "text": "楽しんでいただけましたか？人々は去ったのか？"}, {"type": "subtitle", "time": 17944.788, "timestamp": "04:59:04", "text": "その他、その他。いいえ。"}, {"type": "subtitle", "time": 17946.948, "timestamp": "04:59:06", "text": "彼らが持っている場合、私が持っている場合も同様です"}, {"type": "subtitle", "time": 17949.67, "timestamp": "04:59:09", "text": "私のチャンネルに彼らを登場させると、彼らは"}, {"type": "subtitle", "time": 17953.51, "timestamp": "04:59:13", "text": "私の分析的な作業においても同様です。方法ではなく"}, {"type": "subtitle", "time": 17956.19, "timestamp": "04:59:16", "text": "何人が見るだろうか"}, {"type": "subtitle", "time": 17961.708, "timestamp": "04:59:21", "text": "何人が彼らを観たのか"}, {"type": "subtitle", "time": 17964.788, "timestamp": "04:59:24", "text": "だって彼らは私と一緒に配信してたし、などなど。"}, {"type": "subtitle", "time": 17968.788, "timestamp": "04:59:28", "text": "そんな感じ。私は「うん、"}, {"type": "subtitle", "time": 17971.99, "timestamp": "04:59:31", "text": "今は私が"}, {"type": "subtitle", "time": 17975.91, "timestamp": "04:59:35", "text": "トランザクションタイプのコラボレーションを受け入れる"}, {"type": "subtitle", "time": 17977.628, "timestamp": "04:59:37", "text": "私はまだ"}, {"type": "subtitle", "time": 17981.51, "timestamp": "04:59:41", "text": "初心者で、まだそれほどでもない"}, {"type": "subtitle", "time": 17983.43, "timestamp": "04:59:43", "text": "プロフェッショナルでありながらも。たくさんのものがあります"}, {"type": "subtitle", "time": 17984.75, "timestamp": "04:59:44", "text": "私はできる"}, {"type": "subtitle", "time": 17996.948, "timestamp": "04:59:56", "text": "ええ、運命づけられています。うん。"}]
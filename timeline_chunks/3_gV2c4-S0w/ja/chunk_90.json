[{"type": "subtitle", "time": 5402.43, "timestamp": "01:30:02", "text": "AFK（離席中）と、そのAFK時間"}, {"type": "subtitle", "time": 5404.83, "timestamp": "01:30:04", "text": "のために。"}, {"type": "subtitle", "time": 5415.709, "timestamp": "01:30:15", "text": "これはクライアント側モードです。"}, {"type": "subtitle", "time": 5434.27, "timestamp": "01:30:34", "text": "[音楽]"}, {"type": "subtitle", "time": 5437.75, "timestamp": "01:30:37", "text": "エンティティレーダー、ミニマップを無効にすると良いですね。"}, {"type": "subtitle", "time": 5441.229, "timestamp": "01:30:41", "text": "その他、競争的なプレイを行うために"}, {"type": "subtitle", "time": 5451.4, "timestamp": "01:30:51", "text": "何が"}, {"type": "subtitle", "time": 5452.75, "timestamp": "01:30:52", "text": "[音楽]"}, {"type": "subtitle", "time": 5456.07, "timestamp": "01:30:56", "text": "無駄。ああ、その能力が欲しいですか？"}, {"type": "subtitle", "time": 5459.83, "timestamp": "01:30:59", "text": "道標を持っている？"}]
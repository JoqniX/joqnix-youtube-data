[{"type": "subtitle", "time": 6300.629, "timestamp": "01:45:00", "text": "専用の新しいサーバーをリリース"}, {"type": "subtitle", "time": 6303.03, "timestamp": "01:45:03", "text": "生涯にわたる才能。それから私は"}, {"type": "subtitle", "time": 6304.709, "timestamp": "01:45:04", "text": "何が起こったのか疑問に思う"}, {"type": "subtitle", "time": 6308.07, "timestamp": "01:45:08", "text": "ホリデーライフの古いサーバー？彼らは成功したのか"}, {"type": "subtitle", "time": 6311.669, "timestamp": "01:45:11", "text": "他の人にも利用可能ですか？"}, {"type": "subtitle", "time": 6314.31, "timestamp": "01:45:14", "text": "それは実際に起こったのですか？"}, {"type": "subtitle", "time": 6316.79, "timestamp": "01:45:16", "text": "ああ、彼らは最新の"}, {"type": "subtitle", "time": 6318.79, "timestamp": "01:45:18", "text": "マインクラフトのバージョン。彼らは"}, {"type": "subtitle", "time": 6321.35, "timestamp": "01:45:21", "text": "その古いバージョンのMinecraft"}, {"type": "subtitle", "time": 6322.109, "timestamp": "01:45:22", "text": "古い"}, {"type": "subtitle", "time": 6329.27, "timestamp": "01:45:29", "text": "今はサーバーに参加したくありません。"}, {"type": "subtitle", "time": 6331.99, "timestamp": "01:45:31", "text": "再び遅延する可能性がある"}, {"type": "subtitle", "time": 6334.39, "timestamp": "01:45:34", "text": "デメリットは何も変更しないでください"}, {"type": "subtitle", "time": 6341.51, "timestamp": "01:45:41", "text": "興味を維持するように努めてください"}, {"type": "subtitle", "time": 6343.669, "timestamp": "01:45:43", "text": "マインクラフト。コラボレーションクラブとして最適だ。"}, {"type": "subtitle", "time": 6345.149, "timestamp": "01:45:45", "text": "しかし"}, {"type": "subtitle", "time": 6347.83, "timestamp": "01:45:47", "text": "手に新しいサーバーを持つmosa"}]
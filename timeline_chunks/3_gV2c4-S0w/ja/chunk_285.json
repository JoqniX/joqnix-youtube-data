[{"type": "subtitle", "time": 17101.47, "timestamp": "04:45:01", "text": "私に返信するメッセージ"}, {"type": "subtitle", "time": 17102.99, "timestamp": "04:45:02", "text": "英語。"}, {"type": "subtitle", "time": 17107.948, "timestamp": "04:45:07", "text": "えっと、たとえ私が"}, {"type": "subtitle", "time": 17110.628, "timestamp": "04:45:10", "text": "翻訳の問題なので説明しました"}, {"type": "subtitle", "time": 17112.43, "timestamp": "04:45:12", "text": "あなたが尋ねるとき"}, {"type": "subtitle", "time": 17116.47, "timestamp": "04:45:16", "text": "それだけですか？いいえ、それは人によります"}, {"type": "subtitle", "time": 17120.03, "timestamp": "04:45:20", "text": "今はサイズも重要ですよね？"}, {"type": "subtitle", "time": 17123.27, "timestamp": "04:45:23", "text": "私が尋ねたユーチューバーの半分のように、"}, {"type": "subtitle", "time": 17125.19, "timestamp": "04:45:25", "text": "過去にコラボレーションしたことがある。全員"}, {"type": "subtitle", "time": 17129.43, "timestamp": "04:45:29", "text": "彼らはどのように"}, {"type": "subtitle", "time": 17131.47, "timestamp": "04:45:31", "text": "彼らのコラボレーションへのアプローチは"}, {"type": "subtitle", "time": 17134.788, "timestamp": "04:45:34", "text": "取引的であり、彼らはそれを"}, {"type": "subtitle", "time": 17137.27, "timestamp": "04:45:37", "text": "真剣なビジネス方法で"}, {"type": "subtitle", "time": 17141.11, "timestamp": "04:45:41", "text": "利益をもたらすか、"}, {"type": "subtitle", "time": 17143.99, "timestamp": "04:45:43", "text": "コラボレーションまたは"}, {"type": "subtitle", "time": 17146.31, "timestamp": "04:45:46", "text": "もし彼らがあなたのチャンネルにいるなら、"}, {"type": "subtitle", "time": 17149.91, "timestamp": "04:45:49", "text": "あの真剣な表情。残りは"}, {"type": "subtitle", "time": 17153.19, "timestamp": "04:45:53", "text": "そうだね、もし私たちがお互いを知っていたら、もし私たちが"}, {"type": "subtitle", "time": 17157.35, "timestamp": "04:45:57", "text": "いい雰囲気があれば、"}, {"type": "subtitle", "time": 17158.51, "timestamp": "04:45:58", "text": "それは何と呼ばれますか？"}]
[{"type": "subtitle", "time": 13440.229, "timestamp": "03:44:00", "text": "今日は数件の事故がありました。のように"}, {"type": "subtitle", "time": 13444.15, "timestamp": "03:44:04", "text": "今日、配信が止まったんですよね？うん。"}, {"type": "subtitle", "time": 13447.11, "timestamp": "03:44:07", "text": "明らかにクラッシュした。ああ、今日はその日だった"}, {"type": "subtitle", "time": 13449.429, "timestamp": "03:44:09", "text": "Twitchの配信をやり直さなければならなかった"}, {"type": "subtitle", "time": 13451.91, "timestamp": "03:44:11", "text": "Twitchでは最大48までしか許可されていないため"}, {"type": "subtitle", "time": 13455.51, "timestamp": "03:44:15", "text": "何時間もの配信。つまり、48時間ごとに"}, {"type": "subtitle", "time": 13456.83, "timestamp": "03:44:16", "text": "新しいものを作る必要がある"}, {"type": "subtitle", "time": 13460.03, "timestamp": "03:44:20", "text": "ストリームを終了しないと"}, {"type": "subtitle", "time": 13463.75, "timestamp": "03:44:23", "text": "ストリーム。ああ、でも私は"}, {"type": "subtitle", "time": 13466.389, "timestamp": "03:44:26", "text": "このアプリケーションを使えば、"}, {"type": "subtitle", "time": 13469.75, "timestamp": "03:44:29", "text": "もし私のプラットフォームのいずれかが"}, {"type": "subtitle", "time": 13472.91, "timestamp": "03:44:32", "text": "li オンエアかどうか、そしてその期間がどのように"}, {"type": "subtitle", "time": 13476.55, "timestamp": "03:44:36", "text": "良い。だから、これはある意味役に立つ。 1つ来るのは"}, {"type": "subtitle", "time": 13484.229, "timestamp": "03:44:44", "text": "えっと、彼らに追加​​してもらうように頼むべきですね"}, {"type": "subtitle", "time": 13487.59, "timestamp": "03:44:47", "text": "プラットフォームBeam Streamを使っているのは、"}, {"type": "subtitle", "time": 13490.95, "timestamp": "03:44:50", "text": "マルチリームで、それらは"}, {"type": "subtitle", "time": 13493.429, "timestamp": "03:44:53", "text": "ビーム出身者の半分が"}, {"type": "subtitle", "time": 13494.429, "timestamp": "03:44:54", "text": "ストリームは"}, {"type": "subtitle", "time": 13499.59, "timestamp": "03:44:59", "text": "ボットですが、いくつか見かけたと思います"}]
[{"type": "subtitle", "time": 8645.469, "timestamp": "02:24:05", "text": "え、何？あ、トイレットペーパーは手に入れた？"}, {"type": "subtitle", "time": 8649.03, "timestamp": "02:24:09", "text": "いいえ、彼女は魅惑することを考えています"}, {"type": "subtitle", "time": 8652.55, "timestamp": "02:24:12", "text": "テーブル。ああ、わかりました。ねえ、私が話しているのは"}, {"type": "subtitle", "time": 8662.75, "timestamp": "02:24:22", "text": "どうやって？わあ、それは"}, {"type": "subtitle", "time": 8681.15, "timestamp": "02:24:41", "text": "する？本気ですか？うん。はい。あなたの"}, {"type": "subtitle", "time": 8684.63, "timestamp": "02:24:44", "text": "精霊の実の寺院。"}]
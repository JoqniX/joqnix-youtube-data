[{"type": "subtitle", "time": 2882.15, "timestamp": "00:48:02", "text": "それなど。すべてのパカクリアクリアカットのように"}, {"type": "subtitle", "time": 2884.109, "timestamp": "00:48:04", "text": "明確なタイプの"}, {"type": "subtitle", "time": 2887.829, "timestamp": "00:48:07", "text": "あれこれ。そして私たちもそう"}, {"type": "subtitle", "time": 2890.15, "timestamp": "00:48:10", "text": "コラボレーションのような良い経験でした"}, {"type": "subtitle", "time": 2893.67, "timestamp": "00:48:13", "text": "主催者が率先して運営する"}, {"type": "subtitle", "time": 2896.55, "timestamp": "00:48:16", "text": "コラボレーション全体で全員が"}, {"type": "subtitle", "time": 2900.19, "timestamp": "00:48:20", "text": "全員がそうではないことを確認するために話す"}, {"type": "subtitle", "time": 2903.67, "timestamp": "00:48:23", "text": "中断して、みんなが"}, {"type": "subtitle", "time": 2906.95, "timestamp": "00:48:26", "text": "紹介文など、"}, {"type": "subtitle", "time": 2908.95, "timestamp": "00:48:28", "text": "私が"}, {"type": "subtitle", "time": 2912.069, "timestamp": "00:48:32", "text": "その一部だったんだけど、私は「なんてこった」って思った。"}, {"type": "subtitle", "time": 2915.27, "timestamp": "00:48:35", "text": "これは、プロがこのように"}, {"type": "subtitle", "time": 2918.95, "timestamp": "00:48:38", "text": "そして実際のイアンのユーチューバーがやっているように"}, {"type": "subtitle", "time": 2921.43, "timestamp": "00:48:41", "text": "こういうことはまったく新しい"}, {"type": "subtitle", "time": 2924.069, "timestamp": "00:48:44", "text": "経験して、私は"}, {"type": "subtitle", "time": 2926.549, "timestamp": "00:48:46", "text": "鳥肌が立ったし、僕は幸せだった"}, {"type": "subtitle", "time": 2929.39, "timestamp": "00:48:49", "text": "文字通り、私はこのコラボレーションの一員です。私"}, {"type": "subtitle", "time": 2934.23, "timestamp": "00:48:54", "text": "本当に嬉しかった。ああ、誇りに思うよ。"}, {"type": "subtitle", "time": 2938.309, "timestamp": "00:48:58", "text": "このコラボレーションに招待されること。それは"}]
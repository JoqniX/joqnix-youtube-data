[{"type": "subtitle", "time": 19758.35, "timestamp": "05:29:18", "text": "彼ら。本当にそうしなければならないの？"}, {"type": "subtitle", "time": 19761.548, "timestamp": "05:29:21", "text": "勉強？私はしたくない"}, {"type": "subtitle", "time": 19764.708, "timestamp": "05:29:24", "text": "勉強。私は勉強が大嫌いだ。"}, {"type": "subtitle", "time": 19766.788, "timestamp": "05:29:26", "text": "日本語コースを受講した後も、"}, {"type": "subtitle", "time": 19775.35, "timestamp": "05:29:35", "text": "いいえ、彼らはあなたを切り裂くことはありません"}, {"type": "subtitle", "time": 19777.23, "timestamp": "05:29:37", "text": "の"}, {"type": "subtitle", "time": 19779.66, "timestamp": "05:29:39", "text": "面接官。所有"}, {"type": "subtitle", "time": 19783.948, "timestamp": "05:29:43", "text": "[音楽]"}, {"type": "subtitle", "time": 19787.43, "timestamp": "05:29:47", "text": "の上。なぜ世界は高いのか？外の世界"}, {"type": "subtitle", "time": 19794.31, "timestamp": "05:29:54", "text": "待って、あなたは人々と話しましたか？"}, {"type": "subtitle", "time": 19797.67, "timestamp": "05:29:57", "text": "4月に入隊した人は"}, {"type": "subtitle", "time": 19799.868, "timestamp": "05:29:59", "text": "バダサンと話して"}]
[{"type": "subtitle", "time": 1981.789, "timestamp": "00:33:01", "text": "[音楽]"}, {"type": "subtitle", "time": 1985.75, "timestamp": "00:33:05", "text": "作物が育っているかどうか確認してみてください"}, {"type": "subtitle", "time": 1988.47, "timestamp": "00:33:08", "text": "成長している。 3泊4日を"}, {"type": "subtitle", "time": 1990.43, "timestamp": "00:33:10", "text": "そんなに遠くまで。スキップ時間または"}, {"type": "subtitle", "time": 1993.59, "timestamp": "00:33:13", "text": "何かを試してみて、それが実るか育つか見てみよう"}, {"type": "subtitle", "time": 1995.669, "timestamp": "00:33:15", "text": "あるいは、そんな感じ。それが私が追加したモードです。"}, {"type": "subtitle", "time": 1998.71, "timestamp": "00:33:18", "text": "それは依然として明らかに"}, {"type": "subtitle", "time": 2001.75, "timestamp": "00:33:21", "text": "Minecraft は成長を止めます"}, {"type": "chat", "time": 2003.105, "timestamp": "00:33:23", "author": "@astravt", "avatar": "https://yt4.ggpht.com/MdOwC7qdh0gmlabcCYgLQ5BOZxo7CGLbc14xFv1rO9eQ745gkga99YKsszwMjcyNnEBittX8WA=s64-c-k-c0x00ffffff-no-rj", "message": "okay I'll just learn some spells and then I'll do that"}, {"type": "subtitle", "time": 2003.58, "timestamp": "00:33:23", "text": "植物または"}, {"type": "subtitle", "time": 2004.75, "timestamp": "00:33:24", "text": "[音楽]"}, {"type": "subtitle", "time": 2008.149, "timestamp": "00:33:28", "text": "えーっと、炉とかその他"}, {"type": "subtitle", "time": 2010.47, "timestamp": "00:33:30", "text": "シミュレーションエリアから出る"}, {"type": "subtitle", "time": 2011.47, "timestamp": "00:33:31", "text": "またはいくつか"}, {"type": "subtitle", "time": 2016.149, "timestamp": "00:33:36", "text": "何でも。ええと、そうですね、あなたが来たとき"}, {"type": "subtitle", "time": 2019.669, "timestamp": "00:33:39", "text": "長い遠征の後、または"}, {"type": "subtitle", "time": 2022.789, "timestamp": "00:33:42", "text": "えっと、それを見ると、"}, {"type": "subtitle", "time": 2024.149, "timestamp": "00:33:44", "text": "一時停止されるような感じだ。そうではありません"}, {"type": "subtitle", "time": 2027.549, "timestamp": "00:33:47", "text": "通常は11で一時停止しますが、"}, {"type": "subtitle", "time": 2030.95, "timestamp": "00:33:50", "text": "moduはまだあなたが"}, {"type": "subtitle", "time": 2034.23, "timestamp": "00:33:54", "text": "近くに生きている活動的な"}, {"type": "subtitle", "time": 2037.509, "timestamp": "00:33:57", "text": "シミュレーション領域で、それは続きます"}]
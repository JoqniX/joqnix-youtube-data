[{"type": "subtitle", "time": 11460.23, "timestamp": "03:11:00", "text": "ああ、それで、なぜそれが欲しいのですか？しない"}, {"type": "subtitle", "time": 11462.429, "timestamp": "03:11:02", "text": "欲しい。"}, {"type": "subtitle", "time": 11464.79, "timestamp": "03:11:04", "text": "おお。ほんの冗談です。君たちは"}, {"type": "subtitle", "time": 11467.11, "timestamp": "03:11:07", "text": "非常に"}, {"type": "subtitle", "time": 11470.15, "timestamp": "03:11:10", "text": "ああ、神様、ここにテレポートしましょう。私は必要だった"}, {"type": "subtitle", "time": 11480.59, "timestamp": "03:11:20", "text": "何てことだ。 OP"}, {"type": "subtitle", "time": 11482.59, "timestamp": "03:11:22", "text": "スパイディ"}, {"type": "subtitle", "time": 11495.71, "timestamp": "03:11:35", "text": "持っていません"}, {"type": "subtitle", "time": 11498.87, "timestamp": "03:11:38", "text": "何でも。私はしません"}, {"type": "subtitle", "time": 11503.87, "timestamp": "03:11:43", "text": "神社。何？"}, {"type": "subtitle", "time": 11506.79, "timestamp": "03:11:46", "text": "うん、君たちは、"}, {"type": "subtitle", "time": 11507.79, "timestamp": "03:11:47", "text": "彼女はすでに"}, {"type": "subtitle", "time": 11510.87, "timestamp": "03:11:50", "text": "ストリーム。それをからかうのは良くないだろう"}, {"type": "subtitle", "time": 11513.11, "timestamp": "03:11:53", "text": "今。"}, {"type": "subtitle", "time": 11515.309, "timestamp": "03:11:55", "text": "それは"}]
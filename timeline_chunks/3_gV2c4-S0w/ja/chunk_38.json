[{"type": "subtitle", "time": 2287.71, "timestamp": "00:38:07", "text": "正直に言うと、"}, {"type": "subtitle", "time": 2291.109, "timestamp": "00:38:11", "text": "深く考え込むときもできない"}, {"type": "subtitle", "time": 2293.589, "timestamp": "00:38:13", "text": "実際に私が"}, {"type": "subtitle", "time": 2302.79, "timestamp": "00:38:22", "text": "コラボしたよ、うん、作ったよ、えっと"}, {"type": "subtitle", "time": 2304.31, "timestamp": "00:38:24", "text": "コラボレーションに関しては、"}, {"type": "subtitle", "time": 2306.87, "timestamp": "00:38:26", "text": "私がもっとプロらしくなろうとしたこと"}, {"type": "subtitle", "time": 2310.47, "timestamp": "00:38:30", "text": "できるだけプロフェッショナルに質問する"}, {"type": "subtitle", "time": 2312.79, "timestamp": "00:38:32", "text": "例えば、私の最初のコラボレーション相手であるヴィック"}, {"type": "subtitle", "time": 2314.51, "timestamp": "00:38:34", "text": "と共に"}, {"type": "subtitle", "time": 2316.27, "timestamp": "00:38:36", "text": "ヴィック"}, {"type": "subtitle", "time": 2319.51, "timestamp": "00:38:39", "text": "そうですね、誰が到着したのかまだ覚えていません"}, {"type": "subtitle", "time": 2320.349, "timestamp": "00:38:40", "text": "外"}, {"type": "subtitle", "time": 2323.03, "timestamp": "00:38:43", "text": "最初に私が彼に連絡したのか、それとも"}, {"type": "subtitle", "time": 2324.51, "timestamp": "00:38:44", "text": "彼は来たのか"}, {"type": "subtitle", "time": 2327.63, "timestamp": "00:38:47", "text": "私または"}, {"type": "subtitle", "time": 2331.15, "timestamp": "00:38:51", "text": "何か。覚えていない。"}, {"type": "subtitle", "time": 2335.31, "timestamp": "00:38:55", "text": "えっと、私はすごく興奮して"}, {"type": "subtitle", "time": 2339.589, "timestamp": "00:38:59", "text": "ヴィックが最初に来たとき"}]
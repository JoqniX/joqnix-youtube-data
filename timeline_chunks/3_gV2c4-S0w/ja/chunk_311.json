[{"type": "subtitle", "time": 18660.628, "timestamp": "05:11:00", "text": "狙いはいいし、でも難しいし"}, {"type": "subtitle", "time": 18663.868, "timestamp": "05:11:03", "text": "私がApexで勝つのは珍しい"}, {"type": "subtitle", "time": 18668.19, "timestamp": "05:11:08", "text": "試合。私もディアを育てました"}, {"type": "subtitle", "time": 18671.51, "timestamp": "05:11:11", "text": "季節。私はアニのグランドマスターで、"}, {"type": "subtitle", "time": 18674.708, "timestamp": "05:11:14", "text": "スキルを解放しました。"}, {"type": "subtitle", "time": 18690.23, "timestamp": "05:11:30", "text": "そこには。待って、プレイしないで 待って、しないで"}, {"type": "subtitle", "time": 18693.39, "timestamp": "05:11:33", "text": "マーベルライバルズをプレイする"}, {"type": "subtitle", "time": 18695.83, "timestamp": "05:11:35", "text": "遠距離攻撃？あなたはマーベルをプレイしていると思います"}, {"type": "subtitle", "time": 18699.19, "timestamp": "05:11:39", "text": "ライバルズ・レンジドですよね？あなたは中毒です"}, {"type": "subtitle", "time": 18701.07, "timestamp": "05:11:41", "text": "そのゲーム、"}, {"type": "subtitle", "time": 18704.11, "timestamp": "05:11:44", "text": "ディオ。それはありました"}, {"type": "subtitle", "time": 18706.948, "timestamp": "05:11:46", "text": "数ヶ月。ああ、新しいの見た？"}, {"type": "subtitle", "time": 18709.39, "timestamp": "05:11:49", "text": "金髪のキャラクター"}, {"type": "subtitle", "time": 18712.15, "timestamp": "05:11:52", "text": "奥さん、あなたにはもう希望はありませんよ。えーと"}, {"type": "subtitle", "time": 18718.31, "timestamp": "05:11:58", "text": "君のために、私は着実に日本語を身につけた。わかった、"}]
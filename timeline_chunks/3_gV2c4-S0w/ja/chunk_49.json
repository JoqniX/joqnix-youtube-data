[{"type": "subtitle", "time": 2940.95, "timestamp": "00:49:00", "text": "素晴らしいコラボレーションでした。私は話さなかったけれど"}, {"type": "subtitle", "time": 2944.79, "timestamp": "00:49:04", "text": "たくさんですが、コラボのホストは私が"}, {"type": "subtitle", "time": 2949.109, "timestamp": "00:49:09", "text": "注目された。私は、えっと、行かないつもりでした"}, {"type": "subtitle", "time": 2952.23, "timestamp": "00:49:12", "text": "私のエネルギーレベルが低下しないように。のように"}, {"type": "subtitle", "time": 2954.75, "timestamp": "00:49:14", "text": "それがDのピークだ。"}, {"type": "subtitle", "time": 2956.75, "timestamp": "00:49:16", "text": "それは"}, {"type": "subtitle", "time": 2961.15, "timestamp": "00:49:21", "text": "ピーク。それは本当にひどい"}, {"type": "subtitle", "time": 2964.15, "timestamp": "00:49:24", "text": "いいね。そしてそれは私が"}, {"type": "subtitle", "time": 2968.19, "timestamp": "00:49:28", "text": "私もそうしたい、それは私が目指していることでもある"}, {"type": "subtitle", "time": 2972.549, "timestamp": "00:49:32", "text": "獲得してそのレベルに到達するには"}, {"type": "subtitle", "time": 2976.27, "timestamp": "00:49:36", "text": "私はグループを組むことは決してありません"}, {"type": "subtitle", "time": 2979.75, "timestamp": "00:49:39", "text": "コラボレーション。また、確認したいのですが"}, {"type": "subtitle", "time": 2981.99, "timestamp": "00:49:41", "text": "すべては私の思い通りになる、なぜなら私は"}, {"type": "subtitle", "time": 2983.71, "timestamp": "00:49:43", "text": "これをホストしている"}, {"type": "subtitle", "time": 2987.03, "timestamp": "00:49:47", "text": "コラボレーション。私はコラボパートナーに"}, {"type": "subtitle", "time": 2990.87, "timestamp": "00:49:50", "text": "楽しんでください。そしてまた"}, {"type": "subtitle", "time": 2992.71, "timestamp": "00:49:52", "text": "ええと、見ている視聴者と"}, {"type": "subtitle", "time": 2995.43, "timestamp": "00:49:55", "text": "私たちのコミュニティからのあらゆるもの"}, {"type": "subtitle", "time": 2997.67, "timestamp": "00:49:57", "text": "さまざまなコミュニティすべて"}]
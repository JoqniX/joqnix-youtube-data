[{"type": "subtitle", "time": 4681.189, "timestamp": "01:18:01", "text": "えっと、疑問があるのですが"}, {"type": "subtitle", "time": 4684.63, "timestamp": "01:18:04", "text": "オートモードパックがチェックするようなものです"}, {"type": "subtitle", "time": 4686.709, "timestamp": "01:18:06", "text": "modsフォルダからですよね？サーバー"}, {"type": "subtitle", "time": 4688.87, "timestamp": "01:18:08", "text": "メインMODフォルダ。"}, {"type": "subtitle", "time": 4693.669, "timestamp": "01:18:13", "text": "そして、だから、えっと、どんなモッドでも"}, {"type": "subtitle", "time": 4696.63, "timestamp": "01:18:16", "text": "追加したいのは、それが"}, {"type": "subtitle", "time": 4699.59, "timestamp": "01:18:19", "text": "クライアント側またはサーバー側"}, {"type": "subtitle", "time": 4704.149, "timestamp": "01:18:24", "text": "えっと、それをmodsフォルダに追加しますよね？"}, {"type": "subtitle", "time": 4706.79, "timestamp": "01:18:26", "text": "通常はそうですが、私がしたことは"}, {"type": "subtitle", "time": 4709.669, "timestamp": "01:18:29", "text": "クライアントMOD用の別のフォルダですね。"}, {"type": "subtitle", "time": 4713.43, "timestamp": "01:18:33", "text": "管理が楽になるから、それで何？"}, {"type": "subtitle", "time": 4717.35, "timestamp": "01:18:37", "text": "誰かが"}, {"type": "subtitle", "time": 4719.59, "timestamp": "01:18:39", "text": "えーと、Automodパックがダウンロードされるとき"}, {"type": "subtitle", "time": 4722.31, "timestamp": "01:18:42", "text": "これらのMOD。つまり、何が起こるかというと"}, {"type": "subtitle", "time": 4726.63, "timestamp": "01:18:46", "text": "彼らはそれを2倍ダウンロードするか、リークするだろう"}, {"type": "subtitle", "time": 4728.95, "timestamp": "01:18:48", "text": "CL については、そして私が見てみると"}, {"type": "subtitle", "time": 4731.99, "timestamp": "01:18:51", "text": "ファイルは2倍ではないようですが"}, {"type": "subtitle", "time": 4733.39, "timestamp": "01:18:53", "text": "その"}, {"type": "subtitle", "time": 4737.43, "timestamp": "01:18:57", "text": "それでもなぜか私は「待って」と思った"}]
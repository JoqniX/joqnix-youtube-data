[{"type": "subtitle", "time": 3122.79, "timestamp": "00:52:02", "text": "PNG、えっと、ちょっと雑談したりします"}, {"type": "subtitle", "time": 3126.71, "timestamp": "00:52:06", "text": "そしてコラボする、それだけ、私にとってはノー"}, {"type": "subtitle", "time": 3129.349, "timestamp": "00:52:09", "text": "コラボホストも"}, {"type": "subtitle", "time": 3132.79, "timestamp": "00:52:12", "text": "怠けるのではなく、もっと試してみよう"}, {"type": "subtitle", "time": 3135.99, "timestamp": "00:52:15", "text": "最善を尽くしているが、できない"}, {"type": "subtitle", "time": 3138.15, "timestamp": "00:52:18", "text": "すべてが積み重なりすぎているから"}, {"type": "subtitle", "time": 3140.91, "timestamp": "00:52:20", "text": "彼らのために。いいえ。"}, {"type": "subtitle", "time": 3144.95, "timestamp": "00:52:24", "text": "積み上がってる。いいえ。だから私がすることは、"}, {"type": "subtitle", "time": 3147.51, "timestamp": "00:52:27", "text": "自ら進んで「うん、聞いてみて」"}, {"type": "subtitle", "time": 3149.829, "timestamp": "00:52:29", "text": "ええ、知っています。ダイナミックタイムです"}, {"type": "subtitle", "time": 3152.23, "timestamp": "00:52:32", "text": "スタンプ。これは私たち全員が"}, {"type": "subtitle", "time": 3155.109, "timestamp": "00:52:35", "text": "ストリーミング配信もする予定だし、そういうものも全部"}, {"type": "subtitle", "time": 3157.99, "timestamp": "00:52:37", "text": "昔のDiscordは"}, {"type": "subtitle", "time": 3161.589, "timestamp": "00:52:41", "text": "動的なタイムスタンプの仕組みは"}, {"type": "subtitle", "time": 3164.71, "timestamp": "00:52:44", "text": "他の人にもよく知られている、そして空洞"}, {"type": "subtitle", "time": 3166.95, "timestamp": "00:52:46", "text": "テキストのやつ、マルチウォッチのやつ"}, {"type": "subtitle", "time": 3169.549, "timestamp": "00:52:49", "text": "他の人には知られていなかったし、何もかも。"}, {"type": "subtitle", "time": 3172.79, "timestamp": "00:52:52", "text": "いいえ、私は昔とても好きだったような"}, {"type": "subtitle", "time": 3175.99, "timestamp": "00:52:55", "text": "それを宣伝する、そう、これを使ってもいいよ"}, {"type": "subtitle", "time": 3178.71, "timestamp": "00:52:58", "text": "サイトですが、PGなどについては"}]
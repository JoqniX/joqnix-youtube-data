[{"type": "subtitle", "time": 19562.39, "timestamp": "05:26:02", "text": "今から4ヶ月後、私はどうなっているだろうか。意思"}, {"type": "subtitle", "time": 19566.47, "timestamp": "05:26:06", "text": "私は日本語の勉強を怠っているのでしょうか？私は"}, {"type": "subtitle", "time": 19568.39, "timestamp": "05:26:08", "text": "実際に時間と労力を費やして"}, {"type": "subtitle", "time": 19570.708, "timestamp": "05:26:10", "text": "実際に人と交流する？"}, {"type": "subtitle", "time": 19573.47, "timestamp": "05:26:13", "text": "私は筋金入りの"}, {"type": "subtitle", "time": 19575.67, "timestamp": "05:26:15", "text": "内向的。あなたはインド出身ですか？"}, {"type": "subtitle", "time": 19577.07, "timestamp": "05:26:17", "text": "はい、私は"}, {"type": "subtitle", "time": 19579.39, "timestamp": "05:26:19", "text": "インド。私はインド人です"}, {"type": "subtitle", "time": 19588.07, "timestamp": "05:26:28", "text": "はい。私は、I I のように書くべきだと思います"}, {"type": "subtitle", "time": 19591.03, "timestamp": "05:26:31", "text": "キックにはパネルがあると思います。そうするべきです。"}, {"type": "subtitle", "time": 19594.07, "timestamp": "05:26:34", "text": "Twitchに投稿したようなものを投稿してください。"}, {"type": "subtitle", "time": 19596.23, "timestamp": "05:26:36", "text": "右？ Twitchのパネル関連情報。私はただ"}, {"type": "subtitle", "time": 19598.67, "timestamp": "05:26:38", "text": "それをキックパネルにコピー＆ペーストします。"}, {"type": "subtitle", "time": 19602.67, "timestamp": "05:26:42", "text": "推測。えっと、それで"}, {"type": "subtitle", "time": 19605.708, "timestamp": "05:26:45", "text": "うん。もちろん。"}, {"type": "subtitle", "time": 19609.19, "timestamp": "05:26:49", "text": "もちろん。ええ、そうですね。ええと、たとえ"}, {"type": "subtitle", "time": 19611.43, "timestamp": "05:26:51", "text": "サブボタンみたいに、えっと、あなたは"}, {"type": "subtitle", "time": 19612.99, "timestamp": "05:26:52", "text": "不思議に思うように、"}, {"type": "subtitle", "time": 19616.15, "timestamp": "05:26:56", "text": "ああ、人々から寄付をもらっているのですか？は"}, {"type": "subtitle", "time": 19618.47, "timestamp": "05:26:58", "text": "タイマーの増加は"}]
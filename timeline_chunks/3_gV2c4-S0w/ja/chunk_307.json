[{"type": "subtitle", "time": 18422.03, "timestamp": "05:07:02", "text": "実に奥深い組み合わせだ。"}, {"type": "subtitle", "time": 18424.788, "timestamp": "05:07:04", "text": "おお。恋人との関係はどうですか？何が"}, {"type": "subtitle", "time": 18428.708, "timestamp": "05:07:08", "text": "安定した関係でも？私は勉強していません"}, {"type": "subtitle", "time": 18431.99, "timestamp": "05:07:11", "text": "私はそうすべきだと思う 全体"}, {"type": "subtitle", "time": 18434.35, "timestamp": "05:07:14", "text": "チケットは本日リリースされる予定です"}, {"type": "subtitle", "time": 18437.43, "timestamp": "05:07:17", "text": "今週か来週。私にはわからない"}, {"type": "subtitle", "time": 18440.23, "timestamp": "05:07:20", "text": "どの科目の試験を受ける予定ですか？"}, {"type": "subtitle", "time": 18444.15, "timestamp": "05:07:24", "text": "あるいは、試験日の場合。私は信じている"}, {"type": "subtitle", "time": 18446.99, "timestamp": "05:07:26", "text": "6月のはずなのに"}, {"type": "subtitle", "time": 18451.788, "timestamp": "05:07:31", "text": "16歳とかそんな感じ。 16歳以上または14歳"}, {"type": "subtitle", "time": 18453.39, "timestamp": "05:07:33", "text": "先へ。"}, {"type": "subtitle", "time": 18456.07, "timestamp": "05:07:36", "text": "えっと、ああ、勉強しなきゃいけないんだよ。"}, {"type": "subtitle", "time": 18467.67, "timestamp": "05:07:47", "text": "おお。私は勉強を諦めなければならない"}, {"type": "subtitle", "time": 18469.07, "timestamp": "05:07:49", "text": "私のすることすべて。"}, {"type": "subtitle", "time": 18477.67, "timestamp": "05:07:57", "text": "うん。面白いことに、私は韓国人です"}]
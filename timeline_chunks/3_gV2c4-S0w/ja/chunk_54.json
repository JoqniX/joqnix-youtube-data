[{"type": "subtitle", "time": 3240.75, "timestamp": "00:54:00", "text": "Discordクライアントと"}, {"type": "subtitle", "time": 3244.109, "timestamp": "00:54:04", "text": "何もかも分からないから。感じた"}, {"type": "subtitle", "time": 3247.51, "timestamp": "00:54:07", "text": "心の中では、"}, {"type": "subtitle", "time": 3250.71, "timestamp": "00:54:10", "text": "誰もやってくれないだろうな、という感じだった。"}, {"type": "subtitle", "time": 3253.19, "timestamp": "00:54:13", "text": "私がやってみてもいいんじゃない？だって、手伝いたいから。私"}, {"type": "subtitle", "time": 3256.23, "timestamp": "00:54:16", "text": "貢献したい、貢献していると感じたい。"}, {"type": "subtitle", "time": 3258.309, "timestamp": "00:54:18", "text": "いいえ、私はこれに貢献していると感じたいのです"}, {"type": "subtitle", "time": 3261.109, "timestamp": "00:54:21", "text": "コラボレーション。一人だけが"}, {"type": "subtitle", "time": 3263.829, "timestamp": "00:54:23", "text": "これをやるとこうなるか、"}, {"type": "subtitle", "time": 3266.15, "timestamp": "00:54:26", "text": "あれこれ。私は参加したい"}, {"type": "subtitle", "time": 3268.549, "timestamp": "00:54:28", "text": "これ。いいえ、それはグループ全体の努力の賜物です。それは"}, {"type": "subtitle", "time": 3277.349, "timestamp": "00:54:37", "text": "うん、それが私が感じることだよ"}, {"type": "subtitle", "time": 3280.43, "timestamp": "00:54:40", "text": "グループコラボレーションなどに参加する"}, {"type": "subtitle", "time": 3285.91, "timestamp": "00:54:45", "text": "だって、そう、私はそういうことをするのが好きなんです。私"}, {"type": "subtitle", "time": 3288.069, "timestamp": "00:54:48", "text": "わからない。必要ないけれど"}, {"type": "subtitle", "time": 3293.63, "timestamp": "00:54:53", "text": "自分の立場をわきまえて、好きとかそういうことをする、"}, {"type": "subtitle", "time": 3296.23, "timestamp": "00:54:56", "text": "でも、私がそうしたときはほとんどの場合"}, {"type": "subtitle", "time": 3298.03, "timestamp": "00:54:58", "text": "それについては、誰も何も言わなかった。"}]
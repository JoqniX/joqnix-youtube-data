[{"type": "subtitle", "time": 16860.75, "timestamp": "04:41:00", "text": "私自身はなぜそれが"}, {"type": "subtitle", "time": 16867.75, "timestamp": "04:41:07", "text": "彼らは私たちにたむろすることについて話し、"}, {"type": "subtitle", "time": 16877.27, "timestamp": "04:41:17", "text": "なぜならこれはとても似ているから"}, {"type": "subtitle", "time": 16885.91, "timestamp": "04:41:25", "text": "過去。簡単に説明させてください"}, {"type": "subtitle", "time": 16889.03, "timestamp": "04:41:29", "text": "名前は挙げませんが、簡単に説明させてください"}, {"type": "subtitle", "time": 16891.83, "timestamp": "04:41:31", "text": "あれ。同じだった。わかった。似ている"}, {"type": "subtitle", "time": 16894.39, "timestamp": "04:41:34", "text": "あなたがしていたことに対して、彼らは"}, {"type": "subtitle", "time": 16897.43, "timestamp": "04:41:37", "text": "えっと、クリエイターがいて、私は"}, {"type": "subtitle", "time": 16899.91, "timestamp": "04:41:39", "text": "彼らの配信は本当に楽しかった"}, {"type": "subtitle", "time": 16903.59, "timestamp": "04:41:43", "text": "楽しかったよ、私たちはゲームみたいなことをしてた"}, {"type": "subtitle", "time": 16905.708, "timestamp": "04:41:45", "text": "配信は初めてでした"}, {"type": "subtitle", "time": 16909.35, "timestamp": "04:41:49", "text": "初めて"}, {"type": "subtitle", "time": 16912.31, "timestamp": "04:41:52", "text": "配信者と一緒にプレイできてとても嬉しかった"}, {"type": "subtitle", "time": 16915.99, "timestamp": "04:41:55", "text": "それはフォートナイトでした。私たちはフォートナイトをプレイしました。そして私は"}, {"type": "subtitle", "time": 16918.19, "timestamp": "04:41:58", "text": "本当に幸せだった、本当に幸せだった、そして"}]
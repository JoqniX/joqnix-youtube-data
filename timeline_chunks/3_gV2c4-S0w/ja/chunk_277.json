[{"type": "subtitle", "time": 16621.67, "timestamp": "04:37:01", "text": "知っておくと、自分の側からストリーミングできます"}, {"type": "subtitle", "time": 16635.949, "timestamp": "04:37:15", "text": "では、本当の問題は"}, {"type": "subtitle", "time": 16639.269, "timestamp": "04:37:19", "text": "彼らはあなたを以前と同じように扱ってくれるだろうか？"}, {"type": "subtitle", "time": 16641.189, "timestamp": "04:37:21", "text": "でも彼らは話していて、私は彼らの仲間です"}, {"type": "subtitle", "time": 16645.629, "timestamp": "04:37:25", "text": "「あー、ハイハイハイ」と言ってください。"}, {"type": "subtitle", "time": 16648.789, "timestamp": "04:37:28", "text": "しかし結局彼らは"}, {"type": "subtitle", "time": 16656.269, "timestamp": "04:37:36", "text": "ダシュナは、ある意味でそうですよね"}, {"type": "subtitle", "time": 16659.39, "timestamp": "04:37:39", "text": "ウムフリー"}, {"type": "subtitle", "time": 16662.629, "timestamp": "04:37:42", "text": "そういう風にコラボレーションするなら、そう、そういう意味で"}, {"type": "subtitle", "time": 16665.07, "timestamp": "04:37:45", "text": "おっしゃる通り、それは無料です"}, {"type": "subtitle", "time": 16668.67, "timestamp": "04:37:48", "text": "コラボだけど、まあ、さっきも言ったように"}, {"type": "subtitle", "time": 16672.551, "timestamp": "04:37:52", "text": "それは、もしそこに"}, {"type": "subtitle", "time": 16673.949, "timestamp": "04:37:53", "text": "参加型"}, {"type": "subtitle", "time": 16677.07, "timestamp": "04:37:57", "text": "いいえ、もし彼らが許可すれば"}]
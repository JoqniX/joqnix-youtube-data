[{"type": "subtitle", "time": 13159.87, "timestamp": "03:39:19", "text": "多く。明日は、あ、待って。"}, {"type": "subtitle", "time": 13164.07, "timestamp": "03:39:24", "text": "誰か、どこかに書き留めておかないといけない"}, {"type": "subtitle", "time": 13167.19, "timestamp": "03:39:27", "text": "私が計画を立てているのは、すべてです。すべて"}, {"type": "subtitle", "time": 13168.429, "timestamp": "03:39:28", "text": "コラボレーションは"}, {"type": "subtitle", "time": 13171.51, "timestamp": "03:39:31", "text": "そこには？ああ、神様。難しいのは"}, {"type": "subtitle", "time": 13174.63, "timestamp": "03:39:34", "text": "すべてを自分で管理し、"}, {"type": "subtitle", "time": 13178.19, "timestamp": "03:39:38", "text": "あなたは自分の基準に基づいてすべてを移動します"}, {"type": "subtitle", "time": 13180.95, "timestamp": "03:39:40", "text": "メモリ。よし、私は速めにしようと思う"}, {"type": "subtitle", "time": 13182.55, "timestamp": "03:39:42", "text": "明日ファスモフォビアがあれば"}, {"type": "subtitle", "time": 13188.63, "timestamp": "03:39:48", "text": "えっと、なぜ彼は私に"}, {"type": "subtitle", "time": 13191.429, "timestamp": "03:39:51", "text": "今すぐ入隊案内をダウンロードしますか？そうすればもしかしたら"}, {"type": "subtitle", "time": 13194.87, "timestamp": "03:39:54", "text": "あなたは私に「オーケー」と言うかもしれません。だから私は"}, {"type": "subtitle", "time": 13196.67, "timestamp": "03:39:56", "text": "両方とも保管する"}, {"type": "subtitle", "time": 13199.429, "timestamp": "03:39:59", "text": "インストール済み。入隊したかどうか確認する必要がある"}]
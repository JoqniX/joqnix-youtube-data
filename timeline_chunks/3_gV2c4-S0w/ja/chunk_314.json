[{"type": "subtitle", "time": 18840.35, "timestamp": "05:14:00", "text": "研究"}, {"type": "subtitle", "time": 18843.03, "timestamp": "05:14:03", "text": "良い。 Mはまた眠りにつくでしょう。取る"}, {"type": "subtitle", "time": 18844.55, "timestamp": "05:14:04", "text": "みんなを大切に。こんにちは。おやすみ。良い"}, {"type": "subtitle", "time": 18846.55, "timestamp": "05:14:06", "text": "夜。おやすみ。おやすみ。そして"}, {"type": "subtitle", "time": 18853.07, "timestamp": "05:14:13", "text": "夜。離れる"}, {"type": "subtitle", "time": 18855.628, "timestamp": "05:14:15", "text": "あなたの"}, {"type": "subtitle", "time": 18864.07, "timestamp": "05:14:24", "text": "ええ、今はアルファ版は出せません。だった"}, {"type": "subtitle", "time": 18865.868, "timestamp": "05:14:25", "text": "高地でのセーリング"}, {"type": "subtitle", "time": 18869.35, "timestamp": "05:14:29", "text": "海。待って、それはできないよ。そうそう。ああ、私は"}, {"type": "subtitle", "time": 18883.83, "timestamp": "05:14:43", "text": "ああ、私も航海について考えた"}, {"type": "subtitle", "time": 18887.31, "timestamp": "05:14:47", "text": "いくつかのゲームでは大海原でしたが、私は"}, {"type": "subtitle", "time": 18890.15, "timestamp": "05:14:50", "text": "ある意味、私にもできたのですが、"}, {"type": "subtitle", "time": 18891.91, "timestamp": "05:14:51", "text": "だって、無料ゲームはもうたくさん持ってるんだもん。"}, {"type": "subtitle", "time": 18893.23, "timestamp": "05:14:53", "text": "終わらせます"}, {"type": "subtitle", "time": 18897.27, "timestamp": "05:14:57", "text": "それらの。そうでなければ、私はそれらをプレイしていたでしょう"}]
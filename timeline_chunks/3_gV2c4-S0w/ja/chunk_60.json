[{"type": "subtitle", "time": 3604.47, "timestamp": "01:00:04", "text": "7月上旬。何てことだ。わかった。少なくとも"}, {"type": "subtitle", "time": 3606.789, "timestamp": "01:00:06", "text": "あなたは私の誕生日にここにいてくれる。"}, {"type": "subtitle", "time": 3621.349, "timestamp": "01:00:21", "text": "えっと、ストリームが何なのか気になります"}, {"type": "subtitle", "time": 3625.32, "timestamp": "01:00:25", "text": "肌はこんな感じだった。私はどうしてだろうとは思わない"}, {"type": "subtitle", "time": 3627.87, "timestamp": "01:00:27", "text": "[音楽]"}, {"type": "subtitle", "time": 3653.51, "timestamp": "01:00:53", "text": "今。以前は配信スケジュールがありました"}, {"type": "subtitle", "time": 3657.19, "timestamp": "01:00:57", "text": "実際に投稿しましたが、"}, {"type": "subtitle", "time": 3659.829, "timestamp": "01:00:59", "text": "最後までやり遂げる、私はこう思った、"}]
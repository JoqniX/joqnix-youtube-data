[{"type": "subtitle", "time": 3301.589, "timestamp": "00:55:01", "text": "だから、私はよく「私たちはどうですか」と尋ねていました。"}, {"type": "subtitle", "time": 3303.349, "timestamp": "00:55:03", "text": "コラボレーションを始める予定ですか？何が"}, {"type": "subtitle", "time": 3305.19, "timestamp": "00:55:05", "text": "コラボ形式？誰が"}, {"type": "subtitle", "time": 3306.79, "timestamp": "00:55:06", "text": "紹介とか色々？どうやって"}, {"type": "subtitle", "time": 3311.27, "timestamp": "00:55:11", "text": "やる？などなど、再"}, {"type": "subtitle", "time": 3313.27, "timestamp": "00:55:13", "text": "通常通り"}, {"type": "subtitle", "time": 3316.829, "timestamp": "00:55:16", "text": "えっと、あの、教えてあげるよ"}, {"type": "subtitle", "time": 3321.23, "timestamp": "00:55:21", "text": "えっと、私の経験からすると、もし私が正しければ"}, {"type": "subtitle", "time": 3325.99, "timestamp": "00:55:25", "text": "えっと、寿司が私をドラッグに連れてくるときはいつも"}, {"type": "subtitle", "time": 3329.15, "timestamp": "00:55:29", "text": "コラボに誘う"}, {"type": "subtitle", "time": 3332.47, "timestamp": "00:55:32", "text": "そうだね、寿司も良い例だよ"}, {"type": "subtitle", "time": 3342.99, "timestamp": "00:55:42", "text": "私は寿司がとても素晴らしいところが大好きです"}, {"type": "subtitle", "time": 3346.95, "timestamp": "00:55:46", "text": "クリエイター。えっと、スシ、私たちは彼をスシと呼んでいます。"}, {"type": "subtitle", "time": 3349.91, "timestamp": "00:55:49", "text": "えっと、彼のチャンネル名はReneです"}, {"type": "subtitle", "time": 3351.309, "timestamp": "00:55:51", "text": "マル"}, {"type": "subtitle", "time": 3354.589, "timestamp": "00:55:54", "text": "チャネル。ああ、とても良い"}, {"type": "subtitle", "time": 3357.589, "timestamp": "00:55:57", "text": "友人。うん。神様、私は"}, {"type": "subtitle", "time": 3358.67, "timestamp": "00:55:58", "text": "目と"}]
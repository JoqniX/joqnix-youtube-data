[{"type": "subtitle", "time": 9361.59, "timestamp": "02:36:01", "text": "あなたに向けたものではない"}, {"type": "subtitle", "time": 9364.91, "timestamp": "02:36:04", "text": "ファンメイドであるとどこかに書かれている"}, {"type": "subtitle", "time": 9368.87, "timestamp": "02:36:08", "text": "あれ。それで何が起こったかというと、"}, {"type": "subtitle", "time": 9371.03, "timestamp": "02:36:11", "text": "YouTubeとSoundCloudに投稿され、"}, {"type": "subtitle", "time": 9372.71, "timestamp": "02:36:12", "text": "どこでも"}, {"type": "subtitle", "time": 9375.19, "timestamp": "02:36:15", "text": "えーと、何人かの人が見ていたとき"}, {"type": "subtitle", "time": 9377.67, "timestamp": "02:36:17", "text": "SoundCloudとかSound Yeahみたいなやつ。"}, {"type": "subtitle", "time": 9378.87, "timestamp": "02:36:18", "text": "SoundCloudとか彼らが持ってるもの"}, {"type": "subtitle", "time": 9381.03, "timestamp": "02:36:21", "text": "それを勧められたら、彼らはこう言った"}, {"type": "subtitle", "time": 9384.389, "timestamp": "02:36:24", "text": "ジョー、いつ音楽をやったのか聞いている"}, {"type": "subtitle", "time": 9387.429, "timestamp": "02:36:27", "text": "この人とのコラボレーションでは"}, {"type": "subtitle", "time": 9389.91, "timestamp": "02:36:29", "text": "それを知って私は「えっ」と思いました"}, {"type": "subtitle", "time": 9397.75, "timestamp": "02:36:37", "text": "そう、そういうことなら"}, {"type": "subtitle", "time": 9399.75, "timestamp": "02:36:39", "text": "ストリームからの声とその他すべて"}, {"type": "subtitle", "time": 9402.309, "timestamp": "02:36:42", "text": "今誰かがそうしなければならない 彼らはそうしなければならない"}, {"type": "subtitle", "time": 9406.07, "timestamp": "02:36:46", "text": "ストリームから音声が取られていないことを言及"}, {"type": "subtitle", "time": 9410.71, "timestamp": "02:36:50", "text": "これはファンメイドのプロジェクトであり、"}, {"type": "subtitle", "time": 9418.55, "timestamp": "02:36:58", "text": "怪しい。"}]
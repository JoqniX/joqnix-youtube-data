[{"type": "subtitle", "time": 8961.83, "timestamp": "02:29:21", "text": "何？ああ、あなたはもう自分の家を建てたのですね。"}, {"type": "subtitle", "time": 8964.309, "timestamp": "02:29:24", "text": "私も自分の家が欲しい。したい"}, {"type": "subtitle", "time": 8974.91, "timestamp": "02:29:34", "text": "何？あなたの家"}, {"type": "subtitle", "time": 8978.87, "timestamp": "02:29:38", "text": "まさにこの人みたいだ。ほら、今私は"}, {"type": "subtitle", "time": 8980.95, "timestamp": "02:29:40", "text": "ここから村へ行ってください。"}, {"type": "subtitle", "time": 8983.15, "timestamp": "02:29:43", "text": "見て。"}, {"type": "subtitle", "time": 8986.95, "timestamp": "02:29:46", "text": "ああ。わあ、すごい。私の家と繋がっています。今"}, {"type": "subtitle", "time": 8988.87, "timestamp": "02:29:48", "text": "私はただ、たくさんのサクランボを育てなければならない"}, {"type": "subtitle", "time": 8992.79, "timestamp": "02:29:52", "text": "木々かな。うん。改革のように"}, {"type": "subtitle", "time": 8994.79, "timestamp": "02:29:54", "text": "地形。"}, {"type": "subtitle", "time": 8997.27, "timestamp": "02:29:57", "text": "私は独自の地形を作っています。"}, {"type": "subtitle", "time": 8999.11, "timestamp": "02:29:59", "text": "おお。"}]
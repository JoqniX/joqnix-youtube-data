[{"type": "subtitle", "time": 8705.27, "timestamp": "02:25:05", "text": "今日は何をして遊んでいましたか？何何"}, {"type": "subtitle", "time": 8707.03, "timestamp": "02:25:07", "text": "それはゲームだったのか？それは、"}, {"type": "subtitle", "time": 8709.75, "timestamp": "02:25:09", "text": "マインクラフト。ええ、荒野か"}, {"type": "subtitle", "time": 8712.59, "timestamp": "02:25:12", "text": "何か。そう、未開の地だ。"}, {"type": "subtitle", "time": 8715.59, "timestamp": "02:25:15", "text": "うん、探索できるし"}, {"type": "subtitle", "time": 8726.91, "timestamp": "02:25:26", "text": "ああ、やばい。私は転んだ。私は落ちた。私は落ちた。私"}]
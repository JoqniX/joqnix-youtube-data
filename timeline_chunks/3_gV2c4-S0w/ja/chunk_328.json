[{"type": "subtitle", "time": 19683.19, "timestamp": "05:28:03", "text": "ああ、君は勉強を怠ったんだね"}, {"type": "subtitle", "time": 19684.868, "timestamp": "05:28:04", "text": "あなたは自分のものを自分のものにした"}, {"type": "subtitle", "time": 19686.47, "timestamp": "05:28:06", "text": "デバイスと努力を理解しています"}, {"type": "subtitle", "time": 19690.39, "timestamp": "05:28:10", "text": "リーダー。じゃあ、そうするときは、"}, {"type": "subtitle", "time": 19691.948, "timestamp": "05:28:11", "text": "戻って確認する"}, {"type": "subtitle", "time": 19695.83, "timestamp": "05:28:15", "text": "インタビューで、もしそれが"}, {"type": "subtitle", "time": 19698.548, "timestamp": "05:28:18", "text": "実際の日本では、"}, {"type": "subtitle", "time": 19701.51, "timestamp": "05:28:21", "text": "彼らと会話することができる"}, {"type": "subtitle", "time": 19703.47, "timestamp": "05:28:23", "text": "ましてや"}, {"type": "subtitle", "time": 19704.67, "timestamp": "05:28:24", "text": "承認しました。"}, {"type": "subtitle", "time": 19707.708, "timestamp": "05:28:27", "text": "[音楽]"}, {"type": "subtitle", "time": 19717.43, "timestamp": "05:28:37", "text": "いや、つまり私は幸運だった"}, {"type": "subtitle", "time": 19720.03, "timestamp": "05:28:40", "text": "それはまるで非"}, {"type": "subtitle", "time": 19723.03, "timestamp": "05:28:43", "text": "言語に関する非日本人インタビュアー"}, {"type": "subtitle", "time": 19724.35, "timestamp": "05:28:44", "text": "学校"}, {"type": "subtitle", "time": 19726.47, "timestamp": "05:28:46", "text": "インタビュー。でも、そうだね、君は"}, {"type": "subtitle", "time": 19727.628, "timestamp": "05:28:47", "text": "実は"}]
[{"type": "subtitle", "time": 11941.19, "timestamp": "03:19:01", "text": "水曜日。こんにちは。"}, {"type": "subtitle", "time": 11943.83, "timestamp": "03:19:03", "text": "参加したいですか？あなたも参加できます。"}, {"type": "subtitle", "time": 11947.15, "timestamp": "03:19:07", "text": "それでおしまい。一緒に配信できますよ。"}, {"type": "subtitle", "time": 11951.429, "timestamp": "03:19:11", "text": "水曜日。いつですか？何時？"}, {"type": "subtitle", "time": 11954.429, "timestamp": "03:19:14", "text": "えっと、私は普段8時に配信します。"}, {"type": "subtitle", "time": 11970.309, "timestamp": "03:19:30", "text": "こんにちは。うん、まだ使えるよ。うん。マインクラフト。"}, {"type": "subtitle", "time": 11973.63, "timestamp": "03:19:33", "text": "わかった。私もあなたの"}, {"type": "subtitle", "time": 11977.429, "timestamp": "03:19:37", "text": "Twitch関連の健康状態。そうそう。"}, {"type": "subtitle", "time": 11980.79, "timestamp": "03:19:40", "text": "うん。ヴァン、君はTwitchでそれをやっているんだね。"}, {"type": "subtitle", "time": 11986.07, "timestamp": "03:19:46", "text": "いや、いや、いや。 Twitchのアカウントを設定します。"}, {"type": "subtitle", "time": 11992.95, "timestamp": "03:19:52", "text": "待って、なぜダメなの？複数ページ同時読み込みはなぜしないのか？または"}, {"type": "subtitle", "time": 11995.429, "timestamp": "03:19:55", "text": "まるで、あなたは行くような"}, {"type": "subtitle", "time": 11998.469, "timestamp": "03:19:58", "text": "えっと、限定配信みたいな感じ？私の"}]
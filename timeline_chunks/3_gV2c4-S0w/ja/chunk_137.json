[{"type": "subtitle", "time": 8225.83, "timestamp": "02:17:05", "text": "何てことだ。ニース。"}, {"type": "subtitle", "time": 8227.83, "timestamp": "02:17:07", "text": "うん。"}, {"type": "subtitle", "time": 8231.589, "timestamp": "02:17:11", "text": "どうやってこれを見つけたの？"}, {"type": "subtitle", "time": 8235.03, "timestamp": "02:17:15", "text": "私はただ、物を見つけることができるだけです。"}, {"type": "subtitle", "time": 8241.589, "timestamp": "02:17:21", "text": "行く。ああ、そのモードもあるんですね？クライアント"}, {"type": "subtitle", "time": 8243.589, "timestamp": "02:17:23", "text": "サイドモードでは、物を追加して"}, {"type": "subtitle", "time": 8246.629, "timestamp": "02:17:26", "text": "すべて。 1つは"}, {"type": "subtitle", "time": 8248.549, "timestamp": "02:17:28", "text": "私がどのようにやったか知りたいですか。"}, {"type": "subtitle", "time": 8267.629, "timestamp": "02:17:47", "text": "それはデバッグスティックですか？"}, {"type": "subtitle", "time": 8269.589, "timestamp": "02:17:49", "text": "いいえ。そんな感じです。あなたは思う"}, {"type": "subtitle", "time": 8279.03, "timestamp": "02:17:59", "text": "[音楽]"}]
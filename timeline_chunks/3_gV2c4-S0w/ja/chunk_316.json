[{"type": "subtitle", "time": 18964.43, "timestamp": "05:16:04", "text": "そして、アリーナ公演はあと1週間残っている。"}, {"type": "subtitle", "time": 18967.15, "timestamp": "05:16:07", "text": "ああ、もっと"}, {"type": "subtitle", "time": 18970.75, "timestamp": "05:16:10", "text": "もっと。ああ、あなたは配信していなかったんですね。"}, {"type": "subtitle", "time": 18974.51, "timestamp": "05:16:14", "text": "小川。よう、君の配信が恋しかったよ。"}, {"type": "subtitle", "time": 18977.948, "timestamp": "05:16:17", "text": "バカ、エイペックス・ピューピューはどこだ？"}, {"type": "subtitle", "time": 18981.31, "timestamp": "05:16:21", "text": "ストリーム？一種の休止期間。私"}, {"type": "subtitle", "time": 19000.35, "timestamp": "05:16:40", "text": "えっと、コメントを探してみますね。私は必要としている"}, {"type": "subtitle", "time": 19003.43, "timestamp": "05:16:43", "text": "後知恵ゲーム、それが新しい名前だ。今私は"}, {"type": "subtitle", "time": 19005.75, "timestamp": "05:16:45", "text": "その名前を覚えなければならない。言い換えると"}, {"type": "subtitle", "time": 19008.67, "timestamp": "05:16:48", "text": "私の記憶では"}]
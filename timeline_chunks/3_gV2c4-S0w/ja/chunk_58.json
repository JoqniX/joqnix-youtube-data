[{"type": "subtitle", "time": 3480.87, "timestamp": "00:58:00", "text": "知る。ところで、あなたのVA（バー​​チャルアシスタント）はどうですか？"}, {"type": "subtitle", "time": 3485.75, "timestamp": "00:58:05", "text": "目が覚めたら何をしていたと思いますか？"}, {"type": "subtitle", "time": 3491.15, "timestamp": "00:58:11", "text": "午前6時。いいえ、6時。いいえ。午後6時。いいえ、いいえ、"}, {"type": "subtitle", "time": 3496.63, "timestamp": "00:58:16", "text": "君たち5人。私は午後7時に目を覚ました。"}, {"type": "subtitle", "time": 3498.349, "timestamp": "00:58:18", "text": "午後7時あなたは"}, {"type": "subtitle", "time": 3500.95, "timestamp": "00:58:20", "text": "いつまであなたは"}, {"type": "subtitle", "time": 3502.87, "timestamp": "00:58:22", "text": "起きている？"}, {"type": "subtitle", "time": 3506.71, "timestamp": "00:58:26", "text": "私は午前1時か12時頃に寝た。"}, {"type": "subtitle", "time": 3509.03, "timestamp": "00:58:29", "text": "[音楽]"}, {"type": "subtitle", "time": 3511.47, "timestamp": "00:58:31", "text": "うん。"}, {"type": "subtitle", "time": 3519.71, "timestamp": "00:58:39", "text": "えっと、待って、午前1時？うん。"}, {"type": "subtitle", "time": 3524.069, "timestamp": "00:58:44", "text": "聖なる。何てことだ。私は興奮しすぎて"}, {"type": "subtitle", "time": 3528.23, "timestamp": "00:58:48", "text": "何らかの理由で夜中に。理由がわからない。"}, {"type": "subtitle", "time": 3530.34, "timestamp": "00:58:50", "text": "うん。"}]
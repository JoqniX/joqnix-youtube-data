[{"type": "subtitle", "time": 2700.069, "timestamp": "00:45:00", "text": "あまりプロフェッショナルでなければならないが、"}, {"type": "subtitle", "time": 2703.47, "timestamp": "00:45:03", "text": "職業経験と"}, {"type": "subtitle", "time": 2706.63, "timestamp": "00:45:06", "text": "レベルが上がると、自分らしく生きる方法を学ばなければなりません"}, {"type": "subtitle", "time": 2709.43, "timestamp": "00:45:09", "text": "その訓練を受けなければならない。さて、どうすれば"}, {"type": "subtitle", "time": 2711.67, "timestamp": "00:45:11", "text": "もっとプロらしく振る舞うべきではないでしょうか？それが理由です"}, {"type": "subtitle", "time": 2715.99, "timestamp": "00:45:15", "text": "人々はPRのトレーニングを受け、これらすべてを"}, {"type": "subtitle", "time": 2718.55, "timestamp": "00:45:18", "text": "選挙活動関連資料。多くのことが"}, {"type": "subtitle", "time": 2721.19, "timestamp": "00:45:21", "text": "誰かがあなたにこう教えてくれる"}, {"type": "subtitle", "time": 2724.79, "timestamp": "00:45:24", "text": "振る舞うべきなど。これらは"}, {"type": "subtitle", "time": 2739.47, "timestamp": "00:45:39", "text": "はい。"}, {"type": "subtitle", "time": 2754.15, "timestamp": "00:45:54", "text": "ええ、そうですね、時々私は"}, {"type": "subtitle", "time": 2757.99, "timestamp": "00:45:57", "text": "このようにする。わかった。"}]
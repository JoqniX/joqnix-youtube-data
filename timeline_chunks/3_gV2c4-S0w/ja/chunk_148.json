[{"type": "subtitle", "time": 8888.55, "timestamp": "02:28:08", "text": "チャド、見てごらん、彼らは本当にいい人たちだよ。彼らはいた"}, {"type": "subtitle", "time": 8905.15, "timestamp": "02:28:25", "text": "見て、"}, {"type": "subtitle", "time": 8910.19, "timestamp": "02:28:30", "text": "私はします。ツリー全体をライトアップする必要がある。"}, {"type": "subtitle", "time": 8914.55, "timestamp": "02:28:34", "text": "えっと、枝とかそういうやつ。見る、"}, {"type": "subtitle", "time": 8918.469, "timestamp": "02:28:38", "text": "これでモンスターが出現するようになります。"}]
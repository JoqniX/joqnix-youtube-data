[{"type": "subtitle", "time": 18061.55, "timestamp": "05:01:01", "text": "悲しかった時のことを思い出す"}, {"type": "subtitle", "time": 18064.47, "timestamp": "05:01:04", "text": "ストリームでは多くの人がチャットで次のように言っていました"}, {"type": "subtitle", "time": 18067.43, "timestamp": "05:01:07", "text": "うん、心配しないで、"}, {"type": "subtitle", "time": 18068.868, "timestamp": "05:01:08", "text": "もちろん、"}, {"type": "subtitle", "time": 18069.948, "timestamp": "05:01:09", "text": "欲しがる"}, {"type": "subtitle", "time": 18074.19, "timestamp": "05:01:14", "text": "あなたとつながり、協力し、"}, {"type": "subtitle", "time": 18077.07, "timestamp": "05:01:17", "text": "いろいろあるけど"}, {"type": "subtitle", "time": 18080.03, "timestamp": "05:01:20", "text": "うん"}, {"type": "subtitle", "time": 18082.788, "timestamp": "05:01:22", "text": "でも今日は2つ手に入れることができた"}, {"type": "subtitle", "time": 18086.91, "timestamp": "05:01:26", "text": "コラボレーション"}, {"type": "subtitle", "time": 18091.31, "timestamp": "05:01:31", "text": "ええと、1つは「Yeah」でした。いいえ、３つ"}, {"type": "subtitle", "time": 18095.51, "timestamp": "05:01:35", "text": "実は。えっと、そのうち2つは、"}, {"type": "subtitle", "time": 18097.59, "timestamp": "05:01:37", "text": "相互作用ですが、私たちは相互作用しました"}, {"type": "subtitle", "time": 18100.19, "timestamp": "05:01:40", "text": "テキストの前"}, {"type": "subtitle", "time": 18107.628, "timestamp": "05:01:47", "text": "[音楽]"}, {"type": "subtitle", "time": 18112.43, "timestamp": "05:01:52", "text": "えっと、犬、このバカ。はぁ？何"}, {"type": "subtitle", "time": 18116.788, "timestamp": "05:01:56", "text": "何が起こったのか？寝る。ああ、なんてことだ、君は怖がっている"}, {"type": "subtitle", "time": 18119.99, "timestamp": "05:01:59", "text": "私、ブラアです。 「おい、俺は何をしたんだ？」って感じだった。"}]
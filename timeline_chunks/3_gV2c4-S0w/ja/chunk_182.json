[{"type": "subtitle", "time": 10928.11, "timestamp": "03:02:08", "text": "人々。つまり、えっと"}, {"type": "subtitle", "time": 10930.87, "timestamp": "03:02:10", "text": "探検、探検、探検。おお。"}, {"type": "subtitle", "time": 10934.269, "timestamp": "03:02:14", "text": "人を殺す時間だ。なるほど"}, {"type": "subtitle", "time": 10936.95, "timestamp": "03:02:16", "text": "仕事が人を殺す。私はすでに３人持っています"}, {"type": "subtitle", "time": 10950.469, "timestamp": "03:02:30", "text": "大豆が含まれています。あぁ、ゲームがクラッシュしたみたい。"}, {"type": "subtitle", "time": 10958.19, "timestamp": "03:02:38", "text": "地図、世界地図、"}, {"type": "subtitle", "time": 10961.59, "timestamp": "03:02:41", "text": "サーバーからログアウトしたか、それともまだログアウトしていないか"}, {"type": "subtitle", "time": 10963.269, "timestamp": "03:02:43", "text": "まだそこにいるの？"}, {"type": "subtitle", "time": 10966.309, "timestamp": "03:02:46", "text": "サーバーに参加してください。わかった。"}, {"type": "subtitle", "time": 10968.95, "timestamp": "03:02:48", "text": "待って、スクリーンショットのキーは何だったっけ？"}, {"type": "subtitle", "time": 10972.55, "timestamp": "03:02:52", "text": "スクリーンショットが撮れません。私はそれを信じます"}]
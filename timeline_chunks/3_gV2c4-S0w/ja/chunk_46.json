[{"type": "subtitle", "time": 2761.069, "timestamp": "00:46:01", "text": "いいえ、"}, {"type": "subtitle", "time": 2765.91, "timestamp": "00:46:05", "text": "えーと、時々私は、えーと、私は"}, {"type": "subtitle", "time": 2769.75, "timestamp": "00:46:09", "text": "そういう意味で私も時々"}, {"type": "subtitle", "time": 2772.27, "timestamp": "00:46:12", "text": "他の人の立場になって考えてみてください"}, {"type": "subtitle", "time": 2776.63, "timestamp": "00:46:16", "text": "うん、友達が私を招待してくれた"}, {"type": "subtitle", "time": 2778.27, "timestamp": "00:46:18", "text": "彼らが私を招待してくれた"}, {"type": "subtitle", "time": 2781.109, "timestamp": "00:46:21", "text": "コラボ配信で、彼らがそれを主催しています"}, {"type": "subtitle", "time": 2783.67, "timestamp": "00:46:23", "text": "そして彼らが主催するのは今回が初めてで、"}, {"type": "subtitle", "time": 2786.63, "timestamp": "00:46:26", "text": "彼らがどのように適応していくかを見れば、私はそれが分かる。"}, {"type": "subtitle", "time": 2788.71, "timestamp": "00:46:28", "text": "それへ。コラボレーションであることのプレッシャー"}, {"type": "subtitle", "time": 2791.51, "timestamp": "00:46:31", "text": "ホスト、人々に連絡、DM、"}, {"type": "subtitle", "time": 2792.91, "timestamp": "00:46:32", "text": "DMを作成する"}, {"type": "subtitle", "time": 2795.829, "timestamp": "00:46:35", "text": "グループ、参加者全員が"}, {"type": "subtitle", "time": 2798.51, "timestamp": "00:46:38", "text": "ゲームは、インストールされたもの、"}, {"type": "subtitle", "time": 2802.15, "timestamp": "00:46:42", "text": "アストラのようなすべてのもの"}, {"type": "subtitle", "time": 2804.79, "timestamp": "00:46:44", "text": "出産時のSMPとかを台無しにするんだよね？彼は"}, {"type": "subtitle", "time": 2808.309, "timestamp": "00:46:48", "text": "一人ひとりの手作業で行く"}, {"type": "subtitle", "time": 2810.23, "timestamp": "00:46:50", "text": "そこにいた人たちと、"}, {"type": "subtitle", "time": 2812.47, "timestamp": "00:46:52", "text": "全員がMODなどをインストール済みで、"}, {"type": "subtitle", "time": 2815.71, "timestamp": "00:46:55", "text": "などなど。それでも、人々のような人たちがいた。"}, {"type": "subtitle", "time": 2819.349, "timestamp": "00:46:59", "text": "彼が管理できなかったのは、"}]
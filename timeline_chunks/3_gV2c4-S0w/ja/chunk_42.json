[{"type": "subtitle", "time": 2520.95, "timestamp": "00:42:00", "text": "登録も済ませました。私たちは"}, {"type": "subtitle", "time": 2523.27, "timestamp": "00:42:03", "text": "コラボや、それらを見たとき"}, {"type": "subtitle", "time": 2527.069, "timestamp": "00:42:07", "text": "私のボードブレイクからのコラボレーション"}, {"type": "subtitle", "time": 2529.39, "timestamp": "00:42:09", "text": "あれ、私はこう思う、"}, {"type": "subtitle", "time": 2531.71, "timestamp": "00:42:11", "text": "「わあ、私はまだ"}, {"type": "subtitle", "time": 2535.67, "timestamp": "00:42:15", "text": "彼が私に言ったことを覚えておいてください。どれくらいですか"}, {"type": "subtitle", "time": 2540.15, "timestamp": "00:42:20", "text": "彼がどれだけ指導したかのような男"}, {"type": "subtitle", "time": 2545.03, "timestamp": "00:42:25", "text": "物事について自分の考えを述べた"}, {"type": "subtitle", "time": 2547.349, "timestamp": "00:42:27", "text": "など私が物事について話していたとき"}, {"type": "subtitle", "time": 2549.91, "timestamp": "00:42:29", "text": "再血液化とか、その他諸々について。ええ、私は"}, {"type": "subtitle", "time": 2552.19, "timestamp": "00:42:32", "text": "今でも覚えている"}, {"type": "subtitle", "time": 2555.109, "timestamp": "00:42:35", "text": "それ。そう、そういう類のことだ。"}, {"type": "subtitle", "time": 2557.109, "timestamp": "00:42:37", "text": "私はただ最善を尽くして"}, {"type": "subtitle", "time": 2559.75, "timestamp": "00:42:39", "text": "プロフェッショナルなことなど"}, {"type": "subtitle", "time": 2562.63, "timestamp": "00:42:42", "text": "企業系YouTuberとのコラボレーション。"}, {"type": "subtitle", "time": 2565.03, "timestamp": "00:42:45", "text": "その頃、私はコラボレーションをしたと思う"}, {"type": "subtitle", "time": 2567.589, "timestamp": "00:42:47", "text": "スタースケープと共に"}, {"type": "subtitle", "time": 2570.87, "timestamp": "00:42:50", "text": "才能とかそういうもの。だから私は"}, {"type": "subtitle", "time": 2574.069, "timestamp": "00:42:54", "text": "彼らもよりプロフェッショナルで、"}, {"type": "subtitle", "time": 2576.91, "timestamp": "00:42:56", "text": "彼らの持ち物が何なのかを知ること。"}]
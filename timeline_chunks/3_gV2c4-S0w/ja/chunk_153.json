[{"type": "subtitle", "time": 9199.59, "timestamp": "02:33:19", "text": "彼らはファンを作っています"}, {"type": "subtitle", "time": 9204.55, "timestamp": "02:33:24", "text": "そして彼らはミックスファンのよう"}, {"type": "subtitle", "time": 9211.99, "timestamp": "02:33:31", "text": "ああ、ファンコンテストを開催しているのですか、それとも"}, {"type": "subtitle", "time": 9213.71, "timestamp": "02:33:33", "text": "何か？"}, {"type": "subtitle", "time": 9217.51, "timestamp": "02:33:37", "text": "いや、知らないわけじゃないよ。彼らはただ"}, {"type": "subtitle", "time": 9219.67, "timestamp": "02:33:39", "text": "ファンファイアを執筆中。"}, {"type": "subtitle", "time": 9223.59, "timestamp": "02:33:43", "text": "ああ、それで、それはどこで開催されるんですか？何"}, {"type": "subtitle", "time": 9225.67, "timestamp": "02:33:45", "text": "パッドか何かを入れるか、"}, {"type": "subtitle", "time": 9228.79, "timestamp": "02:33:48", "text": "不和？いや、いや。ああ、彼らはそれを置いただけだ"}, {"type": "subtitle", "time": 9231.91, "timestamp": "02:33:51", "text": "その場で。絵を描こうかな"}, {"type": "subtitle", "time": 9234.15, "timestamp": "02:33:54", "text": "まるで漫画のコマを描きたいみたいだ"}, {"type": "subtitle", "time": 9234.99, "timestamp": "02:33:54", "text": "全体"}, {"type": "subtitle", "time": 9239.309, "timestamp": "02:33:59", "text": "魂。私がやります。"}]
[{"type": "subtitle", "time": 8100.51, "timestamp": "02:15:00", "text": "遅れ？何が私の心を蝕んでいるのか"}, {"type": "subtitle", "time": 8104.35, "timestamp": "02:15:04", "text": "PC？この男。最後にしましょう"}, {"type": "subtitle", "time": 8107.27, "timestamp": "02:15:07", "text": "今すぐ。よし、これでいい。そこには"}, {"type": "subtitle", "time": 8143.669, "timestamp": "02:15:43", "text": "えっと、友達を送ろう。こちらと同じ名前です。"}, {"type": "subtitle", "time": 8144.669, "timestamp": "02:15:44", "text": "オカ。"}, {"type": "subtitle", "time": 8147.75, "timestamp": "02:15:47", "text": "ガッチャ。必ず友達を派遣します"}]
[{"type": "subtitle", "time": 784.47, "timestamp": "00:13:04", "text": "でもそれはちょっと失礼だったし、そうだけど私は"}, {"type": "subtitle", "time": 787.949, "timestamp": "00:13:07", "text": "すべて自分のせいだと感じている。そうなんですか？"}, {"type": "subtitle", "time": 791.91, "timestamp": "00:13:11", "text": "なぜ？いや、なぜそう思うのか教えてあげよう"}, {"type": "subtitle", "time": 795.069, "timestamp": "00:13:15", "text": "そんな感じ。それは"}, {"type": "chat", "time": 797.538, "timestamp": "00:13:17", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "after I mentioned that, it's been a daily thing you worry constantly"}, {"type": "subtitle", "time": 798.389, "timestamp": "00:13:18", "text": "えっと、それは、いや、"}, {"type": "subtitle", "time": 801.15, "timestamp": "00:13:21", "text": "あなたが言うタイミング"}, {"type": "subtitle", "time": 807.99, "timestamp": "00:13:27", "text": "私がそれが日常的なことだと言った後だった"}, {"type": "subtitle", "time": 811.71, "timestamp": "00:13:31", "text": "あなたは常に心配している。いや、むしろこうだ"}, {"type": "subtitle", "time": 816.509, "timestamp": "00:13:36", "text": "えっと、つまり、"}, {"type": "subtitle", "time": 819.67, "timestamp": "00:13:39", "text": "あなたがそうすることを選んだ日が"}, {"type": "subtitle", "time": 821.91, "timestamp": "00:13:41", "text": "私は実際に一歩を踏み出すことを選んだ。"}, {"type": "subtitle", "time": 825.43, "timestamp": "00:13:45", "text": "先へ進み、より自信を持ち、"}, {"type": "subtitle", "time": 828.55, "timestamp": "00:13:48", "text": "自分のことをオープンにして、そう、スポーツマン"}, {"type": "subtitle", "time": 831.269, "timestamp": "00:13:51", "text": "臆病者になるな、君ならできる"}, {"type": "subtitle", "time": 833.829, "timestamp": "00:13:53", "text": "まるであなたがこれをやってきたかのように"}, {"type": "subtitle", "time": 837.43, "timestamp": "00:13:57", "text": "しばらくの間、連絡を取ってみてください"}, {"type": "subtitle", "time": 839.35, "timestamp": "00:13:59", "text": "以前に連絡を取ったことのある人々と"}]
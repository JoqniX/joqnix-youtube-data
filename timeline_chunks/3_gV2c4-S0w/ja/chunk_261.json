[{"type": "subtitle", "time": 15660.83, "timestamp": "04:21:00", "text": "ええと、わかりました。何が"}, {"type": "subtitle", "time": 15665.55, "timestamp": "04:21:05", "text": "ええ、彼女はカナダって言ってました。"}, {"type": "subtitle", "time": 15667.55, "timestamp": "04:21:07", "text": "それで、"}, {"type": "subtitle", "time": 15682.75, "timestamp": "04:21:22", "text": "何？カナダは何度もそうしてきた。"}, {"type": "subtitle", "time": 15700.71, "timestamp": "04:21:40", "text": "おお。午後2時午後3時午後3時午後4時午後6時"}, {"type": "subtitle", "time": 15702.99, "timestamp": "04:21:42", "text": "午後7時5:00"}, {"type": "subtitle", "time": 15712.269, "timestamp": "04:21:52", "text": "えっと、待って。トロントは"}]
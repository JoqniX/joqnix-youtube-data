[{"type": "subtitle", "time": 11892.95, "timestamp": "03:18:12", "text": "いいですね。"}, {"type": "subtitle", "time": 11895.83, "timestamp": "03:18:15", "text": "じゃあ、私は行くね。さよなら。さよなら。さよなら。"}, {"type": "subtitle", "time": 11908.15, "timestamp": "03:18:28", "text": "えっと、睡眠時間を入れさせてください。置かせてください"}, {"type": "subtitle", "time": 11915.19, "timestamp": "03:18:35", "text": "そうそう。少なくとも朝はゆっくり寝られる"}, {"type": "subtitle", "time": 11927.15, "timestamp": "03:18:47", "text": "私は創造的な人間だと気づいた。私"}, {"type": "subtitle", "time": 11930.229, "timestamp": "03:18:50", "text": "見る。ああ、じゃあ待って。いつ配信しますか？"}, {"type": "subtitle", "time": 11938.19, "timestamp": "03:18:58", "text": "水曜日に配信できると思います。"}]
[{"type": "subtitle", "time": 191.50900000000001, "timestamp": "00:03:11", "text": "明日。私は帰るべきではなかった"}, {"type": "subtitle", "time": 199.43, "timestamp": "00:03:19", "text": "えっと、今週末。来週はとても忙しい。"}, {"type": "subtitle", "time": 204.22899999999998, "timestamp": "00:03:24", "text": "きつい。きついよ、兄弟。窮屈だ。いいえ、"}, {"type": "subtitle", "time": 207.07, "timestamp": "00:03:27", "text": "来週は"}, {"type": "subtitle", "time": 210.309, "timestamp": "00:03:30", "text": "きつい。次は、来週は大変なことになりそうだ。"}, {"type": "subtitle", "time": 212.949, "timestamp": "00:03:32", "text": "崩壊、崩壊。"}, {"type": "subtitle", "time": 215.03, "timestamp": "00:03:35", "text": "たった3つしかないという事実"}, {"type": "subtitle", "time": 218.22899999999998, "timestamp": "00:03:38", "text": "先週と同じように、残り日数が少なくなってきた。"}, {"type": "subtitle", "time": 221.86, "timestamp": "00:03:41", "text": "今週は今月は"}, {"type": "subtitle", "time": 223.789, "timestamp": "00:03:43", "text": "[音楽]"}, {"type": "subtitle", "time": 227.149, "timestamp": "00:03:47", "text": "クレイジー。でも、それはそういうことなんです"}, {"type": "subtitle", "time": 230.19, "timestamp": "00:03:50", "text": "は。それで"}, {"type": "subtitle", "time": 232.51, "timestamp": "00:03:52", "text": "すると私はとても"}]
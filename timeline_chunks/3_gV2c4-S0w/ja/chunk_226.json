[{"type": "subtitle", "time": 13561.51, "timestamp": "03:46:01", "text": "最近ではそうではない。何が起こっているのか分かりません。"}, {"type": "subtitle", "time": 13564.91, "timestamp": "03:46:04", "text": "音楽はなかった"}, {"type": "subtitle", "time": 13568.67, "timestamp": "03:46:08", "text": "クラス。まるで自分のコースみたい"}, {"type": "subtitle", "time": 13572.469, "timestamp": "03:46:12", "text": "終わったけど、まだそうは感じない"}, {"type": "subtitle", "time": 13575.429, "timestamp": "03:46:15", "text": "小道具など全てをきちんと研究した。しかし"}, {"type": "subtitle", "time": 13577.15, "timestamp": "03:46:17", "text": "彼らは作ったのか"}, {"type": "subtitle", "time": 13579.67, "timestamp": "03:46:19", "text": "新しいグループを作ったのか、それとも"}, {"type": "subtitle", "time": 13582.309, "timestamp": "03:46:22", "text": "何かがあって、えーと、えーと、彼らは私を仲間外れにした"}, {"type": "subtitle", "time": 13585.269, "timestamp": "03:46:25", "text": "それとも何か別のこと？私は混乱しています。"}, {"type": "subtitle", "time": 13587.389, "timestamp": "03:46:27", "text": "でも私はこのAbletonに参加しています"}, {"type": "subtitle", "time": 13591.55, "timestamp": "03:46:31", "text": "ライブ音楽制作コース"}, {"type": "subtitle", "time": 13593.91, "timestamp": "03:46:33", "text": "えっと、4ヶ月。これは4番目です"}, {"type": "subtitle", "time": 13595.389, "timestamp": "03:46:35", "text": "月ですよね？"}]
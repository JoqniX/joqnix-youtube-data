[{"type": "subtitle", "time": 2341.27, "timestamp": "00:39:01", "text": "彼のチャンネルのコミュニティとか、そういうもの。"}, {"type": "subtitle", "time": 2343.71, "timestamp": "00:39:03", "text": "「なんてこった、吸血鬼だ」"}, {"type": "subtitle", "time": 2346.99, "timestamp": "00:39:06", "text": "ストリーマー、歯科医の吸血鬼"}, {"type": "subtitle", "time": 2349.95, "timestamp": "00:39:09", "text": "ストリーマー。彼はとてもクールで"}, {"type": "subtitle", "time": 2353.19, "timestamp": "00:39:13", "text": "あれこれと。」そして私は彼をフォローしました"}, {"type": "subtitle", "time": 2355.589, "timestamp": "00:39:15", "text": "現実と物事は、"}, {"type": "subtitle", "time": 2357.829, "timestamp": "00:39:17", "text": "現実モデルと私が知らないすべて"}, {"type": "subtitle", "time": 2359.829, "timestamp": "00:39:19", "text": "昔は私の側で知っていたし"}, {"type": "subtitle", "time": 2363.589, "timestamp": "00:39:23", "text": "昔の私 私はまた昔は"}, {"type": "subtitle", "time": 2365.75, "timestamp": "00:39:25", "text": "今はプロとして、"}, {"type": "subtitle", "time": 2368.87, "timestamp": "00:39:28", "text": "コラボパートナーは今がベストタイムです"}, {"type": "subtitle", "time": 2371.99, "timestamp": "00:39:31", "text": "たとえ私自身が次のような問題を知っていたとしても"}, {"type": "subtitle", "time": 2375.31, "timestamp": "00:39:35", "text": "私のエネルギーレベルに欠点があり、疲れてしまいます。"}, {"type": "subtitle", "time": 2379.67, "timestamp": "00:39:39", "text": "たくさんあって、もしそれが"}, {"type": "subtitle", "time": 2381.589, "timestamp": "00:39:41", "text": "グループコラボレーションなど、もしあなたがあなたと"}, {"type": "subtitle", "time": 2384.47, "timestamp": "00:39:44", "text": "私も黙り込むことがあるのに気づいた"}, {"type": "subtitle", "time": 2386.55, "timestamp": "00:39:46", "text": "時々、とても。私は何が"}, {"type": "subtitle", "time": 2388.71, "timestamp": "00:39:48", "text": "人々が話している。私はしたくない"}, {"type": "subtitle", "time": 2391.75, "timestamp": "00:39:51", "text": "彼らを追い越す。私は一人でいるように心がけています"}, {"type": "subtitle", "time": 2395.43, "timestamp": "00:39:55", "text": "車線をもっと静かにして、"}, {"type": "subtitle", "time": 2397.55, "timestamp": "00:39:57", "text": "等"}]
[{"type": "subtitle", "time": 7441.189, "timestamp": "02:04:01", "text": "ご覧の通り、これらの部分から"}, {"type": "subtitle", "time": 7443.51, "timestamp": "02:04:03", "text": "少しだけ火をつけてほしい"}, {"type": "subtitle", "time": 7446.55, "timestamp": "02:04:06", "text": "モンスターがここにスポーンしないように"}, {"type": "subtitle", "time": 7450.229, "timestamp": "02:04:10", "text": "こちらを持って、こちらへ"}, {"type": "subtitle", "time": 7454.55, "timestamp": "02:04:14", "text": "これとこれを受け取って"}, {"type": "subtitle", "time": 7457.91, "timestamp": "02:04:17", "text": "えっと、このブロックを"}, {"type": "subtitle", "time": 7460.589, "timestamp": "02:04:20", "text": "枝は、ここのように、"}, {"type": "subtitle", "time": 7463.27, "timestamp": "02:04:23", "text": "ブロックまたは配置"}, {"type": "subtitle", "time": 7465.43, "timestamp": "02:04:25", "text": "それと、提灯を使ってほしいんです。"}, {"type": "subtitle", "time": 7467.03, "timestamp": "02:04:27", "text": "地面にこれらのつる植物が"}, {"type": "subtitle", "time": 7474.109, "timestamp": "02:04:34", "text": "うん。それできますか？でも私は"}, {"type": "subtitle", "time": 7477.51, "timestamp": "02:04:37", "text": "その間、家。えっと、"}, {"type": "subtitle", "time": 7480.31, "timestamp": "02:04:40", "text": "この枝を木材で伸ばすのですか？もし"}, {"type": "subtitle", "time": 7482.149, "timestamp": "02:04:42", "text": "あなたはただ自分の創造性を発揮したいだけなのです。私"}]
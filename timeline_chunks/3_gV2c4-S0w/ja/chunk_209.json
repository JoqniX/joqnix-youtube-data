[{"type": "subtitle", "time": 12542.11, "timestamp": "03:29:02", "text": "うん。切る必要がある"}, {"type": "subtitle", "time": 12545.269, "timestamp": "03:29:05", "text": "これは私が夕食に出かけた時のことです。これは"}, {"type": "subtitle", "time": 12546.83, "timestamp": "03:29:06", "text": "12歳の時のように。"}, {"type": "subtitle", "time": 12549.91, "timestamp": "03:29:09", "text": "いや、全部寝て済ませたと思う"}, {"type": "subtitle", "time": 12565.15, "timestamp": "03:29:25", "text": "左。わかった。から"}, {"type": "subtitle", "time": 12576.349, "timestamp": "03:29:36", "text": "エクスポートしてからエクスポートすると、私は知っています"}, {"type": "subtitle", "time": 12579.269, "timestamp": "03:29:39", "text": "すべて既にエクスポートされています。"}, {"type": "subtitle", "time": 12581.07, "timestamp": "03:29:41", "text": "法的に"}, {"type": "subtitle", "time": 12586.63, "timestamp": "03:29:46", "text": "ブラインド、オーケー、パート2 60、それから61"}, {"type": "subtitle", "time": 12590.389, "timestamp": "03:29:50", "text": "それは昨日の配信です、待って、何ですか"}]
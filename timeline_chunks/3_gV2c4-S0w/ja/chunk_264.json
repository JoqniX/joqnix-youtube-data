[{"type": "subtitle", "time": 15861.389, "timestamp": "04:24:21", "text": "男。えっと、私は"}, {"type": "subtitle", "time": 15877.83, "timestamp": "04:24:37", "text": "待って、それ持ってるっけ？そう思う。私たちは"}, {"type": "subtitle", "time": 15879.389, "timestamp": "04:24:39", "text": "速く演奏"}, {"type": "subtitle", "time": 15883.11, "timestamp": "04:24:43", "text": "えっと、PS2も一緒にですよね？ええ、そうしました"}]
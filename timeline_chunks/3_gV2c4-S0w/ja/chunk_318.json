[{"type": "subtitle", "time": 19082.39, "timestamp": "05:18:02", "text": "最近の私にとっては、準備がほぼできているので"}, {"type": "subtitle", "time": 19085.55, "timestamp": "05:18:05", "text": "毛布にくるまって寝る"}, {"type": "subtitle", "time": 19087.39, "timestamp": "05:18:07", "text": "すぐ。"}, {"type": "subtitle", "time": 19089.83, "timestamp": "05:18:09", "text": "うん。まあ、調子はどう？そうそう。"}, {"type": "subtitle", "time": 19092.39, "timestamp": "05:18:12", "text": "あなたはそれに対して返答しましたね。うん。どうやって"}, {"type": "subtitle", "time": 19094.35, "timestamp": "05:18:14", "text": "あなたは私を見つける"}, {"type": "subtitle", "time": 19096.948, "timestamp": "05:18:16", "text": "今日？私を見つける人は稀です"}, {"type": "subtitle", "time": 19097.948, "timestamp": "05:18:17", "text": "の上"}, {"type": "subtitle", "time": 19106.75, "timestamp": "05:18:26", "text": "[音楽]"}, {"type": "subtitle", "time": 19109.788, "timestamp": "05:18:29", "text": "えっと、どうして私が熱くなるんだろう"}, {"type": "subtitle", "time": 19113.868, "timestamp": "05:18:33", "text": "朝食？うん。さよなら。朝食を食べる"}, {"type": "subtitle", "time": 19117.07, "timestamp": "05:18:37", "text": "4時"}, {"type": "subtitle", "time": 19119.15, "timestamp": "05:18:39", "text": "午前。"}, {"type": "subtitle", "time": 19123.03, "timestamp": "05:18:43", "text": "えっと、ちょっと待って。あなたは日本に住んでいますか？"}, {"type": "subtitle", "time": 19127.39, "timestamp": "05:18:47", "text": "時間？バカ、7時だよ。"}, {"type": "subtitle", "time": 19133.47, "timestamp": "05:18:53", "text": "えっと、午前7時です。午前7時30分です。"}, {"type": "subtitle", "time": 19135.67, "timestamp": "05:18:55", "text": "日本。ああ、もう"}, {"type": "subtitle", "time": 19138.47, "timestamp": "05:18:58", "text": "日本風の振る舞いを練習している。私"}, {"type": "subtitle", "time": 19139.948, "timestamp": "05:18:59", "text": "私は試してみましたが、"}]
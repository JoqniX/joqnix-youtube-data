[{"type": "subtitle", "time": 14287.95, "timestamp": "03:58:07", "text": "役職。私の投稿を見てくれてありがとう"}, {"type": "subtitle", "time": 14299.91, "timestamp": "03:58:19", "text": "こんにちは。あ、待って。カフェゲーム。ああ、私は言った"}, {"type": "subtitle", "time": 14304.55, "timestamp": "03:58:24", "text": "私がベータテストを行うのはこれらです。 Oから"}, {"type": "subtitle", "time": 14306.71, "timestamp": "03:58:26", "text": "ああ、神様。明日。何があっても、私は"}, {"type": "subtitle", "time": 14308.83, "timestamp": "03:58:28", "text": "そのゲームに参加しなければならない。おお"}, {"type": "subtitle", "time": 14311.79, "timestamp": "03:58:31", "text": "神。"}, {"type": "subtitle", "time": 14314.71, "timestamp": "03:58:34", "text": "えーと、私がそれを忘れ続けているという事実は"}, {"type": "subtitle", "time": 14326.87, "timestamp": "03:58:46", "text": "これらすべてに関して混乱している"}, {"type": "subtitle", "time": 14330.429, "timestamp": "03:58:50", "text": "もの。えーと、難しいですね"}, {"type": "subtitle", "time": 14334.229, "timestamp": "03:58:54", "text": "すべてを理解するのは難しい"}, {"type": "subtitle", "time": 14337.229, "timestamp": "03:58:57", "text": "これらのもの。ええと、そうですね。私はあなたが"}]
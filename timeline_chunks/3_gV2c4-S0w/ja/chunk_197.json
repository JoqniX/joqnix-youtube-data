[{"type": "subtitle", "time": 11821.83, "timestamp": "03:17:01", "text": "え、犬を見たいの？待って、"}, {"type": "subtitle", "time": 11824.79, "timestamp": "03:17:04", "text": "私が何を見ているか"}, {"type": "subtitle", "time": 11837.349, "timestamp": "03:17:17", "text": "どこ？どこ？ああ、D。ああ。"}, {"type": "subtitle", "time": 11840.429, "timestamp": "03:17:20", "text": "ああ、読み込みが始まった。"}, {"type": "subtitle", "time": 11843.11, "timestamp": "03:17:23", "text": "わかった。では、再生とは一体何でしょうか？"}, {"type": "subtitle", "time": 11845.07, "timestamp": "03:17:25", "text": "この火事の中で？"}, {"type": "subtitle", "time": 11847.99, "timestamp": "03:17:27", "text": "何？この焚き火の近くでは、体力が回復します。"}, {"type": "subtitle", "time": 11851.429, "timestamp": "03:17:31", "text": "見る？おお。"}, {"type": "subtitle", "time": 11862.12, "timestamp": "03:17:42", "text": "後で完成させました。"}, {"type": "subtitle", "time": 11869.269, "timestamp": "03:17:49", "text": "4秒ごとに再生します。 5秒。"}]
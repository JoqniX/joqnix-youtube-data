[{"type": "subtitle", "time": 9301.67, "timestamp": "02:35:01", "text": "だって、私はこうやってたから"}, {"type": "subtitle", "time": 9305.59, "timestamp": "02:35:05", "text": "かつての私は混乱していた"}, {"type": "subtitle", "time": 9309.429, "timestamp": "02:35:09", "text": "誰かガイドラインを作ろうとしている"}, {"type": "subtitle", "time": 9313.23, "timestamp": "02:35:13", "text": "クリップを投稿したり何か"}, {"type": "subtitle", "time": 9316.55, "timestamp": "02:35:16", "text": "公に。えっと、これはひどい"}, {"type": "subtitle", "time": 9322.75, "timestamp": "02:35:22", "text": "私が経験したことは、えっと、えっと、"}, {"type": "subtitle", "time": 9325.67, "timestamp": "02:35:25", "text": "えっと、なんて言うんだっけ？えーと、ファンが"}, {"type": "subtitle", "time": 9329.67, "timestamp": "02:35:29", "text": "ランダムなファンや視聴者が"}, {"type": "subtitle", "time": 9334.67, "timestamp": "02:35:34", "text": "音楽や、FN FNAF のような音楽"}, {"type": "subtitle", "time": 9338.71, "timestamp": "02:35:38", "text": "音楽はFNFですか、それとも何らかのリズムですか"}, {"type": "subtitle", "time": 9340.429, "timestamp": "02:35:40", "text": "音楽関連のもの"}, {"type": "subtitle", "time": 9345.51, "timestamp": "02:35:45", "text": "そして彼らは何かをして、ある意味で"}, {"type": "subtitle", "time": 9349.27, "timestamp": "02:35:49", "text": "えーと、ビデオには何も入っていません"}, {"type": "subtitle", "time": 9352.55, "timestamp": "02:35:52", "text": "あなたに関係するもの、またはあなたに関係するものですが、"}, {"type": "subtitle", "time": 9354.429, "timestamp": "02:35:54", "text": "彼らはあなたのPNGと"}, {"type": "subtitle", "time": 9358.87, "timestamp": "02:35:58", "text": "それを置いてください。だからある意味では"}]
[{"type": "subtitle", "time": 4923.75, "timestamp": "01:22:03", "text": "もの。つまり、プラグインは"}, {"type": "subtitle", "time": 4925.99, "timestamp": "01:22:05", "text": "そういうことか？"}, {"type": "subtitle", "time": 4928.47, "timestamp": "01:22:08", "text": "プラグインは別物です。"}, {"type": "subtitle", "time": 4931.99, "timestamp": "01:22:11", "text": "データパックも異なります。"}, {"type": "subtitle", "time": 4934.31, "timestamp": "01:22:14", "text": "なぜこんなにたくさんの3つの異なる"}, {"type": "subtitle", "time": 4950.27, "timestamp": "01:22:30", "text": "それ。コブルムーン。"}, {"type": "subtitle", "time": 4968.27, "timestamp": "01:22:48", "text": "水中"}, {"type": "subtitle", "time": 4970.59, "timestamp": "01:22:50", "text": "遺跡。持ち続ける"}, {"type": "subtitle", "time": 4973.27, "timestamp": "01:22:53", "text": "呼吸。ゲーム内で水中に入ると、"}, {"type": "subtitle", "time": 4975.189, "timestamp": "01:22:55", "text": "実際に息を止めなければならない"}]
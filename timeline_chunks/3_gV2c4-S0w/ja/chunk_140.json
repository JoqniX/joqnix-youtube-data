[{"type": "subtitle", "time": 8401.19, "timestamp": "02:20:01", "text": "何？ええ、ブロックがいくつか欠けていますね。"}, {"type": "subtitle", "time": 8403.27, "timestamp": "02:20:03", "text": "おお、"}, {"type": "subtitle", "time": 8405.83, "timestamp": "02:20:05", "text": "君たちは何をしているの？"}, {"type": "subtitle", "time": 8413.63, "timestamp": "02:20:13", "text": "削除すべきだ"}, {"type": "subtitle", "time": 8416.76, "timestamp": "02:20:16", "text": "今。君たち"}, {"type": "subtitle", "time": 8418.15, "timestamp": "02:20:18", "text": "[音楽]"}, {"type": "subtitle", "time": 8428.389, "timestamp": "02:20:28", "text": "さあ、君は寝ていないよ。"}, {"type": "subtitle", "time": 8431.349, "timestamp": "02:20:31", "text": "そうしなければならないのですか？"}, {"type": "subtitle", "time": 8434.15, "timestamp": "02:20:34", "text": "なぜ？なぜ眠らないのですか？ええ、持っています"}, {"type": "subtitle", "time": 8435.15, "timestamp": "02:20:35", "text": "に。"}, {"type": "subtitle", "time": 8438.71, "timestamp": "02:20:38", "text": "ええ、そういうこともありますね。ええ、それは"}, {"type": "chat", "time": 8445.004, "timestamp": "02:20:45", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "hey hey joqqy"}, {"type": "chat", "time": 8449.571, "timestamp": "02:20:49", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "u still up?"}]
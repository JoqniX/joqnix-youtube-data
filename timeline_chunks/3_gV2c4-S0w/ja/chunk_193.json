[{"type": "subtitle", "time": 11586.55, "timestamp": "03:13:06", "text": "おお。地図に印をつけておきました。何が"}, {"type": "subtitle", "time": 11589.429, "timestamp": "03:13:09", "text": "この場所の名前は？"}, {"type": "subtitle", "time": 11592.349, "timestamp": "03:13:12", "text": "ああ、神様。ああ、神様。二人に襲われた。おお"}, {"type": "subtitle", "time": 11600.309, "timestamp": "03:13:20", "text": "神。私は海の中にいます。私は水の中にいます。"}, {"type": "subtitle", "time": 11603.349, "timestamp": "03:13:23", "text": "私は虚無の中にいる。ああ、神様。いいえ。ここはどこですか？"}, {"type": "subtitle", "time": 11605.67, "timestamp": "03:13:25", "text": "何てことだ。"}, {"type": "subtitle", "time": 11607.309, "timestamp": "03:13:27", "text": "わかった。"}, {"type": "subtitle", "time": 11613.99, "timestamp": "03:13:33", "text": "どうでも。わからない。"}, {"type": "subtitle", "time": 11617.91, "timestamp": "03:13:37", "text": "私はただ名前をつけるだけにならないようにしている。何？あなた あなた"}, {"type": "subtitle", "time": 11630.71, "timestamp": "03:13:50", "text": "何？わかった。私の子供が何と呼ぶか​​知ってる？"}, {"type": "subtitle", "time": 11635.269, "timestamp": "03:13:55", "text": "ボナボナバウアーボナ？わからない"}, {"type": "subtitle", "time": 11637.79, "timestamp": "03:13:57", "text": "これですか"}]
[{"type": "subtitle", "time": 17340.83, "timestamp": "04:49:00", "text": "辛抱強く待っていて、私は説明した"}, {"type": "subtitle", "time": 17342.35, "timestamp": "04:49:02", "text": "彼ら"}, {"type": "subtitle", "time": 17346.31, "timestamp": "04:49:06", "text": "適切にすべてを手に入れるようにする"}, {"type": "subtitle", "time": 17348.47, "timestamp": "04:49:08", "text": "そうすれば彼らは理解できるだろう、私は"}, {"type": "subtitle", "time": 17350.51, "timestamp": "04:49:10", "text": "いいね"}, {"type": "subtitle", "time": 17353.83, "timestamp": "04:49:13", "text": "うん、日本は空虚な人生を送る男性みたいな"}, {"type": "subtitle", "time": 17355.708, "timestamp": "04:49:15", "text": "男性ユーチューバーは"}, {"type": "subtitle", "time": 17358.07, "timestamp": "04:49:18", "text": "存在しないが、それでも試みることはできる"}, {"type": "subtitle", "time": 17361.55, "timestamp": "04:49:21", "text": "運などない、私は"}, {"type": "subtitle", "time": 17366.15, "timestamp": "04:49:26", "text": "ああ、痛みを感じたので、私はただ"}, {"type": "subtitle", "time": 17368.55, "timestamp": "04:49:28", "text": "コラボレーションしたり、知り合いになるための集まりのようなことをする"}, {"type": "subtitle", "time": 17370.03, "timestamp": "04:49:30", "text": "お互いにとって初めてのことだから"}, {"type": "subtitle", "time": 17372.03, "timestamp": "04:49:32", "text": "接続が適切"}, {"type": "subtitle", "time": 17373.868, "timestamp": "04:49:33", "text": "繋がり"}, {"type": "subtitle", "time": 17377.35, "timestamp": "04:49:37", "text": "そして私はただそこに行きたかったのです"}, {"type": "subtitle", "time": 17380.948, "timestamp": "04:49:40", "text": "えっと、あなたは本物のアプローチが好きです"}, {"type": "subtitle", "time": 17383.43, "timestamp": "04:49:43", "text": "時間をかけて、ゆっくり進めて、無理強いしない"}, {"type": "subtitle", "time": 17387.43, "timestamp": "04:49:47", "text": "強制するのではなく、自然にそうさせる。ゆっくりと最初の"}, {"type": "subtitle", "time": 17390.788, "timestamp": "04:49:50", "text": "ch の最初のインタラクション VC コール。見てみて"}, {"type": "subtitle", "time": 17393.75, "timestamp": "04:49:53", "text": "お互いを理解できる。そしてゆっくりと"}, {"type": "subtitle", "time": 17396.15, "timestamp": "04:49:56", "text": "ゆっくりと話をして、お互いを知る"}, {"type": "subtitle", "time": 17399.11, "timestamp": "04:49:59", "text": "そして、彼らがそれで構わないなら、飛び降りる"}]
[{"type": "subtitle", "time": 18540.31, "timestamp": "05:09:00", "text": "トーナメントだよ。地元のドイツ人のように"}, {"type": "subtitle", "time": 18543.19, "timestamp": "05:09:03", "text": "友達の友達のようなノム"}, {"type": "subtitle", "time": 18544.48, "timestamp": "05:09:04", "text": "ホスティング"}, {"type": "subtitle", "time": 18557.948, "timestamp": "05:09:17", "text": "えっと、寝てたの？"}, {"type": "subtitle", "time": 18563.39, "timestamp": "05:09:23", "text": "バッカ・カスタムズ？はい、税関の皆様、ありがとうございます。"}, {"type": "subtitle", "time": 18567.59, "timestamp": "05:09:27", "text": "うん、プラチナみたいなもんだよ。彼らは"}, {"type": "subtitle", "time": 18569.99, "timestamp": "05:09:29", "text": "ダイヤモンドのはずなのにプラチナだった。"}, {"type": "subtitle", "time": 18572.55, "timestamp": "05:09:32", "text": "彼らは私の階級を尋ねた。私はこう思った"}, {"type": "subtitle", "time": 18578.948, "timestamp": "05:09:38", "text": "アンランカーと彼らは「ああ、そうだね」と言いました"}, {"type": "subtitle", "time": 18582.47, "timestamp": "05:09:42", "text": "プラチナ1とかそういうのと、えっと"}, {"type": "subtitle", "time": 18584.868, "timestamp": "05:09:44", "text": "彼らはパブや"}, {"type": "subtitle", "time": 18589.07, "timestamp": "05:09:49", "text": "普通のゲームなのに、すごく劣等感を感じた"}, {"type": "subtitle", "time": 18592.23, "timestamp": "05:09:52", "text": "コラボレーションするためには、私は"}, {"type": "subtitle", "time": 18598.708, "timestamp": "05:09:58", "text": "ああ、新しいシーズンはまだプレイしてないんだ"}]
[{"type": "subtitle", "time": 19023.03, "timestamp": "05:17:03", "text": "ええ、また配信を始めました"}, {"type": "subtitle", "time": 19048.628, "timestamp": "05:17:28", "text": "それ。ハンナ。ハンナ591、こんにちは、ようこそ"}, {"type": "subtitle", "time": 19052.47, "timestamp": "05:17:32", "text": "小川へ。ようこそ、ようこそ。"}, {"type": "subtitle", "time": 19070.99, "timestamp": "05:17:50", "text": "ブレンダー。私"}, {"type": "subtitle", "time": 19075.03, "timestamp": "05:17:55", "text": "見る。やあ、ジョア。"}, {"type": "subtitle", "time": 19076.948, "timestamp": "05:17:56", "text": "ああ、ありがとう。うん、よかった。良い。どうですか？"}, {"type": "subtitle", "time": 19078.868, "timestamp": "05:17:58", "text": "あなた？私も元気です。それは親切です"}]
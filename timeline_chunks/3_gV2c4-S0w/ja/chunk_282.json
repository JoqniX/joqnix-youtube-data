[{"type": "subtitle", "time": 16922.15, "timestamp": "04:42:02", "text": "すべて、そして私が"}, {"type": "subtitle", "time": 16926.15, "timestamp": "04:42:06", "text": "いつも小川にやって来ていた。えっと"}, {"type": "subtitle", "time": 16930.628, "timestamp": "04:42:10", "text": "これは何年も前のことだけど、えっと、"}, {"type": "subtitle", "time": 16933.19, "timestamp": "04:42:13", "text": "えっと、私は彼らの机の中にいたのですが、"}, {"type": "subtitle", "time": 16935.91, "timestamp": "04:42:15", "text": "遊ぶ。彼らはDiscordのような組織には属していなかった。"}, {"type": "subtitle", "time": 16937.99, "timestamp": "04:42:17", "text": "VCとか色々あったから、それは"}, {"type": "subtitle", "time": 16940.39, "timestamp": "04:42:20", "text": "以前は毎日配信されていたのに。"}, {"type": "subtitle", "time": 16943.35, "timestamp": "04:42:23", "text": "VIPバッジを取得するために使用されました。彼らは覚えている"}, {"type": "subtitle", "time": 16946.47, "timestamp": "04:42:26", "text": "私の名前はすべて、その後も、"}, {"type": "subtitle", "time": 16949.39, "timestamp": "04:42:29", "text": "その後も私は活動していなかった"}, {"type": "subtitle", "time": 16959.19, "timestamp": "04:42:39", "text": "えーと、えーと、1年経っても"}, {"type": "subtitle", "time": 16962.628, "timestamp": "04:42:42", "text": "物、いや、彼らは"}, {"type": "subtitle", "time": 16964.788, "timestamp": "04:42:44", "text": "えーと1年とか、いや、まだ"}, {"type": "subtitle", "time": 16966.75, "timestamp": "04:42:46", "text": "私のことを覚えていて、"}, {"type": "subtitle", "time": 16969.868, "timestamp": "04:42:49", "text": "そういう類のもの"}, {"type": "subtitle", "time": 16974.948, "timestamp": "04:42:54", "text": "でも、でも、私の質問は私が"}, {"type": "subtitle", "time": 16978.15, "timestamp": "04:42:58", "text": "私が言ったことは、ある意味正しかったと思う。"}]
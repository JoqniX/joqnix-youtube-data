[{"type": "subtitle", "time": 17881.19, "timestamp": "04:58:01", "text": "今は、もし私がそうでないなら、そうですね、ということについて考えすぎです。"}, {"type": "subtitle", "time": 17883.75, "timestamp": "04:58:03", "text": "ストリームが視聴者を獲得していない"}, {"type": "subtitle", "time": 17886.55, "timestamp": "04:58:06", "text": "すべて順調に進んでいるので、"}, {"type": "subtitle", "time": 17890.788, "timestamp": "04:58:10", "text": "いろいろ変更するなど。それで、私がそれをどう受け止めたかというと…"}, {"type": "subtitle", "time": 17892.868, "timestamp": "04:58:12", "text": "そういうやり取りは悪いやり取りだ"}, {"type": "subtitle", "time": 17896.99, "timestamp": "04:58:16", "text": "まるで私が"}, {"type": "subtitle", "time": 17900.35, "timestamp": "04:58:20", "text": "コラボレーションは、私が"}, {"type": "subtitle", "time": 17904.628, "timestamp": "04:58:24", "text": "感じてる、というか、感じてる"}, {"type": "subtitle", "time": 17908.59, "timestamp": "04:58:28", "text": "不安な気持ちもあったけど、それでもやった"}, {"type": "subtitle", "time": 17911.35, "timestamp": "04:58:31", "text": "注意を払わずに"}, {"type": "subtitle", "time": 17914.07, "timestamp": "04:58:34", "text": "私が言われたことは何だったのか、言われたことは何だったのか"}, {"type": "subtitle", "time": 17917.75, "timestamp": "04:58:37", "text": "私にとって。たとえ私がそれをしたとしても、私は"}, {"type": "subtitle", "time": 17919.628, "timestamp": "04:58:39", "text": "それについて。私は楽しめるだろうか"}, {"type": "subtitle", "time": 17923.43, "timestamp": "04:58:43", "text": "それ？例えば、たとえ私がそれを楽しんだとしても、"}, {"type": "subtitle", "time": 17927.11, "timestamp": "04:58:47", "text": "二人とも楽しんだし、いろいろと良かった。しかしこれは"}, {"type": "subtitle", "time": 17930.31, "timestamp": "04:58:50", "text": "トランザクション トランザクションコラボレーション。いいえ、それで"}, {"type": "subtitle", "time": 17932.23, "timestamp": "04:58:52", "text": "彼らは視聴回数と数字を見るだろう"}, {"type": "subtitle", "time": 17935.75, "timestamp": "04:58:55", "text": "彼らのチャンネルから。ああ、もし私がこれをアプリしたら"}, {"type": "subtitle", "time": 17937.91, "timestamp": "04:58:57", "text": "私の配信に人が現れました、何人"}]
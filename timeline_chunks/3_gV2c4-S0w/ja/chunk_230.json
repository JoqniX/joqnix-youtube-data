[{"type": "subtitle", "time": 13800.55, "timestamp": "03:50:00", "text": "パート2のストリームを作成します"}, {"type": "subtitle", "time": 13804.07, "timestamp": "03:50:04", "text": "夜の配信が最初です。これは午後になります。"}, {"type": "subtitle", "time": 13805.95, "timestamp": "03:50:05", "text": "午前8時になります。"}, {"type": "subtitle", "time": 13808.269, "timestamp": "03:50:08", "text": "午後"}, {"type": "subtitle", "time": 13811.51, "timestamp": "03:50:11", "text": "IST。終わり。"}, {"type": "subtitle", "time": 13814.15, "timestamp": "03:50:14", "text": "午後8時になります。明日。そして"}, {"type": "subtitle", "time": 13817.269, "timestamp": "03:50:17", "text": "朝のストリームはおそらく"}, {"type": "subtitle", "time": 13818.75, "timestamp": "03:50:18", "text": "午後8時8:00"}, {"type": "subtitle", "time": 13822.87, "timestamp": "03:50:22", "text": "午前中、私のスケジュールは"}, {"type": "subtitle", "time": 13827.189, "timestamp": "03:50:27", "text": "今は完全に壊れています。だから、それは"}, {"type": "subtitle", "time": 13834.11, "timestamp": "03:50:34", "text": "正直に。まるでそうしてはいけないかのように"}, {"type": "subtitle", "time": 13837.67, "timestamp": "03:50:37", "text": "この時間にはもう寝ているはずなのに"}, {"type": "subtitle", "time": 13841.469, "timestamp": "03:50:41", "text": "寝ている。私は10時に寝る予定だった"}, {"type": "subtitle", "time": 13844.469, "timestamp": "03:50:44", "text": "午後でも、コラボして以来、"}, {"type": "subtitle", "time": 13847.79, "timestamp": "03:50:47", "text": "他のプレイヤーとのゲームセッションなどのセッション"}, {"type": "subtitle", "time": 13850.79, "timestamp": "03:50:50", "text": "友達はこういうのが好きで、私もそう思う"}, {"type": "subtitle", "time": 13853.189, "timestamp": "03:50:53", "text": "睡眠スケジュール。睡眠スケジュールはどうなっていますか？"}, {"type": "subtitle", "time": 13854.429, "timestamp": "03:50:54", "text": "何が"}, {"type": "subtitle", "time": 13857.51, "timestamp": "03:50:57", "text": "それ？私は夜型人間になり始めた"}]
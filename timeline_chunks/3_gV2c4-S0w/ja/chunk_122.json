[{"type": "subtitle", "time": 7321.51, "timestamp": "02:02:01", "text": "それだけではありません。"}, {"type": "subtitle", "time": 7332.07, "timestamp": "02:02:12", "text": "[音楽]"}, {"type": "subtitle", "time": 7334.55, "timestamp": "02:02:14", "text": "起動中に問題が発生しました"}, {"type": "subtitle", "time": 7337.51, "timestamp": "02:02:17", "text": "ゲーム。 O"}, {"type": "subtitle", "time": 7341.35, "timestamp": "02:02:21", "text": "うん、そこから先は私に聞いてみて。ああ、それは"}, {"type": "subtitle", "time": 7343.99, "timestamp": "02:02:23", "text": "既に実行中です。わかった。どうでも。それは"}, {"type": "subtitle", "time": 7346.149, "timestamp": "02:02:26", "text": "ウィンドウモードで実行しているからでしょうか？その"}, {"type": "subtitle", "time": 7348.87, "timestamp": "02:02:28", "text": "全く違う、というか何か違う。"}, {"type": "subtitle", "time": 7350.79, "timestamp": "02:02:30", "text": "いいえ。"}, {"type": "subtitle", "time": 7366.27, "timestamp": "02:02:46", "text": "私は"}, {"type": "subtitle", "time": 7368.75, "timestamp": "02:02:48", "text": "神聖"}, {"type": "subtitle", "time": 7375.629, "timestamp": "02:02:55", "text": "本当に自分自身であり、必ず"}, {"type": "subtitle", "time": 7379.99, "timestamp": "02:02:59", "text": "私にとって、それは創造的なテレビ番組だ。"}]
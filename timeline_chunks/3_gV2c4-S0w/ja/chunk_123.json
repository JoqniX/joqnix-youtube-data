[{"type": "subtitle", "time": 7381.229, "timestamp": "02:03:01", "text": "どこ"}, {"type": "subtitle", "time": 7386.149, "timestamp": "02:03:06", "text": "あなた？拡張機能で修正する必要があります"}, {"type": "subtitle", "time": 7391.35, "timestamp": "02:03:11", "text": "世界地図。でも、あぁ、ジョーが入力してる。"}, {"type": "subtitle", "time": 7403.229, "timestamp": "02:03:23", "text": "ジョー。"}, {"type": "subtitle", "time": 7412.35, "timestamp": "02:03:32", "text": "えっ？なぜ？ああ、それは桜だ"}, {"type": "subtitle", "time": 7417.189, "timestamp": "02:03:37", "text": "壁。何てことだ。酸っぱいのも不思議ではない"}, {"type": "subtitle", "time": 7421.83, "timestamp": "02:03:41", "text": "あまりにも多くのものを奪っている。それで？"}, {"type": "subtitle", "time": 7426.95, "timestamp": "02:03:46", "text": "どうやってこれを追加したんですか？クレイジー。"}, {"type": "subtitle", "time": 7430.07, "timestamp": "02:03:50", "text": "さて、あなたにやってもらいたい仕事があります。"}, {"type": "subtitle", "time": 7433.51, "timestamp": "02:03:53", "text": "ここ。ここに来て。降りてくる。"}, {"type": "subtitle", "time": 7435.87, "timestamp": "02:03:55", "text": "あなたに"}, {"type": "subtitle", "time": 7438.229, "timestamp": "02:03:58", "text": "残りの根を完成させる"}]
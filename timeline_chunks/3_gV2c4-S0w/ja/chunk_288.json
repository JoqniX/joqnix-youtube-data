[{"type": "subtitle", "time": 17281.35, "timestamp": "04:48:01", "text": "異なるもの。彼らは考慮しなければならなかった。"}, {"type": "subtitle", "time": 17283.83, "timestamp": "04:48:03", "text": "しかし、それは必ずしも"}, {"type": "subtitle", "time": 17290.07, "timestamp": "04:48:10", "text": "彼らがストリーミング配信しなければならないコラボレーション。いいえ。"}, {"type": "subtitle", "time": 17293.27, "timestamp": "04:48:13", "text": "または、"}, {"type": "subtitle", "time": 17296.27, "timestamp": "04:48:16", "text": "えーっと、私の"}, {"type": "subtitle", "time": 17300.07, "timestamp": "04:48:20", "text": "彼らが考えていたことは、私が必要としていた"}, {"type": "subtitle", "time": 17303.19, "timestamp": "04:48:23", "text": "2,000ドルの件、なぜ私は"}, {"type": "subtitle", "time": 17306.23, "timestamp": "04:48:26", "text": "ジョアトンのことは一般には知られていない"}, {"type": "subtitle", "time": 17308.948, "timestamp": "04:48:28", "text": "あまり知らない新しい視聴者"}, {"type": "subtitle", "time": 17310.788, "timestamp": "04:48:30", "text": "初めて彼らは"}, {"type": "subtitle", "time": 17315.19, "timestamp": "04:48:35", "text": "混乱して、彼らは詮索して考えようとする"}, {"type": "subtitle", "time": 17316.91, "timestamp": "04:48:36", "text": "そして仮定する"}, {"type": "subtitle", "time": 17320.788, "timestamp": "04:48:40", "text": "物事、それから私が好きなもの、"}, {"type": "subtitle", "time": 17323.47, "timestamp": "04:48:43", "text": "イノシシのように話すと"}, {"type": "subtitle", "time": 17326.868, "timestamp": "04:48:46", "text": "そうすれば人々はあなたを見なくなるでしょう、などなど"}, {"type": "subtitle", "time": 17329.628, "timestamp": "04:48:49", "text": "なぜあなたはこんなことを言いたいのですか"}, {"type": "subtitle", "time": 17332.47, "timestamp": "04:48:52", "text": "それと、あなたは私の作品も見ていない"}, {"type": "subtitle", "time": 17335.19, "timestamp": "04:48:55", "text": "内容や、自分が不足している文脈を理解する"}, {"type": "subtitle", "time": 17337.83, "timestamp": "04:48:57", "text": "今はたくさんの背景があるので、私がやったことは"}]
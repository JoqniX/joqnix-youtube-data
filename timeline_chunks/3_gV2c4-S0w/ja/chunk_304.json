[{"type": "subtitle", "time": 18242.948, "timestamp": "05:04:02", "text": "それは素晴らしいことだ。わかった。コラボレーションは"}, {"type": "subtitle", "time": 18246.15, "timestamp": "05:04:06", "text": "私にとっては楽しいはずだった。また、なぜ"}, {"type": "subtitle", "time": 18249.43, "timestamp": "05:04:09", "text": "お二人とも同じことを書いているのですか？"}, {"type": "subtitle", "time": 18256.99, "timestamp": "05:04:16", "text": "あなたは金髪ですか？"}, {"type": "subtitle", "time": 18259.868, "timestamp": "05:04:19", "text": "何か？何が起こったのか"}, {"type": "subtitle", "time": 18262.19, "timestamp": "05:04:22", "text": "バカ？すべては"}, {"type": "subtitle", "time": 18271.788, "timestamp": "05:04:31", "text": "くそ。彼女は同じ"}, {"type": "subtitle", "time": 18275.47, "timestamp": "05:04:35", "text": "人。ジャスミン・クローム、あなたは何をしたの？"}, {"type": "subtitle", "time": 18278.23, "timestamp": "05:04:38", "text": "する？でも、ああ、久しぶりだね"}, {"type": "subtitle", "time": 18280.55, "timestamp": "05:04:40", "text": "ジャスミン・サナと話しました。元気でいてくれるといいな"}, {"type": "subtitle", "time": 18282.59, "timestamp": "05:04:42", "text": "順調です。"}, {"type": "subtitle", "time": 18284.868, "timestamp": "05:04:44", "text": "バカ、君は参加してないよ"}, {"type": "subtitle", "time": 18287.43, "timestamp": "05:04:47", "text": "マインクラフトだよ、バカ。元気でしたか？"}, {"type": "subtitle", "time": 18289.75, "timestamp": "05:04:49", "text": "たくさんのMODやアイテムを追加したので、"}, {"type": "subtitle", "time": 18291.67, "timestamp": "05:04:51", "text": "MODを手動でダウンロードする必要はありません"}, {"type": "subtitle", "time": 18294.788, "timestamp": "05:04:54", "text": "もう。オートモードパックのようなものを追加しました"}, {"type": "subtitle", "time": 18297.19, "timestamp": "05:04:57", "text": "あれ。だから、接続を開いて"}, {"type": "subtitle", "time": 18299.59, "timestamp": "05:04:59", "text": "サーバーは自動モッドパックをダウンロードするだけです"}]
[{"type": "subtitle", "time": 14523.349, "timestamp": "04:02:03", "text": "そうですね、いろいろあります"}, {"type": "subtitle", "time": 14524.83, "timestamp": "04:02:04", "text": "関連している"}, {"type": "subtitle", "time": 14527.99, "timestamp": "04:02:07", "text": "コラボレーションの中には"}, {"type": "subtitle", "time": 14530.79, "timestamp": "04:02:10", "text": "本当に楽しみにしています"}, {"type": "subtitle", "time": 14533.79, "timestamp": "04:02:13", "text": "ワクワクして前向きに考えている"}, {"type": "subtitle", "time": 14536.55, "timestamp": "04:02:16", "text": "特に日本のコラボレーション"}, {"type": "subtitle", "time": 14539.51, "timestamp": "04:02:19", "text": "特に私が"}, {"type": "subtitle", "time": 14542.79, "timestamp": "04:02:22", "text": "本当につながりたい"}, {"type": "subtitle", "time": 14545.269, "timestamp": "04:02:25", "text": "えっと、一緒に過ごして楽しい時間を過ごしましょう"}, {"type": "subtitle", "time": 14552.51, "timestamp": "04:02:32", "text": "もの。それで、"}, {"type": "subtitle", "time": 14554.349, "timestamp": "04:02:34", "text": "うん。"}, {"type": "subtitle", "time": 14557.75, "timestamp": "04:02:37", "text": "いいえ、でも大丈夫です。あなたはただ"}, {"type": "subtitle", "time": 14559.63, "timestamp": "04:02:39", "text": "信じる"}, {"type": "subtitle", "time": 14562.389, "timestamp": "04:02:42", "text": "あなたはうまくいくと信じていますし、私も"}, {"type": "subtitle", "time": 14563.79, "timestamp": "04:02:43", "text": "信じて、私はそうする"}, {"type": "subtitle", "time": 14568.189, "timestamp": "04:02:48", "text": "素晴らしい。私はただ最善を尽くすしかない。"}, {"type": "subtitle", "time": 14571.469, "timestamp": "04:02:51", "text": "しかし、それだけです"}, {"type": "subtitle", "time": 14577.88, "timestamp": "04:02:57", "text": "それだけのことです。"}]
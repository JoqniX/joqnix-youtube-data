[{"type": "subtitle", "time": 14765.67, "timestamp": "04:06:05", "text": "よし、ちょっとアップロードして、行くよ"}, {"type": "subtitle", "time": 14767.63, "timestamp": "04:06:07", "text": "就寝時間です。わかった、"}, {"type": "subtitle", "time": 14777.55, "timestamp": "04:06:17", "text": "滞在していただき、ありがとうございます"}, {"type": "subtitle", "time": 14781.349, "timestamp": "04:06:21", "text": "オンが再び私の家の中に入るかもしれない"}, {"type": "subtitle", "time": 14784.189, "timestamp": "04:06:24", "text": "階下で、"}, {"type": "subtitle", "time": 14788.15, "timestamp": "04:06:28", "text": "たぶん私は自分の"}, {"type": "subtitle", "time": 14791.229, "timestamp": "04:06:31", "text": "両親は"}, {"type": "subtitle", "time": 14793.91, "timestamp": "04:06:33", "text": "夕食とか食べ物とか"}, {"type": "subtitle", "time": 14795.67, "timestamp": "04:06:35", "text": "フライドポテトの中に。だから、おそらく"}, {"type": "subtitle", "time": 14797.67, "timestamp": "04:06:37", "text": "外。"}, {"type": "subtitle", "time": 14799.83, "timestamp": "04:06:39", "text": "ご飯か何か食べ物があるかもしれません。"}, {"type": "subtitle", "time": 14801.87, "timestamp": "04:06:41", "text": "もちろん、食べるかもしれない"}, {"type": "subtitle", "time": 14805.55, "timestamp": "04:06:45", "text": "何か。夕食を食べようとするかもしれない"}, {"type": "subtitle", "time": 14808.07, "timestamp": "04:06:48", "text": "また。もう一度夕食を食べてみようかな"}, {"type": "subtitle", "time": 14809.55, "timestamp": "04:06:49", "text": "そして"}]
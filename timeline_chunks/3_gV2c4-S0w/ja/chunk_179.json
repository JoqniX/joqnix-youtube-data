[{"type": "subtitle", "time": 10741.91, "timestamp": "02:59:01", "text": "君たちは何をしたの？何もない。"}, {"type": "subtitle", "time": 10746.55, "timestamp": "02:59:06", "text": "村人を誘拐したようですね。"}, {"type": "subtitle", "time": 10748.15, "timestamp": "02:59:08", "text": "いいえ、"}, {"type": "subtitle", "time": 10750.23, "timestamp": "02:59:10", "text": "あなたはそうしました。"}, {"type": "subtitle", "time": 10755.59, "timestamp": "02:59:15", "text": "私たちはそうだったのでしょうか？何？いいえ。つまり、あの、"}, {"type": "subtitle", "time": 10758.79, "timestamp": "02:59:18", "text": "方法があるんだけど、えっと、それは"}, {"type": "subtitle", "time": 10760.03, "timestamp": "02:59:20", "text": "村人たち"}, {"type": "subtitle", "time": 10763.51, "timestamp": "02:59:23", "text": "この場所へ移住したのは、ええと、"}, {"type": "subtitle", "time": 10766.15, "timestamp": "02:59:26", "text": "私が彼らに新しい家を与えたことに気づいてください。何が"}, {"type": "subtitle", "time": 10772.87, "timestamp": "02:59:32", "text": "まるでアストラが不動産会社になったみたいだ"}, {"type": "subtitle", "time": 10775.429, "timestamp": "02:59:35", "text": "エージェントと、そう、私は"}, {"type": "subtitle", "time": 10777.51, "timestamp": "02:59:37", "text": "新しいオファーがあるのではなく"}, {"type": "subtitle", "time": 10779.429, "timestamp": "02:59:39", "text": "みすぼらしい場所に滞在して、私のところに来て"}, {"type": "subtitle", "time": 10783.349, "timestamp": "02:59:43", "text": "豪華な場所。ああ、そうすると彼らは"}, {"type": "subtitle", "time": 10793.19, "timestamp": "02:59:53", "text": "女王。ああ、私はこれの女王だ"}]
[{"type": "subtitle", "time": 12842.51, "timestamp": "03:34:02", "text": "使いにくいVPNを使う"}, {"type": "subtitle", "time": 12846.63, "timestamp": "03:34:06", "text": "今。うん。それから私たちはそのゲームをしました"}, {"type": "subtitle", "time": 12847.71, "timestamp": "03:34:07", "text": "の"}, {"type": "subtitle", "time": 12851.99, "timestamp": "03:34:11", "text": "パン。パンはすぐ後に加わりました"}, {"type": "subtitle", "time": 12858.229, "timestamp": "03:34:18", "text": "信じる。これを変更しました。私はしなければならない"}, {"type": "subtitle", "time": 12860.59, "timestamp": "03:34:20", "text": "取り除く"}, {"type": "subtitle", "time": 12863.51, "timestamp": "03:34:23", "text": "それ。プレイしました。私たちはそれをプレイしました。それから私は"}, {"type": "subtitle", "time": 12865.95, "timestamp": "03:34:25", "text": "アストラに加わり、"}, {"type": "subtitle", "time": 12867.79, "timestamp": "03:34:27", "text": "輝く"}, {"type": "subtitle", "time": 12875.83, "timestamp": "03:34:35", "text": "私の配信がこんな風だったらいいのに"}, {"type": "subtitle", "time": 12878.469, "timestamp": "03:34:38", "text": "例えば、3時間ぶっ通しで。私はそうしました"}, {"type": "subtitle", "time": 12881.59, "timestamp": "03:34:41", "text": "休憩を取らない。私はそれを作らなければならない"}, {"type": "subtitle", "time": 12887.03, "timestamp": "03:34:47", "text": "多かれ少なかれ、このようなもの"}, {"type": "subtitle", "time": 12889.51, "timestamp": "03:34:49", "text": "私がしない回数が増えるほど"}, {"type": "subtitle", "time": 12893.99, "timestamp": "03:34:53", "text": "アボカド休憩のあれを使ってください。つまり、私は"}, {"type": "subtitle", "time": 12897.15, "timestamp": "03:34:57", "text": "24時間ストリーミング配信しているので問題ありません。"}]
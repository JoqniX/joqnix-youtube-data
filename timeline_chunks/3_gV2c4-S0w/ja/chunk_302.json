[{"type": "subtitle", "time": 18121.55, "timestamp": "05:02:01", "text": "間違っている"}, {"type": "subtitle", "time": 18125.948, "timestamp": "05:02:05", "text": "今？どうしたの？何かをした"}, {"type": "subtitle", "time": 18128.55, "timestamp": "05:02:08", "text": "起こる？バカバカ。うん、行くよ"}, {"type": "subtitle", "time": 18131.39, "timestamp": "05:02:11", "text": "寝る。ああ、眠っていることは"}, {"type": "subtitle", "time": 18133.91, "timestamp": "05:02:13", "text": "もの。私は起きていません"}, {"type": "subtitle", "time": 18140.868, "timestamp": "05:02:20", "text": "昨日。私たちはちょうど深い話をしていました"}, {"type": "subtitle", "time": 18143.35, "timestamp": "05:02:23", "text": "コラボレーションについての会話と"}, {"type": "subtitle", "time": 18148.43, "timestamp": "05:02:28", "text": "そして"}, {"type": "subtitle", "time": 18154.99, "timestamp": "05:02:34", "text": "ええ、それで"}, {"type": "subtitle", "time": 18158.39, "timestamp": "05:02:38", "text": "ドナ、そういえば、もしあなたが"}, {"type": "subtitle", "time": 18162.15, "timestamp": "05:02:42", "text": "ぜひ貢献したいので、ご連絡ください。"}, {"type": "subtitle", "time": 18164.15, "timestamp": "05:02:44", "text": "どう思うか教えてください"}, {"type": "subtitle", "time": 18167.47, "timestamp": "05:02:47", "text": "コラボレーションをどのように捉えているか"}, {"type": "subtitle", "time": 18171.19, "timestamp": "05:02:51", "text": "あなたもそう思いますか"}, {"type": "subtitle", "time": 18174.39, "timestamp": "05:02:54", "text": "ええと、本物のアプローチで"}, {"type": "subtitle", "time": 18176.788, "timestamp": "05:02:56", "text": "相手のことをもっとよく知りたい"}, {"type": "subtitle", "time": 18179.99, "timestamp": "05:02:59", "text": "そして実際に繋がりを築く"}]
[{"type": "subtitle", "time": 6181.59, "timestamp": "01:43:01", "text": "どのコマンドですか？それは何を示しているか"}, {"type": "subtitle", "time": 6186.189, "timestamp": "01:43:06", "text": "サーバーの新しいもの"}, {"type": "subtitle", "time": 6190.99, "timestamp": "01:43:10", "text": "ええ、そうでした。確認してみます。 1つ"}, {"type": "subtitle", "time": 6199.669, "timestamp": "01:43:19", "text": "おお。なんてこった。ファイルを削除しました。いいえ、"}, {"type": "subtitle", "time": 6216.07, "timestamp": "01:43:36", "text": "[音楽]"}, {"type": "subtitle", "time": 6217.31, "timestamp": "01:43:37", "text": "束"}, {"type": "subtitle", "time": 6223.27, "timestamp": "01:43:43", "text": "ああ、人生マンガソフトが始まった"}, {"type": "subtitle", "time": 6225.43, "timestamp": "01:43:45", "text": "訴訟から爆発まで。それで"}, {"type": "subtitle", "time": 6226.709, "timestamp": "01:43:46", "text": "基本的に人生全体は"}, {"type": "subtitle", "time": 6228.229, "timestamp": "01:43:48", "text": "おそらく彼らは"}, {"type": "subtitle", "time": 6231.59, "timestamp": "01:43:51", "text": "サーバーは独自のハブに依存しており、"}, {"type": "subtitle", "time": 6234.149, "timestamp": "01:43:54", "text": "彼らが与えたCPUとGPUの数"}, {"type": "subtitle", "time": 6236.07, "timestamp": "01:43:56", "text": "希望するMinecraftサーバーへ。として"}, {"type": "subtitle", "time": 6237.91, "timestamp": "01:43:57", "text": "それは企業であり、彼らは"}, {"type": "subtitle", "time": 6239.59, "timestamp": "01:43:59", "text": "大量のサーバーを"}]
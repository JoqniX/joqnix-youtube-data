[{"type": "subtitle", "time": 4203.27, "timestamp": "01:10:03", "text": "3～2GBくらいだったよね？三つ？"}, {"type": "subtitle", "time": 4206.95, "timestamp": "01:10:06", "text": "いや、ほぼ4GBのRAMみたいなものだよ。うん、"}, {"type": "subtitle", "time": 4213.35, "timestamp": "01:10:13", "text": "ええ、今は1GBです。ほら、"}, {"type": "subtitle", "time": 4215.11, "timestamp": "01:10:15", "text": "3GBのRAMの違いは"}, {"type": "subtitle", "time": 4217.669, "timestamp": "01:10:17", "text": "そのMODを削除します。"}, {"type": "subtitle", "time": 4220.95, "timestamp": "01:10:20", "text": "ああ、以前はいくらだったっけ？"}, {"type": "subtitle", "time": 4223.87, "timestamp": "01:10:23", "text": "せいぜい２～３個、４個ではない"}, {"type": "subtitle", "time": 4227.11, "timestamp": "01:10:27", "text": "なぜならそれは4歳だったから、私はまだ"}, {"type": "subtitle", "time": 4230.709, "timestamp": "01:10:30", "text": "サーバー内で。何？待って、えっと"}, {"type": "subtitle", "time": 4233.189, "timestamp": "01:10:33", "text": "負荷のかかったアクティビティを解放しました。"}, {"type": "subtitle", "time": 4235.31, "timestamp": "01:10:35", "text": "うん。"}, {"type": "subtitle", "time": 4243.43, "timestamp": "01:10:43", "text": "おお。そのMODの説明は何ですか？"}, {"type": "subtitle", "time": 4245.43, "timestamp": "01:10:45", "text": "また？"}, {"type": "subtitle", "time": 4249.03, "timestamp": "01:10:49", "text": "うん、わかるよ。そのMODを使えば"}, {"type": "subtitle", "time": 4253.35, "timestamp": "01:10:53", "text": "えーと、作物とかそういうのだけど、基本は"}, {"type": "subtitle", "time": 4255.99, "timestamp": "01:10:55", "text": "ほら、そういうものがあるんだよ"}, {"type": "subtitle", "time": 4257.99, "timestamp": "01:10:57", "text": "マインクラフトにおける作物栽培の論理は"}]
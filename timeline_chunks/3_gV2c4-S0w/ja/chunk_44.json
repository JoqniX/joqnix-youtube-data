[{"type": "subtitle", "time": 2641.109, "timestamp": "00:44:01", "text": "どちらかというと、えっと、ここはこんな感じでした"}, {"type": "subtitle", "time": 2643.109, "timestamp": "00:44:03", "text": "まったく新しい人々と"}, {"type": "subtitle", "time": 2646.63, "timestamp": "00:44:06", "text": "OBSやその他諸々が好きな初心者"}, {"type": "subtitle", "time": 2648.91, "timestamp": "00:44:08", "text": "彼らはゆっくりと始めた"}, {"type": "subtitle", "time": 2653.43, "timestamp": "00:44:13", "text": "チューブがどのように機能し、どのように"}, {"type": "subtitle", "time": 2656.069, "timestamp": "00:44:16", "text": "えーと、より大きなチャットに対応するために"}, {"type": "subtitle", "time": 2657.99, "timestamp": "00:44:17", "text": "そしてすべてとコメントする人々"}, {"type": "subtitle", "time": 2660.15, "timestamp": "00:44:20", "text": "たくさんのことをどう対処するか"}, {"type": "subtitle", "time": 2661.91, "timestamp": "00:44:21", "text": "今はプレッシャーが全てだから"}, {"type": "subtitle", "time": 2665.829, "timestamp": "00:44:25", "text": "初めてみたいに、いや、そうだよ"}, {"type": "subtitle", "time": 2669.19, "timestamp": "00:44:29", "text": "それが私たちが乗ってきたノアの箱舟です"}, {"type": "subtitle", "time": 2672.829, "timestamp": "00:44:32", "text": "ええと、私たちのほとんどはすぐに"}, {"type": "subtitle", "time": 2677.03, "timestamp": "00:44:37", "text": "だってその時は君には分からないだろうから"}, {"type": "subtitle", "time": 2679.63, "timestamp": "00:44:39", "text": "どうすればいいですか"}, {"type": "subtitle", "time": 2683.19, "timestamp": "00:44:43", "text": "コラボレーションって何？"}, {"type": "subtitle", "time": 2685.79, "timestamp": "00:44:45", "text": "コラボレーションで起こる"}, {"type": "subtitle", "time": 2694.63, "timestamp": "00:44:54", "text": "そう、それに関しては"}, {"type": "subtitle", "time": 2698.15, "timestamp": "00:44:58", "text": "そういう類のもの。時々、それは"}]
[{"type": "subtitle", "time": 14820.51, "timestamp": "04:07:00", "text": "悪い。私は今すぐここに来なければならない。行く"}, {"type": "subtitle", "time": 14836.229, "timestamp": "04:07:16", "text": "ええと、ビリー・ベリーの成長は"}, {"type": "subtitle", "time": 14841.189, "timestamp": "04:07:21", "text": "ペースがもっとゆっくりしているようだ"}, {"type": "subtitle", "time": 14843.63, "timestamp": "04:07:23", "text": "予想よりも"}, {"type": "subtitle", "time": 14847.189, "timestamp": "04:07:27", "text": "今、言語の壁は私が"}, {"type": "subtitle", "time": 14850.229, "timestamp": "04:07:30", "text": "本当に嫌い。"}, {"type": "subtitle", "time": 14852.79, "timestamp": "04:07:32", "text": "何か方法があればいいのに"}, {"type": "subtitle", "time": 14854.91, "timestamp": "04:07:34", "text": "接続する"}, {"type": "subtitle", "time": 14857.03, "timestamp": "04:07:37", "text": "正しくは、しかし悪い"}, {"type": "subtitle", "time": 14859.11, "timestamp": "04:07:39", "text": "言語。あ、待って、まだ"}, {"type": "subtitle", "time": 14862.03, "timestamp": "04:07:42", "text": "Qを確認しました。"}, {"type": "subtitle", "time": 14865.269, "timestamp": "04:07:45", "text": "右？コミュニティに通知するつもりです"}]
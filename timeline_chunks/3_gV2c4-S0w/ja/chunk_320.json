[{"type": "subtitle", "time": 19200.948, "timestamp": "05:20:00", "text": "ビュー。つまり、流れの曲線と流れ"}, {"type": "subtitle", "time": 19210.07, "timestamp": "05:20:10", "text": "ああ、いいね。ニース。昼寝はしないでください。"}, {"type": "subtitle", "time": 19213.03, "timestamp": "05:20:13", "text": "わかりました、それならやめておきます。ありがとう"}, {"type": "subtitle", "time": 19215.31, "timestamp": "05:20:15", "text": "のために"}, {"type": "subtitle", "time": 19219.03, "timestamp": "05:20:19", "text": "えっと、クリックしていただきありがとうございます"}, {"type": "subtitle", "time": 19221.75, "timestamp": "05:20:21", "text": "私の配信で実際にチャットしている"}, {"type": "subtitle", "time": 19225.03, "timestamp": "05:20:25", "text": "自分。問題は、今私は"}, {"type": "subtitle", "time": 19228.47, "timestamp": "05:20:28", "text": "Kickには実際の視聴者はほとんどいない"}, {"type": "subtitle", "time": 19232.788, "timestamp": "05:20:32", "text": "ボットアカウントが多数出現するため"}, {"type": "subtitle", "time": 19235.27, "timestamp": "05:20:35", "text": "Discordで彼らを追加するように言われる"}, {"type": "subtitle", "time": 19240.43, "timestamp": "05:20:40", "text": "フォロワーなどのために。私はこう思う。"}, {"type": "subtitle", "time": 19243.27, "timestamp": "05:20:43", "text": "Twitchでやってます、はい、私たちは"}, {"type": "subtitle", "time": 19246.23, "timestamp": "05:20:46", "text": "実際に5つのプラットフォームでライブ配信するビリー"}, {"type": "subtitle", "time": 19248.15, "timestamp": "05:20:48", "text": "ビリービリービリーは中国語です"}, {"type": "subtitle", "time": 19251.51, "timestamp": "05:20:51", "text": "中国版YouTubeのようなプラットフォーム"}, {"type": "subtitle", "time": 19254.788, "timestamp": "05:20:54", "text": "それとYouTubeのTwitchキックと"}, {"type": "subtitle", "time": 19256.27, "timestamp": "05:20:56", "text": "ビーム"}, {"type": "subtitle", "time": 19259.708, "timestamp": "05:20:59", "text": "両方のライブ配信を配信"}]
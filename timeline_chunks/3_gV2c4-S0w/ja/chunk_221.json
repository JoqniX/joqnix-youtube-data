[{"type": "subtitle", "time": 13260.309, "timestamp": "03:41:00", "text": "他にも20人くらい"}, {"type": "subtitle", "time": 13263.19, "timestamp": "03:41:03", "text": "えっと、あと20クリップあるはずです。"}, {"type": "subtitle", "time": 13266.63, "timestamp": "03:41:06", "text": "アップロードして追いつく。私たちはできる"}, {"type": "subtitle", "time": 13269.469, "timestamp": "03:41:09", "text": "この終わりまでに"}, {"type": "subtitle", "time": 13273.79, "timestamp": "03:41:13", "text": "週。ユーモア。ええ、これが終わる前に"}, {"type": "subtitle", "time": 13290.11, "timestamp": "03:41:30", "text": "忘れた。他のユーチューバーの友達はいますか？"}, {"type": "subtitle", "time": 13292.19, "timestamp": "03:41:32", "text": "叫び声？何が"}, {"type": "subtitle", "time": 13296.75, "timestamp": "03:41:36", "text": "見る？こんな遅い時間に私だけでしょうか？"}, {"type": "subtitle", "time": 13306.95, "timestamp": "03:41:46", "text": "水泳？あ、待って。私はそうするべきではない"}, {"type": "subtitle", "time": 13309.03, "timestamp": "03:41:49", "text": "ビリーに関する外国のプラットフォームを表示する。おお、"}, {"type": "subtitle", "time": 13311.59, "timestamp": "03:41:51", "text": "待って、待って、待って、待って、待って。する必要がある"}, {"type": "subtitle", "time": 13313.75, "timestamp": "03:41:53", "text": "これを変更してください。またアカウント停止になるかもしれない。私"}, {"type": "subtitle", "time": 13315.229, "timestamp": "03:41:55", "text": "手に入れたくない"}, {"type": "subtitle", "time": 13319.59, "timestamp": "03:41:59", "text": "禁止。わかった。彼女はみんな人気者"}]
[{"type": "subtitle", "time": 1560.149, "timestamp": "00:26:00", "text": "むしろ小規模なクリエイターに対して批判的である"}, {"type": "subtitle", "time": 1564.83, "timestamp": "00:26:04", "text": "彼らを導き、見せるよりも"}, {"type": "subtitle", "time": 1567.909, "timestamp": "00:26:07", "text": "親切心はただ見せびらかすだけなどであり、"}, {"type": "subtitle", "time": 1570.549, "timestamp": "00:26:10", "text": "すべて。つまり、またしても、そうですね、あります"}, {"type": "subtitle", "time": 1572.39, "timestamp": "00:26:12", "text": "それをしたいと思う人もいる"}, {"type": "subtitle", "time": 1574.87, "timestamp": "00:26:14", "text": "だって、時々わかるでしょ"}, {"type": "subtitle", "time": 1580.39, "timestamp": "00:26:20", "text": "悪者にならなければならない"}, {"type": "subtitle", "time": 1583.11, "timestamp": "00:26:23", "text": "彼らに経験を与え、"}, {"type": "subtitle", "time": 1586.149, "timestamp": "00:26:26", "text": "こういうのが好きだと思う"}, {"type": "subtitle", "time": 1589.11, "timestamp": "00:26:29", "text": "そういう時はもっと成熟する必要がある、など"}, {"type": "subtitle", "time": 1591.51, "timestamp": "00:26:31", "text": "そういう類のことは全部、私は"}, {"type": "subtitle", "time": 1593.59, "timestamp": "00:26:33", "text": "どのような言い回しをすれば良いかわかりません。"}, {"type": "subtitle", "time": 1595.75, "timestamp": "00:26:35", "text": "悪いように、本当に良い"}, {"type": "subtitle", "time": 1598.63, "timestamp": "00:26:38", "text": "いい人だけど、彼らは、えーと"}, {"type": "subtitle", "time": 1602.63, "timestamp": "00:26:42", "text": "例えば、先生のように"}, {"type": "subtitle", "time": 1604.74, "timestamp": "00:26:44", "text": "先生は"}, {"type": "subtitle", "time": 1606.029, "timestamp": "00:26:46", "text": "[音楽]"}, {"type": "subtitle", "time": 1608.43, "timestamp": "00:26:48", "text": "ない"}, {"type": "subtitle", "time": 1612.95, "timestamp": "00:26:52", "text": "こんにちは、ようこそ、そして2つありがとうございます"}, {"type": "subtitle", "time": 1615.19, "timestamp": "00:26:55", "text": "プレゼントされたサブスクライバー、ありがとう、ありがとう、ありがとう"}, {"type": "subtitle", "time": 1617.149, "timestamp": "00:26:57", "text": "あなたは感謝します"}, {"type": "subtitle", "time": 1619.39, "timestamp": "00:26:59", "text": "ありがとう、ありがとう"}]
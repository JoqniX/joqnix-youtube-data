[{"type": "subtitle", "time": 9421.95, "timestamp": "02:37:01", "text": "彼らはただ私が配信で読むことを望んでいるだけだ"}, {"type": "subtitle", "time": 9426.469, "timestamp": "02:37:06", "text": "そして、それを使って好きなことを何でもする。ああ、"}, {"type": "subtitle", "time": 9428.469, "timestamp": "02:37:08", "text": "それは良い。"}, {"type": "subtitle", "time": 9430.79, "timestamp": "02:37:10", "text": "じゃあ、描いてみるよ。絵を描いてみます"}, {"type": "subtitle", "time": 9434.57, "timestamp": "02:37:14", "text": "それに関する漫画のコマ。"}, {"type": "subtitle", "time": 9441.91, "timestamp": "02:37:21", "text": "アスカ、提灯はどこ？ああ神様、私は"}, {"type": "subtitle", "time": 9443.309, "timestamp": "02:37:23", "text": "見つかりません"}, {"type": "subtitle", "time": 9447.309, "timestamp": "02:37:27", "text": "それ。金庫とは何ですか？"}, {"type": "subtitle", "time": 9451.27, "timestamp": "02:37:31", "text": "わかった。ああ、わかった。ランタンはどこですか？"}, {"type": "subtitle", "time": 9454.309, "timestamp": "02:37:34", "text": "みんな、私はここにたった一人ぼっちです。"}, {"type": "subtitle", "time": 9470.63, "timestamp": "02:37:50", "text": "私には忍耐力がない。"}]
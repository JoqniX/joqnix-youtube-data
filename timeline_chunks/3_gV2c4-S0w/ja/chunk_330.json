[{"type": "subtitle", "time": 19803.39, "timestamp": "05:30:03", "text": "もの？誰と話しましたか？"}, {"type": "subtitle", "time": 19807.948, "timestamp": "05:30:07", "text": "彼と、授業はどうだったかなどと尋ねた。"}, {"type": "subtitle", "time": 19812.15, "timestamp": "05:30:12", "text": "は？私はあまり話せなかった。ヒットするだろう"}, {"type": "subtitle", "time": 19814.31, "timestamp": "05:30:14", "text": "現実を突きつけられ、後悔する取引を強いられる"}, {"type": "subtitle", "time": 19816.99, "timestamp": "05:30:16", "text": "正しい学習に時間を費やしていない"}, {"type": "subtitle", "time": 19820.07, "timestamp": "05:30:20", "text": "今。うん。ああ、私たちは話していません"}, {"type": "subtitle", "time": 19824.59, "timestamp": "05:30:24", "text": "それについて。私は彼らの"}, {"type": "subtitle", "time": 19827.27, "timestamp": "05:30:27", "text": "状況。彼らは強制送還されるのだろうか？"}, {"type": "subtitle", "time": 19829.51, "timestamp": "05:30:29", "text": "インドへは実際にはそうではない"}, {"type": "subtitle", "time": 19831.67, "timestamp": "05:30:31", "text": "うまく機能していますか？なぜなら、全員がそうではなかったから"}, {"type": "subtitle", "time": 19835.51, "timestamp": "05:30:35", "text": "それを実践してください。偶数に対しても"}, {"type": "subtitle", "time": 19839.11, "timestamp": "05:30:39", "text": "えーと、4月に私が参加したイベントについて。"}, {"type": "subtitle", "time": 19842.15, "timestamp": "05:30:42", "text": "いや、いや。 3月のイベント。私は何に参加しましたか"}, {"type": "subtitle", "time": 19845.59, "timestamp": "05:30:45", "text": "あなたはそれを何と呼びますか？式典。いいえ、"}, {"type": "subtitle", "time": 19846.75, "timestamp": "05:30:46", "text": "COE"}, {"type": "subtitle", "time": 19850.628, "timestamp": "05:30:50", "text": "式。全員です。まるで私が"}, {"type": "subtitle", "time": 19856.868, "timestamp": "05:30:56", "text": "私と他の何人かのクラスメート"}, {"type": "subtitle", "time": 19858.948, "timestamp": "05:30:58", "text": "に近づいたのは"}]
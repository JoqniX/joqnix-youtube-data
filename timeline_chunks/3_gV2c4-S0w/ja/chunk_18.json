[{"type": "subtitle", "time": 1080.15, "timestamp": "00:18:00", "text": "はい、それで大丈夫です"}, {"type": "subtitle", "time": 1082.63, "timestamp": "00:18:02", "text": "私は彼らの立場も理解できますし、"}, {"type": "subtitle", "time": 1085.11, "timestamp": "00:18:05", "text": "何が問題なのか分かるし、それは例えば"}, {"type": "subtitle", "time": 1095.39, "timestamp": "00:18:15", "text": "ええ、人々は私が"}, {"type": "chat", "time": 1098.859, "timestamp": "00:18:18", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "That's inevitable.... you took a big step so it's natural people will come and hit the wrong nerve... I won't say tough up but just know it's a whole package"}, {"type": "subtitle", "time": 1099.59, "timestamp": "00:18:19", "text": "意見や金銭を求めて彼らに近づく"}, {"type": "subtitle", "time": 1102.39, "timestamp": "00:18:22", "text": "利益、"}, {"type": "subtitle", "time": 1104.549, "timestamp": "00:18:24", "text": "金銭的な利益、そして私は"}, {"type": "subtitle", "time": 1106.789, "timestamp": "00:18:26", "text": "私のチャンネルのフォロワー数。だから私は"}, {"type": "subtitle", "time": 1109.47, "timestamp": "00:18:29", "text": "あなたと協力し、"}, {"type": "subtitle", "time": 1112.789, "timestamp": "00:18:32", "text": "すべて。理由はわからないけど"}, {"type": "subtitle", "time": 1114.75, "timestamp": "00:18:34", "text": "人々は次のように考える"}, {"type": "subtitle", "time": 1118.549, "timestamp": "00:18:38", "text": "それ。例えば、私がそれを好きだったとしましょう。"}, {"type": "subtitle", "time": 1122.47, "timestamp": "00:18:42", "text": "あなたの見解が100％正しいと確信するにはどうすればよいでしょうか。"}, {"type": "subtitle", "time": 1124.63, "timestamp": "00:18:44", "text": "あなたの聴衆は私のところに来るでしょう"}, {"type": "subtitle", "time": 1126.789, "timestamp": "00:18:46", "text": "チャンネル登録していいねしてください"}, {"type": "subtitle", "time": 1134.59, "timestamp": "00:18:54", "text": "自分？"}, {"type": "subtitle", "time": 1137.59, "timestamp": "00:18:57", "text": "いいえ。私はたくさんの人とコラボレーションしてきました"}]
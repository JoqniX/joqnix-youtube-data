[{"type": "subtitle", "time": 17522.15, "timestamp": "04:52:02", "text": "私は今、こんな状況に陥っています"}, {"type": "subtitle", "time": 17524.15, "timestamp": "04:52:04", "text": "説明したくないようなこと"}, {"type": "subtitle", "time": 17526.788, "timestamp": "04:52:06", "text": "私は見知らぬ人に説明しなければならなかった"}, {"type": "subtitle", "time": 17531.15, "timestamp": "04:52:11", "text": "もし私が彼らを尊敬し、彼らを切望するなら"}, {"type": "subtitle", "time": 17534.55, "timestamp": "04:52:14", "text": "たとえ私が彼らを尊敬し、敬愛していたとしても"}, {"type": "subtitle", "time": 17536.75, "timestamp": "04:52:16", "text": "コンテンツとその"}, {"type": "subtitle", "time": 17541.07, "timestamp": "04:52:21", "text": "いろいろあるけど、わからない。"}, {"type": "subtitle", "time": 17545.75, "timestamp": "04:52:25", "text": "批判しすぎ、好きじゃない"}, {"type": "subtitle", "time": 17548.39, "timestamp": "04:52:28", "text": "平等に見ているとか、そういう感じ。私は自分が"}, {"type": "subtitle", "time": 17551.59, "timestamp": "04:52:31", "text": "まるで、わからないけど、"}, {"type": "subtitle", "time": 17554.51, "timestamp": "04:52:34", "text": "パワーインフレとか、何でもできる"}, {"type": "subtitle", "time": 17556.35, "timestamp": "04:52:36", "text": "言う"}, {"type": "subtitle", "time": 17561.59, "timestamp": "04:52:41", "text": "私のイニシャルみたいな、えーっと"}, {"type": "subtitle", "time": 17564.708, "timestamp": "04:52:44", "text": "メッセージには、興味があれば、といった内容が含まれていました。"}, {"type": "subtitle", "time": 17567.03, "timestamp": "04:52:47", "text": "または、私に知らせないでください"}, {"type": "subtitle", "time": 17568.59, "timestamp": "04:52:48", "text": "もしあなたが"}, {"type": "subtitle", "time": 17571.51, "timestamp": "04:52:51", "text": "興味を持って、丁寧に"}, {"type": "subtitle", "time": 17574.23, "timestamp": "04:52:54", "text": "「いや、忙しいから無理だよ」と断る"}, {"type": "subtitle", "time": 17577.83, "timestamp": "04:52:57", "text": "言い訳はいつでもできるよね。私は"}]
[{"type": "subtitle", "time": 13986.97, "timestamp": "03:53:06", "text": "オフライン"}, {"type": "subtitle", "time": 13988.75, "timestamp": "03:53:08", "text": "[音楽]"}, {"type": "subtitle", "time": 13990.75, "timestamp": "03:53:10", "text": "壁。"}, {"type": "subtitle", "time": 14000.349, "timestamp": "03:53:20", "text": "えっ？それは巨大な宝箱だ。"}, {"type": "subtitle", "time": 14014.469, "timestamp": "03:53:34", "text": "マインクラフト。待って、メガメガタロン。違う"}, {"type": "subtitle", "time": 14016.03, "timestamp": "03:53:36", "text": "彼女は大きな"}, {"type": "subtitle", "time": 14036.07, "timestamp": "03:53:56", "text": "うん、参加するのは難しいよ。"}, {"type": "subtitle", "time": 14038.95, "timestamp": "03:53:58", "text": "人々がこれをするのは、みんなが"}]
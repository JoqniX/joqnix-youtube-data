[{"type": "subtitle", "time": 17161.91, "timestamp": "04:46:01", "text": "相乗効果があれば、私たちは"}, {"type": "subtitle", "time": 17163.91, "timestamp": "04:46:03", "text": "コラボとかを見るのはいいことだね"}, {"type": "subtitle", "time": 17165.55, "timestamp": "04:46:05", "text": "のように"}, {"type": "subtitle", "time": 17169.19, "timestamp": "04:46:09", "text": "それは、それがどんな感じかということだ"}, {"type": "subtitle", "time": 17171.51, "timestamp": "04:46:11", "text": "俺はこう考えるのが好きだった、おい、何だって？"}, {"type": "subtitle", "time": 17174.708, "timestamp": "04:46:14", "text": "私は間違っている、いや、それは違う"}, {"type": "subtitle", "time": 17177.03, "timestamp": "04:46:17", "text": "もちろん、私はそれが"}, {"type": "subtitle", "time": 17179.59, "timestamp": "04:46:19", "text": "超越的なもののようなもの。しかし、"}, {"type": "subtitle", "time": 17185.708, "timestamp": "04:46:25", "text": "まるで彼らが"}, {"type": "subtitle", "time": 17189.75, "timestamp": "04:46:29", "text": "えっと、それはそれに対する批判ですか、ああ"}, {"type": "subtitle", "time": 17191.59, "timestamp": "04:46:31", "text": "君はジョックマラソンみたいなことをやっていて"}, {"type": "subtitle", "time": 17195.19, "timestamp": "04:46:35", "text": "3月からずっとやっています"}, {"type": "subtitle", "time": 17197.83, "timestamp": "04:46:37", "text": "3月4日。15日と言っていたが、始まった。"}, {"type": "subtitle", "time": 17200.708, "timestamp": "04:46:40", "text": "12歳で。"}, {"type": "subtitle", "time": 17203.67, "timestamp": "04:46:43", "text": "12日に始まった。でも、そう、でも、そう、すべて"}, {"type": "subtitle", "time": 17205.27, "timestamp": "04:46:45", "text": "彼らはそれらのものを些細なことでつまみ食いしていた"}, {"type": "subtitle", "time": 17212.31, "timestamp": "04:46:52", "text": "えっと、なんとなく理由は分かったような気がした"}, {"type": "subtitle", "time": 17214.788, "timestamp": "04:46:54", "text": "彼らはそうするだろうか、なぜなら彼らは"}, {"type": "subtitle", "time": 17218.31, "timestamp": "04:46:58", "text": "真面目なタイプで、"}]
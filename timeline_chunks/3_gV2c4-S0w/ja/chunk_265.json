[{"type": "subtitle", "time": 15904.429, "timestamp": "04:25:04", "text": "これ。この人に連絡を取るべきだ"}, {"type": "subtitle", "time": 15937.91, "timestamp": "04:25:37", "text": "私はオーを招待したのを覚えています。ああ神様、私は"}, {"type": "subtitle", "time": 15940.59, "timestamp": "04:25:40", "text": "すごく懐かしい気持ちになってきたよ、兄弟。何"}, {"type": "subtitle", "time": 15943.91, "timestamp": "04:25:43", "text": "えっ？えっと、しばらく交流していませんでした"}]
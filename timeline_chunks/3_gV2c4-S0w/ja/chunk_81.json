[{"type": "subtitle", "time": 4861.59, "timestamp": "01:21:01", "text": "ウィンドウキャプチャはそこにあります、"}, {"type": "subtitle", "time": 4864.43, "timestamp": "01:21:04", "text": "実際かなり"}, {"type": "subtitle", "time": 4867.27, "timestamp": "01:21:07", "text": "良い。マウスカーソルはそこにあります。前に"}, {"type": "subtitle", "time": 4870.229, "timestamp": "01:21:10", "text": "それはそこになかった。"}, {"type": "subtitle", "time": 4875.31, "timestamp": "01:21:15", "text": "こんにちは、"}, {"type": "subtitle", "time": 4877.75, "timestamp": "01:21:17", "text": "ヴァリチェクシ。あなたは何を書いたのですか？そして"}, {"type": "subtitle", "time": 4879.07, "timestamp": "01:21:19", "text": "何が"}]
[{"type": "subtitle", "time": 6121.75, "timestamp": "01:42:01", "text": "すべてを提供する。インストールと起動"}, {"type": "subtitle", "time": 6123.99, "timestamp": "01:42:03", "text": "マルチバース・コアはかなり混乱を招く可能性がある"}, {"type": "subtitle", "time": 6126.39, "timestamp": "01:42:06", "text": "初めてプレイする人向け。だから私たちは"}, {"type": "subtitle", "time": 6128.229, "timestamp": "01:42:08", "text": "このチュートリアルでは、"}, {"type": "subtitle", "time": 6130.189, "timestamp": "01:42:10", "text": "あらゆるステップ"}, {"type": "subtitle", "time": 6132.95, "timestamp": "01:42:12", "text": "方法。もちろん、私たちは"}, {"type": "subtitle", "time": 6135.87, "timestamp": "01:42:15", "text": "Multiverse Coreをダウンロードすることで"}, {"type": "subtitle", "time": 6139.229, "timestamp": "01:42:19", "text": "プラグイン。彼らの種類に乗り込む"}, {"type": "subtitle", "time": 6146.59, "timestamp": "01:42:26", "text": "働く"}, {"type": "subtitle", "time": 6150.03, "timestamp": "01:42:30", "text": "ページは、"}, {"type": "subtitle", "time": 6152.87, "timestamp": "01:42:32", "text": "入力。宇宙を試してみたくなるでしょう"}, {"type": "subtitle", "time": 6157.75, "timestamp": "01:42:37", "text": "ワールド名スラッシュMVスペース作成は"}, {"type": "subtitle", "time": 6161.83, "timestamp": "01:42:41", "text": "ランダムなオーバーワールドを作成する予定です。のように"}, {"type": "subtitle", "time": 6164.149, "timestamp": "01:42:44", "text": "それは本当に普通のものかもしれない"}, {"type": "subtitle", "time": 6166.87, "timestamp": "01:42:46", "text": "生存世界の舞台。一方で、"}, {"type": "subtitle", "time": 6169.43, "timestamp": "01:42:49", "text": "ちょっと奇抜なことをしたいと思ったら"}, {"type": "subtitle", "time": 6172.03, "timestamp": "01:42:52", "text": "リトル・ワイルド・アーク"}, {"type": "subtitle", "time": 6175.35, "timestamp": "01:42:55", "text": "スライムに殺されるかもしれない"}, {"type": "subtitle", "time": 6177.109, "timestamp": "01:42:57", "text": "それはただ、それはただ、待って、あなたは"}, {"type": "subtitle", "time": 6179.03, "timestamp": "01:42:59", "text": "MODを追加しましたか？"}]
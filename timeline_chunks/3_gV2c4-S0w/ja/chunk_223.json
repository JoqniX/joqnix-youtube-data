[{"type": "subtitle", "time": 13381.99, "timestamp": "03:43:01", "text": "ブラッドがプレイしている間、私のストリームへ"}, {"type": "subtitle", "time": 13386.55, "timestamp": "03:43:06", "text": "マーベルのライバル。つまり、だいたい10くらいですね。"}, {"type": "subtitle", "time": 13391.349, "timestamp": "03:43:11", "text": "今は午前2時です。ええ、3 4"}, {"type": "subtitle", "time": 13393.349, "timestamp": "03:43:13", "text": "時間、それはできるはずだと思う"}, {"type": "subtitle", "time": 13395.71, "timestamp": "03:43:15", "text": "エンコードされる"}, {"type": "subtitle", "time": 13399.95, "timestamp": "03:43:19", "text": "トランスコード済み。ダウンロードできるかもしれません"}, {"type": "subtitle", "time": 13403.59, "timestamp": "03:43:23", "text": "それ。わかった。だからダウンロード用にしておきます"}, {"type": "subtitle", "time": 13406.07, "timestamp": "03:43:26", "text": "そして今日の最新ストリームを取得します"}, {"type": "subtitle", "time": 13407.79, "timestamp": "03:43:27", "text": "今。これ"}, {"type": "subtitle", "time": 13411.469, "timestamp": "03:43:31", "text": "それを保管する"}, {"type": "subtitle", "time": 13415.51, "timestamp": "03:43:35", "text": "保留中で、明日の分を作らなければならない"}, {"type": "subtitle", "time": 13416.75, "timestamp": "03:43:36", "text": "1つ、"}, {"type": "subtitle", "time": 13431.03, "timestamp": "03:43:51", "text": "63. 私は見ていない"}, {"type": "subtitle", "time": 13432.269, "timestamp": "03:43:52", "text": "えーと"}]
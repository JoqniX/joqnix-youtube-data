[{"type": "subtitle", "time": 17702.39, "timestamp": "04:55:02", "text": "彼らのことだけど、そう、一度話すだけか"}, {"type": "subtitle", "time": 17704.23, "timestamp": "04:55:04", "text": "2回または複数回は、"}, {"type": "subtitle", "time": 17706.708, "timestamp": "04:55:06", "text": "彼らは今ではあなたを友人だと思っています。"}, {"type": "subtitle", "time": 17708.83, "timestamp": "04:55:08", "text": "たくさんの"}, {"type": "subtitle", "time": 17713.11, "timestamp": "04:55:13", "text": "そうですよね？私たちのために、そして私たちのためにすべてが"}, {"type": "subtitle", "time": 17716.628, "timestamp": "04:55:16", "text": "今、私たちは誰かと一緒にいるのが好きで、"}, {"type": "subtitle", "time": 17718.31, "timestamp": "04:55:18", "text": "そういうもの、私たちはそれらを親友と呼んでいます"}, {"type": "subtitle", "time": 17721.35, "timestamp": "04:55:21", "text": "もの。今は、私たちはこれについて考えません。"}, {"type": "subtitle", "time": 17722.868, "timestamp": "04:55:22", "text": "差別化に関しては"}, {"type": "subtitle", "time": 17724.43, "timestamp": "04:55:24", "text": "友情、"}, {"type": "subtitle", "time": 17729.27, "timestamp": "04:55:29", "text": "右？友達かパラソーシャルか何か"}, {"type": "subtitle", "time": 17732.708, "timestamp": "04:55:32", "text": "そういうものって、何であれね？分離"}, {"type": "subtitle", "time": 17737.59, "timestamp": "04:55:37", "text": "親友のように、私たちの文化のように"}, {"type": "subtitle", "time": 17740.55, "timestamp": "04:55:40", "text": "私たちはそういうものを持っていません"}, {"type": "subtitle", "time": 17742.708, "timestamp": "04:55:42", "text": "そして私たちはみんなを友達だと思っています"}, {"type": "subtitle", "time": 17744.75, "timestamp": "04:55:44", "text": "いいえ、そして私たちは"}, {"type": "subtitle", "time": 17748.868, "timestamp": "04:55:48", "text": "えっと、私たちは彼らと一緒にいて、"}, {"type": "subtitle", "time": 17751.99, "timestamp": "04:55:51", "text": "最高の時間を過ごして、友達と楽しい時間を過ごしましょう"}, {"type": "subtitle", "time": 17753.07, "timestamp": "04:55:53", "text": "友達"}, {"type": "subtitle", "time": 17756.47, "timestamp": "04:55:56", "text": "そうそう、同じだと思う"}, {"type": "subtitle", "time": 17759.19, "timestamp": "04:55:59", "text": "えっと、それが来たとき、私はそれを学んだと思います"}]
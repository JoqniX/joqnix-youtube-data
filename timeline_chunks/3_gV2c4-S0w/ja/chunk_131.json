[{"type": "subtitle", "time": 7876.709, "timestamp": "02:11:16", "text": "子供。待って、私は正しいものを実行しているのだろうか"}, {"type": "subtitle", "time": 7878.91, "timestamp": "02:11:18", "text": "シェーダー"}, {"type": "subtitle", "time": 7882.31, "timestamp": "02:11:22", "text": "これ？えっと"}, {"type": "subtitle", "time": 7886.669, "timestamp": "02:11:26", "text": "どこにあるの"}, {"type": "subtitle", "time": 7895.39, "timestamp": "02:11:35", "text": "何が変に見えるの？えっと、"}, {"type": "subtitle", "time": 7901.35, "timestamp": "02:11:41", "text": "シェーダーは、ああ、たぶん"}, {"type": "subtitle", "time": 7903.189, "timestamp": "02:11:43", "text": "だって今は明かりがないんだもん。たぶん"}, {"type": "subtitle", "time": 7905.75, "timestamp": "02:11:45", "text": "かもしれない。ええ、ここは暗いですよね？"}, {"type": "subtitle", "time": 7908.39, "timestamp": "02:11:48", "text": "ああ、同じ色合いですね。私が見たロッカ"}, {"type": "subtitle", "time": 7914.95, "timestamp": "02:11:54", "text": "うん、暗いところではちょっと難しい"}]
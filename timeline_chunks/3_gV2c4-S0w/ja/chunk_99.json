[{"type": "subtitle", "time": 5947.669, "timestamp": "01:39:07", "text": "マルチバース。これが3を生み出す"}, {"type": "subtitle", "time": 5950.43, "timestamp": "01:39:10", "text": "リソース。ログを見てください"}, {"type": "subtitle", "time": 5952.109, "timestamp": "01:39:12", "text": "サーバ。"}, {"type": "subtitle", "time": 5955.91, "timestamp": "01:39:15", "text": "何？コンソール。なんてこった。変更する"}, {"type": "subtitle", "time": 5959.51, "timestamp": "01:39:19", "text": "ブロック。何？何？これは何ですか？"}, {"type": "subtitle", "time": 5961.83, "timestamp": "01:39:21", "text": "何が起こっていますか？"}, {"type": "subtitle", "time": 5964.83, "timestamp": "01:39:24", "text": "CPUが言うのはなぜ"}, {"type": "subtitle", "time": 5976.43, "timestamp": "01:39:36", "text": "くそ。"}, {"type": "subtitle", "time": 5979.27, "timestamp": "01:39:39", "text": "マインクラフトの仕事。"}, {"type": "subtitle", "time": 5981.35, "timestamp": "01:39:41", "text": "私は参加できません。"}, {"type": "subtitle", "time": 5983.35, "timestamp": "01:39:43", "text": "やってみて。わかった、あのね？私にさせてください"}, {"type": "subtitle", "time": 5985.35, "timestamp": "01:39:45", "text": "願い事をすることで、彼女も"}, {"type": "subtitle", "time": 5993.75, "timestamp": "01:39:53", "text": "ああ、私も彼女に許可を与えたよ。それで、"}, {"type": "subtitle", "time": 5995.59, "timestamp": "01:39:55", "text": "うん、彼女はここに参加することも、外に出ることもできるよ"}]
[{"type": "subtitle", "time": 17580.628, "timestamp": "04:53:00", "text": "忙しいなど。私は、えっと、私は忙しいです"}, {"type": "subtitle", "time": 17583.27, "timestamp": "04:53:03", "text": "来月、来月など。そうすれば私は"}, {"type": "subtitle", "time": 17587.55, "timestamp": "04:53:07", "text": "それで構いません。右。私 私"}, {"type": "subtitle", "time": 17590.868, "timestamp": "04:53:10", "text": "さあ、どうだろうね。それは奇妙だった"}, {"type": "subtitle", "time": 17594.868, "timestamp": "04:53:14", "text": "交流と体験。そして私は"}, {"type": "subtitle", "time": 17596.43, "timestamp": "04:53:16", "text": "平"}, {"type": "subtitle", "time": 17599.55, "timestamp": "04:53:19", "text": "知る。それがどうなるかさえわからない"}, {"type": "subtitle", "time": 17603.19, "timestamp": "04:53:23", "text": "行く。たとえ彼らが私とコラボレーションしたとしても、私は"}, {"type": "subtitle", "time": 17613.75, "timestamp": "04:53:33", "text": "えっと、もう一つは、私たちは話さないということです"}, {"type": "subtitle", "time": 17615.67, "timestamp": "04:53:35", "text": "これらの人々のいずれかに、"}, {"type": "subtitle", "time": 17617.51, "timestamp": "04:53:37", "text": "日本人で、私たちが"}, {"type": "subtitle", "time": 17625.11, "timestamp": "04:53:45", "text": "うん。そしてこの人は私にこう尋ねました。"}, {"type": "subtitle", "time": 17627.67, "timestamp": "04:53:47", "text": "私のこの説明を見た後、または"}, {"type": "subtitle", "time": 17628.75, "timestamp": "04:53:48", "text": "パネルまたは"}, {"type": "subtitle", "time": 17632.39, "timestamp": "04:53:52", "text": "何か、そして日本へ移住するということは"}, {"type": "subtitle", "time": 17634.47, "timestamp": "04:53:54", "text": "日本に住んでいます。あなたは日本を知っていますか？持っている"}, {"type": "subtitle", "time": 17636.628, "timestamp": "04:53:56", "text": "以前、日本でコラボレーションをしたことはありますか？"}, {"type": "subtitle", "time": 17639.51, "timestamp": "04:53:59", "text": "日本語で説明しました"}]
[{"type": "subtitle", "time": 13740.83, "timestamp": "03:49:00", "text": "それでも、あなたは遅れています。"}, {"type": "subtitle", "time": 13743.63, "timestamp": "03:49:03", "text": "バカ。なぜ遅れているのですか？"}, {"type": "subtitle", "time": 13748.03, "timestamp": "03:49:08", "text": "けれど？ラグが発生しないのであれば、"}, {"type": "subtitle", "time": 13751.429, "timestamp": "03:49:11", "text": "つまり、彼女は私たちのブラウザです"}, {"type": "subtitle", "time": 13753.79, "timestamp": "03:49:13", "text": "私が主に使っているブラウザです。"}, {"type": "subtitle", "time": 13766.15, "timestamp": "03:49:26", "text": "多くの。さて、明日の朝の配信は"}, {"type": "subtitle", "time": 13769.269, "timestamp": "03:49:29", "text": "ええと、私が目覚めたら"}, {"type": "subtitle", "time": 13773.469, "timestamp": "03:49:33", "text": "時間。おそらく私は助けないだろうが、"}, {"type": "subtitle", "time": 13787.71, "timestamp": "03:49:47", "text": "[音楽]"}, {"type": "subtitle", "time": 13797.99, "timestamp": "03:49:57", "text": "あなたはジョーと一緒に過ごすつもりですか？うん、"}]
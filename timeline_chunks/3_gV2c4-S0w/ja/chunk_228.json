[{"type": "subtitle", "time": 13682.44, "timestamp": "03:48:02", "text": "実行中。えっと、"}, {"type": "subtitle", "time": 13695.75, "timestamp": "03:48:15", "text": "ブラウザ。そして面白いことに、"}, {"type": "subtitle", "time": 13698.269, "timestamp": "03:48:18", "text": "他のブラウザでも、"}, {"type": "subtitle", "time": 13702.07, "timestamp": "03:48:22", "text": "オプラックス。私はこれらのブラウザをすべて試してみました。わかった。"}, {"type": "subtitle", "time": 13705.11, "timestamp": "03:48:25", "text": "他のすべてのブラウザ"}, {"type": "subtitle", "time": 13708.55, "timestamp": "03:48:28", "text": "開くのがすごく遅い、"}, {"type": "subtitle", "time": 13711.67, "timestamp": "03:48:31", "text": "サイトがすごく遅くて、Arc が"}, {"type": "subtitle", "time": 13715.07, "timestamp": "03:48:35", "text": "ブラウザは、一部の未知のものに対してより高速です"}, {"type": "subtitle", "time": 13718.63, "timestamp": "03:48:38", "text": "理由。それは私が持っているから"}, {"type": "subtitle", "time": 13721.189, "timestamp": "03:48:41", "text": "私のPCとArcには複数のブラウザがあります"}, {"type": "subtitle", "time": 13724.07, "timestamp": "03:48:44", "text": "ブラウザは「そうだよジョッキー、行くよ」って感じ"}, {"type": "subtitle", "time": 13726.63, "timestamp": "03:48:46", "text": "今は私に頼るしかない。あなたはしない"}, {"type": "subtitle", "time": 13729.429, "timestamp": "03:48:49", "text": "他人のことを気にかける。えっと、君が欲しい"}, {"type": "subtitle", "time": 13733.349, "timestamp": "03:48:53", "text": "私だけを使う。それでは、"}, {"type": "subtitle", "time": 13736.11, "timestamp": "03:48:56", "text": "スピード。あなた、あなた、あなた"}, {"type": "subtitle", "time": 13738.87, "timestamp": "03:48:58", "text": "そんなのが欲しい？でもあなたは"}]
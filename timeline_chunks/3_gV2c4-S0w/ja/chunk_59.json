[{"type": "subtitle", "time": 3555.069, "timestamp": "00:59:15", "text": "日常的な綴り"}, {"type": "subtitle", "time": 3557.349, "timestamp": "00:59:17", "text": "ルーティーン？うん、変えなきゃ"}, {"type": "subtitle", "time": 3564.95, "timestamp": "00:59:24", "text": "唯一悲しいのは、"}, {"type": "subtitle", "time": 3567.51, "timestamp": "00:59:27", "text": "日本で起きていなければならない"}, {"type": "subtitle", "time": 3570.67, "timestamp": "00:59:30", "text": "午後10時に全員とコラボレーションします。"}, {"type": "subtitle", "time": 3575.67, "timestamp": "00:59:35", "text": "IST。あちらでは午前3時くらいだ。"}, {"type": "subtitle", "time": 3578.15, "timestamp": "00:59:38", "text": "ご希望であれば、早めに始めることも可能です。ええ、私たちは"}, {"type": "subtitle", "time": 3585.99, "timestamp": "00:59:45", "text": "いつ日本に行く予定ですか？忘れた。"}, {"type": "subtitle", "time": 3591.109, "timestamp": "00:59:51", "text": "7月までにはそちらに着く予定です。"}, {"type": "subtitle", "time": 3595.03, "timestamp": "00:59:55", "text": "ほんの数日。いくつかあります。数日"}, {"type": "subtitle", "time": 3597.23, "timestamp": "00:59:57", "text": "通り過ぎていくので"}]
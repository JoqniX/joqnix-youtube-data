[{"type": "subtitle", "time": 370.15, "timestamp": "00:06:10", "text": "次に、彼らが感じなくなる時点で"}, {"type": "subtitle", "time": 373.469, "timestamp": "00:06:13", "text": "選ばれた者のように。ええ、もちろんです。はい、はい。"}, {"type": "subtitle", "time": 378.23, "timestamp": "00:06:18", "text": "もちろん。なんだか面倒くさい気がする。"}, {"type": "subtitle", "time": 400.629, "timestamp": "00:06:40", "text": "椅子。私は少し心配しています"}, {"type": "subtitle", "time": 412.87, "timestamp": "00:06:52", "text": "コラボは全部"}, {"type": "subtitle", "time": 416.11, "timestamp": "00:06:56", "text": "私がコラボレーションした人々"}, {"type": "subtitle", "time": 418.029, "timestamp": "00:06:58", "text": "過去と"}]
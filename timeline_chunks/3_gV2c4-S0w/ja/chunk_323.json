[{"type": "subtitle", "time": 19383.43, "timestamp": "05:23:03", "text": "えーと対処していたのですが、私には選択肢がありませんでした"}, {"type": "subtitle", "time": 19387.51, "timestamp": "05:23:07", "text": "少し頼りに"}, {"type": "subtitle", "time": 19389.59, "timestamp": "05:23:09", "text": "彼らが本当に望んでいるならコミュニティ"}, {"type": "subtitle", "time": 19392.31, "timestamp": "05:23:12", "text": "支援やその他諸々。私は違います"}, {"type": "subtitle", "time": 19394.58, "timestamp": "05:23:14", "text": "誰かに強制する"}, {"type": "subtitle", "time": 19396.43, "timestamp": "05:23:16", "text": "[音楽]"}, {"type": "subtitle", "time": 19400.15, "timestamp": "05:23:20", "text": "えーっと、ええ、私は誰にも強制していません"}, {"type": "subtitle", "time": 19402.15, "timestamp": "05:23:22", "text": "どんなものにも寄付する。私は完全に"}, {"type": "subtitle", "time": 19406.07, "timestamp": "05:23:26", "text": "それで構いません。うん、そうだね。それで、えーと、それで私たちは"}, {"type": "subtitle", "time": 19408.868, "timestamp": "05:23:28", "text": "このジョアソンイベントは、"}, {"type": "subtitle", "time": 19412.15, "timestamp": "05:23:32", "text": "モデルやその他諸々の資金調達"}, {"type": "subtitle", "time": 19415.67, "timestamp": "05:23:35", "text": "しかし、私自身が成長するためにも"}, {"type": "subtitle", "time": 19418.628, "timestamp": "05:23:38", "text": "新型モデルと同様のトリマー。芸術は"}, {"type": "subtitle", "time": 19421.75, "timestamp": "05:23:41", "text": "完了しました。支払いが必要です。"}, {"type": "subtitle", "time": 19424.39, "timestamp": "05:23:44", "text": "モデルライセンス料を支払わなければならない。はい。"}, {"type": "subtitle", "time": 19427.35, "timestamp": "05:23:47", "text": "それと、索具とかその他諸々についても。"}, {"type": "subtitle", "time": 19429.628, "timestamp": "05:23:49", "text": "えっと、これは私の公式のものになる予定です"}, {"type": "subtitle", "time": 19432.39, "timestamp": "05:23:52", "text": "モデルで、とても素敵なモデルです。私"}, {"type": "subtitle", "time": 19434.31, "timestamp": "05:23:54", "text": "アーティストたちと一生懸命に取り組んで"}, {"type": "subtitle", "time": 19436.788, "timestamp": "05:23:56", "text": "もっと独創的で可愛くて、すべてが"}, {"type": "subtitle", "time": 19439.75, "timestamp": "05:23:59", "text": "そして私はそれをとても愛していて、"}]
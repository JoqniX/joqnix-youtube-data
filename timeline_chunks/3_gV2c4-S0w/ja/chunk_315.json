[{"type": "subtitle", "time": 18905.51, "timestamp": "05:15:05", "text": "えーと、だからいつも私たちは"}, {"type": "subtitle", "time": 18914.75, "timestamp": "05:15:14", "text": "セントあなたが見えてます。"}, {"type": "subtitle", "time": 18917.27, "timestamp": "05:15:17", "text": "ニース。えっと、もしEpic Gamesでプレイしているなら教えてください。"}, {"type": "subtitle", "time": 18919.59, "timestamp": "05:15:19", "text": "私も参加します。わかった。はい。はい。任せます"}, {"type": "subtitle", "time": 18929.35, "timestamp": "05:15:29", "text": "知る。また、ストリーミング配信はされていますか？"}, {"type": "subtitle", "time": 18933.43, "timestamp": "05:15:33", "text": "マレーシア？もうずいぶん経ちましたね。"}, {"type": "subtitle", "time": 18935.27, "timestamp": "05:15:35", "text": "実際にストリーミング配信しているのですか、それとも"}]
[{"type": "subtitle", "time": 18480.43, "timestamp": "05:08:00", "text": "コラボレーションとは、"}, {"type": "subtitle", "time": 18483.75, "timestamp": "05:08:03", "text": "彼らは英語が下手だ。つまり主に"}, {"type": "subtitle", "time": 18485.35, "timestamp": "05:08:05", "text": "日本語と韓国語。だから、わからない"}, {"type": "subtitle", "time": 18487.59, "timestamp": "05:08:07", "text": "韓国語。だから私は彼らと専門的な話をしなければならない"}, {"type": "subtitle", "time": 18488.67, "timestamp": "05:08:08", "text": "で"}, {"type": "subtitle", "time": 18492.07, "timestamp": "05:08:12", "text": "日本語が下手です。そして私は"}, {"type": "subtitle", "time": 18494.27, "timestamp": "05:08:14", "text": "実際に"}, {"type": "subtitle", "time": 18497.83, "timestamp": "05:08:17", "text": "日本人コラボだけど、英語も話せる。"}, {"type": "subtitle", "time": 18501.39, "timestamp": "05:08:21", "text": "私は何とか生き残れることを示す"}, {"type": "subtitle", "time": 18505.51, "timestamp": "05:08:25", "text": "壊れた壊れた日本語と少し"}, {"type": "subtitle", "time": 18507.83, "timestamp": "05:08:27", "text": "ところどころ英語が少し混ざっている。うん、"}, {"type": "subtitle", "time": 18509.15, "timestamp": "05:08:29", "text": "でもああ"}, {"type": "subtitle", "time": 18518.31, "timestamp": "05:08:38", "text": "いいえ、私は他の人に連絡を取らなければなりません"}, {"type": "subtitle", "time": 18520.948, "timestamp": "05:08:40", "text": "人。 Apexとのコラボレーションはどうなったのか"}, {"type": "subtitle", "time": 18522.868, "timestamp": "05:08:42", "text": "私たちが計画していた？彼らはまるでスーパー"}, {"type": "subtitle", "time": 18524.948, "timestamp": "05:08:44", "text": "でも忙しいんです。"}, {"type": "subtitle", "time": 18527.39, "timestamp": "05:08:47", "text": "あの日本のユーチューバーは超"}, {"type": "subtitle", "time": 18535.11, "timestamp": "05:08:55", "text": "トーナメント。うん。今は一般開業医が中心です。ああ、"}, {"type": "subtitle", "time": 18537.11, "timestamp": "05:08:57", "text": "神。彼らは多くの地元のイベントに参加しています"}]
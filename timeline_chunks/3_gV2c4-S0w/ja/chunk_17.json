[{"type": "subtitle", "time": 1021.91, "timestamp": "00:17:01", "text": "とか、そういう類のもの。彼らは詮索し始める"}, {"type": "subtitle", "time": 1025.99, "timestamp": "00:17:05", "text": "自分の持ち物について、そして尋ねるように"}, {"type": "subtitle", "time": 1029.909, "timestamp": "00:17:09", "text": "えっと、これを何日も続けていて"}, {"type": "subtitle", "time": 1032.789, "timestamp": "00:17:12", "text": "なぜうまく機能しないのかなど、すべて"}, {"type": "subtitle", "time": 1034.829, "timestamp": "00:17:14", "text": "批評することなど"}, {"type": "subtitle", "time": 1038.909, "timestamp": "00:17:18", "text": "もちろん建設的な批判は"}, {"type": "subtitle", "time": 1041.069, "timestamp": "00:17:21", "text": "もちろん"}, {"type": "subtitle", "time": 1042.99, "timestamp": "00:17:22", "text": "ゴカ"}, {"type": "subtitle", "time": 1046.75, "timestamp": "00:17:26", "text": "しかし、それは"}, {"type": "subtitle", "time": 1050.63, "timestamp": "00:17:30", "text": "もし私が誰かに同意を与えたり、"}, {"type": "subtitle", "time": 1055.11, "timestamp": "00:17:35", "text": "えっと、私は彼らにやらせたけど、もし私が"}, {"type": "subtitle", "time": 1057.75, "timestamp": "00:17:37", "text": "彼らに許可を与えさせてはいけない"}, {"type": "subtitle", "time": 1061.63, "timestamp": "00:17:41", "text": "そして彼らはそれを"}, {"type": "subtitle", "time": 1065.59, "timestamp": "00:17:45", "text": "えっと、もしそれが私の友達だったら"}, {"type": "subtitle", "time": 1068.47, "timestamp": "00:17:48", "text": "もし私たちが親しい関係だったら、"}, {"type": "subtitle", "time": 1072.31, "timestamp": "00:17:52", "text": "ほら、私たちは友達だってわかってるよ"}, {"type": "subtitle", "time": 1074.31, "timestamp": "00:17:54", "text": "私は良い友達です、ただ"}, {"type": "subtitle", "time": 1077.39, "timestamp": "00:17:57", "text": "文化を与えることは、"}]
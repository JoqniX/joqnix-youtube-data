[{"type": "subtitle", "time": 12724.71, "timestamp": "03:32:04", "text": "おやすみなさい。おやすみ。良い"}, {"type": "subtitle", "time": 12726.03, "timestamp": "03:32:06", "text": "夜。"}, {"type": "subtitle", "time": 12727.95, "timestamp": "03:32:07", "text": "寝る。良い"}, {"type": "subtitle", "time": 12731.349, "timestamp": "03:32:11", "text": "夜。今夜、星々があなたを導いてくれる"}, {"type": "subtitle", "time": 12743.71, "timestamp": "03:32:23", "text": "夢。はい、そうです"}, {"type": "subtitle", "time": 12747.91, "timestamp": "03:32:27", "text": "働く。私はラップをしなければならない。私は本当に"}, {"type": "subtitle", "time": 12754.83, "timestamp": "03:32:34", "text": "私は60年を終えた"}, {"type": "subtitle", "time": 12757.389, "timestamp": "03:32:37", "text": "昨日。それから私は"}, {"type": "subtitle", "time": 12764.03, "timestamp": "03:32:44", "text": "ストリーム"}, {"type": "subtitle", "time": 12766.91, "timestamp": "03:32:46", "text": "61. それを置いて"}, {"type": "subtitle", "time": 12769.51, "timestamp": "03:32:49", "text": "そこには。これは朝の配信だった。今"}, {"type": "subtitle", "time": 12773.269, "timestamp": "03:32:53", "text": "私は頭の中が真っ白で、こう思った。"}, {"type": "subtitle", "time": 12777.67, "timestamp": "03:32:57", "text": "ゲームをしよう。そして私たちはそれをやった"}]
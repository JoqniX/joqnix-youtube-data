[{"type": "subtitle", "time": 16980.51, "timestamp": "04:43:00", "text": "それで"}, {"type": "subtitle", "time": 16984.23, "timestamp": "04:43:04", "text": "好きだけど、"}, {"type": "subtitle", "time": 16986.948, "timestamp": "04:43:06", "text": "ああ、私たちは親密ではなかったけれど、"}, {"type": "subtitle", "time": 16990.55, "timestamp": "04:43:10", "text": "私たちには何らかの繋がりがあったんだ。"}, {"type": "subtitle", "time": 16993.03, "timestamp": "04:43:13", "text": "うん、これもまたパラソーシャルだけど、それでも"}, {"type": "subtitle", "time": 16996.628, "timestamp": "04:43:16", "text": "えっと、いや、彼らはあなたのことを知らない、あなたは"}, {"type": "subtitle", "time": 16999.948, "timestamp": "04:43:19", "text": "彼らにとって全く見知らぬ人"}, {"type": "subtitle", "time": 17002.708, "timestamp": "04:43:22", "text": "もの。あなたは活動を行いました"}, {"type": "subtitle", "time": 17005.83, "timestamp": "04:43:25", "text": "一緒に活動したり、"}, {"type": "subtitle", "time": 17009.27, "timestamp": "04:43:29", "text": "声で言うとそうでなくても"}, {"type": "subtitle", "time": 17012.15, "timestamp": "04:43:32", "text": "直接話すように話すが、"}, {"type": "subtitle", "time": 17014.708, "timestamp": "04:43:34", "text": "VCとかゲームVCとかそういうの"}, {"type": "subtitle", "time": 17016.948, "timestamp": "04:43:36", "text": "もう一度プレイして、それらのものを全部詰め込んでください。"}, {"type": "subtitle", "time": 17021.19, "timestamp": "04:43:41", "text": "ああ、でも、私が近づいたとき"}, {"type": "subtitle", "time": 17022.43, "timestamp": "04:43:42", "text": "のように"}, {"type": "subtitle", "time": 17024.27, "timestamp": "04:43:44", "text": "たむろしたり、"}, {"type": "subtitle", "time": 17027.75, "timestamp": "04:43:47", "text": "コラボの理由がわからないけど、たぶん"}, {"type": "subtitle", "time": 17030.948, "timestamp": "04:43:50", "text": "なぜなら彼女はより高い番号が好きだったから"}, {"type": "subtitle", "time": 17031.788, "timestamp": "04:43:51", "text": "そして"}, {"type": "subtitle", "time": 17034.47, "timestamp": "04:43:54", "text": "2つの深刻なこととか、私はそうは思わない"}, {"type": "subtitle", "time": 17037.99, "timestamp": "04:43:57", "text": "わかってるけど、そう、彼らは感じたみたい"}]
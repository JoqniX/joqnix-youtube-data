[{"type": "subtitle", "time": 9120.27, "timestamp": "02:32:00", "text": "もしかしたら私たちは"}, {"type": "subtitle", "time": 9122.59, "timestamp": "02:32:02", "text": "ライトを追加する"}, {"type": "subtitle", "time": 9126.23, "timestamp": "02:32:06", "text": "何かのソース。私はそれを実現する"}, {"type": "subtitle", "time": 9129.91, "timestamp": "02:32:09", "text": "木の内側、つまり木の真下。"}, {"type": "subtitle", "time": 9133.429, "timestamp": "02:32:13", "text": "どれ？ランタンのことですよね？"}, {"type": "subtitle", "time": 9135.75, "timestamp": "02:32:15", "text": "そこに。"}, {"type": "subtitle", "time": 9137.91, "timestamp": "02:32:17", "text": "おお、"}, {"type": "subtitle", "time": 9141.59, "timestamp": "02:32:21", "text": "かっこいいと思いませんか？なぜ"}, {"type": "subtitle", "time": 9145.59, "timestamp": "02:32:25", "text": "クリーパーは、えーと、あれみたいに見える。"}, {"type": "subtitle", "time": 9148.389, "timestamp": "02:32:28", "text": "あの春のやつ、知ってる？うん、"}, {"type": "subtitle", "time": 9151.91, "timestamp": "02:32:31", "text": "それが私が追加したアニメーションです。くそ。"}, {"type": "subtitle", "time": 9154.469, "timestamp": "02:32:34", "text": "より高度な技術が、より恐ろしく見える。何もない。"}, {"type": "subtitle", "time": 9159.11, "timestamp": "02:32:39", "text": "あなたはあのクリーパーを見たことがありません。"}]
[{"type": "subtitle", "time": 6727.669, "timestamp": "01:52:07", "text": "つる植物。ああ、またラグったよ。ええ、私は"}, {"type": "subtitle", "time": 6730.83, "timestamp": "01:52:10", "text": "やらなきゃいけないってわかってた"}, {"type": "subtitle", "time": 6737.7, "timestamp": "01:52:17", "text": "また。いやいや、残りはほんのわずかだよ。"}, {"type": "subtitle", "time": 6750.03, "timestamp": "01:52:30", "text": "なぜミルクが滴るのか？"}, {"type": "subtitle", "time": 6768.07, "timestamp": "01:52:48", "text": "ああ、隠された隠された"}, {"type": "subtitle", "time": 6770.52, "timestamp": "01:52:50", "text": "地下層。"}, {"type": "subtitle", "time": 6773.27, "timestamp": "01:52:53", "text": "[音楽]"}, {"type": "subtitle", "time": 6774.87, "timestamp": "01:52:54", "text": "でも、たくさん働かないといけないんだよ"}, {"type": "subtitle", "time": 6777.109, "timestamp": "01:52:57", "text": "これらすべてを可能にするためだけに。あなた"}, {"type": "subtitle", "time": 6779.99, "timestamp": "01:52:59", "text": "すべてを理解する必要がある"}]
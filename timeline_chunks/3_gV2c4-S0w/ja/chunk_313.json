[{"type": "subtitle", "time": 18785.39, "timestamp": "05:13:05", "text": "でも、勉強しなきゃいけないんだ"}, {"type": "subtitle", "time": 18788.788, "timestamp": "05:13:08", "text": "今。でも、先生は"}, {"type": "subtitle", "time": 18807.43, "timestamp": "05:13:27", "text": "いいね、いいね、いいね。"}, {"type": "subtitle", "time": 18810.15, "timestamp": "05:13:30", "text": "森の太陽 スケジュール1 東京"}, {"type": "subtitle", "time": 18813.07, "timestamp": "05:13:33", "text": "東京エクストリームレース"}, {"type": "subtitle", "time": 18824.55, "timestamp": "05:13:44", "text": "ゲーム。うん、私は失望させてはいけない"}, {"type": "subtitle", "time": 18827.39, "timestamp": "05:13:47", "text": "つまり、そう、実際には私はそうすべきではない"}, {"type": "subtitle", "time": 18830.07, "timestamp": "05:13:50", "text": "失望。彼は多くのことを成し遂げた"}, {"type": "subtitle", "time": 18832.75, "timestamp": "05:13:52", "text": "今すぐ追加"}, {"type": "subtitle", "time": 18834.91, "timestamp": "05:13:54", "text": "クラスと"}, {"type": "subtitle", "time": 18838.11, "timestamp": "05:13:58", "text": "すべて、そして実際に必要なこと"}]
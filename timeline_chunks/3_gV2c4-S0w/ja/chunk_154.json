[{"type": "subtitle", "time": 9243.59, "timestamp": "02:34:03", "text": "では、"}, {"type": "subtitle", "time": 9245.349, "timestamp": "02:34:05", "text": "待って。では、クレジットと"}, {"type": "subtitle", "time": 9248.19, "timestamp": "02:34:08", "text": "じゃあ、何か？どうなるだろうか"}, {"type": "subtitle", "time": 9251.59, "timestamp": "02:34:11", "text": "ファンフィクションの作者としてクレジットされていますか？いいえ。"}, {"type": "subtitle", "time": 9257.03, "timestamp": "02:34:17", "text": "えっと、公式のファンフィクションとか"}, {"type": "subtitle", "time": 9260.03, "timestamp": "02:34:20", "text": "何か？それはただ"}, {"type": "subtitle", "time": 9267.389, "timestamp": "02:34:27", "text": "どこかに投稿するだけです。"}, {"type": "subtitle", "time": 9270.75, "timestamp": "02:34:30", "text": "ハァ。私は今、もしそれが"}, {"type": "subtitle", "time": 9273.91, "timestamp": "02:34:33", "text": "えっと、ラジオはファンメイドのものではない"}, {"type": "subtitle", "time": 9276.87, "timestamp": "02:34:36", "text": "公開した直後"}, {"type": "subtitle", "time": 9280.63, "timestamp": "02:34:40", "text": "クレジットの作成方法"}, {"type": "subtitle", "time": 9283.99, "timestamp": "02:34:43", "text": "クレジット表記はどのようになるのでしょうか"}, {"type": "subtitle", "time": 9285.91, "timestamp": "02:34:45", "text": "今、必要なのは、私はそこにないと思う"}, {"type": "subtitle", "time": 9288.389, "timestamp": "02:34:48", "text": "それに対する評価があるだろう"}, {"type": "subtitle", "time": 9293.19, "timestamp": "02:34:53", "text": "あなたの人々が正しいことをしてくれたので"}, {"type": "subtitle", "time": 9297.83, "timestamp": "02:34:57", "text": "はい、コミュニティが作りました。"}, {"type": "subtitle", "time": 9299.75, "timestamp": "02:34:59", "text": "うん、"}]
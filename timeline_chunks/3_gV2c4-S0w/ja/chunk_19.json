[{"type": "subtitle", "time": 1140.15, "timestamp": "00:19:00", "text": "長年にわたり、世界中の人々が"}, {"type": "subtitle", "time": 1141.87, "timestamp": "00:19:01", "text": "右？"}, {"type": "subtitle", "time": 1145.27, "timestamp": "00:19:05", "text": "本当に心から願う人だけ"}, {"type": "subtitle", "time": 1149.35, "timestamp": "00:19:09", "text": "自分のものを楽しんで、話すことを楽しみ、"}, {"type": "subtitle", "time": 1152.31, "timestamp": "00:19:12", "text": "私の関与と交流と"}, {"type": "subtitle", "time": 1155.19, "timestamp": "00:19:15", "text": "すべてと私のコンテンツ。彼らはただ"}, {"type": "subtitle", "time": 1158.87, "timestamp": "00:19:18", "text": "来て、今も見て、今も"}, {"type": "subtitle", "time": 1161.43, "timestamp": "00:19:21", "text": "私の視聴者で、来るのが好きな人"}, {"type": "subtitle", "time": 1164.669, "timestamp": "00:19:24", "text": "すべてにおいて、そうですよね？感謝します"}, {"type": "subtitle", "time": 1168.549, "timestamp": "00:19:28", "text": "それ。うん、特に"}, {"type": "subtitle", "time": 1171.59, "timestamp": "00:19:31", "text": "レイドなど。ストリーマーが来たとき"}, {"type": "subtitle", "time": 1174.07, "timestamp": "00:19:34", "text": "彼らはストリームを終了し、別の場所を襲撃する"}, {"type": "subtitle", "time": 1177.27, "timestamp": "00:19:37", "text": "新しいチャンネルをすべての人々に"}, {"type": "subtitle", "time": 1179.51, "timestamp": "00:19:39", "text": "100人を襲撃している人たち"}, {"type": "subtitle", "time": 1182.39, "timestamp": "00:19:42", "text": "襲撃者として送り込むのですか"}, {"type": "subtitle", "time": 1185.27, "timestamp": "00:19:45", "text": "別のチャンネルでは誰もが"}, {"type": "subtitle", "time": 1189.39, "timestamp": "00:19:49", "text": "評価の高いものを購読またはフォローしたいですか？"}, {"type": "subtitle", "time": 1192.35, "timestamp": "00:19:52", "text": "彼らがチャンネルする"}, {"type": "subtitle", "time": 1195.43, "timestamp": "00:19:55", "text": "フォローされるに値する必要がある"}, {"type": "subtitle", "time": 1197.669, "timestamp": "00:19:57", "text": "その購読に値する、その購読に値する"}]
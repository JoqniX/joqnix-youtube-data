[{"type": "subtitle", "time": 962.189, "timestamp": "00:16:02", "text": "私のジョアソンイベント"}, {"type": "subtitle", "time": 965.269, "timestamp": "00:16:05", "text": "など。ジョアトンイベントに対する批判"}, {"type": "subtitle", "time": 967.829, "timestamp": "00:16:07", "text": "そして全て。批評家たちは"}, {"type": "subtitle", "time": 971.629, "timestamp": "00:16:11", "text": "犬のことさえも私を"}, {"type": "subtitle", "time": 975.069, "timestamp": "00:16:15", "text": "もっともっと"}, {"type": "subtitle", "time": 977.23, "timestamp": "00:16:17", "text": "傷つきやすいと感じている"}, {"type": "subtitle", "time": 984.87, "timestamp": "00:16:24", "text": "例えば、こう考えてみてください。"}, {"type": "subtitle", "time": 988.949, "timestamp": "00:16:28", "text": "あなたはデビューか何かをしている"}, {"type": "subtitle", "time": 993.069, "timestamp": "00:16:33", "text": "少人数の小規模イベント"}, {"type": "subtitle", "time": 996.47, "timestamp": "00:16:36", "text": "何かを持ってきたい"}, {"type": "subtitle", "time": 998.87, "timestamp": "00:16:38", "text": "そしてその後、彼らはあなたのように"}, {"type": "subtitle", "time": 1000.87, "timestamp": "00:16:40", "text": "コラボレーションなどをスケジュールする"}, {"type": "subtitle", "time": 1003.35, "timestamp": "00:16:43", "text": "他のクリエイターまたは新しいクリエイター 次へ"}, {"type": "subtitle", "time": 1005.509, "timestamp": "00:16:45", "text": "来月か来週か何かで、"}, {"type": "subtitle", "time": 1008.15, "timestamp": "00:16:48", "text": "たまたまあなたのコンテンツをチェックして、"}, {"type": "subtitle", "time": 1011.91, "timestamp": "00:16:51", "text": "理由は不明ですが、"}, {"type": "subtitle", "time": 1013.829, "timestamp": "00:16:53", "text": "理由を知るのではなく"}, {"type": "subtitle", "time": 1016.47, "timestamp": "00:16:56", "text": "あなたのすることを尊重し、"}, {"type": "subtitle", "time": 1019.069, "timestamp": "00:16:59", "text": "あなたは自分のことをして"}]
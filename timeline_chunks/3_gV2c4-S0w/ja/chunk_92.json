[{"type": "subtitle", "time": 5520.629, "timestamp": "01:32:00", "text": "秒これは何ですか？これが地図です。おお、"}, {"type": "subtitle", "time": 5523.59, "timestamp": "01:32:03", "text": "うん。私たちはただそれを覚えているだけだ。えっと、それ"}, {"type": "subtitle", "time": 5527.91, "timestamp": "01:32:07", "text": "OKをブロックできます。うん。つまり、"}, {"type": "subtitle", "time": 5530.31, "timestamp": "01:32:10", "text": "えーと、このモードでは、"}, {"type": "subtitle", "time": 5532.95, "timestamp": "01:32:12", "text": "プレイヤーは一度戻ることができます"}, {"type": "subtitle", "time": 5535.03, "timestamp": "01:32:15", "text": "ボブスクロールまたは"}, {"type": "subtitle", "time": 5538.31, "timestamp": "01:32:18", "text": "充電式ボブストーンまたは既存の"}, {"type": "subtitle", "time": 5542.79, "timestamp": "01:32:22", "text": "次々と飛び移る。ああ、わかった。"}, {"type": "subtitle", "time": 5544.91, "timestamp": "01:32:24", "text": "だからそれは"}, {"type": "subtitle", "time": 5548.79, "timestamp": "01:32:28", "text": "えーっと、テレポートするためのものなの？"}, {"type": "subtitle", "time": 5552.79, "timestamp": "01:32:32", "text": "異なる地域。今、私たちは"}, {"type": "subtitle", "time": 5557.27, "timestamp": "01:32:37", "text": "例えば"}, {"type": "subtitle", "time": 5559.75, "timestamp": "01:32:39", "text": "えーと、例えば、なんて呼ぶんだっけ？"}, {"type": "subtitle", "time": 5562.149, "timestamp": "01:32:42", "text": "仮に、私たちが桜地域を形成したとしましょう。"}, {"type": "subtitle", "time": 5564.87, "timestamp": "01:32:44", "text": "今は略奪軍のように"}, {"type": "subtitle", "time": 5567.83, "timestamp": "01:32:47", "text": "地図には、一方通行の石があるとしましょう。"}, {"type": "subtitle", "time": 5571.59, "timestamp": "01:32:51", "text": "あちらには別の道標があります"}, {"type": "subtitle", "time": 5572.43, "timestamp": "01:32:52", "text": "の上"}, {"type": "subtitle", "time": 5577.51, "timestamp": "01:32:57", "text": "昨日私たちがいた場所のような"}]
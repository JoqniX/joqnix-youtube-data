[{"type": "subtitle", "time": 18002.51, "timestamp": "05:00:02", "text": "おい、俺は"}, {"type": "subtitle", "time": 18007.07, "timestamp": "05:00:07", "text": "f でも、ああ、わからない、私はそんなに大きなものを送った"}, {"type": "subtitle", "time": 18010.788, "timestamp": "05:00:10", "text": "各ポイントを説明する長い段落"}, {"type": "subtitle", "time": 18013.43, "timestamp": "05:00:13", "text": "そして今回は必ず入力しました"}, {"type": "subtitle", "time": 18015.43, "timestamp": "05:00:15", "text": "日本語訳と、"}, {"type": "subtitle", "time": 18019.99, "timestamp": "05:00:19", "text": "使用されたのは、Google翻訳を使用したためです。"}, {"type": "subtitle", "time": 18021.55, "timestamp": "05:00:21", "text": "えーと"}, {"type": "subtitle", "time": 18025.83, "timestamp": "05:00:25", "text": "彼らがそれを見てくれることを願おう"}, {"type": "subtitle", "time": 18028.99, "timestamp": "05:00:28", "text": "彼らが興味を持っている場合。あなたが知っている"}, {"type": "subtitle", "time": 18032.39, "timestamp": "05:00:32", "text": "何？そして私は気づいた、そう、この"}, {"type": "subtitle", "time": 18035.91, "timestamp": "05:00:35", "text": "旅には次のような瞬間があります"}, {"type": "subtitle", "time": 18039.51, "timestamp": "05:00:39", "text": "ここはあなたが避けられる場所、"}, {"type": "subtitle", "time": 18041.31, "timestamp": "05:00:41", "text": "拒否されます"}, {"type": "subtitle", "time": 18045.948, "timestamp": "05:00:45", "text": "など、失礼な、ひどい"}, {"type": "subtitle", "time": 18048.51, "timestamp": "05:00:48", "text": "経験。それはあなたが旅の一部です"}, {"type": "subtitle", "time": 18050.75, "timestamp": "05:00:50", "text": "知る。その"}, {"type": "subtitle", "time": 18053.43, "timestamp": "05:00:53", "text": "また、しかしそれは私がそうすべきだという意味ではない"}, {"type": "subtitle", "time": 18056.11, "timestamp": "05:00:56", "text": "コラボレーションをやめる"}, {"type": "subtitle", "time": 18059.51, "timestamp": "05:00:59", "text": "すべてにおいて。うん、そうだね"}]
[{"type": "subtitle", "time": 17041.788, "timestamp": "04:44:01", "text": "私のアプローチは"}, {"type": "subtitle", "time": 17051.47, "timestamp": "04:44:11", "text": "うーん、ある意味で"}, {"type": "subtitle", "time": 17054.868, "timestamp": "04:44:14", "text": "えっと、なんて言うんだっけ、彼らは私の"}, {"type": "subtitle", "time": 17057.91, "timestamp": "04:44:17", "text": "アプローチは、彼らの"}, {"type": "subtitle", "time": 17060.43, "timestamp": "04:44:20", "text": "願い事と"}, {"type": "subtitle", "time": 17062.27, "timestamp": "04:44:22", "text": "物と"}, {"type": "subtitle", "time": 17065.11, "timestamp": "04:44:25", "text": "あなたが手に入れるものすべて、私が手に入れるもの"}, {"type": "subtitle", "time": 17067.43, "timestamp": "04:44:27", "text": "えーと、今彼らはそれを"}, {"type": "subtitle", "time": 17069.91, "timestamp": "04:44:29", "text": "取引的アプローチではなく"}, {"type": "subtitle", "time": 17071.01, "timestamp": "04:44:31", "text": "真のつながり"}, {"type": "subtitle", "time": 17076.11, "timestamp": "04:44:36", "text": "理解できない"}, {"type": "subtitle", "time": 17079.19, "timestamp": "04:44:39", "text": "最初に私が尋ねたとき"}, {"type": "subtitle", "time": 17081.11, "timestamp": "04:44:41", "text": "わからないけど、"}, {"type": "subtitle", "time": 17083.91, "timestamp": "04:44:43", "text": "日本語は、日本語しか話せないから"}, {"type": "subtitle", "time": 17086.39, "timestamp": "04:44:46", "text": "日本語しか話せず、英語は話せません。彼らはそうする"}, {"type": "subtitle", "time": 17089.55, "timestamp": "04:44:49", "text": "好き"}, {"type": "subtitle", "time": 17093.67, "timestamp": "04:44:53", "text": "ええ、たとえ"}, {"type": "subtitle", "time": 17096.19, "timestamp": "04:44:56", "text": "彼らは翻訳者を使って"}, {"type": "subtitle", "time": 17099.03, "timestamp": "04:44:59", "text": "ディープラーを使ったものや送信するもの"}]
[{"type": "subtitle", "time": 5040.99, "timestamp": "01:24:00", "text": "取引。正当な正当な"}, {"type": "subtitle", "time": 5043.83, "timestamp": "01:24:03", "text": "正当な使用理由"}, {"type": "subtitle", "time": 5046.709, "timestamp": "01:24:06", "text": "この機能には、接続速度が遅いといった問題が含まれます。"}, {"type": "subtitle", "time": 5049.59, "timestamp": "01:24:09", "text": "ただし、事前にサーバー管理者に確認してください。"}, {"type": "subtitle", "time": 5052.59, "timestamp": "01:24:12", "text": "このオプションを設定すると、"}, {"type": "subtitle", "time": 5054.59, "timestamp": "01:24:14", "text": "サーバ。"}, {"type": "subtitle", "time": 5057.35, "timestamp": "01:24:17", "text": "ああ、それについてどう思いますか？行く"}, {"type": "subtitle", "time": 5061.75, "timestamp": "01:24:21", "text": "水を与えれば、あなたは失うことはないでしょう"}, {"type": "subtitle", "time": 5065.669, "timestamp": "01:24:25", "text": "えーっと息をして、もしあなたがそうしたくないなら、手を離してください"}, {"type": "subtitle", "time": 5068.629, "timestamp": "01:24:28", "text": "鍵の。"}, {"type": "subtitle", "time": 5074.629, "timestamp": "01:24:34", "text": "何だって？えっと、そういうモードがあって"}, {"type": "subtitle", "time": 5077.83, "timestamp": "01:24:37", "text": "えっと、実際に息を止めなければならない"}, {"type": "subtitle", "time": 5080.87, "timestamp": "01:24:40", "text": "水中に入ると、"}, {"type": "subtitle", "time": 5084.59, "timestamp": "01:24:44", "text": "物、つまりそれは"}, {"type": "subtitle", "time": 5087.27, "timestamp": "01:24:47", "text": "えっと、あの状況は覚えてるよね"}, {"type": "subtitle", "time": 5091.189, "timestamp": "01:24:51", "text": "私は廃墟の中で水から生まれて死んだ"}, {"type": "subtitle", "time": 5093.99, "timestamp": "01:24:53", "text": "ラグや接続の遅さなどが原因で"}, {"type": "subtitle", "time": 5099.51, "timestamp": "01:24:59", "text": "などなど。そうですよね？同じことですが、"}]
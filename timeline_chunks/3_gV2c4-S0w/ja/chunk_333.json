[{"type": "subtitle", "time": 19983.11, "timestamp": "05:33:03", "text": "みんな。大丈夫。大丈夫。"}, {"type": "subtitle", "time": 19987.788, "timestamp": "05:33:07", "text": "心配しないで。えっと、それはあなたです"}, {"type": "subtitle", "time": 19990.708, "timestamp": "05:33:10", "text": "すぐ。いいえ、いいえ、私は実際に"}, {"type": "subtitle", "time": 19994.11, "timestamp": "05:33:14", "text": "本当に安定している。ああ、心配しないでください。時計"}, {"type": "subtitle", "time": 19997.03, "timestamp": "05:33:17", "text": "自分。なぜそれが動作しないのか"}, {"type": "subtitle", "time": 19998.11, "timestamp": "05:33:18", "text": "ビリー"}, {"type": "subtitle", "time": 20005.47, "timestamp": "05:33:25", "text": "仕事してるの？"}, {"type": "subtitle", "time": 20007.23, "timestamp": "05:33:27", "text": "えっと"}, {"type": "subtitle", "time": 20009.47, "timestamp": "05:33:29", "text": "ウェブカメラ"}, {"type": "subtitle", "time": 20012.39, "timestamp": "05:33:32", "text": "設定。ああ、中国語で入力できますよ。私"}, {"type": "subtitle", "time": 20013.708, "timestamp": "05:33:33", "text": "意思"}, {"type": "subtitle", "time": 20016.99, "timestamp": "05:33:36", "text": "翻訳する。あなたは数ヶ月前に言いました"}, {"type": "subtitle", "time": 20018.99, "timestamp": "05:33:38", "text": "前。"}, {"type": "chat", "time": 20025.71, "timestamp": "05:33:45", "author": "@user-suxixhwhw", "avatar": "https://yt4.ggpht.com/3KsOaL3SpNB0m8gI_gLx-_74lNsgZI7V_tLFnIDrqXpSnc2Vyp3BeNpI45BSqXINkNe8T_aHvd8=s64-c-k-c0x00ffffff-no-rj", "message": "Here I come UCkszU2WH9gy1mb0dV-11UJg/LsMfY8P6G-yckNAPjoWA8AI"}, {"type": "subtitle", "time": 20026.27, "timestamp": "05:33:46", "text": "平均？あなたは何を"}, {"type": "chat", "time": 20028.693, "timestamp": "05:33:48", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Greetings Konzteller! Spongebob Skywalker~🌟 Welcome to the Guild! Make sure to read the Guildmate Guidelines in the description below before chatting further. Enjoy your stay!"}, {"type": "subtitle", "time": 20029.39
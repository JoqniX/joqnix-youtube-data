[{"type": "subtitle", "time": 13081.229, "timestamp": "03:38:01", "text": "北西方向へ向かう？私たち。"}, {"type": "subtitle", "time": 13092.71, "timestamp": "03:38:12", "text": "カリフォルニア？待って、北東って何だったっけ？"}, {"type": "subtitle", "time": 13116.87, "timestamp": "03:38:36", "text": "発売されましたか？おお。あ、待って。私はやらなければならない"}, {"type": "subtitle", "time": 13118.79, "timestamp": "03:38:38", "text": "おお。そうそう。うん。うん。うん。ああ、"}, {"type": "subtitle", "time": 13121.309, "timestamp": "03:38:41", "text": "うん。あの人たちは"}, {"type": "subtitle", "time": 13124.469, "timestamp": "03:38:44", "text": "開発者。モンタナ州。ああ、それは聞こえましたよ。"}, {"type": "subtitle", "time": 13137.67, "timestamp": "03:38:57", "text": "動作が遅い？いいえ。わかりました。復活した。すべて閉じます"}]
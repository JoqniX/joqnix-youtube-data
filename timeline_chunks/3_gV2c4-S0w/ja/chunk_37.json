[{"type": "subtitle", "time": 2228.43, "timestamp": "00:37:08", "text": "わかった。うん、私たちはかなり窮地に立たされていた"}, {"type": "subtitle", "time": 2231.71, "timestamp": "00:37:11", "text": "会話。えっと、私たちは"}, {"type": "subtitle", "time": 2234.47, "timestamp": "00:37:14", "text": "緊迫した会話。チャットを読ませてください。"}, {"type": "subtitle", "time": 2238.63, "timestamp": "00:37:18", "text": "それから私は、えーっと、才能があるって感じになった"}, {"type": "subtitle", "time": 2242.069, "timestamp": "00:37:22", "text": "私の禅と私のための購読"}, {"type": "subtitle", "time": 2245.03, "timestamp": "00:37:25", "text": "気が散ってしまった。ああ、それは３人の才能ある"}, {"type": "subtitle", "time": 2247.91, "timestamp": "00:37:27", "text": "サブ。本当にありがとうございました。あなた"}, {"type": "subtitle", "time": 2250.27, "timestamp": "00:37:30", "text": "そんなことしなくてもよかったのに、ありがとう。"}, {"type": "subtitle", "time": 2253.67, "timestamp": "00:37:33", "text": "多くの。それは大きな一歩でしたね。"}, {"type": "subtitle", "time": 2255.91, "timestamp": "00:37:35", "text": "人が来るのは自然なことで、"}, {"type": "subtitle", "time": 2257.75, "timestamp": "00:37:37", "text": "相手の神経を逆撫でしてしまった。厳しいとは言いません"}, {"type": "subtitle", "time": 2260.31, "timestamp": "00:37:40", "text": "値上がりはするが、これは総合的なパッケージであることを知っておいてほしい。"}, {"type": "subtitle", "time": 2262.43, "timestamp": "00:37:42", "text": "はい。確かに、確かに、"}, {"type": "subtitle", "time": 2273.89, "timestamp": "00:37:53", "text": "今はわからない"}, {"type": "subtitle", "time": 2276.03, "timestamp": "00:37:56", "text": "[音楽]"}]
[{"type": "subtitle", "time": 2040.789, "timestamp": "00:34:00", "text": "作物を育てる 作物を育てる"}, {"type": "subtitle", "time": 2043.269, "timestamp": "00:34:03", "text": "ええと、料理、製錬、すべてが"}, {"type": "subtitle", "time": 2046.389, "timestamp": "00:34:06", "text": "それと同じように、走ることもできます。"}, {"type": "subtitle", "time": 2048.389, "timestamp": "00:34:08", "text": "だから、長い遠征に出かけることができます"}, {"type": "subtitle", "time": 2050.47, "timestamp": "00:34:10", "text": "家に帰って、自分の仕事が進んでいるのを見よう"}, {"type": "subtitle", "time": 2053.99, "timestamp": "00:34:13", "text": "そんな感じ。つまり生活の質"}, {"type": "subtitle", "time": 2057.909, "timestamp": "00:34:17", "text": "私が追加したモードです。以上です。私は推測する"}, {"type": "subtitle", "time": 2075.109, "timestamp": "00:34:35", "text": "正しい。しかし、炉は作動しなかった。"}, {"type": "subtitle", "time": 2077.14, "timestamp": "00:34:37", "text": "ええ、炉"}, {"type": "subtitle", "time": 2078.51, "timestamp": "00:34:38", "text": "[音楽]"}, {"type": "subtitle", "time": 2080.31, "timestamp": "00:34:40", "text": "リフレッシュした。私たちは何なのか教えていただけますか？"}, {"type": "subtitle", "time": 2082.47, "timestamp": "00:34:42", "text": "話している？ああ、マインクラフト。私は一晩中起きていた"}, {"type": "subtitle", "time": 2085.19, "timestamp": "00:34:45", "text": "昨晩、もう少しやるために"}, {"type": "subtitle", "time": 2088.069, "timestamp": "00:34:48", "text": "新しい"}, {"type": "subtitle", "time": 2092.99, "timestamp": "00:34:52", "text": "ライトSMPP ええと、アスターが私にくれたので"}, {"type": "subtitle", "time": 2096.99, "timestamp": "00:34:56", "text": "サーバ。えっと、そしてこれ"}]
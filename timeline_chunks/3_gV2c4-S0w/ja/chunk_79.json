[{"type": "subtitle", "time": 4740.229, "timestamp": "01:19:00", "text": "1分だけ、追加するだけでいいんです"}, {"type": "subtitle", "time": 4742.63, "timestamp": "01:19:02", "text": "サーバーへ、そしてそのサーバーへ"}, {"type": "subtitle", "time": 4744.91, "timestamp": "01:19:04", "text": "ファイルはすでに"}, {"type": "subtitle", "time": 4747.83, "timestamp": "01:19:07", "text": "ダウンロードしたか何か。だから私はこう思った"}, {"type": "subtitle", "time": 4749.91, "timestamp": "01:19:09", "text": "混乱しています。なぜダウンロードしているのでしょうか。"}, {"type": "subtitle", "time": 4752.79, "timestamp": "01:19:12", "text": "1 つの mod を追加すると、"}, {"type": "subtitle", "time": 4756.229, "timestamp": "01:19:16", "text": "自動モッドパックには、次のような2つのファイルが表示されます。"}, {"type": "subtitle", "time": 4760.31, "timestamp": "01:19:20", "text": "同じモードを追加すると、"}, {"type": "subtitle", "time": 4763.39, "timestamp": "01:19:23", "text": "ホストモードパックのフォルダとして"}, {"type": "subtitle", "time": 4767.669, "timestamp": "01:19:27", "text": "うーん、わからないけど、今は大丈夫だと思う。"}, {"type": "subtitle", "time": 4769.99, "timestamp": "01:19:29", "text": "うん、大丈夫だよ、大したことじゃないよ"}, {"type": "subtitle", "time": 4772.87, "timestamp": "01:19:32", "text": "了解、それは二次的なものに近い"}, {"type": "subtitle", "time": 4777.11, "timestamp": "01:19:37", "text": "改造フォルダが立ち上がった場合に備えてバックアップ"}, {"type": "subtitle", "time": 4780.47, "timestamp": "01:19:40", "text": "うん。だから、大丈夫です。大丈夫です。すべて"}, {"type": "subtitle", "time": 4786.63, "timestamp": "01:19:46", "text": "わかった。あなたが教えてくれたことを試してみます"}, {"type": "subtitle", "time": 4791.35, "timestamp": "01:19:51", "text": "フルスクリーンで再生しないでください。"}]
[{"type": "subtitle", "time": 16565.551, "timestamp": "04:36:05", "text": "くそ、なんて良いんだ"}, {"type": "subtitle", "time": 16576.109, "timestamp": "04:36:16", "text": "ほら、ほら、ほら。"}, {"type": "subtitle", "time": 16578.629, "timestamp": "04:36:18", "text": "どうやって私がコラボレーションするか知っているのか"}, {"type": "subtitle", "time": 16590.629, "timestamp": "04:36:30", "text": "あなたの返信を待っています。あなたに私の"}, {"type": "subtitle", "time": 16596.949, "timestamp": "04:36:36", "text": "持っていた。とにかく私は彼らと遊んでいます"}, {"type": "subtitle", "time": 16601.47, "timestamp": "04:36:41", "text": "ただ配信を見ているだけの時間。"}, {"type": "subtitle", "time": 16606.83, "timestamp": "04:36:46", "text": "なぜ？あ、待って。それは視聴者としての視点です。"}, {"type": "subtitle", "time": 16615.029, "timestamp": "04:36:55", "text": "ストリーム。でもそれは視聴者向けの部分ですね"}]
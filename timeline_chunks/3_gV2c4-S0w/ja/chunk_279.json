[{"type": "subtitle", "time": 16742.99, "timestamp": "04:39:02", "text": "適切で本物のつながり"}, {"type": "subtitle", "time": 16746.99, "timestamp": "04:39:06", "text": "えーと、その他いろいろ。どう思いますか？"}, {"type": "subtitle", "time": 16751.029, "timestamp": "04:39:11", "text": "それ？魅力的な人のように振る舞いましょう"}, {"type": "subtitle", "time": 16754.39, "timestamp": "04:39:14", "text": "コミュニティと実際に"}, {"type": "subtitle", "time": 16755.99, "timestamp": "04:39:15", "text": "彼らの持ち物と交流し、"}, {"type": "subtitle", "time": 16758.869, "timestamp": "04:39:18", "text": "そういうことばかり。"}, {"type": "subtitle", "time": 16762.629, "timestamp": "04:39:22", "text": "ああ、でも待って、ストリーマーは"}, {"type": "subtitle", "time": 16770.39, "timestamp": "04:39:30", "text": "サイズ？ストリーマーはもっと大きい"}, {"type": "subtitle", "time": 16778.91, "timestamp": "04:39:38", "text": "サイズ？"}, {"type": "subtitle", "time": 16783.19, "timestamp": "04:39:43", "text": "H なぜなら私は複数の出現が好きだから"}, {"type": "subtitle", "time": 16784.99, "timestamp": "04:39:44", "text": "ほら、私は"}, {"type": "subtitle", "time": 16789.11, "timestamp": "04:39:49", "text": "人々が人々に"}, {"type": "subtitle", "time": 16792.07, "timestamp": "04:39:52", "text": "ほら、近づきすぎると"}, {"type": "subtitle", "time": 16798.51, "timestamp": "04:39:58", "text": "知ってるけど、私たちは今でも友達だよ。こんにちは。"}]
[{"type": "subtitle", "time": 1320.47, "timestamp": "00:22:00", "text": "ストリーマー？ CCVは何個ですか？ええ、場合によりますね。"}, {"type": "subtitle", "time": 1324.99, "timestamp": "00:22:04", "text": "CCVでも同様に。 CCV濃度電流"}, {"type": "subtitle", "time": 1333.83, "timestamp": "00:22:13", "text": "サイズはどちらが小さいですか？何番ですか"}, {"type": "subtitle", "time": 1336.23, "timestamp": "00:22:16", "text": "より小さいと見なされる？視聴者20人"}, {"type": "subtitle", "time": 1337.909, "timestamp": "00:22:17", "text": "または100人の視聴者は小さい"}, {"type": "subtitle", "time": 1342.47, "timestamp": "00:22:22", "text": "ストリーマー、もしくは100か2か"}, {"type": "subtitle", "time": 1345.83, "timestamp": "00:22:25", "text": "数字は小さい"}, {"type": "subtitle", "time": 1349.75, "timestamp": "00:22:29", "text": "えっと、1桁目は小さい、2桁目は小さい"}, {"type": "subtitle", "time": 1353.789, "timestamp": "00:22:33", "text": "それから、そうですね、1,000、2,000、3,000、10,000"}, {"type": "subtitle", "time": 1357.19, "timestamp": "00:22:37", "text": "ティアレベルのどれくらいが好きではないかについて"}, {"type": "chat", "time": 1360.518, "timestamp": "00:22:40", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "are you showing it?"}, {"type": "subtitle", "time": 1364.909, "timestamp": "00:22:44", "text": "そういうもの"}, {"type": "subtitle", "time": 1367.07, "timestamp": "00:22:47", "text": "うん。"}, {"type": "chat", "time": 1367.667, "timestamp": "00:22:47", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "or just reading it"}, {"type": "subtitle", "time": 1369.59, "timestamp": "00:22:49", "text": "えっと、表示してるんですか？ 1秒。私は"}]
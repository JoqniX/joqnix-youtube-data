[{"type": "subtitle", "time": 11586.55, "timestamp": "03:13:06", "text": "哇。我在地图上标记出来了。什么是"}, {"type": "subtitle", "time": 11589.429, "timestamp": "03:13:09", "text": "这是什么地方？"}, {"type": "subtitle", "time": 11592.349, "timestamp": "03:13:12", "text": "我的天哪。我的天哪。我被两个人围攻了。哦"}, {"type": "subtitle", "time": 11600.309, "timestamp": "03:13:20", "text": "上帝。我在海里。我在水里。"}, {"type": "subtitle", "time": 11603.349, "timestamp": "03:13:23", "text": "我身处虚空。我的天哪。不，我这是在哪儿？"}, {"type": "subtitle", "time": 11605.67, "timestamp": "03:13:25", "text": "我的天啊。"}, {"type": "subtitle", "time": 11607.309, "timestamp": "03:13:27", "text": "好的。"}, {"type": "subtitle", "time": 11613.99, "timestamp": "03:13:33", "text": "没关系。我不知道。"}, {"type": "subtitle", "time": 11617.91, "timestamp": "03:13:37", "text": "我尽量不只是把它说出来。什么？你 你"}, {"type": "subtitle", "time": 11630.71, "timestamp": "03:13:50", "text": "什么？好的。你知道我孩子叫什么吗？"}, {"type": "subtitle", "time": 11635.269, "timestamp": "03:13:55", "text": "bona bona baur bona?我不知道什么"}, {"type": "subtitle", "time": 11637.79, "timestamp": "03:13:57", "text": "这是什么？"}]
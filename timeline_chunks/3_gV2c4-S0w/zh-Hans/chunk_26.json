[{"type": "subtitle", "time": 1560.149, "timestamp": "00:26:00", "text": "对小型创作者持批评态度"}, {"type": "subtitle", "time": 1564.83, "timestamp": "00:26:04", "text": "比引导和向他们展示更重要"}, {"type": "subtitle", "time": 1567.909, "timestamp": "00:26:07", "text": "出于好心，只是把他们带走等等。"}, {"type": "subtitle", "time": 1570.549, "timestamp": "00:26:10", "text": "一切。我的意思是，是的，确实有。"}, {"type": "subtitle", "time": 1572.39, "timestamp": "00:26:12", "text": "有些人想这么做"}, {"type": "subtitle", "time": 1574.87, "timestamp": "00:26:14", "text": "因为有时候就像你知道的那样"}, {"type": "subtitle", "time": 1580.39, "timestamp": "00:26:20", "text": "你必须扮演……呃，扮演坏人。"}, {"type": "subtitle", "time": 1583.11, "timestamp": "00:26:23", "text": "为了让他们获得经验，"}, {"type": "subtitle", "time": 1586.149, "timestamp": "00:26:26", "text": "有人会想到这些东西。"}, {"type": "subtitle", "time": 1589.11, "timestamp": "00:26:29", "text": "有时候你需要更成熟等等。"}, {"type": "subtitle", "time": 1591.51, "timestamp": "00:26:31", "text": "所有那些乱七八糟的东西，我都不了解。"}, {"type": "subtitle", "time": 1593.59, "timestamp": "00:26:33", "text": "知道它的具体措辞是什么，比如“不”"}, {"type": "subtitle", "time": 1595.75, "timestamp": "00:26:35", "text": "就像坏事一样，他们真的很好"}, {"type": "subtitle", "time": 1598.63, "timestamp": "00:26:38", "text": "人很好，但他们必须像……"}, {"type": "subtitle", "time": 1602.63, "timestamp": "00:26:42", "text": "就像老师一样，例如……"}, {"type": "subtitle", "time": 1604.74, "timestamp": "00:26:44", "text": "老师是"}, {"type": "subtitle", "time": 1606.029, "timestamp": "00:26:46", "text": "[音乐]"}, {"type": "subtitle", "time": 1608.43, "timestamp": "00:26:48", "text": "不是"}, {"type": "subtitle", "time": 1612.95, "timestamp": "00:26:52", "text": "嗨，欢迎，谢谢你们的两点。"}, {"type": "subtitle", "time": 1615.19, "timestamp": "00:26:55", "text": "感谢订阅者，谢谢，谢谢，谢谢"}, {"type": "subtitle", "time": 1617.149, "timestamp": "00:26:57", "text": "你会欣赏"}, {"type": "subtitle", "time": 1619.39, "timestamp": "00:26:59", "text": "谢谢你"}]
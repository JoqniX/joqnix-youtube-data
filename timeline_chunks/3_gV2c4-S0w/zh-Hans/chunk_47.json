[{"type": "subtitle", "time": 2822.55, "timestamp": "00:47:02", "text": "说到更多人，你肯定想不到。"}, {"type": "subtitle", "time": 2825.589, "timestamp": "00:47:05", "text": "如果你有更多人可以帮忙，请联系我。"}, {"type": "subtitle", "time": 2827.67, "timestamp": "00:47:07", "text": "如果你觉得没问题，那就没问题，但如果像……"}, {"type": "subtitle", "time": 2829.51, "timestamp": "00:47:09", "text": "小组协作，而你是唯一一个"}, {"type": "subtitle", "time": 2831.55, "timestamp": "00:47:11", "text": "谁才是真正的"}, {"type": "subtitle", "time": 2834.71, "timestamp": "00:47:14", "text": "自愿参与并确保每个人都参与"}, {"type": "subtitle", "time": 2837.349, "timestamp": "00:47:17", "text": "同一页，一切都一样"}, {"type": "subtitle", "time": 2839.589, "timestamp": "00:47:19", "text": "给予更多自由之类的，是的。"}, {"type": "subtitle", "time": 2842.95, "timestamp": "00:47:22", "text": "很难拒绝，我看到了合作合作"}, {"type": "subtitle", "time": 2845.829, "timestamp": "00:47:25", "text": "我参与过的合作项目包括……"}, {"type": "subtitle", "time": 2848.47, "timestamp": "00:47:28", "text": "很多西方合作，比如伊恩"}, {"type": "subtitle", "time": 2852.79, "timestamp": "00:47:32", "text": "以前的合作之类的活动"}, {"type": "subtitle", "time": 2855.75, "timestamp": "00:47:35", "text": "它完全是撕碎的，笔直地撕碎，就像这样"}, {"type": "subtitle", "time": 2859.109, "timestamp": "00:47:39", "text": "像合作者这样的直男艺术家"}, {"type": "subtitle", "time": 2861.67, "timestamp": "00:47:41", "text": "主动出击，比如“是的，就是这样”。"}, {"type": "subtitle", "time": 2864.069, "timestamp": "00:47:44", "text": "我们接下来要做什么，大家都要参与。"}, {"type": "subtitle", "time": 2867.19, "timestamp": "00:47:47", "text": "我们肯定准时，15分钟后请加入。"}, {"type": "subtitle", "time": 2872.15, "timestamp": "00:47:52", "text": "提前去参加风险投资会议，呃，在我们之前"}, {"type": "subtitle", "time": 2875.109, "timestamp": "00:47:55", "text": "开始直播吧，我们该怎么开始？"}, {"type": "subtitle", "time": 2876.87, "timestamp": "00:47:56", "text": "形式是什么？我们该怎么做？"}]
[{"type": "subtitle", "time": 6841.75, "timestamp": "01:54:01", "text": "但我放弃了那个计划，因为首先"}, {"type": "subtitle", "time": 6843.83, "timestamp": "01:54:03", "text": "免费服务器占用空间并不大。"}, {"type": "subtitle", "time": 6846.31, "timestamp": "01:54:06", "text": "加载完成后，我不得不购买一台服务器。"}, {"type": "subtitle", "time": 6848.87, "timestamp": "01:54:08", "text": "第二竞争对手也刚刚提出了这一点。"}, {"type": "subtitle", "time": 6850.47, "timestamp": "01:54:10", "text": "所以感觉就像我在做……"}, {"type": "subtitle", "time": 6852.669, "timestamp": "01:54:12", "text": "竞争对手模仿"}, {"type": "subtitle", "time": 6854.79, "timestamp": "01:54:14", "text": "我的世界。所以我就想，你知道吗？"}, {"type": "subtitle", "time": 6856.87, "timestamp": "01:54:16", "text": "我想买一台服务器，如果我"}, {"type": "subtitle", "time": 6858.629, "timestamp": "01:54:18", "text": "实际上需要投资购买服务器"}, {"type": "subtitle", "time": 6861.43, "timestamp": "01:54:21", "text": "在《我的世界》里，我为什么不把它建得很大呢？"}, {"type": "subtitle", "time": 6867.03, "timestamp": "01:54:27", "text": "创造者。这就是我最初开始做这件事的方式。"}, {"type": "subtitle", "time": 6868.95, "timestamp": "01:54:28", "text": "室内分娩及室内分娩计划"}, {"type": "subtitle", "time": 6871.149, "timestamp": "01:54:31", "text": "应该是"}, {"type": "subtitle", "time": 6874.39, "timestamp": "01:54:34", "text": "正在发生。但最初它是一个"}, {"type": "subtitle", "time": 6880.709, "timestamp": "01:54:40", "text": "社区活动演变为符文诞生。"}]
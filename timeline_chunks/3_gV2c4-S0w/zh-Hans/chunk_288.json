[{"type": "subtitle", "time": 17281.35, "timestamp": "04:48:01", "text": "不同的事情。他们必须考虑一下。"}, {"type": "subtitle", "time": 17283.83, "timestamp": "04:48:03", "text": "但再说一遍，它不一定是……"}, {"type": "subtitle", "time": 17290.07, "timestamp": "04:48:10", "text": "他们必须在直播的地方进行合作。不。"}, {"type": "subtitle", "time": 17293.27, "timestamp": "04:48:13", "text": "或者类似"}, {"type": "subtitle", "time": 17296.27, "timestamp": "04:48:16", "text": "呃，某种程度上来说，对我来说"}, {"type": "subtitle", "time": 17300.07, "timestamp": "04:48:20", "text": "他们认为，既然我需要"}, {"type": "subtitle", "time": 17303.19, "timestamp": "04:48:23", "text": "那2000美元的事，我为什么要做？"}, {"type": "subtitle", "time": 17306.23, "timestamp": "04:48:26", "text": "乔森的事情他们不知道公众"}, {"type": "subtitle", "time": 17308.948, "timestamp": "04:48:28", "text": "不太了解观看的新观众。"}, {"type": "subtitle", "time": 17310.788, "timestamp": "04:48:30", "text": "对我来说，这将是他们第一次"}, {"type": "subtitle", "time": 17315.19, "timestamp": "04:48:35", "text": "他们感到困惑，于是试图刨根问底，并思考。"}, {"type": "subtitle", "time": 17316.91, "timestamp": "04:48:36", "text": "并假设"}, {"type": "subtitle", "time": 17320.788, "timestamp": "04:48:40", "text": "然后，我喜欢什么？"}, {"type": "subtitle", "time": 17323.47, "timestamp": "04:48:43", "text": "比如你说话像头野猪"}, {"type": "subtitle", "time": 17326.868, "timestamp": "04:48:46", "text": "那样的话，人们就不会看你了等等等等。"}, {"type": "subtitle", "time": 17329.628, "timestamp": "04:48:49", "text": "你为什么要说这样的话"}, {"type": "subtitle", "time": 17332.47, "timestamp": "04:48:52", "text": "而且你甚至都不看我的节目。"}, {"type": "subtitle", "time": 17335.19, "timestamp": "04:48:55", "text": "缺乏相关知识或背景信息"}, {"type": "subtitle", "time": 17337.83, "timestamp": "04:48:57", "text": "现在有很多背景信息，所以我所做的就是……"}]
[{"type": "subtitle", "time": 19683.19, "timestamp": "05:28:03", "text": "是的，你当时荒废了学业。"}, {"type": "subtitle", "time": 19684.868, "timestamp": "05:28:04", "text": "你把自己留给了自己"}, {"type": "subtitle", "time": 19686.47, "timestamp": "05:28:06", "text": "设备，你也明白其中的努力"}, {"type": "subtitle", "time": 19690.39, "timestamp": "05:28:10", "text": "读者。所以，当你真的这么做的时候，就走吧"}, {"type": "subtitle", "time": 19691.948, "timestamp": "05:28:11", "text": "返回并回顾你的"}, {"type": "subtitle", "time": 19695.83, "timestamp": "05:28:15", "text": "面试，你知道如果是"}, {"type": "subtitle", "time": 19698.548, "timestamp": "05:28:18", "text": "如果你真的是日本人，你就不会有"}, {"type": "subtitle", "time": 19701.51, "timestamp": "05:28:21", "text": "能够与他们进行对话"}, {"type": "subtitle", "time": 19703.47, "timestamp": "05:28:23", "text": "更别提得到"}, {"type": "subtitle", "time": 19704.67, "timestamp": "05:28:24", "text": "公认。"}, {"type": "subtitle", "time": 19707.708, "timestamp": "05:28:27", "text": "[音乐]"}, {"type": "subtitle", "time": 19717.43, "timestamp": "05:28:37", "text": "老兄，我的意思是，我很幸运。"}, {"type": "subtitle", "time": 19720.03, "timestamp": "05:28:40", "text": "这就像一场非"}, {"type": "subtitle", "time": 19723.03, "timestamp": "05:28:43", "text": "非日语母语面试官"}, {"type": "subtitle", "time": 19724.35, "timestamp": "05:28:44", "text": "学校"}, {"type": "subtitle", "time": 19726.47, "timestamp": "05:28:46", "text": "面试。但是，是的，你是你"}, {"type": "subtitle", "time": 19727.628, "timestamp": "05:28:47", "text": "实际上"}]
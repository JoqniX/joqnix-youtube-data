[{"type": "subtitle", "time": 11460.23, "timestamp": "03:11:00", "text": "啊，你为什么想要它？不"}, {"type": "subtitle", "time": 11462.429, "timestamp": "03:11:02", "text": "想。"}, {"type": "subtitle", "time": 11464.79, "timestamp": "03:11:04", "text": "哇。我只是在开玩笑。你们是"}, {"type": "subtitle", "time": 11467.11, "timestamp": "03:11:07", "text": "非常"}, {"type": "subtitle", "time": 11470.15, "timestamp": "03:11:10", "text": "我的天，我们传送过来吧。我需要"}, {"type": "subtitle", "time": 11480.59, "timestamp": "03:11:20", "text": "我的天啊。楼主"}, {"type": "subtitle", "time": 11482.59, "timestamp": "03:11:22", "text": "蜘蛛侠"}, {"type": "subtitle", "time": 11495.71, "timestamp": "03:11:35", "text": "它没有"}, {"type": "subtitle", "time": 11498.87, "timestamp": "03:11:38", "text": "任何事物。我不"}, {"type": "subtitle", "time": 11503.87, "timestamp": "03:11:43", "text": "神社。什么？"}, {"type": "subtitle", "time": 11506.79, "timestamp": "03:11:46", "text": "是的，我想你们到时候就会看到了。"}, {"type": "subtitle", "time": 11507.79, "timestamp": "03:11:47", "text": "她已经"}, {"type": "subtitle", "time": 11510.87, "timestamp": "03:11:50", "text": "流。戏弄它可不好。"}, {"type": "subtitle", "time": 11513.11, "timestamp": "03:11:53", "text": "现在。"}, {"type": "subtitle", "time": 11515.309, "timestamp": "03:11:55", "text": "这是一个"}]
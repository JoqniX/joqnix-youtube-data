[{"type": "subtitle", "time": 10440.389, "timestamp": "02:54:00", "text": "醒着。你看到了，那真是太棒了。"}, {"type": "subtitle", "time": 10443.71, "timestamp": "02:54:03", "text": "开玩笑地加了一个太阳能"}, {"type": "subtitle", "time": 10448.23, "timestamp": "02:54:08", "text": "那是个炊具，而且也是个骗局。没有"}, {"type": "subtitle", "time": 10452.07, "timestamp": "02:54:12", "text": "嗯，它会按照我预想的那样运行。"}, {"type": "subtitle", "time": 10455.67, "timestamp": "02:54:15", "text": "你知道吗，它看起来真漂亮"}, {"type": "subtitle", "time": 10458.469, "timestamp": "02:54:18", "text": "夜晚。看看这景色。我的天啊。"}, {"type": "subtitle", "time": 10460.91, "timestamp": "02:54:20", "text": "它简直就像个仙女。"}, {"type": "subtitle", "time": 10464.469, "timestamp": "02:54:24", "text": "土地。哇。看那棵树。真是太"}, {"type": "chat", "time": 10465.509, "timestamp": "02:54:25", "author": "@tengenUzui_flashy1", "avatar": "https://yt4.ggpht.com/U4bubkmDa5_iTX7UhU8yE4NYF3WqbD1yjlX5vpRZK99vtN8boUL9ZV-pbM8qJhCV69RI6ILr=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/JAJ1XpGpJYnW8wTupZu4Cw"}, {"type": "subtitle", "time": 10466.79, "timestamp": "02:54:26", "text": "漂亮的。"}, {"type": "subtitle", "time": 10469.83, "timestamp": "02:54:29", "text": "[音乐]"}, {"type": "subtitle", "time": 10472.55, "timestamp": "02:54:32", "text": "还有我的着色器。看起来绝对"}, {"type": "subtitle", "time": 10474.389, "timestamp": "02:54:34", "text": "漂亮的。"}, {"type": "subtitle", "time": 10476.309, "timestamp": "02:54:36", "text": "是的。你知道吗？我觉得我应该"}, {"type": "subtitle", "time": 10479.11, "timestamp": "02:54:39", "text": "我应该把这座城堡建成"}, {"type": "subtitle", "time": 10481.75, "timestamp": "02:54:41", "text": "万代。是的。"}, {"type": "subtitle", "time": 10492.11, "timestamp": "02:54:52", "text": "那是"}, {"type": "subtitle", "time": 10496.389, "timestamp": "02:54:56", "text": "墙。嗯嗯"}]
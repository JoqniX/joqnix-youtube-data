[{"type": "subtitle", "time": 13502.389, "timestamp": "03:45:02", "text": "那些真正来过的人"}, {"type": "subtitle", "time": 13505.269, "timestamp": "03:45:05", "text": "直播间里有人跟我聊天什么的。"}, {"type": "subtitle", "time": 13508.07, "timestamp": "03:45:08", "text": "是的。然后我们需要一个“我想我可能会”"}, {"type": "subtitle", "time": 13511.55, "timestamp": "03:45:11", "text": "需要把踢人聊天记录之类的东西做成"}, {"type": "subtitle", "time": 13515.349, "timestamp": "03:45:15", "text": "既然我们现在有了 Twitch 和 YouTube"}, {"type": "subtitle", "time": 13518.79, "timestamp": "03:45:18", "text": "以及比利的聊天记录和事件，这些是"}, {"type": "subtitle", "time": 13520.75, "timestamp": "03:45:20", "text": "登录我们的 Discord"}, {"type": "subtitle", "time": 13523.51, "timestamp": "03:45:23", "text": "服务器。所以版主也可以是"}, {"type": "subtitle", "time": 13525.59, "timestamp": "03:45:25", "text": "即使是他们，也会及时更新所有信息"}, {"type": "subtitle", "time": 13526.83, "timestamp": "03:45:26", "text": "不是"}, {"type": "subtitle", "time": 13530.189, "timestamp": "03:45:30", "text": "这里。所以他们可以做他们的"}, {"type": "subtitle", "time": 13532.79, "timestamp": "03:45:32", "text": "一切都公务化。"}, {"type": "subtitle", "time": 13540.309, "timestamp": "03:45:40", "text": "我开始觉得困了。我是"}, {"type": "subtitle", "time": 13543.429, "timestamp": "03:45:43", "text": "控制不住地打哈欠。哇。"}, {"type": "subtitle", "time": 13552.95, "timestamp": "03:45:52", "text": "63. 你知道最搞笑的是什么吗？今天是"}, {"type": "subtitle", "time": 13555.269, "timestamp": "03:45:55", "text": "应该是星期一。今天就是那一天"}, {"type": "subtitle", "time": 13557.91, "timestamp": "03:45:57", "text": "我原本应该上音乐课的。"}]
[{"type": "subtitle", "time": 19862.868, "timestamp": "05:31:02", "text": "是日式咖啡馆那家吗？卵石"}, {"type": "subtitle", "time": 19866.628, "timestamp": "05:31:06", "text": "呃，那家面馆叫面条店。是的。"}, {"type": "subtitle", "time": 19873.59, "timestamp": "05:31:13", "text": "嗯，他们过来后，我就走过去和他们打招呼。"}, {"type": "subtitle", "time": 19875.59, "timestamp": "05:31:15", "text": "我跟人聊了聊，甚至还跟人讲了讲。"}, {"type": "subtitle", "time": 19879.27, "timestamp": "05:31:19", "text": "我喜欢 YouTube 和 YouTube 之类的东西。"}, {"type": "subtitle", "time": 19883.15, "timestamp": "05:31:23", "text": "为什么不选择Twitch？你好，天空。呃，"}, {"type": "subtitle", "time": 19886.99, "timestamp": "05:31:26", "text": "你好。为什么不选择Twitch？我正在直播"}, {"type": "subtitle", "time": 19890.31, "timestamp": "05:31:30", "text": "抽搐。我正在Twitch上直播。我们正在直播"}, {"type": "subtitle", "time": 19898.51, "timestamp": "05:31:38", "text": "送货。是的，依靠"}, {"type": "subtitle", "time": 19901.23, "timestamp": "05:31:41", "text": "抽搐。这就是我为什么会看 Twitch 的原因。"}, {"type": "subtitle", "time": 19905.548, "timestamp": "05:31:45", "text": "评论。我对此不抱任何希望"}, {"type": "subtitle", "time": 19908.35, "timestamp": "05:31:48", "text": "他们。哦"}, {"type": "subtitle", "time": 19917.11, "timestamp": "05:31:57", "text": "存活。因为他们比"}]
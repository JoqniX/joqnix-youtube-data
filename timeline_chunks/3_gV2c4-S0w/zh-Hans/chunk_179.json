[{"type": "subtitle", "time": 10741.91, "timestamp": "02:59:01", "text": "你们都干了些什么？没有什么。"}, {"type": "subtitle", "time": 10746.55, "timestamp": "02:59:06", "text": "我看到你们绑架了村民。"}, {"type": "subtitle", "time": 10748.15, "timestamp": "02:59:08", "text": "不，"}, {"type": "subtitle", "time": 10750.23, "timestamp": "02:59:10", "text": "你做到了。"}, {"type": "subtitle", "time": 10755.59, "timestamp": "02:59:15", "text": "真的吗？什么？不。我的意思是，呃，你知道，"}, {"type": "subtitle", "time": 10758.79, "timestamp": "02:59:18", "text": "有一种方法可以，嗯，就像"}, {"type": "subtitle", "time": 10760.03, "timestamp": "02:59:20", "text": "村民们"}, {"type": "subtitle", "time": 10763.51, "timestamp": "02:59:23", "text": "迁徙到这个地方是因为这个，呃，"}, {"type": "subtitle", "time": 10766.15, "timestamp": "02:59:26", "text": "请注意，我给他们提供了一栋新房子。什么"}, {"type": "subtitle", "time": 10772.87, "timestamp": "02:59:32", "text": "就像阿斯特拉变成了房地产公司"}, {"type": "subtitle", "time": 10775.429, "timestamp": "02:59:35", "text": "经纪人，就像是，是的，我"}, {"type": "subtitle", "time": 10777.51, "timestamp": "02:59:37", "text": "与其提出新的报价，不如……"}, {"type": "subtitle", "time": 10779.429, "timestamp": "02:59:39", "text": "住在破旧的地方，来我家吧"}, {"type": "subtitle", "time": 10783.349, "timestamp": "02:59:43", "text": "豪华场所。哇，那他们就会"}, {"type": "subtitle", "time": 10793.19, "timestamp": "02:59:53", "text": "女王。我的天哪，我是女王！"}]
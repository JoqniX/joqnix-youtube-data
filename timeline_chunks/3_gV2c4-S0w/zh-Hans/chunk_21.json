[{"type": "subtitle", "time": 1262.149, "timestamp": "00:21:02", "text": "我猜，流媒体内容是由鱼创造的。"}, {"type": "subtitle", "time": 1264.669, "timestamp": "00:21:04", "text": "如果你有更多"}, {"type": "subtitle", "time": 1268.149, "timestamp": "00:21:08", "text": "数字，比“是”更多的数字。"}, {"type": "subtitle", "time": 1270.11, "timestamp": "00:21:10", "text": "大。如果你是"}, {"type": "subtitle", "time": 1273.99, "timestamp": "00:21:13", "text": "中等，等等，我觉得如果我在"}, {"type": "subtitle", "time": 1276.95, "timestamp": "00:21:16", "text": "这个话题，我觉得我好像已经收藏了。"}, {"type": "subtitle", "time": 1279.43, "timestamp": "00:21:19", "text": "最近我在推特上看到一些东西"}, {"type": "subtitle", "time": 1283.39, "timestamp": "00:21:23", "text": "展示。让我去拿一下"}, {"type": "subtitle", "time": 1284.51, "timestamp": "00:21:24", "text": "你。"}, {"type": "subtitle", "time": 1286.19, "timestamp": "00:21:26", "text": "[音乐]"}, {"type": "subtitle", "time": 1295.27, "timestamp": "00:21:35", "text": "是的，我收藏了一些东西，它给了"}, {"type": "subtitle", "time": 1298.83, "timestamp": "00:21:38", "text": "完整的基础图"}, {"type": "subtitle", "time": 1301.39, "timestamp": "00:21:41", "text": "就像完全完全"}, {"type": "subtitle", "time": 1305.59, "timestamp": "00:21:45", "text": "图形。谁是小个子？谁是大人物"}, {"type": "subtitle", "time": 1307.549, "timestamp": "00:21:47", "text": "喜欢"}, {"type": "subtitle", "time": 1312.149, "timestamp": "00:21:52", "text": "那？一张完整的图表。一张合适的图表。"}, {"type": "subtitle", "time": 1314.75, "timestamp": "00:21:54", "text": "我正在找呢，伙计。全部"}, {"type": "chat", "time": 1315.684, "timestamp": "00:21:55", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "HUH"}, {"type": "subtitle", "time": 1317.59, "timestamp": "00:21:57", "text": "正确的。就像那个小矮人一样"}]
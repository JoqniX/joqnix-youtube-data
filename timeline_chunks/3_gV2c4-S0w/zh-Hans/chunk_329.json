[{"type": "subtitle", "time": 19758.35, "timestamp": "05:29:18", "text": "他们。我真的必须这样做吗？"}, {"type": "subtitle", "time": 19761.548, "timestamp": "05:29:21", "text": "学习？我不想"}, {"type": "subtitle", "time": 19764.708, "timestamp": "05:29:24", "text": "学习。我讨厌学习。"}, {"type": "subtitle", "time": 19766.788, "timestamp": "05:29:26", "text": "即使上了日语课，我仍然……"}, {"type": "subtitle", "time": 19775.35, "timestamp": "05:29:35", "text": "不，他们不会像这样砍你。"}, {"type": "subtitle", "time": 19777.23, "timestamp": "05:29:37", "text": "这"}, {"type": "subtitle", "time": 19779.66, "timestamp": "05:29:39", "text": "面试官。抓住"}, {"type": "subtitle", "time": 19783.948, "timestamp": "05:29:43", "text": "[音乐]"}, {"type": "subtitle", "time": 19787.43, "timestamp": "05:29:47", "text": "在。世界为何如此高大？外面的世界"}, {"type": "subtitle", "time": 19794.31, "timestamp": "05:29:54", "text": "等等，你跟那些人谈过吗？"}, {"type": "subtitle", "time": 19797.67, "timestamp": "05:29:57", "text": "那些参加四月份入职培训的人就像……"}, {"type": "subtitle", "time": 19799.868, "timestamp": "05:29:59", "text": "你和巴达桑交谈，"}]
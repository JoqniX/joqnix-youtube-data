[{"type": "subtitle", "time": 900.23, "timestamp": "00:15:00", "text": "分享了我对此的看法"}, {"type": "subtitle", "time": 903.949, "timestamp": "00:15:03", "text": "呃，而且在"}, {"type": "subtitle", "time": 907.99, "timestamp": "00:15:07", "text": "方式，我很庆幸我深入地谈论了这一点。"}, {"type": "subtitle", "time": 910.389, "timestamp": "00:15:10", "text": "它和我，那件让我反感的事"}, {"type": "subtitle", "time": 911.71, "timestamp": "00:15:11", "text": "警卫"}, {"type": "subtitle", "time": 915.59, "timestamp": "00:15:15", "text": "那天究竟发生了什么深思熟虑的事？"}, {"type": "subtitle", "time": 916.829, "timestamp": "00:15:16", "text": "那"}, {"type": "subtitle", "time": 929.23, "timestamp": "00:15:29", "text": "尽管。就像我早就知道还有这一面一样"}, {"type": "subtitle", "time": 932.949, "timestamp": "00:15:32", "text": "确实如此，但我没想到我真的会这么做。"}, {"type": "subtitle", "time": 935.75, "timestamp": "00:15:35", "text": "获得那种经验或者喜欢"}, {"type": "subtitle", "time": 938.269, "timestamp": "00:15:38", "text": "治疗"}, {"type": "subtitle", "time": 943.55, "timestamp": "00:15:43", "text": "像个标签一样扣在我的头上"}, {"type": "chat", "time": 945.461, "timestamp": "00:15:45", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "unless one thing is resolved the same thing will keep happening over and over again"}, {"type": "subtitle", "time": 946.269, "timestamp": "00:15:46", "text": "你为什么要靠近我？"}, {"type": "subtitle", "time": 949.99, "timestamp": "00:15:49", "text": "我？你拥有什么价值？即使我们"}, {"type": "subtitle", "time": 953.11, "timestamp": "00:15:53", "text": "合作方面，你能带来什么价值？什么"}, {"type": "chat", "time": 953.914, "timestamp": "00:15:53", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "in your head*"}, {"type": "subtitle", "time": 955.829, "timestamp": "00:15:55", "text": "你有什么想法可以分享？为什么是"}, {"type": "subtitle", "time": 959.269, "timestamp": "00:15:59", "text": "你做的那些事，呃，就像评论家们说的那样"}]
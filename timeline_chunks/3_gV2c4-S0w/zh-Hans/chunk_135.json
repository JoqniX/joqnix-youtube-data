[{"type": "subtitle", "time": 8100.51, "timestamp": "02:15:00", "text": "落后？我究竟在烦恼什么？"}, {"type": "subtitle", "time": 8104.35, "timestamp": "02:15:04", "text": "个人电脑？这个人。我们结束吧"}, {"type": "subtitle", "time": 8107.27, "timestamp": "02:15:07", "text": "现在就是这样。好了。那里有"}, {"type": "subtitle", "time": 8143.669, "timestamp": "02:15:43", "text": "呃，派个朋友过来吧。和这里的名字一样。"}, {"type": "subtitle", "time": 8144.669, "timestamp": "02:15:44", "text": "冈。"}, {"type": "subtitle", "time": 8147.75, "timestamp": "02:15:47", "text": "明白了。我一定会派朋友去。"}]
[{"type": "subtitle", "time": 17940.31, "timestamp": "04:59:00", "text": "浏览量上升了吗？有多少人"}, {"type": "subtitle", "time": 17943.03, "timestamp": "04:59:03", "text": "喜欢和他们在一起吗？有人离开了吗？"}, {"type": "subtitle", "time": 17944.788, "timestamp": "04:59:04", "text": "等等，等等。不。"}, {"type": "subtitle", "time": 17946.948, "timestamp": "04:59:06", "text": "如果他们有的话，如果我有的话，情况也一样。"}, {"type": "subtitle", "time": 17949.67, "timestamp": "04:59:09", "text": "把它们放在我的频道上，它们看起来会很棒。"}, {"type": "subtitle", "time": 17953.51, "timestamp": "04:59:13", "text": "我的分析工作也是如此。不是这样"}, {"type": "subtitle", "time": 17956.19, "timestamp": "04:59:16", "text": "有多少人会看"}, {"type": "subtitle", "time": 17961.708, "timestamp": "04:59:21", "text": "有多少人观看了他们"}, {"type": "subtitle", "time": 17964.788, "timestamp": "04:59:24", "text": "因为他们当时和我一起直播等等。"}, {"type": "subtitle", "time": 17968.788, "timestamp": "04:59:28", "text": "就是这样。我当时就想，“是啊，"}, {"type": "subtitle", "time": 17971.99, "timestamp": "04:59:31", "text": "或许现在不是我该……的时候"}, {"type": "subtitle", "time": 17975.91, "timestamp": "04:59:35", "text": "接受交易型合作，因为"}, {"type": "subtitle", "time": 17977.628, "timestamp": "04:59:37", "text": "我仍然是"}, {"type": "subtitle", "time": 17981.51, "timestamp": "04:59:41", "text": "我是新手，而且现在还不太懂。"}, {"type": "subtitle", "time": 17983.43, "timestamp": "04:59:43", "text": "既专业又专业。东西太多了。"}, {"type": "subtitle", "time": 17984.75, "timestamp": "04:59:44", "text": "我可以"}, {"type": "subtitle", "time": 17996.948, "timestamp": "04:59:56", "text": "是的，这是命中注定的。是的。"}]
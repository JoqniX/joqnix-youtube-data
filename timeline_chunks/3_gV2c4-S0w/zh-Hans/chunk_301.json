[{"type": "subtitle", "time": 18061.55, "timestamp": "05:01:01", "text": "我想我当时是因为这件事感到难过。"}, {"type": "subtitle", "time": 18064.47, "timestamp": "05:01:04", "text": "很多人在聊天中说喜欢这个直播"}, {"type": "subtitle", "time": 18067.43, "timestamp": "05:01:07", "text": "别担心，会有的。"}, {"type": "subtitle", "time": 18068.868, "timestamp": "05:01:08", "text": "当然会有人"}, {"type": "subtitle", "time": 18069.948, "timestamp": "05:01:09", "text": "想要"}, {"type": "subtitle", "time": 18074.19, "timestamp": "05:01:14", "text": "与您联系和合作"}, {"type": "subtitle", "time": 18077.07, "timestamp": "05:01:17", "text": "东西，但是"}, {"type": "subtitle", "time": 18080.03, "timestamp": "05:01:20", "text": "是的"}, {"type": "subtitle", "time": 18082.788, "timestamp": "05:01:22", "text": "所以，今天我弄到了两个。"}, {"type": "subtitle", "time": 18086.91, "timestamp": "05:01:26", "text": "合作"}, {"type": "subtitle", "time": 18091.31, "timestamp": "05:01:31", "text": "嗯，其中一个是和Yeah一起的。不，三"}, {"type": "subtitle", "time": 18095.51, "timestamp": "05:01:35", "text": "实际上。嗯，其中两个就像是第一个。"}, {"type": "subtitle", "time": 18097.59, "timestamp": "05:01:37", "text": "互动，但我们有过互动"}, {"type": "subtitle", "time": 18100.19, "timestamp": "05:01:40", "text": "在文本之前"}, {"type": "subtitle", "time": 18107.628, "timestamp": "05:01:47", "text": "[音乐]"}, {"type": "subtitle", "time": 18112.43, "timestamp": "05:01:52", "text": "呃，狗，你这个笨蛋。嗯？什么"}, {"type": "subtitle", "time": 18116.788, "timestamp": "05:01:56", "text": "发生了吗？睡觉。我的天哪，你害怕了"}, {"type": "subtitle", "time": 18119.99, "timestamp": "05:01:59", "text": "我，布拉。我当时就想，兄弟，我到底做了什么？"}]
[{"type": "subtitle", "time": 13440.229, "timestamp": "03:44:00", "text": "今天我们遇到了几起事故。喜欢"}, {"type": "subtitle", "time": 13444.15, "timestamp": "03:44:04", "text": "今天直播断流了，对吧？是的。"}, {"type": "subtitle", "time": 13447.11, "timestamp": "03:44:07", "text": "显然崩溃了。唉，今天就是那一天。"}, {"type": "subtitle", "time": 13449.429, "timestamp": "03:44:09", "text": "我不得不重新制作 Twitch 直播"}, {"type": "subtitle", "time": 13451.91, "timestamp": "03:44:11", "text": "因为 Twitch 只允许最多 48 个视频"}, {"type": "subtitle", "time": 13455.51, "timestamp": "03:44:15", "text": "直播数小时。所以每隔48小时你"}, {"type": "subtitle", "time": 13456.83, "timestamp": "03:44:16", "text": "必须创建一个新的"}, {"type": "subtitle", "time": 13460.03, "timestamp": "03:44:20", "text": "否则直播就会结束"}, {"type": "subtitle", "time": 13463.75, "timestamp": "03:44:23", "text": "溪流。哦，是的，但是因为我正在使用"}, {"type": "subtitle", "time": 13466.389, "timestamp": "03:44:26", "text": "通过这个应用程序，我可以知道如果"}, {"type": "subtitle", "time": 13469.75, "timestamp": "03:44:29", "text": "如果我的任何平台是"}, {"type": "subtitle", "time": 13472.91, "timestamp": "03:44:32", "text": "李是否在直播以及直播时长如何"}, {"type": "subtitle", "time": 13476.55, "timestamp": "03:44:36", "text": "出色地。这样多少有点帮助。一个来了"}, {"type": "subtitle", "time": 13484.229, "timestamp": "03:44:44", "text": "我应该……呃，让他们加上"}, {"type": "subtitle", "time": 13487.59, "timestamp": "03:44:47", "text": "我使用 Beam Stream 平台是因为它……"}, {"type": "subtitle", "time": 13490.95, "timestamp": "03:44:50", "text": "多领域，而且它们似乎就像"}, {"type": "subtitle", "time": 13493.429, "timestamp": "03:44:53", "text": "Beam公司一半的人都在那里"}, {"type": "subtitle", "time": 13494.429, "timestamp": "03:44:54", "text": "溪流"}, {"type": "subtitle", "time": 13499.59, "timestamp": "03:44:59", "text": "机器人，但我认为我确实看到了一些。"}]
[{"type": "subtitle", "time": 16860.75, "timestamp": "04:41:00", "text": "我自己也想知道为什么会这样"}, {"type": "subtitle", "time": 16867.75, "timestamp": "04:41:07", "text": "他们跟我们聊起了聚会的事，"}, {"type": "subtitle", "time": 16877.27, "timestamp": "04:41:17", "text": "因为感觉这和……非常相似"}, {"type": "subtitle", "time": 16885.91, "timestamp": "04:41:25", "text": "过去的。让我简单介绍一下。"}, {"type": "subtitle", "time": 16889.03, "timestamp": "04:41:29", "text": "我就不点名了，简单介绍一下。"}, {"type": "subtitle", "time": 16891.83, "timestamp": "04:41:31", "text": "东西。情况是一样的。好的。相似的"}, {"type": "subtitle", "time": 16894.39, "timestamp": "04:41:34", "text": "就像他们那样，你当时在做什么？"}, {"type": "subtitle", "time": 16897.43, "timestamp": "04:41:37", "text": "比如，我们找到了创建者，然后我偶然发现了"}, {"type": "subtitle", "time": 16899.91, "timestamp": "04:41:39", "text": "他们的直播真的很有趣"}, {"type": "subtitle", "time": 16903.59, "timestamp": "04:41:43", "text": "我们以前很喜欢玩 Gamesish。"}, {"type": "subtitle", "time": 16905.708, "timestamp": "04:41:45", "text": "这是我第一次直播"}, {"type": "subtitle", "time": 16909.35, "timestamp": "04:41:49", "text": "就像第一次那样"}, {"type": "subtitle", "time": 16912.31, "timestamp": "04:41:52", "text": "和主播一起玩游戏我太开心了"}, {"type": "subtitle", "time": 16915.99, "timestamp": "04:41:55", "text": "我们玩的是堡垒之夜，我"}, {"type": "subtitle", "time": 16918.19, "timestamp": "04:41:58", "text": "我真的很高兴，我真的很高兴。"}]
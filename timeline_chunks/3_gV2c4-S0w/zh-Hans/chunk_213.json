[{"type": "subtitle", "time": 12781.67, "timestamp": "03:33:01", "text": "来源就像游戏，那是个配音演员，呃，什么？"}, {"type": "subtitle", "time": 12782.91, "timestamp": "03:33:02", "text": "是吗？"}, {"type": "subtitle", "time": 12786.229, "timestamp": "03:33:06", "text": "叫什么？呃，VA代理。这就是我们"}, {"type": "subtitle", "time": 12788.67, "timestamp": "03:33:08", "text": "退伍军人事务部"}, {"type": "subtitle", "time": 12792.99, "timestamp": "03:33:12", "text": "代理人。我们4点开始直播。"}, {"type": "subtitle", "time": 12796.55, "timestamp": "03:33:16", "text": "天。然后我就去吃晚饭了。"}, {"type": "subtitle", "time": 12805.349, "timestamp": "03:33:25", "text": "下午嗯，是的。呃，显然当我"}, {"type": "subtitle", "time": 12809.11, "timestamp": "03:33:29", "text": "把我的视频点播上传到billybilly.com"}, {"type": "subtitle", "time": 12812.389, "timestamp": "03:33:32", "text": "呃，就我现在的直播而言，我确保它们"}, {"type": "subtitle", "time": 12815.83, "timestamp": "03:33:35", "text": "看不到像以前W直播那样的点播内容"}, {"type": "subtitle", "time": 12817.59, "timestamp": "03:33:37", "text": "现在因为所有这些直播都已经开始了。"}, {"type": "subtitle", "time": 12819.83, "timestamp": "03:33:39", "text": "已上传。所有 YouTube 直播流都是"}, {"type": "subtitle", "time": 12821.67, "timestamp": "03:33:41", "text": "已上传。 YouTube、Twitch 上都有上传的视频。"}, {"type": "subtitle", "time": 12825.91, "timestamp": "03:33:45", "text": "致比利。所以来自中国的人也可以"}, {"type": "subtitle", "time": 12829.91, "timestamp": "03:33:49", "text": "如果他们想看的话就看吧。所以他们不这么做"}, {"type": "subtitle", "time": 12832.389, "timestamp": "03:33:52", "text": "需要使用 VPN 才能过来。"}, {"type": "subtitle", "time": 12835.229, "timestamp": "03:33:55", "text": "在 YouTube 或 Twitch 上观看"}, {"type": "subtitle", "time": 12838.55, "timestamp": "03:33:58", "text": "因为对某些人来说，这很难"}]
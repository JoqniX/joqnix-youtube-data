[{"type": "subtitle", "time": 4524.31, "timestamp": "01:15:24", "text": "分钟。为什么无法重新充值？"}, {"type": "subtitle", "time": 4524.97, "timestamp": "01:15:24", "text": "是什么"}, {"type": "subtitle", "time": 4526.27, "timestamp": "01:15:26", "text": "[音乐]"}, {"type": "subtitle", "time": 4529.669, "timestamp": "01:15:29", "text": "这？等等，怎么录制 Minecraft 呢？"}, {"type": "subtitle", "time": 4532.47, "timestamp": "01:15:32", "text": "Astra 通常情况下很明显吗？窗户"}, {"type": "subtitle", "time": 4534.95, "timestamp": "01:15:34", "text": "抓取，对吧？但是，不，游戏捕获"}, {"type": "subtitle", "time": 4536.63, "timestamp": "01:15:36", "text": "透过窗户。捕获特定"}, {"type": "subtitle", "time": 4540.31, "timestamp": "01:15:40", "text": "窗户，对吧？游戏画面捕捉。是的，游戏"}, {"type": "subtitle", "time": 4542.63, "timestamp": "01:15:42", "text": "以捕获模式进行捕获"}, {"type": "subtitle", "time": 4546.63, "timestamp": "01:15:46", "text": "特定窗口，对吧？是的。"}, {"type": "subtitle", "time": 4548.63, "timestamp": "01:15:48", "text": "明白了。所以如果当你们都用 Tab 键时，"}, {"type": "subtitle", "time": 4551.35, "timestamp": "01:15:51", "text": "屏幕会卡住，对吧？"}, {"type": "subtitle", "time": 4553.11, "timestamp": "01:15:53", "text": "不，因为我不玩Minecraft。"}, {"type": "subtitle", "time": 4554.91, "timestamp": "01:15:54", "text": "窗口模式。那是一个"}, {"type": "subtitle", "time": 4557.63, "timestamp": "01:15:57", "text": "不同之处。我在窗口模式下玩Minecraft。"}, {"type": "subtitle", "time": 4559.83, "timestamp": "01:15:59", "text": "模式。不要完整地玩《我的世界》。"}]
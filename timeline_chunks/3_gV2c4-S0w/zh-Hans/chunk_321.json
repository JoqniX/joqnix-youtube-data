[{"type": "subtitle", "time": 19262.948, "timestamp": "05:21:02", "text": "你知道，这件事已经发生了"}, {"type": "subtitle", "time": 19266.31, "timestamp": "05:21:06", "text": "增加量"}, {"type": "subtitle", "time": 19271.19, "timestamp": "05:21:11", "text": "随机从 B 账户加入我的"}, {"type": "subtitle", "time": 19273.51, "timestamp": "05:21:13", "text": "Discord 服务器，而且它们是随机的"}, {"type": "subtitle", "time": 19276.948, "timestamp": "05:21:16", "text": "我给成员列表里的每个人都发了私信，还有我"}, {"type": "subtitle", "time": 19280.15, "timestamp": "05:21:20", "text": "必须暂停它们，但我不会把它们放进购物车。"}, {"type": "subtitle", "time": 19282.83, "timestamp": "05:21:22", "text": "踢他们，我"}, {"type": "subtitle", "time": 19286.39, "timestamp": "05:21:26", "text": "我到底是怎么把“捕捉”这个概念放进去的？"}, {"type": "subtitle", "time": 19289.59, "timestamp": "05:21:29", "text": "东西还好，他们是，他们是，所以"}, {"type": "subtitle", "time": 19292.23, "timestamp": "05:21:32", "text": "聪明到足以躲避抓捕"}, {"type": "subtitle", "time": 19294.628, "timestamp": "05:21:34", "text": "然后去秘密频道获取"}, {"type": "subtitle", "time": 19301.948, "timestamp": "05:21:41", "text": "啊"}, {"type": "subtitle", "time": 19310.55, "timestamp": "05:21:50", "text": "为什么要对所有身份进行核实"}, {"type": "subtitle", "time": 19318.99, "timestamp": "05:21:58", "text": "男生"}]
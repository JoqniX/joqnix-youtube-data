[{"type": "subtitle", "time": 17580.628, "timestamp": "04:53:00", "text": "忙，等等。我不知道，嗯，我很忙。"}, {"type": "subtitle", "time": 17583.27, "timestamp": "04:53:03", "text": "一个月，下个月等等。然后我就会……"}, {"type": "subtitle", "time": 17587.55, "timestamp": "04:53:07", "text": "没问题。正确的。我 我"}, {"type": "subtitle", "time": 17590.868, "timestamp": "04:53:10", "text": "我不知道，伙计。那真是奇怪"}, {"type": "subtitle", "time": 17594.868, "timestamp": "04:53:14", "text": "互动与体验。我没有"}, {"type": "subtitle", "time": 17596.43, "timestamp": "04:53:16", "text": "甚至"}, {"type": "subtitle", "time": 17599.55, "timestamp": "04:53:19", "text": "知道。我甚至不知道那会怎么样。"}, {"type": "subtitle", "time": 17603.19, "timestamp": "04:53:23", "text": "去。即使他们与我合作，我会怎么做？"}, {"type": "subtitle", "time": 17613.75, "timestamp": "04:53:33", "text": "呃，还有一件事，就是我们不说话。"}, {"type": "subtitle", "time": 17615.67, "timestamp": "04:53:35", "text": "对这些人中的任何人来说，除了"}, {"type": "subtitle", "time": 17617.51, "timestamp": "04:53:37", "text": "日本人，他们很喜欢我们是日本人。"}, {"type": "subtitle", "time": 17625.11, "timestamp": "04:53:45", "text": "是的。这个人确实问我，呃……"}, {"type": "subtitle", "time": 17627.67, "timestamp": "04:53:47", "text": "看完我的这段描述后，或者"}, {"type": "subtitle", "time": 17628.75, "timestamp": "04:53:48", "text": "面板或"}, {"type": "subtitle", "time": 17632.39, "timestamp": "04:53:52", "text": "比如搬到日本就意味着"}, {"type": "subtitle", "time": 17634.47, "timestamp": "04:53:54", "text": "移居日本。你了解日本吗？有"}, {"type": "subtitle", "time": 17636.628, "timestamp": "04:53:56", "text": "你之前在日本做过合作吗？"}, {"type": "subtitle", "time": 17639.51, "timestamp": "04:53:59", "text": "我之前是日本人，我解释过"}]
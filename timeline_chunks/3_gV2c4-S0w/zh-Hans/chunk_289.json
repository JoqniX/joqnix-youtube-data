[{"type": "subtitle", "time": 17340.83, "timestamp": "04:49:00", "text": "我一直很有耐心，并解释了"}, {"type": "subtitle", "time": 17342.35, "timestamp": "04:49:02", "text": "他们"}, {"type": "subtitle", "time": 17346.31, "timestamp": "04:49:06", "text": "妥善处理一切，就像制作一样。"}, {"type": "subtitle", "time": 17348.47, "timestamp": "04:49:08", "text": "这样他们就能明白我当时是"}, {"type": "subtitle", "time": 17350.51, "timestamp": "04:49:10", "text": "点赞"}, {"type": "subtitle", "time": 17353.83, "timestamp": "04:49:13", "text": "是的，日本有类似空洞人生的男性"}, {"type": "subtitle", "time": 17355.708, "timestamp": "04:49:15", "text": "男性 YouTuber 就像"}, {"type": "subtitle", "time": 17358.07, "timestamp": "04:49:18", "text": "即使不存在，他们仍然可以尝试。"}, {"type": "subtitle", "time": 17361.55, "timestamp": "04:49:21", "text": "没有运气之类的，我当时是，我当时是"}, {"type": "subtitle", "time": 17366.15, "timestamp": "04:49:26", "text": "就像啊，疼痛，然后我就问了一个"}, {"type": "subtitle", "time": 17368.55, "timestamp": "04:49:28", "text": "合作或像聚会一样互相了解"}, {"type": "subtitle", "time": 17370.03, "timestamp": "04:49:30", "text": "因为这是我们的第一个彼此。"}, {"type": "subtitle", "time": 17372.03, "timestamp": "04:49:32", "text": "连接正常"}, {"type": "subtitle", "time": 17373.868, "timestamp": "04:49:33", "text": "联系"}, {"type": "subtitle", "time": 17377.35, "timestamp": "04:49:37", "text": "我当时就想去那里。"}, {"type": "subtitle", "time": 17380.948, "timestamp": "04:49:40", "text": "嗯，你喜欢真诚、真实的方式吗？"}, {"type": "subtitle", "time": 17383.43, "timestamp": "04:49:43", "text": "放慢速度，不要操之过急。"}, {"type": "subtitle", "time": 17387.43, "timestamp": "04:49:47", "text": "它顺其自然，而不是强迫它。慢慢地，第一次"}, {"type": "subtitle", "time": 17390.788, "timestamp": "04:49:50", "text": "第一次互动视频通话。看看我们"}, {"type": "subtitle", "time": 17393.75, "timestamp": "04:49:53", "text": "彼此能够理解。然后慢慢地"}, {"type": "subtitle", "time": 17396.15, "timestamp": "04:49:56", "text": "慢慢交谈，彼此了解。"}, {"type": "subtitle", "time": 17399.11, "timestamp": "04:49:59", "text": "如果他们觉得没问题，那就跳吧"}]
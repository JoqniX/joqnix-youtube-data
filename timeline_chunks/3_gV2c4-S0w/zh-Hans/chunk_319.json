[{"type": "subtitle", "time": 19142.27, "timestamp": "05:19:02", "text": "死了。太过了"}, {"type": "subtitle", "time": 19147.07, "timestamp": "05:19:07", "text": "很多。对我来说太过分了。我"}, {"type": "subtitle", "time": 19149.708, "timestamp": "05:19:09", "text": "我不能吗？我不能吗？"}, {"type": "subtitle", "time": 19153.31, "timestamp": "05:19:13", "text": "整个大脑都窒息了，我……我"}, {"type": "subtitle", "time": 19157.67, "timestamp": "05:19:17", "text": "我现在生病睡着了。哦，"}, {"type": "subtitle", "time": 19161.03, "timestamp": "05:19:21", "text": "分两次入睡。好的，所以是4"}, {"type": "subtitle", "time": 19163.99, "timestamp": "05:19:23", "text": "每人一小时，对吧？我觉得我应该这样做"}, {"type": "subtitle", "time": 19166.07, "timestamp": "05:19:26", "text": "但问题是，我正在直播"}, {"type": "subtitle", "time": 19169.67, "timestamp": "05:19:29", "text": "已经过了24小时。所以我可能得分摊费用。"}, {"type": "subtitle", "time": 19171.99, "timestamp": "05:19:31", "text": "把它分成两个，就像两个两小时两小时"}, {"type": "subtitle", "time": 19175.27, "timestamp": "05:19:35", "text": "也许吧，我也不知道。"}, {"type": "subtitle", "time": 19177.59, "timestamp": "05:19:37", "text": "我必须，我必须真的修好我的"}, {"type": "subtitle", "time": 19180.03, "timestamp": "05:19:40", "text": "日程。如果我这样下去，我就会"}, {"type": "subtitle", "time": 19184.31, "timestamp": "05:19:44", "text": "非常不健康，而且感觉很累，我的"}, {"type": "subtitle", "time": 19187.59, "timestamp": "05:19:47", "text": "健康状况会很糟糕。是的，我很少来。"}, {"type": "subtitle", "time": 19189.99, "timestamp": "05:19:49", "text": "真想狠狠踢自己一脚。我主要在Twitch上直播。"}, {"type": "subtitle", "time": 19195.99, "timestamp": "05:19:55", "text": "好的。我来到了虚拟主播区。所以，"}, {"type": "subtitle", "time": 19197.83, "timestamp": "05:19:57", "text": "我把文件夹从低级改成了高级"}]
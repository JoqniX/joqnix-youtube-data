[{"type": "subtitle", "time": 19803.39, "timestamp": "05:30:03", "text": "东西？你跟谁谈过？"}, {"type": "subtitle", "time": 19807.948, "timestamp": "05:30:07", "text": "他问了一些诸如课程如何之类的问题"}, {"type": "subtitle", "time": 19812.15, "timestamp": "05:30:12", "text": "是？我不太会说话。它将会大受欢迎"}, {"type": "subtitle", "time": 19814.31, "timestamp": "05:30:14", "text": "现实的残酷现实和交易的遗憾"}, {"type": "subtitle", "time": 19816.99, "timestamp": "05:30:16", "text": "没有把时间花在学习正确方法上"}, {"type": "subtitle", "time": 19820.07, "timestamp": "05:30:20", "text": "现在。是的。哦不，我们还没谈过。"}, {"type": "subtitle", "time": 19824.59, "timestamp": "05:30:24", "text": "关于那件事。我更感兴趣的是他们的"}, {"type": "subtitle", "time": 19827.27, "timestamp": "05:30:27", "text": "情况。他们会被遣返吗？"}, {"type": "subtitle", "time": 19829.51, "timestamp": "05:30:29", "text": "去印度，其实不是真的"}, {"type": "subtitle", "time": 19831.67, "timestamp": "05:30:31", "text": "表现如何？因为他们都没有"}, {"type": "subtitle", "time": 19835.51, "timestamp": "05:30:35", "text": "练习一下。即使是对于……"}, {"type": "subtitle", "time": 19839.11, "timestamp": "05:30:39", "text": "呃，我参加了四月份的活动。"}, {"type": "subtitle", "time": 19842.15, "timestamp": "05:30:42", "text": "不，不。三月份的活动。我参加了什么"}, {"type": "subtitle", "time": 19845.59, "timestamp": "05:30:45", "text": "你管它叫什么？仪式。不，是"}, {"type": "subtitle", "time": 19846.75, "timestamp": "05:30:46", "text": "COE"}, {"type": "subtitle", "time": 19850.628, "timestamp": "05:30:50", "text": "仪式。全部。就像我是"}, {"type": "subtitle", "time": 19856.868, "timestamp": "05:30:56", "text": "只有我和一些其他的呃呃呃同学"}, {"type": "subtitle", "time": 19858.948, "timestamp": "05:30:58", "text": "是唯一一个接近他的人"}]
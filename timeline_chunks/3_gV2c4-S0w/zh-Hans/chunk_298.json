[{"type": "subtitle", "time": 17881.19, "timestamp": "04:58:01", "text": "现在关于“是啊”的事情太多了，如果我不是"}, {"type": "subtitle", "time": 17883.75, "timestamp": "04:58:03", "text": "如果直播没有观众，就无法吸引观众。"}, {"type": "subtitle", "time": 17886.55, "timestamp": "04:58:06", "text": "如果一切顺利，那么我需要……"}, {"type": "subtitle", "time": 17890.788, "timestamp": "04:58:10", "text": "改变一些东西等等。所以我是怎么看待这件事的呢？"}, {"type": "subtitle", "time": 17892.868, "timestamp": "04:58:12", "text": "就像那种糟糕的互动一样"}, {"type": "subtitle", "time": 17896.99, "timestamp": "04:58:16", "text": "就像说我做了"}, {"type": "subtitle", "time": 17900.35, "timestamp": "04:58:20", "text": "即使我当时也在合作"}, {"type": "subtitle", "time": 17904.628, "timestamp": "04:58:24", "text": "感同身受，或者说，有点像那种感觉"}, {"type": "subtitle", "time": 17908.59, "timestamp": "04:58:28", "text": "虽然感觉不太对劲，但我还是做了。"}, {"type": "subtitle", "time": 17911.35, "timestamp": "04:58:31", "text": "在没有给予关注的情况下"}, {"type": "subtitle", "time": 17914.07, "timestamp": "04:58:34", "text": "我听到了什么？他们说了什么？"}, {"type": "subtitle", "time": 17917.75, "timestamp": "04:58:37", "text": "大部头书。即使我做了，我当时也觉得"}, {"type": "subtitle", "time": 17919.628, "timestamp": "04:58:39", "text": "关于它。我会喜欢吗？"}, {"type": "subtitle", "time": 17923.43, "timestamp": "04:58:43", "text": "它？就算我喜欢它，我们"}, {"type": "subtitle", "time": 17927.11, "timestamp": "04:58:47", "text": "他们俩都很喜欢。但这是一个"}, {"type": "subtitle", "time": 17930.31, "timestamp": "04:58:50", "text": "交易协作。不，所以"}, {"type": "subtitle", "time": 17932.23, "timestamp": "04:58:52", "text": "他们会查看浏览量和数据。"}, {"type": "subtitle", "time": 17935.75, "timestamp": "04:58:55", "text": "来自他们的频道。哦，如果我申请这个"}, {"type": "subtitle", "time": 17937.91, "timestamp": "04:58:57", "text": "我的直播间里出现了一个人，有多少人？"}]
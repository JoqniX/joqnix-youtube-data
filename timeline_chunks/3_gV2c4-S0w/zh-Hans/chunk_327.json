[{"type": "subtitle", "time": 19622.31, "timestamp": "05:27:02", "text": "捐款？不，不是，呃，因为"}, {"type": "subtitle", "time": 19625.03, "timestamp": "05:27:05", "text": "这就像一个既定事件，就像我已经预料到的一样。"}, {"type": "subtitle", "time": 19627.35, "timestamp": "05:27:07", "text": "我计划一直做到六月中旬。"}, {"type": "subtitle", "time": 19629.19, "timestamp": "05:27:09", "text": "六月"}, {"type": "subtitle", "time": 19633.19, "timestamp": "05:27:13", "text": "呃，六月底我会开始准备，"}, {"type": "subtitle", "time": 19634.948, "timestamp": "05:27:14", "text": "收拾东西"}, {"type": "subtitle", "time": 19640.31, "timestamp": "05:27:20", "text": "去日本。所以，呃，我把"}, {"type": "subtitle", "time": 19643.51, "timestamp": "05:27:23", "text": "用计时器提醒自己"}, {"type": "subtitle", "time": 19647.19, "timestamp": "05:27:27", "text": "对所有人来说，是的，几个小时"}, {"type": "subtitle", "time": 19651.27, "timestamp": "05:27:31", "text": "就这样被留在了月底。所以是"}, {"type": "subtitle", "time": 19654.31, "timestamp": "05:27:34", "text": "不是完全解除限制，而是有点像解除限制，但是"}, {"type": "subtitle", "time": 19662.43, "timestamp": "05:27:42", "text": "框架。我希望你"}, {"type": "subtitle", "time": 19665.19, "timestamp": "05:27:45", "text": "明白了。如果你错过了任何糟糕的"}, {"type": "subtitle", "time": 19668.31, "timestamp": "05:27:48", "text": "如果有什么地方需要，请告诉我。我将"}, {"type": "subtitle", "time": 19671.19, "timestamp": "05:27:51", "text": "乐意且能够、欣然、愿意"}, {"type": "subtitle", "time": 19673.15, "timestamp": "05:27:53", "text": "愿意解释"}]
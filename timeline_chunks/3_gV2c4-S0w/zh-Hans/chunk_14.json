[{"type": "subtitle", "time": 841.15, "timestamp": "00:14:01", "text": "试图联系新"}, {"type": "subtitle", "time": 844.47, "timestamp": "00:14:04", "text": "人们。是的。当与……连接时"}, {"type": "subtitle", "time": 847.43, "timestamp": "00:14:07", "text": "一直想和某人建立联系，对吧？"}, {"type": "subtitle", "time": 850.269, "timestamp": "00:14:10", "text": "就像我刚开始做 Joathon 的时候，我主要"}, {"type": "subtitle", "time": 853.189, "timestamp": "00:14:13", "text": "我曾说过我想进行合作"}, {"type": "subtitle", "time": 854.99, "timestamp": "00:14:14", "text": "与创作者们"}, {"type": "subtitle", "time": 857.91, "timestamp": "00:14:17", "text": "我珍视并希望……的朋友们"}, {"type": "subtitle", "time": 860.069, "timestamp": "00:14:20", "text": "曾与……合作，也曾与……合作过"}, {"type": "subtitle", "time": 861.91, "timestamp": "00:14:21", "text": "我建立的所有联系"}, {"type": "subtitle", "time": 864.71, "timestamp": "00:14:24", "text": "这段旅程。这就是我唯一的理由"}, {"type": "subtitle", "time": 867.35, "timestamp": "00:14:27", "text": "做 Jakatan 呃，比如合作"}, {"type": "subtitle", "time": 870.87, "timestamp": "00:14:30", "text": "因为我会在Jakatan期间一直在这里"}, {"type": "subtitle", "time": 873.67, "timestamp": "00:14:33", "text": "我只是尽力而为。我这么做不是为了"}, {"type": "subtitle", "time": 877.189, "timestamp": "00:14:37", "text": "金钱或其他任何东西，或者金钱收益。呃"}, {"type": "subtitle", "time": 879.829, "timestamp": "00:14:39", "text": "就是，呃，不做，我不做。"}, {"type": "subtitle", "time": 882.269, "timestamp": "00:14:42", "text": "合作旨在获取经济利益"}, {"type": "subtitle", "time": 886.23, "timestamp": "00:14:46", "text": "获得。这行不通。我不会有这种感觉"}, {"type": "subtitle", "time": 890.67, "timestamp": "00:14:50", "text": "我也很高兴。是的。"}, {"type": "subtitle", "time": 894.47, "timestamp": "00:14:54", "text": "所以，是的，当你问起的时候……"}, {"type": "subtitle", "time": 897.43, "timestamp": "00:14:57", "text": "关于合作以及我付出的一切"}]
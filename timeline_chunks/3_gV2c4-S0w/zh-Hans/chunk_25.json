[{"type": "subtitle", "time": 1509.07, "timestamp": "00:25:09", "text": "那个和"}, {"type": "subtitle", "time": 1513.75, "timestamp": "00:25:13", "text": "呃，是啊，我的意思是，我无法想象"}, {"type": "subtitle", "time": 1516.269, "timestamp": "00:25:16", "text": "我"}, {"type": "subtitle", "time": 1520.549, "timestamp": "00:25:20", "text": "如果我成为那样的人……"}, {"type": "subtitle", "time": 1524.11, "timestamp": "00:25:24", "text": "更大的频道。不喜欢说如果我达到"}, {"type": "subtitle", "time": 1527.269, "timestamp": "00:25:27", "text": "1k 我可能会被认为是一个"}, {"type": "subtitle", "time": 1530.149, "timestamp": "00:25:30", "text": "1k 比 1k 大一点什么的。我"}, {"type": "subtitle", "time": 1531.71, "timestamp": "00:25:31", "text": "我知道有一些"}, {"type": "subtitle", "time": 1535.99, "timestamp": "00:25:35", "text": "人们，但我会改变我的性格吗？"}, {"type": "subtitle", "time": 1539.51, "timestamp": "00:25:39", "text": "我如何待人"}, {"type": "subtitle", "time": 1542.029, "timestamp": "00:25:42", "text": "等等。不，为什么会这样？"}, {"type": "subtitle", "time": 1547.31, "timestamp": "00:25:47", "text": "我？但我无法想象……"}, {"type": "subtitle", "time": 1549.149, "timestamp": "00:25:49", "text": "嗯"}, {"type": "subtitle", "time": 1553.75, "timestamp": "00:25:53", "text": "我们如何才能拒绝呢？呃，不是"}, {"type": "subtitle", "time": 1557.269, "timestamp": "00:25:57", "text": "拒绝，就像更粗鲁一样，就像"}]
[{"type": "subtitle", "time": 4563.27, "timestamp": "01:16:03", "text": "屏幕，否则它会那样做。"}, {"type": "subtitle", "time": 4565.99, "timestamp": "01:16:05", "text": "那确实有这么回事。是的，《我的世界》有一个"}, {"type": "subtitle", "time": 4568.39, "timestamp": "01:16:08", "text": "故障之类的东西。所以，如果你在……上玩它"}, {"type": "subtitle", "time": 4570.229, "timestamp": "01:16:10", "text": "全屏模式下，可能会出现很多故障。"}, {"type": "subtitle", "time": 4572.709, "timestamp": "01:16:12", "text": "观察。所以，要经常玩 Minecraft"}, {"type": "subtitle", "time": 4575.11, "timestamp": "01:16:15", "text": "以窗口模式进行流媒体播放。所以，它不会"}, {"type": "subtitle", "time": 4578.54, "timestamp": "01:16:18", "text": "最小化到后台。"}, {"type": "subtitle", "time": 4580.91, "timestamp": "01:16:20", "text": "[音乐]"}, {"type": "subtitle", "time": 4587.95, "timestamp": "01:16:27", "text": "嗯，没关系。"}, {"type": "subtitle", "time": 4591.35, "timestamp": "01:16:31", "text": "嗯。等等，你把它移除了，移除了一些模组"}, {"type": "subtitle", "time": 4595.03, "timestamp": "01:16:35", "text": "正确的。为什么没有成功？"}, {"type": "subtitle", "time": 4597.51, "timestamp": "01:16:37", "text": "因为我不认为它会问你。"}, {"type": "subtitle", "time": 4601.11, "timestamp": "01:16:41", "text": "也要从客户端转移过来。"}, {"type": "subtitle", "time": 4604.55, "timestamp": "01:16:44", "text": "哦，是啊，真奇怪。虽然"}, {"type": "subtitle", "time": 4608.11, "timestamp": "01:16:48", "text": "应该……哦，等等。是吗？"}, {"type": "subtitle", "time": 4613.76, "timestamp": "01:16:53", "text": "因为一秒钟？让我检查一下文件。"}]
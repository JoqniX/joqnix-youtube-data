[{"type": "subtitle", "time": 17401.91, "timestamp": "04:50:01", "text": "合作之类的。它不"}, {"type": "subtitle", "time": 17404.628, "timestamp": "04:50:04", "text": "必须在他们的频道上。阿里的嗯"}, {"type": "subtitle", "time": 17406.868, "timestamp": "04:50:06", "text": "我的也没问题。如果他们不想"}, {"type": "subtitle", "time": 17408.948, "timestamp": "04:50:08", "text": "合作什么的，我们随时都可以一起玩。"}, {"type": "subtitle", "time": 17412.07, "timestamp": "04:50:12", "text": "关闭直播，然后点赞，做一个"}, {"type": "subtitle", "time": 17414.47, "timestamp": "04:50:14", "text": "联系。不，我一直都是这样。"}, {"type": "subtitle", "time": 17416.75, "timestamp": "04:50:16", "text": "这些年来一直和大家一起做这件事"}, {"type": "subtitle", "time": 17419.35, "timestamp": "04:50:19", "text": "别的。不，它不一定要开着。"}, {"type": "subtitle", "time": 17421.55, "timestamp": "04:50:21", "text": "溪流。不一定要合作。"}, {"type": "subtitle", "time": 17425.27, "timestamp": "04:50:25", "text": "不，是的，然后我就遭遇了那种事。"}, {"type": "subtitle", "time": 17427.59, "timestamp": "04:50:27", "text": "然后我解释说，我当时就想，是啊，有的。"}, {"type": "subtitle", "time": 17431.43, "timestamp": "04:50:31", "text": "出现了很多沟通问题。"}, {"type": "subtitle", "time": 17434.31, "timestamp": "04:50:34", "text": "我希望我们能搭上一辆"}, {"type": "subtitle", "time": 17436.788, "timestamp": "04:50:36", "text": "打电话把事情弄清楚，看看这样行不行。"}, {"type": "subtitle", "time": 17439.75, "timestamp": "04:50:39", "text": "有效或无效。在继续进行下去之前，"}, {"type": "subtitle", "time": 17444.35, "timestamp": "04:50:44", "text": "我说完之后，他们就像在问一样。"}, {"type": "subtitle", "time": 17447.27, "timestamp": "04:50:47", "text": "我不明白这样做的目的。"}, {"type": "subtitle", "time": 17450.11, "timestamp": "04:50:50", "text": "合作。我就像"}, {"type": "subtitle", "time": 17453.27, "timestamp": "04:50:53", "text": "兄弟，然后他把整件事都解释了一遍。"}, {"type": "subtitle", "time": 17456.31, "timestamp": "04:50:56", "text": "再次。我为什么要合作？为什么？"}, {"type": "subtitle", "time": 17459.11, "timestamp": "04:50:59", "text": "确实如此，而且他们也这么认为。是的，他们"}]
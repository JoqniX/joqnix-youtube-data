[{"type": "subtitle", "time": 3301.589, "timestamp": "00:55:01", "text": "所以，我以前常常问，我们怎么样？"}, {"type": "subtitle", "time": 3303.349, "timestamp": "00:55:03", "text": "准备开始合作吗？是什么？"}, {"type": "subtitle", "time": 3305.19, "timestamp": "00:55:05", "text": "合作形式？比如，谁会……"}, {"type": "subtitle", "time": 3306.79, "timestamp": "00:55:06", "text": "介绍一下之类的？我们该如何……"}, {"type": "subtitle", "time": 3311.27, "timestamp": "00:55:11", "text": "做吗？等等，以及诸如重新"}, {"type": "subtitle", "time": 3313.27, "timestamp": "00:55:13", "text": "像往常一样"}, {"type": "subtitle", "time": 3316.829, "timestamp": "00:55:16", "text": "呃，你知道，嗯，我会告诉你的。"}, {"type": "subtitle", "time": 3321.23, "timestamp": "00:55:21", "text": "嗯，以我的经验来看，如果我没记错的话"}, {"type": "subtitle", "time": 3325.99, "timestamp": "00:55:25", "text": "嗯，每当寿司给我端来东西的时候，我都觉得很麻烦。"}, {"type": "subtitle", "time": 3329.15, "timestamp": "00:55:29", "text": "我参与合​​作"}, {"type": "subtitle", "time": 3332.47, "timestamp": "00:55:32", "text": "兄弟，寿司也是个很好的例子。"}, {"type": "subtitle", "time": 3342.99, "timestamp": "00:55:42", "text": "我喜欢寿司，它真是太棒了！"}, {"type": "subtitle", "time": 3346.95, "timestamp": "00:55:46", "text": "创造者。呃，寿司，我们都叫他寿司。"}, {"type": "subtitle", "time": 3349.91, "timestamp": "00:55:49", "text": "他的频道名字好像是Rene"}, {"type": "subtitle", "time": 3351.309, "timestamp": "00:55:51", "text": "马尔"}, {"type": "subtitle", "time": 3354.589, "timestamp": "00:55:54", "text": "渠道。嗯，真不错"}, {"type": "subtitle", "time": 3357.589, "timestamp": "00:55:57", "text": "朋友。是的。天哪，我一直关着我的"}, {"type": "subtitle", "time": 3358.67, "timestamp": "00:55:58", "text": "眼睛和"}]
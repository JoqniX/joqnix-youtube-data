[{"type": "subtitle", "time": 1626.31, "timestamp": "00:27:06", "text": "所以，是的，就像我刚才说的那样。"}, {"type": "subtitle", "time": 1628.07, "timestamp": "00:27:08", "text": "有时，有时你想成为一个"}, {"type": "subtitle", "time": 1631.549, "timestamp": "00:27:11", "text": "好人坏人"}, {"type": "subtitle", "time": 1634.63, "timestamp": "00:27:14", "text": "因为你在教他们步骤。"}, {"type": "subtitle", "time": 1638.07, "timestamp": "00:27:18", "text": "不，就像，现实生活并非如此。"}, {"type": "subtitle", "time": 1641.35, "timestamp": "00:27:21", "text": "总是阳光灿烂，充满彩虹"}, {"type": "subtitle", "time": 1644.07, "timestamp": "00:27:24", "text": "他们会，他们会，这将很困难，而且"}, {"type": "subtitle", "time": 1647.47, "timestamp": "00:27:27", "text": "杂七杂八的东西。这就像……"}, {"type": "subtitle", "time": 1650.669, "timestamp": "00:27:30", "text": "鸟儿送来它们的小"}, {"type": "subtitle", "time": 1654.149, "timestamp": "00:27:34", "text": "一。嗯，我觉得有件事儿，对吧？"}, {"type": "subtitle", "time": 1658.149, "timestamp": "00:27:38", "text": "鸟类确实如此。他们不让孩子进来"}, {"type": "subtitle", "time": 1661.59, "timestamp": "00:27:41", "text": "除非他们搭乘某种交通工具回家，否则就回不了家了。"}, {"type": "subtitle", "time": 1664.47, "timestamp": "00:27:44", "text": "母亲会非常粗鲁无礼"}, {"type": "subtitle", "time": 1667.669, "timestamp": "00:27:47", "text": "孩子。母鸟会很粗鲁"}, {"type": "subtitle", "time": 1671.99, "timestamp": "00:27:51", "text": "朝着孩子的方向，直到它……"}, {"type": "subtitle", "time": 1674.789, "timestamp": "00:27:54", "text": "能飞什么的，对吧？就是这样。"}, {"type": "subtitle", "time": 1678.63, "timestamp": "00:27:58", "text": "不会完全溺爱孩子，对吧？"}]
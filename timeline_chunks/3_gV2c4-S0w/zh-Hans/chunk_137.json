[{"type": "subtitle", "time": 8225.83, "timestamp": "02:17:05", "text": "我的天啊。好的。"}, {"type": "subtitle", "time": 8227.83, "timestamp": "02:17:07", "text": "是的。"}, {"type": "subtitle", "time": 8231.589, "timestamp": "02:17:11", "text": "你是怎么找到这东西的？"}, {"type": "subtitle", "time": 8235.03, "timestamp": "02:17:15", "text": "我就是找不到东西。"}, {"type": "subtitle", "time": 8241.589, "timestamp": "02:17:21", "text": "去。哦，有这个模式吗？客户"}, {"type": "subtitle", "time": 8243.589, "timestamp": "02:17:23", "text": "侧边栏模式，您可以在其中添加内容和"}, {"type": "subtitle", "time": 8246.629, "timestamp": "02:17:26", "text": "一切。那个"}, {"type": "subtitle", "time": 8248.549, "timestamp": "02:17:28", "text": "你想看看我做得怎么样吗？"}, {"type": "subtitle", "time": 8267.629, "timestamp": "02:17:47", "text": "那是调试棒吗？"}, {"type": "subtitle", "time": 8269.589, "timestamp": "02:17:49", "text": "不，差不多是这样。您认为"}, {"type": "subtitle", "time": 8279.03, "timestamp": "02:17:59", "text": "[音乐]"}]
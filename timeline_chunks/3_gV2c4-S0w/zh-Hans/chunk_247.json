[{"type": "subtitle", "time": 14820.51, "timestamp": "04:07:00", "text": "坏的。我现在必须上来。前往"}, {"type": "subtitle", "time": 14836.229, "timestamp": "04:07:16", "text": "呃，你知道，比利·贝利身上的那种感觉是……"}, {"type": "subtitle", "time": 14841.189, "timestamp": "04:07:21", "text": "节奏似乎更慢一些。"}, {"type": "subtitle", "time": 14843.63, "timestamp": "04:07:23", "text": "比预期的要多，因为"}, {"type": "subtitle", "time": 14847.189, "timestamp": "04:07:27", "text": "现在语言障碍是我遇到的问题。"}, {"type": "subtitle", "time": 14850.229, "timestamp": "04:07:30", "text": "真讨厌。"}, {"type": "subtitle", "time": 14852.79, "timestamp": "04:07:32", "text": "我希望我们能有办法"}, {"type": "subtitle", "time": 14854.91, "timestamp": "04:07:34", "text": "连接"}, {"type": "subtitle", "time": 14857.03, "timestamp": "04:07:37", "text": "本来应该没问题，但因为不好的原因"}, {"type": "subtitle", "time": 14859.11, "timestamp": "04:07:39", "text": "语言。哦等等，我甚至还没……"}, {"type": "subtitle", "time": 14862.03, "timestamp": "04:07:42", "text": "我检查了我的Q，"}, {"type": "subtitle", "time": 14865.269, "timestamp": "04:07:45", "text": "正确的？我想我应该通知我的社区。"}]
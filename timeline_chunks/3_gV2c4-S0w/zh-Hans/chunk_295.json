[{"type": "subtitle", "time": 17702.39, "timestamp": "04:55:02", "text": "他们那件事，但只是说一次而已。"}, {"type": "subtitle", "time": 17704.23, "timestamp": "04:55:04", "text": "两次或多次并不意味着"}, {"type": "subtitle", "time": 17706.708, "timestamp": "04:55:06", "text": "他们现在把你当朋友。"}, {"type": "subtitle", "time": 17708.83, "timestamp": "04:55:08", "text": "有很多东西……"}, {"type": "subtitle", "time": 17713.11, "timestamp": "04:55:13", "text": "对吧？为了我们，一切都为了我们"}, {"type": "subtitle", "time": 17716.628, "timestamp": "04:55:16", "text": "现在，我们喜欢和某人在一起。"}, {"type": "subtitle", "time": 17718.31, "timestamp": "04:55:18", "text": "我们称它们为最好的朋友"}, {"type": "subtitle", "time": 17721.35, "timestamp": "04:55:21", "text": "东西。现在，我们不会考虑这个问题。"}, {"type": "subtitle", "time": 17722.868, "timestamp": "04:55:22", "text": "在差异化方面"}, {"type": "subtitle", "time": 17724.43, "timestamp": "04:55:24", "text": "友谊，"}, {"type": "subtitle", "time": 17729.27, "timestamp": "04:55:29", "text": "正确的？朋友，或者类似准社会关系，或者什么？"}, {"type": "subtitle", "time": 17732.708, "timestamp": "04:55:32", "text": "不管那些事，对吧？分离"}, {"type": "subtitle", "time": 17737.59, "timestamp": "04:55:37", "text": "就像亲密的朋友，就像我们的文化"}, {"type": "subtitle", "time": 17740.55, "timestamp": "04:55:40", "text": "我们没有那种东西，某种程度上来说。"}, {"type": "subtitle", "time": 17742.708, "timestamp": "04:55:42", "text": "我们视每个人都为朋友。"}, {"type": "subtitle", "time": 17744.75, "timestamp": "04:55:44", "text": "不，我们"}, {"type": "subtitle", "time": 17748.868, "timestamp": "04:55:48", "text": "嗯，我们会和他们在一起，就像……"}, {"type": "subtitle", "time": 17751.99, "timestamp": "04:55:51", "text": "我们尽全力，享受与朋友们共度的时光"}, {"type": "subtitle", "time": 17753.07, "timestamp": "04:55:53", "text": "朋友们"}, {"type": "subtitle", "time": 17756.47, "timestamp": "04:55:56", "text": "对，是啊，我觉得也一样。"}, {"type": "subtitle", "time": 17759.19, "timestamp": "04:55:59", "text": "呃，当它来的时候，我想我已经学会了。"}]
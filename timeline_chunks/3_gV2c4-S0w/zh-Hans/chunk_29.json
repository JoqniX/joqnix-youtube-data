[{"type": "subtitle", "time": 1743.19, "timestamp": "00:29:03", "text": "它。那张图表在哪儿？像小微型"}, {"type": "subtitle", "time": 1752.95, "timestamp": "00:29:12", "text": "我不明白。为什么我找不到它？"}, {"type": "subtitle", "time": 1756.99, "timestamp": "00:29:16", "text": "我以为我已经收藏了。"}, {"type": "subtitle", "time": 1759.389, "timestamp": "00:29:19", "text": "但我找不到它。"}, {"type": "subtitle", "time": 1768.19, "timestamp": "00:29:28", "text": "那里。我找不到。没有任何"}, {"type": "subtitle", "time": 1769.87, "timestamp": "00:29:29", "text": "那里。"}, {"type": "subtitle", "time": 1772.71, "timestamp": "00:29:32", "text": "啊，如果我碰巧找到了它"}, {"type": "subtitle", "time": 1782.63, "timestamp": "00:29:42", "text": "是的。但这很公平。这很公平。"}, {"type": "subtitle", "time": 1786.71, "timestamp": "00:29:46", "text": "尼拉桑，生日快乐。这是尼拉桑的"}, {"type": "subtitle", "time": 1788.83, "timestamp": "00:29:48", "text": "顺便提一下，这是你的生日。"}, {"type": "subtitle", "time": 1790.59, "timestamp": "00:29:50", "text": "今天。"}, {"type": "subtitle", "time": 1793.59, "timestamp": "00:29:53", "text": "嗯，她住在日本，对吧？"}]
[{"type": "subtitle", "time": 2040.789, "timestamp": "00:34:00", "text": "农作物正在生长"}, {"type": "subtitle", "time": 2043.269, "timestamp": "00:34:03", "text": "呃，烹饪、冶炼一切都会是"}, {"type": "subtitle", "time": 2046.389, "timestamp": "00:34:06", "text": "运行起来也跟那个东西一样。"}, {"type": "subtitle", "time": 2048.389, "timestamp": "00:34:08", "text": "所以你可以进行一次漫长的探险。"}, {"type": "subtitle", "time": 2050.47, "timestamp": "00:34:10", "text": "回到家，看到你的工作进展顺利。"}, {"type": "subtitle", "time": 2053.99, "timestamp": "00:34:13", "text": "就是这样。所以，仅仅是生活质量的问题。"}, {"type": "subtitle", "time": 2057.909, "timestamp": "00:34:17", "text": "我添加的模式。差不多就是这样。我猜"}, {"type": "subtitle", "time": 2075.109, "timestamp": "00:34:35", "text": "正确的。但是这些炉子都不能用。"}, {"type": "subtitle", "time": 2077.14, "timestamp": "00:34:37", "text": "是的，暖气炉"}, {"type": "subtitle", "time": 2078.51, "timestamp": "00:34:38", "text": "[音乐]"}, {"type": "subtitle", "time": 2080.31, "timestamp": "00:34:40", "text": "神清气爽。请问我们是什么？"}, {"type": "subtitle", "time": 2082.47, "timestamp": "00:34:42", "text": "说？哦，我的世界。我熬夜了"}, {"type": "subtitle", "time": 2085.19, "timestamp": "00:34:45", "text": "昨晚呃，只是想再做一些事情"}, {"type": "subtitle", "time": 2088.069, "timestamp": "00:34:48", "text": "新游戏的一些模组和东西"}, {"type": "subtitle", "time": 2092.99, "timestamp": "00:34:52", "text": "轻型SMPP，呃，自从Aster给了我"}, {"type": "subtitle", "time": 2096.99, "timestamp": "00:34:56", "text": "服务器。呃，还有这个"}]
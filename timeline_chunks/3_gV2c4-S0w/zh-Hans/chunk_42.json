[{"type": "subtitle", "time": 2520.95, "timestamp": "00:42:00", "text": "已经注册好了。我们做到了"}, {"type": "subtitle", "time": 2523.27, "timestamp": "00:42:03", "text": "合作以及每当我看到我的那些"}, {"type": "subtitle", "time": 2527.069, "timestamp": "00:42:07", "text": "我从我的杂耍假期中合作的作品"}, {"type": "subtitle", "time": 2529.39, "timestamp": "00:42:09", "text": "那玩意儿，我就想，"}, {"type": "subtitle", "time": 2531.71, "timestamp": "00:42:11", "text": "哇，我仍然"}, {"type": "subtitle", "time": 2535.67, "timestamp": "00:42:15", "text": "记住他对我说的话。多少钱？"}, {"type": "subtitle", "time": 2540.15, "timestamp": "00:42:20", "text": "就像他指导和帮助的那种人一样"}, {"type": "subtitle", "time": 2545.03, "timestamp": "00:42:25", "text": "比如，他发表了他对一些事情的嗯……想法。"}, {"type": "subtitle", "time": 2547.349, "timestamp": "00:42:27", "text": "等等，当我谈论事情的时候"}, {"type": "subtitle", "time": 2549.91, "timestamp": "00:42:29", "text": "关于复训等等。是的，我"}, {"type": "subtitle", "time": 2552.19, "timestamp": "00:42:32", "text": "仍然记得"}, {"type": "subtitle", "time": 2555.109, "timestamp": "00:42:35", "text": "它。对，就是诸如此类的事情。"}, {"type": "subtitle", "time": 2557.109, "timestamp": "00:42:37", "text": "我只是尽力变得更好。"}, {"type": "subtitle", "time": 2559.75, "timestamp": "00:42:39", "text": "专业等等，无论是什么"}, {"type": "subtitle", "time": 2562.63, "timestamp": "00:42:42", "text": "与一些企业 YouTuber 合作。"}, {"type": "subtitle", "time": 2565.03, "timestamp": "00:42:45", "text": "我想大概就是在那段时间我参与了合作。"}, {"type": "subtitle", "time": 2567.589, "timestamp": "00:42:47", "text": "星空"}, {"type": "subtitle", "time": 2570.87, "timestamp": "00:42:50", "text": "呃，天赋之类的。所以，我试着成为"}, {"type": "subtitle", "time": 2574.069, "timestamp": "00:42:54", "text": "对他们来说，我也更专业一些。"}, {"type": "subtitle", "time": 2576.91, "timestamp": "00:42:56", "text": "知道他们的东西是什么。"}]
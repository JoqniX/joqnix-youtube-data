[{"type": "subtitle", "time": 2882.15, "timestamp": "00:48:02", "text": "等等。就像所有清晰明确的切割一样。"}, {"type": "subtitle", "time": 2884.109, "timestamp": "00:48:04", "text": "清晰类型的"}, {"type": "subtitle", "time": 2887.829, "timestamp": "00:48:07", "text": "杂七杂八的东西。我们就是这样。"}, {"type": "subtitle", "time": 2890.15, "timestamp": "00:48:10", "text": "这次合作是一次很好的经历。"}, {"type": "subtitle", "time": 2893.67, "timestamp": "00:48:13", "text": "主持人主动主持"}, {"type": "subtitle", "time": 2896.55, "timestamp": "00:48:16", "text": "整个协作过程确保每个人都能获得"}, {"type": "subtitle", "time": 2900.19, "timestamp": "00:48:20", "text": "发言时要确保不是每个人都在说话"}, {"type": "subtitle", "time": 2903.67, "timestamp": "00:48:23", "text": "打断确保每个人都呃"}, {"type": "subtitle", "time": 2906.95, "timestamp": "00:48:26", "text": "引言介绍得很好等等。"}, {"type": "subtitle", "time": 2908.95, "timestamp": "00:48:28", "text": "那种专业的环境，当我"}, {"type": "subtitle", "time": 2912.069, "timestamp": "00:48:32", "text": "当时我就想，我的天哪"}, {"type": "subtitle", "time": 2915.27, "timestamp": "00:48:35", "text": "这就是专业人士的做法吗？"}, {"type": "subtitle", "time": 2918.95, "timestamp": "00:48:38", "text": "就像真正的伊恩·油管博主那样做"}, {"type": "subtitle", "time": 2921.43, "timestamp": "00:48:41", "text": "这种东西就像全新的一样。"}, {"type": "subtitle", "time": 2924.069, "timestamp": "00:48:44", "text": "经历，我感觉就像拥有了……"}, {"type": "subtitle", "time": 2926.549, "timestamp": "00:48:46", "text": "我起了鸡皮疙瘩，感觉自己像个幸福的人。"}, {"type": "subtitle", "time": 2929.39, "timestamp": "00:48:49", "text": "实际上，我参与了这次合作。我"}, {"type": "subtitle", "time": 2934.23, "timestamp": "00:48:54", "text": "真的很高兴，就像，是的，我为此感到自豪。"}, {"type": "subtitle", "time": 2938.309, "timestamp": "00:48:58", "text": "能够受邀参与此次合作。那是一个"}]
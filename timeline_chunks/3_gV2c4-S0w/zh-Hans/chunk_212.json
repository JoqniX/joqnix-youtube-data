[{"type": "subtitle", "time": 12724.71, "timestamp": "03:32:04", "text": "不行，晚安。晚安。好的"}, {"type": "subtitle", "time": 12726.03, "timestamp": "03:32:06", "text": "夜晚。"}, {"type": "subtitle", "time": 12727.95, "timestamp": "03:32:07", "text": "睡觉。好的"}, {"type": "subtitle", "time": 12731.349, "timestamp": "03:32:11", "text": "夜晚。今晚星辰指引着你"}, {"type": "subtitle", "time": 12743.71, "timestamp": "03:32:23", "text": "梦想。好的，就是这样。"}, {"type": "subtitle", "time": 12747.91, "timestamp": "03:32:27", "text": "在职的。我得说唱。我真的"}, {"type": "subtitle", "time": 12754.83, "timestamp": "03:32:34", "text": "我完成了60年"}, {"type": "subtitle", "time": 12757.389, "timestamp": "03:32:37", "text": "昨天。那我必须"}, {"type": "subtitle", "time": 12764.03, "timestamp": "03:32:44", "text": "溪流"}, {"type": "subtitle", "time": 12766.91, "timestamp": "03:32:46", "text": "61. 把那"}, {"type": "subtitle", "time": 12769.51, "timestamp": "03:32:49", "text": "那里。这是清晨的溪流。现在"}, {"type": "subtitle", "time": 12773.269, "timestamp": "03:32:53", "text": "我当时脑子一片空白，心想："}, {"type": "subtitle", "time": 12777.67, "timestamp": "03:32:57", "text": "我们来玩游戏吧。我们确实这么做了。"}]
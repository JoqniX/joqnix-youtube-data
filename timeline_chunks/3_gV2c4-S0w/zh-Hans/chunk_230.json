[{"type": "subtitle", "time": 13800.55, "timestamp": "03:50:00", "text": "我明白了，我会直播第二部分。"}, {"type": "subtitle", "time": 13804.07, "timestamp": "03:50:04", "text": "夜间直播先行。这将是下午 12 点。"}, {"type": "subtitle", "time": 13805.95, "timestamp": "03:50:05", "text": "时间是8点。"}, {"type": "subtitle", "time": 13808.269, "timestamp": "03:50:08", "text": "下午"}, {"type": "subtitle", "time": 13811.51, "timestamp": "03:50:11", "text": "IST。完毕。"}, {"type": "subtitle", "time": 13814.15, "timestamp": "03:50:14", "text": "时间是晚上8点。明天。和"}, {"type": "subtitle", "time": 13817.269, "timestamp": "03:50:17", "text": "早晨的溪流大概会是"}, {"type": "subtitle", "time": 13818.75, "timestamp": "03:50:18", "text": "晚上8点8:00"}, {"type": "subtitle", "time": 13822.87, "timestamp": "03:50:22", "text": "早上。就像我一直这样，我的整个日程安排是"}, {"type": "subtitle", "time": 13827.189, "timestamp": "03:50:27", "text": "现在完全坏了。就是这样。"}, {"type": "subtitle", "time": 13834.11, "timestamp": "03:50:34", "text": "诚实地。好像我不应该……"}, {"type": "subtitle", "time": 13837.67, "timestamp": "03:50:37", "text": "到了这个点，我应该已经睡了。"}, {"type": "subtitle", "time": 13841.469, "timestamp": "03:50:41", "text": "睡眠。我本该十点睡觉的。"}, {"type": "subtitle", "time": 13844.469, "timestamp": "03:50:44", "text": "下午但自从我开始合作以来，"}, {"type": "subtitle", "time": 13847.79, "timestamp": "03:50:47", "text": "与其他玩家一起玩游戏之类的活动"}, {"type": "subtitle", "time": 13850.79, "timestamp": "03:50:50", "text": "朋友喜欢这样，我就想，嗯。"}, {"type": "subtitle", "time": 13853.189, "timestamp": "03:50:53", "text": "睡眠时间表。睡眠时间表是什么？"}, {"type": "subtitle", "time": 13854.429, "timestamp": "03:50:54", "text": "什么是"}, {"type": "subtitle", "time": 13857.51, "timestamp": "03:50:57", "text": "那？我开始变成一个夜猫子"}]
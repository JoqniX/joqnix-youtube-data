[{"type": "subtitle", "time": 9243.59, "timestamp": "02:34:03", "text": "那么我们有类似的东西吗？"}, {"type": "subtitle", "time": 9245.349, "timestamp": "02:34:05", "text": "等待。那么演职员表呢？"}, {"type": "subtitle", "time": 9248.19, "timestamp": "02:34:08", "text": "然后呢？会怎么样呢？"}, {"type": "subtitle", "time": 9251.59, "timestamp": "02:34:11", "text": "这位同人小说的作者是谁？不。会是吗？"}, {"type": "subtitle", "time": 9257.03, "timestamp": "02:34:17", "text": "呃，你知道，官方同人小说或者"}, {"type": "subtitle", "time": 9260.03, "timestamp": "02:34:20", "text": "某物？就这么"}, {"type": "subtitle", "time": 9267.389, "timestamp": "02:34:27", "text": "随便发到某个地方。"}, {"type": "subtitle", "time": 9270.75, "timestamp": "02:34:30", "text": "哈。我当时就在想，如果真是这样的话……"}, {"type": "subtitle", "time": 9273.91, "timestamp": "02:34:33", "text": "嗯，这收音机不像粉丝自制的东西。"}, {"type": "subtitle", "time": 9276.87, "timestamp": "02:34:36", "text": "就在你发布公开消息的时候"}, {"type": "subtitle", "time": 9280.63, "timestamp": "02:34:40", "text": "如何创建信用记录？"}, {"type": "subtitle", "time": 9283.99, "timestamp": "02:34:43", "text": "信用额度会是什么样的呢？"}, {"type": "subtitle", "time": 9285.91, "timestamp": "02:34:45", "text": "现在你需要，我觉得没有。"}, {"type": "subtitle", "time": 9288.389, "timestamp": "02:34:48", "text": "这将获得相应的认可。"}, {"type": "subtitle", "time": 9293.19, "timestamp": "02:34:53", "text": "既然你们的人民已经做对了，那就好了。"}, {"type": "subtitle", "time": 9297.83, "timestamp": "02:34:57", "text": "是的，社区制作的。"}, {"type": "subtitle", "time": 9299.75, "timestamp": "02:34:59", "text": "是的，"}]
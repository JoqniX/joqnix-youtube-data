[{"type": "subtitle", "time": 11761.429, "timestamp": "03:16:01", "text": "哇。而且它还有动画。哇。什么？"}, {"type": "subtitle", "time": 11764.389, "timestamp": "03:16:04", "text": "我勒个去？哦，这需要一段时间。"}, {"type": "subtitle", "time": 11767.75, "timestamp": "03:16:07", "text": "需要加载很多数据块，是吗？"}, {"type": "subtitle", "time": 11770.95, "timestamp": "03:16:10", "text": "好的，乔，那我走了。你玩得开心。我"}, {"type": "subtitle", "time": 11773.75, "timestamp": "03:16:13", "text": "今天得早点睡。哦，"}, {"type": "subtitle", "time": 11777.51, "timestamp": "03:16:17", "text": "你要睡觉了。哦，它有"}, {"type": "subtitle", "time": 11780.63, "timestamp": "03:16:20", "text": "乔，你也该去睡觉了。你"}, {"type": "subtitle", "time": 11783.99, "timestamp": "03:16:23", "text": "睡眠质量更好。"}, {"type": "subtitle", "time": 11786.87, "timestamp": "03:16:26", "text": "你最好现在就去睡觉。正确的"}, {"type": "subtitle", "time": 11790.309, "timestamp": "03:16:30", "text": "现在？什么？"}, {"type": "subtitle", "time": 11799.79, "timestamp": "03:16:39", "text": "你们中的许多人"}, {"type": "subtitle", "time": 11803.67, "timestamp": "03:16:43", "text": "我猜"}, {"type": "subtitle", "time": 11807.91, "timestamp": "03:16:47", "text": "只要我不分心。是的。"}, {"type": "subtitle", "time": 11815.67, "timestamp": "03:16:55", "text": "我们拭目以待。"}, {"type": "subtitle", "time": 11818.95, "timestamp": "03:16:58", "text": "是啊，但我快死了。但愿如此。"}]
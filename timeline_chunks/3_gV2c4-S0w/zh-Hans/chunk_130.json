[{"type": "subtitle", "time": 7801.72, "timestamp": "02:10:01", "text": "欢迎安德拉。你好吗？"}, {"type": "subtitle", "time": 7812.629, "timestamp": "02:10:12", "text": "欢迎。她感觉很奇怪。我需要补充"}, {"type": "subtitle", "time": 7842.03, "timestamp": "02:10:42", "text": "或许你感觉不到这一点"}, {"type": "subtitle", "time": 7844.87, "timestamp": "02:10:44", "text": "奇怪的。加厚了一些。我应该做吗？"}]
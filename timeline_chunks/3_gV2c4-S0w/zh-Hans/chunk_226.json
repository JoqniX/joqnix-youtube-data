[{"type": "subtitle", "time": 13561.51, "timestamp": "03:46:01", "text": "现在情况并非如此。我不知道发生了什么事。"}, {"type": "subtitle", "time": 13564.91, "timestamp": "03:46:04", "text": "一直没有音乐。"}, {"type": "subtitle", "time": 13568.67, "timestamp": "03:46:08", "text": "课程。感觉有点像我的课程"}, {"type": "subtitle", "time": 13572.469, "timestamp": "03:46:12", "text": "结束了，但我仍然感觉不像我"}, {"type": "subtitle", "time": 13575.429, "timestamp": "03:46:15", "text": "仔细研究了道具的所有细节。但"}, {"type": "subtitle", "time": 13577.15, "timestamp": "03:46:17", "text": "他们制作了吗？"}, {"type": "subtitle", "time": 13579.67, "timestamp": "03:46:19", "text": "他们是否组建了一个新的团队？"}, {"type": "subtitle", "time": 13582.309, "timestamp": "03:46:22", "text": "有些事，呃，呃，他们把我落下了。"}, {"type": "subtitle", "time": 13585.269, "timestamp": "03:46:25", "text": "还是别的什么？我很困惑。"}, {"type": "subtitle", "time": 13587.389, "timestamp": "03:46:27", "text": "但我一直在参加这个 Ableton 活动"}, {"type": "subtitle", "time": 13591.55, "timestamp": "03:46:31", "text": "类似现场音乐制作课程"}, {"type": "subtitle", "time": 13593.91, "timestamp": "03:46:33", "text": "嗯，四个月。这是第四个"}, {"type": "subtitle", "time": 13595.389, "timestamp": "03:46:35", "text": "是月份，对吧？"}]
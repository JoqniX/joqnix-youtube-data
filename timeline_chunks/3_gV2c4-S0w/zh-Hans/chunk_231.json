[{"type": "subtitle", "time": 13864.349, "timestamp": "03:51:04", "text": "哇。我会赶在9点前。"}, {"type": "subtitle", "time": 13869.309, "timestamp": "03:51:09", "text": "上午。通常的第一节课时间"}, {"type": "subtitle", "time": 13872.87, "timestamp": "03:51:12", "text": "投币口。 Joadan 的流媒体有四次"}, {"type": "subtitle", "time": 13876.71, "timestamp": "03:51:16", "text": "老虎机。嗯，实际上是四个季度。 9:00"}, {"type": "subtitle", "time": 13879.67, "timestamp": "03:51:19", "text": "早上，新的一天开始了，新的篇章也随之开启。"}, {"type": "subtitle", "time": 13882.91, "timestamp": "03:51:22", "text": "晨间直播第一部分。上午9:00"}, {"type": "subtitle", "time": 13886.15, "timestamp": "03:51:26", "text": "至晚上9点会是12个小时，对吧？"}, {"type": "subtitle", "time": 13889.91, "timestamp": "03:51:29", "text": "所以，它把它分成了两个槽位。 9"}, {"type": "subtitle", "time": 13890.83, "timestamp": "03:51:30", "text": "到"}, {"type": "subtitle", "time": 13896.15, "timestamp": "03:51:36", "text": "下午3点一个插槽。下午3:00至晚上9点"}, {"type": "subtitle", "time": 13900.309, "timestamp": "03:51:40", "text": "进入第二个槽位。晚上9点至凌晨3点"}, {"type": "subtitle", "time": 13903.11, "timestamp": "03:51:43", "text": "第三位。是的，现在应该是三点钟了。"}, {"type": "subtitle", "time": 13904.79, "timestamp": "03:51:44", "text": "对我来说是早上。是的，我们仍在继续。"}, {"type": "subtitle", "time": 13907.63, "timestamp": "03:51:47", "text": "第三个位置"}, {"type": "subtitle", "time": 13910.309, "timestamp": "03:51:50", "text": "现在。是的，从凌晨3点到晚上9点。"}, {"type": "subtitle", "time": 13913.91, "timestamp": "03:51:53", "text": "上午第四时段。所以，凌晨3点到"}, {"type": "subtitle", "time": 13916.429, "timestamp": "03:51:56", "text": "早上9点那件事，就像很早的时候。"}, {"type": "subtitle", "time": 13919.51, "timestamp": "03:51:59", "text": "早餐部分，就是用来……"}]
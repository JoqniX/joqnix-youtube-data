[{"type": "subtitle", "time": 18002.51, "timestamp": "05:00:02", "text": "老兄，我"}, {"type": "subtitle", "time": 18007.07, "timestamp": "05:00:07", "text": "嗯，不过我也不知道我发了那么多。"}, {"type": "subtitle", "time": 18010.788, "timestamp": "05:00:10", "text": "用长段落解释每个要点"}, {"type": "subtitle", "time": 18013.43, "timestamp": "05:00:13", "text": "这次我确实确保输入了"}, {"type": "subtitle", "time": 18015.43, "timestamp": "05:00:15", "text": "日文翻译中也提到了"}, {"type": "subtitle", "time": 18019.99, "timestamp": "05:00:19", "text": "我使用了谷歌翻译。"}, {"type": "subtitle", "time": 18021.55, "timestamp": "05:00:21", "text": "呃，我们……"}, {"type": "subtitle", "time": 18025.83, "timestamp": "05:00:25", "text": "希望，呃，让我们祈祷他们能看到它吧。"}, {"type": "subtitle", "time": 18028.99, "timestamp": "05:00:28", "text": "如果他们感兴趣的话。你知道"}, {"type": "subtitle", "time": 18032.39, "timestamp": "05:00:32", "text": "什么？然后我意识到，是的，在这个"}, {"type": "subtitle", "time": 18035.91, "timestamp": "05:00:35", "text": "旅途中会有一些诸如此类的时刻"}, {"type": "subtitle", "time": 18039.51, "timestamp": "05:00:39", "text": "在这里你会受到排斥，在你"}, {"type": "subtitle", "time": 18041.31, "timestamp": "05:00:41", "text": "将被拒绝"}, {"type": "subtitle", "time": 18045.948, "timestamp": "05:00:45", "text": "等等，甚至粗鲁、恶劣或令人厌恶。"}, {"type": "subtitle", "time": 18048.51, "timestamp": "05:00:48", "text": "经历。这是你人生旅程的一部分。"}, {"type": "subtitle", "time": 18050.75, "timestamp": "05:00:50", "text": "知道。它是"}, {"type": "subtitle", "time": 18053.43, "timestamp": "05:00:53", "text": "但这并不意味着我应该"}, {"type": "subtitle", "time": 18056.11, "timestamp": "05:00:56", "text": "停止合作"}, {"type": "subtitle", "time": 18059.51, "timestamp": "05:00:59", "text": "共。我确定，就像是的，我"}]
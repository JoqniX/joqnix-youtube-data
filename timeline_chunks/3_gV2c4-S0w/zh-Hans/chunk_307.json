[{"type": "subtitle", "time": 18422.03, "timestamp": "05:07:02", "text": "如此精妙的组合。"}, {"type": "subtitle", "time": 18424.788, "timestamp": "05:07:04", "text": "哇。稳定发挥如何？什么是"}, {"type": "subtitle", "time": 18428.708, "timestamp": "05:07:08", "text": "即使是稳定的？我还没学过。"}, {"type": "subtitle", "time": 18431.99, "timestamp": "05:07:11", "text": "我觉得我应该……我觉得整个"}, {"type": "subtitle", "time": 18434.35, "timestamp": "05:07:14", "text": "门票应该会在本周发放。"}, {"type": "subtitle", "time": 18437.43, "timestamp": "05:07:17", "text": "下周或下周。我甚至不知道"}, {"type": "subtitle", "time": 18440.23, "timestamp": "05:07:20", "text": "我应该参加哪门科目的考试？"}, {"type": "subtitle", "time": 18444.15, "timestamp": "05:07:24", "text": "或者考试日期。我相信"}, {"type": "subtitle", "time": 18446.99, "timestamp": "05:07:26", "text": "现在应该是六月了。"}, {"type": "subtitle", "time": 18451.788, "timestamp": "05:07:31", "text": "16岁左右。 16岁及以上或14岁"}, {"type": "subtitle", "time": 18453.39, "timestamp": "05:07:33", "text": "继续。"}, {"type": "subtitle", "time": 18456.07, "timestamp": "05:07:36", "text": "呃，天哪，我得学习了。"}, {"type": "subtitle", "time": 18467.67, "timestamp": "05:07:47", "text": "哦。我必须学习放弃放弃"}, {"type": "subtitle", "time": 18469.07, "timestamp": "05:07:49", "text": "我所做的一切。"}, {"type": "subtitle", "time": 18477.67, "timestamp": "05:07:57", "text": "是的。有趣的是，我有一个韩国人"}]
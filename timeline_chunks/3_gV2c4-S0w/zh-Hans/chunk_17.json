[{"type": "subtitle", "time": 1021.91, "timestamp": "00:17:01", "text": "诸如此类的东西。他们开始刨根问底"}, {"type": "subtitle", "time": 1025.99, "timestamp": "00:17:05", "text": "关于你的东西，然后问一些类似这样的话"}, {"type": "subtitle", "time": 1029.909, "timestamp": "00:17:09", "text": "呃，你连续做了这么多天，"}, {"type": "subtitle", "time": 1032.789, "timestamp": "00:17:12", "text": "为什么它运行不佳等等。所有这些"}, {"type": "subtitle", "time": 1034.829, "timestamp": "00:17:14", "text": "比如评论之类的"}, {"type": "subtitle", "time": 1038.909, "timestamp": "00:17:18", "text": "当然，建设性批评是……"}, {"type": "subtitle", "time": 1041.069, "timestamp": "00:17:21", "text": "好的，当然可以。"}, {"type": "subtitle", "time": 1042.99, "timestamp": "00:17:22", "text": "戈卡"}, {"type": "subtitle", "time": 1046.75, "timestamp": "00:17:26", "text": "但这只有效"}, {"type": "subtitle", "time": 1050.63, "timestamp": "00:17:30", "text": "如果我像给予某人同意一样"}, {"type": "subtitle", "time": 1055.11, "timestamp": "00:17:35", "text": "嗯，我让他们这么做，不，但是如果我"}, {"type": "subtitle", "time": 1057.75, "timestamp": "00:17:37", "text": "别让他们允许他们这么做。"}, {"type": "subtitle", "time": 1061.63, "timestamp": "00:17:41", "text": "他们这样做并非"}, {"type": "subtitle", "time": 1065.59, "timestamp": "00:17:45", "text": "嗯，你知道，就像如果那是我朋友那样。"}, {"type": "subtitle", "time": 1068.47, "timestamp": "00:17:48", "text": "如果我们关系很亲密，那我"}, {"type": "subtitle", "time": 1072.31, "timestamp": "00:17:52", "text": "我说，你看，我知道我们是朋友，我们是"}, {"type": "subtitle", "time": 1074.31, "timestamp": "00:17:54", "text": "就像我是个好朋友一样，我只是想……"}, {"type": "subtitle", "time": 1077.39, "timestamp": "00:17:57", "text": "赋予一种文化以喜爱之情，就是这样。"}]
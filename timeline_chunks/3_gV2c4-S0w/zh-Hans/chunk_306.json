[{"type": "subtitle", "time": 18360.07, "timestamp": "05:06:00", "text": "合作款应该是……"}, {"type": "subtitle", "time": 18371.11, "timestamp": "05:06:11", "text": "所以我想知道，是不是因为我们拿走了大部分"}, {"type": "subtitle", "time": 18373.67, "timestamp": "05:06:13", "text": "我们中的许多人把找回物品视为一种充满激情的事情"}, {"type": "subtitle", "time": 18377.03, "timestamp": "05:06:17", "text": "我们做这件事纯粹是为了好玩。我们喜欢"}, {"type": "subtitle", "time": 18380.868, "timestamp": "05:06:20", "text": "做YouTube视频纯粹是为了好玩。是吗？"}, {"type": "subtitle", "time": 18383.99, "timestamp": "05:06:23", "text": "人们之所以这么说，是因为你看到了它"}, {"type": "subtitle", "time": 18386.55, "timestamp": "05:06:26", "text": "像这样吗？比如，如果你说你做了"}, {"type": "subtitle", "time": 18388.59, "timestamp": "05:06:28", "text": "严重地。"}, {"type": "subtitle", "time": 18391.83, "timestamp": "05:06:31", "text": "不。如果你认真地认真地去做。"}, {"type": "subtitle", "time": 18394.51, "timestamp": "05:06:34", "text": "你要去的地方是你唯一的收入来源"}, {"type": "subtitle", "time": 18397.51, "timestamp": "05:06:37", "text": "流媒体。你必须成长。你必须"}, {"type": "subtitle", "time": 18400.39, "timestamp": "05:06:40", "text": "赚钱。你会如何着手？"}, {"type": "subtitle", "time": 18403.35, "timestamp": "05:06:43", "text": "合作？我想知道。我的意思是，是的，真的"}, {"type": "subtitle", "time": 18406.868, "timestamp": "05:06:46", "text": "合作关系将持续很长时间。"}, {"type": "subtitle", "time": 18409.19, "timestamp": "05:06:49", "text": "实际上，你会拥有你将会"}, {"type": "subtitle", "time": 18412.59, "timestamp": "05:06:52", "text": "结交长久的朋友，"}, {"type": "subtitle", "time": 18414.11, "timestamp": "05:06:54", "text": "正确的？"}, {"type": "subtitle", "time": 18417.03, "timestamp": "05:06:57", "text": "是的。这里面包含的东西太多了，老兄。我是"}, {"type": "subtitle", "time": 18419.83, "timestamp": "05:06:59", "text": "想太多了。深沉的这是"}]
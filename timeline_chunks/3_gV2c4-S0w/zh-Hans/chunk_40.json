[{"type": "subtitle", "time": 2401.19, "timestamp": "00:40:01", "text": "比如诸如此类的东西。是的，我"}, {"type": "subtitle", "time": 2403.91, "timestamp": "00:40:03", "text": "我会尽我所能确保每个人都喜欢"}, {"type": "subtitle", "time": 2407.069, "timestamp": "00:40:07", "text": "感觉和我合作很愉快，"}, {"type": "subtitle", "time": 2409.43, "timestamp": "00:40:09", "text": "了解他们的动态之类的一切"}, {"type": "subtitle", "time": 2411.19, "timestamp": "00:40:11", "text": "规则，哪些事允许，哪些事不允许。"}, {"type": "subtitle", "time": 2412.71, "timestamp": "00:40:12", "text": "允许"}, {"type": "subtitle", "time": 2414.19, "timestamp": "00:40:14", "text": "呃，所有这些"}, {"type": "subtitle", "time": 2417.19, "timestamp": "00:40:17", "text": "东西，所有的一切。是的，我仍然"}, {"type": "subtitle", "time": 2421.51, "timestamp": "00:40:21", "text": "记住这一点。我以前有这个……VC"}, {"type": "subtitle", "time": 2425.51, "timestamp": "00:40:25", "text": "呃，就像之前合作那样，呃，就像呃"}, {"type": "subtitle", "time": 2430.23, "timestamp": "00:40:30", "text": "就像第一次聊天聚会那样"}, {"type": "subtitle", "time": 2432.23, "timestamp": "00:40:32", "text": "我们努力互相了解，"}, {"type": "subtitle", "time": 2435.829, "timestamp": "00:40:35", "text": "东西。我们试着玩了一个类似我这样的游戏。"}, {"type": "subtitle", "time": 2439.39, "timestamp": "00:40:39", "text": "第一次真正体验到这一点是"}, {"type": "subtitle", "time": 2443.91, "timestamp": "00:40:43", "text": "维克多就像我们玩的那样，我们觉得"}, {"type": "subtitle", "time": 2446.71, "timestamp": "00:40:46", "text": "原本应该是1小时30分钟或"}, {"type": "subtitle", "time": 2449.63, "timestamp": "00:40:49", "text": "只是打个30分钟的电话而已。"}, {"type": "subtitle", "time": 2452.87, "timestamp": "00:40:52", "text": "但我们聊得越多，我觉得我们"}, {"type": "subtitle", "time": 2454.95, "timestamp": "00:40:54", "text": "感觉就像一场精彩的互动"}, {"type": "subtitle", "time": 2458.39, "timestamp": "00:40:58", "text": "我问及艾玛·巴洛特的对话"}]
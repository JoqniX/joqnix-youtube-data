[{"type": "subtitle", "time": 784.47, "timestamp": "00:13:04", "text": "但这有点粗鲁，是的，但是……"}, {"type": "subtitle", "time": 787.949, "timestamp": "00:13:07", "text": "感觉这一切都是我的错。是吗？"}, {"type": "subtitle", "time": 791.91, "timestamp": "00:13:11", "text": "为什么？不，我这就告诉你你为什么这么想。"}, {"type": "subtitle", "time": 795.069, "timestamp": "00:13:15", "text": "就是这样。这是因为"}, {"type": "chat", "time": 797.538, "timestamp": "00:13:17", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "after I mentioned that, it's been a daily thing you worry constantly"}, {"type": "subtitle", "time": 798.389, "timestamp": "00:13:18", "text": "嗯，我觉得是因为不，呃……"}, {"type": "subtitle", "time": 801.15, "timestamp": "00:13:21", "text": "你选择在什么时间说这句话"}, {"type": "subtitle", "time": 807.99, "timestamp": "00:13:27", "text": "那是在我提到这是每天都会发生的事之后。"}, {"type": "subtitle", "time": 811.71, "timestamp": "00:13:31", "text": "你总是忧心忡忡。不，更像是"}, {"type": "subtitle", "time": 816.509, "timestamp": "00:13:36", "text": "呃，我会告诉你，就其含义而言，它是"}, {"type": "subtitle", "time": 819.67, "timestamp": "00:13:39", "text": "就像你选择做这件事的那天一样"}, {"type": "subtitle", "time": 821.91, "timestamp": "00:13:41", "text": "我选择真正迈出那一步的那一天"}, {"type": "subtitle", "time": 825.43, "timestamp": "00:13:45", "text": "走得更远，更有自信，也更"}, {"type": "subtitle", "time": 828.55, "timestamp": "00:13:48", "text": "坦诚面对自己，就像个运动健将一样。"}, {"type": "subtitle", "time": 831.269, "timestamp": "00:13:51", "text": "别当胆小鬼，你能行的！"}, {"type": "subtitle", "time": 833.829, "timestamp": "00:13:53", "text": "就像你一直在做这件事一样"}, {"type": "subtitle", "time": 837.43, "timestamp": "00:13:57", "text": "过一段时间，试着联系"}, {"type": "subtitle", "time": 839.35, "timestamp": "00:13:59", "text": "你之前联系过的人"}]
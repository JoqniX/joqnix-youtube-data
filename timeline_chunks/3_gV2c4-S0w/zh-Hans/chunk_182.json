[{"type": "subtitle", "time": 10928.11, "timestamp": "03:02:08", "text": "人们。我的意思是，呃……"}, {"type": "subtitle", "time": 10930.87, "timestamp": "03:02:10", "text": "探索探索探索探索。哇。"}, {"type": "subtitle", "time": 10934.269, "timestamp": "03:02:14", "text": "是时候杀人了。我懂了"}, {"type": "subtitle", "time": 10936.95, "timestamp": "03:02:16", "text": "这份工作会害死人。我已经有三个了。"}, {"type": "subtitle", "time": 10950.469, "timestamp": "03:02:30", "text": "含有大豆。哦，我的游戏好像崩溃了。"}, {"type": "subtitle", "time": 10958.19, "timestamp": "03:02:38", "text": "地图，世界地图"}, {"type": "subtitle", "time": 10961.59, "timestamp": "03:02:41", "text": "我是否已退出服务器？我是否仍在服务器中？"}, {"type": "subtitle", "time": 10963.269, "timestamp": "03:02:43", "text": "还在吗？"}, {"type": "subtitle", "time": 10966.309, "timestamp": "03:02:46", "text": "加入服务器。好的。"}, {"type": "subtitle", "time": 10968.95, "timestamp": "03:02:48", "text": "等等，截图的快捷键是什么？"}, {"type": "subtitle", "time": 10972.55, "timestamp": "03:02:52", "text": "它没有截屏。我相信。"}]
[{"type": "subtitle", "time": 17041.788, "timestamp": "04:44:01", "text": "我的方法"}, {"type": "subtitle", "time": 17051.47, "timestamp": "04:44:11", "text": "嗯，某种程度上来说。"}, {"type": "subtitle", "time": 17054.868, "timestamp": "04:44:14", "text": "嗯，他们感觉像什么来着？"}, {"type": "subtitle", "time": 17057.91, "timestamp": "04:44:17", "text": "这种方法有点像是为了得到他们的"}, {"type": "subtitle", "time": 17060.43, "timestamp": "04:44:20", "text": "查看愿望和"}, {"type": "subtitle", "time": 17062.27, "timestamp": "04:44:22", "text": "东西和"}, {"type": "subtitle", "time": 17065.11, "timestamp": "04:44:25", "text": "就像你得到的一切，你得到我所得到的。"}, {"type": "subtitle", "time": 17067.43, "timestamp": "04:44:27", "text": "呃，现在他们把它看作是一个"}, {"type": "subtitle", "time": 17069.91, "timestamp": "04:44:29", "text": "交易型方法，而不是"}, {"type": "subtitle", "time": 17071.01, "timestamp": "04:44:31", "text": "真正的联系"}, {"type": "subtitle", "time": 17076.11, "timestamp": "04:44:36", "text": "我不明白"}, {"type": "subtitle", "time": 17079.19, "timestamp": "04:44:39", "text": "当时我只是问了一下，就像"}, {"type": "subtitle", "time": 17081.11, "timestamp": "04:44:41", "text": "我不知道它是不是像……"}, {"type": "subtitle", "time": 17083.91, "timestamp": "04:44:43", "text": "日本人，嗯，因为他们只会说"}, {"type": "subtitle", "time": 17086.39, "timestamp": "04:44:46", "text": "日语是日语，不会说英语。他们确实如此"}, {"type": "subtitle", "time": 17089.55, "timestamp": "04:44:49", "text": "有喜欢"}, {"type": "subtitle", "time": 17093.67, "timestamp": "04:44:53", "text": "嗯，是的，即使我有点……"}, {"type": "subtitle", "time": 17096.19, "timestamp": "04:44:56", "text": "他们使用了翻译人员，"}, {"type": "subtitle", "time": 17099.03, "timestamp": "04:44:59", "text": "使用更深层次的东西和要发送的东西"}]
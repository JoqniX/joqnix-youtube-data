[{"type": "subtitle", "time": 1871.95, "timestamp": "00:31:11", "text": "[音乐]"}, {"type": "subtitle", "time": 1876.149, "timestamp": "00:31:16", "text": "呃，做三件事。呃，一个是胸部"}, {"type": "subtitle", "time": 1878.59, "timestamp": "00:31:18", "text": "就是胸前的那个东西。我加了弓"}, {"type": "subtitle", "time": 1883.149, "timestamp": "00:31:23", "text": "胸部。嗯，还有"}, {"type": "subtitle", "time": 1891.909, "timestamp": "00:31:31", "text": "呃，弓箭、胸甲和那个加热器之类的东西。"}, {"type": "subtitle", "time": 1896.23, "timestamp": "00:31:36", "text": "三件事。我希望你放一些"}, {"type": "subtitle", "time": 1899.35, "timestamp": "00:31:39", "text": "农作物之类的东西。种植一些作物或"}, {"type": "subtitle", "time": 1901.59, "timestamp": "00:31:41", "text": "闻到某种东西或气味"}, {"type": "subtitle", "time": 1904.549, "timestamp": "00:31:44", "text": "某物。而且你必须走得很远。"}, {"type": "subtitle", "time": 1909.11, "timestamp": "00:31:49", "text": "远远地看看，如果……嗯，那样的话"}, {"type": "subtitle", "time": 1911.99, "timestamp": "00:31:51", "text": "完成冶炼或种植"}, {"type": "subtitle", "time": 1915.75, "timestamp": "00:31:55", "text": "农作物之类的东西。非常远，就像很远的地方。"}, {"type": "subtitle", "time": 1918.31, "timestamp": "00:31:58", "text": "离这很远。非常远。模拟"}]
[{"type": "subtitle", "time": 1981.789, "timestamp": "00:33:01", "text": "[音乐]"}, {"type": "subtitle", "time": 1985.75, "timestamp": "00:33:05", "text": "嗯，看看你的庄稼长得怎么样。"}, {"type": "subtitle", "time": 1988.47, "timestamp": "00:33:08", "text": "生长。在……度过3、4天晚上"}, {"type": "subtitle", "time": 1990.43, "timestamp": "00:33:10", "text": "远在天边。跳过时间或"}, {"type": "subtitle", "time": 1993.59, "timestamp": "00:33:13", "text": "种点什么，看看能不能结果或生长。"}, {"type": "subtitle", "time": 1995.669, "timestamp": "00:33:15", "text": "或者别的什么。那是我添加的模式。"}, {"type": "subtitle", "time": 1998.71, "timestamp": "00:33:18", "text": "它仍然会喜欢表面上的样子"}, {"type": "subtitle", "time": 2001.75, "timestamp": "00:33:21", "text": "Minecraft 阻止了生长"}, {"type": "chat", "time": 2003.105, "timestamp": "00:33:23", "author": "@astravt", "avatar": "https://yt4.ggpht.com/MdOwC7qdh0gmlabcCYgLQ5BOZxo7CGLbc14xFv1rO9eQ745gkga99YKsszwMjcyNnEBittX8WA=s64-c-k-c0x00ffffff-no-rj", "message": "okay I'll just learn some spells and then I'll do that"}, {"type": "subtitle", "time": 2003.58, "timestamp": "00:33:23", "text": "植物或"}, {"type": "subtitle", "time": 2004.75, "timestamp": "00:33:24", "text": "[音乐]"}, {"type": "subtitle", "time": 2008.149, "timestamp": "00:33:28", "text": "呃，炉子之类的东西等等。如果你是"}, {"type": "subtitle", "time": 2010.47, "timestamp": "00:33:30", "text": "离开模拟区域"}, {"type": "subtitle", "time": 2011.47, "timestamp": "00:33:31", "text": "或一些"}, {"type": "subtitle", "time": 2016.149, "timestamp": "00:33:36", "text": "任何。嗯，是的，就像你来的时候"}, {"type": "subtitle", "time": 2019.669, "timestamp": "00:33:39", "text": "结束漫长的探险或旅行回到家"}, {"type": "subtitle", "time": 2022.789, "timestamp": "00:33:42", "text": "嗯，那个东西，然后你就能看到它会"}, {"type": "subtitle", "time": 2024.149, "timestamp": "00:33:44", "text": "就像会被暂停一样。它不是"}, {"type": "subtitle", "time": 2027.549, "timestamp": "00:33:47", "text": "通常情况下，11 时会暂停，但这次"}, {"type": "subtitle", "time": 2030.95, "timestamp": "00:33:50", "text": "modu 仍然假装你是"}, {"type": "subtitle", "time": 2034.23, "timestamp": "00:33:54", "text": "附近有活着的、活跃的人。"}, {"type": "subtitle", "time": 2037.509, "timestamp": "00:33:57", "text": "模拟区域，并且会持续进行"}]
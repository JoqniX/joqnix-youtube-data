[{"type": "subtitle", "time": 19383.43, "timestamp": "05:23:03", "text": "呃，处理这件事的时候，我别无选择，但是"}, {"type": "subtitle", "time": 19387.51, "timestamp": "05:23:07", "text": "有点像依靠……"}, {"type": "subtitle", "time": 19389.59, "timestamp": "05:23:09", "text": "如果他们真的愿意的话，社区会……"}, {"type": "subtitle", "time": 19392.31, "timestamp": "05:23:12", "text": "支持等等。我不是"}, {"type": "subtitle", "time": 19394.58, "timestamp": "05:23:14", "text": "强迫任何人"}, {"type": "subtitle", "time": 19396.43, "timestamp": "05:23:16", "text": "[音乐]"}, {"type": "subtitle", "time": 19400.15, "timestamp": "05:23:20", "text": "嗯嗯，是的，我没有强迫任何人。"}, {"type": "subtitle", "time": 19402.15, "timestamp": "05:23:22", "text": "比如捐赠给任何东西。我完全"}, {"type": "subtitle", "time": 19406.07, "timestamp": "05:23:26", "text": "没问题。是啊。所以，呃，所以我们"}, {"type": "subtitle", "time": 19408.868, "timestamp": "05:23:28", "text": "这次 Joathon 活动不仅仅是为了喜欢"}, {"type": "subtitle", "time": 19412.15, "timestamp": "05:23:32", "text": "筹集模型及其他所需资金"}, {"type": "subtitle", "time": 19415.67, "timestamp": "05:23:35", "text": "但也是为了我自己能够不断进步。"}, {"type": "subtitle", "time": 19418.628, "timestamp": "05:23:38", "text": "修剪器，就像新款一样。艺术是"}, {"type": "subtitle", "time": 19421.75, "timestamp": "05:23:41", "text": "好了，我只需要付钱就行了，是的，我"}, {"type": "subtitle", "time": 19424.39, "timestamp": "05:23:44", "text": "需要支付模型授权费。是的。"}, {"type": "subtitle", "time": 19427.35, "timestamp": "05:23:47", "text": "还有索具和其他所有东西。"}, {"type": "subtitle", "time": 19429.628, "timestamp": "05:23:49", "text": "嗯，所以这更像是我的正式身份。"}, {"type": "subtitle", "time": 19432.39, "timestamp": "05:23:52", "text": "模特，而且是个非常漂亮的模特。我"}, {"type": "subtitle", "time": 19434.31, "timestamp": "05:23:54", "text": "与艺术家们一起努力创作"}, {"type": "subtitle", "time": 19436.788, "timestamp": "05:23:56", "text": "更原创、更漂亮，一切都更完美"}, {"type": "subtitle", "time": 19439.75, "timestamp": "05:23:59", "text": "我非常喜欢它，我想把它带回家。"}]
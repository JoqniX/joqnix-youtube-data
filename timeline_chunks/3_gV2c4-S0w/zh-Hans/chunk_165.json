[{"type": "subtitle", "time": 9902.71, "timestamp": "02:45:02", "text": "睡觉是人类的事情。是啊，你"}, {"type": "subtitle", "time": 9905.75, "timestamp": "02:45:05", "text": "男生应该只在开玩笑的时候这么说。"}, {"type": "subtitle", "time": 9907.75, "timestamp": "02:45:07", "text": "他活了下来。"}, {"type": "subtitle", "time": 9910.23, "timestamp": "02:45:10", "text": "这种情况一直持续到昨晚。是的，我没有。"}, {"type": "subtitle", "time": 9913.11, "timestamp": "02:45:13", "text": "节省。"}, {"type": "subtitle", "time": 9915.99, "timestamp": "02:45:15", "text": "他每天只睡3个小时。如何"}, {"type": "subtitle", "time": 9921.11, "timestamp": "02:45:21", "text": "凉爽的。我当时就想，我真的很想找到"}, {"type": "subtitle", "time": 9924.79, "timestamp": "02:45:24", "text": "良好的模式，这样我们大家都能享受。所以，我"}, {"type": "subtitle", "time": 9927.99, "timestamp": "02:45:27", "text": "看来我在这里创造了一个文明。"}, {"type": "subtitle", "time": 9929.51, "timestamp": "02:45:29", "text": "文明？"}, {"type": "subtitle", "time": 9931.269, "timestamp": "02:45:31", "text": "是的，我创造了自己的文明。"}, {"type": "subtitle", "time": 9933.51, "timestamp": "02:45:33", "text": "准备好观看了吗？"}, {"type": "subtitle", "time": 9936.15, "timestamp": "02:45:36", "text": "是的，我已经准备好了。我想说"}, {"type": "subtitle", "time": 9941.67, "timestamp": "02:45:41", "text": "我的天啊。"}, {"type": "subtitle", "time": 9944.389, "timestamp": "02:45:44", "text": "[音乐]"}, {"type": "chat", "time": 9944.961, "timestamp": "02:45:44", "author": "@tengenUzui_flashy1", "avatar": "https://yt4.ggpht.com/U4bubkmDa5_iTX7UhU8yE4NYF3WqbD1yjlX5vpRZK99vtN8boUL9ZV-pbM8qJhCV69RI6ILr=s64-c-k-c0x00ffffff-no-rj", "message": "@Sasta Chamgadar"}, {"type": "subtitle", "time": 9947.03, "timestamp": "02:45:47", "text": "我该怎么办？我的天啊。我该怎么办？我"}, {"type": "subtitle", "time": 9949.429, "timestamp": "02:45:49", "text": "想要"}, {"type": "subtitle", "time": 9953.83, "timestamp": "02:45:53", "text": "到我这里来。你确定吗？"}, {"type": "chat", "time": 9955.507, "timestamp": "02:45:55", "author": "@redx7454", "avatar": "https://yt4.ggpht.com/ZnCeavb1XjhCUyF0gPZf2zqHWkwDjnzleyD1oxpd-9re-emmqNet6n-8w_OiHe_rvcNpzZPLgw=s64-c-k-c0x00ffffff-no-rj", "message": "saii aagaya?"}, {"type": "subtitle", "time": 9955.51, "timestamp": "02:45:55", "text": "你知道吗？不，你，你"}, {"type": "subtitle", "time": 9957.75, "timestamp": "02:45:57", "text": "等待。让我给她看看。是的。是的。"}]
[{"type": "subtitle", "time": 3240.75, "timestamp": "00:54:00", "text": "Discord客户端和"}, {"type": "subtitle", "time": 3244.109, "timestamp": "00:54:04", "text": "什么都不知道，因为我也不知道。我感觉"}, {"type": "subtitle", "time": 3247.51, "timestamp": "00:54:07", "text": "就像我内心深处的感觉一样"}, {"type": "subtitle", "time": 3250.71, "timestamp": "00:54:10", "text": "感觉就像，是啊，没人会去做这件事。"}, {"type": "subtitle", "time": 3253.19, "timestamp": "00:54:13", "text": "为什么我不做呢？因为我想帮忙。我"}, {"type": "subtitle", "time": 3256.23, "timestamp": "00:54:16", "text": "我想成为……我想感受到自己有所贡献。"}, {"type": "subtitle", "time": 3258.309, "timestamp": "00:54:18", "text": "不，我希望自己能为此做出贡献。"}, {"type": "subtitle", "time": 3261.109, "timestamp": "00:54:21", "text": "合作。并非只有一个人"}, {"type": "subtitle", "time": 3263.829, "timestamp": "00:54:23", "text": "这样做，结果就会是这样，或者"}, {"type": "subtitle", "time": 3266.15, "timestamp": "00:54:26", "text": "这个那个。我想成为其中的一员"}, {"type": "subtitle", "time": 3268.549, "timestamp": "00:54:28", "text": "这。不，这是团队合作的成果。这是一个"}, {"type": "subtitle", "time": 3277.349, "timestamp": "00:54:37", "text": "是的，我也是这么想的。"}, {"type": "subtitle", "time": 3280.43, "timestamp": "00:54:40", "text": "说到团队合作之类的事情"}, {"type": "subtitle", "time": 3285.91, "timestamp": "00:54:45", "text": "因为，是的，我倾向于那样做。我"}, {"type": "subtitle", "time": 3288.069, "timestamp": "00:54:48", "text": "不知道。即使我不需要"}, {"type": "subtitle", "time": 3293.63, "timestamp": "00:54:53", "text": "我越界了，诸如此类，"}, {"type": "subtitle", "time": 3296.23, "timestamp": "00:54:56", "text": "但我的意思是，大多数时候我这样做的时候……"}, {"type": "subtitle", "time": 3298.03, "timestamp": "00:54:58", "text": "当时，没有人说话。"}]
[{"type": "subtitle", "time": 5162.55, "timestamp": "01:26:02", "text": "他们遭受痛苦，最终死去。窒息而死。"}, {"type": "subtitle", "time": 5165.95, "timestamp": "01:26:05", "text": "我的天啊。那将是"}, {"type": "subtitle", "time": 5181.43, "timestamp": "01:26:21", "text": "[音乐]"}, {"type": "subtitle", "time": 5186.87, "timestamp": "01:26:26", "text": "呼吸。能听见的Minecraft模组"}, {"type": "subtitle", "time": 5198.83, "timestamp": "01:26:38", "text": "这？是的。我和我的朋友们"}, {"type": "subtitle", "time": 5206.79, "timestamp": "01:26:46", "text": "这？他们不。好的。总之，我当时"}, {"type": "subtitle", "time": 5210.01, "timestamp": "01:26:50", "text": "寻找水下"}]
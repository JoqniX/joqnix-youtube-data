[{"type": "subtitle", "time": 609.19, "timestamp": "00:10:09", "text": "就像，但我意识到，是的。就像艾什那样"}, {"type": "subtitle", "time": 611.31, "timestamp": "00:10:11", "text": "看法"}, {"type": "subtitle", "time": 614.19, "timestamp": "00:10:14", "text": "这有点像"}, {"type": "subtitle", "time": 617.509, "timestamp": "00:10:17", "text": "疯狂的。不仅仅是有很多"}, {"type": "subtitle", "time": 620.35, "timestamp": "00:10:20", "text": "重要的事情。现在是"}, {"type": "subtitle", "time": 622.19, "timestamp": "00:10:22", "text": "氛围，"}, {"type": "subtitle", "time": 626.43, "timestamp": "00:10:26", "text": "能量，"}, {"type": "subtitle", "time": 629.75, "timestamp": "00:10:29", "text": "踱步。我正在慢慢学习这一切。"}, {"type": "subtitle", "time": 632.67, "timestamp": "00:10:32", "text": "所以我现在感觉像是在问双重问题。"}, {"type": "subtitle", "time": 634.35, "timestamp": "00:10:34", "text": "我"}, {"type": "subtitle", "time": 637.11, "timestamp": "00:10:37", "text": "实际上。哦等等，那所有的……呢？"}, {"type": "subtitle", "time": 639.99, "timestamp": "00:10:39", "text": "到目前为止，我完成的拼贴画"}, {"type": "subtitle", "time": 642.23, "timestamp": "00:10:42", "text": "我走过的路？"}, {"type": "subtitle", "time": 645.389, "timestamp": "00:10:45", "text": "其他人也会这样做吗？"}, {"type": "subtitle", "time": 650.79, "timestamp": "00:10:50", "text": "呃，他们喜欢吗？还是什么？他们不喜欢？"}, {"type": "subtitle", "time": 653.75, "timestamp": "00:10:53", "text": "好好享受？差不多是这样。那是"}]
[{"type": "subtitle", "time": 18480.43, "timestamp": "05:08:00", "text": "合作，其中提到了哪个"}, {"type": "subtitle", "time": 18483.75, "timestamp": "05:08:03", "text": "他们的英语水平较弱。所以主要是"}, {"type": "subtitle", "time": 18485.35, "timestamp": "05:08:05", "text": "日语和韩语。所以我不知道"}, {"type": "subtitle", "time": 18487.59, "timestamp": "05:08:07", "text": "韩国人。所以我必须和他们好好谈谈。"}, {"type": "subtitle", "time": 18488.67, "timestamp": "05:08:08", "text": "在"}, {"type": "subtitle", "time": 18492.07, "timestamp": "05:08:12", "text": "日语（不流利的日语）然后我"}, {"type": "subtitle", "time": 18494.27, "timestamp": "05:08:14", "text": "实际"}, {"type": "subtitle", "time": 18497.83, "timestamp": "05:08:17", "text": "虽然是日本合作项目，但他们懂英语。"}, {"type": "subtitle", "time": 18501.39, "timestamp": "05:08:21", "text": "证明我能以某种方式生存下去"}, {"type": "subtitle", "time": 18505.51, "timestamp": "05:08:25", "text": "破碎的，破碎的，呃，日语和一点"}, {"type": "subtitle", "time": 18507.83, "timestamp": "05:08:27", "text": "偶尔会说一点英语。是的，"}, {"type": "subtitle", "time": 18509.15, "timestamp": "05:08:29", "text": "但是哦"}, {"type": "subtitle", "time": 18518.31, "timestamp": "05:08:38", "text": "不，我必须联系对方。"}, {"type": "subtitle", "time": 18520.948, "timestamp": "05:08:40", "text": "人。 Apex联动怎么了？"}, {"type": "subtitle", "time": 18522.868, "timestamp": "05:08:42", "text": "我们之前计划过吗？他们简直太棒了"}, {"type": "subtitle", "time": 18524.948, "timestamp": "05:08:44", "text": "虽然很忙。"}, {"type": "subtitle", "time": 18527.39, "timestamp": "05:08:47", "text": "那个日本油管博主简直太厉害了"}, {"type": "subtitle", "time": 18535.11, "timestamp": "05:08:55", "text": "锦标赛。是的。现在全科医生们。哦，我的天"}, {"type": "subtitle", "time": 18537.11, "timestamp": "05:08:57", "text": "上帝。他们参加了很多当地的活动"}]
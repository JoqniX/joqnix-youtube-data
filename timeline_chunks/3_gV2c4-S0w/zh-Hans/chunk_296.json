[{"type": "subtitle", "time": 17761.83, "timestamp": "04:56:01", "text": "艰难的方式，而不是像我这样轻松的方式"}, {"type": "subtitle", "time": 17763.43, "timestamp": "04:56:03", "text": "上网就像……嗯，就是这样。"}, {"type": "subtitle", "time": 17765.948, "timestamp": "04:56:05", "text": "在这些方面存在分歧"}, {"type": "subtitle", "time": 17768.628, "timestamp": "04:56:08", "text": "那里有熟人，那里有"}, {"type": "subtitle", "time": 17770.868, "timestamp": "04:56:10", "text": "亲密的朋友里也有最好的朋友。"}, {"type": "subtitle", "time": 17774.99, "timestamp": "04:56:14", "text": "有很多好朋友的毛绒玩具"}, {"type": "subtitle", "time": 17779.19, "timestamp": "04:56:19", "text": "现在有很多事情，但是，是的，比如"}, {"type": "subtitle", "time": 17782.15, "timestamp": "04:56:22", "text": "嗯，回到刚才的话题，我想是的。"}, {"type": "subtitle", "time": 17786.39, "timestamp": "04:56:26", "text": "我抓住了机会，结果有点出乎意料。"}, {"type": "subtitle", "time": 17787.55, "timestamp": "04:56:27", "text": "我兄弟"}, {"type": "subtitle", "time": 17791.708, "timestamp": "04:56:31", "text": "真的让我很震惊。"}, {"type": "subtitle", "time": 17796.31, "timestamp": "04:56:36", "text": "嗯，因为，是的，我没想到会这样。"}, {"type": "subtitle", "time": 17799.27, "timestamp": "04:56:39", "text": "我把这个故事分享给了另一个人。"}, {"type": "subtitle", "time": 17801.43, "timestamp": "04:56:41", "text": "我应该和一位日本 YouTuber 合作"}, {"type": "subtitle", "time": 17802.27, "timestamp": "04:56:42", "text": "这"}, {"type": "subtitle", "time": 17804.948, "timestamp": "04:56:44", "text": "就像我想知道他们一个月前的情况一样"}, {"type": "subtitle", "time": 17807.23, "timestamp": "04:56:47", "text": "接受。他们如何看待"}, {"type": "subtitle", "time": 17809.43, "timestamp": "04:56:49", "text": "合作？他们是否将其视为一种"}, {"type": "subtitle", "time": 17812.11, "timestamp": "04:56:52", "text": "交易方法或像一个真正的"}, {"type": "subtitle", "time": 17814.708, "timestamp": "04:56:54", "text": "他们采取了真诚的态度。"}, {"type": "subtitle", "time": 17816.708, "timestamp": "04:56:56", "text": "想真正与这个人建立联系"}]
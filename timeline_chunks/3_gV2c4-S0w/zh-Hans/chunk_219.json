[{"type": "subtitle", "time": 13159.87, "timestamp": "03:39:19", "text": "很多。明天我们有……哦，等等。"}, {"type": "subtitle", "time": 13164.07, "timestamp": "03:39:24", "text": "我需要把它写下来，是谁？"}, {"type": "subtitle", "time": 13167.19, "timestamp": "03:39:27", "text": "我正在和他们一起制定计划。全部"}, {"type": "subtitle", "time": 13168.429, "timestamp": "03:39:28", "text": "合作是"}, {"type": "subtitle", "time": 13171.51, "timestamp": "03:39:31", "text": "那里？我的天哪。当你……的时候，这很难。"}, {"type": "subtitle", "time": 13174.63, "timestamp": "03:39:34", "text": "所有事情都由你自己处理。"}, {"type": "subtitle", "time": 13178.19, "timestamp": "03:39:38", "text": "你根据你的行动来调整一切"}, {"type": "subtitle", "time": 13180.95, "timestamp": "03:39:40", "text": "记忆。好的，我想我会把“快速”放在首位。"}, {"type": "subtitle", "time": 13182.55, "timestamp": "03:39:42", "text": "如果明天有恐鬼症"}, {"type": "subtitle", "time": 13188.63, "timestamp": "03:39:48", "text": "嗯，很快，因为他为什么告诉我"}, {"type": "subtitle", "time": 13191.429, "timestamp": "03:39:51", "text": "今天就下载注册员吗？那么或许"}, {"type": "subtitle", "time": 13194.87, "timestamp": "03:39:54", "text": "你可能会让我做，好的。所以我会"}, {"type": "subtitle", "time": 13196.67, "timestamp": "03:39:56", "text": "把它们两个都留下。"}, {"type": "subtitle", "time": 13199.429, "timestamp": "03:39:59", "text": "已安装。我得查一下是否已入伍"}]
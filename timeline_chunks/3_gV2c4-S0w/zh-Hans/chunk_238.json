[{"type": "subtitle", "time": 14287.95, "timestamp": "03:58:07", "text": "邮政。感谢您观看我的这张照片"}, {"type": "subtitle", "time": 14299.91, "timestamp": "03:58:19", "text": "你好。哦，等等。咖啡馆游戏。啊，我告诉过"}, {"type": "subtitle", "time": 14304.55, "timestamp": "03:58:24", "text": "我将进行beta测试。 O 到"}, {"type": "subtitle", "time": 14306.71, "timestamp": "03:58:26", "text": "我的天哪。明天。无论如何，我都会"}, {"type": "subtitle", "time": 14308.83, "timestamp": "03:58:28", "text": "必须玩那个游戏。哦"}, {"type": "subtitle", "time": 14311.79, "timestamp": "03:58:31", "text": "上帝。"}, {"type": "subtitle", "time": 14314.71, "timestamp": "03:58:34", "text": "呃，我总是忘记这件事。"}, {"type": "subtitle", "time": 14326.87, "timestamp": "03:58:46", "text": "面对这一切，我感到迷茫。"}, {"type": "subtitle", "time": 14330.429, "timestamp": "03:58:50", "text": "事物。嗯，这很难……"}, {"type": "subtitle", "time": 14334.229, "timestamp": "03:58:54", "text": "就像很难理解你所有的事情"}, {"type": "subtitle", "time": 14337.229, "timestamp": "03:58:57", "text": "这些东西。嗯，对。我以为你"}]
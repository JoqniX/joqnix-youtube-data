[{"type": "subtitle", "time": 16142.87, "timestamp": "04:29:02", "text": "好的。我应该和他一起计划点什么。"}, {"type": "subtitle", "time": 16144.67, "timestamp": "04:29:04", "text": "作为"}, {"type": "subtitle", "time": 16148.55, "timestamp": "04:29:08", "text": "出色地。因为已经过去很久了，伙计。它是"}, {"type": "subtitle", "time": 16157.75, "timestamp": "04:29:17", "text": "旋转。天哪，好像有好多呢。"}, {"type": "subtitle", "time": 16160.149, "timestamp": "04:29:20", "text": "我想联系和重新联系的人"}, {"type": "subtitle", "time": 16163.67, "timestamp": "04:29:23", "text": "并且喜欢一起做某事，但是"}, {"type": "subtitle", "time": 16168.149, "timestamp": "04:29:28", "text": "感觉就像，不，我的时间有限。"}, {"type": "subtitle", "time": 16169.71, "timestamp": "04:29:29", "text": "我只有几个。"}, {"type": "subtitle", "time": 16172.71, "timestamp": "04:29:32", "text": "几天过去了，我觉得自己可能无法……"}, {"type": "subtitle", "time": 16176.389, "timestamp": "04:29:36", "text": "把所有人都叫来。也不是每个人都享有自由。"}]
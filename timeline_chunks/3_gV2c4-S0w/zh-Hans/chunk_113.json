[{"type": "subtitle", "time": 6782.55, "timestamp": "01:53:02", "text": "具体来说，这个模块是如何工作的。然后你"}, {"type": "subtitle", "time": 6786.39, "timestamp": "01:53:06", "text": "需要弄清楚它的作用。"}, {"type": "subtitle", "time": 6788.55, "timestamp": "01:53:08", "text": "太多了。想想你做了多少工作"}, {"type": "subtitle", "time": 6791.91, "timestamp": "01:53:11", "text": "需要用机械方式完成。我将成为"}, {"type": "subtitle", "time": 6793.79, "timestamp": "01:53:13", "text": "托尼。"}, {"type": "subtitle", "time": 6795.83, "timestamp": "01:53:15", "text": "[音乐]"}, {"type": "subtitle", "time": 6803.91, "timestamp": "01:53:23", "text": "我的天哪。我非常想补充一点："}, {"type": "subtitle", "time": 6812.31, "timestamp": "01:53:32", "text": "没有。是的，有个超级英雄模组"}, {"type": "subtitle", "time": 6815.189, "timestamp": "01:53:35", "text": "这太酷了。好的。好的。你"}, {"type": "subtitle", "time": 6817.51, "timestamp": "01:53:37", "text": "我知道了，好的。所以，我来告诉你符文是如何运作的。"}, {"type": "subtitle", "time": 6819.95, "timestamp": "01:53:39", "text": "确实发生了分娩。"}, {"type": "subtitle", "time": 6822.79, "timestamp": "01:53:42", "text": "所以，我当时想创建一个社区。"}, {"type": "subtitle", "time": 6824.629, "timestamp": "01:53:44", "text": "事件。好的。就像我想进去一样"}, {"type": "subtitle", "time": 6826.55, "timestamp": "01:53:46", "text": "与我的 Discord 群组成员一起参加社区活动。"}, {"type": "subtitle", "time": 6829.109, "timestamp": "01:53:49", "text": "会有类似PVP的玩法，但有其独特之处。"}, {"type": "subtitle", "time": 6832.229, "timestamp": "01:53:52", "text": "我做的服务器里有超级英雄吗？"}, {"type": "subtitle", "time": 6834.629, "timestamp": "01:53:54", "text": "模组。所以每个玩家都会有机会"}, {"type": "subtitle", "time": 6837.03, "timestamp": "01:53:57", "text": "他们可以选择任何他们喜欢的超级英雄，然后他们"}, {"type": "subtitle", "time": 6839.43, "timestamp": "01:53:59", "text": "将会进行一场PVP对战。"}]
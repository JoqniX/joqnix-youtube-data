[{"type": "subtitle", "time": 2580.39, "timestamp": "00:43:00", "text": "呃，就像他们有过那种合作一样"}, {"type": "subtitle", "time": 2582.71, "timestamp": "00:43:02", "text": "禁止那玩意儿，对吧？他们只能这样做"}, {"type": "subtitle", "time": 2586.63, "timestamp": "00:43:06", "text": "每月合作一次，每次两次"}, {"type": "subtitle", "time": 2589.39, "timestamp": "00:43:09", "text": "外部合作者，呃，外部"}, {"type": "subtitle", "time": 2592.15, "timestamp": "00:43:12", "text": "YouTuber之类的。很多事情"}, {"type": "subtitle", "time": 2592.91, "timestamp": "00:43:12", "text": "喜欢"}, {"type": "subtitle", "time": 2595.43, "timestamp": "00:43:15", "text": "那。所以，学习是件好事。哦，"}, {"type": "subtitle", "time": 2597.51, "timestamp": "00:43:17", "text": "是的。类似的东西就在那里。"}, {"type": "subtitle", "time": 2599.75, "timestamp": "00:43:19", "text": "公司级别。这有点像"}, {"type": "subtitle", "time": 2602.47, "timestamp": "00:43:22", "text": "等等。你应该如何表现，你"}, {"type": "subtitle", "time": 2604.47, "timestamp": "00:43:24", "text": "你应该如何展现自己"}, {"type": "subtitle", "time": 2607.27, "timestamp": "00:43:27", "text": "展现自我等等。这就像一个好的"}, {"type": "subtitle", "time": 2610.91, "timestamp": "00:43:30", "text": "现在机会来了，你必须抓住它。"}, {"type": "subtitle", "time": 2614.15, "timestamp": "00:43:34", "text": "记住，我们这个社区……"}, {"type": "subtitle", "time": 2617.589, "timestamp": "00:43:37", "text": "现在并非所有IM2社区的成员都在这里。"}, {"type": "subtitle", "time": 2619.589, "timestamp": "00:43:39", "text": "并非每个人都喜欢，即使是企业也不喜欢。"}, {"type": "subtitle", "time": 2623.03, "timestamp": "00:43:43", "text": "他们也都慢慢地，就像"}, {"type": "subtitle", "time": 2627.589, "timestamp": "00:43:47", "text": "并非所有流媒体新手都如此。"}, {"type": "subtitle", "time": 2631.67, "timestamp": "00:43:51", "text": "他们当中有些人就像已经是主播一样，"}, {"type": "subtitle", "time": 2633.589, "timestamp": "00:43:53", "text": "他们转型为公司员工，这不像……"}, {"type": "subtitle", "time": 2637.43, "timestamp": "00:43:57", "text": "伊恩那边的情况是怎样的，但是"}]
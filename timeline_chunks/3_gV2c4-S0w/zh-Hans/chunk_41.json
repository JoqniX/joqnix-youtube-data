[{"type": "subtitle", "time": 2461.109, "timestamp": "00:41:01", "text": "他现在问我太多问题了"}, {"type": "subtitle", "time": 2464.23, "timestamp": "00:41:04", "text": "对我来说，我就想，哇，我真的很喜欢"}, {"type": "subtitle", "time": 2467.51, "timestamp": "00:41:07", "text": "和他聊天，然后我们一起玩了原神。"}, {"type": "subtitle", "time": 2471.589, "timestamp": "00:41:11", "text": "那天他待了两个多小时，而且他"}, {"type": "subtitle", "time": 2473.829, "timestamp": "00:41:13", "text": "告诉我，要像慢跑一样，你得……"}, {"type": "subtitle", "time": 2475.95, "timestamp": "00:41:15", "text": "达到水平"}, {"type": "subtitle", "time": 2477.47, "timestamp": "00:41:17", "text": "嗯"}, {"type": "subtitle", "time": 2481.109, "timestamp": "00:41:21", "text": "45岁，或者像4岁，像30岁，我当时是新手"}, {"type": "subtitle", "time": 2483.99, "timestamp": "00:41:23", "text": "当时在亚洲服务器上的Genchin是"}, {"type": "subtitle", "time": 2487.03, "timestamp": "00:41:27", "text": "我当时是个新手，要做很多事情。"}, {"type": "subtitle", "time": 2489.43, "timestamp": "00:41:29", "text": "只是为了合作而做的事情，而不是为了合作。"}, {"type": "subtitle", "time": 2491.75, "timestamp": "00:41:31", "text": "仅供Vick参考，也供其他YouTube用户参考"}, {"type": "subtitle", "time": 2493.589, "timestamp": "00:41:33", "text": "因为他们在亚洲服务器上。"}, {"type": "subtitle", "time": 2496.79, "timestamp": "00:41:36", "text": "原神。我当时正在欧洲旅行……"}, {"type": "subtitle", "time": 2499.55, "timestamp": "00:41:39", "text": "游戏出来了"}, {"type": "subtitle", "time": 2504.069, "timestamp": "00:41:44", "text": "第一的。是的，我做出了一个重大决定"}, {"type": "subtitle", "time": 2505.91, "timestamp": "00:41:45", "text": "切换到亚洲服务器，就是这样。"}, {"type": "subtitle", "time": 2509.55, "timestamp": "00:41:49", "text": "这是我做过的最正确的决定。和"}, {"type": "subtitle", "time": 2513.19, "timestamp": "00:41:53", "text": "是的，而且很愉快。我很喜欢"}, {"type": "subtitle", "time": 2515.829, "timestamp": "00:41:55", "text": "和第一次见面时的感觉太像了。不，"}, {"type": "subtitle", "time": 2518.71, "timestamp": "00:41:58", "text": "我们一起出去玩了。我们检查了我们妻子的情况"}]
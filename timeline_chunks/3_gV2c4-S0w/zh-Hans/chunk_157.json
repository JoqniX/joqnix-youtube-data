[{"type": "subtitle", "time": 9421.95, "timestamp": "02:37:01", "text": "他们只是想让我直播时读出来。"}, {"type": "subtitle", "time": 9426.469, "timestamp": "02:37:06", "text": "然后我想怎么处置它就怎么处置它。啊，"}, {"type": "subtitle", "time": 9428.469, "timestamp": "02:37:08", "text": "那挺好的。"}, {"type": "subtitle", "time": 9430.79, "timestamp": "02:37:10", "text": "所以，我就把它画出来吧。我试着画画"}, {"type": "subtitle", "time": 9434.57, "timestamp": "02:37:14", "text": "漫画中的一格画面。"}, {"type": "subtitle", "time": 9441.91, "timestamp": "02:37:21", "text": "阿斯卡，灯笼在哪里？哦，天哪，我"}, {"type": "subtitle", "time": 9443.309, "timestamp": "02:37:23", "text": "找不到"}, {"type": "subtitle", "time": 9447.309, "timestamp": "02:37:27", "text": "它。金库是什么？"}, {"type": "subtitle", "time": 9451.27, "timestamp": "02:37:31", "text": "好的。呃，好的。灯笼在哪里？"}, {"type": "subtitle", "time": 9454.309, "timestamp": "02:37:34", "text": "各位，我一个人在这里。"}, {"type": "subtitle", "time": 9470.63, "timestamp": "02:37:50", "text": "我没有耐心。"}]
[{"type": "subtitle", "time": 16742.99, "timestamp": "04:39:02", "text": "真正的联系"}, {"type": "subtitle", "time": 16746.99, "timestamp": "04:39:06", "text": "呃，还有一些其他的东西。你会怎么做？"}, {"type": "subtitle", "time": 16751.029, "timestamp": "04:39:11", "text": "它？要像个积极参与社交的人那样。"}, {"type": "subtitle", "time": 16754.39, "timestamp": "04:39:14", "text": "他们拥有一个社区，而且实际上"}, {"type": "subtitle", "time": 16755.99, "timestamp": "04:39:15", "text": "与他们的物品互动"}, {"type": "subtitle", "time": 16758.869, "timestamp": "04:39:18", "text": "诸如此类的事情。"}, {"type": "subtitle", "time": 16762.629, "timestamp": "04:39:22", "text": "啊，等等，主播是这样的吗？"}, {"type": "subtitle", "time": 16770.39, "timestamp": "04:39:30", "text": "尺寸？就像主播一样，规模更大"}, {"type": "subtitle", "time": 16778.91, "timestamp": "04:39:38", "text": "尺寸？"}, {"type": "subtitle", "time": 16783.19, "timestamp": "04:39:43", "text": "因为我喜欢多次出现"}, {"type": "subtitle", "time": 16784.99, "timestamp": "04:39:44", "text": "就像你看，我已经"}, {"type": "subtitle", "time": 16789.11, "timestamp": "04:39:49", "text": "看到有些人不希望别人这样做"}, {"type": "subtitle", "time": 16792.07, "timestamp": "04:39:52", "text": "就像你知道的那样，离得太近了"}, {"type": "subtitle", "time": 16798.51, "timestamp": "04:39:58", "text": "我知道，但我们仍然是朋友。你好。"}]
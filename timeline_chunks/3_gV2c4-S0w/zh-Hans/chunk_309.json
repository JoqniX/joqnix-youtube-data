[{"type": "subtitle", "time": 18540.31, "timestamp": "05:09:00", "text": "比赛啊，伙计。就像当地的德国人一样"}, {"type": "subtitle", "time": 18543.19, "timestamp": "05:09:03", "text": "提名，就像朋友的朋友一样"}, {"type": "subtitle", "time": 18544.48, "timestamp": "05:09:04", "text": "托管"}, {"type": "subtitle", "time": 18557.948, "timestamp": "05:09:17", "text": "呃，等等，你刚才在睡觉吗？"}, {"type": "subtitle", "time": 18563.39, "timestamp": "05:09:23", "text": "巴卡定制？是的，谢谢海关。"}, {"type": "subtitle", "time": 18567.59, "timestamp": "05:09:27", "text": "是的，它们就像铂金一样。他们是"}, {"type": "subtitle", "time": 18569.99, "timestamp": "05:09:29", "text": "应该是钻石，但却是铂金。"}, {"type": "subtitle", "time": 18572.55, "timestamp": "05:09:32", "text": "他们问我是什么军衔。我当时就像"}, {"type": "subtitle", "time": 18578.948, "timestamp": "05:09:38", "text": "未排名者，他们就说，嗯，是的，他们"}, {"type": "subtitle", "time": 18582.47, "timestamp": "05:09:42", "text": "就像白金一之类的，嗯"}, {"type": "subtitle", "time": 18584.868, "timestamp": "05:09:44", "text": "他们很乐意去酒吧之类的场所。"}, {"type": "subtitle", "time": 18589.07, "timestamp": "05:09:49", "text": "玩普通游戏，我都会感到很自卑"}, {"type": "subtitle", "time": 18592.23, "timestamp": "05:09:52", "text": "为了合作，我必须"}, {"type": "subtitle", "time": 18598.708, "timestamp": "05:09:58", "text": "哦，对，我还没玩新赛季呢。"}]
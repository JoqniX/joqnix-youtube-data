[{"type": "subtitle", "time": 7321.51, "timestamp": "02:02:01", "text": "不仅。"}, {"type": "subtitle", "time": 7332.07, "timestamp": "02:02:12", "text": "[音乐]"}, {"type": "subtitle", "time": 7334.55, "timestamp": "02:02:14", "text": "启动您的程序时出现问题"}, {"type": "subtitle", "time": 7337.51, "timestamp": "02:02:17", "text": "游戏。哦"}, {"type": "subtitle", "time": 7341.35, "timestamp": "02:02:21", "text": "是的，问问我，从那里把它关掉。哦，是的"}, {"type": "subtitle", "time": 7343.99, "timestamp": "02:02:23", "text": "已经在运行。好的。没关系。是吗？"}, {"type": "subtitle", "time": 7346.149, "timestamp": "02:02:26", "text": "因为我使用的是窗口模式？它是"}, {"type": "subtitle", "time": 7348.87, "timestamp": "02:02:28", "text": "完全不一样，或者说截然不同。"}, {"type": "subtitle", "time": 7350.79, "timestamp": "02:02:30", "text": "不。"}, {"type": "subtitle", "time": 7353.75, "timestamp": "02:02:33", "text": "不，通常情况下它不会导致系统崩溃，但是"}, {"type": "subtitle", "time": 7366.27, "timestamp": "02:02:46", "text": "我身处一个"}, {"type": "subtitle", "time": 7368.75, "timestamp": "02:02:48", "text": "神圣的"}, {"type": "subtitle", "time": 7375.629, "timestamp": "02:02:55", "text": "真正做我自己，并确保自己在场"}, {"type": "subtitle", "time": 7379.99, "timestamp": "02:02:59", "text": "对我来说，这是一部很有创意的电视剧。"}]
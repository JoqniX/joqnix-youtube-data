[{"type": "subtitle", "time": 6727.669, "timestamp": "01:52:07", "text": "爬行者。是的，我又掉线了。是的，我"}, {"type": "subtitle", "time": 6730.83, "timestamp": "01:52:10", "text": "我知道我必须这么做"}, {"type": "subtitle", "time": 6737.7, "timestamp": "01:52:17", "text": "再次。不，不，只剩下几个了。"}, {"type": "subtitle", "time": 6750.03, "timestamp": "01:52:30", "text": "为什么牛奶会滴落？"}, {"type": "subtitle", "time": 6768.07, "timestamp": "01:52:48", "text": "我的天啊，这里竟然藏着一个隐藏的秘密"}, {"type": "subtitle", "time": 6770.52, "timestamp": "01:52:50", "text": "地下层。"}, {"type": "subtitle", "time": 6773.27, "timestamp": "01:52:53", "text": "[音乐]"}, {"type": "subtitle", "time": 6774.87, "timestamp": "01:52:54", "text": "但是你知道，你需要付出很多努力。"}, {"type": "subtitle", "time": 6777.109, "timestamp": "01:52:57", "text": "只是为了让这一切成为可能。你"}, {"type": "subtitle", "time": 6779.99, "timestamp": "01:52:59", "text": "需要像每件事一样弄清楚所有事情"}]
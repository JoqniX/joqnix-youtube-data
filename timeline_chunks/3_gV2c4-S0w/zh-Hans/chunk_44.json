[{"type": "subtitle", "time": 2641.109, "timestamp": "00:44:01", "text": "更像是，呃，这里就像是……"}, {"type": "subtitle", "time": 2643.109, "timestamp": "00:44:03", "text": "完全陌生的人"}, {"type": "subtitle", "time": 2646.63, "timestamp": "00:44:06", "text": "初学者喜欢 OBS 和所有相关的东西"}, {"type": "subtitle", "time": 2648.91, "timestamp": "00:44:08", "text": "他们慢慢地开始"}, {"type": "subtitle", "time": 2653.43, "timestamp": "00:44:13", "text": "了解我们的管材是如何运作的，以及如何运作的"}, {"type": "subtitle", "time": 2656.069, "timestamp": "00:44:16", "text": "呃，呃，处理更大的聊天"}, {"type": "subtitle", "time": 2657.99, "timestamp": "00:44:17", "text": "以及所有的人和他们的评论"}, {"type": "subtitle", "time": 2660.15, "timestamp": "00:44:20", "text": "很多事情该如何处理。"}, {"type": "subtitle", "time": 2661.91, "timestamp": "00:44:21", "text": "现在一切都充满压力，因为之前是这样的。"}, {"type": "subtitle", "time": 2665.829, "timestamp": "00:44:25", "text": "就像第一次一样，嗯"}, {"type": "subtitle", "time": 2669.19, "timestamp": "00:44:29", "text": "这就是我们一直乘坐的方舟"}, {"type": "subtitle", "time": 2672.829, "timestamp": "00:44:32", "text": "呃，我们大多数人都是这么开始的。"}, {"type": "subtitle", "time": 2677.03, "timestamp": "00:44:37", "text": "出去是因为那时候你不会知道哦"}, {"type": "subtitle", "time": 2679.63, "timestamp": "00:44:39", "text": "我该如何做"}, {"type": "subtitle", "time": 2683.19, "timestamp": "00:44:43", "text": "合作是什么？呃，什么？什么？"}, {"type": "subtitle", "time": 2685.79, "timestamp": "00:44:45", "text": "合作中发生的"}, {"type": "subtitle", "time": 2694.63, "timestamp": "00:44:54", "text": "对，所以说到这一点时，你……"}, {"type": "subtitle", "time": 2698.15, "timestamp": "00:44:58", "text": "诸如此类的事情。有时候，嗯，它不会。"}]
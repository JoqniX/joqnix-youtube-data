[{"type": "subtitle", "time": 9199.59, "timestamp": "02:33:19", "text": "他们正在制作一个风扇"}, {"type": "subtitle", "time": 9204.55, "timestamp": "02:33:24", "text": "他们就像是混音爱好者"}, {"type": "subtitle", "time": 9211.99, "timestamp": "02:33:31", "text": "哦，你在举办粉丝比赛吗？"}, {"type": "subtitle", "time": 9213.71, "timestamp": "02:33:33", "text": "某物？"}, {"type": "subtitle", "time": 9217.51, "timestamp": "02:33:37", "text": "不，好像我不知道似的。他们只是"}, {"type": "subtitle", "time": 9219.67, "timestamp": "02:33:39", "text": "写一篇关于狂热的文章。"}, {"type": "subtitle", "time": 9223.59, "timestamp": "02:33:43", "text": "啊，所以，呃，他们会在哪里举办呢？什么"}, {"type": "subtitle", "time": 9225.67, "timestamp": "02:33:45", "text": "垫子之类的东西，或者直接放进去就行了。"}, {"type": "subtitle", "time": 9228.79, "timestamp": "02:33:48", "text": "Discord？不，不。是的，他们就这么放了。"}, {"type": "subtitle", "time": 9231.91, "timestamp": "02:33:51", "text": "当场。我在想，呃，我画画吧。"}, {"type": "subtitle", "time": 9234.15, "timestamp": "02:33:54", "text": "我想画一个漫画分镜。"}, {"type": "subtitle", "time": 9234.99, "timestamp": "02:33:54", "text": "整个"}, {"type": "subtitle", "time": 9239.309, "timestamp": "02:33:59", "text": "灵魂。我愿意做。"}]
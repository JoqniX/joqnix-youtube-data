[{"type": "subtitle", "time": 2761.069, "timestamp": "00:46:01", "text": "不，有些人喜欢看"}, {"type": "subtitle", "time": 2765.91, "timestamp": "00:46:05", "text": "呃，有时候我觉得就像……呃，就像我"}, {"type": "subtitle", "time": 2769.75, "timestamp": "00:46:09", "text": "有点像那样，我有时也这样"}, {"type": "subtitle", "time": 2772.27, "timestamp": "00:46:12", "text": "换位思考一下"}, {"type": "subtitle", "time": 2776.63, "timestamp": "00:46:16", "text": "是的，我的一个朋友邀请了我。"}, {"type": "subtitle", "time": 2778.27, "timestamp": "00:46:18", "text": "他们邀请我去他们那里"}, {"type": "subtitle", "time": 2781.109, "timestamp": "00:46:21", "text": "合作直播，他们正在主持。"}, {"type": "subtitle", "time": 2783.67, "timestamp": "00:46:23", "text": "这是他们第一次主办这项赛事。"}, {"type": "subtitle", "time": 2786.63, "timestamp": "00:46:26", "text": "我知道这一点，我看到了他们是如何适应的。"}, {"type": "subtitle", "time": 2788.71, "timestamp": "00:46:28", "text": "去它。作为合作者所承受的压力"}, {"type": "subtitle", "time": 2791.51, "timestamp": "00:46:31", "text": "主持人，联系他人，私信，"}, {"type": "subtitle", "time": 2792.91, "timestamp": "00:46:32", "text": "制作DM"}, {"type": "subtitle", "time": 2795.829, "timestamp": "00:46:35", "text": "小组，确保每位参与者都有"}, {"type": "subtitle", "time": 2798.51, "timestamp": "00:46:38", "text": "游戏已经安装了一些东西，"}, {"type": "subtitle", "time": 2802.15, "timestamp": "00:46:42", "text": "甚至包括 Astraas 的所有东西"}, {"type": "subtitle", "time": 2804.79, "timestamp": "00:46:44", "text": "毁灭诞生SMP之类的东西，对吧？他曾"}, {"type": "subtitle", "time": 2808.309, "timestamp": "00:46:48", "text": "逐一手动操作"}, {"type": "subtitle", "time": 2810.23, "timestamp": "00:46:50", "text": "谁在场，以及确保"}, {"type": "subtitle", "time": 2812.47, "timestamp": "00:46:52", "text": "大家都安装了模组等等。"}, {"type": "subtitle", "time": 2815.71, "timestamp": "00:46:55", "text": "等等等等。仍然有一些像人一样的人。"}, {"type": "subtitle", "time": 2819.349, "timestamp": "00:46:59", "text": "他好像无法应付，因为当"}]
[{"type": "subtitle", "time": 4681.189, "timestamp": "01:18:01", "text": "呃，我有个疑问，是否"}, {"type": "subtitle", "time": 4684.63, "timestamp": "01:18:04", "text": "呃，就像自动模式包检查它一样"}, {"type": "subtitle", "time": 4686.709, "timestamp": "01:18:06", "text": "从 mods 文件夹里导出，对吧？服务器"}, {"type": "subtitle", "time": 4688.87, "timestamp": "01:18:08", "text": "主模组文件夹。"}, {"type": "subtitle", "time": 4693.669, "timestamp": "01:18:13", "text": "而且自从……自从……不管是什么模组我们"}, {"type": "subtitle", "time": 4696.63, "timestamp": "01:18:16", "text": "想添加的内容，比如是否是"}, {"type": "subtitle", "time": 4699.59, "timestamp": "01:18:19", "text": "客户端或服务器端"}, {"type": "subtitle", "time": 4704.149, "timestamp": "01:18:24", "text": "嗯，我们把它添加到 mods 文件夹里，对吧？"}, {"type": "subtitle", "time": 4706.79, "timestamp": "01:18:26", "text": "通常情况下，但我所做的就是我有一个"}, {"type": "subtitle", "time": 4709.669, "timestamp": "01:18:29", "text": "客户端模组应该放在单独的文件夹里吧？"}, {"type": "subtitle", "time": 4713.43, "timestamp": "01:18:33", "text": "这样更容易管理，对吧？所以呢？"}, {"type": "subtitle", "time": 4717.35, "timestamp": "01:18:37", "text": "事情发生的时候，呃，就是当某人"}, {"type": "subtitle", "time": 4719.59, "timestamp": "01:18:39", "text": "呃，就像自动模组包下载的时候"}, {"type": "subtitle", "time": 4722.31, "timestamp": "01:18:42", "text": "这些模组。所以接下来会发生什么呢？"}, {"type": "subtitle", "time": 4726.63, "timestamp": "01:18:46", "text": "他们会下载两倍的量，或者泄露出去。"}, {"type": "subtitle", "time": 4728.95, "timestamp": "01:18:48", "text": "对于CL，当我查看时"}, {"type": "subtitle", "time": 4731.99, "timestamp": "01:18:51", "text": "文件看起来不像2倍，但是"}, {"type": "subtitle", "time": 4733.39, "timestamp": "01:18:53", "text": "它是"}, {"type": "subtitle", "time": 4737.43, "timestamp": "01:18:57", "text": "不知为何，我当时还是想：等等……"}]
[{"type": "subtitle", "time": 2341.27, "timestamp": "00:39:01", "text": "这个社区在他的频道上等等。"}, {"type": "subtitle", "time": 2343.71, "timestamp": "00:39:03", "text": "我当时想，“我的天哪，吸血鬼！”"}, {"type": "subtitle", "time": 2346.99, "timestamp": "00:39:06", "text": "主播，一个牙医吸血鬼"}, {"type": "subtitle", "time": 2349.95, "timestamp": "00:39:09", "text": "主播。他太酷了，"}, {"type": "subtitle", "time": 2353.19, "timestamp": "00:39:13", "text": "东西，东西。”然后我跟着他走了"}, {"type": "subtitle", "time": 2355.589, "timestamp": "00:39:15", "text": "现实等等，因为用作"}, {"type": "subtitle", "time": 2357.829, "timestamp": "00:39:17", "text": "现实模型以及我所不了解的一切"}, {"type": "subtitle", "time": 2359.829, "timestamp": "00:39:19", "text": "以前我这边的人都知道我。"}, {"type": "subtitle", "time": 2363.589, "timestamp": "00:39:23", "text": "我以前是那样的东西，我以前又那样了，我是"}, {"type": "subtitle", "time": 2365.75, "timestamp": "00:39:25", "text": "作为一名专业人士，我现在努力确保"}, {"type": "subtitle", "time": 2368.87, "timestamp": "00:39:28", "text": "合作方现在正处于最佳状态。"}, {"type": "subtitle", "time": 2371.99, "timestamp": "00:39:31", "text": "即使我知道自己存在一些问题，例如"}, {"type": "subtitle", "time": 2375.31, "timestamp": "00:39:35", "text": "我的精力不足，容易感到疲倦。"}, {"type": "subtitle", "time": 2379.67, "timestamp": "00:39:39", "text": "很多时候，如果是这种情况，我就会变得沉默寡言。"}, {"type": "subtitle", "time": 2381.589, "timestamp": "00:39:41", "text": "如果你是你，那就参与小组合作之类的活动吧"}, {"type": "subtitle", "time": 2384.47, "timestamp": "00:39:44", "text": "我好像也注意到自己变得沉默了。"}, {"type": "subtitle", "time": 2386.55, "timestamp": "00:39:46", "text": "很多时候。我不知道这是什么"}, {"type": "subtitle", "time": 2388.71, "timestamp": "00:39:48", "text": "人们在议论纷纷。我不想"}, {"type": "subtitle", "time": 2391.75, "timestamp": "00:39:51", "text": "超过他们。我尽量独处。"}, {"type": "subtitle", "time": 2395.43, "timestamp": "00:39:55", "text": "走同一条车道，保持安静。"}, {"type": "subtitle", "time": 2397.55, "timestamp": "00:39:57", "text": "ETC。"}]
[{"type": "subtitle", "time": 962.189, "timestamp": "00:16:02", "text": "我的跑步活动"}, {"type": "subtitle", "time": 965.269, "timestamp": "00:16:05", "text": "等等。呃，关于Joathon活动的批评者。"}, {"type": "subtitle", "time": 967.829, "timestamp": "00:16:07", "text": "以及所有的一切。我觉得评论家们"}, {"type": "subtitle", "time": 971.629, "timestamp": "00:16:11", "text": "甚至正是那条狗让我……"}, {"type": "subtitle", "time": 975.069, "timestamp": "00:16:15", "text": "更多"}, {"type": "subtitle", "time": 977.23, "timestamp": "00:16:17", "text": "脆弱的感觉"}, {"type": "subtitle", "time": 984.87, "timestamp": "00:16:24", "text": "比如，换个角度想。"}, {"type": "subtitle", "time": 988.949, "timestamp": "00:16:28", "text": "你是要出道还是其他什么？"}, {"type": "subtitle", "time": 993.069, "timestamp": "00:16:33", "text": "规模较小的活动，参与人数不多。"}, {"type": "subtitle", "time": 996.47, "timestamp": "00:16:36", "text": "你想引入一些东西……"}, {"type": "subtitle", "time": 998.87, "timestamp": "00:16:38", "text": "然后你之后，他们就像你一样"}, {"type": "subtitle", "time": 1000.87, "timestamp": "00:16:40", "text": "安排合作或其他事宜"}, {"type": "subtitle", "time": 1003.35, "timestamp": "00:16:43", "text": "其他创作者或新创作者 下一个 下一个"}, {"type": "subtitle", "time": 1005.509, "timestamp": "00:16:45", "text": "一个月后或者下周之类的，他们"}, {"type": "subtitle", "time": 1008.15, "timestamp": "00:16:48", "text": "他们碰巧查看了你的内容，然后他们"}, {"type": "subtitle", "time": 1011.91, "timestamp": "00:16:51", "text": "我不知道为什么会被卡住"}, {"type": "subtitle", "time": 1013.829, "timestamp": "00:16:53", "text": "知道原因，而不是"}, {"type": "subtitle", "time": 1016.47, "timestamp": "00:16:56", "text": "尊重你的所作所为，并且乐于接受。"}, {"type": "subtitle", "time": 1019.069, "timestamp": "00:16:59", "text": "你还是做你自己的事吧。"}]
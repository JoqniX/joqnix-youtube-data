[{"type": "subtitle", "time": 4982.35, "timestamp": "01:23:02", "text": "什么？"}, {"type": "subtitle", "time": 4986.47, "timestamp": "01:23:06", "text": "真的吗？玩家按下R键确认"}, {"type": "subtitle", "time": 4987.99, "timestamp": "01:23:07", "text": "屏住呼吸。当玩家停止"}, {"type": "subtitle", "time": 4989.79, "timestamp": "01:23:09", "text": "屏住呼吸，他们会"}, {"type": "subtitle", "time": 4992.229, "timestamp": "01:23:12", "text": "发布。此请求属于所有者系统"}, {"type": "subtitle", "time": 4993.87, "timestamp": "01:23:13", "text": "到"}, {"type": "subtitle", "time": 4996.47, "timestamp": "01:23:16", "text": "工作。玩家需要按下R键"}, {"type": "subtitle", "time": 4998.189, "timestamp": "01:23:18", "text": "入水前避免"}, {"type": "subtitle", "time": 5001.47, "timestamp": "01:23:21", "text": "旅行。只要他们"}, {"type": "subtitle", "time": 5004.229, "timestamp": "01:23:24", "text": "玩家，按住我们的R键。"}, {"type": "subtitle", "time": 5007.149, "timestamp": "01:23:27", "text": "不会失去她。很快"}, {"type": "subtitle", "time": 5016.669, "timestamp": "01:23:36", "text": "去他妈的，是什么驱使他们这么做的？"}, {"type": "subtitle", "time": 5018.189, "timestamp": "01:23:38", "text": "这？"}, {"type": "subtitle", "time": 5022.149, "timestamp": "01:23:42", "text": "呃，这个选项可以重置每个玩家"}, {"type": "subtitle", "time": 5024.55, "timestamp": "01:23:44", "text": "这样做难道不会让事情变得更容易吗？"}, {"type": "subtitle", "time": 5026.07, "timestamp": "01:23:46", "text": "玩家可以作弊，但这并不允许。"}, {"type": "subtitle", "time": 5028.47, "timestamp": "01:23:48", "text": "让他们做任何事。他们本可以拥有我"}, {"type": "subtitle", "time": 5030.95, "timestamp": "01:23:50", "text": "已经与类似 Auto 的程序进行过 clish 处理"}, {"type": "subtitle", "time": 5034.47, "timestamp": "01:23:54", "text": "由于该模式已经运行，因此需要硬键才能运行。"}, {"type": "subtitle", "time": 5037.47, "timestamp": "01:23:57", "text": "基于诚信原则。这不算什么大事"}]
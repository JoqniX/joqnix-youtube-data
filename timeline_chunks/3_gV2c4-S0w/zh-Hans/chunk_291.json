[{"type": "subtitle", "time": 17462.75, "timestamp": "04:51:02", "text": "假设字面上假设"}, {"type": "subtitle", "time": 17466.708, "timestamp": "04:51:06", "text": "嗯，如果我们俩合作的话，那就是"}, {"type": "subtitle", "time": 17470.15, "timestamp": "04:51:10", "text": "就像我试图追逐云朵一样"}, {"type": "subtitle", "time": 17473.35, "timestamp": "04:51:13", "text": "窃取他们的观众或其他什么目的"}, {"type": "subtitle", "time": 17476.628, "timestamp": "04:51:16", "text": "我自己的利益，为了我获得"}, {"type": "subtitle", "time": 17479.83, "timestamp": "04:51:19", "text": "钱之类的东西。他们呃"}, {"type": "subtitle", "time": 17482.708, "timestamp": "04:51:22", "text": "或者类似的事情。他们甚至"}, {"type": "subtitle", "time": 17487.83, "timestamp": "04:51:27", "text": "问得好像我想向谁证明什么似的？"}, {"type": "subtitle", "time": 17490.868, "timestamp": "04:51:30", "text": "我当时就想，这默认设置到底是什么鬼？"}, {"type": "subtitle", "time": 17493.51, "timestamp": "04:51:33", "text": "翻译错误？比如当……"}, {"type": "subtitle", "time": 17496.83, "timestamp": "04:51:36", "text": "像兄弟一样把英语翻译成日语"}, {"type": "subtitle", "time": 17500.868, "timestamp": "04:51:40", "text": "那里好像发生了什么事？然后我"}, {"type": "subtitle", "time": 17502.708, "timestamp": "04:51:42", "text": "是的，我没有。最后，"}, {"type": "subtitle", "time": 17505.868, "timestamp": "04:51:45", "text": "有一个赞"}, {"type": "subtitle", "time": 17508.708, "timestamp": "04:51:48", "text": "嗯，你觉得你是在送货吗？"}, {"type": "subtitle", "time": 17512.07, "timestamp": "04:51:52", "text": "值2000美元吗？然后我会解释一下"}, {"type": "subtitle", "time": 17514.788, "timestamp": "04:51:54", "text": "就像在要点中那样，这很容易做到"}, {"type": "subtitle", "time": 17516.788, "timestamp": "04:51:56", "text": "明白，还有诸如“你看，我不是”之类的东西"}, {"type": "subtitle", "time": 17518.708, "timestamp": "04:51:58", "text": "即使是为了钱之类的原因，"}]
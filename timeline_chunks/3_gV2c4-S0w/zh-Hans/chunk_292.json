[{"type": "subtitle", "time": 17522.15, "timestamp": "04:52:02", "text": "我目前处于这种欲望状态。"}, {"type": "subtitle", "time": 17524.15, "timestamp": "04:52:04", "text": "比如那些我不想解释的事情"}, {"type": "subtitle", "time": 17526.788, "timestamp": "04:52:06", "text": "我甚至不得不向一个陌生人解释。"}, {"type": "subtitle", "time": 17531.15, "timestamp": "04:52:11", "text": "如果他们是我钦佩和绝望的人"}, {"type": "subtitle", "time": 17534.55, "timestamp": "04:52:14", "text": "嗯，即使我钦佩并尊重他们"}, {"type": "subtitle", "time": 17536.75, "timestamp": "04:52:16", "text": "内容及其在"}, {"type": "subtitle", "time": 17541.07, "timestamp": "04:52:21", "text": "一些事，但我不知道，感觉就像"}, {"type": "subtitle", "time": 17545.75, "timestamp": "04:52:25", "text": "批评太多太多了，而且不喜欢"}, {"type": "subtitle", "time": 17548.39, "timestamp": "04:52:28", "text": "感觉平等之类的。我知道我是"}, {"type": "subtitle", "time": 17551.59, "timestamp": "04:52:31", "text": "感觉就像……我不知道，感觉像……"}, {"type": "subtitle", "time": 17554.51, "timestamp": "04:52:34", "text": "能力膨胀或者其他什么你能想到的"}, {"type": "subtitle", "time": 17556.35, "timestamp": "04:52:36", "text": "说"}, {"type": "subtitle", "time": 17561.59, "timestamp": "04:52:41", "text": "就像我的名字首字母一样，嗯嗯"}, {"type": "subtitle", "time": 17564.708, "timestamp": "04:52:44", "text": "信息里好像在问你是否感兴趣"}, {"type": "subtitle", "time": 17567.03, "timestamp": "04:52:47", "text": "或者，请不要让我知道。"}, {"type": "subtitle", "time": 17568.59, "timestamp": "04:52:48", "text": "如果你是"}, {"type": "subtitle", "time": 17571.51, "timestamp": "04:52:51", "text": "他们似乎很感兴趣，呃，礼貌地"}, {"type": "subtitle", "time": 17574.23, "timestamp": "04:52:54", "text": "拒绝，说“是啊，我不忙，我很忙”。"}, {"type": "subtitle", "time": 17577.83, "timestamp": "04:52:57", "text": "总能找到借口，对吧。我是"}]
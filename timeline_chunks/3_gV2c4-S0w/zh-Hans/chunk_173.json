[{"type": "subtitle", "time": 10380.87, "timestamp": "02:53:00", "text": "你好。"}, {"type": "subtitle", "time": 10384.87, "timestamp": "02:53:04", "text": "想到我会迷路，我就感到非常痛苦。"}, {"type": "subtitle", "time": 10386.95, "timestamp": "02:53:06", "text": "如果我没记错的话，如果我放一块煤，"}, {"type": "subtitle", "time": 10396.95, "timestamp": "02:53:16", "text": "向上。加热器。"}, {"type": "subtitle", "time": 10399.03, "timestamp": "02:53:19", "text": "我的天啊。你、你的炊具和你的"}, {"type": "chat", "time": 10405.42, "timestamp": "02:53:25", "author": "@RPGfanatic-i3z", "avatar": "https://yt4.ggpht.com/F9kA73IKR7TCeh1WUg7fNOkjcUJ6lPk8I6j69xenF_vJcjZ4GCnCIeYo88hJF8jUU3OAOsYG=s64-c-k-c0x00ffffff-no-rj", "message": "like karwaoo stream bhai ki"}, {"type": "subtitle", "time": 10405.83, "timestamp": "02:53:25", "text": "我的炉灶加热器。"}, {"type": "chat", "time": 10406.313, "timestamp": "02:53:26", "author": "@BRUCELEE-wt7hk", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kywKa6HSckNVxhER8qedLRRVkcGIqFFytjQHe-071HyMo=s64-c-k-c0x00ffffff-no-rj", "message": "like the stream chat otherwise this 🕷 will Crawl all over you"}, {"type": "subtitle", "time": 10409.99, "timestamp": "02:53:29", "text": "她不知道其中的诱惑。好的。是的。"}, {"type": "subtitle", "time": 10412.15, "timestamp": "02:53:32", "text": "什么？"}, {"type": "subtitle", "time": 10417.79, "timestamp": "02:53:37", "text": "所以我尝试设置一个模式"}, {"type": "subtitle", "time": 10420.03, "timestamp": "02:53:40", "text": "呃，太阳能"}, {"type": "subtitle", "time": 10423.269, "timestamp": "02:53:43", "text": "烹饪。所以，即使没有煤炭，你也能得到"}, {"type": "subtitle", "time": 10426.309, "timestamp": "02:53:46", "text": "煮熟的东西，比如食物等等。"}, {"type": "subtitle", "time": 10434.15, "timestamp": "02:53:54", "text": "阳光和阿斯特拉碰巧相遇了，这就是……"}, {"type": "subtitle", "time": 10436.309, "timestamp": "02:53:56", "text": "比如早上八点左右。之后"}]
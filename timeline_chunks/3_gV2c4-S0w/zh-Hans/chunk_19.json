[{"type": "subtitle", "time": 1140.15, "timestamp": "00:19:00", "text": "多年来，世界各地的人们都喜欢这样。"}, {"type": "subtitle", "time": 1141.87, "timestamp": "00:19:01", "text": "正确的？"}, {"type": "subtitle", "time": 1145.27, "timestamp": "00:19:05", "text": "只有那些真心希望"}, {"type": "subtitle", "time": 1149.35, "timestamp": "00:19:09", "text": "我喜欢我的东西，喜欢聊天，而且"}, {"type": "subtitle", "time": 1152.31, "timestamp": "00:19:12", "text": "我的参与和互动以及"}, {"type": "subtitle", "time": 1155.19, "timestamp": "00:19:15", "text": "所有内容。他们只是"}, {"type": "subtitle", "time": 1158.87, "timestamp": "00:19:18", "text": "路过，还在看，还在。"}, {"type": "subtitle", "time": 1161.43, "timestamp": "00:19:21", "text": "作为我的观众，我喜欢来这里"}, {"type": "subtitle", "time": 1164.669, "timestamp": "00:19:24", "text": "一切都对吧？我感激"}, {"type": "subtitle", "time": 1168.549, "timestamp": "00:19:28", "text": "那。是的，尤其如此。"}, {"type": "subtitle", "time": 1171.59, "timestamp": "00:19:31", "text": "突袭等等。当主播出现时"}, {"type": "subtitle", "time": 1174.07, "timestamp": "00:19:34", "text": "直播结束后，他们袭击了另一个地方。"}, {"type": "subtitle", "time": 1177.27, "timestamp": "00:19:37", "text": "频道是一个更新的频道，所有人都"}, {"type": "subtitle", "time": 1179.51, "timestamp": "00:19:39", "text": "假设有100人正在遭受袭击"}, {"type": "subtitle", "time": 1182.39, "timestamp": "00:19:42", "text": "你们是要派他们去当袭击者吗？"}, {"type": "subtitle", "time": 1185.27, "timestamp": "00:19:45", "text": "不同的频道，并非所有人都会如此。"}, {"type": "subtitle", "time": 1189.39, "timestamp": "00:19:49", "text": "想订阅或关注该评分"}, {"type": "subtitle", "time": 1192.35, "timestamp": "00:19:52", "text": "他们会在频道上"}, {"type": "subtitle", "time": 1195.43, "timestamp": "00:19:55", "text": "好像你必须配得上那些关注者似的"}, {"type": "subtitle", "time": 1197.669, "timestamp": "00:19:57", "text": "值得订阅"}]
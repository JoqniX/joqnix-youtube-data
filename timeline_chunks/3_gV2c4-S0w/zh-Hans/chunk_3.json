[{"type": "subtitle", "time": 191.50900000000001, "timestamp": "00:03:11", "text": "明天。我真不该从那里回来。"}, {"type": "subtitle", "time": 199.43, "timestamp": "00:03:19", "text": "呃，就在这个周末。下周好忙啊。"}, {"type": "subtitle", "time": 204.22899999999998, "timestamp": "00:03:24", "text": "紧的。太紧了，兄弟。很紧。不，"}, {"type": "subtitle", "time": 207.07, "timestamp": "00:03:27", "text": "下周是"}, {"type": "subtitle", "time": 210.309, "timestamp": "00:03:30", "text": "紧的。接下来，下周简直太疯狂了。"}, {"type": "subtitle", "time": 212.949, "timestamp": "00:03:32", "text": "崩溃，崩溃。"}, {"type": "subtitle", "time": 215.03, "timestamp": "00:03:35", "text": "事实上只有三个"}, {"type": "subtitle", "time": 218.22899999999998, "timestamp": "00:03:38", "text": "本周，和上周一样，剩下的天数更少了。"}, {"type": "subtitle", "time": 221.86, "timestamp": "00:03:41", "text": "本周是本月是"}, {"type": "subtitle", "time": 223.789, "timestamp": "00:03:43", "text": "[音乐]"}, {"type": "subtitle", "time": 227.149, "timestamp": "00:03:47", "text": "疯狂的。但就是这样。"}, {"type": "subtitle", "time": 230.19, "timestamp": "00:03:50", "text": "是。所以"}, {"type": "subtitle", "time": 232.51, "timestamp": "00:03:52", "text": "然后我就感觉如此"}]
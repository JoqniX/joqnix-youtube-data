[{"type": "subtitle", "time": 16565.551, "timestamp": "04:36:05", "text": "该死，真是个好东西"}, {"type": "subtitle", "time": 16576.109, "timestamp": "04:36:16", "text": "你知道，你知道"}, {"type": "subtitle", "time": 16578.629, "timestamp": "04:36:18", "text": "你怎么知道我会如何与……合作"}, {"type": "subtitle", "time": 16590.629, "timestamp": "04:36:30", "text": "请您回复后再联系我。我会把我的"}, {"type": "subtitle", "time": 16596.949, "timestamp": "04:36:36", "text": "有。反正我都在和他们一起玩。"}, {"type": "subtitle", "time": 16601.47, "timestamp": "04:36:41", "text": "只是观看直播的时间。"}, {"type": "subtitle", "time": 16606.83, "timestamp": "04:36:46", "text": "为什么？哦，等等。就像以观众的身份一样。"}, {"type": "subtitle", "time": 16615.029, "timestamp": "04:36:55", "text": "溪流。但这就像是观众席的一部分。"}]
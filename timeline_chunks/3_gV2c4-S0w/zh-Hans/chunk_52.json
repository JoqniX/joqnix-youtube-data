[{"type": "subtitle", "time": 3122.79, "timestamp": "00:52:02", "text": "PNG 嗯，我们聊了一会儿，闲聊等等。"}, {"type": "subtitle", "time": 3126.71, "timestamp": "00:52:06", "text": "我们合作就结束了，对我来说没问题。"}, {"type": "subtitle", "time": 3129.349, "timestamp": "00:52:09", "text": "当我查看协作主持人是否也"}, {"type": "subtitle", "time": 3132.79, "timestamp": "00:52:12", "text": "与其说是偷懒，不如说是努力尝试"}, {"type": "subtitle", "time": 3135.99, "timestamp": "00:52:15", "text": "他们已经尽力了，但是……也做不到。"}, {"type": "subtitle", "time": 3138.15, "timestamp": "00:52:18", "text": "一切都堆积如山，因为太多了。"}, {"type": "subtitle", "time": 3140.91, "timestamp": "00:52:20", "text": "对他们来说。不。"}, {"type": "subtitle", "time": 3144.95, "timestamp": "00:52:24", "text": "呃，堆积如山。不。所以我的做法是这样的……"}, {"type": "subtitle", "time": 3147.51, "timestamp": "00:52:27", "text": "主动点赞、询问"}, {"type": "subtitle", "time": 3149.829, "timestamp": "00:52:29", "text": "是的，我知道，这是动态时间"}, {"type": "subtitle", "time": 3152.23, "timestamp": "00:52:32", "text": "邮票。这是我们所有人的时机"}, {"type": "subtitle", "time": 3155.109, "timestamp": "00:52:35", "text": "将会进行直播等等"}, {"type": "subtitle", "time": 3157.99, "timestamp": "00:52:37", "text": "因为以前用Discord的时候……"}, {"type": "subtitle", "time": 3161.589, "timestamp": "00:52:41", "text": "动态时间戳功能没有正常工作。"}, {"type": "subtitle", "time": 3164.71, "timestamp": "00:52:44", "text": "其他人也都知道，呃，还有空心的"}, {"type": "subtitle", "time": 3166.95, "timestamp": "00:52:46", "text": "文本功能，多手表功能，哪个"}, {"type": "subtitle", "time": 3169.549, "timestamp": "00:52:49", "text": "其他人对此一无所知。"}, {"type": "subtitle", "time": 3172.79, "timestamp": "00:52:52", "text": "不，我以前就像我非常喜欢的那样"}, {"type": "subtitle", "time": 3175.99, "timestamp": "00:52:55", "text": "宣传一下，比如你可以用这个"}, {"type": "subtitle", "time": 3178.71, "timestamp": "00:52:58", "text": "虽然网站也提供PG级内容之类的，但我"}]
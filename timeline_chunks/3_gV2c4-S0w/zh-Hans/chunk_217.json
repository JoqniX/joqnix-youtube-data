[{"type": "subtitle", "time": 13025.309, "timestamp": "03:37:05", "text": "等等，你所在的时区是哪里？"}, {"type": "subtitle", "time": 13029.15, "timestamp": "03:37:09", "text": "苏潘，你的时间是什么时候？"}, {"type": "subtitle", "time": 13034.269, "timestamp": "03:37:14", "text": "区？它和我们一样吗？你是来自哪里？"}, {"type": "subtitle", "time": 13037.389, "timestamp": "03:37:17", "text": "我们？所以会"}, {"type": "subtitle", "time": 13042.07, "timestamp": "03:37:22", "text": "大概会在晚上。不，我想是的"}, {"type": "subtitle", "time": 13063.469, "timestamp": "03:37:43", "text": "好的。有吗？"}, {"type": "subtitle", "time": 13067.71, "timestamp": "03:37:47", "text": "呃，为什么浏览器不行？"}, {"type": "subtitle", "time": 13069.309, "timestamp": "03:37:49", "text": "浏览，"}, {"type": "subtitle", "time": 13071.79, "timestamp": "03:37:51", "text": "兄弟？"}, {"type": "subtitle", "time": 13075.349, "timestamp": "03:37:55", "text": "不，不是浏览器响铃。它是"}, {"type": "subtitle", "time": 13078.469, "timestamp": "03:37:58", "text": "因为有你。你为什么要办展览？为什么？"}]
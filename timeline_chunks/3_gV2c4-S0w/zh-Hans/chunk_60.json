[{"type": "subtitle", "time": 3604.47, "timestamp": "01:00:04", "text": "七月初。我的天啊。好的。至少"}, {"type": "subtitle", "time": 3606.789, "timestamp": "01:00:06", "text": "你今天来参加我的生日聚会。"}, {"type": "subtitle", "time": 3621.349, "timestamp": "01:00:21", "text": "我不知道，天哪，我很好奇溪流是什么。"}, {"type": "subtitle", "time": 3625.32, "timestamp": "01:00:25", "text": "皮肤就像……我不会好奇为什么"}, {"type": "subtitle", "time": 3627.87, "timestamp": "01:00:27", "text": "[音乐]"}, {"type": "subtitle", "time": 3653.51, "timestamp": "01:00:53", "text": "现在。我以前有直播时间表"}, {"type": "subtitle", "time": 3657.19, "timestamp": "01:00:57", "text": "其实已经发帖了，但是因为我发不了。"}, {"type": "subtitle", "time": 3659.829, "timestamp": "01:00:59", "text": "坚持下去，我当时就想，我要走了。"}]
[{"type": "subtitle", "time": 18720.51, "timestamp": "05:12:00", "text": "不"}, {"type": "subtitle", "time": 18723.83, "timestamp": "05:12:03", "text": "担心。呃，你知道吗，有个很凶的老师来了。"}, {"type": "subtitle", "time": 18727.83, "timestamp": "05:12:07", "text": "那天我直播的时候正在玩游戏"}, {"type": "subtitle", "time": 18730.708, "timestamp": "05:12:10", "text": "与环形波萨卡，他写道"}, {"type": "subtitle", "time": 18733.39, "timestamp": "05:12:13", "text": "我当时就想，我说的是日语吧，兄弟。"}, {"type": "subtitle", "time": 18736.15, "timestamp": "05:12:16", "text": "我当时慌了，心想我看不懂啊，我的天哪"}, {"type": "subtitle", "time": 18738.948, "timestamp": "05:12:18", "text": "天哪，他会知道我没好好学习的。"}, {"type": "subtitle", "time": 18741.43, "timestamp": "05:12:21", "text": "天哪，你又要骂我了，然后我就……"}, {"type": "subtitle", "time": 18745.59, "timestamp": "05:12:25", "text": "我知道，而且我在电脑上笨手笨脚的。"}, {"type": "subtitle", "time": 18748.628, "timestamp": "05:12:28", "text": "延迟如此之大，以至于它复制了"}, {"type": "subtitle", "time": 18751.31, "timestamp": "05:12:31", "text": "我把在 OBS 中复制的文本粘贴了过去。"}, {"type": "subtitle", "time": 18755.11, "timestamp": "05:12:35", "text": "是的，它在 OBS 中创建了一个文本源，兄弟。"}, {"type": "subtitle", "time": 18759.35, "timestamp": "05:12:39", "text": "他知道。我想他知道我把他的放在那里了"}, {"type": "subtitle", "time": 18760.83, "timestamp": "05:12:40", "text": "Google评论"}, {"type": "subtitle", "time": 18766.05, "timestamp": "05:12:46", "text": "兄弟。"}, {"type": "subtitle", "time": 18768.11, "timestamp": "05:12:48", "text": "[音乐]"}, {"type": "subtitle", "time": 18770.59, "timestamp": "05:12:50", "text": "不。但是"}, {"type": "subtitle", "time": 18773.27, "timestamp": "05:12:53", "text": "呃，看来他只是在打字。"}, {"type": "subtitle", "time": 18775.59, "timestamp": "05:12:55", "text": "日本人。你会说：“是啊，哟。”"}, {"type": "subtitle", "time": 18778.708, "timestamp": "05:12:58", "text": "每当他来的时候，我都会说：“哟，小伙子。”"}]
[{"type": "subtitle", "time": 8961.83, "timestamp": "02:29:21", "text": "什么？哦，你现在自己盖房子了。"}, {"type": "subtitle", "time": 8964.309, "timestamp": "02:29:24", "text": "我也想要自己的房子。我想要"}, {"type": "subtitle", "time": 8974.91, "timestamp": "02:29:34", "text": "什么？你的房子"}, {"type": "subtitle", "time": 8978.87, "timestamp": "02:29:38", "text": "简直就像这个人一样。你看，现在我"}, {"type": "subtitle", "time": 8980.95, "timestamp": "02:29:40", "text": "去这个村庄。"}, {"type": "subtitle", "time": 8983.15, "timestamp": "02:29:43", "text": "看。"}, {"type": "subtitle", "time": 8986.95, "timestamp": "02:29:46", "text": "啊。哦，哇。与我家相连。现在"}, {"type": "subtitle", "time": 8988.87, "timestamp": "02:29:48", "text": "我只需要种很多樱桃树"}, {"type": "subtitle", "time": 8992.79, "timestamp": "02:29:52", "text": "我想应该是树木吧。是的。就像改革……"}, {"type": "subtitle", "time": 8994.79, "timestamp": "02:29:54", "text": "地形。"}, {"type": "subtitle", "time": 8997.27, "timestamp": "02:29:57", "text": "我正在制作自己的地形。"}, {"type": "subtitle", "time": 8999.11, "timestamp": "02:29:59", "text": "哇。"}]
[{"type": "subtitle", "time": 14111.59, "timestamp": "03:55:11", "text": "[音乐]"}, {"type": "subtitle", "time": 14114.07, "timestamp": "03:55:14", "text": "我为什么在看推特？让我来做"}, {"type": "subtitle", "time": 14117.349, "timestamp": "03:55:17", "text": "我去做自己的事，然后去睡觉。好的，今天的"}, {"type": "subtitle", "time": 14119.269, "timestamp": "03:55:19", "text": "就是那个东西，对吧？让我们来写摘要"}, {"type": "subtitle", "time": 14130.07, "timestamp": "03:55:30", "text": "第62天。也就是今天，第62天。我们玩了。"}, {"type": "subtitle", "time": 14132.03, "timestamp": "03:55:32", "text": "呃"}, {"type": "subtitle", "time": 14134.269, "timestamp": "03:55:34", "text": "土地。我做了我的"}, {"type": "subtitle", "time": 14137.309, "timestamp": "03:55:37", "text": "最好"}, {"type": "subtitle", "time": 14140.63, "timestamp": "03:55:40", "text": "探索 探索"}, {"type": "subtitle", "time": 14143.389, "timestamp": "03:55:43", "text": "呃，世界，呃，世界"}, {"type": "subtitle", "time": 14145.55, "timestamp": "03:55:45", "text": "的"}, {"type": "subtitle", "time": 14149.79, "timestamp": "03:55:49", "text": "区域/地图 我曾是"}, {"type": "subtitle", "time": 14156.67, "timestamp": "03:55:56", "text": "嗯，有点"}, {"type": "subtitle", "time": 14159.429, "timestamp": "03:55:59", "text": "令人畏惧。 “daunting”这个词用得对吗？"}]
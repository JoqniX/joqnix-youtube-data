[{"type": "subtitle", "time": 18242.948, "timestamp": "05:04:02", "text": "真是件好事。好的。合作是"}, {"type": "subtitle", "time": 18246.15, "timestamp": "05:04:06", "text": "我应该会觉得很有趣。还有，为什么是"}, {"type": "subtitle", "time": 18249.43, "timestamp": "05:04:09", "text": "你们俩写的是同一件事吗？"}, {"type": "subtitle", "time": 18256.99, "timestamp": "05:04:16", "text": "你是那种金发女郎吗？"}, {"type": "subtitle", "time": 18259.868, "timestamp": "05:04:19", "text": "某物？发生了什么事？"}, {"type": "subtitle", "time": 18262.19, "timestamp": "05:04:22", "text": "笨蛋？一切都与……有关"}, {"type": "subtitle", "time": 18271.788, "timestamp": "05:04:31", "text": "该死。她也一样"}, {"type": "subtitle", "time": 18275.47, "timestamp": "05:04:35", "text": "人。茉莉花铬，你做了什么？"}, {"type": "subtitle", "time": 18278.23, "timestamp": "05:04:38", "text": "做？哦，是的，已经有一段时间了。"}, {"type": "subtitle", "time": 18280.55, "timestamp": "05:04:40", "text": "与 Jasmine Sana 交谈过。希望你"}, {"type": "subtitle", "time": 18282.59, "timestamp": "05:04:42", "text": "一切顺利。"}, {"type": "subtitle", "time": 18284.868, "timestamp": "05:04:44", "text": "笨蛋，你一直没参与。"}, {"type": "subtitle", "time": 18287.43, "timestamp": "05:04:47", "text": "你个笨蛋，玩的是我的世界。你最近怎么样？"}, {"type": "subtitle", "time": 18289.75, "timestamp": "05:04:49", "text": "我们添加了很多模组和其他东西，所以你"}, {"type": "subtitle", "time": 18291.67, "timestamp": "05:04:51", "text": "无需手动下载模组"}, {"type": "subtitle", "time": 18294.788, "timestamp": "05:04:54", "text": "不再是了。我添加了一个类似自动模式包"}, {"type": "subtitle", "time": 18297.19, "timestamp": "05:04:57", "text": "东西。所以你打开连接到"}, {"type": "subtitle", "time": 18299.59, "timestamp": "05:04:59", "text": "服务器只需下载自动修改包即可"}]
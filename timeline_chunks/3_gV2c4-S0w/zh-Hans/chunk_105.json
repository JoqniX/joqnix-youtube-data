[{"type": "subtitle", "time": 6300.629, "timestamp": "01:45:00", "text": "发布全新服务器，专为……"}, {"type": "subtitle", "time": 6303.03, "timestamp": "01:45:03", "text": "人生所有才能。然后我"}, {"type": "subtitle", "time": 6304.709, "timestamp": "01:45:04", "text": "诸如“发生了什么事？”之类的问题"}, {"type": "subtitle", "time": 6308.07, "timestamp": "01:45:08", "text": "Hol Life 的旧服务器？他们成功了吗？"}, {"type": "subtitle", "time": 6311.669, "timestamp": "01:45:11", "text": "其他人也可以用吗？"}, {"type": "subtitle", "time": 6314.31, "timestamp": "01:45:14", "text": "这件事发生过吗？"}, {"type": "subtitle", "time": 6316.79, "timestamp": "01:45:16", "text": "哦，他们没能使用最新的"}, {"type": "subtitle", "time": 6318.79, "timestamp": "01:45:18", "text": "Minecraft 版本。他们就像在"}, {"type": "subtitle", "time": 6321.35, "timestamp": "01:45:21", "text": "那个非常非常老的Minecraft版本"}, {"type": "subtitle", "time": 6322.109, "timestamp": "01:45:22", "text": "老的"}, {"type": "subtitle", "time": 6329.27, "timestamp": "01:45:29", "text": "我现在不想加入服务器。"}, {"type": "subtitle", "time": 6331.99, "timestamp": "01:45:31", "text": "它可能又会滞后。"}, {"type": "subtitle", "time": 6334.39, "timestamp": "01:45:34", "text": "缺点方面不要做任何改动。"}, {"type": "subtitle", "time": 6341.51, "timestamp": "01:45:41", "text": "呃，尽量保持兴趣"}, {"type": "subtitle", "time": 6343.669, "timestamp": "01:45:43", "text": "我的世界。它很适合成立一个合作俱乐部。"}, {"type": "subtitle", "time": 6345.149, "timestamp": "01:45:45", "text": "但"}, {"type": "subtitle", "time": 6347.83, "timestamp": "01:45:47", "text": "手上的mosa新服务器有新的"}]
[{"type": "subtitle", "time": 3555.069, "timestamp": "00:59:15", "text": "拼写就像每天一样"}, {"type": "subtitle", "time": 3557.349, "timestamp": "00:59:17", "text": "常规？是的，我需要改变我的"}, {"type": "subtitle", "time": 3564.95, "timestamp": "00:59:24", "text": "我唯一会感到难过的是……"}, {"type": "subtitle", "time": 3567.51, "timestamp": "00:59:27", "text": "我在日本必须保持清醒才能做……"}, {"type": "subtitle", "time": 3570.67, "timestamp": "00:59:30", "text": "晚上10点与大家合作"}, {"type": "subtitle", "time": 3575.67, "timestamp": "00:59:35", "text": "IST。那边现在大概是凌晨三点。"}, {"type": "subtitle", "time": 3578.15, "timestamp": "00:59:38", "text": "如果你愿意，我们可以提前进行。是的，我们"}, {"type": "subtitle", "time": 3585.99, "timestamp": "00:59:45", "text": "你什么时候去日本？我忘了。"}, {"type": "subtitle", "time": 3591.109, "timestamp": "00:59:51", "text": "我七月份就会到那边。"}, {"type": "subtitle", "time": 3595.03, "timestamp": "00:59:55", "text": "仅仅几天而已。几个，是的。几天"}, {"type": "subtitle", "time": 3597.23, "timestamp": "00:59:57", "text": "就这样过去了"}]
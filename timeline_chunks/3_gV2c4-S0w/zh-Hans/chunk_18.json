[{"type": "subtitle", "time": 1080.15, "timestamp": "00:18:00", "text": "好的，这样就可以了。"}, {"type": "subtitle", "time": 1082.63, "timestamp": "00:18:02", "text": "我能理解他们的想法，而且"}, {"type": "subtitle", "time": 1085.11, "timestamp": "00:18:05", "text": "能看出哪里出了问题，就像……"}, {"type": "subtitle", "time": 1095.39, "timestamp": "00:18:15", "text": "是啊，人们认为我只是"}, {"type": "chat", "time": 1098.859, "timestamp": "00:18:18", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "That's inevitable.... you took a big step so it's natural people will come and hit the wrong nerve... I won't say tough up but just know it's a whole package"}, {"type": "subtitle", "time": 1099.59, "timestamp": "00:18:19", "text": "向他们征求意见、金钱方面的意见"}, {"type": "subtitle", "time": 1102.39, "timestamp": "00:18:22", "text": "收益，"}, {"type": "subtitle", "time": 1104.549, "timestamp": "00:18:24", "text": "呃，金钱收益，而我想要"}, {"type": "subtitle", "time": 1106.789, "timestamp": "00:18:26", "text": "我的频道粉丝。这就是我的原因"}, {"type": "subtitle", "time": 1109.47, "timestamp": "00:18:29", "text": "与您合作"}, {"type": "subtitle", "time": 1112.789, "timestamp": "00:18:32", "text": "一切。我也不知道为什么"}, {"type": "subtitle", "time": 1114.75, "timestamp": "00:18:34", "text": "人们这样想"}, {"type": "subtitle", "time": 1118.549, "timestamp": "00:18:38", "text": "那。比如说，就算我真的那样做了。"}, {"type": "subtitle", "time": 1122.47, "timestamp": "00:18:42", "text": "你如何才能百分之百确定你的观点是正确的？"}, {"type": "subtitle", "time": 1124.63, "timestamp": "00:18:44", "text": "你的观众会来我的网站。"}, {"type": "subtitle", "time": 1126.789, "timestamp": "00:18:46", "text": "频道，点赞并订阅我或"}, {"type": "subtitle", "time": 1134.59, "timestamp": "00:18:54", "text": "我？"}, {"type": "subtitle", "time": 1137.59, "timestamp": "00:18:57", "text": "不，我和很多人都合作过。"}]
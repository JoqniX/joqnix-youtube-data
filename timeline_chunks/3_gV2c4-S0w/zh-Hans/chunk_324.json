[{"type": "subtitle", "time": 19444.23, "timestamp": "05:24:04", "text": "那款模型总有一天会亮起来，是的。"}, {"type": "subtitle", "time": 19447.11, "timestamp": "05:24:07", "text": "因为那个型号真的很好，而且性能很高。"}, {"type": "subtitle", "time": 19450.31, "timestamp": "05:24:10", "text": "等级较高，属于高级水平，会有很多……"}, {"type": "subtitle", "time": 19453.59, "timestamp": "05:24:13", "text": "人们的期望，因为……"}, {"type": "subtitle", "time": 19457.23, "timestamp": "05:24:17", "text": "现在质量很好，所以是的"}, {"type": "subtitle", "time": 19460.47, "timestamp": "05:24:20", "text": "所以在我推出新模型之前"}, {"type": "subtitle", "time": 19463.51, "timestamp": "05:24:23", "text": "我必须确认的事情。我不"}, {"type": "subtitle", "time": 19466.628, "timestamp": "05:24:26", "text": "知道。我感觉我好像……我有点……"}, {"type": "subtitle", "time": 19469.99, "timestamp": "05:24:29", "text": "就像我不知道……呃，该怎么称呼它呢？"}, {"type": "subtitle", "time": 19472.55, "timestamp": "05:24:32", "text": "怎么说？我感觉自己好像……"}, {"type": "subtitle", "time": 19476.07, "timestamp": "05:24:36", "text": "我还没准备好接受那种模式，而且我已经"}, {"type": "subtitle", "time": 19479.83, "timestamp": "05:24:39", "text": "因为我像个专业人士。"}, {"type": "subtitle", "time": 19482.55, "timestamp": "05:24:42", "text": "所以，呃，不过多亏了这次运动马拉松"}, {"type": "subtitle", "time": 19484.708, "timestamp": "05:24:44", "text": "事件发生时，我能够鼓起勇气"}, {"type": "subtitle", "time": 19488.75, "timestamp": "05:24:48", "text": "鼓起勇气，打破我自己的呃"}, {"type": "subtitle", "time": 19491.628, "timestamp": "05:24:51", "text": "专业主义综合症等等"}, {"type": "subtitle", "time": 19495.27, "timestamp": "05:24:55", "text": "实际上在 YouTube 上上传了一些东西"}, {"type": "subtitle", "time": 19497.35, "timestamp": "05:24:57", "text": "比如短裤之类的。我开始上传。"}, {"type": "subtitle", "time": 19499.91, "timestamp": "05:24:59", "text": "短裤什么的都带上了。所以，我所做的事情"}]
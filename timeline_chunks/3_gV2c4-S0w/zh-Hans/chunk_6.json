[{"type": "subtitle", "time": 370.15, "timestamp": "00:06:10", "text": "接下来，当他们不再有感觉的时候。"}, {"type": "subtitle", "time": 373.469, "timestamp": "00:06:13", "text": "就像被选中一样。当然可以。当然，当然。"}, {"type": "subtitle", "time": 378.23, "timestamp": "00:06:18", "text": "当然。确实感觉像是一项苦差事。"}, {"type": "subtitle", "time": 400.629, "timestamp": "00:06:40", "text": "椅子。我有点担心……"}, {"type": "subtitle", "time": 412.87, "timestamp": "00:06:52", "text": "担心是因为所有的合作都和"}, {"type": "subtitle", "time": 416.11, "timestamp": "00:06:56", "text": "我曾与以下人员合作："}, {"type": "subtitle", "time": 418.029, "timestamp": "00:06:58", "text": "过去和"}]
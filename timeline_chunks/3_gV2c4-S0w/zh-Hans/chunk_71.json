[{"type": "subtitle", "time": 4261.189, "timestamp": "01:11:01", "text": "如果你在那个渲染块中，"}, {"type": "subtitle", "time": 4264.31, "timestamp": "01:11:04", "text": "你种的任何东西都会生长"}, {"type": "subtitle", "time": 4266.709, "timestamp": "01:11:06", "text": "否则，世界太大了，对吧？如果我们"}, {"type": "subtitle", "time": 4269.189, "timestamp": "01:11:09", "text": "保留该模组，它会继续渲染。"}, {"type": "subtitle", "time": 4271.91, "timestamp": "01:11:11", "text": "这些块作为背景，将会"}, {"type": "subtitle", "time": 4273.91, "timestamp": "01:11:13", "text": "占用内存之类的东西，所以才会这样。"}, {"type": "subtitle", "time": 4291.669, "timestamp": "01:11:31", "text": "哇，你真快。等等，你正在使用"}, {"type": "subtitle", "time": 4296.229, "timestamp": "01:11:36", "text": "呃，就是那个主要的，对吧？我的世界"}, {"type": "subtitle", "time": 4305.91, "timestamp": "01:11:45", "text": "呃"}, {"type": "subtitle", "time": 4308.31, "timestamp": "01:11:48", "text": "是啊，现在他们在……等等，为什么是……"}, {"type": "subtitle", "time": 4310.03, "timestamp": "01:11:50", "text": "仍然需要时间"}, {"type": "subtitle", "time": 4311.63, "timestamp": "01:11:51", "text": "使成为？"}, {"type": "subtitle", "time": 4316.55, "timestamp": "01:11:56", "text": "等等，让我传送到我的"}, {"type": "subtitle", "time": 4319.07, "timestamp": "01:11:59", "text": "密切关注内存"}]
[{"type": "subtitle", "time": 5237.11, "timestamp": "01:27:17", "text": "别问我为什么这么做"}, {"type": "subtitle", "time": 5239.51, "timestamp": "01:27:19", "text": "以及我即将从事的工作。稍等片刻"}, {"type": "subtitle", "time": 5243.189, "timestamp": "01:27:23", "text": "然后看着。你在干什么？"}, {"type": "subtitle", "time": 5245.95, "timestamp": "01:27:25", "text": "我跟你说过，你就等着瞧吧。"}, {"type": "subtitle", "time": 5251.27, "timestamp": "01:27:31", "text": "好的。哦，是的。呃，我需要一张世界地图。我"}, {"type": "subtitle", "time": 5254.229, "timestamp": "01:27:34", "text": "知道。你知道那张世界地图吗？"}, {"type": "subtitle", "time": 5257.189, "timestamp": "01:27:37", "text": "您可以从以下位置查看您的服务器："}, {"type": "subtitle", "time": 5260.27, "timestamp": "01:27:40", "text": "浏览器之类的东西？"}, {"type": "subtitle", "time": 5275.43, "timestamp": "01:27:55", "text": "打电话。开放式派对。"}, {"type": "subtitle", "time": 5277.83, "timestamp": "01:27:57", "text": "此模组增加了认领和"}]
[{"type": "subtitle", "time": 2287.71, "timestamp": "00:38:07", "text": "说实话，我觉得"}, {"type": "subtitle", "time": 2291.109, "timestamp": "00:38:11", "text": "就像我深入思考的时候，我也无法做到。"}, {"type": "subtitle", "time": 2293.589, "timestamp": "00:38:13", "text": "甚至还记得我当时的情景"}, {"type": "subtitle", "time": 2302.79, "timestamp": "00:38:22", "text": "合作就像，嗯，是的，我确实做了，嗯"}, {"type": "subtitle", "time": 2304.31, "timestamp": "00:38:24", "text": "谈到合作和"}, {"type": "subtitle", "time": 2306.87, "timestamp": "00:38:26", "text": "我努力让自己变得更专业一些"}, {"type": "subtitle", "time": 2310.47, "timestamp": "00:38:30", "text": "尽可能专业地询问类似的事情"}, {"type": "subtitle", "time": 2312.79, "timestamp": "00:38:32", "text": "例如，Vic 是我的第一次合作。"}, {"type": "subtitle", "time": 2314.51, "timestamp": "00:38:34", "text": "和"}, {"type": "subtitle", "time": 2316.27, "timestamp": "00:38:36", "text": "维克"}, {"type": "subtitle", "time": 2319.51, "timestamp": "00:38:39", "text": "对，我还是不记得是谁联系上的。"}, {"type": "subtitle", "time": 2320.349, "timestamp": "00:38:40", "text": "出去"}, {"type": "subtitle", "time": 2323.03, "timestamp": "00:38:43", "text": "首先是我主动联系他吗？"}, {"type": "subtitle", "time": 2324.51, "timestamp": "00:38:44", "text": "他来了吗？"}, {"type": "subtitle", "time": 2327.63, "timestamp": "00:38:47", "text": "我或"}, {"type": "subtitle", "time": 2331.15, "timestamp": "00:38:51", "text": "某物。我不记得了。"}, {"type": "subtitle", "time": 2335.31, "timestamp": "00:38:55", "text": "嗯，我看到的时候超级兴奋。"}, {"type": "subtitle", "time": 2339.589, "timestamp": "00:38:59", "text": "Vic第一次进来的时候"}]
[{"type": "subtitle", "time": 2940.95, "timestamp": "00:49:00", "text": "合作非常成功。虽然我没有说话"}, {"type": "subtitle", "time": 2944.79, "timestamp": "00:49:04", "text": "很多，但合作主办方确保我……"}, {"type": "subtitle", "time": 2949.109, "timestamp": "00:49:09", "text": "受到了关注。我本来没打算去。"}, {"type": "subtitle", "time": 2952.23, "timestamp": "00:49:12", "text": "我的精力水平不能下降。喜欢"}, {"type": "subtitle", "time": 2954.75, "timestamp": "00:49:14", "text": "那是D的巅峰。"}, {"type": "subtitle", "time": 2956.75, "timestamp": "00:49:16", "text": "那是"}, {"type": "subtitle", "time": 2961.15, "timestamp": "00:49:21", "text": "顶峰。真是太糟糕了"}, {"type": "subtitle", "time": 2964.15, "timestamp": "00:49:24", "text": "凉爽的。而这正是我所想的。"}, {"type": "subtitle", "time": 2968.19, "timestamp": "00:49:28", "text": "我也想做到这一点，这也是我的目标之一。"}, {"type": "subtitle", "time": 2972.549, "timestamp": "00:49:32", "text": "要达到那个水平"}, {"type": "subtitle", "time": 2976.27, "timestamp": "00:49:36", "text": "我永远不会再做拼贴画了"}, {"type": "subtitle", "time": 2979.75, "timestamp": "00:49:39", "text": "合作。我还想确保"}, {"type": "subtitle", "time": 2981.99, "timestamp": "00:49:41", "text": "一切都如我所愿，因为我"}, {"type": "subtitle", "time": 2983.71, "timestamp": "00:49:43", "text": "举办这个活动的那个人"}, {"type": "subtitle", "time": 2987.03, "timestamp": "00:49:47", "text": "合作。我希望我的合作者"}, {"type": "subtitle", "time": 2990.87, "timestamp": "00:49:50", "text": "尽情享受，玩得开心。而且"}, {"type": "subtitle", "time": 2992.71, "timestamp": "00:49:52", "text": "呃，正在观看的观众们"}, {"type": "subtitle", "time": 2995.43, "timestamp": "00:49:55", "text": "来自我们所有社区的东西"}, {"type": "subtitle", "time": 2997.67, "timestamp": "00:49:57", "text": "不同的社区，他们都"}]
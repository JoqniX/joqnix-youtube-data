[{"type": "subtitle", "time": 17221.55, "timestamp": "04:47:01", "text": "培训其他主播，让他们更加出色"}, {"type": "subtitle", "time": 17226.628, "timestamp": "04:47:06", "text": "认真什么的，但也有……嗯"}, {"type": "subtitle", "time": 17228.628, "timestamp": "04:47:08", "text": "我当时无法理解，而且"}, {"type": "subtitle", "time": 17232.868, "timestamp": "04:47:12", "text": "明白为什么你会这样"}, {"type": "subtitle", "time": 17235.03, "timestamp": "04:47:15", "text": "你知道，就像你就像"}, {"type": "subtitle", "time": 17239.43, "timestamp": "04:47:19", "text": "按照这种形式思考。好的。喜欢"}, {"type": "subtitle", "time": 17242.23, "timestamp": "04:47:22", "text": "呃，你想成为朋友，喜欢"}, {"type": "subtitle", "time": 17244.23, "timestamp": "04:47:24", "text": "你想交朋友。你走近"}, {"type": "subtitle", "time": 17247.03, "timestamp": "04:47:27", "text": "朋友之间变得亲近起来"}, {"type": "subtitle", "time": 17249.11, "timestamp": "04:47:29", "text": "成为朋友并非自然而然发生的。"}, {"type": "subtitle", "time": 17251.75, "timestamp": "04:47:31", "text": "很快。现在这需要时间。不。但是……"}, {"type": "subtitle", "time": 17254.11, "timestamp": "04:47:34", "text": "像这样的人"}, {"type": "subtitle", "time": 17257.51, "timestamp": "04:47:37", "text": "呃，就像当面指责你，或者说……"}, {"type": "subtitle", "time": 17259.91, "timestamp": "04:47:39", "text": "你们都喜欢羞辱自己的身材吗？"}, {"type": "subtitle", "time": 17261.35, "timestamp": "04:47:41", "text": "你就像个书呆子似的。我"}, {"type": "subtitle", "time": 17263.11, "timestamp": "04:47:43", "text": "不想和书呆子做朋友"}, {"type": "subtitle", "time": 17265.83, "timestamp": "04:47:45", "text": "某物。感觉就是这样。我是"}, {"type": "subtitle", "time": 17274.55, "timestamp": "04:47:54", "text": "哇。我不知道。但感觉有点像"}, {"type": "subtitle", "time": 17276.27, "timestamp": "04:47:56", "text": "有点奇怪"}, {"type": "subtitle", "time": 17278.47, "timestamp": "04:47:58", "text": "这就是我为什么说它会触发的原因。"}]
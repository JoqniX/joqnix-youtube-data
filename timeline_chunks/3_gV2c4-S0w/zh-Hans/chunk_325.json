[{"type": "subtitle", "time": 19501.83, "timestamp": "05:25:01", "text": "我真的很想做我过去限制的事情"}, {"type": "subtitle", "time": 19503.59, "timestamp": "05:25:03", "text": "我自己也说过，啊，这不高。"}, {"type": "subtitle", "time": 19506.31, "timestamp": "05:25:06", "text": "质量还不错。我以前喜欢跑步"}, {"type": "subtitle", "time": 19509.27, "timestamp": "05:25:09", "text": "远离它。所以我正在使用这个"}, {"type": "subtitle", "time": 19512.99, "timestamp": "05:25:12", "text": "运动马拉松是一种缓慢表达喜爱的方式"}, {"type": "subtitle", "time": 19515.51, "timestamp": "05:25:15", "text": "慢慢地去做我真正想做的事情"}, {"type": "subtitle", "time": 19519.27, "timestamp": "05:25:19", "text": "去做，并对自己更有信心。"}, {"type": "subtitle", "time": 19520.868, "timestamp": "05:25:20", "text": "实际上"}, {"type": "subtitle", "time": 19524.91, "timestamp": "05:25:24", "text": "嗯，是的，确实花时间陪陪我"}, {"type": "subtitle", "time": 19527.868, "timestamp": "05:25:27", "text": "社区妥善和"}, {"type": "subtitle", "time": 19531.43, "timestamp": "05:25:31", "text": "一切。嗨，你要去……"}, {"type": "subtitle", "time": 19533.03, "timestamp": "05:25:33", "text": "你会去，而且说话会很吃力。"}, {"type": "subtitle", "time": 19534.27, "timestamp": "05:25:34", "text": "在"}, {"type": "subtitle", "time": 19537.75, "timestamp": "05:25:37", "text": "日本。我能应付。记住，我要走了"}, {"type": "subtitle", "time": 19541.19, "timestamp": "05:25:41", "text": "去那里学习日语，对吧？它"}, {"type": "subtitle", "time": 19550.708, "timestamp": "05:25:50", "text": "美好的。我希望它会很好。我相信"}, {"type": "subtitle", "time": 19555.39, "timestamp": "05:25:55", "text": "我。"}, {"type": "subtitle", "time": 19558.15, "timestamp": "05:25:58", "text": "是的。我们只有在三或三个月后才能知道。"}]
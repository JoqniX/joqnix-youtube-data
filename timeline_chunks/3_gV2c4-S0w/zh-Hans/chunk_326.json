[{"type": "subtitle", "time": 19562.39, "timestamp": "05:26:02", "text": "四个月后我会是什么样子？将要"}, {"type": "subtitle", "time": 19566.47, "timestamp": "05:26:06", "text": "我疏忽了日语学习？我会吗？"}, {"type": "subtitle", "time": 19568.39, "timestamp": "05:26:08", "text": "实际上投入了时间和精力"}, {"type": "subtitle", "time": 19570.708, "timestamp": "05:26:10", "text": "真的会和人社交吗？"}, {"type": "subtitle", "time": 19573.47, "timestamp": "05:26:13", "text": "我是个铁杆粉丝"}, {"type": "subtitle", "time": 19575.67, "timestamp": "05:26:15", "text": "内向者。请问您是印度人吗？"}, {"type": "subtitle", "time": 19577.07, "timestamp": "05:26:17", "text": "是的，我来自"}, {"type": "subtitle", "time": 19579.39, "timestamp": "05:26:19", "text": "印度。我是印度人"}, {"type": "subtitle", "time": 19588.07, "timestamp": "05:26:28", "text": "是的。我觉得我应该像我一样写上“我”"}, {"type": "subtitle", "time": 19591.03, "timestamp": "05:26:31", "text": "我觉得踢板上有面板。我应该"}, {"type": "subtitle", "time": 19594.07, "timestamp": "05:26:34", "text": "就像我在Twitch上直播的那种内容一样，"}, {"type": "subtitle", "time": 19596.23, "timestamp": "05:26:36", "text": "正确的？ Twitch 控制面板相关内容。我这就去"}, {"type": "subtitle", "time": 19598.67, "timestamp": "05:26:38", "text": "复制粘贴到踢脚板，我"}, {"type": "subtitle", "time": 19602.67, "timestamp": "05:26:42", "text": "猜测。嗯，所以"}, {"type": "subtitle", "time": 19605.708, "timestamp": "05:26:45", "text": "是的。当然。"}, {"type": "subtitle", "time": 19609.19, "timestamp": "05:26:49", "text": "当然。所以，呃，是的。呃，即使它是"}, {"type": "subtitle", "time": 19611.43, "timestamp": "05:26:51", "text": "就像订阅按钮一样，别……呃，你可能"}, {"type": "subtitle", "time": 19612.99, "timestamp": "05:26:52", "text": "就像……一样好奇。"}, {"type": "subtitle", "time": 19616.15, "timestamp": "05:26:56", "text": "哦，有人给你捐款吗？是"}, {"type": "subtitle", "time": 19618.47, "timestamp": "05:26:58", "text": "计时器因以下原因而增加"}]
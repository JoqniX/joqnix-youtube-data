[{"type": "subtitle", "time": 6601.99, "timestamp": "01:50:01", "text": "呃，钻头之类的东西。"}, {"type": "subtitle", "time": 6604.87, "timestamp": "01:50:04", "text": "没关系。你做完之后我可以做。"}, {"type": "subtitle", "time": 6614.87, "timestamp": "01:50:14", "text": "我的天啊。齿轮机械"}, {"type": "subtitle", "time": 6621.55, "timestamp": "01:50:21", "text": "有一个"}, {"type": "subtitle", "time": 6625.189, "timestamp": "01:50:25", "text": "蛋糕，伙计。我想建一座工厂。"}, {"type": "subtitle", "time": 6628.149, "timestamp": "01:50:28", "text": "我还是会，你想要，你想要"}, {"type": "subtitle", "time": 6631.109, "timestamp": "01:50:31", "text": "建工厂？你可以坐火车。"}, {"type": "subtitle", "time": 6633.83, "timestamp": "01:50:33", "text": "搞什么鬼？"}, {"type": "subtitle", "time": 6635.43, "timestamp": "01:50:35", "text": "你想建一家工厂吗？然后我"}, {"type": "subtitle", "time": 6638.03, "timestamp": "01:50:38", "text": "可以添加创意模式。"}, {"type": "subtitle", "time": 6647.43, "timestamp": "01:50:47", "text": "但我的意思是，这将是一种全新的视角。"}, {"type": "subtitle", "time": 6648.99, "timestamp": "01:50:48", "text": "我的世界"}, {"type": "subtitle", "time": 6652.35, "timestamp": "01:50:52", "text": "猜测。哦，我的天"}, {"type": "subtitle", "time": 6655.99, "timestamp": "01:50:55", "text": "上帝。这到底是什么？"}, {"type": "subtitle", "time": 6659.189, "timestamp": "01:50:59", "text": "我又要掉线了。是的，我需要"}]
[{"type": "subtitle", "time": 11101.51, "timestamp": "03:05:01", "text": "等等，如果你在……点餐，我得问问。"}, {"type": "subtitle", "time": 11103.91, "timestamp": "03:05:03", "text": "凌晨5点或4点之类的，会"}, {"type": "subtitle", "time": 11113.83, "timestamp": "03:05:13", "text": "嗯？等等，所以人们整夜熬夜"}, {"type": "subtitle", "time": 11115.429, "timestamp": "03:05:15", "text": "还是别的什么？有夜班，"}, {"type": "subtitle", "time": 11118.15, "timestamp": "03:05:18", "text": "外卖所需物品。"}, {"type": "subtitle", "time": 11126.23, "timestamp": "03:05:26", "text": "看，是你。"}, {"type": "subtitle", "time": 11133.83, "timestamp": "03:05:33", "text": "好吧，你知道吗？"}, {"type": "subtitle", "time": 11136.309, "timestamp": "03:05:36", "text": "等等，让我用卫生纸缠住你。"}, {"type": "subtitle", "time": 11139.67, "timestamp": "03:05:39", "text": "哦，你这是在用卫生纸包我。别让我上台。"}, {"type": "subtitle", "time": 11143.59, "timestamp": "03:05:43", "text": "好的。好的。你好。好的。终于到了这里。"}, {"type": "subtitle", "time": 11147.309, "timestamp": "03:05:47", "text": "看到这一部分了吗？什么？"}, {"type": "subtitle", "time": 11152.389, "timestamp": "03:05:52", "text": "好的。这是什么模块？这太疯狂了。"}, {"type": "subtitle", "time": 11154.79, "timestamp": "03:05:54", "text": "等待。做什么？你们不是"}]
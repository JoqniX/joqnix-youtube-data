[{"type": "subtitle", "time": 3441.589, "timestamp": "00:57:21", "text": "你就这样离开了吗？是的，我在这里。我是"}, {"type": "subtitle", "time": 3445.51, "timestamp": "00:57:25", "text": "在教会工作。你好。我本来打算"}, {"type": "subtitle", "time": 3447.67, "timestamp": "00:57:27", "text": "加入你们。我正要点击"}, {"type": "subtitle", "time": 3451.589, "timestamp": "00:57:31", "text": "继续，哇。不，我当时是。"}, {"type": "subtitle", "time": 3453.27, "timestamp": "00:57:33", "text": "听着你所有的cono，就像在"}, {"type": "subtitle", "time": 3458.47, "timestamp": "00:57:38", "text": "背景。是啊，简直蠢到家了。讲话"}, {"type": "subtitle", "time": 3468.27, "timestamp": "00:57:48", "text": "我不认为我配得上那份礼物。"}]
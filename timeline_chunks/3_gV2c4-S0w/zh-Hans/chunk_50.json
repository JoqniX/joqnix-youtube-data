[{"type": "subtitle", "time": 3006.87, "timestamp": "00:50:06", "text": "这东西太酷了，但是，嗯，还有……"}, {"type": "subtitle", "time": 3009.03, "timestamp": "00:50:09", "text": "就像人们做事的方式不同一样。"}, {"type": "subtitle", "time": 3012.27, "timestamp": "00:50:12", "text": "这取决于人们是否"}, {"type": "subtitle", "time": 3015.829, "timestamp": "00:50:15", "text": "是的，我的意思是，对我来说，如果我认为"}, {"type": "subtitle", "time": 3017.23, "timestamp": "00:50:17", "text": "关于"}, {"type": "subtitle", "time": 3021.19, "timestamp": "00:50:21", "text": "如果说到乔森，很多"}, {"type": "subtitle", "time": 3024.309, "timestamp": "00:50:24", "text": "我在我的频道里做过的事情，如果我"}, {"type": "subtitle", "time": 3026.79, "timestamp": "00:50:26", "text": "曾投入时间和精力喜欢"}, {"type": "subtitle", "time": 3028.27, "timestamp": "00:50:28", "text": "专业化"}, {"type": "subtitle", "time": 3032.87, "timestamp": "00:50:32", "text": "我可以做得比他好得多"}, {"type": "subtitle", "time": 3035.87, "timestamp": "00:50:35", "text": "我现在正在做。但"}, {"type": "subtitle", "time": 3039.03, "timestamp": "00:50:39", "text": "再说一遍，做得更好"}, {"type": "subtitle", "time": 3042.069, "timestamp": "00:50:42", "text": "所有事情都需要更多人帮忙。"}, {"type": "subtitle", "time": 3045.27, "timestamp": "00:50:45", "text": "是你，对吧？并非所有事你都能做到"}, {"type": "subtitle", "time": 3047.829, "timestamp": "00:50:47", "text": "完全靠你自己。不，那就是我"}, {"type": "subtitle", "time": 3049.15, "timestamp": "00:50:49", "text": "明白了。"}, {"type": "subtitle", "time": 3051.829, "timestamp": "00:50:51", "text": "有时你会觉得那是一个"}, {"type": "subtitle", "time": 3053.51, "timestamp": "00:50:53", "text": "好主意，你想做，但是也"}, {"type": "subtitle", "time": 3056.069, "timestamp": "00:50:56", "text": "如果有人能给你一个"}, {"type": "subtitle", "time": 3058.71, "timestamp": "00:50:58", "text": "更好的主意，你会从中获得灵感。"}]
[{"type": "subtitle", "time": 2882.15, "timestamp": "00:48:02", "text": "為了和Vick合作，也為了其他在亞洲"}, {"type": "subtitle", "time": 2893.67, "timestamp": "00:48:13", "text": "伺服器玩原神的主播們，我做了很多事。遊戲剛推出的時候，我正在歐洲。是的，我做出了一個重大決定，轉到亞洲伺服器，而這絕對是我做過的最正確的"}, {"type": "subtitle", "time": 2908.95, "timestamp": "00:48:28", "text": "決定"}]
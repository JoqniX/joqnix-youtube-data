[{"type": "subtitle", "time": 22097.31, "timestamp": "06:08:17", "text": "我們能通個電話，把事情理清楚，看看這樣是否可行。在繼續討論之前，"}, {"type": "chat", "time": 22100.756, "timestamp": "06:08:20", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "You can watch these fragments of a memories here- https://onxa.link/blsM2qpP"}, {"type": "subtitle", "time": 22105.35, "timestamp": "06:08:25", "text": "我說，他們當時就像在問我，我不理解合作的目的。我當時就想，兄弟，然後又把整件事解釋了一遍。"}, {"type": "subtitle", "time": 22119.11, "timestamp": "06:08:39", "text": "我為什麼要合作？為什麼他們會這樣假設"}, {"type": "subtitle", "time": 22123.43, "timestamp": "06:08:43", "text": "？是的，他們"}, {"type": "subtitle", "time": 22125.39, "timestamp": "06:08:45", "text": "真的假設，如果我們兩個合作，就像我試圖"}, {"type": "subtitle", "time": 22131.51, "timestamp": "06:08:51", "text": "追逐他們，竊取他們的觀眾或其他什麼，為了自己的利益，為了自己的錢或其他什麼。他們"}, {"type": "subtitle", "time": 22138.11, "timestamp": "06:08:58", "text": "呃，或者類似的事情。他們甚至問我，我想向誰證明什麼"}]
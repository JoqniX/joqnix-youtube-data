[{"type": "subtitle", "time": 36300.15, "timestamp": "10:05:00", "text": "加油。填滿它。填滿它。完成它。A。這是我達到的最高點。我的天哪。太棒了。我敢肯定。這真的很酷。"}, {"type": "subtitle", "time": 36318.71, "timestamp": "10:05:18", "text": "嗨，我們完成了第一個。哦，"}, {"type": "subtitle", "time": 36329.83, "timestamp": "10:05:29", "text": "不錯。我們得到了這個。一把劍。一把傘。還有一個這個和還有一些也快來了。不知道"}, {"type": "subtitle", "time": 36333.23, "timestamp": "10:05:33", "text": "我們能不能完成"}, {"type": "subtitle", "time": 36337.11, "timestamp": "10:05:37", "text": "。[音樂][音樂]我們會探索"}, {"type": "subtitle", "time": 36339.55, "timestamp": "10:05:39", "text": "這個。 好的。這是"}, {"type": "subtitle", "time": 36344.39, "timestamp": "10:05:44", "text": "什麼？好大一個東西。我的"}, {"type": "subtitle", "time": 36346.63, "timestamp": "10:05:46", "text": "天哪。哦，那不是。哦。哦。哦。哦。所以沒有呃……這個東西。哦[音樂] 我的天。我的天。哦"}, {"type": "subtitle", "time": 36356.63, "timestamp": "10:05:56", "text": "，有個加載增益。什麼？[音樂][音樂][音樂] 嗨。"}]
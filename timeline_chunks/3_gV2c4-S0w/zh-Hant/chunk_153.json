[{"type": "subtitle", "time": 9199.59, "timestamp": "02:33:19", "text": "你想蓋一間工廠嗎？你可以坐"}, {"type": "subtitle", "time": 9219.67, "timestamp": "02:33:39", "text": "火車。  搞什麼鬼？  你想蓋一家工廠嗎？然後我就可以加入創造模式"}, {"type": "subtitle", "time": 9228.79, "timestamp": "02:33:48", "text": "模組了。  是的。但該如何添加呢？  但"}, {"type": "subtitle", "time": 9231.91, "timestamp": "02:33:51", "text": "我的意思是，這大概會是《我的世界》的一種全新玩法吧。我的天啊。這到底是什麼？  我又要掉線了。是的，我"}, {"type": "subtitle", "time": 9234.15, "timestamp": "02:33:54", "text": "需要再次"}]
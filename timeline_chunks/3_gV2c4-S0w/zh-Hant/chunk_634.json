[{"type": "subtitle", "time": 38047.266, "timestamp": "10:34:07", "text": "不。嗯？"}, {"type": "subtitle", "time": 38049.51, "timestamp": "10:34:09", "text": "我的天哪。沒人告訴我這件事。我的天啊。這段時間一直沒有聲音。我的天啊。"}, {"type": "subtitle", "time": 38053.51, "timestamp": "10:34:13", "text": "為什麼沒人覺得沒關係"}, {"type": "subtitle", "time": 38055.906, "timestamp": "10:34:15", "text": "？沒關係。  歡迎回來。謝謝。  [音樂] ["}]
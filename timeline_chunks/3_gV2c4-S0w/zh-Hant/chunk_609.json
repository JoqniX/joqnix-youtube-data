[{"type": "subtitle", "time": 36545.586, "timestamp": "10:09:05", "text": "，我"}, {"type": "subtitle", "time": 36554.586, "timestamp": "10:09:14", "text": "不會奮鬥，但我就是"}, {"type": "subtitle", "time": 36557.71, "timestamp": "10:09:17", "text": "想把它磨掉。沒關係。  我（音樂）估計慢慢地會把他升到40級左右。 48 [音樂] 16."}, {"type": "subtitle", "time": 36564.266, "timestamp": "10:09:24", "text": "嘿，這讓我想起了我自己，但我愛他。"}, {"type": "subtitle", "time": 36596.71, "timestamp": "10:09:56", "text": "。總有一天要把本尼送到AD去。我可以用這個技能許一個願望。"}]
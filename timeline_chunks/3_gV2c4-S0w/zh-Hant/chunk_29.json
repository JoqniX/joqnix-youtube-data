[{"type": "subtitle", "time": 1756.99, "timestamp": "00:29:16", "text": "我的意思是，現在的問題是，即使我個人沒有很好的體驗，但顯然更多的人對小頻道過於苛刻等等。諸如此類的事情很多，嗯，是的，我的意思是，"}, {"type": "subtitle", "time": 1768.19, "timestamp": "00:29:28", "text": "我無法想像"}, {"type": "subtitle", "time": 1772.71, "timestamp": "00:29:32", "text": "如果我成為一個更大的頻道，我會變成那樣。"}, {"type": "subtitle", "time": 1788.83, "timestamp": "00:29:48", "text": "比如說，如果我達到 1k，我可能會被認為是"}]
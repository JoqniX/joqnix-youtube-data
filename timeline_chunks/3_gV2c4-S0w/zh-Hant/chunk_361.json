[{"type": "subtitle", "time": 21679.51, "timestamp": "06:01:19", "text": "做朋友。感覺就是這樣。"}, {"type": "subtitle", "time": 21684.708, "timestamp": "06:01:24", "text": "我當時就覺得，哇！我不知道。但"}, {"type": "subtitle", "time": 21690.19, "timestamp": "06:01:30", "text": "我覺得有點奇怪，這就是我為什麼說它會引發不同反應的原因。他們必須"}, {"type": "subtitle", "time": 21703.35, "timestamp": "06:01:43", "text": "考慮一下。  但再次強調，這"}]
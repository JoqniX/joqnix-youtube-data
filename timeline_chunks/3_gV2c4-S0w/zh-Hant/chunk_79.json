[{"type": "subtitle", "time": 4747.83, "timestamp": "01:19:07", "text": "因為這些是我們新增的"}, {"type": "subtitle", "time": 4752.79, "timestamp": "01:19:12", "text": "模組，對吧？我在考慮移除你添加的那個"}, {"type": "subtitle", "time": 4756.229, "timestamp": "01:19:16", "text": "鑽孔模組。啊，對，移除它。"}, {"type": "subtitle", "time": 4767.669, "timestamp": "01:19:27", "text": "我想可能是我跟你說過那個模組，你知道，就是當你離開的時候它會…"}, {"type": "subtitle", "time": 4769.99, "timestamp": "01:19:29", "text": "嗯，那個。好的。是的，我們應該移除它，因為它會一直渲染世界上的每個區塊。哦"}, {"type": "subtitle", "time": 4780.47, "timestamp": "01:19:40", "text": "，可能是那個。呃，"}, {"type": "subtitle", "time": 4786.63, "timestamp": "01:19:46", "text": "試試看移除一個，看看性能怎麼樣。我應該直接從遊戲資料夾移除"}, {"type": "subtitle", "time": 4791.35, "timestamp": "01:19:51", "text": "它嗎？呃，是的，有些"}]
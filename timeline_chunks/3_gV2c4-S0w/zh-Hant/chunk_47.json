[{"type": "subtitle", "time": 2831.55, "timestamp": "00:47:11", "text": "實際上只聊了30分鐘。不過我們聊得越多，就越覺得聊得很投機。我問了他關於"}, {"type": "subtitle", "time": 2848.47, "timestamp": "00:47:28", "text": "Emma"}, {"type": "subtitle", "time": 2852.79, "timestamp": "00:47:32", "text": "Balot的事，他也問了我一些問題。現在我有點懵了，就覺得跟他聊天真的很開心。那天我們玩了兩個多小時的原神，他告訴我，嗯，你得達到"}, {"type": "subtitle", "time": 2867.19, "timestamp": "00:47:47", "text": "45級，或是430級左右。"}, {"type": "subtitle", "time": 2872.15, "timestamp": "00:47:52", "text": "當時我剛開始玩原神，在亞洲伺服器，我是個超級新手。"}]
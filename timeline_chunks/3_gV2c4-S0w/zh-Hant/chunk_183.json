[{"type": "subtitle", "time": 10981.51, "timestamp": "03:03:01", "text": "美好的"}, {"type": "subtitle", "time": 10983.83, "timestamp": "03:03:03", "text": "星期一。  看看我做了什麼。我需要"}, {"type": "subtitle", "time": 10998.91, "timestamp": "03:03:18", "text": "把整棵樹都點亮。  呃，就像樹枝之類的東西。你看，現在它會生成怪物了。  好的，查一下。  咬。嘿"}, {"type": "subtitle", "time": 11026.67, "timestamp": "03:03:46", "text": "，那裡"}]
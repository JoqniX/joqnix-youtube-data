[{"type": "subtitle", "time": 18720.948, "timestamp": "05:12:00", "text": "そう言ってください。それについては話したくない。"}, {"type": "subtitle", "time": 18724.868, "timestamp": "05:12:04", "text": "私は持っているだろう。あ、待って。何？"}, {"type": "subtitle", "time": 18727.03, "timestamp": "05:12:07", "text": "もう手遅れだ。"}, {"type": "subtitle", "time": 18728.628, "timestamp": "05:12:08", "text": "わかった。"}, {"type": "subtitle", "time": 18730.31, "timestamp": "05:12:10", "text": "待って、もし今それを見たらどうなるんだろう？えっと、"}, {"type": "subtitle", "time": 18734.39, "timestamp": "05:12:14", "text": "オフィスは閉まっていますか？いいえ。何ですか？はぁ？"}, {"type": "subtitle", "time": 18737.11, "timestamp": "05:12:17", "text": "閉店しました。ごめん。もう手遅れだ。クソッ。"}, {"type": "subtitle", "time": 18739.03, "timestamp": "05:12:19", "text": "ええ、さっきはそういう気分だったんですけど"}, {"type": "subtitle", "time": 18743.43, "timestamp": "05:12:23", "text": "今は違う。男。くそ。"}, {"type": "subtitle", "time": 18746.708, "timestamp": "05:12:26", "text": "すべて。彼はそれを欲しがっているのかもしれない。"}, {"type": "subtitle", "time": 18749.83, "timestamp": "05:12:29", "text": "いや、いや。私は自分の瞬間を掴む。"}, {"type": "subtitle", "time": 18751.51, "timestamp": "05:12:31", "text": "君にもすぐにチャンスが訪れるよ。"}, {"type": "subtitle", "time": 18755.35, "timestamp": "05:12:35", "text": "私にもチャンスが来るはずです。おお。おお。の"}, {"type": "subtitle", "time": 18756.948, "timestamp": "05:12:36", "text": "コース。うん。ここに来て。持続する。地獄"}, {"type": "subtitle", "time": 18760.27, "timestamp": "05:12:40", "text": "うん。もちろんさ。もちろんさ。"}, {"type": "subtitle", "time": 18761.67, "timestamp": "05:12:41", "text": "[音楽]"}, {"type": "subtitle", "time": 18766.708, "timestamp": "05:12:46", "text": "やめて。"}, {"type": "subtitle", "time": 18775.99, "timestamp": "05:12:55", "text": "やめてくれよ、みんな。"}, {"type": "subtitle", "time": 18779.03, "timestamp": "05:12:59", "text": "君はどうかしてるよ。なぜこんなことをするのですか？"}]
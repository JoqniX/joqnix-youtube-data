[{"type": "subtitle", "time": 3743.91, "timestamp": "01:02:23", "text": "もしその音を知っているなら、お前を殺してやる。"}, {"type": "subtitle", "time": 3746.549, "timestamp": "01:02:26", "text": "再生をもたらす雪。"}, {"type": "subtitle", "time": 3760.069, "timestamp": "01:02:40", "text": "私の刃を導いてください。どうやって"}, {"type": "subtitle", "time": 3763.589, "timestamp": "01:02:43", "text": "光が侵入している。"}, {"type": "subtitle", "time": 3767.75, "timestamp": "01:02:47", "text": "私はしくじった。音の一つ。"}, {"type": "subtitle", "time": 3770.789, "timestamp": "01:02:50", "text": "共鳴の瞬間。"}]
[{"type": "subtitle", "time": 15421.189, "timestamp": "04:17:01", "text": "いつも"}, {"type": "subtitle", "time": 15423.83, "timestamp": "04:17:03", "text": "彼らが発見するまでに"}, {"type": "subtitle", "time": 15433.429, "timestamp": "04:17:13", "text": "とにかく恋人を燃やしていた"}, {"type": "subtitle", "time": 15435.83, "timestamp": "04:17:15", "text": "死んで、それから彼は言った、それは、それは、"}, {"type": "subtitle", "time": 15437.83, "timestamp": "04:17:17", "text": "他の人。"}, {"type": "subtitle", "time": 15439.67, "timestamp": "04:17:19", "text": "みんなが集まるのを待っていた。"}, {"type": "subtitle", "time": 15441.99, "timestamp": "04:17:21", "text": "皆さんが参加してくれてありがとう"}, {"type": "subtitle", "time": 15443.91, "timestamp": "04:17:23", "text": "あの地域だけ。"}, {"type": "subtitle", "time": 15446.79, "timestamp": "04:17:26", "text": "ちくしょう。それもあなたのアイデアだったよね。何が"}, {"type": "subtitle", "time": 15448.87, "timestamp": "04:17:28", "text": "よし、我々は、我々は"}, {"type": "subtitle", "time": 15451.429, "timestamp": "04:17:31", "text": "君の最初の作品は素晴らしかった。どういう意味"}, {"type": "subtitle", "time": 15454.149, "timestamp": "04:17:34", "text": "私は優秀すぎる？私はそう思います。いいえ。初勝利です。"}, {"type": "subtitle", "time": 15455.99, "timestamp": "04:17:35", "text": "初勝利。私に何を言っているの？"}, {"type": "subtitle", "time": 15458.95, "timestamp": "04:17:38", "text": "初勝利。ああ、いや、そうじゃない。あなたは"}, {"type": "subtitle", "time": 15461.59, "timestamp": "04:17:41", "text": "人を操ったり、あなたが何をするにしても、"}, {"type": "subtitle", "time": 15465.189, "timestamp": "04:17:45", "text": "あなたは勝っています。だから、いいえ。いいえ。いいえ。いいえ。"}, {"type": "subtitle", "time": 15467.349, "timestamp": "04:17:47", "text": "あなたは素晴らしすぎる。わかった。さあ、さあ"}, {"type": "subtitle", "time": 15469.429, "timestamp": "04:17:49", "text": "鳩のロールを取り除くのは実際には"}, {"type": "subtitle", "time": 15472.79, "timestamp": "04:17:52", "text": "勝つのはとても簡単だ。右。右。いいえ、私は"}, {"type": "subtitle", "time": 15474.87, "timestamp": "04:17:54", "text": "理解できなかった。いいえ。何ですか？君たち"}, {"type": "subtitle", "time": 15479.51, "timestamp": "04:17:59", "text": "君たちが人を殺し続けるのを止めないで。"}]
[{"type": "subtitle", "time": 10262.07, "timestamp": "02:51:02", "text": "ゲームもだけど、私は持っていない"}, {"type": "subtitle", "time": 10265.349, "timestamp": "02:51:05", "text": "このゲーム、よく理解できなかった。"}, {"type": "subtitle", "time": 10267.19, "timestamp": "02:51:07", "text": "そう、まさにAmong Usみたいだね。あなたはただ"}, {"type": "subtitle", "time": 10269.269, "timestamp": "02:51:09", "text": "タスクを実行すると、2つあります"}, {"type": "subtitle", "time": 10271.75, "timestamp": "02:51:11", "text": "殺人者とかそんな感じの奴らが"}, {"type": "subtitle", "time": 10274.309, "timestamp": "02:51:14", "text": "とにかく、あなたを殺して、私たちは報告します"}, {"type": "subtitle", "time": 10277.349, "timestamp": "02:51:17", "text": "彼らと、そう、それはただのAmong Usです"}, {"type": "subtitle", "time": 10281.429, "timestamp": "02:51:21", "text": "追加の手順。うん、そっちの方がずっと面白いね。かわいい"}, {"type": "subtitle", "time": 10284.15, "timestamp": "02:51:24", "text": "左手の設定のほとんどが消えてしまいました。私の"}, {"type": "subtitle", "time": 10285.83, "timestamp": "02:51:25", "text": "左手の設定がなくなりました。そして私は"}, {"type": "subtitle", "time": 10287.75, "timestamp": "02:51:27", "text": "設定するために。"}, {"type": "subtitle", "time": 10292.23, "timestamp": "02:51:32", "text": "また、ここでスミのガチョウが"}, {"type": "subtitle", "time": 10295.99, "timestamp": "02:51:35", "text": "ピンクというより、ほとんど赤に近い。"}, {"type": "subtitle", "time": 10298.15, "timestamp": "02:51:38", "text": "つまり、私たちは虚偽広告について話しているわけですね。"}, {"type": "subtitle", "time": 10299.91, "timestamp": "02:51:39", "text": "ここ。"}, {"type": "subtitle", "time": 10304.15, "timestamp": "02:51:44", "text": "ゲーム内。はい。ゲーム内。ああ、私たちは"}, {"type": "subtitle", "time": 10308.55, "timestamp": "02:51:48", "text": "ゲーム内で会話する。そうそう。"}, {"type": "subtitle", "time": 10311.59, "timestamp": "02:51:51", "text": "肌の色を変えるにはどうすればいいですか？えっと、私は"}, {"type": "subtitle", "time": 10314.15, "timestamp": "02:51:54", "text": "たぶんここだと思う"}, {"type": "subtitle", "time": 10316.469, "timestamp": "02:51:56", "text": "ポータルによって。ええ、そうですね。ああ、わかりました。"}, {"type": "subtitle", "time": 10319.67, "timestamp": "02:51:59", "text": "とりあえずゲーム内でミュートして"}]
[{"type": "subtitle", "time": 16471.349, "timestamp": "04:34:31", "text": "わかった。"}, {"type": "subtitle", "time": 16473.79, "timestamp": "04:34:33", "text": "ここで盗みを働いています。"}, {"type": "subtitle", "time": 16479.189, "timestamp": "04:34:39", "text": "何か言い訳はありますか？"}, {"type": "subtitle", "time": 16485.67, "timestamp": "04:34:45", "text": "そんなことをしなくてもいいんだよ。おお"}, {"type": "subtitle", "time": 16488.07, "timestamp": "04:34:48", "text": "なんてことだ、彼は本当に殺人犯だったのか。待って、"}, {"type": "subtitle", "time": 16489.99, "timestamp": "04:34:49", "text": "誰が？"}, {"type": "subtitle", "time": 16492.23, "timestamp": "04:34:52", "text": "何？何か言いたいことはありますか？"}, {"type": "subtitle", "time": 16494.551, "timestamp": "04:34:54", "text": "あなた自身ですか？私は兵士です。私は完了できます"}, {"type": "subtitle", "time": 16496.869, "timestamp": "04:34:56", "text": "タスクをこなしてから、キルを取る。それから彼は言った"}, {"type": "subtitle", "time": 16498.39, "timestamp": "04:34:58", "text": "互いにコンパイルし合う。だから彼は"}]
[{"type": "subtitle", "time": 11700.229, "timestamp": "03:15:00", "text": "ああ、それはあなたが何も知らない場合です"}, {"type": "subtitle", "time": 11704.389, "timestamp": "03:15:04", "text": "トップアサシンの役割を担うんだよね？それは"}, {"type": "subtitle", "time": 11706.18, "timestamp": "03:15:06", "text": "情報。"}, {"type": "subtitle", "time": 11707.269, "timestamp": "03:15:07", "text": "[音楽]"}, {"type": "subtitle", "time": 11712.71, "timestamp": "03:15:12", "text": "妨害行為。"}, {"type": "subtitle", "time": 11723.03, "timestamp": "03:15:23", "text": "これは私の役割を理解するため"}, {"type": "subtitle", "time": 11725.429, "timestamp": "03:15:25", "text": "利用不可。わかった。右上"}, {"type": "subtitle", "time": 11727.269, "timestamp": "03:15:27", "text": "「I」ボタンがあります。クリックすると"}, {"type": "subtitle", "time": 11728.95, "timestamp": "03:15:28", "text": "それと、人々の役割を確認する"}, {"type": "subtitle", "time": 11730.87, "timestamp": "03:15:30", "text": "選択中。"}, {"type": "subtitle", "time": 11732.63, "timestamp": "03:15:32", "text": "そして、自分の役割を正しく理解するようにしてください。"}, {"type": "subtitle", "time": 11734.63, "timestamp": "03:15:34", "text": "今。うん。必ず読んでください"}, {"type": "subtitle", "time": 11736.07, "timestamp": "03:15:36", "text": "ゲーム内ではおそらくロールできないので、今すぐロールしてください"}, {"type": "subtitle", "time": 11737.99, "timestamp": "03:15:37", "text": "説明文で確認できるが"}, {"type": "subtitle", "time": 11739.429, "timestamp": "03:15:39", "text": "他の説明もご覧いただけます"}, {"type": "subtitle", "time": 11741.429, "timestamp": "03:15:41", "text": "役割。問題は、私には見えないということです"}, {"type": "subtitle", "time": 11744.15, "timestamp": "03:15:44", "text": "役割。えっと"}, {"type": "subtitle", "time": 11746.15, "timestamp": "03:15:46", "text": "ランダムに選ばれたもの。わかった。うん。あなたは"}, {"type": "subtitle", "time": 11747.51, "timestamp": "03:15:47", "text": "ランダムな役割ですよね？画面に表示されているように"}, {"type": "subtitle", "time": 11749.67, "timestamp": "03:15:49", "text": "何か理由があるに違いない。それがあなたの役割です。"}, {"type": "subtitle", "time": 11752.309, "timestamp": "03:15:52", "text": "でも、それは言わないで。そんなことは言わないで"}, {"type": "subtitle", "time": 11754.229, "timestamp": "03:15:54", "text": "けれど。あなたには役割が与えられましたが、私は"}, {"type": "subtitle", "time": 11756.469, "timestamp": "03:15:56", "text": "本当に理解できないのは、"}, {"type": "subtitle", "time": 11758.87, "timestamp": "03:15:58", "text": "それに関する情報はありません。"}]
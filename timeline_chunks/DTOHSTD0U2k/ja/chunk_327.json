[{"type": "subtitle", "time": 19636.708, "timestamp": "05:27:16", "text": "ああ、こんにちは、ジョー。"}, {"type": "subtitle", "time": 19638.868, "timestamp": "05:27:18", "text": "こんにちは。"}, {"type": "subtitle", "time": 19643.11, "timestamp": "05:27:23", "text": "私は、えっと、私はFKでした。こんにちは。はい。こんにちは。よお"}, {"type": "subtitle", "time": 19645.67, "timestamp": "05:27:25", "text": "おい、こっちへ来い。私たちはグループを形成します。私たちは"}, {"type": "subtitle", "time": 19649.91, "timestamp": "05:27:29", "text": "アリバイを作る。私は怖いです"}, {"type": "subtitle", "time": 19651.91, "timestamp": "05:27:31", "text": "ハトですよね？そっちの方がいいですよね？"}, {"type": "subtitle", "time": 19653.19, "timestamp": "05:27:33", "text": "想像する。わかった。わかった。わかった。わかった。考える"}, {"type": "subtitle", "time": 19654.708, "timestamp": "05:27:34", "text": "そんな感じだ。私は死にたくない。何"}, {"type": "subtitle", "time": 19656.708, "timestamp": "05:27:36", "text": "どちらか一方が大丈夫であれば。わかった。わかった。もし"}, {"type": "subtitle", "time": 19658.39, "timestamp": "05:27:38", "text": "ジョックが私を殺したら、あなたは報告することになる"}, {"type": "subtitle", "time": 19660.07, "timestamp": "05:27:40", "text": "それ。もし私がジョックを殺したら、あなたはそれを見ることができるでしょう。"}, {"type": "subtitle", "time": 19662.788, "timestamp": "05:27:42", "text": "そして、もし私があなたを殺したら、あなたはそれを見ることができるでしょう？"}, {"type": "subtitle", "time": 19666.23, "timestamp": "05:27:46", "text": "だから、それは理にかなっている。"}, {"type": "subtitle", "time": 19668.23, "timestamp": "05:27:48", "text": "何だって？とても面白い。わからない。"}, {"type": "subtitle", "time": 19672.23, "timestamp": "05:27:52", "text": "動けません。はぁ？一体どういうことだ？私は"}, {"type": "subtitle", "time": 19674.788, "timestamp": "05:27:54", "text": "立ち往生。何？助けて。ああ、心配しないでください。"}, {"type": "subtitle", "time": 19676.39, "timestamp": "05:27:56", "text": "あなたは近くにいます。兄弟姉妹よ、私は"}, {"type": "subtitle", "time": 19677.91, "timestamp": "05:27:57", "text": "立ち往生。"}]
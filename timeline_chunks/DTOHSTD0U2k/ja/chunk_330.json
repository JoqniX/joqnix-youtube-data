[{"type": "subtitle", "time": 19805.11, "timestamp": "05:30:05", "text": "私から。やあ、ハン、元気かい？"}, {"type": "subtitle", "time": 19807.99, "timestamp": "05:30:07", "text": "相棒？おい、"}, {"type": "subtitle", "time": 19810.23, "timestamp": "05:30:10", "text": "なぜ、なぜ私を怖がらせたの？いや、いや、いや。"}, {"type": "subtitle", "time": 19812.31, "timestamp": "05:30:12", "text": "問題はここですよね？よし、それでは"}, {"type": "subtitle", "time": 19816.31, "timestamp": "05:30:16", "text": "殺人事件が発生した。いいえ、殺害は起こりました"}, {"type": "subtitle", "time": 19818.39, "timestamp": "05:30:18", "text": "できるけど、それは分からない。私はそうは思わない"}, {"type": "subtitle", "time": 19821.59, "timestamp": "05:30:21", "text": "それを知っておくべきだ。それは知りません。わかった、"}, {"type": "subtitle", "time": 19823.75, "timestamp": "05:30:23", "text": "聞く。はい、ハンハン。私たちはそれぞれを通り過ぎた"}, {"type": "subtitle", "time": 19826.948, "timestamp": "05:30:26", "text": "もう一つ。あなたは私が広場を通り過ぎるのを見た。"}, {"type": "subtitle", "time": 19829.51, "timestamp": "05:30:29", "text": "あまり覚えていない。見たことがない"}, {"type": "subtitle", "time": 19831.51, "timestamp": "05:30:31", "text": "私はそれを見ていませんでした。おお、"}, {"type": "subtitle", "time": 19833.59, "timestamp": "05:30:33", "text": "まったくもう。私たちは広場を通り過ぎた"}, {"type": "subtitle", "time": 19835.75, "timestamp": "05:30:35", "text": "一緒に。私は礼拝堂の近くまで降りて行った"}, {"type": "subtitle", "time": 19838.15, "timestamp": "05:30:38", "text": "そして墓地と私が"}, {"type": "subtitle", "time": 19839.99, "timestamp": "05:30:39", "text": "死体の上で彼を見て、彼は押した"}, {"type": "subtitle", "time": 19841.51, "timestamp": "05:30:41", "text": "通り過ぎた途端に報告"}, {"type": "subtitle", "time": 19846.39, "timestamp": "05:30:46", "text": "ちなみに、こちらです。私はただあなたに"}, {"type": "subtitle", "time": 19851.27, "timestamp": "05:30:51", "text": "知る。私は生き延びようとしている。"}, {"type": "subtitle", "time": 19854.47, "timestamp": "05:30:54", "text": "うん。皆さんはどうやって生きていますか？"}, {"type": "subtitle", "time": 19856.15, "timestamp": "05:30:56", "text": "みんなで力を合わせている。つまり、私は"}, {"type": "subtitle", "time": 19857.51, "timestamp": "05:30:57", "text": "まあ、公平に言うと、もしみんなが"}, {"type": "subtitle", "time": 19859.03, "timestamp": "05:30:59", "text": "このイベントのように固く結びつく、ああ、"}]
[{"type": "subtitle", "time": 16990.708, "timestamp": "04:43:10", "text": "私は誰かを見かけた。こんにちは。"}, {"type": "subtitle", "time": 16993.43, "timestamp": "04:43:13", "text": "わかった。ああ、君のことは分かったよ。こんにちは、ジョア。どうやって"}, {"type": "subtitle", "time": 16996.39, "timestamp": "04:43:16", "text": "何をしているの？こんにちは。"}, {"type": "subtitle", "time": 17006.948, "timestamp": "04:43:26", "text": "私の思考はどこにあるのだろう？"}, {"type": "subtitle", "time": 17012.23, "timestamp": "04:43:32", "text": "こんにちは。"}, {"type": "subtitle", "time": 17025.19, "timestamp": "04:43:45", "text": "ゆっくり進めたかったんです。想像する"}, {"type": "subtitle", "time": 17027.83, "timestamp": "04:43:47", "text": "考え"}, {"type": "subtitle", "time": 17029.83, "timestamp": "04:43:49", "text": "想像する。"}, {"type": "subtitle", "time": 17032.39, "timestamp": "04:43:52", "text": "友人を殺すのは難しい。ええ、私は知っていました"}, {"type": "subtitle", "time": 17035.19, "timestamp": "04:43:55", "text": "あなたはレネではなかった。ええ、わかっています。だって君は"}, {"type": "subtitle", "time": 17037.67, "timestamp": "04:43:57", "text": "ハトだった。"}]
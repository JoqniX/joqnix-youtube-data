[{"type": "subtitle", "time": 17464.55, "timestamp": "04:51:04", "text": "そして、お腹の中で懇願している。おお、"}, {"type": "subtitle", "time": 17466.07, "timestamp": "04:51:06", "text": "ヨシ、"}, {"type": "subtitle", "time": 17468.868, "timestamp": "04:51:08", "text": "私にさせてください"}, {"type": "subtitle", "time": 17472.15, "timestamp": "04:51:12", "text": "全員外に出た。私はできません、私はできません"}, {"type": "subtitle", "time": 17474.23, "timestamp": "04:51:14", "text": "君は出て行くよ、わかるだろ、でも、"}, {"type": "subtitle", "time": 17476.31, "timestamp": "04:51:16", "text": "誰かが私を殺した、そしてそれは起こった。それで、"}, {"type": "subtitle", "time": 17479.03, "timestamp": "04:51:19", "text": "ええ、まさに今それが起こりました。"}, {"type": "subtitle", "time": 17480.788, "timestamp": "04:51:20", "text": "それに、周りに人がいたから"}, {"type": "subtitle", "time": 17484.07, "timestamp": "04:51:24", "text": "あなたと話します。ああ、有名人。"}, {"type": "subtitle", "time": 17486.628, "timestamp": "04:51:26", "text": "有名人。有名人。"}, {"type": "subtitle", "time": 17487.59, "timestamp": "04:51:27", "text": "それはいつ死んだのですか？みんなが"}, {"type": "subtitle", "time": 17489.51, "timestamp": "04:51:29", "text": "通知済み。正直言って、ピンク色がある"}, {"type": "subtitle", "time": 17491.43, "timestamp": "04:51:31", "text": "私が「何だこれは"}, {"type": "subtitle", "time": 17494.23, "timestamp": "04:51:34", "text": "[ __ ]？それは"}, {"type": "subtitle", "time": 17496.07, "timestamp": "04:51:36", "text": "カナダのものとほぼ同じだが"}, {"type": "subtitle", "time": 17501.19, "timestamp": "04:51:41", "text": "見る？"}, {"type": "subtitle", "time": 17517.91, "timestamp": "04:51:57", "text": "と共に"}]
[{"type": "subtitle", "time": 19023.67, "timestamp": "05:17:03", "text": "あれ。"}, {"type": "subtitle", "time": 19026.868, "timestamp": "05:17:06", "text": "ええ、ずっとそうでした。"}, {"type": "subtitle", "time": 19029.75, "timestamp": "05:17:09", "text": "ああ、いや、あなたは何にいたの？"}, {"type": "subtitle", "time": 19031.43, "timestamp": "05:17:11", "text": "あなたがいた地図の一部ですか？最後に。"}, {"type": "subtitle", "time": 19033.43, "timestamp": "05:17:13", "text": "ああ、ええと、礼拝堂の左側の近くで"}, {"type": "subtitle", "time": 19035.59, "timestamp": "05:17:15", "text": "トマトは。うん。わかった。わかった。わかった。"}, {"type": "subtitle", "time": 19036.48, "timestamp": "05:17:16", "text": "わかった。 まあ、公平に言うと、もし彼らが"}, {"type": "subtitle", "time": 19038.08, "timestamp": "05:17:18", "text": "まあ、公平に言うと、もし彼らが 両方とも殺人犯で、彼らは"}, {"type": "subtitle", "time": 19041.52, "timestamp": "05:17:21", "text": "両方とも殺人犯で、彼らは 協力する。ああ、それは決して"}, {"type": "subtitle", "time": 19043.52, "timestamp": "05:17:23", "text": "協力する。ああ、それは決して まったく、"}, {"type": "subtitle", "time": 19045.36, "timestamp": "05:17:25", "text": "まったく、 右？なぜ？射撃を除いて"}, {"type": "subtitle", "time": 19047.44, "timestamp": "05:17:27", "text": "右？なぜ？射撃を除いて ドラゴンを撃つ。"}, {"type": "subtitle", "time": 19050.08, "timestamp": "05:17:30", "text": "ドラゴンを撃つ。 射撃。"}, {"type": "subtitle", "time": 19057.59, "timestamp": "05:17:37", "text": "全員無事です。待って、私たちはそうしなかった。"}, {"type": "subtitle", "time": 19079.27, "timestamp": "05:17:59", "text": "私は気にしない。私はヨッシーではありません。私は"}]
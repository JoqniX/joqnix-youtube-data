[{"type": "subtitle", "time": 14220.63, "timestamp": "03:57:00", "text": "報告された。"}, {"type": "subtitle", "time": 14224.95, "timestamp": "03:57:04", "text": "待って、レネーを見たんだけど、"}, {"type": "subtitle", "time": 14227.51, "timestamp": "03:57:07", "text": "命乞いをしながら叫ぶ"}, {"type": "subtitle", "time": 14230.389, "timestamp": "03:57:10", "text": "長いバイク、そして彼は死んでしまった。おお"}, {"type": "subtitle", "time": 14233.75, "timestamp": "03:57:13", "text": "我が神よ。何てことだ。わかりません。私"}, {"type": "subtitle", "time": 14236.79, "timestamp": "03:57:16", "text": "彼がなぜ叫んでいたのかは分からない。"}, {"type": "subtitle", "time": 14245.269, "timestamp": "03:57:25", "text": "私は脱出するつもりだ。私はジョーを待っている"}, {"type": "subtitle", "time": 14247.349, "timestamp": "03:57:27", "text": "彼が近くにいたからだ。"}, {"type": "subtitle", "time": 14249.189, "timestamp": "03:57:29", "text": "どこにいたのか教えてほしい"}, {"type": "subtitle", "time": 14251.189, "timestamp": "03:57:31", "text": "まず体？人数が多すぎる"}, {"type": "subtitle", "time": 14254.63, "timestamp": "03:57:34", "text": "負ける。私はそれを待っていました"}, {"type": "subtitle", "time": 14257.75, "timestamp": "03:57:37", "text": "私のために戦ってくれている。なぜ？私はあなたと一緒にいました。私"}, {"type": "subtitle", "time": 14261.91, "timestamp": "03:57:41", "text": "理由もわからない。はぁ？彼は"}, {"type": "subtitle", "time": 14266.15, "timestamp": "03:57:46", "text": "以前、私と一緒にいました。わかってるけど、"}, {"type": "subtitle", "time": 14268.63, "timestamp": "03:57:48", "text": "あ、そういえば、ヨッシーははっきりしてるね。"}, {"type": "subtitle", "time": 14271.429, "timestamp": "03:57:51", "text": "彼女は実際にその容疑を実行した。いや、待って。"}, {"type": "subtitle", "time": 14273.269, "timestamp": "03:57:53", "text": "なぜ？"}]
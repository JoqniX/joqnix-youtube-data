[{"type": "subtitle", "time": 9363.51, "timestamp": "02:36:03", "text": "[音楽]"}, {"type": "subtitle", "time": 9369.429, "timestamp": "02:36:09", "text": "[ __ ]のサウンドエフェクトを入手できますか？"}, {"type": "subtitle", "time": 9372.15, "timestamp": "02:36:12", "text": "ここ？はい、それですね。私はそれを持っていません"}, {"type": "subtitle", "time": 9376.79, "timestamp": "02:36:16", "text": "音声クリップ。何でも。モッズ。いいえ。"}, {"type": "subtitle", "time": 9378.63, "timestamp": "02:36:18", "text": "あなたのMODの一つはどこにあるのですか？彼女一人だけです。"}, {"type": "subtitle", "time": 9382.309, "timestamp": "02:36:22", "text": "誰もいない。私たちだけです。"}, {"type": "subtitle", "time": 9384.63, "timestamp": "02:36:24", "text": "いいえ。"}, {"type": "subtitle", "time": 9387.11, "timestamp": "02:36:27", "text": "それをサウンドボードにするつもりはありません。"}, {"type": "subtitle", "time": 9390.55, "timestamp": "02:36:30", "text": "おぞましい。いいですね。わかった。あなたのような"}, {"type": "subtitle", "time": 9392.63, "timestamp": "02:36:32", "text": "あのミーム知ってる？"}, {"type": "subtitle", "time": 9394.87, "timestamp": "02:36:34", "text": "マカロニチーズと男が言う"}, {"type": "subtitle", "time": 9402.07, "timestamp": "02:36:42", "text": "まるで水っぽいマカロニチーズみたいだ。それは"}, {"type": "subtitle", "time": 9404.79, "timestamp": "02:36:44", "text": "つる植物？そう、あの水っぽいマカロニチーズのことだよ。そして"}, {"type": "subtitle", "time": 9406.55, "timestamp": "02:36:46", "text": "彼は、それが良いおまんこだと言う"}, {"type": "subtitle", "time": 9409.19, "timestamp": "02:36:49", "text": "どうやらそうみたいですね。"}, {"type": "subtitle", "time": 9410.79, "timestamp": "02:36:50", "text": "持続する。あのツタを取らせてくれよ。"}, {"type": "subtitle", "time": 9412.95, "timestamp": "02:36:52", "text": "1秒。もし私が"}, {"type": "subtitle", "time": 9414.79, "timestamp": "02:36:54", "text": "絶対に見つけるな。誰かいますか"}, {"type": "subtitle", "time": 9418.309, "timestamp": "02:36:58", "text": "Twitchで配信中？"}]
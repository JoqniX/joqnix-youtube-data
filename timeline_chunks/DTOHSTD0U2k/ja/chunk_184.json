[{"type": "subtitle", "time": 11041.19, "timestamp": "03:04:01", "text": "別の人生を終えた人たち。"}, {"type": "subtitle", "time": 11043.59, "timestamp": "03:04:03", "text": "反対側も完了しましたか？私たちは"}, {"type": "subtitle", "time": 11045.75, "timestamp": "03:04:05", "text": "もう一つ作る"}, {"type": "subtitle", "time": 11049.19, "timestamp": "03:04:09", "text": "行く。こんにちは、私の名前はレネです。私も"}, {"type": "subtitle", "time": 11051.349, "timestamp": "03:04:11", "text": "男根について語る男として知られる"}, {"type": "subtitle", "time": 11055.11, "timestamp": "03:04:15", "text": "物にこだわりすぎるし、男性が好きです。"}, {"type": "subtitle", "time": 11062.15, "timestamp": "03:04:22", "text": "まるでカミングアウトする漫画家のように"}, {"type": "subtitle", "time": 11075.429, "timestamp": "03:04:35", "text": "ハンハン、キーボードを壊しちゃってるよ"}, {"type": "subtitle", "time": 11077.75, "timestamp": "03:04:37", "text": "今すぐ。あ、ちょっと待って。申し訳ありません"}, {"type": "subtitle", "time": 11080.37, "timestamp": "03:04:40", "text": "それ。"}, {"type": "subtitle", "time": 11086.469, "timestamp": "03:04:46", "text": "これを修正するには時間がかかります。それで、"}, {"type": "subtitle", "time": 11089.19, "timestamp": "03:04:49", "text": "うん。うん。うん。やってみてよ、だって思うから"}, {"type": "subtitle", "time": 11091.99, "timestamp": "03:04:51", "text": "キーボードの音が大きすぎる。うん。"}, {"type": "subtitle", "time": 11094.87, "timestamp": "03:04:54", "text": "うん。ミュートします。"}, {"type": "subtitle", "time": 11098.95, "timestamp": "03:04:58", "text": "はい。次は黄色いアヒル、"}]
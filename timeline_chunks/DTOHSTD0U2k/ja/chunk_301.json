[{"type": "subtitle", "time": 18066.23, "timestamp": "05:01:06", "text": "こんにちは。何？こんにちは。あなたは偽物ですか？"}, {"type": "subtitle", "time": 18069.03, "timestamp": "05:01:09", "text": "そうしないでください。"}, {"type": "subtitle", "time": 18071.27, "timestamp": "05:01:11", "text": "私はジョアを信頼している。"}, {"type": "subtitle", "time": 18078.07, "timestamp": "05:01:18", "text": "ない。"}, {"type": "subtitle", "time": 18079.99, "timestamp": "05:01:19", "text": "私は怖いです。"}, {"type": "subtitle", "time": 18082.39, "timestamp": "05:01:22", "text": "彼女は今は話さない。何てことだ。彼女は"}, {"type": "subtitle", "time": 18100.23, "timestamp": "05:01:40", "text": "ニース。それは速すぎた。"}, {"type": "subtitle", "time": 18103.03, "timestamp": "05:01:43", "text": "騎手。ジョック。持続する。あなたは料理をしている。"}, {"type": "subtitle", "time": 18106.708, "timestamp": "05:01:46", "text": "ジョック。あなたは料理をしている。黙れ。"}, {"type": "subtitle", "time": 18110.15, "timestamp": "05:01:50", "text": "黙れ。理由を知りたい。なぜならあなたは"}, {"type": "subtitle", "time": 18113.27, "timestamp": "05:01:53", "text": "沈黙していた。あなたは黙っていた。私は話した"}, {"type": "subtitle", "time": 18115.83, "timestamp": "05:01:55", "text": "あなたと。あなたは暴力的に私を追いかけました"}, {"type": "subtitle", "time": 18118.31, "timestamp": "05:01:58", "text": "彼はそれが私だと知っていた。どうやって？どうやって"}]
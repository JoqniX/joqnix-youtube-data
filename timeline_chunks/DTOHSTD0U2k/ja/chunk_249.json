[{"type": "subtitle", "time": 14941.76, "timestamp": "04:09:01", "text": "君が殺すのを見た ハンは皆の前で、あなたたち二人とも"}, {"type": "subtitle", "time": 14944.96, "timestamp": "04:09:04", "text": "ハンは皆の前で、あなたたち二人とも それを行うために。何かありますか？"}, {"type": "subtitle", "time": 14948.08, "timestamp": "04:09:08", "text": "それを行うために。何かありますか？ 説明してください。"}, {"type": "subtitle", "time": 14950.16, "timestamp": "04:09:10", "text": "説明してください。 あれは間違いだったって、分かってるでしょ？"}, {"type": "subtitle", "time": 14952.08, "timestamp": "04:09:12", "text": "あれは間違いだったって、分かってるでしょ？ 戦い。"}, {"type": "subtitle", "time": 14954.63, "timestamp": "04:09:14", "text": "戦い。 [笑い]"}, {"type": "subtitle", "time": 14959.68, "timestamp": "04:09:19", "text": "[笑い] 何？神。"}, {"type": "subtitle", "time": 14969.99, "timestamp": "04:09:29", "text": "何てことだ。"}, {"type": "subtitle", "time": 14972.389, "timestamp": "04:09:32", "text": "大丈夫です。大丈夫です。とてもうるさい。"}, {"type": "subtitle", "time": 14974.95, "timestamp": "04:09:34", "text": "なんてこった。"}, {"type": "subtitle", "time": 14977.269, "timestamp": "04:09:37", "text": "キュウキ、あなたの役割は何ですか？キュウキ、それは"}, {"type": "subtitle", "time": 14979.99, "timestamp": "04:09:39", "text": "あなたの役割は？はぁ？"}, {"type": "subtitle", "time": 14981.429, "timestamp": "04:09:41", "text": "皆さんにじっくり考えていただく時間が必要です。"}, {"type": "subtitle", "time": 14988.309, "timestamp": "04:09:48", "text": "彼女は私に言いたくない、私は"}, {"type": "subtitle", "time": 14990.79, "timestamp": "04:09:50", "text": "殺害現場を目撃したため、彼女を通報した。"}, {"type": "subtitle", "time": 14994.07, "timestamp": "04:09:54", "text": "彼女は殺人者だ。しかし、たとえ私たちが"}]
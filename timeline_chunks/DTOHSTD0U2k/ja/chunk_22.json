[{"type": "subtitle", "time": 1321.43, "timestamp": "00:22:01", "text": "彼は全ての権力を握り、願いを叶えた。"}, {"type": "subtitle", "time": 1326.23, "timestamp": "00:22:06", "text": "しかし、それには代償が伴う。子羊たちは危険を知っていたが"}, {"type": "subtitle", "time": 1329.83, "timestamp": "00:22:09", "text": "誘惑に屈する。残念ながら、"}, {"type": "subtitle", "time": 1332.23, "timestamp": "00:22:12", "text": "そのような誘惑に直面して、"}, {"type": "subtitle", "time": 1335.59, "timestamp": "00:22:15", "text": "あらゆる隠れたリスクを無視して"}, {"type": "subtitle", "time": 1338.63, "timestamp": "00:22:18", "text": "彼らに災難はまだ降りかかっていなかった。もし彼らが"}, {"type": "subtitle", "time": 1341.11, "timestamp": "00:22:21", "text": "もう一度チャンスを与えられたと私は信じています"}, {"type": "subtitle", "time": 1344.47, "timestamp": "00:22:24", "text": "彼らはそれでも同じ道を選ぶだろう。"}, {"type": "subtitle", "time": 1347.27, "timestamp": "00:22:27", "text": "必然的に彼らは自分たちの運命を受け入れ、"}, {"type": "subtitle", "time": 1350.47, "timestamp": "00:22:30", "text": "彼らは時が来た時にその代償を払った。"}, {"type": "subtitle", "time": 1353.83, "timestamp": "00:22:33", "text": "さて、私の2つ目の質問は、"}, {"type": "subtitle", "time": 1356.47, "timestamp": "00:22:36", "text": "子羊たちはその代償として何を支払ったのか"}, {"type": "subtitle", "time": 1358.95, "timestamp": "00:22:38", "text": "願い事？"}, {"type": "subtitle", "time": 1361.669, "timestamp": "00:22:41", "text": "えーと"}, {"type": "subtitle", "time": 1365.43, "timestamp": "00:22:45", "text": "彼らの命。もちろん、いつものように、人生は"}, {"type": "subtitle", "time": 1367.75, "timestamp": "00:22:47", "text": "彼らが持っていた最も貴重なものは"}, {"type": "subtitle", "time": 1372.07, "timestamp": "00:22:52", "text": "オファー。これが私の最後の質問です。"}, {"type": "subtitle", "time": 1375.51, "timestamp": "00:22:55", "text": "黒い子羊はどうなったのですか？"}, {"type": "subtitle", "time": 1379.51, "timestamp": "00:22:59", "text": "急ぐなよ、ローバー。ゆっくりしてください。わかった。"}]
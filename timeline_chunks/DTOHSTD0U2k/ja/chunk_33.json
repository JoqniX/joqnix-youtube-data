[{"type": "subtitle", "time": 1983.19, "timestamp": "00:33:03", "text": "何てことだ。"}, {"type": "subtitle", "time": 2006.789, "timestamp": "00:33:26", "text": "私はスカーの幻想を打ち砕いた"}, {"type": "subtitle", "time": 2010.47, "timestamp": "00:33:30", "text": "彼に怪我を負わせた。すべき"}, {"type": "subtitle", "time": 2014.23, "timestamp": "00:33:34", "text": "慈悲を示してくださり、ありがとうございます。滞在する"}, {"type": "subtitle", "time": 2027.19, "timestamp": "00:33:47", "text": "この人は誰ですか？"}, {"type": "subtitle", "time": 2030.789, "timestamp": "00:33:50", "text": "これは赤いユリの花ではないでしょうか？"}, {"type": "subtitle", "time": 2032.789, "timestamp": "00:33:52", "text": "私に少し残しておくって約束したんじゃないの？"}, {"type": "subtitle", "time": 2037.029, "timestamp": "00:33:57", "text": "ローバーと二人きりの時間？"}, {"type": "subtitle", "time": 2039.59, "timestamp": "00:33:59", "text": "ただし、条件が一つあります。あなたに"}]
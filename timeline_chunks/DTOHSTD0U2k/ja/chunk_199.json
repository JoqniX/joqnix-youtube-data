[{"type": "subtitle", "time": 11942.63, "timestamp": "03:19:02", "text": "吉野。乗り越えるのにかかった時間"}, {"type": "subtitle", "time": 11945.19, "timestamp": "03:19:05", "text": "一番上の部分はあまりにも一貫性に欠ける。"}, {"type": "subtitle", "time": 11947.59, "timestamp": "03:19:07", "text": "だから、私であるはずがない。だって、私はついさっき合格したばかりだから。"}, {"type": "subtitle", "time": 11949.67, "timestamp": "03:19:09", "text": "による。"}, {"type": "subtitle", "time": 11951.99, "timestamp": "03:19:11", "text": "わからない。一番上だと思う。の上"}, {"type": "subtitle", "time": 11955.03, "timestamp": "03:19:15", "text": "頂上付近。しかし、それはどこにあったのだろうか？"}, {"type": "subtitle", "time": 11956.79, "timestamp": "03:19:16", "text": "死体は犯罪に関与している。え、今私ったら"}, {"type": "subtitle", "time": 11959.59, "timestamp": "03:19:19", "text": "撃たれるのか？何？"}, {"type": "subtitle", "time": 11963.83, "timestamp": "03:19:23", "text": "誰かが撃たれた。誰かが撃たれた。おお、"}, {"type": "subtitle", "time": 11965.11, "timestamp": "03:19:25", "text": "それはピエロの仕業だと思う"}, {"type": "subtitle", "time": 11967.88, "timestamp": "03:19:27", "text": "ピエロは人を殺せるから。"}, {"type": "subtitle", "time": 11977.429, "timestamp": "03:19:37", "text": "全く見当もつかないだろう。私は自分のためにそうした。"}, {"type": "subtitle", "time": 11981.59, "timestamp": "03:19:41", "text": "私は紫色のエリアにいました。だから、"}, {"type": "subtitle", "time": 11984.07, "timestamp": "03:19:44", "text": "ドラッグとホンが付き合っていることは確認できます。"}, {"type": "subtitle", "time": 11986.87, "timestamp": "03:19:46", "text": "何てことだ。だから私は通り過ぎた"}, {"type": "subtitle", "time": 11990.15, "timestamp": "03:19:50", "text": "体とヨッシー。私はVをしていた"}, {"type": "subtitle", "time": 11997.84, "timestamp": "03:19:57", "text": "では、私たちは何をしているのでしょうか？"}]
[{"type": "subtitle", "time": 17588.788, "timestamp": "04:53:08", "text": "来て。ああ、まさに私のことだ。"}, {"type": "subtitle", "time": 17591.43, "timestamp": "04:53:11", "text": "みなさんこんにちは、それで何が起こったかというと、私は"}, {"type": "subtitle", "time": 17594.628, "timestamp": "04:53:14", "text": "薬屋で誰かが「ああ」と言っているのが聞こえた"}, {"type": "subtitle", "time": 17596.55, "timestamp": "04:53:16", "text": "あなたは保安官か何かですか？"}, {"type": "subtitle", "time": 17598.628, "timestamp": "04:53:18", "text": "そして彼らは死んだ、そう、保安官が殺した"}, {"type": "subtitle", "time": 17601.03, "timestamp": "04:53:21", "text": "罪のない人が互いに殺し合った"}, {"type": "subtitle", "time": 17609.91, "timestamp": "04:53:29", "text": "保安官が私を殺した"}, {"type": "subtitle", "time": 17611.43, "timestamp": "04:53:31", "text": "そのうちの一人は保安官で、"}, {"type": "subtitle", "time": 17612.708, "timestamp": "04:53:32", "text": "「ああ、私は保安官だ」とか「あなたは"}, {"type": "subtitle", "time": 17614.15, "timestamp": "04:53:34", "text": "保安官が何か言った"}, {"type": "subtitle", "time": 17615.91, "timestamp": "04:53:35", "text": "そして、そう、二人とも死んでしまった。"}, {"type": "subtitle", "time": 17618.55, "timestamp": "04:53:38", "text": "テストが終わったとき、本当にそれは"}, {"type": "subtitle", "time": 17622.39, "timestamp": "04:53:42", "text": "彼女。ダブルキルだ。うん。何"}, {"type": "subtitle", "time": 17623.91, "timestamp": "04:53:43", "text": "倍増させるのか？クールダウンが始まった。"}, {"type": "subtitle", "time": 17625.83, "timestamp": "04:53:45", "text": "クールダウンで罪のない人が殺された"}, {"type": "subtitle", "time": 17629.03, "timestamp": "04:53:49", "text": "その人も亡くなった。うん、そうだね"}, {"type": "subtitle", "time": 17631.75, "timestamp": "04:53:51", "text": "速すぎて彼女には殺せなかった。"}, {"type": "subtitle", "time": 17636.39, "timestamp": "04:53:56", "text": "複雑にしている人は私の"}, {"type": "subtitle", "time": 17638.39, "timestamp": "04:53:58", "text": "恋人は私のチームメイトであり、私の役割を理解してくれる。"}]
[{"type": "subtitle", "time": 15963.58, "timestamp": "04:26:03", "text": "これ大好き。"}, {"type": "subtitle", "time": 15971.349, "timestamp": "04:26:11", "text": "私たちは。"}, {"type": "subtitle", "time": 15975.03, "timestamp": "04:26:15", "text": "待って、[ __ ]にうんざりしてるの？どこにいるの？"}, {"type": "subtitle", "time": 15977.349, "timestamp": "04:26:17", "text": "私には理解できません。うんざり"}, {"type": "subtitle", "time": 15980.71, "timestamp": "04:26:20", "text": "[ __ ]。あなたは私に遊ぶことさえさせてくれなかった。"}, {"type": "subtitle", "time": 15983.03, "timestamp": "04:26:23", "text": "待って、あなたは殺人犯だったの？なんてこった。あなた"}, {"type": "subtitle", "time": 15986.55, "timestamp": "04:26:26", "text": "ドードー鳥だった。私はドードー鳥だった。私は"}, {"type": "subtitle", "time": 15989.03, "timestamp": "04:26:29", "text": "キラー。彼は誰かを食べた。よくやった。良い"}, {"type": "subtitle", "time": 15990.469, "timestamp": "04:26:30", "text": "仕事。君は僕にそういうことをするよね？"}, {"type": "subtitle", "time": 15997.75, "timestamp": "04:26:37", "text": "ああ、ガチョウがいる。あれはアヒルだ。その"}]
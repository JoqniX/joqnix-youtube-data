[{"type": "subtitle", "time": 11822.95, "timestamp": "03:17:02", "text": "待って、私の任務は反対側だ。願っています"}, {"type": "subtitle", "time": 11825.11, "timestamp": "03:17:05", "text": "行くよ。え、何？"}, {"type": "subtitle", "time": 11826.71, "timestamp": "03:17:06", "text": "待って、あなたのタスクがどこにあるかどうやってわかるの？"}, {"type": "subtitle", "time": 11862.309, "timestamp": "03:17:42", "text": "どうやって拭けばいいですか？ 他に何をすればいいですか？"}, {"type": "subtitle", "time": 11872.55, "timestamp": "03:17:52", "text": "待って、私に責任があるの？"}, {"type": "subtitle", "time": 11875.99, "timestamp": "03:17:55", "text": "いいえ、違います。でも、どうすればいいの？"}, {"type": "subtitle", "time": 11878.71, "timestamp": "03:17:58", "text": "それで？"}]
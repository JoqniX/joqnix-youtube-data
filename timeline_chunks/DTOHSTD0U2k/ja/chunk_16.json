[{"type": "subtitle", "time": 964.389, "timestamp": "00:16:04", "text": "つまり、もう合意したということですね？はい、おっしゃる通りです。"}, {"type": "subtitle", "time": 967.749, "timestamp": "00:16:07", "text": "11以上私たちが住んでいる"}, {"type": "subtitle", "time": 969.269, "timestamp": "00:16:09", "text": "理想。"}, {"type": "subtitle", "time": 972.23, "timestamp": "00:16:12", "text": "羊飼いは今も君臨し、子羊たちは"}, {"type": "subtitle", "time": 975.35, "timestamp": "00:16:15", "text": "慢心してしまった。それは"}, {"type": "subtitle", "time": 979.829, "timestamp": "00:16:19", "text": "その世界を実現するために、私たち二人が力を合わせました。"}, {"type": "subtitle", "time": 1010.31, "timestamp": "00:16:50", "text": "わかった。それから、えーと、ちょっと取らせて"}, {"type": "subtitle", "time": 1013.749, "timestamp": "00:16:53", "text": "何かして戻ってきてください。終わりのない焚き火"}, {"type": "subtitle", "time": 1017.43, "timestamp": "00:16:57", "text": "毎晩新しい神を崇拝する"}]
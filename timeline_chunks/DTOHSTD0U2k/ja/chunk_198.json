[{"type": "subtitle", "time": 11880.87, "timestamp": "03:18:00", "text": "おい。やあ、ジャッキー。元気かい？ああ、"}, {"type": "subtitle", "time": 11884.55, "timestamp": "03:18:04", "text": "神。すばらしい。すばらしい。私は大丈夫。私はとても"}, {"type": "subtitle", "time": 11892.95, "timestamp": "03:18:12", "text": "続けろ。諦めずに続けろ。待って。"}, {"type": "subtitle", "time": 11903.59, "timestamp": "03:18:23", "text": "これらの道筋はとても分かりにくい。私"}, {"type": "subtitle", "time": 11905.91, "timestamp": "03:18:25", "text": "全く分からない。ああ、死体だ。ああ、"}, {"type": "subtitle", "time": 11909.91, "timestamp": "03:18:29", "text": "死体。え、何？死体を発見"}, {"type": "subtitle", "time": 11911.51, "timestamp": "03:18:31", "text": "体。"}, {"type": "subtitle", "time": 11915.11, "timestamp": "03:18:35", "text": "どこ？もちろん、映画ですからね。ああ、"}, {"type": "subtitle", "time": 11917.99, "timestamp": "03:18:37", "text": "神。何てことだ。よし。誰か"}, {"type": "subtitle", "time": 11919.91, "timestamp": "03:18:39", "text": "何か心当たりはありますか？だって、ついさっき上がったばかりなんだもん。わかった。"}, {"type": "subtitle", "time": 11921.11, "timestamp": "03:18:41", "text": "もちろん。もちろん。どこで"}, {"type": "subtitle", "time": 11924.55, "timestamp": "03:18:44", "text": "探す？つまり、私は"}, {"type": "subtitle", "time": 11927.99, "timestamp": "03:18:47", "text": "タスクを実行すると、体の上にそれが見えました。しかし"}, {"type": "subtitle", "time": 11936.79, "timestamp": "03:18:56", "text": "私にはアリバイがある。私にはアリバイがある。右。"}, {"type": "subtitle", "time": 11939.59, "timestamp": "03:18:59", "text": "私はジョックニックを通り過ぎ、それから"}]
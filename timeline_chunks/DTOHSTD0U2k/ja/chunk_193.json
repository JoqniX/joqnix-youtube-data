[{"type": "subtitle", "time": 11594.07, "timestamp": "03:13:14", "text": "くそ。誰かを選ぶことはできません。 Fキーを押してください。"}, {"type": "subtitle", "time": 11595.83, "timestamp": "03:13:15", "text": "よし、行ってらっしゃい。イーニー、ミーニー、マイティ"}, {"type": "subtitle", "time": 11608.79, "timestamp": "03:13:28", "text": "さあ行こう。だから私は"}, {"type": "subtitle", "time": 11611.349, "timestamp": "03:13:31", "text": "私のリストから名前を選んでください。"}, {"type": "subtitle", "time": 11616.71, "timestamp": "03:13:36", "text": "わかった。みんなが遊び方を知っているといいな"}, {"type": "subtitle", "time": 11619.91, "timestamp": "03:13:39", "text": "このゲーム。えっと、私は新参者です。わからない。"}, {"type": "subtitle", "time": 11623.11, "timestamp": "03:13:43", "text": "初めてです。私をミムしてください。初めてです。あなた"}, {"type": "subtitle", "time": 11624.95, "timestamp": "03:13:44", "text": "初めて電話してもいいですよ"}, {"type": "subtitle", "time": 11627.03, "timestamp": "03:13:47", "text": "私はこのゲームを実際にプレイしたことがありません。だろう"}, {"type": "subtitle", "time": 11629.59, "timestamp": "03:13:49", "text": "あなたが好きなもの"}, {"type": "subtitle", "time": 11632.87, "timestamp": "03:13:52", "text": "Among Usでロールは？うん。うん。うん。"}, {"type": "subtitle", "time": 11634.15, "timestamp": "03:13:54", "text": "そして、まずは彼が"}, {"type": "subtitle", "time": 11638.87, "timestamp": "03:13:58", "text": "俺たち全員をボコボコにするつもりだよ、兄弟。わかった。はぁ？"}]
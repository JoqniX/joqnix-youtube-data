[{"type": "subtitle", "time": 10703.51, "timestamp": "02:58:23", "text": "くそ。みんなおならをする。 SC"}, {"type": "subtitle", "time": 10710.309, "timestamp": "02:58:30", "text": "ここで終わりのない排便が続く。"}, {"type": "subtitle", "time": 10714.23, "timestamp": "02:58:34", "text": "そうする必要はありません。"}, {"type": "subtitle", "time": 10717.03, "timestamp": "02:58:37", "text": "我慢する。追加します"}, {"type": "subtitle", "time": 10718.55, "timestamp": "02:58:38", "text": "誰か。"}, {"type": "subtitle", "time": 10722.71, "timestamp": "02:58:42", "text": "私はただ疑うだけです"}, {"type": "subtitle", "time": 10725.11, "timestamp": "02:58:45", "text": "怪しい人たちのところへ行くだけです。"}, {"type": "subtitle", "time": 10727.19, "timestamp": "02:58:47", "text": "ああ、確かにそうですね。"}, {"type": "subtitle", "time": 10730.23, "timestamp": "02:58:50", "text": "この扉は何ですか？それは何ですか？"}, {"type": "subtitle", "time": 10732.95, "timestamp": "02:58:52", "text": "ネザーポータルのように見える。ええ、それは"}, {"type": "subtitle", "time": 10735.75, "timestamp": "02:58:55", "text": "マインクラフトへのポータル。もし君たちが"}, {"type": "subtitle", "time": 10737.75, "timestamp": "02:58:57", "text": "4 まで行くと、"}]
[{"type": "subtitle", "time": 18782.31, "timestamp": "05:13:02", "text": "待って、待って、待って、待って、待って、待って。"}, {"type": "subtitle", "time": 18785.35, "timestamp": "05:13:05", "text": "ああ、みなさんこんにちは。こんにちは。"}, {"type": "subtitle", "time": 18787.91, "timestamp": "05:13:07", "text": "いや、そこには行かないで。実際、私は"}, {"type": "subtitle", "time": 18791.11, "timestamp": "05:13:11", "text": "立っている。私は立っています。"}, {"type": "subtitle", "time": 18793.35, "timestamp": "05:13:13", "text": "何てことだ。"}, {"type": "subtitle", "time": 18795.91, "timestamp": "05:13:15", "text": "私は一体何に巻き込まれたんだ？ 1位。私は"}, {"type": "subtitle", "time": 18797.35, "timestamp": "05:13:17", "text": "ごめん。彼らが"}, {"type": "subtitle", "time": 18799.43, "timestamp": "05:13:19", "text": "こうあるべきだ。"}, {"type": "subtitle", "time": 18800.788, "timestamp": "05:13:20", "text": "私たちが"}, {"type": "subtitle", "time": 18802.15, "timestamp": "05:13:22", "text": "こうなるのかな？これはまるで"}, {"type": "subtitle", "time": 18804.39, "timestamp": "05:13:24", "text": "私たちには何が求められているのでしょうか？まるで私が"}, {"type": "subtitle", "time": 18806.31, "timestamp": "05:13:26", "text": "つまり、妻たちは"}, {"type": "subtitle", "time": 18809.67, "timestamp": "05:13:29", "text": "いいけど、マジでヤバいよ。"}, {"type": "subtitle", "time": 18811.19, "timestamp": "05:13:31", "text": "A"}, {"type": "subtitle", "time": 18813.59, "timestamp": "05:13:33", "text": "妻たち。"}, {"type": "subtitle", "time": 18818.07, "timestamp": "05:13:38", "text": "雰囲気が最高すぎる。"}, {"type": "subtitle", "time": 18821.27, "timestamp": "05:13:41", "text": "いやいや、そういうつもりじゃなかったんです。"}, {"type": "subtitle", "time": 18824.39, "timestamp": "05:13:44", "text": "ああ、あなたはそうではなかった。そうでした。"}, {"type": "subtitle", "time": 18827.83, "timestamp": "05:13:47", "text": "うん。君しか見つけられない。"}, {"type": "subtitle", "time": 18831.83, "timestamp": "05:13:51", "text": "そして私たちはあなたを輝かせます。わあ、すごい。ああ、"}, {"type": "subtitle", "time": 18834.23, "timestamp": "05:13:54", "text": "彼はこれから高音域を担当することになるだろう。"}, {"type": "subtitle", "time": 18835.59, "timestamp": "05:13:55", "text": "はい、彼らはただ私たちの"}, {"type": "subtitle", "time": 18838.39, "timestamp": "05:13:58", "text": "もっと声を上げて。私はこれが嫌いだ。私はこれが嫌いだ。"}]
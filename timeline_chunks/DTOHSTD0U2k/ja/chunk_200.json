[{"type": "subtitle", "time": 12009.91, "timestamp": "03:20:09", "text": "ウィローは死んだ。ウィローだと思う"}, {"type": "subtitle", "time": 12012.95, "timestamp": "03:20:12", "text": "撃たれたんだよね？全く分からない。増やす"}, {"type": "subtitle", "time": 12015.07, "timestamp": "03:20:15", "text": "罪悪感。それは"}, {"type": "subtitle", "time": 12018.389, "timestamp": "03:20:18", "text": "[笑い]"}, {"type": "subtitle", "time": 12021.269, "timestamp": "03:20:21", "text": "ああ、なんて可愛らしい声だったんだろう。何？"}, {"type": "subtitle", "time": 12024.229, "timestamp": "03:20:24", "text": "しかし、なぜスアなのか？なぜそんなことをする人がいるのか"}, {"type": "subtitle", "time": 12033.75, "timestamp": "03:20:33", "text": "文字通り、私は信じられない"}, {"type": "subtitle", "time": 12037.349, "timestamp": "03:20:37", "text": "地図で確認できます。待って。ええ、まあ"}, {"type": "subtitle", "time": 12040.95, "timestamp": "03:20:40", "text": "はい、地図をクリックできますよ。"}, {"type": "subtitle", "time": 12042.3, "timestamp": "03:20:42", "text": "何？"}, {"type": "subtitle", "time": 12044.389, "timestamp": "03:20:44", "text": "[笑い]"}, {"type": "subtitle", "time": 12047.67, "timestamp": "03:20:47", "text": "わかった。それで、遺体病院を見つけた"}, {"type": "subtitle", "time": 12051.349, "timestamp": "03:20:51", "text": "つまり、病院の上にあるってことですよね？そして、"}, {"type": "subtitle", "time": 12053.03, "timestamp": "03:20:53", "text": "それでおしまい。私はただ歩き回っていた"}, {"type": "subtitle", "time": 12055.83, "timestamp": "03:20:55", "text": "病院に入院していて、Crime LAで仕事があるんです。"}, {"type": "subtitle", "time": 12058.95, "timestamp": "03:20:58", "text": "だから、私は病院に行くことになって、嘘をついたんです。"}]
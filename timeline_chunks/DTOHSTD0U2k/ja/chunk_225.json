[{"type": "subtitle", "time": 13501.11, "timestamp": "03:45:01", "text": "ヤヌゾだと言った。彼が撃つのを見た"}, {"type": "subtitle", "time": 13507.99, "timestamp": "03:45:07", "text": "何てことだ。あの殺人事件。"}, {"type": "subtitle", "time": 13510.71, "timestamp": "03:45:10", "text": "あれはすごかった。悪魔だ。悪魔は"}, {"type": "subtitle", "time": 13514.309, "timestamp": "03:45:14", "text": "クレイジー。さて、あなたは私が殺人を犯したのを見ましたか？"}, {"type": "subtitle", "time": 13516.07, "timestamp": "03:45:16", "text": "誰であれ？ここに来て。ここに来て。ええ、でも"}, {"type": "subtitle", "time": 13518.309, "timestamp": "03:45:18", "text": "私はあなたが殺人を犯すのを見た。 「おい、誰が"}, {"type": "subtitle", "time": 13520.229, "timestamp": "03:45:20", "text": "「それ？」それで私はその男の後を追おうとした"}, {"type": "subtitle", "time": 13522.95, "timestamp": "03:45:22", "text": "誰だったのか知りたかったけど、殺されちゃったよ。私"}, {"type": "subtitle", "time": 13525.83, "timestamp": "03:45:25", "text": "彼女を殺した。何てことだ。私はまさに"}, {"type": "subtitle", "time": 13527.59, "timestamp": "03:45:27", "text": "犯人が誰か確かめるために追跡したが、彼は殺人を犯した。"}, {"type": "subtitle", "time": 13531.189, "timestamp": "03:45:31", "text": "自分。実際の試合展開。なぜ私に尋ねたのですか？"}, {"type": "subtitle", "time": 13533.349, "timestamp": "03:45:33", "text": "あなたがあちらで助けていたとき"}, {"type": "subtitle", "time": 13535.91, "timestamp": "03:45:35", "text": "いいえ、いいえ。だって、そう、"}, {"type": "subtitle", "time": 13538.63, "timestamp": "03:45:38", "text": "それが私の第一のルールです。信用しないで"}, {"type": "subtitle", "time": 13541.269, "timestamp": "03:45:41", "text": "誰でも。みんな、誰も信用しないで"}, {"type": "subtitle", "time": 13545.91, "timestamp": "03:45:45", "text": "あなた自身。みんな、自分を信用するな。"}, {"type": "subtitle", "time": 13548.309, "timestamp": "03:45:48", "text": "クレイジーな奴らだ。毎回。毎回"}, {"type": "subtitle", "time": 13551.189, "timestamp": "03:45:51", "text": "黒が見えたら、我々は彼を殺します。うん、"}, {"type": "subtitle", "time": 13558.79, "timestamp": "03:45:58", "text": "なぜなら"}]
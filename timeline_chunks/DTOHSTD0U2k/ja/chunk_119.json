[{"type": "subtitle", "time": 7149.51, "timestamp": "01:59:09", "text": "前に出てきなさい。待って。動きがある"}, {"type": "subtitle", "time": 7151.51, "timestamp": "01:59:11", "text": "あれのことですよね？"}, {"type": "subtitle", "time": 7155.189, "timestamp": "01:59:15", "text": "あれがどれだったのか突き止めなければならない。"}, {"type": "subtitle", "time": 7157.99, "timestamp": "01:59:17", "text": "それは動きに関することですね。どれ"}, {"type": "subtitle", "time": 7190.629, "timestamp": "01:59:50", "text": "どれが動きに関するものだったっけ？"}, {"type": "subtitle", "time": 7193.99, "timestamp": "01:59:53", "text": "どちらだったのか？"}, {"type": "subtitle", "time": 7198.55, "timestamp": "01:59:58", "text": "彼女の資産を変えることもできるだろう。"}]
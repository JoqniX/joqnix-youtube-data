[{"type": "subtitle", "time": 15664.389, "timestamp": "04:21:04", "text": "何てことだ。楽しい。私たちは何が"}, {"type": "subtitle", "time": 15677.429, "timestamp": "04:21:17", "text": "[音楽]"}, {"type": "subtitle", "time": 15681.51, "timestamp": "04:21:21", "text": "誰が誰が取ったか見てください"}, {"type": "subtitle", "time": 15684.389, "timestamp": "04:21:24", "text": "あ、こんにちは。くそ。私は殺されるのか？"}, {"type": "subtitle", "time": 15692.87, "timestamp": "04:21:32", "text": "こんにちは。君たちは"}, {"type": "subtitle", "time": 15696.309, "timestamp": "04:21:36", "text": "おい、待て。えっと、ここにいくつか物があります。"}, {"type": "subtitle", "time": 15701.59, "timestamp": "04:21:41", "text": "嘘をつきたいのですか？私を見て。えっと、"}, {"type": "subtitle", "time": 15704.149, "timestamp": "04:21:44", "text": "それは"}, {"type": "subtitle", "time": 15715.99, "timestamp": "04:21:55", "text": "落ち着け。ヨシ。"}, {"type": "subtitle", "time": 15718.389, "timestamp": "04:21:58", "text": "はい、"}, {"type": "subtitle", "time": 15719.99, "timestamp": "04:21:59", "text": "話す時間をください。こんにちは。ください"}]
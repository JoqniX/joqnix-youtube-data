[{"type": "subtitle", "time": 1206.63, "timestamp": "00:20:06", "text": "これは何ですか？シミが見つかりました"}, {"type": "subtitle", "time": 1209.11, "timestamp": "00:20:09", "text": "壁。もっと近づいて。それらを作ることができます"}, {"type": "subtitle", "time": 1211.83, "timestamp": "00:20:11", "text": "文章。追放されたモンスターはすべて彼女です"}, {"type": "subtitle", "time": 1213.43, "timestamp": "00:20:13", "text": "故障。"}, {"type": "subtitle", "time": 1215.51, "timestamp": "00:20:15", "text": "シェルター側からのささやかなページ"}, {"type": "subtitle", "time": 1218.63, "timestamp": "00:20:18", "text": "地上に居住している。その後"}, {"type": "subtitle", "time": 1221.43, "timestamp": "00:20:21", "text": "羊飼いは黒い子羊を公然と非難した"}, {"type": "subtitle", "time": 1223.909, "timestamp": "00:20:23", "text": "ふっくらとした黒子羊のために。次の"}, {"type": "subtitle", "time": 1226.71, "timestamp": "00:20:26", "text": "白い子羊たちが昇る朝を迎えた日"}, {"type": "subtitle", "time": 1230.07, "timestamp": "00:20:30", "text": "太陽。つまり、叔父が操り人形師だったということだ"}, {"type": "subtitle", "time": 1232.31, "timestamp": "00:20:32", "text": "どこにも見当たらない。羊飼い"}, {"type": "subtitle", "time": 1234.95, "timestamp": "00:20:34", "text": "このことに暗黙のルールを導入した"}, {"type": "subtitle", "time": 1236.549, "timestamp": "00:20:36", "text": "村。"}, {"type": "subtitle", "time": 1240.549, "timestamp": "00:20:40", "text": "私たちの黒い子羊が侵害したもの"}, {"type": "subtitle", "time": 1243.51, "timestamp": "00:20:43", "text": "真実を語る。突然かつて"}, {"type": "subtitle", "time": 1247.27, "timestamp": "00:20:47", "text": "溺愛していた神は、願いを叶えるのをやめた。"}, {"type": "subtitle", "time": 1249.75, "timestamp": "00:20:49", "text": "もはや犠牲は捧げられていない"}, {"type": "subtitle", "time": 1252.149, "timestamp": "00:20:52", "text": "黒い子羊の姿を目撃した後に作られた"}, {"type": "subtitle", "time": 1254.789, "timestamp": "00:20:54", "text": "行動と全能の神からの啓示"}, {"type": "subtitle", "time": 1257.669, "timestamp": "00:20:57", "text": "羊飼い。白いものは何だと思いますか"}]
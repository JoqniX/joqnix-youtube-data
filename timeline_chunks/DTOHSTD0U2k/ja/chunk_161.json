[{"type": "subtitle", "time": 9662.07, "timestamp": "02:41:02", "text": "私たちは彼らをいじめているんですよね？おいおい、勘弁してくれよ。彼らは"}, {"type": "subtitle", "time": 9665.99, "timestamp": "02:41:05", "text": "人々の心をつかむ。おぞましい。想像してみて 想像してみて"}, {"type": "subtitle", "time": 9670.71, "timestamp": "02:41:10", "text": "ゲーム内スキンを所有すること。"}, {"type": "subtitle", "time": 9674.389, "timestamp": "02:41:14", "text": "無料だった。今、私は罠を仕掛けたところだ。の"}, {"type": "subtitle", "time": 9677.429, "timestamp": "02:41:17", "text": "無料ガチャ。捕まえたぞ。この男は"}, {"type": "subtitle", "time": 9679.27, "timestamp": "02:41:19", "text": "このゲーム。うん、"}, {"type": "subtitle", "time": 9682.55, "timestamp": "02:41:22", "text": "このゲームにはギャンブル要素がある。"}, {"type": "subtitle", "time": 9684.79, "timestamp": "02:41:24", "text": "プレイすればするほど。"}, {"type": "subtitle", "time": 9686.07, "timestamp": "02:41:26", "text": "プレイすればするほど、"}, {"type": "subtitle", "time": 9690.63, "timestamp": "02:41:30", "text": "通貨。箱を開けるのに使います。ない"}, {"type": "subtitle", "time": 9693.51, "timestamp": "02:41:33", "text": "箱。飛行機ゲーム。私は何度も"}, {"type": "subtitle", "time": 9699.91, "timestamp": "02:41:39", "text": "私たちは皆、その秘密を知っている。幸福とは"}, {"type": "subtitle", "time": 9702.79, "timestamp": "02:41:42", "text": "ギャンブル。それは確かにその通りです。なぜ"}, {"type": "subtitle", "time": 9705.51, "timestamp": "02:41:45", "text": "お前は事実を語っているのか、犬め？私たちはできません"}, {"type": "subtitle", "time": 9708.15, "timestamp": "02:41:48", "text": "持っている"}, {"type": "subtitle", "time": 9710.79, "timestamp": "02:41:50", "text": "誰か配信を始めた？彼らは遅れている"}, {"type": "subtitle", "time": 9713.27, "timestamp": "02:41:53", "text": "9分差で。"}, {"type": "subtitle", "time": 9716.63, "timestamp": "02:41:56", "text": "わかった。わかった。わかった。今すぐ。"}, {"type": "subtitle", "time": 9718.63, "timestamp": "02:41:58", "text": "私は"}]
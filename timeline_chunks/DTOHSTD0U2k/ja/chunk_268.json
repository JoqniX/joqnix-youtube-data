[{"type": "subtitle", "time": 16086.95, "timestamp": "04:28:06", "text": "[音楽]"}, {"type": "subtitle", "time": 16089.1, "timestamp": "04:28:09", "text": "いいえ。"}, {"type": "subtitle", "time": 16091.51, "timestamp": "04:28:11", "text": "[音楽]"}, {"type": "subtitle", "time": 16094.229, "timestamp": "04:28:14", "text": "ああ、ああ、あなたたちが嫌いです。なぜ"}, {"type": "subtitle", "time": 16096.55, "timestamp": "04:28:16", "text": "私にこんなことするの？私は動けません。引っ越します"}, {"type": "subtitle", "time": 16103.59, "timestamp": "04:28:23", "text": "ベルを鳴らすにはどうすればいいですか？どこで"}, {"type": "subtitle", "time": 16106.75, "timestamp": "04:28:26", "text": "ベルが鳴る？"}, {"type": "subtitle", "time": 16109.67, "timestamp": "04:28:29", "text": "[音楽]"}, {"type": "subtitle", "time": 16111.83, "timestamp": "04:28:31", "text": "こんにちは、ヨシ。"}, {"type": "subtitle", "time": 16122.07, "timestamp": "04:28:42", "text": "ヨッシー。"}, {"type": "subtitle", "time": 16125.03, "timestamp": "04:28:45", "text": "いいえ。"}, {"type": "subtitle", "time": 16128.07, "timestamp": "04:28:48", "text": "それは恐ろしい。"}, {"type": "subtitle", "time": 16138.03, "timestamp": "04:28:58", "text": "あれはすごく面白かった。おお。"}]
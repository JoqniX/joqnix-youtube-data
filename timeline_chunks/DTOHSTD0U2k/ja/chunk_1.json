[{"type": "subtitle", "time": 64.869, "timestamp": "00:01:04", "text": "彼の日々についての話はほとんどない"}, {"type": "subtitle", "time": 79.429, "timestamp": "00:01:19", "text": "近いですか？それともテレポートした方が良いですか？"}, {"type": "subtitle", "time": 85.99, "timestamp": "00:01:25", "text": "ここにテレポートしよう。"}, {"type": "subtitle", "time": 89.91, "timestamp": "00:01:29", "text": "シリウス・ブラックの黒人の祖先は？"}, {"type": "subtitle", "time": 92.789, "timestamp": "00:01:32", "text": "シリウス・ブラック？シリウス・ブラックって誰だっけ？"}, {"type": "subtitle", "time": 94.469, "timestamp": "00:01:34", "text": "スネイプ教授とかいう人"}, {"type": "subtitle", "time": 98.22999999999999, "timestamp": "00:01:38", "text": "そう、映画から？ホグワーツを忘れていた"}, {"type": "subtitle", "time": 100.95, "timestamp": "00:01:40", "text": "もの。"}, {"type": "subtitle", "time": 106.22999999999999, "timestamp": "00:01:46", "text": "あなたはニワトコの杖を手に入れた。エルダーワンドとは何ですか？"}, {"type": "subtitle", "time": 115.10900000000001, "timestamp": "00:01:55", "text": "高い地位か。"}, {"type": "subtitle", "time": 116.789, "timestamp": "00:01:56", "text": "おお、"}, {"type": "subtitle", "time": 118.55, "timestamp": "00:01:58", "text": "この謎を解く必要がある。わかった。わかった。"}, {"type": "subtitle", "time": 119.83, "timestamp": "00:01:59", "text": "わかった。待って。"}]
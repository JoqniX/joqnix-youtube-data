[{"type": "subtitle", "time": 11768.229, "timestamp": "03:16:08", "text": "ああ、私たちは天使みたいだ。"}, {"type": "subtitle", "time": 11770.389, "timestamp": "03:16:10", "text": "うん、"}, {"type": "subtitle", "time": 11772.87, "timestamp": "03:16:12", "text": "かわいい"}, {"type": "subtitle", "time": 11775.78, "timestamp": "03:16:15", "text": "交流する。"}, {"type": "subtitle", "time": 11789.59, "timestamp": "03:16:29", "text": "こんにちは。待って、誰かが死んだ。こんにちは。何"}, {"type": "subtitle", "time": 11796.79, "timestamp": "03:16:36", "text": "では、私たちはどうすればよいのでしょうか？"}, {"type": "subtitle", "time": 11800.71, "timestamp": "03:16:40", "text": "わからない。全く分からない。"}, {"type": "subtitle", "time": 11803.51, "timestamp": "03:16:43", "text": "私はただ、知っているかのように歩き回っている"}, {"type": "subtitle", "time": 11817.51, "timestamp": "03:16:57", "text": "あれは岩だと思った。"}]
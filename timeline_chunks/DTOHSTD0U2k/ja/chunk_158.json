[{"type": "subtitle", "time": 9481.349, "timestamp": "02:38:01", "text": "この中で？ウィローは感情を失っている。 A"}, {"type": "subtitle", "time": 9485.349, "timestamp": "02:38:05", "text": "柳、柳。あなたはそんなにも細い柳なのですか？"}, {"type": "subtitle", "time": 9487.19, "timestamp": "02:38:07", "text": "うん。誓って言うけど、君は"}, {"type": "subtitle", "time": 9490.07, "timestamp": "02:38:10", "text": "侮辱。"}, {"type": "subtitle", "time": 9493.75, "timestamp": "02:38:13", "text": "私たちはまるで柳の木みたいだね。柳。"}, {"type": "subtitle", "time": 9500.63, "timestamp": "02:38:20", "text": "ああ、人が多すぎる。"}, {"type": "subtitle", "time": 9504.15, "timestamp": "02:38:24", "text": "多すぎる。どこ？"}, {"type": "subtitle", "time": 9507.19, "timestamp": "02:38:27", "text": "何個までが多すぎるのか？"}, {"type": "subtitle", "time": 9511.75, "timestamp": "02:38:31", "text": "少なくとも2つ。 2つは多すぎる。"}, {"type": "subtitle", "time": 9514.469, "timestamp": "02:38:34", "text": "多すぎる。あなたが正しい。"}, {"type": "subtitle", "time": 9517.19, "timestamp": "02:38:37", "text": "あのね？ 1つでも多すぎる。"}, {"type": "subtitle", "time": 9519.03, "timestamp": "02:38:39", "text": "だから、計算式が2つになることは決してなかったのです。"}, {"type": "subtitle", "time": 9526.389, "timestamp": "02:38:46", "text": "何？ A"}, {"type": "subtitle", "time": 9529.91, "timestamp": "02:38:49", "text": "最悪だ。全体"}, {"type": "subtitle", "time": 9531.75, "timestamp": "02:38:51", "text": "A."}, {"type": "subtitle", "time": 9534.15, "timestamp": "02:38:54", "text": "わかった。"}, {"type": "subtitle", "time": 9536.55, "timestamp": "02:38:56", "text": "ああ、それでいいんですね？わかった。わかった。"}, {"type": "subtitle", "time": 9539.11, "timestamp": "02:38:59", "text": "それは良い情報ですね。それで、"}]
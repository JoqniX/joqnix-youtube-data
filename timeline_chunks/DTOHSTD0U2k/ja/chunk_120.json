[{"type": "subtitle", "time": 7217.91, "timestamp": "02:00:17", "text": "待って。では、待ってください。あと1つ。私は"}, {"type": "subtitle", "time": 7220.709, "timestamp": "02:00:20", "text": "疑い。"}, {"type": "subtitle", "time": 7245.43, "timestamp": "02:00:45", "text": "なぜ"}, {"type": "subtitle", "time": 7247.589, "timestamp": "02:00:47", "text": "待って、私はどの武器が"}, {"type": "subtitle", "time": 7254.79, "timestamp": "02:00:54", "text": "ウー・イン・レーン。はい、それが彼女の名前です。"}, {"type": "subtitle", "time": 7257.83, "timestamp": "02:00:57", "text": "わかった。彼女の武器は何ですか？彼女は"}, {"type": "subtitle", "time": 7259.99, "timestamp": "02:00:59", "text": "電気。わかった。"}]
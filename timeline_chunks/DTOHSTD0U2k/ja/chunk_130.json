[{"type": "subtitle", "time": 7801.02, "timestamp": "02:10:01", "text": "こちらですか？"}, {"type": "subtitle", "time": 7804.55, "timestamp": "02:10:04", "text": "[音楽]"}, {"type": "subtitle", "time": 7819.589, "timestamp": "02:10:19", "text": "上司が増える。ええと、敵が増えました。私のガイド"}, {"type": "subtitle", "time": 7821.27, "timestamp": "02:10:21", "text": "ブレード。"}, {"type": "subtitle", "time": 7827.189, "timestamp": "02:10:27", "text": "[音楽]"}, {"type": "subtitle", "time": 7829.91, "timestamp": "02:10:29", "text": "上昇局面。スカーレット。"}, {"type": "subtitle", "time": 7832.149, "timestamp": "02:10:32", "text": "灌流する。"}, {"type": "subtitle", "time": 7852.31, "timestamp": "02:10:52", "text": "共鳴の瞬間。"}]
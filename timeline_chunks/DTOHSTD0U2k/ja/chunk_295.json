[{"type": "subtitle", "time": 17701.19, "timestamp": "04:55:01", "text": "あなたは何処に行きましたか？わかった。"}, {"type": "subtitle", "time": 17710.31, "timestamp": "04:55:10", "text": "ヴァレラントは今すぐ訓練を狙う。ピュー。"}, {"type": "subtitle", "time": 17712.708, "timestamp": "04:55:12", "text": "こんにちは。ピュー。"}, {"type": "subtitle", "time": 17731.19, "timestamp": "04:55:31", "text": "私は誰かを殺すべきだった、"}, {"type": "subtitle", "time": 17745.27, "timestamp": "04:55:45", "text": "私は話していませんでした。ああ、こんにちは。"}, {"type": "subtitle", "time": 17751.75, "timestamp": "04:55:51", "text": "私はそれを知っていた。"}, {"type": "subtitle", "time": 17759.04, "timestamp": "04:55:59", "text": "私は誰も殺していない。 D."}]
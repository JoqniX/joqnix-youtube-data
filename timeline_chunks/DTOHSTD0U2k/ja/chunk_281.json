[{"type": "subtitle", "time": 16863.67, "timestamp": "04:41:03", "text": "あなた？ごめんなさい。行け、行け。"}, {"type": "subtitle", "time": 16870.948, "timestamp": "04:41:10", "text": "[音楽]"}, {"type": "subtitle", "time": 16875.03, "timestamp": "04:41:15", "text": "わかった。つまり、基本的に私たちは礼拝堂で"}, {"type": "subtitle", "time": 16877.03, "timestamp": "04:41:17", "text": "緊急会議が開かれる場所"}, {"type": "subtitle", "time": 16879.11, "timestamp": "04:41:19", "text": "ボタンは、ヨッシーが目の前で殺される"}, {"type": "subtitle", "time": 16884.39, "timestamp": "04:41:24", "text": "それは私が保安官だから、そして"}, {"type": "subtitle", "time": 16888.39, "timestamp": "04:41:28", "text": "それから？悪者だから。なぜ？なぜ私たちは"}, {"type": "subtitle", "time": 16891.19, "timestamp": "04:41:31", "text": "勝てない？"}, {"type": "subtitle", "time": 16894.948, "timestamp": "04:41:34", "text": "彼女はなぜ死ななかったのか？なぜ"}, {"type": "subtitle", "time": 16897.43, "timestamp": "04:41:37", "text": "RXRはどこにいたのか？いいえ、RXRは見ていません"}, {"type": "subtitle", "time": 16900.47, "timestamp": "04:41:40", "text": "偽者。ええ、もう1つ見ました"}, {"type": "subtitle", "time": 16904.948, "timestamp": "04:41:44", "text": "完全に皆さん。みんな、そうだよ、RX"}, {"type": "subtitle", "time": 16906.39, "timestamp": "04:41:46", "text": "彼は完全に正しかった"}, {"type": "subtitle", "time": 16908.55, "timestamp": "04:41:48", "text": "礼拝堂の脇の入り口から入って、"}, {"type": "subtitle", "time": 16909.91, "timestamp": "04:41:49", "text": "彼は仕事をしていると言っていました。私はしません"}, {"type": "subtitle", "time": 16911.35, "timestamp": "04:41:51", "text": "そこには何か課題があると思う。いや、いや、いや。"}, {"type": "subtitle", "time": 16913.43, "timestamp": "04:41:53", "text": "彼はいつもグループの中にいて、"}, {"type": "subtitle", "time": 16915.59, "timestamp": "04:41:55", "text": "いつもグループの中にいたが、それでも正しかった"}]
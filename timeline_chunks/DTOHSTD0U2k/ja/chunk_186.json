[{"type": "subtitle", "time": 11161.03, "timestamp": "03:06:01", "text": "朝食をとっている。彼は"}, {"type": "subtitle", "time": 11163.75, "timestamp": "03:06:03", "text": "君はマリオの中で一番好きな部分だよ。うん。"}, {"type": "subtitle", "time": 11166.309, "timestamp": "03:06:06", "text": "ほら、分かってくれる人がいる。ありがとう。感謝"}, {"type": "subtitle", "time": 11169.51, "timestamp": "03:06:09", "text": "あなた。あなたは上手い。次はヨッシーです。おお"}, {"type": "subtitle", "time": 11172.469, "timestamp": "03:06:12", "text": "なんてことだ、君は最低だ。こんにちは。調子はどうですか？"}, {"type": "subtitle", "time": 11174.23, "timestamp": "03:06:14", "text": "君たちは何してるの？私は大丈夫です。それでは、さようなら。"}, {"type": "subtitle", "time": 11176.55, "timestamp": "03:06:16", "text": "ありがとう。私は"}, {"type": "subtitle", "time": 11183.67, "timestamp": "03:06:23", "text": "レディ。デスクに戻ってきてください。戻ってくる"}, {"type": "subtitle", "time": 11185.75, "timestamp": "03:06:25", "text": "机へ。適切に話し、"}, {"type": "subtitle", "time": 11191.429, "timestamp": "03:06:31", "text": "皆さん、テレンスです。"}, {"type": "subtitle", "time": 11192.87, "timestamp": "03:06:32", "text": "私はアイドル見習いです。もたらすことを願っています"}, {"type": "subtitle", "time": 11195.11, "timestamp": "03:06:35", "text": "笑顔。みんなも楽しまなくちゃ"}, {"type": "subtitle", "time": 11197.11, "timestamp": "03:06:37", "text": "世界中で。お会い出来て嬉しいです"}, {"type": "subtitle", "time": 11200.15, "timestamp": "03:06:40", "text": "全て。ああ、テレン。ああ、それは"}, {"type": "subtitle", "time": 11207.76, "timestamp": "03:06:47", "text": "[音楽]"}, {"type": "subtitle", "time": 11209.44, "timestamp": "03:06:49", "text": "[笑い]"}, {"type": "subtitle", "time": 11219.19, "timestamp": "03:06:59", "text": "ああ、ハンがここにいる。"}]
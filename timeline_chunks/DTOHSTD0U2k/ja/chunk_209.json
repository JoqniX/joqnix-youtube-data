[{"type": "subtitle", "time": 12552.71, "timestamp": "03:29:12", "text": "彼女がとても"}, {"type": "subtitle", "time": 12556.469, "timestamp": "03:29:16", "text": "その音、聞き覚えがありますか？彼女の声のように"}, {"type": "subtitle", "time": 12565.19, "timestamp": "03:29:25", "text": "なんでそんな声を出したの？"}, {"type": "subtitle", "time": 12587.67, "timestamp": "03:29:47", "text": "試合が始まった。私はすぐ隣にスポーンしました"}, {"type": "subtitle", "time": 12589.429, "timestamp": "03:29:49", "text": "Reに、私は「ああ、私は"}, {"type": "subtitle", "time": 12590.95, "timestamp": "03:29:50", "text": "しばらく遊ばせてあげて。」私は見ていなかった"}, {"type": "subtitle", "time": 12596.95, "timestamp": "03:29:56", "text": "あなたは私たちの休戦協定を破棄する準備ができていた、"}, {"type": "subtitle", "time": 12598.95, "timestamp": "03:29:58", "text": "私たちの友情。"}]
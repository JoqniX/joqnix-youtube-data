[{"type": "subtitle", "time": 2640.71, "timestamp": "00:44:00", "text": "彼女をそのような方向へ押しやった人物"}, {"type": "subtitle", "time": 2644.23, "timestamp": "00:44:04", "text": "悲劇的な結末？申し訳ありません。私は迷子になった"}, {"type": "subtitle", "time": 2651.43, "timestamp": "00:44:11", "text": "このような悲劇が起こらないと言えたらいいのですが"}, {"type": "subtitle", "time": 2654.15, "timestamp": "00:44:14", "text": "再び起こる。"}, {"type": "subtitle", "time": 2656.87, "timestamp": "00:44:16", "text": "しかし、私はまだ自信がないので"}, {"type": "subtitle", "time": 2659.349, "timestamp": "00:44:19", "text": "その主張。"}, {"type": "subtitle", "time": 2661.51, "timestamp": "00:44:21", "text": "こういう悲劇が私を"}, {"type": "subtitle", "time": 2663.91, "timestamp": "00:44:23", "text": "先導者になりたい、"}, {"type": "subtitle", "time": 2666.309, "timestamp": "00:44:26", "text": "強さを持つ人になるために"}, {"type": "subtitle", "time": 2668.87, "timestamp": "00:44:28", "text": "二度とこのようなことが起こらないようにする。私"}, {"type": "subtitle", "time": 2672.069, "timestamp": "00:44:32", "text": "この瞬間を止めることはできないが、少なくとも私は"}, {"type": "subtitle", "time": 2674.069, "timestamp": "00:44:34", "text": "私は全力を尽くすべきです"}, {"type": "subtitle", "time": 2676.15, "timestamp": "00:44:36", "text": "ヘルプ。私はあなたを信頼します。"}, {"type": "subtitle", "time": 2679.19, "timestamp": "00:44:39", "text": "ありがとう、ローバー。"}, {"type": "subtitle", "time": 2682.23, "timestamp": "00:44:42", "text": "それについて思い悩んでも何の得にもならない。"}, {"type": "subtitle", "time": 2685.67, "timestamp": "00:44:45", "text": "さあ行こう。私はレポートを作成します"}, {"type": "subtitle", "time": 2688.15, "timestamp": "00:44:48", "text": "ここで起こったことを一緒に送ってください"}, {"type": "subtitle", "time": 2690.95, "timestamp": "00:44:50", "text": "私たちが集めた手がかり。はい、行きましょう"}, {"type": "subtitle", "time": 2692.47, "timestamp": "00:44:52", "text": "戻る"}, {"type": "subtitle", "time": 2693.79, "timestamp": "00:44:53", "text": "一緒に。"}]
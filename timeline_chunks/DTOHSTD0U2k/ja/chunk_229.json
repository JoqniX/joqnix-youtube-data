[{"type": "subtitle", "time": 13760.309, "timestamp": "03:49:20", "text": "やっています。なんてこった？何？"}, {"type": "subtitle", "time": 13762.469, "timestamp": "03:49:22", "text": "はぁ？どういう意味ですか？なぜあなたは見るのですか"}, {"type": "subtitle", "time": 13782.229, "timestamp": "03:49:42", "text": "これはどのような任務ですか？何てことだ。"}, {"type": "subtitle", "time": 13785.189, "timestamp": "03:49:45", "text": "私は話していないのですか？うん。はい、あなたは"}, {"type": "subtitle", "time": 13787.189, "timestamp": "03:49:47", "text": "このゲームでは会話ができます。"}, {"type": "subtitle", "time": 13789.59, "timestamp": "03:49:49", "text": "はい。何てことだ。私は耳が聞こえないような状態です"}, {"type": "subtitle", "time": 13792.63, "timestamp": "03:49:52", "text": "ずっと。どうやって私は自動聴覚障害になったのか"}, {"type": "subtitle", "time": 13796.79, "timestamp": "03:49:56", "text": "ゲーム？君たちの声は聞こえたよ。"}]
[{"type": "subtitle", "time": 15003.269, "timestamp": "04:10:03", "text": "私は欠席します。たとえそれが"}, {"type": "subtitle", "time": 15006.469, "timestamp": "04:10:06", "text": "入力ミスですね、彼は殺人を犯したんですよね？"}, {"type": "subtitle", "time": 15009.75, "timestamp": "04:10:09", "text": "誤って殺してしまう。何てことだ。幾つか"}, {"type": "subtitle", "time": 15025.67, "timestamp": "04:10:25", "text": "ディンディンディンディンディン。こんにちは。"}, {"type": "subtitle", "time": 15038.87, "timestamp": "04:10:38", "text": "みんな。私の前に出ろ。テレンスです。"}, {"type": "subtitle", "time": 15041.189, "timestamp": "04:10:41", "text": "二人目はテレンスです。えっと、私"}, {"type": "subtitle", "time": 15044.469, "timestamp": "04:10:44", "text": "そしてオックスとテレンス。私たちは皆、"}, {"type": "subtitle", "time": 15046.229, "timestamp": "04:10:46", "text": "墓地の地下。私たちは皆、"}, {"type": "subtitle", "time": 15049.03, "timestamp": "04:10:49", "text": "同時に私の目の前で。いいえ。"}, {"type": "subtitle", "time": 15051.349, "timestamp": "04:10:51", "text": "いいえ。彼だった。それはそれはそれは"}, {"type": "subtitle", "time": 15054.07, "timestamp": "04:10:54", "text": "引きずっている。それはドラゴンだった。それは引きずられた。"}, {"type": "subtitle", "time": 15056.07, "timestamp": "04:10:56", "text": "私は彼よりも遺体から遠かった"}, {"type": "subtitle", "time": 15058.389, "timestamp": "04:10:58", "text": "だった。私は遺体から離れた場所にいた"}]
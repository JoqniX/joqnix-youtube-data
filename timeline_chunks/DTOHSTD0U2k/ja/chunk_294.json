[{"type": "subtitle", "time": 17644.628, "timestamp": "04:54:04", "text": "はい。あなたが恋人かどうかによります。うん。"}, {"type": "subtitle", "time": 17646.708, "timestamp": "04:54:06", "text": "うん。もしあなたが恋人なら、"}, {"type": "subtitle", "time": 17648.31, "timestamp": "04:54:08", "text": "私を見ることができます。"}, {"type": "subtitle", "time": 17652.07, "timestamp": "04:54:12", "text": "私たちには見えない。あなたの「え？」が見えます。"}, {"type": "subtitle", "time": 17654.07, "timestamp": "04:54:14", "text": "わかった。私たちには見えない。誰かが親戚です"}, {"type": "subtitle", "time": 17668.15, "timestamp": "04:54:28", "text": "こんにちは。"}, {"type": "subtitle", "time": 17680.23, "timestamp": "04:54:40", "text": "冗談でしょう？こんにちは。"}, {"type": "subtitle", "time": 17681.99, "timestamp": "04:54:41", "text": "それで、"}, {"type": "subtitle", "time": 17685.11, "timestamp": "04:54:45", "text": "私を信じて。何？"}, {"type": "subtitle", "time": 17698.39, "timestamp": "04:54:58", "text": "何てことだ。どこにいるの？どこで"}]
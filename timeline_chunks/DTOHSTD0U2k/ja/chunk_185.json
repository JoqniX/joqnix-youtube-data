[{"type": "subtitle", "time": 11101.429, "timestamp": "03:05:01", "text": "ボンガス。"}, {"type": "subtitle", "time": 11103.83, "timestamp": "03:05:03", "text": "それは"}, {"type": "subtitle", "time": 11107.11, "timestamp": "03:05:07", "text": "[ __ ]ガス？はい。[ __ ]ガスだよ。誰"}, {"type": "subtitle", "time": 11118.79, "timestamp": "03:05:18", "text": "わかった、"}, {"type": "subtitle", "time": 11122.389, "timestamp": "03:05:22", "text": "私は離席していません。持続する。ここには来ないでください。"}, {"type": "subtitle", "time": 11129.19, "timestamp": "03:05:29", "text": "まさに真ん中へ。真ん中に。で"}, {"type": "subtitle", "time": 11130.63, "timestamp": "03:05:30", "text": "真ん中。真ん中に。では"}, {"type": "subtitle", "time": 11131.99, "timestamp": "03:05:31", "text": "真ん中。ここです。ここです。右"}, {"type": "subtitle", "time": 11133.75, "timestamp": "03:05:33", "text": "ここ。ここです。ここ。ここだよ、犬。"}, {"type": "subtitle", "time": 11135.67, "timestamp": "03:05:35", "text": "ここです。うん。うん。はい、どうぞ。"}, {"type": "subtitle", "time": 11136.71, "timestamp": "03:05:36", "text": "そして、あなたがここに来たら"}, {"type": "subtitle", "time": 11139.83, "timestamp": "03:05:39", "text": "終わり。こんにちは、サズと申します。今日私は"}, {"type": "subtitle", "time": 11143.83, "timestamp": "03:05:43", "text": "目が覚めて、朝食を食べた。ええと、私は"}, {"type": "subtitle", "time": 11145.349, "timestamp": "03:05:45", "text": "他に何か特徴的な点はあるか。私は"}, {"type": "subtitle", "time": 11147.429, "timestamp": "03:05:47", "text": "もう行きます。さあ行こう。ありがとう。"}, {"type": "subtitle", "time": 11149.51, "timestamp": "03:05:49", "text": "さあ行こう。"}, {"type": "subtitle", "time": 11152.389, "timestamp": "03:05:52", "text": "聞こえただろ、兄弟。それは私にとってまさにそうでした。"}, {"type": "subtitle", "time": 11153.75, "timestamp": "03:05:53", "text": "あなたが何を言ったのかはわかりませんが、"}, {"type": "subtitle", "time": 11158.389, "timestamp": "03:05:58", "text": "行く。うん、行こう。さあ行こう。"}]
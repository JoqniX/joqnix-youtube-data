[{"type": "subtitle", "time": 16800.39, "timestamp": "04:40:00", "text": "あなたはそれを私に対して利用するつもりでしょう。"}, {"type": "subtitle", "time": 16802.788, "timestamp": "04:40:02", "text": "あなたはそれを使うつもりです"}, {"type": "subtitle", "time": 16805.35, "timestamp": "04:40:05", "text": "私に対して。このドラゴノサは"}, {"type": "subtitle", "time": 16808.708, "timestamp": "04:40:08", "text": "私に「私は偽者だ」と言えと言っている。"}, {"type": "subtitle", "time": 16810.868, "timestamp": "04:40:10", "text": "えっと、ハトが死んでいるかどうかはわかりません"}, {"type": "subtitle", "time": 16812.788, "timestamp": "04:40:12", "text": "か否か。"}, {"type": "subtitle", "time": 16816.948, "timestamp": "04:40:16", "text": "何？なぜ？私は何もしていません。あなた"}, {"type": "subtitle", "time": 16819.75, "timestamp": "04:40:19", "text": "私を彼らの一人にしたんじゃないの？"}, {"type": "subtitle", "time": 16822.15, "timestamp": "04:40:22", "text": "彼はもう私たちのそばにいないからだ。ない"}, {"type": "subtitle", "time": 16824.31, "timestamp": "04:40:24", "text": "私たちと一緒に。彼が入っていくのを文字通り見た"}, {"type": "subtitle", "time": 16825.99, "timestamp": "04:40:25", "text": "その方向へ。冗談抜きで。"}, {"type": "subtitle", "time": 16828.55, "timestamp": "04:40:28", "text": "そしてその男一人の中に私はある人を見た"}, {"type": "subtitle", "time": 16831.27, "timestamp": "04:40:31", "text": "下降している。彼は落ちぶれるだろう。どうやって"}, {"type": "subtitle", "time": 16834.15, "timestamp": "04:40:34", "text": "わかった。"}, {"type": "subtitle", "time": 16835.03, "timestamp": "04:40:35", "text": "私は電話をかけます"}, {"type": "subtitle", "time": 16837.51, "timestamp": "04:40:37", "text": "鳩の集まり。"}, {"type": "subtitle", "time": 16838.708, "timestamp": "04:40:38", "text": "よし、みんな、電話するよ"}, {"type": "subtitle", "time": 16842.31, "timestamp": "04:40:42", "text": "緊急会議。ハトと"}, {"type": "subtitle", "time": 16844.948, "timestamp": "04:40:44", "text": "ハトは毎回の会合で進歩している"}, {"type": "subtitle", "time": 16848.15, "timestamp": "04:40:48", "text": "完全に道に迷う。ええ、そうですね。はい。行く。"}, {"type": "subtitle", "time": 16851.11, "timestamp": "04:40:51", "text": "待って、ガチョウとハトがいるよ。でも、"}, {"type": "subtitle", "time": 16854.31, "timestamp": "04:40:54", "text": "夜間はできません。これは何ですか？"}, {"type": "subtitle", "time": 16855.91, "timestamp": "04:40:55", "text": "ここにいてください。ここにいてください。"}, {"type": "subtitle", "time": 16857.51, "timestamp": "04:40:57", "text": "ヨシ、私を見て。ヨシ、私を見て。"}, {"type": "subtitle", "time": 16859.99, "timestamp": "04:40:59", "text": "ヨシ、ヨシ、行きます。ヨシ、信頼してもいいですか？"}]
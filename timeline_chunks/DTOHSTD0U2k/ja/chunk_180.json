[{"type": "subtitle", "time": 10802.55, "timestamp": "03:00:02", "text": "行く。おお、"}, {"type": "subtitle", "time": 10809.349, "timestamp": "03:00:09", "text": "行かないで。さあ行こう。さあ行こう。さあ行こう。"}, {"type": "subtitle", "time": 10818.23, "timestamp": "03:00:18", "text": "私に何かあったのかな？元の状態に戻せ。"}, {"type": "subtitle", "time": 10821.349, "timestamp": "03:00:21", "text": "ああ、観戦することもできますよ。として入る"}, {"type": "subtitle", "time": 10824.309, "timestamp": "03:00:24", "text": "観客でもある。そうですね、そうですね"}, {"type": "subtitle", "time": 10833.19, "timestamp": "03:00:33", "text": "待って、どうして反対側を向いているの？"}, {"type": "subtitle", "time": 10836.79, "timestamp": "03:00:36", "text": "彼女は人と違う存在でありたいと願っている。ターゲット"}, {"type": "subtitle", "time": 10839.03, "timestamp": "03:00:39", "text": "人と違う存在でありたい。クリックしました"}, {"type": "subtitle", "time": 10842.87, "timestamp": "03:00:42", "text": "設定を見て、思わず目をそらしてしまった。"}, {"type": "subtitle", "time": 10847.19, "timestamp": "03:00:47", "text": "彼女を狙え。来て。ところで、私たちは一体何者なのか？"}, {"type": "subtitle", "time": 10849.59, "timestamp": "03:00:49", "text": "何を待っているのですか？"}, {"type": "subtitle", "time": 10851.91, "timestamp": "03:00:51", "text": "わからない。 11人くらいいる"}, {"type": "subtitle", "time": 10856.15, "timestamp": "03:00:56", "text": "VC（副大統領）ですが、ここには9人います。"}, {"type": "subtitle", "time": 10858.309, "timestamp": "03:00:58", "text": "わかった。つまり、あと2人足りないということですね。うん。"}]
[{"type": "subtitle", "time": 14400.87, "timestamp": "04:00:00", "text": "RXR。"}, {"type": "subtitle", "time": 14403.349, "timestamp": "04:00:03", "text": "RXR、誕生日おめでとう。お誕生日おめでとう、"}, {"type": "subtitle", "time": 14410.07, "timestamp": "04:00:10", "text": "RXR。彼との時間を楽しんでください。なぜ"}, {"type": "subtitle", "time": 14411.59, "timestamp": "04:00:11", "text": "いつも"}, {"type": "subtitle", "time": 14413.51, "timestamp": "04:00:13", "text": "私を見た？それは無意味だ。なぜ"}, {"type": "subtitle", "time": 14415.51, "timestamp": "04:00:15", "text": "私にそんなことするの？"}, {"type": "subtitle", "time": 14418.309, "timestamp": "04:00:18", "text": "世論は長引いている。"}, {"type": "subtitle", "time": 14426.389, "timestamp": "04:00:26", "text": "事故を許容する。"}, {"type": "subtitle", "time": 14430.229, "timestamp": "04:00:30", "text": "これは何ですか？この鳥を殺すべきだろうか？"}, {"type": "subtitle", "time": 14437.189, "timestamp": "04:00:37", "text": "私の"}, {"type": "subtitle", "time": 14439.03, "timestamp": "04:00:39", "text": "すぐ近く。"}]
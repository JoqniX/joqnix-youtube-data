[{"type": "subtitle", "time": 18960.948, "timestamp": "05:16:00", "text": "それは墨ですか？"}, {"type": "subtitle", "time": 18963.35, "timestamp": "05:16:03", "text": "はい、墓地で遺体を発見しました。私は私だった"}, {"type": "subtitle", "time": 18965.35, "timestamp": "05:16:05", "text": "クラムアレイからポットへ"}, {"type": "subtitle", "time": 18968.948, "timestamp": "05:16:08", "text": "墓地。会ったと思うんだけど、えっと、会ったんだっけ？"}, {"type": "subtitle", "time": 18971.67, "timestamp": "05:16:11", "text": "カラオケはそこでできるの？カラオケ店の前を通りかかった。えっと"}, {"type": "subtitle", "time": 18974.39, "timestamp": "05:16:14", "text": "でも私は犯罪横丁のカラオケを通り過ぎた"}, {"type": "subtitle", "time": 18976.47, "timestamp": "05:16:16", "text": "しかし、それだけです。よくわからない"}, {"type": "subtitle", "time": 18978.708, "timestamp": "05:16:18", "text": "カラオケの起源。私はただ"}, {"type": "subtitle", "time": 18982.39, "timestamp": "05:16:22", "text": "了解しました。次に何が起こるのか？私は私であり、"}, {"type": "subtitle", "time": 18986.23, "timestamp": "05:16:26", "text": "ラオスとキョウキは一緒にいた"}, {"type": "subtitle", "time": 18989.27, "timestamp": "05:16:29", "text": "私たちのところにも同じことが起こりました。"}, {"type": "subtitle", "time": 18991.19, "timestamp": "05:16:31", "text": "だから、ドラゴンとジョックが確認できる"}, {"type": "subtitle", "time": 18993.11, "timestamp": "05:16:33", "text": "君たちを通り過ぎたから一緒にいたんだ"}, {"type": "subtitle", "time": 18996.708, "timestamp": "05:16:36", "text": "広場にいて、私はウィローと一緒だった。だからそれは"}, {"type": "subtitle", "time": 18998.628, "timestamp": "05:16:38", "text": "キリかハンのどちらか。どれでも"}, {"type": "subtitle", "time": 19002.55, "timestamp": "05:16:42", "text": "2人は広場にいた。"}, {"type": "subtitle", "time": 19005.35, "timestamp": "05:16:45", "text": "さっきウィローが彼らと一緒にいるのを見かけたよ。つまり"}, {"type": "subtitle", "time": 19007.11, "timestamp": "05:16:47", "text": "えっと、もし皆さんが私を手伝ってくれるなら。私"}, {"type": "subtitle", "time": 19008.628, "timestamp": "05:16:48", "text": "ウィローと一緒にいた。いや、それは嘘だ。全て"}, {"type": "subtitle", "time": 19010.15, "timestamp": "05:16:50", "text": "右。"}, {"type": "subtitle", "time": 19013.83, "timestamp": "05:16:53", "text": "いいえ、彼は彼らと一緒にいました。彼は、ああ、"}, {"type": "subtitle", "time": 19015.35, "timestamp": "05:16:55", "text": "始まり。最初は。最初は。"}, {"type": "subtitle", "time": 19017.99, "timestamp": "05:16:57", "text": "ええ、彼は文字通り彼らと一緒にいました。私"}, {"type": "subtitle", "time": 19019.91, "timestamp": "05:16:59", "text": "通り過ぎた"}]
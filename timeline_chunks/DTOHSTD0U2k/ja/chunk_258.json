[{"type": "subtitle", "time": 15483.67, "timestamp": "04:18:03", "text": "ああ、パトロンを殺せばいいんだよ。"}, {"type": "subtitle", "time": 15485.99, "timestamp": "04:18:05", "text": "皆さん、ワイルドカードが登場です。彼の"}, {"type": "subtitle", "time": 15488.07, "timestamp": "04:18:08", "text": "名前はジョーカーです。ええ、彼はここにいます。こんにちは、"}, {"type": "subtitle", "time": 15490.309, "timestamp": "04:18:10", "text": "ジョーカー。こんにちは。こんにちは、ジョーカー。お会いできて嬉しいです"}, {"type": "subtitle", "time": 15498.71, "timestamp": "04:18:18", "text": "ジョーカー、君は"}, {"type": "subtitle", "time": 15501.83, "timestamp": "04:18:21", "text": "ジョーカー？私たちは社会に生きているのだろうか？"}, {"type": "subtitle", "time": 15509.75, "timestamp": "04:18:29", "text": "親たちはこれを赤くする準備ができている。いいえ、"}, {"type": "subtitle", "time": 15516.79, "timestamp": "04:18:36", "text": "ああ、あなたは変わることができる"}, {"type": "subtitle", "time": 15519.349, "timestamp": "04:18:39", "text": "常に標的にされている。"}, {"type": "subtitle", "time": 15521.349, "timestamp": "04:18:41", "text": "かわいそうに、犬。いや、違うよ。"}, {"type": "subtitle", "time": 15524.309, "timestamp": "04:18:44", "text": "大丈夫です。大丈夫。"}, {"type": "subtitle", "time": 15527.03, "timestamp": "04:18:47", "text": "ああ、兄弟。おい、なんで俺を殺したんだよ？"}, {"type": "subtitle", "time": 15530.55, "timestamp": "04:18:50", "text": "自警団員。はぁ？ええ、まさにその通りです。"}, {"type": "subtitle", "time": 15537.269, "timestamp": "04:18:57", "text": "みんな"}, {"type": "subtitle", "time": 15539.11, "timestamp": "04:18:59", "text": "知っていたことを忘れてください"}]
[{"type": "subtitle", "time": 15601.349, "timestamp": "04:20:01", "text": "ドードーはドードーです。"}, {"type": "subtitle", "time": 15604.149, "timestamp": "04:20:04", "text": "完全に。それは私です。彼を信用してはいけない。しないで"}, {"type": "subtitle", "time": 15607.51, "timestamp": "04:20:07", "text": "彼を信じてください。ハレルヤ。ああ、私を信じてください。"}, {"type": "subtitle", "time": 15614.95, "timestamp": "04:20:14", "text": "えっと、誰ですか"}, {"type": "subtitle", "time": 15618.229, "timestamp": "04:20:18", "text": "人食い人種は誰ですか？おい、こいつは誰だ？"}, {"type": "subtitle", "time": 15621.59, "timestamp": "04:20:21", "text": "生き物？力強い鷲。"}, {"type": "subtitle", "time": 15625.99, "timestamp": "04:20:25", "text": "何？写真があります。"}, {"type": "subtitle", "time": 15628.07, "timestamp": "04:20:28", "text": "漁師はカモ以外の魚をターゲットにして"}, {"type": "subtitle", "time": 15631.11, "timestamp": "04:20:31", "text": "彼らの投票権。あなたの任務は何ですか？"}, {"type": "subtitle", "time": 15635.75, "timestamp": "04:20:35", "text": "待って、私のノンはありません。ああ、私のロイン"}, {"type": "subtitle", "time": 15638.229, "timestamp": "04:20:38", "text": "力。それはどういう意味ですか？ああ、それ"}, {"type": "subtitle", "time": 15640.389, "timestamp": "04:20:40", "text": "つまり、投票する人は"}, {"type": "subtitle", "time": 15642.79, "timestamp": "04:20:42", "text": "もっと投票してほしい。"}, {"type": "subtitle", "time": 15646.87, "timestamp": "04:20:46", "text": "1票の影響力は、より大きなものになるだろう。"}, {"type": "subtitle", "time": 15651.429, "timestamp": "04:20:51", "text": "ええ、ロビイストプラス1票ですね。"}, {"type": "subtitle", "time": 15653.11, "timestamp": "04:20:53", "text": "プラス1かプラス2だと思う。私"}, {"type": "subtitle", "time": 15655.59, "timestamp": "04:20:55", "text": "覚えていない。"}, {"type": "subtitle", "time": 15658.07, "timestamp": "04:20:58", "text": "わかった、"}]
[{"type": "subtitle", "time": 2160.71, "timestamp": "00:36:00", "text": "何が起こったのか知っているか？"}, {"type": "subtitle", "time": 2163.75, "timestamp": "00:36:03", "text": "もし彼がそうだったら？すべての"}, {"type": "subtitle", "time": 2166.39, "timestamp": "00:36:06", "text": "ティ村の悲劇は"}, {"type": "subtitle", "time": 2176.069, "timestamp": "00:36:16", "text": "実生活に基づいて物語を作り、"}, {"type": "subtitle", "time": 2179.109, "timestamp": "00:36:19", "text": "彼の歪んだ信念を支持する。それは"}, {"type": "subtitle", "time": 2181.19, "timestamp": "00:36:21", "text": "彼ならやりそうなことだ。私たちは"}, {"type": "subtitle", "time": 2184.15, "timestamp": "00:36:24", "text": "彼の言葉を鵜呑みにしてはいけない。今"}, {"type": "subtitle", "time": 2186.23, "timestamp": "00:36:26", "text": "儀式が行われた場所を特定しなければならない"}, {"type": "subtitle", "time": 2197.91, "timestamp": "00:36:37", "text": "それは氷河の氷のようなもので、"}, {"type": "subtitle", "time": 2202.39, "timestamp": "00:36:42", "text": "倒れた。誰かが見ている。"}, {"type": "subtitle", "time": 2204.71, "timestamp": "00:36:44", "text": "酸性の2つの異なる周波数"}, {"type": "subtitle", "time": 2209.03, "timestamp": "00:36:49", "text": "不和。なるほど。私はそれを感じます"}, {"type": "subtitle", "time": 2214.55, "timestamp": "00:36:54", "text": "あちらに流れがある。私に従ってください。では"}]
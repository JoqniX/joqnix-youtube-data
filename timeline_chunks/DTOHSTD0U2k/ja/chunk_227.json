[{"type": "subtitle", "time": 13620.07, "timestamp": "03:47:00", "text": "敏感なイム"}, {"type": "subtitle", "time": 13624.15, "timestamp": "03:47:04", "text": "ここにいる全員に触れてみてください。"}, {"type": "subtitle", "time": 13625.349, "timestamp": "03:47:05", "text": "うん。うん。みんな、誰が誰に触れているのか"}, {"type": "subtitle", "time": 13627.11, "timestamp": "03:47:07", "text": "誰でも？ただ教えてくれればいいんだよ。病気"}, {"type": "subtitle", "time": 13629.429, "timestamp": "03:47:09", "text": "タッチ"}, {"type": "subtitle", "time": 13631.91, "timestamp": "03:47:11", "text": "カウンタータッチします。手伝いますよ。全て"}, {"type": "subtitle", "time": 13633.59, "timestamp": "03:47:13", "text": "右。私に触れる者なら誰でも助けてあげる"}, {"type": "subtitle", "time": 13635.91, "timestamp": "03:47:15", "text": "すべての人に触れる。"}, {"type": "subtitle", "time": 13638.63, "timestamp": "03:47:18", "text": "カウンタータッチ。"}, {"type": "subtitle", "time": 13643.349, "timestamp": "03:47:23", "text": "お互いに触れ合う。特別なもののように聞こえますね"}, {"type": "subtitle", "time": 13648.07, "timestamp": "03:47:28", "text": "JRPGから移行。互いに触れ合う"}, {"type": "subtitle", "time": 13650.229, "timestamp": "03:47:30", "text": "コロナウイルス。"}, {"type": "subtitle", "time": 13651.349, "timestamp": "03:47:31", "text": "わかった。"}, {"type": "subtitle", "time": 13653.67, "timestamp": "03:47:33", "text": "そして教えてください。教えて。私は絶対に"}, {"type": "subtitle", "time": 13663.83, "timestamp": "03:47:43", "text": "誰かの風が吹いてくる音が聞こえる"}, {"type": "subtitle", "time": 13666.87, "timestamp": "03:47:46", "text": "マイク。"}, {"type": "subtitle", "time": 13670.71, "timestamp": "03:47:50", "text": "全く分からない。私じゃないよ。"}]
[{"type": "subtitle", "time": 12662.71, "timestamp": "03:31:02", "text": "誤解したようだ。なんてこった。ごめんね、みんな。私の"}, {"type": "subtitle", "time": 12668.15, "timestamp": "03:31:08", "text": "悪い。ここに何人か人がいます。お願いします。"}, {"type": "subtitle", "time": 12676.79, "timestamp": "03:31:16", "text": "自己紹介をお願いします。"}, {"type": "subtitle", "time": 12681.51, "timestamp": "03:31:21", "text": "エリック。ごめん。待って。ローがここにいる。いいえ。ええ。"}, {"type": "subtitle", "time": 12684.79, "timestamp": "03:31:24", "text": "彼はどこにいますか？どこ？"}, {"type": "subtitle", "time": 12689.03, "timestamp": "03:31:29", "text": "彼がそこにいる。みんな彼を取り囲め。"}, {"type": "subtitle", "time": 12690.87, "timestamp": "03:31:30", "text": "ああ、それはあなたが彼に"}, {"type": "subtitle", "time": 12705.67, "timestamp": "03:31:45", "text": "建設作業をしている人がいます"}, {"type": "subtitle", "time": 12707.349, "timestamp": "03:31:47", "text": "自己紹介をしてください。ええ、私たちは"}, {"type": "subtitle", "time": 12709.67, "timestamp": "03:31:49", "text": "彼を待っている。あなたはそれをやったのです。みんな"}, {"type": "subtitle", "time": 12710.95, "timestamp": "03:31:50", "text": "出て行って、"}, {"type": "subtitle", "time": 12714.15, "timestamp": "03:31:54", "text": "方法。うん。"}, {"type": "subtitle", "time": 12717.51, "timestamp": "03:31:57", "text": "彼らとは距離を置きなさい。うん。近寄らないで"}]
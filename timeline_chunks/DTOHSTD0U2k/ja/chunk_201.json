[{"type": "subtitle", "time": 12060.71, "timestamp": "03:21:00", "text": "嘘だ。全くの嘘だ。私は犯罪現場にいた"}, {"type": "subtitle", "time": 12062.63, "timestamp": "03:21:02", "text": "病院へと続く路地。私は近くにいます"}, {"type": "subtitle", "time": 12064.229, "timestamp": "03:21:04", "text": "町立公園エリア。お前の雌犬は見ていない"}, {"type": "subtitle", "time": 12074.389, "timestamp": "03:21:14", "text": "では、私たちは誰に投票するのでしょうか？私たちは誰ですか？"}, {"type": "subtitle", "time": 12077.269, "timestamp": "03:21:17", "text": "誰に投票しますか？ドラッグ。ドラッグ。投票する。グレッグ。得る"}, {"type": "subtitle", "time": 12079.99, "timestamp": "03:21:19", "text": "彼をここから追い出せ。いや、いや、いや、いや、いや。あなた"}, {"type": "subtitle", "time": 12081.349, "timestamp": "03:21:21", "text": "私がそう思うもう一つの理由を知りたい"}, {"type": "subtitle", "time": 12083.75, "timestamp": "03:21:23", "text": "面倒くさい？"}, {"type": "subtitle", "time": 12085.11, "timestamp": "03:21:25", "text": "彼は私を追放しようとした。彼は試みた"}, {"type": "subtitle", "time": 12088.389, "timestamp": "03:21:28", "text": "アリバイがあったにもかかわらず、私を落選させた。"}, {"type": "subtitle", "time": 12090.15, "timestamp": "03:21:30", "text": "彼は私を追放しようとした。わかった。あなたが知っている"}, {"type": "subtitle", "time": 12092.79, "timestamp": "03:21:32", "text": "何？あのね？抵抗ではない。もし"}, {"type": "subtitle", "time": 12095.11, "timestamp": "03:21:35", "text": "ドラッグじゃない、投票して。うん。もしそうでないなら"}, {"type": "subtitle", "time": 12097.429, "timestamp": "03:21:37", "text": "ドラッグして、私に投票してください。"}, {"type": "subtitle", "time": 12100.389, "timestamp": "03:21:40", "text": "私は怖いです。それは抵抗だ。わからない。私は"}, {"type": "subtitle", "time": 12103.19, "timestamp": "03:21:43", "text": "スキップします"}, {"type": "subtitle", "time": 12110.15, "timestamp": "03:21:50", "text": "何てことだ。おお。"}, {"type": "subtitle", "time": 12113.19, "timestamp": "03:21:53", "text": "頭を使え。頭を使え。来て。"}, {"type": "subtitle", "time": 12117.11, "timestamp": "03:21:57", "text": "オキシ。キック。ドラッグ。彼をここから追い出せ。"}, {"type": "subtitle", "time": 12118.87, "timestamp": "03:21:58", "text": "私は彼をクリックしただけです。クリックしました"}]
[{"type": "subtitle", "time": 18121.43, "timestamp": "05:02:01", "text": "知る？だって、君はそれを知っていたんだから。あなたは話さなかった"}, {"type": "subtitle", "time": 18125.59, "timestamp": "05:02:05", "text": "ハトを見かけるたびに。私は推測する"}, {"type": "subtitle", "time": 18127.99, "timestamp": "05:02:07", "text": "心配しないで。大丈夫。いいえ、私は"}, {"type": "subtitle", "time": 18131.75, "timestamp": "05:02:11", "text": "知る。いいえ、話してください。やり方を知りたい。いいえ、"}, {"type": "subtitle", "time": 18136.07, "timestamp": "05:02:16", "text": "あなたはセンサーを避けたが、私は"}, {"type": "subtitle", "time": 18138.23, "timestamp": "05:02:18", "text": "科学者が何をしているのかを知る。だから、私はただ"}, {"type": "subtitle", "time": 18141.19, "timestamp": "05:02:21", "text": "まるで100IQのプレーみたいだ。聖なる"}, {"type": "subtitle", "time": 18143.91, "timestamp": "05:02:23", "text": "くそっ。私は落ち込んでいるようだった。こんにちはと言いました"}, {"type": "subtitle", "time": 18146.15, "timestamp": "05:02:26", "text": "あなたに連絡しましたが、彼女は返事をしませんでした。彼女はただ"}, {"type": "subtitle", "time": 18148.23, "timestamp": "05:02:28", "text": "下がった。"}, {"type": "subtitle", "time": 18150.788, "timestamp": "05:02:30", "text": "わかった。私は"}, {"type": "subtitle", "time": 18153.83, "timestamp": "05:02:33", "text": "起きる。"}, {"type": "subtitle", "time": 18157.43, "timestamp": "05:02:37", "text": "彼から電話がかかってきた。"}, {"type": "subtitle", "time": 18159.19, "timestamp": "05:02:39", "text": "右？そして彼は天才だ。私たち全員"}, {"type": "subtitle", "time": 18160.788, "timestamp": "05:02:40", "text": "それを知っている。"}, {"type": "subtitle", "time": 18163.75, "timestamp": "05:02:43", "text": "ジョーは実は、人並み外れた天才のような存在だ。"}, {"type": "subtitle", "time": 18168.628, "timestamp": "05:02:48", "text": "ああ、あの行列はすごかったね。私が"}, {"type": "subtitle", "time": 18171.35, "timestamp": "05:02:51", "text": "間違ったサイズでミュートして、"}, {"type": "subtitle", "time": 18172.948, "timestamp": "05:02:52", "text": "私の声を聞いたか何かでしょう。そして誰でも"}, {"type": "subtitle", "time": 18174.628, "timestamp": "05:02:54", "text": "センサーを選んだら、大変なことになるぞ"}, {"type": "subtitle", "time": 18177.35, "timestamp": "05:02:57", "text": "やっとだ。"}]
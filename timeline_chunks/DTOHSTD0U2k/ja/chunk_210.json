[{"type": "subtitle", "time": 12601.51, "timestamp": "03:30:01", "text": "なんてこった。私は嘘をついた。また、あなたの"}, {"type": "subtitle", "time": 12603.349, "timestamp": "03:30:03", "text": "ヘッドバンド、"}, {"type": "subtitle", "time": 12608.15, "timestamp": "03:30:08", "text": "バカ。私は嘘をつきました。つまり、"}, {"type": "subtitle", "time": 12610.309, "timestamp": "03:30:10", "text": "あなたを食べる。はい、忘れたように聞こえますね"}, {"type": "subtitle", "time": 12613.99, "timestamp": "03:30:13", "text": "真実について。ああ、忘れてた"}, {"type": "subtitle", "time": 12616.15, "timestamp": "03:30:16", "text": "あのね？[ __ ]って言った"}, {"type": "subtitle", "time": 12617.59, "timestamp": "03:30:17", "text": "最初に殺された。正直に言うと"}, {"type": "subtitle", "time": 12619.429, "timestamp": "03:30:19", "text": "あなた。"}, {"type": "subtitle", "time": 12627.349, "timestamp": "03:30:27", "text": "よぉ、Rokuがここに来たぞ。さあ行こう。わかった、"}, {"type": "subtitle", "time": 12629.03, "timestamp": "03:30:29", "text": "さあ行こう。よし、彼に少し時間をあげよう"}, {"type": "subtitle", "time": 12640.63, "timestamp": "03:30:40", "text": "XR。"}, {"type": "subtitle", "time": 12652.15, "timestamp": "03:30:52", "text": "マッチがあります"}, {"type": "subtitle", "time": 12654.15, "timestamp": "03:30:54", "text": "待って"}, {"type": "subtitle", "time": 12659.99, "timestamp": "03:30:59", "text": "あなたは何かを拍手していますね。あなただと思う"}]
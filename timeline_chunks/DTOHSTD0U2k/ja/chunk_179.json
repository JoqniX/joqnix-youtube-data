[{"type": "subtitle", "time": 10740.15, "timestamp": "02:59:00", "text": "マインクラフト。"}, {"type": "subtitle", "time": 10741.83, "timestamp": "02:59:01", "text": "えっと、"}, {"type": "subtitle", "time": 10751.269, "timestamp": "02:59:11", "text": "私は一日中あなたの後をつけていました。"}, {"type": "subtitle", "time": 10752.87, "timestamp": "02:59:12", "text": "よお、"}, {"type": "subtitle", "time": 10756.87, "timestamp": "02:59:16", "text": "これは何ですか？ああ、これは私が理解しているようなものです"}, {"type": "subtitle", "time": 10759.429, "timestamp": "02:59:19", "text": "カスタマイザー。"}, {"type": "subtitle", "time": 10765.51, "timestamp": "02:59:25", "text": "よし。つまり、あなたがホスト役なんですね。消去"}, {"type": "subtitle", "time": 10781.11, "timestamp": "02:59:41", "text": "おお、君たちはなかなかいい感じに並んでるね"}, {"type": "subtitle", "time": 10789.03, "timestamp": "02:59:49", "text": "いいセリフだね、みんな。"}, {"type": "subtitle", "time": 10793.03, "timestamp": "02:59:53", "text": "おい、そのセリフはすごくオーマイ"}, {"type": "subtitle", "time": 10795.89, "timestamp": "02:59:55", "text": "神。完璧。"}, {"type": "subtitle", "time": 10797.67, "timestamp": "02:59:57", "text": "[音楽]"}, {"type": "subtitle", "time": 10799.51, "timestamp": "02:59:59", "text": "ああ、ぜひご参加ください。参加しませんか。参加しませんか。そこで私たちは"}]
[{"type": "subtitle", "time": 4564.79, "timestamp": "01:16:04", "text": "H."}, {"type": "subtitle", "time": 4590.63, "timestamp": "01:16:30", "text": "ああ、君は芝刈りをするんだね。お前を迎えに行くぞ。来る"}, {"type": "subtitle", "time": 4593.35, "timestamp": "01:16:33", "text": "ここ。ここに来て。ここに来て。ここに来て。"}, {"type": "subtitle", "time": 4597.11, "timestamp": "01:16:37", "text": "行かないで。いいえ。いいえ。"}, {"type": "subtitle", "time": 4604.87, "timestamp": "01:16:44", "text": "おお。"}]
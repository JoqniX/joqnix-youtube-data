[{"type": "subtitle", "time": 15301.349, "timestamp": "04:15:01", "text": "男の子。確かに甘いですが、"}, {"type": "subtitle", "time": 15305.51, "timestamp": "04:15:05", "text": "Discordでミュートするのを忘れないでください。"}, {"type": "subtitle", "time": 15326.309, "timestamp": "04:15:26", "text": "待って。いいえ、それは、"}, {"type": "subtitle", "time": 15328.63, "timestamp": "04:15:28", "text": "けれど。あ、待って。では、なぜ殺したのですか？"}, {"type": "subtitle", "time": 15336.95, "timestamp": "04:15:36", "text": "ああ、くそ。"}, {"type": "subtitle", "time": 15341.269, "timestamp": "04:15:41", "text": "ああ、彼は席を外している。なるほど。わかったよ、兄弟。彼は"}, {"type": "subtitle", "time": 15342.63, "timestamp": "04:15:42", "text": "爆発を起こすつもり？あなたは"}, {"type": "subtitle", "time": 15345.429, "timestamp": "04:15:45", "text": "道路を空けてください。"}, {"type": "subtitle", "time": 15355.03, "timestamp": "04:15:55", "text": "落とす。なぜ彼は爆弾を投下しないのか？"}, {"type": "subtitle", "time": 15359.189, "timestamp": "04:15:59", "text": "くそ。こんにちは。待って。えーと、それで、私たちだけ"}]
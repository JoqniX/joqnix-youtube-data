[{"type": "subtitle", "time": 15903.59, "timestamp": "04:25:03", "text": "殺人者だったから、彼も一緒に死んだ。"}, {"type": "subtitle", "time": 15905.59, "timestamp": "04:25:05", "text": "わかった。わかった。"}, {"type": "subtitle", "time": 15907.11, "timestamp": "04:25:07", "text": "えっと"}, {"type": "subtitle", "time": 15909.67, "timestamp": "04:25:09", "text": "それで、どこに"}, {"type": "subtitle", "time": 15914.389, "timestamp": "04:25:14", "text": "彼女はどこにいたの？ キルはどこにいたの？私はキリと一緒にいました。"}, {"type": "subtitle", "time": 15917.91, "timestamp": "04:25:17", "text": "私は病院の現場にいました。"}, {"type": "subtitle", "time": 15921.91, "timestamp": "04:25:21", "text": "私たちは私と一緒にいなければなりません。ヨッシー、"}, {"type": "subtitle", "time": 15925.03, "timestamp": "04:25:25", "text": "一体何が必要になるんだ？君たちは欲しい"}, {"type": "subtitle", "time": 15927.349, "timestamp": "04:25:27", "text": "私たちを連れ戻すため？私は探しに行きます"}, {"type": "subtitle", "time": 15929.67, "timestamp": "04:25:29", "text": "あなた。持続する。録音しただけだと思います"}, {"type": "subtitle", "time": 15931.91, "timestamp": "04:25:31", "text": "だって、混乱してたんだもん。あなたがそうしたいのは分かっています。"}, {"type": "subtitle", "time": 15935.429, "timestamp": "04:25:35", "text": "知っている。知っている。または、スキップしてください。"}, {"type": "subtitle", "time": 15938.469, "timestamp": "04:25:38", "text": "じゃあ、スキップするの？スキップしています。ええ、私は"}, {"type": "subtitle", "time": 15941.83, "timestamp": "04:25:41", "text": "私たちはそう思っている。私たちは。私はただ"}, {"type": "subtitle", "time": 15944.469, "timestamp": "04:25:44", "text": "スキップ。とても混乱しています。それはとても"}]
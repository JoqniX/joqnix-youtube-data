[{"type": "subtitle", "time": 10502.23, "timestamp": "02:55:02", "text": "1 2 3 4 5 6 7 8 人。いいえ、誰かの"}, {"type": "subtitle", "time": 10504.15, "timestamp": "02:55:04", "text": "ない。"}, {"type": "subtitle", "time": 10507.11, "timestamp": "02:55:07", "text": "うん。うん。少なくとも10個は必要だ"}, {"type": "subtitle", "time": 10509.349, "timestamp": "02:55:09", "text": "またはそれ以上。途中で行ってしまったので"}, {"type": "subtitle", "time": 10513.15, "timestamp": "02:55:13", "text": "彼には合わない。 A"}, {"type": "subtitle", "time": 10515.19, "timestamp": "02:55:15", "text": "[音楽]"}, {"type": "subtitle", "time": 10527.91, "timestamp": "02:55:27", "text": "あ、待って。"}, {"type": "subtitle", "time": 10530.87, "timestamp": "02:55:30", "text": "待つしかない。"}, {"type": "subtitle", "time": 10536.15, "timestamp": "02:55:36", "text": "テレンス。ああ、みなさんこんにちは。聞こえますか？"}, {"type": "subtitle", "time": 10537.59, "timestamp": "02:55:37", "text": "自分？"}, {"type": "subtitle", "time": 10540.309, "timestamp": "02:55:40", "text": "はい、聞こえていますよ。"}, {"type": "subtitle", "time": 10543.51, "timestamp": "02:55:43", "text": "こんにちは。マイクは長い間働いていなかった"}, {"type": "subtitle", "time": 10546.469, "timestamp": "02:55:46", "text": "時間。私はただ何なのか分からなかった"}, {"type": "subtitle", "time": 10551.349, "timestamp": "02:55:51", "text": "やるべきこと。わからない。クソッタレ。"}, {"type": "subtitle", "time": 10557.91, "timestamp": "02:55:57", "text": "騎手"}, {"type": "subtitle", "time": 10559.83, "timestamp": "02:55:59", "text": "ゲーム内ですぐに自分の声をミュートする。"}]
[{"type": "subtitle", "time": 1560.71, "timestamp": "00:26:00", "text": "羊飼いの指示に従い、"}, {"type": "subtitle", "time": 1564.71, "timestamp": "00:26:04", "text": "何度も何度も願い事をする。彼らは"}, {"type": "subtitle", "time": 1569.43, "timestamp": "00:26:09", "text": "子羊。何てことだ。静かに。黒い子羊が話した"}, {"type": "subtitle", "time": 1573.83, "timestamp": "00:26:13", "text": "立ち上がって、群れの見せかけを打ち砕いた。彼らの"}, {"type": "subtitle", "time": 1578.95, "timestamp": "00:26:18", "text": "平和で幸せな生活という幻想。"}, {"type": "subtitle", "time": 1588.47, "timestamp": "00:26:28", "text": "そして羊飼いの偉大な"}, {"type": "subtitle", "time": 1598.149, "timestamp": "00:26:38", "text": "突然、彼らは血と"}, {"type": "subtitle", "time": 1602.23, "timestamp": "00:26:42", "text": "過去の犠牲の灰が散乱している。今"}, {"type": "subtitle", "time": 1610.549, "timestamp": "00:26:50", "text": "それがあなたの邪悪な本質です。"}, {"type": "subtitle", "time": 1614.47, "timestamp": "00:26:54", "text": "私の話はどうだった、ローバー？"}, {"type": "subtitle", "time": 1617.83, "timestamp": "00:26:57", "text": "しかし、私のMODは食べ続けています。あなたが"}]
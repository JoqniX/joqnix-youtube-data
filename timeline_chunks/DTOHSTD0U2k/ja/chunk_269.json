[{"type": "subtitle", "time": 16146.95, "timestamp": "04:29:06", "text": "楽しかった。ほら、ほら、私は食べる"}, {"type": "subtitle", "time": 16151.75, "timestamp": "04:29:11", "text": "彼女はとても怖がっていたから。"}, {"type": "subtitle", "time": 16157.91, "timestamp": "04:29:17", "text": "ヨシ、どうして私を探しているの？私"}, {"type": "subtitle", "time": 16161.269, "timestamp": "04:29:21", "text": "文字通り、私は保安官だとあなたに言ったでしょう。"}, {"type": "subtitle", "time": 16162.95, "timestamp": "04:29:22", "text": "いいえ、"}, {"type": "subtitle", "time": 16164.55, "timestamp": "04:29:24", "text": "なぜ殺すのか なぜ殺すのか"}, {"type": "subtitle", "time": 16166.229, "timestamp": "04:29:26", "text": "ドラゴン？"}, {"type": "subtitle", "time": 16169.349, "timestamp": "04:29:29", "text": "コンテストで面白いからだよ。それ"}, {"type": "subtitle", "time": 16170.87, "timestamp": "04:29:30", "text": "だった"}, {"type": "subtitle", "time": 16173.189, "timestamp": "04:29:33", "text": "私"}, {"type": "subtitle", "time": 16174.79, "timestamp": "04:29:34", "text": "半分以上食べるように"}, {"type": "subtitle", "time": 16182.95, "timestamp": "04:29:42", "text": "あなたは美味しいものを食べていましたね。そしてその後、私は"}, {"type": "subtitle", "time": 16185.75, "timestamp": "04:29:45", "text": "わざと[ __ ]を食べたくないのは"}, {"type": "subtitle", "time": 16195.51, "timestamp": "04:29:55", "text": "「最後の試合だ」と彼は言う。なあ、俺はこう思ったんだ、"}, {"type": "subtitle", "time": 16197.51, "timestamp": "04:29:57", "text": "ヨッシー、逃げろ。そして私は逃げようとしていた。私"}, {"type": "subtitle", "time": 16199.51, "timestamp": "04:29:59", "text": "まるで、亀仙人、私にはできない、という感じだった。"}]
[{"type": "subtitle", "time": 2281.91, "timestamp": "00:38:01", "text": "山で帽子をなくした。ピース"}, {"type": "subtitle", "time": 2284.069, "timestamp": "00:38:04", "text": "彼らは何の支援も受けずに一緒にいた。ただ"}, {"type": "subtitle", "time": 2286.55, "timestamp": "00:38:06", "text": "走っている。"}, {"type": "subtitle", "time": 2289.27, "timestamp": "00:38:09", "text": "史上最高のゲーム。"}, {"type": "subtitle", "time": 2292.15, "timestamp": "00:38:12", "text": "文句なし。史上最高のゲーム。"}, {"type": "subtitle", "time": 2322.23, "timestamp": "00:38:42", "text": "[音楽]"}, {"type": "subtitle", "time": 2325.19, "timestamp": "00:38:45", "text": "まるで小さなクモのようだ。この男"}, {"type": "subtitle", "time": 2328.31, "timestamp": "00:38:48", "text": "原神とは違って、登り道があるんだ"}, {"type": "subtitle", "time": 2330.069, "timestamp": "00:38:50", "text": "それは上昇している。これは小さな"}, {"type": "subtitle", "time": 2332.47, "timestamp": "00:38:52", "text": "スパイダー"}]
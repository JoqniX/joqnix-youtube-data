[{"type": "subtitle", "time": 10447.429, "timestamp": "02:54:07", "text": "そうするべきだった。ああ、あなたは話すのですね。これ"}, {"type": "subtitle", "time": 10449.75, "timestamp": "02:54:09", "text": "このゲームでは、テレン"}, {"type": "subtitle", "time": 10452.15, "timestamp": "02:54:12", "text": "まるで、ああ、私は"}, {"type": "subtitle", "time": 10455.91, "timestamp": "02:54:15", "text": "そうだよね？まるで幽霊犬みたいだね。"}, {"type": "subtitle", "time": 10460.95, "timestamp": "02:54:20", "text": "右。私は幽霊のように何もしない。"}, {"type": "subtitle", "time": 10464.389, "timestamp": "02:54:24", "text": "さぁ行こう。私はここから立ち去ることができます。"}, {"type": "subtitle", "time": 10470.71, "timestamp": "02:54:30", "text": "はい。さぁ行こう。私はそうする必要があるかもしれない"}, {"type": "subtitle", "time": 10473.269, "timestamp": "02:54:33", "text": "そうそう。スキンは何もアンロックしませんでした。どうやって"}, {"type": "subtitle", "time": 10475.75, "timestamp": "02:54:35", "text": "あなたはこれをしますか？"}, {"type": "subtitle", "time": 10477.83, "timestamp": "02:54:37", "text": "わかった。"}, {"type": "subtitle", "time": 10484.63, "timestamp": "02:54:44", "text": "次回は遅刻しないように気をつけます"}, {"type": "subtitle", "time": 10487.11, "timestamp": "02:54:47", "text": "このような。私は外に出て準備をしなければならなかった"}, {"type": "subtitle", "time": 10490.07, "timestamp": "02:54:50", "text": "GSCのやつ。そうそう。わかった。だから私は行ける"}, {"type": "subtitle", "time": 10493.03, "timestamp": "02:54:53", "text": "次。私は間違いなく"}, {"type": "subtitle", "time": 10495.349, "timestamp": "02:54:55", "text": "移動しました。誰かが感動するだろう。こんにちは。"}, {"type": "subtitle", "time": 10498.55, "timestamp": "02:54:58", "text": "こんにちは。こんにちは。待って、誰がいないの？"}]
[{"type": "subtitle", "time": 15362.79, "timestamp": "04:16:02", "text": "死者は互いの声を聞くことができるか、"}, {"type": "subtitle", "time": 15365.59, "timestamp": "04:16:05", "text": "私たちの声が聞こえない。彼らには私たちの声が聞こえない。彼らは"}, {"type": "subtitle", "time": 15368.79, "timestamp": "04:16:08", "text": "全てを聞き取ることはできません。うん。なぜなぜ"}, {"type": "subtitle", "time": 15373.67, "timestamp": "04:16:13", "text": "あなたはそうではない なぜあなたはそうではないのですか えーと えーと"}, {"type": "subtitle", "time": 15376.469, "timestamp": "04:16:16", "text": "話している？それなら、ミュートにしましょう。"}, {"type": "subtitle", "time": 15378.95, "timestamp": "04:16:18", "text": "なんでみんなミュートで話してるの？"}, {"type": "subtitle", "time": 15381.99, "timestamp": "04:16:21", "text": "テキストメッセージを送ってください。ああ、ついに彼も誰かと付き合ったんだね。彼"}, {"type": "subtitle", "time": 15384.87, "timestamp": "04:16:24", "text": "誰か"}, {"type": "subtitle", "time": 15386.01, "timestamp": "04:16:26", "text": "知る。"}, {"type": "subtitle", "time": 15388.63, "timestamp": "04:16:28", "text": "[音楽]"}, {"type": "subtitle", "time": 15391.91, "timestamp": "04:16:31", "text": "こんにちは。私は死んだ。"}, {"type": "subtitle", "time": 15398.71, "timestamp": "04:16:38", "text": "くそ。"}, {"type": "subtitle", "time": 15402.63, "timestamp": "04:16:42", "text": "ああ、君だったのか、兄弟。くそ。"}, {"type": "subtitle", "time": 15408.79, "timestamp": "04:16:48", "text": "それが私が望まなかった理由だった"}, {"type": "subtitle", "time": 15411.51, "timestamp": "04:16:51", "text": "私の役割を言うと、わかるでしょう。"}, {"type": "subtitle", "time": 15415.91, "timestamp": "04:16:55", "text": "レネが勝つ。レネが勝つ。ハトの勝ち。"}, {"type": "subtitle", "time": 15418.79, "timestamp": "04:16:58", "text": "ハトの勝ち。いつも。言っておくけど"}]
[{"type": "subtitle", "time": 4636.63, "timestamp": "01:17:16", "text": "あまり長くプレイすることはできない。見てみましょう。私"}, {"type": "subtitle", "time": 4638.229, "timestamp": "01:17:18", "text": "つまり、私はゲームをやめるつもりです"}, {"type": "subtitle", "time": 4641.59, "timestamp": "01:17:21", "text": "数週間。心配しないで。それらの試験"}, {"type": "subtitle", "time": 4644.95, "timestamp": "01:17:24", "text": "時々チェックしてください。いいえ、私の唯一の"}, {"type": "subtitle", "time": 4648.709, "timestamp": "01:17:28", "text": "選択肢としては、スイングを行うことです。電話します"}, {"type": "subtitle", "time": 4650.95, "timestamp": "01:17:30", "text": "迅速かつ断固とした対応。いいえ、私の"}, {"type": "subtitle", "time": 4663.189, "timestamp": "01:17:43", "text": "迅速かつ断固とした。"}, {"type": "subtitle", "time": 4665.669, "timestamp": "01:17:45", "text": "影から攻撃せよ。なぜ銃は"}, {"type": "subtitle", "time": 4669.189, "timestamp": "01:17:49", "text": "銃 えーと、戦闘がなぜこんなにクールなのか？それ"}, {"type": "subtitle", "time": 4675.56, "timestamp": "01:17:55", "text": "うん。"}]
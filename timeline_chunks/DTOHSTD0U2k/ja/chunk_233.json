[{"type": "subtitle", "time": 13986.15, "timestamp": "03:53:06", "text": "2つの選択肢があります。ああ、くそ。ああ、くそ。私"}, {"type": "subtitle", "time": 13988.79, "timestamp": "03:53:08", "text": "全部言ったよ、待って。わかった。"}, {"type": "subtitle", "time": 13990.309, "timestamp": "03:53:10", "text": "私は全部ミュートにして話した。よし。"}, {"type": "subtitle", "time": 13993.269, "timestamp": "03:53:13", "text": "もう一度言います。私とレイジャー"}, {"type": "subtitle", "time": 13995.429, "timestamp": "03:53:15", "text": "遺体は礼拝堂にあり、"}, {"type": "subtitle", "time": 13997.11, "timestamp": "03:53:17", "text": "別人だった。誰だったか覚えていない"}, {"type": "subtitle", "time": 13998.63, "timestamp": "03:53:18", "text": "しかし、私はこれを聞きました。私は彼らの声を聞いた"}, {"type": "subtitle", "time": 14001.91, "timestamp": "03:53:21", "text": "そして、私はそれが人だと思う。なぜなら、私が保証できるから。"}, {"type": "subtitle", "time": 14004.309, "timestamp": "03:53:24", "text": "オキシ。ああ、ハンハン。他に誰がいたの？"}, {"type": "subtitle", "time": 14006.79, "timestamp": "03:53:26", "text": "逃げているの？ハンハン。えっと、私は"}, {"type": "subtitle", "time": 14010.389, "timestamp": "03:53:30", "text": "あなたから逃げている。私は"}, {"type": "subtitle", "time": 14012.55, "timestamp": "03:53:32", "text": "そこには"}, {"type": "subtitle", "time": 14015.349, "timestamp": "03:53:35", "text": "そして、彼らは一緒にいた。"}, {"type": "subtitle", "time": 14018.469, "timestamp": "03:53:38", "text": "ええと、見ました"}, {"type": "subtitle", "time": 14020.95, "timestamp": "03:53:40", "text": "私が君たちのところに行ったとき、ハンに会いました"}, {"type": "subtitle", "time": 14028.469, "timestamp": "03:53:48", "text": "私ではありません。私の話を聞いて下さい。持続する。"}, {"type": "subtitle", "time": 14031.189, "timestamp": "03:53:51", "text": "私の話を聞いて下さい。うん。彼女だと思う。"}, {"type": "subtitle", "time": 14033.269, "timestamp": "03:53:53", "text": "彼女だ。私は彼らの声を聞いた。わかった。私"}, {"type": "subtitle", "time": 14034.95, "timestamp": "03:53:54", "text": "私がそこにいる間に彼らの音を聞いた"}, {"type": "subtitle", "time": 14037.59, "timestamp": "03:53:57", "text": "画面に映った後、死亡した。ポップアップを見た"}, {"type": "subtitle", "time": 14039.59, "timestamp": "03:53:59", "text": "その有名人は亡くなった。そこで私は調べた"}]
[{"type": "subtitle", "time": 17760.23, "timestamp": "04:56:00", "text": "[音楽]"}, {"type": "subtitle", "time": 17762.15, "timestamp": "04:56:02", "text": "なぜ？"}, {"type": "subtitle", "time": 17764.708, "timestamp": "04:56:04", "text": "我々の勝ちだ。おそらくその通りでしょう。ドラッグは"}, {"type": "subtitle", "time": 17770.23, "timestamp": "04:56:10", "text": "いずれにせよ、我々は勝つ。あなたの言う通りでした。私たちは"}, {"type": "subtitle", "time": 17772.47, "timestamp": "04:56:12", "text": "勝敗は関係ない。私は言った、"}, {"type": "subtitle", "time": 17775.03, "timestamp": "04:56:15", "text": "持って行けよ、兄弟。黙れ。楽勝だ。私"}, {"type": "subtitle", "time": 17777.67, "timestamp": "04:56:17", "text": "彼を殺さなければならなかった。楽勝。私たちはただ"}, {"type": "subtitle", "time": 17779.67, "timestamp": "04:56:19", "text": "私たちはただあなたに与えているだけです 私たちはただ作っているだけです"}, {"type": "subtitle", "time": 17782.15, "timestamp": "04:56:22", "text": "スミさんにとって、その方が楽ですよ。私たちは 私たちは"}, {"type": "subtitle", "time": 17788.708, "timestamp": "04:56:28", "text": "目的もなく。 「うん、そうだね」"}, {"type": "subtitle", "time": 17793.19, "timestamp": "04:56:33", "text": "「たぶん彼だろう。」 なぜ？どういう意味ですか？"}, {"type": "subtitle", "time": 17795.51, "timestamp": "04:56:35", "text": "ジョー、スミのために戻るの？"}, {"type": "subtitle", "time": 17797.99, "timestamp": "04:56:37", "text": "時間が経つと、あなたはとても怪しくなって、それから"}, {"type": "subtitle", "time": 17799.67, "timestamp": "04:56:39", "text": "お前は彼らの横を通り過ぎて、それから"}, {"type": "subtitle", "time": 17801.59, "timestamp": "04:56:41", "text": "お前らは彼らと話して、それはとても"}, {"type": "subtitle", "time": 17804.948, "timestamp": "04:56:44", "text": "いいえ、ミュートされていました。チャットを読んでいました。それ"}, {"type": "subtitle", "time": 17807.35, "timestamp": "04:56:47", "text": "そうだった。あなたは"}, {"type": "subtitle", "time": 17809.03, "timestamp": "04:56:49", "text": "誰かを殺そうとしている、"}, {"type": "subtitle", "time": 17810.788, "timestamp": "04:56:50", "text": "でもあなたは"}, {"type": "subtitle", "time": 17812.07, "timestamp": "04:56:52", "text": "私を殺さなかった。それは奇妙だ。しかしその後"}, {"type": "subtitle", "time": 17814.31, "timestamp": "04:56:54", "text": "あなたは上に戻ってきて、そして下へ降りて"}, {"type": "subtitle", "time": 17815.67, "timestamp": "04:56:55", "text": "戻ってきて話をした。私は「ああ、"}, {"type": "subtitle", "time": 17819.43, "timestamp": "04:56:59", "text": "「変だね。」うわあ。変だね。私は"}]
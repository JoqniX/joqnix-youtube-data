[{"type": "subtitle", "time": 782.79, "timestamp": "00:13:02", "text": "今の私たちのように。注意深く捕らえられた"}, {"type": "subtitle", "time": 784.31, "timestamp": "00:13:04", "text": "練り上げられた筋書き。元気ですか？私は"}, {"type": "subtitle", "time": 787.35, "timestamp": "00:13:07", "text": "よくやっている。彼は元気ですか？関与していない"}, {"type": "subtitle", "time": 789.99, "timestamp": "00:13:09", "text": "この村は私の"}, {"type": "subtitle", "time": 794.31, "timestamp": "00:13:14", "text": "Jとの話。私は元気です。"}, {"type": "subtitle", "time": 797.19, "timestamp": "00:13:17", "text": "そのため、翻訳が間違っているため"}, {"type": "subtitle", "time": 800.389, "timestamp": "00:13:20", "text": "いつも通り会う。"}, {"type": "subtitle", "time": 830.389, "timestamp": "00:13:50", "text": "はぁ？それは何ですか？"}, {"type": "subtitle", "time": 832.23, "timestamp": "00:13:52", "text": "ああ、それから脅迫しようとしないでください。あなたはしない"}]
[{"type": "subtitle", "time": 13380.95, "timestamp": "03:43:00", "text": "どういう意味ですか？私が嘘をつくとでも思っているの？"}, {"type": "subtitle", "time": 13383.75, "timestamp": "03:43:03", "text": "なんてことだ。私が嘘をつくとでも思っているのか、寿司？"}, {"type": "subtitle", "time": 13386.63, "timestamp": "03:43:06", "text": "何てことだ。"}, {"type": "subtitle", "time": 13389.269, "timestamp": "03:43:09", "text": "こんにちは。お願い、お願い、お願い、お願い"}, {"type": "subtitle", "time": 13391.91, "timestamp": "03:43:11", "text": "そんな風に私を追いかけないで。ごめんなさい。"}, {"type": "subtitle", "time": 13399.269, "timestamp": "03:43:19", "text": "こんにちは。なぜ？どうしてそんなに来るの？ああ、"}, {"type": "subtitle", "time": 13424.229, "timestamp": "03:43:44", "text": "こんにちは、アレクサー。"}, {"type": "subtitle", "time": 13427.269, "timestamp": "03:43:47", "text": "ジョッキー、君は殺人者なのか？何？あなたは"}, {"type": "subtitle", "time": 13431.429, "timestamp": "03:43:51", "text": "殺人犯？ガチョウの騎手。いいえ。D。いいえ。もし私が"}, {"type": "subtitle", "time": 13434.309, "timestamp": "03:43:54", "text": "嘘だよ、君たちなら簡単に分かるかもしれない。それで"}]
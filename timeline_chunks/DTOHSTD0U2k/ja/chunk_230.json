[{"type": "subtitle", "time": 13804.79, "timestamp": "03:50:04", "text": "私にも起こったこと？何？"}, {"type": "subtitle", "time": 13809.03, "timestamp": "03:50:09", "text": "待って。私は、私はあなたを怖がっていません。"}, {"type": "subtitle", "time": 13818.63, "timestamp": "03:50:18", "text": "なぜ今、私を傷つけるのですか？"}, {"type": "subtitle", "time": 13821.51, "timestamp": "03:50:21", "text": "何が起こっている？"}, {"type": "subtitle", "time": 13824.229, "timestamp": "03:50:24", "text": "正常に戻った。"}, {"type": "subtitle", "time": 13826.71, "timestamp": "03:50:26", "text": "お前は殺人犬か？いいえ、違います。私は"}, {"type": "subtitle", "time": 13829.51, "timestamp": "03:50:29", "text": "ない。あなたは殺人者ですか？"}, {"type": "subtitle", "time": 13831.11, "timestamp": "03:50:31", "text": "[音楽]"}, {"type": "subtitle", "time": 13833.349, "timestamp": "03:50:33", "text": "よし。誰が"}, {"type": "subtitle", "time": 13837.11, "timestamp": "03:50:37", "text": "以前は薬剤師だった？だって私は"}, {"type": "subtitle", "time": 13838.469, "timestamp": "03:50:38", "text": "人々がどこにいるかを調べて、"}, {"type": "subtitle", "time": 13842.469, "timestamp": "03:50:42", "text": "このクソ野郎はそこで死んだ。なんてこった。"}, {"type": "subtitle", "time": 13846.389, "timestamp": "03:50:46", "text": "私とアラクサは一緒に"}, {"type": "subtitle", "time": 13850.309, "timestamp": "03:50:50", "text": "ろうそくを灯して教会で"}, {"type": "subtitle", "time": 13852.71, "timestamp": "03:50:52", "text": "私は病院に入院していて、"}, {"type": "subtitle", "time": 13854.87, "timestamp": "03:50:54", "text": "私と一緒にそこにいてください。誰かがそこにいた"}, {"type": "subtitle", "time": 13858.95, "timestamp": "03:50:58", "text": "自分。それは私の手元にあったと思う。思うに"}]
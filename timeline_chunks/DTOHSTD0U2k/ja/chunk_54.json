[{"type": "subtitle", "time": 3248.63, "timestamp": "00:54:08", "text": "火を起こしたいんだよ。私はすべきでしょうか"}, {"type": "subtitle", "time": 3250.72, "timestamp": "00:54:10", "text": "ちょっと待って、みんな？"}, {"type": "subtitle", "time": 3262.63, "timestamp": "00:54:22", "text": "[音楽]"}, {"type": "subtitle", "time": 3264.549, "timestamp": "00:54:24", "text": "刃をお願いします。レンジャー"}, {"type": "subtitle", "time": 3267.349, "timestamp": "00:54:27", "text": "ドニング。心配しないで。私の"}, {"type": "subtitle", "time": 3270.47, "timestamp": "00:54:30", "text": "紅の刃は、それほど長くはあなたを傷つけません。"}, {"type": "subtitle", "time": 3275.43, "timestamp": "00:54:35", "text": "ブレードをお願いします。私はブレードだ。"}, {"type": "subtitle", "time": 3289.99, "timestamp": "00:54:49", "text": "私は実際に自分のすべての時間を費やすべきでしょうか、いいえ、"}, {"type": "subtitle", "time": 3297.37, "timestamp": "00:54:57", "text": "私たちは約束を守ります。これは何ですか？"}]
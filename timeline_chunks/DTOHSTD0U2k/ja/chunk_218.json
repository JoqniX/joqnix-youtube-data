[{"type": "subtitle", "time": 13081.67, "timestamp": "03:38:01", "text": "何？何？"}, {"type": "subtitle", "time": 13087.91, "timestamp": "03:38:07", "text": "アレックスは近くにいたが、後から入ってきた。"}, {"type": "subtitle", "time": 13089.429, "timestamp": "03:38:09", "text": "いくつかの。"}, {"type": "subtitle", "time": 13109.349, "timestamp": "03:38:29", "text": "ここ？はい、トピックはこちらです。ああ、こんにちは。"}, {"type": "subtitle", "time": 13111.91, "timestamp": "03:38:31", "text": "私はただ、与えられた仕事をこなしているだけです。わからない"}, {"type": "subtitle", "time": 13113.269, "timestamp": "03:38:33", "text": "何をするか。はい、お元気ですか？私は"}, {"type": "subtitle", "time": 13116.309, "timestamp": "03:38:36", "text": "ここ。みなさん、こんにちは。どこだかわからない"}, {"type": "subtitle", "time": 13118.87, "timestamp": "03:38:38", "text": "私は一体何者なんだ。よし、私にはやるべきことがある。"}, {"type": "subtitle", "time": 13122.389, "timestamp": "03:38:42", "text": "こんにちは。こんにちは。こちらです。私はそうしなかった"}, {"type": "subtitle", "time": 13131.429, "timestamp": "03:38:51", "text": "何てことだ。あれは吉野さんですか？"}, {"type": "subtitle", "time": 13135.75, "timestamp": "03:38:55", "text": "みんな、吉野か"}]
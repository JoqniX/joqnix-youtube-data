[{"type": "subtitle", "time": 16741.189, "timestamp": "04:39:01", "text": "あれは怖かった。いや、違うよ。私は"}, {"type": "subtitle", "time": 16744.23, "timestamp": "04:39:04", "text": "落下する。ヨッシーは叫んでいるようだった。それで"}, {"type": "subtitle", "time": 16746.869, "timestamp": "04:39:06", "text": "彼女がそうかどうかはよくわからないけど、彼女は"}, {"type": "subtitle", "time": 16749.349, "timestamp": "04:39:09", "text": "一つだけだけど、怖いんだ"}, {"type": "subtitle", "time": 16754.15, "timestamp": "04:39:14", "text": "いいえ。うん。そして"}, {"type": "subtitle", "time": 16756.949, "timestamp": "04:39:16", "text": "彼女は、私もあなたたちと一緒にいてもいいですか？"}, {"type": "subtitle", "time": 16759.75, "timestamp": "04:39:19", "text": "オキシ。オキシ。私はここにいます。私はここにいます。私は隣にいます"}, {"type": "subtitle", "time": 16763.029, "timestamp": "04:39:23", "text": "あなた。わかった。わかった。わかった。わかった。"}, {"type": "subtitle", "time": 16765.189, "timestamp": "04:39:25", "text": "待って。なぜ私と話してくれないの？ドラゴン"}, {"type": "subtitle", "time": 16770.869, "timestamp": "04:39:30", "text": "R. なぜ？ああ、わかりました。こんにちは。"}, {"type": "subtitle", "time": 16773.83, "timestamp": "04:39:33", "text": "あなたの声は"}, {"type": "subtitle", "time": 16777.029, "timestamp": "04:39:37", "text": "うん、声がちょっと低いね。ジョック、"}, {"type": "subtitle", "time": 16780.47, "timestamp": "04:39:40", "text": "少し。ジョック、ちょっと待って。こんにちは。わかったよ、ジョー、"}, {"type": "subtitle", "time": 16783.99, "timestamp": "04:39:43", "text": "何か話せますか？こんにちは。こんにちは。"}, {"type": "subtitle", "time": 16785.11, "timestamp": "04:39:45", "text": "わかった。わかった。ちょっと待って。聞こえる"}, {"type": "subtitle", "time": 16786.868, "timestamp": "04:39:46", "text": "今のあなた。ちょっと待って。ちょっと待って。"}, {"type": "subtitle", "time": 16790.07, "timestamp": "04:39:50", "text": "あの、Ch、私が偽物だって言っていい？"}, {"type": "subtitle", "time": 16792.948, "timestamp": "04:39:52", "text": "なぜ？"}, {"type": "subtitle", "time": 16794.07, "timestamp": "04:39:54", "text": "これはテスト目的だけです。これはただ"}, {"type": "subtitle", "time": 16795.35, "timestamp": "04:39:55", "text": "テスト中。これはテスト目的だけです。その"}, {"type": "subtitle", "time": 16797.67, "timestamp": "04:39:57", "text": "テスト目的のみです。いや、待って。あなたは行く"}]
[{"type": "subtitle", "time": 14354.87, "timestamp": "03:59:14", "text": "待って。わかった。それはどこだったのですか？こんにちは。うん、"}, {"type": "subtitle", "time": 14355.92, "timestamp": "03:59:15", "text": "私たちは一度も見たことがなかった。"}, {"type": "subtitle", "time": 14357.269, "timestamp": "03:59:17", "text": "[音楽]"}, {"type": "subtitle", "time": 14359.59, "timestamp": "03:59:19", "text": "私自身がオキシーを文字通り見たところです"}, {"type": "subtitle", "time": 14363.349, "timestamp": "03:59:23", "text": "死体に向かってくる。何？いいえ。"}, {"type": "subtitle", "time": 14368.309, "timestamp": "03:59:28", "text": "いいえ。私とオキシーは付き合っていました。彼女はそうだった"}, {"type": "subtitle", "time": 14370.95, "timestamp": "03:59:30", "text": "私たちは二人とも一緒にいました。"}, {"type": "subtitle", "time": 14373.429, "timestamp": "03:59:33", "text": "おい、この人何なんだよ？何？"}, {"type": "subtitle", "time": 14380.469, "timestamp": "03:59:40", "text": "何もしない。彼はみんなを責めている、"}, {"type": "subtitle", "time": 14383.03, "timestamp": "03:59:43", "text": "兄弟。それがこのゲームのやり方だ。あなた"}, {"type": "subtitle", "time": 14385.51, "timestamp": "03:59:45", "text": "他人を責める。"}, {"type": "subtitle", "time": 14388.07, "timestamp": "03:59:48", "text": "そして、彼はあなただったのです。"}, {"type": "subtitle", "time": 14390.07, "timestamp": "03:59:50", "text": "うん、"}, {"type": "subtitle", "time": 14392.229, "timestamp": "03:59:52", "text": "私は吉野と一緒にいました。"}, {"type": "subtitle", "time": 14396.389, "timestamp": "03:59:56", "text": "みんなそうだよ、兄弟。お誕生日おめでとう。"}, {"type": "subtitle", "time": 14398.79, "timestamp": "03:59:58", "text": "まあ、そんな感じかな。お誕生日おめでとう、"}]
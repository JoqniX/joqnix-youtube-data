[{"type": "subtitle", "time": 13561.429, "timestamp": "03:46:01", "text": "ひどく静かだった。私はずっとあなたたちに言っていた、"}, {"type": "subtitle", "time": 13562.71, "timestamp": "03:46:02", "text": "そう、だから私はこう言ったんだ"}, {"type": "subtitle", "time": 13565.269, "timestamp": "03:46:05", "text": "彼がそんなことをするはずがない"}, {"type": "subtitle", "time": 13567.51, "timestamp": "03:46:07", "text": "単純なミス。彼は文字通り殺した"}, {"type": "subtitle", "time": 13576.15, "timestamp": "03:46:16", "text": "それは私でした。それは私でした。それは私でした。私"}, {"type": "subtitle", "time": 13578.389, "timestamp": "03:46:18", "text": "変容した。"}, {"type": "subtitle", "time": 13580.15, "timestamp": "03:46:20", "text": "のように"}, {"type": "subtitle", "time": 13581.91, "timestamp": "03:46:21", "text": "変化"}, {"type": "subtitle", "time": 13585.51, "timestamp": "03:46:25", "text": "変身能力のやつだよ、兄弟。私はただ"}, {"type": "subtitle", "time": 13587.59, "timestamp": "03:46:27", "text": "2台のRXが走っているのを見て、私は"}, {"type": "subtitle", "time": 13595.349, "timestamp": "03:46:35", "text": "おい、俺を殺さないでくれよ。私たちはズルをしている。おお、"}, {"type": "subtitle", "time": 13598.95, "timestamp": "03:46:38", "text": "私たちはハトを飼っています。鳩。私はそうは思わない"}, {"type": "subtitle", "time": 13601.189, "timestamp": "03:46:41", "text": "彼は一番社交的だ。"}, {"type": "subtitle", "time": 13603.429, "timestamp": "03:46:43", "text": "彼は最も社交的な人物だ。私は、"}, {"type": "subtitle", "time": 13606.87, "timestamp": "03:46:46", "text": "ハトはそうするけどね。人に触らないで"}, {"type": "subtitle", "time": 13610.07, "timestamp": "03:46:50", "text": "勝ちたい。 PJが触れなければならないのか"}, {"type": "subtitle", "time": 13611.75, "timestamp": "03:46:51", "text": "あなたが知っている人全員。敏感すぎる。うん。"}, {"type": "subtitle", "time": 13614.55, "timestamp": "03:46:54", "text": "悪い奴、悪い奴。うん。彼らは"}, {"type": "subtitle", "time": 13617.75, "timestamp": "03:46:57", "text": "コロナウイルス。悪者。コロナウイルス。"}]
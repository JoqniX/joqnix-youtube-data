[{"type": "subtitle", "time": 420.309, "timestamp": "00:07:00", "text": "周囲をもう少し観察する"}, {"type": "subtitle", "time": 422.7, "timestamp": "00:07:02", "text": "そして、あなたが見たものを教えてください。"}, {"type": "subtitle", "time": 424.15, "timestamp": "00:07:04", "text": "[音楽]"}, {"type": "subtitle", "time": 426.87, "timestamp": "00:07:06", "text": "この世界についてもっと学ぶにつれて、"}, {"type": "subtitle", "time": 430.469, "timestamp": "00:07:10", "text": "本当の欲望が表面化し、私たちの小さな"}, {"type": "subtitle", "time": 435.189, "timestamp": "00:07:15", "text": "ゲームはさらに面白くなるだろう。"}, {"type": "subtitle", "time": 437.99, "timestamp": "00:07:17", "text": "面白いって？それは望んでいない"}, {"type": "subtitle", "time": 440.87, "timestamp": "00:07:20", "text": "私の貴重な一人時間を邪魔する者は誰であれ"}, {"type": "subtitle", "time": 445.029, "timestamp": "00:07:25", "text": "あなたと。それだけです。"}, {"type": "subtitle", "time": 447.749, "timestamp": "00:07:27", "text": "H"}, {"type": "subtitle", "time": 449.99, "timestamp": "00:07:29", "text": "なぜあなたは私たちが"}, {"type": "subtitle", "time": 451.83, "timestamp": "00:07:31", "text": "犯人は？"}, {"type": "subtitle", "time": 453.67, "timestamp": "00:07:33", "text": "もしかしたらあなたは私に何を尋ねるべきなのか"}, {"type": "subtitle", "time": 456.95, "timestamp": "00:07:36", "text": "実際にここで起きた出来事です。"}, {"type": "subtitle", "time": 459.67, "timestamp": "00:07:39", "text": "ああ、わかりました。それでは、そのことを聞いてみます。私はしません"}, {"type": "subtitle", "time": 462.23, "timestamp": "00:07:42", "text": "まだ全てを話す段階ではない。それはあまりにも"}, {"type": "subtitle", "time": 463.749, "timestamp": "00:07:43", "text": "つまらない。"}, {"type": "subtitle", "time": 466.15, "timestamp": "00:07:46", "text": "先ほども言いましたが、ぜひご覧ください。"}, {"type": "subtitle", "time": 469.51, "timestamp": "00:07:49", "text": "周りを見回して、ご自身で確かめてみてください。"}, {"type": "subtitle", "time": 479.029, "timestamp": "00:07:59", "text": "M"}]
[{"type": "subtitle", "time": 14041.349, "timestamp": "03:54:01", "text": "その周り。"}, {"type": "subtitle", "time": 14044.469, "timestamp": "03:54:04", "text": "音を聞いたんだと思う。私の"}, {"type": "subtitle", "time": 14046.71, "timestamp": "03:54:06", "text": "あなたが亡くなった後、彼に疑いの目が向けられるだろう。取ろう"}, {"type": "subtitle", "time": 14048.63, "timestamp": "03:54:08", "text": "小便。どうやって、私はスキップするつもりです。私"}, {"type": "subtitle", "time": 14051.03, "timestamp": "03:54:11", "text": "わからない。"}, {"type": "subtitle", "time": 14053.03, "timestamp": "03:54:13", "text": "何をしなかったのかはわからないが、彼らは"}, {"type": "subtitle", "time": 14055.67, "timestamp": "03:54:15", "text": "正しいように聞こえた。私は彼に投票します。"}, {"type": "subtitle", "time": 14059.429, "timestamp": "03:54:19", "text": "そういうものなんです。それは男だった。それ"}, {"type": "subtitle", "time": 14064.309, "timestamp": "03:54:24", "text": "彼は殺人犯だった。それは立っていた"}, {"type": "subtitle", "time": 14066.79, "timestamp": "03:54:26", "text": "人殺し。"}, {"type": "subtitle", "time": 14070.55, "timestamp": "03:54:30", "text": "兄弟。何てことだ。なぜ部屋はまだああ"}, {"type": "subtitle", "time": 14073.91, "timestamp": "03:54:33", "text": "ああ、なんてことだ、私は何をすべきか分からなかった"}, {"type": "subtitle", "time": 14076.07, "timestamp": "03:54:36", "text": "する。"}, {"type": "subtitle", "time": 14077.75, "timestamp": "03:54:37", "text": "みんな、私には能力があるんだ。私はできない"}, {"type": "subtitle", "time": 14081.429, "timestamp": "03:54:41", "text": "誰かと一緒にいたら殺されるだろう。了解しました。"}, {"type": "subtitle", "time": 14084.309, "timestamp": "03:54:44", "text": "私を助けてください。やあ、元気？"}, {"type": "subtitle", "time": 14085.91, "timestamp": "03:54:45", "text": "こんにちは。"}]
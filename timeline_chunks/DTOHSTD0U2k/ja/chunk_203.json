[{"type": "subtitle", "time": 12192.229, "timestamp": "03:23:12", "text": "私はその作業を行っています。 1秒。"}, {"type": "subtitle", "time": 12194.71, "timestamp": "03:23:14", "text": "うん、君は本当にすごいことを成し遂げたね"}, {"type": "subtitle", "time": 12197.59, "timestamp": "03:23:17", "text": "自己申告で、だって、なんで"}, {"type": "subtitle", "time": 12205.19, "timestamp": "03:23:25", "text": "うん。彼らは私を置いて行ってしまったの？ああ、神様。"}, {"type": "subtitle", "time": 12208.87, "timestamp": "03:23:28", "text": "でも、あなたは、ご存知のように聞こえます。私たちはできますか"}, {"type": "subtitle", "time": 12222.309, "timestamp": "03:23:42", "text": "待って。病院はどこですか？"}, {"type": "subtitle", "time": 12226.389, "timestamp": "03:23:46", "text": "病院はこちらです。うん。 H 私はただ"}, {"type": "subtitle", "time": 12228.07, "timestamp": "03:23:48", "text": "続く。"}, {"type": "subtitle", "time": 12234.309, "timestamp": "03:23:54", "text": "終わり。"}]
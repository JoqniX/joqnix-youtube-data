[{"type": "subtitle", "time": 4335.83, "timestamp": "01:12:15", "text": "ロコに聞きたいのですが、開けません。"}, {"type": "subtitle", "time": 4339.59, "timestamp": "01:12:19", "text": "開けられません。ああ、君が僕なんだね。こんにちは、アリタン"}, {"type": "subtitle", "time": 4341.51, "timestamp": "01:12:21", "text": "ゲーム内で最初に友達になる人になるだろう。"}, {"type": "subtitle", "time": 4347.11, "timestamp": "01:12:27", "text": "さあ行こう。"}, {"type": "subtitle", "time": 4372.61, "timestamp": "01:12:52", "text": "わかった。ロック、ロックウェイはどこにあるの？"}, {"type": "subtitle", "time": 4379.57, "timestamp": "01:12:59", "text": "それは"}]
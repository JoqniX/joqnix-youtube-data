[{"type": "subtitle", "time": 1743.029, "timestamp": "00:29:03", "text": "さあ、考える時間だ、ローバー。おお、"}, {"type": "subtitle", "time": 1747.19, "timestamp": "00:29:07", "text": "あなたは既に私たちを見つけてくれました。"}, {"type": "subtitle", "time": 1750.549, "timestamp": "00:29:10", "text": "震え、身震いし、瞬きをする。時計"}, {"type": "subtitle", "time": 1753.99, "timestamp": "00:29:13", "text": "足が通り過ぎていく。"}, {"type": "subtitle", "time": 1759.83, "timestamp": "00:29:19", "text": "白、黒、赤。それがRPGだ。"}, {"type": "subtitle", "time": 1763.269, "timestamp": "00:29:23", "text": "彼が気に入ってくれるのを待っています"}, {"type": "subtitle", "time": 1772.63, "timestamp": "00:29:32", "text": "それはRPGの仕組みとは違う。"}, {"type": "subtitle", "time": 1775.59, "timestamp": "00:29:35", "text": "はい。ありがとう。私にはそれが必要だった。今あなた"}, {"type": "subtitle", "time": 1780.789, "timestamp": "00:29:40", "text": "死ぬ。気をつけて、愛しい人。あなたの開拓者たち"}, {"type": "subtitle", "time": 1783.83, "timestamp": "00:29:43", "text": "あなたの足元に横たわっています。見ないで。えっと"}, {"type": "subtitle", "time": 1788.389, "timestamp": "00:29:48", "text": "いやいや。焦らないでください。一度でもしくじれば、"}]
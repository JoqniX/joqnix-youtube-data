[{"type": "subtitle", "time": 18601.91, "timestamp": "05:10:01", "text": "私はいつも彼を信頼していたが、その後私は死んだ。"}, {"type": "subtitle", "time": 18605.67, "timestamp": "05:10:05", "text": "どちらの場合も。どちらの時代も好きです。うん。"}, {"type": "subtitle", "time": 18607.19, "timestamp": "05:10:07", "text": "私は落ち着くのが好きです。落ち着け。私は行きます"}, {"type": "subtitle", "time": 18610.23, "timestamp": "05:10:10", "text": "彼女を殺して、彼女を捕まえて行った。"}, {"type": "subtitle", "time": 18615.27, "timestamp": "05:10:15", "text": "うん。だから、そうするんです。だから私は私は私は"}, {"type": "subtitle", "time": 18623.43, "timestamp": "05:10:23", "text": "私は心理戦を仕掛けた。"}, {"type": "subtitle", "time": 18624.948, "timestamp": "05:10:24", "text": "私たちがお互いに仕掛ける唯一の心理戦"}, {"type": "subtitle", "time": 18628.47, "timestamp": "05:10:28", "text": "お互いに撃ち合っている。"}, {"type": "subtitle", "time": 18630.31, "timestamp": "05:10:30", "text": "私たちのIQは彼らの"}, {"type": "subtitle", "time": 18632.15, "timestamp": "05:10:32", "text": "理解。私たちのように、うん。"}, {"type": "subtitle", "time": 18633.67, "timestamp": "05:10:33", "text": "正直言って、私たちはとても難しい"}, {"type": "subtitle", "time": 18635.83, "timestamp": "05:10:35", "text": "理解する。私たちはギガビット級の脳を持っています。"}, {"type": "subtitle", "time": 18637.75, "timestamp": "05:10:37", "text": "その通り。私たちは昇天した。あなたに"}, {"type": "subtitle", "time": 18639.35, "timestamp": "05:10:39", "text": "勝つ。だから私はあなたに感染したのです。私"}, {"type": "subtitle", "time": 18642.31, "timestamp": "05:10:42", "text": "知っていた。うん。私はあなたが"}, {"type": "subtitle", "time": 18643.99, "timestamp": "05:10:43", "text": "あなたは既に知っていたような気がする。私は感じる"}, {"type": "subtitle", "time": 18646.47, "timestamp": "05:10:46", "text": "あなたは理解してくれたような気がしていました。右。私"}, {"type": "subtitle", "time": 18649.03, "timestamp": "05:10:49", "text": "そうだよね？それは何と言えばいいんだろう？"}, {"type": "subtitle", "time": 18652.07, "timestamp": "05:10:52", "text": "それは私たち二人の絆です。すごいね"}, {"type": "subtitle", "time": 18654.788, "timestamp": "05:10:54", "text": "人は似たようなことを考えるものだ。それが私たちを導くことは分かっています"}, {"type": "subtitle", "time": 18657.91, "timestamp": "05:10:57", "text": "あなたたちは運命の相手だと私は知っています。"}]
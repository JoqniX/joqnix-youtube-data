[{"type": "subtitle", "time": 1806.71, "timestamp": "00:30:06", "text": "これがお役に立てば幸いです。私をあなたの"}, {"type": "subtitle", "time": 1817.19, "timestamp": "00:30:17", "text": "スピード。なんという残虐行為だ。残忍。あなた"}, {"type": "subtitle", "time": 1821.269, "timestamp": "00:30:21", "text": "ほら、私たちは血縁関係にあるんだ。"}, {"type": "subtitle", "time": 1828.789, "timestamp": "00:30:28", "text": "教えてくれ、君はルールになりたいのか？"}, {"type": "subtitle", "time": 1832.389, "timestamp": "00:30:32", "text": "羊飼いを設定するか、規則を破るか"}, {"type": "subtitle", "time": 1835.59, "timestamp": "00:30:35", "text": "黒いl？正気な人が"}, {"type": "subtitle", "time": 1838.549, "timestamp": "00:30:38", "text": "狂人の世界で生き残るには、"}, {"type": "subtitle", "time": 1844.149, "timestamp": "00:30:44", "text": "あなたは彼らを最後の司祭と呼ぶか、"}, {"type": "subtitle", "time": 1847.19, "timestamp": "00:30:47", "text": "それについて？そして羊飼いは"}, {"type": "subtitle", "time": 1851.51, "timestamp": "00:30:51", "text": "あらかじめ定められた真理の具現化。一度"}, {"type": "subtitle", "time": 1854.789, "timestamp": "00:30:54", "text": "彼は金のために行った、黒いラボは"}]
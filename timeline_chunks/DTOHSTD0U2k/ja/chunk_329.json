[{"type": "subtitle", "time": 19741.67, "timestamp": "05:29:01", "text": "薬局で彼を一人で殺した。私"}, {"type": "subtitle", "time": 19743.99, "timestamp": "05:29:03", "text": "プラザにいた。私はプラザ地区に引っ越しました。私"}, {"type": "subtitle", "time": 19745.67, "timestamp": "05:29:05", "text": "私はそこで誰も殺していない、なぜなら"}, {"type": "subtitle", "time": 19746.868, "timestamp": "05:29:06", "text": "選択肢がある。から私と一緒にいました"}, {"type": "subtitle", "time": 19750.15, "timestamp": "05:29:10", "text": "ずっと私と一緒にいました。わかった。トランプは"}, {"type": "subtitle", "time": 19751.99, "timestamp": "05:29:11", "text": "それでは、あなたと一緒に。しかし、あなたは自己申告しました。私"}, {"type": "subtitle", "time": 19753.51, "timestamp": "05:29:13", "text": "自己申告を希望する。なぜあなた自身が"}, {"type": "subtitle", "time": 19756.788, "timestamp": "05:29:16", "text": "当時報告されたのですか？なぜ私がそんなことをするの？それが私の"}, {"type": "subtitle", "time": 19759.03, "timestamp": "05:29:19", "text": "ポイント。全員握手をする。私は"}, {"type": "subtitle", "time": 19761.99, "timestamp": "05:29:21", "text": "通過。わかった。人々は私が通り過ぎるのを見ていた。"}, {"type": "subtitle", "time": 19764.47, "timestamp": "05:29:24", "text": "人々は私が通り過ぎるのを見ていた。論理的に考えなさい。"}, {"type": "subtitle", "time": 19766.23, "timestamp": "05:29:26", "text": "論理的に考えなさい。人々は私が通り過ぎるのを見た"}, {"type": "subtitle", "time": 19770.47, "timestamp": "05:29:30", "text": "プラザ。考えていることについて話しているのですが、私にはわかりません。"}, {"type": "subtitle", "time": 19772.47, "timestamp": "05:29:32", "text": "面倒くさい。これは自己申告です。それは"}, {"type": "subtitle", "time": 19774.39, "timestamp": "05:29:34", "text": "自己申告。間違いなく男性です。その"}, {"type": "subtitle", "time": 19780.28, "timestamp": "05:29:40", "text": "なんてこった？"}]
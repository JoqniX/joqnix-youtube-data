[{"type": "subtitle", "time": 19561.03, "timestamp": "05:26:01", "text": "ルネと"}, {"type": "subtitle", "time": 19563.67, "timestamp": "05:26:03", "text": "そして、えーと"}, {"type": "subtitle", "time": 19566.948, "timestamp": "05:26:06", "text": "何をしたから悪い子だったの？"}, {"type": "subtitle", "time": 19570.07, "timestamp": "05:26:10", "text": "私はそう思っていました"}, {"type": "subtitle", "time": 19572.27, "timestamp": "05:26:12", "text": "最初"}, {"type": "subtitle", "time": 19574.55, "timestamp": "05:26:14", "text": "[音楽]"}, {"type": "subtitle", "time": 19578.948, "timestamp": "05:26:18", "text": "俺たちだけがお前らを[ __ ]する。"}, {"type": "subtitle", "time": 19580.948, "timestamp": "05:26:20", "text": "あなたは変な人"}, {"type": "subtitle", "time": 19583.91, "timestamp": "05:26:23", "text": "うん。ああ、私はちょっと変わった人間なのよ。何ができるのか"}, {"type": "subtitle", "time": 19586.47, "timestamp": "05:26:26", "text": "私が何て言ったかって？"}, {"type": "subtitle", "time": 19588.708, "timestamp": "05:26:28", "text": "[音楽]"}, {"type": "subtitle", "time": 19590.92, "timestamp": "05:26:30", "text": "今、私は首を横に振っています。"}, {"type": "subtitle", "time": 19592.15, "timestamp": "05:26:32", "text": "[音楽]"}, {"type": "subtitle", "time": 19597.59, "timestamp": "05:26:37", "text": "ああ、殺人鬼が2人いる"}, {"type": "subtitle", "time": 19600.628, "timestamp": "05:26:40", "text": "すでに。ええ、はい、皆さん、"}, {"type": "subtitle", "time": 19602.948, "timestamp": "05:26:42", "text": "いつも最初に死ぬのはもううんざりだ。ターゲットを"}, {"type": "subtitle", "time": 19605.75, "timestamp": "05:26:45", "text": "他の誰か。私は無実です"}, {"type": "subtitle", "time": 19607.43, "timestamp": "05:26:47", "text": "死にかけている。"}, {"type": "subtitle", "time": 19612.23, "timestamp": "05:26:52", "text": "よし、殺戮行為を３つ。いいえ、違います"}, {"type": "subtitle", "time": 19614.948, "timestamp": "05:26:54", "text": "死んだ。私は死にかけている。はい、遊ばせてください。"}]
[{"type": "subtitle", "time": 16500.15, "timestamp": "04:35:00", "text": "感染源。わかった。なぜあなたは"}, {"type": "subtitle", "time": 16503.349, "timestamp": "04:35:03", "text": "では、私についてきてください。だって面白いから"}, {"type": "subtitle", "time": 16505.349, "timestamp": "04:35:05", "text": "私を殺して。私は死ぬだろう。でもあなたは近づかないで"}, {"type": "subtitle", "time": 16508.31, "timestamp": "04:35:08", "text": "私から。いいえ、あなたは私に近づかないでください。"}, {"type": "subtitle", "time": 16511.51, "timestamp": "04:35:11", "text": "みんな、彼を落選させるべきだろうか？みんな、ただ"}, {"type": "subtitle", "time": 16516.709, "timestamp": "04:35:16", "text": "私の目の前で見てください。大丈夫です。"}, {"type": "subtitle", "time": 16518.629, "timestamp": "04:35:18", "text": "私がいつも言っていること、知ってる？コーケ、"}, {"type": "subtitle", "time": 16520.23, "timestamp": "04:35:20", "text": "失うにはあまりにも多くの命が惜しまれる。彼を捕まえろ"}, {"type": "subtitle", "time": 16533.59, "timestamp": "04:35:33", "text": "バイバイ。"}, {"type": "subtitle", "time": 16559.429, "timestamp": "04:35:59", "text": "よし、私たちは小さな博物館に戻ってきた。"}]
[{"type": "subtitle", "time": 1621.029, "timestamp": "00:27:01", "text": "もう分かっている。"}, {"type": "subtitle", "time": 1623.59, "timestamp": "00:27:03", "text": "反逆した黒い子羊"}, {"type": "subtitle", "time": 1626.63, "timestamp": "00:27:06", "text": "ルール。白い子羊たちは"}, {"type": "subtitle", "time": 1629.35, "timestamp": "00:27:09", "text": "彼らの貪欲さ。純真な乙女たち"}, {"type": "subtitle", "time": 1632.149, "timestamp": "00:27:12", "text": "犠牲になった。そして村人たちは"}, {"type": "subtitle", "time": 1635.029, "timestamp": "00:27:15", "text": "互いに容赦ない狂乱の中で攻撃し合い、"}, {"type": "subtitle", "time": 1642.07, "timestamp": "00:27:22", "text": "羊飼いがしなければならなかったのは、"}, {"type": "subtitle", "time": 1645.269, "timestamp": "00:27:25", "text": "反逆者。そうやって彼は羊の群れを飼い続けた。"}, {"type": "subtitle", "time": 1648.149, "timestamp": "00:27:28", "text": "抑制し、現状維持を図った。"}, {"type": "subtitle", "time": 1651.75, "timestamp": "00:27:31", "text": "それがあなたが回答者になった理由ですか？しかし、そうではない。"}, {"type": "subtitle", "time": 1654.39, "timestamp": "00:27:34", "text": "全く違う。"}, {"type": "subtitle", "time": 1658.71, "timestamp": "00:27:38", "text": "私は決して羊飼いではなかった。決してそうはならないだろう。"}, {"type": "subtitle", "time": 1664.149, "timestamp": "00:27:44", "text": "君と私は、黒い子羊だ。"}, {"type": "subtitle", "time": 1667.269, "timestamp": "00:27:47", "text": "誰がルールを破るのか。"}, {"type": "subtitle", "time": 1676.549, "timestamp": "00:27:56", "text": "面白い。ローバー。"}]
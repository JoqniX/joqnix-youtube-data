[{"type": "subtitle", "time": 12246.309, "timestamp": "03:24:06", "text": "人形はどこにあるの？"}, {"type": "subtitle", "time": 12248.79, "timestamp": "03:24:08", "text": "どこ？どこで"}, {"type": "subtitle", "time": 12266.15, "timestamp": "03:24:26", "text": "こんにちは。"}, {"type": "subtitle", "time": 12269.349, "timestamp": "03:24:29", "text": "これ、どうすればいいの？"}, {"type": "subtitle", "time": 12271.269, "timestamp": "03:24:31", "text": "あ、待って。それはそれ自体が落ちていった。私の任務。"}, {"type": "subtitle", "time": 12280.55, "timestamp": "03:24:40", "text": "ああ、こんにちは。"}, {"type": "subtitle", "time": 12295.67, "timestamp": "03:24:55", "text": "ああ、そうだ、こっちだ。はい、そうです"}, {"type": "subtitle", "time": 12297.269, "timestamp": "03:24:57", "text": "1つ。"}, {"type": "subtitle", "time": 12299.91, "timestamp": "03:24:59", "text": "そうそう。"}]
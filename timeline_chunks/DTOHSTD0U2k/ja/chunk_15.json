[{"type": "subtitle", "time": 900.31, "timestamp": "00:15:00", "text": "うんうん。羊飼いが彼らを連れてきた"}, {"type": "subtitle", "time": 904.069, "timestamp": "00:15:04", "text": "豊かさと保護の約束。"}, {"type": "subtitle", "time": 907.43, "timestamp": "00:15:07", "text": "彼の言葉に引き寄せられた子羊たちはすぐに"}, {"type": "subtitle", "time": 921.43, "timestamp": "00:15:21", "text": "全く逆だ。羊飼いの"}, {"type": "subtitle", "time": 923.75, "timestamp": "00:15:23", "text": "到着は始まりに過ぎない。で"}, {"type": "subtitle", "time": 926.15, "timestamp": "00:15:26", "text": "手を振ると、羊飼いは"}, {"type": "subtitle", "time": 930.15, "timestamp": "00:15:30", "text": "彼らのあらゆる願いを叶えてあげよう。ああ、彼の群れ"}, {"type": "subtitle", "time": 933.75, "timestamp": "00:15:33", "text": "彼らは頭を下げて従い、"}, {"type": "subtitle", "time": 936.55, "timestamp": "00:15:36", "text": "より良い食料と住居。彼らはもはや"}, {"type": "subtitle", "time": 939.35, "timestamp": "00:15:39", "text": "生き残るために必死に戦わなければならなかった。彼らの"}, {"type": "subtitle", "time": 942.47, "timestamp": "00:15:42", "text": "かつては貧弱な生活が"}, {"type": "subtitle", "time": 945.35, "timestamp": "00:15:45", "text": "限りない贅沢、信者たちは崇拝する"}, {"type": "subtitle", "time": 948.71, "timestamp": "00:15:48", "text": "彼らの羊飼いは神となり、彼を讃えた。"}, {"type": "subtitle", "time": 952.069, "timestamp": "00:15:52", "text": "そして彼を抱きしめていた。どうしたの？私の"}, {"type": "subtitle", "time": 955.03, "timestamp": "00:15:55", "text": "あなたがその子羊の一匹だったと想像してみてください"}, {"type": "subtitle", "time": 959.11, "timestamp": "00:15:59", "text": "抗いがたい誘惑に直面し、"}]
[{"type": "subtitle", "time": 13261.269, "timestamp": "03:41:01", "text": "待って。おお、これは最高だ。こんにちは。おお、"}, {"type": "subtitle", "time": 13264.07, "timestamp": "03:41:04", "text": "待って。くそっ。ここ。はい、どうぞ。"}, {"type": "subtitle", "time": 13266.15, "timestamp": "03:41:06", "text": "なんてこった。やったよ。やったよ。こんにちは、"}, {"type": "subtitle", "time": 13271.14, "timestamp": "03:41:11", "text": "みんな。ああ、死体だ。もう一度やり直してください。"}, {"type": "subtitle", "time": 13279.83, "timestamp": "03:41:19", "text": "H 全員の前に悪い少年がいた"}, {"type": "subtitle", "time": 13282.79, "timestamp": "03:41:22", "text": "私たちは水道管のようなものの近くにいました。"}, {"type": "subtitle", "time": 13296.95, "timestamp": "03:41:36", "text": "私たちの目の前に。"}, {"type": "subtitle", "time": 13299.51, "timestamp": "03:41:39", "text": "何？しかし、ドラゴサウルスはひどく静かだ"}, {"type": "subtitle", "time": 13301.67, "timestamp": "03:41:41", "text": "およびRX、"}, {"type": "subtitle", "time": 13304.15, "timestamp": "03:41:44", "text": "あなたが知っている。待って、誰が文字通り殺したの"}, {"type": "subtitle", "time": 13306.07, "timestamp": "03:41:46", "text": "私たちの前にいる人？誰かが走っているのを見た"}, {"type": "subtitle", "time": 13308.55, "timestamp": "03:41:48", "text": "離れて。誰かが逃げるのを見た。私は見た"}, {"type": "subtitle", "time": 13312.15, "timestamp": "03:41:52", "text": "誰かが逃げ出した。何色？"}, {"type": "subtitle", "time": 13314.15, "timestamp": "03:41:54", "text": "覚えていません。私はそうは思わない"}, {"type": "subtitle", "time": 13315.51, "timestamp": "03:41:55", "text": "色を覚えておいてください。私のせいだ。でも、"}, {"type": "subtitle", "time": 13316.79, "timestamp": "03:41:56", "text": "誰かが逃げるのを見た。ボディ"}, {"type": "subtitle", "time": 13318.469, "timestamp": "03:41:58", "text": "その上に水滴が乗っている。そして、"}]
[{"type": "subtitle", "time": 2101.91, "timestamp": "00:35:01", "text": "今はそれは飛ばしましょう。皆さんは"}, {"type": "subtitle", "time": 2104.63, "timestamp": "00:35:04", "text": "右？"}, {"type": "subtitle", "time": 2107.19, "timestamp": "00:35:07", "text": "スカーの共鳴能力は"}, {"type": "subtitle", "time": 2109.03, "timestamp": "00:35:09", "text": "テレポートと"}, {"type": "subtitle", "time": 2111.589, "timestamp": "00:35:11", "text": "空間の操作。"}, {"type": "subtitle", "time": 2114.069, "timestamp": "00:35:14", "text": "彼は私を監禁状態に閉じ込め、私は"}, {"type": "subtitle", "time": 2116.23, "timestamp": "00:35:16", "text": "遠くない場所にあると感じただけだった"}, {"type": "subtitle", "time": 2119.27, "timestamp": "00:35:19", "text": "ここ。それを乗り越えるのに少し時間がかかった"}, {"type": "subtitle", "time": 2121.03, "timestamp": "00:35:21", "text": "バリア。"}, {"type": "subtitle", "time": 2124.15, "timestamp": "00:35:24", "text": "ごめんね、ローバー。もし私が"}, {"type": "subtitle", "time": 2127.27, "timestamp": "00:35:27", "text": "もっと早く君に連絡できたよ。なぜ彼はそんなに"}, {"type": "subtitle", "time": 2134.069, "timestamp": "00:35:34", "text": "兄弟、"}, {"type": "subtitle", "time": 2139.99, "timestamp": "00:35:39", "text": "どうしてここにいるの、坊や？"}, {"type": "subtitle", "time": 2142.23, "timestamp": "00:35:42", "text": "酸性の不和は見たことがない"}, {"type": "subtitle", "time": 2144.87, "timestamp": "00:35:44", "text": "非常に鮮やかな感情を表す。"}, {"type": "subtitle", "time": 2147.67, "timestamp": "00:35:47", "text": "兄が言っていた。"}, {"type": "subtitle", "time": 2151.43, "timestamp": "00:35:51", "text": "まさか？はい、それはあり得ます。"}, {"type": "subtitle", "time": 2154.31, "timestamp": "00:35:54", "text": "ああ、ガーは以前にもここに来たことがあった。話し合いましょう"}, {"type": "subtitle", "time": 2157.91, "timestamp": "00:35:57", "text": "それについては後で話そう。ローバー、私に給油してくれる？"}]
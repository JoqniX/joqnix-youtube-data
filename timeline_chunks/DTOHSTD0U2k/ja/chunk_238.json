[{"type": "subtitle", "time": 14290.229, "timestamp": "03:58:10", "text": "私は人々の集団を見ました。こんにちは。"}, {"type": "subtitle", "time": 14292.95, "timestamp": "03:58:12", "text": "すぐ近くに家がある。こんにちは。こんにちは。彼は"}, {"type": "subtitle", "time": 14295.189, "timestamp": "03:58:15", "text": "そこに立っている。彼は動かない。彼は"}, {"type": "subtitle", "time": 14306.07, "timestamp": "03:58:26", "text": "[音楽]"}, {"type": "subtitle", "time": 14321.34, "timestamp": "03:58:41", "text": "こんにちは。みなさん、こんにちは。"}, {"type": "subtitle", "time": 14324.309, "timestamp": "03:58:44", "text": "[音楽]"}, {"type": "subtitle", "time": 14333.349, "timestamp": "03:58:53", "text": "課題はどこにあるのか？こちらです。こちらです。"}, {"type": "subtitle", "time": 14336.07, "timestamp": "03:58:56", "text": "トマトを使ったあの方法。うん。うん。"}]
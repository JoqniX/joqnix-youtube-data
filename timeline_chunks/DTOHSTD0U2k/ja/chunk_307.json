[{"type": "subtitle", "time": 18420.948, "timestamp": "05:07:00", "text": "あなたから離れた誰か。私はとても幸運でした"}, {"type": "subtitle", "time": 18422.47, "timestamp": "05:07:02", "text": "あなたから逃げ出した。うん、君は本当に"}, {"type": "subtitle", "time": 18424.39, "timestamp": "05:07:04", "text": "ラッキー。私は彼らを殺したかった。あなたが知っている、"}, {"type": "subtitle", "time": 18427.83, "timestamp": "05:07:07", "text": "正直に言うと、私はあなたを殺していたでしょう。"}, {"type": "subtitle", "time": 18430.55, "timestamp": "05:07:10", "text": "私のボタン。クリックボタンを押し続けると"}, {"type": "subtitle", "time": 18434.868, "timestamp": "05:07:14", "text": "とにかく動かせばいいんだ。それは知りません。"}, {"type": "subtitle", "time": 18436.39, "timestamp": "05:07:16", "text": "あなたは怪物が私に向かってくるのを見た、"}, {"type": "subtitle", "time": 18439.11, "timestamp": "05:07:19", "text": "右？ええ、見ましたよ。ええ、できますよ。ええ、私は"}, {"type": "subtitle", "time": 18442.788, "timestamp": "05:07:22", "text": "全く動けなかった。それは実際には"}, {"type": "subtitle", "time": 18443.99, "timestamp": "05:07:23", "text": "うん。いや、怪物がやってきたんだ"}, {"type": "subtitle", "time": 18457.59, "timestamp": "05:07:37", "text": "私のPP。うん、"}]
[{"type": "subtitle", "time": 606.79, "timestamp": "00:10:06", "text": "それは何ですか？気分転換にまた戻ってきたの？"}, {"type": "subtitle", "time": 610.389, "timestamp": "00:10:10", "text": "つまり、あなたはズルをしたいのですね？賢い"}, {"type": "subtitle", "time": 612.79, "timestamp": "00:10:12", "text": "動く。束縛されない でも、あなたには教えない"}, {"type": "subtitle", "time": 613.99, "timestamp": "00:10:13", "text": "もっと。"}, {"type": "subtitle", "time": 615.75, "timestamp": "00:10:15", "text": "まだ。"}, {"type": "subtitle", "time": 618.389, "timestamp": "00:10:18", "text": "最初の子が"}, {"type": "subtitle", "time": 621.35, "timestamp": "00:10:21", "text": "退屈な言葉のやり取り。あなたは望んでいない"}, {"type": "subtitle", "time": 625.19, "timestamp": "00:10:25", "text": "こんなに早く私を失望させるとは、ローバー。長さ"}, {"type": "subtitle", "time": 628.31, "timestamp": "00:10:28", "text": "会えなかった時間。ニハ。ニハ。"}, {"type": "subtitle", "time": 656.31, "timestamp": "00:10:56", "text": "えっと、日記を読んでください。こんにちは。えっと、私は"}, {"type": "subtitle", "time": 658.069, "timestamp": "00:10:58", "text": "新しい家。ニース。叔父が私に学校を与えてくれた"}]
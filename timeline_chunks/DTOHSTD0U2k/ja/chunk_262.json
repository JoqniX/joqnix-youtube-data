[{"type": "subtitle", "time": 15721.83, "timestamp": "04:22:01", "text": "話す時が来た。ヨッシー、ちょっと待って。私にさせて"}, {"type": "subtitle", "time": 15724.389, "timestamp": "04:22:04", "text": "説明する。私は保安官です。私は刺した"}, {"type": "subtitle", "time": 15726.95, "timestamp": "04:22:06", "text": "スミ、私が保安官だから。私はしませんでした"}, {"type": "subtitle", "time": 15729.99, "timestamp": "04:22:09", "text": "死ぬ。スミは殺人犯だった。私は保安官です。私"}, {"type": "subtitle", "time": 15731.75, "timestamp": "04:22:11", "text": "今ならそれを保証できます。私は保安官です。"}, {"type": "subtitle", "time": 15733.91, "timestamp": "04:22:13", "text": "私は信用しない、信用しない、信用しない。"}, {"type": "subtitle", "time": 15736.389, "timestamp": "04:22:16", "text": "いいえ、彼は私の目の前に来たんです。ああ、"}, {"type": "subtitle", "time": 15739.429, "timestamp": "04:22:19", "text": "神。あのね？あなたは"}, {"type": "subtitle", "time": 15741.75, "timestamp": "04:22:21", "text": "よし。賭けたいの？待って。"}, {"type": "subtitle", "time": 15743.269, "timestamp": "04:22:23", "text": "もし私が追い出されて、私が"}, {"type": "subtitle", "time": 15744.79, "timestamp": "04:22:24", "text": "保安官、あなたは何かをしなければなりません"}, {"type": "subtitle", "time": 15746.79, "timestamp": "04:22:26", "text": "自分。おい、お前は追い出されるぞ。いいえ。"}, {"type": "subtitle", "time": 15748.309, "timestamp": "04:22:28", "text": "いや、いや、いや、いや、それはうまくいかない。"}, {"type": "subtitle", "time": 15750.71, "timestamp": "04:22:30", "text": "ここ。それはうまくいかない。よし。私は"}, {"type": "subtitle", "time": 15753.03, "timestamp": "04:22:33", "text": "せっかくのチャンスを逃すつもりです。あなたは"}, {"type": "subtitle", "time": 15755.349, "timestamp": "04:22:35", "text": "機会を無駄にしている。私はただあなたに言っているだけです"}, {"type": "subtitle", "time": 15757.269, "timestamp": "04:22:37", "text": "奴らは保安官を無駄にしている。私のものではない"}, {"type": "subtitle", "time": 15763.429, "timestamp": "04:22:43", "text": "スキップしてもいいですよ。私はただ、私はただ、私は"}, {"type": "subtitle", "time": 15766.149, "timestamp": "04:22:46", "text": "シェリフ。確認しました。ヨシ、私は"}, {"type": "subtitle", "time": 15767.269, "timestamp": "04:22:47", "text": "もしそうだったとしたら、あなたを殺していたでしょう。"}, {"type": "subtitle", "time": 15769.67, "timestamp": "04:22:49", "text": "ヨシ。ヨシ、私と一緒にいて。ヨシ、君"}, {"type": "subtitle", "time": 15771.83, "timestamp": "04:22:51", "text": "何だと思う？"}, {"type": "subtitle", "time": 15774.63, "timestamp": "04:22:54", "text": "私は保安官です。私は保安官です。私は保安官です。"}]
[{"type": "subtitle", "time": 17520.628, "timestamp": "04:52:00", "text": "犬と"}, {"type": "subtitle", "time": 17528.708, "timestamp": "04:52:08", "text": "巡回中。わかった。わかりました。それは"}, {"type": "subtitle", "time": 17532.948, "timestamp": "04:52:12", "text": "ジョックニックス？あれはジョックンですか？"}, {"type": "subtitle", "time": 17535.59, "timestamp": "04:52:15", "text": "え、何？ああ、犬が"}, {"type": "subtitle", "time": 17546.708, "timestamp": "04:52:26", "text": "待って、みんな犬の鳴き声が聞こえる？"}, {"type": "subtitle", "time": 17554.07, "timestamp": "04:52:34", "text": "あなたは正しくない。こんにちは。待って、これは"}, {"type": "subtitle", "time": 17559.91, "timestamp": "04:52:39", "text": "これは何ですか？よし、掃除しなきゃ。私"}, {"type": "subtitle", "time": 17561.75, "timestamp": "04:52:41", "text": "あなたと一緒にいたい。ええ、私は"}, {"type": "subtitle", "time": 17575.59, "timestamp": "04:52:55", "text": "こんにちは。"}, {"type": "subtitle", "time": 17578.948, "timestamp": "04:52:58", "text": "あと10秒お待ちください。"}]
[{"type": "subtitle", "time": 19868.788, "timestamp": "05:31:08", "text": "ええと、どこかに。まあ、そうだと仮定しましょう。"}, {"type": "subtitle", "time": 19870.47, "timestamp": "05:31:10", "text": "うん、"}, {"type": "subtitle", "time": 19872.868, "timestamp": "05:31:12", "text": "説明させてください。あなたは大丈夫です。大丈夫ですよ。"}, {"type": "subtitle", "time": 19875.91, "timestamp": "05:31:15", "text": "見つけた。私は。"}, {"type": "subtitle", "time": 19877.83, "timestamp": "05:31:17", "text": "まあ、彼がこう言う前は、私たちは皆"}, {"type": "subtitle", "time": 19880.23, "timestamp": "05:31:20", "text": "一緒にいよう、もし彼が死んだら、私は"}, {"type": "subtitle", "time": 19882.07, "timestamp": "05:31:22", "text": "報告。もし私たちが死んだら、云々。うん。"}, {"type": "subtitle", "time": 19884.39, "timestamp": "05:31:24", "text": "だから、彼がここにいると思ったんです。"}, {"type": "subtitle", "time": 19885.75, "timestamp": "05:31:25", "text": "さて、ここが重要な点ですよね？私はしません"}, {"type": "subtitle", "time": 19887.99, "timestamp": "05:31:27", "text": "彼のそばにいたい。わかった。しないで、しない"}, {"type": "subtitle", "time": 19890.708, "timestamp": "05:31:30", "text": "彼のそばにいたい。私は彼らを信用していない。"}, {"type": "subtitle", "time": 19892.628, "timestamp": "05:31:32", "text": "だって、私はあなたが人を殺すのを実際に見たんだもの。私はできません"}, {"type": "subtitle", "time": 19895.11, "timestamp": "05:31:35", "text": "君をそばに置いてほしい。"}, {"type": "subtitle", "time": 19897.11, "timestamp": "05:31:37", "text": "だから、どうか最後までお付き合いください。貼ってください"}, {"type": "subtitle", "time": 19900.31, "timestamp": "05:31:40", "text": "私と一緒に。私はあなたを支持する。"}]
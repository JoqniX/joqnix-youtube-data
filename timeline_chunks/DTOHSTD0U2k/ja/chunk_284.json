[{"type": "subtitle", "time": 17040.868, "timestamp": "04:44:00", "text": "何てことだ。なぜ殺すのが難しいのか"}, {"type": "subtitle", "time": 17043.75, "timestamp": "04:44:03", "text": "友達？わかりました、実際、"}, {"type": "subtitle", "time": 17048.15, "timestamp": "04:44:08", "text": "私の勝ちか、あなたの勝ちか。私たちが"}, {"type": "subtitle", "time": 17050.31, "timestamp": "04:44:10", "text": "ほぼ全員を味方につけることができた。実際、私は"}, {"type": "subtitle", "time": 17054.15, "timestamp": "04:44:14", "text": "もう少しの間は続くでしょう。"}, {"type": "subtitle", "time": 17057.11, "timestamp": "04:44:17", "text": "待って。 VCでさよならを言ってください。いいえ、VCを使用してください。"}, {"type": "subtitle", "time": 17059.11, "timestamp": "04:44:19", "text": "何？ああ、そうしなければならない。バイバイ。した"}, {"type": "subtitle", "time": 17073.11, "timestamp": "04:44:33", "text": "ここからストリーミング配信できます。つまり、私は"}, {"type": "subtitle", "time": 17076.07, "timestamp": "04:44:36", "text": "しないで"}, {"type": "subtitle", "time": 17078.39, "timestamp": "04:44:38", "text": "ここにいることができて、皆さんに感謝します"}, {"type": "subtitle", "time": 17081.03, "timestamp": "04:44:41", "text": "接合。"}, {"type": "subtitle", "time": 17087.43, "timestamp": "04:44:47", "text": "一体誰なんだ？つまり、そのうちの2つは"}, {"type": "subtitle", "time": 17089.83, "timestamp": "04:44:49", "text": "去る。"}, {"type": "subtitle", "time": 17091.67, "timestamp": "04:44:51", "text": "バイバイ。"}, {"type": "subtitle", "time": 17095.51, "timestamp": "04:44:55", "text": "いいえ、そうは思いません。ただ、ただあなたに伝えるだけです"}, {"type": "subtitle", "time": 17097.67, "timestamp": "04:44:57", "text": "みんな。"}]
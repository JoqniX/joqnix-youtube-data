[{"type": "subtitle", "time": 18546.628, "timestamp": "05:09:06", "text": "私だけでしょうか？"}, {"type": "subtitle", "time": 18556.47, "timestamp": "05:09:16", "text": "ここに誰がいるの？"}, {"type": "subtitle", "time": 18558.948, "timestamp": "05:09:18", "text": "私じゃないよ。私はまだここにはいません。うん、君は"}, {"type": "subtitle", "time": 18563.03, "timestamp": "05:09:23", "text": "ない。ハンハン、君が行方不明だよ。"}, {"type": "subtitle", "time": 18565.03, "timestamp": "05:09:25", "text": "ハン、あの時の表情を見たらよかったのに"}, {"type": "subtitle", "time": 18567.75, "timestamp": "05:09:27", "text": "彼らの顔。ああ、ただいま。"}, {"type": "subtitle", "time": 18570.708, "timestamp": "05:09:30", "text": "どうしたの？たくさんのものがあり、"}, {"type": "subtitle", "time": 18580.23, "timestamp": "05:09:40", "text": "ええ、今まさに飲み物を取りに行っています。"}, {"type": "subtitle", "time": 18582.868, "timestamp": "05:09:42", "text": "ああ、彼らは水を飲むために川に流れ込んでいる"}, {"type": "subtitle", "time": 18586.31, "timestamp": "05:09:46", "text": "今。うん。くそ。どれがどれのように"}, {"type": "subtitle", "time": 18589.51, "timestamp": "05:09:49", "text": "ウィスキー？ああ、ヨシ、どうしていつも"}, {"type": "subtitle", "time": 18591.43, "timestamp": "05:09:51", "text": "そんなに怖がっているの？"}, {"type": "subtitle", "time": 18593.19, "timestamp": "05:09:53", "text": "わからない。たぶん、たぶん"}, {"type": "subtitle", "time": 18594.868, "timestamp": "05:09:54", "text": "私が彼女を殺して以来、彼女は人間不信に陥っている。"}, {"type": "subtitle", "time": 18598.31, "timestamp": "05:09:58", "text": "いいえ。ええ。あなたはいつもすごくストレスを抱えているね。"}]
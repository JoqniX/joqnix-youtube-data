[{"type": "subtitle", "time": 1081.27, "timestamp": "00:18:01", "text": "待っていてください。私のモニター。私はただ"}, {"type": "subtitle", "time": 1084.31, "timestamp": "00:18:04", "text": "机だよ、おい。緩い。いや、"}, {"type": "subtitle", "time": 1091.029, "timestamp": "00:18:11", "text": "うん。夜が明けるたびに、"}, {"type": "subtitle", "time": 1094.71, "timestamp": "00:18:14", "text": "群れが"}, {"type": "subtitle", "time": 1099.669, "timestamp": "00:18:19", "text": "衰退していく。衰退していく。"}, {"type": "subtitle", "time": 1101.51, "timestamp": "00:18:21", "text": "ローバー、"}, {"type": "subtitle", "time": 1104.15, "timestamp": "00:18:24", "text": "誰かがあなたに"}, {"type": "subtitle", "time": 1106.789, "timestamp": "00:18:26", "text": "あなたが望むものなしで"}, {"type": "subtitle", "time": 1114.07, "timestamp": "00:18:34", "text": "[音楽]"}, {"type": "subtitle", "time": 1117.59, "timestamp": "00:18:37", "text": "私もかつてはそう信じていました。次のように考えられています"}, {"type": "subtitle", "time": 1120.39, "timestamp": "00:18:40", "text": "十分な代償を払った限り、"}, {"type": "subtitle", "time": 1122.63, "timestamp": "00:18:42", "text": "望む結果が得られるかもしれない。私はただ"}, {"type": "subtitle", "time": 1124.71, "timestamp": "00:18:44", "text": "目が覚めた。良質なものは希少だ。願わくば"}, {"type": "subtitle", "time": 1127.35, "timestamp": "00:18:47", "text": "良い朝をお過ごしください。夕食を食べる。私"}, {"type": "subtitle", "time": 1130.87, "timestamp": "00:18:50", "text": "朝食を食べて、荷物をまとめて、場所へ行った。良い"}, {"type": "subtitle", "time": 1132.95, "timestamp": "00:18:52", "text": "運。幸運を。"}, {"type": "subtitle", "time": 1135.83, "timestamp": "00:18:55", "text": "平等な報復を受けるためには、"}]
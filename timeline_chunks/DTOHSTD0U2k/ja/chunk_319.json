[{"type": "subtitle", "time": 19141.51, "timestamp": "05:19:01", "text": "私は兵士です。私は兵士です。それはあなたを意味します"}, {"type": "subtitle", "time": 19144.15, "timestamp": "05:19:04", "text": "殺すことができる。いや、いや、君は、ああ、私は"}, {"type": "subtitle", "time": 19157.11, "timestamp": "05:19:17", "text": "誰か疑っている人はいますか？行けます"}, {"type": "subtitle", "time": 19165.11, "timestamp": "05:19:25", "text": "実際に？"}, {"type": "subtitle", "time": 19166.39, "timestamp": "05:19:26", "text": "よくわからない。わかった。わかった。待って、"}, {"type": "subtitle", "time": 19167.83, "timestamp": "05:19:27", "text": "待って。じゃあ、私はただ行って殺せばいいの？"}, {"type": "subtitle", "time": 19171.03, "timestamp": "05:19:31", "text": "L？はい、もちろんです。続いていきましょう。よし、"}, {"type": "subtitle", "time": 19173.27, "timestamp": "05:19:33", "text": "行く。さあ行こう。私たちはあなたについていきます。"}, {"type": "subtitle", "time": 19177.35, "timestamp": "05:19:37", "text": "さあ行こう。うん。うん。"}, {"type": "subtitle", "time": 19185.11, "timestamp": "05:19:45", "text": "ああ、あなたの「こんにちは」はどこですか？ EKです。私"}, {"type": "subtitle", "time": 19192.47, "timestamp": "05:19:52", "text": "EKが大好きです。何？ EKって何ですか？ああ。はぁ？"}, {"type": "subtitle", "time": 19196.708, "timestamp": "05:19:56", "text": "何？私は兵士です。それからキリと、えっと"}, {"type": "subtitle", "time": 19199.75, "timestamp": "05:19:59", "text": "レネを殺せと言われた。だから私はレナを殺した"}]
[{"type": "subtitle", "time": 12480.55, "timestamp": "03:28:00", "text": "おお。それはおかしい。それはチャットでした。それ"}, {"type": "subtitle", "time": 12482.309, "timestamp": "03:28:02", "text": "だった"}, {"type": "subtitle", "time": 12486.63, "timestamp": "03:28:06", "text": "すばらしい。公共の場で時間を有効活用する"}, {"type": "subtitle", "time": 12494.469, "timestamp": "03:28:14", "text": "何てことだ。だから私たちはただニャーニャー鳴いて"}, {"type": "subtitle", "time": 12498.389, "timestamp": "03:28:18", "text": "その後、怪しいことがすべて起こった"}, {"type": "subtitle", "time": 12501.269, "timestamp": "03:28:21", "text": "誰だったか分かっている。私はそれが認識できる"}, {"type": "subtitle", "time": 12506.15, "timestamp": "03:28:26", "text": "月はいつでも。何てことだ。何？"}, {"type": "subtitle", "time": 12538.229, "timestamp": "03:28:58", "text": "そんな感じ。信じられない"}]
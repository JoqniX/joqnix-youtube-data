[{"type": "subtitle", "time": 363.67, "timestamp": "00:06:03", "text": "みんな、あなたがどれだけ価値があるか知っていた"}, {"type": "subtitle", "time": 369.029, "timestamp": "00:06:09", "text": "は。はぁ。世界は残酷な場所だ。"}, {"type": "subtitle", "time": 371.99, "timestamp": "00:06:11", "text": "あなたは生きている人間ですが、"}, {"type": "subtitle", "time": 375.27, "timestamp": "00:06:15", "text": "君は多くの者にとって単なる駒に過ぎない。"}, {"type": "subtitle", "time": 378.55, "timestamp": "00:06:18", "text": "だから私はここにいる、あなたが見えるから"}, {"type": "subtitle", "time": 381.83, "timestamp": "00:06:21", "text": "親愛なる友人として、あなたに伝えたいことがあります"}, {"type": "subtitle", "time": 383.99, "timestamp": "00:06:23", "text": "真実。"}, {"type": "subtitle", "time": 387.029, "timestamp": "00:06:27", "text": "あなたが受けた全てのことについて、本当に本当に申し訳なく思っています"}, {"type": "subtitle", "time": 389.59, "timestamp": "00:06:29", "text": "これから直面する、"}, {"type": "subtitle", "time": 402.79, "timestamp": "00:06:42", "text": "あなたはどうですか？"}, {"type": "subtitle", "time": 406.23, "timestamp": "00:06:46", "text": "私はあなたが私の心を動かすことができない人だと分かっています"}, {"type": "subtitle", "time": 411.99, "timestamp": "00:06:51", "text": "簡単な言葉で。私の目標は単純です。私"}, {"type": "subtitle", "time": 413.99, "timestamp": "00:06:53", "text": "お互いの絆を深めたいだけです"}, {"type": "subtitle", "time": 417.83, "timestamp": "00:06:57", "text": "理解、それだけだ。来て、"}]
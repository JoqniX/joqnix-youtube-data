[{"type": "subtitle", "time": 9842.469, "timestamp": "02:44:02", "text": "それを言う。いいえ、彼からメールが来たんです。"}, {"type": "subtitle", "time": 9844.95, "timestamp": "02:44:04", "text": "いや、君たち"}, {"type": "subtitle", "time": 9847.03, "timestamp": "02:44:07", "text": "ゲーム実況。待って、それは謎です"}, {"type": "subtitle", "time": 9849.75, "timestamp": "02:44:09", "text": "参加希望者は今すぐ参加しますか？それとも参加しませんか？私はかもしれない"}, {"type": "subtitle", "time": 9853.19, "timestamp": "02:44:13", "text": "彼らの様子を確認する必要がある。"}, {"type": "subtitle", "time": 9855.75, "timestamp": "02:44:15", "text": "ほぼ間違いないと思います。ああ、わかるでしょ、わかるでしょ"}, {"type": "subtitle", "time": 9857.429, "timestamp": "02:44:17", "text": "彼ら。多様性採用の対象となるのは誰ですか？教えて"}, {"type": "subtitle", "time": 9859.99, "timestamp": "02:44:19", "text": "自分。でも、彼らはそうしないと思うよ。"}, {"type": "subtitle", "time": 9862.71, "timestamp": "02:44:22", "text": "そうだね。"}, {"type": "subtitle", "time": 9864.469, "timestamp": "02:44:24", "text": "彼らが誰なのか教えていただけますか？"}, {"type": "subtitle", "time": 9869.03, "timestamp": "02:44:29", "text": "いいえ、わかりません。いいえ。彼女だ。"}, {"type": "subtitle", "time": 9872.389, "timestamp": "02:44:32", "text": "大丈夫です。ママ。ママ。彼女だ。"}, {"type": "subtitle", "time": 9874.79, "timestamp": "02:44:34", "text": "皆さんはどんなマップが欲しいですか？氏"}, {"type": "subtitle", "time": 9877.11, "timestamp": "02:44:37", "text": "獣。その地図が欲しい。あなたはそれを知っています"}, {"type": "subtitle", "time": 9884.469, "timestamp": "02:44:44", "text": "うん。では"}, {"type": "subtitle", "time": 9886.95, "timestamp": "02:44:46", "text": "ああ、その地図が欲しい。私はしません"}, {"type": "subtitle", "time": 9891.75, "timestamp": "02:44:51", "text": "Cor のように。ええ、私もそう思います。"}, {"type": "subtitle", "time": 9894.55, "timestamp": "02:44:54", "text": "それは多すぎる"}]
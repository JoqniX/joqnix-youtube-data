[{"type": "subtitle", "time": 19322.708, "timestamp": "05:22:02", "text": "いや、桐樹さん。"}, {"type": "subtitle", "time": 19324.948, "timestamp": "05:22:04", "text": "きりゆき。いいえ。"}, {"type": "subtitle", "time": 19328.31, "timestamp": "05:22:08", "text": "いいえ。では、これからどうすればいいのでしょうか？私たちはどうすればいいのでしょうか？私"}, {"type": "subtitle", "time": 19336.23, "timestamp": "05:22:16", "text": "戻る。おかえり。"}, {"type": "subtitle", "time": 19338.31, "timestamp": "05:22:18", "text": "ありがとう。おかえり。え、誰？"}, {"type": "subtitle", "time": 19341.11, "timestamp": "05:22:21", "text": "待て、俺は1人殺したぞ。誰が？他に誰が殺したのか"}, {"type": "subtitle", "time": 19342.868, "timestamp": "05:22:22", "text": "ドレ？"}, {"type": "subtitle", "time": 19345.27, "timestamp": "05:22:25", "text": "わからない。"}, {"type": "subtitle", "time": 19347.51, "timestamp": "05:22:27", "text": "それでドラゴンは殺され、ウィローは"}, {"type": "subtitle", "time": 19349.43, "timestamp": "05:22:29", "text": "殺された。"}, {"type": "subtitle", "time": 19351.51, "timestamp": "05:22:31", "text": "ええ、私は自警団員でした。だから私は殺した"}, {"type": "subtitle", "time": 19353.43, "timestamp": "05:22:33", "text": "ウィロー、そしてドレは兵士だった。それから"}, {"type": "subtitle", "time": 19356.31, "timestamp": "05:22:36", "text": "彼はそれを殺さなかった。"}, {"type": "subtitle", "time": 19359.03, "timestamp": "05:22:39", "text": "あのね？私を守護してください。私は必要としている 私は必要としている"}, {"type": "subtitle", "time": 19362.15, "timestamp": "05:22:42", "text": "時計。ちょっとだけご褒美をください。待って、"}, {"type": "subtitle", "time": 19365.27, "timestamp": "05:22:45", "text": "待って。いや、待って。どうでも。 3つまで"}, {"type": "subtitle", "time": 19367.43, "timestamp": "05:22:47", "text": "人々。いや、いや、気にしないで。私は"}, {"type": "subtitle", "time": 19370.628, "timestamp": "05:22:50", "text": "彼女に投票してください。私は彼女に投票することができた。"}, {"type": "subtitle", "time": 19374.39, "timestamp": "05:22:54", "text": "君を置かなきゃ。ごめんなさい。"}, {"type": "subtitle", "time": 19379.67, "timestamp": "05:22:59", "text": "私はスキーです。わからない。私は生意気なの。おお、"}]
[{"type": "subtitle", "time": 15845.11, "timestamp": "04:24:05", "text": "こんにちは。"}, {"type": "subtitle", "time": 15859.91, "timestamp": "04:24:19", "text": "[音楽]"}, {"type": "subtitle", "time": 15871.51, "timestamp": "04:24:31", "text": "何てことだ。ああ、わからない。"}, {"type": "subtitle", "time": 15873.67, "timestamp": "04:24:33", "text": "私はヨシとオキシーと一緒にそこにいました。"}, {"type": "subtitle", "time": 15876.07, "timestamp": "04:24:36", "text": "しかし、二人は突然亡くなった。彼"}, {"type": "subtitle", "time": 15878.87, "timestamp": "04:24:38", "text": "実は保安官だったんです。ええ、彼は"}, {"type": "subtitle", "time": 15880.55, "timestamp": "04:24:40", "text": "突然亡くなった。彼はまるで"}, {"type": "subtitle", "time": 15882.87, "timestamp": "04:24:42", "text": "シェリフ。それで彼はアウを殺し、それから彼は"}, {"type": "subtitle", "time": 15884.95, "timestamp": "04:24:44", "text": "彼と共に死んだ。だから彼は"}, {"type": "subtitle", "time": 15888.87, "timestamp": "04:24:48", "text": "実際は保安官です。彼は"}, {"type": "subtitle", "time": 15890.389, "timestamp": "04:24:50", "text": "ああ、彼は自分が"}, {"type": "subtitle", "time": 15891.99, "timestamp": "04:24:51", "text": "シェリフ。"}, {"type": "subtitle", "time": 15893.99, "timestamp": "04:24:53", "text": "うん。彼が私たちに見せようとしていたように"}, {"type": "subtitle", "time": 15896.07, "timestamp": "04:24:56", "text": "彼は保安官で、その後殺人を犯した"}, {"type": "subtitle", "time": 15899.349, "timestamp": "04:24:59", "text": "Du は、彼が Du ではなかったため"}]
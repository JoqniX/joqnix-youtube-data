[{"type": "subtitle", "time": 9721.99, "timestamp": "02:42:01", "text": "えっと、どうやってミュートにすればいいんですか？"}, {"type": "subtitle", "time": 9724.87, "timestamp": "02:42:04", "text": "すみません。"}, {"type": "subtitle", "time": 9727.83, "timestamp": "02:42:07", "text": "何てことだ。"}, {"type": "subtitle", "time": 9730.95, "timestamp": "02:42:10", "text": "ああ、くそ。"}, {"type": "subtitle", "time": 9763.429, "timestamp": "02:42:43", "text": "明日。はい、わかりました。正しい。多分"}, {"type": "subtitle", "time": 9766.15, "timestamp": "02:42:46", "text": "たぶん明日。こんにちは。わかった。それで、"}, {"type": "subtitle", "time": 9767.75, "timestamp": "02:42:47", "text": "起きるときに起こしたくない"}, {"type": "subtitle", "time": 9769.51, "timestamp": "02:42:49", "text": "まず最初に。わかった。いいえ、私はあなたを望んでいません"}, {"type": "subtitle", "time": 9770.95, "timestamp": "02:42:50", "text": "ここ。だから、私は決してあなたを起こしません。"}, {"type": "subtitle", "time": 9773.59, "timestamp": "02:42:53", "text": "ごめんなさい。"}]
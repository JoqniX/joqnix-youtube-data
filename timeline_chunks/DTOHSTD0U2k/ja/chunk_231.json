[{"type": "subtitle", "time": 13862.309, "timestamp": "03:51:02", "text": "あなたと一緒にいたのは誰でしたか？うーん、スミは"}, {"type": "subtitle", "time": 13864.87, "timestamp": "03:51:04", "text": "犯罪多発地帯から広場へと続く路地。ウィローは"}, {"type": "subtitle", "time": 13867.99, "timestamp": "03:51:07", "text": "そこには。私はまだ広場にいます。それでヤシ"}, {"type": "subtitle", "time": 13869.91, "timestamp": "03:51:09", "text": "たぶんヤシ。ヤシには"}, {"type": "subtitle", "time": 13873.99, "timestamp": "03:51:13", "text": "まだアリバイはない。下に。私は"}, {"type": "subtitle", "time": 13876.309, "timestamp": "03:51:16", "text": "なあ、俺はどこかの病院から来たんだ。"}, {"type": "subtitle", "time": 13878.07, "timestamp": "03:51:18", "text": "つまり、彼女は本当に激しく叩いている、"}, {"type": "subtitle", "time": 13880.71, "timestamp": "03:51:20", "text": "右？そう、だってそれは"}, {"type": "subtitle", "time": 13882.87, "timestamp": "03:51:22", "text": "オキシーは、ドラッグが彼らと一緒にいたと言っている"}, {"type": "subtitle", "time": 13885.67, "timestamp": "03:51:25", "text": "病院から犯罪へ"}, {"type": "subtitle", "time": 13895.349, "timestamp": "03:51:35", "text": "私と一緒にいたのはウィローとニックだけだった。"}, {"type": "subtitle", "time": 13897.51, "timestamp": "03:51:37", "text": "それでおしまい。誰でもない"}, {"type": "subtitle", "time": 13899.59, "timestamp": "03:51:39", "text": "振り向く"}, {"type": "subtitle", "time": 13902.07, "timestamp": "03:51:42", "text": "何らかの怪物に変身する。うん。うん。"}, {"type": "subtitle", "time": 13906.469, "timestamp": "03:51:46", "text": "マスクのことね。そして、その時はあなたは安全だったのです。"}, {"type": "subtitle", "time": 13908.389, "timestamp": "03:51:48", "text": "あなたは「おい、何何」と言っていました"}, {"type": "subtitle", "time": 13911.189, "timestamp": "03:51:51", "text": "「お前らに一体何があったんだ？」そうだな。"}, {"type": "subtitle", "time": 13919.189, "timestamp": "03:51:59", "text": "これ？私は食事をしています。"}]
[{"type": "subtitle", "time": 2460.23, "timestamp": "00:41:00", "text": "もっと多くの人が、私たちは親切だと言った"}, {"type": "subtitle", "time": 2462.63, "timestamp": "00:41:02", "text": "怖い。私の親戚は怖かった。はい、"}, {"type": "subtitle", "time": 2465.109, "timestamp": "00:41:05", "text": "あなた？あなたが"}, {"type": "subtitle", "time": 2468.71, "timestamp": "00:41:08", "text": "ああ、なんてことだ。"}, {"type": "subtitle", "time": 2474.71, "timestamp": "00:41:14", "text": "地下室を出て、また次回お会いしましょう。私"}, {"type": "subtitle", "time": 2477.51, "timestamp": "00:41:17", "text": "父は私にできると思ったが、誰も"}, {"type": "subtitle", "time": 2484.23, "timestamp": "00:41:24", "text": "[音楽]"}, {"type": "subtitle", "time": 2486.39, "timestamp": "00:41:26", "text": "人生で初めてだから、"}, {"type": "subtitle", "time": 2503.67, "timestamp": "00:41:43", "text": "これを殴ってやる。ああ、じゃあ待って"}, {"type": "subtitle", "time": 2507.109, "timestamp": "00:41:47", "text": "父、叔父、あるいは何であれ"}, {"type": "subtitle", "time": 2510.79, "timestamp": "00:41:50", "text": "そして"}, {"type": "subtitle", "time": 2517.51, "timestamp": "00:41:57", "text": "に変わる"}]
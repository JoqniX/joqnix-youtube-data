[{"type": "subtitle", "time": 18841.27, "timestamp": "05:14:01", "text": "それは役に立たないですよね？正直に言うと、私は"}, {"type": "subtitle", "time": 18843.27, "timestamp": "05:14:03", "text": "パーティーよりもピエロの方が好きだ。ピエロ"}, {"type": "subtitle", "time": 18845.35, "timestamp": "05:14:05", "text": "気分が良くなった。"}, {"type": "subtitle", "time": 18848.23, "timestamp": "05:14:08", "text": "ピエロ。ピエロは何をするのか？ピエロ"}, {"type": "subtitle", "time": 18849.99, "timestamp": "05:14:09", "text": "少なくとも高エネルギーを使って人を殺すことができる"}, {"type": "subtitle", "time": 18855.67, "timestamp": "05:14:15", "text": "ピッチングは可能だが、こちらは不可能だ。おお。おお。ふむ。"}, {"type": "subtitle", "time": 18858.628, "timestamp": "05:14:18", "text": "それはオペラ歌手のことでしょう。"}, {"type": "subtitle", "time": 18861.43, "timestamp": "05:14:21", "text": "待って、全員殺せるしスキルもある、"}, {"type": "subtitle", "time": 18863.99, "timestamp": "05:14:23", "text": "右？だから、これはクールだと思う。"}, {"type": "subtitle", "time": 18865.75, "timestamp": "05:14:25", "text": "かわいいですね。"}, {"type": "subtitle", "time": 18868.07, "timestamp": "05:14:28", "text": "それでは十分な量が集まらない。私はそうではなかった"}, {"type": "subtitle", "time": 18870.628, "timestamp": "05:14:30", "text": "ミュート。つまり、それは"}, {"type": "subtitle", "time": 18873.03, "timestamp": "05:14:33", "text": "投票を受ける必要がある人？"}]
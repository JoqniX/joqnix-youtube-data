[{"type": "subtitle", "time": 13320.71, "timestamp": "03:42:00", "text": "ウィローは"}, {"type": "subtitle", "time": 13322.229, "timestamp": "03:42:02", "text": "何らかの理由で鍋の中に入れた。しかし"}, {"type": "subtitle", "time": 13324.229, "timestamp": "03:42:04", "text": "ウィロー、誰かが逃げ出したのは分かってるわ。"}, {"type": "subtitle", "time": 13326.15, "timestamp": "03:42:06", "text": "体から。"}, {"type": "subtitle", "time": 13330.229, "timestamp": "03:42:10", "text": "待って、真っ暗なのが見えた。私は"}, {"type": "subtitle", "time": 13333.349, "timestamp": "03:42:13", "text": "それが確実ではなかったのかどうかは分かりません。私"}, {"type": "subtitle", "time": 13335.11, "timestamp": "03:42:15", "text": "色を忘れてしまった"}, {"type": "subtitle", "time": 13338.95, "timestamp": "03:42:18", "text": "水。私はもう少しで入るところだった。いいえ、していません"}, {"type": "subtitle", "time": 13342.95, "timestamp": "03:42:22", "text": "来ることさえある。つまり、あなたは、あなたは"}, {"type": "subtitle", "time": 13344.55, "timestamp": "03:42:24", "text": "体から離れたところですね？私はサボります。"}, {"type": "subtitle", "time": 13347.99, "timestamp": "03:42:27", "text": "わからない。それはスキップできます"}, {"type": "subtitle", "time": 13349.83, "timestamp": "03:42:29", "text": "彼は一人だった。私が目にするのは彼だけだ"}, {"type": "subtitle", "time": 13351.91, "timestamp": "03:42:31", "text": "バスから離れていく。いいえ、私は彼を見ました"}, {"type": "subtitle", "time": 13353.83, "timestamp": "03:42:33", "text": "誰かと一緒に。彼が誰かと一緒にいるのを見かけた。"}, {"type": "subtitle", "time": 13356.15, "timestamp": "03:42:36", "text": "待てよ、そもそもそれはどこにあったんだっけ？"}, {"type": "subtitle", "time": 13367.349, "timestamp": "03:42:47", "text": "パイプに物が積み上がっている、とでも言っておきましょうか。"}, {"type": "subtitle", "time": 13371.349, "timestamp": "03:42:51", "text": "まあ、ひどく"}, {"type": "subtitle", "time": 13373.51, "timestamp": "03:42:53", "text": "文字通り彼のそばを通り過ぎて殺した"}]
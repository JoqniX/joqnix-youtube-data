[{"type": "subtitle", "time": 15541.67, "timestamp": "04:19:01", "text": "殺人犯がいた。"}, {"type": "subtitle", "time": 15544.229, "timestamp": "04:19:04", "text": "いや、いや、好きじゃないってわけじゃないけど、セックスって知ってるでしょ？"}, {"type": "subtitle", "time": 15546.87, "timestamp": "04:19:06", "text": "人を殺せる人たち。ええ、ミス"}, {"type": "subtitle", "time": 15549.269, "timestamp": "04:19:09", "text": "クリック。準備してください。準備してください。ええ、私は"}, {"type": "subtitle", "time": 15554.55, "timestamp": "04:19:14", "text": "ベルのアイコンをクリックしたかった。私は"}, {"type": "subtitle", "time": 15562.07, "timestamp": "04:19:22", "text": "うん、"}, {"type": "subtitle", "time": 15565.99, "timestamp": "04:19:25", "text": "彼は、ああ、わかった。わかった。"}, {"type": "subtitle", "time": 15567.68, "timestamp": "04:19:27", "text": "わかった。 さあ行こう。"}, {"type": "subtitle", "time": 15579.269, "timestamp": "04:19:39", "text": "さあ行こう。もう一度やってもらえますか？する"}, {"type": "subtitle", "time": 15592.63, "timestamp": "04:19:52", "text": "それはああ、いやだと思った。いいえ。いいえ。"}, {"type": "subtitle", "time": 15595.11, "timestamp": "04:19:55", "text": "みんな、気をつけて。"}, {"type": "subtitle", "time": 15598.71, "timestamp": "04:19:58", "text": "ああ、あれはドードー鳥だ。私を信じないで。"}]
[{"type": "subtitle", "time": 4766.229, "timestamp": "01:19:26", "text": "ああ、そんな感じ。"}, {"type": "subtitle", "time": 4767.25, "timestamp": "01:19:27", "text": "ああ、"}, {"type": "subtitle", "time": 4770.87, "timestamp": "01:19:30", "text": "[音楽]"}, {"type": "subtitle", "time": 4773.99, "timestamp": "01:19:33", "text": "なぜ私の人生には上司がいるのか？"}, {"type": "subtitle", "time": 4777.13, "timestamp": "01:19:37", "text": "我慢する。ここはどこ？起きなきゃ。"}, {"type": "subtitle", "time": 4784.55, "timestamp": "01:19:44", "text": "私のピンが上下に動いています。それはとても"}, {"type": "subtitle", "time": 4794.95, "timestamp": "01:19:54", "text": "あれは変な形のハチか何かだ"}, {"type": "subtitle", "time": 4796.87, "timestamp": "01:19:56", "text": "いくつか。"}]
[{"type": "subtitle", "time": 720.71, "timestamp": "00:12:00", "text": "まだ小さい。これからも最善を尽くします"}, {"type": "subtitle", "time": 723.509, "timestamp": "00:12:03", "text": "村で保護される"}, {"type": "subtitle", "time": 727.11, "timestamp": "00:12:07", "text": "薄い円盤状の粒子に侵食された。わかった。"}, {"type": "subtitle", "time": 732.87, "timestamp": "00:12:12", "text": "私たちの物語はここから始まる。ああ、昔々"}, {"type": "subtitle", "time": 736.15, "timestamp": "00:12:16", "text": "ある平和な村に羊の群れが住んでいました"}, {"type": "subtitle", "time": 739.269, "timestamp": "00:12:19", "text": "のんびりとした子羊たち。彼らがその日"}, {"type": "subtitle", "time": 743.19, "timestamp": "00:12:23", "text": "食料を求めて働き、夕暮れが訪れると"}, {"type": "subtitle", "time": 745.67, "timestamp": "00:12:25", "text": "彼らは迫りくる脅威から逃れようとした"}, {"type": "subtitle", "time": 748.47, "timestamp": "00:12:28", "text": "オオカミの脅威。"}, {"type": "subtitle", "time": 751.03, "timestamp": "00:12:31", "text": "わかった。寓話。"}, {"type": "subtitle", "time": 753.509, "timestamp": "00:12:33", "text": "物語は、"}, {"type": "subtitle", "time": 756.629, "timestamp": "00:12:36", "text": "年齢。古代の伝達技術"}, {"type": "subtitle", "time": 759.43, "timestamp": "00:12:39", "text": "フィクションを通して隠された真実。しかし彼らは"}, {"type": "subtitle", "time": 762.23, "timestamp": "00:12:42", "text": "彼らはいつも実生活からインスピレーションを得ているよね？"}, {"type": "subtitle", "time": 765.829, "timestamp": "00:12:45", "text": "現実の生活。わかった。同じ話が"}, {"type": "subtitle", "time": 769.35, "timestamp": "00:12:49", "text": "多くの人が語った話だ。そして各人が"}, {"type": "subtitle", "time": 772.55, "timestamp": "00:12:52", "text": "彼ら独自の解釈。彼ら自身のもの。うん。こんにちは、"}, {"type": "subtitle", "time": 774.949, "timestamp": "00:12:54", "text": "ロバート・ジャクソン。いらっしゃいませ。そこから学びなさい"}, {"type": "subtitle", "time": 777.67, "timestamp": "00:12:57", "text": "これは無数の異なるものの1つにすぎません"}, {"type": "subtitle", "time": 779.43, "timestamp": "00:12:59", "text": "解釈"}]
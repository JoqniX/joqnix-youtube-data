[{"type": "subtitle", "time": 7443.669, "timestamp": "02:04:03", "text": "よし、これを靴に使おう"}, {"type": "subtitle", "time": 7451.189, "timestamp": "02:04:11", "text": "ようこそ、ドラゴン。"}, {"type": "subtitle", "time": 7453.83, "timestamp": "02:04:13", "text": "ドンさん、ようこそ。"}, {"type": "subtitle", "time": 7466.47, "timestamp": "02:04:26", "text": "それはボスだ。"}, {"type": "subtitle", "time": 7479.99, "timestamp": "02:04:39", "text": "そんなことができるって知っていましたか？私"}, {"type": "subtitle", "time": 7487.43, "timestamp": "02:04:47", "text": "彼女は鉱夫です。ディオ。彼女は文字通り"}]
[{"type": "subtitle", "time": 15132.95, "timestamp": "04:12:12", "text": "おお"}, {"type": "subtitle", "time": 15134.95, "timestamp": "04:12:14", "text": "こんにちは。"}, {"type": "subtitle", "time": 15138.87, "timestamp": "04:12:18", "text": "ああ、愛しい恋人たちよ。"}, {"type": "subtitle", "time": 15142.71, "timestamp": "04:12:22", "text": "ああ、夕食だ。"}, {"type": "subtitle", "time": 15144.229, "timestamp": "04:12:24", "text": "よし、みんな、この会議を招集したのは"}, {"type": "subtitle", "time": 15146.07, "timestamp": "04:12:26", "text": "実際にテレンを追い出すのは、"}, {"type": "subtitle", "time": 15148.63, "timestamp": "04:12:28", "text": "間違いなくテレンスです。もし"}, {"type": "subtitle", "time": 15150.79, "timestamp": "04:12:30", "text": "それは地球ではないので、私は嫌だ"}, {"type": "subtitle", "time": 15153.99, "timestamp": "04:12:33", "text": "そういう奴になるのは構わないが、私を追い出すことはできない。"}, {"type": "subtitle", "time": 15156.469, "timestamp": "04:12:36", "text": "間違いなくテレンスです。はい、"}, {"type": "subtitle", "time": 15158.389, "timestamp": "04:12:38", "text": "蹴り飛ばしてやる。"}, {"type": "subtitle", "time": 15159.99, "timestamp": "04:12:39", "text": "私"}, {"type": "subtitle", "time": 15162.469, "timestamp": "04:12:42", "text": "彼を昇進させる。私はあなたに約束します"}, {"type": "subtitle", "time": 15164.309, "timestamp": "04:12:44", "text": "それ。約束します。テレンです。"}, {"type": "subtitle", "time": 15168.07, "timestamp": "04:12:48", "text": "彼は彼を殺した。いや。もし私だったら、"}, {"type": "subtitle", "time": 15169.67, "timestamp": "04:12:49", "text": "彼も死んでいただろう。もしそうだったら"}, {"type": "subtitle", "time": 15172.15, "timestamp": "04:12:52", "text": "私もそう思うよ、君もそう思うだろう。つまり、私は、ほら"}, {"type": "subtitle", "time": 15174.309, "timestamp": "04:12:54", "text": "何？それはもっともな意見だ。何ですか"}]
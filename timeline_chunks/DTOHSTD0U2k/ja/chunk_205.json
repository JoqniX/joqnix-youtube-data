[{"type": "subtitle", "time": 12313.429, "timestamp": "03:25:13", "text": "科学。"}, {"type": "subtitle", "time": 12316.07, "timestamp": "03:25:16", "text": "ごめん。見る、"}, {"type": "subtitle", "time": 12318.229, "timestamp": "03:25:18", "text": "私は言ったでしょ、ああ神様、"}, {"type": "subtitle", "time": 12321.59, "timestamp": "03:25:21", "text": "アレックス。こんにちは。何てことだ。私は言った"}, {"type": "subtitle", "time": 12323.349, "timestamp": "03:25:23", "text": "右。よし、と思った。私は"}, {"type": "subtitle", "time": 12326.15, "timestamp": "03:25:26", "text": "私を助けてくれる。"}, {"type": "subtitle", "time": 12330.309, "timestamp": "03:25:30", "text": "つまり、私はアヒルか何かだったってこと？はい。"}, {"type": "subtitle", "time": 12333.59, "timestamp": "03:25:33", "text": "わかった。何てことだ。言ったでしょ。私は言った"}, {"type": "subtitle", "time": 12336.15, "timestamp": "03:25:36", "text": "それは100％ドラッグだった。私の本能は"}, {"type": "subtitle", "time": 12338.71, "timestamp": "03:25:38", "text": "嘘。"}, {"type": "subtitle", "time": 12341.13, "timestamp": "03:25:41", "text": "何てことだ。"}, {"type": "subtitle", "time": 12342.389, "timestamp": "03:25:42", "text": "[音楽]"}, {"type": "subtitle", "time": 12345.349, "timestamp": "03:25:45", "text": "ちょっと厳しすぎだよ、犬。あのね？"}, {"type": "subtitle", "time": 12347.83, "timestamp": "03:25:47", "text": "君にとっては試練だったんだよ。それは私でした"}, {"type": "subtitle", "time": 12350.63, "timestamp": "03:25:50", "text": "知る。わかった。だから、私は見ることができません"}, {"type": "subtitle", "time": 12353.75, "timestamp": "03:25:53", "text": "私のもう一人の偽者は誰ですか？"}, {"type": "subtitle", "time": 12355.349, "timestamp": "03:25:55", "text": "なんてこった。あなたはできない、なぜならあなたは"}, {"type": "subtitle", "time": 12356.95, "timestamp": "03:25:56", "text": "詐欺師。あなたは、ほら、"}, {"type": "subtitle", "time": 12359.83, "timestamp": "03:25:59", "text": "今は中立です。ええ、中立です"}]
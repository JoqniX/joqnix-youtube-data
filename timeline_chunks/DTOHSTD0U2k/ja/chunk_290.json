[{"type": "subtitle", "time": 17403.03, "timestamp": "04:50:03", "text": "勝利した？"}, {"type": "subtitle", "time": 17405.03, "timestamp": "04:50:05", "text": "たぶん猫かな。どうやって私に"}, {"type": "subtitle", "time": 17407.67, "timestamp": "04:50:07", "text": "爆弾？あなたはとても遠くにいました。私はしませんでした"}, {"type": "subtitle", "time": 17410.31, "timestamp": "04:50:10", "text": "爆弾をくれてやるよ。ああ、それは始まる"}, {"type": "subtitle", "time": 17413.35, "timestamp": "04:50:13", "text": "しばらくするとくっついてしまう。くそ。いいえ、いいえ、"}, {"type": "subtitle", "time": 17415.51, "timestamp": "04:50:15", "text": "いいえ。私はあなたに爆弾を渡していません。合格しました"}, {"type": "subtitle", "time": 17418.868, "timestamp": "04:50:18", "text": "ヨッシー、ああ、ヨッシーに渡したんだね。"}, {"type": "subtitle", "time": 17420.708, "timestamp": "04:50:20", "text": "彼女はそれを私に渡したので、私は彼女が"}, {"type": "subtitle", "time": 17427.19, "timestamp": "04:50:27", "text": "平均"}, {"type": "subtitle", "time": 17429.67, "timestamp": "04:50:29", "text": "それ"}, {"type": "subtitle", "time": 17432.868, "timestamp": "04:50:32", "text": "食事のために。え、私があなたを？ええ、私は"}, {"type": "subtitle", "time": 17434.15, "timestamp": "04:50:34", "text": "ずっと電話してたよ。彼は言わなかった"}, {"type": "subtitle", "time": 17436.47, "timestamp": "04:50:36", "text": "何でも。私は、私は、私は幽霊です。私"}, {"type": "subtitle", "time": 17438.628, "timestamp": "04:50:38", "text": "まるで体から消え去ってしまうような感覚。"}, {"type": "subtitle", "time": 17442.15, "timestamp": "04:50:42", "text": "だからあなたの声が聞こえなかったんです。"}, {"type": "subtitle", "time": 17443.75, "timestamp": "04:50:43", "text": "いいえ。ああ、何も言ってないじゃないですか。だから私は"}, {"type": "subtitle", "time": 17444.708, "timestamp": "04:50:44", "text": "「ああ、じゃあ、くたばれ」って感じだった。その後"}, {"type": "subtitle", "time": 17453.19, "timestamp": "04:50:53", "text": "私はあなたを無視しているわけではありません。でも、それは私じゃなかった"}, {"type": "subtitle", "time": 17455.67, "timestamp": "04:50:55", "text": "誰があなたにBの評価を与えたのですか？私ではありません。"}]
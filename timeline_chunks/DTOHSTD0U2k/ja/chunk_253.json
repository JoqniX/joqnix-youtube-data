[{"type": "subtitle", "time": 15181.91, "timestamp": "04:13:01", "text": "しかしそうではなかった"}, {"type": "subtitle", "time": 15189.99, "timestamp": "04:13:09", "text": "そうすれば簡単に勝てるよ。"}, {"type": "subtitle", "time": 15192.389, "timestamp": "04:13:12", "text": "おお。"}, {"type": "subtitle", "time": 15195.67, "timestamp": "04:13:15", "text": "ドラマみたいに、ドラマは"}, {"type": "subtitle", "time": 15199.03, "timestamp": "04:13:19", "text": "再び良好になった。"}, {"type": "subtitle", "time": 15203.03, "timestamp": "04:13:23", "text": "おお。おお。なるほど。"}, {"type": "subtitle", "time": 15206.309, "timestamp": "04:13:26", "text": "なるほど、そういうことだったんですね。何てことだ。みんな、彼女は"}, {"type": "subtitle", "time": 15221.03, "timestamp": "04:13:41", "text": "こんにちは、テレン。一人で。こんにちは。こんにちは。"}, {"type": "subtitle", "time": 15231.03, "timestamp": "04:13:51", "text": "彼らは私たちの声を聞くこともあれば、聞かないこともある。"}, {"type": "subtitle", "time": 15233.99, "timestamp": "04:13:53", "text": "亡くなった人だけが"}, {"type": "subtitle", "time": 15236.87, "timestamp": "04:13:56", "text": "お互いの声に耳を傾ける。彼らには私たちの声が聞こえない。私たちは"}]
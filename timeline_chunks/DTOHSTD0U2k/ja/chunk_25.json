[{"type": "subtitle", "time": 1501.51, "timestamp": "00:25:01", "text": "そして、権力を与えるという彼の願いを保留した"}, {"type": "subtitle", "time": 1513.35, "timestamp": "00:25:13", "text": "最初から子羊たちは知っていた"}, {"type": "subtitle", "time": 1516.31, "timestamp": "00:25:16", "text": "願い事をすることのリスク。彼らもまた"}, {"type": "subtitle", "time": 1518.95, "timestamp": "00:25:18", "text": "犠牲者になる可能性がある"}, {"type": "subtitle", "time": 1521.11, "timestamp": "00:25:21", "text": "その他。"}, {"type": "subtitle", "time": 1524.47, "timestamp": "00:25:24", "text": "ランプは信じていた"}, {"type": "subtitle", "time": 1530.87, "timestamp": "00:25:30", "text": "一方、子羊の中には次のような考えを持つものもいた。"}, {"type": "subtitle", "time": 1532.71, "timestamp": "00:25:32", "text": "彼らはすでに危険を冒していた"}, {"type": "subtitle", "time": 1535.83, "timestamp": "00:25:35", "text": "他人の願いのために犠牲にされた、"}, {"type": "subtitle", "time": 1538.789, "timestamp": "00:25:38", "text": "そのリスクを転嫁するのは当然のことだった"}, {"type": "subtitle", "time": 1541.35, "timestamp": "00:25:41", "text": "自分自身の夢を実現するチャンス"}, {"type": "subtitle", "time": 1544.71, "timestamp": "00:25:44", "text": "欲望。そして彼らは演奏を続けた"}, {"type": "subtitle", "time": 1547.83, "timestamp": "00:25:47", "text": "ゲーム。"}, {"type": "subtitle", "time": 1550.87, "timestamp": "00:25:50", "text": "彼らは皆、結果を知っていたが、"}, {"type": "subtitle", "time": 1557.909, "timestamp": "00:25:57", "text": "恐れを抱きながらも貪欲。恐れを抱きながらも貪欲。"}]
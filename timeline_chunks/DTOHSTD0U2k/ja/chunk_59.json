[{"type": "subtitle", "time": 3542.549, "timestamp": "00:59:02", "text": "戦いは終息に向かっている。私は今、1つ手に入れたのでしょうか？"}, {"type": "subtitle", "time": 3545.19, "timestamp": "00:59:05", "text": "タップ？冗談でしょう？力"}, {"type": "subtitle", "time": 3547.829, "timestamp": "00:59:07", "text": "が迫っている。冗談でしょう？"}, {"type": "subtitle", "time": 3595.589, "timestamp": "00:59:55", "text": "私はこの戦いをリセットします"}]
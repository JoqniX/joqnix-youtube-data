[{"type": "subtitle", "time": 12780.79, "timestamp": "03:33:00", "text": "ランダム。待って。時計。時計。ええ、私は"}, {"type": "subtitle", "time": 12782.469, "timestamp": "03:33:02", "text": "私はランダムに選びます。ああ、気にしないで。私は"}, {"type": "subtitle", "time": 12786.15, "timestamp": "03:33:06", "text": "私はプロです。"}, {"type": "subtitle", "time": 12789.03, "timestamp": "03:33:09", "text": "まあ。えっと、これは、"}, {"type": "subtitle", "time": 12798.71, "timestamp": "03:33:18", "text": "何を選べばいいのか？何を選べばいいのか？"}, {"type": "subtitle", "time": 12807.429, "timestamp": "03:33:27", "text": "自分。選手が誰なのかは分かりません。"}, {"type": "subtitle", "time": 12813.83, "timestamp": "03:33:33", "text": "彼は2位だ。"}, {"type": "subtitle", "time": 12815.19, "timestamp": "03:33:35", "text": "私は迷惑な人間です。番号は"}, {"type": "subtitle", "time": 12817.11, "timestamp": "03:33:37", "text": "二。"}, {"type": "subtitle", "time": 12819.51, "timestamp": "03:33:39", "text": "うわぁ。プロ。"}, {"type": "subtitle", "time": 12822.309, "timestamp": "03:33:42", "text": "おい、プロゲーマーになることを想像してみてくれ。"}, {"type": "subtitle", "time": 12825.28, "timestamp": "03:33:45", "text": "プロゲーマーだよ。あなたが知っている、"}, {"type": "subtitle", "time": 12827.75, "timestamp": "03:33:47", "text": "[音楽]"}, {"type": "subtitle", "time": 12829.349, "timestamp": "03:33:49", "text": "プロゲーマーになった自分を想像してみてください。おお"}, {"type": "subtitle", "time": 12830.79, "timestamp": "03:33:50", "text": "しまった、ドードー鳥を捕まえたぞ。それは"}, {"type": "subtitle", "time": 12832.469, "timestamp": "03:33:52", "text": "楽しい。"}, {"type": "subtitle", "time": 12836.55, "timestamp": "03:33:56", "text": "さあ、行こう。それは面白そうだ。私"}, {"type": "subtitle", "time": 12839.03, "timestamp": "03:33:59", "text": "落書き風の鳥が気に入りました。うん、落書き鳥"}]
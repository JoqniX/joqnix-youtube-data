[{"type": "subtitle", "time": 13022.469, "timestamp": "03:37:02", "text": "死体。そして私の役割は私に"}, {"type": "subtitle", "time": 13023.83, "timestamp": "03:37:03", "text": "遺体を調べる。私は"}, {"type": "subtitle", "time": 13025.269, "timestamp": "03:37:05", "text": "それはそうだったのですが、何が起こったのか私にはわかりません。"}, {"type": "subtitle", "time": 13027.67, "timestamp": "03:37:07", "text": "ゲームが一瞬フリーズした。まるで"}, {"type": "subtitle", "time": 13030.87, "timestamp": "03:37:10", "text": "自分。私は身動きが取れなくなっていたのですが、彼がそばにいてくれました。彼"}, {"type": "subtitle", "time": 13032.15, "timestamp": "03:37:12", "text": "何も言わずに、それから彼は"}, {"type": "subtitle", "time": 13034.15, "timestamp": "03:37:14", "text": "来て解読してくれた。あなたは何を"}, {"type": "subtitle", "time": 13036.55, "timestamp": "03:37:16", "text": "平均？私は「こんにちは」と言ったら、あなたはただ"}, {"type": "subtitle", "time": 13039.11, "timestamp": "03:37:19", "text": "そこに立っている。だから私は"}, {"type": "subtitle", "time": 13041.269, "timestamp": "03:37:21", "text": "調査しようとしたが、私にはできなかった。私"}, {"type": "subtitle", "time": 13042.87, "timestamp": "03:37:22", "text": "しないで"}, {"type": "subtitle", "time": 13044.469, "timestamp": "03:37:24", "text": "のように"}, {"type": "subtitle", "time": 13046.389, "timestamp": "03:37:26", "text": "私のチャットを101％信じてください。私は行くつもりです"}, {"type": "subtitle", "time": 13050.71, "timestamp": "03:37:30", "text": "ああ、今、その役割が分かりました。"}, {"type": "subtitle", "time": 13058.07, "timestamp": "03:37:38", "text": "いや、いや、いや。よし、私の役割は"}, {"type": "subtitle", "time": 13060.07, "timestamp": "03:37:40", "text": "私は遺体を調べ、それから"}, {"type": "subtitle", "time": 13062.389, "timestamp": "03:37:42", "text": "役割を見せてくれる。"}, {"type": "subtitle", "time": 13064.309, "timestamp": "03:37:44", "text": "だから私はその役を以前に見たことがなかったのですが、"}, {"type": "subtitle", "time": 13069.19, "timestamp": "03:37:49", "text": "今すぐ見てください。今、分かりました。彼は"}, {"type": "subtitle", "time": 13072.57, "timestamp": "03:37:52", "text": "混乱した。一体何が起こったんだ？"}, {"type": "subtitle", "time": 13075.99, "timestamp": "03:37:55", "text": "[音楽]"}, {"type": "subtitle", "time": 13078.95, "timestamp": "03:37:58", "text": "大丈夫。なぜ？"}]
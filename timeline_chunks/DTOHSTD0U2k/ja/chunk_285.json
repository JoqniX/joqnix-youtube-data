[{"type": "subtitle", "time": 17101.59, "timestamp": "04:45:01", "text": "ハードウッドコートが戻ってきた。うん。さあ行こう。"}, {"type": "subtitle", "time": 17103.43, "timestamp": "04:45:03", "text": "君たちは行くよ 君たちは行くよ"}, {"type": "subtitle", "time": 17105.99, "timestamp": "04:45:05", "text": "しばらく配信を続けるんですよね？ズミ。"}, {"type": "subtitle", "time": 17108.628, "timestamp": "04:45:08", "text": "はい。うん。これから作りに行くよ"}, {"type": "subtitle", "time": 17111.91, "timestamp": "04:45:11", "text": "夕食を食べて、戻ってきてください。"}, {"type": "subtitle", "time": 17113.75, "timestamp": "04:45:13", "text": "その夜は停電だった。"}, {"type": "subtitle", "time": 17115.75, "timestamp": "04:45:15", "text": "だから、まだ夕食を作っていないんです。ああ、それは"}, {"type": "subtitle", "time": 17118.39, "timestamp": "04:45:18", "text": "悲しい。よし。もちろん。だから私は"}, {"type": "subtitle", "time": 17121.27, "timestamp": "04:45:21", "text": "ストリーミング配信もされていません。すぐに戻ります。"}, {"type": "subtitle", "time": 17123.35, "timestamp": "04:45:23", "text": "気をつけてね。はい、お元気で。"}, {"type": "subtitle", "time": 17127.27, "timestamp": "04:45:27", "text": "早く直るといいですね。バイバイ。さよなら。"}, {"type": "subtitle", "time": 17128.788, "timestamp": "04:45:28", "text": "バイバイ。"}, {"type": "subtitle", "time": 17132.39, "timestamp": "04:45:32", "text": "あなたが無料でお金を手に入れられるといいですね。"}, {"type": "subtitle", "time": 17143.19, "timestamp": "04:45:43", "text": "だから、他の皆はもっとプレイしたがっている。"}, {"type": "subtitle", "time": 17146.07, "timestamp": "04:45:46", "text": "ああ、もう終わりだ。私は終わった。よし、"}, {"type": "subtitle", "time": 17149.43, "timestamp": "04:45:49", "text": "さあ行こう。あ、待って。"}, {"type": "subtitle", "time": 17153.27, "timestamp": "04:45:53", "text": "私はもっ​​と多くの人と交流したいと思っています"}]
[{"type": "subtitle", "time": 1441.909, "timestamp": "00:24:01", "text": "羊飼いは徐々に支配権を握っていった"}, {"type": "subtitle", "time": 1445.59, "timestamp": "00:24:05", "text": "羊の群れと子羊たちは満足して暮らしていた"}, {"type": "subtitle", "time": 1447.51, "timestamp": "00:24:07", "text": "生きている。"}, {"type": "subtitle", "time": 1452.21, "timestamp": "00:24:12", "text": "しかし、これは私たちの物語の終わりではありません。"}, {"type": "subtitle", "time": 1454.149, "timestamp": "00:24:14", "text": "[拍手]"}, {"type": "subtitle", "time": 1457.11, "timestamp": "00:24:17", "text": "羊飼いは孤独な黒い"}, {"type": "subtitle", "time": 1460.95, "timestamp": "00:24:20", "text": "彼の群れの中の子羊に与えようと申し出た"}, {"type": "subtitle", "time": 1465.19, "timestamp": "00:24:25", "text": "それは望むどんな願いでも叶える。その見返りに、彼は"}, {"type": "subtitle", "time": 1468.149, "timestamp": "00:24:28", "text": "仲間の1人を"}, {"type": "subtitle", "time": 1469.669, "timestamp": "00:24:29", "text": "犠牲。"}, {"type": "subtitle", "time": 1476.71, "timestamp": "00:24:36", "text": "黒い子羊は拒否し、"}, {"type": "subtitle", "time": 1480.31, "timestamp": "00:24:40", "text": "群れから見放され、"}, {"type": "subtitle", "time": 1483.1, "timestamp": "00:24:43", "text": "住居または食料。"}, {"type": "subtitle", "time": 1484.87, "timestamp": "00:24:44", "text": "[音楽]"}, {"type": "subtitle", "time": 1488.71, "timestamp": "00:24:48", "text": "黒い子羊の追放後、さらに多くの子羊が"}, {"type": "subtitle", "time": 1491.59, "timestamp": "00:24:51", "text": "姿を消し続けた。子羊もね。ラムヤム"}, {"type": "subtitle", "time": 1495.51, "timestamp": "00:24:55", "text": "おいしい。何てことだ。黒いラボで"}, {"type": "subtitle", "time": 1497.909, "timestamp": "00:24:57", "text": "ルール"}]
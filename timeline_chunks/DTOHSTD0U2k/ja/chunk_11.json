[{"type": "subtitle", "time": 660.87, "timestamp": "00:11:00", "text": "仕事。"}, {"type": "subtitle", "time": 662.87, "timestamp": "00:11:02", "text": "どの家も怪物に怯えていた。私たちは"}, {"type": "subtitle", "time": 664.47, "timestamp": "00:11:04", "text": "これを見つけるために、ものすごく長い旅をした"}, {"type": "subtitle", "time": 666.79, "timestamp": "00:11:06", "text": "新しい場所。私は尋ねた。"}, {"type": "subtitle", "time": 669.03, "timestamp": "00:11:09", "text": "えっと、ママとパパが追いついたら"}, {"type": "subtitle", "time": 670.71, "timestamp": "00:11:10", "text": "叔父は私に「本当にすぐ来るよ」と言いました。"}, {"type": "subtitle", "time": 671.67, "timestamp": "00:11:11", "text": "待って。"}, {"type": "chat", "time": 673.915, "timestamp": "00:11:13", "author": "@Minkk102", "avatar": "https://yt4.ggpht.com/TF8h5uIigJBanBg4LA_XZaY69S8H6wHtAUIDSGgMxHUqkEYRKq0z9m5NM8cqeDFnXLN0nN8i8g=s64-c-k-c0x00ffffff-no-rj", "message": "suppp"}, {"type": "subtitle", "time": 674.23, "timestamp": "00:11:14", "text": "これほど日当たりの良い場所は他にない。どの木が"}, {"type": "subtitle", "time": 675.99, "timestamp": "00:11:15", "text": "桃を栽培していますか？ここ出身の人はあまりいない"}, {"type": "subtitle", "time": 679.269, "timestamp": "00:11:19", "text": "大都市へ行こう。ママが欲しい"}, {"type": "subtitle", "time": 682.15, "timestamp": "00:11:22", "text": "そしてパパが私を見つけてくれる。"}, {"type": "subtitle", "time": 685.67, "timestamp": "00:11:25", "text": "今日は私の誕生日です。"}, {"type": "subtitle", "time": 688.47, "timestamp": "00:11:28", "text": "私がそこにいる間、みんな親切そうだった"}, {"type": "subtitle", "time": 690.71, "timestamp": "00:11:30", "text": "塊。私はあの怪物たちを飼うことはできない"}, {"type": "subtitle", "time": 694.31, "timestamp": "00:11:34", "text": "離れて。みんな私のことが大好きだ。子供"}, {"type": "subtitle", "time": 696.71, "timestamp": "00:11:36", "text": "麺と持ち帰りプレゼント。それはありました"}, {"type": "subtitle", "time": 699.19, "timestamp": "00:11:39", "text": "母と父に会ってからずっと"}, {"type": "subtitle", "time": 700.55, "timestamp": "00:11:40", "text": "けれど。彼らが戻ってきてくれるといいな。彼らは"}, {"type": "subtitle", "time": 705.03, "timestamp": "00:11:45", "text": "戻ってくる？ええ、私は彼の"}, {"type": "chat", "time": 706.673, "timestamp": "00:11:46", "author": "@Minkk102", "avatar": "https://yt4.ggpht.com/TF8h5uIigJBanBg4LA_XZaY69S8H6wHtAUIDSGgMxHUqkEYRKq0z9m5NM8cqeDFnXLN0nN8i8g=s64-c-k-c0x00ffffff-no-rj", "message": "good morning/afternoon"}, {"type": "subtitle", "time": 707.11, "timestamp": "00:11:47", "text": "今は娘です。その前に、誰もが"}, {"type": "subtitle", "time": 709.99, "timestamp": "00:11:49", "text": "すでに私の面倒を見て、私を共有してくれました"}, {"type": "subtitle", "time": 711.99, "timestamp": "00:11:51", "text": "美味しい食事。父は私に言った、私は"}, {"type": "subtitle", "time": 717.269, "timestamp": "00:11:57", "text": "私は本当に幸運です。私は愛されてきた"}, {"type": "subtitle", "time": 718.949, "timestamp": "00:11:58", "text": "私の部分は"}]
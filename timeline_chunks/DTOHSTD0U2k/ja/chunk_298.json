[{"type": "subtitle", "time": 17884.39, "timestamp": "04:58:04", "text": "君は本当にわがままな子だね。寿司。"}, {"type": "subtitle", "time": 17886.708, "timestamp": "04:58:06", "text": "わかった。質問があります。私は"}, {"type": "subtitle", "time": 17889.03, "timestamp": "04:58:09", "text": "男。私はわがままな子供にはなれない。私はただ"}, {"type": "subtitle", "time": 17890.708, "timestamp": "04:58:10", "text": "クソ野郎。もし私が投票したら"}, {"type": "subtitle", "time": 17893.11, "timestamp": "04:58:13", "text": "する"}, {"type": "subtitle", "time": 17895.59, "timestamp": "04:58:15", "text": "投票で落選させることだ。"}, {"type": "subtitle", "time": 17897.43, "timestamp": "04:58:17", "text": "あなたの仕事は、選挙で落選することです。それからあなた"}, {"type": "subtitle", "time": 17899.67, "timestamp": "04:58:19", "text": "再び勝利する。投票して落選させよう。うん。それから"}, {"type": "subtitle", "time": 17902.39, "timestamp": "04:58:22", "text": "そうだね。ほらほら"}, {"type": "subtitle", "time": 17903.99, "timestamp": "04:58:23", "text": "それは動作します。うまくいったよね？それぞれをクリアします"}, {"type": "subtitle", "time": 17905.75, "timestamp": "04:58:25", "text": "他の人は、それは私たちどちらも"}, {"type": "subtitle", "time": 17907.99, "timestamp": "04:58:27", "text": "彼らはそこにいた。言いたいことを保留する"}, {"type": "subtitle", "time": 17910.23, "timestamp": "04:58:30", "text": "何か。彼女の声を聞こうとしている。何？"}, {"type": "subtitle", "time": 17912.15, "timestamp": "04:58:32", "text": "ドゥードゥーダックって何？って聞いてたんだけど"}, {"type": "subtitle", "time": 17914.15, "timestamp": "04:58:34", "text": "けれど？しかし、私はとても"}, {"type": "subtitle", "time": 17916.788, "timestamp": "04:58:36", "text": "混乱した。私が持っているものすべて。"}, {"type": "subtitle", "time": 17919.27, "timestamp": "04:58:39", "text": "つまり、ドロは偽者のように振る舞うのだ。もし彼らが"}, {"type": "subtitle", "time": 17920.948, "timestamp": "04:58:40", "text": "彼らが追放されれば、彼らの勝ちだ。彼らはそれは"}, {"type": "subtitle", "time": 17922.55, "timestamp": "04:58:42", "text": "彼らが追放されれば、即座に勝利となる。それで"}, {"type": "subtitle", "time": 17927.03, "timestamp": "04:58:47", "text": "彼らは偽者のように振る舞う必要がある。だからあなたは"}, {"type": "subtitle", "time": 17928.948, "timestamp": "04:58:48", "text": "実際にやることは、心を遊ぶことを目的としている"}, {"type": "subtitle", "time": 17932.948, "timestamp": "04:58:52", "text": "ゲームは君の負担だ。うん。ええ、つまり"}, {"type": "subtitle", "time": 17934.708, "timestamp": "04:58:54", "text": "私とドラッグ。それは中立的なものの1つです"}, {"type": "subtitle", "time": 17936.708, "timestamp": "04:58:56", "text": "ゲーム。正直に、"}, {"type": "subtitle", "time": 17938.47, "timestamp": "04:58:58", "text": "なあ、知ってるか？私たちはそれを運んだ"}]
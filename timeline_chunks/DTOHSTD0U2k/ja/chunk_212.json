[{"type": "subtitle", "time": 12726.389, "timestamp": "03:32:06", "text": "拍手していたのは私の手ではありませんでした。"}, {"type": "subtitle", "time": 12729.91, "timestamp": "03:32:09", "text": "パットは言った。ええ、わかっています。パット、"}, {"type": "subtitle", "time": 12732.55, "timestamp": "03:32:12", "text": "あなたは両手で拍手をする。どうやって"}, {"type": "subtitle", "time": 12735.59, "timestamp": "03:32:15", "text": "手を叩きますか？私は下半身麻痺です。"}, {"type": "subtitle", "time": 12737.99, "timestamp": "03:32:17", "text": "いや、いや、いや。"}, {"type": "subtitle", "time": 12741.83, "timestamp": "03:32:21", "text": "手を叩いてください。え、誰？"}, {"type": "subtitle", "time": 12748.389, "timestamp": "03:32:28", "text": "よし。こんにちは。"}, {"type": "subtitle", "time": 12757.349, "timestamp": "03:32:37", "text": "こんにちは。こんにちは。うん。調子はどう？"}, {"type": "subtitle", "time": 12760.07, "timestamp": "03:32:40", "text": "どうしたの？どうしたの？"}, {"type": "subtitle", "time": 12761.99, "timestamp": "03:32:41", "text": "うん。うん。"}, {"type": "subtitle", "time": 12764.55, "timestamp": "03:32:44", "text": "準備してください。だから私はできない"}, {"type": "subtitle", "time": 12770.229, "timestamp": "03:32:50", "text": "お前を殺す。プレイヤー1。言わないで"}, {"type": "subtitle", "time": 12771.59, "timestamp": "03:32:51", "text": "ナンバーワン。私がプレイヤー1になります。"}, {"type": "subtitle", "time": 12773.67, "timestamp": "03:32:53", "text": "私がプレイヤー1になります。これを見てください。"}, {"type": "subtitle", "time": 12775.83, "timestamp": "03:32:55", "text": "俺が一番だぜ、兄弟。私も同じものを手に入れました"}, {"type": "subtitle", "time": 12778.55, "timestamp": "03:32:58", "text": "番号。私がナンバーワンだ。私は選んでいます"}]
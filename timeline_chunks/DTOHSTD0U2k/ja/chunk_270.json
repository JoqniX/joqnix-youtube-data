[{"type": "subtitle", "time": 16201.349, "timestamp": "04:30:01", "text": "移動する。私のコントロールは奪われた"}, {"type": "subtitle", "time": 16202.95, "timestamp": "04:30:02", "text": "以上。"}, {"type": "subtitle", "time": 16209.269, "timestamp": "04:30:09", "text": "ええ、そうでした。だから、ペリカンがあなたを食べたら、"}, {"type": "subtitle", "time": 16211.67, "timestamp": "04:30:11", "text": "ペリカン以外、誰もあなたの声を聞くことはできません。"}, {"type": "subtitle", "time": 16214.149, "timestamp": "04:30:14", "text": "だから君たちは私に話しかけてきたんだ"}, {"type": "subtitle", "time": 16216.389, "timestamp": "04:30:16", "text": "そして私は返信しようとしていました"}, {"type": "subtitle", "time": 16223.429, "timestamp": "04:30:23", "text": "それが実際に起こったことだ。私は「すべて"}, {"type": "subtitle", "time": 16233.03, "timestamp": "04:30:33", "text": "ほら、"}, {"type": "subtitle", "time": 16234.55, "timestamp": "04:30:34", "text": "知ってるでしょ、5人くらいいたんだけど"}, {"type": "subtitle", "time": 16246.63, "timestamp": "04:30:46", "text": "最初はすでに"}, {"type": "subtitle", "time": 16249.51, "timestamp": "04:30:49", "text": "1人を殺した。"}, {"type": "subtitle", "time": 16259.67, "timestamp": "04:30:59", "text": "ほら、君はただ作ろうとするだけ"}]
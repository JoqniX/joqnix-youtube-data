[{"type": "subtitle", "time": 14520.71, "timestamp": "04:02:00", "text": "何てことだ。"}, {"type": "subtitle", "time": 14525.349, "timestamp": "04:02:05", "text": "彼は皆を殺している。何てことだ。"}, {"type": "subtitle", "time": 14529.51, "timestamp": "04:02:09", "text": "彼は殺しの画面に映っている。彼は殺人を犯している。"}, {"type": "subtitle", "time": 14531.11, "timestamp": "04:02:11", "text": "ちょっと待って。みんなストリーミング配信してる？"}, {"type": "subtitle", "time": 14535.11, "timestamp": "04:02:15", "text": "今すぐ？はい。いいえ、そう思います。"}, {"type": "subtitle", "time": 14538.309, "timestamp": "04:02:18", "text": "テレン、えーと、寿司、"}, {"type": "subtitle", "time": 14542.95, "timestamp": "04:02:22", "text": "えーと、それから壁。えっと、酸素。酸素。それから"}, {"type": "subtitle", "time": 14545.59, "timestamp": "04:02:25", "text": "壁。"}, {"type": "subtitle", "time": 14549.429, "timestamp": "04:02:29", "text": "ああ、自分の遺体を見つけた。私、ヨシ、そしてオキシ"}, {"type": "subtitle", "time": 14552.71, "timestamp": "04:02:32", "text": "一緒にいる。私たちは以下の"}, {"type": "subtitle", "time": 14556.63, "timestamp": "04:02:36", "text": "町立公園。一緒に遺体を見た。うん。"}, {"type": "subtitle", "time": 14558.309, "timestamp": "04:02:38", "text": "ええ、そうです。みんなはどこにいるの？"}, {"type": "subtitle", "time": 14560.469, "timestamp": "04:02:40", "text": "みんなはどこにいるの？待って、待って、待って。"}, {"type": "subtitle", "time": 14562.229, "timestamp": "04:02:42", "text": "待って。持続する。いや、いや、いや、いや。どこ"}, {"type": "subtitle", "time": 14564.07, "timestamp": "04:02:44", "text": "みんな？"}, {"type": "subtitle", "time": 14566.07, "timestamp": "04:02:46", "text": "いや、待って。私もあなたたちと一緒にいました。私はただ"}, {"type": "subtitle", "time": 14569.269, "timestamp": "04:02:49", "text": "亡くなった。そうそう。"}, {"type": "subtitle", "time": 14573.91, "timestamp": "04:02:53", "text": "お父さん、あなたは刑務所に行くことになるよ。何てことだ。"}, {"type": "subtitle", "time": 14576.309, "timestamp": "04:02:56", "text": "何てことだ。待てよ、みんな死んでるぞ、兄弟。"}, {"type": "subtitle", "time": 14579.429, "timestamp": "04:02:59", "text": "何？このゲームは動作が遅すぎる。"}]
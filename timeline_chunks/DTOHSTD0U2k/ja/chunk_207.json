[{"type": "subtitle", "time": 12422.389, "timestamp": "03:27:02", "text": "不適切に。"}, {"type": "subtitle", "time": 12435.429, "timestamp": "03:27:15", "text": "参加すると思います。ええ、彼はここにいます。それで、"}, {"type": "subtitle", "time": 12439.59, "timestamp": "03:27:19", "text": "うん。ええ、おっしゃる通りです。さあ行こう。"}, {"type": "subtitle", "time": 12443.11, "timestamp": "03:27:23", "text": "猫がここにいます。猫が来る。"}, {"type": "subtitle", "time": 12458.87, "timestamp": "03:27:38", "text": "[音楽]"}, {"type": "subtitle", "time": 12462.63, "timestamp": "03:27:42", "text": "何てことだ。何"}, {"type": "subtitle", "time": 12472.229, "timestamp": "03:27:52", "text": "[拍手]"}, {"type": "subtitle", "time": 12475.03, "timestamp": "03:27:55", "text": "スパム？あれはすごかった。ザ・フーがやったこと"}, {"type": "subtitle", "time": 12477.429, "timestamp": "03:27:57", "text": "それ？彼はその時間を有効に活用した。"}]
[{"type": "subtitle", "time": 10983.349, "timestamp": "03:03:03", "text": "懐かしいね、相棒。正直に。わかった。始める"}, {"type": "subtitle", "time": 10986.23, "timestamp": "03:03:06", "text": "最初からね、ベイビー。いいえ。いいえ。いいえ。いいえ。から。"}, {"type": "subtitle", "time": 10988.469, "timestamp": "03:03:08", "text": "正面。正面から。開始"}, {"type": "subtitle", "time": 10992.15, "timestamp": "03:03:12", "text": "トップだよ、ベイビー。ドラゴンがトップに立つ"}, {"type": "subtitle", "time": 10994.469, "timestamp": "03:03:14", "text": "または一番下。自己紹介をしてください。私"}, {"type": "subtitle", "time": 10997.51, "timestamp": "03:03:17", "text": "列に並ばなければならない。"}, {"type": "subtitle", "time": 10999.349, "timestamp": "03:03:19", "text": "わかったよ、ウィル。一番下で停止してください。"}, {"type": "subtitle", "time": 11001.91, "timestamp": "03:03:21", "text": "何？わかった、いいよ。ウィロー、行け。"}, {"type": "subtitle", "time": 11004.23, "timestamp": "03:03:24", "text": "ウィロー、まずはウィローをあげて。導入"}, {"type": "subtitle", "time": 11007.75, "timestamp": "03:03:27", "text": "あなた自身。さあ行こう。うん。乗る"}, {"type": "subtitle", "time": 11010.469, "timestamp": "03:03:30", "text": "ステージだよ、兄弟。 1つに登る"}, {"type": "subtitle", "time": 11013.51, "timestamp": "03:03:33", "text": "椅子。いや、いや、いや。あっちへ移動してください。"}, {"type": "subtitle", "time": 11015.03, "timestamp": "03:03:35", "text": "うん。移動します。"}, {"type": "subtitle", "time": 11017.03, "timestamp": "03:03:37", "text": "スポットライト。はい、どうぞ。うん、"}, {"type": "subtitle", "time": 11019.59, "timestamp": "03:03:39", "text": "はい、どうぞ。注目の的。非常に素晴らしい。"}, {"type": "subtitle", "time": 11022.71, "timestamp": "03:03:42", "text": "こんにちは。私はスミの雇われ友達です"}, {"type": "subtitle", "time": 11026.23, "timestamp": "03:03:46", "text": "ここ。うん。 500ドル差し上げます。私はしません"}, {"type": "subtitle", "time": 11029.03, "timestamp": "03:03:49", "text": "君たちがいくらもらっているかは知っているけど、"}, {"type": "subtitle", "time": 11031.99, "timestamp": "03:03:51", "text": "うわ、うわ、うわ。またこれか。何？"}, {"type": "subtitle", "time": 11034.23, "timestamp": "03:03:54", "text": "いいえ。"}, {"type": "subtitle", "time": 11036.309, "timestamp": "03:03:56", "text": "こんにちは、ウィロー。"}, {"type": "subtitle", "time": 11039.269, "timestamp": "03:03:59", "text": "こんにちは。こんにちは。ああ、また列ができた。"}]
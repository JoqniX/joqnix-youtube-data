[{"type": "subtitle", "time": 18001.03, "timestamp": "05:00:01", "text": "豚がいる。いいえ。モーフとは何ですか？"}, {"type": "subtitle", "time": 18002.788, "timestamp": "05:00:02", "text": "はい、少々お待ちください。それは何をするものですか？病気"}, {"type": "subtitle", "time": 18005.99, "timestamp": "05:00:05", "text": "確認するだけです。あなたはできる"}, {"type": "subtitle", "time": 18008.31, "timestamp": "05:00:08", "text": "別のプレイヤーに交代する。あなたの考え"}, {"type": "subtitle", "time": 18011.35, "timestamp": "05:00:11", "text": "偽物です。ああ、なるほど。"}, {"type": "subtitle", "time": 18013.27, "timestamp": "05:00:13", "text": "ちょっと待って、みんな。酸素は音をこもらせる。彼女を蹴る"}, {"type": "subtitle", "time": 18016.31, "timestamp": "05:00:16", "text": "外。彼女を追い出せ。来て。いいえ、彼女は"}, {"type": "subtitle", "time": 18018.07, "timestamp": "05:00:18", "text": "説明を読んで、"}, {"type": "subtitle", "time": 18021.59, "timestamp": "05:00:21", "text": "情報に関するもの。 Yeahの説明。"}, {"type": "subtitle", "time": 18039.67, "timestamp": "05:00:39", "text": "なぜ私たちは皆孤独​​なのか？ああ、こんにちは。あなたは"}, {"type": "subtitle", "time": 18042.628, "timestamp": "05:00:42", "text": "実際には一人ではない。私はここにいます。"}, {"type": "subtitle", "time": 18045.75, "timestamp": "05:00:45", "text": "こんにちは、またお会いしましたね。私はミュートされています。私は誰を作ろうとしているのか"}, {"type": "subtitle", "time": 18059.83, "timestamp": "05:00:59", "text": "おお、"}]
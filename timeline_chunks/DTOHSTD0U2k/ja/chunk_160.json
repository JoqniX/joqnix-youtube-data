[{"type": "subtitle", "time": 9600.07, "timestamp": "02:40:00", "text": "ちなみに、音声ストリーミングについて言っています。"}, {"type": "subtitle", "time": 9601.19, "timestamp": "02:40:01", "text": "はい、すぐ戻ります。"}, {"type": "subtitle", "time": 9602.71, "timestamp": "02:40:02", "text": "パソコンを再起動する必要があると思う。私は違います"}, {"type": "subtitle", "time": 9604.389, "timestamp": "02:40:04", "text": "なぜ私のゲームがそうではないのかよくわかりません"}, {"type": "subtitle", "time": 9606.63, "timestamp": "02:40:06", "text": "インターネットに接続したい。行く"}, {"type": "subtitle", "time": 9609.19, "timestamp": "02:40:09", "text": "前だ、坊や。"}, {"type": "chat", "time": 9612.633, "timestamp": "02:40:12", "author": "@Shiori_mitsuki", "avatar": "https://yt4.ggpht.com/Dn0VbakjSKrSNaXx6PyhznuqbomoCGx22ivSawRcMXp25Io7cfsud3H3qP-g9QprPJUESlxxtJA=s64-c-k-c0x00ffffff-no-rj", "message": "Hehe lessgoo ~ UCkszU2WH9gy1mb0dV-11UJg/m8MfY4jbFsWJhL0PyouA2Ak"}, {"type": "subtitle", "time": 9618.63, "timestamp": "02:40:18", "text": "神はそうするだろう。"}, {"type": "subtitle", "time": 9621.91, "timestamp": "02:40:21", "text": "はい、戻ってきました。こんにちは。絶妙なタイミングだ。私"}, {"type": "subtitle", "time": 9623.99, "timestamp": "02:40:23", "text": "リンクが必要でした。リンクはどこですか？"}, {"type": "subtitle", "time": 9626.469, "timestamp": "02:40:26", "text": "リンク。どこ？どこ？あなたのリンクはどこですか？"}, {"type": "subtitle", "time": 9628.07, "timestamp": "02:40:28", "text": "どういう意味ですか？これは載っていません"}, {"type": "subtitle", "time": 9640.55, "timestamp": "02:40:40", "text": "はい。"}, {"type": "subtitle", "time": 9642.95, "timestamp": "02:40:42", "text": "VCチャット。実際、I に入れてください"}, {"type": "subtitle", "time": 9645.91, "timestamp": "02:40:45", "text": "サムネイルは作成しませんでした。"}, {"type": "chat", "time": 9646.198, "timestamp": "02:40:46", "author": "@Shiori_mitsuki", "avatar": "https://yt4.ggpht.com/Dn0VbakjSKrSNaXx6PyhznuqbomoCGx22ivSawRcMXp25Io7cfsud3H3qP-g9QprPJUESlxxtJA=s64-c-k-c0x00ffffff-no-rj", "message": "Yoshino san also here :3"}, {"type": "subtitle", "time": 9648.23, "timestamp": "02:40:48", "text": "さぁ行こう。"}, {"type": "subtitle", "time": 9651.27, "timestamp": "02:40:51", "text": "待って、このゲームで服を着ている人なんているの？どうやって"}, {"type": "subtitle", "time": 9653.03, "timestamp": "02:40:53", "text": "ゲームに参加すべきですか？私は持っていると思います"}, {"type": "subtitle", "time": 9654.63, "timestamp": "02:40:54", "text": "何か買うもの。つまり、あなたは"}, {"type": "subtitle", "time": 9656.07, "timestamp": "02:40:56", "text": "今は何も着ていません。誰でも"}, {"type": "subtitle", "time": 9658.389, "timestamp": "02:40:58", "text": "クソみたいなゲームで服を着ている奴は誰であれ、"}]
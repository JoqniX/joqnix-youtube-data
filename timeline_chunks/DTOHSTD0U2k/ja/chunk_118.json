[{"type": "subtitle", "time": 7083.189, "timestamp": "01:58:03", "text": "だから、ある意味、私は気にしなくていい"}, {"type": "subtitle", "time": 7085.83, "timestamp": "01:58:05", "text": "これをすることで、私自身も満足しています。"}, {"type": "subtitle", "time": 7098.55, "timestamp": "01:58:18", "text": "わかった。"}, {"type": "subtitle", "time": 7102.48, "timestamp": "01:58:22", "text": "ああ、みんな、私の声が聞こえてるよね？わかった。"}, {"type": "subtitle", "time": 7104.709, "timestamp": "01:58:24", "text": "[音楽]"}, {"type": "subtitle", "time": 7115.35, "timestamp": "01:58:35", "text": "砂漠のイベントを終えて出発します"}]
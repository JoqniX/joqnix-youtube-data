[{"type": "subtitle", "time": 3321.829, "timestamp": "00:55:21", "text": "[音楽]"}, {"type": "subtitle", "time": 3324.87, "timestamp": "00:55:24", "text": "複製を手に入れたので、"}, {"type": "subtitle", "time": 3327.27, "timestamp": "00:55:27", "text": "彼女を強くする。"}, {"type": "subtitle", "time": 3330.309, "timestamp": "00:55:30", "text": "そして、彼女をアップグレードするつもりだ。はい。あなたは"}, {"type": "subtitle", "time": 3332.71, "timestamp": "00:55:32", "text": "これが私のメインになる予定です。"}, {"type": "subtitle", "time": 3348.71, "timestamp": "00:55:48", "text": "私の真紅の刃は長持ちし、"}, {"type": "subtitle", "time": 3351.75, "timestamp": "00:55:51", "text": "体全体がとても軽くなったように感じる。私は決して"}, {"type": "subtitle", "time": 3354.15, "timestamp": "00:55:54", "text": "この剣がこんなに軽いとは知らなかった"}]
[{"type": "subtitle", "time": 15061.269, "timestamp": "04:11:01", "text": "彼よりも。持続する。 ３人が死亡した。"}, {"type": "subtitle", "time": 15063.189, "timestamp": "04:11:03", "text": "持続する。"}, {"type": "subtitle", "time": 15066.07, "timestamp": "04:11:06", "text": "どうしたの？うん。うん。申し訳ありません。私"}, {"type": "subtitle", "time": 15068.63, "timestamp": "04:11:08", "text": "ジョアが死ぬのを見たが、誰が"}, {"type": "subtitle", "time": 15070.95, "timestamp": "04:11:10", "text": "それ。"}, {"type": "subtitle", "time": 15074.15, "timestamp": "04:11:14", "text": "待って。そのうちの一人は保安官だったと思う"}, {"type": "subtitle", "time": 15077.99, "timestamp": "04:11:17", "text": "死んだだけでなく、罪のない人を殺した。"}, {"type": "subtitle", "time": 15081.11, "timestamp": "04:11:21", "text": "うん、そうかもしれないね。はい、それで、私はかなり確信しています"}, {"type": "subtitle", "time": 15083.189, "timestamp": "04:11:23", "text": "それは偽物だ。私も偽物のように見える"}, {"type": "subtitle", "time": 15085.269, "timestamp": "04:11:25", "text": "彼らですよね？そしてテレンスは"}, {"type": "subtitle", "time": 15088.07, "timestamp": "04:11:28", "text": "私の目の前ですよね？なぜなら"}, {"type": "subtitle", "time": 15090.07, "timestamp": "04:11:30", "text": "私は実際"}, {"type": "subtitle", "time": 15092.95, "timestamp": "04:11:32", "text": "右。あれはドラッグだった。それは間違いなく"}, {"type": "subtitle", "time": 15101.99, "timestamp": "04:11:41", "text": "私は今まさにああ、なんてことだ。ごめんなさい、"}, {"type": "subtitle", "time": 15106.389, "timestamp": "04:11:46", "text": "ジョー。なぜ？いいえ、私は一緒にいると言いました"}, {"type": "subtitle", "time": 15109.269, "timestamp": "04:11:49", "text": "とんでもない。"}, {"type": "subtitle", "time": 15113.91, "timestamp": "04:11:53", "text": "彼らは生き延びた。"}]
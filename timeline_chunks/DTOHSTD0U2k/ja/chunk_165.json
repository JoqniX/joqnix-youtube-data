[{"type": "subtitle", "time": 9911.11, "timestamp": "02:45:11", "text": "どうやっていじめられるようになったの？"}, {"type": "subtitle", "time": 9914.309, "timestamp": "02:45:14", "text": "ゲームは始まるのか？"}, {"type": "subtitle", "time": 9916.63, "timestamp": "02:45:16", "text": "彼女は本当に素晴らしい記録を残しているよね"}, {"type": "subtitle", "time": 9919.83, "timestamp": "02:45:19", "text": "そこには。彼女は肋骨が10本少ないだけなんです。公平"}, {"type": "subtitle", "time": 9921.91, "timestamp": "02:45:21", "text": "十分。"}, {"type": "subtitle", "time": 9924.469, "timestamp": "02:45:24", "text": "右。右。この時点で"}, {"type": "subtitle", "time": 9927.75, "timestamp": "02:45:27", "text": "スシとウィローによるとかなり"}, {"type": "subtitle", "time": 9929.51, "timestamp": "02:45:29", "text": "いじめっ子のオーラがすべてを物語っている"}, {"type": "subtitle", "time": 9931.03, "timestamp": "02:45:31", "text": "以上。"}, {"type": "subtitle", "time": 9932.79, "timestamp": "02:45:32", "text": "まるで、私にはわからないみたいだ。まるで"}, {"type": "subtitle", "time": 9940.79, "timestamp": "02:45:40", "text": "リンクを送りました。コードを追加します"}, {"type": "subtitle", "time": 9943.59, "timestamp": "02:45:43", "text": "コラボレーションチャット。私はそれをリンクしています"}, {"type": "subtitle", "time": 9945.75, "timestamp": "02:45:45", "text": "視聴者。"}, {"type": "subtitle", "time": 9947.59, "timestamp": "02:45:47", "text": "さあ行こう。"}, {"type": "subtitle", "time": 9950.469, "timestamp": "02:45:50", "text": "それは私の得意分野になるだろう。じゃあ、見てみよう"}, {"type": "subtitle", "time": 9953.269, "timestamp": "02:45:53", "text": "5分後にお知らせします。わかった。うん。ここです。"}, {"type": "subtitle", "time": 9957.75, "timestamp": "02:45:57", "text": "うん。うん。私も配信を始めます。"}, {"type": "subtitle", "time": 9959.349, "timestamp": "02:45:59", "text": "うん。皆さんが望むなら、"}]
[{"type": "subtitle", "time": 17342.23, "timestamp": "04:49:02", "text": "君たちは本当に君のことが好きなんだよね？"}, {"type": "subtitle", "time": 17344.31, "timestamp": "04:49:04", "text": "私はあなたを信頼します。ええ、私は彼女にそれ以上問い詰めませんでした"}, {"type": "subtitle", "time": 17347.27, "timestamp": "04:49:07", "text": "けれど。キルは邪悪だ。私を自由にして。私にさせて"}, {"type": "subtitle", "time": 17350.23, "timestamp": "04:49:10", "text": "行く。"}, {"type": "subtitle", "time": 17354.39, "timestamp": "04:49:14", "text": "待って、ペリカンは君を解放してくれるよ。"}, {"type": "subtitle", "time": 17359.51, "timestamp": "04:49:19", "text": "君には私の声が聞こえているはずだ。理由がわかるでしょう"}, {"type": "subtitle", "time": 17363.59, "timestamp": "04:49:23", "text": "あなたを信用する？何？何？自業自得だ。"}, {"type": "subtitle", "time": 17365.99, "timestamp": "04:49:25", "text": "いらっしゃいませ。何？どうしたの？ようこそ"}, {"type": "subtitle", "time": 17369.51, "timestamp": "04:49:29", "text": "映画の世界へようこそ。バディポケット。"}, {"type": "subtitle", "time": 17371.27, "timestamp": "04:49:31", "text": "あなたは当然の報いを受けるべきだ。待って、"}, {"type": "subtitle", "time": 17373.03, "timestamp": "04:49:33", "text": "どうしたの？私たちは自由だ。ああ、私たちは"}, {"type": "subtitle", "time": 17375.59, "timestamp": "04:49:35", "text": "無料。どうしたの？急いで。何てことだ。"}, {"type": "subtitle", "time": 17377.67, "timestamp": "04:49:37", "text": "どうしたの？待って、ここで誰かが亡くなったんだ。"}, {"type": "subtitle", "time": 17382.07, "timestamp": "04:49:42", "text": "誰が亡くなったのですか？亡くなったのはその人たちです。"}, {"type": "subtitle", "time": 17386.07, "timestamp": "04:49:46", "text": "うん。ヨキが彼に爆弾を渡したと言った。"}, {"type": "subtitle", "time": 17387.75, "timestamp": "04:49:47", "text": "君たちは最高だ。私はしません"}, {"type": "subtitle", "time": 17390.31, "timestamp": "04:49:50", "text": "それが欲しい。うん。"}, {"type": "subtitle", "time": 17392.788, "timestamp": "04:49:52", "text": "やあ、ジョッキー、元気かい？私は"}]
[{"type": "subtitle", "time": 14469.91, "timestamp": "04:01:09", "text": "私の息子。えっと、こんにちは。"}, {"type": "subtitle", "time": 14473.59, "timestamp": "04:01:13", "text": "私に従ってください。やらなければならない仕事がある。"}, {"type": "subtitle", "time": 14475.83, "timestamp": "04:01:15", "text": "本気ですか？"}, {"type": "subtitle", "time": 14478.59, "timestamp": "04:01:18", "text": "そんなにたくさん必要ないよ。"}, {"type": "subtitle", "time": 14481.429, "timestamp": "04:01:21", "text": "[拍手]"}, {"type": "subtitle", "time": 14483.67, "timestamp": "04:01:23", "text": "おお、"}, {"type": "subtitle", "time": 14488.15, "timestamp": "04:01:28", "text": "わかった。わかった。さあ、行くぞ。ああ、そうなった。"}, {"type": "subtitle", "time": 14490.55, "timestamp": "04:01:30", "text": "いいえ。"}, {"type": "subtitle", "time": 14492.389, "timestamp": "04:01:32", "text": "あなたが知っている"}, {"type": "subtitle", "time": 14494.95, "timestamp": "04:01:34", "text": "なぜただそこに立っているだけなのか？ほら、私は"}, {"type": "subtitle", "time": 14497.91, "timestamp": "04:01:37", "text": "全員殺せたかもしれないけど、私は"}, {"type": "subtitle", "time": 14505.03, "timestamp": "04:01:45", "text": "何てことだ。"}, {"type": "subtitle", "time": 14507.349, "timestamp": "04:01:47", "text": "それで、実際の生活はどうですか？ここはいいところだよ、"}, {"type": "subtitle", "time": 14510.71, "timestamp": "04:01:50", "text": "そうじゃない？私はそこで誰も殺していない。私"}, {"type": "subtitle", "time": 14513.269, "timestamp": "04:01:53", "text": "勝つために偽のタスクを行っていた"}, {"type": "subtitle", "time": 14515.03, "timestamp": "04:01:55", "text": "デフォルト。"}, {"type": "subtitle", "time": 14518.229, "timestamp": "04:01:58", "text": "全員殺すだけだ。"}]
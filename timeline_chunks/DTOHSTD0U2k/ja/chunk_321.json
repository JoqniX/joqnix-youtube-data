[{"type": "subtitle", "time": 19260.39, "timestamp": "05:21:00", "text": "私たちと一緒にいたのは彼だけだった。"}, {"type": "subtitle", "time": 19262.15, "timestamp": "05:21:02", "text": "わかった。"}, {"type": "subtitle", "time": 19267.59, "timestamp": "05:21:07", "text": "こんにちは。左側にあります。すべて"}, {"type": "subtitle", "time": 19270.47, "timestamp": "05:21:10", "text": "左側。右。よし。"}, {"type": "subtitle", "time": 19275.19, "timestamp": "05:21:15", "text": "一緒に行きましょう。こんにちは。私たちは"}, {"type": "subtitle", "time": 19276.788, "timestamp": "05:21:16", "text": "再読み込み中。"}, {"type": "subtitle", "time": 19279.27, "timestamp": "05:21:19", "text": "何？"}, {"type": "subtitle", "time": 19282.23, "timestamp": "05:21:22", "text": "殺すってどういう意味？わかった。"}, {"type": "subtitle", "time": 19284.948, "timestamp": "05:21:24", "text": "何てことだ。彼はそうではない。彼はそうではない。彼はそうではない"}, {"type": "subtitle", "time": 19291.67, "timestamp": "05:21:31", "text": "あなたたちのうちの一人。あなたたちのうちの一人。まあ。私はできません"}, {"type": "subtitle", "time": 19293.99, "timestamp": "05:21:33", "text": "誰でも殺せ。"}, {"type": "subtitle", "time": 19295.67, "timestamp": "05:21:35", "text": "待って、３回やらなきゃ"}, {"type": "subtitle", "time": 19297.11, "timestamp": "05:21:37", "text": "誰かを殺す前に。私はしたい 私はしたい"}, {"type": "subtitle", "time": 19300.55, "timestamp": "05:21:40", "text": "私の３つをやるために。ああ、神様。"}, {"type": "subtitle", "time": 19315.75, "timestamp": "05:21:55", "text": "ええと、お二人とも殺人鬼ですね。何？"}, {"type": "subtitle", "time": 19319.51, "timestamp": "05:21:59", "text": "何？キュウキに何が起こったの？いいえ。"}]
[{"type": "subtitle", "time": 2580.53, "timestamp": "00:43:00", "text": "失礼します。"}, {"type": "subtitle", "time": 2582.39, "timestamp": "00:43:02", "text": "[拍手]"}, {"type": "subtitle", "time": 2586.069, "timestamp": "00:43:06", "text": "ここは少し寒くなってきた。私たちはできますか"}, {"type": "subtitle", "time": 2588.79, "timestamp": "00:43:08", "text": "もう戻るべきか？"}, {"type": "subtitle", "time": 2596.95, "timestamp": "00:43:16", "text": "ごめんね、ロー。居心地が悪かった"}, {"type": "subtitle", "time": 2599.99, "timestamp": "00:43:19", "text": "あそこだ。ほとんどが保護する。空気は"}, {"type": "subtitle", "time": 2603.03, "timestamp": "00:43:23", "text": "その場所では風もなく重く"}, {"type": "subtitle", "time": 2606.15, "timestamp": "00:43:26", "text": "話題に上る。でも彼女は"}, {"type": "subtitle", "time": 2609.109, "timestamp": "00:43:29", "text": "実際はゲームです。そして、切実な叫び声"}, {"type": "subtitle", "time": 2610.63, "timestamp": "00:43:30", "text": "ヘルプ。"}, {"type": "subtitle", "time": 2615.03, "timestamp": "00:43:35", "text": "村人たちに感謝します"}, {"type": "subtitle", "time": 2617.829, "timestamp": "00:43:37", "text": "様々な感情が入り混じり、"}, {"type": "subtitle", "time": 2621.349, "timestamp": "00:43:41", "text": "恨みと絶望。"}, {"type": "subtitle", "time": 2623.589, "timestamp": "00:43:43", "text": "そして私が読んでいると、"}, {"type": "subtitle", "time": 2626.069, "timestamp": "00:43:46", "text": "私は激しい悲しみを明かすことができ、"}, {"type": "subtitle", "time": 2628.309, "timestamp": "00:43:48", "text": "持ち主の切望とは、"}, {"type": "subtitle", "time": 2631.43, "timestamp": "00:43:51", "text": "日記の持ち主が切望していたもの？"}, {"type": "subtitle", "time": 2634.79, "timestamp": "00:43:54", "text": "それは、彼女がかつて送っていた平和な生活のことだったのだろうか？"}, {"type": "subtitle", "time": 2638.39, "timestamp": "00:43:58", "text": "それとも、彼女は唯一の家族を恋しく思っていたのだろうか？の"}]
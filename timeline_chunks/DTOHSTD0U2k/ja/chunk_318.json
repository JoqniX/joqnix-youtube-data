[{"type": "subtitle", "time": 19108.47, "timestamp": "05:18:28", "text": "わかった？"}, {"type": "subtitle", "time": 19112.31, "timestamp": "05:18:32", "text": "ここに来て。ええ、怖いです。わかった。私は"}, {"type": "subtitle", "time": 19114.55, "timestamp": "05:18:34", "text": "怖い"}, {"type": "subtitle", "time": 19116.628, "timestamp": "05:18:36", "text": "誰かにはまだアリバイがある。所有"}, {"type": "subtitle", "time": 19121.27, "timestamp": "05:18:41", "text": "の上。私たちは皆、アリバイになれるのだろうか？"}, {"type": "subtitle", "time": 19122.948, "timestamp": "05:18:42", "text": "私たちは互いのアリバイになり得る。パワー"}, {"type": "subtitle", "time": 19124.31, "timestamp": "05:18:44", "text": "友情について。私たちはお互いの"}, {"type": "subtitle", "time": 19128.39, "timestamp": "05:18:48", "text": "アリバイ。僕たちなら勝てるよ、みんな。"}, {"type": "subtitle", "time": 19130.788, "timestamp": "05:18:50", "text": "固まらないようにしましょう、"}, {"type": "subtitle", "time": 19133.67, "timestamp": "05:18:53", "text": "知る。友情の力は本物だ。おお、"}, {"type": "subtitle", "time": 19136.868, "timestamp": "05:18:56", "text": "ところで、皆さん、私は兵士です。だから何？"}, {"type": "subtitle", "time": 19138.788, "timestamp": "05:18:58", "text": "ええ、もう自分の役柄は話していますよ。私は"}]
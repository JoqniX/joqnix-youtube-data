[{"type": "subtitle", "time": 18379.19, "timestamp": "05:06:19", "text": "くそ。分かっていた、分かっていた。え、何？"}, {"type": "subtitle", "time": 18384.07, "timestamp": "05:06:24", "text": "くたばれ。いや、そうだったのだろうか？え、どうやって？待って、"}, {"type": "subtitle", "time": 18385.43, "timestamp": "05:06:25", "text": "持続する。私はすでに"}, {"type": "subtitle", "time": 18387.43, "timestamp": "05:06:27", "text": "感染した。何？"}, {"type": "subtitle", "time": 18388.788, "timestamp": "05:06:28", "text": "うん。いいえ、私はあなたに感染させていません。なぜ"}, {"type": "subtitle", "time": 18391.59, "timestamp": "05:06:31", "text": "そんな風に触ってくるの？ああ、わかりました。"}, {"type": "subtitle", "time": 18394.07, "timestamp": "05:06:34", "text": "俺はもう感染してたって分かってたよ、兄弟。彼"}, {"type": "subtitle", "time": 18395.75, "timestamp": "05:06:35", "text": "彼は「みんな、僕はできない」と言った"}, {"type": "subtitle", "time": 18397.99, "timestamp": "05:06:37", "text": "動く。動けません。無理だよ、みんな。私"}, {"type": "subtitle", "time": 18404.23, "timestamp": "05:06:44", "text": "「みんな、私の近くに来てください。」ああ、それ"}, {"type": "subtitle", "time": 18405.99, "timestamp": "05:06:45", "text": "完璧だった。"}, {"type": "subtitle", "time": 18408.07, "timestamp": "05:06:48", "text": "授業が終わった後、"}, {"type": "subtitle", "time": 18409.99, "timestamp": "05:06:49", "text": "兵士になった後、私は殺したかった"}, {"type": "subtitle", "time": 18412.23, "timestamp": "05:06:52", "text": "誰か、でも私が知っていたのは吉野と"}, {"type": "subtitle", "time": 18416.31, "timestamp": "05:06:56", "text": "スミ、私は彼らを殺したくなかった。"}, {"type": "subtitle", "time": 18418.628, "timestamp": "05:06:58", "text": "私は本当に幸運だった。私はただ殺したかった"}]
[{"type": "subtitle", "time": 12121.269, "timestamp": "03:22:01", "text": "の上。"}, {"type": "subtitle", "time": 12123.91, "timestamp": "03:22:03", "text": "なんてこった。何てことだ。私だけでしょうか"}, {"type": "subtitle", "time": 12126.15, "timestamp": "03:22:06", "text": "名前はキムですか？"}, {"type": "subtitle", "time": 12128.79, "timestamp": "03:22:08", "text": "もしそれがただの私ではないとしたら、"}, {"type": "subtitle", "time": 12131.03, "timestamp": "03:22:11", "text": "それを覚えておいてください。"}, {"type": "subtitle", "time": 12146.79, "timestamp": "03:22:26", "text": "ねえ、役割を確認しますか？私は"}, {"type": "subtitle", "time": 12149.269, "timestamp": "03:22:29", "text": "私は探偵です。それで"}, {"type": "subtitle", "time": 12152.55, "timestamp": "03:22:32", "text": "何？ああ、探偵って何？探偵。"}, {"type": "subtitle", "time": 12173.59, "timestamp": "03:22:53", "text": "私と一緒に。私は怖かった。"}, {"type": "subtitle", "time": 12176.95, "timestamp": "03:22:56", "text": "皮肉なことに、私はこう言っていた"}, {"type": "subtitle", "time": 12179.83, "timestamp": "03:22:59", "text": "誰かがそれをどうやって"}]
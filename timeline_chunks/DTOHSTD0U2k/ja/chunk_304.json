[{"type": "subtitle", "time": 18246.868, "timestamp": "05:04:06", "text": "やりたいことがあります 私たちは"}, {"type": "subtitle", "time": 18248.07, "timestamp": "05:04:08", "text": "ふざけすぎている。私たちは"}, {"type": "subtitle", "time": 18249.43, "timestamp": "05:04:09", "text": "ふざけすぎている。たぶん私たちは"}, {"type": "subtitle", "time": 18252.07, "timestamp": "05:04:12", "text": "ちょっと落ち着いてよ。うん。何？"}, {"type": "subtitle", "time": 18255.35, "timestamp": "05:04:15", "text": "でも、もしその男が私たちに感染させたらどうなるの？待って、"}, {"type": "subtitle", "time": 18262.948, "timestamp": "05:04:22", "text": "まあ、そうかもしれないね。なんてこった。わかった。私はこう思った。"}, {"type": "subtitle", "time": 18265.67, "timestamp": "05:04:25", "text": "これ、大嫌い。こんなのマジで嫌いだよ。"}, {"type": "subtitle", "time": 18267.67, "timestamp": "05:04:27", "text": "大丈夫ですか？"}, {"type": "subtitle", "time": 18269.91, "timestamp": "05:04:29", "text": "私はこれが嫌いだ。私はいつも私はいつも"}, {"type": "subtitle", "time": 18283.27, "timestamp": "05:04:43", "text": "私を怖がらせないで。私は怖いです。"}, {"type": "subtitle", "time": 18285.11, "timestamp": "05:04:45", "text": "団結しよう。"}, {"type": "subtitle", "time": 18286.708, "timestamp": "05:04:46", "text": "いや、いや、いや。くたばれ。あなたではない。私はただ"}, {"type": "subtitle", "time": 18289.27, "timestamp": "05:04:49", "text": "ウィローが欲しい。"}, {"type": "subtitle", "time": 18291.35, "timestamp": "05:04:51", "text": "近すぎる。近すぎる。近すぎる。ああ、"}, {"type": "subtitle", "time": 18294.47, "timestamp": "05:04:54", "text": "神。亡くなった人がいた"}]
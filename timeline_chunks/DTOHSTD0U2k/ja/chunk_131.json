[{"type": "subtitle", "time": 7864.95, "timestamp": "02:11:04", "text": "闇が訪れる。何？誰が？はぁ？誰が？"}, {"type": "subtitle", "time": 7866.55, "timestamp": "02:11:06", "text": "はぁ？"}, {"type": "subtitle", "time": 7869.27, "timestamp": "02:11:09", "text": "何？"}, {"type": "subtitle", "time": 7871.109, "timestamp": "02:11:11", "text": "大丈夫。大丈夫。大丈夫。それは"}, {"type": "subtitle", "time": 7872.95, "timestamp": "02:11:12", "text": "あちらへ行けます。また戻ってきます。その"}, {"type": "subtitle", "time": 7898.47, "timestamp": "02:11:38", "text": "音と一体となる。パーティーはやめろよ。"}, {"type": "subtitle", "time": 7901.589, "timestamp": "02:11:41", "text": "まるで最後の蘇生のように。"}, {"type": "subtitle", "time": 7904.55, "timestamp": "02:11:44", "text": "変化を受け入れる。"}]
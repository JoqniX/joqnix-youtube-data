[{"type": "subtitle", "time": 19443.99, "timestamp": "05:24:03", "text": "私は思った"}, {"type": "subtitle", "time": 19446.788, "timestamp": "05:24:06", "text": "私はすごく暑い。あなたはそれを知っていたからやったんだ"}, {"type": "subtitle", "time": 19453.67, "timestamp": "05:24:13", "text": "まさにそこです。君のためなら負けても構わなかった。"}, {"type": "subtitle", "time": 19457.03, "timestamp": "05:24:17", "text": "ジャック・ニクソンはあなたの目の前にいた。そうだった"}, {"type": "subtitle", "time": 19463.83, "timestamp": "05:24:23", "text": "あなたは身を守ることができたはずです。私"}, {"type": "subtitle", "time": 19466.27, "timestamp": "05:24:26", "text": "何も言わないだろう。"}, {"type": "subtitle", "time": 19468.31, "timestamp": "05:24:28", "text": "[音楽]"}, {"type": "subtitle", "time": 19471.1, "timestamp": "05:24:31", "text": "なぜ難しいのか"}, {"type": "subtitle", "time": 19472.39, "timestamp": "05:24:32", "text": "[音楽]"}, {"type": "subtitle", "time": 19480.31, "timestamp": "05:24:40", "text": "ここに来て。あなたと話したいことがあります。来る"}, {"type": "subtitle", "time": 19484.31, "timestamp": "05:24:44", "text": "ここ。あなたと話したいことがあります。"}, {"type": "subtitle", "time": 19488.948, "timestamp": "05:24:48", "text": "とても良い。ヨシ。私にとって。わかった。あなたが知っている"}, {"type": "subtitle", "time": 19491.59, "timestamp": "05:24:51", "text": "キルは保安官だったんだよね？あなた"}, {"type": "subtitle", "time": 19494.868, "timestamp": "05:24:54", "text": "知っていた。私は知りませんでした。知りませんでした。"}, {"type": "subtitle", "time": 19497.43, "timestamp": "05:24:57", "text": "あなたは彼女が友人を撃つのを目撃した。いいえ、彼らは"}]
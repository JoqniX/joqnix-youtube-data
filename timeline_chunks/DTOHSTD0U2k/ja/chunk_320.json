[{"type": "subtitle", "time": 19204.23, "timestamp": "05:20:04", "text": "彼らは疑っていたからだ。何？"}, {"type": "subtitle", "time": 19207.99, "timestamp": "05:20:07", "text": "兵士。まずは私から始めましょう。ほら、言ったでしょ"}, {"type": "subtitle", "time": 19213.59, "timestamp": "05:20:13", "text": "私は兵士です。私は悪者だ。"}, {"type": "subtitle", "time": 19217.19, "timestamp": "05:20:17", "text": "バットマン。わかった。わかった。アトランテ。うん。なぜ"}, {"type": "subtitle", "time": 19219.67, "timestamp": "05:20:19", "text": "私たちは皆、お互いに投票し合っているんじゃないの？みんな"}, {"type": "subtitle", "time": 19222.948, "timestamp": "05:20:22", "text": "食べる。二人ともスキップする"}, {"type": "subtitle", "time": 19225.91, "timestamp": "05:20:25", "text": "もし私たちが一人を落選させなければ。つまり、私たちは"}, {"type": "subtitle", "time": 19228.47, "timestamp": "05:20:28", "text": "ルイ、僕たちが勝ったんだ。 5つ手に入れました。"}, {"type": "subtitle", "time": 19231.99, "timestamp": "05:20:31", "text": "ああ、そうかい。うん。 M 私は実際にはそう思っていません"}, {"type": "subtitle", "time": 19234.23, "timestamp": "05:20:34", "text": "クリアがまだ死んでるかどうか知りたい"}, {"type": "subtitle", "time": 19235.91, "timestamp": "05:20:35", "text": "ない。"}, {"type": "subtitle", "time": 19237.99, "timestamp": "05:20:37", "text": "ええ、でも私たち5人しかいないんです"}, {"type": "subtitle", "time": 19240.708, "timestamp": "05:20:40", "text": "左、右？私はスキップします。"}, {"type": "subtitle", "time": 19244.07, "timestamp": "05:20:44", "text": "うん、私も欠席するよ。"}, {"type": "subtitle", "time": 19246.868, "timestamp": "05:20:46", "text": "私は欠席します。君は死ぬだろう。私は私は"}, {"type": "subtitle", "time": 19248.708, "timestamp": "05:20:48", "text": "疑っている。"}, {"type": "subtitle", "time": 19251.43, "timestamp": "05:20:51", "text": "私はウィローを疑っている。"}, {"type": "subtitle", "time": 19255.35, "timestamp": "05:20:55", "text": "もちろんそうだよ。私はウィローを疑っている。"}, {"type": "subtitle", "time": 19257.67, "timestamp": "05:20:57", "text": "ウィローだけが私たちと一緒にいた。柳"}]
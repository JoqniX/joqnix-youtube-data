[{"type": "subtitle", "time": 302.15, "timestamp": "00:05:02", "text": "それは、あなたがどれほど脆いかを考えると理にかなっています"}, {"type": "subtitle", "time": 304.07, "timestamp": "00:05:04", "text": "あなたが目を覚ました時、私は"}, {"type": "subtitle", "time": 305.67, "timestamp": "00:05:05", "text": "それらの信憑性に疑問を呈した"}, {"type": "subtitle", "time": 307.73, "timestamp": "00:05:07", "text": "噂。"}, {"type": "subtitle", "time": 309.99, "timestamp": "00:05:09", "text": "[音楽]"}, {"type": "subtitle", "time": 312.31, "timestamp": "00:05:12", "text": "あなたは私についてきた。"}, {"type": "subtitle", "time": 317.43, "timestamp": "00:05:17", "text": "つまり、あなたは気づいたんですね。ああ、光栄です。"}, {"type": "subtitle", "time": 320.71, "timestamp": "00:05:20", "text": "ストーカーは神経質になっている。ここまで来れば、あなたは"}, {"type": "subtitle", "time": 327.749, "timestamp": "00:05:27", "text": "[音楽]"}, {"type": "subtitle", "time": 330.71, "timestamp": "00:05:30", "text": "しかし、傍観者の中で、"}, {"type": "subtitle", "time": 333.029, "timestamp": "00:05:33", "text": "名乗り出たのは私だけです"}, {"type": "subtitle", "time": 337.029, "timestamp": "00:05:37", "text": "あなたに心から正直にお会いします。前に"}, {"type": "subtitle", "time": 339.99, "timestamp": "00:05:39", "text": "この世界について何か知っていたら、"}, {"type": "subtitle", "time": 347.59000000000003, "timestamp": "00:05:47", "text": "あなたは私たちが未知数だ"}, {"type": "subtitle", "time": 349.51, "timestamp": "00:05:49", "text": "待っている。"}, {"type": "subtitle", "time": 352.15, "timestamp": "00:05:52", "text": "勢力は所有権を巡って争っている"}, {"type": "subtitle", "time": 355.27, "timestamp": "00:05:55", "text": "あなたを越えて。開封した瞬間から"}, {"type": "subtitle", "time": 357.59000000000003, "timestamp": "00:05:57", "text": "あなたの目、あなたが出会ったすべての人、"}, {"type": "subtitle", "time": 359.99, "timestamp": "00:05:59", "text": "あなたがとても大切に思っているあの女の子も含めて"}]
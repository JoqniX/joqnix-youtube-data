[{"type": "subtitle", "time": 14760.55, "timestamp": "04:06:00", "text": "悲鳴が聞こえた。ハンハン。いいえ、私は"}, {"type": "subtitle", "time": 14762.229, "timestamp": "04:06:02", "text": "死んだ。だから私はあなたを尾行していたんです。ああ、君"}, {"type": "subtitle", "time": 14764.469, "timestamp": "04:06:04", "text": "ああ、あなたも死んでいたんですね。ええ、でも"}, {"type": "subtitle", "time": 14766.07, "timestamp": "04:06:06", "text": "あなたについてきていた2人は"}, {"type": "subtitle", "time": 14770.389, "timestamp": "04:06:10", "text": "もう一人の殺人犯。ああ、そういうことか。"}, {"type": "subtitle", "time": 14772.229, "timestamp": "04:06:12", "text": "くそ、逃げ出した。ええ、ぜひ会いに来てください。"}, {"type": "subtitle", "time": 14779.91, "timestamp": "04:06:19", "text": "この栄誉は私の家族にもたらしたものです。"}, {"type": "subtitle", "time": 14782.55, "timestamp": "04:06:22", "text": "わかった。おお、いいね。ニース。あのね？私"}, {"type": "subtitle", "time": 14785.59, "timestamp": "04:06:25", "text": "まるで、「ねえ、"}, {"type": "subtitle", "time": 14789.269, "timestamp": "04:06:29", "text": "何？何を始めるんですか？ジョーカー、準備はいいか。"}, {"type": "subtitle", "time": 14794.95, "timestamp": "04:06:34", "text": "私は殺した。"}, {"type": "subtitle", "time": 14798.63, "timestamp": "04:06:38", "text": "私は幸せです。私は正しい人物を殺した。あなた"}, {"type": "subtitle", "time": 14800.07, "timestamp": "04:06:40", "text": "理由がわかりますか？だって私は最初の人だったから"}, {"type": "subtitle", "time": 14801.91, "timestamp": "04:06:41", "text": "見かけた人を殺して"}, {"type": "subtitle", "time": 14804.63, "timestamp": "04:06:44", "text": "あなたはただ現れただけだった。"}, {"type": "subtitle", "time": 14807.189, "timestamp": "04:06:47", "text": "みんな、私は幸せだよ。"}, {"type": "subtitle", "time": 14808.79, "timestamp": "04:06:48", "text": "謝る必要はないよ。うん。うん。うん。しかし"}, {"type": "subtitle", "time": 14811.83, "timestamp": "04:06:51", "text": "私は幸せです。いい狩りだった。"}, {"type": "subtitle", "time": 14814.229, "timestamp": "04:06:54", "text": "それは良かった"}]
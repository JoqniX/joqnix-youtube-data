[{"type": "subtitle", "time": 10569.269, "timestamp": "02:56:09", "text": "いや、聞こえるか？私は私が"}, {"type": "subtitle", "time": 10572.23, "timestamp": "02:56:12", "text": "あれみたいに。"}, {"type": "subtitle", "time": 10575.51, "timestamp": "02:56:15", "text": "おお。はぁ？"}, {"type": "subtitle", "time": 10579.83, "timestamp": "02:56:19", "text": "触れてみましょう。何？何？はぁ？触る。誰が"}, {"type": "subtitle", "time": 10582.15, "timestamp": "02:56:22", "text": "私たちは触れ合っていますか？彼らは"}, {"type": "subtitle", "time": 10585.429, "timestamp": "02:56:25", "text": "間接的。私はそこへ行きます。"}, {"type": "subtitle", "time": 10587.83, "timestamp": "02:56:27", "text": "あなたの耳は色が濃いですね。待って、何？"}, {"type": "subtitle", "time": 10594.63, "timestamp": "02:56:34", "text": "ショックはあまりにも無自覚だ。"}, {"type": "subtitle", "time": 10598.309, "timestamp": "02:56:38", "text": "私はタブ派です。ごめん。"}, {"type": "subtitle", "time": 10601.91, "timestamp": "02:56:41", "text": "「私と一緒に紙幣に触れてみて」と私は言った。ああ、それは"}, {"type": "subtitle", "time": 10606.71, "timestamp": "02:56:46", "text": "待って、それが理由だったのか。なんてこった。"}, {"type": "subtitle", "time": 10608.87, "timestamp": "02:56:48", "text": "よし、これでいい。感動していただきありがとうございます"}, {"type": "subtitle", "time": 10612.71, "timestamp": "02:56:52", "text": "請求書は私と一緒に持っています。私はそれを待っていた。"}, {"type": "subtitle", "time": 10616.23, "timestamp": "02:56:56", "text": "私はここにいます。ああ、こんにちは。こんにちは。"}]
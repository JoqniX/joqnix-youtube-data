[{"type": "subtitle", "time": 10321.429, "timestamp": "02:52:01", "text": "ミュートします"}, {"type": "subtitle", "time": 10334.55, "timestamp": "02:52:14", "text": "ああ、なんてことだ、私はその店は要らない。うん、"}, {"type": "subtitle", "time": 10336.95, "timestamp": "02:52:16", "text": "私たちはロビーで待っているだけです。はい、私たちは"}, {"type": "subtitle", "time": 10339.75, "timestamp": "02:52:19", "text": "皆、ただ待っているだけだ。"}, {"type": "subtitle", "time": 10341.11, "timestamp": "02:52:21", "text": "ゲームがほぼそうならないことを願います"}, {"type": "subtitle", "time": 10343.269, "timestamp": "02:52:23", "text": "Among のように時間がかかりすぎたので、私たちを蹴ってください"}, {"type": "subtitle", "time": 10348.309, "timestamp": "02:52:28", "text": "私たち。話を推し進めてください"}, {"type": "subtitle", "time": 10350.309, "timestamp": "02:52:30", "text": "Discordで議論を始めてもいいですか？"}, {"type": "subtitle", "time": 10354.15, "timestamp": "02:52:34", "text": "ゲームの代わりに？うん。ええ、もしあなたが"}, {"type": "subtitle", "time": 10357.99, "timestamp": "02:52:37", "text": "そうしたい。ええ、私には"}, {"type": "subtitle", "time": 10362.32, "timestamp": "02:52:42", "text": "私が使っているテクノロジーのようなもの。それでおしまい。"}, {"type": "subtitle", "time": 10363.99, "timestamp": "02:52:43", "text": "[音楽]"}, {"type": "subtitle", "time": 10367.429, "timestamp": "02:52:47", "text": "よお。よお。この人は誰ですか？"}, {"type": "subtitle", "time": 10371.11, "timestamp": "02:52:51", "text": "わからない。こんにちは。"}, {"type": "subtitle", "time": 10374.309, "timestamp": "02:52:54", "text": "謎めいた人物。"}, {"type": "subtitle", "time": 10376.23, "timestamp": "02:52:56", "text": "兄弟、私は慣れているが、"}]
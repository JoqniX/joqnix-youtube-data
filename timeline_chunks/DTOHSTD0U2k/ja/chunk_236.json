[{"type": "subtitle", "time": 14182.229, "timestamp": "03:56:22", "text": "ああ、私たちは礼拝堂の外にいます。底"}, {"type": "subtitle", "time": 14186.79, "timestamp": "03:56:26", "text": "左隅、右隅。ジョーは隣にいた"}, {"type": "subtitle", "time": 14192.79, "timestamp": "03:56:32", "text": "あのね？なんだか、なんだか匂いがする"}, {"type": "subtitle", "time": 14195.51, "timestamp": "03:56:35", "text": "自己申告みたいな感じだったんだけど、"}, {"type": "subtitle", "time": 14199.269, "timestamp": "03:56:39", "text": "「いや、いや。スミが入ってきたんだ。スミは"}, {"type": "subtitle", "time": 14201.91, "timestamp": "03:56:41", "text": "入ってくるところでした。文字通り入ろうとしていました。"}, {"type": "subtitle", "time": 14203.67, "timestamp": "03:56:43", "text": "誰かを捕まえるエリアは正しかった"}, {"type": "subtitle", "time": 14205.67, "timestamp": "03:56:45", "text": "そこには。うん。ええ、そうしましたよ。私は"}, {"type": "subtitle", "time": 14209.189, "timestamp": "03:56:49", "text": "ランプ。いや。ジョン、何をしているんだ？"}, {"type": "subtitle", "time": 14212.55, "timestamp": "03:56:52", "text": "私はランプの件をやっていました。私は"}, {"type": "subtitle", "time": 14214.63, "timestamp": "03:56:54", "text": "角にあるランプのようなものをやっている"}, {"type": "subtitle", "time": 14216.79, "timestamp": "03:56:56", "text": "門。それから私は降りてきた。君に会った"}, {"type": "subtitle", "time": 14218.95, "timestamp": "03:56:58", "text": "あなた。私たち二人とも遺体を見たし、あなたも"}]
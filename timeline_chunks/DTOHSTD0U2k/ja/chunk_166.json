[{"type": "subtitle", "time": 9961.349, "timestamp": "02:46:01", "text": "例えば、ゲーム内のVCを使うなど。あなたは持っていません"}, {"type": "subtitle", "time": 9966.15, "timestamp": "02:46:06", "text": "このVCに参加できて嬉しいです。いいえ"}, {"type": "subtitle", "time": 9973.51, "timestamp": "02:46:13", "text": "うわぁ。"}, {"type": "subtitle", "time": 9976.71, "timestamp": "02:46:16", "text": "スピードランニングをしていることが気に入っています"}, {"type": "subtitle", "time": 9981.11, "timestamp": "02:46:21", "text": "すべて。ツイートすらしていない。"}, {"type": "subtitle", "time": 9984.389, "timestamp": "02:46:24", "text": "何てことだ。"}, {"type": "subtitle", "time": 9987.67, "timestamp": "02:46:27", "text": "うん。さよなら。ツイートすらしていない。わかった、"}, {"type": "subtitle", "time": 9990.15, "timestamp": "02:46:30", "text": "ちょっとだけツイートさせてください。私は"}, {"type": "subtitle", "time": 9991.99, "timestamp": "02:46:31", "text": "ごめん。私はまだツイートもしていない"}, {"type": "subtitle", "time": 9996.23, "timestamp": "02:46:36", "text": "他のストリームも同様です。おお。"}, {"type": "subtitle", "time": 9998.71, "timestamp": "02:46:38", "text": "何てことだ。今日は何日でしたっけ？"}, {"type": "subtitle", "time": 10000.309, "timestamp": "02:46:40", "text": "このゲームが実際に動作することを恐れています"}, {"type": "subtitle", "time": 10005.19, "timestamp": "02:46:45", "text": "良い。ええと、今日の話題です。残念ながら、"}, {"type": "subtitle", "time": 10006.469, "timestamp": "02:46:46", "text": "直せるかどうか確認する必要がある"}, {"type": "subtitle", "time": 10008.07, "timestamp": "02:46:48", "text": "それ。もし私がそれを直せないなら、私は"}, {"type": "subtitle", "time": 10010.309, "timestamp": "02:46:50", "text": "参加できません。残念ながら、"}, {"type": "subtitle", "time": 10013.83, "timestamp": "02:46:53", "text": "私にとって。ええ、残念ながら。 RX、彼は"}, {"type": "subtitle", "time": 10015.99, "timestamp": "02:46:55", "text": "しばらくの間、この状況に陥っています"}, {"type": "subtitle", "time": 10017.83, "timestamp": "02:46:57", "text": "理由。なぜできないのかわかりません"}, {"type": "subtitle", "time": 10019.19, "timestamp": "02:46:59", "text": "ゲームは接続したくない"}]
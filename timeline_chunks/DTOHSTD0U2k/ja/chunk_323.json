[{"type": "subtitle", "time": 19383.59, "timestamp": "05:23:03", "text": "ああ、神様。えっと、待って。ご存知の通り、私たちは"}, {"type": "subtitle", "time": 19385.27, "timestamp": "05:23:05", "text": "負けるだろう。私たちは負けるだろう。私"}, {"type": "subtitle", "time": 19392.07, "timestamp": "05:23:12", "text": "つまり、私たち３人ともその点では殺人者だ"}, {"type": "subtitle", "time": 19401.11, "timestamp": "05:23:21", "text": "何てことだ。助けて。助けて。ああ、神様。"}, {"type": "subtitle", "time": 19431.43, "timestamp": "05:23:51", "text": "それは見ていない。ああ、私は彼が"}]
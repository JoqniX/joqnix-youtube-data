[{"type": "subtitle", "time": 13465.03, "timestamp": "03:44:25", "text": "何？私は残念ながら殺されました"}, {"type": "subtitle", "time": 13474.87, "timestamp": "03:44:34", "text": "待って、私じゃない。"}, {"type": "subtitle", "time": 13477.429, "timestamp": "03:44:37", "text": "Reは変身能力を持つ存在だ。彼は振り向いた"}, {"type": "subtitle", "time": 13480.15, "timestamp": "03:44:40", "text": "の中へ"}, {"type": "subtitle", "time": 13483.03, "timestamp": "03:44:43", "text": "何？彼は変身能力者だ。"}, {"type": "subtitle", "time": 13494.63, "timestamp": "03:44:54", "text": "私はそれが嫌いです。私はそれが嫌いです。"}, {"type": "subtitle", "time": 13497.99, "timestamp": "03:44:57", "text": "はい。はい。あなたはそうしました。誰も私を信用してくれなかった。私"}]
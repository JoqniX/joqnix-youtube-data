[{"type": "subtitle", "time": 11224.309, "timestamp": "03:07:04", "text": "フォローする。あちらへ行きなさい。あちらへ行きなさい。"}, {"type": "subtitle", "time": 11225.83, "timestamp": "03:07:05", "text": "フォローする"}, {"type": "subtitle", "time": 11226.87, "timestamp": "03:07:06", "text": "聞こえますか？待って。できますか できますか できますか できますか できますか できるか"}, {"type": "subtitle", "time": 11228.309, "timestamp": "03:07:08", "text": "聞こえますか？はい、聞こえていますよ。我々はできる"}, {"type": "subtitle", "time": 11229.91, "timestamp": "03:07:09", "text": "おっしゃることは分かります。"}, {"type": "subtitle", "time": 11232.15, "timestamp": "03:07:12", "text": "わかった。"}, {"type": "subtitle", "time": 11235.19, "timestamp": "03:07:15", "text": "実際にストリームを設定する必要がある"}, {"type": "subtitle", "time": 11236.79, "timestamp": "03:07:16", "text": "初め。だから、まあ、どうでもいいや。わかった。だって、"}, {"type": "subtitle", "time": 11240.55, "timestamp": "03:07:20", "text": "これをもう一度開く必要があるのは、"}, {"type": "subtitle", "time": 11242.95, "timestamp": "03:07:22", "text": "問題ない。"}, {"type": "subtitle", "time": 11254.71, "timestamp": "03:07:34", "text": "待って、ちょっと待って。なぜ私の声が聞こえないのですか？おお"}, {"type": "subtitle", "time": 11257.67, "timestamp": "03:07:37", "text": "くそ、あれは変だった。"}, {"type": "subtitle", "time": 11261.349, "timestamp": "03:07:41", "text": "私は味方を選ぶ。次はあなたの番だと思いますよ。"}, {"type": "subtitle", "time": 11278.23, "timestamp": "03:07:58", "text": "ちょっと待って。大きくなったね。取りに来てください"}]
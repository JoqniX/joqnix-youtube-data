[{"type": "subtitle", "time": 18923.91, "timestamp": "05:15:23", "text": "殺さない。私を殺さないで。席を外しています。よお、"}, {"type": "subtitle", "time": 18924.948, "timestamp": "05:15:24", "text": "どうしたの？どうしたの？どうしたの？いいえ、いいえ、"}, {"type": "subtitle", "time": 18927.67, "timestamp": "05:15:27", "text": "いいえ。私はそれを殺すつもりはない。"}, {"type": "subtitle", "time": 18930.47, "timestamp": "05:15:30", "text": "わかった。私のアリバイ。私はタスクのようにする"}, {"type": "subtitle", "time": 18936.23, "timestamp": "05:15:36", "text": "先に。わかった。こんにちは。ここに来て。"}, {"type": "subtitle", "time": 18938.31, "timestamp": "05:15:38", "text": "この作業は時間がかかりますよね？私はしません"}, {"type": "subtitle", "time": 18941.59, "timestamp": "05:15:41", "text": "怖がりたい。"}, {"type": "subtitle", "time": 18945.59, "timestamp": "05:15:45", "text": "わかった。わかった。行けるよ。私は終わった。したい"}, {"type": "subtitle", "time": 18947.51, "timestamp": "05:15:47", "text": "広場に行く？ああ、タスクがある"}, {"type": "subtitle", "time": 18951.11, "timestamp": "05:15:51", "text": "ここ。これをやってください。よし。"}, {"type": "subtitle", "time": 18952.708, "timestamp": "05:15:52", "text": "アリバイがあるといいよね。"}, {"type": "subtitle", "time": 18957.11, "timestamp": "05:15:57", "text": "こんにちは。どうしたの？私は"}]
[{"type": "subtitle", "time": 1382.07, "timestamp": "00:23:02", "text": "あなたが明らかにした真実とは何ですか？私"}, {"type": "subtitle", "time": 1385.59, "timestamp": "00:23:05", "text": "そこにいるタセットは誰が導いたのか考えてください"}, {"type": "subtitle", "time": 1388.549, "timestamp": "00:23:08", "text": "私たち"}, {"type": "subtitle", "time": 1390.789, "timestamp": "00:23:10", "text": "待って、それは実行されたから"}, {"type": "subtitle", "time": 1393.46, "timestamp": "00:23:13", "text": "羊の群れと羊飼いによって殺された。"}, {"type": "subtitle", "time": 1395.99, "timestamp": "00:23:15", "text": "[音楽]"}, {"type": "subtitle", "time": 1399.35, "timestamp": "00:23:19", "text": "どうすればいいですか？羊飼いは"}, {"type": "subtitle", "time": 1401.909, "timestamp": "00:23:21", "text": "命を犠牲にして願いを叶える"}, {"type": "subtitle", "time": 1403.75, "timestamp": "00:23:23", "text": "子羊の。"}, {"type": "subtitle", "time": 1405.83, "timestamp": "00:23:25", "text": "群れは真実を知ったが、"}, {"type": "subtitle", "time": 1408.07, "timestamp": "00:23:28", "text": "彼の共犯者となり、"}, {"type": "subtitle", "time": 1409.83, "timestamp": "00:23:29", "text": "喜んで黒い子羊を差し出した"}, {"type": "subtitle", "time": 1412.47, "timestamp": "00:23:32", "text": "もう一つの犠牲。"}, {"type": "subtitle", "time": 1414.42, "timestamp": "00:23:34", "text": "しかしそれは正しい"}, {"type": "subtitle", "time": 1421.669, "timestamp": "00:23:41", "text": "子羊たちは身を縮めて身を寄せ合っていた"}, {"type": "subtitle", "time": 1423.909, "timestamp": "00:23:43", "text": "彼らの村は"}, {"type": "subtitle", "time": 1427.909, "timestamp": "00:23:47", "text": "容赦ない狼の群れ"}, {"type": "subtitle", "time": 1430.95, "timestamp": "00:23:50", "text": "羊飼いが到着するまで"}, {"type": "subtitle", "time": 1434.789, "timestamp": "00:23:54", "text": "願いを叶える贈り物、シェルターの提供、そして"}]
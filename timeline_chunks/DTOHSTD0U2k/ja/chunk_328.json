[{"type": "subtitle", "time": 19684.31, "timestamp": "05:28:04", "text": "こんにちは。やあ、みんな。ああ、今はできるよ。くそ。"}, {"type": "subtitle", "time": 19686.628, "timestamp": "05:28:06", "text": "そうですね、私は"}, {"type": "subtitle", "time": 19690.47, "timestamp": "05:28:10", "text": "ああ、ベル。どこですか？"}, {"type": "subtitle", "time": 19693.03, "timestamp": "05:28:13", "text": "鐘はどこですか？わからない。おお、"}, {"type": "subtitle", "time": 19695.75, "timestamp": "05:28:15", "text": "ベルを拾ってください。牛かもしれない。"}, {"type": "subtitle", "time": 19698.15, "timestamp": "05:28:18", "text": "呼び方は何でもいい。チャペル。"}, {"type": "subtitle", "time": 19705.75, "timestamp": "05:28:25", "text": "ベルはどこですか？どこですか？どこで"}, {"type": "subtitle", "time": 19708.07, "timestamp": "05:28:28", "text": "ベルを拾わなければならないの？"}, {"type": "subtitle", "time": 19716.708, "timestamp": "05:28:36", "text": "よし、みんな、私の前には"}, {"type": "subtitle", "time": 19719.03, "timestamp": "05:28:39", "text": "間違いなく雨が降るよね？そして私は遅れている"}, {"type": "subtitle", "time": 19721.91, "timestamp": "05:28:41", "text": "私は礼拝堂エリアの下にいて、"}, {"type": "subtitle", "time": 19724.868, "timestamp": "05:28:44", "text": "墓地へ向かっている。それから私は彼を見た"}, {"type": "subtitle", "time": 19726.948, "timestamp": "05:28:46", "text": "自己申告による。彼は自ら申告した。私は"}, {"type": "subtitle", "time": 19729.11, "timestamp": "05:28:49", "text": "ごめん。間違いなく殺した、間違いなく"}, {"type": "subtitle", "time": 19731.91, "timestamp": "05:28:51", "text": "殺された。嘘をつくことはできない"}, {"type": "subtitle", "time": 19735.43, "timestamp": "05:28:55", "text": "あなたのやり方で。おお。"}, {"type": "subtitle", "time": 19738.23, "timestamp": "05:28:58", "text": "墓地。問題はここですよね？私は"}, {"type": "subtitle", "time": 19739.91, "timestamp": "05:28:59", "text": "ほとんどの場合、ウィローと一緒にいる。できました"}]
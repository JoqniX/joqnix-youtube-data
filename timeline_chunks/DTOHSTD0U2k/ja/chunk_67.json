[{"type": "subtitle", "time": 4022.71, "timestamp": "01:07:02", "text": "恐ろしいと感じるのは自然なことです"}, {"type": "subtitle", "time": 4025.99, "timestamp": "01:07:05", "text": "未知。しかし、"}, {"type": "subtitle", "time": 4028.63, "timestamp": "01:07:08", "text": "未知の中に希望が宿る。"}, {"type": "subtitle", "time": 4030.71, "timestamp": "01:07:10", "text": "他に何が起こるかわからないように"}, {"type": "subtitle", "time": 4036.789, "timestamp": "01:07:16", "text": "待って、これは、これは興味深いものではなく"}, {"type": "subtitle", "time": 4039.99, "timestamp": "01:07:19", "text": "赤ちゃん。文字通り何かを手に入れた"}, {"type": "subtitle", "time": 4041.91, "timestamp": "01:07:21", "text": "アプリから。"}, {"type": "subtitle", "time": 4045.75, "timestamp": "01:07:25", "text": "これはどのバージョンですか？"}, {"type": "subtitle", "time": 4055.45, "timestamp": "01:07:35", "text": "ジョージアには良いところは何もないのか？"}, {"type": "subtitle", "time": 4075.99, "timestamp": "01:07:55", "text": "[音楽]"}, {"type": "subtitle", "time": 4077.77, "timestamp": "01:07:57", "text": "こっちの方がいい。うん。"}]
[{"type": "subtitle", "time": 12363.429, "timestamp": "03:26:03", "text": "役割。いくつかの。わかった。だから私はIのような"}, {"type": "subtitle", "time": 12365.59, "timestamp": "03:26:05", "text": "鳩のようだった。私には全くわからない"}, {"type": "subtitle", "time": 12367.75, "timestamp": "03:26:07", "text": "ハトはそうするだろうか。私は「ああ、君」って感じだった"}, {"type": "subtitle", "time": 12370.309, "timestamp": "03:26:10", "text": "コロナウイルスをあげたように、"}, {"type": "subtitle", "time": 12372.389, "timestamp": "03:26:12", "text": "あなたはウイルスをばらまいていて、"}, {"type": "subtitle", "time": 12374.71, "timestamp": "03:26:14", "text": "全員に感染させれば、君の勝ちだ。ええ、そうです"}, {"type": "subtitle", "time": 12376.79, "timestamp": "03:26:16", "text": "本当に簡単だ。とても簡単なルールです。"}, {"type": "subtitle", "time": 12378.87, "timestamp": "03:26:18", "text": "そう、もしあなたがみんなに触れるなら"}, {"type": "subtitle", "time": 12381.75, "timestamp": "03:26:21", "text": "ゲーム。ええ、あなたはただみんなに触れるだけです"}, {"type": "subtitle", "time": 12392.95, "timestamp": "03:26:32", "text": "Smaxがここにいる。それはとても間違っている"}, {"type": "subtitle", "time": 12395.91, "timestamp": "03:26:35", "text": "けれど。ああ、あなたが好きな場所"}, {"type": "subtitle", "time": 12398.63, "timestamp": "03:26:38", "text": "そんなに人に触れるなんて、クリー？"}, {"type": "subtitle", "time": 12401.51, "timestamp": "03:26:41", "text": "ご存知だと思いますが、"}, {"type": "subtitle", "time": 12403.11, "timestamp": "03:26:43", "text": "クリー。信じられないよ。あなたは"}, {"type": "subtitle", "time": 12404.71, "timestamp": "03:26:44", "text": "タッチャー。"}, {"type": "subtitle", "time": 12407.59, "timestamp": "03:26:47", "text": "あなたは触れるのが上手ですね。なるほど。社会的距離"}, {"type": "subtitle", "time": 12410.07, "timestamp": "03:26:50", "text": "人生において、そういうこともあるよね。ほら、私は感動した"}, {"type": "subtitle", "time": 12413.83, "timestamp": "03:26:53", "text": "星。触れるだけでいいんです。うん。あなた"}, {"type": "subtitle", "time": 12416.71, "timestamp": "03:26:56", "text": "感動的なハグをしなければならなかった。私はほしくない"}, {"type": "subtitle", "time": 12418.79, "timestamp": "03:26:58", "text": "あなたは私の魂に触れた。前回あなたが"}, {"type": "subtitle", "time": 12419.83, "timestamp": "03:26:59", "text": "私の魂に触れた、あなたはそれを成し遂げた"}]
[{"type": "subtitle", "time": 18318.55, "timestamp": "05:05:18", "text": "こんにちは。始めるべきだと思いますか？"}, {"type": "subtitle", "time": 18320.23, "timestamp": "05:05:20", "text": "緊急会議でリセットする"}, {"type": "subtitle", "time": 18322.39, "timestamp": "05:05:22", "text": "ハトの進歩？"}, {"type": "subtitle", "time": 18325.59, "timestamp": "05:05:25", "text": "なぜハトなのか？えーと、ハトのリセットのために"}, {"type": "subtitle", "time": 18327.83, "timestamp": "05:05:27", "text": "進捗。うん。彼らの進歩は"}, {"type": "subtitle", "time": 18329.03, "timestamp": "05:05:29", "text": "リセット。"}, {"type": "subtitle", "time": 18330.31, "timestamp": "05:05:30", "text": "会議を開始していただけますか？待って、これは"}, {"type": "subtitle", "time": 18339.67, "timestamp": "05:05:39", "text": "動けません。ああ、これは役に立つ。こんにちは。"}, {"type": "subtitle", "time": 18343.19, "timestamp": "05:05:43", "text": "なぜミュートできないのですか？ヘルプ。動けません。"}, {"type": "subtitle", "time": 18346.55, "timestamp": "05:05:46", "text": "私を守ってください。私を守ってください。"}, {"type": "subtitle", "time": 18348.39, "timestamp": "05:05:48", "text": "どういう意味ですか？ああ、これでいい。そこには"}, {"type": "subtitle", "time": 18350.47, "timestamp": "05:05:50", "text": "行くぞ。"}, {"type": "subtitle", "time": 18352.31, "timestamp": "05:05:52", "text": "あの奇妙な怪物が私に触れて、私は"}, {"type": "subtitle", "time": 18355.83, "timestamp": "05:05:55", "text": "動けなかった。ああ、くすくす笑いが聞こえたよ。"}]
[{"type": "subtitle", "time": 10026.71, "timestamp": "02:47:06", "text": "ああ、そうだね。問題。"}, {"type": "subtitle", "time": 10029.75, "timestamp": "02:47:09", "text": "えっと、Discordで話してるんだけど"}, {"type": "subtitle", "time": 10031.91, "timestamp": "02:47:11", "text": "大丈夫。だから、何が"}, {"type": "subtitle", "time": 10033.429, "timestamp": "02:47:13", "text": "間違っている。私は"}, {"type": "subtitle", "time": 10035.99, "timestamp": "02:47:15", "text": "今すぐトラブルシューティングを行ってください。"}, {"type": "subtitle", "time": 10038.87, "timestamp": "02:47:18", "text": "うん。"}, {"type": "subtitle", "time": 10046.71, "timestamp": "02:47:26", "text": "わかった。非常に素晴らしい。"}, {"type": "subtitle", "time": 10050.389, "timestamp": "02:47:30", "text": "ああ、みんなエモートを使えるんですね。"}, {"type": "subtitle", "time": 10054.309, "timestamp": "02:47:34", "text": "それはどこですか？これでMC MCは終了です。ああ、そうだね。"}, {"type": "subtitle", "time": 10057.67, "timestamp": "02:47:37", "text": "マイクがオンになっていることに今気づきました"}, {"type": "subtitle", "time": 10060.389, "timestamp": "02:47:40", "text": "ゲーム内でも。何てことだ。"}, {"type": "subtitle", "time": 10062.469, "timestamp": "02:47:42", "text": "あなたがやる。"}, {"type": "subtitle", "time": 10066.469, "timestamp": "02:47:46", "text": "私は置き去りにされた。誰が残ったのか？"}, {"type": "subtitle", "time": 10069.91, "timestamp": "02:47:49", "text": "うん。あ、待って。"}, {"type": "subtitle", "time": 10072.71, "timestamp": "02:47:52", "text": "はい。いくつか素敵なスキンがありますね。これを手に入れた"}, {"type": "subtitle", "time": 10075.59, "timestamp": "02:47:55", "text": "素敵な小さなスカーフがここにあります"}, {"type": "subtitle", "time": 10077.67, "timestamp": "02:47:57", "text": "私が手に入れたのは、私が入れなかったものです"}]
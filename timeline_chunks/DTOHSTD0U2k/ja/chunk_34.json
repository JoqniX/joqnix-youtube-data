[{"type": "subtitle", "time": 2041.669, "timestamp": "00:34:01", "text": "そのことを忘れてはいけませんよ。"}, {"type": "subtitle", "time": 2043.75, "timestamp": "00:34:03", "text": "即興演奏でトラブルにならないように"}, {"type": "subtitle", "time": 2046.95, "timestamp": "00:34:06", "text": "その他。うわー、声優の演技がすごくかっこいい。"}, {"type": "subtitle", "time": 2049.589, "timestamp": "00:34:09", "text": "あなたが急いで駆けつけて守ろうとしているのを見てください"}, {"type": "subtitle", "time": 2054.069, "timestamp": "00:34:14", "text": "貴重で完璧な動き。心配ない。私"}, {"type": "subtitle", "time": 2056.71, "timestamp": "00:34:16", "text": "やっていいことといけないことをすべて把握しておく。私はしません"}, {"type": "subtitle", "time": 2059.909, "timestamp": "00:34:19", "text": "何をすべきか教えてください。"}, {"type": "subtitle", "time": 2063.03, "timestamp": "00:34:23", "text": "ローバー、私たちの幸せな小さなデートは"}, {"type": "subtitle", "time": 2065.669, "timestamp": "00:34:25", "text": "終わりを迎えなければならない。私たちはデートをした。"}, {"type": "subtitle", "time": 2069.03, "timestamp": "00:34:29", "text": "私の誠意は忘れてください。私のプレゼントはどこ？させて"}, {"type": "subtitle", "time": 2071.99, "timestamp": "00:34:31", "text": "あなたが何を選んだのか教えてください。予期せぬ"}, {"type": "subtitle", "time": 2074.629, "timestamp": "00:34:34", "text": "贈り物。あ、待って。"}, {"type": "subtitle", "time": 2076.55, "timestamp": "00:34:36", "text": "彼は"}, {"type": "subtitle", "time": 2079.129, "timestamp": "00:34:39", "text": "贈り物は私たちに選ばせてください。わかった。"}, {"type": "subtitle", "time": 2081.43, "timestamp": "00:34:41", "text": "[音楽]"}, {"type": "subtitle", "time": 2085.51, "timestamp": "00:34:45", "text": "選択はあなた次第です。私は賢いことを知っています"}, {"type": "subtitle", "time": 2088.069, "timestamp": "00:34:48", "text": "あなたは。急いではいけません"}, {"type": "subtitle", "time": 2091.51, "timestamp": "00:34:51", "text": "決断。またいつか会おう"}, {"type": "subtitle", "time": 2093.03, "timestamp": "00:34:53", "text": "あまりにも素晴らしい"}, {"type": "subtitle", "time": 2095.43, "timestamp": "00:34:55", "text": "未来。"}, {"type": "subtitle", "time": 2099.99, "timestamp": "00:34:59", "text": "彼らは去ってしまった。彼らを追撃すべきだろうか？"}]
[{"type": "subtitle", "time": 17282.788, "timestamp": "04:48:02", "text": "あなたが正しいなら。犬よ、それを私から奪ってやってくれ。"}, {"type": "subtitle", "time": 17284.948, "timestamp": "04:48:04", "text": "さあ、どうぞ。それは、ああ、くそ。私は"}, {"type": "subtitle", "time": 17287.27, "timestamp": "04:48:07", "text": "それ。"}, {"type": "subtitle", "time": 17307.99, "timestamp": "04:48:27", "text": "リーネ。"}, {"type": "subtitle", "time": 17311.03, "timestamp": "04:48:31", "text": "ああ、くそったれ。"}, {"type": "subtitle", "time": 17313.99, "timestamp": "04:48:33", "text": "わかった。こんにちは。"}, {"type": "subtitle", "time": 17317.35, "timestamp": "04:48:37", "text": "私を解放してもらえませんか？"}, {"type": "subtitle", "time": 17320.47, "timestamp": "04:48:40", "text": "お願いだから、私を解放してくれませんか？"}, {"type": "subtitle", "time": 17322.868, "timestamp": "04:48:42", "text": "あなたは私を無視した。"}, {"type": "subtitle", "time": 17327.67, "timestamp": "04:48:47", "text": "放してくれ。私を解放してください。"}, {"type": "subtitle", "time": 17330.23, "timestamp": "04:48:50", "text": "これは一体何だ？ベルを拾ってください。"}, {"type": "subtitle", "time": 17334.628, "timestamp": "04:48:54", "text": "ああ、彼女が私を食べたなんて信じられない。何"}]
[{"type": "subtitle", "time": 7264.4, "timestamp": "02:01:04", "text": "整流器。整流器兵器とは何ですか？"}, {"type": "subtitle", "time": 7266.31, "timestamp": "02:01:06", "text": "[音楽]"}, {"type": "subtitle", "time": 7270.47, "timestamp": "02:01:10", "text": "ああ、枯れていく"}, {"type": "subtitle", "time": 7276.07, "timestamp": "02:01:16", "text": "整流器。"}, {"type": "subtitle", "time": 7278.47, "timestamp": "02:01:18", "text": "整流器とは何ですか？"}, {"type": "subtitle", "time": 7280.629, "timestamp": "02:01:20", "text": "おお。おお。おお。おお。おお。おお。彼女はこういう人だ。"}, {"type": "subtitle", "time": 7283.51, "timestamp": "02:01:23", "text": "わかった。わかった。わかった。わかった。わかった。わかった。ああ、"}, {"type": "subtitle", "time": 7286.229, "timestamp": "02:01:26", "text": "それなら大丈夫です。いいえ、"}, {"type": "subtitle", "time": 7289.51, "timestamp": "02:01:29", "text": "実際、できるよ。"}, {"type": "subtitle", "time": 7293.03, "timestamp": "02:01:33", "text": "レベルアップしても構わないが、"}, {"type": "subtitle", "time": 7297.27, "timestamp": "02:01:37", "text": "レベルを上げすぎると、ね。"}, {"type": "subtitle", "time": 7299.75, "timestamp": "02:01:39", "text": "私の気持ち、分かりますか？うん。私はしたくない"}, {"type": "subtitle", "time": 7306.31, "timestamp": "02:01:46", "text": "えっと、"}, {"type": "subtitle", "time": 7317.109, "timestamp": "02:01:57", "text": "AOダメージ。私は彼女にもっと"}, {"type": "subtitle", "time": 7319.99, "timestamp": "02:01:59", "text": "攻撃ですよね？"}]
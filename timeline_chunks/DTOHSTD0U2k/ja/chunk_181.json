[{"type": "subtitle", "time": 10861.11, "timestamp": "03:01:01", "text": "行方不明者は誰ですか？ドラゴンは"}, {"type": "subtitle", "time": 10863.269, "timestamp": "03:01:03", "text": "ストリーム。私たちは何かを見落としていると思います"}, {"type": "subtitle", "time": 10867.11, "timestamp": "03:01:07", "text": "ロック好きの男。私は思う"}, {"type": "subtitle", "time": 10870.309, "timestamp": "03:01:10", "text": "ロク。彼の名前を忘れてしまった。ええ、そう思います。"}, {"type": "subtitle", "time": 10872.15, "timestamp": "03:01:12", "text": "うん。彼がそうするかどうかはわかりません"}, {"type": "subtitle", "time": 10874.23, "timestamp": "03:01:14", "text": "参加する。彼は今日は私のために演奏してくれなかった。彼"}, {"type": "subtitle", "time": 10881.51, "timestamp": "03:01:21", "text": "調整方法は？"}, {"type": "subtitle", "time": 10884.309, "timestamp": "03:01:24", "text": "大丈夫。始める。それでいいんです。その"}, {"type": "subtitle", "time": 10886.389, "timestamp": "03:01:26", "text": "わかった。大丈夫です。"}, {"type": "subtitle", "time": 10888.79, "timestamp": "03:01:28", "text": "オン・オン・ザ・オン・ザ・オンのように"}, {"type": "subtitle", "time": 10898.95, "timestamp": "03:01:38", "text": "前に出ましょう。あなたはそうする必要はありません"}, {"type": "subtitle", "time": 10902.469, "timestamp": "03:01:42", "text": "バスのところへ行ってください。わかった。いいえ。いいえ。私たちはあなたを持っています。"}, {"type": "subtitle", "time": 10905.349, "timestamp": "03:01:45", "text": "何だと思う？私は一歩引いて見守ります。"}, {"type": "subtitle", "time": 10908.79, "timestamp": "03:01:48", "text": "苦労は現実のものだ。待って、みんなオンになってる？"}, {"type": "subtitle", "time": 10911.83, "timestamp": "03:01:51", "text": "Twitchで配信してるの？それともYouTubeで配信してるの？"}, {"type": "subtitle", "time": 10913.429, "timestamp": "03:01:53", "text": "私はYouTubeをやっています。散らばっている。私は"}, {"type": "subtitle", "time": 10915.429, "timestamp": "03:01:55", "text": "YouTubeもそうだ。私たちのほとんどはYouTubeを利用しています。"}, {"type": "subtitle", "time": 10917.51, "timestamp": "03:01:57", "text": "ええ、ほとんどはYouTubeですが、いくつかは"}, {"type": "subtitle", "time": 10919.75, "timestamp": "03:01:59", "text": "今、Twitchで配信中です。すごくうるさいですね。"}]
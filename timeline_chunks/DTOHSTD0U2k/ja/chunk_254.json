[{"type": "subtitle", "time": 15249.51, "timestamp": "04:14:09", "text": "わかった。では、もしよろしければ、"}, {"type": "subtitle", "time": 15250.71, "timestamp": "04:14:10", "text": "目を見ると、2つあることがわかります"}, {"type": "subtitle", "time": 15253.03, "timestamp": "04:14:13", "text": "殺人犯ですよね？そして私は死神だと言った"}, {"type": "subtitle", "time": 15255.189, "timestamp": "04:14:15", "text": "テレンは殺人犯の一人であり、"}, {"type": "subtitle", "time": 15256.87, "timestamp": "04:14:16", "text": "つまり、桐生は"}, {"type": "subtitle", "time": 15258.71, "timestamp": "04:14:18", "text": "殺人犯ですよね？そしてそれはスミディかもしれない"}, {"type": "subtitle", "time": 15261.349, "timestamp": "04:14:21", "text": "そして彼女は実際にそのことを桐生のせいにした。"}, {"type": "subtitle", "time": 15265.59, "timestamp": "04:14:25", "text": "右？それはそうは思わない"}, {"type": "subtitle", "time": 15269.99, "timestamp": "04:14:29", "text": "彼女のアリバイとか、そういう類のもの。私は一緒に"}, {"type": "subtitle", "time": 15271.83, "timestamp": "04:14:31", "text": "彼女。その論理が理解できない。うん、君"}, {"type": "subtitle", "time": 15273.75, "timestamp": "04:14:33", "text": "彼女のそばを通り過ぎたんだよね？それは"}, {"type": "subtitle", "time": 15275.51, "timestamp": "04:14:35", "text": "私はブラジャーを着ています"}, {"type": "subtitle", "time": 15283.51, "timestamp": "04:14:43", "text": "彼は、もしあなたが親切に目を開けて"}, {"type": "subtitle", "time": 15285.75, "timestamp": "04:14:45", "text": "それから彼は彼女に電話をかけるんだ。"}, {"type": "subtitle", "time": 15287.83, "timestamp": "04:14:47", "text": "おいおい、優しくしてくれよ。出て行け。彼は言った"}, {"type": "subtitle", "time": 15289.75, "timestamp": "04:14:49", "text": "面白いと思ったら、彼に投票すればいい。ああ、私は"}, {"type": "subtitle", "time": 15292.55, "timestamp": "04:14:52", "text": "ただ約束通りにしているだけです。"}, {"type": "subtitle", "time": 15295.269, "timestamp": "04:14:55", "text": "ごめんなさい。"}, {"type": "subtitle", "time": 15297.429, "timestamp": "04:14:57", "text": "彼らの主張の方が説得力がある。優しくしてね、私の"}]
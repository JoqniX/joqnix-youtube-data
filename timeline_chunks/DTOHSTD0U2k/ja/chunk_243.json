[{"type": "subtitle", "time": 14581.99, "timestamp": "04:03:01", "text": "お願いだから、通報だけはしないで。"}, {"type": "subtitle", "time": 14586.79, "timestamp": "04:03:06", "text": "自分。テリー、何か言いたいことはある？"}, {"type": "subtitle", "time": 14591.83, "timestamp": "04:03:11", "text": "えっと、私は自分の仕事の一つをしていたのですが"}, {"type": "subtitle", "time": 14593.91, "timestamp": "04:03:13", "text": "シーン。ええ、私にはやるべきことがあります。良い"}, {"type": "subtitle", "time": 14597.99, "timestamp": "04:03:17", "text": "知る。ニース。"}, {"type": "subtitle", "time": 14600.389, "timestamp": "04:03:20", "text": "一緒にいられてよかった。"}, {"type": "subtitle", "time": 14602.63, "timestamp": "04:03:22", "text": "うん、よかったね。おお。すばらしい。なんてことだ"}, {"type": "subtitle", "time": 14613.91, "timestamp": "04:03:33", "text": "さあ行こう。もし"}, {"type": "subtitle", "time": 14616.55, "timestamp": "04:03:36", "text": "犯人は君たちのうちの一人だ。兄弟、私は"}, {"type": "subtitle", "time": 14621.99, "timestamp": "04:03:41", "text": "生存者。そうでないことを願います。そうでないことを願います。"}, {"type": "subtitle", "time": 14625.11, "timestamp": "04:03:45", "text": "私たちは勝ったのか？我々が勝っている。俺たちが勝ってる理由は"}, {"type": "subtitle", "time": 14627.94, "timestamp": "04:03:47", "text": "私は生きている。"}, {"type": "subtitle", "time": 14638.15, "timestamp": "04:03:58", "text": "あなたは私に嘘をついた。私はそれを知っていた。彼女が取ったように"}]
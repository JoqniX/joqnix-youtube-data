[{"type": "subtitle", "time": 4.07, "timestamp": "00:00:04", "text": "ティルダ・ビーズリー。わかった。"}, {"type": "subtitle", "time": 5.59, "timestamp": "00:00:05", "text": "わかった。だから、ここは私が"}, {"type": "subtitle", "time": 7.909, "timestamp": "00:00:07", "text": "指名手配。では、ちょっと待ってください、どこで"}, {"type": "subtitle", "time": 10.95, "timestamp": "00:00:10", "text": "彼女はどのようにして倒れるのですか？あ、待って。彼女"}, {"type": "subtitle", "time": 20.95, "timestamp": "00:00:20", "text": "高いところから目を離さない方がよさそうだ"}, {"type": "subtitle", "time": 24.23, "timestamp": "00:00:24", "text": "ゼノビアのゴブを求めて学校の周りをうろつく。"}, {"type": "subtitle", "time": 28.95, "timestamp": "00:00:28", "text": "ああ、ゴブストーンがこれでロックされる。"}, {"type": "subtitle", "time": 48.869, "timestamp": "00:00:48", "text": "ああ、ずっとここにあったのか。おお"}, {"type": "subtitle", "time": 55.189, "timestamp": "00:00:55", "text": "今、何をしているの？"}, {"type": "subtitle", "time": 57.67, "timestamp": "00:00:57", "text": "わからない。"}]
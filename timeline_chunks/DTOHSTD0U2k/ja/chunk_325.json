[{"type": "subtitle", "time": 19505.83, "timestamp": "05:25:05", "text": "そうすべきだった、"}, {"type": "subtitle", "time": 19507.35, "timestamp": "05:25:07", "text": "兄弟。私に何が起こったかはご存知でしょう、"}, {"type": "subtitle", "time": 19510.15, "timestamp": "05:25:10", "text": "みんな？"}, {"type": "subtitle", "time": 19511.75, "timestamp": "05:25:11", "text": "よくやった。よくやった。面白かったね。それ"}, {"type": "subtitle", "time": 19515.51, "timestamp": "05:25:15", "text": "面白かった。わかった。だから私は"}, {"type": "subtitle", "time": 19518.868, "timestamp": "05:25:18", "text": "ハンハンについてすごく怪しいと思うよ、みんな。欲しい"}, {"type": "subtitle", "time": 19521.75, "timestamp": "05:25:21", "text": "すぐに分かったので、私はとても"}, {"type": "subtitle", "time": 19524.39, "timestamp": "05:25:24", "text": "ハンハドについて怪しいと思ったので、ハンハン"}, {"type": "subtitle", "time": 19525.83, "timestamp": "05:25:25", "text": "私がそうすべきでない良い理由を教えてください"}, {"type": "subtitle", "time": 19527.99, "timestamp": "05:25:27", "text": "死ぬことはないはずだ。いいえ、彼は走り続けました"}, {"type": "subtitle", "time": 19529.99, "timestamp": "05:25:29", "text": "彼はクールダウンが必要なので、私から離れていく。"}, {"type": "subtitle", "time": 19532.31, "timestamp": "05:25:32", "text": "理由を教えてあげましょう。"}, {"type": "subtitle", "time": 19534.948, "timestamp": "05:25:34", "text": "あなたがaなら、あなたがbなら、私はそうではありません"}, {"type": "subtitle", "time": 19537.27, "timestamp": "05:25:37", "text": "お前を殺してやるぞ。その後"}, {"type": "subtitle", "time": 19539.99, "timestamp": "05:25:39", "text": "バン、彼はただ"}, {"type": "subtitle", "time": 19555.75, "timestamp": "05:25:55", "text": "注意を払わなければならない。"}, {"type": "subtitle", "time": 19557.75, "timestamp": "05:25:57", "text": "ところで、私が死んだらすぐに、"}]
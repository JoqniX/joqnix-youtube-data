[{"type": "subtitle", "time": 16261.03, "timestamp": "04:31:01", "text": "人々はあなたを信頼している。だからあなたが"}, {"type": "subtitle", "time": 16265.11, "timestamp": "04:31:05", "text": "殺人鬼だよ、わかるだろ。うん。"}, {"type": "subtitle", "time": 16266.389, "timestamp": "04:31:06", "text": "ほら、ほら、ほら。必需品"}, {"type": "subtitle", "time": 16268.79, "timestamp": "04:31:08", "text": "非常に波乱に満ちたラウンドだった。ヨシ、私たちは見た"}, {"type": "subtitle", "time": 16275.11, "timestamp": "04:31:15", "text": "ヨシは目の前で二人が死ぬのを目撃した"}, {"type": "subtitle", "time": 16277.349, "timestamp": "04:31:17", "text": "同時に。みんな死んだ"}, {"type": "subtitle", "time": 16279.91, "timestamp": "04:31:19", "text": "まるで彼女の前で私を殺したみたいに、それから"}, {"type": "subtitle", "time": 16281.59, "timestamp": "04:31:21", "text": "君は彼女の前でダブルキルをした"}, {"type": "subtitle", "time": 16283.83, "timestamp": "04:31:23", "text": "そして人々は目の前で食べられた"}, {"type": "subtitle", "time": 16294.309, "timestamp": "04:31:34", "text": "私はそういう風に人を甲高い声にさせることができるんです。"}, {"type": "subtitle", "time": 16301.269, "timestamp": "04:31:41", "text": "パーティーって殺人事件みたいなもの？えっと、"}, {"type": "subtitle", "time": 16303.349, "timestamp": "04:31:43", "text": "シュート。これを最後にできないだろうか？"}, {"type": "subtitle", "time": 16305.67, "timestamp": "04:31:45", "text": "そうそう。パーティーを台無しにする奴。他のプレイヤー"}, {"type": "subtitle", "time": 16308.79, "timestamp": "04:31:48", "text": "会議中、甲高い声で話す。"}, {"type": "subtitle", "time": 16310.149, "timestamp": "04:31:50", "text": "残りの人たちが去る必要がある場合は、"}, {"type": "subtitle", "time": 16315.269, "timestamp": "04:31:55", "text": "離れる。ええ、確かにハトがいますよ。もし"}, {"type": "subtitle", "time": 16317.59, "timestamp": "04:31:57", "text": "枕は十分あるから、続けよう。"}, {"type": "subtitle", "time": 16319.67, "timestamp": "04:31:59", "text": "そう、たくさんの人がいるので、"}]
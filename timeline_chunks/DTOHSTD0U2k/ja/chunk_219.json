[{"type": "subtitle", "time": 13156.79, "timestamp": "03:39:16", "text": "彼に説明させよう。彼に説明させよう。"}, {"type": "subtitle", "time": 13160.15, "timestamp": "03:39:20", "text": "何てことだ。オーケーに何が起こったのか。何"}, {"type": "subtitle", "time": 13163.11, "timestamp": "03:39:23", "text": "何が起こったのか？どうしたの？私は"}, {"type": "subtitle", "time": 13164.63, "timestamp": "03:39:24", "text": "フィーリング。いや、待って。持続する。もしかしたらそれは"}, {"type": "subtitle", "time": 13168.229, "timestamp": "03:39:28", "text": "ドードーで遊ぶ。そうかもしれないね。いや、いや、いや。その"}, {"type": "subtitle", "time": 13171.03, "timestamp": "03:39:31", "text": "いや、もしかしたらそれは時代遅れの遊びなのかもしれない。多分そうかもしれない"}, {"type": "subtitle", "time": 13173.91, "timestamp": "03:39:33", "text": "だって、私たちにはドードーがいるじゃないですか、覚えてますか？私はただ"}, {"type": "subtitle", "time": 13176.63, "timestamp": "03:39:36", "text": "彼女が走るのを見た。"}, {"type": "subtitle", "time": 13178.389, "timestamp": "03:39:38", "text": "そして、もしかしたら吉野かもしれないと言う。それは"}, {"type": "subtitle", "time": 13182.07, "timestamp": "03:39:42", "text": "めちゃくちゃ変だ。ええ、その通りです。"}, {"type": "subtitle", "time": 13183.83, "timestamp": "03:39:43", "text": "聞いて、聞いて。ドードー鳥を飼っています。我々は持っています"}, {"type": "subtitle", "time": 13187.11, "timestamp": "03:39:47", "text": "ドードー。私たちには"}, {"type": "subtitle", "time": 13189.269, "timestamp": "03:39:49", "text": "私は欠席します。わからない。私たちは"}, {"type": "subtitle", "time": 13190.87, "timestamp": "03:39:50", "text": "劣勢に立たされているのかもしれない。なぜなのか"}, {"type": "subtitle", "time": 13195.429, "timestamp": "03:39:55", "text": "ひどく静かだ。助けて。"}, {"type": "subtitle", "time": 13197.67, "timestamp": "03:39:57", "text": "彼が選んだことはとても怪しかった"}]
[{"type": "subtitle", "time": 1140.63, "timestamp": "00:19:00", "text": "もっともっともっと与えてください。すべてが"}, {"type": "subtitle", "time": 1143.43, "timestamp": "00:19:03", "text": "願いには大きな代償が伴う、人々は"}, {"type": "subtitle", "time": 1146.31, "timestamp": "00:19:06", "text": "彼らは選択肢を慎重に検討する。"}, {"type": "subtitle", "time": 1148.71, "timestamp": "00:19:08", "text": "他の人に負担をかけることができる場合"}, {"type": "subtitle", "time": 1151.51, "timestamp": "00:19:11", "text": "価格、"}, {"type": "subtitle", "time": 1155.669, "timestamp": "00:19:15", "text": "彼らは皆、もっと願い事をしようと急いでいる。彼らは"}, {"type": "subtitle", "time": 1159.11, "timestamp": "00:19:19", "text": "彼らもいつかは支払うことになるかもしれないと考えてはいけない"}, {"type": "subtitle", "time": 1163.029, "timestamp": "00:19:23", "text": "また別の利己的な欲望のために。面白いですよね"}, {"type": "subtitle", "time": 1165.49, "timestamp": "00:19:25", "text": "それ？"}, {"type": "subtitle", "time": 1182.95, "timestamp": "00:19:42", "text": "わかった、"}]
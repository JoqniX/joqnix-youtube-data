[{"type": "subtitle", "time": 2221.67, "timestamp": "00:37:01", "text": "誰が隠れているんだ？これは誰ですか？"}, {"type": "subtitle", "time": 2227.27, "timestamp": "00:37:07", "text": "彼らは無傷だ。ご安心ください。"}, {"type": "subtitle", "time": 2229.43, "timestamp": "00:37:09", "text": "予想通り、スカーは"}, {"type": "subtitle", "time": 2232.15, "timestamp": "00:37:12", "text": "彼らを殺せ。はい、私は関わらないようにしました"}, {"type": "subtitle", "time": 2235.13, "timestamp": "00:37:15", "text": "あなたが尋ねたのですから。"}, {"type": "subtitle", "time": 2236.31, "timestamp": "00:37:16", "text": "[音楽]"}, {"type": "subtitle", "time": 2239.67, "timestamp": "00:37:19", "text": "そちらは問題ありませんか？"}, {"type": "subtitle", "time": 2241.829, "timestamp": "00:37:21", "text": "お嬢様、どうぞお気をつけてお過ごしください。"}, {"type": "subtitle", "time": 2244.04, "timestamp": "00:37:24", "text": "ああ、あの女性。おお、"}, {"type": "subtitle", "time": 2246.71, "timestamp": "00:37:26", "text": "[音楽]"}, {"type": "subtitle", "time": 2249.43, "timestamp": "00:37:29", "text": "ローバー、まだあのプレートは持ってる？"}, {"type": "subtitle", "time": 2252.39, "timestamp": "00:37:32", "text": "以前に発見された？真っ二つに割れたやつ？"}, {"type": "subtitle", "time": 2256.87, "timestamp": "00:37:36", "text": "やはりそうだったか。私も同じような気持ちでした"}, {"type": "subtitle", "time": 2260.39, "timestamp": "00:37:40", "text": "その方向からの振動。"}, {"type": "subtitle", "time": 2270.23, "timestamp": "00:37:50", "text": "最高の原神キラーは"}, {"type": "subtitle", "time": 2274.31, "timestamp": "00:37:54", "text": "このゲーム、マジで。これを見て"}, {"type": "subtitle", "time": 2279.27, "timestamp": "00:37:59", "text": "男。ああ、ただ走り回ってるだけだよ。それは"}]
[{"type": "subtitle", "time": 14700.95, "timestamp": "04:05:00", "text": "できる限りね、兄弟。ごめんなさい。私は思う"}, {"type": "subtitle", "time": 14707.91, "timestamp": "04:05:07", "text": "私はみんなを愛しています。みんな大好きだよ。私"}, {"type": "subtitle", "time": 14709.83, "timestamp": "04:05:09", "text": "みんな大好きだよ。"}, {"type": "subtitle", "time": 14712.95, "timestamp": "04:05:12", "text": "何てことだ。問題は、私は何をすべきか知っていたということだ。"}, {"type": "subtitle", "time": 14715.67, "timestamp": "04:05:15", "text": "このroで実行します。"}, {"type": "subtitle", "time": 14718.229, "timestamp": "04:05:18", "text": "待って、ファルコンはどうなったの？私は何者だったのか"}, {"type": "subtitle", "time": 14719.99, "timestamp": "04:05:19", "text": "人を殺すことができるのか？私たちはただ"}, {"type": "subtitle", "time": 14723.269, "timestamp": "04:05:23", "text": "音量を下げてください。うん。うん。そうだった"}, {"type": "subtitle", "time": 14727.269, "timestamp": "04:05:27", "text": "個人的な仕事です。私もそうですから。"}, {"type": "subtitle", "time": 14731.59, "timestamp": "04:05:31", "text": "大丈夫。さあ、みんな出かけよう。私"}, {"type": "subtitle", "time": 14734.15, "timestamp": "04:05:34", "text": "誰も私の叫び声を聞いていないと思っていた。よお、ハン"}, {"type": "subtitle", "time": 14736.309, "timestamp": "04:05:36", "text": "ハン。"}, {"type": "subtitle", "time": 14737.91, "timestamp": "04:05:37", "text": "よし。"}, {"type": "subtitle", "time": 14740.55, "timestamp": "04:05:40", "text": "誰も聞いてくれなかったのが最高"}, {"type": "subtitle", "time": 14742.389, "timestamp": "04:05:42", "text": "私は「おい、ハンハン、こっちに来い。おい、"}, {"type": "subtitle", "time": 14744.389, "timestamp": "04:05:44", "text": "ハン。」そして私は完全に"}, {"type": "subtitle", "time": 14746.469, "timestamp": "04:05:46", "text": "静けさ。"}, {"type": "subtitle", "time": 14748.95, "timestamp": "04:05:48", "text": "大丈夫。"}, {"type": "subtitle", "time": 14750.63, "timestamp": "04:05:50", "text": "ねえ、誰もあなたの声を聞いてくれない理由、わかる？"}, {"type": "subtitle", "time": 14752.469, "timestamp": "04:05:52", "text": "なぜなら、彼ら二人は"}, {"type": "subtitle", "time": 14756.07, "timestamp": "04:05:56", "text": "キラー。これは全てプライベートなゲームです。"}, {"type": "subtitle", "time": 14757.59, "timestamp": "04:05:57", "text": "いいえ、聞こえましたよね。あなたは聞いていなかった"}]
[{"type": "subtitle", "time": 2522.79, "timestamp": "00:42:02", "text": "[音楽]"}, {"type": "subtitle", "time": 2528.15, "timestamp": "00:42:08", "text": "わかった。日を追うごとに不安が増していく。"}, {"type": "subtitle", "time": 2540.15, "timestamp": "00:42:20", "text": "最後のステップ。彼らは私にノーと言ったが、"}, {"type": "subtitle", "time": 2552.47, "timestamp": "00:42:32", "text": "おお。"}, {"type": "subtitle", "time": 2560.069, "timestamp": "00:42:40", "text": "[拍手]"}, {"type": "subtitle", "time": 2561.589, "timestamp": "00:42:41", "text": "月"}, {"type": "subtitle", "time": 2563.75, "timestamp": "00:42:43", "text": "あの少女はただ彼女を救いたかっただけ"}, {"type": "subtitle", "time": 2566.71, "timestamp": "00:42:46", "text": "村。うん。"}, {"type": "subtitle", "time": 2569.109, "timestamp": "00:42:49", "text": "しかし、それらの犠牲は"}, {"type": "subtitle", "time": 2571.829, "timestamp": "00:42:51", "text": "償還。"}, {"type": "subtitle", "time": 2574.55, "timestamp": "00:42:54", "text": "我々が目にした酸っぱい不和は残ったと思う"}, {"type": "subtitle", "time": 2577.99, "timestamp": "00:42:57", "text": "彼女の最後の願いを伝えるためにここに来ました。"}]
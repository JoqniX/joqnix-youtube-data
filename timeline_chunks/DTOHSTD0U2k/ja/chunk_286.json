[{"type": "subtitle", "time": 17161.99, "timestamp": "04:46:01", "text": "私たちにも同じことをしてください。楽しかった。"}, {"type": "subtitle", "time": 17164.628, "timestamp": "04:46:04", "text": "変化は私たちを飲み込むだろう。 Kは"}, {"type": "subtitle", "time": 17167.83, "timestamp": "04:46:07", "text": "私たちを食べて。うん、食べに行くよ。"}, {"type": "subtitle", "time": 17169.27, "timestamp": "04:46:09", "text": "お前ら全員、絶対に食べてやる。私は"}, {"type": "subtitle", "time": 17173.43, "timestamp": "04:46:13", "text": "間違いなくペリカンだ。うん。最初"}, {"type": "subtitle", "time": 17176.948, "timestamp": "04:46:16", "text": "外に出るのは怖い。わかった。"}, {"type": "subtitle", "time": 17180.26, "timestamp": "04:46:20", "text": "すぐ隣で消える"}, {"type": "subtitle", "time": 17182.628, "timestamp": "04:46:22", "text": "[音楽]"}, {"type": "subtitle", "time": 17184.628, "timestamp": "04:46:24", "text": "水。"}, {"type": "subtitle", "time": 17186.628, "timestamp": "04:46:26", "text": "はぁ？"}, {"type": "subtitle", "time": 17189.03, "timestamp": "04:46:29", "text": "ええ、私たちは"}, {"type": "subtitle", "time": 17194.948, "timestamp": "04:46:34", "text": "もし殺人犯が来て私を殺さなければ、"}, {"type": "subtitle", "time": 17197.75, "timestamp": "04:46:37", "text": "お前を食ってやる。"}, {"type": "subtitle", "time": 17201.43, "timestamp": "04:46:41", "text": "なぜ？なぜ選択できないのですか？何てことだ。なぜ"}, {"type": "subtitle", "time": 17203.99, "timestamp": "04:46:43", "text": "こういうことなの？何てことだ。なぜ"}, {"type": "subtitle", "time": 17206.02, "timestamp": "04:46:46", "text": "それはまるで"}, {"type": "subtitle", "time": 17208.788, "timestamp": "04:46:48", "text": "[音楽]"}, {"type": "subtitle", "time": 17212.47, "timestamp": "04:46:52", "text": "ああ、あれは何だ？追加で"}, {"type": "subtitle", "time": 17214.868, "timestamp": "04:46:54", "text": "投票する。報告すれば2票獲得できます"}]
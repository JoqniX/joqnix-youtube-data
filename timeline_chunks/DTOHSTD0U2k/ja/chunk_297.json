[{"type": "subtitle", "time": 17821.75, "timestamp": "04:57:01", "text": "君たちと一緒にグルーヴして、それから戻ってくる"}, {"type": "subtitle", "time": 17827.83, "timestamp": "04:57:07", "text": "のように"}, {"type": "subtitle", "time": 17830.31, "timestamp": "04:57:10", "text": "私はただ私とドラッグで助けている"}, {"type": "subtitle", "time": 17832.628, "timestamp": "04:57:12", "text": "お互いを排除する。私たちは恋人同士のようだ。うん、"}, {"type": "subtitle", "time": 17836.07, "timestamp": "04:57:16", "text": "君を愛しているというのは本当だ。ついに手に入れた"}, {"type": "subtitle", "time": 17840.23, "timestamp": "04:57:20", "text": "無料アイテム。ここに来て。ここに来て。"}, {"type": "subtitle", "time": 17842.55, "timestamp": "04:57:22", "text": "私の兄弟"}, {"type": "subtitle", "time": 17844.628, "timestamp": "04:57:24", "text": "そして保安官もだ、兄弟。君たちは良い"}, {"type": "subtitle", "time": 17847.19, "timestamp": "04:57:27", "text": "ルールは守っていたのに、君はそれを無駄にした。いいえ、いいえ、"}, {"type": "subtitle", "time": 17849.91, "timestamp": "04:57:29", "text": "私たちは互いに排除し合った。わかった。いいえ、私たちは"}, {"type": "subtitle", "time": 17851.51, "timestamp": "04:57:31", "text": "互いに排除し合った。重要な部分です。"}, {"type": "subtitle", "time": 17853.27, "timestamp": "04:57:33", "text": "わかった。少なくとも悪いロープは取り除く、"}, {"type": "subtitle", "time": 17855.27, "timestamp": "04:57:35", "text": "良いもの。うん。うん、クリアしたよ"}, {"type": "subtitle", "time": 17857.03, "timestamp": "04:57:37", "text": "お互いを排除する。疑う必要はなかった"}, {"type": "subtitle", "time": 17860.07, "timestamp": "04:57:40", "text": "私たちじゃないから。ええ、なぜなら"}, {"type": "subtitle", "time": 17862.23, "timestamp": "04:57:42", "text": "君たちはもういない。"}, {"type": "subtitle", "time": 17869.27, "timestamp": "04:57:49", "text": "いや、いや。いや、いや、いや。ちょっと聞いてくれ。いいえ。"}, {"type": "subtitle", "time": 17870.868, "timestamp": "04:57:50", "text": "論理って奇妙だ。お互いを愛し合えるなら"}, {"type": "subtitle", "time": 17872.868, "timestamp": "04:57:52", "text": "その他、もしあなたが信頼し、すべてを受け入れるならば、"}, {"type": "subtitle", "time": 17875.35, "timestamp": "04:57:55", "text": "まずは他の人たちの承認を得るべきです。"}, {"type": "subtitle", "time": 17877.27, "timestamp": "04:57:57", "text": "インク。インク。あなたはNワードを言った。インク。インク。"}]
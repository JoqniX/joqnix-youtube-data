[{"type": "subtitle", "time": 14822.309, "timestamp": "04:07:02", "text": "それが僕たちのキャッチフレーズだよ、みんな。私は行きます"}, {"type": "subtitle", "time": 14834.07, "timestamp": "04:07:14", "text": "また。ランダムって何？"}, {"type": "subtitle", "time": 14836.71, "timestamp": "04:07:16", "text": "本気ですか？いや。待って、何？おお、"}, {"type": "subtitle", "time": 14841.429, "timestamp": "04:07:21", "text": "それを破壊し、それを破壊し、それを破壊します。"}, {"type": "subtitle", "time": 14843.59, "timestamp": "04:07:23", "text": "本を私に投げて、私が殺せるように"}, {"type": "subtitle", "time": 14845.269, "timestamp": "04:07:25", "text": "誰か。"}, {"type": "subtitle", "time": 14847.75, "timestamp": "04:07:27", "text": "何？おいおい、勘弁してくれよ。 3人の殺人犯。来る"}, {"type": "subtitle", "time": 14850.469, "timestamp": "04:07:30", "text": "の上。"}, {"type": "subtitle", "time": 14854.15, "timestamp": "04:07:34", "text": "4つ。何てことだ。何てことだ。"}]
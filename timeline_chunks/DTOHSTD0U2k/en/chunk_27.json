[{"type": "subtitle", "time": 1621.029, "timestamp": "00:27:01", "text": "already have it figured out."}, {"type": "subtitle", "time": 1623.59, "timestamp": "00:27:03", "text": "The black lamb who rebelled against the"}, {"type": "subtitle", "time": 1626.63, "timestamp": "00:27:06", "text": "rules. The white lambs who succumbed to"}, {"type": "subtitle", "time": 1629.35, "timestamp": "00:27:09", "text": "their greed. The innocent maidens"}, {"type": "subtitle", "time": 1632.149, "timestamp": "00:27:12", "text": "sacrificed. And the villagers who turned"}, {"type": "subtitle", "time": 1635.029, "timestamp": "00:27:15", "text": "upon each other in a ruthless frenzy,"}, {"type": "subtitle", "time": 1642.07, "timestamp": "00:27:22", "text": "All the shepherd had to do was execute"}, {"type": "subtitle", "time": 1645.269, "timestamp": "00:27:25", "text": "the rebel. That's how he kept the flock"}, {"type": "subtitle", "time": 1648.149, "timestamp": "00:27:28", "text": "in check and maintained the status quo."}, {"type": "subtitle", "time": 1651.75, "timestamp": "00:27:31", "text": "Is that why you became answer? But no,"}, {"type": "subtitle", "time": 1654.39, "timestamp": "00:27:34", "text": "not even close."}, {"type": "subtitle", "time": 1658.71, "timestamp": "00:27:38", "text": "I was never the shepherd. Never will be."}, {"type": "subtitle", "time": 1664.149, "timestamp": "00:27:44", "text": "You and I, we are the black lamb."}, {"type": "subtitle", "time": 1667.269, "timestamp": "00:27:47", "text": "Who breaks the rules."}, {"type": "subtitle", "time": 1676.549, "timestamp": "00:27:56", "text": "Interesting. Rover."}]
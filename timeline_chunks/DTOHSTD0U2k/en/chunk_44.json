[{"type": "subtitle", "time": 2640.71, "timestamp": "00:44:00", "text": "person who pushed her towards such a"}, {"type": "subtitle", "time": 2644.23, "timestamp": "00:44:04", "text": "tragic end? My apologies. I got lost in"}, {"type": "subtitle", "time": 2651.43, "timestamp": "00:44:11", "text": "I wish I could say such tragedies won't"}, {"type": "subtitle", "time": 2654.15, "timestamp": "00:44:14", "text": "happen again."}, {"type": "subtitle", "time": 2656.87, "timestamp": "00:44:16", "text": "But I still lack the confidence to make"}, {"type": "subtitle", "time": 2659.349, "timestamp": "00:44:19", "text": "that claim."}, {"type": "subtitle", "time": 2661.51, "timestamp": "00:44:21", "text": "It was tragedies like this that made me"}, {"type": "subtitle", "time": 2663.91, "timestamp": "00:44:23", "text": "want to become an outrider,"}, {"type": "subtitle", "time": 2666.309, "timestamp": "00:44:26", "text": "to become someone with the strength to"}, {"type": "subtitle", "time": 2668.87, "timestamp": "00:44:28", "text": "stop them from ever happening again. I"}, {"type": "subtitle", "time": 2672.069, "timestamp": "00:44:32", "text": "cannot stop the moment, but at least I"}, {"type": "subtitle", "time": 2674.069, "timestamp": "00:44:34", "text": "should do everything in my power to"}, {"type": "subtitle", "time": 2676.15, "timestamp": "00:44:36", "text": "help. I trust you."}, {"type": "subtitle", "time": 2679.19, "timestamp": "00:44:39", "text": "Thank you, Rover."}, {"type": "subtitle", "time": 2682.23, "timestamp": "00:44:42", "text": "Dwelling on it won't do us any good."}, {"type": "subtitle", "time": 2685.67, "timestamp": "00:44:45", "text": "Let's go. I'll compile a report on what"}, {"type": "subtitle", "time": 2688.15, "timestamp": "00:44:48", "text": "happened here and send it in along with"}, {"type": "subtitle", "time": 2690.95, "timestamp": "00:44:50", "text": "the clues we've gathered. Yes, let's go"}, {"type": "subtitle", "time": 2692.47, "timestamp": "00:44:52", "text": "back"}, {"type": "subtitle", "time": 2693.79, "timestamp": "00:44:53", "text": "together."}]
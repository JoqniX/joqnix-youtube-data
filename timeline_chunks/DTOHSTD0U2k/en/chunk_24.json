[{"type": "subtitle", "time": 1441.909, "timestamp": "00:24:01", "text": "Slowly the shepherd gained control over"}, {"type": "subtitle", "time": 1445.59, "timestamp": "00:24:05", "text": "the flock and the lambs lived contented"}, {"type": "subtitle", "time": 1447.51, "timestamp": "00:24:07", "text": "lives."}, {"type": "subtitle", "time": 1452.21, "timestamp": "00:24:12", "text": "But this is not the end of our story."}, {"type": "subtitle", "time": 1454.149, "timestamp": "00:24:14", "text": "[Applause]"}, {"type": "subtitle", "time": 1457.11, "timestamp": "00:24:17", "text": "The shepherd found the solitary black"}, {"type": "subtitle", "time": 1460.95, "timestamp": "00:24:20", "text": "lamb in his flock and offered to grant"}, {"type": "subtitle", "time": 1465.19, "timestamp": "00:24:25", "text": "any wish it desired. In exchange, he"}, {"type": "subtitle", "time": 1468.149, "timestamp": "00:24:28", "text": "wanted one of its companions as a"}, {"type": "subtitle", "time": 1469.669, "timestamp": "00:24:29", "text": "sacrifice."}, {"type": "subtitle", "time": 1476.71, "timestamp": "00:24:36", "text": "The black lamb refused and it was"}, {"type": "subtitle", "time": 1480.31, "timestamp": "00:24:40", "text": "shunned by its flock, left"}, {"type": "subtitle", "time": 1483.1, "timestamp": "00:24:43", "text": "shelter or sustenance."}, {"type": "subtitle", "time": 1484.87, "timestamp": "00:24:44", "text": "[Music]"}, {"type": "subtitle", "time": 1488.71, "timestamp": "00:24:48", "text": "After the black lamb's exile, more lambs"}, {"type": "subtitle", "time": 1491.59, "timestamp": "00:24:51", "text": "continued to vanish. Lambs too. Ram yum"}, {"type": "subtitle", "time": 1495.51, "timestamp": "00:24:55", "text": "yum. Oh my god. Black lab for breaking"}, {"type": "subtitle", "time": 1497.909, "timestamp": "00:24:57", "text": "the rules"}]
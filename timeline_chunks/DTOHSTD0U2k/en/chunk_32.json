[{"type": "subtitle", "time": 1924.389, "timestamp": "00:32:04", "text": "Keep it together. What? Did you see"}, {"type": "subtitle", "time": 1946.31, "timestamp": "00:32:26", "text": "Such a nuisance. Endless reverberation."}, {"type": "subtitle", "time": 1976.71, "timestamp": "00:32:56", "text": "Did you die fully? Let's go."}]
[{"type": "subtitle", "time": 1140.63, "timestamp": "00:19:00", "text": "give more and more and more. When every"}, {"type": "subtitle", "time": 1143.43, "timestamp": "00:19:03", "text": "wish comes with a hefty price, people"}, {"type": "subtitle", "time": 1146.31, "timestamp": "00:19:06", "text": "weigh their options carefully."}, {"type": "subtitle", "time": 1148.71, "timestamp": "00:19:08", "text": "When they can make someone else bear the"}, {"type": "subtitle", "time": 1151.51, "timestamp": "00:19:11", "text": "price,"}, {"type": "subtitle", "time": 1155.669, "timestamp": "00:19:15", "text": "they all rush to make more wishes. They"}, {"type": "subtitle", "time": 1159.11, "timestamp": "00:19:19", "text": "don't consider they too may one day pay"}, {"type": "subtitle", "time": 1163.029, "timestamp": "00:19:23", "text": "for another selfish desire. Funny, isn't"}, {"type": "subtitle", "time": 1165.49, "timestamp": "00:19:25", "text": "it?"}, {"type": "subtitle", "time": 1182.95, "timestamp": "00:19:42", "text": "Okay,"}]
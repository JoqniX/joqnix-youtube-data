[{"type": "subtitle", "time": 17040.868, "timestamp": "04:44:00", "text": "。我"}, {"type": "subtitle", "time": 17050.31, "timestamp": "04:44:10", "text": "一定會告訴我"}, {"type": "subtitle", "time": 17054.15, "timestamp": "04:44:14", "text": "。  我聽到"}, {"type": "subtitle", "time": 17057.11, "timestamp": "04:44:17", "text": "麥克風裡有風聲。  不知道。不是我。  等等，鵝是"}, {"type": "subtitle", "time": 17059.11, "timestamp": "04:44:19", "text": "什麼？鴨子又是什麼？  [音樂] 真主。  不，"}, {"type": "subtitle", "time": 17078.39, "timestamp": "04:44:38", "text": "哪裡？好的。  你好。"}, {"type": "subtitle", "time": 17081.03, "timestamp": "04:44:41", "text": "觸碰。不，別碰我。  [音樂] 好啦，你們真感人。  你好。你好。"}, {"type": "subtitle", "time": 17087.43, "timestamp": "04:44:47", "text": "嗯，這是哪裡？嗯？  他們"}, {"type": "subtitle", "time": 17089.83, "timestamp": "04:44:49", "text": "來這裡的目的是什麼？  我正在做"}]
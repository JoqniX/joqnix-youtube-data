[{"type": "subtitle", "time": 12552.71, "timestamp": "03:29:12", "text": "我嗎？  是的，我們能聽到你"}, {"type": "subtitle", "time": 12556.469, "timestamp": "03:29:16", "text": "說話。  你好。麥克已經很久沒有工作了。我當時就不知道該怎麼辦了。"}, {"type": "subtitle", "time": 12587.67, "timestamp": "03:29:47", "text": "直接在遊戲裡把自己靜音了。  是啊。  不"}, {"type": "subtitle", "time": 12589.429, "timestamp": "03:29:49", "text": "，你聽見了嗎？我不是那個意思，我不是說我喜歡那樣。  哦。嗯？"}, {"type": "subtitle", "time": 12596.95, "timestamp": "03:29:56", "text": "我們來碰碰。什麼？什麼？嗯？觸碰。我們在觸碰誰？他們採取的是間接方式。我會"}]
[{"type": "subtitle", "time": 19649.91, "timestamp": "05:27:29", "text": "我不信任。不，他走到我面前。我的天哪。你知道嗎"}, {"type": "subtitle", "time": 19651.91, "timestamp": "05:27:31", "text": "？你沒事的。你想打個賭嗎？等等。如果我被趕出去，而我是警長，你得幫我個忙。喲，你得滾蛋。"}, {"type": "subtitle", "time": 19653.19, "timestamp": "05:27:33", "text": "不。不。不。不。不。這招在這裡行不通。這招行不通。"}, {"type": "subtitle", "time": 19656.708, "timestamp": "05:27:36", "text": "好吧。"}, {"type": "subtitle", "time": 19660.07, "timestamp": "05:27:40", "text": "我放棄你的機會了。你在浪費機會。"}, {"type": "subtitle", "time": 19662.788, "timestamp": "05:27:42", "text": "我只是說你們在浪費一個警長。這"}, {"type": "subtitle", "time": 19668.23, "timestamp": "05:27:48", "text": "不關我的事。我們"}, {"type": "subtitle", "time": 19672.23, "timestamp": "05:27:52", "text": "可以跳過。我只是，我只是，我是警長。我可以確認。"}, {"type": "subtitle", "time": 19676.39, "timestamp": "05:27:56", "text": "耀西，如果真是那樣，我會殺了你"}]
[{"type": "subtitle", "time": 13624.15, "timestamp": "03:47:04", "text": "這裡。  我也這麼認為。哦，不。我錯過了。我沒找到。我也這麼認為。我也這麼認為。  我常玩抽"}, {"type": "subtitle", "time": 13640.55, "timestamp": "03:47:20", "text": "卡遊戲。很高興認識你"}, {"type": "subtitle", "time": 13643.349, "timestamp": "03:47:23", "text": "。  我也很高興見到你。"}, {"type": "subtitle", "time": 13651.349, "timestamp": "03:47:31", "text": "沒錯，我們喜歡這種抓到"}]
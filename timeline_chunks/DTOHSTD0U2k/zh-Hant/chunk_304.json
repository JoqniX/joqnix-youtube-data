[{"type": "subtitle", "time": 18248.07, "timestamp": "05:04:08", "text": "感染了。是的。是的。好吧"}, {"type": "subtitle", "time": 18262.948, "timestamp": "05:04:22", "text": "。我必須盡可能多感染別人，兄弟。我很抱歉。我想我已經做到了。我愛你們所有人。"}, {"type": "subtitle", "time": 18265.67, "timestamp": "05:04:25", "text": "我愛你們所有人，夥計們。我愛你們所有人。"}, {"type": "subtitle", "time": 18269.91, "timestamp": "05:04:29", "text": "我的天哪。問題是，我知道在這種情況下該怎麼"}, {"type": "subtitle", "time": 18283.27, "timestamp": "05:04:43", "text": "我能殺人嗎？我們"}]
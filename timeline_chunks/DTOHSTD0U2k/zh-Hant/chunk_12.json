[{"type": "subtitle", "time": 720.71, "timestamp": "00:12:00", "text": "轉瞬即逝的善意，"}, {"type": "subtitle", "time": 723.509, "timestamp": "00:12:03", "text": "集體的欺騙，無謂的殺戮，"}, {"type": "subtitle", "time": 743.19, "timestamp": "00:12:23", "text": "以及被大眾推向"}, {"type": "subtitle", "time": 745.67, "timestamp": "00:12:25", "text": "毀滅之路的脆弱靈魂"}, {"type": "subtitle", "time": 748.47, "timestamp": "00:12:28", "text": "。  什麼？  現在，羅孚，"}, {"type": "subtitle", "time": 753.509, "timestamp": "00:12:33", "text": "故事就由你來講述了"}, {"type": "subtitle", "time": 756.629, "timestamp": "00:12:36", "text": "。  我很想聽聽你了解更多"}, {"type": "subtitle", "time": 759.43, "timestamp": "00:12:39", "text": "資訊後的版本。  [音樂] 他看起來真酷。  嗯？  那是什麼？你是回來尋求刺激的嗎？  所以，你想作弊"}, {"type": "subtitle", "time": 762.23, "timestamp": "00:12:42", "text": "，是嗎？一步妙棋。不受束縛，但我不會"}, {"type": "subtitle", "time": 769.35, "timestamp": "00:12:49", "text": "告訴你更多。  還沒有。  不想讓"}]
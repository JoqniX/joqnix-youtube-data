[{"type": "subtitle", "time": 11644.95, "timestamp": "03:14:04", "text": "你認識他們。誰是負責多元化招募的人員？告訴我。我很確定他們不會。  是的。  你能"}, {"type": "subtitle", "time": 11654.87, "timestamp": "03:14:14", "text": "告訴我他們是誰嗎？  不，我"}, {"type": "subtitle", "time": 11657.67, "timestamp": "03:14:17", "text": "不知道。沒有。是她。  沒關係。媽媽。媽媽。是她。  你們想要什麼樣的地圖？野獸"}, {"type": "subtitle", "time": 11665.11, "timestamp": "03:14:25", "text": "先生。我想要那張地圖。你見過那張地圖。避風港。  是的。對啊，我想要那張地圖。我不喜歡科爾。是啊，我也不喜歡"}, {"type": "subtitle", "time": 11667.03, "timestamp": "03:14:27", "text": "。這就好比太多人同時加入"}, {"type": "subtitle", "time": 11687.269, "timestamp": "03:14:47", "text": "遊戲一樣。  丟三落四的傢伙，你"}, {"type": "subtitle", "time": 11694.63, "timestamp": "03:14:54", "text": "能快點嗎？  遊戲還沒開始，"}]
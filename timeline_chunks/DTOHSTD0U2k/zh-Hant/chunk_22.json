[{"type": "subtitle", "time": 1321.43, "timestamp": "00:22:01", "text": "揮揮手，就能滿足他們的每一個願望"}, {"type": "subtitle", "time": 1326.23, "timestamp": "00:22:06", "text": "。啊，他的"}, {"type": "subtitle", "time": 1356.47, "timestamp": "00:22:36", "text": "羊群聽話地低下頭，懇求得到更好的食物和住所。他們不再需要為生存而掙扎。當他們原本貧瘠的"}, {"type": "subtitle", "time": 1365.43, "timestamp": "00:22:45", "text": "生活被"}, {"type": "subtitle", "time": 1367.75, "timestamp": "00:22:47", "text": "無盡的奢華所取代時，信眾們崇拜著他們的"}, {"type": "subtitle", "time": 1375.51, "timestamp": "00:22:55", "text": "牧羊人，把他奉為神明，讚美他，擁戴他。怎麼了？"}]
[{"type": "subtitle", "time": 2046.95, "timestamp": "00:34:06", "text": "是[音樂]小羊羔"}, {"type": "subtitle", "time": 2065.669, "timestamp": "00:34:25", "text": "們蜷縮在村莊裡，害怕無情的狼群，直到一位牧羊人到來，帶來了"}, {"type": "subtitle", "time": 2071.99, "timestamp": "00:34:31", "text": "願望的"}, {"type": "subtitle", "time": 2074.629, "timestamp": "00:34:34", "text": "禮物，並提供了庇護和食物。  牧羊人慢慢地控制住了羊群，小羊羔們也過了幸福的生活。  但這"}, {"type": "subtitle", "time": 2088.069, "timestamp": "00:34:48", "text": "並非我們故事的結局。  [掌聲] 牧羊人在羊群中發現了一隻孤零零的黑羊羔，並表示願意滿足它任何願望"}, {"type": "subtitle", "time": 2091.51, "timestamp": "00:34:51", "text": "。作為交換，他想要它的一個同伴作為祭品。  哇。  那隻黑羊羔"}]
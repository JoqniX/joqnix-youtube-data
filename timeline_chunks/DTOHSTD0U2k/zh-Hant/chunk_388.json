[{"type": "subtitle", "time": 23281.43, "timestamp": "06:28:01", "text": "這是 Ragnoser，是用來了解其他人的。是 Ragnoser。  我們走吧。"}, {"type": "subtitle", "time": 23284.15, "timestamp": "06:28:04", "text": "哇。  該死"}, {"type": "subtitle", "time": 23288.948, "timestamp": "06:28:08", "text": "。  我知道是[Music]，你這個"}, {"type": "subtitle", "time": 23291.91, "timestamp": "06:28:11", "text": "混蛋。我以為你是我的朋友。德雷和韓韓。我的天啊。好吧，即使是這樣，"}, {"type": "subtitle", "time": 23322.548, "timestamp": "06:28:42", "text": "我知道你不會殺我，但畢竟，我不知道如果戀人還活著，遊戲就會結束。只與一人對抗。晚安，我真的以為你突然消失了。  我不"}]
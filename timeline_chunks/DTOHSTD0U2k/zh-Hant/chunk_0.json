[{"type": "subtitle", "time": 4.07, "timestamp": "00:00:04", "text": "蒂爾達·比斯利。好的。"}, {"type": "subtitle", "time": 5.59, "timestamp": "00:00:05", "text": "好的。所以，這裡不是我"}, {"type": "subtitle", "time": 7.909, "timestamp": "00:00:07", "text": "想要的地方。等等，讓我看看"}, {"type": "subtitle", "time": 10.95, "timestamp": "00:00:10", "text": "她是怎麼下去的？哦，等等。她"}, {"type": "subtitle", "time": 20.95, "timestamp": "00:00:20", "text": "我最好密切注意"}, {"type": "subtitle", "time": 24.23, "timestamp": "00:00:24", "text": "學校周圍的高處，提防澤諾比亞的毒液。"}, {"type": "subtitle", "time": 28.95, "timestamp": "00:00:28", "text": "哦，這塊石塊卡在它下面了。"}, {"type": "subtitle", "time": 48.869, "timestamp": "00:00:48", "text": "哦，原來它一直都在這裡。我的天啊。"}, {"type": "subtitle", "time": 55.189, "timestamp": "00:00:55", "text": "你現在在忙什麼？"}, {"type": "subtitle", "time": 57.67, "timestamp": "00:00:57", "text": "我不知道。  讓"}]
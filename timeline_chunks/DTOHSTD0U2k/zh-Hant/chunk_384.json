[{"type": "subtitle", "time": 23048.868, "timestamp": "06:24:08", "text": "不，不。我是第一個。看，瞧"}, {"type": "subtitle", "time": 23051.83, "timestamp": "06:24:11", "text": "。我隨機挑選。是的。就算我隨機選一個，兄弟，又怎樣？"}, {"type": "subtitle", "time": 23087.19, "timestamp": "06:24:47", "text": "隨機選擇的嗎？  好的，我選了那個。我們輪到我們了。輪到我了。"}, {"type": "subtitle", "time": 23091.67, "timestamp": "06:24:51", "text": "我看了這個。"}, {"type": "subtitle", "time": 23094.628, "timestamp": "06:24:54", "text": "我打算選一個人。"}, {"type": "subtitle", "time": 23096.47, "timestamp": "06:24:56", "text": "好吧，不。又一位警長。即將死去。  我來選。看看這個。"}]
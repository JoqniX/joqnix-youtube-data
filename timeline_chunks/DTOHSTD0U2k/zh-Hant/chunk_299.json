[{"type": "subtitle", "time": 17949.03, "timestamp": "04:59:09", "text": "哦，我的天哪。那麼，演戲的生活怎麼樣呢？這裡"}, {"type": "subtitle", "time": 17951.59, "timestamp": "04:59:11", "text": "不錯，不是嗎？我沒有在那裡殺任何人。"}, {"type": "subtitle", "time": 17955.27, "timestamp": "04:59:15", "text": "我只是在做那個假任務，為了不戰而勝。只是殺了所有人。哦，我的天哪。他把所有人都殺了。我的天啊。他出現在殺戮畫面裡了。他在殺人。"}, {"type": "subtitle", "time": 17961.11, "timestamp": "04:59:21", "text": "等等。現在大家都在直播嗎？是的。不，我想是的"}, {"type": "subtitle", "time": 17965.43, "timestamp": "04:59:25", "text": "。特倫，呃，"}, {"type": "subtitle", "time": 17973.27, "timestamp": "04:59:33", "text": "壽司，呃，然後是牆。嗯，氧氣。氧氣。"}, {"type": "subtitle", "time": 17981.35, "timestamp": "04:59:41", "text": "然後是牆。哦，我找到我的屍體了。我和耀西還有氧氣在一起。我們剛進入下面的城鎮公園"}]
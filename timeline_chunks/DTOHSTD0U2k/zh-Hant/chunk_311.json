[{"type": "subtitle", "time": 18683.91, "timestamp": "05:11:23", "text": "沒關係。說起來更有趣。她不想告訴我我要舉報她，因為我們看到了她殺人。她"}, {"type": "subtitle", "time": 18686.31, "timestamp": "05:11:26", "text": "是個"}, {"type": "subtitle", "time": 18688.788, "timestamp": "05:11:28", "text": "殺手。但即使我們……那是秋天。我要跳過。即使是誤操作，他也殺了人，對吧？誤殺"}, {"type": "subtitle", "time": 18706.55, "timestamp": "05:11:46", "text": "我的天哪。這要多少個字？沒關係。沒關係……叮叮叮叮叮。餵。餵。嘿，夥計們。到我前面來。我是Terence。第二個人是Terence。"}, {"type": "subtitle", "time": 18719.43, "timestamp": "05:11:59", "text": "所以，呃，我和Ox還有Terence"}]
[{"type": "subtitle", "time": 18379.19, "timestamp": "05:06:19", "text": "。所以我"}, {"type": "subtitle", "time": 18384.07, "timestamp": "05:06:24", "text": "跟著你。哦，你，哦，你也死了。是啊，但"}, {"type": "subtitle", "time": 18391.59, "timestamp": "05:06:31", "text": "跟著你的那兩個人是另一個殺手。哦，原來如此。該死，我逃出來了。是啊，夥計們，過來看看我們。是啊，我逃出來了。我把這份榮譽帶給了我的家人。好的。哦，不錯。不錯"}, {"type": "subtitle", "time": 18405.99, "timestamp": "05:06:45", "text": "。"}, {"type": "subtitle", "time": 18408.07, "timestamp": "05:06:48", "text": "你知道嗎？我當時想，嘿，什麼？開始什麼？"}, {"type": "subtitle", "time": 18412.23, "timestamp": "05:06:52", "text": "小丑，準備好了。什麼？我殺人了"}, {"type": "subtitle", "time": 18416.31, "timestamp": "05:06:56", "text": "。"}, {"type": "subtitle", "time": 18418.628, "timestamp": "05:06:58", "text": "我很高興。我殺對了"}]
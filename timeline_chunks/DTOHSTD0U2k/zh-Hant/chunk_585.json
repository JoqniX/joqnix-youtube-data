[{"type": "subtitle", "time": 35107.51, "timestamp": "09:45:07", "text": "。 如果我想要，我可以得到，但每10個保證"}, {"type": "subtitle", "time": 35112.54, "timestamp": "09:45:12", "text": "4個或好吧，但這傢伙就像好吧，我只需要攢下我的東西。"}, {"type": "subtitle", "time": 35119.83, "timestamp": "09:45:19", "text": "我想我得給五星"}, {"type": "subtitle", "time": 35124.31, "timestamp": "09:45:24", "text": "好評"}, {"type": "subtitle", "time": 35134.87, "timestamp": "09:45:34", "text": "。是的，在我們繼續之前，"}, {"type": "subtitle", "time": 35136.95, "timestamp": "09:45:36", "text": "讓我再做一件事。是的，我知道。"}, {"type": "subtitle", "time": 35141.11, "timestamp": "09:45:41", "text": "嗯，早晨真難熬。我怕冷。  嗯，我"}, {"type": "subtitle", "time": 35152.63, "timestamp": "09:45:52", "text": "嗯，這是什麼？不滅的餘燼。哈蒂姆。"}, {"type": "subtitle", "time": 35157.266, "timestamp": "09:45:57", "text": "嗡嗡。探索太空。"}, {"type": "subtitle", "time": 35159.18, "timestamp": "09:45:59", "text": "有趣的物品。"}]
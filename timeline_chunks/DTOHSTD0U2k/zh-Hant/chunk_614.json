[{"type": "subtitle", "time": 36870.71, "timestamp": "10:14:30", "text": "你抬頭望去，發現誇拉斯銅、琥珀和蛋白石"}, {"type": "subtitle", "time": 36880.39, "timestamp": "10:14:40", "text": "從天而降。這是一場奇妙的礦物雨。在這蒸氣瀰漫的瞬間，一個巨大的東西從地幔中伸出脊椎，寬闊的手掌上緊握著一把大錘。"}, {"type": "subtitle", "time": 36884.15, "timestamp": "10:14:44", "text": "你睜開眼睛，意識到這其實是保存的時代。 [音樂]"}, {"type": "subtitle", "time": 36889.266, "timestamp": "10:14:49", "text": "這是新的沙哈塔嗎？這是"}, {"type": "subtitle", "time": 36895.19, "timestamp": "10:14:55", "text": "他們周圍的巨大圓圈"}]
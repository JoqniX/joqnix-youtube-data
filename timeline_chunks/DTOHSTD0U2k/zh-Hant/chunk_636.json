[{"type": "subtitle", "time": 38180.99, "timestamp": "10:36:20", "text": "是一輪了。我可能很快就需要結束直播了。我們繼續。"}, {"type": "subtitle", "time": 38184.55, "timestamp": "10:36:24", "text": "[音樂]"}, {"type": "subtitle", "time": 38188.07, "timestamp": "10:36:28", "text": "我們使用傳送快速前往已解鎖的地點。哦，我們終於解鎖了傳送。"}, {"type": "subtitle", "time": 38196.23, "timestamp": "10:36:36", "text": "[音樂] 使用傳送門在不同地點之間移動。這適用於"}]
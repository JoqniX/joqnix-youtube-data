[{"type": "subtitle", "time": 36365.83, "timestamp": "10:06:05", "text": "[音樂]"}, {"type": "subtitle", "time": 36368.15, "timestamp": "10:06:08", "text": "裡面的東西。走吧。一個好人。一個好人。一個機械師。哦，他還活著。"}, {"type": "subtitle", "time": 36376.6, "timestamp": "10:06:16", "text": "好的，太好了。走吧。"}, {"type": "subtitle", "time": 36381.35, "timestamp": "10:06:21", "text": "[音樂] 連結。哇。哇。關於Wow的真相。他以前只是在想[音樂]"}]
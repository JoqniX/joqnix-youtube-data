[{"type": "subtitle", "time": 15975.03, "timestamp": "04:26:15", "text": "哦，水泵。  我的天啊。誰去世了？"}, {"type": "subtitle", "time": 15977.349, "timestamp": "04:26:17", "text": "不，特蘭。"}, {"type": "subtitle", "time": 15983.03, "timestamp": "04:26:23", "text": "不。嗯，是誰檢舉的？你好。"}, {"type": "subtitle", "time": 15986.55, "timestamp": "04:26:26", "text": "是的，夥計們。嗯，我的聊天記錄顯示 RX 是"}, {"type": "subtitle", "time": 15989.03, "timestamp": "04:26:29", "text": "冒名頂替者。我相信我的聊天記錄。  所以，我現在投他一票。好吧，我來告訴你發生了什麼事。"}]
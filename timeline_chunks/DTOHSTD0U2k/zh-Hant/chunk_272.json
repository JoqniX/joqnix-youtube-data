[{"type": "subtitle", "time": 16323.51, "timestamp": "04:32:03", "text": "我剛才看到她"}, {"type": "subtitle", "time": 16326.55, "timestamp": "04:32:06", "text": "跑了。"}, {"type": "subtitle", "time": 16352.55, "timestamp": "04:32:32", "text": "詭異極了。是的，沒錯。  聽著，聽著。我們"}, {"type": "subtitle", "time": 16356.469, "timestamp": "04:32:36", "text": "有一隻渡渡鳥。我們有一隻渡渡鳥。"}, {"type": "subtitle", "time": 16366.63, "timestamp": "04:32:46", "text": "我要跳過。我不知道。我們可能要被對手佔上風了。"}, {"type": "subtitle", "time": 16369.269, "timestamp": "04:32:49", "text": "為什麼「為什麼"}, {"type": "subtitle", "time": 16379.83, "timestamp": "04:32:59", "text": "」如此沉默？救救我。  他選擇約沙這件事非常可疑，但這或許是幫他一個忙。  我懂了。這是假的"}]
[{"type": "subtitle", "time": 37262.15, "timestamp": "10:21:02", "text": "但我快沒耐心了。好吧。"}, {"type": "subtitle", "time": 37289.39, "timestamp": "10:21:29", "text": "那傢伙。"}, {"type": "subtitle", "time": 37297.35, "timestamp": "10:21:37", "text": "[音樂] 哦，天哪[音樂] 這傷害。"}, {"type": "subtitle", "time": 37300.47, "timestamp": "10:21:40", "text": "他死了。"}, {"type": "subtitle", "time": 37307.03, "timestamp": "10:21:47", "text": "哦"}]
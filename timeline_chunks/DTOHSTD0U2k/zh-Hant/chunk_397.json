[{"type": "subtitle", "time": 23825.99, "timestamp": "06:37:05", "text": "不信任任何人，但我愛每個人。所以我打算跳過。好的之前。好的。是的。是的。是的。"}, {"type": "subtitle", "time": 23835.03, "timestamp": "06:37:15", "text": "但你的角色是什麼？請告訴我們您的角色"}, {"type": "subtitle", "time": 23852.31, "timestamp": "06:37:32", "text": "。請先告訴我。我的礦井是警長。桐生。  你的職責是什麼？我是士兵。  好的。我的天啊。"}, {"type": "subtitle", "time": 23859.99, "timestamp": "06:37:39", "text": "我一起來養鴿子吧。你"}, {"type": "subtitle", "time": 23870.07, "timestamp": "06:37:50", "text": "知道我為什麼猶豫要不要投票嗎？我覺得有人逃脫了，我一直很懷疑，因為他就在我面前，從下面經過，好吧，"}]
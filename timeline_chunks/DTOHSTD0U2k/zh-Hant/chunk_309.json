[{"type": "subtitle", "time": 18570.708, "timestamp": "05:09:30", "text": "什麼？哦，拜託。三個"}, {"type": "subtitle", "time": 18586.31, "timestamp": "05:09:46", "text": "拜託。四個。我的天哪。我的天哪。我的天哪。六個。停。我的天哪。我喜歡"}, {"type": "subtitle", "time": 18589.51, "timestamp": "05:09:49", "text": "我們每個人都是殺手。在遊戲中。這是一個男人的踢腿動作[音樂]。誰在殺誰？"}, {"type": "subtitle", "time": 18593.19, "timestamp": "05:09:53", "text": "我想知道。我不想他媽的……你好。不在場證明。你好。你好。你"}]
[{"type": "subtitle", "time": 35403.11, "timestamp": "09:50:03", "text": "。那是我唯一玩的遊戲。所以，如果我們舉辦任何比賽、每週對戰、比賽或其他活動，"}, {"type": "subtitle", "time": 35407.11, "timestamp": "09:50:07", "text": "你都會從公告頻道"}, {"type": "subtitle", "time": 35411.03, "timestamp": "09:50:11", "text": "收到通知，而不是從其他任何地方，只能從公告頻道"}, {"type": "subtitle", "time": 35415.11, "timestamp": "09:50:15", "text": "或互聯網的"}, {"type": "subtitle", "time": 35418.15, "timestamp": "09:50:18", "text": "鳴謝名單中得知。她是個傀儡"}, {"type": "subtitle", "time": 35420.95, "timestamp": "09:50:20", "text": "。他們是同一個人。我在等你。這真是"}, {"type": "subtitle", "time": 35448.55, "timestamp": "09:50:48", "text": "太酷了。這就是我想要的遊戲。 [音樂]此帳號已停用。業務繼續。沒關係。我們有吉他"}]
[{"type": "subtitle", "time": 18318.55, "timestamp": "05:05:18", "text": "可以把你的音量調低。是的。是的。這是我的私事，因為我也是。沒關係。我們出去吧，大家。我以為沒人聽到我的尖叫聲。喲，韓韓。"}, {"type": "subtitle", "time": 18327.83, "timestamp": "05:05:27", "text": "好吧。"}, {"type": "subtitle", "time": 18339.67, "timestamp": "05:05:39", "text": "我喜歡我說的時候沒人他媽的聽， “嘿，韓韓，過來一下。” “嘿，韓。”然後我就徹底安靜了。好吧。你知道，你知道"}, {"type": "subtitle", "time": 18343.19, "timestamp": "05:05:43", "text": "為什麼沒人聽到你說話嗎？因為他們兩個都是殺手。"}, {"type": "subtitle", "time": 18352.31, "timestamp": "05:05:52", "text": "這都是私人遊戲。"}, {"type": "subtitle", "time": 18355.83, "timestamp": "05:05:55", "text": "不，你聽到了。你只是沒聽到我的尖叫聲。韓韓。不，我，我死了"}]
[{"type": "subtitle", "time": 19805.11, "timestamp": "05:30:05", "text": "Yoshi，我們到底要去哪裡？你們想帶我們回去嗎"}, {"type": "subtitle", "time": 19807.99, "timestamp": "05:30:07", "text": "？我去找你們。等等。我覺得我們錄音只是因為我有點"}, {"type": "subtitle", "time": 19810.23, "timestamp": "05:30:10", "text": "懵。你想……"}, {"type": "subtitle", "time": 19818.39, "timestamp": "05:30:18", "text": "我知道。我知道。我知道。或跳過。所以，我們要跳過嗎？跳過。"}, {"type": "subtitle", "time": 19821.59, "timestamp": "05:30:21", "text": "嗯，我想我們要跳過。"}, {"type": "subtitle", "time": 19823.75, "timestamp": "05:30:23", "text": "我們要跳過。我打算跳過。"}, {"type": "subtitle", "time": 19829.51, "timestamp": "05:30:29", "text": "我好困惑。太讓人困惑了。等等，"}, {"type": "subtitle", "time": 19831.51, "timestamp": "05:30:31", "text": "我為什麼……可以投票？哇哦。我喜歡這個。 [音樂] 我們是。等等，你這"}, {"type": "subtitle", "time": 19833.59, "timestamp": "05:30:33", "text": "討厭的[ __ ]。你在哪裡？我不"}, {"type": "subtitle", "time": 19851.27, "timestamp": "05:30:51", "text": "明白。你這討厭的[ __ ]。你甚至都不讓我玩。等等，你是殺手嗎？"}, {"type": "subtitle", "time": 19854.47, "timestamp": "05:30:54", "text": "哦，不。你是渡渡鳥。我是渡渡鳥。"}, {"type": "subtitle", "time": 19856.15, "timestamp": "05:30:56", "text": "我是殺手。他吃了人。幹得好。幹得好。"}]
[{"type": "subtitle", "time": 20041.27, "timestamp": "05:34:01", "text": "我就已經殺了"}, {"type": "subtitle", "time": 20043.67, "timestamp": "05:34:03", "text": "一個。 謝謝。你知道嗎，感覺就像我的胃裡有五個人一樣。一定很好吃。我覺得一開始我就已經殺了一個。 謝謝。"}, {"type": "subtitle", "time": 20060.21, "timestamp": "05:34:20", "text": "你知道我的打法而言。"}, {"type": "subtitle", "time": 20068.64, "timestamp": "05:34:28", "text": "我向"}]
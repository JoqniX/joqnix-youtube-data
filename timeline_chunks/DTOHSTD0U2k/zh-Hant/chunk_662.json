[{"type": "subtitle", "time": 39733.586, "timestamp": "11:02:13", "text": "這三個人還很"}, {"type": "subtitle", "time": 39736.12, "timestamp": "11:02:16", "text": "年輕。"}, {"type": "subtitle", "time": 39737.266, "timestamp": "11:02:17", "text": "[音樂]我的天哪。 [音樂]大家都知道"}, {"type": "subtitle", "time": 39743.426, "timestamp": "11:02:23", "text": "我會一直在那裡。 【音樂】痛苦。我怎麼沒想到呢？等等。呃，按照指示完成“布里特行動”以"}, {"type": "subtitle", "time": 39758.15, "timestamp": "11:02:38", "text": "。和平指南強化。"}, {"type": "subtitle", "time": 39774.31, "timestamp": "11:02:54", "text": "好的。哦，這就像你的……呃，這個東西。呃，我忘了什麼。它叫什麼來著？那個東西。你現在"}, {"type": "subtitle", "time": 39777.426, "timestamp": "11:02:57", "text": "在故事中領先了。"}]
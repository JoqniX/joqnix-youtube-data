[{"type": "subtitle", "time": 36961.746, "timestamp": "10:16:01", "text": "真正的斯誇里姆一樣忽略我們。一。所以我說你自己"}, {"type": "subtitle", "time": 36963.586, "timestamp": "10:16:03", "text": "試著用點擊"}, {"type": "subtitle", "time": 36966.23, "timestamp": "10:16:06", "text": "他們的心形樹幹來吸引他們，現在看來"}, {"type": "subtitle", "time": 36967.83, "timestamp": "10:16:07", "text": "我的判斷是正確的。下次你"}, {"type": "subtitle", "time": 36971.746, "timestamp": "10:16:11", "text": "跑的時候試著從他們身上得到什麼。"}, {"type": "subtitle", "time": 36973.586, "timestamp": "10:16:13", "text": "你必須了解更多關於那裡的事情。"}, {"type": "subtitle", "time": 36977.83, "timestamp": "10:16:17", "text": "你想知道什麼？關於永恆"}, {"type": "subtitle", "time": 36981.19, "timestamp": "10:16:21", "text": "與海點的神話。我喜歡故事。宇宙的起源"}, {"type": "subtitle", "time": 36983.11, "timestamp": "10:16:23", "text": "。什麼都可以。我很"}, {"type": "subtitle", "time": 36988.31, "timestamp": "10:16:28", "text": "生氣。想想辦法。好的。"}, {"type": "subtitle", "time": 36990.39, "timestamp": "10:16:30", "text": "我會為你完成這次測試。"}, {"type": "subtitle", "time": 36992.79, "timestamp": "10:16:32", "text": "你看，我用我的權限給你"}, {"type": "subtitle", "time": 36994.87, "timestamp": "10:16:34", "text": "祝福。"}, {"type": "subtitle", "time": 36996.63, "timestamp": "10:16:36", "text": "現在你可以去玩了。別問"}, {"type": "subtitle", "time": 36999.51, "timestamp": "10:16:39", "text": "為什麼。只要感謝我。去選一個。"}, {"type": "subtitle", "time": 37001.03, "timestamp": "10:16:41", "text": "好的。你已經"}, {"type": "subtitle", "time": 37003.35, "timestamp": "10:16:43", "text": "擊敗了挪威，可以選擇一個"}, {"type": "subtitle", "time": 37005.99, "timestamp": "10:16:45", "text": "祝福。好的。進入後，所有"}, {"type": "subtitle", "time": 37008.31, "timestamp": "10:16:48", "text": "角色"}]
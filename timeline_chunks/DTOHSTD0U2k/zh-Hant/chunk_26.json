[{"type": "subtitle", "time": 1560.71, "timestamp": "00:26:00", "text": "伴隨著高昂的代價"}, {"type": "subtitle", "time": 1598.149, "timestamp": "00:26:38", "text": "時，人們會仔細衡量各種選擇。  當他們能讓別人承擔"}, {"type": "subtitle", "time": 1602.23, "timestamp": "00:26:42", "text": "代價時，他們都會爭先恐後地許下更多願望。他們沒有想到，自己有一天也可能為另一個"}]
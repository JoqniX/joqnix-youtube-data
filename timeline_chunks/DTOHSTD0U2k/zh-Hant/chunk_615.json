[{"type": "subtitle", "time": 36900.23, "timestamp": "10:15:00", "text": "。這是給你的"}, {"type": "subtitle", "time": 36917.51, "timestamp": "10:15:17", "text": "警告。然後他們在你眼前消失了。沒有計算。她很可愛，她"}, {"type": "subtitle", "time": 36922.39, "timestamp": "10:15:22", "text": "是"}, {"type": "subtitle", "time": 36926.79, "timestamp": "10:15:26", "text": "個帶著花的小機器人。為什麼"}, {"type": "subtitle", "time": 36930.47, "timestamp": "10:15:30", "text": "真的會出現在這裡？雄心勃勃的咯咯笑聲與"}, {"type": "subtitle", "time": 36936.33, "timestamp": "10:15:36", "text": "吸引一位老朋友的腳步聲相呼應。"}, {"type": "subtitle", "time": 36943.266, "timestamp": "10:15:43", "text": "你看到的是一個精心培育的模擬離子"}, {"type": "subtitle", "time": 36954.71, "timestamp": "10:15:54", "text": "由魯安·梅和斯誇里姆·"}, {"type": "subtitle", "time": 36957.746, "timestamp": "10:15:57", "text": "斯克魯里姆模擬器精心培育，它會像"}]
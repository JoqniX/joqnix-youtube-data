[{"type": "subtitle", "time": 18960.948, "timestamp": "05:16:00", "text": "？死神說泰倫是其中一個兇手，這意味著"}, {"type": "subtitle", "time": 18971.67, "timestamp": "05:16:11", "text": "桐木不是兇手，對吧？也可能是澄美，她實際上把罪名推到了桐木身上，對吧？"}, {"type": "subtitle", "time": 18976.47, "timestamp": "05:16:16", "text": "我不認為這是她的不在場"}, {"type": "subtitle", "time": 18991.19, "timestamp": "05:16:31", "text": "證明之類的。我和她"}, {"type": "subtitle", "time": 18993.11, "timestamp": "05:16:33", "text": "在一起。我不懂這個邏輯。是的，你從她身邊經過，"}, {"type": "subtitle", "time": 18996.708, "timestamp": "05:16:36", "text": "對吧？這可能是我因為太"}, {"type": "subtitle", "time": 18998.628, "timestamp": "05:16:38", "text": "激進而戴著胸罩。反駁。他說"}, {"type": "subtitle", "time": 19007.11, "timestamp": "05:16:47", "text": "如果你睜開眼睛，然後他就開始叫她。"}, {"type": "subtitle", "time": 19008.628, "timestamp": "05:16:48", "text": "哦，老兄，友善一點。滾出去。他說如果這很有趣就​​投他一票。哦，我只是，我只是在跟著，我保證。對不起。"}, {"type": "subtitle", "time": 19013.83, "timestamp": "05:16:53", "text": "他們的論點更有說服力。友善點，我的孩子。這確實很甜蜜，但別忘了在Discord上靜音。為什麼？你說"}]
[{"type": "subtitle", "time": 40699.586, "timestamp": "11:18:19", "text": "我相信這是你第一次。我以前沒見過你。"}, {"type": "subtitle", "time": 40707.67, "timestamp": "11:18:27", "text": "我不"}, {"type": "subtitle", "time": 40709.746, "timestamp": "11:18:29", "text": "知道這是新來的，還是像以前來過的老朋友，或者是個新帳號，或者我也不知道，但謝謝你的光臨，而且"}, {"type": "subtitle", "time": 40726.95, "timestamp": "11:18:46", "text": "您"}, {"type": "subtitle", "time": 40729.266, "timestamp": "11:18:49", "text": "找到我的直播間。這對我意義重大。今天"}]
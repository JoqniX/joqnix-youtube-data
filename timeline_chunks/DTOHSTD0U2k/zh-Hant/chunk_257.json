[{"type": "subtitle", "time": 15441.99, "timestamp": "04:17:21", "text": "拋棄我們的休戰協議和友誼。  哦，不。我撒謊了。還有，"}, {"type": "subtitle", "time": 15448.87, "timestamp": "04:17:28", "text": "我喜歡你的頭帶，混蛋。我撒謊了。我是說，關於吃掉"}, {"type": "subtitle", "time": 15451.429, "timestamp": "04:17:31", "text": "你。是的，我聽起來好像忘了真相。是啊"}, {"type": "subtitle", "time": 15458.95, "timestamp": "04:17:38", "text": "，我忘了你知道的那件事嗎？你說先他媽的殺了"}, {"type": "subtitle", "time": 15461.59, "timestamp": "04:17:41", "text": "人"}, {"type": "subtitle", "time": 15465.189, "timestamp": "04:17:45", "text": "。我跟你說實話。  快點。  喲，Roku來了。我們走吧。好了，"}, {"type": "subtitle", "time": 15467.349, "timestamp": "04:17:47", "text": "我們走吧。好的，給他點時間跟大家"}]
[{"type": "subtitle", "time": 19580.948, "timestamp": "05:26:20", "text": "你好。你們好嗎？喲，等等。嗯，我們這裡有點東西。你想加入聯盟嗎？看著我。呃"}, {"type": "subtitle", "time": 19583.91, "timestamp": "05:26:23", "text": "，這是特羅斯嗎"}, {"type": "subtitle", "time": 19586.47, "timestamp": "05:26:26", "text": "？冷靜點。 Yoshi。好的，我們得給我點時間說話。你好。給我點時間說話。"}, {"type": "subtitle", "time": 19600.628, "timestamp": "05:26:40", "text": "Yoshi，等一下。"}, {"type": "subtitle", "time": 19602.948, "timestamp": "05:26:42", "text": "讓我解釋一下。我是警長。我刺傷了Suumi，因為我是警長。"}, {"type": "subtitle", "time": 19605.75, "timestamp": "05:26:45", "text": "我沒"}, {"type": "subtitle", "time": 19607.43, "timestamp": "05:26:47", "text": "死。 Suumi是個殺人犯"}, {"type": "subtitle", "time": 19612.23, "timestamp": "05:26:52", "text": "。我是警長。我現在可以"}]
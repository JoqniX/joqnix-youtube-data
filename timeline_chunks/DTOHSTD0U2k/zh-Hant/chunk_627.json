[{"type": "subtitle", "time": 37620.23, "timestamp": "10:27:00", "text": "深刻的"}, {"type": "subtitle", "time": 37624.63, "timestamp": "10:27:04", "text": "科幻故事"}, {"type": "subtitle", "time": 37631.11, "timestamp": "10:27:11", "text": "。"}, {"type": "subtitle", "time": 37644.07, "timestamp": "10:27:24", "text": "我期待它們出現"}, {"type": "subtitle", "time": 37648.79, "timestamp": "10:27:28", "text": "在我的…[音樂] 你不會感覺到任何回到現實的感覺"}, {"type": "subtitle", "time": 37659.11, "timestamp": "10:27:39", "text": "。 [音樂] 你聽到的遊戲是名字，而不是它們，人工智慧，那是一個聲音，"}, {"type": "subtitle", "time": 37667.906, "timestamp": "10:27:47", "text": "所以你感到很奇怪，但她的聲音變得"}, {"type": "subtitle", "time": 37669.746, "timestamp": "10:27:49", "text": "凝固了，"}, {"type": "subtitle", "time": 37671.99, "timestamp": "10:27:51", "text": "她的整個人變得如此"}, {"type": "subtitle", "time": 37679.426, "timestamp": "10:27:59", "text": "不真實。"}]
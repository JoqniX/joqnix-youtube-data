[{"type": "subtitle", "time": 21721.75, "timestamp": "06:02:01", "text": "我不想殺"}, {"type": "subtitle", "time": 21725.03, "timestamp": "06:02:05", "text": "她們。 我真是太幸運了。我只是想殺個人，讓你遠離我。我真慶幸自己逃離了你。是啊，你真幸運，"}, {"type": "subtitle", "time": 21760.788, "timestamp": "06:02:40", "text": "我想殺了他們。你看到怪物朝我走過來了吧？"}]
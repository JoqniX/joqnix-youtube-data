[{"type": "subtitle", "time": 20777.03, "timestamp": "05:46:17", "text": "走吧？  你無視我。  放開我。放了我"}, {"type": "subtitle", "time": 20780.39, "timestamp": "05:46:20", "text": "。  這他媽是什麼玩意兒？拿起鈴鐺。"}, {"type": "subtitle", "time": 20783.51, "timestamp": "05:46:23", "text": "哦，真不敢相信"}, {"type": "chat", "time": 20785.564, "timestamp": "05:46:25", "author": "@AFroznThorn", "avatar": "https://yt4.ggpht.com/UOd53-ssefezO2JWGQi-gSpM4zglLHS2XVfc2UQu3E-TdNk2KGnAZtWYAYqQBudbEouoIqf3=s64-c-k-c0x00ffffff-no-rj", "message": "🤣🤣🤣😭✋🏻"}, {"type": "subtitle", "time": 20789.59, "timestamp": "05:46:29", "text": "她把我吃了。真是個耀西。  你們真的很喜歡自己，對吧？  我相信你。是的，但"}, {"type": "subtitle", "time": 20791.91, "timestamp": "05:46:31", "text": "我"}, {"type": "chat", "time": 20792.359, "timestamp": "05:46:32", "author": "@AFroznThorn", "avatar": "https://yt4.ggpht.com/UOd53-ssefezO2JWGQi-gSpM4zglLHS2XVfc2UQu3E-TdNk2KGnAZtWYAYqQBudbEouoIqf3=s64-c-k-c0x00ffffff-no-rj", "message": "they all got a bad stomach"}, {"type": "subtitle", "time": 20794.548, "timestamp": "05:46:34", "text": "沒有逼她。基爾是邪惡的"}, {"type": "subtitle", "time": 20797.27, "timestamp": "05:46:37", "text": "。放我走。放開我。  等等，"}, {"type": "subtitle", "time": 20801.83, "timestamp": "05:46:41", "text": "鵜鶘可以放你走。"}, {"type": "subtitle", "time": 20812.15, "timestamp": "05:46:52", "text": "我知道你能聽到我說話。你明白我為什麼信任你了吧？什麼？什麼？罪有應得。  歡迎。什麼？發生了什麼？歡迎來到電影院。夥伴口袋。  你罪有應得。等等"}, {"type": "subtitle", "time": 20816.61, "timestamp": "05:46:56", "text": "，發生了什麼事？我們自由了。"}]
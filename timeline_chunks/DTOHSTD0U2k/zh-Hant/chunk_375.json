[{"type": "subtitle", "time": 22508.628, "timestamp": "06:15:08", "text": "稍等。好的。我們到了。  你好。"}, {"type": "subtitle", "time": 22510.39, "timestamp": "06:15:10", "text": "它在左邊。都在左邊。"}, {"type": "subtitle", "time": 22519.99, "timestamp": "06:15:19", "text": "正確的。好的。  我們一起去吧。你好。我們"}, {"type": "subtitle", "time": 22521.35, "timestamp": "06:15:21", "text": "正在重新裝彈。  什麼？  你說的“殺”是什麼意思？好的。  我的天啊。他"}, {"type": "subtitle", "time": 22523.67, "timestamp": "06:15:23", "text": "不是。他不是。他不是你們中的一員。你們其中一人。哦親愛的。我"}, {"type": "subtitle", "time": 22549.03, "timestamp": "06:15:49", "text": "我想，我想做我的三個。我的天哪。  我的天哪。  呃，你們兩個都是"}]
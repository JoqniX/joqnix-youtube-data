[{"type": "subtitle", "time": 10818.23, "timestamp": "03:00:18", "text": "什麼？  決不。  趕緊結束"}, {"type": "subtitle", "time": 10824.309, "timestamp": "03:00:24", "text": "這件事吧。  上擺。  上擺。  向上。猩紅。  拒絕。  降低。舒適。  迅速而果斷。引導我的刀刃。  煥發活力的雪。擁抱"}, {"type": "subtitle", "time": 10839.03, "timestamp": "03:00:39", "text": "變化。  共鳴時刻。  上擺。  帽子。  [音樂]"}, {"type": "subtitle", "time": 10847.19, "timestamp": "03:00:47", "text": "等等，好像還有"}, {"type": "subtitle", "time": 10856.15, "timestamp": "03:00:56", "text": "後續。"}, {"type": "subtitle", "time": 10858.309, "timestamp": "03:00:58", "text": "啊，浪費這件事真是太糟糕了。  [音樂] 一些織布"}]
[{"type": "subtitle", "time": 22682.628, "timestamp": "06:18:02", "text": "[糟糕了，我們已經有"}, {"type": "subtitle", "time": 22693.99, "timestamp": "06:18:13", "text": "兩個殺手了"}, {"type": "subtitle", "time": 22697.03, "timestamp": "06:18:17", "text": "。  我當時……呃……我當時是FK。你好。是的。你好。喲喲，過來。我們組成一個小組。我們編造"}, {"type": "subtitle", "time": 22701.27, "timestamp": "06:18:21", "text": "不在場證明。我擔心我們家有鴿子，對吧？"}, {"type": "subtitle", "time": 22713.43, "timestamp": "06:18:33", "text": "這樣更好，對吧？  想像。好的。好的。好的。好的。就這麼想吧。"}, {"type": "subtitle", "time": 22729.99, "timestamp": "06:18:49", "text": "我不想死。如果你們其中一人沒事呢？好的。好的。如果喬克殺了我，那你就可以去"}]
[{"type": "subtitle", "time": 37320.39, "timestamp": "10:22:00", "text": "我們得打三次。我忘了。 [音樂][掌聲] 哇。一擊必殺。"}, {"type": "subtitle", "time": 37327.03, "timestamp": "10:22:07", "text": "哦，"}, {"type": "subtitle", "time": 37329.586, "timestamp": "10:22:09", "text": "盾牌。不錯。耶。我打倒了一個敵人。就這樣幹"}, {"type": "subtitle", "time": 37339.746, "timestamp": "10:22:19", "text": "。最後一擊。但他沒死。什麼？ [音樂] 就這樣幹。"}, {"type": "subtitle", "time": 37349.906, "timestamp": "10:22:29", "text": "哦，我造成傷害了。耶。"}, {"type": "subtitle", "time": 37365.586, "timestamp": "10:22:45", "text": "我選擇"}, {"type": "subtitle", "time": 37370.07, "timestamp": "10:22:50", "text": "剩下的那個傢伙。"}]
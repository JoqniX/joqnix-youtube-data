[{"type": "subtitle", "time": 16561.75, "timestamp": "04:36:01", "text": "哦，我的水管。是的，就在我們面前。"}, {"type": "subtitle", "time": 16574.629, "timestamp": "04:36:14", "text": "什麼？但 Dragosaur 非常安靜，而且你知道 RX。"}, {"type": "subtitle", "time": 16575.64, "timestamp": "04:36:15", "text": "等等，"}, {"type": "subtitle", "time": 16588.31, "timestamp": "04:36:28", "text": "剛才在我們面前的那個人是誰殺的"}, {"type": "subtitle", "time": 16593.99, "timestamp": "04:36:33", "text": "？我看到有人逃跑了。我看到有人逃跑了。我看到"}, {"type": "subtitle", "time": 16604.47, "timestamp": "04:36:44", "text": "有人逃跑了。什麼顏色？"}, {"type": "subtitle", "time": 16606.869, "timestamp": "04:36:46", "text": "我不記得了。我不記得顏色了。都是我的錯。但"}, {"type": "subtitle", "time": 16618.31, "timestamp": "04:36:58", "text": "我好像看到有人逃跑了。表面有水滴的物體。而且我感覺 Willow 就是不會進鍋裡，不知道為什麼。但是Willow，我就是"}]
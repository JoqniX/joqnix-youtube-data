[{"type": "subtitle", "time": 1501.51, "timestamp": "00:25:01", "text": "and withheld his wish granting power as"}, {"type": "subtitle", "time": 1513.35, "timestamp": "00:25:13", "text": "From the very beginning, the lambs knew"}, {"type": "subtitle", "time": 1516.31, "timestamp": "00:25:16", "text": "the risk of making wishes. They too"}, {"type": "subtitle", "time": 1518.95, "timestamp": "00:25:18", "text": "could become sacrifices for those of"}, {"type": "subtitle", "time": 1521.11, "timestamp": "00:25:21", "text": "others."}, {"type": "subtitle", "time": 1524.47, "timestamp": "00:25:24", "text": "Lamp believed"}, {"type": "subtitle", "time": 1530.87, "timestamp": "00:25:30", "text": "Meanwhile, some lambs reasoned that"}, {"type": "subtitle", "time": 1532.71, "timestamp": "00:25:32", "text": "since they had already risked being"}, {"type": "subtitle", "time": 1535.83, "timestamp": "00:25:35", "text": "sacrificed for someone else's wish, it"}, {"type": "subtitle", "time": 1538.789, "timestamp": "00:25:38", "text": "was then only fair to pass on that risk"}, {"type": "subtitle", "time": 1541.35, "timestamp": "00:25:41", "text": "for a chance at fulfilling their own"}, {"type": "subtitle", "time": 1544.71, "timestamp": "00:25:44", "text": "desires. And so they continued to play"}, {"type": "subtitle", "time": 1547.83, "timestamp": "00:25:47", "text": "the game."}, {"type": "subtitle", "time": 1550.87, "timestamp": "00:25:50", "text": "They all knew the consequences, chose to"}, {"type": "subtitle", "time": 1557.909, "timestamp": "00:25:57", "text": "fearful yet greedy. Fearful yet greedy."}]
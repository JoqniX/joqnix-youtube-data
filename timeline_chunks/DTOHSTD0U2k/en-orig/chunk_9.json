[{"type": "subtitle", "time": 543.43, "timestamp": "00:09:03", "text": "First, who are the players in our tale?"}, {"type": "subtitle", "time": 547.35, "timestamp": "00:09:07", "text": "An innocent girl, a revered leader, and"}, {"type": "subtitle", "time": 551.19, "timestamp": "00:09:11", "text": "a flock of simple villagers."}, {"type": "subtitle", "time": 555.509, "timestamp": "00:09:15", "text": "Next, what makes up our main plot?"}, {"type": "subtitle", "time": 559.19, "timestamp": "00:09:19", "text": "false devotion, fleeting kindness,"}, {"type": "subtitle", "time": 562.23, "timestamp": "00:09:22", "text": "collective deceit, senseless killings,"}, {"type": "subtitle", "time": 565.67, "timestamp": "00:09:25", "text": "and the one vulnerable soul pushed onto"}, {"type": "subtitle", "time": 569.99, "timestamp": "00:09:29", "text": "a path of destruction by the masses."}, {"type": "subtitle", "time": 572.55, "timestamp": "00:09:32", "text": "What?"}, {"type": "subtitle", "time": 581.75, "timestamp": "00:09:41", "text": "I'm eager to hear your version after"}, {"type": "subtitle", "time": 588.389, "timestamp": "00:09:48", "text": "[Music]"}]
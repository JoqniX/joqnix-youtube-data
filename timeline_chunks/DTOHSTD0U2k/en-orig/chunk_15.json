[{"type": "subtitle", "time": 900.31, "timestamp": "00:15:00", "text": "Uhhuh. The shepherd brought them"}, {"type": "subtitle", "time": 904.069, "timestamp": "00:15:04", "text": "promises of abundance and protection."}, {"type": "subtitle", "time": 907.43, "timestamp": "00:15:07", "text": "The lambs drawn in by his words soon"}, {"type": "subtitle", "time": 921.43, "timestamp": "00:15:21", "text": "quite the opposite. The shepherd's"}, {"type": "subtitle", "time": 923.75, "timestamp": "00:15:23", "text": "arrival is only the beginning. With a"}, {"type": "subtitle", "time": 926.15, "timestamp": "00:15:26", "text": "wave of his hand, the shepherd could"}, {"type": "subtitle", "time": 930.15, "timestamp": "00:15:30", "text": "grant their every wish. Ah, his flock"}, {"type": "subtitle", "time": 933.75, "timestamp": "00:15:33", "text": "obeyed, bowing their heads, pleading for"}, {"type": "subtitle", "time": 936.55, "timestamp": "00:15:36", "text": "better food and shelter. They no longer"}, {"type": "subtitle", "time": 939.35, "timestamp": "00:15:39", "text": "had to struggle for survival. As their"}, {"type": "subtitle", "time": 942.47, "timestamp": "00:15:42", "text": "once meager lives were replaced with"}, {"type": "subtitle", "time": 945.35, "timestamp": "00:15:45", "text": "endless luxury, the flock worshiped"}, {"type": "subtitle", "time": 948.71, "timestamp": "00:15:48", "text": "their shepherd turned god, praising him"}, {"type": "subtitle", "time": 952.069, "timestamp": "00:15:52", "text": "and holding him. What's wrong? Does my"}, {"type": "subtitle", "time": 955.03, "timestamp": "00:15:55", "text": "imagine you were one of those lambs"}, {"type": "subtitle", "time": 959.11, "timestamp": "00:15:59", "text": "facing irresistible temptation and"}]
[{"type": "subtitle", "time": 302.15, "timestamp": "00:05:02", "text": "That makes sense given how fragile you"}, {"type": "subtitle", "time": 304.07, "timestamp": "00:05:04", "text": "were when you woke up or I would have"}, {"type": "subtitle", "time": 305.67, "timestamp": "00:05:05", "text": "questioned the authenticity of those"}, {"type": "subtitle", "time": 307.73, "timestamp": "00:05:07", "text": "rumors."}, {"type": "subtitle", "time": 309.99, "timestamp": "00:05:09", "text": "[Music]"}, {"type": "subtitle", "time": 312.31, "timestamp": "00:05:12", "text": "You followed me."}, {"type": "subtitle", "time": 317.43, "timestamp": "00:05:17", "text": "So, you noticed. Oh, I am flattered."}, {"type": "subtitle", "time": 320.71, "timestamp": "00:05:20", "text": "Stalker on edge. By now, you should have"}, {"type": "subtitle", "time": 327.749, "timestamp": "00:05:27", "text": "[Music]"}, {"type": "subtitle", "time": 330.71, "timestamp": "00:05:30", "text": "But out of all the onlookers,"}, {"type": "subtitle", "time": 333.029, "timestamp": "00:05:33", "text": "I'm the only one who came forward to"}, {"type": "subtitle", "time": 337.029, "timestamp": "00:05:37", "text": "meet you with absolute honesty. Before"}, {"type": "subtitle", "time": 339.99, "timestamp": "00:05:39", "text": "you knew anything about this world, you"}, {"type": "subtitle", "time": 347.59000000000003, "timestamp": "00:05:47", "text": "You are the unknown variable we've been"}, {"type": "subtitle", "time": 349.51, "timestamp": "00:05:49", "text": "waiting."}, {"type": "subtitle", "time": 352.15, "timestamp": "00:05:52", "text": "Forces have been fighting for possession"}, {"type": "subtitle", "time": 355.27, "timestamp": "00:05:55", "text": "over you. From the moment you opened"}, {"type": "subtitle", "time": 357.59000000000003, "timestamp": "00:05:57", "text": "your eyes, everyone you've met,"}, {"type": "subtitle", "time": 359.99, "timestamp": "00:05:59", "text": "including that girl you care so much"}]
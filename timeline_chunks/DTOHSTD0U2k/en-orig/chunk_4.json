[{"type": "subtitle", "time": 243.99, "timestamp": "00:04:03", "text": "yes, I am Scar. Who are you again? Cruel"}, {"type": "subtitle", "time": 246.0, "timestamp": "00:04:06", "text": "and twisted maniac."}, {"type": "subtitle", "time": 249.429, "timestamp": "00:04:09", "text": "[Music]"}, {"type": "subtitle", "time": 252.149, "timestamp": "00:04:12", "text": "Where's Yan? We deserve a meeting free"}, {"type": "subtitle", "time": 257.03, "timestamp": "00:04:17", "text": "of such disturbances. Don't you agree?"}, {"type": "subtitle", "time": 259.509, "timestamp": "00:04:19", "text": "The girl, she's going to sway your"}, {"type": "subtitle", "time": 261.59, "timestamp": "00:04:21", "text": "judgment."}, {"type": "subtitle", "time": 266.629, "timestamp": "00:04:26", "text": "Go back to me. Oi. Aw. So, you really"}, {"type": "subtitle", "time": 269.99, "timestamp": "00:04:29", "text": "care about her? Don't worry. I don't"}, {"type": "subtitle", "time": 272.71, "timestamp": "00:04:32", "text": "plan to make you hate me just yet. She"}, {"type": "subtitle", "time": 275.67, "timestamp": "00:04:35", "text": "is safe now."}, {"type": "subtitle", "time": 278.07, "timestamp": "00:04:38", "text": "Well, let's just enjoy our time together"}, {"type": "subtitle", "time": 280.55, "timestamp": "00:04:40", "text": "for the moment. Forget about that. You"}, {"type": "subtitle", "time": 283.43, "timestamp": "00:04:43", "text": "got a B? Yeah, I did. I have you"}, {"type": "subtitle", "time": 290.87, "timestamp": "00:04:50", "text": "to begin with. I heard you've lost your"}, {"type": "subtitle", "time": 292.79, "timestamp": "00:04:52", "text": "memories."}, {"type": "subtitle", "time": 299.83, "timestamp": "00:04:59", "text": "So, it's true."}]
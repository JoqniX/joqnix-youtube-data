[{"type": "subtitle", "time": 1321.43, "timestamp": "00:22:01", "text": "他掌握着所有权力，可以满足所有人的愿望。"}, {"type": "subtitle", "time": 1326.23, "timestamp": "00:22:06", "text": "但要付出代价。小羊羔们已经知道其中的风险。"}, {"type": "subtitle", "time": 1329.83, "timestamp": "00:22:09", "text": "屈服于诱惑。不幸的是，在"}, {"type": "subtitle", "time": 1332.23, "timestamp": "00:22:12", "text": "面对这样的诱惑，他们"}, {"type": "subtitle", "time": 1335.59, "timestamp": "00:22:15", "text": "完全忽视了所有隐藏的风险"}, {"type": "subtitle", "time": 1338.63, "timestamp": "00:22:18", "text": "灾难尚未降临到他们身上。如果他们"}, {"type": "subtitle", "time": 1341.11, "timestamp": "00:22:21", "text": "我相信，如果他们能得到另一次机会的话。"}, {"type": "subtitle", "time": 1344.47, "timestamp": "00:22:24", "text": "他们仍然会选择同样的道路。"}, {"type": "subtitle", "time": 1347.27, "timestamp": "00:22:27", "text": "他们最终还是接受了自己的命运。"}, {"type": "subtitle", "time": 1350.47, "timestamp": "00:22:30", "text": "他们终究付出了代价。"}, {"type": "subtitle", "time": 1353.83, "timestamp": "00:22:33", "text": "现在，我的第二个问题是："}, {"type": "subtitle", "time": 1356.47, "timestamp": "00:22:36", "text": "这些羔羊为它们付出了怎样的代价？"}, {"type": "subtitle", "time": 1358.95, "timestamp": "00:22:38", "text": "有什么愿望？"}, {"type": "subtitle", "time": 1361.669, "timestamp": "00:22:41", "text": "呃"}, {"type": "subtitle", "time": 1365.43, "timestamp": "00:22:45", "text": "他们的生活。当然，一如既往，生活"}, {"type": "subtitle", "time": 1367.75, "timestamp": "00:22:47", "text": "是他们最宝贵的东西"}, {"type": "subtitle", "time": 1372.07, "timestamp": "00:22:52", "text": "提供。这是我的最后一个问题。"}, {"type": "subtitle", "time": 1375.51, "timestamp": "00:22:55", "text": "那只黑色小羊羔怎么了？"}, {"type": "subtitle", "time": 1379.51, "timestamp": "00:22:59", "text": "别着急，罗孚。慢慢来。好的。"}]
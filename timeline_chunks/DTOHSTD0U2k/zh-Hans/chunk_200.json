[{"type": "subtitle", "time": 12009.91, "timestamp": "03:20:09", "text": "所以Willow死了。我猜是柳树"}, {"type": "subtitle", "time": 12012.95, "timestamp": "03:20:12", "text": "中枪了，对吧？不知道。增加"}, {"type": "subtitle", "time": 12015.07, "timestamp": "03:20:15", "text": "有罪。是吗？"}, {"type": "subtitle", "time": 12018.389, "timestamp": "03:20:18", "text": "[笑声]"}, {"type": "subtitle", "time": 12021.269, "timestamp": "03:20:21", "text": "我的天哪，她的声音听起来好可爱。什么？"}, {"type": "subtitle", "time": 12024.229, "timestamp": "03:20:24", "text": "但为什么是苏阿？为什么会有人这么做？"}, {"type": "subtitle", "time": 12033.75, "timestamp": "03:20:33", "text": "我真的无法相信"}, {"type": "subtitle", "time": 12037.349, "timestamp": "03:20:37", "text": "我在地图上看到了。等待。是的，我的天"}, {"type": "subtitle", "time": 12040.95, "timestamp": "03:20:40", "text": "是的，你可以点击地图。"}, {"type": "subtitle", "time": 12042.3, "timestamp": "03:20:42", "text": "什么？"}, {"type": "subtitle", "time": 12044.389, "timestamp": "03:20:44", "text": "[笑声]"}, {"type": "subtitle", "time": 12047.67, "timestamp": "03:20:47", "text": "好的。所以，找到了像医院一样的尸体"}, {"type": "subtitle", "time": 12051.349, "timestamp": "03:20:51", "text": "所以它就在医院楼上，对吧？呃"}, {"type": "subtitle", "time": 12053.03, "timestamp": "03:20:53", "text": "就是这样。我当时只是在闲逛"}, {"type": "subtitle", "time": 12055.83, "timestamp": "03:20:55", "text": "医院，我在洛杉矶犯罪调查局有一项任务。"}, {"type": "subtitle", "time": 12058.95, "timestamp": "03:20:58", "text": "所以，我当时正要去医院，还撒谎了。"}]
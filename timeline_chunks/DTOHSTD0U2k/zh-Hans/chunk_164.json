[{"type": "subtitle", "time": 9842.469, "timestamp": "02:44:02", "text": "说出来。不，是他给我发短信的。"}, {"type": "subtitle", "time": 9844.95, "timestamp": "02:44:04", "text": "不，你们"}, {"type": "subtitle", "time": 9847.03, "timestamp": "02:44:07", "text": "我们来玩游戏吧。等等，这就是谜团吗？"}, {"type": "subtitle", "time": 9849.75, "timestamp": "02:44:09", "text": "现在加入还是暂时不加入？我可能"}, {"type": "subtitle", "time": 9853.19, "timestamp": "02:44:13", "text": "需要去了解一下他们的情况。"}, {"type": "subtitle", "time": 9855.75, "timestamp": "02:44:15", "text": "我很确定。哦，你知道，你知道"}, {"type": "subtitle", "time": 9857.429, "timestamp": "02:44:17", "text": "他们。谁是负责多元化招聘的人员？告诉"}, {"type": "subtitle", "time": 9859.99, "timestamp": "02:44:19", "text": "我。我很确定他们不会。"}, {"type": "subtitle", "time": 9862.71, "timestamp": "02:44:22", "text": "是的。"}, {"type": "subtitle", "time": 9864.469, "timestamp": "02:44:24", "text": "你能告诉我他们是谁吗？"}, {"type": "subtitle", "time": 9869.03, "timestamp": "02:44:29", "text": "不，我不知道。没有。是她。"}, {"type": "subtitle", "time": 9872.389, "timestamp": "02:44:32", "text": "没关系。妈妈。妈妈。是她。"}, {"type": "subtitle", "time": 9874.79, "timestamp": "02:44:34", "text": "你们想要什么样的地图？先生。"}, {"type": "subtitle", "time": 9877.11, "timestamp": "02:44:37", "text": "兽。我想要那张地图。你知道的"}, {"type": "subtitle", "time": 9884.469, "timestamp": "02:44:44", "text": "是的。那"}, {"type": "subtitle", "time": 9886.95, "timestamp": "02:44:46", "text": "对，我想要那张地图。我不"}, {"type": "subtitle", "time": 9891.75, "timestamp": "02:44:51", "text": "像Cor。是啊，我也不知道。"}, {"type": "subtitle", "time": 9894.55, "timestamp": "02:44:54", "text": "那就像太多了"}]
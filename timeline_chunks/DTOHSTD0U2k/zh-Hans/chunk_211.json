[{"type": "subtitle", "time": 12662.71, "timestamp": "03:31:02", "text": "你误会我的意思了。我的天哪。抱歉各位。我的"}, {"type": "subtitle", "time": 12668.15, "timestamp": "03:31:08", "text": "坏的。我们这里有一些人。请。"}, {"type": "subtitle", "time": 12676.79, "timestamp": "03:31:16", "text": "请你自我介绍一下。"}, {"type": "subtitle", "time": 12681.51, "timestamp": "03:31:21", "text": "埃里克。对不起。等待。 Ro在这里。不。是的。"}, {"type": "subtitle", "time": 12684.79, "timestamp": "03:31:24", "text": "他在哪儿？在哪里？"}, {"type": "subtitle", "time": 12689.03, "timestamp": "03:31:29", "text": "他在那里。所有人都围住了他。"}, {"type": "subtitle", "time": 12690.87, "timestamp": "03:31:30", "text": "哦，那是因为你没给他"}, {"type": "subtitle", "time": 12705.67, "timestamp": "03:31:45", "text": "有人正在进行建筑施工"}, {"type": "subtitle", "time": 12707.349, "timestamp": "03:31:47", "text": "请自我介绍。是的，我们是"}, {"type": "subtitle", "time": 12709.67, "timestamp": "03:31:49", "text": "等着他。你做的。大家"}, {"type": "subtitle", "time": 12710.95, "timestamp": "03:31:50", "text": "赶紧离开这里"}, {"type": "subtitle", "time": 12714.15, "timestamp": "03:31:54", "text": "方式。是的。"}, {"type": "subtitle", "time": 12717.51, "timestamp": "03:31:57", "text": "远离他们。是的。远离"}]
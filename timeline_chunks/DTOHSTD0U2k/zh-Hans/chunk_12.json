[{"type": "subtitle", "time": 720.71, "timestamp": "00:12:00", "text": "仍然很小。我会尽我所能继续"}, {"type": "subtitle", "time": 723.509, "timestamp": "00:12:03", "text": "保护村庄免受……"}, {"type": "subtitle", "time": 727.11, "timestamp": "00:12:07", "text": "被薄盘侵入。好的。"}, {"type": "subtitle", "time": 732.87, "timestamp": "00:12:12", "text": "我们的故事从这里开始。哦，很久很久以前"}, {"type": "subtitle", "time": 736.15, "timestamp": "00:12:16", "text": "在一个宁静的村庄里，住着一群鸟。"}, {"type": "subtitle", "time": 739.269, "timestamp": "00:12:19", "text": "无忧无虑的小羊羔。白天他们"}, {"type": "subtitle", "time": 743.19, "timestamp": "00:12:23", "text": "他们辛勤劳作，只为获取食物，直到夜幕降临。"}, {"type": "subtitle", "time": 745.67, "timestamp": "00:12:25", "text": "他们寻求庇护，以躲避迫在眉睫的灾难"}, {"type": "subtitle", "time": 748.47, "timestamp": "00:12:28", "text": "狼群的威胁。"}, {"type": "subtitle", "time": 751.03, "timestamp": "00:12:31", "text": "好的。寓言故事。"}, {"type": "subtitle", "time": 753.509, "timestamp": "00:12:33", "text": "故事通过……被讲述和重述"}, {"type": "subtitle", "time": 756.629, "timestamp": "00:12:36", "text": "年龄。古老的传递艺术"}, {"type": "subtitle", "time": 759.43, "timestamp": "00:12:39", "text": "虚构作品中隐藏的真相。但他们"}, {"type": "subtitle", "time": 762.23, "timestamp": "00:12:42", "text": "他们总是从现实生活中汲取灵感，不是吗？"}, {"type": "subtitle", "time": 765.829, "timestamp": "00:12:45", "text": "现实生活。好的。同样的故事又发生了。"}, {"type": "subtitle", "time": 769.35, "timestamp": "00:12:49", "text": "很多人都这么说。每个人都带来了"}, {"type": "subtitle", "time": 772.55, "timestamp": "00:12:52", "text": "他们自己的解读。他们自己的。是的。你好，"}, {"type": "subtitle", "time": 774.949, "timestamp": "00:12:54", "text": "罗伯特·杰克逊。欢迎。从中吸取教训"}, {"type": "subtitle", "time": 777.67, "timestamp": "00:12:57", "text": "这只是无数种不同情况中的一种。"}, {"type": "subtitle", "time": 779.43, "timestamp": "00:12:59", "text": "解释"}]
[{"type": "subtitle", "time": 18923.91, "timestamp": "05:15:23", "text": "不杀生。别杀我。我离线了。哟，"}, {"type": "subtitle", "time": 18924.948, "timestamp": "05:15:24", "text": "这是怎么回事？这是怎么回事？这是怎么回事？不，不"}, {"type": "subtitle", "time": 18927.67, "timestamp": "05:15:27", "text": "不。我不会杀了它。"}, {"type": "subtitle", "time": 18930.47, "timestamp": "05:15:30", "text": "好的。我的不在场证明。我把它当成一项任务来做"}, {"type": "subtitle", "time": 18936.23, "timestamp": "05:15:36", "text": "前方。好的。你好。过来。"}, {"type": "subtitle", "time": 18938.31, "timestamp": "05:15:38", "text": "这项任务需要很长时间，对吧？我不"}, {"type": "subtitle", "time": 18941.59, "timestamp": "05:15:41", "text": "想体验恐惧。"}, {"type": "subtitle", "time": 18945.59, "timestamp": "05:15:45", "text": "好的。好的。我们可以走了。我受够了。想要"}, {"type": "subtitle", "time": 18947.51, "timestamp": "05:15:47", "text": "去广场吗？哦，有个任务"}, {"type": "subtitle", "time": 18951.11, "timestamp": "05:15:51", "text": "这里。这样做。好的。"}, {"type": "subtitle", "time": 18952.708, "timestamp": "05:15:52", "text": "你知道，有不在场证明是件好事。"}, {"type": "subtitle", "time": 18957.11, "timestamp": "05:15:57", "text": "你好。这是怎么回事？我是"}]
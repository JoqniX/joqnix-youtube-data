[{"type": "subtitle", "time": 1680.789, "timestamp": "00:28:00", "text": "我越来越喜欢你了。那好吧"}, {"type": "subtitle", "time": 1683.909, "timestamp": "00:28:03", "text": "让我们看看这只黑羊羔会怎么样"}, {"type": "subtitle", "time": 1686.52, "timestamp": "00:28:06", "text": "结果就像你说的那样。"}, {"type": "subtitle", "time": 1697.75, "timestamp": "00:28:17", "text": "那就是牧羊人。标志。哦，"}, {"type": "subtitle", "time": 1700.549, "timestamp": "00:28:20", "text": "老板。等等，等等，让我进去一下，我刚才还在里面。"}, {"type": "subtitle", "time": 1702.95, "timestamp": "00:28:22", "text": "我的天哪。"}, {"type": "subtitle", "time": 1708.07, "timestamp": "00:28:28", "text": "等待。"}, {"type": "subtitle", "time": 1712.87, "timestamp": "00:28:32", "text": "我的天啊，是主席。主席"}, {"type": "subtitle", "time": 1731.59, "timestamp": "00:28:51", "text": "怎么样了？"}, {"type": "subtitle", "time": 1736.31, "timestamp": "00:28:56", "text": "欢迎来到无尽混乱的领域。"}]
[{"type": "subtitle", "time": 13986.15, "timestamp": "03:53:06", "text": "有两种选择。妈的。妈的。我"}, {"type": "subtitle", "time": 13988.79, "timestamp": "03:53:08", "text": "我说完了整件事，我坚持住。好的。"}, {"type": "subtitle", "time": 13990.309, "timestamp": "03:53:10", "text": "我全程都用静音模式说了出来。好的。"}, {"type": "subtitle", "time": 13993.269, "timestamp": "03:53:13", "text": "我再说一遍。我和雷格"}, {"type": "subtitle", "time": 13995.429, "timestamp": "03:53:15", "text": "尸体在小教堂里，就在那里。"}, {"type": "subtitle", "time": 13997.11, "timestamp": "03:53:17", "text": "是另一个人。我不记得是谁了。"}, {"type": "subtitle", "time": 13998.63, "timestamp": "03:53:18", "text": "但我听说了这件事。我听到了他们的声音"}, {"type": "subtitle", "time": 14001.91, "timestamp": "03:53:21", "text": "我认为是真人，因为我可以作证。"}, {"type": "subtitle", "time": 14004.309, "timestamp": "03:53:24", "text": "氧气。呃，韩韩。你还能是谁？"}, {"type": "subtitle", "time": 14006.79, "timestamp": "03:53:26", "text": "逃离什么？韩韩。呃，我是"}, {"type": "subtitle", "time": 14010.389, "timestamp": "03:53:30", "text": "逃离你。我当时就像……"}, {"type": "subtitle", "time": 14012.55, "timestamp": "03:53:32", "text": "那里"}, {"type": "subtitle", "time": 14015.349, "timestamp": "03:53:35", "text": "他们在一起。"}, {"type": "subtitle", "time": 14018.469, "timestamp": "03:53:38", "text": "呃，我看到了"}, {"type": "subtitle", "time": 14020.95, "timestamp": "03:53:40", "text": "我上去的时候看到了韩"}, {"type": "subtitle", "time": 14028.469, "timestamp": "03:53:48", "text": "不是我。听我说。坚持，稍等。"}, {"type": "subtitle", "time": 14031.189, "timestamp": "03:53:51", "text": "听我说。是的。我觉得是她。"}, {"type": "subtitle", "time": 14033.269, "timestamp": "03:53:53", "text": "是她。我听到了他们的声音。好的。我"}, {"type": "subtitle", "time": 14034.95, "timestamp": "03:53:54", "text": "我在里面的时候听到了他们的声音。"}, {"type": "subtitle", "time": 14037.59, "timestamp": "03:53:57", "text": "屏幕突然黑屏，然后就死了。我看到了弹出窗口"}, {"type": "subtitle", "time": 14039.59, "timestamp": "03:53:59", "text": "那位名人去世了。于是我看了看"}]
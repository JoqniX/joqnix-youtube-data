[{"type": "subtitle", "time": 16741.189, "timestamp": "04:39:01", "text": "真是吓人。不，兄弟。我当时"}, {"type": "subtitle", "time": 16744.23, "timestamp": "04:39:04", "text": "坠落。 Yoshi当时就像在尖叫。所以"}, {"type": "subtitle", "time": 16746.869, "timestamp": "04:39:06", "text": "我不确定她是不是，我觉得她是。"}, {"type": "subtitle", "time": 16749.349, "timestamp": "04:39:09", "text": "就是那个，但我喜欢，我有点害怕"}, {"type": "subtitle", "time": 16754.15, "timestamp": "04:39:14", "text": "否。嗯。和"}, {"type": "subtitle", "time": 16756.949, "timestamp": "04:39:16", "text": "因为她……我可以和你们一起玩吗？"}, {"type": "subtitle", "time": 16759.75, "timestamp": "04:39:19", "text": "氧气。氧气。我在这里。我在这里。我在旁边"}, {"type": "subtitle", "time": 16763.029, "timestamp": "04:39:23", "text": "你。好的。好的。好的。好的。"}, {"type": "subtitle", "time": 16765.189, "timestamp": "04:39:25", "text": "等待。为什么他不跟我说话？龙"}, {"type": "subtitle", "time": 16770.869, "timestamp": "04:39:30", "text": "为什么？哦好的。你好。"}, {"type": "subtitle", "time": 16773.83, "timestamp": "04:39:33", "text": "你的声音是"}, {"type": "subtitle", "time": 16777.029, "timestamp": "04:39:37", "text": "是的，声音有点低。乔克，拿着"}, {"type": "subtitle", "time": 16780.47, "timestamp": "04:39:40", "text": "少量。乔克，稍等一下。你好。好的，乔。"}, {"type": "subtitle", "time": 16783.99, "timestamp": "04:39:43", "text": "你能说句话吗？你好。你好。"}, {"type": "subtitle", "time": 16785.11, "timestamp": "04:39:45", "text": "好的。好的。等一下。我能听到"}, {"type": "subtitle", "time": 16786.868, "timestamp": "04:39:46", "text": "现在轮到你了。等一下。等一下。"}, {"type": "subtitle", "time": 16790.07, "timestamp": "04:39:50", "text": "嗯，Ch，你能说我是冒名顶替者吗？"}, {"type": "subtitle", "time": 16792.948, "timestamp": "04:39:52", "text": "为什么？"}, {"type": "subtitle", "time": 16794.07, "timestamp": "04:39:54", "text": "仅用于测试。只是为了"}, {"type": "subtitle", "time": 16795.35, "timestamp": "04:39:55", "text": "测试。仅用于测试。它是"}, {"type": "subtitle", "time": 16797.67, "timestamp": "04:39:57", "text": "仅用于测试。不，等等。你要走了"}]
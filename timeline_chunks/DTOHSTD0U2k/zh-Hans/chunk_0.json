[{"type": "subtitle", "time": 4.07, "timestamp": "00:00:04", "text": "蒂尔达·比斯利。好的。"}, {"type": "subtitle", "time": 5.59, "timestamp": "00:00:05", "text": "好的。所以，这里不是我该来的地方。"}, {"type": "subtitle", "time": 7.909, "timestamp": "00:00:07", "text": "通缉。等等，让我看看哪里"}, {"type": "subtitle", "time": 10.95, "timestamp": "00:00:10", "text": "她是怎么下去的？哦，等等。她"}, {"type": "subtitle", "time": 20.95, "timestamp": "00:00:20", "text": "我最好多留意高处。"}, {"type": "subtitle", "time": 24.23, "timestamp": "00:00:24", "text": "在学校周围，为了泽诺比亚的咕噜声。"}, {"type": "subtitle", "time": 28.95, "timestamp": "00:00:28", "text": "哦，这块石块卡在它下面了。"}, {"type": "subtitle", "time": 48.869, "timestamp": "00:00:48", "text": "哦，原来它一直都在这里。哦"}, {"type": "subtitle", "time": 55.189, "timestamp": "00:00:55", "text": "你现在在忙什么？"}, {"type": "subtitle", "time": 57.67, "timestamp": "00:00:57", "text": "我不知道。"}]
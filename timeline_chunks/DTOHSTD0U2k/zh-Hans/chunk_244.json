[{"type": "subtitle", "time": 14640.79, "timestamp": "04:04:00", "text": "兄弟，她有很多时间打扫房间。我"}, {"type": "subtitle", "time": 14643.59, "timestamp": "04:04:03", "text": "我知道那是谎言。我告诉你了。只是"}, {"type": "subtitle", "time": 14648.55, "timestamp": "04:04:08", "text": "递给我，狗狗。我会帮你。"}, {"type": "subtitle", "time": 14651.59, "timestamp": "04:04:11", "text": "所以，我只知道鸽子。"}, {"type": "subtitle", "time": 14654.87, "timestamp": "04:04:14", "text": "卷。所以，各位，我其实就是想……"}, {"type": "subtitle", "time": 14656.79, "timestamp": "04:04:16", "text": "回报那位想要帮助的人"}, {"type": "subtitle", "time": 14659.03, "timestamp": "04:04:19", "text": "杀了我。所以我问你，奥克西，你是不是"}, {"type": "subtitle", "time": 14660.95, "timestamp": "04:04:20", "text": "就像之前那只该死的鸽子一样，我"}, {"type": "subtitle", "time": 14664.95, "timestamp": "04:04:24", "text": "当时我就想，对啊，就是它，对吧？"}, {"type": "subtitle", "time": 14667.189, "timestamp": "04:04:27", "text": "好的，递给我。是的，我当时"}, {"type": "subtitle", "time": 14668.55, "timestamp": "04:04:28", "text": "就像在等你把它传给我一样"}, {"type": "subtitle", "time": 14671.429, "timestamp": "04:04:31", "text": "我可以把它传给其他人。"}, {"type": "subtitle", "time": 14673.67, "timestamp": "04:04:33", "text": "我知道它是如何运作的。她不得不这样做，她有"}, {"type": "subtitle", "time": 14677.91, "timestamp": "04:04:37", "text": "就像把它送给所有人一样。"}, {"type": "subtitle", "time": 14680.389, "timestamp": "04:04:40", "text": "哦，她有。哦，她必须有。是的，她"}, {"type": "subtitle", "time": 14682.229, "timestamp": "04:04:42", "text": "必须如此。是的，她得去碰一下。"}, {"type": "subtitle", "time": 14685.269, "timestamp": "04:04:45", "text": "每个人。该死。我无法传播它。"}, {"type": "subtitle", "time": 14687.189, "timestamp": "04:04:47", "text": "那只猎鹰呢？当我……的时候，他们就死了。"}, {"type": "subtitle", "time": 14689.75, "timestamp": "04:04:49", "text": "感染他们。我会吗？他们会在我的时候死去吗？"}, {"type": "subtitle", "time": 14691.91, "timestamp": "04:04:51", "text": "会感染他们吗？不，他们不会。不，他们"}, {"type": "subtitle", "time": 14694.309, "timestamp": "04:04:54", "text": "不。他们只是被感染了。是的。"}, {"type": "subtitle", "time": 14698.309, "timestamp": "04:04:58", "text": "是的。好的。我必须尽可能地了解人们。"}]
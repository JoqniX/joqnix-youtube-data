[{"type": "subtitle", "time": 10447.429, "timestamp": "02:54:07", "text": "我应该没事的。哦，你会说话了。这"}, {"type": "subtitle", "time": 10449.75, "timestamp": "02:54:09", "text": "这是我们能够做到的地方，而在这场游戏中，特伦"}, {"type": "subtitle", "time": 10452.15, "timestamp": "02:54:12", "text": "听起来你好像在说“是啊，我”"}, {"type": "subtitle", "time": 10455.91, "timestamp": "02:54:15", "text": "知道吧？你的声音听起来像只幽灵狗。"}, {"type": "subtitle", "time": 10460.95, "timestamp": "02:54:20", "text": "正确的。我是闲置的幽灵。"}, {"type": "subtitle", "time": 10464.389, "timestamp": "02:54:24", "text": "开始了。我可以从这里离开了。"}, {"type": "subtitle", "time": 10470.71, "timestamp": "02:54:30", "text": "是的。开始了。我可能需要这样做"}, {"type": "subtitle", "time": 10473.269, "timestamp": "02:54:33", "text": "哦，是的。我没有解锁任何皮肤。如何"}, {"type": "subtitle", "time": 10475.75, "timestamp": "02:54:35", "text": "你这样做吗？"}, {"type": "subtitle", "time": 10477.83, "timestamp": "02:54:37", "text": "好的。"}, {"type": "subtitle", "time": 10484.63, "timestamp": "02:54:44", "text": "下次我一定尽量不迟到。"}, {"type": "subtitle", "time": 10487.11, "timestamp": "02:54:47", "text": "像这样。我得出去布置一下"}, {"type": "subtitle", "time": 10490.07, "timestamp": "02:54:50", "text": "GSC那玩意儿。哦，是的。好的。所以我可以走了"}, {"type": "subtitle", "time": 10493.03, "timestamp": "02:54:53", "text": "下一个。我肯定"}, {"type": "subtitle", "time": 10495.349, "timestamp": "02:54:55", "text": "搬家了。有人将被调走。你好。"}, {"type": "subtitle", "time": 10498.55, "timestamp": "02:54:58", "text": "你好。你好。等等，谁不见了？"}]
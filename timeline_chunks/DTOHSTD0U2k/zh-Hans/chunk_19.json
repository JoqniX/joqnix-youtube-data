[{"type": "subtitle", "time": 1140.63, "timestamp": "00:19:00", "text": "给予更多、更多、更多。当每个"}, {"type": "subtitle", "time": 1143.43, "timestamp": "00:19:03", "text": "愿望是要付出沉重代价的，人们"}, {"type": "subtitle", "time": 1146.31, "timestamp": "00:19:06", "text": "他们仔细权衡了各种选择。"}, {"type": "subtitle", "time": 1148.71, "timestamp": "00:19:08", "text": "当他们能够让别人承担责任时"}, {"type": "subtitle", "time": 1151.51, "timestamp": "00:19:11", "text": "价格，"}, {"type": "subtitle", "time": 1155.669, "timestamp": "00:19:15", "text": "他们都争先恐后地许愿。他们"}, {"type": "subtitle", "time": 1159.11, "timestamp": "00:19:19", "text": "不要考虑他们有一天也可能付出代价。"}, {"type": "subtitle", "time": 1163.029, "timestamp": "00:19:23", "text": "出于另一种自私的欲望。真有意思，不是吗？"}, {"type": "subtitle", "time": 1165.49, "timestamp": "00:19:25", "text": "它？"}, {"type": "subtitle", "time": 1182.95, "timestamp": "00:19:42", "text": "好的，"}]
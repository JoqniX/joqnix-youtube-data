[{"type": "subtitle", "time": 9911.11, "timestamp": "02:45:11", "text": "你以前是怎么被欺负的？"}, {"type": "subtitle", "time": 9914.309, "timestamp": "02:45:14", "text": "游戏真的会开始吗？"}, {"type": "subtitle", "time": 9916.63, "timestamp": "02:45:16", "text": "她的履历确实令人印象深刻。"}, {"type": "subtitle", "time": 9919.83, "timestamp": "02:45:19", "text": "那里。她少了10根肋骨。公平的"}, {"type": "subtitle", "time": 9921.91, "timestamp": "02:45:21", "text": "足够的。"}, {"type": "subtitle", "time": 9924.469, "timestamp": "02:45:24", "text": "正确的。正确的。所以，我们目前就处于这个阶段。"}, {"type": "subtitle", "time": 9927.75, "timestamp": "02:45:27", "text": "据Sushi和Willow所说，很漂亮"}, {"type": "subtitle", "time": 9929.51, "timestamp": "02:45:29", "text": "很多东西都写着“欺凌光环”"}, {"type": "subtitle", "time": 9931.03, "timestamp": "02:45:31", "text": "超过。"}, {"type": "subtitle", "time": 9932.79, "timestamp": "02:45:32", "text": "我好像不知道。就像"}, {"type": "subtitle", "time": 9940.79, "timestamp": "02:45:40", "text": "我已发送链接。我添加了代码。"}, {"type": "subtitle", "time": 9943.59, "timestamp": "02:45:43", "text": "协作聊天。我把它链接到"}, {"type": "subtitle", "time": 9945.75, "timestamp": "02:45:45", "text": "观众。"}, {"type": "subtitle", "time": 9947.59, "timestamp": "02:45:47", "text": "我们走吧。"}, {"type": "subtitle", "time": 9950.469, "timestamp": "02:45:50", "text": "这将成为我的专长。那我再看看吧。"}, {"type": "subtitle", "time": 9953.269, "timestamp": "02:45:53", "text": "5分钟后见。好的。是的。就在这里。"}, {"type": "subtitle", "time": 9957.75, "timestamp": "02:45:57", "text": "是的。是的。我也开始直播吧。"}, {"type": "subtitle", "time": 9959.349, "timestamp": "02:45:59", "text": "是的。如果你们愿意的话，你们可以……"}]
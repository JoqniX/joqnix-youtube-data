[{"type": "subtitle", "time": 18066.23, "timestamp": "05:01:06", "text": "你好。什么？你好。你是冒名顶替者吗？"}, {"type": "subtitle", "time": 18069.03, "timestamp": "05:01:09", "text": "别这样。"}, {"type": "subtitle", "time": 18071.27, "timestamp": "05:01:11", "text": "我相信乔亚。"}, {"type": "subtitle", "time": 18078.07, "timestamp": "05:01:18", "text": "不是。"}, {"type": "subtitle", "time": 18079.99, "timestamp": "05:01:19", "text": "我很害怕。"}, {"type": "subtitle", "time": 18082.39, "timestamp": "05:01:22", "text": "她现在不说话。我的天啊。她是"}, {"type": "subtitle", "time": 18100.23, "timestamp": "05:01:40", "text": "好的。太快了。"}, {"type": "subtitle", "time": 18103.03, "timestamp": "05:01:43", "text": "骑师。乔克。坚持，稍等。你在做饭。"}, {"type": "subtitle", "time": 18106.708, "timestamp": "05:01:46", "text": "乔克。你在做饭。住口。"}, {"type": "subtitle", "time": 18110.15, "timestamp": "05:01:50", "text": "住口。我需要知道为什么。因为你"}, {"type": "subtitle", "time": 18113.27, "timestamp": "05:01:53", "text": "他们沉默不语。你沉默不语。我说话了"}, {"type": "subtitle", "time": 18115.83, "timestamp": "05:01:55", "text": "与你。你暴力地跟着我，就像"}, {"type": "subtitle", "time": 18118.31, "timestamp": "05:01:58", "text": "他知道是我。如何？你是怎么做到的？"}]
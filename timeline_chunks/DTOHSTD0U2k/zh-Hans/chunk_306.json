[{"type": "subtitle", "time": 18379.19, "timestamp": "05:06:19", "text": "他妈的。我就知道我知道。等等，什么？"}, {"type": "subtitle", "time": 18384.07, "timestamp": "05:06:24", "text": "去你的。或者，我是吗？等等，怎么做到的？等待，"}, {"type": "subtitle", "time": 18385.43, "timestamp": "05:06:25", "text": "坚持，稍等。我以为我已经"}, {"type": "subtitle", "time": 18387.43, "timestamp": "05:06:27", "text": "已感染。什么？"}, {"type": "subtitle", "time": 18388.788, "timestamp": "05:06:28", "text": "是的。不，我没有传染给你。为什么"}, {"type": "subtitle", "time": 18391.59, "timestamp": "05:06:31", "text": "你竟然这样碰我，老兄？哦好的。"}, {"type": "subtitle", "time": 18394.07, "timestamp": "05:06:34", "text": "兄弟，我早就知道自己被感染了。他"}, {"type": "subtitle", "time": 18395.75, "timestamp": "05:06:35", "text": "他当时就像是说：“伙计们，我不能……”"}, {"type": "subtitle", "time": 18397.99, "timestamp": "05:06:37", "text": "移动。我动不了。伙计们，我做不到。我"}, {"type": "subtitle", "time": 18404.23, "timestamp": "05:06:44", "text": "大家都往我这边走走。“哦，那个。”"}, {"type": "subtitle", "time": 18405.99, "timestamp": "05:06:45", "text": "完美。"}, {"type": "subtitle", "time": 18408.07, "timestamp": "05:06:48", "text": "你知道，在我下课之后，"}, {"type": "subtitle", "time": 18409.99, "timestamp": "05:06:49", "text": "我当兵之后，就想杀人。"}, {"type": "subtitle", "time": 18412.23, "timestamp": "05:06:52", "text": "有人，但我只认识吉野和"}, {"type": "subtitle", "time": 18416.31, "timestamp": "05:06:56", "text": "苏米，我不想杀他们。"}, {"type": "subtitle", "time": 18418.628, "timestamp": "05:06:58", "text": "我真是太幸运了。我只想杀人"}]
[{"type": "subtitle", "time": 7801.02, "timestamp": "02:10:01", "text": "这边？"}, {"type": "subtitle", "time": 7804.55, "timestamp": "02:10:04", "text": "[音乐]"}, {"type": "subtitle", "time": 7819.589, "timestamp": "02:10:19", "text": "更多老板。呃，敌人更多了。指引我"}, {"type": "subtitle", "time": 7821.27, "timestamp": "02:10:21", "text": "刀刃。"}, {"type": "subtitle", "time": 7827.189, "timestamp": "02:10:27", "text": "[音乐]"}, {"type": "subtitle", "time": 7829.91, "timestamp": "02:10:29", "text": "上升趋势。猩红。"}, {"type": "subtitle", "time": 7832.149, "timestamp": "02:10:32", "text": "灌注。"}, {"type": "subtitle", "time": 7852.31, "timestamp": "02:10:52", "text": "共鸣时刻。"}]
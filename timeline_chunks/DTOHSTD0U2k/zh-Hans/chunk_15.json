[{"type": "subtitle", "time": 900.31, "timestamp": "00:15:00", "text": "嗯哼。牧羊人把他们带了过来。"}, {"type": "subtitle", "time": 904.069, "timestamp": "00:15:04", "text": "承诺带来富足和庇护。"}, {"type": "subtitle", "time": 907.43, "timestamp": "00:15:07", "text": "他的话语吸引来的羔羊们很快"}, {"type": "subtitle", "time": 921.43, "timestamp": "00:15:21", "text": "恰恰相反。牧羊人的"}, {"type": "subtitle", "time": 923.75, "timestamp": "00:15:23", "text": "到达目的地仅仅是开始。与一个"}, {"type": "subtitle", "time": 926.15, "timestamp": "00:15:26", "text": "牧羊人挥了挥手，就能"}, {"type": "subtitle", "time": 930.15, "timestamp": "00:15:30", "text": "满足他们的每一个愿望。啊，他的羊群"}, {"type": "subtitle", "time": 933.75, "timestamp": "00:15:33", "text": "他们服从了，低着头，恳求道"}, {"type": "subtitle", "time": 936.55, "timestamp": "00:15:36", "text": "更好的食物和住所。他们不再"}, {"type": "subtitle", "time": 939.35, "timestamp": "00:15:39", "text": "不得不为生存而挣扎。他们的"}, {"type": "subtitle", "time": 942.47, "timestamp": "00:15:42", "text": "曾经卑微的生活被……所取代"}, {"type": "subtitle", "time": 945.35, "timestamp": "00:15:45", "text": "无尽的奢华，信徒们顶礼膜拜"}, {"type": "subtitle", "time": 948.71, "timestamp": "00:15:48", "text": "他们的牧羊人变成了神，赞美他"}, {"type": "subtitle", "time": 952.069, "timestamp": "00:15:52", "text": "并抱着他。怎么了？我的"}, {"type": "subtitle", "time": 955.03, "timestamp": "00:15:55", "text": "想象一下你是其中一只羔羊"}, {"type": "subtitle", "time": 959.11, "timestamp": "00:15:59", "text": "面对无法抗拒的诱惑和"}]
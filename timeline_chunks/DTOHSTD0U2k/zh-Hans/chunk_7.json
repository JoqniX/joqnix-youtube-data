[{"type": "subtitle", "time": 420.309, "timestamp": "00:07:00", "text": "多观察一下周围的环境。"}, {"type": "subtitle", "time": 422.7, "timestamp": "00:07:02", "text": "告诉我你看到了什么。"}, {"type": "subtitle", "time": 424.15, "timestamp": "00:07:04", "text": "[音乐]"}, {"type": "subtitle", "time": 426.87, "timestamp": "00:07:06", "text": "随着你对这个世界了解得越多，你的"}, {"type": "subtitle", "time": 430.469, "timestamp": "00:07:10", "text": "真正的欲望终将浮现，而我们的小小"}, {"type": "subtitle", "time": 435.189, "timestamp": "00:07:15", "text": "游戏将变得更加有趣。"}, {"type": "subtitle", "time": 437.99, "timestamp": "00:07:17", "text": "你说它很有趣？我不想那样"}, {"type": "subtitle", "time": 440.87, "timestamp": "00:07:20", "text": "任何人都可以打扰我宝贵的独处时光"}, {"type": "subtitle", "time": 445.029, "timestamp": "00:07:25", "text": "与你。就这样。"}, {"type": "subtitle", "time": 447.749, "timestamp": "00:07:27", "text": "H"}, {"type": "subtitle", "time": 449.99, "timestamp": "00:07:29", "text": "你为什么一定要假设我们是……"}, {"type": "subtitle", "time": 451.83, "timestamp": "00:07:31", "text": "罪魁祸首是谁？"}, {"type": "subtitle", "time": 453.67, "timestamp": "00:07:33", "text": "或许你应该问我什么"}, {"type": "subtitle", "time": 456.95, "timestamp": "00:07:36", "text": "这里确实发生过类似的事情。"}, {"type": "subtitle", "time": 459.67, "timestamp": "00:07:39", "text": "哦好的。那我到时候再问吧。我不会"}, {"type": "subtitle", "time": 462.23, "timestamp": "00:07:42", "text": "暂时还不该告诉你所有的事情。那太过了。"}, {"type": "subtitle", "time": 463.749, "timestamp": "00:07:43", "text": "无聊的。"}, {"type": "subtitle", "time": 466.15, "timestamp": "00:07:46", "text": "正如我所说，你何不看看呢？"}, {"type": "subtitle", "time": 469.51, "timestamp": "00:07:49", "text": "四处看看，自己去发现一下？"}, {"type": "subtitle", "time": 479.029, "timestamp": "00:07:59", "text": "M"}]
[{"type": "subtitle", "time": 19260.39, "timestamp": "05:21:00", "text": "他是唯一一个和我们在一起的人。"}, {"type": "subtitle", "time": 19262.15, "timestamp": "05:21:02", "text": "好的。"}, {"type": "subtitle", "time": 19267.59, "timestamp": "05:21:07", "text": "你好。它在左边。这一切都是"}, {"type": "subtitle", "time": 19270.47, "timestamp": "05:21:10", "text": "在左侧。正确的。好的。"}, {"type": "subtitle", "time": 19275.19, "timestamp": "05:21:15", "text": "我们一起去吧。你好。我们是"}, {"type": "subtitle", "time": 19276.788, "timestamp": "05:21:16", "text": "重新装弹。"}, {"type": "subtitle", "time": 19279.27, "timestamp": "05:21:19", "text": "什么？"}, {"type": "subtitle", "time": 19282.23, "timestamp": "05:21:22", "text": "你说的“杀”是什么意思？好的。"}, {"type": "subtitle", "time": 19284.948, "timestamp": "05:21:24", "text": "我的天啊。他不是。他不是。他不是"}, {"type": "subtitle", "time": 19291.67, "timestamp": "05:21:31", "text": "你们其中一人。你们其中一人。哦亲爱的。我不能"}, {"type": "subtitle", "time": 19293.99, "timestamp": "05:21:33", "text": "杀任何人。"}, {"type": "subtitle", "time": 19295.67, "timestamp": "05:21:35", "text": "等等，我还需要做三次"}, {"type": "subtitle", "time": 19297.11, "timestamp": "05:21:37", "text": "在我杀人之前。我想要，我想要"}, {"type": "subtitle", "time": 19300.55, "timestamp": "05:21:40", "text": "完成我的三件事。我的天哪。"}, {"type": "subtitle", "time": 19315.75, "timestamp": "05:21:55", "text": "呃，你们两个都是杀手。什么？"}, {"type": "subtitle", "time": 19319.51, "timestamp": "05:21:59", "text": "什么？久木怎么了？不。"}]
[{"type": "subtitle", "time": 2041.669, "timestamp": "00:34:01", "text": "你可别忘了这件事。"}, {"type": "subtitle", "time": 2043.75, "timestamp": "00:34:03", "text": "不要让你的即兴发挥惹麻烦"}, {"type": "subtitle", "time": 2046.95, "timestamp": "00:34:06", "text": "其他的。哇，配音太棒了！"}, {"type": "subtitle", "time": 2049.589, "timestamp": "00:34:09", "text": "瞧你冲进去保护你"}, {"type": "subtitle", "time": 2054.069, "timestamp": "00:34:14", "text": "珍贵完美的动作。不用担心。我"}, {"type": "subtitle", "time": 2056.71, "timestamp": "00:34:16", "text": "了解所有应该做和不应该做的事情。我不"}, {"type": "subtitle", "time": 2059.909, "timestamp": "00:34:19", "text": "需要你告诉我该怎么做。"}, {"type": "subtitle", "time": 2063.03, "timestamp": "00:34:23", "text": "罗孚，看来我们快乐的小约会"}, {"type": "subtitle", "time": 2065.669, "timestamp": "00:34:25", "text": "终究会结束。我们约会过。"}, {"type": "subtitle", "time": 2069.03, "timestamp": "00:34:29", "text": "忘了我的真诚吧。我的礼物呢？让"}, {"type": "subtitle", "time": 2071.99, "timestamp": "00:34:31", "text": "告诉我你的选择。意想不到的"}, {"type": "subtitle", "time": 2074.629, "timestamp": "00:34:34", "text": "礼物。哦，等等。"}, {"type": "subtitle", "time": 2076.55, "timestamp": "00:34:36", "text": "他将要"}, {"type": "subtitle", "time": 2079.129, "timestamp": "00:34:39", "text": "请我们帮您挑选礼物。好的。"}, {"type": "subtitle", "time": 2081.43, "timestamp": "00:34:41", "text": "[音乐]"}, {"type": "subtitle", "time": 2085.51, "timestamp": "00:34:45", "text": "选择权在你。我知道他有多聪明"}, {"type": "subtitle", "time": 2088.069, "timestamp": "00:34:48", "text": "你是。你不会仓促行事"}, {"type": "subtitle", "time": 2091.51, "timestamp": "00:34:51", "text": "决定。我们还会再见的"}, {"type": "subtitle", "time": 2093.03, "timestamp": "00:34:53", "text": "托斯蒂斯坦"}, {"type": "subtitle", "time": 2095.43, "timestamp": "00:34:55", "text": "未来。"}, {"type": "subtitle", "time": 2099.99, "timestamp": "00:34:59", "text": "他们走了。我们应该追捕他们吗？"}]
[{"type": "subtitle", "time": 18841.27, "timestamp": "05:14:01", "text": "那没用，对吧？说实话，我"}, {"type": "subtitle", "time": 18843.27, "timestamp": "05:14:03", "text": "比起派对，我更喜欢小丑。小丑"}, {"type": "subtitle", "time": 18845.35, "timestamp": "05:14:05", "text": "感觉好多了。"}, {"type": "subtitle", "time": 18848.23, "timestamp": "05:14:08", "text": "小丑。小丑是做什么的？小丑"}, {"type": "subtitle", "time": 18849.99, "timestamp": "05:14:09", "text": "至少可以用高浓度杀人。"}, {"type": "subtitle", "time": 18855.67, "timestamp": "05:14:15", "text": "投掷，但这个不行。哦。哦。嗯。"}, {"type": "subtitle", "time": 18858.628, "timestamp": "05:14:18", "text": "那应该是歌剧演员。"}, {"type": "subtitle", "time": 18861.43, "timestamp": "05:14:21", "text": "等等，他们都能杀人，而且都有技能。"}, {"type": "subtitle", "time": 18863.99, "timestamp": "05:14:23", "text": "正确的？我觉得这些很酷。"}, {"type": "subtitle", "time": 18865.75, "timestamp": "05:14:25", "text": "它们很可爱。"}, {"type": "subtitle", "time": 18868.07, "timestamp": "05:14:28", "text": "这样收集到的资金不够。我不是。"}, {"type": "subtitle", "time": 18870.628, "timestamp": "05:14:30", "text": "静音。所以，所以，所以这是否意味着"}, {"type": "subtitle", "time": 18873.03, "timestamp": "05:14:33", "text": "这个人需要被投票吗？"}]
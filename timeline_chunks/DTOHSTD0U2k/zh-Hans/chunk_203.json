[{"type": "subtitle", "time": 12192.229, "timestamp": "03:23:12", "text": "我正在执行这项任务。一秒钟。"}, {"type": "subtitle", "time": 12194.71, "timestamp": "03:23:14", "text": "是啊，你真的做了件了不起的事。"}, {"type": "subtitle", "time": 12197.59, "timestamp": "03:23:17", "text": "通过自我报告，因为兄弟，为什么？"}, {"type": "subtitle", "time": 12205.19, "timestamp": "03:23:25", "text": "是的。他们就这样离开了我吗？我的天哪。"}, {"type": "subtitle", "time": 12208.87, "timestamp": "03:23:28", "text": "但你听起来好像知道。我们能"}, {"type": "subtitle", "time": 12222.309, "timestamp": "03:23:42", "text": "等待。医院在哪里？"}, {"type": "subtitle", "time": 12226.389, "timestamp": "03:23:46", "text": "医院这边走。是的。嗨，我只是"}, {"type": "subtitle", "time": 12228.07, "timestamp": "03:23:48", "text": "下列的。"}, {"type": "subtitle", "time": 12234.309, "timestamp": "03:23:54", "text": "完毕。"}]
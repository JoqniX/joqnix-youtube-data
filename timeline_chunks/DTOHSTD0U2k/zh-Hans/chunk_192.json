[{"type": "subtitle", "time": 11520.71, "timestamp": "03:12:00", "text": "老兄，这是我吃过最好吃的面包！诚实地，"}, {"type": "subtitle", "time": 11529.11, "timestamp": "03:12:09", "text": "你好。"}, {"type": "subtitle", "time": 11530.79, "timestamp": "03:12:10", "text": "哦，所以我们在等你准备好。"}, {"type": "subtitle", "time": 11533.67, "timestamp": "03:12:13", "text": "也一样。"}, {"type": "subtitle", "time": 11535.429, "timestamp": "03:12:15", "text": "好了。现在我们他妈的打败了"}, {"type": "subtitle", "time": 11537.67, "timestamp": "03:12:17", "text": "互相撕咬。咱们他妈的"}, {"type": "subtitle", "time": 11539.349, "timestamp": "03:12:19", "text": "去。"}, {"type": "subtitle", "time": 11541.83, "timestamp": "03:12:21", "text": "是的，严格来说。"}, {"type": "subtitle", "time": 11543.83, "timestamp": "03:12:23", "text": "有人去世了，然后我们就不得不……"}, {"type": "subtitle", "time": 11546.309, "timestamp": "03:12:26", "text": "彼此求生。瞄准多邻国"}, {"type": "subtitle", "time": 11547.83, "timestamp": "03:12:27", "text": "鸟。"}, {"type": "subtitle", "time": 11554.55, "timestamp": "03:12:34", "text": "鸟类之类的东西。好的。"}, {"type": "subtitle", "time": 11557.11, "timestamp": "03:12:37", "text": "我们能否就热门话题达成一致，也欢迎推特"}, {"type": "subtitle", "time": 11566.389, "timestamp": "03:12:46", "text": "我们能达成一致吗？"}, {"type": "subtitle", "time": 11569.19, "timestamp": "03:12:49", "text": "是的。当然。好的。我们是谁"}, {"type": "subtitle", "time": 11571.349, "timestamp": "03:12:51", "text": "目标锁定？"}, {"type": "subtitle", "time": 11573.56, "timestamp": "03:12:53", "text": "嗯，"}]
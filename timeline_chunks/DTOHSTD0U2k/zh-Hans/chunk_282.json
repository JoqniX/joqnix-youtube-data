[{"type": "subtitle", "time": 16926.39, "timestamp": "04:42:06", "text": "还有一只鸽子。这里还有一只鸽子。所以"}, {"type": "subtitle", "time": 16929.99, "timestamp": "04:42:09", "text": "难道雷米不是那只鸽子吗？"}, {"type": "subtitle", "time": 16932.628, "timestamp": "04:42:12", "text": "我不这么认为"}, {"type": "subtitle", "time": 16935.59, "timestamp": "04:42:15", "text": "他一直都在队里，"}, {"type": "subtitle", "time": 16937.75, "timestamp": "04:42:17", "text": "我们没看到他做任何事。所以"}, {"type": "subtitle", "time": 16942.55, "timestamp": "04:42:22", "text": "就像，我会告诉你为什么，就像以前一样。"}, {"type": "subtitle", "time": 16944.788, "timestamp": "04:42:24", "text": "之前我好像在尝试完成一项任务，"}, {"type": "subtitle", "time": 16946.47, "timestamp": "04:42:26", "text": "他说他就像在尝试……"}, {"type": "subtitle", "time": 16948.868, "timestamp": "04:42:28", "text": "找到凶手。所以我认为他正在这样做"}, {"type": "subtitle", "time": 16951.83, "timestamp": "04:42:31", "text": "这。是的。我的意思是，它可能是假的。"}, {"type": "subtitle", "time": 16953.11, "timestamp": "04:42:33", "text": "对吧？"}, {"type": "subtitle", "time": 16956.07, "timestamp": "04:42:36", "text": "哦，我觉得他正在……我觉得我是……"}, {"type": "subtitle", "time": 16958.708, "timestamp": "04:42:38", "text": "会吓得人非常难受。他不是"}, {"type": "subtitle", "time": 16964.15, "timestamp": "04:42:44", "text": "甚至连说话都行。是的，我甚至就在这里。"}, {"type": "subtitle", "time": 16967.51, "timestamp": "04:42:47", "text": "我不认为他是在试图……"}, {"type": "subtitle", "time": 16969.03, "timestamp": "04:42:49", "text": "找到凶手，这就是他不在的原因。"}, {"type": "subtitle", "time": 16971.43, "timestamp": "04:42:51", "text": "正在做。记住，我是加拿大人。"}, {"type": "subtitle", "time": 16974.56, "timestamp": "04:42:54", "text": "记住，我是加拿大人。 Yoshi，你会有麻烦的。如果我"}, {"type": "subtitle", "time": 16976.08, "timestamp": "04:42:56", "text": "Yoshi，你会有麻烦的。如果我 如果我死了，你认识他。"}]
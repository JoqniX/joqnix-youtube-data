[{"type": "subtitle", "time": 11161.04, "timestamp": "03:06:01", "text": "正在吃早餐。他当时正在谈论…… 你是我最喜欢的马里奥角色。是的。"}, {"type": "subtitle", "time": 11163.76, "timestamp": "03:06:03", "text": "你是我最喜欢的马里奥角色。是的。 你看，有人明白了。谢谢。感谢"}, {"type": "subtitle", "time": 11166.319, "timestamp": "03:06:06", "text": "你看，有人明白了。谢谢。感谢 你。你很厉害。接下来是耀西。哦"}, {"type": "subtitle", "time": 11169.52, "timestamp": "03:06:09", "text": "你。你很厉害。接下来是耀西。哦 我的天哪，你真恶心。你好。怎样"}, {"type": "subtitle", "time": 11172.479, "timestamp": "03:06:12", "text": "我的天哪，你真恶心。你好。怎样 你们在干嘛？我很好。再见。"}, {"type": "subtitle", "time": 11174.24, "timestamp": "03:06:14", "text": "你们在干嘛？我很好。再见。 谢谢。我是"}, {"type": "subtitle", "time": 11176.56, "timestamp": "03:06:16", "text": "谢谢。我是 嘿，"}, {"type": "subtitle", "time": 11183.67, "timestamp": "03:06:23", "text": "女士。回到办公桌前。回来"}, {"type": "subtitle", "time": 11185.75, "timestamp": "03:06:25", "text": "到办公桌前。好好谈谈"}, {"type": "subtitle", "time": 11191.429, "timestamp": "03:06:31", "text": "大家好，我是特伦斯。"}, {"type": "subtitle", "time": 11192.87, "timestamp": "03:06:32", "text": "我是一名正在接受训练的偶像。希望带来"}, {"type": "subtitle", "time": 11195.11, "timestamp": "03:06:35", "text": "微笑。每个人都得享受其中。"}, {"type": "subtitle", "time": 11197.11, "timestamp": "03:06:37", "text": "遍布世界各地。很高兴认识你"}, {"type": "subtitle", "time": 11200.15, "timestamp": "03:06:40", "text": "全部。我的天哪，特伦。我的天哪，是"}, {"type": "subtitle", "time": 11207.76, "timestamp": "03:06:47", "text": "[音乐]"}, {"type": "subtitle", "time": 11209.44, "timestamp": "03:06:49", "text": "[笑声]"}, {"type": "subtitle", "time": 11219.19, "timestamp": "03:06:59", "text": "哦，韩来了。"}]
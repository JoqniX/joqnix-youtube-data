[{"type": "subtitle", "time": 2101.91, "timestamp": "00:35:01", "text": "我们暂且跳过这个问题。你们都在这里吗？"}, {"type": "subtitle", "time": 2104.63, "timestamp": "00:35:04", "text": "正确的？"}, {"type": "subtitle", "time": 2107.19, "timestamp": "00:35:07", "text": "疤痕的共鸣能力似乎"}, {"type": "subtitle", "time": 2109.03, "timestamp": "00:35:09", "text": "涉及瞬间移动和"}, {"type": "subtitle", "time": 2111.589, "timestamp": "00:35:11", "text": "空间操控。"}, {"type": "subtitle", "time": 2114.069, "timestamp": "00:35:14", "text": "他把我困在牢笼里，而我"}, {"type": "subtitle", "time": 2116.23, "timestamp": "00:35:16", "text": "只能感觉到它离这里不远了。"}, {"type": "subtitle", "time": 2119.27, "timestamp": "00:35:19", "text": "这里。我花了一些时间才克服这一点。"}, {"type": "subtitle", "time": 2121.03, "timestamp": "00:35:21", "text": "障碍。"}, {"type": "subtitle", "time": 2124.15, "timestamp": "00:35:24", "text": "抱歉了，罗孚。如果我能……"}, {"type": "subtitle", "time": 2127.27, "timestamp": "00:35:27", "text": "兄弟，我早就联系上你了。他为什么如此"}, {"type": "subtitle", "time": 2134.069, "timestamp": "00:35:34", "text": "兄弟，"}, {"type": "subtitle", "time": 2139.99, "timestamp": "00:35:39", "text": "小家伙，你为什么在这里？"}, {"type": "subtitle", "time": 2142.23, "timestamp": "00:35:42", "text": "我从未见过任何酸涩的争吵"}, {"type": "subtitle", "time": 2144.87, "timestamp": "00:35:44", "text": "展现出如此生动的情感。"}, {"type": "subtitle", "time": 2147.67, "timestamp": "00:35:47", "text": "哥哥提到过。"}, {"type": "subtitle", "time": 2151.43, "timestamp": "00:35:51", "text": "会不会是呢？是的，这有可能。"}, {"type": "subtitle", "time": 2154.31, "timestamp": "00:35:54", "text": "哦，加尔以前来过这里。我们来聊聊吧。"}, {"type": "subtitle", "time": 2157.91, "timestamp": "00:35:57", "text": "以后再说吧。罗孚，你能帮我加满油吗？"}]
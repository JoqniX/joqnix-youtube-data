[{"type": "subtitle", "time": 11640.469, "timestamp": "03:14:00", "text": "他说他要把我们都揍一顿。不。"}, {"type": "subtitle", "time": 11644.95, "timestamp": "03:14:04", "text": "每次见到龙，我们都会杀了他。"}, {"type": "subtitle", "time": 11647.11, "timestamp": "03:14:07", "text": "不。"}, {"type": "subtitle", "time": 11654.87, "timestamp": "03:14:14", "text": "不要透露你的电话号码。"}, {"type": "subtitle", "time": 11660.87, "timestamp": "03:14:20", "text": "我是第10名，第2名。我的天哪。我是"}, {"type": "subtitle", "time": 11662.79, "timestamp": "03:14:22", "text": "第十条。人太多了。你"}, {"type": "subtitle", "time": 11665.11, "timestamp": "03:14:25", "text": "需要向下滚动。向下。你妈妈。也"}, {"type": "subtitle", "time": 11667.03, "timestamp": "03:14:27", "text": "许多。"}, {"type": "subtitle", "time": 11674.63, "timestamp": "03:14:34", "text": "我们应该能看到那些东西。"}, {"type": "subtitle", "time": 11676.79, "timestamp": "03:14:36", "text": "正确的？"}, {"type": "subtitle", "time": 11679.19, "timestamp": "03:14:39", "text": "随机的。真无聊。鹈鹕"}, {"type": "subtitle", "time": 11687.269, "timestamp": "03:14:47", "text": "他们为了比赛而吃东西。"}, {"type": "subtitle", "time": 11690.15, "timestamp": "03:14:50", "text": "等等，我的角色被自动选中了。"}, {"type": "subtitle", "time": 11694.63, "timestamp": "03:14:54", "text": "我该如何更改？没关系。"}, {"type": "subtitle", "time": 11697.03, "timestamp": "03:14:57", "text": "你无法改变它。"}]
[{"type": "subtitle", "time": 14760.55, "timestamp": "04:06:00", "text": "我听到尖叫声。韩韩。不，我，我，我曾经"}, {"type": "subtitle", "time": 14762.229, "timestamp": "04:06:02", "text": "死的。所以我一直在关注你。哦，你"}, {"type": "subtitle", "time": 14764.469, "timestamp": "04:06:04", "text": "哦，你当时也死了。是的，但是"}, {"type": "subtitle", "time": 14766.07, "timestamp": "04:06:06", "text": "跟踪你的其中两人是"}, {"type": "subtitle", "time": 14770.389, "timestamp": "04:06:10", "text": "另一名凶手。哦，原来如此。"}, {"type": "subtitle", "time": 14772.229, "timestamp": "04:06:12", "text": "该死，我逃出来了。欢迎来玩！"}, {"type": "subtitle", "time": 14779.91, "timestamp": "04:06:19", "text": "我将这份荣誉带给我的家人。"}, {"type": "subtitle", "time": 14782.55, "timestamp": "04:06:22", "text": "好的。哦，不错。好的。你知道吗？我"}, {"type": "subtitle", "time": 14785.59, "timestamp": "04:06:25", "text": "当时我就想，嘿，"}, {"type": "subtitle", "time": 14789.269, "timestamp": "04:06:29", "text": "什么？开始什么？小丑，准备好了。"}, {"type": "subtitle", "time": 14794.95, "timestamp": "04:06:34", "text": "我杀了人。"}, {"type": "subtitle", "time": 14798.63, "timestamp": "04:06:38", "text": "我很高兴。我杀对了人。你"}, {"type": "subtitle", "time": 14800.07, "timestamp": "04:06:40", "text": "知道为什么吗？因为我算是第一个。"}, {"type": "subtitle", "time": 14801.91, "timestamp": "04:06:41", "text": "我见到谁，就杀了他。"}, {"type": "subtitle", "time": 14804.63, "timestamp": "04:06:44", "text": "你就这样出现了。"}, {"type": "subtitle", "time": 14807.189, "timestamp": "04:06:47", "text": "各位，我很高兴。"}, {"type": "subtitle", "time": 14808.79, "timestamp": "04:06:48", "text": "别后悔。是的。是的。是的。但"}, {"type": "subtitle", "time": 14811.83, "timestamp": "04:06:51", "text": "我很高兴。这是一次漂亮的击杀。"}, {"type": "subtitle", "time": 14814.229, "timestamp": "04:06:54", "text": "那真是个好兆头"}]
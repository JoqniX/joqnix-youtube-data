[{"type": "subtitle", "time": 10861.11, "timestamp": "03:01:01", "text": "谁失踪了？巨龙决定"}, {"type": "subtitle", "time": 10863.269, "timestamp": "03:01:03", "text": "溪流。我觉得我们好像漏掉了什么。"}, {"type": "subtitle", "time": 10867.11, "timestamp": "03:01:07", "text": "摇滚男。我认为"}, {"type": "subtitle", "time": 10870.309, "timestamp": "03:01:10", "text": "Roku。我忘了他的名字。是的，我想是的。"}, {"type": "subtitle", "time": 10872.15, "timestamp": "03:01:12", "text": "是的。我不确定他是否会……"}, {"type": "subtitle", "time": 10874.23, "timestamp": "03:01:14", "text": "加入。他今天没跟我一起玩。他"}, {"type": "subtitle", "time": 10881.51, "timestamp": "03:01:21", "text": "我该如何调整我的"}, {"type": "subtitle", "time": 10884.309, "timestamp": "03:01:24", "text": "没关系。开始。没关系。它是"}, {"type": "subtitle", "time": 10886.389, "timestamp": "03:01:26", "text": "好的。没关系。"}, {"type": "subtitle", "time": 10888.79, "timestamp": "03:01:28", "text": "就像在……上"}, {"type": "subtitle", "time": 10898.95, "timestamp": "03:01:38", "text": "我们到前面来。你不必"}, {"type": "subtitle", "time": 10902.469, "timestamp": "03:01:42", "text": "到公交车站。好的。不，不，我们有你。"}, {"type": "subtitle", "time": 10905.349, "timestamp": "03:01:45", "text": "知道什么？我会退后一步。"}, {"type": "subtitle", "time": 10908.79, "timestamp": "03:01:48", "text": "奋斗是真实存在的。等等，我们都在线吗？"}, {"type": "subtitle", "time": 10911.83, "timestamp": "03:01:51", "text": "我们是在Twitch上直播，还是在YouTube上直播？"}, {"type": "subtitle", "time": 10913.429, "timestamp": "03:01:53", "text": "我在YouTube上。疏散。我正在"}, {"type": "subtitle", "time": 10915.429, "timestamp": "03:01:55", "text": "YouTube也是。我们大多数人都在使用YouTube。"}, {"type": "subtitle", "time": 10917.51, "timestamp": "03:01:57", "text": "是的，主要是在 YouTube 上，但也有一些是在"}, {"type": "subtitle", "time": 10919.75, "timestamp": "03:01:59", "text": "现在正在Twitch上直播。太吵了。"}]
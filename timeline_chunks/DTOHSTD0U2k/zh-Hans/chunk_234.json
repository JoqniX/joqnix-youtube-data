[{"type": "subtitle", "time": 14041.349, "timestamp": "03:54:01", "text": "大约。"}, {"type": "subtitle", "time": 14044.469, "timestamp": "03:54:04", "text": "我想我听到了那个声音。把我的"}, {"type": "subtitle", "time": 14046.71, "timestamp": "03:54:06", "text": "你死后，人们对他抱有怀疑。拿一个"}, {"type": "subtitle", "time": 14048.63, "timestamp": "03:54:08", "text": "小便。你怎么做到的？我要跳过。我"}, {"type": "subtitle", "time": 14051.03, "timestamp": "03:54:11", "text": "不知道。"}, {"type": "subtitle", "time": 14053.03, "timestamp": "03:54:13", "text": "我不知道我没做什么，但他们"}, {"type": "subtitle", "time": 14055.67, "timestamp": "03:54:15", "text": "听起来没错。我投他一票。"}, {"type": "subtitle", "time": 14059.429, "timestamp": "03:54:19", "text": "事实就是如此。那是个男人。它"}, {"type": "subtitle", "time": 14064.309, "timestamp": "03:54:24", "text": "曾是杀人犯。它站在"}, {"type": "subtitle", "time": 14066.79, "timestamp": "03:54:26", "text": "杀人犯。"}, {"type": "subtitle", "time": 14070.55, "timestamp": "03:54:30", "text": "兄弟。我的天啊。房间里为什么还很安静？哦"}, {"type": "subtitle", "time": 14073.91, "timestamp": "03:54:33", "text": "我的天哪，我都不知道该怎么办了。"}, {"type": "subtitle", "time": 14076.07, "timestamp": "03:54:36", "text": "做。"}, {"type": "subtitle", "time": 14077.75, "timestamp": "03:54:37", "text": "各位，我有一种特殊能力。我不能"}, {"type": "subtitle", "time": 14081.429, "timestamp": "03:54:41", "text": "如果我和别人在一起，就会被杀。我上线了。"}, {"type": "subtitle", "time": 14084.309, "timestamp": "03:54:44", "text": "请帮我。嘿，你好吗？"}, {"type": "subtitle", "time": 14085.91, "timestamp": "03:54:45", "text": "你好。"}]
[{"type": "subtitle", "time": 10502.23, "timestamp": "02:55:02", "text": "1 2 3 4 5 6 7 8 人。不，是某人的"}, {"type": "subtitle", "time": 10504.15, "timestamp": "02:55:04", "text": "丢失的。"}, {"type": "subtitle", "time": 10507.11, "timestamp": "02:55:07", "text": "是的。是的。至少应该有10个"}, {"type": "subtitle", "time": 10509.349, "timestamp": "02:55:09", "text": "或更多。已经过去了，因为它"}, {"type": "subtitle", "time": 10513.15, "timestamp": "02:55:13", "text": "对他来说行不通。一个"}, {"type": "subtitle", "time": 10515.19, "timestamp": "02:55:15", "text": "[音乐]"}, {"type": "subtitle", "time": 10527.91, "timestamp": "02:55:27", "text": "哦，等等。"}, {"type": "subtitle", "time": 10530.87, "timestamp": "02:55:30", "text": "等待的过程。"}, {"type": "subtitle", "time": 10536.15, "timestamp": "02:55:36", "text": "特伦斯。哦，大家好。你能听到吗？"}, {"type": "subtitle", "time": 10537.59, "timestamp": "02:55:37", "text": "我？"}, {"type": "subtitle", "time": 10540.309, "timestamp": "02:55:40", "text": "是的，我们能听到你说话。"}, {"type": "subtitle", "time": 10543.51, "timestamp": "02:55:43", "text": "你好。迈克工作的时间并不长。"}, {"type": "subtitle", "time": 10546.469, "timestamp": "02:55:46", "text": "时间。我当时就不知道该怎么办了。"}, {"type": "subtitle", "time": 10551.349, "timestamp": "02:55:51", "text": "待办事项。我不知道。真他妈的。"}, {"type": "subtitle", "time": 10557.91, "timestamp": "02:55:57", "text": "骑师"}, {"type": "subtitle", "time": 10559.83, "timestamp": "02:55:59", "text": "直接在游戏里把自己静音。"}]
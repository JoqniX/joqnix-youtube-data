[{"type": "subtitle", "time": 19108.47, "timestamp": "05:18:28", "text": "好的？"}, {"type": "subtitle", "time": 19112.31, "timestamp": "05:18:32", "text": "过来。是啊，我很害怕。好的。我是"}, {"type": "subtitle", "time": 19114.55, "timestamp": "05:18:34", "text": "害怕"}, {"type": "subtitle", "time": 19116.628, "timestamp": "05:18:36", "text": "还有人有不在场证明。抓住"}, {"type": "subtitle", "time": 19121.27, "timestamp": "05:18:41", "text": "在。我们都能成为不在场证明吗？"}, {"type": "subtitle", "time": 19122.948, "timestamp": "05:18:42", "text": "我们可以互相成为对方的不在场证明。权力"}, {"type": "subtitle", "time": 19124.31, "timestamp": "05:18:44", "text": "友谊。我们可以成为彼此的"}, {"type": "subtitle", "time": 19128.39, "timestamp": "05:18:48", "text": "不在场证明。我们能赢，伙计们。"}, {"type": "subtitle", "time": 19130.788, "timestamp": "05:18:50", "text": "咱们还是别抱团了，你们"}, {"type": "subtitle", "time": 19133.67, "timestamp": "05:18:53", "text": "知道。友谊的力量是真实存在的。哦，"}, {"type": "subtitle", "time": 19136.868, "timestamp": "05:18:56", "text": "顺便说一下，各位，我是一名士兵。所以呢？"}, {"type": "subtitle", "time": 19138.788, "timestamp": "05:18:58", "text": "是的，我已经透露了我的角色。我是"}]
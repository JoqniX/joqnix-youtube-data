[{"type": "subtitle", "time": 9721.99, "timestamp": "02:42:01", "text": "呃，我该怎么把它们静音呢？"}, {"type": "subtitle", "time": 9724.87, "timestamp": "02:42:04", "text": "打扰一下。"}, {"type": "subtitle", "time": 9727.83, "timestamp": "02:42:07", "text": "我的天啊。"}, {"type": "subtitle", "time": 9730.95, "timestamp": "02:42:10", "text": "妈的。"}, {"type": "subtitle", "time": 9763.429, "timestamp": "02:42:43", "text": "明天。好的，明白了。正确的。或许"}, {"type": "subtitle", "time": 9766.15, "timestamp": "02:42:46", "text": "也许明天吧。你好。好的。所以就是这样"}, {"type": "subtitle", "time": 9767.75, "timestamp": "02:42:47", "text": "不想在我们快要醒来的时候叫醒我"}, {"type": "subtitle", "time": 9769.51, "timestamp": "02:42:49", "text": "开始。好的。不，我不要你"}, {"type": "subtitle", "time": 9770.95, "timestamp": "02:42:50", "text": "这里。所以我永远不会叫醒你。"}, {"type": "subtitle", "time": 9773.59, "timestamp": "02:42:53", "text": "对不起。"}]
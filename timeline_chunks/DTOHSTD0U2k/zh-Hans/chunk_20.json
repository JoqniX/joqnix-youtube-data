[{"type": "subtitle", "time": 1206.63, "timestamp": "00:20:06", "text": "这是什么？在……上发现了一些污渍"}, {"type": "subtitle", "time": 1209.11, "timestamp": "00:20:09", "text": "墙。靠近些。你可以制作它们"}, {"type": "subtitle", "time": 1211.83, "timestamp": "00:20:11", "text": "文本。被驱逐的怪物都是她的"}, {"type": "subtitle", "time": 1213.43, "timestamp": "00:20:13", "text": "过错。"}, {"type": "subtitle", "time": 1215.51, "timestamp": "00:20:15", "text": "来自庇护所的谦逊页面"}, {"type": "subtitle", "time": 1218.63, "timestamp": "00:20:18", "text": "居住在地面上。后来"}, {"type": "subtitle", "time": 1221.43, "timestamp": "00:20:21", "text": "牧羊人公开指责那只黑羊"}, {"type": "subtitle", "time": 1223.909, "timestamp": "00:20:23", "text": "给那只毛茸茸的黑羊羔。接下来"}, {"type": "subtitle", "time": 1226.71, "timestamp": "00:20:26", "text": "白羊迎接升天的那一天"}, {"type": "subtitle", "time": 1230.07, "timestamp": "00:20:30", "text": "太阳。所以，叔叔就是幕后操纵者。"}, {"type": "subtitle", "time": 1232.31, "timestamp": "00:20:32", "text": "无处可寻。牧羊人"}, {"type": "subtitle", "time": 1234.95, "timestamp": "00:20:34", "text": "引入了一条不成文的规则"}, {"type": "subtitle", "time": 1236.549, "timestamp": "00:20:36", "text": "村庄。"}, {"type": "subtitle", "time": 1240.549, "timestamp": "00:20:40", "text": "我们的黑羊羔违反了其中一条规定"}, {"type": "subtitle", "time": 1243.51, "timestamp": "00:20:43", "text": "说真话。突然间，曾经的"}, {"type": "subtitle", "time": 1247.27, "timestamp": "00:20:47", "text": "慈爱的神不再满足人们的愿望了。"}, {"type": "subtitle", "time": 1249.75, "timestamp": "00:20:49", "text": "因为不再有新的祭品被献祭了。"}, {"type": "subtitle", "time": 1252.149, "timestamp": "00:20:52", "text": "目睹黑羔羊后所作的"}, {"type": "subtitle", "time": 1254.789, "timestamp": "00:20:54", "text": "他们的行动以及聆听他们全能者的指示"}, {"type": "subtitle", "time": 1257.669, "timestamp": "00:20:57", "text": "牧羊人。你认为白色是什么？"}]
[{"type": "subtitle", "time": 14182.229, "timestamp": "03:56:22", "text": "啊，我们已经到了教堂外面。底部"}, {"type": "subtitle", "time": 14186.79, "timestamp": "03:56:26", "text": "左角，右角。乔就坐在旁边"}, {"type": "subtitle", "time": 14192.79, "timestamp": "03:56:32", "text": "你知道吗？我好像闻到了什么味道。"}, {"type": "subtitle", "time": 14195.51, "timestamp": "03:56:35", "text": "就像一份自我报告，因为我当时想的是："}, {"type": "subtitle", "time": 14199.269, "timestamp": "03:56:39", "text": "“不，不。苏米要进来了。苏米是"}, {"type": "subtitle", "time": 14201.91, "timestamp": "03:56:41", "text": "进来了。我当时真的在做“进入”动作。"}, {"type": "subtitle", "time": 14203.67, "timestamp": "03:56:43", "text": "找到人的地方正好合适。"}, {"type": "subtitle", "time": 14205.67, "timestamp": "03:56:45", "text": "那里。是的。是的，我们做到了。我当时正在做"}, {"type": "subtitle", "time": 14209.189, "timestamp": "03:56:49", "text": "灯。不。约翰，你在做什么？"}, {"type": "subtitle", "time": 14212.55, "timestamp": "03:56:52", "text": "我当时正在摆弄那盏灯。我当时"}, {"type": "subtitle", "time": 14214.63, "timestamp": "03:56:54", "text": "在角落里做那个灯的事"}, {"type": "subtitle", "time": 14216.79, "timestamp": "03:56:56", "text": "大门。然后我就下来了。我遇见了你"}, {"type": "subtitle", "time": 14218.95, "timestamp": "03:56:58", "text": "你。我们俩都看到了尸体，还有你。"}]
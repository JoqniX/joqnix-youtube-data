[{"type": "subtitle", "time": 17342.23, "timestamp": "04:49:02", "text": "你们真的很喜欢自己，对吧？"}, {"type": "subtitle", "time": 17344.31, "timestamp": "04:49:04", "text": "我相信你。是的，我没有逼她。"}, {"type": "subtitle", "time": 17347.27, "timestamp": "04:49:07", "text": "尽管。基尔是邪恶的。放我走。让我"}, {"type": "subtitle", "time": 17350.23, "timestamp": "04:49:10", "text": "去。"}, {"type": "subtitle", "time": 17354.39, "timestamp": "04:49:14", "text": "等等，鹈鹕可以放你走。"}, {"type": "subtitle", "time": 17359.51, "timestamp": "04:49:19", "text": "我知道你能听到我说话。你明白为什么了。"}, {"type": "subtitle", "time": 17363.59, "timestamp": "04:49:23", "text": "相信你？什么？什么？罪有应得。"}, {"type": "subtitle", "time": 17365.99, "timestamp": "04:49:25", "text": "欢迎。什么？发生了什么？欢迎来到"}, {"type": "subtitle", "time": 17369.51, "timestamp": "04:49:29", "text": "欢迎来到电影院。伙伴口袋。"}, {"type": "subtitle", "time": 17371.27, "timestamp": "04:49:31", "text": "你罪有应得。等待，"}, {"type": "subtitle", "time": 17373.03, "timestamp": "04:49:33", "text": "发生了什么？我们自由了。哦，我们是"}, {"type": "subtitle", "time": 17375.59, "timestamp": "04:49:35", "text": "自由的。发生了什么？匆忙。我的天啊。"}, {"type": "subtitle", "time": 17377.67, "timestamp": "04:49:37", "text": "发生了什么？等等，这里有人去世了。"}, {"type": "subtitle", "time": 17382.07, "timestamp": "04:49:42", "text": "谁去世了？就是他死了。"}, {"type": "subtitle", "time": 17386.07, "timestamp": "04:49:46", "text": "是的。他说Yoki给了他一颗炸弹。"}, {"type": "subtitle", "time": 17387.75, "timestamp": "04:49:47", "text": "你们有炸弹。我不"}, {"type": "subtitle", "time": 17390.31, "timestamp": "04:49:50", "text": "想要那个。是的。"}, {"type": "subtitle", "time": 17392.788, "timestamp": "04:49:52", "text": "嘿，Jockey，你好吗？我正在做"}]
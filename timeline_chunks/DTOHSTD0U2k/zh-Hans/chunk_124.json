[{"type": "subtitle", "time": 7443.669, "timestamp": "02:04:03", "text": "好的，我会用这个放在鞋子旁边。"}, {"type": "subtitle", "time": 7451.189, "timestamp": "02:04:11", "text": "欢迎你，龙。"}, {"type": "subtitle", "time": 7453.83, "timestamp": "02:04:13", "text": "欢迎唐。"}, {"type": "subtitle", "time": 7466.47, "timestamp": "02:04:26", "text": "那真是个大佬。"}, {"type": "subtitle", "time": 7479.99, "timestamp": "02:04:39", "text": "你知道你可以这样做吗？我"}, {"type": "subtitle", "time": 7487.43, "timestamp": "02:04:47", "text": "她是矿工。迪奥。她简直就是"}]
[{"type": "subtitle", "time": 18121.43, "timestamp": "05:02:01", "text": "知道？因为你知道这一点。你没说话。"}, {"type": "subtitle", "time": 18125.59, "timestamp": "05:02:05", "text": "每次你看到鸽子的时候。我猜"}, {"type": "subtitle", "time": 18127.99, "timestamp": "05:02:07", "text": "不用担心。没关系。不，我需要"}, {"type": "subtitle", "time": 18131.75, "timestamp": "05:02:11", "text": "知道。不，说话。我需要知道方法。不，"}, {"type": "subtitle", "time": 18136.07, "timestamp": "05:02:16", "text": "你避开了传感器，而我没有。"}, {"type": "subtitle", "time": 18138.23, "timestamp": "05:02:18", "text": "了解科学家们的工作内容。所以，我只是……"}, {"type": "subtitle", "time": 18141.19, "timestamp": "05:02:21", "text": "这简直是​​智商100才能做到的操作。圣"}, {"type": "subtitle", "time": 18143.91, "timestamp": "05:02:23", "text": "拉屎。我当时感觉自己快要崩溃了。我打了声招呼"}, {"type": "subtitle", "time": 18146.15, "timestamp": "05:02:26", "text": "你给她发了信息，但她没有回复。她只是"}, {"type": "subtitle", "time": 18148.23, "timestamp": "05:02:28", "text": "倒下了。"}, {"type": "subtitle", "time": 18150.788, "timestamp": "05:02:30", "text": "好的。我甚至都没……"}, {"type": "subtitle", "time": 18153.83, "timestamp": "05:02:33", "text": "起床。"}, {"type": "subtitle", "time": 18157.43, "timestamp": "05:02:37", "text": "他刚才给我打了个电话，"}, {"type": "subtitle", "time": 18159.19, "timestamp": "05:02:39", "text": "正确的？而且他还是个天才。我们所有人"}, {"type": "subtitle", "time": 18160.788, "timestamp": "05:02:40", "text": "我知道。"}, {"type": "subtitle", "time": 18163.75, "timestamp": "05:02:43", "text": "乔其实是个天才。"}, {"type": "subtitle", "time": 18168.628, "timestamp": "05:02:48", "text": "是啊，那条队伍简直太长了。除非我"}, {"type": "subtitle", "time": 18171.35, "timestamp": "05:02:51", "text": "我用错误的尺寸把自己静音了，而他"}, {"type": "subtitle", "time": 18172.948, "timestamp": "05:02:52", "text": "好像听到我说话了。然后无论谁"}, {"type": "subtitle", "time": 18174.628, "timestamp": "05:02:54", "text": "选错了传感器，你就倒霉了。"}, {"type": "subtitle", "time": 18177.35, "timestamp": "05:02:57", "text": "时间真他妈宝贵。"}]
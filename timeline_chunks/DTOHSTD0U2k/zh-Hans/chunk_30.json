[{"type": "subtitle", "time": 1806.71, "timestamp": "00:30:06", "text": "希望这能帮到你。让我成为你的"}, {"type": "subtitle", "time": 1817.19, "timestamp": "00:30:17", "text": "速度。如此残暴。残酷。你"}, {"type": "subtitle", "time": 1821.269, "timestamp": "00:30:21", "text": "你看，我们是同类。"}, {"type": "subtitle", "time": 1828.789, "timestamp": "00:30:28", "text": "告诉我，你想成为规则的制定者吗？"}, {"type": "subtitle", "time": 1832.389, "timestamp": "00:30:32", "text": "设置牧羊人或违反规则"}, {"type": "subtitle", "time": 1835.59, "timestamp": "00:30:35", "text": "黑色 l？如果一个神志清醒的人能够"}, {"type": "subtitle", "time": 1838.549, "timestamp": "00:30:38", "text": "在疯子横行的世界里生存下去，"}, {"type": "subtitle", "time": 1844.149, "timestamp": "00:30:44", "text": "你称他们为最后的祭司，或者"}, {"type": "subtitle", "time": 1847.19, "timestamp": "00:30:47", "text": "关于它？而牧羊人并非……"}, {"type": "subtitle", "time": 1851.51, "timestamp": "00:30:51", "text": "真理的预定化身。一次"}, {"type": "subtitle", "time": 1854.789, "timestamp": "00:30:54", "text": "他一心想淘金，那只黑色拉布拉多犬"}]
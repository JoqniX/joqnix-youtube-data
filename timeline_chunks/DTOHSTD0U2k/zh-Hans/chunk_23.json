[{"type": "subtitle", "time": 1382.07, "timestamp": "00:23:02", "text": "你发现了什么真相？我"}, {"type": "subtitle", "time": 1385.59, "timestamp": "00:23:05", "text": "想想那个沉默的人是谁，是谁在那里引导的"}, {"type": "subtitle", "time": 1388.549, "timestamp": "00:23:08", "text": "我们就是"}, {"type": "subtitle", "time": 1390.789, "timestamp": "00:23:10", "text": "等等，它被执行了，因为它是"}, {"type": "subtitle", "time": 1393.46, "timestamp": "00:23:13", "text": "被羊群和牧羊人杀害。"}, {"type": "subtitle", "time": 1395.99, "timestamp": "00:23:15", "text": "[音乐]"}, {"type": "subtitle", "time": 1399.35, "timestamp": "00:23:19", "text": "我该怎么做？牧羊人是"}, {"type": "subtitle", "time": 1401.909, "timestamp": "00:23:21", "text": "通过牺牲生命来实现愿望"}, {"type": "subtitle", "time": 1403.75, "timestamp": "00:23:23", "text": "羔羊。"}, {"type": "subtitle", "time": 1405.83, "timestamp": "00:23:25", "text": "羊群发现了真相，却选择了……"}, {"type": "subtitle", "time": 1408.07, "timestamp": "00:23:28", "text": "成为他的同谋，他们"}, {"type": "subtitle", "time": 1409.83, "timestamp": "00:23:29", "text": "心甘情愿地献出黑羊羔"}, {"type": "subtitle", "time": 1412.47, "timestamp": "00:23:32", "text": "又一次牺牲。"}, {"type": "subtitle", "time": 1414.42, "timestamp": "00:23:34", "text": "但这是正确的。"}, {"type": "subtitle", "time": 1421.669, "timestamp": "00:23:41", "text": "小羊羔们蜷缩着身子，瑟瑟发抖。"}, {"type": "subtitle", "time": 1423.909, "timestamp": "00:23:43", "text": "他们的村庄对……感到恐惧"}, {"type": "subtitle", "time": 1427.909, "timestamp": "00:23:47", "text": "无情的狼群"}, {"type": "subtitle", "time": 1430.95, "timestamp": "00:23:50", "text": "直到一个牧羊人带着……到来"}, {"type": "subtitle", "time": 1434.789, "timestamp": "00:23:54", "text": "许愿和提供住所"}]
[{"type": "subtitle", "time": 302.15, "timestamp": "00:05:02", "text": "考虑到你的脆弱程度，这很合理。"}, {"type": "subtitle", "time": 304.07, "timestamp": "00:05:04", "text": "是你醒来的时候，否则我就会……"}, {"type": "subtitle", "time": 305.67, "timestamp": "00:05:05", "text": "质疑了这些物品的真实性。"}, {"type": "subtitle", "time": 307.73, "timestamp": "00:05:07", "text": "谣言。"}, {"type": "subtitle", "time": 309.99, "timestamp": "00:05:09", "text": "[音乐]"}, {"type": "subtitle", "time": 312.31, "timestamp": "00:05:12", "text": "你跟踪我了。"}, {"type": "subtitle", "time": 317.43, "timestamp": "00:05:17", "text": "所以，你注意到了。哦，我受宠若惊。"}, {"type": "subtitle", "time": 320.71, "timestamp": "00:05:20", "text": "跟踪者处于紧张状态。到现在，你应该已经"}, {"type": "subtitle", "time": 327.749, "timestamp": "00:05:27", "text": "[音乐]"}, {"type": "subtitle", "time": 330.71, "timestamp": "00:05:30", "text": "但在所有旁观者中，"}, {"type": "subtitle", "time": 333.029, "timestamp": "00:05:33", "text": "只有我一个人站出来"}, {"type": "subtitle", "time": 337.029, "timestamp": "00:05:37", "text": "以绝对的诚实与你见面。前"}, {"type": "subtitle", "time": 339.99, "timestamp": "00:05:39", "text": "你对这个世界一无所知吗？"}, {"type": "subtitle", "time": 347.59000000000003, "timestamp": "00:05:47", "text": "你是我们一直以来所未知的变量。"}, {"type": "subtitle", "time": 349.51, "timestamp": "00:05:49", "text": "等待。"}, {"type": "subtitle", "time": 352.15, "timestamp": "00:05:52", "text": "各方一直在争夺地盘"}, {"type": "subtitle", "time": 355.27, "timestamp": "00:05:55", "text": "在你。从你打开的那一刻起"}, {"type": "subtitle", "time": 357.59000000000003, "timestamp": "00:05:57", "text": "你的眼睛，你遇到的每一个人，"}, {"type": "subtitle", "time": 359.99, "timestamp": "00:05:59", "text": "包括你非常在乎的那个女孩。"}]
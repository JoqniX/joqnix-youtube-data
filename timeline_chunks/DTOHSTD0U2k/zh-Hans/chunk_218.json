[{"type": "subtitle", "time": 13081.67, "timestamp": "03:38:01", "text": "什么？什么？"}, {"type": "subtitle", "time": 13087.91, "timestamp": "03:38:07", "text": "亚历克斯当时也在附近，但他后来才进来。"}, {"type": "subtitle", "time": 13089.429, "timestamp": "03:38:09", "text": "一些。"}, {"type": "subtitle", "time": 13109.349, "timestamp": "03:38:29", "text": "这里？好了，话题来了。哦，你好。"}, {"type": "subtitle", "time": 13111.91, "timestamp": "03:38:31", "text": "我只是在执行任务。我不知道"}, {"type": "subtitle", "time": 13113.269, "timestamp": "03:38:33", "text": "该怎么办。你好吗？我是"}, {"type": "subtitle", "time": 13116.309, "timestamp": "03:38:36", "text": "这里。大家好，我又来了。我不知道在哪里"}, {"type": "subtitle", "time": 13118.87, "timestamp": "03:38:38", "text": "我他妈是谁？好吧，我这儿有个任务。"}, {"type": "subtitle", "time": 13122.389, "timestamp": "03:38:42", "text": "你好。你好。这边走。我没有"}, {"type": "subtitle", "time": 13131.429, "timestamp": "03:38:51", "text": "我的天啊。那是吉野吗？"}, {"type": "subtitle", "time": 13135.75, "timestamp": "03:38:55", "text": "各位，要么是吉野，要么是……"}]
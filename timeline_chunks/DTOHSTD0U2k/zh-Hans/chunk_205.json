[{"type": "subtitle", "time": 12313.429, "timestamp": "03:25:13", "text": "科学。"}, {"type": "subtitle", "time": 12316.07, "timestamp": "03:25:16", "text": "对不起。看，"}, {"type": "subtitle", "time": 12318.229, "timestamp": "03:25:18", "text": "我跟你说过我他妈的……我的天哪，"}, {"type": "subtitle", "time": 12321.59, "timestamp": "03:25:21", "text": "亚历克斯。你好。我的天啊。我告诉过你我是"}, {"type": "subtitle", "time": 12323.349, "timestamp": "03:25:23", "text": "正确的。我心想，好吧。我以为我是"}, {"type": "subtitle", "time": 12326.15, "timestamp": "03:25:26", "text": "帮我。"}, {"type": "subtitle", "time": 12330.309, "timestamp": "03:25:30", "text": "所以，我就是那只鸭子之类的东西？是的。"}, {"type": "subtitle", "time": 12333.59, "timestamp": "03:25:33", "text": "好的。我的天啊。我告诉过你了。我告诉"}, {"type": "subtitle", "time": 12336.15, "timestamp": "03:25:36", "text": "你完全是拖累。我的直觉告诉我并非如此。"}, {"type": "subtitle", "time": 12338.71, "timestamp": "03:25:38", "text": "说谎。"}, {"type": "subtitle", "time": 12341.13, "timestamp": "03:25:41", "text": "我的天啊。"}, {"type": "subtitle", "time": 12342.389, "timestamp": "03:25:42", "text": "[音乐]"}, {"type": "subtitle", "time": 12345.349, "timestamp": "03:25:45", "text": "太难了，狗狗。你知道吗？"}, {"type": "subtitle", "time": 12347.83, "timestamp": "03:25:47", "text": "对你来说，这是一次考验，兄弟。那是一个我"}, {"type": "subtitle", "time": 12350.63, "timestamp": "03:25:50", "text": "知道。好的。所以，我看不见。"}, {"type": "subtitle", "time": 12353.75, "timestamp": "03:25:53", "text": "谁是我的另一个冒名顶替者？"}, {"type": "subtitle", "time": 12355.349, "timestamp": "03:25:55", "text": "哦，不。你做不到，因为你不是"}, {"type": "subtitle", "time": 12356.95, "timestamp": "03:25:56", "text": "冒名顶替者。你就像，你知道的，"}, {"type": "subtitle", "time": 12359.83, "timestamp": "03:25:59", "text": "目前保持中立。是的，我们有中立的"}]
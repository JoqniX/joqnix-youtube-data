[{"type": "subtitle", "time": 17161.99, "timestamp": "04:46:01", "text": "对我们也这样做。那真有趣。"}, {"type": "subtitle", "time": 17164.628, "timestamp": "04:46:04", "text": "变革终将吞噬我们。 K要去"}, {"type": "subtitle", "time": 17167.83, "timestamp": "04:46:07", "text": "吃掉我们。嗯，我要去吃饭了。"}, {"type": "subtitle", "time": 17169.27, "timestamp": "04:46:09", "text": "我肯定会把你们全都吃掉。我是"}, {"type": "subtitle", "time": 17173.43, "timestamp": "04:46:13", "text": "肯定是鹈鹕。是的。第一个"}, {"type": "subtitle", "time": 17176.948, "timestamp": "04:46:16", "text": "走出去很可怕。好的。"}, {"type": "subtitle", "time": 17180.26, "timestamp": "04:46:20", "text": "消失在旁边"}, {"type": "subtitle", "time": 17182.628, "timestamp": "04:46:22", "text": "[音乐]"}, {"type": "subtitle", "time": 17184.628, "timestamp": "04:46:24", "text": "水。"}, {"type": "subtitle", "time": 17186.628, "timestamp": "04:46:26", "text": "嗯？"}, {"type": "subtitle", "time": 17189.03, "timestamp": "04:46:29", "text": "是的，我们是"}, {"type": "subtitle", "time": 17194.948, "timestamp": "04:46:34", "text": "如果凶手不来杀我，"}, {"type": "subtitle", "time": 17197.75, "timestamp": "04:46:37", "text": "我要吃了你。"}, {"type": "subtitle", "time": 17201.43, "timestamp": "04:46:41", "text": "为什么？为什么我无法选择？我的天啊。为什么"}, {"type": "subtitle", "time": 17203.99, "timestamp": "04:46:43", "text": "真是这样吗？我的天啊。为什么是"}, {"type": "subtitle", "time": 17206.02, "timestamp": "04:46:46", "text": "它喜欢"}, {"type": "subtitle", "time": 17208.788, "timestamp": "04:46:48", "text": "[音乐]"}, {"type": "subtitle", "time": 17212.47, "timestamp": "04:46:52", "text": "哦，那是什么？你还会额外获得"}, {"type": "subtitle", "time": 17214.868, "timestamp": "04:46:54", "text": "投票。举报可获得两票"}]
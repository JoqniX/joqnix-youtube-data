[{"type": "subtitle", "time": 15132.95, "timestamp": "04:12:12", "text": "哦"}, {"type": "subtitle", "time": 15134.95, "timestamp": "04:12:14", "text": "你好。"}, {"type": "subtitle", "time": 15138.87, "timestamp": "04:12:18", "text": "哦，亲爱的恋人们。"}, {"type": "subtitle", "time": 15142.71, "timestamp": "04:12:22", "text": "哦，晚餐。"}, {"type": "subtitle", "time": 15144.229, "timestamp": "04:12:24", "text": "好了各位，我召开这次会议是为了"}, {"type": "subtitle", "time": 15146.07, "timestamp": "04:12:26", "text": "实际上我把特伦踢出去了，因为我"}, {"type": "subtitle", "time": 15148.63, "timestamp": "04:12:28", "text": "我百分之百保证那就是特伦斯。如果"}, {"type": "subtitle", "time": 15150.79, "timestamp": "04:12:30", "text": "如果不是特伦，那我就不……我讨厌……"}, {"type": "subtitle", "time": 15153.99, "timestamp": "04:12:33", "text": "你可以做那样的人，但你不能把我赶出去。"}, {"type": "subtitle", "time": 15156.469, "timestamp": "04:12:36", "text": "我向你保证，那就是特伦斯。好的，我们"}, {"type": "subtitle", "time": 15158.389, "timestamp": "04:12:38", "text": "会踢你。"}, {"type": "subtitle", "time": 15159.99, "timestamp": "04:12:39", "text": "我"}, {"type": "subtitle", "time": 15162.469, "timestamp": "04:12:42", "text": "提拔他。我向你保证"}, {"type": "subtitle", "time": 15164.309, "timestamp": "04:12:44", "text": "那。我向你保证。是特伦。"}, {"type": "subtitle", "time": 15168.07, "timestamp": "04:12:48", "text": "他杀了他。不。如果是我，你"}, {"type": "subtitle", "time": 15169.67, "timestamp": "04:12:49", "text": "他也早就死了。如果是这样的话"}, {"type": "subtitle", "time": 15172.15, "timestamp": "04:12:52", "text": "我也会这么做，你也会。我的意思是，你知道"}, {"type": "subtitle", "time": 15174.309, "timestamp": "04:12:54", "text": "什么？这是一个合理的论点。是什么"}]
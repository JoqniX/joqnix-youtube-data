[{"type": "subtitle", "time": 13022.469, "timestamp": "03:37:02", "text": "尸体。我的角色让我能够"}, {"type": "subtitle", "time": 13023.83, "timestamp": "03:37:03", "text": "检查尸体。我当时正试图做"}, {"type": "subtitle", "time": 13025.269, "timestamp": "03:37:05", "text": "但它，但我不知道发生了什么。"}, {"type": "subtitle", "time": 13027.67, "timestamp": "03:37:07", "text": "我的游戏画面卡顿了一秒钟。就像那样"}, {"type": "subtitle", "time": 13030.87, "timestamp": "03:37:10", "text": "我。我当时被困住了，而他就在附近。他"}, {"type": "subtitle", "time": 13032.15, "timestamp": "03:37:12", "text": "他什么也没说，然后就……"}, {"type": "subtitle", "time": 13034.15, "timestamp": "03:37:14", "text": "他过来帮我解码了。你是什​​么"}, {"type": "subtitle", "time": 13036.55, "timestamp": "03:37:16", "text": "意思是？我跟你打招呼，你就在那里。"}, {"type": "subtitle", "time": 13039.11, "timestamp": "03:37:19", "text": "站在那里。所以我当时试图"}, {"type": "subtitle", "time": 13041.269, "timestamp": "03:37:21", "text": "我调查过了，但我做不到。我"}, {"type": "subtitle", "time": 13042.87, "timestamp": "03:37:22", "text": "不"}, {"type": "subtitle", "time": 13044.469, "timestamp": "03:37:24", "text": "喜欢"}, {"type": "subtitle", "time": 13046.389, "timestamp": "03:37:26", "text": "我百分之百相信我的聊天记录。我要走了"}, {"type": "subtitle", "time": 13050.71, "timestamp": "03:37:30", "text": "哦，我现在明白这个角色了。"}, {"type": "subtitle", "time": 13058.07, "timestamp": "03:37:38", "text": "不，不，不。好吧，我的角色是……"}, {"type": "subtitle", "time": 13060.07, "timestamp": "03:37:40", "text": "我检查了尸体，然后……"}, {"type": "subtitle", "time": 13062.389, "timestamp": "03:37:42", "text": "向我展示了角色。"}, {"type": "subtitle", "time": 13064.309, "timestamp": "03:37:44", "text": "所以我之前没看过这个角色，但是"}, {"type": "subtitle", "time": 13069.19, "timestamp": "03:37:49", "text": "现在就看看。我现在明白了。他是"}, {"type": "subtitle", "time": 13072.57, "timestamp": "03:37:52", "text": "使困惑。到底发生了什么？"}, {"type": "subtitle", "time": 13075.99, "timestamp": "03:37:55", "text": "[音乐]"}, {"type": "subtitle", "time": 13078.95, "timestamp": "03:37:58", "text": "美好的。为什么？"}]
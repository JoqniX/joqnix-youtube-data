[{"type": "subtitle", "time": 12060.71, "timestamp": "03:21:00", "text": "谎言。彻头彻尾的谎言。我当时在犯罪现场。"}, {"type": "subtitle", "time": 12062.63, "timestamp": "03:21:02", "text": "通往医院的小巷。我就在附近"}, {"type": "subtitle", "time": 12064.229, "timestamp": "03:21:04", "text": "城镇公园区域。我没看到你那婊子。"}, {"type": "subtitle", "time": 12074.389, "timestamp": "03:21:14", "text": "所以，我们到底要投票给谁？我们是谁？"}, {"type": "subtitle", "time": 12077.269, "timestamp": "03:21:17", "text": "投票给？拖。拖。投票。格雷格。得到"}, {"type": "subtitle", "time": 12079.99, "timestamp": "03:21:19", "text": "把他赶出去。不，不，不，不，不。你"}, {"type": "subtitle", "time": 12081.349, "timestamp": "03:21:21", "text": "想知道我为什么这么想的另一个原因"}, {"type": "subtitle", "time": 12083.75, "timestamp": "03:21:23", "text": "真扫兴？"}, {"type": "subtitle", "time": 12085.11, "timestamp": "03:21:25", "text": "他试图投票把我赶下台。他试图"}, {"type": "subtitle", "time": 12088.389, "timestamp": "03:21:28", "text": "即使我有不在场证明，也要把我投出去。"}, {"type": "subtitle", "time": 12090.15, "timestamp": "03:21:30", "text": "他试图投票把我赶下台。好的。你知道"}, {"type": "subtitle", "time": 12092.79, "timestamp": "03:21:32", "text": "什么？你知道吗？这不是拖拽。如果"}, {"type": "subtitle", "time": 12095.11, "timestamp": "03:21:35", "text": "这不是拖延，投票吧。是的。如果不是"}, {"type": "subtitle", "time": 12097.429, "timestamp": "03:21:37", "text": "拖拽，投我一票。"}, {"type": "subtitle", "time": 12100.389, "timestamp": "03:21:40", "text": "我很害怕。这是拖延症。我不知道。我是"}, {"type": "subtitle", "time": 12103.19, "timestamp": "03:21:43", "text": "跳过"}, {"type": "subtitle", "time": 12110.15, "timestamp": "03:21:50", "text": "我的天啊。哇。"}, {"type": "subtitle", "time": 12113.19, "timestamp": "03:21:53", "text": "动动脑子。动动脑筋。快点。"}, {"type": "subtitle", "time": 12117.11, "timestamp": "03:21:57", "text": "氧气。踢。拖。把他弄出去。"}, {"type": "subtitle", "time": 12118.87, "timestamp": "03:21:58", "text": "我刚刚点开了他的页面。我刚刚点击了一下。"}]
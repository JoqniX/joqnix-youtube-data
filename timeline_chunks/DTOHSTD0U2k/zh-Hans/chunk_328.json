[{"type": "subtitle", "time": 19684.31, "timestamp": "05:28:04", "text": "你好。嘿，伙计们。哦，我现在可以了。该死。"}, {"type": "subtitle", "time": 19686.628, "timestamp": "05:28:06", "text": "所以，是的，我想做其中一个"}, {"type": "subtitle", "time": 19690.47, "timestamp": "05:28:10", "text": "哦，铃铛。它在哪里？"}, {"type": "subtitle", "time": 19693.03, "timestamp": "05:28:13", "text": "铃铛在哪儿？我不知道。哦，"}, {"type": "subtitle", "time": 19695.75, "timestamp": "05:28:15", "text": "拿起铃铛。可能是头牛。"}, {"type": "subtitle", "time": 19698.15, "timestamp": "05:28:18", "text": "不管它叫什么。教堂。"}, {"type": "subtitle", "time": 19705.75, "timestamp": "05:28:25", "text": "铃铛在哪儿？它在哪里？在哪里"}, {"type": "subtitle", "time": 19708.07, "timestamp": "05:28:28", "text": "我们得去捡铃铛吗？"}, {"type": "subtitle", "time": 19716.708, "timestamp": "05:28:36", "text": "好了各位，在我面前的是……"}, {"type": "subtitle", "time": 19719.03, "timestamp": "05:28:39", "text": "肯定是下雨了，对吧？我落后了"}, {"type": "subtitle", "time": 19721.91, "timestamp": "05:28:41", "text": "我在教堂区域下方，我是"}, {"type": "subtitle", "time": 19724.868, "timestamp": "05:28:44", "text": "前往墓地的路上。然后我看到他"}, {"type": "subtitle", "time": 19726.948, "timestamp": "05:28:46", "text": "自我报告。他主动报告了此事。我是"}, {"type": "subtitle", "time": 19729.11, "timestamp": "05:28:49", "text": "对不起。绝对杀死了"}, {"type": "subtitle", "time": 19731.91, "timestamp": "05:28:51", "text": "被杀。你不能，你不能撒谎。"}, {"type": "subtitle", "time": 19735.43, "timestamp": "05:28:55", "text": "按你的方式。哇。"}, {"type": "subtitle", "time": 19738.23, "timestamp": "05:28:58", "text": "公墓。事情就是这样，对吧？我当时"}, {"type": "subtitle", "time": 19739.91, "timestamp": "05:28:59", "text": "大部分时间都和Willow在一起。我可以"}]
[{"type": "subtitle", "time": 1441.909, "timestamp": "00:24:01", "text": "牧羊人慢慢地控制了局面。"}, {"type": "subtitle", "time": 1445.59, "timestamp": "00:24:05", "text": "羊群和羔羊们过着幸福的生活。"}, {"type": "subtitle", "time": 1447.51, "timestamp": "00:24:07", "text": "生命。"}, {"type": "subtitle", "time": 1452.21, "timestamp": "00:24:12", "text": "但这并非我们故事的结局。"}, {"type": "subtitle", "time": 1454.149, "timestamp": "00:24:14", "text": "[掌声]"}, {"type": "subtitle", "time": 1457.11, "timestamp": "00:24:17", "text": "牧羊人发现了那只孤零零的黑羊。"}, {"type": "subtitle", "time": 1460.95, "timestamp": "00:24:20", "text": "他羊群中的一只羔羊，并表示愿意给予"}, {"type": "subtitle", "time": 1465.19, "timestamp": "00:24:25", "text": "任何它想要的愿望。作为交换，他"}, {"type": "subtitle", "time": 1468.149, "timestamp": "00:24:28", "text": "希望它的一个同伴作为"}, {"type": "subtitle", "time": 1469.669, "timestamp": "00:24:29", "text": "牺牲。"}, {"type": "subtitle", "time": 1476.71, "timestamp": "00:24:36", "text": "那只黑羊拒绝了，而且"}, {"type": "subtitle", "time": 1480.31, "timestamp": "00:24:40", "text": "被信众排斥，离开了"}, {"type": "subtitle", "time": 1483.1, "timestamp": "00:24:43", "text": "住所或食物。"}, {"type": "subtitle", "time": 1484.87, "timestamp": "00:24:44", "text": "[音乐]"}, {"type": "subtitle", "time": 1488.71, "timestamp": "00:24:48", "text": "黑羊被放逐之后，更多的羊羔"}, {"type": "subtitle", "time": 1491.59, "timestamp": "00:24:51", "text": "继续消失。羔羊也是。拉姆·尤姆"}, {"type": "subtitle", "time": 1495.51, "timestamp": "00:24:55", "text": "真好吃。我的天啊。黑拉布拉多犬打破"}, {"type": "subtitle", "time": 1497.909, "timestamp": "00:24:57", "text": "规则"}]
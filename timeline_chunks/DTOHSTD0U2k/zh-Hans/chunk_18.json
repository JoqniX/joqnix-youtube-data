[{"type": "subtitle", "time": 1081.27, "timestamp": "00:18:01", "text": "稍等片刻。我的显示器。我只是"}, {"type": "subtitle", "time": 1084.31, "timestamp": "00:18:04", "text": "那张桌子，伙计。它松了。呃，不。"}, {"type": "subtitle", "time": 1091.029, "timestamp": "00:18:11", "text": "是的。随着夜幕降临，夜色渐深。"}, {"type": "subtitle", "time": 1094.71, "timestamp": "00:18:14", "text": "只有一个人注意到它的羊群是如何的"}, {"type": "subtitle", "time": 1099.669, "timestamp": "00:18:19", "text": "逐渐消失。逐渐消失。"}, {"type": "subtitle", "time": 1101.51, "timestamp": "00:18:21", "text": "路虎，"}, {"type": "subtitle", "time": 1104.15, "timestamp": "00:18:24", "text": "你觉得会有人给你什么？"}, {"type": "subtitle", "time": 1106.789, "timestamp": "00:18:26", "text": "你想要没有"}, {"type": "subtitle", "time": 1114.07, "timestamp": "00:18:34", "text": "[音乐]"}, {"type": "subtitle", "time": 1117.59, "timestamp": "00:18:37", "text": "我曾经也这么认为。认为"}, {"type": "subtitle", "time": 1120.39, "timestamp": "00:18:40", "text": "只要我付出的代价足够高，我"}, {"type": "subtitle", "time": 1122.63, "timestamp": "00:18:42", "text": "可以达到我想要的结果。我只是"}, {"type": "subtitle", "time": 1124.71, "timestamp": "00:18:44", "text": "醒了。优质产品稀缺。希望你"}, {"type": "subtitle", "time": 1127.35, "timestamp": "00:18:47", "text": "祝您早安。吃晚饭。我"}, {"type": "subtitle", "time": 1130.87, "timestamp": "00:18:50", "text": "吃了早餐之类的东西，然后去了那里。好的"}, {"type": "subtitle", "time": 1132.95, "timestamp": "00:18:52", "text": "运气。祝你好运。"}, {"type": "subtitle", "time": 1135.83, "timestamp": "00:18:55", "text": "要获得同等的报应，一个人必须"}]
[{"type": "subtitle", "time": 18720.948, "timestamp": "05:12:00", "text": "说出来。我不想谈论这件事。"}, {"type": "subtitle", "time": 18724.868, "timestamp": "05:12:04", "text": "我会。哦，等等。什么？"}, {"type": "subtitle", "time": 18727.03, "timestamp": "05:12:07", "text": "现在太迟了。"}, {"type": "subtitle", "time": 18728.628, "timestamp": "05:12:08", "text": "好的。"}, {"type": "subtitle", "time": 18730.31, "timestamp": "05:12:10", "text": "等等，如果我现在看到了呢？比如，是"}, {"type": "subtitle", "time": 18734.39, "timestamp": "05:12:14", "text": "办公室关门了吗？不。什么？嗯？"}, {"type": "subtitle", "time": 18737.11, "timestamp": "05:12:17", "text": "关闭。对不起。太迟了。操。"}, {"type": "subtitle", "time": 18739.03, "timestamp": "05:12:19", "text": "是的，我之前确实有这个兴致，但是"}, {"type": "subtitle", "time": 18743.43, "timestamp": "05:12:23", "text": "现在我不是了。一个男人。该死。"}, {"type": "subtitle", "time": 18746.708, "timestamp": "05:12:26", "text": "一切。他可能想要。"}, {"type": "subtitle", "time": 18749.83, "timestamp": "05:12:29", "text": "不，不，我会等到我的机会。"}, {"type": "subtitle", "time": 18751.51, "timestamp": "05:12:31", "text": "你很快就会迎来属于你的时刻。"}, {"type": "subtitle", "time": 18755.35, "timestamp": "05:12:35", "text": "你能吗？我会有属于我的时刻。哦。哦。的"}, {"type": "subtitle", "time": 18756.948, "timestamp": "05:12:36", "text": "课程。是的。过来。坚持，稍等。地狱"}, {"type": "subtitle", "time": 18760.27, "timestamp": "05:12:40", "text": "是的。当然。当然。"}, {"type": "subtitle", "time": 18761.67, "timestamp": "05:12:41", "text": "[音乐]"}, {"type": "subtitle", "time": 18766.708, "timestamp": "05:12:46", "text": "住手。"}, {"type": "subtitle", "time": 18775.99, "timestamp": "05:12:55", "text": "别闹了，伙计们。"}, {"type": "subtitle", "time": 18779.03, "timestamp": "05:12:59", "text": "你疯了。你为什么要这样做？"}]
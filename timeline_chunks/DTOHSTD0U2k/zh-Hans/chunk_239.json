[{"type": "subtitle", "time": 14354.87, "timestamp": "03:59:14", "text": "等待。好的。那是什么地方？你好。是的，"}, {"type": "subtitle", "time": 14355.92, "timestamp": "03:59:15", "text": "我们从未见过。"}, {"type": "subtitle", "time": 14357.269, "timestamp": "03:59:17", "text": "[音乐]"}, {"type": "subtitle", "time": 14359.59, "timestamp": "03:59:19", "text": "我刚才真的看到了Oxy"}, {"type": "subtitle", "time": 14363.349, "timestamp": "03:59:23", "text": "走向尸体。什么？不。"}, {"type": "subtitle", "time": 14368.309, "timestamp": "03:59:28", "text": "不，我和奥克西在一起。她"}, {"type": "subtitle", "time": 14370.95, "timestamp": "03:59:30", "text": "我们当时在一起。"}, {"type": "subtitle", "time": 14373.429, "timestamp": "03:59:33", "text": "兄弟，这个人到底怎么了？什么？"}, {"type": "subtitle", "time": 14380.469, "timestamp": "03:59:40", "text": "什么也不做。他把责任推卸给所有人。"}, {"type": "subtitle", "time": 14383.03, "timestamp": "03:59:43", "text": "兄弟。这就是游戏的玩法。你"}, {"type": "subtitle", "time": 14385.51, "timestamp": "03:59:45", "text": "把责任推给别人。"}, {"type": "subtitle", "time": 14388.07, "timestamp": "03:59:48", "text": "而他就是你的化身。"}, {"type": "subtitle", "time": 14390.07, "timestamp": "03:59:50", "text": "是的，"}, {"type": "subtitle", "time": 14392.229, "timestamp": "03:59:52", "text": "我和吉野在一起。"}, {"type": "subtitle", "time": 14396.389, "timestamp": "03:59:56", "text": "这些人，兄弟。生日快乐。"}, {"type": "subtitle", "time": 14398.79, "timestamp": "03:59:58", "text": "或者别的什么吧。生日快乐，"}]
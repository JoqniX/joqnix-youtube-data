[{"type": "subtitle", "time": 12780.79, "timestamp": "03:33:00", "text": "随机的。等待。手表。手表。是的，我是"}, {"type": "subtitle", "time": 12782.469, "timestamp": "03:33:02", "text": "我随机挑选。哦，没事了。我是"}, {"type": "subtitle", "time": 12786.15, "timestamp": "03:33:06", "text": "选择我是专业的。"}, {"type": "subtitle", "time": 12789.03, "timestamp": "03:33:09", "text": "哦亲爱的。呃，我感觉自己离目标很远"}, {"type": "subtitle", "time": 12798.71, "timestamp": "03:33:18", "text": "如何选择？如何选择？"}, {"type": "subtitle", "time": 12807.429, "timestamp": "03:33:27", "text": "我。我们不知道参赛选手都有谁。"}, {"type": "subtitle", "time": 12813.83, "timestamp": "03:33:33", "text": "他是第二名。"}, {"type": "subtitle", "time": 12815.19, "timestamp": "03:33:35", "text": "我真烦人。我认为是数字"}, {"type": "subtitle", "time": 12817.11, "timestamp": "03:33:37", "text": "二。"}, {"type": "subtitle", "time": 12819.51, "timestamp": "03:33:39", "text": "哇。专业的。"}, {"type": "subtitle", "time": 12822.309, "timestamp": "03:33:42", "text": "哟，想象一下当职业玩家是什么感觉。"}, {"type": "subtitle", "time": 12825.28, "timestamp": "03:33:45", "text": "你知道，我是职业玩家。你知道，"}, {"type": "subtitle", "time": 12827.75, "timestamp": "03:33:47", "text": "[音乐]"}, {"type": "subtitle", "time": 12829.349, "timestamp": "03:33:49", "text": "想象一下成为一名职业玩家。哦"}, {"type": "subtitle", "time": 12830.79, "timestamp": "03:33:50", "text": "糟了，我们抓到一只渡渡鸟。那将会是"}, {"type": "subtitle", "time": 12832.469, "timestamp": "03:33:52", "text": "乐趣。"}, {"type": "subtitle", "time": 12836.55, "timestamp": "03:33:56", "text": "哦，我们走吧。那肯定很有趣。我"}, {"type": "subtitle", "time": 12839.03, "timestamp": "03:33:59", "text": "我喜欢这只涂鸦鸟。是的，涂鸦鸟"}]
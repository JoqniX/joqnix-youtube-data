[{"type": "subtitle", "time": 7864.95, "timestamp": "02:11:04", "text": "夜幕降临。什么？ WHO？嗯？ WHO？"}, {"type": "subtitle", "time": 7866.55, "timestamp": "02:11:06", "text": "嗯？"}, {"type": "subtitle", "time": 7869.27, "timestamp": "02:11:09", "text": "什么？"}, {"type": "subtitle", "time": 7871.109, "timestamp": "02:11:11", "text": "没关系。没关系。没关系。那是"}, {"type": "subtitle", "time": 7872.95, "timestamp": "02:11:12", "text": "我们在那边可以。我会回来的。它是"}, {"type": "subtitle", "time": 7898.47, "timestamp": "02:11:38", "text": "与声音融为一体。别再聚会了，兄弟。"}, {"type": "subtitle", "time": 7901.589, "timestamp": "02:11:41", "text": "如同最后的复苏。"}, {"type": "subtitle", "time": 7904.55, "timestamp": "02:11:44", "text": "拥抱变化。"}]
[{"type": "subtitle", "time": 660.87, "timestamp": "00:11:00", "text": "工作。"}, {"type": "subtitle", "time": 662.87, "timestamp": "00:11:02", "text": "所有家庭都害怕怪物。我们"}, {"type": "subtitle", "time": 664.47, "timestamp": "00:11:04", "text": "我走了很远的路才找到这个"}, {"type": "subtitle", "time": 666.79, "timestamp": "00:11:06", "text": "新地方。我问了。"}, {"type": "subtitle", "time": 669.03, "timestamp": "00:11:09", "text": "呃，等爸爸妈妈赶上来的时候……"}, {"type": "subtitle", "time": 670.71, "timestamp": "00:11:10", "text": "叔叔跟我说，很快，就来了。"}, {"type": "subtitle", "time": 671.67, "timestamp": "00:11:11", "text": "等待。"}, {"type": "chat", "time": 673.915, "timestamp": "00:11:13", "author": "@Minkk102", "avatar": "https://yt4.ggpht.com/TF8h5uIigJBanBg4LA_XZaY69S8H6wHtAUIDSGgMxHUqkEYRKq0z9m5NM8cqeDFnXLN0nN8i8g=s64-c-k-c0x00ffffff-no-rj", "message": "suppp"}, {"type": "subtitle", "time": 674.23, "timestamp": "00:11:14", "text": "没有哪个地方比这里更阳光明媚了。哪棵树"}, {"type": "subtitle", "time": 675.99, "timestamp": "00:11:15", "text": "种桃子吗？这里人不多。"}, {"type": "subtitle", "time": 679.269, "timestamp": "00:11:19", "text": "去大城市。虽然我想要妈妈"}, {"type": "subtitle", "time": 682.15, "timestamp": "00:11:22", "text": "让爸爸来找我。"}, {"type": "subtitle", "time": 685.67, "timestamp": "00:11:25", "text": "今天是我的生日。"}, {"type": "subtitle", "time": 688.47, "timestamp": "00:11:28", "text": "自从我到了那里，感觉每个人都挺友善的。"}, {"type": "subtitle", "time": 690.71, "timestamp": "00:11:30", "text": "一大块。我不能留下那些怪物"}, {"type": "subtitle", "time": 694.31, "timestamp": "00:11:34", "text": "离开。大家都很喜欢我。孩子"}, {"type": "subtitle", "time": 696.71, "timestamp": "00:11:36", "text": "面条和礼物。它已经"}, {"type": "subtitle", "time": 699.19, "timestamp": "00:11:39", "text": "自从我再也没见过爸爸妈妈之后……"}, {"type": "subtitle", "time": 700.55, "timestamp": "00:11:40", "text": "尽管。希望他们能回来。他们会吗？"}, {"type": "subtitle", "time": 705.03, "timestamp": "00:11:45", "text": "回来？嗯，我从他那里得到了好处。"}, {"type": "chat", "time": 706.673, "timestamp": "00:11:46", "author": "@Minkk102", "avatar": "https://yt4.ggpht.com/TF8h5uIigJBanBg4LA_XZaY69S8H6wHtAUIDSGgMxHUqkEYRKq0z9m5NM8cqeDFnXLN0nN8i8g=s64-c-k-c0x00ffffff-no-rj", "message": "good morning/afternoon"}, {"type": "subtitle", "time": 707.11, "timestamp": "00:11:47", "text": "现在是女儿了。在此之前，每个人都有"}, {"type": "subtitle", "time": 709.99, "timestamp": "00:11:49", "text": "已经照顾过我，也和我分享过我"}, {"type": "subtitle", "time": 711.99, "timestamp": "00:11:51", "text": "美味佳肴。我父亲告诉我我是个"}, {"type": "subtitle", "time": 717.269, "timestamp": "00:11:57", "text": "我真是太幸运了。我曾被……爱过"}, {"type": "subtitle", "time": 718.949, "timestamp": "00:11:58", "text": "即使我的部分是"}]
[{"type": "subtitle", "time": 19204.23, "timestamp": "05:20:04", "text": "因为他们心存疑虑。什么？"}, {"type": "subtitle", "time": 19207.99, "timestamp": "05:20:07", "text": "士兵。我们先来。你看，我早就跟你说过吧？"}, {"type": "subtitle", "time": 19213.59, "timestamp": "05:20:13", "text": "我是士兵。我是坏人。"}, {"type": "subtitle", "time": 19217.19, "timestamp": "05:20:17", "text": "蝙蝠侠。好的。好的。亚特兰蒂斯。是的。为什么"}, {"type": "subtitle", "time": 19219.67, "timestamp": "05:20:19", "text": "难道我们不都是互相投票吗？每个人"}, {"type": "subtitle", "time": 19222.948, "timestamp": "05:20:22", "text": "吃。你们俩都跳过"}, {"type": "subtitle", "time": 19225.91, "timestamp": "05:20:25", "text": "如果我们不投票淘汰一个人的话。我的意思是，我们"}, {"type": "subtitle", "time": 19228.47, "timestamp": "05:20:28", "text": "我们赢了，路易斯。我们，我们，我们有五个。"}, {"type": "subtitle", "time": 19231.99, "timestamp": "05:20:31", "text": "是啊，没错。是的。我其实没有"}, {"type": "subtitle", "time": 19234.23, "timestamp": "05:20:34", "text": "知道是否像清澈的尸体一样已经死了吗？"}, {"type": "subtitle", "time": 19235.91, "timestamp": "05:20:35", "text": "不是。"}, {"type": "subtitle", "time": 19237.99, "timestamp": "05:20:37", "text": "是啊，但我们只有五个人。"}, {"type": "subtitle", "time": 19240.708, "timestamp": "05:20:40", "text": "左边，右边？我跳过。"}, {"type": "subtitle", "time": 19244.07, "timestamp": "05:20:44", "text": "是的，我也要跳过。"}, {"type": "subtitle", "time": 19246.868, "timestamp": "05:20:46", "text": "我跳过。你死定了。我 我"}, {"type": "subtitle", "time": 19248.708, "timestamp": "05:20:48", "text": "心存疑虑。"}, {"type": "subtitle", "time": 19251.43, "timestamp": "05:20:51", "text": "我怀疑Willow。"}, {"type": "subtitle", "time": 19255.35, "timestamp": "05:20:55", "text": "当然是。我怀疑Willow。"}, {"type": "subtitle", "time": 19257.67, "timestamp": "05:20:57", "text": "只有Willow和我们在一起。柳"}]
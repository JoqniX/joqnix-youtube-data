[{"type": "subtitle", "time": 18318.55, "timestamp": "05:05:18", "text": "你好。你觉得我们应该开始吗？"}, {"type": "subtitle", "time": 18320.23, "timestamp": "05:05:20", "text": "召开紧急会议，目的只是为了重新安排。"}, {"type": "subtitle", "time": 18322.39, "timestamp": "05:05:22", "text": "鸽子的进展如何？"}, {"type": "subtitle", "time": 18325.59, "timestamp": "05:05:25", "text": "为什么是鸽子？呃，为了重置鸽子的"}, {"type": "subtitle", "time": 18327.83, "timestamp": "05:05:27", "text": "进步。是的。所以他们的进展"}, {"type": "subtitle", "time": 18329.03, "timestamp": "05:05:29", "text": "重置。"}, {"type": "subtitle", "time": 18330.31, "timestamp": "05:05:30", "text": "可以开始会议了吗？等等，这是什么？"}, {"type": "subtitle", "time": 18339.67, "timestamp": "05:05:39", "text": "我动不了。哦，这很有帮助。你好。"}, {"type": "subtitle", "time": 18343.19, "timestamp": "05:05:43", "text": "为什么不能静音？帮助。我动不了。"}, {"type": "subtitle", "time": 18346.55, "timestamp": "05:05:46", "text": "保护我。保护我。"}, {"type": "subtitle", "time": 18348.39, "timestamp": "05:05:48", "text": "你是什​​么意思？哦，好了。那里"}, {"type": "subtitle", "time": 18350.47, "timestamp": "05:05:50", "text": "我们走。"}, {"type": "subtitle", "time": 18352.31, "timestamp": "05:05:52", "text": "那个怪异的怪物碰了我，然后我"}, {"type": "subtitle", "time": 18355.83, "timestamp": "05:05:55", "text": "动弹不得。啊，我听到了咯咯声。"}]
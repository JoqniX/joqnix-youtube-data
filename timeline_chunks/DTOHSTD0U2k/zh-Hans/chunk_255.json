[{"type": "subtitle", "time": 15301.349, "timestamp": "04:15:01", "text": "男生。它的确很甜，但是"}, {"type": "subtitle", "time": 15305.51, "timestamp": "04:15:05", "text": "别忘了在Discord上静音。"}, {"type": "subtitle", "time": 15326.309, "timestamp": "04:15:26", "text": "等待。不，事情是这样的，"}, {"type": "subtitle", "time": 15328.63, "timestamp": "04:15:28", "text": "尽管。哦，等等。所以，你为什么要杀人？"}, {"type": "subtitle", "time": 15336.95, "timestamp": "04:15:36", "text": "妈的。"}, {"type": "subtitle", "time": 15341.269, "timestamp": "04:15:41", "text": "哦，他不在。我懂了。好的，兄弟。是他吗？"}, {"type": "subtitle", "time": 15342.63, "timestamp": "04:15:42", "text": "准备引爆炸弹吗？你要去"}, {"type": "subtitle", "time": 15345.429, "timestamp": "04:15:45", "text": "清理道路。"}, {"type": "subtitle", "time": 15355.03, "timestamp": "04:15:55", "text": "降低。他为什么不放出重磅炸弹？"}, {"type": "subtitle", "time": 15359.189, "timestamp": "04:15:59", "text": "该死。你好。等待。呃，所以只有呃我们"}]
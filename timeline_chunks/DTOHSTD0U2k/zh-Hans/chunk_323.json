[{"type": "subtitle", "time": 19383.59, "timestamp": "05:23:03", "text": "我的天哪。呃，等等。你知道，我们是"}, {"type": "subtitle", "time": 19385.27, "timestamp": "05:23:05", "text": "将会输掉比赛。我们要输了。我"}, {"type": "subtitle", "time": 19392.07, "timestamp": "05:23:12", "text": "我的意思是，我们三个都是杀手。"}, {"type": "subtitle", "time": 19401.11, "timestamp": "05:23:21", "text": "我的天啊。帮我。帮我。我的天哪。"}, {"type": "subtitle", "time": 19431.43, "timestamp": "05:23:51", "text": "没看到。哦，我就知道我知道他"}]
[{"type": "subtitle", "time": 1501.51, "timestamp": "00:25:01", "text": "并收回了他实现愿望的能力。"}, {"type": "subtitle", "time": 1513.35, "timestamp": "00:25:13", "text": "从一开始，羔羊们就知道"}, {"type": "subtitle", "time": 1516.31, "timestamp": "00:25:16", "text": "许愿的风险。他们也"}, {"type": "subtitle", "time": 1518.95, "timestamp": "00:25:18", "text": "可能成为那些人的牺牲品"}, {"type": "subtitle", "time": 1521.11, "timestamp": "00:25:21", "text": "其他的。"}, {"type": "subtitle", "time": 1524.47, "timestamp": "00:25:24", "text": "灯相信"}, {"type": "subtitle", "time": 1530.87, "timestamp": "00:25:30", "text": "与此同时，一些羔羊这样推断："}, {"type": "subtitle", "time": 1532.71, "timestamp": "00:25:32", "text": "因为他们已经冒了风险"}, {"type": "subtitle", "time": 1535.83, "timestamp": "00:25:35", "text": "为了满足别人的愿望而牺牲，它"}, {"type": "subtitle", "time": 1538.789, "timestamp": "00:25:38", "text": "那么，将风险转嫁出去才是公平的。"}, {"type": "subtitle", "time": 1541.35, "timestamp": "00:25:41", "text": "为了有机会实现自己的梦想"}, {"type": "subtitle", "time": 1544.71, "timestamp": "00:25:44", "text": "欲望。于是他们继续玩了起来。"}, {"type": "subtitle", "time": 1547.83, "timestamp": "00:25:47", "text": "游戏。"}, {"type": "subtitle", "time": 1550.87, "timestamp": "00:25:50", "text": "他们都清楚后果，但还是选择了这样做。"}, {"type": "subtitle", "time": 1557.909, "timestamp": "00:25:57", "text": "既恐惧又贪婪。既恐惧又贪婪。"}]
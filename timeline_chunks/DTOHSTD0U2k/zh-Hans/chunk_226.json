[{"type": "subtitle", "time": 13561.429, "timestamp": "03:46:01", "text": "寂静无声。我一直跟你们说，"}, {"type": "subtitle", "time": 13562.71, "timestamp": "03:46:02", "text": "对，所以我才那样说。"}, {"type": "subtitle", "time": 13565.269, "timestamp": "03:46:05", "text": "他绝不可能做出这样的事"}, {"type": "subtitle", "time": 13567.51, "timestamp": "03:46:07", "text": "简单的错误。他真的杀人了"}, {"type": "subtitle", "time": 13576.15, "timestamp": "03:46:16", "text": "那是我。那是我。那是我。我"}, {"type": "subtitle", "time": 13578.389, "timestamp": "03:46:18", "text": "转变。"}, {"type": "subtitle", "time": 13580.15, "timestamp": "03:46:20", "text": "喜欢"}, {"type": "subtitle", "time": 13581.91, "timestamp": "03:46:21", "text": "改变"}, {"type": "subtitle", "time": 13585.51, "timestamp": "03:46:25", "text": "就是那个变形器，兄弟。我只是"}, {"type": "subtitle", "time": 13587.59, "timestamp": "03:46:27", "text": "看到两台RX在运行，我就像其中一台一样。"}, {"type": "subtitle", "time": 13595.349, "timestamp": "03:46:35", "text": "老兄，别杀我。我们在作弊。哦，"}, {"type": "subtitle", "time": 13598.95, "timestamp": "03:46:38", "text": "我们养了一只鸽子。鸽子。我不认为"}, {"type": "subtitle", "time": 13601.189, "timestamp": "03:46:41", "text": "他最爱社交。"}, {"type": "subtitle", "time": 13603.429, "timestamp": "03:46:43", "text": "他最善于交际。我知道什么是"}, {"type": "subtitle", "time": 13606.87, "timestamp": "03:46:46", "text": "鸽子确实会这样做。不要碰任何人"}, {"type": "subtitle", "time": 13610.07, "timestamp": "03:46:50", "text": "想赢。是PJ要碰吗？"}, {"type": "subtitle", "time": 13611.75, "timestamp": "03:46:51", "text": "你认识的所有人。真是太敏感了。是的。"}, {"type": "subtitle", "time": 13614.55, "timestamp": "03:46:54", "text": "坏人，坏蛋。是的。他们得到了"}, {"type": "subtitle", "time": 13617.75, "timestamp": "03:46:57", "text": "新冠病毒。坏人。新冠病毒。"}]
[{"type": "subtitle", "time": 15362.79, "timestamp": "04:16:02", "text": "死人也能听到彼此的声音，或者他们"}, {"type": "subtitle", "time": 15365.59, "timestamp": "04:16:05", "text": "听不到我们说话。他们听不到我们说话。他们"}, {"type": "subtitle", "time": 15368.79, "timestamp": "04:16:08", "text": "听不到所有声音。嗯。为什么？"}, {"type": "subtitle", "time": 15373.67, "timestamp": "04:16:13", "text": "你为什么不？你为什么不？嗯嗯"}, {"type": "subtitle", "time": 15376.469, "timestamp": "04:16:16", "text": "说？那我们就静音吧。"}, {"type": "subtitle", "time": 15378.95, "timestamp": "04:16:18", "text": "你们为什么都在静音状态下说话？"}, {"type": "subtitle", "time": 15381.99, "timestamp": "04:16:21", "text": "仅文字。哦，他终于成了个重要人物。他"}, {"type": "subtitle", "time": 15384.87, "timestamp": "04:16:24", "text": "某人"}, {"type": "subtitle", "time": 15386.01, "timestamp": "04:16:26", "text": "知道。"}, {"type": "subtitle", "time": 15388.63, "timestamp": "04:16:28", "text": "[音乐]"}, {"type": "subtitle", "time": 15391.91, "timestamp": "04:16:31", "text": "你好。我死了。"}, {"type": "subtitle", "time": 15398.71, "timestamp": "04:16:38", "text": "该死的。"}, {"type": "subtitle", "time": 15402.63, "timestamp": "04:16:42", "text": "哦，原来是你啊，兄弟。该死的。"}, {"type": "subtitle", "time": 15408.79, "timestamp": "04:16:48", "text": "这就是我不想跟你在一起的原因。"}, {"type": "subtitle", "time": 15411.51, "timestamp": "04:16:51", "text": "你知道，我的角色就​​是这样。"}, {"type": "subtitle", "time": 15415.91, "timestamp": "04:16:55", "text": "雷内赢了。雷内赢了。鸽子赢了。"}, {"type": "subtitle", "time": 15418.79, "timestamp": "04:16:58", "text": "鸽子赢了。总是。我告诉你"}]
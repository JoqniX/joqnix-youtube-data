[{"type": "subtitle", "time": 15181.91, "timestamp": "04:13:01", "text": "但事实并非如此。"}, {"type": "subtitle", "time": 15189.99, "timestamp": "04:13:09", "text": "这样你就能轻松获胜。"}, {"type": "subtitle", "time": 15192.389, "timestamp": "04:13:12", "text": "哇。"}, {"type": "subtitle", "time": 15195.67, "timestamp": "04:13:15", "text": "就像这部剧一样，因为这部剧太精彩了。"}, {"type": "subtitle", "time": 15199.03, "timestamp": "04:13:19", "text": "又好了。"}, {"type": "subtitle", "time": 15203.03, "timestamp": "04:13:23", "text": "哇。哇。我懂了。"}, {"type": "subtitle", "time": 15206.309, "timestamp": "04:13:26", "text": "我明白了。我的天啊。伙计们，她"}, {"type": "subtitle", "time": 15221.03, "timestamp": "04:13:41", "text": "你好，特伦。我独自一人。你好。你好。"}, {"type": "subtitle", "time": 15231.03, "timestamp": "04:13:51", "text": "他们要么能听到我们说话，要么听不到我们说话。"}, {"type": "subtitle", "time": 15233.99, "timestamp": "04:13:53", "text": "我认为只有死者才能……"}, {"type": "subtitle", "time": 15236.87, "timestamp": "04:13:56", "text": "互相倾听。他们听不到我们说话。我们"}]
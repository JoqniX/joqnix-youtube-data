[{"type": "subtitle", "time": 481.11, "timestamp": "00:08:01", "text": "最后的仪式。"}, {"type": "subtitle", "time": 484.07, "timestamp": "00:08:04", "text": "好极了。没想到你会注意到"}, {"type": "subtitle", "time": 485.589, "timestamp": "00:08:05", "text": "那。"}, {"type": "subtitle", "time": 488.07, "timestamp": "00:08:08", "text": "那么，你的结论是什么？"}, {"type": "subtitle", "time": 495.69, "timestamp": "00:08:15", "text": "嗯，"}, {"type": "subtitle", "time": 501.909, "timestamp": "00:08:21", "text": "[音乐]"}, {"type": "subtitle", "time": 504.629, "timestamp": "00:08:24", "text": "看来你不太信任那些人。"}, {"type": "subtitle", "time": 512.23, "timestamp": "00:08:32", "text": "啊，看来他们对你的评价是对的。你"}, {"type": "subtitle", "time": 514.539, "timestamp": "00:08:34", "text": "确实非常出色。"}, {"type": "subtitle", "time": 517.509, "timestamp": "00:08:37", "text": "[音乐]"}, {"type": "subtitle", "time": 520.87, "timestamp": "00:08:40", "text": "我喜欢。你观察力敏锐，"}, {"type": "subtitle", "time": 523.99, "timestamp": "00:08:43", "text": "精准的判断，以及准确的"}, {"type": "subtitle", "time": 527.269, "timestamp": "00:08:47", "text": "对人性的理解。"}, {"type": "subtitle", "time": 535.19, "timestamp": "00:08:55", "text": "嗯？真相远比这复杂得多。"}, {"type": "subtitle", "time": 538.63, "timestamp": "00:08:58", "text": "比你想象的要多。"}]
[{"type": "subtitle", "time": 11700.229, "timestamp": "03:15:00", "text": "哦，如果你什么都不知道的话。"}, {"type": "subtitle", "time": 11704.389, "timestamp": "03:15:04", "text": "顶级刺客的角色，对吧？那是"}, {"type": "subtitle", "time": 11706.18, "timestamp": "03:15:06", "text": "信息。"}, {"type": "subtitle", "time": 11707.269, "timestamp": "03:15:07", "text": "[音乐]"}, {"type": "subtitle", "time": 11712.71, "timestamp": "03:15:12", "text": "破坏。"}, {"type": "subtitle", "time": 11723.03, "timestamp": "03:15:23", "text": "理解我的角色，因为这是"}, {"type": "subtitle", "time": 11725.429, "timestamp": "03:15:25", "text": "无法使用。好的。在右上角"}, {"type": "subtitle", "time": 11727.269, "timestamp": "03:15:27", "text": "有一个“I”按钮。所以你可以点击"}, {"type": "subtitle", "time": 11728.95, "timestamp": "03:15:28", "text": "还要检查一下每个人的角色。"}, {"type": "subtitle", "time": 11730.87, "timestamp": "03:15:30", "text": "选择。"}, {"type": "subtitle", "time": 11732.63, "timestamp": "03:15:32", "text": "务必仔细阅读你的角色描述。"}, {"type": "subtitle", "time": 11734.63, "timestamp": "03:15:34", "text": "现在。是的。比如，一定要阅读你的"}, {"type": "subtitle", "time": 11736.07, "timestamp": "03:15:36", "text": "现在就扮演这个角色，因为在游戏中你可能不会"}, {"type": "subtitle", "time": 11737.99, "timestamp": "03:15:37", "text": "能够看到它的描述，但是"}, {"type": "subtitle", "time": 11739.429, "timestamp": "03:15:39", "text": "你会看到其他的描述。"}, {"type": "subtitle", "time": 11741.429, "timestamp": "03:15:41", "text": "角色。问题是我看不见我的"}, {"type": "subtitle", "time": 11744.15, "timestamp": "03:15:44", "text": "角色。呃"}, {"type": "subtitle", "time": 11746.15, "timestamp": "03:15:46", "text": "随机的那个。好的。是的。你得到了"}, {"type": "subtitle", "time": 11747.51, "timestamp": "03:15:47", "text": "随机角色，对吧？就像在你的屏幕上一样"}, {"type": "subtitle", "time": 11749.67, "timestamp": "03:15:49", "text": "肯定有什么事。那是你的职责。"}, {"type": "subtitle", "time": 11752.309, "timestamp": "03:15:52", "text": "不过，千万别这么说。别这么说。"}, {"type": "subtitle", "time": 11754.229, "timestamp": "03:15:54", "text": "尽管。你被赋予了一个角色，但是我"}, {"type": "subtitle", "time": 11756.469, "timestamp": "03:15:56", "text": "真的不明白，因为有"}, {"type": "subtitle", "time": 11758.87, "timestamp": "03:15:58", "text": "没有相关信息。"}]
[{"type": "subtitle", "time": 18601.91, "timestamp": "05:10:01", "text": "我一直都很信任他，然后我就死了"}, {"type": "subtitle", "time": 18605.67, "timestamp": "05:10:05", "text": "两次都是如此。我两个时期都喜欢。是的。"}, {"type": "subtitle", "time": 18607.19, "timestamp": "05:10:07", "text": "我喜欢平静下来。冷静下来。我要去"}, {"type": "subtitle", "time": 18610.23, "timestamp": "05:10:10", "text": "我杀了她，然后抓住了她就走了。"}, {"type": "subtitle", "time": 18615.27, "timestamp": "05:10:15", "text": "是的。我也是。所以我尝试我是"}, {"type": "subtitle", "time": 18623.43, "timestamp": "05:10:23", "text": "我玩弄了心理战。"}, {"type": "subtitle", "time": 18624.948, "timestamp": "05:10:24", "text": "我们彼此之间唯一玩的心理游戏就是这些"}, {"type": "subtitle", "time": 18628.47, "timestamp": "05:10:28", "text": "另一方正在互相射击。"}, {"type": "subtitle", "time": 18630.31, "timestamp": "05:10:30", "text": "我们的智商远超他们"}, {"type": "subtitle", "time": 18632.15, "timestamp": "05:10:32", "text": "理解。就像我们的一样，是的。"}, {"type": "subtitle", "time": 18633.67, "timestamp": "05:10:33", "text": "说实话，我们真的太难搞了。"}, {"type": "subtitle", "time": 18635.83, "timestamp": "05:10:35", "text": "理解。我们拥有海量大脑。"}, {"type": "subtitle", "time": 18637.75, "timestamp": "05:10:37", "text": "确切地。我们已经升华了。我希望你"}, {"type": "subtitle", "time": 18639.35, "timestamp": "05:10:39", "text": "赢。这就是我被你感染的原因。我"}, {"type": "subtitle", "time": 18642.31, "timestamp": "05:10:42", "text": "知道。是的。我知道你是一个我"}, {"type": "subtitle", "time": 18643.99, "timestamp": "05:10:43", "text": "有一种感觉，你其实早就知道了。我感觉"}, {"type": "subtitle", "time": 18646.47, "timestamp": "05:10:46", "text": "我感觉你明白了。正确的。我"}, {"type": "subtitle", "time": 18649.03, "timestamp": "05:10:49", "text": "知道吧？我还能说什么呢？"}, {"type": "subtitle", "time": 18652.07, "timestamp": "05:10:52", "text": "这是我们之间的纽带。我兄弟很棒"}, {"type": "subtitle", "time": 18654.788, "timestamp": "05:10:54", "text": "英雄所见略同。我知道这会让我们……"}, {"type": "subtitle", "time": 18657.91, "timestamp": "05:10:57", "text": "我知道你们是天生一对。"}]
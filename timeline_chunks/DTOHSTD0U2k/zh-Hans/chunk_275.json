[{"type": "subtitle", "time": 16500.15, "timestamp": "04:35:00", "text": "感染者。好的。你当时为什么在那里？"}, {"type": "subtitle", "time": 16503.349, "timestamp": "04:35:03", "text": "那你跟着我吗？因为这样做很有趣"}, {"type": "subtitle", "time": 16505.349, "timestamp": "04:35:05", "text": "杀了我。我会死。但你要远离"}, {"type": "subtitle", "time": 16508.31, "timestamp": "04:35:08", "text": "来自我。不，你离我远点。"}, {"type": "subtitle", "time": 16511.51, "timestamp": "04:35:11", "text": "伙计们，我们应该投票把他赶下台吗？伙计们，就"}, {"type": "subtitle", "time": 16516.709, "timestamp": "04:35:16", "text": "看着我前面的人。没关系。"}, {"type": "subtitle", "time": 16518.629, "timestamp": "04:35:18", "text": "你知道我经常说什么吗？科克，"}, {"type": "subtitle", "time": 16520.23, "timestamp": "04:35:20", "text": "我们有太多人要失去。抓住他"}, {"type": "subtitle", "time": 16533.59, "timestamp": "04:35:33", "text": "再见。"}, {"type": "subtitle", "time": 16559.429, "timestamp": "04:35:59", "text": "好了，我们又回到我们的小博物馆了。"}]
[{"type": "subtitle", "time": 15003.269, "timestamp": "04:10:03", "text": "我打算跳过。即使它是一个"}, {"type": "subtitle", "time": 15006.469, "timestamp": "04:10:06", "text": "如果输入错误，他确实杀人了，对吗？"}, {"type": "subtitle", "time": 15009.75, "timestamp": "04:10:09", "text": "误杀。我的天啊。多少"}, {"type": "subtitle", "time": 15025.67, "timestamp": "04:10:25", "text": "叮叮叮叮叮。你好。"}, {"type": "subtitle", "time": 15038.87, "timestamp": "04:10:38", "text": "伙计们。到我前面来。是特伦斯。"}, {"type": "subtitle", "time": 15041.189, "timestamp": "04:10:41", "text": "第二个人是特伦斯。所以，呃，我"}, {"type": "subtitle", "time": 15044.469, "timestamp": "04:10:44", "text": "还有 Ox 和 Terrence。我们都诞生于"}, {"type": "subtitle", "time": 15046.229, "timestamp": "04:10:46", "text": "墓地下方。我们都诞生于"}, {"type": "subtitle", "time": 15049.03, "timestamp": "04:10:49", "text": "同时，它们就在我面前。没有。"}, {"type": "subtitle", "time": 15051.349, "timestamp": "04:10:51", "text": "没有。是他。是，是"}, {"type": "subtitle", "time": 15054.07, "timestamp": "04:10:54", "text": "拖拽。那是一条龙。它被拖走了。"}, {"type": "subtitle", "time": 15056.07, "timestamp": "04:10:56", "text": "我离尸体比他远。"}, {"type": "subtitle", "time": 15058.389, "timestamp": "04:10:58", "text": "曾是。我离尸体比较远。"}]
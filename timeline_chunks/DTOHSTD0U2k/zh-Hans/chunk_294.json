[{"type": "subtitle", "time": 17644.628, "timestamp": "04:54:04", "text": "是的。这取决于你们是否是恋人。是的。"}, {"type": "subtitle", "time": 17646.708, "timestamp": "04:54:06", "text": "是的。如果你是恋人，我觉得你们"}, {"type": "subtitle", "time": 17648.31, "timestamp": "04:54:08", "text": "他能看到我。"}, {"type": "subtitle", "time": 17652.07, "timestamp": "04:54:12", "text": "我们看不到它。我们能看到你的“嗯？”"}, {"type": "subtitle", "time": 17654.07, "timestamp": "04:54:14", "text": "好的。我们看不见。有人是亲戚"}, {"type": "subtitle", "time": 17668.15, "timestamp": "04:54:28", "text": "你好。"}, {"type": "subtitle", "time": 17680.23, "timestamp": "04:54:40", "text": "你在开玩笑吗？你好。"}, {"type": "subtitle", "time": 17681.99, "timestamp": "04:54:41", "text": "所以，"}, {"type": "subtitle", "time": 17685.11, "timestamp": "04:54:45", "text": "相信我。什么？"}, {"type": "subtitle", "time": 17698.39, "timestamp": "04:54:58", "text": "我的天啊。你在哪里？哪里"}]
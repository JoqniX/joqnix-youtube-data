[{"type": "subtitle", "time": 17403.03, "timestamp": "04:50:03", "text": "韩元？"}, {"type": "subtitle", "time": 17405.03, "timestamp": "04:50:05", "text": "我猜是小猫咪。你是如何给我的"}, {"type": "subtitle", "time": 17407.67, "timestamp": "04:50:07", "text": "炸弹？你离我那么远。我没有"}, {"type": "subtitle", "time": 17410.31, "timestamp": "04:50:10", "text": "给你炸弹。哦，它开始了。"}, {"type": "subtitle", "time": 17413.35, "timestamp": "04:50:13", "text": "过一段时间后就粘住了。他妈的。不，不"}, {"type": "subtitle", "time": 17415.51, "timestamp": "04:50:15", "text": "不。我没把炸弹递给你。我通过了"}, {"type": "subtitle", "time": 17418.868, "timestamp": "04:50:18", "text": "Yoshi 哦，你把它传给了 Yoshi。"}, {"type": "subtitle", "time": 17420.708, "timestamp": "04:50:20", "text": "她把它递给我，我以为她"}, {"type": "subtitle", "time": 17427.19, "timestamp": "04:50:27", "text": "意思是"}, {"type": "subtitle", "time": 17429.67, "timestamp": "04:50:29", "text": "那"}, {"type": "subtitle", "time": 17432.868, "timestamp": "04:50:32", "text": "谢谢你的款待。等等，我做了你？是的，我"}, {"type": "subtitle", "time": 17434.15, "timestamp": "04:50:34", "text": "我一直在给你打电话。他没说"}, {"type": "subtitle", "time": 17436.47, "timestamp": "04:50:36", "text": "任何事物。我是一个幽灵。我"}, {"type": "subtitle", "time": 17438.628, "timestamp": "04:50:38", "text": "感觉就像从我身体里消失了一样。"}, {"type": "subtitle", "time": 17442.15, "timestamp": "04:50:42", "text": "这就是我听不到你说话的原因。"}, {"type": "subtitle", "time": 17443.75, "timestamp": "04:50:43", "text": "不。哦，你什么也没说。所以，我"}, {"type": "subtitle", "time": 17444.708, "timestamp": "04:50:44", "text": "当时我就想，“哦，去你的。”进而"}, {"type": "subtitle", "time": 17453.19, "timestamp": "04:50:53", "text": "我没有无视你。但我并不是那个人。"}, {"type": "subtitle", "time": 17455.67, "timestamp": "04:50:55", "text": "是谁把B传给你的？不是我。"}]
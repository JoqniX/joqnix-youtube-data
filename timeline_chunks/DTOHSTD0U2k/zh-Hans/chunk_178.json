[{"type": "subtitle", "time": 10703.51, "timestamp": "02:58:23", "text": "该死。我们都在放屁。呃，最高法院"}, {"type": "subtitle", "time": 10710.309, "timestamp": "02:58:30", "text": "我这儿的排便简直没完没了。"}, {"type": "subtitle", "time": 10714.23, "timestamp": "02:58:34", "text": "没必要那样做。"}, {"type": "subtitle", "time": 10717.03, "timestamp": "02:58:37", "text": "耽误。我打算补充"}, {"type": "subtitle", "time": 10718.55, "timestamp": "02:58:38", "text": "某人。"}, {"type": "subtitle", "time": 10722.71, "timestamp": "02:58:42", "text": "我只是想怀疑一下。"}, {"type": "subtitle", "time": 10725.11, "timestamp": "02:58:45", "text": "只是去见见那些外国的、爱炫耀的人。"}, {"type": "subtitle", "time": 10727.19, "timestamp": "02:58:47", "text": "哦，确实如此。"}, {"type": "subtitle", "time": 10730.23, "timestamp": "02:58:50", "text": "这是什么门？那是什么？"}, {"type": "subtitle", "time": 10732.95, "timestamp": "02:58:52", "text": "看起来像是下界传送门。是的，那是一个"}, {"type": "subtitle", "time": 10735.75, "timestamp": "02:58:55", "text": "通往Minecraft的传送门。如果你们愿意的话"}, {"type": "subtitle", "time": 10737.75, "timestamp": "02:58:57", "text": "转到四，它会带你到"}]
[{"type": "subtitle", "time": 13804.79, "timestamp": "03:50:04", "text": "刚刚发生在我身上了吗？什么？"}, {"type": "subtitle", "time": 13809.03, "timestamp": "03:50:09", "text": "等待。我不是害怕你。"}, {"type": "subtitle", "time": 13818.63, "timestamp": "03:50:18", "text": "你为什么现在要伤害我？"}, {"type": "subtitle", "time": 13821.51, "timestamp": "03:50:21", "text": "怎么了？"}, {"type": "subtitle", "time": 13824.229, "timestamp": "03:50:24", "text": "恢复正常。"}, {"type": "subtitle", "time": 13826.71, "timestamp": "03:50:26", "text": "你是杀人犯吗，狗？不，我不是。我是"}, {"type": "subtitle", "time": 13829.51, "timestamp": "03:50:29", "text": "不是。你是杀人犯吗？"}, {"type": "subtitle", "time": 13831.11, "timestamp": "03:50:31", "text": "[音乐]"}, {"type": "subtitle", "time": 13833.349, "timestamp": "03:50:33", "text": "好的。有人知道是谁吗？"}, {"type": "subtitle", "time": 13837.11, "timestamp": "03:50:37", "text": "以前是药剂师吗？因为我正在努力"}, {"type": "subtitle", "time": 13838.469, "timestamp": "03:50:38", "text": "弄清楚人们在哪里，然后我发现"}, {"type": "subtitle", "time": 13842.469, "timestamp": "03:50:42", "text": "这混蛋死在那儿了。哦，不。"}, {"type": "subtitle", "time": 13846.389, "timestamp": "03:50:46", "text": "我和阿拉莎当时在一起"}, {"type": "subtitle", "time": 13850.309, "timestamp": "03:50:50", "text": "教堂通过点燃蜡烛的方式"}, {"type": "subtitle", "time": 13852.71, "timestamp": "03:50:52", "text": "我陪着一个病人在医院，他之前……"}, {"type": "subtitle", "time": 13854.87, "timestamp": "03:50:54", "text": "和我在一起。当时有人在那里。"}, {"type": "subtitle", "time": 13858.95, "timestamp": "03:50:58", "text": "我。我想它当时在我这儿。我觉得是这样。"}]
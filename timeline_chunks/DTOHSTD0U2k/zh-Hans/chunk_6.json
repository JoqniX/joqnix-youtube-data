[{"type": "subtitle", "time": 363.67, "timestamp": "00:06:03", "text": "他们都知道你有多重要。"}, {"type": "subtitle", "time": 369.029, "timestamp": "00:06:09", "text": "是。嗯。世界是残酷的。"}, {"type": "subtitle", "time": 371.99, "timestamp": "00:06:11", "text": "你是一个活生生的人，但是"}, {"type": "subtitle", "time": 375.27, "timestamp": "00:06:15", "text": "在很多人眼里，你只不过是一枚棋子。"}, {"type": "subtitle", "time": 378.55, "timestamp": "00:06:18", "text": "这就是我来这里的原因，因为我看到了你。"}, {"type": "subtitle", "time": 381.83, "timestamp": "00:06:21", "text": "作为一位挚友，我想告诉你"}, {"type": "subtitle", "time": 383.99, "timestamp": "00:06:23", "text": "真相。"}, {"type": "subtitle", "time": 387.029, "timestamp": "00:06:27", "text": "对于你所经历的一切，我深感抱歉。"}, {"type": "subtitle", "time": 389.59, "timestamp": "00:06:29", "text": "即将面对，"}, {"type": "subtitle", "time": 402.79, "timestamp": "00:06:42", "text": "你呢？"}, {"type": "subtitle", "time": 406.23, "timestamp": "00:06:46", "text": "我知道你不是我能左右的人。"}, {"type": "subtitle", "time": 411.99, "timestamp": "00:06:51", "text": "简单的词语。我的目标很简单。我"}, {"type": "subtitle", "time": 413.99, "timestamp": "00:06:53", "text": "只是想加深我们之间的相互了解"}, {"type": "subtitle", "time": 417.83, "timestamp": "00:06:57", "text": "仅此而已。快点，"}]
[{"type": "subtitle", "time": 2460.23, "timestamp": "00:41:00", "text": "很多人都说我们很友善"}, {"type": "subtitle", "time": 2462.63, "timestamp": "00:41:02", "text": "可怕的。我的亲戚很可怕。是的，会"}, {"type": "subtitle", "time": 2465.109, "timestamp": "00:41:05", "text": "你？如果你是……你会怎么做？"}, {"type": "subtitle", "time": 2468.71, "timestamp": "00:41:08", "text": "小哦我的天哪。"}, {"type": "subtitle", "time": 2474.71, "timestamp": "00:41:14", "text": "离开了地穴，下次再见。我"}, {"type": "subtitle", "time": 2477.51, "timestamp": "00:41:17", "text": "父亲，我以为我可以，但没有人像我这样。"}, {"type": "subtitle", "time": 2484.23, "timestamp": "00:41:24", "text": "[音乐]"}, {"type": "subtitle", "time": 2486.39, "timestamp": "00:41:26", "text": "这是我人生中的第一次，因为我听起来"}, {"type": "subtitle", "time": 2503.67, "timestamp": "00:41:43", "text": "我要揍他。哦，等等"}, {"type": "subtitle", "time": 2507.109, "timestamp": "00:41:47", "text": "父亲、叔叔或其他什么人"}, {"type": "subtitle", "time": 2510.79, "timestamp": "00:41:50", "text": "然后"}, {"type": "subtitle", "time": 2517.51, "timestamp": "00:41:57", "text": "变成"}]
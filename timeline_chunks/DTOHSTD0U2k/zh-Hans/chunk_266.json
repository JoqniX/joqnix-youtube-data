[{"type": "subtitle", "time": 15963.58, "timestamp": "04:26:03", "text": "我喜欢这个。"}, {"type": "subtitle", "time": 15971.349, "timestamp": "04:26:11", "text": "我们是。"}, {"type": "subtitle", "time": 15975.03, "timestamp": "04:26:15", "text": "等等，你这婊子够了。你在哪里？"}, {"type": "subtitle", "time": 15977.349, "timestamp": "04:26:17", "text": "我不明白。你厌倦了"}, {"type": "subtitle", "time": 15980.71, "timestamp": "04:26:20", "text": "贱人。你甚至都没让我上场。"}, {"type": "subtitle", "time": 15983.03, "timestamp": "04:26:23", "text": "等等，你是杀人犯吗？哦，不。你"}, {"type": "subtitle", "time": 15986.55, "timestamp": "04:26:26", "text": "我们是渡渡鸟。我曾是一只渡渡鸟。我曾是"}, {"type": "subtitle", "time": 15989.03, "timestamp": "04:26:29", "text": "杀手。他吃了一个人。好工作。好的"}, {"type": "subtitle", "time": 15990.469, "timestamp": "04:26:30", "text": "工作。你就是这样对我的，对吧？"}, {"type": "subtitle", "time": 15997.75, "timestamp": "04:26:37", "text": "哦，那里有只鹅。那是一只鸭子。它是"}]
[{"type": "subtitle", "time": 12601.51, "timestamp": "03:30:01", "text": "哦，不。我撒谎了。还有，就像你的"}, {"type": "subtitle", "time": 12603.349, "timestamp": "03:30:03", "text": "头巾，"}, {"type": "subtitle", "time": 12608.15, "timestamp": "03:30:08", "text": "笨蛋。我撒谎了。我的意思是，关于"}, {"type": "subtitle", "time": 12610.309, "timestamp": "03:30:10", "text": "吃掉你。是的，我听起来好像忘了似的。"}, {"type": "subtitle", "time": 12613.99, "timestamp": "03:30:13", "text": "关于真相。是啊，我忘了这事儿了。"}, {"type": "subtitle", "time": 12616.15, "timestamp": "03:30:16", "text": "你知道吗？你说了句该死的话"}, {"type": "subtitle", "time": 12617.59, "timestamp": "03:30:17", "text": "第一个被杀死的。我要实话实说"}, {"type": "subtitle", "time": 12619.429, "timestamp": "03:30:19", "text": "你。"}, {"type": "subtitle", "time": 12627.349, "timestamp": "03:30:27", "text": "哟，Roku来了。我们走吧。好的，"}, {"type": "subtitle", "time": 12629.03, "timestamp": "03:30:29", "text": "我们走吧。好的，给他一些时间。"}, {"type": "subtitle", "time": 12640.63, "timestamp": "03:30:40", "text": "XR。"}, {"type": "subtitle", "time": 12652.15, "timestamp": "03:30:52", "text": "你有一场匹配赛"}, {"type": "subtitle", "time": 12654.15, "timestamp": "03:30:54", "text": "等待"}, {"type": "subtitle", "time": 12659.99, "timestamp": "03:30:59", "text": "你在鼓掌。我觉得你"}]
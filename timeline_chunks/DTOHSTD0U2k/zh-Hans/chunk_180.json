[{"type": "subtitle", "time": 10802.55, "timestamp": "03:00:02", "text": "去。哦，"}, {"type": "subtitle", "time": 10809.349, "timestamp": "03:00:09", "text": "别去。我们走吧。我们走吧。我们走吧。"}, {"type": "subtitle", "time": 10818.23, "timestamp": "03:00:18", "text": "我这是怎么了？把它放回正轨。"}, {"type": "subtitle", "time": 10821.349, "timestamp": "03:00:21", "text": "哦，你也可以作为观众。以……身份进入"}, {"type": "subtitle", "time": 10824.309, "timestamp": "03:00:24", "text": "也是旁观者。确实如此。"}, {"type": "subtitle", "time": 10833.19, "timestamp": "03:00:33", "text": "等等，你为什么面向另一边？"}, {"type": "subtitle", "time": 10836.79, "timestamp": "03:00:36", "text": "她想与众不同。目标"}, {"type": "subtitle", "time": 10839.03, "timestamp": "03:00:39", "text": "想要与众不同。我点击了。"}, {"type": "subtitle", "time": 10842.87, "timestamp": "03:00:42", "text": "设置让我移开了视线。"}, {"type": "subtitle", "time": 10847.19, "timestamp": "03:00:47", "text": "瞄准她。快点。总之，我们是谁？"}, {"type": "subtitle", "time": 10849.59, "timestamp": "03:00:49", "text": "还在等什么？"}, {"type": "subtitle", "time": 10851.91, "timestamp": "03:00:51", "text": "我不知道。我们大概有11个人"}, {"type": "subtitle", "time": 10856.15, "timestamp": "03:00:56", "text": "风险投资，但这里有九个。"}, {"type": "subtitle", "time": 10858.309, "timestamp": "03:00:58", "text": "好的。所以，我们还差两个。是的。"}]
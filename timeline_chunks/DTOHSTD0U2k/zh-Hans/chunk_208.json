[{"type": "subtitle", "time": 12480.55, "timestamp": "03:28:00", "text": "哇。太疯狂了。那只是聊天而已。那"}, {"type": "subtitle", "time": 12482.309, "timestamp": "03:28:02", "text": "曾是"}, {"type": "subtitle", "time": 12486.63, "timestamp": "03:28:06", "text": "惊人的。充分利用公共时间"}, {"type": "subtitle", "time": 12494.469, "timestamp": "03:28:14", "text": "我的天啊。所以，我们当时就喵喵叫着。"}, {"type": "subtitle", "time": 12498.389, "timestamp": "03:28:18", "text": "然后，所有可疑的事情都发生了。"}, {"type": "subtitle", "time": 12501.269, "timestamp": "03:28:21", "text": "我知道是谁。我能意识到这一点"}, {"type": "subtitle", "time": 12506.15, "timestamp": "03:28:26", "text": "月亮随时都可能出现。我的天啊。什么？"}, {"type": "subtitle", "time": 12538.229, "timestamp": "03:28:58", "text": "差不多就是这样。我简直不敢相信"}]
[{"type": "subtitle", "time": 19141.51, "timestamp": "05:19:01", "text": "我是士兵。我是士兵。这意味着你"}, {"type": "subtitle", "time": 19144.15, "timestamp": "05:19:04", "text": "会致命。不，不，你，我，是的，我没有"}, {"type": "subtitle", "time": 19157.11, "timestamp": "05:19:17", "text": "你们怀疑谁吗？我可以去"}, {"type": "subtitle", "time": 19165.11, "timestamp": "05:19:25", "text": "真正的？"}, {"type": "subtitle", "time": 19166.39, "timestamp": "05:19:26", "text": "不太清楚。好的。好的。等待，"}, {"type": "subtitle", "time": 19167.83, "timestamp": "05:19:27", "text": "等待。所以，我应该直接去杀人吗？"}, {"type": "subtitle", "time": 19171.03, "timestamp": "05:19:31", "text": "升？好的，没问题。我们跟着。好的，我们开始吧"}, {"type": "subtitle", "time": 19173.27, "timestamp": "05:19:33", "text": "去。我们走吧。我们会跟着你。"}, {"type": "subtitle", "time": 19177.35, "timestamp": "05:19:37", "text": "我们走吧。是的。是的。"}, {"type": "subtitle", "time": 19185.11, "timestamp": "05:19:45", "text": "啊，你的“你好”呢？这是EK。我"}, {"type": "subtitle", "time": 19192.47, "timestamp": "05:19:52", "text": "爱EK。什么？ EK是什么？啊。嗯？"}, {"type": "subtitle", "time": 19196.708, "timestamp": "05:19:56", "text": "什么？我是士兵。然后是 Kiri，还有……"}, {"type": "subtitle", "time": 19199.75, "timestamp": "05:19:59", "text": "他让我杀了雷内。所以我杀了蕾娜"}]
[{"type": "subtitle", "time": 6849.91, "timestamp": "01:54:09", "text": "拥抱变化。"}, {"type": "subtitle", "time": 6855.589, "timestamp": "01:54:15", "text": "上升趋势。"}, {"type": "subtitle", "time": 6864.79, "timestamp": "01:54:24", "text": "迅速而果断。"}, {"type": "subtitle", "time": 6868.31, "timestamp": "01:54:28", "text": "让我灌注一下。"}, {"type": "subtitle", "time": 6875.589, "timestamp": "01:54:35", "text": "我需要你的治愈。首次给药"}, {"type": "subtitle", "time": 6879.83, "timestamp": "01:54:39", "text": "援助。拥抱链。焕发活力的雪。"}, {"type": "subtitle", "time": 6882.07, "timestamp": "01:54:42", "text": "迅速而果断。"}]
[{"type": "subtitle", "time": 19636.708, "timestamp": "05:27:16", "text": "哦，你好，乔。"}, {"type": "subtitle", "time": 19638.868, "timestamp": "05:27:18", "text": "你好。"}, {"type": "subtitle", "time": 19643.11, "timestamp": "05:27:23", "text": "我当时……呃……我当时是FK。你好。是的。你好。哟"}, {"type": "subtitle", "time": 19645.67, "timestamp": "05:27:25", "text": "你过来。我们组成一个小组。我们"}, {"type": "subtitle", "time": 19649.91, "timestamp": "05:27:29", "text": "编造不在场证明。我害怕我们有"}, {"type": "subtitle", "time": 19651.91, "timestamp": "05:27:31", "text": "是鸽子，对吧？这样更好，对吧？"}, {"type": "subtitle", "time": 19653.19, "timestamp": "05:27:33", "text": "想象。好的。好的。好的。好的。思考"}, {"type": "subtitle", "time": 19654.708, "timestamp": "05:27:34", "text": "就是这样。我不想死。什么"}, {"type": "subtitle", "time": 19656.708, "timestamp": "05:27:36", "text": "如果你们其中一人没事的话。好的。好的。如果"}, {"type": "subtitle", "time": 19658.39, "timestamp": "05:27:38", "text": "乔克杀了我，然后你就得去报道了。"}, {"type": "subtitle", "time": 19660.07, "timestamp": "05:27:40", "text": "它。如果我杀了乔克，你就会明白了。"}, {"type": "subtitle", "time": 19662.788, "timestamp": "05:27:42", "text": "如果我杀了你，你就能看到了，对吧？"}, {"type": "subtitle", "time": 19666.23, "timestamp": "05:27:46", "text": "所以，这很有道理。"}, {"type": "subtitle", "time": 19668.23, "timestamp": "05:27:48", "text": "那是什么？很搞笑。我不知道。"}, {"type": "subtitle", "time": 19672.23, "timestamp": "05:27:52", "text": "我动不了。嗯？搞什么鬼？我是"}, {"type": "subtitle", "time": 19674.788, "timestamp": "05:27:54", "text": "卡住。什么？帮我。哦，别担心。"}, {"type": "subtitle", "time": 19676.39, "timestamp": "05:27:56", "text": "您就在附近。兄弟姐妹们，我是"}, {"type": "subtitle", "time": 19677.91, "timestamp": "05:27:57", "text": "卡住。"}]
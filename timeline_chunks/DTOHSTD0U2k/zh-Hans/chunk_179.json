[{"type": "subtitle", "time": 10740.15, "timestamp": "02:59:00", "text": "我的世界。"}, {"type": "subtitle", "time": 10741.83, "timestamp": "02:59:01", "text": "嗯，"}, {"type": "subtitle", "time": 10751.269, "timestamp": "02:59:11", "text": "我今天一整天都在跟着你。"}, {"type": "subtitle", "time": 10752.87, "timestamp": "02:59:12", "text": "哟，"}, {"type": "subtitle", "time": 10756.87, "timestamp": "02:59:16", "text": "这是什么？哦，这就像我看到的"}, {"type": "subtitle", "time": 10759.429, "timestamp": "02:59:19", "text": "定制者。"}, {"type": "subtitle", "time": 10765.51, "timestamp": "02:59:25", "text": "好的。所以，你是主人。删除"}, {"type": "subtitle", "time": 10781.11, "timestamp": "02:59:41", "text": "哦，你们排得真不错。"}, {"type": "subtitle", "time": 10789.03, "timestamp": "02:59:49", "text": "不错，伙计们。"}, {"type": "subtitle", "time": 10793.03, "timestamp": "02:59:53", "text": "哟，那句台词简直太棒了，我的天哪"}, {"type": "subtitle", "time": 10795.89, "timestamp": "02:59:55", "text": "上帝。完美的。"}, {"type": "subtitle", "time": 10797.67, "timestamp": "02:59:57", "text": "[音乐]"}, {"type": "subtitle", "time": 10799.51, "timestamp": "02:59:59", "text": "哦，加入我们吧。加入我们。加入我们。那里我们"}]
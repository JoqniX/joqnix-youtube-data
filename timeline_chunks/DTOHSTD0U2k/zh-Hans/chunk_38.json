[{"type": "subtitle", "time": 2281.91, "timestamp": "00:38:01", "text": "山上丢了一顶帽子。你可以拼凑"}, {"type": "subtitle", "time": 2284.069, "timestamp": "00:38:04", "text": "他们聚在一起，却没有任何支持。只是"}, {"type": "subtitle", "time": 2286.55, "timestamp": "00:38:06", "text": "跑步。"}, {"type": "subtitle", "time": 2289.27, "timestamp": "00:38:09", "text": "史上最佳游戏。"}, {"type": "subtitle", "time": 2292.15, "timestamp": "00:38:12", "text": "毫无疑问。史上最佳游戏。"}, {"type": "subtitle", "time": 2322.23, "timestamp": "00:38:42", "text": "[音乐]"}, {"type": "subtitle", "time": 2325.19, "timestamp": "00:38:45", "text": "它就像一只小蜘蛛。这家伙"}, {"type": "subtitle", "time": 2328.31, "timestamp": "00:38:48", "text": "那里有个攀爬的东西，不像原神"}, {"type": "subtitle", "time": 2330.069, "timestamp": "00:38:50", "text": "正在攀升。这就像一个小"}, {"type": "subtitle", "time": 2332.47, "timestamp": "00:38:52", "text": "蜘蛛"}]
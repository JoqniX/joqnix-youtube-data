[{"type": "subtitle", "time": 14700.95, "timestamp": "04:05:00", "text": "尽可能吧，兄弟。我很抱歉。我认为"}, {"type": "subtitle", "time": 14707.91, "timestamp": "04:05:07", "text": "我爱你们。我爱你们所有人。我"}, {"type": "subtitle", "time": 14709.83, "timestamp": "04:05:09", "text": "爱你们所有人。"}, {"type": "subtitle", "time": 14712.95, "timestamp": "04:05:12", "text": "我的天啊。问题是，我知道该怎么做"}, {"type": "subtitle", "time": 14715.67, "timestamp": "04:05:15", "text": "在本 ro 中执行。"}, {"type": "subtitle", "time": 14718.229, "timestamp": "04:05:18", "text": "等等，那猎鹰号呢？我当时是什么？"}, {"type": "subtitle", "time": 14719.99, "timestamp": "04:05:19", "text": "能够杀人吗？我们可以就这么"}, {"type": "subtitle", "time": 14723.269, "timestamp": "04:05:23", "text": "请调低音量。是的。是的。那是"}, {"type": "subtitle", "time": 14727.269, "timestamp": "04:05:27", "text": "对我来说，这也是一份个人工作。"}, {"type": "subtitle", "time": 14731.59, "timestamp": "04:05:31", "text": "没关系。大家出去吧。我"}, {"type": "subtitle", "time": 14734.15, "timestamp": "04:05:34", "text": "我以为没人听到我的尖叫声。哟，韩"}, {"type": "subtitle", "time": 14736.309, "timestamp": "04:05:36", "text": "韩。"}, {"type": "subtitle", "time": 14737.91, "timestamp": "04:05:37", "text": "好的。"}, {"type": "subtitle", "time": 14740.55, "timestamp": "04:05:40", "text": "我喜欢没人他妈的听我的。"}, {"type": "subtitle", "time": 14742.389, "timestamp": "04:05:42", "text": "我说：“嘿，韩韩，过来一下。嘿，"}, {"type": "subtitle", "time": 14744.389, "timestamp": "04:05:44", "text": "韩。”然后我就彻底崩溃了"}, {"type": "subtitle", "time": 14746.469, "timestamp": "04:05:46", "text": "沉默的。"}, {"type": "subtitle", "time": 14748.95, "timestamp": "04:05:48", "text": "美好的。"}, {"type": "subtitle", "time": 14750.63, "timestamp": "04:05:50", "text": "你知道，你知道为什么没人听见你说话吗？"}, {"type": "subtitle", "time": 14752.469, "timestamp": "04:05:52", "text": "因为因为他们俩都是"}, {"type": "subtitle", "time": 14756.07, "timestamp": "04:05:56", "text": "杀手。这完全是私人游戏。"}, {"type": "subtitle", "time": 14757.59, "timestamp": "04:05:57", "text": "没错，你没听错。你根本没听见"}]
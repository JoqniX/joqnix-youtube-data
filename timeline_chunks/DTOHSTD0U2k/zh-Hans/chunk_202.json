[{"type": "subtitle", "time": 12121.269, "timestamp": "03:22:01", "text": "在。"}, {"type": "subtitle", "time": 12123.91, "timestamp": "03:22:03", "text": "哦，不。我的天啊。难道只有我一个人这样吗？"}, {"type": "subtitle", "time": 12126.15, "timestamp": "03:22:06", "text": "名字叫金吗？"}, {"type": "subtitle", "time": 12128.79, "timestamp": "03:22:08", "text": "如果这甚至都不是我想的那样"}, {"type": "subtitle", "time": 12131.03, "timestamp": "03:22:11", "text": "记住这一点。"}, {"type": "subtitle", "time": 12146.79, "timestamp": "03:22:26", "text": "嘿，你想确认一下角色吗？我是一名"}, {"type": "subtitle", "time": 12149.269, "timestamp": "03:22:29", "text": "我是一名侦探。所以"}, {"type": "subtitle", "time": 12152.55, "timestamp": "03:22:32", "text": "什么？哦，侦探是做什么的？侦探。"}, {"type": "subtitle", "time": 12173.59, "timestamp": "03:22:53", "text": "与我一起。我当时很害怕。"}, {"type": "subtitle", "time": 12176.95, "timestamp": "03:22:56", "text": "讽刺的是，我当时正在说……"}, {"type": "subtitle", "time": 12179.83, "timestamp": "03:22:59", "text": "怎么会有人做出这种事"}]
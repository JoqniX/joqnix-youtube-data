[{"type": "subtitle", "time": 15421.189, "timestamp": "04:17:01", "text": "总是"}, {"type": "subtitle", "time": 15423.83, "timestamp": "04:17:03", "text": "当他们找到的时候"}, {"type": "subtitle", "time": 15433.429, "timestamp": "04:17:13", "text": "只是随便地和情人谈恋爱而已。"}, {"type": "subtitle", "time": 15435.83, "timestamp": "04:17:15", "text": "死了，然后他说，是，是，呃……"}, {"type": "subtitle", "time": 15437.83, "timestamp": "04:17:17", "text": "他人。"}, {"type": "subtitle", "time": 15439.67, "timestamp": "04:17:19", "text": "我一直在等大家集合。"}, {"type": "subtitle", "time": 15441.99, "timestamp": "04:17:21", "text": "感谢大家的积极参与。"}, {"type": "subtitle", "time": 15443.91, "timestamp": "04:17:23", "text": "那个区域。"}, {"type": "subtitle", "time": 15446.79, "timestamp": "04:17:26", "text": "该死。这也是你的主意。什么"}, {"type": "subtitle", "time": 15448.87, "timestamp": "04:17:28", "text": "好的，我们需要，我们需要得到"}, {"type": "subtitle", "time": 15451.429, "timestamp": "04:17:31", "text": "你的第一个作品太棒了。你是什​​么意思"}, {"type": "subtitle", "time": 15454.149, "timestamp": "04:17:34", "text": "我太优秀了吗？大概吧。不，首胜。"}, {"type": "subtitle", "time": 15455.99, "timestamp": "04:17:35", "text": "首胜。你在跟我说什么？"}, {"type": "subtitle", "time": 15458.95, "timestamp": "04:17:38", "text": "首胜。哦，没有。你要么是"}, {"type": "subtitle", "time": 15461.59, "timestamp": "04:17:41", "text": "操纵他人或者你做的任何事，"}, {"type": "subtitle", "time": 15465.189, "timestamp": "04:17:45", "text": "你赢了。所以，不。不，不，不。"}, {"type": "subtitle", "time": 15467.349, "timestamp": "04:17:47", "text": "你太优秀了。好的。让我们……"}, {"type": "subtitle", "time": 15469.429, "timestamp": "04:17:49", "text": "实际上，请移除鸽子卷，因为"}, {"type": "subtitle", "time": 15472.79, "timestamp": "04:17:52", "text": "赢太容易了。正确的。正确的。不，我"}, {"type": "subtitle", "time": 15474.87, "timestamp": "04:17:54", "text": "没明白。不。什么？你们"}, {"type": "subtitle", "time": 15479.51, "timestamp": "04:17:59", "text": "别再让你们这些杀人犯继续杀人了。"}]
[{"type": "subtitle", "time": 3743.91, "timestamp": "01:02:23", "text": "如果你知道这个声音，我会杀了你。"}, {"type": "subtitle", "time": 3746.549, "timestamp": "01:02:26", "text": "焕发活力的雪。"}, {"type": "subtitle", "time": 3760.069, "timestamp": "01:02:40", "text": "引导我的刀刃。如何"}, {"type": "subtitle", "time": 3763.589, "timestamp": "01:02:43", "text": "光正在入侵。"}, {"type": "subtitle", "time": 3767.75, "timestamp": "01:02:47", "text": "我搞砸了。其中一种声音。"}, {"type": "subtitle", "time": 3770.789, "timestamp": "01:02:50", "text": "共鸣时刻。"}]
[{"type": "subtitle", "time": 14581.99, "timestamp": "04:03:01", "text": "求求你们，千万别举报"}, {"type": "subtitle", "time": 14586.79, "timestamp": "04:03:06", "text": "我。特里，你有什么要说的吗？"}, {"type": "subtitle", "time": 14591.83, "timestamp": "04:03:11", "text": "呃，我当时正在执行我的其中一项任务……"}, {"type": "subtitle", "time": 14593.91, "timestamp": "04:03:13", "text": "场景。是的，我还有任务。很好"}, {"type": "subtitle", "time": 14597.99, "timestamp": "04:03:17", "text": "知道。好的。"}, {"type": "subtitle", "time": 14600.389, "timestamp": "04:03:20", "text": "幸好我们在一起。"}, {"type": "subtitle", "time": 14602.63, "timestamp": "04:03:22", "text": "是的，这是好事。哇。惊人的。真是"}, {"type": "subtitle", "time": 14613.91, "timestamp": "04:03:33", "text": "我们走吧。如果"}, {"type": "subtitle", "time": 14616.55, "timestamp": "04:03:36", "text": "是你们其中一个人。兄弟，我……我"}, {"type": "subtitle", "time": 14621.99, "timestamp": "04:03:41", "text": "幸存者。我希望不是。我希望不是。"}, {"type": "subtitle", "time": 14625.11, "timestamp": "04:03:45", "text": "我们赢了吗？我们赢了。我们赢了，因为"}, {"type": "subtitle", "time": 14627.94, "timestamp": "04:03:47", "text": "我还活着。"}, {"type": "subtitle", "time": 14638.15, "timestamp": "04:03:58", "text": "你骗了我。我就知道。就像她拿走"}]
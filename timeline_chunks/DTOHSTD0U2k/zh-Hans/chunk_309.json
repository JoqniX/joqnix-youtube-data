[{"type": "subtitle", "time": 18546.628, "timestamp": "05:09:06", "text": "只有我一个人这样吗？"}, {"type": "subtitle", "time": 18556.47, "timestamp": "05:09:16", "text": "谁在这里？"}, {"type": "subtitle", "time": 18558.948, "timestamp": "05:09:18", "text": "不是我。我还没到。是的，你是"}, {"type": "subtitle", "time": 18563.03, "timestamp": "05:09:23", "text": "丢失的。韩韩，你不见了。"}, {"type": "subtitle", "time": 18565.03, "timestamp": "05:09:25", "text": "韩，你应该看看他当时的表情。"}, {"type": "subtitle", "time": 18567.75, "timestamp": "05:09:27", "text": "他们的脸。哦，我回来了。"}, {"type": "subtitle", "time": 18570.708, "timestamp": "05:09:30", "text": "发生了什么？太多事情了，所以"}, {"type": "subtitle", "time": 18580.23, "timestamp": "05:09:40", "text": "是的，他们现在正在喝饮料。"}, {"type": "subtitle", "time": 18582.868, "timestamp": "05:09:42", "text": "所以，哦，他们正在喝水。"}, {"type": "subtitle", "time": 18586.31, "timestamp": "05:09:46", "text": "现在。是的。该死。哪个喜欢"}, {"type": "subtitle", "time": 18589.51, "timestamp": "05:09:49", "text": "威士忌酒？哦，Yoshi，你为什么总是"}, {"type": "subtitle", "time": 18591.43, "timestamp": "05:09:51", "text": "这么害怕吗？"}, {"type": "subtitle", "time": 18593.19, "timestamp": "05:09:53", "text": "我不知道。我猜我猜"}, {"type": "subtitle", "time": 18594.868, "timestamp": "05:09:54", "text": "我杀了她之后，她就有了信任问题。"}, {"type": "subtitle", "time": 18598.31, "timestamp": "05:09:58", "text": "不。是的。你总是压力很大。"}]
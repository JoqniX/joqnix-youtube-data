[{"type": "subtitle", "time": 16201.349, "timestamp": "04:30:01", "text": "移动。我的控制措施已被采取"}, {"type": "subtitle", "time": 16202.95, "timestamp": "04:30:02", "text": "超过。"}, {"type": "subtitle", "time": 16209.269, "timestamp": "04:30:09", "text": "是的。所以，当鹈鹕吃了你的时候，"}, {"type": "subtitle", "time": 16211.67, "timestamp": "04:30:11", "text": "除了鹈鹕，没有人能听到你说话。"}, {"type": "subtitle", "time": 16214.149, "timestamp": "04:30:14", "text": "这就是你们跟我说话的原因。"}, {"type": "subtitle", "time": 16216.389, "timestamp": "04:30:16", "text": "我当时正试图回复"}, {"type": "subtitle", "time": 16223.429, "timestamp": "04:30:23", "text": "事情就是这样。我当时就想，“所有"}, {"type": "subtitle", "time": 16233.03, "timestamp": "04:30:33", "text": "你知道，就像"}, {"type": "subtitle", "time": 16234.55, "timestamp": "04:30:34", "text": "你知道当时大概有五个人。"}, {"type": "subtitle", "time": 16246.63, "timestamp": "04:30:46", "text": "我觉得，我觉得一开始我就已经"}, {"type": "subtitle", "time": 16249.51, "timestamp": "04:30:49", "text": "杀死了一个人。"}, {"type": "subtitle", "time": 16259.67, "timestamp": "04:30:59", "text": "你知道，你只是想努力做到"}]
[{"type": "subtitle", "time": 19561.03, "timestamp": "05:26:01", "text": "旁观者雷内和"}, {"type": "subtitle", "time": 19563.67, "timestamp": "05:26:03", "text": "呃"}, {"type": "subtitle", "time": 19566.948, "timestamp": "05:26:06", "text": "你做了什么坏事？"}, {"type": "subtitle", "time": 19570.07, "timestamp": "05:26:10", "text": "我当时想的是"}, {"type": "subtitle", "time": 19572.27, "timestamp": "05:26:12", "text": "第一个"}, {"type": "subtitle", "time": 19574.55, "timestamp": "05:26:14", "text": "[音乐]"}, {"type": "subtitle", "time": 19578.948, "timestamp": "05:26:18", "text": "我们只想操你。"}, {"type": "subtitle", "time": 19580.948, "timestamp": "05:26:20", "text": "你真是个怪人"}, {"type": "subtitle", "time": 19583.91, "timestamp": "05:26:23", "text": "是的。哦，我有点怪异。什么可以"}, {"type": "subtitle", "time": 19586.47, "timestamp": "05:26:26", "text": "我说？"}, {"type": "subtitle", "time": 19588.708, "timestamp": "05:26:28", "text": "[音乐]"}, {"type": "subtitle", "time": 19590.92, "timestamp": "05:26:30", "text": "我现在正摇头。"}, {"type": "subtitle", "time": 19592.15, "timestamp": "05:26:32", "text": "[音乐]"}, {"type": "subtitle", "time": 19597.59, "timestamp": "05:26:37", "text": "哦不，我们遇到了两个杀人狂。"}, {"type": "subtitle", "time": 19600.628, "timestamp": "05:26:40", "text": "已经。呃，我们有，是的，我们有伙计们。"}, {"type": "subtitle", "time": 19602.948, "timestamp": "05:26:42", "text": "我厌倦了总是第一个死。请瞄准"}, {"type": "subtitle", "time": 19605.75, "timestamp": "05:26:45", "text": "其他人。我是无辜的，我是"}, {"type": "subtitle", "time": 19607.43, "timestamp": "05:26:47", "text": "垂死。"}, {"type": "subtitle", "time": 19612.23, "timestamp": "05:26:52", "text": "好的，三种致命的东西。不，我不是。"}, {"type": "subtitle", "time": 19614.948, "timestamp": "05:26:54", "text": "死的。我要死了。好的，我们来玩吧。"}]
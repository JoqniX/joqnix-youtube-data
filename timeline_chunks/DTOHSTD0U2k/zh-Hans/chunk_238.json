[{"type": "subtitle", "time": 14290.229, "timestamp": "03:58:10", "text": "我看到一群人。你好。"}, {"type": "subtitle", "time": 14292.95, "timestamp": "03:58:12", "text": "房子就在附近。你好。你好。他是"}, {"type": "subtitle", "time": 14295.189, "timestamp": "03:58:15", "text": "站在那里。他一动不动。他是"}, {"type": "subtitle", "time": 14306.07, "timestamp": "03:58:26", "text": "[音乐]"}, {"type": "subtitle", "time": 14321.34, "timestamp": "03:58:41", "text": "你好。大家好。"}, {"type": "subtitle", "time": 14324.309, "timestamp": "03:58:44", "text": "[音乐]"}, {"type": "subtitle", "time": 14333.349, "timestamp": "03:58:53", "text": "任务在哪里？这边走。这边走。"}, {"type": "subtitle", "time": 14336.07, "timestamp": "03:58:56", "text": "如何做番茄那件事。是的。是的。"}]
[{"type": "subtitle", "time": 1560.71, "timestamp": "00:26:00", "text": "遵照牧羊人的指示做了"}, {"type": "subtitle", "time": 1564.71, "timestamp": "00:26:04", "text": "一遍又一遍地许愿。他们本可以"}, {"type": "subtitle", "time": 1569.43, "timestamp": "00:26:09", "text": "羊肉。我的天啊。嘘。黑羊说话"}, {"type": "subtitle", "time": 1573.83, "timestamp": "00:26:13", "text": "突然出现，打破了羊群的伪装。他们的"}, {"type": "subtitle", "time": 1578.95, "timestamp": "00:26:18", "text": "营造一种平静幸福生活的假象。"}, {"type": "subtitle", "time": 1588.47, "timestamp": "00:26:28", "text": "以及牧羊人的伟大"}, {"type": "subtitle", "time": 1598.149, "timestamp": "00:26:38", "text": "突然间，他们可以忽略血迹了。"}, {"type": "subtitle", "time": 1602.23, "timestamp": "00:26:42", "text": "过去祭祀的骨灰散落各处。现在"}, {"type": "subtitle", "time": 1610.549, "timestamp": "00:26:50", "text": "那是你邪恶的化身。"}, {"type": "subtitle", "time": 1614.47, "timestamp": "00:26:54", "text": "罗孚，你觉得我的故事怎么样？"}, {"type": "subtitle", "time": 1617.83, "timestamp": "00:26:57", "text": "但是我的模组一直在吃东西。假设你"}]
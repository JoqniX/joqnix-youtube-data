[{"type": "subtitle", "time": 2221.67, "timestamp": "00:37:01", "text": "谁在躲藏？这是谁？"}, {"type": "subtitle", "time": 2227.27, "timestamp": "00:37:07", "text": "他们安然无恙。请放心。"}, {"type": "subtitle", "time": 2229.43, "timestamp": "00:37:09", "text": "正如你所预料的那样，斯卡并没有试图"}, {"type": "subtitle", "time": 2232.15, "timestamp": "00:37:12", "text": "杀了他们。是的，我置身事外了。"}, {"type": "subtitle", "time": 2235.13, "timestamp": "00:37:15", "text": "你问了。"}, {"type": "subtitle", "time": 2236.31, "timestamp": "00:37:16", "text": "[音乐]"}, {"type": "subtitle", "time": 2239.67, "timestamp": "00:37:19", "text": "你那边一切都正常吗？"}, {"type": "subtitle", "time": 2241.829, "timestamp": "00:37:21", "text": "夫人，请务必注意安全。"}, {"type": "subtitle", "time": 2244.04, "timestamp": "00:37:24", "text": "哦，这位女士。哦，"}, {"type": "subtitle", "time": 2246.71, "timestamp": "00:37:26", "text": "[音乐]"}, {"type": "subtitle", "time": 2249.43, "timestamp": "00:37:29", "text": "罗孚，你还留着我们用的那块牌匾吗？"}, {"type": "subtitle", "time": 2252.39, "timestamp": "00:37:32", "text": "之前发现的？断成两半的那一个？"}, {"type": "subtitle", "time": 2256.87, "timestamp": "00:37:36", "text": "果然不出我所料。我也有类似的感觉。"}, {"type": "subtitle", "time": 2260.39, "timestamp": "00:37:40", "text": "来自那个方向的振动。"}, {"type": "subtitle", "time": 2270.23, "timestamp": "00:37:50", "text": "你知道吗，最强的原神杀手是"}, {"type": "subtitle", "time": 2274.31, "timestamp": "00:37:54", "text": "这游戏啊。看看这个"}, {"type": "subtitle", "time": 2279.27, "timestamp": "00:37:59", "text": "男人。唉，到处跑来跑去。这是"}]
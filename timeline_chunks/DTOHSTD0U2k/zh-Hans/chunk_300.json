[{"type": "subtitle", "time": 18001.03, "timestamp": "05:00:01", "text": "那里有一头猪。不。形态是什么？"}, {"type": "subtitle", "time": 18002.788, "timestamp": "05:00:02", "text": "好的，稍等一下。它有什么作用？患病的"}, {"type": "subtitle", "time": 18005.99, "timestamp": "05:00:05", "text": "查一下就行了。你可以"}, {"type": "subtitle", "time": 18008.31, "timestamp": "05:00:08", "text": "切换到另一名玩家。你的想法"}, {"type": "subtitle", "time": 18011.35, "timestamp": "05:00:11", "text": "都是假的。我懂了。"}, {"type": "subtitle", "time": 18013.27, "timestamp": "05:00:13", "text": "等等，各位。氧气使声音变得沉闷。踢她"}, {"type": "subtitle", "time": 18016.31, "timestamp": "05:00:16", "text": "出去。把她赶出去。快点。不，她是"}, {"type": "subtitle", "time": 18018.07, "timestamp": "05:00:18", "text": "阅读描述后，"}, {"type": "subtitle", "time": 18021.59, "timestamp": "05:00:21", "text": "信息类事物。对“是”的描述。"}, {"type": "subtitle", "time": 18039.67, "timestamp": "05:00:39", "text": "为什么我们都感到孤独？哦，你好。你是"}, {"type": "subtitle", "time": 18042.628, "timestamp": "05:00:42", "text": "其实并不孤单。我在这里。"}, {"type": "subtitle", "time": 18045.75, "timestamp": "05:00:45", "text": "你好。我已静音。我正在塑造谁？"}, {"type": "subtitle", "time": 18059.83, "timestamp": "05:00:59", "text": "哦，"}]
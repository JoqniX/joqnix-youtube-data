[{"type": "subtitle", "time": 18420.948, "timestamp": "05:07:00", "text": "远离你的人。我真是太幸运了"}, {"type": "subtitle", "time": 18422.47, "timestamp": "05:07:02", "text": "他逃离了你。是啊，你真是太……"}, {"type": "subtitle", "time": 18424.39, "timestamp": "05:07:04", "text": "幸运的。我想杀了他们。你知道，"}, {"type": "subtitle", "time": 18427.83, "timestamp": "05:07:07", "text": "说实话，我当时真想杀了你。"}, {"type": "subtitle", "time": 18430.55, "timestamp": "05:07:10", "text": "我的按钮。我可以按住点击按钮"}, {"type": "subtitle", "time": 18434.868, "timestamp": "05:07:14", "text": "让他们动起来。我不知道。"}, {"type": "subtitle", "time": 18436.39, "timestamp": "05:07:16", "text": "你看到怪物朝我走来，"}, {"type": "subtitle", "time": 18439.11, "timestamp": "05:07:19", "text": "正确的？是的，我看到了。是的，我可以。是的，我"}, {"type": "subtitle", "time": 18442.788, "timestamp": "05:07:22", "text": "完全动弹不得。那其实是"}, {"type": "subtitle", "time": 18443.99, "timestamp": "05:07:23", "text": "是的。不，有个怪物要来了"}, {"type": "subtitle", "time": 18457.59, "timestamp": "05:07:37", "text": "我的PP。是的，"}]
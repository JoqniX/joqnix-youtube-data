[{"type": "subtitle", "time": 13501.11, "timestamp": "03:45:01", "text": "他说是贾努佐。我亲眼看到他开枪了。"}, {"type": "subtitle", "time": 13507.99, "timestamp": "03:45:07", "text": "我的天啊。那起谋杀案。"}, {"type": "subtitle", "time": 13510.71, "timestamp": "03:45:10", "text": "真是太疯狂了。魔鬼。魔鬼是"}, {"type": "subtitle", "time": 13514.309, "timestamp": "03:45:14", "text": "疯狂的。你看到我杀人了吗？"}, {"type": "subtitle", "time": 13516.07, "timestamp": "03:45:16", "text": "谁？过来。过来。是的，但是"}, {"type": "subtitle", "time": 13518.309, "timestamp": "03:45:18", "text": "我亲眼看到你杀人。我当时就想，“哟，那是谁？”"}, {"type": "subtitle", "time": 13520.229, "timestamp": "03:45:20", "text": "“那？”于是我试着跟着那个人。"}, {"type": "subtitle", "time": 13522.95, "timestamp": "03:45:22", "text": "我很想知道是谁干的，但他杀了我。我"}, {"type": "subtitle", "time": 13525.83, "timestamp": "03:45:25", "text": "谋杀了她。我的天啊。我正要"}, {"type": "subtitle", "time": 13527.59, "timestamp": "03:45:27", "text": "他追上去想看看是谁，结果却被杀了。"}, {"type": "subtitle", "time": 13531.189, "timestamp": "03:45:31", "text": "我。实战优势。你为什么问我"}, {"type": "subtitle", "time": 13533.349, "timestamp": "03:45:33", "text": "在你那边的时候帮帮你"}, {"type": "subtitle", "time": 13535.91, "timestamp": "03:45:35", "text": "因为不，不。因为就像，好吧，"}, {"type": "subtitle", "time": 13538.63, "timestamp": "03:45:38", "text": "这是我的第一条原则。不要相信"}, {"type": "subtitle", "time": 13541.269, "timestamp": "03:45:41", "text": "任何人。伙计们，除了……之外，谁都不要相信。"}, {"type": "subtitle", "time": 13545.91, "timestamp": "03:45:45", "text": "你自己。伙计们，别相信自己。"}, {"type": "subtitle", "time": 13548.309, "timestamp": "03:45:48", "text": "一群疯子。每次。每次我们"}, {"type": "subtitle", "time": 13551.189, "timestamp": "03:45:51", "text": "看到黑色，我们就杀了他。是的，"}, {"type": "subtitle", "time": 13558.79, "timestamp": "03:45:58", "text": "因为"}]
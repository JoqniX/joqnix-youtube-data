[{"type": "subtitle", "time": 10569.269, "timestamp": "02:56:09", "text": "不，你听见了吗？我不是那个意思，就像我"}, {"type": "subtitle", "time": 10572.23, "timestamp": "02:56:12", "text": "就像那样。"}, {"type": "subtitle", "time": 10575.51, "timestamp": "02:56:15", "text": "哦。嗯？"}, {"type": "subtitle", "time": 10579.83, "timestamp": "02:56:19", "text": "我们来碰碰。什么？什么？嗯？触碰。 WHO"}, {"type": "subtitle", "time": 10582.15, "timestamp": "02:56:22", "text": "我们是不是在接触？他们正在做"}, {"type": "subtitle", "time": 10585.429, "timestamp": "02:56:25", "text": "间接。我会去那里。"}, {"type": "subtitle", "time": 10587.83, "timestamp": "02:56:27", "text": "你的耳朵颜色有点深。等等，什么？"}, {"type": "subtitle", "time": 10594.63, "timestamp": "02:56:34", "text": "震惊真是毫无察觉。"}, {"type": "subtitle", "time": 10598.309, "timestamp": "02:56:38", "text": "我全是制表符。对不起。"}, {"type": "subtitle", "time": 10601.91, "timestamp": "02:56:41", "text": "我说把钞票拿过来给我。哦，那是"}, {"type": "subtitle", "time": 10606.71, "timestamp": "02:56:46", "text": "等等，原来是这样。哦，不。"}, {"type": "subtitle", "time": 10608.87, "timestamp": "02:56:48", "text": "好了。谢谢你的感动"}, {"type": "subtitle", "time": 10612.71, "timestamp": "02:56:52", "text": "账单在我这里。我一直在等这一刻。"}, {"type": "subtitle", "time": 10616.23, "timestamp": "02:56:56", "text": "我在这里。哦，你好。你好。"}]
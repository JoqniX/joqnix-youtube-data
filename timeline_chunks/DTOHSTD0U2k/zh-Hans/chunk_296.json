[{"type": "subtitle", "time": 17760.23, "timestamp": "04:56:00", "text": "[音乐]"}, {"type": "subtitle", "time": 17762.15, "timestamp": "04:56:02", "text": "为什么？"}, {"type": "subtitle", "time": 17764.708, "timestamp": "04:56:04", "text": "我们赢了。我猜对了。我说拖鞋"}, {"type": "subtitle", "time": 17770.23, "timestamp": "04:56:10", "text": "无论如何我们都会赢。你是对的。我们"}, {"type": "subtitle", "time": 17772.47, "timestamp": "04:56:12", "text": "无论如何都要赢。我告诉过你我必须"}, {"type": "subtitle", "time": 17775.03, "timestamp": "04:56:15", "text": "兄弟，帮你拿着。住口。这是一场轻松的胜利。我"}, {"type": "subtitle", "time": 17777.67, "timestamp": "04:56:17", "text": "不得不杀了他。轻松获胜。我们只是"}, {"type": "subtitle", "time": 17779.67, "timestamp": "04:56:19", "text": "我们只是给你，我们只是在制作"}, {"type": "subtitle", "time": 17782.15, "timestamp": "04:56:22", "text": "这样对你来说更容易些，苏米。我们是 我们是"}, {"type": "subtitle", "time": 17788.708, "timestamp": "04:56:28", "text": "漫无目的地。我当时就想，“是啊，就是这样。”"}, {"type": "subtitle", "time": 17793.19, "timestamp": "04:56:33", "text": "可能是他。”为什么？你什么意思？"}, {"type": "subtitle", "time": 17795.51, "timestamp": "04:56:35", "text": "Jo，你还要回去找Sumi吗？"}, {"type": "subtitle", "time": 17797.99, "timestamp": "04:56:37", "text": "时间让你变得超级可疑，然后"}, {"type": "subtitle", "time": 17799.67, "timestamp": "04:56:39", "text": "你他妈的从他们身边走过，然后"}, {"type": "subtitle", "time": 17801.59, "timestamp": "04:56:41", "text": "你他妈的跟他们说话，那真是太糟糕了。"}, {"type": "subtitle", "time": 17804.948, "timestamp": "04:56:44", "text": "不，我被静音了。我在看聊天记录。它"}, {"type": "subtitle", "time": 17807.35, "timestamp": "04:56:47", "text": "确实如此。你好像是"}, {"type": "subtitle", "time": 17809.03, "timestamp": "04:56:49", "text": "想找个人杀掉，你知道的"}, {"type": "subtitle", "time": 17810.788, "timestamp": "04:56:50", "text": "但是你"}, {"type": "subtitle", "time": 17812.07, "timestamp": "04:56:52", "text": "没杀了我。真奇怪。但是后来"}, {"type": "subtitle", "time": 17814.31, "timestamp": "04:56:54", "text": "你回到上面，然后又下去了，"}, {"type": "subtitle", "time": 17815.67, "timestamp": "04:56:55", "text": "回来后我们聊了聊。我当时想，“哦，"}, {"type": "subtitle", "time": 17819.43, "timestamp": "04:56:59", "text": "“真奇怪。”哇，真奇怪。我想……"}]
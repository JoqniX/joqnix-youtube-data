[{"type": "subtitle", "time": 19505.83, "timestamp": "05:25:05", "text": "我本应该那样做。"}, {"type": "subtitle", "time": 19507.35, "timestamp": "05:25:07", "text": "兄弟。你知道我身上发生了什么事，"}, {"type": "subtitle", "time": 19510.15, "timestamp": "05:25:10", "text": "伙计们？"}, {"type": "subtitle", "time": 19511.75, "timestamp": "05:25:11", "text": "不错。不错。真搞笑。那"}, {"type": "subtitle", "time": 19515.51, "timestamp": "05:25:15", "text": "很有趣。好的。所以，我当时的感觉就像是……"}, {"type": "subtitle", "time": 19518.868, "timestamp": "05:25:18", "text": "伙计们，我好想知道韩韩的事。我想"}, {"type": "subtitle", "time": 19521.75, "timestamp": "05:25:21", "text": "我一到就知道，我当时就是这样。"}, {"type": "subtitle", "time": 19524.39, "timestamp": "05:25:24", "text": "怀疑韩哈德，我就跟韩哈德一样。"}, {"type": "subtitle", "time": 19525.83, "timestamp": "05:25:25", "text": "给我一个不该这么做的充分理由。"}, {"type": "subtitle", "time": 19527.99, "timestamp": "05:25:27", "text": "不应该会要了你的命。不，他继续跑了下去。"}, {"type": "subtitle", "time": 19529.99, "timestamp": "05:25:29", "text": "离我远点，因为他需要冷静一下。"}, {"type": "subtitle", "time": 19532.31, "timestamp": "05:25:32", "text": "我会给你一个理由。"}, {"type": "subtitle", "time": 19534.948, "timestamp": "05:25:34", "text": "如果你是a，如果你是b，我不是"}, {"type": "subtitle", "time": 19537.27, "timestamp": "05:25:37", "text": "你知道，这会要了你的命。进而"}, {"type": "subtitle", "time": 19539.99, "timestamp": "05:25:39", "text": "砰，他就"}, {"type": "subtitle", "time": 19555.75, "timestamp": "05:25:55", "text": "我需要集中注意力。"}, {"type": "subtitle", "time": 19557.75, "timestamp": "05:25:57", "text": "顺便说一句，我一死，我就……"}]
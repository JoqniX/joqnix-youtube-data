[{"type": "subtitle", "time": 18246.868, "timestamp": "05:04:06", "text": "我想做一些我们一直我们一直"}, {"type": "subtitle", "time": 18248.07, "timestamp": "05:04:08", "text": "玩得太疯了。我们一直"}, {"type": "subtitle", "time": 18249.43, "timestamp": "05:04:09", "text": "玩得太疯了。或许我们应该"}, {"type": "subtitle", "time": 18252.07, "timestamp": "05:04:12", "text": "放松点，好吗？是的。什么？"}, {"type": "subtitle", "time": 18255.35, "timestamp": "05:04:15", "text": "但如果这个人感染了我们怎么办？等待，"}, {"type": "subtitle", "time": 18262.948, "timestamp": "05:04:22", "text": "好吧，也许吧。哦，不。好的。我当时就想，"}, {"type": "subtitle", "time": 18265.67, "timestamp": "05:04:25", "text": "我讨厌这样。我讨厌这种破事儿。"}, {"type": "subtitle", "time": 18267.67, "timestamp": "05:04:27", "text": "你还好吗？"}, {"type": "subtitle", "time": 18269.91, "timestamp": "05:04:29", "text": "我讨厌这样。我一直都喜欢"}, {"type": "subtitle", "time": 18283.27, "timestamp": "05:04:43", "text": "别吓我。我很害怕。"}, {"type": "subtitle", "time": 18285.11, "timestamp": "05:04:45", "text": "团结一致。"}, {"type": "subtitle", "time": 18286.708, "timestamp": "05:04:46", "text": "不，不，不。去你的。不是你。我只"}, {"type": "subtitle", "time": 18289.27, "timestamp": "05:04:49", "text": "想要柳树。"}, {"type": "subtitle", "time": 18291.35, "timestamp": "05:04:51", "text": "太近了。太近了。太近了。哦，我的"}, {"type": "subtitle", "time": 18294.47, "timestamp": "05:04:54", "text": "上帝。有人因此丧命。"}]
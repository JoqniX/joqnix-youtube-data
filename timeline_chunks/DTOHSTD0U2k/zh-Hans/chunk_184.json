[{"type": "subtitle", "time": 11041.19, "timestamp": "03:04:01", "text": "那些已经完成另一段人生的人。"}, {"type": "subtitle", "time": 11043.59, "timestamp": "03:04:03", "text": "我完成另一边的任务了吗？我们"}, {"type": "subtitle", "time": 11045.75, "timestamp": "03:04:05", "text": "再做一个"}, {"type": "subtitle", "time": 11049.19, "timestamp": "03:04:09", "text": "去。你好，我叫蕾妮。我也是"}, {"type": "subtitle", "time": 11051.349, "timestamp": "03:04:11", "text": "被称为谈论阳具的人"}, {"type": "subtitle", "time": 11055.11, "timestamp": "03:04:15", "text": "我太喜欢东西了，而且我喜欢男人。"}, {"type": "subtitle", "time": 11062.15, "timestamp": "03:04:22", "text": "漫画家出柜了"}, {"type": "subtitle", "time": 11075.429, "timestamp": "03:04:35", "text": "韩韩，你这是在糟蹋你的键盘"}, {"type": "subtitle", "time": 11077.75, "timestamp": "03:04:37", "text": "现在。哦，等等。我很抱歉"}, {"type": "subtitle", "time": 11080.37, "timestamp": "03:04:40", "text": "那。"}, {"type": "subtitle", "time": 11086.469, "timestamp": "03:04:46", "text": "我需要花点时间来解决这个问题。所以，"}, {"type": "subtitle", "time": 11089.19, "timestamp": "03:04:49", "text": "是的。是的。是的。就这么做吧，因为我觉得"}, {"type": "subtitle", "time": 11091.99, "timestamp": "03:04:51", "text": "键盘声音太大了。是的。"}, {"type": "subtitle", "time": 11094.87, "timestamp": "03:04:54", "text": "是的。我已静音。"}, {"type": "subtitle", "time": 11098.95, "timestamp": "03:04:58", "text": "是的。接下来是黄鸭子，或者"}]
[{"type": "subtitle", "time": 15249.51, "timestamp": "04:14:09", "text": "好的。所以，呃，如果您能打开您的"}, {"type": "subtitle", "time": 15250.71, "timestamp": "04:14:10", "text": "你可以看到，眼睛有两个。"}, {"type": "subtitle", "time": 15253.03, "timestamp": "04:14:13", "text": "杀人犯，对吧？死神说道：“我是死神。”"}, {"type": "subtitle", "time": 15255.189, "timestamp": "04:14:15", "text": "特伦是其中一名杀手，"}, {"type": "subtitle", "time": 15256.87, "timestamp": "04:14:16", "text": "这意味着桐木并非其中之一"}, {"type": "subtitle", "time": 15258.71, "timestamp": "04:14:18", "text": "杀人犯，对吧？也可能是苏米迪"}, {"type": "subtitle", "time": 15261.349, "timestamp": "04:14:21", "text": "她竟然把这件事归咎于桐木。"}, {"type": "subtitle", "time": 15265.59, "timestamp": "04:14:25", "text": "正确的？我不认为那是……"}, {"type": "subtitle", "time": 15269.99, "timestamp": "04:14:29", "text": "比如她的不在场证明之类的。我当时和"}, {"type": "subtitle", "time": 15271.83, "timestamp": "04:14:31", "text": "她。我不理解这个逻辑。是的，你"}, {"type": "subtitle", "time": 15273.75, "timestamp": "04:14:33", "text": "你从她身边经过，对吧？它可能是"}, {"type": "subtitle", "time": 15275.51, "timestamp": "04:14:35", "text": "我穿胸罩是因为我太……"}, {"type": "subtitle", "time": 15283.51, "timestamp": "04:14:43", "text": "他说，如果你能睁开眼睛看看，"}, {"type": "subtitle", "time": 15285.75, "timestamp": "04:14:45", "text": "然后他就开始打电话给她。"}, {"type": "subtitle", "time": 15287.83, "timestamp": "04:14:47", "text": "哎呀，别这样。出去。他说就像"}, {"type": "subtitle", "time": 15289.75, "timestamp": "04:14:49", "text": "如果觉得好笑就投他一票。哦，我是"}, {"type": "subtitle", "time": 15292.55, "timestamp": "04:14:52", "text": "我只是在履行承诺而已。"}, {"type": "subtitle", "time": 15295.269, "timestamp": "04:14:55", "text": "对不起。"}, {"type": "subtitle", "time": 15297.429, "timestamp": "04:14:57", "text": "他们的论点更有说服力。要对我好一点，我的"}]
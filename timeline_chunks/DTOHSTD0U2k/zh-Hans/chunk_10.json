[{"type": "subtitle", "time": 606.79, "timestamp": "00:10:06", "text": "那是什么？你是回来寻求刺激的吗？"}, {"type": "subtitle", "time": 610.389, "timestamp": "00:10:10", "text": "所以，你想作弊，是吗？聪明"}, {"type": "subtitle", "time": 612.79, "timestamp": "00:10:12", "text": "移动。不受束缚，但我不会告诉你"}, {"type": "subtitle", "time": 613.99, "timestamp": "00:10:13", "text": "更多的。"}, {"type": "subtitle", "time": 615.75, "timestamp": "00:10:15", "text": "还没有。"}, {"type": "subtitle", "time": 618.389, "timestamp": "00:10:18", "text": "不希望我们的第一个孩子变成……"}, {"type": "subtitle", "time": 621.35, "timestamp": "00:10:21", "text": "枯燥乏味的言语交锋。你不想"}, {"type": "subtitle", "time": 625.19, "timestamp": "00:10:25", "text": "罗孚，这么快就让我失望了。长的"}, {"type": "subtitle", "time": 628.31, "timestamp": "00:10:28", "text": "好久不见。妮哈。妮哈。"}, {"type": "subtitle", "time": 656.31, "timestamp": "00:10:56", "text": "呃，看看日记吧。你好。嗯，我发现了一个"}, {"type": "subtitle", "time": 658.069, "timestamp": "00:10:58", "text": "新家。好的。叔叔送我上学"}]
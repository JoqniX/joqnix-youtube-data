[{"type": "subtitle", "time": 17821.75, "timestamp": "04:57:01", "text": "跟你们一起嗨起来，然后回来"}, {"type": "subtitle", "time": 17827.83, "timestamp": "04:57:07", "text": "喜欢"}, {"type": "subtitle", "time": 17830.31, "timestamp": "04:57:10", "text": "我只是我自己，还有拖着我们一起帮忙"}, {"type": "subtitle", "time": 17832.628, "timestamp": "04:57:12", "text": "互相排挤。我们就像恋人一样。是的，"}, {"type": "subtitle", "time": 17836.07, "timestamp": "04:57:16", "text": "就像我真的爱你一样。我终于得到了"}, {"type": "subtitle", "time": 17840.23, "timestamp": "04:57:20", "text": "免费物品。过来。过来。"}, {"type": "subtitle", "time": 17842.55, "timestamp": "04:57:22", "text": "我哥哥"}, {"type": "subtitle", "time": 17844.628, "timestamp": "04:57:24", "text": "还有警长，兄弟。你们玩得很开心"}, {"type": "subtitle", "time": 17847.19, "timestamp": "04:57:27", "text": "规则，但你却浪费了。不，不"}, {"type": "subtitle", "time": 17849.91, "timestamp": "04:57:29", "text": "我们互相清除了对方的障碍。好的。不，我们"}, {"type": "subtitle", "time": 17851.51, "timestamp": "04:57:31", "text": "互相清除了对方的障碍。重要部分。"}, {"type": "subtitle", "time": 17853.27, "timestamp": "04:57:33", "text": "好的。至少要清除那些不好的绳子，而不是"}, {"type": "subtitle", "time": 17855.27, "timestamp": "04:57:35", "text": "好的那些。是的。是的，我们清理干净了。"}, {"type": "subtitle", "time": 17857.03, "timestamp": "04:57:37", "text": "互相排挤。你没必要怀疑"}, {"type": "subtitle", "time": 17860.07, "timestamp": "04:57:40", "text": "因为我们，因为那不是我们。是的，因为"}, {"type": "subtitle", "time": 17862.23, "timestamp": "04:57:42", "text": "你们都走了。"}, {"type": "subtitle", "time": 17869.27, "timestamp": "04:57:49", "text": "不，不。不，不，不。听我说完。不。"}, {"type": "subtitle", "time": 17870.868, "timestamp": "04:57:50", "text": "逻辑很奇怪。如果你们彼此相爱"}, {"type": "subtitle", "time": 17872.868, "timestamp": "04:57:52", "text": "其他情况下，如果你信任一切，那么"}, {"type": "subtitle", "time": 17875.35, "timestamp": "04:57:55", "text": "你应该先征得其他人的同意。"}, {"type": "subtitle", "time": 17877.27, "timestamp": "04:57:57", "text": "墨水。墨水。你说了那个N开头的词。墨水。墨水。"}]
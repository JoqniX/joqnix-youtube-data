[{"type": "subtitle", "time": 15061.269, "timestamp": "04:11:01", "text": "比他以前更甚。坚持，稍等。三人死亡。"}, {"type": "subtitle", "time": 15063.189, "timestamp": "04:11:03", "text": "坚持，稍等。"}, {"type": "subtitle", "time": 15066.07, "timestamp": "04:11:06", "text": "发生了什么？是的。是的。对不起。我"}, {"type": "subtitle", "time": 15068.63, "timestamp": "04:11:08", "text": "我看到乔亚死了，但我没看到是谁死了。"}, {"type": "subtitle", "time": 15070.95, "timestamp": "04:11:10", "text": "那。"}, {"type": "subtitle", "time": 15074.15, "timestamp": "04:11:14", "text": "等待。我想其中一人是警长"}, {"type": "subtitle", "time": 15077.99, "timestamp": "04:11:17", "text": "他们死了，而且他们还杀害了一个无辜的人。"}, {"type": "subtitle", "time": 15081.11, "timestamp": "04:11:21", "text": "嗯，也许吧。好的，所以我相当确定"}, {"type": "subtitle", "time": 15083.189, "timestamp": "04:11:23", "text": "这是冒牌货。我看起来像个冒名顶替者"}, {"type": "subtitle", "time": 15085.269, "timestamp": "04:11:25", "text": "是他们，对吧？然后特伦斯杀了人"}, {"type": "subtitle", "time": 15088.07, "timestamp": "04:11:28", "text": "就在我前面，对吧？因为"}, {"type": "subtitle", "time": 15090.07, "timestamp": "04:11:30", "text": "我其实"}, {"type": "subtitle", "time": 15092.95, "timestamp": "04:11:32", "text": "正确的。那真是太拖沓了。这绝对是"}, {"type": "subtitle", "time": 15101.99, "timestamp": "04:11:41", "text": "我简直要疯了。我的天哪。我很抱歉，"}, {"type": "subtitle", "time": 15106.389, "timestamp": "04:11:46", "text": "乔。为什么？不，我说我和"}, {"type": "subtitle", "time": 15109.269, "timestamp": "04:11:49", "text": "决不。"}, {"type": "subtitle", "time": 15113.91, "timestamp": "04:11:53", "text": "他们活了下来。"}]
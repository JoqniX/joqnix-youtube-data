[{"type": "subtitle", "time": 11768.229, "timestamp": "03:16:08", "text": "哦，我们看起来像天使。"}, {"type": "subtitle", "time": 11770.389, "timestamp": "03:16:10", "text": "是的，"}, {"type": "subtitle", "time": 11772.87, "timestamp": "03:16:12", "text": "漂亮的"}, {"type": "subtitle", "time": 11775.78, "timestamp": "03:16:15", "text": "混杂在一起。"}, {"type": "subtitle", "time": 11789.59, "timestamp": "03:16:29", "text": "你好。等等，有人去世了。你好。什么"}, {"type": "subtitle", "time": 11796.79, "timestamp": "03:16:36", "text": "那么我们该怎么办？"}, {"type": "subtitle", "time": 11800.71, "timestamp": "03:16:40", "text": "我不知道。不知道。"}, {"type": "subtitle", "time": 11803.51, "timestamp": "03:16:43", "text": "我只是像个行尸走肉一样四处闲逛，好像我什么都知道似的。"}, {"type": "subtitle", "time": 11817.51, "timestamp": "03:16:57", "text": "我以为那是一块石头。"}]
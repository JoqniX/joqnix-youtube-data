[{"type": "subtitle", "time": 2640.71, "timestamp": "00:44:00", "text": "把她推向这一步的人"}, {"type": "subtitle", "time": 2644.23, "timestamp": "00:44:04", "text": "悲惨的结局？我很抱歉。我迷路了"}, {"type": "subtitle", "time": 2651.43, "timestamp": "00:44:11", "text": "我真希望我能说这样的悲剧不会发生。"}, {"type": "subtitle", "time": 2654.15, "timestamp": "00:44:14", "text": "再次发生。"}, {"type": "subtitle", "time": 2656.87, "timestamp": "00:44:16", "text": "但我仍然缺乏信心去做这件事。"}, {"type": "subtitle", "time": 2659.349, "timestamp": "00:44:19", "text": "那种说法。"}, {"type": "subtitle", "time": 2661.51, "timestamp": "00:44:21", "text": "正是这样的悲剧让我……"}, {"type": "subtitle", "time": 2663.91, "timestamp": "00:44:23", "text": "想成为一名先锋骑兵，"}, {"type": "subtitle", "time": 2666.309, "timestamp": "00:44:26", "text": "成为拥有这种力量的人"}, {"type": "subtitle", "time": 2668.87, "timestamp": "00:44:28", "text": "阻止此类事件再次发生。我"}, {"type": "subtitle", "time": 2672.069, "timestamp": "00:44:32", "text": "无法阻止这一刻，但至少我"}, {"type": "subtitle", "time": 2674.069, "timestamp": "00:44:34", "text": "我应该尽我所能"}, {"type": "subtitle", "time": 2676.15, "timestamp": "00:44:36", "text": "帮助。我相信你。"}, {"type": "subtitle", "time": 2679.19, "timestamp": "00:44:39", "text": "谢谢你，Rover。"}, {"type": "subtitle", "time": 2682.23, "timestamp": "00:44:42", "text": "纠结于此对我们没有任何好处。"}, {"type": "subtitle", "time": 2685.67, "timestamp": "00:44:45", "text": "我们走吧。我将撰写一份关于以下内容的报告"}, {"type": "subtitle", "time": 2688.15, "timestamp": "00:44:48", "text": "这里发生的事情，请把它一起发送过来。"}, {"type": "subtitle", "time": 2690.95, "timestamp": "00:44:50", "text": "我们收集到的线索。好的，我们走吧"}, {"type": "subtitle", "time": 2692.47, "timestamp": "00:44:52", "text": "后退"}, {"type": "subtitle", "time": 2693.79, "timestamp": "00:44:53", "text": "一起。"}]
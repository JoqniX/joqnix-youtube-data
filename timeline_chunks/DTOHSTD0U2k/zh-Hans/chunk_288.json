[{"type": "subtitle", "time": 17282.788, "timestamp": "04:48:02", "text": "如果你说得对的话。把它从我手里拿走，狗狗。"}, {"type": "subtitle", "time": 17284.948, "timestamp": "04:48:04", "text": "把它拿走。真是太糟糕了。我拿"}, {"type": "subtitle", "time": 17287.27, "timestamp": "04:48:07", "text": "它。"}, {"type": "subtitle", "time": 17307.99, "timestamp": "04:48:27", "text": "里恩。"}, {"type": "subtitle", "time": 17311.03, "timestamp": "04:48:31", "text": "去你的。"}, {"type": "subtitle", "time": 17313.99, "timestamp": "04:48:33", "text": "好的。你好。"}, {"type": "subtitle", "time": 17317.35, "timestamp": "04:48:37", "text": "你能放我走吗？"}, {"type": "subtitle", "time": 17320.47, "timestamp": "04:48:40", "text": "求求你放我走吧？"}, {"type": "subtitle", "time": 17322.868, "timestamp": "04:48:42", "text": "你无视我。"}, {"type": "subtitle", "time": 17327.67, "timestamp": "04:48:47", "text": "放开我。放了我。"}, {"type": "subtitle", "time": 17330.23, "timestamp": "04:48:50", "text": "这他妈是什么玩意儿？拿起铃铛。"}, {"type": "subtitle", "time": 17334.628, "timestamp": "04:48:54", "text": "哦，真不敢相信她把我吃了。什么"}]
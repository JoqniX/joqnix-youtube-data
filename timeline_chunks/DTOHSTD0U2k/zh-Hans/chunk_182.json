[{"type": "subtitle", "time": 10930.63, "timestamp": "03:02:10", "text": "进入"}, {"type": "subtitle", "time": 10934.309, "timestamp": "03:02:14", "text": "这里有锻造炉。你可以。你可以。"}, {"type": "subtitle", "time": 10936.23, "timestamp": "03:02:16", "text": "是的。你没有上西班牙语课吗？"}, {"type": "subtitle", "time": 10939.19, "timestamp": "03:02:19", "text": "伙计们？"}, {"type": "subtitle", "time": 10944.27, "timestamp": "03:02:24", "text": "完全不会说西班牙语。不会说西班牙语。好的。"}, {"type": "subtitle", "time": 10947.03, "timestamp": "03:02:27", "text": "[笑声]"}, {"type": "subtitle", "time": 10952.71, "timestamp": "03:02:32", "text": "我们要等他排队吗？嗯，你好吗？"}, {"type": "subtitle", "time": 10955.03, "timestamp": "03:02:35", "text": "我们现在还在等什么？韩韩。哦，等等。"}, {"type": "subtitle", "time": 10956.95, "timestamp": "03:02:36", "text": "韩听不到我们说话。这句台词说得不错。"}, {"type": "subtitle", "time": 10959.269, "timestamp": "03:02:39", "text": "韩韩。"}, {"type": "subtitle", "time": 10963.349, "timestamp": "03:02:43", "text": "是的，我的问题依然存在。"}, {"type": "subtitle", "time": 10966.55, "timestamp": "03:02:46", "text": "好的。我无法更改我的名字。它是"}, {"type": "subtitle", "time": 10968.469, "timestamp": "03:02:48", "text": "氧气代替氧气。他在……"}, {"type": "subtitle", "time": 10971.99, "timestamp": "03:02:51", "text": "VC。碉堡了。好的。"}, {"type": "subtitle", "time": 10974.469, "timestamp": "03:02:54", "text": "他还在修理他的东西。"}, {"type": "subtitle", "time": 10977.269, "timestamp": "03:02:57", "text": "哦。你想做个自我介绍吗？"}, {"type": "subtitle", "time": 10979.59, "timestamp": "03:02:59", "text": "直接开始游戏？是的。就像"}]
[{"type": "subtitle", "time": 2403.27, "timestamp": "00:40:03", "text": "这里没有水，但到处都很干燥。甚至"}, {"type": "subtitle", "time": 2405.51, "timestamp": "00:40:05", "text": "植被生长茂盛。好的，老板。"}, {"type": "subtitle", "time": 2408.47, "timestamp": "00:40:08", "text": "再见。"}, {"type": "subtitle", "time": 2410.47, "timestamp": "00:40:10", "text": "那棵树。"}, {"type": "subtitle", "time": 2412.87, "timestamp": "00:40:12", "text": "太惊艳了。"}, {"type": "subtitle", "time": 2416.63, "timestamp": "00:40:16", "text": "它真迷人。它有一种诡异的魅力。"}, {"type": "subtitle", "time": 2421.27, "timestamp": "00:40:21", "text": "请救救我们。"}, {"type": "subtitle", "time": 2424.63, "timestamp": "00:40:24", "text": "你是想告诉我们什么？"}, {"type": "subtitle", "time": 2428.67, "timestamp": "00:40:28", "text": "这里面藏着什么秘密吗？"}, {"type": "subtitle", "time": 2431.03, "timestamp": "00:40:31", "text": "[音乐]"}, {"type": "subtitle", "time": 2449.829, "timestamp": "00:40:49", "text": "一个陌生男人来找我。我说我打电话"}, {"type": "subtitle", "time": 2453.75, "timestamp": "00:40:53", "text": "我可以叫他哥哥，但我真的"}, {"type": "subtitle", "time": 2456.55, "timestamp": "00:40:56", "text": "与其他人截然不同。不是"}]
[{"type": "subtitle", "time": 16146.95, "timestamp": "04:29:06", "text": "很有趣。你知道，你知道，我吃"}, {"type": "subtitle", "time": 16151.75, "timestamp": "04:29:11", "text": "她是因为太害怕了。"}, {"type": "subtitle", "time": 16157.91, "timestamp": "04:29:17", "text": "Yoshi，你为什么在找我？我"}, {"type": "subtitle", "time": 16161.269, "timestamp": "04:29:21", "text": "我真的告诉​​过你我是警长。"}, {"type": "subtitle", "time": 16162.95, "timestamp": "04:29:22", "text": "不，"}, {"type": "subtitle", "time": 16164.55, "timestamp": "04:29:24", "text": "你为什么要杀人？你为什么要杀人？"}, {"type": "subtitle", "time": 16166.229, "timestamp": "04:29:26", "text": "龙？"}, {"type": "subtitle", "time": 16169.349, "timestamp": "04:29:29", "text": "因为这样比赛会很有趣。它"}, {"type": "subtitle", "time": 16170.87, "timestamp": "04:29:30", "text": "曾是"}, {"type": "subtitle", "time": 16173.189, "timestamp": "04:29:33", "text": "我"}, {"type": "subtitle", "time": 16174.79, "timestamp": "04:29:34", "text": "比如我吃了一半以上的"}, {"type": "subtitle", "time": 16182.95, "timestamp": "04:29:42", "text": "你吃得很好。之后，我"}, {"type": "subtitle", "time": 16185.75, "timestamp": "04:29:45", "text": "故意不吃屎，因为"}, {"type": "subtitle", "time": 16195.51, "timestamp": "04:29:55", "text": "他说，这是最后一场比赛。兄弟，我当时就想，"}, {"type": "subtitle", "time": 16197.51, "timestamp": "04:29:57", "text": "耀西，快跑。我当时正试图逃跑。我"}, {"type": "subtitle", "time": 16199.51, "timestamp": "04:29:59", "text": "我当时就想，龟仙人，我做不到。"}]
[{"type": "subtitle", "time": 18960.948, "timestamp": "05:16:00", "text": "那是墨美吗？"}, {"type": "subtitle", "time": 18963.35, "timestamp": "05:16:03", "text": "好的，我在墓地里发现了一具尸体。我当时"}, {"type": "subtitle", "time": 18965.35, "timestamp": "05:16:05", "text": "正从补习班走到一个锅"}, {"type": "subtitle", "time": 18968.948, "timestamp": "05:16:08", "text": "公墓。我想我遇到了……呃，是吗？我遇到了"}, {"type": "subtitle", "time": 18971.67, "timestamp": "05:16:11", "text": "那里有卡拉OK吗？我路过卡拉OK厅。呃"}, {"type": "subtitle", "time": 18974.39, "timestamp": "05:16:14", "text": "但我路过犯罪巷的卡拉OK厅"}, {"type": "subtitle", "time": 18976.47, "timestamp": "05:16:16", "text": "仅此而已。我不太清楚。"}, {"type": "subtitle", "time": 18978.708, "timestamp": "05:16:18", "text": "卡拉OK的起源。我只是……所以你"}, {"type": "subtitle", "time": 18982.39, "timestamp": "05:16:22", "text": "明白了。接下来会发生什么？我就是我，"}, {"type": "subtitle", "time": 18986.23, "timestamp": "05:16:26", "text": "Raos 和 Kyoki 在一起"}, {"type": "subtitle", "time": 18989.27, "timestamp": "05:16:29", "text": "我们也遇到了同样的情况。"}, {"type": "subtitle", "time": 18991.19, "timestamp": "05:16:31", "text": "所以我可以确认，因为Dragon和Jock"}, {"type": "subtitle", "time": 18993.11, "timestamp": "05:16:33", "text": "我们在一起是因为我路过你们身边"}, {"type": "subtitle", "time": 18996.708, "timestamp": "05:16:36", "text": "广场上，我和Willow在一起。所以是"}, {"type": "subtitle", "time": 18998.628, "timestamp": "05:16:38", "text": "要么是基里，要么是韩。无论哪一个"}, {"type": "subtitle", "time": 19002.55, "timestamp": "05:16:42", "text": "二号在广场上。"}, {"type": "subtitle", "time": 19005.35, "timestamp": "05:16:45", "text": "我刚才看到Willow和他们在一起。我是说"}, {"type": "subtitle", "time": 19007.11, "timestamp": "05:16:47", "text": "嗯，如果你们愿意帮帮我的话。我"}, {"type": "subtitle", "time": 19008.628, "timestamp": "05:16:48", "text": "当时和Willow在一起。好吧，那是谎话。全部"}, {"type": "subtitle", "time": 19010.15, "timestamp": "05:16:50", "text": "正确的。"}, {"type": "subtitle", "time": 19013.83, "timestamp": "05:16:53", "text": "不，他当时和他们在一起。哦，在"}, {"type": "subtitle", "time": 19015.35, "timestamp": "05:16:55", "text": "开始。一开始。一开始。"}, {"type": "subtitle", "time": 19017.99, "timestamp": "05:16:57", "text": "是的，他当时就和他们在一起。我"}, {"type": "subtitle", "time": 19019.91, "timestamp": "05:16:59", "text": "走过"}]
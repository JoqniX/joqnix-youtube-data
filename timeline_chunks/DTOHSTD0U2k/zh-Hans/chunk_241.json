[{"type": "subtitle", "time": 14469.91, "timestamp": "04:01:09", "text": "我的孩子。呃，你好。"}, {"type": "subtitle", "time": 14473.59, "timestamp": "04:01:13", "text": "跟我来。我需要有人帮我完成一项任务。"}, {"type": "subtitle", "time": 14475.83, "timestamp": "04:01:15", "text": "你确定吗？"}, {"type": "subtitle", "time": 14478.59, "timestamp": "04:01:18", "text": "你不需要那么多。"}, {"type": "subtitle", "time": 14481.429, "timestamp": "04:01:21", "text": "[掌声]"}, {"type": "subtitle", "time": 14483.67, "timestamp": "04:01:23", "text": "哦，"}, {"type": "subtitle", "time": 14488.15, "timestamp": "04:01:28", "text": "好的。好的。就这样。就这样。"}, {"type": "subtitle", "time": 14490.55, "timestamp": "04:01:30", "text": "不。"}, {"type": "subtitle", "time": 14492.389, "timestamp": "04:01:32", "text": "你知道"}, {"type": "subtitle", "time": 14494.95, "timestamp": "04:01:34", "text": "为什么就站在那里？你知道，我"}, {"type": "subtitle", "time": 14497.91, "timestamp": "04:01:37", "text": "我本可以杀了所有人，但我当时"}, {"type": "subtitle", "time": 14505.03, "timestamp": "04:01:45", "text": "我的天啊。"}, {"type": "subtitle", "time": 14507.349, "timestamp": "04:01:47", "text": "所以，你的演艺生涯如何？这里真不错。"}, {"type": "subtitle", "time": 14510.71, "timestamp": "04:01:50", "text": "难道不是吗？我没在那里杀任何人。我"}, {"type": "subtitle", "time": 14513.269, "timestamp": "04:01:53", "text": "他为了赢得比赛而假装完成任务"}, {"type": "subtitle", "time": 14515.03, "timestamp": "04:01:55", "text": "默认。"}, {"type": "subtitle", "time": 14518.229, "timestamp": "04:01:58", "text": "把所有人都杀光。"}]
[{"type": "subtitle", "time": 14220.63, "timestamp": "03:57:00", "text": "已报告。"}, {"type": "subtitle", "time": 14224.95, "timestamp": "03:57:04", "text": "等等，我看到蕾妮……呃，就像……"}, {"type": "subtitle", "time": 14227.51, "timestamp": "03:57:07", "text": "他大声呼救，拼命求生"}, {"type": "subtitle", "time": 14230.389, "timestamp": "03:57:10", "text": "骑了很久的自行车，然后突然就死了。哦"}, {"type": "subtitle", "time": 14233.75, "timestamp": "03:57:13", "text": "我的上帝。我的天啊。我不知道。我"}, {"type": "subtitle", "time": 14236.79, "timestamp": "03:57:16", "text": "不知道他为什么尖叫。"}, {"type": "subtitle", "time": 14245.269, "timestamp": "03:57:25", "text": "我要逃跑。我在等乔"}, {"type": "subtitle", "time": 14247.349, "timestamp": "03:57:27", "text": "因为他就在附近。"}, {"type": "subtitle", "time": 14249.189, "timestamp": "03:57:29", "text": "我想让你们告诉我，事情发生在哪里。"}, {"type": "subtitle", "time": 14251.189, "timestamp": "03:57:31", "text": "先是身体？我们人太多了"}, {"type": "subtitle", "time": 14254.63, "timestamp": "03:57:34", "text": "输掉。我正在等待它在……"}, {"type": "subtitle", "time": 14257.75, "timestamp": "03:57:37", "text": "给我提个醒。为什么？我当时和你在一起。我"}, {"type": "subtitle", "time": 14261.91, "timestamp": "03:57:41", "text": "我也不知道为什么。嗯？他看起来"}, {"type": "subtitle", "time": 14266.15, "timestamp": "03:57:46", "text": "之前就和我在一起。我知道，但是"}, {"type": "subtitle", "time": 14268.63, "timestamp": "03:57:48", "text": "哦，对了，Yoshi倒是很清楚。"}, {"type": "subtitle", "time": 14271.429, "timestamp": "03:57:51", "text": "她确实进行了冲锋。不，等等。"}, {"type": "subtitle", "time": 14273.269, "timestamp": "03:57:53", "text": "为什么？"}]
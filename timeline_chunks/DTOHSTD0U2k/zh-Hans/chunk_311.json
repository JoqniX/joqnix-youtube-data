[{"type": "subtitle", "time": 18665.51, "timestamp": "05:11:05", "text": "你会吗？你会吗？"}, {"type": "subtitle", "time": 18667.91, "timestamp": "05:11:07", "text": "你愿意嫁给我吗？我已结婚。我是"}, {"type": "subtitle", "time": 18669.67, "timestamp": "05:11:09", "text": "对不起。"}, {"type": "subtitle", "time": 18679.75, "timestamp": "05:11:19", "text": "是的，他们要结婚了。"}, {"type": "subtitle", "time": 18683.91, "timestamp": "05:11:23", "text": "什么？不，不，不。是Rea吗？"}, {"type": "subtitle", "time": 18686.31, "timestamp": "05:11:26", "text": "哦，他名草有主了，兄弟。他名草有主了。他是"}, {"type": "subtitle", "time": 18688.788, "timestamp": "05:11:28", "text": "找到老婆了。他拒绝了我。他沮丧"}, {"type": "subtitle", "time": 18699.91, "timestamp": "05:11:39", "text": "但我没在直播。好了，各位。"}, {"type": "subtitle", "time": 18706.55, "timestamp": "05:11:46", "text": "这将是我最后一次。哦，我不这么认为"}, {"type": "subtitle", "time": 18708.39, "timestamp": "05:11:48", "text": "她到这儿了。好的。是的。做过"}, {"type": "subtitle", "time": 18711.67, "timestamp": "05:11:51", "text": "有人说“去吸我的鸡巴”？我说我"}, {"type": "subtitle", "time": 18715.91, "timestamp": "05:11:55", "text": "我吃的是蘸酱，不是口交。哦，"}, {"type": "subtitle", "time": 18719.43, "timestamp": "05:11:59", "text": "好的。所以，说实话，你并没有"}]
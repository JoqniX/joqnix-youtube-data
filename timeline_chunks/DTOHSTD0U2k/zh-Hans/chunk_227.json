[{"type": "subtitle", "time": 13620.07, "timestamp": "03:47:00", "text": "敏感的"}, {"type": "subtitle", "time": 13624.15, "timestamp": "03:47:04", "text": "和这里每个人互动。"}, {"type": "subtitle", "time": 13625.349, "timestamp": "03:47:05", "text": "是的。是的。伙计们，谁在摸谁？"}, {"type": "subtitle", "time": 13627.11, "timestamp": "03:47:07", "text": "有人吗？你就直接告诉我吧。患病的"}, {"type": "subtitle", "time": 13629.429, "timestamp": "03:47:09", "text": "触摸"}, {"type": "subtitle", "time": 13631.91, "timestamp": "03:47:11", "text": "我会反击。我会帮你。全部"}, {"type": "subtitle", "time": 13633.59, "timestamp": "03:47:13", "text": "正确的。谁碰我，我就帮你"}, {"type": "subtitle", "time": 13635.91, "timestamp": "03:47:15", "text": "也要和每个人互动。"}, {"type": "subtitle", "time": 13638.63, "timestamp": "03:47:18", "text": "柜台触摸。"}, {"type": "subtitle", "time": 13643.349, "timestamp": "03:47:23", "text": "互相触摸。听起来像个特别的"}, {"type": "subtitle", "time": 13648.07, "timestamp": "03:47:28", "text": "从日式角色扮演游戏中走出来。互相触碰"}, {"type": "subtitle", "time": 13650.229, "timestamp": "03:47:30", "text": "新冠病毒。"}, {"type": "subtitle", "time": 13651.349, "timestamp": "03:47:31", "text": "好的。"}, {"type": "subtitle", "time": 13653.67, "timestamp": "03:47:33", "text": "告诉我。告诉我。我肯定"}, {"type": "subtitle", "time": 13663.83, "timestamp": "03:47:43", "text": "我听到有人吹风的声音。"}, {"type": "subtitle", "time": 13666.87, "timestamp": "03:47:46", "text": "麦克风。"}, {"type": "subtitle", "time": 13670.71, "timestamp": "03:47:50", "text": "不知道。不是我。"}]
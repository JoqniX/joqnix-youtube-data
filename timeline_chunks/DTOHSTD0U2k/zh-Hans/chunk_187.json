[{"type": "subtitle", "time": 11224.309, "timestamp": "03:07:04", "text": "跟随。到那边去。到那边去。"}, {"type": "subtitle", "time": 11225.83, "timestamp": "03:07:05", "text": "跟随"}, {"type": "subtitle", "time": 11226.87, "timestamp": "03:07:06", "text": "你能听到我吗？等待。你能吗？你能吗？"}, {"type": "subtitle", "time": 11228.309, "timestamp": "03:07:08", "text": "听见了吗？是的，我们能听到你说话。我们可以"}, {"type": "subtitle", "time": 11229.91, "timestamp": "03:07:09", "text": "听到了。"}, {"type": "subtitle", "time": 11232.15, "timestamp": "03:07:12", "text": "好的。"}, {"type": "subtitle", "time": 11235.19, "timestamp": "03:07:15", "text": "我需要实际设置我的直播流。"}, {"type": "subtitle", "time": 11236.79, "timestamp": "03:07:16", "text": "第一的。随便吧。好的。因为就像"}, {"type": "subtitle", "time": 11240.55, "timestamp": "03:07:20", "text": "我需要再次打开这个，因为我"}, {"type": "subtitle", "time": 11242.95, "timestamp": "03:07:22", "text": "没问题。"}, {"type": "subtitle", "time": 11254.71, "timestamp": "03:07:34", "text": "等等，稍等。你为什么听不到我说话？哦"}, {"type": "subtitle", "time": 11257.67, "timestamp": "03:07:37", "text": "妈的，真奇怪。"}, {"type": "subtitle", "time": 11261.349, "timestamp": "03:07:41", "text": "我选择盟友。我想下一个应该是你。"}, {"type": "subtitle", "time": 11278.23, "timestamp": "03:07:58", "text": "稍等片刻。大男孩。来取吧"}]
[{"type": "subtitle", "time": 15483.67, "timestamp": "04:18:03", "text": "是的，你可以直接杀了那个赞助人。"}, {"type": "subtitle", "time": 15485.99, "timestamp": "04:18:05", "text": "各位，王牌来了。他的"}, {"type": "subtitle", "time": 15488.07, "timestamp": "04:18:08", "text": "我的名字是小丑。是的，他在这里。你好，"}, {"type": "subtitle", "time": 15490.309, "timestamp": "04:18:10", "text": "小丑。你好。你好，小丑。很高兴见到你"}, {"type": "subtitle", "time": 15498.71, "timestamp": "04:18:18", "text": "小丑，是你吗？"}, {"type": "subtitle", "time": 15501.83, "timestamp": "04:18:21", "text": "小丑？我们生活在一个社会里吗？"}, {"type": "subtitle", "time": 15509.75, "timestamp": "04:18:29", "text": "家长们准备好迎接这股红色风暴吧。不，"}, {"type": "subtitle", "time": 15516.79, "timestamp": "04:18:36", "text": "哦，你可以改变"}, {"type": "subtitle", "time": 15519.349, "timestamp": "04:18:39", "text": "总是成为攻击目标。"}, {"type": "subtitle", "time": 15521.349, "timestamp": "04:18:41", "text": "狗狗，我真为你感到难过。不，兄弟。"}, {"type": "subtitle", "time": 15524.309, "timestamp": "04:18:44", "text": "没关系。没关系。"}, {"type": "subtitle", "time": 15527.03, "timestamp": "04:18:47", "text": "哦，兄弟。兄弟，你为什么要杀我？"}, {"type": "subtitle", "time": 15530.55, "timestamp": "04:18:50", "text": "义警。嗯？对，没错。"}, {"type": "subtitle", "time": 15537.269, "timestamp": "04:18:57", "text": "伙计们"}, {"type": "subtitle", "time": 15539.11, "timestamp": "04:18:59", "text": "忘记你知道曾经有过"}]
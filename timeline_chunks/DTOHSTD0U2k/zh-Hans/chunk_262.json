[{"type": "subtitle", "time": 15721.83, "timestamp": "04:22:01", "text": "该我发言了。 Yoshi，一秒钟。让我"}, {"type": "subtitle", "time": 15724.389, "timestamp": "04:22:04", "text": "解释。我是警长。我刺伤了"}, {"type": "subtitle", "time": 15726.95, "timestamp": "04:22:06", "text": "苏米，因为我是警长。我没有"}, {"type": "subtitle", "time": 15729.99, "timestamp": "04:22:09", "text": "死。苏米是个杀手。我是警长。我"}, {"type": "subtitle", "time": 15731.75, "timestamp": "04:22:11", "text": "现在可以保证这一点。我是警长。"}, {"type": "subtitle", "time": 15733.91, "timestamp": "04:22:13", "text": "我不信任，我不信任。"}, {"type": "subtitle", "time": 15736.389, "timestamp": "04:22:16", "text": "不，他直接走到我面前。哦，我的"}, {"type": "subtitle", "time": 15739.429, "timestamp": "04:22:19", "text": "上帝。你知道吗？你是"}, {"type": "subtitle", "time": 15741.75, "timestamp": "04:22:21", "text": "好的。你想打赌吗？等待。"}, {"type": "subtitle", "time": 15743.269, "timestamp": "04:22:23", "text": "如果我被赶出去，而我是……"}, {"type": "subtitle", "time": 15744.79, "timestamp": "04:22:24", "text": "警长，你得做点什么了。"}, {"type": "subtitle", "time": 15746.79, "timestamp": "04:22:26", "text": "我。喂，你准备踢出去。不。"}, {"type": "subtitle", "time": 15748.309, "timestamp": "04:22:28", "text": "不，不，不，不。那样行不通。"}, {"type": "subtitle", "time": 15750.71, "timestamp": "04:22:30", "text": "这里。这样行不通。好的。我是"}, {"type": "subtitle", "time": 15753.03, "timestamp": "04:22:33", "text": "你打算错失良机。你是"}, {"type": "subtitle", "time": 15755.349, "timestamp": "04:22:35", "text": "错失良机。我只是说你"}, {"type": "subtitle", "time": 15757.269, "timestamp": "04:22:37", "text": "这些人浪费了一个警长。不是我的"}, {"type": "subtitle", "time": 15763.429, "timestamp": "04:22:43", "text": "我们可以跳过。我只是，我只是，我是"}, {"type": "subtitle", "time": 15766.149, "timestamp": "04:22:46", "text": "警长。我可以确认。 Yoshi，我会"}, {"type": "subtitle", "time": 15767.269, "timestamp": "04:22:47", "text": "如果真是那样，我已经杀了你。"}, {"type": "subtitle", "time": 15769.67, "timestamp": "04:22:49", "text": "吉。 Yoshi，留下来陪我。 Yoshi，你"}, {"type": "subtitle", "time": 15771.83, "timestamp": "04:22:51", "text": "知道什么？"}, {"type": "subtitle", "time": 15774.63, "timestamp": "04:22:54", "text": "我是警长。我是警长。我是警长。"}]
[{"type": "subtitle", "time": 10983.349, "timestamp": "03:03:03", "text": "过去的好时光啊，老兄。诚实地。好的。开始"}, {"type": "subtitle", "time": 10986.23, "timestamp": "03:03:06", "text": "从头开始，宝贝。不。不。不。不。来自"}, {"type": "subtitle", "time": 10988.469, "timestamp": "03:03:08", "text": "正面。从正面。从"}, {"type": "subtitle", "time": 10992.15, "timestamp": "03:03:12", "text": "最棒的，宝贝。龙将登顶"}, {"type": "subtitle", "time": 10994.469, "timestamp": "03:03:14", "text": "或在底部。请自我介绍。我"}, {"type": "subtitle", "time": 10997.51, "timestamp": "03:03:17", "text": "需要排队。"}, {"type": "subtitle", "time": 10999.349, "timestamp": "03:03:19", "text": "好的，威尔。停在底部。"}, {"type": "subtitle", "time": 11001.91, "timestamp": "03:03:21", "text": "什么？好吧，没问题。柳树，走吧。"}, {"type": "subtitle", "time": 11004.23, "timestamp": "03:03:24", "text": "先给柳树。介绍"}, {"type": "subtitle", "time": 11007.75, "timestamp": "03:03:27", "text": "你自己。我们走吧。是的。上去"}, {"type": "subtitle", "time": 11010.469, "timestamp": "03:03:30", "text": "舞台，兄弟。爬上其中一个"}, {"type": "subtitle", "time": 11013.51, "timestamp": "03:03:33", "text": "椅子。不，不，不。移到那边去。"}, {"type": "subtitle", "time": 11015.03, "timestamp": "03:03:35", "text": "是的。移至你需要的地方"}, {"type": "subtitle", "time": 11017.03, "timestamp": "03:03:37", "text": "聚光灯。对，就是这样。是的，"}, {"type": "subtitle", "time": 11019.59, "timestamp": "03:03:39", "text": "好了。聚光灯。很不错。"}, {"type": "subtitle", "time": 11022.71, "timestamp": "03:03:42", "text": "你好。我是苏米的付费朋友"}, {"type": "subtitle", "time": 11026.23, "timestamp": "03:03:46", "text": "这里。是的。给你500美元。我不"}, {"type": "subtitle", "time": 11029.03, "timestamp": "03:03:49", "text": "我知道你们能得到多少，但是"}, {"type": "subtitle", "time": 11031.99, "timestamp": "03:03:51", "text": "哇，哇，哇。又来了。什么？"}, {"type": "subtitle", "time": 11034.23, "timestamp": "03:03:54", "text": "不。"}, {"type": "subtitle", "time": 11036.309, "timestamp": "03:03:56", "text": "你好，柳树。"}, {"type": "subtitle", "time": 11039.269, "timestamp": "03:03:59", "text": "你好。你好。哦，我们再排一条队。"}]
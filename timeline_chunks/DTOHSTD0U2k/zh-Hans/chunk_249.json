[{"type": "subtitle", "time": 14941.76, "timestamp": "04:09:01", "text": "我亲眼目睹你杀人 韩当着大家的面，你们两个。"}, {"type": "subtitle", "time": 14944.96, "timestamp": "04:09:04", "text": "韩当着大家的面，你们两个。 这样做。你有什么要说的吗？"}, {"type": "subtitle", "time": 14948.08, "timestamp": "04:09:08", "text": "这样做。你有什么要说的吗？ 请解释一下？"}, {"type": "subtitle", "time": 14950.16, "timestamp": "04:09:10", "text": "请解释一下？ 你知道，你知道那是个错误"}, {"type": "subtitle", "time": 14952.08, "timestamp": "04:09:12", "text": "你知道，你知道那是个错误 斗争。"}, {"type": "subtitle", "time": 14954.63, "timestamp": "04:09:14", "text": "斗争。 [笑声]"}, {"type": "subtitle", "time": 14959.68, "timestamp": "04:09:19", "text": "[笑声] 什么？上帝。"}, {"type": "subtitle", "time": 14969.99, "timestamp": "04:09:29", "text": "我的天啊。"}, {"type": "subtitle", "time": 14972.389, "timestamp": "04:09:32", "text": "没关系。没关系。声音非常大。"}, {"type": "subtitle", "time": 14974.95, "timestamp": "04:09:34", "text": "哦，不。"}, {"type": "subtitle", "time": 14977.269, "timestamp": "04:09:37", "text": "Kyuki，你的角色是什么？ Kyuki，是什么？"}, {"type": "subtitle", "time": 14979.99, "timestamp": "04:09:39", "text": "你的角色是什么？嗯？"}, {"type": "subtitle", "time": 14981.429, "timestamp": "04:09:41", "text": "我得让你们好好想想。"}, {"type": "subtitle", "time": 14988.309, "timestamp": "04:09:48", "text": "她不想告诉我我是"}, {"type": "subtitle", "time": 14990.79, "timestamp": "04:09:50", "text": "因为我们目睹了杀戮过程，所以举报了她。"}, {"type": "subtitle", "time": 14994.07, "timestamp": "04:09:54", "text": "她是个杀手。但即便我们拥有"}]
[{"type": "subtitle", "time": 16800.39, "timestamp": "04:40:00", "text": "你会用它来对付我。"}, {"type": "subtitle", "time": 16802.788, "timestamp": "04:40:02", "text": "你会用到它的"}, {"type": "subtitle", "time": 16805.35, "timestamp": "04:40:05", "text": "反对我。这个叫Dragonosa的家伙"}, {"type": "subtitle", "time": 16808.708, "timestamp": "04:40:08", "text": "让我承认自己是冒名顶替者。"}, {"type": "subtitle", "time": 16810.868, "timestamp": "04:40:10", "text": "我们不知道这只鸽子是否已经死了。"}, {"type": "subtitle", "time": 16812.788, "timestamp": "04:40:12", "text": "或不。"}, {"type": "subtitle", "time": 16816.948, "timestamp": "04:40:16", "text": "什么？为什么？我什么都没做。你"}, {"type": "subtitle", "time": 16819.75, "timestamp": "04:40:19", "text": "你别让我成为他们中的一员。"}, {"type": "subtitle", "time": 16822.15, "timestamp": "04:40:22", "text": "因为他不在我们身边。不是"}, {"type": "subtitle", "time": 16824.31, "timestamp": "04:40:24", "text": "和我们一起。我亲眼看到他进去的。"}, {"type": "subtitle", "time": 16825.99, "timestamp": "04:40:25", "text": "那个方向。我可不是在开玩笑。"}, {"type": "subtitle", "time": 16828.55, "timestamp": "04:40:28", "text": "而我，仅仅在那个人身上，就看到了某种东西。"}, {"type": "subtitle", "time": 16831.27, "timestamp": "04:40:31", "text": "向下。他要倒下了。你如何"}, {"type": "subtitle", "time": 16834.15, "timestamp": "04:40:34", "text": "好的。"}, {"type": "subtitle", "time": 16835.03, "timestamp": "04:40:35", "text": "我要打电话"}, {"type": "subtitle", "time": 16837.51, "timestamp": "04:40:37", "text": "鸽子聚会。"}, {"type": "subtitle", "time": 16838.708, "timestamp": "04:40:38", "text": "好了各位，我要打电话了……"}, {"type": "subtitle", "time": 16842.31, "timestamp": "04:40:42", "text": "紧急会议。一只鸽子和"}, {"type": "subtitle", "time": 16844.948, "timestamp": "04:40:44", "text": "每次见面，鸽子都有进步"}, {"type": "subtitle", "time": 16848.15, "timestamp": "04:40:48", "text": "完全迷路了。是的。是的。去。"}, {"type": "subtitle", "time": 16851.11, "timestamp": "04:40:51", "text": "等等，还有鹅和鸽子。但是就像"}, {"type": "subtitle", "time": 16854.31, "timestamp": "04:40:54", "text": "晚上做不了。这是什么？"}, {"type": "subtitle", "time": 16855.91, "timestamp": "04:40:55", "text": "就住这儿吧。就住这儿吧。"}, {"type": "subtitle", "time": 16857.51, "timestamp": "04:40:57", "text": "Yoshi，看着我。 Yoshi，看着我。"}, {"type": "subtitle", "time": 16859.99, "timestamp": "04:40:59", "text": "耀西，耀西，走吧。 Yoshi，我可以信任你吗？"}]
[{"type": "subtitle", "time": 7688.709, "timestamp": "02:08:08", "text": "[音乐]"}, {"type": "subtitle", "time": 7692.95, "timestamp": "02:08:12", "text": "我的天啊，他们打败了boss。不"}, {"type": "subtitle", "time": 7700.3, "timestamp": "02:08:20", "text": "方式。 NPC们都很好。"}, {"type": "subtitle", "time": 7701.589, "timestamp": "02:08:21", "text": "[音乐]"}, {"type": "subtitle", "time": 7703.75, "timestamp": "02:08:23", "text": "决不。"}, {"type": "subtitle", "time": 7706.229, "timestamp": "02:08:26", "text": "但那边还有一个。但"}, {"type": "subtitle", "time": 7714.79, "timestamp": "02:08:34", "text": "NPC 的水平完全不同。"}, {"type": "subtitle", "time": 7721.99, "timestamp": "02:08:41", "text": "毫不犹豫。"}, {"type": "subtitle", "time": 7724.149, "timestamp": "02:08:44", "text": "与声音融为一体。"}, {"type": "subtitle", "time": 7726.709, "timestamp": "02:08:46", "text": "共鸣时刻。"}, {"type": "subtitle", "time": 7728.79, "timestamp": "02:08:48", "text": "引导我的刀刃。"}, {"type": "subtitle", "time": 7733.99, "timestamp": "02:08:53", "text": "上摆。"}]
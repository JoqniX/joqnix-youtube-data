[{"type": "subtitle", "time": 1621.029, "timestamp": "00:27:01", "text": "我已经想好了。"}, {"type": "subtitle", "time": 1623.59, "timestamp": "00:27:03", "text": "那只反抗的黑羊"}, {"type": "subtitle", "time": 1626.63, "timestamp": "00:27:06", "text": "规则。那些屈服于……的白羊"}, {"type": "subtitle", "time": 1629.35, "timestamp": "00:27:09", "text": "他们的贪婪。天真无邪的少女们"}, {"type": "subtitle", "time": 1632.149, "timestamp": "00:27:12", "text": "被牺牲了。而那些村民却……"}, {"type": "subtitle", "time": 1635.029, "timestamp": "00:27:15", "text": "他们互相残杀，陷入了无情的疯狂之中。"}, {"type": "subtitle", "time": 1642.07, "timestamp": "00:27:22", "text": "牧羊人所要做的就是执行"}, {"type": "subtitle", "time": 1645.269, "timestamp": "00:27:25", "text": "叛逆者。他就是这样留住羊群的。"}, {"type": "subtitle", "time": 1648.149, "timestamp": "00:27:28", "text": "受到控制并维持现状。"}, {"type": "subtitle", "time": 1651.75, "timestamp": "00:27:31", "text": "这就是你成为答案的原因吗？不，"}, {"type": "subtitle", "time": 1654.39, "timestamp": "00:27:34", "text": "差远了。"}, {"type": "subtitle", "time": 1658.71, "timestamp": "00:27:38", "text": "我从来就不是牧羊人。永远不会。"}, {"type": "subtitle", "time": 1664.149, "timestamp": "00:27:44", "text": "你和我，我们就是那只黑羊。"}, {"type": "subtitle", "time": 1667.269, "timestamp": "00:27:47", "text": "谁违反了规则？"}, {"type": "subtitle", "time": 1676.549, "timestamp": "00:27:56", "text": "有趣的。路虎。"}]
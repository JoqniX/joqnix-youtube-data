[{"type": "subtitle", "time": 6361.27, "timestamp": "01:46:01", "text": "第一的，"}, {"type": "subtitle", "time": 6362.709, "timestamp": "01:46:02", "text": "你觉得这款游戏目前为止怎么样？它是"}, {"type": "subtitle", "time": 6364.95, "timestamp": "01:46:04", "text": "好的。真的很好。我很喜欢它"}, {"type": "subtitle", "time": 6367.75, "timestamp": "01:46:07", "text": "你的意思是，我们赶紧结束这件事吧。我得到了"}, {"type": "subtitle", "time": 6372.39, "timestamp": "01:46:12", "text": "使用后获得的红发老婆魅力。我"}, {"type": "subtitle", "time": 6375.59, "timestamp": "01:46:15", "text": "抓到她了。我很高兴。"}, {"type": "subtitle", "time": 6379.51, "timestamp": "01:46:19", "text": "我需要一位能帮我照顾这位五星级女士的储蓄者。"}, {"type": "subtitle", "time": 6381.27, "timestamp": "01:46:21", "text": "所以，我不会支持这个。"}, {"type": "subtitle", "time": 6383.53, "timestamp": "01:46:23", "text": "横幅。"}, {"type": "subtitle", "time": 6385.59, "timestamp": "01:46:25", "text": "[音乐]"}, {"type": "subtitle", "time": 6387.27, "timestamp": "01:46:27", "text": "好的。我要去哪里？好的。这是"}, {"type": "subtitle", "time": 6394.95, "timestamp": "01:46:34", "text": "这是什么？我的天啊。谜。我讨厌"}, {"type": "subtitle", "time": 6401.669, "timestamp": "01:46:41", "text": "它。另外，如何是如何是"}, {"type": "subtitle", "time": 6406.07, "timestamp": "01:46:46", "text": "你觉得这场比赛目前为止怎么样？"}]
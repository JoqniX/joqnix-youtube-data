[{"type": "subtitle", "time": 4564.79, "timestamp": "01:16:04", "text": "H."}, {"type": "subtitle", "time": 4590.63, "timestamp": "01:16:30", "text": "哦，你割草。我来找你了。来"}, {"type": "subtitle", "time": 4593.35, "timestamp": "01:16:33", "text": "这里。过来。过来。过来。"}, {"type": "subtitle", "time": 4597.11, "timestamp": "01:16:37", "text": "别走。不。不。"}, {"type": "subtitle", "time": 4604.87, "timestamp": "01:16:44", "text": "哇。"}]
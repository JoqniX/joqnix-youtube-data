[{"type": "subtitle", "time": 2371.81, "timestamp": "00:39:31", "text": "你看，水位下降了。"}, {"type": "subtitle", "time": 2392.79, "timestamp": "00:39:52", "text": "我简直不敢相信。这里有这么大的一个地方"}, {"type": "subtitle", "time": 2396.47, "timestamp": "00:39:56", "text": "从这里打开。上帝，"}, {"type": "subtitle", "time": 2398.71, "timestamp": "00:39:58", "text": "这个地方本应被浸泡过"}]
[{"type": "subtitle", "time": 14400.87, "timestamp": "04:00:00", "text": "RXR。"}, {"type": "subtitle", "time": 14403.349, "timestamp": "04:00:03", "text": "RXR，生日快乐。生日快乐，"}, {"type": "subtitle", "time": 14410.07, "timestamp": "04:00:10", "text": "RXR。好好享受他吧。你为什么……"}, {"type": "subtitle", "time": 14411.59, "timestamp": "04:00:11", "text": "总是"}, {"type": "subtitle", "time": 14413.51, "timestamp": "04:00:13", "text": "看见我了吗？这样做毫无意义。你为什么会这样？"}, {"type": "subtitle", "time": 14415.51, "timestamp": "04:00:15", "text": "你敢这样对我？"}, {"type": "subtitle", "time": 14418.309, "timestamp": "04:00:18", "text": "公众舆论长期存在。"}, {"type": "subtitle", "time": 14426.389, "timestamp": "04:00:26", "text": "允许意外发生。"}, {"type": "subtitle", "time": 14430.229, "timestamp": "04:00:30", "text": "这是什么？我该杀了这只鸟吗？"}, {"type": "subtitle", "time": 14437.189, "timestamp": "04:00:37", "text": "矿"}, {"type": "subtitle", "time": 14439.03, "timestamp": "04:00:39", "text": "就在附近。"}]
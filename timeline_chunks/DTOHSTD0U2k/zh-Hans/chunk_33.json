[{"type": "subtitle", "time": 1983.19, "timestamp": "00:33:03", "text": "我的天啊。"}, {"type": "subtitle", "time": 2006.789, "timestamp": "00:33:26", "text": "我打破了疤面煞星的幻想，他本应该……"}, {"type": "subtitle", "time": 2010.47, "timestamp": "00:33:30", "text": "他受了伤。应该"}, {"type": "subtitle", "time": 2014.23, "timestamp": "00:33:34", "text": "感谢你对我施以怜悯？停留"}, {"type": "subtitle", "time": 2027.19, "timestamp": "00:33:47", "text": "这是谁？"}, {"type": "subtitle", "time": 2030.789, "timestamp": "00:33:50", "text": "这不是红百合花吗？"}, {"type": "subtitle", "time": 2032.789, "timestamp": "00:33:52", "text": "你不是答应过要给我留点东西吗？"}, {"type": "subtitle", "time": 2037.029, "timestamp": "00:33:57", "text": "和 Rover 单独相处的时间？"}, {"type": "subtitle", "time": 2039.59, "timestamp": "00:33:59", "text": "但有一个条件。我希望你"}]
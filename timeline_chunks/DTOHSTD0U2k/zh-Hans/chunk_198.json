[{"type": "subtitle", "time": 11880.87, "timestamp": "03:18:00", "text": "嘿。嘿，杰基。你好吗？哦，我的"}, {"type": "subtitle", "time": 11884.55, "timestamp": "03:18:04", "text": "上帝。惊人的。惊人的。我没事。我太"}, {"type": "subtitle", "time": 11892.95, "timestamp": "03:18:12", "text": "继续前进。继续前进。等待。"}, {"type": "subtitle", "time": 11903.59, "timestamp": "03:18:23", "text": "这些路径看起来好复杂。我"}, {"type": "subtitle", "time": 11905.91, "timestamp": "03:18:25", "text": "完全没有头绪。哦，尸体。哦，还有"}, {"type": "subtitle", "time": 11909.91, "timestamp": "03:18:29", "text": "一具尸体。哦，什么？我发现了一具尸体"}, {"type": "subtitle", "time": 11911.51, "timestamp": "03:18:31", "text": "身体。"}, {"type": "subtitle", "time": 11915.11, "timestamp": "03:18:35", "text": "在哪里？当然，这是一部电影。哦，我的"}, {"type": "subtitle", "time": 11917.99, "timestamp": "03:18:37", "text": "上帝。我的天啊。好的。有人吗？"}, {"type": "subtitle", "time": 11919.91, "timestamp": "03:18:39", "text": "有什么想法吗？因为我刚刚上去了。好的。"}, {"type": "subtitle", "time": 11921.11, "timestamp": "03:18:41", "text": "当然。当然。你去了哪里？"}, {"type": "subtitle", "time": 11924.55, "timestamp": "03:18:44", "text": "寻找？我的意思是，我当时在帮忙……"}, {"type": "subtitle", "time": 11927.99, "timestamp": "03:18:47", "text": "任务，我只能看到身体上的情况。但"}, {"type": "subtitle", "time": 11936.79, "timestamp": "03:18:56", "text": "我有不在场证明。我有不在场证明。正确的。"}, {"type": "subtitle", "time": 11939.59, "timestamp": "03:18:59", "text": "我路过 Jocknik，然后我又路过"}]
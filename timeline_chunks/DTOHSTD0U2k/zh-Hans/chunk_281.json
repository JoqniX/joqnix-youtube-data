[{"type": "subtitle", "time": 16863.67, "timestamp": "04:41:03", "text": "你？对不起。走，走。"}, {"type": "subtitle", "time": 16870.948, "timestamp": "04:41:10", "text": "[音乐]"}, {"type": "subtitle", "time": 16875.03, "timestamp": "04:41:15", "text": "好的。所以，基本上我们是在教堂里"}, {"type": "subtitle", "time": 16877.03, "timestamp": "04:41:17", "text": "紧急会议地点"}, {"type": "subtitle", "time": 16879.11, "timestamp": "04:41:19", "text": "按钮是，Yoshi 会被杀死在前面"}, {"type": "subtitle", "time": 16884.39, "timestamp": "04:41:24", "text": "那是因为我是警长，我为什么"}, {"type": "subtitle", "time": 16888.39, "timestamp": "04:41:28", "text": "然后？因为一个坏人。为什么？我们为何如此"}, {"type": "subtitle", "time": 16891.19, "timestamp": "04:41:31", "text": "没赢？"}, {"type": "subtitle", "time": 16894.948, "timestamp": "04:41:34", "text": "她为什么没死？为什么是"}, {"type": "subtitle", "time": 16897.43, "timestamp": "04:41:37", "text": "RXR在哪儿？不，我们没有看到RXR。"}, {"type": "subtitle", "time": 16900.47, "timestamp": "04:41:40", "text": "冒名顶替者。是的，我们又看到一个。"}, {"type": "subtitle", "time": 16904.948, "timestamp": "04:41:44", "text": "事情完全是这样的。伙计们，是的，RX"}, {"type": "subtitle", "time": 16906.39, "timestamp": "04:41:46", "text": "他完全在右边"}, {"type": "subtitle", "time": 16908.55, "timestamp": "04:41:48", "text": "教堂的侧门，他就在那里。"}, {"type": "subtitle", "time": 16909.91, "timestamp": "04:41:49", "text": "他告诉我他正在执行任务。我不"}, {"type": "subtitle", "time": 16911.35, "timestamp": "04:41:51", "text": "我认为那里有个任务。不，不，不。"}, {"type": "subtitle", "time": 16913.43, "timestamp": "04:41:53", "text": "他总是像个团队里的成员一样。"}, {"type": "subtitle", "time": 16915.59, "timestamp": "04:41:55", "text": "一直都在这个群体里，但依然是对的"}]
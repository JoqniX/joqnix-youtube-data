[{"type": "subtitle", "time": 15664.389, "timestamp": "04:21:04", "text": "我的天啊。乐趣。我们不知道那是什么"}, {"type": "subtitle", "time": 15677.429, "timestamp": "04:21:17", "text": "[音乐]"}, {"type": "subtitle", "time": 15681.51, "timestamp": "04:21:21", "text": "看看是谁拍了谁拍的"}, {"type": "subtitle", "time": 15684.389, "timestamp": "04:21:24", "text": "哦，你好。该死。我会死吗？"}, {"type": "subtitle", "time": 15692.87, "timestamp": "04:21:32", "text": "你好。你们是吗？"}, {"type": "subtitle", "time": 15696.309, "timestamp": "04:21:36", "text": "等等。嗯，我们这里有一些东西。"}, {"type": "subtitle", "time": 15701.59, "timestamp": "04:21:41", "text": "你想结盟吗？看着我。呃，"}, {"type": "subtitle", "time": 15704.149, "timestamp": "04:21:44", "text": "就是"}, {"type": "subtitle", "time": 15715.99, "timestamp": "04:21:55", "text": "冷静下来。吉。"}, {"type": "subtitle", "time": 15718.389, "timestamp": "04:21:58", "text": "好的，我们有"}, {"type": "subtitle", "time": 15719.99, "timestamp": "04:21:59", "text": "请给我时间发言。你好。给我"}]
[{"type": "subtitle", "time": 16323.51, "timestamp": "04:32:03", "text": "可以继续。我也想看看我自己。"}, {"type": "subtitle", "time": 16326.55, "timestamp": "04:32:06", "text": "我的意思是，这只是我第一次赢。"}, {"type": "subtitle", "time": 16344.71, "timestamp": "04:32:24", "text": "你好，医生。你好。"}, {"type": "subtitle", "time": 16352.55, "timestamp": "04:32:32", "text": "真是太奇怪了。"}, {"type": "subtitle", "time": 16356.469, "timestamp": "04:32:36", "text": "哦，我这里有个任务。"}, {"type": "subtitle", "time": 16366.63, "timestamp": "04:32:46", "text": "抓住他。是的。我要抓住他。我是"}, {"type": "subtitle", "time": 16369.269, "timestamp": "04:32:49", "text": "抓住他。发生了什么？不，不，不。"}, {"type": "subtitle", "time": 16370.469, "timestamp": "04:32:50", "text": "这里。这个。好了。那里我们"}, {"type": "subtitle", "time": 16372.149, "timestamp": "04:32:52", "text": "去。好了。好的。他们是"}, {"type": "subtitle", "time": 16373.269, "timestamp": "04:32:53", "text": "已感染。他们被感染了。他们是"}, {"type": "subtitle", "time": 16375.51, "timestamp": "04:32:55", "text": "已感染。"}, {"type": "subtitle", "time": 16376.87, "timestamp": "04:32:56", "text": "下一个。下一个。下一个。骑师。"}, {"type": "subtitle", "time": 16379.83, "timestamp": "04:32:59", "text": "过来，骑师。你是什​​么意思？"}]
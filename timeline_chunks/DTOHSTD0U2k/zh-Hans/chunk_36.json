[{"type": "subtitle", "time": 2160.71, "timestamp": "00:36:00", "text": "知道发生了什么事吗？"}, {"type": "subtitle", "time": 2163.75, "timestamp": "00:36:03", "text": "如果他真是那样呢？似乎所有的"}, {"type": "subtitle", "time": 2166.39, "timestamp": "00:36:06", "text": "蒂村的悲剧与"}, {"type": "subtitle", "time": 2176.069, "timestamp": "00:36:16", "text": "根据真实生活编造故事"}, {"type": "subtitle", "time": 2179.109, "timestamp": "00:36:19", "text": "支持他那些扭曲的信仰。确实如此。"}, {"type": "subtitle", "time": 2181.19, "timestamp": "00:36:21", "text": "听起来像是他会做的事。我们"}, {"type": "subtitle", "time": 2184.15, "timestamp": "00:36:24", "text": "不能把他的话当真。现在"}, {"type": "subtitle", "time": 2186.23, "timestamp": "00:36:26", "text": "我们必须找到仪式发生的地点。"}, {"type": "subtitle", "time": 2197.91, "timestamp": "00:36:37", "text": "那是什么？是冰川冰之类的东西，"}, {"type": "subtitle", "time": 2202.39, "timestamp": "00:36:42", "text": "摔倒了。有人在监视。"}, {"type": "subtitle", "time": 2204.71, "timestamp": "00:36:44", "text": "两种不同的酸度频率"}, {"type": "subtitle", "time": 2209.03, "timestamp": "00:36:49", "text": "不和谐。我懂了。我能感觉到。"}, {"type": "subtitle", "time": 2214.55, "timestamp": "00:36:54", "text": "那边有溪流。跟我来。在"}]
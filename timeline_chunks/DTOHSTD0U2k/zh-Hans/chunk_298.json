[{"type": "subtitle", "time": 17884.39, "timestamp": "04:58:04", "text": "你真是个小霸王。寿司。"}, {"type": "subtitle", "time": 17886.708, "timestamp": "04:58:06", "text": "好的。我有个问题。我是什么？"}, {"type": "subtitle", "time": 17889.03, "timestamp": "04:58:09", "text": "男人。我不能当个任性的人。我只是个"}, {"type": "subtitle", "time": 17890.708, "timestamp": "04:58:10", "text": "真是个混蛋。如果你，如果我投票反对"}, {"type": "subtitle", "time": 17893.11, "timestamp": "04:58:13", "text": "做"}, {"type": "subtitle", "time": 17895.59, "timestamp": "04:58:15", "text": "目的是争取选票。"}, {"type": "subtitle", "time": 17897.43, "timestamp": "04:58:17", "text": "你的任务就是被选下台。然后你"}, {"type": "subtitle", "time": 17899.67, "timestamp": "04:58:19", "text": "再次获胜。投票反对。是的。然后"}, {"type": "subtitle", "time": 17902.39, "timestamp": "04:58:22", "text": "是的。看"}, {"type": "subtitle", "time": 17903.99, "timestamp": "04:58:23", "text": "有用。它有效，对吧？我们清除每个"}, {"type": "subtitle", "time": 17905.75, "timestamp": "04:58:25", "text": "另一个选项，因为这意味着我们俩都不行。"}, {"type": "subtitle", "time": 17907.99, "timestamp": "04:58:27", "text": "我们当时就在那里。持有者想说"}, {"type": "subtitle", "time": 17910.23, "timestamp": "04:58:30", "text": "某物。我在努力听她说话。什么？"}, {"type": "subtitle", "time": 17912.15, "timestamp": "04:58:32", "text": "我当时在问什么是嘟嘟鸭"}, {"type": "subtitle", "time": 17914.15, "timestamp": "04:58:34", "text": "尽管？但很多回答都像这样，我真是太……"}, {"type": "subtitle", "time": 17916.788, "timestamp": "04:58:36", "text": "使困惑。我所拥有的一切。"}, {"type": "subtitle", "time": 17919.27, "timestamp": "04:58:39", "text": "所以多萝扮演的是个冒名顶替者。如果他们"}, {"type": "subtitle", "time": 17920.948, "timestamp": "04:58:40", "text": "被投票淘汰，他们就赢了。他们这是一个"}, {"type": "subtitle", "time": 17922.55, "timestamp": "04:58:42", "text": "如果他们被投票淘汰，就直接获胜。所以"}, {"type": "subtitle", "time": 17927.03, "timestamp": "04:58:47", "text": "他们需要扮演冒名顶替者的角色。所以你"}, {"type": "subtitle", "time": 17928.948, "timestamp": "04:58:48", "text": "实际上，这样做是为了玩弄心智。"}, {"type": "subtitle", "time": 17932.948, "timestamp": "04:58:52", "text": "游戏由你来玩。是的。是啊，我的意思是"}, {"type": "subtitle", "time": 17934.708, "timestamp": "04:58:54", "text": "我和拖拽。它是中立的之一。"}, {"type": "subtitle", "time": 17936.708, "timestamp": "04:58:56", "text": "游戏。诚实地，"}, {"type": "subtitle", "time": 17938.47, "timestamp": "04:58:58", "text": "兄弟，你知道吗？我们携带了那件物品"}]
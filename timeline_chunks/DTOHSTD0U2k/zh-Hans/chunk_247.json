[{"type": "subtitle", "time": 14822.309, "timestamp": "04:07:02", "text": "伙计们，这是我们的口号。我要去"}, {"type": "subtitle", "time": 14834.07, "timestamp": "04:07:14", "text": "再次。什么是随机的？"}, {"type": "subtitle", "time": 14836.71, "timestamp": "04:07:16", "text": "你确定吗？不。等等，什么？哦，"}, {"type": "subtitle", "time": 14841.429, "timestamp": "04:07:21", "text": "拆除那个路"}, {"type": "subtitle", "time": 14843.59, "timestamp": "04:07:23", "text": "把书扔给我，这样我就可以杀人了"}, {"type": "subtitle", "time": 14845.269, "timestamp": "04:07:25", "text": "某人。"}, {"type": "subtitle", "time": 14847.75, "timestamp": "04:07:27", "text": "什么？哦，拜托。三名杀手。来"}, {"type": "subtitle", "time": 14850.469, "timestamp": "04:07:30", "text": "在。"}, {"type": "subtitle", "time": 14854.15, "timestamp": "04:07:34", "text": "四、我的天啊。我的天啊。"}]
[{"type": "subtitle", "time": 847.189, "timestamp": "00:14:07", "text": "嗯？我觉得这是个聪明的举动，但我并不这么认为。"}, {"type": "subtitle", "time": 848.47, "timestamp": "00:14:08", "text": "告诉你。你不想"}, {"type": "subtitle", "time": 852.629, "timestamp": "00:14:12", "text": "这么快就让我失望了。罗，我看到你"}, {"type": "subtitle", "time": 855.75, "timestamp": "00:14:15", "text": "它。现在就出手，撕碎它。毕竟"}, {"type": "subtitle", "time": 858.31, "timestamp": "00:14:18", "text": "付出努力了吗？你真的想放弃吗？"}, {"type": "subtitle", "time": 867.99, "timestamp": "00:14:27", "text": "[音乐]"}, {"type": "subtitle", "time": 878.15, "timestamp": "00:14:38", "text": "雷班手里拿着一张纸条。每个"}, {"type": "subtitle", "time": 897.509, "timestamp": "00:14:57", "text": "有一天，一位牧羊人来到村子里。"}]
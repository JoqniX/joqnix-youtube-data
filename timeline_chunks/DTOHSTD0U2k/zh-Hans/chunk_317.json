[{"type": "subtitle", "time": 19023.67, "timestamp": "05:17:03", "text": "那个东西。"}, {"type": "subtitle", "time": 19026.868, "timestamp": "05:17:06", "text": "我一直都和他们在一起。"}, {"type": "subtitle", "time": 19029.75, "timestamp": "05:17:09", "text": "哦，就像不，你当时就像在什么"}, {"type": "subtitle", "time": 19031.43, "timestamp": "05:17:11", "text": "你所在的地图区域是哪一部分？在最后。"}, {"type": "subtitle", "time": 19033.43, "timestamp": "05:17:13", "text": "哦，呃，就在小教堂左侧附近，那里"}, {"type": "subtitle", "time": 19035.59, "timestamp": "05:17:15", "text": "西红柿是。是的。好的。好的。好的。"}, {"type": "subtitle", "time": 19036.48, "timestamp": "05:17:16", "text": "好的。 我的意思是，公平地说，如果他们是"}, {"type": "subtitle", "time": 19038.08, "timestamp": "05:17:18", "text": "我的意思是，公平地说，如果他们是 凶手，他们可能喜欢……"}, {"type": "subtitle", "time": 19041.52, "timestamp": "05:17:21", "text": "凶手，他们可能喜欢…… 合作。哦，那永远不会发生"}, {"type": "subtitle", "time": 19043.52, "timestamp": "05:17:23", "text": "合作。哦，那永远不会发生 他妈的发生，"}, {"type": "subtitle", "time": 19045.36, "timestamp": "05:17:25", "text": "他妈的发生， 正确的？为什么？除了射击之外"}, {"type": "subtitle", "time": 19047.44, "timestamp": "05:17:27", "text": "正确的？为什么？除了射击之外 射龙。"}, {"type": "subtitle", "time": 19050.08, "timestamp": "05:17:30", "text": "射龙。 射击。"}, {"type": "subtitle", "time": 19057.59, "timestamp": "05:17:37", "text": "大家都安全。等等，我们没有。"}, {"type": "subtitle", "time": 19079.27, "timestamp": "05:17:59", "text": "我不在乎。我不是Yoshi。我是"}]
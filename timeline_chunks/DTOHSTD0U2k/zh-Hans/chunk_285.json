[{"type": "subtitle", "time": 17101.59, "timestamp": "04:45:01", "text": "硬木地板又回来了。是的。我们走吧。"}, {"type": "subtitle", "time": 17103.43, "timestamp": "04:45:03", "text": "你们要去，你们要去"}, {"type": "subtitle", "time": 17105.99, "timestamp": "04:45:05", "text": "还会直播一段时间吧？祖米。"}, {"type": "subtitle", "time": 17108.628, "timestamp": "04:45:08", "text": "是的。是的。我要去……"}, {"type": "subtitle", "time": 17111.91, "timestamp": "04:45:11", "text": "吃完晚饭，尽量早点回来，因为……"}, {"type": "subtitle", "time": 17113.75, "timestamp": "04:45:13", "text": "晚上没有电。"}, {"type": "subtitle", "time": 17115.75, "timestamp": "04:45:15", "text": "所以，我还没做晚饭。啊，那是"}, {"type": "subtitle", "time": 17118.39, "timestamp": "04:45:18", "text": "伤心。好的。当然。这就是我的原因"}, {"type": "subtitle", "time": 17121.27, "timestamp": "04:45:21", "text": "流媒体播放效果不佳。很快回来。"}, {"type": "subtitle", "time": 17123.35, "timestamp": "04:45:23", "text": "保重，兄弟。嗯，保重。"}, {"type": "subtitle", "time": 17127.27, "timestamp": "04:45:27", "text": "希望问题能得到解决。再见。再见。"}, {"type": "subtitle", "time": 17128.798, "timestamp": "04:45:28", "text": "再见。 我希望你能得到免费的钱。"}, {"type": "subtitle", "time": 17132.4, "timestamp": "04:45:32", "text": "我希望你能得到免费的钱。 再见。"}, {"type": "subtitle", "time": 17143.19, "timestamp": "04:45:43", "text": "所以，其他人都愿意继续玩下去。"}, {"type": "subtitle", "time": 17146.07, "timestamp": "04:45:46", "text": "好了，我做完了。我受够了。好的，"}, {"type": "subtitle", "time": 17149.43, "timestamp": "04:45:49", "text": "我们走吧。哦，等等。"}, {"type": "subtitle", "time": 17153.27, "timestamp": "04:45:53", "text": "我愿意与更多人一起参与。"}]
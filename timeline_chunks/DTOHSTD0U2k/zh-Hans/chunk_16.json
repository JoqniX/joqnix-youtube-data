[{"type": "subtitle", "time": 964.389, "timestamp": "00:16:04", "text": "我们已经达成一致了吗？是的你是对的。"}, {"type": "subtitle", "time": 967.749, "timestamp": "00:16:07", "text": "11岁以上的人居住的地方，我们的生活远未达到我们的预期。"}, {"type": "subtitle", "time": 969.269, "timestamp": "00:16:09", "text": "理想。"}, {"type": "subtitle", "time": 972.23, "timestamp": "00:16:12", "text": "牧羊人依然掌权，羔羊们……"}, {"type": "subtitle", "time": 975.35, "timestamp": "00:16:15", "text": "变得自满。这取决于……"}, {"type": "subtitle", "time": 979.829, "timestamp": "00:16:19", "text": "我们两人携手，将那个世界变为现实。"}, {"type": "subtitle", "time": 1010.31, "timestamp": "00:16:50", "text": "好的。还有，呃，让我呃拿一下"}, {"type": "subtitle", "time": 1013.749, "timestamp": "00:16:53", "text": "做点什么，然后回来。无尽的篝火"}, {"type": "subtitle", "time": 1017.43, "timestamp": "00:16:57", "text": "每晚都庆祝他们的新神。"}]
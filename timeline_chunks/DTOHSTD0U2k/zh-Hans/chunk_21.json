[{"type": "subtitle", "time": 1262.149, "timestamp": "00:21:02", "text": "羔羊们做到了吗？啊，那些显而易见的羔羊。"}, {"type": "subtitle", "time": 1264.63, "timestamp": "00:21:04", "text": "他们丝毫没有意识到最可怕的事情"}, {"type": "subtitle", "time": 1268.789, "timestamp": "00:21:08", "text": "恶魔就在他们眼皮底下。"}, {"type": "subtitle", "time": 1271.59, "timestamp": "00:21:11", "text": "男人。"}, {"type": "subtitle", "time": 1286.71, "timestamp": "00:21:26", "text": "黑暗的故事。干得好。你没有"}, {"type": "subtitle", "time": 1290.07, "timestamp": "00:21:30", "text": "别让任何细节泄露出来。"}, {"type": "subtitle", "time": 1293.11, "timestamp": "00:21:33", "text": "现在，我想知道你从中得到了什么启发"}, {"type": "subtitle", "time": 1295.51, "timestamp": "00:21:35", "text": "这个故事？"}, {"type": "subtitle", "time": 1297.83, "timestamp": "00:21:37", "text": "回答我，我就会揭露真相。"}, {"type": "subtitle", "time": 1300.549, "timestamp": "00:21:40", "text": "发生了什么。"}, {"type": "chat", "time": 1301.981, "timestamp": "00:21:41", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Shhh... TheRealRaitoPlayz, Joq is resting. 🌙 Welcome to the Guild, and enjoy the past joq's memories!"}, {"type": "subtitle", "time": 1303.43, "timestamp": "00:21:43", "text": "好的。真正的幕后黑手是谁？"}, {"type": "subtitle", "time": 1311.99, "timestamp": "00:21:51", "text": "H"}, {"type": "subtitle", "time": 1315.59, "timestamp": "00:21:55", "text": "牧羊人。事实上，直接的罪魁祸首"}, {"type": "subtitle", "time": 1318.149, "timestamp": "00:21:58", "text": "是牧羊人。"}]
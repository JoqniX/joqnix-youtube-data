[{"type": "subtitle", "time": 17940.07, "timestamp": "04:59:00", "text": "游戏。我们让您操作起来非常方便"}, {"type": "subtitle", "time": 17944.15, "timestamp": "04:59:04", "text": "兄弟，查清楚是谁干的。"}, {"type": "subtitle", "time": 17946.07, "timestamp": "04:59:06", "text": "我们当时只是在精简人员。"}, {"type": "subtitle", "time": 17949.03, "timestamp": "04:59:09", "text": "数字。你看，你这是在窃取我的功劳。"}, {"type": "subtitle", "time": 17951.59, "timestamp": "04:59:11", "text": "你窃取了我的功劳。不，不，我们"}, {"type": "subtitle", "time": 17953.75, "timestamp": "04:59:13", "text": "不是。说实话，我们只是减少了一些人。"}, {"type": "subtitle", "time": 17955.27, "timestamp": "04:59:15", "text": "以下是相关数据。我们只是在帮忙。"}, {"type": "subtitle", "time": 17957.27, "timestamp": "04:59:17", "text": "你。我们并非居功。不，你是"}, {"type": "subtitle", "time": 17959.35, "timestamp": "04:59:19", "text": "这使得冒名顶替者更容易得逞。"}, {"type": "subtitle", "time": 17961.11, "timestamp": "04:59:21", "text": "正确的。所以，我们喜欢“不，不”。我正在制作"}, {"type": "subtitle", "time": 17965.43, "timestamp": "04:59:25", "text": "这样对你来说更方便。只有"}, {"type": "subtitle", "time": 17968.23, "timestamp": "04:59:28", "text": "这让我更难了。如果你是"}, {"type": "subtitle", "time": 17970.07, "timestamp": "04:59:30", "text": "如果你扮演的是一个好角色，那就太好了。"}, {"type": "subtitle", "time": 17973.27, "timestamp": "04:59:33", "text": "警长或侦探，或者为我做这件事。"}, {"type": "subtitle", "time": 17976.15, "timestamp": "04:59:36", "text": "你们都是蠢货。你真是个笨蛋。关闭"}, {"type": "subtitle", "time": 17978.788, "timestamp": "04:59:38", "text": "向上。"}, {"type": "subtitle", "time": 17981.35, "timestamp": "04:59:41", "text": "你说了那个N开头的词。无效点。它"}, {"type": "subtitle", "time": 17986.23, "timestamp": "04:59:46", "text": "是那个n开头的词。哦，拜托。不。ka"}, {"type": "subtitle", "time": 17988.15, "timestamp": "04:59:48", "text": "是一个松饼。"}, {"type": "subtitle", "time": 17991.91, "timestamp": "04:59:51", "text": "妈的。还有一头猪。"}]
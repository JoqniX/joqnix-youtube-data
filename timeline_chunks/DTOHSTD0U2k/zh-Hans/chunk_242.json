[{"type": "subtitle", "time": 14520.71, "timestamp": "04:02:00", "text": "我的天啊。"}, {"type": "subtitle", "time": 14525.349, "timestamp": "04:02:05", "text": "他正在屠杀所有人。我的天啊。"}, {"type": "subtitle", "time": 14529.51, "timestamp": "04:02:09", "text": "他正在大杀四方。他在杀人。"}, {"type": "subtitle", "time": 14531.11, "timestamp": "04:02:11", "text": "等一下。大家都在直播吗？"}, {"type": "subtitle", "time": 14535.11, "timestamp": "04:02:15", "text": "现在？是的。不，我也这么认为。"}, {"type": "subtitle", "time": 14538.309, "timestamp": "04:02:18", "text": "特伦，呃，寿司，"}, {"type": "subtitle", "time": 14542.95, "timestamp": "04:02:22", "text": "呃，然后是墙。嗯，氧气。氧。然后"}, {"type": "subtitle", "time": 14545.59, "timestamp": "04:02:25", "text": "墙。"}, {"type": "subtitle", "time": 14549.429, "timestamp": "04:02:29", "text": "哦，我找到我的尸体了。我、Yoshi 和 Oxy"}, {"type": "subtitle", "time": 14552.71, "timestamp": "04:02:32", "text": "他们在一起。我们刚刚输入了以下内容"}, {"type": "subtitle", "time": 14556.63, "timestamp": "04:02:36", "text": "镇公园。我们一起看到了尸体。是的。"}, {"type": "subtitle", "time": 14558.309, "timestamp": "04:02:38", "text": "是的，确实如此。大家都在哪儿？"}, {"type": "subtitle", "time": 14560.469, "timestamp": "04:02:40", "text": "人都去哪儿了？等等，等等，等等。"}, {"type": "subtitle", "time": 14562.229, "timestamp": "04:02:42", "text": "等待。坚持，稍等。不，不，不，不。在哪里？"}, {"type": "subtitle", "time": 14564.07, "timestamp": "04:02:44", "text": "每个人？"}, {"type": "subtitle", "time": 14566.07, "timestamp": "04:02:46", "text": "不，等等。我当时和你们在一起。我只是"}, {"type": "subtitle", "time": 14569.269, "timestamp": "04:02:49", "text": "死了。哦，是的。"}, {"type": "subtitle", "time": 14573.91, "timestamp": "04:02:53", "text": "爸，你要坐牢了。我的天啊。"}, {"type": "subtitle", "time": 14576.309, "timestamp": "04:02:56", "text": "我的天啊。等等，兄弟，大家都死了。"}, {"type": "subtitle", "time": 14579.429, "timestamp": "04:02:59", "text": "什么？这游戏节奏太慢了。"}]
[{"type": "subtitle", "time": 16261.03, "timestamp": "04:31:01", "text": "人们信任你。所以当你是"}, {"type": "subtitle", "time": 16265.11, "timestamp": "04:31:05", "text": "你知道，他是杀手。是的。"}, {"type": "subtitle", "time": 16266.389, "timestamp": "04:31:06", "text": "你知道，你知道，你知道。必须有"}, {"type": "subtitle", "time": 16268.79, "timestamp": "04:31:08", "text": "这轮比赛真是太疯狂了。 Yoshi，我们看到了"}, {"type": "subtitle", "time": 16275.11, "timestamp": "04:31:15", "text": "尤希亲眼目睹了两个人死在她面前。"}, {"type": "subtitle", "time": 16277.349, "timestamp": "04:31:17", "text": "同时。每个人都死了，就像"}, {"type": "subtitle", "time": 16279.91, "timestamp": "04:31:19", "text": "就像你当着她的面杀了我一样。"}, {"type": "subtitle", "time": 16281.59, "timestamp": "04:31:21", "text": "你当着她的面完成了双杀。"}, {"type": "subtitle", "time": 16283.83, "timestamp": "04:31:23", "text": "然后人们就在眼前被吃掉了"}, {"type": "subtitle", "time": 16294.309, "timestamp": "04:31:34", "text": "我可以让人发出那样的高音。"}, {"type": "subtitle", "time": 16301.269, "timestamp": "04:31:41", "text": "派对就像个杀手吗？呃，"}, {"type": "subtitle", "time": 16303.349, "timestamp": "04:31:43", "text": "射击。我们可以把这变成最后一次吗？"}, {"type": "subtitle", "time": 16305.67, "timestamp": "04:31:45", "text": "哦，是的。派对杀手。其他玩家"}, {"type": "subtitle", "time": 16308.79, "timestamp": "04:31:48", "text": "会议期间使用高音调说话。"}, {"type": "subtitle", "time": 16310.149, "timestamp": "04:31:50", "text": "如果其他人需要离开，他们可以"}, {"type": "subtitle", "time": 16315.269, "timestamp": "04:31:55", "text": "离开。是的，那里有一只鸽子。如果"}, {"type": "subtitle", "time": 16317.59, "timestamp": "04:31:57", "text": "枕头够用，我们可以继续。"}, {"type": "subtitle", "time": 16319.67, "timestamp": "04:31:59", "text": "是的，人很多，所以我们"}]
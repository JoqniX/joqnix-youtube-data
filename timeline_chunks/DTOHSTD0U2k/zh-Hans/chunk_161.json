[{"type": "subtitle", "time": 9662.07, "timestamp": "02:41:02", "text": "我们欺负他们，对吧？哦，拜托。他们"}, {"type": "subtitle", "time": 9665.99, "timestamp": "02:41:05", "text": "赢得人心。真恶心。想象一下 想象一下"}, {"type": "subtitle", "time": 9670.71, "timestamp": "02:41:10", "text": "拥有游戏内皮肤。"}, {"type": "subtitle", "time": 9674.389, "timestamp": "02:41:14", "text": "它是免费的。我刚刚使出了杀手锏。这"}, {"type": "subtitle", "time": 9677.429, "timestamp": "02:41:17", "text": "免费扭蛋。你被套路了。这个人"}, {"type": "subtitle", "time": 9679.27, "timestamp": "02:41:19", "text": "这款游戏。是的，"}, {"type": "subtitle", "time": 9682.55, "timestamp": "02:41:22", "text": "这个游戏里有赌博成分。"}, {"type": "subtitle", "time": 9684.79, "timestamp": "02:41:24", "text": "玩得越多。"}, {"type": "subtitle", "time": 9686.07, "timestamp": "02:41:26", "text": "玩得越多，你就能获得一些"}, {"type": "subtitle", "time": 9690.63, "timestamp": "02:41:30", "text": "货币。用它来打开盒子。不是"}, {"type": "subtitle", "time": 9693.51, "timestamp": "02:41:33", "text": "盒子。飞机游戏。我一直收到"}, {"type": "subtitle", "time": 9699.91, "timestamp": "02:41:39", "text": "我们都知道这个秘密。幸福是"}, {"type": "subtitle", "time": 9702.79, "timestamp": "02:41:42", "text": "赌博。确实如此。为什么"}, {"type": "subtitle", "time": 9705.51, "timestamp": "02:41:45", "text": "你说的是事实吗，老兄？我们不能"}, {"type": "subtitle", "time": 9708.15, "timestamp": "02:41:48", "text": "有一个"}, {"type": "subtitle", "time": 9710.79, "timestamp": "02:41:50", "text": "有人开始直播了吗？他们迟到了。"}, {"type": "subtitle", "time": 9713.27, "timestamp": "02:41:53", "text": "提前9分钟。"}, {"type": "subtitle", "time": 9716.63, "timestamp": "02:41:56", "text": "好的。好的。好的。现在。"}, {"type": "subtitle", "time": 9718.63, "timestamp": "02:41:58", "text": "我当时"}]
[{"type": "subtitle", "time": 15601.349, "timestamp": "04:20:01", "text": "渡渡鸟是渡渡鸟。"}, {"type": "subtitle", "time": 15604.149, "timestamp": "04:20:04", "text": "完全。这就是我。不要相信他。不"}, {"type": "subtitle", "time": 15607.51, "timestamp": "04:20:07", "text": "相信他。哈利路亚。哦，相信我。"}, {"type": "subtitle", "time": 15614.95, "timestamp": "04:20:14", "text": "嗯是谁？"}, {"type": "subtitle", "time": 15618.229, "timestamp": "04:20:18", "text": "谁是食人族？兄弟，这人是谁？"}, {"type": "subtitle", "time": 15621.59, "timestamp": "04:20:21", "text": "生物？威猛的雄鹰。"}, {"type": "subtitle", "time": 15625.99, "timestamp": "04:20:25", "text": "什么？我们有张照片。"}, {"type": "subtitle", "time": 15628.07, "timestamp": "04:20:28", "text": "费舍尔可以以非鸭类为目标来增加"}, {"type": "subtitle", "time": 15631.11, "timestamp": "04:20:31", "text": "他们的投票权。你的任务是什么？"}, {"type": "subtitle", "time": 15635.75, "timestamp": "04:20:35", "text": "等等，没有我的哦不，我的roing"}, {"type": "subtitle", "time": 15638.229, "timestamp": "04:20:38", "text": "力量。这意味着什么？哦，那个"}, {"type": "subtitle", "time": 15640.389, "timestamp": "04:20:40", "text": "意思是，投票的人可以拥有"}, {"type": "subtitle", "time": 15642.79, "timestamp": "04:20:42", "text": "比如多投一票。"}, {"type": "subtitle", "time": 15646.87, "timestamp": "04:20:46", "text": "一票之差将拥有更大的权力。"}, {"type": "subtitle", "time": 15651.429, "timestamp": "04:20:51", "text": "嗯，是的，游说者加一票。"}, {"type": "subtitle", "time": 15653.11, "timestamp": "04:20:53", "text": "我认为是加一或加二。我"}, {"type": "subtitle", "time": 15655.59, "timestamp": "04:20:55", "text": "记不起来了。"}, {"type": "subtitle", "time": 15658.07, "timestamp": "04:20:58", "text": "好的，"}]
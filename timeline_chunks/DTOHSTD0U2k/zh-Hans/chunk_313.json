[{"type": "subtitle", "time": 18782.31, "timestamp": "05:13:02", "text": "等等，等等，等等，等等，等等，等等。"}, {"type": "subtitle", "time": 18785.35, "timestamp": "05:13:05", "text": "哦，大家好。你好。"}, {"type": "subtitle", "time": 18787.91, "timestamp": "05:13:07", "text": "不，别去那里。实际上，我是"}, {"type": "subtitle", "time": 18791.11, "timestamp": "05:13:11", "text": "常设。我站着。"}, {"type": "subtitle", "time": 18793.35, "timestamp": "05:13:13", "text": "我的天啊。"}, {"type": "subtitle", "time": 18795.91, "timestamp": "05:13:15", "text": "我究竟走进了什么地方？第一。我是"}, {"type": "subtitle", "time": 18797.35, "timestamp": "05:13:17", "text": "对不起。我不知道他们要去"}, {"type": "subtitle", "time": 18799.43, "timestamp": "05:13:19", "text": "像这样。"}, {"type": "subtitle", "time": 18800.788, "timestamp": "05:13:20", "text": "你的意思是说你不知道我们是谁？"}, {"type": "subtitle", "time": 18802.15, "timestamp": "05:13:22", "text": "以后都会这样吗？这不就像"}, {"type": "subtitle", "time": 18804.39, "timestamp": "05:13:24", "text": "我们该如何表现？就像我"}, {"type": "subtitle", "time": 18806.31, "timestamp": "05:13:26", "text": "我的意思是，我知道妻子们会……"}, {"type": "subtitle", "time": 18809.67, "timestamp": "05:13:29", "text": "不错，但我的天啊，兄弟。"}, {"type": "subtitle", "time": 18811.19, "timestamp": "05:13:31", "text": "一个"}, {"type": "subtitle", "time": 18813.59, "timestamp": "05:13:33", "text": "妻子们。"}, {"type": "subtitle", "time": 18818.07, "timestamp": "05:13:38", "text": "气氛简直太棒了。"}, {"type": "subtitle", "time": 18821.27, "timestamp": "05:13:41", "text": "不，不，我不是那个意思。"}, {"type": "subtitle", "time": 18824.39, "timestamp": "05:13:44", "text": "哦，你不是。我们是。"}, {"type": "subtitle", "time": 18827.83, "timestamp": "05:13:47", "text": "是的。我只找到你。"}, {"type": "subtitle", "time": 18831.83, "timestamp": "05:13:51", "text": "我们让你光彩夺目。哇哦。哦，那是什么？"}, {"type": "subtitle", "time": 18834.23, "timestamp": "05:13:54", "text": "他现在要唱高音了。"}, {"type": "subtitle", "time": 18835.59, "timestamp": "05:13:55", "text": "是的，他们只是想推销我们的产品。"}, {"type": "subtitle", "time": 18838.39, "timestamp": "05:13:58", "text": "提高音量。我讨厌这样。我讨厌这样。"}]
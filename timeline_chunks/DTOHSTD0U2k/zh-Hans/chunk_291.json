[{"type": "subtitle", "time": 17464.55, "timestamp": "04:51:04", "text": "内心深处发出哀求。哦，"}, {"type": "subtitle", "time": 17466.07, "timestamp": "04:51:06", "text": "吉，"}, {"type": "subtitle", "time": 17468.868, "timestamp": "04:51:08", "text": "请让我"}, {"type": "subtitle", "time": 17472.15, "timestamp": "04:51:12", "text": "所有人都出去了。我无法获得"}, {"type": "subtitle", "time": 17474.23, "timestamp": "04:51:14", "text": "你出去了，你知道，就像，但除非"}, {"type": "subtitle", "time": 17476.31, "timestamp": "04:51:16", "text": "有人杀了我，事情就这么发生了。所以，"}, {"type": "subtitle", "time": 17479.03, "timestamp": "04:51:19", "text": "是的，刚才就发生了这件事。"}, {"type": "subtitle", "time": 17480.788, "timestamp": "04:51:20", "text": "而且周围有人，所以我没法"}, {"type": "subtitle", "time": 17484.07, "timestamp": "04:51:24", "text": "跟你聊聊。哦，名人。"}, {"type": "subtitle", "time": 17486.628, "timestamp": "04:51:26", "text": "名人。名人。"}, {"type": "subtitle", "time": 17487.59, "timestamp": "04:51:27", "text": "它什么时候消亡的？每个人都得到"}, {"type": "subtitle", "time": 17489.51, "timestamp": "04:51:29", "text": "已通知。说实话，上面有粉色"}, {"type": "subtitle", "time": 17491.43, "timestamp": "04:51:31", "text": "我当时想的是，“这是什么？”"}, {"type": "subtitle", "time": 17494.23, "timestamp": "04:51:34", "text": "操？是"}, {"type": "subtitle", "time": 17496.07, "timestamp": "04:51:36", "text": "与加拿大的几乎相同，但"}, {"type": "subtitle", "time": 17501.19, "timestamp": "04:51:41", "text": "看？"}, {"type": "subtitle", "time": 17517.91, "timestamp": "04:51:57", "text": "与一个"}]
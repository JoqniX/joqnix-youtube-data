[{"type": "subtitle", "time": 17520.628, "timestamp": "04:52:00", "text": "狗"}, {"type": "subtitle", "time": 17528.708, "timestamp": "04:52:08", "text": "四处走走。好的。好的。是吗？"}, {"type": "subtitle", "time": 17532.948, "timestamp": "04:52:12", "text": "乔克尼克斯？那是乔克恩吗？"}, {"type": "subtitle", "time": 17535.59, "timestamp": "04:52:15", "text": "等等，什么？哦，你听见狗叫了"}, {"type": "subtitle", "time": 17546.708, "timestamp": "04:52:26", "text": "等等，你们听到狗狗叫了吗？"}, {"type": "subtitle", "time": 17554.07, "timestamp": "04:52:34", "text": "你没有，对吧。你好。等等，这个我"}, {"type": "subtitle", "time": 17559.91, "timestamp": "04:52:39", "text": "这是什么？好了，我得打扫卫生了。我"}, {"type": "subtitle", "time": 17561.75, "timestamp": "04:52:41", "text": "和你待在一起感觉真好。是的，我"}, {"type": "subtitle", "time": 17575.59, "timestamp": "04:52:55", "text": "你好。"}, {"type": "subtitle", "time": 17578.948, "timestamp": "04:52:58", "text": "再等10秒钟。"}]
[{"type": "subtitle", "time": 19741.67, "timestamp": "05:29:01", "text": "独自一人在药剂师铺里杀了他。我"}, {"type": "subtitle", "time": 19743.99, "timestamp": "05:29:03", "text": "当时在广场。我搬到了广场。我"}, {"type": "subtitle", "time": 19745.67, "timestamp": "05:29:05", "text": "我没在那里杀人，因为我不杀人。"}, {"type": "subtitle", "time": 19746.868, "timestamp": "05:29:06", "text": "有选择权。一直和我在一起"}, {"type": "subtitle", "time": 19750.15, "timestamp": "05:29:10", "text": "整个过程都和我在一起。好的。特朗普是"}, {"type": "subtitle", "time": 19751.99, "timestamp": "05:29:11", "text": "那时和你在一起。但你是主动申报的。我"}, {"type": "subtitle", "time": 19753.51, "timestamp": "05:29:13", "text": "想自行申报。你为什么自"}, {"type": "subtitle", "time": 19756.788, "timestamp": "05:29:16", "text": "当时有报道吗？我为什么要这么做？那是我的"}, {"type": "subtitle", "time": 19759.03, "timestamp": "05:29:19", "text": "观点。大家互相握手。我当时"}, {"type": "subtitle", "time": 19761.99, "timestamp": "05:29:21", "text": "通过。好的。有人看到我经过。"}, {"type": "subtitle", "time": 19764.47, "timestamp": "05:29:24", "text": "有人看到我经过。逻辑思考。"}, {"type": "subtitle", "time": 19766.23, "timestamp": "05:29:26", "text": "逻辑思考。人们看到我经过我的"}, {"type": "subtitle", "time": 19770.47, "timestamp": "05:29:30", "text": "广场。谈论我不知道的事情。"}, {"type": "subtitle", "time": 19772.47, "timestamp": "05:29:32", "text": "真扫兴。这是一份自我报告。这是一个"}, {"type": "subtitle", "time": 19774.39, "timestamp": "05:29:34", "text": "自我报告。肯定是男生。它是"}, {"type": "subtitle", "time": 19780.28, "timestamp": "05:29:40", "text": "我勒个去？"}]
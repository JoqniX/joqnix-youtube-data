[{"type": "subtitle", "time": 1743.029, "timestamp": "00:29:03", "text": "现在是你思考的时候了，罗孚。哦，"}, {"type": "subtitle", "time": 1747.19, "timestamp": "00:29:07", "text": "你已经找到我们了。"}, {"type": "subtitle", "time": 1750.549, "timestamp": "00:29:10", "text": "颤抖、发抖，眨眨眼。时钟"}, {"type": "subtitle", "time": 1753.99, "timestamp": "00:29:13", "text": "一双双腿从旁边经过。"}, {"type": "subtitle", "time": 1759.83, "timestamp": "00:29:19", "text": "白色、黑色和红色。那是角色扮演游戏。"}, {"type": "subtitle", "time": 1763.269, "timestamp": "00:29:23", "text": "我在等他点赞"}, {"type": "subtitle", "time": 1772.63, "timestamp": "00:29:32", "text": "角色扮演游戏可不是这么玩的。"}, {"type": "subtitle", "time": 1775.59, "timestamp": "00:29:35", "text": "是的。谢谢。我需要那个。现在轮到你"}, {"type": "subtitle", "time": 1780.789, "timestamp": "00:29:40", "text": "死。亲爱的，小心点。你们的先驱者们"}, {"type": "subtitle", "time": 1783.83, "timestamp": "00:29:43", "text": "都躺在你的脚边。别看。呃"}, {"type": "subtitle", "time": 1788.389, "timestamp": "00:29:48", "text": "嗯嗯。别着急。稍有不慎，他们就会"}]
[{"type": "subtitle", "time": 19805.11, "timestamp": "05:30:05", "text": "来自我。嘿，韩，你好吗？"}, {"type": "subtitle", "time": 19807.99, "timestamp": "05:30:07", "text": "伙伴？嘿，"}, {"type": "subtitle", "time": 19810.23, "timestamp": "05:30:10", "text": "你为什么吓到我了？不，不，不。"}, {"type": "subtitle", "time": 19812.31, "timestamp": "05:30:12", "text": "事情就是这样，对吧？好的，所以"}, {"type": "subtitle", "time": 19816.31, "timestamp": "05:30:16", "text": "发生了杀戮。不，杀戮事件发生了。"}, {"type": "subtitle", "time": 19818.39, "timestamp": "05:30:18", "text": "我可以，但我并不确定。我不"}, {"type": "subtitle", "time": 19821.59, "timestamp": "05:30:21", "text": "记住这一点。我不知道。好的，"}, {"type": "subtitle", "time": 19823.75, "timestamp": "05:30:23", "text": "听。对，韩韩。我们经过了每一处"}, {"type": "subtitle", "time": 19826.948, "timestamp": "05:30:26", "text": "另一次。你看到我经过广场了。"}, {"type": "subtitle", "time": 19829.51, "timestamp": "05:30:29", "text": "我记不太清了。我还没见过"}, {"type": "subtitle", "time": 19831.51, "timestamp": "05:30:31", "text": "我一直没去看那东西。哦，"}, {"type": "subtitle", "time": 19833.59, "timestamp": "05:30:33", "text": "真是见鬼了。我们路过广场"}, {"type": "subtitle", "time": 19835.75, "timestamp": "05:30:35", "text": "一起。我当时正往教堂附近走。"}, {"type": "subtitle", "time": 19838.15, "timestamp": "05:30:38", "text": "然后，在墓地和……之间，然后我"}, {"type": "subtitle", "time": 19839.99, "timestamp": "05:30:39", "text": "我看到他站在一具尸体旁，他用力按压。"}, {"type": "subtitle", "time": 19841.51, "timestamp": "05:30:41", "text": "我一经过就立即汇报了情况。"}, {"type": "subtitle", "time": 19846.39, "timestamp": "05:30:46", "text": "顺便一提。我只是告诉你而已"}, {"type": "subtitle", "time": 19851.27, "timestamp": "05:30:51", "text": "知道。我正在努力活下去。"}, {"type": "subtitle", "time": 19854.47, "timestamp": "05:30:54", "text": "是的。情况如何？大家都还活着吗？"}, {"type": "subtitle", "time": 19856.15, "timestamp": "05:30:56", "text": "大家都在团结一致。我的意思是，我"}, {"type": "subtitle", "time": 19857.51, "timestamp": "05:30:57", "text": "但公平地说，如果每个人"}, {"type": "subtitle", "time": 19859.03, "timestamp": "05:30:59", "text": "像这样的活动，大家团结在一起。哦，"}]
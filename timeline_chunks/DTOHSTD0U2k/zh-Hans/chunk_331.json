[{"type": "subtitle", "time": 19868.788, "timestamp": "05:31:08", "text": "呃，在某个地方。但好吧，假设你确实这么做了。"}, {"type": "subtitle", "time": 19870.47, "timestamp": "05:31:10", "text": "是的，"}, {"type": "subtitle", "time": 19872.868, "timestamp": "05:31:12", "text": "我来解释一下。你没事。你没事。"}, {"type": "subtitle", "time": 19875.91, "timestamp": "05:31:15", "text": "我接到你了。我是。"}, {"type": "subtitle", "time": 19877.83, "timestamp": "05:31:17", "text": "嗯，在他之前，他好像说过，我们都应该……"}, {"type": "subtitle", "time": 19880.23, "timestamp": "05:31:20", "text": "团结一致，如果他死了，我会……"}, {"type": "subtitle", "time": 19882.07, "timestamp": "05:31:22", "text": "报告。如果我们死了，等等等等。是的。"}, {"type": "subtitle", "time": 19884.39, "timestamp": "05:31:24", "text": "所以，我以为他在这里。"}, {"type": "subtitle", "time": 19885.75, "timestamp": "05:31:25", "text": "问题就在这里，对吧？我不"}, {"type": "subtitle", "time": 19887.99, "timestamp": "05:31:27", "text": "想待在他身边。好的。不，我不"}, {"type": "subtitle", "time": 19890.708, "timestamp": "05:31:30", "text": "想待在他身边。我不信任他们。"}, {"type": "subtitle", "time": 19892.628, "timestamp": "05:31:32", "text": "因为我亲眼看到你杀人了。我不能"}, {"type": "subtitle", "time": 19895.11, "timestamp": "05:31:35", "text": "你离我近吗？"}, {"type": "subtitle", "time": 19897.11, "timestamp": "05:31:37", "text": "所以，请跟着我的节奏走。请坚持"}, {"type": "subtitle", "time": 19900.31, "timestamp": "05:31:40", "text": "与我一起。我会一直支持你。"}]
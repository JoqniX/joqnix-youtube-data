[{"type": "subtitle", "time": 4335.83, "timestamp": "01:12:15", "text": "我想问罗科，但我打不开。"}, {"type": "subtitle", "time": 4339.59, "timestamp": "01:12:19", "text": "我打不开。哦，你我。你好，阿里坦"}, {"type": "subtitle", "time": 4341.51, "timestamp": "01:12:21", "text": "将会是我在游戏中的第一个朋友。"}, {"type": "subtitle", "time": 4347.11, "timestamp": "01:12:27", "text": "我们走吧。"}, {"type": "subtitle", "time": 4372.61, "timestamp": "01:12:52", "text": "好的。洛克，洛克威在哪里？"}, {"type": "subtitle", "time": 4379.57, "timestamp": "01:12:59", "text": "那是"}]
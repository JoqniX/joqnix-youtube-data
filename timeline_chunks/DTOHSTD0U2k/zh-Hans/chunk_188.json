[{"type": "subtitle", "time": 11282.55, "timestamp": "03:08:02", "text": "你的手机。好了。铃声。"}, {"type": "subtitle", "time": 11285.67, "timestamp": "03:08:05", "text": "铃声。你的手机响了。我的天啊。"}, {"type": "subtitle", "time": 11288.469, "timestamp": "03:08:08", "text": "兄弟，真对不起。"}, {"type": "subtitle", "time": 11291.75, "timestamp": "03:08:11", "text": "虽然我说过这句话。是的。嗯"}, {"type": "subtitle", "time": 11294.55, "timestamp": "03:08:14", "text": "各位，呃，你们可以叫我奥克西，但是这个"}, {"type": "subtitle", "time": 11297.03, "timestamp": "03:08:17", "text": "这不是我的用户名。我不能"}, {"type": "subtitle", "time": 11299.349, "timestamp": "03:08:19", "text": "改一下。我不"}, {"type": "subtitle", "time": 11300.95, "timestamp": "03:08:20", "text": "它是"}, {"type": "subtitle", "time": 11303.269, "timestamp": "03:08:23", "text": "不过，你们可以叫我奥克西。我是"}, {"type": "subtitle", "time": 11305.83, "timestamp": "03:08:25", "text": "只是一个小小的直播主播。就这样。"}, {"type": "subtitle", "time": 11309.03, "timestamp": "03:08:29", "text": "就这样"}, {"type": "subtitle", "time": 11317.83, "timestamp": "03:08:37", "text": "哇，哇，"}, {"type": "subtitle", "time": 11321.11, "timestamp": "03:08:41", "text": "等待。嘿，嘿，不。"}, {"type": "subtitle", "time": 11324.87, "timestamp": "03:08:44", "text": "我的兄弟。她，她，她也和……一样可爱"}, {"type": "subtitle", "time": 11326.71, "timestamp": "03:08:46", "text": "奥利弗是。我的天啊。我必须站起来"}, {"type": "subtitle", "time": 11331.91, "timestamp": "03:08:51", "text": "我也这么认为。哦，不。我错过了。我是"}, {"type": "subtitle", "time": 11335.91, "timestamp": "03:08:55", "text": "上面没找到。我也这么认为。我认为"}, {"type": "subtitle", "time": 11337.67, "timestamp": "03:08:57", "text": "所以。"}]
[{"type": "subtitle", "time": 13922.229, "timestamp": "03:52:02", "text": "我在吃点零食。这就是为什么即使"}, {"type": "subtitle", "time": 13926.389, "timestamp": "03:52:06", "text": "沉默的。我在吃饭。哦。哦不，它变了"}, {"type": "subtitle", "time": 13935.75, "timestamp": "03:52:15", "text": "哇。"}, {"type": "subtitle", "time": 13960.87, "timestamp": "03:52:40", "text": "我只信任你。"}, {"type": "subtitle", "time": 13965.269, "timestamp": "03:52:45", "text": "不，你不应该测试。"}, {"type": "subtitle", "time": 13973.349, "timestamp": "03:52:53", "text": "我的天啊，"}]
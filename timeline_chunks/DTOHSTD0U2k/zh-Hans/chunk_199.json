[{"type": "subtitle", "time": 11942.63, "timestamp": "03:19:02", "text": "吉野。克服困难所需的时间"}, {"type": "subtitle", "time": 11945.19, "timestamp": "03:19:05", "text": "顶部的那些东西太不稳定了。"}, {"type": "subtitle", "time": 11947.59, "timestamp": "03:19:07", "text": "所以不可能是我，因为我刚刚通过了。"}, {"type": "subtitle", "time": 11949.67, "timestamp": "03:19:09", "text": "经过。"}, {"type": "subtitle", "time": 11951.99, "timestamp": "03:19:11", "text": "我不知道。我认为它排在第一位。在"}, {"type": "subtitle", "time": 11955.03, "timestamp": "03:19:15", "text": "顶部附近。但是它到底在哪里呢？"}, {"type": "subtitle", "time": 11956.79, "timestamp": "03:19:16", "text": "尸体涉嫌犯罪。等等，我刚才是不是……"}, {"type": "subtitle", "time": 11959.59, "timestamp": "03:19:19", "text": "被枪击了？什么？"}, {"type": "subtitle", "time": 11963.83, "timestamp": "03:19:23", "text": "有人中枪了。有人中枪了。哦，"}, {"type": "subtitle", "time": 11965.11, "timestamp": "03:19:25", "text": "我觉得，我觉得那就是小丑那件事"}, {"type": "subtitle", "time": 11967.88, "timestamp": "03:19:27", "text": "因为小丑可能会杀人。"}, {"type": "subtitle", "time": 11977.429, "timestamp": "03:19:37", "text": "我完全不知道。我当时是为了我自己。"}, {"type": "subtitle", "time": 11981.59, "timestamp": "03:19:41", "text": "我当时在紫色区域。所以就像"}, {"type": "subtitle", "time": 11984.07, "timestamp": "03:19:44", "text": "我可以确认Drag和Hon在一起了。"}, {"type": "subtitle", "time": 11986.87, "timestamp": "03:19:46", "text": "我的天啊。所以我就路过了"}, {"type": "subtitle", "time": 11990.15, "timestamp": "03:19:50", "text": "身体和Yoshi。我当时在做V字手势"}, {"type": "subtitle", "time": 11997.84, "timestamp": "03:19:57", "text": "所以我们现在在做什么？"}]
[{"type": "subtitle", "time": 15903.59, "timestamp": "04:25:03", "text": "凶手，所以他和凶手一起死了。"}, {"type": "subtitle", "time": 15905.59, "timestamp": "04:25:05", "text": "好的。好的。"}, {"type": "subtitle", "time": 15907.11, "timestamp": "04:25:07", "text": "嗯"}, {"type": "subtitle", "time": 15909.67, "timestamp": "04:25:09", "text": "所以，他当时在哪儿？"}, {"type": "subtitle", "time": 15914.389, "timestamp": "04:25:14", "text": "她和基尔在哪里？我和基里在一起。"}, {"type": "subtitle", "time": 15917.91, "timestamp": "04:25:17", "text": "我当时在医院现场。"}, {"type": "subtitle", "time": 15921.91, "timestamp": "04:25:21", "text": "我们得留下来陪我。 Yoshi，在哪里"}, {"type": "subtitle", "time": 15925.03, "timestamp": "04:25:25", "text": "我们到底需要做什么？你们想要吗？"}, {"type": "subtitle", "time": 15927.349, "timestamp": "04:25:27", "text": "带我们回去？我要去找"}, {"type": "subtitle", "time": 15929.67, "timestamp": "04:25:29", "text": "你。坚持，稍等。我认为我们只录制了"}, {"type": "subtitle", "time": 15931.91, "timestamp": "04:25:31", "text": "因为我当时很困惑。你想知道。"}, {"type": "subtitle", "time": 15935.429, "timestamp": "04:25:35", "text": "我知道。我知道。或者跳过。"}, {"type": "subtitle", "time": 15938.469, "timestamp": "04:25:38", "text": "所以，我们要跳过吗？跳过。是的，我"}, {"type": "subtitle", "time": 15941.83, "timestamp": "04:25:41", "text": "我们认为我们是。我们是。我这就去"}, {"type": "subtitle", "time": 15944.469, "timestamp": "04:25:44", "text": "跳过。我感到非常困惑。那真是太……"}]
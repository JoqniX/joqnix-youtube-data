[{"type": "subtitle", "time": 19443.99, "timestamp": "05:24:03", "text": "我当时想"}, {"type": "subtitle", "time": 19446.788, "timestamp": "05:24:06", "text": "我好热。你那样做是因为你知道"}, {"type": "subtitle", "time": 19453.67, "timestamp": "05:24:13", "text": "就在那儿。我愿意为你输掉比赛。"}, {"type": "subtitle", "time": 19457.03, "timestamp": "05:24:17", "text": "杰克·尼克松就站在你前面。那是"}, {"type": "subtitle", "time": 19463.83, "timestamp": "05:24:23", "text": "你本可以保护自己。我"}, {"type": "subtitle", "time": 19466.27, "timestamp": "05:24:26", "text": "我什么都不会说。"}, {"type": "subtitle", "time": 19468.31, "timestamp": "05:24:28", "text": "[音乐]"}, {"type": "subtitle", "time": 19471.1, "timestamp": "05:24:31", "text": "为什么很难"}, {"type": "subtitle", "time": 19472.39, "timestamp": "05:24:32", "text": "[音乐]"}, {"type": "subtitle", "time": 19480.31, "timestamp": "05:24:40", "text": "过来。我需要和你谈谈。来"}, {"type": "subtitle", "time": 19484.31, "timestamp": "05:24:44", "text": "这里。我需要和你谈谈。"}, {"type": "subtitle", "time": 19488.948, "timestamp": "05:24:48", "text": "非常好。吉。大部头书。好的。你知道"}, {"type": "subtitle", "time": 19491.59, "timestamp": "05:24:51", "text": "Kir 以前可是个警长，对吧？你"}, {"type": "subtitle", "time": 19494.868, "timestamp": "05:24:54", "text": "知道。我不知道。我不知道。"}, {"type": "subtitle", "time": 19497.43, "timestamp": "05:24:57", "text": "你亲眼看到她枪杀了她的朋友。不，他们"}]
[{"type": "subtitle", "time": 1624.47, "timestamp": "00:27:04", "text": "我。  我如何才能收到“嗨”？謝謝。謝謝。  謝謝。  我的天啊。  你有一"}, {"type": "subtitle", "time": 1632.87, "timestamp": "00:27:12", "text": "台電腦嗎？我沒有"}, {"type": "subtitle", "time": 1657.99, "timestamp": "00:27:37", "text": "。  [笑聲] 我有一台電腦。我在等我的…嗯…這個東西…[笑聲] 是的，今年"}]
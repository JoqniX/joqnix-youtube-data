[{"type": "subtitle", "time": 1090.23, "timestamp": "00:18:10", "text": "。"}, {"type": "subtitle", "time": 1102.71, "timestamp": "00:18:22", "text": "我還想做個唱歌"}, {"type": "subtitle", "time": 1106.31, "timestamp": "00:18:26", "text": "練習之類的，因為我的一個朋友拉著我一起翻唱那首《Chain Man》的歌《Jane Do》。"}, {"type": "subtitle", "time": 1115.35, "timestamp": "00:18:35", "text": "呃，"}, {"type": "subtitle", "time": 1118.71, "timestamp": "00:18:38", "text": "所以我得學學男聲部分的台詞。但我去了，我和女伴們在一起。"}, {"type": "subtitle", "time": 1133.83, "timestamp": "00:18:53", "text": "呃，主線對我來說有點難。"}]
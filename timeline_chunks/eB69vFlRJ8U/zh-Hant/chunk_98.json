[{"type": "subtitle", "time": 5883.189, "timestamp": "01:38:03", "text": "，我嚇了一跳。拜拜。我不小心按到什麼東西了，然後我在唱歌"}, {"type": "subtitle", "time": 5921.189, "timestamp": "01:38:41", "text": "我正在"}, {"type": "subtitle", "time": 5925.35, "timestamp": "01:38:45", "text": "學這首歌，因為我要翻唱。我必須在一個月內學會"}, {"type": "subtitle", "time": 5936.39, "timestamp": "01:38:56", "text": "這首歌，因為我要和朋友一起翻唱。所以，嗯，什麼？"}]
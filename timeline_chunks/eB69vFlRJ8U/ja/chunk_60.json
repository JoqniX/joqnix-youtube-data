[{"type": "subtitle", "time": 3606.63, "timestamp": "01:00:06", "text": "私はお酒を飲まないんだ。やあ、"}, {"type": "subtitle", "time": 3609.349, "timestamp": "01:00:09", "text": "やあ。歌の"}, {"type": "subtitle", "time": 3611.27, "timestamp": "01:00:11", "text": "練習をしよう。えっと、"}, {"type": "subtitle", "time": 3613.75, "timestamp": "01:00:13", "text": "1ヶ月以内にジェーンを覚えないといけないから。えっと、"}, {"type": "subtitle", "time": 3616.789, "timestamp": "01:00:16", "text": "デュエットカバーのために。"}, {"type": "subtitle", "time": 3618.47, "timestamp": "01:00:18", "text": "うん。"}, {"type": "subtitle", "time": 3639.03, "timestamp": "01:00:39", "text": "全部が遅れてる。"}, {"type": "subtitle", "time": 3658.63, "timestamp": "01:00:58", "text": "ガイドメロディがない。わかった。これには"}]
[{"type": "subtitle", "time": 3361.349, "timestamp": "00:56:01", "text": "ない。配信できなくても動画をアップロードするよ。"}, {"type": "subtitle", "time": 3364.63, "timestamp": "00:56:04", "text": "配信大好き。正直、配信は"}, {"type": "subtitle", "time": 3393.109, "timestamp": "00:56:33", "text": "ああ、大学用。えっと、大学用？"}, {"type": "subtitle", "time": 3397.829, "timestamp": "00:56:37", "text": "いや、日本のN1試験、ZPTに合格すれば大丈夫だよ"}, {"type": "subtitle", "time": 3400.47, "timestamp": "00:56:40", "text": "。そうすれば大丈夫だし、"}, {"type": "subtitle", "time": 3401.99, "timestamp": "00:56:41", "text": "語学学校のコネも使えるし。"}, {"type": "subtitle", "time": 3404.549, "timestamp": "00:56:44", "text": "彼らが助けてくれるから。"}, {"type": "subtitle", "time": 3407.43, "timestamp": "00:56:47", "text": "厳しい学校なんだ。この学校は、"}, {"type": "subtitle", "time": 3409.27, "timestamp": "00:56:49", "text": "学生に高等"}, {"type": "subtitle", "time": 3411.589, "timestamp": "00:56:51", "text": "教育を与えて、彼らが行きたいところに行けるようにするんだ"}, {"type": "subtitle", "time": 3414.87, "timestamp": "00:56:54", "text": "。いや。だから、"}, {"type": "subtitle", "time": 3417.109, "timestamp": "00:56:57", "text": "できれば大学に入って、"}, {"type": "subtitle", "time": 3419.91, "timestamp": "00:56:59", "text": "ビザを3～4年間の留学ビザに切り替えるようにする"}]
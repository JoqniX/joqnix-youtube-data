[{"type": "subtitle", "time": 3523.03, "timestamp": "00:58:43", "text": "彼は何も見てないって"}, {"type": "subtitle", "time": 3526.47, "timestamp": "00:58:46", "text": "。ああ、ごめん。何かを"}, {"type": "subtitle", "time": 3529.51, "timestamp": "00:58:49", "text": "切り替えていたら、何かが起こったんだ"}, {"type": "subtitle", "time": 3532.47, "timestamp": "00:58:52", "text": "。（息を呑む）ええ。"}, {"type": "subtitle", "time": 3534.71, "timestamp": "00:58:54", "text": "実家に行って、両親"}, {"type": "subtitle", "time": 3537.51, "timestamp": "00:58:57", "text": "と別れたんだ。両親は外にいた。ええ、私の記憶によると、"}, {"type": "subtitle", "time": 3539.349, "timestamp": "00:58:59", "text": "2日後に目が覚めた"}]
[{"type": "subtitle", "time": 5220.229, "timestamp": "01:27:00", "text": "えーと、スマホから録画したいなら"}, {"type": "subtitle", "time": 5222.79, "timestamp": "01:27:02", "text": "、V Studioモバイル"}, {"type": "subtitle", "time": 5225.99, "timestamp": "01:27:05", "text": "アプリをダウンロードすればいいよ。プロ版か何かを入手して、"}, {"type": "subtitle", "time": 5228.79, "timestamp": "01:27:08", "text": "PCで使えるようにしなさい。"}, {"type": "subtitle", "time": 5231.35, "timestamp": "01:27:11", "text": "スマホのカメラを使って"}, {"type": "subtitle", "time": 5235.59, "timestamp": "01:27:15", "text": "モデルを追跡したい場合は、そうすることができます。"}, {"type": "subtitle", "time": 5244.709, "timestamp": "01:27:24", "text": "[息を呑む]"}, {"type": "subtitle", "time": 5264.285, "timestamp": "01:27:44", "text": "ええ、わかりました。何をしてたっけ？"}, {"type": "subtitle", "time": 5265.91, "timestamp": "01:27:45", "text": "[笑い] 忘れてた。"}]
[{"type": "subtitle", "time": 913.509, "timestamp": "00:15:13", "text": "[笑い]"}, {"type": "subtitle", "time": 917.67, "timestamp": "00:15:17", "text": "いいですね。 ニース。 こんにちは。 それで、ええと、私は自分の"}, {"type": "subtitle", "time": 922.15, "timestamp": "00:15:22", "text": "勇気を捨てて、自分の"}, {"type": "subtitle", "time": 928.79, "timestamp": "00:15:28", "text": "普段の生活をモデルに使うことにしました。"}, {"type": "subtitle", "time": 931.03, "timestamp": "00:15:31", "text": "うーん、"}, {"type": "subtitle", "time": 934.47, "timestamp": "00:15:34", "text": "だって、うーん、もう一度言いますが、もし物事が起こったら、もし"}, {"type": "subtitle", "time": 936.79, "timestamp": "00:15:36", "text": "何かが起こったら、それはそれで仕方ないんです"}, {"type": "subtitle", "time": 940.069, "timestamp": "00:15:40", "text": "。 しかし今のところ、しばらくは何も"}, {"type": "subtitle", "time": 943.91, "timestamp": "00:15:43", "text": "起こらないと思われます"}, {"type": "subtitle", "time": 946.629, "timestamp": "00:15:46", "text": "。 それで、"}, {"type": "subtitle", "time": 949.269, "timestamp": "00:15:49", "text": "4、2、3、"}, {"type": "subtitle", "time": 952.31, "timestamp": "00:15:52", "text": "4年くらい使っていた古いモデルを使うつもりです [笑い]"}, {"type": "subtitle", "time": 955.11, "timestamp": "00:15:55", "text": "なので、次の3か月からはそうするつもりです。"}, {"type": "subtitle", "time": 957.03, "timestamp": "00:15:57", "text": "つまり、今すぐに"}]
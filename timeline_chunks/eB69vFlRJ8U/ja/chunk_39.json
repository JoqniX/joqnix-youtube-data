[{"type": "subtitle", "time": 2342.31, "timestamp": "00:39:02", "text": "ええ、今週は何もしてませんでした。"}, {"type": "subtitle", "time": 2345.589, "timestamp": "00:39:05", "text": "ゲームには全く触れませんでした。"}, {"type": "subtitle", "time": 2349.99, "timestamp": "00:39:09", "text": "他のストリーマーがプレイしているのを見ていましたが、"}, {"type": "subtitle", "time": 2353.91, "timestamp": "00:39:13", "text": "自分でプレイしなくては。"}, {"type": "subtitle", "time": 2357.51, "timestamp": "00:39:17", "text": "私が遭遇する唯一の不運な瞬間は、"}, {"type": "subtitle", "time": 2360.87, "timestamp": "00:39:20", "text": "ストリーミングしようとするたびに、本当に"}, {"type": "subtitle", "time": 2365.829, "timestamp": "00:39:25", "text": "運が悪くなることです。 私はすぐに死んでしまいます。"}, {"type": "subtitle", "time": 2369.99, "timestamp": "00:39:29", "text": "ああ、私のPCが苦戦しているから。 いいえ、"}, {"type": "subtitle", "time": 2375.51, "timestamp": "00:39:35", "text": "私の PC にはちょっと重いゲームです。 そういうことです"}, {"type": "subtitle", "time": 2388.87, "timestamp": "00:39:48", "text": "いいえ。えっと、何ですか? 何？   ちょっと"}, {"type": "subtitle", "time": 2393.75, "timestamp": "00:39:53", "text": "待って、何？ それは爆発的だ。 何ですか?   うーん"}]
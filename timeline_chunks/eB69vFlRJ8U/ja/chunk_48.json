[{"type": "subtitle", "time": 2880.87, "timestamp": "00:48:00", "text": "ようこそ。 ああ、そうそう、Dainci Resolve をダウンロードしたのは、"}, {"type": "subtitle", "time": 2892.15, "timestamp": "00:48:12", "text": "字幕を抽出して"}, {"type": "subtitle", "time": 2893.91, "timestamp": "00:48:13", "text": "字幕を使って編集したり、"}, {"type": "subtitle", "time": 2897.03, "timestamp": "00:48:17", "text": "無音部分を自動的にリップル削除したりできる機能を見つけたからです"}, {"type": "subtitle", "time": 2898.47, "timestamp": "00:48:18", "text": "。 それで「よし、手に入れるぞ"}, {"type": "subtitle", "time": 2907.67, "timestamp": "00:48:27", "text": "良い機能が動画制作に役立つからね。」って感じだった。"}, {"type": "subtitle", "time": 2919.27, "timestamp": "00:48:39", "text": "うん、"}, {"type": "subtitle", "time": 2921.51, "timestamp": "00:48:41", "text": "今日後で試すのが楽しみだ。"}, {"type": "subtitle", "time": 2923.589, "timestamp": "00:48:43", "text": "動画を撮る予定なんだ。"}, {"type": "subtitle", "time": 2926.63, "timestamp": "00:48:46", "text": "前の電車の動画で"}, {"type": "subtitle", "time": 2930.39, "timestamp": "00:48:50", "text": "モデルの状況、つまり僕の"}, {"type": "subtitle", "time": 2933.768, "timestamp": "00:48:53", "text": "モデルの悲惨な状況について話したんだけど。"}, {"type": "subtitle", "time": 2935.75, "timestamp": "00:48:55", "text": "[笑い]"}, {"type": "subtitle", "time": 2938.71, "timestamp": "00:48:58", "text": "だから、その動画を撮って、"}]
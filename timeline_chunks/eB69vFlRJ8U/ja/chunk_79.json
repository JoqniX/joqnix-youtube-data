[{"type": "subtitle", "time": 4743.59, "timestamp": "01:19:03", "text": "ことをやること。コミュニティに入ったりしないで"}, {"type": "subtitle", "time": 4745.59, "timestamp": "01:19:05", "text": "何でもいい。自分のやりたい"}, {"type": "subtitle", "time": 4747.11, "timestamp": "01:19:07", "text": "ことをやればいい。"}, {"type": "subtitle", "time": 4755.59, "timestamp": "01:19:15", "text": "君の作品に共感してくれる人もいるだろうけど、"}, {"type": "subtitle", "time": 4759.43, "timestamp": "01:19:19", "text": "結局は"}, {"type": "subtitle", "time": 4761.75, "timestamp": "01:19:21", "text": "良い友達にはなれないかもしれないし、偽物かもしれない"}, {"type": "subtitle", "time": 4763.59, "timestamp": "01:19:23", "text": "。アンチもいるだろうし、あれはダメだ、あれはダメだと"}, {"type": "subtitle", "time": 4765.99, "timestamp": "01:19:25", "text": "言う人もいるだろう"}, {"type": "subtitle", "time": 4773.51, "timestamp": "01:19:33", "text": "沈黙は無視して、自分の"}, {"type": "subtitle", "time": 4775.669, "timestamp": "01:19:35", "text": "情熱を追い求めればいい。Vubingを"}, {"type": "subtitle", "time": 4777.75, "timestamp": "01:19:37", "text": "やりたいなら、Vimingを試してみたいなら"}, {"type": "subtitle", "time": 4780.709, "timestamp": "01:19:40", "text": "、やってみよう。"}, {"type": "subtitle", "time": 4787.35, "timestamp": "01:19:47", "text": "コンテンツ制作、"}, {"type": "subtitle", "time": 4790.39, "timestamp": "01:19:50", "text": "ライブ配信、コンテンツ制作、"}, {"type": "subtitle", "time": 4793.35, "timestamp": "01:19:53", "text": "そういったことをゆっくりと学んでいくんだ。これは旅なんだ。うん、大丈夫"}, {"type": "subtitle", "time": 4795.91, "timestamp": "01:19:55", "text": "。"}, {"type": "subtitle", "time": 4797.91, "timestamp": "01:19:57", "text": "誰にも邪魔されずに、頑張ろう"}]
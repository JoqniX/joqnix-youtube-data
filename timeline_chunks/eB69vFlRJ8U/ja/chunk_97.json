[{"type": "subtitle", "time": 5847.669, "timestamp": "01:37:27", "text": "歌詞では今、"}, {"type": "subtitle", "time": 5853.03, "timestamp": "01:37:33", "text": "2番が難しいんだけど、コーラス、えーと、リフレインがあって、"}, {"type": "subtitle", "time": 5857.51, "timestamp": "01:37:37", "text": "1番のリフレイン、コーラス、この全部できると"}, {"type": "subtitle", "time": 5870.95, "timestamp": "01:37:50", "text": "[笑い]"}, {"type": "subtitle", "time": 5873.35, "timestamp": "01:37:53", "text": "難しい。ブリッジ。できる。ブリッジ。できる"}, {"type": "subtitle", "time": 5876.629, "timestamp": "01:37:56", "text": "。ブリッジ。できる。2番"}]
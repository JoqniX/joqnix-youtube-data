[{"type": "subtitle", "time": 1877.19, "timestamp": "00:31:17", "text": "これの何が問題なのか分かりません。 何てことだ"}, {"type": "subtitle", "time": 1879.83, "timestamp": "00:31:19", "text": "。"}, {"type": "subtitle", "time": 1882.149, "timestamp": "00:31:22", "text": "そうですね、だから"}, {"type": "subtitle", "time": 1891.83, "timestamp": "00:31:31", "text": "そうですね、配信する前にテストしておくべきでした"}, {"type": "subtitle", "time": 1895.669, "timestamp": "00:31:35", "text": "。 ええ、"}, {"type": "subtitle", "time": 1898.389, "timestamp": "00:31:38", "text": "でも大丈夫です。"}, {"type": "subtitle", "time": 1901.59, "timestamp": "00:31:41", "text": "それが現実さ。"}, {"type": "subtitle", "time": 1913.269, "timestamp": "00:31:53", "text": "脳内の毛細血管のように、このパズルを解くことができると思います。 ああ、"}, {"type": "subtitle", "time": 1919.669, "timestamp": "00:31:59", "text": "ジョナスが何を与えるかを知る必要はありますか"}]
[{"type": "subtitle", "time": 4389.43, "timestamp": "01:13:09", "text": "オーケー、戻ってきた。戻ってきた。あらまあ。わあ、オーケー"}, {"type": "subtitle", "time": 4395.59, "timestamp": "01:13:15", "text": "。えーと、ある意味、"}, {"type": "subtitle", "time": 4401.99, "timestamp": "01:13:21", "text": "デュエットカバーでヒカルアンのセリフを歌う必要なんてないんだ。"}, {"type": "subtitle", "time": 4404.79, "timestamp": "01:13:24", "text": "ケンチイズイナのセリフを歌えばいいんだよ。"}, {"type": "subtitle", "time": 4407.59, "timestamp": "01:13:27", "text": "これだけ、"}, {"type": "subtitle", "time": 4411.59, "timestamp": "01:13:31", "text": "その行だけです [笑い]"}, {"type": "subtitle", "time": 4415.189, "timestamp": "01:13:35", "text": "最初の2つはこれで終わりです。デュエットな"}]
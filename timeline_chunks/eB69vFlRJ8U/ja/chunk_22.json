[{"type": "subtitle", "time": 1320.63, "timestamp": "00:22:00", "text": "10 分ほどかかるようになります。"}, {"type": "subtitle", "time": 1323.19, "timestamp": "00:22:03", "text": "つまり、"}, {"type": "subtitle", "time": 1326.47, "timestamp": "00:22:06", "text": "YouTube API からすべてのストリームを取得するには最大 1 秒かかります。 次に、すべてのものを一つ一つ"}, {"type": "subtitle", "time": 1329.27, "timestamp": "00:22:09", "text": "マッピングする必要があります"}, {"type": "subtitle", "time": 1332.149, "timestamp": "00:22:12", "text": "。 いいえ。そうです。 うん。 最大 10"}, {"type": "subtitle", "time": 1334.87, "timestamp": "00:22:14", "text": "分かかります。内部ファイルからチェックする必要があるためです。2 つの"}, {"type": "subtitle", "time": 1338.47, "timestamp": "00:22:18", "text": "ファイルがあり、"}, {"type": "subtitle", "time": 1341.029, "timestamp": "00:22:21", "text": "1 つはメイン レジストリ、もう 1 つは"}, {"type": "subtitle", "time": 1342.95, "timestamp": "00:22:22", "text": "ストリームです。"}, {"type": "subtitle", "time": 1346.149, "timestamp": "00:22:26", "text": "はい、チェックして、チェックして、"}, {"type": "subtitle", "time": 1349.51, "timestamp": "00:22:29", "text": "次のものかどうかを確認します。これらすべての作業に"}, {"type": "subtitle", "time": 1352.87, "timestamp": "00:22:32", "text": "約 10～20 分かかります。"}, {"type": "subtitle", "time": 1356.39, "timestamp": "00:22:36", "text": "なんとかしてそれを短縮する必要があります。そのため、"}, {"type": "subtitle", "time": 1359.029, "timestamp": "00:22:39", "text": "今日のストリームのような場合には、"}, {"type": "subtitle", "time": 1365.19, "timestamp": "00:22:45", "text": "10 分前などに突然ストリームをスケジュールして [笑い]、そのまま"}, {"type": "subtitle", "time": 1367.669, "timestamp": "00:22:47", "text": "ライブ配信を開始しました。"}, {"type": "subtitle", "time": 1370.47, "timestamp": "00:22:50", "text": "現状は、"}, {"type": "subtitle", "time": 1374.47, "timestamp": "00:22:54", "text": "Discord でライブ配信中であることをアナウンスできないという状況です。"}, {"type": "subtitle", "time": 1377.27, "timestamp": "00:22:57", "text": "手動で行うことはできますが、"}, {"type": "subtitle", "time": 1379.43, "timestamp": "00:22:59", "text": "今は自動化されたセットアップができています。"}]
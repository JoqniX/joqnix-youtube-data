[{"type": "subtitle", "time": 780.629, "timestamp": "00:13:00", "text": "誕生日の男の子は元気ですか？"}, {"type": "subtitle", "time": 783.03, "timestamp": "00:13:03", "text": "試験が終わりました。 えっと、試験は全部サボったんです"}, {"type": "subtitle", "time": 789.99, "timestamp": "00:13:09", "text": "私は試験を全部サボりました。"}, {"type": "subtitle", "time": 792.069, "timestamp": "00:13:12", "text": "それはまた別の話です。"}, {"type": "subtitle", "time": 795.03, "timestamp": "00:13:15", "text": "いつかそれについて話します。 私は試験を全部サボりました"}, {"type": "subtitle", "time": 797.789, "timestamp": "00:13:17", "text": "。 うん。"}, {"type": "subtitle", "time": 799.67, "timestamp": "00:13:19", "text": "[笑い]"}, {"type": "subtitle", "time": 802.374, "timestamp": "00:13:22", "text": "そうですね、その窓はやらないでください。"}, {"type": "subtitle", "time": 803.029, "timestamp": "00:13:23", "text": "[笑い]"}, {"type": "subtitle", "time": 811.43, "timestamp": "00:13:31", "text": "。 えっと、今日はただのおしゃべりになります。"}, {"type": "subtitle", "time": 817.19, "timestamp": "00:13:37", "text": "友達が"}, {"type": "subtitle", "time": 825.43, "timestamp": "00:13:45", "text": "チェインマンの曲「ジェーン・ドゥ」のカバーデュエットをやるように誘ってきたので、歌の練習もしたかったんです。 えっと、"}, {"type": "subtitle", "time": 828.23, "timestamp": "00:13:48", "text": "男性のセリフを学ばないといけないんです。 しかし、私は"}, {"type": "subtitle", "time": 832.79, "timestamp": "00:13:52", "text": "女性のラインに沿って行きました。 うーん、"}, {"type": "subtitle", "time": 837.509, "timestamp": "00:13:57", "text": "メインラインはちょっと私には難しいです。 だから"}]
[{"type": "subtitle", "time": 1800.789, "timestamp": "00:30:00", "text": "彼らはただ"}, {"type": "subtitle", "time": 1802.789, "timestamp": "00:30:02", "text": "お互いに会話をしているだけです。 だから"}, {"type": "subtitle", "time": 1805.909, "timestamp": "00:30:05", "text": "進化するには力ずくになるのです。 ああ、そうですね、"}, {"type": "subtitle", "time": 1811.43, "timestamp": "00:30:11", "text": "バランスを取って、どうなるか見てみましょう"}, {"type": "subtitle", "time": 1817.909, "timestamp": "00:30:17", "text": "そうですね。今年は、"}, {"type": "subtitle", "time": 1822.71, "timestamp": "00:30:22", "text": "特にTwitchやKick"}, {"type": "subtitle", "time": 1826.805, "timestamp": "00:30:26", "text": "Rightなどのチャンネルで多くのことを変えることができました。 パネルの作業をしなくてはいけないんだ。"}, {"type": "subtitle", "time": 1827.75, "timestamp": "00:30:27", "text": "[笑い]"}, {"type": "subtitle", "time": 1829.83, "timestamp": "00:30:29", "text": "パネルの作業をしなければなりません。 いくつかの"}, {"type": "subtitle", "time": 1832.87, "timestamp": "00:30:32", "text": "パネルを更新する必要があります。"}, {"type": "subtitle", "time": 1836.63, "timestamp": "00:30:36", "text": "ポケモンが石を使って進化するのと同じように。"}, {"type": "subtitle", "time": 1840.549, "timestamp": "00:30:40", "text": "うん。 何てことだ。 待てよ、ポケモンの進化。"}, {"type": "subtitle", "time": 1853.51, "timestamp": "00:30:53", "text": "おお。 知りませんでした。"}]
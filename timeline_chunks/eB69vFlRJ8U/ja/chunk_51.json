[{"type": "subtitle", "time": 3061.589, "timestamp": "00:51:01", "text": "たいていYouTubeでは"}, {"type": "subtitle", "time": 3063.67, "timestamp": "00:51:03", "text": "配信をスケジュールして、"}, {"type": "subtitle", "time": 3066.71, "timestamp": "00:51:06", "text": "この日この時間に配信するとアナウンスしますよ"}, {"type": "subtitle", "time": 3070.63, "timestamp": "00:51:10", "text": "ね？本当に色々ありますよね？"}, {"type": "subtitle", "time": 3078.549, "timestamp": "00:51:18", "text": "ゴリラだと思ったんだけど。"}, {"type": "subtitle", "time": 3082.069, "timestamp": "00:51:22", "text": "日本語の試験に合格した？いいえ。えっと、"}, {"type": "subtitle", "time": 3085.829, "timestamp": "00:51:25", "text": "1月18日だよ。その試験。"}, {"type": "subtitle", "time": 3089.03, "timestamp": "00:51:29", "text": "1月18日が勉強しなきゃいけない試験で、"}, {"type": "subtitle", "time": 3091.589, "timestamp": "00:51:31", "text": "今日は"}, {"type": "subtitle", "time": 3094.39, "timestamp": "00:51:34", "text": "午後3時からオフライン授業があるんだ。だから"}, {"type": "subtitle", "time": 3098.95, "timestamp": "00:51:38", "text": "午後1時くらいには配信を終わらせて、"}, {"type": "subtitle", "time": 3105.03, "timestamp": "00:51:45", "text": "お昼を食べて準備をして帰らなきゃいけない。"}, {"type": "subtitle", "time": 3107.91, "timestamp": "00:51:47", "text": "試験は何個？たった1つだよ。"}, {"type": "subtitle", "time": 3112.71, "timestamp": "00:51:52", "text": "大学のことで、さっきまで試験があったんだ。"}, {"type": "subtitle", "time": 3116.39, "timestamp": "00:51:56", "text": "全部サボってたんだ。ある意味、"}, {"type": "subtitle", "time": 3119.43, "timestamp": "00:51:59", "text": "試験は受けてない。だって、"}]
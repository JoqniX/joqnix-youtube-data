[{"type": "subtitle", "time": 3126.47, "timestamp": "00:52:06", "text": "今から日本に行くから日本語の試験だけに集中しようって思ってたからね。だから"}, {"type": "subtitle", "time": 3128.63, "timestamp": "00:52:08", "text": "合格しなきゃいけない。"}, {"type": "subtitle", "time": 3131.349, "timestamp": "00:52:11", "text": "でも、大学の試験も"}, {"type": "subtitle", "time": 3134.71, "timestamp": "00:52:14", "text": "日本から受けられるならいいんだけど。"}, {"type": "subtitle", "time": 3137.51, "timestamp": "00:52:17", "text": "まだ確定じゃないんだ。"}, {"type": "subtitle", "time": 3146.79, "timestamp": "00:52:26", "text": "刑務所みたいな、NAT、NAT、"}, {"type": "subtitle", "time": 3149.27, "timestamp": "00:52:29", "text": "NATの試験みたいな。"}, {"type": "subtitle", "time": 3155.03, "timestamp": "00:52:35", "text": "N試験 N"}, {"type": "subtitle", "time": 3159.27, "timestamp": "00:52:39", "text": "ええ、NATを受験します。N"}, {"type": "subtitle", "time": 3162.95, "timestamp": "00:52:42", "text": "Q4を受験します。GPT"}, {"type": "subtitle", "time": 3166.309, "timestamp": "00:52:46", "text": "と同じようなものです。GPTは、えー、えー、"}, {"type": "subtitle", "time": 3175.589, "timestamp": "00:52:55", "text": "同じです。"}, {"type": "subtitle", "time": 3179.109, "timestamp": "00:52:59", "text": "なぜチャットで書いているんですか？"}]
[{"type": "subtitle", "time": 3961.829, "timestamp": "01:06:01", "text": "ああ、待って。えーと、"}, {"type": "subtitle", "time": 3965.43, "timestamp": "01:06:05", "text": "チャットを読んでいなかった。ちょっと待って。えーと、"}, {"type": "subtitle", "time": 3967.27, "timestamp": "01:06:07", "text": "どの曲？ これ？チェンソー"}, {"type": "subtitle", "time": 3969.029, "timestamp": "01:06:09", "text": "マンの曲なんだけど。た"}, {"type": "subtitle", "time": 3971.109, "timestamp": "01:06:11", "text": "こぴーのオリジナル"}, {"type": "subtitle", "time": 3975.27, "timestamp": "01:06:15", "text": "曲見たことある？いや、そのアニメは見てない。"}, {"type": "subtitle", "time": 3977.029, "timestamp": "01:06:17", "text": "えーっと、ハイライトか"}, {"type": "subtitle", "time": 3979.19, "timestamp": "01:06:19", "text": "色付けをしようと思ったんだ。新しいモデルは色付きだよ。"}, {"type": "subtitle", "time": 3982.309, "timestamp": "01:06:22", "text": "心配しないで、新しいモデル、新しい、えー、"}, {"type": "subtitle", "time": 3985.589, "timestamp": "01:06:25", "text": "衣装みたいなやつ。えーっと、もし買えるならね"}, {"type": "subtitle", "time": 3988.23, "timestamp": "01:06:28", "text": "。"}, {"type": "subtitle", "time": 3989.91, "timestamp": "01:06:29", "text": "えーっと、"}, {"type": "subtitle", "time": 3998.156, "timestamp": "01:06:38", "text": "看板がないって何て言ったらいいのか分からないけど。"}, {"type": "subtitle", "time": 3999.67, "timestamp": "01:06:39", "text": "[笑い]"}, {"type": "subtitle", "time": 4001.99, "timestamp": "01:06:41", "text": "クレイジー。わかった"}, {"type": "subtitle", "time": 4004.23, "timestamp": "01:06:44", "text": "。情報ありがとう。"}, {"type": "subtitle", "time": 4007.43, "timestamp": "01:06:47", "text": "でもね。やあ。さあ行こう。えーっと、これは"}, {"type": "subtitle", "time": 4011.19, "timestamp": "01:06:51", "text": "チェンソーマンの曲。えーっと、映画の曲、"}, {"type": "subtitle", "time": 4014.15, "timestamp": "01:06:54", "text": "Jane Do。デュエット曲なんだ。"}]
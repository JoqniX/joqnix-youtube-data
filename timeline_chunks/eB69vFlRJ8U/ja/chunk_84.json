[{"type": "subtitle", "time": 5041.11, "timestamp": "01:24:01", "text": "ええと、ええ。でも"}, {"type": "subtitle", "time": 5046.47, "timestamp": "01:24:06", "text": "大変ですが、楽しいことでもあります。"}, {"type": "subtitle", "time": 5049.91, "timestamp": "01:24:09", "text": "ええ。でも、"}, {"type": "subtitle", "time": 5052.229, "timestamp": "01:24:12", "text": "可能であれば、自分で調べた方がいいと思います。世の中にはたくさんの"}, {"type": "subtitle", "time": 5054.39, "timestamp": "01:24:14", "text": "ガイド"}, {"type": "subtitle", "time": 5062.87, "timestamp": "01:24:22", "text": "やリソースがあります。YouTubeなどで何か困難に直面している場合は、"}, {"type": "subtitle", "time": 5069.59, "timestamp": "01:24:29", "text": "ビデオなどだけを作りたい場合など、お気軽にご相談ください。いいえ、そこにもあります。念のため、"}, {"type": "subtitle", "time": 5077.608, "timestamp": "01:24:37", "text": "そこにあるものすべてをご承知おきください。 うん。"}, {"type": "subtitle", "time": 5082.79, "timestamp": "01:24:42", "text": "アドバイスとしては、"}, {"type": "subtitle", "time": 5084.87, "timestamp": "01:24:44", "text": "Twitterはやめた方がいいよ。[笑い]"}, {"type": "subtitle", "time": 5093.83, "timestamp": "01:24:53", "text": "うん、つまりTwitterは"}, {"type": "subtitle", "time": 5099.43, "timestamp": "01:24:59", "text": "アルゴリズムとかネットワーキングとか、そういうのを入手できる唯一の方法だからね"}]
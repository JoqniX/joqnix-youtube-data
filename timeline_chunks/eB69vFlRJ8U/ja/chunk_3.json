[{"type": "subtitle", "time": 180.869, "timestamp": "00:03:00", "text": "こんにちは、みんな。"}, {"type": "subtitle", "time": 187.322, "timestamp": "00:03:07", "text": "ああ、待って。 つまり、オハイオです。"}, {"type": "subtitle", "time": 188.79, "timestamp": "00:03:08", "text": "[笑い]"}, {"type": "subtitle", "time": 197.11, "timestamp": "00:03:17", "text": "。 こんにちは、みんな。 みなさんはお元気ですか"}, {"type": "subtitle", "time": 200.07, "timestamp": "00:03:20", "text": "？"}, {"type": "subtitle", "time": 202.869, "timestamp": "00:03:22", "text": "こんにちは。 こんにちは。"}, {"type": "subtitle", "time": 205.27, "timestamp": "00:03:25", "text": "うん。 さよなら。  [笑い声] もう"}, {"type": "subtitle", "time": 212.47, "timestamp": "00:03:32", "text": "新年です。私たち全員にとって新しい年です。"}, {"type": "subtitle", "time": 213.99, "timestamp": "00:03:33", "text": "約"}, {"type": "subtitle", "time": 216.47, "timestamp": "00:03:36", "text": "1秒です。   ああそうだ"}, {"type": "subtitle", "time": 219.99, "timestamp": "00:03:39", "text": "、今日のストリームは"}, {"type": "subtitle", "time": 229.67000000000002, "timestamp": "00:03:49", "text": "午後 2 時前にどこかに行かなければならないので短くなります。"}, {"type": "subtitle", "time": 234.949, "timestamp": "00:03:54", "text": "午後2時までにどこかに行かなければなりません。 ということで、"}, {"type": "subtitle", "time": 238.309, "timestamp": "00:03:58", "text": "これは短いストリームになります。   何をすればいいのかわからなかったので、"}]
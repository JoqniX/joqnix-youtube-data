[{"type": "subtitle", "time": 6728.07, "timestamp": "01:52:08", "text": "ええ、次のストリームでは、"}, {"type": "subtitle", "time": 6732.629, "timestamp": "01:52:12", "text": "何とかしてこれをすべて修正する必要があります。明けましておめでとうございます、ええ、あなたにも新年おめでとうございます。Mad"}, {"type": "subtitle", "time": 6736.629, "timestamp": "01:52:16", "text": "Dog、"}, {"type": "subtitle", "time": 6745.03, "timestamp": "01:52:25", "text": "今年もあなたにとって良い年になることを願っています"}, {"type": "subtitle", "time": 6754.629, "timestamp": "01:52:34", "text": "。 もう"}, {"type": "subtitle", "time": 6757.35, "timestamp": "01:52:37", "text": "2時間経ちます。 それでは、ここで終わりにしたいと思います。"}, {"type": "subtitle", "time": 6760.229, "timestamp": "01:52:40", "text": "技術的な問題もありますが、仕方ないですね"}, {"type": "subtitle", "time": 6762.95, "timestamp": "01:52:42", "text": "。 それはゴリラの"}, {"type": "subtitle", "time": 6765.589, "timestamp": "01:52:45", "text": "ストリームでした。"}, {"type": "subtitle", "time": 6769.189, "timestamp": "01:52:49", "text": "今日は予定外の配信でした。 うーん、そうですね。"}, {"type": "subtitle", "time": 6771.109, "timestamp": "01:52:51", "text": "楽しんでいただけたでしょうか。"}, {"type": "subtitle", "time": 6774.229, "timestamp": "01:52:54", "text": "本日お越しいただいた皆様ありがとうございました。 それは"}, {"type": "subtitle", "time": 6777.51, "timestamp": "01:52:57", "text": "本当に大きな意味があります。   何てことだ"}]
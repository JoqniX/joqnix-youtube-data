[{"type": "subtitle", "time": 3245.75, "timestamp": "00:54:05", "text": "日本語に入学できるということです。でも、よくわかりません"}, {"type": "subtitle", "time": 3249.19, "timestamp": "00:54:09", "text": "。私はもう合格しました。もう"}, {"type": "subtitle", "time": 3255.27, "timestamp": "00:54:15", "text": "学校に選ばれています。ただ、"}, {"type": "subtitle", "time": 3258.87, "timestamp": "00:54:18", "text": "ビザとかが切れたら心配です。"}, {"type": "subtitle", "time": 3264.63, "timestamp": "00:54:24", "text": "えっと、去年は"}, {"type": "subtitle", "time": 3269.67, "timestamp": "00:54:29", "text": "延期されたから、今年はちゃんと行けると思う。いや、"}, {"type": "subtitle", "time": 3272.95, "timestamp": "00:54:32", "text": "次の入学時期である"}, {"type": "subtitle", "time": 3275.99, "timestamp": "00:54:35", "text": "2026年4月まで待たないといけないって言われたんだ。"}, {"type": "subtitle", "time": 3278.39, "timestamp": "00:54:38", "text": "うん、少なくとも今年は"}, {"type": "subtitle", "time": 3280.23, "timestamp": "00:54:40", "text": "行けるといいな。いや、[笑い]"}, {"type": "subtitle", "time": 3283.75, "timestamp": "00:54:43", "text": "1年待ったよ。でも、もし今"}, {"type": "subtitle", "time": 3290.069, "timestamp": "00:54:50", "text": "日本に行ったら、日本にいる間は"}, {"type": "subtitle", "time": 3294.39, "timestamp": "00:54:54", "text": "6ヶ月間は配信できないと思うんだ。"}, {"type": "subtitle", "time": 3298.39, "timestamp": "00:54:58", "text": "学校も寮も厳しいし、騒音"}]
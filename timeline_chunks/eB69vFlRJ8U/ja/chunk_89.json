[{"type": "subtitle", "time": 5340.629, "timestamp": "01:29:00", "text": "押したかな？えーと、"}, {"type": "subtitle", "time": 5343.189, "timestamp": "01:29:03", "text": "何かしたかな？ えっと、"}, {"type": "subtitle", "time": 5344.87, "timestamp": "01:29:04", "text": "縛り付けてなかったよ。"}, {"type": "subtitle", "time": 5357.59, "timestamp": "01:29:17", "text": "。バイバイ。"}, {"type": "subtitle", "time": 5364.629, "timestamp": "01:29:24", "text": "歌っちゃったんだ[鼻で笑う]。うん。うん。"}, {"type": "subtitle", "time": 5366.229, "timestamp": "01:29:26", "text": "うん。カバーがあるからこの曲を習ってるんだ"}, {"type": "subtitle", "time": 5368.39, "timestamp": "01:29:28", "text": "。友達とカバー曲をやらなきゃいけないから、1ヶ月以内に習わなきゃ"}, {"type": "subtitle", "time": 5375.43, "timestamp": "01:29:35", "text": "。それで、"}]
[{"type": "subtitle", "time": 2043.43, "timestamp": "00:34:03", "text": "何だそれは素晴らしいアイデアだ。"}, {"type": "subtitle", "time": 2047.11, "timestamp": "00:34:07", "text": "ああ、それは本当にいいですね。"}, {"type": "subtitle", "time": 2050.47, "timestamp": "00:34:10", "text": "でも正直いいと思うよ、"}, {"type": "subtitle", "time": 2054.869, "timestamp": "00:34:14", "text": "自分のコミュニティと自分のジョックニックの"}, {"type": "subtitle", "time": 2056.869, "timestamp": "00:34:16", "text": "主とすべてが欲しいから。 いいえ、"}, {"type": "subtitle", "time": 2060.79, "timestamp": "00:34:20", "text": "ARPG のようなセット設定で [音楽] のように、"}, {"type": "subtitle", "time": 2063.349, "timestamp": "00:34:23", "text": "パンくずを見つけてつなぎ合わせて、"}, {"type": "subtitle", "time": 2069.589, "timestamp": "00:34:29", "text": "秘密のストーリー ラインや隠された"}, {"type": "subtitle", "time": 2072.149, "timestamp": "00:34:32", "text": "ラインなどを理解するようにします。 そういうもの"}, {"type": "subtitle", "time": 2074.79, "timestamp": "00:34:34", "text": "。 でも、そうだったらいいですね。"}, {"type": "subtitle", "time": 2081.109, "timestamp": "00:34:41", "text": "これらすべてのことについて、考えなければなりません。 いや、"}, {"type": "subtitle", "time": 2083.909, "timestamp": "00:34:43", "text": "正直嬉しいです。 そうですね、"}, {"type": "subtitle", "time": 2086.71, "timestamp": "00:34:46", "text": "新しい衣装が公開される前に準備しておこうと思います"}, {"type": "subtitle", "time": 2089.99, "timestamp": "00:34:49", "text": "。 えっと、その"}, {"type": "subtitle", "time": 2093.75, "timestamp": "00:34:53", "text": "モデルの衣装ができたらお見せします。 そうですね、"}, {"type": "subtitle", "time": 2096.71, "timestamp": "00:34:56", "text": "全部準備しておいた方がいいですね。   そうできると"}, {"type": "subtitle", "time": 2099.27, "timestamp": "00:34:59", "text": "いいのですが。"}]
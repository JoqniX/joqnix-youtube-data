[{"type": "subtitle", "time": 2164.71, "timestamp": "00:36:04", "text": "ああ、デモタルができればいいのに、"}, {"type": "subtitle", "time": 2171.51, "timestamp": "00:36:11", "text": "僕は"}, {"type": "subtitle", "time": 2173.27, "timestamp": "00:36:13", "text": "伝承の中にいるようなもので、"}, {"type": "subtitle", "time": 2177.51, "timestamp": "00:36:17", "text": "文書化したくないんです。ああ、"}, {"type": "subtitle", "time": 2183.19, "timestamp": "00:36:23", "text": "ファンタジーの世界にいるみたいに、"}, {"type": "subtitle", "time": 2186.15, "timestamp": "00:36:26", "text": "転生したり召喚されたりしたらいいな、みたいなことを"}, {"type": "subtitle", "time": 2189.03, "timestamp": "00:36:29", "text": "そこに投げ込んでいるような。でも"}, {"type": "subtitle", "time": 2194.39, "timestamp": "00:36:34", "text": "今はどこでもそういうのを目にするから、そういう"}, {"type": "subtitle", "time": 2199.03, "timestamp": "00:36:39", "text": "設定にはしたくないんです。そうだね"}, {"type": "subtitle", "time": 2204.15, "timestamp": "00:36:44", "text": "もし僕が設定で行くなら、えーっと、えーっと、どんな感じかっていう設定にしたいなと思う。"}, {"type": "subtitle", "time": 2212.79, "timestamp": "00:36:52", "text": "それは、たとえば、"}]
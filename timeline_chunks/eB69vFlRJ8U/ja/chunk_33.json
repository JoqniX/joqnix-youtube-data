[{"type": "subtitle", "time": 1982.149, "timestamp": "00:33:02", "text": "だから、"}, {"type": "subtitle", "time": 1984.87, "timestamp": "00:33:04", "text": "私はただの星座のようなもので、いくつかの"}, {"type": "subtitle", "time": 1989.19, "timestamp": "00:33:09", "text": "力やら何やらを持っているのですが、まるで自分"}, {"type": "subtitle", "time": 1995.669, "timestamp": "00:33:15", "text": "自身をアニメか何かの中に登場させたいと思ったのです"}, {"type": "subtitle", "time": 1997.83, "timestamp": "00:33:17", "text": "。 いや、もうすでに強力すぎる、えーっと、吐き気がするようなことはしたくないですよね"}, {"type": "subtitle", "time": 2002.789, "timestamp": "00:33:22", "text": "？ そんなことはしたくない"}, {"type": "subtitle", "time": 2004.549, "timestamp": "00:33:24", "text": "。"}, {"type": "subtitle", "time": 2007.909, "timestamp": "00:33:27", "text": "私はただゼロからスタートして、"}, {"type": "subtitle", "time": 2011.11, "timestamp": "00:33:31", "text": "自分の力みたいなものを手に入れたいと思っています"}, {"type": "subtitle", "time": 2015.43, "timestamp": "00:33:35", "text": "。 それはいいですね。   ああ"}, {"type": "subtitle", "time": 2017.269, "timestamp": "00:33:37", "text": "、全体を改修しなければなりません"}, {"type": "subtitle", "time": 2025.669, "timestamp": "00:33:45", "text": "そうですね。"}, {"type": "subtitle", "time": 2029.19, "timestamp": "00:33:49", "text": "うん。 ああ、それはいいですね。 いいえ。ええ。 まるで"}, {"type": "subtitle", "time": 2035.029, "timestamp": "00:33:55", "text": "私が次の何かに選ばれたかのようでした"}, {"type": "subtitle", "time": 2038.95, "timestamp": "00:33:58", "text": "。 何てことだ。 待って。"}]
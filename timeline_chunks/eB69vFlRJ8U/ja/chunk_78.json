[{"type": "subtitle", "time": 4692.79, "timestamp": "01:18:12", "text": "ここ。私も"}, {"type": "subtitle", "time": 4696.39, "timestamp": "01:18:16", "text": "インドのYouTuberになろうとしているんだ。ああ、頑張って。頑張って。頑張って。"}, {"type": "subtitle", "time": 4725.91, "timestamp": "01:18:45", "text": "インドのYouTuberにはいいことも悪いこともあるけど、"}, {"type": "subtitle", "time": 4727.83, "timestamp": "01:18:47", "text": "君がもっと上手くやれることを願ってる"}, {"type": "subtitle", "time": 4730.07, "timestamp": "01:18:50", "text": "。心配しないで、大丈夫だよ。"}, {"type": "subtitle", "time": 4736.149, "timestamp": "01:18:56", "text": "うん。6年くらいYouTuberをやってきた僕から言えるアドバイスは、自分のやりたい"}]
[{"type": "subtitle", "time": 3302.87, "timestamp": "00:55:02", "text": "苦情も厳しいから。"}, {"type": "subtitle", "time": 3305.19, "timestamp": "00:55:05", "text": "もし捕まったら、"}, {"type": "subtitle", "time": 3310.069, "timestamp": "00:55:10", "text": "誰かが「うるさいよ」"}, {"type": "subtitle", "time": 3312.63, "timestamp": "00:55:12", "text": "とか「この"}, {"type": "subtitle", "time": 3315.109, "timestamp": "00:55:15", "text": "人変だ、夜中に大声で叫んだり、わめいたり、"}, {"type": "subtitle", "time": 3317.99, "timestamp": "00:55:17", "text": "喋ったりして」とか文句を言ったら、もう大変だよ"}, {"type": "subtitle", "time": 3319.349, "timestamp": "00:55:19", "text": "。平和がほしいんだ。もし誰かが"}, {"type": "subtitle", "time": 3322.188, "timestamp": "00:55:22", "text": "文句を言ったら、もう、もう大変だよ。"}, {"type": "subtitle", "time": 3323.91, "timestamp": "00:55:23", "text": "[笑い] 配信できないと思うよ。"}, {"type": "subtitle", "time": 3325.589, "timestamp": "00:55:25", "text": "[息を呑む]"}, {"type": "subtitle", "time": 3330.549, "timestamp": "00:55:30", "text": "警告とか受けたら、"}, {"type": "subtitle", "time": 3333.19, "timestamp": "00:55:33", "text": "気をつけなきゃいけない。"}, {"type": "subtitle", "time": 3335.109, "timestamp": "00:55:35", "text": "ルールを破ったら、"}, {"type": "subtitle", "time": 3337.99, "timestamp": "00:55:37", "text": "インドに強制送還されると思う。"}, {"type": "subtitle", "time": 3340.79, "timestamp": "00:55:40", "text": "そう、 厳しい学校なんだ。だから"}, {"type": "subtitle", "time": 3343.91, "timestamp": "00:55:43", "text": "気をつけなきゃ。"}, {"type": "subtitle", "time": 3349.19, "timestamp": "00:55:49", "text": "どうなるか分からないけど、せめて"}, {"type": "subtitle", "time": 3352.15, "timestamp": "00:55:52", "text": "動画をアップロードするか、"}, {"type": "subtitle", "time": 3355.03, "timestamp": "00:55:55", "text": "録画するかはするよ。今はそれしか"}, {"type": "subtitle", "time": 3356.789, "timestamp": "00:55:56", "text": "考えて"}]
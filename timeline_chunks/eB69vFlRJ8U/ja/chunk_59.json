[{"type": "subtitle", "time": 3544.069, "timestamp": "00:59:04", "text": "。何が ちくしょう？何？"}, {"type": "subtitle", "time": 3547.51, "timestamp": "00:59:07", "text": "大丈夫？"}, {"type": "subtitle", "time": 3581.27, "timestamp": "00:59:41", "text": "よし、あのクキをやろう。わかった。えっと、"}, {"type": "subtitle", "time": 3585.349, "timestamp": "00:59:45", "text": "歌を覚えてみよう。"}, {"type": "subtitle", "time": 3588.121, "timestamp": "00:59:48", "text": "ああ、忘れてた。[笑い]"}, {"type": "subtitle", "time": 3589.27, "timestamp": "00:59:49", "text": "[息を呑む]"}, {"type": "subtitle", "time": 3591.349, "timestamp": "00:59:51", "text": "もうクリスマスじゃないんだ。だから、"}]
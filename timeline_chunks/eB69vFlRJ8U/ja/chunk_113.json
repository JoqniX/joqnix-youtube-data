[{"type": "subtitle", "time": 6781.189, "timestamp": "01:53:01", "text": "。 二人とも、私に"}, {"type": "subtitle", "time": 6788.47, "timestamp": "01:53:08", "text": "このバグは報告しないといけない。 ほかに何か"}, {"type": "subtitle", "time": 6790.149, "timestamp": "01:53:10", "text": "？ マルチ"}, {"type": "subtitle", "time": 6793.35, "timestamp": "01:53:13", "text": "ストリーミングプラットフォームをこれに切り替える必要があります。 だから"}, {"type": "subtitle", "time": 6795.91, "timestamp": "01:53:15", "text": "サービスです。"}, {"type": "subtitle", "time": 6798.87, "timestamp": "01:53:18", "text": "ああ、"}, {"type": "subtitle", "time": 6801.99, "timestamp": "01:53:21", "text": "2秒ごとにライブストリームがオフラインになります。  （笑い）"}, {"type": "subtitle", "time": 6804.149, "timestamp": "01:53:24", "text": "とにかく、今日来てくださった皆様ありがとうございました"}, {"type": "subtitle", "time": 6806.629, "timestamp": "01:53:26", "text": "。 えっと、本当に楽しかったです。 本当に"}, {"type": "subtitle", "time": 6808.55, "timestamp": "01:53:28", "text": "本当に楽しいです。"}, {"type": "subtitle", "time": 6812.07, "timestamp": "01:53:32", "text": "皆さん楽しんでいただけたでしょうか。 楽しむ。"}, {"type": "subtitle", "time": 6814.47, "timestamp": "01:53:34", "text": "皆さん気をつけて楽しんでくださいね。"}, {"type": "subtitle", "time": 6817.35, "timestamp": "01:53:37", "text": "こんにちは。 次回のストリームでお会いしましょう。 えーと、"}, {"type": "subtitle", "time": 6819.91, "timestamp": "01:53:39", "text": "おそらく"}, {"type": "subtitle", "time": 6822.87, "timestamp": "01:53:42", "text": "今夜後、今日の遅くにストリーミング配信しようと思います。"}, {"type": "subtitle", "time": 6824.87, "timestamp": "01:53:44", "text": "約束はできません。 ああ、"}, {"type": "subtitle", "time": 6828.229, "timestamp": "01:53:48", "text": "また予想外のことが起きそうだ。 うーん、そうですね、気をつけてください"}, {"type": "subtitle", "time": 6829.99, "timestamp": "01:53:49", "text": "。   気をつけてね"}, {"type": "subtitle", "time": 6833.35, "timestamp": "01:53:53", "text": "。"}, {"type": "subtitle", "time": 6837.669, "timestamp": "01:53:57", "text": "今夜か明日、同じ"}]
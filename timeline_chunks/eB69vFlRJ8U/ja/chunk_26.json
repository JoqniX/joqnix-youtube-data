[{"type": "subtitle", "time": 1560.95, "timestamp": "00:26:00", "text": "この24時間チャンネルについて何かやろうと思っています"}, {"type": "subtitle", "time": 1565.59, "timestamp": "00:26:05", "text": "。 ええと、正直に言うと、出発する前に、いくつかの"}, {"type": "subtitle", "time": 1586.07, "timestamp": "00:26:26", "text": "。 そうですね、今年は"}, {"type": "subtitle", "time": 1588.63, "timestamp": "00:26:28", "text": "もっとビデオを作ろうと思います。 それが私がやろうとしていることの一つです"}, {"type": "subtitle", "time": 1591.269, "timestamp": "00:26:31", "text": "。 それほど"}, {"type": "subtitle", "time": 1593.669, "timestamp": "00:26:33", "text": "質が良いわけではないのですが、"}, {"type": "subtitle", "time": 1595.51, "timestamp": "00:26:35", "text": "とりあえず"}, {"type": "subtitle", "time": 1599.269, "timestamp": "00:26:39", "text": "個人のブログか何かにして、"}, {"type": "subtitle", "time": 1601.75, "timestamp": "00:26:41", "text": "どうなるか見てみようと思ったのです。"}, {"type": "subtitle", "time": 1606.549, "timestamp": "00:26:46", "text": "うーん、良いリソースや"}, {"type": "subtitle", "time": 1609.669, "timestamp": "00:26:49", "text": "あれこれの準備ができたら、もっと"}, {"type": "subtitle", "time": 1613.51, "timestamp": "00:26:53", "text": "独白的なものを作れるようになるので、それが私のやりたいことなんです。"}, {"type": "subtitle", "time": 1617.909, "timestamp": "00:26:57", "text": "うん。 昨日、神迫のコンサートを観ていたのですが、本当にたくさんの"}]
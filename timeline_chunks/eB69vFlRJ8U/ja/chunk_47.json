[{"type": "subtitle", "time": 2830.63, "timestamp": "00:47:10", "text": "十分に上達してカバーできるようになるまで、あと1か月ほど勉強する必要があるので、大丈夫だと思いました"}, {"type": "subtitle", "time": 2835.91, "timestamp": "00:47:15", "text": "しかし、オーディオのセットアップに苦労しているんです"}, {"type": "subtitle", "time": 2837.43, "timestamp": "00:47:17", "text": "。"}, {"type": "subtitle", "time": 2840.309, "timestamp": "00:47:20", "text": "私のオーディオは本当にブーです。   自分が"}, {"type": "subtitle", "time": 2855.109, "timestamp": "00:47:35", "text": "望むサウンドを出すためには、エフェクトなどポストセクションポストをたくさん使用する必要があると思います。"}, {"type": "subtitle", "time": 2858.39, "timestamp": "00:47:38", "text": "時々マイクのピークが出る時とか。 いいえ、それは嫌いです"}, {"type": "subtitle", "time": 2872.47, "timestamp": "00:47:52", "text": "感傷的な息子。 こんにちは。"}]
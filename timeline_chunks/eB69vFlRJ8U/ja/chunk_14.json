[{"type": "subtitle", "time": 841.99, "timestamp": "00:14:01", "text": "それを練習しないといけないんです。 それで最近、"}, {"type": "subtitle", "time": 854.87, "timestamp": "00:14:14", "text": "そしてまた、ええと、今日は"}, {"type": "subtitle", "time": 857.11, "timestamp": "00:14:17", "text": "1 月 3 日です。"}, {"type": "subtitle", "time": 858.629, "timestamp": "00:14:18", "text": "えーっと、"}, {"type": "subtitle", "time": 867.11, "timestamp": "00:14:27", "text": "5日か明日までにビデオをアップロードできると思います。"}, {"type": "subtitle", "time": 871.43, "timestamp": "00:14:31", "text": "えっと、"}, {"type": "subtitle", "time": 874.15, "timestamp": "00:14:34", "text": "私のモデルとしての状況について話すビデオがあります。"}, {"type": "subtitle", "time": 878.23, "timestamp": "00:14:38", "text": "可能であれば、"}, {"type": "subtitle", "time": 882.629, "timestamp": "00:14:42", "text": "ライブ 2D モデルをもう一度使用して、そのビデオを作成したいと考えていました。"}, {"type": "subtitle", "time": 884.25, "timestamp": "00:14:44", "text": "あ、"}, {"type": "subtitle", "time": 885.03, "timestamp": "00:14:45", "text": "（笑）"}, {"type": "subtitle", "time": 887.509, "timestamp": "00:14:47", "text": "会員になっていただきありがとうございます。"}]
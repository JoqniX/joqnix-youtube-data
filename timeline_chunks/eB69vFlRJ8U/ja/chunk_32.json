[{"type": "subtitle", "time": 1921.782, "timestamp": "00:32:01", "text": "?"}, {"type": "subtitle", "time": 1922.389, "timestamp": "00:32:02", "text": "[笑い]"}, {"type": "subtitle", "time": 1928.549, "timestamp": "00:32:08", "text": "実のところ分かりません。  H いい質問ですね。"}, {"type": "subtitle", "time": 1938.47, "timestamp": "00:32:18", "text": "私は星座です。 はぁ？ それで、"}, {"type": "subtitle", "time": 1943.509, "timestamp": "00:32:23", "text": "何に進化するのでしょうか?   つまり、"}, {"type": "subtitle", "time": 1946.95, "timestamp": "00:32:26", "text": "次の進化は、"}, {"type": "subtitle", "time": 1949.11, "timestamp": "00:32:29", "text": "リークするべきかどうかということです。 わからない"}, {"type": "subtitle", "time": 1952.149, "timestamp": "00:32:32", "text": "。 でも、そうですね、"}, {"type": "subtitle", "time": 1955.35, "timestamp": "00:32:35", "text": "私は実体になります。"}, {"type": "subtitle", "time": 1957.99, "timestamp": "00:32:37", "text": "えっと、星座なので"}, {"type": "subtitle", "time": 1960.389, "timestamp": "00:32:40", "text": "役割を与えられます。"}, {"type": "subtitle", "time": 1965.35, "timestamp": "00:32:45", "text": "えっと、その後、"}, {"type": "subtitle", "time": 1967.909, "timestamp": "00:32:47", "text": "その"}, {"type": "subtitle", "time": 1970.47, "timestamp": "00:32:50", "text": "銀河では何が起こるんですか? 分かりません（笑）。"}, {"type": "subtitle", "time": 1974.95, "timestamp": "00:32:54", "text": "つまり、私は実際のところ、"}, {"type": "subtitle", "time": 1977.83, "timestamp": "00:32:57", "text": "自分の下位のものの進化についてはあまり考えていないのです"}, {"type": "subtitle", "time": 1979.75, "timestamp": "00:32:59", "text": "。"}]
[{"type": "subtitle", "time": 3523.03, "timestamp": "00:58:43", "text": "是的，没事了。他什么也没看到"}, {"type": "subtitle", "time": 3526.47, "timestamp": "00:58:46", "text": "。哦，对不起。"}, {"type": "subtitle", "time": 3529.51, "timestamp": "00:58:49", "text": "我当时正在整理东西，然后就出事了"}, {"type": "subtitle", "time": 3532.47, "timestamp": "00:58:52", "text": "。（倒吸一口凉气）是的。"}, {"type": "subtitle", "time": 3534.71, "timestamp": "00:58:54", "text": "我去了镇上的一个家，"}, {"type": "subtitle", "time": 3537.51, "timestamp": "00:58:57", "text": "和我的父母分开了，他们当时在外面。呃，"}, {"type": "subtitle", "time": 3539.349, "timestamp": "00:58:59", "text": "据我所知，我两天后醒来"}]
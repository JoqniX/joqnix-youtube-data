[{"type": "subtitle", "time": 3606.63, "timestamp": "01:00:06", "text": "我永远不会喝酒。嗨。嗨。"}, {"type": "subtitle", "time": 3609.349, "timestamp": "01:00:09", "text": "我们来做那个唱歌"}, {"type": "subtitle", "time": 3611.27, "timestamp": "01:00:11", "text": "练习吧。呃，因为我必须"}, {"type": "subtitle", "time": 3613.75, "timestamp": "01:00:13", "text": "在一个月内学会Jane这首歌。"}, {"type": "subtitle", "time": 3616.789, "timestamp": "01:00:16", "text": "呃，为了合唱翻唱。"}, {"type": "subtitle", "time": 3618.47, "timestamp": "01:00:18", "text": "是的。"}, {"type": "subtitle", "time": 3639.03, "timestamp": "01:00:39", "text": "一切都卡顿了。"}, {"type": "subtitle", "time": 3658.63, "timestamp": "01:00:58", "text": "没有引导旋律。好的。这个有"}]
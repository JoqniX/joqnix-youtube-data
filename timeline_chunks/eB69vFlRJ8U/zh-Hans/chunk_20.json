[{"type": "subtitle", "time": 1214.373, "timestamp": "00:20:14", "text": "你有一台电脑吗？ 我没有。"}, {"type": "subtitle", "time": 1215.19, "timestamp": "00:20:15", "text": "[笑声]"}, {"type": "subtitle", "time": 1219.51, "timestamp": "00:20:19", "text": "我有一台电脑。 我在等我的……嗯……这个"}, {"type": "subtitle", "time": 1234.87, "timestamp": "00:20:34", "text": "，今年我将"}, {"type": "subtitle", "time": 1237.669, "timestamp": "00:20:37", "text": "在日本受苦。 但我"}, {"type": "subtitle", "time": 1246.149, "timestamp": "00:20:46", "text": "现在要享受并学习这个反复试验的过程。"}, {"type": "subtitle", "time": 1248.434, "timestamp": "00:20:48", "text": "是啊，今年真是令人期待。"}, {"type": "subtitle", "time": 1253.83, "timestamp": "00:20:53", "text": "我会尽我所能联系"}, {"type": "subtitle", "time": 1256.95, "timestamp": "00:20:56", "text": "更多"}, {"type": "subtitle", "time": 1259.19, "timestamp": "00:20:59", "text": "愿意和"}]
[{"type": "subtitle", "time": 1982.149, "timestamp": "00:33:02", "text": "所以"}, {"type": "subtitle", "time": 1984.87, "timestamp": "00:33:04", "text": "我只是一个拥有"}, {"type": "subtitle", "time": 1989.19, "timestamp": "00:33:09", "text": "一些力量之类的星座之类的东西，"}, {"type": "subtitle", "time": 1993.269, "timestamp": "00:33:13", "text": "但我想要的是，如果我把"}, {"type": "subtitle", "time": 1995.669, "timestamp": "00:33:15", "text": "自己带入动漫之类的作品中会是什么样子"}, {"type": "subtitle", "time": 1997.83, "timestamp": "00:33:17", "text": "。 不，我不想用"}, {"type": "subtitle", "time": 2000.71, "timestamp": "00:33:20", "text": "那种已经威力过大的"}, {"type": "subtitle", "time": 2002.789, "timestamp": "00:33:22", "text": "呕吐物，对吧？ 我不想那样"}, {"type": "subtitle", "time": 2004.549, "timestamp": "00:33:24", "text": "做。"}, {"type": "subtitle", "time": 2007.909, "timestamp": "00:33:27", "text": "我只想从零开始，"}, {"type": "subtitle", "time": 2011.11, "timestamp": "00:33:31", "text": "然后一步步获得我想要的那种权力"}, {"type": "subtitle", "time": 2015.43, "timestamp": "00:33:35", "text": "。 那太好了。"}, {"type": "subtitle", "time": 2017.269, "timestamp": "00:33:37", "text": "天哪，我得把那里的一切都改头换面"}, {"type": "subtitle", "time": 2025.669, "timestamp": "00:33:45", "text": "。   是的"}, {"type": "subtitle", "time": 2029.19, "timestamp": "00:33:49", "text": "。 哦，那太好了。 不。是的"}, {"type": "subtitle", "time": 2035.029, "timestamp": "00:33:55", "text": "。 感觉就像我被选中成为下一个什么人或事"}, {"type": "subtitle", "time": 2038.95, "timestamp": "00:33:58", "text": "一样。 我的天啊。 等待。"}]
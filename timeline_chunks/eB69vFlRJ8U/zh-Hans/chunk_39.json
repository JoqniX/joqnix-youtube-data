[{"type": "subtitle", "time": 2342.31, "timestamp": "00:39:02", "text": "是啊，这周我什么都没做。 我"}, {"type": "subtitle", "time": 2345.589, "timestamp": "00:39:05", "text": "根本没碰过那个游戏。 我之前"}, {"type": "subtitle", "time": 2347.19, "timestamp": "00:39:07", "text": "看过"}, {"type": "subtitle", "time": 2349.99, "timestamp": "00:39:09", "text": "其他主播玩这款游戏，但我"}, {"type": "subtitle", "time": 2353.91, "timestamp": "00:39:13", "text": "现在也得自己玩了。"}, {"type": "subtitle", "time": 2357.51, "timestamp": "00:39:17", "text": "我唯一倒霉的时候"}, {"type": "subtitle", "time": 2360.87, "timestamp": "00:39:20", "text": "就是每次尝试直播的时候，"}, {"type": "subtitle", "time": 2365.829, "timestamp": "00:39:25", "text": "运气都很差。 我死得很快。"}, {"type": "subtitle", "time": 2369.99, "timestamp": "00:39:29", "text": "呃，因为我的电脑运行吃力。 不，这款"}, {"type": "subtitle", "time": 2372.63, "timestamp": "00:39:32", "text": "游戏对"}, {"type": "subtitle", "time": 2375.51, "timestamp": "00:39:35", "text": "我的电脑来说有点吃配置。 就是"}, {"type": "subtitle", "time": 2388.87, "timestamp": "00:39:48", "text": "不。呃，什么？ 什么？"}, {"type": "subtitle", "time": 2393.75, "timestamp": "00:39:53", "text": "等等，什么？ 那可是个爆炸性新闻。 什么？"}]
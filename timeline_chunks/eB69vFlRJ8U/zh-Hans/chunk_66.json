[{"type": "subtitle", "time": 3961.829, "timestamp": "01:06:01", "text": "哦，等等。呃，"}, {"type": "subtitle", "time": 3965.43, "timestamp": "01:06:05", "text": "我没看聊天记录。稍等一下。呃，"}, {"type": "subtitle", "time": 3967.27, "timestamp": "01:06:07", "text": "这是什么歌？这是《电锯"}, {"type": "subtitle", "time": 3969.029, "timestamp": "01:06:09", "text": "人》的主题曲。"}, {"type": "subtitle", "time": 3971.109, "timestamp": "01:06:11", "text": "你看过Takopi的原版"}, {"type": "subtitle", "time": 3975.27, "timestamp": "01:06:15", "text": "歌曲吗？没有，我没看过。 动漫。"}, {"type": "subtitle", "time": 3977.029, "timestamp": "01:06:17", "text": "呃，我想过高光或者"}, {"type": "subtitle", "time": 3979.19, "timestamp": "01:06:19", "text": "上色。新模型是彩色的。"}, {"type": "subtitle", "time": 3982.309, "timestamp": "01:06:22", "text": "别担心，新模型，新的……呃，"}, {"type": "subtitle", "time": 3985.589, "timestamp": "01:06:25", "text": "服装什么的。呃，如果我能买得起的话"}, {"type": "subtitle", "time": 3988.23, "timestamp": "01:06:28", "text": "。"}, {"type": "subtitle", "time": 3989.91, "timestamp": "01:06:29", "text": "呃，"}, {"type": "subtitle", "time": 3998.156, "timestamp": "01:06:38", "text": "我不知道该怎么形容没有标志的情况。"}, {"type": "subtitle", "time": 3999.67, "timestamp": "01:06:39", "text": "[笑] 太"}, {"type": "subtitle", "time": 4001.99, "timestamp": "01:06:41", "text": "疯狂了。"}, {"type": "subtitle", "time": 4004.23, "timestamp": "01:06:44", "text": "好的。谢谢你提供的信息。"}, {"type": "subtitle", "time": 4007.43, "timestamp": "01:06:47", "text": "但是，是的。嗨。我们开始吧。呃，这是一首《"}, {"type": "subtitle", "time": 4011.19, "timestamp": "01:06:51", "text": "电锯人》的歌。呃，电影歌曲《"}, {"type": "subtitle", "time": 4014.15, "timestamp": "01:06:54", "text": "Jane Do》。这是一首二重唱。"}]
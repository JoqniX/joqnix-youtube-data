[{"type": "subtitle", "time": 1385.35, "timestamp": "00:23:05", "text": "。 再见。 你独居还是和"}, {"type": "subtitle", "time": 1387.35, "timestamp": "00:23:07", "text": "家人同住？ 与家人在一起。 与家人在一起。 但这就像是"}, {"type": "subtitle", "time": 1390.39, "timestamp": "00:23:10", "text": "我为Jockn准备的办公空间。"}, {"type": "subtitle", "time": 1394.07, "timestamp": "00:23:14", "text": "我称之为我的Jocknik总部。"}, {"type": "subtitle", "time": 1397.11, "timestamp": "00:23:17", "text": "嗯，不过等我在日本安顿下来之后，我也希望有一天能"}, {"type": "subtitle", "time": 1401.029, "timestamp": "00:23:21", "text": "在日本拥有自己的房子"}, {"type": "subtitle", "time": 1403.11, "timestamp": "00:23:23", "text": "。"}, {"type": "subtitle", "time": 1406.39, "timestamp": "00:23:26", "text": "对了，说到这个，下个月我"}, {"type": "subtitle", "time": 1409.19, "timestamp": "00:23:29", "text": "得要么把我的logo设计好，要么就给"}, {"type": "subtitle", "time": 1416.71, "timestamp": "00:23:36", "text": "我的门做个亚克力玻璃面板，"}, {"type": "subtitle", "time": 1420.31, "timestamp": "00:23:40", "text": "因为这就像个……店面，"}, {"type": "subtitle", "time": 1422.71, "timestamp": "00:23:42", "text": "对吧？ 这个空间。 所以，我得"}, {"type": "subtitle", "time": 1426.63, "timestamp": "00:23:46", "text": "做一个类似这样的装置，我有一个类似柔性板的东西，上面"}, {"type": "subtitle", "time": 1430.47, "timestamp": "00:23:50", "text": "写着文档、地址和"}, {"type": "subtitle", "time": 1433.11, "timestamp": "00:23:53", "text": "增值税号。 我必须改一下，才能让它看起来"}, {"type": "subtitle", "time": 1436.789, "timestamp": "00:23:56", "text": "像个标志。 嗯，我"}, {"type": "subtitle", "time": 1439.83, "timestamp": "00:23:59", "text": "觉得德国牧羊犬公司的人以后不会再进行内部"}]
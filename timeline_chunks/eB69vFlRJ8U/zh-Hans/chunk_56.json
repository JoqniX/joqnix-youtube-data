[{"type": "subtitle", "time": 3361.349, "timestamp": "00:56:01", "text": "就算不能直播，我也会上传视频。"}, {"type": "subtitle", "time": 3364.63, "timestamp": "00:56:04", "text": "我喜欢直播。说真的，直播真的很"}, {"type": "subtitle", "time": 3393.109, "timestamp": "00:56:33", "text": "哦，为了上大学。呃，为了上大学？"}, {"type": "subtitle", "time": 3397.829, "timestamp": "00:56:37", "text": "不，我只要通过日本的N1考试（ZPT）就行了"}, {"type": "subtitle", "time": 3400.47, "timestamp": "00:56:40", "text": "。然后我就没问题了，我会"}, {"type": "subtitle", "time": 3401.99, "timestamp": "00:56:41", "text": "利用语言"}, {"type": "subtitle", "time": 3404.549, "timestamp": "00:56:44", "text": "学校的人脉，因为他们会帮我。那是一所很"}, {"type": "subtitle", "time": 3407.43, "timestamp": "00:56:47", "text": "严格的学校。这所学校致力于为"}, {"type": "subtitle", "time": 3409.27, "timestamp": "00:56:49", "text": "学生提供"}, {"type": "subtitle", "time": 3411.589, "timestamp": "00:56:51", "text": "高等教育，以及他们想去的任何地方"}, {"type": "subtitle", "time": 3414.87, "timestamp": "00:56:54", "text": "等等。不。所以我会"}, {"type": "subtitle", "time": 3417.109, "timestamp": "00:56:57", "text": "尽可能地尝试考上大学，"}, {"type": "subtitle", "time": 3419.91, "timestamp": "00:56:59", "text": "然后把我的签证换成学习签证，"}]
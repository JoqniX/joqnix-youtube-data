[{"type": "subtitle", "time": 4080.39, "timestamp": "01:08:00", "text": "好节奏才能做到。"}, {"type": "subtitle", "time": 4083.829, "timestamp": "01:08:03", "text": "兄弟，我很忙。别卡顿。让我"}, {"type": "subtitle", "time": 4100.95, "timestamp": "01:08:20", "text": "的声音低沉多了。是的，"}, {"type": "subtitle", "time": 4104.63, "timestamp": "01:08:24", "text": "我做不到…… 我做不到低沉的声音。我"}, {"type": "subtitle", "time": 4107.11, "timestamp": "01:08:27", "text": "试过了，真的"}, {"type": "subtitle", "time": 4108.309, "timestamp": "01:08:28", "text": "做不到。[笑声]"}, {"type": "subtitle", "time": 4110.55, "timestamp": "01:08:30", "text": "我唯一能做到的办法就是把"}, {"type": "subtitle", "time": 4114.092, "timestamp": "01:08:34", "text": "自己噎住，但这很糟糕。千万别这么做。"}, {"type": "subtitle", "time": 4115.51, "timestamp": "01:08:35", "text": "[笑声]"}, {"type": "subtitle", "time": 4132.309, "timestamp": "01:08:52", "text": "。"}, {"type": "subtitle", "time": 4136.55, "timestamp": "01:08:56", "text": "呃，等等。你觉得我该开始了吗"}, {"type": "subtitle", "time": 4138.309, "timestamp": "01:08:58", "text": "？等一下。有人敲"}]
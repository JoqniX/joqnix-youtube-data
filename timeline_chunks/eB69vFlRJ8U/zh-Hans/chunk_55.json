[{"type": "subtitle", "time": 3302.87, "timestamp": "00:55:02", "text": "投诉是常有的事，"}, {"type": "subtitle", "time": 3305.19, "timestamp": "00:55:05", "text": "如果我被抓到，问题就很多了。"}, {"type": "subtitle", "time": 3310.069, "timestamp": "00:55:10", "text": "如果有人投诉"}, {"type": "subtitle", "time": 3312.63, "timestamp": "00:55:12", "text": "说“你太吵了”或者“这个"}, {"type": "subtitle", "time": 3315.109, "timestamp": "00:55:15", "text": "人很奇怪，"}, {"type": "subtitle", "time": 3317.99, "timestamp": "00:55:17", "text": "晚上大喊大叫，说话那么大声。我们想要"}, {"type": "subtitle", "time": 3319.349, "timestamp": "00:55:19", "text": "安静”之类的。如果有人"}, {"type": "subtitle", "time": 3322.188, "timestamp": "00:55:22", "text": "投诉，不，我就完蛋了。["}, {"type": "subtitle", "time": 3323.91, "timestamp": "00:55:23", "text": "笑] 我觉得我可能没法"}, {"type": "subtitle", "time": 3330.549, "timestamp": "00:55:30", "text": "直播了。[倒吸一口凉气] 呃，如果我收到警告"}, {"type": "subtitle", "time": 3333.19, "timestamp": "00:55:33", "text": "之类的，我就得小心点，"}, {"type": "subtitle", "time": 3335.109, "timestamp": "00:55:35", "text": "因为如果我违反规定，"}, {"type": "subtitle", "time": 3337.99, "timestamp": "00:55:37", "text": "我想我会被遣返回印度。"}, {"type": "subtitle", "time": 3340.79, "timestamp": "00:55:40", "text": "是啊，那是一所很严格的学校。 唉，所以"}, {"type": "subtitle", "time": 3343.91, "timestamp": "00:55:43", "text": "我得小心点。"}, {"type": "subtitle", "time": 3345.829, "timestamp": "00:55:45", "text": "是啊，"}, {"type": "subtitle", "time": 3349.19, "timestamp": "00:55:49", "text": "我不知道情况会怎么样，但"}, {"type": "subtitle", "time": 3352.15, "timestamp": "00:55:52", "text": "我至少会尽量上传视频或者"}, {"type": "subtitle", "time": 3355.03, "timestamp": "00:55:55", "text": "录制视频。好吧，"}, {"type": "subtitle", "time": 3356.789, "timestamp": "00:55:56", "text": "我现在就想着这个。"}]
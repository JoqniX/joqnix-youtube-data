[{"type": "subtitle", "time": 2820.95, "timestamp": "00:47:00", "text": "我以为我得喘口气，"}, {"type": "subtitle", "time": 2824.71, "timestamp": "00:47:04", "text": "因为我还有一个月的时间来"}, {"type": "subtitle", "time": 2827.91, "timestamp": "00:47:07", "text": "学习它，把它学好到"}, {"type": "subtitle", "time": 2830.63, "timestamp": "00:47:10", "text": "足以应付"}, {"type": "subtitle", "time": 2835.91, "timestamp": "00:47:15", "text": "但是我的音频设备出了点问题，真是太糟糕了"}, {"type": "subtitle", "time": 2837.43, "timestamp": "00:47:17", "text": "。"}, {"type": "subtitle", "time": 2840.309, "timestamp": "00:47:20", "text": "我的音频质量真的太差了。"}, {"type": "subtitle", "time": 2844.47, "timestamp": "00:47:24", "text": "我得用很多后期处理部分来添加"}, {"type": "subtitle", "time": 2850.63, "timestamp": "00:47:30", "text": "效果等等，"}, {"type": "subtitle", "time": 2852.95, "timestamp": "00:47:32", "text": "才能让它听起来像"}, {"type": "subtitle", "time": 2855.109, "timestamp": "00:47:35", "text": "我想要的那样。"}, {"type": "subtitle", "time": 2858.39, "timestamp": "00:47:38", "text": "有时候麦克风会突然爆音。 不，我讨厌"}, {"type": "subtitle", "time": 2872.47, "timestamp": "00:47:52", "text": "感性的儿子。 你好。"}]
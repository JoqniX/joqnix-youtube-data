[{"type": "subtitle", "time": 1443.19, "timestamp": "00:24:03", "text": "检查了。 所以，我可以把"}, {"type": "subtitle", "time": 1446.789, "timestamp": "00:24:06", "text": "它改成logo格式。"}, {"type": "subtitle", "time": 1450.149, "timestamp": "00:24:10", "text": "那我就这么做。"}, {"type": "subtitle", "time": 1452.87, "timestamp": "00:24:12", "text": "是的，我爸爸一直跟我说你"}, {"type": "subtitle", "time": 1456.07, "timestamp": "00:24:16", "text": "可以把它做成玻璃的东西，就像"}, {"type": "subtitle", "time": 1460.149, "timestamp": "00:24:20", "text": "我们"}, {"type": "subtitle", "time": 1462.87, "timestamp": "00:24:22", "text": "隔壁那家用泡沫塑料做的，所以他们做了"}, {"type": "subtitle", "time": 1466.47, "timestamp": "00:24:26", "text": "一个玻璃面板之类的东西。 嗯，真的很"}]
[{"type": "subtitle", "time": 240.47, "timestamp": "00:04:00", "text": "我只是想做个直播，因为"}, {"type": "subtitle", "time": 243.19, "timestamp": "00:04:03", "text": "我不知道该做什么。 因为"}, {"type": "subtitle", "time": 245.99, "timestamp": "00:04:05", "text": "那里的时间是有限制的，"}, {"type": "subtitle", "time": 250.309, "timestamp": "00:04:10", "text": "对吧？ 当然可以。 上次我们做了"}, {"type": "subtitle", "time": 254.71, "timestamp": "00:04:14", "text": "合作直播。 我说过"}, {"type": "subtitle", "time": 257.909, "timestamp": "00:04:17", "text": "当天晚些时候会直播，但我没能做到。 我当时"}, {"type": "subtitle", "time": 263.189, "timestamp": "00:04:23", "text": "感觉很累，所以就睡着了。"}, {"type": "subtitle", "time": 265.749, "timestamp": "00:04:25", "text": "我只是多休息了一会儿"}, {"type": "subtitle", "time": 268.15, "timestamp": "00:04:28", "text": "。"}, {"type": "subtitle", "time": 272.23, "timestamp": "00:04:32", "text": "但我那天只是休息了一天。"}, {"type": "subtitle", "time": 282.39, "timestamp": "00:04:42", "text": "好的，请稍等片刻。 让我先"}, {"type": "subtitle", "time": 285.59000000000003, "timestamp": "00:04:45", "text": "看看直播流有没有什么问题，"}, {"type": "subtitle", "time": 288.07, "timestamp": "00:04:48", "text": "这样我就可以修复它了。"}, {"type": "subtitle", "time": 291.51, "timestamp": "00:04:51", "text": "嗯，如果你能……"}, {"type": "subtitle", "time": 294.39, "timestamp": "00:04:54", "text": "如果你发现任何直播流"}, {"type": "subtitle", "time": 299.11, "timestamp": "00:04:59", "text": "无法正常工作的话。 例如，嗯，你"}]
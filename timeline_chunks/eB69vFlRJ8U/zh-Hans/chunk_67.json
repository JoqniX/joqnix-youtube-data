[{"type": "subtitle", "time": 4056.549, "timestamp": "01:07:36", "text": "我需要一段引导人声。伙计，我需要"}, {"type": "subtitle", "time": 4060.39, "timestamp": "01:07:40", "text": "真正的引导人声。等等，等等。"}, {"type": "subtitle", "time": 4063.829, "timestamp": "01:07:43", "text": "我做不到。呃，我……等等，等等，等等，"}, {"type": "subtitle", "time": 4065.43, "timestamp": "01:07:45", "text": "等等。"}, {"type": "subtitle", "time": 4073.99, "timestamp": "01:07:53", "text": "好的，我明白了。"}, {"type": "subtitle", "time": 4076.71, "timestamp": "01:07:56", "text": "嗨。三，二，一。我必须掌握"}]
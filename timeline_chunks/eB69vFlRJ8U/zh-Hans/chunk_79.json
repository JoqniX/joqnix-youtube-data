[{"type": "subtitle", "time": 4741.03, "timestamp": "01:19:01", "text": "六年YouTuber之后想给你的建议是，"}, {"type": "subtitle", "time": 4743.59, "timestamp": "01:19:03", "text": "做你自己的事。不要加入任何"}, {"type": "subtitle", "time": 4745.59, "timestamp": "01:19:05", "text": "社群或团体。就做你自己的"}, {"type": "subtitle", "time": 4747.11, "timestamp": "01:19:07", "text": "事。"}, {"type": "subtitle", "time": 4751.189, "timestamp": "01:19:11", "text": "嗯，会有人"}, {"type": "subtitle", "time": 4755.59, "timestamp": "01:19:15", "text": "因为你的作品而加入你的行列，但"}, {"type": "subtitle", "time": 4759.43, "timestamp": "01:19:19", "text": "最终他们可能永远不会成为"}, {"type": "subtitle", "time": 4761.75, "timestamp": "01:19:21", "text": "好朋友，或者只是虚伪的人"}, {"type": "subtitle", "time": 4763.59, "timestamp": "01:19:23", "text": "。 总会有人喷"}, {"type": "subtitle", "time": 4765.99, "timestamp": "01:19:25", "text": "你，总会有人说你"}, {"type": "subtitle", "time": 4773.51, "timestamp": "01:19:33", "text": "别理会这些沉默，只管去做"}, {"type": "subtitle", "time": 4775.669, "timestamp": "01:19:35", "text": "你真正热爱的事。如果你"}, {"type": "subtitle", "time": 4777.75, "timestamp": "01:19:37", "text": "想做Vubing，如果你想"}, {"type": "subtitle", "time": 4780.709, "timestamp": "01:19:40", "text": "尝试Viming，那就去做吧。"}, {"type": "subtitle", "time": 4784.149, "timestamp": "01:19:44", "text": "嗯，你会慢慢地、慢慢地"}, {"type": "subtitle", "time": 4787.35, "timestamp": "01:19:47", "text": "学习如何创作内容、"}, {"type": "subtitle", "time": 4790.39, "timestamp": "01:19:50", "text": "直播、制作内容等等"}, {"type": "subtitle", "time": 4793.35, "timestamp": "01:19:53", "text": "。这是一个过程。不，没问题。"}, {"type": "subtitle", "time": 4797.91, "timestamp": "01:19:57", "text": "别让任何人动摇你的"}]
[{"type": "subtitle", "time": 3422.789, "timestamp": "00:57:02", "text": "为期3到4年。然后等我"}, {"type": "subtitle", "time": 3425.43, "timestamp": "00:57:05", "text": "大学毕业后，我得找份"}, {"type": "subtitle", "time": 3428.47, "timestamp": "00:57:08", "text": "工作，换成工作签证。所有这些"}, {"type": "subtitle", "time": 3430.789, "timestamp": "00:57:10", "text": "事情。"}, {"type": "subtitle", "time": 3433.91, "timestamp": "00:57:13", "text": "是的，我还有…… 唯一好处就是"}, {"type": "subtitle", "time": 3437.51, "timestamp": "00:57:17", "text": "我学到了如何管理自己的"}, {"type": "subtitle", "time": 3439.43, "timestamp": "00:57:19", "text": "财务等等"}, {"type": "subtitle", "time": 3442.71, "timestamp": "00:57:22", "text": "。这样我就不会破产，也"}, {"type": "subtitle", "time": 3445.99, "timestamp": "00:57:25", "text": "不会惹上麻烦，因为我确信，"}, {"type": "subtitle", "time": 3448.39, "timestamp": "00:57:28", "text": "如果我闭上眼睛，钱就会像流水一样"}, {"type": "subtitle", "time": 3452.63, "timestamp": "00:57:32", "text": "花掉。（笑）就像水一样。"}, {"type": "subtitle", "time": 3455.589, "timestamp": "00:57:35", "text": "你不会意识到钱就这么凭空消失了，"}, {"type": "subtitle", "time": 3458.63, "timestamp": "00:57:38", "text": "因为各种开销什么的"}, {"type": "subtitle", "time": 3462.71, "timestamp": "00:57:42", "text": "。不，"}, {"type": "subtitle", "time": 3465.349, "timestamp": "00:57:45", "text": "我去日本能学到的一项技能就是"}, {"type": "subtitle", "time": 3467.829, "timestamp": "00:57:47", "text": "如何管理这些"}, {"type": "subtitle", "time": 3470.789, "timestamp": "00:57:50", "text": "财务，这样我就不会惹上"}, {"type": "subtitle", "time": 3473.109, "timestamp": "00:57:53", "text": "麻烦。是的。所以"}]
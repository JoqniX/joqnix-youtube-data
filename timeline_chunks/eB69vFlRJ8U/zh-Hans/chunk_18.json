[{"type": "subtitle", "time": 1086.15, "timestamp": "00:18:06", "text": "因为它需要经过五道"}, {"type": "subtitle", "time": 1090.23, "timestamp": "00:18:10", "text": "检查。 不，这太疯狂了。"}, {"type": "subtitle", "time": 1098.87, "timestamp": "00:18:18", "text": "我的天啊。"}, {"type": "subtitle", "time": 1102.71, "timestamp": "00:18:22", "text": "另外，哥们，我还想问一下，我的"}, {"type": "subtitle", "time": 1106.31, "timestamp": "00:18:26", "text": "流媒体音频设置是不是真的很糟糕？ 比如，我"}, {"type": "subtitle", "time": 1111.19, "timestamp": "00:18:31", "text": "说话声音是不是有时候太大了之类的？ 我"}, {"type": "subtitle", "time": 1113.75, "timestamp": "00:18:33", "text": "收到了一些反馈。"}, {"type": "subtitle", "time": 1115.35, "timestamp": "00:18:35", "text": "嗯，"}, {"type": "subtitle", "time": 1118.71, "timestamp": "00:18:38", "text": "我自己也注意到了。 我的麦克风"}, {"type": "subtitle", "time": 1126.47, "timestamp": "00:18:46", "text": "，我也"}, {"type": "subtitle", "time": 1129.19, "timestamp": "00:18:49", "text": "偶尔会注意到这一点。 我的麦克风"}, {"type": "subtitle", "time": 1130.95, "timestamp": "00:18:50", "text": "有时会发出声音。"}, {"type": "subtitle", "time": 1133.83, "timestamp": "00:18:53", "text": "足够好了。 我觉得"}]
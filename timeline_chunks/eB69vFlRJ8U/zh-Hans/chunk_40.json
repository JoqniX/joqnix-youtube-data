[{"type": "subtitle", "time": 2413.589, "timestamp": "00:40:13", "text": "[笑声]"}, {"type": "subtitle", "time": 2417.99, "timestamp": "00:40:17", "text": "我的天哪。 你认为这种事存在吗？ 我"}, {"type": "subtitle", "time": 2420.63, "timestamp": "00:40:20", "text": "觉得没人会这么做，"}, {"type": "subtitle", "time": 2424.23, "timestamp": "00:40:24", "text": "我的意思是，它应该是给体型"}, {"type": "subtitle", "time": 2426.39, "timestamp": "00:40:26", "text": "更大的人准备的。 我感觉自己像个无名小卒"}, {"type": "subtitle", "time": 2430.15, "timestamp": "00:40:30", "text": "。 我不这么认为"}, {"type": "subtitle", "time": 2432.87, "timestamp": "00:40:32", "text": "。"}, {"type": "subtitle", "time": 2442.95, "timestamp": "00:40:42", "text": "[笑声]"}, {"type": "subtitle", "time": 2444.71, "timestamp": "00:40:44", "text": "你疯了。"}, {"type": "subtitle", "time": 2458.55, "timestamp": "00:40:58", "text": "我还活着吗？"}]
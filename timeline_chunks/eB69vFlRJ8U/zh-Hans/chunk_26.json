[{"type": "subtitle", "time": 1565.59, "timestamp": "00:26:05", "text": "今年我会对这个24小时频道采取一些措施。 呃，在我离开之前，"}, {"type": "subtitle", "time": 1586.07, "timestamp": "00:26:26", "text": "锵锵。 是的，今年我会尝试多做"}, {"type": "subtitle", "time": 1588.63, "timestamp": "00:26:28", "text": "一些视频。 这就是我正在"}, {"type": "subtitle", "time": 1591.269, "timestamp": "00:26:31", "text": "努力做的事情之一。 虽然"}, {"type": "subtitle", "time": 1593.669, "timestamp": "00:26:33", "text": "质量不算太好，"}, {"type": "subtitle", "time": 1595.51, "timestamp": "00:26:35", "text": "但我现在只是想把它当成"}, {"type": "subtitle", "time": 1599.269, "timestamp": "00:26:39", "text": "个人博客之类的东西，"}, {"type": "subtitle", "time": 1601.75, "timestamp": "00:26:41", "text": "看看效果如何。"}, {"type": "subtitle", "time": 1606.549, "timestamp": "00:26:46", "text": "嗯，一旦我们有了足够的资源和"}, {"type": "subtitle", "time": 1609.669, "timestamp": "00:26:49", "text": "这些东西，我们就可以做更多"}, {"type": "subtitle", "time": 1613.51, "timestamp": "00:26:53", "text": "独白式的表演，这也是我希望做的。   是的"}, {"type": "subtitle", "time": 1617.909, "timestamp": "00:26:57", "text": "。 昨天我看了Kamisubaki的演唱会，真的给了"}]
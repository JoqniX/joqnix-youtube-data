[{"type": "subtitle", "time": 4148.87, "timestamp": "01:09:08", "text": "哦，算了。不是我的门。好的。是"}, {"type": "subtitle", "time": 4153.392, "timestamp": "01:09:13", "text": "另一个门。好的。呃，我不抽烟。"}, {"type": "subtitle", "time": 4155.269, "timestamp": "01:09:15", "text": "[笑声]"}, {"type": "subtitle", "time": 4158.789, "timestamp": "01:09:18", "text": "我不做那些事。我的电脑怎么这么"}, {"type": "subtitle", "time": 4163.51, "timestamp": "01:09:23", "text": "卡，兄弟？为什么这么卡？这么严重吗？"}, {"type": "subtitle", "time": 4174.07, "timestamp": "01:09:34", "text": "我这就关掉。"}, {"type": "subtitle", "time": 4181.43, "timestamp": "01:09:41", "text": "好的。[清嗓子]"}, {"type": "subtitle", "time": 4185.349, "timestamp": "01:09:45", "text": "嗨。呃，让我"}, {"type": "subtitle", "time": 4188.39, "timestamp": "01:09:48", "text": "用这个试试。"}]
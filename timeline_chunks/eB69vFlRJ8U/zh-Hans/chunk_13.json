[{"type": "subtitle", "time": 780.629, "timestamp": "00:13:00", "text": "寿星最近怎么样？"}, {"type": "subtitle", "time": 783.03, "timestamp": "00:13:03", "text": "考试结束了。 呃，我没参加所有"}, {"type": "subtitle", "time": 789.99, "timestamp": "00:13:09", "text": "我逃了所有考试。"}, {"type": "subtitle", "time": 792.069, "timestamp": "00:13:12", "text": "那是另一回事了。 我以后"}, {"type": "subtitle", "time": 795.03, "timestamp": "00:13:15", "text": "会谈到这件事的。 我逃了所有"}, {"type": "subtitle", "time": 797.789, "timestamp": "00:13:17", "text": "考试。 是的。"}, {"type": "subtitle", "time": 799.67, "timestamp": "00:13:19", "text": "[笑声]"}, {"type": "subtitle", "time": 802.374, "timestamp": "00:13:22", "text": "对，别去那扇窗户。"}, {"type": "subtitle", "time": 803.029, "timestamp": "00:13:23", "text": "[笑声]"}, {"type": "subtitle", "time": 811.43, "timestamp": "00:13:31", "text": "。 嗯，今天就随便聊聊吧。"}, {"type": "subtitle", "time": 814.15, "timestamp": "00:13:34", "text": "我还想做个唱歌练习之类的，"}, {"type": "subtitle", "time": 817.19, "timestamp": "00:13:37", "text": "因为我的一个朋友"}, {"type": "subtitle", "time": 820.15, "timestamp": "00:13:40", "text": "拉着我一起翻唱"}, {"type": "subtitle", "time": 825.43, "timestamp": "00:13:45", "text": "那首《Chain Man》的歌《Jane Do》。 呃，所以我"}, {"type": "subtitle", "time": 828.23, "timestamp": "00:13:48", "text": "得学学男声部分的台词。 但"}, {"type": "subtitle", "time": 832.79, "timestamp": "00:13:52", "text": "我去了，我和女伴们在一起。 呃，"}, {"type": "subtitle", "time": 837.509, "timestamp": "00:13:57", "text": "主线对我来说有点难。 所以"}]
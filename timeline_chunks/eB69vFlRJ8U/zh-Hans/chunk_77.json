[{"type": "subtitle", "time": 4620.31, "timestamp": "01:17:00", "text": "你看，这里好卡。不，我的电脑。哦"}, {"type": "subtitle", "time": 4626.07, "timestamp": "01:17:06", "text": "我的天。你知道吗？我不做"}, {"type": "subtitle", "time": 4629.11, "timestamp": "01:17:09", "text": "鼠标缩放了。我把"}, {"type": "subtitle", "time": 4631.91, "timestamp": "01:17:11", "text": "它关掉。是的。是的。这样，你"}, {"type": "subtitle", "time": 4636.149, "timestamp": "01:17:16", "text": "就能看到整个画面了。好的。"}, {"type": "subtitle", "time": 4653.51, "timestamp": "01:17:33", "text": "我觉得印度的"}, {"type": "subtitle", "time": 4672.87, "timestamp": "01:17:52", "text": "好的，让我来做一下。"}, {"type": "subtitle", "time": 4676.63, "timestamp": "01:17:56", "text": "为什么我的镜头被放大了？好的。嗨。嗨。嗨。"}]
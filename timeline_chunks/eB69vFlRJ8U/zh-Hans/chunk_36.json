[{"type": "subtitle", "time": 2164.71, "timestamp": "00:36:04", "text": "唉，我也希望自己能成为凡人，"}, {"type": "subtitle", "time": 2171.51, "timestamp": "00:36:11", "text": "我感觉"}, {"type": "subtitle", "time": 2173.27, "timestamp": "00:36:13", "text": "自己像是置身于传说之中，但我不想"}, {"type": "subtitle", "time": 2177.51, "timestamp": "00:36:17", "text": "记录下来。啊，我喜欢那种感觉，"}, {"type": "subtitle", "time": 2180.63, "timestamp": "00:36:20", "text": "比如在"}, {"type": "subtitle", "time": 2183.19, "timestamp": "00:36:23", "text": "奇幻世界里"}, {"type": "subtitle", "time": 2186.15, "timestamp": "00:36:26", "text": "转世重生或者被召唤之类的，"}, {"type": "subtitle", "time": 2189.03, "timestamp": "00:36:29", "text": "扔到那里，"}, {"type": "subtitle", "time": 2191.43, "timestamp": "00:36:31", "text": "那会很棒。但你"}, {"type": "subtitle", "time": 2194.39, "timestamp": "00:36:34", "text": "现在到处都能看到这种设定，所以"}, {"type": "subtitle", "time": 2196.15, "timestamp": "00:36:36", "text": "我不想采用那种"}, {"type": "subtitle", "time": 2199.03, "timestamp": "00:36:39", "text": "设定。是的"}, {"type": "subtitle", "time": 2204.15, "timestamp": "00:36:44", "text": "如果我要选择一个设定，我想我会选择一个……"}, {"type": "subtitle", "time": 2206.15, "timestamp": "00:36:46", "text": "呃，就像……而"}, {"type": "subtitle", "time": 2212.79, "timestamp": "00:36:52", "text": "不是……它是什么样子的设定。 它就像一个"}, {"type": "subtitle", "time": 2215.829, "timestamp": "00:36:55", "text": "既定的世界设定，"}]
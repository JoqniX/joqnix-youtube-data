[{"type": "subtitle", "time": 1800.789, "timestamp": "00:30:00", "text": "他们只是在"}, {"type": "subtitle", "time": 1802.789, "timestamp": "00:30:02", "text": "互相交谈。 所以我们将依靠蛮力"}, {"type": "subtitle", "time": 1805.909, "timestamp": "00:30:05", "text": "来进化。 啊，那"}, {"type": "subtitle", "time": 1811.43, "timestamp": "00:30:11", "text": "我得权衡一下，看看情况如何"}, {"type": "subtitle", "time": 1817.909, "timestamp": "00:30:17", "text": "是的，今年我得以"}, {"type": "subtitle", "time": 1819.83, "timestamp": "00:30:19", "text": "对我的"}, {"type": "subtitle", "time": 1822.71, "timestamp": "00:30:22", "text": "频道，特别是 Twitch 和 Kick 频道，做出很多改变"}, {"type": "subtitle", "time": 1826.805, "timestamp": "00:30:26", "text": "。 我得去修面板了。"}, {"type": "subtitle", "time": 1827.75, "timestamp": "00:30:27", "text": "[笑声]"}, {"type": "subtitle", "time": 1829.83, "timestamp": "00:30:29", "text": "我得去处理这些面板。 我需要"}, {"type": "subtitle", "time": 1832.87, "timestamp": "00:30:32", "text": "更新一些面板。"}, {"type": "subtitle", "time": 1836.63, "timestamp": "00:30:36", "text": "就像宝可梦使用进化石进化一样。   是的"}, {"type": "subtitle", "time": 1840.549, "timestamp": "00:30:40", "text": "。 我的天啊。 等等，宝可梦进化了。"}, {"type": "subtitle", "time": 1853.51, "timestamp": "00:30:53", "text": "哇。 我不知道。"}]
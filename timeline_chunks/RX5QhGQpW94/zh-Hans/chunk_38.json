[{"type": "subtitle", "time": 2285.03, "timestamp": "00:38:05", "text": "好的。 [叹息和喘息]"}, {"type": "subtitle", "time": 2287.829, "timestamp": "00:38:07", "text": "谢谢你提供的补水剂。"}, {"type": "subtitle", "time": 2290.39, "timestamp": "00:38:10", "text": "我去倒点水。我真的"}, {"type": "subtitle", "time": 2294.23, "timestamp": "00:38:14", "text": "今天感觉喉咙有点疼。"}, {"type": "subtitle", "time": 2300.31, "timestamp": "00:38:20", "text": "[清嗓子]"}, {"type": "subtitle", "time": 2303.27, "timestamp": "00:38:23", "text": "是的，我做了体检，全身检查。"}, {"type": "subtitle", "time": 2305.349, "timestamp": "00:38:25", "text": "清理，"}, {"type": "subtitle", "time": 2308.15, "timestamp": "00:38:28", "text": "医生说我没事。我是"}, {"type": "subtitle", "time": 2311.91, "timestamp": "00:38:31", "text": "好吧，诸如此类，因为不，我有这个"}, {"type": "subtitle", "time": 2315.27, "timestamp": "00:38:35", "text": "灰尘过敏问题。我一直打喷嚏，"}, {"type": "subtitle", "time": 2319.349, "timestamp": "00:38:39", "text": "不停地打喷嚏。"}, {"type": "subtitle", "time": 2322.31, "timestamp": "00:38:42", "text": "这是痛苦。"}, {"type": "subtitle", "time": 2326.71, "timestamp": "00:38:46", "text": "102. 这是什么？"}]
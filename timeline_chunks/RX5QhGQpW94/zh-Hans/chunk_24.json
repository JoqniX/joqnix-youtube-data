[{"type": "subtitle", "time": 1441.35, "timestamp": "00:24:01", "text": "一段时间以来，我基本上就是一个"}, {"type": "subtitle", "time": 1444.789, "timestamp": "00:24:04", "text": "实际上我还是新手。"}, {"type": "subtitle", "time": 1460.39, "timestamp": "00:24:20", "text": "好了，公告结束了。好的，很好。"}, {"type": "subtitle", "time": 1462.87, "timestamp": "00:24:22", "text": "好，好。"}, {"type": "subtitle", "time": 1470.23, "timestamp": "00:24:30", "text": "呃，你知道，我不能，我不能，我知道"}, {"type": "subtitle", "time": 1478.63, "timestamp": "00:24:38", "text": "希望"}, {"type": "subtitle", "time": 1481.19, "timestamp": "00:24:41", "text": "事情会好起来的。别太担心"}, {"type": "subtitle", "time": 1483.59, "timestamp": "00:24:43", "text": "很多。"}, {"type": "subtitle", "time": 1485.909, "timestamp": "00:24:45", "text": "是的。"}, {"type": "subtitle", "time": 1490.23, "timestamp": "00:24:50", "text": "而且我最近……"}, {"type": "subtitle", "time": 1492.95, "timestamp": "00:24:52", "text": "你父母为什么会同意呢？"}, {"type": "subtitle", "time": 1495.269, "timestamp": "00:24:55", "text": "然后？如果我父母不同意，"}, {"type": "subtitle", "time": 1498.07, "timestamp": "00:24:58", "text": "那我为什么要去那里？"}]
[{"type": "subtitle", "time": 2460.39, "timestamp": "00:41:00", "text": "呃，那好像是一张256GB的存储卡。"}, {"type": "subtitle", "time": 2463.99, "timestamp": "00:41:03", "text": "SanDisk。我的手机内部存储空间"}, {"type": "subtitle", "time": 2466.63, "timestamp": "00:41:06", "text": "存储空间现在为 128。我当时就想，"}, {"type": "subtitle", "time": 2469.589, "timestamp": "00:41:09", "text": "好的，我不会再收到这个错误提示了。"}, {"type": "subtitle", "time": 2472.71, "timestamp": "00:41:12", "text": "出现“设备存储空间不足”之类的消息"}, {"type": "subtitle", "time": 2476.39, "timestamp": "00:41:16", "text": "插入我的内存条，也就是新的内存卡。"}, {"type": "subtitle", "time": 2478.63, "timestamp": "00:41:18", "text": "我当时就想，"}, {"type": "subtitle", "time": 2482.15, "timestamp": "00:41:22", "text": "“是啊，这件事就此结束了。”但我当时"}, {"type": "subtitle", "time": 2486.47, "timestamp": "00:41:26", "text": "错误的。所有这些应用。不，就像我"}, {"type": "subtitle", "time": 2490.47, "timestamp": "00:41:30", "text": "每当我看到一些类似的应用程序时"}, {"type": "subtitle", "time": 2492.79, "timestamp": "00:41:32", "text": "就像应用商店一样，我只是随意安装的"}, {"type": "subtitle", "time": 2496.069, "timestamp": "00:41:36", "text": "否则我就会想，“哦，我可以用这个"}, {"type": "subtitle", "time": 2498.39, "timestamp": "00:41:38", "text": "因为某某事，我会忘记的。"}, {"type": "subtitle", "time": 2502.55, "timestamp": "00:41:42", "text": "关于这件事。”然后，嗯，时机成熟的时候……"}, {"type": "subtitle", "time": 2505.109, "timestamp": "00:41:45", "text": "我觉得我必须澄清一下"}, {"type": "subtitle", "time": 2507.829, "timestamp": "00:41:47", "text": "一些存储和卸载这些"}, {"type": "subtitle", "time": 2509.67, "timestamp": "00:41:49", "text": "应用程序"}, {"type": "subtitle", "time": 2514.563, "timestamp": "00:41:54", "text": "嗯，然后我就想，啊，我需要……"}, {"type": "subtitle", "time": 2516.15, "timestamp": "00:41:56", "text": "[嗤笑]"}, {"type": "subtitle", "time": 2519.349, "timestamp": "00:41:59", "text": "你必须点击才能知道我不知道"}]
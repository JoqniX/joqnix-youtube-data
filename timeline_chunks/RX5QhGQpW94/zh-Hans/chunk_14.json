[{"type": "subtitle", "time": 843.189, "timestamp": "00:14:03", "text": "表叔叔、安迪和我的家人。"}, {"type": "subtitle", "time": 846.71, "timestamp": "00:14:06", "text": "是的。我的天啊。你要去哪里？呃，我是"}, {"type": "subtitle", "time": 855.59, "timestamp": "00:14:15", "text": "我当时想，呃，我"}, {"type": "subtitle", "time": 858.629, "timestamp": "00:14:18", "text": "你上次来的时候，我们聊过天。"}, {"type": "subtitle", "time": 861.99, "timestamp": "00:14:21", "text": "关于这件事。你忘了？"}, {"type": "subtitle", "time": 864.71, "timestamp": "00:14:24", "text": "你上次来的时候，"}, {"type": "subtitle", "time": 867.03, "timestamp": "00:14:27", "text": "时机成熟时就该这么做。呃，四月，四月"}, {"type": "subtitle", "time": 869.829, "timestamp": "00:14:29", "text": "1，我会到场。是的。嗯，所以我有"}, {"type": "subtitle", "time": 875.35, "timestamp": "00:14:35", "text": "比如二月和三月的中后期"}, {"type": "subtitle", "time": 879.59, "timestamp": "00:14:39", "text": "三月时分。是的。是的。所以在我之前"}, {"type": "subtitle", "time": 882.79, "timestamp": "00:14:42", "text": "准备出发"}, {"type": "subtitle", "time": 887.75, "timestamp": "00:14:47", "text": "大概需要一年左右的时间。不，不"}, {"type": "subtitle", "time": 889.35, "timestamp": "00:14:49", "text": "不，不，不。我今年要去"}, {"type": "subtitle", "time": 891.75, "timestamp": "00:14:51", "text": "大概。没有把握。尚未证实"}, {"type": "subtitle", "time": 895.59, "timestamp": "00:14:55", "text": "然而。我下周就能得到确认。"}, {"type": "subtitle", "time": 899.67, "timestamp": "00:14:59", "text": "是的，下周。呃，下周或者16号"}]
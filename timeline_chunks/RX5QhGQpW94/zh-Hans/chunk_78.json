[{"type": "subtitle", "time": 4681.75, "timestamp": "01:18:01", "text": "即使在今天，仍然有很多事情是"}, {"type": "subtitle", "time": 4683.99, "timestamp": "01:18:03", "text": "正在崩溃，我恨透了这一切。"}, {"type": "subtitle", "time": 4689.51, "timestamp": "01:18:09", "text": "时间。真是件烦人的事。"}, {"type": "subtitle", "time": 4736.63, "timestamp": "01:18:56", "text": "休息一下。"}]
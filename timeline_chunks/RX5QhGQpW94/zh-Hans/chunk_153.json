[{"type": "subtitle", "time": 9181.99, "timestamp": "02:33:01", "text": "这些伏击溪流的设计目的是为了"}, {"type": "subtitle", "time": 9184.309, "timestamp": "02:33:04", "text": "惊喜观众经常最后宣布"}, {"type": "subtitle", "time": 9187.429, "timestamp": "02:33:07", "text": "在社交媒体上发布一分钟或声明"}, {"type": "subtitle", "time": 9190.309, "timestamp": "02:33:10", "text": "突然。是的。"}, {"type": "subtitle", "time": 9193.75, "timestamp": "02:33:13", "text": "你好，萨拉赫。欢迎。"}, {"type": "subtitle", "time": 9196.07, "timestamp": "02:33:16", "text": "是的。随机流。是的。是的。是的。"}, {"type": "subtitle", "time": 9207.03, "timestamp": "02:33:27", "text": "[清嗓子]"}, {"type": "subtitle", "time": 9209.03, "timestamp": "02:33:29", "text": "好的。呃，我们的目标是那些不……的人"}, {"type": "subtitle", "time": 9211.27, "timestamp": "02:33:31", "text": "我知道最近我曾发布过它。"}, {"type": "subtitle", "time": 9212.71, "timestamp": "02:33:32", "text": "我的YouTube频道全部都能正常运行。"}, {"type": "subtitle", "time": 9214.87, "timestamp": "02:33:34", "text": "我在 YouTube 上做过的直播"}, {"type": "subtitle", "time": 9217.429, "timestamp": "02:33:37", "text": "渠道。所以这段视频将会给出"}, {"type": "subtitle", "time": 9219.429, "timestamp": "02:33:39", "text": "你简要"}, {"type": "subtitle", "time": 9229.67, "timestamp": "02:33:49", "text": "我不想看到SRT"}]
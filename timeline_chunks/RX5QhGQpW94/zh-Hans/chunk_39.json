[{"type": "subtitle", "time": 2344.63, "timestamp": "00:39:04", "text": "兄弟，说实话，你知道，我当时就想，"}, {"type": "subtitle", "time": 2348.63, "timestamp": "00:39:08", "text": "我要录制我的视频内容"}, {"type": "subtitle", "time": 2357.19, "timestamp": "00:39:17", "text": "你老了。你不应该出去"}, {"type": "subtitle", "time": 2359.75, "timestamp": "00:39:19", "text": "这。你为什么说“老”？哦，我不是。"}, {"type": "subtitle", "time": 2375.03, "timestamp": "00:39:35", "text": "我看到了你的聊天记录。你，你说在……"}, {"type": "subtitle", "time": 2378.39, "timestamp": "00:39:38", "text": "板"}, {"type": "subtitle", "time": 2381.829, "timestamp": "00:39:41", "text": "频道始终在线。你这小鬼。你……"}, {"type": "subtitle", "time": 2385.43, "timestamp": "00:39:45", "text": "再叫我叔叔好吗？我的天啊。"}, {"type": "subtitle", "time": 2390.39, "timestamp": "00:39:50", "text": "你好，内森。我的天啊。你好吗？"}, {"type": "subtitle", "time": 2395.109, "timestamp": "00:39:55", "text": "你好吗？你好吗？你好。"}]
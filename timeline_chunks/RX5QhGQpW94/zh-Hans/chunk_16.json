[{"type": "subtitle", "time": 962.23, "timestamp": "00:16:02", "text": "呃，我不知道我是否会有。"}, {"type": "subtitle", "time": 965.43, "timestamp": "00:16:05", "text": "一个让我可以像……一样的环境"}, {"type": "subtitle", "time": 968.949, "timestamp": "00:16:08", "text": "现在我有了私人空间，这样我就可以拥有我的"}, {"type": "subtitle", "time": 971.189, "timestamp": "00:16:11", "text": "我能做很多事。"}, {"type": "subtitle", "time": 973.829, "timestamp": "00:16:13", "text": "不，不，好几年都没有了。基本上是6"}, {"type": "subtitle", "time": 976.79, "timestamp": "00:16:16", "text": "至少几个月，或许不会有结果。"}, {"type": "subtitle", "time": 981.67, "timestamp": "00:16:21", "text": "直播6个月，直到我搬出去为止"}, {"type": "subtitle", "time": 984.629, "timestamp": "00:16:24", "text": "我自己的住处。"}, {"type": "subtitle", "time": 988.629, "timestamp": "00:16:28", "text": "呃，是啊，因为我不知道宿舍的事。"}, {"type": "subtitle", "time": 991.99, "timestamp": "00:16:31", "text": "规则。我会住在宿舍。我要"}, {"type": "subtitle", "time": 995.749, "timestamp": "00:16:35", "text": "室友之类的。呃"}, {"type": "subtitle", "time": 1004.15, "timestamp": "00:16:44", "text": "是的，"}, {"type": "subtitle", "time": 1007.829, "timestamp": "00:16:47", "text": "我无法预料或预测任何事情。"}, {"type": "subtitle", "time": 1009.749, "timestamp": "00:16:49", "text": "打算留下来。不，我打算……"}]
[{"type": "subtitle", "time": 17221.11, "timestamp": "04:47:01", "text": "没错，当他们首次亮相的时候。"}, {"type": "subtitle", "time": 17225.51, "timestamp": "04:47:05", "text": "流。你好，健藤崎。"}, {"type": "subtitle", "time": 17229.83, "timestamp": "04:47:09", "text": "你好。等等，你们在聊天吗？"}, {"type": "subtitle", "time": 17231.91, "timestamp": "04:47:11", "text": "我的主号？哦，是的。您正在聊天"}, {"type": "subtitle", "time": 17252.07, "timestamp": "04:47:32", "text": "好的。好的。好了，我们可以结束了。"}, {"type": "subtitle", "time": 17254.55, "timestamp": "04:47:34", "text": "很快。好的。"}, {"type": "subtitle", "time": 17256.07, "timestamp": "04:47:36", "text": "正确的。"}, {"type": "subtitle", "time": 17258.15, "timestamp": "04:47:38", "text": "呃"}, {"type": "subtitle", "time": 17260.868, "timestamp": "04:47:40", "text": "再次感谢 Luna Moon"}, {"type": "subtitle", "time": 17263.43, "timestamp": "04:47:43", "text": "官员们。感谢您的阅读。"}, {"type": "subtitle", "time": 17266.23, "timestamp": "04:47:46", "text": "抽搐。这对我意义重大。"}, {"type": "subtitle", "time": 17269.11, "timestamp": "04:47:49", "text": "感谢你通过以下方式发现我："}, {"type": "subtitle", "time": 17272.538, "timestamp": "04:47:52", "text": "突袭民意调查网站。"}, {"type": "subtitle", "time": 17275.11, "timestamp": "04:47:55", "text": "[清嗓子] 我很高兴我推荐了"}]
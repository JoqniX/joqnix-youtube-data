[{"type": "subtitle", "time": 2588.23, "timestamp": "00:43:08", "text": "呃"}, {"type": "subtitle", "time": 2591.19, "timestamp": "00:43:11", "text": "已经过了好久了。五年。"}, {"type": "subtitle", "time": 2594.71, "timestamp": "00:43:14", "text": "是的。你知道吗，我有一些激动人心的消息。"}, {"type": "subtitle", "time": 2597.109, "timestamp": "00:43:17", "text": "即将推出"}, {"type": "subtitle", "time": 2599.67, "timestamp": "00:43:19", "text": "我还在考虑我是否应该"}, {"type": "subtitle", "time": 2604.23, "timestamp": "00:43:24", "text": "本月或下个月公布。"}, {"type": "subtitle", "time": 2607.27, "timestamp": "00:43:27", "text": "我必须……我必须联系两个人"}, {"type": "subtitle", "time": 2611.43, "timestamp": "00:43:31", "text": "更多人手来最终敲定所有事宜。"}, {"type": "subtitle", "time": 2614.069, "timestamp": "00:43:34", "text": "嗯"}, {"type": "subtitle", "time": 2617.349, "timestamp": "00:43:37", "text": "是的。卓越。是的。是的。是的。"}, {"type": "subtitle", "time": 2621.91, "timestamp": "00:43:41", "text": "你看，球门就在顶端。"}, {"type": "subtitle", "time": 2625.589, "timestamp": "00:43:45", "text": "比如制作 Joik 的新模型之类的。"}, {"type": "subtitle", "time": 2629.349, "timestamp": "00:43:49", "text": "是的。我终于"}, {"type": "subtitle", "time": 2630.95, "timestamp": "00:43:50", "text": "最后"}, {"type": "subtitle", "time": 2632.47, "timestamp": "00:43:52", "text": "得到"}, {"type": "subtitle", "time": 2636.15, "timestamp": "00:43:56", "text": "我不知道我该不该说，但是"}, {"type": "subtitle", "time": 2638.23, "timestamp": "00:43:58", "text": "呃，不是模型。该模型并非"}]
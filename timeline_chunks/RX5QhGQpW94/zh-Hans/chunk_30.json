[{"type": "subtitle", "time": 1801.19, "timestamp": "00:30:01", "text": "机构。"}, {"type": "subtitle", "time": 1804.149, "timestamp": "00:30:04", "text": "是的。看来我并不孤单。不。"}, {"type": "subtitle", "time": 1806.23, "timestamp": "00:30:06", "text": "原因有二。首先，我最好的朋友是"}, {"type": "subtitle", "time": 1809.19, "timestamp": "00:30:09", "text": "也会想念她的。"}, {"type": "subtitle", "time": 1811.19, "timestamp": "00:30:11", "text": "其次，你也很快要走了。"}, {"type": "subtitle", "time": 1821.669, "timestamp": "00:30:21", "text": "是的。是的。同学们都在那里。不"}, {"type": "subtitle", "time": 1825.029, "timestamp": "00:30:25", "text": "担心。呃呃，好像……嗯，我想……呃"}, {"type": "subtitle", "time": 1827.269, "timestamp": "00:30:27", "text": "我的语言学校，嗯，会有的"}, {"type": "subtitle", "time": 1829.83, "timestamp": "00:30:29", "text": "三四个人。"}, {"type": "subtitle", "time": 1833.35, "timestamp": "00:30:33", "text": "总共有12位家长要去。呃"}, {"type": "subtitle", "time": 1834.71, "timestamp": "00:30:34", "text": "有些人会去不同的地方。"}, {"type": "subtitle", "time": 1837.269, "timestamp": "00:30:37", "text": "不同的州。呃，我要去一个"}, {"type": "subtitle", "time": 1840.149, "timestamp": "00:30:40", "text": "不同的州，特定的学校。他们"}, {"type": "subtitle", "time": 1841.59, "timestamp": "00:30:41", "text": "即将前往另一个州，而且"}, {"type": "subtitle", "time": 1845.146, "timestamp": "00:30:45", "text": "具体学校。就是这样。"}, {"type": "subtitle", "time": 1845.75, "timestamp": "00:30:45", "text": "[叹气]"}, {"type": "subtitle", "time": 1848.71, "timestamp": "00:30:48", "text": "呃，最好的朋友，我生命中的挚爱。一个"}, {"type": "subtitle", "time": 1852.149, "timestamp": "00:30:52", "text": "是的，我知道那一刻"}, {"type": "subtitle", "time": 1855.51, "timestamp": "00:30:55", "text": "我儿时的朋友们，现在他们都"}, {"type": "subtitle", "time": 1859.99, "timestamp": "00:30:59", "text": "虽然他离开了我，但就像……"}]
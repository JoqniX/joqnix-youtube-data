[{"type": "subtitle", "time": 1981.99, "timestamp": "00:33:01", "text": "就是这样。所以他们（清了清嗓子）呃"}, {"type": "subtitle", "time": 1984.31, "timestamp": "00:33:04", "text": "给你一个机会，他们联系"}, {"type": "subtitle", "time": 1986.23, "timestamp": "00:33:06", "text": "用这门语言与你交流。凉爽的。你"}, {"type": "subtitle", "time": 1988.07, "timestamp": "00:33:08", "text": "通过面试等等一切"}, {"type": "subtitle", "time": 1989.909, "timestamp": "00:33:09", "text": "然后"}, {"type": "subtitle", "time": 1992.87, "timestamp": "00:33:12", "text": "直到你被接纳到那里，就像你一样"}, {"type": "subtitle", "time": 1994.789, "timestamp": "00:33:14", "text": "机票会寄到那里。"}, {"type": "subtitle", "time": 1996.95, "timestamp": "00:33:16", "text": "所有东西都是成套出售的。他们呃"}, {"type": "subtitle", "time": 1999.75, "timestamp": "00:33:19", "text": "当地机构会帮助你"}, {"type": "subtitle", "time": 2003.509, "timestamp": "00:33:23", "text": "本地的文档翻译之类的东西"}, {"type": "subtitle", "time": 2007.83, "timestamp": "00:33:27", "text": "当地机构所做的一切都是这样的。"}, {"type": "subtitle", "time": 2010.71, "timestamp": "00:33:30", "text": "然后，一旦你到了日本，"}, {"type": "subtitle", "time": 2013.029, "timestamp": "00:33:33", "text": "语言学校"}, {"type": "subtitle", "time": 2015.35, "timestamp": "00:33:35", "text": "嗯，日语"}, {"type": "subtitle", "time": 2017.269, "timestamp": "00:33:37", "text": "他们学校"}, {"type": "subtitle", "time": 2020.31, "timestamp": "00:33:40", "text": "呃，比如，当地的研究所将会是"}, {"type": "subtitle", "time": 2023.35, "timestamp": "00:33:43", "text": "就像你的监护人挡了你的路一样，因为如果"}, {"type": "subtitle", "time": 2025.11, "timestamp": "00:33:45", "text": "任何事情都可能发生，比如说你5岁"}, {"type": "subtitle", "time": 2028.23, "timestamp": "00:33:48", "text": "迟到几分钟或迟到1分钟"}, {"type": "subtitle", "time": 2032.23, "timestamp": "00:33:52", "text": "在日本的时候，早上要上课，对吧？"}, {"type": "subtitle", "time": 2034.149, "timestamp": "00:33:54", "text": "这"}, {"type": "subtitle", "time": 2037.19, "timestamp": "00:33:57", "text": "呃，校长会打电话给你。"}, {"type": "subtitle", "time": 2039.35, "timestamp": "00:33:59", "text": "像您这样的姻亲当地机构"}]
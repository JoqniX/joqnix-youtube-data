[{"type": "subtitle", "time": 4865.59, "timestamp": "01:21:05", "text": "呃，你知道，我得准备我的呃"}, {"type": "subtitle", "time": 4869.59, "timestamp": "01:21:09", "text": "新车型发布会相关内容。我甚至还没……"}, {"type": "subtitle", "time": 4871.75, "timestamp": "01:21:11", "text": "呃"}, {"type": "subtitle", "time": 4874.79, "timestamp": "01:21:14", "text": "就像思考我想要怎样"}, {"type": "subtitle", "time": 4879.43, "timestamp": "01:21:19", "text": "去做。永远不要想"}, {"type": "subtitle", "time": 4888.39, "timestamp": "01:21:28", "text": "呃，所以这事儿会成，对吧？"}, {"type": "subtitle", "time": 4898.55, "timestamp": "01:21:38", "text": "这些是即将播出的节目。"}, {"type": "subtitle", "time": 4900.709, "timestamp": "01:21:40", "text": "90年代更好。"}, {"type": "subtitle", "time": 4903.27, "timestamp": "01:21:43", "text": "现在的问题是，我现在没有"}, {"type": "subtitle", "time": 4906.709, "timestamp": "01:21:46", "text": "想采取很多步骤去做事情。"}, {"type": "subtitle", "time": 4909.51, "timestamp": "01:21:49", "text": "如果能实现自动化，我就去。"}, {"type": "subtitle", "time": 4911.91, "timestamp": "01:21:51", "text": "去做这件事。"}, {"type": "subtitle", "time": 4914.07, "timestamp": "01:21:54", "text": "这就是我把所有这些操作都自动化的原因。"}, {"type": "subtitle", "time": 4918.55, "timestamp": "01:21:58", "text": "因为我讨厌不得不离开，所以才这样。"}]
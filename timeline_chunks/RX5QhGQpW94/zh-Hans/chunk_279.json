[{"type": "subtitle", "time": 16743.91, "timestamp": "04:39:03", "text": "呃，主播们。哦，对，我记得泰勒"}, {"type": "subtitle", "time": 16747.75, "timestamp": "04:39:07", "text": "我记得我曾看过他。"}, {"type": "subtitle", "time": 16750.949, "timestamp": "04:39:10", "text": "我不看英雄联盟，但我只是"}, {"type": "subtitle", "time": 16754.15, "timestamp": "04:39:14", "text": "我记得看过一些片段"}, {"type": "subtitle", "time": 16757.51, "timestamp": "04:39:17", "text": "他。我记得这件事。我记得"}, {"type": "subtitle", "time": 16759.99, "timestamp": "04:39:19", "text": "我关注的第一个日本 YouTuber 是"}, {"type": "subtitle", "time": 16762.15, "timestamp": "04:39:22", "text": "巴基斯坦"}, {"type": "subtitle", "time": 16767.109, "timestamp": "04:39:27", "text": "我至今还记得她。我当时就像在看"}, {"type": "subtitle", "time": 16771.59, "timestamp": "04:39:31", "text": "呃，日本直播和YouTuber"}, {"type": "subtitle", "time": 16775.029, "timestamp": "04:39:35", "text": "VTuber标签。我甚至都不知道这一点。"}, {"type": "subtitle", "time": 16778.628, "timestamp": "04:39:38", "text": "这是一位虚拟主播（VTuber）。"}, {"type": "subtitle", "time": 16780.15, "timestamp": "04:39:40", "text": "直到"}, {"type": "subtitle", "time": 16783.27, "timestamp": "04:39:43", "text": "在 YouTube 上经营了四五个月后，我"}, {"type": "subtitle", "time": 16786.31, "timestamp": "04:39:46", "text": "发现了绊之眼。"}, {"type": "subtitle", "time": 16789.75, "timestamp": "04:39:49", "text": "然后我就想，“哦，等等。”"}, {"type": "subtitle", "time": 16792.47, "timestamp": "04:39:52", "text": "所以，这位是虚拟主播（VTuber）。"}, {"type": "subtitle", "time": 16794.15, "timestamp": "04:39:54", "text": "就是这样。"}, {"type": "subtitle", "time": 16799.43, "timestamp": "04:39:59", "text": "是的，我就是这样偶然发现了帕基。"}]
[{"type": "subtitle", "time": 10320.309, "timestamp": "02:52:00", "text": "我已经是个被宠坏的孩子了。"}, {"type": "subtitle", "time": 10323.91, "timestamp": "02:52:03", "text": "作为独生子女。所以，是的，不知道是否"}, {"type": "subtitle", "time": 10344.63, "timestamp": "02:52:24", "text": "我又得了这事儿。 [音乐]"}, {"type": "subtitle", "time": 10346.87, "timestamp": "02:52:26", "text": "但从这里开始"}, {"type": "subtitle", "time": 10349.67, "timestamp": "02:52:29", "text": "到这里，"}, {"type": "subtitle", "time": 10351.19, "timestamp": "02:52:31", "text": "你说的也是我的目标。"}, {"type": "subtitle", "time": 10352.79, "timestamp": "02:52:32", "text": "我想当演员，想赚钱。"}, {"type": "subtitle", "time": 10355.19, "timestamp": "02:52:35", "text": "专业。就是这样。是的。让我们尽力而为。"}, {"type": "subtitle", "time": 10357.83, "timestamp": "02:52:37", "text": "好的。"}, {"type": "subtitle", "time": 10371.19, "timestamp": "02:52:51", "text": "呃，会有人……我的意思是"}, {"type": "subtitle", "time": 10372.55, "timestamp": "02:52:52", "text": "会有人"}, {"type": "subtitle", "time": 10376.15, "timestamp": "02:52:56", "text": "令人担忧。他们会告诉你他们的说法。"}, {"type": "subtitle", "time": 10378.95, "timestamp": "02:52:58", "text": "但话说回来，这是你的人生。"}]
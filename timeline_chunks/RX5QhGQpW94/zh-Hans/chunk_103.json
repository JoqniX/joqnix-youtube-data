[{"type": "subtitle", "time": 6194.55, "timestamp": "01:43:14", "text": "好的。所以，我想我可以……"}, {"type": "subtitle", "time": 6198.31, "timestamp": "01:43:18", "text": "进行正常录音。呃，那是“你”吗？"}, {"type": "subtitle", "time": 6207.99, "timestamp": "01:43:27", "text": "哦，我还没来得及检查音频。呃，一个"}, {"type": "subtitle", "time": 6210.149, "timestamp": "01:43:30", "text": "第二。"}, {"type": "subtitle", "time": 6213.51, "timestamp": "01:43:33", "text": "这有“哦”吗？"}, {"type": "subtitle", "time": 6216.011, "timestamp": "01:43:36", "text": "我把它关掉了。"}]
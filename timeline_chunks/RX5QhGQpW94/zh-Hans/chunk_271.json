[{"type": "subtitle", "time": 16260.87, "timestamp": "04:31:00", "text": "欢迎。"}, {"type": "subtitle", "time": 16264.07, "timestamp": "04:31:04", "text": "我当时玩的是之前的奖励。"}, {"type": "subtitle", "time": 16267.03, "timestamp": "04:31:07", "text": "所以，我当时就像……呃，所以我今天……"}, {"type": "subtitle", "time": 16271.03, "timestamp": "04:31:11", "text": "录制成了两段视频。嗯"}, {"type": "subtitle", "time": 16273.269, "timestamp": "04:31:13", "text": "这就是我录制两个视频的原因。不"}, {"type": "subtitle", "time": 16275.349, "timestamp": "04:31:15", "text": "注意擦伤。我要展示我的全部"}, {"type": "subtitle", "time": 16277.67, "timestamp": "04:31:17", "text": "屏幕很差。但是，是的，不要"}, {"type": "subtitle", "time": 16281.99, "timestamp": "04:31:21", "text": "注意擦伤。但请稍等片刻。"}, {"type": "subtitle", "time": 16285.99, "timestamp": "04:31:25", "text": "耽误。别在意擦痕。"}, {"type": "subtitle", "time": 16289.83, "timestamp": "04:31:29", "text": "等待。呃，我录完了。"}, {"type": "subtitle", "time": 16293.75, "timestamp": "04:31:33", "text": "介绍一下我为什么创建了这个频道"}, {"type": "subtitle", "time": 16296.469, "timestamp": "04:31:36", "text": "以及您可以期待些什么等等。"}, {"type": "subtitle", "time": 16299.59, "timestamp": "04:31:39", "text": "这是一个6分钟的短视频。然后我"}, {"type": "subtitle", "time": 16302.469, "timestamp": "04:31:42", "text": "只有错误。然后我做了"}, {"type": "subtitle", "time": 16305.83, "timestamp": "04:31:45", "text": "技术细节版本。所以如果有人"}, {"type": "subtitle", "time": 16309.83, "timestamp": "04:31:49", "text": "谁是技术宅，谁对我的技术感兴趣？"}, {"type": "subtitle", "time": 16312.87, "timestamp": "04:31:52", "text": "这样他们就可以参考它了。我"}, {"type": "subtitle", "time": 16315.11, "timestamp": "04:31:55", "text": "成功了。这是我第一次制作"}, {"type": "subtitle", "time": 16317.83, "timestamp": "04:31:57", "text": "就像教程一样。所以，我想我会做"}]
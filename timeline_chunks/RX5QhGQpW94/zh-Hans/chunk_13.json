[{"type": "subtitle", "time": 782.87, "timestamp": "00:13:02", "text": "海滩？我不知道。呃，海滩。是的，"}, {"type": "subtitle", "time": 786.23, "timestamp": "00:13:06", "text": "那里有灯塔之类的东西。"}, {"type": "subtitle", "time": 801.11, "timestamp": "00:13:21", "text": "上次。为什么？哦，因为我要走了"}, {"type": "subtitle", "time": 803.59, "timestamp": "00:13:23", "text": "我要出国，对吧？呃，接下来"}, {"type": "subtitle", "time": 805.67, "timestamp": "00:13:25", "text": "月份，四月。"}, {"type": "subtitle", "time": 809.829, "timestamp": "00:13:29", "text": "是的。所以，上次我只有我一个人"}, {"type": "subtitle", "time": 814.31, "timestamp": "00:13:34", "text": "在印度待两个月，然后我就"}, {"type": "subtitle", "time": 816.87, "timestamp": "00:13:36", "text": "那我"}, {"type": "subtitle", "time": 820.629, "timestamp": "00:13:40", "text": "在另一个国家。是的。"}, {"type": "subtitle", "time": 825.67, "timestamp": "00:13:45", "text": "所以，呃，我不能，我不能具体说。"}, {"type": "subtitle", "time": 829.11, "timestamp": "00:13:49", "text": "我去了哪里？不过，是的，那是一个"}, {"type": "subtitle", "time": 833.509, "timestamp": "00:13:53", "text": "玩得很开心。我的表兄弟们也在那里，所以"}, {"type": "subtitle", "time": 835.19, "timestamp": "00:13:55", "text": "我"}, {"type": "subtitle", "time": 837.91, "timestamp": "00:13:57", "text": "和表兄弟姐妹们一起玩，"}]
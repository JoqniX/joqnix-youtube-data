[{"type": "subtitle", "time": 1500.549, "timestamp": "00:25:00", "text": "首位？你知道，"}, {"type": "subtitle", "time": 1504.789, "timestamp": "00:25:04", "text": "家人都同意了，他们什么都知道。"}, {"type": "subtitle", "time": 1507.11, "timestamp": "00:25:07", "text": "呃，应该期待什么，不应该期待什么"}, {"type": "subtitle", "time": 1509.75, "timestamp": "00:25:09", "text": "期望，一切，多少"}, {"type": "subtitle", "time": 1512.31, "timestamp": "00:25:12", "text": "所有费用。"}, {"type": "subtitle", "time": 1519.19, "timestamp": "00:25:19", "text": "呃"}, {"type": "subtitle", "time": 1522.07, "timestamp": "00:25:22", "text": "他们为什么同意了？卡琪，好好想想。"}, {"type": "subtitle", "time": 1530.23, "timestamp": "00:25:30", "text": "你想出国留学，你就去……"}, {"type": "subtitle", "time": 1533.11, "timestamp": "00:25:33", "text": "你对任何事物都感兴趣"}, {"type": "subtitle", "time": 1535.35, "timestamp": "00:25:35", "text": "想做。即使你要出国"}, {"type": "subtitle", "time": 1537.59, "timestamp": "00:25:37", "text": "或者留在自己的国家"}, {"type": "subtitle", "time": 1538.87, "timestamp": "00:25:38", "text": "你对某件事感兴趣，你"}, {"type": "subtitle", "time": 1542.47, "timestamp": "00:25:42", "text": "有一些你想做的事情。"}, {"type": "subtitle", "time": 1544.07, "timestamp": "00:25:44", "text": "呃"}, {"type": "subtitle", "time": 1547.43, "timestamp": "00:25:47", "text": "而你感觉自己就像……"}, {"type": "subtitle", "time": 1551.19, "timestamp": "00:25:51", "text": "有足够的自信去尝试。"}, {"type": "subtitle", "time": 1554.31, "timestamp": "00:25:54", "text": "你去试试吧。不，如果你的家人"}, {"type": "subtitle", "time": 1557.19, "timestamp": "00:25:57", "text": "情况还可以，家人也允许。"}, {"type": "subtitle", "time": 1559.11, "timestamp": "00:25:59", "text": "你会去做的，对吧？就像……"}]
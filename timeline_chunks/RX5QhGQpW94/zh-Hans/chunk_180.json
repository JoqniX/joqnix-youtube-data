[{"type": "subtitle", "time": 10800.79, "timestamp": "03:00:00", "text": "有时。是的，聊天室会是空的。"}, {"type": "subtitle", "time": 10803.03, "timestamp": "03:00:03", "text": "但只要你……，音乐就没问题。"}, {"type": "subtitle", "time": 10805.51, "timestamp": "03:00:05", "text": "男士们可以抽出一点时间"}, {"type": "subtitle", "time": 10810.79, "timestamp": "03:00:10", "text": "一起回忆或享受这些美好时光"}, {"type": "subtitle", "time": 10813.51, "timestamp": "03:00:13", "text": "作为大家共同组成的一个群体。它"}, {"type": "subtitle", "time": 10815.59, "timestamp": "03:00:15", "text": "意义重大"}, {"type": "subtitle", "time": 10817.67, "timestamp": "03:00:17", "text": "共度的美好时光"}, {"type": "subtitle", "time": 10820.389, "timestamp": "03:00:20", "text": "作为大家共同组成的一个群体。它"}, {"type": "subtitle", "time": 10822.63, "timestamp": "03:00:22", "text": "对我意义重大。我觉得我不需要"}, {"type": "subtitle", "time": 10826.469, "timestamp": "03:00:26", "text": "目前最后一个名额。"}, {"type": "subtitle", "time": 10830.79, "timestamp": "03:00:30", "text": "团结就是力量。"}, {"type": "subtitle", "time": 10834.95, "timestamp": "03:00:34", "text": "嗯，是的，我想"}, {"type": "subtitle", "time": 10837.269, "timestamp": "03:00:37", "text": "应该足够了。"}, {"type": "subtitle", "time": 10838.79, "timestamp": "03:00:38", "text": "我最想做的一件事是"}, {"type": "subtitle", "time": 10848.469, "timestamp": "03:00:48", "text": "知道它存在，我感到很开心。或许"}, {"type": "subtitle", "time": 10851.51, "timestamp": "03:00:51", "text": "总有一天会有人"}, {"type": "subtitle", "time": 10853.67, "timestamp": "03:00:53", "text": "也许有一天会有人跌倒。"}]
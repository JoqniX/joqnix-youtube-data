[{"type": "subtitle", "time": 6064.149, "timestamp": "01:41:04", "text": "好的，所以"}, {"type": "subtitle", "time": 6066.55, "timestamp": "01:41:06", "text": "呃"}, {"type": "subtitle", "time": 6077.27, "timestamp": "01:41:17", "text": "等等，别人会看到我的思绪栏。"}, {"type": "subtitle", "time": 6079.51, "timestamp": "01:41:19", "text": "我需要担心这个吗？让我"}, {"type": "subtitle", "time": 6087.59, "timestamp": "01:41:27", "text": "为什么我的消息会被吸走"}, {"type": "subtitle", "time": 6107.35, "timestamp": "01:41:47", "text": "哦，[笑声]秋天的词语。你好。"}, {"type": "subtitle", "time": 6109.51, "timestamp": "01:41:49", "text": "对不起。"}, {"type": "subtitle", "time": 6118.31, "timestamp": "01:41:58", "text": "有留言吗？你好，Crystal"}]
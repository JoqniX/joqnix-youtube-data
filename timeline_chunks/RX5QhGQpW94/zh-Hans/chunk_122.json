[{"type": "subtitle", "time": 7327.27, "timestamp": "02:02:07", "text": "兄弟，我做创作太差劲了。 [笑声]"}, {"type": "subtitle", "time": 7358.79, "timestamp": "02:02:38", "text": "该死。他对他的内容进行了新的更新。"}, {"type": "subtitle", "time": 7366.79, "timestamp": "02:02:46", "text": "好的。是我，我，就像，我该怎么做"}, {"type": "subtitle", "time": 7369.99, "timestamp": "02:02:49", "text": "怎么说？感觉就像我在做……"}, {"type": "subtitle", "time": 7376.229, "timestamp": "02:02:56", "text": "好的，"}, {"type": "subtitle", "time": 7378.629, "timestamp": "02:02:58", "text": "美好的。患病的"}]
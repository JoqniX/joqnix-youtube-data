[{"type": "subtitle", "time": 1681.59, "timestamp": "00:28:01", "text": "我们走吧。"}, {"type": "subtitle", "time": 1683.59, "timestamp": "00:28:03", "text": "你好吗？我一切都很好。刚到"}, {"type": "subtitle", "time": 1688.31, "timestamp": "00:28:08", "text": "今天结束了假期回到家。"}, {"type": "subtitle", "time": 1689.75, "timestamp": "00:28:09", "text": "嗯，我相信你正在努力。"}, {"type": "subtitle", "time": 1692.63, "timestamp": "00:28:12", "text": "边。别担心。我也是"}, {"type": "subtitle", "time": 1696.07, "timestamp": "00:28:16", "text": "担心我的东西。现在，"}, {"type": "subtitle", "time": 1698.87, "timestamp": "00:28:18", "text": "你看，我并不孤单。即使我要去，也不行。"}, {"type": "subtitle", "time": 1701.51, "timestamp": "00:28:21", "text": "去一个我没有的国家"}, {"type": "subtitle", "time": 1703.51, "timestamp": "00:28:23", "text": "谁能保护我、救我？"}, {"type": "subtitle", "time": 1707.35, "timestamp": "00:28:27", "text": "我家里的东西都摆在那里，对吧？"}, {"type": "subtitle", "time": 1709.83, "timestamp": "00:28:29", "text": "我的家人和朋友们也在那里。"}, {"type": "subtitle", "time": 1711.59, "timestamp": "00:28:31", "text": "有表兄弟姐妹吗？每个人都在吗？"}, {"type": "subtitle", "time": 1715.669, "timestamp": "00:28:35", "text": "你知道，嗯，但我不会孤单一人。"}, {"type": "subtitle", "time": 1719.43, "timestamp": "00:28:39", "text": "我交了……我交了……嗯，好朋友，不是吗？"}, {"type": "subtitle", "time": 1721.35, "timestamp": "00:28:41", "text": "日本人喜欢印度人，"}, {"type": "subtitle", "time": 1726.23, "timestamp": "00:28:46", "text": "比如，我信任的人，如果非要说的话。"}, {"type": "subtitle", "time": 1729.11, "timestamp": "00:28:49", "text": "发生任何让我迷路或困惑的事情"}, {"type": "subtitle", "time": 1732.87, "timestamp": "00:28:52", "text": "我能联系到他们的任何方式"}, {"type": "subtitle", "time": 1737.669, "timestamp": "00:28:57", "text": "一切都好，对，同学们，加油！"}, {"type": "subtitle", "time": 1739.99, "timestamp": "00:28:59", "text": "日本学校的同学，他们也是"}]
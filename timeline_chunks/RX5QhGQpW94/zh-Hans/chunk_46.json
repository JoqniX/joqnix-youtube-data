[{"type": "subtitle", "time": 2760.71, "timestamp": "00:46:00", "text": "是的。"}, {"type": "subtitle", "time": 2765.27, "timestamp": "00:46:05", "text": "天哪，用蓝牙聊天真贵啊。"}, {"type": "subtitle", "time": 2779.03, "timestamp": "00:46:19", "text": "我的天哪，我太兴奋了！"}, {"type": "subtitle", "time": 2784.63, "timestamp": "00:46:24", "text": "我对此感到非常兴奋。我希望"}, {"type": "subtitle", "time": 2797.75, "timestamp": "00:46:37", "text": "好的，让我先修复这个漏洞，然后我们再看看情况。"}, {"type": "subtitle", "time": 2801.349, "timestamp": "00:46:41", "text": "我不富有。你看，如果我很有钱，我"}, {"type": "subtitle", "time": 2803.43, "timestamp": "00:46:43", "text": "直播中不会有目标"}, {"type": "subtitle", "time": 2806.069, "timestamp": "00:46:46", "text": "尽管。"}, {"type": "subtitle", "time": 2807.99, "timestamp": "00:46:47", "text": "就好像我需要钱来做我的模型一样"}, {"type": "subtitle", "time": 2812.15, "timestamp": "00:46:52", "text": "还有一些其他的东西。没有。 2000美元相当于多少钱"}, {"type": "subtitle", "time": 2815.589, "timestamp": "00:46:55", "text": "呃，用印度卢比吗？就像你可以"}, {"type": "subtitle", "time": 2818.47, "timestamp": "00:46:58", "text": "买一个新的"}]
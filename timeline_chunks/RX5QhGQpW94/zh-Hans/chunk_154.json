[{"type": "subtitle", "time": 9242.07, "timestamp": "02:34:02", "text": "你好，莱兰德。欢迎，"}, {"type": "subtitle", "time": 9243.91, "timestamp": "02:34:03", "text": "欢迎，欢迎。我今天过得很愉快。我"}, {"type": "subtitle", "time": 9252.15, "timestamp": "02:34:12", "text": "下一个笑话。责怪"}, {"type": "subtitle", "time": 9257.03, "timestamp": "02:34:17", "text": "人工智能或用于识别的音频字幕"}, {"type": "subtitle", "time": 9258.95, "timestamp": "02:34:18", "text": "我的声音。"}, {"type": "subtitle", "time": 9262.15, "timestamp": "02:34:22", "text": "假设我接下来说的是运动员。我说"}, {"type": "subtitle", "time": 9267.691, "timestamp": "02:34:27", "text": "[笑声]"}, {"type": "subtitle", "time": 9269.429, "timestamp": "02:34:29", "text": "[倒吸一口气]"}, {"type": "subtitle", "time": 9270.95, "timestamp": "02:34:30", "text": "你好。"}, {"type": "subtitle", "time": 9281.349, "timestamp": "02:34:41", "text": "好的，等等。我觉得我可以"}, {"type": "subtitle", "time": 9283.91, "timestamp": "02:34:43", "text": "执行涟漪删除。我觉得（音乐）"}, {"type": "subtitle", "time": 9285.51, "timestamp": "02:34:45", "text": "时间线"}, {"type": "subtitle", "time": 9288.469, "timestamp": "02:34:48", "text": "声音的。"}, {"type": "subtitle", "time": 9292.95, "timestamp": "02:34:52", "text": "呃，视频。呃，没有人工智能。"}]
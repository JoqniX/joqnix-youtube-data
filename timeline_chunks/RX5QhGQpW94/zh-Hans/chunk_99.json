[{"type": "subtitle", "time": 5944.79, "timestamp": "01:39:04", "text": "兄弟，我的浏览器现在卡顿了。什么？"}, {"type": "subtitle", "time": 5951.189, "timestamp": "01:39:11", "text": "好的，它有点卡顿。"}, {"type": "subtitle", "time": 5954.709, "timestamp": "01:39:14", "text": "好了，它回来了。呃，花生。花生。"}, {"type": "subtitle", "time": 5957.91, "timestamp": "01:39:17", "text": "我这就搜一下"}, {"type": "subtitle", "time": 5961.109, "timestamp": "01:39:21", "text": "始终在线。所以，呃，当我开始"}, {"type": "subtitle", "time": 5964.07, "timestamp": "01:39:24", "text": "话题，我只想谈谈这个。"}, {"type": "subtitle", "time": 5967.51, "timestamp": "01:39:27", "text": "一般来说，都是24小时不间断直播，对吧？如何"}, {"type": "subtitle", "time": 5969.669, "timestamp": "01:39:29", "text": "它们被制造出来了。然后我得谈谈……"}, {"type": "subtitle", "time": 5973.189, "timestamp": "01:39:33", "text": "那个付费的东西将会是"}, {"type": "subtitle", "time": 5975.27, "timestamp": "01:39:35", "text": "云端 OBS。"}, {"type": "subtitle", "time": 5977.669, "timestamp": "01:39:37", "text": "那将是"}, {"type": "subtitle", "time": 5981.59, "timestamp": "01:39:41", "text": "IL主机和"}, {"type": "subtitle", "time": 5985.189, "timestamp": "01:39:45", "text": "它在哪里？它在哪里？安迪的袖口。"}, {"type": "subtitle", "time": 5988.39, "timestamp": "01:39:48", "text": "这是3000美元，对吧？ 200是多少？"}, {"type": "subtitle", "time": 5990.07, "timestamp": "01:39:50", "text": "这"}, {"type": "subtitle", "time": 5993.75, "timestamp": "01:39:53", "text": "为了？好的。每月90美元。而我拥有这个"}, {"type": "subtitle", "time": 5996.629, "timestamp": "01:39:56", "text": "也想谈谈这件事。"}]
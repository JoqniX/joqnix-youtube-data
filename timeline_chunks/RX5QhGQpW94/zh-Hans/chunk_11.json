[{"type": "subtitle", "time": 662.202, "timestamp": "00:11:02", "text": "我想测试一下。"}, {"type": "subtitle", "time": 663.269, "timestamp": "00:11:03", "text": "[清嗓子]"}, {"type": "subtitle", "time": 666.87, "timestamp": "00:11:06", "text": "嗯，是的，你知道，嗯，当我……"}, {"type": "subtitle", "time": 670.71, "timestamp": "00:11:10", "text": "我离开电脑的时候，就像远程办公一样。"}, {"type": "subtitle", "time": 673.35, "timestamp": "00:11:13", "text": "控制电脑，这样我就可以检查了。"}, {"type": "subtitle", "time": 676.55, "timestamp": "00:11:16", "text": "我的板子频道上总是会更新"}, {"type": "subtitle", "time": 680.069, "timestamp": "00:11:20", "text": "频道相关的事情，我得去做我的……"}, {"type": "subtitle", "time": 682.15, "timestamp": "00:11:22", "text": "每日新闻，对吧？ [笑声]"}, {"type": "subtitle", "time": 686.71, "timestamp": "00:11:26", "text": "蓝色协议每日记录。所以我一直……"}, {"type": "subtitle", "time": 689.03, "timestamp": "00:11:29", "text": "远程控制我的电脑，我喜欢这样做"}, {"type": "subtitle", "time": 692.87, "timestamp": "00:11:32", "text": "我的日常记录等等。"}, {"type": "subtitle", "time": 695.509, "timestamp": "00:11:35", "text": "谢天谢地，没有停电。"}, {"type": "subtitle", "time": 698.31, "timestamp": "00:11:38", "text": "四天。"}, {"type": "subtitle", "time": 699.829, "timestamp": "00:11:39", "text": "你去哪儿了？我一直在……"}, {"type": "subtitle", "time": 703.509, "timestamp": "00:11:43", "text": "假期。假期很愉快。花费我"}, {"type": "subtitle", "time": 706.63, "timestamp": "00:11:46", "text": "多花时间陪伴家人。真是"}, {"type": "subtitle", "time": 709.75, "timestamp": "00:11:49", "text": "乐趣。很喜欢。"}, {"type": "subtitle", "time": 712.47, "timestamp": "00:11:52", "text": "我和家人共度了时光。"}, {"type": "subtitle", "time": 714.47, "timestamp": "00:11:54", "text": "是的。"}]
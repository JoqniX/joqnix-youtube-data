[{"type": "subtitle", "time": 14280.389, "timestamp": "03:58:00", "text": "顺序意味着每当一个新的"}, {"type": "subtitle", "time": 14282.71, "timestamp": "03:58:02", "text": "播放列表一旦创建，它将永远存在。"}, {"type": "subtitle", "time": 14285.51, "timestamp": "03:58:05", "text": "以顺序模式创建，这意味着"}, {"type": "subtitle", "time": 14288.469, "timestamp": "03:58:08", "text": "就像在序列模式下，比如一个视频"}, {"type": "subtitle", "time": 14292.79, "timestamp": "03:58:12", "text": "数字部分 1 2 3 像这样随机"}, {"type": "subtitle", "time": 14294.95, "timestamp": "03:58:14", "text": "所以我做了，我会在后面谈到这件事。"}, {"type": "subtitle", "time": 14297.269, "timestamp": "03:58:17", "text": "第三个按钮：精选词语循环"}, {"type": "subtitle", "time": 14298.87, "timestamp": "03:58:18", "text": "自动激活"}, {"type": "subtitle", "time": 14302.469, "timestamp": "03:58:22", "text": "所以随机模式也会如此"}, {"type": "subtitle", "time": 14304.71, "timestamp": "03:58:24", "text": "实际上会循环往复地经历"}, {"type": "subtitle", "time": 14308.63, "timestamp": "03:58:28", "text": "播放列表，但顺序随机。"}, {"type": "subtitle", "time": 14311.83, "timestamp": "03:58:31", "text": "基本上就是这样。"}, {"type": "subtitle", "time": 14314.79, "timestamp": "03:58:34", "text": "所以，这里是精选歌单："}, {"type": "subtitle", "time": 14317.83, "timestamp": "03:58:37", "text": "单曲版，嗯，我想是单曲版"}, {"type": "subtitle", "time": 14319.764, "timestamp": "03:58:39", "text": "这是我目前使用的版本。"}, {"type": "subtitle", "time": 14321.91, "timestamp": "03:58:41", "text": "[音乐] 我把它循环播放了或者"}, {"type": "subtitle", "time": 14324.469, "timestamp": "03:58:44", "text": "某物。"}, {"type": "subtitle", "time": 14327.11, "timestamp": "03:58:47", "text": "是的。"}, {"type": "subtitle", "time": 14332.07, "timestamp": "03:58:52", "text": "嗯，是的，正如你所看到的，嗯，对于那些"}, {"type": "subtitle", "time": 14334.309, "timestamp": "03:58:54", "text": "看到这条信息的人，你们会非常开心！"}, {"type": "subtitle", "time": 14337.03, "timestamp": "03:58:57", "text": "完全搞不清楚到底发生了什么"}]
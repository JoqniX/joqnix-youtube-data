[{"type": "subtitle", "time": 15482.63, "timestamp": "04:18:02", "text": "这就是我实施该系统的原因。"}, {"type": "subtitle", "time": 15486.309, "timestamp": "04:18:06", "text": "Sammy 和主播机器人中的一切都不是"}, {"type": "subtitle", "time": 15489.269, "timestamp": "04:18:09", "text": "主播机器人，对，萨米，就是这样。"}, {"type": "subtitle", "time": 15491.91, "timestamp": "04:18:11", "text": "我为什么要在 Sammy 中实现这一切"}, {"type": "subtitle", "time": 15495.11, "timestamp": "04:18:15", "text": "网络工作室与类似系统的概念相契合。"}, {"type": "subtitle", "time": 15499.11, "timestamp": "04:18:19", "text": "嗨，希望你喜欢我的技术讲解。"}, {"type": "subtitle", "time": 15503.03, "timestamp": "04:18:23", "text": "细节有点……呃，让人困惑"}, {"type": "subtitle", "time": 15507.269, "timestamp": "04:18:27", "text": "类似教程的东西。嗨，如果你喜欢的话，"}, {"type": "subtitle", "time": 15510.469, "timestamp": "04:18:30", "text": "请在下方留言。如果你没有"}, {"type": "subtitle", "time": 15513.03, "timestamp": "04:18:33", "text": "完全理解也没关系。"}, {"type": "subtitle", "time": 15515.429, "timestamp": "04:18:35", "text": "你不必为此担心。如果"}, {"type": "subtitle", "time": 15518.469, "timestamp": "04:18:38", "text": "你充满好奇心，并且对此感兴趣。"}, {"type": "subtitle", "time": 15521.99, "timestamp": "04:18:41", "text": "并且想了解更多相关信息，感觉"}, {"type": "subtitle", "time": 15524.469, "timestamp": "04:18:44", "text": "欢迎在评论区告诉我。"}, {"type": "subtitle", "time": 15525.99, "timestamp": "04:18:45", "text": "以下部分[音乐]"}, {"type": "subtitle", "time": 15530.55, "timestamp": "04:18:50", "text": "我很乐意深入探讨。雅浦"}, {"type": "subtitle", "time": 15533.83, "timestamp": "04:18:53", "text": "关于我如何做这些事情。"}]
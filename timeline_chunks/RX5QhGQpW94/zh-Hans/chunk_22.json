[{"type": "subtitle", "time": 1328.71, "timestamp": "00:22:08", "text": "正是如此。"}, {"type": "subtitle", "time": 1332.31, "timestamp": "00:22:12", "text": "好的，没错。"}, {"type": "subtitle", "time": 1334.789, "timestamp": "00:22:14", "text": "我想展示我的屏幕，但我希望"}, {"type": "subtitle", "time": 1337.75, "timestamp": "00:22:17", "text": "这并不太技术性，因为……"}, {"type": "subtitle", "time": 1340.47, "timestamp": "00:22:20", "text": "很多。我也得做一个教程。"}, {"type": "subtitle", "time": 1342.95, "timestamp": "00:22:22", "text": "不。所以，我得想办法把它做出来。"}, {"type": "subtitle", "time": 1345.11, "timestamp": "00:22:25", "text": "更漂亮。"}, {"type": "subtitle", "time": 1348.95, "timestamp": "00:22:28", "text": "天哪，工作好多啊。哇。"}, {"type": "subtitle", "time": 1352.58, "timestamp": "00:22:32", "text": "我刚回来。"}, {"type": "subtitle", "time": 1355.11, "timestamp": "00:22:35", "text": "[倒吸一口凉气] 工作量好大。好的，让我来做"}, {"type": "subtitle", "time": 1358.95, "timestamp": "00:22:38", "text": "宣布我已上线。"}, {"type": "subtitle", "time": 1360.95, "timestamp": "00:22:40", "text": "我得去做，我忘了去做。"}, {"type": "subtitle", "time": 1378.78, "timestamp": "00:22:58", "text": "你好像已经忘记了事情原本的样子。"}]
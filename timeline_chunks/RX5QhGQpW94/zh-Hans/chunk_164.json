[{"type": "subtitle", "time": 9843.429, "timestamp": "02:44:03", "text": "24频道"}, {"type": "subtitle", "time": 9847.349, "timestamp": "02:44:07", "text": "将会直播，我也会直播。"}, {"type": "subtitle", "time": 9850.469, "timestamp": "02:44:10", "text": "但将来我会做到这一点。"}, {"type": "subtitle", "time": 9853.91, "timestamp": "02:44:13", "text": "每当我"}, {"type": "subtitle", "time": 9856.63, "timestamp": "02:44:16", "text": "那[哼]"}, {"type": "subtitle", "time": 9858.71, "timestamp": "02:44:18", "text": "为什么我必须手动切割？"}, {"type": "subtitle", "time": 9861.269, "timestamp": "02:44:21", "text": "沉默？我以为人工智能会保持沉默"}, {"type": "chat", "time": 9870.022, "timestamp": "02:44:30", "author": "@abhaynair7276", "avatar": "https://yt4.ggpht.com/ytc/AIdro_m3_pcx7bakRsuScPVawS3lNZlHTFLM8XHTpdd1EGU=s64-c-k-c0x00ffffff-no-rj", "message": "is it just me that when I hear my voice I die hearing it out of embarrassment"}, {"type": "subtitle", "time": 9870.469, "timestamp": "02:44:30", "text": "24小时直播将会暂停，但"}, {"type": "subtitle", "time": 9876.389, "timestamp": "02:44:36", "text": "即将上线。所以每当你看到“啊”的时候"}, {"type": "subtitle", "time": 9878.23, "timestamp": "02:44:38", "text": "只有我一个人，当我听到自己的声音时，我就会死去。"}, {"type": "subtitle", "time": 9880.79, "timestamp": "02:44:40", "text": "听到有人说“是啊，我也是”。我也是。我"}, {"type": "subtitle", "time": 9884.55, "timestamp": "02:44:44", "text": "已经习惯了。这花了一段时间。"}, {"type": "subtitle", "time": 9887.19, "timestamp": "02:44:47", "text": "我仍然不……我仍然讨厌我的"}, {"type": "subtitle", "time": 9892.79, "timestamp": "02:44:52", "text": "[清嗓子]"}, {"type": "subtitle", "time": 9897.75, "timestamp": "02:44:57", "text": "呃，我明白了，你现在必须做这件事了。"}]
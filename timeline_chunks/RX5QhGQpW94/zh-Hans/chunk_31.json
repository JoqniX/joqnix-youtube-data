[{"type": "subtitle", "time": 1863.75, "timestamp": "00:31:03", "text": "嗯，其中一个去了"}, {"type": "subtitle", "time": 1866.87, "timestamp": "00:31:06", "text": "一个人去了喜欢的地方"}, {"type": "subtitle", "time": 1870.07, "timestamp": "00:31:10", "text": "这个国家叫什么名字？上帝啊，这是怎么回事？"}, {"type": "subtitle", "time": 1872.87, "timestamp": "00:31:12", "text": "名字？爱尔兰。是的。一个去了"}, {"type": "subtitle", "time": 1874.549, "timestamp": "00:31:14", "text": "爱尔兰。"}, {"type": "subtitle", "time": 1876.549, "timestamp": "00:31:16", "text": "理性永存。其余一切皆会消逝。"}, {"type": "subtitle", "time": 1885.101, "timestamp": "00:31:25", "text": "热爱生活。 [笑声]"}, {"type": "subtitle", "time": 1893.99, "timestamp": "00:31:33", "text": "所以，大家最近都在忙些什么呢？"}, {"type": "subtitle", "time": 1896.549, "timestamp": "00:31:36", "text": "生活过得怎么样？"}, {"type": "subtitle", "time": 1899.11, "timestamp": "00:31:39", "text": "一切都好吗？"}, {"type": "subtitle", "time": 1901.19, "timestamp": "00:31:41", "text": "告诉我。我跟不上时代了。"}, {"type": "subtitle", "time": 1903.75, "timestamp": "00:31:43", "text": "互联网上发生了什么"}, {"type": "subtitle", "time": 1910.23, "timestamp": "00:31:50", "text": "所以这就是学生们出国留学的方式。"}, {"type": "subtitle", "time": 1912.87, "timestamp": "00:31:52", "text": "佣金，对吧？它更像是一个"}, {"type": "subtitle", "time": 1916.07, "timestamp": "00:31:56", "text": "MCN，就像他们教这门语言一样，他们"}, {"type": "subtitle", "time": 1917.909, "timestamp": "00:31:57", "text": "教授文化方面的知识"}]
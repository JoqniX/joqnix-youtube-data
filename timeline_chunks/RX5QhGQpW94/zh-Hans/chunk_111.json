[{"type": "subtitle", "time": 6663.109, "timestamp": "01:51:03", "text": "是的，录音和飞行员都是"}, {"type": "subtitle", "time": 6666.31, "timestamp": "01:51:06", "text": "在职的。好的。"}, {"type": "subtitle", "time": 6669.51, "timestamp": "01:51:09", "text": "我百分之百确定，如果这行不通的话，"}, {"type": "subtitle", "time": 6672.47, "timestamp": "01:51:12", "text": "我打算把整个过程重做一遍。"}, {"type": "subtitle", "time": 6675.99, "timestamp": "01:51:15", "text": "直播中断了，伙计。"}, {"type": "subtitle", "time": 6677.51, "timestamp": "01:51:17", "text": "好的，"}, {"type": "subtitle", "time": 6680.149, "timestamp": "01:51:20", "text": "关闭此窗口。嗨，请欣赏背景。"}, {"type": "subtitle", "time": 6684.87, "timestamp": "01:51:24", "text": "音乐。嗨，我们开始吧。"}, {"type": "subtitle", "time": 6687.51, "timestamp": "01:51:27", "text": "我的剧本准备好了吗？ [笑声] 我"}, {"type": "subtitle", "time": 6695.99, "timestamp": "01:51:35", "text": "另外，还要检查存储情况。存储容量是多少"}, {"type": "subtitle", "time": 6697.75, "timestamp": "01:51:37", "text": "我有？"}, {"type": "subtitle", "time": 6701.372, "timestamp": "01:51:41", "text": "我的天啊，我们的存储空间严重不足。"}, {"type": "subtitle", "time": 6702.07, "timestamp": "01:51:42", "text": "[笑声]"}, {"type": "subtitle", "time": 6704.87, "timestamp": "01:51:44", "text": "没关系。没关系。不会太"}, {"type": "subtitle", "time": 6710.709, "timestamp": "01:51:50", "text": "不会太多。不会太"}, {"type": "subtitle", "time": 6719.27, "timestamp": "01:51:59", "text": "呃。"}]
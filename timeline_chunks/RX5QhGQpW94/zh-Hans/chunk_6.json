[{"type": "subtitle", "time": 377.189, "timestamp": "00:06:17", "text": "大家好。"}, {"type": "subtitle", "time": 379.909, "timestamp": "00:06:19", "text": "我能被听到吗？我希望我的声音能被听到。"}, {"type": "subtitle", "time": 382.55, "timestamp": "00:06:22", "text": "你好。你好。"}, {"type": "subtitle", "time": 390.469, "timestamp": "00:06:30", "text": "大家最近怎么样？你好。"}, {"type": "subtitle", "time": 393.83, "timestamp": "00:06:33", "text": "哦，稍等一下。呃，"}, {"type": "subtitle", "time": 395.749, "timestamp": "00:06:35", "text": "我今天真是倒霉透了（清嗓子）"}, {"type": "subtitle", "time": 399.43, "timestamp": "00:06:39", "text": "在我的直播结束后，我又开始直播了"}, {"type": "subtitle", "time": 402.23, "timestamp": "00:06:42", "text": "假期。我开始变得像个傻瓜一样"}, {"type": "subtitle", "time": 407.189, "timestamp": "00:06:47", "text": "我的后端出现了大量的错误。和"}, {"type": "subtitle", "time": 409.369, "timestamp": "00:06:49", "text": "我当时就想，“兄弟，这到底是怎么回事？”"}, {"type": "subtitle", "time": 410.87, "timestamp": "00:06:50", "text": "[笑声]"}, {"type": "subtitle", "time": 414.609, "timestamp": "00:06:54", "text": "我一直在做很多事"}, {"type": "subtitle", "time": 416.87, "timestamp": "00:06:56", "text": "[清嗓子] 我一直在做很多"}, {"type": "subtitle", "time": 418.469, "timestamp": "00:06:58", "text": "呃"}]
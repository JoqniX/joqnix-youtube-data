[{"type": "subtitle", "time": 1080.07, "timestamp": "00:18:00", "text": "我非常希望拥有像……一样的东西"}, {"type": "subtitle", "time": 1082.07, "timestamp": "00:18:02", "text": "奖学金之类的。我非常乐意"}, {"type": "subtitle", "time": 1084.027, "timestamp": "00:18:04", "text": "致，男人。"}, {"type": "subtitle", "time": 1090.95, "timestamp": "00:18:10", "text": "我希望如此。是的，"}, {"type": "subtitle", "time": 1109.51, "timestamp": "00:18:29", "text": "兄弟，这到底是怎么回事？"}, {"type": "subtitle", "time": 1112.63, "timestamp": "00:18:32", "text": "我甚至都不能宣布我正在直播"}, {"type": "subtitle", "time": 1116.63, "timestamp": "00:18:36", "text": "在 YouTube 和 Discord 上进行直播。兄弟，"}, {"type": "subtitle", "time": 1119.59, "timestamp": "00:18:39", "text": "到底哪里出了问题？"}, {"type": "subtitle", "time": 1121.11, "timestamp": "00:18:41", "text": "什么？"}, {"type": "subtitle", "time": 1123.669, "timestamp": "00:18:43", "text": "我哪里出错了？那么，在哪里？"}, {"type": "subtitle", "time": 1126.549, "timestamp": "00:18:46", "text": "你要去吗？我要去追逐我的未来。"}, {"type": "subtitle", "time": 1128.71, "timestamp": "00:18:48", "text": "东西。"}, {"type": "subtitle", "time": 1130.87, "timestamp": "00:18:50", "text": "我要去那里学习"}, {"type": "subtitle", "time": 1132.549, "timestamp": "00:18:52", "text": "语言。"}, {"type": "subtitle", "time": 1137.029, "timestamp": "00:18:57", "text": "呃，读大学学位，然后拿到一个"}]
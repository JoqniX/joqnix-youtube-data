[{"type": "subtitle", "time": 1622.23, "timestamp": "00:27:02", "text": "大概播放五、六、七次。"}, {"type": "subtitle", "time": 1624.47, "timestamp": "00:27:04", "text": "我觉得那是最大的"}, {"type": "subtitle", "time": 1630.95, "timestamp": "00:27:10", "text": "犯错，因为你知道，那天我"}, {"type": "subtitle", "time": 1633.51, "timestamp": "00:27:13", "text": "开始敞开心扉谈论我的个人生活"}, {"type": "subtitle", "time": 1635.51, "timestamp": "00:27:15", "text": "生活琐事"}, {"type": "subtitle", "time": 1638.549, "timestamp": "00:27:18", "text": "呃，我开始明白事情的两面性了。"}, {"type": "subtitle", "time": 1641.909, "timestamp": "00:27:21", "text": "人们。一方是支持方，"}, {"type": "subtitle", "time": 1646.07, "timestamp": "00:27:26", "text": "另一方面，也是令人担忧的一面。"}, {"type": "subtitle", "time": 1648.789, "timestamp": "00:27:28", "text": "所以我不知道，通常情况下人们"}, {"type": "subtitle", "time": 1651.029, "timestamp": "00:27:31", "text": "不要分享"}, {"type": "subtitle", "time": 1654.789, "timestamp": "00:27:34", "text": "嗯，他们在私生活中做的事情"}, {"type": "subtitle", "time": 1658.39, "timestamp": "00:27:38", "text": "现在。是的，我想我犯了那个错误。"}, {"type": "subtitle", "time": 1660.39, "timestamp": "00:27:40", "text": "但没关系，我们从中吸取了教训"}, {"type": "subtitle", "time": 1664.95, "timestamp": "00:27:44", "text": "现在有些错误，不过你好，欢迎。"}, {"type": "subtitle", "time": 1668.789, "timestamp": "00:27:48", "text": "好久不见了。生活如何？"}, {"type": "subtitle", "time": 1670.87, "timestamp": "00:27:50", "text": "晚上好。"}, {"type": "subtitle", "time": 1673.83, "timestamp": "00:27:53", "text": "恭喜。等等什么？经过"}, {"type": "subtitle", "time": 1675.35, "timestamp": "00:27:55", "text": "因为我也开始直播了"}, {"type": "subtitle", "time": 1678.63, "timestamp": "00:27:58", "text": "制作视频。哦，好，好，好。"}]
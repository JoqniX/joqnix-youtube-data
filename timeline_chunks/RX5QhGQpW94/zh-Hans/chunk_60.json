[{"type": "subtitle", "time": 3601.349, "timestamp": "01:00:01", "text": "连续一周，每周六。现在"}, {"type": "subtitle", "time": 3604.63, "timestamp": "01:00:04", "text": "战地、命运2和钢琴"}, {"type": "subtitle", "time": 3607.109, "timestamp": "01:00:07", "text": "学习，对吧？所以钢琴学习开始了"}, {"type": "subtitle", "time": 3610.71, "timestamp": "01:00:10", "text": "随机状态"}, {"type": "subtitle", "time": 3612.47, "timestamp": "01:00:12", "text": "是的，《战地》和《命运》也是。"}, {"type": "subtitle", "time": 3614.63, "timestamp": "01:00:14", "text": "随机状态。所以它们是顺序的，而且"}, {"type": "subtitle", "time": 3617.03, "timestamp": "01:00:17", "text": "随机的。随机意味着它看起来会像这样"}, {"type": "subtitle", "time": 3620.63, "timestamp": "01:00:20", "text": "这。仅限钢琴学习播放列表"}, {"type": "subtitle", "time": 3623.589, "timestamp": "01:00:23", "text": "因为只有一个视频，所以只会显示一个。"}, {"type": "subtitle", "time": 3625.829, "timestamp": "01:00:25", "text": "其次是战场。"}, {"type": "subtitle", "time": 3628.549, "timestamp": "01:00:28", "text": "正确的。所以它会一直保持随机性。"}, {"type": "subtitle", "time": 3631.91, "timestamp": "01:00:31", "text": "它不会像某一集那样，呃，一部分。"}, {"type": "subtitle", "time": 3634.309, "timestamp": "01:00:34", "text": "第一部分，第二部分，第三部分。顺序是"}, {"type": "subtitle", "time": 3637.589, "timestamp": "01:00:37", "text": "就像编号随机数一样，会被随机化。"}, {"type": "subtitle", "time": 3640.47, "timestamp": "01:00:40", "text": "情况不会一样了。没有重演"}, {"type": "subtitle", "time": 3644.15, "timestamp": "01:00:44", "text": "那里会有溪流。然后……"}, {"type": "subtitle", "time": 3648.15, "timestamp": "01:00:48", "text": "进入三个播放列表"}, {"type": "subtitle", "time": 3651.829, "timestamp": "01:00:51", "text": "其余内容将随机生成。"}, {"type": "subtitle", "time": 3655.829, "timestamp": "01:00:55", "text": "我上传了大约90个视频。所以这是为了"}, {"type": "subtitle", "time": 3658.789, "timestamp": "01:00:58", "text": "就像一周的[吸食]"}]
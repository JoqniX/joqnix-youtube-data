[{"type": "subtitle", "time": 4261.75, "timestamp": "01:11:01", "text": "你需要多久才能学会？"}, {"type": "subtitle", "time": 4264.79, "timestamp": "01:11:04", "text": "正在看吗？说实话，我"}, {"type": "subtitle", "time": 4267.35, "timestamp": "01:11:07", "text": "自从萨米的事情发生以来，我就一直在做萨米的事情。"}, {"type": "subtitle", "time": 4270.07, "timestamp": "01:11:10", "text": "大约在 2021 年发布。"}, {"type": "subtitle", "time": 4274.63, "timestamp": "01:11:14", "text": "它以前被称为利奥林板。"}, {"type": "subtitle", "time": 4277.35, "timestamp": "01:11:17", "text": "是的。问题是，我不会告诉你我的"}, {"type": "subtitle", "time": 4280.149, "timestamp": "01:11:20", "text": "我的想法，我的东西。"}, {"type": "subtitle", "time": 4283.75, "timestamp": "01:11:23", "text": "所以，我有个独特的想法，我想……"}, {"type": "subtitle", "time": 4287.59, "timestamp": "01:11:27", "text": "为我的直播做点什么"}, {"type": "subtitle", "time": 4289.91, "timestamp": "01:11:29", "text": "然后我就会想，好吧，我想做这件事。"}, {"type": "subtitle", "time": 4292.229, "timestamp": "01:11:32", "text": "我该怎么做？我就随便玩玩。"}, {"type": "subtitle", "time": 4295.189, "timestamp": "01:11:35", "text": "就像你在玩 Photoshop 一样。"}, {"type": "subtitle", "time": 4297.51, "timestamp": "01:11:37", "text": "或者 Adob​​e Illustrator 之类的软件。不，就像"}, {"type": "subtitle", "time": 4300.31, "timestamp": "01:11:40", "text": "你摆弄了一下软件，"}, {"type": "subtitle", "time": 4302.55, "timestamp": "01:11:42", "text": "正确的？但当你感到困惑时，"}, {"type": "subtitle", "time": 4307.27, "timestamp": "01:11:47", "text": "迷路了，我直接去了客服服务器。"}, {"type": "subtitle", "time": 4310.07, "timestamp": "01:11:50", "text": "萨米的。"}, {"type": "subtitle", "time": 4312.79, "timestamp": "01:11:52", "text": "是的，就像在这里，我感觉我就像我曾经那样"}, {"type": "subtitle", "time": 4316.31, "timestamp": "01:11:56", "text": "API 时间方面有些事情耽搁了。"}, {"type": "subtitle", "time": 4319.27, "timestamp": "01:11:59", "text": "API相关内容。所以我问了我的疑问：我该如何才能做到？"}]
[{"type": "subtitle", "time": 14232.229, "timestamp": "03:57:12", "text": "一个我可以控制哪种系统的"}, {"type": "subtitle", "time": 14236.07, "timestamp": "03:57:16", "text": "我想要24小时频道播放列表。"}, {"type": "subtitle", "time": 14241.59, "timestamp": "03:57:21", "text": "频道要播放。所以我可以"}, {"type": "subtitle", "time": 14244.469, "timestamp": "03:57:24", "text": "点击以下任意播放列表。所以我可以"}, {"type": "subtitle", "time": 14249.11, "timestamp": "03:57:29", "text": "点击此处激活，即可获取"}, {"type": "subtitle", "time": 14251.67, "timestamp": "03:57:31", "text": "它将从以下位置获取视频："}, {"type": "subtitle", "time": 14254.79, "timestamp": "03:57:34", "text": "播放列表 ID。所以它在这里的作用是"}, {"type": "subtitle", "time": 14258.95, "timestamp": "03:57:38", "text": "将获取包含以下内容的任何播放列表"}, {"type": "subtitle", "time": 14263.189, "timestamp": "03:57:43", "text": "活动属性带有勾选标记"}, {"type": "subtitle", "time": 14267.349, "timestamp": "03:57:47", "text": "这边。它会获取所有视频"}, {"type": "subtitle", "time": 14270.95, "timestamp": "03:57:50", "text": "那个播放列表。是的。"}, {"type": "subtitle", "time": 14274.55, "timestamp": "03:57:54", "text": "然后我在这里提到了模式"}, {"type": "subtitle", "time": 14277.269, "timestamp": "03:57:57", "text": "房产就在这里"}]
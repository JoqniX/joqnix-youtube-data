[{"type": "subtitle", "time": 2404.069, "timestamp": "00:40:04", "text": "呃，虽然我只完成了数学课程"}, {"type": "subtitle", "time": 2406.069, "timestamp": "00:40:06", "text": "完全关于"}, {"type": "subtitle", "time": 2410.39, "timestamp": "00:40:10", "text": "物理 12。是 515 20%。哦，已经很久了。"}, {"type": "subtitle", "time": 2412.87, "timestamp": "00:40:12", "text": "一点。假期过得怎么样？假期是"}, {"type": "subtitle", "time": 2414.069, "timestamp": "00:40:14", "text": "好的。"}, {"type": "subtitle", "time": 2417.19, "timestamp": "00:40:17", "text": "我花时间陪伴家人。"}, {"type": "subtitle", "time": 2419.99, "timestamp": "00:40:19", "text": "我需要一些和家人在一起的时光。那是"}, {"type": "subtitle", "time": 2424.069, "timestamp": "00:40:24", "text": "好的。很喜欢。"}, {"type": "subtitle", "time": 2427.349, "timestamp": "00:40:27", "text": "是的。我觉得我需要保留那些"}, {"type": "subtitle", "time": 2430.47, "timestamp": "00:40:30", "text": "照片和所有东西都保存了"}, {"type": "subtitle", "time": 2438.95, "timestamp": "00:40:38", "text": "我的手机存储空间已满。满的。"}, {"type": "subtitle", "time": 2444.71, "timestamp": "00:40:44", "text": "我的手机存储空间已满。兄弟，我需要一个"}, {"type": "subtitle", "time": 2448.79, "timestamp": "00:40:48", "text": "我需要一张我买的类似存储卡的东西"}, {"type": "subtitle", "time": 2451.51, "timestamp": "00:40:51", "text": "今天。我当时订购了它"}, {"type": "subtitle", "time": 2454.55, "timestamp": "00:40:54", "text": "回家了。"}, {"type": "subtitle", "time": 2456.71, "timestamp": "00:40:56", "text": "嗯"}]
[{"type": "subtitle", "time": 5101.83, "timestamp": "01:25:01", "text": "知道什么？"}, {"type": "subtitle", "time": 5105.11, "timestamp": "01:25:05", "text": "我要禁用这个按钮，这样我"}, {"type": "subtitle", "time": 5110.149, "timestamp": "01:25:10", "text": "我不明白，所以我也不明白。"}, {"type": "subtitle", "time": 5112.47, "timestamp": "01:25:12", "text": "呃，它在哪儿？"}, {"type": "subtitle", "time": 5114.39, "timestamp": "01:25:14", "text": "我要把它禁用掉，所以我"}, {"type": "subtitle", "time": 5116.39, "timestamp": "01:25:16", "text": "不要被打断。"}, {"type": "subtitle", "time": 5119.669, "timestamp": "01:25:19", "text": "我没时间在直播中解决这个问题。"}, {"type": "subtitle", "time": 5122.149, "timestamp": "01:25:22", "text": "好的，那我把按钮禁用掉。"}, {"type": "subtitle", "time": 5124.629, "timestamp": "01:25:24", "text": "呃，我得尽快开始录音。好的。"}, {"type": "subtitle", "time": 5126.229, "timestamp": "01:25:26", "text": "呃"}, {"type": "subtitle", "time": 5137.11, "timestamp": "01:25:37", "text": "不，别这样对我。"}, {"type": "subtitle", "time": 5138.709, "timestamp": "01:25:38", "text": "好的。好的。好的。连接。连接。"}]
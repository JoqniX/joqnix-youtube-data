[{"type": "subtitle", "time": 15001.349, "timestamp": "04:10:01", "text": "目前"}, {"type": "subtitle", "time": 15005.11, "timestamp": "04:10:05", "text": "我是本地运行的。"}, {"type": "subtitle", "time": 15007.03, "timestamp": "04:10:07", "text": "让我给你展示一下我的OBS软件。我目前"}, {"type": "subtitle", "time": 15009.83, "timestamp": "04:10:09", "text": "我用同一个 OBS 进行录制和直播"}, {"type": "subtitle", "time": 15013.91, "timestamp": "04:10:13", "text": "到。但是，嗯……"}, {"type": "subtitle", "time": 15018.55, "timestamp": "04:10:18", "text": "我使用了一个叫做 branch output 的插件。"}, {"type": "subtitle", "time": 15021.349, "timestamp": "04:10:21", "text": "分支输出插件允许我"}, {"type": "subtitle", "time": 15026.79, "timestamp": "04:10:26", "text": "请把这段视频发给我。这是"}, {"type": "subtitle", "time": 15031.269, "timestamp": "04:10:31", "text": "显示我网站的浏览器源。"}, {"type": "subtitle", "time": 15034.63, "timestamp": "04:10:34", "text": "这就是我的V通道的工作原理。所以"}, {"type": "subtitle", "time": 15037.75, "timestamp": "04:10:37", "text": "此浏览器源的音频获取"}, {"type": "subtitle", "time": 15039.59, "timestamp": "04:10:39", "text": "广播"}, {"type": "subtitle", "time": 15042.389, "timestamp": "04:10:42", "text": "就好像你直播的方式和你直播的方式很相似一样"}, {"type": "subtitle", "time": 15046.309, "timestamp": "04:10:46", "text": "在 OBS 上，还可以同步到 YouTube、Twitch 等平台。"}, {"type": "subtitle", "time": 15052.07, "timestamp": "04:10:52", "text": "这里我正在向 Mel multi 发送信号"}, {"type": "subtitle", "time": 15056.07, "timestamp": "04:10:56", "text": "熔化后，我可以进行多线程操作。"}, {"type": "subtitle", "time": 15059.51, "timestamp": "04:10:59", "text": "Twitch 踢人和其他平台。我在这里"}]
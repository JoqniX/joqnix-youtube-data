[{"type": "subtitle", "time": 12003.51, "timestamp": "03:20:03", "text": "YouTube上也有类似的系统。那是"}, {"type": "subtitle", "time": 12008.898, "timestamp": "03:20:08", "text": "但他们没有频道点"}, {"type": "subtitle", "time": 12010.71, "timestamp": "03:20:10", "text": "[音乐] 悲伤地。"}, {"type": "subtitle", "time": 12012.79, "timestamp": "03:20:12", "text": "他们真的应该好好谈谈频道要点。"}, {"type": "subtitle", "time": 12015.429, "timestamp": "03:20:15", "text": "YouTube，老兄。"}, {"type": "subtitle", "time": 12041.51, "timestamp": "03:20:41", "text": "我肯定做不好这个教程"}, {"type": "subtitle", "time": 12051.59, "timestamp": "03:20:51", "text": "我感觉好累，不想……"}, {"type": "subtitle", "time": 12054.07, "timestamp": "03:20:54", "text": "记下来。我不知道。我应该吗？"}, {"type": "subtitle", "time": 12059.67, "timestamp": "03:20:59", "text": "刚才发生了什么？呃，所以当你"}]
[{"type": "subtitle", "time": 2160.87, "timestamp": "00:36:00", "text": "我读11年级。没有董事会。不，你是"}, {"type": "subtitle", "time": 2163.91, "timestamp": "00:36:03", "text": "准备寄宿。"}, {"type": "subtitle", "time": 2165.19, "timestamp": "00:36:05", "text": "不。哦，是的。是的。你没有"}, {"type": "subtitle", "time": 2167.19, "timestamp": "00:36:07", "text": "木板。是的。是的。第十二。是的。第十二。"}, {"type": "subtitle", "time": 2168.95, "timestamp": "00:36:08", "text": "你会有饭吃的。是的。我忘了。"}, {"type": "subtitle", "time": 2172.95, "timestamp": "00:36:12", "text": "对不起。祝你好运。祝你好运。不要懈怠"}, {"type": "subtitle", "time": 2180.31, "timestamp": "00:36:20", "text": "我的一些同事"}, {"type": "subtitle", "time": 2183.51, "timestamp": "00:36:23", "text": "他们的董事会"}, {"type": "subtitle", "time": 2185.91, "timestamp": "00:36:25", "text": "考试季已经到了，因为已经开始了。"}, {"type": "subtitle", "time": 2188.71, "timestamp": "00:36:28", "text": "二月没有"}, {"type": "subtitle", "time": 2191.99, "timestamp": "00:36:31", "text": "二月 三月"}, {"type": "subtitle", "time": 2193.99, "timestamp": "00:36:33", "text": "即使我已经学过了"}, {"type": "subtitle", "time": 2196.31, "timestamp": "00:36:36", "text": "十二年级的全部课程内容早已过时了。"}, {"type": "subtitle", "time": 2201.91, "timestamp": "00:36:41", "text": "哇。哪个系统哪个课程大纲是ICE或I"}, {"type": "subtitle", "time": 2217.67, "timestamp": "00:36:57", "text": "我记得，呃，当我还在学习的时候"}, {"type": "subtitle", "time": 2219.99, "timestamp": "00:36:59", "text": "我知道了"}]
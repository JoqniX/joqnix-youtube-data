[{"type": "subtitle", "time": 16082.79, "timestamp": "04:28:02", "text": "观看我当时在场的那段视频"}, {"type": "subtitle", "time": 16084.95, "timestamp": "04:28:04", "text": "现场录音技术"}, {"type": "subtitle", "time": 16087.429, "timestamp": "04:28:07", "text": "细节方面？"}, {"type": "subtitle", "time": 16090.07, "timestamp": "04:28:10", "text": "呃，如果你做了什么，你会怎么评价？"}, {"type": "subtitle", "time": 16092.71, "timestamp": "04:28:12", "text": "它？"}, {"type": "subtitle", "time": 16095.189, "timestamp": "04:28:15", "text": "你会如何评价我的"}, {"type": "subtitle", "time": 16099.67, "timestamp": "04:28:19", "text": "我想提一下另一款游戏。你可以"}, {"type": "subtitle", "time": 16101.91, "timestamp": "04:28:21", "text": "请务必私信我。"}, {"type": "subtitle", "time": 16103.83, "timestamp": "04:28:23", "text": "哦，是的。当然。当然。好的。逃生"}, {"type": "subtitle", "time": 16118.55, "timestamp": "04:28:38", "text": "老兄，别告诉我这是个恐怖游戏。"}, {"type": "subtitle", "time": 16122.63, "timestamp": "04:28:42", "text": "我的天，这是个恐怖游戏。"}, {"type": "subtitle", "time": 16125.83, "timestamp": "04:28:45", "text": "好吧，我得买这个。你能重做吗？"}, {"type": "subtitle", "time": 16135.11, "timestamp": "04:28:55", "text": "好的，我录下来了……"}]
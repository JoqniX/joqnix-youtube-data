[{"type": "subtitle", "time": 902.949, "timestamp": "00:15:02", "text": "我会尽快收到确认邮件。"}, {"type": "subtitle", "time": 904.79, "timestamp": "00:15:04", "text": "呃"}, {"type": "subtitle", "time": 906.389, "timestamp": "00:15:06", "text": "是的，我希望一切顺利。我是"}, {"type": "subtitle", "time": 915.75, "timestamp": "00:15:15", "text": "所以，直播结束了。我会尽量"}, {"type": "subtitle", "time": 919.03, "timestamp": "00:15:19", "text": "多直播，多做视频"}, {"type": "subtitle", "time": 921.99, "timestamp": "00:15:21", "text": "内容不在 YouTube 上。我会尽力去做"}, {"type": "subtitle", "time": 924.15, "timestamp": "00:15:24", "text": "YouTube 上有更多类似的视频内容"}, {"type": "subtitle", "time": 927.35, "timestamp": "00:15:27", "text": "拍vlog之类的。我还没试过"}, {"type": "subtitle", "time": 932.79, "timestamp": "00:15:32", "text": "视频博客。嗯，那我看看情况如何吧。"}, {"type": "subtitle", "time": 935.269, "timestamp": "00:15:35", "text": "呃"}, {"type": "subtitle", "time": 945.189, "timestamp": "00:15:45", "text": "一旦我……嗯……一旦我……嗯……我该怎么说呢？"}, {"type": "subtitle", "time": 949.91, "timestamp": "00:15:49", "text": "只有当我……时，流媒体播放才有可能。"}, {"type": "subtitle", "time": 953.43, "timestamp": "00:15:53", "text": "呃，把所有事情都安排好，比如"}, {"type": "subtitle", "time": 956.79, "timestamp": "00:15:56", "text": "笔记本电脑需要联网才能购买"}, {"type": "subtitle", "time": 959.91, "timestamp": "00:15:59", "text": "新笔记本电脑网络连接"}]
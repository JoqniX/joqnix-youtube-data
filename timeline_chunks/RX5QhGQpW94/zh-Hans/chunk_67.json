[{"type": "subtitle", "time": 4020.23, "timestamp": "01:07:00", "text": "然后我得写踢分号呃"}, {"type": "subtitle", "time": 4024.069, "timestamp": "01:07:04", "text": "这个点点东西踢ID。然后"}, {"type": "subtitle", "time": 4026.549, "timestamp": "01:07:06", "text": "YouTube，就像这样，输入你的 YouTube 用户 ID。"}, {"type": "subtitle", "time": 4029.91, "timestamp": "01:07:09", "text": "这就是合并的方法。"}, {"type": "subtitle", "time": 4032.15, "timestamp": "01:07:12", "text": "是的。一旦你合并了它，你就会"}, {"type": "subtitle", "time": 4034.789, "timestamp": "01:07:14", "text": "在以下位置拥有你自己的公共 UID："}, {"type": "subtitle", "time": 4037.43, "timestamp": "01:07:17", "text": "你内心的想法。是的。有点"}, {"type": "subtitle", "time": 4040.789, "timestamp": "01:07:20", "text": "复杂的。它非常简陋。不好"}, {"type": "subtitle", "time": 4045.43, "timestamp": "01:07:25", "text": "够了，但勉强能用。"}, {"type": "subtitle", "time": 4047.75, "timestamp": "01:07:27", "text": "是的。"}, {"type": "subtitle", "time": 4051.91, "timestamp": "01:07:31", "text": "呃，我想让它变得更好。"}, {"type": "subtitle", "time": 4055.349, "timestamp": "01:07:35", "text": "就像拥有一个和用户一样的东西"}, {"type": "subtitle", "time": 4058.789, "timestamp": "01:07:38", "text": "公司有权，我想过要一个"}, {"type": "subtitle", "time": 4061.109, "timestamp": "01:07:41", "text": "系统里我可以像我一样拥有"}, {"type": "subtitle", "time": 4063.99, "timestamp": "01:07:43", "text": "类似管理员登录"}, {"type": "subtitle", "time": 4067.109, "timestamp": "01:07:47", "text": "呃，我自己用，所以不需要链接我的"}, {"type": "subtitle", "time": 4070.95, "timestamp": "01:07:50", "text": "YouTube API 和 Twitch API 之类的东西，我的"}, {"type": "subtitle", "time": 4073.91, "timestamp": "01:07:53", "text": "Sammy 的东西能用，我可以直接用我的"}, {"type": "subtitle", "time": 4077.43, "timestamp": "01:07:57", "text": "网站并让它获取令牌，然后用于"}]
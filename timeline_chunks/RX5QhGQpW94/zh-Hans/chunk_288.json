[{"type": "subtitle", "time": 17280.31, "timestamp": "04:48:00", "text": "你们来突袭我。不过，谢谢。"}, {"type": "subtitle", "time": 17284.15, "timestamp": "04:48:04", "text": "好了，我要结束今天的分享了。"}, {"type": "subtitle", "time": 17285.91, "timestamp": "04:48:05", "text": "今天。"}, {"type": "subtitle", "time": 17289.43, "timestamp": "04:48:09", "text": "好的，我会接受你的提议。"}, {"type": "subtitle", "time": 17293.75, "timestamp": "04:48:13", "text": "有一次我玩到了最后的《Outlast》试玩版。"}, {"type": "subtitle", "time": 17297.19, "timestamp": "04:48:17", "text": "我会私信你，这样我们就可以合作了。"}, {"type": "subtitle", "time": 17299.91, "timestamp": "04:48:19", "text": "这会很有趣。"}, {"type": "subtitle", "time": 17302.628, "timestamp": "04:48:22", "text": "我已经很久没有参与合作项目了。"}, {"type": "subtitle", "time": 17308.708, "timestamp": "04:48:28", "text": "我怀念合作的感觉。所以，"}, {"type": "subtitle", "time": 17311.27, "timestamp": "04:48:31", "text": "是啊，今年我过得很艰难。"}, {"type": "subtitle", "time": 17316.07, "timestamp": "04:48:36", "text": "不算糟糕，但确实太忙了。"}, {"type": "subtitle", "time": 17319.83, "timestamp": "04:48:39", "text": "所以我很怀念做拼贴画的日子。但是，是的，这个"}, {"type": "subtitle", "time": 17323.43, "timestamp": "04:48:43", "text": "这是我唯一的月份，对，对。"}, {"type": "subtitle", "time": 17326.39, "timestamp": "04:48:46", "text": "我可以慢慢来，专注于……"}, {"type": "subtitle", "time": 17328.47, "timestamp": "04:48:48", "text": "直播和其他一些东西，对吧？我觉得我"}]
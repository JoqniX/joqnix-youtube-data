[{"type": "subtitle", "time": 6963.03, "timestamp": "01:56:03", "text": "我可以进行直播"}, {"type": "subtitle", "time": 6966.47, "timestamp": "01:56:06", "text": "操读"}, {"type": "subtitle", "time": 6970.39, "timestamp": "01:56:10", "text": "我决定做25x7的原因"}, {"type": "subtitle", "time": 6973.51, "timestamp": "01:56:13", "text": "频道是为那些不了解的人准备的"}, {"type": "subtitle", "time": 6976.55, "timestamp": "01:56:16", "text": "我知道我即将前往日本。"}, {"type": "subtitle", "time": 6978.95, "timestamp": "01:56:18", "text": "4月2日至26日"}, {"type": "subtitle", "time": 6982.39, "timestamp": "01:56:22", "text": "这样一来，大门就敞开了。"}, {"type": "subtitle", "time": 6986.149, "timestamp": "01:56:26", "text": "不可预测性，而我本人却不在场。"}, {"type": "subtitle", "time": 6989.99, "timestamp": "01:56:29", "text": "我不确定何时才能返回。"}, {"type": "subtitle", "time": 6991.83, "timestamp": "01:56:31", "text": "流媒体"}, {"type": "subtitle", "time": 6995.75, "timestamp": "01:56:35", "text": "从某种程度上说，我的内容"}, {"type": "subtitle", "time": 6998.47, "timestamp": "01:56:38", "text": "基本上就是直播，而我确实在直播。"}, {"type": "subtitle", "time": 7001.91, "timestamp": "01:56:41", "text": "这里那里有一些视频，但对于那些"}, {"type": "subtitle", "time": 7006.149, "timestamp": "01:56:46", "text": "喜欢看我的现场表演以及我想要的东西"}, {"type": "subtitle", "time": 7010.07, "timestamp": "01:56:50", "text": "为了保留一些记忆"}, {"type": "subtitle", "time": 7012.79, "timestamp": "01:56:52", "text": "以某种方式或途径，以便人们可以"}, {"type": "subtitle", "time": 7017.43, "timestamp": "01:56:57", "text": "记住账号。所以这就是我决定这么做的原因。"}]
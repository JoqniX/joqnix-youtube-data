[{"type": "subtitle", "time": 1020.31, "timestamp": "00:17:00", "text": "大师级的东西将会是……"}, {"type": "subtitle", "time": 1021.99, "timestamp": "00:17:01", "text": "20"}, {"type": "subtitle", "time": 1028.949, "timestamp": "00:17:08", "text": "是的。学生交换。是的。是的。"}, {"type": "subtitle", "time": 1030.71, "timestamp": "00:17:10", "text": "语言交流。外汇"}, {"type": "subtitle", "time": 1033.35, "timestamp": "00:17:13", "text": "我猜是学生吧。去另一个地方"}, {"type": "subtitle", "time": 1037.909, "timestamp": "00:17:17", "text": "去这个国家学习语言，这样我们就可以"}, {"type": "subtitle", "time": 1040.789, "timestamp": "00:17:20", "text": "进行两年的语言学习将是"}, {"type": "subtitle", "time": 1043.59, "timestamp": "00:17:23", "text": "两年。"}, {"type": "subtitle", "time": 1050.47, "timestamp": "00:17:30", "text": "是的，我想那将是我之前的力量。"}, {"type": "subtitle", "time": 1057.51, "timestamp": "00:17:37", "text": "这难以预测。我不知道该怎么做"}, {"type": "subtitle", "time": 1069.43, "timestamp": "00:17:49", "text": "你像学者一样吗？不，不，不，不。"}, {"type": "subtitle", "time": 1071.19, "timestamp": "00:17:51", "text": "不是奖学金之类的。"}, {"type": "subtitle", "time": 1077.669, "timestamp": "00:17:57", "text": "我希望[笑声]"}]
[{"type": "subtitle", "time": 602.47, "timestamp": "00:10:02", "text": "没关系。我在这里。你可以跟我说话"}, {"type": "subtitle", "time": 607.59, "timestamp": "00:10:07", "text": "[清嗓子]"}, {"type": "subtitle", "time": 616.47, "timestamp": "00:10:16", "text": "一秒钟。呃，你知道，呃，给我一个"}, {"type": "subtitle", "time": 619.03, "timestamp": "00:10:19", "text": "少量。我，呃，我这就充电。"}, {"type": "subtitle", "time": 622.31, "timestamp": "00:10:22", "text": "然后，呃，聊一会儿，呃，"}, {"type": "subtitle", "time": 626.15, "timestamp": "00:10:26", "text": "同时处理一些事情，这会导致崩溃。"}, {"type": "subtitle", "time": 636.55, "timestamp": "00:10:36", "text": "我以为一切都很顺利。"}, {"type": "subtitle", "time": 639.19, "timestamp": "00:10:39", "text": "是的，总是这个时候……"}, {"type": "subtitle", "time": 641.99, "timestamp": "00:10:41", "text": "回来继续做你平常做的事吧。"}, {"type": "subtitle", "time": 645.509, "timestamp": "00:10:45", "text": "一切都突然崩溃了[笑声]"}, {"type": "subtitle", "time": 647.91, "timestamp": "00:10:47", "text": "太疯狂了，不是吗？"}, {"type": "subtitle", "time": 651.03, "timestamp": "00:10:51", "text": "我甚至都没准备好我的 OBS。"}, {"type": "subtitle", "time": 654.31, "timestamp": "00:10:54", "text": "记录。显然，出现了一个新的呃"}, {"type": "subtitle", "time": 659.35, "timestamp": "00:10:59", "text": "你可以采用多轨视频方法。嗯"}]
[{"type": "subtitle", "time": 10501.03, "timestamp": "02:55:01", "text": "主播为什么不说话了"}, {"type": "subtitle", "time": 10504.309, "timestamp": "02:55:04", "text": "嗯，这个和那个，这个和那个。这是什么？"}, {"type": "subtitle", "time": 10506.79, "timestamp": "02:55:06", "text": "广播？这是假直播吗？"}, {"type": "subtitle", "time": 10508.95, "timestamp": "02:55:08", "text": "这个那个。"}, {"type": "subtitle", "time": 10511.75, "timestamp": "02:55:11", "text": "标题里明明写着呢，上面写着："}, {"type": "subtitle", "time": 10513.91, "timestamp": "02:55:13", "text": "在评论区。"}, {"type": "subtitle", "time": 10516.63, "timestamp": "02:55:16", "text": "我不知道我还需要做些什么。"}, {"type": "subtitle", "time": 10520.63, "timestamp": "02:55:20", "text": "你。我尽力了，但有些人……"}, {"type": "subtitle", "time": 10522.55, "timestamp": "02:55:22", "text": "不明白。而且还有类似的东西"}, {"type": "subtitle", "time": 10526.87, "timestamp": "02:55:26", "text": "其他批评意见，例如为什么较小的"}, {"type": "subtitle", "time": 10528.389, "timestamp": "02:55:28", "text": "创作者"}, {"type": "subtitle", "time": 10533.03, "timestamp": "02:55:33", "text": "那些几乎没有观众的人需要做什么"}, {"type": "subtitle", "time": 10539.03, "timestamp": "02:55:39", "text": "一个全天候频道，保护你的CPU，呃，你的电脑"}, {"type": "subtitle", "time": 10542.469, "timestamp": "02:55:42", "text": "权力构建了这个那个，因为"}, {"type": "subtitle", "time": 10544.389, "timestamp": "02:55:44", "text": "当前系统是本地的，现在不是了。"}, {"type": "subtitle", "time": 10549.11, "timestamp": "02:55:49", "text": "基于云的那些东西，对吧？但是"}, {"type": "subtitle", "time": 10552.07, "timestamp": "02:55:52", "text": "我，我想我忘了提一下……"}, {"type": "subtitle", "time": 10556.23, "timestamp": "02:55:56", "text": "视频，但是，呃，这是个实验性的视频。"}, {"type": "subtitle", "time": 10558.729, "timestamp": "02:55:58", "text": "这是我想要尝试的一种实验性做法。"}]
[{"type": "subtitle", "time": 2042.95, "timestamp": "00:34:02", "text": "守护者就像人们一样，他们会的。"}, {"type": "subtitle", "time": 2045.669, "timestamp": "00:34:05", "text": "打电话开会，呃，你必须……"}, {"type": "subtitle", "time": 2048.95, "timestamp": "00:34:08", "text": "写一篇作文或道歉信"}, {"type": "subtitle", "time": 2052.389, "timestamp": "00:34:12", "text": "你必须写一封道歉信"}, {"type": "subtitle", "time": 2056.71, "timestamp": "00:34:16", "text": "在你找到兼职工作之前，我会代表你。"}, {"type": "subtitle", "time": 2058.71, "timestamp": "00:34:18", "text": "直到你找到一份兼职工作为止"}, {"type": "subtitle", "time": 2062.31, "timestamp": "00:34:22", "text": "你很稳定，当地的研究所"}, {"type": "subtitle", "time": 2066.95, "timestamp": "00:34:26", "text": "嗯，就像……得照顾你一样"}, {"type": "subtitle", "time": 2069.03, "timestamp": "00:34:29", "text": "而且就像必须照顾一样"}, {"type": "subtitle", "time": 2071.75, "timestamp": "00:34:31", "text": "一切都是……嗯。字面意义上的"}, {"type": "subtitle", "time": 2073.51, "timestamp": "00:34:33", "text": "他们会照顾好学生的。"}, {"type": "subtitle", "time": 2077.03, "timestamp": "00:34:37", "text": "不管是那种事。然后"}, {"type": "subtitle", "time": 2079.829, "timestamp": "00:34:39", "text": "从语言专业毕业后"}, {"type": "subtitle", "time": 2082.79, "timestamp": "00:34:42", "text": "如果要去学校，那就看你自己了。不，你呃"}, {"type": "subtitle", "time": 2086.149, "timestamp": "00:34:46", "text": "你像……一样走出了自己的道路"}, {"type": "subtitle", "time": 2088.869, "timestamp": "00:34:48", "text": "上大学或者找份工作什么的。"}, {"type": "subtitle", "time": 2095.03, "timestamp": "00:34:55", "text": "就在你身上，对吧，嗯，就是这样。"}]
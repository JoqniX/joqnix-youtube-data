[{"type": "subtitle", "time": 12240.79, "timestamp": "03:24:00", "text": "超级留言。你发送了一条超级留言或"}, {"type": "subtitle", "time": 12243.429, "timestamp": "03:24:03", "text": "会员资格或其他什么[音乐]"}, {"type": "subtitle", "time": 12245.03, "timestamp": "03:24:05", "text": "呃"}, {"type": "subtitle", "time": 12250.07, "timestamp": "03:24:10", "text": "嗯，一旦你达到目标"}, {"type": "subtitle", "time": 12253.75, "timestamp": "03:24:13", "text": "目标将在同一系统中完成。"}, {"type": "subtitle", "time": 12256.95, "timestamp": "03:24:16", "text": "我怎么才能去等等？我这就打开它。"}, {"type": "subtitle", "time": 12261.03, "timestamp": "03:24:21", "text": "我想，嗯……"}, {"type": "subtitle", "time": 12275.19, "timestamp": "03:24:35", "text": "微笑检查。我当时真是蠢到家了，居然喜欢……"}, {"type": "subtitle", "time": 12280.95, "timestamp": "03:24:40", "text": "呃"}, {"type": "subtitle", "time": 12293.59, "timestamp": "03:24:53", "text": "好的，让我看看。开启微笑检查功能。"}, {"type": "subtitle", "time": 12298.15, "timestamp": "03:24:58", "text": "我把它增加到31道菜。 30天。"}]
[{"type": "subtitle", "time": 14702.71, "timestamp": "04:05:02", "text": "自动变为活动状态"}, {"type": "subtitle", "time": 14706.229, "timestamp": "04:05:06", "text": "该物业将采用已应用的技术。所以"}, {"type": "subtitle", "time": 14709.67, "timestamp": "04:05:09", "text": "假设我目前正在玩《战地4》。"}, {"type": "subtitle", "time": 14713.59, "timestamp": "04:05:13", "text": "《命运2》和钢琴学习是用来做什么的？"}, {"type": "subtitle", "time": 14717.349, "timestamp": "04:05:17", "text": "右翼主动。所以那三个职业选手"}, {"type": "subtitle", "time": 14719.75, "timestamp": "04:05:19", "text": "他们的播放列表是他们的财产。"}, {"type": "subtitle", "time": 14723.91, "timestamp": "04:05:23", "text": "已使用部分将被勾选。然后当我运行"}, {"type": "subtitle", "time": 14727.349, "timestamp": "04:05:27", "text": "按钮再次位于另一组三个按钮下方"}, {"type": "subtitle", "time": 14731.51, "timestamp": "04:05:31", "text": "随机播放列表内容将激活"}, {"type": "subtitle", "time": 14733.75, "timestamp": "04:05:33", "text": "就在那时"}, {"type": "subtitle", "time": 14736.79, "timestamp": "04:05:36", "text": "这意味着"}, {"type": "subtitle", "time": 14739.349, "timestamp": "04:05:39", "text": "过去一直被用作房产"}, {"type": "subtitle", "time": 14741.83, "timestamp": "04:05:41", "text": "三个不会更改的播放列表。所以"}, {"type": "subtitle", "time": 14747.03, "timestamp": "04:05:47", "text": "这意味着每次都是如此"}, {"type": "subtitle", "time": 14749.91, "timestamp": "04:05:49", "text": "每次都会有不同的播放列表"}, {"type": "subtitle", "time": 14753.189, "timestamp": "04:05:53", "text": "将会展出"}, {"type": "subtitle", "time": 14756.95, "timestamp": "04:05:56", "text": "并且这已被用作财产"}]
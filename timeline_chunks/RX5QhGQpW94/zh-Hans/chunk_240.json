[{"type": "subtitle", "time": 14400.79, "timestamp": "04:00:00", "text": "这种情况会发生"}, {"type": "subtitle", "time": 14403.83, "timestamp": "04:00:03", "text": "每当我有"}, {"type": "subtitle", "time": 14406.95, "timestamp": "04:00:06", "text": "如果每当我随机"}, {"type": "subtitle", "time": 14409.59, "timestamp": "04:00:09", "text": "呃，这是个正经的……呃，这是个东西……"}, {"type": "subtitle", "time": 14412.71, "timestamp": "04:00:12", "text": "我的播放列表循环中已经结束了"}, {"type": "subtitle", "time": 14415.75, "timestamp": "04:00:15", "text": "所以这是一个固定模式，这意味着如果我"}, {"type": "subtitle", "time": 14418.79, "timestamp": "04:00:18", "text": "我不想用精选歌单。"}, {"type": "subtitle", "time": 14421.59, "timestamp": "04:00:21", "text": "可以直接点击随机，然后点击“选择”。"}, {"type": "subtitle", "time": 14425.429, "timestamp": "04:00:25", "text": "如果将其设置为活动状态，则只会使用"}, {"type": "subtitle", "time": 14426.63, "timestamp": "04:00:26", "text": "随机"}, {"type": "subtitle", "time": 14429.269, "timestamp": "04:00:29", "text": "什么？什么"}, {"type": "subtitle", "time": 14431.75, "timestamp": "04:00:31", "text": "如果我想要一个顺序的呢？它会呃"}, {"type": "subtitle", "time": 14434.71, "timestamp": "04:00:34", "text": "使用顺序执行。现在有个问题……"}, {"type": "subtitle", "time": 14439.11, "timestamp": "04:00:39", "text": "你会想知道，你说的那个运动员还好吗？"}, {"type": "subtitle", "time": 14442.389, "timestamp": "04:00:42", "text": "你可以创建任何播放列表"}, {"type": "subtitle", "time": 14445.189, "timestamp": "04:00:45", "text": "你想查看它"}, {"type": "subtitle", "time": 14448.07, "timestamp": "04:00:48", "text": "董事会频道，呃，24小时频道"}, {"type": "subtitle", "time": 14451.269, "timestamp": "04:00:51", "text": "东西对吧"}, {"type": "subtitle", "time": 14454.309, "timestamp": "04:00:54", "text": "如果选定的播放列表是"}, {"type": "subtitle", "time": 14457.83, "timestamp": "04:00:57", "text": "如果活跃用户没有视频可用了，那该怎么办？"}]
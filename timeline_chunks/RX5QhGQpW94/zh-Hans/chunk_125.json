[{"type": "subtitle", "time": 7501.91, "timestamp": "02:05:01", "text": "我创建这个24小时频道是因为我"}, {"type": "subtitle", "time": 7504.55, "timestamp": "02:05:04", "text": "想要所有人"}, {"type": "subtitle", "time": 7507.189, "timestamp": "02:05:07", "text": "拥有"}, {"type": "subtitle", "time": 7511.109, "timestamp": "02:05:11", "text": "当我不在那里的时候，我的一些影子，当"}, {"type": "subtitle", "time": 7515.91, "timestamp": "02:05:15", "text": "我无法进行直播或开播。"}, {"type": "subtitle", "time": 7520.149, "timestamp": "02:05:20", "text": "由于生活或其他任何原因。我想要"}, {"type": "subtitle", "time": 7523.83, "timestamp": "02:05:23", "text": "我的社区能够观看和"}, {"type": "subtitle", "time": 7528.39, "timestamp": "02:05:28", "text": "尽情享用我们现有的老式冷凝器吧。"}, {"type": "subtitle", "time": 7530.709, "timestamp": "02:05:30", "text": "在那里经历了很多，留下了美好的回忆。"}, {"type": "subtitle", "time": 7534.629, "timestamp": "02:05:34", "text": "过去的。我希望你们喜欢它"}, {"type": "subtitle", "time": 7537.51, "timestamp": "02:05:37", "text": "再次。"}, {"type": "subtitle", "time": 7544.229, "timestamp": "02:05:44", "text": "重温我们共同的回忆"}, {"type": "subtitle", "time": 7548.87, "timestamp": "02:05:48", "text": "前。是的。所以这就是为什么是24小时"}]
[{"type": "subtitle", "time": 10263.302, "timestamp": "02:51:03", "text": "呃，或者地下，在地下"}, {"type": "subtitle", "time": 10264.389, "timestamp": "02:51:04", "text": "[音乐]"}, {"type": "subtitle", "time": 10267.11, "timestamp": "02:51:07", "text": "音乐艺术家之类的DJ表演和"}, {"type": "subtitle", "time": 10269.853, "timestamp": "02:51:09", "text": "我觉得我能做所有这些事。"}, {"type": "subtitle", "time": 10270.469, "timestamp": "02:51:10", "text": "[音乐]"}, {"type": "subtitle", "time": 10272.55, "timestamp": "02:51:12", "text": "然后你就会问谁会……"}, {"type": "subtitle", "time": 10276.23, "timestamp": "02:51:16", "text": "观看一位在日本的印度陌生人……呃……"}, {"type": "subtitle", "time": 10279.67, "timestamp": "02:51:19", "text": "音乐、DJ之类的，那挺好的。"}, {"type": "subtitle", "time": 10282.63, "timestamp": "02:51:22", "text": "问题是，我不知道，我是"}, {"type": "subtitle", "time": 10284.23, "timestamp": "02:51:24", "text": "如果那样不行，我就只能随机应变了。"}, {"type": "subtitle", "time": 10287.83, "timestamp": "02:51:27", "text": "我还有其他备用方案。"}, {"type": "subtitle", "time": 10290.55, "timestamp": "02:51:30", "text": "是的，"}, {"type": "subtitle", "time": 10294.389, "timestamp": "02:51:34", "text": "某种程度上来说。是啊，但问题是……我"}, {"type": "subtitle", "time": 10296.95, "timestamp": "02:51:36", "text": "不想过度依赖或倚重"}, {"type": "subtitle", "time": 10300.63, "timestamp": "02:51:40", "text": "我家的钱。我找到一份兼职工作后"}, {"type": "subtitle", "time": 10303.19, "timestamp": "02:51:43", "text": "一旦我到了那里，一切都会好起来的。"}, {"type": "subtitle", "time": 10306.389, "timestamp": "02:51:46", "text": "第一年之后"}, {"type": "subtitle", "time": 10308.309, "timestamp": "02:51:48", "text": "一切都将取决于"}, {"type": "subtitle", "time": 10310.63, "timestamp": "02:51:50", "text": "我自己"}, {"type": "subtitle", "time": 10312.428, "timestamp": "02:51:52", "text": "我不负责的所有财务事宜"}, {"type": "subtitle", "time": 10314.07, "timestamp": "02:51:54", "text": "[清嗓子] 想依靠第三方"}, {"type": "subtitle", "time": 10316.79, "timestamp": "02:51:56", "text": "根本没有聚会。"}]
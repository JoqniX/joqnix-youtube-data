[{"type": "subtitle", "time": 17460.23, "timestamp": "04:51:00", "text": "让它自动评价我的战争"}, {"type": "subtitle", "time": 17463.43, "timestamp": "04:51:03", "text": "呃，一直都在这个频道，对吧？"}, {"type": "subtitle", "time": 17471.99, "timestamp": "04:51:11", "text": "工作量好大。"}, {"type": "subtitle", "time": 17477.99, "timestamp": "04:51:17", "text": "踢？"}, {"type": "subtitle", "time": 17499.11, "timestamp": "04:51:39", "text": "我做不到。诡异的。好的。反正，"}, {"type": "subtitle", "time": 17502.788, "timestamp": "04:51:42", "text": "我们这边就到此为止了。"}, {"type": "subtitle", "time": 17505.43, "timestamp": "04:51:45", "text": "请花点时间感谢每一位"}, {"type": "subtitle", "time": 17507.27, "timestamp": "04:51:47", "text": "潜伏着，"}, {"type": "subtitle", "time": 17510.15, "timestamp": "04:51:50", "text": "今天在这里聊天的人。谢谢"}, {"type": "subtitle", "time": 17512.708, "timestamp": "04:51:52", "text": "感谢今天所有到场的朋友。真的"}, {"type": "subtitle", "time": 17515.75, "timestamp": "04:51:55", "text": "意义重大。我度假回来了。"}]
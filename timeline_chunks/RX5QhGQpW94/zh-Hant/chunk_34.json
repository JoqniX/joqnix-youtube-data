[{"type": "subtitle", "time": 2045.669, "timestamp": "00:34:05", "text": "會議。然後你必須"}, {"type": "subtitle", "time": 2048.95, "timestamp": "00:34:08", "text": "寫一篇作文或道歉信，他們會代表"}, {"type": "subtitle", "time": 2052.389, "timestamp": "00:34:12", "text": "你寫道歉信，"}, {"type": "subtitle", "time": 2058.71, "timestamp": "00:34:18", "text": "直到你找到兼職工作，直到"}, {"type": "subtitle", "time": 2062.31, "timestamp": "00:34:22", "text": "你的生活穩定下來。當地的機構就像是，"}, {"type": "subtitle", "time": 2066.95, "timestamp": "00:34:26", "text": "必須照顧你，"}, {"type": "subtitle", "time": 2069.03, "timestamp": "00:34:29", "text": "必須處理好"}, {"type": "subtitle", "time": 2071.75, "timestamp": "00:34:31", "text": "一切。所以，"}, {"type": "subtitle", "time": 2073.51, "timestamp": "00:34:33", "text": "無論如何，他們都會照顧好學生"}, {"type": "subtitle", "time": 2077.03, "timestamp": "00:34:37", "text": "。"}, {"type": "subtitle", "time": 2079.829, "timestamp": "00:34:39", "text": "語言學校畢業後，就看自己的選擇了"}, {"type": "subtitle", "time": 2082.79, "timestamp": "00:34:42", "text": "。不，呃，"}, {"type": "subtitle", "time": 2086.149, "timestamp": "00:34:46", "text": "你得自己選擇道路，像是上"}, {"type": "subtitle", "time": 2088.869, "timestamp": "00:34:48", "text": "大學、找工作之類"}]
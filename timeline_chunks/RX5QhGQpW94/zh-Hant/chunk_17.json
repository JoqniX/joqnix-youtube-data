[{"type": "subtitle", "time": 1037.909, "timestamp": "00:17:17", "text": "學語言。一種語言。語言。  大師級的東西大概是 20 到 28。是的。學生交換。是的。是的。  語言交流。我猜是交換生。去另一個國家學習語言，這樣我們就可以"}, {"type": "subtitle", "time": 1040.789, "timestamp": "00:17:20", "text": "進行為期兩年的語言學習"}, {"type": "subtitle", "time": 1043.59, "timestamp": "00:17:23", "text": "。  是的"}, {"type": "subtitle", "time": 1057.51, "timestamp": "00:17:37", "text": "這難以預測。我不知道"}, {"type": "subtitle", "time": 1069.43, "timestamp": "00:17:49", "text": "不，不，不，不。"}, {"type": "subtitle", "time": 1071.19, "timestamp": "00:17:51", "text": "不是獎學金之類的。  沒有。沒有。沒有。  我"}]
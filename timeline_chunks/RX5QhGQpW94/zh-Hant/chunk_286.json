[{"type": "subtitle", "time": 17183.27, "timestamp": "04:46:23", "text": "歡迎回來。  說實話，我只剩一個月的時間了"}, {"type": "subtitle", "time": 17185.43, "timestamp": "04:46:25", "text": "。那是三月份，之後我就要去日本了。所以，我必須徹底完成監控系統和自動化系統，這樣，"}, {"type": "subtitle", "time": 17190.23, "timestamp": "04:46:30", "text": "一旦我不在家，我就可以讓家人打開"}, {"type": "subtitle", "time": 17193.51, "timestamp": "04:46:33", "text": "我的電腦，然後我就可以……我認為有可能在不連接到"}, {"type": "subtitle", "time": 17199.19, "timestamp": "04:46:39", "text": "本地伺服器或本地網路的情況下，公開實現陸地"}]
[{"type": "subtitle", "time": 3665.99, "timestamp": "01:01:05", "text": "所以既有順序的，也有隨機的。隨機產生的圖像會是"}, {"type": "subtitle", "time": 3668.23, "timestamp": "01:01:08", "text": "這樣的。鋼琴學習播放清單只有一個視頻，所以"}, {"type": "subtitle", "time": 3676.309, "timestamp": "01:01:16", "text": "只會顯示一個。  其次，戰場是第二件正確的事。"}, {"type": "subtitle", "time": 3681.91, "timestamp": "01:01:21", "text": "所以它會一直保持隨機性"}, {"type": "subtitle", "time": 3684.39, "timestamp": "01:01:24", "text": "。  它不會像劇集那樣分為第一部分、第二部分、第三部分。順序"}, {"type": "subtitle", "time": 3696.71, "timestamp": "01:01:36", "text": "隨機數就像編號隨機數一樣，會隨機化。  情況不會一樣了。不會有重播。"}, {"type": "subtitle", "time": 3705.03, "timestamp": "01:01:45", "text": "播放完前三個歌單後，剩下的內容將"}, {"type": "subtitle", "time": 3710.23, "timestamp": "01:01:50", "text": "是隨機播放的。  我上傳了大約90個影片。所以"}]
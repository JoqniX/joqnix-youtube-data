[{"type": "subtitle", "time": 4224.79, "timestamp": "01:10:24", "text": "是的，我"}, {"type": "subtitle", "time": 4227.91, "timestamp": "01:10:27", "text": "放棄了網站"}, {"type": "subtitle", "time": 4230.31, "timestamp": "01:10:30", "text": "建設。對不起。 [笑聲] H [嘆氣] 所以，是的，薩米的事。  他很久以前就失去我了。  嘿，喬亞。是的，就像我成功了一樣。  所以你看，我可以在這裡看到你所有的"}, {"type": "subtitle", "time": 4236.31, "timestamp": "01:10:36", "text": "聊天記錄。就像你的第一條訊息一樣。  我得修改一下。"}, {"type": "subtitle", "time": 4250.87, "timestamp": "01:10:50", "text": "我得弄清楚"}]
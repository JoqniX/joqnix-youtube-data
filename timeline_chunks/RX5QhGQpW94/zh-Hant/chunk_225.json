[{"type": "subtitle", "time": 13524.309, "timestamp": "03:45:24", "text": "正在"}, {"type": "subtitle", "time": 13527.11, "timestamp": "03:45:27", "text": "直播到哪個[音樂]類別，然後播放該類別中的音樂"}, {"type": "subtitle", "time": 13533.99, "timestamp": "03:45:33", "text": "串流。  所以，如果我在玩《Arc Raiders》時休息一下，它會在我休息的隨機時間播放"}, {"type": "subtitle", "time": 13538.229, "timestamp": "03:45:38", "text": "我們創作者播放清單"}, {"type": "subtitle", "time": 13541.99, "timestamp": "03:45:41", "text": "中的 VOD，並像這樣在"}, {"type": "subtitle", "time": 13545.59, "timestamp": "03:45:45", "text": "直播中顯示出來。所以，這就是第三版。  然後"}, {"type": "subtitle", "time": 13553.11, "timestamp": "03:45:53", "text": "我突然想到一個主意。我想像版本一和版本二一樣"}, {"type": "subtitle", "time": 13556.309, "timestamp": "03:45:56", "text": "重複使用它。  就像那種隨機抽獎活動一樣，對吧？"}]
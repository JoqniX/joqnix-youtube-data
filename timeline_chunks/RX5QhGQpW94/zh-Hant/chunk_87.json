[{"type": "subtitle", "time": 5229.189, "timestamp": "01:27:09", "text": "呃，我直播25分鐘。好的。你知道嗎？"}, {"type": "subtitle", "time": 5235.27, "timestamp": "01:27:15", "text": "呃，"}, {"type": "subtitle", "time": 5245.51, "timestamp": "01:27:25", "text": "我打算停用這個按鈕，"}, {"type": "subtitle", "time": 5249.669, "timestamp": "01:27:29", "text": "這樣我就不會遇到「嗯，它在哪裡？」這樣的問題了。"}, {"type": "subtitle", "time": 5256.55, "timestamp": "01:27:36", "text": "我打算把它關掉，免得被打擾。  我沒時間在直播中解決這個問題。  好的，那"}, {"type": "subtitle", "time": 5269.27, "timestamp": "01:27:49", "text": "我把按鈕禁用掉。  呃，我得盡快開始錄音。"}]
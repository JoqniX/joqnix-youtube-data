[{"type": "subtitle", "time": 7694.31, "timestamp": "02:08:14", "text": "這就像重溫我們曾經共同擁有的回憶。是的"}, {"type": "subtitle", "time": 7696.709, "timestamp": "02:08:16", "text": "。"}, {"type": "subtitle", "time": 7702.709, "timestamp": "02:08:22", "text": "所以這就是為什麼會有24小時頻道的原因。這就是我創建這個頻道的原因，"}, {"type": "subtitle", "time": 7705.99, "timestamp": "02:08:25", "text": "這個頻道將24小時不間斷直播，但這並不意味著我會在我的主頻道上即時直播。"}, {"type": "subtitle", "time": 7709.03, "timestamp": "02:08:29", "text": "請記住，有時可能會出現 24 小時頻道"}, {"type": "subtitle", "time": 7715.979, "timestamp": "02:08:35", "text": "直播和我同時直播的情況，但以後我會"}, {"type": "subtitle", "time": 7721.27, "timestamp": "02:08:41", "text": "調整設置，讓"}, {"type": "subtitle", "time": 7734.87, "timestamp": "02:08:54", "text": "我的主頻道直播時，24 小時頻道的直播會暫停，但 24 小時頻道的直播仍然會繼續進行。"}]
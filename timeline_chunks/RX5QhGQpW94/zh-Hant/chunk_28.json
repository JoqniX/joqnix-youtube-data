[{"type": "subtitle", "time": 1698.87, "timestamp": "00:28:18", "text": "我一切都很好。今天剛結束假期回到家。  嗯，我相信你是站在勝利這一邊的。別擔心。我也很擔心我的東西。你看，我並不孤單。不，即使我要去一個沒有"}, {"type": "subtitle", "time": 1703.51, "timestamp": "00:28:23", "text": "人保護我、救我的國家，就像"}, {"type": "subtitle", "time": 1707.35, "timestamp": "00:28:27", "text": "在我自己​​的地方一樣，"}, {"type": "subtitle", "time": 1709.83, "timestamp": "00:28:29", "text": "我的家人在那裡，朋友在那裡，"}, {"type": "subtitle", "time": 1711.59, "timestamp": "00:28:31", "text": "表兄弟姐妹在那裡，所有人都在"}, {"type": "subtitle", "time": 1715.669, "timestamp": "00:28:35", "text": "那裡，你知道的，嗯，但我不會孤單。"}, {"type": "subtitle", "time": 1719.43, "timestamp": "00:28:39", "text": "我交了好朋友，不是"}, {"type": "subtitle", "time": 1721.35, "timestamp": "00:28:41", "text": "日本人，是印度人，是"}, {"type": "subtitle", "time": 1726.23, "timestamp": "00:28:46", "text": "我可以信任的人。如果"}, {"type": "subtitle", "time": 1729.11, "timestamp": "00:28:49", "text": "發生什麼事，我迷路了或是困惑了，"}, {"type": "subtitle", "time": 1732.87, "timestamp": "00:28:52", "text": "我都可以聯絡他們。還有，我的"}, {"type": "subtitle", "time": 1737.669, "timestamp": "00:28:57", "text": "同學，"}, {"type": "subtitle", "time": 1739.99, "timestamp": "00:28:59", "text": "日本學校的同學，他們也在"}]
[{"type": "subtitle", "time": 377.189, "timestamp": "00:06:17", "text": "大家好。"}, {"type": "subtitle", "time": 379.909, "timestamp": "00:06:19", "text": "我能被聽見嗎？我希望我的聲音能被聽見。"}, {"type": "subtitle", "time": 382.55, "timestamp": "00:06:22", "text": "你好。你好。  你好"}, {"type": "subtitle", "time": 390.469, "timestamp": "00:06:30", "text": "大家最近怎麼樣？你好。"}, {"type": "subtitle", "time": 393.83, "timestamp": "00:06:33", "text": "哦，稍等一下。呃，今天是"}, {"type": "subtitle", "time": 395.749, "timestamp": "00:06:35", "text": "我假期結束後回歸直播的第一天（清喉嚨）"}, {"type": "subtitle", "time": 402.23, "timestamp": "00:06:42", "text": "。我的後端開始出現"}, {"type": "subtitle", "time": 407.189, "timestamp": "00:06:47", "text": "大量莫名其妙的錯誤。"}, {"type": "subtitle", "time": 409.369, "timestamp": "00:06:49", "text": "我當時就想，「兄弟，搞什麼鬼？"}, {"type": "subtitle", "time": 410.87, "timestamp": "00:06:50", "text": "[笑]"}, {"type": "subtitle", "time": 414.609, "timestamp": "00:06:54", "text": "我一直在做很多"}, {"type": "subtitle", "time": 416.87, "timestamp": "00:06:56", "text": "[清嗓子] 我一直在做很多"}]
[{"type": "subtitle", "time": 3241.99, "timestamp": "00:54:01", "text": "所以我只能這樣解釋"}, {"type": "subtitle", "time": 3256.95, "timestamp": "00:54:16", "text": "。不。好的。"}, {"type": "subtitle", "time": 3267.19, "timestamp": "00:54:27", "text": "我得解釋一下，是啊。所以這些播放清單會自動添加到這裡，我必須…是的。我只需要讓它運行就行了。就是這樣。  所以今天是什麼日子？今天是星期三。  所以，戰爭週期每週"}, {"type": "subtitle", "time": 3276.23, "timestamp": "00:54:36", "text": "六都會改變。所以這意味著，目前除了《命運2》和《"}, {"type": "subtitle", "time": 3283.109, "timestamp": "00:54:43", "text": "分裂之門》之外，還有"}]
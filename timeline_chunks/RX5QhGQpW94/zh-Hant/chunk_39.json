[{"type": "subtitle", "time": 2344.63, "timestamp": "00:39:04", "text": "我沒事"}, {"type": "subtitle", "time": 2359.75, "timestamp": "00:39:19", "text": "什麼？  N 在那裡。這是什麼？  兄弟，說"}, {"type": "subtitle", "time": 2375.03, "timestamp": "00:39:35", "text": "實話，"}, {"type": "subtitle", "time": 2381.829, "timestamp": "00:39:41", "text": "你知道，我當時想的是，我要錄完視頻，然後就結束今天的工作了。  你老了。你不應該"}, {"type": "subtitle", "time": 2385.43, "timestamp": "00:39:45", "text": "穿成這樣出門。為什麼說「老」？哦，我並不老。我還年輕。哦"}]
[{"type": "subtitle", "time": 1870.07, "timestamp": "00:31:10", "text": "國家叫什麼來著？上帝，祂叫什麼"}, {"type": "subtitle", "time": 1872.87, "timestamp": "00:31:12", "text": "名字？愛爾蘭。是的。一人去了"}, {"type": "subtitle", "time": 1874.549, "timestamp": "00:31:14", "text": "愛爾蘭。"}, {"type": "subtitle", "time": 1876.549, "timestamp": "00:31:16", "text": "理性永存。其餘一切皆會消逝。"}, {"type": "subtitle", "time": 1885.101, "timestamp": "00:31:25", "text": "對生活的熱愛。 [笑聲]"}, {"type": "subtitle", "time": 1893.99, "timestamp": "00:31:33", "text": "所以，呃，大家最近都在忙些什麼呢？"}, {"type": "subtitle", "time": 1896.549, "timestamp": "00:31:36", "text": "生活過得怎麼樣？"}, {"type": "subtitle", "time": 1899.11, "timestamp": "00:31:39", "text": "一切都好嗎？"}, {"type": "subtitle", "time": 1901.19, "timestamp": "00:31:41", "text": "告訴我。我跟不上時代了"}]
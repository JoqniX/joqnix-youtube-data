[{"type": "subtitle", "time": 662.202, "timestamp": "00:11:02", "text": "我想測試一下。"}, {"type": "subtitle", "time": 663.269, "timestamp": "00:11:03", "text": "[清嗓子] 嗯，"}, {"type": "subtitle", "time": 666.87, "timestamp": "00:11:06", "text": "你知道，嗯，當我不在"}, {"type": "subtitle", "time": 670.71, "timestamp": "00:11:10", "text": "電腦旁的時候，我就遠端"}, {"type": "subtitle", "time": 673.35, "timestamp": "00:11:13", "text": "控制電腦，這樣我就可以查看我的頻道，那個"}, {"type": "subtitle", "time": 676.55, "timestamp": "00:11:16", "text": "頻道總是"}, {"type": "subtitle", "time": 680.069, "timestamp": "00:11:20", "text": "播放一些內容，而且我還要完成我的日常工作"}, {"type": "subtitle", "time": 682.15, "timestamp": "00:11:22", "text": "，對吧？ [笑聲] 藍色協議每日例行公事。"}, {"type": "subtitle", "time": 686.71, "timestamp": "00:11:26", "text": "所以我一直在"}, {"type": "subtitle", "time": 689.03, "timestamp": "00:11:29", "text": "遠端控制我的電腦，做一些"}, {"type": "subtitle", "time": 692.87, "timestamp": "00:11:32", "text": "日常工作等等。"}, {"type": "subtitle", "time": 695.509, "timestamp": "00:11:35", "text": "謝天謝地，"}, {"type": "subtitle", "time": 698.31, "timestamp": "00:11:38", "text": "四天沒有停電。"}, {"type": "subtitle", "time": 699.829, "timestamp": "00:11:39", "text": "你去哪裡了？我一直在"}, {"type": "subtitle", "time": 703.509, "timestamp": "00:11:43", "text": "度假。假期很愉快。"}, {"type": "subtitle", "time": 712.47, "timestamp": "00:11:52", "text": "我把時間都花在了陪伴家人。真的很有趣。"}]
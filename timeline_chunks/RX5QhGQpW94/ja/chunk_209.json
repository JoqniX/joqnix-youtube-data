[{"type": "subtitle", "time": 12547.59, "timestamp": "03:29:07", "text": "何？"}, {"type": "subtitle", "time": 12565.83, "timestamp": "03:29:25", "text": "そしてこれ"}, {"type": "subtitle", "time": 12569.99, "timestamp": "03:29:29", "text": "私のウェブサイトへのリンクが必要です"}, {"type": "subtitle", "time": 12576.469, "timestamp": "03:29:36", "text": "どこ"}, {"type": "subtitle", "time": 12579.83, "timestamp": "03:29:39", "text": "チョコレートスペース。"}, {"type": "subtitle", "time": 12582.95, "timestamp": "03:29:42", "text": "これにリンクを貼る必要があります。私は"}, {"type": "subtitle", "time": 12585.51, "timestamp": "03:29:45", "text": "リンクがどこにあるか忘れてしまった"}, {"type": "subtitle", "time": 12594.309, "timestamp": "03:29:54", "text": "ウェブサイトも更新しなければなりません。"}]
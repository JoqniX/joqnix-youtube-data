[{"type": "subtitle", "time": 7327.27, "timestamp": "02:02:07", "text": "クリエイターになるのは嫌だ、兄弟。 [笑い]"}, {"type": "subtitle", "time": 7358.79, "timestamp": "02:02:38", "text": "くそ。彼は新しいアップデートをしました"}, {"type": "subtitle", "time": 7366.79, "timestamp": "02:02:46", "text": "わかった。それは私です私は、どうすればいいか"}, {"type": "subtitle", "time": 7369.99, "timestamp": "02:02:49", "text": "言い換えれば？まるで私が"}, {"type": "subtitle", "time": 7376.229, "timestamp": "02:02:56", "text": "わかった、"}, {"type": "subtitle", "time": 7378.629, "timestamp": "02:02:58", "text": "大丈夫。病気"}]
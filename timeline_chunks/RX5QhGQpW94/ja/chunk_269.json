[{"type": "subtitle", "time": 16140.389, "timestamp": "04:29:00", "text": "47分のビデオです。聖なる主よ、"}, {"type": "subtitle", "time": 16143.59, "timestamp": "04:29:03", "text": "47分のビデオです。ああ神様。待って。えーっと"}, {"type": "subtitle", "time": 16145.03, "timestamp": "04:29:05", "text": "聞こえてくると思います"}, {"type": "subtitle", "time": 16147.83, "timestamp": "04:29:07", "text": "背景。新しい音楽。ちょっと待ってください。"}, {"type": "subtitle", "time": 16151.349, "timestamp": "04:29:11", "text": "それで、マルチトラックのものを録音しました。それで"}, {"type": "subtitle", "time": 16154.63, "timestamp": "04:29:14", "text": "両方とも"}, {"type": "subtitle", "time": 16159.349, "timestamp": "04:29:19", "text": "どちらもアバターのみの音声バージョン"}, {"type": "subtitle", "time": 16161.75, "timestamp": "04:29:21", "text": "そして"}, {"type": "subtitle", "time": 16165.83, "timestamp": "04:29:25", "text": "えっと、もしこれを変更できれば"}, {"type": "subtitle", "time": 16168.469, "timestamp": "04:29:28", "text": "ディスプレイキャプチャも録画しました"}, {"type": "subtitle", "time": 16170.95, "timestamp": "04:29:30", "text": "ものも"}, {"type": "subtitle", "time": 16177.59, "timestamp": "04:29:37", "text": "うん。"}, {"type": "subtitle", "time": 16182.149, "timestamp": "04:29:42", "text": "だから、私は、ええと、"}, {"type": "subtitle", "time": 16184.229, "timestamp": "04:29:44", "text": "それはああ神様、エラーは"}, {"type": "subtitle", "time": 16186.63, "timestamp": "04:29:46", "text": "来ます。マルチトラックビデオなので"}, {"type": "subtitle", "time": 16189.51, "timestamp": "04:29:49", "text": "録音、いいえ。ああ、ちょうど閉めたところ"}, {"type": "subtitle", "time": 16191.75, "timestamp": "04:29:51", "text": "バックグラウンドミュージック。何てことだ。待って、待って、"}, {"type": "subtitle", "time": 16193.99, "timestamp": "04:29:53", "text": "待って。"}, {"type": "subtitle", "time": 16196.07, "timestamp": "04:29:56", "text": "そうですね、マルチトラックビデオなので"}, {"type": "subtitle", "time": 16199.83, "timestamp": "04:29:59", "text": "買わなきゃ ゲットしなきゃ ああ、"}]
[{"type": "subtitle", "time": 1141.83, "timestamp": "00:19:01", "text": "仕事とか。そこに定住する"}, {"type": "subtitle", "time": 1144.39, "timestamp": "00:19:04", "text": "などなど。うん。 [咳払い]いいえ、私は"}, {"type": "subtitle", "time": 1146.63, "timestamp": "00:19:06", "text": "知る。ただそこに行くだけです。行く"}, {"type": "subtitle", "time": 1161.27, "timestamp": "00:19:21", "text": "パソコン。さあ、私の言うことを聞いてください。作ってみよう"}, {"type": "subtitle", "time": 1166.549, "timestamp": "00:19:26", "text": "あなたが働いてくれれば私は私の"}, {"type": "subtitle", "time": 1170.07, "timestamp": "00:19:30", "text": "ストリーム。いいえ、私はいつも「私って何？」から始めます"}, {"type": "subtitle", "time": 1172.453, "timestamp": "00:19:32", "text": "言ってるの？ストリームを開始するところでした。"}, {"type": "subtitle", "time": 1173.029, "timestamp": "00:19:33", "text": "[笑い]"}, {"type": "subtitle", "time": 1175.99, "timestamp": "00:19:35", "text": "いいえ、私はいつも「何を言っているんだ?」から始めます。"}, {"type": "subtitle", "time": 1178.07, "timestamp": "00:19:38", "text": "いくら"}]
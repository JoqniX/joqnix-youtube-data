[{"type": "subtitle", "time": 962.23, "timestamp": "00:16:02", "text": "えっと、私はそれができるかどうかさえ知りません"}, {"type": "subtitle", "time": 965.43, "timestamp": "00:16:05", "text": "環境が私に"}, {"type": "subtitle", "time": 968.949, "timestamp": "00:16:08", "text": "プライベートな空間ができるので"}, {"type": "subtitle", "time": 971.189, "timestamp": "00:16:11", "text": "いろいろできます。"}, {"type": "subtitle", "time": 973.829, "timestamp": "00:16:13", "text": "いいえ、何年もそうではありません。基本的に6"}, {"type": "subtitle", "time": 976.79, "timestamp": "00:16:16", "text": "少なくとも数ヶ月は"}, {"type": "subtitle", "time": 981.67, "timestamp": "00:16:21", "text": "ストリーム6ヶ月私が引っ越すまで"}, {"type": "subtitle", "time": 984.629, "timestamp": "00:16:24", "text": "自分の場所。"}, {"type": "subtitle", "time": 988.629, "timestamp": "00:16:28", "text": "ああ、寮は知らないから"}, {"type": "subtitle", "time": 991.99, "timestamp": "00:16:31", "text": "ルール。寮に入ります。私は"}, {"type": "subtitle", "time": 995.749, "timestamp": "00:16:35", "text": "ルームメイトとか。えーっと"}, {"type": "subtitle", "time": 1004.15, "timestamp": "00:16:44", "text": "そう、"}, {"type": "subtitle", "time": 1007.829, "timestamp": "00:16:47", "text": "何も期待したり予測したりすることはできません。"}, {"type": "subtitle", "time": 1009.749, "timestamp": "00:16:49", "text": "滞在します。いいえ、私は"}]
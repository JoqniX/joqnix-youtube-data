[{"type": "subtitle", "time": 17580.15, "timestamp": "04:53:00", "text": "それは次のストリームになります。"}, {"type": "subtitle", "time": 17582.948, "timestamp": "04:53:02", "text": "発表しますよ。心配しないで。私はまだ"}, {"type": "subtitle", "time": 17584.868, "timestamp": "04:53:04", "text": "Fortnite ストリームをやらなければなりません。私は持っている"}, {"type": "subtitle", "time": 17587.19, "timestamp": "04:53:07", "text": "アークレアーズを行う。私たちは努力しなければなりません"}, {"type": "subtitle", "time": 17591.11, "timestamp": "04:53:11", "text": "クレ。ブループロトコルをやらなきゃ。"}, {"type": "subtitle", "time": 17595.67, "timestamp": "04:53:15", "text": "たくさんあるよ、兄弟。たくさんのものがあります。"}, {"type": "subtitle", "time": 17598.868, "timestamp": "04:53:18", "text": "でも、来てくれた皆さんありがとう"}, {"type": "subtitle", "time": 17601.27, "timestamp": "04:53:21", "text": "また。次回もお会いしましょう"}, {"type": "subtitle", "time": 17603.35, "timestamp": "04:53:23", "text": "1つ。"}, {"type": "subtitle", "time": 17606.15, "timestamp": "04:53:26", "text": "こんにちは"}, {"type": "subtitle", "time": 17613.11, "timestamp": "04:53:33", "text": "私の常時オンチャンネルにあなたを送ります。"}]
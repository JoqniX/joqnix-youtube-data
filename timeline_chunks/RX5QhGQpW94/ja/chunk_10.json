[{"type": "subtitle", "time": 602.47, "timestamp": "00:10:02", "text": "大丈夫。私はここにいます。私に話してもいいよ"}, {"type": "subtitle", "time": 607.59, "timestamp": "00:10:07", "text": "[咳払い]"}, {"type": "subtitle", "time": 616.47, "timestamp": "00:10:16", "text": "1秒。えっと、あの、えっと、ちょっと"}, {"type": "subtitle", "time": 619.03, "timestamp": "00:10:19", "text": "少し。えっと、ちょっと充電するよ"}, {"type": "subtitle", "time": 622.31, "timestamp": "00:10:22", "text": "そして、少しの間、話をします"}, {"type": "subtitle", "time": 626.15, "timestamp": "00:10:26", "text": "マルチタスクでいくつかの作業を実行すると、"}, {"type": "subtitle", "time": 636.55, "timestamp": "00:10:36", "text": "すべて順調に進んでいると思っていました。"}, {"type": "subtitle", "time": 639.19, "timestamp": "00:10:39", "text": "ああ、いつもあなたが"}, {"type": "subtitle", "time": 641.99, "timestamp": "00:10:41", "text": "いつも通りのことをして戻ってきて"}, {"type": "subtitle", "time": 645.509, "timestamp": "00:10:45", "text": "突然すべてが壊れる [笑い]"}, {"type": "subtitle", "time": 647.91, "timestamp": "00:10:47", "text": "おかしいですよね？"}, {"type": "subtitle", "time": 651.03, "timestamp": "00:10:51", "text": "そして私はOBSを準備していませんでした"}, {"type": "subtitle", "time": 654.31, "timestamp": "00:10:54", "text": "録音。どうやら新しい"}, {"type": "subtitle", "time": 659.35, "timestamp": "00:10:59", "text": "マルチトラックビデオ方式を実行できます。えーと"}]
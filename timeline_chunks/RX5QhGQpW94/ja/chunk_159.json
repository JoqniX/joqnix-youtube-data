[{"type": "subtitle", "time": 9541.75, "timestamp": "02:39:01", "text": "24 V チャネルを正しく実行していません。"}, {"type": "subtitle", "time": 9546.07, "timestamp": "02:39:06", "text": "V 24 ジョックニックは何をしているのですか?ああ、"}, {"type": "subtitle", "time": 9550.389, "timestamp": "02:39:10", "text": "jockathon フィードバックは Google フォームから送信します。"}, {"type": "subtitle", "time": 9556.71, "timestamp": "02:39:16", "text": "ああ、そうですね、私は OBS でそのようにやっています。もしあなたが"}, {"type": "subtitle", "time": 9562.63, "timestamp": "02:39:22", "text": "[咳払い]"}, {"type": "subtitle", "time": 9568.55, "timestamp": "02:39:28", "text": "ねずみ"}, {"type": "subtitle", "time": 9571.11, "timestamp": "02:39:31", "text": "電話"}, {"type": "subtitle", "time": 9575.99, "timestamp": "02:39:35", "text": "ズームは明らかです。これだと思う"}, {"type": "subtitle", "time": 9580.55, "timestamp": "02:39:40", "text": "明らかな lua マウス、つまりマウスにズームします。あなた"}, {"type": "subtitle", "time": 9583.83, "timestamp": "02:39:43", "text": "これをインストールして、これを実行してください。そして"}, {"type": "subtitle", "time": 9586.309, "timestamp": "02:39:46", "text": "GitHubをチェックして"}, {"type": "subtitle", "time": 9589.67, "timestamp": "02:39:49", "text": "この人、あなたも私を見るでしょう、なぜなら私は"}, {"type": "subtitle", "time": 9594.23, "timestamp": "02:39:54", "text": "バージョンを提案しました。ええと"}, {"type": "subtitle", "time": 9597.51, "timestamp": "02:39:57", "text": "GitHubはどこですか？"}, {"type": "subtitle", "time": 9599.59, "timestamp": "02:39:59", "text": "私は年上の人のように提案したと思います"}]
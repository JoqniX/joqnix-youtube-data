[{"type": "subtitle", "time": 9242.07, "timestamp": "02:34:02", "text": "こんにちは、ライランド。いらっしゃいませ、"}, {"type": "subtitle", "time": 9243.91, "timestamp": "02:34:03", "text": "ようこそ、ようこそ。今日は良い一日でした。私"}, {"type": "subtitle", "time": 9252.15, "timestamp": "02:34:12", "text": "次はジョークです。責める"}, {"type": "subtitle", "time": 9257.03, "timestamp": "02:34:17", "text": "AIまたは音声字幕を認識する"}, {"type": "subtitle", "time": 9258.95, "timestamp": "02:34:18", "text": "私の声。"}, {"type": "subtitle", "time": 9262.15, "timestamp": "02:34:22", "text": "次に私がジョックと言ったと仮定します。私が言った時"}, {"type": "subtitle", "time": 9267.691, "timestamp": "02:34:27", "text": "[笑い]"}, {"type": "subtitle", "time": 9269.429, "timestamp": "02:34:29", "text": "[息を呑む]"}, {"type": "subtitle", "time": 9270.95, "timestamp": "02:34:30", "text": "こんにちは。"}, {"type": "subtitle", "time": 9281.349, "timestamp": "02:34:41", "text": "はい、それはわかりました、待ってください。できると思う"}, {"type": "subtitle", "time": 9283.91, "timestamp": "02:34:43", "text": "リップル削除を実行します。私は[音楽]だと思う"}, {"type": "subtitle", "time": 9285.51, "timestamp": "02:34:45", "text": "タイムライン"}, {"type": "subtitle", "time": 9288.469, "timestamp": "02:34:48", "text": "オーディオ。"}, {"type": "subtitle", "time": 9292.95, "timestamp": "02:34:52", "text": "えっと、ビデオ。うーん、AIはないですね。"}]
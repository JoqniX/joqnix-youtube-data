[{"type": "subtitle", "time": 9900.15, "timestamp": "02:45:00", "text": "あなたがなり始めるとき"}, {"type": "subtitle", "time": 9902.389, "timestamp": "02:45:02", "text": "あなたがコンテンツクリエイターであるなら"}, {"type": "subtitle", "time": 9905.91, "timestamp": "02:45:05", "text": "すべて自分で。手に入れなければならない"}, {"type": "subtitle", "time": 9910.469, "timestamp": "02:45:10", "text": "自分のストリームを見るのに慣れています。"}, {"type": "subtitle", "time": 9913.19, "timestamp": "02:45:13", "text": "座って自分の配信を見て"}, {"type": "subtitle", "time": 9915.67, "timestamp": "02:45:15", "text": "それを乗り越える"}, {"type": "subtitle", "time": 9918.07, "timestamp": "02:45:18", "text": "自分でクリップや詰め物を作るのが好きです。"}, {"type": "subtitle", "time": 9922.95, "timestamp": "02:45:22", "text": "いいえ。だから、時間が経てば慣れるでしょう"}, {"type": "subtitle", "time": 9927.19, "timestamp": "02:45:27", "text": "それに。私はいつもライブ配信をしているときに"}, {"type": "subtitle", "time": 9930.95, "timestamp": "02:45:30", "text": "24ストリームが受信する主なチャンネル"}, {"type": "subtitle", "time": 9934.15, "timestamp": "02:45:34", "text": "一時停止中ですが、まだライブです。だからいつでも"}, {"type": "subtitle", "time": 9937.91, "timestamp": "02:45:37", "text": "24チャンネルのライブを見るということは"}, {"type": "subtitle", "time": 9940.95, "timestamp": "02:45:40", "text": "それは私たちが最後に見た記憶を再生する"}, {"type": "subtitle", "time": 9944.15, "timestamp": "02:45:44", "text": "暗闇をすべて持っていた"}, {"type": "chat", "time": 9953.292, "timestamp": "02:45:53", "author": "@abhaynair7276", "avatar": "https://yt4.ggpht.com/ytc/AIdro_m3_pcx7bakRsuScPVawS3lNZlHTFLM8XHTpdd1EGU=s64-c-k-c0x00ffffff-no-rj", "message": "no no your voice is good!!! you know when I was trying to sing I delete the app 😂😂"}, {"type": "subtitle", "time": 9954.23, "timestamp": "02:45:54", "text": "ある意味、私は"}]
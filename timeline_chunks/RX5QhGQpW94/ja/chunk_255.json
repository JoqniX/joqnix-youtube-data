[{"type": "subtitle", "time": 15301.349, "timestamp": "04:15:01", "text": "私の創造的な[音楽]努力における"}, {"type": "subtitle", "time": 15303.91, "timestamp": "04:15:03", "text": "これらの技術的なものや使用"}, {"type": "subtitle", "time": 15306.87, "timestamp": "04:15:06", "text": "サミー、そして私はもう一度これを公言したい"}, {"type": "subtitle", "time": 15310.79, "timestamp": "04:15:10", "text": "私が今日示したことは何でも"}, {"type": "subtitle", "time": 15314.469, "timestamp": "04:15:14", "text": "ストリーマーを使ってこれをやってください"}, {"type": "subtitle", "time": 15319.349, "timestamp": "04:15:19", "text": "他のストリームストリーミングツール"}, {"type": "subtitle", "time": 15322.71, "timestamp": "04:15:22", "text": "サードパーティのストリーミングのようなもの"}, {"type": "subtitle", "time": 15324.63, "timestamp": "04:15:24", "text": "ストリーマーのようなアシスタントツール"}, {"type": "subtitle", "time": 15327.51, "timestamp": "04:15:27", "text": "ボットは私がそれをできたと信じています"}, {"type": "subtitle", "time": 15329.51, "timestamp": "04:15:29", "text": "より良い"}, {"type": "subtitle", "time": 15333.59, "timestamp": "04:15:33", "text": "文字通り私のコムを見て"}, {"type": "subtitle", "time": 15337.189, "timestamp": "04:15:37", "text": "このように見るとボタンのように見えます"}, {"type": "subtitle", "time": 15340.55, "timestamp": "04:15:40", "text": "ここにたくさんのブロックがあなたの髪に"}, {"type": "subtitle", "time": 15344.63, "timestamp": "04:15:44", "text": "正直に言うと、狂ってしまうでしょう"}, {"type": "subtitle", "time": 15347.51, "timestamp": "04:15:47", "text": "私も夢中よ [音楽] 私はもっと"}, {"type": "subtitle", "time": 15350.87, "timestamp": "04:15:50", "text": "サミーを使うのが快適だからもっと大丈夫"}, {"type": "subtitle", "time": 15354.309, "timestamp": "04:15:54", "text": "サミーには適しているが、私がやるとしたら"}, {"type": "subtitle", "time": 15355.99, "timestamp": "04:15:55", "text": "この全体"}, {"type": "subtitle", "time": 15359.269, "timestamp": "04:15:59", "text": "ストリーマーで。私はただ"}]
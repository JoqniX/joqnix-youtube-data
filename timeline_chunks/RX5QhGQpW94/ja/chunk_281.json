[{"type": "subtitle", "time": 16885.03, "timestamp": "04:41:25", "text": "20ドル。いいえ、20ではありません。20ではないと思います。"}, {"type": "subtitle", "time": 16887.19, "timestamp": "04:41:27", "text": "他のアプリにも料金を支払う必要があります。"}, {"type": "subtitle", "time": 16888.948, "timestamp": "04:41:28", "text": "右。"}, {"type": "subtitle", "time": 16891.03, "timestamp": "04:41:31", "text": "だから私は"}, {"type": "subtitle", "time": 16894.39, "timestamp": "04:41:34", "text": "アンディ・スカフの方が俺がやるならいいな"}, {"type": "subtitle", "time": 16897.99, "timestamp": "04:41:37", "text": "雲や物のようなものですが、私は"}, {"type": "subtitle", "time": 16902.23, "timestamp": "04:41:42", "text": "月額90ドルを支払います。それはおかしい。それは"}, {"type": "subtitle", "time": 16906.39, "timestamp": "04:41:46", "text": "私の通貨ではいくらですか？"}, {"type": "subtitle", "time": 16911.11, "timestamp": "04:41:51", "text": "8,000ルピー。こんにちは。"}]
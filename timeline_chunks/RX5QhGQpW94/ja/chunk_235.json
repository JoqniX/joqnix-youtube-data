[{"type": "subtitle", "time": 14100.87, "timestamp": "03:55:00", "text": "自動的にアクティブ化されて実行されます。基本的に実行する"}, {"type": "subtitle", "time": 14104.309, "timestamp": "03:55:04", "text": "2度目の処刑となる。"}, {"type": "subtitle", "time": 14106.469, "timestamp": "03:55:06", "text": "最初の実行は同期です"}, {"type": "subtitle", "time": 14108.95, "timestamp": "03:55:08", "text": "ボタン。同期する"}, {"type": "subtitle", "time": 14111.429, "timestamp": "03:55:11", "text": "すべてが最新の状態です。"}, {"type": "subtitle", "time": 14114.71, "timestamp": "03:55:14", "text": "右？ [音楽]それでは"}, {"type": "subtitle", "time": 14117.91, "timestamp": "03:55:17", "text": "単語サイクル実行ボタンを作成しました。それでここで"}, {"type": "subtitle", "time": 14121.83, "timestamp": "03:55:21", "text": "何が起こるかというと、それが取得されるのです。"}, {"type": "subtitle", "time": 14124.229, "timestamp": "03:55:24", "text": "それはチャンネルを取得します"}, {"type": "subtitle", "time": 14126.07, "timestamp": "03:55:26", "text": "ビデオ。"}, {"type": "subtitle", "time": 14128.79, "timestamp": "03:55:28", "text": "つまり、実際には 3 回のフェッチが実行されます。"}, {"type": "subtitle", "time": 14131.429, "timestamp": "03:55:31", "text": "一つは全体の取得になります"}, {"type": "subtitle", "time": 14134.309, "timestamp": "03:55:34", "text": "チャネル。これは参考資料です"}, {"type": "subtitle", "time": 14136.79, "timestamp": "03:55:36", "text": "反復1と2では"}, {"type": "subtitle", "time": 14139.51, "timestamp": "03:55:39", "text": "全体を取得する"}, {"type": "subtitle", "time": 14143.67, "timestamp": "03:55:43", "text": "私のチャンネルのチャンネルVSビデオ。それは"}, {"type": "subtitle", "time": 14146.469, "timestamp": "03:55:46", "text": "こんな感じの音楽を探してください。"}, {"type": "subtitle", "time": 14150.07, "timestamp": "03:55:50", "text": "うーん、こんな感じになります。のように"}, {"type": "subtitle", "time": 14153.83, "timestamp": "03:55:53", "text": "すべての1000本のビデオ 1000本以上のビデオ"}, {"type": "subtitle", "time": 14156.07, "timestamp": "03:55:56", "text": "私のチャンネルはこのように取得されます"}, {"type": "subtitle", "time": 14159.289, "timestamp": "03:55:59", "text": "適切にフォーマットされ、"}]
[{"type": "subtitle", "time": 5229.189, "timestamp": "01:27:09", "text": "えーっと、普段は"}, {"type": "subtitle", "time": 5232.95, "timestamp": "01:27:12", "text": "チャドGPTに私の脚本を書いてもらう"}, {"type": "subtitle", "time": 5235.27, "timestamp": "01:27:15", "text": "ビデオ？えーっと"}, {"type": "subtitle", "time": 5245.51, "timestamp": "01:27:25", "text": "わかった。 OBS を設定する必要があります。"}, {"type": "subtitle", "time": 5249.669, "timestamp": "01:27:29", "text": "だから、ここではストリームをやらないことにします。"}, {"type": "subtitle", "time": 5253.91, "timestamp": "01:27:33", "text": "そこで初めて"}, {"type": "subtitle", "time": 5256.55, "timestamp": "01:27:36", "text": "OBS の設定。それで私たちは"}, {"type": "subtitle", "time": 5261.27, "timestamp": "01:27:41", "text": "マルチビデオマルチビデオトラックを実行する"}, {"type": "subtitle", "time": 5263.99, "timestamp": "01:27:43", "text": "もの。"}, {"type": "subtitle", "time": 5265.91, "timestamp": "01:27:45", "text": "それで"}, {"type": "subtitle", "time": 5269.27, "timestamp": "01:27:49", "text": "キャンバスを追加します。このキャンバスは"}, {"type": "subtitle", "time": 5270.95, "timestamp": "01:27:50", "text": "なれ"}, {"type": "subtitle", "time": 5272.79, "timestamp": "01:27:52", "text": "ジョック"}, {"type": "subtitle", "time": 5275.03, "timestamp": "01:27:55", "text": "アバター"}, {"type": "subtitle", "time": 5277.99, "timestamp": "01:27:57", "text": "のみ。これは追加事項になります"}]
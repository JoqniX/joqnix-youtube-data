[{"type": "subtitle", "time": 5282.47, "timestamp": "01:28:02", "text": "キャンバス。ええと、解像度は"}, {"type": "subtitle", "time": 5285.669, "timestamp": "01:28:05", "text": "1920 x 1080。わかりました。"}, {"type": "subtitle", "time": 5289.11, "timestamp": "01:28:09", "text": "これがキャンバスです。私がやることは"}, {"type": "subtitle", "time": 5292.55, "timestamp": "01:28:12", "text": "騒ぎを起こす。追加"}, {"type": "subtitle", "time": 5313.75, "timestamp": "01:28:33", "text": "だから私たちはあなたを"}, {"type": "subtitle", "time": 5319.27, "timestamp": "01:28:39", "text": "グリーンスクリーン。だから色が映えるのです。"}, {"type": "subtitle", "time": 5321.27, "timestamp": "01:28:41", "text": "これは何ですか？"}, {"type": "subtitle", "time": 5324.709, "timestamp": "01:28:44", "text": "いいえ。えーと、色のショーを追加する必要があります。"}, {"type": "subtitle", "time": 5327.11, "timestamp": "01:28:47", "text": "うん。"}, {"type": "subtitle", "time": 5330.629, "timestamp": "01:28:50", "text": "色は緑。はい、それで大丈夫です。"}, {"type": "subtitle", "time": 5333.35, "timestamp": "01:28:53", "text": "Ctrl + F。"}, {"type": "subtitle", "time": 5337.189, "timestamp": "01:28:57", "text": "OBSのことを忘れてしまいました。私は明白なものは使いません。"}, {"type": "subtitle", "time": 5339.59, "timestamp": "01:28:59", "text": "えっと、コントロール"}]
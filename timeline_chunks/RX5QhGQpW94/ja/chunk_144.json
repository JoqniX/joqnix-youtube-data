[{"type": "subtitle", "time": 8643.91, "timestamp": "02:24:03", "text": "だから、このインスピレーションは私が"}, {"type": "subtitle", "time": 8648.389, "timestamp": "02:24:08", "text": "彼と同じようにやろう。馬車"}, {"type": "subtitle", "time": 8650.469, "timestamp": "02:24:10", "text": "した。"}, {"type": "subtitle", "time": 8657.429, "timestamp": "02:24:17", "text": "はい、このようにします。私"}, {"type": "subtitle", "time": 8695.03, "timestamp": "02:24:55", "text": "ええ、ある意味私の究極の目標は"}, {"type": "subtitle", "time": 8698.55, "timestamp": "02:24:58", "text": "私の24時間の仕事は"}]
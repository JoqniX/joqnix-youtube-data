[{"type": "subtitle", "time": 10263.302, "timestamp": "02:51:03", "text": "ええと、地下の地下"}, {"type": "subtitle", "time": 10264.389, "timestamp": "02:51:04", "text": "[音楽]"}, {"type": "subtitle", "time": 10267.11, "timestamp": "02:51:07", "text": "音楽アーティストのDJショーや"}, {"type": "subtitle", "time": 10269.853, "timestamp": "02:51:09", "text": "私ができるすべてのこと"}, {"type": "subtitle", "time": 10270.469, "timestamp": "02:51:10", "text": "[音楽]"}, {"type": "subtitle", "time": 10272.55, "timestamp": "02:51:12", "text": "すると、誰が"}, {"type": "subtitle", "time": 10276.23, "timestamp": "02:51:16", "text": "日本でランダムなインド人が作るのを見る"}, {"type": "subtitle", "time": 10279.67, "timestamp": "02:51:19", "text": "音楽とDJとかいいよね"}, {"type": "subtitle", "time": 10282.63, "timestamp": "02:51:22", "text": "質問ですが、私は分かりません"}, {"type": "subtitle", "time": 10284.23, "timestamp": "02:51:24", "text": "それがうまくいかなかったら、即興でやるつもりだ"}, {"type": "subtitle", "time": 10287.83, "timestamp": "02:51:27", "text": "仕事には他のバックアッププランもあります"}, {"type": "subtitle", "time": 10290.55, "timestamp": "02:51:30", "text": "うん、"}, {"type": "subtitle", "time": 10294.389, "timestamp": "02:51:34", "text": "ある意味。ええ、でも問題は、えーっと、私は"}, {"type": "subtitle", "time": 10296.95, "timestamp": "02:51:36", "text": "あまり頼りすぎたり、頼りすぎたりしたくない"}, {"type": "subtitle", "time": 10300.63, "timestamp": "02:51:40", "text": "私の家族のお金。パートタイムの仕事に就いたとき"}, {"type": "subtitle", "time": 10303.19, "timestamp": "02:51:43", "text": "そして私がそこに着いたらすべて"}, {"type": "subtitle", "time": 10306.389, "timestamp": "02:51:46", "text": "最初の1年目以降"}, {"type": "subtitle", "time": 10308.309, "timestamp": "02:51:48", "text": "すべては依存することになる"}, {"type": "subtitle", "time": 10310.63, "timestamp": "02:51:50", "text": "私自身"}, {"type": "subtitle", "time": 10312.428, "timestamp": "02:51:52", "text": "私が必要としないもの全てを賄う"}, {"type": "subtitle", "time": 10314.07, "timestamp": "02:51:54", "text": "[咳払い] 3番目に頼りたい"}, {"type": "subtitle", "time": 10316.79, "timestamp": "02:51:56", "text": "まったくパーティーにならない。"}]
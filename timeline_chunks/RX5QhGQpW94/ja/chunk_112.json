[{"type": "subtitle", "time": 6720.79, "timestamp": "01:52:00", "text": "わかった。えっと、5分くらいかかります"}, {"type": "subtitle", "time": 6723.189, "timestamp": "01:52:03", "text": "ビデオですよね？わかった。こんにちは。わかった。私は行きます"}, {"type": "subtitle", "time": 6724.87, "timestamp": "01:52:04", "text": "それを行う。はい、[笑い]"}, {"type": "subtitle", "time": 6728.95, "timestamp": "01:52:08", "text": "幸運を祈ってください。ライブを見ることになる"}, {"type": "subtitle", "time": 6730.95, "timestamp": "01:52:10", "text": "生々しいドッギング"}, {"type": "subtitle", "time": 6734.629, "timestamp": "01:52:14", "text": "私が録音しているものです。うんうん。"}, {"type": "subtitle", "time": 6737.109, "timestamp": "01:52:17", "text": "ああ神様、助けてください。"}, {"type": "subtitle", "time": 6746.229, "timestamp": "01:52:26", "text": "えーと"}, {"type": "subtitle", "time": 6748.87, "timestamp": "01:52:28", "text": "これをここに置いて"}, {"type": "subtitle", "time": 6762.229, "timestamp": "01:52:42", "text": "待って、私の、えっと、私のを見るにはどうすればいいですか？"}, {"type": "subtitle", "time": 6765.109, "timestamp": "01:52:45", "text": "キャンバス"}, {"type": "subtitle", "time": 6773.189, "timestamp": "01:52:53", "text": "最新は明らかではないですか?ああ、できるよ"}, {"type": "subtitle", "time": 6776.629, "timestamp": "01:52:56", "text": "ドッキングのように"}]
[{"type": "subtitle", "time": 13510.229, "timestamp": "03:45:10", "text": "2035年に彼らはいくつかの変更を加えました"}, {"type": "subtitle", "time": 13521.269, "timestamp": "03:45:21", "text": "つまりウェブサイトを開設する必要がある"}, {"type": "subtitle", "time": 13524.309, "timestamp": "03:45:24", "text": "または目的地がどこなのか"}, {"type": "subtitle", "time": 13527.11, "timestamp": "03:45:27", "text": "埋め込みも行います。それは"}, {"type": "subtitle", "time": 13531.349, "timestamp": "03:45:31", "text": "トゥイッチ。 Twitchを埋め込もうとすると"}, {"type": "subtitle", "time": 13533.99, "timestamp": "03:45:33", "text": "ウェブサイトでストリーミングするには、入力する必要があります"}, {"type": "subtitle", "time": 13538.229, "timestamp": "03:45:38", "text": "あなたの参照者。それはあなたのウェブサイトです"}, {"type": "subtitle", "time": 13541.99, "timestamp": "03:45:41", "text": "I フレームにアドレスがあるんですよね?あなたが持っている"}, {"type": "subtitle", "time": 13545.59, "timestamp": "03:45:45", "text": "今度は YouTube でも同じことを行います。そして"}, {"type": "subtitle", "time": 13549.11, "timestamp": "03:45:49", "text": "それはとても大きな問題であり、とても"}, {"type": "subtitle", "time": 13553.11, "timestamp": "03:45:53", "text": "私のために奮闘してください。それで私は方法を見つけました"}, {"type": "subtitle", "time": 13556.309, "timestamp": "03:45:56", "text": "私の場合、私の使用ではそれに対抗できる"}]
[{"type": "subtitle", "time": 7681.91, "timestamp": "02:08:01", "text": "約束または"}, {"type": "subtitle", "time": 7684.709, "timestamp": "02:08:04", "text": "そのようなことは一切ありません。それは"}, {"type": "subtitle", "time": 7687.589, "timestamp": "02:08:07", "text": "私のメインのライブストリームの代わり"}, {"type": "subtitle", "time": 7690.709, "timestamp": "02:08:10", "text": "これまで。そして、それは"}, {"type": "subtitle", "time": 7694.31, "timestamp": "02:08:14", "text": "ライブストリーム。それは基本的に"}, {"type": "subtitle", "time": 7696.709, "timestamp": "02:08:16", "text": "再放送。"}, {"type": "subtitle", "time": 7700.149, "timestamp": "02:08:20", "text": "以前のコンテンツを再放送しています"}, {"type": "subtitle", "time": 7702.709, "timestamp": "02:08:22", "text": "以前にも配信したことがあります。技術的には"}, {"type": "subtitle", "time": 7705.99, "timestamp": "02:08:25", "text": "それはライブですが、ライブライフライブではありません。"}, {"type": "subtitle", "time": 7709.03, "timestamp": "02:08:29", "text": "だから、いつでも思い出してください"}, {"type": "subtitle", "time": 7712.79, "timestamp": "02:08:32", "text": "私の24時間年中無休のチャンネルに出会う"}, {"type": "subtitle", "time": 7715.979, "timestamp": "02:08:35", "text": "YouTubeキックまたはTwitchでストリームします"}, {"type": "subtitle", "time": 7718.629, "timestamp": "02:08:38", "text": "[音楽] チャットはできないことを覚えておいてください"}, {"type": "subtitle", "time": 7721.27, "timestamp": "02:08:41", "text": "今のところモデレーターです。"}, {"type": "subtitle", "time": 7724.149, "timestamp": "02:08:44", "text": "もしあなたがそこにメッセージを送るなら"}, {"type": "subtitle", "time": 7727.109, "timestamp": "02:08:47", "text": "チャットルームでは、うーん、私はできません"}, {"type": "subtitle", "time": 7729.189, "timestamp": "02:08:49", "text": "見てください。"}, {"type": "subtitle", "time": 7731.75, "timestamp": "02:08:51", "text": "そしてあなたは私と話をしないでしょう"}, {"type": "subtitle", "time": 7734.87, "timestamp": "02:08:54", "text": "私の通常のストリームがどこにあるのかを直接"}, {"type": "subtitle", "time": 7738.39, "timestamp": "02:08:58", "text": "ライブチャットでチャットしていただければ"}]
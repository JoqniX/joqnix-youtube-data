[{"type": "subtitle", "time": 3783.19, "timestamp": "01:03:03", "text": "彼の配信を見て、"}, {"type": "subtitle", "time": 3785.91, "timestamp": "01:03:05", "text": "彼のコンテンツやその他のものとやり取りします。"}, {"type": "subtitle", "time": 3788.47, "timestamp": "01:03:08", "text": "そしてトークンなどを獲得できます。そして"}, {"type": "subtitle", "time": 3790.39, "timestamp": "01:03:10", "text": "十分なトークンがあれば、"}, {"type": "subtitle", "time": 3794.39, "timestamp": "01:03:14", "text": "クランなどに参加したり"}, {"type": "subtitle", "time": 3796.87, "timestamp": "01:03:16", "text": "えっと、ゲームのクランですよね？デスティニー一族のように"}, {"type": "subtitle", "time": 3799.91, "timestamp": "01:03:19", "text": "などなど、いろいろなものが好きです。そして"}, {"type": "subtitle", "time": 3805.109, "timestamp": "01:03:25", "text": "また、例えば、"}, {"type": "subtitle", "time": 3809.19, "timestamp": "01:03:29", "text": "ええと、アバターみたいなもの。どこですか"}, {"type": "subtitle", "time": 3812.47, "timestamp": "01:03:32", "text": "それ？どこですか？どこですか？うん。"}, {"type": "subtitle", "time": 3814.549, "timestamp": "01:03:34", "text": "コバタス。"}, {"type": "subtitle", "time": 3816.71, "timestamp": "01:03:36", "text": "ああ、アバターみたいなやつ。"}, {"type": "subtitle", "time": 3819.19, "timestamp": "01:03:39", "text": "自分だけのアバターを作ることができます"}, {"type": "subtitle", "time": 3820.87, "timestamp": "01:03:40", "text": "通貨"}, {"type": "subtitle", "time": 3822.87, "timestamp": "01:03:42", "text": "獲得したトークンは"}, {"type": "subtitle", "time": 3825.91, "timestamp": "01:03:45", "text": "貢献しています。いいえ、チャンネルです。それはまるで"}, {"type": "subtitle", "time": 3828.069, "timestamp": "01:03:48", "text": "Twitch チャンネルポイントのようなものです。私"}, {"type": "subtitle", "time": 3831.19, "timestamp": "01:03:51", "text": "いつかこれをやりたいな。"}, {"type": "subtitle", "time": 3833.109, "timestamp": "01:03:53", "text": "いつかこれをやりたい。ありがとうございます"}]
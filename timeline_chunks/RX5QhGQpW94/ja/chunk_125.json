[{"type": "subtitle", "time": 7501.91, "timestamp": "02:05:01", "text": "私が24時間チャンネルを作ったのは"}, {"type": "subtitle", "time": 7504.55, "timestamp": "02:05:04", "text": "みんなが欲しかった"}, {"type": "subtitle", "time": 7507.189, "timestamp": "02:05:07", "text": "持つ"}, {"type": "subtitle", "time": 7511.109, "timestamp": "02:05:11", "text": "私がそこにいないとき、"}, {"type": "subtitle", "time": 7515.91, "timestamp": "02:05:15", "text": "ストリーミングやライブ配信ができない"}, {"type": "subtitle", "time": 7520.149, "timestamp": "02:05:20", "text": "人生のせいか、何かしらのせい。私は欲しかった"}, {"type": "subtitle", "time": 7523.83, "timestamp": "02:05:23", "text": "私のコミュニティが見ることができて"}, {"type": "subtitle", "time": 7528.39, "timestamp": "02:05:28", "text": "古い凝縮器を楽しんでください"}, {"type": "subtitle", "time": 7530.709, "timestamp": "02:05:30", "text": "経験し、思い出を作りました"}, {"type": "subtitle", "time": 7534.629, "timestamp": "02:05:34", "text": "過去。皆さんに楽しんでもらいたかったんです"}, {"type": "subtitle", "time": 7537.51, "timestamp": "02:05:37", "text": "また。"}, {"type": "subtitle", "time": 7544.229, "timestamp": "02:05:44", "text": "私たちが共有した思い出を振り返る"}, {"type": "subtitle", "time": 7548.87, "timestamp": "02:05:48", "text": "前に。うん。だから24時間"}]
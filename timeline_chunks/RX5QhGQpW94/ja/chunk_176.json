[{"type": "subtitle", "time": 10561.19, "timestamp": "02:56:01", "text": "【音楽】やること。うまくいくなら、うまくいく。もし"}, {"type": "subtitle", "time": 10564.07, "timestamp": "02:56:04", "text": "動作しません、問題ありません。"}, {"type": "subtitle", "time": 10567.51, "timestamp": "02:56:07", "text": "見せてあげる。私はそれを保持しないと思います"}, {"type": "subtitle", "time": 10572.469, "timestamp": "02:56:12", "text": "永遠に。需要があれば、あるいは"}, {"type": "subtitle", "time": 10576.07, "timestamp": "02:56:16", "text": "あるいは余裕があるかどうか。それで、私はただ"}, {"type": "subtitle", "time": 10578.71, "timestamp": "02:56:18", "text": "今夕食を食べました。ニース。私はすでに"}, {"type": "subtitle", "time": 10602.79, "timestamp": "02:56:42", "text": "でもそれはまるで試練のよう"}, {"type": "subtitle", "time": 10604.07, "timestamp": "02:56:44", "text": "そしてエラー。"}, {"type": "subtitle", "time": 10607.11, "timestamp": "02:56:47", "text": "私はただ、試してみたいだけなのです"}, {"type": "subtitle", "time": 10609.99, "timestamp": "02:56:49", "text": "以前に試してみて、それがどのように"}, {"type": "subtitle", "time": 10613.19, "timestamp": "02:56:53", "text": "行きます。これは良い学習教材です"}, {"type": "subtitle", "time": 10615.67, "timestamp": "02:56:55", "text": "他にも"}, {"type": "subtitle", "time": 10619.03, "timestamp": "02:56:59", "text": "私は今リスクを負って裁判に臨んでいるので"}]
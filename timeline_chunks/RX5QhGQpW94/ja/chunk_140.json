[{"type": "subtitle", "time": 8401.67, "timestamp": "02:20:01", "text": "だから"}, {"type": "subtitle", "time": 8404.71, "timestamp": "02:20:04", "text": "こんにちは、みんな。"}, {"type": "subtitle", "time": 8406.55, "timestamp": "02:20:06", "text": "なぜ品質は大丈夫なのでしょうか。わかった。私"}, {"type": "subtitle", "time": 8412.252, "timestamp": "02:20:12", "text": "忘れました。えっと、どうやってエフェクトを追加すればいいですか？えーっと"}, {"type": "subtitle", "time": 8414.07, "timestamp": "02:20:14", "text": "[咳]"}, {"type": "subtitle", "time": 8416.63, "timestamp": "02:20:16", "text": "いや、待って。えっと、クロマを検索する必要があります"}, {"type": "subtitle", "time": 8423.67, "timestamp": "02:20:23", "text": "緑はありません。えーっと"}, {"type": "subtitle", "time": 8425.75, "timestamp": "02:20:25", "text": "ちょっと待って、それは何と呼ばれていますか？ああ、私は"}, {"type": "subtitle", "time": 8429.83, "timestamp": "02:20:29", "text": "忘れてたよ。えーっと"}, {"type": "subtitle", "time": 8433.03, "timestamp": "02:20:33", "text": "それは何と呼ばれていますか？"}, {"type": "subtitle", "time": 8444.95, "timestamp": "02:20:44", "text": "YouTubeのストリームをすべて放送する"}, {"type": "subtitle", "time": 8447.349, "timestamp": "02:20:47", "text": "これは私の YouTube チャンネルで行ったものです。"}, {"type": "subtitle", "time": 8448.95, "timestamp": "02:20:48", "text": "私のYouTube。わかった。ありがとう。 [音楽]"}, {"type": "subtitle", "time": 8450.15, "timestamp": "02:20:50", "text": "ありがとう。許可してくれてありがとう"}, {"type": "subtitle", "time": 8453.03, "timestamp": "02:20:53", "text": "知る。ありがとう。"}, {"type": "subtitle", "time": 8456.79, "timestamp": "02:20:56", "text": "効果ええと"}]
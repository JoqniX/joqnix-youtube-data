[{"type": "subtitle", "time": 1742.23, "timestamp": "00:29:02", "text": "同じ学校に通っているので"}, {"type": "subtitle", "time": 1745.35, "timestamp": "00:29:05", "text": "一人ではダメ [鼻で笑う] 悲しいし、良くない"}, {"type": "subtitle", "time": 1747.11, "timestamp": "00:29:07", "text": "心配"}, {"type": "chat", "time": 1753.051, "timestamp": "00:29:13", "author": "@FEROCIOUS_Grrr", "avatar": "https://yt4.ggpht.com/rmtWHi2aNUIGM7D2-pghmzYKH0T3TxOrKX5r3tEUTUKW76MPbf9yPfYQIA9_qVEyIMBRSZJypw=s64-c-k-c0x00ffffff-no-rj", "message": "REASON IS IMMORTAL, ALL ELSE IS MORTAL.. just a unique line heard by great mathematician hehe"}, {"type": "subtitle", "time": 1759.11, "timestamp": "00:29:19", "text": "3月中旬まで。"}, {"type": "subtitle", "time": 1761.83, "timestamp": "00:29:21", "text": "だから心配しないでください。私はそうするだろう"}, {"type": "subtitle", "time": 1763.99, "timestamp": "00:29:23", "text": "ストリームをやっています、そして今回は"}, {"type": "subtitle", "time": 1766.549, "timestamp": "00:29:26", "text": "私はサバソンをやりません。"}, {"type": "subtitle", "time": 1768.95, "timestamp": "00:29:28", "text": "ジョアソンは来ません。それだけです。"}, {"type": "subtitle", "time": 1770.71, "timestamp": "00:29:30", "text": "うん。"}, {"type": "subtitle", "time": 1774.07, "timestamp": "00:29:34", "text": "人々が"}, {"type": "subtitle", "time": 1777.11, "timestamp": "00:29:37", "text": "人々は私がいなくて寂しくなると思う"}, {"type": "subtitle", "time": 1780.23, "timestamp": "00:29:40", "text": "などなど。いいえ、だから私は"}, {"type": "subtitle", "time": 1784.149, "timestamp": "00:29:44", "text": "24時間365日のチャンネルとか。"}, {"type": "subtitle", "time": 1786.07, "timestamp": "00:29:46", "text": "うん。"}, {"type": "subtitle", "time": 1788.71, "timestamp": "00:29:48", "text": "私はビデオを録画するつもりです"}, {"type": "subtitle", "time": 1791.83, "timestamp": "00:29:51", "text": "それは今しばらくしてから。直してあげる"}, {"type": "subtitle", "time": 1796.23, "timestamp": "00:29:56", "text": "私が抱えているこの馬鹿げたバグ。えっと、あなたの"}, {"type": "subtitle", "time": 1799.669, "timestamp": "00:29:59", "text": "学校 ウーラン語 現地語"}]
[{"type": "subtitle", "time": 16441.109, "timestamp": "04:34:01", "text": "プレイします"}, {"type": "subtitle", "time": 16444.629, "timestamp": "04:34:04", "text": "えっと、ビデオとか私のビデオみたいに"}, {"type": "subtitle", "time": 16446.869, "timestamp": "04:34:06", "text": "プレイリスト。ただおしゃべりするだけのプレイリスト。私"}, {"type": "subtitle", "time": 16449.91, "timestamp": "04:34:09", "text": "プレイリストがあります。私は正当な"}, {"type": "subtitle", "time": 16453.129, "timestamp": "04:34:13", "text": "チャットプレイリストまたはうん。それでこれ。"}, {"type": "subtitle", "time": 16454.23, "timestamp": "04:34:14", "text": "[笑い]"}, {"type": "subtitle", "time": 16457.189, "timestamp": "04:34:17", "text": "そうすれば、これからビデオが再生されます。"}, {"type": "subtitle", "time": 16459.67, "timestamp": "04:34:19", "text": "現在のTwitchカテゴリーをチェックして"}, {"type": "subtitle", "time": 16463.429, "timestamp": "04:34:23", "text": "もの。するとまたインスピレーションが湧きました。"}, {"type": "subtitle", "time": 16465.83, "timestamp": "04:34:25", "text": "それで、私はこう思いました。「よし、この大きな"}, {"type": "subtitle", "time": 16468.07, "timestamp": "04:34:28", "text": "ストリーマーは常にオンの状態"}, {"type": "subtitle", "time": 16470.07, "timestamp": "04:34:30", "text": "いつもTwitchでこれやってる"}, {"type": "subtitle", "time": 16473.109, "timestamp": "04:34:33", "text": "このカテゴリーは本当にクールです。やりたいこと"}, {"type": "subtitle", "time": 16476.789, "timestamp": "04:34:36", "text": "こんな感じです。そこで私は"}, {"type": "subtitle", "time": 16480.07, "timestamp": "04:34:40", "text": "彼らがどのようにこの設定を行ったかを調べ、"}, {"type": "subtitle", "time": 16483.429, "timestamp": "04:34:43", "text": "特にここのCo、連合のように"}, {"type": "subtitle", "time": 16487.59, "timestamp": "04:34:47", "text": "ゲーム。本当に、ええと、気に入ってよかったです"}, {"type": "subtitle", "time": 16491.189, "timestamp": "04:34:51", "text": "彼がどうやって作品を作ったのか調べてみると、"}, {"type": "subtitle", "time": 16492.869, "timestamp": "04:34:52", "text": "すべて。"}, {"type": "subtitle", "time": 16494.869, "timestamp": "04:34:54", "text": "そうです、そういう風に作ったんです。それで"}, {"type": "subtitle", "time": 16498.07, "timestamp": "04:34:58", "text": "Sammyではすべてがうまくいきます。私は思う"}]
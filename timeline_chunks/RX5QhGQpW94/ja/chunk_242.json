[{"type": "subtitle", "time": 14520.79, "timestamp": "04:02:00", "text": "私のウェブサイトからお見せするとしたら。"}, {"type": "subtitle", "time": 14526.71, "timestamp": "04:02:06", "text": "それで、現時点では"}, {"type": "subtitle", "time": 14529.349, "timestamp": "04:02:09", "text": "これはピアノのプレイリストです"}, {"type": "subtitle", "time": 14532.63, "timestamp": "04:02:12", "text": "このプレイリストには1つだけあります"}, {"type": "subtitle", "time": 14535.429, "timestamp": "04:02:15", "text": "ビデオ。次のプレイリストは"}, {"type": "subtitle", "time": 14537.83, "timestamp": "04:02:17", "text": "バトルフィールドと次のプレイリスト"}, {"type": "subtitle", "time": 14541.67, "timestamp": "04:02:21", "text": "Destiny 2になります。"}, {"type": "subtitle", "time": 14546.469, "timestamp": "04:02:26", "text": "ここでの私たちの考えは、バトルフィールド4です。"}, {"type": "subtitle", "time": 14550.469, "timestamp": "04:02:30", "text": "それから[音楽] Destiny 2とピアノ"}, {"type": "subtitle", "time": 14552.71, "timestamp": "04:02:32", "text": "学ぶ。まさにその通りです。この3つ"}, {"type": "subtitle", "time": 14555.99, "timestamp": "04:02:35", "text": "プレイリストがアクティブで[音楽]"}, {"type": "subtitle", "time": 14557.99, "timestamp": "04:02:37", "text": "ビデオを取得します。だからこの二人は"}, {"type": "subtitle", "time": 14560.469, "timestamp": "04:02:40", "text": "プレイリストにはビデオが 1 つだけあります。それから休む"}, {"type": "subtitle", "time": 14564.71, "timestamp": "04:02:44", "text": "Destiny の 10 本のビデオのうちの 1 本。 10本のビデオ"}, {"type": "subtitle", "time": 14567.269, "timestamp": "04:02:47", "text": "Destinyからのものはここにあります。それから[音楽]"}, {"type": "subtitle", "time": 14570.87, "timestamp": "04:02:50", "text": "21番からここまで"}, {"type": "subtitle", "time": 14575.03, "timestamp": "04:02:55", "text": "22 から 23 以降。できる限り"}, {"type": "subtitle", "time": 14577.349, "timestamp": "04:02:57", "text": "その他すべてはランダムです。 [音楽]"}]
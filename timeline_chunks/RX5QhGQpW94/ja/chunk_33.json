[{"type": "subtitle", "time": 1981.99, "timestamp": "00:33:01", "text": "そういう感じ。それで彼らは[咳払い]"}, {"type": "subtitle", "time": 1984.31, "timestamp": "00:33:04", "text": "あなたに機会を与え、彼らはつながります"}, {"type": "subtitle", "time": 1986.23, "timestamp": "00:33:06", "text": "あなたと言語で。いいね。あなた"}, {"type": "subtitle", "time": 1988.07, "timestamp": "00:33:08", "text": "面接に合格して、"}, {"type": "subtitle", "time": 1989.909, "timestamp": "00:33:09", "text": "それから"}, {"type": "subtitle", "time": 1992.87, "timestamp": "00:33:12", "text": "あなたがそこに受け入れられるまで"}, {"type": "subtitle", "time": 1994.789, "timestamp": "00:33:14", "text": "航空券が送られてくる"}, {"type": "subtitle", "time": 1996.95, "timestamp": "00:33:16", "text": "すべてがパッケージに入っています。彼らは、うーん"}, {"type": "subtitle", "time": 1999.75, "timestamp": "00:33:19", "text": "地元の研究所があなたを助けます"}, {"type": "subtitle", "time": 2003.509, "timestamp": "00:33:23", "text": "ローカル文書翻訳のようなもの"}, {"type": "subtitle", "time": 2007.83, "timestamp": "00:33:27", "text": "すべては地元の研究所が行います。"}, {"type": "subtitle", "time": 2010.71, "timestamp": "00:33:30", "text": "そして日本に着いたら、"}, {"type": "subtitle", "time": 2013.029, "timestamp": "00:33:33", "text": "語学学校"}, {"type": "subtitle", "time": 2015.35, "timestamp": "00:33:35", "text": "ああ、そうだ日本語"}, {"type": "subtitle", "time": 2017.269, "timestamp": "00:33:37", "text": "学校は彼ら"}, {"type": "subtitle", "time": 2020.31, "timestamp": "00:33:40", "text": "地元の研究所は"}, {"type": "subtitle", "time": 2023.35, "timestamp": "00:33:43", "text": "あなたの守護者があなたの邪魔をするかのように"}, {"type": "subtitle", "time": 2025.11, "timestamp": "00:33:45", "text": "5歳になったら何でも起こる"}, {"type": "subtitle", "time": 2028.23, "timestamp": "00:33:48", "text": "分遅れまたは1分遅れ"}, {"type": "subtitle", "time": 2032.23, "timestamp": "00:33:52", "text": "朝の授業は日本にいる間ですよね"}, {"type": "subtitle", "time": 2034.149, "timestamp": "00:33:54", "text": "その"}, {"type": "subtitle", "time": 2037.19, "timestamp": "00:33:57", "text": "校長先生が電話して"}, {"type": "subtitle", "time": 2039.35, "timestamp": "00:33:59", "text": "あなたのような義理の地元の研究所"}]
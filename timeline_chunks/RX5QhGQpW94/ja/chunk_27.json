[{"type": "subtitle", "time": 1622.23, "timestamp": "00:27:02", "text": "5、6、7回くらいストリーミングします。"}, {"type": "subtitle", "time": 1624.47, "timestamp": "00:27:04", "text": "それが最大の出来事だったと思う"}, {"type": "subtitle", "time": 1630.95, "timestamp": "00:27:10", "text": "間違いだってええと、ええと、私が"}, {"type": "subtitle", "time": 1633.51, "timestamp": "00:27:13", "text": "自分の個人的なことを話し始めた"}, {"type": "subtitle", "time": 1635.51, "timestamp": "00:27:15", "text": "生活用品"}, {"type": "subtitle", "time": 1638.549, "timestamp": "00:27:18", "text": "えっと、私は2つの側面を理解し始めています"}, {"type": "subtitle", "time": 1641.909, "timestamp": "00:27:21", "text": "人々。一つは支援側であり、"}, {"type": "subtitle", "time": 1646.07, "timestamp": "00:27:26", "text": "もうひとつは、心配な点です。"}, {"type": "subtitle", "time": 1648.789, "timestamp": "00:27:28", "text": "だから私は知らないよ 普通の人"}, {"type": "subtitle", "time": 1651.029, "timestamp": "00:27:31", "text": "共有しない"}, {"type": "subtitle", "time": 1654.789, "timestamp": "00:27:34", "text": "彼らが私生活でやっていること"}, {"type": "subtitle", "time": 1658.39, "timestamp": "00:27:38", "text": "今。ああ、その間違いを犯したと思う"}, {"type": "subtitle", "time": 1660.39, "timestamp": "00:27:40", "text": "でも大丈夫、私たちは"}, {"type": "subtitle", "time": 1664.95, "timestamp": "00:27:44", "text": "今は間違いがありますが、こんにちは、ようこそ。"}, {"type": "subtitle", "time": 1668.789, "timestamp": "00:27:48", "text": "久しぶりですね。人生はどうですか？"}, {"type": "subtitle", "time": 1670.87, "timestamp": "00:27:50", "text": "こんばんは。"}, {"type": "subtitle", "time": 1673.83, "timestamp": "00:27:53", "text": "おめでとう。何を待つんですか?による"}, {"type": "subtitle", "time": 1675.35, "timestamp": "00:27:55", "text": "私もストリーミングを始めたので"}, {"type": "subtitle", "time": 1678.63, "timestamp": "00:27:58", "text": "ビデオを作る。ああ、よかった、よかった、よかった。"}]
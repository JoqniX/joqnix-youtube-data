[{"type": "subtitle", "time": 13381.429, "timestamp": "03:43:01", "text": "4つ。数字を忘れてしまいました。 [笑い]"}, {"type": "subtitle", "time": 13386.55, "timestamp": "03:43:06", "text": "これは私がライブ配信しているときに"}, {"type": "subtitle", "time": 13390.309, "timestamp": "03:43:10", "text": "私がどの[音楽]カテゴリーに属しているかを確認します"}, {"type": "subtitle", "time": 13394.469, "timestamp": "03:43:14", "text": "現在ストリーミングしている"}, {"type": "subtitle", "time": 13398.389, "timestamp": "03:43:18", "text": "そのカテゴリからのストリーム。"}, {"type": "subtitle", "time": 13400.71, "timestamp": "03:43:20", "text": "だから、アークレイダーズをプレイしていて、"}, {"type": "subtitle", "time": 13404.55, "timestamp": "03:43:24", "text": "休憩中はVODを再生します"}, {"type": "subtitle", "time": 13407.269, "timestamp": "03:43:27", "text": "ランダム化されたクリエイターのプレイリスト"}, {"type": "subtitle", "time": 13410.15, "timestamp": "03:43:30", "text": "時間とともにストリームに表示されます"}, {"type": "subtitle", "time": 13413.67, "timestamp": "03:43:33", "text": "それ。これがバージョン3です。"}, {"type": "subtitle", "time": 13418.229, "timestamp": "03:43:38", "text": "そして私はあるアイデアを思いつきました。再利用したい"}, {"type": "subtitle", "time": 13421.11, "timestamp": "03:43:41", "text": "私の場合はバージョン 1 とバージョン 2 が好きです。"}, {"type": "subtitle", "time": 13423.429, "timestamp": "03:43:43", "text": "それはランダムな賞のようなものでした"}, {"type": "subtitle", "time": 13427.51, "timestamp": "03:43:47", "text": "あれですよね？そこで私がしたのは"}, {"type": "subtitle", "time": 13431.11, "timestamp": "03:43:51", "text": "ストリーミングしていないとき"}, {"type": "subtitle", "time": 13434.63, "timestamp": "03:43:54", "text": "Twitchで配信していないときは"}]
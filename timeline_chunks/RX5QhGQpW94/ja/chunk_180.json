[{"type": "subtitle", "time": 10800.79, "timestamp": "03:00:00", "text": "時々。そうだね、チャットは空になるよ"}, {"type": "subtitle", "time": 10803.03, "timestamp": "03:00:03", "text": "でも、音楽は大丈夫だよ"}, {"type": "subtitle", "time": 10805.51, "timestamp": "03:00:05", "text": "ちょっと時間を取って"}, {"type": "subtitle", "time": 10810.79, "timestamp": "03:00:10", "text": "一緒にこれらの瞬間を思い出したり楽しんだりする"}, {"type": "subtitle", "time": 10813.51, "timestamp": "03:00:13", "text": "みんなでグループとして一緒に。それ"}, {"type": "subtitle", "time": 10815.59, "timestamp": "03:00:15", "text": "とても意味がある"}, {"type": "subtitle", "time": 10817.67, "timestamp": "03:00:17", "text": "一緒に過ごす瞬間"}, {"type": "subtitle", "time": 10820.389, "timestamp": "03:00:20", "text": "みんなでグループになって。それ"}, {"type": "subtitle", "time": 10822.63, "timestamp": "03:00:22", "text": "私にとっては大きな意味があります。必要ないと思う"}, {"type": "subtitle", "time": 10826.469, "timestamp": "03:00:26", "text": "この時点で最後のスポット。"}, {"type": "subtitle", "time": 10830.79, "timestamp": "03:00:30", "text": "グループとして一緒にいれば十分です。"}, {"type": "subtitle", "time": 10834.95, "timestamp": "03:00:34", "text": "ああ、そうだと思う"}, {"type": "subtitle", "time": 10837.269, "timestamp": "03:00:37", "text": "それで十分なはずです。"}, {"type": "subtitle", "time": 10838.79, "timestamp": "03:00:38", "text": "私が伝えたいことの一つは"}, {"type": "subtitle", "time": 10848.469, "timestamp": "03:00:48", "text": "それが存在することを知るのは楽しいです。多分"}, {"type": "subtitle", "time": 10851.51, "timestamp": "03:00:51", "text": "いつか誰かが"}]
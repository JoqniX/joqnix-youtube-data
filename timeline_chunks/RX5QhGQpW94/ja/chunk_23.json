[{"type": "subtitle", "time": 1380.71, "timestamp": "00:23:00", "text": "[笑い]"}, {"type": "subtitle", "time": 1384.47, "timestamp": "00:23:04", "text": "一つ一つのことをどうやってやらなければならないのですか?"}, {"type": "subtitle", "time": 1386.87, "timestamp": "00:23:06", "text": "ええと、具体的に必要なのは"}, {"type": "subtitle", "time": 1389.19, "timestamp": "00:23:09", "text": "専門分野ですか？音楽。ええ、たぶん行くでしょう"}, {"type": "subtitle", "time": 1393.19, "timestamp": "00:23:13", "text": "音楽をやる。それで"}, {"type": "subtitle", "time": 1395.029, "timestamp": "00:23:15", "text": "おそらく音楽をやるか"}, {"type": "subtitle", "time": 1399.029, "timestamp": "00:23:19", "text": "文学。わからない。"}, {"type": "subtitle", "time": 1401.83, "timestamp": "00:23:21", "text": "どのような機会が開かれるかによる"}, {"type": "subtitle", "time": 1407.669, "timestamp": "00:23:27", "text": "自分。ええ、バックアッププランはありますよ。私は私は"}, {"type": "subtitle", "time": 1410.31, "timestamp": "00:23:30", "text": "このことを学ぶ。"}, {"type": "subtitle", "time": 1412.71, "timestamp": "00:23:32", "text": "私は歌が本当に下手ですが"}, {"type": "subtitle", "time": 1414.87, "timestamp": "00:23:34", "text": "歌を学ぶ。"}, {"type": "subtitle", "time": 1417.83, "timestamp": "00:23:37", "text": "えーっと"}, {"type": "subtitle", "time": 1422.63, "timestamp": "00:23:42", "text": "そして音楽が好きです"}, {"type": "subtitle", "time": 1426.87, "timestamp": "00:23:46", "text": "ソフトウェアを使用するような生産"}, {"type": "subtitle", "time": 1430.87, "timestamp": "00:23:50", "text": "デジタルで音楽を作る。いいえ、私は"}, {"type": "subtitle", "time": 1438.31, "timestamp": "00:23:58", "text": "えっと、触ってないからだと思う"}]
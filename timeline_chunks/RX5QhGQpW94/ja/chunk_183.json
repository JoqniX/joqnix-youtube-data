[{"type": "subtitle", "time": 10980.309, "timestamp": "03:03:00", "text": "そして将来何が期待できるか。"}, {"type": "subtitle", "time": 10982.63, "timestamp": "03:03:02", "text": "たくさんあります"}, {"type": "subtitle", "time": 10985.19, "timestamp": "03:03:05", "text": "インタラクティブな要素を24時間365日"}, {"type": "subtitle", "time": 10987.99, "timestamp": "03:03:07", "text": "チャンネル。楽しみにしていてください"}, {"type": "subtitle", "time": 10989.91, "timestamp": "03:03:09", "text": "ご視聴ありがとうございました。取る"}, {"type": "subtitle", "time": 10992.469, "timestamp": "03:03:12", "text": "みんなを気遣う。"}, {"type": "subtitle", "time": 10994.309, "timestamp": "03:03:14", "text": "バイバイ。"}, {"type": "subtitle", "time": 10997.51, "timestamp": "03:03:17", "text": "はい、悪くないですよ。"}, {"type": "subtitle", "time": 11006.07, "timestamp": "03:03:26", "text": "[咳]"}, {"type": "subtitle", "time": 11009.67, "timestamp": "03:03:29", "text": "えっと、悪くないですよね？私は思う"}, {"type": "subtitle", "time": 11031.03, "timestamp": "03:03:51", "text": "でもビデオは必要でしょうか?わからない。私"}, {"type": "subtitle", "time": 11033.51, "timestamp": "03:03:53", "text": "私は黒をたくさんやってきた"}, {"type": "subtitle", "time": 11035.51, "timestamp": "03:03:55", "text": "そして白いもの。私はそうは思わない"}, {"type": "subtitle", "time": 11037.349, "timestamp": "03:03:57", "text": "わかってるよ。"}]
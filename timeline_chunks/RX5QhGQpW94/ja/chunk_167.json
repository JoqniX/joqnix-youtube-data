[{"type": "subtitle", "time": 10023.11, "timestamp": "02:47:03", "text": "しかし、ある意味ではそれは"}, {"type": "subtitle", "time": 10027.59, "timestamp": "02:47:07", "text": "ビデオ。うーん、分かりません。"}, {"type": "subtitle", "time": 10030.389, "timestamp": "02:47:10", "text": "基本的には恋愛再放送チャンネルです。"}, {"type": "subtitle", "time": 10033.03, "timestamp": "02:47:13", "text": "だから、これを載せるべきかどうか分からない"}, {"type": "subtitle", "time": 10036.469, "timestamp": "02:47:16", "text": "一部。わからない。でも大丈夫"}, {"type": "subtitle", "time": 10039.19, "timestamp": "02:47:19", "text": "多くの人が"}, {"type": "subtitle", "time": 10043.03, "timestamp": "02:47:23", "text": "私のコミュニティでは、特定の"}, {"type": "subtitle", "time": 10045.67, "timestamp": "02:47:25", "text": "ストリーム。彼らはいくつかのものを見ることができませんでした"}, {"type": "subtitle", "time": 10048.79, "timestamp": "02:47:28", "text": "誰もが異なるAmazonと"}, {"type": "subtitle", "time": 10052.309, "timestamp": "02:47:32", "text": "また、今年2026年4月に私は"}, {"type": "subtitle", "time": 10055.51, "timestamp": "02:47:35", "text": "日本。つまり起業家です。"}, {"type": "subtitle", "time": 10057.429, "timestamp": "02:47:37", "text": "わかった。これが私の主な理由です"}, {"type": "subtitle", "time": 10060.15, "timestamp": "02:47:40", "text": "戦争チャンネルを戦争ではないものにする"}, {"type": "subtitle", "time": 10062.71, "timestamp": "02:47:42", "text": "24時間365日のチャネル。"}, {"type": "subtitle", "time": 10066.63, "timestamp": "02:47:46", "text": "私の家族がそうしないことを祈りましょう"}, {"type": "subtitle", "time": 10070.63, "timestamp": "02:47:50", "text": "自宅のパソコンで何かおかしなことが起こりました。"}, {"type": "subtitle", "time": 10073.35, "timestamp": "02:47:53", "text": "あなたが見ているこの PC です。"}, {"type": "subtitle", "time": 10075.51, "timestamp": "02:47:55", "text": "[笑い] まあ、それが長く続くことを祈りましょう"}, {"type": "subtitle", "time": 10077.03, "timestamp": "02:47:57", "text": "一年。"}]
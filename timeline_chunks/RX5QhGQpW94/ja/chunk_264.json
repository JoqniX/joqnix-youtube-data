[{"type": "subtitle", "time": 15847.83, "timestamp": "04:24:07", "text": "私は偶然このことを知りました"}, {"type": "subtitle", "time": 15849.75, "timestamp": "04:24:09", "text": "ツイッター。"}, {"type": "subtitle", "time": 15859.189, "timestamp": "04:24:19", "text": "そしてそこにアカウントを作ったと思います。"}, {"type": "subtitle", "time": 15862.149, "timestamp": "04:24:22", "text": "それが私が"}, {"type": "subtitle", "time": 15869.11, "timestamp": "04:24:29", "text": "実際に計算すると"}, {"type": "subtitle", "time": 15872.71, "timestamp": "04:24:32", "text": "私からあなたに読むことを勧めました。つまり"}, {"type": "subtitle", "time": 15875.75, "timestamp": "04:24:35", "text": "とてもクール。"}, {"type": "subtitle", "time": 15877.429, "timestamp": "04:24:37", "text": "おお。"}, {"type": "subtitle", "time": 15888.389, "timestamp": "04:24:48", "text": "[咳払い] 私は自分の"}, {"type": "subtitle", "time": 15890.87, "timestamp": "04:24:50", "text": "私が取り組んでいる新しい世界と"}, {"type": "subtitle", "time": 15895.189, "timestamp": "04:24:55", "text": "試練に耐える。ああ、いいですね。ニース。"}]
[{"type": "subtitle", "time": 7146.31, "timestamp": "01:59:06", "text": "あのね？私はやり直すつもりです"}, {"type": "subtitle", "time": 7149.51, "timestamp": "01:59:09", "text": "取る。わかった。 1秒。"}, {"type": "subtitle", "time": 7169.91, "timestamp": "01:59:29", "text": "うん。そして、それが何に関するものではないのか。うん。"}, {"type": "subtitle", "time": 7173.632, "timestamp": "01:59:33", "text": "それは私が書かなければならないことです。"}, {"type": "subtitle", "time": 7175.189, "timestamp": "01:59:35", "text": "[咳]"}, {"type": "subtitle", "time": 7178.229, "timestamp": "01:59:38", "text": "視聴者は何を期待すべきでしょうか?なぜそれが"}, {"type": "subtitle", "time": 7181.99, "timestamp": "01:59:41", "text": "あなたにとってはまだ重要です。"}, {"type": "subtitle", "time": 7187.91, "timestamp": "01:59:47", "text": "つまり、基本的には5になります"}, {"type": "subtitle", "time": 7189.669, "timestamp": "01:59:49", "text": "1 分間のビデオ。それでおしまい。走らないで。"}, {"type": "subtitle", "time": 7192.47, "timestamp": "01:59:52", "text": "邪魔しないでください。わかりました。えっと、説明しないで"}, {"type": "subtitle", "time": 7199.03, "timestamp": "01:59:59", "text": "あのね？私はただ続けるつもりです"}]
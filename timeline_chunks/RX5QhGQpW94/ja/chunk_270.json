[{"type": "subtitle", "time": 16201.99, "timestamp": "04:30:01", "text": "ああ、私は何をしているんだろう？私は"}, {"type": "subtitle", "time": 16203.59, "timestamp": "04:30:03", "text": "ナッツ"}, {"type": "subtitle", "time": 16207.11, "timestamp": "04:30:07", "text": "あれですよね？これ。"}, {"type": "subtitle", "time": 16209.83, "timestamp": "04:30:09", "text": "クソはどこだ？彼は昨日それをリリースした"}, {"type": "subtitle", "time": 16212.79, "timestamp": "04:30:12", "text": "これより上。待って。いや、いや、待って。どこ"}, {"type": "subtitle", "time": 16214.55, "timestamp": "04:30:14", "text": "それは？"}, {"type": "subtitle", "time": 16216.87, "timestamp": "04:30:16", "text": "マルチトラック"}, {"type": "subtitle", "time": 16218.87, "timestamp": "04:30:18", "text": "ビデオ デミキサー スクリプト。うん。だから私は"}, {"type": "subtitle", "time": 16221.429, "timestamp": "04:30:21", "text": "これをダウンロードしてください。"}, {"type": "subtitle", "time": 16224.389, "timestamp": "04:30:24", "text": "2つの別々のビデオに変換されます"}, {"type": "subtitle", "time": 16225.83, "timestamp": "04:30:25", "text": "とか。そうすれば入れられる"}, {"type": "subtitle", "time": 16231.75, "timestamp": "04:30:31", "text": "Dainci なら編集できます。うん。"}, {"type": "subtitle", "time": 16234.07, "timestamp": "04:30:34", "text": "何を作ってるんですか？それで、私たちは、ええと、私は作りました"}, {"type": "subtitle", "time": 16237.91, "timestamp": "04:30:37", "text": "24時間365日対応のアプリを作ったチュートリアルのようなもの"}, {"type": "subtitle", "time": 16240.71, "timestamp": "04:30:40", "text": "チャネル。えっと、ちょっと待ってください。OBS を確認させてください。"}, {"type": "subtitle", "time": 16243.429, "timestamp": "04:30:43", "text": "ライブですか？"}, {"type": "subtitle", "time": 16247.51, "timestamp": "04:30:47", "text": "はい、ライブです。 24時間365日"}, {"type": "subtitle", "time": 16250.87, "timestamp": "04:30:50", "text": "チャネル。 Twitchにもあります。"}, {"type": "subtitle", "time": 16254.149, "timestamp": "04:30:54", "text": "ええと、Jox247"}, {"type": "subtitle", "time": 16256.55, "timestamp": "04:30:56", "text": "そして"}, {"type": "subtitle", "time": 16258.55, "timestamp": "04:30:58", "text": "それでこんにちは、ベーコン、[咳払い]"}]
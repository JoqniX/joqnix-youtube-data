[{"type": "subtitle", "time": 3960.789, "timestamp": "01:06:00", "text": "システムをより良くします。"}, {"type": "subtitle", "time": 3963.19, "timestamp": "01:06:03", "text": "私は先生ストリームにいます。チャットしたかった"}, {"type": "subtitle", "time": 3966.715, "timestamp": "01:06:06", "text": "あなたも一緒に。ああ、カフェです。"}, {"type": "subtitle", "time": 3968.39, "timestamp": "01:06:08", "text": "[笑い]"}, {"type": "subtitle", "time": 3975.91, "timestamp": "01:06:15", "text": "そうですね、そんな感じです。そして私は"}, {"type": "subtitle", "time": 3978.47, "timestamp": "01:06:18", "text": "リンクとマージの作業を行う必要があります。それで、"}, {"type": "subtitle", "time": 3980.549, "timestamp": "01:06:20", "text": "リンガンマージは管理者のようになります"}, {"type": "subtitle", "time": 3983.27, "timestamp": "01:06:23", "text": "指示。だから感嘆符を使わなければならない"}, {"type": "subtitle", "time": 3989.43, "timestamp": "01:06:29", "text": "ポイントは管理者のマージで、リンクできます"}, {"type": "subtitle", "time": 3992.549, "timestamp": "01:06:32", "text": "例えば"}, {"type": "subtitle", "time": 4001.51, "timestamp": "01:06:41", "text": "Twitchでチャットすると入力できます"}, {"type": "subtitle", "time": 4005.829, "timestamp": "01:06:45", "text": "感嘆符 ええと 管理者 マージ そして 私 私"}, {"type": "subtitle", "time": 4008.23, "timestamp": "01:06:48", "text": "このようにする"}, {"type": "subtitle", "time": 4010.549, "timestamp": "01:06:50", "text": "レジストリファイルをお見せしましょう"}, {"type": "subtitle", "time": 4012.309, "timestamp": "01:06:52", "text": "まあ、こうして書かざるを得ないわけです。"}, {"type": "subtitle", "time": 4016.87, "timestamp": "01:06:56", "text": "Twitch ID を Twitch にコロンします。"}]
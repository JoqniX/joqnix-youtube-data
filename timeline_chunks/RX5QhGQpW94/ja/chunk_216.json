[{"type": "subtitle", "time": 12961.67, "timestamp": "03:36:01", "text": "私のYouTubeのリストを載せる"}, {"type": "subtitle", "time": 12965.349, "timestamp": "03:36:05", "text": "私が紹介したいストリームと"}, {"type": "subtitle", "time": 12970.309, "timestamp": "03:36:10", "text": "このリストをランダム化する"}, {"type": "subtitle", "time": 12973.03, "timestamp": "03:36:13", "text": "そして[音楽]は"}, {"type": "subtitle", "time": 12975.99, "timestamp": "03:36:15", "text": "ランダムな期間のようなタイムスタンプ。それで"}, {"type": "subtitle", "time": 12980.469, "timestamp": "03:36:20", "text": "これは私が切り替えるたびに"}, {"type": "subtitle", "time": 12982.15, "timestamp": "03:36:22", "text": "ランダム"}, {"type": "subtitle", "time": 12984.79, "timestamp": "03:36:24", "text": "えっと、つまり私が"}, {"type": "subtitle", "time": 12988.07, "timestamp": "03:36:28", "text": "シーンを無効にしたり、眠っているシーンをオンにしたり"}, {"type": "subtitle", "time": 12988.95, "timestamp": "03:36:28", "text": "OBS、[音楽]"}, {"type": "subtitle", "time": 12992.229, "timestamp": "03:36:32", "text": "ランダムにYouTube動画が再生される"}, {"type": "subtitle", "time": 12995.19, "timestamp": "03:36:35", "text": "私のYouTubeチャンネルからランダムに"}, {"type": "subtitle", "time": 12998.55, "timestamp": "03:36:38", "text": "タイムスタンプ。それが最初の"}, {"type": "subtitle", "time": 13001.349, "timestamp": "03:36:41", "text": "このセットアップの反復 [音楽]"}, {"type": "subtitle", "time": 13003.349, "timestamp": "03:36:43", "text": "存在した。"}, {"type": "subtitle", "time": 13005.83, "timestamp": "03:36:45", "text": "それから"}, {"type": "subtitle", "time": 13009.429, "timestamp": "03:36:49", "text": "私がジョッカソンイベントをやったとき"}, {"type": "subtitle", "time": 13013.11, "timestamp": "03:36:53", "text": "それはサバソンかドーナツソンのイベントでした"}, {"type": "subtitle", "time": 13018.55, "timestamp": "03:36:58", "text": "24時間配信することにした"}]
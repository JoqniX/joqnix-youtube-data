[{"type": "subtitle", "time": 4622.709, "timestamp": "01:17:02", "text": "すぐに修正させてください。いや、やめて"}, {"type": "subtitle", "time": 4624.55, "timestamp": "01:17:04", "text": "気にしないでください。私とチャットするだけでも大丈夫です。"}, {"type": "subtitle", "time": 4626.79, "timestamp": "01:17:06", "text": "画面を気にしないでください。無視してもいい"}, {"type": "subtitle", "time": 4629.43, "timestamp": "01:17:09", "text": "画面。私の声を聞いて"}, {"type": "subtitle", "time": 4632.87, "timestamp": "01:17:12", "text": "ただ私とチャットしてください。えっと、もしあなたが"}, {"type": "subtitle", "time": 4635.03, "timestamp": "01:17:15", "text": "画面が技術的すぎるので、"}, {"type": "subtitle", "time": 4637.11, "timestamp": "01:17:17", "text": "心配しないで。"}, {"type": "subtitle", "time": 4644.79, "timestamp": "01:17:24", "text": "えっと、今日のストリームはRX5です。"}, {"type": "subtitle", "time": 4648.229, "timestamp": "01:17:28", "text": "これを削除しなければなりません。"}, {"type": "subtitle", "time": 4649.669, "timestamp": "01:17:29", "text": "えーっと（ため息）"}, {"type": "subtitle", "time": 4651.75, "timestamp": "01:17:31", "text": "いいえ、これに約"}, {"type": "subtitle", "time": 4653.669, "timestamp": "01:17:33", "text": "YouTube ボタン。いいえ。わかりました。"}, {"type": "subtitle", "time": 4656.55, "timestamp": "01:17:36", "text": "この期間。 YouTube API"}, {"type": "subtitle", "time": 4658.95, "timestamp": "01:17:38", "text": "ライブフェッチ進行中 今後のフェッチ"}, {"type": "subtitle", "time": 4661.51, "timestamp": "01:17:41", "text": "メインマップ ストリーム レジストリが完了しました。私"}, {"type": "subtitle", "time": 4665.43, "timestamp": "01:17:45", "text": "これに3ヶ月を費やしました。完成しました"}, {"type": "subtitle", "time": 4670.149, "timestamp": "01:17:50", "text": "先月、ええと先月25日頃"}, {"type": "subtitle", "time": 4672.55, "timestamp": "01:17:52", "text": "1月の。"}, {"type": "subtitle", "time": 4676.07, "timestamp": "01:17:56", "text": "やっと完成しました。 Discord API"}, {"type": "subtitle", "time": 4679.189, "timestamp": "01:17:59", "text": "物も良いです。でも、たとえ私が行っても"}]
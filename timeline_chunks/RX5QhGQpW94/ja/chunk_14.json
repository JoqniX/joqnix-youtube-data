[{"type": "subtitle", "time": 843.189, "timestamp": "00:14:03", "text": "いとこの叔父とアンディと私の家族。"}, {"type": "subtitle", "time": 846.71, "timestamp": "00:14:06", "text": "うん。何てことだ。どこへ行くの？えっと、私は"}, {"type": "subtitle", "time": 855.59, "timestamp": "00:14:15", "text": "私は、ええと、私は"}, {"type": "subtitle", "time": 858.629, "timestamp": "00:14:18", "text": "前回あなたが来たとき、私たちは話をしました"}, {"type": "subtitle", "time": 861.99, "timestamp": "00:14:21", "text": "これについて。忘れましたか？"}, {"type": "subtitle", "time": 864.71, "timestamp": "00:14:24", "text": "前回来た時は"}, {"type": "subtitle", "time": 867.03, "timestamp": "00:14:27", "text": "それには時間があります。えっと、4月、4月"}, {"type": "subtitle", "time": 869.829, "timestamp": "00:14:29", "text": "1、私はそこに行きます。うん。えっと、私は"}, {"type": "subtitle", "time": 875.35, "timestamp": "00:14:35", "text": "2月と3月の半ば、終わり頃"}, {"type": "subtitle", "time": 879.59, "timestamp": "00:14:39", "text": "3月になりました。うん。うん。だから私が"}, {"type": "subtitle", "time": 882.79, "timestamp": "00:14:42", "text": "出発の準備をする"}, {"type": "subtitle", "time": 887.75, "timestamp": "00:14:47", "text": "1年くらいかかるでしょう。いやいや、"}, {"type": "subtitle", "time": 889.35, "timestamp": "00:14:49", "text": "いや、いや、いや。今年行きます"}, {"type": "subtitle", "time": 891.75, "timestamp": "00:14:51", "text": "おそらく。わからない。それは確認されていない"}, {"type": "subtitle", "time": 895.59, "timestamp": "00:14:55", "text": "まだ。来週までに確認が取れます。"}, {"type": "subtitle", "time": 899.67, "timestamp": "00:14:59", "text": "ええ、来週です。ええと来週か​​16日"}]
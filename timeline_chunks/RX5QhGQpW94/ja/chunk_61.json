[{"type": "subtitle", "time": 3662.23, "timestamp": "01:01:02", "text": "少なくとも1ヶ月分は"}, {"type": "subtitle", "time": 3665.99, "timestamp": "01:01:05", "text": "賞のためだと思います。だから私は"}, {"type": "subtitle", "time": 3668.23, "timestamp": "01:01:08", "text": "そのように説明できると思います。私"}, {"type": "subtitle", "time": 3670.87, "timestamp": "01:01:10", "text": "正しく考えなさい。"}, {"type": "subtitle", "time": 3672.15, "timestamp": "01:01:12", "text": "えーっと（ため息）"}, {"type": "subtitle", "time": 3676.309, "timestamp": "01:01:16", "text": "ほかに何か？えっと、準備ができていません。"}, {"type": "subtitle", "time": 3679.349, "timestamp": "01:01:19", "text": "これはまずい。私はチュートリアルを決してやりません。その"}, {"type": "subtitle", "time": 3681.91, "timestamp": "01:01:21", "text": "複雑すぎる。それで、これが"}, {"type": "subtitle", "time": 3684.39, "timestamp": "01:01:24", "text": "次のようになります。これが私のすべてのビデオです"}, {"type": "subtitle", "time": 3687.19, "timestamp": "01:01:27", "text": "YouTubeでやりました。それで、"}, {"type": "subtitle", "time": 3692.309, "timestamp": "01:01:32", "text": "1K のビデオがいくつあると思いますか。えーっと"}, {"type": "subtitle", "time": 3696.71, "timestamp": "01:01:36", "text": "つまり、これは1,000のビデオIDごとに"}, {"type": "subtitle", "time": 3699.99, "timestamp": "01:01:39", "text": "YouTubeショットを除くストリームと"}, {"type": "subtitle", "time": 3702.309, "timestamp": "01:01:42", "text": "ビデオ"}, {"type": "subtitle", "time": 3705.03, "timestamp": "01:01:45", "text": "ええと、過去の放送すべてライブストリームのみ"}, {"type": "subtitle", "time": 3710.23, "timestamp": "01:01:50", "text": "それは整理されたオブジェクトにあります。"}, {"type": "subtitle", "time": 3714.309, "timestamp": "01:01:54", "text": "うん。うん。フォーマットを確認してください。うん。"}, {"type": "subtitle", "time": 3716.71, "timestamp": "01:01:56", "text": "そういうことです。わかった。"}, {"type": "subtitle", "time": 3719.67, "timestamp": "01:01:59", "text": "ああ、そして"}]
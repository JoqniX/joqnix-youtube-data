[{"type": "subtitle", "time": 1921.43, "timestamp": "00:32:01", "text": "すべて。そして彼らはあなたに提供します"}, {"type": "subtitle", "time": 1927.029, "timestamp": "00:32:07", "text": "インタビューを受ける機会"}, {"type": "subtitle", "time": 1929.43, "timestamp": "00:32:09", "text": "他の学校"}, {"type": "subtitle", "time": 1932.389, "timestamp": "00:32:12", "text": "日本国内では"}, {"type": "subtitle", "time": 1936.71, "timestamp": "00:32:16", "text": "リングアップとタイアップ、そうですよね？そして"}, {"type": "subtitle", "time": 1940.87, "timestamp": "00:32:20", "text": "ええ、そしてええと、あなたが通過した後"}, {"type": "subtitle", "time": 1942.549, "timestamp": "00:32:22", "text": "インタビュー"}, {"type": "subtitle", "time": 1943.99, "timestamp": "00:32:23", "text": "えーと [咳払い]"}, {"type": "subtitle", "time": 1947.75, "timestamp": "00:32:27", "text": "えっと、えっと、できるための要件みたいな"}, {"type": "subtitle", "time": 1949.83, "timestamp": "00:32:29", "text": "日本の語学学校に通う"}, {"type": "subtitle", "time": 1953.509, "timestamp": "00:32:33", "text": "ある程度の時間が必要なようです"}, {"type": "subtitle", "time": 1957.35, "timestamp": "00:32:37", "text": "300時間も勉強すれば"}, {"type": "subtitle", "time": 1959.19, "timestamp": "00:32:39", "text": "ラン"}, {"type": "subtitle", "time": 1961.909, "timestamp": "00:32:41", "text": "地域内の日本語レベル"}, {"type": "subtitle", "time": 1965.43, "timestamp": "00:32:45", "text": "その証明書を発行する"}, {"type": "subtitle", "time": 1968.31, "timestamp": "00:32:48", "text": "えっと、そのレベルの合格証書です。のために"}, {"type": "subtitle", "time": 1972.389, "timestamp": "00:32:52", "text": "例えば私の場合、N5 NLPに合格しました"}, {"type": "subtitle", "time": 1975.75, "timestamp": "00:32:55", "text": "N5ですよね？つまり、最低限の要件は"}, {"type": "subtitle", "time": 1979.669, "timestamp": "00:32:59", "text": "N5 N4の方が優れています。では他には何がありますか?ええ、私は"}]
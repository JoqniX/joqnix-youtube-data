[{"type": "subtitle", "time": 1681.59, "timestamp": "00:28:01", "text": "さあ行こう。"}, {"type": "subtitle", "time": 1683.59, "timestamp": "00:28:03", "text": "元気ですか？元気ですよ。ちょうど来た"}, {"type": "subtitle", "time": 1688.31, "timestamp": "00:28:08", "text": "今日は休暇を終えて家に帰って来ました。"}, {"type": "subtitle", "time": 1689.75, "timestamp": "00:28:09", "text": "まあ、あなたは心配していると思います"}, {"type": "subtitle", "time": 1692.63, "timestamp": "00:28:12", "text": "側。はい、心配しないでください。私も"}, {"type": "subtitle", "time": 1696.07, "timestamp": "00:28:16", "text": "自分の持ち物について心配しています。今、"}, {"type": "chat", "time": 1698.126, "timestamp": "00:28:18", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "u r going to Japan soon"}, {"type": "subtitle", "time": 1698.87, "timestamp": "00:28:18", "text": "ほら、私は一人じゃない。いや、たとえ私が行くとしても"}, {"type": "subtitle", "time": 1701.51, "timestamp": "00:28:21", "text": "私が持っていない国へ"}, {"type": "subtitle", "time": 1703.51, "timestamp": "00:28:23", "text": "私を守り、救ってくれる人は誰もいない"}, {"type": "subtitle", "time": 1707.35, "timestamp": "00:28:27", "text": "自分の場所にあるもの"}, {"type": "subtitle", "time": 1709.83, "timestamp": "00:28:29", "text": "そして私の家族はそこにいます、ええと人々、友人"}, {"type": "subtitle", "time": 1711.59, "timestamp": "00:28:31", "text": "いとこはいますか？みんないますか？"}, {"type": "subtitle", "time": 1715.669, "timestamp": "00:28:35", "text": "ええと、でも私は一人じゃないわ"}, {"type": "subtitle", "time": 1719.43, "timestamp": "00:28:39", "text": "私は良い友達を作った"}, {"type": "subtitle", "time": 1721.35, "timestamp": "00:28:41", "text": "日本人はインド人が好きで、"}, {"type": "subtitle", "time": 1726.23, "timestamp": "00:28:46", "text": "好きな人や信頼できる人"}, {"type": "subtitle", "time": 1729.11, "timestamp": "00:28:49", "text": "何かが起こると、私は迷ったり混乱したりします"}, {"type": "subtitle", "time": 1732.87, "timestamp": "00:28:52", "text": "彼らに連絡できるものなら何でも"}, {"type": "subtitle", "time": 1737.669, "timestamp": "00:28:57", "text": "すべてとええ、クラスメートたちよ"}, {"type": "subtitle", "time": 1739.99, "timestamp": "00:28:59", "text": "日本の学校の同級生たちも"}]
[{"type": "subtitle", "time": 11055.862, "timestamp": "03:04:15", "text": "ドローンオーバーレイ。これは何ですか？わかった。えーっと、"}, {"type": "subtitle", "time": 11056.469, "timestamp": "03:04:16", "text": "[咳払い]"}, {"type": "subtitle", "time": 11059.83, "timestamp": "03:04:19", "text": "夜間視力。くそ。わかった。えっと、私は何者ですか"}, {"type": "subtitle", "time": 11070.309, "timestamp": "03:04:30", "text": "輪郭、化粧品、雲、"}, {"type": "subtitle", "time": 11072.71, "timestamp": "03:04:32", "text": "無地、"}, {"type": "subtitle", "time": 11087.269, "timestamp": "03:04:47", "text": "ええ、フルカラーがいいですね"}]
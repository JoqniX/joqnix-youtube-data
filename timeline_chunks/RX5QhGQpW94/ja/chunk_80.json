[{"type": "subtitle", "time": 4809.27, "timestamp": "01:20:09", "text": "なぜ人口が増えないのですか?"}, {"type": "subtitle", "time": 4826.47, "timestamp": "01:20:26", "text": "いいえ。"}, {"type": "subtitle", "time": 4837.43, "timestamp": "01:20:37", "text": "ああ、あなたはワールドオブをプレイしています"}, {"type": "subtitle", "time": 4840.149, "timestamp": "01:20:40", "text": "ウォークラフト。あなたは現実ではいたずらっ子ですか?私はしません"}, {"type": "subtitle", "time": 4843.27, "timestamp": "01:20:43", "text": "知る。私は技術的なものが好きです"}, {"type": "subtitle", "time": 4846.39, "timestamp": "01:20:46", "text": "ものやその他すべて。楽しいですね。"}, {"type": "subtitle", "time": 4856.07, "timestamp": "01:20:56", "text": "自分はオタクだとは思わない。"}]
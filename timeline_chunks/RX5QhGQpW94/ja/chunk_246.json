[{"type": "subtitle", "time": 14761.59, "timestamp": "04:06:01", "text": "これらすべてが一度だけリセットされる"}, {"type": "subtitle", "time": 14764.95, "timestamp": "04:06:04", "text": "プレイリストは"}, {"type": "subtitle", "time": 14768.55, "timestamp": "04:06:08", "text": "自動的に再生されます。"}, {"type": "subtitle", "time": 14772.469, "timestamp": "04:06:12", "text": "これらすべてが"}, {"type": "subtitle", "time": 14777.03, "timestamp": "04:06:17", "text": "ストリームはこれらのプレイリストは"}, {"type": "subtitle", "time": 14781.189, "timestamp": "04:06:21", "text": "少なくとも1回はプレイしました。つまり、すべて"}, {"type": "subtitle", "time": 14784.469, "timestamp": "04:06:24", "text": "これらはプレイリストとして使用されています"}, {"type": "subtitle", "time": 14788.389, "timestamp": "04:06:28", "text": "この物件が好きなのは"}, {"type": "subtitle", "time": 14791.269, "timestamp": "04:06:31", "text": "ここにあるすべてのアイテムは"}, {"type": "subtitle", "time": 14793.99, "timestamp": "04:06:33", "text": "幾つか"}, {"type": "subtitle", "time": 14795.51, "timestamp": "04:06:35", "text": "131"}, {"type": "subtitle", "time": 14799.03, "timestamp": "04:06:39", "text": "ランダムなものを一度だけ除外する"}, {"type": "subtitle", "time": 14804.55, "timestamp": "04:06:44", "text": "131のプレイリストがみんなに"}, {"type": "subtitle", "time": 14809.11, "timestamp": "04:06:49", "text": "チェックマークは使用済みのように消えています"}, {"type": "subtitle", "time": 14810.309, "timestamp": "04:06:50", "text": "チェック済み"}, {"type": "subtitle", "time": 14813.349, "timestamp": "04:06:53", "text": "そうすることで初めて完全なリセットが行われます。"}, {"type": "subtitle", "time": 14817.429, "timestamp": "04:06:57", "text": "私がここでやったのはこれです。それで"}]
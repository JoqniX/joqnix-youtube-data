[{"type": "subtitle", "time": 15120.229, "timestamp": "04:12:00", "text": "[音楽] 同じものを持たなければならない"}, {"type": "subtitle", "time": 15122.55, "timestamp": "04:12:02", "text": "私が持っているセットアップ。私はそうしなければならないと思う"}, {"type": "subtitle", "time": 15135.91, "timestamp": "04:12:15", "text": "でもサミーをどこかに走らせないといけないので"}, {"type": "subtitle", "time": 15142.309, "timestamp": "04:12:22", "text": "OBSも実行する必要があるので"}, {"type": "subtitle", "time": 15145.91, "timestamp": "04:12:25", "text": "物事を正しく行う。"}, {"type": "subtitle", "time": 15151.11, "timestamp": "04:12:31", "text": "そうですね、ある意味私は"}, {"type": "subtitle", "time": 15155.189, "timestamp": "04:12:35", "text": "今すぐクラウドをセットアップするか、"}, {"type": "subtitle", "time": 15159.189, "timestamp": "04:12:39", "text": "遠い将来にのみそれを行ってください。もしこれが"}, {"type": "subtitle", "time": 15161.59, "timestamp": "04:12:41", "text": "これをテストする私の実験"}, {"type": "subtitle", "time": 15164.55, "timestamp": "04:12:44", "text": "常時24時間365日のチャネルシステム、"}, {"type": "subtitle", "time": 15166.15, "timestamp": "04:12:46", "text": "すべて [音楽]"}, {"type": "subtitle", "time": 15168.15, "timestamp": "04:12:48", "text": "それがどうなるか、すべて見てみましょう。もし"}, {"type": "subtitle", "time": 15170.15, "timestamp": "04:12:50", "text": "全てがうまくいけば、私は満足する"}, {"type": "subtitle", "time": 15173.51, "timestamp": "04:12:53", "text": "私は本当に切り替えたいと思っています"}, {"type": "subtitle", "time": 15175.51, "timestamp": "04:12:55", "text": "クラウド設定なので心配する必要はありません"}, {"type": "subtitle", "time": 15179.429, "timestamp": "04:12:59", "text": "それについて。そして、うーん"}]
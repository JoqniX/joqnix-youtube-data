[{"type": "subtitle", "time": 2285.03, "timestamp": "00:38:05", "text": "わかった。 [ため息と息切れ]"}, {"type": "subtitle", "time": 2287.829, "timestamp": "00:38:07", "text": "ハイドレートありがとうございます。"}, {"type": "subtitle", "time": 2290.39, "timestamp": "00:38:10", "text": "水を持ってきます。私は本当に"}, {"type": "subtitle", "time": 2294.23, "timestamp": "00:38:14", "text": "今日は喉が痛いです。"}, {"type": "subtitle", "time": 2300.31, "timestamp": "00:38:20", "text": "[咳払い]"}, {"type": "subtitle", "time": 2303.27, "timestamp": "00:38:23", "text": "でも、全身検査は受けたよ"}, {"type": "subtitle", "time": 2305.349, "timestamp": "00:38:25", "text": "調べる、"}, {"type": "subtitle", "time": 2308.15, "timestamp": "00:38:28", "text": "そして医者は私は大丈夫だと言いました。私は"}, {"type": "subtitle", "time": 2311.91, "timestamp": "00:38:31", "text": "いいえ、私はこれを持っています"}, {"type": "subtitle", "time": 2315.27, "timestamp": "00:38:35", "text": "ハウスダストアレルギーの問題。私はくしゃみをし続けて"}, {"type": "subtitle", "time": 2319.349, "timestamp": "00:38:39", "text": "くしゃみが止まらなくて、くしゃみが止まりません。"}, {"type": "subtitle", "time": 2322.31, "timestamp": "00:38:42", "text": "それは痛みです。"}, {"type": "subtitle", "time": 2326.71, "timestamp": "00:38:46", "text": "102. これは何ですか?"}]
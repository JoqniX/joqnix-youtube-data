[{"type": "subtitle", "time": 4441.91, "timestamp": "01:14:01", "text": "ヘルプ。そうそう。うん。これです。これ"}, {"type": "subtitle", "time": 4443.669, "timestamp": "01:14:03", "text": "1つ。これです。これです。うん。うん。"}, {"type": "subtitle", "time": 4446.149, "timestamp": "01:14:06", "text": "うん。うん。うん。"}, {"type": "subtitle", "time": 4449.75, "timestamp": "01:14:09", "text": "この男。うん。うん。うん。うん。わかった。"}, {"type": "subtitle", "time": 4451.35, "timestamp": "01:14:11", "text": "うん。うん。これです。これです。これ"}, {"type": "subtitle", "time": 4454.229, "timestamp": "01:14:14", "text": "1つ。これについては、"}, {"type": "subtitle", "time": 4457.35, "timestamp": "01:14:17", "text": "ビデオも同様です。"}, {"type": "subtitle", "time": 4459.11, "timestamp": "01:14:19", "text": "えーっと"}, {"type": "subtitle", "time": 4461.901, "timestamp": "01:14:21", "text": "ああ、一番上までスクロールしないといけない。"}, {"type": "subtitle", "time": 4462.556, "timestamp": "01:14:22", "text": "[笑い]"}, {"type": "subtitle", "time": 4463.35, "timestamp": "01:14:23", "text": "[息を呑む]"}, {"type": "subtitle", "time": 4469.189, "timestamp": "01:14:29", "text": "だからこの男は、彼のように"}, {"type": "subtitle", "time": 4472.55, "timestamp": "01:14:32", "text": "YouTubeの動画などのストリームや"}, {"type": "subtitle", "time": 4477.43, "timestamp": "01:14:37", "text": "BRBに乗っているときに表示されるクリップ"}, {"type": "subtitle", "time": 4480.95, "timestamp": "01:14:40", "text": "画面。わかった。だから私はランダムに"}, {"type": "subtitle", "time": 4484.709, "timestamp": "01:14:44", "text": "2023年のような日がこのあたりだと思う"}, {"type": "subtitle", "time": 4488.63, "timestamp": "01:14:48", "text": "私は他の何かをしていたとき"}, {"type": "subtitle", "time": 4490.95, "timestamp": "01:14:50", "text": "サミーのものを見て、これに出会いました。"}, {"type": "subtitle", "time": 4494.55, "timestamp": "01:14:54", "text": "それで私は「ああ、これはクールだ」と思いました。"}, {"type": "subtitle", "time": 4497.83, "timestamp": "01:14:57", "text": "そして私はこのスレッドをフォローしていました"}]
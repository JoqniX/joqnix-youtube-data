[{"type": "subtitle", "time": 14041.03, "timestamp": "03:54:01", "text": "私の新しいセットアップでは本当に重要です。"}, {"type": "subtitle", "time": 14048.87, "timestamp": "03:54:08", "text": "このボタンは基本的に"}, {"type": "subtitle", "time": 14052.15, "timestamp": "03:54:12", "text": "フィルターを作成してここにこれを作成します"}, {"type": "subtitle", "time": 14055.67, "timestamp": "03:54:15", "text": "[音楽]が"}, {"type": "subtitle", "time": 14059.349, "timestamp": "03:54:19", "text": "作成するか、パッチを適用する必要があります。だからそれは"}, {"type": "subtitle", "time": 14063.83, "timestamp": "03:54:23", "text": "見つからない場合は作成します"}, {"type": "subtitle", "time": 14066.309, "timestamp": "03:54:26", "text": "プレイリストにはない"}, {"type": "subtitle", "time": 14069.75, "timestamp": "03:54:29", "text": "現在のリストを取得するときに、"}, {"type": "subtitle", "time": 14073.51, "timestamp": "03:54:33", "text": "すでに見つかったプレイリスト"}, {"type": "subtitle", "time": 14076.55, "timestamp": "03:54:36", "text": "[音楽]が"}, {"type": "subtitle", "time": 14078.95, "timestamp": "03:54:38", "text": "サムネイルのタイトルが変更されました"}, {"type": "subtitle", "time": 14081.83, "timestamp": "03:54:41", "text": "変更されたか、または[音楽]"}, {"type": "subtitle", "time": 14083.91, "timestamp": "03:54:43", "text": "説明や何かが変わったら"}, {"type": "subtitle", "time": 14086.309, "timestamp": "03:54:46", "text": "パッチリクエストとアップデートを行います"}, {"type": "subtitle", "time": 14088.55, "timestamp": "03:54:48", "text": "そういう感じ。うん。 [音楽] それで"}, {"type": "subtitle", "time": 14091.429, "timestamp": "03:54:51", "text": "作成された水循環同期ボタン"}, {"type": "subtitle", "time": 14096.71, "timestamp": "03:54:56", "text": "動作します。そして、自動アクティブになります。"}]
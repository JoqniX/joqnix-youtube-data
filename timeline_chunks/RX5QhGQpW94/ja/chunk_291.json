[{"type": "subtitle", "time": 17460.23, "timestamp": "04:51:00", "text": "自動的に戦争を評価するようにする"}, {"type": "subtitle", "time": 17463.43, "timestamp": "04:51:03", "text": "えっと、いつもチャンネルオンですよね？"}, {"type": "subtitle", "time": 17471.99, "timestamp": "04:51:11", "text": "仕事が山ほどある。"}, {"type": "subtitle", "time": 17477.99, "timestamp": "04:51:17", "text": "キック？"}, {"type": "subtitle", "time": 17499.11, "timestamp": "04:51:39", "text": "できないよ。奇妙な。わかった。ともかく、"}, {"type": "subtitle", "time": 17502.788, "timestamp": "04:51:42", "text": "ここで終わりにします。"}, {"type": "subtitle", "time": 17505.43, "timestamp": "04:51:45", "text": "皆さんに感謝の気持ちを伝えましょう"}, {"type": "subtitle", "time": 17507.27, "timestamp": "04:51:47", "text": "潜伏し、"}, {"type": "subtitle", "time": 17510.15, "timestamp": "04:51:50", "text": "今日チャットした人がここにいました。ありがとう"}, {"type": "subtitle", "time": 17512.708, "timestamp": "04:51:52", "text": "今日来てくださった皆様。本当に"}, {"type": "subtitle", "time": 17515.75, "timestamp": "04:51:55", "text": "とても大きな意味があります。休暇から戻ってきました。"}]
[{"type": "subtitle", "time": 16020.95, "timestamp": "04:27:00", "text": "ビデオ 今録画したばかりです"}, {"type": "subtitle", "time": 16027.91, "timestamp": "04:27:07", "text": "だから"}, {"type": "subtitle", "time": 16031.11, "timestamp": "04:27:11", "text": "徹底的に調べました。誰もいないような気がする"}, {"type": "subtitle", "time": 16036.87, "timestamp": "04:27:16", "text": "歌のストリーミング配信をしてくれる？"}, {"type": "subtitle", "time": 16039.51, "timestamp": "04:27:19", "text": "また？えーっと"}, {"type": "subtitle", "time": 16041.51, "timestamp": "04:27:21", "text": "いつかそこに"}, {"type": "subtitle", "time": 16044.229, "timestamp": "04:27:24", "text": "たぶん今月。はい、できます。"}, {"type": "subtitle", "time": 16046.63, "timestamp": "04:27:26", "text": "ええ、今月はできるかもしれません。"}, {"type": "subtitle", "time": 16058.229, "timestamp": "04:27:38", "text": "また、今日は多くのバグに直面しました。病気"}, {"type": "subtitle", "time": 16066.67, "timestamp": "04:27:46", "text": "これ以外のものはすべてブロック解除します"}, {"type": "subtitle", "time": 16067.59, "timestamp": "04:27:47", "text": "[笑い]"}, {"type": "subtitle", "time": 16069.59, "timestamp": "04:27:49", "text": "待たなければならなかったのでクリックするだけでいいと思います"}, {"type": "subtitle", "time": 16071.99, "timestamp": "04:27:51", "text": "ブロック解除中。うん。"}, {"type": "subtitle", "time": 16074.55, "timestamp": "04:27:54", "text": "いや、[音楽]エラーがポップアップ表示されないようにしてください。"}, {"type": "subtitle", "time": 16077.269, "timestamp": "04:27:57", "text": "ストリーム外で修正するだけです。"}, {"type": "subtitle", "time": 16079.59, "timestamp": "04:27:59", "text": "そうですね。そうそう。お買い得。あなたは"}]
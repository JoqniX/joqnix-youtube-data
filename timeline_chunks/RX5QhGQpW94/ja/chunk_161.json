[{"type": "subtitle", "time": 9660.55, "timestamp": "02:41:00", "text": "もう一度。それはまるで"}, {"type": "subtitle", "time": 9672.486, "timestamp": "02:41:12", "text": "これで十分でしょうか?私たちが持っているコンテンツ"}, {"type": "subtitle", "time": 9674.79, "timestamp": "02:41:14", "text": "[音楽]で体験し、思い出を作った"}, {"type": "subtitle", "time": 9678.23, "timestamp": "02:41:18", "text": "過去。皆さんに楽しんでもらいたかったんです"}, {"type": "subtitle", "time": 9681.27, "timestamp": "02:41:21", "text": "また。それはまるで私たちが"}, {"type": "subtitle", "time": 9683.349, "timestamp": "02:41:23", "text": "共有しました。覚えてる？"}, {"type": "subtitle", "time": 9685.83, "timestamp": "02:41:25", "text": "彼はYouTuberになりたい人は誰だと言いましたか?おお、"}, {"type": "subtitle", "time": 9688.79, "timestamp": "02:41:28", "text": "あなたでしたか？覚えていると思います。は"}, {"type": "subtitle", "time": 9691.349, "timestamp": "02:41:31", "text": "それは私がいたストリームからではないですか"}, {"type": "subtitle", "time": 9694.07, "timestamp": "02:41:34", "text": "Arc Raidersをプレイしていますか?"}, {"type": "subtitle", "time": 9702.23, "timestamp": "02:41:42", "text": "ああ、わかりました。では他には何がありますか?えーっと、"}, {"type": "subtitle", "time": 9718.87, "timestamp": "02:41:58", "text": "試してみることにも興味がある"}]
[{"type": "subtitle", "time": 377.189, "timestamp": "00:06:17", "text": "えっと皆さんこんにちは。"}, {"type": "subtitle", "time": 379.909, "timestamp": "00:06:19", "text": "私の声が聞こえますか？私の声が聞き取れることを祈ります。"}, {"type": "subtitle", "time": 382.55, "timestamp": "00:06:22", "text": "こんにちは。こんにちは。"}, {"type": "subtitle", "time": 390.469, "timestamp": "00:06:30", "text": "みなさんお元気ですか？こんにちは。"}, {"type": "subtitle", "time": 393.83, "timestamp": "00:06:33", "text": "ああ、ちょっと待って。えーっと、"}, {"type": "subtitle", "time": 395.749, "timestamp": "00:06:35", "text": "今日は[咳払い]"}, {"type": "subtitle", "time": 399.43, "timestamp": "00:06:39", "text": "ストリーミングに戻った後"}, {"type": "subtitle", "time": 402.23, "timestamp": "00:06:42", "text": "休暇。私はバカみたいになっていった"}, {"type": "subtitle", "time": 407.189, "timestamp": "00:06:47", "text": "バックエンドでのエラーの量。そして"}, {"type": "subtitle", "time": 409.369, "timestamp": "00:06:49", "text": "私はこう言いました、「おい、一体何なんだ？」"}, {"type": "subtitle", "time": 410.87, "timestamp": "00:06:50", "text": "[笑い]"}, {"type": "subtitle", "time": 414.609, "timestamp": "00:06:54", "text": "私はたくさんのことをしてきました"}, {"type": "subtitle", "time": 416.87, "timestamp": "00:06:56", "text": "[咳払い] 私はたくさんのことをしてきました"}, {"type": "subtitle", "time": 418.469, "timestamp": "00:06:58", "text": "えーと"}]
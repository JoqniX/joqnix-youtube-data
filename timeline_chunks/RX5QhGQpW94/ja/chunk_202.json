[{"type": "subtitle", "time": 12123.51, "timestamp": "03:22:03", "text": "ああ、なるほど。なるほど。"}, {"type": "subtitle", "time": 12134.87, "timestamp": "03:22:14", "text": "はい、12になります。いや、でも大丈夫です。"}, {"type": "subtitle", "time": 12136.389, "timestamp": "03:22:16", "text": "えーっと、"}, {"type": "subtitle", "time": 12147.104, "timestamp": "03:22:27", "text": "はい、これをやらなければなりません。"}, {"type": "subtitle", "time": 12159.91, "timestamp": "03:22:39", "text": "いや。いや。いや。いや。いいえ ...それで"}, {"type": "subtitle", "time": 12163.03, "timestamp": "03:22:43", "text": "皆さん、私にはアイデアがあるんです。本当に"}, {"type": "subtitle", "time": 12167.75, "timestamp": "03:22:47", "text": "非常に基本的な、そして非常に悪いビデオ"}, {"type": "subtitle", "time": 12170.87, "timestamp": "03:22:50", "text": "理解するのはとても難しいですが、もし"}, {"type": "subtitle", "time": 12173.91, "timestamp": "03:22:53", "text": "音楽を求める人々"}, {"type": "subtitle", "time": 12176.469, "timestamp": "03:22:56", "text": "より鮮明なビデオを"}, {"type": "subtitle", "time": 12179.83, "timestamp": "03:22:59", "text": "ビデオ[音楽]を詳細に説明"}]
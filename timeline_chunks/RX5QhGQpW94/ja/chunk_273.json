[{"type": "subtitle", "time": 16381.67, "timestamp": "04:33:01", "text": "そうですね、見つけてみましょう。ああ、どこだ"}, {"type": "subtitle", "time": 16384.39, "timestamp": "04:33:04", "text": "あなたは？どこにいるの？さて、それで"}, {"type": "subtitle", "time": 16388.07, "timestamp": "04:33:08", "text": "基本的に、私は何かを持っています。えーと、"}, {"type": "subtitle", "time": 16391.429, "timestamp": "04:33:11", "text": "このアイデアは私が"}, {"type": "subtitle", "time": 16394.949, "timestamp": "04:33:14", "text": "ストリーミング。だから私は5分くらいかけて"}, {"type": "subtitle", "time": 16397.109, "timestamp": "04:33:17", "text": "ストリームに戻るまで10分"}, {"type": "subtitle", "time": 16399.67, "timestamp": "04:33:19", "text": "夕食を食べるかとか"}, {"type": "subtitle", "time": 16402.39, "timestamp": "04:33:22", "text": "何か何か。いいえ。だから私は思いました"}, {"type": "subtitle", "time": 16404.551, "timestamp": "04:33:24", "text": "少し遊べたらもっといいんじゃない？"}, {"type": "subtitle", "time": 16408.39, "timestamp": "04:33:28", "text": "ランダムクリップまたは過去のような事前のようなVOD"}, {"type": "subtitle", "time": 16411.91, "timestamp": "04:33:31", "text": "私のYouTubeチャンネルからストリームする"}, {"type": "subtitle", "time": 16415.269, "timestamp": "04:33:35", "text": "BRBシーンに切り替えたときに表示される"}, {"type": "subtitle", "time": 16418.15, "timestamp": "04:33:38", "text": "そして OBS。うん。そこでアイデアが生まれました"}, {"type": "subtitle", "time": 16422.23, "timestamp": "04:33:42", "text": "そこから私が望んでいたところまで"}, {"type": "subtitle", "time": 16424.869, "timestamp": "04:33:44", "text": "ランダムな時間にランダム投票を表示する"}, {"type": "subtitle", "time": 16428.31, "timestamp": "04:33:48", "text": "スタンプ。そしてそこから発展して"}, {"type": "subtitle", "time": 16431.75, "timestamp": "04:33:51", "text": "うーんという点"}, {"type": "subtitle", "time": 16435.59, "timestamp": "04:33:55", "text": "私のカテゴリーが何であるかを確認します"}, {"type": "subtitle", "time": 16438.709, "timestamp": "04:33:58", "text": "たとえば、Twitch ではただチャットするだけです。だから"}]
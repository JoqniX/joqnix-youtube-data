[{"type": "subtitle", "time": 4865.59, "timestamp": "01:21:05", "text": "えっと、あの、準備しなきゃいけないんだけど"}, {"type": "subtitle", "time": 4869.59, "timestamp": "01:21:09", "text": "新しいモデルの公開情報。私はまだ"}, {"type": "subtitle", "time": 4871.75, "timestamp": "01:21:11", "text": "えーと"}, {"type": "subtitle", "time": 4874.79, "timestamp": "01:21:14", "text": "自分がどうなりたいか考えた"}, {"type": "subtitle", "time": 4879.43, "timestamp": "01:21:19", "text": "それをやってください。決して考えない"}, {"type": "subtitle", "time": 4888.39, "timestamp": "01:21:28", "text": "えっと、そうなるんですよね？"}, {"type": "subtitle", "time": 4898.55, "timestamp": "01:21:38", "text": "これらは今後のストリームです。"}, {"type": "subtitle", "time": 4900.709, "timestamp": "01:21:40", "text": "90年代の方がよかった。"}, {"type": "subtitle", "time": 4903.27, "timestamp": "01:21:43", "text": "さて、私の場合は、"}, {"type": "subtitle", "time": 4906.709, "timestamp": "01:21:46", "text": "何かをするためにたくさんのステップを踏みたい。"}, {"type": "subtitle", "time": 4909.51, "timestamp": "01:21:49", "text": "自動化できる方法があれば、"}, {"type": "subtitle", "time": 4911.91, "timestamp": "01:21:51", "text": "それを行う。"}, {"type": "subtitle", "time": 4914.07, "timestamp": "01:21:54", "text": "だから私はこれらすべてを自動化したのです"}, {"type": "subtitle", "time": 4918.55, "timestamp": "01:21:58", "text": "私は行かなければならなかったのが嫌だった"}]
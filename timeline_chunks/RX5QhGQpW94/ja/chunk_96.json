[{"type": "subtitle", "time": 5760.229, "timestamp": "01:36:00", "text": "働いた。見て、見て、見て、見て。右"}, {"type": "subtitle", "time": 5762.149, "timestamp": "01:36:02", "text": "クリック、"}, {"type": "subtitle", "time": 5766.149, "timestamp": "01:36:06", "text": "兄弟。おい、見て。 Hバカ。"}, {"type": "subtitle", "time": 5768.39, "timestamp": "01:36:08", "text": "わかった。ビデオ。"}, {"type": "subtitle", "time": 5771.189, "timestamp": "01:36:11", "text": "ビデオトラック。"}, {"type": "subtitle", "time": 5772.87, "timestamp": "01:36:12", "text": "V."}, {"type": "subtitle", "time": 5774.629, "timestamp": "01:36:14", "text": "一時停止。"}, {"type": "subtitle", "time": 5776.149, "timestamp": "01:36:16", "text": "ビデオ。"}, {"type": "subtitle", "time": 5779.669, "timestamp": "01:36:19", "text": "ビデオトラック。これ。"}, {"type": "subtitle", "time": 5783.91, "timestamp": "01:36:23", "text": "読み込みに少し時間がかかります。"}, {"type": "subtitle", "time": 5785.83, "timestamp": "01:36:25", "text": "それはどこだ？それはどこだ？わかった。"}, {"type": "subtitle", "time": 5787.99, "timestamp": "01:36:27", "text": "待って。"}, {"type": "subtitle", "time": 5791.43, "timestamp": "01:36:31", "text": "この中。待って。どこですか？こんにちは。うん、"}, {"type": "subtitle", "time": 5794.39, "timestamp": "01:36:34", "text": "ええ、ええ。見て、見て、見て、見て、見て。それで、"}, {"type": "subtitle", "time": 5798.31, "timestamp": "01:36:38", "text": "動画を編集すると、私のアバターが"}, {"type": "subtitle", "time": 5800.47, "timestamp": "01:36:40", "text": "別々で、ディスプレイキャプチャは"}, {"type": "subtitle", "time": 5804.709, "timestamp": "01:36:44", "text": "別々であること。良い。"}, {"type": "subtitle", "time": 5809.189, "timestamp": "01:36:49", "text": "ニース。では、録音を始めましょう。わかった、"}, {"type": "subtitle", "time": 5812.229, "timestamp": "01:36:52", "text": "私は"}, {"type": "subtitle", "time": 5819.51, "timestamp": "01:36:59", "text": "さて、配信を終えたら"}]
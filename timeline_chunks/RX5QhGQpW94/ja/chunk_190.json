[{"type": "subtitle", "time": 11402.79, "timestamp": "03:10:02", "text": "メールアドレスを確認する必要があります"}, {"type": "subtitle", "time": 11407.269, "timestamp": "03:10:07", "text": "そして、私は"}, {"type": "subtitle", "time": 11409.11, "timestamp": "03:10:09", "text": "いやいや、待って。すでにTwitchアカウントをお持ちの場合"}, {"type": "subtitle", "time": 11410.87, "timestamp": "03:10:10", "text": "アカウント。"}, {"type": "subtitle", "time": 11418.469, "timestamp": "03:10:18", "text": "ちょっと待って、何？どうしたの？はどこにありますか"}, {"type": "subtitle", "time": 11422.95, "timestamp": "03:10:22", "text": "それは自動モードですか？それは私が"}, {"type": "subtitle", "time": 11429.429, "timestamp": "03:10:29", "text": "ちょっと待って、何が起こったの？"}, {"type": "subtitle", "time": 11452.87, "timestamp": "03:10:52", "text": "私は私が持っているもの、ああそうだ"}]
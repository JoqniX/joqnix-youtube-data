[{"type": "subtitle", "time": 1328.71, "timestamp": "00:22:08", "text": "これに。"}, {"type": "subtitle", "time": 1332.31, "timestamp": "00:22:12", "text": "はい、これは正解です。"}, {"type": "subtitle", "time": 1334.789, "timestamp": "00:22:14", "text": "画面を見せたいのですが、"}, {"type": "subtitle", "time": 1337.75, "timestamp": "00:22:17", "text": "あまり技術的ではないので"}, {"type": "subtitle", "time": 1340.47, "timestamp": "00:22:20", "text": "多くの。チュートリアルも作らなければなりません。"}, {"type": "subtitle", "time": 1342.95, "timestamp": "00:22:22", "text": "いいえ。だから、私はそれを作らなければなりません"}, {"type": "subtitle", "time": 1345.11, "timestamp": "00:22:25", "text": "もっときれい。"}, {"type": "subtitle", "time": 1348.95, "timestamp": "00:22:28", "text": "ああ、仕事がたくさんある。おお。"}, {"type": "subtitle", "time": 1352.58, "timestamp": "00:22:32", "text": "ただ戻ってきただけだよ。"}, {"type": "subtitle", "time": 1355.11, "timestamp": "00:22:35", "text": "[あえぎ声] 仕事が多すぎる。わかりました。"}, {"type": "subtitle", "time": 1358.95, "timestamp": "00:22:38", "text": "私がライブ配信中であることをお知らせします。"}, {"type": "subtitle", "time": 1360.95, "timestamp": "00:22:40", "text": "やらなきゃいけないのに忘れちゃった"}, {"type": "subtitle", "time": 1378.78, "timestamp": "00:22:58", "text": "物事がどうなっているか忘れてしまったようです。"}]
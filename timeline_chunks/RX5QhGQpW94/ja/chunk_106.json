[{"type": "subtitle", "time": 6360.79, "timestamp": "01:46:00", "text": "管理キャンバス。はい、待ってください。しかし、"}, {"type": "subtitle", "time": 6364.229, "timestamp": "01:46:04", "text": "私の疑問は"}, {"type": "subtitle", "time": 6367.109, "timestamp": "01:46:07", "text": "一体どうやって私のああにアクセスすればいいのでしょうか"}, {"type": "subtitle", "time": 6369.51, "timestamp": "01:46:09", "text": "ここです。わかった。わかった。これは私の"}, {"type": "subtitle", "time": 6372.47, "timestamp": "01:46:12", "text": "今すぐアバター。それで、私がここでやらなければならないことは"}, {"type": "subtitle", "time": 6383.03, "timestamp": "01:46:23", "text": "そしてこのマイクオックスはElgatoで動作しています"}, {"type": "subtitle", "time": 6385.51, "timestamp": "01:46:25", "text": "あれですよね？ノイズのあるもの"}, {"type": "subtitle", "time": 6390.31, "timestamp": "01:46:30", "text": "抑制とコンプレッサー。うん。"}, {"type": "subtitle", "time": 6395.189, "timestamp": "01:46:35", "text": "ああ、わかりました。えーっと"}, {"type": "subtitle", "time": 6398.149, "timestamp": "01:46:38", "text": "それはいいです。えっと、でもちょっと待って[音楽]"}]
[{"type": "subtitle", "time": 10501.03, "timestamp": "02:55:01", "text": "なぜストリーマーは話さないのか"}, {"type": "subtitle", "time": 10504.309, "timestamp": "02:55:04", "text": "えーっと、あれこれ、あれこれ。これですか"}, {"type": "subtitle", "time": 10506.79, "timestamp": "02:55:06", "text": "放送ですか？これは偽のストリームですか?"}, {"type": "subtitle", "time": 10508.95, "timestamp": "02:55:08", "text": "あれこれ。"}, {"type": "subtitle", "time": 10511.75, "timestamp": "02:55:11", "text": "タイトルにもあるように"}, {"type": "subtitle", "time": 10513.91, "timestamp": "02:55:13", "text": "コメント欄に。"}, {"type": "subtitle", "time": 10516.63, "timestamp": "02:55:16", "text": "何をすればいいのか分からない"}, {"type": "subtitle", "time": 10520.63, "timestamp": "02:55:20", "text": "あなた。私は最善を尽くしましたが、中には"}, {"type": "subtitle", "time": 10522.55, "timestamp": "02:55:22", "text": "理解できない。そして、"}, {"type": "subtitle", "time": 10526.87, "timestamp": "02:55:26", "text": "他の批判は、なぜ小さい"}, {"type": "subtitle", "time": 10528.389, "timestamp": "02:55:28", "text": "クリエイター"}, {"type": "subtitle", "time": 10533.03, "timestamp": "02:55:33", "text": "視聴者がほとんどいない人がやらなければならないこと"}, {"type": "subtitle", "time": 10539.03, "timestamp": "02:55:39", "text": "24時間365日のチャンネルでCPUとPCを節約"}, {"type": "subtitle", "time": 10542.469, "timestamp": "02:55:42", "text": "パワーアリティはこれとあれを構築します"}, {"type": "subtitle", "time": 10544.389, "timestamp": "02:55:44", "text": "現在のシステムはローカルですが、"}, {"type": "subtitle", "time": 10549.11, "timestamp": "02:55:49", "text": "クラウドベースのものはすべてそうですが"}, {"type": "subtitle", "time": 10552.07, "timestamp": "02:55:52", "text": "私は、私が言及するのを忘れたと思う"}, {"type": "subtitle", "time": 10556.23, "timestamp": "02:55:56", "text": "ビデオですが、実験的なものです"}, {"type": "subtitle", "time": 10558.729, "timestamp": "02:55:58", "text": "それは私が望んでいた実験的なものだった"}]
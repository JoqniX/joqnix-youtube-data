[{"type": "subtitle", "time": 10320.309, "timestamp": "02:52:00", "text": "私はもう甘やかされて育った子供です"}, {"type": "subtitle", "time": 10323.91, "timestamp": "02:52:03", "text": "一人っ子として。そうですね、"}, {"type": "subtitle", "time": 10344.63, "timestamp": "02:52:24", "text": "また物が届きました。 [音楽]"}, {"type": "chat", "time": 10345.397, "timestamp": "02:52:25", "author": "@abhaynair7276", "avatar": "https://yt4.ggpht.com/ytc/AIdro_m3_pcx7bakRsuScPVawS3lNZlHTFLM8XHTpdd1EGU=s64-c-k-c0x00ffffff-no-rj", "message": "I'm not joking but whatever you are saying is my goal too, I want to be an actor, and make my mama proud that's it"}, {"type": "subtitle", "time": 10346.87, "timestamp": "02:52:26", "text": "しかしここから"}, {"type": "subtitle", "time": 10349.67, "timestamp": "02:52:29", "text": "ここまで、"}, {"type": "subtitle", "time": 10351.19, "timestamp": "02:52:31", "text": "あなたが何を言おうと、それは私の目標でもあります。"}, {"type": "subtitle", "time": 10352.79, "timestamp": "02:52:32", "text": "私は俳優として活動してお金を稼ぎたい"}, {"type": "subtitle", "time": 10355.19, "timestamp": "02:52:35", "text": "プロ。それでおしまい。うん。頑張りましょう。"}, {"type": "subtitle", "time": 10357.83, "timestamp": "02:52:37", "text": "わかった。"}, {"type": "subtitle", "time": 10371.19, "timestamp": "02:52:51", "text": "ええと、ええと、つまり"}, {"type": "subtitle", "time": 10372.55, "timestamp": "02:52:52", "text": "そうなる人もいるだろう"}, {"type": "subtitle", "time": 10376.15, "timestamp": "02:52:56", "text": "心配です。彼らはあなたに彼らの側の"}, {"type": "subtitle", "time": 10378.95, "timestamp": "02:52:58", "text": "物事は、しかし、それはあなたの人生です"}]
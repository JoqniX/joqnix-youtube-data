[{"type": "subtitle", "time": 13800.95, "timestamp": "03:50:00", "text": "私の"}, {"type": "subtitle", "time": 13803.99, "timestamp": "03:50:03", "text": "いいえ、私の考えのデータを取得します。"}, {"type": "subtitle", "time": 13807.11, "timestamp": "03:50:07", "text": "ここから。メインのビデオはこちらです"}, {"type": "subtitle", "time": 13809.75, "timestamp": "03:50:09", "text": "ID、開始時間、プレイリストID。これらは"}, {"type": "subtitle", "time": 13812.71, "timestamp": "03:50:12", "text": "すべてのプレイリストID、終了時間を表示"}, {"type": "subtitle", "time": 13814.87, "timestamp": "03:50:14", "text": "現場で目に見えるもの、そういったものすべて。私"}, {"type": "subtitle", "time": 13817.03, "timestamp": "03:50:17", "text": "これらの他のプロパティを追加して"}, {"type": "subtitle", "time": 13818.95, "timestamp": "03:50:18", "text": "カスタマイズして自動化する"}, {"type": "subtitle", "time": 13823.429, "timestamp": "03:50:23", "text": "好み。だから私がリフレッシュするたびに"}, {"type": "subtitle", "time": 13826.95, "timestamp": "03:50:26", "text": "私のウェブサイトのページには、"}, {"type": "subtitle", "time": 13829.429, "timestamp": "03:50:29", "text": "新しいものを生成する"}, {"type": "subtitle", "time": 13832.229, "timestamp": "03:50:32", "text": "新しいリンクが生成されます。"}, {"type": "subtitle", "time": 13836.469, "timestamp": "03:50:36", "text": "現在のバージョンでは"}, {"type": "subtitle", "time": 13841.03, "timestamp": "03:50:41", "text": "3つ、あるいは現在のバージョンは4つだと思います"}, {"type": "subtitle", "time": 13842.87, "timestamp": "03:50:42", "text": "バージョン"}, {"type": "subtitle", "time": 13846.309, "timestamp": "03:50:46", "text": "いつでも"}, {"type": "subtitle", "time": 13849.59, "timestamp": "03:50:49", "text": "ランダムなvを生成する"}, {"type": "subtitle", "time": 13853.189, "timestamp": "03:50:53", "text": "毎回生成する"}, {"type": "subtitle", "time": 13855.11, "timestamp": "03:50:55", "text": "3時間"}, {"type": "subtitle", "time": 13857.349, "timestamp": "03:50:57", "text": "または30分でタイミングを変えることができます"}, {"type": "subtitle", "time": 13859.83, "timestamp": "03:50:59", "text": "私の好みに合わせてデザインしました"}]
[{"type": "subtitle", "time": 17221.11, "timestamp": "04:47:01", "text": "彼らがデビューするときに持ってきて、そう"}, {"type": "subtitle", "time": 17225.51, "timestamp": "04:47:05", "text": "ストリーム。こんにちは、Kentasakiさん。"}, {"type": "subtitle", "time": 17229.83, "timestamp": "04:47:09", "text": "こんにちは。ちょっと待って、チャットしてるの？"}, {"type": "subtitle", "time": 17231.91, "timestamp": "04:47:11", "text": "私のメイン？そうそう。チャット中です"}, {"type": "subtitle", "time": 17252.07, "timestamp": "04:47:32", "text": "わかった。わかった。では、終わりにしましょう"}, {"type": "subtitle", "time": 17254.55, "timestamp": "04:47:34", "text": "すぐ。わかった。"}, {"type": "subtitle", "time": 17256.07, "timestamp": "04:47:36", "text": "右。"}, {"type": "subtitle", "time": 17258.15, "timestamp": "04:47:38", "text": "えーっと"}, {"type": "subtitle", "time": 17260.868, "timestamp": "04:47:40", "text": "改めて、ルナムーンに感謝します"}, {"type": "subtitle", "time": 17263.43, "timestamp": "04:47:43", "text": "役人。読んでいただきありがとうございます"}, {"type": "subtitle", "time": 17266.23, "timestamp": "04:47:46", "text": "トゥイッチ。それは本当に大きな意味があります。"}, {"type": "subtitle", "time": 17269.11, "timestamp": "04:47:49", "text": "私を見つけてくれてありがとう"}, {"type": "subtitle", "time": 17272.538, "timestamp": "04:47:52", "text": "レイド投票ウェブサイト。"}, {"type": "subtitle", "time": 17275.11, "timestamp": "04:47:55", "text": "[咳払い] 勧めてよかった"}]
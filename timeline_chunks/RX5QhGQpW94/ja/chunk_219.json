[{"type": "subtitle", "time": 13143.03, "timestamp": "03:39:03", "text": "ジョアソンの問題"}, {"type": "subtitle", "time": 13146.309, "timestamp": "03:39:06", "text": "イベントはジョアソンを作らなければならなかった"}, {"type": "subtitle", "time": 13149.91, "timestamp": "03:39:09", "text": "すべてのジョアソンを含むプレイリスト"}, {"type": "subtitle", "time": 13153.349, "timestamp": "03:39:13", "text": "ストリームですよね？しかし、凝縮"}, {"type": "subtitle", "time": 13156.87, "timestamp": "03:39:16", "text": "多種多様で異なります。これは"}, {"type": "subtitle", "time": 13159.75, "timestamp": "03:39:19", "text": "最も"}, {"type": "subtitle", "time": 13162.309, "timestamp": "03:39:22", "text": "計算しなければならなかった厄介な変数"}, {"type": "subtitle", "time": 13166.87, "timestamp": "03:39:26", "text": "外。そこで私がしたのは"}, {"type": "subtitle", "time": 13169.03, "timestamp": "03:39:29", "text": "内容を気にしないといけないので"}, {"type": "subtitle", "time": 13172.87, "timestamp": "03:39:32", "text": "種類と[音楽]プレイリストを見て気づいた"}, {"type": "subtitle", "time": 13176.389, "timestamp": "03:39:36", "text": "すでに24時間配信をしているストリーマーは"}, {"type": "subtitle", "time": 13192.55, "timestamp": "03:39:52", "text": "24時間体制でセットアップを行うストリーマー"}, {"type": "subtitle", "time": 13196.15, "timestamp": "03:39:56", "text": "ここ。彼は、"}, {"type": "subtitle", "time": 13199.75, "timestamp": "03:39:59", "text": "文字通りランダムに演奏します。その"}]
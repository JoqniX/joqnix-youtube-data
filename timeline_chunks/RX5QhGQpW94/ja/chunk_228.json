[{"type": "subtitle", "time": 13682.07, "timestamp": "03:48:02", "text": "プレイリストとあなたの起源。これは"}, {"type": "subtitle", "time": 13685.03, "timestamp": "03:48:05", "text": "以前言及した参照者"}, {"type": "subtitle", "time": 13687.91, "timestamp": "03:48:07", "text": "起源。これが私のウェブサイトです"}, {"type": "subtitle", "time": 13689.59, "timestamp": "03:48:09", "text": "住所"}, {"type": "subtitle", "time": 13693.83, "timestamp": "03:48:13", "text": "URLなどです。これは"}, {"type": "subtitle", "time": 13698.15, "timestamp": "03:48:18", "text": "OBSに埋め込みリンクを貼って再生する"}, {"type": "subtitle", "time": 13701.51, "timestamp": "03:48:21", "text": "ブラウザソースからの埋め込み"}, {"type": "subtitle", "time": 13705.67, "timestamp": "03:48:25", "text": "OBS。右？そこで私がやったことは"}, {"type": "subtitle", "time": 13711.51, "timestamp": "03:48:31", "text": "しかし問題は、サミーをどうやって使うかということだった"}, {"type": "subtitle", "time": 13715.99, "timestamp": "03:48:35", "text": "ランダムなVAを生成する"}, {"type": "subtitle", "time": 13720.309, "timestamp": "03:48:40", "text": "リンクを貼ってウェブスタジオに送信"}, {"type": "subtitle", "time": 13723.269, "timestamp": "03:48:43", "text": "私のウェブサイトはウェブ上に構築されているので"}, {"type": "subtitle", "time": 13726.79, "timestamp": "03:48:46", "text": "スタジオ右。だから私は"}]
[{"type": "subtitle", "time": 5700.79, "timestamp": "01:35:00", "text": "オープンウェブ。"}, {"type": "subtitle", "time": 5704.87, "timestamp": "01:35:04", "text": "ちょっと待って、これやってもいい？ああ、それはダメだ。"}, {"type": "subtitle", "time": 5714.07, "timestamp": "01:35:14", "text": "えーっと。どうすればいいですか。ああ、インストールします。"}, {"type": "subtitle", "time": 5721.27, "timestamp": "01:35:21", "text": "あなたは[咳払い]に取り組んでいます"}, {"type": "subtitle", "time": 5723.27, "timestamp": "01:35:23", "text": "何か。あなたのメッセージを読んで申し訳ありません"}, {"type": "subtitle", "time": 5724.95, "timestamp": "01:35:24", "text": "遅い。そうだ、録音するよ"}, {"type": "subtitle", "time": 5728.229, "timestamp": "01:35:28", "text": "私はそれをやりますというビデオ。私は"}, {"type": "subtitle", "time": 5737.51, "timestamp": "01:35:37", "text": "はい、動作しています。わかった。右クリック、"}, {"type": "subtitle", "time": 5740.31, "timestamp": "01:35:40", "text": "開く"}, {"type": "subtitle", "time": 5748.31, "timestamp": "01:35:48", "text": "そこでここを右クリックします。ビデオ。"}, {"type": "subtitle", "time": 5749.27, "timestamp": "01:35:49", "text": "こんにちは。これは"}, {"type": "subtitle", "time": 5751.59, "timestamp": "01:35:51", "text": "ビデオトラック。"}, {"type": "subtitle", "time": 5754.95, "timestamp": "01:35:54", "text": "見て見て。何てことだ。待って。あなたは見ましたか"}, {"type": "subtitle", "time": 5757.75, "timestamp": "01:35:57", "text": "それ？待って、待って、待って。それは実際には"}]
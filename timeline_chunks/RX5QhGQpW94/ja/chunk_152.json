[{"type": "subtitle", "time": 9122.07, "timestamp": "02:32:02", "text": "通常、YouTuberのストリームは常に"}, {"type": "subtitle", "time": 9124.95, "timestamp": "02:32:04", "text": "予定されているコンテンツになります。えーと"}, {"type": "subtitle", "time": 9128.389, "timestamp": "02:32:08", "text": "YouTuberが好む"}, {"type": "subtitle", "time": 9131.51, "timestamp": "02:32:11", "text": "私はJP YouTubersが何をスケジュールするか"}, {"type": "subtitle", "time": 9133.99, "timestamp": "02:32:13", "text": "彼らが行うストリームの種類"}, {"type": "subtitle", "time": 9136.63, "timestamp": "02:32:16", "text": "1週間前に、あるいは彼らが"}, {"type": "subtitle", "time": 9138.95, "timestamp": "02:32:18", "text": "月曜日火曜日のようなスケジュールはありません"}, {"type": "subtitle", "time": 9143.19, "timestamp": "02:32:23", "text": "水曜日 金曜日 休み そんな感じ"}, {"type": "subtitle", "time": 9145.75, "timestamp": "02:32:25", "text": "ゴリラストリームというのは"}, {"type": "subtitle", "time": 9151.03, "timestamp": "02:32:31", "text": "予定外のストリーム私はどこからともなく現れた"}, {"type": "subtitle", "time": 9155.99, "timestamp": "02:32:35", "text": "ストリーミングして見たら止まって"}, {"type": "subtitle", "time": 9157.99, "timestamp": "02:32:37", "text": "グレリア"}, {"type": "subtitle", "time": 9166.71, "timestamp": "02:32:46", "text": "えっと、グレリアのストリームはやめてください。そうだ、ゴリラ"}, {"type": "subtitle", "time": 9169.27, "timestamp": "02:32:49", "text": "ストリームは予定外のサプライズライブです"}, {"type": "subtitle", "time": 9171.27, "timestamp": "02:32:51", "text": "コネクトクリエイターズパートによる放送"}, {"type": "subtitle", "time": 9173.51, "timestamp": "02:32:53", "text": "YouTuberの間で特に人気がある"}, {"type": "subtitle", "time": 9175.59, "timestamp": "02:32:55", "text": "事前の告知なしに起こったり、"}, {"type": "subtitle", "time": 9179.75, "timestamp": "02:32:59", "text": "通常のスケジュール外。"}]
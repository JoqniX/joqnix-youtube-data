[{"type": "subtitle", "time": 5886.55, "timestamp": "01:38:06", "text": "何をしてるの？録音します"}, {"type": "subtitle", "time": 5889.59, "timestamp": "01:38:09", "text": "私の24時間年中無休のチャンネルのビデオをただ与えるために"}, {"type": "subtitle", "time": 5894.149, "timestamp": "01:38:14", "text": "なぜそれを作ったのか説明してほしい"}, {"type": "subtitle", "time": 5896.629, "timestamp": "01:38:16", "text": "それは何なのか、そして私は"}, {"type": "subtitle", "time": 5899.83, "timestamp": "01:38:19", "text": "技術的な詳細ビデオを作成する"}, {"type": "subtitle", "time": 5903.91, "timestamp": "01:38:23", "text": "について興味がある人"}, {"type": "subtitle", "time": 5906.79, "timestamp": "01:38:26", "text": "技術的なこと、どうやって作ったのか"}, {"type": "subtitle", "time": 5911.83, "timestamp": "01:38:31", "text": "ああ、ああ、ああ、ああ、私は作らなければならない"}, {"type": "subtitle", "time": 5915.109, "timestamp": "01:38:35", "text": "これをトップにするにはTwitchに行く必要があります"}, {"type": "subtitle", "time": 5927.109, "timestamp": "01:38:47", "text": "ええ、私はただ例を挙げることができます"}, {"type": "subtitle", "time": 5931.35, "timestamp": "01:38:51", "text": "24時間365日のチャネル。いや、彼は"}, {"type": "subtitle", "time": 5936.149, "timestamp": "01:38:56", "text": "今すぐカテゴリを選択してください。だから私は見つけなければならないと思う"}, {"type": "subtitle", "time": 5939.109, "timestamp": "01:38:59", "text": "ピーナッツはどこですか？"}]
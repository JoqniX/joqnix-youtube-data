[{"type": "subtitle", "time": 12240.79, "timestamp": "03:24:00", "text": "スーパーチャット。スーパーチャットを送信したり"}, {"type": "subtitle", "time": 12243.429, "timestamp": "03:24:03", "text": "会員権か何か [音楽]"}, {"type": "subtitle", "time": 12245.03, "timestamp": "03:24:05", "text": "えーと"}, {"type": "subtitle", "time": 12250.07, "timestamp": "03:24:10", "text": "そしてゴールに到達したら"}, {"type": "subtitle", "time": 12253.75, "timestamp": "03:24:13", "text": "目標は同じシステムで完了します"}, {"type": "subtitle", "time": 12256.95, "timestamp": "03:24:16", "text": "どうやって待っていればいいの？電源を入れるから"}, {"type": "subtitle", "time": 12261.03, "timestamp": "03:24:21", "text": "もう一度言うけど"}, {"type": "subtitle", "time": 12275.19, "timestamp": "03:24:35", "text": "笑顔チェック。えっと、私が好きだったなんてバカだった"}, {"type": "subtitle", "time": 12280.95, "timestamp": "03:24:40", "text": "えーと"}, {"type": "subtitle", "time": 12293.59, "timestamp": "03:24:53", "text": "わかりました。見てみましょう。パワーアップスマイルチェック。"}, {"type": "subtitle", "time": 12298.15, "timestamp": "03:24:58", "text": "31皿まで拡張します。 30日間。"}]
[{"type": "subtitle", "time": 16260.87, "timestamp": "04:31:00", "text": "いらっしゃいませ。"}, {"type": "subtitle", "time": 16264.07, "timestamp": "04:31:04", "text": "私は現在、古い報酬をプレイしていました。"}, {"type": "subtitle", "time": 16267.03, "timestamp": "04:31:07", "text": "だから私は今日私は"}, {"type": "subtitle", "time": 16271.03, "timestamp": "04:31:11", "text": "2つのビデオのように録画されます。えーと"}, {"type": "subtitle", "time": 16273.269, "timestamp": "04:31:13", "text": "だから私は2つのビデオを録画しました。しないでください"}, {"type": "subtitle", "time": 16275.349, "timestamp": "04:31:15", "text": "擦り傷に注意してください。私は全身を見せている"}, {"type": "subtitle", "time": 16277.67, "timestamp": "04:31:17", "text": "画面が悪いです。でも、そうしないで"}, {"type": "subtitle", "time": 16281.99, "timestamp": "04:31:21", "text": "擦り傷に注意してください。でもちょっと待ってください。"}, {"type": "subtitle", "time": 16285.99, "timestamp": "04:31:25", "text": "我慢する。擦り傷は気にしないでください。"}, {"type": "subtitle", "time": 16289.83, "timestamp": "04:31:29", "text": "待って。それで録音が終わったので"}, {"type": "subtitle", "time": 16293.75, "timestamp": "04:31:33", "text": "チャンネルを作った理由などの紹介"}, {"type": "subtitle", "time": 16296.469, "timestamp": "04:31:36", "text": "そして、それについて何を期待できるかなど。"}, {"type": "subtitle", "time": 16299.59, "timestamp": "04:31:39", "text": "6分間の短いビデオです。それから私は"}, {"type": "subtitle", "time": 16302.469, "timestamp": "04:31:42", "text": "エラーのみ。それから私は"}, {"type": "subtitle", "time": 16305.83, "timestamp": "04:31:45", "text": "技術詳細バージョン。だからもし誰かが"}, {"type": "subtitle", "time": 16309.83, "timestamp": "04:31:49", "text": "誰が技術オタクで誰が私のやり方に興味があるか"}, {"type": "subtitle", "time": 16312.87, "timestamp": "04:31:52", "text": "参照できるようにしました。私"}, {"type": "subtitle", "time": 16315.11, "timestamp": "04:31:55", "text": "できました。初めて作りました"}, {"type": "subtitle", "time": 16317.83, "timestamp": "04:31:57", "text": "チュートリアルのようなものです。そこで、私は"}]
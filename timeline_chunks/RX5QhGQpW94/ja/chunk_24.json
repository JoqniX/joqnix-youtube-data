[{"type": "subtitle", "time": 1441.35, "timestamp": "00:24:01", "text": "しばらくは、私は基本的に"}, {"type": "subtitle", "time": 1444.789, "timestamp": "00:24:04", "text": "実質的に初心者です。"}, {"type": "subtitle", "time": 1460.39, "timestamp": "00:24:20", "text": "はい、発表は終わりました。はい、よかったです"}, {"type": "subtitle", "time": 1462.87, "timestamp": "00:24:22", "text": "よかった、よかった。"}, {"type": "subtitle", "time": 1470.23, "timestamp": "00:24:30", "text": "えっと、できない、できない、わかってる"}, {"type": "subtitle", "time": 1478.63, "timestamp": "00:24:38", "text": "希望"}, {"type": "subtitle", "time": 1481.19, "timestamp": "00:24:41", "text": "物事はうまくいくでしょう。心配しないでください"}, {"type": "subtitle", "time": 1483.59, "timestamp": "00:24:43", "text": "多くの。"}, {"type": "subtitle", "time": 1485.909, "timestamp": "00:24:45", "text": "うん。"}, {"type": "subtitle", "time": 1490.23, "timestamp": "00:24:50", "text": "そして私は最近"}, {"type": "subtitle", "time": 1492.95, "timestamp": "00:24:52", "text": "なぜ両親はそれに同意したのですか"}, {"type": "subtitle", "time": 1495.269, "timestamp": "00:24:55", "text": "それから？もし両親が同意してくれなかったら、"}, {"type": "subtitle", "time": 1498.07, "timestamp": "00:24:58", "text": "じゃあなぜ私がそこに行くのか"}]
[{"type": "subtitle", "time": 2344.63, "timestamp": "00:39:04", "text": "正直に言うと、私はこう思いました"}, {"type": "subtitle", "time": 2348.63, "timestamp": "00:39:08", "text": "ビデオを録画するつもりです"}, {"type": "subtitle", "time": 2357.19, "timestamp": "00:39:17", "text": "あなたは年寄りです。外に出てはいけない"}, {"type": "subtitle", "time": 2359.75, "timestamp": "00:39:19", "text": "これ。なぜ古いと言うのですか？ああ、違うよ"}, {"type": "subtitle", "time": 2375.03, "timestamp": "00:39:35", "text": "あなたのチャットを見ました。あなたは言った"}, {"type": "subtitle", "time": 2378.39, "timestamp": "00:39:38", "text": "ボード ザ ザ"}, {"type": "subtitle", "time": 2381.829, "timestamp": "00:39:41", "text": "常にオンのチャンネル。このガキめ。あなたは"}, {"type": "subtitle", "time": 2385.43, "timestamp": "00:39:45", "text": "またおじさんと呼べるの？何てことだ。"}, {"type": "subtitle", "time": 2390.39, "timestamp": "00:39:50", "text": "こんにちは、ネイサン。何てことだ。元気ですか？"}, {"type": "subtitle", "time": 2395.109, "timestamp": "00:39:55", "text": "元気ですか？元気ですか？こんにちは。"}]
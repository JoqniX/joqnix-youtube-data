[{"type": "subtitle", "time": 7860.55, "timestamp": "02:11:00", "text": "私をチェックしたり、私を見ている人たちは"}, {"type": "subtitle", "time": 7865.03, "timestamp": "02:11:05", "text": "懐かしさなどまだ感じられます。"}, {"type": "subtitle", "time": 7868.069, "timestamp": "02:11:08", "text": "そして最後に私が言いたかったのは"}, {"type": "subtitle", "time": 7871.03, "timestamp": "02:11:11", "text": "誰でも歓迎します"}, {"type": "subtitle", "time": 7875.109, "timestamp": "02:11:15", "text": "周りに潜む24倍"}, {"type": "subtitle", "time": 7879.589, "timestamp": "02:11:19", "text": "これらの24時間365日のチャネルと"}, {"type": "subtitle", "time": 7882.31, "timestamp": "02:11:22", "text": "ええ、心配しないでください私のメインチャンネル"}, {"type": "subtitle", "time": 7884.55, "timestamp": "02:11:24", "text": "内容はすべて同じになります。"}, {"type": "subtitle", "time": 7887.669, "timestamp": "02:11:27", "text": "これは別の"}, {"type": "subtitle", "time": 7890.79, "timestamp": "02:11:30", "text": "これは別個の 24 時間 365 日のものです。それで"}, {"type": "subtitle", "time": 7895.27, "timestamp": "02:11:35", "text": "ええ、もっと最新情報を知りたい場合は"}, {"type": "subtitle", "time": 7897.43, "timestamp": "02:11:37", "text": "技術的な詳細などについては"}, {"type": "subtitle", "time": 7899.03, "timestamp": "02:11:39", "text": "に関して別のビデオを作る予定"}, {"type": "subtitle", "time": 7905.43, "timestamp": "02:11:45", "text": "それ。そして私の24時間体制に何かあれば"}, {"type": "subtitle", "time": 7907.51, "timestamp": "02:11:47", "text": "最新情報やお知らせは"}, {"type": "subtitle", "time": 7909.35, "timestamp": "02:11:49", "text": "私のメインチャンネルで"}, {"type": "subtitle", "time": 7913.27, "timestamp": "02:11:53", "text": "これは皆さんに次のようなビデオをお届けするものです"}, {"type": "subtitle", "time": 7915.589, "timestamp": "02:11:55", "text": "何が変わったか、そして何を"}, {"type": "subtitle", "time": 7918.55, "timestamp": "02:11:58", "text": "今後に期待できます。を持つでしょう"}]
[{"type": "subtitle", "time": 3483.829, "timestamp": "00:58:03", "text": "チャット中です。ああ、覗いてくれてありがとう。"}, {"type": "subtitle", "time": 3489.75, "timestamp": "00:58:09", "text": "ああ、わかりました。 [咳払い]"}, {"type": "subtitle", "time": 3495.43, "timestamp": "00:58:15", "text": "2つのコマンドがあると思います"}, {"type": "subtitle", "time": 3497.43, "timestamp": "00:58:17", "text": "見せる。"}, {"type": "subtitle", "time": 3501.51, "timestamp": "00:58:21", "text": "これはフェッチの概念です"}, {"type": "subtitle", "time": 3503.51, "timestamp": "00:58:23", "text": "プレイリストシングル。わかった。わかった。これは"}, {"type": "subtitle", "time": 3506.87, "timestamp": "00:58:26", "text": "プレイリスト。待たないで。プレイリストを作成しました"}, {"type": "subtitle", "time": 3509.91, "timestamp": "00:58:29", "text": "アクティブ。待って、待って、待って。我慢する。私"}, {"type": "subtitle", "time": 3513.91, "timestamp": "00:58:33", "text": "国民に説明しなければならない"}, {"type": "subtitle", "time": 3516.87, "timestamp": "00:58:36", "text": "ここで何をすればいいのでしょうか？そしてああ神様、"}, {"type": "subtitle", "time": 3520.47, "timestamp": "00:58:40", "text": "彼らは頭を殴られるんじゃないの？"}, {"type": "subtitle", "time": 3523.349, "timestamp": "00:58:43", "text": "これらすべてを見るとどう思うでしょうか?"}, {"type": "subtitle", "time": 3530.549, "timestamp": "00:58:50", "text": "えーっと、"}, {"type": "subtitle", "time": 3532.789, "timestamp": "00:58:52", "text": "合併しました。ああそうだ、後退しろ。秋が必要です"}, {"type": "subtitle", "time": 3535.67, "timestamp": "00:58:55", "text": "戻る。フォールバックは基本的にこれです。それで、"}]
[{"type": "subtitle", "time": 4020.23, "timestamp": "01:07:00", "text": "それからキックセミコールを書かないといけない"}, {"type": "subtitle", "time": 4024.069, "timestamp": "01:07:04", "text": "この点ドットのようなものがIDをキックします。それから"}, {"type": "subtitle", "time": 4026.549, "timestamp": "01:07:06", "text": "YouTube のユーザー ID をこのように入力します。"}, {"type": "subtitle", "time": 4029.91, "timestamp": "01:07:09", "text": "それがマージする方法です。"}, {"type": "subtitle", "time": 4032.15, "timestamp": "01:07:12", "text": "うん。そして、それを統合すると、"}, {"type": "subtitle", "time": 4034.789, "timestamp": "01:07:14", "text": "独自の公開UIDを持つ"}, {"type": "subtitle", "time": 4037.43, "timestamp": "01:07:17", "text": "あなたの内面のもの。うん。それはちょっと"}, {"type": "subtitle", "time": 4040.789, "timestamp": "01:07:20", "text": "複雑。それは骨組みだけです。良くない"}, {"type": "subtitle", "time": 4045.43, "timestamp": "01:07:25", "text": "十分ですが、ある程度は機能します。"}, {"type": "subtitle", "time": 4047.75, "timestamp": "01:07:27", "text": "うん。"}, {"type": "subtitle", "time": 4051.91, "timestamp": "01:07:31", "text": "えっと、もっと良くしたかったんです"}, {"type": "subtitle", "time": 4055.349, "timestamp": "01:07:35", "text": "ユーザーが同じことをしているような"}, {"type": "subtitle", "time": 4058.789, "timestamp": "01:07:38", "text": "coには権利がある私は"}, {"type": "subtitle", "time": 4061.109, "timestamp": "01:07:41", "text": "私が持っているようなシステム"}, {"type": "subtitle", "time": 4063.99, "timestamp": "01:07:43", "text": "管理者ログインのように"}, {"type": "subtitle", "time": 4067.109, "timestamp": "01:07:47", "text": "自分用なのでリンクする必要はありません"}, {"type": "subtitle", "time": 4070.95, "timestamp": "01:07:50", "text": "YouTube APIキックTwitch APIのもの"}, {"type": "subtitle", "time": 4073.91, "timestamp": "01:07:53", "text": "サミーのものを仕事に使うだけでいい"}, {"type": "subtitle", "time": 4077.43, "timestamp": "01:07:57", "text": "ウェブサイトにアクセスしてトークンを取得し、"}]
[{"type": "subtitle", "time": 2042.95, "timestamp": "00:34:02", "text": "守護者は人々のように正しい彼らは"}, {"type": "subtitle", "time": 2045.669, "timestamp": "00:34:05", "text": "電話して会議をしなくてはいけません"}, {"type": "subtitle", "time": 2048.95, "timestamp": "00:34:08", "text": "エッセイや謝罪の手紙を書く"}, {"type": "subtitle", "time": 2052.389, "timestamp": "00:34:12", "text": "謝罪の手紙を書かなければならない"}, {"type": "subtitle", "time": 2056.71, "timestamp": "00:34:16", "text": "アルバイトをするまで"}, {"type": "subtitle", "time": 2062.31, "timestamp": "00:34:22", "text": "あなたは安定しています地元の研究所"}, {"type": "subtitle", "time": 2066.95, "timestamp": "00:34:26", "text": "えっと、えっと、あなたを大事にしなきゃいけないみたいな"}, {"type": "subtitle", "time": 2069.03, "timestamp": "00:34:29", "text": "そして世話をしなければならない"}, {"type": "subtitle", "time": 2071.75, "timestamp": "00:34:31", "text": "すべてそうです。文字通り"}, {"type": "subtitle", "time": 2073.51, "timestamp": "00:34:33", "text": "彼らは学生の面倒を見ることはない"}, {"type": "subtitle", "time": 2077.03, "timestamp": "00:34:37", "text": "そういうことは何であれ。それから"}, {"type": "subtitle", "time": 2079.829, "timestamp": "00:34:39", "text": "言語学を卒業した後"}, {"type": "subtitle", "time": 2082.79, "timestamp": "00:34:42", "text": "学校ならそれはあなた次第です。いや、君は"}, {"type": "subtitle", "time": 2086.149, "timestamp": "00:34:46", "text": "あなたは自分の道を残す"}, {"type": "subtitle", "time": 2088.869, "timestamp": "00:34:48", "text": "大学に行くか、仕事を探すか何か。"}, {"type": "subtitle", "time": 2095.03, "timestamp": "00:34:55", "text": "それは君の責任だよ、ああ、そうだね。"}]
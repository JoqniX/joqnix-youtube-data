[{"type": "subtitle", "time": 14580.389, "timestamp": "04:03:00", "text": "そして、繰り返しの中で気づいたかもしれない"}, {"type": "subtitle", "time": 14584.63, "timestamp": "04:03:04", "text": "5つのバージョン5を合計すると90になります"}, {"type": "subtitle", "time": 14587.03, "timestamp": "04:03:07", "text": "埋め込み動画"}, {"type": "subtitle", "time": 14590.71, "timestamp": "04:03:10", "text": "埋め込まれたプレイリスト。それで何が"}, {"type": "subtitle", "time": 14594.87, "timestamp": "04:03:14", "text": "私ができることはセットアップを実行することだけです"}, {"type": "subtitle", "time": 14597.67, "timestamp": "04:03:17", "text": "週に一度、十分な"}, {"type": "subtitle", "time": 14600.79, "timestamp": "04:03:20", "text": "[音楽]が全体を通して再生されるコンテンツ"}, {"type": "subtitle", "time": 14605.189, "timestamp": "04:03:25", "text": "週。それは本当にクールじゃないですか?"}, {"type": "subtitle", "time": 14608.87, "timestamp": "04:03:28", "text": "うん。さて、次はオートアクティブです。今"}, {"type": "subtitle", "time": 14611.83, "timestamp": "04:03:31", "text": "ジョーは"}, {"type": "subtitle", "time": 14615.91, "timestamp": "04:03:35", "text": "プレイリストのサイクルを手動で変更する"}, {"type": "subtitle", "time": 14619.59, "timestamp": "04:03:39", "text": "右？でも、私が作り直したものは"}, {"type": "subtitle", "time": 14621.91, "timestamp": "04:03:41", "text": "ここ、"}, {"type": "subtitle", "time": 14624.07, "timestamp": "04:03:44", "text": "私がここで作ったものは必要ありません"}, {"type": "subtitle", "time": 14626.55, "timestamp": "04:03:46", "text": "それをやるには。これを実行するだけです"}, {"type": "subtitle", "time": 14630.07, "timestamp": "04:03:50", "text": "ボタンを一度押すと"}, {"type": "subtitle", "time": 14632.55, "timestamp": "04:03:52", "text": "ランダムにランダムに"}, {"type": "subtitle", "time": 14636.469, "timestamp": "04:03:56", "text": "ランダムにトリガーされます"}, {"type": "subtitle", "time": 14639.11, "timestamp": "04:03:59", "text": "プレイリストのいずれか。見せてあげましょう"}]
[{"type": "subtitle", "time": 10863.269, "timestamp": "03:01:03", "text": "これ。"}, {"type": "subtitle", "time": 10867.349, "timestamp": "03:01:07", "text": "さて、ここで"}, {"type": "subtitle", "time": 10871.03, "timestamp": "03:01:11", "text": "これらの瞬間を見ると"}, {"type": "subtitle", "time": 10874.389, "timestamp": "03:01:14", "text": "私のメインチャンネルをチェックしたり、"}, {"type": "subtitle", "time": 10877.83, "timestamp": "03:01:17", "text": "私のアウトですよね？だから、それは良い"}, {"type": "subtitle", "time": 10882.23, "timestamp": "03:01:22", "text": "私を発見した人のためのオープナー"}, {"type": "subtitle", "time": 10884.79, "timestamp": "03:01:24", "text": "または、私をチェックすることに興味がある人や"}, {"type": "subtitle", "time": 10887.99, "timestamp": "03:01:27", "text": "私を見ている人は、まだ"}, {"type": "subtitle", "time": 10890.55, "timestamp": "03:01:30", "text": "懐かしさとか。そして最後に、私は"}, {"type": "subtitle", "time": 10893.83, "timestamp": "03:01:33", "text": "皆さんが誰であっても"}, {"type": "subtitle", "time": 10898.15, "timestamp": "03:01:38", "text": "ぜひお越しください。"}, {"type": "subtitle", "time": 10911.19, "timestamp": "03:01:51", "text": "えっと、君たち"}, {"type": "subtitle", "time": 10912.71, "timestamp": "03:01:52", "text": "そして"}, {"type": "subtitle", "time": 10917.11, "timestamp": "03:01:57", "text": "これらの247チャンネルで"}, {"type": "subtitle", "time": 10919.11, "timestamp": "03:01:59", "text": "これらの"}]
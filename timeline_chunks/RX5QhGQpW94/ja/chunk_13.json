[{"type": "subtitle", "time": 782.87, "timestamp": "00:13:02", "text": "ビーチ？わからない。えっと、ビーチ。うん、"}, {"type": "subtitle", "time": 786.23, "timestamp": "00:13:06", "text": "灯台とかもありました。"}, {"type": "subtitle", "time": 801.11, "timestamp": "00:13:21", "text": "前回。なぜ？ああ、私は行くから"}, {"type": "subtitle", "time": 803.59, "timestamp": "00:13:23", "text": "海外に行くんですよね？えっと、次の後"}, {"type": "subtitle", "time": 805.67, "timestamp": "00:13:25", "text": "月、4月。"}, {"type": "subtitle", "time": 809.829, "timestamp": "00:13:29", "text": "うん。だから、最後に私が"}, {"type": "subtitle", "time": 814.31, "timestamp": "00:13:34", "text": "インドで2ヶ月過ごして、その後"}, {"type": "subtitle", "time": 816.87, "timestamp": "00:13:36", "text": "私は"}, {"type": "subtitle", "time": 820.629, "timestamp": "00:13:40", "text": "別の国で。うん。"}, {"type": "subtitle", "time": 825.67, "timestamp": "00:13:45", "text": "だから、具体的には言えないんです"}, {"type": "subtitle", "time": 829.11, "timestamp": "00:13:49", "text": "どこに行ったかって？でも、そう、それは"}, {"type": "subtitle", "time": 833.509, "timestamp": "00:13:53", "text": "楽しい時間でした。いとこ達もそこにいたので"}, {"type": "subtitle", "time": 835.19, "timestamp": "00:13:55", "text": "私"}, {"type": "subtitle", "time": 837.91, "timestamp": "00:13:57", "text": "いとこたちと遊ぶ、"}]
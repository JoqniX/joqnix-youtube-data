[{"type": "subtitle", "time": 662.202, "timestamp": "00:11:02", "text": "それを試してみたかったんです。"}, {"type": "subtitle", "time": 663.269, "timestamp": "00:11:03", "text": "[咳払い]"}, {"type": "subtitle", "time": 666.87, "timestamp": "00:11:06", "text": "ええ、私が"}, {"type": "subtitle", "time": 670.71, "timestamp": "00:11:10", "text": "パソコンから離れると、私はまるでリモートのようでした"}, {"type": "subtitle", "time": 673.35, "timestamp": "00:11:13", "text": "PCを制御してチェックできるように"}, {"type": "subtitle", "time": 676.55, "timestamp": "00:11:16", "text": "私のボードチャンネルでいつも"}, {"type": "subtitle", "time": 680.069, "timestamp": "00:11:20", "text": "チャンネルのことをやらなきゃいけないし"}, {"type": "subtitle", "time": 682.15, "timestamp": "00:11:22", "text": "デイリー、ですよね？ [笑い]"}, {"type": "subtitle", "time": 686.71, "timestamp": "00:11:26", "text": "ブループロトコルのデイリー。だから私は、"}, {"type": "subtitle", "time": 689.03, "timestamp": "00:11:29", "text": "PCをリモートコントロールして、"}, {"type": "subtitle", "time": 692.87, "timestamp": "00:11:32", "text": "私のデイリーとその他すべて。"}, {"type": "subtitle", "time": 695.509, "timestamp": "00:11:35", "text": "停電がなかったのは幸いでした"}, {"type": "subtitle", "time": 698.31, "timestamp": "00:11:38", "text": "4日間。"}, {"type": "subtitle", "time": 699.829, "timestamp": "00:11:39", "text": "どこにいましたか？私は"}, {"type": "subtitle", "time": 703.509, "timestamp": "00:11:43", "text": "休暇。休暇はよかったです。支出I"}, {"type": "subtitle", "time": 706.63, "timestamp": "00:11:46", "text": "家族と時間を過ごす。それは本当に"}, {"type": "subtitle", "time": 709.75, "timestamp": "00:11:49", "text": "楽しい。楽しかったです。"}, {"type": "subtitle", "time": 712.47, "timestamp": "00:11:52", "text": "家族と一緒に時間を過ごしました。"}, {"type": "subtitle", "time": 714.47, "timestamp": "00:11:54", "text": "うん。"}]
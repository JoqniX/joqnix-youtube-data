[{"type": "subtitle", "time": 10621.51, "timestamp": "02:57:01", "text": "エラー。"}, {"type": "subtitle", "time": 10624.23, "timestamp": "02:57:04", "text": "そして[咳払い]あなたはそれをやったかどうか見ることができます"}, {"type": "subtitle", "time": 10626.63, "timestamp": "02:57:06", "text": "それは私にとってうまくいくでしょうか?そうでもないかもしれない。もしそれが"}, {"type": "subtitle", "time": 10629.83, "timestamp": "02:57:09", "text": "そうでない場合、どうすれば改善できますか?"}, {"type": "subtitle", "time": 10632.15, "timestamp": "02:57:12", "text": "それはコンテンツ作成ですよね？"}, {"type": "subtitle", "time": 10635.347, "timestamp": "02:57:15", "text": "この1時間のチャンネルについて"}, {"type": "subtitle", "time": 10637.75, "timestamp": "02:57:17", "text": "[咳払い] そんなことないよ。まず、これは"}, {"type": "subtitle", "time": 10640.79, "timestamp": "02:57:20", "text": "このチャンネルは農業用ではありません"}, {"type": "subtitle", "time": 10643.269, "timestamp": "02:57:23", "text": "約束とかそういうもの。それ"}, {"type": "subtitle", "time": 10646.87, "timestamp": "02:57:26", "text": "私のメインライブの代わりにはなりません"}, {"type": "subtitle", "time": 10649.59, "timestamp": "02:57:29", "text": "これまでで最も多くのストリーム。そしてそれは偽装ではない"}, {"type": "subtitle", "time": 10653.429, "timestamp": "02:57:33", "text": "ライブストリームになります。それは基本的に"}, {"type": "subtitle", "time": 10657.67, "timestamp": "02:57:37", "text": "再放送。前回の再放送です"}, {"type": "subtitle", "time": 10661.75, "timestamp": "02:57:41", "text": "私がストリーミングしたコンテンツ"}, {"type": "subtitle", "time": 10664.79, "timestamp": "02:57:44", "text": "ギャップのニーズ"}, {"type": "subtitle", "time": 10667.83, "timestamp": "02:57:47", "text": "ギャップを埋める。わかった、"}, {"type": "subtitle", "time": 10670.15, "timestamp": "02:57:50", "text": "技術的にはライブですが"}, {"type": "subtitle", "time": 10672.87, "timestamp": "02:57:52", "text": "ライブ。覚えておいてください"}, {"type": "subtitle", "time": 10678.07, "timestamp": "02:57:58", "text": "私の24倍速チャンネルに出会うたびに"}]
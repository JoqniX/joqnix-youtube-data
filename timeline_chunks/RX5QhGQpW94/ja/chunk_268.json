[{"type": "subtitle", "time": 16082.79, "timestamp": "04:28:02", "text": "私がいたセグメントを見て"}, {"type": "subtitle", "time": 16084.95, "timestamp": "04:28:04", "text": "ライブ録音 技術的な録音"}, {"type": "subtitle", "time": 16087.429, "timestamp": "04:28:07", "text": "詳細ってこと？"}, {"type": "subtitle", "time": 16090.07, "timestamp": "04:28:10", "text": "えっと、もしあなたが何をしたら評価しますか？"}, {"type": "subtitle", "time": 16092.71, "timestamp": "04:28:12", "text": "それ？"}, {"type": "subtitle", "time": 16095.189, "timestamp": "04:28:15", "text": "私の評価はどうですか？"}, {"type": "subtitle", "time": 16099.67, "timestamp": "04:28:19", "text": "もう一つ注目したいゲーム。あなたはできる"}, {"type": "subtitle", "time": 16101.91, "timestamp": "04:28:21", "text": "いつでもDMしてください。"}, {"type": "subtitle", "time": 16103.83, "timestamp": "04:28:23", "text": "そうそう。もちろん。もちろん。わかった。アウトラスト"}, {"type": "subtitle", "time": 16118.55, "timestamp": "04:28:38", "text": "いや、ホラーゲームだなんて言わないでよ。"}, {"type": "subtitle", "time": 16122.63, "timestamp": "04:28:42", "text": "ああ、それはホラーゲームだ。"}, {"type": "subtitle", "time": 16125.83, "timestamp": "04:28:45", "text": "わかりました。これを買わなければなりません。やり直しできますか"}, {"type": "subtitle", "time": 16135.11, "timestamp": "04:28:55", "text": "はい、録音しました"}]
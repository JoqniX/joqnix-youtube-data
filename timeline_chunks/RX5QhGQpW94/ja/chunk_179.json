[{"type": "subtitle", "time": 10740.15, "timestamp": "02:59:00", "text": "前にも言ったように、私は"}, {"type": "subtitle", "time": 10744.15, "timestamp": "02:59:04", "text": "存在するために自分の何かを与える"}, {"type": "subtitle", "time": 10746.79, "timestamp": "02:59:06", "text": "私がいないときにそこにいる"}, {"type": "subtitle", "time": 10749.99, "timestamp": "02:59:09", "text": "そして私のコミュニティと視聴者ができること"}, {"type": "subtitle", "time": 10754.63, "timestamp": "02:59:14", "text": "この24チャンネルから期待できるのは"}, {"type": "subtitle", "time": 10767.11, "timestamp": "02:59:27", "text": "おい、私のベースチャンネルは君が見るかもしれない"}, {"type": "subtitle", "time": 10769.99, "timestamp": "02:59:29", "text": "同じ内容をもう一度。そうなる"}, {"type": "subtitle", "time": 10774.389, "timestamp": "02:59:34", "text": "基本的にすべての古いVS"}, {"type": "subtitle", "time": 10776.389, "timestamp": "02:59:36", "text": "私の YouTube チャンネルの再生リストです。それらの"}, {"type": "subtitle", "time": 10781.11, "timestamp": "02:59:41", "text": "リサイクルされ、ここで再び敷設され、"}, {"type": "subtitle", "time": 10782.95, "timestamp": "02:59:42", "text": "そこには。それで、いくつか見ることになる"}, {"type": "subtitle", "time": 10785.67, "timestamp": "02:59:45", "text": "リサイクルとはどういう意味ですか"}, {"type": "subtitle", "time": 10787.67, "timestamp": "02:59:47", "text": "2021年のように"}, {"type": "subtitle", "time": 10796.469, "timestamp": "02:59:56", "text": "耳を作る必要はなかった"}]
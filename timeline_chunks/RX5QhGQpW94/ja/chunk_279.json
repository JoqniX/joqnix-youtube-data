[{"type": "subtitle", "time": 16743.91, "timestamp": "04:39:03", "text": "ああ、ストリーマー。ああ、タイラーのことを覚えてるよ"}, {"type": "subtitle", "time": 16747.75, "timestamp": "04:39:07", "text": "私は彼を見ていたのを覚えている"}, {"type": "subtitle", "time": 16750.949, "timestamp": "04:39:10", "text": "私はリーグを見ていないけど、"}, {"type": "subtitle", "time": 16754.15, "timestamp": "04:39:14", "text": "見たいくつかのクリップを見たのを覚えている"}, {"type": "subtitle", "time": 16757.51, "timestamp": "04:39:17", "text": "彼。覚えていますよ。私は覚えています"}, {"type": "subtitle", "time": 16759.99, "timestamp": "04:39:19", "text": "私が初めて見た日本のYouTuberは"}, {"type": "subtitle", "time": 16762.15, "timestamp": "04:39:22", "text": "パキ"}, {"type": "subtitle", "time": 16767.109, "timestamp": "04:39:27", "text": "私は今でも彼女のことを覚えています。私は見ているようだった"}, {"type": "subtitle", "time": 16771.59, "timestamp": "04:39:31", "text": "日本のストリームとYouTuberで"}, {"type": "subtitle", "time": 16775.029, "timestamp": "04:39:35", "text": "VTuberタグ。そんなことも知らなかった"}, {"type": "subtitle", "time": 16778.628, "timestamp": "04:39:38", "text": "これはVTuberでした"}, {"type": "subtitle", "time": 16780.15, "timestamp": "04:39:40", "text": "それまで"}, {"type": "subtitle", "time": 16783.27, "timestamp": "04:39:43", "text": "YouTubeを始めて4、5ヶ月経った後、私は"}, {"type": "subtitle", "time": 16786.31, "timestamp": "04:39:46", "text": "キズナアイを発見しました。"}, {"type": "subtitle", "time": 16789.75, "timestamp": "04:39:49", "text": "すると私はこう思いました。「ああ、待って。"}, {"type": "subtitle", "time": 16792.47, "timestamp": "04:39:52", "text": "これがVTuberか"}, {"type": "subtitle", "time": 16794.15, "timestamp": "04:39:54", "text": "そういう感じ。」"}, {"type": "subtitle", "time": 16799.43, "timestamp": "04:39:59", "text": "そうです、それで私は偶然パキスタンに出会ったのです。"}]
[{"type": "subtitle", "time": 12064.15, "timestamp": "03:21:04", "text": "償還私はそれを見て、私はそれをする"}, {"type": "subtitle", "time": 12067.349, "timestamp": "03:21:07", "text": "その活動は"}, {"type": "subtitle", "time": 12070.389, "timestamp": "03:21:10", "text": "えっと、あなたは水分補給ストレッチと償還されましたか？"}, {"type": "subtitle", "time": 12073.349, "timestamp": "03:21:13", "text": "姿勢チェックは今私が持っていることを意味します"}, {"type": "subtitle", "time": 12076.55, "timestamp": "03:21:16", "text": "水分補給のためにストレッチをして"}, {"type": "subtitle", "time": 12081.349, "timestamp": "03:21:21", "text": "姿勢を正したりとか。"}, {"type": "subtitle", "time": 12084.63, "timestamp": "03:21:24", "text": "こんにちは、ギャンクさん。いらっしゃいませ。"}, {"type": "subtitle", "time": 12101.83, "timestamp": "03:21:41", "text": "君たちじゃないよ。ダニエル、でもあなたは"}, {"type": "subtitle", "time": 12104.63, "timestamp": "03:21:44", "text": "ユーザー名。わかった。新しい名前を作りました。"}, {"type": "subtitle", "time": 12107.804, "timestamp": "03:21:47", "text": "わかりました。電話します。"}, {"type": "subtitle", "time": 12117.429, "timestamp": "03:21:57", "text": "こんにちは、D。"}, {"type": "subtitle", "time": 12119.83, "timestamp": "03:21:59", "text": "それが私の本名です。ああ、わかったよ。ガッチャ。"}]
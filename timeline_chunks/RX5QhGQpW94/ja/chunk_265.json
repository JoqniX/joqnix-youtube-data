[{"type": "subtitle", "time": 15900.229, "timestamp": "04:25:00", "text": "[咳払い]"}, {"type": "subtitle", "time": 15902.469, "timestamp": "04:25:02", "text": "さあ行こう。"}, {"type": "subtitle", "time": 15907.03, "timestamp": "04:25:07", "text": "チャットでちょっと触れたことはないけど"}, {"type": "subtitle", "time": 15909.269, "timestamp": "04:25:09", "text": "もの。"}, {"type": "subtitle", "time": 15911.99, "timestamp": "04:25:11", "text": "うーん、でもそれはクールですね。私はしたいです"}, {"type": "subtitle", "time": 15923.189, "timestamp": "04:25:23", "text": "すべては私がやろうとしていることだから"}, {"type": "subtitle", "time": 15925.349, "timestamp": "04:25:25", "text": "コンサートとか。だから私は"}, {"type": "subtitle", "time": 15929.83, "timestamp": "04:25:29", "text": "3D 関連の Unity や Unreal を学びます。"}, {"type": "subtitle", "time": 15935.67, "timestamp": "04:25:35", "text": "でもそれは本当に素晴らしいですね"}, {"type": "subtitle", "time": 15939.269, "timestamp": "04:25:39", "text": "ご存知のとおり、ベイダーの壁を作るためです。本当にかっこいいですね。"}, {"type": "subtitle", "time": 15942.219, "timestamp": "04:25:42", "text": "それはすばらしい。"}, {"type": "subtitle", "time": 15943.03, "timestamp": "04:25:43", "text": "[笑い]"}, {"type": "subtitle", "time": 15949.349, "timestamp": "04:25:49", "text": "えっと、水を飲んでます。水分補給"}, {"type": "subtitle", "time": 15959.269, "timestamp": "04:25:59", "text": "私たちの"}]
[{"type": "subtitle", "time": 6963.03, "timestamp": "01:56:03", "text": "ライブ配信できる"}, {"type": "subtitle", "time": 6966.47, "timestamp": "01:56:06", "text": "読んでくれ"}, {"type": "subtitle", "time": 6970.39, "timestamp": "01:56:10", "text": "私が25x7をやろうと決めた理由"}, {"type": "subtitle", "time": 6973.51, "timestamp": "01:56:13", "text": "チャンネルは、そうでない人のために"}, {"type": "subtitle", "time": 6976.55, "timestamp": "01:56:16", "text": "私は日本に出発する予定です"}, {"type": "subtitle", "time": 6978.95, "timestamp": "01:56:18", "text": "4月2日26日"}, {"type": "subtitle", "time": 6982.39, "timestamp": "01:56:22", "text": "そうすれば、"}, {"type": "subtitle", "time": 6986.149, "timestamp": "01:56:26", "text": "私自身が予測できない"}, {"type": "subtitle", "time": 6989.99, "timestamp": "01:56:29", "text": "いつ戻れるか分からない"}, {"type": "subtitle", "time": 6991.83, "timestamp": "01:56:31", "text": "ストリーミングへ"}, {"type": "subtitle", "time": 6995.75, "timestamp": "01:56:35", "text": "そしてある意味で私のコンテンツは"}, {"type": "subtitle", "time": 6998.47, "timestamp": "01:56:38", "text": "基本的にライブストリーミングなので"}, {"type": "subtitle", "time": 7001.91, "timestamp": "01:56:41", "text": "動画はあちこちで見ることができますが、"}, {"type": "subtitle", "time": 7006.149, "timestamp": "01:56:46", "text": "私のライブや私が望んでいたものを見るのが大好き"}, {"type": "subtitle", "time": 7010.07, "timestamp": "01:56:50", "text": "思い出を残すために"}, {"type": "subtitle", "time": 7012.79, "timestamp": "01:56:52", "text": "何らかの方法で人々が"}, {"type": "subtitle", "time": 7017.43, "timestamp": "01:56:57", "text": "私を覚えてますか。だから私は"}]
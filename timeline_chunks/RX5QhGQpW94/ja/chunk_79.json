[{"type": "subtitle", "time": 4754.689, "timestamp": "01:19:14", "text": "わかりました。ちょっとこれをやってみましょう"}, {"type": "subtitle", "time": 4757.27, "timestamp": "01:19:17", "text": "[ため息] ああ、これをスピードランできるように。"}, {"type": "subtitle", "time": 4759.43, "timestamp": "01:19:19", "text": "えっと、ごめんなさい、私がやるのを見なきゃいけないの"}, {"type": "subtitle", "time": 4760.63, "timestamp": "01:19:20", "text": "これ。 [笑い]"}, {"type": "subtitle", "time": 4762.95, "timestamp": "01:19:22", "text": "通常は配信外で行いますが、"}, {"type": "subtitle", "time": 4767.11, "timestamp": "01:19:27", "text": "その馬鹿げたエラーが毎回表示される"}, {"type": "subtitle", "time": 4774.229, "timestamp": "01:19:34", "text": "日本語キーボードを渡さないでください。えっとこれ"}, {"type": "subtitle", "time": 4779.43, "timestamp": "01:19:39", "text": "1つ。いいえ。えっと、検索してみましょう。"}, {"type": "subtitle", "time": 4782.31, "timestamp": "01:19:42", "text": "なぜエラーが表示されるのですか?ああ、"}, {"type": "subtitle", "time": 4789.83, "timestamp": "01:19:49", "text": "さて、これが今日の配信ですね？"}, {"type": "subtitle", "time": 4792.07, "timestamp": "01:19:52", "text": "休暇から戻ってきたゴリラストリーム。始める"}, {"type": "subtitle", "time": 4795.75, "timestamp": "01:19:55", "text": "時間。すべてここにあります。"}]
[{"type": "subtitle", "time": 2404.069, "timestamp": "00:40:04", "text": "ええと、私は数学しか修了していませんが"}, {"type": "subtitle", "time": 2406.069, "timestamp": "00:40:06", "text": "完全に"}, {"type": "subtitle", "time": 2410.39, "timestamp": "00:40:10", "text": "物理12。515 20%です。ああ、それは"}, {"type": "subtitle", "time": 2412.87, "timestamp": "00:40:12", "text": "少し。休暇はどうでしたか？休暇は"}, {"type": "subtitle", "time": 2414.069, "timestamp": "00:40:14", "text": "良い。"}, {"type": "subtitle", "time": 2417.19, "timestamp": "00:40:17", "text": "家族と一緒に時間を過ごします。"}, {"type": "subtitle", "time": 2419.99, "timestamp": "00:40:19", "text": "家族と過ごす時間が必要でした。そうだった"}, {"type": "subtitle", "time": 2424.069, "timestamp": "00:40:24", "text": "良い。楽しかったです。"}, {"type": "subtitle", "time": 2427.349, "timestamp": "00:40:27", "text": "うん。それを保管しておく必要があると思う"}, {"type": "subtitle", "time": 2430.47, "timestamp": "00:40:30", "text": "写真と保存したものすべて"}, {"type": "subtitle", "time": 2438.95, "timestamp": "00:40:38", "text": "携帯電話のストレージがいっぱいです。満杯。"}, {"type": "subtitle", "time": 2444.71, "timestamp": "00:40:44", "text": "携帯電話のストレージがいっぱいです。兄貴、私には"}, {"type": "subtitle", "time": 2448.79, "timestamp": "00:40:48", "text": "メモリーカードのようなものを買ったので"}, {"type": "subtitle", "time": 2451.51, "timestamp": "00:40:51", "text": "今日。私は注文したのですが"}, {"type": "subtitle", "time": 2454.55, "timestamp": "00:40:54", "text": "家に帰る。"}, {"type": "subtitle", "time": 2456.71, "timestamp": "00:40:56", "text": "えーと"}]
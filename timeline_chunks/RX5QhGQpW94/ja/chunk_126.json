[{"type": "subtitle", "time": 7567.51, "timestamp": "02:06:07", "text": "このチャンネルはライブ配信されます"}, {"type": "subtitle", "time": 7570.629, "timestamp": "02:06:10", "text": "常に24時間365日"}, {"type": "subtitle", "time": 7572.229, "timestamp": "02:06:12", "text": "そして"}, {"type": "subtitle", "time": 7573.75, "timestamp": "02:06:13", "text": "しかし"}, {"type": "subtitle", "time": 7577.669, "timestamp": "02:06:17", "text": "私が実際にライブ配信しているわけではない"}, {"type": "subtitle", "time": 7579.75, "timestamp": "02:06:19", "text": "私のメインチャンネルです。"}, {"type": "subtitle", "time": 7581.99, "timestamp": "02:06:21", "text": "覚えておいてください"}, {"type": "subtitle", "time": 7586.31, "timestamp": "02:06:26", "text": "24の"}, {"type": "subtitle", "time": 7590.069, "timestamp": "02:06:30", "text": "24時間チャンネルが生放送される場所"}, {"type": "subtitle", "time": 7593.589, "timestamp": "02:06:33", "text": "私もライブで参加しますが"}, {"type": "subtitle", "time": 7596.79, "timestamp": "02:06:36", "text": "将来はいつでも"}, {"type": "subtitle", "time": 7600.149, "timestamp": "02:06:40", "text": "私のメインチャンネルで24時間ライブ配信"}, {"type": "subtitle", "time": 7603.51, "timestamp": "02:06:43", "text": "ストリームは一時停止されますが、それでも"}, {"type": "subtitle", "time": 7605.189, "timestamp": "02:06:45", "text": "ライブ。"}, {"type": "subtitle", "time": 7610.87, "timestamp": "02:06:50", "text": "24時間チャンネルを見るたびに"}, {"type": "subtitle", "time": 7614.069, "timestamp": "02:06:54", "text": "ライブでは、すべての"}, {"type": "subtitle", "time": 7618.629, "timestamp": "02:06:58", "text": "ジョグネックスの過去の思い出"}]
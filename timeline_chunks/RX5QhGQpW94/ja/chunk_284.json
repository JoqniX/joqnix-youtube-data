[{"type": "subtitle", "time": 17041.11, "timestamp": "04:44:01", "text": "インド。もしそれが可能で、あなたが"}, {"type": "subtitle", "time": 17043.67, "timestamp": "04:44:03", "text": "それについて研究しなければなりません。もしそれが"}, {"type": "subtitle", "time": 17047.35, "timestamp": "04:44:07", "text": "可能だ、俺はそれをやるつもりだ。"}, {"type": "subtitle", "time": 17049.35, "timestamp": "04:44:09", "text": "それをやらなきゃいけない。そうすれば私は"}, {"type": "subtitle", "time": 17052.55, "timestamp": "04:44:12", "text": "自動的にシャットダウン、起動"}, {"type": "subtitle", "time": 17056.55, "timestamp": "04:44:16", "text": "すべてですよね？それらすべて。"}, {"type": "subtitle", "time": 17060.47, "timestamp": "04:44:20", "text": "この設定をローカルで実行する必要があるため、"}, {"type": "subtitle", "time": 17062.708, "timestamp": "04:44:22", "text": "右？"}, {"type": "subtitle", "time": 17065.27, "timestamp": "04:44:25", "text": "それで、"}, {"type": "subtitle", "time": 17067.51, "timestamp": "04:44:27", "text": "そうだ、ユーザーマップを完成させないといけない"}, {"type": "subtitle", "time": 17071.11, "timestamp": "04:44:31", "text": "システム。明日はどうなるか分からない"}, {"type": "subtitle", "time": 17073.03, "timestamp": "04:44:33", "text": "ストリーミング中です。私はただ"}, {"type": "subtitle", "time": 17075.67, "timestamp": "04:44:35", "text": "出席する会議。"}, {"type": "subtitle", "time": 17078.23, "timestamp": "04:44:38", "text": "また、今月はビデオも配信します"}, {"type": "subtitle", "time": 17082.15, "timestamp": "04:44:42", "text": "コンテンツ、ショット、ビデオが増えます。私"}, {"type": "subtitle", "time": 17085.75, "timestamp": "04:44:45", "text": "それをしなければなりません。私はちょっと"}, {"type": "subtitle", "time": 17087.91, "timestamp": "04:44:47", "text": "何をしたいのかブレインストーミングして"}, {"type": "subtitle", "time": 17091.27, "timestamp": "04:44:51", "text": "すべて。それから私の新しい、そして新しい"}, {"type": "subtitle", "time": 17093.99, "timestamp": "04:44:53", "text": "モデルのもの、それは"}, {"type": "subtitle", "time": 17096.31, "timestamp": "04:44:56", "text": "ハプニング。おそらくこれについては分からない"}, {"type": "subtitle", "time": 17099.03, "timestamp": "04:44:59", "text": "月か、いや、今月ではない、おそらく来月"}]
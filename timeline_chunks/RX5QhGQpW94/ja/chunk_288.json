[{"type": "subtitle", "time": 17280.31, "timestamp": "04:48:00", "text": "私を襲撃するのです。でも、ありがとう。"}, {"type": "subtitle", "time": 17284.15, "timestamp": "04:48:04", "text": "ということで、"}, {"type": "subtitle", "time": 17285.91, "timestamp": "04:48:05", "text": "今日。"}, {"type": "subtitle", "time": 17289.43, "timestamp": "04:48:09", "text": "でも、あなたの申し出を受けるよ"}, {"type": "subtitle", "time": 17293.75, "timestamp": "04:48:13", "text": "最後のOutlastトライアルを終えたとき。"}, {"type": "subtitle", "time": 17297.19, "timestamp": "04:48:17", "text": "コラボできるようにDMを送ります。"}, {"type": "subtitle", "time": 17299.91, "timestamp": "04:48:19", "text": "楽しいでしょうね。"}, {"type": "subtitle", "time": 17302.628, "timestamp": "04:48:22", "text": "長い間コラボをしていません。"}, {"type": "subtitle", "time": 17308.708, "timestamp": "04:48:28", "text": "コラボするのが懐かしいです。それで"}, {"type": "subtitle", "time": 17311.27, "timestamp": "04:48:31", "text": "ええ、今年は私にとって大変でした。"}, {"type": "subtitle", "time": 17316.07, "timestamp": "04:48:36", "text": "大変ではないけど、忙しすぎる。"}, {"type": "subtitle", "time": 17319.83, "timestamp": "04:48:39", "text": "だからコラージュをするのが懐かしいんです。でも、これは"}, {"type": "subtitle", "time": 17323.43, "timestamp": "04:48:43", "text": "私の唯一の月、右、左。"}, {"type": "subtitle", "time": 17326.39, "timestamp": "04:48:46", "text": "私は時間をかけて集中することができました"}, {"type": "subtitle", "time": 17328.47, "timestamp": "04:48:48", "text": "ストリームとか他のものかな？私は思う"}]
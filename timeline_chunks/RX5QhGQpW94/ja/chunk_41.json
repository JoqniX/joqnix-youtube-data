[{"type": "subtitle", "time": 2460.39, "timestamp": "00:41:00", "text": "256GBのメモリカードのようなものでした"}, {"type": "subtitle", "time": 2463.99, "timestamp": "00:41:03", "text": "サンディスク。私の携帯電話の内部ストレージ"}, {"type": "subtitle", "time": 2466.63, "timestamp": "00:41:06", "text": "ストレージは現在 128 です。そして私はこう思いました"}, {"type": "subtitle", "time": 2469.589, "timestamp": "00:41:09", "text": "「わかりました。エラーが出ないようにします"}, {"type": "subtitle", "time": 2472.71, "timestamp": "00:41:12", "text": "デバイスのストレージがないというメッセージが表示されたら"}, {"type": "subtitle", "time": 2476.39, "timestamp": "00:41:16", "text": "「メモリ、新しいメモリカードを挿入してください。」"}, {"type": "subtitle", "time": 2478.63, "timestamp": "00:41:18", "text": "そして私はこう思いました"}, {"type": "subtitle", "time": 2482.15, "timestamp": "00:41:22", "text": "「ああ、もうこんなことはやめた。」でも私は"}, {"type": "subtitle", "time": 2486.47, "timestamp": "00:41:26", "text": "間違っている。これらすべてのアプリ。いいえ、私は"}, {"type": "subtitle", "time": 2490.47, "timestamp": "00:41:30", "text": "似たようなアプリケーションを見ると"}, {"type": "subtitle", "time": 2492.79, "timestamp": "00:41:32", "text": "プレイストアのように、ランダムにインストールするだけです"}, {"type": "subtitle", "time": 2496.069, "timestamp": "00:41:36", "text": "それを使わないと「ああ、これを使えば"}, {"type": "subtitle", "time": 2498.39, "timestamp": "00:41:38", "text": "何かのために、そして私は忘れるだろう"}, {"type": "subtitle", "time": 2502.55, "timestamp": "00:41:42", "text": "「それについて」そしてその時が来たら"}, {"type": "subtitle", "time": 2505.109, "timestamp": "00:41:45", "text": "片付けなければいけないと感じる場所"}, {"type": "subtitle", "time": 2507.829, "timestamp": "00:41:47", "text": "いくつかのストレージとアンインストールこれら"}, {"type": "subtitle", "time": 2509.67, "timestamp": "00:41:49", "text": "アプリケーション"}, {"type": "subtitle", "time": 2514.563, "timestamp": "00:41:54", "text": "えっと、私はああ、私は"}, {"type": "subtitle", "time": 2516.15, "timestamp": "00:41:56", "text": "[鼻を鳴らす]"}, {"type": "subtitle", "time": 2519.349, "timestamp": "00:41:59", "text": "私がそうではないことを知るにはクリックする必要があります"}]
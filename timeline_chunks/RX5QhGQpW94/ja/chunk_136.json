[{"type": "subtitle", "time": 8163.51, "timestamp": "02:16:03", "text": "正しいと言っても"}, {"type": "subtitle", "time": 8183.51, "timestamp": "02:16:23", "text": "おお"}, {"type": "subtitle", "time": 8185.83, "timestamp": "02:16:25", "text": "わかりました。ドキュメントを開いて、終わらせます。"}, {"type": "subtitle", "time": 8188.87, "timestamp": "02:16:28", "text": "編集は、ええと"}, {"type": "subtitle", "time": 8191.35, "timestamp": "02:16:31", "text": "8分間のビデオを終わらせるよ"}, {"type": "subtitle", "time": 8195.509, "timestamp": "02:16:35", "text": "急いでスピードランして、それから"}, {"type": "subtitle", "time": 8197.589, "timestamp": "02:16:37", "text": "技術ビデオ。わかりました。それでは"}, {"type": "subtitle", "time": 8209.349, "timestamp": "02:16:49", "text": "インド版ウイルスは"}, {"type": "subtitle", "time": 8213.589, "timestamp": "02:16:53", "text": "原因は いいえ、いいえ、いいえ、それではありません。いやいや。"}]
[{"type": "subtitle", "time": 5101.83, "timestamp": "01:25:01", "text": "何を知ってる？"}, {"type": "subtitle", "time": 5105.11, "timestamp": "01:25:05", "text": "ボタンを無効にして"}, {"type": "subtitle", "time": 5110.149, "timestamp": "01:25:10", "text": "わからないからわからない"}, {"type": "subtitle", "time": 5112.47, "timestamp": "01:25:12", "text": "えっと、どこですか？"}, {"type": "subtitle", "time": 5114.39, "timestamp": "01:25:14", "text": "私はこれを無効にしたいので"}, {"type": "subtitle", "time": 5116.39, "timestamp": "01:25:16", "text": "邪魔されないでください。"}, {"type": "subtitle", "time": 5119.669, "timestamp": "01:25:19", "text": "配信中にこれを修正する時間がありません。"}, {"type": "subtitle", "time": 5122.149, "timestamp": "01:25:22", "text": "ああ、わかりました。ボタンを無効にします。"}, {"type": "subtitle", "time": 5124.629, "timestamp": "01:25:24", "text": "ああ、すぐに録音を始めなければいけません。わかった。"}, {"type": "subtitle", "time": 5126.229, "timestamp": "01:25:26", "text": "えーっと"}, {"type": "subtitle", "time": 5137.11, "timestamp": "01:25:37", "text": "いや、私にそんなことはしないで。"}, {"type": "subtitle", "time": 5138.709, "timestamp": "01:25:38", "text": "わかった。わかった。わかった。接続する。接続する。"}]
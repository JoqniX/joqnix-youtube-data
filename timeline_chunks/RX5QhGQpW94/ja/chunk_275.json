[{"type": "subtitle", "time": 16501.029, "timestamp": "04:35:01", "text": "Streamer でこれを行うことができます。混ぜる"}, {"type": "subtitle", "time": 16504.31, "timestamp": "04:35:04", "text": "もし他のツールを使うなら"}, {"type": "subtitle", "time": 16508.144, "timestamp": "04:35:08", "text": "そこには。はい、基本的には簡単です。"}, {"type": "subtitle", "time": 16509.109, "timestamp": "04:35:09", "text": "[笑い]"}, {"type": "subtitle", "time": 16513.59, "timestamp": "04:35:13", "text": "簡単ではありませんが、少し複雑です。"}, {"type": "subtitle", "time": 16516.869, "timestamp": "04:35:16", "text": "でもそうだね。 [笑い]"}, {"type": "subtitle", "time": 16519.91, "timestamp": "04:35:19", "text": "私の設定は3つのボタンで動作します"}, {"type": "subtitle", "time": 16521.51, "timestamp": "04:35:21", "text": "あれ。"}, {"type": "subtitle", "time": 16523.99, "timestamp": "04:35:23", "text": "完全に自動化されています。する必要はない"}, {"type": "subtitle", "time": 16527.429, "timestamp": "04:35:27", "text": "何かに触れてください。毎週土曜日に新作演劇"}, {"type": "subtitle", "time": 16531.189, "timestamp": "04:35:31", "text": "作成したプレイリストが選択され、"}, {"type": "subtitle", "time": 16535.99, "timestamp": "04:35:35", "text": "自動的に作成されます。それで今週は"}, {"type": "subtitle", "time": 16539.99, "timestamp": "04:35:39", "text": "バトルフィールド4、デスティニー2、ピアノです"}, {"type": "subtitle", "time": 16541.51, "timestamp": "04:35:41", "text": "学ぶ。"}, {"type": "subtitle", "time": 16543.349, "timestamp": "04:35:43", "text": "えっと、ピアノの練習ですよね？うん、ピアノ"}, {"type": "subtitle", "time": 16547.029, "timestamp": "04:35:47", "text": "学ぶ。それで、来週はああ神様"}, {"type": "subtitle", "time": 16554.07, "timestamp": "04:35:54", "text": "そこで、それに関する短いビデオを作りました。また、"}]
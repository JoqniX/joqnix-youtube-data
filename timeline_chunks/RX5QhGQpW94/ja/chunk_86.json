[{"type": "subtitle", "time": 5168.55, "timestamp": "01:26:08", "text": "いいえ。これをやめてもいいですか？"}, {"type": "subtitle", "time": 5176.87, "timestamp": "01:26:16", "text": "なんという就職フェアだ。"}, {"type": "subtitle", "time": 5180.87, "timestamp": "01:26:20", "text": "クレイジー。わかりました。これをブロックします"}, {"type": "subtitle", "time": 5183.189, "timestamp": "01:26:23", "text": "ボタン。"}, {"type": "subtitle", "time": 5185.51, "timestamp": "01:26:25", "text": "ブロックします"}, {"type": "subtitle", "time": 5188.149, "timestamp": "01:26:28", "text": "このボタン。"}, {"type": "subtitle", "time": 5207.189, "timestamp": "01:26:47", "text": "うん。大丈夫。あなたもね。わかった。"}, {"type": "subtitle", "time": 5209.91, "timestamp": "01:26:49", "text": "ああ、わかりました。すべてがブロックされていますよね？"}, {"type": "subtitle", "time": 5212.629, "timestamp": "01:26:52", "text": "わかった。わかった。わかった。"}, {"type": "subtitle", "time": 5215.11, "timestamp": "01:26:55", "text": "しなければならない"}, {"type": "subtitle", "time": 5217.189, "timestamp": "01:26:57", "text": "ストリーム外で修正します。いいえ、いいえ"}]
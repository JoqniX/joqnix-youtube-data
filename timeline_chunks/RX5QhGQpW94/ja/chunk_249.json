[{"type": "subtitle", "time": 14940.95, "timestamp": "04:09:00", "text": "人々がコミュニティにできる場所"}, {"type": "subtitle", "time": 14942.469, "timestamp": "04:09:02", "text": "投票する"}, {"type": "subtitle", "time": 14946.229, "timestamp": "04:09:06", "text": "再放送されます。それは"}, {"type": "subtitle", "time": 14949.51, "timestamp": "04:09:09", "text": "私も24倍速に欲しいもの"}, {"type": "subtitle", "time": 14952.229, "timestamp": "04:09:12", "text": "チャネル。"}, {"type": "subtitle", "time": 14955.99, "timestamp": "04:09:15", "text": "むしろ、"}, {"type": "subtitle", "time": 14960.71, "timestamp": "04:09:20", "text": "ランダムに選ばれたプレイリストのようなものではなく"}, {"type": "subtitle", "time": 14964.79, "timestamp": "04:09:24", "text": "私は聴衆にそう伝えることができるし、皆さんにもそう伝えることができる"}, {"type": "subtitle", "time": 14968.07, "timestamp": "04:09:28", "text": "どのような種類のコンテンツを作成したいかを決めます"}, {"type": "subtitle", "time": 14973.03, "timestamp": "04:09:33", "text": "再生されます。それは本当に良いことです。そして"}, {"type": "subtitle", "time": 14976.87, "timestamp": "04:09:36", "text": "投票コンテンツが終わったら、"}, {"type": "subtitle", "time": 14979.189, "timestamp": "04:09:39", "text": "あなたはいつでも頼ることができます"}, {"type": "subtitle", "time": 14982.07, "timestamp": "04:09:42", "text": "ランダム化されたコンデントも週または"}, {"type": "subtitle", "time": 14985.67, "timestamp": "04:09:45", "text": "もう一度投票機能を実行するかもしれません。ええ、私は"}, {"type": "subtitle", "time": 14988.309, "timestamp": "04:09:48", "text": "頭の中にはたくさんのアイデアがある"}, {"type": "subtitle", "time": 14991.11, "timestamp": "04:09:51", "text": "バージョン6と7。"}, {"type": "subtitle", "time": 14994.71, "timestamp": "04:09:54", "text": "しかし今のところ、これはバージョン5です"}, {"type": "subtitle", "time": 14998.79, "timestamp": "04:09:58", "text": "私のVサイクルシステム。"}]
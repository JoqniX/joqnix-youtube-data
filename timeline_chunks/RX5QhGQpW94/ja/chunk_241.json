[{"type": "subtitle", "time": 14461.59, "timestamp": "04:01:01", "text": "ええ、それで後退するので私は"}, {"type": "subtitle", "time": 14465.269, "timestamp": "04:01:05", "text": "もし"}, {"type": "subtitle", "time": 14472.07, "timestamp": "04:01:12", "text": "キュレーションされた単語の場合。それで何が起こるか"}, {"type": "subtitle", "time": 14475.189, "timestamp": "04:01:15", "text": "ここに、厳選されたビデオがすべてあります"}, {"type": "subtitle", "time": 14479.91, "timestamp": "04:01:19", "text": "最大数動画は"}, {"type": "subtitle", "time": 14483.269, "timestamp": "04:01:23", "text": "埋め込みプレイリストに入れます。それは"}, {"type": "subtitle", "time": 14485.91, "timestamp": "04:01:25", "text": "numの最大数を設定できます"}, {"type": "subtitle", "time": 14489.51, "timestamp": "04:01:29", "text": "ビデオミニマム[音楽]とええとグローバル"}, {"type": "subtitle", "time": 14492.63, "timestamp": "04:01:32", "text": "ビデオ数。クリエイターのプレイリストは"}, {"type": "subtitle", "time": 14495.03, "timestamp": "04:01:35", "text": "常に10本のビデオ[音楽]を用意する"}, {"type": "subtitle", "time": 14497.99, "timestamp": "04:01:37", "text": "大きさに関係なく。"}, {"type": "subtitle", "time": 14501.83, "timestamp": "04:01:41", "text": "厳選された動画はすべて10本です。つまり10本"}, {"type": "subtitle", "time": 14505.03, "timestamp": "04:01:45", "text": "チャンネルごとの再生リストの動画数は"}, {"type": "subtitle", "time": 14509.11, "timestamp": "04:01:49", "text": "追加した。残りは"}, {"type": "subtitle", "time": 14517.03, "timestamp": "04:01:57", "text": "だから、見せればもっと簡単になります"}]
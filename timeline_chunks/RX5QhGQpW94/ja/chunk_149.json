[{"type": "subtitle", "time": 8941.83, "timestamp": "02:29:01", "text": "今日。心配しないで。すぐに治りますよ"}, {"type": "subtitle", "time": 8943.11, "timestamp": "02:29:03", "text": "考える。"}, {"type": "subtitle", "time": 8945.51, "timestamp": "02:29:05", "text": "待って、30歳くらいの人かな？"}, {"type": "subtitle", "time": 8950.07, "timestamp": "02:29:10", "text": "分、40分ですか？くそ。"}, {"type": "subtitle", "time": 8953.59, "timestamp": "02:29:13", "text": "待って、私は"}, {"type": "subtitle", "time": 8955.67, "timestamp": "02:29:15", "text": "ああ、待って、待って、待って。まるで彼が"}, {"type": "subtitle", "time": 8959.27, "timestamp": "02:29:19", "text": "ストリーム全体は表示されません。のみ"}, {"type": "subtitle", "time": 8962.79, "timestamp": "02:29:22", "text": "そのセグメントのゲームプレイのみを表示します"}, {"type": "subtitle", "time": 8965.75, "timestamp": "02:29:25", "text": "その特定のストリームの。ああ、それは"}, {"type": "subtitle", "time": 8968.07, "timestamp": "02:29:28", "text": "頭いい。"}, {"type": "subtitle", "time": 8970.71, "timestamp": "02:29:30", "text": "ああ、それは賢いですね。ああ、それは本当に"}, {"type": "subtitle", "time": 8982.71, "timestamp": "02:29:42", "text": "つまり、これはライブ配信ではなく、"}, {"type": "subtitle", "time": 8988.469, "timestamp": "02:29:48", "text": "ビデオ。ああ、それはとても賢いですね。"}, {"type": "subtitle", "time": 8994.79, "timestamp": "02:29:54", "text": "Twitchで配信していたら、Twitchで"}, {"type": "subtitle", "time": 8997.429, "timestamp": "02:29:57", "text": "私の主な仕事は、"}]
[{"type": "subtitle", "time": 721.829, "timestamp": "00:12:01", "text": "ユーチューブで言ったように"}, {"type": "subtitle", "time": 724.47, "timestamp": "00:12:04", "text": "コミュニティ投稿をチェックしていない場合は"}, {"type": "subtitle", "time": 728.71, "timestamp": "00:12:08", "text": "ぜひお気軽にチェックしてみてください。えーと"}, {"type": "subtitle", "time": 732.389, "timestamp": "00:12:12", "text": "ああ、これが最後になるだろう"}, {"type": "subtitle", "time": 738.71, "timestamp": "00:12:18", "text": "家族と一緒に過ごすためです。楽しむ、"}, {"type": "subtitle", "time": 741.19, "timestamp": "00:12:21", "text": "楽しかった、"}, {"type": "subtitle", "time": 743.829, "timestamp": "00:12:23", "text": "楽しかったです。"}, {"type": "subtitle", "time": 748.87, "timestamp": "00:12:28", "text": "えっと、いくつか画像を投稿しました"}, {"type": "subtitle", "time": 752.31, "timestamp": "00:12:32", "text": "鳥やら何やらを撮影しました"}, {"type": "subtitle", "time": 757.829, "timestamp": "00:12:37", "text": "ええと、ビーチのような特定の場所"}, {"type": "subtitle", "time": 761.108, "timestamp": "00:12:41", "text": "1つまたは何か。それはまるで"}, {"type": "subtitle", "time": 762.79, "timestamp": "00:12:42", "text": "[咳払い]"}, {"type": "subtitle", "time": 766.629, "timestamp": "00:12:46", "text": "ええと、いくつかの教会を訪問しました。えっと、私は"}, {"type": "subtitle", "time": 769.35, "timestamp": "00:12:49", "text": "いくつかの教会を訪問しました。えっと、何ですか"}, {"type": "subtitle", "time": 772.389, "timestamp": "00:12:52", "text": "これ？一体何なんだ？はい、訪問しました"}, {"type": "subtitle", "time": 775.35, "timestamp": "00:12:55", "text": "いくつかの教会と"}, {"type": "subtitle", "time": 779.43, "timestamp": "00:12:59", "text": "えーと、ビーチ。写真を投稿しましたか？"}]
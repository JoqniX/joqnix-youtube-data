[{"type": "subtitle", "time": 12602.55, "timestamp": "03:30:02", "text": "でも、ウェブカスタムは必要ありません"}, {"type": "subtitle", "time": 12605.91, "timestamp": "03:30:05", "text": "Webサイト。リンクを使うだけでいい"}, {"type": "subtitle", "time": 12607.67, "timestamp": "03:30:07", "text": "ええと、例えば"}, {"type": "subtitle", "time": 12615.75, "timestamp": "03:30:15", "text": "YouTube からログオフするのをやめます。わかった、"}, {"type": "subtitle", "time": 12617.67, "timestamp": "03:30:17", "text": "気をつけて。おやすみ。おやすみ。良い"}, {"type": "subtitle", "time": 12619.365, "timestamp": "03:30:19", "text": "夜。"}, {"type": "subtitle", "time": 12621.11, "timestamp": "03:30:21", "text": "[咳払い]"}]
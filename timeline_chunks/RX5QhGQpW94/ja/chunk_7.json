[{"type": "subtitle", "time": 421.749, "timestamp": "00:07:01", "text": "非公開のストリームとテスト"}, {"type": "subtitle", "time": 425.749, "timestamp": "00:07:05", "text": "すべて。つまり、すべてがうまくいっている"}, {"type": "subtitle", "time": 427.83, "timestamp": "00:07:07", "text": "そして"}, {"type": "subtitle", "time": 431.639, "timestamp": "00:07:11", "text": "すべては嘘だった。」"}, {"type": "subtitle", "time": 432.309, "timestamp": "00:07:12", "text": "[笑い]"}, {"type": "subtitle", "time": 435.35, "timestamp": "00:07:15", "text": "クレイジーだよ。それはただクレイジーです。でも、"}, {"type": "subtitle", "time": 440.15, "timestamp": "00:07:20", "text": "皆さんお元気ですか？こんにちは、ようこそ。"}, {"type": "subtitle", "time": 441.189, "timestamp": "00:07:21", "text": "待って、[咳払い] 倍にさせて"}, {"type": "subtitle", "time": 453.67, "timestamp": "00:07:33", "text": "ええ、今日は私たちは、ええと、私は、ええと、"}, {"type": "subtitle", "time": 457.99, "timestamp": "00:07:37", "text": "えっと、今日はゴリラみたいに"}, {"type": "subtitle", "time": 460.30899999999997, "timestamp": "00:07:40", "text": "ストリーム。予定外の配信です。もしあなたが"}, {"type": "subtitle", "time": 462.629, "timestamp": "00:07:42", "text": "ゴリラが何なのか分からない、それは"}, {"type": "subtitle", "time": 464.71, "timestamp": "00:07:44", "text": "予定外のストリーム。"}, {"type": "subtitle", "time": 466.30899999999997, "timestamp": "00:07:46", "text": "えーと"}, {"type": "subtitle", "time": 469.99, "timestamp": "00:07:49", "text": "ええ、休暇から戻ったばかりです"}, {"type": "subtitle", "time": 473.99, "timestamp": "00:07:53", "text": "そして戻ってきました。だから、私はただ"}, {"type": "subtitle", "time": 476.39, "timestamp": "00:07:56", "text": "えっと、ちょっとみんなとゆっくりして"}]
[{"type": "subtitle", "time": 13320.71, "timestamp": "03:42:00", "text": "今回は少しだけお見せすると"}, {"type": "subtitle", "time": 13325.429, "timestamp": "03:42:05", "text": "それの。ああ、そうだね。そこで今回私がやったことは"}, {"type": "subtitle", "time": 13330.71, "timestamp": "03:42:10", "text": "それはチェックされるので、それは私の"}, {"type": "subtitle", "time": 13333.429, "timestamp": "03:42:13", "text": "Twitchカテゴリーでストリーミングしているとき"}, {"type": "subtitle", "time": 13336.229, "timestamp": "03:42:16", "text": "Twitch、YouTube、Kick。確認します"}, {"type": "subtitle", "time": 13338.79, "timestamp": "03:42:18", "text": "[音楽]の現在のカテゴリーは何ですか"}, {"type": "subtitle", "time": 13341.269, "timestamp": "03:42:21", "text": "トゥイッチ。だから、私がこんなゲームをプレイしていると"}, {"type": "subtitle", "time": 13344.55, "timestamp": "03:42:24", "text": "アークレイダーズとか、"}, {"type": "subtitle", "time": 13348.309, "timestamp": "03:42:28", "text": "それを認識できるようにしてください"}, {"type": "subtitle", "time": 13351.03, "timestamp": "03:42:31", "text": "私はアークレイダースをプレイしていますが"}, {"type": "subtitle", "time": 13352.63, "timestamp": "03:42:32", "text": "リンク。"}, {"type": "subtitle", "time": 13355.11, "timestamp": "03:42:35", "text": "プレイリストをリンクできるようにしました。"}, {"type": "subtitle", "time": 13358.15, "timestamp": "03:42:38", "text": "つまり、これは手動で行う必要がありました"}, {"type": "subtitle", "time": 13361.429, "timestamp": "03:42:41", "text": "それ。ご覧の通り、私は"}, {"type": "subtitle", "time": 13365.11, "timestamp": "03:42:45", "text": "YouTubeのプレイリストを手動でリンクする"}, {"type": "subtitle", "time": 13369.91, "timestamp": "03:42:49", "text": "これ。それぞれのゲームの種類ごとに"}, {"type": "subtitle", "time": 13372.07, "timestamp": "03:42:52", "text": "カテゴリータイプをリンクする必要がありました"}, {"type": "subtitle", "time": 13374.79, "timestamp": "03:42:54", "text": "YouTubeチャンネルのYouTube再生リスト。"}, {"type": "subtitle", "time": 13378.55, "timestamp": "03:42:58", "text": "これが3回目の反復です"}]
[{"type": "subtitle", "time": 3730.87, "timestamp": "01:02:10", "text": "また、新しいことに取り組んでいます。させて"}, {"type": "subtitle", "time": 3734.23, "timestamp": "01:02:14", "text": "それをちょっと見せてもらってもいいですか？それで、あなたは"}, {"type": "subtitle", "time": 3737.91, "timestamp": "01:02:17", "text": "知ってるよ、これは私が生まれて以来の夢だった"}, {"type": "subtitle", "time": 3741.829, "timestamp": "01:02:21", "text": "この大物Twitchストリーマーに触発されて"}, {"type": "subtitle", "time": 3744.789, "timestamp": "01:02:24", "text": "コイル化と呼ばれます。あなたは彼を知っているかも知れません。"}, {"type": "subtitle", "time": 3748.23, "timestamp": "01:02:28", "text": "彼は大のストリーマーであり、コンテンツクリエイターです。"}, {"type": "subtitle", "time": 3751.75, "timestamp": "01:02:31", "text": "Co. それで、えーと、Co が今これを持っています。あなた"}, {"type": "subtitle", "time": 3753.75, "timestamp": "01:02:33", "text": "Twitchアカウントでログインできます"}, {"type": "subtitle", "time": 3757.27, "timestamp": "01:02:37", "text": "彼のウェブサイトで。"}, {"type": "subtitle", "time": 3759.829, "timestamp": "01:02:39", "text": "えっと、ログインして、えっと、彼の、えっと、"}, {"type": "subtitle", "time": 3761.43, "timestamp": "01:02:41", "text": "はい、Twitchでログインできます"}, {"type": "subtitle", "time": 3765.03, "timestamp": "01:02:45", "text": "彼のウェブサイトにアカウントを作成します。えっと、これは"}, {"type": "subtitle", "time": 3767.03, "timestamp": "01:02:47", "text": "フォーラム。気にしないでください。私たちがなぜ"}, {"type": "subtitle", "time": 3769.829, "timestamp": "01:02:49", "text": "ここを見ているのは"}, {"type": "subtitle", "time": 3774.47, "timestamp": "01:02:54", "text": "えっと、このワントークンストア。だから人々は"}, {"type": "subtitle", "time": 3779.109, "timestamp": "01:02:59", "text": "彼の視聴者はトークンを獲得できる"}]
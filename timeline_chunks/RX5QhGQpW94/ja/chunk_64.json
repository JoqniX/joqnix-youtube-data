[{"type": "subtitle", "time": 3842.309, "timestamp": "01:04:02", "text": "それで、これは私に大きなインスピレーションを与えました。だから私は"}, {"type": "subtitle", "time": 3845.91, "timestamp": "01:04:05", "text": "チャド・GPunと話すチン"}, {"type": "subtitle", "time": 3848.87, "timestamp": "01:04:08", "text": "私はこのシステムを作っていました"}, {"type": "subtitle", "time": 3851.589, "timestamp": "01:04:11", "text": "統一って言えますか？わかった。統一"}, {"type": "subtitle", "time": 3853.75, "timestamp": "01:04:13", "text": "ユーザーマップ。それでは、"}, {"type": "subtitle", "time": 3865.67, "timestamp": "01:04:25", "text": "えっと、ユーザーマップ。わかった。それで"}, {"type": "subtitle", "time": 3868.309, "timestamp": "01:04:28", "text": "ユーザーはどこにいますか?わかった。だから全ての人々は"}, {"type": "subtitle", "time": 3873.19, "timestamp": "01:04:33", "text": "私の24時間年中無休のチャンネルでチャットしている人"}, {"type": "subtitle", "time": 3878.23, "timestamp": "01:04:38", "text": "そしてメインチャンネルは"}, {"type": "subtitle", "time": 3883.27, "timestamp": "01:04:43", "text": "ユーザー。カスタマイズ可能なUIを手に入れよう"}, {"type": "subtitle", "time": 3885.91, "timestamp": "01:04:45", "text": "カスタマイズできません。内部"}, {"type": "subtitle", "time": 3891.43, "timestamp": "01:04:51", "text": "UIDとパブリックUIDは"}, {"type": "subtitle", "time": 3894.15, "timestamp": "01:04:54", "text": "一番下のゲームをプレイする場合"}, {"type": "subtitle", "time": 3897.91, "timestamp": "01:04:57", "text": "画面にはユーザーIDが表示されます"}]
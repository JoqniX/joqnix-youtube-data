[{"type": "subtitle", "time": 1561.43, "timestamp": "00:26:01", "text": "そういう感じ。"}, {"type": "subtitle", "time": 1564.549, "timestamp": "00:26:04", "text": "私のクラスメイトのほとんどは、"}, {"type": "subtitle", "time": 1566.549, "timestamp": "00:26:06", "text": "高校時代と大学時代。全て"}, {"type": "subtitle", "time": 1568.87, "timestamp": "00:26:08", "text": "それらのほとんどは、いくつかのようなものです"}, {"type": "subtitle", "time": 1573.029, "timestamp": "00:26:13", "text": "ここに定住している人もいれば、海外にいる人もいる"}, {"type": "subtitle", "time": 1575.83, "timestamp": "00:26:15", "text": "そういう感じ。"}, {"type": "subtitle", "time": 1579.43, "timestamp": "00:26:19", "text": "そして状況は悪化しました。"}, {"type": "subtitle", "time": 1583.19, "timestamp": "00:26:23", "text": "Hこんにちは猛烈な歓迎です。どのように"}, {"type": "subtitle", "time": 1586.87, "timestamp": "00:26:26", "text": "何をしてるの？元気ですか？元気ですか？"}, {"type": "subtitle", "time": 1589.83, "timestamp": "00:26:29", "text": "人生はどうですか？どんな状況でも"}, {"type": "subtitle", "time": 1593.83, "timestamp": "00:26:33", "text": "間違っている。こんにちは、D。あなたを知っています。心配しないで。"}, {"type": "subtitle", "time": 1596.31, "timestamp": "00:26:36", "text": "名前は変わりましたか？何が"}, {"type": "subtitle", "time": 1598.31, "timestamp": "00:26:38", "text": "ゴリラはタイトルで言及している"}, {"type": "subtitle", "time": 1601.43, "timestamp": "00:26:41", "text": "ストリーム？ちなみにゴリラとは"}, {"type": "subtitle", "time": 1603.269, "timestamp": "00:26:43", "text": "えーと"}, {"type": "subtitle", "time": 1606.47, "timestamp": "00:26:46", "text": "ゴリラとは、計画性がなく、組織化されていない、"}, {"type": "subtitle", "time": 1609.99, "timestamp": "00:26:49", "text": "計画外の予期せぬストリーム。"}, {"type": "subtitle", "time": 1612.23, "timestamp": "00:26:52", "text": "彼らはただ希望を抱いて去ったわけではないと思います。あなた"}, {"type": "subtitle", "time": 1615.19, "timestamp": "00:26:55", "text": "計画すらありません。私には計画がある。私"}, {"type": "subtitle", "time": 1618.47, "timestamp": "00:26:58", "text": "すでに説明しました"}]
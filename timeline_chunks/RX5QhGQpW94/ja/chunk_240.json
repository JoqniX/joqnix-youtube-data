[{"type": "subtitle", "time": 14400.79, "timestamp": "04:00:00", "text": "それは起こる"}, {"type": "subtitle", "time": 14403.83, "timestamp": "04:00:03", "text": "いつでも"}, {"type": "subtitle", "time": 14406.95, "timestamp": "04:00:06", "text": "もし私がランダムに"}, {"type": "subtitle", "time": 14409.59, "timestamp": "04:00:09", "text": "えっと、これは適切な、えっと、これは私が"}, {"type": "subtitle", "time": 14412.71, "timestamp": "04:00:12", "text": "私のプレイリストサイクルで終わった"}, {"type": "subtitle", "time": 14415.75, "timestamp": "04:00:15", "text": "これは固定モードなので、"}, {"type": "subtitle", "time": 14418.79, "timestamp": "04:00:18", "text": "キュレーションされたプレイリストを使いたくない"}, {"type": "subtitle", "time": 14421.59, "timestamp": "04:00:21", "text": "ランダムにクリックしてクリックするだけです"}, {"type": "subtitle", "time": 14425.429, "timestamp": "04:00:25", "text": "アクティブとして設定すると、"}, {"type": "subtitle", "time": 14426.63, "timestamp": "04:00:26", "text": "ランダム化"}, {"type": "subtitle", "time": 14429.269, "timestamp": "04:00:29", "text": "何？何"}, {"type": "subtitle", "time": 14431.75, "timestamp": "04:00:31", "text": "連続したものが欲しい場合はどうすればいいですか?それはええと"}, {"type": "subtitle", "time": 14434.71, "timestamp": "04:00:34", "text": "連続したものを使用してください。さて、質問です"}, {"type": "subtitle", "time": 14439.11, "timestamp": "04:00:39", "text": "ジョックは大丈夫かと疑問に思うだろう"}, {"type": "subtitle", "time": 14442.389, "timestamp": "04:00:42", "text": "どのようなプレイリストでも作成できます"}, {"type": "subtitle", "time": 14445.189, "timestamp": "04:00:45", "text": "あなたはそれを見たいです"}, {"type": "subtitle", "time": 14448.07, "timestamp": "04:00:48", "text": "24時間チャンネルのボードチャンネル"}, {"type": "subtitle", "time": 14451.269, "timestamp": "04:00:51", "text": "物事は正しいので"}, {"type": "subtitle", "time": 14454.309, "timestamp": "04:00:54", "text": "選択したプレイリストが"}, {"type": "subtitle", "time": 14457.83, "timestamp": "04:00:57", "text": "アクティブの動画がなくなったらどうなる？"}]
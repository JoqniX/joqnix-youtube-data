[{"type": "subtitle", "time": 7802.47, "timestamp": "02:10:02", "text": "ランダムまたは連続的であり、時には"}, {"type": "subtitle", "time": 7805.91, "timestamp": "02:10:05", "text": "ええ、この24倍のチャットは空になります"}, {"type": "subtitle", "time": 7808.709, "timestamp": "02:10:08", "text": "チャンネル。君たちが"}, {"type": "subtitle", "time": 7810.87, "timestamp": "02:10:10", "text": "少しお時間を取って"}, {"type": "subtitle", "time": 7814.629, "timestamp": "02:10:14", "text": "これらの瞬間を思い出すか楽しんでください"}, {"type": "subtitle", "time": 7816.149, "timestamp": "02:10:16", "text": "一緒に"}, {"type": "subtitle", "time": 7818.87, "timestamp": "02:10:18", "text": "全員でグループとして一緒に。それ"}, {"type": "subtitle", "time": 7821.43, "timestamp": "02:10:21", "text": "私にとっては大きな意味があります。"}, {"type": "subtitle", "time": 7823.669, "timestamp": "02:10:23", "text": "そして私が望む主なことの一つは"}, {"type": "subtitle", "time": 7826.149, "timestamp": "02:10:26", "text": "そう言うのは"}, {"type": "subtitle", "time": 7830.229, "timestamp": "02:10:30", "text": "たとえ誰も私の24時間を見ていなかったとしても"}, {"type": "subtitle", "time": 7835.35, "timestamp": "02:10:35", "text": "チャンネルが存在することを知るのは楽しいです。"}, {"type": "subtitle", "time": 7839.189, "timestamp": "02:10:39", "text": "いつか誰かが"}, {"type": "subtitle", "time": 7843.705, "timestamp": "02:10:43", "text": "そしてこれらの瞬間を見れば"}, {"type": "subtitle", "time": 7844.31, "timestamp": "02:10:44", "text": "[音楽]"}, {"type": "subtitle", "time": 7848.31, "timestamp": "02:10:48", "text": "私のメインチャンネルをチェックして興味を持ってください"}, {"type": "subtitle", "time": 7850.87, "timestamp": "02:10:50", "text": "それとも私の自信は消え去ったのでしょうか？だから、それは"}, {"type": "subtitle", "time": 7855.35, "timestamp": "02:10:55", "text": "良いオープナーは"}, {"type": "subtitle", "time": 7857.99, "timestamp": "02:10:57", "text": "私を発見したり、興味を持ったり"}]
[{"type": "subtitle", "time": 15482.63, "timestamp": "04:18:02", "text": "私のシステムなので、実装しました"}, {"type": "subtitle", "time": 15486.309, "timestamp": "04:18:06", "text": "サミーとストリーマーボットのすべてではない"}, {"type": "subtitle", "time": 15489.269, "timestamp": "04:18:09", "text": "ストリーマーボットええサミーとそれが好き"}, {"type": "subtitle", "time": 15491.91, "timestamp": "04:18:11", "text": "なぜ私はこれらすべてをサミーに実装したのか"}, {"type": "subtitle", "time": 15495.11, "timestamp": "04:18:15", "text": "Web スタジオでは、そのようなシステムを考えています。"}, {"type": "subtitle", "time": 15499.11, "timestamp": "04:18:19", "text": "こんにちは、私の技術的な内容を楽しんでいただけたでしょうか"}, {"type": "subtitle", "time": 15503.03, "timestamp": "04:18:23", "text": "詳細はちょっと混乱する"}, {"type": "subtitle", "time": 15507.269, "timestamp": "04:18:27", "text": "チュートリアルっぽいもの。こんにちは、気に入っていただけたら、"}, {"type": "subtitle", "time": 15510.469, "timestamp": "04:18:30", "text": "下記にコメントしてください。もしそうしなかったら"}, {"type": "subtitle", "time": 15513.03, "timestamp": "04:18:33", "text": "全然理解できなくても全然大丈夫です。"}, {"type": "subtitle", "time": 15515.429, "timestamp": "04:18:35", "text": "心配する必要はありません。もし"}, {"type": "subtitle", "time": 15518.469, "timestamp": "04:18:38", "text": "あなたは好奇心と興味を持っています"}, {"type": "subtitle", "time": 15521.99, "timestamp": "04:18:41", "text": "これらについてもっと知りたいと思ったら"}, {"type": "subtitle", "time": 15524.469, "timestamp": "04:18:44", "text": "コメントで教えてください"}, {"type": "subtitle", "time": 15525.99, "timestamp": "04:18:45", "text": "下のセクション[音楽]"}, {"type": "subtitle", "time": 15530.55, "timestamp": "04:18:50", "text": "詳しくお話ししたいと思います。ヤップ"}, {"type": "subtitle", "time": 15533.83, "timestamp": "04:18:53", "text": "私がこれらのことをどのように行うかについて。"}]
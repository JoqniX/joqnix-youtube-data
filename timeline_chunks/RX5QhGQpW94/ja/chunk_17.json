[{"type": "subtitle", "time": 1020.31, "timestamp": "00:17:00", "text": "マスターのものになるだろう"}, {"type": "subtitle", "time": 1021.99, "timestamp": "00:17:01", "text": "20"}, {"type": "subtitle", "time": 1028.949, "timestamp": "00:17:08", "text": "うん。学生交換。うん。うん。"}, {"type": "subtitle", "time": 1030.71, "timestamp": "00:17:10", "text": "言語交換。外国為替"}, {"type": "subtitle", "time": 1033.35, "timestamp": "00:17:13", "text": "学生だと思います。別の場所に行く"}, {"type": "subtitle", "time": 1037.909, "timestamp": "00:17:17", "text": "国で言語を学ぶことで"}, {"type": "subtitle", "time": 1040.789, "timestamp": "00:17:20", "text": "2年間の語学研修は"}, {"type": "subtitle", "time": 1043.59, "timestamp": "00:17:23", "text": "2年間。"}, {"type": "subtitle", "time": 1050.47, "timestamp": "00:17:30", "text": "ええ、私は前に私の力になると思います"}, {"type": "subtitle", "time": 1057.51, "timestamp": "00:17:37", "text": "それは予測不可能だ。やり方が分からない"}, {"type": "subtitle", "time": 1069.43, "timestamp": "00:17:49", "text": "あなたは学者のような人ですか？いや、いや、いや、いや。"}, {"type": "subtitle", "time": 1071.19, "timestamp": "00:17:51", "text": "奨学金とかそういうものではありません。"}, {"type": "subtitle", "time": 1077.669, "timestamp": "00:17:57", "text": "願わくば（笑い）"}]
[{"type": "subtitle", "time": 5580.39, "timestamp": "01:33:00", "text": "それで、必要なのはマイクと"}, {"type": "subtitle", "time": 5587.189, "timestamp": "01:33:07", "text": "そうですね、それは設定する必要があることを意味します"}, {"type": "subtitle", "time": 5591.27, "timestamp": "01:33:11", "text": "オーディオミキサーをアップグレードしました。OBSが変更されました。"}, {"type": "subtitle", "time": 5595.27, "timestamp": "01:33:15", "text": "これはちょっと面倒です。"}, {"type": "subtitle", "time": 5597.59, "timestamp": "01:33:17", "text": "それで"}, {"type": "subtitle", "time": 5600.79, "timestamp": "01:33:20", "text": "彼のマイクに、"}, {"type": "subtitle", "time": 5609.91, "timestamp": "01:33:29", "text": "そうですね。うん。"}, {"type": "subtitle", "time": 5612.87, "timestamp": "01:33:32", "text": "右。何？わかった。わかった。えっと、どこですか"}, {"type": "subtitle", "time": 5614.709, "timestamp": "01:33:34", "text": "録音ボタン？待って、レコードはどこだ"}, {"type": "subtitle", "time": 5617.669, "timestamp": "01:33:37", "text": "ボタン？わかった。マルチトラックビデオ。わかった。"}, {"type": "subtitle", "time": 5626.79, "timestamp": "01:33:46", "text": "こんにちは。これはマルチトラックのテストです"}, {"type": "subtitle", "time": 5632.79, "timestamp": "01:33:52", "text": "はい、完了しました。さて、"}, {"type": "subtitle", "time": 5635.669, "timestamp": "01:33:55", "text": "録音。"}, {"type": "subtitle", "time": 5638.31, "timestamp": "01:33:58", "text": "今確認します。ああ、私は"}]
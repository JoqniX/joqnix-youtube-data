[{"type": "subtitle", "time": 6301.43, "timestamp": "01:45:01", "text": "だからちょっと違う感じがする"}, {"type": "subtitle", "time": 6325.669, "timestamp": "01:45:25", "text": "火。暗くない。ヘルプ。"}, {"type": "subtitle", "time": 6330.79, "timestamp": "01:45:30", "text": "マルチダーク。いや、いや、道具はない。いいえ"}, {"type": "subtitle", "time": 6338.229, "timestamp": "01:45:38", "text": "一体何なんだ？キャンバスはどこですか？私"}, {"type": "subtitle", "time": 6341.91, "timestamp": "01:45:41", "text": "キャンバスが見つかりません。どこ？なぜ？"}]
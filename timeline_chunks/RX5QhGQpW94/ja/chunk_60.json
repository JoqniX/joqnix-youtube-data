[{"type": "subtitle", "time": 3601.349, "timestamp": "01:00:01", "text": "1週間、毎週土曜日に。現在"}, {"type": "subtitle", "time": 3604.63, "timestamp": "01:00:04", "text": "バトルフィールド、デスティニー2、そしてピアノ"}, {"type": "subtitle", "time": 3607.109, "timestamp": "01:00:07", "text": "学習ですよね？ピアノの勉強は始まった"}, {"type": "subtitle", "time": 3610.71, "timestamp": "01:00:10", "text": "ランダムな状態"}, {"type": "subtitle", "time": 3612.47, "timestamp": "01:00:12", "text": "ええ、バトルフィールドとデスティニーも"}, {"type": "subtitle", "time": 3614.63, "timestamp": "01:00:14", "text": "ランダムな状態。そこで順次"}, {"type": "subtitle", "time": 3617.03, "timestamp": "01:00:17", "text": "ランダム。ランダムというのは、"}, {"type": "subtitle", "time": 3620.63, "timestamp": "01:00:20", "text": "これ。ピアノ学習用プレイリストのみ"}, {"type": "subtitle", "time": 3623.589, "timestamp": "01:00:23", "text": "ビデオが 1 つしかないので、 1 つだけ表示されます。"}, {"type": "subtitle", "time": 3625.829, "timestamp": "01:00:25", "text": "そして戦場は2番目だった"}, {"type": "subtitle", "time": 3628.549, "timestamp": "01:00:28", "text": "右。つまりランダム化され続けることになります。"}, {"type": "subtitle", "time": 3631.91, "timestamp": "01:00:31", "text": "それはエピソードのようなものではないだろう"}, {"type": "subtitle", "time": 3634.309, "timestamp": "01:00:34", "text": "1、パート2、パート3。シーケンシャルとは"}, {"type": "subtitle", "time": 3637.589, "timestamp": "01:00:37", "text": "番号がランダムな場合はランダム化されます。"}, {"type": "subtitle", "time": 3640.47, "timestamp": "01:00:40", "text": "同じにはならないよ。繰り返しはありません"}, {"type": "subtitle", "time": 3644.15, "timestamp": "01:00:44", "text": "ストリームはそこにあります。そしてその後"}, {"type": "subtitle", "time": 3648.15, "timestamp": "01:00:48", "text": "3つのプレイリストに到達"}, {"type": "subtitle", "time": 3651.829, "timestamp": "01:00:51", "text": "残りはランダムなコンテンツになります。"}, {"type": "subtitle", "time": 3655.829, "timestamp": "01:00:55", "text": "90本くらいのビデオを載せました。これは"}, {"type": "subtitle", "time": 3658.789, "timestamp": "01:00:58", "text": "1週間分の[鼻息]"}]
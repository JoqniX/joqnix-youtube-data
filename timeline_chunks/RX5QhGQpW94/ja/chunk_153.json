[{"type": "subtitle", "time": 9181.99, "timestamp": "02:33:01", "text": "これらの待ち伏せストリームは、"}, {"type": "subtitle", "time": 9184.309, "timestamp": "02:33:04", "text": "視聴者を驚かせるために、最後に発表されることが多い"}, {"type": "subtitle", "time": 9187.429, "timestamp": "02:33:07", "text": "ソーシャルメディアで1分間発言したり"}, {"type": "subtitle", "time": 9190.309, "timestamp": "02:33:10", "text": "突然。うん。"}, {"type": "subtitle", "time": 9193.75, "timestamp": "02:33:13", "text": "こんにちは、サラー。いらっしゃいませ。"}, {"type": "subtitle", "time": 9196.07, "timestamp": "02:33:16", "text": "うん。ランダムストリーム。うん。うん。うん。"}, {"type": "subtitle", "time": 9207.03, "timestamp": "02:33:27", "text": "[咳払い]"}, {"type": "subtitle", "time": 9209.03, "timestamp": "02:33:29", "text": "わかった。ええと、私たちはそうでない人たちを狙っています"}, {"type": "subtitle", "time": 9211.27, "timestamp": "02:33:31", "text": "最近私はそれを一度に立ち上げたことを知っています"}, {"type": "subtitle", "time": 9212.71, "timestamp": "02:33:32", "text": "私のYouTubeのすべてに機能しています"}, {"type": "subtitle", "time": 9214.87, "timestamp": "02:33:34", "text": "私がYouTubeで配信したストリーム"}, {"type": "subtitle", "time": 9217.429, "timestamp": "02:33:37", "text": "チャネル。このビデオでは"}, {"type": "subtitle", "time": 9219.429, "timestamp": "02:33:39", "text": "あなたに簡単に"}, {"type": "subtitle", "time": 9229.67, "timestamp": "02:33:49", "text": "SRTは見たくない"}]
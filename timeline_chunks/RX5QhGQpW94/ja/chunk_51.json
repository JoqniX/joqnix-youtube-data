[{"type": "subtitle", "time": 3062.95, "timestamp": "00:51:02", "text": "私のソーシャルメディアのすべて"}, {"type": "subtitle", "time": 3065.99, "timestamp": "00:51:05", "text": "すべてがジョックニックです。"}, {"type": "subtitle", "time": 3069.349, "timestamp": "00:51:09", "text": "インスタでやれば大丈夫だと思う"}, {"type": "subtitle", "time": 3074.15, "timestamp": "00:51:14", "text": "現れる。いいえ、IG。"}, {"type": "subtitle", "time": 3079.27, "timestamp": "00:51:19", "text": "そうそう。そうですよ。エラーが見えますか?"}, {"type": "subtitle", "time": 3081.589, "timestamp": "00:51:21", "text": "修正しようとしています。うまくいかないよ"}, {"type": "subtitle", "time": 3087.03, "timestamp": "00:51:27", "text": "えーっと、"}, {"type": "subtitle", "time": 3106.549, "timestamp": "00:51:46", "text": "しかしそれはオフです。では誰がそれを運営しているのでしょうか?"}, {"type": "subtitle", "time": 3117.67, "timestamp": "00:51:57", "text": "これは何ですか？"}, {"type": "subtitle", "time": 3119.99, "timestamp": "00:51:59", "text": "392."}]
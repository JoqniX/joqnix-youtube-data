[{"type": "subtitle", "time": 1801.19, "timestamp": "00:30:01", "text": "機関。"}, {"type": "subtitle", "time": 1804.149, "timestamp": "00:30:04", "text": "うん。だから私は一人じゃないんです。いいえ。"}, {"type": "subtitle", "time": 1806.23, "timestamp": "00:30:06", "text": "ええと、2つの理由があります。まず私の親友は"}, {"type": "subtitle", "time": 1809.19, "timestamp": "00:30:09", "text": "また、IRでも、IRでも、彼女がいなくなると寂しくなります。"}, {"type": "subtitle", "time": 1811.19, "timestamp": "00:30:11", "text": "第二に、あなたももうすぐいなくなるでしょう。"}, {"type": "subtitle", "time": 1821.669, "timestamp": "00:30:21", "text": "うん。うん。クラスメイトもそこにいます。しないでください"}, {"type": "subtitle", "time": 1825.029, "timestamp": "00:30:25", "text": "心配。うーん、うーん、たぶん"}, {"type": "subtitle", "time": 1827.269, "timestamp": "00:30:27", "text": "私の語学学校は"}, {"type": "subtitle", "time": 1829.83, "timestamp": "00:30:29", "text": "3人4人。"}, {"type": "subtitle", "time": 1833.35, "timestamp": "00:30:33", "text": "合計12名12人の親が行きます。えーっと"}, {"type": "subtitle", "time": 1834.71, "timestamp": "00:30:34", "text": "一部の人々は違う方向へ向かっている"}, {"type": "subtitle", "time": 1837.269, "timestamp": "00:30:37", "text": "さまざまな状態。えっと、私は"}, {"type": "subtitle", "time": 1840.149, "timestamp": "00:30:40", "text": "異なる州、特定の学校。彼らは"}, {"type": "subtitle", "time": 1841.59, "timestamp": "00:30:41", "text": "別の州に行くと"}, {"type": "subtitle", "time": 1845.146, "timestamp": "00:30:45", "text": "特定の学校。そういう感じ。"}, {"type": "subtitle", "time": 1845.75, "timestamp": "00:30:45", "text": "[ため息]"}, {"type": "subtitle", "time": 1848.71, "timestamp": "00:30:48", "text": "ええ、私の親友であり、私の人生の恋人です。あ"}, {"type": "subtitle", "time": 1852.149, "timestamp": "00:30:52", "text": "ああ、その瞬間はわかる"}, {"type": "subtitle", "time": 1855.51, "timestamp": "00:30:55", "text": "私の幼なじみの友達はみんな"}, {"type": "subtitle", "time": 1859.99, "timestamp": "00:30:59", "text": "私を残していったけど、つまり"}]
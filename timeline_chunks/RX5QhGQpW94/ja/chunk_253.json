[{"type": "subtitle", "time": 15208.71, "timestamp": "04:13:28", "text": "例えば、"}, {"type": "subtitle", "time": 15212.54, "timestamp": "04:13:32", "text": "Asmin Goldの24時間年中無休のチャンネルで"}, {"type": "subtitle", "time": 15213.59, "timestamp": "04:13:33", "text": "[音楽]"}, {"type": "subtitle", "time": 15215.429, "timestamp": "04:13:35", "text": "いつでも"}, {"type": "subtitle", "time": 15218.79, "timestamp": "04:13:38", "text": "Asmin Goはメインチャンネルでライブ配信中ですが、"}, {"type": "subtitle", "time": 15222.07, "timestamp": "04:13:42", "text": "彼の24時間チャンネルに注目してください"}, {"type": "subtitle", "time": 15226.389, "timestamp": "04:13:46", "text": "実際にフィードを一時停止します。このように"}, {"type": "subtitle", "time": 15228.87, "timestamp": "04:13:48", "text": "本当にクールで、とても多くの"}, {"type": "subtitle", "time": 15232.07, "timestamp": "04:13:52", "text": "バージョン 7 と 8 のインスピレーション。"}, {"type": "subtitle", "time": 15233.91, "timestamp": "04:13:53", "text": "[音楽]のように、それはまた、"}, {"type": "subtitle", "time": 15236.79, "timestamp": "04:13:56", "text": "スケジュールは"}, {"type": "subtitle", "time": 15237.99, "timestamp": "04:13:57", "text": "次のプレイリスト [音楽]"}]
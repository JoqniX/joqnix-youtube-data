[{"type": "subtitle", "time": 14280.389, "timestamp": "03:58:00", "text": "順次とは、新しい"}, {"type": "subtitle", "time": 14282.71, "timestamp": "03:58:02", "text": "プレイリストが作成されると、常に"}, {"type": "subtitle", "time": 14285.51, "timestamp": "03:58:05", "text": "シーケンシャルモードで作成されたため、"}, {"type": "subtitle", "time": 14288.469, "timestamp": "03:58:08", "text": "1つのビデオのようなシーケンスモードのように"}, {"type": "subtitle", "time": 14292.79, "timestamp": "03:58:12", "text": "数字の部分 1 2 3 このようにランダム"}, {"type": "subtitle", "time": 14294.95, "timestamp": "03:58:14", "text": "それで私はそれを作りました。これについては後で話します"}, {"type": "subtitle", "time": 14297.269, "timestamp": "03:58:17", "text": "3番目のボタンはキュレーションされた単語サイクルです"}, {"type": "subtitle", "time": 14298.87, "timestamp": "03:58:18", "text": "自動アクティブ"}, {"type": "subtitle", "time": 14302.469, "timestamp": "03:58:22", "text": "ランダムモードもランダムモードも"}, {"type": "subtitle", "time": 14304.71, "timestamp": "03:58:24", "text": "文字通りサイクリングすることになる"}, {"type": "subtitle", "time": 14308.63, "timestamp": "03:58:28", "text": "プレイリストですが、順序はランダムです。"}, {"type": "subtitle", "time": 14311.83, "timestamp": "03:58:31", "text": "基本的にはこんな感じです。"}, {"type": "subtitle", "time": 14314.79, "timestamp": "03:58:34", "text": "ということで、キュレーションされたプレイリストには"}, {"type": "subtitle", "time": 14317.83, "timestamp": "03:58:37", "text": "シングルバージョンとシングルだと思う"}, {"type": "subtitle", "time": 14319.764, "timestamp": "03:58:39", "text": "現在使用しているバージョンです。"}, {"type": "subtitle", "time": 14321.91, "timestamp": "03:58:41", "text": "[音楽] ループ再生したり"}, {"type": "subtitle", "time": 14324.469, "timestamp": "03:58:44", "text": "何か。"}, {"type": "subtitle", "time": 14327.11, "timestamp": "03:58:47", "text": "うん。"}, {"type": "subtitle", "time": 14332.07, "timestamp": "03:58:52", "text": "ええ、ご覧の通り、"}, {"type": "subtitle", "time": 14334.309, "timestamp": "03:58:54", "text": "これを見ている人は、きっと素晴らしい"}, {"type": "subtitle", "time": 14337.03, "timestamp": "03:58:57", "text": "一体何が起こっているのか混乱している"}]
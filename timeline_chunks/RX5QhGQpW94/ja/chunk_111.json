[{"type": "subtitle", "time": 6663.109, "timestamp": "01:51:03", "text": "ええ、レコーディングとアビエイターはどちらも"}, {"type": "subtitle", "time": 6666.31, "timestamp": "01:51:06", "text": "働く。はい、よかったです。"}, {"type": "subtitle", "time": 6669.51, "timestamp": "01:51:09", "text": "これがうまくいかなかったら、"}, {"type": "subtitle", "time": 6672.47, "timestamp": "01:51:12", "text": "全部やり直すつもりです"}, {"type": "subtitle", "time": 6675.99, "timestamp": "01:51:15", "text": "ストリームから外れたやつだよ。"}, {"type": "subtitle", "time": 6677.51, "timestamp": "01:51:17", "text": "わかった、"}, {"type": "subtitle", "time": 6680.149, "timestamp": "01:51:20", "text": "これを閉じます。こんにちは、背景をお楽しみください"}, {"type": "subtitle", "time": 6684.87, "timestamp": "01:51:24", "text": "音楽。こんにちは、始めましょう。"}, {"type": "subtitle", "time": 6687.51, "timestamp": "01:51:27", "text": "スクリプトは準備できましたか? [笑い] 私は"}, {"type": "subtitle", "time": 6695.99, "timestamp": "01:51:35", "text": "また、保管チェックも行います。どのくらいのストレージ容量が必要か"}, {"type": "subtitle", "time": 6697.75, "timestamp": "01:51:37", "text": "私は持っている？"}, {"type": "subtitle", "time": 6701.372, "timestamp": "01:51:41", "text": "大変です、私たちは保管に苦労しています。"}, {"type": "subtitle", "time": 6702.07, "timestamp": "01:51:42", "text": "[笑い]"}, {"type": "subtitle", "time": 6704.87, "timestamp": "01:51:44", "text": "大丈夫。大丈夫。それほどでもないだろう"}, {"type": "subtitle", "time": 6710.709, "timestamp": "01:51:50", "text": "多すぎることはないでしょう。それほどでもないだろう"}, {"type": "subtitle", "time": 6719.27, "timestamp": "01:51:59", "text": "えーっと。"}]
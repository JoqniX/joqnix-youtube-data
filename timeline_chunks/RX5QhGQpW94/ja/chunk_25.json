[{"type": "subtitle", "time": 1500.549, "timestamp": "00:25:00", "text": "1位は？あなたが知っている、"}, {"type": "subtitle", "time": 1504.789, "timestamp": "00:25:04", "text": "家族も同意し、彼らはすべて知っています。"}, {"type": "subtitle", "time": 1507.11, "timestamp": "00:25:07", "text": "何を期待するか、何を期待しないか"}, {"type": "subtitle", "time": 1509.75, "timestamp": "00:25:09", "text": "期待、すべて、どれだけ"}, {"type": "subtitle", "time": 1512.31, "timestamp": "00:25:12", "text": "経費、すべて。"}, {"type": "subtitle", "time": 1519.19, "timestamp": "00:25:19", "text": "えーっと"}, {"type": "subtitle", "time": 1522.07, "timestamp": "00:25:22", "text": "なぜ彼らは同意したのでしょうか?よく考えてください、カキ。"}, {"type": "subtitle", "time": 1530.23, "timestamp": "00:25:30", "text": "留学したいなら、"}, {"type": "subtitle", "time": 1533.11, "timestamp": "00:25:33", "text": "あなたは何にでも興味を持っています"}, {"type": "subtitle", "time": 1535.35, "timestamp": "00:25:35", "text": "やりたい。海外に行く場合でも"}, {"type": "subtitle", "time": 1537.59, "timestamp": "00:25:37", "text": "あるいは自国に留まるか"}, {"type": "subtitle", "time": 1538.87, "timestamp": "00:25:38", "text": "何かに興味があるなら、"}, {"type": "subtitle", "time": 1542.47, "timestamp": "00:25:42", "text": "ああ、あれこれやりたいことがある。"}, {"type": "subtitle", "time": 1544.07, "timestamp": "00:25:44", "text": "えーっと"}, {"type": "subtitle", "time": 1547.43, "timestamp": "00:25:47", "text": "そしてあなたは、あなたが"}, {"type": "subtitle", "time": 1551.19, "timestamp": "00:25:51", "text": "自信を持って挑戦できる。"}, {"type": "subtitle", "time": 1554.31, "timestamp": "00:25:54", "text": "頑張ってください。いいえ、あなたの家族が"}, {"type": "subtitle", "time": 1557.19, "timestamp": "00:25:57", "text": "状況は良く、家族もそれを許している、"}, {"type": "subtitle", "time": 1559.11, "timestamp": "00:25:59", "text": "あなたはそれに挑戦するつもりですよね？ちょうど"}]
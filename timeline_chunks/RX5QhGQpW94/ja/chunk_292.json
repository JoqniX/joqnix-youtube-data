[{"type": "subtitle", "time": 17521.91, "timestamp": "04:52:01", "text": "もっと積極的になれるよう頑張ります。"}, {"type": "subtitle", "time": 17524.23, "timestamp": "04:52:04", "text": "えーと、今日の配信を楽しんでいただけたでしょうか。私は"}, {"type": "subtitle", "time": 17526.07, "timestamp": "04:52:06", "text": "ところで、元気がなく申し訳ありません。"}, {"type": "subtitle", "time": 17530.15, "timestamp": "04:52:10", "text": "私はとても疲れている。ちょうど1時半です。その"}, {"type": "subtitle", "time": 17533.43, "timestamp": "04:52:13", "text": "午前1時30分になります。"}, {"type": "subtitle", "time": 17535.99, "timestamp": "04:52:15", "text": "えっと、でも、ええ、[咳払い]ありがとう"}, {"type": "subtitle", "time": 17538.47, "timestamp": "04:52:18", "text": "もう一度、ミナ、"}, {"type": "subtitle", "time": 17543.03, "timestamp": "04:52:23", "text": "ここにいてくれてありがとう。それは本当に大きな意味があります。"}, {"type": "subtitle", "time": 17545.83, "timestamp": "04:52:25", "text": "配信をお楽しみいただけましたら、"}, {"type": "subtitle", "time": 17548.628, "timestamp": "04:52:28", "text": "今後の配信にぜひお越しください"}, {"type": "subtitle", "time": 17569.51, "timestamp": "04:52:49", "text": "さよなら。それでは、これで終わりにします。ありがとう"}, {"type": "subtitle", "time": 17572.23, "timestamp": "04:52:52", "text": "今日来てくださった皆様。"}, {"type": "subtitle", "time": 17574.31, "timestamp": "04:52:54", "text": "ありがとう。"}, {"type": "subtitle", "time": 17577.75, "timestamp": "04:52:57", "text": "次回のストリームでお会いしましょう。"}]
[{"type": "subtitle", "time": 12784.07, "timestamp": "03:33:04", "text": "未来。わかった。こんにちは。それでは始めましょう"}, {"type": "subtitle", "time": 12790.469, "timestamp": "03:33:10", "text": "えっと、それでは始めましょう"}, {"type": "subtitle", "time": 12792.79, "timestamp": "03:33:12", "text": "どうやってそれをやったか"}, {"type": "subtitle", "time": 12797.429, "timestamp": "03:33:17", "text": "そして私がこの24時間の仕事に取り組んだきっかけは"}, {"type": "subtitle", "time": 12803.75, "timestamp": "03:33:23", "text": "それで"}, {"type": "subtitle", "time": 12806.71, "timestamp": "03:33:26", "text": "スクロールしていたとき"}, {"type": "subtitle", "time": 12810.71, "timestamp": "03:33:30", "text": "Twitchカテゴリーは常にオンと呼ばれ、私は"}, {"type": "subtitle", "time": 12813.429, "timestamp": "03:33:33", "text": "大きなストリーマーのような注目"}, {"type": "subtitle", "time": 12817.75, "timestamp": "03:33:37", "text": "ボン・ピーナッツ、Co、PewDiePie、その他"}, {"type": "subtitle", "time": 12823.67, "timestamp": "03:33:43", "text": "ストラウド、多くのストリーマーは、かつて"}, {"type": "subtitle", "time": 12826.71, "timestamp": "03:33:46", "text": "彼らの"}, {"type": "subtitle", "time": 12827.657, "timestamp": "03:33:47", "text": "放送。"}, {"type": "subtitle", "time": 12827.91, "timestamp": "03:33:47", "text": "[音楽]"}, {"type": "subtitle", "time": 12831.83, "timestamp": "03:33:51", "text": "そこで、私の研究から分かったことは"}, {"type": "subtitle", "time": 12835.59, "timestamp": "03:33:55", "text": "これを行うには 2 つの方法があります。のように"}, {"type": "subtitle", "time": 12839.448, "timestamp": "03:33:59", "text": "ストリームをローカルに記録するか"}]
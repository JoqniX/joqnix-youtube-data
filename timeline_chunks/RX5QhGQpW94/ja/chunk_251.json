[{"type": "subtitle", "time": 15062.63, "timestamp": "04:11:02", "text": "現在Twitchで配信中"}, {"type": "subtitle", "time": 15065.67, "timestamp": "04:11:05", "text": "メインチャンネルはプライベートストリームとして"}, {"type": "subtitle", "time": 15069.03, "timestamp": "04:11:09", "text": "テストなどを行うために"}, {"type": "subtitle", "time": 15071.91, "timestamp": "04:11:11", "text": "その舞台裏。そしてこれが"}, {"type": "subtitle", "time": 15075.59, "timestamp": "04:11:15", "text": "メイン24時間年中無休のYouTubeチャンネルと"}, {"type": "subtitle", "time": 15079.269, "timestamp": "04:11:19", "text": "1つ蹴ります。うん。そして[音楽]は現在私の"}, {"type": "subtitle", "time": 15083.59, "timestamp": "04:11:23", "text": "現在の設定では、"}, {"type": "subtitle", "time": 15088.55, "timestamp": "04:11:28", "text": "360pでまたフィード"}, {"type": "subtitle", "time": 15092.79, "timestamp": "04:11:32", "text": "私の現在の設定はローカル"}, {"type": "subtitle", "time": 15095.75, "timestamp": "04:11:35", "text": "設定。つまり、パソコンを使わなければならない"}, {"type": "subtitle", "time": 15098.55, "timestamp": "04:11:38", "text": "この 24 時間チャンネルを運営するためのリソース。"}, {"type": "subtitle", "time": 15100.07, "timestamp": "04:11:40", "text": "右。"}, {"type": "subtitle", "time": 15105.51, "timestamp": "04:11:45", "text": "他のクリエイターたちは"}, {"type": "subtitle", "time": 15109.269, "timestamp": "04:11:49", "text": "独自のクラウドのようなものを持っています。"}, {"type": "subtitle", "time": 15113.11, "timestamp": "04:11:53", "text": "ええ、ある意味私も同じことができるかもしれません"}, {"type": "subtitle", "time": 15115.349, "timestamp": "04:11:55", "text": "将来のこと。それはつまり私が"}, {"type": "subtitle", "time": 15117.564, "timestamp": "04:11:57", "text": "クラウドサーバーに投資する必要がある"}]
[{"type": "subtitle", "time": 11285.59, "timestamp": "03:08:05", "text": "技術的な詳細ビデオについては、"}, {"type": "subtitle", "time": 11288.95, "timestamp": "03:08:08", "text": "少なくとも30分のビデオになります"}, {"type": "subtitle", "time": 11291.349, "timestamp": "03:08:11", "text": "長さ。私は推測する"}, {"type": "subtitle", "time": 11293.11, "timestamp": "03:08:13", "text": "パワーポイントを作らないと"}, {"type": "subtitle", "time": 11295.67, "timestamp": "03:08:15", "text": "プレゼンテーション、"}, {"type": "subtitle", "time": 11297.83, "timestamp": "03:08:17", "text": "えーと"}, {"type": "subtitle", "time": 11300.15, "timestamp": "03:08:20", "text": "わからない"}, {"type": "subtitle", "time": 11311.99, "timestamp": "03:08:31", "text": "問題は今"}, {"type": "subtitle", "time": 11315.429, "timestamp": "03:08:35", "text": "人々がそれを見ることを期待していません、"}, {"type": "subtitle", "time": 11318.309, "timestamp": "03:08:38", "text": "しかし"}, {"type": "subtitle", "time": 11320.95, "timestamp": "03:08:40", "text": "それを気にする人のために、私は"}, {"type": "subtitle", "time": 11324.71, "timestamp": "03:08:44", "text": "彼らがそこに来たのか、来たのかを知るために"}, {"type": "subtitle", "time": 11328.79, "timestamp": "03:08:48", "text": "ここに。 24時間365日体制で"}, {"type": "subtitle", "time": 11332.469, "timestamp": "03:08:52", "text": "たくさんのストリーマーとしてチャンネルを運営している"}, {"type": "subtitle", "time": 11335.99, "timestamp": "03:08:55", "text": "私のチャンネルでストリームを彼らのチャンネルで配信しますか?"}, {"type": "subtitle", "time": 11338.71, "timestamp": "03:08:58", "text": "できますか？"}]
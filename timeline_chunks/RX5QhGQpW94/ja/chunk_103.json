[{"type": "subtitle", "time": 6194.55, "timestamp": "01:43:14", "text": "わかった。だから、私はできると思う"}, {"type": "subtitle", "time": 6198.31, "timestamp": "01:43:18", "text": "通常の録音を行います。えっと、それはあなたですか"}, {"type": "subtitle", "time": 6207.99, "timestamp": "01:43:27", "text": "あ、今は音声をチェックしていませんでした。ええと、1つ"}, {"type": "subtitle", "time": 6210.149, "timestamp": "01:43:30", "text": "2番。"}, {"type": "subtitle", "time": 6213.51, "timestamp": "01:43:33", "text": "これには「ああ、"}, {"type": "subtitle", "time": 6216.011, "timestamp": "01:43:36", "text": "閉じました。"}]
[{"type": "subtitle", "time": 11221.59, "timestamp": "03:07:01", "text": "ダークネス247 イントロ"}, {"type": "subtitle", "time": 11223.51, "timestamp": "03:07:03", "text": "そしてアニメーション。娯楽なし"}, {"type": "subtitle", "time": 11230.71, "timestamp": "03:07:10", "text": "剃る。剃る。剃る。剃る。わかった。そして"}, {"type": "subtitle", "time": 11234.07, "timestamp": "03:07:14", "text": "レンダリングQに追加してレンダリングします。こんにちは。だった"}, {"type": "subtitle", "time": 11235.91, "timestamp": "03:07:15", "text": "完了"}, {"type": "subtitle", "time": 11238.15, "timestamp": "03:07:18", "text": "2番目のビデオを今すぐに作成すべきでしょうか?"}, {"type": "subtitle", "time": 11240.15, "timestamp": "03:07:20", "text": "20年間ライブを続けています。生きていますか？"}, {"type": "subtitle", "time": 11243.19, "timestamp": "03:07:23", "text": "3時間もですか？行う必要がありますか？"}, {"type": "subtitle", "time": 11246.79, "timestamp": "03:07:26", "text": "技術詳細バージョン?えーっと"}, {"type": "subtitle", "time": 11249.51, "timestamp": "03:07:29", "text": "技術的な準備が不十分で"}, {"type": "subtitle", "time": 11251.67, "timestamp": "03:07:31", "text": "バージョン。"}, {"type": "subtitle", "time": 11254.469, "timestamp": "03:07:34", "text": "技術的なバージョンでは、"}, {"type": "subtitle", "time": 11257.349, "timestamp": "03:07:37", "text": "具体的に言えば。ああ、"}, {"type": "subtitle", "time": 11260.389, "timestamp": "03:07:40", "text": "くそ。何てことだ。停止。気づいたんだけど"}, {"type": "subtitle", "time": 11277.83, "timestamp": "03:07:57", "text": "クリアレンダリング開始。わかった。再度レンダリングします。"}]
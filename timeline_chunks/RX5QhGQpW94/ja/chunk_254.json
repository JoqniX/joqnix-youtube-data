[{"type": "subtitle", "time": 15241.189, "timestamp": "04:14:01", "text": "そして、そのようなものも同様に"}, {"type": "subtitle", "time": 15244.469, "timestamp": "04:14:04", "text": "バックグラウンドミュージックとか。私は信じています"}, {"type": "subtitle", "time": 15247.349, "timestamp": "04:14:07", "text": "これはクラウドサーバー上で実行されており、"}, {"type": "subtitle", "time": 15250.229, "timestamp": "04:14:10", "text": "すべてはおそらく次のように行われます"}, {"type": "subtitle", "time": 15252.07, "timestamp": "04:14:12", "text": "クラウドベース。それはまるで"}, {"type": "subtitle", "time": 15255.189, "timestamp": "04:14:15", "text": "何らかのコーディングを自動化し、"}, {"type": "subtitle", "time": 15258.389, "timestamp": "04:14:18", "text": "シーンとか。しかし、これは本当に"}, {"type": "subtitle", "time": 15262.63, "timestamp": "04:14:22", "text": "かっこいいですよね？うん。そして"}, {"type": "subtitle", "time": 15266.63, "timestamp": "04:14:26", "text": "それは私にとって新しい扉を開く"}, {"type": "subtitle", "time": 15269.67, "timestamp": "04:14:29", "text": "実験して他のものを見てみたい"}, {"type": "subtitle", "time": 15272.71, "timestamp": "04:14:32", "text": "クリエイターは準備を整え、"}, {"type": "subtitle", "time": 15274.87, "timestamp": "04:14:34", "text": "私自身の実装"}, {"type": "subtitle", "time": 15278.149, "timestamp": "04:14:38", "text": "それのために。だから私の現在の"}, {"type": "subtitle", "time": 15280.79, "timestamp": "04:14:40", "text": "実装、"}, {"type": "subtitle", "time": 15283.83, "timestamp": "04:14:43", "text": "私は満足しています"}, {"type": "subtitle", "time": 15286.55, "timestamp": "04:14:46", "text": "現在の私の設定。それは"}, {"type": "subtitle", "time": 15288.469, "timestamp": "04:14:48", "text": "本当に良いです。"}, {"type": "subtitle", "time": 15291.269, "timestamp": "04:14:51", "text": "それは私が望む動作にぴったり合います。"}, {"type": "subtitle", "time": 15296.469, "timestamp": "04:14:56", "text": "私がどんなアイデアを持っていたとしても、それはうまくいきます。"}, {"type": "subtitle", "time": 15298.87, "timestamp": "04:14:58", "text": "でも、将来が楽しみです"}]
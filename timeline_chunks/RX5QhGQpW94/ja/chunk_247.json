[{"type": "subtitle", "time": 14822.469, "timestamp": "04:07:02", "text": "一度、ええと、すべてが使われたら"}, {"type": "subtitle", "time": 14825.75, "timestamp": "04:07:05", "text": "完全なリセットが行われ、"}, {"type": "subtitle", "time": 14828.229, "timestamp": "04:07:08", "text": "もう一度最初からやり直してください。"}, {"type": "subtitle", "time": 14832.15, "timestamp": "04:07:12", "text": "うん。これってクールじゃないですか？そしてこれは"}, {"type": "subtitle", "time": 14835.349, "timestamp": "04:07:15", "text": "皆さんのほとんどがまだ理解できていないと思います"}, {"type": "subtitle", "time": 14837.269, "timestamp": "04:07:17", "text": "私が何を話していたのか、何をしゃべっていたのか"}, {"type": "subtitle", "time": 14842.229, "timestamp": "04:07:22", "text": "ここでの話ですが、それでもそれはすべての"}, {"type": "subtitle", "time": 14846.229, "timestamp": "04:07:26", "text": "それで、今は"}, {"type": "subtitle", "time": 14848.229, "timestamp": "04:07:28", "text": "現在、私はこれを予定しています"}, {"type": "subtitle", "time": 14852.389, "timestamp": "04:07:32", "text": "毎週土曜日に実行するボタン"}, {"type": "subtitle", "time": 14855.189, "timestamp": "04:07:35", "text": "正しい。ええ、水曜日と土曜日"}, {"type": "subtitle", "time": 14857.91, "timestamp": "04:07:37", "text": "それが最初のものでした。それから私はこれを変える"}, {"type": "subtitle", "time": 14865.83, "timestamp": "04:07:45", "text": "ええ、もし私が正しければ、私はそれを変更しました"}, {"type": "subtitle", "time": 14867.99, "timestamp": "04:07:47", "text": "土曜日。毎週土曜日には"}, {"type": "subtitle", "time": 14871.99, "timestamp": "04:07:51", "text": "作成されたサイクル同期ボタンをトリガーします。"}, {"type": "subtitle", "time": 14874.63, "timestamp": "04:07:54", "text": "同期ボタンが完了すると、"}, {"type": "subtitle", "time": 14877.269, "timestamp": "04:07:57", "text": "自動アクティブボタンを実行し、"}]
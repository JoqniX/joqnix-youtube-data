[{"type": "subtitle", "time": 7501.91, "timestamp": "02:05:01", "text": "I made the 24-hour channel because I"}, {"type": "subtitle", "time": 7504.55, "timestamp": "02:05:04", "text": "wanted everyone"}, {"type": "subtitle", "time": 7507.189, "timestamp": "02:05:07", "text": "to have"}, {"type": "subtitle", "time": 7511.109, "timestamp": "02:05:11", "text": "something of me when I'm not there, when"}, {"type": "subtitle", "time": 7515.91, "timestamp": "02:05:15", "text": "I'm not able to stream like or go live"}, {"type": "subtitle", "time": 7520.149, "timestamp": "02:05:20", "text": "due to due to life or anything. I wanted"}, {"type": "subtitle", "time": 7523.83, "timestamp": "02:05:23", "text": "my community to be able to watch and"}, {"type": "subtitle", "time": 7528.39, "timestamp": "02:05:28", "text": "enjoy the older condensants we have"}, {"type": "subtitle", "time": 7530.709, "timestamp": "02:05:30", "text": "experienced and made memories in the"}, {"type": "subtitle", "time": 7534.629, "timestamp": "02:05:34", "text": "past. I wanted you guys to enjoy it"}, {"type": "subtitle", "time": 7537.51, "timestamp": "02:05:37", "text": "again."}, {"type": "subtitle", "time": 7544.229, "timestamp": "02:05:44", "text": "rewatching memories we have shared"}, {"type": "subtitle", "time": 7548.87, "timestamp": "02:05:48", "text": "before. Yeah. So that's why the 24 hours"}]
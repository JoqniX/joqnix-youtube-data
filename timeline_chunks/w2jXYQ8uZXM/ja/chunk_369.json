[{"type": "subtitle", "time": 22141.548, "timestamp": "06:09:01", "text": "アバター"}, {"type": "subtitle", "time": 22144.948, "timestamp": "06:09:04", "text": "おしゃべりな人、そして"}, {"type": "subtitle", "time": 22147.83, "timestamp": "06:09:07", "text": "コメントが少し表示されます"}, {"type": "subtitle", "time": 22150.628, "timestamp": "06:09:10", "text": "コメントは、フェードアウトのフェードアウトとして表示されます"}, {"type": "subtitle", "time": 22153.35, "timestamp": "06:09:13", "text": "メッセージ。まるでポンと入ってくるみたい"}, {"type": "subtitle", "time": 22156.708, "timestamp": "06:09:16", "text": "画面上のどこかにランダムに表示され、"}, {"type": "subtitle", "time": 22159.27, "timestamp": "06:09:19", "text": "突き放すような感じ。まあ、そういう感じで"}, {"type": "subtitle", "time": 22162.788, "timestamp": "06:09:22", "text": "そんな感じ。それはすごくクールだね。私はしたい"}, {"type": "subtitle", "time": 22166.59, "timestamp": "06:09:26", "text": "欲しい、手に入れたい。どのように"}, {"type": "subtitle", "time": 22173.07, "timestamp": "06:09:33", "text": "それ？"}, {"type": "subtitle", "time": 22176.51, "timestamp": "06:09:36", "text": "では、どうすれば見つけられますか？"}, {"type": "subtitle", "time": 22180.27, "timestamp": "06:09:40", "text": "それ？こんにちは、そして太陽。こんにちは。良い"}, {"type": "subtitle", "time": 22182.27, "timestamp": "06:09:42", "text": "夕方。こんにちは。"}, {"type": "subtitle", "time": 22185.39, "timestamp": "06:09:45", "text": "こんにちは。お元気でお過ごしでしょうか"}, {"type": "subtitle", "time": 22189.15, "timestamp": "06:09:49", "text": "良い。それから、あることに気づいた。"}, {"type": "subtitle", "time": 22192.708, "timestamp": "06:09:52", "text": "えっと、たくさんおしゃべりしているので"}, {"type": "subtitle", "time": 22195.75, "timestamp": "06:09:55", "text": "ストリームとかそういうもの。私はおそらく"}, {"type": "subtitle", "time": 22198.708, "timestamp": "06:09:58", "text": "入れたらいいと思う"}]
[{"type": "subtitle", "time": 3441.309, "timestamp": "00:57:21", "text": "下？なぜこう書いてあるのですか"}, {"type": "subtitle", "time": 3444.109, "timestamp": "00:57:24", "text": "夜明け？それは"}, {"type": "subtitle", "time": 3461.03, "timestamp": "00:57:41", "text": "奇妙な。私はそれがそうではないという事実が大好きです"}, {"type": "subtitle", "time": 3465.03, "timestamp": "00:57:45", "text": "ボタンプロンプトのようなものも送信します。"}, {"type": "subtitle", "time": 3466.43, "timestamp": "00:57:46", "text": "まるで"}, {"type": "subtitle", "time": 3470.51, "timestamp": "00:57:50", "text": "下へ、ポップが表示されました"}, {"type": "subtitle", "time": 3473.39, "timestamp": "00:57:53", "text": "上。しかし、それは決して弾けなかった"}]
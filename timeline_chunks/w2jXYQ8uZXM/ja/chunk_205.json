[{"type": "subtitle", "time": 12300.87, "timestamp": "03:25:00", "text": "ボブとB。もう矢は持っていますか？"}, {"type": "subtitle", "time": 12303.429, "timestamp": "03:25:03", "text": "うん。"}, {"type": "subtitle", "time": 12305.349, "timestamp": "03:25:05", "text": "ああ、彼らに互いに殴り合うように仕向けることもできるよ。私"}, {"type": "subtitle", "time": 12317.67, "timestamp": "03:25:17", "text": "ああ、なんてことだ、私のパソコンが。"}, {"type": "subtitle", "time": 12319.83, "timestamp": "03:25:19", "text": "ああ、それは頑張ってくれ。そして手に入れた"}, {"type": "subtitle", "time": 12322.349, "timestamp": "03:25:22", "text": "過負荷状態になりました。"}, {"type": "subtitle", "time": 12328.15, "timestamp": "03:25:28", "text": "ああ、それは難しいですね。わかった。設定。"}, {"type": "subtitle", "time": 12332.229, "timestamp": "03:25:32", "text": "高い。いいえ。いいえ。いいえ。D。ただそれを着せただけです"}, {"type": "subtitle", "time": 12334.389, "timestamp": "03:25:34", "text": "中くらい。中火にしてください。ええ、私は"}, {"type": "subtitle", "time": 12336.309, "timestamp": "03:25:36", "text": "低く設定する。私もそう思います。取る"}, {"type": "subtitle", "time": 12339.91, "timestamp": "03:25:39", "text": "でも、私は配信しているんです。"}, {"type": "subtitle", "time": 12342.95, "timestamp": "03:25:42", "text": "わかった。ゲームを開始します。ゲーム開始ですか、それとも"}, {"type": "subtitle", "time": 12345.19, "timestamp": "03:25:45", "text": "ゲームに参加しますか？私は「ゲーム開始」をクリックしました。参加する"}, {"type": "subtitle", "time": 12347.51, "timestamp": "03:25:47", "text": "ゲーム。私は「ゲーム開始」をクリックしました。ああ、君"}, {"type": "subtitle", "time": 12349.51, "timestamp": "03:25:49", "text": "必要になるかもしれない 必要になるかもしれない 好きになるかもしれない"}, {"type": "subtitle", "time": 12351.83, "timestamp": "03:25:51", "text": "このゲームはもうやめてください"}, {"type": "subtitle", "time": 12354.389, "timestamp": "03:25:54", "text": "ゲームには何て言うんだっけ"}, {"type": "subtitle", "time": 12358.79, "timestamp": "03:25:58", "text": "それ？メニューに戻るには、こちらをクリックしてください。"}]
[{"type": "subtitle", "time": 19622.47, "timestamp": "05:27:02", "text": "それは何をするものですか？敵を倒すと、"}, {"type": "subtitle", "time": 19625.27, "timestamp": "05:27:05", "text": "爆発すると、近くのすべての敵にダメージを与える。"}, {"type": "subtitle", "time": 19628.07, "timestamp": "05:27:08", "text": "誰か欲しい人いますか？"}, {"type": "subtitle", "time": 19631.91, "timestamp": "05:27:11", "text": "入手できます。それを得る。削除する方法"}, {"type": "subtitle", "time": 19634.55, "timestamp": "05:27:14", "text": "アイテム。"}, {"type": "subtitle", "time": 19638.55, "timestamp": "05:27:18", "text": "ああ、犬に食べさせればいいよ。"}, {"type": "subtitle", "time": 19644.23, "timestamp": "05:27:24", "text": "うん。簡単。"}, {"type": "subtitle", "time": 19648.708, "timestamp": "05:27:28", "text": "私はズボンをあげます。"}, {"type": "subtitle", "time": 19650.31, "timestamp": "05:27:30", "text": "わーい。"}, {"type": "subtitle", "time": 19656.75, "timestamp": "05:27:36", "text": "[音楽]"}, {"type": "subtitle", "time": 19659.67, "timestamp": "05:27:39", "text": "わーい。骨釘が欲しい人がいたら、"}, {"type": "subtitle", "time": 19674.708, "timestamp": "05:27:54", "text": "あなたは1勝しました。"}]
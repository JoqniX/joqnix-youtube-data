[{"type": "subtitle", "time": 17160.47, "timestamp": "04:46:00", "text": "そこには。"}, {"type": "subtitle", "time": 17164.47, "timestamp": "04:46:04", "text": "あなたたち二人はどこにいるの？見上げる。"}, {"type": "subtitle", "time": 17168.47, "timestamp": "04:46:08", "text": "上。ああ、上へ上へ上へ。"}, {"type": "subtitle", "time": 17172.07, "timestamp": "04:46:12", "text": "あなたは天国への階段を築いているのです。私"}, {"type": "subtitle", "time": 17173.91, "timestamp": "04:46:13", "text": "私たちの仕事についてはよく知らない。私がやります。"}, {"type": "subtitle", "time": 17176.878, "timestamp": "04:46:16", "text": "私がやります。 続けて。"}, {"type": "subtitle", "time": 17196.868, "timestamp": "04:46:36", "text": "最悪だ。よし、"}, {"type": "subtitle", "time": 17199.91, "timestamp": "04:46:39", "text": "何か上のもの、あるいは私たちが"}, {"type": "subtitle", "time": 17201.23, "timestamp": "04:46:41", "text": "行く"}, {"type": "subtitle", "time": 17204.948, "timestamp": "04:46:44", "text": "ここでまた死ぬなんて。あ、待って、"}, {"type": "subtitle", "time": 17207.35, "timestamp": "04:46:47", "text": "待って、待って、待って。来ないでください。"}, {"type": "subtitle", "time": 17211.11, "timestamp": "04:46:51", "text": "いい考えがある。移動します"}, {"type": "subtitle", "time": 17213.75, "timestamp": "04:46:53", "text": "プラットフォームのようにして、それからまた上に上がる"}]
[{"type": "subtitle", "time": 19563.99, "timestamp": "05:26:03", "text": "お腹が空きました。どうすればそれを手に入れられますか？どうやって"}, {"type": "subtitle", "time": 19567.27, "timestamp": "05:26:07", "text": "水面にZの文字を置く？"}, {"type": "subtitle", "time": 19569.43, "timestamp": "05:26:09", "text": "キンバーと書いてある、ああ、置かなきゃ"}, {"type": "subtitle", "time": 19572.15, "timestamp": "05:26:12", "text": "私の機材の中で。うん。ああ、これは"}, {"type": "subtitle", "time": 19575.51, "timestamp": "05:26:15", "text": "両者よりも速い。"}, {"type": "subtitle", "time": 19577.51, "timestamp": "05:26:17", "text": "速くて、まるで"}, {"type": "subtitle", "time": 19585.31, "timestamp": "05:26:25", "text": "唯一の欠点は、物を置けないこと"}, {"type": "subtitle", "time": 19587.51, "timestamp": "05:26:27", "text": "そこには。でも、あそこに私のピングが見えますか？"}, {"type": "subtitle", "time": 19590.868, "timestamp": "05:26:30", "text": "右側ですか？うん。"}, {"type": "subtitle", "time": 19593.03, "timestamp": "05:26:33", "text": "うん。次回はそこに行く必要がある"}, {"type": "subtitle", "time": 19600.31, "timestamp": "05:26:40", "text": "では、誰のセーブデータなのでしょうか？"}, {"type": "subtitle", "time": 19603.51, "timestamp": "05:26:43", "text": "ええと、それは私たちのものです。"}, {"type": "subtitle", "time": 19606.23, "timestamp": "05:26:46", "text": "H."}, {"type": "subtitle", "time": 19608.47, "timestamp": "05:26:48", "text": "だから、心配しないでください。彼がそうしないことを願う"}, {"type": "subtitle", "time": 19612.15, "timestamp": "05:26:52", "text": "彼のセーブデータを削除してください。ああ、新しい"}, {"type": "subtitle", "time": 19615.43, "timestamp": "05:26:55", "text": "アルマノ社の耐火性能。ああ、私たちは精神力を持っている。"}, {"type": "subtitle", "time": 19619.51, "timestamp": "05:26:59", "text": "スピリットはOK、収集します。"}]
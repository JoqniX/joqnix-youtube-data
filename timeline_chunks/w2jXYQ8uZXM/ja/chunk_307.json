[{"type": "subtitle", "time": 18423.67, "timestamp": "05:07:03", "text": "何？食べ物を手に入れよう。"}, {"type": "subtitle", "time": 18425.35, "timestamp": "05:07:05", "text": "掴め。ジョックにいくつか与える必要がある"}, {"type": "subtitle", "time": 18431.91, "timestamp": "05:07:11", "text": "見つける アーマーを取り戻して、どこに"}, {"type": "subtitle", "time": 18435.11, "timestamp": "05:07:15", "text": "鎧？私があなたにあげたんですよね？"}, {"type": "subtitle", "time": 18439.03, "timestamp": "05:07:19", "text": "頭部のみ。何だけ？うん。ここ"}, {"type": "subtitle", "time": 18441.19, "timestamp": "05:07:21", "text": "行くぞ。捨ててもいいですか？どうぞ。わかった、"}, {"type": "subtitle", "time": 18443.868, "timestamp": "05:07:23", "text": "ここで見つけました。ああ、何"}, {"type": "subtitle", "time": 18446.23, "timestamp": "05:07:26", "text": "何が残っているのか？何？残っているものは"}, {"type": "subtitle", "time": 18474.628, "timestamp": "05:07:54", "text": "水に関する問題はありますか？水"}, {"type": "subtitle", "time": 18479.59, "timestamp": "05:07:59", "text": "強さ？そう思う。私"}]
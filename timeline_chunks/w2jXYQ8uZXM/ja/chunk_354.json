[{"type": "subtitle", "time": 21251.43, "timestamp": "05:54:11", "text": "水のポニー。私を覚えていますか？はい。"}, {"type": "subtitle", "time": 21254.23, "timestamp": "05:54:14", "text": "こんばんは。こんにちは。"}, {"type": "subtitle", "time": 21256.07, "timestamp": "05:54:16", "text": "待って、いつそのメッセージが送信されたの？"}, {"type": "subtitle", "time": 21294.948, "timestamp": "05:54:54", "text": "分。えっと、昼食を食べます。えっと"}, {"type": "subtitle", "time": 21298.15, "timestamp": "05:54:58", "text": "お茶。お茶。お茶と軽食は"}]
[{"type": "subtitle", "time": 12607.15, "timestamp": "03:30:07", "text": "赤ちゃん。私"}, {"type": "subtitle", "time": 12610.87, "timestamp": "03:30:10", "text": "忘れた。待って、ゲームを終了してもいいですか？私"}, {"type": "subtitle", "time": 12613.11, "timestamp": "03:30:13", "text": "「続行」を押しました。忘れた。私は"}, {"type": "subtitle", "time": 12615.03, "timestamp": "03:30:15", "text": "変更する"}, {"type": "subtitle", "time": 12617.19, "timestamp": "03:30:17", "text": "いやいや、心配しないでください。やり直すことができます"}, {"type": "subtitle", "time": 12619.83, "timestamp": "03:30:19", "text": "それ。私たちは何かを作る必要がある"}, {"type": "subtitle", "time": 12622.95, "timestamp": "03:30:22", "text": "そして、僕たちは自分たちのキャラクターを兄弟のように作ることができる。"}, {"type": "subtitle", "time": 12624.389, "timestamp": "03:30:24", "text": "心配しないで。知っている。君ならそうしてくれると分かってるよ"}, {"type": "subtitle", "time": 12626.79, "timestamp": "03:30:26", "text": "そんな感じ。だから、私は既に知っていた。"}, {"type": "subtitle", "time": 12630.229, "timestamp": "03:30:30", "text": "どういう意味ですか？あなたは既に知っていたはずだ。"}, {"type": "subtitle", "time": 12634.229, "timestamp": "03:30:34", "text": "ああ、大丈夫ですよ。大丈夫だよ、ジョー。大丈夫。"}, {"type": "subtitle", "time": 12637.269, "timestamp": "03:30:37", "text": "私たちはそれを知っています。心配しないで。"}, {"type": "subtitle", "time": 12639.51, "timestamp": "03:30:39", "text": "私たちは既に知っている。ジョー、私たちはもう知っているわ。"}, {"type": "subtitle", "time": 12642.07, "timestamp": "03:30:42", "text": "心配しないで。"}, {"type": "subtitle", "time": 12653.59, "timestamp": "03:30:53", "text": "もう洞窟から出た？うん。 1つ"}, {"type": "subtitle", "time": 12656.87, "timestamp": "03:30:56", "text": "2番。開けてください。だって彼は"}, {"type": "subtitle", "time": 12659.75, "timestamp": "03:30:59", "text": "君らしく行け。いやいや、大丈夫です。その"}]
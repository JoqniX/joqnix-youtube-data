[{"type": "subtitle", "time": 15881.63, "timestamp": "04:24:41", "text": "みんな"}, {"type": "subtitle", "time": 15887.11, "timestamp": "04:24:47", "text": "上。おお。ああ、どうやら行き詰まってしまったようだ。おお。おお、"}, {"type": "subtitle", "time": 15891.389, "timestamp": "04:24:51", "text": "くそ。ああ、くそ。ああ、くそ。おお、"}, {"type": "subtitle", "time": 15895.51, "timestamp": "04:24:55", "text": "くそ。私についてこないでください。聖なる。私は"}, {"type": "subtitle", "time": 15897.269, "timestamp": "04:24:57", "text": "既に行き詰まっている。"}, {"type": "subtitle", "time": 15899.95, "timestamp": "04:24:59", "text": "ああ、とにかく前に進み続けよう。マナを作る"}]
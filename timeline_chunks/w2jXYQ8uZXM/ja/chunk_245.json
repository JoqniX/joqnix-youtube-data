[{"type": "subtitle", "time": 14711.07, "timestamp": "04:05:11", "text": "[音楽]"}, {"type": "subtitle", "time": 14719.67, "timestamp": "04:05:19", "text": "遅れた人生。なぜ私の仲間はいつも"}, {"type": "subtitle", "time": 14721.75, "timestamp": "04:05:21", "text": "遅れている？"}, {"type": "subtitle", "time": 14724.03, "timestamp": "04:05:24", "text": "生きて、死なない"}, {"type": "subtitle", "time": 14728.55, "timestamp": "04:05:28", "text": "仕事。えっと、起きて。魂を目覚めさせるとは"}, {"type": "subtitle", "time": 14731.71, "timestamp": "04:05:31", "text": "私を精神的に支えてくれる存在は？ああ、それは"}, {"type": "subtitle", "time": 14735.83, "timestamp": "04:05:35", "text": "うん、一緒にやるよね？"}, {"type": "subtitle", "time": 14738.15, "timestamp": "04:05:38", "text": "うん。"}, {"type": "subtitle", "time": 14743.309, "timestamp": "04:05:43", "text": "私に従ってください。小枝をたくさん手に入れました"}, {"type": "subtitle", "time": 14746.15, "timestamp": "04:05:46", "text": "ココナッツ。階段を作ったんですか？"}, {"type": "subtitle", "time": 14749.349, "timestamp": "04:05:49", "text": "何てことだ。天国への道。はい、そうしました。私"}, {"type": "subtitle", "time": 14752.55, "timestamp": "04:05:52", "text": "した。はい、そうしました。"}, {"type": "subtitle", "time": 14754.389, "timestamp": "04:05:54", "text": "ああ、くそ。"}]
[{"type": "subtitle", "time": 9121.469, "timestamp": "02:32:01", "text": "[音楽]"}, {"type": "subtitle", "time": 9124.389, "timestamp": "02:32:04", "text": "枯れていく？あのね？こちらをご覧ください"}, {"type": "subtitle", "time": 9138.19, "timestamp": "02:32:18", "text": "日。こんにちは、また戻ってきます。楽しむ"}, {"type": "subtitle", "time": 9141.51, "timestamp": "02:32:21", "text": "カムバック。はい、私たちは"}, {"type": "subtitle", "time": 9142.71, "timestamp": "02:32:22", "text": "荷解き"}, {"type": "subtitle", "time": 9145.429, "timestamp": "02:32:25", "text": "[音楽]"}, {"type": "subtitle", "time": 9149.469, "timestamp": "02:32:29", "text": "えーと、販売中止とか、えーと"}, {"type": "subtitle", "time": 9152.469, "timestamp": "02:32:32", "text": "延期するか、実際にストリーミング配信するか"}, {"type": "subtitle", "time": 9155.429, "timestamp": "02:32:35", "text": "このゲーム。私はついに来た"}, {"type": "subtitle", "time": 9163.95, "timestamp": "02:32:43", "text": "それ。とても長い間"}, {"type": "subtitle", "time": 9168.28, "timestamp": "02:32:48", "text": "長い間 実際にこのゲームをプレイしましたが、"}, {"type": "subtitle", "time": 9171.359, "timestamp": "02:32:51", "text": "実際にこのゲームをプレイしましたが、 このゲーム"}, {"type": "subtitle", "time": 9178.389, "timestamp": "02:32:58", "text": "あまりにも。うん。こんにちは、ブラッド。おはよう。"}]
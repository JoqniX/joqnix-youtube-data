[{"type": "subtitle", "time": 15661.11, "timestamp": "04:21:01", "text": "もしそれが美味しい珍味なら、"}, {"type": "subtitle", "time": 15664.55, "timestamp": "04:21:04", "text": "珍味ですね？わからない。もしかしたらあなたは"}, {"type": "subtitle", "time": 15666.79, "timestamp": "04:21:06", "text": "レモネードを殺したい。わあ、彼らは"}, {"type": "subtitle", "time": 15668.95, "timestamp": "04:21:08", "text": "私にとって貴重なもの"}, {"type": "subtitle", "time": 15673.429, "timestamp": "04:21:13", "text": "食べる。なぜ？それらはある意味で人間であり"}, {"type": "subtitle", "time": 15675.429, "timestamp": "04:21:15", "text": "肉体も全て。どうやって？彼らはどうですか"}, {"type": "subtitle", "time": 15678.149, "timestamp": "04:21:18", "text": "人間？彼らは魚人だ。彼らはできない"}, {"type": "subtitle", "time": 15680.79, "timestamp": "04:21:20", "text": "中間言語で話す。"}, {"type": "subtitle", "time": 15682.389, "timestamp": "04:21:22", "text": "なんてこった。魚は話すことができる"}, {"type": "subtitle", "time": 15687.469, "timestamp": "04:21:27", "text": "ああ、"}, {"type": "subtitle", "time": 15697.71, "timestamp": "04:21:37", "text": "これ。よし、金色のものをいくつか。"}]
[{"type": "subtitle", "time": 18841.03, "timestamp": "05:14:01", "text": "彼を手に入れるな。あれらを見て。見てください"}, {"type": "subtitle", "time": 18844.628, "timestamp": "05:14:04", "text": "この髪。ちくしょう。ニース。"}, {"type": "subtitle", "time": 18845.868, "timestamp": "05:14:05", "text": "彼らは投げている"}, {"type": "subtitle", "time": 18848.47, "timestamp": "05:14:08", "text": "彼女。えーと、みんな早く来て"}, {"type": "subtitle", "time": 18850.55, "timestamp": "05:14:10", "text": "一緒に、なぜなら、その後"}, {"type": "subtitle", "time": 18865.708, "timestamp": "05:14:25", "text": "真ん中も"}, {"type": "subtitle", "time": 18867.55, "timestamp": "05:14:27", "text": "損傷する"}, {"type": "subtitle", "time": 18871.07, "timestamp": "05:14:31", "text": "餌。それが私がやろうとしていることです"}, {"type": "subtitle", "time": 18872.75, "timestamp": "05:14:32", "text": "する。"}, {"type": "subtitle", "time": 18875.03, "timestamp": "05:14:35", "text": "うん。ペニスって書いてください。私にはペニスがありますから。"}, {"type": "subtitle", "time": 18876.628, "timestamp": "05:14:36", "text": "必要。"}]
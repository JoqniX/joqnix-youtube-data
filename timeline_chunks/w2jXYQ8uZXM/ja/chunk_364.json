[{"type": "subtitle", "time": 21840.948, "timestamp": "06:04:00", "text": "今日私が草に触れに行った理由と、"}, {"type": "subtitle", "time": 21846.99, "timestamp": "06:04:06", "text": "少し遅れて戻ってきて、"}, {"type": "subtitle", "time": 21849.83, "timestamp": "06:04:09", "text": "会議のため、ここにいます。私は授業を受けています"}, {"type": "subtitle", "time": 21881.27, "timestamp": "06:04:41", "text": "えっと、私の音声レベルは大丈夫ですか？できますか、できますか"}, {"type": "subtitle", "time": 21884.708, "timestamp": "06:04:44", "text": "もしそれが私の"}, {"type": "subtitle", "time": 21888.948, "timestamp": "06:04:48", "text": "音声レベルは大丈夫ですか？私の声は聞こえますか？そしてああ"}, {"type": "subtitle", "time": 21893.19, "timestamp": "06:04:53", "text": "待って、これをやらなきゃ。私の声は聞こえていますか？"}, {"type": "subtitle", "time": 21896.31, "timestamp": "06:04:56", "text": "そしてそれは、"}, {"type": "subtitle", "time": 21898.31, "timestamp": "06:04:58", "text": "バックグラウンドミュージックは私の"}]
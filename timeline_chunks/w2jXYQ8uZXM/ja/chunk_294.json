[{"type": "subtitle", "time": 17651.91, "timestamp": "04:54:11", "text": "ああ、吸血鬼が出てきたよ。"}, {"type": "subtitle", "time": 17656.15, "timestamp": "04:54:16", "text": "吸血鬼。ああ、精霊の標的"}, {"type": "subtitle", "time": 17659.27, "timestamp": "04:54:19", "text": "骨の棍棒。ブルドッグ用ベッド。基本的な快適さ"}, {"type": "subtitle", "time": 17661.31, "timestamp": "04:54:21", "text": "セット"}, {"type": "subtitle", "time": 17671.67, "timestamp": "04:54:31", "text": "魚がいるところに魚を放つ。だから待って"}, {"type": "subtitle", "time": 17674.39, "timestamp": "04:54:34", "text": "デモ版にはたくさんの内容があります。すべての"}, {"type": "subtitle", "time": 17676.788, "timestamp": "04:54:36", "text": "これらはデモ用です。"}, {"type": "subtitle", "time": 17678.83, "timestamp": "04:54:38", "text": "うん。"}, {"type": "subtitle", "time": 17681.91, "timestamp": "04:54:41", "text": "うわ、信じられない。あなたはまだ"}, {"type": "subtitle", "time": 17690.65, "timestamp": "04:54:50", "text": "さらに、別の経歴も掲載されています。"}, {"type": "subtitle", "time": 17698.55, "timestamp": "04:54:58", "text": "このゲームはかなり良いですね。"}]
[{"type": "subtitle", "time": 19265.03, "timestamp": "05:21:05", "text": "殺した後何も得られなかった"}, {"type": "subtitle", "time": 19268.39, "timestamp": "05:21:08", "text": "サメ。えっと"}, {"type": "subtitle", "time": 19270.55, "timestamp": "05:21:10", "text": "あるいは、そんな感じ。まるで本当に紫色"}, {"type": "subtitle", "time": 19277.99, "timestamp": "05:21:17", "text": "はぁ？箱はどこですか？"}, {"type": "subtitle", "time": 19304.75, "timestamp": "05:21:44", "text": "今行くよ。私はできると思う"}, {"type": "subtitle", "time": 19307.59, "timestamp": "05:21:47", "text": "見て、アイミング。ああ、敵だ。卵と治癒"}, {"type": "subtitle", "time": 19316.55, "timestamp": "05:21:56", "text": "卵もその物を使う"}]
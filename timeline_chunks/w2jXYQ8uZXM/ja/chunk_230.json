[{"type": "subtitle", "time": 13800.469, "timestamp": "03:50:00", "text": "確認してみます。川はまだ"}, {"type": "subtitle", "time": 13806.71, "timestamp": "03:50:06", "text": "戻ってきました。戻ってきました。戻ってきました。私はしなければならない"}, {"type": "subtitle", "time": 13809.269, "timestamp": "03:50:09", "text": "助けてください。あなたは今私ですか？はい、そうしました。私は"}, {"type": "subtitle", "time": 13811.11, "timestamp": "03:50:11", "text": "数分間。何てことだ。わかった。"}, {"type": "subtitle", "time": 13815.03, "timestamp": "03:50:15", "text": "近日公開。私はチームの諸々の作業を手伝っています。"}, {"type": "subtitle", "time": 13816.79, "timestamp": "03:50:16", "text": "これはかなり進んだところだ"}, {"type": "subtitle", "time": 13818.55, "timestamp": "03:50:18", "text": "男。"}, {"type": "subtitle", "time": 13820.83, "timestamp": "03:50:20", "text": "基本的な生活。何が"}, {"type": "subtitle", "time": 13823.87, "timestamp": "03:50:23", "text": "これ？敵を倒せ。スポーン"}, {"type": "subtitle", "time": 13826.63, "timestamp": "03:50:26", "text": "槍。私はもう限界です 私たちはある意味作りました"}, {"type": "subtitle", "time": 13829.309, "timestamp": "03:50:29", "text": "この場所はとても空っぽで、"}, {"type": "subtitle", "time": 13832.95, "timestamp": "03:50:32", "text": "はぁ？光ファイバーはありません。彼らは復活する。"}, {"type": "subtitle", "time": 13836.229, "timestamp": "03:50:36", "text": "そうなんです。いや、いや。復活するよ。私たちはそうしません"}, {"type": "subtitle", "time": 13838.309, "timestamp": "03:50:38", "text": "今すぐ必要だ。私たちは手に入れる必要がある"}, {"type": "subtitle", "time": 13840.87, "timestamp": "03:50:40", "text": "いくつか情報があります。殺す必要がある"}, {"type": "subtitle", "time": 13842.95, "timestamp": "03:50:42", "text": "敵もいる。今すぐ男を手に入れろ。来て、"}, {"type": "subtitle", "time": 13845.269, "timestamp": "03:50:45", "text": "みんな。うん。私は殺さなければならない"}, {"type": "subtitle", "time": 13849.99, "timestamp": "03:50:49", "text": "敵。何かありますか？"}, {"type": "subtitle", "time": 13852.95, "timestamp": "03:50:52", "text": "えっと、武器？"}, {"type": "subtitle", "time": 13857.349, "timestamp": "03:50:57", "text": "ああ、そうかい。君のために槍を作ってあげよう。"}]
[{"type": "subtitle", "time": 12840.07, "timestamp": "03:34:00", "text": "鳥を飼っているのですか？何てことだ。うん、そうするよ"}, {"type": "subtitle", "time": 12843.59, "timestamp": "03:34:03", "text": "あなたにも一つあげます。来て。"}, {"type": "subtitle", "time": 12846.309, "timestamp": "03:34:06", "text": "知識ポイントを獲得しました。何てことだ。見て"}, {"type": "subtitle", "time": 12849.469, "timestamp": "03:34:09", "text": "アラスにて。そんな建築家"}, {"type": "subtitle", "time": 12852.95, "timestamp": "03:34:12", "text": "人。ああ、彼を見て。では、"}, {"type": "subtitle", "time": 12854.32, "timestamp": "03:34:14", "text": "ゲームの内容は？"}, {"type": "subtitle", "time": 12856.309, "timestamp": "03:34:16", "text": "[音楽]"}, {"type": "subtitle", "time": 12859.269, "timestamp": "03:34:19", "text": "私はただ、工作に使う材料を集めているだけです。"}, {"type": "subtitle", "time": 12861.349, "timestamp": "03:34:21", "text": "ああ、心配しないでください。たくさんの物があります。"}, {"type": "subtitle", "time": 12864.51, "timestamp": "03:34:24", "text": "大丈夫ですよ。来て。来る"}, {"type": "subtitle", "time": 12867.429, "timestamp": "03:34:27", "text": "ここ。景色をお楽しみください。今は"}, {"type": "subtitle", "time": 12870.229, "timestamp": "03:34:30", "text": "生き残るためだけに。そしてMを押すと、"}, {"type": "subtitle", "time": 12871.83, "timestamp": "03:34:31", "text": "疑問符が見えますね。あなたは"}, {"type": "subtitle", "time": 12873.75, "timestamp": "03:34:33", "text": "地図上に疑問符のようなものが見えますか？"}, {"type": "subtitle", "time": 12875.429, "timestamp": "03:34:35", "text": "うん、"}, {"type": "subtitle", "time": 12877.269, "timestamp": "03:34:37", "text": "私たちはそれらを手に入れる必要があります。そして、"}, {"type": "subtitle", "time": 12880.71, "timestamp": "03:34:40", "text": "また、ミニボスのように倒す必要がある"}, {"type": "subtitle", "time": 12883.91, "timestamp": "03:34:43", "text": "特定の物を作るため。"}, {"type": "subtitle", "time": 12885.67, "timestamp": "03:34:45", "text": "ええ、こっちに来てください。ああ、ちくしょう。"}, {"type": "subtitle", "time": 12893.99, "timestamp": "03:34:53", "text": "ああ、小枝。わかった。"}, {"type": "subtitle", "time": 12895.67, "timestamp": "03:34:55", "text": "そうそう。また、ミッションも実行してください。"}, {"type": "subtitle", "time": 12897.99, "timestamp": "03:34:57", "text": "彼らを見て。ああ、任務を遂行しろ。わかった、"}]
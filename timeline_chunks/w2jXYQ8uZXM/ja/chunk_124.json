[{"type": "subtitle", "time": 7440.07, "timestamp": "02:04:00", "text": "ストリーム。 Beamstreamに頼んだんだけど、"}, {"type": "subtitle", "time": 7442.07, "timestamp": "02:04:02", "text": "ビームストリームの人々を統合する"}, {"type": "subtitle", "time": 7445.629, "timestamp": "02:04:05", "text": "これ。彼らはこのことを心配していた"}, {"type": "subtitle", "time": 7449.43, "timestamp": "02:04:09", "text": "なぜなら、彼らは問題を抱えていたからです。"}, {"type": "subtitle", "time": 7452.79, "timestamp": "02:04:12", "text": "Tik Tok なぜなら、彼らは"}, {"type": "subtitle", "time": 7455.109, "timestamp": "02:04:15", "text": "公式企業のような、米国企業ではない"}, {"type": "subtitle", "time": 7457.99, "timestamp": "02:04:17", "text": "米国に拠点を置く企業ビームストリーム"}, {"type": "subtitle", "time": 7461.27, "timestamp": "02:04:21", "text": "例えば、TikTok向けに何かを統合するなら"}, {"type": "subtitle", "time": 7463.589, "timestamp": "02:04:23", "text": "米国政府が言うなら、トックとかそういうもの"}, {"type": "subtitle", "time": 7465.669, "timestamp": "02:04:25", "text": "TikTokは米国で禁止され、"}, {"type": "subtitle", "time": 7470.95, "timestamp": "02:04:30", "text": "これを統合して、もしTikTokが"}, {"type": "subtitle", "time": 7474.95, "timestamp": "02:04:34", "text": "アメリカでは禁止されているし、彼らは"}, {"type": "subtitle", "time": 7477.83, "timestamp": "02:04:37", "text": "TikTokのサポートを削除する必要があります"}, {"type": "subtitle", "time": 7480.47, "timestamp": "02:04:40", "text": "そして全て。いいえ。たとえ彼らが"}, {"type": "subtitle", "time": 7484.47, "timestamp": "02:04:44", "text": "したくないけど、やらなきゃいけないから、"}, {"type": "subtitle", "time": 7487.109, "timestamp": "02:04:47", "text": "企業やその他すべて、低価格で"}, {"type": "subtitle", "time": 7488.87, "timestamp": "02:04:48", "text": "すべてが不足している"}, {"type": "subtitle", "time": 7492.629, "timestamp": "02:04:52", "text": "そういうことですよね、それが問題なんです"}, {"type": "subtitle", "time": 7495.83, "timestamp": "02:04:55", "text": "えっと、彼らは私がしたことについて尋ねていました"}, {"type": "subtitle", "time": 7497.709, "timestamp": "02:04:57", "text": "特徴"}]
[{"type": "subtitle", "time": 14100.55, "timestamp": "03:55:00", "text": "戻る。心配しないで。"}, {"type": "subtitle", "time": 14103.67, "timestamp": "03:55:03", "text": "私を忘れないでください。"}, {"type": "subtitle", "time": 14105.269, "timestamp": "03:55:05", "text": "わかった。わかった。私たちは"}, {"type": "subtitle", "time": 14107.189, "timestamp": "03:55:07", "text": "疑問符。来て。わかった。私は私は"}, {"type": "subtitle", "time": 14108.55, "timestamp": "03:55:08", "text": "来るよ。今行ってる。今行ってる。私は"}, {"type": "subtitle", "time": 14110.87, "timestamp": "03:55:10", "text": "行くよ。"}, {"type": "subtitle", "time": 14112.95, "timestamp": "03:55:12", "text": "あと、食事もしてくださいね。"}, {"type": "subtitle", "time": 14115.269, "timestamp": "03:55:15", "text": "食べなければ、健康状態は低下します"}, {"type": "subtitle", "time": 14118.469, "timestamp": "03:55:18", "text": "それは確かに存在する。それは確かに存在する。はい。"}, {"type": "subtitle", "time": 14123.99, "timestamp": "03:55:23", "text": "必ずやり遂げる。心配しないで。私は十分持っている"}, {"type": "subtitle", "time": 14132.15, "timestamp": "03:55:32", "text": "この人たちを見てください。"}, {"type": "subtitle", "time": 14142.15, "timestamp": "03:55:42", "text": "ちなみに、転ばないようにね。それは多くのことをします"}, {"type": "subtitle", "time": 14144.07, "timestamp": "03:55:44", "text": "損害の。"}, {"type": "subtitle", "time": 14147.05, "timestamp": "03:55:47", "text": "おお。"}, {"type": "subtitle", "time": 14149.349, "timestamp": "03:55:49", "text": "[音楽]"}, {"type": "subtitle", "time": 14151.67, "timestamp": "03:55:51", "text": "さて、誰が卵を取るのでしょうか？私は"}, {"type": "subtitle", "time": 14154.67, "timestamp": "03:55:54", "text": "卵をつかむ。実際に構築する"}, {"type": "subtitle", "time": 14157.189, "timestamp": "03:55:57", "text": "階。よし。誰が"}]
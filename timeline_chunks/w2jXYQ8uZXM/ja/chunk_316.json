[{"type": "subtitle", "time": 18961.51, "timestamp": "05:16:01", "text": "全てが終わった。わかった、"}, {"type": "subtitle", "time": 18964.15, "timestamp": "05:16:04", "text": "それはすばらしい。"}, {"type": "subtitle", "time": 18975.67, "timestamp": "05:16:15", "text": "ああ、奴らは復活したんだ。よし、戦おう"}, {"type": "subtitle", "time": 18979.11, "timestamp": "05:16:19", "text": "また。リスポーン。全部手に入れよう。"}, {"type": "subtitle", "time": 18980.51, "timestamp": "05:16:20", "text": "ええ、私は"}, {"type": "subtitle", "time": 18984.31, "timestamp": "05:16:24", "text": "取っ手も片方なくした。わかった。よし、"}, {"type": "subtitle", "time": 18986.23, "timestamp": "05:16:26", "text": "ここに来て、私は行った"}, {"type": "subtitle", "time": 18988.47, "timestamp": "05:16:28", "text": "ゆっくりと。しかし、誰かが"}, {"type": "subtitle", "time": 18990.23, "timestamp": "05:16:30", "text": "餌。"}, {"type": "subtitle", "time": 19011.19, "timestamp": "05:16:51", "text": "別の方向へ進んでください。"}, {"type": "subtitle", "time": 19013.83, "timestamp": "05:16:53", "text": "クリティカルエラーが発生して、動かなくなってしまいました。行く"}, {"type": "subtitle", "time": 19016.31, "timestamp": "05:16:56", "text": "逆方向。あちら側。わかった、行くよ"}]
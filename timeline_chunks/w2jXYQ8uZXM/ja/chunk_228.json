[{"type": "subtitle", "time": 13680.99, "timestamp": "03:48:00", "text": "これは満杯です。"}, {"type": "subtitle", "time": 13684.63, "timestamp": "03:48:04", "text": "何？私の在庫。"}, {"type": "subtitle", "time": 13686.389, "timestamp": "03:48:06", "text": "いいえ、"}, {"type": "subtitle", "time": 13690.63, "timestamp": "03:48:10", "text": "攻撃を受けている。待って。"}, {"type": "subtitle", "time": 13693.11, "timestamp": "03:48:13", "text": "ああ、あなたはどこから来たのですか？"}, {"type": "subtitle", "time": 13694.95, "timestamp": "03:48:14", "text": "私は勝てたはずだ。私は"}, {"type": "subtitle", "time": 13697.469, "timestamp": "03:48:17", "text": "チャレンジ。"}, {"type": "subtitle", "time": 13701.43, "timestamp": "03:48:21", "text": "ああ、ごめんね、犬。私のミスです。"}, {"type": "subtitle", "time": 13708.95, "timestamp": "03:48:28", "text": "1秒。樹脂をいくつかもらってもいいですか？"}, {"type": "subtitle", "time": 13710.87, "timestamp": "03:48:30", "text": "お願いします？"}, {"type": "subtitle", "time": 13713.75, "timestamp": "03:48:33", "text": "ああ、もちろんだよ。どうぞ。ありがとう。"}, {"type": "subtitle", "time": 13731.309, "timestamp": "03:48:51", "text": "包帯。これらのロープを置かせてください"}]
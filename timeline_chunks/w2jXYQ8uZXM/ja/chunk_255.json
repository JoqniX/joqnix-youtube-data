[{"type": "subtitle", "time": 15300.51, "timestamp": "04:15:00", "text": "どうやって"}, {"type": "subtitle", "time": 15303.91, "timestamp": "04:15:03", "text": "どのキーを押せば"}, {"type": "subtitle", "time": 15305.99, "timestamp": "04:15:05", "text": "シールドは発生するのか？"}, {"type": "subtitle", "time": 15309.269, "timestamp": "04:15:09", "text": "えっと、３を押してください。何でも。いや、つまり"}, {"type": "subtitle", "time": 15311.51, "timestamp": "04:15:11", "text": "シールドがどこにあろうと関係ない。何が"}, {"type": "subtitle", "time": 15315.99, "timestamp": "04:15:15", "text": "シールドゾーン？はい、わかりました。"}, {"type": "subtitle", "time": 15317.75, "timestamp": "04:15:17", "text": "何てことだ。私は君が死んでいくのを見ている。私は"}, {"type": "subtitle", "time": 15319.67, "timestamp": "04:15:19", "text": "あなたが死んでいくのを見守る。ところで、彼らは"}, {"type": "subtitle", "time": 15325.67, "timestamp": "04:15:25", "text": "彼はまた死ぬだろう。あなたは私たちですか"}, {"type": "subtitle", "time": 15327.91, "timestamp": "04:15:27", "text": "これを見る予定ですか？見ていますよ。私は"}, {"type": "subtitle", "time": 15330.87, "timestamp": "04:15:30", "text": "悲しいことに、ここでも亡くなる人がいる。"}, {"type": "subtitle", "time": 15333.349, "timestamp": "04:15:33", "text": "私はそのうちの2人と戦っている。"}, {"type": "subtitle", "time": 15335.03, "timestamp": "04:15:35", "text": "ああ、それは素晴らしいですね。私は、私は"}, {"type": "subtitle", "time": 15337.349, "timestamp": "04:15:37", "text": "唯一。"}, {"type": "subtitle", "time": 15339.03, "timestamp": "04:15:39", "text": "手伝ってくれるよ、ジョー。後で行きます"}, {"type": "subtitle", "time": 15353.59, "timestamp": "04:15:53", "text": "よお、おい。今行ってる。心配しないで。"}, {"type": "subtitle", "time": 15356.389, "timestamp": "04:15:56", "text": "今、この森を手に入れているところです。"}]
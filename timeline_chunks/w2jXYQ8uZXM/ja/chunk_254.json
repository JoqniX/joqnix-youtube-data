[{"type": "subtitle", "time": 15240.03, "timestamp": "04:14:00", "text": "では、待ってください。"}, {"type": "subtitle", "time": 15242.67, "timestamp": "04:14:02", "text": "えっと、質問があります。"}, {"type": "subtitle", "time": 15246.429, "timestamp": "04:14:06", "text": "あの、"}, {"type": "subtitle", "time": 15250.07, "timestamp": "04:14:10", "text": "Can Wait を手に入れる、何？トーテムがあった"}, {"type": "subtitle", "time": 15252.189, "timestamp": "04:14:12", "text": "そういう類のもの。それは何"}, {"type": "subtitle", "time": 15254.87, "timestamp": "04:14:14", "text": "あなたのトーテム。"}, {"type": "subtitle", "time": 15256.63, "timestamp": "04:14:16", "text": "ええ、トーテムのようなものがありました"}, {"type": "subtitle", "time": 15259.51, "timestamp": "04:14:19", "text": "間違った方法。"}, {"type": "subtitle", "time": 15261.75, "timestamp": "04:14:21", "text": "ええ、わかっています。"}, {"type": "subtitle", "time": 15265.389, "timestamp": "04:14:25", "text": "うん。なぜ家に帰るのですか？私はゴールに到達しました"}, {"type": "subtitle", "time": 15269.189, "timestamp": "04:14:29", "text": "トーテム。アイテムを取り戻せません。同じ。私"}, {"type": "subtitle", "time": 15273.07, "timestamp": "04:14:33", "text": "それはできません。荷物は手に入れたよ。"}, {"type": "subtitle", "time": 15277.429, "timestamp": "04:14:37", "text": "ほら、私、攻撃されてるでしょ。彼らは死んだ"}, {"type": "subtitle", "time": 15278.99, "timestamp": "04:14:38", "text": "また。"}, {"type": "subtitle", "time": 15283.03, "timestamp": "04:14:43", "text": "よし、マナを手に入れた。"}, {"type": "subtitle", "time": 15285.51, "timestamp": "04:14:45", "text": "まあ、またここに来ればいいんじゃない？"}, {"type": "subtitle", "time": 15287.189, "timestamp": "04:14:47", "text": "いや、いや、いや。待って、待って、待って、待って。私は"}, {"type": "subtitle", "time": 15290.71, "timestamp": "04:14:50", "text": "こいつらを殺してやる。のような"}, {"type": "subtitle", "time": 15293.429, "timestamp": "04:14:53", "text": "8人があそこにいる。私にはそれがわかる。"}, {"type": "subtitle", "time": 15295.51, "timestamp": "04:14:55", "text": "うん。"}, {"type": "subtitle", "time": 15298.79, "timestamp": "04:14:58", "text": "どこへ行ったの？ああ、あそこにあるよ。"}]
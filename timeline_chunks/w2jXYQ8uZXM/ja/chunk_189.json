[{"type": "subtitle", "time": 11346.07, "timestamp": "03:09:06", "text": "ああ、樹脂が必要だ。"}, {"type": "subtitle", "time": 11364.83, "timestamp": "03:09:24", "text": "食べ物。私たちはもっとあの食べ物が必要です"}, {"type": "subtitle", "time": 11374.309, "timestamp": "03:09:34", "text": "宝石。ねえ、いくらですか"}, {"type": "subtitle", "time": 11376.03, "timestamp": "03:09:36", "text": "うん、取って"}, {"type": "subtitle", "time": 11381.71, "timestamp": "03:09:41", "text": "ここ"}, {"type": "subtitle", "time": 11385.67, "timestamp": "03:09:45", "text": "これは、ほら、私は繊維を入れるんだ"}, {"type": "subtitle", "time": 11388.95, "timestamp": "03:09:48", "text": "ここに持って行けば、I に持っていくことができます"}, {"type": "subtitle", "time": 11392.309, "timestamp": "03:09:52", "text": "記事に載せてください。よし。私は必要としている"}, {"type": "subtitle", "time": 11396.63, "timestamp": "03:09:56", "text": "たくさん「いいえ、繊維が必要です」だから私は"}]
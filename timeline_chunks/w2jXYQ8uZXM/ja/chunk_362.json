[{"type": "subtitle", "time": 21725.27, "timestamp": "06:02:05", "text": "こんにちは。こんにちは。そう、私はただ"}, {"type": "subtitle", "time": 21732.35, "timestamp": "06:02:12", "text": "不和。私は保管しません"}, {"type": "subtitle", "time": 21735.59, "timestamp": "06:02:15", "text": "忘れること。うん。こんにちは。うん。こんにちは"}, {"type": "subtitle", "time": 21739.43, "timestamp": "06:02:19", "text": "みんな。皆さん、お元気ですか？"}, {"type": "subtitle", "time": 21740.99, "timestamp": "06:02:20", "text": "私にさせてください"}, {"type": "subtitle", "time": 21744.708, "timestamp": "06:02:24", "text": "ただ私にさせてください"}, {"type": "subtitle", "time": 21752.788, "timestamp": "06:02:32", "text": "あれ。こんにちは、シャードフィッシュ。いらっしゃいませ、"}, {"type": "subtitle", "time": 21755.35, "timestamp": "06:02:35", "text": "ようこそ、ようこそ。 Twitchでライブ配信中"}, {"type": "subtitle", "time": 21764.47, "timestamp": "06:02:44", "text": "ええ、私は、"}, {"type": "subtitle", "time": 21766.75, "timestamp": "06:02:46", "text": "えっと、"}, {"type": "subtitle", "time": 21768.43, "timestamp": "06:02:48", "text": "ストリーム"}, {"type": "subtitle", "time": 21771.59, "timestamp": "06:02:51", "text": "明日、でも私はそう感じた"}, {"type": "subtitle", "time": 21775.39, "timestamp": "06:02:55", "text": "最後の配信を約束します。"}]
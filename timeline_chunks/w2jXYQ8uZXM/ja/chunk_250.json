[{"type": "subtitle", "time": 15000.79, "timestamp": "04:10:00", "text": "もの。"}, {"type": "subtitle", "time": 15004.07, "timestamp": "04:10:04", "text": "他のものも失くしてしまうよ、えっと"}, {"type": "subtitle", "time": 15006.63, "timestamp": "04:10:06", "text": "ブーツとか、そういうやつだよ。いいえ。"}, {"type": "subtitle", "time": 15008.79, "timestamp": "04:10:08", "text": "武器を紛失した？思い出せますか"}, {"type": "subtitle", "time": 15009.55, "timestamp": "04:10:09", "text": "彼ら"}, {"type": "subtitle", "time": 15012.229, "timestamp": "04:10:12", "text": "また？いや、違うよ。"}, {"type": "subtitle", "time": 15015.189, "timestamp": "04:10:15", "text": "兄弟、"}, {"type": "subtitle", "time": 15019.189, "timestamp": "04:10:19", "text": "眠っている精霊を回収できますか？"}, {"type": "subtitle", "time": 15034.229, "timestamp": "04:10:34", "text": "古代遺跡へ旅する。私はただ"}, {"type": "subtitle", "time": 15036.87, "timestamp": "04:10:36", "text": "彼はこの仕事を試してみたと言っていた。彼はただ試しただけ"}, {"type": "subtitle", "time": 15039.11, "timestamp": "04:10:39", "text": "この仕事。"}, {"type": "subtitle", "time": 15043.75, "timestamp": "04:10:43", "text": "ああ、私の荷物を回収してくれるんですか？私 私"}, {"type": "subtitle", "time": 15046.55, "timestamp": "04:10:46", "text": "たくさん手に入れた。"}, {"type": "subtitle", "time": 15049.83, "timestamp": "04:10:49", "text": "いいえ、ジャンプはできません。それは消滅します、"}, {"type": "subtitle", "time": 15052.59, "timestamp": "04:10:52", "text": "兄弟。これは何ですか"}, {"type": "subtitle", "time": 15056.469, "timestamp": "04:10:56", "text": "ゲーム？死亡した場合、所持品はすべて失われます。"}, {"type": "subtitle", "time": 15059.83, "timestamp": "04:10:59", "text": "ああ、だったら死ななければいいだけだよ。私はただ"}]
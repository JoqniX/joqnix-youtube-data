[{"type": "subtitle", "time": 12361.349, "timestamp": "03:26:01", "text": "どうすれば戻れますか？ゲームを完全に終了してください。"}, {"type": "subtitle", "time": 12363.11, "timestamp": "03:26:03", "text": "いいえ、ゲームを完全に終了する必要があります。"}, {"type": "subtitle", "time": 12366.229, "timestamp": "03:26:06", "text": "わかった。すべて完了。"}, {"type": "subtitle", "time": 12369.59, "timestamp": "03:26:09", "text": "おお。うん、ちょっと変だよね。"}, {"type": "subtitle", "time": 12372.55, "timestamp": "03:26:12", "text": "デモ版だからかもしれませんね。"}, {"type": "subtitle", "time": 12374.469, "timestamp": "03:26:14", "text": "ええ、おそらくそうでしょう。大丈夫です。ああ、もっと"}, {"type": "subtitle", "time": 12381.91, "timestamp": "03:26:21", "text": "なぜあんな奴らに矢を無駄遣いするんだ？"}, {"type": "subtitle", "time": 12383.79, "timestamp": "03:26:23", "text": "頭を殴ればいい。"}, {"type": "subtitle", "time": 12386.63, "timestamp": "03:26:26", "text": "痛い。わかった。"}, {"type": "subtitle", "time": 12395.03, "timestamp": "03:26:35", "text": "ともかく、盗賊に関するニュースをいくつか紹介しよう。"}, {"type": "subtitle", "time": 12403.75, "timestamp": "03:26:43", "text": "よし、再起動するよ。"}, {"type": "subtitle", "time": 12407.19, "timestamp": "03:26:47", "text": "うん。えっと、アラスさん、彼に送ってください"}, {"type": "subtitle", "time": 12409.83, "timestamp": "03:26:49", "text": "ゲームに参加するためのコードなので、彼は"}, {"type": "subtitle", "time": 12413.349, "timestamp": "03:26:53", "text": "もう一度ゲーム開始ボタンを押してください。"}]
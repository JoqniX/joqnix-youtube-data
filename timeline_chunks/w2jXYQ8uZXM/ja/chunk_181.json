[{"type": "subtitle", "time": 10861.63, "timestamp": "03:01:01", "text": "チョッパー。ヘリコプターは"}, {"type": "subtitle", "time": 10874.309, "timestamp": "03:01:14", "text": "よし、次はこれだ。もっと必要だ"}, {"type": "subtitle", "time": 10877.349, "timestamp": "03:01:17", "text": "石。作れると思いますよ。"}, {"type": "subtitle", "time": 10879.75, "timestamp": "03:01:19", "text": "あなた自身のために？"}, {"type": "subtitle", "time": 10882.389, "timestamp": "03:01:22", "text": "いいえ、今は違います。私は掴んでいる"}, {"type": "subtitle", "time": 10885.19, "timestamp": "03:01:25", "text": "将来必要になるかもしれないもの、例えば"}, {"type": "subtitle", "time": 10887.269, "timestamp": "03:01:27", "text": "棒。木材を取りに行く"}, {"type": "subtitle", "time": 10889.55, "timestamp": "03:01:29", "text": "それから。"}, {"type": "subtitle", "time": 10892.63, "timestamp": "03:01:32", "text": "よし、自分で作ってみる。"}, {"type": "subtitle", "time": 10895.19, "timestamp": "03:01:35", "text": "このラナを少し取って"}, {"type": "subtitle", "time": 10902.59, "timestamp": "03:01:42", "text": "クラブ。"}, {"type": "subtitle", "time": 10911.349, "timestamp": "03:01:51", "text": "ああ、そうだ、そうだ、そうだ、そうだ。もの"}, {"type": "subtitle", "time": 10912.87, "timestamp": "03:01:52", "text": "このゲームで起こること。心配しないでください"}, {"type": "subtitle", "time": 10915.79, "timestamp": "03:01:55", "text": "それ。つまり、これはデモ版なんです。"}, {"type": "subtitle", "time": 10919.99, "timestamp": "03:01:59", "text": "はい、開発中です。"}]
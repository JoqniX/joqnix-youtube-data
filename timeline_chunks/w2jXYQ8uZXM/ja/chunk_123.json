[{"type": "subtitle", "time": 7380.39, "timestamp": "02:03:00", "text": "それに、開発者に聞いているのですが"}, {"type": "subtitle", "time": 7385.51, "timestamp": "02:03:05", "text": "ストリーマーボットと開発者に尋ねました"}, {"type": "subtitle", "time": 7388.43, "timestamp": "02:03:08", "text": "ずっと昔、ソーシャルから"}, {"type": "subtitle", "time": 7392.31, "timestamp": "02:03:12", "text": "ストリームソーシャルストリームを統合する"}, {"type": "subtitle", "time": 7395.51, "timestamp": "02:03:15", "text": "ビリーブリーみたいなやつ。私は彼に頼んだ"}, {"type": "subtitle", "time": 7397.83, "timestamp": "02:03:17", "text": "ビリービリー1。彼はウェブ上でそれをやった"}, {"type": "subtitle", "time": 7401.189, "timestamp": "02:03:21", "text": "クローリング方法だが、その方法は"}, {"type": "subtitle", "time": 7403.99, "timestamp": "02:03:23", "text": "もはや正常に機能しないのは"}, {"type": "subtitle", "time": 7407.35, "timestamp": "02:03:27", "text": "現在は制限されています。ログインする必要があります。"}, {"type": "subtitle", "time": 7411.27, "timestamp": "02:03:31", "text": "そして全てがそうであり、メッセージは"}, {"type": "subtitle", "time": 7415.189, "timestamp": "02:03:35", "text": "マスクをしているので、ラプラスを提案しました"}, {"type": "subtitle", "time": 7418.149, "timestamp": "02:03:38", "text": "あれこれと彼らはそれを統合した"}, {"type": "subtitle", "time": 7420.75, "timestamp": "02:03:40", "text": "ウェブソケットのやつですね、これでやっと"}, {"type": "subtitle", "time": 7424.39, "timestamp": "02:03:44", "text": "ソーシャルなどの外部の第三者に尋ねる"}, {"type": "subtitle", "time": 7426.149, "timestamp": "02:03:46", "text": "ストリーム"}, {"type": "subtitle", "time": 7428.83, "timestamp": "02:03:48", "text": "などストリームを中断してラッププラスを統合します"}, {"type": "subtitle", "time": 7432.95, "timestamp": "02:03:52", "text": "あれ。それから私は問題に遭遇しました"}, {"type": "subtitle", "time": 7436.31, "timestamp": "02:03:56", "text": "問題ですが、ビームが心配です"}]
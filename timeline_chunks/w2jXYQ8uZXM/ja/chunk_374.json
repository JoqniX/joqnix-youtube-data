[{"type": "subtitle", "time": 22443.03, "timestamp": "06:14:03", "text": "今。でも、皆さんは私の"}, {"type": "subtitle", "time": 22445.788, "timestamp": "06:14:05", "text": "短縮URL？私は思う"}, {"type": "subtitle", "time": 22449.67, "timestamp": "06:14:09", "text": "えっと、皆さんのほとんどはそうだと思います。"}, {"type": "subtitle", "time": 22452.67, "timestamp": "06:14:12", "text": "うん。うん。うん。皆さんのほとんどは"}, {"type": "subtitle", "time": 22457.03, "timestamp": "06:14:17", "text": "する。統計データは確認できます。わかった。"}, {"type": "subtitle", "time": 22460.75, "timestamp": "06:14:20", "text": "クリック音とかそういうやつ。それで、"}, {"type": "subtitle", "time": 22462.27, "timestamp": "06:14:22", "text": "それで"}, {"type": "subtitle", "time": 22467.39, "timestamp": "06:14:27", "text": "それからジョックスペースワンと"}, {"type": "subtitle", "time": 22470.43, "timestamp": "06:14:30", "text": "それらすべて"}, {"type": "subtitle", "time": 22473.67, "timestamp": "06:14:33", "text": "もの。今では私は"}, {"type": "subtitle", "time": 22476.47, "timestamp": "06:14:36", "text": "すでに"}, {"type": "subtitle", "time": 22478.43, "timestamp": "06:14:38", "text": "えっと、どうやって"}, {"type": "subtitle", "time": 22483.23, "timestamp": "06:14:43", "text": "多くのスポーツ選手が、私はそれをやろうとしている。"}, {"type": "subtitle", "time": 22486.31, "timestamp": "06:14:46", "text": "ジョロ。ああ、そうだね。やったよ。やったよ。おお"}, {"type": "subtitle", "time": 22487.47, "timestamp": "06:14:47", "text": "神。"}, {"type": "subtitle", "time": 22494.27, "timestamp": "06:14:54", "text": "かわいい。"}]
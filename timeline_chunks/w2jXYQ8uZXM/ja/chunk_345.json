[{"type": "subtitle", "time": 20731.27, "timestamp": "05:45:31", "text": "いやあ、すごく楽しかったよ。とても"}, {"type": "subtitle", "time": 20736.03, "timestamp": "05:45:36", "text": "楽しい。待って、なぜ出口で止まっているの？"}, {"type": "subtitle", "time": 20738.628, "timestamp": "05:45:38", "text": "ゲーム？なぜ私は負けているように感じるのだろうか"}, {"type": "subtitle", "time": 20741.35, "timestamp": "05:45:41", "text": "すべて？"}, {"type": "subtitle", "time": 20742.948, "timestamp": "05:45:42", "text": "いいえ、そうはなりません。それはあなたのものでさえありません"}, {"type": "subtitle", "time": 20745.67, "timestamp": "05:45:45", "text": "クソサーバー。それはあなたのものでさえありません"}, {"type": "subtitle", "time": 20748.07, "timestamp": "05:45:48", "text": "ゲーム。つまり、あなたは救われたということです。それは それは"}, {"type": "subtitle", "time": 20751.99, "timestamp": "05:45:51", "text": "覚醒。しかし、私はそれを声に出して失ってしまった。でも私は"}]
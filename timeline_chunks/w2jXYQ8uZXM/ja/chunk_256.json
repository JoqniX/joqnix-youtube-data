[{"type": "subtitle", "time": 15366.51, "timestamp": "04:16:06", "text": "わかった、"}, {"type": "subtitle", "time": 15369.389, "timestamp": "04:16:09", "text": "病気"}, {"type": "subtitle", "time": 15384.149, "timestamp": "04:16:24", "text": "矢印を使っても構いません。彼は死にかけている。"}, {"type": "subtitle", "time": 15387.03, "timestamp": "04:16:27", "text": "彼は死にかけている。彼を助けてあげて。私は見ることができます"}, {"type": "subtitle", "time": 15389.87, "timestamp": "04:16:29", "text": "それ。一番上。の上"}, {"type": "subtitle", "time": 15397.51, "timestamp": "04:16:37", "text": "ああ、これもここにある。"}, {"type": "subtitle", "time": 15400.389, "timestamp": "04:16:40", "text": "ええ、今着いたところです。"}, {"type": "subtitle", "time": 15403.59, "timestamp": "04:16:43", "text": "お前の矢を使えよ、相棒。私たちは"}, {"type": "subtitle", "time": 15405.469, "timestamp": "04:16:45", "text": "彼。私はそうしました"}, {"type": "subtitle", "time": 15408.95, "timestamp": "04:16:48", "text": "それ。やったぞ。さあ行こう。"}, {"type": "subtitle", "time": 15411.11, "timestamp": "04:16:51", "text": "彼のクソみたいな酵母の瞬き。彼は行く、私は"}, {"type": "subtitle", "time": 15412.67, "timestamp": "04:16:52", "text": "やったよ。"}]
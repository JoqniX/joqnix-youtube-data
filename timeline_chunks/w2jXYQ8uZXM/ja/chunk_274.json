[{"type": "subtitle", "time": 16442.31, "timestamp": "04:34:02", "text": "くそ。今すぐ私の荷物を返せ。"}, {"type": "subtitle", "time": 16444.789, "timestamp": "04:34:04", "text": "くそ。ジョー、私の"}, {"type": "subtitle", "time": 16451.67, "timestamp": "04:34:11", "text": "いいえ、でもどこかで"}, {"type": "subtitle", "time": 16453.67, "timestamp": "04:34:13", "text": "これらのひび割れ。"}, {"type": "subtitle", "time": 16455.429, "timestamp": "04:34:15", "text": "お尻の底が痒い"}, {"type": "subtitle", "time": 16457.269, "timestamp": "04:34:17", "text": "亡くなった。"}, {"type": "subtitle", "time": 16467.349, "timestamp": "04:34:27", "text": "ああ、木々に対して批評をすることができるよ。の"}, {"type": "subtitle", "time": 16470.949, "timestamp": "04:34:30", "text": "ポケットが重く感じる。私は"}]
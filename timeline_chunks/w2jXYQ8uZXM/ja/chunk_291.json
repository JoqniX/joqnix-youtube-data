[{"type": "subtitle", "time": 17460.39, "timestamp": "04:51:00", "text": "これのこと？それを"}, {"type": "subtitle", "time": 17462.948, "timestamp": "04:51:02", "text": "ストレージ。ストレージ容量を増やす必要がある"}, {"type": "subtitle", "time": 17464.868, "timestamp": "04:51:04", "text": "実は。"}, {"type": "subtitle", "time": 17467.91, "timestamp": "04:51:07", "text": "いいえ、今すぐ行かなければなりません。"}, {"type": "subtitle", "time": 17469.91, "timestamp": "04:51:09", "text": "私たちはどこへ行けばいいのでしょうか？行く。ところで、"}, {"type": "subtitle", "time": 17471.27, "timestamp": "04:51:11", "text": "犬よ、これでキャラクターを変更できる"}, {"type": "subtitle", "time": 17474.55, "timestamp": "04:51:14", "text": "あなたが望むなら。どうやって？"}]
[{"type": "subtitle", "time": 12483.03, "timestamp": "03:28:03", "text": "ストリーム。それにも時間がかかります。どうぞそうしてください。"}, {"type": "subtitle", "time": 12485.67, "timestamp": "03:28:05", "text": "うん。はい、ぜひそうしてください。それだけです。"}, {"type": "subtitle", "time": 12492.87, "timestamp": "03:28:12", "text": "どこにコードを送りましたか？"}, {"type": "subtitle", "time": 12497.51, "timestamp": "03:28:17", "text": "そこには？物を送ることができません。"}, {"type": "subtitle", "time": 12499.67, "timestamp": "03:28:19", "text": "魚をあげたいのですが、"}, {"type": "subtitle", "time": 12501.389, "timestamp": "03:28:21", "text": "槍は"}, {"type": "subtitle", "time": 12505.19, "timestamp": "03:28:25", "text": "来るよ。それはあまりにも間違っているように聞こえる。"}, {"type": "subtitle", "time": 12507.75, "timestamp": "03:28:27", "text": "Discordの読み込みにものすごく時間がかかっている"}, {"type": "subtitle", "time": 12511.11, "timestamp": "03:28:31", "text": "アニメーション。そして、あなたが送るとき"}, {"type": "subtitle", "time": 12514.59, "timestamp": "03:28:34", "text": "そのアニメーションはメッセージを伝えるものですよね？"}, {"type": "subtitle", "time": 12517.349, "timestamp": "03:28:37", "text": "彼もどもり癖があるみたいだ。それは"}, {"type": "subtitle", "time": 12519.229, "timestamp": "03:28:39", "text": "つまり、そういうことですか？"}, {"type": "subtitle", "time": 12523.389, "timestamp": "03:28:43", "text": "うん。何てことだ。"}, {"type": "subtitle", "time": 12527.429, "timestamp": "03:28:47", "text": "確認する。はい、読み込み中です。"}, {"type": "subtitle", "time": 12529.429, "timestamp": "03:28:49", "text": "さあ、行こうぜ。さあ、行こう。良い"}, {"type": "subtitle", "time": 12537.349, "timestamp": "03:28:57", "text": "えっと"}, {"type": "subtitle", "time": 12539.429, "timestamp": "03:28:59", "text": "このゲームは、ただあなたが"}]
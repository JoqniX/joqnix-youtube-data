[{"type": "subtitle", "time": 20282.15, "timestamp": "05:38:02", "text": "文章。いやあ、すごく楽しかったよ。"}, {"type": "subtitle", "time": 20284.628, "timestamp": "05:38:04", "text": "来てくれてありがとう。ご招待いただきありがとうございます"}, {"type": "subtitle", "time": 20287.99, "timestamp": "05:38:07", "text": "自分。許可してくれてありがとう"}, {"type": "subtitle", "time": 20290.628, "timestamp": "05:38:10", "text": "ご参加いただきありがとうございます。待って、このゲーム"}, {"type": "subtitle", "time": 20292.83, "timestamp": "05:38:12", "text": "とても楽しいです。"}, {"type": "subtitle", "time": 20295.27, "timestamp": "05:38:15", "text": "うん。待って、保存する必要はありません"}, {"type": "subtitle", "time": 20297.91, "timestamp": "05:38:17", "text": "再び積み込みます。ええ。うん。もしあなたがただ"}, {"type": "subtitle", "time": 20301.43, "timestamp": "05:38:21", "text": "去れば、救われるだろう。ああ、神様。こんにちは。出口"}, {"type": "subtitle", "time": 20310.708, "timestamp": "05:38:30", "text": "行き詰まったゲームだ。何てことだ。"}, {"type": "subtitle", "time": 20313.19, "timestamp": "05:38:33", "text": "何てことだ。どこですか？行かないで。"}]
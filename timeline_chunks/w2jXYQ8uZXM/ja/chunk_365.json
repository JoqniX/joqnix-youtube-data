[{"type": "subtitle", "time": 21904.91, "timestamp": "06:05:04", "text": "[音楽]"}, {"type": "subtitle", "time": 21908.91, "timestamp": "06:05:08", "text": "右？ああ、私はいつも"}, {"type": "subtitle", "time": 21911.708, "timestamp": "06:05:11", "text": "これ。あなたは何を"}, {"type": "subtitle", "time": 21917.19, "timestamp": "06:05:17", "text": "平均？ありがとう。それは褒め言葉だったのですか？"}, {"type": "subtitle", "time": 21920.548, "timestamp": "06:05:20", "text": "こんにちは、ソフトさん。元気でいることを願っています"}, {"type": "subtitle", "time": 21928.15, "timestamp": "06:05:28", "text": "こんにちは。そう、私はただ自分がやりたいことをするだけです"}, {"type": "subtitle", "time": 21931.39, "timestamp": "06:05:31", "text": "短いザツ。ランダムについて話す"}, {"type": "subtitle", "time": 21934.948, "timestamp": "06:05:34", "text": "もの。最近になって気づいたのですが、私は"}, {"type": "subtitle", "time": 21939.628, "timestamp": "06:05:39", "text": "ザトゥだけをやっている。ザツザツ"}, {"type": "subtitle", "time": 21943.19, "timestamp": "06:05:43", "text": "そこには。私はザツをたくさんやってきたんじゃないですか？"}, {"type": "subtitle", "time": 21945.11, "timestamp": "06:05:45", "text": "最近？"}, {"type": "subtitle", "time": 21946.35, "timestamp": "06:05:46", "text": "私は思う"}, {"type": "subtitle", "time": 21959.27, "timestamp": "06:05:59", "text": "もちろん。わかった。待って。オーバーレイを追加できますか？"}]
[{"type": "subtitle", "time": 12780.15, "timestamp": "03:33:00", "text": "彼に会ってください。彼はなぜあそこにいるのですか？彼は"}, {"type": "subtitle", "time": 12783.11, "timestamp": "03:33:03", "text": "チュートリアルエリア。"}, {"type": "subtitle", "time": 12784.84, "timestamp": "03:33:04", "text": "ああ、"}, {"type": "subtitle", "time": 12787.309, "timestamp": "03:33:07", "text": "[音楽]"}, {"type": "subtitle", "time": 12789.59, "timestamp": "03:33:09", "text": "ベリー。うん、キノコをいくつか取ってきてね"}, {"type": "subtitle", "time": 12791.59, "timestamp": "03:33:11", "text": "ところで、あなたがこちらに来る時はね。私たちは"}, {"type": "subtitle", "time": 12809.99, "timestamp": "03:33:29", "text": "暴徒。彼を歓迎しましょう。上に立つ"}, {"type": "subtitle", "time": 12810.91, "timestamp": "03:33:30", "text": "前面"}, {"type": "subtitle", "time": 12815.71, "timestamp": "03:33:35", "text": "出口へ。おお、"}, {"type": "subtitle", "time": 12824.15, "timestamp": "03:33:44", "text": "キノコ。あなたは正しい方向へ進んでいます。"}, {"type": "subtitle", "time": 12826.469, "timestamp": "03:33:46", "text": "あなたは正しい方向へ進んでいます。あなたが見えてます。"}, {"type": "subtitle", "time": 12830.55, "timestamp": "03:33:50", "text": "ええ、あなたの名前が見えますね。"}, {"type": "subtitle", "time": 12832.229, "timestamp": "03:33:52", "text": "彼を歓迎しましょう。うん、君はもうすぐ"}, {"type": "subtitle", "time": 12833.75, "timestamp": "03:33:53", "text": "そこには。"}, {"type": "subtitle", "time": 12836.79, "timestamp": "03:33:56", "text": "何てことだ。こんにちは。オウムを飼っていますか？"}]
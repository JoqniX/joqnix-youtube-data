[{"type": "subtitle", "time": 11282.07, "timestamp": "03:08:02", "text": "三つ。どこへ行くのか覚えていない"}, {"type": "subtitle", "time": 11284.71, "timestamp": "03:08:04", "text": "覚えていないが、わからない。私"}, {"type": "subtitle", "time": 11293.03, "timestamp": "03:08:13", "text": "そのうち慣れるだろう。ああ、わかりました。私は見つけた"}, {"type": "subtitle", "time": 11294.87, "timestamp": "03:08:14", "text": "それ。"}, {"type": "subtitle", "time": 11299.19, "timestamp": "03:08:19", "text": "了解しました。うん、"}, {"type": "subtitle", "time": 11302.349, "timestamp": "03:08:22", "text": "私もレベルアップしました。何が見えるか"}, {"type": "subtitle", "time": 11305.19, "timestamp": "03:08:25", "text": "より速くレベルアップする。はい、私は"}, {"type": "subtitle", "time": 11306.99, "timestamp": "03:08:26", "text": "作る予定"}, {"type": "subtitle", "time": 11311.389, "timestamp": "03:08:31", "text": "槍と、えっと、私は思う"}, {"type": "subtitle", "time": 11326.429, "timestamp": "03:08:46", "text": "よし、2つ減らしたぞ。私はたくさんの"}, {"type": "subtitle", "time": 11335.83, "timestamp": "03:08:55", "text": "包帯は作っているんですよ、とあなたは言う。おお、"}]
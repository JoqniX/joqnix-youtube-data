[{"type": "subtitle", "time": 12002.469, "timestamp": "03:20:02", "text": "ご自身でどうぞ。よし。"}, {"type": "subtitle", "time": 12005.59, "timestamp": "03:20:05", "text": "ありがとう。さよなら。ありがとう。わかった。私たちは"}, {"type": "subtitle", "time": 12007.95, "timestamp": "03:20:07", "text": "いくつか集めるために"}, {"type": "subtitle", "time": 12011.67, "timestamp": "03:20:11", "text": "そう、ロープみたいなやつとか"}, {"type": "subtitle", "time": 12013.429, "timestamp": "03:20:13", "text": "ええ、その通りです。"}, {"type": "subtitle", "time": 12016.99, "timestamp": "03:20:16", "text": "草のことね。ああ、"}, {"type": "subtitle", "time": 12019.269, "timestamp": "03:20:19", "text": "ファブリック。それは何と呼ばれていますか？植物繊維。"}, {"type": "subtitle", "time": 12021.349, "timestamp": "03:20:21", "text": "はい、すみません。なんてこった。私はたくさん好きです"}, {"type": "subtitle", "time": 12024.71, "timestamp": "03:20:24", "text": "こちらには植物繊維があります。じゃあ、"}, {"type": "subtitle", "time": 12027.79, "timestamp": "03:20:27", "text": "植物繊維が99個以上あるので、私にも手に入れてください。"}, {"type": "subtitle", "time": 12031.75, "timestamp": "03:20:31", "text": "このかごの上で。何を狙ってるの？"}, {"type": "subtitle", "time": 12057.11, "timestamp": "03:20:57", "text": "やったー。くそ、君の"}]
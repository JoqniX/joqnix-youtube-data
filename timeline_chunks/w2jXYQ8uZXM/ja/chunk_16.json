[{"type": "subtitle", "time": 962.11, "timestamp": "00:16:02", "text": "[音楽]"}, {"type": "subtitle", "time": 966.59, "timestamp": "00:16:06", "text": "本当に最悪だ。本当に"}, {"type": "subtitle", "time": 973.749, "timestamp": "00:16:13", "text": "うん。少し時間をください。アップロードする必要があります"}, {"type": "subtitle", "time": 976.59, "timestamp": "00:16:16", "text": "この動画を私のプライベートに"}, {"type": "subtitle", "time": 984.389, "timestamp": "00:16:24", "text": "そしてこれをプライベートにアップロードしなければならない"}, {"type": "subtitle", "time": 1008.069, "timestamp": "00:16:48", "text": "分。私が理解できないのは"}, {"type": "subtitle", "time": 1013.629, "timestamp": "00:16:53", "text": "私のCPUは急上昇している"}, {"type": "subtitle", "time": 1017.069, "timestamp": "00:16:57", "text": "先にあるのは"}]
[{"type": "subtitle", "time": 14822.95, "timestamp": "04:07:02", "text": "ニース。基本的なネイルをしました。治癒中"}, {"type": "subtitle", "time": 14826.309, "timestamp": "04:07:06", "text": "ポーション、石切り、光る石。ニース。"}, {"type": "subtitle", "time": 14828.229, "timestamp": "04:07:08", "text": "ああ、それはいいですね。ええ、戻ってきます"}, {"type": "subtitle", "time": 14831.99, "timestamp": "04:07:11", "text": "皆さんへ。私は死んでいない。"}, {"type": "subtitle", "time": 14835.51, "timestamp": "04:07:15", "text": "私は水の中にいます。私は水中にいる。"}, {"type": "subtitle", "time": 14838.07, "timestamp": "04:07:18", "text": "彼は水中にいる。"}, {"type": "subtitle", "time": 14841.269, "timestamp": "04:07:21", "text": "ええ、私は水中にいます。待って。だから、"}, {"type": "subtitle", "time": 14844.229, "timestamp": "04:07:24", "text": "あなたは水中探検をしますか？"}, {"type": "subtitle", "time": 14846.15, "timestamp": "04:07:26", "text": "うん、お城とかそういうのがあるよ。"}, {"type": "subtitle", "time": 14847.99, "timestamp": "04:07:27", "text": "でもそれは心の奥底にあるようなものだ。この"}, {"type": "subtitle", "time": 14855.189, "timestamp": "04:07:35", "text": "はい。うん。ところで、一体どこなんだ"}, {"type": "subtitle", "time": 14858.67, "timestamp": "04:07:38", "text": "あなたは？私は今のところ"}, {"type": "subtitle", "time": 14863.75, "timestamp": "04:07:43", "text": "離れて。私はほとんど手を伸ばした。"}, {"type": "subtitle", "time": 14866.87, "timestamp": "04:07:46", "text": "なぜ今、これが復活しないのでしょうか？よお、今"}, {"type": "subtitle", "time": 14869.269, "timestamp": "04:07:49", "text": "あなたは私のところに来る。"}, {"type": "subtitle", "time": 14873.99, "timestamp": "04:07:53", "text": "木材が欲しい。木材が欲しい。"}]
[{"type": "subtitle", "time": 14160.229, "timestamp": "03:56:00", "text": "棒を作る？ああ、なんてことだ。私がやります。"}, {"type": "subtitle", "time": 14162.15, "timestamp": "03:56:02", "text": "そこへ飛び降りてもいいですよ。私たちはそこへ飛び込む。あなた"}, {"type": "subtitle", "time": 14172.229, "timestamp": "03:56:12", "text": "実は階段を作ろうと思っています。"}, {"type": "subtitle", "time": 14174.51, "timestamp": "03:56:14", "text": "はい、どうぞ。"}, {"type": "subtitle", "time": 14179.269, "timestamp": "03:56:19", "text": "日付がないので、日付の木を選べません。"}, {"type": "subtitle", "time": 14181.99, "timestamp": "03:56:21", "text": "というわけで、私たちはここで薪を割っているところです。"}, {"type": "subtitle", "time": 14184.63, "timestamp": "03:56:24", "text": "わかった。いいえ、私は卵をつかみます。分かりますか"}, {"type": "subtitle", "time": 14186.95, "timestamp": "03:56:26", "text": "目の前の卵？"}, {"type": "subtitle", "time": 14189.229, "timestamp": "03:56:29", "text": "これ。おや、これは何でしょう？しないで"}, {"type": "subtitle", "time": 14193.349, "timestamp": "03:56:33", "text": "秋。それを掴みます。一度私がああ、それは"}, {"type": "subtitle", "time": 14195.75, "timestamp": "03:56:35", "text": "アップグレードしたい。それはまるで"}, {"type": "subtitle", "time": 14197.309, "timestamp": "03:56:37", "text": "アップグレードする"}, {"type": "subtitle", "time": 14202.71, "timestamp": "03:56:42", "text": "アンカービーコンをアップグレードします。"}, {"type": "subtitle", "time": 14210.71, "timestamp": "03:56:50", "text": "卵を置きます。それから私たちは"}, {"type": "subtitle", "time": 14212.71, "timestamp": "03:56:52", "text": "手の上に。目の前に手が見える"}, {"type": "subtitle", "time": 14217.429, "timestamp": "03:56:57", "text": "あなたですか？デカい手。手はどこに？"}]
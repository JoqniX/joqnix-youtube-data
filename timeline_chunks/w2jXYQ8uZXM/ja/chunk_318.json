[{"type": "subtitle", "time": 19089.43, "timestamp": "05:18:09", "text": "私も乗ろうとした。私はただ彼"}, {"type": "subtitle", "time": 19092.708, "timestamp": "05:18:12", "text": "ここに来るべきだった。何？いいえ、違います。"}, {"type": "subtitle", "time": 19096.31, "timestamp": "05:18:16", "text": "そこで泳ぎに行くつもりだ。うん。"}, {"type": "subtitle", "time": 19108.788, "timestamp": "05:18:28", "text": "なぜ登山は難しいのか？"}, {"type": "subtitle", "time": 19109.868, "timestamp": "05:18:29", "text": "ああ、"}, {"type": "subtitle", "time": 19121.31, "timestamp": "05:18:41", "text": "よし、あと1つ下へ。彼の"}, {"type": "subtitle", "time": 19124.47, "timestamp": "05:18:44", "text": "アイテム。待って、長老の霊はどこにいるの？"}, {"type": "subtitle", "time": 19127.35, "timestamp": "05:18:47", "text": "破片？私にはそうは思えません。"}, {"type": "subtitle", "time": 19128.628, "timestamp": "05:18:48", "text": "エルダースピリットシャードは"}, {"type": "subtitle", "time": 19131.43, "timestamp": "05:18:51", "text": "それ。でも、1つ手に入れたよ。 1と書いてあります。なんてこった。"}, {"type": "subtitle", "time": 19132.948, "timestamp": "05:18:52", "text": "持っています。持っています。持っています。あなた"}, {"type": "subtitle", "time": 19135.59, "timestamp": "05:18:55", "text": "私の体には使命が宿っている。それは私の"}, {"type": "subtitle", "time": 19137.27, "timestamp": "05:18:57", "text": "体。"}]
[{"type": "subtitle", "time": 11462.67, "timestamp": "03:11:02", "text": "えっと、もっとこうしたかったんです"}, {"type": "subtitle", "time": 11466.389, "timestamp": "03:11:06", "text": "より良い、そして以前の"}, {"type": "subtitle", "time": 11470.389, "timestamp": "03:11:10", "text": "1サイクルのように"}, {"type": "subtitle", "time": 11473.269, "timestamp": "03:11:13", "text": "何かが起こって、彼らは戻ってきました"}, {"type": "subtitle", "time": 11475.83, "timestamp": "03:11:15", "text": "物語の始まりへ。だから私はただ"}, {"type": "subtitle", "time": 11478.07, "timestamp": "03:11:18", "text": "物語を再開した。"}, {"type": "subtitle", "time": 11482.389, "timestamp": "03:11:22", "text": "物語を最初からやり直す。うん。ええ、できますよ"}, {"type": "subtitle", "time": 11486.63, "timestamp": "03:11:26", "text": "あなたにはまだ時間があります。とても効果的です。"}, {"type": "subtitle", "time": 11488.79, "timestamp": "03:11:28", "text": "ご興味があれば、お送りできます"}, {"type": "subtitle", "time": 11492.55, "timestamp": "03:11:32", "text": "また後で。ええ、ぜひお願いします。実は、"}, {"type": "subtitle", "time": 11494.469, "timestamp": "03:11:34", "text": "よし。"}, {"type": "subtitle", "time": 11497.269, "timestamp": "03:11:37", "text": "あなたは私にそう言ったじゃないですか。どうすればいいの？私にさせて"}, {"type": "subtitle", "time": 11500.389, "timestamp": "03:11:40", "text": "魚を捕まえよう。私は戻ってきます。私は"}, {"type": "subtitle", "time": 11503.99, "timestamp": "03:11:43", "text": "旅に出る。 M. 誰？うん。何？"}, {"type": "subtitle", "time": 11508.03, "timestamp": "03:11:48", "text": "あれは何だ？洞窟を見つけた。"}, {"type": "subtitle", "time": 11510.07, "timestamp": "03:11:50", "text": "よし、攻撃されないように。そこには"}, {"type": "subtitle", "time": 11518.87, "timestamp": "03:11:58", "text": "ここにはたくさんの物があり、"}]
[{"type": "subtitle", "time": 17944.948, "timestamp": "04:59:04", "text": "もの。もう少し繊維質を。"}, {"type": "subtitle", "time": 17947.59, "timestamp": "04:59:07", "text": "それらを手に入れるために。"}, {"type": "subtitle", "time": 17951.19, "timestamp": "04:59:11", "text": "はい、収集します"}, {"type": "subtitle", "time": 17953.83, "timestamp": "04:59:13", "text": "みんなを落ち込ませるためですよね？だから私は"}, {"type": "subtitle", "time": 17957.43, "timestamp": "04:59:17", "text": "後ろから母に呼ばれた。"}]
[{"type": "subtitle", "time": 13621.87, "timestamp": "03:47:01", "text": "くそっ"}, {"type": "subtitle", "time": 13624.63, "timestamp": "03:47:04", "text": "男。さあ、そろそろ行きましょう。私たちは必要としません"}, {"type": "subtitle", "time": 13626.99, "timestamp": "03:47:06", "text": "もうここにいたくない。"}, {"type": "subtitle", "time": 13630.469, "timestamp": "03:47:10", "text": "包帯。わかった。ああ、そうだね。くそ。私"}, {"type": "subtitle", "time": 13633.269, "timestamp": "03:47:13", "text": "忘れた。"}, {"type": "subtitle", "time": 13636.63, "timestamp": "03:47:16", "text": "私は食事を作らなければならない。"}, {"type": "subtitle", "time": 13644.59, "timestamp": "03:47:24", "text": "食料、包帯、そして"}, {"type": "subtitle", "time": 13653.429, "timestamp": "03:47:33", "text": "シールド。あの、樹脂は置いてありますか？私"}, {"type": "subtitle", "time": 13655.03, "timestamp": "03:47:35", "text": "そう思うよ。"}, {"type": "subtitle", "time": 13658.95, "timestamp": "03:47:38", "text": "しまった、アラス。おい、なんで水の中にいるんだよ？"}, {"type": "subtitle", "time": 13661.83, "timestamp": "03:47:41", "text": "私はここにいます。あなたは船を作っているのですか？"}, {"type": "subtitle", "time": 13664.469, "timestamp": "03:47:44", "text": "おお、"}, {"type": "subtitle", "time": 13673.59, "timestamp": "03:47:53", "text": "「まだ船は必要ない」と私は言いました。"}, {"type": "subtitle", "time": 13676.75, "timestamp": "03:47:56", "text": "けれど。まず最初に"}]
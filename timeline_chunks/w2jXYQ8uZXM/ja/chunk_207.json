[{"type": "subtitle", "time": 12422.07, "timestamp": "03:27:02", "text": "あなたは何をしていますか？私は戻らなければならなかった"}, {"type": "subtitle", "time": 12425.269, "timestamp": "03:27:05", "text": "基地も。ああ、何を殺しているんだ？"}, {"type": "subtitle", "time": 12427.59, "timestamp": "03:27:07", "text": "はい、戻ってきました。いや、いや、わかったよ。私は手に入れた"}, {"type": "subtitle", "time": 12429.09, "timestamp": "03:27:09", "text": "それ。"}, {"type": "subtitle", "time": 12431.91, "timestamp": "03:27:11", "text": "[音楽]"}, {"type": "subtitle", "time": 12439.75, "timestamp": "03:27:19", "text": "何もかもが遅い。人生はブーじゃない。"}, {"type": "subtitle", "time": 12443.269, "timestamp": "03:27:23", "text": "私の声を変えさせてください"}, {"type": "subtitle", "time": 12446.95, "timestamp": "03:27:26", "text": "遅れている。心配しています。いいえ、そうではありません。"}, {"type": "subtitle", "time": 12450.15, "timestamp": "03:27:30", "text": "なぜあなたの配信は続いているのですか？いいえ。いいえ。同じです。"}, {"type": "subtitle", "time": 12453.95, "timestamp": "03:27:33", "text": "配信とか色々。えっと、これは"}, {"type": "subtitle", "time": 12457.99, "timestamp": "03:27:37", "text": "同じ。わかった。えっと、B3ローにします"}, {"type": "subtitle", "time": 12462.79, "timestamp": "03:27:42", "text": "品質。いいえ、中程度の品質です。"}, {"type": "subtitle", "time": 12464.309, "timestamp": "03:27:44", "text": "中程度または低程度。あなたに合ったものなら何でも、"}, {"type": "subtitle", "time": 12466.71, "timestamp": "03:27:46", "text": "右？何でも。私は下げなければならない"}, {"type": "subtitle", "time": 12469.91, "timestamp": "03:27:49", "text": "エンコードに関するもの。あなたが知っている、"}, {"type": "subtitle", "time": 12471.91, "timestamp": "03:27:51", "text": "えーと、"}, {"type": "subtitle", "time": 12473.71, "timestamp": "03:27:53", "text": "参加する"}, {"type": "subtitle", "time": 12477.83, "timestamp": "03:27:57", "text": "ゲーム。コードはどこにあるの？まず、ニ、"}, {"type": "subtitle", "time": 12479.229, "timestamp": "03:27:59", "text": "見るのをやめて"}]
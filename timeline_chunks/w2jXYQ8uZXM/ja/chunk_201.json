[{"type": "subtitle", "time": 12066.79, "timestamp": "03:21:06", "text": "グラフィック設定が低いからだと思いますが、"}, {"type": "subtitle", "time": 12069.429, "timestamp": "03:21:09", "text": "それが理由です。まあ、そうですね。ああ、戻ってきて。"}, {"type": "subtitle", "time": 12071.19, "timestamp": "03:21:11", "text": "それでもかなり良さそうだ。"}, {"type": "subtitle", "time": 12074.309, "timestamp": "03:21:14", "text": "ああ、彼が戻ってきた。ええ、戻ってきました。おお"}, {"type": "subtitle", "time": 12077.99, "timestamp": "03:21:17", "text": "我が神よ。これが私が立ち上げるものです"}, {"type": "subtitle", "time": 12079.91, "timestamp": "03:21:19", "text": "ゲーム。"}, {"type": "subtitle", "time": 12081.99, "timestamp": "03:21:21", "text": "わかった。"}, {"type": "subtitle", "time": 12085.59, "timestamp": "03:21:25", "text": "ああ、私のPCがラグっています、"}, {"type": "subtitle", "time": 12092.15, "timestamp": "03:21:32", "text": "ああ、重要な部品ですね。はい、再起動します"}, {"type": "subtitle", "time": 12096.79, "timestamp": "03:21:36", "text": "チーム。これを受け取って。そうそう。少し分けてあげて。"}, {"type": "subtitle", "time": 12099.19, "timestamp": "03:21:39", "text": "なんだかすごく裸になったような気分なんだよ。ありがとう"}, {"type": "subtitle", "time": 12102.15, "timestamp": "03:21:42", "text": "フライパンのためだよ。そして、ここ。"}, {"type": "subtitle", "time": 12105.59, "timestamp": "03:21:45", "text": "ありがとう。ああ、そうだね。私の胸を隠して"}, {"type": "subtitle", "time": 12114.389, "timestamp": "03:21:54", "text": "今はジョーを待つことにしましょう。殺す"}, {"type": "subtitle", "time": 12117.67, "timestamp": "03:21:57", "text": "これらのカニのいくつかは"}]
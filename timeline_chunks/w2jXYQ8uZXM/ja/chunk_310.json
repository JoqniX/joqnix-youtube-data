[{"type": "subtitle", "time": 18601.51, "timestamp": "05:10:01", "text": "彼は上下に動いている。知っている。知っている。"}, {"type": "subtitle", "time": 18604.23, "timestamp": "05:10:04", "text": "私はしようとしています。"}, {"type": "subtitle", "time": 18605.75, "timestamp": "05:10:05", "text": "彼を待って彼を助けたいですか、それとも"}, {"type": "subtitle", "time": 18608.23, "timestamp": "05:10:08", "text": "彼を放っておくべきでしょうか？私たちならできる"}, {"type": "subtitle", "time": 18609.99, "timestamp": "05:10:09", "text": "一人で。まあ、彼を捕まえよう。おお、"}, {"type": "subtitle", "time": 18612.07, "timestamp": "05:10:12", "text": "うん。うん。行く。大丈夫です。大丈夫です。私"}, {"type": "subtitle", "time": 18616.868, "timestamp": "05:10:16", "text": "ここから出なきゃいけないみたいだ。ええ、そうですね。"}, {"type": "subtitle", "time": 18620.55, "timestamp": "05:10:20", "text": "私たちの活動に参加したり、"}, {"type": "subtitle", "time": 18622.47, "timestamp": "05:10:22", "text": "大きな被害を受けた。したいですか"}, {"type": "subtitle", "time": 18623.83, "timestamp": "05:10:23", "text": "船に来たいですか、それとも"}, {"type": "subtitle", "time": 18625.67, "timestamp": "05:10:25", "text": "自分の船を奪いに行くのか？私は船を所有している。"}, {"type": "subtitle", "time": 18631.47, "timestamp": "05:10:31", "text": "手綱"}, {"type": "subtitle", "time": 18634.868, "timestamp": "05:10:34", "text": "私が逃げ出せる場所。"}, {"type": "subtitle", "time": 18636.708, "timestamp": "05:10:36", "text": "ああ、ピラニアがいる。"}, {"type": "subtitle", "time": 18643.27, "timestamp": "05:10:43", "text": "それはサメだ。"}, {"type": "subtitle", "time": 18646.15, "timestamp": "05:10:46", "text": "そう、サメだ。これは私たちの後ろにある宝箱です。"}, {"type": "subtitle", "time": 18658.948, "timestamp": "05:10:58", "text": "ああ、ボスはピラニア出身だ。わかった、"}]
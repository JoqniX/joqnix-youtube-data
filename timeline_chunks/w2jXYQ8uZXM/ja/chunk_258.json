[{"type": "subtitle", "time": 15480.469, "timestamp": "04:18:00", "text": "えーっと、湖とかそういう感じ？うん、"}, {"type": "subtitle", "time": 15483.51, "timestamp": "04:18:03", "text": "どう言うんだっけ、行くところを選んでください"}, {"type": "subtitle", "time": 15486.389, "timestamp": "04:18:06", "text": "親和性。ただ、"}, {"type": "subtitle", "time": 15492.149, "timestamp": "04:18:12", "text": "リフレッシュして水に入りましょう。"}, {"type": "subtitle", "time": 15499.87, "timestamp": "04:18:19", "text": "今すぐ水に入ってください。終わりました"}, {"type": "subtitle", "time": 15503.189, "timestamp": "04:18:23", "text": "そこには。水の中へ、さあ、さあ、水の中へ。これは"}, {"type": "subtitle", "time": 15518.149, "timestamp": "04:18:38", "text": "あなたは再生していますか？"}, {"type": "subtitle", "time": 15520.229, "timestamp": "04:18:40", "text": "はい。"}, {"type": "subtitle", "time": 15523.59, "timestamp": "04:18:43", "text": "私は今、人魚です。"}, {"type": "subtitle", "time": 15526.63, "timestamp": "04:18:46", "text": "この男、本当にひどい。"}, {"type": "subtitle", "time": 15530.71, "timestamp": "04:18:50", "text": "新しいものを手に入れた 私は新しいものを手に入れた 私はレベルにいる"}]
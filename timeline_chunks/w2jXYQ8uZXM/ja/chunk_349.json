[{"type": "subtitle", "time": 20947.03, "timestamp": "05:49:07", "text": "ところで、もう行くの？うん、そうだと思う。"}, {"type": "subtitle", "time": 20949.91, "timestamp": "05:49:09", "text": "それで。"}, {"type": "subtitle", "time": 20952.868, "timestamp": "05:49:12", "text": "何か。わかりました。あなたもそうなら。"}, {"type": "subtitle", "time": 20955.03, "timestamp": "05:49:15", "text": "私もです。わかりました。またね、みんな"}, {"type": "subtitle", "time": 20957.83, "timestamp": "05:49:17", "text": "後で。また次回お会いしましょう。バイバイ。さよなら。"}, {"type": "subtitle", "time": 20966.59, "timestamp": "05:49:26", "text": "ああ、"}, {"type": "subtitle", "time": 20974.15, "timestamp": "05:49:34", "text": "楽しい。ええ、そうですね。今すぐ行け。あなたたちは親切です"}, {"type": "subtitle", "time": 20975.948, "timestamp": "05:49:35", "text": "の"}, {"type": "subtitle", "time": 20992.19, "timestamp": "05:49:52", "text": "君たちが戻ってくるのを待たなければならない"}]
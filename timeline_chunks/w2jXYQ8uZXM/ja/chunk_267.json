[{"type": "subtitle", "time": 16025.87, "timestamp": "04:27:05", "text": "[音楽]"}, {"type": "subtitle", "time": 16031.469, "timestamp": "04:27:11", "text": "また。ああ、わかった。ラダー。どこにあるの"}, {"type": "subtitle", "time": 16039.229, "timestamp": "04:27:19", "text": "あった。連絡が入りました"}, {"type": "subtitle", "time": 16046.229, "timestamp": "04:27:26", "text": "ファンシー。うん。ちなみに、私はまだフォローしています"}, {"type": "subtitle", "time": 16051.349, "timestamp": "04:27:31", "text": "ジョー。一瞬、死ぬかと思った。"}, {"type": "subtitle", "time": 16054.469, "timestamp": "04:27:34", "text": "いいえ。暴徒と戦っています。"}, {"type": "subtitle", "time": 16057.75, "timestamp": "04:27:37", "text": "暴徒と戦っている。確かに。"}, {"type": "subtitle", "time": 16068.07, "timestamp": "04:27:48", "text": "つまらない。これは手ですか？いいえ。そうです。は"}, {"type": "subtitle", "time": 16069.75, "timestamp": "04:27:49", "text": "あなたは手の中にいますか？おそらくあなたは"}, {"type": "subtitle", "time": 16075.67, "timestamp": "04:27:55", "text": "ああ、あなたはそうじゃない。ああ、でも私たちは近い"}]
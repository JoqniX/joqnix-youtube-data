[{"type": "subtitle", "time": 18720.15, "timestamp": "05:12:00", "text": "君たち、最高だよ。"}, {"type": "subtitle", "time": 18721.628, "timestamp": "05:12:01", "text": "出て行く"}, {"type": "subtitle", "time": 18740.47, "timestamp": "05:12:20", "text": "私はなんとかサメをやり過ごしている。"}, {"type": "subtitle", "time": 18743.83, "timestamp": "05:12:23", "text": "この燃料車のやつは何？"}, {"type": "subtitle", "time": 18744.868, "timestamp": "05:12:24", "text": "触らないでください。触らないでください。しないで"}, {"type": "subtitle", "time": 18745.91, "timestamp": "05:12:25", "text": "それに触れてみて。爆発するだろう。しないで"}, {"type": "subtitle", "time": 18753.27, "timestamp": "05:12:33", "text": "いいえ。"}, {"type": "subtitle", "time": 18759.67, "timestamp": "05:12:39", "text": "くそ。文字通りびっくりしたよ"}, {"type": "subtitle", "time": 18761.91, "timestamp": "05:12:41", "text": "サメによって。"}, {"type": "subtitle", "time": 18763.59, "timestamp": "05:12:43", "text": "ああ、あそこにサメがいる。"}, {"type": "subtitle", "time": 18765.628, "timestamp": "05:12:45", "text": "ママは"}, {"type": "subtitle", "time": 18772.948, "timestamp": "05:12:52", "text": "入り口が見える。君たちはどこから来たの？"}, {"type": "subtitle", "time": 18775.99, "timestamp": "05:12:55", "text": "底辺？いや、違うよ。もうすぐ"}, {"type": "subtitle", "time": 18779.43, "timestamp": "05:12:59", "text": "沖合。私はその場所に入ります。ああ、"}]
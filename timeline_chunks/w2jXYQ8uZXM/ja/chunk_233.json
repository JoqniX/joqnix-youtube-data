[{"type": "subtitle", "time": 13982.91, "timestamp": "03:53:02", "text": "また落ちたの？えっと、それを下ろしてください。"}, {"type": "subtitle", "time": 13986.229, "timestamp": "03:53:06", "text": "うん。私はただどこからでも押したいだけです"}, {"type": "subtitle", "time": 13988.07, "timestamp": "03:53:08", "text": "あなたの在庫。"}, {"type": "subtitle", "time": 13990.07, "timestamp": "03:53:10", "text": "鶏の殻を1ついただけますか？"}, {"type": "subtitle", "time": 13993.75, "timestamp": "03:53:13", "text": "もしあなたが私を持っているなら、私はあなたに2つあげます。ええ、私は"}, {"type": "subtitle", "time": 13997.11, "timestamp": "03:53:17", "text": "シールド用にあと1つ必要だ。私たちは"}, {"type": "subtitle", "time": 13998.429, "timestamp": "03:53:18", "text": "何かありますか"}, {"type": "subtitle", "time": 14000.63, "timestamp": "03:53:20", "text": "バスケット？バスケットの種類によります。あなたはできる"}, {"type": "subtitle", "time": 14003.309, "timestamp": "03:53:23", "text": "それを受け取ってください。私たちはそうしなかった"}, {"type": "subtitle", "time": 14005.71, "timestamp": "03:53:25", "text": "平"}, {"type": "subtitle", "time": 14013.309, "timestamp": "03:53:33", "text": "おお。すごく変な感じだけど、"}, {"type": "subtitle", "time": 14015.67, "timestamp": "03:53:35", "text": "わかった。右。"}, {"type": "subtitle", "time": 14020.55, "timestamp": "03:53:40", "text": "槍は君が持っている。私は槍を手に入れた。"}, {"type": "subtitle", "time": 14025.03, "timestamp": "03:53:45", "text": "私は物を入れる"}, {"type": "subtitle", "time": 14028.03, "timestamp": "03:53:48", "text": "バスケット。"}, {"type": "subtitle", "time": 14032.07, "timestamp": "03:53:52", "text": "うん。いいえ、道具は必要ありません。また、"}, {"type": "subtitle", "time": 14033.51, "timestamp": "03:53:53", "text": "木材を用意しました。"}, {"type": "subtitle", "time": 14034.75, "timestamp": "03:53:54", "text": "建てる"}, {"type": "subtitle", "time": 14037.99, "timestamp": "03:53:57", "text": "特定の場所へ行くために必要なもの。行く。"}, {"type": "subtitle", "time": 14039.91, "timestamp": "03:53:59", "text": "待って、フォートナイト関連のことをしないといけないよ。おお"}]
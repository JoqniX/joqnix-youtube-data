[{"type": "subtitle", "time": 3726.109, "timestamp": "01:02:06", "text": "えっと、つまり"}, {"type": "subtitle", "time": 3729.91, "timestamp": "01:02:09", "text": "えーと、それは、TikTokのように信じられるという意味です"}, {"type": "subtitle", "time": 3731.75, "timestamp": "01:02:11", "text": "いつか規則性や"}, {"type": "subtitle", "time": 3733.829, "timestamp": "01:02:13", "text": "政治的制裁、特に"}, {"type": "subtitle", "time": 3735.75, "timestamp": "01:02:15", "text": "米国のような国々は中国"}, {"type": "subtitle", "time": 3737.829, "timestamp": "01:02:17", "text": "起源または所有権。もしそうなったら"}, {"type": "subtitle", "time": 3739.589, "timestamp": "01:02:19", "text": "ビームリーのようなプラットフォームは"}, {"type": "subtitle", "time": 3741.43, "timestamp": "01:02:21", "text": "関係を断ち切るか、特徴や顔を制限する"}, {"type": "subtitle", "time": 3743.99, "timestamp": "01:02:23", "text": "法的トラブル。それはまるで、OK のようなものです"}, {"type": "subtitle", "time": 3745.589, "timestamp": "01:02:25", "text": "彼はティックの状況と比較されている"}, {"type": "subtitle", "time": 3746.95, "timestamp": "01:02:26", "text": "トクでは、彼らは確信が持てない"}, {"type": "subtitle", "time": 3748.549, "timestamp": "01:02:28", "text": "継続的なサポート、または"}, {"type": "subtitle", "time": 3749.99, "timestamp": "01:02:29", "text": "コードを変更または制限する"}, {"type": "subtitle", "time": 3752.99, "timestamp": "01:02:32", "text": "法律の改正によりユーザーの国が"}, {"type": "subtitle", "time": 3756.47, "timestamp": "01:02:36", "text": "バンド。彼らは法的助言を好む"}, {"type": "subtitle", "time": 3759.03, "timestamp": "01:02:39", "text": "あるいは、より上位の権威による統治"}, {"type": "subtitle", "time": 3761.03, "timestamp": "01:02:41", "text": "支持するかどうかを推測しなければならない"}, {"type": "subtitle", "time": 3763.91, "timestamp": "01:02:43", "text": "安全かどうか。彼らはオープンなので"}, {"type": "subtitle", "time": 3767.23, "timestamp": "01:02:47", "text": "要約すると、彼らはビリーを加えることに前向きです"}, {"type": "subtitle", "time": 3769.91, "timestamp": "01:02:49", "text": "D 入力と新しいサポートに感謝します"}, {"type": "subtitle", "time": 3771.91, "timestamp": "01:02:51", "text": "ウェブサイトの機能だが躊躇している"}, {"type": "subtitle", "time": 3775.069, "timestamp": "01:02:55", "text": "コミットするのは、彼らがとても"}, {"type": "subtitle", "time": 3778.069, "timestamp": "01:02:58", "text": "嘘をついたら、彼らは建てたくなくなるだろう"}]
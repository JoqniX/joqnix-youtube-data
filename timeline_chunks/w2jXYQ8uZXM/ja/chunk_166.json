[{"type": "subtitle", "time": 9962.83, "timestamp": "02:46:02", "text": "えっと、"}, {"type": "subtitle", "time": 9965.59, "timestamp": "02:46:05", "text": "分。ええと、私の友達は"}, {"type": "subtitle", "time": 9968.07, "timestamp": "02:46:08", "text": "ゲームをプレイしたり、その他諸々。えっと、"}, {"type": "subtitle", "time": 9969.99, "timestamp": "02:46:09", "text": "彼が引き継ぐことになる。私たちは"}, {"type": "subtitle", "time": 9972.349, "timestamp": "02:46:12", "text": "コラボレーション。"}, {"type": "subtitle", "time": 9975.469, "timestamp": "02:46:15", "text": "えっと、彼が"}, {"type": "subtitle", "time": 9978.309, "timestamp": "02:46:18", "text": "参加する。彼が参加するのを待つだけです"}, {"type": "subtitle", "time": 10003.11, "timestamp": "02:46:43", "text": "えっと、ほんの数文だけです。あ、待って、"}, {"type": "subtitle", "time": 10005.71, "timestamp": "02:46:45", "text": "ちょっと待ってください。"}]
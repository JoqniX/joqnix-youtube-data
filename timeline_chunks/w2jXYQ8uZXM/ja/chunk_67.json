[{"type": "subtitle", "time": 4021.99, "timestamp": "01:07:01", "text": "あなたはスパム行為を自動化しているわけではありません。えっと、彼らは"}, {"type": "subtitle", "time": 4024.15, "timestamp": "01:07:04", "text": "受動的なアクセスを容認する傾向がある"}, {"type": "subtitle", "time": 4028.15, "timestamp": "01:07:08", "text": "これは非公式なので法的に"}, {"type": "subtitle", "time": 4030.71, "timestamp": "01:07:10", "text": "彼らは正式な出版社ではないが、"}, {"type": "subtitle", "time": 4032.71, "timestamp": "01:07:12", "text": "アクティブ情報ではありません。"}, {"type": "subtitle", "time": 4033.87, "timestamp": "01:07:13", "text": "埋める"}, {"type": "subtitle", "time": 4037.029, "timestamp": "01:07:17", "text": "路面電車の取り締まりリスクは低い"}, {"type": "subtitle", "time": 4039.829, "timestamp": "01:07:19", "text": "個々のツールや読書だが、もし実験室であれば"}, {"type": "subtitle", "time": 4041.589, "timestamp": "01:07:21", "text": "信じられるルールを破るか、捕まる"}, {"type": "subtitle", "time": 4044.15, "timestamp": "01:07:24", "text": "ダウンまたはアクティブにブロックを開始する"}, {"type": "subtitle", "time": 4046.47, "timestamp": "01:07:26", "text": "サードパーティのイベントスクレイピングとサービス"}, {"type": "subtitle", "time": 4048.43, "timestamp": "01:07:28", "text": "閉鎖されるか、"}, {"type": "subtitle", "time": 4049.77, "timestamp": "01:07:29", "text": "限定"}, {"type": "subtitle", "time": 4056.75, "timestamp": "01:07:36", "text": "[音楽]"}, {"type": "subtitle", "time": 4060.51, "timestamp": "01:07:40", "text": "えっと、それは成績です。ええ、あなたはそうではありません"}]
[{"type": "subtitle", "time": 9181.59, "timestamp": "02:33:01", "text": "うん。こんにちは、忍者さん。おはよう。"}, {"type": "subtitle", "time": 9187.309, "timestamp": "02:33:07", "text": "ドン。長くは続かない"}, {"type": "subtitle", "time": 9190.63, "timestamp": "02:33:10", "text": "平均。これが最後にプレイした時だった"}, {"type": "subtitle", "time": 9196.19, "timestamp": "02:33:16", "text": "[音楽]"}, {"type": "subtitle", "time": 9206.63, "timestamp": "02:33:26", "text": "今日なぜだかわからないけど、今日は"}, {"type": "subtitle", "time": 9210.55, "timestamp": "02:33:30", "text": "よく眠れたから良かった。私はそうしなかったと思う"}, {"type": "subtitle", "time": 9213.95, "timestamp": "02:33:33", "text": "寝過ぎたり、飲み過ぎたり"}, {"type": "subtitle", "time": 9216.11, "timestamp": "02:33:36", "text": "時間といいね"}, {"type": "subtitle", "time": 9220.59, "timestamp": "02:33:40", "text": "えっと、時間がかかりすぎたり、"}, {"type": "subtitle", "time": 9223.51, "timestamp": "02:33:43", "text": "まあ、ある意味ではよく眠れたよ。ええ、ある意味では"}, {"type": "subtitle", "time": 9227.55, "timestamp": "02:33:47", "text": "よく眠れた。私は時間を管理し、"}, {"type": "subtitle", "time": 9230.11, "timestamp": "02:33:50", "text": "すべて。今日は良い日だった"}, {"type": "subtitle", "time": 9232.79, "timestamp": "02:33:52", "text": "日。良い一日だった。疑問符。"}, {"type": "subtitle", "time": 9236.03, "timestamp": "02:33:56", "text": "騎手。つまり"}]
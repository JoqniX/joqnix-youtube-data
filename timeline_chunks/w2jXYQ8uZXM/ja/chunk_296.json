[{"type": "subtitle", "time": 17761.07, "timestamp": "04:56:01", "text": "骨が折れるだろう"}, {"type": "subtitle", "time": 17763.35, "timestamp": "04:56:03", "text": "あれ。どうすれば、その致命的な症状を治せますか？"}, {"type": "subtitle", "time": 17765.67, "timestamp": "04:56:05", "text": "骨？"}, {"type": "subtitle", "time": 17768.628, "timestamp": "04:56:08", "text": "えっと、あなたはそれらを持っていますか？"}, {"type": "subtitle", "time": 17772.15, "timestamp": "04:56:12", "text": "緑色の葉っぱとか、そういうの？"}, {"type": "subtitle", "time": 17774.31, "timestamp": "04:56:14", "text": "どんな葉っぱ？"}, {"type": "subtitle", "time": 17776.788, "timestamp": "04:56:16", "text": "それは私が使うものだと思います、"}, {"type": "subtitle", "time": 17786.47, "timestamp": "04:56:26", "text": "私はこれらのモンスターを倒しましたが、彼らは"}, {"type": "subtitle", "time": 17790.03, "timestamp": "04:56:30", "text": "Dではない。彼らは落とさなかった。"}, {"type": "subtitle", "time": 17793.03, "timestamp": "04:56:33", "text": "何でも。おそらくそうだったでしょう。さぁ行こう。"}, {"type": "subtitle", "time": 17794.51, "timestamp": "04:56:34", "text": "ジョグ。によって"}, {"type": "subtitle", "time": 17798.03, "timestamp": "04:56:38", "text": "骨の釘、ですよね？"}, {"type": "subtitle", "time": 17801.99, "timestamp": "04:56:41", "text": "うん。骨の棍棒を作らなければならない。"}, {"type": "subtitle", "time": 17803.59, "timestamp": "04:56:43", "text": "また、工事の音が聞こえますか？"}, {"type": "subtitle", "time": 17805.43, "timestamp": "04:56:45", "text": "音？"}, {"type": "subtitle", "time": 17807.35, "timestamp": "04:56:47", "text": "私のマイク。"}, {"type": "subtitle", "time": 17809.59, "timestamp": "04:56:49", "text": "ニース。骨の棍棒は必要ないかもしれない。"}, {"type": "subtitle", "time": 17811.83, "timestamp": "04:56:51", "text": "ほら、普通のクラブも"}, {"type": "subtitle", "time": 17815.75, "timestamp": "04:56:55", "text": "同じことをする。何？"}, {"type": "subtitle", "time": 17817.67, "timestamp": "04:56:57", "text": "ええ、大した違いはありません。"}]
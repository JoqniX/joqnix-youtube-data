[{"type": "subtitle", "time": 12722.349, "timestamp": "03:32:02", "text": "低設定で60fps。これは"}, {"type": "subtitle", "time": 12725.71, "timestamp": "03:32:05", "text": "より良い。遅れているという事実は"}, {"type": "subtitle", "time": 12729.03, "timestamp": "03:32:09", "text": "不気味なほど奇妙だ。"}, {"type": "subtitle", "time": 12730.63, "timestamp": "03:32:10", "text": "うん、このゲームは確かにラグが発生するね"}, {"type": "subtitle", "time": 12732.87, "timestamp": "03:32:12", "text": "水の物理特性によるものです。水のように"}, {"type": "subtitle", "time": 12735.429, "timestamp": "03:32:15", "text": "物理学は良い。"}, {"type": "subtitle", "time": 12739.51, "timestamp": "03:32:19", "text": "待って、このベースを作ったんだ。作ってみよう。"}, {"type": "subtitle", "time": 12742.469, "timestamp": "03:32:22", "text": "しかし、ドアはどこにあるのだろうか？えっと、あなたは"}, {"type": "subtitle", "time": 12745.59, "timestamp": "03:32:25", "text": "ドアのやつが見えますか？"}, {"type": "subtitle", "time": 12749.75, "timestamp": "03:32:29", "text": "オン・オン・ザ・"}, {"type": "subtitle", "time": 12752.15, "timestamp": "03:32:32", "text": "モード？うん。そこに入れて"}, {"type": "subtitle", "time": 12754.75, "timestamp": "03:32:34", "text": "それはただドアを作るだけです"}, {"type": "subtitle", "time": 12757.15, "timestamp": "03:32:37", "text": "自体。"}, {"type": "subtitle", "time": 12760.15, "timestamp": "03:32:40", "text": "ドアを取り付けましょう。"}, {"type": "subtitle", "time": 12767.51, "timestamp": "03:32:47", "text": "ドア。なぜ？なぜ彼らは呼吸を持っているのか"}, {"type": "subtitle", "time": 12771.19, "timestamp": "03:32:51", "text": "ワイルドのスタミナゲージ？"}, {"type": "subtitle", "time": 12774.15, "timestamp": "03:32:54", "text": "はい。よし、これでいい。"}, {"type": "subtitle", "time": 12775.83, "timestamp": "03:32:55", "text": "ええ、スタミナゲージみたいなものがありますよ。しないで"}, {"type": "subtitle", "time": 12777.429, "timestamp": "03:32:57", "text": "それについては心配する必要がある。ああ、ジョック。私"}]
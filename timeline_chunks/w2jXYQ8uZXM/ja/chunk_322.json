[{"type": "subtitle", "time": 19335.83, "timestamp": "05:22:15", "text": "私の犬のもう片方の部分はどこにあるの？私"}, {"type": "subtitle", "time": 19339.27, "timestamp": "05:22:19", "text": "それを見つけてください。彼はどこにもいない。"}, {"type": "subtitle", "time": 19342.23, "timestamp": "05:22:22", "text": "もう少しで着陸するところだった。どうぞ、どうぞ。戻る"}, {"type": "subtitle", "time": 19345.51, "timestamp": "05:22:25", "text": "家。はい、今行きます。ほとんど。"}, {"type": "subtitle", "time": 19347.19, "timestamp": "05:22:27", "text": "お二人は運転の好みが違いますか？"}, {"type": "subtitle", "time": 19349.83, "timestamp": "05:22:29", "text": "今、最悪な状況？うん。くそったれ"}, {"type": "subtitle", "time": 19351.67, "timestamp": "05:22:31", "text": "それ。"}, {"type": "subtitle", "time": 19355.35, "timestamp": "05:22:35", "text": "つまり、彼は彼を正式に招待したかったのです。"}, {"type": "subtitle", "time": 19358.15, "timestamp": "05:22:38", "text": "そうそう。つまり、私たちは、私たちは"}, {"type": "subtitle", "time": 19360.55, "timestamp": "05:22:40", "text": "両方のストレージに。だから、私たちは"}, {"type": "subtitle", "time": 19363.83, "timestamp": "05:22:43", "text": "それの。作ればいいんです。ちくしょう。"}, {"type": "subtitle", "time": 19366.19, "timestamp": "05:22:46", "text": "なぜ？"}, {"type": "subtitle", "time": 19368.83, "timestamp": "05:22:48", "text": "こんにちは。こんにちは。私は"}, {"type": "subtitle", "time": 19376.27, "timestamp": "05:22:56", "text": "おお。彼は他の人の"}]
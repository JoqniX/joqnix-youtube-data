[{"type": "subtitle", "time": 15902.51, "timestamp": "04:25:02", "text": "もの。くそ、それは"}, {"type": "subtitle", "time": 15906.389, "timestamp": "04:25:06", "text": "ニース。いいえ。ああ、あなたは死んでいますか？"}, {"type": "subtitle", "time": 15909.11, "timestamp": "04:25:09", "text": "いいえ、私はまだ死んでいません。私はただプレスしているだけです"}, {"type": "subtitle", "time": 15919.75, "timestamp": "04:25:19", "text": "緊急通報すべきでしょうか？うん。"}, {"type": "subtitle", "time": 15922.469, "timestamp": "04:25:22", "text": "よし、彼は生き延びた。"}, {"type": "subtitle", "time": 15925.67, "timestamp": "04:25:25", "text": "ああ、神様。私はジョックについて行くよ、"}, {"type": "subtitle", "time": 15926.67, "timestamp": "04:25:26", "text": "私"}, {"type": "subtitle", "time": 15930.71, "timestamp": "04:25:30", "text": "推測。これは一体何だ？"}, {"type": "subtitle", "time": 15939.269, "timestamp": "04:25:39", "text": "聞く？今すぐ荷物を取りに行かないといけないので"}, {"type": "subtitle", "time": 15941.83, "timestamp": "04:25:41", "text": "2 つの古代の断片があり、"}, {"type": "subtitle", "time": 15943.25, "timestamp": "04:25:43", "text": "ずっと上"}, {"type": "subtitle", "time": 15951.429, "timestamp": "04:25:51", "text": "そこには。の代わりにマナに取り組む"}, {"type": "subtitle", "time": 15953.67, "timestamp": "04:25:53", "text": "見ているB。"}, {"type": "subtitle", "time": 15957.269, "timestamp": "04:25:57", "text": "うん、たぶん屋敷を使うと思う。"}]
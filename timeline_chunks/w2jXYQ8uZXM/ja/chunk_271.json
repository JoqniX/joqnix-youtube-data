[{"type": "subtitle", "time": 16260.389, "timestamp": "04:31:00", "text": "あなたのプラットフォーム活動は？わかった。何？なぜ"}, {"type": "subtitle", "time": 16263.51, "timestamp": "04:31:03", "text": "プラットフォームはありますか？わかった。"}, {"type": "subtitle", "time": 16266.67, "timestamp": "04:31:06", "text": "どうやってあなたはどうですか私は"}, {"type": "subtitle", "time": 16272.79, "timestamp": "04:31:12", "text": "わかった。私は死んだ。私は死んだ。彼は亡くなった。"}, {"type": "subtitle", "time": 16273.79, "timestamp": "04:31:13", "text": "何"}, {"type": "subtitle", "time": 16277.99, "timestamp": "04:31:17", "text": "くそ、俺は押した、押した。あなたが知っている"}, {"type": "subtitle", "time": 16280.87, "timestamp": "04:31:20", "text": "私が何をしたかって？私はまるで建築物を作っているようだった"}, {"type": "subtitle", "time": 16283.67, "timestamp": "04:31:23", "text": "そして私の回避は左マウスのようなものです"}, {"type": "subtitle", "time": 16285.91, "timestamp": "04:31:25", "text": "クリック。私は実際にそれを押しました"}, {"type": "subtitle", "time": 16290.03, "timestamp": "04:31:30", "text": "そして私は転んだ。クソ野郎。"}, {"type": "subtitle", "time": 16293.83, "timestamp": "04:31:33", "text": "なあ、ジャンプしなきゃ。私が撃ったんです。もし"}, {"type": "subtitle", "time": 16295.429, "timestamp": "04:31:35", "text": "上がってきたら、"}, {"type": "subtitle", "time": 16298.309, "timestamp": "04:31:38", "text": "はしごを持って登るのですか？うん。"}, {"type": "subtitle", "time": 16299.349, "timestamp": "04:31:39", "text": "はい、できますよ。でも私はそうは思わない"}, {"type": "subtitle", "time": 16301.309, "timestamp": "04:31:41", "text": "そうするつもりです。どうぞ"}, {"type": "subtitle", "time": 16303.67, "timestamp": "04:31:43", "text": "それ。いいえ、ジョギングはしたくないと思います"}, {"type": "subtitle", "time": 16305.59, "timestamp": "04:31:45", "text": "始めたことをやり遂げる。兄弟、ついてきてくれよ。"}, {"type": "subtitle", "time": 16308.63, "timestamp": "04:31:48", "text": "私が言ったことをそのまま受け止めてください。"}, {"type": "subtitle", "time": 16319.269, "timestamp": "04:31:59", "text": "ちなみに、自分の持ち物がどこにあるかは分かっていますよ。私"}]
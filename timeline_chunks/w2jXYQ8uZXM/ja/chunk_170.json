[{"type": "subtitle", "time": 10203.99, "timestamp": "02:50:03", "text": "彼は一体何を言っているんだ？それは"}, {"type": "subtitle", "time": 10206.19, "timestamp": "02:50:06", "text": "のように見える"}, {"type": "subtitle", "time": 10211.75, "timestamp": "02:50:11", "text": "えっと、BRBストリーマー。ああ、消え失せろ。の"}, {"type": "subtitle", "time": 10214.429, "timestamp": "02:50:14", "text": "すぐ戻ります"}, {"type": "subtitle", "time": 10218.23, "timestamp": "02:50:18", "text": "ストリーマー。ああ、ちくしょう。それは"}, {"type": "subtitle", "time": 10222.23, "timestamp": "02:50:22", "text": "私はこうなってしまったのか？ BRB配信者？イエス。私"}, {"type": "subtitle", "time": 10226.91, "timestamp": "02:50:26", "text": "ああ、大変だ。"}, {"type": "subtitle", "time": 10231.63, "timestamp": "02:50:31", "text": "えーっと、みんな調子はどう？こんにちは。"}, {"type": "subtitle", "time": 10236.23, "timestamp": "02:50:36", "text": "こんにちは。さっき食べたばかりで、よくわからない。"}, {"type": "subtitle", "time": 10240.63, "timestamp": "02:50:40", "text": "ただ食べるだけ。ええ、ちょうど昼食を済ませたところです。私"}, {"type": "subtitle", "time": 10243.75, "timestamp": "02:50:43", "text": "行かなければならない"}, {"type": "subtitle", "time": 10245.83, "timestamp": "02:50:45", "text": "うん。"}, {"type": "subtitle", "time": 10254.309, "timestamp": "02:50:54", "text": "まあ、スポーツマンたちがやってくるまではね。あなたは何を"}, {"type": "subtitle", "time": 10259.91, "timestamp": "02:50:59", "text": "つまり、あなたがプレイしていたゲームをプレイしてください"}]
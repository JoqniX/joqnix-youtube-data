[{"type": "subtitle", "time": 19028.31, "timestamp": "05:17:08", "text": "いいえ。彼はどこにいますか？待って、彼はどこにいるの？"}, {"type": "subtitle", "time": 19031.03, "timestamp": "05:17:11", "text": "彼はどこへ行ったのか？"}, {"type": "subtitle", "time": 19034.43, "timestamp": "05:17:14", "text": "何てことだ。わかった、いいよ。わかった、もうやめて。私"}, {"type": "subtitle", "time": 19037.51, "timestamp": "05:17:17", "text": "矢印だけが必要だ。私は99を持っています。"}, {"type": "subtitle", "time": 19040.47, "timestamp": "05:17:20", "text": "アイドルは必要ですか？よくわからない。わかった。"}, {"type": "subtitle", "time": 19048.948, "timestamp": "05:17:28", "text": "あなたか上司の意見が聞こえます。わからない。"}, {"type": "subtitle", "time": 19050.59, "timestamp": "05:17:30", "text": "あなたはここにいますか？ボス"}, {"type": "subtitle", "time": 19053.67, "timestamp": "05:17:33", "text": "実は。ああ、彼はここにいる。から"}, {"type": "subtitle", "time": 19060.47, "timestamp": "05:17:40", "text": "うん。ああ、いい子だね。彼は"}, {"type": "subtitle", "time": 19075.19, "timestamp": "05:17:55", "text": "ただ、それはあなたの体力を奪います"}, {"type": "subtitle", "time": 19078.31, "timestamp": "05:17:58", "text": "これをやっている。うん。そうそう。何てことだ。"}]
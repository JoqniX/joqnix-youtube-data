[{"type": "subtitle", "time": 13562.309, "timestamp": "03:46:02", "text": "ここ。建てるなら、ここに来なさい。ここに来て。ああ、"}, {"type": "subtitle", "time": 13564.389, "timestamp": "03:46:04", "text": "わかった。わかった。わかった。わかった。わかった。"}, {"type": "subtitle", "time": 13566.389, "timestamp": "03:46:06", "text": "わかった。わかった。わかった。わかった。内部。"}, {"type": "subtitle", "time": 13568.71, "timestamp": "03:46:08", "text": "内部で作成する必要があります。"}, {"type": "subtitle", "time": 13569.71, "timestamp": "03:46:09", "text": "それは"}, {"type": "subtitle", "time": 13572.51, "timestamp": "03:46:12", "text": "火。リクエスト"}, {"type": "subtitle", "time": 13575.59, "timestamp": "03:46:15", "text": "火事。よくやったね。寝ることができます"}, {"type": "subtitle", "time": 13577.269, "timestamp": "03:46:17", "text": "これです。もう二度と作らないで。ああ、"}, {"type": "subtitle", "time": 13581.189, "timestamp": "03:46:21", "text": "クソ神様。彼はベッドを2つ作った。"}, {"type": "subtitle", "time": 13583.59, "timestamp": "03:46:23", "text": "あれは削除します。実際は、いいえ。いいえ、"}, {"type": "subtitle", "time": 13584.95, "timestamp": "03:46:24", "text": "私のものは削除していただいて構いません。削除できます"}, {"type": "subtitle", "time": 13587.75, "timestamp": "03:46:27", "text": "実は、私のものです。うん、もうやったよ"}, {"type": "subtitle", "time": 13591.11, "timestamp": "03:46:31", "text": "それ。私のものを削除してください。 1つ削除してください。うん。"}, {"type": "subtitle", "time": 13593.189, "timestamp": "03:46:33", "text": "うん、私が作ったものを削除して"}, {"type": "subtitle", "time": 13596.63, "timestamp": "03:46:36", "text": "ここ。ああ、そうだね。ありがとう。あなたは"}, {"type": "subtitle", "time": 13597.83, "timestamp": "03:46:37", "text": "もう片方を削除しますか？わかった。うん、君は"}, {"type": "subtitle", "time": 13599.83, "timestamp": "03:46:39", "text": "死んだ。さあ、寝よう。ただ"}, {"type": "subtitle", "time": 13601.79, "timestamp": "03:46:41", "text": "寝る。いいえ、Bを押してください"}, {"type": "subtitle", "time": 13605.349, "timestamp": "03:46:45", "text": "また。寝よう。はい、お願いします。"}, {"type": "subtitle", "time": 13608.79, "timestamp": "03:46:48", "text": "はい。よし、目が覚めたよね？いいえ。"}, {"type": "subtitle", "time": 13611.189, "timestamp": "03:46:51", "text": "いいえ。いいえ。Eを押していません、"}, {"type": "subtitle", "time": 13613.91, "timestamp": "03:46:53", "text": "母親。"}, {"type": "subtitle", "time": 13618.63, "timestamp": "03:46:58", "text": "XPを獲得しました。私は「わかった」と思った。"}]
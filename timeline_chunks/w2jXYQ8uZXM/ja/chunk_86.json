[{"type": "subtitle", "time": 5160.55, "timestamp": "01:26:00", "text": "そして私は大学とドラッグをこれから受講します"}, {"type": "subtitle", "time": 5163.43, "timestamp": "01:26:03", "text": "テスト。私も。あと1ヶ月。ああ、よかった"}, {"type": "subtitle", "time": 5166.03, "timestamp": "01:26:06", "text": "運。良い"}, {"type": "subtitle", "time": 5181.75, "timestamp": "01:26:21", "text": "運。そうそう。忍者が尋ねたんだよね？どうやって"}, {"type": "subtitle", "time": 5183.91, "timestamp": "01:26:23", "text": "私は伍長たちと話すように話します"}, {"type": "subtitle", "time": 5186.55, "timestamp": "01:26:26", "text": "もの？私はしません。私は普通に話すだけです"}, {"type": "subtitle", "time": 5189.07, "timestamp": "01:26:29", "text": "今。文字通り、私は話す"}, {"type": "subtitle", "time": 5191.669, "timestamp": "01:26:31", "text": "通常。私はただ話すだけです"}, {"type": "subtitle", "time": 5208.79, "timestamp": "01:26:48", "text": "普通は疑問点などを質問するから"}, {"type": "subtitle", "time": 5211.91, "timestamp": "01:26:51", "text": "企業側の事情はよく知りません。平"}, {"type": "subtitle", "time": 5219.43, "timestamp": "01:26:59", "text": "クリエイター、たとえ私がコンテンツクリエイターであっても、"}]
[{"type": "subtitle", "time": 14400.63, "timestamp": "04:00:00", "text": "彼の健康状態が悪化しているのがわかるのは、"}, {"type": "subtitle", "time": 14445.469, "timestamp": "04:00:45", "text": "ああ、それはあそこの上の方にどこかにあるよ。"}, {"type": "subtitle", "time": 14455.67, "timestamp": "04:00:55", "text": "また戻ってきます。あなたの配信はつまらない。"}, {"type": "subtitle", "time": 14459.229, "timestamp": "04:00:59", "text": "私の配信は「はい」です。"}]
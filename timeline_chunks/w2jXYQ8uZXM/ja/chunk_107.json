[{"type": "subtitle", "time": 6420.99, "timestamp": "01:47:00", "text": "そして私は知らない"}, {"type": "subtitle", "time": 6424.59, "timestamp": "01:47:04", "text": "中国語。難しいだろう"}, {"type": "subtitle", "time": 6427.27, "timestamp": "01:47:07", "text": "しかし私は徐々に学んでいます"}, {"type": "subtitle", "time": 6429.27, "timestamp": "01:47:09", "text": "プラットフォーム。もっと作りたい"}, {"type": "subtitle", "time": 6431.79, "timestamp": "01:47:11", "text": "他の人々が"}, {"type": "subtitle", "time": 6435.109, "timestamp": "01:47:15", "text": "また、ここでストリーミング配信なども行い、"}]
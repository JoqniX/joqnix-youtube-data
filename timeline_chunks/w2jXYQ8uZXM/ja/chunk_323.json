[{"type": "subtitle", "time": 19385.628, "timestamp": "05:23:05", "text": "脅威。でも私はもっともっと手に入れた"}, {"type": "subtitle", "time": 19395.51, "timestamp": "05:23:15", "text": "実際、そのまま枯らしておいた方がいい。心配しないで。"}, {"type": "subtitle", "time": 19399.27, "timestamp": "05:23:19", "text": "ブロックします。私は男です。"}, {"type": "subtitle", "time": 19401.11, "timestamp": "05:23:21", "text": "あのパイナップルの中には誰が住んでいるの？そうしたいです。"}, {"type": "subtitle", "time": 19407.43, "timestamp": "05:23:27", "text": "わかった。えっと、あなたのアイテム、あなたのアイテムと"}, {"type": "subtitle", "time": 19410.03, "timestamp": "05:23:30", "text": "もの。"}, {"type": "subtitle", "time": 19413.67, "timestamp": "05:23:33", "text": "うん。えっと、その物を手に入れることができます"}, {"type": "subtitle", "time": 19415.99, "timestamp": "05:23:35", "text": "羊の飼育場から。"}, {"type": "subtitle", "time": 19420.948, "timestamp": "05:23:40", "text": "ストレージを手に入れました。忘れていた"}, {"type": "subtitle", "time": 19423.91, "timestamp": "05:23:43", "text": "の"}, {"type": "subtitle", "time": 19431.43, "timestamp": "05:23:51", "text": "しまった。時々、ゲームは"}, {"type": "subtitle", "time": 19434.55, "timestamp": "05:23:54", "text": "ぎこちないけど、良いよ。何てことだ。水"}, {"type": "subtitle", "time": 19436.47, "timestamp": "05:23:56", "text": "ストランド。基本的な治療を施しました"}, {"type": "subtitle", "time": 19439.51, "timestamp": "05:23:59", "text": "薬。構築する。その構造を理解してください。"}]
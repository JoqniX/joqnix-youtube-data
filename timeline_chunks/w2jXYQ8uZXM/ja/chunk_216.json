[{"type": "subtitle", "time": 12960.309, "timestamp": "03:36:00", "text": "構築できる。アークみたいなもんだよ"}, {"type": "subtitle", "time": 12982.469, "timestamp": "03:36:22", "text": "私はみんなのためにベッドを整えた。登ることができます"}, {"type": "subtitle", "time": 12985.91, "timestamp": "03:36:25", "text": "あなたの。ああ、私たちは付き合っているの？私たちは"}, {"type": "subtitle", "time": 12991.269, "timestamp": "03:36:31", "text": "みんな手をつないでいるの？いや。ああ、ちくしょう。"}, {"type": "subtitle", "time": 12997.91, "timestamp": "03:36:37", "text": "何？何を作っているの？ああ、変わりたい"}, {"type": "subtitle", "time": 13001.269, "timestamp": "03:36:41", "text": "ああ、私は作る必要がない"}, {"type": "subtitle", "time": 13004.71, "timestamp": "03:36:44", "text": "これ。ああ、私はなんてバカなんだろう。どこ？大丈夫。"}, {"type": "subtitle", "time": 13007.269, "timestamp": "03:36:47", "text": "もう一度右クリックを押してください。行くよ"}, {"type": "subtitle", "time": 13010.349, "timestamp": "03:36:50", "text": "ここ。私は"}, {"type": "subtitle", "time": 13013.51, "timestamp": "03:36:53", "text": "ペットだよ、みんな。私のペットを見たいですか？私は手に入れた"}, {"type": "subtitle", "time": 13016.71, "timestamp": "03:36:56", "text": "削除しました。"}, {"type": "subtitle", "time": 13018.309, "timestamp": "03:36:58", "text": "ええ、誰も私のペットを見たくないんです。私"}]
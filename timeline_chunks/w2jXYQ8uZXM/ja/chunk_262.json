[{"type": "subtitle", "time": 15725.189, "timestamp": "04:22:05", "text": "ああ、君たちは本当に遠いね"}, {"type": "subtitle", "time": 15726.95, "timestamp": "04:22:06", "text": "離れて。"}, {"type": "subtitle", "time": 15729.95, "timestamp": "04:22:09", "text": "私はここまで手が届く。しないで"}, {"type": "subtitle", "time": 15732.229, "timestamp": "04:22:12", "text": "心配。おそらく上に行くでしょう"}, {"type": "subtitle", "time": 15741.71, "timestamp": "04:22:21", "text": "心配。私もこれを受け取ります"}, {"type": "subtitle", "time": 15744.59, "timestamp": "04:22:24", "text": "男。今はスペースがありません"}, {"type": "subtitle", "time": 15753.189, "timestamp": "04:22:33", "text": "ええ、そうしました。"}, {"type": "subtitle", "time": 15755.349, "timestamp": "04:22:35", "text": "また、ここを歩き回るのは好きではありません"}, {"type": "subtitle", "time": 15763.67, "timestamp": "04:22:43", "text": "オブジェクトを回転させるにはどうすればいいですか？"}]
[{"type": "subtitle", "time": 17102.31, "timestamp": "04:45:02", "text": "もっと良い階段はないのだろうか？これ"}, {"type": "subtitle", "time": 17105.51, "timestamp": "04:45:05", "text": "階段はひどい。"}, {"type": "subtitle", "time": 17113.67, "timestamp": "04:45:13", "text": "私たちは始めたことをやり遂げなければならない。しかし私たちは"}, {"type": "subtitle", "time": 17119.11, "timestamp": "04:45:19", "text": "それ。私たちの分はどこにあるの？ああ、うちのはダウンしたよ、"}, {"type": "subtitle", "time": 17122.948, "timestamp": "04:45:22", "text": "ベイビー。ええ、ただいま。あなたが希望することを願います"}, {"type": "subtitle", "time": 17143.43, "timestamp": "04:45:43", "text": "そこには。わかりました、では今確認させてください。神よ、くそったれ"}, {"type": "subtitle", "time": 17151.39, "timestamp": "04:45:51", "text": "何"}, {"type": "subtitle", "time": 17158.31, "timestamp": "04:45:58", "text": "見て。イドリスがそこにいる。小さなオーバーのように"}]
[{"type": "subtitle", "time": 13201.469, "timestamp": "03:40:01", "text": "それらを手に入れよう"}, {"type": "subtitle", "time": 13204.79, "timestamp": "03:40:04", "text": "山賊。また、"}, {"type": "subtitle", "time": 13208.75, "timestamp": "03:40:08", "text": "キャンプファイヤーだ、みんな。忘れないでください"}, {"type": "subtitle", "time": 13211.67, "timestamp": "03:40:11", "text": "それ。あなたの空腹は唯一の"}, {"type": "subtitle", "time": 13223.03, "timestamp": "03:40:23", "text": "あなた。はい。はい。はい。また、仕事も見つけてください。"}, {"type": "subtitle", "time": 13226.75, "timestamp": "03:40:26", "text": "これらの霊の霊について"}, {"type": "subtitle", "time": 13230.95, "timestamp": "03:40:30", "text": "アンカー。ずっと簡単になった。 Gキーを押してください。"}, {"type": "subtitle", "time": 13245.75, "timestamp": "03:40:45", "text": "ただし、水上でしか効果がない。何？ああ、"}, {"type": "subtitle", "time": 13249.19, "timestamp": "03:40:49", "text": "神。それは確かに存在する。親和性。ああ、"}, {"type": "subtitle", "time": 13250.95, "timestamp": "03:40:50", "text": "神。"}, {"type": "subtitle", "time": 13258.87, "timestamp": "03:40:58", "text": "わかった。私と同じだ。ちくしょう。私は"}]
[{"type": "subtitle", "time": 4260.149, "timestamp": "01:11:00", "text": "「あ、時計みたいなものがあるんだ」みたいな感じ。"}, {"type": "subtitle", "time": 4263.83, "timestamp": "01:11:03", "text": "明らかに時計のようなもの。"}, {"type": "subtitle", "time": 4265.79, "timestamp": "01:11:05", "text": "ライブボット"}, {"type": "subtitle", "time": 4268.35, "timestamp": "01:11:08", "text": "シミュレーター。たくさん"}, {"type": "subtitle", "time": 4272.189, "timestamp": "01:11:12", "text": "もの。えっと、イベント"}, {"type": "subtitle", "time": 4277.03, "timestamp": "01:11:17", "text": "橋。変わったビーター。これは何ですか？ああ、"}, {"type": "subtitle", "time": 4279.95, "timestamp": "01:11:19", "text": "神。"}, {"type": "subtitle", "time": 4307.03, "timestamp": "01:11:47", "text": "最も自由な実際の地上位置線が自由"}, {"type": "subtitle", "time": 4311.39, "timestamp": "01:11:51", "text": "コピーソフト無料ソフトウェア。ああ、開いているよ"}, {"type": "subtitle", "time": 4314.59, "timestamp": "01:11:54", "text": "ソース。つまり、オープンです"}, {"type": "subtitle", "time": 4317.27, "timestamp": "01:11:57", "text": "ソース。ええと、修正もまた"}]
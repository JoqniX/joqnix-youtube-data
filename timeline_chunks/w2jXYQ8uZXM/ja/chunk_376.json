[{"type": "subtitle", "time": 22567.27, "timestamp": "06:16:07", "text": "ええ、うまくいくと思いますよ。何"}, {"type": "subtitle", "time": 22570.27, "timestamp": "06:16:10", "text": "みんなそうじゃないの？わかった。わかった。わかった。"}, {"type": "subtitle", "time": 22575.31, "timestamp": "06:16:15", "text": "えっと、私は、えっと、私、その、"}, {"type": "subtitle", "time": 22579.07, "timestamp": "06:16:19", "text": "これに関する私の設定はすべて"}, {"type": "subtitle", "time": 22580.99, "timestamp": "06:16:20", "text": "良い。"}, {"type": "subtitle", "time": 22590.67, "timestamp": "06:16:30", "text": "通知。えっと、ライン"}, {"type": "subtitle", "time": 22594.74, "timestamp": "06:16:34", "text": "通知。メール通知。おお。"}, {"type": "subtitle", "time": 22603.67, "timestamp": "06:16:43", "text": "ナンダ 550円。 550円はいくらですか？それ"}, {"type": "subtitle", "time": 22605.67, "timestamp": "06:16:45", "text": "おそらく2倍になるだろう"}, {"type": "subtitle", "time": 22610.628, "timestamp": "06:16:50", "text": "額。いいえ。ええと、1×4、1×"}, {"type": "subtitle", "time": 22612.83, "timestamp": "06:16:52", "text": "4番目または"}, {"type": "subtitle", "time": 22617.19, "timestamp": "06:16:57", "text": "何か。ああ、300だ。ああ。そうそう。"}]
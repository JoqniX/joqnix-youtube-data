[{"type": "subtitle", "time": 12243.269, "timestamp": "03:24:03", "text": "No. 360。30 60 了解。あなたが言うのを聞きました"}, {"type": "subtitle", "time": 12246.71, "timestamp": "03:24:06", "text": "560。私は「待って、50」って感じでした。なんてこった。それで、"}, {"type": "subtitle", "time": 12254.349, "timestamp": "03:24:14", "text": "[音楽]"}, {"type": "subtitle", "time": 12257.269, "timestamp": "03:24:17", "text": "イエス。アーチャンはFPSが好きではない。彼"}, {"type": "subtitle", "time": 12259.349, "timestamp": "03:24:19", "text": "美学が好きで、"}, {"type": "subtitle", "time": 12262.67, "timestamp": "03:24:22", "text": "源珍とか色々あるけど、高い"}, {"type": "subtitle", "time": 12267.99, "timestamp": "03:24:27", "text": "右。うん。うん。つまり、それは完全に"}, {"type": "subtitle", "time": 12270.95, "timestamp": "03:24:30", "text": "最高に滑らか。"}, {"type": "subtitle", "time": 12274.79, "timestamp": "03:24:34", "text": "そう、このゲームは"}, {"type": "subtitle", "time": 12277.19, "timestamp": "03:24:37", "text": "最高設定だと少し動作が重くなります。うん、"}, {"type": "subtitle", "time": 12278.79, "timestamp": "03:24:38", "text": "私たちは目の前のものを殺しに行く"}, {"type": "subtitle", "time": 12285.11, "timestamp": "03:24:45", "text": "私だけでしょうか、それとも画面が真っ黒なままなのでしょうか？"}, {"type": "subtitle", "time": 12286.349, "timestamp": "03:24:46", "text": "私はそうすべきでしょうか"}, {"type": "subtitle", "time": 12288.71, "timestamp": "03:24:48", "text": "最初は少し心配だったけど、"}, {"type": "subtitle", "time": 12291.75, "timestamp": "03:24:51", "text": "心配。ええ、ロードするためです。はい。同じことだ"}]
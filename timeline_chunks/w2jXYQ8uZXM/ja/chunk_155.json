[{"type": "subtitle", "time": 9301.19, "timestamp": "02:35:01", "text": "ツイッター。最近、私はベールのバオバを見ました"}, {"type": "subtitle", "time": 9305.11, "timestamp": "02:35:05", "text": "チューバ。彼女は完全にTwaを去りました。彼女"}, {"type": "subtitle", "time": 9307.469, "timestamp": "02:35:07", "text": "1つ広げて"}, {"type": "subtitle", "time": 9310.55, "timestamp": "02:35:10", "text": "もの。でも、私もそうしたいんです"}, {"type": "subtitle", "time": 9314.15, "timestamp": "02:35:14", "text": "そうしてください。開始に集中したい"}, {"type": "subtitle", "time": 9316.95, "timestamp": "02:35:16", "text": "自分自身とすべてのことに集中して"}, {"type": "subtitle", "time": 9319.51, "timestamp": "02:35:19", "text": "また、やめる、つまり、あまりにも"}, {"type": "subtitle", "time": 9322.71, "timestamp": "02:35:22", "text": "あまり活動的ではありません。わかった。私"}, {"type": "subtitle", "time": 9325.91, "timestamp": "02:35:25", "text": "あまりツイートはしないけど、私はただそこにいるだけ"}, {"type": "subtitle", "time": 9327.55, "timestamp": "02:35:27", "text": "そこには。私はただ"}, {"type": "subtitle", "time": 9335.79, "timestamp": "02:35:35", "text": "[音楽]"}, {"type": "subtitle", "time": 9338.75, "timestamp": "02:35:38", "text": "それ。それで"}, {"type": "subtitle", "time": 9345.23, "timestamp": "02:35:45", "text": "えっと、あなたは"}, {"type": "subtitle", "time": 9348.19, "timestamp": "02:35:48", "text": "怪物の話を聞いたことがある。はい、どうぞ"}, {"type": "subtitle", "time": 9353.71, "timestamp": "02:35:53", "text": "行く。最後のストリーム"}, {"type": "subtitle", "time": 9356.309, "timestamp": "02:35:56", "text": "荷解き。最後の解凍ストリーム。私にさせて"}, {"type": "subtitle", "time": 9359.67, "timestamp": "02:35:59", "text": "えっと、バックグラウンドミュージックを消してください。さあ"}]
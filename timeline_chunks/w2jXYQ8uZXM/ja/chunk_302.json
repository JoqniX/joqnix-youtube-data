[{"type": "subtitle", "time": 18120.948, "timestamp": "05:02:00", "text": "ああ、彼は後でそれを解体することもできるよ。それで、"}, {"type": "subtitle", "time": 18127.03, "timestamp": "05:02:07", "text": "材料は返却されますか？いいえ、あなた"}, {"type": "subtitle", "time": 18132.39, "timestamp": "05:02:12", "text": "お店のことですよね？"}, {"type": "subtitle", "time": 18134.23, "timestamp": "05:02:14", "text": "オルズ？今、３つくらいあるんだけど"}, {"type": "subtitle", "time": 18152.628, "timestamp": "05:02:32", "text": "現在、私のマナは22です。みんな、"}, {"type": "subtitle", "time": 18155.35, "timestamp": "05:02:35", "text": "あなたはいくつ持っていますか？"}, {"type": "subtitle", "time": 18159.91, "timestamp": "05:02:39", "text": "どこにいるの？ああ、あなたは遠すぎます。"}, {"type": "subtitle", "time": 18163.67, "timestamp": "05:02:43", "text": "今行ってる。ああ、大きな"}]
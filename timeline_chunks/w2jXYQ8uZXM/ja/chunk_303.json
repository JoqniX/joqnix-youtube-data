[{"type": "subtitle", "time": 18183.07, "timestamp": "05:03:03", "text": "うわぁ。ああ、心を落ち着かせるアンカーアップデート"}, {"type": "subtitle", "time": 18190.55, "timestamp": "05:03:10", "text": "心を落ち着かせる雰囲気。"}, {"type": "subtitle", "time": 18193.99, "timestamp": "05:03:13", "text": "それはどこで入手できますか？私たちには必要だ"}, {"type": "subtitle", "time": 18196.708, "timestamp": "05:03:16", "text": "ああ、もしかしたらできるかもしれない。"}, {"type": "subtitle", "time": 18198.55, "timestamp": "05:03:18", "text": "マナを稼げ。"}, {"type": "subtitle", "time": 18200.39, "timestamp": "05:03:20", "text": "水の強さ。マナをたくさん持って"}, {"type": "subtitle", "time": 18201.99, "timestamp": "05:03:21", "text": "自分。"}, {"type": "subtitle", "time": 18212.07, "timestamp": "05:03:32", "text": "よし、これで新しいセットを作ろう"}, {"type": "subtitle", "time": 18216.31, "timestamp": "05:03:36", "text": "はるかに優れた防具パーツです。"}, {"type": "subtitle", "time": 18219.27, "timestamp": "05:03:39", "text": "私はヨットに乗っています。"}, {"type": "subtitle", "time": 18221.83, "timestamp": "05:03:41", "text": "航海はするな。それを解体すればいい。なぜ？どこ"}, {"type": "subtitle", "time": 18223.75, "timestamp": "05:03:43", "text": "あなたは行き​​ますか？"}, {"type": "subtitle", "time": 18226.39, "timestamp": "05:03:46", "text": "アドベンチャー。"}, {"type": "subtitle", "time": 18228.31, "timestamp": "05:03:48", "text": "何てことだ。グロウストーンが欲しいですか、それとも"}, {"type": "subtitle", "time": 18229.83, "timestamp": "05:03:49", "text": "何か？"}, {"type": "subtitle", "time": 18233.948, "timestamp": "05:03:53", "text": "光る石。うん、それらを使って作れるよ"}, {"type": "subtitle", "time": 18236.47, "timestamp": "05:03:56", "text": "矢印。さあ、行くぞ、兄弟。どうやって"}]
[{"type": "subtitle", "time": 15600.309, "timestamp": "04:20:00", "text": "我が神よ。"}, {"type": "subtitle", "time": 15604.63, "timestamp": "04:20:04", "text": "次の目的地はもうすぐだと思う。"}, {"type": "subtitle", "time": 15605.95, "timestamp": "04:20:05", "text": "うん、"}, {"type": "subtitle", "time": 15608.71, "timestamp": "04:20:08", "text": "いや、こっちに洞窟が見えるよ。私はできる"}, {"type": "subtitle", "time": 15611.189, "timestamp": "04:20:11", "text": "登る。"}, {"type": "subtitle", "time": 15621.349, "timestamp": "04:20:21", "text": "くそ。あの船が見えますか？彼が見える。"}, {"type": "subtitle", "time": 15623.269, "timestamp": "04:20:23", "text": "ああ、彼らは私を見ている。何かが攻撃している"}, {"type": "subtitle", "time": 15627.349, "timestamp": "04:20:27", "text": "自分。そうそう。あまり。私は見ませんでした"}, {"type": "subtitle", "time": 15641.67, "timestamp": "04:20:41", "text": "あなたは本当の人魚ではない。推測"}, {"type": "subtitle", "time": 15647.91, "timestamp": "04:20:47", "text": "人魚よ、私の友よ。ああ、人魚。わかった。"}, {"type": "subtitle", "time": 15650.55, "timestamp": "04:20:50", "text": "わかった。うん、"}, {"type": "subtitle", "time": 15654.469, "timestamp": "04:20:54", "text": "人魚。人魚は実在すると思う？"}, {"type": "subtitle", "time": 15658.07, "timestamp": "04:20:58", "text": "いいえ、水が必要です。ええ、おそらくそうでしょう。私は思う"}]
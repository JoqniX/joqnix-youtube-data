[{"type": "subtitle", "time": 14042.229, "timestamp": "03:54:02", "text": "我が神よ。さあ行こう。うん。さあ、みんな。"}, {"type": "subtitle", "time": 14048.229, "timestamp": "03:54:08", "text": "ニース。"}, {"type": "subtitle", "time": 14049.85, "timestamp": "03:54:09", "text": "うん。"}, {"type": "subtitle", "time": 14051.269, "timestamp": "03:54:11", "text": "[音楽]"}, {"type": "subtitle", "time": 14054.229, "timestamp": "03:54:14", "text": "私に従ってください。私たちはただ、あなたが「いいね」を押すと"}, {"type": "subtitle", "time": 14056.55, "timestamp": "03:54:16", "text": "M、君なら私たちがどこへ向かうべきか分かるだろう。のように"}, {"type": "subtitle", "time": 14059.11, "timestamp": "03:54:19", "text": "いくつか疑問点がある。どこ"}, {"type": "subtitle", "time": 14062.229, "timestamp": "03:54:22", "text": "シールドは設置すべきですか？ボート。なんてこった。ない"}, {"type": "subtitle", "time": 14064.15, "timestamp": "03:54:24", "text": "ボートランナー。だから、まず最初に"}, {"type": "subtitle", "time": 14066.71, "timestamp": "03:54:26", "text": "この疑問符を取得してください"}, {"type": "subtitle", "time": 14069.59, "timestamp": "03:54:29", "text": "この場所。その後、"}, {"type": "subtitle", "time": 14074.15, "timestamp": "03:54:34", "text": "両側。よし。どのように配置すればいいですか"}, {"type": "subtitle", "time": 14077.99, "timestamp": "03:54:37", "text": "自分の体にシールドを張る？右。"}, {"type": "subtitle", "time": 14082.389, "timestamp": "03:54:42", "text": "どのボタンですか？シールド"}, {"type": "subtitle", "time": 14084.389, "timestamp": "03:54:44", "text": "あなたの在庫。"}, {"type": "subtitle", "time": 14086.309, "timestamp": "03:54:46", "text": "二。"}, {"type": "subtitle", "time": 14092.71, "timestamp": "03:54:52", "text": "クラブと協力して活動している。ところで、"}, {"type": "subtitle", "time": 14095.91, "timestamp": "03:54:55", "text": "私は今すぐクラブが必要だ。何てことだ。私は思った"}, {"type": "subtitle", "time": 14098.79, "timestamp": "03:54:58", "text": "ああ、この男は本当にひどい。行くよ"}]
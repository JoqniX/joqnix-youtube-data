[{"type": "subtitle", "time": 16863.43, "timestamp": "04:41:03", "text": "ついに。あ、自分の物が見えた。はい。あなたは"}, {"type": "subtitle", "time": 16866.39, "timestamp": "04:41:06", "text": "私の作品も見ていただけますか？ええ、分かります。"}, {"type": "subtitle", "time": 16878.628, "timestamp": "04:41:18", "text": "暴徒が私を攻撃しているが、私は"}, {"type": "subtitle", "time": 16881.59, "timestamp": "04:41:21", "text": "攻撃が見えない。"}, {"type": "subtitle", "time": 16886.23, "timestamp": "04:41:26", "text": "何？ああ、発射体のやつだ。"}, {"type": "subtitle", "time": 16890.868, "timestamp": "04:41:30", "text": "ああ、これは別の手法を使っているんですね。"}, {"type": "subtitle", "time": 16894.868, "timestamp": "04:41:34", "text": "待って、私のデッドボックスはどこ？"}, {"type": "subtitle", "time": 16897.43, "timestamp": "04:41:37", "text": "それは私の壊れた箱です。あなたのは上向きです"}, {"type": "subtitle", "time": 16903.11, "timestamp": "04:41:43", "text": "ここに来て。ここに来て。お見せしましょう。"}, {"type": "subtitle", "time": 16911.75, "timestamp": "04:41:51", "text": "ジョー、私たちがやろうとしていることを終わらせたいですか？"}, {"type": "subtitle", "time": 16914.07, "timestamp": "04:41:54", "text": "開始しましたか？もっと行きたいですか？うん。"}, {"type": "subtitle", "time": 16916.708, "timestamp": "04:41:56", "text": "うん。うん。うん。うん。私たちは死んだ"}]
[{"type": "subtitle", "time": 22381.67, "timestamp": "06:13:01", "text": "行く。私が何をしようとしているか、わかる？私は"}, {"type": "subtitle", "time": 22384.868, "timestamp": "06:13:04", "text": "短いURLを作って"}, {"type": "subtitle", "time": 22388.67, "timestamp": "06:13:08", "text": "こうします"}, {"type": "subtitle", "time": 22392.15, "timestamp": "06:13:12", "text": "ジョロ。それはすごく可愛いだろうね。あなたが知っている"}, {"type": "subtitle", "time": 22394.11, "timestamp": "06:13:14", "text": "何？私は"}, {"type": "subtitle", "time": 22401.47, "timestamp": "06:13:21", "text": "どうして"}, {"type": "subtitle", "time": 22423.15, "timestamp": "06:13:43", "text": "ほとんどの人が使っているかどうかはわかりません"}, {"type": "subtitle", "time": 22427.11, "timestamp": "06:13:47", "text": "えっと、短縮URLって何て言うんだっけ？"}, {"type": "subtitle", "time": 22429.07, "timestamp": "06:13:49", "text": "ブランドリンク"}, {"type": "subtitle", "time": 22432.99, "timestamp": "06:13:52", "text": "今はもう使ってないけど、使われているのを見たことがある"}, {"type": "subtitle", "time": 22437.03, "timestamp": "06:13:57", "text": "人気ブランドやさらに人気のあるブランドによって"}, {"type": "subtitle", "time": 22439.23, "timestamp": "06:13:59", "text": "クリエイター"}]
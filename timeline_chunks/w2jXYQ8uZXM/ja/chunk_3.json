[{"type": "subtitle", "time": 214.99, "timestamp": "00:03:34", "text": "時々、私は自分が"}, {"type": "subtitle", "time": 219.43, "timestamp": "00:03:39", "text": "ビリー・ビリーのバッグ、またはストリーミングなし"}, {"type": "subtitle", "time": 220.82999999999998, "timestamp": "00:03:40", "text": "適切にまたは"}, {"type": "subtitle", "time": 224.589, "timestamp": "00:03:44", "text": "何か、またはわからないメッセージ"}, {"type": "subtitle", "time": 229.22899999999998, "timestamp": "00:03:49", "text": "すぐ。わかった。よし。"}, {"type": "subtitle", "time": 231.949, "timestamp": "00:03:51", "text": "こんにちは。良い"}, {"type": "subtitle", "time": 235.0, "timestamp": "00:03:55", "text": "朝。こんにちは。こんにちは。いらっしゃいませ。良い"}, {"type": "subtitle", "time": 237.39, "timestamp": "00:03:57", "text": "[音楽]"}]
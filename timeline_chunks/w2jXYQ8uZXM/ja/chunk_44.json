[{"type": "subtitle", "time": 2661.309, "timestamp": "00:44:21", "text": "えっと、私は行く"}, {"type": "subtitle", "time": 2664.23, "timestamp": "00:44:24", "text": "あなたは企業の担当者と話すのが得意ですね"}, {"type": "subtitle", "time": 2667.829, "timestamp": "00:44:27", "text": "人々だよ、男。いや、違うよ、兄弟。私は違います。"}, {"type": "subtitle", "time": 2670.63, "timestamp": "00:44:30", "text": "私は違います。私はそれが苦手なんです。あなたは思う"}, {"type": "subtitle", "time": 2673.67, "timestamp": "00:44:33", "text": "もし私が自分の家族と話すことさえできないなら"}, {"type": "subtitle", "time": 2678.55, "timestamp": "00:44:38", "text": "アーティスト、そして厳しさも一緒に来てください、なぜなら私は"}, {"type": "subtitle", "time": 2685.15, "timestamp": "00:44:45", "text": "非公式。文字通り私は私は"}, {"type": "subtitle", "time": 2697.55, "timestamp": "00:44:57", "text": "キャップ。冗談抜きで。"}]
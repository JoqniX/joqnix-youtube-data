[{"type": "subtitle", "time": 8126.31, "timestamp": "02:15:26", "text": "1つ。わかった。コメントはこちらです。しかし"}, {"type": "subtitle", "time": 8128.95, "timestamp": "02:15:28", "text": "問題は、基本モードのサポートがないことです"}, {"type": "subtitle", "time": 8130.75, "timestamp": "02:15:30", "text": "ここ。あなた"}, {"type": "subtitle", "time": 8133.629, "timestamp": "02:15:33", "text": "名前を知っているのは"}]
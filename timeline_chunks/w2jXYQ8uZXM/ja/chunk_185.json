[{"type": "subtitle", "time": 11107.95, "timestamp": "03:05:07", "text": "石。作る"}, {"type": "subtitle", "time": 11110.469, "timestamp": "03:05:10", "text": "石。えーと、何を作る必要があるの？"}, {"type": "subtitle", "time": 11113.349, "timestamp": "03:05:13", "text": "精神的な支柱？"}, {"type": "subtitle", "time": 11115.429, "timestamp": "03:05:15", "text": "ああ、それはリスポーンビーコンのようなものだ。あなたも"}, {"type": "subtitle", "time": 11117.91, "timestamp": "03:05:17", "text": "卵を使ったやつ、覚えてる？それは"}, {"type": "subtitle", "time": 11120.71, "timestamp": "03:05:20", "text": "どこにいるの？うん。"}, {"type": "subtitle", "time": 11124.19, "timestamp": "03:05:24", "text": "さらに、それらも必要です。あなた、私はただ"}, {"type": "subtitle", "time": 11127.269, "timestamp": "03:05:27", "text": "まるで魔法のようなものが手に入ると言っている。私たちは"}, {"type": "subtitle", "time": 11130.71, "timestamp": "03:05:30", "text": "まだ手に入れていないけど。ああ、私は"}, {"type": "subtitle", "time": 11135.03, "timestamp": "03:05:35", "text": "見る。うん。魔法みたいなもの。それは"}, {"type": "subtitle", "time": 11141.429, "timestamp": "03:05:41", "text": "もう夜になりつつある？それは、"}, {"type": "subtitle", "time": 11143.83, "timestamp": "03:05:43", "text": "あなたにとって今夜は？"}, {"type": "subtitle", "time": 11146.63, "timestamp": "03:05:46", "text": "ああ、そちらではもう夜ですね。そうですね、"}, {"type": "subtitle", "time": 11150.71, "timestamp": "03:05:50", "text": "私にとっては昼間です。ああ、それは素晴らしい。"}, {"type": "subtitle", "time": 11152.15, "timestamp": "03:05:52", "text": "おそらく照明のせいでしょう。ええ、"}, {"type": "subtitle", "time": 11153.99, "timestamp": "03:05:53", "text": "雲。"}, {"type": "subtitle", "time": 11156.63, "timestamp": "03:05:56", "text": "そうそう。おそらく。さぁ行こう。病気"}, {"type": "subtitle", "time": 11158.87, "timestamp": "03:05:58", "text": "いくつか作って"}]
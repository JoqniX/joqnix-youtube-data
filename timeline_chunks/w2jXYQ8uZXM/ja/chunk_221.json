[{"type": "subtitle", "time": 13261.269, "timestamp": "03:41:01", "text": "変化。それはいいです。わかった、いいよ。病気"}, {"type": "subtitle", "time": 13263.11, "timestamp": "03:41:03", "text": "変化。"}, {"type": "subtitle", "time": 13264.87, "timestamp": "03:41:04", "text": "私は変わっていく。私は変わっていく。私は"}, {"type": "subtitle", "time": 13269.03, "timestamp": "03:41:09", "text": "合計。なかなかいい感じだね。"}, {"type": "subtitle", "time": 13271.15, "timestamp": "03:41:11", "text": "とにかく、私たちは"}, {"type": "subtitle", "time": 13274.79, "timestamp": "03:41:14", "text": "彼は武器を持っていますか？"}, {"type": "subtitle", "time": 13278.71, "timestamp": "03:41:18", "text": "私はお尻しか持っていない"}, {"type": "subtitle", "time": 13281.51, "timestamp": "03:41:21", "text": "彼は槍を持っていないと思う。"}, {"type": "subtitle", "time": 13285.229, "timestamp": "03:41:25", "text": "うん。彼に弓と矢を作ってあげてください。いくつかの"}, {"type": "subtitle", "time": 13288.71, "timestamp": "03:41:28", "text": "わかった。矢が必要だ。どうやって切るの？"}, {"type": "subtitle", "time": 13290.55, "timestamp": "03:41:30", "text": "木？"}, {"type": "subtitle", "time": 13292.55, "timestamp": "03:41:32", "text": "私はただ彼らの前に出て、尋ねるだけです。"}, {"type": "subtitle", "time": 13294.79, "timestamp": "03:41:34", "text": "ええ、やりますよ。あなたはそれをやっている。"}, {"type": "subtitle", "time": 13302.469, "timestamp": "03:41:42", "text": "行く。樹脂も少し手に入ります。"}, {"type": "subtitle", "time": 13305.03, "timestamp": "03:41:45", "text": "もう少し近づかないと。"}]
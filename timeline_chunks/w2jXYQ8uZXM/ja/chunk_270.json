[{"type": "subtitle", "time": 16214.95, "timestamp": "04:30:14", "text": "私は自分自身の冒険をしている。従わないで"}, {"type": "subtitle", "time": 16217.75, "timestamp": "04:30:17", "text": "ちなみに、私のことです。これは、"}, {"type": "subtitle", "time": 16236.189, "timestamp": "04:30:36", "text": "ああ、もうすぐ"}, {"type": "subtitle", "time": 16246.51, "timestamp": "04:30:46", "text": "はい。私はほとんど"}, {"type": "subtitle", "time": 16249.83, "timestamp": "04:30:49", "text": "亡くなった。イエス。みんなそれぞれ"}, {"type": "subtitle", "time": 16251.51, "timestamp": "04:30:51", "text": "自分自身の冒険。冗談だよ、分かってる？"}, {"type": "subtitle", "time": 16254.55, "timestamp": "04:30:54", "text": "自分？今行ってる。"}, {"type": "subtitle", "time": 16257.11, "timestamp": "04:30:57", "text": "いいえ、やめてください。死ぬかもしれない。どうしたの？"}]
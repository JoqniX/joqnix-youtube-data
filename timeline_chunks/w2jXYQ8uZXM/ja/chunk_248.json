[{"type": "subtitle", "time": 14883.59, "timestamp": "04:08:03", "text": "私はこのゲームをスピードランします。"}, {"type": "subtitle", "time": 14885.91, "timestamp": "04:08:05", "text": "私たちはスピードランができる。これは"}, {"type": "subtitle", "time": 14888.95, "timestamp": "04:08:08", "text": "まるでゲームみたいだよ。おお。ああ、そうかもね"}, {"type": "subtitle", "time": 14902.95, "timestamp": "04:08:22", "text": "私はビーチサイドにいます。"}, {"type": "subtitle", "time": 14904.95, "timestamp": "04:08:24", "text": "うん。来た時と同じ道を戻ってきてください"}, {"type": "subtitle", "time": 14908.87, "timestamp": "04:08:28", "text": "来た。いや、でもそこはすごく遠いよ。私は"}, {"type": "subtitle", "time": 14912.309, "timestamp": "04:08:32", "text": "別の場所で。私は船の近くにいます。"}, {"type": "subtitle", "time": 14914.15, "timestamp": "04:08:34", "text": "いや、それは違う。あなたは走らなかった"}, {"type": "subtitle", "time": 14918.389, "timestamp": "04:08:38", "text": "さあ、行こう。いや、手を使うよ。"}, {"type": "subtitle", "time": 14920.95, "timestamp": "04:08:40", "text": "まだ手を伸ばさないでください。しないで その方法"}, {"type": "subtitle", "time": 14924.63, "timestamp": "04:08:44", "text": "手元へ行くのはここからです。"}, {"type": "subtitle", "time": 14928.15, "timestamp": "04:08:48", "text": "ああ、敵がいる。おい、"}, {"type": "subtitle", "time": 14931.75, "timestamp": "04:08:51", "text": "なぜ彼は私を狙っているのか？"}, {"type": "subtitle", "time": 14933.99, "timestamp": "04:08:53", "text": "待って、君たちはどこにいるの？私は文字通り"}, {"type": "subtitle", "time": 14936.55, "timestamp": "04:08:56", "text": "スポーン地点にて。"}, {"type": "subtitle", "time": 14938.71, "timestamp": "04:08:58", "text": "いいえ、同じ場所から来てください。知ってるでしょ"}]
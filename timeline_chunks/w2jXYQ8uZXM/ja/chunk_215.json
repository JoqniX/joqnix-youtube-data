[{"type": "subtitle", "time": 12906.63, "timestamp": "03:35:06", "text": "もっと早く。あなたの基本的な必需品は何ですか"}, {"type": "subtitle", "time": 12910.71, "timestamp": "03:35:10", "text": "任務とは？えーと、緩めるって何？"}, {"type": "subtitle", "time": 12913.03, "timestamp": "03:35:13", "text": "石の棒？"}, {"type": "subtitle", "time": 12915.11, "timestamp": "03:35:15", "text": "そうしています。それらだけを実行してください。"}, {"type": "subtitle", "time": 12916.79, "timestamp": "03:35:16", "text": "精神を働かないでください"}, {"type": "subtitle", "time": 12919.229, "timestamp": "03:35:19", "text": "守護者。それはまるで、私たちがそれらをやらなければならないかのようです"}, {"type": "subtitle", "time": 12935.59, "timestamp": "03:35:35", "text": "作業台を作る。"}, {"type": "subtitle", "time": 12943.11, "timestamp": "03:35:43", "text": "ビルドMODですよね？"}, {"type": "subtitle", "time": 12945.83, "timestamp": "03:35:45", "text": "うん。"}, {"type": "subtitle", "time": 12950.309, "timestamp": "03:35:50", "text": "何をどうやって入手するのか？"}, {"type": "subtitle", "time": 12952.87, "timestamp": "03:35:52", "text": "ああ、Kを押してください。"}, {"type": "subtitle", "time": 12956.389, "timestamp": "03:35:56", "text": "知識とかそういうものですね。プレス。わかった。"}, {"type": "subtitle", "time": 12957.91, "timestamp": "03:35:57", "text": "そして今、あなたが何をしたかを見ることができます"}]
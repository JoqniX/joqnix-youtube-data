[{"type": "subtitle", "time": 20807.35, "timestamp": "05:46:47", "text": "くそったれ犬め。えっと、あなたはまだ"}, {"type": "subtitle", "time": 20810.39, "timestamp": "05:46:50", "text": "ゲーム？いいえ、辞めます。ああ、あの小川"}, {"type": "subtitle", "time": 20812.548, "timestamp": "05:46:52", "text": "昨日は、ああ、ストリームは"}, {"type": "subtitle", "time": 20815.35, "timestamp": "05:46:55", "text": "大幅に遅延しました。"}, {"type": "subtitle", "time": 20817.39, "timestamp": "05:46:57", "text": "なぜ遅れているのですか？どうしてそんなことがあり得るのか"}]
[{"type": "subtitle", "time": 11162.71, "timestamp": "03:06:02", "text": "「ポケットが重い」と書いてある。"}, {"type": "subtitle", "time": 11165.23, "timestamp": "03:06:05", "text": "そうそう。おそらく製作する必要がある"}, {"type": "subtitle", "time": 11169.11, "timestamp": "03:06:09", "text": "一瞬でバスケットにボールを入れた。クラフトする"}, {"type": "subtitle", "time": 11171.79, "timestamp": "03:06:11", "text": "石切り機。石とは何か"}, {"type": "subtitle", "time": 11179.269, "timestamp": "03:06:19", "text": "ああ、そうだね。私たちもこれらをやらなければならない"}, {"type": "subtitle", "time": 11187.91, "timestamp": "03:06:27", "text": "ああ、とにかく、もっともっと"}, {"type": "subtitle", "time": 11204.469, "timestamp": "03:06:44", "text": "ああ、目の前に敵がいる。なるほど。"}, {"type": "subtitle", "time": 11207.349, "timestamp": "03:06:47", "text": "スープを取って。ところで、私が入れたジャムは"}, {"type": "subtitle", "time": 11209.55, "timestamp": "03:06:49", "text": "の"}, {"type": "subtitle", "time": 11212.71, "timestamp": "03:06:52", "text": "できる。マナを得るためにこれらの豆を殺します"}]
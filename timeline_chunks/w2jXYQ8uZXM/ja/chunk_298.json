[{"type": "subtitle", "time": 17881.43, "timestamp": "04:58:01", "text": "パッチキット。パッチキット。"}, {"type": "subtitle", "time": 17888.868, "timestamp": "04:58:08", "text": "ここ。与えた。"}, {"type": "subtitle", "time": 17891.35, "timestamp": "04:58:11", "text": "よし、みんなに作ってあげるよ"}, {"type": "subtitle", "time": 17894.47, "timestamp": "04:58:14", "text": "今度は防具のパーツです。待って、レベルは"}, {"type": "subtitle", "time": 17896.55, "timestamp": "04:58:16", "text": "今のあなたですか？"}, {"type": "subtitle", "time": 17898.83, "timestamp": "04:58:18", "text": "私"}, {"type": "subtitle", "time": 17906.07, "timestamp": "04:58:26", "text": "ああ、私は8番目です。"}, {"type": "subtitle", "time": 17907.67, "timestamp": "04:58:27", "text": "それはすばらしい。だって私はそういうのが好きじゃないから"}, {"type": "subtitle", "time": 17910.11, "timestamp": "04:58:30", "text": "やるべきこと。八。"}, {"type": "subtitle", "time": 17913.27, "timestamp": "04:58:33", "text": "どうやって？つまり、私は冒険に出かけ、"}, {"type": "subtitle", "time": 17915.83, "timestamp": "04:58:35", "text": "もの。わかった、行くよ。いいえ、それはまるで"}, {"type": "subtitle", "time": 17918.47, "timestamp": "04:58:38", "text": "木を切り倒すのも好きだね、"}, {"type": "subtitle", "time": 17920.23, "timestamp": "04:58:40", "text": "グラインディングによってレベルアップすることもできます"}, {"type": "subtitle", "time": 17922.47, "timestamp": "04:58:42", "text": "それ。"}, {"type": "subtitle", "time": 17929.91, "timestamp": "04:58:49", "text": "ああ、それは素晴らしい経験ですね。良い。わかった、"}, {"type": "subtitle", "time": 17931.15, "timestamp": "04:58:51", "text": "手に入れよう"}, {"type": "subtitle", "time": 17933.59, "timestamp": "04:58:53", "text": "ボス。そうそう。時計。少し必要です"}]
[{"type": "subtitle", "time": 11230.03, "timestamp": "03:07:10", "text": "収納バスケット"}, {"type": "subtitle", "time": 11233.11, "timestamp": "03:07:13", "text": "また？メニューを作成する。どこ？何ですか"}, {"type": "subtitle", "time": 11235.03, "timestamp": "03:07:15", "text": "それ？"}, {"type": "subtitle", "time": 11237.99, "timestamp": "03:07:17", "text": "何？"}, {"type": "subtitle", "time": 11242.469, "timestamp": "03:07:22", "text": "収納バスケットの作り方を教えてください。えっと、"}, {"type": "subtitle", "time": 11245.75, "timestamp": "03:07:25", "text": "レベルを3つ上げましたか？"}, {"type": "subtitle", "time": 11249.67, "timestamp": "03:07:29", "text": "うん、あのレシピのロックを解除したよ。"}, {"type": "subtitle", "time": 11251.75, "timestamp": "03:07:31", "text": "わかった。あなたには、"}, {"type": "subtitle", "time": 11253.19, "timestamp": "03:07:33", "text": "作品を見ればわかります。私たちはできる"}, {"type": "subtitle", "time": 11256.389, "timestamp": "03:07:36", "text": "作業台の上か、Bを押してください。"}, {"type": "subtitle", "time": 11259.03, "timestamp": "03:07:39", "text": "それを"}, {"type": "subtitle", "time": 11264.23, "timestamp": "03:07:44", "text": "構築中。ええ、構築中です"}, {"type": "subtitle", "time": 11271.429, "timestamp": "03:07:51", "text": "そして1。ああ、もう遅すぎる。"}, {"type": "subtitle", "time": 11274.469, "timestamp": "03:07:54", "text": "プレイ場所を下へ移動すれば、"}]
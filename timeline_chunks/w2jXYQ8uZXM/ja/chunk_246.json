[{"type": "subtitle", "time": 14760.07, "timestamp": "04:06:00", "text": "しまった、これは間違った方向だ。私はただ"}, {"type": "subtitle", "time": 14763.11, "timestamp": "04:06:03", "text": "君たちをスタート地点に連れてきたんだ。ああ、くそ。"}, {"type": "subtitle", "time": 14765.91, "timestamp": "04:06:05", "text": "ここから飛び降りないでください。繰り返しますが、"}, {"type": "subtitle", "time": 14768.07, "timestamp": "04:06:08", "text": "飛び降りないでください。"}, {"type": "subtitle", "time": 14770.469, "timestamp": "04:06:10", "text": "それは"}, {"type": "subtitle", "time": 14772.389, "timestamp": "04:06:12", "text": "ええ、私は「うわあ、これはすごい」と思いました。"}, {"type": "subtitle", "time": 14776.07, "timestamp": "04:06:16", "text": "「馴染みのある。」そしてそれは私のbeunだった。"}, {"type": "subtitle", "time": 14778.389, "timestamp": "04:06:18", "text": "注意深い。"}, {"type": "subtitle", "time": 14784.389, "timestamp": "04:06:24", "text": "手段。うん、ちょっと待ってて"}, {"type": "subtitle", "time": 14794.15, "timestamp": "04:06:34", "text": "また、配信も完全に追いつきました。"}, {"type": "subtitle", "time": 14797.03, "timestamp": "04:06:37", "text": "何？ああ、それはいいですね。私は死んだ。あなた"}, {"type": "subtitle", "time": 14800.95, "timestamp": "04:06:40", "text": "死ななかった。ああ、あなたは亡くなったのですね。だから、もしあなたが"}, {"type": "subtitle", "time": 14804.07, "timestamp": "04:06:44", "text": "死んだら、どこで復活するの？"}, {"type": "subtitle", "time": 14807.83, "timestamp": "04:06:47", "text": "ええ、寝た場所に戻ってきました。"}, {"type": "subtitle", "time": 14810.71, "timestamp": "04:06:50", "text": "おお。持ち物を紛失しましたか？"}, {"type": "subtitle", "time": 14819.71, "timestamp": "04:06:59", "text": "おお。ああ、どこかにたどり着いた。"}]
[{"type": "subtitle", "time": 10388.63, "timestamp": "02:53:08", "text": "忘れた。さて、ゲームがうまくいくことを願っています"}, {"type": "subtitle", "time": 10391.429, "timestamp": "02:53:11", "text": "あなたの終わりです。フレームみたいな感じだったから"}, {"type": "subtitle", "time": 10394.07, "timestamp": "02:53:14", "text": "私の側で接続が切れています。"}, {"type": "subtitle", "time": 10397.15, "timestamp": "02:53:17", "text": "うん。うん。私は自分の"}, {"type": "subtitle", "time": 10399.99, "timestamp": "02:53:19", "text": "終わり。彼も私に確認するように言ったので、"}, {"type": "subtitle", "time": 10402.309, "timestamp": "02:53:22", "text": "昨日、そのことを忘れていました。できたかもしれない"}, {"type": "subtitle", "time": 10403.95, "timestamp": "02:53:23", "text": "確認済み。神"}, {"type": "subtitle", "time": 10406.71, "timestamp": "02:53:26", "text": "くそ。まあ、彼はそれを忘れていた"}, {"type": "subtitle", "time": 10411.13, "timestamp": "02:53:31", "text": "驚き。それが理由です。"}, {"type": "subtitle", "time": 10412.83, "timestamp": "02:53:32", "text": "[音楽]"}, {"type": "subtitle", "time": 10416.63, "timestamp": "02:53:36", "text": "うん。まあまあ、ジョー、大丈夫だよ。良い"}, {"type": "subtitle", "time": 10419.429, "timestamp": "02:53:39", "text": "うまくいくかどうか見てみましょう。もしそうでないなら"}, {"type": "subtitle", "time": 10422.03, "timestamp": "02:53:42", "text": "あなたに怒鳴りつけます。それが"}, {"type": "subtitle", "time": 10425.91, "timestamp": "02:53:45", "text": "おお。何？えっと、たぶん"}, {"type": "subtitle", "time": 10430.55, "timestamp": "02:53:50", "text": "ストリーミング配信であって、あなたに怒鳴りつけるものではありません。"}, {"type": "subtitle", "time": 10435.79, "timestamp": "02:53:55", "text": "うん。うん。どれでも配信します。そして、そうする"}, {"type": "subtitle", "time": 10439.03, "timestamp": "02:53:59", "text": "私たちは何をしているのか、それともあなたは"}]
[{"type": "subtitle", "time": 16152.99, "timestamp": "04:29:12", "text": "おお"}, {"type": "subtitle", "time": 16155.67, "timestamp": "04:29:15", "text": "神。ああ、神様。それと、あなたはどこにいるのですか？おお、"}, {"type": "subtitle", "time": 16157.91, "timestamp": "04:29:17", "text": "君たちが作った"}, {"type": "subtitle", "time": 16159.91, "timestamp": "04:29:19", "text": "君たちはあっという間にやったね。何が"}, {"type": "subtitle", "time": 16161.75, "timestamp": "04:29:21", "text": "これ？このプラットフォーム戦略は何なんだ？あなた"}, {"type": "subtitle", "time": 16166.229, "timestamp": "04:29:26", "text": "何か持って行きたい？はい、承知いたしました。"}, {"type": "subtitle", "time": 16168.87, "timestamp": "04:29:28", "text": "君たちは最高だよ。ええ、私たちは"}, {"type": "subtitle", "time": 16170.79, "timestamp": "04:29:30", "text": "同じ場所。私はそうは思わない、そうならないことを願う"}, {"type": "subtitle", "time": 16172.71, "timestamp": "04:29:32", "text": "再び死ぬ。"}, {"type": "subtitle", "time": 16175.11, "timestamp": "04:29:35", "text": "よし、すごく長い階段を作ってるんだ"}, {"type": "subtitle", "time": 16178.55, "timestamp": "04:29:38", "text": "私たちがそこを制覇するまで。"}]
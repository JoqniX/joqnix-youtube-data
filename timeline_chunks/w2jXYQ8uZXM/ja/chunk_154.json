[{"type": "subtitle", "time": 9245.83, "timestamp": "02:34:05", "text": "待って、スマホを使いたかったんだけど、"}, {"type": "subtitle", "time": 9249.19, "timestamp": "02:34:09", "text": "残念ながら私の携帯電話は"}, {"type": "subtitle", "time": 9259.63, "timestamp": "02:34:19", "text": "そこには。待っています"}, {"type": "subtitle", "time": 9264.19, "timestamp": "02:34:24", "text": "繋がり。接続できません"}, {"type": "subtitle", "time": 9267.59, "timestamp": "02:34:27", "text": "そこには。ああ、Macは好きになれなかった。その"}, {"type": "subtitle", "time": 9271.75, "timestamp": "02:34:31", "text": "わかった。さて、試合に集中しましょう。"}, {"type": "subtitle", "time": 9275.19, "timestamp": "02:34:35", "text": "さあ行こう。さあ行こう。さあ行こう。さあ行こう。"}, {"type": "subtitle", "time": 9279.429, "timestamp": "02:34:39", "text": "音声が聞こえたら教えてください。わかった。えっと、"}, {"type": "subtitle", "time": 9282.07, "timestamp": "02:34:42", "text": "あの、最近は断捨離をしてるんだ"}, {"type": "subtitle", "time": 9285.309, "timestamp": "02:34:45", "text": "私のフォロワー。"}, {"type": "subtitle", "time": 9289.389, "timestamp": "02:34:49", "text": "実際にフォロワーに投稿しています"}, {"type": "subtitle", "time": 9291.71, "timestamp": "02:34:51", "text": "インスタグラム、グラム"}, {"type": "subtitle", "time": 9293.469, "timestamp": "02:34:53", "text": "場所"}, {"type": "subtitle", "time": 9297.469, "timestamp": "02:34:57", "text": "だから、ずっとやりたかったんです"}]
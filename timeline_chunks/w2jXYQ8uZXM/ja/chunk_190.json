[{"type": "subtitle", "time": 11400.71, "timestamp": "03:10:00", "text": "しかし、繊維が不足している。もっと手に入れる"}, {"type": "subtitle", "time": 11402.79, "timestamp": "03:10:02", "text": "特に理由はない。"}, {"type": "subtitle", "time": 11405.429, "timestamp": "03:10:05", "text": "何の理由もなく。いくつか作ってみよう"}, {"type": "subtitle", "time": 11408.95, "timestamp": "03:10:08", "text": "槍で魚を捕まえるよ。"}, {"type": "subtitle", "time": 11410.79, "timestamp": "03:10:10", "text": "よし。"}, {"type": "subtitle", "time": 11412.55, "timestamp": "03:10:12", "text": "よし、これで槍を手に入れたぞ。私は行く"}, {"type": "subtitle", "time": 11424.389, "timestamp": "03:10:24", "text": "やったー。ここに置いてください。これです。これ"}, {"type": "subtitle", "time": 11430.71, "timestamp": "03:10:30", "text": "そうそう。昨日、私たちは"}, {"type": "subtitle", "time": 11432.87, "timestamp": "03:10:32", "text": "まるで初めてプレイするかのように、"}, {"type": "subtitle", "time": 11435.99, "timestamp": "03:10:35", "text": "右？ゲームをプレイする。だから、思い出した"}, {"type": "subtitle", "time": 11438.95, "timestamp": "03:10:38", "text": "私が書いていた物語の私にとってそれは"}, {"type": "subtitle", "time": 11441.269, "timestamp": "03:10:41", "text": "物語はこのような島で始まった"}, {"type": "subtitle", "time": 11443.03, "timestamp": "03:10:43", "text": "良い。"}, {"type": "subtitle", "time": 11445.19, "timestamp": "03:10:45", "text": "おお、"}, {"type": "subtitle", "time": 11448.15, "timestamp": "03:10:48", "text": "うん。"}, {"type": "subtitle", "time": 11450.07, "timestamp": "03:10:50", "text": "ねえ、一体何の話だったの？何が"}, {"type": "subtitle", "time": 11451.91, "timestamp": "03:10:51", "text": "それは何についてですか？それは、そうあるべきだ"}, {"type": "subtitle", "time": 11454.95, "timestamp": "03:10:54", "text": "ファンタジー。実際に一度書いたことがある"}, {"type": "subtitle", "time": 11458.07, "timestamp": "03:10:58", "text": "40ページか50ページくらいかなと思ったんだけど、"}]
[{"type": "subtitle", "time": 16920.788, "timestamp": "04:42:00", "text": "それで３回くらい。あ、待って。それ"}, {"type": "subtitle", "time": 16923.83, "timestamp": "04:42:03", "text": "ここにはいません。 「私と一緒に来て」はどこにいるの？"}, {"type": "subtitle", "time": 16927.03, "timestamp": "04:42:07", "text": "私と来て。わかった。ちょっと待ってください。"}, {"type": "subtitle", "time": 16929.43, "timestamp": "04:42:09", "text": "これは非常に危険です。私に作らせてください"}, {"type": "subtitle", "time": 16932.39, "timestamp": "04:42:12", "text": "実際にはプラットフォームです。"}, {"type": "subtitle", "time": 16934.39, "timestamp": "04:42:14", "text": "あなたのものが下に見えると思います"}, {"type": "subtitle", "time": 16937.19, "timestamp": "04:42:17", "text": "そこには。"}, {"type": "subtitle", "time": 16938.628, "timestamp": "04:42:18", "text": "そうそう。はい、あなたの荷物はあちらです"}, {"type": "subtitle", "time": 16942.39, "timestamp": "04:42:22", "text": "そこには。こちらで。こちらで。わかった。"}, {"type": "subtitle", "time": 16945.99, "timestamp": "04:42:25", "text": "途中で。木材を組み立てることはできますか"}, {"type": "subtitle", "time": 16948.31, "timestamp": "04:42:28", "text": "私が作った2plの小型プラットフォームのことですか？"}, {"type": "subtitle", "time": 16950.15, "timestamp": "04:42:30", "text": "わかった。同じように構築する必要があります"}, {"type": "subtitle", "time": 16952.39, "timestamp": "04:42:32", "text": "プラットフォームはこちらです。ところで、私は"}, {"type": "subtitle", "time": 16954.47, "timestamp": "04:42:34", "text": "ない。折り目の下のようなものです。"}, {"type": "subtitle", "time": 16957.15, "timestamp": "04:42:37", "text": "折り目の下に。私は思う"}, {"type": "subtitle", "time": 16967.27, "timestamp": "04:42:47", "text": "木材。わかった。どうすればいいですか？どこ"}, {"type": "subtitle", "time": 16970.708, "timestamp": "04:42:50", "text": "それ？ここに来て。私と来て。まず"}]
[{"type": "subtitle", "time": 18660.83, "timestamp": "05:11:00", "text": "いいえ"}, {"type": "subtitle", "time": 18667.628, "timestamp": "05:11:07", "text": "木を切り倒して"}, {"type": "subtitle", "time": 18687.91, "timestamp": "05:11:27", "text": "わかった。 2点あります。水やりをしたいですか、"}, {"type": "subtitle", "time": 18689.27, "timestamp": "05:11:29", "text": "底辺から抜け出さないと、"}, {"type": "subtitle", "time": 18691.27, "timestamp": "05:11:31", "text": "最初からやり直すつもりですか？さあ行こう"}, {"type": "subtitle", "time": 18693.11, "timestamp": "05:11:33", "text": "下から。"}, {"type": "subtitle", "time": 18695.43, "timestamp": "05:11:35", "text": "わかった。わかった。わかった。"}, {"type": "subtitle", "time": 18699.19, "timestamp": "05:11:39", "text": "あなたはそこから来ることができます。トップとゲット"}, {"type": "subtitle", "time": 18702.31, "timestamp": "05:11:42", "text": "宝箱があれば、それ。なんてこった。オン"}, {"type": "subtitle", "time": 18703.67, "timestamp": "05:11:43", "text": "一番上はボス戦です。一番下"}, {"type": "subtitle", "time": 18705.03, "timestamp": "05:11:45", "text": "確か宝箱があったはずだ"}, {"type": "subtitle", "time": 18706.39, "timestamp": "05:11:46", "text": "その通りです。"}, {"type": "subtitle", "time": 18710.43, "timestamp": "05:11:50", "text": "あなたは以前にもこのゲームをプレイしたことがあるのですか？"}]
[{"type": "subtitle", "time": 10261.429, "timestamp": "02:51:01", "text": "昨日？"}, {"type": "subtitle", "time": 10264.309, "timestamp": "02:51:04", "text": "ええ、できますよ。"}, {"type": "subtitle", "time": 10266.87, "timestamp": "02:51:06", "text": "ああ、そうだね。マーベルを開けようとしてたから"}, {"type": "subtitle", "time": 10268.63, "timestamp": "02:51:08", "text": "ライバルはすぐに現れるけど、私はこう思った、"}, {"type": "subtitle", "time": 10272.55, "timestamp": "02:51:12", "text": "ちょっと待って、アラスが来る。"}, {"type": "subtitle", "time": 10276.469, "timestamp": "02:51:16", "text": "うん。それで、何が起こったのか"}, {"type": "subtitle", "time": 10279.269, "timestamp": "02:51:19", "text": "「私はそれをプレイします」に何が起こったのか。私は"}, {"type": "subtitle", "time": 10282.389, "timestamp": "02:51:22", "text": "色々なことに気を取られている。そして私は参加しました"}, {"type": "subtitle", "time": 10285.19, "timestamp": "02:51:25", "text": "ストリームとこの男はまさに"}, {"type": "subtitle", "time": 10287.269, "timestamp": "02:51:27", "text": "コードをいくつか入力しています。これは"}, {"type": "subtitle", "time": 10289.99, "timestamp": "02:51:29", "text": "え？これは新しいイベントですか？カットしなければならない"}, {"type": "subtitle", "time": 10294.23, "timestamp": "02:51:34", "text": "コード。いいえ、これは新しい"}, {"type": "subtitle", "time": 10296.63, "timestamp": "02:51:36", "text": "午後に配信します。ない"}, {"type": "subtitle", "time": 10298.87, "timestamp": "02:51:38", "text": "午後。早くやりたかったのですが、"}, {"type": "subtitle", "time": 10302.389, "timestamp": "02:51:42", "text": "私は今日は早く起きたけど、今は遅く起きた。だから、私は思うんだけど"}, {"type": "subtitle", "time": 10305.91, "timestamp": "02:51:45", "text": "夜か何かでやります。"}, {"type": "subtitle", "time": 10315.19, "timestamp": "02:51:55", "text": "コラボのクリックベイト。クリックベイト。"}, {"type": "subtitle", "time": 10317.349, "timestamp": "02:51:57", "text": "待って、今日は"}]
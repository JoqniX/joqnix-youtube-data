[{"type": "subtitle", "time": 6791.95, "timestamp": "01:53:11", "text": "いくつかやりたい"}, {"type": "subtitle", "time": 6801.629, "timestamp": "01:53:21", "text": "えっと、なぜキラキラ光るけど、恐れてないの？"}, {"type": "subtitle", "time": 6803.91, "timestamp": "01:53:23", "text": "理解？私は理解したと思います"}, {"type": "subtitle", "time": 6806.43, "timestamp": "01:53:26", "text": "文。 H それは"}, {"type": "subtitle", "time": 6809.91, "timestamp": "01:53:29", "text": "わかった。心配ない。怖がらないで。感じる"}, {"type": "subtitle", "time": 6811.87, "timestamp": "01:53:31", "text": "無料"}, {"type": "subtitle", "time": 6814.03, "timestamp": "01:53:34", "text": "話す。しないで"}, {"type": "subtitle", "time": 6816.39, "timestamp": "01:53:36", "text": "恐れている。怖がらないで。必要ない"}]
[{"type": "subtitle", "time": 11049.99, "timestamp": "03:04:09", "text": "図１。このゲームはもっと"}, {"type": "subtitle", "time": 11051.63, "timestamp": "03:04:11", "text": "平和的に。"}, {"type": "subtitle", "time": 11054.07, "timestamp": "03:04:14", "text": "うん。モンスターの心配は無用です"}, {"type": "subtitle", "time": 11055.389, "timestamp": "03:04:15", "text": "すべての"}, {"type": "subtitle", "time": 11066.79, "timestamp": "03:04:26", "text": "ああ、手の中に入りたい。また、私たちは"}, {"type": "subtitle", "time": 11068.07, "timestamp": "03:04:28", "text": "卵を見つけなければならない。あのね？"}, {"type": "subtitle", "time": 11070.15, "timestamp": "03:04:30", "text": "質問にある卵を手に入れましょう"}, {"type": "subtitle", "time": 11072.95, "timestamp": "03:04:32", "text": "仕事が好きになった後の点数。今すぐ、"}, {"type": "subtitle", "time": 11076.309, "timestamp": "03:04:36", "text": "私たちはただひたすら努力するだけです。よし。"}, {"type": "subtitle", "time": 11087.309, "timestamp": "03:04:47", "text": "お腹の空き具合はどうですか？"}, {"type": "subtitle", "time": 11091.03, "timestamp": "03:04:51", "text": "半分を少し超えるくらいです。"}, {"type": "subtitle", "time": 11093.11, "timestamp": "03:04:53", "text": "うん、焚き火をして、"}, {"type": "subtitle", "time": 11094.87, "timestamp": "03:04:54", "text": "スープ。"}]
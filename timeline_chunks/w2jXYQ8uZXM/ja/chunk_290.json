[{"type": "subtitle", "time": 17400.19, "timestamp": "04:50:00", "text": "骨の爪を手に入れる？ディープリング"}, {"type": "subtitle", "time": 17405.43, "timestamp": "04:50:05", "text": "ネイルクリーチャー。アドリーパワー。わかった。"}, {"type": "subtitle", "time": 17408.11, "timestamp": "04:50:08", "text": "石の矢"}, {"type": "subtitle", "time": 17410.868, "timestamp": "04:50:10", "text": "火。ああ、無限の矢印を持つことができるよ。"}, {"type": "subtitle", "time": 17413.27, "timestamp": "04:50:13", "text": "おお、"}, {"type": "subtitle", "time": 17414.948, "timestamp": "04:50:14", "text": "知っている。グロウストーンは欲しいですか？誰でも"}, {"type": "subtitle", "time": 17418.15, "timestamp": "04:50:18", "text": "グロウストーンの矢が欲しいですか？ええ、必要"}, {"type": "subtitle", "time": 17425.91, "timestamp": "04:50:25", "text": "私は持っていません"}, {"type": "subtitle", "time": 17427.75, "timestamp": "04:50:27", "text": "私は持っている"}, {"type": "subtitle", "time": 17431.43, "timestamp": "04:50:31", "text": "はい、1つあります。200個あります。"}, {"type": "subtitle", "time": 17434.07, "timestamp": "04:50:34", "text": "矢の束が3つ、7つ。私は"}, {"type": "subtitle", "time": 17437.51, "timestamp": "04:50:37", "text": "今は弓使いの男だ。"}, {"type": "subtitle", "time": 17441.67, "timestamp": "04:50:41", "text": "ちなみに、光る石のことです。ああ、ありがとう。"}, {"type": "subtitle", "time": 17455.43, "timestamp": "04:50:55", "text": "では、これまでのデータはどこに置けばいいのでしょうか？えっと、どこで"}, {"type": "subtitle", "time": 17456.43, "timestamp": "04:50:56", "text": "私は"}]
[{"type": "subtitle", "time": 9554.94, "timestamp": "02:39:14", "text": "ラップトップ？ここは満員です。"}, {"type": "subtitle", "time": 9572.19, "timestamp": "02:39:32", "text": "[音楽]"}, {"type": "subtitle", "time": 9574.95, "timestamp": "02:39:34", "text": "H. ああ、ここでやるはずだったのに。"}, {"type": "subtitle", "time": 9578.58, "timestamp": "02:39:38", "text": "では、これを置きましょう。"}, {"type": "subtitle", "time": 9582.27, "timestamp": "02:39:42", "text": "[音楽]"}, {"type": "subtitle", "time": 9585.23, "timestamp": "02:39:45", "text": "ええ、私たちは"}, {"type": "subtitle", "time": 9589.26, "timestamp": "02:39:49", "text": "下着を下に着る。おお"}, {"type": "subtitle", "time": 9594.59, "timestamp": "02:39:54", "text": "[音楽]"}, {"type": "subtitle", "time": 9597.349, "timestamp": "02:39:57", "text": "ええ、それは手配できません。何てことだ、"}, {"type": "subtitle", "time": 9599.79, "timestamp": "02:39:59", "text": "横向きになっています。"}]
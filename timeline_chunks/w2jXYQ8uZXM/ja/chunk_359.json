[{"type": "subtitle", "time": 21540.59, "timestamp": "05:59:00", "text": "うん。本当に？わかった。わかった。私は読む"}, {"type": "subtitle", "time": 21542.948, "timestamp": "05:59:02", "text": "それ。それを読みました。あなたが"}, {"type": "subtitle", "time": 21546.05, "timestamp": "05:59:06", "text": "まだここにいるけど、そうだね。"}, {"type": "subtitle", "time": 21571.19, "timestamp": "05:59:31", "text": "はい、階下へ降りて"}, {"type": "subtitle", "time": 21574.548, "timestamp": "05:59:34", "text": "私は戻ってきます。板を置きます。どうやって"}, {"type": "subtitle", "time": 21594.51, "timestamp": "05:59:54", "text": "私たちはとても遠く離れてしまった。"}, {"type": "subtitle", "time": 21597.67, "timestamp": "05:59:57", "text": "655。まだ710分あります。"}]
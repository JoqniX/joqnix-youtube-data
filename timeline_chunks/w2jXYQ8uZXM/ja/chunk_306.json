[{"type": "subtitle", "time": 18360.31, "timestamp": "05:06:00", "text": "もっとそういうのを。私は食物繊維を少し摂取しています。私"}, {"type": "subtitle", "time": 18363.19, "timestamp": "05:06:03", "text": "ここで考えてみてください。 6人。レゴのやつ。"}, {"type": "subtitle", "time": 18365.19, "timestamp": "05:06:05", "text": "古代の人々はどこで眠っているのだろうか？それは"}, {"type": "subtitle", "time": 18370.31, "timestamp": "05:06:10", "text": "戦い？何？"}, {"type": "subtitle", "time": 18372.55, "timestamp": "05:06:12", "text": "古代の休息。"}, {"type": "subtitle", "time": 18375.35, "timestamp": "05:06:15", "text": "うん。"}, {"type": "subtitle", "time": 18380.628, "timestamp": "05:06:20", "text": "そして私はOKを受け取ります。"}, {"type": "subtitle", "time": 18382.628, "timestamp": "05:06:22", "text": "ああ、君か。彼はなぜあそこにいるのですか？私はただ"}, {"type": "subtitle", "time": 18384.708, "timestamp": "05:06:24", "text": "彼に新しい胸部パーツを取り付けた。待って、"}, {"type": "subtitle", "time": 18387.59, "timestamp": "05:06:27", "text": "待って、待ってて。今行ってる。ああ、私は"}, {"type": "subtitle", "time": 18396.708, "timestamp": "05:06:36", "text": "うん。ともかく。うん、ソロでやるよ。"}, {"type": "subtitle", "time": 18401.43, "timestamp": "05:06:41", "text": "あなたはデュオでもソロでも死んでしまった。えっと、それで"}, {"type": "subtitle", "time": 18405.55, "timestamp": "05:06:45", "text": "はい、どうぞ。ありがとう。そして、"}, {"type": "subtitle", "time": 18408.23, "timestamp": "05:06:48", "text": "これ。必要ない、必要ない、必要ない"}, {"type": "subtitle", "time": 18409.75, "timestamp": "05:06:49", "text": "弓を持っているので、それは必要ない"}, {"type": "subtitle", "time": 18416.47, "timestamp": "05:06:56", "text": "つまり、私はこれらのゲームをたくさんプレイしているので、"}, {"type": "subtitle", "time": 18419.51, "timestamp": "05:06:59", "text": "以前は、鎧を使っていました。"}]
[{"type": "subtitle", "time": 11580.71, "timestamp": "03:13:00", "text": "研削。とにかく、私は行くわ"}, {"type": "subtitle", "time": 11589.71, "timestamp": "03:13:09", "text": "右。ちくしょう。何が"}, {"type": "subtitle", "time": 11592.309, "timestamp": "03:13:12", "text": "それ？ああ、アサリ。"}, {"type": "subtitle", "time": 11607.229, "timestamp": "03:13:27", "text": "そう、寝袋を作って"}, {"type": "subtitle", "time": 11611.91, "timestamp": "03:13:31", "text": "もの。ええ、寝るための寝袋がいくつか。"}, {"type": "subtitle", "time": 11618.71, "timestamp": "03:13:38", "text": "ああ、海藻を取ると、あなたの"}, {"type": "subtitle", "time": 11626.469, "timestamp": "03:13:46", "text": "理由がわからない。それは"}, {"type": "subtitle", "time": 11627.79, "timestamp": "03:13:47", "text": "グリッチまたは"}, {"type": "subtitle", "time": 11630.15, "timestamp": "03:13:50", "text": "何か。ああ、あの大きなやつが見える"}, {"type": "subtitle", "time": 11637.63, "timestamp": "03:13:57", "text": "彼。来る"}]
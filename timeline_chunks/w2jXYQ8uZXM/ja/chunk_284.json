[{"type": "subtitle", "time": 17077.11, "timestamp": "04:44:37", "text": "ポケットが重く感じる？何てことだ。私"}, {"type": "subtitle", "time": 17079.83, "timestamp": "04:44:39", "text": "荷物を持って行けません。その"}, {"type": "subtitle", "time": 17082.27, "timestamp": "04:44:42", "text": "重すぎる。わかった、気にしないで。私は手に入れた"}, {"type": "subtitle", "time": 17085.91, "timestamp": "04:44:45", "text": "それ。一体私は何に巻き込まれてしまったんだ？おお"}, {"type": "subtitle", "time": 17087.83, "timestamp": "04:44:47", "text": "私の"}, {"type": "subtitle", "time": 17089.43, "timestamp": "04:44:49", "text": "走って行き詰まったら、"}, {"type": "subtitle", "time": 17091.83, "timestamp": "04:44:51", "text": "立ち往生。いや、いや、いや、いや、いや。のように"}]
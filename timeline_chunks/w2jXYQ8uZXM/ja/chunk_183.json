[{"type": "subtitle", "time": 10980.23, "timestamp": "03:03:00", "text": "石は見つかりませんでした。持っていますか"}, {"type": "subtitle", "time": 10982.11, "timestamp": "03:03:02", "text": "どんな石でも？"}, {"type": "subtitle", "time": 10984.03, "timestamp": "03:03:04", "text": "私は私に"}, {"type": "subtitle", "time": 10987.23, "timestamp": "03:03:07", "text": "見る。私は3つ持っています。これ"}, {"type": "subtitle", "time": 10991.03, "timestamp": "03:03:11", "text": "えっと、たぶん私はいくつか手に入れる"}, {"type": "subtitle", "time": 10992.87, "timestamp": "03:03:12", "text": "石。石を全部くれ。私はできる"}, {"type": "subtitle", "time": 10998.99, "timestamp": "03:03:18", "text": "落とすような感じ。私はあなたの目の前にいます、"}, {"type": "chat", "time": 11007.038, "timestamp": "03:03:27", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "peak"}, {"type": "subtitle", "time": 11007.07, "timestamp": "03:03:27", "text": "はい、ありがとうございます"}, {"type": "subtitle", "time": 11011.309, "timestamp": "03:03:31", "text": "あなた。私は本物のつるはしを作ります"}, {"type": "subtitle", "time": 11014.23, "timestamp": "03:03:34", "text": "素早く"}, {"type": "subtitle", "time": 11016.79, "timestamp": "03:03:36", "text": "木を何本か切り倒す。ところで、"}, {"type": "subtitle", "time": 11019.59, "timestamp": "03:03:39", "text": "えっと、木を切り倒しているんです。"}, {"type": "subtitle", "time": 11022.07, "timestamp": "03:03:42", "text": "私たちは精神的な支えを作ることができます。私は行きます"}, {"type": "subtitle", "time": 11023.07, "timestamp": "03:03:43", "text": "作るために"}, {"type": "subtitle", "time": 11024.99, "timestamp": "03:03:44", "text": "焚き火、いくつか"}, {"type": "subtitle", "time": 11026.99, "timestamp": "03:03:46", "text": "鎧、"}, {"type": "subtitle", "time": 11035.91, "timestamp": "03:03:55", "text": "レベルアップもする。私は、"}]
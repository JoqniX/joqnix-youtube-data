[{"type": "subtitle", "time": 21780.15, "timestamp": "06:03:00", "text": "右？そして私はそれを届けなかったのは、えーと"}, {"type": "subtitle", "time": 21782.39, "timestamp": "06:03:02", "text": "そこではたくさんのことが起こっている"}, {"type": "subtitle", "time": 21803.83, "timestamp": "06:03:23", "text": "皆さんの土曜日の夜はいかがですか？"}, {"type": "subtitle", "time": 21807.43, "timestamp": "06:03:27", "text": "続いていますか？まるで土曜日のようだ"}, {"type": "subtitle", "time": 21810.31, "timestamp": "06:03:30", "text": "夕方。土曜日、土曜日ではなく日曜日"}, {"type": "subtitle", "time": 21812.27, "timestamp": "06:03:32", "text": "夕方。日曜日"}, {"type": "subtitle", "time": 21816.31, "timestamp": "06:03:36", "text": "夜。アメリカにいる人にとっては、えーっと"}, {"type": "subtitle", "time": 21817.708, "timestamp": "06:03:37", "text": "になるだろう"}, {"type": "subtitle", "time": 21819.628, "timestamp": "06:03:39", "text": "日曜日、"}, {"type": "subtitle", "time": 21821.23, "timestamp": "06:03:41", "text": "右？"}, {"type": "subtitle", "time": 21828.07, "timestamp": "06:03:48", "text": "終わり。わかった。待って。少し時間をください。えっと"}, {"type": "subtitle", "time": 21829.47, "timestamp": "06:03:49", "text": "どのように"}, {"type": "subtitle", "time": 21834.07, "timestamp": "06:03:54", "text": "どうすればいいですか？わかりました。このような。私は"}, {"type": "subtitle", "time": 21837.868, "timestamp": "06:03:57", "text": "今日はとても方向感覚を失っている。わからない"}]
[{"type": "subtitle", "time": 16986.788, "timestamp": "04:43:06", "text": "それはどこか上のほうにあった。ああ、見えるかい？"}, {"type": "subtitle", "time": 16990.23, "timestamp": "04:43:10", "text": "ここに来て下を見下ろしてみてください。"}, {"type": "subtitle", "time": 16993.15, "timestamp": "04:43:13", "text": "ただいま。家。"}, {"type": "subtitle", "time": 16996.31, "timestamp": "04:43:16", "text": "ええ、そうですね。うん。そこから飛び降りないでください、"}, {"type": "subtitle", "time": 16999.83, "timestamp": "04:43:19", "text": "ところで。なぜ？"}, {"type": "subtitle", "time": 17003.91, "timestamp": "04:43:23", "text": "お前は死ぬだろう。ああ、そうだね。その"}, {"type": "subtitle", "time": 17010.788, "timestamp": "04:43:30", "text": "ずさんだ。木材はどれくらい必要ですか？わかった。階段、"}, {"type": "subtitle", "time": 17024.19, "timestamp": "04:43:44", "text": "木材。はい、どうぞ、ジョー。もっと"}, {"type": "subtitle", "time": 17026.55, "timestamp": "04:43:46", "text": "木材。あそこに投げ捨てることはできない。あなた"}, {"type": "subtitle", "time": 17029.27, "timestamp": "04:43:49", "text": "ここに来なければならない。ここに木材があります。"}, {"type": "subtitle", "time": 17030.59, "timestamp": "04:43:50", "text": "ところで。取ることができます"}, {"type": "subtitle", "time": 17033.19, "timestamp": "04:43:53", "text": "それ。私は始めたことをやり遂げなければならない。"}, {"type": "subtitle", "time": 17039.58, "timestamp": "04:43:59", "text": "わかった。"}]
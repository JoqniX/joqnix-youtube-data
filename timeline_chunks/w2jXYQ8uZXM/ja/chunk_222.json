[{"type": "subtitle", "time": 13320.95, "timestamp": "03:42:00", "text": "こちらがあなたの弓です。"}, {"type": "subtitle", "time": 13324.469, "timestamp": "03:42:04", "text": "わーい。そして、矢は無限ではない。今あなた"}, {"type": "subtitle", "time": 13328.469, "timestamp": "03:42:08", "text": "作らなければならない。うん。"}, {"type": "subtitle", "time": 13335.99, "timestamp": "03:42:15", "text": "ここで矢を作ることができます。"}, {"type": "subtitle", "time": 13338.229, "timestamp": "03:42:18", "text": "なんでしょう？レシピは何ですか"}, {"type": "subtitle", "time": 13340.51, "timestamp": "03:42:20", "text": "これ？"}, {"type": "subtitle", "time": 13342.389, "timestamp": "03:42:22", "text": "プレス。"}, {"type": "subtitle", "time": 13346.71, "timestamp": "03:42:26", "text": "よし、矢石と木だ。"}, {"type": "subtitle", "time": 13349.67, "timestamp": "03:42:29", "text": "レベルを上げるにはどうすればいいですか？"}, {"type": "subtitle", "time": 13352.07, "timestamp": "03:42:32", "text": "三つ？"}, {"type": "subtitle", "time": 13354.79, "timestamp": "03:42:34", "text": "遊ぼう。ああ、基本を演奏するだけでいい"}, {"type": "subtitle", "time": 13357.51, "timestamp": "03:42:37", "text": "必需品。必需品。"}, {"type": "subtitle", "time": 13360.79, "timestamp": "03:42:40", "text": "石切り機って何ですか？"}, {"type": "subtitle", "time": 13363.269, "timestamp": "03:42:43", "text": "ああ、斧だよ、相棒。オン"}, {"type": "subtitle", "time": 13365.59, "timestamp": "03:42:45", "text": "レシピ。まずロックを解除する必要があります。"}, {"type": "subtitle", "time": 13368.15, "timestamp": "03:42:48", "text": "それなら、手放す必要がある。"}, {"type": "subtitle", "time": 13370.55, "timestamp": "03:42:50", "text": "休眠場所を採取する。切り倒す"}, {"type": "subtitle", "time": 13374.07, "timestamp": "03:42:54", "text": "三つ。それらをボールのように叩きつけろ。"}, {"type": "subtitle", "time": 13376.309, "timestamp": "03:42:56", "text": "私はシンプルなものが好きなんです。後"}, {"type": "subtitle", "time": 13379.269, "timestamp": "03:42:59", "text": "そうすれば、私たちは冒険に出かけることができる。"}]
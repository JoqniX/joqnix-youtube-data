[{"type": "subtitle", "time": 11706.389, "timestamp": "03:15:06", "text": "ええ、大丈夫です。私はとても怒っています。終わり"}, {"type": "subtitle", "time": 11710.91, "timestamp": "03:15:10", "text": "それらの流れ。私は本当に怒る"}, {"type": "subtitle", "time": 11713.389, "timestamp": "03:15:13", "text": "人。なぜそれをプレイするのかわからない"}, {"type": "subtitle", "time": 11716.95, "timestamp": "03:15:16", "text": "ゲーム。なぜそのゲームをプレイするのか分からない。"}, {"type": "subtitle", "time": 11722.389, "timestamp": "03:15:22", "text": "でも、もっと甘いものが欲しい。"}, {"type": "subtitle", "time": 11732.63, "timestamp": "03:15:32", "text": "時間。食べ物を買って"}, {"type": "subtitle", "time": 11734.55, "timestamp": "03:15:34", "text": "キャンプファイヤー。私はたくさんの"}, {"type": "subtitle", "time": 11736.309, "timestamp": "03:15:36", "text": "そこの食べ物。"}, {"type": "subtitle", "time": 11737.63, "timestamp": "03:15:37", "text": "私"}, {"type": "subtitle", "time": 11750.03, "timestamp": "03:15:50", "text": "あなた。チャットを見せてください。誰かいますか"}, {"type": "subtitle", "time": 11753.59, "timestamp": "03:15:53", "text": "話している？ピーク。これはモンスターハンターですか？"}, {"type": "subtitle", "time": 11756.55, "timestamp": "03:15:56", "text": "絶対に嫌だ。 D. これはモンスターハンターじゃない。"}, {"type": "subtitle", "time": 11759.19, "timestamp": "03:15:59", "text": "これはモンスターハンターよりも優れている。地獄"}]
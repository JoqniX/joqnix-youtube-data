[{"type": "subtitle", "time": 12541.67, "timestamp": "03:29:01", "text": "このゲームから最初に出てくると、"}, {"type": "subtitle", "time": 12543.99, "timestamp": "03:29:03", "text": "うわー、これはすごい、これは"}, {"type": "subtitle", "time": 12547.75, "timestamp": "03:29:07", "text": "ちょっとかっこいい。うん。"}, {"type": "subtitle", "time": 12550.15, "timestamp": "03:29:10", "text": "それに、とても落ち着いた雰囲気です。だから私は言った"}, {"type": "subtitle", "time": 12551.51, "timestamp": "03:29:11", "text": "僕たちはそれをプレイするべきだと思う。それ"}, {"type": "subtitle", "time": 12553.429, "timestamp": "03:29:13", "text": "パルワールドを思い出す。ご存知のとおり"}, {"type": "subtitle", "time": 12556.309, "timestamp": "03:29:16", "text": "私はパルワールドで遊びたかったのですが"}, {"type": "subtitle", "time": 12559.11, "timestamp": "03:29:19", "text": "私はできませんでした。"}, {"type": "subtitle", "time": 12561.349, "timestamp": "03:29:21", "text": "なぜPal Worldをプレイしたいのですか？それ"}, {"type": "subtitle", "time": 12564.95, "timestamp": "03:29:24", "text": "ゲームは、私がそう思わなかったようなものだったと思います。"}, {"type": "subtitle", "time": 12566.95, "timestamp": "03:29:26", "text": "ゲームは1週間くらいしか続かなかった"}, {"type": "subtitle", "time": 12569.429, "timestamp": "03:29:29", "text": "2つあって、それから消えたの？"}, {"type": "subtitle", "time": 12571.51, "timestamp": "03:29:31", "text": "何？それは消えた。それはまだ存在している、"}, {"type": "subtitle", "time": 12573.429, "timestamp": "03:29:33", "text": "右？"}, {"type": "subtitle", "time": 12575.349, "timestamp": "03:29:35", "text": "それは確かに存在する。私はただ言っているだけです"}, {"type": "subtitle", "time": 12578.87, "timestamp": "03:29:38", "text": "その人気は消え去った。"}, {"type": "subtitle", "time": 12585.269, "timestamp": "03:29:45", "text": "今どき、誰がそのゲームをプレイしてるんだろう？"}]
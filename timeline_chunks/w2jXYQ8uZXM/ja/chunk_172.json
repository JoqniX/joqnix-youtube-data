[{"type": "subtitle", "time": 10320.469, "timestamp": "02:52:00", "text": "今は午後です。だから、大丈夫です。私は"}, {"type": "subtitle", "time": 10323.67, "timestamp": "02:52:03", "text": "タイトルを実際に変更してください。何てことだ。に"}, {"type": "subtitle", "time": 10326.03, "timestamp": "02:52:06", "text": "あらゆる場所で変更してください。"}, {"type": "subtitle", "time": 10330.389, "timestamp": "02:52:10", "text": "おお、イエスよ。こいつはクリックベイトをやっている。"}, {"type": "subtitle", "time": 10333.83, "timestamp": "02:52:13", "text": "クリックベイト。恥を知れ。"}, {"type": "subtitle", "time": 10336.24, "timestamp": "02:52:16", "text": "恥を知れ。 何てことだ。"}, {"type": "subtitle", "time": 10343.11, "timestamp": "02:52:23", "text": "ちくしょう。なぜ私たちのように表示しているのですか"}, {"type": "subtitle", "time": 10345.51, "timestamp": "02:52:25", "text": "流れ？私はただ誰かを待っているだけです"}, {"type": "subtitle", "time": 10348.23, "timestamp": "02:52:28", "text": "ストリーミング配信する。"}, {"type": "subtitle", "time": 10351.429, "timestamp": "02:52:31", "text": "いいえ、手動で視聴する必要があります。私は持っている"}, {"type": "subtitle", "time": 10354.87, "timestamp": "02:52:34", "text": "今すぐ手動で視聴する。それでは、"}, {"type": "subtitle", "time": 10357.51, "timestamp": "02:52:37", "text": "それ。私が開けます。心配しないで。私は"}, {"type": "subtitle", "time": 10360.15, "timestamp": "02:52:40", "text": "うわ、私のプロフィール画像、かなりイケてるじゃん。のように"}, {"type": "subtitle", "time": 10363.19, "timestamp": "02:52:43", "text": "弾薬の霜のようなものを見て"}, {"type": "subtitle", "time": 10366.309, "timestamp": "02:52:46", "text": "フレームは、まるで、"}, {"type": "subtitle", "time": 10369.51, "timestamp": "02:52:49", "text": "私のプロフィール写真のほとんどがこれです。"}, {"type": "subtitle", "time": 10372.07, "timestamp": "02:52:52", "text": "[音楽]"}, {"type": "subtitle", "time": 10374.03, "timestamp": "02:52:54", "text": "はい。ああ、私の"}]
[{"type": "subtitle", "time": 17280.15, "timestamp": "04:48:00", "text": "90年代。もうすぐだ。[ __ ]後"}, {"type": "subtitle", "time": 17281.55, "timestamp": "04:48:01", "text": "たくさん"}, {"type": "subtitle", "time": 17283.67, "timestamp": "04:48:03", "text": "死亡者（数。ああ、端っこから落ちないで。おお、"}, {"type": "subtitle", "time": 17288.35, "timestamp": "04:48:08", "text": "建築制限があるんだよ、兄弟。ちくしょう。"}, {"type": "subtitle", "time": 17291.51, "timestamp": "04:48:11", "text": "いいえ。アリサにジャンプしたいのですか？待って、"}, {"type": "subtitle", "time": 17293.51, "timestamp": "04:48:13", "text": "彼は私たちの時間を無駄にするためだけにわざわざ来た"}, {"type": "subtitle", "time": 17296.55, "timestamp": "04:48:16", "text": "もの？ああ、そうだよ。ああ、なんてことだ。待って、"}, {"type": "subtitle", "time": 17299.83, "timestamp": "04:48:19", "text": "私たちの部屋に飛び込みたいですか？なぜ"}, {"type": "subtitle", "time": 17302.31, "timestamp": "04:48:22", "text": "死にたいのか？私は隣にスポーンしたい"}, {"type": "subtitle", "time": 17304.23, "timestamp": "04:48:24", "text": "しかし、彼に関しては。私はタフだった。私たちはただ行くことができます"}, {"type": "subtitle", "time": 17308.31, "timestamp": "04:48:28", "text": "ゆっくりと。いいえ、私は飛び降ります。"}, {"type": "subtitle", "time": 17310.47, "timestamp": "04:48:30", "text": "何てことだ。いいえ。グライダーを手に入れてください。我々は持っています"}, {"type": "subtitle", "time": 17312.55, "timestamp": "04:48:32", "text": "に"}, {"type": "subtitle", "time": 17316.23, "timestamp": "04:48:36", "text": "グライダーを手に入れなければならない。"}, {"type": "subtitle", "time": 17321.35, "timestamp": "04:48:41", "text": "私は生きている。どうやって？え、どうやって？クソッ"}, {"type": "subtitle", "time": 17324.47, "timestamp": "04:48:44", "text": "幸運が舞い降りてきた。降りてくる。私は私は"}, {"type": "subtitle", "time": 17326.788, "timestamp": "04:48:46", "text": "ジャンプする。私はジャンプしている。はい、私はかなり"}, {"type": "subtitle", "time": 17328.27, "timestamp": "04:48:48", "text": "彼はきっと"}, {"type": "subtitle", "time": 17336.55, "timestamp": "04:48:56", "text": "死ぬなよ。いいえ、しません。なぜ？"}, {"type": "subtitle", "time": 17338.788, "timestamp": "04:48:58", "text": "どういう意味だよ、兄弟？"}]
[{"type": "subtitle", "time": 11520.349, "timestamp": "03:12:00", "text": "人々も同様です。私は"}, {"type": "subtitle", "time": 11522.67, "timestamp": "03:12:02", "text": "走っている。私は走っています。"}, {"type": "subtitle", "time": 11527.349, "timestamp": "03:12:07", "text": "ああ、私は全然迷惑をかけませんよ。私は何の問題もありません。"}, {"type": "subtitle", "time": 11529.99, "timestamp": "03:12:09", "text": "何かお手伝いが必要ですか？いや、いや、いや。私は違います"}, {"type": "subtitle", "time": 11531.71, "timestamp": "03:12:11", "text": "今まさにこの問題と闘っているところです。私たちは来ることができます"}, {"type": "subtitle", "time": 11536.87, "timestamp": "03:12:16", "text": "後で。後で。今すぐお時間ありますか？"}, {"type": "subtitle", "time": 11541.11, "timestamp": "03:12:21", "text": "ええと、私はたくさんの石を持っています。少し分けてくれ。"}, {"type": "subtitle", "time": 11548.389, "timestamp": "03:12:28", "text": "来るよ。友よ、君のもとへ走っていくよ。"}, {"type": "subtitle", "time": 11571.91, "timestamp": "03:12:51", "text": "そうそう。とにかく、これがあなたの石です。"}, {"type": "subtitle", "time": 11574.87, "timestamp": "03:12:54", "text": "どうもありがとう。ありがとう。はい。はい。私は"}, {"type": "subtitle", "time": 11577.309, "timestamp": "03:12:57", "text": "頑張ってるよ、相棒。私は"}, {"type": "chat", "time": 11579.103, "timestamp": "03:12:59", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "is this mosnter hunter?"}]
[{"type": "subtitle", "time": 15062.59, "timestamp": "04:11:02", "text": "以前は、"}, {"type": "subtitle", "time": 15071.91, "timestamp": "04:11:11", "text": "来る。えっと、ジョックを見てみましょう"}, {"type": "subtitle", "time": 15074.55, "timestamp": "04:11:14", "text": "そして、彼が言うことを見てください。"}, {"type": "subtitle", "time": 15076.95, "timestamp": "04:11:16", "text": "この場所に階段を作り、"}, {"type": "subtitle", "time": 15080.55, "timestamp": "04:11:20", "text": "飛び上がった。お前、飛び降りたな。あなたはそうしなかった"}, {"type": "subtitle", "time": 15082.87, "timestamp": "04:11:22", "text": "階段を作る。"}, {"type": "subtitle", "time": 15088.63, "timestamp": "04:11:28", "text": "はい、そうしました。あなたはどこにいましたか？私はここに来られます。彼は"}, {"type": "subtitle", "time": 15091.03, "timestamp": "04:11:31", "text": "来るよ。彼は向かっている途中です。見たい"}, {"type": "subtitle", "time": 15108.63, "timestamp": "04:11:48", "text": "推測。くそ。走り続けろよ、相棒。保つ"}, {"type": "subtitle", "time": 15111.03, "timestamp": "04:11:51", "text": "走っている。もうすぐです。くそ。なぜ"}]
[{"type": "subtitle", "time": 22263.67, "timestamp": "06:11:03", "text": "えっと、欲しいものをいくつか調べてみました"}, {"type": "subtitle", "time": 22264.59, "timestamp": "06:11:04", "text": "に"}, {"type": "subtitle", "time": 22269.19, "timestamp": "06:11:09", "text": "来週のためにやっておきましょう。だから、約束はできません"}, {"type": "subtitle", "time": 22271.628, "timestamp": "06:11:11", "text": "私ができないことは何でも"}, {"type": "subtitle", "time": 22276.39, "timestamp": "06:11:16", "text": "配信はできませんが、試してみます。はい、やってみます。"}, {"type": "subtitle", "time": 22285.628, "timestamp": "06:11:25", "text": "そう、すべてに優先順位をつけなきゃいけないんだ。"}, {"type": "subtitle", "time": 22289.548, "timestamp": "06:11:29", "text": "さて、それは"}, {"type": "subtitle", "time": 22292.35, "timestamp": "06:11:32", "text": "難しい。"}, {"type": "subtitle", "time": 22296.15, "timestamp": "06:11:36", "text": "命を与えることを、命を生むことよりも優先する"}, {"type": "subtitle", "time": 22318.43, "timestamp": "06:11:58", "text": "えーと"}]
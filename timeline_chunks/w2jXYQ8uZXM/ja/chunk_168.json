[{"type": "subtitle", "time": 10083.19, "timestamp": "02:48:03", "text": "わかった。うん。私の友人は"}, {"type": "subtitle", "time": 10085.51, "timestamp": "02:48:05", "text": "以上。ブラッドはパンを焼き、アリサは"}, {"type": "subtitle", "time": 10088.55, "timestamp": "02:48:08", "text": "引き継ぐ。えっと"}, {"type": "chat", "time": 10091.405, "timestamp": "02:48:11", "author": "@bakononcopiumm", "avatar": "https://yt4.ggpht.com/hb5sPAHLUD7fBrZZsmfkzISQWwRqI8BY1n8lceyhZz0sNISomD05pCwUe-GL2amD5y-voH_uYw=s64-c-k-c0x00ffffff-no-rj", "message": "hewo"}, {"type": "subtitle", "time": 10091.51, "timestamp": "02:48:11", "text": "ええと、ちょっと待ってください。倍にさせてください"}, {"type": "subtitle", "time": 10095.63, "timestamp": "02:48:15", "text": "与えられたものを確認すると、"}, {"type": "subtitle", "time": 10103.59, "timestamp": "02:48:23", "text": "ええ、彼にはその役が与えられています。彼は"}, {"type": "subtitle", "time": 10104.91, "timestamp": "02:48:24", "text": "役割。"}, {"type": "subtitle", "time": 10109.269, "timestamp": "02:48:29", "text": "はい、皆さんも参加できます。えー、あなたは"}, {"type": "subtitle", "time": 10110.95, "timestamp": "02:48:30", "text": "ストリーミング配信？誰が配信しているの？誰が"}, {"type": "subtitle", "time": 10113.269, "timestamp": "02:48:33", "text": "ストリーミング配信？"}, {"type": "subtitle", "time": 10117.429, "timestamp": "02:48:37", "text": "えっと、アルスか私かどちらかが話します"}, {"type": "subtitle", "time": 10127.59, "timestamp": "02:48:47", "text": "しかし、私たちはそのゲームをプレイします"}, {"type": "subtitle", "time": 10139.03, "timestamp": "02:48:59", "text": "確認しましたか？まだ。"}]
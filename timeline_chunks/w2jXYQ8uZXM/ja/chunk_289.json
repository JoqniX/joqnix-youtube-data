[{"type": "subtitle", "time": 17346.11, "timestamp": "04:49:06", "text": "何てことだ。彼はここにいる。いいえ、私は"}, {"type": "subtitle", "time": 17348.39, "timestamp": "04:49:08", "text": "彼は、"}, {"type": "subtitle", "time": 17351.35, "timestamp": "04:49:11", "text": "顔。ああ、神様。"}, {"type": "subtitle", "time": 17354.67, "timestamp": "04:49:14", "text": "待てよ、水がないぞ。"}, {"type": "subtitle", "time": 17356.55, "timestamp": "04:49:16", "text": "[音楽]"}, {"type": "subtitle", "time": 17358.91, "timestamp": "04:49:18", "text": "あなたは"}, {"type": "subtitle", "time": 17361.83, "timestamp": "04:49:21", "text": "これを見て？"}, {"type": "subtitle", "time": 17364.91, "timestamp": "04:49:24", "text": "この男を見てください。私"}, {"type": "subtitle", "time": 17368.708, "timestamp": "04:49:28", "text": "私はここにいます。見て。ここにあるのは何ですか？彼"}, {"type": "subtitle", "time": 17371.35, "timestamp": "04:49:31", "text": "私に飛びかかってきた。"}, {"type": "subtitle", "time": 17373.27, "timestamp": "04:49:33", "text": "おお。"}, {"type": "subtitle", "time": 17375.43, "timestamp": "04:49:35", "text": "ああ、この人か。"}, {"type": "subtitle", "time": 17376.19, "timestamp": "04:49:36", "text": "これ"}, {"type": "subtitle", "time": 17380.23, "timestamp": "04:49:40", "text": "男。この男、すごいな。オーマイはどこ？"}, {"type": "subtitle", "time": 17382.628, "timestamp": "04:49:42", "text": "神。よし、構成要素が必要だ。今"}, {"type": "subtitle", "time": 17384.55, "timestamp": "04:49:44", "text": "私たちは水上旅行に出かけます。"}, {"type": "subtitle", "time": 17388.23, "timestamp": "04:49:48", "text": "さあ、みんな。十分。ハハ。彼"}, {"type": "subtitle", "time": 17390.47, "timestamp": "04:49:50", "text": "えっと、ボートを建造する。どうやって"}, {"type": "subtitle", "time": 17393.51, "timestamp": "04:49:53", "text": "ボートを建造する？わかった。それでは、"}, {"type": "subtitle", "time": 17397.35, "timestamp": "04:49:57", "text": "ボート。それはいいです。骨の爪。方法"}]
[{"type": "subtitle", "time": 2463.67, "timestamp": "00:41:03", "text": "秘密 新しい秘密。新しい秘密を作る"}, {"type": "subtitle", "time": 2474.79, "timestamp": "00:41:14", "text": "それ。それらは見せることができません。実は"}, {"type": "subtitle", "time": 2477.109, "timestamp": "00:41:17", "text": "ぶつけられるかもしれない。私がボングで酔っ払ったようにはならない"}, {"type": "subtitle", "time": 2479.15, "timestamp": "00:41:19", "text": "話すかもしれない"}, {"type": "subtitle", "time": 2496.19, "timestamp": "00:41:36", "text": "そしてP"}, {"type": "subtitle", "time": 2499.589, "timestamp": "00:41:39", "text": "そして私は、すべての"}, {"type": "subtitle", "time": 2502.069, "timestamp": "00:41:42", "text": "AI がある今、"}, {"type": "subtitle", "time": 2503.829, "timestamp": "00:41:43", "text": "今、私はたくさんのものを作っています"}, {"type": "subtitle", "time": 2505.71, "timestamp": "00:41:45", "text": "私自身のアプリケーション"}, {"type": "subtitle", "time": 2519.67, "timestamp": "00:41:59", "text": "クレイジーだけど、大好き。大好きです。大好きです。"}]
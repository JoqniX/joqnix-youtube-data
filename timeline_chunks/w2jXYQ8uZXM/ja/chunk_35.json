[{"type": "subtitle", "time": 2103.55, "timestamp": "00:35:03", "text": "なぜ"}, {"type": "subtitle", "time": 2106.19, "timestamp": "00:35:06", "text": "よし、やろう"}, {"type": "subtitle", "time": 2108.71, "timestamp": "00:35:08", "text": "これ。私は自分が作っているという事実が大好きです"}, {"type": "subtitle", "time": 2112.91, "timestamp": "00:35:12", "text": "多くのカスタムプログラムスクリプト"}, {"type": "subtitle", "time": 2114.91, "timestamp": "00:35:14", "text": "私自身はただ"}, {"type": "subtitle", "time": 2118.75, "timestamp": "00:35:18", "text": "私はただ必要としているから"}, {"type": "subtitle", "time": 2144.43, "timestamp": "00:35:44", "text": "モニター。ストリーム"}]
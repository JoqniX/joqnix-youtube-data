[{"type": "subtitle", "time": 13922.55, "timestamp": "03:52:02", "text": "2番。たくさん。私には何もすることがない"}, {"type": "subtitle", "time": 13926.469, "timestamp": "03:52:06", "text": "クエストログに記入してください。それは普通のことですか？"}, {"type": "subtitle", "time": 13928.79, "timestamp": "03:52:08", "text": "戦闘入門。あれ、分かりますか？"}, {"type": "subtitle", "time": 13938.71, "timestamp": "03:52:18", "text": "クエストログを閉じるにはどうすればいいですか？"}, {"type": "subtitle", "time": 13940.63, "timestamp": "03:52:20", "text": "いいえ、大丈夫です。それはそこにずっと留まっている。あなた"}, {"type": "subtitle", "time": 13942.389, "timestamp": "03:52:22", "text": "閉じることができません。ちくしょう。わかった。と"}, {"type": "subtitle", "time": 13944.79, "timestamp": "03:52:24", "text": "槍。"}, {"type": "subtitle", "time": 13946.55, "timestamp": "03:52:26", "text": "槍を作るのは君だ。あなたは作りたい"}, {"type": "subtitle", "time": 13949.11, "timestamp": "03:52:29", "text": "あなた自身"}, {"type": "subtitle", "time": 13950.309, "timestamp": "03:52:30", "text": "「ああ、槍を作るよ"}, {"type": "subtitle", "time": 13952.07, "timestamp": "03:52:32", "text": "自分でやったんだ。わかった。わかった。やったよ。"}, {"type": "subtitle", "time": 13954.71, "timestamp": "03:52:34", "text": "それ。やったぞ。やったぞ。ちくしょう。"}, {"type": "subtitle", "time": 13956.469, "timestamp": "03:52:36", "text": "予備が1つありますか？持っていますか？"}, {"type": "subtitle", "time": 13959.11, "timestamp": "03:52:39", "text": "余分なカニの殻？"}, {"type": "subtitle", "time": 13960.63, "timestamp": "03:52:40", "text": "カニの甲羅。待って、ほら。私は持っている"}, {"type": "subtitle", "time": 13963.349, "timestamp": "03:52:43", "text": "二。私は2つ持っています。それは硬くて殻のようなものです。"}, {"type": "subtitle", "time": 13965.83, "timestamp": "03:52:45", "text": "あ、待って。それは硬くて殻で覆われている。"}, {"type": "subtitle", "time": 13967.91, "timestamp": "03:52:47", "text": "そこには硬化がある。ここに"}, {"type": "subtitle", "time": 13970.63, "timestamp": "03:52:50", "text": "貝。そしてそれは、非常に硬い殻だった。"}, {"type": "subtitle", "time": 13973.11, "timestamp": "03:52:53", "text": "わかった。ハードな自己中心的なものも一つください。"}, {"type": "subtitle", "time": 13975.429, "timestamp": "03:52:55", "text": "私はそれをあなたに渡しました。何が"}, {"type": "subtitle", "time": 13979.11, "timestamp": "03:52:59", "text": "もしかして？あ、待って。待って。えっと、どうやって"}]
[{"type": "subtitle", "time": 14220.79, "timestamp": "03:57:00", "text": "あなたはそれを知らない。私は途方に暮れています"}, {"type": "subtitle", "time": 14223.59, "timestamp": "03:57:03", "text": "今すぐ。何てことだ。待って、私は少し行った"}, {"type": "subtitle", "time": 14225.469, "timestamp": "03:57:05", "text": "他の。はい、私は"}, {"type": "subtitle", "time": 14228.99, "timestamp": "03:57:08", "text": "ここ。ああ、それはああ神様、私は"}, {"type": "subtitle", "time": 14233.91, "timestamp": "03:57:13", "text": "死んだ。 45馬力。なんてこった。うん、その通りだよ"}, {"type": "subtitle", "time": 14238.03, "timestamp": "03:57:18", "text": "ダメージ。えっと、ああ、"}, {"type": "subtitle", "time": 14241.79, "timestamp": "03:57:21", "text": "神。誰か持ってる？"}, {"type": "subtitle", "time": 14246.07, "timestamp": "03:57:26", "text": "マナ、あるいはマナがあるべきでしょうか？"}, {"type": "subtitle", "time": 14248.389, "timestamp": "03:57:28", "text": "ええ、それを受け取りました。ええ、持っていません"}, {"type": "subtitle", "time": 14250.75, "timestamp": "03:57:30", "text": "どれでも"}, {"type": "subtitle", "time": 14253.429, "timestamp": "03:57:33", "text": "くそっ。もっとマナが必要だ。来て。それから"}, {"type": "subtitle", "time": 14256.79, "timestamp": "03:57:36", "text": "私たちは農業を始めました。"}, {"type": "subtitle", "time": 14264.269, "timestamp": "03:57:44", "text": "方法"}, {"type": "subtitle", "time": 14268.309, "timestamp": "03:57:48", "text": "キノコを食べる？ああ、料理しなくちゃ"}, {"type": "subtitle", "time": 14271.83, "timestamp": "03:57:51", "text": "彼ら。ああ、"}, {"type": "subtitle", "time": 14273.83, "timestamp": "03:57:53", "text": "どういう意味ですか？料理はしていないのですか？"}, {"type": "subtitle", "time": 14276.389, "timestamp": "03:57:56", "text": "自分自身に何か？"}, {"type": "subtitle", "time": 14278.95, "timestamp": "03:57:58", "text": "私だけだ。"}]
[{"type": "subtitle", "time": 2822.109, "timestamp": "00:47:02", "text": "トークン？私はどこにいるべきだったの？"}, {"type": "subtitle", "time": 2834.23, "timestamp": "00:47:14", "text": "わかった。わかった。チャンネルIDが必要です。"}, {"type": "subtitle", "time": 2836.43, "timestamp": "00:47:16", "text": "ジョック"}, {"type": "subtitle", "time": 2845.55, "timestamp": "00:47:25", "text": "チャンネルIDが必要です。はい、私の"}, {"type": "subtitle", "time": 2847.99, "timestamp": "00:47:27", "text": "チャネル。ああ、もしあなたが知っていたら"}, {"type": "subtitle", "time": 2850.23, "timestamp": "00:47:30", "text": "チャンネルIDは、"}, {"type": "subtitle", "time": 2852.55, "timestamp": "00:47:32", "text": "私のプロフィールページに行って、下にスクロールしてください。"}, {"type": "subtitle", "time": 2857.349, "timestamp": "00:47:37", "text": "共有、チャンネルIDをコピーします。それでおしまい。簡単。"}, {"type": "subtitle", "time": 2859.15, "timestamp": "00:47:39", "text": "簡単だ"}, {"type": "subtitle", "time": 2862.39, "timestamp": "00:47:42", "text": "なれ。えっと、ちょっと待ってください。なぜなら私は"}, {"type": "subtitle", "time": 2865.19, "timestamp": "00:47:45", "text": "Twitch ID、クライアントトークン、Twitch"}, {"type": "subtitle", "time": 2866.95, "timestamp": "00:47:46", "text": "あれ。いいえ、だから私は見せないんです"}, {"type": "subtitle", "time": 2870.589, "timestamp": "00:47:50", "text": "コードは怖いから、何が"}, {"type": "subtitle", "time": 2874.47, "timestamp": "00:47:54", "text": "起こる。そういうことも起こり得る。それで、"}]
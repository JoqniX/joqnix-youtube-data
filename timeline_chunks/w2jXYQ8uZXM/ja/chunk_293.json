[{"type": "subtitle", "time": 17581.27, "timestamp": "04:53:01", "text": "わかった。わかった。最初のボスと戦いたい"}, {"type": "subtitle", "time": 17584.39, "timestamp": "04:53:04", "text": "戦うのか、それとも私たちが言っていることなのか？わかった。私たちはただ"}, {"type": "subtitle", "time": 17587.67, "timestamp": "04:53:07", "text": "少し休憩して、何か小さなことをしてもいいでしょう。"}, {"type": "subtitle", "time": 17589.51, "timestamp": "04:53:09", "text": "私は何かをしている、それから"}, {"type": "subtitle", "time": 17591.47, "timestamp": "04:53:11", "text": "一緒になる。"}, {"type": "subtitle", "time": 17593.43, "timestamp": "04:53:13", "text": "わかった。"}, {"type": "subtitle", "time": 17595.11, "timestamp": "04:53:15", "text": "メインのお店で何か食べ物を取ってきます。"}, {"type": "subtitle", "time": 17597.19, "timestamp": "04:53:17", "text": "推測。はい、食べ物やその他のものを準備します"}, {"type": "subtitle", "time": 17605.03, "timestamp": "04:53:25", "text": "海藻とか色々買ってきて。"}, {"type": "subtitle", "time": 17607.27, "timestamp": "04:53:27", "text": "これが必要だ、さもなければ"}, {"type": "subtitle", "time": 17608.55, "timestamp": "04:53:28", "text": "死ぬ。つまり、私はどうやって"}, {"type": "subtitle", "time": 17610.788, "timestamp": "04:53:30", "text": "生き残った。ほら、真ん中で"}, {"type": "subtitle", "time": 17613.19, "timestamp": "04:53:33", "text": "旅の間、私はロックをたくさん必要としていたが、"}, {"type": "subtitle", "time": 17619.75, "timestamp": "04:53:39", "text": "ええ、ちょうど行こうとしていたところでした。私は持っていません"}, {"type": "subtitle", "time": 17621.59, "timestamp": "04:53:41", "text": "アラスがどこに行ったのか手がかりはないが、彼は"}, {"type": "subtitle", "time": 17623.43, "timestamp": "04:53:43", "text": "どこかで。"}, {"type": "subtitle", "time": 17625.31, "timestamp": "04:53:45", "text": "つまり、"}, {"type": "subtitle", "time": 17629.67, "timestamp": "04:53:49", "text": "ガーディアンズのスピードのことね。新しい"}, {"type": "subtitle", "time": 17634.15, "timestamp": "04:53:54", "text": "うん。うん。それはすばらしい。それはすばらしい。"}]
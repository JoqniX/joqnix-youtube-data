[{"type": "subtitle", "time": 16801.51, "timestamp": "04:40:01", "text": "さらに深く掘り下げますか？"}, {"type": "subtitle", "time": 16810.708, "timestamp": "04:40:10", "text": "ああ、なぜジャンプの音が聞こえるのだろう？ああ、あなたは"}, {"type": "subtitle", "time": 16812.55, "timestamp": "04:40:12", "text": "自分の曲を演奏する。そうそう。うん。"}, {"type": "subtitle", "time": 16819.788, "timestamp": "04:40:19", "text": "ありがとう。"}, {"type": "subtitle", "time": 16822.868, "timestamp": "04:40:22", "text": "無事に帰国できて嬉しいです。"}, {"type": "subtitle", "time": 16826.628, "timestamp": "04:40:26", "text": "何てことだ。どれくらい長い遠征"}, {"type": "subtitle", "time": 16830.15, "timestamp": "04:40:30", "text": "行きましたか？少なくとも死ななかったのは良かった。"}, {"type": "subtitle", "time": 16831.75, "timestamp": "04:40:31", "text": "ああ、少なくとも死ななかったのは良かったな"}, {"type": "subtitle", "time": 16841.35, "timestamp": "04:40:41", "text": "私たち。ああ、いつか私はもっと上手くなるだろう"}, {"type": "subtitle", "time": 16842.51, "timestamp": "04:40:42", "text": "生存"}, {"type": "subtitle", "time": 16846.55, "timestamp": "04:40:46", "text": "ゲーム。いつか。彼は言う、"}, {"type": "subtitle", "time": 16856.628, "timestamp": "04:40:56", "text": "私は今、死にかけているので、埋め合わせをしなければならない。おお"}, {"type": "subtitle", "time": 16858.51, "timestamp": "04:40:58", "text": "我が神よ。"}]
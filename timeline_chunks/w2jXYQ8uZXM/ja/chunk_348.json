[{"type": "subtitle", "time": 20881.27, "timestamp": "05:48:01", "text": "待って、Twitchはどうなの？"}, {"type": "subtitle", "time": 20883.35, "timestamp": "05:48:03", "text": "Twitchは遅れているのか？ Twitchはそうではないかもしれない"}, {"type": "subtitle", "time": 20885.35, "timestamp": "05:48:05", "text": "後ろに。"}, {"type": "subtitle", "time": 20907.59, "timestamp": "05:48:27", "text": "そういうことです。それで、"}, {"type": "subtitle", "time": 20910.708, "timestamp": "05:48:30", "text": "うん。わかった。ビリー・ウィルは最新情報を把握している。"}, {"type": "subtitle", "time": 20913.51, "timestamp": "05:48:33", "text": "優れたプラットフォームです。そうそう。ビリー。うん。"}, {"type": "subtitle", "time": 20916.31, "timestamp": "05:48:36", "text": "良い。"}, {"type": "subtitle", "time": 20918.628, "timestamp": "05:48:38", "text": "彼らが私たちの話を聞いている可能性についてはどうでしょうか？"}, {"type": "subtitle", "time": 20920.708, "timestamp": "05:48:40", "text": "ビリー、ビリー、君たちは最高だよ。"}, {"type": "subtitle", "time": 20922.43, "timestamp": "05:48:42", "text": "あなたは今、私たちの話を聞いていません"}, {"type": "subtitle", "time": 20924.948, "timestamp": "05:48:44", "text": "YouTubeやTwitchとは異なりライブ配信"}, {"type": "subtitle", "time": 20928.51, "timestamp": "05:48:48", "text": "そこには。私たちは10分遅刻しました。"}, {"type": "subtitle", "time": 20930.868, "timestamp": "05:48:50", "text": "はい、アップデートがあります。ええと、"}, {"type": "subtitle", "time": 20932.788, "timestamp": "05:48:52", "text": "ストリームは追いつくでしょう。小川"}, {"type": "subtitle", "time": 20934.39, "timestamp": "05:48:54", "text": "私が言っていることに追いつくでしょう"}, {"type": "subtitle", "time": 20937.67, "timestamp": "05:48:57", "text": "今すぐ。うん。"}]
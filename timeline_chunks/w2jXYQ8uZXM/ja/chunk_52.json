[{"type": "subtitle", "time": 3157.47, "timestamp": "00:52:37", "text": "神様、私は母に話しかけている"}, {"type": "subtitle", "time": 3160.549, "timestamp": "00:52:40", "text": "eコマース。理由がわからない。わからない"}, {"type": "subtitle", "time": 3162.15, "timestamp": "00:52:42", "text": "なぜ。私が話すときもいつも"}, {"type": "subtitle", "time": 3165.51, "timestamp": "00:52:45", "text": "家族、私は変な男の声を持っているか、"}, {"type": "subtitle", "time": 3167.67, "timestamp": "00:52:47", "text": "何かが来る、あるいは失礼な"}, {"type": "subtitle", "time": 3169.95, "timestamp": "00:52:49", "text": "口調とか、そういう感じ。理由がわからない、"}, {"type": "subtitle", "time": 3171.95, "timestamp": "00:52:51", "text": "でも兄弟、"}, {"type": "subtitle", "time": 3174.79, "timestamp": "00:52:54", "text": "なぜ？でも配信とかやってるときは、"}, {"type": "subtitle", "time": 3177.829, "timestamp": "00:52:57", "text": "柔らかい小さな子供や子供のように、"}]
[{"type": "subtitle", "time": 11888.79, "timestamp": "03:18:08", "text": "煙。また、"}, {"type": "subtitle", "time": 11890.59, "timestamp": "03:18:10", "text": "これら"}, {"type": "subtitle", "time": 11893.99, "timestamp": "03:18:13", "text": "みんな。そのことを忘れないでください。何が"}, {"type": "subtitle", "time": 11896.309, "timestamp": "03:18:16", "text": "ええと、あの、心を落ち着かせる雰囲気？プレイヤーは"}, {"type": "subtitle", "time": 11898.63, "timestamp": "03:18:18", "text": "スピリットアンカー内での受動的なヒーリング"}, {"type": "subtitle", "time": 11900.07, "timestamp": "03:18:20", "text": "オーラ。"}, {"type": "subtitle", "time": 11905.83, "timestamp": "03:18:25", "text": "ニース。食べ物を持ってきてくれよ、相棒。手に入れよう"}, {"type": "subtitle", "time": 11913.03, "timestamp": "03:18:33", "text": "ああ、それはいいよ。ほら、これだよ。そうです。"}, {"type": "subtitle", "time": 11914.59, "timestamp": "03:18:34", "text": "それはあなたに多くの"}, {"type": "subtitle", "time": 11918.95, "timestamp": "03:18:38", "text": "健康。つまり、そういうことなんです。"}, {"type": "subtitle", "time": 11923.19, "timestamp": "03:18:43", "text": "ほら、私が何を言っているか分かるでしょ？"}, {"type": "subtitle", "time": 11936.19, "timestamp": "03:18:56", "text": "あれを作ってもらえますか？"}, {"type": "subtitle", "time": 11938.19, "timestamp": "03:18:58", "text": "修理"}]
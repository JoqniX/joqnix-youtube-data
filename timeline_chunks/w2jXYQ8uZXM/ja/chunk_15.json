[{"type": "subtitle", "time": 900.67, "timestamp": "00:15:00", "text": "右？待って、今ライブ配信中だよね？"}, {"type": "subtitle", "time": 902.79, "timestamp": "00:15:02", "text": "ビリー、彼らは私を追放した理由は"}, {"type": "subtitle", "time": 904.829, "timestamp": "00:15:04", "text": "表示中"}, {"type": "subtitle", "time": 908.629, "timestamp": "00:15:08", "text": "Twitter？はい、まだそこにいます。ああ、私は"}, {"type": "subtitle", "time": 911.43, "timestamp": "00:15:11", "text": "まだそこにいる。"}, {"type": "subtitle", "time": 917.35, "timestamp": "00:15:17", "text": "罰。うん。うん。うん。彼らは"}, {"type": "subtitle", "time": 919.91, "timestamp": "00:15:19", "text": "外国人に見せさせないでください"}, {"type": "subtitle", "time": 921.67, "timestamp": "00:15:21", "text": "外国側。彼らは倒す"}, {"type": "subtitle", "time": 925.629, "timestamp": "00:15:25", "text": "ストリーム。 56歳でそれが起こった"}, {"type": "subtitle", "time": 929.75, "timestamp": "00:15:29", "text": "回。警告。わかった。ウィリー・ウィリー"}, {"type": "subtitle", "time": 932.949, "timestamp": "00:15:32", "text": "5回警告を受けた。えっと、じゃあ"}, {"type": "subtitle", "time": 945.9, "timestamp": "00:15:45", "text": "最悪だ。考え"}]
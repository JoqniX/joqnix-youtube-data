[{"type": "subtitle", "time": 14463.83, "timestamp": "04:01:03", "text": "えっと、待って。本当に？何てことだ。また。私"}, {"type": "subtitle", "time": 14465.75, "timestamp": "04:01:05", "text": "これを聞いてください。"}, {"type": "subtitle", "time": 14467.269, "timestamp": "04:01:07", "text": "うん。"}, {"type": "subtitle", "time": 14471.189, "timestamp": "04:01:11", "text": "いいえ、復活しました。復活した。そうではないのですか？"}, {"type": "subtitle", "time": 14474.309, "timestamp": "04:01:14", "text": "なぜこれほど大幅な遅延が発生しているのですか？"}, {"type": "subtitle", "time": 14475.91, "timestamp": "04:01:15", "text": "なぜこれがそんなに"}, {"type": "subtitle", "time": 14478.15, "timestamp": "04:01:18", "text": "大きい"}, {"type": "subtitle", "time": 14480.349, "timestamp": "04:01:20", "text": "ああ、"}, {"type": "subtitle", "time": 14483.63, "timestamp": "04:01:23", "text": "神の命ではなく、私"}]
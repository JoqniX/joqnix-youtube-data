[{"type": "subtitle", "time": 10740.03, "timestamp": "02:59:00", "text": "収集"}, {"type": "subtitle", "time": 10743.91, "timestamp": "02:59:03", "text": "ええと、棒と石。"}, {"type": "subtitle", "time": 10751.91, "timestamp": "02:59:11", "text": "じゃあ、私もいくつか取らせてください。私たちは"}, {"type": "subtitle", "time": 10754.95, "timestamp": "02:59:14", "text": "これらのベリーが早く必要です。"}, {"type": "subtitle", "time": 10757.269, "timestamp": "02:59:17", "text": "彼らの多くと同じように。ああ、いくつかある"}, {"type": "subtitle", "time": 10760.07, "timestamp": "02:59:20", "text": "植物繊維も同様です。"}, {"type": "subtitle", "time": 10762.67, "timestamp": "02:59:22", "text": "ああ、そうだね。掴む"}, {"type": "subtitle", "time": 10764.99, "timestamp": "02:59:24", "text": "それ。いくつか手に入れよう"}, {"type": "subtitle", "time": 10775.99, "timestamp": "02:59:35", "text": "石。わかった。"}, {"type": "subtitle", "time": 10793.91, "timestamp": "02:59:53", "text": "石。よし、私は作らなければならない"}]
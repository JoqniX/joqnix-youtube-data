[{"type": "subtitle", "time": 21212.23, "timestamp": "05:53:32", "text": "わかった。 653. いや、違う。えっと、1453。わかりました。また、"}, {"type": "subtitle", "time": 21213.67, "timestamp": "05:53:33", "text": "夜の小川は枯れていくだろう"}, {"type": "subtitle", "time": 21215.788, "timestamp": "05:53:35", "text": "衰えゆく波。によって"}, {"type": "subtitle", "time": 21218.788, "timestamp": "05:53:38", "text": "方法、念のため、重要なリマインダー"}]
[{"type": "subtitle", "time": 18902.99, "timestamp": "05:15:02", "text": "私には"}, {"type": "subtitle", "time": 18905.03, "timestamp": "05:15:05", "text": "それこそが重要だ。"}, {"type": "subtitle", "time": 18908.19, "timestamp": "05:15:08", "text": "ください"}, {"type": "subtitle", "time": 18911.47, "timestamp": "05:15:11", "text": "水。よし、では行こう。"}, {"type": "subtitle", "time": 18913.99, "timestamp": "05:15:13", "text": "何？みんな、水面を狙えよ。目指すのは"}, {"type": "subtitle", "time": 18916.23, "timestamp": "05:15:16", "text": "水。そうそう。"}, {"type": "subtitle", "time": 18917.75, "timestamp": "05:15:17", "text": "胸部が上部にあるはずです。"}, {"type": "subtitle", "time": 18920.39, "timestamp": "05:15:20", "text": "確認しなかったのですか？いくつか見えます いくつか見えます"}, {"type": "subtitle", "time": 18923.75, "timestamp": "05:15:23", "text": "もの。えっと、みんな、私の荷物を持って行って。私はしません"}, {"type": "subtitle", "time": 18927.948, "timestamp": "05:15:27", "text": "みんな、見てて。うん、そう思う"}, {"type": "subtitle", "time": 18932.15, "timestamp": "05:15:32", "text": "私の友人が亡くなった。知りませんでした。ああ、そうだね"}, {"type": "subtitle", "time": 18933.91, "timestamp": "05:15:33", "text": "船のすぐ目の前。だって私は"}, {"type": "subtitle", "time": 18940.39, "timestamp": "05:15:40", "text": "その間、私は"}, {"type": "subtitle", "time": 18944.708, "timestamp": "05:15:44", "text": "性格、ということかな。ああ、転んでしまった。"}, {"type": "subtitle", "time": 18957.07, "timestamp": "05:15:57", "text": "とにかく、それは手に入れた。の1つ"}, {"type": "subtitle", "time": 18959.83, "timestamp": "05:15:59", "text": "遺跡。おそらく私たちは"}]
[{"type": "subtitle", "time": 20230.788, "timestamp": "05:37:10", "text": "いくつかあります"}, {"type": "subtitle", "time": 20233.67, "timestamp": "05:37:13", "text": "ここにいくつかあります。私は手に入れる必要がある 私は"}, {"type": "subtitle", "time": 20236.07, "timestamp": "05:37:16", "text": "鋭い石斧を手に入れて"}, {"type": "subtitle", "time": 20238.788, "timestamp": "05:37:18", "text": "すべて。"}, {"type": "subtitle", "time": 20242.31, "timestamp": "05:37:22", "text": "金属製のやつ。どうすればそれを手に入れられますか？"}, {"type": "subtitle", "time": 20245.75, "timestamp": "05:37:25", "text": "ああ、あなたの後ろに群衆がいますよ。"}, {"type": "subtitle", "time": 20251.43, "timestamp": "05:37:31", "text": "何？オーケー。えっと、デモモードです。"}, {"type": "subtitle", "time": 20254.628, "timestamp": "05:37:34", "text": "全く分かりません。座っていただけますか？"}, {"type": "subtitle", "time": 20257.11, "timestamp": "05:37:37", "text": "お前はカフェイン中毒者だな。できますか？"}, {"type": "subtitle", "time": 20265.27, "timestamp": "05:37:45", "text": "ただ走り回っているだけです。わかった。"}, {"type": "subtitle", "time": 20267.67, "timestamp": "05:37:47", "text": "よし。これで私たちの関係は終わりだと思います。"}, {"type": "subtitle", "time": 20274.788, "timestamp": "05:37:54", "text": "ちょっとご飯食べに行くね。えっと、"}, {"type": "subtitle", "time": 20279.15, "timestamp": "05:37:59", "text": "お茶を淹れてください。ゲームを終了します。出口"}]
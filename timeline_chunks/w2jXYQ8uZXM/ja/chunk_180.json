[{"type": "subtitle", "time": 10802.389, "timestamp": "03:00:02", "text": "待って、レシピがないよ。私は"}, {"type": "subtitle", "time": 10804.79, "timestamp": "03:00:04", "text": "レシピはありますか？私たちはそれらを解き放つ必要がある。"}, {"type": "subtitle", "time": 10806.309, "timestamp": "03:00:06", "text": "ええ、あなたの言う通り、ああ、そうでした"}, {"type": "subtitle", "time": 10811.03, "timestamp": "03:00:11", "text": "ロックを解除してください。ご覧のとおり、Kキーを押してください。"}, {"type": "subtitle", "time": 10812.59, "timestamp": "03:00:12", "text": "うん、"}, {"type": "subtitle", "time": 10815.83, "timestamp": "03:00:15", "text": "武器がアンロックされ、次に石斧が手に入った。"}, {"type": "subtitle", "time": 10818.469, "timestamp": "03:00:18", "text": "そのチケットも必要になります。えっと、ただ"}, {"type": "subtitle", "time": 10820.309, "timestamp": "03:00:20", "text": "全てを解錠する。ロックを解除するだけ"}, {"type": "subtitle", "time": 10824.15, "timestamp": "03:00:24", "text": "すべて。そうそう。そうそう。"}, {"type": "subtitle", "time": 10827.349, "timestamp": "03:00:27", "text": "いずれにせよ、私たちはすべてを必要としている。建てる。プレス"}, {"type": "subtitle", "time": 10829.19, "timestamp": "03:00:29", "text": "B. 作業台を作るつもりです。あなたは"}, {"type": "subtitle", "time": 10832.07, "timestamp": "03:00:32", "text": "作業台も作らないといけないの？"}, {"type": "subtitle", "time": 10851.51, "timestamp": "03:00:51", "text": "作業台を作りました。作ることができます"}, {"type": "subtitle", "time": 10853.75, "timestamp": "03:00:53", "text": "さあ、今すぐやろう。"}, {"type": "subtitle", "time": 10857.95, "timestamp": "03:00:57", "text": "私は石を作るつもりです"}]
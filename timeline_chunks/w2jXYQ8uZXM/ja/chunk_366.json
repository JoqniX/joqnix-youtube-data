[{"type": "subtitle", "time": 21963.75, "timestamp": "06:06:03", "text": "えっと、待って。ちょっと調べてみます。"}, {"type": "subtitle", "time": 21965.31, "timestamp": "06:06:05", "text": "私は置きたい"}, {"type": "subtitle", "time": 21970.15, "timestamp": "06:06:10", "text": "これをオーバーレイとして使います。えっと、私に"}, {"type": "subtitle", "time": 21972.27, "timestamp": "06:06:12", "text": "1"}, {"type": "subtitle", "time": 21982.15, "timestamp": "06:06:22", "text": "ああ、タイマー設定があるんですね。ちょっと待って。"}, {"type": "subtitle", "time": 21985.03, "timestamp": "06:06:25", "text": "私にさせて、私にさせて、私にさせて、私にさせて、それは"}, {"type": "subtitle", "time": 21986.788, "timestamp": "06:06:26", "text": "私がしている褒め言葉。ああ、それは"}, {"type": "subtitle", "time": 21988.11, "timestamp": "06:06:28", "text": "褒め言葉。"}, {"type": "subtitle", "time": 21990.628, "timestamp": "06:06:30", "text": "わかった。えっと、問題は今私はあまりにも"}, {"type": "subtitle", "time": 21992.47, "timestamp": "06:06:32", "text": "密集。私は知らないし、もし"}, {"type": "subtitle", "time": 21995.19, "timestamp": "06:06:35", "text": "あなたは私を褒めたり、称賛したりもした。"}, {"type": "subtitle", "time": 21997.75, "timestamp": "06:06:37", "text": "実際、私は文字通り"}, {"type": "subtitle", "time": 22015.03, "timestamp": "06:06:55", "text": "なぜ私がそれを手に入れるまで、それを手に入れるのか。私を"}, {"type": "subtitle", "time": 22018.59, "timestamp": "06:06:58", "text": "ああ、これは"}]
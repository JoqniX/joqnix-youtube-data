[{"type": "subtitle", "time": 13022.389, "timestamp": "03:37:02", "text": "これはそうだと思う。うん。うん。ブルウォグ。"}, {"type": "subtitle", "time": 13024.63, "timestamp": "03:37:04", "text": "ブルウォグ。今はジャンクフードを与えないでください"}, {"type": "subtitle", "time": 13027.349, "timestamp": "03:37:07", "text": "だって、うちにはガラクタなんてないから。私は"}, {"type": "subtitle", "time": 13029.429, "timestamp": "03:37:09", "text": "何でも持っています。"}, {"type": "subtitle", "time": 13031.429, "timestamp": "03:37:11", "text": "あと、ジョックのためにこれを作らなきゃいけないんだ"}, {"type": "subtitle", "time": 13035.269, "timestamp": "03:37:15", "text": "だから彼は変わることができる。必ずやり遂げる。私"}, {"type": "subtitle", "time": 13037.95, "timestamp": "03:37:17", "text": "学びたい。ああ、古代のものが必要だ"}, {"type": "subtitle", "time": 13043.03, "timestamp": "03:37:23", "text": "fman。ちくしょう。うん。"}, {"type": "subtitle", "time": 13045.389, "timestamp": "03:37:25", "text": "私は日焼けするだろう。その"}, {"type": "subtitle", "time": 13048.15, "timestamp": "03:37:28", "text": "わかった。では、彼を"}, {"type": "subtitle", "time": 13051.91, "timestamp": "03:37:31", "text": "鎧とかそういう類？ギヤ。私は確信しています。私は"}, {"type": "subtitle", "time": 13059.67, "timestamp": "03:37:39", "text": "少し時間をください。病気"}, {"type": "subtitle", "time": 13062.389, "timestamp": "03:37:42", "text": "やってみて。私たちは冒険に出かけなければならない。"}, {"type": "subtitle", "time": 13064.63, "timestamp": "03:37:44", "text": "私たちはここで時間を過ごすつもりですか"}, {"type": "subtitle", "time": 13067.11, "timestamp": "03:37:47", "text": "小石を集めているの？あなたはなぜここにいるのですか？"}, {"type": "subtitle", "time": 13074.07, "timestamp": "03:37:54", "text": "矢印も同様です。"}, {"type": "subtitle", "time": 13076.87, "timestamp": "03:37:56", "text": "石のつるはし。"}]
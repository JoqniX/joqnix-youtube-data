[{"type": "subtitle", "time": 5105.709, "timestamp": "01:25:05", "text": "それから行く"}, {"type": "subtitle", "time": 5107.48, "timestamp": "01:25:07", "text": "行く 1"}, {"type": "subtitle", "time": 5109.32, "timestamp": "01:25:09", "text": "1 大学"}, {"type": "subtitle", "time": 5111.88, "timestamp": "01:25:11", "text": "大学 そこで追いかける"}, {"type": "subtitle", "time": 5115.719, "timestamp": "01:25:15", "text": "そこで追いかける 夢。だから、私は行く"}, {"type": "subtitle", "time": 5118.04, "timestamp": "01:25:18", "text": "夢。だから、私は行く 一生懸命働く。"}]
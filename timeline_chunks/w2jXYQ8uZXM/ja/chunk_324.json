[{"type": "subtitle", "time": 19441.91, "timestamp": "05:24:01", "text": "古代の破片を手に入れるつもりだ。あなたはできる"}, {"type": "subtitle", "time": 19449.67, "timestamp": "05:24:09", "text": "ええ、もう一つ作らなきゃ"}, {"type": "subtitle", "time": 19453.628, "timestamp": "05:24:13", "text": "別のもののようなビーコン"}, {"type": "subtitle", "time": 19456.788, "timestamp": "05:24:16", "text": "古代の休息地や島に行くとき、"}, {"type": "subtitle", "time": 19459.35, "timestamp": "05:24:19", "text": "最も遠くに見えるものは、"}, {"type": "subtitle", "time": 19461.91, "timestamp": "05:24:21", "text": "遺跡の正面？疑問符。"}, {"type": "subtitle", "time": 19465.03, "timestamp": "05:24:25", "text": "何？そこが私たちが好むべき点です。それで"}, {"type": "subtitle", "time": 19469.51, "timestamp": "05:24:29", "text": "その道具はどうやって使うのですか？"}, {"type": "subtitle", "time": 19474.708, "timestamp": "05:24:34", "text": "構築コアを入手する必要があります。"}]
[{"type": "subtitle", "time": 9780.5, "timestamp": "02:43:00", "text": "えっと、これを開けてみましょう。別の"}, {"type": "subtitle", "time": 9782.19, "timestamp": "02:43:02", "text": "[音楽]"}, {"type": "subtitle", "time": 9785.469, "timestamp": "02:43:05", "text": "ドレスを掛ける。あのね？"}, {"type": "subtitle", "time": 9798.03, "timestamp": "02:43:18", "text": "ハンガー。別の"}, {"type": "subtitle", "time": 9800.55, "timestamp": "02:43:20", "text": "ハンガー。携帯電話はどこですか？"}, {"type": "subtitle", "time": 9811.389, "timestamp": "02:43:31", "text": "下着。下着はここにあるはずです。"}, {"type": "subtitle", "time": 9818.91, "timestamp": "02:43:38", "text": "ここ。ああ、私たちは2つの同じものを手に入れました"}, {"type": "subtitle", "time": 9826.03, "timestamp": "02:43:46", "text": "色。あと2人。わかった。"}, {"type": "subtitle", "time": 9834.83, "timestamp": "02:43:54", "text": "誰がこんなことをするの？のように"}]
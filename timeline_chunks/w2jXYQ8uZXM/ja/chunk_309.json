[{"type": "subtitle", "time": 18545.83, "timestamp": "05:09:05", "text": "ボスの後は、私は小さな"}, {"type": "subtitle", "time": 18549.51, "timestamp": "05:09:09", "text": "レンガを焼いて、お茶を淹れよう。わかった。ああ、私は"}, {"type": "subtitle", "time": 18552.23, "timestamp": "05:09:12", "text": "思う"}, {"type": "subtitle", "time": 18554.788, "timestamp": "05:09:14", "text": "私のマナを忘れないで。えっと、私の鎧。うん、"}, {"type": "subtitle", "time": 18555.67, "timestamp": "05:09:15", "text": "持っています。持っています。私は行くつもりだった"}, {"type": "subtitle", "time": 18558.59, "timestamp": "05:09:18", "text": "逆向きに。"}, {"type": "subtitle", "time": 18566.07, "timestamp": "05:09:26", "text": "彼ら。全速力で。わかった。くそ。私たちは"}, {"type": "subtitle", "time": 18567.91, "timestamp": "05:09:27", "text": "橋に沿って進むだけで"}, {"type": "subtitle", "time": 18578.39, "timestamp": "05:09:38", "text": "それでいいと思います。"}, {"type": "subtitle", "time": 18580.868, "timestamp": "05:09:40", "text": "私は遺跡の仕事に行くだけです。心配しないで。"}, {"type": "subtitle", "time": 18582.47, "timestamp": "05:09:42", "text": "ちょっと失敗してしまったと思う。わかった。手に入れた"}, {"type": "subtitle", "time": 18586.55, "timestamp": "05:09:46", "text": "赤い卵。あなたは赤を手に入れました。私はちょっと"}, {"type": "subtitle", "time": 18588.39, "timestamp": "05:09:48", "text": "めちゃくちゃだ。"}, {"type": "subtitle", "time": 18590.99, "timestamp": "05:09:50", "text": "あなたは何をしましたか？私は"}]
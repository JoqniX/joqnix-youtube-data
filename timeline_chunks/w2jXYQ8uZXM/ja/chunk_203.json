[{"type": "subtitle", "time": 12181.67, "timestamp": "03:23:01", "text": "それを「眠れる魂」とでも呼ぼうか。何が"}, {"type": "subtitle", "time": 12185.11, "timestamp": "03:23:05", "text": "これをストリーミング配信しても大丈夫ですか？それは"}, {"type": "subtitle", "time": 12188.95, "timestamp": "03:23:08", "text": "デモ。これはデモ版です。ええ、それは"}, {"type": "subtitle", "time": 12191.03, "timestamp": "03:23:11", "text": "つまり、これをストリーミング配信しても大丈夫ってこと？何"}, {"type": "subtitle", "time": 12193.83, "timestamp": "03:23:13", "text": "それはどういう意味ですか？そうではないと思った"}, {"type": "subtitle", "time": 12196.87, "timestamp": "03:23:16", "text": "賭けは終了しました。ええ、大丈夫です。いいえ、いいえ、"}, {"type": "subtitle", "time": 12198.95, "timestamp": "03:23:18", "text": "これはオープンベータ版のオープンデモのようなもので、"}, {"type": "subtitle", "time": 12209.03, "timestamp": "03:23:29", "text": "スイッチ。装着した時の見た目を確認させてください"}, {"type": "subtitle", "time": 12210.58, "timestamp": "03:23:30", "text": "あなたの画面。"}, {"type": "subtitle", "time": 12212.99, "timestamp": "03:23:32", "text": "[音楽]"}, {"type": "subtitle", "time": 12217.429, "timestamp": "03:23:37", "text": "うん、僕たちは、もし僕がそれを壮大なものにしたらどうなるだろう？意思"}, {"type": "subtitle", "time": 12219.67, "timestamp": "03:23:39", "text": "それは要求ですか？"}, {"type": "subtitle", "time": 12222.309, "timestamp": "03:23:42", "text": "そうだったと思います。何てことだ。あなたはプレイしています"}, {"type": "subtitle", "time": 12226.59, "timestamp": "03:23:46", "text": "壮大な。動作が遅い。うん、"}, {"type": "subtitle", "time": 12232.429, "timestamp": "03:23:52", "text": "兄弟。あなたのDPRはいくつですか？何？ 30です"}, {"type": "subtitle", "time": 12238.15, "timestamp": "03:23:58", "text": "60. 動作が遅いだけです。うん。待って。 50 60。"}]
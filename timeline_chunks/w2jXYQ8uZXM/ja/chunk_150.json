[{"type": "subtitle", "time": 9005.23, "timestamp": "02:30:05", "text": "そして、完全に削除したくない"}, {"type": "subtitle", "time": 9038.71, "timestamp": "02:30:38", "text": "大丈夫。ああ、私ってすごく速い。ああ、私は"}, {"type": "subtitle", "time": 9041.91, "timestamp": "02:30:41", "text": "私はもう彼らに対して無敵だ。うん、"}, {"type": "subtitle", "time": 9044.87, "timestamp": "02:30:44", "text": "Hell Diverは明日のコラボ相手だった。神よ、私は"}, {"type": "subtitle", "time": 9052.15, "timestamp": "02:30:52", "text": "それ。私のPCには面白い事実があります"}, {"type": "subtitle", "time": 9055.95, "timestamp": "02:30:55", "text": "すでに80％に達している"}, {"type": "subtitle", "time": 9059.99, "timestamp": "02:30:59", "text": "非常識な。まったく信じられないよ、兄弟。狂気"}]
[{"type": "subtitle", "time": 5040.75, "timestamp": "01:24:00", "text": "と"}, {"type": "subtitle", "time": 5042.43, "timestamp": "01:24:02", "text": "それ。"}, {"type": "subtitle", "time": 5067.51, "timestamp": "01:24:27", "text": "神。あなたは大学生ですか、それとも"}, {"type": "subtitle", "time": 5069.51, "timestamp": "01:24:29", "text": "既に稼働中ですか？私は大学生です。"}, {"type": "subtitle", "time": 5070.83, "timestamp": "01:24:30", "text": "大学"}, {"type": "subtitle", "time": 5072.35, "timestamp": "01:24:32", "text": "学生。"}, {"type": "subtitle", "time": 5076.149, "timestamp": "01:24:36", "text": "大学生。私は行く予定です"}, {"type": "subtitle", "time": 5077.709, "timestamp": "01:24:37", "text": "日本"}, {"type": "subtitle", "time": 5081.95, "timestamp": "01:24:41", "text": "まもなく、"}, {"type": "subtitle", "time": 5084.59, "timestamp": "01:24:44", "text": "7月"}, {"type": "subtitle", "time": 5088.87, "timestamp": "01:24:48", "text": "そして私たちは勉強します、私はそこにいます"}, {"type": "subtitle", "time": 5092.149, "timestamp": "01:24:52", "text": "学習のために"}, {"type": "subtitle", "time": 5093.79, "timestamp": "01:24:53", "text": "えーと、"}, {"type": "subtitle", "time": 5096.43, "timestamp": "01:24:56", "text": "の"}, {"type": "subtitle", "time": 5097.73, "timestamp": "01:24:57", "text": "勉強"}, {"type": "subtitle", "time": 5099.229, "timestamp": "01:24:59", "text": "[音楽]"}]
[{"type": "subtitle", "time": 22202.51, "timestamp": "06:10:02", "text": "マシュマロ。私は始める"}, {"type": "subtitle", "time": 22205.67, "timestamp": "06:10:05", "text": "マシュマロだよ、わかるだろ？えっと、私は"}, {"type": "subtitle", "time": 22207.628, "timestamp": "06:10:07", "text": "マシュマロは"}, {"type": "subtitle", "time": 22210.83, "timestamp": "06:10:10", "text": "よく使われるもの"}, {"type": "subtitle", "time": 22214.548, "timestamp": "06:10:14", "text": "その他。ええ、そうしたいです。"}, {"type": "subtitle", "time": 22215.47, "timestamp": "06:10:15", "text": "する"}, {"type": "subtitle", "time": 22220.39, "timestamp": "06:10:20", "text": "それ。やりたいです。だから、私は"}, {"type": "subtitle", "time": 22223.83, "timestamp": "06:10:23", "text": "それ。質問があれば誰にでも答えたい"}, {"type": "subtitle", "time": 22226.39, "timestamp": "06:10:26", "text": "私にとってはそうだった。"}, {"type": "subtitle", "time": 22228.91, "timestamp": "06:10:28", "text": "それで、それで"}, {"type": "subtitle", "time": 22233.548, "timestamp": "06:10:33", "text": "えっと、ちょっと待って、マシュマロはブロックされてるの？"}, {"type": "subtitle", "time": 22236.15, "timestamp": "06:10:36", "text": "中国？ああ、それ調べてみないと。私"}, {"type": "subtitle", "time": 22238.708, "timestamp": "06:10:38", "text": "調べなきゃいけないな、私も"}, {"type": "subtitle", "time": 22241.47, "timestamp": "06:10:41", "text": "ビリーにも使って"}, {"type": "subtitle", "time": 22246.75, "timestamp": "06:10:46", "text": "未来。うん、そうするべきだね。それで、"}, {"type": "subtitle", "time": 22248.91, "timestamp": "06:10:48", "text": "ダイアナ。うん。待って。"}, {"type": "subtitle", "time": 22251.91, "timestamp": "06:10:51", "text": "えっと、マシュマロですよね？えっと、ちょっと待って"}, {"type": "subtitle", "time": 22259.708, "timestamp": "06:10:59", "text": "ああ、こんにちは。えっと、私はこうなります"}]
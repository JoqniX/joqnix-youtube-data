[{"type": "subtitle", "time": 18241.99, "timestamp": "05:04:01", "text": "ええ、彼は知らないんです、しばらく"}, {"type": "subtitle", "time": 18244.868, "timestamp": "05:04:04", "text": "前。"}, {"type": "subtitle", "time": 18248.07, "timestamp": "05:04:08", "text": "さぁ行こう。もっとグロウストーンを。"}, {"type": "subtitle", "time": 18250.868, "timestamp": "05:04:10", "text": "ああ、少し"}, {"type": "subtitle", "time": 18255.67, "timestamp": "05:04:15", "text": "そんなにたくさんの敵と戦うために、あなたはどこへ行ったのですか？"}, {"type": "subtitle", "time": 18257.27, "timestamp": "05:04:17", "text": "ごめん。"}, {"type": "subtitle", "time": 18261.19, "timestamp": "05:04:21", "text": "お大事に。お大事に。ありがとう。"}, {"type": "subtitle", "time": 18270.11, "timestamp": "05:04:30", "text": "ああ、オンボードを壊してしまった。"}, {"type": "subtitle", "time": 18273.75, "timestamp": "05:04:33", "text": "ニース。オンボード機器を何度も壊してしまう。"}, {"type": "subtitle", "time": 18287.07, "timestamp": "05:04:47", "text": "私は持っている"}, {"type": "subtitle", "time": 18297.11, "timestamp": "05:04:57", "text": "胸部2つ。ああ、マナが尽きてしまった。あなたは"}, {"type": "subtitle", "time": 18299.59, "timestamp": "05:04:59", "text": "みんな、マナ持ってる？そうしたいです。"}]
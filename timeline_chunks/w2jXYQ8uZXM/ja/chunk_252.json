[{"type": "subtitle", "time": 15129.429, "timestamp": "04:12:09", "text": "この男、本当にひどい。ママは筋肉質で"}, {"type": "subtitle", "time": 15133.67, "timestamp": "04:12:13", "text": "私の隣に立っている。ちくしょう。"}, {"type": "subtitle", "time": 15137.83, "timestamp": "04:12:17", "text": "ああ、ここが俺が死んだ場所だ。"}, {"type": "subtitle", "time": 15139.75, "timestamp": "04:12:19", "text": "うん。そして私は階段を作って"}, {"type": "subtitle", "time": 15142.59, "timestamp": "04:12:22", "text": "そこには。でも、荷物は手に入れることができます"}, {"type": "subtitle", "time": 15146.07, "timestamp": "04:12:26", "text": "実は。木材をくれ。私は行くつもりです"}, {"type": "subtitle", "time": 15148.07, "timestamp": "04:12:28", "text": "それを得る。"}, {"type": "subtitle", "time": 15156.55, "timestamp": "04:12:36", "text": "またかよ、兄弟？何が問題なの？"}, {"type": "subtitle", "time": 15158.309, "timestamp": "04:12:38", "text": "このゲーム？"}, {"type": "subtitle", "time": 15171.67, "timestamp": "04:12:51", "text": "二度と死なないでくれ。ああ、なんてこった。彼"}, {"type": "subtitle", "time": 15175.269, "timestamp": "04:12:55", "text": "死亡したのはたった2回だけだ。 2回。私は思う"}]
[{"type": "subtitle", "time": 17227.47, "timestamp": "04:47:07", "text": "わかった。あなたは私をブロックしましたね。あ、すみません。"}, {"type": "subtitle", "time": 17230.39, "timestamp": "04:47:10", "text": "ごめん。いい考えがある。これを削除してください。"}, {"type": "subtitle", "time": 17235.59, "timestamp": "04:47:15", "text": "これを削除してください。動かさないでください。うん。"}, {"type": "subtitle", "time": 17239.27, "timestamp": "04:47:19", "text": "もうすぐ着く？はい。うん。えっと、"}, {"type": "subtitle", "time": 17246.628, "timestamp": "04:47:26", "text": "階段をいくつか作ってください。くそ"}, {"type": "subtitle", "time": 17249.59, "timestamp": "04:47:29", "text": "恥ずかしい。そちらは元気ですか？"}, {"type": "subtitle", "time": 17252.47, "timestamp": "04:47:32", "text": "うん、"}, {"type": "subtitle", "time": 17254.948, "timestamp": "04:47:34", "text": "もうすぐだ。プラットフォームを作成する"}, {"type": "subtitle", "time": 17257.67, "timestamp": "04:47:37", "text": "その後。まるで間違った方法で建てたようなものだ。 A"}, {"type": "subtitle", "time": 17263.67, "timestamp": "04:47:43", "text": "上。ええ、そうです。プラットフォームを作成する"}, {"type": "subtitle", "time": 17267.75, "timestamp": "04:47:47", "text": "今すぐ出発できるように。なんてこった。いいえ、"}, {"type": "subtitle", "time": 17275.99, "timestamp": "04:47:55", "text": "うん。ああ、なんてことだ、90年代だ。"}]
[{"type": "subtitle", "time": 7631.189, "timestamp": "02:07:11", "text": "ソーシャルストリームも良いですね。私は手に入れることができます"}, {"type": "subtitle", "time": 7633.75, "timestamp": "02:07:13", "text": "イベントやその他すべて、チャットや"}, {"type": "subtitle", "time": 7636.069, "timestamp": "02:07:16", "text": "何もせずに瞬時に"}, {"type": "subtitle", "time": 7637.709, "timestamp": "02:07:17", "text": "生きるか"}, {"type": "subtitle", "time": 7653.189, "timestamp": "02:07:33", "text": "瞬時に。ビリーはどこにいるの？"}, {"type": "subtitle", "time": 7675.27, "timestamp": "02:07:55", "text": "チャット。待って、請求対象を追加するにはどうすればいいですか？"}]
[{"type": "subtitle", "time": 4895.229, "timestamp": "01:21:35", "text": "えっと、なんていう名前でしたっけ？えっと、チャット"}, {"type": "subtitle", "time": 4897.43, "timestamp": "01:21:37", "text": "ユーザー名。残念ながら私には理解できません"}, {"type": "subtitle", "time": 4899.99, "timestamp": "01:21:39", "text": "配信者が言っていること。ああ、それは"}, {"type": "subtitle", "time": 4902.95, "timestamp": "01:21:42", "text": "わかった。ごめんなさい。私はただ話しているだけです"}, {"type": "subtitle", "time": 4904.99, "timestamp": "01:21:44", "text": "自分自身。心配しないでください"}]
[{"type": "subtitle", "time": 22323.31, "timestamp": "06:12:03", "text": "えっと、リンクを送れると思います"}, {"type": "subtitle", "time": 22333.43, "timestamp": "06:12:13", "text": "えーと、説明欄のコメントと"}, {"type": "subtitle", "time": 22336.15, "timestamp": "06:12:16", "text": "Twitchにも投稿しておきます"}, {"type": "subtitle", "time": 22339.23, "timestamp": "06:12:19", "text": "将来的にはパネルディスカッションの場として。わかった。"}, {"type": "subtitle", "time": 22341.39, "timestamp": "06:12:21", "text": "[音楽]"}, {"type": "subtitle", "time": 22345.708, "timestamp": "06:12:25", "text": "えっと、もし誰か空いていたら"}, {"type": "subtitle", "time": 22350.11, "timestamp": "06:12:30", "text": "さあ、マシュマロを送ってくれ。待って、"}, {"type": "subtitle", "time": 22360.35, "timestamp": "06:12:40", "text": "うん。手配する必要がある"}, {"type": "subtitle", "time": 22362.67, "timestamp": "06:12:42", "text": "私の"}, {"type": "subtitle", "time": 22374.43, "timestamp": "06:12:54", "text": "メッセージと"}]
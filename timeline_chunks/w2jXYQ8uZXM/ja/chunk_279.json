[{"type": "subtitle", "time": 16749.51, "timestamp": "04:39:09", "text": "彼は一体何を言っているんだ？"}, {"type": "subtitle", "time": 16757.269, "timestamp": "04:39:17", "text": "確認しただけです。"}, {"type": "subtitle", "time": 16759.869, "timestamp": "04:39:19", "text": "何か話してたの？いいえ、"}, {"type": "subtitle", "time": 16763.59, "timestamp": "04:39:23", "text": "チェック中。何てことだ。"}, {"type": "subtitle", "time": 16765.59, "timestamp": "04:39:25", "text": "くそっ、ジョギングめ。私はあなたが"}, {"type": "subtitle", "time": 16767.75, "timestamp": "04:39:27", "text": "こんな感じ、こんな感じ。"}, {"type": "subtitle", "time": 16771.07, "timestamp": "04:39:31", "text": "何てことだ。この"}, {"type": "subtitle", "time": 16774.07, "timestamp": "04:39:34", "text": "だから、あなたを見てみろと言いたいんです。あなたは"}, {"type": "subtitle", "time": 16778.83, "timestamp": "04:39:38", "text": "冗談について話している。私はそう言う"}, {"type": "subtitle", "time": 16782.47, "timestamp": "04:39:42", "text": "ああ、雷に吹き飛ばされそうだ。"}, {"type": "subtitle", "time": 16792.07, "timestamp": "04:39:52", "text": "えっと、あ、待って。マナみたいなものがある"}, {"type": "subtitle", "time": 16799.11, "timestamp": "04:39:59", "text": "紫色ですか？そうなんですか？青色です。どのように"}]
[{"type": "subtitle", "time": 19140.11, "timestamp": "05:19:00", "text": "ああ、Vを手に入れた"}, {"type": "subtitle", "time": 19143.47, "timestamp": "05:19:03", "text": "また。ちょうど手に入れた"}, {"type": "subtitle", "time": 19156.15, "timestamp": "05:19:16", "text": "同じようなタイプの男性には手を出さない方がいいよ。しないで"}, {"type": "subtitle", "time": 19161.99, "timestamp": "05:19:21", "text": "それ。私はまた別のサメに怯えている。しかし"}, {"type": "subtitle", "time": 19164.31, "timestamp": "05:19:24", "text": "もう一つの箱はどこですか？"}, {"type": "subtitle", "time": 19165.788, "timestamp": "05:19:25", "text": "の前に"}, {"type": "subtitle", "time": 19173.55, "timestamp": "05:19:33", "text": "そう願っています。私は"}, {"type": "subtitle", "time": 19195.07, "timestamp": "05:19:55", "text": "ああ、私は死んだ。兄弟、これ"}, {"type": "subtitle", "time": 19198.868, "timestamp": "05:19:58", "text": "サメ。 1馬力。 1馬力。 1馬力。彼はそうではない"}]
[{"type": "subtitle", "time": 5583.229, "timestamp": "01:33:03", "text": "統合"}, {"type": "subtitle", "time": 5585.87, "timestamp": "01:33:05", "text": "ラボレス"}, {"type": "subtitle", "time": 5588.709, "timestamp": "01:33:08", "text": "ライブ。こんにちは。"}, {"type": "subtitle", "time": 5590.11, "timestamp": "01:33:10", "text": "それで"}, {"type": "subtitle", "time": 5595.47, "timestamp": "01:33:15", "text": "えっと、こんにちは、私は配信しています"}, {"type": "subtitle", "time": 5601.51, "timestamp": "01:33:21", "text": "信じられないことに、そして私は知っています、"}, {"type": "subtitle", "time": 5602.83, "timestamp": "01:33:22", "text": "少し"}, {"type": "subtitle", "time": 5604.99, "timestamp": "01:33:24", "text": "数"}, {"type": "subtitle", "time": 5608.669, "timestamp": "01:33:28", "text": "ストリーマーは"}, {"type": "subtitle", "time": 5612.31, "timestamp": "01:33:32", "text": "えーと、非ネイティブ"}, {"type": "subtitle", "time": 5618.07, "timestamp": "01:33:38", "text": "えーと、中国人、えーと、非ネイティブ、えーと、えーと、誰？"}, {"type": "subtitle", "time": 5624.79, "timestamp": "01:33:44", "text": "また、ストリーミングにも参入しようとしている"}, {"type": "subtitle", "time": 5625.709, "timestamp": "01:33:45", "text": "ビリー"}, {"type": "subtitle", "time": 5634.229, "timestamp": "01:33:54", "text": "えーと、それで、私もできる方法を探していたんです"}, {"type": "subtitle", "time": 5638.79, "timestamp": "01:33:58", "text": "方法を探していたので、えーとビリー、えーと私は"}]
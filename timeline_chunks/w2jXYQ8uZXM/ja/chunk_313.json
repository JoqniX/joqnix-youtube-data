[{"type": "subtitle", "time": 18782.39, "timestamp": "05:13:02", "text": "クソ神様。あの野郎。幾つか"}, {"type": "subtitle", "time": 18784.948, "timestamp": "05:13:04", "text": "注射？この緑色のネズミが開いています。何"}, {"type": "subtitle", "time": 18786.03, "timestamp": "05:13:06", "text": "の"}, {"type": "subtitle", "time": 18788.628, "timestamp": "05:13:08", "text": "くそ？ここに来て。あいつをぶっ飛ばせ。来る"}, {"type": "subtitle", "time": 18790.35, "timestamp": "05:13:10", "text": "ここ。これ"}, {"type": "subtitle", "time": 18799.51, "timestamp": "05:13:19", "text": "だが、君はとんでもない相手に手を出した"}, {"type": "subtitle", "time": 18802.39, "timestamp": "05:13:22", "text": "パーティーだ、馬鹿者め。ああ、ジョーはどこ？私にさせて"}, {"type": "subtitle", "time": 18806.47, "timestamp": "05:13:26", "text": "ヘルプ。ああ、ジョーがいる。そうそう。"}, {"type": "subtitle", "time": 18809.47, "timestamp": "05:13:29", "text": "また、"}, {"type": "subtitle", "time": 18812.15, "timestamp": "05:13:32", "text": "ちなみに、そういうことです。水。うん。"}, {"type": "subtitle", "time": 18815.03, "timestamp": "05:13:35", "text": "水。ああ、水の件ね。"}, {"type": "subtitle", "time": 18818.31, "timestamp": "05:13:38", "text": "私は死んだ。"}, {"type": "subtitle", "time": 18821.868, "timestamp": "05:13:41", "text": "よし、ボスと戦おう。来る"}, {"type": "subtitle", "time": 18826.39, "timestamp": "05:13:46", "text": "の上。ああ、そうだよ。あ、そういえば、"}, {"type": "subtitle", "time": 18832.67, "timestamp": "05:13:52", "text": "鎧。ここで私たちは"}, {"type": "subtitle", "time": 18836.31, "timestamp": "05:13:56", "text": "行く。それを装備します。くそ。なぜあなたの"}, {"type": "subtitle", "time": 18838.99, "timestamp": "05:13:58", "text": "髪　ああ、そうだね。あなたは自分の効果を変えます。"}]
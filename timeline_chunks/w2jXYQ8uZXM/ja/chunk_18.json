[{"type": "subtitle", "time": 1085.95, "timestamp": "00:18:05", "text": "ああ、あなたは言わなかった"}, {"type": "subtitle", "time": 1088.31, "timestamp": "00:18:08", "text": "それ。ご気分はいかがですか？私は感じています"}, {"type": "subtitle", "time": 1090.669, "timestamp": "00:18:10", "text": "今日は良い日でした。"}, {"type": "subtitle", "time": 1097.63, "timestamp": "00:18:17", "text": "なぜなら"}, {"type": "subtitle", "time": 1099.95, "timestamp": "00:18:19", "text": "彼女"}, {"type": "subtitle", "time": 1108.909, "timestamp": "00:18:28", "text": "なぜ？なぜ全部取ってしまうの？"}, {"type": "subtitle", "time": 1111.909, "timestamp": "00:18:31", "text": "もの？えーっと、とにかく、アップロードしないといけないんです"}, {"type": "subtitle", "time": 1113.39, "timestamp": "00:18:33", "text": "えーと、ヴォード、"}, {"type": "subtitle", "time": 1130.029, "timestamp": "00:18:50", "text": "V"}, {"type": "subtitle", "time": 1137.75, "timestamp": "00:18:57", "text": "昨日の物？"}]
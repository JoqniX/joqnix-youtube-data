[{"type": "subtitle", "time": 19505.43, "timestamp": "05:25:05", "text": "うん。"}, {"type": "subtitle", "time": 19515.83, "timestamp": "05:25:15", "text": "そのコンセプト全体がかなり重い。彼らは"}, {"type": "subtitle", "time": 19517.31, "timestamp": "05:25:17", "text": "ほとんど全部"}, {"type": "subtitle", "time": 19520.788, "timestamp": "05:25:20", "text": "私の持ち物。ここに置いてください。うん。それを置いて"}, {"type": "subtitle", "time": 19530.55, "timestamp": "05:25:30", "text": "エンジンの破片が山ほどある。"}, {"type": "subtitle", "time": 19553.91, "timestamp": "05:25:53", "text": "これは何ですか？ありがとう。"}]
[{"type": "subtitle", "time": 13150.51, "timestamp": "03:39:10", "text": "ああ、動作がすごく遅い。わかった。"}, {"type": "subtitle", "time": 13159.349, "timestamp": "03:39:19", "text": "好きなように建築してください"}, {"type": "subtitle", "time": 13161.75, "timestamp": "03:39:21", "text": "作る。それはまるで全ての力、全ての"}, {"type": "subtitle", "time": 13169.349, "timestamp": "03:39:29", "text": "欲しい。持久力。"}, {"type": "subtitle", "time": 13171.349, "timestamp": "03:39:31", "text": "えっと、これのために包帯を作ってあげましょう"}, {"type": "subtitle", "time": 13196.389, "timestamp": "03:39:56", "text": "どこでその材料を手に入れたのですか？"}, {"type": "subtitle", "time": 13199.07, "timestamp": "03:39:59", "text": "ああ、もう少し短くしてください。そしてあなたは"}]
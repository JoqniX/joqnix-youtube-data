[{"type": "subtitle", "time": 15420.71, "timestamp": "04:17:00", "text": "今こそ、再び立ち上がらなければならない。おお、"}, {"type": "subtitle", "time": 15429.349, "timestamp": "04:17:09", "text": "エンジンの話に戻りましょう。少し使ってみてください。そうでしょう"}, {"type": "subtitle", "time": 15431.59, "timestamp": "04:17:11", "text": "包帯みたいなものを持ってる？"}, {"type": "subtitle", "time": 15434.79, "timestamp": "04:17:14", "text": "ええ、いくつか使ってみます。うん、そうするよ"}, {"type": "subtitle", "time": 15447.91, "timestamp": "04:17:27", "text": "さあ、行こう。来て。よし。"}, {"type": "subtitle", "time": 15449.55, "timestamp": "04:17:29", "text": "ジョーはどこ？"}, {"type": "subtitle", "time": 15451.59, "timestamp": "04:17:31", "text": "行くの？どこに行くの？どこで"}, {"type": "subtitle", "time": 15453.59, "timestamp": "04:17:33", "text": "みんな行く？"}, {"type": "subtitle", "time": 15456.389, "timestamp": "04:17:36", "text": "どこにいるの？今行ってる。今行ってる。"}, {"type": "subtitle", "time": 15458.07, "timestamp": "04:17:38", "text": "洞窟。"}, {"type": "subtitle", "time": 15460.149, "timestamp": "04:17:40", "text": "ああ、私はその洞窟を見ませんでした。私は"}, {"type": "subtitle", "time": 15463.469, "timestamp": "04:17:43", "text": "別の方法。ああ、"}, {"type": "subtitle", "time": 15466.309, "timestamp": "04:17:46", "text": "神。なぜそんなに体調が悪いのですか？食べる"}, {"type": "subtitle", "time": 15469.07, "timestamp": "04:17:49", "text": "何かあるんだよ、相棒。"}, {"type": "subtitle", "time": 15472.79, "timestamp": "04:17:52", "text": "ええ、食べましたよ。お腹がいっぱいです。私"}, {"type": "subtitle", "time": 15474.189, "timestamp": "04:17:54", "text": "なぜそうしないのか分からない"}, {"type": "subtitle", "time": 15477.11, "timestamp": "04:17:57", "text": "再生中。それは無料の体力回復ですか？"}]
[{"type": "subtitle", "time": 4080.39, "timestamp": "01:08:00", "text": "ああ。えっと、ラボとライブの開発者に聞いてみるべきでしょうか？"}, {"type": "subtitle", "time": 4082.109, "timestamp": "01:08:02", "text": "について"}, {"type": "subtitle", "time": 4088.309, "timestamp": "01:08:08", "text": "これ？えっと、待って。えっと、アンカー。えっと"}, {"type": "subtitle", "time": 4091.589, "timestamp": "01:08:11", "text": "アンカーと一緒にいたい、"}, {"type": "subtitle", "time": 4095.75, "timestamp": "01:08:15", "text": "友達になれて、君は素晴らしい人だ。"}, {"type": "subtitle", "time": 4098.789, "timestamp": "01:08:18", "text": "いいですか？ええ、もちろんです。私と話してもいいですよ"}, {"type": "subtitle", "time": 4101.55, "timestamp": "01:08:21", "text": "チャットでのやり取りなど。いいえ"}, {"type": "subtitle", "time": 4105.229, "timestamp": "01:08:25", "text": "心配事。うん、君"}, {"type": "subtitle", "time": 4116.709, "timestamp": "01:08:36", "text": "ええと、彼らは限界を知っています"}, {"type": "subtitle", "time": 4119.709, "timestamp": "01:08:39", "text": "通信で許可されている"}, {"type": "subtitle", "time": 4135.789, "timestamp": "01:08:55", "text": "リスク？どこの出身ですか？私は"}, {"type": "subtitle", "time": 4137.55, "timestamp": "01:08:57", "text": "インド。"}]
[{"type": "subtitle", "time": 18302.31, "timestamp": "05:05:02", "text": "ええ、胸部にあります。ありがとう。取る"}, {"type": "subtitle", "time": 18305.67, "timestamp": "05:05:05", "text": "この箱から取り出してください。マナ、オー"}, {"type": "subtitle", "time": 18308.15, "timestamp": "05:05:08", "text": "なんてこった、彼はものすごい魔力を持っている。"}, {"type": "subtitle", "time": 18310.868, "timestamp": "05:05:10", "text": "私は大量のマナを投入した。"}, {"type": "subtitle", "time": 18312.35, "timestamp": "05:05:12", "text": "クソッ"}, {"type": "subtitle", "time": 18314.51, "timestamp": "05:05:14", "text": "地獄。ここで私たちは"}, {"type": "subtitle", "time": 18318.03, "timestamp": "05:05:18", "text": "行く。えっと、"}, {"type": "subtitle", "time": 18321.35, "timestamp": "05:05:21", "text": "息切れ。胸当てがあります。"}, {"type": "subtitle", "time": 18324.948, "timestamp": "05:05:24", "text": "わかった、行くよ。バイバイ。"}, {"type": "subtitle", "time": 18329.19, "timestamp": "05:05:29", "text": "一人でちゃんと航海できるだろうか？うん。"}, {"type": "subtitle", "time": 18331.03, "timestamp": "05:05:31", "text": "わかった、こっちに戻ってきて。我々は来る"}, {"type": "subtitle", "time": 18334.23, "timestamp": "05:05:34", "text": "戻る。私はゲーマーです。私はゲーマーです。しないで"}, {"type": "subtitle", "time": 18337.11, "timestamp": "05:05:37", "text": "ゲームの持つ力を過小評価する。できる"}, {"type": "subtitle", "time": 18339.83, "timestamp": "05:05:39", "text": "ワインをいくつかいただけますか？"}, {"type": "subtitle", "time": 18341.948, "timestamp": "05:05:41", "text": "草。"}, {"type": "subtitle", "time": 18350.47, "timestamp": "05:05:50", "text": "胸にオイルを塗るか、オーケー、"}, {"type": "subtitle", "time": 18353.67, "timestamp": "05:05:53", "text": "99 を渡したと思います。"}, {"type": "subtitle", "time": 18355.75, "timestamp": "05:05:55", "text": "彼ら。"}, {"type": "subtitle", "time": 18357.67, "timestamp": "05:05:57", "text": "ええ、もう少し必要です。 1つ欲しい"}]
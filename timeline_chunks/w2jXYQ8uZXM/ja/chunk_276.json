[{"type": "subtitle", "time": 16562.629, "timestamp": "04:36:02", "text": "戻る。犬。犬。ちょっと待ってください。おお、"}, {"type": "subtitle", "time": 16565.709, "timestamp": "04:36:05", "text": "起きました。私が代わりにやってあ​​げましょう。"}, {"type": "subtitle", "time": 16569.429, "timestamp": "04:36:09", "text": "ああ、兄弟。私のためにやってくれてもいいですよ。そうそう。"}, {"type": "subtitle", "time": 16571.51, "timestamp": "04:36:11", "text": "それはすばらしい。"}, {"type": "subtitle", "time": 16573.51, "timestamp": "04:36:13", "text": "あそこに君の死体が見えるよ。あなた"}, {"type": "subtitle", "time": 16575.75, "timestamp": "04:36:15", "text": "私が死んだのと同じ場所で亡くなった。うん。私"}, {"type": "subtitle", "time": 16578.029, "timestamp": "04:36:18", "text": "我々は作り出す必要があると思う"}, {"type": "subtitle", "time": 16589.269, "timestamp": "04:36:29", "text": "いいえ。あなたは眠らなかったのですか？"}, {"type": "subtitle", "time": 16592.629, "timestamp": "04:36:32", "text": "誰も眠らなかった。"}, {"type": "subtitle", "time": 16594.589, "timestamp": "04:36:34", "text": "は"}, {"type": "subtitle", "time": 16596.39, "timestamp": "04:36:36", "text": "[音楽]"}, {"type": "subtitle", "time": 16598.07, "timestamp": "04:36:38", "text": "また。"}, {"type": "subtitle", "time": 16600.869, "timestamp": "04:36:40", "text": "はい。"}, {"type": "subtitle", "time": 16604.789, "timestamp": "04:36:44", "text": "なぜ私たちはこんなにも多く死んでいくのか？なぜ私たちは"}, {"type": "subtitle", "time": 16607.429, "timestamp": "04:36:47", "text": "あなたの声が途切れています。えっと、私の声"}, {"type": "subtitle", "time": 16609.67, "timestamp": "04:36:49", "text": "別れようとしている。ちょっと待って、みんな。あなたはしない"}, {"type": "subtitle", "time": 16611.67, "timestamp": "04:36:51", "text": "私の声が途切れているのが聞こえますか？"}, {"type": "subtitle", "time": 16614.349, "timestamp": "04:36:54", "text": "いいえ、いいえ、実際にはそうではありません。何てことだ。"}]
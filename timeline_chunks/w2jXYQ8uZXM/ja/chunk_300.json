[{"type": "subtitle", "time": 18004.47, "timestamp": "05:00:04", "text": "これで十分かもしれない。私は手に入れた"}, {"type": "subtitle", "time": 18017.11, "timestamp": "05:00:17", "text": "わかった。わかった。マナはどれくらいあるか"}, {"type": "subtitle", "time": 18026.67, "timestamp": "05:00:26", "text": "ここ？"}, {"type": "subtitle", "time": 18031.91, "timestamp": "05:00:31", "text": "マナは必要ですか？マナはありますか？いいえ。"}, {"type": "subtitle", "time": 18035.19, "timestamp": "05:00:35", "text": "わかった。 1 2 3。おそらく必要"}, {"type": "subtitle", "time": 18037.03, "timestamp": "05:00:37", "text": "敵を何人か殺しに行く。私は行きます"}, {"type": "subtitle", "time": 18043.51, "timestamp": "05:00:43", "text": "君たちも敵を倒す"}, {"type": "subtitle", "time": 18047.91, "timestamp": "05:00:47", "text": "マナを得る方法。 20～30マナは"}]
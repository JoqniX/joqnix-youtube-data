[{"type": "subtitle", "time": 14942.469, "timestamp": "04:09:02", "text": "私たちが山から登ってきた地域。うん、"}, {"type": "subtitle", "time": 14943.71, "timestamp": "04:09:03", "text": "来て"}, {"type": "subtitle", "time": 14948.71, "timestamp": "04:09:08", "text": "そこには。この男、すごいな。神に誓って。"}, {"type": "subtitle", "time": 14950.63, "timestamp": "04:09:10", "text": "ところで、シフトしてジャンプすると"}, {"type": "subtitle", "time": 14953.11, "timestamp": "04:09:13", "text": "同時に、チャンネルは"}, {"type": "subtitle", "time": 14956.07, "timestamp": "04:09:16", "text": "そこまで落ちぶれるのか。うん。"}, {"type": "subtitle", "time": 14957.99, "timestamp": "04:09:17", "text": "君はそれに気づいてる？もちろんそうでしょう。"}, {"type": "subtitle", "time": 14962.469, "timestamp": "04:09:22", "text": "ええ、そうしました。もちろんそうです。私は"}, {"type": "subtitle", "time": 14966.07, "timestamp": "04:09:26", "text": "ゲーマー。私にとって何の関係があるの？何を期待していたのですか？"}, {"type": "subtitle", "time": 14967.59, "timestamp": "04:09:27", "text": "私が言いたいのはそういうことです。そしてそれが"}, {"type": "subtitle", "time": 14970.79, "timestamp": "04:09:30", "text": "君のことは知っていた。"}, {"type": "subtitle", "time": 14984.11, "timestamp": "04:09:44", "text": "さあ、行こう。冒険に出かけよう"}, {"type": "subtitle", "time": 14987.349, "timestamp": "04:09:47", "text": "手渡されるのを待っている。光沢がある。私"}, {"type": "subtitle", "time": 14989.83, "timestamp": "04:09:49", "text": "亡くなった。ああ。"}, {"type": "subtitle", "time": 14995.83, "timestamp": "04:09:55", "text": "ああ、なんてことだ。イリード。私は飛び降りようとした。私は試した"}, {"type": "subtitle", "time": 14998.79, "timestamp": "04:09:58", "text": "クソ野郎。待って。私は失くしません"}]
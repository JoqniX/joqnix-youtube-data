[{"type": "subtitle", "time": 5343.39, "timestamp": "01:29:03", "text": "ええ、彼らはGPLライセンスです"}, {"type": "subtitle", "time": 5346.669, "timestamp": "01:29:06", "text": "ライセンス。つまり、それは実際の会社ではないということです。"}, {"type": "subtitle", "time": 5350.229, "timestamp": "01:29:10", "text": "会社っぽい。それはむしろプロジェクトに近い"}, {"type": "subtitle", "time": 5354.189, "timestamp": "01:29:14", "text": "またはライセンスに基づくプログラム"}, {"type": "subtitle", "time": 5371.229, "timestamp": "01:29:31", "text": "なぜ私が人々に尋ねる必要があるのか"}, {"type": "subtitle", "time": 5380.91, "timestamp": "01:29:40", "text": "えっと、ストリーマーボットなら"}]
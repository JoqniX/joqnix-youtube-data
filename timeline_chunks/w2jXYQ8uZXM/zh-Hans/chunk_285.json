[{"type": "subtitle", "time": 17102.31, "timestamp": "04:45:02", "text": "难道没有更好的楼梯吗？这"}, {"type": "subtitle", "time": 17105.51, "timestamp": "04:45:05", "text": "楼梯坏了。"}, {"type": "subtitle", "time": 17113.67, "timestamp": "04:45:13", "text": "我们终于完成了我们开始的事情。但是我们"}, {"type": "subtitle", "time": 17119.11, "timestamp": "04:45:19", "text": "它。我们的呢？哦，我们的坏了。"}, {"type": "subtitle", "time": 17122.948, "timestamp": "04:45:22", "text": "宝贝。是的，我到家了。我希望你也希望"}, {"type": "subtitle", "time": 17143.43, "timestamp": "04:45:43", "text": "那里。好的，让我看看。真他妈的"}, {"type": "subtitle", "time": 17151.39, "timestamp": "04:45:51", "text": "什么"}, {"type": "subtitle", "time": 17155.03, "timestamp": "04:45:55", "text": "发生了吗？嗨，你说得对。哇。哦，"}, {"type": "subtitle", "time": 17158.31, "timestamp": "04:45:58", "text": "看。伊德里斯也在那里。就像一个小过"}]
[{"type": "subtitle", "time": 17707.35, "timestamp": "04:55:07", "text": "我们甚至还没跟蛇交过手呢。我们"}, {"type": "subtitle", "time": 17720.868, "timestamp": "04:55:20", "text": "蛇。你们知道哪里可以买到吗？"}, {"type": "subtitle", "time": 17723.708, "timestamp": "04:55:23", "text": "锋利的石头？"}, {"type": "subtitle", "time": 17727.19, "timestamp": "04:55:27", "text": "如何获得深海潜航？哦，我有"}, {"type": "subtitle", "time": 17730.708, "timestamp": "04:55:30", "text": "现在就可以去刷这些boss了。"}, {"type": "subtitle", "time": 17735.07, "timestamp": "04:55:35", "text": "而且您可以免费维修您的物品。"}, {"type": "subtitle", "time": 17737.99, "timestamp": "04:55:37", "text": "是的。你还有什么要说的？这"}, {"type": "subtitle", "time": 17741.75, "timestamp": "04:55:41", "text": "锋利的石头状物体。黑色的石头。"}, {"type": "subtitle", "time": 17746.75, "timestamp": "04:55:46", "text": "呃，我觉得是在另一份个人简介里。"}, {"type": "subtitle", "time": 17749.59, "timestamp": "04:55:49", "text": "哦，还有，我们唯一能得到它的方法就是"}, {"type": "subtitle", "time": 17758.708, "timestamp": "04:55:58", "text": "哦，是的。"}]
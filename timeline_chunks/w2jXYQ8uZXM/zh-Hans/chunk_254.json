[{"type": "subtitle", "time": 15240.03, "timestamp": "04:14:00", "text": "所以，等等。"}, {"type": "subtitle", "time": 15242.67, "timestamp": "04:14:02", "text": "嗯，问个问题。"}, {"type": "subtitle", "time": 15246.429, "timestamp": "04:14:06", "text": "嗯，我可以吗？"}, {"type": "subtitle", "time": 15250.07, "timestamp": "04:14:10", "text": "等不及了？那里有一个图腾"}, {"type": "subtitle", "time": 15252.189, "timestamp": "04:14:12", "text": "那种东西。那是什么意思？"}, {"type": "subtitle", "time": 15254.87, "timestamp": "04:14:14", "text": "你的图腾。"}, {"type": "subtitle", "time": 15256.63, "timestamp": "04:14:16", "text": "是的，那里有一种图腾之类的东西。"}, {"type": "subtitle", "time": 15259.51, "timestamp": "04:14:19", "text": "错误的方法。"}, {"type": "subtitle", "time": 15261.75, "timestamp": "04:14:21", "text": "是的，我知道。"}, {"type": "subtitle", "time": 15265.389, "timestamp": "04:14:25", "text": "是的。你为什么要回家？我到达了目的地"}, {"type": "subtitle", "time": 15269.189, "timestamp": "04:14:29", "text": "图腾。我无法找回我的物品。相同的。我"}, {"type": "subtitle", "time": 15273.07, "timestamp": "04:14:33", "text": "做不到。我的东西都拿到了。"}, {"type": "subtitle", "time": 15277.429, "timestamp": "04:14:37", "text": "你看，我遭到攻击了。他们已经死了"}, {"type": "subtitle", "time": 15278.99, "timestamp": "04:14:38", "text": "再次。"}, {"type": "subtitle", "time": 15283.03, "timestamp": "04:14:43", "text": "好了，我获得法力了。"}, {"type": "subtitle", "time": 15285.51, "timestamp": "04:14:45", "text": "好吧，看来你还得再来一次。"}, {"type": "subtitle", "time": 15287.189, "timestamp": "04:14:47", "text": "不，不，不。等等，等等，等等，等等。我是"}, {"type": "subtitle", "time": 15290.71, "timestamp": "04:14:50", "text": "我要杀了这些人。有类似"}, {"type": "subtitle", "time": 15293.429, "timestamp": "04:14:53", "text": "下面有八个。我能看到。"}, {"type": "subtitle", "time": 15295.51, "timestamp": "04:14:55", "text": "是的。"}, {"type": "subtitle", "time": 15298.79, "timestamp": "04:14:58", "text": "去了哪里？哦，它就在上面。"}]
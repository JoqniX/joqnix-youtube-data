[{"type": "subtitle", "time": 14042.229, "timestamp": "03:54:02", "text": "我的上帝。我们走吧。是的。来吧，伙计们。"}, {"type": "subtitle", "time": 14048.229, "timestamp": "03:54:08", "text": "好的。"}, {"type": "subtitle", "time": 14049.85, "timestamp": "03:54:09", "text": "是的。"}, {"type": "subtitle", "time": 14051.269, "timestamp": "03:54:11", "text": "[音乐]"}, {"type": "subtitle", "time": 14054.229, "timestamp": "03:54:14", "text": "跟我来。我们只是如果你按赞"}, {"type": "subtitle", "time": 14056.55, "timestamp": "03:54:16", "text": "M，你应该明白我们该往哪走。喜欢"}, {"type": "subtitle", "time": 14059.11, "timestamp": "03:54:19", "text": "这里存在一些疑问。在哪里"}, {"type": "subtitle", "time": 14062.229, "timestamp": "03:54:22", "text": "我该装上盾牌吗？船。哦，不。不是"}, {"type": "subtitle", "time": 14064.15, "timestamp": "03:54:24", "text": "船夫。所以，我们首先需要……"}, {"type": "subtitle", "time": 14066.71, "timestamp": "03:54:26", "text": "把问号放在这个上面"}, {"type": "subtitle", "time": 14069.59, "timestamp": "03:54:29", "text": "这个地方。之后，我们会把"}, {"type": "subtitle", "time": 14074.15, "timestamp": "03:54:34", "text": "双方。好的。我该如何放置我的"}, {"type": "subtitle", "time": 14077.99, "timestamp": "03:54:37", "text": "呃，给自己身上加个防护罩？正确的。"}, {"type": "subtitle", "time": 14082.389, "timestamp": "03:54:42", "text": "是哪个按钮？盾牌"}, {"type": "subtitle", "time": 14084.389, "timestamp": "03:54:44", "text": "您的库存。"}, {"type": "subtitle", "time": 14086.309, "timestamp": "03:54:46", "text": "二。"}, {"type": "subtitle", "time": 14092.71, "timestamp": "03:54:52", "text": "与俱乐部合作。顺便一提，"}, {"type": "subtitle", "time": 14095.91, "timestamp": "03:54:55", "text": "我现在需要一家俱乐部。我的天啊。我当时想"}, {"type": "subtitle", "time": 14098.79, "timestamp": "03:54:58", "text": "哦，该死的这家伙。我会来的"}]
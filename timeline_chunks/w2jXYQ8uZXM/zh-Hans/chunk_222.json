[{"type": "subtitle", "time": 13320.95, "timestamp": "03:42:00", "text": "给你弓。"}, {"type": "subtitle", "time": 13324.469, "timestamp": "03:42:04", "text": "耶。箭矢并非无限。现在轮到你"}, {"type": "subtitle", "time": 13328.469, "timestamp": "03:42:08", "text": "必须制作 o。是的。"}, {"type": "subtitle", "time": 13335.99, "timestamp": "03:42:15", "text": "我可以在这里制作一些箭。"}, {"type": "subtitle", "time": 13338.229, "timestamp": "03:42:18", "text": "你想要什么？配方是什么？"}, {"type": "subtitle", "time": 13340.51, "timestamp": "03:42:20", "text": "这？"}, {"type": "subtitle", "time": 13342.389, "timestamp": "03:42:22", "text": "按。"}, {"type": "subtitle", "time": 13346.71, "timestamp": "03:42:26", "text": "好的，箭石和木头。"}, {"type": "subtitle", "time": 13349.67, "timestamp": "03:42:29", "text": "我需要知道如何才能达到那个等级"}, {"type": "subtitle", "time": 13352.07, "timestamp": "03:42:32", "text": "三？"}, {"type": "subtitle", "time": 13354.79, "timestamp": "03:42:34", "text": "让我们玩。哦，就玩基础版就行了。"}, {"type": "subtitle", "time": 13357.51, "timestamp": "03:42:37", "text": "必需品。必需品。"}, {"type": "subtitle", "time": 13360.79, "timestamp": "03:42:40", "text": "什么是碎石机？"}, {"type": "subtitle", "time": 13363.269, "timestamp": "03:42:43", "text": "哦，是斧子，伙计。在"}, {"type": "subtitle", "time": 13365.59, "timestamp": "03:42:45", "text": "食谱。你需要先解锁它。"}, {"type": "subtitle", "time": 13368.15, "timestamp": "03:42:48", "text": "那么你就需要放手了。"}, {"type": "subtitle", "time": 13370.55, "timestamp": "03:42:50", "text": "收集休眠点。砍倒"}, {"type": "subtitle", "time": 13374.07, "timestamp": "03:42:54", "text": "三。把那些东西砸碎。"}, {"type": "subtitle", "time": 13376.309, "timestamp": "03:42:56", "text": "我就是喜欢最基本的那些。后"}, {"type": "subtitle", "time": 13379.269, "timestamp": "03:42:59", "text": "这样，我们就可以开始我们的冒险之旅了。"}]
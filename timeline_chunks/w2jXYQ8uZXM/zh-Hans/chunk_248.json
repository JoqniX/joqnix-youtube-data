[{"type": "subtitle", "time": 14883.59, "timestamp": "04:08:03", "text": "我速通了这个游戏。"}, {"type": "subtitle", "time": 14885.91, "timestamp": "04:08:05", "text": "我们可以速通。这就像……"}, {"type": "subtitle", "time": 14888.95, "timestamp": "04:08:08", "text": "就像玩游戏一样。哇。啊，也许"}, {"type": "subtitle", "time": 14902.95, "timestamp": "04:08:22", "text": "我在海边。"}, {"type": "subtitle", "time": 14904.95, "timestamp": "04:08:24", "text": "是的。原路返回"}, {"type": "subtitle", "time": 14908.87, "timestamp": "04:08:28", "text": "来了。不，那还很远呢。我是"}, {"type": "subtitle", "time": 14912.309, "timestamp": "04:08:32", "text": "别的地方。我离船很近。"}, {"type": "subtitle", "time": 14914.15, "timestamp": "04:08:34", "text": "不，不是那样的。你没跑"}, {"type": "subtitle", "time": 14918.389, "timestamp": "04:08:38", "text": "然后走。不，我要去洗手间。"}, {"type": "subtitle", "time": 14920.95, "timestamp": "04:08:40", "text": "先别急着伸手。不要那样"}, {"type": "subtitle", "time": 14924.63, "timestamp": "04:08:44", "text": "从这里到手边就是路。"}, {"type": "subtitle", "time": 14928.15, "timestamp": "04:08:48", "text": "糟糕，有敌人。嘿，"}, {"type": "subtitle", "time": 14931.75, "timestamp": "04:08:51", "text": "他为什么偏偏要追我？"}, {"type": "subtitle", "time": 14933.99, "timestamp": "04:08:53", "text": "等等，你们在哪儿？我真的"}, {"type": "subtitle", "time": 14936.55, "timestamp": "04:08:56", "text": "在出生点。"}, {"type": "subtitle", "time": 14938.71, "timestamp": "04:08:58", "text": "不，还是从同一个地方上来。你知道的"}]
[{"type": "subtitle", "time": 3613.43, "timestamp": "01:00:13", "text": "制裁。等等，等等，等等，等等"}, {"type": "subtitle", "time": 3616.23, "timestamp": "01:00:16", "text": "等等，等等，等等，等等。我想"}, {"type": "subtitle", "time": 3618.87, "timestamp": "01:00:18", "text": "等待。我会把它转发给主题组。呃"}, {"type": "subtitle", "time": 3621.75, "timestamp": "01:00:21", "text": "他很快就会重生，然后……"}, {"type": "subtitle", "time": 3625.589, "timestamp": "01:00:25", "text": "刀举起来。但我确实担心是否会……"}, {"type": "subtitle", "time": 3632.87, "timestamp": "01:00:32", "text": "制裁。这就像我们遇到的问题一样"}, {"type": "subtitle", "time": 3634.63, "timestamp": "01:00:34", "text": "抖音，以及不知道你是否"}, {"type": "subtitle", "time": 3637.91, "timestamp": "01:00:37", "text": "是否允许继续提供支持"}, {"type": "subtitle", "time": 3639.829, "timestamp": "01:00:39", "text": "向法院作出补偿，以依赖"}, {"type": "subtitle", "time": 3642.309, "timestamp": "01:00:42", "text": "国家。如果你友善的话，我们有点……"}, {"type": "subtitle", "time": 3646.51, "timestamp": "01:00:46", "text": "就像质疑未知事物一样。"}, {"type": "subtitle", "time": 3649.47, "timestamp": "01:00:49", "text": "等等，为什么？"}]
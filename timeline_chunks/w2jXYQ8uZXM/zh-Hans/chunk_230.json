[{"type": "subtitle", "time": 13800.469, "timestamp": "03:50:00", "text": "让我查一下。溪流依然畅通。"}, {"type": "subtitle", "time": 13806.71, "timestamp": "03:50:06", "text": "我回来了。我回来了。我回来了。我必须"}, {"type": "subtitle", "time": 13809.269, "timestamp": "03:50:09", "text": "帮帮我，你刚才是在嘲笑我吗？我做了。我当时"}, {"type": "subtitle", "time": 13811.11, "timestamp": "03:50:11", "text": "几分钟而已。我的天啊。好的。"}, {"type": "subtitle", "time": 13815.03, "timestamp": "03:50:15", "text": "未来。我负责帮团队做些杂事。"}, {"type": "subtitle", "time": 13816.79, "timestamp": "03:50:16", "text": "这已经完成了很大一部分。"}, {"type": "subtitle", "time": 13818.55, "timestamp": "03:50:18", "text": "男。"}, {"type": "subtitle", "time": 13820.83, "timestamp": "03:50:20", "text": "基本生活。什么是"}, {"type": "subtitle", "time": 13823.87, "timestamp": "03:50:23", "text": "这？击败敌人。生成"}, {"type": "subtitle", "time": 13826.63, "timestamp": "03:50:26", "text": "矛。我完全没辙了，我们算是做到了。"}, {"type": "subtitle", "time": 13829.309, "timestamp": "03:50:29", "text": "这里好空旷啊，"}, {"type": "subtitle", "time": 13832.95, "timestamp": "03:50:32", "text": "嗯？没有纤维。它们会重生。"}, {"type": "subtitle", "time": 13836.229, "timestamp": "03:50:36", "text": "确实如此。不，不，它会重生的。我们不"}, {"type": "subtitle", "time": 13838.309, "timestamp": "03:50:38", "text": "现在就需要。我们需要像得到一样"}, {"type": "subtitle", "time": 13840.87, "timestamp": "03:50:40", "text": "现在说点东西。我们需要像杀戮一样"}, {"type": "subtitle", "time": 13842.95, "timestamp": "03:50:42", "text": "一些敌人。现在就去找个男人吧。快点，"}, {"type": "subtitle", "time": 13845.269, "timestamp": "03:50:45", "text": "伙计们。是的。我需要，我需要杀一些人"}, {"type": "subtitle", "time": 13849.99, "timestamp": "03:50:49", "text": "敌人。请问你有什么类型的吗？"}, {"type": "subtitle", "time": 13852.95, "timestamp": "03:50:52", "text": "呃呃，武器？"}, {"type": "subtitle", "time": 13857.349, "timestamp": "03:50:57", "text": "哦，没问题，我会为你打造一支长矛。"}]
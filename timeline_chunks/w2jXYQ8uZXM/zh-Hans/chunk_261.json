[{"type": "subtitle", "time": 15661.11, "timestamp": "04:21:01", "text": "如果它们是美味佳肴，也许吧。"}, {"type": "subtitle", "time": 15664.55, "timestamp": "04:21:04", "text": "美味佳肴啊？我不知道。或许你"}, {"type": "subtitle", "time": 15666.79, "timestamp": "04:21:06", "text": "想扼杀柠檬水。哇，他们是"}, {"type": "subtitle", "time": 15668.95, "timestamp": "04:21:08", "text": "珍贵如我"}, {"type": "subtitle", "time": 15673.429, "timestamp": "04:21:13", "text": "吃。为什么？从某种意义上说，他们也是人类。"}, {"type": "subtitle", "time": 15675.429, "timestamp": "04:21:15", "text": "血肉之躯，以及一切。如何？他们怎么样？"}, {"type": "subtitle", "time": 15678.149, "timestamp": "04:21:18", "text": "人类？他们是鱼人。他们不能"}, {"type": "subtitle", "time": 15680.79, "timestamp": "04:21:20", "text": "用中间语言交谈。"}, {"type": "subtitle", "time": 15682.389, "timestamp": "04:21:22", "text": "真是见鬼了。鱼儿会说话。"}, {"type": "subtitle", "time": 15687.469, "timestamp": "04:21:27", "text": "哦，我的"}, {"type": "subtitle", "time": 15697.71, "timestamp": "04:21:37", "text": "这。好吧，一些黄金"}]
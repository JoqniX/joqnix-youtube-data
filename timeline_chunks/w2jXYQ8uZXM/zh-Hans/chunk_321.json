[{"type": "subtitle", "time": 19265.03, "timestamp": "05:21:05", "text": "杀了它之后我什么也没得到。"}, {"type": "subtitle", "time": 19268.39, "timestamp": "05:21:08", "text": "鲨鱼。呃"}, {"type": "subtitle", "time": 19270.55, "timestamp": "05:21:10", "text": "或者别的什么。它就像一种非常紫的"}, {"type": "subtitle", "time": 19277.99, "timestamp": "05:21:17", "text": "嗯？盒子在哪里？"}, {"type": "subtitle", "time": 19304.75, "timestamp": "05:21:44", "text": "我们来了。我觉得我可以"}, {"type": "subtitle", "time": 19307.59, "timestamp": "05:21:47", "text": "见我。哦，对了，敌人。鸡蛋和愈合"}, {"type": "subtitle", "time": 19316.55, "timestamp": "05:21:56", "text": "也可以用那个东西，还有那个鸡蛋"}]
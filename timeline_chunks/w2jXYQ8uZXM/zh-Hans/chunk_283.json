[{"type": "subtitle", "time": 16986.788, "timestamp": "04:43:06", "text": "它在某个地方，哦，你看到了吗？"}, {"type": "subtitle", "time": 16990.23, "timestamp": "04:43:10", "text": "过来，往下看。"}, {"type": "subtitle", "time": 16993.15, "timestamp": "04:43:13", "text": "我到家了。家。"}, {"type": "subtitle", "time": 16996.31, "timestamp": "04:43:16", "text": "嗯，是的。是的。不要跳下去，"}, {"type": "subtitle", "time": 16999.83, "timestamp": "04:43:19", "text": "顺便一提。为什么？"}, {"type": "subtitle", "time": 17003.91, "timestamp": "04:43:23", "text": "你会死。哦，对。它是"}, {"type": "subtitle", "time": 17010.788, "timestamp": "04:43:30", "text": "邋遢。需要多少木材？好的。楼梯，"}, {"type": "subtitle", "time": 17024.19, "timestamp": "04:43:44", "text": "木头。给你，乔。更多的"}, {"type": "subtitle", "time": 17026.55, "timestamp": "04:43:46", "text": "木头。我不能把它扔到那里。你"}, {"type": "subtitle", "time": 17029.27, "timestamp": "04:43:49", "text": "需要上来一趟。我这里有木头。"}, {"type": "subtitle", "time": 17030.59, "timestamp": "04:43:50", "text": "顺便一提。你可以带"}, {"type": "subtitle", "time": 17033.19, "timestamp": "04:43:53", "text": "它。我终于完成了我开始的事情。"}, {"type": "subtitle", "time": 17039.58, "timestamp": "04:43:59", "text": "好的。"}]
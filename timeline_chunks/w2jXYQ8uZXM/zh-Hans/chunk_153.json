[{"type": "subtitle", "time": 9181.59, "timestamp": "02:33:01", "text": "是的。你好，忍者。早上好。"}, {"type": "subtitle", "time": 9187.309, "timestamp": "02:33:07", "text": "大学教师。不久"}, {"type": "subtitle", "time": 9190.63, "timestamp": "02:33:10", "text": "平均的。这是我最后一次玩这个游戏。"}, {"type": "subtitle", "time": 9196.19, "timestamp": "02:33:16", "text": "[音乐]"}, {"type": "subtitle", "time": 9206.63, "timestamp": "02:33:26", "text": "我不知道为什么今天我……今天我感觉"}, {"type": "subtitle", "time": 9210.55, "timestamp": "02:33:30", "text": "很好，因为我睡得很好。我想我没做到。"}, {"type": "subtitle", "time": 9213.95, "timestamp": "02:33:33", "text": "呃，睡过头或者吃太多"}, {"type": "subtitle", "time": 9216.11, "timestamp": "02:33:36", "text": "时间和喜欢"}, {"type": "subtitle", "time": 9220.59, "timestamp": "02:33:40", "text": "嗯，太费时间了，或者像"}, {"type": "subtitle", "time": 9223.51, "timestamp": "02:33:43", "text": "嗯，某种程度上来说，我睡得不错。是的，某种程度上是这样。"}, {"type": "subtitle", "time": 9227.55, "timestamp": "02:33:47", "text": "我睡得很好。我管理好了时间，"}, {"type": "subtitle", "time": 9230.11, "timestamp": "02:33:50", "text": "一切。今天过得不错"}, {"type": "subtitle", "time": 9232.79, "timestamp": "02:33:52", "text": "天。今天过得很愉快。问号。"}, {"type": "subtitle", "time": 9236.03, "timestamp": "02:33:56", "text": "骑师。你的意思是"}]
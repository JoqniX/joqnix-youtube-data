[{"type": "subtitle", "time": 16511.83, "timestamp": "04:35:11", "text": "小心。好了，我们现在返回顶部。我"}, {"type": "subtitle", "time": 16515.949, "timestamp": "04:35:15", "text": "把我的东西拿走。你好。"}, {"type": "subtitle", "time": 16518.99, "timestamp": "04:35:18", "text": "你好。我还有木头，我"}, {"type": "subtitle", "time": 16521.67, "timestamp": "04:35:21", "text": "猜测。别摔倒。顺便说一句，我"}, {"type": "subtitle", "time": 16522.429, "timestamp": "04:35:22", "text": "得到"}, {"type": "subtitle", "time": 16530.709, "timestamp": "04:35:30", "text": "哦，我想我得把它删掉。后"}, {"type": "subtitle", "time": 16533.75, "timestamp": "04:35:33", "text": "这样，我们就可以跳了。哦，不。给我一个"}, {"type": "subtitle", "time": 16536.789, "timestamp": "04:35:36", "text": "第二。让我搭建一个平台"}, {"type": "subtitle", "time": 16546.47, "timestamp": "04:35:46", "text": "案件。哦。哦，该死。我现在进退两难。呃，"}, {"type": "subtitle", "time": 16548.869, "timestamp": "04:35:48", "text": "我被困住了。等等，等等，等等。我有一个"}, {"type": "subtitle", "time": 16551.75, "timestamp": "04:35:51", "text": "主意。我有个主意。呃，你删除了。"}, {"type": "subtitle", "time": 16557.59, "timestamp": "04:35:57", "text": "是一样的。你可以他妈的"}, {"type": "subtitle", "time": 16558.67, "timestamp": "04:35:58", "text": "东西"}]
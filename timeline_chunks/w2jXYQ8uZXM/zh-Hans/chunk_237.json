[{"type": "subtitle", "time": 14220.79, "timestamp": "03:57:00", "text": "你对此一无所知。我完全迷路了。"}, {"type": "subtitle", "time": 14223.59, "timestamp": "03:57:03", "text": "现在。我的天啊。等等，我走了一些"}, {"type": "subtitle", "time": 14225.469, "timestamp": "03:57:05", "text": "其他。好的，我是"}, {"type": "subtitle", "time": 14228.99, "timestamp": "03:57:08", "text": "这里。哦，天哪，我"}, {"type": "subtitle", "time": 14233.91, "timestamp": "03:57:13", "text": "死的。 45马力。哦，不。是的，你没错"}, {"type": "subtitle", "time": 14238.03, "timestamp": "03:57:18", "text": "损害。呃，我的天哪"}, {"type": "subtitle", "time": 14241.79, "timestamp": "03:57:21", "text": "上帝。有人有吗？"}, {"type": "subtitle", "time": 14246.07, "timestamp": "03:57:26", "text": "需要法力吗？或者应该需要一些法力？"}, {"type": "subtitle", "time": 14248.389, "timestamp": "03:57:28", "text": "是的，我拿走了。是的，我没有"}, {"type": "subtitle", "time": 14250.75, "timestamp": "03:57:30", "text": "任何"}, {"type": "subtitle", "time": 14253.429, "timestamp": "03:57:33", "text": "拉屎。我们需要更多法力。快点。然后"}, {"type": "subtitle", "time": 14256.79, "timestamp": "03:57:36", "text": "我们得去务农。"}, {"type": "subtitle", "time": 14264.269, "timestamp": "03:57:44", "text": "如何"}, {"type": "subtitle", "time": 14268.309, "timestamp": "03:57:48", "text": "吃蘑菇吗？哦，我得做饭了"}, {"type": "subtitle", "time": 14271.83, "timestamp": "03:57:51", "text": "他们。哦，w"}, {"type": "subtitle", "time": 14273.83, "timestamp": "03:57:53", "text": "你是什​​么意思？你没做饭吗？"}, {"type": "subtitle", "time": 14276.389, "timestamp": "03:57:56", "text": "给自己准备了什么？"}, {"type": "subtitle", "time": 14278.95, "timestamp": "03:57:58", "text": "只有我一个人。"}]
[{"type": "subtitle", "time": 14463.83, "timestamp": "04:01:03", "text": "呃，等等。真的吗？我的天啊。再次。我"}, {"type": "subtitle", "time": 14465.75, "timestamp": "04:01:05", "text": "听着。"}, {"type": "subtitle", "time": 14467.269, "timestamp": "04:01:07", "text": "是的。"}, {"type": "subtitle", "time": 14471.189, "timestamp": "04:01:11", "text": "不，它又回来了。它回来了。难道不是吗？"}, {"type": "subtitle", "time": 14474.309, "timestamp": "04:01:14", "text": "为什么会有这么大的延误？"}, {"type": "subtitle", "time": 14475.91, "timestamp": "04:01:15", "text": "我一直在想，为什么会这样？"}, {"type": "subtitle", "time": 14478.15, "timestamp": "04:01:18", "text": "大的"}, {"type": "subtitle", "time": 14480.349, "timestamp": "04:01:20", "text": "哦，我的"}, {"type": "subtitle", "time": 14483.63, "timestamp": "04:01:23", "text": "上帝，生命，不是我"}]
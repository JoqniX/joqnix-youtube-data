[{"type": "subtitle", "time": 2661.309, "timestamp": "00:44:21", "text": "呃，我要走了"}, {"type": "subtitle", "time": 2664.23, "timestamp": "00:44:24", "text": "你很擅长与企业人士沟通。"}, {"type": "subtitle", "time": 2667.829, "timestamp": "00:44:27", "text": "人啊。不，我不是，兄弟。我不是。"}, {"type": "subtitle", "time": 2670.63, "timestamp": "00:44:30", "text": "我不是。我在这方面很差劲。您认为"}, {"type": "subtitle", "time": 2673.67, "timestamp": "00:44:33", "text": "如果我连自己人都不能说话，那他们就更不行了。"}, {"type": "subtitle", "time": 2678.55, "timestamp": "00:44:38", "text": "艺术家，而且要严格遵守规则，因为我……"}, {"type": "subtitle", "time": 2685.15, "timestamp": "00:44:45", "text": "非正式的。字面上，我就是……"}, {"type": "subtitle", "time": 2697.55, "timestamp": "00:44:57", "text": "帽。没骗你，兄弟。"}]
[{"type": "subtitle", "time": 11049.99, "timestamp": "03:04:09", "text": "图一。这款游戏更像是……"}, {"type": "subtitle", "time": 11051.63, "timestamp": "03:04:11", "text": "平静地。"}, {"type": "subtitle", "time": 11054.07, "timestamp": "03:04:14", "text": "是的。不用担心怪物"}, {"type": "subtitle", "time": 11055.389, "timestamp": "03:04:15", "text": "全部"}, {"type": "subtitle", "time": 11066.79, "timestamp": "03:04:26", "text": "老兄，我想把手伸进去。此外，我们"}, {"type": "subtitle", "time": 11068.07, "timestamp": "03:04:28", "text": "需要找到那枚蛋。你知道吗？"}, {"type": "subtitle", "time": 11070.15, "timestamp": "03:04:30", "text": "我们会拿到问题中的鸡蛋。"}, {"type": "subtitle", "time": 11072.95, "timestamp": "03:04:32", "text": "工作完成后会打分。现在，"}, {"type": "subtitle", "time": 11076.309, "timestamp": "03:04:36", "text": "我们只想努力奋斗。好的。"}, {"type": "subtitle", "time": 11087.309, "timestamp": "03:04:47", "text": "你感觉肚子饿吗？"}, {"type": "subtitle", "time": 11091.03, "timestamp": "03:04:51", "text": "略多于一半。"}, {"type": "subtitle", "time": 11093.11, "timestamp": "03:04:53", "text": "是啊，我会生一堆篝火，然后做一些"}, {"type": "subtitle", "time": 11094.87, "timestamp": "03:04:54", "text": "汤。"}]
[{"type": "subtitle", "time": 19028.31, "timestamp": "05:17:08", "text": "没有。他在哪儿？等等，他在哪里？"}, {"type": "subtitle", "time": 19031.03, "timestamp": "05:17:11", "text": "他去了哪里？"}, {"type": "subtitle", "time": 19034.43, "timestamp": "05:17:14", "text": "我的天啊。好吧，行。好了，你停下来。我"}, {"type": "subtitle", "time": 19037.51, "timestamp": "05:17:17", "text": "只需要箭头。我有99个。多少？"}, {"type": "subtitle", "time": 19040.47, "timestamp": "05:17:20", "text": "你需要偶像吗？我不知道。好的。"}, {"type": "subtitle", "time": 19048.948, "timestamp": "05:17:28", "text": "我听到了你或者老板的声音。我不知道。"}, {"type": "subtitle", "time": 19050.59, "timestamp": "05:17:30", "text": "你在这里？老板"}, {"type": "subtitle", "time": 19053.67, "timestamp": "05:17:33", "text": "实际上。哦，他在这里。出局"}, {"type": "subtitle", "time": 19060.47, "timestamp": "05:17:40", "text": "是的。哦，这真是个乖孩子。他是"}, {"type": "subtitle", "time": 19075.19, "timestamp": "05:17:55", "text": "它会消耗你大量的体力。"}, {"type": "subtitle", "time": 19078.31, "timestamp": "05:17:58", "text": "这样做。是的。哦，是的。我的天啊。"}]
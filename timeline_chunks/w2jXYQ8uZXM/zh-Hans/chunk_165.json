[{"type": "subtitle", "time": 9901.23, "timestamp": "02:45:01", "text": "某物。我不知道那是什么。"}, {"type": "subtitle", "time": 9909.389, "timestamp": "02:45:09", "text": "[音乐]"}, {"type": "subtitle", "time": 9911.67, "timestamp": "02:45:11", "text": "拖鞋。我们得到更多"}, {"type": "subtitle", "time": 9914.79, "timestamp": "02:45:14", "text": "鞋。好的。"}, {"type": "subtitle", "time": 9917.349, "timestamp": "02:45:17", "text": "所以，随着我们鞋子数量的增加，"}, {"type": "subtitle", "time": 9923.95, "timestamp": "02:45:23", "text": "就这么办吧"}, {"type": "subtitle", "time": 9929.07, "timestamp": "02:45:29", "text": "你会在那里吗？好的。呃，我会是"}, {"type": "subtitle", "time": 9934.79, "timestamp": "02:45:34", "text": "嗯，我要去吃午饭了。呃"}, {"type": "subtitle", "time": 9937.91, "timestamp": "02:45:37", "text": "欢迎光临。我去吃午饭了。我的"}, {"type": "subtitle", "time": 9940.15, "timestamp": "02:45:40", "text": "朋友会接手。面包将会是"}, {"type": "subtitle", "time": 9940.99, "timestamp": "02:45:40", "text": "采取"}, {"type": "subtitle", "time": 9944.15, "timestamp": "02:45:44", "text": "超过。嗯，是的，我正在等待……"}, {"type": "subtitle", "time": 9946.19, "timestamp": "02:45:46", "text": "面包。他将接受"}, {"type": "subtitle", "time": 9949.24, "timestamp": "02:45:49", "text": "超过。一秒钟。我忘了做"}, {"type": "subtitle", "time": 9950.67, "timestamp": "02:45:50", "text": "[音乐]"}, {"type": "subtitle", "time": 9956.75, "timestamp": "02:45:56", "text": "那个东西。呃，我的面包要走了"}, {"type": "subtitle", "time": 9957.76, "timestamp": "02:45:57", "text": "超过。"}, {"type": "subtitle", "time": 9959.71, "timestamp": "02:45:59", "text": "[音乐]"}]
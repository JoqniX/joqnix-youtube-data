[{"type": "subtitle", "time": 11706.389, "timestamp": "03:15:06", "text": "没事的。我非常生气。结尾"}, {"type": "subtitle", "time": 11710.91, "timestamp": "03:15:10", "text": "那些溪流。我真的会很生气"}, {"type": "subtitle", "time": 11713.389, "timestamp": "03:15:13", "text": "人。我不知道我为什么会玩那个游戏。"}, {"type": "subtitle", "time": 11716.95, "timestamp": "03:15:16", "text": "游戏。我不知道自己为什么会玩那个游戏。"}, {"type": "subtitle", "time": 11722.389, "timestamp": "03:15:22", "text": "但我还得再吃点甜食。"}, {"type": "subtitle", "time": 11732.63, "timestamp": "03:15:32", "text": "时间。去买些食物吧"}, {"type": "subtitle", "time": 11734.55, "timestamp": "03:15:34", "text": "营火。我喜欢放置很多"}, {"type": "subtitle", "time": 11736.309, "timestamp": "03:15:36", "text": "那里的食物。"}, {"type": "subtitle", "time": 11737.63, "timestamp": "03:15:37", "text": "我"}, {"type": "subtitle", "time": 11750.03, "timestamp": "03:15:50", "text": "你。让我看看聊天记录。有人吗？"}, {"type": "subtitle", "time": 11753.59, "timestamp": "03:15:53", "text": "说？顶峰。这是怪物猎人吗？"}, {"type": "subtitle", "time": 11756.55, "timestamp": "03:15:56", "text": "绝对不行。 D. 这不是怪物猎人。"}, {"type": "subtitle", "time": 11759.19, "timestamp": "03:15:59", "text": "这比《怪物猎人》好多了。地狱"}]
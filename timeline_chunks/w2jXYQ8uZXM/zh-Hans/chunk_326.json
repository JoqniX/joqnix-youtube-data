[{"type": "subtitle", "time": 19563.99, "timestamp": "05:26:03", "text": "我饿了。如何才能得到它？你如何"}, {"type": "subtitle", "time": 19567.27, "timestamp": "05:26:07", "text": "在水面上放个Z？"}, {"type": "subtitle", "time": 19569.43, "timestamp": "05:26:09", "text": "上面写的是 Kimber，不是“哦，我得放"}, {"type": "subtitle", "time": 19572.15, "timestamp": "05:26:12", "text": "在我的设备里。是的。哦，这是"}, {"type": "subtitle", "time": 19575.51, "timestamp": "05:26:15", "text": "比两者都快。"}, {"type": "subtitle", "time": 19577.51, "timestamp": "05:26:17", "text": "它速度更快，而且就像……"}, {"type": "subtitle", "time": 19585.31, "timestamp": "05:26:25", "text": "唯一的缺点就是不能放东西。"}, {"type": "subtitle", "time": 19587.51, "timestamp": "05:26:27", "text": "那里。但是你看到我那边的信号了吗？"}, {"type": "subtitle", "time": 19590.868, "timestamp": "05:26:30", "text": "在右侧？是的。"}, {"type": "subtitle", "time": 19593.03, "timestamp": "05:26:33", "text": "是的。下次我们需要去那里"}, {"type": "subtitle", "time": 19600.31, "timestamp": "05:26:40", "text": "那么，这是谁的救援？"}, {"type": "subtitle", "time": 19603.51, "timestamp": "05:26:43", "text": "呃，这是我们的存档。"}, {"type": "subtitle", "time": 19606.23, "timestamp": "05:26:46", "text": "H."}, {"type": "subtitle", "time": 19608.47, "timestamp": "05:26:48", "text": "所以，别担心。我希望他不会。"}, {"type": "subtitle", "time": 19612.15, "timestamp": "05:26:52", "text": "删除他的存档。哦，我们有新的"}, {"type": "subtitle", "time": 19615.43, "timestamp": "05:26:55", "text": "阿玛诺防火免疫。哦，我们可以振作起来。"}, {"type": "subtitle", "time": 19619.51, "timestamp": "05:26:59", "text": "精神可以，收集。"}]
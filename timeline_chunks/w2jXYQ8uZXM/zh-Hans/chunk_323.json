[{"type": "subtitle", "time": 19385.628, "timestamp": "05:23:05", "text": "威胁。但我还有一些"}, {"type": "subtitle", "time": 19395.51, "timestamp": "05:23:15", "text": "实际上，就让它死了吧。不用担心。"}, {"type": "subtitle", "time": 19399.27, "timestamp": "05:23:19", "text": "我已屏蔽它。我是个男的。"}, {"type": "subtitle", "time": 19401.11, "timestamp": "05:23:21", "text": "谁住在那个菠萝里？我想"}, {"type": "subtitle", "time": 19407.43, "timestamp": "05:23:27", "text": "好的。呃，你的物品，你的物品和"}, {"type": "subtitle", "time": 19410.03, "timestamp": "05:23:30", "text": "东西。"}, {"type": "subtitle", "time": 19413.67, "timestamp": "05:23:33", "text": "是的。你可以……你可以买到那些东西。"}, {"type": "subtitle", "time": 19415.99, "timestamp": "05:23:35", "text": "来自羊圈。"}, {"type": "subtitle", "time": 19420.948, "timestamp": "05:23:40", "text": "我拿到了“是的，存储空间”。我忘了这件事"}, {"type": "subtitle", "time": 19423.91, "timestamp": "05:23:43", "text": "这"}, {"type": "subtitle", "time": 19431.43, "timestamp": "05:23:51", "text": "糟糕。有时，游戏是"}, {"type": "subtitle", "time": 19434.55, "timestamp": "05:23:54", "text": "虽然有点笨拙，但还不错。我的天啊。水"}, {"type": "subtitle", "time": 19436.47, "timestamp": "05:23:56", "text": "股线。我们得到了一些基本的治疗。"}, {"type": "subtitle", "time": 19439.51, "timestamp": "05:23:59", "text": "药水。构造。获取该结构。"}]
[{"type": "subtitle", "time": 19335.83, "timestamp": "05:22:15", "text": "我的狗的另一部分在哪里？我"}, {"type": "subtitle", "time": 19339.27, "timestamp": "05:22:19", "text": "找到它。他不知所踪。"}, {"type": "subtitle", "time": 19342.23, "timestamp": "05:22:22", "text": "我差点就被困住了。哦，请便。后退"}, {"type": "subtitle", "time": 19345.51, "timestamp": "05:22:25", "text": "家。好的，我来了。几乎。"}, {"type": "subtitle", "time": 19347.19, "timestamp": "05:22:27", "text": "你们俩开车的方式不一样吗？"}, {"type": "subtitle", "time": 19349.83, "timestamp": "05:22:29", "text": "现在糟透了吗？是的。该死的"}, {"type": "subtitle", "time": 19351.67, "timestamp": "05:22:31", "text": "它。"}, {"type": "subtitle", "time": 19355.35, "timestamp": "05:22:35", "text": "我的意思是，他很想正式邀请他。"}, {"type": "subtitle", "time": 19358.15, "timestamp": "05:22:38", "text": "哦，是的。我的意思是，我们必须……我们有"}, {"type": "subtitle", "time": 19360.55, "timestamp": "05:22:40", "text": "两个存储位置。所以，我们必须利用"}, {"type": "subtitle", "time": 19363.83, "timestamp": "05:22:43", "text": "它的。你可以自己动手制作。该死。"}, {"type": "subtitle", "time": 19366.19, "timestamp": "05:22:46", "text": "为什么？"}, {"type": "subtitle", "time": 19368.83, "timestamp": "05:22:48", "text": "你好。你好。我是"}, {"type": "subtitle", "time": 19376.27, "timestamp": "05:22:56", "text": "哇。他想打别人的"}]
[{"type": "subtitle", "time": 5343.39, "timestamp": "01:29:03", "text": "嗯，是的，他们使用的是GPL协议。"}, {"type": "subtitle", "time": 5346.669, "timestamp": "01:29:06", "text": "执照。所以，它并不是一家真正的公司。"}, {"type": "subtitle", "time": 5350.229, "timestamp": "01:29:10", "text": "公司氛围。它更像是一个项目"}, {"type": "subtitle", "time": 5354.189, "timestamp": "01:29:14", "text": "或获得许可的程序"}, {"type": "subtitle", "time": 5371.229, "timestamp": "01:29:31", "text": "我为什么要问那些人呢？"}, {"type": "subtitle", "time": 5380.91, "timestamp": "01:29:40", "text": "呃，如果那是主播机器人的话。"}]
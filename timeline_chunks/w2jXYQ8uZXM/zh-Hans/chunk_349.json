[{"type": "subtitle", "time": 20947.03, "timestamp": "05:49:07", "text": "总之，你现在要走了吗？嗯，我想是的"}, {"type": "subtitle", "time": 20949.91, "timestamp": "05:49:09", "text": "所以。"}, {"type": "subtitle", "time": 20952.868, "timestamp": "05:49:12", "text": "某物。好吧，那如果你也这么认为的话。"}, {"type": "subtitle", "time": 20955.03, "timestamp": "05:49:15", "text": "我也是。好的。再见各位"}, {"type": "subtitle", "time": 20957.83, "timestamp": "05:49:17", "text": "之后。下次见。再见。再见。"}, {"type": "subtitle", "time": 20966.59, "timestamp": "05:49:26", "text": "哦，我的"}, {"type": "subtitle", "time": 20974.15, "timestamp": "05:49:34", "text": "乐趣。是的。现在就走。你们真好"}, {"type": "subtitle", "time": 20975.948, "timestamp": "05:49:35", "text": "的"}, {"type": "subtitle", "time": 20992.19, "timestamp": "05:49:52", "text": "我得等你们回来。"}]
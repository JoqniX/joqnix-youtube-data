[{"type": "subtitle", "time": 18782.39, "timestamp": "05:13:02", "text": "真他妈的。那个混蛋。多少"}, {"type": "subtitle", "time": 18784.948, "timestamp": "05:13:04", "text": "注射？这只绿色的小老鼠正在打开。什么"}, {"type": "subtitle", "time": 18786.03, "timestamp": "05:13:06", "text": "这"}, {"type": "subtitle", "time": 18788.628, "timestamp": "05:13:08", "text": "他妈的？过来。狠狠揍他一顿。来"}, {"type": "subtitle", "time": 18790.35, "timestamp": "05:13:10", "text": "这里。这"}, {"type": "subtitle", "time": 18799.51, "timestamp": "05:13:19", "text": "比特，你惹错人了。"}, {"type": "subtitle", "time": 18802.39, "timestamp": "05:13:22", "text": "派对，傻瓜。哦，乔去哪儿了？让我"}, {"type": "subtitle", "time": 18806.47, "timestamp": "05:13:26", "text": "帮助。哦，乔也在那儿。哦，是的。"}, {"type": "subtitle", "time": 18809.47, "timestamp": "05:13:29", "text": "另外，还要得到那个那个"}, {"type": "subtitle", "time": 18812.15, "timestamp": "05:13:32", "text": "顺便提一下。水。是的。"}, {"type": "subtitle", "time": 18815.03, "timestamp": "05:13:35", "text": "水。对，就是水的事。"}, {"type": "subtitle", "time": 18818.31, "timestamp": "05:13:38", "text": "我死了。"}, {"type": "subtitle", "time": 18821.868, "timestamp": "05:13:41", "text": "好了，现在开始挑战boss吧。来"}, {"type": "subtitle", "time": 18826.39, "timestamp": "05:13:46", "text": "在。是啊，兄弟。哦，对了，我必须"}, {"type": "subtitle", "time": 18832.67, "timestamp": "05:13:52", "text": "盔甲。这里我们"}, {"type": "subtitle", "time": 18836.31, "timestamp": "05:13:56", "text": "去。我会配备那个。该死。为什么你的"}, {"type": "subtitle", "time": 18838.99, "timestamp": "05:13:58", "text": "头发 哦，是的。你改变了你的效果。"}]
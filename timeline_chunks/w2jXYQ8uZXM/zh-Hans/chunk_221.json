[{"type": "subtitle", "time": 13261.269, "timestamp": "03:41:01", "text": "改变。没关系。好吧，行。患病的"}, {"type": "subtitle", "time": 13263.11, "timestamp": "03:41:03", "text": "改变。"}, {"type": "subtitle", "time": 13264.87, "timestamp": "03:41:04", "text": "我正在改变。我正在改变。我接受了"}, {"type": "subtitle", "time": 13269.03, "timestamp": "03:41:09", "text": "全部的。挺酷的。"}, {"type": "subtitle", "time": 13271.15, "timestamp": "03:41:11", "text": "总之，我们是谁？"}, {"type": "subtitle", "time": 13274.79, "timestamp": "03:41:14", "text": "他有武器吗？"}, {"type": "subtitle", "time": 13278.71, "timestamp": "03:41:18", "text": "我只有那种屁股"}, {"type": "subtitle", "time": 13281.51, "timestamp": "03:41:21", "text": "我想他没有长矛。"}, {"type": "subtitle", "time": 13285.229, "timestamp": "03:41:25", "text": "是的。给他做一把弓箭。一些"}, {"type": "subtitle", "time": 13288.71, "timestamp": "03:41:28", "text": "好的。我需要一些箭。我该如何切"}, {"type": "subtitle", "time": 13290.55, "timestamp": "03:41:30", "text": "树？"}, {"type": "subtitle", "time": 13292.55, "timestamp": "03:41:32", "text": "我直接走到他们面前问。"}, {"type": "subtitle", "time": 13294.79, "timestamp": "03:41:34", "text": "是的，我正在做。你在做这件事。"}, {"type": "subtitle", "time": 13302.469, "timestamp": "03:41:42", "text": "去。你还会得到一些树脂。"}, {"type": "subtitle", "time": 13305.03, "timestamp": "03:41:45", "text": "你得再靠近一点。"}]
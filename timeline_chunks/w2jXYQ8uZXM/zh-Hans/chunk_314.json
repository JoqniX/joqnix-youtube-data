[{"type": "subtitle", "time": 18841.03, "timestamp": "05:14:01", "text": "别招惹他。看看那些。看看"}, {"type": "subtitle", "time": 18844.628, "timestamp": "05:14:04", "text": "这头发。该死。好的。"}, {"type": "subtitle", "time": 18845.868, "timestamp": "05:14:05", "text": "他们正在投掷"}, {"type": "subtitle", "time": 18848.47, "timestamp": "05:14:08", "text": "她。呃，大家都很快来了"}, {"type": "subtitle", "time": 18850.55, "timestamp": "05:14:10", "text": "因为……而在一起，因为……之后"}, {"type": "subtitle", "time": 18865.708, "timestamp": "05:14:25", "text": "中间部分也是如此。"}, {"type": "subtitle", "time": 18867.55, "timestamp": "05:14:27", "text": "损害"}, {"type": "subtitle", "time": 18871.07, "timestamp": "05:14:31", "text": "饵。这就是我想要做的。"}, {"type": "subtitle", "time": 18872.75, "timestamp": "05:14:32", "text": "做。"}, {"type": "subtitle", "time": 18875.03, "timestamp": "05:14:35", "text": "是的。放上阴茎，因为我有阴茎。"}, {"type": "subtitle", "time": 18876.628, "timestamp": "05:14:36", "text": "需要。"}]
[{"type": "subtitle", "time": 22141.548, "timestamp": "06:09:01", "text": "化身"}, {"type": "subtitle", "time": 22144.948, "timestamp": "06:09:04", "text": "喋喋不休的人，然后是"}, {"type": "subtitle", "time": 22147.83, "timestamp": "06:09:07", "text": "评论稍微显露出来一点"}, {"type": "subtitle", "time": 22150.628, "timestamp": "06:09:10", "text": "评论显示为逐渐褪色的"}, {"type": "subtitle", "time": 22153.35, "timestamp": "06:09:13", "text": "信息。就像突然冒出来一样"}, {"type": "subtitle", "time": 22156.708, "timestamp": "06:09:16", "text": "屏幕随机出现在某个地方，而且"}, {"type": "subtitle", "time": 22159.27, "timestamp": "06:09:19", "text": "推开之类的。有点儿"}, {"type": "subtitle", "time": 22162.788, "timestamp": "06:09:22", "text": "就是这样。太酷了。我想我"}, {"type": "subtitle", "time": 22166.59, "timestamp": "06:09:26", "text": "我想要，我想要得到它们。如何"}, {"type": "subtitle", "time": 22173.07, "timestamp": "06:09:33", "text": "它？"}, {"type": "subtitle", "time": 22176.51, "timestamp": "06:09:36", "text": "那么，我该如何找到"}, {"type": "subtitle", "time": 22180.27, "timestamp": "06:09:40", "text": "它？你好，阳光。下午好。好的"}, {"type": "subtitle", "time": 22182.27, "timestamp": "06:09:42", "text": "晚上。你好。"}, {"type": "subtitle", "time": 22185.39, "timestamp": "06:09:45", "text": "你好。希望你一切顺利"}, {"type": "subtitle", "time": 22189.15, "timestamp": "06:09:49", "text": "出色地。还有，我意识到了一件事。"}, {"type": "subtitle", "time": 22192.708, "timestamp": "06:09:52", "text": "嗯，因为我们一直在聊天"}, {"type": "subtitle", "time": 22195.75, "timestamp": "06:09:55", "text": "直播之类的。我当时可能"}, {"type": "subtitle", "time": 22198.708, "timestamp": "06:09:58", "text": "我觉得如果我放"}]
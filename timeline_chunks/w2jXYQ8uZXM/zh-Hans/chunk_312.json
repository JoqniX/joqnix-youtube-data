[{"type": "subtitle", "time": 18720.15, "timestamp": "05:12:00", "text": "你们真酷。"}, {"type": "subtitle", "time": 18721.628, "timestamp": "05:12:01", "text": "离开"}, {"type": "subtitle", "time": 18740.47, "timestamp": "05:12:20", "text": "我正在躲避鲨鱼。"}, {"type": "subtitle", "time": 18743.83, "timestamp": "05:12:23", "text": "这是我的燃油车吗？"}, {"type": "subtitle", "time": 18744.868, "timestamp": "05:12:24", "text": "不要碰它。不要碰它。不"}, {"type": "subtitle", "time": 18745.91, "timestamp": "05:12:25", "text": "摸一下。它要爆炸了。不"}, {"type": "subtitle", "time": 18753.27, "timestamp": "05:12:33", "text": "不。"}, {"type": "subtitle", "time": 18759.67, "timestamp": "05:12:39", "text": "该死。我当时真的吓了一跳"}, {"type": "subtitle", "time": 18761.91, "timestamp": "05:12:41", "text": "被鲨鱼咬了。"}, {"type": "subtitle", "time": 18763.59, "timestamp": "05:12:43", "text": "我刚才看到，哦，那边有条鲨鱼。"}, {"type": "subtitle", "time": 18765.628, "timestamp": "05:12:45", "text": "妈妈要来了"}, {"type": "subtitle", "time": 18772.948, "timestamp": "05:12:52", "text": "我看到了入口。你们来自哪里？"}, {"type": "subtitle", "time": 18775.99, "timestamp": "05:12:55", "text": "底部？呃，不。我快到了"}, {"type": "subtitle", "time": 18779.43, "timestamp": "05:12:59", "text": "离岸。我进入了这个地方。哦，我的"}]
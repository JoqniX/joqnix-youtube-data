[{"type": "subtitle", "time": 11520.349, "timestamp": "03:12:00", "text": "也包括其他人。我是"}, {"type": "subtitle", "time": 11522.67, "timestamp": "03:12:02", "text": "跑步。我在跑步。"}, {"type": "subtitle", "time": 11527.349, "timestamp": "03:12:07", "text": "哦，我不会给你添麻烦的。我没惹麻烦。"}, {"type": "subtitle", "time": 11529.99, "timestamp": "03:12:09", "text": "你需要帮助吗？不，不，不。我不是"}, {"type": "subtitle", "time": 11531.71, "timestamp": "03:12:11", "text": "我们正在努力解决这个问题。我们可以来"}, {"type": "subtitle", "time": 11536.87, "timestamp": "03:12:16", "text": "之后。稍后。你现在有吗？"}, {"type": "subtitle", "time": 11541.11, "timestamp": "03:12:21", "text": "呃，我有很多石头。给我一些。"}, {"type": "subtitle", "time": 11548.389, "timestamp": "03:12:28", "text": "未来。朋友，我要奔向你。"}, {"type": "subtitle", "time": 11571.91, "timestamp": "03:12:51", "text": "哦，是的。总之，这是你的石头。"}, {"type": "subtitle", "time": 11574.87, "timestamp": "03:12:54", "text": "多谢。谢谢。是的。是的。我当时"}, {"type": "subtitle", "time": 11577.309, "timestamp": "03:12:57", "text": "伙计，加油。我当时"}, {"type": "chat", "time": 11579.103, "timestamp": "03:12:59", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "is this mosnter hunter?"}]
[{"type": "subtitle", "time": 14711.07, "timestamp": "04:05:11", "text": "[音乐]"}, {"type": "subtitle", "time": 14719.67, "timestamp": "04:05:19", "text": "生活节奏缓慢。为什么我的兄弟总是"}, {"type": "subtitle", "time": 14721.75, "timestamp": "04:05:21", "text": "滞后？"}, {"type": "subtitle", "time": 14724.03, "timestamp": "04:05:24", "text": "生命而非死亡"}, {"type": "subtitle", "time": 14728.55, "timestamp": "04:05:28", "text": "工作。呃，醒醒。唤醒灵魂是什么？"}, {"type": "subtitle", "time": 14731.71, "timestamp": "04:05:31", "text": "在精神锚点上？哦，那是"}, {"type": "subtitle", "time": 14735.83, "timestamp": "04:05:35", "text": "是啊，我们一起做，对吧？"}, {"type": "subtitle", "time": 14738.15, "timestamp": "04:05:38", "text": "是的。"}, {"type": "subtitle", "time": 14743.309, "timestamp": "04:05:43", "text": "跟我来。我弄到了很多树枝，"}, {"type": "subtitle", "time": 14746.15, "timestamp": "04:05:46", "text": "椰子。你刚才是不是搭了个楼梯？"}, {"type": "subtitle", "time": 14749.349, "timestamp": "04:05:49", "text": "我的天啊。通往天堂的道路。我做了。我"}, {"type": "subtitle", "time": 14752.55, "timestamp": "04:05:52", "text": "做过。我做了。"}, {"type": "subtitle", "time": 14754.389, "timestamp": "04:05:54", "text": "妈的。"}]
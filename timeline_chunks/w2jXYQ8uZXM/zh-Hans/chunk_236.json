[{"type": "subtitle", "time": 14160.229, "timestamp": "03:56:00", "text": "做根棍子？我的天哪。我愿意做。"}, {"type": "subtitle", "time": 14162.15, "timestamp": "03:56:02", "text": "你可以跳到那里。我们跳到那里。你"}, {"type": "subtitle", "time": 14172.229, "timestamp": "03:56:12", "text": "我打算建一些楼梯。"}, {"type": "subtitle", "time": 14174.51, "timestamp": "03:56:14", "text": "好了。"}, {"type": "subtitle", "time": 14179.269, "timestamp": "03:56:19", "text": "日期树：我们没有任何日期。"}, {"type": "subtitle", "time": 14181.99, "timestamp": "03:56:21", "text": "所以，我们现在就在这儿劈柴。"}, {"type": "subtitle", "time": 14184.63, "timestamp": "03:56:24", "text": "好的。不，我要拿鸡蛋。你看"}, {"type": "subtitle", "time": 14186.95, "timestamp": "03:56:26", "text": "你面前的那个鸡蛋？"}, {"type": "subtitle", "time": 14189.229, "timestamp": "03:56:29", "text": "这。哦，这是什么？不"}, {"type": "subtitle", "time": 14193.349, "timestamp": "03:56:33", "text": "落下。我把它拿走了。一旦我哦，是"}, {"type": "subtitle", "time": 14195.75, "timestamp": "03:56:35", "text": "想升级。这就像……"}, {"type": "subtitle", "time": 14197.309, "timestamp": "03:56:37", "text": "升级"}, {"type": "subtitle", "time": 14202.71, "timestamp": "03:56:42", "text": "我们的锚泊信标进行了升级。"}, {"type": "subtitle", "time": 14210.71, "timestamp": "03:56:50", "text": "我们来放鸡蛋。然后我们继续……"}, {"type": "subtitle", "time": 14212.71, "timestamp": "03:56:52", "text": "表面上。你看到前面的手了吗？"}, {"type": "subtitle", "time": 14217.429, "timestamp": "03:56:57", "text": "你呢？那只大手。手放在哪里？"}]
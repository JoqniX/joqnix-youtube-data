[{"type": "subtitle", "time": 12541.67, "timestamp": "03:29:01", "text": "玩完这款游戏后，你首先会感觉"}, {"type": "subtitle", "time": 12543.99, "timestamp": "03:29:03", "text": "哇，这真是……这真是……"}, {"type": "subtitle", "time": 12547.75, "timestamp": "03:29:07", "text": "挺酷的。是的。"}, {"type": "subtitle", "time": 12550.15, "timestamp": "03:29:10", "text": "而且氛围非常轻松惬意。这就是我为什么说"}, {"type": "subtitle", "time": 12551.51, "timestamp": "03:29:11", "text": "我觉得我们应该玩这个游戏。它"}, {"type": "subtitle", "time": 12553.429, "timestamp": "03:29:13", "text": "这让我想起了Pal World。你知道的"}, {"type": "subtitle", "time": 12556.309, "timestamp": "03:29:16", "text": "我很想玩Pal世界，但是"}, {"type": "subtitle", "time": 12559.11, "timestamp": "03:29:19", "text": "我做不到。"}, {"type": "subtitle", "time": 12561.349, "timestamp": "03:29:21", "text": "你为什么想玩《Pal World》？那"}, {"type": "subtitle", "time": 12564.95, "timestamp": "03:29:24", "text": "游戏就像……我觉得……没那么简单。"}, {"type": "subtitle", "time": 12566.95, "timestamp": "03:29:26", "text": "游戏大概只持续了一周左右。"}, {"type": "subtitle", "time": 12569.429, "timestamp": "03:29:29", "text": "两个，然后就消失了？"}, {"type": "subtitle", "time": 12571.51, "timestamp": "03:29:31", "text": "什么？它消失了。它仍然存在。"}, {"type": "subtitle", "time": 12573.429, "timestamp": "03:29:33", "text": "正确的？"}, {"type": "subtitle", "time": 12575.349, "timestamp": "03:29:35", "text": "它的确存在。我只是说说而已。"}, {"type": "subtitle", "time": 12578.87, "timestamp": "03:29:38", "text": "它的人气消失了。"}, {"type": "subtitle", "time": 12585.269, "timestamp": "03:29:45", "text": "现在还有谁玩那个游戏？"}]
[{"type": "subtitle", "time": 12906.63, "timestamp": "03:35:06", "text": "快点。你的基本生活必需品是什么？"}, {"type": "subtitle", "time": 12910.71, "timestamp": "03:35:10", "text": "任务是什么？什么是呃，收集松散"}, {"type": "subtitle", "time": 12913.03, "timestamp": "03:35:13", "text": "石头棍？"}, {"type": "subtitle", "time": 12915.11, "timestamp": "03:35:15", "text": "我正在这样做。只做那几个。"}, {"type": "subtitle", "time": 12916.79, "timestamp": "03:35:16", "text": "不要做那种精神"}, {"type": "subtitle", "time": 12919.229, "timestamp": "03:35:19", "text": "监护人。这就像是我们必须做的。"}, {"type": "subtitle", "time": 12935.59, "timestamp": "03:35:35", "text": "制作一个工作台。"}, {"type": "subtitle", "time": 12943.11, "timestamp": "03:35:43", "text": "构建模组，对吧？"}, {"type": "subtitle", "time": 12945.83, "timestamp": "03:35:45", "text": "是的。"}, {"type": "subtitle", "time": 12950.309, "timestamp": "03:35:50", "text": "如何获得什么？"}, {"type": "subtitle", "time": 12952.87, "timestamp": "03:35:52", "text": "哦，按K键。我想你应该能看到……"}, {"type": "subtitle", "time": 12956.389, "timestamp": "03:35:56", "text": "当时的知识等等。按。好的。"}, {"type": "subtitle", "time": 12957.91, "timestamp": "03:35:57", "text": "现在你可以看到你都做了些什么"}]
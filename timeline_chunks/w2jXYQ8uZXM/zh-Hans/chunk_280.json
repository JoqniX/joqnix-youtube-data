[{"type": "subtitle", "time": 16801.51, "timestamp": "04:40:01", "text": "你打算深入探索吗？"}, {"type": "subtitle", "time": 16810.708, "timestamp": "04:40:10", "text": "哦，为什么我听到跳跃声？哦，你是"}, {"type": "subtitle", "time": 16812.55, "timestamp": "04:40:12", "text": "演奏你自己的歌曲。哦，是的。是的。"}, {"type": "subtitle", "time": 16819.788, "timestamp": "04:40:19", "text": "谢谢。"}, {"type": "subtitle", "time": 16822.868, "timestamp": "04:40:22", "text": "回家真开心。"}, {"type": "subtitle", "time": 16826.628, "timestamp": "04:40:26", "text": "我的天啊。一次漫长的探险需要多长时间？"}, {"type": "subtitle", "time": 16830.15, "timestamp": "04:40:30", "text": "你去了吗？至少你没死。"}, {"type": "subtitle", "time": 16831.75, "timestamp": "04:40:31", "text": "是啊，至少你没死。"}, {"type": "subtitle", "time": 16841.35, "timestamp": "04:40:41", "text": "我们。嗯，总有一天我会进步的。"}, {"type": "subtitle", "time": 16842.51, "timestamp": "04:40:42", "text": "生存"}, {"type": "subtitle", "time": 16846.55, "timestamp": "04:40:46", "text": "游戏。有一天。他说："}, {"type": "subtitle", "time": 16856.628, "timestamp": "04:40:56", "text": "我得弥补一下，因为我快要死了。哦"}, {"type": "subtitle", "time": 16858.51, "timestamp": "04:40:58", "text": "我的上帝。"}]
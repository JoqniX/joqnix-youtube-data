[{"type": "subtitle", "time": 18241.99, "timestamp": "05:04:01", "text": "是的，他不知道，因为过了一段时间"}, {"type": "subtitle", "time": 18244.868, "timestamp": "05:04:04", "text": "前。"}, {"type": "subtitle", "time": 18248.07, "timestamp": "05:04:08", "text": "开始了。更多萤石。"}, {"type": "subtitle", "time": 18250.868, "timestamp": "05:04:10", "text": "哦，一点点"}, {"type": "subtitle", "time": 18255.67, "timestamp": "05:04:15", "text": "你去了哪里打这么多怪？"}, {"type": "subtitle", "time": 18257.27, "timestamp": "05:04:17", "text": "对不起。"}, {"type": "subtitle", "time": 18261.19, "timestamp": "05:04:21", "text": "祝福你。祝福你。谢谢。"}, {"type": "subtitle", "time": 18270.11, "timestamp": "05:04:30", "text": "哦，我的车载设备损坏了。"}, {"type": "subtitle", "time": 18273.75, "timestamp": "05:04:33", "text": "好的。我的车载设备总是损坏。"}, {"type": "subtitle", "time": 18287.07, "timestamp": "05:04:47", "text": "我有"}, {"type": "subtitle", "time": 18297.11, "timestamp": "05:04:57", "text": "两个箱子。哦，我的魔法值用完了。你"}, {"type": "subtitle", "time": 18299.59, "timestamp": "05:04:59", "text": "各位还有魔法值吗？我喜欢那样。"}]
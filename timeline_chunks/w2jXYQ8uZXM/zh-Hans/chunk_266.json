[{"type": "subtitle", "time": 15961.75, "timestamp": "04:26:01", "text": "因为我们需要水上摩托艇之类的东西。一架喷气式飞机。"}, {"type": "subtitle", "time": 15966.4, "timestamp": "04:26:06", "text": "那里有一辆水上摩托艇。什么？更像是"}, {"type": "subtitle", "time": 15969.149, "timestamp": "04:26:09", "text": "[音乐]"}, {"type": "subtitle", "time": 15972.71, "timestamp": "04:26:12", "text": "冲浪板。而不是水上摩托艇。更多的"}, {"type": "subtitle", "time": 15976.99, "timestamp": "04:26:16", "text": "就像冲浪板一样。但这游戏真是太……"}, {"type": "subtitle", "time": 15980.309, "timestamp": "04:26:20", "text": "凉爽的。他前一秒还因为……而生气"}, {"type": "subtitle", "time": 15982.55, "timestamp": "04:26:22", "text": "游戏，下一刻"}, {"type": "subtitle", "time": 15990.63, "timestamp": "04:26:30", "text": "对，扑上去。扑上去揍他。我们跳到那里。"}, {"type": "subtitle", "time": 15997.75, "timestamp": "04:26:37", "text": "好的，我们需要做一个梯子。你"}, {"type": "subtitle", "time": 16000.309, "timestamp": "04:26:40", "text": "朋友，你还有木头吗？"}, {"type": "subtitle", "time": 16004.229, "timestamp": "04:26:44", "text": "我愿意。我愿意。请拿走这叠东西。"}, {"type": "subtitle", "time": 16011.189, "timestamp": "04:26:51", "text": "我的天啊。我像个"}, {"type": "subtitle", "time": 16015.91, "timestamp": "04:26:55", "text": "我成功了。我差点死了，但我活下来了。"}, {"type": "subtitle", "time": 16018.149, "timestamp": "04:26:58", "text": "我为什么现在表现得像个运动员？我"}]
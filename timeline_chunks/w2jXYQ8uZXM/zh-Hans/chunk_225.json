[{"type": "subtitle", "time": 13502.309, "timestamp": "03:45:02", "text": "屋顶、门、墙、梯子。"}, {"type": "subtitle", "time": 13509.429, "timestamp": "03:45:09", "text": "我只是……我只是坐着而已。"}, {"type": "subtitle", "time": 13511.91, "timestamp": "03:45:11", "text": "我等着你们离开。"}, {"type": "subtitle", "time": 13515.99, "timestamp": "03:45:15", "text": "你是如何制作睡袋的？"}, {"type": "subtitle", "time": 13519.189, "timestamp": "03:45:19", "text": "按下 B 键，你就可以做到了。"}, {"type": "subtitle", "time": 13520.63, "timestamp": "03:45:20", "text": "你有这道菜的食谱吗？首先"}, {"type": "subtitle", "time": 13523.189, "timestamp": "03:45:23", "text": "大家好，运动员"}, {"type": "subtitle", "time": 13525.349, "timestamp": "03:45:25", "text": "第一的。"}, {"type": "subtitle", "time": 13528.55, "timestamp": "03:45:28", "text": "我如何才能获得食谱？"}, {"type": "subtitle", "time": 13534.389, "timestamp": "03:45:34", "text": "呃，不。不，上去。向上滑动。"}, {"type": "subtitle", "time": 13536.55, "timestamp": "03:45:36", "text": "啊，睡袋。好的。好的。我看到了"}, {"type": "subtitle", "time": 13539.83, "timestamp": "03:45:39", "text": "我有食谱，但我做不出来。和"}, {"type": "subtitle", "time": 13542.469, "timestamp": "03:45:42", "text": "你需要什么？"}, {"type": "subtitle", "time": 13544.469, "timestamp": "03:45:44", "text": "我觉得在制作过程中看不到它。"}, {"type": "subtitle", "time": 13546.309, "timestamp": "03:45:46", "text": "食谱。"}, {"type": "subtitle", "time": 13552.15, "timestamp": "03:45:52", "text": "你能过来告诉我们一下吗？"}, {"type": "subtitle", "time": 13554.309, "timestamp": "03:45:54", "text": "你们的材料足够多了，"}, {"type": "subtitle", "time": 13556.15, "timestamp": "03:45:56", "text": "小伙子？"}, {"type": "subtitle", "time": 13558.79, "timestamp": "03:45:58", "text": "建造模式。好吧，我没看到。"}]
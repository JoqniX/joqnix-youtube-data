[{"type": "subtitle", "time": 16214.95, "timestamp": "04:30:14", "text": "我独自踏上冒险之旅。不要跟随"}, {"type": "subtitle", "time": 16217.75, "timestamp": "04:30:17", "text": "顺便说一句，是我。这可能会导致"}, {"type": "subtitle", "time": 16236.189, "timestamp": "04:30:36", "text": "我的天哪，我快要……"}, {"type": "subtitle", "time": 16246.51, "timestamp": "04:30:46", "text": "是的。我几乎"}, {"type": "subtitle", "time": 16249.83, "timestamp": "04:30:49", "text": "死了。耶稣。我想我们都有各自的……"}, {"type": "subtitle", "time": 16251.51, "timestamp": "04:30:51", "text": "自己的冒险经历。开玩笑的，你明白吗？"}, {"type": "subtitle", "time": 16254.55, "timestamp": "04:30:54", "text": "我？我来了。"}, {"type": "subtitle", "time": 16257.11, "timestamp": "04:30:57", "text": "不，不要。你可能会死。怎么回事？"}]
[{"type": "subtitle", "time": 19622.47, "timestamp": "05:27:02", "text": "它有什么作用？当你杀死敌人时，"}, {"type": "subtitle", "time": 19625.27, "timestamp": "05:27:05", "text": "它会爆炸，对附近所有敌人造成伤害。"}, {"type": "subtitle", "time": 19628.07, "timestamp": "05:27:08", "text": "有人想要那个吗？"}, {"type": "subtitle", "time": 19631.91, "timestamp": "05:27:11", "text": "可以拿到。得到它。如何删除一个"}, {"type": "subtitle", "time": 19634.55, "timestamp": "05:27:14", "text": "物品。"}, {"type": "subtitle", "time": 19638.55, "timestamp": "05:27:18", "text": "哦，喂狗吧。"}, {"type": "subtitle", "time": 19644.23, "timestamp": "05:27:24", "text": "是的。简单的。"}, {"type": "subtitle", "time": 19648.708, "timestamp": "05:27:28", "text": "我要把我的裤子给别人。"}, {"type": "subtitle", "time": 19650.31, "timestamp": "05:27:30", "text": "耶。"}, {"type": "subtitle", "time": 19656.75, "timestamp": "05:27:36", "text": "[音乐]"}, {"type": "subtitle", "time": 19659.67, "timestamp": "05:27:39", "text": "耶。如果有人想要骨钉的话，"}, {"type": "subtitle", "time": 19674.708, "timestamp": "05:27:54", "text": "你赢了一场。"}]
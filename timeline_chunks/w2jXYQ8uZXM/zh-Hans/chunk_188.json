[{"type": "subtitle", "time": 11282.07, "timestamp": "03:08:02", "text": "三。我不记得我要去哪里了。"}, {"type": "subtitle", "time": 11284.71, "timestamp": "03:08:04", "text": "我不记得了，但我也不知道。我"}, {"type": "subtitle", "time": 11293.03, "timestamp": "03:08:13", "text": "我们会习惯的。哦好的。我发现"}, {"type": "subtitle", "time": 11294.87, "timestamp": "03:08:14", "text": "它。"}, {"type": "subtitle", "time": 11299.19, "timestamp": "03:08:19", "text": "我们明白了。是的，"}, {"type": "subtitle", "time": 11302.349, "timestamp": "03:08:22", "text": "我也升级了。我还可以看到什么"}, {"type": "subtitle", "time": 11305.19, "timestamp": "03:08:25", "text": "升级速度比……快。好的，我是"}, {"type": "subtitle", "time": 11306.99, "timestamp": "03:08:26", "text": "准备制作一个"}, {"type": "subtitle", "time": 11311.389, "timestamp": "03:08:31", "text": "长矛，呃，我想是……"}, {"type": "subtitle", "time": 11326.429, "timestamp": "03:08:46", "text": "好的，减少了两项。我得到了很多"}, {"type": "subtitle", "time": 11335.83, "timestamp": "03:08:55", "text": "你说，他们确实生产绷带。哦，"}]
[{"type": "subtitle", "time": 2463.67, "timestamp": "00:41:03", "text": "秘密 新秘密。制定新的秘密"}, {"type": "subtitle", "time": 2474.79, "timestamp": "00:41:14", "text": "那。不能展示那些东西。实际上"}, {"type": "subtitle", "time": 2477.109, "timestamp": "00:41:17", "text": "可能会被撞到。不像我那样吸食大麻"}, {"type": "subtitle", "time": 2479.15, "timestamp": "00:41:19", "text": "可能会说话"}, {"type": "subtitle", "time": 2496.19, "timestamp": "00:41:36", "text": "和 P"}, {"type": "subtitle", "time": 2499.589, "timestamp": "00:41:39", "text": "我喜欢这一点：每一个"}, {"type": "subtitle", "time": 2502.069, "timestamp": "00:41:42", "text": "现在人工智能就在那里，我感觉就像这样。"}, {"type": "subtitle", "time": 2503.829, "timestamp": "00:41:43", "text": "我现在做的所有东西都好多。"}, {"type": "subtitle", "time": 2505.71, "timestamp": "00:41:45", "text": "我自己申请"}, {"type": "subtitle", "time": 2519.67, "timestamp": "00:41:59", "text": "太棒了，我喜欢！我喜欢它。我喜欢它。"}]
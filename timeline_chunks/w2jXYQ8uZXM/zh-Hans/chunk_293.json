[{"type": "subtitle", "time": 17581.27, "timestamp": "04:53:01", "text": "好的。好的。想挑战第一个boss"}, {"type": "subtitle", "time": 17584.39, "timestamp": "04:53:04", "text": "打架还是我们说的什么？好的。我们只是"}, {"type": "subtitle", "time": 17587.67, "timestamp": "04:53:07", "text": "可以休息一下，做点小事。"}, {"type": "subtitle", "time": 17589.51, "timestamp": "04:53:09", "text": "我正在做一件事，然后我们……"}, {"type": "subtitle", "time": 17591.47, "timestamp": "04:53:11", "text": "一起出现。"}, {"type": "subtitle", "time": 17593.43, "timestamp": "04:53:13", "text": "好的。"}, {"type": "subtitle", "time": 17595.11, "timestamp": "04:53:15", "text": "我先去主楼拿点吃的，我"}, {"type": "subtitle", "time": 17597.19, "timestamp": "04:53:17", "text": "猜测。是的，准备食物和其他"}, {"type": "subtitle", "time": 17605.03, "timestamp": "04:53:25", "text": "弄点海藻之类的东西。"}, {"type": "subtitle", "time": 17607.27, "timestamp": "04:53:27", "text": "我们需要这些东西，否则我们将"}, {"type": "subtitle", "time": 17608.55, "timestamp": "04:53:28", "text": "死。我的意思是，我不知道我该怎么做"}, {"type": "subtitle", "time": 17610.788, "timestamp": "04:53:30", "text": "幸存了下来。你知道，在中间"}, {"type": "subtitle", "time": 17613.19, "timestamp": "04:53:33", "text": "旅途中，我非常需要摇滚乐，但我没有"}, {"type": "subtitle", "time": 17619.75, "timestamp": "04:53:39", "text": "是的，我正要走。我没有"}, {"type": "subtitle", "time": 17621.59, "timestamp": "04:53:41", "text": "知道阿拉苏去了哪里，但他去了"}, {"type": "subtitle", "time": 17623.43, "timestamp": "04:53:43", "text": "某处。"}, {"type": "subtitle", "time": 17625.31, "timestamp": "04:53:45", "text": "我的意思是，你可以看看"}, {"type": "subtitle", "time": 17629.67, "timestamp": "04:53:49", "text": "银河护卫队的速度设定。我们有了一个新的"}, {"type": "subtitle", "time": 17634.15, "timestamp": "04:53:54", "text": "是的。是的。那很好。那很好。"}]
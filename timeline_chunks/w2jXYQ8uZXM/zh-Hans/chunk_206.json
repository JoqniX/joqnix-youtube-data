[{"type": "subtitle", "time": 12361.349, "timestamp": "03:26:01", "text": "我该如何返回？完全退出游戏。"}, {"type": "subtitle", "time": 12363.11, "timestamp": "03:26:03", "text": "不，你必须完全退出游戏。"}, {"type": "subtitle", "time": 12366.229, "timestamp": "03:26:06", "text": "好的。全部都是满的。"}, {"type": "subtitle", "time": 12369.59, "timestamp": "03:26:09", "text": "哇。是啊，确实有点奇怪。"}, {"type": "subtitle", "time": 12372.55, "timestamp": "03:26:12", "text": "或许是因为它还在演示阶段。"}, {"type": "subtitle", "time": 12374.469, "timestamp": "03:26:14", "text": "嗯，大概吧。没关系。哦，还有更多"}, {"type": "subtitle", "time": 12381.91, "timestamp": "03:26:21", "text": "你为什么要把箭浪费在那些家伙身上？"}, {"type": "subtitle", "time": 12383.79, "timestamp": "03:26:23", "text": "直接捏他们的头。"}, {"type": "subtitle", "time": 12386.63, "timestamp": "03:26:26", "text": "哎哟。好的。"}, {"type": "subtitle", "time": 12395.03, "timestamp": "03:26:35", "text": "总之，让我用一些匪帮新闻吧。"}, {"type": "subtitle", "time": 12403.75, "timestamp": "03:26:43", "text": "好的，我正在重新启动。"}, {"type": "subtitle", "time": 12407.19, "timestamp": "03:26:47", "text": "是的。嗯，阿拉苏，现在请把……发给他"}, {"type": "subtitle", "time": 12409.83, "timestamp": "03:26:49", "text": "他无法获得加入游戏的密码"}, {"type": "subtitle", "time": 12413.349, "timestamp": "03:26:53", "text": "再次按下开始游戏按钮。"}]
[{"type": "subtitle", "time": 22202.51, "timestamp": "06:10:02", "text": "棉花糖。我开始做"}, {"type": "subtitle", "time": 22205.67, "timestamp": "06:10:05", "text": "你知道，就是棉花糖。嗯，我觉得"}, {"type": "subtitle", "time": 22207.628, "timestamp": "06:10:07", "text": "棉花糖是"}, {"type": "subtitle", "time": 22210.83, "timestamp": "06:10:10", "text": "经常被使用的东西"}, {"type": "subtitle", "time": 22214.548, "timestamp": "06:10:14", "text": "其他的。嗯，是的，我想，我想"}, {"type": "subtitle", "time": 22215.47, "timestamp": "06:10:15", "text": "要做"}, {"type": "subtitle", "time": 22220.39, "timestamp": "06:10:20", "text": "它。我想做这件事。所以，我想这样做"}, {"type": "subtitle", "time": 22223.83, "timestamp": "06:10:23", "text": "它。我想回答任何人的问题。"}, {"type": "subtitle", "time": 22226.39, "timestamp": "06:10:26", "text": "对我来说是这样。"}, {"type": "subtitle", "time": 22228.91, "timestamp": "06:10:28", "text": "所以，所以"}, {"type": "subtitle", "time": 22233.548, "timestamp": "06:10:33", "text": "等等，棉花糖系统被屏蔽了吗？"}, {"type": "subtitle", "time": 22236.15, "timestamp": "06:10:36", "text": "中国？哦，我得查一下。我"}, {"type": "subtitle", "time": 22238.708, "timestamp": "06:10:38", "text": "需要查一下，因为我也可能"}, {"type": "subtitle", "time": 22241.47, "timestamp": "06:10:41", "text": "也把它用在比利身上。"}, {"type": "subtitle", "time": 22246.75, "timestamp": "06:10:46", "text": "未来。是的，我应该那样做。所以，"}, {"type": "subtitle", "time": 22248.91, "timestamp": "06:10:48", "text": "戴安娜。是的。等待。"}, {"type": "subtitle", "time": 22251.91, "timestamp": "06:10:51", "text": "嗯，棉花糖，对吧？呃，让我拿一下"}, {"type": "subtitle", "time": 22259.708, "timestamp": "06:10:59", "text": "啊，你好。呃，我会像"}]
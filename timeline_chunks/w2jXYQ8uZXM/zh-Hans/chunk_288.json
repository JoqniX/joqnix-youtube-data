[{"type": "subtitle", "time": 17280.15, "timestamp": "04:48:00", "text": "90年代。我们快到了。操完"}, {"type": "subtitle", "time": 17281.55, "timestamp": "04:48:01", "text": "太多了"}, {"type": "subtitle", "time": 17283.67, "timestamp": "04:48:03", "text": "死亡人数。哦，别掉到边缘去。哦，"}, {"type": "subtitle", "time": 17288.35, "timestamp": "04:48:08", "text": "兄弟，建造数量是有限制的。该死的。"}, {"type": "subtitle", "time": 17291.51, "timestamp": "04:48:11", "text": "不，你想跳槽到Arisa吗？等等，我……"}, {"type": "subtitle", "time": 17293.51, "timestamp": "04:48:13", "text": "他千里迢迢而来，就为了浪费我们的时间？"}, {"type": "subtitle", "time": 17296.55, "timestamp": "04:48:16", "text": "东西？哦，是的，我们做到了。我的天哪。等等，可以"}, {"type": "subtitle", "time": 17299.83, "timestamp": "04:48:19", "text": "你想跳到我们房间来吗？为什么"}, {"type": "subtitle", "time": 17302.31, "timestamp": "04:48:22", "text": "你想死吗？我想在旁边重生"}, {"type": "subtitle", "time": 17304.23, "timestamp": "04:48:24", "text": "但他呢？我性格很强硬。我们可以走了"}, {"type": "subtitle", "time": 17308.31, "timestamp": "04:48:28", "text": "轻轻放下。不，我要跳下去。"}, {"type": "subtitle", "time": 17310.47, "timestamp": "04:48:30", "text": "我的天啊。不，去弄滑翔机。我们有"}, {"type": "subtitle", "time": 17312.55, "timestamp": "04:48:32", "text": "到"}, {"type": "subtitle", "time": 17316.23, "timestamp": "04:48:36", "text": "我们必须弄到滑翔机。"}, {"type": "subtitle", "time": 17321.35, "timestamp": "04:48:41", "text": "我还活着。如何？等等，怎么做到的？他妈的"}, {"type": "subtitle", "time": 17324.47, "timestamp": "04:48:44", "text": "好运降临。正在下降。我 我"}, {"type": "subtitle", "time": 17326.788, "timestamp": "04:48:46", "text": "跳跃。我要跳起来。好吧，我相当"}, {"type": "subtitle", "time": 17328.27, "timestamp": "04:48:48", "text": "他肯定会这么做"}, {"type": "subtitle", "time": 17336.55, "timestamp": "04:48:56", "text": "别他妈死了。不，我不会。为什么？"}, {"type": "subtitle", "time": 17338.788, "timestamp": "04:48:58", "text": "兄弟，你什么意思？"}]
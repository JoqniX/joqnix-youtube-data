[{"type": "subtitle", "time": 13150.51, "timestamp": "03:39:10", "text": "天哪，这也太卡了吧。好的。"}, {"type": "subtitle", "time": 13159.349, "timestamp": "03:39:19", "text": "想怎么建就怎么建。"}, {"type": "subtitle", "time": 13161.75, "timestamp": "03:39:21", "text": "制作。这就像所有的力量，所有"}, {"type": "subtitle", "time": 13169.349, "timestamp": "03:39:29", "text": "想。耐力。"}, {"type": "subtitle", "time": 13171.349, "timestamp": "03:39:31", "text": "呃，让我来做些绷带吧。"}, {"type": "subtitle", "time": 13196.389, "timestamp": "03:39:56", "text": "你从哪里弄到资源来制作的？"}, {"type": "subtitle", "time": 13199.07, "timestamp": "03:39:59", "text": "哦，请减少一些。而且你可以"}]
[{"type": "subtitle", "time": 13382.15, "timestamp": "03:43:02", "text": "是的。是的。当然，当然，当然。我们需要"}, {"type": "subtitle", "time": 13389.95, "timestamp": "03:43:09", "text": "还需要到达那座塔。"}, {"type": "subtitle", "time": 13393.39, "timestamp": "03:43:13", "text": "去抢点战利品吧。"}, {"type": "subtitle", "time": 13398.87, "timestamp": "03:43:18", "text": "各位，注意控制食量。请观看"}, {"type": "subtitle", "time": 13403.99, "timestamp": "03:43:23", "text": "你的饥饿感。我的快满了。"}, {"type": "subtitle", "time": 13406.15, "timestamp": "03:43:26", "text": "我的满了。我会吃得像……"}, {"type": "subtitle", "time": 13419.189, "timestamp": "03:43:39", "text": "你从中得不到树脂吗？"}, {"type": "subtitle", "time": 13422.389, "timestamp": "03:43:42", "text": "从树上长出来的。在岩石上。"}, {"type": "subtitle", "time": 13439.469, "timestamp": "03:43:59", "text": "[音乐]"}]
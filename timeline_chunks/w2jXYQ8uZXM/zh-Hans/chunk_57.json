[{"type": "subtitle", "time": 3441.309, "timestamp": "00:57:21", "text": "向下？为什么会说它是"}, {"type": "subtitle", "time": 3444.109, "timestamp": "00:57:24", "text": "黎明？那是"}, {"type": "subtitle", "time": 3461.03, "timestamp": "00:57:41", "text": "诡异的。我喜欢它不是这样的这一点"}, {"type": "subtitle", "time": 3465.03, "timestamp": "00:57:45", "text": "甚至还发送了按钮提示信息。"}, {"type": "subtitle", "time": 3466.43, "timestamp": "00:57:46", "text": "比如如果是的话"}, {"type": "subtitle", "time": 3470.51, "timestamp": "00:57:50", "text": "向下看，它就显示了这个弹出"}, {"type": "subtitle", "time": 3473.39, "timestamp": "00:57:53", "text": "向上。但它始终没有爆裂。"}]
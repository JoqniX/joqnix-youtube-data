[{"type": "subtitle", "time": 18545.83, "timestamp": "05:09:05", "text": "老板之后，我就拿了一小块"}, {"type": "subtitle", "time": 18549.51, "timestamp": "05:09:09", "text": "砖块，然后泡杯茶。好的。哦，我"}, {"type": "subtitle", "time": 18552.23, "timestamp": "05:09:12", "text": "认为你"}, {"type": "subtitle", "time": 18554.788, "timestamp": "05:09:14", "text": "别忘了我的法力值。呃，我的盔甲。是的，"}, {"type": "subtitle", "time": 18555.67, "timestamp": "05:09:15", "text": "我有。我有。我正要去"}, {"type": "subtitle", "time": 18558.59, "timestamp": "05:09:18", "text": "向后。"}, {"type": "subtitle", "time": 18566.07, "timestamp": "05:09:26", "text": "他们。全速。我得到了它。该死。我们"}, {"type": "subtitle", "time": 18567.91, "timestamp": "05:09:27", "text": "只需要沿着桥走就行了。"}, {"type": "subtitle", "time": 18578.39, "timestamp": "05:09:38", "text": "我觉得没问题。"}, {"type": "subtitle", "time": 18580.868, "timestamp": "05:09:40", "text": "我只是去废墟那里工作。不用担心。"}, {"type": "subtitle", "time": 18582.47, "timestamp": "05:09:42", "text": "我觉得我搞砸了。好的。得到"}, {"type": "subtitle", "time": 18586.55, "timestamp": "05:09:46", "text": "红鸡蛋。你拿到了红色。我有点"}, {"type": "subtitle", "time": 18588.39, "timestamp": "05:09:48", "text": "搞砸了。"}, {"type": "subtitle", "time": 18590.99, "timestamp": "05:09:50", "text": "你做了什么？我是"}]
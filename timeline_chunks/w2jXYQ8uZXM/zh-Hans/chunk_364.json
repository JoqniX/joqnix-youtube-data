[{"type": "subtitle", "time": 21840.948, "timestamp": "06:04:00", "text": "我今天为什么去摸草呢？"}, {"type": "subtitle", "time": 21846.99, "timestamp": "06:04:06", "text": "回来得有点晚，而且我……"}, {"type": "subtitle", "time": 21849.83, "timestamp": "06:04:09", "text": "会议正在进行中，我在这里。我有一些课程"}, {"type": "subtitle", "time": 21881.27, "timestamp": "06:04:41", "text": "我的音量可以吗？你能吗？"}, {"type": "subtitle", "time": 21884.708, "timestamp": "06:04:44", "text": "你们让我知道，如果这是我的"}, {"type": "subtitle", "time": 21888.948, "timestamp": "06:04:48", "text": "音频音量合适吗？我是音频吗？哦"}, {"type": "subtitle", "time": 21893.19, "timestamp": "06:04:53", "text": "等等，我必须做这件事。我能被听到吗？"}, {"type": "subtitle", "time": 21896.31, "timestamp": "06:04:56", "text": "难道这不是一件合适的衣服吗？"}, {"type": "subtitle", "time": 21898.31, "timestamp": "06:04:58", "text": "背景音乐没有影响我的"}]
[{"type": "subtitle", "time": 14822.95, "timestamp": "04:07:02", "text": "好的。我做了些基础美甲，正在愈合中"}, {"type": "subtitle", "time": 14826.309, "timestamp": "04:07:06", "text": "药水、碎石、发光石。好的。"}, {"type": "subtitle", "time": 14828.229, "timestamp": "04:07:08", "text": "哦，那真不错。嗯，我回来了。"}, {"type": "subtitle", "time": 14831.99, "timestamp": "04:07:11", "text": "给你们。你需要知道我并没有死。"}, {"type": "subtitle", "time": 14835.51, "timestamp": "04:07:15", "text": "我在水里。我在水下。"}, {"type": "subtitle", "time": 14838.07, "timestamp": "04:07:18", "text": "他被淹没在水下。"}, {"type": "subtitle", "time": 14841.269, "timestamp": "04:07:21", "text": "是的，我在水下。等待。所以，可以吗？"}, {"type": "subtitle", "time": 14844.229, "timestamp": "04:07:24", "text": "你们从事水下探险活动吗？"}, {"type": "subtitle", "time": 14846.15, "timestamp": "04:07:26", "text": "是的，那里有城堡之类的东西。"}, {"type": "subtitle", "time": 14847.99, "timestamp": "04:07:27", "text": "但就像在内心深处。不在这个"}, {"type": "subtitle", "time": 14855.189, "timestamp": "04:07:35", "text": "是的。是的。对了，这他妈在哪儿？"}, {"type": "subtitle", "time": 14858.67, "timestamp": "04:07:38", "text": "你是？我目前为止"}, {"type": "subtitle", "time": 14863.75, "timestamp": "04:07:43", "text": "离开。我几乎就要伸到那只手了。"}, {"type": "subtitle", "time": 14866.87, "timestamp": "04:07:46", "text": "为什么现在还没恢复？哟，现在"}, {"type": "subtitle", "time": 14869.269, "timestamp": "04:07:49", "text": "你来找我。"}, {"type": "subtitle", "time": 14873.99, "timestamp": "04:07:53", "text": "我想要木头。我想要木头。"}]
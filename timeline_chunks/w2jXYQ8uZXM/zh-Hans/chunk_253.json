[{"type": "subtitle", "time": 15185.11, "timestamp": "04:13:05", "text": "我猜我只能努力奋斗了。我得到了"}, {"type": "subtitle", "time": 15187.349, "timestamp": "04:13:07", "text": "用维修机修理东西。"}, {"type": "subtitle", "time": 15190.71, "timestamp": "04:13:10", "text": "你可以修好它。那确实有这么回事。是的，"}, {"type": "subtitle", "time": 15208.229, "timestamp": "04:13:28", "text": "我的肘部。呃，"}, {"type": "subtitle", "time": 15209.99, "timestamp": "04:13:29", "text": "我们需要拿到另一个蛋。和"}, {"type": "subtitle", "time": 15211.83, "timestamp": "04:13:31", "text": "这家伙正在拿走这家伙已经死了，就像"}, {"type": "subtitle", "time": 15214.309, "timestamp": "04:13:34", "text": "这已经是两次了。"}, {"type": "subtitle", "time": 15218.71, "timestamp": "04:13:38", "text": "是的。第一人称射击游戏玩家。顺便一提，"}, {"type": "subtitle", "time": 15222.229, "timestamp": "04:13:42", "text": "我家根本不玩生存模式。"}, {"type": "subtitle", "time": 15224.229, "timestamp": "04:13:44", "text": "啊，"}, {"type": "subtitle", "time": 15233.75, "timestamp": "04:13:53", "text": "我仍在思考如何……"}, {"type": "subtitle", "time": 15237.99, "timestamp": "04:13:57", "text": "把你的东西找回来。哦，该死。"}]
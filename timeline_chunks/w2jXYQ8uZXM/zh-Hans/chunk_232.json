[{"type": "subtitle", "time": 13922.55, "timestamp": "03:52:02", "text": "第二。很多。我没什么可做的"}, {"type": "subtitle", "time": 13926.469, "timestamp": "03:52:06", "text": "在任务日志中完成。这正常吗？"}, {"type": "subtitle", "time": 13928.79, "timestamp": "03:52:08", "text": "战斗入门。你看到了吗？"}, {"type": "subtitle", "time": 13938.71, "timestamp": "03:52:18", "text": "如何关闭任务日志？"}, {"type": "subtitle", "time": 13940.63, "timestamp": "03:52:20", "text": "不，没关系。它就一直待在那里。你"}, {"type": "subtitle", "time": 13942.389, "timestamp": "03:52:22", "text": "无法关闭。该死的。好的。和"}, {"type": "subtitle", "time": 13944.79, "timestamp": "03:52:24", "text": "长矛。"}, {"type": "subtitle", "time": 13946.55, "timestamp": "03:52:26", "text": "你制作长矛。你想制作"}, {"type": "subtitle", "time": 13949.11, "timestamp": "03:52:29", "text": "你自己"}, {"type": "subtitle", "time": 13950.309, "timestamp": "03:52:30", "text": "比如，“是啊，我会做一根长矛……”"}, {"type": "subtitle", "time": 13952.07, "timestamp": "03:52:32", "text": "我自己。” 好吧。好吧。我做到了。我做到了。"}, {"type": "subtitle", "time": 13954.71, "timestamp": "03:52:34", "text": "它。我成功了。我成功了。该死的。"}, {"type": "subtitle", "time": 13956.469, "timestamp": "03:52:36", "text": "你还有多余的吗？你有吗？"}, {"type": "subtitle", "time": 13959.11, "timestamp": "03:52:39", "text": "多余蟹壳？"}, {"type": "subtitle", "time": 13960.63, "timestamp": "03:52:40", "text": "蟹壳。等等，找到了。我有"}, {"type": "subtitle", "time": 13963.349, "timestamp": "03:52:43", "text": "二。我有两个。那是坚硬的外壳。"}, {"type": "subtitle", "time": 13965.83, "timestamp": "03:52:45", "text": "哦，等等。它坚硬且有壳。"}, {"type": "subtitle", "time": 13967.91, "timestamp": "03:52:47", "text": "那里有硬化。这里有一个"}, {"type": "subtitle", "time": 13970.63, "timestamp": "03:52:50", "text": "贝类。那是一个坚硬的外壳。"}, {"type": "subtitle", "time": 13973.11, "timestamp": "03:52:53", "text": "好的。也给我一个自私的硬汉。"}, {"type": "subtitle", "time": 13975.429, "timestamp": "03:52:55", "text": "我把它给了你，我付出了很多。什么"}, {"type": "subtitle", "time": 13979.11, "timestamp": "03:52:59", "text": "你的意思是？哦，等等。等待。呃，怎么会这样"}]
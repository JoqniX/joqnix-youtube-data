[{"type": "subtitle", "time": 12002.469, "timestamp": "03:20:02", "text": "请你自己去做。好的。"}, {"type": "subtitle", "time": 12005.59, "timestamp": "03:20:05", "text": "谢谢。再见。谢谢。好的。我们得到了"}, {"type": "subtitle", "time": 12007.95, "timestamp": "03:20:07", "text": "收集一些"}, {"type": "subtitle", "time": 12011.67, "timestamp": "03:20:11", "text": "对，就像绳子那玩意儿或者……"}, {"type": "subtitle", "time": 12013.429, "timestamp": "03:20:13", "text": "没错，这就是事实。"}, {"type": "subtitle", "time": 12016.99, "timestamp": "03:20:16", "text": "就是那片草。哦，为了"}, {"type": "subtitle", "time": 12019.269, "timestamp": "03:20:19", "text": "织物。它叫什么名字？植物纤维。"}, {"type": "subtitle", "time": 12021.349, "timestamp": "03:20:21", "text": "抱歉。哦，不。我有很多喜欢的东西。"}, {"type": "subtitle", "time": 12024.71, "timestamp": "03:20:24", "text": "这里是植物纤维。那就这样吧"}, {"type": "subtitle", "time": 12027.79, "timestamp": "03:20:27", "text": "我得到了99份植物纤维。"}, {"type": "subtitle", "time": 12031.75, "timestamp": "03:20:31", "text": "就在这个篮子里。你想做什么？"}, {"type": "subtitle", "time": 12057.11, "timestamp": "03:20:57", "text": "耶！该死，你身上好黑啊"}]
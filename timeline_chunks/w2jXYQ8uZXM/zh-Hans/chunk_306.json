[{"type": "subtitle", "time": 18360.31, "timestamp": "05:06:00", "text": "更多这样的。我有一些纤维。我"}, {"type": "subtitle", "time": 18363.19, "timestamp": "05:06:03", "text": "想想这里。六个。乐高积木。"}, {"type": "subtitle", "time": 18365.19, "timestamp": "05:06:05", "text": "古人安息何处？那是……"}, {"type": "subtitle", "time": 18370.31, "timestamp": "05:06:10", "text": "斗争？什么？"}, {"type": "subtitle", "time": 18372.55, "timestamp": "05:06:12", "text": "古老的安息。"}, {"type": "subtitle", "time": 18375.35, "timestamp": "05:06:15", "text": "是的。"}, {"type": "subtitle", "time": 18380.628, "timestamp": "05:06:20", "text": "然后我就得到了“好的”。"}, {"type": "subtitle", "time": 18382.628, "timestamp": "05:06:22", "text": "哦，你。他为什么在那边？我只是"}, {"type": "subtitle", "time": 18384.708, "timestamp": "05:06:24", "text": "给他换上了新的胸甲。等待，"}, {"type": "subtitle", "time": 18387.59, "timestamp": "05:06:27", "text": "等等，等等我。我来了。哦，我"}, {"type": "subtitle", "time": 18396.708, "timestamp": "05:06:36", "text": "是的。反正。是的，我们要单飞。"}, {"type": "subtitle", "time": 18401.43, "timestamp": "05:06:41", "text": "你在双人模式中阵亡，也在单人模式中阵亡。呃，所以"}, {"type": "subtitle", "time": 18405.55, "timestamp": "05:06:45", "text": "给你。谢谢。而且有"}, {"type": "subtitle", "time": 18408.23, "timestamp": "05:06:48", "text": "这。我不需要，我不需要，我甚至都不需要"}, {"type": "subtitle", "time": 18409.75, "timestamp": "05:06:49", "text": "我有弓箭，所以我不需要那个权利"}, {"type": "subtitle", "time": 18416.47, "timestamp": "05:06:56", "text": "我的意思是，我玩过很多这类游戏，所以我……"}, {"type": "subtitle", "time": 18419.51, "timestamp": "05:06:59", "text": "过去常用于盔甲。"}]
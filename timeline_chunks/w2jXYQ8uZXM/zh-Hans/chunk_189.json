[{"type": "subtitle", "time": 11346.07, "timestamp": "03:09:06", "text": "哦，我们需要树脂。"}, {"type": "subtitle", "time": 11364.83, "timestamp": "03:09:24", "text": "食物。我们需要更多这类食物。"}, {"type": "subtitle", "time": 11374.309, "timestamp": "03:09:34", "text": "宝石。嘿，多少钱？"}, {"type": "subtitle", "time": 11376.03, "timestamp": "03:09:36", "text": "是的，拿"}, {"type": "subtitle", "time": 11381.71, "timestamp": "03:09:41", "text": "这里"}, {"type": "subtitle", "time": 11385.67, "timestamp": "03:09:45", "text": "你知道，这就是我要投入我的纤维。"}, {"type": "subtitle", "time": 11388.95, "timestamp": "03:09:48", "text": "这边你可以带他们去我"}, {"type": "subtitle", "time": 11392.309, "timestamp": "03:09:52", "text": "把它们放到故事里。好的。我需要"}, {"type": "subtitle", "time": 11396.63, "timestamp": "03:09:56", "text": "很多“不，我需要纤维”。所以，我有"}]
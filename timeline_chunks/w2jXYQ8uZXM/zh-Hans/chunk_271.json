[{"type": "subtitle", "time": 16260.389, "timestamp": "04:31:00", "text": "你的平台？好的。什么？为什么是"}, {"type": "subtitle", "time": 16263.51, "timestamp": "04:31:03", "text": "有平台吗？好的。"}, {"type": "subtitle", "time": 16266.67, "timestamp": "04:31:06", "text": "你怎么样？我怎么样？"}, {"type": "subtitle", "time": 16272.79, "timestamp": "04:31:12", "text": "好的。我死了。我死了。他去世了。"}, {"type": "subtitle", "time": 16273.79, "timestamp": "04:31:13", "text": "什么？"}, {"type": "subtitle", "time": 16277.99, "timestamp": "04:31:17", "text": "我他妈的按了，我按了。你知道"}, {"type": "subtitle", "time": 16280.87, "timestamp": "04:31:20", "text": "我做了什么？我当时就像是在搭建东西。"}, {"type": "subtitle", "time": 16283.67, "timestamp": "04:31:23", "text": "我的闪避动作就像我的鼠标左键一样。"}, {"type": "subtitle", "time": 16285.91, "timestamp": "04:31:25", "text": "点击。我按下了，我真的按下了那个键。"}, {"type": "subtitle", "time": 16290.03, "timestamp": "04:31:30", "text": "我摔倒了。混蛋。"}, {"type": "subtitle", "time": 16293.83, "timestamp": "04:31:33", "text": "兄弟，我得去跳了。我开枪了。如果"}, {"type": "subtitle", "time": 16295.429, "timestamp": "04:31:35", "text": "你来了，你能挪一下吗？"}, {"type": "subtitle", "time": 16298.309, "timestamp": "04:31:38", "text": "用梯子带着它上去？是的。"}, {"type": "subtitle", "time": 16299.349, "timestamp": "04:31:39", "text": "是的，可以。但我认为我不是"}, {"type": "subtitle", "time": 16301.309, "timestamp": "04:31:41", "text": "我会这么做。请拿"}, {"type": "subtitle", "time": 16303.67, "timestamp": "04:31:43", "text": "它。不，我不想……我想慢跑。"}, {"type": "subtitle", "time": 16305.59, "timestamp": "04:31:45", "text": "完成我开始的事情。兄弟，跟上！"}, {"type": "subtitle", "time": 16308.63, "timestamp": "04:31:48", "text": "把我让你带走的东西拿去。"}, {"type": "subtitle", "time": 16319.269, "timestamp": "04:31:59", "text": "顺便说一句，我知道我的东西在哪儿。我"}]
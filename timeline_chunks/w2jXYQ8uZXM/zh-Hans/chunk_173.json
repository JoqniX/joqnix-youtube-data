[{"type": "subtitle", "time": 10388.63, "timestamp": "02:53:08", "text": "忘了。我希望游戏能正常运行。"}, {"type": "subtitle", "time": 10391.429, "timestamp": "02:53:11", "text": "你的回合结束了。因为它就像一个框架"}, {"type": "subtitle", "time": 10394.07, "timestamp": "02:53:14", "text": "我这边掉线了。"}, {"type": "subtitle", "time": 10397.15, "timestamp": "02:53:17", "text": "是的。是的。我害怕我的"}, {"type": "subtitle", "time": 10399.99, "timestamp": "02:53:19", "text": "结尾。他也让我检查一下，然后我就……"}, {"type": "subtitle", "time": 10402.309, "timestamp": "02:53:22", "text": "昨天忘了这事儿了。可能"}, {"type": "subtitle", "time": 10403.95, "timestamp": "02:53:23", "text": "已确认。上帝"}, {"type": "subtitle", "time": 10406.71, "timestamp": "02:53:26", "text": "该死。他把这件事忘了一段时间。"}, {"type": "subtitle", "time": 10411.13, "timestamp": "02:53:31", "text": "惊喜。这就是原因。"}, {"type": "subtitle", "time": 10412.83, "timestamp": "02:53:32", "text": "[音乐]"}, {"type": "subtitle", "time": 10416.63, "timestamp": "02:53:36", "text": "是的。好吧，好吧，乔，没关系。出色地"}, {"type": "subtitle", "time": 10419.429, "timestamp": "02:53:39", "text": "看看行不行。如果……如果它不……嗯……"}, {"type": "subtitle", "time": 10422.03, "timestamp": "02:53:42", "text": "我要对你大吼大叫。就是这样。"}, {"type": "subtitle", "time": 10425.91, "timestamp": "02:53:45", "text": "哇。什么？嗯，我大概会……"}, {"type": "subtitle", "time": 10430.55, "timestamp": "02:53:50", "text": "别对你大喊大叫。"}, {"type": "subtitle", "time": 10435.79, "timestamp": "02:53:55", "text": "嗯。是的。我会直播。而且确实如此"}, {"type": "subtitle", "time": 10439.03, "timestamp": "02:53:59", "text": "你觉得我们在做什么？或者你想做什么？"}]
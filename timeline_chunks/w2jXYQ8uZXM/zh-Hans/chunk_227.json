[{"type": "subtitle", "time": 13621.87, "timestamp": "03:47:01", "text": "该死的"}, {"type": "subtitle", "time": 13624.63, "timestamp": "03:47:04", "text": "男。总之，我们现在走吧。我们不需要"}, {"type": "subtitle", "time": 13626.99, "timestamp": "03:47:06", "text": "不想再待在这里了。"}, {"type": "subtitle", "time": 13630.469, "timestamp": "03:47:10", "text": "绷带。好的。哦，是的。他妈的。我"}, {"type": "subtitle", "time": 13633.269, "timestamp": "03:47:13", "text": "忘了。"}, {"type": "subtitle", "time": 13636.63, "timestamp": "03:47:16", "text": "我得做饭。"}, {"type": "subtitle", "time": 13644.59, "timestamp": "03:47:24", "text": "一些食物，一些绷带，以及"}, {"type": "subtitle", "time": 13653.429, "timestamp": "03:47:33", "text": "盾。呃，你们有树脂吗？我"}, {"type": "subtitle", "time": 13655.03, "timestamp": "03:47:35", "text": "我想我的确有。"}, {"type": "subtitle", "time": 13658.95, "timestamp": "03:47:38", "text": "该死的，阿拉苏。伙计，你为什么在水里？"}, {"type": "subtitle", "time": 13661.83, "timestamp": "03:47:41", "text": "我在这里。你在造船吗？"}, {"type": "subtitle", "time": 13664.469, "timestamp": "03:47:44", "text": "哦，"}, {"type": "subtitle", "time": 13673.59, "timestamp": "03:47:53", "text": "我做了“我们现在还不需要这艘船”这句话。"}, {"type": "subtitle", "time": 13676.75, "timestamp": "03:47:56", "text": "尽管。我们首先需要抓住一个"}]
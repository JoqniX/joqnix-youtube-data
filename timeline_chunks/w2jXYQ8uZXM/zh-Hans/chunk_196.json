[{"type": "subtitle", "time": 11765.429, "timestamp": "03:16:05", "text": "这个游戏还挺有意思的。这"}, {"type": "subtitle", "time": 11767.269, "timestamp": "03:16:07", "text": "不是的。顺便说一下，这叫做……"}, {"type": "subtitle", "time": 11771.19, "timestamp": "03:16:11", "text": "被称为美国步枪协会的处女。这是一个演示版本。"}, {"type": "subtitle", "time": 11773.429, "timestamp": "03:16:13", "text": "不过，作为演示来说，这已经很不错了。"}, {"type": "subtitle", "time": 11776.389, "timestamp": "03:16:16", "text": "太棒了，兄弟。还不错。"}, {"type": "subtitle", "time": 11777.389, "timestamp": "03:16:17", "text": "不会"}, {"type": "subtitle", "time": 11780.99, "timestamp": "03:16:20", "text": "说谎。它很漂亮"}, {"type": "subtitle", "time": 11783.349, "timestamp": "03:16:23", "text": "好的。你可以自己尝试一下。"}, {"type": "subtitle", "time": 11791.51, "timestamp": "03:16:31", "text": "我又回来了，这次我杀了三条鱼。"}, {"type": "subtitle", "time": 11793.15, "timestamp": "03:16:33", "text": "很多"}, {"type": "subtitle", "time": 11797.55, "timestamp": "03:16:37", "text": "海藻。我去拿海藻来，我"}, {"type": "subtitle", "time": 11809.67, "timestamp": "03:16:49", "text": "总之，我得做个睡袋。"}, {"type": "subtitle", "time": 11817.469, "timestamp": "03:16:57", "text": "在哪里？"}]
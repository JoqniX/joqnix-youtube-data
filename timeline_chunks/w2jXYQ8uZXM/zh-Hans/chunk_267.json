[{"type": "subtitle", "time": 16025.87, "timestamp": "04:27:05", "text": "[音乐]"}, {"type": "subtitle", "time": 16031.469, "timestamp": "04:27:11", "text": "再次。呃，好的。梯子。在哪里？"}, {"type": "subtitle", "time": 16039.229, "timestamp": "04:27:19", "text": "找到了。我联系上了"}, {"type": "subtitle", "time": 16046.229, "timestamp": "04:27:26", "text": "想要。是的。顺便说一句，我仍然关注着。"}, {"type": "subtitle", "time": 16051.349, "timestamp": "04:27:31", "text": "乔。我当时感觉自己快要死了。"}, {"type": "subtitle", "time": 16054.469, "timestamp": "04:27:34", "text": "不，是在和一些小怪战斗。"}, {"type": "subtitle", "time": 16057.75, "timestamp": "04:27:37", "text": "与一些怪物战斗。的确。"}, {"type": "subtitle", "time": 16068.07, "timestamp": "04:27:48", "text": "无聊的。这是手吗？不。对。是"}, {"type": "subtitle", "time": 16069.75, "timestamp": "04:27:49", "text": "你手下有手吗？我可能你在"}, {"type": "subtitle", "time": 16075.67, "timestamp": "04:27:55", "text": "哦，你不是。哦，但我们离……很近了"}]
[{"type": "subtitle", "time": 20230.788, "timestamp": "05:37:10", "text": "我们有一些"}, {"type": "subtitle", "time": 20233.67, "timestamp": "05:37:13", "text": "我们这里有一些。我需要得到我需要"}, {"type": "subtitle", "time": 20236.07, "timestamp": "05:37:16", "text": "去获取锋利的石斧和"}, {"type": "subtitle", "time": 20238.788, "timestamp": "05:37:18", "text": "一切。"}, {"type": "subtitle", "time": 20242.31, "timestamp": "05:37:22", "text": "金属的那个。如何才能得到它？"}, {"type": "subtitle", "time": 20245.75, "timestamp": "05:37:25", "text": "哦，你身后有一群人。"}, {"type": "subtitle", "time": 20251.43, "timestamp": "05:37:31", "text": "什么？什么？好吧。呃，演示模式。"}, {"type": "subtitle", "time": 20254.628, "timestamp": "05:37:34", "text": "我完全不知道。请坐下好吗？"}, {"type": "subtitle", "time": 20257.11, "timestamp": "05:37:37", "text": "你这个该死的咖啡因成瘾者。你可以吗"}, {"type": "subtitle", "time": 20265.27, "timestamp": "05:37:45", "text": "我只是到处跑跑而已。好的。"}, {"type": "subtitle", "time": 20267.67, "timestamp": "05:37:47", "text": "好的。我想我们的故事就此结束了。"}, {"type": "subtitle", "time": 20274.788, "timestamp": "05:37:54", "text": "我要去吃饭了。呃，我会"}, {"type": "subtitle", "time": 20279.15, "timestamp": "05:37:59", "text": "泡杯茶吧。退出游戏。出口"}]
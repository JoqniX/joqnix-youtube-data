[{"type": "subtitle", "time": 20282.15, "timestamp": "05:38:02", "text": "文本。伙计们，我玩得很开心。"}, {"type": "subtitle", "time": 20284.628, "timestamp": "05:38:04", "text": "谢谢光临。谢谢你的邀请。"}, {"type": "subtitle", "time": 20287.99, "timestamp": "05:38:07", "text": "我。谢谢你让我"}, {"type": "subtitle", "time": 20290.628, "timestamp": "05:38:10", "text": "感谢您的参与。等等，这个游戏"}, {"type": "subtitle", "time": 20292.83, "timestamp": "05:38:12", "text": "非常有趣。"}, {"type": "subtitle", "time": 20295.27, "timestamp": "05:38:15", "text": "是的。等等，你不需要保存"}, {"type": "subtitle", "time": 20297.91, "timestamp": "05:38:17", "text": "我们重新装好弹药。是的。是的。如果你只是"}, {"type": "subtitle", "time": 20301.43, "timestamp": "05:38:21", "text": "离开，这样就能省钱。我的天哪。你好。出口"}, {"type": "subtitle", "time": 20310.708, "timestamp": "05:38:30", "text": "游戏卡住了。我的天啊。"}, {"type": "subtitle", "time": 20313.19, "timestamp": "05:38:33", "text": "我的天啊。它在哪里？别走。"}]
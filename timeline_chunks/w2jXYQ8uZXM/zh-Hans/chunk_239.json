[{"type": "subtitle", "time": 14345.349, "timestamp": "03:59:05", "text": "烹饪？哦，他在帮忙。哦，现在我的"}, {"type": "subtitle", "time": 14372.07, "timestamp": "03:59:32", "text": "该死。你好吗？还好。"}, {"type": "subtitle", "time": 14378.389, "timestamp": "03:59:38", "text": "[音乐]"}, {"type": "subtitle", "time": 14381.03, "timestamp": "03:59:41", "text": "我觉得我们应该去追他，因为他是"}, {"type": "subtitle", "time": 14384.229, "timestamp": "03:59:44", "text": "现在处境艰难。"}]
[{"type": "subtitle", "time": 13022.389, "timestamp": "03:37:02", "text": "看来就是这样。是的。是的。牛虻。"}, {"type": "subtitle", "time": 13024.63, "timestamp": "03:37:04", "text": "牛虻。现在别给他吃垃圾食品。"}, {"type": "subtitle", "time": 13027.349, "timestamp": "03:37:07", "text": "因为我们没有任何杂物。我甚至都不认识"}, {"type": "subtitle", "time": 13029.429, "timestamp": "03:37:09", "text": "什么都有。"}, {"type": "subtitle", "time": 13031.429, "timestamp": "03:37:11", "text": "另外，我得给乔克做这些东西。"}, {"type": "subtitle", "time": 13035.269, "timestamp": "03:37:15", "text": "所以他可以改变。我会成功的。我"}, {"type": "subtitle", "time": 13037.95, "timestamp": "03:37:17", "text": "想学习。哦，我们需要一个古代的"}, {"type": "subtitle", "time": 13043.03, "timestamp": "03:37:23", "text": "fman。该死。是的。"}, {"type": "subtitle", "time": 13045.389, "timestamp": "03:37:25", "text": "我会被烧伤。它是"}, {"type": "subtitle", "time": 13048.15, "timestamp": "03:37:28", "text": "好的。所以，你能让他成为那个吗？"}, {"type": "subtitle", "time": 13051.91, "timestamp": "03:37:31", "text": "盔甲之类的东西？齿轮。我敢肯定。我正在"}, {"type": "subtitle", "time": 13059.67, "timestamp": "03:37:39", "text": "我要花点时间陪你。患病的"}, {"type": "subtitle", "time": 13062.389, "timestamp": "03:37:42", "text": "去做。我们要去冒险。"}, {"type": "subtitle", "time": 13064.63, "timestamp": "03:37:44", "text": "我们打算在这里待多久？"}, {"type": "subtitle", "time": 13067.11, "timestamp": "03:37:47", "text": "收集鹅卵石？你为什么在这里？"}, {"type": "subtitle", "time": 13074.07, "timestamp": "03:37:54", "text": "还有箭。"}, {"type": "subtitle", "time": 13076.87, "timestamp": "03:37:56", "text": "石镐。"}]
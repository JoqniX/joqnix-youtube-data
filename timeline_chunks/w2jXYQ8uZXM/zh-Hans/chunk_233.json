[{"type": "subtitle", "time": 13982.91, "timestamp": "03:53:02", "text": "我又掉线了吗？呃，放下它。"}, {"type": "subtitle", "time": 13986.229, "timestamp": "03:53:06", "text": "是的。我就是喜欢按任意键。"}, {"type": "subtitle", "time": 13988.07, "timestamp": "03:53:08", "text": "您的库存。"}, {"type": "subtitle", "time": 13990.07, "timestamp": "03:53:10", "text": "我能请你给我一个母鸡壳吗？"}, {"type": "subtitle", "time": 13993.75, "timestamp": "03:53:13", "text": "如果你有的话，我可以给你两个。是的，我"}, {"type": "subtitle", "time": 13997.11, "timestamp": "03:53:17", "text": "盾牌上还需要一个。我们"}, {"type": "subtitle", "time": 13998.429, "timestamp": "03:53:18", "text": "里面有吗？"}, {"type": "subtitle", "time": 14000.63, "timestamp": "03:53:20", "text": "篮子？取决于篮子的情况。你可以"}, {"type": "subtitle", "time": 14003.309, "timestamp": "03:53:23", "text": "拿着吧。我们没有"}, {"type": "subtitle", "time": 14005.71, "timestamp": "03:53:25", "text": "甚至"}, {"type": "subtitle", "time": 14013.309, "timestamp": "03:53:33", "text": "哇。这东西摸起来很奇特，但是"}, {"type": "subtitle", "time": 14015.67, "timestamp": "03:53:35", "text": "好的。正确的。"}, {"type": "subtitle", "time": 14020.55, "timestamp": "03:53:40", "text": "你有长矛。我拿到了长矛。"}, {"type": "subtitle", "time": 14025.03, "timestamp": "03:53:45", "text": "我会把东西放进去"}, {"type": "subtitle", "time": 14028.03, "timestamp": "03:53:48", "text": "篮子。"}, {"type": "subtitle", "time": 14032.07, "timestamp": "03:53:52", "text": "是的。不，我不需要工具。还，"}, {"type": "subtitle", "time": 14033.51, "timestamp": "03:53:53", "text": "我弄了些木头，因为我们可能需要用到。"}, {"type": "subtitle", "time": 14034.75, "timestamp": "03:53:54", "text": "建造"}, {"type": "subtitle", "time": 14037.99, "timestamp": "03:53:57", "text": "到达某些地方所需的物品。去。"}, {"type": "subtitle", "time": 14039.91, "timestamp": "03:53:59", "text": "等等，你得先做点《堡垒之夜》的事情。哦"}]
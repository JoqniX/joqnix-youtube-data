[{"type": "subtitle", "time": 21060.75, "timestamp": "05:51:00", "text": "它追上了上游。所以，再说一遍，"}, {"type": "subtitle", "time": 21062.27, "timestamp": "05:51:02", "text": "[音乐]"}, {"type": "subtitle", "time": 21076.23, "timestamp": "05:51:16", "text": "男人。打开辣椒鸡肉罐头。"}, {"type": "subtitle", "time": 21082.59, "timestamp": "05:51:22", "text": "吃。杯面"}, {"type": "subtitle", "time": 21107.59, "timestamp": "05:51:47", "text": "甚至都没到溪边。不是"}]
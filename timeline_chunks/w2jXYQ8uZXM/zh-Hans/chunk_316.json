[{"type": "subtitle", "time": 18961.51, "timestamp": "05:16:01", "text": "一切都过去了。好的，"}, {"type": "subtitle", "time": 18964.15, "timestamp": "05:16:04", "text": "那很好。"}, {"type": "subtitle", "time": 18975.67, "timestamp": "05:16:15", "text": "哦，他们复活了。好吧，我们来对抗它。"}, {"type": "subtitle", "time": 18979.11, "timestamp": "05:16:19", "text": "再次。重生。我们把它们全都弄到手。"}, {"type": "subtitle", "time": 18980.51, "timestamp": "05:16:20", "text": "是的，我"}, {"type": "subtitle", "time": 18984.31, "timestamp": "05:16:24", "text": "把手也丢了。我得到了它。好的，"}, {"type": "subtitle", "time": 18986.23, "timestamp": "05:16:26", "text": "你就上来，然后我就走了"}, {"type": "subtitle", "time": 18988.47, "timestamp": "05:16:28", "text": "轻轻放下。但总得有人来做这件事"}, {"type": "subtitle", "time": 18990.23, "timestamp": "05:16:30", "text": "饵。"}, {"type": "subtitle", "time": 19011.19, "timestamp": "05:16:51", "text": "走另一条路。"}, {"type": "subtitle", "time": 19013.83, "timestamp": "05:16:53", "text": "我遇到了关键问题，现在卡住了。去"}, {"type": "subtitle", "time": 19016.31, "timestamp": "05:16:56", "text": "反过来。那边。好的，我去"}]
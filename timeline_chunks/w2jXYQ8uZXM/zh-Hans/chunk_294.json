[{"type": "subtitle", "time": 17651.91, "timestamp": "04:54:11", "text": "哦，对了，我们这儿有个吸血鬼。"}, {"type": "subtitle", "time": 17656.15, "timestamp": "04:54:16", "text": "吸血鬼。哦，对了，幽灵目标"}, {"type": "subtitle", "time": 17659.27, "timestamp": "04:54:19", "text": "骨棒。斗牛犬床。基本舒适"}, {"type": "subtitle", "time": 17661.31, "timestamp": "04:54:21", "text": "放"}, {"type": "subtitle", "time": 17671.67, "timestamp": "04:54:31", "text": "哪里有鱼，哪里就有鱼。所以请耐心等待"}, {"type": "subtitle", "time": 17674.39, "timestamp": "04:54:34", "text": "他们提供的演示内容非常丰富。就像所有……"}, {"type": "subtitle", "time": 17676.788, "timestamp": "04:54:36", "text": "这些仅供演示。"}, {"type": "subtitle", "time": 17678.83, "timestamp": "04:54:38", "text": "是的。"}, {"type": "subtitle", "time": 17681.91, "timestamp": "04:54:41", "text": "我的天，这太疯狂了。你甚至还没……"}, {"type": "subtitle", "time": 17690.65, "timestamp": "04:54:50", "text": "此外，还有一份不同的个人简介。"}, {"type": "subtitle", "time": 17698.55, "timestamp": "04:54:58", "text": "这游戏还不错。"}]
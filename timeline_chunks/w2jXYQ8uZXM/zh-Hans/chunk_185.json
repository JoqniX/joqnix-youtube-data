[{"type": "subtitle", "time": 11107.95, "timestamp": "03:05:07", "text": "石头。制作"}, {"type": "subtitle", "time": 11110.469, "timestamp": "03:05:10", "text": "石头。呃，我们需要做什么来制作一个"}, {"type": "subtitle", "time": 11113.349, "timestamp": "03:05:13", "text": "精神锚？"}, {"type": "subtitle", "time": 11115.429, "timestamp": "03:05:15", "text": "哦，它就像一个重生信标。你呢"}, {"type": "subtitle", "time": 11117.91, "timestamp": "03:05:17", "text": "还记得那种鸡蛋之类的东西吗？那是"}, {"type": "subtitle", "time": 11120.71, "timestamp": "03:05:20", "text": "你在哪儿？是的。"}, {"type": "subtitle", "time": 11124.19, "timestamp": "03:05:24", "text": "此外，我们也需要那些。你我我只是"}, {"type": "subtitle", "time": 11127.269, "timestamp": "03:05:27", "text": "他们说我们可以得到像魔法一样的东西。我们"}, {"type": "subtitle", "time": 11130.71, "timestamp": "03:05:30", "text": "不过我还没收到。哦，我"}, {"type": "subtitle", "time": 11135.03, "timestamp": "03:05:35", "text": "看。是的。魔法之类的东西。是吗？"}, {"type": "subtitle", "time": 11141.429, "timestamp": "03:05:41", "text": "天黑了吗？这就像，是吗？"}, {"type": "subtitle", "time": 11143.83, "timestamp": "03:05:43", "text": "今晚对你来说怎么样？"}, {"type": "subtitle", "time": 11146.63, "timestamp": "03:05:46", "text": "哦，你那里已经是晚上了。就像，是啊，"}, {"type": "subtitle", "time": 11150.71, "timestamp": "03:05:50", "text": "对我来说现在是白天。天哪，真不错。"}, {"type": "subtitle", "time": 11152.15, "timestamp": "03:05:52", "text": "可能是光线问题。是的，"}, {"type": "subtitle", "time": 11153.99, "timestamp": "03:05:53", "text": "云。"}, {"type": "subtitle", "time": 11156.63, "timestamp": "03:05:56", "text": "哦，是的。大概。开始了。患病的"}, {"type": "subtitle", "time": 11158.87, "timestamp": "03:05:58", "text": "做一些"}]
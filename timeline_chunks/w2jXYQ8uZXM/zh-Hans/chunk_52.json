[{"type": "subtitle", "time": 3157.47, "timestamp": "00:52:37", "text": "天哪，我跟妈妈说话就像……"}, {"type": "subtitle", "time": 3160.549, "timestamp": "00:52:40", "text": "电子商务。我不知道为什么。我不知道"}, {"type": "subtitle", "time": 3162.15, "timestamp": "00:52:42", "text": "为什么。就像每当我跟我说话的时候"}, {"type": "subtitle", "time": 3165.51, "timestamp": "00:52:45", "text": "家人，我的声音听起来很奇怪，像个男人。"}, {"type": "subtitle", "time": 3167.67, "timestamp": "00:52:47", "text": "某种粗鲁的东西"}, {"type": "subtitle", "time": 3169.95, "timestamp": "00:52:49", "text": "语气之类的。我不知道为什么，"}, {"type": "subtitle", "time": 3171.95, "timestamp": "00:52:51", "text": "但是兄弟，"}, {"type": "subtitle", "time": 3174.79, "timestamp": "00:52:54", "text": "为什么？但当我直播的时候，我就是"}, {"type": "subtitle", "time": 3177.829, "timestamp": "00:52:57", "text": "像个软弱的小孩或孩子"}]
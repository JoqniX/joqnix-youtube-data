[{"type": "subtitle", "time": 12840.07, "timestamp": "03:34:00", "text": "你养鸟吗？我的天啊。是的，我会"}, {"type": "subtitle", "time": 12843.59, "timestamp": "03:34:03", "text": "也给你一个。快点。"}, {"type": "subtitle", "time": 12846.309, "timestamp": "03:34:06", "text": "获得知识点。我的天啊。看"}, {"type": "subtitle", "time": 12849.469, "timestamp": "03:34:09", "text": "在 Arasu。这样一位建筑师"}, {"type": "subtitle", "time": 12852.95, "timestamp": "03:34:12", "text": "人。哦，看看他。那么，什么是……"}, {"type": "subtitle", "time": 12854.32, "timestamp": "03:34:14", "text": "游戏内容是什么？"}, {"type": "subtitle", "time": 12856.309, "timestamp": "03:34:16", "text": "[音乐]"}, {"type": "subtitle", "time": 12859.269, "timestamp": "03:34:19", "text": "我只是在收集做手工的材料。"}, {"type": "subtitle", "time": 12861.349, "timestamp": "03:34:21", "text": "哦，别担心。我们有很多东西。"}, {"type": "subtitle", "time": 12864.51, "timestamp": "03:34:24", "text": "你可以的，没关系。快点。来"}, {"type": "subtitle", "time": 12867.429, "timestamp": "03:34:27", "text": "这里。欣赏美景。现在是"}, {"type": "subtitle", "time": 12870.229, "timestamp": "03:34:30", "text": "就像生存一样。如果你按下M键，"}, {"type": "subtitle", "time": 12871.83, "timestamp": "03:34:31", "text": "你可以看到那些问号。你"}, {"type": "subtitle", "time": 12873.75, "timestamp": "03:34:33", "text": "看到地图上像问号一样的标记了吗？"}, {"type": "subtitle", "time": 12875.429, "timestamp": "03:34:35", "text": "是的，"}, {"type": "subtitle", "time": 12877.269, "timestamp": "03:34:37", "text": "我们需要得到那些东西。而且还有"}, {"type": "subtitle", "time": 12880.71, "timestamp": "03:34:40", "text": "还有像小boss一样需要我们击杀"}, {"type": "subtitle", "time": 12883.91, "timestamp": "03:34:43", "text": "制造某些东西。"}, {"type": "subtitle", "time": 12885.67, "timestamp": "03:34:45", "text": "好，过来一下。哦，该死的。"}, {"type": "subtitle", "time": 12893.99, "timestamp": "03:34:53", "text": "哦，小树枝。好的。"}, {"type": "subtitle", "time": 12895.67, "timestamp": "03:34:55", "text": "哦，是的。如果你愿意的话，也请完成你的任务。"}, {"type": "subtitle", "time": 12897.99, "timestamp": "03:34:57", "text": "看看他们。是的，执行你的任务。好的，"}]
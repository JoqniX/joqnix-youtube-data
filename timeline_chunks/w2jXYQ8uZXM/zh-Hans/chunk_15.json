[{"type": "subtitle", "time": 900.67, "timestamp": "00:15:00", "text": "正确的？等等，我是直播状态，对吧？"}, {"type": "subtitle", "time": 902.79, "timestamp": "00:15:02", "text": "比利，他们是不是因为这个原因封禁我了？"}, {"type": "subtitle", "time": 904.829, "timestamp": "00:15:04", "text": "显示"}, {"type": "subtitle", "time": 908.629, "timestamp": "00:15:08", "text": "叽叽喳喳？好的，我还在那里。哦，我是"}, {"type": "subtitle", "time": 911.43, "timestamp": "00:15:11", "text": "还在那里。"}, {"type": "subtitle", "time": 917.35, "timestamp": "00:15:17", "text": "惩罚。是的。是的。是的。他们"}, {"type": "subtitle", "time": 919.91, "timestamp": "00:15:19", "text": "别让外国人让你露面"}, {"type": "subtitle", "time": 921.67, "timestamp": "00:15:21", "text": "外国方面。他们把……"}, {"type": "subtitle", "time": 925.629, "timestamp": "00:15:25", "text": "溪流。我五六年也遇到过这种情况。"}, {"type": "subtitle", "time": 929.75, "timestamp": "00:15:29", "text": "次数。警告。好的。威利威利"}, {"type": "subtitle", "time": 932.949, "timestamp": "00:15:32", "text": "警告了我五分钟。呃，那就这样吧"}, {"type": "subtitle", "time": 945.9, "timestamp": "00:15:45", "text": "真糟糕。想法"}]
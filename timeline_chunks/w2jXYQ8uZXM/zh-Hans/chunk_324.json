[{"type": "subtitle", "time": 19441.91, "timestamp": "05:24:01", "text": "我要去弄到那些古代碎片。你可以"}, {"type": "subtitle", "time": 19449.67, "timestamp": "05:24:09", "text": "嗯，是的，我们需要再做一个。"}, {"type": "subtitle", "time": 19453.628, "timestamp": "05:24:13", "text": "就像一个不同的灯塔"}, {"type": "subtitle", "time": 19456.788, "timestamp": "05:24:16", "text": "当我们去岛上的古老休息处时，或者"}, {"type": "subtitle", "time": 19459.35, "timestamp": "05:24:19", "text": "你看到最远的更像是在"}, {"type": "subtitle", "time": 19461.91, "timestamp": "05:24:21", "text": "废墟前面？问号。"}, {"type": "subtitle", "time": 19465.03, "timestamp": "05:24:25", "text": "什么？这就是我们需要点赞的地方。所以"}, {"type": "subtitle", "time": 19469.51, "timestamp": "05:24:29", "text": "这个东西怎么用？"}, {"type": "subtitle", "time": 19474.708, "timestamp": "05:24:34", "text": "我需要获取构造核心。"}]
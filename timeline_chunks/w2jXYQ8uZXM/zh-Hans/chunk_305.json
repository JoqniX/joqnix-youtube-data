[{"type": "subtitle", "time": 18302.31, "timestamp": "05:05:02", "text": "是的，它在箱子里。谢谢。拿"}, {"type": "subtitle", "time": 18305.67, "timestamp": "05:05:05", "text": "从这个箱子里拿出来。玛娜，哦"}, {"type": "subtitle", "time": 18308.15, "timestamp": "05:05:08", "text": "我的天，他有很多魔力。"}, {"type": "subtitle", "time": 18310.868, "timestamp": "05:05:10", "text": "我投入了大量的法力。"}, {"type": "subtitle", "time": 18312.35, "timestamp": "05:05:12", "text": "操"}, {"type": "subtitle", "time": 18314.51, "timestamp": "05:05:14", "text": "地狱。这里我们"}, {"type": "subtitle", "time": 18318.03, "timestamp": "05:05:18", "text": "去。呃，这里有一个"}, {"type": "subtitle", "time": 18321.35, "timestamp": "05:05:21", "text": "喘气。这里有个胸甲。"}, {"type": "subtitle", "time": 18324.948, "timestamp": "05:05:24", "text": "好的，我走了。再见。"}, {"type": "subtitle", "time": 18329.19, "timestamp": "05:05:29", "text": "我能独自一人顺利航行吗？是的。"}, {"type": "subtitle", "time": 18331.03, "timestamp": "05:05:31", "text": "好的，你回来就好。我们来了"}, {"type": "subtitle", "time": 18334.23, "timestamp": "05:05:34", "text": "后退。我是一名游戏玩家。我是一名游戏玩家。不"}, {"type": "subtitle", "time": 18337.11, "timestamp": "05:05:37", "text": "低估游戏的力量。能"}, {"type": "subtitle", "time": 18339.83, "timestamp": "05:05:39", "text": "你能给我一些酒吗？"}, {"type": "subtitle", "time": 18341.948, "timestamp": "05:05:41", "text": "草。"}, {"type": "subtitle", "time": 18350.47, "timestamp": "05:05:50", "text": "应该涂点胸油，或者好吧，我"}, {"type": "subtitle", "time": 18353.67, "timestamp": "05:05:53", "text": "我想我给了你99。我们用完了。"}, {"type": "subtitle", "time": 18355.75, "timestamp": "05:05:55", "text": "他们。"}, {"type": "subtitle", "time": 18357.67, "timestamp": "05:05:57", "text": "是的，我还需要一点。我需要像一个"}]
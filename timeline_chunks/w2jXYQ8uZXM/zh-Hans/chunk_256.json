[{"type": "subtitle", "time": 15366.51, "timestamp": "04:16:06", "text": "好的，"}, {"type": "subtitle", "time": 15369.389, "timestamp": "04:16:09", "text": "患病的"}, {"type": "subtitle", "time": 15384.149, "timestamp": "04:16:24", "text": "你可以使用你的箭。他快要死了。"}, {"type": "subtitle", "time": 15387.03, "timestamp": "04:16:27", "text": "他快要死了。帮帮他。我能看到"}, {"type": "subtitle", "time": 15389.87, "timestamp": "04:16:29", "text": "它。在最上面。在"}, {"type": "subtitle", "time": 15397.51, "timestamp": "04:16:37", "text": "哦，也在这里。"}, {"type": "subtitle", "time": 15400.389, "timestamp": "04:16:40", "text": "是的，我刚到。"}, {"type": "subtitle", "time": 15403.59, "timestamp": "04:16:43", "text": "用你的箭啊，伙计。我们得到了"}, {"type": "subtitle", "time": 15405.469, "timestamp": "04:16:45", "text": "他。我做了"}, {"type": "subtitle", "time": 15408.95, "timestamp": "04:16:48", "text": "它。我们成功了。我们走吧。"}, {"type": "subtitle", "time": 15411.11, "timestamp": "04:16:51", "text": "他那该死的酵母眨了一下眼。他说，我"}, {"type": "subtitle", "time": 15412.67, "timestamp": "04:16:52", "text": "做到了。"}]
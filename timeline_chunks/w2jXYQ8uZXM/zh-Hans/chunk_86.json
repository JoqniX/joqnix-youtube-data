[{"type": "subtitle", "time": 5160.55, "timestamp": "01:26:00", "text": "我即将进入大学，同时还要吸毒。"}, {"type": "subtitle", "time": 5163.43, "timestamp": "01:26:03", "text": "考试。我也是。还有一个月。哦，好"}, {"type": "subtitle", "time": 5166.03, "timestamp": "01:26:06", "text": "运气。好的"}, {"type": "subtitle", "time": 5181.75, "timestamp": "01:26:21", "text": "运气。哦，是的。忍者问的，对吧？如何"}, {"type": "subtitle", "time": 5183.91, "timestamp": "01:26:23", "text": "我说话的方式像和下士说话吗？"}, {"type": "subtitle", "time": 5186.55, "timestamp": "01:26:26", "text": "东西？我不。我只是正常说话。"}, {"type": "subtitle", "time": 5189.07, "timestamp": "01:26:29", "text": "现在。实际上，我说话"}, {"type": "subtitle", "time": 5191.669, "timestamp": "01:26:31", "text": "通常情况下。我只是说说而已。"}, {"type": "subtitle", "time": 5208.79, "timestamp": "01:26:48", "text": "通常会问我一些疑问之类的，因为"}, {"type": "subtitle", "time": 5211.91, "timestamp": "01:26:51", "text": "我不了解公司层面的情况。甚至"}, {"type": "subtitle", "time": 5219.43, "timestamp": "01:26:59", "text": "即使我是一名内容创作者，"}]
[{"type": "subtitle", "time": 10861.63, "timestamp": "03:01:01", "text": "直升机。就像直升机一样"}, {"type": "subtitle", "time": 10874.309, "timestamp": "03:01:14", "text": "好的，我们下一个就到了。我们需要更多"}, {"type": "subtitle", "time": 10877.349, "timestamp": "03:01:17", "text": "石头。我觉得你可以。你做过一个吗？"}, {"type": "subtitle", "time": 10879.75, "timestamp": "03:01:19", "text": "为自己？"}, {"type": "subtitle", "time": 10882.389, "timestamp": "03:01:22", "text": "不，现在不行。我正抓着它"}, {"type": "subtitle", "time": 10885.19, "timestamp": "03:01:25", "text": "我们将来可能需要的东西，例如"}, {"type": "subtitle", "time": 10887.269, "timestamp": "03:01:27", "text": "棍子。我打算去弄些木头。"}, {"type": "subtitle", "time": 10889.55, "timestamp": "03:01:29", "text": "然后。"}, {"type": "subtitle", "time": 10892.63, "timestamp": "03:01:32", "text": "好吧，我要自己动手。"}, {"type": "subtitle", "time": 10895.19, "timestamp": "03:01:35", "text": "让我拿一些拉娜和"}, {"type": "subtitle", "time": 10902.59, "timestamp": "03:01:42", "text": "俱乐部。"}, {"type": "subtitle", "time": 10911.349, "timestamp": "03:01:51", "text": "哦耶，耶，耶，耶。事物"}, {"type": "subtitle", "time": 10912.87, "timestamp": "03:01:52", "text": "游戏中会发生这样的事。别担心"}, {"type": "subtitle", "time": 10915.79, "timestamp": "03:01:55", "text": "它。我的意思是，这只是个演示。"}, {"type": "subtitle", "time": 10919.99, "timestamp": "03:01:59", "text": "是的，正在开发中。"}]
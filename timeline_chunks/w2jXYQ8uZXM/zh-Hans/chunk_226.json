[{"type": "subtitle", "time": 13562.309, "timestamp": "03:46:02", "text": "这里。建造，过来。过来。啊，"}, {"type": "subtitle", "time": 13564.389, "timestamp": "03:46:04", "text": "知道了。知道了。知道了。知道了。知道了。"}, {"type": "subtitle", "time": 13566.389, "timestamp": "03:46:06", "text": "知道了。知道了。知道了。知道了。里面。"}, {"type": "subtitle", "time": 13568.71, "timestamp": "03:46:08", "text": "你需要进去。"}, {"type": "subtitle", "time": 13569.71, "timestamp": "03:46:09", "text": "那是"}, {"type": "subtitle", "time": 13572.51, "timestamp": "03:46:12", "text": "火。要求"}, {"type": "subtitle", "time": 13575.59, "timestamp": "03:46:15", "text": "一场火灾。你成功了。你可以睡着"}, {"type": "subtitle", "time": 13577.269, "timestamp": "03:46:17", "text": "这个。不要再做了。哦，我的"}, {"type": "subtitle", "time": 13581.189, "timestamp": "03:46:21", "text": "真他妈的。他铺了两张床。"}, {"type": "subtitle", "time": 13583.59, "timestamp": "03:46:23", "text": "我会把那条删掉。实际上，并非如此。不，"}, {"type": "subtitle", "time": 13584.95, "timestamp": "03:46:24", "text": "你可以删除我的。您可以删除"}, {"type": "subtitle", "time": 13587.75, "timestamp": "03:46:27", "text": "其实是我的。是的，我已经这么做了。"}, {"type": "subtitle", "time": 13591.11, "timestamp": "03:46:31", "text": "那。删掉我的。删除那个。是的。"}, {"type": "subtitle", "time": 13593.189, "timestamp": "03:46:33", "text": "对，删掉我重新做的那个。"}, {"type": "subtitle", "time": 13596.63, "timestamp": "03:46:36", "text": "这里。哦，是的。谢谢。你……"}, {"type": "subtitle", "time": 13597.83, "timestamp": "03:46:37", "text": "删除另一个？好的。是的，你是"}, {"type": "subtitle", "time": 13599.83, "timestamp": "03:46:39", "text": "死的。好了，我们睡觉吧。只是"}, {"type": "subtitle", "time": 13601.79, "timestamp": "03:46:41", "text": "睡觉。不用，直接按B键就行了。"}, {"type": "subtitle", "time": 13605.349, "timestamp": "03:46:45", "text": "再次。我们睡觉吧。好的，谢谢。"}, {"type": "subtitle", "time": 13608.79, "timestamp": "03:46:48", "text": "是的。好了，我们都醒了，对吧？不。"}, {"type": "subtitle", "time": 13611.189, "timestamp": "03:46:51", "text": "不，不，你还没按E键呢。"}, {"type": "subtitle", "time": 13613.91, "timestamp": "03:46:53", "text": "母亲。"}, {"type": "subtitle", "time": 13618.63, "timestamp": "03:46:58", "text": "我获得了经验值。我当时就想，好吧。"}]
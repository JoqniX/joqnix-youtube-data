[{"type": "subtitle", "time": 16920.788, "timestamp": "04:42:00", "text": "大概是三次吧。哦，等等。它"}, {"type": "subtitle", "time": 16923.83, "timestamp": "04:42:03", "text": "不在这里。 “跟我来”在哪里？"}, {"type": "subtitle", "time": 16927.03, "timestamp": "04:42:07", "text": "跟我来。好的。稍等片刻。"}, {"type": "subtitle", "time": 16929.43, "timestamp": "04:42:09", "text": "这东西太危险了。让我来建造"}, {"type": "subtitle", "time": 16932.39, "timestamp": "04:42:12", "text": "实际上，它是一个平台。"}, {"type": "subtitle", "time": 16934.39, "timestamp": "04:42:14", "text": "我觉得我看到你的东西就像向下看一样"}, {"type": "subtitle", "time": 16937.19, "timestamp": "04:42:17", "text": "那里。"}, {"type": "subtitle", "time": 16938.628, "timestamp": "04:42:18", "text": "哦，是的。是的，你的东西都在那里。"}, {"type": "subtitle", "time": 16942.39, "timestamp": "04:42:22", "text": "那里。就在这里。就在这里。好的。"}, {"type": "subtitle", "time": 16945.99, "timestamp": "04:42:25", "text": "正在路上。你能用木头建造吗？"}, {"type": "subtitle", "time": 16948.31, "timestamp": "04:42:28", "text": "我搭建的那两个 pl 的小平台？"}, {"type": "subtitle", "time": 16950.15, "timestamp": "04:42:30", "text": "好的。你必须像……一样建造"}, {"type": "subtitle", "time": 16952.39, "timestamp": "04:42:32", "text": "平台在这里。顺便说一句，我确实"}, {"type": "subtitle", "time": 16954.47, "timestamp": "04:42:34", "text": "不是。就像在褶皱下面一样。"}, {"type": "subtitle", "time": 16957.15, "timestamp": "04:42:37", "text": "折痕下方。我觉得我"}, {"type": "subtitle", "time": 16967.27, "timestamp": "04:42:47", "text": "木头。好的。我应该怎么办？在哪里？"}, {"type": "subtitle", "time": 16970.708, "timestamp": "04:42:50", "text": "它？过来。跟我来。首先"}]
[{"type": "subtitle", "time": 10802.389, "timestamp": "03:00:02", "text": "等等，我们没有食谱。我该怎么做？"}, {"type": "subtitle", "time": 10804.79, "timestamp": "03:00:04", "text": "有食谱吗？我们需要解锁它们。"}, {"type": "subtitle", "time": 10806.309, "timestamp": "03:00:06", "text": "是的，根据你的……哦，是的，我们确实"}, {"type": "subtitle", "time": 10811.03, "timestamp": "03:00:11", "text": "解锁它们。如您所见，请按 K 键。"}, {"type": "subtitle", "time": 10812.59, "timestamp": "03:00:12", "text": "是的，"}, {"type": "subtitle", "time": 10815.83, "timestamp": "03:00:15", "text": "武器解锁后，获得了石斧。"}, {"type": "subtitle", "time": 10818.469, "timestamp": "03:00:18", "text": "我们也需要那些票。呃，就"}, {"type": "subtitle", "time": 10820.309, "timestamp": "03:00:20", "text": "解锁所有内容。只需解锁"}, {"type": "subtitle", "time": 10824.15, "timestamp": "03:00:24", "text": "一切。哦，是的。哦，是的。"}, {"type": "subtitle", "time": 10827.349, "timestamp": "03:00:27", "text": "反正我们什么都需要。建造。按"}, {"type": "subtitle", "time": 10829.19, "timestamp": "03:00:29", "text": "B. 我要做一个工作台。你"}, {"type": "subtitle", "time": 10832.07, "timestamp": "03:00:32", "text": "还需要制作工作台吗？"}, {"type": "subtitle", "time": 10851.51, "timestamp": "03:00:51", "text": "我做了一个工作台。你可以做一些"}, {"type": "subtitle", "time": 10853.75, "timestamp": "03:00:53", "text": "现在的东西。"}, {"type": "subtitle", "time": 10857.95, "timestamp": "03:00:57", "text": "我要制作一块石头"}]
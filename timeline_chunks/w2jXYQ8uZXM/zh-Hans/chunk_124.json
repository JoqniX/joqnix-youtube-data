[{"type": "subtitle", "time": 7440.07, "timestamp": "02:04:00", "text": "溪流。我让Beamstream呃呃呃点赞"}, {"type": "subtitle", "time": 7442.07, "timestamp": "02:04:02", "text": "来自 Beamstream 的人员整合"}, {"type": "subtitle", "time": 7445.629, "timestamp": "02:04:05", "text": "这。他们对此感到担忧。"}, {"type": "subtitle", "time": 7449.43, "timestamp": "02:04:09", "text": "因为他们遇到了一些问题……"}, {"type": "subtitle", "time": 7452.79, "timestamp": "02:04:12", "text": "抖音，因为如果他们在，因为他们是"}, {"type": "subtitle", "time": 7455.109, "timestamp": "02:04:15", "text": "像一家正规公司，而不是美国公司"}, {"type": "subtitle", "time": 7457.99, "timestamp": "02:04:17", "text": "总部位于美国的 Beamstream 公司"}, {"type": "subtitle", "time": 7461.27, "timestamp": "02:04:21", "text": "比如如果他们把一些东西整合到 Tik 里"}, {"type": "subtitle", "time": 7463.589, "timestamp": "02:04:23", "text": "如果美国政府这么说的话，Tok 之类的东西"}, {"type": "subtitle", "time": 7465.669, "timestamp": "02:04:25", "text": "TikTok在美国被禁"}, {"type": "subtitle", "time": 7470.95, "timestamp": "02:04:30", "text": "整合这个，所以如果TikTok获得"}, {"type": "subtitle", "time": 7474.95, "timestamp": "02:04:34", "text": "在美国被禁，还有他们会……"}, {"type": "subtitle", "time": 7477.83, "timestamp": "02:04:37", "text": "必须移除对抖音的支持"}, {"type": "subtitle", "time": 7480.47, "timestamp": "02:04:40", "text": "以及所有的一切。不，呃，即使他们"}, {"type": "subtitle", "time": 7484.47, "timestamp": "02:04:44", "text": "他们不想这么做，但他们不得不这么做，因为呃"}, {"type": "subtitle", "time": 7487.109, "timestamp": "02:04:47", "text": "公司和所有东西都低廉"}, {"type": "subtitle", "time": 7488.87, "timestamp": "02:04:48", "text": "所有东西都快用完了。"}, {"type": "subtitle", "time": 7492.629, "timestamp": "02:04:52", "text": "对，就是这样。"}, {"type": "subtitle", "time": 7495.83, "timestamp": "02:04:55", "text": "呃，他们问的就是我回答的那个问题。"}, {"type": "subtitle", "time": 7497.709, "timestamp": "02:04:57", "text": "特征"}]
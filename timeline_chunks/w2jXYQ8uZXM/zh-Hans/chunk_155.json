[{"type": "subtitle", "time": 9301.19, "timestamp": "02:35:01", "text": "叽叽喳喳。最近我看到了包巴的面纱"}, {"type": "subtitle", "time": 9305.11, "timestamp": "02:35:05", "text": "大号。她彻底离开了Twa。她"}, {"type": "subtitle", "time": 9307.469, "timestamp": "02:35:07", "text": "展开一个"}, {"type": "subtitle", "time": 9310.55, "timestamp": "02:35:10", "text": "东西。但问题是，我也想"}, {"type": "subtitle", "time": 9314.15, "timestamp": "02:35:14", "text": "照做。我想重点谈谈开头。"}, {"type": "subtitle", "time": 9316.95, "timestamp": "02:35:16", "text": "专注于自己和所有事情"}, {"type": "subtitle", "time": 9319.51, "timestamp": "02:35:19", "text": "还有，别再……你知道的，太……了"}, {"type": "subtitle", "time": 9322.71, "timestamp": "02:35:22", "text": "活跃度：我不太活跃。好的。我"}, {"type": "subtitle", "time": 9325.91, "timestamp": "02:35:25", "text": "我不太常发推特，但我一直都在。"}, {"type": "subtitle", "time": 9327.55, "timestamp": "02:35:27", "text": "那里。我只是"}, {"type": "subtitle", "time": 9335.79, "timestamp": "02:35:35", "text": "[音乐]"}, {"type": "subtitle", "time": 9338.75, "timestamp": "02:35:38", "text": "那。所以"}, {"type": "subtitle", "time": 9345.23, "timestamp": "02:35:45", "text": "呃，你可能已经有了"}, {"type": "subtitle", "time": 9348.19, "timestamp": "02:35:48", "text": "听说过怪物吗？好了，就是这样。"}, {"type": "subtitle", "time": 9353.71, "timestamp": "02:35:53", "text": "去。呃的最后一串"}, {"type": "subtitle", "time": 9356.309, "timestamp": "02:35:56", "text": "拆箱。解压的最后一段。让我"}, {"type": "subtitle", "time": 9359.67, "timestamp": "02:35:59", "text": "呃，请关闭我的背景音乐。我们开始吧"}]
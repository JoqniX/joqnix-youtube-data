[{"type": "subtitle", "time": 10922.309, "timestamp": "03:02:02", "text": "是的，有些怪物就像两个"}, {"type": "subtitle", "time": 10924.63, "timestamp": "03:02:04", "text": "帧。他们会像两个一样攻击你"}, {"type": "subtitle", "time": 10941.51, "timestamp": "03:02:21", "text": "我正在努力获取我们需要获取的东西"}, {"type": "subtitle", "time": 10944.71, "timestamp": "03:02:24", "text": "它叫什么名字？长矛。"}, {"type": "subtitle", "time": 10956.55, "timestamp": "03:02:36", "text": "与《我的世界》不同，我认为这是……"}, {"type": "subtitle", "time": 10959.309, "timestamp": "03:02:39", "text": "渐进式游戏。是的。"}, {"type": "subtitle", "time": 10962.469, "timestamp": "03:02:42", "text": "是的。它还带有一点故事性，你"}, {"type": "subtitle", "time": 10965.03, "timestamp": "03:02:45", "text": "要知道，如果你读了文本，"}, {"type": "subtitle", "time": 10967.59, "timestamp": "03:02:47", "text": "东西。它有点故事性，"}, {"type": "subtitle", "time": 10970.389, "timestamp": "03:02:50", "text": "这是一个好故事。"}]
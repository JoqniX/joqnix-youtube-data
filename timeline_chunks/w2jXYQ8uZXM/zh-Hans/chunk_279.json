[{"type": "subtitle", "time": 16749.51, "timestamp": "04:39:09", "text": "他在说什么？"}, {"type": "subtitle", "time": 16757.269, "timestamp": "04:39:17", "text": "我只是确认一下。"}, {"type": "subtitle", "time": 16759.869, "timestamp": "04:39:19", "text": "你们在说话吗？不，"}, {"type": "subtitle", "time": 16763.59, "timestamp": "04:39:23", "text": "检查。我的天啊。"}, {"type": "subtitle", "time": 16765.59, "timestamp": "04:39:25", "text": "该死的慢跑。我从未知道你是谁。"}, {"type": "subtitle", "time": 16767.75, "timestamp": "04:39:27", "text": "就像那样。"}, {"type": "subtitle", "time": 16771.07, "timestamp": "04:39:31", "text": "我的天啊。这"}, {"type": "subtitle", "time": 16774.07, "timestamp": "04:39:34", "text": "所以我想说，看看你。你是"}, {"type": "subtitle", "time": 16778.83, "timestamp": "04:39:38", "text": "谈论开玩笑。我这么说。"}, {"type": "subtitle", "time": 16782.47, "timestamp": "04:39:42", "text": "我被雷声席卷了。"}, {"type": "subtitle", "time": 16792.07, "timestamp": "04:39:52", "text": "嗯，等等。这里有个魔法值之类的东西"}, {"type": "subtitle", "time": 16799.11, "timestamp": "04:39:59", "text": "它是紫色的吗？是吗？它是蓝色的。如何"}]
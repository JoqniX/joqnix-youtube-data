[{"type": "subtitle", "time": 19089.43, "timestamp": "05:18:09", "text": "我也尝试过登录。我只是他"}, {"type": "subtitle", "time": 19092.708, "timestamp": "05:18:12", "text": "我应该来这里的。什么？不，我不是。"}, {"type": "subtitle", "time": 19096.31, "timestamp": "05:18:16", "text": "去那里游泳。是的。"}, {"type": "subtitle", "time": 19108.788, "timestamp": "05:18:28", "text": "为什么攀岩很难？"}, {"type": "subtitle", "time": 19109.868, "timestamp": "05:18:29", "text": "哦，我的"}, {"type": "subtitle", "time": 19121.31, "timestamp": "05:18:41", "text": "好的，我们再往下走一步。得到他"}, {"type": "subtitle", "time": 19124.47, "timestamp": "05:18:44", "text": "项目。等等，远古之灵在哪里？"}, {"type": "subtitle", "time": 19127.35, "timestamp": "05:18:47", "text": "碎片？我没看到这一点。"}, {"type": "subtitle", "time": 19128.628, "timestamp": "05:18:48", "text": "你无法从……获得远古之魂碎片"}, {"type": "subtitle", "time": 19131.43, "timestamp": "05:18:51", "text": "它。但我买到了一个。上面写着一。哦，不。"}, {"type": "subtitle", "time": 19132.948, "timestamp": "05:18:52", "text": "我有。我有。我有。你"}, {"type": "subtitle", "time": 19135.59, "timestamp": "05:18:55", "text": "我身上有使命感。它在我的"}, {"type": "subtitle", "time": 19137.27, "timestamp": "05:18:57", "text": "身体。"}]
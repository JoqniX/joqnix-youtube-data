[{"type": "subtitle", "time": 12780.15, "timestamp": "03:33:00", "text": "去见他。他为什么在那边？他进来了"}, {"type": "subtitle", "time": 12783.11, "timestamp": "03:33:03", "text": "教程区。"}, {"type": "subtitle", "time": 12784.84, "timestamp": "03:33:04", "text": "哦，那"}, {"type": "subtitle", "time": 12787.309, "timestamp": "03:33:07", "text": "[音乐]"}, {"type": "subtitle", "time": 12789.59, "timestamp": "03:33:09", "text": "浆果。是的，去弄点蘑菇吧。"}, {"type": "subtitle", "time": 12791.59, "timestamp": "03:33:11", "text": "对了，你什么时候过来。我们"}, {"type": "subtitle", "time": 12809.99, "timestamp": "03:33:29", "text": "暴民。让我们欢迎他。站在"}, {"type": "subtitle", "time": 12810.91, "timestamp": "03:33:30", "text": "前面"}, {"type": "subtitle", "time": 12815.71, "timestamp": "03:33:35", "text": "出口。哦，"}, {"type": "subtitle", "time": 12824.15, "timestamp": "03:33:44", "text": "蘑菇。你走的路是对的。"}, {"type": "subtitle", "time": 12826.469, "timestamp": "03:33:46", "text": "你走的路是对的。我看见你。"}, {"type": "subtitle", "time": 12830.55, "timestamp": "03:33:50", "text": "是的，我看到你的名字了。"}, {"type": "subtitle", "time": 12832.229, "timestamp": "03:33:52", "text": "让我们欢迎他。是的，你快到了。"}, {"type": "subtitle", "time": 12833.75, "timestamp": "03:33:53", "text": "那里。"}, {"type": "subtitle", "time": 12836.79, "timestamp": "03:33:56", "text": "我的天啊。你好。你养鹦鹉吗？"}]
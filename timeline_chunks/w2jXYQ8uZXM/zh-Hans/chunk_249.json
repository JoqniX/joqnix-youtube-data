[{"type": "subtitle", "time": 14942.469, "timestamp": "04:09:02", "text": "我们从山上来的地方。是的，"}, {"type": "subtitle", "time": 14943.71, "timestamp": "04:09:03", "text": "就来"}, {"type": "subtitle", "time": 14948.71, "timestamp": "04:09:08", "text": "那里。这家伙，真是的。我向上帝发誓。"}, {"type": "subtitle", "time": 14950.63, "timestamp": "04:09:10", "text": "顺便说一下，如果你换挡并跳跃"}, {"type": "subtitle", "time": 14953.11, "timestamp": "04:09:13", "text": "与此同时，该频道却没有"}, {"type": "subtitle", "time": 14956.07, "timestamp": "04:09:16", "text": "降到那个水平。是的。"}, {"type": "subtitle", "time": 14957.99, "timestamp": "04:09:17", "text": "你明白这一点吗？你当然会这么做。"}, {"type": "subtitle", "time": 14962.469, "timestamp": "04:09:22", "text": "是的，我做了。当然是这样。我是一名"}, {"type": "subtitle", "time": 14966.07, "timestamp": "04:09:26", "text": "游戏玩家。对我而言？你还期待什么？"}, {"type": "subtitle", "time": 14967.59, "timestamp": "04:09:27", "text": "我就是这个意思。就是这样。"}, {"type": "subtitle", "time": 14970.79, "timestamp": "04:09:30", "text": "我认识你。"}, {"type": "subtitle", "time": 14984.11, "timestamp": "04:09:44", "text": "那就来吧。我们经历了一场冒险"}, {"type": "subtitle", "time": 14987.349, "timestamp": "04:09:47", "text": "等待伸手。闪亮的。我"}, {"type": "subtitle", "time": 14989.83, "timestamp": "04:09:49", "text": "死了。啊。"}, {"type": "subtitle", "time": 14995.83, "timestamp": "04:09:55", "text": "我的天哪。生气了。我试着跳下去。我试过"}, {"type": "subtitle", "time": 14998.79, "timestamp": "04:09:58", "text": "混蛋。等待。我不会失去我的"}]
[{"type": "subtitle", "time": 21540.59, "timestamp": "05:59:00", "text": "是的。真的吗？好的。好的。我读"}, {"type": "subtitle", "time": 21542.948, "timestamp": "05:59:02", "text": "那。我读过那篇文章。我不知道你是否"}, {"type": "subtitle", "time": 21546.05, "timestamp": "05:59:06", "text": "他们还在，不过，是的。"}, {"type": "subtitle", "time": 21571.19, "timestamp": "05:59:31", "text": "好的，我需要下楼去。"}, {"type": "subtitle", "time": 21574.548, "timestamp": "05:59:34", "text": "我会回来的。我会放一块板子。我如何"}, {"type": "subtitle", "time": 21594.51, "timestamp": "05:59:54", "text": "我们离得太远了。"}, {"type": "subtitle", "time": 21597.67, "timestamp": "05:59:57", "text": "655. 我们还有七分十秒"}]
[{"type": "subtitle", "time": 6849.55, "timestamp": "01:54:09", "text": "好的，我的水是"}, {"type": "subtitle", "time": 6853.189, "timestamp": "01:54:13", "text": "完毕。我的水用完了，我只能……"}, {"type": "subtitle", "time": 6856.229, "timestamp": "01:54:16", "text": "就这么做吧"}, {"type": "subtitle", "time": 6858.79, "timestamp": "01:54:18", "text": "伙计，这里面有地狱般的黑暗。我不知道"}, {"type": "subtitle", "time": 6883.669, "timestamp": "01:54:43", "text": "游戏。便携版。所有调整"}, {"type": "subtitle", "time": 6885.229, "timestamp": "01:54:45", "text": "在。祝您玩得愉快"}, {"type": "subtitle", "time": 6887.55, "timestamp": "01:54:47", "text": "看。"}]
[{"type": "subtitle", "time": 15062.59, "timestamp": "04:11:02", "text": "过去你不会失去你的"}, {"type": "subtitle", "time": 15071.91, "timestamp": "04:11:11", "text": "来。嗯，我们先来看看乔克吧。"}, {"type": "subtitle", "time": 15074.55, "timestamp": "04:11:14", "text": "看看他会说什么，因为我"}, {"type": "subtitle", "time": 15076.95, "timestamp": "04:11:16", "text": "他修建了一条通往这里的楼梯。"}, {"type": "subtitle", "time": 15080.55, "timestamp": "04:11:20", "text": "跳了起来。你他妈跳了。你没有"}, {"type": "subtitle", "time": 15082.87, "timestamp": "04:11:22", "text": "建造楼梯。"}, {"type": "subtitle", "time": 15088.63, "timestamp": "04:11:28", "text": "我做了。你在哪儿？我可以来这里。他是"}, {"type": "subtitle", "time": 15091.03, "timestamp": "04:11:31", "text": "未来。他正在路上。我想看看"}, {"type": "subtitle", "time": 15108.63, "timestamp": "04:11:48", "text": "猜测。该死。继续跑，伙计。保持"}, {"type": "subtitle", "time": 15111.03, "timestamp": "04:11:51", "text": "跑步。你快到了。该死。为什么"}]
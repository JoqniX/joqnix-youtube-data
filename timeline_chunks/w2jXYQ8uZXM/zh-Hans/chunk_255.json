[{"type": "subtitle", "time": 15300.51, "timestamp": "04:15:00", "text": "如何放置"}, {"type": "subtitle", "time": 15303.91, "timestamp": "04:15:03", "text": "我应该输入哪个键才能发出声音？"}, {"type": "subtitle", "time": 15305.99, "timestamp": "04:15:05", "text": "护盾生效了吗？"}, {"type": "subtitle", "time": 15309.269, "timestamp": "04:15:09", "text": "呃，按3。任何。不，我的意思是"}, {"type": "subtitle", "time": 15311.51, "timestamp": "04:15:11", "text": "无论护盾覆盖在什么位置。什么是"}, {"type": "subtitle", "time": 15315.99, "timestamp": "04:15:15", "text": "防护区？好的，明白了。"}, {"type": "subtitle", "time": 15317.75, "timestamp": "04:15:17", "text": "我的天啊。我正看着你死去。我是"}, {"type": "subtitle", "time": 15319.67, "timestamp": "04:15:19", "text": "看着你死去。顺便说一句，他们确实……"}, {"type": "subtitle", "time": 15325.67, "timestamp": "04:15:25", "text": "他还要再死一次。你是吗？我们是吗？"}, {"type": "subtitle", "time": 15327.91, "timestamp": "04:15:27", "text": "你会看这个吗？我正在观看。我是"}, {"type": "subtitle", "time": 15330.87, "timestamp": "04:15:30", "text": "很遗憾，他也在这里死去。"}, {"type": "subtitle", "time": 15333.349, "timestamp": "04:15:33", "text": "我正在和他们中的两个人战斗。"}, {"type": "subtitle", "time": 15335.03, "timestamp": "04:15:35", "text": "哦，那太好了。我觉得我就是"}, {"type": "subtitle", "time": 15337.349, "timestamp": "04:15:37", "text": "只有一个。"}, {"type": "subtitle", "time": 15339.03, "timestamp": "04:15:39", "text": "我会帮我的，乔。我会过来"}, {"type": "subtitle", "time": 15353.59, "timestamp": "04:15:53", "text": "哟，过来。我来了。不用担心。"}, {"type": "subtitle", "time": 15356.389, "timestamp": "04:15:56", "text": "我正在收集这些木材。"}]
[{"type": "subtitle", "time": 22381.67, "timestamp": "06:13:01", "text": "去。你知道我要做什么吗？我是"}, {"type": "subtitle", "time": 22384.868, "timestamp": "06:13:04", "text": "我打算创建一个短链接之类的东西。"}, {"type": "subtitle", "time": 22388.67, "timestamp": "06:13:08", "text": "我会把它弄成这样"}, {"type": "subtitle", "time": 22392.15, "timestamp": "06:13:12", "text": "乔洛。那一定很可爱。你知道"}, {"type": "subtitle", "time": 22394.11, "timestamp": "06:13:14", "text": "什么？我打算这样做"}, {"type": "subtitle", "time": 22401.47, "timestamp": "06:13:21", "text": "怎么可能"}, {"type": "subtitle", "time": 22423.15, "timestamp": "06:13:43", "text": "我不知道大多数人是否使用"}, {"type": "subtitle", "time": 22427.11, "timestamp": "06:13:47", "text": "嗯，你们管它叫什么？短链接。"}, {"type": "subtitle", "time": 22429.07, "timestamp": "06:13:49", "text": "品牌链接"}, {"type": "subtitle", "time": 22432.99, "timestamp": "06:13:52", "text": "已经不再使用了，但我见过有人用。"}, {"type": "subtitle", "time": 22437.03, "timestamp": "06:13:57", "text": "一些知名品牌和更多热门品牌"}, {"type": "subtitle", "time": 22439.23, "timestamp": "06:13:59", "text": "创造者"}]
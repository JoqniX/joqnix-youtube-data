[{"type": "subtitle", "time": 15480.469, "timestamp": "04:18:00", "text": "呃呃，像湖泊之类的吗？是的，"}, {"type": "subtitle", "time": 15483.51, "timestamp": "04:18:03", "text": "只需选择“去”这个词，怎么说呢？"}, {"type": "subtitle", "time": 15486.389, "timestamp": "04:18:06", "text": "亲和力。就拿走"}, {"type": "subtitle", "time": 15492.149, "timestamp": "04:18:12", "text": "呃，恢复活力，然后下水。"}, {"type": "subtitle", "time": 15499.87, "timestamp": "04:18:19", "text": "现在就下水吧。结束了"}, {"type": "subtitle", "time": 15503.189, "timestamp": "04:18:23", "text": "那里。快快下水！这是"}, {"type": "subtitle", "time": 15518.149, "timestamp": "04:18:38", "text": "你正在恢复活力吗？"}, {"type": "subtitle", "time": 15520.229, "timestamp": "04:18:40", "text": "是的。"}, {"type": "subtitle", "time": 15523.59, "timestamp": "04:18:43", "text": "我现在是一条美人鱼了。"}, {"type": "subtitle", "time": 15526.63, "timestamp": "04:18:46", "text": "该死的家伙。"}, {"type": "subtitle", "time": 15530.71, "timestamp": "04:18:50", "text": "我们有了新的，我有了新的，我达到了水平"}]
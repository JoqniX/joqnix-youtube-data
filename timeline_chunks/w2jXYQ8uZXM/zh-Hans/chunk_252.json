[{"type": "subtitle", "time": 15129.429, "timestamp": "04:12:09", "text": "该死的家伙。妈妈身材很棒"}, {"type": "subtitle", "time": 15133.67, "timestamp": "04:12:13", "text": "站在我旁边。该死。"}, {"type": "subtitle", "time": 15137.83, "timestamp": "04:12:17", "text": "是的，我就是在这里去世的。"}, {"type": "subtitle", "time": 15139.75, "timestamp": "04:12:19", "text": "是的。我建了个楼梯去"}, {"type": "subtitle", "time": 15142.59, "timestamp": "04:12:22", "text": "那里。但你可以拿到你的东西。"}, {"type": "subtitle", "time": 15146.07, "timestamp": "04:12:26", "text": "实际上。给我木头。我要走了"}, {"type": "subtitle", "time": 15148.07, "timestamp": "04:12:28", "text": "得到它。"}, {"type": "subtitle", "time": 15156.55, "timestamp": "04:12:36", "text": "又来了，兄弟？到底是怎么回事？"}, {"type": "subtitle", "time": 15158.309, "timestamp": "04:12:38", "text": "这个游戏？"}, {"type": "subtitle", "time": 15171.67, "timestamp": "04:12:51", "text": "千万别再死了。哦，该死。他"}, {"type": "subtitle", "time": 15175.269, "timestamp": "04:12:55", "text": "他只死过两次。两次。我觉得我"}]
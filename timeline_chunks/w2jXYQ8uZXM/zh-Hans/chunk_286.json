[{"type": "subtitle", "time": 17160.47, "timestamp": "04:46:00", "text": "那里。"}, {"type": "subtitle", "time": 17164.47, "timestamp": "04:46:04", "text": "你们两个在哪儿？抬头。"}, {"type": "subtitle", "time": 17168.47, "timestamp": "04:46:08", "text": "向上。哦，向上向上向上向上。"}, {"type": "subtitle", "time": 17172.07, "timestamp": "04:46:12", "text": "你正在建造通往天堂的阶梯。我"}, {"type": "subtitle", "time": 17173.91, "timestamp": "04:46:13", "text": "不了解我们的工作。我愿意做。"}, {"type": "subtitle", "time": 17176.878, "timestamp": "04:46:16", "text": "我愿意做。 继续前进。"}, {"type": "subtitle", "time": 17196.868, "timestamp": "04:46:36", "text": "真糟糕。好吧，我希望有"}, {"type": "subtitle", "time": 17199.91, "timestamp": "04:46:39", "text": "上面有什么东西，或者除非我们是这样的"}, {"type": "subtitle", "time": 17201.23, "timestamp": "04:46:41", "text": "去"}, {"type": "subtitle", "time": 17204.948, "timestamp": "04:46:44", "text": "又要死在这里了。哦，等等，"}, {"type": "subtitle", "time": 17207.35, "timestamp": "04:46:47", "text": "等等，等等，等等。别来。"}, {"type": "subtitle", "time": 17211.11, "timestamp": "04:46:51", "text": "我有个主意。我会把它移到"}, {"type": "subtitle", "time": 17213.75, "timestamp": "04:46:53", "text": "像个平台一样，然后再次向上。"}]
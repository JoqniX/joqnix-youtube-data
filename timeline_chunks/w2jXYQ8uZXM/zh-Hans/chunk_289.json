[{"type": "subtitle", "time": 17346.11, "timestamp": "04:49:06", "text": "我的天啊。他来了。不，我"}, {"type": "subtitle", "time": 17348.39, "timestamp": "04:49:08", "text": "他正在祈祷，这样他就不会失去他"}, {"type": "subtitle", "time": 17351.35, "timestamp": "04:49:11", "text": "脸。我的天哪。"}, {"type": "subtitle", "time": 17354.67, "timestamp": "04:49:14", "text": "等等，兄弟，没水了。"}, {"type": "subtitle", "time": 17356.55, "timestamp": "04:49:16", "text": "[音乐]"}, {"type": "subtitle", "time": 17358.91, "timestamp": "04:49:18", "text": "你……"}, {"type": "subtitle", "time": 17361.83, "timestamp": "04:49:21", "text": "看看这个？"}, {"type": "subtitle", "time": 17364.91, "timestamp": "04:49:24", "text": "看看这个人。我"}, {"type": "subtitle", "time": 17368.708, "timestamp": "04:49:28", "text": "我在这里。看。这里右边是什么？他"}, {"type": "subtitle", "time": 17371.35, "timestamp": "04:49:31", "text": "扑到我身上。"}, {"type": "subtitle", "time": 17373.27, "timestamp": "04:49:33", "text": "哇。"}, {"type": "subtitle", "time": 17375.43, "timestamp": "04:49:35", "text": "哦，这个人。"}, {"type": "subtitle", "time": 17376.19, "timestamp": "04:49:36", "text": "这"}, {"type": "subtitle", "time": 17380.23, "timestamp": "04:49:40", "text": "男。这家伙，真是的。我的天哪！"}, {"type": "subtitle", "time": 17382.628, "timestamp": "04:49:42", "text": "上帝。好的，我们需要一个构造。现在"}, {"type": "subtitle", "time": 17384.55, "timestamp": "04:49:44", "text": "我们将踏上水上之旅。"}, {"type": "subtitle", "time": 17388.23, "timestamp": "04:49:48", "text": "拜托，伙计们。足够的。哈哈。他"}, {"type": "subtitle", "time": 17390.47, "timestamp": "04:49:50", "text": "呃，造一艘船。你如何"}, {"type": "subtitle", "time": 17393.51, "timestamp": "04:49:53", "text": "造一艘船？好的。那就让我……"}, {"type": "subtitle", "time": 17397.35, "timestamp": "04:49:57", "text": "一艘船。没关系。骨钉。如何"}]
[{"type": "subtitle", "time": 17761.07, "timestamp": "04:56:01", "text": "我要去拿那些致残的骨头"}, {"type": "subtitle", "time": 17763.35, "timestamp": "04:56:03", "text": "东西。我该如何获得这种致残性？"}, {"type": "subtitle", "time": 17765.67, "timestamp": "04:56:05", "text": "骨头？"}, {"type": "subtitle", "time": 17768.628, "timestamp": "04:56:08", "text": "呃，你有这些东西吗？"}, {"type": "subtitle", "time": 17772.15, "timestamp": "04:56:12", "text": "比如绿叶子之类的？"}, {"type": "subtitle", "time": 17774.31, "timestamp": "04:56:14", "text": "什么叶子？"}, {"type": "subtitle", "time": 17776.788, "timestamp": "04:56:16", "text": "我觉得它就在“我会利用”这句话里。"}, {"type": "subtitle", "time": 17786.47, "timestamp": "04:56:26", "text": "我打败了这些怪物，但它们"}, {"type": "subtitle", "time": 17790.03, "timestamp": "04:56:30", "text": "不是D。他们没有放弃。"}, {"type": "subtitle", "time": 17793.03, "timestamp": "04:56:33", "text": "任何事物。他们很可能这么做了。开始了。"}, {"type": "subtitle", "time": 17794.51, "timestamp": "04:56:34", "text": "慢跑。由"}, {"type": "subtitle", "time": 17798.03, "timestamp": "04:56:38", "text": "没错，就是骨钉，对吧？"}, {"type": "subtitle", "time": 17801.99, "timestamp": "04:56:41", "text": "是的。我需要制作骨棒。"}, {"type": "subtitle", "time": 17803.59, "timestamp": "04:56:43", "text": "另外，你听到施工的声音了吗？"}, {"type": "subtitle", "time": 17805.43, "timestamp": "04:56:45", "text": "噪音？"}, {"type": "subtitle", "time": 17807.35, "timestamp": "04:56:47", "text": "我的麦克风。"}, {"type": "subtitle", "time": 17809.59, "timestamp": "04:56:49", "text": "好的。我们或许不需要骨棒。"}, {"type": "subtitle", "time": 17811.83, "timestamp": "04:56:51", "text": "你知道，因为普通俱乐部也"}, {"type": "subtitle", "time": 17815.75, "timestamp": "04:56:55", "text": "效果一样。什么？"}, {"type": "subtitle", "time": 17817.67, "timestamp": "04:56:57", "text": "是的，差别不大。"}]
[{"type": "subtitle", "time": 21251.43, "timestamp": "05:54:11", "text": "水马。你还记得我吗？是的。"}, {"type": "subtitle", "time": 21254.23, "timestamp": "05:54:14", "text": "晚上好。你好。"}, {"type": "subtitle", "time": 21256.07, "timestamp": "05:54:16", "text": "等等，你是什么时候发的这条消息？"}, {"type": "subtitle", "time": 21294.948, "timestamp": "05:54:54", "text": "分钟。我……我要吃午饭了。呃"}, {"type": "subtitle", "time": 21298.15, "timestamp": "05:54:58", "text": "茶。茶。我的茶和点心会在里面。"}]
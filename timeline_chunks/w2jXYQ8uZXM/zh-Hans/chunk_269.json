[{"type": "subtitle", "time": 16152.99, "timestamp": "04:29:12", "text": "哦"}, {"type": "subtitle", "time": 16155.67, "timestamp": "04:29:15", "text": "上帝。我的天哪。还有，你在哪里？哦，"}, {"type": "subtitle", "time": 16157.91, "timestamp": "04:29:17", "text": "你们做了"}, {"type": "subtitle", "time": 16159.91, "timestamp": "04:29:19", "text": "你们来得真快。什么是"}, {"type": "subtitle", "time": 16161.75, "timestamp": "04:29:21", "text": "这？这种平台跳跃是怎么回事？你"}, {"type": "subtitle", "time": 16166.229, "timestamp": "04:29:26", "text": "想拿走什么吗？是的，先生。"}, {"type": "subtitle", "time": 16168.87, "timestamp": "04:29:28", "text": "你们都很棒。是的，我们现在在"}, {"type": "subtitle", "time": 16170.79, "timestamp": "04:29:30", "text": "同一个地方。我希望我们不要这样。"}, {"type": "subtitle", "time": 16172.71, "timestamp": "04:29:32", "text": "再次死去。"}, {"type": "subtitle", "time": 16175.11, "timestamp": "04:29:35", "text": "好的，我正在做一个很长的楼梯。"}, {"type": "subtitle", "time": 16178.55, "timestamp": "04:29:38", "text": "直到我们到达那里。"}]
[{"type": "subtitle", "time": 12066.79, "timestamp": "03:21:06", "text": "我想是因为我把画面设置调低了。"}, {"type": "subtitle", "time": 12069.429, "timestamp": "03:21:09", "text": "这就是原因。是的。哦，回来吧。"}, {"type": "subtitle", "time": 12071.19, "timestamp": "03:21:11", "text": "看起来仍然很不错。"}, {"type": "subtitle", "time": 12074.309, "timestamp": "03:21:14", "text": "我的天哪，他回来了。是的，我回来了。哦"}, {"type": "subtitle", "time": 12077.99, "timestamp": "03:21:17", "text": "我的上帝。我要启动"}, {"type": "subtitle", "time": 12079.91, "timestamp": "03:21:19", "text": "游戏。"}, {"type": "subtitle", "time": 12081.99, "timestamp": "03:21:21", "text": "好的。"}, {"type": "subtitle", "time": 12085.59, "timestamp": "03:21:25", "text": "天哪，我的电脑好卡！"}, {"type": "subtitle", "time": 12092.15, "timestamp": "03:21:32", "text": "啊，关键部件。好的，重新开始"}, {"type": "subtitle", "time": 12096.79, "timestamp": "03:21:36", "text": "团队。拿着。哦，是的。给一些。"}, {"type": "subtitle", "time": 12099.19, "timestamp": "03:21:39", "text": "你知道吗？我觉得自己就像赤身裸体一样。谢谢"}, {"type": "subtitle", "time": 12102.15, "timestamp": "03:21:42", "text": "为了平底锅，伙计。还有这里。"}, {"type": "subtitle", "time": 12105.59, "timestamp": "03:21:45", "text": "谢谢。哦是的。遮住我的胸部"}, {"type": "subtitle", "time": 12114.389, "timestamp": "03:21:54", "text": "我们现在就等乔回来吧。我会杀了"}, {"type": "subtitle", "time": 12117.67, "timestamp": "03:21:57", "text": "这些螃蟹中还有一些"}]
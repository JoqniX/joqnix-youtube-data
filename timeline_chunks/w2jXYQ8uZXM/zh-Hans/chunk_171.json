[{"type": "subtitle", "time": 10261.429, "timestamp": "02:51:01", "text": "昨天？"}, {"type": "subtitle", "time": 10264.309, "timestamp": "02:51:04", "text": "是的，我们可以。"}, {"type": "subtitle", "time": 10266.87, "timestamp": "02:51:06", "text": "哦是的。因为我本来打算打开漫威"}, {"type": "subtitle", "time": 10268.63, "timestamp": "02:51:08", "text": "瞬间成为对手，但我当时想的是，"}, {"type": "subtitle", "time": 10272.55, "timestamp": "02:51:12", "text": "等一下，阿拉苏来了。"}, {"type": "subtitle", "time": 10276.469, "timestamp": "02:51:16", "text": "是的。那么，后来发生了什么事？"}, {"type": "subtitle", "time": 10279.269, "timestamp": "02:51:19", "text": "发生了什么事？我会玩的。我当时"}, {"type": "subtitle", "time": 10282.389, "timestamp": "02:51:22", "text": "被各种事情分心了。我也加入了"}, {"type": "subtitle", "time": 10285.19, "timestamp": "02:51:25", "text": "直播，还有这个人，就像"}, {"type": "subtitle", "time": 10287.269, "timestamp": "02:51:27", "text": "输入一些代码。我心想，这是……"}, {"type": "subtitle", "time": 10289.99, "timestamp": "02:51:29", "text": "哇？这是新活动吗？必须砍掉"}, {"type": "subtitle", "time": 10294.23, "timestamp": "02:51:34", "text": "代码。不，这是我新的想法。"}, {"type": "subtitle", "time": 10296.63, "timestamp": "02:51:36", "text": "我下午会直播。不是"}, {"type": "subtitle", "time": 10298.87, "timestamp": "02:51:38", "text": "下午。我本来想早点做，但是"}, {"type": "subtitle", "time": 10302.389, "timestamp": "02:51:42", "text": "我今天起得早，现在都晚了。所以，我觉得呃"}, {"type": "subtitle", "time": 10305.91, "timestamp": "02:51:45", "text": "我打算晚上做或者别的什么时间做。"}, {"type": "subtitle", "time": 10315.19, "timestamp": "02:51:55", "text": "合作标题党。标题党。"}, {"type": "subtitle", "time": 10317.349, "timestamp": "02:51:57", "text": "等等，我们今天就要在……"}]
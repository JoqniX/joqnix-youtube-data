[{"type": "subtitle", "time": 13680.99, "timestamp": "03:48:00", "text": "我的这个东西满了。"}, {"type": "subtitle", "time": 13684.63, "timestamp": "03:48:04", "text": "什么？我的……库存。"}, {"type": "subtitle", "time": 13686.389, "timestamp": "03:48:06", "text": "不，"}, {"type": "subtitle", "time": 13690.63, "timestamp": "03:48:10", "text": "我遭到攻击了。等待。"}, {"type": "subtitle", "time": 13693.11, "timestamp": "03:48:13", "text": "哦，你来自哪里？"}, {"type": "subtitle", "time": 13694.95, "timestamp": "03:48:14", "text": "我本可以战胜他们。我有一个"}, {"type": "subtitle", "time": 13697.469, "timestamp": "03:48:17", "text": "挑战。"}, {"type": "subtitle", "time": 13701.43, "timestamp": "03:48:21", "text": "哦，我的错，狗狗。我的错。"}, {"type": "subtitle", "time": 13708.95, "timestamp": "03:48:28", "text": "一秒钟。我可以拿点树脂吗？"}, {"type": "subtitle", "time": 13710.87, "timestamp": "03:48:30", "text": "请？"}, {"type": "subtitle", "time": 13713.75, "timestamp": "03:48:33", "text": "哦，当然可以。请这样做。谢谢。"}, {"type": "subtitle", "time": 13731.309, "timestamp": "03:48:51", "text": "绷带。让我把这些绳子放好。"}]
[{"type": "subtitle", "time": 18183.07, "timestamp": "05:03:03", "text": "哇。哦，令人舒缓的锚点更新"}, {"type": "subtitle", "time": 18190.55, "timestamp": "05:03:10", "text": "令人舒缓的氛围。"}, {"type": "subtitle", "time": 18193.99, "timestamp": "05:03:13", "text": "在哪里可以买到？我们需要"}, {"type": "subtitle", "time": 18196.708, "timestamp": "05:03:16", "text": "哦，我们或许能做到。"}, {"type": "subtitle", "time": 18198.55, "timestamp": "05:03:18", "text": "获取一些法力。"}, {"type": "subtitle", "time": 18200.39, "timestamp": "05:03:20", "text": "水的强度。拥有大量法力值"}, {"type": "subtitle", "time": 18201.99, "timestamp": "05:03:21", "text": "我。"}, {"type": "subtitle", "time": 18212.07, "timestamp": "05:03:32", "text": "好的，我们现在可以搭建一套新的场景了。"}, {"type": "subtitle", "time": 18216.31, "timestamp": "05:03:36", "text": "这件盔甲部件要好得多。"}, {"type": "subtitle", "time": 18219.27, "timestamp": "05:03:39", "text": "我在航海。"}, {"type": "subtitle", "time": 18221.83, "timestamp": "05:03:41", "text": "不要出海。把它拆解开来。为什么？在哪里"}, {"type": "subtitle", "time": 18223.75, "timestamp": "05:03:43", "text": "你要去吗？"}, {"type": "subtitle", "time": 18226.39, "timestamp": "05:03:46", "text": "冒险。"}, {"type": "subtitle", "time": 18228.31, "timestamp": "05:03:48", "text": "我的天啊。你想要萤石吗？"}, {"type": "subtitle", "time": 18229.83, "timestamp": "05:03:49", "text": "某物？"}, {"type": "subtitle", "time": 18233.948, "timestamp": "05:03:53", "text": "发光石。是的，我可以用它们来制作"}, {"type": "subtitle", "time": 18236.47, "timestamp": "05:03:56", "text": "箭头。开始了，兄弟。你如何"}]
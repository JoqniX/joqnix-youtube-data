[{"type": "subtitle", "time": 17077.11, "timestamp": "04:44:37", "text": "我的口袋感觉很沉？我的天啊。我"}, {"type": "subtitle", "time": 17079.83, "timestamp": "04:44:39", "text": "我不能带走我的东西。它是"}, {"type": "subtitle", "time": 17082.27, "timestamp": "04:44:42", "text": "太重了。好吧，没事了。我得到了"}, {"type": "subtitle", "time": 17085.91, "timestamp": "04:44:45", "text": "它。我到底被困在什么地方了？哦"}, {"type": "subtitle", "time": 17087.83, "timestamp": "04:44:47", "text": "我的"}, {"type": "subtitle", "time": 17089.43, "timestamp": "04:44:49", "text": "如果你卡住了，你就需要像跑步一样奔跑。"}, {"type": "subtitle", "time": 17091.83, "timestamp": "04:44:51", "text": "卡住。不，不，不，不，不。就像"}]
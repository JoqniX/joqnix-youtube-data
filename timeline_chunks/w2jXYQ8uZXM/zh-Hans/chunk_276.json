[{"type": "subtitle", "time": 16562.629, "timestamp": "04:36:02", "text": "后退。狗。狗。稍等片刻。哦，"}, {"type": "subtitle", "time": 16565.709, "timestamp": "04:36:05", "text": "我起身。我可以帮你做。"}, {"type": "subtitle", "time": 16569.429, "timestamp": "04:36:09", "text": "啊，兄弟。你可以帮我做这件事。哦，是的。"}, {"type": "subtitle", "time": 16571.51, "timestamp": "04:36:11", "text": "那很好。"}, {"type": "subtitle", "time": 16573.51, "timestamp": "04:36:13", "text": "我能看到你的尸体在那边。你"}, {"type": "subtitle", "time": 16575.75, "timestamp": "04:36:15", "text": "他死在了我死的同一个地方。是的。我"}, {"type": "subtitle", "time": 16578.029, "timestamp": "04:36:18", "text": "我们认为我们需要精心制作"}, {"type": "subtitle", "time": 16589.269, "timestamp": "04:36:29", "text": "没有。你没睡吗？"}, {"type": "subtitle", "time": 16592.629, "timestamp": "04:36:32", "text": "没有人睡觉。"}, {"type": "subtitle", "time": 16594.589, "timestamp": "04:36:34", "text": "是"}, {"type": "subtitle", "time": 16596.39, "timestamp": "04:36:36", "text": "[音乐]"}, {"type": "subtitle", "time": 16598.07, "timestamp": "04:36:38", "text": "再次。"}, {"type": "subtitle", "time": 16600.869, "timestamp": "04:36:40", "text": "是的。"}, {"type": "subtitle", "time": 16604.789, "timestamp": "04:36:44", "text": "为什么我们会死得这么多？为什么我们"}, {"type": "subtitle", "time": 16607.429, "timestamp": "04:36:47", "text": "你的声音断断续续的。呃，我的声音"}, {"type": "subtitle", "time": 16609.67, "timestamp": "04:36:49", "text": "正在分手。等等，各位。你没有"}, {"type": "subtitle", "time": 16611.67, "timestamp": "04:36:51", "text": "听见我声音哽咽了吗？"}, {"type": "subtitle", "time": 16614.349, "timestamp": "04:36:54", "text": "不，不，我其实没有。我的天啊。"}]
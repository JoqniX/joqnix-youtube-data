[{"type": "subtitle", "time": 11646.229, "timestamp": "03:14:06", "text": "是的。说实话，我真的很害怕"}, {"type": "subtitle", "time": 11648.15, "timestamp": "03:14:08", "text": "水。而现在，看着"}, {"type": "subtitle", "time": 11650.229, "timestamp": "03:14:10", "text": "唉，真是有点烦人。"}, {"type": "subtitle", "time": 11652.67, "timestamp": "03:14:12", "text": "我不想去"}, {"type": "subtitle", "time": 11655.269, "timestamp": "03:14:15", "text": "深的。看着有点吓人，你"}, {"type": "subtitle", "time": 11657.349, "timestamp": "03:14:17", "text": "我知道，而且天黑了，哦，是的。"}, {"type": "subtitle", "time": 11659.269, "timestamp": "03:14:19", "text": "这简直糟透了。我有点"}, {"type": "subtitle", "time": 11665.11, "timestamp": "03:14:25", "text": "这里。哦，是的。其中一条大鱼"}, {"type": "subtitle", "time": 11666.95, "timestamp": "03:14:26", "text": "现在他们要来找我了。那太棒了。我"}, {"type": "subtitle", "time": 11668.87, "timestamp": "03:14:28", "text": "知道。"}, {"type": "subtitle", "time": 11671.429, "timestamp": "03:14:31", "text": "那就是我不是个怂包。我来了"}, {"type": "subtitle", "time": 11673.99, "timestamp": "03:14:33", "text": "这个贱人。过来。我要刺杀"}, {"type": "subtitle", "time": 11679.75, "timestamp": "03:14:39", "text": "你的屁股。哦，对了，它正在运行。"}, {"type": "subtitle", "time": 11683.349, "timestamp": "03:14:43", "text": "哦，我们正在处理这件事。谁在乎？"}, {"type": "subtitle", "time": 11686.15, "timestamp": "03:14:46", "text": "我懂了。好的。乔克不会介意我的。"}, {"type": "subtitle", "time": 11693.11, "timestamp": "03:14:53", "text": "大概。你见过那些吗？"}, {"type": "subtitle", "time": 11695.19, "timestamp": "03:14:55", "text": "我在玩《漫威宿敌》的时候会直播吗？"}, {"type": "subtitle", "time": 11697.99, "timestamp": "03:14:57", "text": "她"}]
[{"type": "subtitle", "time": 19140.11, "timestamp": "05:19:00", "text": "哦，我得到了V"}, {"type": "subtitle", "time": 19143.47, "timestamp": "05:19:03", "text": "还。我刚收到"}, {"type": "subtitle", "time": 19156.15, "timestamp": "05:19:16", "text": "不要再找同一种类型的男人了。不"}, {"type": "subtitle", "time": 19161.99, "timestamp": "05:19:21", "text": "它。我又被鲨鱼吓到了。但"}, {"type": "subtitle", "time": 19164.31, "timestamp": "05:19:24", "text": "另一个箱子在哪里？"}, {"type": "subtitle", "time": 19165.788, "timestamp": "05:19:25", "text": "在...前面"}, {"type": "subtitle", "time": 19173.55, "timestamp": "05:19:33", "text": "但愿如此。我是"}, {"type": "subtitle", "time": 19195.07, "timestamp": "05:19:55", "text": "哦，我死了。兄弟，这"}, {"type": "subtitle", "time": 19198.868, "timestamp": "05:19:58", "text": "鲨鱼。 1马力。 1马力。 1马力。他不是"}]
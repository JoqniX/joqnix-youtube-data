[{"type": "subtitle", "time": 18601.51, "timestamp": "05:10:01", "text": "他上下移动。我知道。我知道。"}, {"type": "subtitle", "time": 18604.23, "timestamp": "05:10:04", "text": "我想。"}, {"type": "subtitle", "time": 18605.75, "timestamp": "05:10:05", "text": "想等他并帮助他，还是"}, {"type": "subtitle", "time": 18608.23, "timestamp": "05:10:08", "text": "我们是不是应该就此离开他？我们能做到"}, {"type": "subtitle", "time": 18609.99, "timestamp": "05:10:09", "text": "独自的。没错，我们一定要抓住他。哦，"}, {"type": "subtitle", "time": 18612.07, "timestamp": "05:10:12", "text": "是的。是的。去。没关系。没关系。我"}, {"type": "subtitle", "time": 18616.868, "timestamp": "05:10:16", "text": "看来我得离开了。嗯，是的。"}, {"type": "subtitle", "time": 18620.55, "timestamp": "05:10:20", "text": "你可以加入我们的线上活动，或者来我这里。"}, {"type": "subtitle", "time": 18622.47, "timestamp": "05:10:22", "text": "遭受了很大的损失。你想做什么"}, {"type": "subtitle", "time": 18623.83, "timestamp": "05:10:23", "text": "你想来船上吗？"}, {"type": "subtitle", "time": 18625.67, "timestamp": "05:10:25", "text": "打算自己去弄艘船吗？我拥有一艘船。"}, {"type": "subtitle", "time": 18631.47, "timestamp": "05:10:31", "text": "缰绳"}, {"type": "subtitle", "time": 18634.868, "timestamp": "05:10:34", "text": "我将去哪里逃离。"}, {"type": "subtitle", "time": 18636.708, "timestamp": "05:10:36", "text": "我的天哪，那里有条食人鱼。"}, {"type": "subtitle", "time": 18643.27, "timestamp": "05:10:43", "text": "那是一条鲨鱼。"}, {"type": "subtitle", "time": 18646.15, "timestamp": "05:10:46", "text": "对，鲨鱼。这是我们身后的胸部。"}, {"type": "subtitle", "time": 18658.948, "timestamp": "05:10:58", "text": "哦，老板是食人鱼。好的，"}]
[{"type": "subtitle", "time": 18423.67, "timestamp": "05:07:03", "text": "什么？去弄点吃的。"}, {"type": "subtitle", "time": 18425.35, "timestamp": "05:07:05", "text": "抓住它。我们需要给乔克一些……"}, {"type": "subtitle", "time": 18431.91, "timestamp": "05:07:11", "text": "找到“找回你的盔甲”和“在哪里”。"}, {"type": "subtitle", "time": 18435.11, "timestamp": "05:07:15", "text": "那套盔甲？我把它给你了，对吧？"}, {"type": "subtitle", "time": 18439.03, "timestamp": "05:07:19", "text": "只有头部。只有什么？是的。这里"}, {"type": "subtitle", "time": 18441.19, "timestamp": "05:07:21", "text": "我们走。我可以把它扔掉吗？干得好。好的，"}, {"type": "subtitle", "time": 18443.868, "timestamp": "05:07:23", "text": "我在这里找到了。哦，什么？"}, {"type": "subtitle", "time": 18446.23, "timestamp": "05:07:26", "text": "还剩下什么？什么？还剩下什么"}, {"type": "subtitle", "time": 18474.628, "timestamp": "05:07:54", "text": "你有那个水容器吗？水"}, {"type": "subtitle", "time": 18479.59, "timestamp": "05:07:59", "text": "力量？我想我的确有。我"}]
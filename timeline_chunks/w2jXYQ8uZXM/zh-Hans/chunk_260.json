[{"type": "subtitle", "time": 15600.309, "timestamp": "04:20:00", "text": "我的上帝。"}, {"type": "subtitle", "time": 15604.63, "timestamp": "04:20:04", "text": "我觉得我离下一个目的地不远了。"}, {"type": "subtitle", "time": 15605.95, "timestamp": "04:20:05", "text": "是的，"}, {"type": "subtitle", "time": 15608.71, "timestamp": "04:20:08", "text": "因为不，我看到这边有个山洞。我可以"}, {"type": "subtitle", "time": 15611.189, "timestamp": "04:20:11", "text": "向上爬。"}, {"type": "subtitle", "time": 15621.349, "timestamp": "04:20:21", "text": "该死。你看到那艘船了吗？我看见他了。"}, {"type": "subtitle", "time": 15623.269, "timestamp": "04:20:23", "text": "哦，他们看见我了。攻击正在发生。"}, {"type": "subtitle", "time": 15627.349, "timestamp": "04:20:27", "text": "我。哦，是的。并不真地。我没看到"}, {"type": "subtitle", "time": 15641.67, "timestamp": "04:20:41", "text": "你其实不是美人鱼。猜测"}, {"type": "subtitle", "time": 15647.91, "timestamp": "04:20:47", "text": "我的朋友，人鱼。啊，美人鱼。好的。"}, {"type": "subtitle", "time": 15650.55, "timestamp": "04:20:50", "text": "好的。是的，"}, {"type": "subtitle", "time": 15654.469, "timestamp": "04:20:54", "text": "一条美人鱼。你认为美人鱼真的存在吗？"}, {"type": "subtitle", "time": 15658.07, "timestamp": "04:20:58", "text": "不，我们需要水。嗯，大概吧。我认为"}]
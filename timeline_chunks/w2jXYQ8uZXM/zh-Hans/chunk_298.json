[{"type": "subtitle", "time": 17881.43, "timestamp": "04:58:01", "text": "修补工具包。修补工具包。"}, {"type": "subtitle", "time": 17888.868, "timestamp": "04:58:08", "text": "这里。给予。"}, {"type": "subtitle", "time": 17891.35, "timestamp": "04:58:11", "text": "好的，我要给你们做一些"}, {"type": "subtitle", "time": 17894.47, "timestamp": "04:58:14", "text": "现在是一件盔甲部件。等等，这是什么级别？"}, {"type": "subtitle", "time": 17896.55, "timestamp": "04:58:16", "text": "你现在感觉如何？"}, {"type": "subtitle", "time": 17898.83, "timestamp": "04:58:18", "text": "我"}, {"type": "subtitle", "time": 17906.07, "timestamp": "04:58:26", "text": "哦，我玩到第八局了。"}, {"type": "subtitle", "time": 17907.67, "timestamp": "04:58:27", "text": "那很好。因为我不想那样做"}, {"type": "subtitle", "time": 17910.11, "timestamp": "04:58:30", "text": "待办事项。八。"}, {"type": "subtitle", "time": 17913.27, "timestamp": "04:58:33", "text": "如何？我的意思是，我去冒险了"}, {"type": "subtitle", "time": 17915.83, "timestamp": "04:58:35", "text": "东西。好的，我走了。不，就像……"}, {"type": "subtitle", "time": 17918.47, "timestamp": "04:58:38", "text": "你甚至喜欢砍树，去做一些吧。"}, {"type": "subtitle", "time": 17920.23, "timestamp": "04:58:40", "text": "通过刷怪升级，你也可以通过刷怪升级。"}, {"type": "subtitle", "time": 17922.47, "timestamp": "04:58:42", "text": "那。"}, {"type": "subtitle", "time": 17929.91, "timestamp": "04:58:49", "text": "哦，这真是一种体验。好的。好的，"}, {"type": "subtitle", "time": 17931.15, "timestamp": "04:58:51", "text": "我们开始吧"}, {"type": "subtitle", "time": 17933.59, "timestamp": "04:58:53", "text": "老板。哦，是的。时钟。我需要一点"}]
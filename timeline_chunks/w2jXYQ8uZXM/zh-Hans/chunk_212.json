[{"type": "subtitle", "time": 12722.349, "timestamp": "03:32:02", "text": "低画质下 60 帧。这是"}, {"type": "subtitle", "time": 12725.71, "timestamp": "03:32:05", "text": "更好的。它落后的事实是"}, {"type": "subtitle", "time": 12729.03, "timestamp": "03:32:09", "text": "令人担忧的怪异之处。"}, {"type": "subtitle", "time": 12730.63, "timestamp": "03:32:10", "text": "是的，这款游戏确实会造成卡顿。"}, {"type": "subtitle", "time": 12732.87, "timestamp": "03:32:12", "text": "因为水的物理特性。像水"}, {"type": "subtitle", "time": 12735.429, "timestamp": "03:32:15", "text": "物理学很好。"}, {"type": "subtitle", "time": 12739.51, "timestamp": "03:32:19", "text": "等等，我做了这个基地。建造它。"}, {"type": "subtitle", "time": 12742.469, "timestamp": "03:32:22", "text": "但是门在哪里？呃，你必须"}, {"type": "subtitle", "time": 12745.59, "timestamp": "03:32:25", "text": "你看到那扇门了吗？"}, {"type": "subtitle", "time": 12749.75, "timestamp": "03:32:29", "text": "在……上"}, {"type": "subtitle", "time": 12752.15, "timestamp": "03:32:32", "text": "模式？是的。把它放进去就行了"}, {"type": "subtitle", "time": 12754.75, "timestamp": "03:32:34", "text": "它只会制造一扇门"}, {"type": "subtitle", "time": 12757.15, "timestamp": "03:32:37", "text": "本身。"}, {"type": "subtitle", "time": 12760.15, "timestamp": "03:32:40", "text": "我们来装门吧。"}, {"type": "subtitle", "time": 12767.51, "timestamp": "03:32:47", "text": "门。为什么？他们为什么拥有呼吸？"}, {"type": "subtitle", "time": 12771.19, "timestamp": "03:32:51", "text": "野性耐力条？"}, {"type": "subtitle", "time": 12774.15, "timestamp": "03:32:54", "text": "是的。好了。"}, {"type": "subtitle", "time": 12775.83, "timestamp": "03:32:55", "text": "是的，游戏里有个类似体力条的东西。不"}, {"type": "subtitle", "time": 12777.429, "timestamp": "03:32:57", "text": "无需担心这个问题。哦，乔克。我"}]
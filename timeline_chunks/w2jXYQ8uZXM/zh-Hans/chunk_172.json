[{"type": "subtitle", "time": 10320.469, "timestamp": "02:52:00", "text": "现在是下午。所以，没问题。我会"}, {"type": "subtitle", "time": 10323.67, "timestamp": "02:52:03", "text": "实际上，应该修改标题。我的天啊。到"}, {"type": "subtitle", "time": 10326.03, "timestamp": "02:52:06", "text": "到处都改一下。"}, {"type": "subtitle", "time": 10330.389, "timestamp": "02:52:10", "text": "哦，耶稣。这家伙在用标题党骗点击。"}, {"type": "subtitle", "time": 10333.83, "timestamp": "02:52:13", "text": "标题党。你太无耻了。"}, {"type": "subtitle", "time": 10336.24, "timestamp": "02:52:16", "text": "你太无耻了。 我的天啊。"}, {"type": "subtitle", "time": 10343.11, "timestamp": "02:52:23", "text": "该死的。为什么你们要像我们一样表现呢？"}, {"type": "subtitle", "time": 10345.51, "timestamp": "02:52:25", "text": "溪流？我只是在等某人。"}, {"type": "subtitle", "time": 10348.23, "timestamp": "02:52:28", "text": "流式传输。"}, {"type": "subtitle", "time": 10351.429, "timestamp": "02:52:31", "text": "不，我得手动观看。我有"}, {"type": "subtitle", "time": 10354.87, "timestamp": "02:52:34", "text": "现在需要手动观看。那么，我来打开"}, {"type": "subtitle", "time": 10357.51, "timestamp": "02:52:37", "text": "它。我来打开它。不用担心。我当时"}, {"type": "subtitle", "time": 10360.15, "timestamp": "02:52:40", "text": "哇，我的头像真好看。喜欢"}, {"type": "subtitle", "time": 10363.19, "timestamp": "02:52:43", "text": "看着弹药霜冻的东西"}, {"type": "subtitle", "time": 10366.309, "timestamp": "02:52:46", "text": "框架就像该死的，占用了……"}, {"type": "subtitle", "time": 10369.51, "timestamp": "02:52:49", "text": "我的大部分头像都是这个。"}, {"type": "subtitle", "time": 10372.07, "timestamp": "02:52:52", "text": "[音乐]"}, {"type": "subtitle", "time": 10374.03, "timestamp": "02:52:54", "text": "是的。哦，我的"}]
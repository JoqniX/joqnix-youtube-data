[{"type": "subtitle", "time": 11888.79, "timestamp": "03:18:08", "text": "抽烟。我们还需要赋予其中一人权力"}, {"type": "subtitle", "time": 11890.59, "timestamp": "03:18:10", "text": "这些"}, {"type": "subtitle", "time": 11893.99, "timestamp": "03:18:13", "text": "伙计们。别忘了这件事。什么"}, {"type": "subtitle", "time": 11896.309, "timestamp": "03:18:16", "text": "那种令人舒缓的氛围？玩家拥有"}, {"type": "subtitle", "time": 11898.63, "timestamp": "03:18:18", "text": "在灵锚内进行被动疗愈"}, {"type": "subtitle", "time": 11900.07, "timestamp": "03:18:20", "text": "灵气。"}, {"type": "subtitle", "time": 11905.83, "timestamp": "03:18:25", "text": "好的。伙计，去拿你的食物。获得你的"}, {"type": "subtitle", "time": 11913.03, "timestamp": "03:18:33", "text": "哦，留着吧。瞧，就是这个。确实如此。"}, {"type": "subtitle", "time": 11914.59, "timestamp": "03:18:34", "text": "它给了你很多"}, {"type": "subtitle", "time": 11918.95, "timestamp": "03:18:38", "text": "健康。我的意思是，很多时候都是这样。"}, {"type": "subtitle", "time": 11923.19, "timestamp": "03:18:43", "text": "你知道，你知道我在说什么。"}, {"type": "subtitle", "time": 11936.19, "timestamp": "03:18:56", "text": "你能做一个那样的吗？"}, {"type": "subtitle", "time": 11938.19, "timestamp": "03:18:58", "text": "嗯，维修"}]
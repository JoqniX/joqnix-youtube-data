[{"type": "subtitle", "time": 21780.15, "timestamp": "06:03:00", "text": "正确的？我没能把它送出去，因为……"}, {"type": "subtitle", "time": 21782.39, "timestamp": "06:03:02", "text": "那里发生了很多事。"}, {"type": "subtitle", "time": 21803.83, "timestamp": "06:03:23", "text": "大家周六晚上过得怎么样？"}, {"type": "subtitle", "time": 21807.43, "timestamp": "06:03:27", "text": "一直在进行吗？就像星期六一样。"}, {"type": "subtitle", "time": 21810.31, "timestamp": "06:03:30", "text": "晚上。星期六，不是星期六，星期日"}, {"type": "subtitle", "time": 21812.27, "timestamp": "06:03:32", "text": "晚上。星期日"}, {"type": "subtitle", "time": 21816.31, "timestamp": "06:03:36", "text": "夜晚。对于美国人来说，这就好比……"}, {"type": "subtitle", "time": 21817.708, "timestamp": "06:03:37", "text": "将会是"}, {"type": "subtitle", "time": 21819.628, "timestamp": "06:03:39", "text": "星期日，"}, {"type": "subtitle", "time": 21821.23, "timestamp": "06:03:41", "text": "正确的？"}, {"type": "subtitle", "time": 21828.07, "timestamp": "06:03:48", "text": "完毕。好的。等待。给我一分钟时间。呃"}, {"type": "subtitle", "time": 21829.47, "timestamp": "06:03:49", "text": "如何"}, {"type": "subtitle", "time": 21834.07, "timestamp": "06:03:54", "text": "我该怎么做？好的，明白了。像这样。我是"}, {"type": "subtitle", "time": 21837.868, "timestamp": "06:03:57", "text": "今天感觉很迷茫。我不知道"}]
[{"type": "subtitle", "time": 18902.99, "timestamp": "05:15:02", "text": "我需要"}, {"type": "subtitle", "time": 18905.03, "timestamp": "05:15:05", "text": "更甚者。"}, {"type": "subtitle", "time": 18908.19, "timestamp": "05:15:08", "text": "给我"}, {"type": "subtitle", "time": 18911.47, "timestamp": "05:15:11", "text": "水。好了，我们走吧。"}, {"type": "subtitle", "time": 18913.99, "timestamp": "05:15:13", "text": "什么？伙计们，瞄准水面。目标是"}, {"type": "subtitle", "time": 18916.23, "timestamp": "05:15:16", "text": "水。哦，是的。"}, {"type": "subtitle", "time": 18917.75, "timestamp": "05:15:17", "text": "这里上方应该有胸部。"}, {"type": "subtitle", "time": 18920.39, "timestamp": "05:15:20", "text": "你没检查吗？我看到一些，我看到一些"}, {"type": "subtitle", "time": 18923.75, "timestamp": "05:15:23", "text": "东西。各位，拿走我的东西吧。我不"}, {"type": "subtitle", "time": 18927.948, "timestamp": "05:15:27", "text": "瞧瞧，伙计们。是的，我想"}, {"type": "subtitle", "time": 18932.15, "timestamp": "05:15:32", "text": "我的朋友去世了。我不知道。哦，对"}, {"type": "subtitle", "time": 18933.91, "timestamp": "05:15:33", "text": "就在船的正前方。因为我"}, {"type": "subtitle", "time": 18940.39, "timestamp": "05:15:40", "text": "与此同时，我会改变我的"}, {"type": "subtitle", "time": 18944.708, "timestamp": "05:15:44", "text": "我猜是性格使然吧。哦，我摔倒了。"}, {"type": "subtitle", "time": 18957.07, "timestamp": "05:15:57", "text": "总之，我们搞定了。中的一个"}, {"type": "subtitle", "time": 18959.83, "timestamp": "05:15:59", "text": "废墟。我们可能会说“哦，我们”。"}]
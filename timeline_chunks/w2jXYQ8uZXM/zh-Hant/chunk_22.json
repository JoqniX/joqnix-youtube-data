[{"type": "subtitle", "time": 1323.549, "timestamp": "00:22:03", "text": "你好，"}, {"type": "subtitle", "time": 1326.83, "timestamp": "00:22:06", "text": "肯。歡迎來到"}, {"type": "subtitle", "time": 1337.51, "timestamp": "00:22:17", "text": "昨天我們玩了《漫威宿敵》。我當時是不是掛機了（音樂）？所以，我從這裡出發，又回到這裡，在那裡好好休息了一會兒。是的。謝謝。謝謝。謝謝。  然後我們就直接開打了。  呃"}, {"type": "subtitle", "time": 1358.39, "timestamp": "00:22:38", "text": "不。不，不，不，不。我可以看到你"}, {"type": "subtitle", "time": 1360.63, "timestamp": "00:22:40", "text": "傳來的聊天訊息"}]
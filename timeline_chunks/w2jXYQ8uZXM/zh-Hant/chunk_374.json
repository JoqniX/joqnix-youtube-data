[{"type": "subtitle", "time": 22449.67, "timestamp": "06:14:09", "text": "。  我該怎麼做呢？我不知道現在"}, {"type": "subtitle", "time": 22452.67, "timestamp": "06:14:12", "text": "大多數人是否還使用短鏈接，也就是所有品牌鏈接，"}, {"type": "subtitle", "time": 22457.03, "timestamp": "06:14:17", "text": "但我看到一些知名品牌和比較受歡迎的創作者現在都在使用它。"}, {"type": "subtitle", "time": 22460.75, "timestamp": "06:14:20", "text": "不過，你們會使用我的短連結嗎​​？"}, {"type": "subtitle", "time": 22473.67, "timestamp": "06:14:33", "text": "我想，嗯，我想你們"}, {"type": "subtitle", "time": 22483.23, "timestamp": "06:14:43", "text": "大多數人都會這麼想。  是的"}, {"type": "subtitle", "time": 22486.31, "timestamp": "06:14:46", "text": "。是的。是的。你們大多數人都會這麼做。這樣我就可以看到統計數據了。"}]
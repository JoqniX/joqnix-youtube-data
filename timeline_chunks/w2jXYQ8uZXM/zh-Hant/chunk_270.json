[{"type": "subtitle", "time": 16217.75, "timestamp": "04:30:17", "text": "這麼痛？"}, {"type": "subtitle", "time": 16236.189, "timestamp": "04:30:36", "text": "哦，過來一下。我的東西。  我的天哪。"}, {"type": "subtitle", "time": 16246.51, "timestamp": "04:30:46", "text": "我的天哪。還有，你在哪裡？哦，你們"}, {"type": "subtitle", "time": 16251.51, "timestamp": "04:30:51", "text": "行動起來真是神速。這是什麼？這種平台跳躍是"}, {"type": "subtitle", "time": 16257.11, "timestamp": "04:30:57", "text": "怎麼回事？你想拿走什麼嗎？是的，先生。  你們都很棒。是的，我們情況一樣。我希望我們不會再死去"}]
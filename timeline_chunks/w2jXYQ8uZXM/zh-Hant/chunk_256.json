[{"type": "subtitle", "time": 15384.149, "timestamp": "04:16:24", "text": "。順便說一句，它們會造成很大的破壞。是的，他還會再"}, {"type": "subtitle", "time": 15387.03, "timestamp": "04:16:27", "text": "死一次。你要看嗎？我們要看"}, {"type": "subtitle", "time": 15389.87, "timestamp": "04:16:29", "text": "這個嗎？"}, {"type": "subtitle", "time": 15400.389, "timestamp": "04:16:40", "text": "哦，那太好了。我想我可能是唯一一個。  我會幫我的"}, {"type": "subtitle", "time": 15403.59, "timestamp": "04:16:43", "text": "，喬。我馬上"}, {"type": "subtitle", "time": 15408.95, "timestamp": "04:16:48", "text": "過去。不"}]
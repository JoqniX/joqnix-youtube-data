[{"type": "subtitle", "time": 629.509, "timestamp": "00:10:29", "text": "我覺得直播畫面卡頓太嚴重了。啊，沒關係。沒關係。"}, {"type": "subtitle", "time": 631.19, "timestamp": "00:10:31", "text": "等等，真的有"}, {"type": "subtitle", "time": 634.71, "timestamp": "00:10:34", "text": "延遲嗎？我也"}, {"type": "subtitle", "time": 645.11, "timestamp": "00:10:45", "text": "。不錯。"}, {"type": "subtitle", "time": 646.67, "timestamp": "00:10:46", "text": "在"}, {"type": "subtitle", "time": 650.03, "timestamp": "00:10:50", "text": "Chocolate"}]
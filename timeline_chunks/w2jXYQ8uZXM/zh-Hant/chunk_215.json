[{"type": "subtitle", "time": 12910.71, "timestamp": "03:35:10", "text": "？  你養鳥嗎？"}, {"type": "subtitle", "time": 12915.11, "timestamp": "03:35:15", "text": "我的天啊。是啊，"}, {"type": "subtitle", "time": 12919.229, "timestamp": "03:35:19", "text": "我也給你一個。快點。  獲得知識點數。我的天啊。看看阿拉蘇。真是個這樣的建築師"}, {"type": "subtitle", "time": 12956.389, "timestamp": "03:35:56", "text": "快點。過來。欣賞美景。"}, {"type": "subtitle", "time": 12957.91, "timestamp": "03:35:57", "text": "現在的情況就像是在掙扎求生"}]
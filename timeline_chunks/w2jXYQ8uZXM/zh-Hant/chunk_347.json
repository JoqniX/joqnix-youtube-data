[{"type": "subtitle", "time": 20820.31, "timestamp": "05:47:00", "text": "載入遊戲的時候不用保存。是的。是的。如果你直接離開，它就會被保存下來。我的"}, {"type": "subtitle", "time": 20839.868, "timestamp": "05:47:19", "text": "天哪。你好。退出遊戲。  遊戲卡住了。我的天啊。  我的天啊。它在哪裡？"}, {"type": "subtitle", "time": 20844.15, "timestamp": "05:47:24", "text": "別走。  好的。  真是太有趣了。非常有趣。"}, {"type": "subtitle", "time": 20848.07, "timestamp": "05:47:28", "text": "等等，為什麼卡在退出遊"}, {"type": "subtitle", "time": 20860.788, "timestamp": "05:47:40", "text": "戲介面了？為什麼我感覺自己"}, {"type": "subtitle", "time": 20863.27, "timestamp": "05:47:43", "text": "失去了一切？  不，你不會的。這他媽根本不是你的伺服器。這甚至"}, {"type": "subtitle", "time": 20871.67, "timestamp": "05:47:51", "text": "不是你的遊戲。就像，你得救了。是 Arosus。但我卻把"}, {"type": "subtitle", "time": 20874.59, "timestamp": "05:47:54", "text": "這些話說出口了。但我以為他是在打字。  該死的狗。"}, {"type": "subtitle", "time": 20877.99, "timestamp": "05:47:57", "text": "嗯，你還在參賽嗎？不，我辭職了。哦，昨天的直播好像延遲了很久。"}]
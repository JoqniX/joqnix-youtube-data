[{"type": "subtitle", "time": 11888.79, "timestamp": "03:18:08", "text": "海藻去。還有一條"}, {"type": "subtitle", "time": 11893.99, "timestamp": "03:18:13", "text": "魚。  總之，我得做個睡袋才能升級。稍等片刻。  床在哪裡？我"}, {"type": "subtitle", "time": 11896.309, "timestamp": "03:18:16", "text": "解鎖了嗎？對，解鎖"}, {"type": "subtitle", "time": 11900.07, "timestamp": "03:18:20", "text": "。基本套裝。修復石材。床在哪裡？  我"}, {"type": "subtitle", "time": 11913.03, "timestamp": "03:18:33", "text": "升級了。哦，你什麼也沒做。也一樣。  哦，夥計，我得好好鍛鍊一下"}, {"type": "subtitle", "time": 11918.95, "timestamp": "03:18:38", "text": "耐力和精力了。"}]
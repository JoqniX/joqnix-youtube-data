[{"type": "subtitle", "time": 22683.99, "timestamp": "06:18:03", "text": "如果是500日元，550日元，就像300日元，300盧比，之類的。我知道，就像一個日元，我的意思是，等等，一個"}, {"type": "subtitle", "time": 22687.11, "timestamp": "06:18:07", "text": "盧比就像…呃，1.83，83，一個盧比83，對吧？我"}, {"type": "subtitle", "time": 22689.07, "timestamp": "06:18:09", "text": "知道，不，等等，等等，我在說什麼"}, {"type": "subtitle", "time": 22697.27, "timestamp": "06:18:17", "text": "？一個盧比就是一個……呃，"}, {"type": "subtitle", "time": 22702.51, "timestamp": "06:18:22", "text": "我不知道怎麼數點"}, {"type": "subtitle", "time": 22723.628, "timestamp": "06:18:43", "text": "。如果有人在看或在看的話，請寄個"}, {"type": "subtitle", "time": 22728.15, "timestamp": "06:18:48", "text": "棉花糖給我吧。我想看看它是如何運作的。"}, {"type": "subtitle", "time": 22731.39, "timestamp": "06:18:51", "text": "您能好心送"}]
[{"type": "subtitle", "time": 18740.47, "timestamp": "05:12:20", "text": "鯊魚。"}, {"type": "subtitle", "time": 18743.83, "timestamp": "05:12:23", "text": "這是我們身後的胸部。  算了，"}, {"type": "subtitle", "time": 18744.868, "timestamp": "05:12:24", "text": "沒關係。  炸彈。是的，"}, {"type": "subtitle", "time": 18745.91, "timestamp": "05:12:25", "text": "炸彈在那裡。  哦，老闆是食人魚。好吧，沒人"}, {"type": "subtitle", "time": 18761.91, "timestamp": "05:12:41", "text": "狗狗。拜託，夥計。  好的。兩件事。"}, {"type": "subtitle", "time": 18772.948, "timestamp": "05:12:52", "text": "你是打算從底部澆水，還是只從頂部澆水？讓我們從最底層開始。  好的。好的。好的。  你可以來自「是的」。到達"}, {"type": "subtitle", "time": 18779.43, "timestamp": "05:12:59", "text": "頂部並拾取寶箱（如果有的話）。哦，不。最上面一層是boss戰。如果我沒記錯的話，最下面"}]
[{"type": "subtitle", "time": 15781.189, "timestamp": "04:23:01", "text": "他們也是"}, {"type": "subtitle", "time": 15789.03, "timestamp": "04:23:09", "text": "如何？他們怎麼能算是人類呢？他們是魚人。他們不會說中間語言。  真是見鬼了。你們魚會說母語。  我的天啊。請稍等"}, {"type": "subtitle", "time": 15798.63, "timestamp": "04:23:18", "text": "片刻。"}, {"type": "subtitle", "time": 15805.75, "timestamp": "04:23:25", "text": "讓我拿一下。好的，一些金石。  好的。順便說一句，這很不錯。  哦，你們離我們真的很遠。"}, {"type": "subtitle", "time": 15807.55, "timestamp": "04:23:27", "text": "我"}]
[{"type": "subtitle", "time": 4897.43, "timestamp": "01:21:37", "text": "突然間，我不知道"}, {"type": "subtitle", "time": 4899.99, "timestamp": "01:21:39", "text": "主播是不是在跟我說話。不，不，不，不，不，不。當我跟你說話的時候，"}, {"type": "subtitle", "time": 4902.95, "timestamp": "01:21:42", "text": "我會跟你說話。等等，你的名字怎麼讀？  等等，我該如何……我該如何提到你的名字？"}]
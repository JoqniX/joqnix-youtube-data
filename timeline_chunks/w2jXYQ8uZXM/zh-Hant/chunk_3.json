[{"type": "subtitle", "time": 214.99, "timestamp": "00:03:34", "text": "有時我覺得我好像被"}, {"type": "subtitle", "time": 219.43, "timestamp": "00:03:39", "text": "比利比利的袋子壓住了，或者直播出了"}, {"type": "subtitle", "time": 220.82999999999998, "timestamp": "00:03:40", "text": "問題，"}, {"type": "subtitle", "time": 224.589, "timestamp": "00:03:44", "text": "或者我不知道，"}, {"type": "subtitle", "time": 229.22899999999998, "timestamp": "00:03:49", "text": "很快就會有消息了。好的。好的。"}, {"type": "subtitle", "time": 231.949, "timestamp": "00:03:51", "text": "你好。"}, {"type": "subtitle", "time": 235.0, "timestamp": "00:03:55", "text": "早安.你好。你好。歡迎。早安（音樂）"}]
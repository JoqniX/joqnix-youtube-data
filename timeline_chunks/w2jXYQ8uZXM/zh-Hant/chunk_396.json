[{"type": "subtitle", "time": 23761.35, "timestamp": "06:36:01", "text": "嗯，我目前的 OBS 版本裡還"}, {"type": "subtitle", "time": 23765.628, "timestamp": "06:36:05", "text": "沒有這個功能，不過是"}, {"type": "subtitle", "time": 23768.948, "timestamp": "06:36:08", "text": "的。  歡迎來到節目，明安。感謝您加入"}, {"type": "subtitle", "time": 23782.07, "timestamp": "06:36:22", "text": "Discord伺服器。你可能會遇到驗證機器人的"}, {"type": "subtitle", "time": 23788.788, "timestamp": "06:36:28", "text": "麻煩。所以，只需點擊頻道，就像等待進入房間一樣。只需點擊一下，選擇角色，然後驗證身份即可。您將獲得"}, {"type": "subtitle", "time": 23791.548, "timestamp": "06:36:31", "text": "全部權限。 Saka，我發現我的兩個伺服器機器人無法正常工作"}, {"type": "subtitle", "time": 23803.23, "timestamp": "06:36:43", "text": "，我們不得不像…我"}]
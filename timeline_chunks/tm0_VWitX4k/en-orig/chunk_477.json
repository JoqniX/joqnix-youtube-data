[{"type": "subtitle", "time": 28621.51, "timestamp": "07:57:01", "text": "guard our base. Remember, sectors will"}, {"type": "subtitle", "time": 28623.91, "timestamp": "07:57:03", "text": "eventually destabilize, making both"}, {"type": "subtitle", "time": 28628.23, "timestamp": "07:57:08", "text": "sides increasingly easier to capture."}, {"type": "subtitle", "time": 28630.31, "timestamp": "07:57:10", "text": "For this mission, operator restrictions"}, {"type": "subtitle", "time": 28636.468, "timestamp": "07:57:16", "text": "Unit sizes have been increased to six,"}, {"type": "subtitle", "time": 28638.23, "timestamp": "07:57:18", "text": "and operators are cleared for"}, {"type": "subtitle", "time": 28640.948, "timestamp": "07:57:20", "text": "redeployment in the event of casualties"}, {"type": "subtitle", "time": 28650.15, "timestamp": "07:57:30", "text": "This is a live combat zone, so be"}, {"type": "subtitle", "time": 28652.07, "timestamp": "07:57:32", "text": "prepared for secondary assignments in"}, {"type": "subtitle", "time": 28654.23, "timestamp": "07:57:34", "text": "the neutral sector. Assignments will"}, {"type": "subtitle", "time": 28656.548, "timestamp": "07:57:36", "text": "provide powerful assets that can shift"}, {"type": "subtitle", "time": 28658.868, "timestamp": "07:57:38", "text": "the tide of battle. Complete them"}, {"type": "subtitle", "time": 28661.83, "timestamp": "07:57:41", "text": "whenever possible."}, {"type": "subtitle", "time": 28663.99, "timestamp": "07:57:43", "text": "Dual Front will be unlike any challenge"}, {"type": "subtitle", "time": 28666.628, "timestamp": "07:57:46", "text": "you've faced before. So, be ready for"}, {"type": "subtitle", "time": 28669.19, "timestamp": "07:57:49", "text": "anything."}, {"type": "subtitle", "time": 28671.67, "timestamp": "07:57:51", "text": "Stand strong."}, {"type": "subtitle", "time": 28674.548, "timestamp": "07:57:54", "text": "Stand together. We're counting on you,"}, {"type": "subtitle", "time": 28677.27, "timestamp": "07:57:57", "text": "Alpha team."}]
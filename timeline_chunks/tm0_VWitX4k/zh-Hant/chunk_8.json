[{"type": "subtitle", "time": 480.07, "timestamp": "00:08:00", "text": "直播之類的。我一直在"}, {"type": "subtitle", "time": 484.07, "timestamp": "00:08:04", "text": "直播，但我安排直播的時間非常非常糟糕"}, {"type": "subtitle", "time": 487.189, "timestamp": "00:08:07", "text": "。所以，我覺得我大概"}, {"type": "subtitle", "time": 490.629, "timestamp": "00:08:10", "text": "每三週到一個月直播一次，想直播的時候就直播。我之前在 Sushi 或 Renee 那裡做過一次"}, {"type": "subtitle", "time": 497.589, "timestamp": "00:08:17", "text": "直播。是的，那是很久"}, {"type": "subtitle", "time": 499.83, "timestamp": "00:08:19", "text": "以前的事了。  我說，大概就是幾天前的事吧。  啊，"}, {"type": "subtitle", "time": 504.39, "timestamp": "00:08:24", "text": "不錯。"}, {"type": "subtitle", "time": 506.469, "timestamp": "00:08:26", "text": "我們本來打算玩《虹彩六號：圍攻行動》，但他們更新了，所以"}, {"type": "subtitle", "time": 508.23, "timestamp": "00:08:28", "text": "我們最後玩了《遊戲王》的直播"}, {"type": "subtitle", "time": 510.55, "timestamp": "00:08:30", "text": "。  我還在下載《虹彩六號：圍攻行動》。是啊，"}, {"type": "subtitle", "time": 519.11, "timestamp": "00:08:39", "text": "下載量有點大。  是啊，它太火了，我"}, {"type": "subtitle", "time": 526.07, "timestamp": "00:08:46", "text": "記得很久以前就買過《虹彩六號：圍攻行動》。"}, {"type": "subtitle", "time": 529.59, "timestamp": "00:08:49", "text": "我不知道。我不"}, {"type": "subtitle", "time": 531.99, "timestamp": "00:08:51", "text": "記得是什麼時候了。感覺就像Epic Games給了它"}, {"type": "subtitle", "time": 534.07, "timestamp": "00:08:54", "text": "一個優惠。於是我"}, {"type": "subtitle", "time": 537.59, "timestamp": "00:08:57", "text": "就想，「好吧，我一定要得到它。」"}, {"type": "subtitle", "time": 539.67, "timestamp": "00:08:59", "text": "你知道，在我拿到帳號之後，"}]
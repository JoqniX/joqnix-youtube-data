[{"type": "subtitle", "time": 42150.15, "timestamp": "11:42:30", "text": "挑戰。  競技場。競技場。  好的。  這是給你的。這是給你的。"}, {"type": "subtitle", "time": 42166.31, "timestamp": "11:42:46", "text": "我有點"}, {"type": "subtitle", "time": 42169.35, "timestamp": "11:42:49", "text": "戰利品。  該死。真噁心，對吧？  可惡的。  可惡的。  [音樂] 開始。  你真討厭，對吧？  你既壞又好。你真噁心"}, {"type": "subtitle", "time": 42179.906, "timestamp": "11:42:59", "text": "，真討厭。  我喜歡。我喜歡。我喜歡。  糟糕。"}]
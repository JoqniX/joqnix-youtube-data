[{"type": "subtitle", "time": 2161.19, "timestamp": "00:36:01", "text": "壽司關係很鐵。  我相當多。是啊，那挺好的。"}, {"type": "subtitle", "time": 2165.109, "timestamp": "00:36:05", "text": "而"}, {"type": "subtitle", "time": 2172.79, "timestamp": "00:36:12", "text": "我覺得在那個時候，是的，在…期間。不過，這個月我確實和她"}, {"type": "subtitle", "time": 2192.39, "timestamp": "00:36:32", "text": "合作了一次，所以我們選了一些遊戲"}, {"type": "subtitle", "time": 2195.109, "timestamp": "00:36:35", "text": "之類的東西，但我們只是聊了聊。  確實如此。  等等，呃，你也玩過CS:GO嗎？"}, {"type": "subtitle", "time": 2197.91, "timestamp": "00:36:37", "text": "嗯，我有。哦，我玩過，但我不是CS:GO的忠實粉絲。"}, {"type": "subtitle", "time": 2205.19, "timestamp": "00:36:45", "text": "我喜歡我們現在的樣子，但現在也許是因為我是黨魁之類的原因吧。"}, {"type": "subtitle", "time": 2208.47, "timestamp": "00:36:48", "text": "我覺得思科挺有意思的，但"}, {"type": "subtitle", "time": 2218.069, "timestamp": "00:36:58", "text": "不太符合我的風格。  是眼睛嗎？我想只是因為我需要一些更……"}]
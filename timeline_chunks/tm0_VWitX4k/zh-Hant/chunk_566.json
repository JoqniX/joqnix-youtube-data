[{"type": "subtitle", "time": 33990.31, "timestamp": "09:26:30", "text": "，"}, {"type": "subtitle", "time": 33992.23, "timestamp": "09:26:32", "text": "我需要不停地努力、努力、努力。  我需要努力奮鬥。  疼痛。  我需要升六級。"}, {"type": "subtitle", "time": 34003.11, "timestamp": "09:26:43", "text": "好的，人造絲。嗯，昨天早上五、六點我在乍得沒看到你。"}, {"type": "subtitle", "time": 34011.906, "timestamp": "09:26:51", "text": "我還以為你睡著了"}]
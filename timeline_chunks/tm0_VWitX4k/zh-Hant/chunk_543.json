[{"type": "subtitle", "time": 32589.99, "timestamp": "09:03:09", "text": "，讓我，"}, {"type": "subtitle", "time": 32593.75, "timestamp": "09:03:13", "text": "讓我給自己一些時間。  我還沒吃飯。兄弟"}, {"type": "subtitle", "time": 32595.83, "timestamp": "09:03:15", "text": "，為什麼總是失手？快點"}, {"type": "subtitle", "time": 32605.99, "timestamp": "09:03:25", "text": "。  你是人類。去"}, {"type": "subtitle", "time": 32637.59, "timestamp": "09:03:57", "text": "我該親自去餵你吃嗎？  要不要我餵你吃東西，笨蛋？"}]
[{"type": "subtitle", "time": 181.99, "timestamp": "00:03:01", "text": "逃避並不能起到太大作用。好的？如果你"}, {"type": "subtitle", "time": 184.63, "timestamp": "00:03:04", "text": "看到這訊息，請不要與人有眼神交流。"}, {"type": "subtitle", "time": 188.63, "timestamp": "00:03:08", "text": "不要奔跑，不要發出任何噪音。好的？"}, {"type": "subtitle", "time": 190.39, "timestamp": "00:03:10", "text": "由於沒有人"}, {"type": "subtitle", "time": 192.55, "timestamp": "00:03:12", "text": "拍到該實體的照片，以下"}, {"type": "subtitle", "time": 194.63, "timestamp": "00:03:14", "text": "圖紙是根據幾份"}, {"type": "subtitle", "time": 197.19, "timestamp": "00:03:17", "text": "證詞繪製的。"}, {"type": "subtitle", "time": 199.35, "timestamp": "00:03:19", "text": "如果看到這種情況，不要與對方有眼神交流。"}, {"type": "subtitle", "time": 202.55, "timestamp": "00:03:22", "text": "不要跑。"}, {"type": "subtitle", "time": 205.589, "timestamp": "00:03:25", "text": "不要發出聲音。  是的"}, {"type": "subtitle", "time": 210.149, "timestamp": "00:03:30", "text": "，我相信你。好的，我們開始吧。我"}, {"type": "subtitle", "time": 212.55, "timestamp": "00:03:32", "text": "不知道。我們要去哪裡？這是怎麼"}, {"type": "subtitle", "time": 218.22899999999998, "timestamp": "00:03:38", "text": "。好的。不，不，別"}, {"type": "subtitle", "time": 224.07, "timestamp": "00:03:44", "text": "去那裡。  好的。他喜歡黑暗。我們還是別談這個了。"}, {"type": "subtitle", "time": 225.82999999999998, "timestamp": "00:03:45", "text": "Joker前輩。快點。哦，等等。"}, {"type": "subtitle", "time": 228.55, "timestamp": "00:03:48", "text": "這邊走，對吧？這個。這邊走"}, {"type": "subtitle", "time": 232.47, "timestamp": "00:03:52", "text": "。  這邊走。這邊走。好的。"}, {"type": "subtitle", "time": 233.43, "timestamp": "00:03:53", "text": "哦，有東西。那我們該怎麼"}, {"type": "subtitle", "time": 235.03, "timestamp": "00:03:55", "text": "辦？好像有"}, {"type": "subtitle", "time": 238.309, "timestamp": "00:03:58", "text": "聲音傳來。我認為我們應該"}]
[{"type": "subtitle", "time": 5051.51, "timestamp": "01:24:11", "text": "好的。好的。我被一個家人踩在了身上。好的。  脈搏穩定。"}, {"type": "subtitle", "time": 5063.59, "timestamp": "01:24:23", "text": "哦，別在"}, {"type": "subtitle", "time": 5066.629, "timestamp": "01:24:26", "text": "椅子上坐得太重。所以，"}, {"type": "subtitle", "time": 5071.83, "timestamp": "01:24:31", "text": "我覺得我們目前走的就是這條路。啊，接下來"}, {"type": "subtitle", "time": 5073.669, "timestamp": "01:24:33", "text": "我們就能在《玩具"}]
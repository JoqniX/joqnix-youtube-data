[{"type": "subtitle", "time": 423.589, "timestamp": "00:07:03", "text": "公主，然後我"}, {"type": "subtitle", "time": 426.07, "timestamp": "00:07:06", "text": "的遊戲 ID 曾經是 Westable 之類的，"}, {"type": "subtitle", "time": 430.71, "timestamp": "00:07:10", "text": "但後來，你知道，"}, {"type": "subtitle", "time": 434.15, "timestamp": "00:07:14", "text": "我真的很喜歡放屁，結果就成了我和我前任之間的一個"}, {"type": "subtitle", "time": 436.71, "timestamp": "00:07:16", "text": "綽號，"}, {"type": "subtitle", "time": 439.189, "timestamp": "00:07:19", "text": "因為我真的很喜歡鹹的"}, {"type": "subtitle", "time": 441.83, "timestamp": "00:07:21", "text": "食物，也喜歡放屁，你知道，所以我最後就叫自己咸屁，"}, {"type": "subtitle", "time": 443.83, "timestamp": "00:07:23", "text": "然後這個綽號就一直被"}, {"type": "subtitle", "time": 449.11, "timestamp": "00:07:29", "text": "大家記住了。現在它變鹹了。可惜"}, {"type": "subtitle", "time": 450.469, "timestamp": "00:07:30", "text": "大家都覺得我愛抱怨。  鹹"}, {"type": "subtitle", "time": 457.27, "timestamp": "00:07:37", "text": "。真是個好聽的名字。是的。我的意思是"}, {"type": "subtitle", "time": 460.71, "timestamp": "00:07:40", "text": "，它也很獨特。我想應該"}, {"type": "subtitle", "time": 462.95, "timestamp": "00:07:42", "text": "沒有人跟我取過這樣的名字吧？"}, {"type": "subtitle", "time": 466.79, "timestamp": "00:07:46", "text": "查一下。我知道。我是一個自由思想者，"}, {"type": "subtitle", "time": 470.23, "timestamp": "00:07:50", "text": "你知道的。非常有創意。  是的。"}, {"type": "subtitle", "time": 473.589, "timestamp": "00:07:53", "text": "好的。"}, {"type": "subtitle", "time": 475.67, "timestamp": "00:07:55", "text": "呃，你一定沒看過YouTube。你"}, {"type": "subtitle", "time": 477.43, "timestamp": "00:07:57", "text": "提到你最近沒有"}]
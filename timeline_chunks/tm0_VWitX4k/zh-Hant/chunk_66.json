[{"type": "subtitle", "time": 3969.19, "timestamp": "01:06:09", "text": "我不明白為什麼它會這麼大？  大家都"}, {"type": "subtitle", "time": 3974.95, "timestamp": "01:06:14", "text": "喜歡"}, {"type": "subtitle", "time": 3977.109, "timestamp": "01:06:17", "text": "射擊遊戲嗎？  嗯，是的，嗯，這些遊戲通常會安裝在你的網咖裡，就像啊，哦，有人，有人在玩那個強盜"}, {"type": "subtitle", "time": 3990.23, "timestamp": "01:06:30", "text": "遊戲。  我像個遊戲玩家。確認全隊都受到濺射效果影響。  是的，我想要那個。一半的"}]
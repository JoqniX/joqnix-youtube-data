[{"type": "subtitle", "time": 5116.07, "timestamp": "01:25:16", "text": "所以你就能明白，就像《"}, {"type": "subtitle", "time": 5118.95, "timestamp": "01:25:18", "text": "Dead by Dead》這首歌是關於什麼的。"}, {"type": "subtitle", "time": 5121.59, "timestamp": "01:25:21", "text": "嗯，我只知道這有點像捉迷藏"}, {"type": "subtitle", "time": 5124.55, "timestamp": "01:25:24", "text": "。有個殺手，你躲避他，"}, {"type": "subtitle", "time": 5127.669, "timestamp": "01:25:27", "text": "被困在"}, {"type": "subtitle", "time": 5130.07, "timestamp": "01:25:30", "text": "操場之類的地方。"}, {"type": "subtitle", "time": 5132.87, "timestamp": "01:25:32", "text": "呃，所以有四個倖存者"}, {"type": "subtitle", "time": 5135.03, "timestamp": "01:25:35", "text": "和一個殺手，"}, {"type": "subtitle", "time": 5138.149, "timestamp": "01:25:38", "text": "殺手的目標是殺死倖存者，"}, {"type": "subtitle", "time": 5140.55, "timestamp": "01:25:40", "text": "或者倖存者的目標是逃脫。所以我們必須解決這個問題，因為"}, {"type": "subtitle", "time": 5142.47, "timestamp": "01:25:42", "text": "我們是倖存者，因為我們要"}, {"type": "subtitle", "time": 5144.709, "timestamp": "01:25:44", "text": "扮演倖存者。呃，我們得"}, {"type": "subtitle", "time": 5148.87, "timestamp": "01:25:48", "text": "修理發電機。呃，我們得想辦法避開兇手"}, {"type": "subtitle", "time": 5151.11, "timestamp": "01:25:51", "text": "。我們基本上就是想辦法逃出去[音樂]，避免被殺手殺死。  兇手的全部"}, {"type": "subtitle", "time": 5159.75, "timestamp": "01:25:59", "text": "目的就是"}]
[{"type": "subtitle", "time": 4861.189, "timestamp": "01:21:01", "text": "我的錯。不，確實如此。不，確實如此。  我們盡力了"}, {"type": "subtitle", "time": 4868.229, "timestamp": "01:21:08", "text": "我們做得很好。"}, {"type": "subtitle", "time": 4870.63, "timestamp": "01:21:10", "text": "好的。嗯，現在時間是"}, {"type": "subtitle", "time": 4873.59, "timestamp": "01:21:13", "text": "12:57。你想完成嗎？呃，"}, {"type": "subtitle", "time": 4875.91, "timestamp": "01:21:15", "text": "你想玩《黎明死線》嗎？"}, {"type": "subtitle", "time": 4877.91, "timestamp": "01:21:17", "text": "當然可以。"}, {"type": "subtitle", "time": 4907.91, "timestamp": "01:21:47", "text": "我覺得應該要有跨界合作吧？"}, {"type": "subtitle", "time": 4911.99, "timestamp": "01:21:51", "text": "嗯。我還沒有做過史詩般的事情。  一切都很好"}, {"type": "subtitle", "time": 4913.59, "timestamp": "01:21:53", "text": "。我覺得"}, {"type": "subtitle", "time": 4916.09, "timestamp": "01:21:56", "text": "我必須透過這個方式把你加進去。"}, {"type": "subtitle", "time": 4917.27, "timestamp": "01:21:57", "text": "[音樂]"}, {"type": "subtitle", "time": 4918.55, "timestamp": "01:21:58", "text": "沒錯。是的，它完全"}]
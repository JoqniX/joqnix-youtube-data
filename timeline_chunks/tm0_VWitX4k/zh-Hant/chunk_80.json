[{"type": "subtitle", "time": 4805.51, "timestamp": "01:20:05", "text": "幾天。  是的。今晚"}, {"type": "subtitle", "time": 4808.07, "timestamp": "01:20:08", "text": "你跟我回家"}, {"type": "subtitle", "time": 4810.709, "timestamp": "01:20:10", "text": "。結果我們得到了三個而不是兩個。  因為我知道我還能再"}, {"type": "subtitle", "time": 4818.229, "timestamp": "01:20:18", "text": "拿到一個，所以我打算"}, {"type": "subtitle", "time": 4821.189, "timestamp": "01:20:21", "text": "試試看能不能拿到一個瞄準鏡。  好的。"}, {"type": "subtitle", "time": 4823.27, "timestamp": "01:20:23", "text": "好的。  這邊"}, {"type": "subtitle", "time": 4834.709, "timestamp": "01:20:34", "text": "我們可以，我們可以戰鬥。我們可以，我們可以"}, {"type": "subtitle", "time": 4838.149, "timestamp": "01:20:38", "text": "戰鬥。我可以做這邊的這件事。"}, {"type": "subtitle", "time": 4844.31, "timestamp": "01:20:44", "text": "後退。哦，該死。它們都裂了嗎？而且價格都"}, {"type": "subtitle", "time": 4847.59, "timestamp": "01:20:47", "text": "很低嗎？"}, {"type": "subtitle", "time": 4851.189, "timestamp": "01:20:51", "text": "一切療癒都源自於此。敵人就在這裡。"}]
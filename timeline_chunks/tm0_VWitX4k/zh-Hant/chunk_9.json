[{"type": "subtitle", "time": 543.67, "timestamp": "00:09:03", "text": "我的 Everoft 帳號被盜了，"}, {"type": "subtitle", "time": 546.79, "timestamp": "00:09:06", "text": "有個駭客入侵了《虹彩六號：圍攻行動》，"}, {"type": "subtitle", "time": 550.07, "timestamp": "00:09:10", "text": "贏了大概 100 場遊戲，然後我的帳號就被封了，我當時就想"}, {"type": "subtitle", "time": 553.03, "timestamp": "00:09:13", "text": "，"}, {"type": "subtitle", "time": 555.75, "timestamp": "00:09:15", "text": "「哇」。"}, {"type": "subtitle", "time": 560.389, "timestamp": "00:09:20", "text": "好吧，至少現在是免費的。是的。"}, {"type": "subtitle", "time": 564.31, "timestamp": "00:09:24", "text": "它終於免費了，"}, {"type": "subtitle", "time": 567.269, "timestamp": "00:09:27", "text": "但我還沒試過。嗯，"}, {"type": "subtitle", "time": 571.11, "timestamp": "00:09:31", "text": "你試過嗎？你試過嗎？"}, {"type": "subtitle", "time": 574.79, "timestamp": "00:09:34", "text": "玩了什麼？呃，圍攻。圍城。圍城。"}, {"type": "subtitle", "time": 578.79, "timestamp": "00:09:38", "text": "哦，那是我的 f 我"}, {"type": "subtitle", "time": 581.91, "timestamp": "00:09:41", "text": "我已經伸手去拿 呃 圍攻了。我"}, {"type": "subtitle", "time": 585.03, "timestamp": "00:09:45", "text": "連續三個賽季都拿了冠軍。在冠軍模式推出之前我就拿到鑽石了"}, {"type": "subtitle", "time": 586.949, "timestamp": "00:09:46", "text": "。我玩這個遊戲大概有"}, {"type": "subtitle", "time": 590.15, "timestamp": "00:09:50", "text": "800小時了。我"}, {"type": "subtitle", "time": 592.389, "timestamp": "00:09:52", "text": "高中時常玩這個遊戲，"}, {"type": "subtitle", "time": 594.389, "timestamp": "00:09:54", "text": "但自從我發現了《"}, {"type": "subtitle", "time": 596.87, "timestamp": "00:09:56", "text": "Valerant》之後就很少玩了，現在我玩得很爛。"}, {"type": "subtitle", "time": 599.829, "timestamp": "00:09:59", "text": "[音樂]"}]
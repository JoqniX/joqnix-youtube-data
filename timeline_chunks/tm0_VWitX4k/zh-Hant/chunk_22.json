[{"type": "subtitle", "time": 1324.87, "timestamp": "00:22:04", "text": "[音樂] 是啊。是啊，前幾天我還在抱怨這件事，你知道，"}, {"type": "subtitle", "time": 1344.23, "timestamp": "00:22:24", "text": "他們沒有給沃森出尊享肌膚，但其他角色都有。"}, {"type": "subtitle", "time": 1349.51, "timestamp": "00:22:29", "text": "我看到了，她要買一個。"}, {"type": "subtitle", "time": 1350.87, "timestamp": "00:22:30", "text": "我太激動了。  哦，是的"}, {"type": "subtitle", "time": 1357.43, "timestamp": "00:22:37", "text": "。還有，請問你擅長玩這個"}, {"type": "subtitle", "time": 1360.95, "timestamp": "00:22:40", "text": "遊戲嗎？  我沒事。  就像遊戲最火紅的時候，我達到了鑽石段位，但也就僅此而已了。然後，"}]
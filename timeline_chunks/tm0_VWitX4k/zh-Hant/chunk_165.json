[{"type": "subtitle", "time": 9901.349, "timestamp": "02:45:01", "text": "我也有桌上型電腦，不過現在沒有。 H筆記型電腦是我想要的，我本來想"}, {"type": "subtitle", "time": 9908.309, "timestamp": "02:45:08", "text": "買一台筆記型"}, {"type": "subtitle", "time": 9911.03, "timestamp": "02:45:11", "text": "電腦，然後我意識到，呃，是的，現在東西太多了。是的，它比較便攜，但性能不太強"}, {"type": "subtitle", "time": 9915.429, "timestamp": "02:45:15", "text": "。  那也太肯定了。哦，是的，"}, {"type": "subtitle", "time": 9923.429, "timestamp": "02:45:23", "text": "學院的人就像我一樣，我告訴他們，嗯，因為我打算從日本買筆記型"}, {"type": "subtitle", "time": 9925.269, "timestamp": "02:45:25", "text": "電腦之類的東西。嗯，是的，他們會說我們時不時會有人從日本來印度，所以我們可以安排人從那裡幫你買筆記型電腦，然後"}, {"type": "subtitle", "time": 9935.75, "timestamp": "02:45:35", "text": "帶過來，這樣我就可以把一切都設置好了。"}, {"type": "subtitle", "time": 9946.07, "timestamp": "02:45:46", "text": "是啊，我當時就想，我的天哪，那對我幫助太大了，真的太好了。我"}, {"type": "subtitle", "time": 9952.389, "timestamp": "02:45:52", "text": "最初的計劃是"}, {"type": "subtitle", "time": 9955.19, "timestamp": "02:45:55", "text": "現在把我的硬碟，像是固態硬碟，帶上，然後把它"}]
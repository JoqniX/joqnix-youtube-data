[{"type": "subtitle", "time": 1938.71, "timestamp": "00:32:18", "text": "呃，"}, {"type": "subtitle", "time": 1941.11, "timestamp": "00:32:21", "text": "好的。所以，這就像東南亞那邊的情況。  所以，他們"}, {"type": "subtitle", "time": 1942.23, "timestamp": "00:32:22", "text": "更換了伺服器。所以，現在有東南亞一號、東南亞二號，還有EA EU。他們基本上把所有人都推到了一起"}, {"type": "subtitle", "time": 1973.909, "timestamp": "00:32:53", "text": "請問為什麼顯示此帳號不允許"}]
[{"type": "subtitle", "time": 602.389, "timestamp": "00:10:02", "text": "是的，Valerant 很有趣，但是，是的，我玩"}, {"type": "subtitle", "time": 604.949, "timestamp": "00:10:04", "text": "不懂它。感覺有點慢，"}, {"type": "subtitle", "time": 608.07, "timestamp": "00:10:08", "text": "因為我以前常玩Apex，雖然我玩得很爛。"}, {"type": "subtitle", "time": 611.43, "timestamp": "00:10:11", "text": "我最後也"}, {"type": "subtitle", "time": 615.67, "timestamp": "00:10:15", "text": "安裝了Valer。這是。  情況變得"}, {"type": "subtitle", "time": 617.35, "timestamp": "00:10:17", "text": "非常糟糕。我會連續報道。  Valerant 是"}, {"type": "subtitle", "time": 619.19, "timestamp": "00:10:19", "text": "一款不錯的遊戲，剛開始玩的時候，"}, {"type": "subtitle", "time": 621.19, "timestamp": "00:10:21", "text": "遊戲剛推出的時候就玩了。  嗯，我"}, {"type": "subtitle", "time": 623.829, "timestamp": "00:10:23", "text": "玩過很多次。"}, {"type": "subtitle", "time": 630.31, "timestamp": "00:10:30", "text": "從 2020 年到現在，我玩這款遊戲的時間大概有 4000 小時了。我的天。"}, {"type": "subtitle", "time": 631.67, "timestamp": "00:10:31", "text": "那真是不少，你知道，就像"}, {"type": "subtitle", "time": 633.75, "timestamp": "00:10:33", "text": "我當時在玩的遊戲一樣。但後來，他們不斷地"}, {"type": "subtitle", "time": 635.99, "timestamp": "00:10:35", "text": "增加東西，結果就有點過載了，"}, {"type": "subtitle", "time": 640.15, "timestamp": "00:10:40", "text": "他們稱之為「過載」"}, {"type": "subtitle", "time": 641.59, "timestamp": "00:10:41", "text": "。但他們不想採取任何行動。所以"}, {"type": "subtitle", "time": 643.67, "timestamp": "00:10:43", "text": "我就想，我不太想玩那種能力過強而讓我感到力不從心的遊戲。所以，我"}, {"type": "subtitle", "time": 644.79, "timestamp": "00:10:44", "text": "選擇玩"}, {"type": "subtitle", "time": 649.11, "timestamp": "00:10:49", "text": "充滿各種"}, {"type": "subtitle", "time": 651.07, "timestamp": "00:10:51", "text": "技能的遊戲，你知道的。"}, {"type": "subtitle", "time": 653.11, "timestamp": "00:10:53", "text": "[音樂]"}, {"type": "subtitle", "time": 655.43, "timestamp": "00:10:55", "text": "所以現在，是的，這就是我經常玩和"}, {"type": "subtitle", "time": 658.55, "timestamp": "00:10:58", "text": "直播的遊戲。"}]
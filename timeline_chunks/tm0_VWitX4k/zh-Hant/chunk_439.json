[{"type": "subtitle", "time": 26352.15, "timestamp": "07:19:12", "text": "的訂閱源。  只有我才能重置速度。  難的。  這"}, {"type": "subtitle", "time": 26366.39, "timestamp": "07:19:26", "text": "是什麼？  啊，等等。為什麼我現在也在刷推特？"}, {"type": "subtitle", "time": 26386.948, "timestamp": "07:19:46", "text": "我的意思是，我挺喜歡這種藝術的，但現在對我來說不太適合。  [音樂] 我真的不知道。  [音樂] 哦，"}, {"type": "subtitle", "time": 26393.67, "timestamp": "07:19:53", "text": "什麼？  很多人會說：「你好，"}, {"type": "subtitle", "time": 26398.39, "timestamp": "07:19:58", "text": "Zarasa，歡迎光臨。你好嗎"}]
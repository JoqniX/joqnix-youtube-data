[{"type": "subtitle", "time": 15252.63, "timestamp": "04:14:12", "text": "什麼？  這些皮膚不會破壞動畫效果。  確實如此。是的，我剛看到。  升級確實能為你帶來一些不錯的收益。  我重生"}, {"type": "subtitle", "time": 15259.51, "timestamp": "04:14:19", "text": "殺戮。"}, {"type": "subtitle", "time": 15283.429, "timestamp": "04:14:43", "text": "音樂是一回事，對吧？  哦。啊。  就"}, {"type": "subtitle", "time": 15287.429, "timestamp": "04:14:47", "text": "差一點。  哦，它很特別。"}, {"type": "subtitle", "time": 15293.51, "timestamp": "04:14:53", "text": "嗯？我的乒乓球碗被人下藥了。  為什麼我"}]
[{"type": "subtitle", "time": 5400.629, "timestamp": "01:30:00", "text": "，對吧？你必須把握好時機。"}, {"type": "subtitle", "time": 5402.79, "timestamp": "01:30:02", "text": "哦，是的。是的。大量的"}, {"type": "subtitle", "time": 5409.189, "timestamp": "01:30:09", "text": "你不必非得拿到白色的那部分"}, {"type": "subtitle", "time": 5412.59, "timestamp": "01:30:12", "text": "。你只需要拿到那句話。"}, {"type": "subtitle", "time": 5428.149, "timestamp": "01:30:28", "text": "修理末級發電機。"}, {"type": "subtitle", "time": 5430.07, "timestamp": "01:30:30", "text": "你被抓住了。"}, {"type": "subtitle", "time": 5438.39, "timestamp": "01:30:38", "text": "哦，那些殺人信。是啊，但是"}, {"type": "subtitle", "time": 5441.75, "timestamp": "01:30:41", "text": "我的天。找到兇手了。是的。所以"}, {"type": "subtitle", "time": 5443.51, "timestamp": "01:30:43", "text": "這個殺手……這向"}, {"type": "subtitle", "time": 5445.59, "timestamp": "01:30:45", "text": "你展示了殺手能做什麼"}, {"type": "subtitle", "time": 5447.27, "timestamp": "01:30:47", "text": "等等。"}]
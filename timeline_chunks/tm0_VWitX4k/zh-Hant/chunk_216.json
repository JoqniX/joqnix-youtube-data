[{"type": "subtitle", "time": 12969.75, "timestamp": "03:36:09", "text": "遊戲，"}, {"type": "subtitle", "time": 12975.83, "timestamp": "03:36:15", "text": "登山角色扮演遊戲，asmmetric 8 v1，這很"}, {"type": "subtitle", "time": 12981.83, "timestamp": "03:36:21", "text": "合理。  他們被鎖在後面的房間。"}, {"type": "subtitle", "time": 12986.87, "timestamp": "03:36:26", "text": "我的天哪，他們有"}, {"type": "subtitle", "time": 12988.389, "timestamp": "03:36:28", "text": "很多遊戲啊。他們甚至還設法弄到了"}, {"type": "subtitle", "time": 13003.99, "timestamp": "03:36:43", "text": "就像我之前在"}, {"type": "subtitle", "time": 13006.15, "timestamp": "03:36:46", "text": "Roblox 上玩那個遊戲的時候，它和原版遊戲一樣，但後來好像被 Roblox 下架了。哦，他們"}, {"type": "subtitle", "time": 13014.15, "timestamp": "03:36:54", "text": "又做了一個，型號什麼的都不一樣。"}, {"type": "subtitle", "time": 13016.469, "timestamp": "03:36:56", "text": "但它看起來確實和"}]
[{"type": "subtitle", "time": 22268.15, "timestamp": "06:11:08", "text": "我需要那個東西。"}, {"type": "subtitle", "time": 22284.39, "timestamp": "06:11:24", "text": "嘿，放開我。我的天啊。不。哦，我也沒辦法殺了他。還有，"}, {"type": "subtitle", "time": 22300.4, "timestamp": "06:11:40", "text": "為什麼我會滑行，而且無法停止滑行？"}, {"type": "subtitle", "time": 22308.23, "timestamp": "06:11:48", "text": "是什麼聲音"}, {"type": "subtitle", "time": 22310.948, "timestamp": "06:11:50", "text": "？  我"}]
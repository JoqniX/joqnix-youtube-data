[{"type": "subtitle", "time": 15600.55, "timestamp": "04:20:00", "text": "50歳ですよね？"}, {"type": "subtitle", "time": 15603.11, "timestamp": "04:20:03", "text": "あなたには"}, {"type": "subtitle", "time": 15606.229, "timestamp": "04:20:06", "text": "俺は核攻撃がめちゃくちゃしたいんだよ。うん、君"}, {"type": "subtitle", "time": 15636.79, "timestamp": "04:20:36", "text": "ジェイコブ、お前の家族を狙うぞ"}, {"type": "subtitle", "time": 15640.309, "timestamp": "04:20:40", "text": "後で。何？"}, {"type": "subtitle", "time": 15651.03, "timestamp": "04:20:51", "text": "おお。ああ。そこから私の命を奪ったんだ。"}]
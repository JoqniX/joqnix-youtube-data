[{"type": "subtitle", "time": 9068.23, "timestamp": "02:31:08", "text": "マンロックはあなたたち全員をあなたの"}, {"type": "subtitle", "time": 9070.46, "timestamp": "02:31:10", "text": "死。"}, {"type": "subtitle", "time": 9072.95, "timestamp": "02:31:12", "text": "[音楽]"}, {"type": "subtitle", "time": 9096.309, "timestamp": "02:31:36", "text": "その通りです。私がすべきことは、"}, {"type": "subtitle", "time": 9098.95, "timestamp": "02:31:38", "text": "するべきことは"}, {"type": "subtitle", "time": 9102.23, "timestamp": "02:31:42", "text": "実際、もうお腹いっぱいという感じがする。いいえ、私は"}, {"type": "subtitle", "time": 9105.83, "timestamp": "02:31:45", "text": "満腹です。それで、"}, {"type": "subtitle", "time": 9110.309, "timestamp": "02:31:50", "text": "ある意味、私の一部は"}, {"type": "subtitle", "time": 9112.55, "timestamp": "02:31:52", "text": "実際にこれらを売ってお金を稼ぐが、"}, {"type": "subtitle", "time": 9114.55, "timestamp": "02:31:54", "text": "どうやら"}, {"type": "subtitle", "time": 9118.15, "timestamp": "02:31:58", "text": "私はできません。大丈夫。"}]
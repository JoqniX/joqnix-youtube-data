[{"type": "subtitle", "time": 4260.229, "timestamp": "01:11:00", "text": "彼らは何をしているのか。今はまるで"}, {"type": "subtitle", "time": 4263.35, "timestamp": "01:11:03", "text": "それは動きのようなもので、タップダンスのようなものです。おお"}, {"type": "subtitle", "time": 4265.11, "timestamp": "01:11:05", "text": "我が神よ。"}, {"type": "subtitle", "time": 4268.229, "timestamp": "01:11:08", "text": "ああ、まるでぬるぬるしてるみたいだよ。よくやった"}, {"type": "subtitle", "time": 4272.709, "timestamp": "01:11:12", "text": "私のようなダイヤモンドと一緒に。痛み。"}, {"type": "subtitle", "time": 4274.47, "timestamp": "01:11:14", "text": "これでシールドを付与できると思う。"}, {"type": "subtitle", "time": 4277.669, "timestamp": "01:11:17", "text": "うん、行くよ。"}, {"type": "subtitle", "time": 4280.39, "timestamp": "01:11:20", "text": "あなたは約束しなければならない。あなたがそうできることを願っています"}, {"type": "subtitle", "time": 4304.31, "timestamp": "01:11:44", "text": "私はジャンプマスターです。ここに留まりましょう"}, {"type": "subtitle", "time": 4306.07, "timestamp": "01:11:46", "text": "一緒に。"}, {"type": "subtitle", "time": 4308.95, "timestamp": "01:11:48", "text": "私はジャンプマスターです"}, {"type": "subtitle", "time": 4311.189, "timestamp": "01:11:51", "text": "そこには。"}, {"type": "subtitle", "time": 4313.189, "timestamp": "01:11:53", "text": "私についてきて、勝利を掴み取ろう。もう一つのホット"}, {"type": "subtitle", "time": 4315.91, "timestamp": "01:11:55", "text": "スポイト。私はすべてが大好きです"}, {"type": "subtitle", "time": 4317.669, "timestamp": "01:11:57", "text": "スポイト。"}]
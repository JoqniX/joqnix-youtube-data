[{"type": "subtitle", "time": 1440.71, "timestamp": "00:24:00", "text": "銀から金に変わるような感じかな？金"}, {"type": "subtitle", "time": 1442.31, "timestamp": "00:24:02", "text": "プラット。"}, {"type": "subtitle", "time": 1448.39, "timestamp": "00:24:08", "text": "待って、あなたはどのサーバーにいますか？"}, {"type": "subtitle", "time": 1451.51, "timestamp": "00:24:11", "text": "ああ、私は南東にいる"}, {"type": "subtitle", "time": 1453.269, "timestamp": "00:24:13", "text": "だって、私はあなたのところに引っ越すべきだから"}, {"type": "subtitle", "time": 1456.149, "timestamp": "00:24:16", "text": "サービス。ああ、大丈夫ですよ。大丈夫です。さあ"}, {"type": "subtitle", "time": 1468.149, "timestamp": "00:24:28", "text": "エイデンがどうやってまた手に入れたか忘れちゃった。えっと、私は"}, {"type": "subtitle", "time": 1479.029, "timestamp": "00:24:39", "text": "私の生産物。ああ、なんて肌が"}, {"type": "subtitle", "time": 1482.149, "timestamp": "00:24:42", "text": "かわいい。とても綺麗ですね。ああ、なんてことだ、私は"}, {"type": "subtitle", "time": 1497.029, "timestamp": "00:24:57", "text": "ご注意ください。"}]
[{"type": "subtitle", "time": 5526.39, "timestamp": "01:32:06", "text": "ええと、ほとんどの殺人犯はただついていくだけです"}, {"type": "subtitle", "time": 5539.43, "timestamp": "01:32:19", "text": "ああ、なんてことだ、彼はたった今、私を1時に誘拐した。"}, {"type": "subtitle", "time": 5548.07, "timestamp": "01:32:28", "text": "何てことだ。キャラクターを見ると"}, {"type": "subtitle", "time": 5550.07, "timestamp": "01:32:30", "text": "苦労している、"}, {"type": "subtitle", "time": 5558.149, "timestamp": "01:32:38", "text": "あなたが立ち去ると、彼女は"}, {"type": "subtitle", "time": 5560.229, "timestamp": "01:32:40", "text": "下に入る。"}, {"type": "subtitle", "time": 5569.91, "timestamp": "01:32:49", "text": "どうやって誰かを治療するための救急キットを手に入れたの？"}, {"type": "subtitle", "time": 5571.83, "timestamp": "01:32:51", "text": "それ以外？"}, {"type": "subtitle", "time": 5579.35, "timestamp": "01:32:59", "text": "このゲームはクレイジーだ。血液の量"}]
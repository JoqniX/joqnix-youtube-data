[{"type": "subtitle", "time": 7862.229, "timestamp": "02:11:02", "text": "私はこれが本当に好きになれない。"}, {"type": "subtitle", "time": 7865.109, "timestamp": "02:11:05", "text": "システムに不具合を起こしている。"}, {"type": "subtitle", "time": 7870.069, "timestamp": "02:11:10", "text": "私は文字通りシステムをバグらせている。"}, {"type": "subtitle", "time": 7876.47, "timestamp": "02:11:16", "text": "でも、ちょっと可愛いよね。えっと、それはちょっと"}, {"type": "subtitle", "time": 7878.87, "timestamp": "02:11:18", "text": "クールな効果。"}, {"type": "subtitle", "time": 7883.43, "timestamp": "02:11:23", "text": "すごく気分がいい。私はピクセル化される可能性があります、"}, {"type": "subtitle", "time": 7888.55, "timestamp": "02:11:28", "text": "あなたが知っている。画質が粗くなることがあります。"}, {"type": "subtitle", "time": 7891.35, "timestamp": "02:11:31", "text": "かっこいいと思わない？"}, {"type": "subtitle", "time": 7893.669, "timestamp": "02:11:33", "text": "私は自分自身にさまざまな色を付けることができます"}, {"type": "subtitle", "time": 7900.629, "timestamp": "02:11:40", "text": "もし私がピクセルピクセルを手に入れたいと思ったら"}, {"type": "subtitle", "time": 7906.229, "timestamp": "02:11:46", "text": "ピクセル、ピクセル、こうやって行けるよ。"}, {"type": "subtitle", "time": 7910.069, "timestamp": "02:11:50", "text": "文字通り、こんな感じでできます。"}]
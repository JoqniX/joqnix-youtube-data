[{"type": "subtitle", "time": 2702.55, "timestamp": "00:45:02", "text": "再装填中。その人は処分された。"}, {"type": "subtitle", "time": 2704.15, "timestamp": "00:45:04", "text": "我々の部隊は彼を全滅させた。どうでも。ただ"}, {"type": "subtitle", "time": 2714.39, "timestamp": "00:45:14", "text": "良いROMがあればよかったのに。ああ、"}, {"type": "subtitle", "time": 2727.03, "timestamp": "00:45:27", "text": "どうすれば"}, {"type": "subtitle", "time": 2730.39, "timestamp": "00:45:30", "text": "舵。舵輪が欲しいのですが、"}, {"type": "subtitle", "time": 2732.47, "timestamp": "00:45:32", "text": "値段が高い。"}, {"type": "subtitle", "time": 2735.349, "timestamp": "00:45:35", "text": "えっと、彼らは、私はそれが"}, {"type": "subtitle", "time": 2737.51, "timestamp": "00:45:37", "text": "彼らは同情制度を作った"}, {"type": "subtitle", "time": 2741.27, "timestamp": "00:45:41", "text": "今。つまり、500ごとに"}, {"type": "subtitle", "time": 2745.67, "timestamp": "00:45:45", "text": "パック。 500は多すぎる。 500は"}, {"type": "subtitle", "time": 2747.109, "timestamp": "00:45:47", "text": "多く。うん。でも、十分に遊ぶのが好きなら"}, {"type": "subtitle", "time": 2748.79, "timestamp": "00:45:48", "text": "そして、あなたは本当にそれが欲しいのです。"}, {"type": "subtitle", "time": 2750.39, "timestamp": "00:45:50", "text": "無料でプレイできるものも含め、必ず1つは保証されています。それ"}, {"type": "subtitle", "time": 2753.19, "timestamp": "00:45:53", "text": "とにかく時間がかかる。"}, {"type": "subtitle", "time": 2755.03, "timestamp": "00:45:55", "text": "しかし、それもカウントされる。それも同様にカウントされます"}, {"type": "subtitle", "time": 2756.87, "timestamp": "00:45:56", "text": "イベントパックも同様です。彼らはそれを数えた"}, {"type": "subtitle", "time": 2759.43, "timestamp": "00:45:59", "text": "500。"}]
[{"type": "subtitle", "time": 7981.35, "timestamp": "02:13:01", "text": "えっと、私はいくつかの異なるプロジェクトに取り組んでいます"}, {"type": "subtitle", "time": 7983.91, "timestamp": "02:13:03", "text": "要素、"}, {"type": "subtitle", "time": 7988.31, "timestamp": "02:13:08", "text": "でも一番大切なのは、"}, {"type": "subtitle", "time": 7992.149, "timestamp": "02:13:12", "text": "それら全てに合う。それは一つの点だ。そして"}, {"type": "subtitle", "time": 7994.39, "timestamp": "02:13:14", "text": "主と私の"}, {"type": "subtitle", "time": 7997.51, "timestamp": "02:13:17", "text": "今は黙ってろ。アデレードの叔父が"}, {"type": "subtitle", "time": 8000.39, "timestamp": "02:13:20", "text": "非常に到達しそうなように見えることを願っています"}, {"type": "subtitle", "time": 8002.39, "timestamp": "02:13:22", "text": "最終稿には彼女の叔父のキャンプについて言及されていた"}, {"type": "subtitle", "time": 8005.669, "timestamp": "02:13:25", "text": "ブロック川の​​向こう側にあるかもしれない"}, {"type": "subtitle", "time": 8008.149, "timestamp": "02:13:28", "text": "川は"}, {"type": "subtitle", "time": 8020.55, "timestamp": "02:13:40", "text": "さあ、外に出て行こう"}]
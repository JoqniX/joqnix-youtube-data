[{"type": "subtitle", "time": 16157.87, "timestamp": "04:29:17", "text": "おお、"}, {"type": "subtitle", "time": 16160.309, "timestamp": "04:29:20", "text": "[音楽]"}, {"type": "subtitle", "time": 16162.389, "timestamp": "04:29:22", "text": "私は疲れている。"}, {"type": "subtitle", "time": 16165.91, "timestamp": "04:29:25", "text": "私は105歳です。"}, {"type": "subtitle", "time": 16168.71, "timestamp": "04:29:28", "text": "ああ、ケースか何かを手に入れたんだ。ああ、何"}, {"type": "subtitle", "time": 16171.59, "timestamp": "04:29:31", "text": "私はします？私はそれをクリックする。ライフルを使え。いいえ、"}, {"type": "subtitle", "time": 16175.11, "timestamp": "04:29:35", "text": "それは私のインベントリに入っています。"}, {"type": "subtitle", "time": 16178.79, "timestamp": "04:29:38", "text": "ああ、鍵を持って行ってください。西部開拓時代。西部開拓時代。"}, {"type": "subtitle", "time": 16181.11, "timestamp": "04:29:41", "text": "わかった。"}, {"type": "subtitle", "time": 16184.309, "timestamp": "04:29:44", "text": "何人いますか？"}, {"type": "subtitle", "time": 16187.11, "timestamp": "04:29:47", "text": "野蛮な人々は狂っている。 10人くらい"}, {"type": "subtitle", "time": 16189.59, "timestamp": "04:29:49", "text": "もっと多くのものが欲しい。"}, {"type": "subtitle", "time": 16192.55, "timestamp": "04:29:52", "text": "そこであなたの訴訟案件を確認できます。"}, {"type": "subtitle", "time": 16197.349, "timestamp": "04:29:57", "text": "あ、失礼しました。私はApexのケースを持っています。"}]
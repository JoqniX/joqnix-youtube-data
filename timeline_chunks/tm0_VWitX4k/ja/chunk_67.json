[{"type": "subtitle", "time": 4020.069, "timestamp": "01:07:00", "text": "あの山賊に。"}, {"type": "subtitle", "time": 4023.589, "timestamp": "01:07:03", "text": "私はゲーマーみたいなものだ。スプラッシュオンを確認してください"}, {"type": "subtitle", "time": 4025.589, "timestamp": "01:07:05", "text": "チーム全員。"}, {"type": "subtitle", "time": 4038.069, "timestamp": "01:07:18", "text": "私はそれが欲しい。チームの半数が去った。私たちは"}, {"type": "subtitle", "time": 4040.63, "timestamp": "01:07:20", "text": "彼らの世界を終わらせることができる。"}, {"type": "subtitle", "time": 4055.99, "timestamp": "01:07:35", "text": "ああ、君は戦っているんだね。"}, {"type": "subtitle", "time": 4058.39, "timestamp": "01:07:38", "text": "えっと、私は、"}, {"type": "subtitle", "time": 4075.029, "timestamp": "01:07:55", "text": "それは、ええと、オクタンです。"}, {"type": "subtitle", "time": 4076.47, "timestamp": "01:07:56", "text": "うん、オクタン関連のものを見つけたよ。武器"}, {"type": "subtitle", "time": 4078.549, "timestamp": "01:07:58", "text": "そして彼はそれを好きになろうとしていたと思う"}]
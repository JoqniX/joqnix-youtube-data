[{"type": "subtitle", "time": 1500.47, "timestamp": "00:25:00", "text": "愛は墓場だ。"}, {"type": "subtitle", "time": 1503.029, "timestamp": "00:25:03", "text": "すみません、チャットの設定を調整しているところです。いいえ"}, {"type": "subtitle", "time": 1513.43, "timestamp": "00:25:13", "text": "どこから飛び降りればいいですか？"}, {"type": "subtitle", "time": 1515.269, "timestamp": "00:25:15", "text": "ええと、おそらく私たちは"}, {"type": "subtitle", "time": 1518.63, "timestamp": "00:25:18", "text": "タービンを回せ。ええ、彼らは行くでしょう"}, {"type": "subtitle", "time": 1538.39, "timestamp": "00:25:38", "text": "考える"}, {"type": "subtitle", "time": 1546.149, "timestamp": "00:25:46", "text": "ここには他にも人がいる。なんてこった。"}, {"type": "subtitle", "time": 1556.71, "timestamp": "00:25:56", "text": "初めてミミズを捕まえた。"}]
[{"type": "subtitle", "time": 13389.99, "timestamp": "03:43:09", "text": "私は現れただろうか？"}, {"type": "subtitle", "time": 13416.389, "timestamp": "03:43:36", "text": "本来あるべきではないものを依然として受け入れている"}, {"type": "subtitle", "time": 13418.229, "timestamp": "03:43:38", "text": "それ。"}, {"type": "subtitle", "time": 13421.189, "timestamp": "03:43:41", "text": "だから私も混乱しているんです。"}, {"type": "subtitle", "time": 13425.349, "timestamp": "03:43:45", "text": "時間がかかりすぎている。"}, {"type": "subtitle", "time": 13428.63, "timestamp": "03:43:48", "text": "なぜ料理をしているのですか？"}, {"type": "subtitle", "time": 13431.75, "timestamp": "03:43:51", "text": "いいえ。それはまだそこにある。文字通り"}, {"type": "subtitle", "time": 13437.67, "timestamp": "03:43:57", "text": "何？"}]
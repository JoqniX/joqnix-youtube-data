[{"type": "subtitle", "time": 15905.11, "timestamp": "04:25:05", "text": "あと9人倒せばいいだけだ。落とすことができます"}, {"type": "subtitle", "time": 15907.91, "timestamp": "04:25:07", "text": "核兵器。"}, {"type": "subtitle", "time": 15911.36, "timestamp": "04:25:11", "text": "彼はただスパムメールを送っているだけだ。どうすればいいですか？"}, {"type": "subtitle", "time": 15919.269, "timestamp": "04:25:19", "text": "レーザーで私を殺すのはちょっと難しい"}, {"type": "subtitle", "time": 15921.03, "timestamp": "04:25:21", "text": "男"}, {"type": "subtitle", "time": 15928.07, "timestamp": "04:25:28", "text": "いいえ、"}, {"type": "subtitle", "time": 15931.91, "timestamp": "04:25:31", "text": "男。君からは隠れられないんだね？さらに6人"}, {"type": "subtitle", "time": 15934.63, "timestamp": "04:25:34", "text": "キルして、"}, {"type": "subtitle", "time": 15936.95, "timestamp": "04:25:36", "text": "核兵器。"}, {"type": "subtitle", "time": 15947.75, "timestamp": "04:25:47", "text": "ああ、私は本当に素敵だ。いいえ、"}, {"type": "subtitle", "time": 15956.229, "timestamp": "04:25:56", "text": "ああ、お前はクソ野郎だ。何てことだ。さっき君を見たよ"}, {"type": "subtitle", "time": 15959.75, "timestamp": "04:25:59", "text": "秋。何てことだ。"}]
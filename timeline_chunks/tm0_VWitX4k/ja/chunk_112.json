[{"type": "subtitle", "time": 6735.35, "timestamp": "01:52:15", "text": "発電機は時間がかかるだろう、"}, {"type": "subtitle", "time": 6744.87, "timestamp": "01:52:24", "text": "ええ、宝石は大抵そうなりますよ。通常人々は"}, {"type": "subtitle", "time": 6747.189, "timestamp": "01:52:27", "text": "まるで宝石のような二人の男。"}, {"type": "subtitle", "time": 6749.91, "timestamp": "01:52:29", "text": "修理する能力はないのですか？"}, {"type": "subtitle", "time": 6752.07, "timestamp": "01:52:32", "text": "もっと早く？"}, {"type": "subtitle", "time": 6753.51, "timestamp": "01:52:33", "text": "ええ、ありますよ。いくつかあります"}, {"type": "subtitle", "time": 6769.03, "timestamp": "01:52:49", "text": "そして、あなたは死にかけているんですよね？"}, {"type": "subtitle", "time": 6771.189, "timestamp": "01:52:51", "text": "うん。だから、彼は私に対して、"}, {"type": "subtitle", "time": 6776.149, "timestamp": "01:52:56", "text": "考える。何てことだ。彼はこう言う、"}]
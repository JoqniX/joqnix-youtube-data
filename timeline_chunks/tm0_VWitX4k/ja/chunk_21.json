[{"type": "subtitle", "time": 1263.59, "timestamp": "00:21:03", "text": "ちょうどその時、ゲーム用PCを持っていた"}, {"type": "subtitle", "time": 1267.35, "timestamp": "00:21:07", "text": "しかし私のPCはサポートのようにオンラインだったので"}, {"type": "subtitle", "time": 1271.029, "timestamp": "00:21:11", "text": "CPUとGPUの両方が"}, {"type": "subtitle", "time": 1285.19, "timestamp": "00:21:25", "text": "うん、それは全然楽しくないね。"}, {"type": "subtitle", "time": 1287.83, "timestamp": "00:21:27", "text": "男。"}, {"type": "subtitle", "time": 1291.99, "timestamp": "00:21:31", "text": "ええ、今でも恋しいです"}, {"type": "subtitle", "time": 1293.59, "timestamp": "00:21:33", "text": "いいえ、あなたの言う通りです。ごめん。どうぞ、どうぞ。"}, {"type": "subtitle", "time": 1295.83, "timestamp": "00:21:35", "text": "私のミスです。ごめん。うん。あなたは行方不明ですか？"}, {"type": "subtitle", "time": 1299.27, "timestamp": "00:21:39", "text": "いいえ、そうです。いや、いや。ええ、私もそう思います"}, {"type": "subtitle", "time": 1300.71, "timestamp": "00:21:40", "text": "正直言って、私のものも同じことが起こりました。"}, {"type": "subtitle", "time": 1303.83, "timestamp": "00:21:43", "text": "えっと、私のコンピューターのグラフィックカードが壊れました"}, {"type": "subtitle", "time": 1305.669, "timestamp": "00:21:45", "text": "ええと、私がプレイしたのと同じコンピューターで"}, {"type": "subtitle", "time": 1308.549, "timestamp": "00:21:48", "text": "ずっと昔のことだ。"}]
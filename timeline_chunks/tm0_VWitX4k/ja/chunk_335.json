[{"type": "subtitle", "time": 20110.548, "timestamp": "05:35:10", "text": "待って。それは私だけに表示します。"}, {"type": "subtitle", "time": 20113.27, "timestamp": "05:35:13", "text": "待って、どうすればまたあなたたちと合流できるの？どのように"}, {"type": "subtitle", "time": 20114.31, "timestamp": "05:35:14", "text": "あなた"}, {"type": "subtitle", "time": 20119.43, "timestamp": "05:35:19", "text": "ゲーム、もしくは私はできます。わかった。そうそう。"}, {"type": "subtitle", "time": 20150.47, "timestamp": "05:35:50", "text": "はい。"}, {"type": "subtitle", "time": 20153.19, "timestamp": "05:35:53", "text": "さあ行こう。"}, {"type": "subtitle", "time": 20155.19, "timestamp": "05:35:55", "text": "おい。"}, {"type": "subtitle", "time": 20159.75, "timestamp": "05:35:59", "text": "ええと、この質問にはパーティーの規模が大きすぎます。"}]
[{"type": "subtitle", "time": 6181.03, "timestamp": "01:43:01", "text": "スキンコレクション。つまり、彼らは本当に"}, {"type": "subtitle", "time": 6183.27, "timestamp": "01:43:03", "text": "ウィッチャーをテーマにしたスキンがたくさんある。それで"}, {"type": "subtitle", "time": 6185.51, "timestamp": "01:43:05", "text": "登場人物の一人には"}, {"type": "subtitle", "time": 6187.109, "timestamp": "01:43:07", "text": "それは誰のためのものですか？ええ、"}, {"type": "subtitle", "time": 6190.39, "timestamp": "01:43:10", "text": "生存者なら、文字通りジェラルドか"}, {"type": "subtitle", "time": 6194.99, "timestamp": "01:43:14", "text": "シリ、イェネファー、トリス"}, {"type": "subtitle", "time": 6196.709, "timestamp": "01:43:16", "text": "[音楽]"}, {"type": "subtitle", "time": 6199.83, "timestamp": "01:43:19", "text": "そして、殺人者として、騎士であるあなた"}, {"type": "subtitle", "time": 6203.75, "timestamp": "01:43:23", "text": "そしてアーティストはスキンを受け取った。うん。それで、"}, {"type": "subtitle", "time": 6205.51, "timestamp": "01:43:25", "text": "例えば、見てみて"}, {"type": "subtitle", "time": 6208.07, "timestamp": "01:43:28", "text": "コレクションタブには次のようなものが表示されます"}, {"type": "subtitle", "time": 6211.03, "timestamp": "01:43:31", "text": "すべてのスキンはどんな感じですか"}, {"type": "subtitle", "time": 6212.95, "timestamp": "01:43:32", "text": "知る"}, {"type": "subtitle", "time": 6214.55, "timestamp": "01:43:34", "text": "バンドル"}, {"type": "subtitle", "time": 6216.55, "timestamp": "01:43:36", "text": "鉄もあるから"}, {"type": "subtitle", "time": 6218.629, "timestamp": "01:43:38", "text": "乙女。彼らはスキンコラボをしました"}, {"type": "subtitle", "time": 6221.83, "timestamp": "01:43:41", "text": "アイアン・メイデン。彼らは皮膚を持っていた"}, {"type": "subtitle", "time": 6225.189, "timestamp": "01:43:45", "text": "umとのコラボレーション"}, {"type": "subtitle", "time": 6227.91, "timestamp": "01:43:47", "text": "カップル向けファッションブランド。"}, {"type": "subtitle", "time": 6232.31, "timestamp": "01:43:52", "text": "ゲームプレイエキスポ64 トゥームレイダー"}, {"type": "subtitle", "time": 6234.229, "timestamp": "01:43:54", "text": "明らかに"}, {"type": "subtitle", "time": 6236.629, "timestamp": "01:43:56", "text": "うん、でも、"}, {"type": "subtitle", "time": 6238.79, "timestamp": "01:43:58", "text": "全体的に"}]
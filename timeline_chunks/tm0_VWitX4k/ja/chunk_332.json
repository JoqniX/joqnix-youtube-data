[{"type": "subtitle", "time": 19922.39, "timestamp": "05:32:02", "text": "何？ああ、"}, {"type": "subtitle", "time": 19926.07, "timestamp": "05:32:06", "text": "私のping値は600です。どういうことですか？ 600 ping。私は持っている"}, {"type": "subtitle", "time": 19928.788, "timestamp": "05:32:08", "text": "500 ping"}, {"type": "subtitle", "time": 19931.11, "timestamp": "05:32:11", "text": "私たち。なぜ？"}, {"type": "subtitle", "time": 19933.75, "timestamp": "05:32:13", "text": "それが彼らが勝っている理由だ。私は好きです"}, {"type": "subtitle", "time": 19941.43, "timestamp": "05:32:21", "text": "彼はまるで何でもないかのように私を殺した。"}, {"type": "subtitle", "time": 19948.548, "timestamp": "05:32:28", "text": "彼らはフルピングで、私たちはそれをプレイしています"}, {"type": "subtitle", "time": 19950.47, "timestamp": "05:32:30", "text": "1つ。"}, {"type": "subtitle", "time": 19957.99, "timestamp": "05:32:37", "text": "あ、待って。一体どういうことだ？私たちならできる。"}, {"type": "subtitle", "time": 19961.51, "timestamp": "05:32:41", "text": "私は彼を殺したと思った。何？"}, {"type": "subtitle", "time": 19966.15, "timestamp": "05:32:46", "text": "右クリックの回数を減らすことができます。知りませんでした。"}, {"type": "subtitle", "time": 19976.15, "timestamp": "05:32:56", "text": "ああ、それはできますよ。知りませんでした"}]
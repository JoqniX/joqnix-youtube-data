[{"type": "subtitle", "time": 18273.59, "timestamp": "05:04:33", "text": "太陽の岩を売っている男がいるんだ。したい"}, {"type": "subtitle", "time": 18277.51, "timestamp": "05:04:37", "text": "彼をひどく殺したい。サンロ？"}, {"type": "subtitle", "time": 18280.47, "timestamp": "05:04:40", "text": "うん。男と男と私のような"}, {"type": "subtitle", "time": 18282.948, "timestamp": "05:04:42", "text": "ロボットのアバター。"}, {"type": "subtitle", "time": 18284.788, "timestamp": "05:04:44", "text": "まるで翼でも生えたみたいだった。彼は"}, {"type": "subtitle", "time": 18288.47, "timestamp": "05:04:48", "text": "それらのものを手に入れるのに十分な金額を支払った。うん。"}, {"type": "subtitle", "time": 18291.59, "timestamp": "05:04:51", "text": "このスキンは、ああ、それは何ですか"}]
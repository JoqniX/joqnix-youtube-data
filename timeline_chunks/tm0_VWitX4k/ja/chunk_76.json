[{"type": "subtitle", "time": 4561.669, "timestamp": "01:16:01", "text": "銃声が聞こえる"}, {"type": "subtitle", "time": 4564.39, "timestamp": "01:16:04", "text": "そちら側。犬たちは何を考えているんだろう"}, {"type": "subtitle", "time": 4583.75, "timestamp": "01:16:23", "text": "わかった。強化するため。"}, {"type": "subtitle", "time": 4585.91, "timestamp": "01:16:25", "text": "おい、新しい殺人犯が現れたぞ。私の武器は"}, {"type": "subtitle", "time": 4593.83, "timestamp": "01:16:33", "text": "この武器は強化されている。充電"}, {"type": "subtitle", "time": 4599.91, "timestamp": "01:16:39", "text": "よし。闇市場を開設しましたが、"}, {"type": "subtitle", "time": 4603.59, "timestamp": "01:16:43", "text": "たぶん、そのまま持っておくと思います。"}, {"type": "subtitle", "time": 4606.149, "timestamp": "01:16:46", "text": "うん。"}, {"type": "subtitle", "time": 4609.83, "timestamp": "01:16:49", "text": "予備の物資をいくつか見つけました。"}, {"type": "subtitle", "time": 4612.47, "timestamp": "01:16:52", "text": "私は"}, {"type": "subtitle", "time": 4616.709, "timestamp": "01:16:56", "text": "このオクタン・スプリントっていうやつ。"}]
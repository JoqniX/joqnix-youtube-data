[{"type": "subtitle", "time": 4805.51, "timestamp": "01:20:05", "text": "何てことだ。弾薬は山ほどある。"}, {"type": "subtitle", "time": 4808.07, "timestamp": "01:20:08", "text": "うん。あなたは私と一緒に家に帰る"}, {"type": "subtitle", "time": 4810.709, "timestamp": "01:20:10", "text": "今夜。そして私たちは3つを手に入れます"}, {"type": "subtitle", "time": 4818.229, "timestamp": "01:20:18", "text": "だから、もう1つ手に入れることができると分かっているから"}, {"type": "subtitle", "time": 4821.189, "timestamp": "01:20:21", "text": "スコープを入手しようと思います。"}, {"type": "subtitle", "time": 4823.27, "timestamp": "01:20:23", "text": "わかった。良い。"}, {"type": "subtitle", "time": 4834.709, "timestamp": "01:20:34", "text": "私たちは戦える。私たちはできる、私たちはできる"}, {"type": "subtitle", "time": 4838.149, "timestamp": "01:20:38", "text": "戦い。もう一度やり直せる"}, {"type": "subtitle", "time": 4840.709, "timestamp": "01:20:40", "text": "ここ。"}, {"type": "subtitle", "time": 4844.31, "timestamp": "01:20:44", "text": "戻る。ああ、くそ。それらはすべてひび割れていて"}, {"type": "subtitle", "time": 4847.59, "timestamp": "01:20:47", "text": "どれも低い？"}, {"type": "subtitle", "time": 4851.189, "timestamp": "01:20:51", "text": "その背後には、すべての癒しが隠されている。敵はここにいる。"}]
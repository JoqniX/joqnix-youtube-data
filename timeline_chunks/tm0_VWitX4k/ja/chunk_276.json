[{"type": "subtitle", "time": 16572.15, "timestamp": "04:36:12", "text": "なぜ彼はそんな狙いを定めるのか"}, {"type": "subtitle", "time": 16581.429, "timestamp": "04:36:21", "text": "君を殺したのが好きだ。しかし、それはただ落ちるだけだ。"}, {"type": "subtitle", "time": 16583.109, "timestamp": "04:36:23", "text": "リング音がない。それは"}, {"type": "subtitle", "time": 16585.99, "timestamp": "04:36:25", "text": "もの。そう、ただ引き上げるだけだよ。"}, {"type": "subtitle", "time": 16587.75, "timestamp": "04:36:27", "text": "実は、"}, {"type": "subtitle", "time": 16589.269, "timestamp": "04:36:29", "text": "それがあなたがやっていることです。そして私は"}, {"type": "subtitle", "time": 16591.189, "timestamp": "04:36:31", "text": "知る。"}, {"type": "subtitle", "time": 16607.75, "timestamp": "04:36:47", "text": "彼は私の目の前で息を引き取った。待って、君"}]
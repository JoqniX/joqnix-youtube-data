[{"type": "subtitle", "time": 9481.429, "timestamp": "02:38:01", "text": "時間。それもコラボレーションの最中だった。私"}, {"type": "subtitle", "time": 9484.309, "timestamp": "02:38:04", "text": "たぶん"}, {"type": "subtitle", "time": 9487.51, "timestamp": "02:38:07", "text": "私は信じている。うん。うん。"}, {"type": "subtitle", "time": 9493.75, "timestamp": "02:38:13", "text": "えっと、その時私は電話会議に参加していました"}, {"type": "subtitle", "time": 9497.83, "timestamp": "02:38:17", "text": "ニュースを聞いて、私は「なんてことだ」と思いました"}, {"type": "subtitle", "time": 9500.95, "timestamp": "02:38:20", "text": "私はここで全てをスピードランしているので"}, {"type": "subtitle", "time": 9503.99, "timestamp": "02:38:23", "text": "平和に"}, {"type": "subtitle", "time": 9508.87, "timestamp": "02:38:28", "text": "来月は、わあ、あなたは"}, {"type": "subtitle", "time": 9511.99, "timestamp": "02:38:31", "text": "つまり、私は延長する機会を得るということです"}, {"type": "subtitle", "time": 9518.79, "timestamp": "02:38:38", "text": "1年11ヶ月の卵のためのジャカタン。おお。"}, {"type": "subtitle", "time": 9521.03, "timestamp": "02:38:41", "text": "つまり、良い面と悪い面の両方があるということだ"}, {"type": "subtitle", "time": 9523.39, "timestamp": "02:38:43", "text": "側面。うん。"}, {"type": "subtitle", "time": 9525.59, "timestamp": "02:38:45", "text": "[音楽]"}, {"type": "subtitle", "time": 9529.27, "timestamp": "02:38:49", "text": "それについて議論しよう。うん。しかしある意味では"}, {"type": "subtitle", "time": 9531.349, "timestamp": "02:38:51", "text": "アカデミーの人たちは「ああ、私たちは"}, {"type": "subtitle", "time": 9533.429, "timestamp": "02:38:53", "text": "あなたに補償"}, {"type": "subtitle", "time": 9536.15, "timestamp": "02:38:56", "text": "N4クラスの形式では"}, {"type": "subtitle", "time": 9539.11, "timestamp": "02:38:59", "text": "無料。えっと"}]
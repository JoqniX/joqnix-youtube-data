[{"type": "subtitle", "time": 3543.829, "timestamp": "00:59:03", "text": "くそ。本当に惜しかった。私は外出しました。"}, {"type": "subtitle", "time": 3546.63, "timestamp": "00:59:06", "text": "うん、"}, {"type": "subtitle", "time": 3549.67, "timestamp": "00:59:09", "text": "あと少しだったのに。誰もドロップしなかったと思う"}, {"type": "subtitle", "time": 3551.84, "timestamp": "00:59:11", "text": "残念なことだ。"}, {"type": "subtitle", "time": 3553.91, "timestamp": "00:59:13", "text": "[音楽]"}, {"type": "subtitle", "time": 3564.47, "timestamp": "00:59:24", "text": "もう一度やってみよう。"}, {"type": "subtitle", "time": 3568.71, "timestamp": "00:59:28", "text": "え、君はレベル203なの？聖なる。"}, {"type": "subtitle", "time": 3572.23, "timestamp": "00:59:32", "text": "自分のレベルに達したときにそう言う"}, {"type": "subtitle", "time": 3575.75, "timestamp": "00:59:35", "text": "三つ。あ、待って。ああ、３だ。いいえ、"}, {"type": "subtitle", "time": 3579.27, "timestamp": "00:59:39", "text": "待って。 500 をやったのかもしれないし"}, {"type": "subtitle", "time": 3581.589, "timestamp": "00:59:41", "text": "それから戻ってきて、それからあなたは"}, {"type": "subtitle", "time": 3584.15, "timestamp": "00:59:44", "text": "2回目だ。もう一度。彼らは持っている"}, {"type": "subtitle", "time": 3586.71, "timestamp": "00:59:46", "text": "そういうことですよね？"}, {"type": "subtitle", "time": 3599.51, "timestamp": "00:59:59", "text": "私は500に到達したいです。"}]
[{"type": "subtitle", "time": 4761.59, "timestamp": "01:19:21", "text": "その盾は何ですか？"}, {"type": "subtitle", "time": 4764.63, "timestamp": "01:19:24", "text": "それがライフラインの究極の姿だ。充電中。"}, {"type": "subtitle", "time": 4767.43, "timestamp": "01:19:27", "text": "ライフラインの代替手段は何ですか？だから"}, {"type": "subtitle", "time": 4770.63, "timestamp": "01:19:30", "text": "ライフラインパックはもうありませんが、今は"}, {"type": "subtitle", "time": 4773.11, "timestamp": "01:19:33", "text": "巨大な盾。"}, {"type": "subtitle", "time": 4789.11, "timestamp": "01:19:49", "text": "周りに死体がたくさん"}, {"type": "subtitle", "time": 4791.27, "timestamp": "01:19:51", "text": "私たち。この巨大な木の後ろに来て"}, {"type": "subtitle", "time": 4793.43, "timestamp": "01:19:53", "text": "私はもうダメだ。"}]
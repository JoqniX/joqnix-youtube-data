[{"type": "subtitle", "time": 12300.55, "timestamp": "03:25:00", "text": "インド人の権利。"}, {"type": "subtitle", "time": 12302.309, "timestamp": "03:25:02", "text": "うん、"}, {"type": "subtitle", "time": 12305.429, "timestamp": "03:25:05", "text": "そういう動画もあるよ"}, {"type": "subtitle", "time": 12308.87, "timestamp": "03:25:08", "text": "そういうことが多すぎるんです。"}, {"type": "subtitle", "time": 12311.83, "timestamp": "03:25:11", "text": "連絡を取るのは少し難しいのかもしれませんね。"}, {"type": "subtitle", "time": 12315.349, "timestamp": "03:25:15", "text": "ほとんどの人は実際には見ていない"}, {"type": "subtitle", "time": 12319.429, "timestamp": "03:25:19", "text": "インド人はそういうのが好きなんです。"}, {"type": "subtitle", "time": 12325.59, "timestamp": "03:25:25", "text": "また、好きになるのは少し難しい"}, {"type": "subtitle", "time": 12328.12, "timestamp": "03:25:28", "text": "異種の筋肉のようなものと関係する"}, {"type": "subtitle", "time": 12344.63, "timestamp": "03:25:44", "text": "歌のカバーを作るのが得意で、"}, {"type": "subtitle", "time": 12347.59, "timestamp": "03:25:47", "text": "もの。それは本当に素晴らしいですね。実は、"}, {"type": "subtitle", "time": 12349.67, "timestamp": "03:25:49", "text": "彼らには助けてくれる素敵なコミュニティがある"}]
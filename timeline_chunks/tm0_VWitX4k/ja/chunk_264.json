[{"type": "subtitle", "time": 15844.149, "timestamp": "04:24:04", "text": "それらの人々は全員ホワイトエディションを持っています"}, {"type": "subtitle", "time": 15845.67, "timestamp": "04:24:05", "text": "銃。"}, {"type": "subtitle", "time": 15847.91, "timestamp": "04:24:07", "text": "わからない。"}, {"type": "subtitle", "time": 15851.349, "timestamp": "04:24:11", "text": "私ですら持っていません。私はただ"}, {"type": "subtitle", "time": 15862.71, "timestamp": "04:24:22", "text": "36歳で37点くらい取ったよ。"}, {"type": "subtitle", "time": 15895.75, "timestamp": "04:24:55", "text": "1"}, {"type": "subtitle", "time": 15897.67, "timestamp": "04:24:57", "text": "彼は元気ですか？彼はただスパムしているだけです"}]
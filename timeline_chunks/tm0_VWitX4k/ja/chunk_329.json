[{"type": "subtitle", "time": 19741.35, "timestamp": "05:29:01", "text": "えーと、RCS。"}, {"type": "subtitle", "time": 19756.948, "timestamp": "05:29:16", "text": "私には見えない"}, {"type": "subtitle", "time": 19761.51, "timestamp": "05:29:21", "text": "FFはありません、PVPタイプだけです"}, {"type": "subtitle", "time": 19766.39, "timestamp": "05:29:26", "text": "あなたを招待するので、王様は大丈夫です。私は今プレイします"}, {"type": "subtitle", "time": 19770.23, "timestamp": "05:29:30", "text": "プレイヤーの右制限を押す OK スイッチ"}, {"type": "subtitle", "time": 19773.51, "timestamp": "05:29:33", "text": "離れてください。私がやること？立ち上がる。"}, {"type": "subtitle", "time": 19776.628, "timestamp": "05:29:36", "text": "膠着状態。それはイベントだ。遊べるよ"}, {"type": "subtitle", "time": 19778.708, "timestamp": "05:29:38", "text": "イベント。"}, {"type": "subtitle", "time": 19781.94, "timestamp": "05:29:41", "text": "1対1対1の対戦もあります。"}, {"type": "subtitle", "time": 19787.67, "timestamp": "05:29:47", "text": "この最後の試合は1対1対1になります"}, {"type": "subtitle", "time": 19789.35, "timestamp": "05:29:49", "text": "あなたが望むもの。"}]
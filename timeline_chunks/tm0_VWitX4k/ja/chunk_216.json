[{"type": "subtitle", "time": 12965.429, "timestamp": "03:36:05", "text": "しかし、それは本当に似ている"}, {"type": "subtitle", "time": 12969.75, "timestamp": "03:36:09", "text": "オリジナルゲーム。本当にそっくりです。"}, {"type": "subtitle", "time": 12975.83, "timestamp": "03:36:15", "text": "スーパーマーケットシミュレーターがあります。ああ、"}, {"type": "subtitle", "time": 12978.309, "timestamp": "03:36:18", "text": "神。何が欠けているのか？たくさんの物。"}, {"type": "subtitle", "time": 12981.83, "timestamp": "03:36:21", "text": "信じられないでしょう。何が欠けているのか？"}, {"type": "subtitle", "time": 12983.99, "timestamp": "03:36:23", "text": "何試合ですか？"}, {"type": "subtitle", "time": 12986.87, "timestamp": "03:36:26", "text": "私自身も知りません。多すぎる"}, {"type": "subtitle", "time": 12988.389, "timestamp": "03:36:28", "text": "多くのゲーム。見た目もそうじゃない"}, {"type": "subtitle", "time": 12995.75, "timestamp": "03:36:35", "text": "率直に言って。それは"}, {"type": "subtitle", "time": 12998.469, "timestamp": "03:36:38", "text": "Unreal Engine 5とか、そんな感じのエンジンですね。そこには"}, {"type": "subtitle", "time": 13001.59, "timestamp": "03:36:41", "text": "そういうゲーム。"}, {"type": "subtitle", "time": 13003.99, "timestamp": "03:36:43", "text": "何てことだ。"}, {"type": "subtitle", "time": 13006.15, "timestamp": "03:36:46", "text": "そうそう、Robloxには独自のエンジンがあるんだ。"}, {"type": "subtitle", "time": 13009.83, "timestamp": "03:36:49", "text": "右？ええ、独自のエンジンを搭載しています。あなた"}, {"type": "subtitle", "time": 13011.67, "timestamp": "03:36:51", "text": "自分でスクリプトを書かないといけない"}, {"type": "subtitle", "time": 13014.15, "timestamp": "03:36:54", "text": "そして建物や物を作るか、"}, {"type": "subtitle", "time": 13016.469, "timestamp": "03:36:56", "text": "既製品のようなものも使えますが、"}]
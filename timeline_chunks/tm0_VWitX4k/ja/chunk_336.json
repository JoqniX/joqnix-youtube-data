[{"type": "subtitle", "time": 20162.23, "timestamp": "05:36:02", "text": "では、私たちはどうすればいいのでしょうか？パーティーはあまりにも"}, {"type": "subtitle", "time": 20167.11, "timestamp": "05:36:07", "text": "大きい。 1対2とか、そういう感じでできると思うよ。彼女"}, {"type": "subtitle", "time": 20169.67, "timestamp": "05:36:09", "text": "待って、アーケードに行って1対1対1をやろう。"}, {"type": "subtitle", "time": 20172.31, "timestamp": "05:36:12", "text": "それはうまくいかない。"}, {"type": "subtitle", "time": 20174.15, "timestamp": "05:36:14", "text": "おい、アーケード1番。ええ、うまくいきません。"}, {"type": "subtitle", "time": 20176.39, "timestamp": "05:36:16", "text": "それは、このチームにはパーティーの規模が大きすぎると言っている。"}, {"type": "subtitle", "time": 20178.788, "timestamp": "05:36:18", "text": "それから2対2対2。"}, {"type": "subtitle", "time": 20181.59, "timestamp": "05:36:21", "text": "待って、３人必要だ。"}, {"type": "subtitle", "time": 20183.75, "timestamp": "05:36:23", "text": "どうすればそれができるのでしょうか？ H アーケードサーバー"}]
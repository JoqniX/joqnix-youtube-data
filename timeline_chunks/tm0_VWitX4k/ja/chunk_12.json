[{"type": "subtitle", "time": 723.11, "timestamp": "00:12:03", "text": "ホラー映画みたいに、"}, {"type": "subtitle", "time": 725.19, "timestamp": "00:12:05", "text": "私のお気に入り これは本当のホラーではない"}, {"type": "subtitle", "time": 729.269, "timestamp": "00:12:09", "text": "私の好きなホラー映画を当ててみて"}, {"type": "subtitle", "time": 733.43, "timestamp": "00:12:13", "text": "映画はソウです。私はソウが本当に好きです。"}, {"type": "subtitle", "time": 736.069, "timestamp": "00:12:16", "text": "うん。"}, {"type": "subtitle", "time": 740.47, "timestamp": "00:12:20", "text": "だから、私はまだ見ていないと思います。"}, {"type": "subtitle", "time": 742.71, "timestamp": "00:12:22", "text": "ちょっとグロテスクな描写があります。とてもグロテスクな作品です。その"}, {"type": "subtitle", "time": 747.269, "timestamp": "00:12:27", "text": "正直言って、すごくグロテスクです。は"}, {"type": "subtitle", "time": 749.35, "timestamp": "00:12:29", "text": "チェーンソーを持った男が"}, {"type": "subtitle", "time": 751.11, "timestamp": "00:12:31", "text": "あなたを殺すとか、そういうこと？のこぎりが付いています"}, {"type": "subtitle", "time": 753.35, "timestamp": "00:12:33", "text": "名前に。"}, {"type": "subtitle", "time": 755.509, "timestamp": "00:12:35", "text": "あれはチェーンソーだと思う"}, {"type": "subtitle", "time": 757.03, "timestamp": "00:12:37", "text": "虐殺。そして物語は、"}, {"type": "subtitle", "time": 760.15, "timestamp": "00:12:40", "text": "まるで老人のようで、彼はこんな風に"}, {"type": "subtitle", "time": 763.99, "timestamp": "00:12:43", "text": "この人形は木の人形で、彼は悪い"}, {"type": "subtitle", "time": 765.509, "timestamp": "00:12:45", "text": "人々は、とても献身的です"}, {"type": "subtitle", "time": 768.71, "timestamp": "00:12:48", "text": "凶悪犯罪などを罠にかける"}, {"type": "subtitle", "time": 771.269, "timestamp": "00:12:51", "text": "パズルみたいなものもあるし、"}, {"type": "subtitle", "time": 775.11, "timestamp": "00:12:55", "text": "何かを失って別の何かを得るようなもの。"}, {"type": "subtitle", "time": 778.15, "timestamp": "00:12:58", "text": "ああ、ほら、そのうちの1人が"}]
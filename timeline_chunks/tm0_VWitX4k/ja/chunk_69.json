[{"type": "subtitle", "time": 4141.99, "timestamp": "01:09:01", "text": "ロロ。"}, {"type": "subtitle", "time": 4157.749, "timestamp": "01:09:17", "text": "ああ、なんてことだ。あなたはどこから来たのですか？"}, {"type": "subtitle", "time": 4164.39, "timestamp": "01:09:24", "text": "同じように。"}, {"type": "subtitle", "time": 4167.189, "timestamp": "01:09:27", "text": "おい、それは最悪だよ。ああ、そうすべきじゃない"}, {"type": "subtitle", "time": 4169.99, "timestamp": "01:09:29", "text": "そこでそれを済ませました。"}, {"type": "subtitle", "time": 4180.309, "timestamp": "01:09:40", "text": "ああ、先に君を殺してもいいよ。何てことだ。"}, {"type": "subtitle", "time": 4183.59, "timestamp": "01:09:43", "text": "ええ、本当にたくさんやってくれましたね。どうやって手に入れたの？"}, {"type": "subtitle", "time": 4186.47, "timestamp": "01:09:46", "text": "5キル？"}, {"type": "subtitle", "time": 4189.59, "timestamp": "01:09:49", "text": "後方には選手たちがいた。私は満面の笑みを浮かべた"}, {"type": "subtitle", "time": 4191.51, "timestamp": "01:09:51", "text": "私たちが見たのは3つのチームだった。私は３人全員を殺した"}, {"type": "subtitle", "time": 4194.47, "timestamp": "01:09:54", "text": "当時私たちが目にしたものの中で。くそ。"}, {"type": "subtitle", "time": 4197.35, "timestamp": "01:09:57", "text": "ニース。"}, {"type": "subtitle", "time": 4199.43, "timestamp": "01:09:59", "text": "そして私は考えました、そして私は殺しました"}]
[{"type": "subtitle", "time": 6241.51, "timestamp": "01:44:01", "text": "文字通り、彼らは"}, {"type": "subtitle", "time": 6244.39, "timestamp": "01:44:04", "text": "レインボーシックス シージも"}, {"type": "subtitle", "time": 6250.39, "timestamp": "01:44:10", "text": "Wai Blitzとしてプレイできます。"}, {"type": "subtitle", "time": 6253.35, "timestamp": "01:44:13", "text": "TL Tero 発音できないけど、"}, {"type": "subtitle", "time": 6256.07, "timestamp": "01:44:16", "text": "リバー60年代のキャラクターのようにプレイする"}, {"type": "subtitle", "time": 6260.709, "timestamp": "01:44:20", "text": "わあ、そうですね。"}, {"type": "subtitle", "time": 6262.629, "timestamp": "01:44:22", "text": "でも、素晴らしいですね。でも、すごく楽しいよ。"}, {"type": "subtitle", "time": 6264.709, "timestamp": "01:44:24", "text": "大好きだよ。だから私はそれが好きなのです"}, {"type": "subtitle", "time": 6267.51, "timestamp": "01:44:27", "text": "だって、それは馬鹿げているから。そして彼らは"}, {"type": "subtitle", "time": 6269.51, "timestamp": "01:44:29", "text": "彼らは別のアニメとコラボレーションしている"}, {"type": "subtitle", "time": 6271.35, "timestamp": "01:44:31", "text": "すぐ。そして私はとても興奮しています。"}, {"type": "subtitle", "time": 6278.229, "timestamp": "01:44:38", "text": "アニメは、えーと、ナイト・オブ・ザ・"}, {"type": "subtitle", "time": 6281.59, "timestamp": "01:44:41", "text": "猫だと思う。そしてそれは恐ろしい"}, {"type": "subtitle", "time": 6285.59, "timestamp": "01:44:45", "text": "ゾンビみたいなアニメ"}, {"type": "subtitle", "time": 6287.43, "timestamp": "01:44:47", "text": "黙示録だが、ゾンビの代わりに"}, {"type": "subtitle", "time": 6295.109, "timestamp": "01:44:55", "text": "だからそれはまるでたくさんの猫みたい"}, {"type": "subtitle", "time": 6297.59, "timestamp": "01:44:57", "text": "猫のようにあなたを舐めるように感染する"}]
[{"type": "subtitle", "time": 12121.269, "timestamp": "03:22:01", "text": "発見可能性とか何か"}, {"type": "subtitle", "time": 12123.349, "timestamp": "03:22:03", "text": "人々が何を知ることができるかすべて"}, {"type": "subtitle", "time": 12126.469, "timestamp": "03:22:06", "text": "あなたは何かについて"}, {"type": "subtitle", "time": 12128.469, "timestamp": "03:22:08", "text": "などなど。なるほど。以前これを作ったことがあります"}, {"type": "subtitle", "time": 12132.07, "timestamp": "03:22:12", "text": "でも、私のデビュー作です。また、多くの人は"}, {"type": "subtitle", "time": 12136.55, "timestamp": "03:22:16", "text": "本当にそんなに頻繁に使うんですか？私は思う"}, {"type": "subtitle", "time": 12138.71, "timestamp": "03:22:18", "text": "人は自らを売り込むものだ。私はしません"}, {"type": "subtitle", "time": 12141.51, "timestamp": "03:22:21", "text": "人々はただそこにやって来て"}, {"type": "subtitle", "time": 12147.67, "timestamp": "03:22:27", "text": "[音楽]"}, {"type": "subtitle", "time": 12150.95, "timestamp": "03:22:30", "text": "ズリクは最上位にいます。何？うん、"}, {"type": "subtitle", "time": 12153.67, "timestamp": "03:22:33", "text": "彼女はそこにいる。はい。"}, {"type": "subtitle", "time": 12156.87, "timestamp": "03:22:36", "text": "トップの座は6月の金曜日だけのもの。"}, {"type": "subtitle", "time": 12159.51, "timestamp": "03:22:39", "text": "うん。"}, {"type": "subtitle", "time": 12162.55, "timestamp": "03:22:42", "text": "ええ、それは、ええと、"}, {"type": "subtitle", "time": 12165.67, "timestamp": "03:22:45", "text": "2020年3月。"}, {"type": "subtitle", "time": 12167.349, "timestamp": "03:22:47", "text": "ということで、毎日配信します。"}, {"type": "subtitle", "time": 12169.99, "timestamp": "03:22:49", "text": "その日まであと24時間。私はそう思う"}, {"type": "subtitle", "time": 12173.91, "timestamp": "03:22:53", "text": "落ち着いて。うん、"}, {"type": "subtitle", "time": 12175.91, "timestamp": "03:22:55", "text": "わからない。私は元の生活には戻れない"}, {"type": "subtitle", "time": 12179.429, "timestamp": "03:22:59", "text": "ただし、ストリーム配信です。私の体もああ"}]
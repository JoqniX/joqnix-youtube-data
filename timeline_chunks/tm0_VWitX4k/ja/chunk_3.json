[{"type": "subtitle", "time": 181.99, "timestamp": "00:03:01", "text": "離れていてもあまり効果はない。わかった？もしあなたが"}, {"type": "subtitle", "time": 184.63, "timestamp": "00:03:04", "text": "これを見て、目を合わせないでください。する"}, {"type": "subtitle", "time": 188.63, "timestamp": "00:03:08", "text": "走ったり、音を立てたりしないでください。わかった？"}, {"type": "subtitle", "time": 190.39, "timestamp": "00:03:10", "text": "誰も成し遂げられなかったという事実"}, {"type": "subtitle", "time": 192.55, "timestamp": "00:03:12", "text": "以下のエンティティの写真を撮る"}, {"type": "subtitle", "time": 194.63, "timestamp": "00:03:14", "text": "絵は複数のものから生成される"}, {"type": "subtitle", "time": 197.19, "timestamp": "00:03:17", "text": "証言。"}, {"type": "subtitle", "time": 199.35, "timestamp": "00:03:19", "text": "それを見かけたら、目を合わせないでください。"}, {"type": "subtitle", "time": 202.55, "timestamp": "00:03:22", "text": "そして、走ってはいけません。そして"}, {"type": "subtitle", "time": 205.589, "timestamp": "00:03:25", "text": "音を立てないでください。"}, {"type": "subtitle", "time": 210.149, "timestamp": "00:03:30", "text": "はい、あなたを信じています。はい、そうしましょう。私"}, {"type": "subtitle", "time": 212.55, "timestamp": "00:03:32", "text": "わからない。私たちはどこへ行くのですか？何ですか"}, {"type": "subtitle", "time": 218.22899999999998, "timestamp": "00:03:38", "text": "光がある。わかった。だめだ。だめだ。行かないで。"}, {"type": "subtitle", "time": 224.07, "timestamp": "00:03:44", "text": "わかった。彼は暗闇が好きだ。行かないでおこう"}, {"type": "subtitle", "time": 225.82999999999998, "timestamp": "00:03:45", "text": "そこには。ジョーカー先輩。来て。あ、待って。"}, {"type": "subtitle", "time": 228.55, "timestamp": "00:03:48", "text": "こっちですよね？これです。こちらです。"}, {"type": "subtitle", "time": 232.47, "timestamp": "00:03:52", "text": "こちらです。こちらです。わかった。"}, {"type": "subtitle", "time": 233.43, "timestamp": "00:03:53", "text": "ああ、何かある。私たちは何者なのか"}, {"type": "subtitle", "time": 235.03, "timestamp": "00:03:55", "text": "では、どうすればいいのでしょうか？まるで"}, {"type": "subtitle", "time": 238.309, "timestamp": "00:03:58", "text": "何らかの音が聞こえてくる。私たちは"}]
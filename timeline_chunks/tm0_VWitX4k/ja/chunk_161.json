[{"type": "subtitle", "time": 9664.95, "timestamp": "02:41:04", "text": "つまり、書くのは少し難しい"}, {"type": "subtitle", "time": 9667.51, "timestamp": "02:41:07", "text": "間違いだらけの日本語。うん。"}, {"type": "subtitle", "time": 9669.349, "timestamp": "02:41:09", "text": "真実。真実。"}, {"type": "subtitle", "time": 9671.67, "timestamp": "02:41:11", "text": "同じ文字が1つで、たくさんの意味を持つ"}, {"type": "subtitle", "time": 9677.75, "timestamp": "02:41:17", "text": "だから、"}, {"type": "subtitle", "time": 9679.67, "timestamp": "02:41:19", "text": "でもそうだね"}, {"type": "subtitle", "time": 9682.389, "timestamp": "02:41:22", "text": "まあ、そういうことだけど、うん、手に入れるよ"}, {"type": "subtitle", "time": 9686.95, "timestamp": "02:41:26", "text": "授業があるので、おそらくもっと忙しくなるでしょう"}, {"type": "subtitle", "time": 9689.19, "timestamp": "02:41:29", "text": "夜ですが、私はそこにいます"}, {"type": "subtitle", "time": 9690.79, "timestamp": "02:41:30", "text": "朝。これからどうなるかわかりません"}, {"type": "subtitle", "time": 9693.91, "timestamp": "02:41:33", "text": "音楽の授業で起こること。私は私は"}, {"type": "subtitle", "time": 9696.63, "timestamp": "02:41:36", "text": "音楽の授業。うん、音楽みたいな"}, {"type": "subtitle", "time": 9699.19, "timestamp": "02:41:39", "text": "Ableton Live用の制作ツール。あなた"}, {"type": "subtitle", "time": 9701.99, "timestamp": "02:41:41", "text": "そういうのが好きだったよね？だから私はこう思った"}, {"type": "subtitle", "time": 9704.55, "timestamp": "02:41:44", "text": "行き詰まってから、"}, {"type": "subtitle", "time": 9706.87, "timestamp": "02:41:46", "text": "チュートリアル動画などを見て、学んでいきます"}, {"type": "subtitle", "time": 9710.309, "timestamp": "02:41:50", "text": "残りの部分では、それは役に立ったが"}, {"type": "subtitle", "time": 9713.19, "timestamp": "02:41:53", "text": "またしても、私はその時間を正しく使っていません"}, {"type": "subtitle", "time": 9717.27, "timestamp": "02:41:57", "text": "学習へ。私はそれを行うことができます。うん。だから私は"}]
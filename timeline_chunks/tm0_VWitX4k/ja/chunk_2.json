[{"type": "subtitle", "time": 122.709, "timestamp": "00:02:02", "text": "うん。わかりました。私たちはただ"}, {"type": "subtitle", "time": 125.03, "timestamp": "00:02:05", "text": "点灯するまで待ってください。待って、"}, {"type": "subtitle", "time": 128.1, "timestamp": "00:02:08", "text": "あそこに何かがある。そうです。"}, {"type": "subtitle", "time": 131.67, "timestamp": "00:02:11", "text": "[音楽]"}, {"type": "subtitle", "time": 133.43, "timestamp": "00:02:13", "text": "体力に気を付けてください。それはあなたを救ってくれる"}, {"type": "subtitle", "time": 135.99, "timestamp": "00:02:15", "text": "死にかけている。だから、管理を確実にしてください"}, {"type": "subtitle", "time": 140.15, "timestamp": "00:02:20", "text": "それは正しい。わかった。エンティティ8について。おお"}, {"type": "subtitle", "time": 144.39, "timestamp": "00:02:24", "text": "いや、それは人間用の犬みたいなものだよ。"}, {"type": "subtitle", "time": 152.309, "timestamp": "00:02:32", "text": "とても奇妙でかわいい生き物が"}, {"type": "subtitle", "time": 155.35, "timestamp": "00:02:35", "text": "アヒルの中から出てくるのが目撃された"}, {"type": "subtitle", "time": 159.27, "timestamp": "00:02:39", "text": "奥の部屋で。これは心理戦だ"}, {"type": "subtitle", "time": 161.43, "timestamp": "00:02:41", "text": "それは生理学的な類似性です"}, {"type": "subtitle", "time": 164.22899999999998, "timestamp": "00:02:44", "text": "人型の特徴を持つアヒル。その"}, {"type": "subtitle", "time": 166.63, "timestamp": "00:02:46", "text": "非常に"}, {"type": "subtitle", "time": 168.55, "timestamp": "00:02:48", "text": "攻撃的で危険だが、"}, {"type": "subtitle", "time": 171.91, "timestamp": "00:02:51", "text": "騒音にイライラし、"}, {"type": "subtitle", "time": 174.309, "timestamp": "00:02:54", "text": "直接目を合わせる。"}, {"type": "subtitle", "time": 176.63, "timestamp": "00:02:56", "text": "その顔を見ると、その顔は"}, {"type": "subtitle", "time": 179.27, "timestamp": "00:02:59", "text": "賢く行動しよう。走る時"}]
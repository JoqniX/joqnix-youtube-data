[{"type": "subtitle", "time": 19809.81, "timestamp": "05:30:09", "text": "ねえ、ゲーム内のマイクがオンになってるよ。"}, {"type": "subtitle", "time": 19815.19, "timestamp": "05:30:15", "text": "[音楽]"}, {"type": "subtitle", "time": 19819.03, "timestamp": "05:30:19", "text": "おい、二重癌だぞ。"}, {"type": "subtitle", "time": 19821.19, "timestamp": "05:30:21", "text": "わかった、"}, {"type": "subtitle", "time": 19827.03, "timestamp": "05:30:27", "text": "期間限定。はい、これは正解です。"}, {"type": "subtitle", "time": 19830.868, "timestamp": "05:30:30", "text": "期間限定。何をすべきか？"}, {"type": "subtitle", "time": 19832.868, "timestamp": "05:30:32", "text": "始めたばかりです。彼らは何人かの人を見つけた。私"}, {"type": "subtitle", "time": 19838.23, "timestamp": "05:30:38", "text": "ここで1対1の試合をすることもできたはずだ。"}, {"type": "subtitle", "time": 19850.788, "timestamp": "05:30:50", "text": "[音楽]"}, {"type": "subtitle", "time": 19853.35, "timestamp": "05:30:53", "text": "奥の部屋。"}]
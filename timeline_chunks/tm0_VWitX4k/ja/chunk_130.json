[{"type": "subtitle", "time": 7801.27, "timestamp": "02:10:01", "text": "うん。こんにちは。まあ。ごきげんよう？"}, {"type": "subtitle", "time": 7804.149, "timestamp": "02:10:04", "text": "ほら、私の叔父のローランドは、"}, {"type": "subtitle", "time": 7806.39, "timestamp": "02:10:06", "text": "ゴブリン社会ではよく知られている。彼"}, {"type": "subtitle", "time": 7808.79, "timestamp": "02:10:08", "text": "普段は彼が"}, {"type": "subtitle", "time": 7811.43, "timestamp": "02:10:11", "text": "出張。最後のフクロウで、彼は"}, {"type": "subtitle", "time": 7813.189, "timestamp": "02:10:13", "text": "過激派との取引をほのめかした"}, {"type": "subtitle", "time": 7816.709, "timestamp": "02:10:16", "text": "ゴブリン。過激なゴブリンたち。ああ、"}, {"type": "subtitle", "time": 7818.87, "timestamp": "02:10:18", "text": "あのフクロウの事件からずいぶん時間が経ちましたが、心配です。"}, {"type": "subtitle", "time": 7821.189, "timestamp": "02:10:21", "text": "噂に対する荒らしの攻撃があったので"}, {"type": "subtitle", "time": 7823.109, "timestamp": "02:10:23", "text": "ゴブリンが関わっていた可能性もある？による"}, {"type": "subtitle", "time": 7824.87, "timestamp": "02:10:24", "text": "私が実験してきた方法で"}, {"type": "subtitle", "time": 7827.589, "timestamp": "02:10:27", "text": "最近何か新しいことがありました。見てみたいの？"}, {"type": "subtitle", "time": 7831.35, "timestamp": "02:10:31", "text": "こんな感じです。"}, {"type": "subtitle", "time": 7833.589, "timestamp": "02:10:33", "text": "こんな感じになります。集中する"}, {"type": "subtitle", "time": 7837.03, "timestamp": "02:10:37", "text": "私のモデルについて少し考えてみましょう。わかった。見た目"}, {"type": "subtitle", "time": 7840.229, "timestamp": "02:10:40", "text": "このような。 D 私は文字通り手に入れることができます"}, {"type": "subtitle", "time": 7843.03, "timestamp": "02:10:43", "text": "ピクセル化された。"}, {"type": "subtitle", "time": 7846.31, "timestamp": "02:10:46", "text": "これを見てください。これはピクセル作業で、私は"}, {"type": "subtitle", "time": 7849.589, "timestamp": "02:10:49", "text": "移動してさまざまなバージョンを作成する"}, {"type": "subtitle", "time": 7852.149, "timestamp": "02:10:52", "text": "私の。"}]
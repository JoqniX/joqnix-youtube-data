[{"type": "subtitle", "time": 6662.39, "timestamp": "01:51:02", "text": "幽霊みたいなものがいた。"}, {"type": "subtitle", "time": 6664.629, "timestamp": "01:51:04", "text": "うん。うん。つまり、犯人は幽霊だったということか。"}, {"type": "subtitle", "time": 6674.55, "timestamp": "01:51:14", "text": "彼はそうみたいだ。"}, {"type": "subtitle", "time": 6677.43, "timestamp": "01:51:17", "text": "ええ、彼は私の上に座っているんです。"}, {"type": "subtitle", "time": 6680.629, "timestamp": "01:51:20", "text": "おそらく私のところには来られないだろう。お知らせ下さい"}, {"type": "subtitle", "time": 6684.31, "timestamp": "01:51:24", "text": "良い葉があれば。"}, {"type": "subtitle", "time": 6686.55, "timestamp": "01:51:26", "text": "えっと、"}, {"type": "subtitle", "time": 6688.87, "timestamp": "01:51:28", "text": "問題は、私にはできないということです。ああ、彼は、彼は、彼は"}, {"type": "subtitle", "time": 6689.99, "timestamp": "01:51:29", "text": "あなたに向かってきています。彼はこちらに向かってきている"}, {"type": "subtitle", "time": 6696.55, "timestamp": "01:51:36", "text": "ああ、彼は今あなたのところへ来ていますよ。ええ、彼は"}, {"type": "subtitle", "time": 6699.51, "timestamp": "01:51:39", "text": "あなたに向かってきています。だから、彼は、彼は、彼は"}, {"type": "subtitle", "time": 6700.709, "timestamp": "01:51:40", "text": "おそらく私のところには来られないので、"}, {"type": "subtitle", "time": 6704.07, "timestamp": "01:51:44", "text": "逃げる。ああ、あの戦い"}, {"type": "subtitle", "time": 6707.35, "timestamp": "01:51:47", "text": "音楽が始まった。何てことだ。うん。うん、"}, {"type": "subtitle", "time": 6709.669, "timestamp": "01:51:49", "text": "だって彼はあなたの近くにいるから。うん。それで、えーと"}, {"type": "subtitle", "time": 6711.27, "timestamp": "01:51:51", "text": "追跡シーンにぴったりの音楽だ。幸運なことに、それは"}, {"type": "subtitle", "time": 6713.43, "timestamp": "01:51:53", "text": "良い指標だ。彼はキャンプをしている。彼はそうだ。"}]
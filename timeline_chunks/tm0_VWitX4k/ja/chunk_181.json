[{"type": "subtitle", "time": 10860.79, "timestamp": "03:01:00", "text": "彼らは音楽レーベルのスタジオのようなものですが、"}, {"type": "subtitle", "time": 10862.79, "timestamp": "03:01:02", "text": "ええ、彼らは"}, {"type": "subtitle", "time": 10864.389, "timestamp": "03:01:04", "text": "えっと"}, {"type": "subtitle", "time": 10867.11, "timestamp": "03:01:07", "text": "うん、彼らはテイクを変えた"}, {"type": "subtitle", "time": 10869.51, "timestamp": "03:01:09", "text": "時間。"}, {"type": "subtitle", "time": 10872.55, "timestamp": "03:01:12", "text": "こういうのが大好きなんです"}, {"type": "subtitle", "time": 10874.63, "timestamp": "03:01:14", "text": "ミュージックビデオを作りたいし"}, {"type": "subtitle", "time": 10876.389, "timestamp": "03:01:16", "text": "音楽ステージとか、そういうの全部"}, {"type": "subtitle", "time": 10878.71, "timestamp": "03:01:18", "text": "これだが、そのためには良いものが必要だ"}, {"type": "subtitle", "time": 10882.15, "timestamp": "03:01:22", "text": "3Dモデル。いや、それは正気の沙汰ではない。"}, {"type": "subtitle", "time": 10886.309, "timestamp": "03:01:26", "text": "ええ、Blenderタイプのカスタムモデルですね。"}, {"type": "subtitle", "time": 10888.95, "timestamp": "03:01:28", "text": "はい。さよなら。誰かを好きになる必要がある"}, {"type": "subtitle", "time": 10891.11, "timestamp": "03:01:31", "text": "アニメーションを作るなどして努力する"}, {"type": "subtitle", "time": 10895.429, "timestamp": "03:01:35", "text": "もの。はい。または、MMDのようなものを使用することもできます。"}, {"type": "subtitle", "time": 10899.269, "timestamp": "03:01:39", "text": "はい。はい。はい。はい。うん。"}, {"type": "subtitle", "time": 10901.429, "timestamp": "03:01:41", "text": "それで"}, {"type": "subtitle", "time": 10903.75, "timestamp": "03:01:43", "text": "なぜMMDはミクミクダンスのようなものなのか"}, {"type": "subtitle", "time": 10905.99, "timestamp": "03:01:45", "text": "どうにか？何？"}, {"type": "subtitle", "time": 10910.15, "timestamp": "03:01:50", "text": "うん。 MMDはミクミクダンスです。"}, {"type": "subtitle", "time": 10915.59, "timestamp": "03:01:55", "text": "ところで、どうやってこの名前をつけたんだろう？"}]
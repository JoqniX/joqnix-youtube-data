[{"type": "subtitle", "time": 3300.79, "timestamp": "00:55:00", "text": "作品。何てことだ。あなたはそうしました"}, {"type": "subtitle", "time": 3303.99, "timestamp": "00:55:03", "text": "すべて。あなた"}, {"type": "subtitle", "time": 3307.349, "timestamp": "00:55:07", "text": "私はできる限り受け取るように努力していました"}, {"type": "subtitle", "time": 3310.23, "timestamp": "00:55:10", "text": "動作が非常に遅かったにもかかわらず、ダメージを与えた。しかし"}, {"type": "subtitle", "time": 3317.99, "timestamp": "00:55:17", "text": "それは正気の沙汰ではない。ああ、大変だ。何てことだ。"}, {"type": "subtitle", "time": 3327.03, "timestamp": "00:55:27", "text": "リク。わかった。わかった。愛に戻らせてください"}, {"type": "subtitle", "time": 3336.79, "timestamp": "00:55:36", "text": "私には何の利益もありません。それはとても"}, {"type": "subtitle", "time": 3340.309, "timestamp": "00:55:40", "text": "恥。いいえ。ああ、そうですね。パックについては、"}, {"type": "subtitle", "time": 3344.71, "timestamp": "00:55:44", "text": "火花みたいなやつを作ったんだよね？"}, {"type": "subtitle", "time": 3346.95, "timestamp": "00:55:46", "text": "ボーナス。"}, {"type": "subtitle", "time": 3349.27, "timestamp": "00:55:49", "text": "うん、"}, {"type": "subtitle", "time": 3352.549, "timestamp": "00:55:52", "text": "かっこいい。"}, {"type": "subtitle", "time": 3355.51, "timestamp": "00:55:55", "text": "私はあなたに使命を与えます"}, {"type": "subtitle", "time": 3358.789, "timestamp": "00:55:58", "text": "えっと、なんて言うんでしたっけ？"}]
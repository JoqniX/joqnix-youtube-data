[{"type": "subtitle", "time": 13083.99, "timestamp": "03:38:03", "text": "私はその件で場所を確保しました。私は"}, {"type": "subtitle", "time": 13102.95, "timestamp": "03:38:22", "text": "たくさんの新作ゲームが登場する。"}, {"type": "subtitle", "time": 13105.429, "timestamp": "03:38:25", "text": "えっと、これ"}, {"type": "subtitle", "time": 13107.91, "timestamp": "03:38:27", "text": "抽出をプレイするのが楽しみです"}, {"type": "subtitle", "time": 13111.51, "timestamp": "03:38:31", "text": "シューティングゲーム、マラソンみたいなやつだよね？"}, {"type": "subtitle", "time": 13117.59, "timestamp": "03:38:37", "text": "ああ、もしよければプレイしてもいいけど、えっと"}, {"type": "subtitle", "time": 13119.83, "timestamp": "03:38:39", "text": "まだ発売されていません。ああ、もうすぐだ"}, {"type": "subtitle", "time": 13121.91, "timestamp": "03:38:41", "text": "9月。しかし、料金を支払わなければなりません。ああ、"}, {"type": "subtitle", "time": 13126.15, "timestamp": "03:38:46", "text": "それが問題なのです。ああ、無料ではないんです。"}, {"type": "subtitle", "time": 13128.229, "timestamp": "03:38:48", "text": "君はバンジーのファンだ。"}, {"type": "subtitle", "time": 13139.51, "timestamp": "03:38:59", "text": "AIを搭載した新しいブラウザを見ましたか？"}]
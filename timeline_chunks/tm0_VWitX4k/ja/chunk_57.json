[{"type": "subtitle", "time": 3420.15, "timestamp": "00:57:00", "text": "待って、これって非現実的なこと？私は"}, {"type": "subtitle", "time": 3421.75, "timestamp": "00:57:01", "text": "失った"}, {"type": "subtitle", "time": 3424.47, "timestamp": "00:57:04", "text": "そして私は宙に浮いていて、"}, {"type": "subtitle", "time": 3426.95, "timestamp": "00:57:06", "text": "道に迷いました。それで、私は"}, {"type": "subtitle", "time": 3428.549, "timestamp": "00:57:08", "text": "それ。私は走った。私の言った通りだった。いいえ、それは"}, {"type": "subtitle", "time": 3430.39, "timestamp": "00:57:10", "text": "大丈夫。レース自体は構いません。"}, {"type": "subtitle", "time": 3438.15, "timestamp": "00:57:18", "text": "ああ、あなただけだよ。ニース。"}, {"type": "subtitle", "time": 3440.47, "timestamp": "00:57:20", "text": "私はジャンプマスターです。どこに行くか知っています"}, {"type": "subtitle", "time": 3442.15, "timestamp": "00:57:22", "text": "土地。私は手放します。わからない"}, {"type": "subtitle", "time": 3446.069, "timestamp": "00:57:26", "text": "着陸地点。ああ、あの人だ。おお、"}, {"type": "subtitle", "time": 3448.789, "timestamp": "00:57:28", "text": "いい感じのホットドロップ。"}, {"type": "subtitle", "time": 3450.63, "timestamp": "00:57:30", "text": "いいえ、ホットドロップ側です。私たちは、"}, {"type": "subtitle", "time": 3455.03, "timestamp": "00:57:35", "text": "大丈夫です。ええ、大丈夫です。チーム"}, {"type": "subtitle", "time": 3457.109, "timestamp": "00:57:37", "text": "おそらく反対側に着陸するだろう"}, {"type": "subtitle", "time": 3459.27, "timestamp": "00:57:39", "text": "側。取り返せ。敵が降りてきた"}, {"type": "subtitle", "time": 3471.589, "timestamp": "00:57:51", "text": "ああ、ラグはそれほどひどくなかった。"}]
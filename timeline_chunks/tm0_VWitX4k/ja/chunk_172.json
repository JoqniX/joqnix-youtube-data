[{"type": "subtitle", "time": 10324.55, "timestamp": "02:52:04", "text": "とても悲しい。人を見つけるたびに、私はただ"}, {"type": "subtitle", "time": 10328.389, "timestamp": "02:52:08", "text": "「こんにちは、お会いできて嬉しいです、同志」"}, {"type": "subtitle", "time": 10330.79, "timestamp": "02:52:10", "text": "インド人ユーチューバー。頑張ってください"}, {"type": "subtitle", "time": 10332.389, "timestamp": "02:52:12", "text": "旅。幸運を祈っています。"}, {"type": "subtitle", "time": 10335.03, "timestamp": "02:52:15", "text": "それ。"}, {"type": "subtitle", "time": 10339.11, "timestamp": "02:52:19", "text": "購読してこのサーバーに参加しました。"}, {"type": "subtitle", "time": 10340.95, "timestamp": "02:52:20", "text": "私はあまり人と交流しません。私は親切です"}, {"type": "subtitle", "time": 10343.51, "timestamp": "02:52:23", "text": "内気な。"}, {"type": "subtitle", "time": 10346.309, "timestamp": "02:52:26", "text": "同じ。私も運がいい方で"}, {"type": "subtitle", "time": 10348.15, "timestamp": "02:52:28", "text": "分隊サーバー。私はただそこにいるべきだ"}, {"type": "subtitle", "time": 10349.99, "timestamp": "02:52:29", "text": "そして見て。"}, {"type": "subtitle", "time": 10353.19, "timestamp": "02:52:33", "text": "昔は、何かを調べていたのかもしれません"}, {"type": "subtitle", "time": 10355.51, "timestamp": "02:52:35", "text": "そこにいるとか、話したり、ポップしたりするような"}, {"type": "subtitle", "time": 10361.67, "timestamp": "02:52:41", "text": "[音楽]"}, {"type": "subtitle", "time": 10363.429, "timestamp": "02:52:43", "text": "それが私が星空を描くためにやったことです"}, {"type": "subtitle", "time": 10366.469, "timestamp": "02:52:46", "text": "あれ。ご覧になったことがあるかもしれません"}, {"type": "subtitle", "time": 10369.67, "timestamp": "02:52:49", "text": "時々、私は入力してポップアップします"}, {"type": "subtitle", "time": 10371.51, "timestamp": "02:52:51", "text": "チャット"}, {"type": "subtitle", "time": 10379.99, "timestamp": "02:52:59", "text": "ほとんどの人にとって、それは単なる偶然に過ぎない。"}]
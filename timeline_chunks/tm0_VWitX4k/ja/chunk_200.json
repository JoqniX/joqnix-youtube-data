[{"type": "subtitle", "time": 12001.51, "timestamp": "03:20:01", "text": "今年は中止となりました。だから誰もが"}, {"type": "subtitle", "time": 12004.55, "timestamp": "03:20:04", "text": "来年も新鮮な気持ちで"}, {"type": "subtitle", "time": 12008.469, "timestamp": "03:20:08", "text": "4月バッチからのような年"}, {"type": "subtitle", "time": 12010.55, "timestamp": "03:20:10", "text": "新年を迎えるので、2年後"}, {"type": "subtitle", "time": 12014.389, "timestamp": "03:20:14", "text": "そうですね、7月入学組は1年9ヶ月になります"}, {"type": "subtitle", "time": 12018.63, "timestamp": "03:20:18", "text": "数ヶ月後、10月のバッチは、えっと、"}, {"type": "subtitle", "time": 12023.19, "timestamp": "03:20:23", "text": "えっと、1年6ヶ月くらいかな"}, {"type": "subtitle", "time": 12025.75, "timestamp": "03:20:25", "text": "そうですね、12月分は9人になります"}, {"type": "subtitle", "time": 12028.15, "timestamp": "03:20:28", "text": "数ヶ月かそれくらい"}, {"type": "subtitle", "time": 12030.309, "timestamp": "03:20:30", "text": "そんな感じ、それが彼らのやり方"}, {"type": "subtitle", "time": 12032.309, "timestamp": "03:20:32", "text": "問題はそこだ。"}, {"type": "subtitle", "time": 12034.95, "timestamp": "03:20:34", "text": "だから私は、人々がこう思うように行く"}, {"type": "subtitle", "time": 12037.59, "timestamp": "03:20:37", "text": "彼らは7月を優先するだろう"}, {"type": "subtitle", "time": 12041.03, "timestamp": "03:20:41", "text": "摂取量の影響を受けた人々。そう、だから私は"}, {"type": "subtitle", "time": 12043.67, "timestamp": "03:20:43", "text": "4月入学時に送付されます。それで"}, {"type": "subtitle", "time": 12045.99, "timestamp": "03:20:45", "text": "そのため、私は"}, {"type": "subtitle", "time": 12050.07, "timestamp": "03:20:50", "text": "必要な資金を調達するための目標を達成しました"}, {"type": "subtitle", "time": 12053.75, "timestamp": "03:20:53", "text": "モデルのリギングやその他すべて。えっと"}, {"type": "subtitle", "time": 12057.19, "timestamp": "03:20:57", "text": "リガーとリガーの両方が"}]
[{"type": "subtitle", "time": 9844.23, "timestamp": "02:44:04", "text": "今はパソコンのことがもっと心配です"}, {"type": "subtitle", "time": 9848.23, "timestamp": "02:44:08", "text": "だって私は24時間365日それをやってるから"}, {"type": "subtitle", "time": 9851.67, "timestamp": "02:44:11", "text": "今。そして、"}, {"type": "subtitle", "time": 9853.349, "timestamp": "02:44:13", "text": "うん。そして、唯一"}, {"type": "subtitle", "time": 9856.63, "timestamp": "02:44:16", "text": "爆発したり、崩壊したりするような"}, {"type": "subtitle", "time": 9859.99, "timestamp": "02:44:19", "text": "まずモニターから。ああ、なんてことだ、私は"}, {"type": "subtitle", "time": 9865.91, "timestamp": "02:44:25", "text": "うん。パネルが何もしないことを願うばかりです"}, {"type": "subtitle", "time": 9868.469, "timestamp": "02:44:28", "text": "パネルに再び同じことが起こる。もし私がそうしなければならなかったら"}, {"type": "subtitle", "time": 9871.51, "timestamp": "02:44:31", "text": "2回修理したら、"}, {"type": "subtitle", "time": 9874.95, "timestamp": "02:44:34", "text": "今すぐ保証を受けましょう。はい。 2回"}, {"type": "subtitle", "time": 9878.63, "timestamp": "02:44:38", "text": "修理して、えっと、やらなきゃいけなかったんです。ええ、それは"}, {"type": "subtitle", "time": 9881.269, "timestamp": "02:44:41", "text": "保証も付いています。だから、もし私がそれを失くしたら、私は負ける。"}, {"type": "subtitle", "time": 9885.59, "timestamp": "02:44:45", "text": "それ。それを失う。そしてPC用"}, {"type": "subtitle", "time": 9889.429, "timestamp": "02:44:49", "text": "あれ、キャビネット、ガラス製。いいえ、"}, {"type": "subtitle", "time": 9892.389, "timestamp": "02:44:52", "text": "粉々に砕け散ったパネル。"}, {"type": "subtitle", "time": 9895.99, "timestamp": "02:44:55", "text": "それは粉々に砕け散った。ああ、それは粉々に砕け散った。"}, {"type": "subtitle", "time": 9897.99, "timestamp": "02:44:57", "text": "暑さのせいなのか、それとも何のせいなのか？いいえ、"}]
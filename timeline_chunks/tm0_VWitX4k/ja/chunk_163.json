[{"type": "subtitle", "time": 9782.15, "timestamp": "02:43:02", "text": "それ。両親は、"}, {"type": "subtitle", "time": 9785.67, "timestamp": "02:43:05", "text": "日本はIGNU関連のことをしているようなものだ"}, {"type": "subtitle", "time": 9788.71, "timestamp": "02:43:08", "text": "だから英語の学士号、うん、英語"}, {"type": "subtitle", "time": 9791.75, "timestamp": "02:43:11", "text": "文学の栄誉は、"}, {"type": "subtitle", "time": 9795.51, "timestamp": "02:43:15", "text": "日本語の授業があり、あなたは自分の"}, {"type": "subtitle", "time": 9799.99, "timestamp": "02:43:19", "text": "ストリーミングとか全部、そして今私は"}, {"type": "subtitle", "time": 9804.55, "timestamp": "02:43:24", "text": "うん、バランスを取らなきゃいけなかった5つのこと"}, {"type": "subtitle", "time": 9807.429, "timestamp": "02:43:27", "text": "どうやってもわからない どうやってもわからない"}, {"type": "subtitle", "time": 9810.23, "timestamp": "02:43:30", "text": "私は死んだ。"}, {"type": "subtitle", "time": 9818.79, "timestamp": "02:43:38", "text": "でも、今でも私は、えっと、ほら、私は"}, {"type": "subtitle", "time": 9821.99, "timestamp": "02:43:41", "text": "ある意味、少なくとも"}, {"type": "subtitle", "time": 9824.389, "timestamp": "02:43:44", "text": "ジョアトンとその他すべてを拡張して、"}, {"type": "subtitle", "time": 9827.19, "timestamp": "02:43:47", "text": "毎日ストリーミングを続けてみてください"}, {"type": "subtitle", "time": 9830.07, "timestamp": "02:43:50", "text": "それはかなり良いですね。ええ、でも"}, {"type": "subtitle", "time": 9832.95, "timestamp": "02:43:52", "text": "唯一の問題は、私がこれまでずっと"}, {"type": "subtitle", "time": 9835.429, "timestamp": "02:43:55", "text": "私が去ることを期待してストリーミング配信"}, {"type": "subtitle", "time": 9839.51, "timestamp": "02:43:59", "text": "来月は日本です。しかし実際には、"}]
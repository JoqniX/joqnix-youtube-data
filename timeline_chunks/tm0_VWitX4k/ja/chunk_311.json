[{"type": "subtitle", "time": 18672.708, "timestamp": "05:11:12", "text": "何？ああ、あなたは「ああ、なんてことだ」を持っています。はい。"}, {"type": "subtitle", "time": 18674.23, "timestamp": "05:11:14", "text": "矢は、もしあなたが望むなら、より多くのダメージを与えます"}, {"type": "subtitle", "time": 18686.55, "timestamp": "05:11:26", "text": "[音楽]"}, {"type": "subtitle", "time": 18719.43, "timestamp": "05:11:59", "text": "何てことだ。死にかけた。"}]
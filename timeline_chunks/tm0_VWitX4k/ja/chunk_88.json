[{"type": "subtitle", "time": 5280.79, "timestamp": "01:28:00", "text": "分"}, {"type": "subtitle", "time": 5283.43, "timestamp": "01:28:03", "text": "せいぜいその程度だ。"}, {"type": "subtitle", "time": 5286.87, "timestamp": "01:28:06", "text": "見つけた。大丈夫だよ。"}, {"type": "subtitle", "time": 5289.43, "timestamp": "01:28:09", "text": "ああ、左クリックしちゃった。あったと思う"}, {"type": "subtitle", "time": 5291.75, "timestamp": "01:28:11", "text": "カットシーン。おお、"}, {"type": "subtitle", "time": 5292.87, "timestamp": "01:28:12", "text": "大丈夫だよ。あなたはそうする必要はありません"}, {"type": "subtitle", "time": 5294.55, "timestamp": "01:28:14", "text": "カットシーンをご覧ください。私はしなければならない"}, {"type": "subtitle", "time": 5296.709, "timestamp": "01:28:16", "text": "チュートリアル。"}, {"type": "subtitle", "time": 5300.87, "timestamp": "01:28:20", "text": "いいえ。ああ、チュートリアルはできますよ。"}, {"type": "subtitle", "time": 5309.57, "timestamp": "01:28:29", "text": "いや、待って。ロビーには入れません。"}, {"type": "subtitle", "time": 5311.83, "timestamp": "01:28:31", "text": "[音楽]"}, {"type": "subtitle", "time": 5315.35, "timestamp": "01:28:35", "text": "いや、冗談でしょう。"}, {"type": "subtitle", "time": 5317.75, "timestamp": "01:28:37", "text": "チュートリアルをやらなければなりません。"}, {"type": "subtitle", "time": 5321.03, "timestamp": "01:28:41", "text": "ああ、なんてことだ。"}, {"type": "subtitle", "time": 5324.149, "timestamp": "01:28:44", "text": "何てことだ。"}, {"type": "subtitle", "time": 5328.149, "timestamp": "01:28:48", "text": "なぜ最高設定になっているのですか？何てことだ。グラフィック。"}, {"type": "subtitle", "time": 5331.03, "timestamp": "01:28:51", "text": "うん。ああ、ウルトラって書いてある。あなたは私の"}, {"type": "subtitle", "time": 5337.59, "timestamp": "01:28:57", "text": "非常識な。"}]
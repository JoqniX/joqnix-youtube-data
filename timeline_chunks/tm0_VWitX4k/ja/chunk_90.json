[{"type": "subtitle", "time": 5400.629, "timestamp": "01:30:00", "text": "そういうことですよね？タイミングが重要だ。"}, {"type": "subtitle", "time": 5402.79, "timestamp": "01:30:02", "text": "そうそう。うん。たくさんのたくさんの"}, {"type": "subtitle", "time": 5409.189, "timestamp": "01:30:09", "text": "白い部分を手に入れる必要はありません"}, {"type": "subtitle", "time": 5412.59, "timestamp": "01:30:12", "text": "それ。そのセリフをマスターすればいいんです。"}, {"type": "subtitle", "time": 5428.149, "timestamp": "01:30:28", "text": "最後の発電機を修理してください。"}, {"type": "subtitle", "time": 5430.07, "timestamp": "01:30:30", "text": "捕まったぞ。"}, {"type": "subtitle", "time": 5438.39, "timestamp": "01:30:38", "text": "ああ、殺害予告の手紙。ええ、でも、ああ"}, {"type": "subtitle", "time": 5441.75, "timestamp": "01:30:41", "text": "我が神よ。犯人を発見した。ええ、そうですね。それで"}, {"type": "subtitle", "time": 5443.51, "timestamp": "01:30:43", "text": "この殺人犯は、あなたがショーを好きであることを示している"}, {"type": "subtitle", "time": 5445.59, "timestamp": "01:30:45", "text": "殺人者ができることを気に入って、"}, {"type": "subtitle", "time": 5447.27, "timestamp": "01:30:47", "text": "それら全て。"}]
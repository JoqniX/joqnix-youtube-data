[{"type": "subtitle", "time": 4080.549, "timestamp": "01:08:00", "text": "彼が屋上に行くためだった。"}, {"type": "subtitle", "time": 4082.789, "timestamp": "01:08:02", "text": "それはとても興味深いですね"}, {"type": "subtitle", "time": 4094.069, "timestamp": "01:08:14", "text": "ええ、彼らはそれをジャンプするように作ったんです"}, {"type": "subtitle", "time": 4096.07, "timestamp": "01:08:16", "text": "パッドはもう死なないみたいな感じ。"}, {"type": "subtitle", "time": 4097.269, "timestamp": "01:08:17", "text": "以前はクールダウンのようなものがあった"}, {"type": "subtitle", "time": 4100.309, "timestamp": "01:08:20", "text": "これらのもの。ああ、"}, {"type": "subtitle", "time": 4112.309, "timestamp": "01:08:32", "text": "それは誰かだと思う。それは人々だ"}, {"type": "subtitle", "time": 4130.95, "timestamp": "01:08:50", "text": "私たちの頭上。"}, {"type": "subtitle", "time": 4139.749, "timestamp": "01:08:59", "text": "何てことだ。"}]
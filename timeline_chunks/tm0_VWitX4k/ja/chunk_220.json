[{"type": "subtitle", "time": 13201.75, "timestamp": "03:40:01", "text": "あと、彼らは「えっと、何だったかな」みたいなのも作ったんだよね"}, {"type": "subtitle", "time": 13204.469, "timestamp": "03:40:04", "text": "それはすべての要約と"}, {"type": "subtitle", "time": 13206.63, "timestamp": "03:40:06", "text": "例えば、あなたがプレイしていたゲームに関する情報など。"}, {"type": "subtitle", "time": 13211.91, "timestamp": "03:40:11", "text": "ああ、"}, {"type": "subtitle", "time": 13222.95, "timestamp": "03:40:22", "text": "のために"}, {"type": "subtitle", "time": 13230.469, "timestamp": "03:40:30", "text": "私の"}, {"type": "subtitle", "time": 13240.79, "timestamp": "03:40:40", "text": "広告。"}, {"type": "subtitle", "time": 13250.79, "timestamp": "03:40:50", "text": "あれ、私、あなたのゲームに参加したっけ？"}]
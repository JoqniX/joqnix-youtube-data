[{"type": "subtitle", "time": 3849.109, "timestamp": "01:04:09", "text": "そして、強化すれば、"}, {"type": "subtitle", "time": 3851.029, "timestamp": "01:04:11", "text": "その機械。よろしければEをクリックしてください"}, {"type": "subtitle", "time": 3853.109, "timestamp": "01:04:13", "text": "その側面。"}, {"type": "subtitle", "time": 3854.789, "timestamp": "01:04:14", "text": "小さな緑色の四角形が見えますか"}, {"type": "subtitle", "time": 3856.71, "timestamp": "01:04:16", "text": "側？うん。強化できるなら"}, {"type": "subtitle", "time": 3871.91, "timestamp": "01:04:31", "text": "ああ、無料のものがもらえるよ。"}, {"type": "subtitle", "time": 3873.349, "timestamp": "01:04:33", "text": "そう、スコープとかそういうのが手に入るんだよ。"}, {"type": "subtitle", "time": 3875.19, "timestamp": "01:04:35", "text": "うん。しかし、そうするとあなたは"}, {"type": "subtitle", "time": 3876.39, "timestamp": "01:04:36", "text": "その件の責任。でも、"}, {"type": "subtitle", "time": 3879.349, "timestamp": "01:04:39", "text": "別の軽弾薬のように、軽"}, {"type": "subtitle", "time": 3882.39, "timestamp": "01:04:42", "text": "弾薬1つですよね？"}, {"type": "subtitle", "time": 3885.43, "timestamp": "01:04:45", "text": "うわあ、それはすごい。私たちは外にいます"}, {"type": "subtitle", "time": 3887.75, "timestamp": "01:04:47", "text": "楽しむために鳴らす。そして、あなたはそれを押すことができます"}, {"type": "subtitle", "time": 3890.309, "timestamp": "01:04:50", "text": "例えば、4つ見つけたり"}, {"type": "subtitle", "time": 3891.91, "timestamp": "01:04:51", "text": "3つは、最後まで押し込むことができます"}, {"type": "subtitle", "time": 3896.61, "timestamp": "01:04:56", "text": "軽弾薬へ。つまり、金色のアイテムのことです。"}]
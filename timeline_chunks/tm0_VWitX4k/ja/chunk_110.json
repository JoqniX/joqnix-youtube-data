[{"type": "subtitle", "time": 6600.47, "timestamp": "01:50:00", "text": "一番近い窓まで走る"}, {"type": "subtitle", "time": 6602.95, "timestamp": "01:50:02", "text": "などなど。通常はチャンスが高い"}, {"type": "subtitle", "time": 6611.03, "timestamp": "01:50:11", "text": "殺人者は飽きっぽい"}, {"type": "subtitle", "time": 6613.59, "timestamp": "01:50:13", "text": "そして彼らは追いかけるのをやめる"}, {"type": "subtitle", "time": 6616.149, "timestamp": "01:50:16", "text": "しばらくして。"}, {"type": "subtitle", "time": 6625.03, "timestamp": "01:50:25", "text": "なぜ私はクリックキラーになりたくなるのだろうか"}, {"type": "subtitle", "time": 6628.39, "timestamp": "01:50:28", "text": "辛くて痛いですか？"}, {"type": "subtitle", "time": 6630.47, "timestamp": "01:50:30", "text": "ああ、個人的には"}, {"type": "subtitle", "time": 6632.07, "timestamp": "01:50:32", "text": "キラーをプレイしたんだけど、私はいつも"}, {"type": "subtitle", "time": 6634.39, "timestamp": "01:50:34", "text": "かなり良い、簡単なゲームがある"}, {"type": "subtitle", "time": 6636.229, "timestamp": "01:50:36", "text": "キラー。サバイバーは少し"}, {"type": "subtitle", "time": 6652.149, "timestamp": "01:50:52", "text": "これらの人たちは"}, {"type": "subtitle", "time": 6654.87, "timestamp": "01:50:54", "text": "修正中。ハマってしまったけど、こっそりと"}, {"type": "subtitle", "time": 6656.47, "timestamp": "01:50:56", "text": "私の方です。私はあの幽霊のことをすっかり忘れていた"}, {"type": "subtitle", "time": 6659.109, "timestamp": "01:50:59", "text": "まるでステルスフェイスのようだ。"}]
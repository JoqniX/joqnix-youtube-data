[{"type": "subtitle", "time": 3064.15, "timestamp": "00:51:04", "text": "そしてそれは本当に"}, {"type": "subtitle", "time": 3066.549, "timestamp": "00:51:06", "text": "トップ4に入っているから、これは大きな戦いだ。"}, {"type": "subtitle", "time": 3068.47, "timestamp": "00:51:08", "text": "はい、それでおしまいです。だから、私たちは"}, {"type": "subtitle", "time": 3073.03, "timestamp": "00:51:13", "text": "今すぐ行け。では、ここへ行きましょう。"}, {"type": "subtitle", "time": 3075.03, "timestamp": "00:51:15", "text": "なんてこった。できません。どうでも。そうではありません"}, {"type": "subtitle", "time": 3077.99, "timestamp": "00:51:17", "text": "あの時。そのゾーンは"}, {"type": "subtitle", "time": 3079.75, "timestamp": "00:51:19", "text": "ゾーンがかなり傷つくことになるだろう"}, {"type": "subtitle", "time": 3083.27, "timestamp": "00:51:23", "text": "レベル。うん。ええと、高いほど"}, {"type": "subtitle", "time": 3085.589, "timestamp": "00:51:25", "text": "明らかにレベルは痛むが、おそらく"}, {"type": "subtitle", "time": 3087.27, "timestamp": "00:51:27", "text": "それは既に知っている。でも私は本当に"}, {"type": "subtitle", "time": 3089.829, "timestamp": "00:51:29", "text": "それを経験したい。"}, {"type": "subtitle", "time": 3093.43, "timestamp": "00:51:33", "text": "わかった。誰か他の人"}, {"type": "subtitle", "time": 3108.63, "timestamp": "00:51:48", "text": "私は敵を倒した。必要悪"}, {"type": "subtitle", "time": 3118.47, "timestamp": "00:51:58", "text": "おい、俺は"}]
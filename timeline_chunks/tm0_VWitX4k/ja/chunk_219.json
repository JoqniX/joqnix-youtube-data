[{"type": "subtitle", "time": 13143.349, "timestamp": "03:39:03", "text": "Arcに似たDiaというもの"}, {"type": "subtitle", "time": 13145.269, "timestamp": "03:39:05", "text": "Edgeのように"}, {"type": "subtitle", "time": 13146.95, "timestamp": "03:39:06", "text": "ディア？"}, {"type": "subtitle", "time": 13148.71, "timestamp": "03:39:08", "text": "だから、チャットできます"}, {"type": "subtitle", "time": 13151.83, "timestamp": "03:39:11", "text": "ブラウザで実際に"}, {"type": "subtitle", "time": 13154.469, "timestamp": "03:39:14", "text": "例えば、メールの下書きを作成したいとしましょう。"}, {"type": "subtitle", "time": 13156.79, "timestamp": "03:39:16", "text": "学校のプロジェクトか何かについて"}, {"type": "subtitle", "time": 13159.429, "timestamp": "03:39:19", "text": "そして今、あなたは自分のものを持っています。"}, {"type": "subtitle", "time": 13161.349, "timestamp": "03:39:21", "text": "調査か何かをしなければならない"}, {"type": "subtitle", "time": 13163.429, "timestamp": "03:39:23", "text": "研究結果を保存するためにメールを書く"}, {"type": "subtitle", "time": 13165.67, "timestamp": "03:39:25", "text": "資料のPDFとすべてのファイルを開く"}, {"type": "subtitle", "time": 13170.15, "timestamp": "03:39:30", "text": "タブを開いて、プロンプトを開きます。"}, {"type": "subtitle", "time": 13173.269, "timestamp": "03:39:33", "text": "えーと、AIが入力みたいなことをするように促すやつ"}, {"type": "subtitle", "time": 13177.269, "timestamp": "03:39:37", "text": "彼らにタブを言及するように伝えてください。"}, {"type": "subtitle", "time": 13179.91, "timestamp": "03:39:39", "text": "または、すべてのタブを選択して次のようにします。"}, {"type": "subtitle", "time": 13181.83, "timestamp": "03:39:41", "text": "「うん、これとこれについてメッセージを書いてくれ」"}, {"type": "subtitle", "time": 13183.59, "timestamp": "03:39:43", "text": "そしてそれ。」そしてそれは自動的に行われます。"}, {"type": "subtitle", "time": 13187.99, "timestamp": "03:39:47", "text": "それ。それっていいこと？その情報を保存してください。"}, {"type": "subtitle", "time": 13190.55, "timestamp": "03:39:50", "text": "うん。 GeForceも同様に、"}, {"type": "subtitle", "time": 13194.07, "timestamp": "03:39:54", "text": "同じことだ。彼らは作っていたんだと思う。"}, {"type": "subtitle", "time": 13196.72, "timestamp": "03:39:56", "text": "ええ、彼らは作っていました"}, {"type": "subtitle", "time": 13198.79, "timestamp": "03:39:58", "text": "[音楽]"}]
[{"type": "subtitle", "time": 8343.669, "timestamp": "02:19:03", "text": "[音楽]"}, {"type": "subtitle", "time": 8359.83, "timestamp": "02:19:19", "text": "私の一部は"}, {"type": "subtitle", "time": 8362.23, "timestamp": "02:19:22", "text": "うん、私の中にはこう感じる部分もある"}, {"type": "subtitle", "time": 8365.27, "timestamp": "02:19:25", "text": "私が求めているものになる。"}, {"type": "subtitle", "time": 8368.309, "timestamp": "02:19:28", "text": "でも、私の中にはこう感じる部分もある"}, {"type": "subtitle", "time": 8370.79, "timestamp": "02:19:30", "text": "私が探している場所は"}, {"type": "subtitle", "time": 8375.75, "timestamp": "02:19:35", "text": "のために？ともあれ、この点については検討してみよう。"}, {"type": "subtitle", "time": 8377.589, "timestamp": "02:19:37", "text": "また、マーリンのスケートもあります。私は知っている"}, {"type": "subtitle", "time": 8379.99, "timestamp": "02:19:39", "text": "マーリンの裁判を見かけたら、必ず見に行く。私はそうします"}, {"type": "subtitle", "time": 8382.309, "timestamp": "02:19:42", "text": "これ"}, {"type": "subtitle", "time": 8393.99, "timestamp": "02:19:53", "text": "1 2 3。岩の地形。"}, {"type": "subtitle", "time": 8396.55, "timestamp": "02:19:56", "text": "それがこの地図上の最初の目印です。"}]
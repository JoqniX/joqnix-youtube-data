[{"type": "subtitle", "time": 6840.95, "timestamp": "01:54:00", "text": "ええ、そうですね。だから、彼は特典を持っている"}, {"type": "subtitle", "time": 6845.83, "timestamp": "01:54:05", "text": "それは即座にダウンするだろう。えっと、私は思う"}, {"type": "subtitle", "time": 6848.709, "timestamp": "01:54:08", "text": "それは残念ですね。これは奇妙な"}, {"type": "subtitle", "time": 6850.709, "timestamp": "01:54:10", "text": "男の顔面を吹き飛ばしたので、これが私の最初の"}, {"type": "subtitle", "time": 6879.669, "timestamp": "01:54:39", "text": "ああ、ありがとうございます。ありがとう。わかった。どこ"}, {"type": "subtitle", "time": 6882.55, "timestamp": "01:54:42", "text": "あなたは自撮りをしますか？"}, {"type": "subtitle", "time": 6894.39, "timestamp": "01:54:54", "text": "わかった。 R ZGXによって回復される"}]
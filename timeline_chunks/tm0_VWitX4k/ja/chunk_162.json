[{"type": "subtitle", "time": 9720.15, "timestamp": "02:42:00", "text": "まだ"}, {"type": "subtitle", "time": 9723.429, "timestamp": "02:42:03", "text": "私はまだそれをやらなければならない。"}, {"type": "subtitle", "time": 9726.07, "timestamp": "02:42:06", "text": "だから私は「ああ、彼らに支払わなきゃいけない」って感じだった"}, {"type": "subtitle", "time": 9728.79, "timestamp": "02:42:08", "text": "それが最後の月だ。まるで"}, {"type": "subtitle", "time": 9730.309, "timestamp": "02:42:10", "text": "分割払い。"}, {"type": "subtitle", "time": 9734.63, "timestamp": "02:42:14", "text": "値段も高かった。 6万5000人くらい。"}, {"type": "subtitle", "time": 9737.75, "timestamp": "02:42:17", "text": "なんていうか、すごく高いんだよ。"}, {"type": "subtitle", "time": 9740.389, "timestamp": "02:42:20", "text": "うん。そして私は4を懇願した"}, {"type": "subtitle", "time": 9743.19, "timestamp": "02:42:23", "text": "月々の分割払い。だから私は彼に支払わなければならなかった"}, {"type": "subtitle", "time": 9746.15, "timestamp": "02:42:26", "text": "16.4Kくらい"}, {"type": "subtitle", "time": 9750.71, "timestamp": "02:42:30", "text": "毎月。そして3月頃または"}, {"type": "subtitle", "time": 9752.87, "timestamp": "02:42:32", "text": "何か、私は始める、私は始める、私は始めた"}, {"type": "subtitle", "time": 9756.63, "timestamp": "02:42:36", "text": "止めて、始めたよ。前に"}, {"type": "subtitle", "time": 9760.07, "timestamp": "02:42:40", "text": "私は理解できなくなり始めた"}, {"type": "subtitle", "time": 9762.71, "timestamp": "02:42:42", "text": "えーと、私がやっていることから得られるお金は"}, {"type": "subtitle", "time": 9765.67, "timestamp": "02:42:45", "text": "私は技術サポートの仕事が好きで、"}, {"type": "subtitle", "time": 9767.91, "timestamp": "02:42:47", "text": "すべて。だから私はお金を受け取っていなかった"}, {"type": "subtitle", "time": 9770.07, "timestamp": "02:42:50", "text": "誰も求めていなかったので十分なお金"}, {"type": "subtitle", "time": 9773.67, "timestamp": "02:42:53", "text": "私と、その他すべて。だから私は「ああ、だめだ」と思った"}, {"type": "subtitle", "time": 9777.11, "timestamp": "02:42:57", "text": "私はどうすればいいの？と懇願して尋ねた"}, {"type": "subtitle", "time": 9779.429, "timestamp": "02:42:59", "text": "両親は反対していたので"}]
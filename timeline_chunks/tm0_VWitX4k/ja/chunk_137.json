[{"type": "subtitle", "time": 8222.389, "timestamp": "02:17:02", "text": "ええ、私もそこにいますよ。私は行く必要があります"}, {"type": "subtitle", "time": 8225.509, "timestamp": "02:17:05", "text": "これらを通じて"}, {"type": "subtitle", "time": 8229.75, "timestamp": "02:17:09", "text": "環状道路とか、そんな感じの道。"}, {"type": "subtitle", "time": 8231.19, "timestamp": "02:17:11", "text": "あのね？私は"}, {"type": "subtitle", "time": 8240.389, "timestamp": "02:17:20", "text": "私が何をしようとしているか、わかる？"}, {"type": "subtitle", "time": 8247.429, "timestamp": "02:17:27", "text": "えーと"}, {"type": "subtitle", "time": 8250.07, "timestamp": "02:17:30", "text": "これをどうすればいいんだろう？私はします"}, {"type": "subtitle", "time": 8257.27, "timestamp": "02:17:37", "text": "私ができることは、それをアップロードして"}, {"type": "subtitle", "time": 8270.79, "timestamp": "02:17:50", "text": "URLをコピーして、はい、見てみます"}, {"type": "subtitle", "time": 8274.07, "timestamp": "02:17:54", "text": "ここからこの地図へ"}, {"type": "subtitle", "time": 8278.389, "timestamp": "02:17:58", "text": "自分の目で見た。こんにちは。"}]
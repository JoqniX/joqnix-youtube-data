[{"type": "subtitle", "time": 6360.709, "timestamp": "01:46:00", "text": "それはずっと昔のことだった、2016年、17、8。"}, {"type": "subtitle", "time": 6363.43, "timestamp": "01:46:03", "text": "ああ、彼らはリセットしたんだ"}, {"type": "subtitle", "time": 6366.31, "timestamp": "01:46:06", "text": "休眠口座について考えると、"}, {"type": "subtitle", "time": 6373.51, "timestamp": "01:46:13", "text": "うん。ああ、これでいい。 2週間前、"}, {"type": "subtitle", "time": 6377.51, "timestamp": "01:46:17", "text": "彼らはアサシン クリードを発表しました"}, {"type": "subtitle", "time": 6381.109, "timestamp": "01:46:21", "text": "えーと、シャドウズとのコラボレーション。"}, {"type": "subtitle", "time": 6383.669, "timestamp": "01:46:23", "text": "おお、"}, {"type": "subtitle", "time": 6387.669, "timestamp": "01:46:27", "text": "ああ、それから、私たちは、"}, {"type": "subtitle", "time": 6391.03, "timestamp": "01:46:31", "text": "セニーノの噛み跡またはピンヘッドから"}, {"type": "subtitle", "time": 6392.55, "timestamp": "01:46:32", "text": "ヘルレイザー、"}, {"type": "subtitle", "time": 6396.229, "timestamp": "01:46:36", "text": "しかし彼らは負けた"}, {"type": "subtitle", "time": 6398.47, "timestamp": "01:46:38", "text": "彼らはライセンスを失った。だから、彼らは"}, {"type": "subtitle", "time": 6400.31, "timestamp": "01:46:40", "text": "すべてのライセンス料を支払わなければならない"}, {"type": "subtitle", "time": 6402.229, "timestamp": "01:46:42", "text": "これらのうち。"}, {"type": "subtitle", "time": 6404.709, "timestamp": "01:46:44", "text": "おお。ええと、彼らはライセンスを失いました。それで、"}, {"type": "subtitle", "time": 6406.629, "timestamp": "01:46:46", "text": "ライセンスを失ったため、"}, {"type": "subtitle", "time": 6409.27, "timestamp": "01:46:49", "text": "彼を、彼が"}, {"type": "subtitle", "time": 6412.95, "timestamp": "01:46:52", "text": "ある意味、引退した状態。だから、彼を買うことはできない、"}, {"type": "subtitle", "time": 6414.47, "timestamp": "01:46:54", "text": "彼をロック解除することはできませんし、"}, {"type": "subtitle", "time": 6416.87, "timestamp": "01:46:56", "text": "彼の特権のどれでも。ああ、それは最悪だ"}, {"type": "subtitle", "time": 6418.39, "timestamp": "01:46:58", "text": "なぜなら彼は最高の特典を持っていたから"}]
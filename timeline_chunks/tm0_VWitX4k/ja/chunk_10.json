[{"type": "subtitle", "time": 602.389, "timestamp": "00:10:02", "text": "うん、ヴァレラントは楽しいけど、うん、私は"}, {"type": "subtitle", "time": 604.949, "timestamp": "00:10:04", "text": "入手できません。少し遅く感じる"}, {"type": "subtitle", "time": 608.07, "timestamp": "00:10:08", "text": "なぜなら私は昔Apexをよくプレイしていたからです"}, {"type": "subtitle", "time": 611.43, "timestamp": "00:10:11", "text": "とはいえ、私はそれが苦手です。結局"}, {"type": "subtitle", "time": 615.67, "timestamp": "00:10:15", "text": "Valerも同様にインストールします。そうです。"}, {"type": "subtitle", "time": 617.35, "timestamp": "00:10:17", "text": "状況は本当に悪化している。私は連続でやります。"}, {"type": "subtitle", "time": 619.19, "timestamp": "00:10:19", "text": "Valerantはしばらくの間は素晴らしいゲームだったが、"}, {"type": "subtitle", "time": 621.19, "timestamp": "00:10:21", "text": "私はゲームが発売された時からプレイし始めたのが好きです。"}, {"type": "subtitle", "time": 623.829, "timestamp": "00:10:23", "text": "ええ、私もその曲をたくさんプレイしました。私は思う"}, {"type": "subtitle", "time": 625.91, "timestamp": "00:10:25", "text": "最終的に4,000くらいになった"}, {"type": "subtitle", "time": 630.31, "timestamp": "00:10:30", "text": "2020年頃から何時間もゲームをプレイしている。すごい。"}, {"type": "subtitle", "time": 631.67, "timestamp": "00:10:31", "text": "それはすごいことだよ、ほら、それは"}, {"type": "subtitle", "time": 633.75, "timestamp": "00:10:33", "text": "私がプレイしていたゲーム。しかしその後"}, {"type": "subtitle", "time": 635.99, "timestamp": "00:10:35", "text": "まるで追加し続けるかのように"}, {"type": "subtitle", "time": 637.35, "timestamp": "00:10:37", "text": "それはただ"}, {"type": "subtitle", "time": 640.15, "timestamp": "00:10:40", "text": "少し過負荷過負荷と呼ばれた"}, {"type": "subtitle", "time": 641.59, "timestamp": "00:10:41", "text": "それ。しかし彼らは何もしたくなかった"}, {"type": "subtitle", "time": 643.67, "timestamp": "00:10:43", "text": "それについて。だから私は、私は本当に"}, {"type": "subtitle", "time": 644.79, "timestamp": "00:10:44", "text": "ゲームをプレイしたいのですが、"}, {"type": "subtitle", "time": 647.43, "timestamp": "00:10:47", "text": "能力が過剰になったような感じ。それで、私は"}, {"type": "subtitle", "time": 649.11, "timestamp": "00:10:49", "text": "ゲームをプレイすることを選んだ"}, {"type": "subtitle", "time": 651.07, "timestamp": "00:10:51", "text": "能力のことだよ。"}, {"type": "subtitle", "time": 653.11, "timestamp": "00:10:53", "text": "[音楽]"}, {"type": "subtitle", "time": 655.43, "timestamp": "00:10:55", "text": "だから今、そう、それが私がプレイするゲームなんだ"}, {"type": "subtitle", "time": 658.55, "timestamp": "00:10:58", "text": "たくさんとストリーム。"}]
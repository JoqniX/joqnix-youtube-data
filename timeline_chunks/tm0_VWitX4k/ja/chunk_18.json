[{"type": "subtitle", "time": 1080.47, "timestamp": "00:18:00", "text": "外部の人物。だから、私は"}, {"type": "subtitle", "time": 1082.549, "timestamp": "00:18:02", "text": "シャッターのように、"}, {"type": "subtitle", "time": 1085.43, "timestamp": "00:18:05", "text": "何でも。私はあまり外に出ないんです"}, {"type": "subtitle", "time": 1087.669, "timestamp": "00:18:07", "text": "保証するために。"}, {"type": "subtitle", "time": 1089.11, "timestamp": "00:18:09", "text": "だから、私はあまり外出しないので"}, {"type": "subtitle", "time": 1091.029, "timestamp": "00:18:11", "text": "十分にお金を使ってください。だから、私は"}, {"type": "subtitle", "time": 1098.23, "timestamp": "00:18:18", "text": "でも私は買いました、私は買いました"}, {"type": "subtitle", "time": 1100.31, "timestamp": "00:18:20", "text": "本を何冊か買ったり、その他いろいろ"}, {"type": "subtitle", "time": 1102.23, "timestamp": "00:18:22", "text": "日。だから、実際にはお金を使っていない"}, {"type": "subtitle", "time": 1103.52, "timestamp": "00:18:23", "text": "お金。"}, {"type": "subtitle", "time": 1105.99, "timestamp": "00:18:25", "text": "[音楽]"}, {"type": "subtitle", "time": 1109.59, "timestamp": "00:18:29", "text": "購入後に後悔したことはありますか？"}, {"type": "subtitle", "time": 1111.909, "timestamp": "00:18:31", "text": "ゲームでこういうものを買うとき"}, {"type": "subtitle", "time": 1117.59, "timestamp": "00:18:37", "text": "もう一度言って頂けますか？今まで"}, {"type": "subtitle", "time": 1121.19, "timestamp": "00:18:41", "text": "購入時に後悔した"}, {"type": "subtitle", "time": 1127.11, "timestamp": "00:18:47", "text": "もの？ああ、間違いなく100％後悔してるよ。"}, {"type": "subtitle", "time": 1129.51, "timestamp": "00:18:49", "text": "私の記憶では、"}, {"type": "subtitle", "time": 1132.39, "timestamp": "00:18:52", "text": "私が買ったスキンの1つ"}, {"type": "subtitle", "time": 1134.07, "timestamp": "00:18:54", "text": "ヴァレラント。私は、最初の"}, {"type": "subtitle", "time": 1136.87, "timestamp": "00:18:56", "text": "私が買ったスキン？私はそれを買って、"}, {"type": "subtitle", "time": 1138.39, "timestamp": "00:18:58", "text": "「ああ、いつも使ってるよ」みたいな感じ。それは"}]
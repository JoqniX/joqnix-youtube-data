[{"type": "subtitle", "time": 2283.19, "timestamp": "00:38:03", "text": "決勝に挑戦しました"}, {"type": "subtitle", "time": 2285.99, "timestamp": "00:38:05", "text": "チャンピオン、それは良かったけど、"}, {"type": "subtitle", "time": 2289.51, "timestamp": "00:38:09", "text": "実際、とても難しい"}, {"type": "subtitle", "time": 2298.55, "timestamp": "00:38:18", "text": "月曜日の決勝戦を想像すると"}, {"type": "subtitle", "time": 2301.829, "timestamp": "00:38:21", "text": "バトルロイヤル賞。"}, {"type": "subtitle", "time": 2304.15, "timestamp": "00:38:24", "text": "ああ、期末試験だ。正直言って、決勝戦は"}, {"type": "subtitle", "time": 2311.67, "timestamp": "00:38:31", "text": "ここに着陸しましょう。さあ行こう。"}, {"type": "subtitle", "time": 2313.75, "timestamp": "00:38:33", "text": "私は自分が"}, {"type": "subtitle", "time": 2320.71, "timestamp": "00:38:40", "text": "レヴナントは素晴らしいですね。"}, {"type": "subtitle", "time": 2327.03, "timestamp": "00:38:47", "text": "しかし彼らは"}, {"type": "subtitle", "time": 2330.79, "timestamp": "00:38:50", "text": "あのトムみたいなやつ。私はそれが欲しかった"}, {"type": "subtitle", "time": 2335.51, "timestamp": "00:38:55", "text": "トーテム。楽しかった。今、私は今、それはまるで"}]
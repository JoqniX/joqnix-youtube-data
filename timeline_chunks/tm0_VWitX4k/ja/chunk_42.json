[{"type": "subtitle", "time": 2520.79, "timestamp": "00:42:00", "text": "私の選択は問題ない。えっと、私は何者ですか？"}, {"type": "subtitle", "time": 2523.109, "timestamp": "00:42:03", "text": "私は150ですが、これをプレイしました"}, {"type": "subtitle", "time": 2526.23, "timestamp": "00:42:06", "text": "前に。えっと、OCの前には実際には"}, {"type": "subtitle", "time": 2527.589, "timestamp": "00:42:07", "text": "たくさんのゲームを手に入れよう。まるで"}, {"type": "subtitle", "time": 2531.99, "timestamp": "00:42:11", "text": "試合を観戦できるのは滅多にない機会だ。うん。"}, {"type": "subtitle", "time": 2537.19, "timestamp": "00:42:17", "text": "だから、ほら、それは、"}, {"type": "subtitle", "time": 2539.109, "timestamp": "00:42:19", "text": "私はping値の高いサーバーでプレイしています"}, {"type": "subtitle", "time": 2542.069, "timestamp": "00:42:22", "text": "OCでは試合が行われないから"}, {"type": "subtitle", "time": 2543.349, "timestamp": "00:42:23", "text": "サーバー。"}, {"type": "subtitle", "time": 2544.87, "timestamp": "00:42:24", "text": "私は手に入れたと思うけど、私は手に入れたと思う"}, {"type": "subtitle", "time": 2552.55, "timestamp": "00:42:32", "text": "私の2つの2500ダメージバッジはNAのようなものです。それで"}, {"type": "subtitle", "time": 2555.03, "timestamp": "00:42:35", "text": "ping値が150というのは、それほど悪くはない。すべて順調です。"}, {"type": "subtitle", "time": 2557.67, "timestamp": "00:42:37", "text": "くそ。"}, {"type": "subtitle", "time": 2559.75, "timestamp": "00:42:39", "text": "えっと、その設定がどこだったか知っていますか？"}, {"type": "subtitle", "time": 2564.79, "timestamp": "00:42:44", "text": "再びFPSを制限するのですか？えっと、FPS制限は"}, {"type": "subtitle", "time": 2572.069, "timestamp": "00:42:52", "text": "削除しましたか？"}, {"type": "subtitle", "time": 2576.23, "timestamp": "00:42:56", "text": "ええと、解像度を調整しました。"}, {"type": "subtitle", "time": 2579.589, "timestamp": "00:42:59", "text": "それです。ああ、神様。私は思う 私は思う 私は思う 私は"}]
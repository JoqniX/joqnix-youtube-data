[{"type": "subtitle", "time": 1324.87, "timestamp": "00:22:04", "text": "[音楽]"}, {"type": "subtitle", "time": 1334.789, "timestamp": "00:22:14", "text": "それは本当に多くのことを変えた。"}, {"type": "subtitle", "time": 1337.27, "timestamp": "00:22:17", "text": "待って、なぜ？待って、私があなたと同じように感じている"}, {"type": "subtitle", "time": 1344.23, "timestamp": "00:22:24", "text": "あなたは家宝を持っているような気がします"}, {"type": "subtitle", "time": 1345.99, "timestamp": "00:22:25", "text": "すでに。"}, {"type": "subtitle", "time": 1349.51, "timestamp": "00:22:29", "text": "私はします。私は、"}, {"type": "subtitle", "time": 1350.87, "timestamp": "00:22:30", "text": "家宝。新しいものは持っていません"}, {"type": "subtitle", "time": 1352.31, "timestamp": "00:22:32", "text": "彼らが持っている家宝ですが、私は"}, {"type": "subtitle", "time": 1354.789, "timestamp": "00:22:34", "text": "家宝、それが"}, {"type": "subtitle", "time": 1357.43, "timestamp": "00:22:37", "text": "ワトソンの。そして私は認めたが"}, {"type": "subtitle", "time": 1360.95, "timestamp": "00:22:40", "text": "私はゲームに対して少し腹を立てています"}, {"type": "subtitle", "time": 1362.789, "timestamp": "00:22:42", "text": "のように"}, {"type": "subtitle", "time": 1364.87, "timestamp": "00:22:44", "text": "そしておそらく私は落ちようとしている"}, {"type": "subtitle", "time": 1367.669, "timestamp": "00:22:47", "text": "今後2ヶ月で、"}, {"type": "subtitle", "time": 1371.19, "timestamp": "00:22:51", "text": "ほぼ3ドル、さらに300ドル、400ドル"}, {"type": "subtitle", "time": 1373.19, "timestamp": "00:22:53", "text": "このゲームでは"}, {"type": "subtitle", "time": 1374.549, "timestamp": "00:22:54", "text": "なぜなら彼らはもうすぐリリースするから"}, {"type": "subtitle", "time": 1377.19, "timestamp": "00:22:57", "text": "ワトソンのえーと"}]
[{"type": "subtitle", "time": 12541.349, "timestamp": "03:29:01", "text": "この中にスキンとかあるの？"}, {"type": "subtitle", "time": 12543.11, "timestamp": "03:29:03", "text": "ゲーム？"}, {"type": "subtitle", "time": 12548.07, "timestamp": "03:29:08", "text": "ええ、そうです。わあ、いいね。"}, {"type": "subtitle", "time": 12550.07, "timestamp": "03:29:10", "text": "うん、ちょっと安かったから、うん、"}, {"type": "subtitle", "time": 12559.59, "timestamp": "03:29:19", "text": "えっと、どんなタイプのゲームですか"}, {"type": "subtitle", "time": 12561.75, "timestamp": "03:29:21", "text": "気に入りましたか？ FPS"}, {"type": "subtitle", "time": 12565.67, "timestamp": "03:29:25", "text": "それともRobloxみたいに？いいえ、一般的に"}, {"type": "subtitle", "time": 12569.91, "timestamp": "03:29:29", "text": "それとも全体的な印象でしょうか？いいえ。えっと、私はこうプレイします"}, {"type": "subtitle", "time": 12578.63, "timestamp": "03:29:38", "text": "はい。リズムゲームが好きなあなた"}, {"type": "subtitle", "time": 12582.95, "timestamp": "03:29:42", "text": "円とかそういうもの。私も大好きです。私"}, {"type": "subtitle", "time": 12591.83, "timestamp": "03:29:51", "text": "男。オハイオ州立大学はいいところだ。このグラフィックを購入しました"}, {"type": "subtitle", "time": 12595.67, "timestamp": "03:29:55", "text": "タブレットはただ遊ぶためのものです。"}, {"type": "subtitle", "time": 12597.99, "timestamp": "03:29:57", "text": "ただ遊ぶためだけに。"}, {"type": "subtitle", "time": 12599.75, "timestamp": "03:29:59", "text": "グラフィックタブレットのようなものを使用できます"}]
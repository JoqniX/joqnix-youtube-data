[{"type": "subtitle", "time": 661.99, "timestamp": "00:11:01", "text": "ああ、いいね。ニース。"}, {"type": "subtitle", "time": 664.31, "timestamp": "00:11:04", "text": "あなたが持っているゲームの中で一番好きなものは何ですか？"}, {"type": "subtitle", "time": 666.87, "timestamp": "00:11:06", "text": "長年にわたって好きだった人？私は思う"}, {"type": "subtitle", "time": 671.59, "timestamp": "00:11:11", "text": "あなたはFPSゲームの方が好きなんですよね？リーグ。えっと、"}, {"type": "subtitle", "time": 673.829, "timestamp": "00:11:13", "text": "神様、待ってください。私の好きなゲーム"}, {"type": "subtitle", "time": 677.03, "timestamp": "00:11:17", "text": "遊ぶこと、ええと、私は遊ぶのが好きです"}, {"type": "subtitle", "time": 681.269, "timestamp": "00:11:21", "text": "リーグ。私はリーグが好きです。えっと、"}, {"type": "subtitle", "time": 683.99, "timestamp": "00:11:23", "text": "ああ、そうそう、さっきプレイしてたよね。"}, {"type": "subtitle", "time": 686.79, "timestamp": "00:11:26", "text": "包囲。包囲。私は今でもちょっと好きです"}, {"type": "subtitle", "time": 691.269, "timestamp": "00:11:31", "text": "包囲。えっと、デッド・バイ・デイライト。"}, {"type": "subtitle", "time": 695.829, "timestamp": "00:11:35", "text": "Dead by Daylightは本当に楽しい。"}, {"type": "subtitle", "time": 697.19, "timestamp": "00:11:37", "text": "私は最近、Dead by をとても楽しんでいます"}, {"type": "subtitle", "time": 700.23, "timestamp": "00:11:40", "text": "昼間だよ。待って、Bで大丈夫？"}, {"type": "subtitle", "time": 703.43, "timestamp": "00:11:43", "text": "偶然ですか？あなたはホラー映画が得意ですか？"}, {"type": "subtitle", "time": 705.75, "timestamp": "00:11:45", "text": "私はホラーが得意です。ああ、なんてことだ、私は"}, {"type": "subtitle", "time": 707.829, "timestamp": "00:11:47", "text": "ホラーが苦手。"}, {"type": "subtitle", "time": 709.35, "timestamp": "00:11:49", "text": "いえ、それは分かります。あまり多くない"}, {"type": "subtitle", "time": 712.389, "timestamp": "00:11:52", "text": "人々はそうである。ええと、私は元気です。私のお気に入り"}, {"type": "subtitle", "time": 715.829, "timestamp": "00:11:55", "text": "ホラーとは、ホラー映画のようなものです。"}, {"type": "subtitle", "time": 717.829, "timestamp": "00:11:57", "text": "私はホラー映画の大ファンです。"}]
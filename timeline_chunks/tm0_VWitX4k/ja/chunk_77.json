[{"type": "subtitle", "time": 4631.75, "timestamp": "01:17:11", "text": "こんにちは。"}, {"type": "subtitle", "time": 4638.87, "timestamp": "01:17:18", "text": "チームメイトに追いつく簡単な方法。"}, {"type": "subtitle", "time": 4641.99, "timestamp": "01:17:21", "text": "レベル３。いただいてもよろしいでしょうか？"}, {"type": "subtitle", "time": 4644.55, "timestamp": "01:17:24", "text": "ああ、それはできますよ。"}, {"type": "subtitle", "time": 4646.31, "timestamp": "01:17:26", "text": "はい。ああ、全部やらなくてよかった"}, {"type": "subtitle", "time": 4656.709, "timestamp": "01:17:36", "text": "ええと、私たちの前にはチームがいて"}, {"type": "subtitle", "time": 4658.55, "timestamp": "01:17:38", "text": "この建物。"}, {"type": "subtitle", "time": 4660.47, "timestamp": "01:17:40", "text": "私は下です。"}, {"type": "subtitle", "time": 4663.669, "timestamp": "01:17:43", "text": "えっと、押すべきでしょうか？"}, {"type": "subtitle", "time": 4665.83, "timestamp": "01:17:45", "text": "いや、違うよ。避難塔は良い選択肢です。"}, {"type": "subtitle", "time": 4669.83, "timestamp": "01:17:49", "text": "では、この避難塔を手に入れましょう。"}, {"type": "subtitle", "time": 4671.83, "timestamp": "01:17:51", "text": "これは、正確にはわからない"}, {"type": "subtitle", "time": 4674.149, "timestamp": "01:17:54", "text": "彼らです。それが問題なのです。そうそう。おお"}, {"type": "subtitle", "time": 4676.709, "timestamp": "01:17:56", "text": "待って。彼らが今どこにいるのか、正確に把握している。"}, {"type": "subtitle", "time": 4678.55, "timestamp": "01:17:58", "text": "わかった。"}]
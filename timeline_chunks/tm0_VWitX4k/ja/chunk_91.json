[{"type": "subtitle", "time": 5460.07, "timestamp": "01:31:00", "text": "だから、体をくねらせることを覚えるんだ。"}, {"type": "subtitle", "time": 5462.39, "timestamp": "01:31:02", "text": "だから、彼はあなたを迎えに来て、"}, {"type": "subtitle", "time": 5465.99, "timestamp": "01:31:05", "text": "それから、セクションを叩かないといけない"}, {"type": "subtitle", "time": 5471.75, "timestamp": "01:31:11", "text": "でも、私には理解できない。なぜ私たちは"}, {"type": "subtitle", "time": 5474.95, "timestamp": "01:31:14", "text": "この場所に閉じ込められた？"}, {"type": "subtitle", "time": 5476.87, "timestamp": "01:31:16", "text": "えーと、つまり、"}, {"type": "subtitle", "time": 5479.669, "timestamp": "01:31:19", "text": "DVDには、このような存在があります"}, {"type": "subtitle", "time": 5484.07, "timestamp": "01:31:24", "text": "ええと、ある種の存在が閉じ込めた"}, {"type": "subtitle", "time": 5487.83, "timestamp": "01:31:27", "text": "えーと、これらの殺人犯を誘い込む必要がある"}, {"type": "subtitle", "time": 5492.149, "timestamp": "01:31:32", "text": "餌をやってください。えーと、その存在はえーとを糧にしているから"}, {"type": "subtitle", "time": 5497.59, "timestamp": "01:31:37", "text": "えっと"}, {"type": "subtitle", "time": 5502.39, "timestamp": "01:31:42", "text": "何てことだ。彼はちょうど魚を釣り上げたところだ。"}, {"type": "subtitle", "time": 5503.75, "timestamp": "01:31:43", "text": "これで彼女は夢中になるだろう、そして"}, {"type": "subtitle", "time": 5505.27, "timestamp": "01:31:45", "text": "引きずり落ちるように進むつもりです"}, {"type": "subtitle", "time": 5506.48, "timestamp": "01:31:46", "text": "フック。"}, {"type": "subtitle", "time": 5507.99, "timestamp": "01:31:47", "text": "[音楽]"}, {"type": "subtitle", "time": 5514.229, "timestamp": "01:31:54", "text": "つまり、法律全体が基本的に実体である"}, {"type": "subtitle", "time": 5517.43, "timestamp": "01:31:57", "text": "生存者を誘拐し、それぞれの生存者"}, {"type": "subtitle", "time": 5519.51, "timestamp": "01:31:59", "text": "独自の殺人鬼を抱えている。ほとんどの生存者"}]
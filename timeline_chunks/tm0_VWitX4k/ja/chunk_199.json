[{"type": "subtitle", "time": 11940.87, "timestamp": "03:19:00", "text": "どうやら1年らしい。そうそう。あなたは私だった"}, {"type": "subtitle", "time": 11942.229, "timestamp": "03:19:02", "text": "私の"}, {"type": "subtitle", "time": 11944.309, "timestamp": "03:19:04", "text": "コミュニティタブのお知らせ"}, {"type": "subtitle", "time": 11947.83, "timestamp": "03:19:07", "text": "YouTube や Twitter など、私の私の"}, {"type": "subtitle", "time": 11951.59, "timestamp": "03:19:11", "text": "公式サイトもご覧ください。でも、ええと"}, {"type": "subtitle", "time": 11956.469, "timestamp": "03:19:16", "text": "うん、日本への私の入学は"}, {"type": "subtitle", "time": 11959.03, "timestamp": "03:19:19", "text": "インドとパキスタンのせいでキャンセルされました"}, {"type": "subtitle", "time": 11961.269, "timestamp": "03:19:21", "text": "あれと"}, {"type": "subtitle", "time": 11964.15, "timestamp": "03:19:24", "text": "えっと、理屈でその根源はわからない"}, {"type": "subtitle", "time": 11966.63, "timestamp": "03:19:26", "text": "しかし、それはアカデミーの人たちが言っていたことだ"}, {"type": "subtitle", "time": 11968.63, "timestamp": "03:19:28", "text": "なぜなら、この出来事が起こっていたとき"}, {"type": "subtitle", "time": 11973.67, "timestamp": "03:19:33", "text": "彼らはすぐに、"}, {"type": "subtitle", "time": 11976.07, "timestamp": "03:19:36", "text": "移民局の人々に伝える"}, {"type": "subtitle", "time": 11978.63, "timestamp": "03:19:38", "text": "ええ、私たちは、私たちは、"}, {"type": "subtitle", "time": 11981.67, "timestamp": "03:19:41", "text": "移民局の職員は送らないよ。"}, {"type": "subtitle", "time": 11984.55, "timestamp": "03:19:44", "text": "だからアカデミーの人たちがそう言ったんだと思う"}, {"type": "subtitle", "time": 11987.59, "timestamp": "03:19:47", "text": "学生に影響を与える"}, {"type": "subtitle", "time": 11991.349, "timestamp": "03:19:51", "text": "10月入学と12月入学。それで"}, {"type": "subtitle", "time": 11993.75, "timestamp": "03:19:53", "text": "それらは完全に相殺されるようなものだ"}, {"type": "subtitle", "time": 11996.71, "timestamp": "03:19:56", "text": "残りの2つの吸気口と同様に"}, {"type": "subtitle", "time": 11998.469, "timestamp": "03:19:58", "text": "7月。つまり、３つのインテークが"}]
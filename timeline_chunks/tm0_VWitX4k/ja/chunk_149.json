[{"type": "subtitle", "time": 8943.59, "timestamp": "02:29:03", "text": "私は死んだ。"}, {"type": "subtitle", "time": 8954.95, "timestamp": "02:29:14", "text": "どういう意味ですか？"}, {"type": "subtitle", "time": 8958.55, "timestamp": "02:29:18", "text": "私たちは順調です。よく眠れた。"}, {"type": "subtitle", "time": 8961.91, "timestamp": "02:29:21", "text": "私は大好きです"}, {"type": "subtitle", "time": 8965.03, "timestamp": "02:29:25", "text": "そして朝食の材料。"}, {"type": "subtitle", "time": 8967.19, "timestamp": "02:29:27", "text": "そうそう。"}, {"type": "subtitle", "time": 8985.75, "timestamp": "02:29:45", "text": "その周り。"}, {"type": "subtitle", "time": 8988.71, "timestamp": "02:29:48", "text": "なぜそうしなかったのですか？いいえ。"}, {"type": "subtitle", "time": 8991.349, "timestamp": "02:29:51", "text": "守る"}]
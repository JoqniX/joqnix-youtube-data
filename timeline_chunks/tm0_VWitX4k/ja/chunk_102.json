[{"type": "subtitle", "time": 6120.79, "timestamp": "01:42:00", "text": "レズとしてプレイする。だから、あなたは"}, {"type": "subtitle", "time": 6122.31, "timestamp": "01:42:02", "text": "グールを手に入れて、それから"}, {"type": "subtitle", "time": 6125.03, "timestamp": "01:42:05", "text": "彼女をリスキンとして持つことができます"}, {"type": "subtitle", "time": 6129.109, "timestamp": "01:42:09", "text": "だって、あの男がグールを作ったんだから。えっと、"}, {"type": "subtitle", "time": 6132.79, "timestamp": "01:42:12", "text": "彼らは、アンレオか"}, {"type": "subtitle", "time": 6134.47, "timestamp": "01:42:14", "text": "リングから出てきたひよこ。あの女の子のこと知ってるでしょ"}, {"type": "subtitle", "time": 6136.629, "timestamp": "01:42:16", "text": "テレビから這い出てくるようなやつ。"}, {"type": "subtitle", "time": 6138.55, "timestamp": "01:42:18", "text": "うん。"}, {"type": "subtitle", "time": 6142.07, "timestamp": "01:42:22", "text": "リッチと呼ばれる殺人鬼がいる。彼女は"}, {"type": "subtitle", "time": 6144.87, "timestamp": "01:42:24", "text": "DBDより。ええと、私たちには"}, {"type": "subtitle", "time": 6147.75, "timestamp": "01:42:27", "text": "ゼノモーフ。チャッキーがいるよ。"}, {"type": "subtitle", "time": 6149.75, "timestamp": "01:42:29", "text": "えーと、闇の君主は"}, {"type": "subtitle", "time": 6151.51, "timestamp": "01:42:31", "text": "キャッスルヴァニア。"}, {"type": "subtitle", "time": 6157.43, "timestamp": "01:42:37", "text": "首謀者かアダム・ウェスカーが"}, {"type": "subtitle", "time": 6160.47, "timestamp": "01:42:40", "text": "バイオハザードより。私たちはネメシスを手に入れました"}, {"type": "subtitle", "time": 6162.79, "timestamp": "01:42:42", "text": "バイオハザード。ピラミッドヘッドを手に入れた。私たちは"}, {"type": "subtitle", "time": 6167.189, "timestamp": "01:42:47", "text": "幽霊みたいな顔になった。デモゴルゴンを手に入れた。"}, {"type": "subtitle", "time": 6169.99, "timestamp": "01:42:49", "text": "おお。これは、これは文字通り"}, {"type": "subtitle", "time": 6172.07, "timestamp": "01:42:52", "text": "フォートナイトみたいなホラーゲームだよ。"}, {"type": "subtitle", "time": 6174.87, "timestamp": "01:42:54", "text": "ええ、そうです。"}, {"type": "subtitle", "time": 6177.83, "timestamp": "01:42:57", "text": "だって、全部そんな感じだし、そう、彼らは"}, {"type": "subtitle", "time": 6179.43, "timestamp": "01:42:59", "text": "皮膚のようなもの。ウィッチャーがいた"}]
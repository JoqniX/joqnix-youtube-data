[{"type": "subtitle", "time": 17941.91, "timestamp": "04:59:01", "text": "ゲームが始まった。え、何？"}, {"type": "subtitle", "time": 17944.868, "timestamp": "04:59:04", "text": "マーベル作品だけが、射撃のような魅力を持っている。"}, {"type": "subtitle", "time": 17946.39, "timestamp": "04:59:06", "text": "シュート。ああ、彼を撃つんだ。待って、これは"}, {"type": "subtitle", "time": 17948.788, "timestamp": "04:59:08", "text": "それです"}, {"type": "subtitle", "time": 17950.39, "timestamp": "04:59:10", "text": "もの？"}, {"type": "subtitle", "time": 17955.43, "timestamp": "04:59:15", "text": "ああ、"}, {"type": "subtitle", "time": 17959.83, "timestamp": "04:59:19", "text": "待って。あなたはもう行ったのですか？いいえ、私はここにいます。わかった、"}, {"type": "subtitle", "time": 17962.55, "timestamp": "04:59:22", "text": "遊べるよ。ええ、何でも演奏できますよ。"}, {"type": "subtitle", "time": 17966.15, "timestamp": "04:59:26", "text": "ええ、これは"}, {"type": "subtitle", "time": 17969.43, "timestamp": "04:59:29", "text": "私たちはライブで部屋を作ることができます。"}, {"type": "subtitle", "time": 17972.868, "timestamp": "04:59:32", "text": "よし、もう一度開けてみよう。"}, {"type": "subtitle", "time": 17976.39, "timestamp": "04:59:36", "text": "何てことだ、"}]
[{"type": "subtitle", "time": 13862.63, "timestamp": "03:51:02", "text": "それを開けて、一つ開ける。"}, {"type": "subtitle", "time": 13877.03, "timestamp": "03:51:17", "text": "ああ、今は動いている。"}, {"type": "subtitle", "time": 13879.269, "timestamp": "03:51:19", "text": "はい。"}, {"type": "subtitle", "time": 13883.91, "timestamp": "03:51:23", "text": "ラッキー。感度はどのくらいですか？"}, {"type": "subtitle", "time": 13887.91, "timestamp": "03:51:27", "text": "それはやりすぎだ。おお、"}, {"type": "subtitle", "time": 13890.34, "timestamp": "03:51:30", "text": "感度に不具合があります。"}, {"type": "subtitle", "time": 13893.51, "timestamp": "03:51:33", "text": "[音楽]"}]
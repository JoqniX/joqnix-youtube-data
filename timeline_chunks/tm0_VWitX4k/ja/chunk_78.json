[{"type": "subtitle", "time": 4682.709, "timestamp": "01:18:02", "text": "私たちはこれに対抗できるかもしれない。"}, {"type": "subtitle", "time": 4685.99, "timestamp": "01:18:05", "text": "シールドが枯渇しました。充電中。"}, {"type": "subtitle", "time": 4687.11, "timestamp": "01:18:07", "text": "彼らは別の相手と戦っている。だから私たちは"}, {"type": "subtitle", "time": 4689.35, "timestamp": "01:18:09", "text": "絶対に戦い抜くことができる。修理"}, {"type": "subtitle", "time": 4691.03, "timestamp": "01:18:11", "text": "ダメージ。向こうで何が見つかるだろうか"}, {"type": "subtitle", "time": 4693.75, "timestamp": "01:18:13", "text": "そこには。よし。"}, {"type": "subtitle", "time": 4695.03, "timestamp": "01:18:15", "text": "だから、彼らは誰かを撃っているから"}, {"type": "subtitle", "time": 4697.91, "timestamp": "01:18:17", "text": "そうでなければ、私たちは理解します。"}, {"type": "subtitle", "time": 4699.35, "timestamp": "01:18:19", "text": "彼らは私たちが去ると思っているが、"}, {"type": "subtitle", "time": 4702.79, "timestamp": "01:18:22", "text": "実際、私たちは今まさに彼らのところへ向かっているところです。"}]
[{"type": "subtitle", "time": 7561.55, "timestamp": "02:06:01", "text": "１、２。"}, {"type": "subtitle", "time": 7567.91, "timestamp": "02:06:07", "text": "[音楽]"}, {"type": "subtitle", "time": 7570.99, "timestamp": "02:06:10", "text": "それはひどい遅延だ。"}, {"type": "subtitle", "time": 7576.95, "timestamp": "02:06:16", "text": "[音楽]"}, {"type": "subtitle", "time": 7579.109, "timestamp": "02:06:19", "text": "わかった。私が話すときはいつでも"}, {"type": "subtitle", "time": 7581.589, "timestamp": "02:06:21", "text": "モバイル機器、波形が見えるでしょ。"}, {"type": "subtitle", "time": 7583.91, "timestamp": "02:06:23", "text": "わかった。それが唯一の"}, {"type": "subtitle", "time": 7589.189, "timestamp": "02:06:29", "text": "それらを区別することができる。えっと"}, {"type": "subtitle", "time": 7591.109, "timestamp": "02:06:31", "text": "うん。ええ、私は行きます"}, {"type": "subtitle", "time": 7593.99, "timestamp": "02:06:33", "text": "階下で食事をし、小川を楽しみ、"}, {"type": "subtitle", "time": 7596.149, "timestamp": "02:06:36", "text": "Vのすべてを楽しんでください。そして私はただ"}, {"type": "subtitle", "time": 7599.75, "timestamp": "02:06:39", "text": "V字型で先を追う。だから、"}, {"type": "subtitle", "time": 7603.35, "timestamp": "02:06:43", "text": "これはホグワーツのレガシーWです。どうぞお楽しみください。"}, {"type": "subtitle", "time": 7605.189, "timestamp": "02:06:45", "text": "ここ。"}, {"type": "subtitle", "time": 7607.669, "timestamp": "02:06:47", "text": "1つください。私は戻ってきます。始めます"}, {"type": "subtitle", "time": 7609.669, "timestamp": "02:06:49", "text": "コラボレーション"}, {"type": "subtitle", "time": 7613.189, "timestamp": "02:06:53", "text": "20分。わかった。それでは、皆さん、さようなら。"}, {"type": "subtitle", "time": 7615.589, "timestamp": "02:06:55", "text": "何？これはすごくクールだ。私は知りたいです"}, {"type": "subtitle", "time": 7619.91, "timestamp": "02:06:59", "text": "ああいう瞬間をどうやって演出するか。まあまあで"}]
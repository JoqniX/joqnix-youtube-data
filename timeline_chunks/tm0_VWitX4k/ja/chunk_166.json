[{"type": "subtitle", "time": 9960.71, "timestamp": "02:46:00", "text": "しかし、それは完全に砕け散ったように見えた"}, {"type": "subtitle", "time": 9964.63, "timestamp": "02:46:04", "text": "ひび割れとかそういうのが完全にあって、私は"}, {"type": "subtitle", "time": 9968.309, "timestamp": "02:46:08", "text": "泣きながら、どうやって閉じればいいのかと思った"}, {"type": "subtitle", "time": 9971.349, "timestamp": "02:46:11", "text": "PCが怖くなってきた"}, {"type": "subtitle", "time": 9984.87, "timestamp": "02:46:24", "text": "グラスを持っている人たちを見たことがあります"}, {"type": "subtitle", "time": 9994.95, "timestamp": "02:46:34", "text": "正気の沙汰ではない。待って、ノートパソコンを使ってるの？"}, {"type": "subtitle", "time": 10000.23, "timestamp": "02:46:40", "text": "デスクトップPCをノートPCとして使う？ああ"}, {"type": "subtitle", "time": 10004.71, "timestamp": "02:46:44", "text": "デスクトップパソコンも持ってるけど、今はまだ持ってない。 H"}, {"type": "subtitle", "time": 10007.59, "timestamp": "02:46:47", "text": "ノートパソコンが欲しいです。買いたいです。"}, {"type": "subtitle", "time": 10010.469, "timestamp": "02:46:50", "text": "ラップトップを見て、私は気づいた"}, {"type": "subtitle", "time": 10013.75, "timestamp": "02:46:53", "text": "ああ、今は物が多​​すぎる。ええ、そうです"}, {"type": "subtitle", "time": 10015.19, "timestamp": "02:46:55", "text": "持ち運びはできるけど、実際はそうでもない"}, {"type": "subtitle", "time": 10017.19, "timestamp": "02:46:57", "text": "強力だ。"}, {"type": "subtitle", "time": 10018.95, "timestamp": "02:46:58", "text": "それはあまりにも"}]
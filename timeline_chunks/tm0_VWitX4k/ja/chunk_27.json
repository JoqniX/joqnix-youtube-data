[{"type": "subtitle", "time": 1622.47, "timestamp": "00:27:02", "text": "再装填中。ピエロが倒された。"}, {"type": "subtitle", "time": 1625.75, "timestamp": "00:27:05", "text": "ナックルクラスター。"}, {"type": "subtitle", "time": 1627.669, "timestamp": "00:27:07", "text": "来て。来て。来て。"}, {"type": "subtitle", "time": 1630.789, "timestamp": "00:27:10", "text": "うん、押せるよ。私は推測する"}, {"type": "subtitle", "time": 1633.669, "timestamp": "00:27:13", "text": "おそらく私は犠牲になるだろう。うん。だから私たちは"}, {"type": "subtitle", "time": 1644.95, "timestamp": "00:27:24", "text": "何てことだ。ラグがあるので、実際には"}, {"type": "subtitle", "time": 1652.47, "timestamp": "00:27:32", "text": "弓のチェックだよ。なんてこった。それ"}, {"type": "subtitle", "time": 1658.149, "timestamp": "00:27:38", "text": "よし、弓のチェックを拾って"}, {"type": "subtitle", "time": 1665.59, "timestamp": "00:27:45", "text": "それは決してアップグレードとは言えない。さあ"}, {"type": "subtitle", "time": 1671.909, "timestamp": "00:27:51", "text": "救援物資が配達されています。"}, {"type": "subtitle", "time": 1678.789, "timestamp": "00:27:58", "text": "相棒はいますか？ええと、おそらく"}]
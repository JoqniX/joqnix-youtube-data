[{"type": "subtitle", "time": 4200.79, "timestamp": "01:10:00", "text": "そのうちの2つ。しかし、それは"}, {"type": "subtitle", "time": 4202.36, "timestamp": "01:10:02", "text": "最後の一つ。"}, {"type": "subtitle", "time": 4219.91, "timestamp": "01:10:19", "text": "ストーンポイント。"}, {"type": "subtitle", "time": 4222.55, "timestamp": "01:10:22", "text": "新しいマップは追加されましたか？彼らは"}, {"type": "subtitle", "time": 4232.31, "timestamp": "01:10:32", "text": "私は今でもあの頭蓋骨の形をしたポイントを覚えています。"}, {"type": "subtitle", "time": 4236.47, "timestamp": "01:10:36", "text": "オリジナルマップ。そう、元祖マップだよ。"}, {"type": "subtitle", "time": 4239.51, "timestamp": "01:10:39", "text": "彼らはまだその地図を持っていると思うが"}, {"type": "subtitle", "time": 4244.149, "timestamp": "01:10:44", "text": "大きく変わってしまったんです。うん。うん。"}, {"type": "subtitle", "time": 4247.43, "timestamp": "01:10:47", "text": "それ、すごく好き。クリップを見るような"}, {"type": "subtitle", "time": 4250.95, "timestamp": "01:10:50", "text": "Apexの最初の週の人々は"}, {"type": "subtitle", "time": 4253.83, "timestamp": "01:10:53", "text": "最初のシーズンをプレイして、そう、戻ってきました"}, {"type": "subtitle", "time": 4256.07, "timestamp": "01:10:56", "text": "その時は良かった。誰も知らなかった"}]
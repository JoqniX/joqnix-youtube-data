[{"type": "subtitle", "time": 16625.749, "timestamp": "04:37:05", "text": "ああ、走れ、走れ、行け。くそ。"}, {"type": "subtitle", "time": 16645.429, "timestamp": "04:37:25", "text": "おい。おい。"}, {"type": "subtitle", "time": 16647.349, "timestamp": "04:37:27", "text": "ああ、あなたは建物の中にいるんですね。私は"}, {"type": "subtitle", "time": 16649.59, "timestamp": "04:37:29", "text": "つまり、誰なの？何してるの"}, {"type": "subtitle", "time": 16668.31, "timestamp": "04:37:48", "text": "これまでの私の撮影状況はどうですか？わからない。"}, {"type": "subtitle", "time": 16677.99, "timestamp": "04:37:57", "text": "彼はすぐそばにいる。"}, {"type": "subtitle", "time": 16679.67, "timestamp": "04:37:59", "text": "おお、いいね。"}]
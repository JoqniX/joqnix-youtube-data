[{"type": "subtitle", "time": 9422.15, "timestamp": "02:37:02", "text": "その他諸々。私の人生は"}, {"type": "subtitle", "time": 9429.349, "timestamp": "02:37:09", "text": "それはすばらしい。ジョン、君はどう？自分？"}, {"type": "subtitle", "time": 9432.79, "timestamp": "02:37:12", "text": "うーん、わからない。複雑な気持ちです。"}, {"type": "subtitle", "time": 9435.27, "timestamp": "02:37:15", "text": "すべては起こるべくして起こった"}, {"type": "subtitle", "time": 9439.429, "timestamp": "02:37:19", "text": "幸せで今"}, {"type": "subtitle", "time": 9442.07, "timestamp": "02:37:22", "text": "入学がキャンセルされた理由は"}, {"type": "subtitle", "time": 9446.63, "timestamp": "02:37:26", "text": "インドとパキスタンの戦争のことですね。うん、"}, {"type": "subtitle", "time": 9448.95, "timestamp": "02:37:28", "text": "戦争はまだ続いている。"}, {"type": "subtitle", "time": 9450.389, "timestamp": "02:37:30", "text": "彼らはまだ色々なことで争っている。"}, {"type": "subtitle", "time": 9454.07, "timestamp": "02:37:34", "text": "待って、まだ終わってないよ。"}, {"type": "subtitle", "time": 9456.63, "timestamp": "02:37:36", "text": "しばらくの間は止めていたけど、"}, {"type": "subtitle", "time": 9458.87, "timestamp": "02:37:38", "text": "彼らが止まるとは思わない方がいい。"}, {"type": "subtitle", "time": 9460.63, "timestamp": "02:37:40", "text": "その話はやめようぜ、兄弟。うん。"}, {"type": "subtitle", "time": 9465.19, "timestamp": "02:37:45", "text": "うん。うん。うん。そして、私はそうだったので"}, {"type": "subtitle", "time": 9469.27, "timestamp": "02:37:49", "text": "クラスメートの一人のように"}, {"type": "subtitle", "time": 9471.75, "timestamp": "02:37:51", "text": "えっと、アカデミーの人たちは"}, {"type": "subtitle", "time": 9474.309, "timestamp": "02:37:54", "text": "誰だったかはわからないけど、"}, {"type": "subtitle", "time": 9476.389, "timestamp": "02:37:56", "text": "それを言ったのは、"}, {"type": "subtitle", "time": 9478.71, "timestamp": "02:37:58", "text": "クラスメートと彼が私に電話をかけてきて"}]
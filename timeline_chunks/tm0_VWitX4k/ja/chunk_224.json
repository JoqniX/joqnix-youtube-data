[{"type": "subtitle", "time": 13444.469, "timestamp": "03:44:04", "text": "非常識な。私は既にゲームに参加しています。それは始まった。"}, {"type": "subtitle", "time": 13447.429, "timestamp": "03:44:07", "text": "あのね？私は待つべきではない。"}, {"type": "subtitle", "time": 13451.91, "timestamp": "03:44:11", "text": "私も参加できますか？もう一度参加できますか？"}, {"type": "subtitle", "time": 13454.55, "timestamp": "03:44:14", "text": "アル。もしあなたが別のゲームをしたいなら、"}, {"type": "subtitle", "time": 13457.75, "timestamp": "03:44:17", "text": "欲しい。わかった。"}, {"type": "subtitle", "time": 13460.469, "timestamp": "03:44:20", "text": "しかし、そのためには変わらなければならない。はい、私は"}, {"type": "subtitle", "time": 13463.11, "timestamp": "03:44:23", "text": "そうしました。大丈夫です。"}, {"type": "subtitle", "time": 13467.03, "timestamp": "03:44:27", "text": "Robloxプレイヤーですよね？スタジオではありません。わかった。"}, {"type": "subtitle", "time": 13480.95, "timestamp": "03:44:40", "text": "ペイントボールで遊びたい"}, {"type": "subtitle", "time": 13482.55, "timestamp": "03:44:42", "text": "あれ？"}, {"type": "subtitle", "time": 13484.95, "timestamp": "03:44:44", "text": "はい。おお、"}]
[{"type": "subtitle", "time": 8586.389, "timestamp": "02:23:06", "text": "はい、チャットを見ることができます。"}, {"type": "subtitle", "time": 8589.75, "timestamp": "02:23:09", "text": "ビーム上のもの。それは良いことだ。私は感じる"}, {"type": "subtitle", "time": 8592.55, "timestamp": "02:23:12", "text": "今の私の環境は最高だよね"}, {"type": "subtitle", "time": 8599.19, "timestamp": "02:23:19", "text": "世界を征服できるような気分になる、"}, {"type": "subtitle", "time": 8601.59, "timestamp": "02:23:21", "text": "この時点で何か"}, {"type": "subtitle", "time": 8611.27, "timestamp": "02:23:31", "text": "えっと、戻らないといけないんです。私は2つしか持っていません"}, {"type": "subtitle", "time": 8615.83, "timestamp": "02:23:35", "text": "1分。私はクラブにDMを送りました"}, {"type": "subtitle", "time": 8619.349, "timestamp": "02:23:39", "text": "パートナー。次はアサスです。私はDMとして"}, {"type": "subtitle", "time": 8622.15, "timestamp": "02:23:42", "text": "それについて"}, {"type": "subtitle", "time": 8624.55, "timestamp": "02:23:44", "text": "周囲に。ええ、そういうことです。"}, {"type": "subtitle", "time": 8628.469, "timestamp": "02:23:48", "text": "わかった。他に何か必要なものはありますか？"}, {"type": "subtitle", "time": 8630.469, "timestamp": "02:23:50", "text": "えっと、"}, {"type": "subtitle", "time": 8633.75, "timestamp": "02:23:53", "text": "わかった。私はこれを受け取るつもりです。"}, {"type": "subtitle", "time": 8636.15, "timestamp": "02:23:56", "text": "私はこれを食べるつもりです"}, {"type": "subtitle", "time": 8637.67, "timestamp": "02:23:57", "text": "2階へ。"}, {"type": "subtitle", "time": 8639.75, "timestamp": "02:23:59", "text": "わかった。りんご。"}]
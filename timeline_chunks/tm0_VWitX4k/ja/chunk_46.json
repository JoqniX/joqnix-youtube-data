[{"type": "subtitle", "time": 2760.87, "timestamp": "00:46:00", "text": "彼らはたくさんのパックを配っている"}, {"type": "subtitle", "time": 2776.15, "timestamp": "00:46:16", "text": "これは何のスピードですか？私が"}, {"type": "subtitle", "time": 2783.99, "timestamp": "00:46:23", "text": "それ？それで、彼らは何かを追加した。だから、"}, {"type": "subtitle", "time": 2787.51, "timestamp": "00:46:27", "text": "チームメンバーが一緒にいるとより良い"}, {"type": "subtitle", "time": 2789.589, "timestamp": "00:46:29", "text": "明らかにオクタンやレイスのような人たち"}, {"type": "subtitle", "time": 2790.87, "timestamp": "00:46:30", "text": "そして他の多くのチャンピオンは"}, {"type": "subtitle", "time": 2793.109, "timestamp": "00:46:33", "text": "機動性、非常に高い機動性。今度は"}, {"type": "subtitle", "time": 2795.19, "timestamp": "00:46:35", "text": "スクワッドベイトを一緒に、彼らは追加しました"}, {"type": "subtitle", "time": 2798.55, "timestamp": "00:46:38", "text": "みんなと同じように試せる茎"}, {"type": "subtitle", "time": 2801.19, "timestamp": "00:46:41", "text": "追いつくために。あなたは、ある特定の"}, {"type": "subtitle", "time": 2803.589, "timestamp": "00:46:43", "text": "遠く離れていて、まるであなたが見ることができるように"}, {"type": "subtitle", "time": 2805.99, "timestamp": "00:46:45", "text": "チームメイトと、そのサークルが"}, {"type": "subtitle", "time": 2807.43, "timestamp": "00:46:47", "text": "塗りつぶすと、次のような見た目になります"}, {"type": "subtitle", "time": 2814.87, "timestamp": "00:46:54", "text": "それは素晴らしいですね。それはただ試すだけで、"}, {"type": "subtitle", "time": 2818.79, "timestamp": "00:46:58", "text": "全員を一緒に保つ。"}]
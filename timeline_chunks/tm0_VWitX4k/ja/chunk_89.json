[{"type": "subtitle", "time": 5351.83, "timestamp": "01:29:11", "text": "エンティティコマンド。でも私はこれをプレイしました"}, {"type": "subtitle", "time": 5353.99, "timestamp": "01:29:13", "text": "前に。"}, {"type": "subtitle", "time": 5357.35, "timestamp": "01:29:17", "text": "以前Epic Gamesでプレイしたことはありますか？"}, {"type": "subtitle", "time": 5361.11, "timestamp": "01:29:21", "text": "うん。え、私、そうだったっけ？"}, {"type": "subtitle", "time": 5365.669, "timestamp": "01:29:25", "text": "Epicでは一度もプレイしたことがないよ、兄弟。私は覚えている"}, {"type": "subtitle", "time": 5368.149, "timestamp": "01:29:28", "text": "このゲームを買うのは、"}, {"type": "subtitle", "time": 5371.43, "timestamp": "01:29:31", "text": "え、このゲームって無料だったの？"}, {"type": "subtitle", "time": 5373.99, "timestamp": "01:29:33", "text": "いいえ、いいえ、このゲームは無料ではありません。"}, {"type": "subtitle", "time": 5375.99, "timestamp": "01:29:35", "text": "ええ、おそらくそうだと思います"}, {"type": "subtitle", "time": 5383.03, "timestamp": "01:29:43", "text": "うん。"}, {"type": "subtitle", "time": 5386.229, "timestamp": "01:29:46", "text": "窓際まで行きなさい。何てことだ。したい"}, {"type": "subtitle", "time": 5397.03, "timestamp": "01:29:57", "text": "ああ、これね。彼らにはその仲間がいる"}]
[{"type": "subtitle", "time": 480.07, "timestamp": "00:08:00", "text": "ストリーミングとかそういうやつ。私は"}, {"type": "subtitle", "time": 484.07, "timestamp": "00:08:04", "text": "ストリーミング配信はしているのですが、私はとてもとても下手です"}, {"type": "subtitle", "time": 487.189, "timestamp": "00:08:07", "text": "スケジュール設定。だから、私は親切だと思う、私は"}, {"type": "subtitle", "time": 488.79, "timestamp": "00:08:08", "text": "1回くらい配信する"}, {"type": "subtitle", "time": 490.629, "timestamp": "00:08:10", "text": "3週間に1回から"}, {"type": "subtitle", "time": 493.99, "timestamp": "00:08:13", "text": "自分がそうしたいと思った時に月ごとに。私はそうしました"}, {"type": "subtitle", "time": 497.589, "timestamp": "00:08:17", "text": "寿司かレネーでストリーム配信をする"}, {"type": "subtitle", "time": 499.83, "timestamp": "00:08:19", "text": "少し前のことです。ええ、ずいぶん前のことですね。"}, {"type": "subtitle", "time": 501.909, "timestamp": "00:08:21", "text": "ほんの数日前のことだった、と私は言った。"}, {"type": "subtitle", "time": 504.39, "timestamp": "00:08:24", "text": "ああ、いいね。"}, {"type": "subtitle", "time": 506.469, "timestamp": "00:08:26", "text": "私たちはシージをプレイするつもりですが、その後彼らは"}, {"type": "subtitle", "time": 508.23, "timestamp": "00:08:28", "text": "アップデートしたので、結局遊戯王をプレイすることになった"}, {"type": "subtitle", "time": 510.55, "timestamp": "00:08:30", "text": "ストリーム。"}, {"type": "subtitle", "time": 513.029, "timestamp": "00:08:33", "text": "私はまだレインボーシックスをダウンロード中です"}, {"type": "subtitle", "time": 515.909, "timestamp": "00:08:35", "text": "シージX。"}, {"type": "subtitle", "time": 519.11, "timestamp": "00:08:39", "text": "ええ、ちょっとダウンロード容量が大きいですね。"}, {"type": "subtitle", "time": 526.07, "timestamp": "00:08:46", "text": "それはとても大きいので、私は買ったことを覚えています"}, {"type": "subtitle", "time": 529.59, "timestamp": "00:08:49", "text": "包囲はずっと前から始まっていた。わからない。私はしません"}, {"type": "subtitle", "time": 531.99, "timestamp": "00:08:51", "text": "いつのことだったか覚えている？まるで"}, {"type": "subtitle", "time": 534.07, "timestamp": "00:08:54", "text": "Epic Gamesのオファーのようなものだ。だから私は"}, {"type": "subtitle", "time": 537.59, "timestamp": "00:08:57", "text": "「よし、これを手に入れよう」という感じ。"}, {"type": "subtitle", "time": 539.67, "timestamp": "00:08:59", "text": "そして、それを手に入れた後、"}]
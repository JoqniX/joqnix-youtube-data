[{"type": "subtitle", "time": 7260.79, "timestamp": "02:01:00", "text": "うん。皆さんにとって良い一日になりますように。"}, {"type": "subtitle", "time": 7262.31, "timestamp": "02:01:02", "text": "はい。"}, {"type": "subtitle", "time": 7264.95, "timestamp": "02:01:04", "text": "Salty Signsの仲間と楽しい時間を過ごせるなら、"}, {"type": "subtitle", "time": 7267.669, "timestamp": "02:01:07", "text": "彼女のTwitchアカウントは無料でフォローできます。えーと、"}, {"type": "subtitle", "time": 7270.149, "timestamp": "02:01:10", "text": "リンクは説明欄と"}, {"type": "subtitle", "time": 7274.31, "timestamp": "02:01:14", "text": "TwitchとBMのピン留めチャット。うん。"}, {"type": "subtitle", "time": 7276.31, "timestamp": "02:01:16", "text": "わーい。"}, {"type": "subtitle", "time": 7279.189, "timestamp": "02:01:19", "text": "それでは、良い一日を。素敵な夜をお過ごしください"}, {"type": "subtitle", "time": 7281.99, "timestamp": "02:01:21", "text": "先に。"}, {"type": "subtitle", "time": 7283.99, "timestamp": "02:01:23", "text": "ありがとう。"}, {"type": "subtitle", "time": 7291.43, "timestamp": "02:01:31", "text": "というわけで、以上がソルティでした。願わくば"}, {"type": "subtitle", "time": 7294.87, "timestamp": "02:01:34", "text": "今日はソルティ・サンと楽しい時間を過ごした。それ"}, {"type": "subtitle", "time": 7296.87, "timestamp": "02:01:36", "text": "でも、本当に楽しかったよ。本当にそうだった、"}, {"type": "subtitle", "time": 7300.55, "timestamp": "02:01:40", "text": "本当に楽しかった。一緒に過ごすのが楽しかったです"}, {"type": "subtitle", "time": 7303.27, "timestamp": "02:01:43", "text": "塩味付き。"}, {"type": "subtitle", "time": 7311.55, "timestamp": "02:01:51", "text": "とても楽しかったです。"}, {"type": "subtitle", "time": 7314.149, "timestamp": "02:01:54", "text": "[音楽]"}, {"type": "subtitle", "time": 7318.47, "timestamp": "02:01:58", "text": "というわけで、次はアサスです"}]
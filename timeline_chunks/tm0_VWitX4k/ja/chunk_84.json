[{"type": "subtitle", "time": 5051.51, "timestamp": "01:24:11", "text": "わかった。わかった。私には家族がいました"}, {"type": "subtitle", "time": 5059.27, "timestamp": "01:24:19", "text": "わかった。"}, {"type": "subtitle", "time": 5063.59, "timestamp": "01:24:23", "text": "脈拍は安定している。ああ、"}, {"type": "subtitle", "time": 5066.629, "timestamp": "01:24:26", "text": "椅子。つまり、そういう類の"}, {"type": "subtitle", "time": 5071.83, "timestamp": "01:24:31", "text": "私たちが進んでいる道は、似たようなものだと思う。ああ、"}, {"type": "subtitle", "time": 5073.669, "timestamp": "01:24:33", "text": "そして、5つのスプリングトラップが登場します"}]
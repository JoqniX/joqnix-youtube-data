[{"type": "subtitle", "time": 12422.15, "timestamp": "03:27:02", "text": "今は無料ですよね？はい、無料です"}, {"type": "subtitle", "time": 12424.95, "timestamp": "03:27:04", "text": "今。入手しましたが、"}, {"type": "subtitle", "time": 12427.83, "timestamp": "03:27:07", "text": "ダウンロードしました。"}, {"type": "subtitle", "time": 12430.71, "timestamp": "03:27:10", "text": "彼らは超高"}, {"type": "subtitle", "time": 12433.51, "timestamp": "03:27:13", "text": "リソースパックのようなグラフィック関連のもの。"}, {"type": "subtitle", "time": 12441.59, "timestamp": "03:27:21", "text": "91ギガです。"}, {"type": "subtitle", "time": 12445.349, "timestamp": "03:27:25", "text": "待てよ、60だぞ。"}, {"type": "subtitle", "time": 12447.59, "timestamp": "03:27:27", "text": "つまり、ハードドライブに約90ギガの空き容量があるということだ。"}, {"type": "subtitle", "time": 12449.11, "timestamp": "03:27:29", "text": "ドライブ。"}, {"type": "subtitle", "time": 12465.59, "timestamp": "03:27:45", "text": "つまり、ゲームを買った人たちのことです"}, {"type": "subtitle", "time": 12467.67, "timestamp": "03:27:47", "text": "実際には返金は受け取れなかったが、"}]
[{"type": "subtitle", "time": 2825.829, "timestamp": "00:47:05", "text": "私たちはついさっきまであそこにいたの？私たちは"}, {"type": "subtitle", "time": 2827.75, "timestamp": "00:47:07", "text": "あそこです。"}, {"type": "subtitle", "time": 2830.55, "timestamp": "00:47:10", "text": "ああ、私たちはついさっきあそこにいましたよ。わかった。"}, {"type": "subtitle", "time": 2837.99, "timestamp": "00:47:17", "text": "[音楽]"}, {"type": "subtitle", "time": 2840.23, "timestamp": "00:47:20", "text": "飛び越えられるかな。あ、待って。"}, {"type": "subtitle", "time": 2843.19, "timestamp": "00:47:23", "text": "彼は"}, {"type": "subtitle", "time": 2845.67, "timestamp": "00:47:25", "text": "ああ、チームメイトたちよ。"}, {"type": "subtitle", "time": 2848.15, "timestamp": "00:47:28", "text": "チームメイト。調べてみるべきですね。"}, {"type": "subtitle", "time": 2866.23, "timestamp": "00:47:46", "text": "私は生まれた。"}, {"type": "subtitle", "time": 2869.109, "timestamp": "00:47:49", "text": "逃げられないよ。"}, {"type": "subtitle", "time": 2873.109, "timestamp": "00:47:53", "text": "あ、待って。それはあなたです。私の調子はどうですか？"}, {"type": "subtitle", "time": 2878.39, "timestamp": "00:47:58", "text": "ああ、これでいい。"}]
[{"type": "subtitle", "time": 15720.469, "timestamp": "04:22:00", "text": "どうすれば彼らを殺せるのか？"}, {"type": "subtitle", "time": 15722.95, "timestamp": "04:22:02", "text": "ああ、ジェイコブ、この裏切り者め。行くよ"}, {"type": "subtitle", "time": 15732.79, "timestamp": "04:22:12", "text": "いいえ、いいえ、いいえ、いいえ、いいえ、いいえ、いいえ、いいえ。"}, {"type": "subtitle", "time": 15742.389, "timestamp": "04:22:22", "text": "ああ、なんてことだ、君は本当に素晴らしい。"}, {"type": "subtitle", "time": 15744.229, "timestamp": "04:22:24", "text": "いいえ、私は良くありません。あなたは"}, {"type": "subtitle", "time": 15746.95, "timestamp": "04:22:26", "text": "トップ。"}, {"type": "subtitle", "time": 15749.11, "timestamp": "04:22:29", "text": "この銃は何？何？未来のライフル。"}, {"type": "subtitle", "time": 15751.51, "timestamp": "04:22:31", "text": "あれは何でしょう？"}, {"type": "subtitle", "time": 15754.07, "timestamp": "04:22:34", "text": "どのライフルですか？レーザー銃を持ってるよ"}, {"type": "subtitle", "time": 15756.469, "timestamp": "04:22:36", "text": "スター・ウォーズか何かからの引用です。白い"}, {"type": "subtitle", "time": 15759.269, "timestamp": "04:22:39", "text": "タワーライフル。おお。"}, {"type": "subtitle", "time": 15762.469, "timestamp": "04:22:42", "text": "まるで未来のライフル銃のようだ。何？"}, {"type": "subtitle", "time": 15764.55, "timestamp": "04:22:44", "text": "ああ、そっち側からだとどんな感じですか？"}, {"type": "subtitle", "time": 15766.309, "timestamp": "04:22:46", "text": "何？"}, {"type": "subtitle", "time": 15769.349, "timestamp": "04:22:49", "text": "これは痛みとダメージだ。何？何が"}]
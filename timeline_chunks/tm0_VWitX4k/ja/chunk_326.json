[{"type": "subtitle", "time": 19579.03, "timestamp": "05:26:19", "text": "待って、君はどこにいるの？"}, {"type": "subtitle", "time": 19583.36, "timestamp": "05:26:23", "text": "公開サーバー。あなたも一緒に参加できますよ。どうすれば"}, {"type": "subtitle", "time": 19584.628, "timestamp": "05:26:24", "text": "[音楽]"}, {"type": "subtitle", "time": 19586.948, "timestamp": "05:26:26", "text": "ブローカーをクリックして参加してください"}, {"type": "subtitle", "time": 19588.29, "timestamp": "05:26:28", "text": "もの？"}, {"type": "subtitle", "time": 19591.43, "timestamp": "05:26:31", "text": "[音楽]"}, {"type": "subtitle", "time": 19594.15, "timestamp": "05:26:34", "text": "私には見えません。あ、待って。私は行かなければならない"}, {"type": "subtitle", "time": 19611.03, "timestamp": "05:26:51", "text": "[音楽]"}, {"type": "subtitle", "time": 19613.11, "timestamp": "05:26:53", "text": "今朝はペンキ塗りまで始めていた。"}, {"type": "subtitle", "time": 19619.59, "timestamp": "05:26:59", "text": "あなたはここにいますか？"}]
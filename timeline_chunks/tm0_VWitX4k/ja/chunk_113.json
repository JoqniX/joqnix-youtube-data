[{"type": "subtitle", "time": 6781.589, "timestamp": "01:53:01", "text": "どうすればいいですか？"}, {"type": "subtitle", "time": 6784.47, "timestamp": "01:53:04", "text": "世代は固定されていたのか？"}, {"type": "subtitle", "time": 6787.03, "timestamp": "01:53:07", "text": "だから、下の方を見ると、"}, {"type": "subtitle", "time": 6789.43, "timestamp": "01:53:09", "text": "右下隅。"}, {"type": "subtitle", "time": 6795.109, "timestamp": "01:53:15", "text": "ああ、私は死んでしまった。ああ、しまった。"}, {"type": "subtitle", "time": 6805.03, "timestamp": "01:53:25", "text": "私は今、死ぬ。私は死んだのか？ええ、そうです。ただ"}, {"type": "subtitle", "time": 6820.709, "timestamp": "01:53:40", "text": "彼は私がどこにいるのか知らない、なぜなら私は"}, {"type": "subtitle", "time": 6824.709, "timestamp": "01:53:44", "text": "背の高い草むらの中で。だから、私は遊んでいる"}, {"type": "subtitle", "time": 6832.31, "timestamp": "01:53:52", "text": "待てよ、彼らは2つの発電機を持っている。"}, {"type": "subtitle", "time": 6837.91, "timestamp": "01:53:57", "text": "ああ、それは私を殺そうとしている。"}]
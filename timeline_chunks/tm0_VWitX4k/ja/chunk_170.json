[{"type": "subtitle", "time": 10202.309, "timestamp": "02:50:02", "text": "すべてのポケモンの神、創造主のような"}, {"type": "subtitle", "time": 10210.07, "timestamp": "02:50:10", "text": "おお。"}, {"type": "subtitle", "time": 10214.23, "timestamp": "02:50:14", "text": "H では、何があなたをそうさせたのですか？"}, {"type": "subtitle", "time": 10222.79, "timestamp": "02:50:22", "text": "私はただコミュニティを作りたかっただけです"}, {"type": "subtitle", "time": 10225.67, "timestamp": "02:50:25", "text": "私が楽しめる場所。"}, {"type": "subtitle", "time": 10227.269, "timestamp": "02:50:27", "text": "それだけです。"}, {"type": "subtitle", "time": 10229.03, "timestamp": "02:50:29", "text": "ああ、ただ楽しみたいだけなんだ"}, {"type": "subtitle", "time": 10230.25, "timestamp": "02:50:30", "text": "友達。"}, {"type": "subtitle", "time": 10232.23, "timestamp": "02:50:32", "text": "[音楽]"}, {"type": "subtitle", "time": 10247.59, "timestamp": "02:50:47", "text": "それで、サンジが一度"}, {"type": "subtitle", "time": 10251.19, "timestamp": "02:50:51", "text": "えっと、あなたはまだ関わっていたのですか"}, {"type": "subtitle", "time": 10253.429, "timestamp": "02:50:53", "text": "YouTuberとかを見るのが好き？いいえ。"}, {"type": "subtitle", "time": 10256.07, "timestamp": "02:50:56", "text": "まるで消えてしまったかのように。私は興味がなかった"}, {"type": "subtitle", "time": 10259.429, "timestamp": "02:50:59", "text": "初めてあなたを見たときまでは"}]
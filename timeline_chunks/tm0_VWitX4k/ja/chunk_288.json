[{"type": "subtitle", "time": 17285.19, "timestamp": "04:48:05", "text": "ああ、なぜそんなに良い演奏をするように送られたのか"}, {"type": "subtitle", "time": 17287.35, "timestamp": "04:48:07", "text": "どこにでも広まっているの？"}, {"type": "subtitle", "time": 17289.75, "timestamp": "04:48:09", "text": "核兵器ではない。あなたはこれに勝つでしょう"}, {"type": "subtitle", "time": 17294.868, "timestamp": "04:48:14", "text": "2キルしたやつかな。何てことだ、"}, {"type": "subtitle", "time": 17322.708, "timestamp": "04:48:42", "text": "[音楽]"}, {"type": "subtitle", "time": 17337.6, "timestamp": "04:48:57", "text": "数人倒せばいいだけだ。"}]
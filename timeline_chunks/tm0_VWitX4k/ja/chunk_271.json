[{"type": "subtitle", "time": 16272.87, "timestamp": "04:31:12", "text": "インターネットをオフにするにはどうすればいいですか？そうじゃない"}, {"type": "subtitle", "time": 16289.59, "timestamp": "04:31:29", "text": "桜材。私は桜の木を手に入れました。"}, {"type": "subtitle", "time": 16293.11, "timestamp": "04:31:33", "text": "私も胸を開けていました。始めたばかりです"}]
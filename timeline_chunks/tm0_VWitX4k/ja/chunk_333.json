[{"type": "subtitle", "time": 19983.67, "timestamp": "05:33:03", "text": "何？"}, {"type": "subtitle", "time": 19985.67, "timestamp": "05:33:05", "text": "どうすればいいですか？私は彼らを殴ったが、"}, {"type": "subtitle", "time": 19987.99, "timestamp": "05:33:07", "text": "殺すわけではない。"}, {"type": "subtitle", "time": 19991.19, "timestamp": "05:33:11", "text": "それは私たちの得意分野です。"}, {"type": "subtitle", "time": 19995.03, "timestamp": "05:33:15", "text": "私たちも欲しいです。おお。何が"}, {"type": "subtitle", "time": 20011.59, "timestamp": "05:33:31", "text": "わかった。"}, {"type": "subtitle", "time": 20025.03, "timestamp": "05:33:45", "text": "キル数はゼロだった。どうしてそんなに上手なの？私"}, {"type": "subtitle", "time": 20026.868, "timestamp": "05:33:46", "text": "わからない。どうすればいいのかわからない"}, {"type": "subtitle", "time": 20029.03, "timestamp": "05:33:49", "text": "あなたはやっている。"}, {"type": "subtitle", "time": 20031.99, "timestamp": "05:33:51", "text": "私は三人称です"}, {"type": "subtitle", "time": 20034.23, "timestamp": "05:33:54", "text": "ゲームをする。"}]
[{"type": "subtitle", "time": 10742.389, "timestamp": "02:59:02", "text": "それは、とても面白いもののように"}, {"type": "subtitle", "time": 10745.59, "timestamp": "02:59:05", "text": "しかも、そのアニメにはYouTuberも登場していた。"}, {"type": "subtitle", "time": 10748.71, "timestamp": "02:59:08", "text": "それは良かった。それは本当に素晴らしかった。"}, {"type": "subtitle", "time": 10752.63, "timestamp": "02:59:12", "text": "子供たちの目のように、それから赤井舞"}, {"type": "subtitle", "time": 10757.83, "timestamp": "02:59:17", "text": "マリア・アカイ、それからカカ・ルナ、その他みんな"}, {"type": "subtitle", "time": 10761.349, "timestamp": "02:59:21", "text": "今はもう大人だ。ああ、あの大きな"}, {"type": "subtitle", "time": 10763.269, "timestamp": "02:59:23", "text": "人々。彼らも結構年を取っている。うん、"}, {"type": "subtitle", "time": 10771.269, "timestamp": "02:59:31", "text": "つまり、たくさんの人が去っていく"}, {"type": "subtitle", "time": 10773.83, "timestamp": "02:59:33", "text": "今すぐ。それは私にとって少し悲しいことです。"}, {"type": "subtitle", "time": 10776.71, "timestamp": "02:59:36", "text": "ああ、そうだね。つまり、ユーチューバーの"}, {"type": "subtitle", "time": 10779.429, "timestamp": "02:59:39", "text": "去る。最近は、"}, {"type": "subtitle", "time": 10782.71, "timestamp": "02:59:42", "text": "卒業式何か"}, {"type": "subtitle", "time": 10784.55, "timestamp": "02:59:44", "text": "そして人々はこう推測している"}, {"type": "subtitle", "time": 10786.55, "timestamp": "02:59:46", "text": "彼らは空洞になるか、あるいは次は"}, {"type": "subtitle", "time": 10791.83, "timestamp": "02:59:51", "text": "サンジ。本当に悲しいことだ。うん。"}, {"type": "subtitle", "time": 10795.59, "timestamp": "02:59:55", "text": "アメリアはどこかにいた"}, {"type": "subtitle", "time": 10798.07, "timestamp": "02:59:58", "text": "また"}]
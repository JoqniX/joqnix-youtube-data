[{"type": "subtitle", "time": 2640.95, "timestamp": "00:44:00", "text": "ただ、ちょっとハマっちゃったんです"}, {"type": "subtitle", "time": 2642.31, "timestamp": "00:44:02", "text": "彼女に。"}, {"type": "chat", "time": 2643.059, "timestamp": "00:44:03", "author": "@ReneMahl", "avatar": "https://yt4.ggpht.com/cprihAALC0ENkeBRE8MMo6B7-dWCchmrYp5xkfC385nUVI1G6PlgxFB6lhLDLQY4sSbCyci54A=s64-c-k-c0x00ffffff-no-rj", "message": "SHE IS STINKY"}, {"type": "chat", "time": 2646.012, "timestamp": "00:44:06", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Greetings Konzteller! Rene Mahl Ch.~🌟 Welcome to the Guild! Make sure to read the Guildmate Guidelines in the description below before chatting further. Enjoy your stay!"}, {"type": "subtitle", "time": 2654.39, "timestamp": "00:44:14", "text": "こんにちは、寿司さん。チャットであ​​なたを見かけました。こんにちは。"}, {"type": "subtitle", "time": 2658.95, "timestamp": "00:44:18", "text": "寿司。これは寿司です。"}, {"type": "subtitle", "time": 2661.43, "timestamp": "00:44:21", "text": "彼女は臭い。"}, {"type": "subtitle", "time": 2664.63, "timestamp": "00:44:24", "text": "私は臭い。ええ、私、臭いんですよ。"}, {"type": "subtitle", "time": 2669.03, "timestamp": "00:44:29", "text": "寿司の観点から言えば、それは臭い間抜けだ。"}, {"type": "subtitle", "time": 2678.309, "timestamp": "00:44:38", "text": "私のバッグはパンパンです。ほら、"}, {"type": "subtitle", "time": 2679.75, "timestamp": "00:44:39", "text": "ここから銃声が聞こえて、今は"}, {"type": "chat", "time": 2685.348, "timestamp": "00:44:45", "author": "@ReneMahl", "avatar": "https://yt4.ggpht.com/cprihAALC0ENkeBRE8MMo6B7-dWCchmrYp5xkfC385nUVI1G6PlgxFB6lhLDLQY4sSbCyci54A=s64-c-k-c0x00ffffff-no-rj", "message": "The only goober who's worth it 💯"}, {"type": "subtitle", "time": 2689.829, "timestamp": "00:44:49", "text": "はい。銃声が聞こえる。どうでも。私"}]
[{"type": "subtitle", "time": 5883.109, "timestamp": "01:38:03", "text": "右上隅。ああ、血の網。"}, {"type": "subtitle", "time": 5885.43, "timestamp": "01:38:05", "text": "わかった。キャラクター上で確認できます"}, {"type": "subtitle", "time": 5887.99, "timestamp": "01:38:07", "text": "血の網みたいで、ただ"}, {"type": "subtitle", "time": 5892.55, "timestamp": "01:38:12", "text": "レベルアップするだけで、"}, {"type": "subtitle", "time": 5894.629, "timestamp": "01:38:14", "text": "ああ、あなたは超新しい世界に入ることになるでしょう"}, {"type": "subtitle", "time": 5897.27, "timestamp": "01:38:17", "text": "ロビーだから、まあいい感じ。"}, {"type": "subtitle", "time": 5898.629, "timestamp": "01:38:18", "text": "すべてを持つ必要はない"}, {"type": "subtitle", "time": 5902.07, "timestamp": "01:38:22", "text": "ロック解除されている、またはそれは、それは"}, {"type": "subtitle", "time": 5904.87, "timestamp": "01:38:24", "text": "特典やアイテムのロックを解除する方法"}, {"type": "subtitle", "time": 5907.51, "timestamp": "01:38:27", "text": "ゲーム内のアイテム。"}, {"type": "subtitle", "time": 5908.709, "timestamp": "01:38:28", "text": "様々なキャラクターが登場します。うん。"}, {"type": "subtitle", "time": 5911.83, "timestamp": "01:38:31", "text": "うん。好きなキャラクターを試してみてください。"}, {"type": "subtitle", "time": 5913.99, "timestamp": "01:38:33", "text": "ああ、ジョン・ヴィックみたいな人がいるね"}, {"type": "subtitle", "time": 5917.189, "timestamp": "01:38:37", "text": "キャラクターを探している。"}, {"type": "subtitle", "time": 5919.27, "timestamp": "01:38:39", "text": "え、何？"}, {"type": "subtitle", "time": 5921.43, "timestamp": "01:38:41", "text": "うん。うん。これで大丈夫です。基本的に、これは"}, {"type": "subtitle", "time": 5924.47, "timestamp": "01:38:44", "text": "このゲームはホラー版フォートナイトみたいなものだ。"}, {"type": "subtitle", "time": 5927.51, "timestamp": "01:38:47", "text": "それで、ララ・クロフトみたいな感じになったんです。俺たちはこうなった"}, {"type": "subtitle", "time": 5930.149, "timestamp": "01:38:50", "text": "Dn Dのキャラクター。ニコラス・ケイジを起用しました。"}, {"type": "subtitle", "time": 5932.629, "timestamp": "01:38:52", "text": "ニコラス・ケイジが出演する。何？アヤ"}, {"type": "subtitle", "time": 5936.95, "timestamp": "01:38:56", "text": "ウォン、レオン・ケネディ、ジル・バレンタイン。"}]
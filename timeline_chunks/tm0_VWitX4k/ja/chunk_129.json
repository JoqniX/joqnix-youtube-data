[{"type": "subtitle", "time": 7754.79, "timestamp": "02:09:14", "text": "セバスチャンを紹介します。そして"}, {"type": "subtitle", "time": 7758.229, "timestamp": "02:09:18", "text": "待って、それは違う"}, {"type": "subtitle", "time": 7761.27, "timestamp": "02:09:21", "text": "アデルと話す"}, {"type": "subtitle", "time": 7768.069, "timestamp": "02:09:28", "text": "アデレード・オークス。わかった。アデリデのオーク。あまりにも"}, {"type": "subtitle", "time": 7781.35, "timestamp": "02:09:41", "text": "ああ、私のすぐ隣にあるやつですね。わかった、"}, {"type": "subtitle", "time": 7783.669, "timestamp": "02:09:43", "text": "これです。"}, {"type": "subtitle", "time": 7786.79, "timestamp": "02:09:46", "text": "ああ、これだ。わかった。"}, {"type": "subtitle", "time": 7789.91, "timestamp": "02:09:49", "text": "だから、私たちは最善を尽くして"}, {"type": "subtitle", "time": 7792.55, "timestamp": "02:09:52", "text": "今日できる限り多くのクエストを完了してください。それは"}, {"type": "subtitle", "time": 7795.35, "timestamp": "02:09:55", "text": "目的。"}, {"type": "subtitle", "time": 7798.709, "timestamp": "02:09:58", "text": "存在していた。はい、アデリーを受け取りました。"}]
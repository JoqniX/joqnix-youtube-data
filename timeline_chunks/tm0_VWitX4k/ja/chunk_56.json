[{"type": "subtitle", "time": 3360.789, "timestamp": "00:56:00", "text": "の"}, {"type": "subtitle", "time": 3363.27, "timestamp": "00:56:03", "text": "あれは何だったっけ？えっと"}, {"type": "subtitle", "time": 3366.95, "timestamp": "00:56:06", "text": "舵面からのショット。うん。うん。うん。パッケージ"}, {"type": "subtitle", "time": 3369.67, "timestamp": "00:56:09", "text": "ショット。うん。珍しいショットはありません"}, {"type": "subtitle", "time": 3372.309, "timestamp": "00:56:12", "text": "あまりにも。彼らは「うん」という感じだ。お金を使う"}, {"type": "subtitle", "time": 3375.589, "timestamp": "00:56:15", "text": "こちらにもっとお金が入る。"}, {"type": "subtitle", "time": 3377.67, "timestamp": "00:56:17", "text": "珍しい破片しか買えませんが、"}, {"type": "subtitle", "time": 3380.95, "timestamp": "00:56:20", "text": "それらはまるで同じ肌のためのもののようです。私は思う"}, {"type": "subtitle", "time": 3384.71, "timestamp": "00:56:24", "text": "50ドルくらいです"}, {"type": "subtitle", "time": 3386.95, "timestamp": "00:56:26", "text": "少なくとも。でも、私にはそれが"}, {"type": "subtitle", "time": 3388.93, "timestamp": "00:56:28", "text": "それは1枚の皮膚です。"}, {"type": "subtitle", "time": 3400.87, "timestamp": "00:56:40", "text": "たくさんのこと。"}, {"type": "subtitle", "time": 3405.109, "timestamp": "00:56:45", "text": "何を選べばいいですか？えっと、私は"}, {"type": "subtitle", "time": 3407.03, "timestamp": "00:56:47", "text": "彼女。"}, {"type": "subtitle", "time": 3415.43, "timestamp": "00:56:55", "text": "あなたが何を求めているのか、私には分かります。"}, {"type": "subtitle", "time": 3418.15, "timestamp": "00:56:58", "text": "何てことだ。ラーよ、なぜ私はレイスなのか？"}]
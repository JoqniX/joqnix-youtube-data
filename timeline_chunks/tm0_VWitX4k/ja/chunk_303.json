[{"type": "subtitle", "time": 18185.56, "timestamp": "05:03:05", "text": "今、あなたはそれを言いましたね。"}, {"type": "subtitle", "time": 18187.03, "timestamp": "05:03:07", "text": "[音楽]"}, {"type": "subtitle", "time": 18192.47, "timestamp": "05:03:12", "text": "メッカのスキンを着た男がいる。"}, {"type": "subtitle", "time": 18194.708, "timestamp": "05:03:14", "text": "私はゲームに参加しました。"}, {"type": "subtitle", "time": 18197.83, "timestamp": "05:03:17", "text": "ああ、どれですか？ライバル。あ、待って、待って"}, {"type": "subtitle", "time": 18206.31, "timestamp": "05:03:26", "text": "これらの人たちを倒させてください。"}]
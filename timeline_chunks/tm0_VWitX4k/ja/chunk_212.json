[{"type": "subtitle", "time": 12724.07, "timestamp": "03:32:04", "text": "夕食は食べましたか？"}, {"type": "subtitle", "time": 12733.03, "timestamp": "03:32:13", "text": "えっと、あなたは昨年デビューしましたよね？"}, {"type": "subtitle", "time": 12734.79, "timestamp": "03:32:14", "text": "はい。"}, {"type": "subtitle", "time": 12739.67, "timestamp": "03:32:19", "text": "これまでのVubing体験はいかがでしたか？"}, {"type": "subtitle", "time": 12742.55, "timestamp": "03:32:22", "text": "ああ、楽しんでいますか？良かったよ。それ"}, {"type": "subtitle", "time": 12751.11, "timestamp": "03:32:31", "text": "それで、あなたの国の人々は親切なんですね。何ですか"}, {"type": "subtitle", "time": 12753.67, "timestamp": "03:32:33", "text": "あなたの将来の目標は何ですか？"}, {"type": "subtitle", "time": 12755.67, "timestamp": "03:32:35", "text": "内部"}, {"type": "subtitle", "time": 12757.67, "timestamp": "03:32:37", "text": "プロジェクトやその他何であれ"}, {"type": "subtitle", "time": 12759.59, "timestamp": "03:32:39", "text": "あなたが達成したいことは何でも"}, {"type": "subtitle", "time": 12761.429, "timestamp": "03:32:41", "text": "YouTubeで？"}, {"type": "subtitle", "time": 12763.19, "timestamp": "03:32:43", "text": "YouTubeみたいなものを作る必要がある"}, {"type": "subtitle", "time": 12766.07, "timestamp": "03:32:46", "text": "インドでのカジュアルなもののようなもの"}, {"type": "subtitle", "time": 12768.87, "timestamp": "03:32:48", "text": "これが今の私の動機です"}, {"type": "subtitle", "time": 12770.79, "timestamp": "03:32:50", "text": "普通のストリーマーが、とても有名です"}, {"type": "subtitle", "time": 12773.67, "timestamp": "03:32:53", "text": "インディアはキャリーのように地獄に生まれた"}, {"type": "subtitle", "time": 12777.349, "timestamp": "03:32:57", "text": "地獄に生まれた何か"}]
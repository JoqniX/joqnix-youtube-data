[{"type": "subtitle", "time": 19681.83, "timestamp": "05:28:01", "text": "パーティーに招待するにはどうすればいいですか？彼を追加するにはどうすればいいですか？"}, {"type": "subtitle", "time": 19684.39, "timestamp": "05:28:04", "text": "友人として？"}, {"type": "subtitle", "time": 19686.788, "timestamp": "05:28:06", "text": "エスケープをクリックするだけで、彼の"}, {"type": "subtitle", "time": 19688.72, "timestamp": "05:28:08", "text": "ユーザー名と人々。"}, {"type": "subtitle", "time": 19706.628, "timestamp": "05:28:26", "text": "よし、行こう。私たちは何者なのか"}, {"type": "subtitle", "time": 19708.15, "timestamp": "05:28:28", "text": "何をしているの？"}, {"type": "subtitle", "time": 19709.83, "timestamp": "05:28:29", "text": "まるで私たちがこれらの上に立たなければならないかのように"}, {"type": "subtitle", "time": 19711.99, "timestamp": "05:28:31", "text": "皿。"}, {"type": "subtitle", "time": 19715.19, "timestamp": "05:28:35", "text": "ああ、1つか2つね。 1対1対3。"}, {"type": "subtitle", "time": 19718.948, "timestamp": "05:28:38", "text": "1 v3。あ、待って。ええと、３人です。あなた"}, {"type": "subtitle", "time": 19724.15, "timestamp": "05:28:44", "text": "v2を1つ作成できます。 1対1対1対1"}, {"type": "subtitle", "time": 19727.19, "timestamp": "05:28:47", "text": "ffa のように。"}, {"type": "subtitle", "time": 19730.31, "timestamp": "05:28:50", "text": "通常のFFAをやりたいですか？そのためには"}, {"type": "subtitle", "time": 19733.19, "timestamp": "05:28:53", "text": "BNAパーティーが必要だよね？"}, {"type": "subtitle", "time": 19735.91, "timestamp": "05:28:55", "text": "待って、あなたを追加させてください"}, {"type": "subtitle", "time": 19738.47, "timestamp": "05:28:58", "text": "に"}]
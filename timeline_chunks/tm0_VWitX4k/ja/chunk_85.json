[{"type": "subtitle", "time": 5116.07, "timestamp": "01:25:16", "text": "だから、あなたは何を得るか、何を得るか、えーと"}, {"type": "subtitle", "time": 5118.95, "timestamp": "01:25:18", "text": "Dead by Deadとは、次のようなゲームです。"}, {"type": "subtitle", "time": 5121.59, "timestamp": "01:25:21", "text": "えっと、私が知っているのは、かくれんぼみたいなものです"}, {"type": "subtitle", "time": 5124.55, "timestamp": "01:25:24", "text": "離れて。殺人犯がいて、あなたは隠れる"}, {"type": "subtitle", "time": 5127.669, "timestamp": "01:25:27", "text": "彼らから逃げて、あなたは閉じ込められてしまう"}, {"type": "subtitle", "time": 5130.07, "timestamp": "01:25:30", "text": "遊び場か何か。"}, {"type": "subtitle", "time": 5132.87, "timestamp": "01:25:32", "text": "えっと、4つあります。4つあります。"}, {"type": "subtitle", "time": 5135.03, "timestamp": "01:25:35", "text": "生存者と殺人犯1人、そして"}, {"type": "subtitle", "time": 5138.149, "timestamp": "01:25:38", "text": "殺人者の目的は生存者を殺すことだ"}, {"type": "subtitle", "time": 5140.55, "timestamp": "01:25:40", "text": "あるいは、生存者の目標は脱出することである。それで"}, {"type": "subtitle", "time": 5142.47, "timestamp": "01:25:42", "text": "生き残った者として直さなきゃいけないから"}, {"type": "subtitle", "time": 5144.709, "timestamp": "01:25:44", "text": "サバイバーをプレイしに行く。ええと、私たちは"}, {"type": "subtitle", "time": 5148.87, "timestamp": "01:25:48", "text": "発電機を修理する。えーと、私たちは、"}, {"type": "subtitle", "time": 5151.11, "timestamp": "01:25:51", "text": "知っておけ、殺人犯を避けろ。私たちはちょうど"}, {"type": "subtitle", "time": 5153.97, "timestamp": "01:25:53", "text": "基本的に脱出を試みる"}, {"type": "subtitle", "time": 5156.31, "timestamp": "01:25:56", "text": "[音楽]"}, {"type": "subtitle", "time": 5158.149, "timestamp": "01:25:58", "text": "そして、殺人鬼に殺されないようにする。"}, {"type": "subtitle", "time": 5159.75, "timestamp": "01:25:59", "text": "そして殺人犯の目的は"}]
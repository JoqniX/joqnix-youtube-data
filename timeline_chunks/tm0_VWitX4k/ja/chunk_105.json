[{"type": "subtitle", "time": 6301.35, "timestamp": "01:45:01", "text": "それ。猫に変身すると、"}, {"type": "subtitle", "time": 6302.709, "timestamp": "01:45:02", "text": "それがアニメの全てです。しかし彼らは"}, {"type": "subtitle", "time": 6305.83, "timestamp": "01:45:05", "text": "それとコラボレーションする予定です"}, {"type": "subtitle", "time": 6307.91, "timestamp": "01:45:07", "text": "アニメと、確かVTuberもいたと思う"}, {"type": "subtitle", "time": 6310.31, "timestamp": "01:45:10", "text": "コラボレーションが発表されました。"}, {"type": "subtitle", "time": 6312.149, "timestamp": "01:45:12", "text": "おお。"}, {"type": "subtitle", "time": 6316.149, "timestamp": "01:45:16", "text": "くそ。非常識な。"}, {"type": "subtitle", "time": 6320.07, "timestamp": "01:45:20", "text": "うん、このゲームにはちょっと"}, {"type": "subtitle", "time": 6325.99, "timestamp": "01:45:25", "text": "えっと、でも、プレイして、えっと、準備完了を押します。"}, {"type": "subtitle", "time": 6328.229, "timestamp": "01:45:28", "text": "うん。準備ができたら、"}, {"type": "subtitle", "time": 6331.27, "timestamp": "01:45:31", "text": "新しいロビーみたいだけど、"}, {"type": "subtitle", "time": 6333.51, "timestamp": "01:45:33", "text": "ここでプレイしてください。私は誓いを立てるつもりはない"}, {"type": "subtitle", "time": 6335.27, "timestamp": "01:45:35", "text": "何でも。そのままにしておきます。"}, {"type": "subtitle", "time": 6337.75, "timestamp": "01:45:37", "text": "超気軽にプレイして、それを解明する"}, {"type": "subtitle", "time": 6344.87, "timestamp": "01:45:44", "text": "なぜ私は自分の進歩と"}, {"type": "subtitle", "time": 6347.59, "timestamp": "01:45:47", "text": "すべてリセットされたの？私はかつて遊んでいた"}, {"type": "subtitle", "time": 6350.95, "timestamp": "01:45:50", "text": "1回か2回。"}, {"type": "subtitle", "time": 6355.59, "timestamp": "01:45:55", "text": "実際そうだったのかもしれない。そうなるかもしれない"}]
[{"type": "subtitle", "time": 19864.948, "timestamp": "05:31:04", "text": "3対3の試合です。わからない。ああ、私たちは"}, {"type": "subtitle", "time": 19866.708, "timestamp": "05:31:06", "text": "リボルバー。"}, {"type": "subtitle", "time": 19869.59, "timestamp": "05:31:09", "text": "タップするだけで済みます。"}, {"type": "subtitle", "time": 19873.67, "timestamp": "05:31:13", "text": "スパムを続けろ。ああ、誰かがちょうど私ああ、"}, {"type": "subtitle", "time": 19886.67, "timestamp": "05:31:26", "text": "彼は狙いが上手すぎた"}, {"type": "subtitle", "time": 19888.39, "timestamp": "05:31:28", "text": "[音楽]"}, {"type": "subtitle", "time": 19894.47, "timestamp": "05:31:34", "text": "私たちもグループで行動した方がいいと思う。"}, {"type": "subtitle", "time": 19907.91, "timestamp": "05:31:47", "text": "わかったよ。代わりに狙撃してやろう。"}, {"type": "subtitle", "time": 19915.51, "timestamp": "05:31:55", "text": "ああ、この乗り物でどれくらい滑空しているんだろう"}]
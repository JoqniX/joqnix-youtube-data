[{"type": "subtitle", "time": 19522.55, "timestamp": "05:25:22", "text": "私は追加しました"}, {"type": "subtitle", "time": 19525.67, "timestamp": "05:25:25", "text": "友達リクエストが届きませんでした。待って、"}, {"type": "subtitle", "time": 19528.628, "timestamp": "05:25:28", "text": "ゲーム内でのあなたの名前は何ですか？あ、待って。病気"}, {"type": "subtitle", "time": 19530.868, "timestamp": "05:25:30", "text": "彼を追加してください。"}, {"type": "subtitle", "time": 19536.07, "timestamp": "05:25:36", "text": "しかし彼は「私はそうしました」と言った。かくして王よ。おお、"}, {"type": "subtitle", "time": 19544.708, "timestamp": "05:25:44", "text": "これは何ですか？庭を育てよう。これは何ですか"}]
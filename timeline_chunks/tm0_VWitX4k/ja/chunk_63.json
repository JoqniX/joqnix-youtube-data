[{"type": "subtitle", "time": 3781.109, "timestamp": "01:03:01", "text": "今ではたくさんのクモを見かける。しかし彼らは"}, {"type": "subtitle", "time": 3783.75, "timestamp": "01:03:03", "text": "ええ、もうそんなことはないと思います"}, {"type": "subtitle", "time": 3820.23, "timestamp": "01:03:40", "text": "私たちじゃなくてよかった。強化する"}, {"type": "subtitle", "time": 3821.99, "timestamp": "01:03:41", "text": "オルタネーター。"}, {"type": "subtitle", "time": 3823.67, "timestamp": "01:03:43", "text": "さあ、世界に足跡を残そう。"}, {"type": "subtitle", "time": 3826.39, "timestamp": "01:03:46", "text": "これで、さらに強化できます。"}, {"type": "subtitle", "time": 3829.99, "timestamp": "01:03:49", "text": "うん。だから、これらを見ると、"}, {"type": "subtitle", "time": 3834.47, "timestamp": "01:03:54", "text": "これらの弾薬には、弾薬のマークが付いています。私たちは"}, {"type": "subtitle", "time": 3836.63, "timestamp": "01:03:56", "text": "軽い弾薬の銃のようなものを持っている。単に"}]
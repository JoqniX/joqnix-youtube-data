[{"type": "subtitle", "time": 9600.23, "timestamp": "02:40:00", "text": "彼の友達とすべて、そして放浪する"}, {"type": "subtitle", "time": 9603.67, "timestamp": "02:40:03", "text": "買い物とか色々あったけど、私は"}, {"type": "subtitle", "time": 9606.87, "timestamp": "02:40:06", "text": "チェックしたり勉強したりする時間さえも私に"}, {"type": "subtitle", "time": 9609.67, "timestamp": "02:40:09", "text": "合格。それは正気の沙汰ではない。"}, {"type": "subtitle", "time": 9611.349, "timestamp": "02:40:11", "text": "あなたが幸運だったのか、それとも"}, {"type": "subtitle", "time": 9614.389, "timestamp": "02:40:14", "text": "まるで答えを知っているかのようだった。いいえ、私は"}, {"type": "subtitle", "time": 9616.79, "timestamp": "02:40:16", "text": "今すぐ読まなければならなかった。他の皆はこう"}, {"type": "subtitle", "time": 9619.03, "timestamp": "02:40:19", "text": "多肢選択問題なので"}, {"type": "subtitle", "time": 9621.59, "timestamp": "02:40:21", "text": "ただ持って行って、いろいろとやってもいいよ。だから、"}, {"type": "subtitle", "time": 9623.51, "timestamp": "02:40:23", "text": "4月に学校に行き、"}, {"type": "subtitle", "time": 9625.67, "timestamp": "02:40:25", "text": "答えがわからないので"}, {"type": "subtitle", "time": 9629.03, "timestamp": "02:40:29", "text": "私は適当に何かを選んで、"}, {"type": "subtitle", "time": 9632.469, "timestamp": "02:40:32", "text": "試験は5分で終わります"}, {"type": "subtitle", "time": 9635.59, "timestamp": "02:40:35", "text": "質疑応答はありませんでした。質問はありませんでした。"}, {"type": "subtitle", "time": 9637.59, "timestamp": "02:40:37", "text": "書かなくてもよかった答え"}, {"type": "subtitle", "time": 9640.55, "timestamp": "02:40:40", "text": "何でもいい、いやいや、それはMCQタイプだった、えっと、"}, {"type": "subtitle", "time": 9644.389, "timestamp": "02:40:44", "text": "泡立つタイプですね"}, {"type": "subtitle", "time": 9647.51, "timestamp": "02:40:47", "text": "すべてMCQですね。日本の試験はそうです"}, {"type": "subtitle", "time": 9651.67, "timestamp": "02:40:51", "text": "MCQ形式はどれも良いですね。想像する"}, {"type": "subtitle", "time": 9653.99, "timestamp": "02:40:53", "text": "学校とかでそういうことをしなきゃいけないとしたら"}, {"type": "subtitle", "time": 9657.59, "timestamp": "02:40:57", "text": "さあ、書かなきゃ。うん。もしもし"}, {"type": "subtitle", "time": 9659.99, "timestamp": "02:40:59", "text": "それは私が正しいことを書いていた"}]
[{"type": "subtitle", "time": 4327.75, "timestamp": "01:12:07", "text": "TNBの下落は、"}, {"type": "subtitle", "time": 4330.95, "timestamp": "01:12:10", "text": "エージェントのようなレイドスキンまたは"}, {"type": "subtitle", "time": 4332.95, "timestamp": "01:12:12", "text": "何か。忘れた。"}, {"type": "subtitle", "time": 4334.149, "timestamp": "01:12:14", "text": "ああ、君がどの人のことを言っているのか分かってるよ"}, {"type": "subtitle", "time": 4337.35, "timestamp": "01:12:17", "text": "について。これは愚かな質問だ。私は"}, {"type": "subtitle", "time": 4340.47, "timestamp": "01:12:20", "text": "私は子供だから、悪態をつく権利があるの？"}, {"type": "subtitle", "time": 4341.99, "timestamp": "01:12:21", "text": "H"}, {"type": "subtitle", "time": 4344.229, "timestamp": "01:12:24", "text": "汚い言葉を使うには、私は子供すぎるのでしょうか？うん。うん。感じる"}, {"type": "subtitle", "time": 4346.709, "timestamp": "01:12:26", "text": "ありのままの自分でいられる。心配ない。わかった。"}, {"type": "subtitle", "time": 4348.47, "timestamp": "01:12:28", "text": "わかった。わかった。私はよく悪態をつくんです。彼らは"}, {"type": "subtitle", "time": 4349.83, "timestamp": "01:12:29", "text": "スーツを台無しにしたくないので"}, {"type": "subtitle", "time": 4351.59, "timestamp": "01:12:31", "text": "それは罵り言葉です。なんてこった。いいえ。いいえ。すべて"}, {"type": "subtitle", "time": 4354.55, "timestamp": "01:12:34", "text": "良い。すべて順調です。"}, {"type": "subtitle", "time": 4365.11, "timestamp": "01:12:45", "text": "私が担当します。私が担当します。私が担当します。"}, {"type": "subtitle", "time": 4367.51, "timestamp": "01:12:47", "text": "わかった。くそ。彼らは私を狙っていた。"}, {"type": "subtitle", "time": 4369.99, "timestamp": "01:12:49", "text": "彼らは戦車のフルチームを擁し、"}, {"type": "subtitle", "time": 4378.63, "timestamp": "01:12:58", "text": "なので、以下は"}]
[{"type": "subtitle", "time": 1200.71, "timestamp": "00:20:00", "text": "右。よし、ゲームを面白くしたぞ。"}, {"type": "subtitle", "time": 1203.669, "timestamp": "00:20:03", "text": "でも、それは確かにクレイジーですね。"}, {"type": "subtitle", "time": 1207.669, "timestamp": "00:20:07", "text": "私は、"}, {"type": "subtitle", "time": 1211.99, "timestamp": "00:20:11", "text": "そんなに高い金額を払っているのか。だけでなく"}, {"type": "subtitle", "time": 1215.669, "timestamp": "00:20:15", "text": "ああ、あなたが持っているという感覚"}, {"type": "subtitle", "time": 1218.63, "timestamp": "00:20:18", "text": "この瞬間を手に入れるために"}, {"type": "subtitle", "time": 1221.11, "timestamp": "00:20:21", "text": "時々。うん。私はそれを持っているのが好きで、"}, {"type": "subtitle", "time": 1223.35, "timestamp": "00:20:23", "text": "ドーパミンラッシュって感じだよね、"}, {"type": "subtitle", "time": 1225.83, "timestamp": "00:20:25", "text": "知ってる、あまり好きじゃないけど、私にはそれが必要なの"}, {"type": "subtitle", "time": 1227.83, "timestamp": "00:20:27", "text": "ドーパミンはその場で、ほら、"}, {"type": "subtitle", "time": 1234.23, "timestamp": "00:20:34", "text": "そう、そこから得られるドーパミンは"}, {"type": "subtitle", "time": 1236.149, "timestamp": "00:20:36", "text": "素晴らしい。正直に言うと、"}, {"type": "subtitle", "time": 1238.95, "timestamp": "00:20:38", "text": "とても短い。非常に短い"}, {"type": "subtitle", "time": 1247.51, "timestamp": "00:20:47", "text": "わかった。あ、Steamでリクエストを送りましたよ。"}, {"type": "subtitle", "time": 1249.51, "timestamp": "00:20:49", "text": "わかった、"}, {"type": "subtitle", "time": 1251.669, "timestamp": "00:20:51", "text": "よし、これでいい。"}, {"type": "subtitle", "time": 1253.75, "timestamp": "00:20:53", "text": "モデルを削除する必要があると思います"}, {"type": "subtitle", "time": 1256.789, "timestamp": "00:20:56", "text": "これ。私のPCでは処理できません。以前はよく＿＿していた"}, {"type": "subtitle", "time": 1259.909, "timestamp": "00:20:59", "text": "えーと、僕たちがスプリットでプレイしていた頃のこと"}]
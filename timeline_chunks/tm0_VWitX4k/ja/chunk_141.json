[{"type": "subtitle", "time": 8483.75, "timestamp": "02:21:23", "text": "どうやら、"}, {"type": "subtitle", "time": 8495.75, "timestamp": "02:21:35", "text": "私が修理したばかりのこれらの岩は、"}, {"type": "subtitle", "time": 8498.55, "timestamp": "02:21:38", "text": "ハローのほんの一部。できますか？"}, {"type": "subtitle", "time": 8501.11, "timestamp": "02:21:41", "text": "みんな、聞こえる？銃を手に入れた。携帯"}, {"type": "subtitle", "time": 8505.11, "timestamp": "02:21:45", "text": "犬から感染している。"}, {"type": "subtitle", "time": 8507.75, "timestamp": "02:21:47", "text": "そう、外は文字通り雨が降っていない。"}, {"type": "subtitle", "time": 8513.27, "timestamp": "02:21:53", "text": "ここ。夕食を食べ終えたところです"}, {"type": "subtitle", "time": 8517.19, "timestamp": "02:21:57", "text": "ええ、あれは何だったんですか？ああ、それは"}]
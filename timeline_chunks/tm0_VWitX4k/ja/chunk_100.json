[{"type": "subtitle", "time": 6003.75, "timestamp": "01:40:03", "text": "非常識な"}, {"type": "subtitle", "time": 6013.59, "timestamp": "01:40:13", "text": "わあ、キャラクターたちがすごくかっこいい。"}, {"type": "subtitle", "time": 6023.99, "timestamp": "01:40:23", "text": "安定したwを求めて努力したいのですが"}, {"type": "subtitle", "time": 6025.59, "timestamp": "01:40:25", "text": "の"}, {"type": "subtitle", "time": 6028.79, "timestamp": "01:40:28", "text": "ユン。残念ながら、悲しいことに、"}, {"type": "subtitle", "time": 6030.39, "timestamp": "01:40:30", "text": "中にはお金を払わなければならないものもありますが、"}, {"type": "subtitle", "time": 6032.79, "timestamp": "01:40:32", "text": "虹色に輝くものもあります"}, {"type": "subtitle", "time": 6035.83, "timestamp": "01:40:35", "text": "ロックを解除できる破片。"}, {"type": "subtitle", "time": 6038.55, "timestamp": "01:40:38", "text": "金色のキャラクターはすべて"}, {"type": "subtitle", "time": 6041.75, "timestamp": "01:40:41", "text": "オレンジ色みたいに500とか400とか、"}, {"type": "subtitle", "time": 6044.07, "timestamp": "01:40:44", "text": "有料のキャラクター。しかしすべて"}, {"type": "subtitle", "time": 6046.629, "timestamp": "01:40:46", "text": "そのうちの4,500人くらいは"}, {"type": "subtitle", "time": 6050.79, "timestamp": "01:40:50", "text": "あるいは、それらの隣にある破片のように"}, {"type": "subtitle", "time": 6054.95, "timestamp": "01:40:54", "text": "ゲームをプレイするだけでも十分だ。ああ、"}, {"type": "subtitle", "time": 6056.31, "timestamp": "01:40:56", "text": "殺人犯についても同じことが言える。そこには"}, {"type": "subtitle", "time": 6057.83, "timestamp": "01:40:57", "text": "プレイすることで入手できるキラーもいくつかあります"}]
[{"type": "subtitle", "time": 10263.67, "timestamp": "02:51:03", "text": "インスタグラムで。ああ"}, {"type": "subtitle", "time": 10266.07, "timestamp": "02:51:06", "text": "それは"}, {"type": "subtitle", "time": 10268.63, "timestamp": "02:51:08", "text": "そうやって私はそのサーバーに参加したんだ"}, {"type": "subtitle", "time": 10281.59, "timestamp": "02:51:21", "text": "ほとんどのインド人は"}, {"type": "subtitle", "time": 10285.429, "timestamp": "02:51:25", "text": "何度もそうだったように。ええ、ありませんでした"}, {"type": "subtitle", "time": 10288.469, "timestamp": "02:51:28", "text": "当時、多くの人がそうでした。"}, {"type": "subtitle", "time": 10290.469, "timestamp": "02:51:30", "text": "それは100年以上前から始まった"}, {"type": "subtitle", "time": 10294.15, "timestamp": "02:51:34", "text": "私の記憶が正しければ。そこには"}, {"type": "subtitle", "time": 10298.469, "timestamp": "02:51:38", "text": "125 がありました"}, {"type": "subtitle", "time": 10303.11, "timestamp": "02:51:43", "text": "あるいは、2022年に戻った時のことかもしれません。"}, {"type": "subtitle", "time": 10306.389, "timestamp": "02:51:46", "text": "2023年、2024年から多くの人が来ており、"}, {"type": "subtitle", "time": 10308.63, "timestamp": "02:51:48", "text": "2025年。"}, {"type": "subtitle", "time": 10311.269, "timestamp": "02:51:51", "text": "非常識な。彼らは多すぎる。その"}, {"type": "subtitle", "time": 10313.11, "timestamp": "02:51:53", "text": "それらを見つけるのも少し難しいか、"}, {"type": "subtitle", "time": 10315.429, "timestamp": "02:51:55", "text": "ない。"}]
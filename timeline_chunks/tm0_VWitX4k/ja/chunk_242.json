[{"type": "subtitle", "time": 14538.79, "timestamp": "04:02:18", "text": "今からこのスナイパーをプレイするよ。どうやって"}, {"type": "subtitle", "time": 14542.309, "timestamp": "04:02:22", "text": "変化？ああ、核兵器。"}, {"type": "subtitle", "time": 14543.99, "timestamp": "04:02:23", "text": "あなたはどのように変化しますか？メニュー画面に移動しました"}, {"type": "subtitle", "time": 14546.15, "timestamp": "04:02:26", "text": "私が死んだ後。"}, {"type": "subtitle", "time": 14549.51, "timestamp": "04:02:29", "text": "メニュー画面に戻ったとか？"}, {"type": "subtitle", "time": 14551.11, "timestamp": "04:02:31", "text": "ええ、死んだ後にはメニューがあります"}]
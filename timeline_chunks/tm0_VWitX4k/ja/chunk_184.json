[{"type": "subtitle", "time": 11049.59, "timestamp": "03:04:09", "text": "でも、私の夢の一つは、"}, {"type": "subtitle", "time": 11052.389, "timestamp": "03:04:12", "text": "ジャマ"}, {"type": "subtitle", "time": 11054.389, "timestamp": "03:04:14", "text": "だって私は音楽の道に進みたかったから"}, {"type": "subtitle", "time": 11057.429, "timestamp": "03:04:17", "text": "今。だから私は彼女を大きなものとして保っています"}, {"type": "subtitle", "time": 11058.95, "timestamp": "03:04:18", "text": "インスピレーション"}, {"type": "subtitle", "time": 11061.03, "timestamp": "03:04:21", "text": "だから「ああ、君ならできるよ」って言えるんだ。私"}, {"type": "subtitle", "time": 11063.349, "timestamp": "03:04:23", "text": "あなたを信じています。"}, {"type": "subtitle", "time": 11067.03, "timestamp": "03:04:27", "text": "うん。もしそれがただの音楽、音楽を作るだけなら"}, {"type": "subtitle", "time": 11069.349, "timestamp": "03:04:29", "text": "そうすれば私は"}, {"type": "subtitle", "time": 11072.79, "timestamp": "03:04:32", "text": "ボーカロイド系のものとか、そういう類のもの全部"}, {"type": "subtitle", "time": 11076.309, "timestamp": "03:04:36", "text": "歌とかそういうの"}, {"type": "subtitle", "time": 11079.11, "timestamp": "03:04:39", "text": "そう、曲を書く必要があるんだ"}, {"type": "subtitle", "time": 11082.95, "timestamp": "03:04:42", "text": "歌ってください。はい。"}, {"type": "subtitle", "time": 11084.469, "timestamp": "03:04:44", "text": "それで"}, {"type": "subtitle", "time": 11086.87, "timestamp": "03:04:46", "text": "でも、歌うことが必要なんだ"}, {"type": "subtitle", "time": 11090.63, "timestamp": "03:04:50", "text": "マッチさせて、"}, {"type": "subtitle", "time": 11092.55, "timestamp": "03:04:52", "text": "最初は、"}, {"type": "subtitle", "time": 11094.79, "timestamp": "03:04:54", "text": "コース修了後、日本に定住し、"}, {"type": "subtitle", "time": 11097.19, "timestamp": "03:04:57", "text": "物、あるいはコース中に"}, {"type": "subtitle", "time": 11099.19, "timestamp": "03:04:59", "text": "パートタイムなら自由です。"}]
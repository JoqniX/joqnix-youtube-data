[{"type": "subtitle", "time": 13620.309, "timestamp": "03:47:00", "text": "時々人とコラボレーションしたり、"}, {"type": "subtitle", "time": 13622.95, "timestamp": "03:47:02", "text": "毎日とか、そんな感じで。 1対1で"}, {"type": "subtitle", "time": 13625.75, "timestamp": "03:47:05", "text": "1つ。それはあなた次第だと思います。"}, {"type": "subtitle", "time": 13633.83, "timestamp": "03:47:13", "text": "まだ動かない。画面が真っ黒です。"}, {"type": "subtitle", "time": 13635.99, "timestamp": "03:47:15", "text": "兄弟。なぜ"}, {"type": "subtitle", "time": 13639.429, "timestamp": "03:47:19", "text": "行き詰まっていますか？あなたにとっても。"}, {"type": "subtitle", "time": 13649.349, "timestamp": "03:47:29", "text": "たくさんのリン。あ、待って。あなたの"}, {"type": "subtitle", "time": 13652.63, "timestamp": "03:47:32", "text": "好きなゲームは？"}, {"type": "subtitle", "time": 13659.03, "timestamp": "03:47:39", "text": "おお。おお。わかった。わかった。"}, {"type": "subtitle", "time": 13660.87, "timestamp": "03:47:40", "text": "ニース。"}, {"type": "subtitle", "time": 13663.349, "timestamp": "03:47:43", "text": "しかし、あまりストリーミング配信はできない。ストリーミング配信"}, {"type": "subtitle", "time": 13665.75, "timestamp": "03:47:45", "text": "現在では著作権の問題が大きく影響している。私"}, {"type": "subtitle", "time": 13668.229, "timestamp": "03:47:48", "text": "ほとんどプレイしていたと思う。本当にそう思います"}, {"type": "subtitle", "time": 13670.74, "timestamp": "03:47:50", "text": "大好きです。"}, {"type": "subtitle", "time": 13672.309, "timestamp": "03:47:52", "text": "[音楽]"}]
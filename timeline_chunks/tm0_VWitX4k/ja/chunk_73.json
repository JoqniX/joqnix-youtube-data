[{"type": "subtitle", "time": 4381.27, "timestamp": "01:13:01", "text": "ジブラルタにある城で、"}, {"type": "subtitle", "time": 4383.189, "timestamp": "01:13:03", "text": "棒と呼ぶ。"}, {"type": "subtitle", "time": 4385.11, "timestamp": "01:13:05", "text": "えっと、あなたは死んだんですか？ああ、なんてことだ、君は"}, {"type": "subtitle", "time": 4387.11, "timestamp": "01:13:07", "text": "亡くなった。えっと、どこですか？ ええ、やりました。うん、"}, {"type": "subtitle", "time": 4389.189, "timestamp": "01:13:09", "text": "下に３人くらい男がいる。うん、"}, {"type": "subtitle", "time": 4391.35, "timestamp": "01:13:11", "text": "恥ずかしい。そして彼らは私を追いかけてきた"}, {"type": "subtitle", "time": 4433.75, "timestamp": "01:13:53", "text": "ああ、彼らはやって来るよ。"}, {"type": "subtitle", "time": 4436.47, "timestamp": "01:13:56", "text": "復活した。復活した。"}]
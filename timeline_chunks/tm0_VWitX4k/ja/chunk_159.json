[{"type": "subtitle", "time": 9541.99, "timestamp": "02:39:01", "text": "ええ、それで先生は始めます"}, {"type": "subtitle", "time": 9544.95, "timestamp": "02:39:04", "text": "来月からN4クラスが始まります。"}, {"type": "subtitle", "time": 9548.79, "timestamp": "02:39:08", "text": "有益でもある。 H"}, {"type": "subtitle", "time": 9551.349, "timestamp": "02:39:11", "text": "それはあなたにとっても有益です。ええ、そうです"}, {"type": "subtitle", "time": 9553.99, "timestamp": "02:39:13", "text": "アカデミーの人たちのおかげで私にとって有益です"}, {"type": "subtitle", "time": 9557.03, "timestamp": "02:39:17", "text": "4月に旅行に行った学生たちは"}, {"type": "subtitle", "time": 9561.349, "timestamp": "02:39:21", "text": "昨年4月に受け入れた彼らは苦しんでいる"}, {"type": "subtitle", "time": 9563.59, "timestamp": "02:39:23", "text": "えーと、全員失敗したから"}, {"type": "subtitle", "time": 9567.67, "timestamp": "02:39:27", "text": "NI試験の受験に関しては、私を除いて。"}, {"type": "subtitle", "time": 9571.429, "timestamp": "02:39:31", "text": "ええ、実際、それらはすべて失敗に終わりました。"}, {"type": "subtitle", "time": 9574.87, "timestamp": "02:39:34", "text": "我が神よ。うん、大変だったよ。"}, {"type": "subtitle", "time": 9577.59, "timestamp": "02:39:37", "text": "しかも、私はあまり勉強もしなかった。私は"}, {"type": "subtitle", "time": 9579.67, "timestamp": "02:39:39", "text": "チェンナイ滞在中にアニメを見ていた"}, {"type": "subtitle", "time": 9581.67, "timestamp": "02:39:41", "text": "試験のために。"}, {"type": "subtitle", "time": 9585.03, "timestamp": "02:39:45", "text": "アニメを見ていたのですか？うん。"}, {"type": "subtitle", "time": 9589.59, "timestamp": "02:39:49", "text": "何てことだ。そして、えっと、それに私の父の"}, {"type": "subtitle", "time": 9592.55, "timestamp": "02:39:52", "text": "友達か何かみたいに、彼は言った"}, {"type": "subtitle", "time": 9594.79, "timestamp": "02:39:54", "text": "大学時代か何かから"}, {"type": "subtitle", "time": 9597.75, "timestamp": "02:39:57", "text": "チェンナイ。それで私たちは彼に会いに行き、"}]
[{"type": "subtitle", "time": 6420.39, "timestamp": "01:47:00", "text": "ゲーム。"}, {"type": "subtitle", "time": 6423.91, "timestamp": "01:47:03", "text": "えっと、でも元々あなたが彼を所有していたなら、"}, {"type": "subtitle", "time": 6427.43, "timestamp": "01:47:07", "text": "すべてまだ使用できます。"}, {"type": "subtitle", "time": 6429.35, "timestamp": "01:47:09", "text": "だから、誰かが本当にOG（オリジナルギャングスター）だとわかるんだ"}, {"type": "subtitle", "time": 6433.189, "timestamp": "01:47:13", "text": "もし彼らが地獄のような"}, {"type": "subtitle", "time": 6447.59, "timestamp": "01:47:27", "text": "待って、どうしてそれを知っているの？の"}, {"type": "subtitle", "time": 6450.87, "timestamp": "01:47:30", "text": "だから誰かが年寄りだってわかる"}, {"type": "subtitle", "time": 6453.03, "timestamp": "01:47:33", "text": "前回と同じようにゲームをプレイしました"}, {"type": "subtitle", "time": 6455.75, "timestamp": "01:47:35", "text": "確か去年のことだったと思うけど、削除されたんだ"}, {"type": "subtitle", "time": 6459.27, "timestamp": "01:47:39", "text": "地獄の騒ぎを起こすピンヘッドだから、もしあなたが"}, {"type": "subtitle", "time": 6462.47, "timestamp": "01:47:42", "text": "最後に、もしあなたが"}, {"type": "subtitle", "time": 6465.109, "timestamp": "01:47:45", "text": "ピンヘッドと、もし彼らが彼を連れてこなかったら"}, {"type": "subtitle", "time": 6467.189, "timestamp": "01:47:47", "text": "まるでその人が"}, {"type": "subtitle", "time": 6474.47, "timestamp": "01:47:54", "text": "それが私も好きなところです"}, {"type": "chat", "time": 6475.308, "timestamp": "01:47:55", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "hmm"}, {"type": "subtitle", "time": 6475.83, "timestamp": "01:47:55", "text": "このゲームについて、いくつかの要素は"}, {"type": "subtitle", "time": 6479.43, "timestamp": "01:47:59", "text": "まったく違う"}]
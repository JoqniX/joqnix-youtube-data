[{"type": "subtitle", "time": 5641.75, "timestamp": "01:34:01", "text": "おお。脱出するのに時間がかかるんだね？"}, {"type": "subtitle", "time": 5643.99, "timestamp": "01:34:03", "text": "うん。うん。つまり、発電機は5台あるということです。"}, {"type": "subtitle", "time": 5646.629, "timestamp": "01:34:06", "text": "通常。"}, {"type": "subtitle", "time": 5650.31, "timestamp": "01:34:10", "text": "だから4人の生存者は"}, {"type": "subtitle", "time": 5653.669, "timestamp": "01:34:13", "text": "えっと、全部手に入れる"}, {"type": "subtitle", "time": 5656.39, "timestamp": "01:34:16", "text": "4人全員が好きです。"}, {"type": "subtitle", "time": 5668.55, "timestamp": "01:34:28", "text": "そして、もしそうなら。これで大丈夫です。では"}, {"type": "subtitle", "time": 5673.11, "timestamp": "01:34:33", "text": "この出来事。つまり、これは一体何ですか？"}, {"type": "subtitle", "time": 5676.629, "timestamp": "01:34:36", "text": "だから、生存者が一人残っているなら、えーと"}, {"type": "subtitle", "time": 5678.55, "timestamp": "01:34:38", "text": "簡単にしてあげて、一人では難しいから"}, {"type": "subtitle", "time": 5680.87, "timestamp": "01:34:40", "text": "生存者よ、行かなければならない"}, {"type": "subtitle", "time": 5682.709, "timestamp": "01:34:42", "text": "ハッチへ。"}, {"type": "subtitle", "time": 5684.95, "timestamp": "01:34:44", "text": "だから、もし生存者が一人だけ残っていたら、"}, {"type": "subtitle", "time": 5696.55, "timestamp": "01:34:56", "text": "ああ、あのゲームにゲラルっていうキャラクターがいるよ。"}, {"type": "subtitle", "time": 5699.03, "timestamp": "01:34:59", "text": "ああ、演奏できますよ。プレイできます。"}]
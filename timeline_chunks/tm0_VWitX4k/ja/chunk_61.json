[{"type": "subtitle", "time": 3666.15, "timestamp": "01:01:06", "text": "それ見逃した。えっと、"}, {"type": "subtitle", "time": 3670.23, "timestamp": "01:01:10", "text": "私はもっ​​と努力できたはずだ。ああ、今から作るには"}, {"type": "subtitle", "time": 3672.789, "timestamp": "01:01:12", "text": "12,000ドルくらい"}, {"type": "subtitle", "time": 3681.51, "timestamp": "01:01:21", "text": "まあ、伝説はあまり追加されていないね"}, {"type": "subtitle", "time": 3683.91, "timestamp": "01:01:23", "text": "それ以来ずっと。"}, {"type": "subtitle", "time": 3685.51, "timestamp": "01:01:25", "text": "いやいや、本当にそんなことはないよ。のように"}, {"type": "subtitle", "time": 3688.549, "timestamp": "01:01:28", "text": "アルトンは、彼らはただ"}, {"type": "subtitle", "time": 3690.95, "timestamp": "01:01:30", "text": "2シーズンにわたって何も貢献できなかった。"}, {"type": "subtitle", "time": 3696.789, "timestamp": "01:01:36", "text": "私の視点から見た世界を見るまで待って"}, {"type": "subtitle", "time": 3699.16, "timestamp": "01:01:39", "text": "視点。"}, {"type": "subtitle", "time": 3713.589, "timestamp": "01:01:53", "text": "ああ、ライフレアにはグライダーがあるって聞いたよ。は"}, {"type": "subtitle", "time": 3716.87, "timestamp": "01:01:56", "text": "それは本当ですか？うん。うん。ええ、そうです。彼らは"}, {"type": "subtitle", "time": 3718.549, "timestamp": "01:01:58", "text": "彼女はライフラインを再構築し、今では"}]
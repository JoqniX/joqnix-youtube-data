[{"type": "subtitle", "time": 10020.95, "timestamp": "02:47:00", "text": "もちろん。ああ、アカデミーの人たちは"}, {"type": "subtitle", "time": 10024.63, "timestamp": "02:47:04", "text": "僕が言ったように、うん、えっと"}, {"type": "subtitle", "time": 10027.91, "timestamp": "02:47:07", "text": "ノートパソコンを買う予定だったので"}, {"type": "subtitle", "time": 10031.75, "timestamp": "02:47:11", "text": "日本とかから。ええ、それから彼らは"}, {"type": "subtitle", "time": 10034.07, "timestamp": "02:47:14", "text": "まるで、"}, {"type": "subtitle", "time": 10036.55, "timestamp": "02:47:16", "text": "日本からインドへ時々行くことで"}, {"type": "subtitle", "time": 10039.51, "timestamp": "02:47:19", "text": "あなたのような人に、あの"}, {"type": "subtitle", "time": 10041.91, "timestamp": "02:47:21", "text": "そこからあなたのためのノートパソコンを持ってきてください"}, {"type": "subtitle", "time": 10044.309, "timestamp": "02:47:24", "text": "ここに私が設定できるように"}, {"type": "subtitle", "time": 10047.99, "timestamp": "02:47:27", "text": "すべては今。ええ、私は「ああ、なんてことだ」と思いました"}, {"type": "subtitle", "time": 10051.269, "timestamp": "02:47:31", "text": "神様、それは私を助けてくれるでしょう、それは私を助けてくれるでしょう"}, {"type": "subtitle", "time": 10053.91, "timestamp": "02:47:33", "text": "たくさんだけど"}, {"type": "subtitle", "time": 10057.67, "timestamp": "02:47:37", "text": "いいですね。私の最初の計画は"}, {"type": "subtitle", "time": 10061.349, "timestamp": "02:47:41", "text": "では、私のハードディスク、つまりSSDを取り上げます"}, {"type": "subtitle", "time": 10064.79, "timestamp": "02:47:44", "text": "それをスーツケースに無理やり押し込んだ。"}, {"type": "subtitle", "time": 10067.83, "timestamp": "02:47:47", "text": "うん。それは、今はノートパソコンだから"}, {"type": "subtitle", "time": 10070.87, "timestamp": "02:47:50", "text": "外部を購入する必要があります"}, {"type": "subtitle", "time": 10073.75, "timestamp": "02:47:53", "text": "SSD。ストレージは、ある意味"}, {"type": "subtitle", "time": 10075.349, "timestamp": "02:47:55", "text": "高い。"}]
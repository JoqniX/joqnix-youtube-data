[{"type": "subtitle", "time": 17460.39, "timestamp": "04:51:00", "text": "金色の虎柄の銃を手に入れた。ゴールデン。"}, {"type": "subtitle", "time": 17463.43, "timestamp": "04:51:03", "text": "何か良いものが欲しい。銃だけが必要"}, {"type": "subtitle", "time": 17496.788, "timestamp": "04:51:36", "text": "兄弟。"}, {"type": "subtitle", "time": 17499.51, "timestamp": "04:51:39", "text": "インディゴスナイパーをたくさん手に入れたよ。私はしません"}, {"type": "subtitle", "time": 17503.11, "timestamp": "04:51:43", "text": "知る。売ることすらできないんです。私は推測する"}, {"type": "subtitle", "time": 17512.31, "timestamp": "04:51:52", "text": "レベル16に到達しました。ゲームを始めました。"}, {"type": "subtitle", "time": 17515.83, "timestamp": "04:51:55", "text": "今日のこの試合。いいえ。"}, {"type": "subtitle", "time": 17519.83, "timestamp": "04:51:59", "text": "レベル6に到達しました。 78."}]
[{"type": "subtitle", "time": 7681.91, "timestamp": "02:08:01", "text": "少し神経質すぎるが、"}, {"type": "subtitle", "time": 7686.31, "timestamp": "02:08:06", "text": "仕組み的に言えば、そういうことだと思う。"}, {"type": "subtitle", "time": 7688.79, "timestamp": "02:08:08", "text": "うん、"}, {"type": "subtitle", "time": 7692.069, "timestamp": "02:08:12", "text": "うまくいかない。でも、私たちは"}, {"type": "subtitle", "time": 7696.069, "timestamp": "02:08:16", "text": "最高だと言えるでしょう。えっと"}, {"type": "subtitle", "time": 7699.669, "timestamp": "02:08:19", "text": "なぜ私はあんなことをしてしまったのだろう？"}, {"type": "subtitle", "time": 7705.669, "timestamp": "02:08:25", "text": "受け取りに行ってもいいですか？私には分かりません。 O"}, {"type": "subtitle", "time": 7709.669, "timestamp": "02:08:29", "text": "みんな、これ聞こえる？気分が落ち込んでいる。私にさせて"}, {"type": "subtitle", "time": 7714.229, "timestamp": "02:08:34", "text": "今日の配信は私たちについてです"}, {"type": "subtitle", "time": 7719.109, "timestamp": "02:08:39", "text": "えっと、いろいろやってるよね？ええと、私たちは"}, {"type": "subtitle", "time": 7731.75, "timestamp": "02:08:51", "text": "そういうことですよね？ああ、まずい。えっと、本当に"}, {"type": "subtitle", "time": 7733.83, "timestamp": "02:08:53", "text": "これをする必要がありますか？"}, {"type": "subtitle", "time": 7739.27, "timestamp": "02:08:59", "text": "ええと、わかりました。ここはどこでしたっけ？"}]
[{"type": "subtitle", "time": 7201.99, "timestamp": "02:00:01", "text": "それは個人的なことと言えるかもしれません。うん。"}, {"type": "subtitle", "time": 7205.51, "timestamp": "02:00:05", "text": "はい、これで終わりにしましょう。疲れた。"}, {"type": "subtitle", "time": 7208.149, "timestamp": "02:00:08", "text": "お招きいただきありがとうございます。とても良かった"}, {"type": "subtitle", "time": 7211.589, "timestamp": "02:00:11", "text": "君と遊びたい。 Apexは楽しかった。エイペックスは"}, {"type": "subtitle", "time": 7214.229, "timestamp": "02:00:14", "text": "本当に楽しかった。私たちは手に入れることができてとても嬉しいです"}, {"type": "subtitle", "time": 7216.79, "timestamp": "02:00:16", "text": "もう一度話をして、私たちは遊ぶべきだ"}, {"type": "subtitle", "time": 7219.589, "timestamp": "02:00:19", "text": "未来。もっと遊ぶべきだ。私たちはすべきです"}, {"type": "subtitle", "time": 7222.47, "timestamp": "02:00:22", "text": "もっとプレイしよう。うん。うん。うん。私が"}, {"type": "subtitle", "time": 7225.27, "timestamp": "02:00:25", "text": "えっと、私の入学は延期されました"}, {"type": "subtitle", "time": 7228.629, "timestamp": "02:00:28", "text": "4月26日。うん。 26. だから私はたくさん"}, {"type": "subtitle", "time": 7233.189, "timestamp": "02:00:33", "text": "さあ、今こそ遊んで楽しむ時間だ。"}, {"type": "subtitle", "time": 7235.35, "timestamp": "02:00:35", "text": "うん。一緒にゲームをしようよ。"}, {"type": "subtitle", "time": 7237.75, "timestamp": "02:00:37", "text": "うん。"}, {"type": "subtitle", "time": 7244.149, "timestamp": "02:00:44", "text": "ストリーム。バイバイ。何かありますか？"}, {"type": "subtitle", "time": 7245.669, "timestamp": "02:00:45", "text": "お知らせやその他ご希望のこと"}, {"type": "subtitle", "time": 7247.99, "timestamp": "02:00:47", "text": "事前に作る必要があった？"}, {"type": "subtitle", "time": 7250.95, "timestamp": "02:00:50", "text": "えっと、私をフォローしたいなら、"}, {"type": "subtitle", "time": 7254.709, "timestamp": "02:00:54", "text": "私のTwitchでは、毎日配信しています。"}, {"type": "subtitle", "time": 7257.669, "timestamp": "02:00:57", "text": "時々。そうなったらいいよね。"}]
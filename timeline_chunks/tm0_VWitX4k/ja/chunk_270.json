[{"type": "subtitle", "time": 16204.63, "timestamp": "04:30:04", "text": "私はこのスキルをもう一つ手に入れました。"}, {"type": "subtitle", "time": 16208.95, "timestamp": "04:30:08", "text": "大丈夫。私もレーザーが必要だ。日光浴"}, {"type": "subtitle", "time": 16211.75, "timestamp": "04:30:11", "text": "集める。"}, {"type": "subtitle", "time": 16231.11, "timestamp": "04:30:31", "text": "コア"}, {"type": "subtitle", "time": 16233.429, "timestamp": "04:30:33", "text": "カーボンケース。"}, {"type": "subtitle", "time": 16242.55, "timestamp": "04:30:42", "text": "症例数が増加した。あなたは買うことができますが、私は買いません"}, {"type": "subtitle", "time": 16245.59, "timestamp": "04:30:45", "text": "良いものを手に入れられてラッキーだ。"}, {"type": "subtitle", "time": 16247.67, "timestamp": "04:30:47", "text": "同じ。"}, {"type": "subtitle", "time": 16249.91, "timestamp": "04:30:49", "text": "待って、ダークメタルの中心部分が必要なの？"}, {"type": "subtitle", "time": 16252.63, "timestamp": "04:30:52", "text": "これには500ルーブルくらい必要だよ。"}]
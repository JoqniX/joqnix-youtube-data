[{"type": "subtitle", "time": 6541.91, "timestamp": "01:49:01", "text": "そうですね、"}, {"type": "subtitle", "time": 6543.48, "timestamp": "01:49:03", "text": "[音楽]"}, {"type": "subtitle", "time": 6556.149, "timestamp": "01:49:16", "text": "私は地図を読んでいるようなものだが、そうではない"}, {"type": "subtitle", "time": 6563.99, "timestamp": "01:49:23", "text": "ああ、地図は、地図は、ちょっと"}, {"type": "subtitle", "time": 6566.79, "timestamp": "01:49:26", "text": "ちょっと変わった話ですね。私はしません"}, {"type": "subtitle", "time": 6574.55, "timestamp": "01:49:34", "text": "[音楽]"}, {"type": "subtitle", "time": 6594.149, "timestamp": "01:49:54", "text": "ああ、彼がここにいる。"}, {"type": "subtitle", "time": 6597.03, "timestamp": "01:49:57", "text": "ああ、彼を見つけたんですね。走るのとほとんど同じ"}, {"type": "subtitle", "time": 6598.629, "timestamp": "01:49:58", "text": "もしあなたが知らないなら。まるで私たちがただ行くように"}]
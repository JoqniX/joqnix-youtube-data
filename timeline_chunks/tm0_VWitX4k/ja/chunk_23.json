[{"type": "subtitle", "time": 1380.81, "timestamp": "00:23:00", "text": "ワトソンの高級スキン。"}, {"type": "subtitle", "time": 1382.47, "timestamp": "00:23:02", "text": "[音楽]"}, {"type": "subtitle", "time": 1383.83, "timestamp": "00:23:03", "text": "うん。ええ、それについて文句を言っていました。"}, {"type": "subtitle", "time": 1385.669, "timestamp": "00:23:05", "text": "先日、ほら、ああ、"}, {"type": "subtitle", "time": 1387.11, "timestamp": "00:23:07", "text": "彼らにはプレステージスキンがありません"}, {"type": "subtitle", "time": 1390.63, "timestamp": "00:23:10", "text": "ワトソンは持っているが、他の皆も持っている。私は見た"}, {"type": "subtitle", "time": 1392.31, "timestamp": "00:23:12", "text": "彼女はそれを手に入れようとしている。私はとても"}, {"type": "subtitle", "time": 1402.149, "timestamp": "00:23:22", "text": "そうそう。そして、えっと"}, {"type": "subtitle", "time": 1405.83, "timestamp": "00:23:25", "text": "あなたはもしかしてこのゲームが得意ですか？"}, {"type": "subtitle", "time": 1408.95, "timestamp": "00:23:28", "text": "私は大丈夫です。"}, {"type": "subtitle", "time": 1411.27, "timestamp": "00:23:31", "text": "ゲームが全盛期だった頃のように、私は"}, {"type": "subtitle", "time": 1413.669, "timestamp": "00:23:33", "text": "ダイヤモンドみたいだったけど、それ以上は"}, {"type": "subtitle", "time": 1422.95, "timestamp": "00:23:42", "text": "時間。"}, {"type": "subtitle", "time": 1425.11, "timestamp": "00:23:45", "text": "うん。ええ、それはより高いランクでしたが、"}, {"type": "subtitle", "time": 1427.99, "timestamp": "00:23:47", "text": "そうじゃないみたいに。何てことだ。私たちは"}, {"type": "subtitle", "time": 1430.23, "timestamp": "00:23:50", "text": "中心部。"}, {"type": "subtitle", "time": 1432.149, "timestamp": "00:23:52", "text": "うん。つまり、私たちはこのような状況にあるということです"}, {"type": "subtitle", "time": 1435.029, "timestamp": "00:23:55", "text": "みんなみたいな感じだよね？おお"}, {"type": "subtitle", "time": 1436.87, "timestamp": "00:23:56", "text": "我が神よ。えっと、たぶんだいたい"}]
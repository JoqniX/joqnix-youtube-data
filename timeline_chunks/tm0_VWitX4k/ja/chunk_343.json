[{"type": "subtitle", "time": 20593.51, "timestamp": "05:43:13", "text": "いいえ、私の痛みのボールです。はい、わかりました。私"}, {"type": "subtitle", "time": 20600.23, "timestamp": "05:43:20", "text": "はい。"}, {"type": "subtitle", "time": 20603.43, "timestamp": "05:43:23", "text": "他に持っていません"}, {"type": "subtitle", "time": 20607.19, "timestamp": "05:43:27", "text": "私は何も持っていなかった。"}, {"type": "subtitle", "time": 20619.27, "timestamp": "05:43:39", "text": "ああ、これは素晴らしい。"}]
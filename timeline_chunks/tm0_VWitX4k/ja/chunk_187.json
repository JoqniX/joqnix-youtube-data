[{"type": "subtitle", "time": 11227.91, "timestamp": "03:07:07", "text": "こんにちは、ナス。"}, {"type": "subtitle", "time": 11230.71, "timestamp": "03:07:10", "text": "よお、ジョー、新しいニサンジ見た？"}, {"type": "subtitle", "time": 11236.15, "timestamp": "03:07:16", "text": "内破？ひねりの効いたドラマチックな展開のことですか？"}, {"type": "subtitle", "time": 11239.11, "timestamp": "03:07:19", "text": "彼は何を言っているんだ？ナンディ関連"}, {"type": "subtitle", "time": 11242.87, "timestamp": "03:07:22", "text": "起こった。ええと、ねじれたもののいくつかは"}, {"type": "subtitle", "time": 11246.469, "timestamp": "03:07:26", "text": "才能のある人たちは悪いことを言った"}, {"type": "subtitle", "time": 11248.15, "timestamp": "03:07:28", "text": "インド人"}, {"type": "chat", "time": 11249.423, "timestamp": "03:07:29", "author": "@N_I_R_NASHAK", "avatar": "https://yt4.ggpht.com/1tUEQ85FwbdYgcMSwBtAKUjwpzN8k-JYCUeDTQQXUvSFn0hVEvGSW0HPICJMtxNg5tVEcjZ-cOc=s64-c-k-c0x00ffffff-no-rj", "message": "twisty of niji was caught being racist against India and homophobic"}, {"type": "subtitle", "time": 11251.269, "timestamp": "03:07:31", "text": "それらが茶色であること、そしてそれが彼女に影響を与える"}, {"type": "subtitle", "time": 11255.349, "timestamp": "03:07:35", "text": "そしてこれとあれとこれ。"}, {"type": "subtitle", "time": 11257.429, "timestamp": "03:07:37", "text": "世界のこの状況についていく"}, {"type": "subtitle", "time": 11259.349, "timestamp": "03:07:39", "text": "人種差別的でインドに反対し、"}, {"type": "subtitle", "time": 11262.309, "timestamp": "03:07:42", "text": "同性愛嫌悪。ああ、レヴァンみたいに見てたよ"}, {"type": "subtitle", "time": 11265.03, "timestamp": "03:07:45", "text": "朝にビデオを撮っている間、私は"}, {"type": "subtitle", "time": 11269.11, "timestamp": "03:07:49", "text": "7時に寝たので、寝ようとしていました。"}, {"type": "subtitle", "time": 11271.67, "timestamp": "03:07:51", "text": "ベッドで紅茶を飲もうとしているとき、"}, {"type": "subtitle", "time": 11274.55, "timestamp": "03:07:54", "text": "眠ろうとしながら見ているような感じ。それで"}, {"type": "subtitle", "time": 11277.83, "timestamp": "03:07:57", "text": "私はそれを着けて寝て、"}]
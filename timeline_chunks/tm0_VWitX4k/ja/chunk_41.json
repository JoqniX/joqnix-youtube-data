[{"type": "subtitle", "time": 2467.109, "timestamp": "00:41:07", "text": "彼らは似たような衣装を作らなければならなかった"}, {"type": "subtitle", "time": 2469.91, "timestamp": "00:41:09", "text": "ゲーム内のキャラクター。"}, {"type": "subtitle", "time": 2473.349, "timestamp": "00:41:13", "text": "ああ、結局は直感通りだった"}, {"type": "subtitle", "time": 2476.069, "timestamp": "00:41:16", "text": "そして優勝衣装と、"}, {"type": "subtitle", "time": 2477.91, "timestamp": "00:41:17", "text": "他の衣装は"}, {"type": "subtitle", "time": 2481.19, "timestamp": "00:41:21", "text": "クリエイターたちはセットに入れられることになる。"}, {"type": "subtitle", "time": 2483.349, "timestamp": "00:41:23", "text": "それを見たとき、ちょっとワクワクした。"}, {"type": "subtitle", "time": 2487.349, "timestamp": "00:41:27", "text": "女狩人の衣装、素晴らしいですね。"}, {"type": "subtitle", "time": 2489.51, "timestamp": "00:41:29", "text": "ああ、"}, {"type": "subtitle", "time": 2491.829, "timestamp": "00:41:31", "text": "でも、下にはたくさんのものがある"}, {"type": "subtitle", "time": 2493.77, "timestamp": "00:41:33", "text": "おっぱい"}, {"type": "subtitle", "time": 2496.79, "timestamp": "00:41:36", "text": "[音楽]"}, {"type": "subtitle", "time": 2509.8, "timestamp": "00:41:49", "text": "退屈ではない。"}, {"type": "subtitle", "time": 2512.069, "timestamp": "00:41:52", "text": "[音楽]"}, {"type": "subtitle", "time": 2515.349, "timestamp": "00:41:55", "text": "うん、みんなすごく遠くにいるんだよね。調子はどうですか？"}, {"type": "subtitle", "time": 2517.99, "timestamp": "00:41:57", "text": "ping を探していますか？"}]
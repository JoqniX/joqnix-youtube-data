[{"type": "subtitle", "time": 2881.91, "timestamp": "00:48:01", "text": "何てことだ。別のチームが来る"}, {"type": "subtitle", "time": 2885.67, "timestamp": "00:48:05", "text": "別のチームから"}, {"type": "subtitle", "time": 2890.87, "timestamp": "00:48:10", "text": "もの。私たちがいた檻。はい。"}, {"type": "subtitle", "time": 2897.829, "timestamp": "00:48:17", "text": "えーと"}, {"type": "subtitle", "time": 2900.23, "timestamp": "00:48:20", "text": "その その その その"}, {"type": "subtitle", "time": 2903.03, "timestamp": "00:48:23", "text": "オクタンはちょっと戦っていた。私の"}, {"type": "subtitle", "time": 2905.589, "timestamp": "00:48:25", "text": "シールド。"}, {"type": "subtitle", "time": 2909.589, "timestamp": "00:48:29", "text": "いつここに来るかはわかりませんが、"}, {"type": "subtitle", "time": 2911.349, "timestamp": "00:48:31", "text": "あちらで何が落ちているの？私は"}, {"type": "subtitle", "time": 2912.79, "timestamp": "00:48:32", "text": "好奇心旺盛。あそこに赤いものがある"}, {"type": "subtitle", "time": 2914.309, "timestamp": "00:48:34", "text": "そして私は、何なのかを密かに気になっている"}, {"type": "subtitle", "time": 2938.63, "timestamp": "00:48:58", "text": "こっちに何か赤く光っているものがある。そして"}]
[{"type": "subtitle", "time": 11762.15, "timestamp": "03:16:02", "text": "スケジュールの件で、私は「うわあ、想像してみて」って感じ"}, {"type": "subtitle", "time": 11764.87, "timestamp": "03:16:04", "text": "もしオフカイみたいなものがあったら"}, {"type": "subtitle", "time": 11767.75, "timestamp": "03:16:07", "text": "インドですが、私にとっては博覧会はありません"}, {"type": "subtitle", "time": 11770.07, "timestamp": "03:16:10", "text": "インドで起こっていること。それが問題なんです"}, {"type": "subtitle", "time": 11772.63, "timestamp": "03:16:12", "text": "有名なユーチューバー。"}, {"type": "subtitle", "time": 11774.87, "timestamp": "03:16:14", "text": "うん、"}, {"type": "subtitle", "time": 11795.75, "timestamp": "03:16:35", "text": "たくさんあります。ぜひ参加したいです。"}, {"type": "subtitle", "time": 11798.63, "timestamp": "03:16:38", "text": "慣習を守り、それを感じさせる。まあ、君は"}, {"type": "subtitle", "time": 11800.63, "timestamp": "03:16:40", "text": "実際に応募できますが、"}, {"type": "subtitle", "time": 11803.75, "timestamp": "03:16:43", "text": "合格できてラッキーです。"}, {"type": "subtitle", "time": 11805.83, "timestamp": "03:16:45", "text": "適用する"}, {"type": "subtitle", "time": 11808.87, "timestamp": "03:16:48", "text": "ああ、あなたがホストできますよ。うん。うん。うん。"}, {"type": "subtitle", "time": 11811.99, "timestamp": "03:16:51", "text": "その他すべて。うん。ああ、オフカのために。"}, {"type": "subtitle", "time": 11814.309, "timestamp": "03:16:54", "text": "申請できます。"}, {"type": "subtitle", "time": 11818.07, "timestamp": "03:16:58", "text": "選ばれた人は、あなたにあなたの"}]
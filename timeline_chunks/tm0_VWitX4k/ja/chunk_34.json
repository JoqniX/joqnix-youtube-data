[{"type": "subtitle", "time": 2044.63, "timestamp": "00:34:04", "text": "ええ、私は南東部にいます。えーとAP"}, {"type": "subtitle", "time": 2058.71, "timestamp": "00:34:18", "text": "うん。うん。少し時間をください。私はただ"}, {"type": "subtitle", "time": 2063.109, "timestamp": "00:34:23", "text": "ええ、私も参加させてください。"}, {"type": "subtitle", "time": 2080.23, "timestamp": "00:34:40", "text": "私は参加しませんでした。ちょっと待って。えーと、友達"}, {"type": "subtitle", "time": 2085.909, "timestamp": "00:34:45", "text": "待って、なぜ参加できないと表示されるの？"}, {"type": "subtitle", "time": 2089.51, "timestamp": "00:34:49", "text": "パーティー？何？"}, {"type": "subtitle", "time": 2098.63, "timestamp": "00:34:58", "text": "ああ、私も参加しました。待って。ああ、今起動した"}]
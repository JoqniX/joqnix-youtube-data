[{"type": "subtitle", "time": 11103.03, "timestamp": "03:05:03", "text": "たぶん出席してみようと思った"}, {"type": "subtitle", "time": 11105.59, "timestamp": "03:05:05", "text": "歌のレッスンとかそういうのがあるところ"}, {"type": "subtitle", "time": 11108.469, "timestamp": "03:05:08", "text": "日本語を勉強することに興味があるので"}, {"type": "subtitle", "time": 11110.87, "timestamp": "03:05:10", "text": "今は音楽なので、そうかもしれないと思った"}, {"type": "subtitle", "time": 11113.429, "timestamp": "03:05:13", "text": "さあ、行こう。うん。うん。うん。雲"}, {"type": "subtitle", "time": 11116.15, "timestamp": "03:05:16", "text": "などなど。たくさんのこと。"}, {"type": "subtitle", "time": 11120.389, "timestamp": "03:05:20", "text": "それは一種の体験になるだろうね。"}, {"type": "subtitle", "time": 11126.71, "timestamp": "03:05:26", "text": "奇妙なループ。ああ、これは何だ？それは"}, {"type": "subtitle", "time": 11129.51, "timestamp": "03:05:29", "text": "アニメーション。ああ、私は本当に"}, {"type": "subtitle", "time": 11138.23, "timestamp": "03:05:38", "text": "ニース。"}, {"type": "subtitle", "time": 11141.91, "timestamp": "03:05:41", "text": "ああ、FRB。ああ、歌とともに。"}, {"type": "subtitle", "time": 11143.51, "timestamp": "03:05:43", "text": "はい。"}, {"type": "subtitle", "time": 11149.83, "timestamp": "03:05:49", "text": "アニメーションは本当に素晴らしい。"}, {"type": "subtitle", "time": 11153.269, "timestamp": "03:05:53", "text": "ええ、本当に良いですよ。"}]
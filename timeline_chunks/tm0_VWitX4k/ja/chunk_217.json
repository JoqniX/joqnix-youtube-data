[{"type": "subtitle", "time": 13031.429, "timestamp": "03:37:11", "text": "[音楽]"}, {"type": "subtitle", "time": 13043.59, "timestamp": "03:37:23", "text": "あなたはドライビングゲームが好きですか？"}, {"type": "subtitle", "time": 13046.71, "timestamp": "03:37:26", "text": "チャンス？ええ、少なくとも私はプレイしますよ。彼らは"}, {"type": "subtitle", "time": 13048.55, "timestamp": "03:37:28", "text": "リラックスして楽しむのもいいですよ"}, {"type": "subtitle", "time": 13055.11, "timestamp": "03:37:35", "text": "好きなドライビングゲームをプレイしてください"}, {"type": "subtitle", "time": 13058.55, "timestamp": "03:37:38", "text": "しかし最近は。それはホラー映画だった。"}, {"type": "subtitle", "time": 13060.71, "timestamp": "03:37:40", "text": "ああ、"}, {"type": "subtitle", "time": 13062.469, "timestamp": "03:37:42", "text": "ベイビー。ホラー系のドライビングゲームがある。"}, {"type": "subtitle", "time": 13064.07, "timestamp": "03:37:44", "text": "何？"}, {"type": "subtitle", "time": 13066.71, "timestamp": "03:37:46", "text": "ストリームでデモをプレイしていたとき"}, {"type": "subtitle", "time": 13068.71, "timestamp": "03:37:48", "text": "昨日。いいえ、前日のように"}, {"type": "subtitle", "time": 13076.79, "timestamp": "03:37:56", "text": "ああ、デモ版か。"}]
[{"type": "subtitle", "time": 11700.87, "timestamp": "03:15:00", "text": "もの"}, {"type": "subtitle", "time": 11703.51, "timestamp": "03:15:03", "text": "私は忘れていたことに気づいた"}, {"type": "subtitle", "time": 11707.03, "timestamp": "03:15:07", "text": "音を真実にするために、私は気づいた"}, {"type": "subtitle", "time": 11710.07, "timestamp": "03:15:10", "text": "えっと、私は何かを見ていたんです"}, {"type": "subtitle", "time": 11714.07, "timestamp": "03:15:14", "text": "Twのツイートを見て、ほとんどの"}, {"type": "subtitle", "time": 11717.03, "timestamp": "03:15:17", "text": "環境系ユーチューバーの中には、"}, {"type": "subtitle", "time": 11720.15, "timestamp": "03:15:20", "text": "ワークショップのようなものを開催する"}, {"type": "subtitle", "time": 11722.79, "timestamp": "03:15:22", "text": "編集するにはどうすればいいですか？うん。"}, {"type": "subtitle", "time": 11724.95, "timestamp": "03:15:24", "text": "ワークショップでは、彼らが作るような方法を学ぶことができます。"}, {"type": "subtitle", "time": 11727.91, "timestamp": "03:15:27", "text": "チュートリアルとかがたくさんある。うん。うん。"}, {"type": "subtitle", "time": 11730.469, "timestamp": "03:15:30", "text": "そしてどうやら"}, {"type": "subtitle", "time": 11733.51, "timestamp": "03:15:33", "text": "うん。もっと多くの人がそうできたらいいのに"}, {"type": "subtitle", "time": 11735.429, "timestamp": "03:15:35", "text": "それ。"}, {"type": "subtitle", "time": 11738.79, "timestamp": "03:15:38", "text": "つまりそれは"}, {"type": "subtitle", "time": 11740.95, "timestamp": "03:15:40", "text": "学校の課題か大学での何か"}, {"type": "subtitle", "time": 11742.389, "timestamp": "03:15:42", "text": "課題か何か。さあ、あなたは"}, {"type": "subtitle", "time": 11745.67, "timestamp": "03:15:45", "text": "PDFファイルを作成する。いいえ。ええ、スライドと"}, {"type": "subtitle", "time": 11748.15, "timestamp": "03:15:48", "text": "すべてを提示し、"}, {"type": "subtitle", "time": 11759.19, "timestamp": "03:15:59", "text": "私はオフカのエキスポを見ていた"}]
[{"type": "subtitle", "time": 15241.83, "timestamp": "04:14:01", "text": "君の哨戒機がドローンで私を攻撃した。"}, {"type": "subtitle", "time": 15244.229, "timestamp": "04:14:04", "text": "私はドローンを持っていた。"}, {"type": "subtitle", "time": 15250.55, "timestamp": "04:14:10", "text": "遠くから送られてきたものだと思った。"}, {"type": "subtitle", "time": 15252.63, "timestamp": "04:14:12", "text": "なんてこった？"}, {"type": "subtitle", "time": 15256.149, "timestamp": "04:14:16", "text": "しかし、そこには「ドローン」と書かれていた。"}, {"type": "subtitle", "time": 15259.51, "timestamp": "04:14:19", "text": "火を噴く"}, {"type": "subtitle", "time": 15279.03, "timestamp": "04:14:39", "text": "おお、"}, {"type": "subtitle", "time": 15281.78, "timestamp": "04:14:41", "text": "在庫にあります。"}, {"type": "subtitle", "time": 15283.429, "timestamp": "04:14:43", "text": "[音楽]"}, {"type": "subtitle", "time": 15285.349, "timestamp": "04:14:45", "text": "私は手に入れている"}, {"type": "subtitle", "time": 15287.429, "timestamp": "04:14:47", "text": "2回連続。スナイパーみたいに"}, {"type": "subtitle", "time": 15293.51, "timestamp": "04:14:53", "text": "ああ、ライフルだ。"}]
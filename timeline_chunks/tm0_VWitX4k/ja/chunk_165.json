[{"type": "subtitle", "time": 9901.349, "timestamp": "02:45:01", "text": "いや、いや、いや。私の部屋、私のストリーム"}, {"type": "subtitle", "time": 9904.55, "timestamp": "02:45:04", "text": "部屋は工事中で、いろいろと問題があった。えっと"}, {"type": "subtitle", "time": 9908.309, "timestamp": "02:45:08", "text": "えっと、私は以前はPCとゲームを置いていました"}, {"type": "subtitle", "time": 9911.03, "timestamp": "02:45:11", "text": "リビングで壊れたパソコン。"}, {"type": "subtitle", "time": 9913.59, "timestamp": "02:45:13", "text": "いいえ。ええと、去年はそうやって過ごしました。"}, {"type": "subtitle", "time": 9915.429, "timestamp": "02:45:15", "text": "風の波とか、そういうやつ。あなた"}, {"type": "subtitle", "time": 9917.429, "timestamp": "02:45:17", "text": "あの配信を覚えていますか？あなたは"}, {"type": "subtitle", "time": 9921.11, "timestamp": "02:45:21", "text": "そこには。うん。ああ、あの時のことだ。うん。それ"}, {"type": "subtitle", "time": 9923.429, "timestamp": "02:45:23", "text": "時間。ええ、リビングルームにありました。"}, {"type": "subtitle", "time": 9925.269, "timestamp": "02:45:25", "text": "そこで、PCを掃除して"}, {"type": "subtitle", "time": 9928.309, "timestamp": "02:45:28", "text": "すべて、私はそれを引きずっていた"}, {"type": "subtitle", "time": 9931.75, "timestamp": "02:45:31", "text": "ガラスの部品を取り外したばかりで、"}, {"type": "subtitle", "time": 9935.75, "timestamp": "02:45:35", "text": "それを置いて、うっかり"}, {"type": "subtitle", "time": 9938.63, "timestamp": "02:45:38", "text": "与えすぎた力"}, {"type": "subtitle", "time": 9941.03, "timestamp": "02:45:41", "text": "ネジが1本見えなかったから、それについて"}, {"type": "subtitle", "time": 9943.349, "timestamp": "02:45:43", "text": "または角。"}, {"type": "subtitle", "time": 9946.07, "timestamp": "02:45:46", "text": "ええ、角から粉々に砕け散って"}, {"type": "subtitle", "time": 9947.99, "timestamp": "02:45:47", "text": "要点は、それが全てだということだ"}, {"type": "subtitle", "time": 9952.389, "timestamp": "02:45:52", "text": "粉々に砕け散った。唯一の理由は"}, {"type": "subtitle", "time": 9955.19, "timestamp": "02:45:55", "text": "ステッカーのおかげで今は無傷です"}, {"type": "subtitle", "time": 9958.309, "timestamp": "02:45:58", "text": "パネルステッカーはそこにありました"}]
[{"type": "subtitle", "time": 780.47, "timestamp": "00:13:00", "text": "ああ、君たちはたくさんの詐欺を働いたんだね"}, {"type": "subtitle", "time": 782.47, "timestamp": "00:13:02", "text": "知り合いがいるから、あなたたちのうちの一人が"}, {"type": "subtitle", "time": 786.069, "timestamp": "00:13:06", "text": "最も多くの"}, {"type": "subtitle", "time": 788.069, "timestamp": "00:13:08", "text": "あなたの体は肉のようなものだとわかります、これについて"}, {"type": "subtitle", "time": 790.31, "timestamp": "00:13:10", "text": "スケールは生き残り、もう一人は死ぬ"}, {"type": "subtitle", "time": 794.629, "timestamp": "00:13:14", "text": "そしてそれはまるで、ああ"}, {"type": "subtitle", "time": 796.55, "timestamp": "00:13:16", "text": "超グロテスク、超、超"}, {"type": "subtitle", "time": 798.629, "timestamp": "00:13:18", "text": "グロテスクだが、全体的には"}, {"type": "subtitle", "time": 800.15, "timestamp": "00:13:20", "text": "人々は本当に難しい決断をしなければならない"}, {"type": "subtitle", "time": 802.71, "timestamp": "00:13:22", "text": "彼らがむしろ働きたいかという決定"}, {"type": "subtitle", "time": 805.59, "timestamp": "00:13:25", "text": "一緒に、あるいはあなたのように、私は彼らの命を失います。"}, {"type": "subtitle", "time": 807.03, "timestamp": "00:13:27", "text": "すぐにお金を使いそうだと思う"}, {"type": "subtitle", "time": 810.79, "timestamp": "00:13:30", "text": "パックを開けるとき。"}, {"type": "subtitle", "time": 812.389, "timestamp": "00:13:32", "text": "ああ、ゲームを起動するんですね。ちょっと待って。させて"}, {"type": "subtitle", "time": 816.629, "timestamp": "00:13:36", "text": "ゲームを起動します。まだ"}, {"type": "subtitle", "time": 827.03, "timestamp": "00:13:47", "text": "待って、Apexでいくら使ったの？"}, {"type": "subtitle", "time": 831.269, "timestamp": "00:13:51", "text": "Apexのゲーム？ああ、わかりました。持っていましたか"}, {"type": "subtitle", "time": 833.67, "timestamp": "00:13:53", "text": "髪の毛か何か？"}, {"type": "subtitle", "time": 835.67, "timestamp": "00:13:55", "text": "私は家宝を持っています。私は持っている"}, {"type": "subtitle", "time": 838.31, "timestamp": "00:13:58", "text": "ワトソンの家宝。私はワトソン役の大ファンです。大きい"}]
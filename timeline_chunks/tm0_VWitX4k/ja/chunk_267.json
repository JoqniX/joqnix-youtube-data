[{"type": "subtitle", "time": 16029.429, "timestamp": "04:27:09", "text": "兄弟、"}, {"type": "subtitle", "time": 16034.63, "timestamp": "04:27:14", "text": "私は強烈な爆弾を投下する。核兵器？何だって？"}, {"type": "subtitle", "time": 16055.349, "timestamp": "04:27:35", "text": "おお、我が歩哨よ。私の歩哨が炎上している。"}, {"type": "subtitle", "time": 16058.229, "timestamp": "04:27:38", "text": "何？"}, {"type": "subtitle", "time": 16062.63, "timestamp": "04:27:42", "text": "いや、まさか。"}, {"type": "subtitle", "time": 16065.75, "timestamp": "04:27:45", "text": "以前、キルを取ったことがある。何てことだ。ニース。おお"}, {"type": "subtitle", "time": 16069.51, "timestamp": "04:27:49", "text": "我が神よ。それでたくさんキルできたね。"}, {"type": "subtitle", "time": 16076.79, "timestamp": "04:27:56", "text": "ああ、またか。誰か、頼むよ、15キル必要なんだ"}]
[{"type": "subtitle", "time": 3602.23, "timestamp": "01:00:02", "text": "500に到達すると、クラフトのようなものが手に入ります"}, {"type": "subtitle", "time": 3605.03, "timestamp": "01:00:05", "text": "材料がたくさんある。"}, {"type": "subtitle", "time": 3608.63, "timestamp": "01:00:08", "text": "ええ、2.57だと思います"}, {"type": "subtitle", "time": 3611.73, "timestamp": "01:00:11", "text": "今はクラフト素材が必要です。おお、"}, {"type": "subtitle", "time": 3628.39, "timestamp": "01:00:28", "text": "私は伝説のスパーを手に入れたかった。"}, {"type": "subtitle", "time": 3630.549, "timestamp": "01:00:30", "text": "ああ、あのスパーリングの男か。そうそう。私はあなたが好きです"}, {"type": "subtitle", "time": 3634.39, "timestamp": "01:00:34", "text": "あまりにも。あなたもそうする。彼らは与え始めた"}, {"type": "subtitle", "time": 3637.27, "timestamp": "01:00:37", "text": "ただし、それらは無料です。だから、もし"}, {"type": "subtitle", "time": 3640.87, "timestamp": "01:00:40", "text": "えっと、もしあなたが"}, {"type": "subtitle", "time": 3642.47, "timestamp": "01:00:42", "text": "残念ながら無料ではありませんが、"}, {"type": "subtitle", "time": 3644.789, "timestamp": "01:00:44", "text": "まるで、ある時期があったかのように"}, {"type": "subtitle", "time": 3645.91, "timestamp": "01:00:45", "text": "一定量のように終了しました"}, {"type": "subtitle", "time": 3648.71, "timestamp": "01:00:48", "text": "任務のために、彼らはそれをあなたに渡しました"}, {"type": "subtitle", "time": 3651.109, "timestamp": "01:00:51", "text": "あ、待って。本当に？"}, {"type": "subtitle", "time": 3652.63, "timestamp": "01:00:52", "text": "うん。うん。そう、多くの"}, {"type": "subtitle", "time": 3656.39, "timestamp": "01:00:56", "text": "ゲームは今やそれを実現している。何てことだ。おお、"}, {"type": "subtitle", "time": 3658.069, "timestamp": "01:00:58", "text": "うん。ヴァロンも昔はそうしてたよね？"}, {"type": "subtitle", "time": 3659.589, "timestamp": "01:00:59", "text": "うん。"}]
[{"type": "subtitle", "time": 2940.95, "timestamp": "00:49:00", "text": "それが何なのか、私にはわかりません。甘い。これ"}, {"type": "subtitle", "time": 2943.91, "timestamp": "00:49:03", "text": "赤ちゃんは均等に見える。見つけた。"}, {"type": "subtitle", "time": 2946.39, "timestamp": "00:49:06", "text": "それは何ですか？それは神話的なゴミ箱です。"}, {"type": "subtitle", "time": 2947.91, "timestamp": "00:49:07", "text": "だから、彼らは追加したんだ。ほら、あれら"}, {"type": "subtitle", "time": 2949.75, "timestamp": "00:49:09", "text": "神話の武器？だから今、彼らは"}, {"type": "subtitle", "time": 2953.349, "timestamp": "00:49:13", "text": "ゴミ箱を見つけてスポーンするチャンス"}, {"type": "subtitle", "time": 2955.67, "timestamp": "00:49:15", "text": "そして神話級のものが見つかるかもしれません。"}, {"type": "subtitle", "time": 2959.51, "timestamp": "00:49:19", "text": "ああ、それにすごく美味しいんです。"}, {"type": "subtitle", "time": 2962.23, "timestamp": "00:49:22", "text": "ステムにバネを入れるべきですね。これ"}, {"type": "subtitle", "time": 2963.91, "timestamp": "00:49:23", "text": "は"}, {"type": "subtitle", "time": 2967.75, "timestamp": "00:49:27", "text": "ああ、なんてことだ。うん。うん。それで、"}, {"type": "subtitle", "time": 2969.75, "timestamp": "00:49:29", "text": "私は自分のものを取った。あなたは何でも取ることができる"}, {"type": "subtitle", "time": 2972.15, "timestamp": "00:49:32", "text": "ここから欲しいもの"}, {"type": "subtitle", "time": 2974.87, "timestamp": "00:49:34", "text": "そして私たちはまだ神話を手に入れました"}, {"type": "subtitle", "time": 2983.03, "timestamp": "00:49:43", "text": "しかし、それはより大きな損害をもたらすのだろうか？私は"}, {"type": "subtitle", "time": 2985.91, "timestamp": "00:49:45", "text": "同じ銃。伝説の武器。ええと、"}, {"type": "subtitle", "time": 2989.589, "timestamp": "00:49:49", "text": "わかった。金色のものもあれば、"}, {"type": "subtitle", "time": 2991.27, "timestamp": "00:49:51", "text": "金の武器、そして神話級の武器もある"}, {"type": "subtitle", "time": 2992.549, "timestamp": "00:49:52", "text": "兵器。神話級武器は"}, {"type": "subtitle", "time": 2995.27, "timestamp": "00:49:55", "text": "平和維持要員。私が手に持っているもの"}, {"type": "subtitle", "time": 2998.549, "timestamp": "00:49:58", "text": "神話級で、より多くのダメージを与えますが"}]
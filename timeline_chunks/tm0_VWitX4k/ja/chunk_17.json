[{"type": "subtitle", "time": 1020.629, "timestamp": "00:17:00", "text": "たくさんお金を持っていた。うん。"}, {"type": "subtitle", "time": 1025.029, "timestamp": "00:17:05", "text": "今の私は勉強していて"}, {"type": "subtitle", "time": 1029.51, "timestamp": "00:17:09", "text": "主に、"}, {"type": "subtitle", "time": 1032.23, "timestamp": "00:17:12", "text": "経営管理学では、と呼ばれます。"}, {"type": "subtitle", "time": 1034.309, "timestamp": "00:17:14", "text": "私は秘書です。"}, {"type": "subtitle", "time": 1036.47, "timestamp": "00:17:16", "text": "私は誰かのために帳簿をつけます"}, {"type": "subtitle", "time": 1037.47, "timestamp": "00:17:17", "text": "基本的に。"}, {"type": "subtitle", "time": 1040.309, "timestamp": "00:17:20", "text": "[音楽]"}, {"type": "subtitle", "time": 1043.099, "timestamp": "00:17:23", "text": "しかし、私は非常に良い報酬を支払います。"}, {"type": "subtitle", "time": 1053.59, "timestamp": "00:17:33", "text": "おお。うわぁ、って感じ。それは正気の沙汰ではない。"}, {"type": "subtitle", "time": 1055.59, "timestamp": "00:17:35", "text": "そうです。認めますが、それは少し"}, {"type": "subtitle", "time": 1057.11, "timestamp": "00:17:37", "text": "お金。"}, {"type": "subtitle", "time": 1070.71, "timestamp": "00:17:50", "text": "待って、"}, {"type": "subtitle", "time": 1073.59, "timestamp": "00:17:53", "text": "ちょっと話が途切れたみたいですね。"}, {"type": "subtitle", "time": 1076.15, "timestamp": "00:17:56", "text": "もしかしたら私のPCかもしれない。ええ、あなたは"}, {"type": "subtitle", "time": 1078.549, "timestamp": "00:17:58", "text": "と言っている。だから、私はあまり"}]
[{"type": "subtitle", "time": 8106.95, "timestamp": "02:15:06", "text": "ああ、この操作方法を忘れてしまった"}, {"type": "subtitle", "time": 8139.75, "timestamp": "02:15:39", "text": "[音楽]"}, {"type": "subtitle", "time": 8143.589, "timestamp": "02:15:43", "text": "装備スロットがいっぱいです。何てことだ。"}, {"type": "subtitle", "time": 8147.35, "timestamp": "02:15:47", "text": "完了。おお。おお。そこで、"}, {"type": "subtitle", "time": 8150.87, "timestamp": "02:15:50", "text": "ギアスロットの容量を増やします。"}, {"type": "subtitle", "time": 8153.43, "timestamp": "02:15:53", "text": "えっと、メロンを作るべきだと思うんだけど"}, {"type": "subtitle", "time": 8156.47, "timestamp": "02:15:56", "text": "課題。わかった。アデレードは、"}, {"type": "subtitle", "time": 8159.669, "timestamp": "02:15:59", "text": "叔父は自分の商売の地図をメモに書き留めていた。"}]
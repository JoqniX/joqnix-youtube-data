[{"type": "subtitle", "time": 7624.47, "timestamp": "02:07:04", "text": "私は自分がそれをかなり頻繁にやっていることに気づきました。"}, {"type": "subtitle", "time": 7628.31, "timestamp": "02:07:08", "text": "かなり頻繁に。私はそれをかなりよくやります"}, {"type": "subtitle", "time": 7631.109, "timestamp": "02:07:11", "text": "頻繁。なぜそうなるのか分からないが、"}, {"type": "subtitle", "time": 7633.51, "timestamp": "02:07:13", "text": "しかし、それは確かに存在する。"}, {"type": "subtitle", "time": 7637.189, "timestamp": "02:07:17", "text": "ええ、実際にそういうことなんです"}, {"type": "subtitle", "time": 7639.35, "timestamp": "02:07:19", "text": "はい、そうです。"}, {"type": "subtitle", "time": 7642.39, "timestamp": "02:07:22", "text": "こんにちは、ゲームがようやくロードされました。待って、"}, {"type": "subtitle", "time": 7645.83, "timestamp": "02:07:25", "text": "なぜ「すみません」なのですか？"}, {"type": "subtitle", "time": 7648.39, "timestamp": "02:07:28", "text": "それは何だったのか？それは何だったのか？それは何だったのか？"}, {"type": "subtitle", "time": 7651.589, "timestamp": "02:07:31", "text": "どんな感じでしたか？えっと、"}, {"type": "subtitle", "time": 7661.91, "timestamp": "02:07:41", "text": "でも、そうですね、最近私は"}, {"type": "subtitle", "time": 7665.43, "timestamp": "02:07:45", "text": "何かを自動化しようとするような"}, {"type": "subtitle", "time": 7667.83, "timestamp": "02:07:47", "text": "ストリーミング配信も全て含めて。"}, {"type": "subtitle", "time": 7670.55, "timestamp": "02:07:50", "text": "うまくいかないのは、"}, {"type": "subtitle", "time": 7673.91, "timestamp": "02:07:53", "text": "ブラザーのブラウザポリシー関連のものなど"}, {"type": "subtitle", "time": 7677.43, "timestamp": "02:07:57", "text": "すべてだよ、わかるだろ。それはある意味"}]
[{"type": "subtitle", "time": 8703.11, "timestamp": "02:25:03", "text": "すべて。おそらくマイクにノイズが入っているのでしょう"}, {"type": "subtitle", "time": 8705.91, "timestamp": "02:25:05", "text": "抑制と良質"}, {"type": "subtitle", "time": 8709.429, "timestamp": "02:25:09", "text": "PCのノイズ抑制が"}, {"type": "subtitle", "time": 8712.469, "timestamp": "02:25:12", "text": "そのため、ほとんど聞こえません。うん、"}, {"type": "subtitle", "time": 8714.469, "timestamp": "02:25:14", "text": "次に話すWがいる"}, {"type": "subtitle", "time": 8717.59, "timestamp": "02:25:17", "text": "今ですよね？ドキュメントは"}, {"type": "subtitle", "time": 8719.99, "timestamp": "02:25:19", "text": "1、2年前のこと。"}, {"type": "subtitle", "time": 8725.99, "timestamp": "02:25:25", "text": "でも大丈夫。"}, {"type": "subtitle", "time": 8729.91, "timestamp": "02:25:29", "text": "少し時間をください。もうすぐ終わります。"}, {"type": "subtitle", "time": 8731.91, "timestamp": "02:25:31", "text": "でも、面白いことに"}, {"type": "subtitle", "time": 8735.27, "timestamp": "02:25:35", "text": "私は自分の声を終わらせなければならない"}, {"type": "subtitle", "time": 8737.99, "timestamp": "02:25:37", "text": "トランスミッション 私のトランスミッション"}, {"type": "subtitle", "time": 8741.349, "timestamp": "02:25:41", "text": "ストリームまたはその他"}, {"type": "subtitle", "time": 8745.27, "timestamp": "02:25:45", "text": "それは痛みなのか、それともなぜ痛みなのか？私"}, {"type": "subtitle", "time": 8747.67, "timestamp": "02:25:47", "text": "わからない。物を買うときに耳にするかもしれません"}, {"type": "subtitle", "time": 8750.71, "timestamp": "02:25:50", "text": "私が忘れたとしても、あなたは聞いてはいけない"}, {"type": "subtitle", "time": 8753.429, "timestamp": "02:25:53", "text": "それをオフにする。家族の騒音または"}, {"type": "subtitle", "time": 8756.309, "timestamp": "02:25:56", "text": "何か。うん。"}, {"type": "subtitle", "time": 8759.349, "timestamp": "02:25:59", "text": "こんにちは、PCに戻ってきます。"}]
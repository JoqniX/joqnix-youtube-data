[{"type": "subtitle", "time": 1140.789, "timestamp": "00:19:00", "text": "今では、私が一番嫌いな肌みたい。のように"}, {"type": "subtitle", "time": 1142.63, "timestamp": "00:19:02", "text": "私はそれで遊ぶのが嫌いなので、"}, {"type": "subtitle", "time": 1144.47, "timestamp": "00:19:04", "text": "それを使ってください。"}, {"type": "subtitle", "time": 1147.19, "timestamp": "00:19:07", "text": "それが私の願いです。えっと、私は"}, {"type": "subtitle", "time": 1149.27, "timestamp": "00:19:09", "text": "それはちょっとまずいですね。えっと、買う"}, {"type": "subtitle", "time": 1152.31, "timestamp": "00:19:12", "text": "トリプル。私は費やしました"}, {"type": "subtitle", "time": 1154.31, "timestamp": "00:19:14", "text": "えっと"}, {"type": "subtitle", "time": 1159.75, "timestamp": "00:19:19", "text": "えーと、私のXに2,000ドル払ったとき、私も"}, {"type": "subtitle", "time": 1161.83, "timestamp": "00:19:21", "text": "ゲーム内のスキンコスメティックにやってきて、"}, {"type": "subtitle", "time": 1163.43, "timestamp": "00:19:23", "text": "もの"}, {"type": "subtitle", "time": 1165.59, "timestamp": "00:19:25", "text": "えっと、私たちが一緒にいた期間のことです"}, {"type": "subtitle", "time": 1168.95, "timestamp": "00:19:28", "text": "8年くらい。だから8年くらいで、"}, {"type": "subtitle", "time": 1171.029, "timestamp": "00:19:31", "text": "でも、たくさん買ったことをちょっと後悔してる"}, {"type": "subtitle", "time": 1172.39, "timestamp": "00:19:32", "text": "私はそのことについて、"}, {"type": "subtitle", "time": 1177.51, "timestamp": "00:19:37", "text": "でもそれは、"}, {"type": "subtitle", "time": 1181.19, "timestamp": "00:19:41", "text": "過去は今。もうほとんどなくなってしまった。"}, {"type": "subtitle", "time": 1184.39, "timestamp": "00:19:44", "text": "それはかなりの金額ですね。"}, {"type": "subtitle", "time": 1186.39, "timestamp": "00:19:46", "text": "ええ、かなりの金額ですね。はい、お金"}, {"type": "subtitle", "time": 1188.39, "timestamp": "00:19:48", "text": "私の"}, {"type": "subtitle", "time": 1196.23, "timestamp": "00:19:56", "text": "それ自体が狂気の沙汰だ。待って、えっと、全員"}]
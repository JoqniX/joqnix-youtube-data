[{"type": "subtitle", "time": 20418.548, "timestamp": "05:40:18", "text": "ねえ、私は期末試験を中止することはできないよ。"}, {"type": "subtitle", "time": 20428.07, "timestamp": "05:40:28", "text": "おい、目の前でリロードしろよ"}, {"type": "subtitle", "time": 20434.548, "timestamp": "05:40:34", "text": "私が殺そうとしている男は、私に殺させようとしなかった"}, {"type": "subtitle", "time": 20437.35, "timestamp": "05:40:37", "text": "私がリロードしたら、彼に会える。"}, {"type": "subtitle", "time": 20439.03, "timestamp": "05:40:39", "text": "ああ。"}]
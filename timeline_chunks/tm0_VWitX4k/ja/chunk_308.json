[{"type": "subtitle", "time": 18503.27, "timestamp": "05:08:23", "text": "わかった。再登録するにはどうすればいいですか？"}, {"type": "subtitle", "time": 18505.43, "timestamp": "05:08:25", "text": "離れる。はぁ？私のプロフィールをクリックしてください"}, {"type": "subtitle", "time": 18507.75, "timestamp": "05:08:27", "text": "参加するだけです。友人たち、誰かが付け加えた"}, {"type": "subtitle", "time": 18509.91, "timestamp": "05:08:29", "text": "自分。"}, {"type": "subtitle", "time": 18512.15, "timestamp": "05:08:32", "text": "夢よ、安らかに眠れ。"}, {"type": "subtitle", "time": 18520.788, "timestamp": "05:08:40", "text": "ライバルたち。このゲームは何だろう？"}, {"type": "subtitle", "time": 18535.79, "timestamp": "05:08:55", "text": "おお。"}]
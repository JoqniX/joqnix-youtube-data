[{"type": "subtitle", "time": 5942.39, "timestamp": "01:39:02", "text": "えーと、スティーブン・ハリントンが"}, {"type": "subtitle", "time": 5945.75, "timestamp": "01:39:05", "text": "ストレンジャー・シングス、ナンシー・ウィーラー、"}, {"type": "subtitle", "time": 5950.55, "timestamp": "01:39:10", "text": "アシュリー・J・ウィリアムズ（アッシュ対）"}, {"type": "subtitle", "time": 5956.55, "timestamp": "01:39:16", "text": "悪。えっと、他に何かありますか？えっと、"}, {"type": "subtitle", "time": 5959.51, "timestamp": "01:39:19", "text": "探偵タップがいます"}, {"type": "subtitle", "time": 5963.189, "timestamp": "01:39:23", "text": "魂。ええと、クイントン・スミスは"}, {"type": "subtitle", "time": 5967.43, "timestamp": "01:39:27", "text": "悪夢とエルストリート。えっと、それから"}, {"type": "subtitle", "time": 5970.229, "timestamp": "01:39:30", "text": "ええ、マイケルからローレン・ストロードをもらいました"}, {"type": "subtitle", "time": 5972.229, "timestamp": "01:39:32", "text": "マイヤーズ。そしてもちろん、私たちの"}, {"type": "subtitle", "time": 5974.95, "timestamp": "01:39:34", "text": "オリジナルキャラクター。そして、肌もある"}, {"type": "subtitle", "time": 5976.47, "timestamp": "01:39:36", "text": "キャラクター。あ、アラン・ウェイクも手に入れましたよ。"}, {"type": "subtitle", "time": 5979.59, "timestamp": "01:39:39", "text": "アラン・ウェイクも手に入れました。忘れた。"}, {"type": "subtitle", "time": 5984.07, "timestamp": "01:39:44", "text": "おお。そしてトレバー。トレバー・ベルモント"}, {"type": "subtitle", "time": 5986.629, "timestamp": "01:39:46", "text": "キャッスルヴァニアとビルもね。我々は持っています"}, {"type": "subtitle", "time": 5989.91, "timestamp": "01:39:49", "text": "ビルもだ。ダンジョンズ＆ドラゴンズがある"}, {"type": "subtitle", "time": 5992.79, "timestamp": "01:39:52", "text": "章。おお。"}, {"type": "subtitle", "time": 5995.43, "timestamp": "01:39:55", "text": "うん。そして私は、殺人鬼リッチを追加しました"}, {"type": "subtitle", "time": 5998.07, "timestamp": "01:39:58", "text": "そして"}]
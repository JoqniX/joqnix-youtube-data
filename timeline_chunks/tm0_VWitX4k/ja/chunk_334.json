[{"type": "subtitle", "time": 20041.51, "timestamp": "05:34:01", "text": "ああ、"}, {"type": "subtitle", "time": 20043.03, "timestamp": "05:34:03", "text": "あなたが当選したら、プレゼントを差し上げます。誰"}, {"type": "subtitle", "time": 20049.83, "timestamp": "05:34:09", "text": "ああ、あなたは本当に上手ですね。また、私の"}, {"type": "subtitle", "time": 20052.868, "timestamp": "05:34:12", "text": "状況は良くない。"}, {"type": "subtitle", "time": 20056.07, "timestamp": "05:34:16", "text": "えっと、誰かが遊んでいた"}, {"type": "subtitle", "time": 20060.39, "timestamp": "05:34:20", "text": "何？見てみましょう。その男は遊んでいた"}, {"type": "subtitle", "time": 20062.23, "timestamp": "05:34:22", "text": "コンソールのようなもの。"}, {"type": "subtitle", "time": 20065.03, "timestamp": "05:34:25", "text": "おお。"}, {"type": "subtitle", "time": 20067.83, "timestamp": "05:34:27", "text": "1対1対1でやりたいの？うん。"}, {"type": "subtitle", "time": 20069.43, "timestamp": "05:34:29", "text": "はい。"}, {"type": "subtitle", "time": 20076.708, "timestamp": "05:34:36", "text": "なぜアメリカのサーバーなのか？待って、変更"}, {"type": "subtitle", "time": 20080.23, "timestamp": "05:34:40", "text": "サーバー。ああ、サーバーへ。私にさせて"}, {"type": "subtitle", "time": 20082.47, "timestamp": "05:34:42", "text": "そこを抜けて、別のグループに入ればいい。それ"}, {"type": "subtitle", "time": 20085.11, "timestamp": "05:34:45", "text": "インドでしょう。"}, {"type": "subtitle", "time": 20088.39, "timestamp": "05:34:48", "text": "いいえ、マッチングの仕組みは異なります。うん。"}, {"type": "subtitle", "time": 20091.51, "timestamp": "05:34:51", "text": "どうすればあなたのグループに参加できますか？待って、ちょっと"}]
[{"type": "subtitle", "time": 12242.07, "timestamp": "03:24:02", "text": "私はそうは思わない。ああ、"}, {"type": "subtitle", "time": 12244.63, "timestamp": "03:24:04", "text": "これです。"}, {"type": "subtitle", "time": 12246.95, "timestamp": "03:24:06", "text": "彼らが私たちを推薦してくれていると知って嬉しいです。待って、"}, {"type": "subtitle", "time": 12249.03, "timestamp": "03:24:09", "text": "そうなんですか？"}, {"type": "subtitle", "time": 12251.429, "timestamp": "03:24:11", "text": "うん、彼女はメインで推薦されたんだ"}, {"type": "subtitle", "time": 12277.75, "timestamp": "03:24:37", "text": "いくつか動画を配信したいのですが"}, {"type": "subtitle", "time": 12280.469, "timestamp": "03:24:40", "text": "外に出ているが、連絡を取るのはとても難しいと感じている"}, {"type": "subtitle", "time": 12282.55, "timestamp": "03:24:42", "text": "に"}, {"type": "subtitle", "time": 12285.67, "timestamp": "03:24:45", "text": "なぜなら、彼らは大きいから"}, {"type": "subtitle", "time": 12288.469, "timestamp": "03:24:48", "text": "自分のサークル"}, {"type": "subtitle", "time": 12295.19, "timestamp": "03:24:55", "text": "彼らはイアンのような人たちを"}, {"type": "subtitle", "time": 12298.309, "timestamp": "03:24:58", "text": "イアンの方に惹かれるけど、"}]
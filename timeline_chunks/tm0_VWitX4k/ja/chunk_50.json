[{"type": "subtitle", "time": 3003.03, "timestamp": "00:50:03", "text": "しかし、それに対抗するには損害が必要だ。また、"}, {"type": "subtitle", "time": 3006.63, "timestamp": "00:50:06", "text": "弾薬の量が一定量あります。だから私は"}, {"type": "subtitle", "time": 3011.43, "timestamp": "00:50:11", "text": "弾丸は25発あります。ああ"}, {"type": "subtitle", "time": 3015.19, "timestamp": "00:50:15", "text": "また、私たちは今すぐにでもここを去らなければなりません。"}, {"type": "subtitle", "time": 3023.829, "timestamp": "00:50:23", "text": "10秒。リングは近い。唯一の"}, {"type": "subtitle", "time": 3026.069, "timestamp": "00:50:26", "text": "それだけの価値がある間抜け。速く、速く、"}, {"type": "subtitle", "time": 3032.79, "timestamp": "00:50:32", "text": "敵と交戦する。はい、あります"}, {"type": "subtitle", "time": 3034.39, "timestamp": "00:50:34", "text": "私たちの前にいる人たちは、"}, {"type": "subtitle", "time": 3038.79, "timestamp": "00:50:38", "text": "赤。逃げられないよ。"}, {"type": "subtitle", "time": 3041.19, "timestamp": "00:50:41", "text": "今から移動します。"}, {"type": "subtitle", "time": 3044.309, "timestamp": "00:50:44", "text": "救援物資が到着する。"}, {"type": "subtitle", "time": 3046.95, "timestamp": "00:50:46", "text": "よし、こっちへ行こう。"}, {"type": "subtitle", "time": 3049.91, "timestamp": "00:50:49", "text": "えーと、それからこちらの白い壁、"}]
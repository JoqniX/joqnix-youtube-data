[{"type": "subtitle", "time": 11820.469, "timestamp": "03:17:00", "text": "才能のある人、つまりタレントマネージャーではなく、"}, {"type": "subtitle", "time": 11823.83, "timestamp": "03:17:03", "text": "あなたの個人マネージャーまたは"}, {"type": "subtitle", "time": 11826.87, "timestamp": "03:17:06", "text": "イベントのための何か、そして彼らは"}, {"type": "subtitle", "time": 11829.19, "timestamp": "03:17:09", "text": "君にこう言うんだ、ほら、これに参加して"}, {"type": "subtitle", "time": 11831.91, "timestamp": "03:17:11", "text": "グループVC、またはこの通話、またはGoogleで私を検索してください"}, {"type": "subtitle", "time": 11834.469, "timestamp": "03:17:14", "text": "自宅からでもできるもの"}, {"type": "subtitle", "time": 11837.349, "timestamp": "03:17:17", "text": "スタッフを何人か用意して"}, {"type": "subtitle", "time": 11839.51, "timestamp": "03:17:19", "text": "彼らはテレビロボットなどを扱います"}, {"type": "subtitle", "time": 11842.15, "timestamp": "03:17:22", "text": "そう、そしてミート＆グリートもできるよ"}, {"type": "subtitle", "time": 11846.229, "timestamp": "03:17:26", "text": "選ばれるために有名になる"}, {"type": "subtitle", "time": 11847.83, "timestamp": "03:17:27", "text": "本当に運がいいか、"}, {"type": "subtitle", "time": 11852.309, "timestamp": "03:17:32", "text": "本当に有名ですね、本当です。"}, {"type": "subtitle", "time": 11856.07, "timestamp": "03:17:36", "text": "みんな応募すると思うよ、うん"}, {"type": "subtitle", "time": 11860.95, "timestamp": "03:17:40", "text": "スズキも適用しようとしたと思う"}, {"type": "subtitle", "time": 11863.349, "timestamp": "03:17:43", "text": "そう、スズキですね。"}, {"type": "subtitle", "time": 11865.59, "timestamp": "03:17:45", "text": "彼女は応募しようとしたが、"}, {"type": "subtitle", "time": 11870.87, "timestamp": "03:17:50", "text": "彼女はそれを手に入れたが、彼女の見解の1つはザックの見解だった"}, {"type": "subtitle", "time": 11873.67, "timestamp": "03:17:53", "text": "オフカイで働いていた者として"}, {"type": "subtitle", "time": 11876.95, "timestamp": "03:17:56", "text": "去年の博覧会か何かで。ああ"}, {"type": "subtitle", "time": 11878.71, "timestamp": "03:17:58", "text": "ええ、ええ"}, {"type": "chat", "time": 11879.841, "timestamp": "03:17:59", "author": "@PanditJi.Y", "avatar": "https://yt4.ggpht.com/dbuBEqO3mJ9DX4
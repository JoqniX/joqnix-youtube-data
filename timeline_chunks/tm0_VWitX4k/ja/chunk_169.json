[{"type": "subtitle", "time": 10140.79, "timestamp": "02:49:00", "text": "私がポケモンにハマっていた頃は、オタクと呼ばれていました。"}, {"type": "subtitle", "time": 10143.11, "timestamp": "02:49:03", "text": "ああ。"}, {"type": "subtitle", "time": 10144.389, "timestamp": "02:49:04", "text": "[音楽]"}, {"type": "subtitle", "time": 10146.15, "timestamp": "02:49:06", "text": "私はYouTubeを1970年代から見ています"}, {"type": "subtitle", "time": 10150.87, "timestamp": "02:49:10", "text": "ニジサンジとインド版ニサンジ。"}, {"type": "subtitle", "time": 10153.51, "timestamp": "02:49:13", "text": "うん、NとWanの頃からそこにいたよ。"}, {"type": "subtitle", "time": 10156.309, "timestamp": "02:49:16", "text": "ヴィハンが来た。私はすべての名前を挙げることさえしません"}, {"type": "subtitle", "time": 10157.83, "timestamp": "02:49:17", "text": "男。"}, {"type": "subtitle", "time": 10159.91, "timestamp": "02:49:19", "text": "ああ、ヴァン。ヴィハンだったよね？うん。"}, {"type": "subtitle", "time": 10162.79, "timestamp": "02:49:22", "text": "他に女の子が2人いた"}, {"type": "subtitle", "time": 10166.15, "timestamp": "02:49:26", "text": "あるいは、私が彼らをずっと見てきたかのように。私は行った"}, {"type": "subtitle", "time": 10169.349, "timestamp": "02:49:29", "text": "無駄な時間はほとんどない。"}, {"type": "subtitle", "time": 10171.11, "timestamp": "02:49:31", "text": "おお"}, {"type": "subtitle", "time": 10172.95, "timestamp": "02:49:32", "text": "うん。"}, {"type": "subtitle", "time": 10175.83, "timestamp": "02:49:35", "text": "自分のことから始めたんだ。"}, {"type": "subtitle", "time": 10178.469, "timestamp": "02:49:38", "text": "彼らの配信を今でも覚えている"}, {"type": "subtitle", "time": 10181.429, "timestamp": "02:49:41", "text": "岩か何かがあって、"}, {"type": "subtitle", "time": 10184.79, "timestamp": "02:49:44", "text": "彼女が歌を歌ったりしたゲーム。"}, {"type": "subtitle", "time": 10196.23, "timestamp": "02:49:56", "text": "Asusとはどういう意味ですか？どうやって"}, {"type": "subtitle", "time": 10199.83, "timestamp": "02:49:59", "text": "名前を作る？ポケモン。"}]
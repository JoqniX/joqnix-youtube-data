[{"type": "subtitle", "time": 7021.27, "timestamp": "01:57:01", "text": "我々からエネルギーを吸い取っている。"}, {"type": "subtitle", "time": 7051.589, "timestamp": "01:57:31", "text": "最初のデイリーサバイバルマッチ。レベルアップ"}, {"type": "subtitle", "time": 7057.51, "timestamp": "01:57:37", "text": "虹彩。"}, {"type": "subtitle", "time": 7067.589, "timestamp": "01:57:47", "text": "わかった。私は傍観者でいられます。そうねぇ。"}, {"type": "subtitle", "time": 7070.55, "timestamp": "01:57:50", "text": "どこにいるの？"}, {"type": "subtitle", "time": 7075.35, "timestamp": "01:57:55", "text": "私は。あ、隣に座るよ。"}, {"type": "subtitle", "time": 7078.95, "timestamp": "01:57:58", "text": "それらは以前から持っていた能力ですか？"}]
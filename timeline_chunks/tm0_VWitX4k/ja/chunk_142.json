[{"type": "subtitle", "time": 8520.07, "timestamp": "02:22:00", "text": "配信中に動作します。"}, {"type": "subtitle", "time": 8523.429, "timestamp": "02:22:03", "text": "わかった。えっと、私は信じます、聞こえますか"}, {"type": "subtitle", "time": 8525.51, "timestamp": "02:22:05", "text": "雨？"}, {"type": "subtitle", "time": 8527.59, "timestamp": "02:22:07", "text": "わからない。"}, {"type": "subtitle", "time": 8529.91, "timestamp": "02:22:09", "text": "しかし、私はノイズ抑制機能があったと思います。"}, {"type": "subtitle", "time": 8533.67, "timestamp": "02:22:13", "text": "OBSでオンにしたので、そういうことです。"}, {"type": "subtitle", "time": 8536.15, "timestamp": "02:22:16", "text": "でも、配信に復帰しますよ。"}, {"type": "subtitle", "time": 8538.87, "timestamp": "02:22:18", "text": "はい、少々お待ちください。私の"}, {"type": "subtitle", "time": 8544.55, "timestamp": "02:22:24", "text": "これはすごくクールだ。"}, {"type": "subtitle", "time": 8548.15, "timestamp": "02:22:28", "text": "私は世界のどこにでもいられるし、"}, {"type": "subtitle", "time": 8552.87, "timestamp": "02:22:32", "text": "それでも、音声で音声は"}, {"type": "subtitle", "time": 8554.87, "timestamp": "02:22:34", "text": "ストリーム中にストリームの音声が"}, {"type": "subtitle", "time": 8556.309, "timestamp": "02:22:36", "text": "走っている。"}, {"type": "subtitle", "time": 8560.23, "timestamp": "02:22:40", "text": "これ、すごくかっこいいよ。"}, {"type": "subtitle", "time": 8562.15, "timestamp": "02:22:42", "text": "曲がった木。テクノロジーと"}, {"type": "subtitle", "time": 8564.469, "timestamp": "02:22:44", "text": "革新的なものって本当に素晴らしいよね。タワー"}, {"type": "subtitle", "time": 8567.51, "timestamp": "02:22:47", "text": "ここから落ちてはいけない。どこ？病気"}, {"type": "subtitle", "time": 8569.75, "timestamp": "02:22:49", "text": "食料をいくつか持っていく。ああ、つまり"}, {"type": "subtitle", "time": 8571.75, "timestamp": "02:22:51", "text": "これ？私は文字通り"}, {"type": "subtitle", "time": 8574.07, "timestamp": "02:22:54", "text": "冷蔵庫。"}]
[{"type": "subtitle", "time": 8412.23, "timestamp": "02:20:12", "text": "だから、ここは適切な場所ではない。どういう意味ですか？"}, {"type": "subtitle", "time": 8423.59, "timestamp": "02:20:23", "text": "何？そして私はこれが特別なものだと思った"}, {"type": "subtitle", "time": 8435.67, "timestamp": "02:20:35", "text": "キャラクターは実際に岩と言った"}, {"type": "subtitle", "time": 8438.79, "timestamp": "02:20:38", "text": "形成。岩石の形成は最初の"}, {"type": "subtitle", "time": 8458.63, "timestamp": "02:20:58", "text": "よし、1つ完了した。"}]
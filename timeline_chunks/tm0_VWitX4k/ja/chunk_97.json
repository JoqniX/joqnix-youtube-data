[{"type": "subtitle", "time": 5820.79, "timestamp": "01:37:00", "text": "私は生存者役を演じることができる。えっと、それで"}, {"type": "subtitle", "time": 5822.149, "timestamp": "01:37:02", "text": "あなたが何をするつもりか、私があなたに任せるから"}, {"type": "subtitle", "time": 5824.47, "timestamp": "01:37:04", "text": "自分のサーバー上で実行してください。ああ、私は参加しました"}, {"type": "subtitle", "time": 5826.47, "timestamp": "01:37:06", "text": "あなたの。"}, {"type": "subtitle", "time": 5830.95, "timestamp": "01:37:10", "text": "なんてこった。大丈夫。さあ、もう一度プレイしよう。行く"}, {"type": "subtitle", "time": 5835.83, "timestamp": "01:37:15", "text": "「プレイ」をクリックして、生存者としてプレイしてください。"}, {"type": "subtitle", "time": 5841.35, "timestamp": "01:37:21", "text": "わかった。えっと、サバイバーとしてプレイする"}, {"type": "subtitle", "time": 5843.43, "timestamp": "01:37:23", "text": "そしてロビーのような場所を見ると"}, {"type": "subtitle", "time": 5845.83, "timestamp": "01:37:25", "text": "そうすれば、あなたのロビーに参加できます。"}, {"type": "subtitle", "time": 5851.59, "timestamp": "01:37:31", "text": "そうなると、こうなります"}, {"type": "subtitle", "time": 5853.99, "timestamp": "01:37:33", "text": "技術的には、それはあなたの"}, {"type": "subtitle", "time": 5856.31, "timestamp": "01:37:36", "text": "一般的な。"}, {"type": "subtitle", "time": 5857.91, "timestamp": "01:37:37", "text": "だから、高いpをクリックしますが、大丈夫です"}, {"type": "subtitle", "time": 5859.189, "timestamp": "01:37:39", "text": "それと。繰り返しますが、私は気にしません"}, {"type": "subtitle", "time": 5860.39, "timestamp": "01:37:40", "text": "それ。"}, {"type": "subtitle", "time": 5863.83, "timestamp": "01:37:43", "text": "そして私たちはただ"}, {"type": "subtitle", "time": 5867.99, "timestamp": "01:37:47", "text": "それで、ええと、そうすればあなたは"}, {"type": "subtitle", "time": 5869.59, "timestamp": "01:37:49", "text": "血液と呼ばれるものがある"}, {"type": "subtitle", "time": 5875.03, "timestamp": "01:37:55", "text": "血液のポイント。お分かりですか？つまり、"}, {"type": "subtitle", "time": 5877.51, "timestamp": "01:37:57", "text": "赤い三角形のようなもの"}]
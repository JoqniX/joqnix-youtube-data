[{"type": "subtitle", "time": 10800.57, "timestamp": "03:00:00", "text": "私にとってそれは靴下のようなものだった。"}, {"type": "subtitle", "time": 10806.469, "timestamp": "03:00:06", "text": "それは何か"}, {"type": "subtitle", "time": 10809.11, "timestamp": "03:00:09", "text": "普通"}, {"type": "subtitle", "time": 10816.87, "timestamp": "03:00:16", "text": "それは今の時代、それは"}, {"type": "subtitle", "time": 10820.55, "timestamp": "03:00:20", "text": "もし、もしコーポレーションのような代理店のメンバーが"}, {"type": "subtitle", "time": 10822.63, "timestamp": "03:00:22", "text": "どちらでも"}, {"type": "subtitle", "time": 10825.19, "timestamp": "03:00:25", "text": "卒業生にはたくさんのルールがある"}, {"type": "subtitle", "time": 10827.99, "timestamp": "03:00:27", "text": "彼ら。うん。うん。企業関係のことだよ、わかるだろ？"}, {"type": "subtitle", "time": 10830.71, "timestamp": "03:00:30", "text": "ルールが多すぎる。"}, {"type": "subtitle", "time": 10832.309, "timestamp": "03:00:32", "text": "はい。"}, {"type": "subtitle", "time": 10835.48, "timestamp": "03:00:35", "text": "たくさんのこと。"}, {"type": "subtitle", "time": 10837.269, "timestamp": "03:00:37", "text": "[音楽]"}, {"type": "subtitle", "time": 10840.71, "timestamp": "03:00:40", "text": "ああ、カフが新曲を出した。私はこう思う、"}, {"type": "subtitle", "time": 10845.349, "timestamp": "03:00:45", "text": "おお。ちょっと待って、リンクをお送りしますね。"}, {"type": "subtitle", "time": 10849.03, "timestamp": "03:00:49", "text": "ちょっと待って、確認させて。では、お話ししましょう。"}, {"type": "subtitle", "time": 10852.07, "timestamp": "03:00:52", "text": "これは深マギスタジオの作品の一つです。"}, {"type": "subtitle", "time": 10855.83, "timestamp": "03:00:55", "text": "彼らが与えているような主な人物"}, {"type": "subtitle", "time": 10857.59, "timestamp": "03:00:57", "text": "もっとお金が欲しい、とか、いろいろと。"}]
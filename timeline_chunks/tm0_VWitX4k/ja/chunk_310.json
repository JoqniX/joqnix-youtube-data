[{"type": "subtitle", "time": 18601.99, "timestamp": "05:10:01", "text": "待って。これはどのようなモードですか？私はしません"}, {"type": "subtitle", "time": 18604.39, "timestamp": "05:10:04", "text": "知る。何"}, {"type": "subtitle", "time": 18606.948, "timestamp": "05:10:06", "text": "私たちは何かを禁止しているのですか？"}, {"type": "subtitle", "time": 18619.19, "timestamp": "05:10:19", "text": "待って、これって禁止措置なの？"}, {"type": "subtitle", "time": 18622.15, "timestamp": "05:10:22", "text": "はい。おお。武器をいくつか持っていくことができます。私"}, {"type": "subtitle", "time": 18634.39, "timestamp": "05:10:34", "text": "これは一体何ですか？どれだけのものを"}, {"type": "subtitle", "time": 18637.27, "timestamp": "05:10:37", "text": "禁止する必要があるのか​​？"}, {"type": "subtitle", "time": 18640.23, "timestamp": "05:10:40", "text": "2つくらいあるよ。"}, {"type": "subtitle", "time": 18642.708, "timestamp": "05:10:42", "text": "私たちはそれを手に入れなければならない。"}]
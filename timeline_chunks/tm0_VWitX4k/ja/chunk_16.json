[{"type": "subtitle", "time": 961.43, "timestamp": "00:16:01", "text": "そのうちの"}, {"type": "subtitle", "time": 965.43, "timestamp": "00:16:05", "text": "ルートボックス。聖なる。"}, {"type": "subtitle", "time": 970.389, "timestamp": "00:16:10", "text": "そして、私は約5000ドル使ったと思います"}, {"type": "subtitle", "time": 972.949, "timestamp": "00:16:12", "text": "リーグ・オブ・レジェンドについて。"}, {"type": "subtitle", "time": 976.31, "timestamp": "00:16:16", "text": "何？何？"}, {"type": "subtitle", "time": 977.91, "timestamp": "00:16:17", "text": "私はリーグ・オブ・レジェンドを始めてまだ3年しか経っていません"}, {"type": "subtitle", "time": 980.31, "timestamp": "00:16:20", "text": "年なので、もう少し"}, {"type": "subtitle", "time": 982.55, "timestamp": "00:16:22", "text": "思っていたよりもお金がかかってしまったんだ。"}, {"type": "subtitle", "time": 990.069, "timestamp": "00:16:30", "text": "それは正気の沙汰ではない。"}, {"type": "subtitle", "time": 993.35, "timestamp": "00:16:33", "text": "ええと、私は計算しました、私は"}, {"type": "subtitle", "time": 996.87, "timestamp": "00:16:36", "text": "ヴァレラントに費やした金額"}, {"type": "subtitle", "time": 1001.35, "timestamp": "00:16:41", "text": "そしてヴァレラントは"}, {"type": "subtitle", "time": 1013.829, "timestamp": "00:16:53", "text": "それは"}, {"type": "subtitle", "time": 1015.829, "timestamp": "00:16:55", "text": "いかなる時点においても失業状態にあること。だから、私は"}]
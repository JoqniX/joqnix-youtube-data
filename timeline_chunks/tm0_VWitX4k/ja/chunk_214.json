[{"type": "subtitle", "time": 12841.91, "timestamp": "03:34:01", "text": "そうそう。彼らはカスタムメイドの"}, {"type": "subtitle", "time": 12843.91, "timestamp": "03:34:03", "text": "自分のサーバーを作ることができ、"}, {"type": "subtitle", "time": 12846.309, "timestamp": "03:34:06", "text": "もの。うん、"}, {"type": "subtitle", "time": 12848.469, "timestamp": "03:34:08", "text": "カスタムワールド。"}, {"type": "subtitle", "time": 12851.19, "timestamp": "03:34:11", "text": "はい。うん。"}, {"type": "subtitle", "time": 12853.59, "timestamp": "03:34:13", "text": "さらに、彼らは非常に多くのコラボレーションを実現しました。私はできる"}, {"type": "subtitle", "time": 12860.55, "timestamp": "03:34:20", "text": "彼らは最近あまりコラボレーションをしていない。"}, {"type": "subtitle", "time": 12863.91, "timestamp": "03:34:23", "text": "多すぎる。"}, {"type": "subtitle", "time": 12865.59, "timestamp": "03:34:25", "text": "彼らはどうやってそんなに多くのコラボレーションを実現しているのだろうか？"}, {"type": "subtitle", "time": 12867.349, "timestamp": "03:34:27", "text": "それが私の疑問です。なんていうか、それはあまりにも"}, {"type": "subtitle", "time": 12879.67, "timestamp": "03:34:39", "text": "ああ、インストールで詰まってしまった。私はできません"}, {"type": "subtitle", "time": 12882.389, "timestamp": "03:34:42", "text": "キャンセルすることさえできる。"}, {"type": "subtitle", "time": 12885.67, "timestamp": "03:34:45", "text": "インストール段階で止まってしまっています。"}, {"type": "subtitle", "time": 12887.75, "timestamp": "03:34:47", "text": "これがある。これ試したことありますか？"}, {"type": "subtitle", "time": 12891.429, "timestamp": "03:34:51", "text": "「フォーセイクン」とかいう名前だったかな？私は見た"}, {"type": "subtitle", "time": 12893.51, "timestamp": "03:34:53", "text": "人々はForsakenについて語る。うん、"}, {"type": "subtitle", "time": 12895.99, "timestamp": "03:34:55", "text": "見捨てられた。それはRobloxにあるの？それとも何？"}]
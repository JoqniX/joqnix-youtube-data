[{"type": "subtitle", "time": 19022.15, "timestamp": "05:17:02", "text": "何に参加できますか？参加したいですか？ミンク"}, {"type": "subtitle", "time": 19030.55, "timestamp": "05:17:10", "text": "待って、彼は私の友達リストに入ってるよ。あなたはできる"}, {"type": "subtitle", "time": 19032.55, "timestamp": "05:17:12", "text": "再度参加してください。"}, {"type": "subtitle", "time": 19044.83, "timestamp": "05:17:24", "text": "で。"}, {"type": "subtitle", "time": 19047.43, "timestamp": "05:17:27", "text": "[音楽]"}]
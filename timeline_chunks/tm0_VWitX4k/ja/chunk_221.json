[{"type": "subtitle", "time": 13260.309, "timestamp": "03:41:00", "text": "わかった。待って。えっと、準備はいい？"}, {"type": "subtitle", "time": 13263.51, "timestamp": "03:41:03", "text": "わかった。 1分だけ時間をください。わかった。"}, {"type": "subtitle", "time": 13265.75, "timestamp": "03:41:05", "text": "遊ぶ。"}, {"type": "subtitle", "time": 13277.19, "timestamp": "03:41:17", "text": "私は再生ボタンをクリックした。何？"}, {"type": "subtitle", "time": 13280.07, "timestamp": "03:41:20", "text": "ゲームに参加することもできますし、"}, {"type": "subtitle", "time": 13281.99, "timestamp": "03:41:21", "text": "ドア。"}, {"type": "subtitle", "time": 13284.87, "timestamp": "03:41:24", "text": "うん、ここみたいに行けるよ。"}, {"type": "subtitle", "time": 13289.83, "timestamp": "03:41:29", "text": "それだけです。これは店内で遊べるゲームです。"}, {"type": "subtitle", "time": 13302.07, "timestamp": "03:41:42", "text": "私は主にRNGやファーミング系のゲームをプレイします。"}, {"type": "subtitle", "time": 13304.229, "timestamp": "03:41:44", "text": "Robloxのような"}, {"type": "subtitle", "time": 13308.79, "timestamp": "03:41:48", "text": "そして、バトルグラウンド・ファーミングゲームのようなもの。"}, {"type": "subtitle", "time": 13311.59, "timestamp": "03:41:51", "text": "ええ、私が農場を経営しなければならないような場所です"}, {"type": "subtitle", "time": 13314.229, "timestamp": "03:41:54", "text": "農業関連のものとは違って、"}, {"type": "subtitle", "time": 13317.75, "timestamp": "03:41:57", "text": "農作業、農作業、ひたすらな作業。"}]
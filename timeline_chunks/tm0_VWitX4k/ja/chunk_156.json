[{"type": "subtitle", "time": 9363.27, "timestamp": "02:36:03", "text": "わからない。心配ない。そしてそれは私たちの"}, {"type": "subtitle", "time": 9366.95, "timestamp": "02:36:06", "text": "ある意味、初めてのコラボレーションですね。ええと、私たちは"}, {"type": "subtitle", "time": 9369.51, "timestamp": "02:36:09", "text": "私たちはグループで会いました"}, {"type": "subtitle", "time": 9373.349, "timestamp": "02:36:13", "text": "以前にもコラボしたことがあるよね？うん。うん。その"}, {"type": "subtitle", "time": 9375.99, "timestamp": "02:36:15", "text": "私自身をテーマにしたコラボレーションは今回が初めてです。その"}, {"type": "subtitle", "time": 9379.429, "timestamp": "02:36:19", "text": "少し緊張している。あれみたいに"}, {"type": "subtitle", "time": 9383.67, "timestamp": "02:36:23", "text": "コラボレーションを一つだけ行うのは、私にとってはちょっと緊張します。"}, {"type": "subtitle", "time": 9397.67, "timestamp": "02:36:37", "text": "でも、初めてなので、"}, {"type": "subtitle", "time": 9400.469, "timestamp": "02:36:40", "text": "話せるのは嬉しいです"}, {"type": "subtitle", "time": 9402.71, "timestamp": "02:36:42", "text": "あなたと話したり、いろいろしたり。"}, {"type": "subtitle", "time": 9406.15, "timestamp": "02:36:46", "text": "いいねしてコラボしよう"}, {"type": "subtitle", "time": 9409.429, "timestamp": "02:36:49", "text": "あなたが"}, {"type": "subtitle", "time": 9415.429, "timestamp": "02:36:55", "text": "さて、最近はいかがでしたか？調子はどうですか"}, {"type": "subtitle", "time": 9417.349, "timestamp": "02:36:57", "text": "あなた？"}, {"type": "subtitle", "time": 9419.349, "timestamp": "02:36:59", "text": "地域社会ではかなり良い雰囲気です"}]
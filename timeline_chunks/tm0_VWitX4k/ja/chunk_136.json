[{"type": "subtitle", "time": 8161.83, "timestamp": "02:16:01", "text": "おそらくこれらのランドマークは私を"}, {"type": "subtitle", "time": 8164.31, "timestamp": "02:16:04", "text": "彼。"}, {"type": "subtitle", "time": 8167.83, "timestamp": "02:16:07", "text": "オークス氏の業界誌。業界誌。"}, {"type": "subtitle", "time": 8170.47, "timestamp": "02:16:10", "text": "これは興味深い。ますます"}, {"type": "subtitle", "time": 8172.629, "timestamp": "02:16:12", "text": "さらに興味深いことに"}, {"type": "subtitle", "time": 8176.069, "timestamp": "02:16:16", "text": "その時には。"}, {"type": "subtitle", "time": 8187.189, "timestamp": "02:16:27", "text": "Rlandの地図を使用してください。わかった。だから私たちは"}, {"type": "subtitle", "time": 8190.55, "timestamp": "02:16:30", "text": "実際にこの地図を使うべきなのは"}, {"type": "subtitle", "time": 8192.709, "timestamp": "02:16:32", "text": "できる"}, {"type": "subtitle", "time": 8195.99, "timestamp": "02:16:35", "text": "必要な場所であなたを区別します"}, {"type": "subtitle", "time": 8198.07, "timestamp": "02:16:38", "text": "持ち帰り。"}, {"type": "subtitle", "time": 8204.07, "timestamp": "02:16:44", "text": "でも、私のゲスト枠はほぼ埋まっています"}, {"type": "subtitle", "time": 8219.429, "timestamp": "02:16:59", "text": "これです。ああ、Roblox。わかった。"}]
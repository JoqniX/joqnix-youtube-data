[{"type": "subtitle", "time": 8641.83, "timestamp": "02:24:01", "text": "このリンゴはどこに置けばいいですか？そして"}, {"type": "subtitle", "time": 8644.71, "timestamp": "02:24:04", "text": "崩れかけた塔。わかった。ここに置いてください。"}, {"type": "subtitle", "time": 8647.27, "timestamp": "02:24:07", "text": "ここから真南。ああ、それはあまりにも"}, {"type": "subtitle", "time": 8651.03, "timestamp": "02:24:11", "text": "寒い。わかった。りんご。あれ。そして暑い"}, {"type": "subtitle", "time": 8652.87, "timestamp": "02:24:12", "text": "水。"}, {"type": "subtitle", "time": 8656.389, "timestamp": "02:24:16", "text": "ああ、そうだね。このカレーを入れなければならない"}, {"type": "subtitle", "time": 8660.07, "timestamp": "02:24:20", "text": "冷蔵庫に戻るんだよね？ああ神様、"}, {"type": "subtitle", "time": 8662.55, "timestamp": "02:24:22", "text": "やらなきゃいけないんだ。あ、待って。あのね？"}, {"type": "subtitle", "time": 8665.91, "timestamp": "02:24:25", "text": "ちょっと待ってくれよ、みんな。選んだ。それは"}, {"type": "subtitle", "time": 8668.15, "timestamp": "02:24:28", "text": "本来行われるべきではなかったこと。あなたのベスト"}, {"type": "subtitle", "time": 8671.429, "timestamp": "02:24:31", "text": "一瞬。そこはゲートで囲まれた場所です。わかった、"}, {"type": "subtitle", "time": 8674.23, "timestamp": "02:24:34", "text": "それは一人の男の話です。ここにあります。入手する"}, {"type": "subtitle", "time": 8676.389, "timestamp": "02:24:36", "text": "二人目の男。"}, {"type": "subtitle", "time": 8679.67, "timestamp": "02:24:39", "text": "それから、お米に水を入れなければなりません"}, {"type": "subtitle", "time": 8681.83, "timestamp": "02:24:41", "text": "だって、誰も食べていないから。私"}, {"type": "subtitle", "time": 8684.15, "timestamp": "02:24:44", "text": "食事を終えた。私の父と母は"}, {"type": "subtitle", "time": 8688.95, "timestamp": "02:24:48", "text": "自宅で。まあ、そういうことだ。かなり悪い"}, {"type": "subtitle", "time": 8690.55, "timestamp": "02:24:50", "text": "それ"}, {"type": "subtitle", "time": 8693.67, "timestamp": "02:24:53", "text": "そういう風にキッチンで料理ができるんだ"}, {"type": "subtitle", "time": 8697.51, "timestamp": "02:24:57", "text": "この時点で。でもどれくらいかはわからない"}, {"type": "subtitle", "time": 8699.75, "timestamp": "02:24:59", "text": "背景の雑音が聞こえ、"}]
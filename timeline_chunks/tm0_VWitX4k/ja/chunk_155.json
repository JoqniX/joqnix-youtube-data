[{"type": "subtitle", "time": 9306.23, "timestamp": "02:35:06", "text": "私は文字通りこの場所を掃除している"}, {"type": "subtitle", "time": 9308.71, "timestamp": "02:35:08", "text": "ゴブリンだらけ"}, {"type": "subtitle", "time": 9320.07, "timestamp": "02:35:20", "text": "そしてこれは確かに正しい方法ではない"}, {"type": "subtitle", "time": 9323.03, "timestamp": "02:35:23", "text": "行かなきゃいけないけど、でも"}, {"type": "subtitle", "time": 9326.01, "timestamp": "02:35:26", "text": "うん"}, {"type": "subtitle", "time": 9335.91, "timestamp": "02:35:35", "text": "みなさんこんにちは、第2回へようこそ"}, {"type": "subtitle", "time": 9338.63, "timestamp": "02:35:38", "text": "ヨアトンの一部"}, {"type": "subtitle", "time": 9343.03, "timestamp": "02:35:43", "text": "2日目パート2。ということで、ここにアッシュがいます"}, {"type": "subtitle", "time": 9348.389, "timestamp": "02:35:48", "text": "本日のゲストはどなたでしょうか。こんにちは、アッシュ。"}, {"type": "subtitle", "time": 9353.83, "timestamp": "02:35:53", "text": "なんてこった。こんにちは。こんにちは。こんにちは、猫ちゃん。ヒロ。"}, {"type": "subtitle", "time": 9357.03, "timestamp": "02:35:57", "text": "ヒロ。すごく緊張する。なぜあなたは"}, {"type": "subtitle", "time": 9359.429, "timestamp": "02:35:59", "text": "神経質？"}]
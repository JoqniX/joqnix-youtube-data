[{"type": "subtitle", "time": 6490.55, "timestamp": "01:48:10", "text": "こんにちは、お母さん。親切にありがとうございます"}, {"type": "subtitle", "time": 6497.109, "timestamp": "01:48:17", "text": "ああ、これは一体何の供物ですか？"}, {"type": "subtitle", "time": 6500.39, "timestamp": "01:48:20", "text": "つまり、ゲーム内には様々な特典があるということです。えっと、私は"}, {"type": "subtitle", "time": 6502.709, "timestamp": "01:48:22", "text": "追加しました。"}, {"type": "subtitle", "time": 6504.39, "timestamp": "01:48:24", "text": "私たちにとってはもう少し楽になるが、"}, {"type": "subtitle", "time": 6506.55, "timestamp": "01:48:26", "text": "彼もだ。えーと、2みたいな感じ、"}, {"type": "subtitle", "time": 6509.35, "timestamp": "01:48:29", "text": "50/50ですが、それは、"}, {"type": "subtitle", "time": 6512.47, "timestamp": "01:48:32", "text": "スポーンするためのハッチのようなもの。"}, {"type": "subtitle", "time": 6514.07, "timestamp": "01:48:34", "text": "だから、ハッチの件は全部見たと思うけど、"}, {"type": "subtitle", "time": 6515.83, "timestamp": "01:48:35", "text": "ハッチが出現する原因となる"}, {"type": "subtitle", "time": 6520.229, "timestamp": "01:48:40", "text": "えっと、何ですか？の"}, {"type": "subtitle", "time": 6522.229, "timestamp": "01:48:42", "text": "本館のことだと思います。私は思う"}, {"type": "subtitle", "time": 6526.39, "timestamp": "01:48:46", "text": "殺人小屋を想像してみて。だから、すべてのいいね"}, {"type": "subtitle", "time": 6529.35, "timestamp": "01:48:49", "text": "地図には通常2つのものがあります"}, {"type": "subtitle", "time": 6530.95, "timestamp": "01:48:50", "text": "これは主要な建物です。それはまるで"}, {"type": "subtitle", "time": 6533.43, "timestamp": "01:48:53", "text": "大きな建物と、その隣にある恐ろしい小屋"}, {"type": "subtitle", "time": 6535.03, "timestamp": "01:48:55", "text": "それは小さな建物のようなもので"}]
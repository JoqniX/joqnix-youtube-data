[{"type": "subtitle", "time": 4450.31, "timestamp": "01:14:10", "text": "ああ、彼らはまた、何ていうか、えーと"}, {"type": "subtitle", "time": 4452.07, "timestamp": "01:14:12", "text": "Call of Duty Battle Royaleが成し遂げたこと。それで、"}, {"type": "subtitle", "time": 4454.55, "timestamp": "01:14:14", "text": "私は銃を保管している。幸運なことに、私はただ"}, {"type": "subtitle", "time": 4466.87, "timestamp": "01:14:26", "text": "くそ。手榴弾を投げたのか？えっと、敵"}, {"type": "subtitle", "time": 4470.63, "timestamp": "01:14:30", "text": "シールドが破損しました。レベルアップしました"}, {"type": "subtitle", "time": 4473.11, "timestamp": "01:14:33", "text": "また。わかった。いいえ、大丈夫です。やられた。最後"}, {"type": "subtitle", "time": 4479.91, "timestamp": "01:14:39", "text": "おお、いいね。"}, {"type": "subtitle", "time": 4481.51, "timestamp": "01:14:41", "text": "彼は戦利品をすべて手に入れなければならなかった"}, {"type": "subtitle", "time": 4485.91, "timestamp": "01:14:45", "text": "戻る。それは少し残念ですね。甘い。"}, {"type": "subtitle", "time": 4487.669, "timestamp": "01:14:47", "text": "それは私にとっても癒しになります。待って、それは"}, {"type": "subtitle", "time": 4491.11, "timestamp": "01:14:51", "text": "良い。待って、私は何も知らない、私は何なのか全くわからなかった"}, {"type": "subtitle", "time": 4494.63, "timestamp": "01:14:54", "text": "コンジットならそれができる。"}, {"type": "subtitle", "time": 4496.55, "timestamp": "01:14:56", "text": "Conduitが最新版にアップグレードされました。聞く"}]
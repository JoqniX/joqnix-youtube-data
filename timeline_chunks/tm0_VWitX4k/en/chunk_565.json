[{"type": "subtitle", "time": 33912.95, "timestamp": "09:25:12", "text": "If there's anything you need,"}, {"type": "subtitle", "time": 33916.39, "timestamp": "09:25:16", "text": "if you need a hug, if you need a head,"}, {"type": "subtitle", "time": 33919.99, "timestamp": "09:25:19", "text": "if you need a chew in your forehead,"}, {"type": "subtitle", "time": 33923.746, "timestamp": "09:25:23", "text": "I'll be there to give you"}, {"type": "subtitle", "time": 33927.35, "timestamp": "09:25:27", "text": "to make you happy."}, {"type": "subtitle", "time": 33937.19, "timestamp": "09:25:37", "text": "don't be sad."}, {"type": "subtitle", "time": 33941.266, "timestamp": "09:25:41", "text": "Stay positive. Always"}, {"type": "subtitle", "time": 33943.35, "timestamp": "09:25:43", "text": "always always"}, {"type": "subtitle", "time": 33948.07, "timestamp": "09:25:48", "text": "look to the future and look up."}, {"type": "subtitle", "time": 33957.11, "timestamp": "09:25:57", "text": "If you go up, I'll punk you and kill you"}]
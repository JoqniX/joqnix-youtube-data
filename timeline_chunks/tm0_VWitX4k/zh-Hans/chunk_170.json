[{"type": "subtitle", "time": 10202.309, "timestamp": "02:50:02", "text": "如同创造者一般的宝可梦之神"}, {"type": "subtitle", "time": 10210.07, "timestamp": "02:50:10", "text": "哇。"}, {"type": "subtitle", "time": 10214.23, "timestamp": "02:50:14", "text": "那么是什么启发了你呢？"}, {"type": "subtitle", "time": 10222.79, "timestamp": "02:50:22", "text": "我只是想建立一个社区。"}, {"type": "subtitle", "time": 10225.67, "timestamp": "02:50:25", "text": "我可以在那里玩得很开心。"}, {"type": "subtitle", "time": 10227.269, "timestamp": "02:50:27", "text": "就这样。"}, {"type": "subtitle", "time": 10229.03, "timestamp": "02:50:29", "text": "哦，我只想玩得开心，做点什么。"}, {"type": "subtitle", "time": 10230.25, "timestamp": "02:50:30", "text": "朋友们。"}, {"type": "subtitle", "time": 10232.23, "timestamp": "02:50:32", "text": "[音乐]"}, {"type": "subtitle", "time": 10247.59, "timestamp": "02:50:47", "text": "所以，嗯，在山治一次之后，嗯"}, {"type": "subtitle", "time": 10251.19, "timestamp": "02:50:51", "text": "呃，你当时还参与其中吗？"}, {"type": "subtitle", "time": 10253.429, "timestamp": "02:50:53", "text": "比如看YouTube博主之类的？不。"}, {"type": "subtitle", "time": 10256.07, "timestamp": "02:50:56", "text": "它就像消失了一样。我对此不感兴趣。"}, {"type": "subtitle", "time": 10259.429, "timestamp": "02:50:59", "text": "直到我第一次见到你……"}]
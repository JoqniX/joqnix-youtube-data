[{"type": "subtitle", "time": 6600.47, "timestamp": "01:50:00", "text": "跑到最近的窗户那里。"}, {"type": "subtitle", "time": 6602.95, "timestamp": "01:50:02", "text": "还有一些其他的东西。通常有更大的机会"}, {"type": "subtitle", "time": 6611.03, "timestamp": "01:50:11", "text": "杀手往往会感到无聊。"}, {"type": "subtitle", "time": 6613.59, "timestamp": "01:50:13", "text": "他们好像停止追逐了。"}, {"type": "subtitle", "time": 6616.149, "timestamp": "01:50:16", "text": "过了一会儿。"}, {"type": "subtitle", "time": 6625.03, "timestamp": "01:50:25", "text": "为什么我感觉自己像个点击杀手？"}, {"type": "subtitle", "time": 6628.39, "timestamp": "01:50:28", "text": "难受又痛苦吗？"}, {"type": "subtitle", "time": 6630.47, "timestamp": "01:50:30", "text": "哦，嗯，​​我个人觉得我已经"}, {"type": "subtitle", "time": 6632.07, "timestamp": "01:50:32", "text": "我玩的是屠夫，我觉得我通常"}, {"type": "subtitle", "time": 6634.39, "timestamp": "01:50:34", "text": "玩一款相当不错的简单游戏"}, {"type": "subtitle", "time": 6636.229, "timestamp": "01:50:36", "text": "杀手。我觉得《幸存者》有点"}, {"type": "subtitle", "time": 6652.149, "timestamp": "01:50:52", "text": "这些人正在修复"}, {"type": "subtitle", "time": 6654.87, "timestamp": "01:50:54", "text": "定影。我上瘾了，但我偷偷摸摸地上去的。"}, {"type": "subtitle", "time": 6656.47, "timestamp": "01:50:56", "text": "我当时就在那儿。我完全忘了那个鬼魂"}, {"type": "subtitle", "time": 6659.109, "timestamp": "01:50:59", "text": "就像一张隐形的脸。"}]
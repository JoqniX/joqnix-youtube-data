[{"type": "subtitle", "time": 7681.91, "timestamp": "02:08:01", "text": "有点太挑剔了，但是"}, {"type": "subtitle", "time": 7686.31, "timestamp": "02:08:06", "text": "我想，就它运作的方式而言，就是这样吧。"}, {"type": "subtitle", "time": 7688.79, "timestamp": "02:08:08", "text": "是的，"}, {"type": "subtitle", "time": 7692.069, "timestamp": "02:08:12", "text": "它不起作用。但是，呃，我们正在尝试我们的"}, {"type": "subtitle", "time": 7696.069, "timestamp": "02:08:16", "text": "最好，你可以这么说。所以……"}, {"type": "subtitle", "time": 7699.669, "timestamp": "02:08:19", "text": "我为什么要那样做？"}, {"type": "subtitle", "time": 7705.669, "timestamp": "02:08:25", "text": "我可以去取吗？我无法知道。哦"}, {"type": "subtitle", "time": 7709.669, "timestamp": "02:08:29", "text": "你们听到了吗？我情绪低落。让我"}, {"type": "subtitle", "time": 7714.229, "timestamp": "02:08:34", "text": "去掉“所以今天的直播内容是关于我们的”。"}, {"type": "subtitle", "time": 7719.109, "timestamp": "02:08:39", "text": "呃，在做事情，对吧？呃，我们将会是"}, {"type": "subtitle", "time": 7731.75, "timestamp": "02:08:51", "text": "东西，对吧？糟糕，不。呃，我真的吗？"}, {"type": "subtitle", "time": 7733.83, "timestamp": "02:08:53", "text": "需要这样做吗？"}, {"type": "subtitle", "time": 7739.27, "timestamp": "02:08:59", "text": "嗯，好吧，行。这是哪里来着？"}]
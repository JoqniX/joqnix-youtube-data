[{"type": "subtitle", "time": 15974.71, "timestamp": "04:26:14", "text": "好的，我能明白“激光是怎么回事？”"}, {"type": "subtitle", "time": 16002.469, "timestamp": "04:26:42", "text": "好的，我要……"}, {"type": "subtitle", "time": 16007.83, "timestamp": "04:26:47", "text": "兄弟，我的无人机。哦，我的天，我想……"}, {"type": "subtitle", "time": 16011.83, "timestamp": "04:26:51", "text": "事物。是的。大部分都在哪里？"}, {"type": "subtitle", "time": 16015.59, "timestamp": "04:26:55", "text": "哦，我的天哪，你得到了所有的"}, {"type": "subtitle", "time": 16018.229, "timestamp": "04:26:58", "text": "拿着激光枪的家伙好像在说：继续前进"}]
[{"type": "subtitle", "time": 9720.15, "timestamp": "02:42:00", "text": "仍然需要"}, {"type": "subtitle", "time": 9723.429, "timestamp": "02:42:03", "text": "我还要做那件事。"}, {"type": "subtitle", "time": 9726.07, "timestamp": "02:42:06", "text": "所以我就想，是啊，我得付钱给他们。"}, {"type": "subtitle", "time": 9728.79, "timestamp": "02:42:08", "text": "这是最后一个月了。就像"}, {"type": "subtitle", "time": 9730.309, "timestamp": "02:42:10", "text": "分期付款。"}, {"type": "subtitle", "time": 9734.63, "timestamp": "02:42:14", "text": "而且价格也很贵。比如 65,000。"}, {"type": "subtitle", "time": 9737.75, "timestamp": "02:42:17", "text": "我的天哪，这也太贵了吧。"}, {"type": "subtitle", "time": 9740.389, "timestamp": "02:42:20", "text": "是的。我苦苦哀求，终于得到了4分。"}, {"type": "subtitle", "time": 9743.19, "timestamp": "02:42:23", "text": "按月分期付款。所以我不得不付钱给他。"}, {"type": "subtitle", "time": 9746.15, "timestamp": "02:42:26", "text": "比如 16.4K"}, {"type": "subtitle", "time": 9750.71, "timestamp": "02:42:30", "text": "每月一次。大约在三月份或"}, {"type": "subtitle", "time": 9752.87, "timestamp": "02:42:32", "text": "某事，我开始 我开始 我开始"}, {"type": "subtitle", "time": 9756.63, "timestamp": "02:42:36", "text": "停下来，我开始……是的。前"}, {"type": "subtitle", "time": 9760.07, "timestamp": "02:42:40", "text": "我开始不明白了"}, {"type": "subtitle", "time": 9762.71, "timestamp": "02:42:42", "text": "呃，我靠这些收入赚的钱"}, {"type": "subtitle", "time": 9765.67, "timestamp": "02:42:45", "text": "我确实喜欢技术支持之类的东西，"}, {"type": "subtitle", "time": 9767.91, "timestamp": "02:42:47", "text": "一切。所以我没拿到钱。"}, {"type": "subtitle", "time": 9770.07, "timestamp": "02:42:50", "text": "钱够了，因为没人要。"}, {"type": "subtitle", "time": 9773.67, "timestamp": "02:42:53", "text": "我和一切。所以我就想，哦不"}, {"type": "subtitle", "time": 9777.11, "timestamp": "02:42:57", "text": "我该怎么办？我苦苦哀求。"}, {"type": "subtitle", "time": 9779.429, "timestamp": "02:42:59", "text": "因为现在父母都反对他们。"}]
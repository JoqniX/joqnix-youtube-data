[{"type": "subtitle", "time": 780.47, "timestamp": "00:13:00", "text": "比如，你们好像骗了很多人。"}, {"type": "subtitle", "time": 782.47, "timestamp": "00:13:02", "text": "你认识的人中，有人有"}, {"type": "subtitle", "time": 786.069, "timestamp": "00:13:06", "text": "谁投入的呃的数量最多"}, {"type": "subtitle", "time": 788.069, "timestamp": "00:13:08", "text": "你的身体就像血肉之躯，你知道的。"}, {"type": "subtitle", "time": 790.31, "timestamp": "00:13:10", "text": "规模决定了生命，而另一个人则死了"}, {"type": "subtitle", "time": 794.629, "timestamp": "00:13:14", "text": "感觉就像那样，哦，"}, {"type": "subtitle", "time": 796.55, "timestamp": "00:13:16", "text": "超级血腥，真的超级血腥"}, {"type": "subtitle", "time": 798.629, "timestamp": "00:13:18", "text": "虽然血腥，但整体感觉就像……"}, {"type": "subtitle", "time": 800.15, "timestamp": "00:13:20", "text": "人们必须把真正困难的事情做好。"}, {"type": "subtitle", "time": 802.71, "timestamp": "00:13:22", "text": "他们更愿意选择的工作"}, {"type": "subtitle", "time": 805.59, "timestamp": "00:13:25", "text": "一起或像你一样失去生命。"}, {"type": "subtitle", "time": 807.03, "timestamp": "00:13:27", "text": "我觉得我很快就要花钱了。"}, {"type": "subtitle", "time": 810.79, "timestamp": "00:13:30", "text": "当我打开包装时。"}, {"type": "subtitle", "time": 812.389, "timestamp": "00:13:32", "text": "哦，你启动了游戏。好的，等等。让"}, {"type": "subtitle", "time": 816.629, "timestamp": "00:13:36", "text": "让我启动游戏。还没有"}, {"type": "subtitle", "time": 827.03, "timestamp": "00:13:47", "text": "等等，你在Apex里花了多少钱？"}, {"type": "subtitle", "time": 831.269, "timestamp": "00:13:51", "text": "Apex 上的游戏？哦好的。你有过吗？"}, {"type": "subtitle", "time": 833.67, "timestamp": "00:13:53", "text": "头发之类的？"}, {"type": "subtitle", "time": 835.67, "timestamp": "00:13:55", "text": "我确实有一件传家宝。我有"}, {"type": "subtitle", "time": 838.31, "timestamp": "00:13:58", "text": "沃森的传家宝。我是个十足的沃森迷。大的"}]
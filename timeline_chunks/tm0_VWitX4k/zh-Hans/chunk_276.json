[{"type": "subtitle", "time": 16572.15, "timestamp": "04:36:12", "text": "他为什么要瞄准那里？"}, {"type": "subtitle", "time": 16581.429, "timestamp": "04:36:21", "text": "我喜欢我杀了你。但它就这么掉了下去。"}, {"type": "subtitle", "time": 16583.109, "timestamp": "04:36:23", "text": "它没有环。那就是"}, {"type": "subtitle", "time": 16585.99, "timestamp": "04:36:25", "text": "事物。对，直接打开就行了。"}, {"type": "subtitle", "time": 16587.75, "timestamp": "04:36:27", "text": "实际上，"}, {"type": "subtitle", "time": 16589.269, "timestamp": "04:36:29", "text": "你现在做的就是这个。我没有"}, {"type": "subtitle", "time": 16591.189, "timestamp": "04:36:31", "text": "知道。"}, {"type": "subtitle", "time": 16607.75, "timestamp": "04:36:47", "text": "他就这样死在我面前了。等等，你"}]
[{"type": "subtitle", "time": 14538.79, "timestamp": "04:02:18", "text": "我现在要玩狙击枪了。它是怎么做到的？"}, {"type": "subtitle", "time": 14542.309, "timestamp": "04:02:22", "text": "改变？哦，核弹。"}, {"type": "subtitle", "time": 14543.99, "timestamp": "04:02:23", "text": "你如何改变？我刚去了菜单。"}, {"type": "subtitle", "time": 14546.15, "timestamp": "04:02:26", "text": "我死后。"}, {"type": "subtitle", "time": 14549.51, "timestamp": "04:02:29", "text": "你是不是返回了菜单之类的？"}, {"type": "subtitle", "time": 14551.11, "timestamp": "04:02:31", "text": "是的，死后会有一份菜单。"}]
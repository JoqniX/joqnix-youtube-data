[{"type": "subtitle", "time": 6735.35, "timestamp": "01:52:15", "text": "发电机需要很长时间才能启动。"}, {"type": "subtitle", "time": 6744.87, "timestamp": "01:52:24", "text": "是的，宝石通常都是如此。通常人们"}, {"type": "subtitle", "time": 6747.189, "timestamp": "01:52:27", "text": "就像两个男人的宝石。"}, {"type": "subtitle", "time": 6749.91, "timestamp": "01:52:29", "text": "难道没有办法进行修复吗？"}, {"type": "subtitle", "time": 6752.07, "timestamp": "01:52:32", "text": "快点？"}, {"type": "subtitle", "time": 6753.51, "timestamp": "01:52:33", "text": "嗯，有的。有一些"}, {"type": "subtitle", "time": 6769.03, "timestamp": "01:52:49", "text": "你快要死了，对吗？"}, {"type": "subtitle", "time": 6771.189, "timestamp": "01:52:51", "text": "是的。所以，他有点儿缠着我，我"}, {"type": "subtitle", "time": 6776.149, "timestamp": "01:52:56", "text": "思考。我的天啊。他就像是，"}]
[{"type": "subtitle", "time": 6120.79, "timestamp": "01:42:00", "text": "扮演Rez。所以你可以拥有你可以"}, {"type": "subtitle", "time": 6122.31, "timestamp": "01:42:02", "text": "你可以拥有食尸鬼，然后你"}, {"type": "subtitle", "time": 6125.03, "timestamp": "01:42:05", "text": "我可以让她重新拥有我的皮肤"}, {"type": "subtitle", "time": 6129.109, "timestamp": "01:42:09", "text": "因为那家伙制造了食尸鬼。嗯，有"}, {"type": "subtitle", "time": 6132.79, "timestamp": "01:42:12", "text": "他们有呃 enreo 或"}, {"type": "subtitle", "time": 6134.47, "timestamp": "01:42:14", "text": "擂台上的小鸡。你认识那个妞儿"}, {"type": "subtitle", "time": 6136.629, "timestamp": "01:42:16", "text": "就是那个从电视机里爬出来的家伙什么的。"}, {"type": "subtitle", "time": 6138.55, "timestamp": "01:42:18", "text": "是的。"}, {"type": "subtitle", "time": 6142.07, "timestamp": "01:42:22", "text": "有一个名叫巫妖的杀手。她是"}, {"type": "subtitle", "time": 6144.87, "timestamp": "01:42:24", "text": "来自 DBD。呃，我们还有"}, {"type": "subtitle", "time": 6147.75, "timestamp": "01:42:27", "text": "异形。我们抓到恰奇了。"}, {"type": "subtitle", "time": 6149.75, "timestamp": "01:42:29", "text": "嗯，我们有来自黑暗领主的"}, {"type": "subtitle", "time": 6151.51, "timestamp": "01:42:31", "text": "恶魔城。"}, {"type": "subtitle", "time": 6157.43, "timestamp": "01:42:37", "text": "我们抓到了幕后主使，或者说是亚当·威斯克"}, {"type": "subtitle", "time": 6160.47, "timestamp": "01:42:40", "text": "出自《生化危机》。我们从复仇女神那里得到了"}, {"type": "subtitle", "time": 6162.79, "timestamp": "01:42:42", "text": "生化危机。我们抓到了三角头。我们"}, {"type": "subtitle", "time": 6167.189, "timestamp": "01:42:47", "text": "长了鬼脸。我们抓到了魔王。"}, {"type": "subtitle", "time": 6169.99, "timestamp": "01:42:49", "text": "哇。这就像这简直就像"}, {"type": "subtitle", "time": 6172.07, "timestamp": "01:42:52", "text": "它有点像恐怖版的《堡垒之夜》。"}, {"type": "subtitle", "time": 6174.87, "timestamp": "01:42:54", "text": "是的，确实如此。"}, {"type": "subtitle", "time": 6177.83, "timestamp": "01:42:57", "text": "因为就像所有的一切，是的，他们"}, {"type": "subtitle", "time": 6179.43, "timestamp": "01:42:59", "text": "就像皮肤一样。所以就有了《猎魔人》。"}]
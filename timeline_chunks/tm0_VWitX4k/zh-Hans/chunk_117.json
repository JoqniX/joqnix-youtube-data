[{"type": "subtitle", "time": 7021.27, "timestamp": "01:57:01", "text": "它以我们为食。"}, {"type": "subtitle", "time": 7051.589, "timestamp": "01:57:31", "text": "每日首场生存赛。升级"}, {"type": "subtitle", "time": 7057.51, "timestamp": "01:57:37", "text": "虹膜。"}, {"type": "subtitle", "time": 7067.589, "timestamp": "01:57:47", "text": "好的。我可以旁观。让我看看。"}, {"type": "subtitle", "time": 7070.55, "timestamp": "01:57:50", "text": "你在哪里？"}, {"type": "subtitle", "time": 7075.35, "timestamp": "01:57:55", "text": "我是。哦，我坐在旁边。"}, {"type": "subtitle", "time": 7078.95, "timestamp": "01:57:58", "text": "你以前就具备这些能力吗？"}]
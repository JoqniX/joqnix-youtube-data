[{"type": "subtitle", "time": 13389.99, "timestamp": "03:43:09", "text": "我到场了吗？"}, {"type": "subtitle", "time": 13416.389, "timestamp": "03:43:36", "text": "仍然承受着不该承受的一切"}, {"type": "subtitle", "time": 13418.229, "timestamp": "03:43:38", "text": "那。"}, {"type": "subtitle", "time": 13421.189, "timestamp": "03:43:41", "text": "所以我也很困惑。"}, {"type": "subtitle", "time": 13425.349, "timestamp": "03:43:45", "text": "这花费的时间太长了。"}, {"type": "subtitle", "time": 13428.63, "timestamp": "03:43:48", "text": "你为什么在做饭？"}, {"type": "subtitle", "time": 13431.75, "timestamp": "03:43:51", "text": "没有。它还在那里。它确实如此"}, {"type": "subtitle", "time": 13437.67, "timestamp": "03:43:57", "text": "什么？"}]
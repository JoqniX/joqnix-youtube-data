[{"type": "subtitle", "time": 11641.11, "timestamp": "03:14:01", "text": "消息。啊"}, {"type": "subtitle", "time": 11650.15, "timestamp": "03:14:10", "text": "该死"}, {"type": "subtitle", "time": 11655.429, "timestamp": "03:14:15", "text": "我。"}, {"type": "subtitle", "time": 11658.63, "timestamp": "03:14:18", "text": "我懂了。"}, {"type": "subtitle", "time": 11660.63, "timestamp": "03:14:20", "text": "我的意思是，他们有点儿建立起这些。"}, {"type": "subtitle", "time": 11663.269, "timestamp": "03:14:23", "text": "事物。我不知道。"}, {"type": "subtitle", "time": 11681.11, "timestamp": "03:14:41", "text": "发生的事情太多了。"}, {"type": "subtitle", "time": 11684.309, "timestamp": "03:14:44", "text": "我们对此却一无所知。"}, {"type": "subtitle", "time": 11687.429, "timestamp": "03:14:47", "text": "是的。呃"}, {"type": "subtitle", "time": 11691.11, "timestamp": "03:14:51", "text": "虽然我意识到这一点，呃，一夜之间"}, {"type": "subtitle", "time": 11694.07, "timestamp": "03:14:54", "text": "是的，你说"}, {"type": "subtitle", "time": 11695.99, "timestamp": "03:14:55", "text": "它一夜之间就发生了，你却毫不知情。"}, {"type": "subtitle", "time": 11699.11, "timestamp": "03:14:59", "text": "甚至直到你打开推特才会知道。"}]
[{"type": "subtitle", "time": 543.67, "timestamp": "00:09:03", "text": "我的Everoft账号被盗了。"}, {"type": "subtitle", "time": 546.79, "timestamp": "00:09:06", "text": "某个黑客入侵了《彩虹六号》游戏。"}, {"type": "subtitle", "time": 550.07, "timestamp": "00:09:10", "text": "攻城战，赢了大概100场，"}, {"type": "subtitle", "time": 553.03, "timestamp": "00:09:13", "text": "我的账号被封了，我当时就想，"}, {"type": "subtitle", "time": 555.75, "timestamp": "00:09:15", "text": "“哇。”"}, {"type": "subtitle", "time": 560.389, "timestamp": "00:09:20", "text": "好吧，至少现在是免费的。是的。"}, {"type": "subtitle", "time": 564.31, "timestamp": "00:09:24", "text": "它终于免费了。"}, {"type": "subtitle", "time": 567.269, "timestamp": "00:09:27", "text": "我还没试过呢。嗯，有"}, {"type": "subtitle", "time": 571.11, "timestamp": "00:09:31", "text": "你试过了？你试玩过吗？"}, {"type": "subtitle", "time": 574.79, "timestamp": "00:09:34", "text": "玩了什么？呃，围攻。围城。围城。"}, {"type": "subtitle", "time": 578.79, "timestamp": "00:09:38", "text": "哦，那是我的 f 我 我已经伸手去拿了"}, {"type": "subtitle", "time": 581.91, "timestamp": "00:09:41", "text": "围城。我当时就像冠军一样，三个"}, {"type": "subtitle", "time": 585.03, "timestamp": "00:09:45", "text": "连续几个赛季。我钻石之前"}, {"type": "subtitle", "time": 586.949, "timestamp": "00:09:46", "text": "冠军诞生了。我玩我大约"}, {"type": "subtitle", "time": 590.15, "timestamp": "00:09:50", "text": "大概玩了800个小时。我玩过它"}, {"type": "subtitle", "time": 592.389, "timestamp": "00:09:52", "text": "就像我高中时经常发生的那样，"}, {"type": "subtitle", "time": 594.389, "timestamp": "00:09:54", "text": "但我后来就没怎么玩了。"}, {"type": "subtitle", "time": 596.87, "timestamp": "00:09:56", "text": "我找到了《Valerant》，现在我玩得超级烂。"}, {"type": "subtitle", "time": 598.26, "timestamp": "00:09:58", "text": "它。"}, {"type": "subtitle", "time": 599.829, "timestamp": "00:09:59", "text": "[音乐]"}]
[{"type": "subtitle", "time": 17941.91, "timestamp": "04:59:01", "text": "就像游戏开始了一样。等等，什么？"}, {"type": "subtitle", "time": 17944.868, "timestamp": "04:59:04", "text": "只有漫威能与之匹敌，就像射击游戏一样。"}, {"type": "subtitle", "time": 17946.39, "timestamp": "04:59:06", "text": "射击。哦，射杀他。等等，这是什么？"}, {"type": "subtitle", "time": 17948.788, "timestamp": "04:59:08", "text": "那个"}, {"type": "subtitle", "time": 17950.39, "timestamp": "04:59:10", "text": "事物？"}, {"type": "subtitle", "time": 17955.43, "timestamp": "04:59:15", "text": "啊，"}, {"type": "subtitle", "time": 17959.83, "timestamp": "04:59:19", "text": "等待。你离开了吗？不，我在这里。好的，"}, {"type": "subtitle", "time": 17962.55, "timestamp": "04:59:22", "text": "我们可以玩。是的，我们什么游戏都能玩。"}, {"type": "subtitle", "time": 17966.15, "timestamp": "04:59:26", "text": "是的，这是"}, {"type": "subtitle", "time": 17969.43, "timestamp": "04:59:29", "text": "我们可以在直播中创建一个房间。"}, {"type": "subtitle", "time": 17972.868, "timestamp": "04:59:32", "text": "好的，我把它打开。"}, {"type": "subtitle", "time": 17976.39, "timestamp": "04:59:36", "text": "我的天啊，"}]
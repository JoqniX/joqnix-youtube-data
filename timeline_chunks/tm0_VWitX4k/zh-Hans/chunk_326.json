[{"type": "subtitle", "time": 19579.03, "timestamp": "05:26:19", "text": "等等，你在哪里？"}, {"type": "subtitle", "time": 19583.36, "timestamp": "05:26:23", "text": "公共服务器。你可以加入我。我该怎么做？"}, {"type": "subtitle", "time": 19584.628, "timestamp": "05:26:24", "text": "[音乐]"}, {"type": "subtitle", "time": 19586.948, "timestamp": "05:26:26", "text": "只需点击经纪商并加入即可。"}, {"type": "subtitle", "time": 19588.29, "timestamp": "05:26:28", "text": "事物？"}, {"type": "subtitle", "time": 19591.43, "timestamp": "05:26:31", "text": "[音乐]"}, {"type": "subtitle", "time": 19594.15, "timestamp": "05:26:34", "text": "我没看见。哦，等等。我必须离开了"}, {"type": "subtitle", "time": 19611.03, "timestamp": "05:26:51", "text": "[音乐]"}, {"type": "subtitle", "time": 19613.11, "timestamp": "05:26:53", "text": "他们今天早上甚至还开始粉刷墙壁了。"}, {"type": "subtitle", "time": 19619.59, "timestamp": "05:26:59", "text": "你在这里？"}]
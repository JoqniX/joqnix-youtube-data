[{"type": "subtitle", "time": 4761.59, "timestamp": "01:19:21", "text": "那是什么盾牌？"}, {"type": "subtitle", "time": 4764.63, "timestamp": "01:19:24", "text": "这就是生命线的终极技能。正在充电。"}, {"type": "subtitle", "time": 4767.43, "timestamp": "01:19:27", "text": "Lifeline 的备选方案是什么？所以，就是这样。"}, {"type": "subtitle", "time": 4770.63, "timestamp": "01:19:30", "text": "不再提供生命线包，但现在是……"}, {"type": "subtitle", "time": 4773.11, "timestamp": "01:19:33", "text": "巨型盾牌。"}, {"type": "subtitle", "time": 4789.11, "timestamp": "01:19:49", "text": "因为周围有很多尸体。"}, {"type": "subtitle", "time": 4791.27, "timestamp": "01:19:51", "text": "我们。到这棵大树后面来。"}, {"type": "subtitle", "time": 4793.43, "timestamp": "01:19:53", "text": "我完蛋了。"}]
[{"type": "subtitle", "time": 16029.429, "timestamp": "04:27:09", "text": "兄弟，"}, {"type": "subtitle", "time": 16034.63, "timestamp": "04:27:14", "text": "我将投下一颗威力巨大的炸弹。核武器？什么？"}, {"type": "subtitle", "time": 16055.349, "timestamp": "04:27:35", "text": "我的哨兵。我的哨兵着火了。"}, {"type": "subtitle", "time": 16058.229, "timestamp": "04:27:38", "text": "什么？"}, {"type": "subtitle", "time": 16062.63, "timestamp": "04:27:42", "text": "哦，不可能。"}, {"type": "subtitle", "time": 16065.75, "timestamp": "04:27:45", "text": "我之前杀过一个人。我的天啊。好的。哦"}, {"type": "subtitle", "time": 16069.51, "timestamp": "04:27:49", "text": "我的上帝。你用那招杀了好多人。"}, {"type": "subtitle", "time": 16076.79, "timestamp": "04:27:56", "text": "哦，又来了。兄弟，我需要15个人头。"}]
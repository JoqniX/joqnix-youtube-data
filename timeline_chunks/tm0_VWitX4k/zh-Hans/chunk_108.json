[{"type": "subtitle", "time": 6490.55, "timestamp": "01:48:10", "text": "妈妈你好。谢谢你的好意"}, {"type": "subtitle", "time": 6497.109, "timestamp": "01:48:17", "text": "哦，这是什么供品？"}, {"type": "subtitle", "time": 6500.39, "timestamp": "01:48:20", "text": "所以，游戏中是有各种奖励的。呃，我"}, {"type": "subtitle", "time": 6502.709, "timestamp": "01:48:22", "text": "我还添加了一项供品，该供品将"}, {"type": "subtitle", "time": 6504.39, "timestamp": "01:48:24", "text": "请稍微减轻我们的负担，但是"}, {"type": "subtitle", "time": 6506.55, "timestamp": "01:48:26", "text": "还有他。呃，就像二，就像"}, {"type": "subtitle", "time": 6509.35, "timestamp": "01:48:29", "text": "五五开，但这会导致呃……"}, {"type": "subtitle", "time": 6512.47, "timestamp": "01:48:32", "text": "某种孵化方式以产卵。"}, {"type": "subtitle", "time": 6514.07, "timestamp": "01:48:34", "text": "所以，就像你们看到的整个舱门开启过程一样，"}, {"type": "subtitle", "time": 6515.83, "timestamp": "01:48:35", "text": "它们会导致孵化场生成。"}, {"type": "subtitle", "time": 6520.229, "timestamp": "01:48:40", "text": "呃呃，那是什么？这"}, {"type": "subtitle", "time": 6522.229, "timestamp": "01:48:42", "text": "我认为是主楼。我觉得我"}, {"type": "subtitle", "time": 6526.39, "timestamp": "01:48:46", "text": "想想那个杀手小屋。所以每个人都喜欢"}, {"type": "subtitle", "time": 6529.35, "timestamp": "01:48:49", "text": "地图通常包含两样东西。"}, {"type": "subtitle", "time": 6530.95, "timestamp": "01:48:50", "text": "这是一栋主楼。就像这样"}, {"type": "subtitle", "time": 6533.43, "timestamp": "01:48:53", "text": "一栋大楼，然后是一间杀人小屋"}, {"type": "subtitle", "time": 6535.03, "timestamp": "01:48:55", "text": "就像旁边一栋较小的建筑物"}]
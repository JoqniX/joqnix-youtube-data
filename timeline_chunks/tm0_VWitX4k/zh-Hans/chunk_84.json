[{"type": "subtitle", "time": 5051.51, "timestamp": "01:24:11", "text": "好的。好的。我有一位家庭成员"}, {"type": "subtitle", "time": 5059.27, "timestamp": "01:24:19", "text": "好的。"}, {"type": "subtitle", "time": 5063.59, "timestamp": "01:24:23", "text": "脉搏稳定。哦，别这样。"}, {"type": "subtitle", "time": 5066.629, "timestamp": "01:24:26", "text": "椅子。所以，这就是那种"}, {"type": "subtitle", "time": 5071.83, "timestamp": "01:24:31", "text": "我觉得我们正走在类似的道路上。啊，"}, {"type": "subtitle", "time": 5073.669, "timestamp": "01:24:33", "text": "然后我们在《五人组》中看到了弹簧陷阱。"}]
[{"type": "subtitle", "time": 4500.149, "timestamp": "01:15:00", "text": "我的播客里有详细介绍。"}, {"type": "subtitle", "time": 4515.83, "timestamp": "01:15:15", "text": "我需要重新研究一下能量方面的问题。"}, {"type": "subtitle", "time": 4518.149, "timestamp": "01:15:18", "text": "和"}, {"type": "subtitle", "time": 4524.39, "timestamp": "01:15:24", "text": "他们根本不是你的好对手。"}, {"type": "subtitle", "time": 4527.59, "timestamp": "01:15:27", "text": "好了。"}, {"type": "subtitle", "time": 4535.51, "timestamp": "01:15:35", "text": "哦，有光了。"}, {"type": "subtitle", "time": 4539.189, "timestamp": "01:15:39", "text": "有光。什么？有一道光"}, {"type": "subtitle", "time": 4541.189, "timestamp": "01:15:41", "text": "在那边。"}, {"type": "subtitle", "time": 4543.75, "timestamp": "01:15:43", "text": "哦，我完全忘了。我的门槛很低，而且"}, {"type": "subtitle", "time": 4545.43, "timestamp": "01:15:45", "text": "透过它可以看到类似紫色的东西"}, {"type": "subtitle", "time": 4551.51, "timestamp": "01:15:51", "text": "耶稣，我当时没意识到为什么会这样"}]
[{"type": "subtitle", "time": 6360.709, "timestamp": "01:46:00", "text": "仿佛是很久以前的事了，2016年8月17日。"}, {"type": "subtitle", "time": 6363.43, "timestamp": "01:46:03", "text": "嗯，是的，他们彻底重置了一切。"}, {"type": "subtitle", "time": 6366.31, "timestamp": "01:46:06", "text": "想想那些休眠账户，比如"}, {"type": "subtitle", "time": 6373.51, "timestamp": "01:46:13", "text": "是的。哦，好了。两周前，"}, {"type": "subtitle", "time": 6377.51, "timestamp": "01:46:17", "text": "他们宣布了他们的《刺客信条》"}, {"type": "subtitle", "time": 6381.109, "timestamp": "01:46:21", "text": "呃，影子乐队的合作。"}, {"type": "subtitle", "time": 6383.669, "timestamp": "01:46:23", "text": "哦，"}, {"type": "subtitle", "time": 6391.03, "timestamp": "01:46:31", "text": "塞尼诺咬痕或针头"}, {"type": "subtitle", "time": 6392.55, "timestamp": "01:46:32", "text": "猛鬼追魂，"}, {"type": "subtitle", "time": 6396.229, "timestamp": "01:46:36", "text": "但他们输了"}, {"type": "subtitle", "time": 6398.47, "timestamp": "01:46:38", "text": "他们失去了执照。所以，他们确实如此。"}, {"type": "subtitle", "time": 6400.31, "timestamp": "01:46:40", "text": "必须为所有许可之类的东西付费"}, {"type": "subtitle", "time": 6402.229, "timestamp": "01:46:42", "text": "这些。"}, {"type": "subtitle", "time": 6404.709, "timestamp": "01:46:44", "text": "哦。呃，他们失去了许可证。所以，"}, {"type": "subtitle", "time": 6406.629, "timestamp": "01:46:46", "text": "因为他们失去了许可证，所以"}, {"type": "subtitle", "time": 6409.27, "timestamp": "01:46:49", "text": "不得不像他一直以来那样对待他"}, {"type": "subtitle", "time": 6412.95, "timestamp": "01:46:52", "text": "算是退休了。所以，你买不到他。"}, {"type": "subtitle", "time": 6414.47, "timestamp": "01:46:54", "text": "你无法解锁他，也无法获得他。"}, {"type": "subtitle", "time": 6416.87, "timestamp": "01:46:56", "text": "他的任何特权。呃，真糟糕。"}, {"type": "subtitle", "time": 6418.39, "timestamp": "01:46:58", "text": "因为他享有最好的福利"}]
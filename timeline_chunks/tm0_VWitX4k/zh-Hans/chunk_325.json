[{"type": "subtitle", "time": 19522.55, "timestamp": "05:25:22", "text": "我添加了"}, {"type": "subtitle", "time": 19525.67, "timestamp": "05:25:25", "text": "它没有收到好友请求。等待，"}, {"type": "subtitle", "time": 19528.628, "timestamp": "05:25:28", "text": "你在游戏里的名字是什么？哦，等等。患病的"}, {"type": "subtitle", "time": 19530.868, "timestamp": "05:25:30", "text": "把他加进去。"}, {"type": "subtitle", "time": 19536.07, "timestamp": "05:25:36", "text": "但他确实说过“我做了”。国王。哦，"}, {"type": "subtitle", "time": 19544.708, "timestamp": "05:25:44", "text": "这是什么？种个菜园。这是什么？"}]
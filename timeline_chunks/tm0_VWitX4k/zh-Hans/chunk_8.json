[{"type": "subtitle", "time": 480.07, "timestamp": "00:08:00", "text": "流媒体之类的。我一直"}, {"type": "subtitle", "time": 484.07, "timestamp": "00:08:04", "text": "但我直播技术很差。"}, {"type": "subtitle", "time": 487.189, "timestamp": "00:08:07", "text": "安排日程。所以，我觉得我挺善良的。"}, {"type": "subtitle", "time": 488.79, "timestamp": "00:08:08", "text": "我大概每隔一段时间就会直播一次"}, {"type": "subtitle", "time": 490.629, "timestamp": "00:08:10", "text": "每三周一次到"}, {"type": "subtitle", "time": 493.99, "timestamp": "00:08:13", "text": "想做的时候就做。我做了"}, {"type": "subtitle", "time": 497.589, "timestamp": "00:08:17", "text": "在 Sushi 或 Renee uh a 上直播"}, {"type": "subtitle", "time": 499.83, "timestamp": "00:08:19", "text": "不久前。是的，那是很久以前的事了。"}, {"type": "subtitle", "time": 501.909, "timestamp": "00:08:21", "text": "我说，大概就是几天前的事吧。"}, {"type": "subtitle", "time": 504.39, "timestamp": "00:08:24", "text": "啊，不错。"}, {"type": "subtitle", "time": 506.469, "timestamp": "00:08:26", "text": "我们要玩《彩虹六号：围攻》，但是他们"}, {"type": "subtitle", "time": 508.23, "timestamp": "00:08:28", "text": "更新后，我们最后玩了游戏王。"}, {"type": "subtitle", "time": 510.55, "timestamp": "00:08:30", "text": "溪流。"}, {"type": "subtitle", "time": 513.029, "timestamp": "00:08:33", "text": "我还在下载《彩虹六号》。"}, {"type": "subtitle", "time": 515.909, "timestamp": "00:08:35", "text": "围攻 X。"}, {"type": "subtitle", "time": 519.11, "timestamp": "00:08:39", "text": "是的，下载的文件有点大。"}, {"type": "subtitle", "time": 526.07, "timestamp": "00:08:46", "text": "它太大了，我记得我买过。"}, {"type": "subtitle", "time": 529.59, "timestamp": "00:08:49", "text": "很久以前的围攻。我不知道。我不"}, {"type": "subtitle", "time": 531.99, "timestamp": "00:08:51", "text": "还记得是什么时候吗？就好像它曾经"}, {"type": "subtitle", "time": 534.07, "timestamp": "00:08:54", "text": "就像Epic Games上的优惠一样。所以当时"}, {"type": "subtitle", "time": 537.59, "timestamp": "00:08:57", "text": "就像，“好吧，我要去拿这个。”"}, {"type": "subtitle", "time": 539.67, "timestamp": "00:08:59", "text": "你知道，拿到它之后……"}]
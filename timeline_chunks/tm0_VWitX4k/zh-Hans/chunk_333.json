[{"type": "subtitle", "time": 19983.67, "timestamp": "05:33:03", "text": "什么？"}, {"type": "subtitle", "time": 19985.67, "timestamp": "05:33:05", "text": "我该怎么做？我打他们，但是"}, {"type": "subtitle", "time": 19987.99, "timestamp": "05:33:07", "text": "不会杀死它们。"}, {"type": "subtitle", "time": 19991.19, "timestamp": "05:33:11", "text": "这是我们的特色。"}, {"type": "subtitle", "time": 19995.03, "timestamp": "05:33:15", "text": "我们想要一些。哇。我不知道那是什么"}, {"type": "subtitle", "time": 20011.59, "timestamp": "05:33:31", "text": "好的。"}, {"type": "subtitle", "time": 20025.03, "timestamp": "05:33:45", "text": "我一个击杀都没拿到。你怎么这么厉害？我"}, {"type": "subtitle", "time": 20026.868, "timestamp": "05:33:46", "text": "我不知道。我不知道该怎么做"}, {"type": "subtitle", "time": 20029.03, "timestamp": "05:33:49", "text": "你正在做的。"}, {"type": "subtitle", "time": 20031.99, "timestamp": "05:33:51", "text": "我只是第三人称"}, {"type": "subtitle", "time": 20034.23, "timestamp": "05:33:54", "text": "玩游戏。"}]
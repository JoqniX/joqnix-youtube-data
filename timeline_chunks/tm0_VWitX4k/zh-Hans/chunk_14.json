[{"type": "subtitle", "time": 840.79, "timestamp": "00:14:00", "text": "沃森的粉丝。我几乎拥有所有华生系列产品。"}, {"type": "subtitle", "time": 845.11, "timestamp": "00:14:05", "text": "皮肤，传奇皮肤。呃"}, {"type": "subtitle", "time": 847.509, "timestamp": "00:14:07", "text": "是的。不，我只是……我只是个大"}, {"type": "subtitle", "time": 854.15, "timestamp": "00:14:14", "text": "总的来说，我花了很多钱"}, {"type": "subtitle", "time": 855.67, "timestamp": "00:14:15", "text": "游戏。我不是……我不是"}, {"type": "subtitle", "time": 857.35, "timestamp": "00:14:17", "text": "我为自己花在……上的钱感到尴尬"}, {"type": "subtitle", "time": 860.389, "timestamp": "00:14:20", "text": "游戏。我会实话实说。嗯，我觉得在……"}, {"type": "subtitle", "time": 862.069, "timestamp": "00:14:22", "text": "我几乎能说出所有游戏的名字。我花了"}, {"type": "subtitle", "time": 867.03, "timestamp": "00:14:27", "text": "在 Apex 上大概花了 900 多美元。"}, {"type": "subtitle", "time": 870.629, "timestamp": "00:14:30", "text": "神圣的澳大利亚人。就是这样。"}, {"type": "subtitle", "time": 875.43, "timestamp": "00:14:35", "text": "这是最低金额。这个数字太低了。"}, {"type": "subtitle", "time": 878.23, "timestamp": "00:14:38", "text": "那差不多是我需要支付的金额。"}, {"type": "subtitle", "time": 880.55, "timestamp": "00:14:40", "text": "用于我为新模型制作的绑定装置。哦，我的"}, {"type": "subtitle", "time": 882.55, "timestamp": "00:14:42", "text": "上帝。"}, {"type": "subtitle", "time": 884.949, "timestamp": "00:14:44", "text": "所以，说到这个模型，我是……"}, {"type": "subtitle", "time": 886.31, "timestamp": "00:14:46", "text": "偷工减料。我觉得我太抠门了"}, {"type": "subtitle", "time": 889.43, "timestamp": "00:14:49", "text": "我的模型有点儿。呃，我去布斯商学院了。"}, {"type": "subtitle", "time": 891.75, "timestamp": "00:14:51", "text": "有一个叫做 Booth 的网站。是的。"}, {"type": "subtitle", "time": 895.59, "timestamp": "00:14:55", "text": "展位。呃，我买了一大堆。"}, {"type": "subtitle", "time": 897.509, "timestamp": "00:14:57", "text": "呃，生产的模型。但我之所以这样想，是因为我"}]
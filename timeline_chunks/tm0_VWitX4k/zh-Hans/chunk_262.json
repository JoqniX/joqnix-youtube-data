[{"type": "subtitle", "time": 15720.469, "timestamp": "04:22:00", "text": "我该如何杀死它们？"}, {"type": "subtitle", "time": 15722.95, "timestamp": "04:22:02", "text": "啊，雅各布，你这只老鼠。我要来了"}, {"type": "subtitle", "time": 15732.79, "timestamp": "04:22:12", "text": "不，不，不，不，不，不，不，不。"}, {"type": "subtitle", "time": 15742.389, "timestamp": "04:22:22", "text": "啊，我的天哪，你太棒了。"}, {"type": "subtitle", "time": 15744.229, "timestamp": "04:22:24", "text": "不，我不好。你就是那个人"}, {"type": "subtitle", "time": 15746.95, "timestamp": "04:22:26", "text": "顶部。"}, {"type": "subtitle", "time": 15749.11, "timestamp": "04:22:29", "text": "这是什么枪？什么？未来步枪。"}, {"type": "subtitle", "time": 15751.51, "timestamp": "04:22:31", "text": "那是什么？"}, {"type": "subtitle", "time": 15754.07, "timestamp": "04:22:34", "text": "什么步枪？你就像一把激光枪"}, {"type": "subtitle", "time": 15756.469, "timestamp": "04:22:36", "text": "它出自《星球大战》之类的作品。白色"}, {"type": "subtitle", "time": 15759.269, "timestamp": "04:22:39", "text": "塔式步枪。哇。"}, {"type": "subtitle", "time": 15762.469, "timestamp": "04:22:42", "text": "就像未来的步枪。什么？"}, {"type": "subtitle", "time": 15764.55, "timestamp": "04:22:44", "text": "啊，从那边击球感觉如何？"}, {"type": "subtitle", "time": 15766.309, "timestamp": "04:22:46", "text": "什么？"}, {"type": "subtitle", "time": 15769.349, "timestamp": "04:22:49", "text": "这是痛苦和伤害。什么？什么是"}]
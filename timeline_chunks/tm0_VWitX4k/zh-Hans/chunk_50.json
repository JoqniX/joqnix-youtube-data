[{"type": "subtitle", "time": 3003.03, "timestamp": "00:50:03", "text": "但要对抗它，就会造成损害。它也仅"}, {"type": "subtitle", "time": 3006.63, "timestamp": "00:50:06", "text": "嗯，他有一定数量的弹药。所以我只"}, {"type": "subtitle", "time": 3011.43, "timestamp": "00:50:11", "text": "有25发子弹。啊"}, {"type": "subtitle", "time": 3015.19, "timestamp": "00:50:15", "text": "我们也得像现在这样离开。"}, {"type": "subtitle", "time": 3023.829, "timestamp": "00:50:23", "text": "10秒。戒指很近了。唯一"}, {"type": "subtitle", "time": 3026.069, "timestamp": "00:50:26", "text": "值得一提的傻瓜。更快，更快"}, {"type": "subtitle", "time": 3032.79, "timestamp": "00:50:32", "text": "与敌人交战。好的，有"}, {"type": "subtitle", "time": 3034.39, "timestamp": "00:50:34", "text": "走在我们前面的人，他们确实有"}, {"type": "subtitle", "time": 3038.79, "timestamp": "00:50:38", "text": "红色。你逃不掉的。"}, {"type": "subtitle", "time": 3041.19, "timestamp": "00:50:41", "text": "现在开始搬家。"}, {"type": "subtitle", "time": 3044.309, "timestamp": "00:50:44", "text": "物资正在运送途中。"}, {"type": "subtitle", "time": 3046.95, "timestamp": "00:50:46", "text": "好的，我们走这边。"}, {"type": "subtitle", "time": 3049.91, "timestamp": "00:50:49", "text": "呃，还有这边的这堵白墙，"}]
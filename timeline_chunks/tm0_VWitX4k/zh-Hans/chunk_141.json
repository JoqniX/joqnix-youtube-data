[{"type": "subtitle", "time": 8483.75, "timestamp": "02:21:23", "text": "显然，"}, {"type": "subtitle", "time": 8495.75, "timestamp": "02:21:35", "text": "这些我刚刚修好的石头，"}, {"type": "subtitle", "time": 8498.55, "timestamp": "02:21:38", "text": "只是“你好”的一部分。你可以吗"}, {"type": "subtitle", "time": 8501.11, "timestamp": "02:21:41", "text": "你们听见了吗？我们有把枪。移动的"}, {"type": "subtitle", "time": 8505.11, "timestamp": "02:21:45", "text": "病毒源自狗。"}, {"type": "subtitle", "time": 8507.75, "timestamp": "02:21:47", "text": "所以，没错，外面根本没下雨。"}, {"type": "subtitle", "time": 8513.27, "timestamp": "02:21:53", "text": "这里。我刚吃完晚饭。"}, {"type": "subtitle", "time": 8517.19, "timestamp": "02:21:57", "text": "是啊，那是什么？哦，它"}]
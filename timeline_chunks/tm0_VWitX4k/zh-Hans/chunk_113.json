[{"type": "subtitle", "time": 6781.589, "timestamp": "01:53:01", "text": "我该如何知道有多少个？"}, {"type": "subtitle", "time": 6784.47, "timestamp": "01:53:04", "text": "世代是固定的吗？"}, {"type": "subtitle", "time": 6787.03, "timestamp": "01:53:07", "text": "所以，在底部，你会看到"}, {"type": "subtitle", "time": 6789.43, "timestamp": "01:53:09", "text": "右下角。"}, {"type": "subtitle", "time": 6795.109, "timestamp": "01:53:15", "text": "糟糕，我死定了。糟糕。"}, {"type": "subtitle", "time": 6805.03, "timestamp": "01:53:25", "text": "我这就死了。我死了吗？嗯，我是。只是"}, {"type": "subtitle", "time": 6820.709, "timestamp": "01:53:40", "text": "他不知道我在哪里，因为我"}, {"type": "subtitle", "time": 6824.709, "timestamp": "01:53:44", "text": "在高高的草丛里。所以，我就像在玩游戏一样。"}, {"type": "subtitle", "time": 6832.31, "timestamp": "01:53:52", "text": "等等，他们有两代产品。"}, {"type": "subtitle", "time": 6837.91, "timestamp": "01:53:57", "text": "哦，它想杀了我。"}]
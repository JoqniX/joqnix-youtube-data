[{"type": "subtitle", "time": 6181.03, "timestamp": "01:43:01", "text": "皮肤收藏。所以他们真的"}, {"type": "subtitle", "time": 6183.27, "timestamp": "01:43:03", "text": "好多巫师主题的皮肤。所以"}, {"type": "subtitle", "time": 6185.51, "timestamp": "01:43:05", "text": "其中一个角色就是这样。"}, {"type": "subtitle", "time": 6187.109, "timestamp": "01:43:07", "text": "是给谁的？是的，其中一个"}, {"type": "subtitle", "time": 6190.39, "timestamp": "01:43:10", "text": "幸存者们，你真的可以成为杰拉德或"}, {"type": "subtitle", "time": 6194.99, "timestamp": "01:43:14", "text": "Siri、Yennefer 或 Tris"}, {"type": "subtitle", "time": 6196.709, "timestamp": "01:43:16", "text": "[音乐]"}, {"type": "subtitle", "time": 6199.83, "timestamp": "01:43:19", "text": "然后，作为杀手，你们就是骑士"}, {"type": "subtitle", "time": 6203.75, "timestamp": "01:43:23", "text": "这位艺术家收到了皮肤。是的。所以，"}, {"type": "subtitle", "time": 6205.51, "timestamp": "01:43:25", "text": "比如，如果你去看看……"}, {"type": "subtitle", "time": 6208.07, "timestamp": "01:43:28", "text": "收藏标签会显示你喜欢的内容"}, {"type": "subtitle", "time": 6211.03, "timestamp": "01:43:31", "text": "所有皮肤都像你一样"}, {"type": "subtitle", "time": 6212.95, "timestamp": "01:43:32", "text": "知道"}, {"type": "subtitle", "time": 6214.55, "timestamp": "01:43:34", "text": "捆"}, {"type": "subtitle", "time": 6216.55, "timestamp": "01:43:36", "text": "因为还有铁"}, {"type": "subtitle", "time": 6218.629, "timestamp": "01:43:38", "text": "少女。他们有过类似皮肤联名合作。"}, {"type": "subtitle", "time": 6221.83, "timestamp": "01:43:41", "text": "铁娘子乐队。他们有皮肤"}, {"type": "subtitle", "time": 6225.189, "timestamp": "01:43:45", "text": "与 um 合作"}, {"type": "subtitle", "time": 6227.91, "timestamp": "01:43:47", "text": "情侣时尚品牌。"}, {"type": "subtitle", "time": 6232.31, "timestamp": "01:43:52", "text": "游戏展 64 呃 古墓丽影"}, {"type": "subtitle", "time": 6234.229, "timestamp": "01:43:54", "text": "明显地"}, {"type": "subtitle", "time": 6236.629, "timestamp": "01:43:56", "text": "是啊，但是……"}, {"type": "subtitle", "time": 6238.79, "timestamp": "01:43:58", "text": "这里有整个"}]
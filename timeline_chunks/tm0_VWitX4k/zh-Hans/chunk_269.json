[{"type": "subtitle", "time": 16157.87, "timestamp": "04:29:17", "text": "哦，"}, {"type": "subtitle", "time": 16160.309, "timestamp": "04:29:20", "text": "[音乐]"}, {"type": "subtitle", "time": 16162.389, "timestamp": "04:29:22", "text": "我累了。"}, {"type": "subtitle", "time": 16165.91, "timestamp": "04:29:25", "text": "我105岁了。"}, {"type": "subtitle", "time": 16168.71, "timestamp": "04:29:28", "text": "哦，我好像遇到什么事了。哦，什么？"}, {"type": "subtitle", "time": 16171.59, "timestamp": "04:29:31", "text": "我愿意？我点击了它。使用你的步枪。不，"}, {"type": "subtitle", "time": 16175.11, "timestamp": "04:29:35", "text": "它就在我的库存里。"}, {"type": "subtitle", "time": 16178.79, "timestamp": "04:29:38", "text": "啊，拿着你的钥匙。狂野西部。狂野西部。"}, {"type": "subtitle", "time": 16181.11, "timestamp": "04:29:41", "text": "好的。"}, {"type": "subtitle", "time": 16184.309, "timestamp": "04:29:44", "text": "这里有多少人？"}, {"type": "subtitle", "time": 16187.11, "timestamp": "04:29:47", "text": "野蛮人都是疯子。像10个人"}, {"type": "subtitle", "time": 16189.59, "timestamp": "04:29:49", "text": "喜欢更多东西。"}, {"type": "subtitle", "time": 16192.55, "timestamp": "04:29:52", "text": "您可以在那里查看您的案件。"}, {"type": "subtitle", "time": 16197.349, "timestamp": "04:29:57", "text": "啊，不好意思。我有一个 Apex 机箱。"}]
[{"type": "subtitle", "time": 3849.109, "timestamp": "01:04:09", "text": "如果你增强它，它就会给你带来……"}, {"type": "subtitle", "time": 3851.029, "timestamp": "01:04:11", "text": "机器。如果你喜欢，请点击 E。"}, {"type": "subtitle", "time": 3853.109, "timestamp": "01:04:13", "text": "它的侧面。"}, {"type": "subtitle", "time": 3854.789, "timestamp": "01:04:14", "text": "你看到那个绿色的小方块了吗？"}, {"type": "subtitle", "time": 3856.71, "timestamp": "01:04:16", "text": "边？是的。如果你能增强它"}, {"type": "subtitle", "time": 3871.91, "timestamp": "01:04:31", "text": "哦，你还能得到免费的东西。"}, {"type": "subtitle", "time": 3873.349, "timestamp": "01:04:33", "text": "是的，你可以弄到瞄准镜之类的东西。"}, {"type": "subtitle", "time": 3875.19, "timestamp": "01:04:35", "text": "是的。但是，然后你就出局了。"}, {"type": "subtitle", "time": 3876.39, "timestamp": "01:04:36", "text": "负责那件事。但你可以去"}, {"type": "subtitle", "time": 3879.349, "timestamp": "01:04:39", "text": "就像另一种轻型弹药，就像一束光"}, {"type": "subtitle", "time": 3882.39, "timestamp": "01:04:42", "text": "弹药一号，对吧？"}, {"type": "subtitle", "time": 3885.43, "timestamp": "01:04:45", "text": "哇，这太疯狂了。我们在外面"}, {"type": "subtitle", "time": 3887.75, "timestamp": "01:04:47", "text": "打电话是为了好玩。你可以推它"}, {"type": "subtitle", "time": 3890.309, "timestamp": "01:04:50", "text": "比如你找到四个，或者"}, {"type": "subtitle", "time": 3891.91, "timestamp": "01:04:51", "text": "其中三个，你可以一直推到底"}, {"type": "subtitle", "time": 3896.61, "timestamp": "01:04:56", "text": "轻型弹药。我指的是黄金物品。"}]
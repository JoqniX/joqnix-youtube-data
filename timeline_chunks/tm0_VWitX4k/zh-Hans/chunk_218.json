[{"type": "subtitle", "time": 13083.99, "timestamp": "03:38:03", "text": "我确实在那上面做了一个标记。我得到了一个"}, {"type": "subtitle", "time": 13102.95, "timestamp": "03:38:22", "text": "好多新游戏要来了。"}, {"type": "subtitle", "time": 13105.429, "timestamp": "03:38:25", "text": "呃，这个"}, {"type": "subtitle", "time": 13107.91, "timestamp": "03:38:27", "text": "我很兴奋能玩到《提取》这款游戏。"}, {"type": "subtitle", "time": 13111.51, "timestamp": "03:38:31", "text": "射击游戏，就是那个马拉松游戏，对吧？"}, {"type": "subtitle", "time": 13117.59, "timestamp": "03:38:37", "text": "哦，你想玩就玩吧，但是……"}, {"type": "subtitle", "time": 13119.83, "timestamp": "03:38:39", "text": "还没上映呢。呃，快到了"}, {"type": "subtitle", "time": 13121.91, "timestamp": "03:38:41", "text": "九月。但你需要付费。啊，"}, {"type": "subtitle", "time": 13126.15, "timestamp": "03:38:46", "text": "这就是问题所在。哦，它不是免费的。"}, {"type": "subtitle", "time": 13128.229, "timestamp": "03:38:48", "text": "你是蹦极爱好者。"}, {"type": "subtitle", "time": 13139.51, "timestamp": "03:38:59", "text": "你看到那款带有人工智能的新浏览器了吗？"}]
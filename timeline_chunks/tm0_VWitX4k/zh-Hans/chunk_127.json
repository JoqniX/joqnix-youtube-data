[{"type": "subtitle", "time": 7624.47, "timestamp": "02:07:04", "text": "我发现自己经常这样做。"}, {"type": "subtitle", "time": 7628.31, "timestamp": "02:07:08", "text": "几乎经常如此。我做得相当不错"}, {"type": "subtitle", "time": 7631.109, "timestamp": "02:07:11", "text": "经常。我不知道为什么会有这种事，"}, {"type": "subtitle", "time": 7633.51, "timestamp": "02:07:13", "text": "但这确实存在。"}, {"type": "subtitle", "time": 7637.189, "timestamp": "02:07:17", "text": "是的，这确实存在。"}, {"type": "subtitle", "time": 7639.35, "timestamp": "02:07:19", "text": "是的，我同意。"}, {"type": "subtitle", "time": 7642.39, "timestamp": "02:07:22", "text": "嗨，游戏终于加载完毕了。等待，"}, {"type": "subtitle", "time": 7645.83, "timestamp": "02:07:25", "text": "为什么是“对不起”？"}, {"type": "subtitle", "time": 7648.39, "timestamp": "02:07:28", "text": "那是什么？那是什么？那是什么？"}, {"type": "subtitle", "time": 7651.589, "timestamp": "02:07:31", "text": "感觉如何？嗯，"}, {"type": "subtitle", "time": 7661.91, "timestamp": "02:07:41", "text": "但是，嗯，最近我一直在……"}, {"type": "subtitle", "time": 7665.43, "timestamp": "02:07:45", "text": "比如尝试将一些事情自动化"}, {"type": "subtitle", "time": 7667.83, "timestamp": "02:07:47", "text": "直播等等。"}, {"type": "subtitle", "time": 7670.55, "timestamp": "02:07:50", "text": "它有点行不通，因为它需要"}, {"type": "subtitle", "time": 7673.91, "timestamp": "02:07:53", "text": "比如兄弟浏览器政策之类的东西"}, {"type": "subtitle", "time": 7677.43, "timestamp": "02:07:57", "text": "你知道，所有的一切。这有点像"}]
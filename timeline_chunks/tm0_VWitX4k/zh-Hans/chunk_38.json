[{"type": "subtitle", "time": 2283.19, "timestamp": "00:38:03", "text": "我确实尝试过决赛。"}, {"type": "subtitle", "time": 2285.99, "timestamp": "00:38:05", "text": "那位冠军还不错，但是……"}, {"type": "subtitle", "time": 2289.51, "timestamp": "00:38:09", "text": "真的很难"}, {"type": "subtitle", "time": 2298.55, "timestamp": "00:38:18", "text": "想象一下，期末考试周一出来……"}, {"type": "subtitle", "time": 2301.829, "timestamp": "00:38:21", "text": "大逃杀奖。"}, {"type": "subtitle", "time": 2304.15, "timestamp": "00:38:24", "text": "天哪，期末考试。说实话，决赛是"}, {"type": "subtitle", "time": 2311.67, "timestamp": "00:38:31", "text": "我们在这里降落。我们走吧。"}, {"type": "subtitle", "time": 2313.75, "timestamp": "00:38:33", "text": "我意识到我是"}, {"type": "subtitle", "time": 2320.71, "timestamp": "00:38:40", "text": "我的意思是，Revenant 很棒。"}, {"type": "subtitle", "time": 2327.03, "timestamp": "00:38:47", "text": "但他们改变了他们所做的事情"}, {"type": "subtitle", "time": 2330.79, "timestamp": "00:38:50", "text": "那个汤姆玩意儿。我想要的就是那个"}, {"type": "subtitle", "time": 2335.51, "timestamp": "00:38:55", "text": "图腾。那真有趣。现在，现在感觉就像"}]
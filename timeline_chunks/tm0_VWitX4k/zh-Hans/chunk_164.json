[{"type": "subtitle", "time": 9844.23, "timestamp": "02:44:04", "text": "我现在更担心我的电脑了。"}, {"type": "subtitle", "time": 9848.23, "timestamp": "02:44:08", "text": "因为我一天24小时都在用它"}, {"type": "subtitle", "time": 9851.67, "timestamp": "02:44:11", "text": "现在。而唯一能"}, {"type": "subtitle", "time": 9853.349, "timestamp": "02:44:13", "text": "是的。唯一正在发生的事情"}, {"type": "subtitle", "time": 9856.63, "timestamp": "02:44:16", "text": "爆炸或类似崩溃之类的"}, {"type": "subtitle", "time": 9859.99, "timestamp": "02:44:19", "text": "先看显示器，因为哦我的天哪，我"}, {"type": "subtitle", "time": 9865.91, "timestamp": "02:44:25", "text": "是的。我只希望小组什么事都不会发生"}, {"type": "subtitle", "time": 9868.469, "timestamp": "02:44:28", "text": "面板再次出现同样的问题。如果我必须这样做的话"}, {"type": "subtitle", "time": 9871.51, "timestamp": "02:44:31", "text": "修了两次就坏了。"}, {"type": "subtitle", "time": 9874.95, "timestamp": "02:44:34", "text": "立即享受保修服务。是的。我不得不两次"}, {"type": "subtitle", "time": 9878.63, "timestamp": "02:44:38", "text": "修理，嗯，我不得不……是的，它坏了。"}, {"type": "subtitle", "time": 9881.269, "timestamp": "02:44:41", "text": "还有保修。所以，如果我弄丢了，我就输了。"}, {"type": "subtitle", "time": 9885.59, "timestamp": "02:44:45", "text": "它。丢掉它。而且，PC版也一样。"}, {"type": "subtitle", "time": 9889.429, "timestamp": "02:44:49", "text": "那个东西，橱柜，呃，玻璃的。不，是"}, {"type": "subtitle", "time": 9892.389, "timestamp": "02:44:52", "text": "破碎的面板。"}, {"type": "subtitle", "time": 9895.99, "timestamp": "02:44:55", "text": "那件事彻底崩溃了。是的，那件事彻底崩溃了。"}, {"type": "subtitle", "time": 9897.99, "timestamp": "02:44:57", "text": "是因为天气热吗？不，"}]
[{"type": "subtitle", "time": 6966.709, "timestamp": "01:56:06", "text": "我的天啊。哦，我的"}, {"type": "subtitle", "time": 6975.51, "timestamp": "01:56:15", "text": "好的，我们这就去修一个。"}, {"type": "subtitle", "time": 6987.99, "timestamp": "01:56:27", "text": "我的天啊。"}, {"type": "subtitle", "time": 7002.229, "timestamp": "01:56:42", "text": "啊，我上瘾了。"}, {"type": "subtitle", "time": 7004.629, "timestamp": "01:56:44", "text": "我死了。"}, {"type": "subtitle", "time": 7012.87, "timestamp": "01:56:52", "text": "不过还是赢了。我们赢了。我们赢了。"}, {"type": "subtitle", "time": 7017.189, "timestamp": "01:56:57", "text": "我被一些恶魔抓走了。"}, {"type": "subtitle", "time": 7019.109, "timestamp": "01:56:59", "text": "是的。所以实体就像"}]
[{"type": "subtitle", "time": 6241.51, "timestamp": "01:44:01", "text": "简直就像他们已经……"}, {"type": "subtitle", "time": 6244.39, "timestamp": "01:44:04", "text": "你也可以玩《彩虹六号：围攻》。"}, {"type": "subtitle", "time": 6250.39, "timestamp": "01:44:10", "text": "你可以扮演 Wai Blitz 或"}, {"type": "subtitle", "time": 6253.35, "timestamp": "01:44:13", "text": "TL Tero 我不会念，但你可以念"}, {"type": "subtitle", "time": 6256.07, "timestamp": "01:44:16", "text": "扮演像River 60年代角色那样的角色"}, {"type": "subtitle", "time": 6260.709, "timestamp": "01:44:20", "text": "哇，M，是的。"}, {"type": "subtitle", "time": 6262.629, "timestamp": "01:44:22", "text": "不过这很棒。真的很有趣。"}, {"type": "subtitle", "time": 6264.709, "timestamp": "01:44:24", "text": "我超爱它。这就是我喜欢它的原因。"}, {"type": "subtitle", "time": 6267.51, "timestamp": "01:44:27", "text": "因为它很滑稽。他们是"}, {"type": "subtitle", "time": 6269.51, "timestamp": "01:44:29", "text": "他们正在与另一部动画合作"}, {"type": "subtitle", "time": 6271.35, "timestamp": "01:44:31", "text": "很快。我真的很兴奋，因为"}, {"type": "subtitle", "time": 6278.229, "timestamp": "01:44:38", "text": "这部动漫叫做《夜之梦》。"}, {"type": "subtitle", "time": 6281.59, "timestamp": "01:44:41", "text": "我想应该是小猫咪吧。这简直太可怕了"}, {"type": "subtitle", "time": 6285.59, "timestamp": "01:44:45", "text": "一部类似僵尸题材的动漫"}, {"type": "subtitle", "time": 6287.43, "timestamp": "01:44:47", "text": "末日浩劫，但不是丧尸，而是……"}, {"type": "subtitle", "time": 6295.109, "timestamp": "01:44:55", "text": "所以它就像一群猫一样"}, {"type": "subtitle", "time": 6297.59, "timestamp": "01:44:57", "text": "像猫一样感染，舔你什么的"}]
[{"type": "subtitle", "time": 1080.47, "timestamp": "00:18:00", "text": "外来者。所以，并不是说我"}, {"type": "subtitle", "time": 1082.549, "timestamp": "00:18:02", "text": "就像一个在里面，就像我是一个快门或"}, {"type": "subtitle", "time": 1085.43, "timestamp": "00:18:05", "text": "任何事物。我出门的次数太少了。"}, {"type": "subtitle", "time": 1087.669, "timestamp": "00:18:07", "text": "保证。"}, {"type": "subtitle", "time": 1089.11, "timestamp": "00:18:09", "text": "所以，我很少出门。"}, {"type": "subtitle", "time": 1091.029, "timestamp": "00:18:11", "text": "我花够钱了。所以，我有点"}, {"type": "subtitle", "time": 1098.23, "timestamp": "00:18:18", "text": "但我确实买了一些。"}, {"type": "subtitle", "time": 1100.31, "timestamp": "00:18:20", "text": "买了一些书和其他东西"}, {"type": "subtitle", "time": 1102.23, "timestamp": "00:18:22", "text": "天。所以，我并没有真的把钱花在我的……上。"}, {"type": "subtitle", "time": 1103.52, "timestamp": "00:18:23", "text": "钱。"}, {"type": "subtitle", "time": 1105.99, "timestamp": "00:18:25", "text": "[音乐]"}, {"type": "subtitle", "time": 1109.59, "timestamp": "00:18:29", "text": "你有没有过买东西后后悔的经历？"}, {"type": "subtitle", "time": 1111.909, "timestamp": "00:18:31", "text": "当你在游戏中购买这类物品时"}, {"type": "subtitle", "time": 1117.59, "timestamp": "00:18:37", "text": "你能再说一遍吗？你有没有过"}, {"type": "subtitle", "time": 1121.19, "timestamp": "00:18:41", "text": "买东西的时候后悔了"}, {"type": "subtitle", "time": 1127.11, "timestamp": "00:18:47", "text": "东西？哦，百分之百后悔买了这件东西。"}, {"type": "subtitle", "time": 1129.51, "timestamp": "00:18:49", "text": "我的天，我想我能想起一个……"}, {"type": "subtitle", "time": 1132.39, "timestamp": "00:18:52", "text": "在我买的其中一款皮肤的顶部"}, {"type": "subtitle", "time": 1134.07, "timestamp": "00:18:54", "text": "瓦莱兰特。我当时就想，第一个是什么？"}, {"type": "subtitle", "time": 1136.87, "timestamp": "00:18:56", "text": "我买的皮肤？我买了它，然后我"}, {"type": "subtitle", "time": 1138.39, "timestamp": "00:18:58", "text": "哦，我经常用它。这是"}]
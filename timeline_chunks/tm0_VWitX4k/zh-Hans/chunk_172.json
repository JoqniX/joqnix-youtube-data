[{"type": "subtitle", "time": 10324.55, "timestamp": "02:52:04", "text": "好难过。每当我遇到人，我就会……"}, {"type": "subtitle", "time": 10328.389, "timestamp": "02:52:08", "text": "比如这样说：“你好，很高兴见到你，朋友。”"}, {"type": "subtitle", "time": 10330.79, "timestamp": "02:52:10", "text": "印度YouTube博主。祝你好运"}, {"type": "subtitle", "time": 10332.389, "timestamp": "02:52:12", "text": "旅行。祝你一切顺利。"}, {"type": "subtitle", "time": 10335.03, "timestamp": "02:52:15", "text": "那。"}, {"type": "subtitle", "time": 10339.11, "timestamp": "02:52:19", "text": "我刚刚订阅并加入了这个服务器。"}, {"type": "subtitle", "time": 10340.95, "timestamp": "02:52:20", "text": "我不太喜欢与人交流。我很善良"}, {"type": "subtitle", "time": 10343.51, "timestamp": "02:52:23", "text": "害羞的。"}, {"type": "subtitle", "time": 10346.309, "timestamp": "02:52:26", "text": "相同的。我在运气方面也挺好的。"}, {"type": "subtitle", "time": 10348.15, "timestamp": "02:52:28", "text": "小队服务器。我应该在那里。"}, {"type": "subtitle", "time": 10349.99, "timestamp": "02:52:29", "text": "瞧。"}, {"type": "subtitle", "time": 10353.19, "timestamp": "02:52:33", "text": "或许曾经有人查阅过资料"}, {"type": "subtitle", "time": 10355.51, "timestamp": "02:52:35", "text": "在那里或者像聊天或者什么或者流行乐"}, {"type": "subtitle", "time": 10361.67, "timestamp": "02:52:41", "text": "[音乐]"}, {"type": "subtitle", "time": 10363.429, "timestamp": "02:52:43", "text": "这就是我为星空所做的。"}, {"type": "subtitle", "time": 10366.469, "timestamp": "02:52:46", "text": "东西。你可能已经见过一些"}, {"type": "subtitle", "time": 10369.67, "timestamp": "02:52:49", "text": "有时过段时间我会突然输入"}, {"type": "subtitle", "time": 10371.51, "timestamp": "02:52:51", "text": "聊天"}, {"type": "subtitle", "time": 10379.99, "timestamp": "02:52:59", "text": "对大多数人来说，这纯粹是随机的。"}]
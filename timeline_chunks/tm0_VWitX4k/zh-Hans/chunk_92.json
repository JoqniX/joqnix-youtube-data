[{"type": "subtitle", "time": 5526.39, "timestamp": "01:32:06", "text": "呃，而且大多数杀手只是跟随。"}, {"type": "subtitle", "time": 5539.43, "timestamp": "01:32:19", "text": "我的天哪，他竟然在凌晨一点把我绑架了。"}, {"type": "subtitle", "time": 5548.07, "timestamp": "01:32:28", "text": "我的天啊。当我看到这个角色时"}, {"type": "subtitle", "time": 5550.07, "timestamp": "01:32:30", "text": "感觉很挣扎，我觉得自己好像……"}, {"type": "subtitle", "time": 5558.149, "timestamp": "01:32:38", "text": "你走开，然后她就要……"}, {"type": "subtitle", "time": 5560.229, "timestamp": "01:32:40", "text": "下来。"}, {"type": "subtitle", "time": 5569.91, "timestamp": "01:32:49", "text": "你怎么会有医疗包来治疗别人呢？"}, {"type": "subtitle", "time": 5571.83, "timestamp": "01:32:51", "text": "别的？"}, {"type": "subtitle", "time": 5579.35, "timestamp": "01:32:59", "text": "这游戏太疯狂了。血液量"}]
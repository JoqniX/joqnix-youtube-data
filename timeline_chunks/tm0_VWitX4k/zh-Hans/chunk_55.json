[{"type": "subtitle", "time": 3300.79, "timestamp": "00:55:00", "text": "这项工作。我的天啊。你做了"}, {"type": "subtitle", "time": 3303.99, "timestamp": "00:55:03", "text": "一切。你"}, {"type": "subtitle", "time": 3307.349, "timestamp": "00:55:07", "text": "我尽力做到既接受又给予。"}, {"type": "subtitle", "time": 3310.23, "timestamp": "00:55:10", "text": "即使网络延迟很高，仍然造成了伤害。但"}, {"type": "subtitle", "time": 3317.99, "timestamp": "00:55:17", "text": "太疯狂了。我的天哪。我的天啊。"}, {"type": "subtitle", "time": 3327.03, "timestamp": "00:55:27", "text": "里库。好的。好的。让我回到爱中去"}, {"type": "subtitle", "time": 3336.79, "timestamp": "00:55:36", "text": "我从中什么也得不到。那真是太……"}, {"type": "subtitle", "time": 3340.309, "timestamp": "00:55:40", "text": "耻辱。不。哦，是的。对于这些包装来说，它们"}, {"type": "subtitle", "time": 3344.71, "timestamp": "00:55:44", "text": "像火花塞一样，对吧？"}, {"type": "subtitle", "time": 3346.95, "timestamp": "00:55:46", "text": "奖金。"}, {"type": "subtitle", "time": 3349.27, "timestamp": "00:55:49", "text": "是的，"}, {"type": "subtitle", "time": 3352.549, "timestamp": "00:55:52", "text": "这很酷。"}, {"type": "subtitle", "time": 3355.51, "timestamp": "00:55:55", "text": "我的使命是给予你"}, {"type": "subtitle", "time": 3358.789, "timestamp": "00:55:58", "text": "给你带来的是……嗯，该怎么称呼它呢？"}]
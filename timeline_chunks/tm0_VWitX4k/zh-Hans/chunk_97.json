[{"type": "subtitle", "time": 5820.79, "timestamp": "01:37:00", "text": "我可以扮演幸存者。呃，所以"}, {"type": "subtitle", "time": 5822.149, "timestamp": "01:37:02", "text": "你打算怎么做？因为我会让你这么做。"}, {"type": "subtitle", "time": 5824.47, "timestamp": "01:37:04", "text": "在你们的服务器上操作。哦，我加入了"}, {"type": "subtitle", "time": 5826.47, "timestamp": "01:37:06", "text": "你的。"}, {"type": "subtitle", "time": 5830.95, "timestamp": "01:37:10", "text": "哦，不。没关系。所以，回去继续玩吧。去"}, {"type": "subtitle", "time": 5835.83, "timestamp": "01:37:15", "text": "点击开始游戏，然后选择扮演幸存者。"}, {"type": "subtitle", "time": 5841.35, "timestamp": "01:37:21", "text": "好的。呃，扮演幸存者"}, {"type": "subtitle", "time": 5843.43, "timestamp": "01:37:23", "text": "然后你就会看到像大厅那样的地方。"}, {"type": "subtitle", "time": 5845.83, "timestamp": "01:37:25", "text": "然后我就可以加入你的游戏大厅了。"}, {"type": "subtitle", "time": 5851.59, "timestamp": "01:37:31", "text": "然后这意味着它会像这样"}, {"type": "subtitle", "time": 5853.99, "timestamp": "01:37:33", "text": "从技术上讲，它就像覆盖了你的"}, {"type": "subtitle", "time": 5856.31, "timestamp": "01:37:36", "text": "一般的。"}, {"type": "subtitle", "time": 5857.91, "timestamp": "01:37:37", "text": "所以我点击高p值，但我没事。"}, {"type": "subtitle", "time": 5859.189, "timestamp": "01:37:39", "text": "就这样。再说一遍，我并不介意"}, {"type": "subtitle", "time": 5860.39, "timestamp": "01:37:40", "text": "那。"}, {"type": "subtitle", "time": 5863.83, "timestamp": "01:37:43", "text": "然后我们就就这样了。"}, {"type": "subtitle", "time": 5867.99, "timestamp": "01:37:47", "text": "所以，呃，然后你应该能够……"}, {"type": "subtitle", "time": 5869.59, "timestamp": "01:37:49", "text": "有一种东西叫做血液。"}, {"type": "subtitle", "time": 5875.03, "timestamp": "01:37:55", "text": "血点。你看到了吗？所以，你看"}, {"type": "subtitle", "time": 5877.51, "timestamp": "01:37:57", "text": "那些像红色一样的红色三角形"}]
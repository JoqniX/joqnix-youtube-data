[{"type": "subtitle", "time": 5116.07, "timestamp": "01:25:16", "text": "所以你得到的就是你得到的，就像……"}, {"type": "subtitle", "time": 5118.95, "timestamp": "01:25:18", "text": "《Dead by Dead》讲述的是……"}, {"type": "subtitle", "time": 5121.59, "timestamp": "01:25:21", "text": "呃，我只知道这就像捉迷藏一样。"}, {"type": "subtitle", "time": 5124.55, "timestamp": "01:25:24", "text": "离开。有个杀手，你得躲起来。"}, {"type": "subtitle", "time": 5127.669, "timestamp": "01:25:27", "text": "远离他们，你就被困住了。"}, {"type": "subtitle", "time": 5130.07, "timestamp": "01:25:30", "text": "游乐场之类的。"}, {"type": "subtitle", "time": 5132.87, "timestamp": "01:25:32", "text": "呃，所以有四个。"}, {"type": "subtitle", "time": 5135.03, "timestamp": "01:25:35", "text": "幸存者、一名凶手和"}, {"type": "subtitle", "time": 5138.149, "timestamp": "01:25:38", "text": "杀手的目标是杀死幸存者。"}, {"type": "subtitle", "time": 5140.55, "timestamp": "01:25:40", "text": "或者幸存者的目标是逃脱。所以"}, {"type": "subtitle", "time": 5142.47, "timestamp": "01:25:42", "text": "我们必须解决这个问题，作为幸存者，因为我们是"}, {"type": "subtitle", "time": 5144.709, "timestamp": "01:25:44", "text": "准备玩《幸存者》游戏。呃，我们必须"}, {"type": "subtitle", "time": 5148.87, "timestamp": "01:25:48", "text": "修复生成器。呃，我们得像你一样。"}, {"type": "subtitle", "time": 5151.11, "timestamp": "01:25:51", "text": "要知道，要避开凶手。我们刚刚到达"}, {"type": "subtitle", "time": 5153.97, "timestamp": "01:25:53", "text": "基本上就是想办法逃脱。"}, {"type": "subtitle", "time": 5156.31, "timestamp": "01:25:56", "text": "[音乐]"}, {"type": "subtitle", "time": 5158.149, "timestamp": "01:25:58", "text": "并避免被杀手杀害。"}, {"type": "subtitle", "time": 5159.75, "timestamp": "01:25:59", "text": "而凶手的全部目的就是"}]
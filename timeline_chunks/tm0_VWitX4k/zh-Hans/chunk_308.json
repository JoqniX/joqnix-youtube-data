[{"type": "subtitle", "time": 18503.27, "timestamp": "05:08:23", "text": "好的。我该如何再次加入？"}, {"type": "subtitle", "time": 18505.43, "timestamp": "05:08:25", "text": "离开。嗯？你可以点击我的个人资料"}, {"type": "subtitle", "time": 18507.75, "timestamp": "05:08:27", "text": "直接加入就行了。朋友们，有人补充道"}, {"type": "subtitle", "time": 18509.91, "timestamp": "05:08:29", "text": "我。"}, {"type": "subtitle", "time": 18512.15, "timestamp": "05:08:32", "text": "梦已逝。"}, {"type": "subtitle", "time": 18520.788, "timestamp": "05:08:40", "text": "竞争对手。我想知道这是什么游戏。"}, {"type": "subtitle", "time": 18535.79, "timestamp": "05:08:55", "text": "哦。"}]
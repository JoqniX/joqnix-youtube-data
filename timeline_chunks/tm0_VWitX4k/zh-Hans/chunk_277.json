[{"type": "subtitle", "time": 16625.749, "timestamp": "04:37:05", "text": "哦，快跑，快跑，走。该死的。"}, {"type": "subtitle", "time": 16645.429, "timestamp": "04:37:25", "text": "嘿。嘿。"}, {"type": "subtitle", "time": 16647.349, "timestamp": "04:37:27", "text": "哦，你已经在建筑物里面了。我当时"}, {"type": "subtitle", "time": 16649.59, "timestamp": "04:37:29", "text": "是谁？你在干什么"}, {"type": "subtitle", "time": 16668.31, "timestamp": "04:37:48", "text": "我目前的拍摄效果如何？我不知道。"}, {"type": "subtitle", "time": 16677.99, "timestamp": "04:37:57", "text": "他就坐在我旁边。"}, {"type": "subtitle", "time": 16679.67, "timestamp": "04:37:59", "text": "哦，不错。"}]
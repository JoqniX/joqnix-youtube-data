[{"type": "subtitle", "time": 15241.83, "timestamp": "04:14:01", "text": "你的哨兵用无人机打我。"}, {"type": "subtitle", "time": 15244.229, "timestamp": "04:14:04", "text": "我有一架无人机。"}, {"type": "subtitle", "time": 15250.55, "timestamp": "04:14:10", "text": "我以为是从那么远的地方寄过来的。"}, {"type": "subtitle", "time": 15252.63, "timestamp": "04:14:12", "text": "我勒个去？"}, {"type": "subtitle", "time": 15256.149, "timestamp": "04:14:16", "text": "但它说的是无人机。"}, {"type": "subtitle", "time": 15259.51, "timestamp": "04:14:19", "text": "喷火"}, {"type": "subtitle", "time": 15279.03, "timestamp": "04:14:39", "text": "哦，"}, {"type": "subtitle", "time": 15281.78, "timestamp": "04:14:41", "text": "它在库存里。"}, {"type": "subtitle", "time": 15283.429, "timestamp": "04:14:43", "text": "[音乐]"}, {"type": "subtitle", "time": 15285.349, "timestamp": "04:14:45", "text": "我正在获得"}, {"type": "subtitle", "time": 15287.429, "timestamp": "04:14:47", "text": "连续两次。我就像个狙击手"}, {"type": "subtitle", "time": 15293.51, "timestamp": "04:14:53", "text": "哦，步枪。"}]
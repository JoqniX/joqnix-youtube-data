[{"type": "subtitle", "time": 1020.629, "timestamp": "00:17:00", "text": "曾经拥有很多钱。嗯。"}, {"type": "subtitle", "time": 1025.029, "timestamp": "00:17:05", "text": "就像我现在正在学习一样，"}, {"type": "subtitle", "time": 1029.51, "timestamp": "00:17:09", "text": "主要从事呃……工作"}, {"type": "subtitle", "time": 1032.23, "timestamp": "00:17:12", "text": "在工商管理中被称为。"}, {"type": "subtitle", "time": 1034.309, "timestamp": "00:17:14", "text": "我是一名秘书。"}, {"type": "subtitle", "time": 1036.47, "timestamp": "00:17:16", "text": "我帮别人记账。"}, {"type": "subtitle", "time": 1037.47, "timestamp": "00:17:17", "text": "基本上。"}, {"type": "subtitle", "time": 1040.309, "timestamp": "00:17:20", "text": "[音乐]"}, {"type": "subtitle", "time": 1043.099, "timestamp": "00:17:23", "text": "但我给的报酬很高。"}, {"type": "subtitle", "time": 1053.59, "timestamp": "00:17:33", "text": "哇。我当时就想，哇。简直太疯狂了。"}, {"type": "subtitle", "time": 1055.59, "timestamp": "00:17:35", "text": "这是。我承认这有点……"}, {"type": "subtitle", "time": 1057.11, "timestamp": "00:17:37", "text": "钱。"}, {"type": "subtitle", "time": 1070.71, "timestamp": "00:17:50", "text": "等待，"}, {"type": "subtitle", "time": 1073.59, "timestamp": "00:17:53", "text": "我觉得你刚才好像被切断了一会儿信号。"}, {"type": "subtitle", "time": 1076.15, "timestamp": "00:17:56", "text": "可能是我的电脑。是的，你当时"}, {"type": "subtitle", "time": 1078.549, "timestamp": "00:17:58", "text": "说道。所以，我其实不太擅长……"}]
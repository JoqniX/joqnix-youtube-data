[{"type": "subtitle", "time": 4381.27, "timestamp": "01:13:01", "text": "是吉布拉尔塔岛上的一座城堡，我认为"}, {"type": "subtitle", "time": 4383.189, "timestamp": "01:13:03", "text": "呼叫棒。"}, {"type": "subtitle", "time": 4385.11, "timestamp": "01:13:05", "text": "等等，你死了吗？我的天哪，你"}, {"type": "subtitle", "time": 4387.11, "timestamp": "01:13:07", "text": "死了。呃，是的，我做了。是的，"}, {"type": "subtitle", "time": 4389.189, "timestamp": "01:13:09", "text": "下面好像有三个人。是的，"}, {"type": "subtitle", "time": 4391.35, "timestamp": "01:13:11", "text": "令人尴尬。然后他们追我"}, {"type": "subtitle", "time": 4433.75, "timestamp": "01:13:53", "text": "哦，他们要来了。"}, {"type": "subtitle", "time": 4436.47, "timestamp": "01:13:56", "text": "复活了。复活了。"}]
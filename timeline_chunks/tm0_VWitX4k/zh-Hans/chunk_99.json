[{"type": "subtitle", "time": 5942.39, "timestamp": "01:39:02", "text": "呃，我们请到了史蒂文·哈灵顿。"}, {"type": "subtitle", "time": 5945.75, "timestamp": "01:39:05", "text": "《怪奇物语》、南希·惠勒，我们得到了"}, {"type": "subtitle", "time": 5950.55, "timestamp": "01:39:10", "text": "来自 Ash versus 的 Ashley J. uh Williams"}, {"type": "subtitle", "time": 5956.55, "timestamp": "01:39:16", "text": "邪恶的。呃，我们还有什么？呃，"}, {"type": "subtitle", "time": 5959.51, "timestamp": "01:39:19", "text": "我们有来自《In the》的侦探塔普"}, {"type": "subtitle", "time": 5963.189, "timestamp": "01:39:23", "text": "灵魂。呃，我们请来了昆顿·史密斯"}, {"type": "subtitle", "time": 5967.43, "timestamp": "01:39:27", "text": "噩梦与艾尔街。呃，然后"}, {"type": "subtitle", "time": 5970.229, "timestamp": "01:39:30", "text": "是的，我们从迈克尔那里得到了劳伦·斯特罗德。"}, {"type": "subtitle", "time": 5972.229, "timestamp": "01:39:32", "text": "迈尔斯。当然，还有我们的"}, {"type": "subtitle", "time": 5974.95, "timestamp": "01:39:34", "text": "原创角色。然后还有皮肤"}, {"type": "subtitle", "time": 5976.47, "timestamp": "01:39:36", "text": "特点。哦，我们还有《心灵杀手》。"}, {"type": "subtitle", "time": 5979.59, "timestamp": "01:39:39", "text": "我们也买了《心灵杀手》。我忘了。"}, {"type": "subtitle", "time": 5984.07, "timestamp": "01:39:44", "text": "哇。还有特雷弗。来自特雷弗·贝尔蒙特"}, {"type": "subtitle", "time": 5986.629, "timestamp": "01:39:46", "text": "呃，还有《恶魔城》和《比尔》。我们有"}, {"type": "subtitle", "time": 5989.91, "timestamp": "01:39:49", "text": "比尔也是。还有《龙与地下城》"}, {"type": "subtitle", "time": 5992.79, "timestamp": "01:39:52", "text": "章。哇。"}, {"type": "subtitle", "time": 5995.43, "timestamp": "01:39:55", "text": "是的。我还加了个杀手，巫妖。"}, {"type": "subtitle", "time": 5998.07, "timestamp": "01:39:58", "text": "以及"}]
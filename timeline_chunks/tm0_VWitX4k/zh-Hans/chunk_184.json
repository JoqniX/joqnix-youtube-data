[{"type": "subtitle", "time": 11049.59, "timestamp": "03:04:09", "text": "是的，我的梦想之一就是做这样的事"}, {"type": "subtitle", "time": 11052.389, "timestamp": "03:04:12", "text": "贾马"}, {"type": "subtitle", "time": 11054.389, "timestamp": "03:04:14", "text": "因为我想走音乐这条路。"}, {"type": "subtitle", "time": 11057.429, "timestamp": "03:04:17", "text": "现在。所以我把她留了下来，作为一个大人物"}, {"type": "subtitle", "time": 11058.95, "timestamp": "03:04:18", "text": "灵感"}, {"type": "subtitle", "time": 11061.03, "timestamp": "03:04:21", "text": "所以我可以说：“哦，你可以做到。”我"}, {"type": "subtitle", "time": 11063.349, "timestamp": "03:04:23", "text": "相信自己。"}, {"type": "subtitle", "time": 11067.03, "timestamp": "03:04:27", "text": "是的。如果仅仅是音乐，创作音乐的话"}, {"type": "subtitle", "time": 11069.349, "timestamp": "03:04:29", "text": "然后我本可以走上这条路。"}, {"type": "subtitle", "time": 11072.79, "timestamp": "03:04:32", "text": "Vocaloid之类的东西，以及所有那些"}, {"type": "subtitle", "time": 11076.309, "timestamp": "03:04:36", "text": "比如一些歌曲之类的东西"}, {"type": "subtitle", "time": 11079.11, "timestamp": "03:04:39", "text": "是啊，你得先写首歌才行。"}, {"type": "subtitle", "time": 11082.95, "timestamp": "03:04:42", "text": "唱出来。是的。"}, {"type": "subtitle", "time": 11084.469, "timestamp": "03:04:44", "text": "所以"}, {"type": "subtitle", "time": 11086.87, "timestamp": "03:04:46", "text": "但是，是的，我现在需要唱歌这个功能。"}, {"type": "subtitle", "time": 11090.63, "timestamp": "03:04:50", "text": "就像把它匹配起来一样"}, {"type": "subtitle", "time": 11092.55, "timestamp": "03:04:52", "text": "我最初的想法是在得到之后"}, {"type": "subtitle", "time": 11094.79, "timestamp": "03:04:54", "text": "课程结束后定居日本"}, {"type": "subtitle", "time": 11097.19, "timestamp": "03:04:57", "text": "东西，或者可能是在课程期间如果"}, {"type": "subtitle", "time": 11099.19, "timestamp": "03:04:59", "text": "如果我做兼职，我就有空了，看看这样行不行。"}]
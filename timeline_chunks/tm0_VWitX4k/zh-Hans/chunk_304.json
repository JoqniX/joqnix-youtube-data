[{"type": "subtitle", "time": 18273.59, "timestamp": "05:04:33", "text": "有个叫太阳石的人。我想要"}, {"type": "subtitle", "time": 18277.51, "timestamp": "05:04:37", "text": "杀了他，杀了他。桑罗？"}, {"type": "subtitle", "time": 18280.47, "timestamp": "05:04:40", "text": "是的。一个男人和一个男人，就像我一样"}, {"type": "subtitle", "time": 18282.948, "timestamp": "05:04:42", "text": "机器人化身。"}, {"type": "subtitle", "time": 18284.788, "timestamp": "05:04:44", "text": "就像他长了翅膀之类的。我认为他"}, {"type": "subtitle", "time": 18288.47, "timestamp": "05:04:48", "text": "付的钱足够买这些东西了。是的。"}, {"type": "subtitle", "time": 18291.59, "timestamp": "05:04:51", "text": "哦，这皮肤……你……"}]
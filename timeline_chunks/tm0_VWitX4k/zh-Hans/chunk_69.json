[{"type": "subtitle", "time": 4141.99, "timestamp": "01:09:01", "text": "洛洛。"}, {"type": "subtitle", "time": 4157.749, "timestamp": "01:09:17", "text": "我的天哪。你来自哪里？"}, {"type": "subtitle", "time": 4164.39, "timestamp": "01:09:24", "text": "也一样。"}, {"type": "subtitle", "time": 4167.189, "timestamp": "01:09:27", "text": "兄弟，真倒霉。哦，我不应该"}, {"type": "subtitle", "time": 4169.99, "timestamp": "01:09:29", "text": "我已经在那里做过了。"}, {"type": "subtitle", "time": 4180.309, "timestamp": "01:09:40", "text": "哦，我们可以先杀了你。我的天啊。"}, {"type": "subtitle", "time": 4183.59, "timestamp": "01:09:43", "text": "是的，你做了很多。你是怎么得到"}, {"type": "subtitle", "time": 4186.47, "timestamp": "01:09:46", "text": "五杀？"}, {"type": "subtitle", "time": 4189.59, "timestamp": "01:09:49", "text": "球队又回来了。我向……"}, {"type": "subtitle", "time": 4191.51, "timestamp": "01:09:51", "text": "我们看到了三个小队。我杀了他们三个"}, {"type": "subtitle", "time": 4194.47, "timestamp": "01:09:54", "text": "我们当时看到的那些。该死。"}, {"type": "subtitle", "time": 4197.35, "timestamp": "01:09:57", "text": "好的。"}, {"type": "subtitle", "time": 4199.43, "timestamp": "01:09:59", "text": "然后我想，呃，然后我就杀了"}]
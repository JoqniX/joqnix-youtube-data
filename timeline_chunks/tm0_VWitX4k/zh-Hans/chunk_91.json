[{"type": "subtitle", "time": 5460.07, "timestamp": "01:31:00", "text": "所以它会教你如何扭动身体。"}, {"type": "subtitle", "time": 5462.39, "timestamp": "01:31:02", "text": "所以，他会来接你。"}, {"type": "subtitle", "time": 5465.99, "timestamp": "01:31:05", "text": "然后你就得像打靶一样完成这些部分。"}, {"type": "subtitle", "time": 5471.75, "timestamp": "01:31:11", "text": "但我还是不明白。我们为何如此"}, {"type": "subtitle", "time": 5474.95, "timestamp": "01:31:14", "text": "被困在这里了吗？"}, {"type": "subtitle", "time": 5476.87, "timestamp": "01:31:16", "text": "呃，所以基本上整个背景故事就像"}, {"type": "subtitle", "time": 5479.669, "timestamp": "01:31:19", "text": "DVD，有这么个实体"}, {"type": "subtitle", "time": 5484.07, "timestamp": "01:31:24", "text": "呃，而且某种实体已经困住了"}, {"type": "subtitle", "time": 5487.83, "timestamp": "01:31:27", "text": "呃，必须引诱这些杀手进来"}, {"type": "subtitle", "time": 5492.149, "timestamp": "01:31:32", "text": "喂它。呃，因为这个实体以……为食"}, {"type": "subtitle", "time": 5497.59, "timestamp": "01:31:37", "text": "嗯"}, {"type": "subtitle", "time": 5502.39, "timestamp": "01:31:42", "text": "我的天啊。他刚刚钓到鱼了。"}, {"type": "subtitle", "time": 5503.75, "timestamp": "01:31:43", "text": "这会让她上瘾的，然后"}, {"type": "subtitle", "time": 5505.27, "timestamp": "01:31:45", "text": "你会像拉车一样冲过去"}, {"type": "subtitle", "time": 5506.48, "timestamp": "01:31:46", "text": "钩子。"}, {"type": "subtitle", "time": 5507.99, "timestamp": "01:31:47", "text": "[音乐]"}, {"type": "subtitle", "time": 5514.229, "timestamp": "01:31:54", "text": "所以，整部法律基本上就是这个实体。"}, {"type": "subtitle", "time": 5517.43, "timestamp": "01:31:57", "text": "绑架幸存者，每个幸存者"}, {"type": "subtitle", "time": 5519.51, "timestamp": "01:31:59", "text": "它就像有自己的杀手。大多数幸存者"}]
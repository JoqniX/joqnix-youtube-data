[{"type": "subtitle", "time": 2881.91, "timestamp": "00:48:01", "text": "我的天啊。还有另一支队伍要来了。"}, {"type": "subtitle", "time": 2885.67, "timestamp": "00:48:05", "text": "来自另一支球队"}, {"type": "subtitle", "time": 2890.87, "timestamp": "00:48:10", "text": "事物。我们当时所在的笼子。是的。"}, {"type": "subtitle", "time": 2897.829, "timestamp": "00:48:17", "text": "呃"}, {"type": "subtitle", "time": 2900.23, "timestamp": "00:48:20", "text": "那 那"}, {"type": "subtitle", "time": 2903.03, "timestamp": "00:48:23", "text": "Octane 稍微反抗了一下。离开我的"}, {"type": "subtitle", "time": 2905.589, "timestamp": "00:48:25", "text": "盾牌。"}, {"type": "subtitle", "time": 2909.589, "timestamp": "00:48:29", "text": "不知道他们什么时候会来，但是"}, {"type": "subtitle", "time": 2911.349, "timestamp": "00:48:31", "text": "那边掉落的是什么？我是"}, {"type": "subtitle", "time": 2912.79, "timestamp": "00:48:32", "text": "好奇的。那边有个红色的东西"}, {"type": "subtitle", "time": 2914.309, "timestamp": "00:48:34", "text": "我其实有点好奇……"}, {"type": "subtitle", "time": 2938.63, "timestamp": "00:48:58", "text": "这边有红色发光的东西。和"}]
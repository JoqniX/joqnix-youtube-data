[{"type": "subtitle", "time": 122.709, "timestamp": "00:02:02", "text": "是的。好的。我认为我们只需要"}, {"type": "subtitle", "time": 125.03, "timestamp": "00:02:05", "text": "等它亮起来。等待，"}, {"type": "subtitle", "time": 128.1, "timestamp": "00:02:08", "text": "那边有东西。确实如此。"}, {"type": "subtitle", "time": 131.67, "timestamp": "00:02:11", "text": "[音乐]"}, {"type": "subtitle", "time": 133.43, "timestamp": "00:02:13", "text": "注意你的体力。它可以让你免于……"}, {"type": "subtitle", "time": 135.99, "timestamp": "00:02:15", "text": "垂死。所以，请确保您已妥善管理。"}, {"type": "subtitle", "time": 140.15, "timestamp": "00:02:20", "text": "正确。好的。关于实体八。哦"}, {"type": "subtitle", "time": 144.39, "timestamp": "00:02:24", "text": "不，这是人类和狗狗之间的那种关系。"}, {"type": "subtitle", "time": 152.309, "timestamp": "00:02:32", "text": "一种非常奇怪又可爱的生物"}, {"type": "subtitle", "time": 155.35, "timestamp": "00:02:35", "text": "有人看到鸭子从……中钻了出来"}, {"type": "subtitle", "time": 159.27, "timestamp": "00:02:39", "text": "在后面的房间里。这是心理学"}, {"type": "subtitle", "time": 161.43, "timestamp": "00:02:41", "text": "这是生理上的相似之处"}, {"type": "subtitle", "time": 164.22899999999998, "timestamp": "00:02:44", "text": "一只长着人形特征的鸭子。它是"}, {"type": "subtitle", "time": 166.63, "timestamp": "00:02:46", "text": "就像它以极其……而闻名一样"}, {"type": "subtitle", "time": 168.55, "timestamp": "00:02:48", "text": "具有攻击性和危险性，但它是"}, {"type": "subtitle", "time": 171.91, "timestamp": "00:02:51", "text": "受噪音困扰，并被……吓倒"}, {"type": "subtitle", "time": 174.309, "timestamp": "00:02:54", "text": "直接眼神交流。"}, {"type": "subtitle", "time": 176.63, "timestamp": "00:02:56", "text": "当你看着它的脸，它的脸"}, {"type": "subtitle", "time": 179.27, "timestamp": "00:02:59", "text": "要聪明点。跑步的时候有时候"}]
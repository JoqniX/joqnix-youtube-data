[{"type": "subtitle", "time": 12121.269, "timestamp": "03:22:01", "text": "可发现性或其他方面"}, {"type": "subtitle", "time": 12123.349, "timestamp": "03:22:03", "text": "一切是为了让人们知道什么"}, {"type": "subtitle", "time": 12126.469, "timestamp": "03:22:06", "text": "你正在谈论某件事"}, {"type": "subtitle", "time": 12128.469, "timestamp": "03:22:08", "text": "还有一些其他的东西。我懂了。我之前做过这个"}, {"type": "subtitle", "time": 12132.07, "timestamp": "03:22:12", "text": "这是我的处女作。此外，很多人也不"}, {"type": "subtitle", "time": 12136.55, "timestamp": "03:22:16", "text": "真的有那么频繁地使用它吗？我认为"}, {"type": "subtitle", "time": 12138.71, "timestamp": "03:22:18", "text": "人们确实会进行自我推销。我不"}, {"type": "subtitle", "time": 12141.51, "timestamp": "03:22:21", "text": "认为人们会直接出现在那里，"}, {"type": "subtitle", "time": 12147.67, "timestamp": "03:22:27", "text": "[音乐]"}, {"type": "subtitle", "time": 12150.95, "timestamp": "03:22:30", "text": "Zuriku 排在最前面。什么？是的，"}, {"type": "subtitle", "time": 12153.67, "timestamp": "03:22:33", "text": "她在那里。是的。"}, {"type": "subtitle", "time": 12156.87, "timestamp": "03:22:36", "text": "只有像星期五一样的最高位置，六月。"}, {"type": "subtitle", "time": 12159.51, "timestamp": "03:22:39", "text": "是的。"}, {"type": "subtitle", "time": 12162.55, "timestamp": "03:22:42", "text": "所以，是的，它会持续到……"}, {"type": "subtitle", "time": 12165.67, "timestamp": "03:22:45", "text": "2020年3月。"}, {"type": "subtitle", "time": 12167.349, "timestamp": "03:22:47", "text": "所以，我每天都会直播。"}, {"type": "subtitle", "time": 12169.99, "timestamp": "03:22:49", "text": "到那天为止还有24小时。我想我会"}, {"type": "subtitle", "time": 12173.91, "timestamp": "03:22:53", "text": "别紧张。是的，"}, {"type": "subtitle", "time": 12175.91, "timestamp": "03:22:55", "text": "我不知道。我回不到正常状态了。"}, {"type": "subtitle", "time": 12179.429, "timestamp": "03:22:59", "text": "不过，流媒体还是有的。我的身体也感觉啊。"}]
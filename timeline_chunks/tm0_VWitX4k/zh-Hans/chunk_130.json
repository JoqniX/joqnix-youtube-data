[{"type": "subtitle", "time": 7801.27, "timestamp": "02:10:01", "text": "是的。你好。哦亲爱的。你好吗？"}, {"type": "subtitle", "time": 7804.149, "timestamp": "02:10:04", "text": "你看，我的叔叔罗兰，他相当"}, {"type": "subtitle", "time": 7806.39, "timestamp": "02:10:06", "text": "在哥布林社群中颇有名气。他"}, {"type": "subtitle", "time": 7808.79, "timestamp": "02:10:08", "text": "他通常在外出的时候派我出去。"}, {"type": "subtitle", "time": 7811.43, "timestamp": "02:10:11", "text": "商务旅行。在他最后一只猫头鹰里，他"}, {"type": "subtitle", "time": 7813.189, "timestamp": "02:10:13", "text": "暗示与那些激进分子打交道"}, {"type": "subtitle", "time": 7816.709, "timestamp": "02:10:16", "text": "哥布林。激进的哥布林。哦，已经很久了。"}, {"type": "subtitle", "time": 7818.87, "timestamp": "02:10:18", "text": "自从上次见到那只猫头鹰已经过去很久了，我很担心。"}, {"type": "subtitle", "time": 7821.189, "timestamp": "02:10:21", "text": "关于谣言的网络攻击"}, {"type": "subtitle", "time": 7823.109, "timestamp": "02:10:23", "text": "难道是地精参与其中？经过"}, {"type": "subtitle", "time": 7824.87, "timestamp": "02:10:24", "text": "我一直在尝试用这种方法"}, {"type": "subtitle", "time": 7827.589, "timestamp": "02:10:27", "text": "最近有了些新东西。你想看吗？"}, {"type": "subtitle", "time": 7831.35, "timestamp": "02:10:31", "text": "大概是这样的。"}, {"type": "subtitle", "time": 7833.589, "timestamp": "02:10:33", "text": "大概会是这样的样子。集中注意力"}, {"type": "subtitle", "time": 7837.03, "timestamp": "02:10:37", "text": "在我的模型上停留了一秒钟。好的。它看起来"}, {"type": "subtitle", "time": 7840.229, "timestamp": "02:10:40", "text": "像这样。 D 我会的，我真的可以得到"}, {"type": "subtitle", "time": 7843.03, "timestamp": "02:10:43", "text": "像素化。"}, {"type": "subtitle", "time": 7846.31, "timestamp": "02:10:46", "text": "看看这个。这是像素级的工作，我可以"}, {"type": "subtitle", "time": 7849.589, "timestamp": "02:10:49", "text": "四处走动，制作不同的版本"}, {"type": "subtitle", "time": 7852.149, "timestamp": "02:10:52", "text": "是我。"}]
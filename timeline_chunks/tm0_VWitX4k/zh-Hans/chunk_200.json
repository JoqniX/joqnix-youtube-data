[{"type": "subtitle", "time": 12001.51, "timestamp": "03:20:01", "text": "今年已取消。所以每个人都有"}, {"type": "subtitle", "time": 12004.55, "timestamp": "03:20:04", "text": "延续来年的新鲜感"}, {"type": "subtitle", "time": 12008.469, "timestamp": "03:20:08", "text": "就像从四月份开始的那批一样。"}, {"type": "subtitle", "time": 12010.55, "timestamp": "03:20:10", "text": "将是新的一年，也就是两年后。"}, {"type": "subtitle", "time": 12014.389, "timestamp": "03:20:14", "text": "对，所以七月份那批学生将是……一年级九年级"}, {"type": "subtitle", "time": 12018.63, "timestamp": "03:20:18", "text": "几个月后，十月份的批次将会是……呃，我"}, {"type": "subtitle", "time": 12023.19, "timestamp": "03:20:23", "text": "想想大概一年半左右吧"}, {"type": "subtitle", "time": 12025.75, "timestamp": "03:20:25", "text": "是的，那么12月份那批货就是9号。"}, {"type": "subtitle", "time": 12028.15, "timestamp": "03:20:28", "text": "几个月之类的"}, {"type": "subtitle", "time": 12030.309, "timestamp": "03:20:30", "text": "大概就是这样，他们就是这样。"}, {"type": "subtitle", "time": 12032.309, "timestamp": "03:20:32", "text": "问题是……"}, {"type": "subtitle", "time": 12034.95, "timestamp": "03:20:34", "text": "所以我去是为了让人们觉得"}, {"type": "subtitle", "time": 12037.59, "timestamp": "03:20:37", "text": "他们会优先考虑七月份的事情。"}, {"type": "subtitle", "time": 12041.03, "timestamp": "03:20:41", "text": "摄入量对人群有影响。是的，所以……"}, {"type": "subtitle", "time": 12043.67, "timestamp": "03:20:43", "text": "将于四月份入学时寄出。所以"}, {"type": "subtitle", "time": 12045.99, "timestamp": "03:20:45", "text": "正因为如此，我才没有"}, {"type": "subtitle", "time": 12050.07, "timestamp": "03:20:50", "text": "达到了所需的目标"}, {"type": "subtitle", "time": 12053.75, "timestamp": "03:20:53", "text": "模型的所有绑定和相关工作。嗯"}, {"type": "subtitle", "time": 12057.19, "timestamp": "03:20:57", "text": "虽然索具工和索具工以及呃"}]
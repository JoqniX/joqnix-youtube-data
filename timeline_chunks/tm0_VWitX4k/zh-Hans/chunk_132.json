[{"type": "subtitle", "time": 7921.91, "timestamp": "02:12:01", "text": "你好呀。我就是那个像素控。"}, {"type": "subtitle", "time": 7923.669, "timestamp": "02:12:03", "text": "可能遇到麻烦了。你比这更出色"}, {"type": "subtitle", "time": 7926.149, "timestamp": "02:12:06", "text": "明白了，韦斯莱教授。听到"}, {"type": "subtitle", "time": 7928.55, "timestamp": "02:12:08", "text": "我本来打算禁止我这样做。"}, {"type": "subtitle", "time": 7930.709, "timestamp": "02:12:10", "text": "很酷。我喜欢这个。确信"}, {"type": "subtitle", "time": 7933.03, "timestamp": "02:12:13", "text": "他能照顾好自己。看来我是我的"}, {"type": "subtitle", "time": 7934.95, "timestamp": "02:12:14", "text": "拥有自己的 Minecraft 皮肤之类的东西。他是"}, {"type": "subtitle", "time": 7938.709, "timestamp": "02:12:18", "text": "好的。我没有像素皮肤之类的东西。"}, {"type": "subtitle", "time": 7941.83, "timestamp": "02:12:21", "text": "试着找到你看到的那个a"}, {"type": "subtitle", "time": 7945.35, "timestamp": "02:12:25", "text": "蓝眼睛，还有蓝眼睛和紫色"}, {"type": "subtitle", "time": 7947.83, "timestamp": "02:12:27", "text": "中间有一只眼睛。是的，那些是我的"}, {"type": "subtitle", "time": 7956.47, "timestamp": "02:12:36", "text": "我看不出我能学到什么。谢谢。"}, {"type": "subtitle", "time": 7958.55, "timestamp": "02:12:38", "text": "他非常……所以，是的，就是这样。"}, {"type": "subtitle", "time": 7960.79, "timestamp": "02:12:40", "text": "我当时在做实验。"}, {"type": "subtitle", "time": 7963.109, "timestamp": "02:12:43", "text": "最近。事实上，在他生命的最后时刻，他"}, {"type": "subtitle", "time": 7965.189, "timestamp": "02:12:45", "text": "吸引我。你知道，事实是我确实会"}, {"type": "subtitle", "time": 7968.629, "timestamp": "02:12:48", "text": "做几个实验。我做新的"}, {"type": "subtitle", "time": 7971.589, "timestamp": "02:12:51", "text": "东西。但问题是，这就像……"}, {"type": "subtitle", "time": 7973.189, "timestamp": "02:12:53", "text": "如何"}, {"type": "subtitle", "time": 7975.99, "timestamp": "02:12:55", "text": "呃，怎么……呃"}, {"type": "subtitle", "time": 7978.95, "timestamp": "02:12:58", "text": "你把它调整到合适的位置。出事了。"}]
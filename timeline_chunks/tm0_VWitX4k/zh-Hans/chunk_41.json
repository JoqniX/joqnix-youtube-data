[{"type": "subtitle", "time": 2467.109, "timestamp": "00:41:07", "text": "他们需要制作类似的服装。"}, {"type": "subtitle", "time": 2469.91, "timestamp": "00:41:09", "text": "游戏中的角色。"}, {"type": "subtitle", "time": 2473.349, "timestamp": "00:41:13", "text": "哦，结果就像预感一样。"}, {"type": "subtitle", "time": 2476.069, "timestamp": "00:41:16", "text": "以及获胜的服装，还有其中之一"}, {"type": "subtitle", "time": 2477.91, "timestamp": "00:41:17", "text": "其他服装是由其中一位制作的"}, {"type": "subtitle", "time": 2481.19, "timestamp": "00:41:21", "text": "创作者们将被安排到一个组里。"}, {"type": "subtitle", "time": 2483.349, "timestamp": "00:41:23", "text": "我有点兴奋，因为我看到"}, {"type": "subtitle", "time": 2487.349, "timestamp": "00:41:27", "text": "这套猎人服装真是太棒了。"}, {"type": "subtitle", "time": 2489.51, "timestamp": "00:41:29", "text": "啊，"}, {"type": "subtitle", "time": 2491.829, "timestamp": "00:41:31", "text": "但有很多类似“下面”的东西"}, {"type": "subtitle", "time": 2493.77, "timestamp": "00:41:33", "text": "胸部"}, {"type": "subtitle", "time": 2496.79, "timestamp": "00:41:36", "text": "[音乐]"}, {"type": "subtitle", "time": 2509.8, "timestamp": "00:41:49", "text": "一点也不无聊。"}, {"type": "subtitle", "time": 2512.069, "timestamp": "00:41:52", "text": "[音乐]"}, {"type": "subtitle", "time": 2515.349, "timestamp": "00:41:55", "text": "是啊，大家都离得太远了。你好吗？"}, {"type": "subtitle", "time": 2517.99, "timestamp": "00:41:57", "text": "正在搜索？"}]
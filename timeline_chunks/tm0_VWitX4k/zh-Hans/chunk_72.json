[{"type": "subtitle", "time": 4327.75, "timestamp": "01:12:07", "text": "TNB倒塌就像那样"}, {"type": "subtitle", "time": 4330.95, "timestamp": "01:12:10", "text": "突袭皮肤，就像特工或"}, {"type": "subtitle", "time": 4332.95, "timestamp": "01:12:12", "text": "某物。我忘了。"}, {"type": "subtitle", "time": 4334.149, "timestamp": "01:12:14", "text": "是的，我知道你在说哪个。"}, {"type": "subtitle", "time": 4337.35, "timestamp": "01:12:17", "text": "关于。这是个愚蠢的问题。我是谁？"}, {"type": "subtitle", "time": 4340.47, "timestamp": "01:12:20", "text": "我是小孩吗，我可以说脏话吗？"}, {"type": "subtitle", "time": 4341.99, "timestamp": "01:12:21", "text": "H"}, {"type": "subtitle", "time": 4344.229, "timestamp": "01:12:24", "text": "我是小孩，可以骂脏话吗？是的。是的。感觉"}, {"type": "subtitle", "time": 4346.709, "timestamp": "01:12:26", "text": "做你自己。不用担心。好的。"}, {"type": "subtitle", "time": 4348.47, "timestamp": "01:12:28", "text": "好的。好的。我只是经常说脏话。他们"}, {"type": "subtitle", "time": 4349.83, "timestamp": "01:12:29", "text": "不想因为……而毁了一套西装"}, {"type": "subtitle", "time": 4351.59, "timestamp": "01:12:31", "text": "这是脏话。哦，不。不，不，全都这样了。"}, {"type": "subtitle", "time": 4354.55, "timestamp": "01:12:34", "text": "好的。一切都好。"}, {"type": "subtitle", "time": 4365.11, "timestamp": "01:12:45", "text": "我来。我来。我来。"}, {"type": "subtitle", "time": 4367.51, "timestamp": "01:12:47", "text": "好的。该死。他们好像都喜欢我。"}, {"type": "subtitle", "time": 4369.99, "timestamp": "01:12:49", "text": "他们拥有一支完整的坦克部队，"}, {"type": "subtitle", "time": 4378.63, "timestamp": "01:12:58", "text": "所以，下面提到的就是一点。"}]
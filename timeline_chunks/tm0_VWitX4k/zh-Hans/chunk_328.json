[{"type": "subtitle", "time": 19681.83, "timestamp": "05:28:01", "text": "如何邀请派对？我该如何添加他？"}, {"type": "subtitle", "time": 19684.39, "timestamp": "05:28:04", "text": "作为朋友？"}, {"type": "subtitle", "time": 19686.788, "timestamp": "05:28:06", "text": "只需按下 Esc 键，你就能找到他。"}, {"type": "subtitle", "time": 19688.72, "timestamp": "05:28:08", "text": "用户名和这些人。"}, {"type": "subtitle", "time": 19706.628, "timestamp": "05:28:26", "text": "好了，我们走吧。我们是什么？我们是谁？"}, {"type": "subtitle", "time": 19708.15, "timestamp": "05:28:28", "text": "正在做？"}, {"type": "subtitle", "time": 19709.83, "timestamp": "05:28:29", "text": "就像我们必须站在这些上面一样"}, {"type": "subtitle", "time": 19711.99, "timestamp": "05:28:31", "text": "盘子。"}, {"type": "subtitle", "time": 19715.19, "timestamp": "05:28:35", "text": "哦，一两个吧。一对一 v3。"}, {"type": "subtitle", "time": 19718.948, "timestamp": "05:28:38", "text": "一个 v3。哦，等等。呃，三个人。你"}, {"type": "subtitle", "time": 19724.15, "timestamp": "05:28:44", "text": "可以做一个 v2。一对一一对一一对一"}, {"type": "subtitle", "time": 19727.19, "timestamp": "05:28:47", "text": "就像 FFA 一样。"}, {"type": "subtitle", "time": 19730.31, "timestamp": "05:28:50", "text": "你想参加常规的自由竞争（FFA）吗？为此"}, {"type": "subtitle", "time": 19733.19, "timestamp": "05:28:53", "text": "我们需要一个BNA党，对吧？"}, {"type": "subtitle", "time": 19735.91, "timestamp": "05:28:55", "text": "等等，让我把你加进去。"}, {"type": "subtitle", "time": 19738.47, "timestamp": "05:28:58", "text": "到"}]
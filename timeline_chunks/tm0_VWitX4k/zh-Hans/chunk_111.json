[{"type": "subtitle", "time": 6662.39, "timestamp": "01:51:02", "text": "那里有个像鬼魂一样的东西。"}, {"type": "subtitle", "time": 6664.629, "timestamp": "01:51:04", "text": "是的。是的。所以，凶手是鬼魂。"}, {"type": "subtitle", "time": 6674.55, "timestamp": "01:51:14", "text": "他似乎确实是。"}, {"type": "subtitle", "time": 6677.43, "timestamp": "01:51:17", "text": "是的，他正坐在我身上。"}, {"type": "subtitle", "time": 6680.629, "timestamp": "01:51:20", "text": "可能来不了。请告诉我"}, {"type": "subtitle", "time": 6684.31, "timestamp": "01:51:24", "text": "如果有什么好的叶子的话。"}, {"type": "subtitle", "time": 6686.55, "timestamp": "01:51:26", "text": "嗯，"}, {"type": "subtitle", "time": 6688.87, "timestamp": "01:51:28", "text": "问题是我不能……哦，他是……他是……"}, {"type": "subtitle", "time": 6689.99, "timestamp": "01:51:29", "text": "正朝你走来。他正朝这边走来"}, {"type": "subtitle", "time": 6696.55, "timestamp": "01:51:36", "text": "哦，他现在正朝你走来。是的，他是"}, {"type": "subtitle", "time": 6699.51, "timestamp": "01:51:39", "text": "正朝你走来。所以，他，他，呃，他"}, {"type": "subtitle", "time": 6700.709, "timestamp": "01:51:40", "text": "可能没法来找我，所以就试试吧。"}, {"type": "subtitle", "time": 6704.07, "timestamp": "01:51:44", "text": "逃跑。是的，那场战斗"}, {"type": "subtitle", "time": 6707.35, "timestamp": "01:51:47", "text": "音乐响起。我的天啊。是的。是的，"}, {"type": "subtitle", "time": 6709.669, "timestamp": "01:51:49", "text": "因为他就在你附近。是的。所以，呃……"}, {"type": "subtitle", "time": 6711.27, "timestamp": "01:51:51", "text": "这是很棒的追逐音乐。幸运的是，这是一个"}, {"type": "subtitle", "time": 6713.43, "timestamp": "01:51:53", "text": "良好的指标。他在露营。他是。"}]
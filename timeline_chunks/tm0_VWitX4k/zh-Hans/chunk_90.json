[{"type": "subtitle", "time": 5400.629, "timestamp": "01:30:00", "text": "对吧？你必须把握好时机。"}, {"type": "subtitle", "time": 5402.79, "timestamp": "01:30:02", "text": "哦，是的。是的。很多很多很多"}, {"type": "subtitle", "time": 5409.189, "timestamp": "01:30:09", "text": "你不必得到白色的那部分"}, {"type": "subtitle", "time": 5412.59, "timestamp": "01:30:12", "text": "它。你只需要拿到那句话。"}, {"type": "subtitle", "time": 5428.149, "timestamp": "01:30:28", "text": "修理末级发电机。"}, {"type": "subtitle", "time": 5430.07, "timestamp": "01:30:30", "text": "你被抓住了。"}, {"type": "subtitle", "time": 5438.39, "timestamp": "01:30:38", "text": "哦，那些杀人信。是的，但是哦"}, {"type": "subtitle", "time": 5441.75, "timestamp": "01:30:41", "text": "我的上帝。找到凶手了。是的。所以"}, {"type": "subtitle", "time": 5443.51, "timestamp": "01:30:43", "text": "这个杀手，所以这表明你喜欢表演"}, {"type": "subtitle", "time": 5445.59, "timestamp": "01:30:45", "text": "你喜欢杀手们能做的事吗？"}, {"type": "subtitle", "time": 5447.27, "timestamp": "01:30:47", "text": "所有这些。"}]
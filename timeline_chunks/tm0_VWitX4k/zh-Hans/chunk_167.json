[{"type": "subtitle", "time": 10020.95, "timestamp": "02:47:00", "text": "当然。哦，对了，学院的人是"}, {"type": "subtitle", "time": 10024.63, "timestamp": "02:47:04", "text": "就像我之前那样，我告诉他们，嗯，嗯。"}, {"type": "subtitle", "time": 10027.91, "timestamp": "02:47:07", "text": "因为呃，我本来打算买一台笔记本电脑。"}, {"type": "subtitle", "time": 10031.75, "timestamp": "02:47:11", "text": "来自日本之类的东西。嗯，是的，然后他们"}, {"type": "subtitle", "time": 10034.07, "timestamp": "02:47:14", "text": "就像我们有来自各地的人一样"}, {"type": "subtitle", "time": 10036.55, "timestamp": "02:47:16", "text": "日本和印度之间会不时往来，所以我们可以"}, {"type": "subtitle", "time": 10039.51, "timestamp": "02:47:19", "text": "找个像你知道的那种人买下"}, {"type": "subtitle", "time": 10041.91, "timestamp": "02:47:21", "text": "从那里帮你拿一台笔记本电脑过来。"}, {"type": "subtitle", "time": 10044.309, "timestamp": "02:47:24", "text": "这样我就可以设置了。"}, {"type": "subtitle", "time": 10047.99, "timestamp": "02:47:27", "text": "现在一切都结束了。是啊，我当时就想，我的天哪"}, {"type": "subtitle", "time": 10051.269, "timestamp": "02:47:31", "text": "上帝啊，请帮助我，请帮助我。"}, {"type": "subtitle", "time": 10053.91, "timestamp": "02:47:33", "text": "很多，但是"}, {"type": "subtitle", "time": 10057.67, "timestamp": "02:47:37", "text": "那太好了。我最初的计划是"}, {"type": "subtitle", "time": 10061.349, "timestamp": "02:47:41", "text": "现在，嗯，拿我的硬盘来说，就是固态硬盘（SSD）。"}, {"type": "subtitle", "time": 10064.79, "timestamp": "02:47:44", "text": "用力把它放进行李箱里。"}, {"type": "subtitle", "time": 10067.83, "timestamp": "02:47:47", "text": "是的。那是因为现在是笔记本电脑了。"}, {"type": "subtitle", "time": 10070.87, "timestamp": "02:47:50", "text": "必须购买外部设备"}, {"type": "subtitle", "time": 10073.75, "timestamp": "02:47:53", "text": "固态硬盘。嗯，存储空间有点……"}, {"type": "subtitle", "time": 10075.349, "timestamp": "02:47:55", "text": "昂贵的。"}]
[{"type": "subtitle", "time": 12060.389, "timestamp": "03:21:00", "text": "绑定师和美术师的工作已经全部完成了。我"}, {"type": "subtitle", "time": 12064.07, "timestamp": "03:21:04", "text": "意思是索具工需要启动那个东西。"}, {"type": "subtitle", "time": 12067.03, "timestamp": "03:21:07", "text": "艺术方面的工作已经完成了。所以他们就像"}, {"type": "subtitle", "time": 12070.229, "timestamp": "03:21:10", "text": "准备好了，准备动手。是的，他们就像"}, {"type": "subtitle", "time": 12073.59, "timestamp": "03:21:13", "text": "他们已经准备好了，但是他们做不到。"}, {"type": "subtitle", "time": 12075.75, "timestamp": "03:21:15", "text": "因为我必须支付那笔巨款"}, {"type": "subtitle", "time": 12077.91, "timestamp": "03:21:17", "text": "钱，对吧？我心想，我没有"}, {"type": "subtitle", "time": 12082.55, "timestamp": "03:21:22", "text": "一。昂贵的。是的。"}, {"type": "subtitle", "time": 12087.349, "timestamp": "03:21:27", "text": "所以，哦，你向我比了个V字手势。"}, {"type": "subtitle", "time": 12089.19, "timestamp": "03:21:29", "text": "你确实提到了印度。我不记得了。"}, {"type": "subtitle", "time": 12093.349, "timestamp": "03:21:33", "text": "我曾经有过。它在印度。是的。印地语"}, {"type": "subtitle", "time": 12096.469, "timestamp": "03:21:36", "text": "语言。不，很好。好的。是的。我曾经"}, {"type": "subtitle", "time": 12099.75, "timestamp": "03:21:39", "text": "告诉大家我觉得是的，我"}, {"type": "subtitle", "time": 12102.87, "timestamp": "03:21:42", "text": "我想我最初制作的时候是这么想的"}, {"type": "subtitle", "time": 12104.71, "timestamp": "03:21:44", "text": "明星、普通人和其他人没有其他"}, {"type": "subtitle", "time": 12107.11, "timestamp": "03:21:47", "text": "印度的 YouTuber 并不怎么用这个，所以"}, {"type": "subtitle", "time": 12109.67, "timestamp": "03:21:49", "text": "我当时就像这个网站一样，然后我大声喊了出来"}, {"type": "subtitle", "time": 12113.75, "timestamp": "03:21:53", "text": "然后我问沙兰，星星们"}, {"type": "subtitle", "time": 12116.469, "timestamp": "03:21:56", "text": "就像，是的，把自己放进去，你必须这样做。"}, {"type": "subtitle", "time": 12118.469, "timestamp": "03:21:58", "text": "参与其中，你就能获得"}]
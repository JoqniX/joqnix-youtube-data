[{"type": "subtitle", "time": 4682.709, "timestamp": "01:18:02", "text": "我们或许能够阻止这一切。"}, {"type": "subtitle", "time": 4685.99, "timestamp": "01:18:05", "text": "护盾已耗尽。正在充电。"}, {"type": "subtitle", "time": 4687.11, "timestamp": "01:18:07", "text": "他们正在和别人交战。所以，我们"}, {"type": "subtitle", "time": 4689.35, "timestamp": "01:18:09", "text": "绝对可以打赢这场仗。维修"}, {"type": "subtitle", "time": 4691.03, "timestamp": "01:18:11", "text": "损害。我想知道我们会发现什么。"}, {"type": "subtitle", "time": 4693.75, "timestamp": "01:18:13", "text": "那里。好的。"}, {"type": "subtitle", "time": 4695.03, "timestamp": "01:18:15", "text": "所以，因为他们正在向某人开枪。"}, {"type": "subtitle", "time": 4697.91, "timestamp": "01:18:17", "text": "否则，我们就明白了。"}, {"type": "subtitle", "time": 4699.35, "timestamp": "01:18:19", "text": "他们以为我们要离开，但实际上"}, {"type": "subtitle", "time": 4702.79, "timestamp": "01:18:22", "text": "实际上，我们现在就要去见他们。"}]
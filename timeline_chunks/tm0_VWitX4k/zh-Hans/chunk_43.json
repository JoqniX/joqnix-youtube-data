[{"type": "subtitle", "time": 2581.03, "timestamp": "00:43:01", "text": "我想应该就这些了。我不太确定。我"}, {"type": "subtitle", "time": 2613.27, "timestamp": "00:43:33", "text": "我们过去吧。是的。我们走吧。"}, {"type": "subtitle", "time": 2628.23, "timestamp": "00:43:48", "text": "那么，你最喜欢的经纪人是谁？呃，不是经纪人。"}, {"type": "subtitle", "time": 2631.75, "timestamp": "00:43:51", "text": "呃，传奇人物是沃森，对吧？沃森。"}, {"type": "subtitle", "time": 2635.51, "timestamp": "00:43:55", "text": "绝对地。是的。我太喜欢沃森了。"}, {"type": "subtitle", "time": 2636.87, "timestamp": "00:43:56", "text": "不知道是怎么回事。不知道"}, {"type": "subtitle", "time": 2639.27, "timestamp": "00:43:59", "text": "比如为什么我根本不用她的能力。"}]
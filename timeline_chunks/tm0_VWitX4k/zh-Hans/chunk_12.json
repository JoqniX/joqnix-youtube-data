[{"type": "subtitle", "time": 723.11, "timestamp": "00:12:03", "text": "就像恐怖电影一样，我觉得"}, {"type": "subtitle", "time": 725.19, "timestamp": "00:12:05", "text": "我最喜欢的是，这其实不算恐怖片。"}, {"type": "subtitle", "time": 729.269, "timestamp": "00:12:09", "text": "猜猜我最喜欢的恐怖片是什么样的"}, {"type": "subtitle", "time": 733.43, "timestamp": "00:12:13", "text": "电影《电锯惊魂》就像我真的很喜欢的那种。"}, {"type": "subtitle", "time": 736.069, "timestamp": "00:12:16", "text": "嗯。"}, {"type": "subtitle", "time": 740.47, "timestamp": "00:12:20", "text": "所以我想我还没看过。"}, {"type": "subtitle", "time": 742.71, "timestamp": "00:12:22", "text": "有点血腥。非常血腥。它是"}, {"type": "subtitle", "time": 747.269, "timestamp": "00:12:27", "text": "说实话，这片子非常血腥。是"}, {"type": "subtitle", "time": 749.35, "timestamp": "00:12:29", "text": "就是那个拿着电锯的家伙，他试图"}, {"type": "subtitle", "time": 751.11, "timestamp": "00:12:31", "text": "杀了你之类的？它有一把锯子"}, {"type": "subtitle", "time": 753.35, "timestamp": "00:12:33", "text": "以名称为名。"}, {"type": "subtitle", "time": 755.509, "timestamp": "00:12:35", "text": "我觉得，我觉得那是电锯"}, {"type": "subtitle", "time": 757.03, "timestamp": "00:12:37", "text": "屠杀。故事大概是这样的"}, {"type": "subtitle", "time": 760.15, "timestamp": "00:12:40", "text": "就像一个老头子，他有这样的"}, {"type": "subtitle", "time": 763.99, "timestamp": "00:12:43", "text": "这个木娃娃，他把它弄坏了。"}, {"type": "subtitle", "time": 765.509, "timestamp": "00:12:45", "text": "像我这样投入的人真漂亮"}, {"type": "subtitle", "time": 768.71, "timestamp": "00:12:48", "text": "令人发指的罪行，以及诸如陷阱之类的东西"}, {"type": "subtitle", "time": 771.269, "timestamp": "00:12:51", "text": "还有一些东西，比如拼图之类的，他们有"}, {"type": "subtitle", "time": 775.11, "timestamp": "00:12:55", "text": "就像失去一样，为了得到另一样东西而失去一样东西。"}, {"type": "subtitle", "time": 778.15, "timestamp": "00:12:58", "text": "啊，就像你知道的，其中一个就是"}]
[{"type": "subtitle", "time": 961.43, "timestamp": "00:16:01", "text": "它在"}, {"type": "subtitle", "time": 965.43, "timestamp": "00:16:05", "text": "战利品箱。圣。"}, {"type": "subtitle", "time": 970.389, "timestamp": "00:16:10", "text": "我想我大概花了五千美元。"}, {"type": "subtitle", "time": 972.949, "timestamp": "00:16:12", "text": "在《英雄联盟》中。"}, {"type": "subtitle", "time": 976.31, "timestamp": "00:16:16", "text": "什么？什么？"}, {"type": "subtitle", "time": 977.91, "timestamp": "00:16:17", "text": "我玩英雄联盟才3年。"}, {"type": "subtitle", "time": 980.31, "timestamp": "00:16:20", "text": "年，所以这有点多了。"}, {"type": "subtitle", "time": 982.55, "timestamp": "00:16:22", "text": "比我预想的要多得多，你知道的。"}, {"type": "subtitle", "time": 990.069, "timestamp": "00:16:30", "text": "太疯狂了。"}, {"type": "subtitle", "time": 993.35, "timestamp": "00:16:33", "text": "嗯，我的确计算过我花了多少钱"}, {"type": "subtitle", "time": 996.87, "timestamp": "00:16:36", "text": "花费在 Valerant 上"}, {"type": "subtitle", "time": 1001.35, "timestamp": "00:16:41", "text": "而 Valerant 大约"}, {"type": "subtitle", "time": 1013.829, "timestamp": "00:16:53", "text": "那是"}, {"type": "subtitle", "time": 1015.829, "timestamp": "00:16:55", "text": "曾处于失业状态。所以，我刚刚"}]
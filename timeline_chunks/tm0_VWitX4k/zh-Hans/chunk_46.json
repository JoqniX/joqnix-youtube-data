[{"type": "subtitle", "time": 2760.87, "timestamp": "00:46:00", "text": "他们一直在发放各种礼包。"}, {"type": "subtitle", "time": 2776.15, "timestamp": "00:46:16", "text": "这是什么速度？我能看到我什么时候"}, {"type": "subtitle", "time": 2783.99, "timestamp": "00:46:23", "text": "它？所以，他们又加了一样东西。所以，为了保持"}, {"type": "subtitle", "time": 2787.51, "timestamp": "00:46:27", "text": "队员们团结在一起会更好，因为"}, {"type": "subtitle", "time": 2789.589, "timestamp": "00:46:29", "text": "显然，像 Octane 和 Wraith 这样的人"}, {"type": "subtitle", "time": 2790.87, "timestamp": "00:46:30", "text": "还有很多其他冠军也拥有"}, {"type": "subtitle", "time": 2793.109, "timestamp": "00:46:33", "text": "流动性，非常高的流动性。现在要保持"}, {"type": "subtitle", "time": 2795.19, "timestamp": "00:46:35", "text": "小队诱饵一起出现，他们增加了类似的东西"}, {"type": "subtitle", "time": 2798.55, "timestamp": "00:46:38", "text": "一个尝试的茎，就像每个人都能一样"}, {"type": "subtitle", "time": 2801.19, "timestamp": "00:46:41", "text": "赶上进度。你知道，你肯定"}, {"type": "subtitle", "time": 2803.589, "timestamp": "00:46:43", "text": "距离很远，就像你可以看着"}, {"type": "subtitle", "time": 2805.99, "timestamp": "00:46:45", "text": "你的队友，然后当那个圆圈出现时"}, {"type": "subtitle", "time": 2807.43, "timestamp": "00:46:47", "text": "填充后，你会得到类似这样的效果"}, {"type": "subtitle", "time": 2814.87, "timestamp": "00:46:54", "text": "那太酷了。只是想试试看而已"}, {"type": "subtitle", "time": 2818.79, "timestamp": "00:46:58", "text": "让大家待在一起。"}]
[{"type": "subtitle", "time": 9541.99, "timestamp": "02:39:01", "text": "嗯，老师就要开始了。"}, {"type": "subtitle", "time": 9544.95, "timestamp": "02:39:04", "text": "从下个月开始的N4课程。"}, {"type": "subtitle", "time": 9548.79, "timestamp": "02:39:08", "text": "也很有益处。 H"}, {"type": "subtitle", "time": 9551.349, "timestamp": "02:39:11", "text": "这对你也有好处。是的。"}, {"type": "subtitle", "time": 9553.99, "timestamp": "02:39:13", "text": "对我有利，因为学院的人"}, {"type": "subtitle", "time": 9557.03, "timestamp": "02:39:17", "text": "参加四月份活动的学生们说道"}, {"type": "subtitle", "time": 9561.349, "timestamp": "02:39:21", "text": "他们于去年四月入院，目前正遭受痛苦。"}, {"type": "subtitle", "time": 9563.59, "timestamp": "02:39:23", "text": "呃，因为他们全都失败了。"}, {"type": "subtitle", "time": 9567.67, "timestamp": "02:39:27", "text": "除了我以外，其他人都要参加NI考试。"}, {"type": "subtitle", "time": 9571.429, "timestamp": "02:39:31", "text": "是的，实际上他们都失败了。"}, {"type": "subtitle", "time": 9574.87, "timestamp": "02:39:34", "text": "我的上帝。是的，很难。"}, {"type": "subtitle", "time": 9577.59, "timestamp": "02:39:37", "text": "而且我也没怎么学习。我当时"}, {"type": "subtitle", "time": 9579.67, "timestamp": "02:39:39", "text": "我在钦奈的时候看了动漫"}, {"type": "subtitle", "time": 9581.67, "timestamp": "02:39:41", "text": "为了考试。"}, {"type": "subtitle", "time": 9585.03, "timestamp": "02:39:45", "text": "在看动漫吗？是的。"}, {"type": "subtitle", "time": 9589.59, "timestamp": "02:39:49", "text": "我的天啊。还有，呃，加上我爸爸的"}, {"type": "subtitle", "time": 9592.55, "timestamp": "02:39:52", "text": "他说，就像朋友之类的，就像"}, {"type": "subtitle", "time": 9594.79, "timestamp": "02:39:54", "text": "大学时代之类的，一直都有"}, {"type": "subtitle", "time": 9597.75, "timestamp": "02:39:57", "text": "钦奈。于是我们就去见了他，然后……"}]
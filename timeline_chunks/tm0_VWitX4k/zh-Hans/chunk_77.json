[{"type": "subtitle", "time": 4631.75, "timestamp": "01:17:11", "text": "你好。"}, {"type": "subtitle", "time": 4638.87, "timestamp": "01:17:18", "text": "轻松追上队友的方法。"}, {"type": "subtitle", "time": 4641.99, "timestamp": "01:17:21", "text": "三级。我可以拿走吗？"}, {"type": "subtitle", "time": 4644.55, "timestamp": "01:17:24", "text": "哦，你可以这样做。"}, {"type": "subtitle", "time": 4646.31, "timestamp": "01:17:26", "text": "是的。哦，我很高兴我没有完全……"}, {"type": "subtitle", "time": 4656.709, "timestamp": "01:17:36", "text": "呃，前面有一支队伍……"}, {"type": "subtitle", "time": 4658.55, "timestamp": "01:17:38", "text": "这栋楼。"}, {"type": "subtitle", "time": 4660.47, "timestamp": "01:17:40", "text": "我输了。"}, {"type": "subtitle", "time": 4663.669, "timestamp": "01:17:43", "text": "呃，我们应该继续推进吗？"}, {"type": "subtitle", "time": 4665.83, "timestamp": "01:17:45", "text": "嗯，不。疏散塔是一个不错的选择。"}, {"type": "subtitle", "time": 4669.83, "timestamp": "01:17:49", "text": "那么，我们来搞定这个疏散塔吧。"}, {"type": "subtitle", "time": 4671.83, "timestamp": "01:17:51", "text": "这是一个我不太清楚具体位置的地方"}, {"type": "subtitle", "time": 4674.149, "timestamp": "01:17:54", "text": "没错。这就是问题所在。哦，是的。哦"}, {"type": "subtitle", "time": 4676.709, "timestamp": "01:17:56", "text": "等待。我知道他们现在在哪里。"}, {"type": "subtitle", "time": 4678.55, "timestamp": "01:17:58", "text": "好的。"}]
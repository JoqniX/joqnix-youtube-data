[{"type": "subtitle", "time": 12300.55, "timestamp": "03:25:00", "text": "印度右翼。"}, {"type": "subtitle", "time": 12302.309, "timestamp": "03:25:02", "text": "是的，"}, {"type": "subtitle", "time": 12305.429, "timestamp": "03:25:05", "text": "有类似的视频。"}, {"type": "subtitle", "time": 12308.87, "timestamp": "03:25:08", "text": "而且这样的案例实在太多了。"}, {"type": "subtitle", "time": 12311.83, "timestamp": "03:25:11", "text": "感觉联系上有点困难。"}, {"type": "subtitle", "time": 12315.349, "timestamp": "03:25:15", "text": "就像大多数人都不怎么看电视一样"}, {"type": "subtitle", "time": 12319.429, "timestamp": "03:25:19", "text": "印度人就喜欢这样。"}, {"type": "subtitle", "time": 12325.59, "timestamp": "03:25:25", "text": "而且，也很难喜欢上它。"}, {"type": "subtitle", "time": 12328.12, "timestamp": "03:25:28", "text": "与异国肌肉有关"}, {"type": "subtitle", "time": 12344.63, "timestamp": "03:25:44", "text": "他们很擅长翻唱歌曲，"}, {"type": "subtitle", "time": 12347.59, "timestamp": "03:25:47", "text": "东西。那真不错。实际上，"}, {"type": "subtitle", "time": 12349.67, "timestamp": "03:25:49", "text": "他们有一个很棒的社区，可以提供帮助。"}]
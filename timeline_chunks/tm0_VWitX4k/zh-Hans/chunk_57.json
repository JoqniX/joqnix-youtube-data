[{"type": "subtitle", "time": 3420.15, "timestamp": "00:57:00", "text": "等等，我们这是在做梦吗？我以为我是"}, {"type": "subtitle", "time": 3421.75, "timestamp": "00:57:01", "text": "丢失的"}, {"type": "subtitle", "time": 3424.47, "timestamp": "00:57:04", "text": "我当时就像悬在空中一样，心想："}, {"type": "subtitle", "time": 3426.95, "timestamp": "00:57:06", "text": "我迷路了。所以，我得到了"}, {"type": "subtitle", "time": 3428.549, "timestamp": "00:57:08", "text": "它。我确实跑了。我猜对了。不，是"}, {"type": "subtitle", "time": 3430.39, "timestamp": "00:57:10", "text": "美好的。我对比赛结果没意见。"}, {"type": "subtitle", "time": 3438.15, "timestamp": "00:57:18", "text": "哦，原来只有你一个人。好的。"}, {"type": "subtitle", "time": 3440.47, "timestamp": "00:57:20", "text": "我是跳伞指挥官。我知道该去哪里"}, {"type": "subtitle", "time": 3442.15, "timestamp": "00:57:22", "text": "土地。我放弃。我不知道"}, {"type": "subtitle", "time": 3446.069, "timestamp": "00:57:26", "text": "在哪里降落？哦，是他啊。哦，"}, {"type": "subtitle", "time": 3448.789, "timestamp": "00:57:28", "text": "不错的热饮。"}, {"type": "subtitle", "time": 3450.63, "timestamp": "00:57:30", "text": "不，在热滴那边。我认为我们"}, {"type": "subtitle", "time": 3455.03, "timestamp": "00:57:35", "text": "没问题。是的，我们没事。团队"}, {"type": "subtitle", "time": 3457.109, "timestamp": "00:57:37", "text": "可能会落在另一边"}, {"type": "subtitle", "time": 3459.27, "timestamp": "00:57:39", "text": "边。夺回。敌人从空中落下"}, {"type": "subtitle", "time": 3471.589, "timestamp": "00:57:51", "text": "我的天，延迟并不严重。"}]
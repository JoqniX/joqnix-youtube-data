[{"type": "subtitle", "time": 9306.23, "timestamp": "02:35:06", "text": "我正在彻底清理这个地方。"}, {"type": "subtitle", "time": 9308.71, "timestamp": "02:35:08", "text": "到处都是哥布林"}, {"type": "subtitle", "time": 9320.07, "timestamp": "02:35:20", "text": "这肯定不是正确的方法。"}, {"type": "subtitle", "time": 9323.03, "timestamp": "02:35:23", "text": "必须走了，但是"}, {"type": "subtitle", "time": 9326.01, "timestamp": "02:35:26", "text": "是的"}, {"type": "subtitle", "time": 9335.91, "timestamp": "02:35:35", "text": "大家好，欢迎来到第二期"}, {"type": "subtitle", "time": 9338.63, "timestamp": "02:35:38", "text": "约顿的一部分"}, {"type": "subtitle", "time": 9343.03, "timestamp": "02:35:43", "text": "第二天。所以，我们这里有阿什"}, {"type": "subtitle", "time": 9348.389, "timestamp": "02:35:48", "text": "今天我们的嘉宾是谁？你好，Ash。"}, {"type": "subtitle", "time": 9353.83, "timestamp": "02:35:53", "text": "哦，不。你好。你好。你好，猫咪。希洛。"}, {"type": "subtitle", "time": 9357.03, "timestamp": "02:35:57", "text": "希洛。我好紧张。你为什么是"}, {"type": "subtitle", "time": 9359.429, "timestamp": "02:35:59", "text": "紧张的？"}]
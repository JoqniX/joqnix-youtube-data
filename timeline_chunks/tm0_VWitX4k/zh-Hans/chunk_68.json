[{"type": "subtitle", "time": 4080.549, "timestamp": "01:08:00", "text": "是为了让他能到达屋顶。"}, {"type": "subtitle", "time": 4082.789, "timestamp": "01:08:02", "text": "那真是太有趣了……"}, {"type": "subtitle", "time": 4094.069, "timestamp": "01:08:14", "text": "是的，他们就这么把它弄得这么突兀。"}, {"type": "subtitle", "time": 4096.07, "timestamp": "01:08:16", "text": "卫生巾好像不会再坏了。"}, {"type": "subtitle", "time": 4097.269, "timestamp": "01:08:17", "text": "以前好像有个冷却期"}, {"type": "subtitle", "time": 4100.309, "timestamp": "01:08:20", "text": "这些东西。啊，"}, {"type": "subtitle", "time": 4112.309, "timestamp": "01:08:32", "text": "我觉得那是某个人。那是人。"}, {"type": "subtitle", "time": 4130.95, "timestamp": "01:08:50", "text": "在我们上方。"}, {"type": "subtitle", "time": 4139.749, "timestamp": "01:08:59", "text": "我的天啊。"}]
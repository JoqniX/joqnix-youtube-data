[{"type": "subtitle", "time": 19864.948, "timestamp": "05:31:04", "text": "这是3对3的比赛。我不知道。哦，我们得到了"}, {"type": "subtitle", "time": 19866.708, "timestamp": "05:31:06", "text": "左轮手枪。"}, {"type": "subtitle", "time": 19869.59, "timestamp": "05:31:09", "text": "只需轻点一下即可。"}, {"type": "subtitle", "time": 19873.67, "timestamp": "05:31:13", "text": "继续发送垃圾邮件。哦，有人刚刚我哦，"}, {"type": "subtitle", "time": 19886.67, "timestamp": "05:31:26", "text": "他的枪法太好了。"}, {"type": "subtitle", "time": 19888.39, "timestamp": "05:31:28", "text": "[音乐]"}, {"type": "subtitle", "time": 19894.47, "timestamp": "05:31:34", "text": "我想我们也应该结伴而行。"}, {"type": "subtitle", "time": 19907.91, "timestamp": "05:31:47", "text": "抓到你了。让我直接狙击他们吧。"}, {"type": "subtitle", "time": 19915.51, "timestamp": "05:31:55", "text": "哦，我靠这玩意儿能滑翔多远呢？"}]
[{"type": "subtitle", "time": 11940.87, "timestamp": "03:19:00", "text": "显然是今年。哦，是的。你曾是我"}, {"type": "subtitle", "time": 11942.229, "timestamp": "03:19:02", "text": "不知道你有没有注意到我的"}, {"type": "subtitle", "time": 11944.309, "timestamp": "03:19:04", "text": "我在社区标签页上发布了公告"}, {"type": "subtitle", "time": 11947.83, "timestamp": "03:19:07", "text": "YouTube 和 Twitter，还有我的我的"}, {"type": "subtitle", "time": 11951.59, "timestamp": "03:19:11", "text": "官方网站也已上线。但是，嗯……"}, {"type": "subtitle", "time": 11956.469, "timestamp": "03:19:16", "text": "是的，我进军日本市场的情况"}, {"type": "subtitle", "time": 11959.03, "timestamp": "03:19:19", "text": "因印度巴基斯坦冲突而取消"}, {"type": "subtitle", "time": 11961.269, "timestamp": "03:19:21", "text": "东西和"}, {"type": "subtitle", "time": 11964.15, "timestamp": "03:19:24", "text": "呃，我不知道根本原因"}, {"type": "subtitle", "time": 11966.63, "timestamp": "03:19:26", "text": "但学院那边的人是这么说的。"}, {"type": "subtitle", "time": 11968.63, "timestamp": "03:19:28", "text": "因为就在这件事发生的时候"}, {"type": "subtitle", "time": 11973.67, "timestamp": "03:19:33", "text": "他们立刻就表示，呃，就像"}, {"type": "subtitle", "time": 11976.07, "timestamp": "03:19:36", "text": "向移民人员传达以下信息："}, {"type": "subtitle", "time": 11978.63, "timestamp": "03:19:38", "text": "是的，我们不，呃，不让，我们不，我们"}, {"type": "subtitle", "time": 11981.67, "timestamp": "03:19:41", "text": "不会派移民局的人去。"}, {"type": "subtitle", "time": 11984.55, "timestamp": "03:19:44", "text": "所以我觉得学院那边的人是这么说的。"}, {"type": "subtitle", "time": 11987.59, "timestamp": "03:19:47", "text": "影响即将入学的学生"}, {"type": "subtitle", "time": 11991.349, "timestamp": "03:19:51", "text": "十月份入学和十二月份入学。所以"}, {"type": "subtitle", "time": 11993.75, "timestamp": "03:19:53", "text": "它们就像完全抵消了一样。"}, {"type": "subtitle", "time": 11996.71, "timestamp": "03:19:56", "text": "就像其他两个进气口一样"}, {"type": "subtitle", "time": 11998.469, "timestamp": "03:19:58", "text": "七月。所以，三个摄入量正在增加。"}]
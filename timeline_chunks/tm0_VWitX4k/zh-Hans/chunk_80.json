[{"type": "subtitle", "time": 4805.51, "timestamp": "01:20:05", "text": "我的天啊。弹药充足，够用好几天。"}, {"type": "subtitle", "time": 4808.07, "timestamp": "01:20:08", "text": "是的。你要跟我回家。"}, {"type": "subtitle", "time": 4810.709, "timestamp": "01:20:10", "text": "今晚。结果我们得到了三个，而不是"}, {"type": "subtitle", "time": 4818.229, "timestamp": "01:20:18", "text": "因为我知道我还能再得到一个，所以我"}, {"type": "subtitle", "time": 4821.189, "timestamp": "01:20:21", "text": "打算试试能不能弄到瞄准镜。"}, {"type": "subtitle", "time": 4823.27, "timestamp": "01:20:23", "text": "好的。好的。"}, {"type": "subtitle", "time": 4834.709, "timestamp": "01:20:34", "text": "我们可以，我们可以战斗。我们可以，我们可以"}, {"type": "subtitle", "time": 4838.149, "timestamp": "01:20:38", "text": "斗争。我可以重做这件事。"}, {"type": "subtitle", "time": 4840.709, "timestamp": "01:20:40", "text": "这里。"}, {"type": "subtitle", "time": 4844.31, "timestamp": "01:20:44", "text": "后退。哦，该死。它们都裂了吗？"}, {"type": "subtitle", "time": 4847.59, "timestamp": "01:20:47", "text": "它们都很低吗？"}, {"type": "subtitle", "time": 4851.189, "timestamp": "01:20:51", "text": "一切疗愈都源于此。敌人就在这里。"}]
[{"type": "subtitle", "time": 10800.57, "timestamp": "03:00:00", "text": "对我来说，它就像一双袜子。"}, {"type": "subtitle", "time": 10806.469, "timestamp": "03:00:06", "text": "这是某种东西"}, {"type": "subtitle", "time": 10809.11, "timestamp": "03:00:09", "text": "普通的"}, {"type": "subtitle", "time": 10816.87, "timestamp": "03:00:16", "text": "现在这就像……"}, {"type": "subtitle", "time": 10820.55, "timestamp": "03:00:20", "text": "如果呃，如果像公司这样的机构成员"}, {"type": "subtitle", "time": 10822.63, "timestamp": "03:00:22", "text": "任何"}, {"type": "subtitle", "time": 10825.19, "timestamp": "03:00:25", "text": "嗯，毕业生们有很多规矩。"}, {"type": "subtitle", "time": 10827.99, "timestamp": "03:00:27", "text": "他们。是的。是的。公司那事儿，你知道的。"}, {"type": "subtitle", "time": 10830.71, "timestamp": "03:00:30", "text": "规矩真多。"}, {"type": "subtitle", "time": 10832.309, "timestamp": "03:00:32", "text": "是的。"}, {"type": "subtitle", "time": 10835.48, "timestamp": "03:00:35", "text": "太多事情了。"}, {"type": "subtitle", "time": 10837.269, "timestamp": "03:00:37", "text": "[音乐]"}, {"type": "subtitle", "time": 10840.71, "timestamp": "03:00:40", "text": "我的天哪，Kaf 出新歌了。我当时就想，"}, {"type": "subtitle", "time": 10845.349, "timestamp": "03:00:45", "text": "哇。等等，我把链接发给你。"}, {"type": "subtitle", "time": 10849.03, "timestamp": "03:00:49", "text": "等等，让我查一下。好的，让我来分享一下。"}, {"type": "subtitle", "time": 10852.07, "timestamp": "03:00:52", "text": "这是深魔工作室的作品之一，"}, {"type": "subtitle", "time": 10855.83, "timestamp": "03:00:55", "text": "主要人物喜欢他们给予投入"}, {"type": "subtitle", "time": 10857.59, "timestamp": "03:00:57", "text": "我想，更多的钱，呃，还有其他一些东西。"}]
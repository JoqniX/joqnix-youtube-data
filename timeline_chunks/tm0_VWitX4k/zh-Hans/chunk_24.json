[{"type": "subtitle", "time": 1440.71, "timestamp": "00:24:00", "text": "就像银子变成金子一样，你知道吗？金子"}, {"type": "subtitle", "time": 1442.31, "timestamp": "00:24:02", "text": "铂金。"}, {"type": "subtitle", "time": 1448.39, "timestamp": "00:24:08", "text": "等等，你现在在哪个服务器？"}, {"type": "subtitle", "time": 1451.51, "timestamp": "00:24:11", "text": "糟糕，我在……哦，我在东南方向"}, {"type": "subtitle", "time": 1453.269, "timestamp": "00:24:13", "text": "因为呃，我应该搬到你那儿去。"}, {"type": "subtitle", "time": 1456.149, "timestamp": "00:24:16", "text": "服务。哦，没关系。没关系。我们开始吧"}, {"type": "subtitle", "time": 1468.149, "timestamp": "00:24:28", "text": "我忘了艾登是怎么回来的了。呃，我"}, {"type": "subtitle", "time": 1479.029, "timestamp": "00:24:39", "text": "我的产品。我的天哪，这皮肤也太好了吧"}, {"type": "subtitle", "time": 1482.149, "timestamp": "00:24:42", "text": "漂亮的。真漂亮。我的天哪，我"}, {"type": "subtitle", "time": 1497.029, "timestamp": "00:24:57", "text": "提防。"}]
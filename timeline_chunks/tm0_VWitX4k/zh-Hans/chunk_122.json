[{"type": "subtitle", "time": 7322.31, "timestamp": "02:02:02", "text": "作为我们的下一位嘉宾。"}, {"type": "subtitle", "time": 7323.83, "timestamp": "02:02:03", "text": "嗯，"}, {"type": "subtitle", "time": 7325.91, "timestamp": "02:02:05", "text": "在此之前，我想先去吃饭。"}, {"type": "subtitle", "time": 7327.99, "timestamp": "02:02:07", "text": "速通吃"}, {"type": "subtitle", "time": 7330.629, "timestamp": "02:02:10", "text": "呃，速通吃"}, {"type": "subtitle", "time": 7332.629, "timestamp": "02:02:12", "text": "我的食物。"}, {"type": "subtitle", "time": 7370.39, "timestamp": "02:02:50", "text": "好的。哦，另一位模特也来了。"}, {"type": "subtitle", "time": 7373.75, "timestamp": "02:02:53", "text": "你好。呃，各位，我来吃晚餐吧。"}, {"type": "subtitle", "time": 7376.39, "timestamp": "02:02:56", "text": "休息一会儿。我很快会回来。"}, {"type": "subtitle", "time": 7379.669, "timestamp": "02:02:59", "text": "好的。我还要拿起我的麦克风。"}]
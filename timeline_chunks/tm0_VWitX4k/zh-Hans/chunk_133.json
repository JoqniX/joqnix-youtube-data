[{"type": "subtitle", "time": 7981.35, "timestamp": "02:13:01", "text": "我从事几个不同的工作。"}, {"type": "subtitle", "time": 7983.91, "timestamp": "02:13:03", "text": "元素，"}, {"type": "subtitle", "time": 7988.31, "timestamp": "02:13:08", "text": "但最重要的是能够……"}, {"type": "subtitle", "time": 7992.149, "timestamp": "02:13:12", "text": "全部都适合。这是一件事。和"}, {"type": "subtitle", "time": 7994.39, "timestamp": "02:13:14", "text": "能够平衡主与我的"}, {"type": "subtitle", "time": 7997.51, "timestamp": "02:13:17", "text": "当前人员闭嘴。我希望阿德莱德的叔叔"}, {"type": "subtitle", "time": 8000.39, "timestamp": "02:13:20", "text": "希望它似乎能够达到"}, {"type": "subtitle", "time": 8002.39, "timestamp": "02:13:22", "text": "最终稿提到了她叔叔的营地"}, {"type": "subtitle", "time": 8005.669, "timestamp": "02:13:25", "text": "可能在布罗克附近，过了河。"}, {"type": "subtitle", "time": 8008.149, "timestamp": "02:13:28", "text": "你说的那条河"}, {"type": "subtitle", "time": 8020.55, "timestamp": "02:13:40", "text": "出去，咱们走吧"}]
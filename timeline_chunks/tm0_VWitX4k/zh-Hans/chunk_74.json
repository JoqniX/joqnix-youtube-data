[{"type": "subtitle", "time": 4450.31, "timestamp": "01:14:10", "text": "哦，他们也做了类似“这是什么”之类的事情。"}, {"type": "subtitle", "time": 4452.07, "timestamp": "01:14:12", "text": "《使命召唤：大逃杀》做到了什么。所以，"}, {"type": "subtitle", "time": 4454.55, "timestamp": "01:14:14", "text": "我保留我的枪。幸运的是，我只是……"}, {"type": "subtitle", "time": 4466.87, "timestamp": "01:14:26", "text": "他妈的。你扔手雷了吗？呃，敌人"}, {"type": "subtitle", "time": 4470.63, "timestamp": "01:14:30", "text": "盾牌破了。我升级了"}, {"type": "subtitle", "time": 4473.11, "timestamp": "01:14:33", "text": "再次。好的。不，没关系。抓到我们了。最后的"}, {"type": "subtitle", "time": 4479.91, "timestamp": "01:14:39", "text": "哦，不错。"}, {"type": "subtitle", "time": 4481.51, "timestamp": "01:14:41", "text": "他必须确保自己拿到所有的战利品。"}, {"type": "subtitle", "time": 4485.91, "timestamp": "01:14:45", "text": "后退。那真是有点可惜。甜的。"}, {"type": "subtitle", "time": 4487.669, "timestamp": "01:14:47", "text": "那也能治愈我。等等，这太……"}, {"type": "subtitle", "time": 4491.11, "timestamp": "01:14:51", "text": "好的。等等，我不知道……"}, {"type": "subtitle", "time": 4494.63, "timestamp": "01:14:54", "text": "导管可以做到这一点。"}, {"type": "subtitle", "time": 4496.55, "timestamp": "01:14:56", "text": "导管已全新升级。听到"}]
[{"type": "subtitle", "time": 9600.23, "timestamp": "02:40:00", "text": "他的朋友和一切，就像漫游一样"}, {"type": "subtitle", "time": 9603.67, "timestamp": "02:40:03", "text": "周围都是购物之类的，我没有"}, {"type": "subtitle", "time": 9606.87, "timestamp": "02:40:06", "text": "甚至还有时间检查或学习，而我"}, {"type": "subtitle", "time": 9609.67, "timestamp": "02:40:09", "text": "经过。太疯狂了。"}, {"type": "subtitle", "time": 9611.349, "timestamp": "02:40:11", "text": "我不知道你是幸运还是……"}, {"type": "subtitle", "time": 9614.389, "timestamp": "02:40:14", "text": "就好像你知道答案一样。不，我"}, {"type": "subtitle", "time": 9616.79, "timestamp": "02:40:16", "text": "现在必须读了。其他人都像这样"}, {"type": "subtitle", "time": 9619.03, "timestamp": "02:40:19", "text": "因为是多项选择题，所以"}, {"type": "subtitle", "time": 9621.59, "timestamp": "02:40:21", "text": "可以随便拿走之类的。所以其中之一"}, {"type": "subtitle", "time": 9623.51, "timestamp": "02:40:23", "text": "四月份去的学生们参加了"}, {"type": "subtitle", "time": 9625.67, "timestamp": "02:40:25", "text": "当时我就想，是啊，我不知道答案。"}, {"type": "subtitle", "time": 9629.03, "timestamp": "02:40:29", "text": "我随机选了一样东西，然后就完成了。"}, {"type": "subtitle", "time": 9632.469, "timestamp": "02:40:32", "text": "考试还有5分钟"}, {"type": "subtitle", "time": 9635.59, "timestamp": "02:40:35", "text": "没有问答环节，也没有问题。"}, {"type": "subtitle", "time": 9637.59, "timestamp": "02:40:37", "text": "你不必写的答案"}, {"type": "subtitle", "time": 9640.55, "timestamp": "02:40:40", "text": "什么都没有，不不不，是选择题类型的，呃……"}, {"type": "subtitle", "time": 9644.389, "timestamp": "02:40:44", "text": "冒泡类型对吧哦"}, {"type": "subtitle", "time": 9647.51, "timestamp": "02:40:47", "text": "我看到的都是选择题，没错，日语考试就是这样。"}, {"type": "subtitle", "time": 9651.67, "timestamp": "02:40:51", "text": "就像所有选择题一样，这很好。想象"}, {"type": "subtitle", "time": 9653.99, "timestamp": "02:40:53", "text": "如果你必须在学校之类的场所"}, {"type": "subtitle", "time": 9657.59, "timestamp": "02:40:57", "text": "现在你必须写“是的”。如果"}, {"type": "subtitle", "time": 9659.99, "timestamp": "02:40:59", "text": "写出正确的事情我本该如此。"}]
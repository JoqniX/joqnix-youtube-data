[{"type": "subtitle", "time": 15905.11, "timestamp": "04:25:05", "text": "我还需要再杀九个人。我可以放弃"}, {"type": "subtitle", "time": 15907.91, "timestamp": "04:25:07", "text": "核弹。"}, {"type": "subtitle", "time": 15911.36, "timestamp": "04:25:11", "text": "他只是在发垃圾信息。我该怎么做？"}, {"type": "subtitle", "time": 15919.269, "timestamp": "04:25:19", "text": "激光很难杀死我。"}, {"type": "subtitle", "time": 15921.03, "timestamp": "04:25:21", "text": "盖伊"}, {"type": "subtitle", "time": 15928.07, "timestamp": "04:25:28", "text": "不，"}, {"type": "subtitle", "time": 15931.91, "timestamp": "04:25:31", "text": "男人。瞒不过你，是吧？还有六个"}, {"type": "subtitle", "time": 15934.63, "timestamp": "04:25:34", "text": "击杀数越多，我就能获得"}, {"type": "subtitle", "time": 15936.95, "timestamp": "04:25:36", "text": "核弹。"}, {"type": "subtitle", "time": 15947.75, "timestamp": "04:25:47", "text": "啊，我真是太棒了。不，"}, {"type": "subtitle", "time": 15956.229, "timestamp": "04:25:56", "text": "哦，你个混蛋。我的天啊。我刚才看到你了"}, {"type": "subtitle", "time": 15959.75, "timestamp": "04:25:59", "text": "落下。我的天啊。"}]
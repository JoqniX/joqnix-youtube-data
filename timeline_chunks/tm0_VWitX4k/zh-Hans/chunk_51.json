[{"type": "subtitle", "time": 3064.15, "timestamp": "00:51:04", "text": "然后就会变成真的"}, {"type": "subtitle", "time": 3066.549, "timestamp": "00:51:06", "text": "因为我们进入了前四名，所以这将是一场硬仗。"}, {"type": "subtitle", "time": 3068.47, "timestamp": "00:51:08", "text": "好了，就这样吧。所以我们必须"}, {"type": "subtitle", "time": 3073.03, "timestamp": "00:51:13", "text": "现在就走。所以，我们就到这里来。"}, {"type": "subtitle", "time": 3075.03, "timestamp": "00:51:15", "text": "哦，不。我们不能。没关系。它不是"}, {"type": "subtitle", "time": 3077.99, "timestamp": "00:51:17", "text": "那段时间。这个区域就像"}, {"type": "subtitle", "time": 3079.75, "timestamp": "00:51:19", "text": "会受到很大伤害，因为这个区域有"}, {"type": "subtitle", "time": 3083.27, "timestamp": "00:51:23", "text": "级别。是的。嗯，所以越高越高"}, {"type": "subtitle", "time": 3085.589, "timestamp": "00:51:25", "text": "等级下降显然会造成伤害，但可能"}, {"type": "subtitle", "time": 3087.27, "timestamp": "00:51:27", "text": "我已经知道了。但我其实并不这么认为。"}, {"type": "subtitle", "time": 3089.829, "timestamp": "00:51:29", "text": "想经历这一切。"}, {"type": "subtitle", "time": 3093.43, "timestamp": "00:51:33", "text": "好的。其他人"}, {"type": "subtitle", "time": 3108.63, "timestamp": "00:51:48", "text": "我干掉了一个敌人。必要的恶"}, {"type": "subtitle", "time": 3118.47, "timestamp": "00:51:58", "text": "老兄，我"}]
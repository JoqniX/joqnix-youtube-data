[{"type": "subtitle", "time": 7561.55, "timestamp": "02:06:01", "text": "一，二。"}, {"type": "subtitle", "time": 7567.91, "timestamp": "02:06:07", "text": "[音乐]"}, {"type": "subtitle", "time": 7570.99, "timestamp": "02:06:10", "text": "这耽搁也太糟糕了。"}, {"type": "subtitle", "time": 7576.95, "timestamp": "02:06:16", "text": "[音乐]"}, {"type": "subtitle", "time": 7579.109, "timestamp": "02:06:19", "text": "好的。每当我说话的时候"}, {"type": "subtitle", "time": 7581.589, "timestamp": "02:06:21", "text": "移动设备，呃，你可以看到波形。"}, {"type": "subtitle", "time": 7583.91, "timestamp": "02:06:23", "text": "好的。那是唯一一件事"}, {"type": "subtitle", "time": 7589.189, "timestamp": "02:06:29", "text": "可以区分这两者。嗯"}, {"type": "subtitle", "time": 7591.109, "timestamp": "02:06:31", "text": "是的。是的，我要走了。"}, {"type": "subtitle", "time": 7593.99, "timestamp": "02:06:33", "text": "下楼吃饭，欣赏溪流，"}, {"type": "subtitle", "time": 7596.149, "timestamp": "02:06:36", "text": "尽情享受V的一切。而我只是"}, {"type": "subtitle", "time": 7599.75, "timestamp": "02:06:39", "text": "继续用V字形向前探索。所以它更"}, {"type": "subtitle", "time": 7603.35, "timestamp": "02:06:43", "text": "这是《霍格沃茨之遗》W。请尽情享受吧！"}, {"type": "subtitle", "time": 7605.189, "timestamp": "02:06:45", "text": "这里。"}, {"type": "subtitle", "time": 7607.669, "timestamp": "02:06:47", "text": "我要一个。我会回来的。我们将开始"}, {"type": "subtitle", "time": 7609.669, "timestamp": "02:06:49", "text": "合作"}, {"type": "subtitle", "time": 7613.189, "timestamp": "02:06:53", "text": "20分钟。好的。各位再见。"}, {"type": "subtitle", "time": 7615.589, "timestamp": "02:06:55", "text": "什么？太酷了！我想知道"}, {"type": "subtitle", "time": 7619.91, "timestamp": "02:06:59", "text": "如何才能营造出那种氛围？所以，就这样吧。"}]
[{"type": "subtitle", "time": 4260.229, "timestamp": "01:11:00", "text": "他们在做什么。现在就像"}, {"type": "subtitle", "time": 4263.35, "timestamp": "01:11:03", "text": "它就像移动和点击 stra 一样。哦"}, {"type": "subtitle", "time": 4265.11, "timestamp": "01:11:05", "text": "我的上帝。"}, {"type": "subtitle", "time": 4268.229, "timestamp": "01:11:08", "text": "是啊，感觉黏糊糊的。太好了"}, {"type": "subtitle", "time": 4272.709, "timestamp": "01:11:12", "text": "像我这样的钻石。好痛。"}, {"type": "subtitle", "time": 4274.47, "timestamp": "01:11:14", "text": "我觉得我可以用这个提供护盾。"}, {"type": "subtitle", "time": 4277.669, "timestamp": "01:11:17", "text": "好的，我去。"}, {"type": "subtitle", "time": 4280.39, "timestamp": "01:11:20", "text": "你必须承诺。我希望你能"}, {"type": "subtitle", "time": 4304.31, "timestamp": "01:11:44", "text": "我是跳伞指挥官。我们留下来吧"}, {"type": "subtitle", "time": 4306.07, "timestamp": "01:11:46", "text": "一起。"}, {"type": "subtitle", "time": 4308.95, "timestamp": "01:11:48", "text": "我是跳伞指挥官"}, {"type": "subtitle", "time": 4311.189, "timestamp": "01:11:51", "text": "那里。"}, {"type": "subtitle", "time": 4313.189, "timestamp": "01:11:53", "text": "跟我一起走向胜利。又一个热门"}, {"type": "subtitle", "time": 4315.91, "timestamp": "01:11:55", "text": "滴管。我爱每一个"}, {"type": "subtitle", "time": 4317.669, "timestamp": "01:11:57", "text": "滴管。"}]
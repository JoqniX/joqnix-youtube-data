[{"type": "subtitle", "time": 2825.829, "timestamp": "00:47:05", "text": "我们刚才是不是在那边？我想我们当时"}, {"type": "subtitle", "time": 2827.75, "timestamp": "00:47:07", "text": "就在那边。"}, {"type": "subtitle", "time": 2830.55, "timestamp": "00:47:10", "text": "哦，我们刚才就在那边。好的。"}, {"type": "subtitle", "time": 2837.99, "timestamp": "00:47:17", "text": "[音乐]"}, {"type": "subtitle", "time": 2840.23, "timestamp": "00:47:20", "text": "不知道我能不能跳过去。哦，等等。"}, {"type": "subtitle", "time": 2843.19, "timestamp": "00:47:23", "text": "他是"}, {"type": "subtitle", "time": 2845.67, "timestamp": "00:47:25", "text": "哦，队友们。"}, {"type": "subtitle", "time": 2848.15, "timestamp": "00:47:28", "text": "队友。我们应该查一下。"}, {"type": "subtitle", "time": 2866.23, "timestamp": "00:47:46", "text": "我出生了。"}, {"type": "subtitle", "time": 2869.109, "timestamp": "00:47:49", "text": "你逃不掉的。"}, {"type": "subtitle", "time": 2873.109, "timestamp": "00:47:53", "text": "哦，等等。那就是你。我表现如何？"}, {"type": "subtitle", "time": 2878.39, "timestamp": "00:47:58", "text": "哦，好了。"}]
[{"type": "subtitle", "time": 5701.669, "timestamp": "01:35:01", "text": "哦，收件箱。"}, {"type": "subtitle", "time": 5704.629, "timestamp": "01:35:04", "text": "这是什么？全部删除。好了。"}, {"type": "subtitle", "time": 5708.229, "timestamp": "01:35:08", "text": "好了。您现在在大厅里。"}, {"type": "subtitle", "time": 5711.27, "timestamp": "01:35:11", "text": "全部玩一遍。我从来没玩过这个"}, {"type": "subtitle", "time": 5713.189, "timestamp": "01:35:13", "text": "之前玩过游戏之类的。为什么会这样？"}, {"type": "subtitle", "time": 5714.709, "timestamp": "01:35:14", "text": "感觉就像第一次玩一样"}, {"type": "subtitle", "time": 5716.95, "timestamp": "01:35:16", "text": "时间？"}, {"type": "subtitle", "time": 5720.709, "timestamp": "01:35:20", "text": "呃，玩"}, {"type": "subtitle", "time": 5724.95, "timestamp": "01:35:24", "text": "我该如何交朋友？"}, {"type": "subtitle", "time": 5728.07, "timestamp": "01:35:28", "text": "所以，呃，是它的朋友们。呃，向下"}, {"type": "subtitle", "time": 5730.87, "timestamp": "01:35:30", "text": "最底层就像是人们"}, {"type": "subtitle", "time": 5732.629, "timestamp": "01:35:32", "text": "然后你和那个人一起按下加号。"}, {"type": "subtitle", "time": 5735.59, "timestamp": "01:35:35", "text": "然后对我来说，哦，是"}, {"type": "subtitle", "time": 5739.51, "timestamp": "01:35:39", "text": "抱歉，捡起来很咸，我觉得。"}, {"type": "subtitle", "time": 5741.43, "timestamp": "01:35:41", "text": "它有"}, {"type": "subtitle", "time": 5746.07, "timestamp": "01:35:46", "text": "我不记得他叫什么名字了。"}, {"type": "subtitle", "time": 5751.27, "timestamp": "01:35:51", "text": "啊，我想我找到你了，1311 对吧？"}, {"type": "subtitle", "time": 5755.669, "timestamp": "01:35:55", "text": "嗯嗯，我会发邀请函的，儿子，你发了吗？"}]
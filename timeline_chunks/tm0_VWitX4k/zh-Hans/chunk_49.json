[{"type": "subtitle", "time": 2940.95, "timestamp": "00:49:00", "text": "我不知道那是什么。甜的。这"}, {"type": "subtitle", "time": 2943.91, "timestamp": "00:49:03", "text": "宝宝看起来匀称。找到了。"}, {"type": "subtitle", "time": 2946.39, "timestamp": "00:49:06", "text": "那是什么？这是一个神话般的箱子。"}, {"type": "subtitle", "time": 2947.91, "timestamp": "00:49:07", "text": "所以，他们添加了，你知道那些"}, {"type": "subtitle", "time": 2949.75, "timestamp": "00:49:09", "text": "神话武器？所以，现在他们有了一个"}, {"type": "subtitle", "time": 2953.349, "timestamp": "00:49:13", "text": "有机会发现垃圾桶和刷新点"}, {"type": "subtitle", "time": 2955.67, "timestamp": "00:49:15", "text": "你还可以找到神话般的物品。"}, {"type": "subtitle", "time": 2959.51, "timestamp": "00:49:19", "text": "哦，它真的太好吃了。"}, {"type": "subtitle", "time": 2962.23, "timestamp": "00:49:22", "text": "应该把弹簧装到我的杆子里。这"}, {"type": "subtitle", "time": 2963.91, "timestamp": "00:49:23", "text": "是"}, {"type": "subtitle", "time": 2967.75, "timestamp": "00:49:27", "text": "应该是“我的天哪”。是的。是的。所以，"}, {"type": "subtitle", "time": 2969.75, "timestamp": "00:49:29", "text": "我已经拿走了我的……你可以拿走任何你想拿的东西"}, {"type": "subtitle", "time": 2972.15, "timestamp": "00:49:32", "text": "想要从这个喜欢"}, {"type": "subtitle", "time": 2974.87, "timestamp": "00:49:34", "text": "而且我还是拿到了神话级"}, {"type": "subtitle", "time": 2983.03, "timestamp": "00:49:43", "text": "但它造成的损害更大吗？我曾有过"}, {"type": "subtitle", "time": 2985.91, "timestamp": "00:49:45", "text": "同一把枪。神话般的武器。嗯，好吧"}, {"type": "subtitle", "time": 2989.589, "timestamp": "00:49:49", "text": "好的。有黄金，还有……"}, {"type": "subtitle", "time": 2991.27, "timestamp": "00:49:51", "text": "黄金武器，还有神话武器。"}, {"type": "subtitle", "time": 2992.549, "timestamp": "00:49:52", "text": "武器。神话武器就像……"}, {"type": "subtitle", "time": 2995.27, "timestamp": "00:49:55", "text": "维和人员。我手里拿着的那一个"}, {"type": "subtitle", "time": 2998.549, "timestamp": "00:49:58", "text": "它是神话级物品，而且伤害更高，但是"}]
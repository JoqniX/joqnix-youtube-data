[{"type": "subtitle", "time": 8343.669, "timestamp": "02:19:03", "text": "[音乐]"}, {"type": "subtitle", "time": 8359.83, "timestamp": "02:19:19", "text": "我的一部分感觉像是"}, {"type": "subtitle", "time": 8362.23, "timestamp": "02:19:22", "text": "是的，我的一部分感觉这可能是"}, {"type": "subtitle", "time": 8365.27, "timestamp": "02:19:25", "text": "正是我要找的那种。"}, {"type": "subtitle", "time": 8368.309, "timestamp": "02:19:28", "text": "但我内心深处也觉得"}, {"type": "subtitle", "time": 8370.79, "timestamp": "02:19:30", "text": "会不会是我正在寻找的地方"}, {"type": "subtitle", "time": 8375.75, "timestamp": "02:19:35", "text": "为了？但无论如何，我们都会探讨这个问题。"}, {"type": "subtitle", "time": 8377.589, "timestamp": "02:19:37", "text": "另外，还有一款梅林牌溜冰鞋。我知道一个"}, {"type": "subtitle", "time": 8379.99, "timestamp": "02:19:39", "text": "我看到梅林审判的时候就会去。我会的"}, {"type": "subtitle", "time": 8382.309, "timestamp": "02:19:42", "text": "这"}, {"type": "subtitle", "time": 8393.99, "timestamp": "02:19:53", "text": "一二三。岩层。"}, {"type": "subtitle", "time": 8396.55, "timestamp": "02:19:56", "text": "这是地图上的第一个地标。"}]
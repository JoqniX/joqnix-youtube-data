[{"type": "subtitle", "time": 2520.79, "timestamp": "00:42:00", "text": "我的选择没问题。我到底是什么？"}, {"type": "subtitle", "time": 2523.109, "timestamp": "00:42:03", "text": "我目前150级，但我已经玩过这个了。"}, {"type": "subtitle", "time": 2526.23, "timestamp": "00:42:06", "text": "前。我呃，在OC之前，其实并没有真正"}, {"type": "subtitle", "time": 2527.589, "timestamp": "00:42:07", "text": "玩很多游戏。就像那样"}, {"type": "subtitle", "time": 2531.99, "timestamp": "00:42:11", "text": "难得的机会能玩到这款游戏。嗯。"}, {"type": "subtitle", "time": 2537.19, "timestamp": "00:42:17", "text": "所以，你知道，呃，情况并非如此。"}, {"type": "subtitle", "time": 2539.109, "timestamp": "00:42:19", "text": "我玩的是延迟比较高的服务器。"}, {"type": "subtitle", "time": 2542.069, "timestamp": "00:42:22", "text": "因为游戏不会在OC上进行。"}, {"type": "subtitle", "time": 2543.349, "timestamp": "00:42:23", "text": "服务器。"}, {"type": "subtitle", "time": 2544.87, "timestamp": "00:42:24", "text": "我觉得我拿到了，但是我觉得我好像"}, {"type": "subtitle", "time": 2552.55, "timestamp": "00:42:32", "text": "我在北美服务器拿到了两个2500伤害徽章。所以"}, {"type": "subtitle", "time": 2555.03, "timestamp": "00:42:35", "text": "150毫秒的延迟不算太糟。一切都好。"}, {"type": "subtitle", "time": 2557.67, "timestamp": "00:42:37", "text": "该死。"}, {"type": "subtitle", "time": 2559.75, "timestamp": "00:42:39", "text": "呃，你知道拍摄地点在哪里吗？"}, {"type": "subtitle", "time": 2564.79, "timestamp": "00:42:44", "text": "再次限制帧率？呃，限制帧率在"}, {"type": "subtitle", "time": 2572.069, "timestamp": "00:42:52", "text": "你把它取下来了吗？"}, {"type": "subtitle", "time": 2576.23, "timestamp": "00:42:56", "text": "呃，分辨率已调整。"}, {"type": "subtitle", "time": 2579.589, "timestamp": "00:42:59", "text": "那个。我的天哪。我觉得我觉得我"}]
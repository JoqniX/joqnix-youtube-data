[{"type": "subtitle", "time": 1324.87, "timestamp": "00:22:04", "text": "[音乐]"}, {"type": "subtitle", "time": 1334.789, "timestamp": "00:22:14", "text": "那件事确实改变了很多事情。"}, {"type": "subtitle", "time": 1337.27, "timestamp": "00:22:17", "text": "等等，为什么？等等，我感觉就像你"}, {"type": "subtitle", "time": 1344.23, "timestamp": "00:22:24", "text": "我觉得你拥有一件传家宝。"}, {"type": "subtitle", "time": 1345.99, "timestamp": "00:22:25", "text": "已经。"}, {"type": "subtitle", "time": 1349.51, "timestamp": "00:22:29", "text": "我愿意。我确实有一个，我只有一个"}, {"type": "subtitle", "time": 1350.87, "timestamp": "00:22:30", "text": "传家宝。我没有新款的。"}, {"type": "subtitle", "time": 1352.31, "timestamp": "00:22:32", "text": "他们有传家宝，但我只有一件。"}, {"type": "subtitle", "time": 1354.789, "timestamp": "00:22:34", "text": "传家宝，就是这样。"}, {"type": "subtitle", "time": 1357.43, "timestamp": "00:22:37", "text": "沃森的。虽然我已经承认"}, {"type": "subtitle", "time": 1360.95, "timestamp": "00:22:40", "text": "我对这款游戏有点生气。"}, {"type": "subtitle", "time": 1362.789, "timestamp": "00:22:42", "text": "喜欢"}, {"type": "subtitle", "time": 1364.87, "timestamp": "00:22:44", "text": "我可能马上就要像这样倒下了"}, {"type": "subtitle", "time": 1367.669, "timestamp": "00:22:47", "text": "接下来的两个月将会大幅下降"}, {"type": "subtitle", "time": 1371.19, "timestamp": "00:22:51", "text": "几乎三个，另外 300 400"}, {"type": "subtitle", "time": 1373.19, "timestamp": "00:22:53", "text": "在这场游戏中"}, {"type": "subtitle", "time": 1374.549, "timestamp": "00:22:54", "text": "因为他们即将发布"}, {"type": "subtitle", "time": 1377.19, "timestamp": "00:22:57", "text": "沃森的嗯"}]
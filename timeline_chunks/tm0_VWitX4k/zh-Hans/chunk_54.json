[{"type": "subtitle", "time": 3247.03, "timestamp": "00:54:07", "text": "我的Octane赛车稍微受损了一点。"}, {"type": "subtitle", "time": 3268.069, "timestamp": "00:54:28", "text": "抓到他了。"}, {"type": "subtitle", "time": 3269.51, "timestamp": "00:54:29", "text": "我倒下了。我倒下了。向下。只是……"}, {"type": "subtitle", "time": 3271.109, "timestamp": "00:54:31", "text": "一。只有我们俩。向下。有一个"}, {"type": "subtitle", "time": 3273.91, "timestamp": "00:54:33", "text": "更多的。还有一个。我接到你了。我的天啊。"}, {"type": "subtitle", "time": 3276.549, "timestamp": "00:54:36", "text": "我们走吧。"}, {"type": "subtitle", "time": 3280.26, "timestamp": "00:54:40", "text": "这是我三年来的首场胜利。我的天啊。"}, {"type": "subtitle", "time": 3282.39, "timestamp": "00:54:42", "text": "[笑声]"}, {"type": "subtitle", "time": 3286.95, "timestamp": "00:54:46", "text": "我的天哪。我的天啊。我们走吧。"}, {"type": "subtitle", "time": 3296.15, "timestamp": "00:54:56", "text": "我的天啊。"}, {"type": "subtitle", "time": 3297.829, "timestamp": "00:54:57", "text": "你完成了D的一半。你完成了一半"}]
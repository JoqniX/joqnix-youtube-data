[{"type": "subtitle", "time": 15600.55, "timestamp": "04:20:00", "text": "50，对吧？"}, {"type": "subtitle", "time": 15603.11, "timestamp": "04:20:03", "text": "你需要"}, {"type": "subtitle", "time": 15606.229, "timestamp": "04:20:06", "text": "我太想用核弹了，老兄。是的，你"}, {"type": "subtitle", "time": 15636.79, "timestamp": "04:20:36", "text": "雅各布，我要来找你家人了。"}, {"type": "subtitle", "time": 15640.309, "timestamp": "04:20:40", "text": "之后。什么？"}, {"type": "subtitle", "time": 15651.03, "timestamp": "04:20:51", "text": "哦。啊。你从那里杀了我。"}]
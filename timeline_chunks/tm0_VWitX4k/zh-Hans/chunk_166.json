[{"type": "subtitle", "time": 9960.71, "timestamp": "02:46:00", "text": "但它看起来像是碎了一样"}, {"type": "subtitle", "time": 9964.63, "timestamp": "02:46:04", "text": "就像裂缝之类的，完全裂开了，我当时"}, {"type": "subtitle", "time": 9968.309, "timestamp": "02:46:08", "text": "我哭着说，不，我该怎么关上我的门"}, {"type": "subtitle", "time": 9971.349, "timestamp": "02:46:11", "text": "电脑现在很可怕"}, {"type": "subtitle", "time": 9984.87, "timestamp": "02:46:24", "text": "我见过有人拿着玻璃杯"}, {"type": "subtitle", "time": 9994.95, "timestamp": "02:46:34", "text": "简直疯了。等等，你用的是笔记本电脑吗？"}, {"type": "subtitle", "time": 10000.23, "timestamp": "02:46:40", "text": "台式机当笔记本电脑用？啊"}, {"type": "subtitle", "time": 10004.71, "timestamp": "02:46:44", "text": "我也有台式电脑，但目前还没有。 H"}, {"type": "subtitle", "time": 10007.59, "timestamp": "02:46:47", "text": "我想买的笔记本电脑"}, {"type": "subtitle", "time": 10010.469, "timestamp": "02:46:50", "text": "然后我意识到，我有一台笔记本电脑。"}, {"type": "subtitle", "time": 10013.75, "timestamp": "02:46:53", "text": "呃，是啊，现在东西太多了。是的，就是这样。"}, {"type": "subtitle", "time": 10015.19, "timestamp": "02:46:55", "text": "算是便携，但又不太便携"}, {"type": "subtitle", "time": 10017.19, "timestamp": "02:46:57", "text": "强大的。"}, {"type": "subtitle", "time": 10018.95, "timestamp": "02:46:58", "text": "那太过了。"}]
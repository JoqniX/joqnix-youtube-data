[{"type": "subtitle", "time": 2161.19, "timestamp": "00:36:01", "text": "不，不。我好像看到加载画面了。"}, {"type": "subtitle", "time": 2165.109, "timestamp": "00:36:05", "text": "所以，我觉得不行。哦，算了。"}, {"type": "subtitle", "time": 2168.55, "timestamp": "00:36:08", "text": "等等，你是在游戏里做的吗？"}, {"type": "subtitle", "time": 2172.79, "timestamp": "00:36:12", "text": "哦，等等。我看到你了。"}, {"type": "subtitle", "time": 2177.03, "timestamp": "00:36:17", "text": "你正在玩游戏吗？哦，不。是的。我们走吧。"}, {"type": "subtitle", "time": 2184.27, "timestamp": "00:36:24", "text": "我的天哪，太难了。"}, {"type": "subtitle", "time": 2186.95, "timestamp": "00:36:26", "text": "[音乐]"}, {"type": "subtitle", "time": 2190.069, "timestamp": "00:36:30", "text": "所以，你最近怎么样？哦，是的。所以，"}, {"type": "subtitle", "time": 2192.39, "timestamp": "00:36:32", "text": "你一直在参与合作项目"}, {"type": "subtitle", "time": 2195.109, "timestamp": "00:36:35", "text": "诸如此类，对吧？还有寿司之类的。"}, {"type": "subtitle", "time": 2197.91, "timestamp": "00:36:37", "text": "是的。是的。是的。寿司和我，他们是"}, {"type": "subtitle", "time": 2199.99, "timestamp": "00:36:39", "text": "很紧。"}, {"type": "subtitle", "time": 2205.19, "timestamp": "00:36:45", "text": "我相当多。是啊，那挺好的。"}, {"type": "subtitle", "time": 2208.47, "timestamp": "00:36:48", "text": "而且我觉得当时，是的，在"}, {"type": "subtitle", "time": 2211.99, "timestamp": "00:36:51", "text": "是的。然而，这个月我确实做了一件事"}, {"type": "subtitle", "time": 2215.03, "timestamp": "00:36:55", "text": "与她合作，所以我们选择了她。"}, {"type": "subtitle", "time": 2218.069, "timestamp": "00:36:58", "text": "玩游戏什么的，但我们就去了"}]
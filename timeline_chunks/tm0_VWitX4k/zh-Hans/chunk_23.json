[{"type": "subtitle", "time": 1380.81, "timestamp": "00:23:00", "text": "屈臣氏的……高级护肤品。"}, {"type": "subtitle", "time": 1382.47, "timestamp": "00:23:02", "text": "[音乐]"}, {"type": "subtitle", "time": 1383.83, "timestamp": "00:23:03", "text": "是的。是啊，我当时就在抱怨这件事。"}, {"type": "subtitle", "time": 1385.669, "timestamp": "00:23:05", "text": "前几天，大概就是，你知道，哦，"}, {"type": "subtitle", "time": 1387.11, "timestamp": "00:23:07", "text": "他们没有专属的尊享皮肤。"}, {"type": "subtitle", "time": 1390.63, "timestamp": "00:23:10", "text": "沃森，但其他人都有。我看见"}, {"type": "subtitle", "time": 1392.31, "timestamp": "00:23:12", "text": "她要买一个。我太"}, {"type": "subtitle", "time": 1402.149, "timestamp": "00:23:22", "text": "哦，是的。让我……"}, {"type": "subtitle", "time": 1405.83, "timestamp": "00:23:25", "text": "你碰巧擅长玩这个游戏吗？"}, {"type": "subtitle", "time": 1408.95, "timestamp": "00:23:28", "text": "我没事。"}, {"type": "subtitle", "time": 1411.27, "timestamp": "00:23:31", "text": "就像游戏最火的时候一样，我"}, {"type": "subtitle", "time": 1413.669, "timestamp": "00:23:33", "text": "就像钻石一样，但也就仅此而已了。"}, {"type": "subtitle", "time": 1422.95, "timestamp": "00:23:42", "text": "时间。"}, {"type": "subtitle", "time": 1425.11, "timestamp": "00:23:45", "text": "是的。是的，排名更高，但是"}, {"type": "subtitle", "time": 1427.99, "timestamp": "00:23:47", "text": "好像事实并非如此。我的天啊。我们正在"}, {"type": "subtitle", "time": 1430.23, "timestamp": "00:23:50", "text": "中心。"}, {"type": "subtitle", "time": 1432.149, "timestamp": "00:23:52", "text": "是的。这意味着我们已经进入了这种状态"}, {"type": "subtitle", "time": 1435.029, "timestamp": "00:23:55", "text": "就像每个人一样，你知道吗？哦"}, {"type": "subtitle", "time": 1436.87, "timestamp": "00:23:56", "text": "我的上帝。大概吧，大概……"}]
[{"type": "subtitle", "time": 661.99, "timestamp": "00:11:01", "text": "啊，不错。好的。"}, {"type": "subtitle", "time": 664.31, "timestamp": "00:11:04", "text": "你最喜欢的游戏是什么？"}, {"type": "subtitle", "time": 666.87, "timestamp": "00:11:06", "text": "多年来一直喜欢？我认为"}, {"type": "subtitle", "time": 671.59, "timestamp": "00:11:11", "text": "你更喜欢第一人称射击游戏，对吧？联盟。嗯，"}, {"type": "subtitle", "time": 673.829, "timestamp": "00:11:13", "text": "上帝啊，坚持住。我最喜欢的游戏"}, {"type": "subtitle", "time": 677.03, "timestamp": "00:11:17", "text": "玩，嗯，我确实喜欢玩。"}, {"type": "subtitle", "time": 681.269, "timestamp": "00:11:21", "text": "联盟。我喜欢英雄联盟。嗯，"}, {"type": "subtitle", "time": 683.99, "timestamp": "00:11:23", "text": "哦，对，你之前玩过。"}, {"type": "subtitle", "time": 686.79, "timestamp": "00:11:26", "text": "围城。围城。我仍然有点喜欢"}, {"type": "subtitle", "time": 691.269, "timestamp": "00:11:31", "text": "围城。呃，《黎明杀机》。"}, {"type": "subtitle", "time": 695.829, "timestamp": "00:11:35", "text": "《黎明杀机》真的很好玩。"}, {"type": "subtitle", "time": 697.19, "timestamp": "00:11:37", "text": "我最近真的很喜欢玩《Dead by》。"}, {"type": "subtitle", "time": 700.23, "timestamp": "00:11:40", "text": "天亮了，老兄。等等，你擅长B吗？"}, {"type": "subtitle", "time": 703.43, "timestamp": "00:11:43", "text": "碰巧吗？你喜欢恐怖片吗？"}, {"type": "subtitle", "time": 705.75, "timestamp": "00:11:45", "text": "我特别喜欢恐怖片。我的天哪，我"}, {"type": "subtitle", "time": 707.829, "timestamp": "00:11:47", "text": "不擅长恐怖片。"}, {"type": "subtitle", "time": 709.35, "timestamp": "00:11:49", "text": "不，我明白。比如，不多"}, {"type": "subtitle", "time": 712.389, "timestamp": "00:11:52", "text": "人们就是这样。我很好。我最喜欢的"}, {"type": "subtitle", "time": 715.829, "timestamp": "00:11:55", "text": "恐怖就像恐怖电影。"}, {"type": "subtitle", "time": 717.829, "timestamp": "00:11:57", "text": "我是个恐怖电影迷，"}]
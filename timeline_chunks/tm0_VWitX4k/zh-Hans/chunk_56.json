[{"type": "subtitle", "time": 3360.789, "timestamp": "00:56:00", "text": "这"}, {"type": "subtitle", "time": 3363.27, "timestamp": "00:56:03", "text": "那是什么来着？呃"}, {"type": "subtitle", "time": 3366.95, "timestamp": "00:56:06", "text": "头盔镜头。是的。是的。是的。所以包装"}, {"type": "subtitle", "time": 3369.67, "timestamp": "00:56:09", "text": "镜头。是的。没有异国风情的镜头"}, {"type": "subtitle", "time": 3372.309, "timestamp": "00:56:12", "text": "也。他们就像是“是啊”。去消费"}, {"type": "subtitle", "time": 3375.589, "timestamp": "00:56:15", "text": "这里面有更多钱。"}, {"type": "subtitle", "time": 3377.67, "timestamp": "00:56:17", "text": "你只能购买异域碎片，但是"}, {"type": "subtitle", "time": 3380.95, "timestamp": "00:56:20", "text": "它们就像是同一层皮肤。我认为"}, {"type": "subtitle", "time": 3384.71, "timestamp": "00:56:24", "text": "大概50美元吧。"}, {"type": "subtitle", "time": 3386.95, "timestamp": "00:56:26", "text": "至少。但我甚至不知道是否"}, {"type": "subtitle", "time": 3388.93, "timestamp": "00:56:28", "text": "它只有一层皮肤。"}, {"type": "subtitle", "time": 3400.87, "timestamp": "00:56:40", "text": "太多事情了。"}, {"type": "subtitle", "time": 3405.109, "timestamp": "00:56:45", "text": "我该如何选择？呃，我想去……"}, {"type": "subtitle", "time": 3407.03, "timestamp": "00:56:47", "text": "她。"}, {"type": "subtitle", "time": 3415.43, "timestamp": "00:56:55", "text": "我知道你在找什么。"}, {"type": "subtitle", "time": 3418.15, "timestamp": "00:56:58", "text": "我的天啊。拉，为什么？为什么我会成为幽灵？"}]
[{"type": "subtitle", "time": 5883.109, "timestamp": "01:38:03", "text": "右上角。哦，血网。"}, {"type": "subtitle", "time": 5885.43, "timestamp": "01:38:05", "text": "好的。所以你会在你的角色上看到这一点。"}, {"type": "subtitle", "time": 5887.99, "timestamp": "01:38:07", "text": "就像血网一样，你基本上就是"}, {"type": "subtitle", "time": 5892.55, "timestamp": "01:38:12", "text": "只要升级一下，你就能得到"}, {"type": "subtitle", "time": 5894.629, "timestamp": "01:38:14", "text": "哦，你会进入一个全新的世界。"}, {"type": "subtitle", "time": 5897.27, "timestamp": "01:38:17", "text": "大厅里一切都很好。"}, {"type": "subtitle", "time": 5898.629, "timestamp": "01:38:18", "text": "你不必拥有所有东西。"}, {"type": "subtitle", "time": 5902.07, "timestamp": "01:38:22", "text": "解锁或者类似那样，呃，那就是"}, {"type": "subtitle", "time": 5904.87, "timestamp": "01:38:24", "text": "如何解锁诸如特权和物品之类的东西"}, {"type": "subtitle", "time": 5907.51, "timestamp": "01:38:27", "text": "游戏中的物品。"}, {"type": "subtitle", "time": 5908.709, "timestamp": "01:38:28", "text": "有各种各样的角色。是的。"}, {"type": "subtitle", "time": 5911.83, "timestamp": "01:38:31", "text": "是的。试试你喜欢的任何角色。"}, {"type": "subtitle", "time": 5913.99, "timestamp": "01:38:33", "text": "啊，约翰·维克也算是其中之一吧。"}, {"type": "subtitle", "time": 5917.189, "timestamp": "01:38:37", "text": "外形特征。"}, {"type": "subtitle", "time": 5919.27, "timestamp": "01:38:39", "text": "等等，什么？"}, {"type": "subtitle", "time": 5921.43, "timestamp": "01:38:41", "text": "是的。是的。这样可以。基本上，这"}, {"type": "subtitle", "time": 5924.47, "timestamp": "01:38:44", "text": "这款游戏就像恐怖版的《堡垒之夜》。"}, {"type": "subtitle", "time": 5927.51, "timestamp": "01:38:47", "text": "所以，我们就有了劳拉·克劳馥。我们就像"}, {"type": "subtitle", "time": 5930.149, "timestamp": "01:38:50", "text": "龙与地下城角色。我们请到了尼古拉斯·凯奇。"}, {"type": "subtitle", "time": 5932.629, "timestamp": "01:38:52", "text": "尼古拉斯·凯奇也参与了游戏。什么？阿雅"}, {"type": "subtitle", "time": 5936.95, "timestamp": "01:38:56", "text": "黄，里昂·肯尼迪，吉尔·瓦伦丁。"}]
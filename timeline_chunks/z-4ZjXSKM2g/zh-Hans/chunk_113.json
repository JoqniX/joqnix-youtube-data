[{"type": "subtitle", "time": 6790.47, "timestamp": "01:53:10", "text": "是的。"}, {"type": "subtitle", "time": 6794.55, "timestamp": "01:53:14", "text": "好的，你去做吧。"}, {"type": "subtitle", "time": 6796.47, "timestamp": "01:53:16", "text": "还没结束。一定。"}, {"type": "subtitle", "time": 6798.87, "timestamp": "01:53:18", "text": "是的。我还没完成坐标那部分工作。"}, {"type": "subtitle", "time": 6799.87, "timestamp": "01:53:19", "text": "是的。"}, {"type": "subtitle", "time": 6812.99, "timestamp": "01:53:32", "text": "我把它剥掉了。"}, {"type": "subtitle", "time": 6817.39, "timestamp": "01:53:37", "text": "好了，我们走吧。"}, {"type": "subtitle", "time": 6818.35, "timestamp": "01:53:38", "text": "好的。好的。好的。"}, {"type": "subtitle", "time": 6819.87, "timestamp": "01:53:39", "text": "是的。我们走吧。"}, {"type": "subtitle", "time": 6820.79, "timestamp": "01:53:40", "text": "是的。"}, {"type": "subtitle", "time": 6822.548, "timestamp": "01:53:42", "text": "激光。激光"}, {"type": "subtitle", "time": 6823.229, "timestamp": "01:53:43", "text": "[清嗓子]"}, {"type": "subtitle", "time": 6823.91, "timestamp": "01:53:43", "text": "激光。"}, {"type": "subtitle", "time": 6826.75, "timestamp": "01:53:46", "text": "他们是什么样的人？他们究竟是怎样的人？"}, {"type": "subtitle", "time": 6828.47, "timestamp": "01:53:48", "text": "这是"}, {"type": "subtitle", "time": 6831.109, "timestamp": "01:53:51", "text": "我觉得没必要。每个人"}, {"type": "subtitle", "time": 6834.03, "timestamp": "01:53:54", "text": "有必要设铃铛吗？贝尔绝对是必备的。"}, {"type": "subtitle", "time": 6836.589, "timestamp": "01:53:56", "text": "铃铛是必不可少的。"}, {"type": "subtitle", "time": 6836.99, "timestamp": "01:53:56", "text": "小糸"}, {"type": "subtitle", "time": 6839.27, "timestamp": "01:53:59", "text": "我要去。已经"}, {"type": "subtitle", "time": 6839.51, "timestamp": "01:53:59", "text": "是的。"}]
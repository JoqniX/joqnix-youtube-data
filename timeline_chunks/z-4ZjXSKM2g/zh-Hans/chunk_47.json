[{"type": "subtitle", "time": 2830.63, "timestamp": "00:47:10", "text": "那"}, {"type": "subtitle", "time": 2836.51, "timestamp": "00:47:16", "text": "嘿！"}, {"type": "subtitle", "time": 2837.109, "timestamp": "00:47:17", "text": "在车站"}, {"type": "subtitle", "time": 2840.03, "timestamp": "00:47:20", "text": "别把我丢下。"}, {"type": "subtitle", "time": 2845.069, "timestamp": "00:47:25", "text": "它闪闪发光。"}, {"type": "subtitle", "time": 2845.79, "timestamp": "00:47:25", "text": "啊，"}, {"type": "subtitle", "time": 2846.63, "timestamp": "00:47:26", "text": "它闪闪发光。"}, {"type": "subtitle", "time": 2847.069, "timestamp": "00:47:27", "text": "一个，"}, {"type": "subtitle", "time": 2848.19, "timestamp": "00:47:28", "text": "它闪闪发光。"}, {"type": "subtitle", "time": 2850.51, "timestamp": "00:47:30", "text": "是的，可以放置。"}, {"type": "subtitle", "time": 2856.99, "timestamp": "00:47:36", "text": "早期的。"}, {"type": "subtitle", "time": 2859.87, "timestamp": "00:47:39", "text": "哦，不是这样。你去哪儿？"}, {"type": "subtitle", "time": 2866.03, "timestamp": "00:47:46", "text": "糟糕的。它不见了。"}, {"type": "subtitle", "time": 2867.19, "timestamp": "00:47:47", "text": "糟糕的。"}, {"type": "subtitle", "time": 2869.99, "timestamp": "00:47:49", "text": "是的。"}, {"type": "subtitle", "time": 2871.27, "timestamp": "00:47:51", "text": "我应该怎么办？"}, {"type": "subtitle", "time": 2873.508, "timestamp": "00:47:53", "text": "没人有激光器。"}, {"type": "subtitle", "time": 2874.23, "timestamp": "00:47:54", "text": "[笑声]"}]
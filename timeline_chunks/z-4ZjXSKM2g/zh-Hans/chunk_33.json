[{"type": "subtitle", "time": 1987.31, "timestamp": "00:33:07", "text": "一个，"}, {"type": "subtitle", "time": 1989.83, "timestamp": "00:33:09", "text": "嗯？你去哪儿？"}, {"type": "chat", "time": 1991.0, "timestamp": "00:33:11", "author": "@hariomfluteandrap", "avatar": "https://yt4.ggpht.com/uLmxuG6eMZD-leBcxuP2_JYccD9POZNjPz-fuOc9TTPAawcZy9q1tIRMiQjZvsvk-gSHwpggS2Q=s64-c-k-c0x00ffffff-no-rj", "message": "tell me"}, {"type": "subtitle", "time": 1991.509, "timestamp": "00:33:11", "text": "哦，上面有人。"}, {"type": "subtitle", "time": 1993.11, "timestamp": "00:33:13", "text": "啊，是的，有。"}, {"type": "subtitle", "time": 2001.669, "timestamp": "00:33:21", "text": "我们见面了。 O Park"}, {"type": "subtitle", "time": 2002.269, "timestamp": "00:33:22", "text": "好的。"}, {"type": "subtitle", "time": 2003.31, "timestamp": "00:33:23", "text": "我们终于见面了。"}, {"type": "subtitle", "time": 2005.47, "timestamp": "00:33:25", "text": "我换了衣服就睡觉了。"}, {"type": "subtitle", "time": 2006.47, "timestamp": "00:33:26", "text": "握住铃铛，然后看"}, {"type": "subtitle", "time": 2008.269, "timestamp": "00:33:28", "text": "它很可爱。太可爱了。"}, {"type": "subtitle", "time": 2010.31, "timestamp": "00:33:30", "text": "我有点困了。因为现在是晚上。"}, {"type": "subtitle", "time": 2021.87, "timestamp": "00:33:41", "text": "就像玩耍后睡着的孩子一样。"}, {"type": "subtitle", "time": 2023.83, "timestamp": "00:33:43", "text": "我睡着了。"}, {"type": "subtitle", "time": 2026.549, "timestamp": "00:33:46", "text": "我做到了。"}, {"type": "subtitle", "time": 2028.07, "timestamp": "00:33:48", "text": "所以，龙君已经"}, {"type": "subtitle", "time": 2028.95, "timestamp": "00:33:48", "text": "1 件。"}, {"type": "subtitle", "time": 2031.789, "timestamp": "00:33:51", "text": "山"}, {"type": "subtitle", "time": 2039.31, "timestamp": "00:33:59", "text": "我想我会让他们帮我拿。"}]
[{"type": "subtitle", "time": 10020.71, "timestamp": "02:47:00", "text": "我明白。"}, {"type": "subtitle", "time": 10022.59, "timestamp": "02:47:02", "text": "哇。继续努力吧。"}, {"type": "subtitle", "time": 10024.51, "timestamp": "02:47:04", "text": "视角也正确。"}, {"type": "subtitle", "time": 10025.309, "timestamp": "02:47:05", "text": "祝你们俩好运。"}, {"type": "subtitle", "time": 10027.23, "timestamp": "02:47:07", "text": "哦，那很好。好的。"}, {"type": "subtitle", "time": 10036.15, "timestamp": "02:47:16", "text": "你还好吗？"}, {"type": "subtitle", "time": 10037.95, "timestamp": "02:47:17", "text": "你做得非常棒！"}, {"type": "subtitle", "time": 10040.269, "timestamp": "02:47:20", "text": "你做得很好。你做得很好。一个，"}, {"type": "subtitle", "time": 10042.19, "timestamp": "02:47:22", "text": "快到了"}, {"type": "subtitle", "time": 10044.75, "timestamp": "02:47:24", "text": "我想我们现在可以走了。"}, {"type": "subtitle", "time": 10047.59, "timestamp": "02:47:27", "text": "给你一支激光笔，咱们玩疯吧。"}, {"type": "subtitle", "time": 10053.469, "timestamp": "02:47:33", "text": "一个。正确答案。惊人的。"}, {"type": "subtitle", "time": 10054.63, "timestamp": "02:47:34", "text": "我做到了。"}, {"type": "subtitle", "time": 10063.91, "timestamp": "02:47:43", "text": "他们来了。"}, {"type": "subtitle", "time": 10065.75, "timestamp": "02:47:45", "text": "我成功了。"}, {"type": "subtitle", "time": 10075.429, "timestamp": "02:47:55", "text": "鸬鹚。"}, {"type": "subtitle", "time": 10077.936, "timestamp": "02:47:57", "text": "一个。哦，别踢它。"}, {"type": "subtitle", "time": 10079.63, "timestamp": "02:47:59", "text": "[笑声]"}]
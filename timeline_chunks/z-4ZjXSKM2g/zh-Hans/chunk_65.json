[{"type": "subtitle", "time": 3903.829, "timestamp": "01:05:03", "text": "为什么？"}, {"type": "subtitle", "time": 3906.029, "timestamp": "01:05:06", "text": "哦，他们已经走了。他们已经离开了。早期的。"}, {"type": "subtitle", "time": 3907.349, "timestamp": "01:05:07", "text": "他们已经离开了。它倒了。"}, {"type": "subtitle", "time": 3908.549, "timestamp": "01:05:08", "text": "我想我就把它放在这里吧。"}, {"type": "subtitle", "time": 3908.91, "timestamp": "01:05:08", "text": "早期的。"}, {"type": "subtitle", "time": 3922.71, "timestamp": "01:05:22", "text": "是的。是的。"}, {"type": "subtitle", "time": 3934.599, "timestamp": "01:05:34", "text": "是的。 但它看起来不像手表。"}, {"type": "subtitle", "time": 3936.839, "timestamp": "01:05:36", "text": "但它看起来不像手表。 即便如此，这里写的数字和黑板上的数字还是不一样。"}, {"type": "subtitle", "time": 3944.549, "timestamp": "01:05:44", "text": "奈绪酱，把这个背在背上。"}, {"type": "subtitle", "time": 3952.51, "timestamp": "01:05:52", "text": "这里有一块白板。"}]
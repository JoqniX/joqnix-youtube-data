[{"type": "subtitle", "time": 1084.549, "timestamp": "00:18:04", "text": "一个，"}, {"type": "subtitle", "time": 1087.11, "timestamp": "00:18:07", "text": "所有人都失败了。"}, {"type": "subtitle", "time": 1089.789, "timestamp": "00:18:09", "text": "我确定我已经完成了这部分，所以它应该就在这里。"}, {"type": "subtitle", "time": 1092.549, "timestamp": "00:18:12", "text": "啊，哦，"}, {"type": "subtitle", "time": 1097.19, "timestamp": "00:18:17", "text": "嘿。"}, {"type": "subtitle", "time": 1098.75, "timestamp": "00:18:18", "text": "嗯，当时它就在这里。"}, {"type": "subtitle", "time": 1100.029, "timestamp": "00:18:20", "text": "啊。"}, {"type": "subtitle", "time": 1101.31, "timestamp": "00:18:21", "text": "是的。"}, {"type": "subtitle", "time": 1104.31, "timestamp": "00:18:24", "text": "由于尚未升起国旗，说明事件还没有结束。"}, {"type": "subtitle", "time": 1105.63, "timestamp": "00:18:25", "text": "是否有可能地点？"}, {"type": "subtitle", "time": 1109.51, "timestamp": "00:18:29", "text": "某物"}, {"type": "subtitle", "time": 1111.789, "timestamp": "00:18:31", "text": "或许走这条路更好。"}, {"type": "subtitle", "time": 1112.23, "timestamp": "00:18:32", "text": "你有吗？"}, {"type": "subtitle", "time": 1113.19, "timestamp": "00:18:33", "text": "收到。"}, {"type": "subtitle", "time": 1119.75, "timestamp": "00:18:39", "text": "或许我应该走那条路。"}, {"type": "subtitle", "time": 1120.07, "timestamp": "00:18:40", "text": "是的。"}, {"type": "subtitle", "time": 1122.029, "timestamp": "00:18:42", "text": "我们走吧。"}, {"type": "subtitle", "time": 1127.19, "timestamp": "00:18:47", "text": "我搞不明白，因为它只是一个方向而已。"}, {"type": "subtitle", "time": 1128.59, "timestamp": "00:18:48", "text": "哦，等等。"}, {"type": "subtitle", "time": 1134.83, "timestamp": "00:18:54", "text": "哦，是激光。"}, {"type": "subtitle", "time": 1136.669, "timestamp": "00:18:56", "text": "它是皮革。孩子，"}, {"type": "subtitle", "time": 1137.83, "timestamp": "00:18:57", "text": "就在这里。"}]
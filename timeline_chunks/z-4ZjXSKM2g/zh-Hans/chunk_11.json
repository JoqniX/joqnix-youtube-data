[{"type": "subtitle", "time": 661.43, "timestamp": "00:11:01", "text": "好的。好的。"}, {"type": "subtitle", "time": 663.389, "timestamp": "00:11:03", "text": "他说话的时候麦克风又静音了。"}, {"type": "subtitle", "time": 664.509, "timestamp": "00:11:04", "text": "谢谢。"}, {"type": "subtitle", "time": 665.67, "timestamp": "00:11:05", "text": "静音类型的声音太多了。"}, {"type": "subtitle", "time": 666.389, "timestamp": "00:11:06", "text": "是的。"}, {"type": "subtitle", "time": 668.069, "timestamp": "00:11:08", "text": "一点点"}, {"type": "subtitle", "time": 670.87, "timestamp": "00:11:10", "text": "这样可以。我能做到吗？"}, {"type": "subtitle", "time": 679.03, "timestamp": "00:11:19", "text": "好了，我们走吧。"}, {"type": "subtitle", "time": 679.959, "timestamp": "00:11:19", "text": "我们走吧。 好的，我们按顺时针方向依次查看名单。"}, {"type": "subtitle", "time": 685.35, "timestamp": "00:11:25", "text": "图片，"}, {"type": "subtitle", "time": 700.99, "timestamp": "00:11:40", "text": "下一个"}, {"type": "subtitle", "time": 701.91, "timestamp": "00:11:41", "text": "我醒了。"}, {"type": "subtitle", "time": 703.87, "timestamp": "00:11:43", "text": "津马正在睡觉。"}, {"type": "subtitle", "time": 706.088, "timestamp": "00:11:46", "text": "我当时在喝蛋白奶昔。蛋白质。"}, {"type": "subtitle", "time": 712.069, "timestamp": "00:11:52", "text": "嗯，这次也是。"}]
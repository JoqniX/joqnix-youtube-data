[{"type": "subtitle", "time": 2040.83, "timestamp": "00:34:00", "text": "哦"}, {"type": "subtitle", "time": 2042.71, "timestamp": "00:34:02", "text": "我肯定通过"}, {"type": "subtitle", "time": 2043.19, "timestamp": "00:34:03", "text": "罗盘"}, {"type": "subtitle", "time": 2045.43, "timestamp": "00:34:05", "text": "似乎没有地方可以攀爬。那座山"}, {"type": "subtitle", "time": 2045.909, "timestamp": "00:34:05", "text": "射线"}, {"type": "subtitle", "time": 2046.99, "timestamp": "00:34:06", "text": "根据地图来看，情况就是这样。"}, {"type": "subtitle", "time": 2048.51, "timestamp": "00:34:08", "text": "是的。好的。"}, {"type": "subtitle", "time": 2050.75, "timestamp": "00:34:10", "text": "这意味着你可以空出双手。"}, {"type": "subtitle", "time": 2053.31, "timestamp": "00:34:13", "text": "是的。我没有那么多。"}, {"type": "subtitle", "time": 2055.829, "timestamp": "00:34:15", "text": "所以这意味着你可以携带它。各种各样的事情。"}, {"type": "subtitle", "time": 2056.589, "timestamp": "00:34:16", "text": "是的。"}, {"type": "subtitle", "time": 2058.869, "timestamp": "00:34:18", "text": "我做到了。"}, {"type": "subtitle", "time": 2061.71, "timestamp": "00:34:21", "text": "我想背着所有人。"}, {"type": "subtitle", "time": 2070.71, "timestamp": "00:34:30", "text": "我很害怕，因为我不知道他们有什么。"}, {"type": "subtitle", "time": 2070.829, "timestamp": "00:34:30", "text": "1"}, {"type": "subtitle", "time": 2073.589, "timestamp": "00:34:33", "text": "我虽然还没失去任何东西，但还是感到害怕。天亮了。"}, {"type": "subtitle", "time": 2078.23, "timestamp": "00:34:38", "text": "哦真的吗？"}, {"type": "subtitle", "time": 2084.669, "timestamp": "00:34:44", "text": "我觉得你不会经常把它弄丢吧？"}, {"type": "subtitle", "time": 2087.069, "timestamp": "00:34:47", "text": "难道不危险吗？这样做难道不冒险吗？"}, {"type": "subtitle", "time": 2088.069, "timestamp": "00:34:48", "text": "等一下。糟糕的。"}]
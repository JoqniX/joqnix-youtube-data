[{"type": "subtitle", "time": 8100.109, "timestamp": "02:15:00", "text": "这很困难。"}, {"type": "subtitle", "time": 8103.109, "timestamp": "02:15:03", "text": "那很困难。谢谢你，Ori-san。"}, {"type": "subtitle", "time": 8104.109, "timestamp": "02:15:04", "text": "表达清楚了吗？"}, {"type": "subtitle", "time": 8105.35, "timestamp": "02:15:05", "text": "是的。"}, {"type": "subtitle", "time": 8119.79, "timestamp": "02:15:19", "text": "天黑了。"}, {"type": "subtitle", "time": 8122.51, "timestamp": "02:15:22", "text": "天太黑了，什么都看不见。"}, {"type": "subtitle", "time": 8124.99, "timestamp": "02:15:24", "text": "没有什么。我应该怎么办？"}, {"type": "subtitle", "time": 8125.83, "timestamp": "02:15:25", "text": "嘿。"}, {"type": "subtitle", "time": 8127.39, "timestamp": "02:15:27", "text": "哦，刚才我看到灯光另一边有一个。"}, {"type": "subtitle", "time": 8132.31, "timestamp": "02:15:32", "text": "是的。"}, {"type": "subtitle", "time": 8143.669, "timestamp": "02:15:43", "text": "从这里开始。"}, {"type": "subtitle", "time": 8146.35, "timestamp": "02:15:46", "text": "哦，我去Gas先生家了。"}, {"type": "subtitle", "time": 8148.35, "timestamp": "02:15:48", "text": "是的。 [笑声]"}, {"type": "subtitle", "time": 8152.109, "timestamp": "02:15:52", "text": "是的。这就是我。是的。"}, {"type": "subtitle", "time": 8158.75, "timestamp": "02:15:58", "text": "欢迎回来。"}]
[{"type": "subtitle", "time": 5105.83, "timestamp": "01:25:05", "text": "它们有两个"}, {"type": "subtitle", "time": 5116.39, "timestamp": "01:25:16", "text": "去打水的人和去上厕所的人。"}, {"type": "subtitle", "time": 5119.149, "timestamp": "01:25:19", "text": "我想我应该看看这里。这里还有人。"}, {"type": "subtitle", "time": 5122.43, "timestamp": "01:25:22", "text": "我认为他们正在同时进行各种事情。"}, {"type": "subtitle", "time": 5148.149, "timestamp": "01:25:48", "text": "一个，"}, {"type": "subtitle", "time": 5150.55, "timestamp": "01:25:50", "text": "无法按下的按钮"}, {"type": "subtitle", "time": 5154.709, "timestamp": "01:25:54", "text": "世界上没有不能按的按钮。"}]
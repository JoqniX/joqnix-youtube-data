[{"type": "subtitle", "time": 840.389, "timestamp": "00:14:00", "text": "你是怎么做到的？"}, {"type": "subtitle", "time": 841.87, "timestamp": "00:14:01", "text": "这是人会做的事情吗？"}, {"type": "subtitle", "time": 842.79, "timestamp": "00:14:02", "text": "哦，等等，我说错了吗？"}, {"type": "subtitle", "time": 844.629, "timestamp": "00:14:04", "text": "把这个反过来。"}, {"type": "subtitle", "time": 845.509, "timestamp": "00:14:05", "text": "啊，完成了，完成了，完成了。"}, {"type": "subtitle", "time": 847.15, "timestamp": "00:14:07", "text": "啊，我明白了。哦，你说得对。"}, {"type": "subtitle", "time": 854.119, "timestamp": "00:14:14", "text": "好的，那你可以留着它。我就这么保持现状吗？"}, {"type": "subtitle", "time": 863.67, "timestamp": "00:14:23", "text": "把它放进你的背包里。"}, {"type": "subtitle", "time": 865.91, "timestamp": "00:14:25", "text": "哦，对。我得把它带走。"}, {"type": "subtitle", "time": 868.389, "timestamp": "00:14:28", "text": "我需要把它带走。"}, {"type": "subtitle", "time": 871.389, "timestamp": "00:14:31", "text": "哦，我不知道这东西里有什么。"}, {"type": "subtitle", "time": 887.949, "timestamp": "00:14:47", "text": "指南针。"}, {"type": "subtitle", "time": 888.47, "timestamp": "00:14:48", "text": "是的。"}, {"type": "subtitle", "time": 889.269, "timestamp": "00:14:49", "text": "哦。"}, {"type": "subtitle", "time": 891.59, "timestamp": "00:14:51", "text": "好的"}, {"type": "subtitle", "time": 898.71, "timestamp": "00:14:58", "text": "最后，贝尔"}]
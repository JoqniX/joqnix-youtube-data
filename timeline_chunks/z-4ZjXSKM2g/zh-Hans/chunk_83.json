[{"type": "subtitle", "time": 4982.47, "timestamp": "01:23:02", "text": "但那个地方还有两个谜团。"}, {"type": "subtitle", "time": 4983.6, "timestamp": "01:23:03", "text": "。 哦真的吗？"}, {"type": "subtitle", "time": 4985.48, "timestamp": "01:23:05", "text": "哦真的吗？ 什么？土豆"}, {"type": "subtitle", "time": 4986.36, "timestamp": "01:23:06", "text": "什么？土豆 我想试试能不能把它推下去，或者更确切地说，在我待在这里的时候，看看能不能关注一下它。"}, {"type": "subtitle", "time": 5003.51, "timestamp": "01:23:23", "text": "这似乎不太可能。"}, {"type": "subtitle", "time": 5005.709, "timestamp": "01:23:25", "text": "我现在明白了。"}, {"type": "subtitle", "time": 5026.03, "timestamp": "01:23:46", "text": "所以这"}, {"type": "subtitle", "time": 5028.51, "timestamp": "01:23:48", "text": "没有按钮可以按。"}, {"type": "subtitle", "time": 5029.189, "timestamp": "01:23:49", "text": "是的，是的，是的。"}]
[{"type": "subtitle", "time": 8340.23, "timestamp": "02:19:00", "text": "不是背包。"}, {"type": "subtitle", "time": 8345.549, "timestamp": "02:19:05", "text": "是的，是的，是的，是的。"}, {"type": "subtitle", "time": 8346.23, "timestamp": "02:19:06", "text": "这是正确的。"}, {"type": "subtitle", "time": 8355.629, "timestamp": "02:19:15", "text": "[笑声]"}, {"type": "subtitle", "time": 8356.75, "timestamp": "02:19:16", "text": "它很大吗？"}, {"type": "subtitle", "time": 8369.07, "timestamp": "02:19:29", "text": "哦，但是它装不上。"}, {"type": "subtitle", "time": 8370.349, "timestamp": "02:19:30", "text": "他们不让我这么做。"}, {"type": "subtitle", "time": 8371.429, "timestamp": "02:19:31", "text": "这行不通。"}, {"type": "subtitle", "time": 8372.549, "timestamp": "02:19:32", "text": "是的，真的。"}, {"type": "subtitle", "time": 8373.349, "timestamp": "02:19:33", "text": "它太大了。"}, {"type": "subtitle", "time": 8375.07, "timestamp": "02:19:35", "text": "我想我可以在上面装个铃铛。"}, {"type": "subtitle", "time": 8376.91, "timestamp": "02:19:36", "text": "啊，我可以把它附加上去。我不能。"}, {"type": "subtitle", "time": 8378.95, "timestamp": "02:19:38", "text": "哦，你还可以加个铃铛。"}, {"type": "subtitle", "time": 8381.27, "timestamp": "02:19:41", "text": "你不能开灯吗？"}, {"type": "subtitle", "time": 8383.389, "timestamp": "02:19:43", "text": "这件衣服可能太大了，穿不了。"}, {"type": "subtitle", "time": 8385.669, "timestamp": "02:19:45", "text": "我懂了。"}, {"type": "subtitle", "time": 8389.99, "timestamp": "02:19:49", "text": "一定。一个，"}, {"type": "subtitle", "time": 8392.23, "timestamp": "02:19:52", "text": "或许你可以用激光笔？大概。"}]
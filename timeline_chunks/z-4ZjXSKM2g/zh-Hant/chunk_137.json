[{"type": "subtitle", "time": 8232.349, "timestamp": "02:17:12", "text": "我以為可能根本沒有。"}, {"type": "subtitle", "time": 8233.87, "timestamp": "02:17:13", "text": "你要去哪裡？"}, {"type": "subtitle", "time": 8234.669, "timestamp": "02:17:14", "text": "啊，你說得對。"}, {"type": "subtitle", "time": 8240.429, "timestamp": "02:17:20", "text": "也許。"}, {"type": "subtitle", "time": 8254.23, "timestamp": "02:17:34", "text": "[嗤笑]"}, {"type": "subtitle", "time": 8255.389, "timestamp": "02:17:35", "text": "我可以把它背在背上嗎？"}, {"type": "subtitle", "time": 8258.11, "timestamp": "02:17:38", "text": "如果你把它放在背上"}, {"type": "subtitle", "time": 8264.309, "timestamp": "02:17:44", "text": "看來我騎不了它了。哦，看來它不合適。"}, {"type": "subtitle", "time": 8266.589, "timestamp": "02:17:46", "text": "哦，嘿，你按得太用力了。"}, {"type": "subtitle", "time": 8268.95, "timestamp": "02:17:48", "text": "我被逼退了。我們被擊退了。"}, {"type": "subtitle", "time": 8271.79, "timestamp": "02:17:51", "text": "正在進行中。一個，"}, {"type": "subtitle", "time": 8272.349, "timestamp": "02:17:52", "text": "難道不可能嗎？"}, {"type": "subtitle", "time": 8273.309, "timestamp": "02:17:53", "text": "它太大了。"}]
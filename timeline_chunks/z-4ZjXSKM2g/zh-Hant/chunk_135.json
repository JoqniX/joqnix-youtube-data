[{"type": "subtitle", "time": 8100.109, "timestamp": "02:15:00", "text": "這很困難。"}, {"type": "subtitle", "time": 8103.109, "timestamp": "02:15:03", "text": "那很困難。謝謝你，Ori-san。"}, {"type": "subtitle", "time": 8104.109, "timestamp": "02:15:04", "text": "表達清楚了嗎？"}, {"type": "subtitle", "time": 8105.35, "timestamp": "02:15:05", "text": "是的。"}, {"type": "subtitle", "time": 8119.79, "timestamp": "02:15:19", "text": "天黑了。"}, {"type": "subtitle", "time": 8122.51, "timestamp": "02:15:22", "text": "天太黑了，什麼都看不見。"}, {"type": "subtitle", "time": 8124.99, "timestamp": "02:15:24", "text": "沒有什麼。我該怎麼辦？"}, {"type": "subtitle", "time": 8125.83, "timestamp": "02:15:25", "text": "嘿。"}, {"type": "subtitle", "time": 8127.39, "timestamp": "02:15:27", "text": "哦，剛才我看到燈光另一邊有一個。"}, {"type": "subtitle", "time": 8132.31, "timestamp": "02:15:32", "text": "是的。"}, {"type": "subtitle", "time": 8143.669, "timestamp": "02:15:43", "text": "從這裡開始。"}, {"type": "subtitle", "time": 8146.35, "timestamp": "02:15:46", "text": "哦，我去Gas先生家了。"}, {"type": "subtitle", "time": 8148.35, "timestamp": "02:15:48", "text": "是的。 [笑聲]"}, {"type": "subtitle", "time": 8152.109, "timestamp": "02:15:52", "text": "是的。這就是我。是的。"}, {"type": "subtitle", "time": 8158.75, "timestamp": "02:15:58", "text": "歡迎回來。"}]
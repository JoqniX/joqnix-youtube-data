[{"type": "subtitle", "time": 6735.189, "timestamp": "01:52:15", "text": "我很幸運。"}, {"type": "subtitle", "time": 6735.589, "timestamp": "01:52:15", "text": "圖片，"}, {"type": "subtitle", "time": 6738.27, "timestamp": "01:52:18", "text": "我想知道打開它之後它會不會出來？"}, {"type": "subtitle", "time": 6741.229, "timestamp": "01:52:21", "text": "啊，完成了。"}, {"type": "subtitle", "time": 6742.109, "timestamp": "01:52:22", "text": "一個，"}, {"type": "subtitle", "time": 6743.79, "timestamp": "01:52:23", "text": "先生。"}, {"type": "subtitle", "time": 6745.83, "timestamp": "01:52:25", "text": "那"}, {"type": "subtitle", "time": 6747.99, "timestamp": "01:52:27", "text": "是的，我當時也在場。"}, {"type": "subtitle", "time": 6750.87, "timestamp": "01:52:30", "text": "它在洛威路的中途結束。我下車了。"}, {"type": "subtitle", "time": 6756.629, "timestamp": "01:52:36", "text": "[笑聲]"}, {"type": "subtitle", "time": 6762.589, "timestamp": "01:52:42", "text": "歡迎回來。 [笑聲]"}, {"type": "subtitle", "time": 6770.95, "timestamp": "01:52:50", "text": "那很棒。"}, {"type": "subtitle", "time": 6775.03, "timestamp": "01:52:55", "text": "5"}, {"type": "subtitle", "time": 6777.91, "timestamp": "01:52:57", "text": "我們當時在討論，感覺好像可以把他們都聚集起來。"}]
[{"type": "subtitle", "time": 2040.83, "timestamp": "00:34:00", "text": "哦"}, {"type": "subtitle", "time": 2042.71, "timestamp": "00:34:02", "text": "我肯定透過"}, {"type": "subtitle", "time": 2043.19, "timestamp": "00:34:03", "text": "羅盤"}, {"type": "subtitle", "time": 2045.43, "timestamp": "00:34:05", "text": "似乎沒有地方可以攀爬。那座山"}, {"type": "subtitle", "time": 2045.909, "timestamp": "00:34:05", "text": "射線"}, {"type": "subtitle", "time": 2046.99, "timestamp": "00:34:06", "text": "根據地圖來看，情況就是這樣。"}, {"type": "subtitle", "time": 2048.51, "timestamp": "00:34:08", "text": "是的。好的。"}, {"type": "subtitle", "time": 2050.75, "timestamp": "00:34:10", "text": "這意味著你可以空出雙手。"}, {"type": "subtitle", "time": 2053.31, "timestamp": "00:34:13", "text": "是的。我沒有那麼多。"}, {"type": "subtitle", "time": 2055.829, "timestamp": "00:34:15", "text": "所以這意味著你可以攜帶它。各種各樣的事情。"}, {"type": "subtitle", "time": 2056.589, "timestamp": "00:34:16", "text": "是的。"}, {"type": "subtitle", "time": 2058.869, "timestamp": "00:34:18", "text": "我做到了。"}, {"type": "subtitle", "time": 2061.71, "timestamp": "00:34:21", "text": "我想背著所有人。"}, {"type": "subtitle", "time": 2070.71, "timestamp": "00:34:30", "text": "我很害怕，因為我不知道他們有什麼。"}, {"type": "subtitle", "time": 2070.829, "timestamp": "00:34:30", "text": "1"}, {"type": "subtitle", "time": 2073.589, "timestamp": "00:34:33", "text": "我雖然還沒失去任何東西，但我還是感到害怕。天亮了。"}, {"type": "subtitle", "time": 2078.23, "timestamp": "00:34:38", "text": "哦真的嗎？"}, {"type": "subtitle", "time": 2084.669, "timestamp": "00:34:44", "text": "我覺得你不會常常把它弄丟吧？"}, {"type": "subtitle", "time": 2087.069, "timestamp": "00:34:47", "text": "難道不危險嗎？這樣做不冒險嗎？"}, {"type": "subtitle", "time": 2088.069, "timestamp": "00:34:48", "text": "等一下。糟糕的。"}]
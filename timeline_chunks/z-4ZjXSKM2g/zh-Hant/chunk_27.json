[{"type": "subtitle", "time": 1620.269, "timestamp": "00:27:00", "text": "是的。"}, {"type": "subtitle", "time": 1620.59, "timestamp": "00:27:00", "text": "所以"}, {"type": "subtitle", "time": 1621.23, "timestamp": "00:27:01", "text": "等一下。"}, {"type": "subtitle", "time": 1622.07, "timestamp": "00:27:02", "text": "我們走吧？"}, {"type": "subtitle", "time": 1629.11, "timestamp": "00:27:09", "text": "J，這就是原因"}, {"type": "subtitle", "time": 1630.51, "timestamp": "00:27:10", "text": "我們一共四個人，對吧？ [笑聲]"}, {"type": "subtitle", "time": 1632.029, "timestamp": "00:27:12", "text": "不，不是那樣。"}, {"type": "subtitle", "time": 1634.19, "timestamp": "00:27:14", "text": "我覺得我們去下一個地方的時候會遇到一些有趣的事情。"}, {"type": "subtitle", "time": 1635.87, "timestamp": "00:27:15", "text": "只有第一位患者會接受雷射治療。"}, {"type": "subtitle", "time": 1638.07, "timestamp": "00:27:18", "text": "我們現在就一起做吧"}, {"type": "subtitle", "time": 1640.63, "timestamp": "00:27:20", "text": "我跟你一起去。用雷射。"}, {"type": "subtitle", "time": 1652.31, "timestamp": "00:27:32", "text": "是的。 222"}, {"type": "subtitle", "time": 1655.19, "timestamp": "00:27:35", "text": "如果我們在那裡分頭行動，豈不是更好？"}, {"type": "subtitle", "time": 1655.95, "timestamp": "00:27:35", "text": "我同意。"}, {"type": "subtitle", "time": 1656.389, "timestamp": "00:27:36", "text": "然後是4"}, {"type": "subtitle", "time": 1664.909, "timestamp": "00:27:44", "text": "因為距離很遠。"}, {"type": "subtitle", "time": 1667.35, "timestamp": "00:27:47", "text": "啊，確實很遠。"}, {"type": "subtitle", "time": 1668.83, "timestamp": "00:27:48", "text": "眼睛"}, {"type": "subtitle", "time": 1670.63, "timestamp": "00:27:50", "text": "我同意。"}, {"type": "subtitle", "time": 1677.029, "timestamp": "00:27:57", "text": "我先上去看看。"}]
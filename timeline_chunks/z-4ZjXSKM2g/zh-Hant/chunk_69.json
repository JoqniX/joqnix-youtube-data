[{"type": "subtitle", "time": 4140.99, "timestamp": "01:09:00", "text": "是的。"}, {"type": "subtitle", "time": 4149.59, "timestamp": "01:09:09", "text": "啊，"}, {"type": "subtitle", "time": 4152.189, "timestamp": "01:09:12", "text": "這個正在減少。"}, {"type": "subtitle", "time": 4154.47, "timestamp": "01:09:14", "text": "這邊在減少，這邊在增加。"}, {"type": "subtitle", "time": 4157.269, "timestamp": "01:09:17", "text": "這個數字正在上升。較低的值正在增加。"}, {"type": "subtitle", "time": 4158.07, "timestamp": "01:09:18", "text": "向下"}, {"type": "subtitle", "time": 4163.63, "timestamp": "01:09:23", "text": "哦，如果你向後移動，它就會向下移動。"}, {"type": "subtitle", "time": 4165.789, "timestamp": "01:09:25", "text": "啊，我明白了。好的，這邊請。"}, {"type": "subtitle", "time": 4173.47, "timestamp": "01:09:33", "text": "325"}, {"type": "subtitle", "time": 4185.349, "timestamp": "01:09:45", "text": "我能做到嗎？"}, {"type": "subtitle", "time": 4187.03, "timestamp": "01:09:47", "text": "不，不，不，等一下。"}, {"type": "subtitle", "time": 4189.829, "timestamp": "01:09:49", "text": "哦，不，我不能。 [笑聲]"}, {"type": "subtitle", "time": 4191.749, "timestamp": "01:09:51", "text": "哦哦哦"}, {"type": "subtitle", "time": 4193.348, "timestamp": "01:09:53", "text": "即使你完全理解了，你也看不到這個人。"}, {"type": "subtitle", "time": 4194.95, "timestamp": "01:09:54", "text": "[笑聲]"}, {"type": "subtitle", "time": 4197.27, "timestamp": "01:09:57", "text": "我看不見。背對著我的人我看不見。"}]
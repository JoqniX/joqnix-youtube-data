[{"type": "subtitle", "time": 4202.669, "timestamp": "01:10:02", "text": "[笑聲]"}, {"type": "subtitle", "time": 4205.27, "timestamp": "01:10:05", "text": "歸根結底，事情並非如此。"}, {"type": "subtitle", "time": 4211.75, "timestamp": "01:10:11", "text": "當然，在行走時"}, {"type": "subtitle", "time": 4212.83, "timestamp": "01:10:12", "text": "從後面可以看到。"}, {"type": "subtitle", "time": 4213.669, "timestamp": "01:10:13", "text": "是的。"}, {"type": "subtitle", "time": 4227.11, "timestamp": "01:10:27", "text": "[笑聲]"}, {"type": "subtitle", "time": 4243.128, "timestamp": "01:10:43", "text": "普莉桑去哪了？"}, {"type": "subtitle", "time": 4244.149, "timestamp": "01:10:44", "text": "[笑聲]"}, {"type": "subtitle", "time": 4246.43, "timestamp": "01:10:46", "text": "嗯？馬鈴薯."}, {"type": "subtitle", "time": 4248.79, "timestamp": "01:10:48", "text": "嗯？"}, {"type": "subtitle", "time": 4258.47, "timestamp": "01:10:58", "text": "我簡直不敢相信他竟然把貝爾丟下了。"}, {"type": "subtitle", "time": 4259.87, "timestamp": "01:10:59", "text": "雷射."}]
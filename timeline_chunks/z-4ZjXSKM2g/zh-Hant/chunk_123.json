[{"type": "subtitle", "time": 7381.75, "timestamp": "02:03:01", "text": "哦真的嗎？問題是你是否真的能和他們交談。"}, {"type": "subtitle", "time": 7382.669, "timestamp": "02:03:02", "text": "因為我孤身一人。"}, {"type": "subtitle", "time": 7388.35, "timestamp": "02:03:08", "text": "1"}, {"type": "subtitle", "time": 7395.35, "timestamp": "02:03:15", "text": "哦，我們也需要把這一點傳達給他們。"}, {"type": "subtitle", "time": 7417.79, "timestamp": "02:03:37", "text": "超出"}, {"type": "subtitle", "time": 7420.189, "timestamp": "02:03:40", "text": "這是"}, {"type": "subtitle", "time": 7437.43, "timestamp": "02:03:57", "text": "令人煩惱。"}]
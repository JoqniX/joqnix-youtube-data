[{"type": "subtitle", "time": 5281.51, "timestamp": "01:28:01", "text": "哦，然後我想我會按下那個按鈕。死亡"}, {"type": "subtitle", "time": 5283.43, "timestamp": "01:28:03", "text": "所以。"}, {"type": "subtitle", "time": 5290.43, "timestamp": "01:28:10", "text": "就定在10左右吧。 10左右"}, {"type": "subtitle", "time": 5292.55, "timestamp": "01:28:12", "text": "愛麗絲。"}, {"type": "subtitle", "time": 5295.75, "timestamp": "01:28:15", "text": "現在是11"}, {"type": "subtitle", "time": 5298.87, "timestamp": "01:28:18", "text": "如果它再次下跌，然後又上漲…"}, {"type": "subtitle", "time": 5305.83, "timestamp": "01:28:25", "text": "開始了。我同意。我又做到了。"}, {"type": "subtitle", "time": 5314.39, "timestamp": "01:28:34", "text": "那座還沒倒塌。哦，他們下車了。"}, {"type": "subtitle", "time": 5318.03, "timestamp": "01:28:38", "text": "好的。我被指派了一項相當重要的任務。看"}, {"type": "subtitle", "time": 5333.629, "timestamp": "01:28:53", "text": "好吧，我想我應該去看一下。即使這樣，也超級棒，不，"}, {"type": "subtitle", "time": 5336.189, "timestamp": "01:28:56", "text": "我什麼都看不見。除非用望遠鏡看，否則根本看不到它。"}]
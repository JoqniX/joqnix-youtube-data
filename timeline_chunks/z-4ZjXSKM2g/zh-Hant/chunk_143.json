[{"type": "subtitle", "time": 8584.55, "timestamp": "02:23:04", "text": "改變。是的，情況會改變的。"}, {"type": "subtitle", "time": 8586.59, "timestamp": "02:23:06", "text": "哦，那我得從裡面進去才行。"}, {"type": "subtitle", "time": 8589.389, "timestamp": "02:23:09", "text": "中等的"}, {"type": "subtitle", "time": 8591.79, "timestamp": "02:23:11", "text": "這太不合理了。"}, {"type": "subtitle", "time": 8597.03, "timestamp": "02:23:17", "text": "這可以用來傳達"}, {"type": "subtitle", "time": 8597.63, "timestamp": "02:23:17", "text": "這就是原因。"}, {"type": "subtitle", "time": 8599.95, "timestamp": "02:23:19", "text": "是的。"}, {"type": "subtitle", "time": 8602.03, "timestamp": "02:23:22", "text": "啊。"}, {"type": "subtitle", "time": 8607.429, "timestamp": "02:23:27", "text": "我同意。"}, {"type": "subtitle", "time": 8610.15, "timestamp": "02:23:30", "text": "他們正從那個方向過來。"}, {"type": "subtitle", "time": 8610.59, "timestamp": "02:23:30", "text": "明白了。"}, {"type": "subtitle", "time": 8613.389, "timestamp": "02:23:33", "text": "它將被傳遞到另一邊。這"}, {"type": "subtitle", "time": 8628.23, "timestamp": "02:23:48", "text": "關閉一次。"}, {"type": "subtitle", "time": 8634.07, "timestamp": "02:23:54", "text": "哦，從那裡看很正常。這是"}, {"type": "subtitle", "time": 8636.63, "timestamp": "02:23:56", "text": "是的。嗯？你看到了嗎？"}]
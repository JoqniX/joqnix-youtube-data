[{"type": "subtitle", "time": 3600.39, "timestamp": "01:00:00", "text": "還剩最後一個。"}, {"type": "subtitle", "time": 3608.589, "timestamp": "01:00:08", "text": "葛達"}, {"type": "subtitle", "time": 3609.75, "timestamp": "01:00:09", "text": "我做到了。"}, {"type": "subtitle", "time": 3618.67, "timestamp": "01:00:18", "text": "很好。"}, {"type": "subtitle", "time": 3620.75, "timestamp": "01:00:20", "text": "取得進展是好事。"}, {"type": "subtitle", "time": 3622.349, "timestamp": "01:00:22", "text": "那太棒了。"}, {"type": "subtitle", "time": 3624.23, "timestamp": "01:00:24", "text": "它由優質材料製成。"}, {"type": "subtitle", "time": 3625.27, "timestamp": "01:00:25", "text": "哦。"}, {"type": "subtitle", "time": 3627.349, "timestamp": "01:00:27", "text": "再來一個，這招可能就管用了。一個"}, {"type": "subtitle", "time": 3628.731, "timestamp": "01:00:28", "text": "一個。"}, {"type": "subtitle", "time": 3629.71, "timestamp": "01:00:29", "text": "[笑聲]"}, {"type": "subtitle", "time": 3631.95, "timestamp": "01:00:31", "text": "我們走吧？我們上去吧。"}, {"type": "subtitle", "time": 3632.99, "timestamp": "01:00:32", "text": "好的，我們走吧。"}, {"type": "subtitle", "time": 3634.799, "timestamp": "01:00:34", "text": "我們走吧。 外面真黑。使用。"}, {"type": "subtitle", "time": 3637.039, "timestamp": "01:00:37", "text": "外面真黑。使用。 哦，天黑了。"}, {"type": "subtitle", "time": 3639.76, "timestamp": "01:00:39", "text": "哦，天黑了。 沒人帶手電筒。"}]
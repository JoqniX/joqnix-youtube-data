[{"type": "subtitle", "time": 7981.95, "timestamp": "02:13:01", "text": "從上一行底部開始，向右移動一個方塊，比前面那一行向右移動一個方塊。"}, {"type": "subtitle", "time": 7983.51, "timestamp": "02:13:03", "text": "第二。"}, {"type": "subtitle", "time": 7985.99, "timestamp": "02:13:05", "text": "我之前是第三名，但現在是第二名了。倒數第二個"}, {"type": "subtitle", "time": 7990.39, "timestamp": "02:13:10", "text": "驚人的。"}, {"type": "subtitle", "time": 7994.03, "timestamp": "02:13:14", "text": "就是剛才那輛車右邊那台？"}, {"type": "subtitle", "time": 7995.109, "timestamp": "02:13:15", "text": "倒數第二個。"}, {"type": "subtitle", "time": 8002.83, "timestamp": "02:13:22", "text": "請。請。"}, {"type": "subtitle", "time": 8004.91, "timestamp": "02:13:24", "text": "我真的很驚訝。"}, {"type": "subtitle", "time": 8033.069, "timestamp": "02:13:53", "text": "再來一個。"}, {"type": "subtitle", "time": 8035.149, "timestamp": "02:13:55", "text": "啊，完成了。"}, {"type": "subtitle", "time": 8035.589, "timestamp": "02:13:55", "text": "可愛的。"}, {"type": "subtitle", "time": 8036.069, "timestamp": "02:13:56", "text": "啊。"}, {"type": "subtitle", "time": 8038.149, "timestamp": "02:13:58", "text": "是的。是的。"}]
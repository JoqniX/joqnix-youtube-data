[{"type": "subtitle", "time": 4381.07, "timestamp": "01:13:01", "text": "我找到它只是因為它掉下來了。"}, {"type": "subtitle", "time": 4381.55, "timestamp": "01:13:01", "text": "這是正確的。"}, {"type": "subtitle", "time": 4382.99, "timestamp": "01:13:02", "text": "一個，"}, {"type": "subtitle", "time": 4385.31, "timestamp": "01:13:05", "text": "所以也許它就在那邊。"}, {"type": "subtitle", "time": 4386.669, "timestamp": "01:13:06", "text": "一個"}, {"type": "subtitle", "time": 4396.51, "timestamp": "01:13:16", "text": "是的。 3"}, {"type": "subtitle", "time": 4398.39, "timestamp": "01:13:18", "text": "大約一人。啊，但是啊，"}, {"type": "subtitle", "time": 4399.189, "timestamp": "01:13:19", "text": "我們四個人可以嗎？"}, {"type": "subtitle", "time": 4400.709, "timestamp": "01:13:20", "text": "一個，"}, {"type": "subtitle", "time": 4417.709, "timestamp": "01:13:37", "text": "是的。"}, {"type": "subtitle", "time": 4419.87, "timestamp": "01:13:39", "text": "去。"}, {"type": "subtitle", "time": 4421.945, "timestamp": "01:13:41", "text": "它從極高的地方落了下來。下車。視野非常狹窄。"}, {"type": "subtitle", "time": 4436.47, "timestamp": "01:13:56", "text": "只有右邊那家店開著。"}, {"type": "subtitle", "time": 4436.83, "timestamp": "01:13:56", "text": "是的。"}, {"type": "subtitle", "time": 4438.75, "timestamp": "01:13:58", "text": "而且，我想要雙份。"}]
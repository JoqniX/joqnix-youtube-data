[{"type": "subtitle", "time": 8841.99, "timestamp": "02:27:21", "text": "哦，你說得對。"}, {"type": "subtitle", "time": 8844.83, "timestamp": "02:27:24", "text": "這不是巴丹島嗎？"}, {"type": "subtitle", "time": 8846.91, "timestamp": "02:27:26", "text": "啊，是的。謝謝。"}, {"type": "subtitle", "time": 8847.269, "timestamp": "02:27:27", "text": "是的。"}, {"type": "subtitle", "time": 8848.83, "timestamp": "02:27:28", "text": "哦，我沒有。"}, {"type": "subtitle", "time": 8849.309, "timestamp": "02:27:29", "text": "是的。"}, {"type": "subtitle", "time": 8851.63, "timestamp": "02:27:31", "text": "這不可能。這不可能。這不可能。"}, {"type": "subtitle", "time": 8852.79, "timestamp": "02:27:32", "text": "哦，我按不動它。"}, {"type": "subtitle", "time": 8853.52, "timestamp": "02:27:33", "text": "我按不動它。 我按不動它。它達不到。"}, {"type": "subtitle", "time": 8855.96, "timestamp": "02:27:35", "text": "我按不動它。它達不到。 一個，"}, {"type": "subtitle", "time": 8856.92, "timestamp": "02:27:36", "text": "一個， 裡面有個按鈕，"}, {"type": "subtitle", "time": 8859.439, "timestamp": "02:27:39", "text": "裡面有個按鈕， 所以，因為我們無法溝通，嗯，"}, {"type": "subtitle", "time": 8861.8, "timestamp": "02:27:41", "text": "所以，因為我們無法溝通，嗯， 一旦你關閉它"}, {"type": "subtitle", "time": 8863.12, "timestamp": "02:27:43", "text": "一旦你關閉它 我們離開夜晚，另一邊的人接下來就進去了。"}, {"type": "subtitle", "time": 8874.91, "timestamp": "02:27:54", "text": "這個房間的天花板上有四個按鈕。"}, {"type": "subtitle", "time": 8876.63, "timestamp": "02:27:56", "text": "一個，"}, {"type": "subtitle", "time": 8877.269, "timestamp": "02:27:57", "text": "一定。"}, {"type": "subtitle", "time": 8877.67, "timestamp": "02:27:57", "text": "圖片，"}, {"type": "subtitle", "time": 8878.79, "timestamp": "02:27:58", "text": "是的，有。 4"}, {"type": "subtitle", "time": 8879.79, "timestamp": "02:27:59", "text": "總是。"}]
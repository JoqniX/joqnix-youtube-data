[{"type": "subtitle", "time": 4969.99, "timestamp": "01:22:49", "text": "他們進來了。"}, {"type": "subtitle", "time": 4972.35, "timestamp": "01:22:52", "text": "我不能來這裡"}, {"type": "subtitle", "time": 4974.79, "timestamp": "01:22:54", "text": "我想知道有沒有辦法把它關掉。"}, {"type": "subtitle", "time": 4978.39, "timestamp": "01:22:58", "text": "看來他們沒能成功施壓。是的。我按不動它。"}, {"type": "subtitle", "time": 4979.95, "timestamp": "01:22:59", "text": "腰部"}]
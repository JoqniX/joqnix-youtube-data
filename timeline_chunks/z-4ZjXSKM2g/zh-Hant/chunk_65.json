[{"type": "subtitle", "time": 3903.829, "timestamp": "01:05:03", "text": "為什麼？"}, {"type": "subtitle", "time": 3906.029, "timestamp": "01:05:06", "text": "哦，他們已經走了。他們已經離開了。早期的。"}, {"type": "subtitle", "time": 3907.349, "timestamp": "01:05:07", "text": "他們已經離開了。它倒了。"}, {"type": "subtitle", "time": 3908.549, "timestamp": "01:05:08", "text": "我想我就把它放在這裡吧。"}, {"type": "subtitle", "time": 3908.91, "timestamp": "01:05:08", "text": "早期的。"}, {"type": "subtitle", "time": 3922.71, "timestamp": "01:05:22", "text": "是的。是的。"}, {"type": "subtitle", "time": 3934.599, "timestamp": "01:05:34", "text": "是的。 但它看起來不像手錶。"}, {"type": "subtitle", "time": 3936.839, "timestamp": "01:05:36", "text": "但它看起來不像手錶。 即便如此，這裡寫的數字和黑板上的數字還是不一樣。"}, {"type": "subtitle", "time": 3944.549, "timestamp": "01:05:44", "text": "奈緒醬，把這個背在背上。"}, {"type": "subtitle", "time": 3952.51, "timestamp": "01:05:52", "text": "這裡有一塊白板。"}]
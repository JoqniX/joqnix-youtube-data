[{"type": "subtitle", "time": 10507.349, "timestamp": "02:55:07", "text": "一個，"}, {"type": "subtitle", "time": 10509.71, "timestamp": "02:55:09", "text": "我分不清這是左邊還是右邊。"}, {"type": "subtitle", "time": 10510.59, "timestamp": "02:55:10", "text": "是的，是的，是的。"}, {"type": "subtitle", "time": 10519.349, "timestamp": "02:55:19", "text": "哦，呃，這邊請。"}, {"type": "subtitle", "time": 10519.71, "timestamp": "02:55:19", "text": "一個，"}, {"type": "subtitle", "time": 10522.59, "timestamp": "02:55:22", "text": "啊。啊，我明白了。對，對。"}, {"type": "subtitle", "time": 10523.469, "timestamp": "02:55:23", "text": "這個，這個，這個，"}, {"type": "subtitle", "time": 10525.63, "timestamp": "02:55:25", "text": "不是側躺著的那隻。"}, {"type": "subtitle", "time": 10527.469, "timestamp": "02:55:27", "text": "不是這個。"}, {"type": "subtitle", "time": 10529.309, "timestamp": "02:55:29", "text": "恰恰相反。"}, {"type": "subtitle", "time": 10530.07, "timestamp": "02:55:30", "text": "撤銷"}, {"type": "subtitle", "time": 10531.75, "timestamp": "02:55:31", "text": "也許"}, {"type": "subtitle", "time": 10534.429, "timestamp": "02:55:34", "text": "不。"}, {"type": "subtitle", "time": 10534.99, "timestamp": "02:55:34", "text": "圖片，"}, {"type": "subtitle", "time": 10535.131, "timestamp": "02:55:35", "text": "難道沒有嗎？反過來則不成立。啊，那肯定就是這個了。"}]
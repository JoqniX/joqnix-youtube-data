[{"type": "subtitle", "time": 6790.47, "timestamp": "01:53:10", "text": "是的。"}, {"type": "subtitle", "time": 6794.55, "timestamp": "01:53:14", "text": "好的，你去做吧。"}, {"type": "subtitle", "time": 6796.47, "timestamp": "01:53:16", "text": "還沒結束。一定。"}, {"type": "subtitle", "time": 6798.87, "timestamp": "01:53:18", "text": "是的。我還沒完成座標那部分工作。"}, {"type": "subtitle", "time": 6799.87, "timestamp": "01:53:19", "text": "是的。"}, {"type": "subtitle", "time": 6812.99, "timestamp": "01:53:32", "text": "我把它剝掉了。"}, {"type": "subtitle", "time": 6817.39, "timestamp": "01:53:37", "text": "好了，我們走吧。"}, {"type": "subtitle", "time": 6818.35, "timestamp": "01:53:38", "text": "好的。好的。好的。"}, {"type": "subtitle", "time": 6819.87, "timestamp": "01:53:39", "text": "是的。我們走吧。"}, {"type": "subtitle", "time": 6820.79, "timestamp": "01:53:40", "text": "是的。"}, {"type": "subtitle", "time": 6822.548, "timestamp": "01:53:42", "text": "雷射.雷射"}, {"type": "subtitle", "time": 6823.229, "timestamp": "01:53:43", "text": "[清喉嚨]"}, {"type": "subtitle", "time": 6823.91, "timestamp": "01:53:43", "text": "雷射."}, {"type": "subtitle", "time": 6826.75, "timestamp": "01:53:46", "text": "他們是什麼樣的人？他們究竟是怎樣的人？"}, {"type": "subtitle", "time": 6828.47, "timestamp": "01:53:48", "text": "這是"}, {"type": "subtitle", "time": 6831.109, "timestamp": "01:53:51", "text": "我覺得沒必要。每個人"}, {"type": "subtitle", "time": 6834.03, "timestamp": "01:53:54", "text": "有必要設鈴鐺嗎？貝爾絕對是必備的。"}, {"type": "subtitle", "time": 6836.589, "timestamp": "01:53:56", "text": "鈴鐺是不可或缺的。"}, {"type": "subtitle", "time": 6836.99, "timestamp": "01:53:56", "text": "小糸"}, {"type": "subtitle", "time": 6839.27, "timestamp": "01:53:59", "text": "我要去。已經"}, {"type": "subtitle", "time": 6839.51, "timestamp": "01:53:59", "text": "是的。"}]
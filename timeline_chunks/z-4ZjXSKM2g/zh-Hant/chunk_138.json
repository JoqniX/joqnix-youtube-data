[{"type": "subtitle", "time": 8282.19, "timestamp": "02:18:02", "text": "啊，確實如此。"}, {"type": "subtitle", "time": 8286.83, "timestamp": "02:18:06", "text": "它不知所蹤。"}, {"type": "subtitle", "time": 8293.99, "timestamp": "02:18:13", "text": "我有一個背包。"}, {"type": "subtitle", "time": 8295.75, "timestamp": "02:18:15", "text": "背包就在那裡。"}, {"type": "subtitle", "time": 8301.389, "timestamp": "02:18:21", "text": "為什麼？"}, {"type": "subtitle", "time": 8302.349, "timestamp": "02:18:22", "text": "該物品"}, {"type": "subtitle", "time": 8314.79, "timestamp": "02:18:34", "text": "嗯？哦，那樣做豈不是不對嗎？"}, {"type": "subtitle", "time": 8321.27, "timestamp": "02:18:41", "text": "這是什麼？"}, {"type": "subtitle", "time": 8323.509, "timestamp": "02:18:43", "text": "這大概是橫著的"}, {"type": "subtitle", "time": 8329.15, "timestamp": "02:18:49", "text": "啊，"}, {"type": "subtitle", "time": 8331.509, "timestamp": "02:18:51", "text": "這是腰帶嗎？這是腰帶嗎？哦"}, {"type": "subtitle", "time": 8333.629, "timestamp": "02:18:53", "text": "癢，癢。"}, {"type": "subtitle", "time": 8339.629, "timestamp": "02:18:59", "text": "啊，我的意思是它可以安裝在側面。也許"}]
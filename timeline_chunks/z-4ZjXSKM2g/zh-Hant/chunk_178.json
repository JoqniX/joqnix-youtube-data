[{"type": "subtitle", "time": 10680.59, "timestamp": "02:58:00", "text": "這是一個背包。"}, {"type": "subtitle", "time": 10683.11, "timestamp": "02:58:03", "text": "哦，那很好。"}, {"type": "subtitle", "time": 10685.229, "timestamp": "02:58:05", "text": "這是一個背包。哦"}, {"type": "subtitle", "time": 10687.229, "timestamp": "02:58:07", "text": "哦。是。"}, {"type": "subtitle", "time": 10689.67, "timestamp": "02:58:09", "text": "一個國家。"}, {"type": "subtitle", "time": 10697.07, "timestamp": "02:58:17", "text": "背在背上豈不是更好？"}, {"type": "subtitle", "time": 10698.03, "timestamp": "02:58:18", "text": "馬鈴薯"}, {"type": "subtitle", "time": 10700.67, "timestamp": "02:58:20", "text": "最好背在背上。請。"}, {"type": "subtitle", "time": 10701.429, "timestamp": "02:58:21", "text": "我做到了。"}, {"type": "subtitle", "time": 10702.55, "timestamp": "02:58:22", "text": "好的。"}, {"type": "subtitle", "time": 10704.99, "timestamp": "02:58:24", "text": "弄到了一些馬鈴薯。"}, {"type": "subtitle", "time": 10711.389, "timestamp": "02:58:31", "text": "你打算用這個嗎？"}, {"type": "subtitle", "time": 10721.55, "timestamp": "02:58:41", "text": "在哪裡？它在哪裡來著？"}, {"type": "subtitle", "time": 10731.51, "timestamp": "02:58:51", "text": "是的。是的。"}, {"type": "subtitle", "time": 10736.0, "timestamp": "02:58:56", "text": "是的。 外面真黑。外面非常黑。"}]
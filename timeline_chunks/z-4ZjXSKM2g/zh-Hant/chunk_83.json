[{"type": "subtitle", "time": 4982.47, "timestamp": "01:23:02", "text": "但那個地方還有兩個謎團。"}, {"type": "subtitle", "time": 4983.6, "timestamp": "01:23:03", "text": "。 哦真的嗎？"}, {"type": "subtitle", "time": 4985.48, "timestamp": "01:23:05", "text": "哦真的嗎？ 什麼？馬鈴薯"}, {"type": "subtitle", "time": 4986.36, "timestamp": "01:23:06", "text": "什麼？馬鈴薯 我想試試看能不能把它推下去，或者更確切地說，在我待在這裡的時候，看看能不能關註一下它。"}, {"type": "subtitle", "time": 5003.51, "timestamp": "01:23:23", "text": "這似乎不太可能。"}, {"type": "subtitle", "time": 5005.709, "timestamp": "01:23:25", "text": "我現在明白了。"}, {"type": "subtitle", "time": 5026.03, "timestamp": "01:23:46", "text": "所以這"}, {"type": "subtitle", "time": 5028.51, "timestamp": "01:23:48", "text": "沒有按鈕可以按。"}, {"type": "subtitle", "time": 5029.189, "timestamp": "01:23:49", "text": "是的，是的，是的。"}]
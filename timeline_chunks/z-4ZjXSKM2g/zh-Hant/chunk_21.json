[{"type": "subtitle", "time": 1263.19, "timestamp": "00:21:03", "text": "我以我的生命發誓。"}, {"type": "subtitle", "time": 1264.809, "timestamp": "00:21:04", "text": "我簡直不敢相信。"}, {"type": "subtitle", "time": 1266.669, "timestamp": "00:21:06", "text": "[笑聲]"}, {"type": "subtitle", "time": 1269.63, "timestamp": "00:21:09", "text": "我將把它用於我的一生。"}, {"type": "subtitle", "time": 1272.47, "timestamp": "00:21:12", "text": "我的雷射筆不會丟失的。哦，不。"}, {"type": "subtitle", "time": 1274.789, "timestamp": "00:21:14", "text": "糟糕的。現在有點卡頓。"}, {"type": "subtitle", "time": 1295.51, "timestamp": "00:21:35", "text": "是的。一定"}, {"type": "subtitle", "time": 1309.87, "timestamp": "00:21:49", "text": "我想保留它。"}, {"type": "subtitle", "time": 1317.269, "timestamp": "00:21:57", "text": "嗯，但是"}, {"type": "subtitle", "time": 1319.51, "timestamp": "00:21:59", "text": "哦，這個"}]
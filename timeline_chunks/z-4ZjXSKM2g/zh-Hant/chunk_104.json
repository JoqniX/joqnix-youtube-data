[{"type": "subtitle", "time": 6246.629, "timestamp": "01:44:06", "text": "哦，他們下車了。"}, {"type": "subtitle", "time": 6249.27, "timestamp": "01:44:09", "text": "我下車了。"}, {"type": "subtitle", "time": 6253.27, "timestamp": "01:44:13", "text": "好了，我得下車了。我要下車了。"}, {"type": "subtitle", "time": 6255.39, "timestamp": "01:44:15", "text": "這裡有一部對講機。"}, {"type": "subtitle", "time": 6255.91, "timestamp": "01:44:15", "text": "一個，"}, {"type": "subtitle", "time": 6256.109, "timestamp": "01:44:16", "text": "是的。"}, {"type": "subtitle", "time": 6257.277, "timestamp": "01:44:17", "text": "哦，我不下車。"}, {"type": "subtitle", "time": 6267.39, "timestamp": "01:44:27", "text": "一個，"}, {"type": "subtitle", "time": 6269.27, "timestamp": "01:44:29", "text": "是的，是的，是的，是的。"}, {"type": "subtitle", "time": 6271.27, "timestamp": "01:44:31", "text": "我該買這個嗎？"}, {"type": "subtitle", "time": 6271.629, "timestamp": "01:44:31", "text": "一個，"}, {"type": "subtitle", "time": 6272.109, "timestamp": "01:44:32", "text": "是的。"}, {"type": "subtitle", "time": 6274.189, "timestamp": "01:44:34", "text": "哦，它卡住了。"}, {"type": "subtitle", "time": 6274.47, "timestamp": "01:44:34", "text": "是的。"}, {"type": "subtitle", "time": 6276.27, "timestamp": "01:44:36", "text": "我被困住了。"}, {"type": "subtitle", "time": 6277.229, "timestamp": "01:44:37", "text": "我該把它帶走嗎？"}, {"type": "subtitle", "time": 6277.91, "timestamp": "01:44:37", "text": "哦，"}, {"type": "subtitle", "time": 6278.27, "timestamp": "01:44:38", "text": "是的。"}, {"type": "subtitle", "time": 6280.669, "timestamp": "01:44:40", "text": "好了，我們走吧。"}, {"type": "subtitle", "time": 6282.79, "timestamp": "01:44:42", "text": "是的。"}, {"type": "subtitle", "time": 6283.79, "timestamp": "01:44:43", "text": "這邊。這邊。"}, {"type": "subtitle", "time": 6284.83, "timestamp": "01:44:44", "text": "請稍等。"}, {"type": "subtitle", "time": 6285.99, "timestamp": "01:44:45", "text": "射線。"}, {"type": "subtitle", "time": 6287.629, "timestamp": "01:44:47", "text": "這讓我笑了。"}, {"type": "subtitle", "time": 6290.629, "timestamp": "01:44:50", "text": "祝你旅途愉快。"}, {"type": "subtitle", "time": 6292.669, "timestamp": "01:44:52", "text": "小心。"}]
[{"type": "subtitle", "time": 5340.109, "timestamp": "01:29:00", "text": "我看不見。真魚。"}, {"type": "subtitle", "time": 5344.03, "timestamp": "01:29:04", "text": "哇，真有意思。然後，就像往常一樣，啊"}, {"type": "subtitle", "time": 5346.629, "timestamp": "01:29:06", "text": "它來了，它來了，它來了。類似直播之類的"}, {"type": "subtitle", "time": 5349.91, "timestamp": "01:29:09", "text": "即使你不是主播，"}, {"type": "subtitle", "time": 5352.149, "timestamp": "01:29:12", "text": "看起來和朋友一起做這件事會非常有趣。"}, {"type": "subtitle", "time": 5354.91, "timestamp": "01:29:14", "text": "是。這場比賽的亮點出現了嗎？"}, {"type": "subtitle", "time": 5357.83, "timestamp": "01:29:17", "text": "。今晚燈亮了。"}, {"type": "subtitle", "time": 5361.27, "timestamp": "01:29:21", "text": "真是太有趣了，不是嗎？大約6人"}, {"type": "subtitle", "time": 5364.75, "timestamp": "01:29:24", "text": "我覺得差不多就是這樣。"}, {"type": "subtitle", "time": 5368.79, "timestamp": "01:29:28", "text": "兩個人就能做到。哦，我睡著了。"}, {"type": "subtitle", "time": 5373.51, "timestamp": "01:29:33", "text": "。當我入睡時，我的眼前景象就像我入睡前看到的畫面。"}, {"type": "subtitle", "time": 5376.229, "timestamp": "01:29:36", "text": "我做到了。是的。操作"}, {"type": "subtitle", "time": 5380.51, "timestamp": "01:29:40", "text": "這肯定比用針頭好。"}, {"type": "subtitle", "time": 5383.47, "timestamp": "01:29:43", "text": "我覺得34個人比較有趣，但6個人也蠻好玩的。"}, {"type": "subtitle", "time": 5387.149, "timestamp": "01:29:47", "text": "如果人那麼多，這個謎題可能很容易解開，但是"}, {"type": "subtitle", "time": 5390.709, "timestamp": "01:29:50", "text": "六個是合適的數字，因為再多就難以管理了。"}, {"type": "subtitle", "time": 5393.229, "timestamp": "01:29:53", "text": "看起來差不多。"}, {"type": "subtitle", "time": 5396.87, "timestamp": "01:29:56", "text": "真是太搞笑了。"}]
[{"type": "subtitle", "time": 661.43, "timestamp": "00:11:01", "text": "好的。好的。"}, {"type": "subtitle", "time": 663.389, "timestamp": "00:11:03", "text": "他說話的時候麥克風又靜音了。"}, {"type": "subtitle", "time": 664.509, "timestamp": "00:11:04", "text": "謝謝。"}, {"type": "subtitle", "time": 665.67, "timestamp": "00:11:05", "text": "靜音類型的聲音太多了。"}, {"type": "subtitle", "time": 666.389, "timestamp": "00:11:06", "text": "是的。"}, {"type": "subtitle", "time": 668.069, "timestamp": "00:11:08", "text": "一點點"}, {"type": "subtitle", "time": 670.87, "timestamp": "00:11:10", "text": "這樣可以。我能做到嗎？"}, {"type": "subtitle", "time": 679.03, "timestamp": "00:11:19", "text": "好了，我們走吧。"}, {"type": "subtitle", "time": 679.959, "timestamp": "00:11:19", "text": "我們走吧。 好的，我們以順時針方向依序查看名單。"}, {"type": "subtitle", "time": 685.35, "timestamp": "00:11:25", "text": "圖片，"}, {"type": "subtitle", "time": 700.99, "timestamp": "00:11:40", "text": "下一個"}, {"type": "subtitle", "time": 701.91, "timestamp": "00:11:41", "text": "我醒了。"}, {"type": "subtitle", "time": 703.87, "timestamp": "00:11:43", "text": "津馬正在睡覺。"}, {"type": "subtitle", "time": 706.088, "timestamp": "00:11:46", "text": "我當時在喝蛋白奶昔。蛋白質。"}, {"type": "subtitle", "time": 712.069, "timestamp": "00:11:52", "text": "嗯，這次也是。"}]
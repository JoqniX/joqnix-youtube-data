[{"type": "subtitle", "time": 3244.95, "timestamp": "00:54:04", "text": "耶！"}, {"type": "subtitle", "time": 3246.549, "timestamp": "00:54:06", "text": "你還好嗎？"}, {"type": "subtitle", "time": 3260.349, "timestamp": "00:54:20", "text": "圖片，"}, {"type": "subtitle", "time": 3263.03, "timestamp": "00:54:23", "text": "這塊地瓜難道沒有地方放嗎？"}, {"type": "subtitle", "time": 3263.589, "timestamp": "00:54:23", "text": "是的。"}, {"type": "subtitle", "time": 3264.67, "timestamp": "00:54:24", "text": "啊，"}, {"type": "subtitle", "time": 3267.549, "timestamp": "00:54:27", "text": "我記得那裡好像有個可以待著的塔樓。"}, {"type": "subtitle", "time": 3268.15, "timestamp": "00:54:28", "text": "哦，對。"}, {"type": "subtitle", "time": 3270.309, "timestamp": "00:54:30", "text": "再多一點那種。"}, {"type": "subtitle", "time": 3294.677, "timestamp": "00:54:54", "text": "全部捐出去"}, {"type": "subtitle", "time": 3296.549, "timestamp": "00:54:56", "text": "[笑聲]"}]
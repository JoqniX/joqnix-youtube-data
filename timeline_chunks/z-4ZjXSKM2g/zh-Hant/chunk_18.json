[{"type": "subtitle", "time": 1084.549, "timestamp": "00:18:04", "text": "一個，"}, {"type": "subtitle", "time": 1087.11, "timestamp": "00:18:07", "text": "所有人都失敗了。"}, {"type": "subtitle", "time": 1089.789, "timestamp": "00:18:09", "text": "我確定我已經完成了這部分，所以它應該就在這裡。"}, {"type": "subtitle", "time": 1092.549, "timestamp": "00:18:12", "text": "啊，哦，"}, {"type": "subtitle", "time": 1097.19, "timestamp": "00:18:17", "text": "嘿。"}, {"type": "subtitle", "time": 1098.75, "timestamp": "00:18:18", "text": "嗯，當時它就在這裡。"}, {"type": "subtitle", "time": 1100.029, "timestamp": "00:18:20", "text": "啊。"}, {"type": "subtitle", "time": 1101.31, "timestamp": "00:18:21", "text": "是的。"}, {"type": "subtitle", "time": 1104.31, "timestamp": "00:18:24", "text": "由於尚未升起國旗，說明事件還沒結束。"}, {"type": "subtitle", "time": 1105.63, "timestamp": "00:18:25", "text": "是否有可能地點？"}, {"type": "subtitle", "time": 1109.51, "timestamp": "00:18:29", "text": "某物"}, {"type": "subtitle", "time": 1111.789, "timestamp": "00:18:31", "text": "或許走這條路比較好。"}, {"type": "subtitle", "time": 1112.23, "timestamp": "00:18:32", "text": "你有嗎？"}, {"type": "subtitle", "time": 1113.19, "timestamp": "00:18:33", "text": "收到。"}, {"type": "subtitle", "time": 1119.75, "timestamp": "00:18:39", "text": "或許我該走那條路。"}, {"type": "subtitle", "time": 1120.07, "timestamp": "00:18:40", "text": "是的。"}, {"type": "subtitle", "time": 1122.029, "timestamp": "00:18:42", "text": "我們走吧。"}, {"type": "subtitle", "time": 1127.19, "timestamp": "00:18:47", "text": "我搞不明白，因為它只是一個方向而已。"}, {"type": "subtitle", "time": 1128.59, "timestamp": "00:18:48", "text": "哦，等等。"}, {"type": "subtitle", "time": 1134.83, "timestamp": "00:18:54", "text": "哦，是雷射。"}, {"type": "subtitle", "time": 1136.669, "timestamp": "00:18:56", "text": "它是皮革。孩子，"}, {"type": "subtitle", "time": 1137.83, "timestamp": "00:18:57", "text": "就在這裡。"}]
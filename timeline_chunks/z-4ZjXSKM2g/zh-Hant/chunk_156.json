[{"type": "subtitle", "time": 9364.83, "timestamp": "02:36:04", "text": "如果我當初只犯了一個錯誤就好了。但"}, {"type": "subtitle", "time": 9366.83, "timestamp": "02:36:06", "text": "是的。如果第一個差了1，那就有點…"}, {"type": "subtitle", "time": 9368.269, "timestamp": "02:36:08", "text": "是的。"}, {"type": "subtitle", "time": 9398.469, "timestamp": "02:36:38", "text": "已覆蓋 已覆蓋 已覆蓋 已覆蓋"}, {"type": "subtitle", "time": 9410.95, "timestamp": "02:36:50", "text": "哦，就是它，就是它"}, {"type": "subtitle", "time": 9412.55, "timestamp": "02:36:52", "text": "Oota，按壓，按壓"}, {"type": "subtitle", "time": 9413.309, "timestamp": "02:36:53", "text": "我打敗了它。"}, {"type": "subtitle", "time": 9419.71, "timestamp": "02:36:59", "text": "等等，我們還能走嗎？不可能的。"}]
[{"type": "subtitle", "time": 2410.75, "timestamp": "00:40:10", "text": "三人關係密切。"}, {"type": "subtitle", "time": 2413.349, "timestamp": "00:40:13", "text": "次數。"}, {"type": "subtitle", "time": 2415.79, "timestamp": "00:40:15", "text": "啊，一二狙擊，三次。"}, {"type": "subtitle", "time": 2417.67, "timestamp": "00:40:17", "text": "哦，已經是下一集了。"}, {"type": "subtitle", "time": 2419.79, "timestamp": "00:40:19", "text": "啊，三次。三次。"}, {"type": "subtitle", "time": 2422.79, "timestamp": "00:40:22", "text": "是的。嗯，嗯，嗯。"}, {"type": "subtitle", "time": 2425.589, "timestamp": "00:40:25", "text": "哦，娜醬，你做了多少次？"}, {"type": "subtitle", "time": 2428.87, "timestamp": "00:40:28", "text": "呃，淺藍色兩次，黃色兩次。"}, {"type": "subtitle", "time": 2432.87, "timestamp": "00:40:32", "text": "我也是3號，所以是3加3，然後…"}, {"type": "subtitle", "time": 2434.67, "timestamp": "00:40:34", "text": "卡桑什麼也沒做"}, {"type": "subtitle", "time": 2437.03, "timestamp": "00:40:37", "text": "嗯，三次用白色，"}, {"type": "subtitle", "time": 2441.15, "timestamp": "00:40:41", "text": "我想它有三次是黃色，兩次是紅色。"}, {"type": "subtitle", "time": 2441.55, "timestamp": "00:40:41", "text": "多希"}, {"type": "subtitle", "time": 2442.27, "timestamp": "00:40:42", "text": "所以，一個人"}]
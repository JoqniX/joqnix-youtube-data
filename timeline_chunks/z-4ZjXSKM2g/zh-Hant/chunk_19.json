[{"type": "subtitle", "time": 1142.31, "timestamp": "00:19:02", "text": "如果我把一切都拋在腦後，我可能會失去一切。"}, {"type": "subtitle", "time": 1144.59, "timestamp": "00:19:04", "text": "它在地圖上的這個位置。"}, {"type": "subtitle", "time": 1145.71, "timestamp": "00:19:05", "text": "地圖去哪了？"}, {"type": "subtitle", "time": 1147.63, "timestamp": "00:19:07", "text": "我需要帶地圖嗎？"}, {"type": "subtitle", "time": 1150.43, "timestamp": "00:19:10", "text": "無人"}, {"type": "subtitle", "time": 1151.59, "timestamp": "00:19:11", "text": "一個，"}, {"type": "subtitle", "time": 1153.59, "timestamp": "00:19:13", "text": "我也什麼都沒有，所以…"}, {"type": "subtitle", "time": 1154.27, "timestamp": "00:19:14", "text": "我會把它給你。"}, {"type": "subtitle", "time": 1155.23, "timestamp": "00:19:15", "text": "謝謝。"}, {"type": "subtitle", "time": 1161.669, "timestamp": "00:19:21", "text": "扔到這裡。"}, {"type": "subtitle", "time": 1163.39, "timestamp": "00:19:23", "text": "是的。"}, {"type": "subtitle", "time": 1165.27, "timestamp": "00:19:25", "text": "我們走吧。"}, {"type": "subtitle", "time": 1167.029, "timestamp": "00:19:27", "text": "圖片？"}, {"type": "subtitle", "time": 1179.71, "timestamp": "00:19:39", "text": "糟糕的，"}]
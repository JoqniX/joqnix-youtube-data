[{"type": "subtitle", "time": 840.389, "timestamp": "00:14:00", "text": "これってどうやっての?"}, {"type": "subtitle", "time": 841.87, "timestamp": "00:14:01", "text": "これ人がするんだっけ?これ。"}, {"type": "subtitle", "time": 842.79, "timestamp": "00:14:02", "text": "あ、違うっけ?"}, {"type": "subtitle", "time": 844.629, "timestamp": "00:14:04", "text": "これ後ろ向きに。"}, {"type": "subtitle", "time": 845.509, "timestamp": "00:14:05", "text": "あ、できた、できた、できた。"}, {"type": "subtitle", "time": 847.15, "timestamp": "00:14:07", "text": "あ、なるほど。あ、本当だ。"}, {"type": "subtitle", "time": 854.119, "timestamp": "00:14:14", "text": "じゃあ、そのまま持っといてもらうか。このままさに持っといてもらうか。"}, {"type": "subtitle", "time": 863.67, "timestamp": "00:14:23", "text": "これをリュックに。"}, {"type": "subtitle", "time": 865.91, "timestamp": "00:14:25", "text": "あ、そうだ。それ持っていかなきゃいけないんだ。"}, {"type": "subtitle", "time": 868.389, "timestamp": "00:14:28", "text": "それを持っていかないといけない。"}, {"type": "subtitle", "time": 871.389, "timestamp": "00:14:31", "text": "あ、じゃ何持ってるかわかんねえんだ、これ。"}, {"type": "subtitle", "time": 887.949, "timestamp": "00:14:47", "text": "コンピーコンパス。"}, {"type": "subtitle", "time": 888.47, "timestamp": "00:14:48", "text": "はい。"}, {"type": "subtitle", "time": 889.269, "timestamp": "00:14:49", "text": "おお。"}, {"type": "subtitle", "time": 891.59, "timestamp": "00:14:51", "text": "よし"}, {"type": "subtitle", "time": 898.71, "timestamp": "00:14:58", "text": "結局ベル"}]
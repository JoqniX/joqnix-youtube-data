[{"type": "subtitle", "time": 5340.109, "timestamp": "01:29:00", "text": "見えない。マこ。"}, {"type": "subtitle", "time": 5344.03, "timestamp": "01:29:04", "text": "いや、面白いすね。で、なんか普通に、あ"}, {"type": "subtitle", "time": 5346.629, "timestamp": "01:29:06", "text": "、来た、来た、来た。なんか配信とかじゃ"}, {"type": "subtitle", "time": 5349.91, "timestamp": "01:29:09", "text": "なくて普通になんか配信者じゃなくても"}, {"type": "subtitle", "time": 5352.149, "timestamp": "01:29:12", "text": "友達同士でやったらめちゃくちゃ楽しそう"}, {"type": "subtitle", "time": 5354.91, "timestamp": "01:29:14", "text": "です。このゲームなんかライトがついたか"}, {"type": "subtitle", "time": 5357.83, "timestamp": "01:29:17", "text": "。今夜になったから電気がつい"}, {"type": "subtitle", "time": 5361.27, "timestamp": "01:29:21", "text": "めちゃくちゃ面白いですよね。6人ぐらい"}, {"type": "subtitle", "time": 5364.75, "timestamp": "01:29:24", "text": "がちょうどいい気がするな、やっぱり。"}, {"type": "subtitle", "time": 5368.79, "timestamp": "01:29:28", "text": "2人、2人でできるん。あえ、寝ちゃった"}, {"type": "subtitle", "time": 5373.51, "timestamp": "01:29:33", "text": "。僕が寝ると視界がさっき今のポやって寝"}, {"type": "subtitle", "time": 5376.229, "timestamp": "01:29:36", "text": "ちゃった。そう。操作して"}, {"type": "subtitle", "time": 5380.51, "timestamp": "01:29:40", "text": "針でやるよりは絶対"}, {"type": "subtitle", "time": 5383.47, "timestamp": "01:29:43", "text": "34人はいた方が楽しいと思うし6人"}, {"type": "subtitle", "time": 5387.149, "timestamp": "01:29:47", "text": "ぐらいいたら多分謎解き簡単だけどそれ"}, {"type": "subtitle", "time": 5390.709, "timestamp": "01:29:50", "text": "より多いと逆に収集つかなくなるから6人"}, {"type": "subtitle", "time": 5393.229, "timestamp": "01:29:53", "text": "ぐらいがちょうどいい気がする。"}, {"type": "subtitle", "time": 5396.87, "timestamp": "01:29:56", "text": "めちゃくちゃおもろい。"}]
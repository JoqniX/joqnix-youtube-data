[{"type": "subtitle", "time": 1084.549, "timestamp": "00:18:04", "text": "あ、"}, {"type": "subtitle", "time": 1087.11, "timestamp": "00:18:07", "text": "全員落ちた。"}, {"type": "subtitle", "time": 1089.789, "timestamp": "00:18:09", "text": "絶対ここクリアしてるからここら辺じゃないかな。"}, {"type": "subtitle", "time": 1092.549, "timestamp": "00:18:12", "text": "あ、オ、"}, {"type": "subtitle", "time": 1097.19, "timestamp": "00:18:17", "text": "ね。"}, {"type": "subtitle", "time": 1098.75, "timestamp": "00:18:18", "text": "ん、じゃ、ここにあった。"}, {"type": "subtitle", "time": 1100.029, "timestamp": "00:18:20", "text": "あー。"}, {"type": "subtitle", "time": 1101.31, "timestamp": "00:18:21", "text": "うん。"}, {"type": "subtitle", "time": 1104.31, "timestamp": "00:18:24", "text": "フラグ立ってないってことはこれまだ終わってないってこと。"}, {"type": "subtitle", "time": 1105.63, "timestamp": "00:18:25", "text": "ありそうな場所あるかな?"}, {"type": "subtitle", "time": 1109.51, "timestamp": "00:18:29", "text": "なんか"}, {"type": "subtitle", "time": 1111.789, "timestamp": "00:18:31", "text": "多分じゃこっちに行った方が"}, {"type": "subtitle", "time": 1112.23, "timestamp": "00:18:32", "text": "あるんか?"}, {"type": "subtitle", "time": 1113.19, "timestamp": "00:18:33", "text": "了解。"}, {"type": "subtitle", "time": 1119.75, "timestamp": "00:18:39", "text": "あっちに行った方がいいかな。"}, {"type": "subtitle", "time": 1120.07, "timestamp": "00:18:40", "text": "うん。"}, {"type": "subtitle", "time": 1122.029, "timestamp": "00:18:42", "text": "レッツゴー。"}, {"type": "subtitle", "time": 1127.19, "timestamp": "00:18:47", "text": "方向だからわかんなかった。"}, {"type": "subtitle", "time": 1128.59, "timestamp": "00:18:48", "text": "あ、ちょ、ちょっと待って。"}, {"type": "subtitle", "time": 1134.83, "timestamp": "00:18:54", "text": "あ、レーザー。"}, {"type": "subtitle", "time": 1136.669, "timestamp": "00:18:56", "text": "レザーだ。こ、"}, {"type": "subtitle", "time": 1137.83, "timestamp": "00:18:57", "text": "ここにちゃんとあった。"}, {"type": "subtitle", "time": 1139.549, "timestamp": "00:18:59", "text": "ここにあったよ。"}]
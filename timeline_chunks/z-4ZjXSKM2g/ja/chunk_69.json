[{"type": "subtitle", "time": 4140.99, "timestamp": "01:09:00", "text": "はい。"}, {"type": "subtitle", "time": 4149.59, "timestamp": "01:09:09", "text": "ああ、"}, {"type": "subtitle", "time": 4152.189, "timestamp": "01:09:12", "text": "こっちが減ってるわ。"}, {"type": "subtitle", "time": 4154.47, "timestamp": "01:09:14", "text": "こっちが減ってて、こっちが多くなって、"}, {"type": "subtitle", "time": 4157.269, "timestamp": "01:09:17", "text": "こっちが増えてる。下の値が増えてる。"}, {"type": "subtitle", "time": 4158.07, "timestamp": "01:09:18", "text": "下が"}, {"type": "subtitle", "time": 4163.63, "timestamp": "01:09:23", "text": "あ、後ろに下がると下がるね。"}, {"type": "subtitle", "time": 4165.789, "timestamp": "01:09:25", "text": "あ、分かりました。じゃあこっちね。"}, {"type": "subtitle", "time": 4173.47, "timestamp": "01:09:33", "text": "325"}, {"type": "subtitle", "time": 4185.349, "timestamp": "01:09:45", "text": "できるかな?"}, {"type": "subtitle", "time": 4187.03, "timestamp": "01:09:47", "text": "いやいやいや、ちょ、ちょっと待って。"}, {"type": "subtitle", "time": 4189.829, "timestamp": "01:09:49", "text": "あ、できませ。[笑い]"}, {"type": "subtitle", "time": 4191.749, "timestamp": "01:09:51", "text": "おオオオで"}, {"type": "subtitle", "time": 4193.348, "timestamp": "01:09:53", "text": "めっちゃ分かりでも人は見えない。"}, {"type": "subtitle", "time": 4194.95, "timestamp": "01:09:54", "text": "[笑い]"}, {"type": "subtitle", "time": 4197.27, "timestamp": "01:09:57", "text": "見えない。背ってる人は見えない。"}]
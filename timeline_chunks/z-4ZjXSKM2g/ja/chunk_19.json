[{"type": "subtitle", "time": 1142.31, "timestamp": "00:19:02", "text": "全部たら全部なくすかもしんないから置いていくか。"}, {"type": "subtitle", "time": 1144.59, "timestamp": "00:19:04", "text": "マップでもここにある。"}, {"type": "subtitle", "time": 1145.71, "timestamp": "00:19:05", "text": "マップどこ行った?"}, {"type": "subtitle", "time": 1147.63, "timestamp": "00:19:07", "text": "マップ持っていこうか。"}, {"type": "subtitle", "time": 1150.43, "timestamp": "00:19:10", "text": "誰もワ"}, {"type": "subtitle", "time": 1151.59, "timestamp": "00:19:11", "text": "あ、"}, {"type": "subtitle", "time": 1153.59, "timestamp": "00:19:13", "text": "僕も何も持ってないからあの、"}, {"type": "subtitle", "time": 1154.27, "timestamp": "00:19:14", "text": "あげます。"}, {"type": "subtitle", "time": 1155.23, "timestamp": "00:19:15", "text": "ありがとう。"}, {"type": "subtitle", "time": 1161.669, "timestamp": "00:19:21", "text": "ここに捨てて。"}, {"type": "subtitle", "time": 1163.39, "timestamp": "00:19:23", "text": "はい。"}, {"type": "subtitle", "time": 1165.27, "timestamp": "00:19:25", "text": "レッツゴー。"}, {"type": "subtitle", "time": 1167.029, "timestamp": "00:19:27", "text": "え?"}, {"type": "subtitle", "time": 1179.71, "timestamp": "00:19:39", "text": "やばい、"}]
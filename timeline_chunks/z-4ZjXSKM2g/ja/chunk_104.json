[{"type": "subtitle", "time": 6246.629, "timestamp": "01:44:06", "text": "あ、降りた。"}, {"type": "subtitle", "time": 6249.28, "timestamp": "01:44:09", "text": "降りた。 降りた。"}, {"type": "subtitle", "time": 6251.04, "timestamp": "01:44:11", "text": "降りた。 さ、降りなきゃ。降りま。"}, {"type": "subtitle", "time": 6253.28, "timestamp": "01:44:13", "text": "さ、降りなきゃ。降りま。 ここにね、なんかトランシーバーあるんだけど。"}, {"type": "subtitle", "time": 6255.4, "timestamp": "01:44:15", "text": "ここにね、なんかトランシーバーあるんだけど。 あ、"}, {"type": "subtitle", "time": 6255.92, "timestamp": "01:44:15", "text": "あ、 うん。"}, {"type": "subtitle", "time": 6256.119, "timestamp": "01:44:16", "text": "うん。 あ、降りない。"}, {"type": "subtitle", "time": 6257.287, "timestamp": "01:44:17", "text": "あ、降りない。 [笑い]"}, {"type": "subtitle", "time": 6267.39, "timestamp": "01:44:27", "text": "あ、"}, {"type": "subtitle", "time": 6269.27, "timestamp": "01:44:29", "text": "はいはいはいはい。"}, {"type": "subtitle", "time": 6271.27, "timestamp": "01:44:31", "text": "これ拾っていけばいいかな。"}, {"type": "subtitle", "time": 6271.629, "timestamp": "01:44:31", "text": "あ、"}, {"type": "subtitle", "time": 6272.109, "timestamp": "01:44:32", "text": "うん。"}, {"type": "subtitle", "time": 6274.189, "timestamp": "01:44:34", "text": "あ、引っかかってる。"}, {"type": "subtitle", "time": 6274.47, "timestamp": "01:44:34", "text": "うん。"}, {"type": "subtitle", "time": 6276.27, "timestamp": "01:44:36", "text": "引っかかってる。"}, {"type": "subtitle", "time": 6277.229, "timestamp": "01:44:37", "text": "持っていきましょうか。"}, {"type": "subtitle", "time": 6277.91, "timestamp": "01:44:37", "text": "お、"}, {"type": "subtitle", "time": 6278.27, "timestamp": "01:44:38", "text": "うん。"}, {"type": "subtitle", "time": 6280.669, "timestamp": "01:44:40", "text": "じゃあ行きましょうか。"}, {"type": "subtitle", "time": 6282.79, "timestamp": "01:44:42", "text": "うん。"}, {"type": "subtitle", "time": 6283.79, "timestamp": "01:44:43", "text": "こっち側。こっち側。"}, {"type": "subtitle", "time": 6284.83, "timestamp": "01:44:44", "text": "持ってください。"}, {"type": "subtitle", "tim
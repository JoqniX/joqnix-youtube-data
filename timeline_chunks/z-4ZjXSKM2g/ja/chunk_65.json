[{"type": "subtitle", "time": 3903.829, "timestamp": "01:05:03", "text": "なんで?"}, {"type": "subtitle", "time": 3906.029, "timestamp": "01:05:06", "text": "あ、もう行っちゃった。もう行っちゃった。早い。"}, {"type": "subtitle", "time": 3907.349, "timestamp": "01:05:07", "text": "もう行っちゃったし。落ちてった。"}, {"type": "subtitle", "time": 3908.549, "timestamp": "01:05:08", "text": "ここに置いとこうかな。"}, {"type": "subtitle", "time": 3908.91, "timestamp": "01:05:08", "text": "早い。"}, {"type": "subtitle", "time": 3922.71, "timestamp": "01:05:22", "text": "うん。うん。"}, {"type": "subtitle", "time": 3934.589, "timestamp": "01:05:34", "text": "だな。"}, {"type": "subtitle", "time": 3936.829, "timestamp": "01:05:36", "text": "時計でもなさそうですけど。"}, {"type": "subtitle", "time": 3944.549, "timestamp": "01:05:44", "text": "これはなおちゃん背負って。"}, {"type": "subtitle", "time": 3952.51, "timestamp": "01:05:52", "text": "ホワイトボードある。"}]
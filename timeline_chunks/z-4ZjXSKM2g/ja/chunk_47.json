[{"type": "subtitle", "time": 2830.63, "timestamp": "00:47:10", "text": "あれ"}, {"type": "subtitle", "time": 2836.51, "timestamp": "00:47:16", "text": "おーい。"}, {"type": "subtitle", "time": 2837.109, "timestamp": "00:47:17", "text": "駅で"}, {"type": "subtitle", "time": 2840.03, "timestamp": "00:47:20", "text": "追いてかないで。"}, {"type": "subtitle", "time": 2845.069, "timestamp": "00:47:25", "text": "光ってる。"}, {"type": "subtitle", "time": 2845.79, "timestamp": "00:47:25", "text": "ああ、"}, {"type": "subtitle", "time": 2846.63, "timestamp": "00:47:26", "text": "光ってる。"}, {"type": "subtitle", "time": 2847.069, "timestamp": "00:47:27", "text": "あ、"}, {"type": "subtitle", "time": 2848.19, "timestamp": "00:47:28", "text": "光ってる。"}, {"type": "subtitle", "time": 2850.51, "timestamp": "00:47:30", "text": "い、おける。"}, {"type": "subtitle", "time": 2856.99, "timestamp": "00:47:36", "text": "早い。"}, {"type": "subtitle", "time": 2859.87, "timestamp": "00:47:39", "text": "あ、こっちじゃないんだけど。どこ行った?"}, {"type": "subtitle", "time": 2866.03, "timestamp": "00:47:46", "text": "やばい。なくなっちゃった。"}, {"type": "subtitle", "time": 2867.19, "timestamp": "00:47:47", "text": "やばい。"}, {"type": "subtitle", "time": 2869.99, "timestamp": "00:47:49", "text": "ええ。"}, {"type": "subtitle", "time": 2871.27, "timestamp": "00:47:51", "text": "どうしよう。"}, {"type": "subtitle", "time": 2873.508, "timestamp": "00:47:53", "text": "誰もレーザー持ってない。"}, {"type": "subtitle", "time": 2874.23, "timestamp": "00:47:54", "text": "[笑い]"}]
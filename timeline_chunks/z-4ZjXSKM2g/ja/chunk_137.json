[{"type": "subtitle", "time": 8232.349, "timestamp": "02:17:12", "text": "ないかなと思っ。"}, {"type": "subtitle", "time": 8233.87, "timestamp": "02:17:13", "text": "どこ行きますか?"}, {"type": "subtitle", "time": 8234.669, "timestamp": "02:17:14", "text": "ああ、確かに。"}, {"type": "subtitle", "time": 8240.429, "timestamp": "02:17:20", "text": "多分。"}, {"type": "subtitle", "time": 8254.23, "timestamp": "02:17:34", "text": "[鼻息]"}, {"type": "subtitle", "time": 8255.389, "timestamp": "02:17:35", "text": "これ背中に乗せれる?"}, {"type": "subtitle", "time": 8258.11, "timestamp": "02:17:38", "text": "それ背中に置いといたら"}, {"type": "subtitle", "time": 8264.309, "timestamp": "02:17:44", "text": "乗れなさそう。あ、乗せれなさそう。"}, {"type": "subtitle", "time": 8266.589, "timestamp": "02:17:46", "text": "あ、ちょ、めっちゃ押してるけど。"}, {"type": "subtitle", "time": 8268.95, "timestamp": "02:17:48", "text": "押さ、押されてる。押されてる。"}, {"type": "subtitle", "time": 8271.79, "timestamp": "02:17:51", "text": "されてる。あ、"}, {"type": "subtitle", "time": 8272.349, "timestamp": "02:17:52", "text": "無理か。"}, {"type": "subtitle", "time": 8273.309, "timestamp": "02:17:53", "text": "大きすぎるんだ。"}]
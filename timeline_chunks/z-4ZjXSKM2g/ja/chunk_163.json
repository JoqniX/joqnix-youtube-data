[{"type": "subtitle", "time": 9787.03, "timestamp": "02:43:07", "text": "ああ。"}, {"type": "subtitle", "time": 9789.59, "timestamp": "02:43:09", "text": "み、見てない。"}, {"type": "subtitle", "time": 9798.03, "timestamp": "02:43:18", "text": "あの、"}, {"type": "subtitle", "time": 9800.55, "timestamp": "02:43:20", "text": "あれ僕見て猫ちゃんの形見せて。"}, {"type": "subtitle", "time": 9801.269, "timestamp": "02:43:21", "text": "うん。"}, {"type": "subtitle", "time": 9808.19, "timestamp": "02:43:28", "text": "違う違う。"}, {"type": "subtitle", "time": 9809.63, "timestamp": "02:43:29", "text": "違う。これ。"}, {"type": "subtitle", "time": 9810.15, "timestamp": "02:43:30", "text": "うん。も違う。"}, {"type": "subtitle", "time": 9812.91, "timestamp": "02:43:32", "text": "違う。こことここ。これ。"}, {"type": "subtitle", "time": 9814.51, "timestamp": "02:43:34", "text": "それはあってる。それはあってる。"}, {"type": "subtitle", "time": 9816.87, "timestamp": "02:43:36", "text": "それは当てた。向きがやっぱ違うじゃ。"}, {"type": "subtitle", "time": 9817.59, "timestamp": "02:43:37", "text": "そう。"}, {"type": "subtitle", "time": 9828.51, "timestamp": "02:43:48", "text": "あ、開いてんのか。"}, {"type": "subtitle", "time": 9829.75, "timestamp": "02:43:49", "text": "そう、そう、そう、そう、そう。"}, {"type": "subtitle", "time": 9831.389, "timestamp": "02:43:51", "text": "間がいてた。"}, {"type": "subtitle", "time": 9834.03, "timestamp": "02:43:54", "text": "そう。え、じゃあ方向決めよう。方向決めよう。"}, {"type": "subtitle", "time": 9835.59, "timestamp": "02:43:55", "text": "に2個並んでると思ったから。"}, {"type": "subtitle", "time": 9838.15, "timestamp": "02:43:58", "text": "なちゃん、なこちゃん4箇所目った。"}, {"type": "subtitle", "time": 9839.15, "timestamp": "02:43:59", "text": "こう見てたんだ。4"}]
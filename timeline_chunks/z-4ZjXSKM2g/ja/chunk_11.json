[{"type": "subtitle", "time": 661.43, "timestamp": "00:11:01", "text": "よかった。よかった。"}, {"type": "subtitle", "time": 663.389, "timestamp": "00:11:03", "text": "またミュートしながら喋ってた。"}, {"type": "subtitle", "time": 664.509, "timestamp": "00:11:04", "text": "ありがとう。"}, {"type": "subtitle", "time": 665.67, "timestamp": "00:11:05", "text": "ミュート系が多すぎる。"}, {"type": "subtitle", "time": 666.389, "timestamp": "00:11:06", "text": "はい。"}, {"type": "subtitle", "time": 668.069, "timestamp": "00:11:08", "text": "ちょっと"}, {"type": "subtitle", "time": 670.87, "timestamp": "00:11:10", "text": "これでこれでいいや。いけるかな?"}, {"type": "subtitle", "time": 679.03, "timestamp": "00:11:19", "text": "じゃ、行きましょう。"}, {"type": "subtitle", "time": 679.959, "timestamp": "00:11:19", "text": "行きましょう。 じゃあ時計周りに名前をね、言っていきましょうか。"}, {"type": "subtitle", "time": 685.35, "timestamp": "00:11:25", "text": "え、"}, {"type": "subtitle", "time": 700.99, "timestamp": "00:11:40", "text": "じゃ次"}, {"type": "subtitle", "time": 701.91, "timestamp": "00:11:41", "text": "俺さん起きてる。"}, {"type": "subtitle", "time": 703.87, "timestamp": "00:11:43", "text": "つまさん寝てる。"}, {"type": "subtitle", "time": 706.088, "timestamp": "00:11:46", "text": "プロテイン食べてました。プロテイン。"}, {"type": "subtitle", "time": 712.069, "timestamp": "00:11:52", "text": "え、今回も"}]
[{"type": "subtitle", "time": 10625.63, "timestamp": "02:57:05", "text": "そう"}, {"type": "subtitle", "time": 10627.349, "timestamp": "02:57:07", "text": "振り返ってね向き合わしてくれたからな"}, {"type": "subtitle", "time": 10634.59, "timestamp": "02:57:14", "text": "みんな俺がお互いが同じ方向いて。"}, {"type": "subtitle", "time": 10634.95, "timestamp": "02:57:14", "text": "同じ。"}, {"type": "subtitle", "time": 10635.19, "timestamp": "02:57:15", "text": "そう。"}, {"type": "subtitle", "time": 10636.19, "timestamp": "02:57:16", "text": "ナイス。"}, {"type": "subtitle", "time": 10639.71, "timestamp": "02:57:19", "text": "できた。"}, {"type": "subtitle", "time": 10642.15, "timestamp": "02:57:22", "text": "3"}, {"type": "subtitle", "time": 10643.71, "timestamp": "02:57:23", "text": "回直しに行く。1"}, {"type": "subtitle", "time": 10645.469, "timestamp": "02:57:25", "text": "回直しに行こうか。直しに行ってもうか。"}, {"type": "subtitle", "time": 10647.71, "timestamp": "02:57:27", "text": "あの、リュック拾ったっけ?"}, {"type": "subtitle", "time": 10649.389, "timestamp": "02:57:29", "text": "リュック拾ってない。"}, {"type": "subtitle", "time": 10652.229, "timestamp": "02:57:32", "text": "あの、リュックない。多分"}, {"type": "subtitle", "time": 10654.269, "timestamp": "02:57:34", "text": "あの青いやつ。はい。"}, {"type": "subtitle", "time": 10671.91, "timestamp": "02:57:51", "text": "あ、これじゃない。"}, {"type": "subtitle", "time": 10673.19, "timestamp": "02:57:53", "text": "これもベルトだ。"}, {"type": "subtitle", "time": 10674.95, "timestamp": "02:57:54", "text": "今日難しい時。"}, {"type": "subtitle", "time": 10677.07, "timestamp": "02:57:57", "text": "ああ、これもベルト。"}, {"type": "subtitle", "time": 10677.67, "timestamp": "02:57:57", "text": "あ、待って。"}, {"type": "subtitle", "time": 10679.19, "timestamp": "02:57:59", "text": "リュックじゃ。あ、リュック。リュック。"}]
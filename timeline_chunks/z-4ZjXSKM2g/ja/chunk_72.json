[{"type": "subtitle", "time": 4322.03, "timestamp": "01:12:02", "text": "先に行かないでください。"}, {"type": "subtitle", "time": 4337.39, "timestamp": "01:12:17", "text": "あー"}, {"type": "subtitle", "time": 4339.47, "timestamp": "01:12:19", "text": "何か見つけたんですか?"}, {"type": "subtitle", "time": 4341.79, "timestamp": "01:12:21", "text": "どんどん数字増えてる。"}, {"type": "subtitle", "time": 4342.75, "timestamp": "01:12:22", "text": "どこや?"}, {"type": "subtitle", "time": 4345.35, "timestamp": "01:12:25", "text": "めちゃくちゃめちゃくちゃ向こうに"}, {"type": "subtitle", "time": 4348.51, "timestamp": "01:12:28", "text": "goingsofarの方でね。"}, {"type": "subtitle", "time": 4349.03, "timestamp": "01:12:29", "text": "すごい。"}, {"type": "subtitle", "time": 4351.149, "timestamp": "01:12:31", "text": "あ、なんかある。あるよ。"}, {"type": "subtitle", "time": 4356.07, "timestamp": "01:12:36", "text": "あるあるある。"}, {"type": "subtitle", "time": 4358.84, "timestamp": "01:12:38", "text": "ある。 何これ?"}, {"type": "subtitle", "time": 4359.239, "timestamp": "01:12:39", "text": "何これ? 反対側にも同じようなのあるから絶対ある関係あるだろう。"}, {"type": "subtitle", "time": 4362.199, "timestamp": "01:12:42", "text": "反対側にも同じようなのあるから絶対ある関係あるだろう。 ああ、関係ありそう。これなんだろう。"}, {"type": "subtitle", "time": 4371.95, "timestamp": "01:12:51", "text": "え、"}, {"type": "subtitle", "time": 4372.669, "timestamp": "01:12:52", "text": "これ何?"}, {"type": "subtitle", "time": 4374.229, "timestamp": "01:12:54", "text": "あ、またカウントするやつだ。"}, {"type": "subtitle", "time": 4376.11, "timestamp": "01:12:56", "text": "わかんね。落ちたんだよね。"}, {"type": "subtitle", "time": 4378.31, "timestamp": "01:12:58", "text": "下に"}]
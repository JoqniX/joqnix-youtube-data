[{"type": "subtitle", "time": 1987.31, "timestamp": "00:33:07", "text": "あ、"}, {"type": "subtitle", "time": 1989.83, "timestamp": "00:33:09", "text": "え、どこ行ったの?"}, {"type": "chat", "time": 1991.0, "timestamp": "00:33:11", "author": "@hariomfluteandrap", "avatar": "https://yt4.ggpht.com/uLmxuG6eMZD-leBcxuP2_JYccD9POZNjPz-fuOc9TTPAawcZy9q1tIRMiQjZvsvk-gSHwpggS2Q=s64-c-k-c0x00ffffff-no-rj", "message": "tell me"}, {"type": "subtitle", "time": 1991.509, "timestamp": "00:33:11", "text": "あ、上あ、いる。"}, {"type": "subtitle", "time": 1993.11, "timestamp": "00:33:13", "text": "ああ、いる。"}, {"type": "subtitle", "time": 2001.669, "timestamp": "00:33:21", "text": "合流した。オ、"}, {"type": "subtitle", "time": 2002.269, "timestamp": "00:33:22", "text": "オッケー。"}, {"type": "subtitle", "time": 2003.31, "timestamp": "00:33:23", "text": "合流できた。"}, {"type": "subtitle", "time": 2005.47, "timestamp": "00:33:25", "text": "変えて寝てる。"}, {"type": "subtitle", "time": 2006.47, "timestamp": "00:33:26", "text": "ベル抱えて見て"}, {"type": "subtitle", "time": 2008.269, "timestamp": "00:33:28", "text": "かいい。めっちゃ可愛い。"}, {"type": "subtitle", "time": 2010.31, "timestamp": "00:33:30", "text": "眠くならっちゃった。夜だから。"}, {"type": "subtitle", "time": 2021.87, "timestamp": "00:33:41", "text": "遊び疲れて寝てる子供みたいな。"}, {"type": "subtitle", "time": 2023.83, "timestamp": "00:33:43", "text": "寝ちゃった。"}, {"type": "subtitle", "time": 2026.559, "timestamp": "00:33:46", "text": "ちゃった。 で一応リュ君もう"}, {"type": "subtitle", "time": 2028.08, "timestamp": "00:33:48", "text": "で一応リュ君もう 1個。"}, {"type": "subtitle", "time": 2028.96, "timestamp": "00:33:48", "text": "1個。 山"}, {"type": "subtitle", "time": 2031.799, "timestamp": "00:33:51", "text": "山 山。これ"}, {"type": "subtitle", "time": 2034.399, "timestamp": "00:33:54", "text": "山。これ リックパスもそんな使わしました。"}, {"type": "subtitle", "time": 2039.31, "timestamp": "00:33:59", "text": "背負っといてもらおうかな。"}]
[{"type": "subtitle", "time": 8463.349, "timestamp": "02:21:03", "text": "あー。おうぜ。あ、"}, {"type": "subtitle", "time": 8465.389, "timestamp": "02:21:05", "text": "おお。なんだこれ?なんか"}, {"type": "subtitle", "time": 8477.03, "timestamp": "02:21:17", "text": "お、"}, {"type": "subtitle", "time": 8477.67, "timestamp": "02:21:17", "text": "使えるやつ。"}, {"type": "subtitle", "time": 8482.389, "timestamp": "02:21:22", "text": "へ、"}, {"type": "subtitle", "time": 8483.23, "timestamp": "02:21:23", "text": "ワンをびっくりした。"}, {"type": "subtitle", "time": 8487.83, "timestamp": "02:21:27", "text": "おお。"}, {"type": "subtitle", "time": 8488.99, "timestamp": "02:21:28", "text": "あ、あ、"}, {"type": "subtitle", "time": 8491.51, "timestamp": "02:21:31", "text": "これ怖い。聞こえる。あ、声聞えるね。"}, {"type": "subtitle", "time": 8500.15, "timestamp": "02:21:40", "text": "あ、これはめれるわ。"}, {"type": "subtitle", "time": 8502.15, "timestamp": "02:21:42", "text": "ああ。"}, {"type": "subtitle", "time": 8503.55, "timestamp": "02:21:43", "text": "ああ、ついてる。"}, {"type": "subtitle", "time": 8505.87, "timestamp": "02:21:45", "text": "ちょっと違うね。これ無だ。"}, {"type": "subtitle", "time": 8507.389, "timestamp": "02:21:47", "text": "おお。"}, {"type": "subtitle", "time": 8508.83, "timestamp": "02:21:48", "text": "あ、開いた。"}, {"type": "subtitle", "time": 8511.51, "timestamp": "02:21:51", "text": "開いた。ドア開きました。"}, {"type": "subtitle", "time": 8512.87, "timestamp": "02:21:52", "text": "え、"}]
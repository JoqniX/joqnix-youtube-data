[{"type": "subtitle", "time": 10020.71, "timestamp": "02:47:00", "text": "伝わってます。"}, {"type": "subtitle", "time": 10022.59, "timestamp": "02:47:02", "text": "うわあって。頑張れ。"}, {"type": "subtitle", "time": 10024.51, "timestamp": "02:47:04", "text": "見てる向き的にも合ってる。"}, {"type": "subtitle", "time": 10025.309, "timestamp": "02:47:05", "text": "頑張れ2人。"}, {"type": "subtitle", "time": 10027.23, "timestamp": "02:47:07", "text": "あ、よかった。よかった。"}, {"type": "subtitle", "time": 10036.15, "timestamp": "02:47:16", "text": "大丈夫かな?"}, {"type": "subtitle", "time": 10037.95, "timestamp": "02:47:17", "text": "頑張ってるなあ。"}, {"type": "subtitle", "time": 10040.269, "timestamp": "02:47:20", "text": "頑張ってる。頑張ってる。あ、"}, {"type": "subtitle", "time": 10042.19, "timestamp": "02:47:22", "text": "そろそろ"}, {"type": "subtitle", "time": 10047.59, "timestamp": "02:47:27", "text": "ここがレーザーポインター持ってるからめちゃくちゃしよ。"}, {"type": "subtitle", "time": 10053.469, "timestamp": "02:47:33", "text": "あ。正解。すごい。"}, {"type": "subtitle", "time": 10054.63, "timestamp": "02:47:34", "text": "やった。"}, {"type": "subtitle", "time": 10063.91, "timestamp": "02:47:43", "text": "来た。"}, {"type": "subtitle", "time": 10065.75, "timestamp": "02:47:45", "text": "行けた。"}, {"type": "subtitle", "time": 10075.429, "timestamp": "02:47:55", "text": "う。"}, {"type": "subtitle", "time": 10077.936, "timestamp": "02:47:57", "text": "あ。あ、蹴っちゃダめだよ。"}, {"type": "subtitle", "time": 10079.63, "timestamp": "02:47:59", "text": "[笑い]"}]
[{"type": "subtitle", "time": 2040.83, "timestamp": "00:34:00", "text": "おお"}, {"type": "subtitle", "time": 2042.71, "timestamp": "00:34:02", "text": "お確かにパス"}, {"type": "subtitle", "time": 2043.19, "timestamp": "00:34:03", "text": "コンパス"}, {"type": "subtitle", "time": 2045.43, "timestamp": "00:34:05", "text": "登れそうな場所がないね。あの山"}, {"type": "subtitle", "time": 2045.909, "timestamp": "00:34:05", "text": "えい"}, {"type": "subtitle", "time": 2046.99, "timestamp": "00:34:06", "text": "地図見た感じだけど。"}, {"type": "subtitle", "time": 2048.51, "timestamp": "00:34:08", "text": "はい。よし。"}, {"type": "subtitle", "time": 2050.75, "timestamp": "00:34:10", "text": "たら手が2つ開くってことだから。"}, {"type": "subtitle", "time": 2053.31, "timestamp": "00:34:13", "text": "うん。そんなにも持ってないわ。"}, {"type": "subtitle", "time": 2055.829, "timestamp": "00:34:15", "text": "じゃあ持てるってことだ。色々と。"}, {"type": "subtitle", "time": 2056.589, "timestamp": "00:34:16", "text": "うん。"}, {"type": "subtitle", "time": 2058.869, "timestamp": "00:34:18", "text": "やった。"}, {"type": "subtitle", "time": 2061.71, "timestamp": "00:34:21", "text": "全員背負置いたいな。"}, {"type": "subtitle", "time": 2070.71, "timestamp": "00:34:30", "text": "持ってるものわかんないから怖いんだけど。"}, {"type": "subtitle", "time": 2070.829, "timestamp": "00:34:30", "text": "1"}, {"type": "subtitle", "time": 2073.589, "timestamp": "00:34:33", "text": "回なんかロストしてないけど怖くなる。明るくなった。"}, {"type": "subtitle", "time": 2078.23, "timestamp": "00:34:38", "text": "あ、そうなの?"}, {"type": "subtitle", "time": 2084.669, "timestamp": "00:34:44", "text": "そう落とさないんじゃない?"}, {"type": "subtitle", "time": 2087.069, "timestamp": "00:34:47", "text": "危険じゃない?危なくない?"}, {"type": "subtitle", "time": 2088.069, "timestamp": "00:34:48", "text": "ちょっと待って。やばい。"}]
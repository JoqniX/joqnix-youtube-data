[{"type": "subtitle", "time": 6790.47, "timestamp": "01:53:10", "text": "うん。"}, {"type": "subtitle", "time": 6794.55, "timestamp": "01:53:14", "text": "じゃ、やって。"}, {"type": "subtitle", "time": 6796.47, "timestamp": "01:53:16", "text": "終わってない。確かに。"}, {"type": "subtitle", "time": 6798.87, "timestamp": "01:53:18", "text": "そう。座標のやつ全然終わってないから。"}, {"type": "subtitle", "time": 6799.87, "timestamp": "01:53:19", "text": "うん。"}, {"type": "subtitle", "time": 6812.99, "timestamp": "01:53:32", "text": "皮取っちゃった。"}, {"type": "subtitle", "time": 6817.39, "timestamp": "01:53:37", "text": "じゃあ行こうか。"}, {"type": "subtitle", "time": 6818.35, "timestamp": "01:53:38", "text": "オッケー。オッケー。オッケー。"}, {"type": "subtitle", "time": 6819.87, "timestamp": "01:53:39", "text": "はい。行きましょう。"}, {"type": "subtitle", "time": 6820.79, "timestamp": "01:53:40", "text": "はい。"}, {"type": "subtitle", "time": 6822.548, "timestamp": "01:53:42", "text": "レーザー。レーザー"}, {"type": "subtitle", "time": 6823.229, "timestamp": "01:53:43", "text": "[咳払い]"}, {"type": "subtitle", "time": 6823.91, "timestamp": "01:53:43", "text": "レーザー。"}, {"type": "subtitle", "time": 6826.75, "timestamp": "01:53:46", "text": "どういう方?本当にどういう方?"}, {"type": "subtitle", "time": 6828.47, "timestamp": "01:53:48", "text": "それは"}, {"type": "subtitle", "time": 6831.109, "timestamp": "01:53:51", "text": "いらないじゃないかな。みんな"}, {"type": "subtitle", "time": 6834.03, "timestamp": "01:53:54", "text": "ベル必須か。やっぱベル必須だ。"}, {"type": "subtitle", "time": 6836.589, "timestamp": "01:53:56", "text": "ベルは必須。"}, {"type": "subtitle", "time": 6836.99, "timestamp": "01:53:56", "text": "こいと"}, {"type": "subtitle", "time": 6839.27, "timestamp": "01:53:59", "text": "行きます。もう"}, {"type": "subtitle", "time": 6839.51, "timestamp": "01:53:59", "text": "はい。"}]
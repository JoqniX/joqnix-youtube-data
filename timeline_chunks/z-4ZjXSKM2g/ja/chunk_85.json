[{"type": "subtitle", "time": 5105.83, "timestamp": "01:25:05", "text": "2人いるんですけど2"}, {"type": "subtitle", "time": 5116.39, "timestamp": "01:25:16", "text": "お水取りに行った人とおトイレ行った人と"}, {"type": "subtitle", "time": 5119.149, "timestamp": "01:25:19", "text": "ここ見とこうかな。ここで一応人がまだ"}, {"type": "subtitle", "time": 5122.43, "timestamp": "01:25:22", "text": "色々やってくれてる途中だと思うから"}, {"type": "subtitle", "time": 5148.149, "timestamp": "01:25:48", "text": "あ、"}, {"type": "subtitle", "time": 5150.55, "timestamp": "01:25:50", "text": "押せないボタンを"}, {"type": "subtitle", "time": 5154.709, "timestamp": "01:25:54", "text": "この世に押せないボタンしないです。"}]
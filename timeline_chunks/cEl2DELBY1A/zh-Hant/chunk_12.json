[{"type": "subtitle", "time": 722.55, "timestamp": "00:12:02", "text": "聖誕冒險之旅，"}, {"type": "subtitle", "time": 724.15, "timestamp": "00:12:04", "text": "對心臟有益。"}, {"type": "subtitle", "time": 726.47, "timestamp": "00:12:06", "text": "恐怖題材對內容來說是好事。"}, {"type": "subtitle", "time": 728.069, "timestamp": "00:12:08", "text": "射擊遊戲。"}, {"type": "subtitle", "time": 730.71, "timestamp": "00:12:10", "text": "哦，這真是最棒的"}, {"type": "subtitle", "time": 734.71, "timestamp": "00:12:14", "text": "拍攝！我不喜歡射擊遊戲。"}, {"type": "subtitle", "time": 738.389, "timestamp": "00:12:18", "text": "如果是大逃殺遊戲，那呃，我"}, {"type": "subtitle", "time": 741.59, "timestamp": "00:12:21", "text": "不知道你會不會死。如果你經常死，"}, {"type": "subtitle", "time": 745.75, "timestamp": "00:12:25", "text": "你會感到悲傷。不，但廣告"}, {"type": "subtitle", "time": 747.829, "timestamp": "00:12:27", "text": "成癮問題依然存在。"}, {"type": "subtitle", "time": 749.829, "timestamp": "00:12:29", "text": "我不喜歡大逃殺遊戲。我不知道，我"}, {"type": "subtitle", "time": 751.19, "timestamp": "00:12:31", "text": "不知道為什麼（音樂）。"}, {"type": "subtitle", "time": 754.389, "timestamp": "00:12:34", "text": "哦，我不喜歡射擊遊戲，"}, {"type": "subtitle", "time": 757.03, "timestamp": "00:12:37", "text": "因為我總是輸。是的"}, {"type": "subtitle", "time": 764.629, "timestamp": "00:12:44", "text": "最令人難過的是，我的意思是，"}, {"type": "subtitle", "time": 767.269, "timestamp": "00:12:47", "text": "在冒險遊戲中這很容易做到。"}, {"type": "subtitle", "time": 772.79, "timestamp": "00:12:52", "text": "像射擊遊戲這類遊戲就很難。對"}]
[{"type": "subtitle", "time": 543.59, "timestamp": "00:09:03", "text": "呃，他們透過和"}, {"type": "subtitle", "time": 545.99, "timestamp": "00:09:05", "text": "他們所有人交談的方式邀請我過新年。有時候"}, {"type": "subtitle", "time": 549.75, "timestamp": "00:09:09", "text": "直播的時候如果沒有觀眾，大家"}, {"type": "subtitle", "time": 552.47, "timestamp": "00:09:12", "text": "自言自語就很糟糕。 [音樂] 我想跟"}, {"type": "subtitle", "time": 557.75, "timestamp": "00:09:17", "text": "你聊天，別擔心。"}, {"type": "subtitle", "time": 561.03, "timestamp": "00:09:21", "text": "我能理解。"}, {"type": "subtitle", "time": 564.55, "timestamp": "00:09:24", "text": "是啊，有人陪伴真的很有幫助"}, {"type": "subtitle", "time": 565.269, "timestamp": "00:09:25", "text": "。"}, {"type": "subtitle", "time": 568.949, "timestamp": "00:09:28", "text": "好的，關於模型還有一個問題。"}, {"type": "subtitle", "time": 589.509, "timestamp": "00:09:49", "text": "是啊，2D動畫確實很漂亮"}, {"type": "subtitle", "time": 591.11, "timestamp": "00:09:51", "text": "。用 2D 即時影像可以做很多事情"}, {"type": "subtitle", "time": 595.99, "timestamp": "00:09:55", "text": "，但用 3D 即時影像更"}, {"type": "subtitle", "time": 598.63, "timestamp": "00:09:58", "text": "實用。"}, {"type": "subtitle", "time": 599.67, "timestamp": "00:09:59", "text": "我猜"}]
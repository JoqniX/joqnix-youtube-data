[{"type": "subtitle", "time": 4268.709, "timestamp": "01:11:08", "text": "。  好了，是時候結束了。我們會"}, {"type": "subtitle", "time": 4270.95, "timestamp": "01:11:10", "text": "開始這麼做的。"}, {"type": "subtitle", "time": 4273.75, "timestamp": "01:11:13", "text": "你好，M。新年快樂。新年快樂。"}, {"type": "subtitle", "time": 4277.91, "timestamp": "01:11:17", "text": "你遲到了。我要結束直播了。"}, {"type": "subtitle", "time": 4279.91, "timestamp": "01:11:19", "text": "[笑聲]"}, {"type": "subtitle", "time": 4283.03, "timestamp": "01:11:23", "text": "沒關係。 [音樂] 新年快樂，M。"}]
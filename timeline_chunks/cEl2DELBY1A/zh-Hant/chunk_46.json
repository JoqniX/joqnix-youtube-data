[{"type": "subtitle", "time": 2769.589, "timestamp": "00:46:09", "text": "今年有什麼建議可以給自己嗎？你覺得這些建議會有幫助嗎？嗯，就我個人而言，我一直都不敢"}, {"type": "subtitle", "time": 2774.79, "timestamp": "00:46:14", "text": "現在就發東西，因為擔心品質問題等等。我可能會說我連封面都買不起。我會"}, {"type": "subtitle", "time": 2783.75, "timestamp": "00:46:23", "text": "說，我找不到人幫我混音，"}, {"type": "subtitle", "time": 2785.829, "timestamp": "00:46:25", "text": "或是幫我製作音樂影片什麼的。"}, {"type": "subtitle", "time": 2789.19, "timestamp": "00:46:29", "text": "不，我們"}, {"type": "subtitle", "time": 2791.19, "timestamp": "00:46:31", "text": "總是會找各種藉口，"}, {"type": "chat", "time": 2791.298, "timestamp": "00:46:31", "author": "@HamidSenseii", "avatar": "https://yt4.ggpht.com/ytc/AIdro_moeku1wSJ_5JYElsivgwUBW9jYwk2tsk6dgkop4bCQX9KRj77yp1bZwNyZvBy82WKOMA=s64-c-k-c0x00ffffff-no-rj", "message": "What are you guys talking about is it about future planning"}, {"type": "subtitle", "time": 2794.309, "timestamp": "00:46:34", "text": "說這個行不通，那個行不通，等等等等。但就我個人而言，這些年來"}, {"type": "subtitle", "time": 2796.15, "timestamp": "00:46:36", "text": "我一直在玩遊戲，做"}, {"type": "subtitle", "time": 2808.309, "timestamp": "00:46:48", "text": "各種各樣的事情，而今年（2026）我想專注於"}, {"type": "subtitle", "time": 2810.47, "timestamp": "00:46:50", "text": "內容創作。嗯，該怎麼說呢？但是，有些創作者會關注分析數據、"}, {"type": "subtitle", "time": 2813.109, "timestamp": "00:46:53", "text": "趨勢等等。不，我一直都是那種不在乎數字，只關注流行趨勢的人。  我想玩什麼遊戲就玩什麼遊戲。不。"}, {"type": "subtitle", "time": 2815.67, "timestamp": "00:46:55", "text": "所以這次，我想更進一步，"}, {"type": "subtitle", "time": 2819.589, "timestamp": "00:46:59", "text": "看看我能製作哪些熱門"}]
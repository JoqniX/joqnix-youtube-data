[{"type": "subtitle", "time": 3840.95, "timestamp": "01:04:00", "text": "尝试每次直播都给自己定"}, {"type": "subtitle", "time": 3843.27, "timestamp": "01:04:03", "text": "目标：先说10分钟，"}, {"type": "subtitle", "time": 3845.75, "timestamp": "01:04:05", "text": "如果我能做到10分钟，"}, {"type": "subtitle", "time": 3849.51, "timestamp": "01:04:09", "text": "如果我能不出错、"}, {"type": "subtitle", "time": 3852.069, "timestamp": "01:04:12", "text": "不费力地说完10分钟，我就争取说20分钟。就这样"}, {"type": "subtitle", "time": 3860.15, "timestamp": "01:04:20", "text": "慢慢来，这些年来我的"}, {"type": "subtitle", "time": 3863.51, "timestamp": "01:04:23", "text": "英语水平终于可以算不错了。"}, {"type": "subtitle", "time": 3866.549, "timestamp": "01:04:26", "text": "嗯，我觉得一个好建议是多"}, {"type": "subtitle", "time": 3870.39, "timestamp": "01:04:30", "text": "看英语作品、"}, {"type": "subtitle", "time": 3872.309, "timestamp": "01:04:32", "text": "英语电影，多"}, {"type": "subtitle", "time": 3875.27, "timestamp": "01:04:35", "text": "接触英语内容，多接触英语媒体。"}, {"type": "subtitle", "time": 3877.589, "timestamp": "01:04:37", "text": "现在人们在教"}, {"type": "subtitle", "time": 3879.67, "timestamp": "01:04:39", "text": "你学习"}, {"type": "subtitle", "time": 3882.309, "timestamp": "01:04:42", "text": "日语等语言时，也会给你同样的建议。"}, {"type": "subtitle", "time": 3885.75, "timestamp": "01:04:45", "text": "消费媒体，对吧？ 不要仅仅把"}, {"type": "subtitle", "time": 3888.63, "timestamp": "01:04:48", "text": "它当作娱乐来欣赏，还要"}, {"type": "subtitle", "time": 3891.43, "timestamp": "01:04:51", "text": "注意句子的结构"}, {"type": "subtitle", "time": 3895.91, "timestamp": "01:04:55", "text": "等等，对吧？ 是的。 嗯，为什么会"}, {"type": "subtitle", "time": 3899.349, "timestamp": "01:04:59", "text": "这样提到一个句子呢？"}]
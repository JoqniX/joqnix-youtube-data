[{"type": "subtitle", "time": 2342.71, "timestamp": "00:39:02", "text": "呵呵，我猜他是印度最倒霉的人吧"}, {"type": "subtitle", "time": 2345.27, "timestamp": "00:39:05", "text": "。 就像其他人一样，大家都经常咒骂他"}, {"type": "subtitle", "time": 2352.23, "timestamp": "00:39:12", "text": "你会打电话问对方什么时候才能"}, {"type": "subtitle", "time": 2354.87, "timestamp": "00:39:14", "text": "恢复供电吗？ 他们"}, {"type": "subtitle", "time": 2357.99, "timestamp": "00:39:17", "text": "说了什么？ 他们没拿走手机吗？   是的"}, {"type": "subtitle", "time": 2360.71, "timestamp": "00:39:20", "text": "，这事确实"}, {"type": "subtitle", "time": 2363.589, "timestamp": "00:39:23", "text": "发生在我身上了。 事情是这样的，在通过"}, {"type": "subtitle", "time": 2366.39, "timestamp": "00:39:26", "text": "应用程序提交了两份报告后，我"}, {"type": "subtitle", "time": 2369.27, "timestamp": "00:39:29", "text": "第三次给"}, {"type": "subtitle", "time": 2371.19, "timestamp": "00:39:31", "text": "他打电话，第四次，"}, {"type": "subtitle", "time": 2373.19, "timestamp": "00:39:33", "text": "第五次之后他就不"}, {"type": "subtitle", "time": 2376.069, "timestamp": "00:39:36", "text": "再接电话了。"}, {"type": "subtitle", "time": 2378.63, "timestamp": "00:39:38", "text": "当时我就想，"}, {"type": "subtitle", "time": 2381.589, "timestamp": "00:39:41", "text": "兄弟，听着，"}, {"type": "subtitle", "time": 2384.87, "timestamp": "00:39:44", "text": "别给我希望了，好吗？就此打住吧。同样的事情再次发生，同样的事情再次发生，"}, {"type": "subtitle", "time": 2389.91, "timestamp": "00:39:49", "text": "我的天哪，"}, {"type": "subtitle", "time": 2392.95, "timestamp": "00:39:52", "text": "但是现在，但是现在，但是现在它不再"}, {"type": "subtitle", "time": 2395.27, "timestamp": "00:39:55", "text": "来了。   是的"}, {"type": "subtitle", "time": 2398.71, "timestamp": "00:39:58", "text": "。 现在感觉就像冬天一样。   是的"}]
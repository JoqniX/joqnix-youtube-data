[{"type": "subtitle", "time": 4381.91, "timestamp": "01:13:01", "text": "那是四月份的事，是啊是啊是"}, {"type": "subtitle", "time": 4385.35, "timestamp": "01:13:05", "text": "啊，如果什么事都没发生的话，我会在二月份拿到我的在留资格证书"}, {"type": "subtitle", "time": 4388.149, "timestamp": "01:13:08", "text": "[叹气和倒吸一口气]"}, {"type": "subtitle", "time": 4391.35, "timestamp": "01:13:11", "text": "。 如果一切"}, {"type": "subtitle", "time": 4393.83, "timestamp": "01:13:13", "text": "顺利，那就很好。 我"}, {"type": "subtitle", "time": 4395.91, "timestamp": "01:13:15", "text": "1月18日有考试。"}, {"type": "subtitle", "time": 4398.229, "timestamp": "01:13:18", "text": "我必须复习日语考试。 我"}, {"type": "subtitle", "time": 4401.51, "timestamp": "01:13:21", "text": "得去钦奈，"}, {"type": "subtitle", "time": 4402.95, "timestamp": "01:13:22", "text": "嗯[笑]对，"}, {"type": "subtitle", "time": 4407.35, "timestamp": "01:13:27", "text": "再去钦奈看看肯定很棒。"}, {"type": "subtitle", "time": 4409.5, "timestamp": "01:13:29", "text": "那里的文化就像是另一种文化。"}, {"type": "subtitle", "time": 4410.149, "timestamp": "01:13:30", "text": "[笑声]"}, {"type": "subtitle", "time": 4414.31, "timestamp": "01:13:34", "text": "一切都变得如此不同。 哇。"}, {"type": "subtitle", "time": 4417.43, "timestamp": "01:13:37", "text": "M的孩子离开后，我不想"}, {"type": "subtitle", "time": 4421.83, "timestamp": "01:13:41", "text": "离开了。 但我也想离开。   是"}, {"type": "subtitle", "time": 4424.79, "timestamp": "01:13:44", "text": "啊，（笑）事情就是这样"}, {"type": "subtitle", "time": 4433.27, "timestamp": "01:13:53", "text": "总之，我就先说到这里吧。"}, {"type": "subtitle", "time": 4436.149, "timestamp": "01:13:56", "text": "我们下午"}]
[{"type": "subtitle", "time": 4203.03, "timestamp": "01:10:03", "text": "就像几周前那样。 啊，"}, {"type": "subtitle", "time": 4205.75, "timestamp": "01:10:05", "text": "我跟大家的近况都完全不搭边了"}, {"type": "subtitle", "time": 4211.91, "timestamp": "01:10:11", "text": "啊，"}, {"type": "subtitle", "time": 4214.47, "timestamp": "01:10:14", "text": "我跟大家都太不熟了。"}, {"type": "subtitle", "time": 4216.709, "timestamp": "01:10:16", "text": "我一直都在，但"}, {"type": "subtitle", "time": 4220.87, "timestamp": "01:10:20", "text": "我甚至都没跟任何人说过话。"}, {"type": "subtitle", "time": 4222.87, "timestamp": "01:10:22", "text": "我呃，"}, {"type": "subtitle", "time": 4224.95, "timestamp": "01:10:24", "text": "我甚至还没祝任何人新年快乐呢"}, {"type": "subtitle", "time": 4225.99, "timestamp": "01:10:25", "text": "。  [笑声]"}, {"type": "subtitle", "time": 4230.55, "timestamp": "01:10:30", "text": "只有私信我的人。 我"}, {"type": "subtitle", "time": 4234.07, "timestamp": "01:10:34", "text": "通常是那种会祝所有人"}, {"type": "subtitle", "time": 4237.35, "timestamp": "01:10:37", "text": "新年快乐的人。 但是，现在我不能再做"}, {"type": "subtitle", "time": 4240.709, "timestamp": "01:10:40", "text": "那种事了，"}, {"type": "subtitle", "time": 4242.95, "timestamp": "01:10:42", "text": "因为我不知道谁还在"}, {"type": "subtitle", "time": 4244.79, "timestamp": "01:10:44", "text": "和我说话，谁还在和我保持联系"}, {"type": "subtitle", "time": 4249.35, "timestamp": "01:10:49", "text": "。 就是这样。"}]
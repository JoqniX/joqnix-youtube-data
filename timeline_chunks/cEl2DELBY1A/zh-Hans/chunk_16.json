[{"type": "subtitle", "time": 962.47, "timestamp": "00:16:02", "text": "见到他之后我就自信多了。 所以[音乐]是的，"}, {"type": "subtitle", "time": 965.43, "timestamp": "00:16:05", "text": "我五月份开始做音乐，然后八月份停了下来，"}, {"type": "subtitle", "time": 966.71, "timestamp": "00:16:06", "text": "因为"}, {"type": "subtitle", "time": 969.67, "timestamp": "00:16:09", "text": "像你好 Rishio 8610 欢迎来到直播间，"}, {"type": "subtitle", "time": 973.03, "timestamp": "00:16:13", "text": "就像现实生活中要面对很多事情一样，对吧，"}, {"type": "subtitle", "time": 975.43, "timestamp": "00:16:15", "text": "考试[音乐]和所有的学习"}, {"type": "subtitle", "time": 977.67, "timestamp": "00:16:17", "text": "等等，然后我就停了下来，"}, {"type": "subtitle", "time": 979.99, "timestamp": "00:16:19", "text": "最近我又停了几个星期，"}, {"type": "subtitle", "time": 983.11, "timestamp": "00:16:23", "text": "因为呃，"}, {"type": "subtitle", "time": 988.069, "timestamp": "00:16:28", "text": "我的 3D 模型出了点问题，呃，我"}, {"type": "subtitle", "time": 991.189, "timestamp": "00:16:31", "text": "不得不面对很多与我的 3D 模型有关的事情"}, {"type": "subtitle", "time": 1002.55, "timestamp": "00:16:42", "text": "P，你呢？"}, {"type": "subtitle", "time": 1005.43, "timestamp": "00:16:45", "text": "你的怎么样？ 我觉得你现在也和你一样，在"}, {"type": "subtitle", "time": 1016.55, "timestamp": "00:16:56", "text": "。 就像最近这样。   是的"}, {"type": "subtitle", "time": 1018.629, "timestamp": "00:16:58", "text": "。 说说那件事吧。"}]
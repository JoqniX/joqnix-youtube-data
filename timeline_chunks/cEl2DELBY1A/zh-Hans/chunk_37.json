[{"type": "subtitle", "time": 2220.63, "timestamp": "00:37:00", "text": "如此。 你们还继续吗？"}, {"type": "subtitle", "time": 2223.109, "timestamp": "00:37:03", "text": "美国。"}, {"type": "subtitle", "time": 2227.27, "timestamp": "00:37:07", "text": "我刚才只是说，呃，气氛很紧张"}, {"type": "subtitle", "time": 2231.19, "timestamp": "00:37:11", "text": "。 过去一年简直是"}, {"type": "subtitle", "time": 2234.31, "timestamp": "00:37:14", "text": "充满压力的一年。"}, {"type": "subtitle", "time": 2236.47, "timestamp": "00:37:16", "text": "我真的希望这将是"}, {"type": "subtitle", "time": 2239.67, "timestamp": "00:37:19", "text": "平静安宁的一年，像一个风平浪静的"}, {"type": "subtitle", "time": 2241.43, "timestamp": "00:37:21", "text": "年份。 希望就这些了"}, {"type": "subtitle", "time": 2242.55, "timestamp": "00:37:22", "text": "。  [音乐] 是的"}, {"type": "subtitle", "time": 2244.63, "timestamp": "00:37:24", "text": "。"}, {"type": "subtitle", "time": 2247.51, "timestamp": "00:37:27", "text": "你刚才说什么来着？"}, {"type": "subtitle", "time": 2250.15, "timestamp": "00:37:30", "text": "我刚才说的是，我注意到"}, {"type": "subtitle", "time": 2252.79, "timestamp": "00:37:32", "text": "叙利亚的 YouTube 直播突然中断了。 我当时"}, {"type": "subtitle", "time": 2254.069, "timestamp": "00:37:34", "text": "就想，“哦，不。”   是的"}, {"type": "subtitle", "time": 2257.43, "timestamp": "00:37:37", "text": "。 是的。 它像很多动物一样死去。 呃，但是"}, {"type": "subtitle", "time": 2259.27, "timestamp": "00:37:39", "text": "，每次我尝试"}, {"type": "subtitle", "time": 2262.386, "timestamp": "00:37:42", "text": "重新开始直播的时候，我的 OBS"}, {"type": "subtitle", "time": 2264.79, "timestamp": "00:37:44", "text": "[音乐] 就会莫名其妙地关闭。"}, {"type": "subtitle", "time": 2267.27, "timestamp": "00:37:47", "text": "我当时就想，那我就只运营"}, {"type": "subtitle", "time": 2270.55, "timestamp": "00:37:50", "text": "Twitch 频道吧。"}, {"type": "subtitle", "time": 2272.87, "timestamp": "00:37:52", "text": "没关系。 这种事时有发生。"}, {"type": "subtitle", "time": 2275.27, "timestamp": "00:37:55", "text": "我只是在这里。 我的直播间里一片哀嚎。"}, {"type": "subtitle", "time": 2278.39, "timestamp": "00:37:58", "text": "哦，不。 没关系。  [笑声] 是的"}]
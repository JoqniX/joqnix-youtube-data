[{"type": "subtitle", "time": 3783.349, "timestamp": "01:03:03", "text": "年轻的职场人士，你们好。 欢迎。 嗯，"}, {"type": "subtitle", "time": 3784.789, "timestamp": "01:03:04", "text": "直播。 是的，我今年没能做到"}, {"type": "subtitle", "time": 3786.87, "timestamp": "01:03:06", "text": "。 没关系。 至少视频我已经拍完了"}, {"type": "subtitle", "time": 3789.91, "timestamp": "01:03:09", "text": "。 是的，我不想"}, {"type": "subtitle", "time": 3793.19, "timestamp": "01:03:13", "text": "直播，因为我的视频渲染时间太长了"}, {"type": "subtitle", "time": 3797.51, "timestamp": "01:03:17", "text": "。"}, {"type": "subtitle", "time": 3803.27, "timestamp": "01:03:23", "text": "，你的英语真好。 我"}, {"type": "subtitle", "time": 3806.069, "timestamp": "01:03:26", "text": "英语不好。 你知道我"}, {"type": "subtitle", "time": 3807.589, "timestamp": "01:03:27", "text": "英语很差。"}, {"type": "subtitle", "time": 3812.23, "timestamp": "01:03:32", "text": "问题是，我刚"}, {"type": "subtitle", "time": 3815.829, "timestamp": "01:03:35", "text": "开始做直播的时候，我的"}, {"type": "subtitle", "time": 3818.23, "timestamp": "01:03:38", "text": "英语很差。 我从未和任何人说过话。"}, {"type": "subtitle", "time": 3822.069, "timestamp": "01:03:42", "text": "不。所以我每次直播都会给自己设定"}, {"type": "subtitle", "time": 3825.349, "timestamp": "01:03:45", "text": "一个挑战，比如这次"}, {"type": "subtitle", "time": 3828.63, "timestamp": "01:03:48", "text": "直播我要讲10分钟"}, {"type": "subtitle", "time": 3832.47, "timestamp": "01:03:52", "text": "或者5分钟。 我必须用"}, {"type": "subtitle", "time": 3834.87, "timestamp": "01:03:54", "text": "规范的英语句子说话，否则就得挑战自己。"}, {"type": "subtitle", "time": 3838.15, "timestamp": "01:03:58", "text": "不。所以我开始"}]
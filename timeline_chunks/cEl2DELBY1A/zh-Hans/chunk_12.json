[{"type": "subtitle", "time": 722.55, "timestamp": "00:12:02", "text": "圣诞冒险之旅，"}, {"type": "subtitle", "time": 724.15, "timestamp": "00:12:04", "text": "对心脏有益。"}, {"type": "subtitle", "time": 726.47, "timestamp": "00:12:06", "text": "恐怖题材对内容来说是好事。"}, {"type": "subtitle", "time": 728.069, "timestamp": "00:12:08", "text": "射击游戏。"}, {"type": "subtitle", "time": 730.71, "timestamp": "00:12:10", "text": "哦，这真是最棒的"}, {"type": "subtitle", "time": 734.71, "timestamp": "00:12:14", "text": "拍摄！ 我不喜欢射击游戏。"}, {"type": "subtitle", "time": 738.389, "timestamp": "00:12:18", "text": "如果是大逃杀游戏，那呃，我"}, {"type": "subtitle", "time": 741.59, "timestamp": "00:12:21", "text": "不知道你会不会死。 如果你经常死，"}, {"type": "subtitle", "time": 745.75, "timestamp": "00:12:25", "text": "你会感到悲伤。 不，但广告"}, {"type": "subtitle", "time": 747.829, "timestamp": "00:12:27", "text": "成瘾问题依然存在。"}, {"type": "subtitle", "time": 749.829, "timestamp": "00:12:29", "text": "我不喜欢大逃杀游戏。 我不知道，我"}, {"type": "subtitle", "time": 751.19, "timestamp": "00:12:31", "text": "不知道为什么（音乐）。"}, {"type": "subtitle", "time": 754.389, "timestamp": "00:12:34", "text": "哦，我不喜欢射击游戏，"}, {"type": "subtitle", "time": 757.03, "timestamp": "00:12:37", "text": "因为我总是输。 是的"}, {"type": "subtitle", "time": 764.629, "timestamp": "00:12:44", "text": "最令人难过的是，我的意思是，"}, {"type": "subtitle", "time": 767.269, "timestamp": "00:12:47", "text": "在冒险游戏中这很容易做到。"}, {"type": "subtitle", "time": 772.79, "timestamp": "00:12:52", "text": "像射击游戏这类游戏就很难。 对我来说，"}, {"type": "subtitle", "time": 776.15, "timestamp": "00:12:56", "text": "这取决于我的心情。"}, {"type": "subtitle", "time": 778.389, "timestamp": "00:12:58", "text": "哦，"}]
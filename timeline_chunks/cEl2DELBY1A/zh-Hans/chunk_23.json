[{"type": "subtitle", "time": 1389.029, "timestamp": "00:23:09", "text": "是的，"}, {"type": "subtitle", "time": 1394.789, "timestamp": "00:23:14", "text": "可以说是混乱的一年，但"}, {"type": "subtitle", "time": 1398.63, "timestamp": "00:23:18", "text": "我想我们也学到了很多东西。   是的"}, {"type": "subtitle", "time": 1401.11, "timestamp": "00:23:21", "text": "，"}, {"type": "subtitle", "time": 1405.27, "timestamp": "00:23:25", "text": "我觉得"}, {"type": "subtitle", "time": 1409.11, "timestamp": "00:23:29", "text": "今年首先有很多"}, {"type": "subtitle", "time": 1411.43, "timestamp": "00:23:31", "text": "政治事件，然后是"}, {"type": "subtitle", "time": 1415.35, "timestamp": "00:23:35", "text": "地理事件，然后是战争"}, {"type": "subtitle", "time": 1417.27, "timestamp": "00:23:37", "text": "事件，是的，这是"}, {"type": "subtitle", "time": 1420.95, "timestamp": "00:23:40", "text": "不同寻常的"}, {"type": "subtitle", "time": 1424.549, "timestamp": "00:23:44", "text": "一年。至于音乐，现在我们有了我们"}, {"type": "subtitle", "time": 1428.31, "timestamp": "00:23:48", "text": "为了子孙后代而幸存下来的故事"}, {"type": "subtitle", "time": 1430.23, "timestamp": "00:23:50", "text": "。"}, {"type": "subtitle", "time": 1431.35, "timestamp": "00:23:51", "text": "嗯。"}, {"type": "subtitle", "time": 1434.63, "timestamp": "00:23:54", "text": "至于V型管材，我认为"}, {"type": "subtitle", "time": 1437.51, "timestamp": "00:23:57", "text": "印度终于有很多人开始"}, {"type": "subtitle", "time": 1439.83, "timestamp": "00:23:59", "text": "接触它了。 是的，这很贵。"}]
[{"type": "subtitle", "time": 2109.51, "timestamp": "00:35:09", "text": "日本に行けるのは3月までしかないので、2か月後には帰国する予定なので、IRLに集中したいと思うんです。"}, {"type": "subtitle", "time": 2113.829, "timestamp": "00:35:13", "text": "日本から配信できればいいなと思います。 それは"}, {"type": "subtitle", "time": 2116.79, "timestamp": "00:35:16", "text": "大変でしょう。 うーん、おそらく"}, {"type": "subtitle", "time": 2119.27, "timestamp": "00:35:19", "text": "6か月くらいかかると思いますが、頑張ってみます"}, {"type": "subtitle", "time": 2122.23, "timestamp": "00:35:22", "text": "。 多分。 わかりません"}, {"type": "subtitle", "time": 2124.47, "timestamp": "00:35:24", "text": "（笑）ストリーミングは"}, {"type": "subtitle", "time": 2129.109, "timestamp": "00:35:29", "text": "楽しいですから。 いえ、"}, {"type": "subtitle", "time": 2132.069, "timestamp": "00:35:32", "text": "内容も含めて全力を尽くしていただきたいと思います。"}, {"type": "subtitle", "time": 2135.829, "timestamp": "00:35:35", "text": "ビデオブログを作るかもしれません。 それはいいですね。"}, {"type": "subtitle", "time": 2143.109, "timestamp": "00:35:43", "text": "。 うん。  [音楽] はい。 わかった。 私のものです。"}, {"type": "subtitle", "time": 2147.589, "timestamp": "00:35:47", "text": "えっと、僕は"}, {"type": "subtitle", "time": 2150.15, "timestamp": "00:35:50", "text": "[音楽] に関して具体的な目標があって、例えば Twitch や YouTube でもっと視聴者を増やしたり、"}, {"type": "subtitle", "time": 2156.79, "timestamp": "00:35:56", "text": "今年はボードがあるのでチュービングを続けたりして、"}, {"type": "subtitle", "time": 2159.75, "timestamp": "00:35:59", "text": "そこでも優秀な成績を収めたいと思っています。 今年が"}]
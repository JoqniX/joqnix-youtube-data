[{"type": "subtitle", "time": 902.629, "timestamp": "00:15:02", "text": "ええ、本当にすぐに興味が湧いてしまいました。"}, {"type": "subtitle", "time": 904.87, "timestamp": "00:15:04", "text": "文字通り、3D モデルを変更しただけです"}, {"type": "subtitle", "time": 907.189, "timestamp": "00:15:07", "text": "。 新しい3Dモデルを手に入れました。  2 回のストリームで使用しましたが、"}, {"type": "subtitle", "time": 912.629, "timestamp": "00:15:12", "text": "これは気に入らないと思いました。 別のものを使います。"}, {"type": "subtitle", "time": 921.269, "timestamp": "00:15:21", "text": "うん。"}, {"type": "subtitle", "time": 923.43, "timestamp": "00:15:23", "text": "そして、私は"}, {"type": "subtitle", "time": 925.99, "timestamp": "00:15:25", "text": "ストリーミングが大好きで、それが"}, {"type": "subtitle", "time": 930.755, "timestamp": "00:15:30", "text": "私に平穏を与えてくれるので、これをもっと一貫して行う必要があります。"}, {"type": "subtitle", "time": 931.189, "timestamp": "00:15:31", "text": "[咳払い]"}, {"type": "subtitle", "time": 932.949, "timestamp": "00:15:32", "text": "あなたにもいろいろあったでしょ"}, {"type": "subtitle", "time": 936.389, "timestamp": "00:15:36", "text": "う？  Meoさん、確か、私の"}, {"type": "subtitle", "time": 939.43, "timestamp": "00:15:39", "text": "記憶が正しければ、あなたも"}, {"type": "subtitle", "time": 942.389, "timestamp": "00:15:42", "text": "配信をやめるつもりだったよね？"}, {"type": "subtitle", "time": 944.389, "timestamp": "00:15:44", "text": "うん。 そうですね、"}, {"type": "subtitle", "time": 946.949, "timestamp": "00:15:46", "text": "ストリーミングをやめるつもりでした。 わかった、わかった、教えてよ。"}, {"type": "subtitle", "time": 951.11, "timestamp": "00:15:51", "text": "それで、基本的に私は5月にストリーミングを始めましたが、"}, {"type": "subtitle", "time": 959.59, "timestamp": "00:15:59", "text": "そのときJonixが私を大いに助けてくれました。 うん、"}]
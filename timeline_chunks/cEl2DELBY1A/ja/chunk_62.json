[{"type": "subtitle", "time": 3721.99, "timestamp": "01:02:01", "text": "。 わかった。  [鼻で笑う] そして、ゲームでもしたり"}, {"type": "subtitle", "time": 3724.15, "timestamp": "01:02:04", "text": "。 うん。 私はまだクリエイターの作品に触れたことがないので、"}, {"type": "subtitle", "time": 3731.349, "timestamp": "01:02:11", "text": "Arc Raiders をぜひプレイしたいです。 うん。"}, {"type": "subtitle", "time": 3735.75, "timestamp": "01:02:15", "text": "それで完了です。 食事もできました。  [笑い]"}, {"type": "subtitle", "time": 3738.069, "timestamp": "01:02:18", "text": "そうですね。"}, {"type": "subtitle", "time": 3741.19, "timestamp": "01:02:21", "text": "正直に言うと、昨日は"}, {"type": "subtitle", "time": 3746.47, "timestamp": "01:02:26", "text": "新年までのカウントダウンなどのカウントダウンストリームを行う予定でした"}, {"type": "subtitle", "time": 3748.95, "timestamp": "01:02:28", "text": "。 いいえ、私たちは長年そうしてきました"}, {"type": "subtitle", "time": 3752.95, "timestamp": "01:02:32", "text": "。 そして俺は寝てしまったんだ。 たぶん"}, {"type": "subtitle", "time": 3758.39, "timestamp": "01:02:38", "text": "、ぐっすりと眠ったと思います。"}, {"type": "subtitle", "time": 3763.99, "timestamp": "01:02:43", "text": "午後7時か8時から寝ました。"}, {"type": "subtitle", "time": 3766.95, "timestamp": "01:02:46", "text": "午前4時まで、"}, {"type": "subtitle", "time": 3770.95, "timestamp": "01:02:50", "text": "両親は夕食を食べませんでした。 寝て過ごしました"}, {"type": "subtitle", "time": 3774.798, "timestamp": "01:02:54", "text": "。 それでおしまい。 寝坊して"}, {"type": "subtitle", "time": 3777.418, "timestamp": "01:02:57", "text": "遅く起きました（笑）。"}, {"type": "subtitle", "time": 3777.99, "timestamp": "01:02:57", "text": "[息を呑む]"}, {"type": "subtitle", "time": 3779.589, "timestamp": "01:02:59", "text": "すごい。"}]
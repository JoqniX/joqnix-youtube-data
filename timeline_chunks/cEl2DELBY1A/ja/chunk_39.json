[{"type": "subtitle", "time": 2342.71, "timestamp": "00:39:02", "text": "ふふ、彼はインドで一番呪われた男だと思うよ"}, {"type": "subtitle", "time": 2345.27, "timestamp": "00:39:05", "text": "。 みんなが彼をよく罵倒する"}, {"type": "subtitle", "time": 2352.23, "timestamp": "00:39:12", "text": "その人に電話して、いつ"}, {"type": "subtitle", "time": 2354.87, "timestamp": "00:39:14", "text": "電気が戻るか聞くのが好きですか? 彼らは何て"}, {"type": "subtitle", "time": 2357.99, "timestamp": "00:39:17", "text": "言うんですか？ 彼らは電話を受け取らなかったのですか？"}, {"type": "subtitle", "time": 2360.71, "timestamp": "00:39:20", "text": "はい、実際に"}, {"type": "subtitle", "time": 2363.589, "timestamp": "00:39:23", "text": "私にもそれが起こったことがあります。 何が起こったかというと、"}, {"type": "subtitle", "time": 2366.39, "timestamp": "00:39:26", "text": "アプリから2回報告があった後、"}, {"type": "subtitle", "time": 2369.27, "timestamp": "00:39:29", "text": "3回目に電話したのがきっかけで、"}, {"type": "subtitle", "time": 2371.19, "timestamp": "00:39:31", "text": "4回目、"}, {"type": "subtitle", "time": 2373.19, "timestamp": "00:39:33", "text": "5回目以降は彼が"}, {"type": "subtitle", "time": 2376.069, "timestamp": "00:39:36", "text": "電話に出なくなったんです。つまり、私が"}, {"type": "subtitle", "time": 2378.63, "timestamp": "00:39:38", "text": "その時点で思っていたのは、おい、聞いてよ、"}, {"type": "subtitle", "time": 2381.589, "timestamp": "00:39:41", "text": "電気を消してくれ、"}, {"type": "subtitle", "time": 2384.87, "timestamp": "00:39:44", "text": "希望を持たせないで、いいから消してくれ、同じことが起こった、"}, {"type": "subtitle", "time": 2387.27, "timestamp": "00:39:47", "text": "ここでも同じことが起こった、なんてことだ、でも今はもう、でも"}, {"type": "subtitle", "time": 2392.95, "timestamp": "00:39:52", "text": "今はもうダメだ、って感じでした"}, {"type": "subtitle", "time": 2395.27, "timestamp": "00:39:55", "text": "。"}, {"type": "subtitle", "time": 2398.71, "timestamp": "00:39:58", "text": "うん。 そして今はもう冬のようです。"}]
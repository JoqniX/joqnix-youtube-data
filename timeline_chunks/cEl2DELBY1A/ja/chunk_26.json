[{"type": "subtitle", "time": 1562.87, "timestamp": "00:26:02", "text": "[笑い]"}, {"type": "subtitle", "time": 1566.47, "timestamp": "00:26:06", "text": "待ってください、でもそれは PC で支払われるんですよね?"}, {"type": "subtitle", "time": 1568.71, "timestamp": "00:26:08", "text": "遊べない。"}, {"type": "subtitle", "time": 1571.909, "timestamp": "00:26:11", "text": "そうですね、うーん、[音楽]"}, {"type": "subtitle", "time": 1575.269, "timestamp": "00:26:15", "text": "1307 のようなものだと思います。"}, {"type": "subtitle", "time": 1577.35, "timestamp": "00:26:17", "text": "はい、でもブルースタックでプレイできます。"}, {"type": "subtitle", "time": 1579.59, "timestamp": "00:26:19", "text": "ブルースタックではいつでもプレイできます。 彼らは"}, {"type": "subtitle", "time": 1581.029, "timestamp": "00:26:21", "text": "それを許可します。"}, {"type": "subtitle", "time": 1581.669, "timestamp": "00:26:21", "text": "はい、"}, {"type": "subtitle", "time": 1583.99, "timestamp": "00:26:23", "text": "ゲーム開発者自身が、希望する場合は"}, {"type": "subtitle", "time": 1585.99, "timestamp": "00:26:25", "text": "ブルースタックから無料で入手できると言っています"}, {"type": "subtitle", "time": 1588.31, "timestamp": "00:26:28", "text": "。   はい"}, {"type": "subtitle", "time": 1590.789, "timestamp": "00:26:30", "text": "、それでは大丈夫です。   わかった"}, {"type": "subtitle", "time": 1593.59, "timestamp": "00:26:33", "text": "。 そして私は[音楽]大丈夫です。   はい"}, {"type": "subtitle", "time": 1595.35, "timestamp": "00:26:35", "text": "、"}, {"type": "subtitle", "time": 1598.208, "timestamp": "00:26:38", "text": "楽しかったです。 僕たちは"}, {"type": "subtitle", "time": 1600.23, "timestamp": "00:26:40", "text": "[音楽]のいろいろなことを始めることができる。 レポなどをプレイできます"}, {"type": "subtitle", "time": 1602.149, "timestamp": "00:26:42", "text": "。"}, {"type": "subtitle", "time": 1613.43, "timestamp": "00:26:53", "text": "ご存知の方もいるかもしれませんが、ミコは休暇中です。 彼はすぐ戻ってきます。   わかった"}, {"type": "subtitle", "time": 1615.75, "timestamp": "00:26:55", "text": "。"}]
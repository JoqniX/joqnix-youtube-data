[{"type": "subtitle", "time": 2766.309, "timestamp": "00:46:06", "text": "自身のコンテンツに関しては、ここ数"}, {"type": "subtitle", "time": 2769.589, "timestamp": "00:46:09", "text": "年間ずっと、"}, {"type": "subtitle", "time": 2772.15, "timestamp": "00:46:12", "text": "ゲームをしたり、バラエティ番組をやったりしてきましたが、"}, {"type": "subtitle", "time": 2774.79, "timestamp": "00:46:14", "text": "2026年に向けて、"}, {"type": "subtitle", "time": 2779.829, "timestamp": "00:46:19", "text": "コンテンツに重点を置きたいと思っています。何と"}, {"type": "subtitle", "time": 2783.75, "timestamp": "00:46:23", "text": "言ったらいいでしょうか。しかし、"}, {"type": "subtitle", "time": 2785.829, "timestamp": "00:46:25", "text": "分析や"}, {"type": "subtitle", "time": 2789.19, "timestamp": "00:46:29", "text": "トレンドなどを注目するタイプのクリエイターもいます。 いいえ、私は"}, {"type": "subtitle", "time": 2791.19, "timestamp": "00:46:31", "text": "いつも"}, {"type": "chat", "time": 2791.298, "timestamp": "00:46:31", "author": "@HamidSenseii", "avatar": "https://yt4.ggpht.com/ytc/AIdro_moeku1wSJ_5JYElsivgwUBW9jYwk2tsk6dgkop4bCQX9KRj77yp1bZwNyZvBy82WKOMA=s64-c-k-c0x00ffffff-no-rj", "message": "What are you guys talking about is it about future planning"}, {"type": "subtitle", "time": 2794.309, "timestamp": "00:46:34", "text": "数字を気にせずトレンドに注目するタイプでした。"}, {"type": "subtitle", "time": 2796.15, "timestamp": "00:46:36", "text": "やりたいゲームが何であれ、とにかく"}, {"type": "subtitle", "time": 2799.349, "timestamp": "00:46:39", "text": "プレイします。 いいえ。だから今回は一歩"}, {"type": "subtitle", "time": 2808.309, "timestamp": "00:46:48", "text": "前進して、トレンドになっているような"}, {"type": "subtitle", "time": 2810.47, "timestamp": "00:46:50", "text": "コンテンツが作れるかどうか試してみたいと思っています"}, {"type": "subtitle", "time": 2813.109, "timestamp": "00:46:53", "text": "。 うまくいけばそれで"}, {"type": "subtitle", "time": 2815.67, "timestamp": "00:46:55", "text": "いいのですが、私が目指したい主な目標は、自分が"}]
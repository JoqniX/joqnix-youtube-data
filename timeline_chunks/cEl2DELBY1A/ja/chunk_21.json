[{"type": "subtitle", "time": 1260.95, "timestamp": "00:21:00", "text": "。 それから、ある意味では私にはモデルがいて、"}, {"type": "subtitle", "time": 1263.43, "timestamp": "00:21:03", "text": "彼らはそのモデルにお金を払って、"}, {"type": "subtitle", "time": 1266.549, "timestamp": "00:21:06", "text": "コミッションを始めました。 アートは完成していたのですが、"}, {"type": "subtitle", "time": 1269.59, "timestamp": "00:21:09", "text": "その後彼らは「うん、"}, {"type": "subtitle", "time": 1272.31, "timestamp": "00:21:12", "text": "これはできないから、しばらく休止しよう」と言って、"}, {"type": "subtitle", "time": 1278.95, "timestamp": "00:21:18", "text": "親会社と[音楽]のことに集中し始めました。 それから私は"}, {"type": "subtitle", "time": 1282.39, "timestamp": "00:21:22", "text": "6〜8か月間辛抱強く待っていました"}, {"type": "subtitle", "time": 1285.909, "timestamp": "00:21:25", "text": "。 すると、アーティストが"}, {"type": "subtitle", "time": 1289.83, "timestamp": "00:21:29", "text": "すでにモデルを作成したかのような気がしました。 いいえ。そして、もし"}, {"type": "subtitle", "time": 1291.83, "timestamp": "00:21:31", "text": "エージェンシーが継続しない場合、もし"}, {"type": "subtitle", "time": 1293.99, "timestamp": "00:21:33", "text": "音楽が"}, {"type": "subtitle", "time": 1297.11, "timestamp": "00:21:37", "text": "復活するまでに5年か6年かかることになるでしょう。 いいえ。"}, {"type": "subtitle", "time": 1300.31, "timestamp": "00:21:40", "text": "モデルを手に入れて"}, {"type": "subtitle", "time": 1303.27, "timestamp": "00:21:43", "text": "そこから出て、自分で資金を調達する方が良いのではないでしょうか?"}, {"type": "subtitle", "time": 1305.59, "timestamp": "00:21:45", "text": "それについて考えました。 それで、"}, {"type": "subtitle", "time": 1309.35, "timestamp": "00:21:49", "text": "2025年の2月に、よし、やってみようと思いました"}, {"type": "subtitle", "time": 1313.59, "timestamp": "00:21:53", "text": "。 それから、エージェンシーが"}]
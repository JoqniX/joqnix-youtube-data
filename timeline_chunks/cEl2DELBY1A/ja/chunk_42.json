[{"type": "subtitle", "time": 2521.19, "timestamp": "00:42:01", "text": "映画『チェンソーマン』のカバー曲を勉強するように言われました。 いいえ。"}, {"type": "subtitle", "time": 2526.47, "timestamp": "00:42:06", "text": "えーと、ジェーン、ダメ。 ジェーン・ドゥでしたか？ ああ、そうだ、"}, {"type": "subtitle", "time": 2529.19, "timestamp": "00:42:09", "text": "ジェーン・ドゥ。 ええ、"}, {"type": "subtitle", "time": 2532.95, "timestamp": "00:42:12", "text": "ジェーン・ドゥの歌を覚えるように言われました。 デュエット曲です。 いいえ。"}, {"type": "subtitle", "time": 2535.829, "timestamp": "00:42:15", "text": "メインのラインは 8 ラインくらいです"}, {"type": "subtitle", "time": 2538.63, "timestamp": "00:42:18", "text": "。 だから私はそれを学ぼうとしてきました"}, {"type": "subtitle", "time": 2542.39, "timestamp": "00:42:22", "text": "。 ちゃんと"}, {"type": "subtitle", "time": 2545.349, "timestamp": "00:42:25", "text": "歌えないから難しいです。 そうですね、そう思います"}, {"type": "subtitle", "time": 2546.95, "timestamp": "00:42:26", "text": "。"}, {"type": "subtitle", "time": 2549.75, "timestamp": "00:42:29", "text": "独学でも"}, {"type": "subtitle", "time": 2553.27, "timestamp": "00:42:33", "text": "どこかに到達できますが、"}, {"type": "subtitle", "time": 2561.829, "timestamp": "00:42:41", "text": "すべてを実際に行う方法を学ぶには、メンターの指導を受ける必要があります。"}, {"type": "subtitle", "time": 2565.349, "timestamp": "00:42:45", "text": "うん。 でも、ここインドでは、"}, {"type": "subtitle", "time": 2569.51, "timestamp": "00:42:49", "text": "ええ、ええと、私はただ自分のことを終わらせるだけだと言うので、"}, {"type": "subtitle", "time": 2571.829, "timestamp": "00:42:51", "text": "ここインドでは、ええと、"}, {"type": "subtitle", "time": 2577.99, "timestamp": "00:42:57", "text": "今は日本の音楽などに興味のあるトレーナーは見つからないでしょう。 だから、もし"}]
[{"type": "subtitle", "time": 1389.029, "timestamp": "00:23:09", "text": "そうですね、"}, {"type": "subtitle", "time": 1394.789, "timestamp": "00:23:14", "text": "大変な一年だったと思いますが、"}, {"type": "subtitle", "time": 1398.63, "timestamp": "00:23:18", "text": "多くのことを学べたと思います。"}, {"type": "subtitle", "time": 1401.11, "timestamp": "00:23:21", "text": "そうですね、"}, {"type": "subtitle", "time": 1405.27, "timestamp": "00:23:25", "text": "今年はまず"}, {"type": "subtitle", "time": 1411.43, "timestamp": "00:23:31", "text": "政治的なことがたくさんあって、それから"}, {"type": "subtitle", "time": 1415.35, "timestamp": "00:23:35", "text": "地理的なこと、それから戦争のこともあったと思います。"}, {"type": "subtitle", "time": 1420.95, "timestamp": "00:23:40", "text": "そうですね、いつもと違う"}, {"type": "subtitle", "time": 1424.549, "timestamp": "00:23:44", "text": "年でした。そして[音楽]今では、"}, {"type": "subtitle", "time": 1428.31, "timestamp": "00:23:48", "text": "戦争を生き延びたという物語が"}, {"type": "subtitle", "time": 1430.23, "timestamp": "00:23:50", "text": "孫たちに伝えられると思います。"}, {"type": "subtitle", "time": 1431.35, "timestamp": "00:23:51", "text": "うん。"}, {"type": "subtitle", "time": 1434.63, "timestamp": "00:23:54", "text": "そして、V チューブに関しては、ようやく"}, {"type": "subtitle", "time": 1437.51, "timestamp": "00:23:57", "text": "インドに多くの人が来ていると思います"}, {"type": "subtitle", "time": 1439.83, "timestamp": "00:23:59", "text": "。 そうですね、高かったですよ。"}]
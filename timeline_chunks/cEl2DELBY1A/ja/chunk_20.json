[{"type": "subtitle", "time": 1202.31, "timestamp": "00:20:02", "text": "Znex、"}, {"type": "subtitle", "time": 1204.15, "timestamp": "00:20:04", "text": "今年何か起こりましたか?"}, {"type": "subtitle", "time": 1205.11, "timestamp": "00:20:05", "text": "えっと、今年ですか？"}, {"type": "subtitle", "time": 1209.029, "timestamp": "00:20:09", "text": "去年のことでした。"}, {"type": "subtitle", "time": 1210.95, "timestamp": "00:20:10", "text": "去年だったと思います。  [笑い]"}, {"type": "subtitle", "time": 1213.59, "timestamp": "00:20:13", "text": "ああ、そうだね。"}, {"type": "subtitle", "time": 1214.47, "timestamp": "00:20:14", "text": "私は[咳払い]つまり、"}, {"type": "subtitle", "time": 1216.15, "timestamp": "00:20:16", "text": "モデルのことを話しているのなら、"}, {"type": "subtitle", "time": 1218.15, "timestamp": "00:20:18", "text": "そうですか？ うーん、"}, {"type": "subtitle", "time": 1219.029, "timestamp": "00:20:19", "text": "いいえ。"}, {"type": "subtitle", "time": 1221.99, "timestamp": "00:20:21", "text": "ああ。 そうそう。 あれ。 わかった。 えっと、今年は"}, {"type": "subtitle", "time": 1224.23, "timestamp": "00:20:24", "text": "これについての詳しいビデオも作ろうと"}, {"type": "subtitle", "time": 1227.029, "timestamp": "00:20:27", "text": "思います。 でも、基本的に"}, {"type": "subtitle", "time": 1233.51, "timestamp": "00:20:33", "text": "今はライブ出演に多額のお金を払わないといけないんです。 えっと、私にはそれができなかったんです。それは、"}, {"type": "subtitle", "time": 1238.63, "timestamp": "00:20:38", "text": "えっと、私には"}, {"type": "subtitle", "time": 1241.11, "timestamp": "00:20:41", "text": "チャンスが与えられたようなもので、それは"}, {"type": "subtitle", "time": 1243.909, "timestamp": "00:20:43", "text": "代理店のようなもので、"}, {"type": "subtitle", "time": 1247.75, "timestamp": "00:20:47", "text": "スタートアップのようなもので、えっと、彼らは"}, {"type": "subtitle", "time": 1252.71, "timestamp": "00:20:52", "text": "YouTubeがどれほど高価になるかなど、自分たちが何に取り組んでいるのか知らなかったからです。  [音楽]"}, {"type": "subtitle", "time": 1254.95, "timestamp": "00:20:54", "text": "僕は彼らの最初のタレントになるはずだったんだ"}]
[{"type": "subtitle", "time": 1500.23, "timestamp": "00:25:00", "text": "ケイド？ 今年は美しいモデル以外に何か新しいものが見られるのでしょうか"}, {"type": "subtitle", "time": 1506.789, "timestamp": "00:25:06", "text": "？ 何か計画はありますか？"}, {"type": "subtitle", "time": 1510.39, "timestamp": "00:25:10", "text": "待ち遠しいこと、楽しみにしていることはありますか"}, {"type": "subtitle", "time": 1511.75, "timestamp": "00:25:11", "text": "？   まだ"}, {"type": "subtitle", "time": 1514.87, "timestamp": "00:25:14", "text": "何も計画していませんが、うまくいくことを願っています"}, {"type": "subtitle", "time": 1525.19, "timestamp": "00:25:25", "text": "。 はい、うまくいくといいですね"}, {"type": "subtitle", "time": 1528.31, "timestamp": "00:25:28", "text": "。 そして、"}, {"type": "subtitle", "time": 1530.549, "timestamp": "00:25:30", "text": "実は私は人を数えていたんです。 それは"}, {"type": "subtitle", "time": 1533.43, "timestamp": "00:25:33", "text": "良いことではないが、それでも。 そして、『"}, {"type": "subtitle", "time": 1535.669, "timestamp": "00:25:35", "text": "Among Us』とその"}, {"type": "subtitle", "time": 1542.789, "timestamp": "00:25:42", "text": "十分な人数がいると思いますよ。"}, {"type": "subtitle", "time": 1545.99, "timestamp": "00:25:45", "text": "ああ、『Among Us』。 私はその試合を見逃した。"}, {"type": "subtitle", "time": 1547.772, "timestamp": "00:25:47", "text": "まだプレイしてる人いる？  [笑い]"}, {"type": "subtitle", "time": 1548.39, "timestamp": "00:25:48", "text": "[息を呑む]"}, {"type": "subtitle", "time": 1552.47, "timestamp": "00:25:52", "text": "ええ、イギリスやアメリカではまだ、あの"}, {"type": "subtitle", "time": 1556.07, "timestamp": "00:25:56", "text": "ゲームには寛容さが残っています。"}, {"type": "subtitle", "time": 1557.83, "timestamp": "00:25:57", "text": "うん。"}]
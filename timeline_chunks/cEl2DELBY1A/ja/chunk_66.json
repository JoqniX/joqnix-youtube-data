[{"type": "subtitle", "time": 3962.549, "timestamp": "01:06:02", "text": "日本語を英語に翻訳してみるとか"}, {"type": "subtitle", "time": 3964.789, "timestamp": "01:06:04", "text": "。"}, {"type": "subtitle", "time": 3968.39, "timestamp": "01:06:08", "text": "最初は日本語で考えるんですよね？ あなたは、ええと、ええと、ええと、ええと、まず"}, {"type": "subtitle", "time": 3977.99, "timestamp": "01:06:17", "text": "日本語で考えるように自分自身を訓練したと思いますよ"}, {"type": "subtitle", "time": 3980.63, "timestamp": "01:06:20", "text": "ね？ うん。 ゆっくりゆっくり"}, {"type": "subtitle", "time": 3983.99, "timestamp": "01:06:23", "text": "英語の映画をあれこれ観る。 うん。 そして、"}, {"type": "subtitle", "time": 3986.71, "timestamp": "01:06:26", "text": "シャドーイングをしたり、"}, {"type": "subtitle", "time": 3992.95, "timestamp": "01:06:32", "text": "歌を聴いたりしながら歌ってみるのもいいでしょう。 いいえ、それもうまくいくと思います"}, {"type": "subtitle", "time": 3995.349, "timestamp": "01:06:35", "text": "。"}, {"type": "subtitle", "time": 3999.829, "timestamp": "01:06:39", "text": "また、Anki は繰り返しの部分をスペースで区切るんですよね"}, {"type": "subtitle", "time": 4002.47, "timestamp": "01:06:42", "text": "？ それは"}, {"type": "subtitle", "time": 4005.19, "timestamp": "01:06:45", "text": "本当に良いことです。"}, {"type": "subtitle", "time": 4009.51, "timestamp": "01:06:49", "text": "私がお勧めする YouTube チャンネルは、"}, {"type": "chat", "time": 4017.818, "timestamp": "01:06:57", "author": "@HamidFromJapan", "avatar": "https://yt4.ggpht.com/JefRAq_FTuy3FF6yEdN6WftK11jwj0fJkVvjxg043BpGmQ6kmngPlYYyYvAd2bh9ppSGBlbP=s64-c-k-c0x00ffffff-no-rj", "message": "For the Advice ありがとうございます"}, {"type": "subtitle", "time": 4018.95, "timestamp": "01:06:58", "text": "スピーキングや人前で話すことなどに関する多くのアドバイスを提供しているので、"}]
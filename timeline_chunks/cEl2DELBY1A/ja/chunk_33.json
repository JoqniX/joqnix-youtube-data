[{"type": "subtitle", "time": 1981.99, "timestamp": "00:33:01", "text": "私にとって本当に特別な存在でした。 彼女はまるで"}, {"type": "subtitle", "time": 1986.149, "timestamp": "00:33:06", "text": "私のお姉さんのような存在です。"}, {"type": "subtitle", "time": 1988.63, "timestamp": "00:33:08", "text": "ああ、ちなみに、"}, {"type": "subtitle", "time": 1990.549, "timestamp": "00:33:10", "text": "[音楽]は"}, {"type": "subtitle", "time": 1993.177, "timestamp": "00:33:13", "text": "52分からストリーミングしています。"}, {"type": "subtitle", "time": 1993.509, "timestamp": "00:33:13", "text": "[笑い]"}, {"type": "subtitle", "time": 1995.75, "timestamp": "00:33:15", "text": "はい、"}, {"type": "subtitle", "time": 1997.99, "timestamp": "00:33:17", "text": "もうすぐ終わりです。   なんてこった。 そうそう"}, {"type": "subtitle", "time": 2000.71, "timestamp": "00:33:20", "text": "。 そろそろ行かなくちゃいけないよね"}, {"type": "subtitle", "time": 2001.909, "timestamp": "00:33:21", "text": "？   わかった"}, {"type": "subtitle", "time": 2004.23, "timestamp": "00:33:24", "text": "。 私から最後にもう1つ質問させてください。"}, {"type": "subtitle", "time": 2005.83, "timestamp": "00:33:25", "text": "もし皆さんが音楽を続けたいなら、私は"}, {"type": "subtitle", "time": 2009.99, "timestamp": "00:33:29", "text": "去ります。 わかった。"}, {"type": "subtitle", "time": 2012.71, "timestamp": "00:33:32", "text": "では、"}, {"type": "subtitle", "time": 2022.389, "timestamp": "00:33:42", "text": "達成したい目標は何ですか?   見逃してしまいごめんなさい"}, {"type": "subtitle", "time": 2024.87, "timestamp": "00:33:44", "text": "。 もう一度"}, {"type": "subtitle", "time": 2026.23, "timestamp": "00:33:46", "text": "質問を言っていただけますか？"}, {"type": "subtitle", "time": 2029.75, "timestamp": "00:33:49", "text": "えっと、2026年に達成しなければならない目標は何ですか"}, {"type": "subtitle", "time": 2032.389, "timestamp": "00:33:52", "text": "?"}, {"type": "subtitle", "time": 2039.669, "timestamp": "00:33:59", "text": "最初に話すのは私ではありません。"}]
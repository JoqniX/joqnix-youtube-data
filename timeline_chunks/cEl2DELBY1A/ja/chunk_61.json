[{"type": "subtitle", "time": 3660.87, "timestamp": "01:01:00", "text": "最近それを発見したので知りませんでした。"}, {"type": "subtitle", "time": 3663.51, "timestamp": "01:01:03", "text": "動画を視聴せずに要約することができます。"}, {"type": "subtitle", "time": 3666.39, "timestamp": "01:01:06", "text": "全て揃っています。"}, {"type": "subtitle", "time": 3669.109, "timestamp": "01:01:09", "text": "NIでいくら貰ったの？ よくわからない。"}, {"type": "chat", "time": 3673.049, "timestamp": "01:01:13", "author": "@HamidFromJapan", "avatar": "https://yt4.ggpht.com/JefRAq_FTuy3FF6yEdN6WftK11jwj0fJkVvjxg043BpGmQ6kmngPlYYyYvAd2bh9ppSGBlbP=s64-c-k-c0x00ffffff-no-rj", "message": "reflecting on 2025"}, {"type": "subtitle", "time": 3673.51, "timestamp": "01:01:13", "text": "NATE の NAT 試験関係の人達からメールが来ませんでした。"}, {"type": "subtitle", "time": 3675.51, "timestamp": "01:01:15", "text": "受け取るはずだったのですが、受け取らなかったと思います"}, {"type": "subtitle", "time": 3680.63, "timestamp": "01:01:20", "text": "。 うーん、理解できなかったと思います"}, {"type": "subtitle", "time": 3684.23, "timestamp": "01:01:24", "text": "。 うーん、でも合格したよ。 やっと"}, {"type": "subtitle", "time": 3689.27, "timestamp": "01:01:29", "text": "5つ出ました。Q5です。 私は"}, {"type": "subtitle", "time": 3697.349, "timestamp": "01:01:37", "text": "それで、午後"}, {"type": "subtitle", "time": 3701.43, "timestamp": "01:01:41", "text": "4時になります。"}, {"type": "subtitle", "time": 3707.03, "timestamp": "01:01:47", "text": "コラボパートナーが配信を終了したため、今回のコラボ配信を終了します"}, {"type": "subtitle", "time": 3710.39, "timestamp": "01:01:50", "text": "。 ああ、ずっと良くなりました。 今夜"}, {"type": "subtitle", "time": 3713.51, "timestamp": "01:01:53", "text": "遅くに新しいストリームを開始します。"}, {"type": "subtitle", "time": 3716.71, "timestamp": "01:01:56", "text": "今日は、ええ、それは良くなるでしょうから、"}, {"type": "subtitle", "time": 3719.51, "timestamp": "01:01:59", "text": "ただ話をしたり、何かそういうことをしたりできるでしょう"}]
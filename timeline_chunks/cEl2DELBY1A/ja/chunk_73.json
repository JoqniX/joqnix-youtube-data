[{"type": "subtitle", "time": 4381.91, "timestamp": "01:13:01", "text": "4月に起こります、そして、ええええええ、何も"}, {"type": "subtitle", "time": 4391.35, "timestamp": "01:13:11", "text": "起こらなければ、2月までにCOEを受け取ります [ため息と息を呑む]。 えっと、もしすべてがうまくいけば"}, {"type": "subtitle", "time": 4393.83, "timestamp": "01:13:13", "text": "、それは良いことです。"}, {"type": "subtitle", "time": 4395.91, "timestamp": "01:13:15", "text": "1月18日に試験があります。"}, {"type": "subtitle", "time": 4398.229, "timestamp": "01:13:18", "text": "私は日本語の試験のために勉強しなければなりません。"}, {"type": "subtitle", "time": 4401.51, "timestamp": "01:13:21", "text": "チェンナイに行かないといけないので、"}, {"type": "subtitle", "time": 4402.95, "timestamp": "01:13:22", "text": "あー（笑い）"}, {"type": "subtitle", "time": 4407.35, "timestamp": "01:13:27", "text": "またチェンナイを訪れるのはいいですね。   まるで"}, {"type": "subtitle", "time": 4409.5, "timestamp": "01:13:29", "text": "違う文化があるようです。"}, {"type": "subtitle", "time": 4410.149, "timestamp": "01:13:30", "text": "[笑い]"}, {"type": "subtitle", "time": 4414.31, "timestamp": "01:13:34", "text": "すべてがまったく違いますね。 おお。"}, {"type": "subtitle", "time": 4417.43, "timestamp": "01:13:37", "text": "Mの子供がいなくなったら、私は"}, {"type": "subtitle", "time": 4421.83, "timestamp": "01:13:41", "text": "去りたくない。 でも、私も去りたい。"}, {"type": "subtitle", "time": 4424.79, "timestamp": "01:13:44", "text": "そうですね（笑）。"}, {"type": "subtitle", "time": 4433.27, "timestamp": "01:13:53", "text": "とにかく、ここで終わりにします。   午後"}]
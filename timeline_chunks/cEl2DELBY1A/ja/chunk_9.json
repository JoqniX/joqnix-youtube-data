[{"type": "subtitle", "time": 543.59, "timestamp": "00:09:03", "text": "ええと、彼らはみんなと話して私を新年に招待してくれました"}, {"type": "subtitle", "time": 545.99, "timestamp": "00:09:05", "text": "。 時々、"}, {"type": "subtitle", "time": 547.269, "timestamp": "00:09:07", "text": "視聴者がいないと、"}, {"type": "subtitle", "time": 549.75, "timestamp": "00:09:09", "text": "ストリーミングしている人々が"}, {"type": "subtitle", "time": 552.47, "timestamp": "00:09:12", "text": "虚空で話しているのが嫌になります [音楽] 私は"}, {"type": "subtitle", "time": 557.75, "timestamp": "00:09:17", "text": "あなたとチャットしたい、心配しないで、という感じです。   それは"}, {"type": "subtitle", "time": 561.03, "timestamp": "00:09:21", "text": "理解できます。"}, {"type": "subtitle", "time": 564.55, "timestamp": "00:09:24", "text": "そうですね、人がいると本当に助かると思います"}, {"type": "subtitle", "time": 565.269, "timestamp": "00:09:25", "text": "。   さて、"}, {"type": "subtitle", "time": 568.949, "timestamp": "00:09:28", "text": "モデルについて一つ質問があります。"}, {"type": "subtitle", "time": 589.509, "timestamp": "00:09:49", "text": "そうですね、ライブ 2D は本当に美しいです"}, {"type": "subtitle", "time": 591.11, "timestamp": "00:09:51", "text": "。 ライブ 2D でもさまざまなことができます"}, {"type": "subtitle", "time": 595.99, "timestamp": "00:09:55", "text": "が、3D ではさらに"}, {"type": "subtitle", "time": 598.63, "timestamp": "00:09:58", "text": "実用的になります。"}]
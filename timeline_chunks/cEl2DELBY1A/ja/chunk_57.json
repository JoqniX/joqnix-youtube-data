[{"type": "subtitle", "time": 3422.47, "timestamp": "00:57:02", "text": "すぐにスピードランをして、ここの"}, {"type": "subtitle", "time": 3425.75, "timestamp": "00:57:05", "text": "オフィスルームみたいなところまで来て、それをここに置いて、"}, {"type": "subtitle", "time": 3427.75, "timestamp": "00:57:07", "text": "私たちがストリームを開始してゆっくりと"}, {"type": "subtitle", "time": 3430.95, "timestamp": "00:57:10", "text": "食べ始めました。"}, {"type": "subtitle", "time": 3433.109, "timestamp": "00:57:13", "text": "えっと、覚えていますか？ もちろん覚えていますよ"}, {"type": "subtitle", "time": 3435.67, "timestamp": "00:57:15", "text": "。 私が日本語を勉強していたときに来たことを忘れましたか"}, {"type": "subtitle", "time": 3440.309, "timestamp": "00:57:20", "text": "？ えーっと、"}, {"type": "subtitle", "time": 3442.63, "timestamp": "00:57:22", "text": "漢字ストリームをやっていた頃は終わりでした。"}, {"type": "subtitle", "time": 3445.984, "timestamp": "00:57:25", "text": "右。 うん。 当時、私は"}, {"type": "subtitle", "time": 3449.51, "timestamp": "00:57:29", "text": "[鼻で笑う] 漢字のストリームをやっていて、ええ、"}, {"type": "subtitle", "time": 3453.03, "timestamp": "00:57:33", "text": "その頃にはあなたも来ていました。 はい。"}, {"type": "subtitle", "time": 3455.589, "timestamp": "00:57:35", "text": "うん。 ミコ・マネーって誰？ えっと、ミコ・バニーは"}, {"type": "subtitle", "time": 3459.67, "timestamp": "00:57:39", "text": "インドのYouTuberです。"}, {"type": "subtitle", "time": 3462.549, "timestamp": "00:57:42", "text": "このコラボの"}, {"type": "subtitle", "time": 3466.069, "timestamp": "00:57:46", "text": "初期には、Mikos も私たちと一緒にいました。 それで、ミコサは"}, {"type": "subtitle", "time": 3469.03, "timestamp": "00:57:49", "text": "今年の新年、このコラボ [音楽] のホストでした。"}, {"type": "subtitle", "time": 3472.069, "timestamp": "00:57:52", "text": "うーん、それはパーティーのようなもの、"}, {"type": "subtitle", "time": 3474.309, "timestamp": "00:57:54", "text": "または友人とのたまり場、"}, {"type": "subtitle", "time": 3476.47, "timestamp": "00:57:56", "text": "友人とのお祝いのようなもので、そこで私たちは"}]
[{"type": "subtitle", "time": 2705.67, "timestamp": "00:45:05", "text": "試合そのものではなく、キャラクターとしての僕たちだと思います。"}, {"type": "subtitle", "time": 2708.71, "timestamp": "00:45:08", "text": "つまり、ただ"}, {"type": "subtitle", "time": 2712.55, "timestamp": "00:45:12", "text": "一つの方法のニッチにだけ踏み込むことはできないのです。"}, {"type": "subtitle", "time": 2714.341, "timestamp": "00:45:14", "text": "今年、コンテンツのような"}, {"type": "subtitle", "time": 2717.51, "timestamp": "00:45:17", "text": "目標である [音楽] を達成するのに役立つアイデアやアドバイスはありますか"}, {"type": "subtitle", "time": 2720.63, "timestamp": "00:45:20", "text": "?"}, {"type": "subtitle", "time": 2724.55, "timestamp": "00:45:24", "text": "うん。 うん。"}, {"type": "subtitle", "time": 2727.589, "timestamp": "00:45:27", "text": "今年、あなた自身に役立つと思われるアドバイスはありますか"}, {"type": "subtitle", "time": 2730.79, "timestamp": "00:45:30", "text": "？ そうですね、私の場合、"}, {"type": "subtitle", "time": 2741.829, "timestamp": "00:45:41", "text": "品質が低かったりとかで、何かを投稿するのが怖かったのがずっと理由です。"}, {"type": "subtitle", "time": 2747.03, "timestamp": "00:45:47", "text": "カバー用のリソースさえも無いような気がします。"}, {"type": "subtitle", "time": 2749.109, "timestamp": "00:45:49", "text": "ミックスしたり"}, {"type": "subtitle", "time": 2751.67, "timestamp": "00:45:51", "text": "ミュージックビデオを作ったりできる人がいないって思うんです。 いいえ、"}, {"type": "subtitle", "time": 2754.39, "timestamp": "00:45:54", "text": "私たちはいつも、これはうまくいかない、あれはうまくいかない、あれはうまくいかない、などと言い訳をしますが、私"}]
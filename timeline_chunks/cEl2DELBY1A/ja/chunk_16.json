[{"type": "subtitle", "time": 962.47, "timestamp": "00:16:02", "text": "彼を見ていると自信が湧いてきたよ。 それで、[音楽]"}, {"type": "subtitle", "time": 965.43, "timestamp": "00:16:05", "text": "5月に始めたんですが、"}, {"type": "subtitle", "time": 966.71, "timestamp": "00:16:06", "text": "8月にやめました。というのも、"}, {"type": "subtitle", "time": 969.67, "timestamp": "00:16:09", "text": "こんにちは、Rishio 8610さん、ストリームへようこそ、現実世界ではたくさんのことに直面しなければならないし、"}, {"type": "subtitle", "time": 975.43, "timestamp": "00:16:15", "text": "試験や [音楽] 勉強など"}, {"type": "subtitle", "time": 977.67, "timestamp": "00:16:17", "text": "いろいろあったので、やめました。そして"}, {"type": "subtitle", "time": 979.99, "timestamp": "00:16:19", "text": "最近、"}, {"type": "subtitle", "time": 988.069, "timestamp": "00:16:28", "text": "私の3Dモデルに何かが起こったせいで、数週間やめました。私の"}, {"type": "subtitle", "time": 991.189, "timestamp": "00:16:31", "text": "3Dモデルに関して、いろいろなことに直面しなければならなかったんです"}, {"type": "subtitle", "time": 1002.55, "timestamp": "00:16:42", "text": "Pさんはどうですか？"}, {"type": "subtitle", "time": 1005.43, "timestamp": "00:16:45", "text": "あなたのはどうでしたか？ あなたと同じように、あなた"}, {"type": "subtitle", "time": 1008.389, "timestamp": "00:16:48", "text": "も現在、モデルなどに関して問題に直面していると思います"}, {"type": "subtitle", "time": 1016.55, "timestamp": "00:16:56", "text": "うん。 最近みたいに。"}, {"type": "subtitle", "time": 1018.629, "timestamp": "00:16:58", "text": "うん。 それについて話してください。"}]
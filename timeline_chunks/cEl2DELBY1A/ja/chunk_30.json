[{"type": "subtitle", "time": 1804.149, "timestamp": "00:30:04", "text": "ジョクニクス自身でした。"}, {"type": "subtitle", "time": 1806.23, "timestamp": "00:30:06", "text": "このコラボは本当に嬉しいです。"}, {"type": "subtitle", "time": 1817.19, "timestamp": "00:30:17", "text": "今年出会った、少なくとも会って"}, {"type": "subtitle", "time": 1820.47, "timestamp": "00:30:20", "text": "繋がった大好きな人たちが、まるで電話しているかのようにチャットに参加しているので、私も楽しみにしていました。 皆さんが出会ったように。"}, {"type": "subtitle", "time": 1824.149, "timestamp": "00:30:24", "text": "Mo と過ごした時間は本当に楽しかった。えーっと、"}, {"type": "subtitle", "time": 1827.83, "timestamp": "00:30:27", "text": "グループを作ろうとしていた頃のことを思い出します。それから"}, {"type": "subtitle", "time": 1832.549, "timestamp": "00:30:32", "text": "Azu に出会って、"}, {"type": "subtitle", "time": 1835.83, "timestamp": "00:30:35", "text": "今年は恵まれた年だったと言えるでしょう。"}, {"type": "subtitle", "time": 1837.909, "timestamp": "00:30:37", "text": "今年はたくさんの素晴らしい人達に会いました。 いろいろありましたが、"}, {"type": "subtitle", "time": 1843.59, "timestamp": "00:30:43", "text": "私も同じでした。 カイドはどうですか？   私がモに会ったのは、ええと、ただ"}, {"type": "subtitle", "time": 1851.669, "timestamp": "00:30:51", "text": "ジョックのおかげです。"}, {"type": "subtitle", "time": 1852.31, "timestamp": "00:30:52", "text": "うん。"}, {"type": "subtitle", "time": 1857.909, "timestamp": "00:30:57", "text": "待ってください。 本当に？"}]
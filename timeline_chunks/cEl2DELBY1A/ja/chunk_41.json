[{"type": "subtitle", "time": 2466.23, "timestamp": "00:41:06", "text": "。 正直に言うと、これは良い要約です"}, {"type": "subtitle", "time": 2468.069, "timestamp": "00:41:08", "text": "。"}, {"type": "subtitle", "time": 2471.27, "timestamp": "00:41:11", "text": "みんなと一緒に座って"}, {"type": "subtitle", "time": 2474.15, "timestamp": "00:41:14", "text": "穏やかに簡単な会話をします。 それは可能でした。 私は"}, {"type": "subtitle", "time": 2476.573, "timestamp": "00:41:16", "text": "まだ観客のためにオフィスにいます。"}, {"type": "subtitle", "time": 2477.43, "timestamp": "00:41:17", "text": "[笑い]"}, {"type": "subtitle", "time": 2479.51, "timestamp": "00:41:19", "text": "背景に誰かがいたなら、"}, {"type": "subtitle", "time": 2482.95, "timestamp": "00:41:22", "text": "お詫びします。 人々が出入りしており、"}, {"type": "subtitle", "time": 2485.349, "timestamp": "00:41:25", "text": "私は静かにするように彼らと行動しながら話しています"}, {"type": "subtitle", "time": 2486.23, "timestamp": "00:41:26", "text": "。"}, {"type": "subtitle", "time": 2489.91, "timestamp": "00:41:29", "text": "こんにちは、アミド・サンサ。 あけましておめでとう。   あけましておめでとう"}, {"type": "subtitle", "time": 2491.75, "timestamp": "00:41:31", "text": "。"}, {"type": "subtitle", "time": 2493.349, "timestamp": "00:41:33", "text": "どうすれば英語力が上達しますか？ わからない"}, {"type": "subtitle", "time": 2496.309, "timestamp": "00:41:36", "text": "。 ただ映画を観て、"}, {"type": "subtitle", "time": 2498.15, "timestamp": "00:41:38", "text": "シャドーイングとかをやってみてください。 それは役に立つと思います"}, {"type": "subtitle", "time": 2500.87, "timestamp": "00:41:40", "text": "。"}, {"type": "subtitle", "time": 2502.95, "timestamp": "00:41:42", "text": "ところで、次の場所から何か [音楽の]"}, {"type": "subtitle", "time": 2505.75, "timestamp": "00:41:45", "text": "カバーが来る予定ですか?"}, {"type": "subtitle", "time": 2508.55, "timestamp": "00:41:48", "text": "あなたが音楽に興味を持っていることは私も知っています"}, {"type": "subtitle", "time": 2509.51, "timestamp": "00:41:49", "text": "。"}, {"type": "subtitle", "time": 2513.75, "timestamp": "00:41:53", "text": "ああ、わかりました。 正直に言うと、うーん、"}, {"type": "subtitle", "time": 2517.829, "timestamp": "00:41:57", "text": "引きずられちゃったんです。"}]
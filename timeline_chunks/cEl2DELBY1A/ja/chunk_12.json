[{"type": "subtitle", "time": 722.55, "timestamp": "00:12:02", "text": "アドベントの冒険は"}, {"type": "subtitle", "time": 724.15, "timestamp": "00:12:04", "text": "心に良い冒険です。"}, {"type": "subtitle", "time": 726.47, "timestamp": "00:12:06", "text": "ホラーは内容的には良いです。"}, {"type": "subtitle", "time": 728.069, "timestamp": "00:12:08", "text": "シューティングゲーム。"}, {"type": "subtitle", "time": 730.71, "timestamp": "00:12:10", "text": "ああ、それは最高の"}, {"type": "subtitle", "time": 734.71, "timestamp": "00:12:14", "text": "撮影だ。 私はシューティングゲームが好きではありません。"}, {"type": "subtitle", "time": 738.389, "timestamp": "00:12:18", "text": "バトルロワイヤルだったら、"}, {"type": "subtitle", "time": 741.59, "timestamp": "00:12:21", "text": "死ぬかどうかは分かりません。 たくさん死ぬと"}, {"type": "subtitle", "time": 745.75, "timestamp": "00:12:25", "text": "悲しい気持ちになります。 いいえ、しかし薬物"}, {"type": "subtitle", "time": 747.829, "timestamp": "00:12:27", "text": "依存症は存在するでしょう。"}, {"type": "subtitle", "time": 749.829, "timestamp": "00:12:29", "text": "私はバトルロワイヤルが好きではありません。"}, {"type": "subtitle", "time": 751.19, "timestamp": "00:12:31", "text": "[音楽]なぜかは分かりません。"}, {"type": "subtitle", "time": 754.389, "timestamp": "00:12:34", "text": "ああ、私はシューティングゲームが好きじゃないんです。"}, {"type": "subtitle", "time": 757.03, "timestamp": "00:12:37", "text": "いつも負けてしまうから。 そうですね"}, {"type": "subtitle", "time": 764.629, "timestamp": "00:12:44", "text": "最も悲しいことは、"}, {"type": "subtitle", "time": 767.269, "timestamp": "00:12:47", "text": "アドベンチャー ゲームではそれが簡単だということです。"}, {"type": "subtitle", "time": 772.79, "timestamp": "00:12:52", "text": "シューティングゲームのように非常に難しいです。 私の場合は"}, {"type": "subtitle", "time": 776.15, "timestamp": "00:12:56", "text": "気分次第です。"}, {"type": "subtitle", "time": 778.389, "timestamp": "00:12:58", "text": "ああ、わかりました、という意味です"}]
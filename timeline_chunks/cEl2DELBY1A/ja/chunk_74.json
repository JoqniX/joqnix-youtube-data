[{"type": "subtitle", "time": 4444.07, "timestamp": "01:14:04", "text": "正直に言うと、"}, {"type": "subtitle", "time": 4446.55, "timestamp": "01:14:06", "text": "Arc Raiders をストリーミング配信するなら、オンストリーム"}, {"type": "subtitle", "time": 4454.041, "timestamp": "01:14:14", "text": "よりもオフストリームで配信するほうが運がいいので、オフストリームで配信するほうがずっといいです。"}, {"type": "subtitle", "time": 4472.55, "timestamp": "01:14:32", "text": "有名になってますよ。 うん。 こんにちは。   これで終わりにします"}, {"type": "subtitle", "time": 4475.189, "timestamp": "01:14:35", "text": "。 わかった。 こんにちは。"}, {"type": "subtitle", "time": 4478.39, "timestamp": "01:14:38", "text": "午後6時にお会いしましょう。 または今夜のストリーム以降。 わかった。"}, {"type": "subtitle", "time": 4480.55, "timestamp": "01:14:40", "text": "こんにちは。"}, {"type": "subtitle", "time": 4483.27, "timestamp": "01:14:43", "text": "本日"}, {"type": "subtitle", "time": 4486.39, "timestamp": "01:14:46", "text": "このストリームにご来場いただいた皆様、ありがとうございました。  [音楽] そして、"}, {"type": "subtitle", "time": 4493.189, "timestamp": "01:14:53", "text": "Nimikosan"}, {"type": "subtitle", "time": 4497.43, "timestamp": "01:14:57", "text": "、Suryak、Kisanとのこのコラボに招待してくれたMikosaに感謝します。 ありがとう。"}, {"type": "subtitle", "time": 4499.669, "timestamp": "01:14:59", "text": "皆様ありがとうございました。  [音楽]"}]
[{"type": "subtitle", "time": 1320.71, "timestamp": "00:22:00", "text": "モデル代金を払ったので、私がエージェンシーに支払うという合意をしなければなりませんでした。"}, {"type": "subtitle", "time": 1322.23, "timestamp": "00:22:02", "text": "いいえ、芸術です。"}, {"type": "subtitle", "time": 1324.71, "timestamp": "00:22:04", "text": "うん。 ええ、年間サブスクリプションのようなものです"}, {"type": "subtitle", "time": 1326.47, "timestamp": "00:22:06", "text": "。 少し"}, {"type": "subtitle", "time": 1329.35, "timestamp": "00:22:09", "text": "お金を払わなければなりません。 しかし、私は生涯にわたる義務は"}, {"type": "subtitle", "time": 1332.07, "timestamp": "00:22:12", "text": "非常に高価であることに気づきました。"}, {"type": "subtitle", "time": 1335.669, "timestamp": "00:22:15", "text": "うん。 そして生涯の税金は、えーっと、"}, {"type": "subtitle", "time": 1339.27, "timestamp": "00:22:19", "text": "ほぼ 1,000 ドルです。 それは10万ルピーくらいです"}, {"type": "subtitle", "time": 1343.43, "timestamp": "00:22:23", "text": "うん。"}, {"type": "subtitle", "time": 1345.99, "timestamp": "00:22:25", "text": "そして私はこう思いました。「そうだ、"}, {"type": "subtitle", "time": 1347.909, "timestamp": "00:22:27", "text": "このモデルにはもう二度と会うことはないだろう。」 だから私は"}, {"type": "subtitle", "time": 1350.71, "timestamp": "00:22:30", "text": "Joonのことをやったんです。"}, {"type": "subtitle", "time": 1353.99, "timestamp": "00:22:33", "text": "そして、えーっと、今でも私は少ししか、えーっと、少ししか"}, {"type": "subtitle", "time": 1356.95, "timestamp": "00:22:36", "text": "貯金がないので、"}, {"type": "subtitle", "time": 1361.029, "timestamp": "00:22:41", "text": "それは無理です。だから、いつか"}, {"type": "subtitle", "time": 1365.029, "timestamp": "00:22:45", "text": "そのモデルをデビューさせたいです。 うん。"}, {"type": "subtitle", "time": 1367.99, "timestamp": "00:22:47", "text": "しかし、少なくとも"}, {"type": "subtitle", "time": 1371.029, "timestamp": "00:22:51", "text": "今は何かを持っているので嬉しいです。 少なくとも PNG は。"}, {"type": "subtitle", "time": 1373.99, "timestamp": "00:22:53", "text": "ええと、古いモデルは、"}, {"type": "subtitle", "time": 1376.149, "timestamp": "00:22:56", "text": "起こった事柄のせいで使えないんです。  [笑い]"}]
[{"type": "subtitle", "time": 4022.95, "timestamp": "01:07:02", "text": "もし見つけたら教えてください。 ちょっと待ってください"}, {"type": "subtitle", "time": 4026.309, "timestamp": "01:07:06", "text": "。"}, {"type": "subtitle", "time": 4036.309, "timestamp": "01:07:16", "text": "、このチャンネルはそうだ。 聞く。 うん。"}, {"type": "subtitle", "time": 4043.829, "timestamp": "01:07:23", "text": "はい、言わせていただきます。 うん。 このチャンネルは本当に良いです。"}, {"type": "subtitle", "time": 4048.069, "timestamp": "01:07:28", "text": "どのように話すか、どのように"}, {"type": "subtitle", "time": 4051.27, "timestamp": "01:07:31", "text": "人に聞いてもらうかを教えます。 これは良い"}, {"type": "subtitle", "time": 4059.109, "timestamp": "01:07:39", "text": "そうですね。 うん。 上達する唯一の方法は、"}, {"type": "subtitle", "time": 4061.19, "timestamp": "01:07:41", "text": "実際に英語を話すことです。 うん。"}, {"type": "subtitle", "time": 4064.309, "timestamp": "01:07:44", "text": "うん。 うん。 本当だ、本当だ、本当だ。   気をつけて"}, {"type": "subtitle", "time": 4066.87, "timestamp": "01:07:46", "text": "。 アドバイスを受ける。  [笑い声]"}, {"type": "subtitle", "time": 4077.029, "timestamp": "01:07:57", "text": "私も日本の男性をマスターしたいです。"}]
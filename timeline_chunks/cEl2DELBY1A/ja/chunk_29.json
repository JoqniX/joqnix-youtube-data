[{"type": "subtitle", "time": 1749.669, "timestamp": "00:29:09", "text": "好きなのは『ゴッド・オブ・ウォー』または『ラグナロク・オブ・"}, {"type": "subtitle", "time": 1754.389, "timestamp": "00:29:14", "text": "[鼻で笑う]"}, {"type": "subtitle", "time": 1755.83, "timestamp": "00:29:15", "text": "ああ。"}, {"type": "subtitle", "time": 1756.23, "timestamp": "00:29:16", "text": "ああ、"}, {"type": "subtitle", "time": 1757.029, "timestamp": "00:29:17", "text": "いいですね。   わかった"}, {"type": "subtitle", "time": 1758.95, "timestamp": "00:29:18", "text": "。"}, {"type": "subtitle", "time": 1771.75, "timestamp": "00:29:31", "text": "[笑い]"}, {"type": "subtitle", "time": 1773.75, "timestamp": "00:29:33", "text": "わかりました。 画面外で[音楽]を完成させました"}, {"type": "subtitle", "time": 1775.99, "timestamp": "00:29:35", "text": "。   わかった"}, {"type": "subtitle", "time": 1778.149, "timestamp": "00:29:38", "text": "。 起こる。 わかった。"}, {"type": "subtitle", "time": 1785.909, "timestamp": "00:29:45", "text": "それで、えーと、"}, {"type": "subtitle", "time": 1791.43, "timestamp": "00:29:51", "text": "えっと、"}, {"type": "subtitle", "time": 1793.029, "timestamp": "00:29:53", "text": "音楽を教えてください。   私はこれから"}, {"type": "subtitle", "time": 1797.11, "timestamp": "00:29:57", "text": "始めようと思います。"}, {"type": "subtitle", "time": 1797.909, "timestamp": "00:29:57", "text": "うん。"}]
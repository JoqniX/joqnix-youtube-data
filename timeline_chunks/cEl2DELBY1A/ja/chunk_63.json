[{"type": "subtitle", "time": 3783.349, "timestamp": "01:03:03", "text": "こんにちは、若いプロフェッショナルの皆さん。 いらっしゃいませ。 えーっと、"}, {"type": "subtitle", "time": 3784.789, "timestamp": "01:03:04", "text": "ストリーム。 そうですね、"}, {"type": "subtitle", "time": 3786.87, "timestamp": "01:03:06", "text": "今年はできませんでした。 大丈夫。 少なくとも"}, {"type": "subtitle", "time": 3789.91, "timestamp": "01:03:09", "text": "今はビデオを撮りました。 そうですね、"}, {"type": "subtitle", "time": 3793.19, "timestamp": "01:03:13", "text": "ビデオのレンダリングに時間がかかりすぎたため、ストリームをやりたくなかったんです"}, {"type": "chat", "time": 3797.139, "timestamp": "01:03:17", "author": "@HamidFromJapan", "avatar": "https://yt4.ggpht.com/JefRAq_FTuy3FF6yEdN6WftK11jwj0fJkVvjxg043BpGmQ6kmngPlYYyYvAd2bh9ppSGBlbP=s64-c-k-c0x00ffffff-no-rj", "message": "Damn your English is so good 😭"}, {"type": "subtitle", "time": 3797.51, "timestamp": "01:03:17", "text": "。"}, {"type": "subtitle", "time": 3803.27, "timestamp": "01:03:23", "text": "あなたの英語は本当に上手ですね。 私の"}, {"type": "subtitle", "time": 3806.069, "timestamp": "01:03:26", "text": "英語は分かりません。 私が英語が下手だということはご存知でしょう"}, {"type": "subtitle", "time": 3807.589, "timestamp": "01:03:27", "text": "。"}, {"type": "subtitle", "time": 3812.23, "timestamp": "01:03:32", "text": "実は、私が"}, {"type": "subtitle", "time": 3815.829, "timestamp": "01:03:35", "text": "ストリーミングを始めた頃は、"}, {"type": "subtitle", "time": 3818.23, "timestamp": "01:03:38", "text": "英語がとても苦手でした。 誰とも話さなかった。"}, {"type": "chat", "time": 3821.841, "timestamp": "01:03:41", "author": "@HamidFromJapan", "avatar": "https://yt4.ggpht.com/JefRAq_FTuy3FF6yEdN6WftK11jwj0fJkVvjxg043BpGmQ6kmngPlYYyYvAd2bh9ppSGBlbP=s64-c-k-c0x00ffffff-no-rj", "message": "I wanna learn English like you after mastering Japanese"}, {"type": "subtitle", "time": 3822.069, "timestamp": "01:03:42", "text": "いいえ。だから私は、自分が行うすべてのストリームで、"}, {"type": "subtitle", "time": 3825.349, "timestamp": "01:03:45", "text": "この"}, {"type": "subtitle", "time": 3828.63, "timestamp": "01:03:48", "text": "ストリームでは 10 分か"}, {"type": "subtitle", "time": 3832.47, "timestamp": "01:03:52", "text": "5 分間話す、というようなチャレンジをしました。"}, {"type": "subtitle", "time": 3834.87, "timestamp": "01:03:54", "text": "正しい文章で英語を話したり、自分自身に挑戦したりする必要があります。"}, {"type": "subtitle", "time": 3838.15, "timestamp": "01:03:58", "text": "いいえ。だから、毎回の配信で「"}]
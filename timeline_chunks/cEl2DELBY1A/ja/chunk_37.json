[{"type": "subtitle", "time": 2220.63, "timestamp": "00:37:00", "text": "。 君達はまだ先へ進んでる？"}, {"type": "subtitle", "time": 2223.109, "timestamp": "00:37:03", "text": "アメリカ合衆国。"}, {"type": "subtitle", "time": 2227.27, "timestamp": "00:37:07", "text": "かなり"}, {"type": "subtitle", "time": 2231.19, "timestamp": "00:37:11", "text": "緊張しているよ、とだけ言っておきました。 昨年は"}, {"type": "subtitle", "time": 2234.31, "timestamp": "00:37:14", "text": "緊張でいっぱいの一年でした。 今年は何も起こらずに"}, {"type": "subtitle", "time": 2239.67, "timestamp": "00:37:19", "text": "平和な一年になることを心から願っています"}, {"type": "subtitle", "time": 2241.43, "timestamp": "00:37:21", "text": "。 うまくいけば、それだけです"}, {"type": "subtitle", "time": 2242.55, "timestamp": "00:37:22", "text": "。  [音楽]"}, {"type": "subtitle", "time": 2244.63, "timestamp": "00:37:24", "text": "うん。"}, {"type": "subtitle", "time": 2247.51, "timestamp": "00:37:27", "text": "でも、何を言っていたんですか？"}, {"type": "subtitle", "time": 2250.15, "timestamp": "00:37:30", "text": "私は"}, {"type": "subtitle", "time": 2252.79, "timestamp": "00:37:32", "text": "シリアの YouTube ストリームが停止したことに今気づいただけだと言いました。 それで私は"}, {"type": "subtitle", "time": 2254.069, "timestamp": "00:37:34", "text": "「ああ、だめだ」と思いました。"}, {"type": "subtitle", "time": 2257.43, "timestamp": "00:37:37", "text": "うん。 うん。 たくさん死んだよ。 えっと、でもそうですね"}, {"type": "subtitle", "time": 2259.27, "timestamp": "00:37:39", "text": "、"}, {"type": "subtitle", "time": 2262.386, "timestamp": "00:37:42", "text": "ストリームを再開しようとするたびに、私の OBS"}, {"type": "subtitle", "time": 2264.79, "timestamp": "00:37:44", "text": "[音楽] が何らかの理由でシャットダウンしてしまいました。"}, {"type": "subtitle", "time": 2267.27, "timestamp": "00:37:47", "text": "それで、私は、Twitch だけを運営するつもりだ"}, {"type": "subtitle", "time": 2270.55, "timestamp": "00:37:50", "text": "、と思いました。"}, {"type": "subtitle", "time": 2272.87, "timestamp": "00:37:52", "text": "大丈夫。 それは起こります。"}, {"type": "subtitle", "time": 2275.27, "timestamp": "00:37:55", "text": "私はただここにいます。 私の小川はすすり泣いている。   なんてこった。"}, {"type": "subtitle", "time": 2278.39, "timestamp": "00:37:58", "text": "大丈夫。  [笑い]"}]
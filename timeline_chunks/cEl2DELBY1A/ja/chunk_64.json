[{"type": "subtitle", "time": 3843.27, "timestamp": "01:04:03", "text": "10分間話す」「20分間話す」「"}, {"type": "subtitle", "time": 3845.75, "timestamp": "01:04:05", "text": "10分間の"}, {"type": "subtitle", "time": 3849.51, "timestamp": "01:04:09", "text": "目標を達成できたら話す」「苦労せずに間違えずに10分間"}, {"type": "subtitle", "time": 3852.069, "timestamp": "01:04:12", "text": "話すことができたら」という目標を立てて、20分間続けるようにして、何"}, {"type": "subtitle", "time": 3860.15, "timestamp": "01:04:20", "text": "年もかけてゆっくりとゆっくりと英語を上達させることができました。"}, {"type": "subtitle", "time": 3866.549, "timestamp": "01:04:26", "text": "良いアドバイスとしては、"}, {"type": "subtitle", "time": 3870.39, "timestamp": "01:04:30", "text": "英語のクリエイティブを見たり、"}, {"type": "subtitle", "time": 3872.309, "timestamp": "01:04:32", "text": "英語の映画を見たり、"}, {"type": "subtitle", "time": 3875.27, "timestamp": "01:04:35", "text": "メディアに関しては英語のコンテンツを消費したりすることです。   これは、"}, {"type": "subtitle", "time": 3882.309, "timestamp": "01:04:42", "text": "日本語のような言語を学ぶときにも、人々が与えるアドバイスと同じです。"}, {"type": "subtitle", "time": 3885.75, "timestamp": "01:04:45", "text": "メディアを消費するんですよね？ そして、ただ"}, {"type": "subtitle", "time": 3888.63, "timestamp": "01:04:48", "text": "娯楽として消費するのではなく、"}, {"type": "subtitle", "time": 3891.43, "timestamp": "01:04:51", "text": "文章の構成など"}, {"type": "subtitle", "time": 3895.91, "timestamp": "01:04:55", "text": "すべてに注目してください。 うん。 えーっと、どうやって、なぜそのように"}, {"type": "subtitle", "time": 3899.349, "timestamp": "01:04:59", "text": "文が述べられるのでしょうか?"}]
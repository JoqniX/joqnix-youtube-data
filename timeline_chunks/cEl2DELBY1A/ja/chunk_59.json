[{"type": "subtitle", "time": 3542.789, "timestamp": "00:59:02", "text": "日曜日です。  18日は日曜日です。 だから"}, {"type": "subtitle", "time": 3548.23, "timestamp": "00:59:08", "text": "試験を受けるために遠くまで行かなければなりません。 なので16、"}, {"type": "chat", "time": 3550.298, "timestamp": "00:59:10", "author": "@HamidFromJapan", "avatar": "https://yt4.ggpht.com/JefRAq_FTuy3FF6yEdN6WftK11jwj0fJkVvjxg043BpGmQ6kmngPlYYyYvAd2bh9ppSGBlbP=s64-c-k-c0x00ffffff-no-rj", "message": "I love bunnies"}, {"type": "subtitle", "time": 3552.39, "timestamp": "00:59:12", "text": "17、18、19日はストリーミングしません。"}, {"type": "subtitle", "time": 3556.15, "timestamp": "00:59:16", "text": "ええ、でも24時間365日のチャンネルはそこにあります"}, {"type": "chat", "time": 3556.897, "timestamp": "00:59:16", "author": "@HamidFromJapan", "avatar": "https://yt4.ggpht.com/JefRAq_FTuy3FF6yEdN6WftK11jwj0fJkVvjxg043BpGmQ6kmngPlYYyYvAd2bh9ppSGBlbP=s64-c-k-c0x00ffffff-no-rj", "message": "damn what the hell"}, {"type": "subtitle", "time": 3559.43, "timestamp": "00:59:19", "text": "。 えっと、24チャンネルが"}, {"type": "subtitle", "time": 3562.15, "timestamp": "00:59:22", "text": "放送されます。 したがって、"}, {"type": "subtitle", "time": 3564.95, "timestamp": "00:59:24", "text": "毎日のジョックンのジョセを入手したい場合は、24時間年中"}, {"type": "subtitle", "time": 3567.91, "timestamp": "00:59:27", "text": "無休のチャンネルをいつでも視聴できます"}, {"type": "chat", "time": 3569.208, "timestamp": "00:59:29", "author": "@HamidFromJapan", "avatar": "https://yt4.ggpht.com/JefRAq_FTuy3FF6yEdN6WftK11jwj0fJkVvjxg043BpGmQ6kmngPlYYyYvAd2bh9ppSGBlbP=s64-c-k-c0x00ffffff-no-rj", "message": "I think N4 is easy so you gonna pass"}, {"type": "subtitle", "time": 3570.87, "timestamp": "00:59:30", "text": "。 家を離れているときはいつでも PC がオンになります"}, {"type": "subtitle", "time": 3573.75, "timestamp": "00:59:33", "text": "。 私はそれを制御します"}, {"type": "subtitle", "time": 3576.549, "timestamp": "00:59:36", "text": "。 すべてを自動化します。"}, {"type": "subtitle", "time": 3579.43, "timestamp": "00:59:39", "text": "停電が起こっても、[笑い]"}, {"type": "subtitle", "time": 3582.47, "timestamp": "00:59:42", "text": "誰かに電源を入れてもらったり、"}, {"type": "subtitle", "time": 3586.47, "timestamp": "00:59:46", "text": "スマホから遠隔操作で電源を入れてもらったりして、"}, {"type": "subtitle", "time": 3593.349, "timestamp": "00:59:53", "text": "PC を起動するたびに自動的に OBS が起動して"}, {"type": "subtitle", "time": 3596.95, "timestamp": "00:59:56", "text": "配信が始まります。 だから、大丈夫です。"}]
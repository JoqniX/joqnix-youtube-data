[{"type": "subtitle", "time": 25106.39, "timestamp": "06:58:26", "text": "艾米的什麼事嗎？艾米喜歡蜘蛛。冰鑰匙上蠕動著毛茸茸的醜陋蜘蛛。這就是我為什麼不跟她做朋友的原因"}, {"type": "subtitle", "time": 25118.708, "timestamp": "06:58:38", "text": "。"}, {"type": "subtitle", "time": 25130.468, "timestamp": "06:58:50", "text": "米扶我起來，然後帶我去見了護士。這就是我為什麼不跟她做朋友的原因"}]
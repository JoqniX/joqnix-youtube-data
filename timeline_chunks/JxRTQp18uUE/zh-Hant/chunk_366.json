[{"type": "subtitle", "time": 21965.03, "timestamp": "06:06:05", "text": "這個傻瓜。沒人會見面。好了，讓我把這段"}, {"type": "subtitle", "time": 21968.628, "timestamp": "06:06:08", "text": "[音樂]清理一下。"}, {"type": "subtitle", "time": 21971.51, "timestamp": "06:06:11", "text": "我之前用它做佔位符，用來在上傳視頻的時候放鏈接、日期之類的"}, {"type": "subtitle", "time": 21978.07, "timestamp": "06:06:18", "text": "東西。好了。"}, {"type": "subtitle", "time": 22007.07, "timestamp": "06:06:47", "text": "那麼，下午部分，我來告訴你我們要做什麼。"}, {"type": "subtitle", "time": 22013.51, "timestamp": "06:06:53", "text": "嗯，我的"}]
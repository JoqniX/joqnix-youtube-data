[{"type": "subtitle", "time": 26044.628, "timestamp": "07:14:04", "text": "我並沒有。 所以"}, {"type": "subtitle", "time": 26063.15, "timestamp": "07:14:23", "text": "我買了一些東西，呃，該怎麼稱呼它呢，大概是"}, {"type": "subtitle", "time": 26077.15, "timestamp": "07:14:37", "text": "香檳之類的吧"}, {"type": "subtitle", "time": 26082.23, "timestamp": "07:14:42", "text": "。還有"}, {"type": "subtitle", "time": 26087.51, "timestamp": "07:14:47", "text": "什麼呢？"}]
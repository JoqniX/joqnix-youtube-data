[{"type": "subtitle", "time": 25639.67, "timestamp": "07:07:19", "text": "什麼？"}, {"type": "subtitle", "time": 25642.61, "timestamp": "07:07:22", "text": "她怎麼知道的？  什麼？  你好。等等，這是事先寫好的劇本嗎？"}, {"type": "subtitle", "time": 25665.35, "timestamp": "07:07:45", "text": "等等，這是事先寫好的"}, {"type": "subtitle", "time": 25668.548, "timestamp": "07:07:48", "text": "劇本嗎？我很困惑。等等，這太可怕了。這太可怕了。我的天啊。她怎麼知道我忘了"}, {"type": "subtitle", "time": 25670.708, "timestamp": "07:07:50", "text": "？因為"}]
[{"type": "subtitle", "time": 26419.19, "timestamp": "07:20:19", "text": "Sayi，我下一個"}, {"type": "subtitle", "time": 26423.948, "timestamp": "07:20:23", "text": "蘇瑞，等等。尤里突然來了精神。尤里雙手緊緊攥著一張紙，站了起來"}, {"type": "subtitle", "time": 26458.788, "timestamp": "07:20:58", "text": "。  她低著頭，快步走上講台。  這首詩名為《尤里焦急地看著我們每一個人》。"}]
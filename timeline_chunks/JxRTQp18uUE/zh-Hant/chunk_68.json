[{"type": "subtitle", "time": 4086.309, "timestamp": "01:08:06", "text": "可以編輯視頻片段"}, {"type": "subtitle", "time": 4088.549, "timestamp": "01:08:08", "text": "並上傳到手機等短片設備上嗎？ Clip 的網址即可。"}, {"type": "subtitle", "time": 4117.63, "timestamp": "01:08:37", "text": "你可能"}, {"type": "subtitle", "time": 4129.189, "timestamp": "01:08:49", "text": "會看到一個分享按鈕，然後在右側還會有一個名為“混音”的按鈕。點擊混音。然後"}]
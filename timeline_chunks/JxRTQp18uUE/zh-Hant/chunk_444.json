[{"type": "subtitle", "time": 26646.07, "timestamp": "07:24:06", "text": "。  我們一定是忘記了。在我們鼓掌的時候，尤里把詩抱在胸前，衝回了她的懷裡。她：我喜歡這部動畫。她經常在外面"}, {"type": "subtitle", "time": 26648.948, "timestamp": "07:24:08", "text": "吃飯"}, {"type": "subtitle", "time": 26651.75, "timestamp": "07:24:11", "text": "。"}, {"type": "subtitle", "time": 26662.23, "timestamp": "07:24:22", "text": "尤里，你做得真棒。謝謝分享。看來"}, {"type": "subtitle", "time": 26690.708, "timestamp": "07:24:50", "text": "尤里"}]
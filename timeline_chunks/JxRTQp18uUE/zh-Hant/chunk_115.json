[{"type": "subtitle", "time": 6903.83, "timestamp": "01:55:03", "text": "看到"}, {"type": "subtitle", "time": 6907.589, "timestamp": "01:55:07", "text": "有人對口語、語言交流或提高他們的……這方面"}, {"type": "subtitle", "time": 6920.39, "timestamp": "01:55:20", "text": "做的那樣，即使他們不……明白我的意思嗎？"}, {"type": "subtitle", "time": 6934.79, "timestamp": "01:55:34", "text": "只有他們才會聊天，他們只會來串門，把國外殘酷的現實留給主播們。人裡有"}, {"type": "subtitle", "time": 6940.79, "timestamp": "01:55:40", "text": "532人。感覺我"}]
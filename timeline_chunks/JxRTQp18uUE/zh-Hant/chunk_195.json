[{"type": "subtitle", "time": 11704.07, "timestamp": "03:15:04", "text": "我很難"}, {"type": "subtitle", "time": 11706.87, "timestamp": "03:15:06", "text": "接受。"}, {"type": "subtitle", "time": 11737.75, "timestamp": "03:15:37", "text": "因為如果人們覺得我的聲音很奇怪、很不一樣，或者他們不習慣，或者他們胡亂猜測等等，"}, {"type": "subtitle", "time": 11740.87, "timestamp": "03:15:40", "text": "我"}, {"type": "subtitle", "time": 11743.59, "timestamp": "03:15:43", "text": "又能怎麼辦呢？是的，我甚至一度想過用變聲器來阻止這些指責和一切"}, {"type": "subtitle", "time": 11745.11, "timestamp": "03:15:45", "text": "。"}]
[{"type": "subtitle", "time": 24383.43, "timestamp": "06:46:23", "text": "抓住Say的胳膊，扶我們倆在"}, {"type": "subtitle", "time": 24385.91, "timestamp": "06:46:25", "text": "桌子旁坐下"}, {"type": "subtitle", "time": 24396.35, "timestamp": "06:46:36", "text": "。讓我們來讀一下。你在說什麼？ 我喜歡吃辣面。"}, {"type": "subtitle", "time": 24404.628, "timestamp": "06:46:44", "text": "方。"}, {"type": "subtitle", "time": 24408.19, "timestamp": "06:46:48", "text": "美好的想法。發現秘密。他們真的那麼想要我的瓶子嗎？快樂的"}]
[{"type": "subtitle", "time": 22575.47, "timestamp": "06:16:15", "text": "我希望"}, {"type": "subtitle", "time": 22581.47, "timestamp": "06:16:21", "text": "即使我不再是 Vishojo 的 Malakhan，momo 們也能繼續為我加油。是的，她仍然會保持獨立"}, {"type": "subtitle", "time": 22585.03, "timestamp": "06:16:25", "text": "。她將不再"}, {"type": "subtitle", "time": 22589.19, "timestamp": "06:16:29", "text": "與 Vishojo 有任何關聯。就是這樣。節目。是的"}, {"type": "subtitle", "time": 22615.43, "timestamp": "06:16:55", "text": "，這部分讓我很困惑。他們把她解雇了"}]
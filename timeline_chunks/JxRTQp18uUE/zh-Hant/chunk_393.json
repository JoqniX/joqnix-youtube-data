[{"type": "subtitle", "time": 23585.27, "timestamp": "06:33:05", "text": "小鹿浪漫故事。又一天過去了"}, {"type": "subtitle", "time": 23590.39, "timestamp": "06:33:10", "text": "。  好的。今天就是"}, {"type": "subtitle", "time": 23597.468, "timestamp": "06:33:17", "text": "我的死期，因為你該如何吶喊？因為你要如何直播這款遊戲。跟我一樣。我們的朋友們都因為這個遊戲"}, {"type": "subtitle", "time": 23605.51, "timestamp": "06:33:25", "text": "而尖叫"}, {"type": "subtitle", "time": 23616.15, "timestamp": "06:33:36", "text": "。等待"}]
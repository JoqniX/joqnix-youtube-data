[{"type": "subtitle", "time": 16441.51, "timestamp": "04:34:01", "text": "「私のお金はどこ？私の"}, {"type": "subtitle", "time": 16444.31, "timestamp": "04:34:04", "text": "お金？そして父に腹を立てる"}, {"type": "chat", "time": 16445.718, "timestamp": "04:34:05", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "sadge"}, {"type": "subtitle", "time": 16446.551, "timestamp": "04:34:06", "text": "などなど。たとえ私たちが"}, {"type": "chat", "time": 16449.149, "timestamp": "04:34:09", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "ok thats weird"}, {"type": "subtitle", "time": 16449.75, "timestamp": "04:34:09", "text": "当時、経済的に苦しかったその男は"}, {"type": "subtitle", "time": 16462.39, "timestamp": "04:34:22", "text": "うん、言い訳みたいな感じで、"}, {"type": "subtitle", "time": 16464.39, "timestamp": "04:34:24", "text": "「ああ、車のローンを払わなきゃいけないし、"}, {"type": "chat", "time": 16467.387, "timestamp": "04:34:27", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "why would ya be angry towards a kid and his fam for money"}, {"type": "subtitle", "time": 16468.15, "timestamp": "04:34:28", "text": "すべてです。私は、たった2万ドルです、と言いました。"}, {"type": "subtitle", "time": 16470.83, "timestamp": "04:34:30", "text": "夏期は2万"}, {"type": "subtitle", "time": 16478.83, "timestamp": "04:34:38", "text": "[音楽]"}, {"type": "chat", "time": 16482.198, "timestamp": "04:34:42", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "20k's a lot"}, {"type": "subtitle", "time": 16482.429, "timestamp": "04:34:42", "text": "数ヶ月。うん。お金のために。私たちは支払いました"}, {"type": "subtitle", "time": 16485.349, "timestamp": "04:34:45", "text": "半分。残りの分は、"}, {"type": "subtitle", "time": 16487.869, "timestamp": "04:34:47", "text": "お金を持っているか、終わり前に好き"}, {"type": "subtitle", "time": 16490.39, "timestamp": "04:34:50", "text": "月。彼はまるで月の初めのようだった。"}, {"type": "subtitle", "time": 16498.23, "timestamp": "04:34:58", "text": "ええ、たくさんあったし、叱られました。"}]
[{"type": "subtitle", "time": 1620.789, "timestamp": "00:27:00", "text": "1時間または3時間の配信を行う"}, {"type": "subtitle", "time": 1623.51, "timestamp": "00:27:03", "text": "ストリームか何かでクリップを入手"}, {"type": "subtitle", "time": 1626.029, "timestamp": "00:27:06", "text": "そのストリームまたはクリップ"}, {"type": "subtitle", "time": 1628.71, "timestamp": "00:27:08", "text": "ストリーム。しばらくすると、"}, {"type": "subtitle", "time": 1630.87, "timestamp": "00:27:10", "text": "必ず確認しなければならない 必ず確認しなければならない"}, {"type": "subtitle", "time": 1634.23, "timestamp": "00:27:14", "text": "リミックスオプションが有効になっているということですね。"}, {"type": "subtitle", "time": 1638.83, "timestamp": "00:27:18", "text": "それは、"}, {"type": "subtitle", "time": 1642.909, "timestamp": "00:27:22", "text": "設定。いいえ、それはあなたの"}, {"type": "subtitle", "time": 1645.43, "timestamp": "00:27:25", "text": "あなたが作成しなければならない動画に関する動画"}, {"type": "subtitle", "time": 1648.31, "timestamp": "00:27:28", "text": "ショットやリミックスを許可して、それから"}, {"type": "subtitle", "time": 1650.63, "timestamp": "00:27:30", "text": "クリップをあなたの"}, {"type": "subtitle", "time": 1654.149, "timestamp": "00:27:34", "text": "スマホのクリップ機能を使ってリミックスする"}, {"type": "subtitle", "time": 1656.87, "timestamp": "00:27:36", "text": "同じレイアウトを追加して"}, {"type": "subtitle", "time": 1658.909, "timestamp": "00:27:38", "text": "すべては"}, {"type": "subtitle", "time": 1661.909, "timestamp": "00:27:41", "text": "良い。 YouTubeアプリ自体の中で"}, {"type": "subtitle", "time": 1664.71, "timestamp": "00:27:44", "text": "字幕を追加できますか？"}, {"type": "subtitle", "time": 1668.83, "timestamp": "00:27:48", "text": "ナレーションなどなど"}, {"type": "subtitle", "time": 1671.35, "timestamp": "00:27:51", "text": "クール、通常ビデオを撮るときは"}, {"type": "subtitle", "time": 1673.11, "timestamp": "00:27:53", "text": "スクリプトを作成する 効果音を見つける"}, {"type": "subtitle", "time": 1675.549, "timestamp": "00:27:55", "text": "ハイライトのトリミング動画のこと、ああ"}, {"type": "subtitle", "time": 1679.51, "timestamp": "00:27:59", "text": "うわー、どうやってやるの？私にはわからない"}]
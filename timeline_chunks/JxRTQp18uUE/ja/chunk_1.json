[{"type": "subtitle", "time": 80.59, "timestamp": "00:01:20", "text": "言った。ええ、私たちは"}, {"type": "subtitle", "time": 82.78, "timestamp": "00:01:22", "text": "ライブ。ごめんね、みんな。"}, {"type": "subtitle", "time": 84.10900000000001, "timestamp": "00:01:24", "text": "[音楽]"}, {"type": "subtitle", "time": 86.469, "timestamp": "00:01:26", "text": "ええと、技術的な問題がたくさん発生しています"}, {"type": "subtitle", "time": 91.59, "timestamp": "00:01:31", "text": "今日の問題。私のPCは、私が持っていないからです。"}, {"type": "subtitle", "time": 95.71000000000001, "timestamp": "00:01:35", "text": "私のPCをシャットダウンしました"}, {"type": "subtitle", "time": 97.22999999999999, "timestamp": "00:01:37", "text": "少し"}, {"type": "subtitle", "time": 99.95, "timestamp": "00:01:39", "text": "日。それは、それは"}, {"type": "subtitle", "time": 103.149, "timestamp": "00:01:43", "text": "悪い"}, {"type": "subtitle", "time": 106.469, "timestamp": "00:01:46", "text": "良い。状況も悪くなっているのは"}, {"type": "subtitle", "time": 109.50999999999999, "timestamp": "00:01:49", "text": "忙しいので、シャットダウンしていません。"}, {"type": "subtitle", "time": 112.38900000000001, "timestamp": "00:01:52", "text": "数日間。"}, {"type": "subtitle", "time": 116.38900000000001, "timestamp": "00:01:56", "text": "いろいろあるけど、大丈夫。ええと、"}, {"type": "subtitle", "time": 119.27000000000001, "timestamp": "00:01:59", "text": "生きている、そして私たちはここにいる。皆さん、ようこそ"}]
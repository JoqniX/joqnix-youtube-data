[{"type": "subtitle", "time": 9617.79, "timestamp": "02:40:17", "text": "アップロードが終わったら"}, {"type": "subtitle", "time": 9625.23, "timestamp": "02:40:25", "text": "クリップはすべてのクリップを取得します"}, {"type": "subtitle", "time": 9629.99, "timestamp": "02:40:29", "text": "2025年4月現在の最新クリップ右"}, {"type": "subtitle", "time": 9635.15, "timestamp": "02:40:35", "text": "最新版にすべてアップデートしてから"}, {"type": "subtitle", "time": 9637.99, "timestamp": "02:40:37", "text": "えっと、とりあえず一括編集を始めます"}, {"type": "subtitle", "time": 9640.23, "timestamp": "02:40:40", "text": "すべて。英語からすべて編集"}, {"type": "subtitle", "time": 9643.63, "timestamp": "02:40:43", "text": "中国語にすれば"}, {"type": "subtitle", "time": 9646.79, "timestamp": "02:40:46", "text": "発見した。いいえ、それは私が"}, {"type": "subtitle", "time": 9649.23, "timestamp": "02:40:49", "text": "何をしようかと考えている"}, {"type": "subtitle", "time": 9652.469, "timestamp": "02:40:52", "text": "Vチャンネルのビリー。ただ置いておくだけです"}, {"type": "subtitle", "time": 9656.07, "timestamp": "02:40:56", "text": "英語で。私はとても、私はそれを置きました"}]
[{"type": "subtitle", "time": 20700.19, "timestamp": "05:45:00", "text": "セーブファイルを失ってしまいました。 Steam"}, {"type": "subtitle", "time": 20704.07, "timestamp": "05:45:04", "text": "クラウドは私のセーブデータを保存します"}, {"type": "subtitle", "time": 20707.99, "timestamp": "05:45:07", "text": "ゲームのセーブデータなどのバックアップ"}, {"type": "subtitle", "time": 20710.07, "timestamp": "05:45:10", "text": "いろいろあるけど、どうやらそうではないらしい。あなた"}, {"type": "subtitle", "time": 20711.99, "timestamp": "05:45:11", "text": "セーブデータをローカルに保存する必要があります。"}, {"type": "subtitle", "time": 20714.708, "timestamp": "05:45:14", "text": "何か。私は知りませんでした。だから私は"}, {"type": "subtitle", "time": 20718.708, "timestamp": "05:45:18", "text": "最初の頃に築き上げた進歩が失われてしまった"}, {"type": "subtitle", "time": 20721.83, "timestamp": "05:45:21", "text": "2つ目の配信でDDLCの配信が行われています。それで、"}, {"type": "subtitle", "time": 20723.43, "timestamp": "05:45:23", "text": "私はスピードランのように"}, {"type": "subtitle", "time": 20728.15, "timestamp": "05:45:28", "text": "要点を言うと、えーと、要点を言うと"}, {"type": "subtitle", "time": 20732.07, "timestamp": "05:45:32", "text": "えーと、私は最後のえーとを終えました"}, {"type": "subtitle", "time": 20736.788, "timestamp": "05:45:36", "text": "DTLCの配信。そう、ユーリの後は、"}, {"type": "subtitle", "time": 20740.788, "timestamp": "05:45:40", "text": "後で掲示板をチェックします。"}, {"type": "subtitle", "time": 20745.51, "timestamp": "05:45:45", "text": "前回のDTLC配信を見て、私たちがどこで終わったのかを確認してください。"}, {"type": "subtitle", "time": 20750.23, "timestamp": "05:45:50", "text": "そして私は、ほとんどを終えたことを願っています。"}, {"type": "subtitle", "time": 20751.75, "timestamp": "05:45:51", "text": "その物質の。"}, {"type": "subtitle", "time": 20754.15, "timestamp": "05:45:54", "text": "えっと、その後、彼らは"}, {"type": "subtitle", "time": 20758.31, "timestamp": "05:45:58", "text": "日記の次の部分を読んで、その理由"}]
[{"type": "subtitle", "time": 20402.19, "timestamp": "05:40:02", "text": "最後に、旅が始まります。ああ、それはもう少し多いですね。"}, {"type": "subtitle", "time": 20404.03, "timestamp": "05:40:04", "text": "わかった。"}, {"type": "subtitle", "time": 20408.31, "timestamp": "05:40:08", "text": "抱きしめる。誰だか分からないことを願う"}, {"type": "subtitle", "time": 20410.91, "timestamp": "05:40:10", "text": "そこへ行ったが、"}, {"type": "subtitle", "time": 20413.75, "timestamp": "05:40:13", "text": "うん。つまり、それは私たちが考えていた日記ではない"}, {"type": "subtitle", "time": 20415.59, "timestamp": "05:40:15", "text": "実行中。だから、心配しないでください。ええ、私は"}, {"type": "subtitle", "time": 20417.708, "timestamp": "05:40:17", "text": "それを捕まえる"}, {"type": "subtitle", "time": 20421.03, "timestamp": "05:40:21", "text": "上。うん。こんにちは、ハニー。元気かい？"}, {"type": "subtitle", "time": 20423.35, "timestamp": "05:40:23", "text": "何？なぜなのかは、"}, {"type": "subtitle", "time": 20425.47, "timestamp": "05:40:25", "text": "悲しい顔？何"}, {"type": "subtitle", "time": 20429.27, "timestamp": "05:40:29", "text": "何が起こったのか？モー、元気でいるといいな。"}, {"type": "subtitle", "time": 20434.59, "timestamp": "05:40:34", "text": "は、"}, {"type": "subtitle", "time": 20437.59, "timestamp": "05:40:37", "text": "もっと。だから、私は彼ら全員を覚えている"}, {"type": "subtitle", "time": 20440.23, "timestamp": "05:40:40", "text": "クッキーとかカップケーキとか食べてた"}, {"type": "subtitle", "time": 20442.31, "timestamp": "05:40:42", "text": "などなど。"}, {"type": "subtitle", "time": 20444.23, "timestamp": "05:40:44", "text": "それが私が最後に覚えていることです"}, {"type": "subtitle", "time": 20444.74, "timestamp": "05:40:44", "text": "一部"}, {"type": "subtitle", "time": 20455.51, "timestamp": "05:40:55", "text": "二。良い指摘ですね。カップケーキ。はい、彼らは"}, {"type": "subtitle", "time": 20457.59, "timestamp": "05:40:57", "text": "カップケーキの話をしている。はい、私は"}, {"type": "subtitle", "time": 20459.43, "timestamp": "05:40:59", "text": "私は正しい方向に向かっている。よし、行くぞ"}]
[{"type": "subtitle", "time": 1440.43, "timestamp": "00:24:00", "text": "それが私だった"}, {"type": "subtitle", "time": 1442.19, "timestamp": "00:24:02", "text": "言う"}, {"type": "subtitle", "time": 1445.669, "timestamp": "00:24:05", "text": "だって最近のドラマとか色々"}, {"type": "subtitle", "time": 1455.07, "timestamp": "00:24:15", "text": "多く。私は多くのことを学びました。必要ない"}, {"type": "subtitle", "time": 1458.909, "timestamp": "00:24:18", "text": "あなたには必要ない"}, {"type": "subtitle", "time": 1462.07, "timestamp": "00:24:22", "text": "えーと、将来を見据えた対策と"}, {"type": "subtitle", "time": 1464.669, "timestamp": "00:24:24", "text": "もの。"}, {"type": "subtitle", "time": 1469.99, "timestamp": "00:24:29", "text": "時には、時にはただ"}, {"type": "subtitle", "time": 1472.39, "timestamp": "00:24:32", "text": "私はただ編集することを学びます"}, {"type": "subtitle", "time": 1475.029, "timestamp": "00:24:35", "text": "自分自身。その方が良い。うん。そして"}, {"type": "subtitle", "time": 1477.19, "timestamp": "00:24:37", "text": "そうすることで、より効率的に仕事ができる気がする"}, {"type": "subtitle", "time": 1480.39, "timestamp": "00:24:40", "text": "もし私が自分でやれば。ただ、私には必要なんです"}, {"type": "subtitle", "time": 1490.31, "timestamp": "00:24:50", "text": "それ。私はただ、自分が"}, {"type": "subtitle", "time": 1491.909, "timestamp": "00:24:51", "text": "ソフトウェアをあらゆる面で扱う。あなた"}, {"type": "subtitle", "time": 1493.63, "timestamp": "00:24:53", "text": "知っているような"}, {"type": "chat", "time": 1494.902, "timestamp": "00:24:54", "author": "@bakononcopiumm", "avatar": "https://yt4.ggpht.com/hb5sPAHLUD7fBrZZsmfkzISQWwRqI8BY1n8lceyhZz0sNISomD05pCwUe-GL2amD5y-voH_uYw=s64-c-k-c0x00ffffff-no-rj", "message": "yup it takes supa long time"}, {"type": "subtitle", "time": 1497.19, "timestamp": "00:24:57", "text": "どうやって考えることができるか"}, {"type": "subtitle", "time": 1499.669, "timestamp": "00:24:59", "text": "このソフトウェアの使い方について"}]
[{"type": "subtitle", "time": 1022.11, "timestamp": "00:17:02", "text": "ショットの件も"}, {"type": "subtitle", "time": 1025.63, "timestamp": "00:17:05", "text": "そうですね、いろいろと"}, {"type": "subtitle", "time": 1029.669, "timestamp": "00:17:09", "text": "そして、私たちはそうします。その間"}, {"type": "subtitle", "time": 1032.39, "timestamp": "00:17:12", "text": "すべて完了しましたので、再起動します。"}, {"type": "subtitle", "time": 1035.11, "timestamp": "00:17:15", "text": "PCでゲームをしたり、"}, {"type": "subtitle", "time": 1039.39, "timestamp": "00:17:19", "text": "何か。しばらくぶらぶらしよう。"}, {"type": "subtitle", "time": 1054.39, "timestamp": "00:17:34", "text": "携帯電話の電源を入れます。うっかり"}, {"type": "subtitle", "time": 1057.39, "timestamp": "00:17:37", "text": "充電するのを忘れた"}, {"type": "subtitle", "time": 1059.669, "timestamp": "00:17:39", "text": "電話。うっかり充電し忘れてしまった"}, {"type": "subtitle", "time": 1060.72, "timestamp": "00:17:40", "text": "私の携帯電話。"}, {"type": "subtitle", "time": 1062.11, "timestamp": "00:17:42", "text": "[音楽]"}, {"type": "subtitle", "time": 1063.71, "timestamp": "00:17:43", "text": "それで"}, {"type": "subtitle", "time": 1066.909, "timestamp": "00:17:46", "text": "うん。わかった。水が"}]
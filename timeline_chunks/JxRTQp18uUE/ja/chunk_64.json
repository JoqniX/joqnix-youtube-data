[{"type": "subtitle", "time": 3843.829, "timestamp": "01:04:03", "text": "せっかちな彼らは、もし、もし、えーと、何か、えーと"}, {"type": "subtitle", "time": 3848.27, "timestamp": "01:04:08", "text": "せっかちな視聴者は、私には理解できません"}, {"type": "subtitle", "time": 3857.23, "timestamp": "01:04:17", "text": "ジョークは音を出す"}, {"type": "subtitle", "time": 3869.51, "timestamp": "01:04:29", "text": "ダミー。何てことだ。何てことだ。何てことだ。"}, {"type": "subtitle", "time": 3877.87, "timestamp": "01:04:37", "text": "神。私はとても谷底にいた"}, {"type": "subtitle", "time": 3882.47, "timestamp": "01:04:42", "text": "谷育ちの男。これが私の獲物だ。あなた"}, {"type": "subtitle", "time": 3886.109, "timestamp": "01:04:46", "text": "私は怒っていた。私は感じていた"}, {"type": "subtitle", "time": 3890.15, "timestamp": "01:04:50", "text": "もの。私は色々なことを感じていました。おお"}, {"type": "subtitle", "time": 3894.39, "timestamp": "01:04:54", "text": "我が神よ。私は崖っぷちか何かにいた。私"}, {"type": "subtitle", "time": 3895.789, "timestamp": "01:04:55", "text": "しないで"}, {"type": "subtitle", "time": 3897.549, "timestamp": "01:04:57", "text": "知る。"}, {"type": "subtitle", "time": 3899.65, "timestamp": "01:04:59", "text": "ええと、それは"}]
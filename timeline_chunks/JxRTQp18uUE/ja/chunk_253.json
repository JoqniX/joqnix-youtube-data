[{"type": "subtitle", "time": 15181.11, "timestamp": "04:13:01", "text": "裏口から。ベビーカーは"}, {"type": "subtitle", "time": 15182.95, "timestamp": "04:13:02", "text": "あそこへまっすぐ。ああ、だって今は"}, {"type": "subtitle", "time": 15186.149, "timestamp": "04:13:06", "text": "弁護士たちが私の隣の部屋を使っています。"}, {"type": "subtitle", "time": 15189.11, "timestamp": "04:13:09", "text": "内側の部屋。彼らは受け取っていない"}, {"type": "subtitle", "time": 15190.95, "timestamp": "04:13:10", "text": "えーと、前面部分ですね。"}, {"type": "subtitle", "time": 15192.63, "timestamp": "04:13:12", "text": "彼らは後ろの部分を取っています"}, {"type": "subtitle", "time": 15194.229, "timestamp": "04:13:14", "text": "より快適。"}, {"type": "subtitle", "time": 15196.55, "timestamp": "04:13:16", "text": "彼らはエアコンなどを設置した"}, {"type": "subtitle", "time": 15200.63, "timestamp": "04:13:20", "text": "もう全員揃っている。の"}, {"type": "subtitle", "time": 15202.91, "timestamp": "04:13:22", "text": "労働者たちがここにいます。清掃婦は"}, {"type": "subtitle", "time": 15207.189, "timestamp": "04:13:27", "text": "ここ。弁護士が来るだろうが、300年後"}, {"type": "subtitle", "time": 15208.83, "timestamp": "04:13:28", "text": "午後私"}, {"type": "subtitle", "time": 15211.429, "timestamp": "04:13:31", "text": "弁護士の集まりを考えれば、彼らは来るだろう。"}, {"type": "subtitle", "time": 15213.03, "timestamp": "04:13:33", "text": "彼らは完全にシフトし、"}, {"type": "subtitle", "time": 15215.79, "timestamp": "04:13:35", "text": "彼らの事業は5月から"}, {"type": "subtitle", "time": 15223.59, "timestamp": "04:13:43", "text": "うん。たくさんあります。だから人々は"}, {"type": "subtitle", "time": 15226.55, "timestamp": "04:13:46", "text": "時々、うるさくなることがあります。私は気づきました"}, {"type": "subtitle", "time": 15231.51, "timestamp": "04:13:51", "text": "昨日。あなたは自分が飲み過ぎていることを知っている。"}, {"type": "subtitle", "time": 15234.75, "timestamp": "04:13:54", "text": "タンクレスは"}, {"type": "subtitle", "time": 15238.149, "timestamp": "04:13:58", "text": "時間。私は飲むのをいつも忘れてしまうんです"}]
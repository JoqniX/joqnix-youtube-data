[{"type": "subtitle", "time": 2533.67, "timestamp": "00:42:13", "text": "最悪だ。 47日目は4月27日ですよね？"}, {"type": "subtitle", "time": 2544.069, "timestamp": "00:42:24", "text": "[音楽]"}, {"type": "subtitle", "time": 2546.23, "timestamp": "00:42:26", "text": "YouTubeはもっと頑張る必要がある"}, {"type": "subtitle", "time": 2548.03, "timestamp": "00:42:28", "text": "[音楽]"}, {"type": "subtitle", "time": 2550.75, "timestamp": "00:42:30", "text": "けれど。たくさん"}, {"type": "subtitle", "time": 2554.23, "timestamp": "00:42:34", "text": "彼らがやらなければならないこと。 Twitchを見てください。"}, {"type": "subtitle", "time": 2556.75, "timestamp": "00:42:36", "text": "彼らは積極的に新しい技術を開発している"}, {"type": "subtitle", "time": 2559.03, "timestamp": "00:42:39", "text": "もの。 YouTube、いつになったら"}, {"type": "subtitle", "time": 2560.349, "timestamp": "00:42:40", "text": "する"}, {"type": "subtitle", "time": 2563.19, "timestamp": "00:42:43", "text": "それ？しかし彼らは持ち込んでいる"}, {"type": "subtitle", "time": 2565.67, "timestamp": "00:42:45", "text": "ポッドキャスターやライブストリーマー、"}, {"type": "subtitle", "time": 2568.15, "timestamp": "00:42:48", "text": "コンテンツクリエイターをフィードバックチャネルへ"}, {"type": "subtitle", "time": 2569.23, "timestamp": "00:42:49", "text": "あるいは何か"}, {"type": "subtitle", "time": 2571.99, "timestamp": "00:42:51", "text": "最近。だから、私はそれに興味があります。"}, {"type": "subtitle", "time": 2575.75, "timestamp": "00:42:55", "text": "より多くの人が声を上げることができる"}, {"type": "subtitle", "time": 2578.47, "timestamp": "00:42:58", "text": "彼らはあらゆるものを手に入れたいと願っている。それは"}]
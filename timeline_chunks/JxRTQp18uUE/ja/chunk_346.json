[{"type": "subtitle", "time": 20761.31, "timestamp": "05:46:01", "text": "私はすでに"}, {"type": "subtitle", "time": 20765.75, "timestamp": "05:46:05", "text": "えっと、訪問しました、"}, {"type": "subtitle", "time": 20766.43, "timestamp": "05:46:06", "text": "えーと"}, {"type": "subtitle", "time": 20769.47, "timestamp": "05:46:09", "text": "誰かの家を訪れた"}, {"type": "subtitle", "time": 20772.59, "timestamp": "05:46:12", "text": "家の中で、男の歩き方を見たことがないから"}, {"type": "subtitle", "time": 20776.03, "timestamp": "05:46:16", "text": "家と"}, {"type": "subtitle", "time": 20778.868, "timestamp": "05:46:18", "text": "これは時々とても奇妙です。なぜならあなたは決して"}, {"type": "subtitle", "time": 20786.27, "timestamp": "05:46:26", "text": "けれど。"}, {"type": "subtitle", "time": 20790.51, "timestamp": "05:46:30", "text": "ああ、私はちょっとスポーツ好きです"}, {"type": "subtitle", "time": 20793.39, "timestamp": "05:46:33", "text": "いろいろあるけど"}, {"type": "subtitle", "time": 20795.788, "timestamp": "05:46:35", "text": "痛み。それは確かに"}, {"type": "subtitle", "time": 20799.51, "timestamp": "05:46:39", "text": "痛み。じゃあ、配信に戻りますね"}, {"type": "subtitle", "time": 20801.11, "timestamp": "05:46:41", "text": "そして"}, {"type": "subtitle", "time": 20808.788, "timestamp": "05:46:48", "text": "DLC。それではパート2です。それで、このストリームがありました"}, {"type": "subtitle", "time": 20813.07, "timestamp": "05:46:53", "text": "ムハンマド・ハ様とご一緒です。それで"}, {"type": "subtitle", "time": 20817.35, "timestamp": "05:46:57", "text": "ああ、チャットのAkyとHanaから"}]
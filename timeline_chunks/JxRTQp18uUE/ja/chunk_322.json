[{"type": "subtitle", "time": 19320.07, "timestamp": "05:22:00", "text": "起こる。だから私は集中しようと思った"}, {"type": "subtitle", "time": 19322.83, "timestamp": "05:22:02", "text": "日本語で始め、"}, {"type": "subtitle", "time": 19325.35, "timestamp": "05:22:05", "text": "証明書とその他すべて"}, {"type": "subtitle", "time": 19328.11, "timestamp": "05:22:08", "text": "2年以内に"}, {"type": "chat", "time": 19330.293, "timestamp": "05:22:10", "author": "@MovieJunction909", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mNkj4pW6jUvChG4gBzsrYlBtzdpsU-SuNMu6MPKVmDoCxY2_D05vAOfPJE2IATJUm0Sw=s64-c-k-c0x00ffffff-no-rj", "message": "they speak cantonese/mandarin there, no japanese"}, {"type": "subtitle", "time": 19336.788, "timestamp": "05:22:16", "text": "きちんと。試験を受けて、その他すべて"}, {"type": "subtitle", "time": 19339.75, "timestamp": "05:22:19", "text": "私が日本語でやっているように"}, {"type": "subtitle", "time": 19342.39, "timestamp": "05:22:22", "text": "私は日本に行くのは日本のためですよね？"}, {"type": "subtitle", "time": 19344.59, "timestamp": "05:22:24", "text": "私はそこに滞在します"}, {"type": "subtitle", "time": 19347.35, "timestamp": "05:22:27", "text": "永遠に。永遠にではなく、しばらくの間、"}, {"type": "subtitle", "time": 19349.51, "timestamp": "05:22:29", "text": "長い間。私はそこに滞在したい"}, {"type": "chat", "time": 19351.875, "timestamp": "05:22:31", "author": "@MovieJunction909", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mNkj4pW6jUvChG4gBzsrYlBtzdpsU-SuNMu6MPKVmDoCxY2_D05vAOfPJE2IATJUm0Sw=s64-c-k-c0x00ffffff-no-rj", "message": "forever? wow"}, {"type": "subtitle", "time": 19353.15, "timestamp": "05:22:33", "text": "長い間。私は戻りたくない"}, {"type": "subtitle", "time": 19355.67, "timestamp": "05:22:35", "text": "インド。また戻ってこなければならないかもしれない。私"}, {"type": "subtitle", "time": 19359.31, "timestamp": "05:22:39", "text": "まだそこに行かなければならない。私の未来は"}, {"type": "chat", "time": 19361.642, "timestamp": "05:22:41", "author": "@MovieJunction909", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mNkj4pW6jUvChG4gBzsrYlBtzdpsU-SuNMu6MPKVmDoCxY2_D05vAOfPJE2IATJUm0Sw=s64-c-k-c0x00ffffff-no-rj", "message": "oh u not wanna come back to india?"}, {"type": "subtitle", "time": 19362.23, "timestamp": "05:22:42", "text": "日本。私は全てを注ぎ込んでいます。ない"}, {"type": "subtitle", "time": 19364.628, "timestamp": "05:22:44", "text": "永遠に。"}, {"type": "subtitle", "time": 19366.19, "timestamp": "05:22:46", "text": "永遠にではない"}, {"type": "subtitle", "time": 19368.43, "timestamp": "05:22:48", "text": "けれど。つまり"}, {"type": "subtitle", "time": 19375.67, "timestamp": "05:22:55", "text": "そこには。あるいは、あなたがそうしたいのかどうかは分かりません。私"}, {"type": "subtitle", "time": 19377.83, "timestamp": "05:22:57", "text": "つまり、よく考えてみて。あなたは支払っているので"}, {"type": "subtitle", "time": 19379.83, "timestamp": "05:22:59", "text": "まだまだ先は長い。航空券、"}]
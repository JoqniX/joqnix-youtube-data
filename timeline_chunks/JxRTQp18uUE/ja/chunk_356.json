[{"type": "subtitle", "time": 21362.07, "timestamp": "05:56:02", "text": "配信を開始します。わかった。"}, {"type": "subtitle", "time": 21364.39, "timestamp": "05:56:04", "text": "44分くらいかかるけど、"}, {"type": "subtitle", "time": 21367.43, "timestamp": "05:56:07", "text": "配信開始から45分くらい経ちました。"}, {"type": "subtitle", "time": 21369.548, "timestamp": "05:56:09", "text": "私はとても"}, {"type": "subtitle", "time": 21372.628, "timestamp": "05:56:12", "text": "ごめん。でも、もっと多くの人を見てきました"}, {"type": "subtitle", "time": 21373.99, "timestamp": "05:56:13", "text": "このゲームをプレイしてください。ネタバレ注意。それは"}, {"type": "subtitle", "time": 21376.23, "timestamp": "05:56:16", "text": "完全に良いゲームで、悪いところは何もありません"}, {"type": "subtitle", "time": 21379.99, "timestamp": "05:56:19", "text": "その中で何が起こるか。こんにちは、確認しておきます。えっと"}, {"type": "subtitle", "time": 21382.868, "timestamp": "05:56:22", "text": "ありがとう。私のせいで何かが破裂した"}, {"type": "subtitle", "time": 21386.27, "timestamp": "05:56:26", "text": "私の配信で。こんにちは"}, {"type": "subtitle", "time": 21391.35, "timestamp": "05:56:31", "text": "オカ。ああ、お母さんは寝てないよ、それは"}, {"type": "subtitle", "time": 21393.47, "timestamp": "05:56:33", "text": "世界が終わる"}, {"type": "subtitle", "time": 21398.51, "timestamp": "05:56:38", "text": "こんにちは、私たちはそれを理解しています"}, {"type": "subtitle", "time": 21402.39, "timestamp": "05:56:42", "text": "うわぁ、でも、たくさん手に入れてくださいね。"}, {"type": "subtitle", "time": 21405.27, "timestamp": "05:56:45", "text": "寝る、もしくは一日寝る、さもないと"}, {"type": "subtitle", "time": 21408.31, "timestamp": "05:56:48", "text": "わかってるよ、君はそうしたくないんだ、いやいや、そうじゃない"}, {"type": "subtitle", "time": 21411.51, "timestamp": "05:56:51", "text": "睡眠、パワーナップ、効果あり"}, {"type": "subtitle", "time": 21413.99, "timestamp": "05:56:53", "text": "あくびをしたくないから"}, {"type": "subtitle", "time": 21417.03, "timestamp": "05:56:57", "text": "今の私のように"}, {"type": "subtitle", "time": 21419.51, "timestamp": "05:56:59", "text": "あくびが止まらない。一体どういうことだ？"}]
[{"type": "subtitle", "time": 18900.47, "timestamp": "05:15:00", "text": "あれは本当に素晴らしい崖だね。"}, {"type": "subtitle", "time": 18902.07, "timestamp": "05:15:02", "text": "個人的には、"}, {"type": "subtitle", "time": 18904.39, "timestamp": "05:15:04", "text": "褒美？報酬について教えてください。あなたが知っている"}, {"type": "subtitle", "time": 18905.91, "timestamp": "05:15:05", "text": "何？ラグノザーを殺せば、"}, {"type": "subtitle", "time": 18908.75, "timestamp": "05:15:08", "text": "この胸当てと胸当て"}, {"type": "subtitle", "time": 18911.99, "timestamp": "05:15:11", "text": "皿。ダイヤモンドの胸当てで"}, {"type": "subtitle", "time": 18922.47, "timestamp": "05:15:22", "text": "はい、設定しました。"}, {"type": "subtitle", "time": 18924.19, "timestamp": "05:15:24", "text": "[音楽]"}, {"type": "subtitle", "time": 18927.99, "timestamp": "05:15:27", "text": "スケジュール。そのネザライトのブーツはあなたのものでしたか？"}, {"type": "subtitle", "time": 18931.51, "timestamp": "05:15:31", "text": "ええ、すべて私のものだったんです。いいですか、聞いてください。"}, {"type": "subtitle", "time": 18933.43, "timestamp": "05:15:33", "text": "彼はほとんど"}, {"type": "subtitle", "time": 18936.55, "timestamp": "05:15:36", "text": "あの映像の中で、私は泣いていた。聞かないで"}, {"type": "subtitle", "time": 18939.19, "timestamp": "05:15:39", "text": "彼。彼はずる賢い。でも私は"}, {"type": "subtitle", "time": 18943.35, "timestamp": "05:15:43", "text": "世界の守護者。"}, {"type": "subtitle", "time": 18945.83, "timestamp": "05:15:45", "text": "あなたではない。"}, {"type": "subtitle", "time": 18954.55, "timestamp": "05:15:54", "text": "うん。うん。それ、すごく好き。殺すことができるなら"}, {"type": "subtitle", "time": 18957.67, "timestamp": "05:15:57", "text": "ラグノスですよね？"}]
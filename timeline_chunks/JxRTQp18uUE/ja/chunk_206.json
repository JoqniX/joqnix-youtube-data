[{"type": "subtitle", "time": 12362.63, "timestamp": "03:26:02", "text": "今はとても気分がいい。だからテイラーは"}, {"type": "subtitle", "time": 12364.51, "timestamp": "03:26:04", "text": "本物"}, {"type": "subtitle", "time": 12368.469, "timestamp": "03:26:08", "text": "テイラーと私は彼を愛しています。私はテイラーが大好きです。"}, {"type": "subtitle", "time": 12369.79, "timestamp": "03:26:09", "text": "それはとても"}, {"type": "subtitle", "time": 12372.91, "timestamp": "03:26:12", "text": "いいね。彼らはとても"}, {"type": "subtitle", "time": 12382.07, "timestamp": "03:26:22", "text": "言う。しかし、私はそうは思わない。"}, {"type": "subtitle", "time": 12383.87, "timestamp": "03:26:23", "text": "重要な声。それは"}, {"type": "subtitle", "time": 12386.87, "timestamp": "03:26:26", "text": "大切なのは、その人柄だ。いいえ。ええ。"}, {"type": "subtitle", "time": 12388.79, "timestamp": "03:26:28", "text": "声とかそういうのはおまけみたいなものだ。もしあなたが"}, {"type": "subtitle", "time": 12390.55, "timestamp": "03:26:30", "text": "良い声、歌声をお持ちなら"}, {"type": "subtitle", "time": 12393.99, "timestamp": "03:26:33", "text": "そして全てがうまくいけば、良いのです。もしあなたが"}, {"type": "subtitle", "time": 12395.83, "timestamp": "03:26:35", "text": "良い一日を。歌声のことですね。"}, {"type": "chat", "time": 12396.48, "timestamp": "03:26:36", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "hnm"}, {"type": "subtitle", "time": 12398.95, "timestamp": "03:26:38", "text": "かわいいモデルがいれば、"}, {"type": "subtitle", "time": 12401.99, "timestamp": "03:26:41", "text": "コンテンツを適切に作成できないのでは？"}, {"type": "subtitle", "time": 12404.469, "timestamp": "03:26:44", "text": "創造、またはあなたが下手ならいいね、あなたが"}, {"type": "subtitle", "time": 12407.67, "timestamp": "03:26:47", "text": "吸うように吸う、たとえあなたが"}, {"type": "subtitle", "time": 12410.07, "timestamp": "03:26:50", "text": "良いモデルなら、人々はまだ見てくれるだろう"}, {"type": "subtitle", "time": 12413.67, "timestamp": "03:26:53", "text": "あなた。 Vumingは今、このように進化している。"}, {"type": "subtitle", "time": 12418.11, "timestamp": "03:26:58", "text": "時代と時代。でも、そう、それが"}]
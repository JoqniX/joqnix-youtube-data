[{"type": "subtitle", "time": 302.15, "timestamp": "00:05:02", "text": "私たちはホヤ・ウォーズをプレイします"}, {"type": "subtitle", "time": 303.79, "timestamp": "00:05:03", "text": "ゲーム。つまり、枯れていく"}, {"type": "subtitle", "time": 307.23, "timestamp": "00:05:07", "text": "すぐに手を振ってデルタをインストールします"}, {"type": "subtitle", "time": 310.909, "timestamp": "00:05:10", "text": "力。ええ、聞こえましたよね"}, {"type": "subtitle", "time": 314.909, "timestamp": "00:05:14", "text": "右。私がすぐ後に"}, {"type": "subtitle", "time": 324.71, "timestamp": "00:05:24", "text": "うん、もう一方のバージョンも楽しかったよ。正直に、"}, {"type": "subtitle", "time": 328.909, "timestamp": "00:05:28", "text": "楽しかったけど、"}, {"type": "subtitle", "time": 332.189, "timestamp": "00:05:32", "text": "うん、そうなったんだ"}, {"type": "subtitle", "time": 340.029, "timestamp": "00:05:40", "text": "方法。させて"}, {"type": "subtitle", "time": 346.35, "timestamp": "00:05:46", "text": "私にさせて"}, {"type": "subtitle", "time": 347.79, "timestamp": "00:05:47", "text": "[音楽]"}, {"type": "subtitle", "time": 351.23, "timestamp": "00:05:51", "text": "アップロード。カット"}, {"type": "subtitle", "time": 354.55, "timestamp": "00:05:54", "text": "ああ、ストリームはまるで私がカットしたかのようだ"}, {"type": "subtitle", "time": 356.87, "timestamp": "00:05:56", "text": "戦争が今、ストリームは3のように見えます"}]
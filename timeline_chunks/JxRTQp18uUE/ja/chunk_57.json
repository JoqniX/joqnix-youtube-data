[{"type": "subtitle", "time": 3437.67, "timestamp": "00:57:17", "text": "成長する方法を考える"}, {"type": "subtitle", "time": 3440.63, "timestamp": "00:57:20", "text": "信じられないことに、もし"}, {"type": "subtitle", "time": 3444.309, "timestamp": "00:57:24", "text": "彼らは英語でしゃべっているストリーマーを見かける"}, {"type": "subtitle", "time": 3447.349, "timestamp": "00:57:27", "text": "彼らは参加しない、怖がるし、"}, {"type": "subtitle", "time": 3451.109, "timestamp": "00:57:31", "text": "誰かが参加したら、彼らは参加しないだろう"}, {"type": "subtitle", "time": 3453.91, "timestamp": "00:57:33", "text": "話すことや言語に興味がある人"}, {"type": "subtitle", "time": 3458.03, "timestamp": "00:57:38", "text": "交換または改善"}, {"type": "subtitle", "time": 3460.87, "timestamp": "00:57:40", "text": "物事や私がしていることが好きでも"}, {"type": "subtitle", "time": 3463.349, "timestamp": "00:57:43", "text": "彼らは私が言っていることを理解していない。"}, {"type": "subtitle", "time": 3465.71, "timestamp": "00:57:45", "text": "彼らは"}, {"type": "subtitle", "time": 3474.51, "timestamp": "00:57:54", "text": "外国の厳しい現実をそこに置いて"}, {"type": "subtitle", "time": 3477.15, "timestamp": "00:57:57", "text": "ストリーマー。"}]
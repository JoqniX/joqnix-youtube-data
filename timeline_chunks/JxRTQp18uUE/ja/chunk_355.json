[{"type": "subtitle", "time": 21321.99, "timestamp": "05:55:21", "text": "これ。だから、今がその時だと思う"}, {"type": "subtitle", "time": 21334.868, "timestamp": "05:55:34", "text": "額。そう、それがポイントなんだ。わかった。"}, {"type": "subtitle", "time": 21337.708, "timestamp": "05:55:37", "text": "わかった。わかった。わかった。だから手伝った後"}, {"type": "subtitle", "time": 21341.19, "timestamp": "05:55:41", "text": "彼女を助けた後、彼らは、えーと、私は、えーと"}, {"type": "subtitle", "time": 21343.43, "timestamp": "05:55:43", "text": "最後の部分では、"}, {"type": "subtitle", "time": 21346.23, "timestamp": "05:55:46", "text": "日記に。そこが私たちが立ち止まった場所です"}, {"type": "subtitle", "time": 21349.35, "timestamp": "05:55:49", "text": "DTLC配信のパート2です。その後、"}, {"type": "subtitle", "time": 21354.47, "timestamp": "05:55:54", "text": "声に出して、声に出して、全部読み上げます"}, {"type": "subtitle", "time": 21359.43, "timestamp": "05:55:59", "text": "ええと、すべての線、そして私たちは"}]
[{"type": "subtitle", "time": 12060.59, "timestamp": "03:21:00", "text": "毎日ここでストリーミング配信"}, {"type": "subtitle", "time": 12063.07, "timestamp": "03:21:03", "text": "今。私はもっ​​と 私はもっと"}, {"type": "subtitle", "time": 12065.83, "timestamp": "03:21:05", "text": "あらゆる場所で活動している。それで彼らは私に"}, {"type": "subtitle", "time": 12071.429, "timestamp": "03:21:11", "text": "ベータ。ここでビームから得られるのはボットばかりだ"}, {"type": "subtitle", "time": 12073.349, "timestamp": "03:21:13", "text": "などなど。実際に人が必要です"}, {"type": "subtitle", "time": 12075.99, "timestamp": "03:21:15", "text": "ビームもね、実際誰が"}, {"type": "subtitle", "time": 12078.59, "timestamp": "03:21:18", "text": "私と話しましょう。ビームと"}, {"type": "subtitle", "time": 12081.67, "timestamp": "03:21:21", "text": "キック。今のところ、実際に話をしたのは2人だけです。"}, {"type": "subtitle", "time": 12086.269, "timestamp": "03:21:26", "text": "私にとって、普通の視聴者として話しました"}, {"type": "subtitle", "time": 12089.389, "timestamp": "03:21:29", "text": "キック。うん、難しいね。"}, {"type": "subtitle", "time": 12094.48, "timestamp": "03:21:34", "text": "難しい。"}, {"type": "subtitle", "time": 12106.469, "timestamp": "03:21:46", "text": "ああ、確かに話が脱線しちゃったよね？私たちは"}, {"type": "subtitle", "time": 12108.55, "timestamp": "03:21:48", "text": "私たちは別のことを話していて、"}, {"type": "chat", "time": 12119.168, "timestamp": "03:21:59", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "had lunch?"}]
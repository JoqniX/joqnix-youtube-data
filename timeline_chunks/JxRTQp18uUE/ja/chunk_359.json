[{"type": "subtitle", "time": 21543.868, "timestamp": "05:59:03", "text": "何？所有"}, {"type": "subtitle", "time": 21546.02, "timestamp": "05:59:06", "text": "上。待って"}, {"type": "subtitle", "time": 21547.708, "timestamp": "05:59:07", "text": "[音楽]"}, {"type": "subtitle", "time": 21555.23, "timestamp": "05:59:15", "text": "420？サス。それでは、"}, {"type": "subtitle", "time": 21558.43, "timestamp": "05:59:18", "text": "これ。いいえ、まだ寝ていません。"}, {"type": "subtitle", "time": 21562.948, "timestamp": "05:59:22", "text": "何？ああ、エドワード。寝なさい。なぜ"}, {"type": "subtitle", "time": 21565.15, "timestamp": "05:59:25", "text": "あなた なぜあなた"}, {"type": "subtitle", "time": 21569.51, "timestamp": "05:59:29", "text": "起きている？でも、自分の部屋で寝て"}, {"type": "subtitle", "time": 21571.67, "timestamp": "05:59:31", "text": "あれ。わかった。あなたに無理強いはしたくない"}, {"type": "subtitle", "time": 21572.83, "timestamp": "05:59:32", "text": "眠る。"}, {"type": "subtitle", "time": 21577.07, "timestamp": "05:59:37", "text": "わかった。こんにちは。そして、このゲームが"}, {"type": "subtitle", "time": 21581.11, "timestamp": "05:59:41", "text": "聞いたところによると、ホラーっぽいらしい。"}, {"type": "subtitle", "time": 21583.75, "timestamp": "05:59:43", "text": "本当にひどくてホラーに敏感で、"}, {"type": "subtitle", "time": 21585.628, "timestamp": "05:59:45", "text": "叫びたくない"}, {"type": "subtitle", "time": 21587.948, "timestamp": "05:59:47", "text": "しかし"}, {"type": "subtitle", "time": 21591.35, "timestamp": "05:59:51", "text": "あ、こんにちは。続ける前に、"}, {"type": "subtitle", "time": 21594.23, "timestamp": "05:59:54", "text": "ちょっと休憩して、お茶を淹れようかな。"}, {"type": "subtitle", "time": 21597.39, "timestamp": "05:59:57", "text": "それは、お茶を飲むと目が覚めると思うから"}]
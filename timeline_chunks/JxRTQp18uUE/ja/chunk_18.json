[{"type": "subtitle", "time": 1089.27, "timestamp": "00:18:09", "text": "47. 私は目撃した後"}, {"type": "subtitle", "time": 1091.15, "timestamp": "00:18:11", "text": "昨日の"}, {"type": "subtitle", "time": 1094.71, "timestamp": "00:18:14", "text": "物事、私は本当に心配しています"}, {"type": "subtitle", "time": 1098.27, "timestamp": "00:18:18", "text": "エネルギーレベル。もし私がどこへ行くとしたら"}, {"type": "subtitle", "time": 1102.71, "timestamp": "00:18:22", "text": "外の世界では、私の心は完全に死んでいるだろう。"}, {"type": "subtitle", "time": 1106.549, "timestamp": "00:18:26", "text": "そしてそれは難しいことだ。それは、"}, {"type": "subtitle", "time": 1111.35, "timestamp": "00:18:31", "text": "それは日本では難しいだろう"}, {"type": "subtitle", "time": 1114.63, "timestamp": "00:18:34", "text": "日本にいるときは、おそらく"}, {"type": "subtitle", "time": 1119.029, "timestamp": "00:18:39", "text": "夕方までに、いやいやいや、午後までに私の"}, {"type": "subtitle", "time": 1121.75, "timestamp": "00:18:41", "text": "授業は午後までに終わります"}, {"type": "subtitle", "time": 1125.669, "timestamp": "00:18:45", "text": "夕方か夜、6時頃か"}, {"type": "subtitle", "time": 1129.549, "timestamp": "00:18:49", "text": "7 そうですね、私はまだパートタイムで働いています"}, {"type": "subtitle", "time": 1132.47, "timestamp": "00:18:52", "text": "そうですね、それでPneyから戻ってきたら"}, {"type": "subtitle", "time": 1135.19, "timestamp": "00:18:55", "text": "私はとても疲れるでしょう。私は"}, {"type": "subtitle", "time": 1137.87, "timestamp": "00:18:57", "text": "ベッドに入る"}]
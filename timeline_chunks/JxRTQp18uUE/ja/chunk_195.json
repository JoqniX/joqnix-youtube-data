[{"type": "subtitle", "time": 11704.07, "timestamp": "03:15:04", "text": "GPUが低レベルなので、1660 Superではできません"}, {"type": "subtitle", "time": 11706.87, "timestamp": "03:15:06", "text": "あまり使わないと良いゲームができないし"}, {"type": "subtitle", "time": 11707.95, "timestamp": "03:15:07", "text": "もの"}, {"type": "subtitle", "time": 11712.67, "timestamp": "03:15:12", "text": "私の古いPCには2060が搭載されていました"}, {"type": "subtitle", "time": 11716.429, "timestamp": "03:15:16", "text": "2060 私はRTX 2060を持っていたが、"}, {"type": "subtitle", "time": 11720.19, "timestamp": "03:15:20", "text": "GPUが故障しました。それが機能しない場合"}, {"type": "subtitle", "time": 11723.67, "timestamp": "03:15:23", "text": "もう。そして古いゲームPCのもう1つ"}, {"type": "subtitle", "time": 11727.469, "timestamp": "03:15:27", "text": "1つはAMDのRyzen 7だった。"}, {"type": "subtitle", "time": 11731.75, "timestamp": "03:15:31", "text": "3800X。そのCPUも壊れてしまった。ない"}, {"type": "subtitle", "time": 11734.11, "timestamp": "03:15:34", "text": "働く"}, {"type": "subtitle", "time": 11737.75, "timestamp": "03:15:37", "text": "もう。ええ、そうですね。だから私が日本に行くとき"}, {"type": "subtitle", "time": 11740.87, "timestamp": "03:15:40", "text": "7月には新しいノートパソコンを買わなければならない。私"}, {"type": "subtitle", "time": 11743.59, "timestamp": "03:15:43", "text": "このパソコンは使用できません。いいえ、このPCは"}, {"type": "subtitle", "time": 11745.11, "timestamp": "03:15:45", "text": "インドで。"}, {"type": "subtitle", "time": 11747.95, "timestamp": "03:15:47", "text": "私は家にいます。"}]
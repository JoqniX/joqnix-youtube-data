[{"type": "subtitle", "time": 21961.99, "timestamp": "06:06:01", "text": "モールのようなところへ行ったとき、私は尋ねた。「M、私は"}, {"type": "subtitle", "time": 21965.03, "timestamp": "06:06:05", "text": "このドーナツが欲しい。安っぽい感じがする。できますか"}, {"type": "subtitle", "time": 21967.1, "timestamp": "06:06:07", "text": "1つ手に入れる？"}, {"type": "subtitle", "time": 21968.628, "timestamp": "06:06:08", "text": "[音楽]"}, {"type": "subtitle", "time": 21971.51, "timestamp": "06:06:11", "text": "えっと、それで彼女に聞いて、初めて"}, {"type": "subtitle", "time": 21974.75, "timestamp": "06:06:14", "text": "今までで一番ドーナツを食べた時間"}, {"type": "subtitle", "time": 21978.07, "timestamp": "06:06:18", "text": "人生。食べ物の種類が多すぎて"}, {"type": "subtitle", "time": 21981.548, "timestamp": "06:06:21", "text": "試してみたい"}, {"type": "subtitle", "time": 21984.868, "timestamp": "06:06:24", "text": "未来。機会があればいつでも試してみたい"}, {"type": "subtitle", "time": 21988.548, "timestamp": "06:06:28", "text": "外。あるいは、私は、えーと、"}, {"type": "subtitle", "time": 21991.67, "timestamp": "06:06:31", "text": "食べ物のレビューや食事に関すること"}, {"type": "subtitle", "time": 21994.15, "timestamp": "06:06:34", "text": "激辛麺チャレンジみたいに。誰が"}, {"type": "subtitle", "time": 21996.15, "timestamp": "06:06:36", "text": "やりたいこと 誰がそれを見たいですか？誰が"}, {"type": "subtitle", "time": 21998.31, "timestamp": "06:06:38", "text": "激辛麺チャレンジを見てみたいですか？"}, {"type": "subtitle", "time": 21999.708, "timestamp": "06:06:39", "text": "私が"}, {"type": "subtitle", "time": 22003.548, "timestamp": "06:06:43", "text": "それ。私は本当に興奮しています"}, {"type": "subtitle", "time": 22007.07, "timestamp": "06:06:47", "text": "それ。もしあなたが望むなら、もし誰かが望むなら"}, {"type": "subtitle", "time": 22011.03, "timestamp": "06:06:51", "text": "でも、韓国の何かがある"}, {"type": "subtitle", "time": 22013.51, "timestamp": "06:06:53", "text": "えっと、韓国の辛いメモみたいなやつですよね？"}, {"type": "subtitle", "time": 22015.75, "timestamp": "06:06:55", "text": "ご注文いただけます。したい"}, {"type": "subtitle", "time": 22018.548, "timestamp": "06:06:58", "text": "そうしてください。スパイスの味を味わいたい"}]
[{"type": "subtitle", "time": 21424.99, "timestamp": "05:57:04", "text": "[音楽]"}, {"type": "subtitle", "time": 21427.43, "timestamp": "05:57:07", "text": "これ？それはつまり、もっと必要だということだと思う"}, {"type": "subtitle", "time": 21428.67, "timestamp": "05:57:08", "text": "睡眠、私は"}, {"type": "subtitle", "time": 21431.31, "timestamp": "05:57:11", "text": "信じる。わからない。そしてまた、"}, {"type": "subtitle", "time": 21433.868, "timestamp": "05:57:13", "text": "エドワード、元気でいることを願っています"}, {"type": "subtitle", "time": 21435.71, "timestamp": "05:57:15", "text": "良い。来る"}, {"type": "subtitle", "time": 21445.708, "timestamp": "05:57:25", "text": "による。見てみましょう。もうすぐだ、"}, {"type": "subtitle", "time": 21449.59, "timestamp": "05:57:29", "text": "信じる。はい。こんにちは。念のため確認させてください。"}, {"type": "subtitle", "time": 21451.718, "timestamp": "05:57:31", "text": "念のため確認させてください。 えっと、もう一度確認させてください。つまり、"}, {"type": "subtitle", "time": 21454.52, "timestamp": "05:57:34", "text": "えっと、もう一度確認させてください。つまり、 同じ。そして私たちは"}, {"type": "subtitle", "time": 21458.84, "timestamp": "05:57:38", "text": "同じ。そして私たちは 昨年11月30日頃、こちらでストリーミング配信"}, {"type": "subtitle", "time": 21463.4, "timestamp": "05:57:43", "text": "昨年11月30日頃、こちらでストリーミング配信 年。私は何て言ったの？私の声を聞かせてください"}, {"type": "subtitle", "time": 21466.4, "timestamp": "05:57:46", "text": "年。私は何て言ったの？私の声を聞かせてください 自分の声。ああ、"}, {"type": "subtitle", "time": 21470.4, "timestamp": "05:57:50", "text": "自分の声。ああ、 聞こえないよ。何？私の"}, {"type": "subtitle", "time": 21472.638, "timestamp": "05:57:52", "text": "聞こえないよ。何？私の ボリューム"}, {"type": "subtitle", "time": 21474.36, "timestamp": "05:57:54", "text": "ボリューム 600. チャットは皆さん楽しんでいただけましたか？おお"}, {"type": "subtitle", "time": 21477.44, "timestamp": "05:57:57", "text": "600. チャットは皆さん楽しんでいただけましたか？おお 我が神よ。オーディオのピーク性能が最高レベルに達した。"}]
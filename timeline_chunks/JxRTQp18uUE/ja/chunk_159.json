[{"type": "subtitle", "time": 9552.83, "timestamp": "02:39:12", "text": "神。おお"}, {"type": "subtitle", "time": 9560.11, "timestamp": "02:39:20", "text": "えっと、試してみてもいいですよ"}, {"type": "subtitle", "time": 9563.23, "timestamp": "02:39:23", "text": "中国人 中国人として"}, {"type": "subtitle", "time": 9564.91, "timestamp": "02:39:24", "text": "1"}, {"type": "subtitle", "time": 9574.19, "timestamp": "02:39:34", "text": "ビデオ？"}, {"type": "subtitle", "time": 9584.07, "timestamp": "02:39:44", "text": "私の名前は中国語でどう発音しますか？"}, {"type": "subtitle", "time": 9586.03, "timestamp": "02:39:46", "text": "けれど？"}, {"type": "subtitle", "time": 9593.15, "timestamp": "02:39:53", "text": "[音楽]"}, {"type": "subtitle", "time": 9597.21, "timestamp": "02:39:57", "text": "いいえ、それはできます。"}]
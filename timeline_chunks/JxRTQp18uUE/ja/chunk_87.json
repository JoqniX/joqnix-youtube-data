[{"type": "subtitle", "time": 5228.55, "timestamp": "01:27:08", "text": "彼は子犬です。猫が何匹か彼の頭を傷つけた。おお"}, {"type": "subtitle", "time": 5244.149, "timestamp": "01:27:24", "text": "神。この見知らぬ人たち、吐き気がする"}, {"type": "subtitle", "time": 5251.27, "timestamp": "01:27:31", "text": "ビルダー？これは無作為な人々です。したい"}, {"type": "subtitle", "time": 5268.709, "timestamp": "01:27:48", "text": "モデルの位置と"}, {"type": "subtitle", "time": 5278.95, "timestamp": "01:27:58", "text": "お前の家族を狙うぞ。あなただけ"}]
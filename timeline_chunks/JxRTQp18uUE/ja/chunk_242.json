[{"type": "subtitle", "time": 14532.79, "timestamp": "04:02:12", "text": "[音楽]"}, {"type": "subtitle", "time": 14534.83, "timestamp": "04:02:14", "text": "私は"}, {"type": "subtitle", "time": 14538.15, "timestamp": "04:02:18", "text": "疑い。 YouTubeで知っているように、私は"}, {"type": "subtitle", "time": 14541.03, "timestamp": "04:02:21", "text": "そしてTwitchには"}, {"type": "subtitle", "time": 14544.15, "timestamp": "04:02:24", "text": "あなたが知っている人"}, {"type": "subtitle", "time": 14548.79, "timestamp": "04:02:28", "text": "ライブ配信ルームに出入りする。しかし"}, {"type": "subtitle", "time": 14551.99, "timestamp": "04:02:31", "text": "私はいつもいくつかのプラットフォームについて自問自答しています"}, {"type": "subtitle", "time": 14552.91, "timestamp": "04:02:32", "text": "のように"}, {"type": "subtitle", "time": 14555.83, "timestamp": "04:02:35", "text": "リアリティアプリ モジビリー"}, {"type": "subtitle", "time": 14558.07, "timestamp": "04:02:38", "text": "など。ええと、誰かが"}, {"type": "subtitle", "time": 14560.83, "timestamp": "04:02:40", "text": "ストリームに参加すると、その人の名前が表示されます"}, {"type": "subtitle", "time": 14565.59, "timestamp": "04:02:45", "text": "ここに、今、誰かが入ってくる"}, {"type": "subtitle", "time": 14568.389, "timestamp": "04:02:48", "text": "その部屋。私は彼らを歓迎すべきでしょうか？"}, {"type": "subtitle", "time": 14571.03, "timestamp": "04:02:51", "text": "彼らが入ってくるとき、または彼らを歓迎するだけです"}, {"type": "subtitle", "time": 14573.99, "timestamp": "04:02:53", "text": "彼らがチャットするとき？私はYouTubeをやっています"}, {"type": "subtitle", "time": 14577.269, "timestamp": "04:02:57", "text": "Twitch のあのやつで、誰かが"}, {"type": "subtitle", "time": 14579.67, "timestamp": "04:02:59", "text": "チャットをしたら、私は彼らを歓迎します。"}]
[{"type": "subtitle", "time": 3900.75, "timestamp": "01:05:00", "text": "[音楽]"}, {"type": "subtitle", "time": 3905.029, "timestamp": "01:05:05", "text": "クレイジー。あれはすごかった。ああ、ああ、なんてことだ。私"}, {"type": "subtitle", "time": 3906.109, "timestamp": "01:05:06", "text": "しないで"}, {"type": "subtitle", "time": 3909.349, "timestamp": "01:05:09", "text": "はい。さよなら。"}, {"type": "subtitle", "time": 3910.95, "timestamp": "01:05:10", "text": "ああ、フォートナイトをプレイできるよ。によって"}, {"type": "subtitle", "time": 3918.75, "timestamp": "01:05:18", "text": "それ。ああ、いやだ。"}, {"type": "subtitle", "time": 3922.309, "timestamp": "01:05:22", "text": "DSG。ということで、キットをいくつか用意します。"}, {"type": "subtitle", "time": 3923.95, "timestamp": "01:05:23", "text": "そして"}, {"type": "subtitle", "time": 3926.99, "timestamp": "01:05:26", "text": "うん。では、キットをいくつか開けてみよう"}, {"type": "subtitle", "time": 3930.71, "timestamp": "01:05:30", "text": "外。うん。"}, {"type": "subtitle", "time": 3934.71, "timestamp": "01:05:34", "text": "何てことだ。この動画は何？なぜ"}, {"type": "subtitle", "time": 3937.829, "timestamp": "01:05:37", "text": "みんなこんな風に切り抜くの？なぜなぜ"}, {"type": "subtitle", "time": 3940.15, "timestamp": "01:05:40", "text": "なぜ私の画像が切り取られるのですか？なぜ私は"}, {"type": "subtitle", "time": 3942.99, "timestamp": "01:05:42", "text": "私に何が問題なの？ですか"}, {"type": "subtitle", "time": 3946.43, "timestamp": "01:05:46", "text": "ランダムな人々を構築したい"}]
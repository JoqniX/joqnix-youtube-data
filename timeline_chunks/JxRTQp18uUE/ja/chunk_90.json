[{"type": "subtitle", "time": 5402.51, "timestamp": "01:30:02", "text": "えっと、私は、私は、"}, {"type": "subtitle", "time": 5407.11, "timestamp": "01:30:07", "text": "そのクリップにクレジットを付けるのは、"}, {"type": "subtitle", "time": 5421.75, "timestamp": "01:30:21", "text": "[笑い]"}, {"type": "subtitle", "time": 5427.43, "timestamp": "01:30:27", "text": "何か。何かをする前に、"}, {"type": "subtitle", "time": 5454.39, "timestamp": "01:30:54", "text": "少し。 5分だけ時間をください。 5つまたは"}]
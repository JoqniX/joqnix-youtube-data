[{"type": "subtitle", "time": 20643.91, "timestamp": "05:44:03", "text": "FIFA U-17ワールドカップを待つ"}, {"type": "subtitle", "time": 20645.67, "timestamp": "05:44:05", "text": "インドが主催する予定で、"}, {"type": "subtitle", "time": 20648.72, "timestamp": "05:44:08", "text": "オーに影響を与えるだろう"}, {"type": "subtitle", "time": 20655.868, "timestamp": "05:44:15", "text": "いいえ。ワシは戦える。ええ、読みました"}, {"type": "subtitle", "time": 20660.91, "timestamp": "05:44:20", "text": "これ。このゲーム、信じられない。"}, {"type": "subtitle", "time": 20663.51, "timestamp": "05:44:23", "text": "待って、このゲーム。信じられない、ああ、"}, {"type": "subtitle", "time": 20665.59, "timestamp": "05:44:25", "text": "待って。あなたはゲームについて話していましたね。"}, {"type": "subtitle", "time": 20669.19, "timestamp": "05:44:29", "text": "ええ、そうですね。どうやら、私は"}, {"type": "subtitle", "time": 20671.99, "timestamp": "05:44:31", "text": "ストリームはこのDLCをやった。私"}, {"type": "subtitle", "time": 20674.23, "timestamp": "05:44:34", "text": "ずっと前にDLCを始めた"}, {"type": "subtitle", "time": 20676.868, "timestamp": "05:44:36", "text": "年。実は最後まで書き終えられなかったんです。それで、"}, {"type": "subtitle", "time": 20679.75, "timestamp": "05:44:39", "text": "私たちには2つのストリームしかありませんでした"}, {"type": "subtitle", "time": 20683.75, "timestamp": "05:44:43", "text": "YouTubeですが、残念ながら私のPCのせいで"}, {"type": "subtitle", "time": 20686.31, "timestamp": "05:44:46", "text": "ぐちゃぐちゃになってリセットしないといけない"}, {"type": "subtitle", "time": 20691.59, "timestamp": "05:44:51", "text": "合計で12～13回程度"}, {"type": "subtitle", "time": 20694.23, "timestamp": "05:44:54", "text": "昨年の回数、そして今年自体の回数。それで、"}, {"type": "subtitle", "time": 20696.948, "timestamp": "05:44:56", "text": "リセットやその他諸々のせいで、"}]
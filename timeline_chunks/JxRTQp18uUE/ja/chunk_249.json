[{"type": "subtitle", "time": 14946.87, "timestamp": "04:09:06", "text": "ギャング。私はここで昼食を食べに行きました"}, {"type": "subtitle", "time": 14950.63, "timestamp": "04:09:10", "text": "場所。私は医者を探していて、"}, {"type": "subtitle", "time": 14952.389, "timestamp": "04:09:12", "text": "つまずいて、つまずいて、"}, {"type": "subtitle", "time": 14954.71, "timestamp": "04:09:14", "text": "レストランやケータリングサービスのようなもの"}, {"type": "subtitle", "time": 14958.99, "timestamp": "04:09:18", "text": "それはセルフサービスのようなもので"}, {"type": "subtitle", "time": 14962.07, "timestamp": "04:09:22", "text": "サービス。昼食をとって、"}, {"type": "subtitle", "time": 14965.429, "timestamp": "04:09:25", "text": "夜食とか色々。まるで並べられたみたいだ"}, {"type": "subtitle", "time": 14967.269, "timestamp": "04:09:27", "text": "あなたの目の前に。何でも選べます"}, {"type": "subtitle", "time": 14969.389, "timestamp": "04:09:29", "text": "そしてたくさんの座席があります"}, {"type": "subtitle", "time": 14972.389, "timestamp": "04:09:32", "text": "そこには。それで私はつまずいて"}, {"type": "subtitle", "time": 14974.309, "timestamp": "04:09:34", "text": "これを探している間に偶然見つけた"}, {"type": "subtitle", "time": 14976.75, "timestamp": "04:09:36", "text": "ある医師。"}, {"type": "subtitle", "time": 14981.11, "timestamp": "04:09:41", "text": "Googleマップで彼の家を検索"}, {"type": "subtitle", "time": 14983.91, "timestamp": "04:09:43", "text": "診察の予約をしました"}, {"type": "subtitle", "time": 14987.11, "timestamp": "04:09:47", "text": "事態が深刻になるので、"}, {"type": "subtitle", "time": 14990.99, "timestamp": "04:09:50", "text": "見つけるには、できるだけ前に行わなければならなかった"}, {"type": "subtitle", "time": 14993.79, "timestamp": "04:09:53", "text": "可能で"}, {"type": "subtitle", "time": 14997.99, "timestamp": "04:09:57", "text": "そう、だから私は彼らの食べ物が大好きなんです"}]
[{"type": "subtitle", "time": 4030.75, "timestamp": "01:07:10", "text": "何？ああ、"}, {"type": "subtitle", "time": 4034.109, "timestamp": "01:07:14", "text": "神。それは灰色の対称性である"}, {"type": "subtitle", "time": 4041.349, "timestamp": "01:07:21", "text": "これは、ああ、なんてことだ。わかった、そのクリップを入手するよ"}, {"type": "subtitle", "time": 4052.23, "timestamp": "01:07:32", "text": "ええ、何も問題ありませんでした。わかった。聞く、"}, {"type": "subtitle", "time": 4056.47, "timestamp": "01:07:36", "text": "ジョック。ジョック。はい。ラグノスを倒せるなら、"}, {"type": "subtitle", "time": 4058.87, "timestamp": "01:07:38", "text": "ジョー、彼の言うことを聞いちゃダメよ。彼はずる賢い。"}, {"type": "subtitle", "time": 4061.43, "timestamp": "01:07:41", "text": "でも私は守護者であるはずなのに"}, {"type": "subtitle", "time": 4068.95, "timestamp": "01:07:48", "text": "世界。偽りの神を滅ぼさなければならないのは誰だ？"}, {"type": "subtitle", "time": 4073.19, "timestamp": "01:07:53", "text": "うん。神を倒すために。ええ、そうは思いません"}, {"type": "subtitle", "time": 4075.51, "timestamp": "01:07:55", "text": "ジョーがどこにいるか知ってるなら、殺せるなら殺せる"}, {"type": "subtitle", "time": 4078.95, "timestamp": "01:07:58", "text": "ドラグノサ、そうだ、君にあげるよ、"}]
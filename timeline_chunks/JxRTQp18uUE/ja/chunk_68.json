[{"type": "subtitle", "time": 4080.47, "timestamp": "01:08:00", "text": "個人的に報酬を差し上げます"}, {"type": "subtitle", "time": 4082.309, "timestamp": "01:08:02", "text": "報酬は何ですか？教えてください"}, {"type": "subtitle", "time": 4084.23, "timestamp": "01:08:04", "text": "報酬は、もしあなたが殺したらどうなるか知っていますか？"}, {"type": "subtitle", "time": 4086.309, "timestamp": "01:08:06", "text": "ラグノサー、彼の胸当てはそのままにしておいていいよ"}, {"type": "subtitle", "time": 4088.549, "timestamp": "01:08:08", "text": "そして彼の胸当てを胸当てにすることができます"}, {"type": "subtitle", "time": 4091.75, "timestamp": "01:08:11", "text": "ダイヤモンドの胸当てで素敵です"}, {"type": "subtitle", "time": 4094.789, "timestamp": "01:08:14", "text": "ダグノーザーが着ているのはあなたのものです"}, {"type": "subtitle", "time": 4098.47, "timestamp": "01:08:18", "text": "うん、全部私のものだったよ、いいかい？"}, {"type": "subtitle", "time": 4102.63, "timestamp": "01:08:22", "text": "ジョック、ラグノサーを倒せるならそうするよ"}, {"type": "subtitle", "time": 4105.11, "timestamp": "01:08:25", "text": "彼の言うことを聞いてはいけません。彼は騙している。しかし"}, {"type": "subtitle", "time": 4107.43, "timestamp": "01:08:27", "text": "私は守護者であるはず"}, {"type": "subtitle", "time": 4109.92, "timestamp": "01:08:29", "text": "世界。"}, {"type": "subtitle", "time": 4117.63, "timestamp": "01:08:37", "text": "私は守護者であるはずなのに。あなたは"}, {"type": "subtitle", "time": 4121.39, "timestamp": "01:08:41", "text": "きっぱりとノーではない"}, {"type": "subtitle", "time": 4125.99, "timestamp": "01:08:45", "text": "顔。いいえ。夢の中の話だよ、相棒。"}, {"type": "subtitle", "time": 4129.189, "timestamp": "01:08:49", "text": "それは、それは、それは私には見えなかったものです"}, {"type": "subtitle", "time": 4130.349, "timestamp": "01:08:50", "text": "電話で"}]
[{"type": "subtitle", "time": 21121.03, "timestamp": "05:52:01", "text": "幸せ。えっと、アドベント。私は選びました"}, {"type": "subtitle", "time": 21122.85, "timestamp": "05:52:02", "text": "アドベンチャー。"}, {"type": "subtitle", "time": 21124.67, "timestamp": "05:52:04", "text": "[音楽]"}, {"type": "subtitle", "time": 21127.23, "timestamp": "05:52:07", "text": "それで"}, {"type": "subtitle", "time": 21129.548, "timestamp": "05:52:09", "text": "楽しむ"}, {"type": "subtitle", "time": 21137.19, "timestamp": "05:52:17", "text": "そして、本日このニュースを共有していただき、ありがとうございます。"}, {"type": "subtitle", "time": 21138.99, "timestamp": "05:52:18", "text": "感謝"}, {"type": "subtitle", "time": 21149.868, "timestamp": "05:52:29", "text": "ああ。"}, {"type": "subtitle", "time": 21153.07, "timestamp": "05:52:33", "text": "ピュアドッキー"}, {"type": "subtitle", "time": 21161.39, "timestamp": "05:52:41", "text": "ロマンス。また一日が過ぎた。"}, {"type": "subtitle", "time": 21163.99, "timestamp": "05:52:43", "text": "わかった。今日は私の死の日です。なぜなら"}, {"type": "subtitle", "time": 21166.39, "timestamp": "05:52:46", "text": "叫ぶつもり？あなたがどのように"}, {"type": "subtitle", "time": 21167.83, "timestamp": "05:52:47", "text": "このゲームから配信する予定です。ただ"}, {"type": "subtitle", "time": 21169.35, "timestamp": "05:52:49", "text": "私のような。私たちの友人は叫んでいた"}, {"type": "subtitle", "time": 21179.27, "timestamp": "05:52:59", "text": "待って。ああ、これは"}]
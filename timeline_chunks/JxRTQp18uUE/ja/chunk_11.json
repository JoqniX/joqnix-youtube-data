[{"type": "subtitle", "time": 667.03, "timestamp": "00:11:07", "text": "正解です。そして彼らはその鉤十字を手に入れます。"}, {"type": "subtitle", "time": 669.71, "timestamp": "00:11:09", "text": "彼らが手に入れることができるもの"}, {"type": "subtitle", "time": 673.91, "timestamp": "00:11:13", "text": "彼女はナチスと間違われる可能性がある"}, {"type": "subtitle", "time": 679.829, "timestamp": "00:11:19", "text": "誰かによる何か"}, {"type": "subtitle", "time": 700.99, "timestamp": "00:11:40", "text": "それは"}, {"type": "subtitle", "time": 716.13, "timestamp": "00:11:56", "text": "練習が必要だ"}, {"type": "subtitle", "time": 717.47, "timestamp": "00:11:57", "text": "[音楽]"}]
[{"type": "subtitle", "time": 18872.15, "timestamp": "05:14:32", "text": "そのネザライトのブーツはあなたのものでしたか？うん、"}, {"type": "subtitle", "time": 18875.43, "timestamp": "05:14:35", "text": "全ては私のものだった。いいですか、聞いてください。ジョック。"}, {"type": "subtitle", "time": 18879.27, "timestamp": "05:14:39", "text": "ジョック。はい。ラグノザーを倒すことができれば。"}, {"type": "subtitle", "time": 18881.67, "timestamp": "05:14:41", "text": "ジョー、彼の言うことを聞いちゃダメよ。彼は騙している。"}, {"type": "subtitle", "time": 18884.15, "timestamp": "05:14:44", "text": "でも私は守護者であるはずなのに"}, {"type": "subtitle", "time": 18887.27, "timestamp": "05:14:47", "text": "世界。"}, {"type": "subtitle", "time": 18890.948, "timestamp": "05:14:50", "text": "偽りの神を滅ぼさなければならないのは誰だ。うん、"}, {"type": "subtitle", "time": 18894.15, "timestamp": "05:14:54", "text": "私は拒否されました"}, {"type": "subtitle", "time": 18895.59, "timestamp": "05:14:55", "text": "そして私は両方とも"}, {"type": "subtitle", "time": 18898.55, "timestamp": "05:14:58", "text": "プロテクター。診断医のことですよね？"}]
[{"type": "subtitle", "time": 9732.79, "timestamp": "02:42:12", "text": "難しい。ファン100人を集めるのは本当に大変だ。なぜこれが"}, {"type": "subtitle", "time": 9740.07, "timestamp": "02:42:20", "text": "中国語でちゃんとした動画を作るべきだ。"}, {"type": "subtitle", "time": 9742.27, "timestamp": "02:42:22", "text": "でも私は必要ない"}, {"type": "subtitle", "time": 9752.91, "timestamp": "02:42:32", "text": "だから、やります"}, {"type": "subtitle", "time": 9770.27, "timestamp": "02:42:50", "text": "わかった。私は何をしていたんだろう？私"}, {"type": "subtitle", "time": 9776.87, "timestamp": "02:42:56", "text": "クリップ、それは私が叫んでいるのですが、ノイズ"}, {"type": "subtitle", "time": 9778.63, "timestamp": "02:42:58", "text": "抑制すると、私は"}]
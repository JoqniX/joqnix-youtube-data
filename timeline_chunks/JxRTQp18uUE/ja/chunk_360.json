[{"type": "subtitle", "time": 21601.31, "timestamp": "06:00:01", "text": "上。いいえ、緑茶です。それで、"}, {"type": "subtitle", "time": 21603.548, "timestamp": "06:00:03", "text": "ビ"}, {"type": "subtitle", "time": 21607.23, "timestamp": "06:00:07", "text": "今のところはバイセクシャルでチャットしましょう。"}, {"type": "subtitle", "time": 21611.788, "timestamp": "06:00:11", "text": "待って。こんにちは。あなたは音楽を楽しんでいる。"}, {"type": "subtitle", "time": 21615.35, "timestamp": "06:00:15", "text": "わかった。もう少ししたら戻ってきます。"}, {"type": "subtitle", "time": 21618.47, "timestamp": "06:00:18", "text": "少ししたらスピードランで戻ってきます。必要"}, {"type": "subtitle", "time": 21621.75, "timestamp": "06:00:21", "text": "温かいお湯を運び、お茶のように"}]
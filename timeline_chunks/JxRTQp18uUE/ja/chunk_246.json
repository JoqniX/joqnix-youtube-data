[{"type": "subtitle", "time": 14770.87, "timestamp": "04:06:10", "text": "けれど。わかった。タイトルは何にしようかな"}, {"type": "subtitle", "time": 14795.389, "timestamp": "04:06:35", "text": "頭痛がする"}, {"type": "subtitle", "time": 14816.15, "timestamp": "04:06:56", "text": "ケーキ。このケーキは後で食べよう。私"}, {"type": "subtitle", "time": 14818.71, "timestamp": "04:06:58", "text": "このゴアの飲み物は後で飲んだ方がいいだろう。飲む"}]
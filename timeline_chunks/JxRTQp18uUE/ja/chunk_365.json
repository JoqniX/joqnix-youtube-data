[{"type": "subtitle", "time": 21900.23, "timestamp": "06:05:00", "text": "同じ世界におけるこの現実の世界"}, {"type": "subtitle", "time": 21904.15, "timestamp": "06:05:04", "text": "私たち全員がそうであるように。ええ。うん。"}, {"type": "subtitle", "time": 21906.868, "timestamp": "06:05:06", "text": "地球に生まれて、私にはたった2つしか"}, {"type": "subtitle", "time": 21909.91, "timestamp": "06:05:09", "text": "今のところドーナツです。それはチョコレート味だった"}, {"type": "subtitle", "time": 21913.11, "timestamp": "06:05:13", "text": "そしてもう1つは、いや、いや、いや。 1つは"}, {"type": "subtitle", "time": 21915.59, "timestamp": "06:05:15", "text": "チョコレートで完全にチョコレートでした"}, {"type": "subtitle", "time": 21917.75, "timestamp": "06:05:17", "text": "振りかけるもの。わからない。の"}, {"type": "subtitle", "time": 21922.23, "timestamp": "06:05:22", "text": "もう1つは、えーっと、"}, {"type": "subtitle", "time": 21926.628, "timestamp": "06:05:26", "text": "白い、ええと、白い灰だけど、"}, {"type": "subtitle", "time": 21929.27, "timestamp": "06:05:29", "text": "カラフルな虹色の、えーと、スプリンクル"}, {"type": "subtitle", "time": 21932.15, "timestamp": "06:05:32", "text": "好きなものや、振りかけるもの"}, {"type": "subtitle", "time": 21936.59, "timestamp": "06:05:36", "text": "小さい、えっと、小さい長方形、いいえ、違います"}, {"type": "subtitle", "time": 21939.91, "timestamp": "06:05:39", "text": "長方形の丸みを帯びた長方形のもの"}, {"type": "subtitle", "time": 21943.15, "timestamp": "06:05:43", "text": "あれ。うん。それで、えーと、私はお願いしたので"}, {"type": "subtitle", "time": 21947.59, "timestamp": "06:05:47", "text": "難しいのは、えっと、理由はわからないけど、えっと、私は"}, {"type": "subtitle", "time": 21949.35, "timestamp": "06:05:49", "text": "ドーナツを買うなんて考えたこともなかった"}, {"type": "subtitle", "time": 21952.548, "timestamp": "06:05:52", "text": "私自身は、昔は、えーと、"}, {"type": "subtitle", "time": 21955.43, "timestamp": "06:05:55", "text": "2年前だったと思いますが、"}, {"type": "subtitle", "time": 21959.19, "timestamp": "06:05:59", "text": "私と父と家族、えーと、父と母"}]
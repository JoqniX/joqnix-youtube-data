[{"type": "subtitle", "time": 22142.548, "timestamp": "06:09:02", "text": "理解する。つまり、あなたは決して理解できない"}, {"type": "subtitle", "time": 22144.47, "timestamp": "06:09:04", "text": "私が理解したとき、私が説明しようとしたとき"}, {"type": "subtitle", "time": 22150.03, "timestamp": "06:09:10", "text": "スリ"}, {"type": "subtitle", "time": 22151.628, "timestamp": "06:09:11", "text": "言った。"}, {"type": "subtitle", "time": 22154.75, "timestamp": "06:09:14", "text": "おい、子供じゃないぞ。あなた"}, {"type": "subtitle", "time": 22157.788, "timestamp": "06:09:17", "text": "知ってる、本当にそう思ってるの？"}, {"type": "subtitle", "time": 22160.43, "timestamp": "06:09:20", "text": "それ？ H"}, {"type": "subtitle", "time": 22163.67, "timestamp": "06:09:23", "text": "多分。サイアは彼女をいじり始める"}, {"type": "subtitle", "time": 22166.19, "timestamp": "06:09:26", "text": "彼女の間に鉛筆"}, {"type": "subtitle", "time": 22168.67, "timestamp": "06:09:28", "text": "手。勇気"}, {"type": "subtitle", "time": 22172.23, "timestamp": "06:09:32", "text": "自分。あなたの詩をいただけますか？種の"}, {"type": "subtitle", "time": 22175.39, "timestamp": "06:09:35", "text": "手元に置いておきたい。はぁ？"}, {"type": "subtitle", "time": 22177.38, "timestamp": "06:09:37", "text": "なぜ？"}, {"type": "subtitle", "time": 22179.15, "timestamp": "06:09:39", "text": "[音楽]"}, {"type": "subtitle", "time": 22181.67, "timestamp": "06:09:41", "text": "なぜなら、あなたが最初に書いたとき"}, {"type": "subtitle", "time": 22188.23, "timestamp": "06:09:48", "text": "自分。あなたは完全に誤解しています。私"}, {"type": "subtitle", "time": 22190.43, "timestamp": "06:09:50", "text": "これは"}, {"type": "subtitle", "time": 22193.91, "timestamp": "06:09:53", "text": "あなた。そもそもなぜ聞いているのか"}, {"type": "subtitle", "time": 22197.03, "timestamp": "06:09:57", "text": "もう？えっと、何？あなたにあげます"}]
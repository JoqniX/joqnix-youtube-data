[{"type": "subtitle", "time": 5162.35, "timestamp": "01:26:02", "text": "それは私がやりたいことの一つです"}, {"type": "subtitle", "time": 5166.31, "timestamp": "01:26:06", "text": "今日。金の皿、または"}, {"type": "subtitle", "time": 5169.99, "timestamp": "01:26:09", "text": "天体プレートか何か。私たちはAIです"}, {"type": "subtitle", "time": 5172.31, "timestamp": "01:26:12", "text": "生成されたとか、そういうもの。わからない。"}, {"type": "subtitle", "time": 5183.39, "timestamp": "01:26:23", "text": "バージョン。すべてのアバターを回転させる"}, {"type": "subtitle", "time": 5186.189, "timestamp": "01:26:26", "text": "円形に"}, {"type": "subtitle", "time": 5189.39, "timestamp": "01:26:29", "text": "国境。それでおしまい。そうするつもりです"}, {"type": "subtitle", "time": 5196.95, "timestamp": "01:26:36", "text": "うん。ということで、キットをいくつか用意します。"}, {"type": "subtitle", "time": 5198.95, "timestamp": "01:26:38", "text": "ええ、そうです。"}, {"type": "subtitle", "time": 5200.669, "timestamp": "01:26:40", "text": "分"}]
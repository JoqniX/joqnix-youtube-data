[{"type": "subtitle", "time": 22201.43, "timestamp": "06:10:01", "text": "私たちが家に帰るとき。本当に？スナップ。"}, {"type": "subtitle", "time": 22203.47, "timestamp": "06:10:03", "text": "ああ、壊しちゃった"}, {"type": "subtitle", "time": 22206.548, "timestamp": "06:10:06", "text": "鉛筆。そこで、急いでかがんで拾い上げる"}, {"type": "subtitle", "time": 22207.788, "timestamp": "06:10:07", "text": "上に"}, {"type": "subtitle", "time": 22210.67, "timestamp": "06:10:10", "text": "ペン。しかし、"}, {"type": "subtitle", "time": 22214.27, "timestamp": "06:10:14", "text": "彼女に注意を払っていなかったため、彼女はまっすぐにぶつかりました"}, {"type": "subtitle", "time": 22221.59, "timestamp": "06:10:21", "text": "大丈夫です。大丈夫です。私はそれを手に入れます"}, {"type": "subtitle", "time": 22223.67, "timestamp": "06:10:23", "text": "あなた。私はかがんで壊れたものを選び出す"}, {"type": "subtitle", "time": 22226.708, "timestamp": "06:10:26", "text": "鉛筆。ごめん。机だけを切り取って"}, {"type": "subtitle", "time": 22228.788, "timestamp": "06:10:28", "text": "彼女の膝を支え、震えを止めてあげてください。私は"}, {"type": "subtitle", "time": 22240.548, "timestamp": "06:10:40", "text": "セイの腕をつかんで、私たちが座るのを手伝うとします。"}, {"type": "subtitle", "time": 22243.75, "timestamp": "06:10:43", "text": "机。誰でも？まだ読んでいない"}, {"type": "subtitle", "time": 22246.868, "timestamp": "06:10:46", "text": "あなたの詩。あ、すみません。すみません、忘れていました"}, {"type": "subtitle", "time": 22247.708, "timestamp": "06:10:47", "text": "について"}, {"type": "subtitle", "time": 22250.65, "timestamp": "06:10:50", "text": "それ。しかし、それは良くない"}, {"type": "subtitle", "time": 22258.15, "timestamp": "06:10:58", "text": "あなたの。でも心配しないでください。私は確信しています"}]
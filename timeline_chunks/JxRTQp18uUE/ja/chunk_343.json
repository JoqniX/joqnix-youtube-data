[{"type": "subtitle", "time": 20581.89, "timestamp": "05:43:01", "text": "トーナメント、さらに"}, {"type": "subtitle", "time": 20583.788, "timestamp": "05:43:03", "text": "[音楽]"}, {"type": "subtitle", "time": 20593.27, "timestamp": "05:43:13", "text": "インドが中国製アプリなどを禁止"}, {"type": "subtitle", "time": 20596.23, "timestamp": "05:43:16", "text": "そして今、インドは禁止されている"}, {"type": "subtitle", "time": 20598.35, "timestamp": "05:43:18", "text": "他の"}, {"type": "subtitle", "time": 20602.07, "timestamp": "05:43:22", "text": "場所。だから、私たちは読んだことを覚えている"}, {"type": "subtitle", "time": 20605.35, "timestamp": "05:43:25", "text": "彼ら全員からの詩。"}, {"type": "subtitle", "time": 20608.19, "timestamp": "05:43:28", "text": "そして最後の"}, {"type": "subtitle", "time": 20610.788, "timestamp": "05:43:30", "text": "1つ。私は何を言っているんだ？そんなはずはない。"}, {"type": "subtitle", "time": 20612.91, "timestamp": "05:43:32", "text": "いいえ。"}, {"type": "subtitle", "time": 20620.708, "timestamp": "05:43:40", "text": "計算する。えっと、チャット関連のことなら。はい、"}, {"type": "subtitle", "time": 20623.47, "timestamp": "05:43:43", "text": "それは事実です。 FIFAは終わった"}, {"type": "subtitle", "time": 20631.03, "timestamp": "05:43:51", "text": "サッカー関連の話題。ああ、あくびが出てきた。おお"}, {"type": "subtitle", "time": 20639.75, "timestamp": "05:43:59", "text": "17歳未満です。"}]
[{"type": "subtitle", "time": 1141.51, "timestamp": "00:19:01", "text": "おそらく、そして私には時間がないと思う"}, {"type": "subtitle", "time": 1144.39, "timestamp": "00:19:04", "text": "配信中ですが、調整してみます。私はしなければならない"}, {"type": "subtitle", "time": 1146.71, "timestamp": "00:19:06", "text": "そういう仕事に慣れる"}, {"type": "subtitle", "time": 1149.789, "timestamp": "00:19:09", "text": "ある種の環境と"}, {"type": "subtitle", "time": 1152.87, "timestamp": "00:19:12", "text": "えーと、新しいものに体を適応させる"}, {"type": "subtitle", "time": 1154.95, "timestamp": "00:19:14", "text": "状況。私はそう感じています"}, {"type": "subtitle", "time": 1156.19, "timestamp": "00:19:16", "text": "であるべき"}, {"type": "subtitle", "time": 1159.47, "timestamp": "00:19:19", "text": "実行中。それで、"}, {"type": "subtitle", "time": 1163.909, "timestamp": "00:19:23", "text": "きっと解決してくれるでしょう。心配ない。"}, {"type": "subtitle", "time": 1166.19, "timestamp": "00:19:26", "text": "騎手が何とかしてくれるでしょう。"}, {"type": "subtitle", "time": 1175.19, "timestamp": "00:19:35", "text": "心配事。わかった。 46 パート2。まず始めに"}, {"type": "subtitle", "time": 1176.909, "timestamp": "00:19:36", "text": "すべてを置く"}, {"type": "subtitle", "time": 1183.63, "timestamp": "00:19:43", "text": "リンク。 46は"}, {"type": "subtitle", "time": 1189.789, "timestamp": "00:19:49", "text": "26日ですよね？ 25か26。待って、今日は"}, {"type": "subtitle", "time": 1194.669, "timestamp": "00:19:54", "text": "29. 何？ 49. 昨日は"}, {"type": "subtitle", "time": 1198.11, "timestamp": "00:19:58", "text": "28. 48は"}]
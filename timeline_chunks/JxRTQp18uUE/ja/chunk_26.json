[{"type": "subtitle", "time": 1561.43, "timestamp": "00:26:01", "text": "非編集でアップロードします"}, {"type": "subtitle", "time": 1565.909, "timestamp": "00:26:05", "text": "現時点では、タイプと非タイプの両方で低く設定されています。一度私が"}, {"type": "subtitle", "time": 1567.87, "timestamp": "00:26:07", "text": "完全にアップデート済み"}, {"type": "subtitle", "time": 1571.669, "timestamp": "00:26:11", "text": "それを完全に終えたら、"}, {"type": "subtitle", "time": 1574.549, "timestamp": "00:26:14", "text": "YouTubeとTwitchの最新クリップ、"}, {"type": "subtitle", "time": 1577.51, "timestamp": "00:26:17", "text": "それから字幕制作を始めるつもりです"}, {"type": "subtitle", "time": 1580.07, "timestamp": "00:26:20", "text": "ゆっくり、それは1つになるだろう"}, {"type": "subtitle", "time": 1583.83, "timestamp": "00:26:23", "text": "クリップ、2つのクリップ、ほんの小さな"}, {"type": "subtitle", "time": 1586.83, "timestamp": "00:26:26", "text": "ビットですよね？だから、ゆっくりやればいいんです"}, {"type": "subtitle", "time": 1590.549, "timestamp": "00:26:30", "text": "ゆっくり。 Twitchで配信中。新しい切り抜き"}, {"type": "subtitle", "time": 1591.87, "timestamp": "00:26:31", "text": "機能は"}, {"type": "subtitle", "time": 1594.549, "timestamp": "00:26:34", "text": "今でも見ることができる場所へ"}, {"type": "subtitle", "time": 1598.47, "timestamp": "00:26:38", "text": "ストリーム。ポップアップウィンドウになります"}, {"type": "subtitle", "time": 1601.07, "timestamp": "00:26:41", "text": "切り抜きとかそういう時に。それはとても"}, {"type": "subtitle", "time": 1604.47, "timestamp": "00:26:44", "text": "いいね。 Twitchでは、他のユーザーがあなたの映像を切り抜くことができます。"}, {"type": "subtitle", "time": 1606.669, "timestamp": "00:26:46", "text": "同じことが"}, {"type": "subtitle", "time": 1609.43, "timestamp": "00:26:49", "text": "YouTube。 YouTubeで。最近知ったのですが"}, {"type": "subtitle", "time": 1613.35, "timestamp": "00:26:53", "text": "もしあなたが自分のクリップをリミックスできるなら。もしあなたが"}, {"type": "subtitle", "time": 1614.95, "timestamp": "00:26:54", "text": "もしあなたがストリーミング配信をしない人なら"}, {"type": "subtitle", "time": 1618.39, "timestamp": "00:26:58", "text": "私のように12時間、または24時間ですが"}]
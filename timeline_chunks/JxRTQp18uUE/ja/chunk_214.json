[{"type": "subtitle", "time": 12875.269, "timestamp": "03:34:35", "text": "兄弟、シンダーのよりはマシだよ"}, {"type": "subtitle", "time": 12877.71, "timestamp": "03:34:37", "text": "しかし、不運が続いた。ああ、"}, {"type": "subtitle", "time": 12880.59, "timestamp": "03:34:40", "text": "神。ああ、"}, {"type": "subtitle", "time": 12889.349, "timestamp": "03:34:49", "text": "[音楽]"}, {"type": "subtitle", "time": 12892.91, "timestamp": "03:34:52", "text": "正直に言うと、いいえ。えっと、私、私、私、私"}, {"type": "subtitle", "time": 12896.19, "timestamp": "03:34:56", "text": "私はテオンを見るのが好きです。"}, {"type": "subtitle", "time": 12899.269, "timestamp": "03:34:59", "text": "わかった。そして私はしばらくの間、見るのをやめた。"}]
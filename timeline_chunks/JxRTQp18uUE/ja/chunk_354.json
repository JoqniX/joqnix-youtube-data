[{"type": "subtitle", "time": 21242.868, "timestamp": "05:54:02", "text": "私は最後の"}, {"type": "subtitle", "time": 21246.91, "timestamp": "05:54:06", "text": "私が行ったDLCのストリーム"}, {"type": "subtitle", "time": 21250.67, "timestamp": "05:54:10", "text": "私がミモと一緒にやったこと"}, {"type": "subtitle", "time": 21254.27, "timestamp": "05:54:14", "text": "マメハ。これは11月のことでした"}, {"type": "subtitle", "time": 21257.43, "timestamp": "05:54:17", "text": "2021年。そう、そうだね。誰かが電話をかけてきた"}, {"type": "subtitle", "time": 21259.99, "timestamp": "05:54:19", "text": "私の家のドアベル。何てことだ。私"}, {"type": "subtitle", "time": 21262.03, "timestamp": "05:54:22", "text": "これがそうでないことを願います。"}, {"type": "subtitle", "time": 21274.548, "timestamp": "05:54:34", "text": "ストリーム。追いつくまでこれを実行させてください。"}, {"type": "subtitle", "time": 21277.948, "timestamp": "05:54:37", "text": "だからナツは言うべきだ"}, {"type": "subtitle", "time": 21281.43, "timestamp": "05:54:41", "text": "倒れたり、何かが起こったりするだろう。睡眠"}, {"type": "subtitle", "time": 21283.51, "timestamp": "05:54:43", "text": "それほど多くのものだったのは、"}, {"type": "subtitle", "time": 21286.15, "timestamp": "05:54:46", "text": "今朝はいつも通り体調は良いです。"}, {"type": "subtitle", "time": 21289.628, "timestamp": "05:54:49", "text": "あなたは眠らなかった。"}, {"type": "subtitle", "time": 21293.15, "timestamp": "05:54:53", "text": "何？何てことだ。これは"}, {"type": "subtitle", "time": 21296.47, "timestamp": "05:54:56", "text": "大量。何をすればいいですか"}, {"type": "subtitle", "time": 21298.67, "timestamp": "05:54:58", "text": "[音楽]"}]
[{"type": "subtitle", "time": 16263.03, "timestamp": "04:31:03", "text": "年をとって、彼の父親がそれを見て"}, {"type": "subtitle", "time": 16266.229, "timestamp": "04:31:06", "text": "私たちも叱り始めたので、"}, {"type": "subtitle", "time": 16268.79, "timestamp": "04:31:08", "text": "ここまで来たのに悲しい気持ちです"}, {"type": "subtitle", "time": 16271.83, "timestamp": "04:31:11", "text": "ここ。ここに来るのに私たちもお金を払ったんです"}, {"type": "subtitle", "time": 16274.63, "timestamp": "04:31:14", "text": "そしてそれに参加する。そして、"}, {"type": "subtitle", "time": 16278.87, "timestamp": "04:31:18", "text": "たくさんのこと。えっと、彼のお父さんが話している"}, {"type": "chat", "time": 16281.677, "timestamp": "04:31:21", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "he started to scold u why u weren't smokin too?"}, {"type": "subtitle", "time": 16282.229, "timestamp": "04:31:22", "text": "あちらの人々は会場関係者を好んでいる"}, {"type": "subtitle", "time": 16285.269, "timestamp": "04:31:25", "text": "イベントコーディネーターはなぜ"}, {"type": "subtitle", "time": 16287.349, "timestamp": "04:31:27", "text": "君たちが目の前でこんなことをするなんて"}, {"type": "subtitle", "time": 16290.389, "timestamp": "04:31:30", "text": "子供とか、えっと、オープンにとか？"}, {"type": "subtitle", "time": 16294.75, "timestamp": "04:31:34", "text": "どこか閉鎖された場所でやってください。"}, {"type": "subtitle", "time": 16298.63, "timestamp": "04:31:38", "text": "えっと、それで彼は私を叱った"}, {"type": "subtitle", "time": 16300.79, "timestamp": "04:31:40", "text": "先生、なぜあなたはそもそも"}, {"type": "chat", "time": 16301.036, "timestamp": "04:31:41", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "i mean.. "}, {"type": "chat", "time": 16302.02, "timestamp": "04:31:42", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "eh"}, {"type": "subtitle", "time": 16303.03, "timestamp": "04:31:43", "text": "このような場所が好きになるのではなく"}, {"type": "subtitle", "time": 16305.83, "timestamp": "04:31:45", "text": "子供にも適していて、私が"}, {"type": "subtitle", "time": 16308.149, "timestamp": "04:31:48", "text": "二人で楽しみたいだけだった"}, {"type": "subtitle", "time": 16311.389, "timestamp": "04:31:51", "text": "音楽やダンスを楽しみたいと思って"}, {"type": "subtitle", "time": 16314.79, "timestamp": "04:31:54", "text": "すべて、そして私はそうだった"}, {"type": "chat", "time": 16316.723, "timestamp": "04:31:56", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "wut is with public morality, how can u tell people to behave in a public venue"}, {"type": "subtitle", "time": 16317.229, "timestamp": "04:31:57", "text": "ナイトライフがどんなものかを学び、"}]
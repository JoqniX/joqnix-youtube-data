[{"type": "subtitle", "time": 1262.47, "timestamp": "00:21:02", "text": "誕生日にモデルを完成させることができた。"}, {"type": "subtitle", "time": 1265.23, "timestamp": "00:21:05", "text": "でも私の誕生日が近づいている"}, {"type": "subtitle", "time": 1270.59, "timestamp": "00:21:10", "text": "すぐ。私のモデルを入手できる可能性は非常に低いと思います"}, {"type": "subtitle", "time": 1272.27, "timestamp": "00:21:12", "text": "終わり。"}, {"type": "subtitle", "time": 1274.19, "timestamp": "00:21:14", "text": "それで、"}, {"type": "subtitle", "time": 1276.95, "timestamp": "00:21:16", "text": "うん。私はいくつの時計番組を持っていますか？"}, {"type": "subtitle", "time": 1289.63, "timestamp": "00:21:29", "text": "チェック。お誕生日おめでとう"}, {"type": "subtitle", "time": 1299.23, "timestamp": "00:21:39", "text": "ああ、時計時間は"}, {"type": "subtitle", "time": 1300.909, "timestamp": "00:21:40", "text": "5,000"}, {"type": "subtitle", "time": 1311.47, "timestamp": "00:21:51", "text": "2.3K 有効なショットの視聴者数。おお、"}, {"type": "subtitle", "time": 1314.83, "timestamp": "00:21:54", "text": "ニース。それは"}, {"type": "subtitle", "time": 1317.43, "timestamp": "00:21:57", "text": "多く。人々は実際に私の"}, {"type": "subtitle", "time": 1319.909, "timestamp": "00:21:59", "text": "ショット。人々が"}]
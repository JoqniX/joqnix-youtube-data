[{"type": "subtitle", "time": 22441.07, "timestamp": "06:14:01", "text": "借りる。でも、私が一つ手放すたびに、"}, {"type": "subtitle", "time": 22445.31, "timestamp": "06:14:05", "text": "私の間のタイルにぶつかって粉々に砕け散る"}, {"type": "subtitle", "time": 22448.47, "timestamp": "06:14:08", "text": "足。楽しいことを考えよう。楽しいことを考えよう。"}, {"type": "subtitle", "time": 22452.59, "timestamp": "06:14:12", "text": "幸せな考えが至る所に散りばめられている"}, {"type": "subtitle", "time": 22456.75, "timestamp": "06:14:16", "text": "床。それらは私のためのものだった"}, {"type": "subtitle", "time": 22459.868, "timestamp": "06:14:19", "text": "友達。私の友人でそうでない人たち"}, {"type": "subtitle", "time": 22464.19, "timestamp": "06:14:24", "text": "みんな笑顔で、叫び、懇願している"}, {"type": "subtitle", "time": 22470.03, "timestamp": "06:14:30", "text": "何か。でも私が聞くのは、行く、"}, {"type": "subtitle", "time": 22474.07, "timestamp": "06:14:34", "text": "私の頭の中に入ってきて。ああ、これは"}, {"type": "subtitle", "time": 22477.75, "timestamp": "06:14:37", "text": "とても良い。詩。何てことだ。"}, {"type": "subtitle", "time": 22481.27, "timestamp": "06:14:41", "text": "スリによる詩、あるいは日記のようなもの。ああ、"}, {"type": "subtitle", "time": 22489.31, "timestamp": "06:14:49", "text": "それはどういう意味ですか？"}, {"type": "subtitle", "time": 22492.07, "timestamp": "06:14:52", "text": "オカブカ。何てことだ。わからない"}, {"type": "subtitle", "time": 22494.47, "timestamp": "06:14:54", "text": "チャットで何が起こっているのか、もう分からなくなってしまった。"}, {"type": "subtitle", "time": 22497.31, "timestamp": "06:14:57", "text": "私の脳細胞が"}]
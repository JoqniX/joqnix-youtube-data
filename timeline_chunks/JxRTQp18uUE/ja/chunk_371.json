[{"type": "subtitle", "time": 22264.948, "timestamp": "06:11:04", "text": "それ。ボトル。では、読んでみましょう。男、"}, {"type": "subtitle", "time": 22267.51, "timestamp": "06:11:07", "text": "声の出し方は合ってるかな？"}, {"type": "subtitle", "time": 22269.75, "timestamp": "06:11:09", "text": "きちんと？これは、"}, {"type": "subtitle", "time": 22272.948, "timestamp": "06:11:12", "text": "私がやるべきことだ。私は"}, {"type": "subtitle", "time": 22276.47, "timestamp": "06:11:16", "text": "何でもかんでも私の声で。私は最高です"}, {"type": "subtitle", "time": 22277.07, "timestamp": "06:11:17", "text": "素晴らしい"}, {"type": "subtitle", "time": 22281.51, "timestamp": "06:11:21", "text": "本当に申し訳ありません。わかった。あなたはそう思いますか？"}, {"type": "subtitle", "time": 22285.51, "timestamp": "06:11:25", "text": "ベルの問題児でもあるの？え、何？"}, {"type": "subtitle", "time": 22287.31, "timestamp": "06:11:27", "text": "何の話をしてるの？"}, {"type": "subtitle", "time": 22289.83, "timestamp": "06:11:29", "text": "について？私は辛い麺を食べます。私はそれを知っている"}, {"type": "subtitle", "time": 22292.23, "timestamp": "06:11:32", "text": "口から火が噴き出した。同じことが一度あった。試す"}, {"type": "subtitle", "time": 22294.15, "timestamp": "06:11:34", "text": "二度と試みなかった。私は5回試しました"}, {"type": "subtitle", "time": 22297.868, "timestamp": "06:11:37", "text": "時々だけ。うん。さよなら。ああ、"}, {"type": "subtitle", "time": 22303.47, "timestamp": "06:11:43", "text": "神。こんにちは。読んでみましょう Sud を読んでみましょう"}, {"type": "subtitle", "time": 22307.19, "timestamp": "06:11:47", "text": "ボトル。私は頭皮を剥がす"}, {"type": "subtitle", "time": 22310.708, "timestamp": "06:11:50", "text": "クッキーチャームの鉛。秘密がある"}, {"type": "subtitle", "time": 22313.99, "timestamp": "06:11:53", "text": "私の夢をすべて保管しておく場所。全て"}, {"type": "subtitle", "time": 22318.15, "timestamp": "06:11:58", "text": "私の夢。小さなボスのような太陽の光"}]
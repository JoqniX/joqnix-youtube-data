[{"type": "subtitle", "time": 22382.67, "timestamp": "06:13:02", "text": "秘密。隅や隙間に隠れる"}, {"type": "subtitle", "time": 22386.15, "timestamp": "06:13:06", "text": "隙間。掘り続ける。削る"}, {"type": "subtitle", "time": 22393.91, "timestamp": "06:13:13", "text": "私はボトルキャップの埃を吹き飛ばす。それ"}, {"type": "subtitle", "time": 22397.67, "timestamp": "06:13:17", "text": "時間が経った気がしない。私の空っぽ"}, {"type": "subtitle", "time": 22401.35, "timestamp": "06:13:21", "text": "棚にはもう少し何か置いておくと良いだろう。私の友人"}, {"type": "subtitle", "time": 22403.04, "timestamp": "06:13:23", "text": "私の鍵のかかった正面から見て"}, {"type": "subtitle", "time": 22406.11, "timestamp": "06:13:26", "text": "[音楽]"}, {"type": "subtitle", "time": 22411.43, "timestamp": "06:13:31", "text": "ドア。ついに全て完了しました。私は開けて"}, {"type": "subtitle", "time": 22419.59, "timestamp": "06:13:39", "text": "友達。彼らはとても急いでやって来る。"}, {"type": "subtitle", "time": 22423.07, "timestamp": "06:13:43", "text": "彼らは私のボトルをそんなに欲しがっているのだろうか？私"}, {"type": "subtitle", "time": 22426.23, "timestamp": "06:13:46", "text": "慌ててそれらを引っ張って"}, {"type": "subtitle", "time": 22429.47, "timestamp": "06:13:49", "text": "棚の1つ"}, {"type": "subtitle", "time": 22433.548, "timestamp": "06:13:53", "text": "他のすべての人に届くように差し出している"}, {"type": "subtitle", "time": 22437.15, "timestamp": "06:13:57", "text": "友人。一人ひとり"}]
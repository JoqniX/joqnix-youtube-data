[{"type": "subtitle", "time": 20941.47, "timestamp": "05:49:01", "text": "する？私は何をしたのか"}, {"type": "subtitle", "time": 20951.35, "timestamp": "05:49:11", "text": "こんにちは。お元気でお過ごしでしょうか。どうやって"}, {"type": "subtitle", "time": 20953.19, "timestamp": "05:49:13", "text": "ファンタジーだと考えられている？ダウンロードしましたか？"}, {"type": "subtitle", "time": 20956.548, "timestamp": "05:49:16", "text": "それ？ゲームはどうですか？"}, {"type": "subtitle", "time": 20958.548, "timestamp": "05:49:18", "text": "まだプレイしていないのですか？あなたは"}, {"type": "subtitle", "time": 20960.47, "timestamp": "05:49:20", "text": "プレイしてください。うん、君はそれをプレイするんだ。"}, {"type": "subtitle", "time": 20962.868, "timestamp": "05:49:22", "text": "うん。では、あなたが選ぶことを願っています。"}, {"type": "subtitle", "time": 20965.11, "timestamp": "05:49:25", "text": "私と同じサーバーなので、ほら、"}, {"type": "subtitle", "time": 20967.83, "timestamp": "05:49:27", "text": "一緒に拭いて、お互いに助け合う"}, {"type": "subtitle", "time": 20969.53, "timestamp": "05:49:29", "text": "そして"}, {"type": "subtitle", "time": 20973.868, "timestamp": "05:49:33", "text": "[音楽]"}, {"type": "subtitle", "time": 20976.31, "timestamp": "05:49:36", "text": "もの。このホラーゲームに備えよ。"}, {"type": "subtitle", "time": 20979.83, "timestamp": "05:49:39", "text": "問題児。こんにちは。"}, {"type": "subtitle", "time": 20981.2, "timestamp": "05:49:41", "text": "ヘルプ"}]
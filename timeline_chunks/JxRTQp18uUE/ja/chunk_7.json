[{"type": "subtitle", "time": 421.35, "timestamp": "00:07:01", "text": "右？ええと、ペナルティの件"}, {"type": "subtitle", "time": 424.749, "timestamp": "00:07:04", "text": "本当に、えっと、私は"}, {"type": "subtitle", "time": 428.029, "timestamp": "00:07:08", "text": "私が"}, {"type": "chat", "time": 429.147, "timestamp": "00:07:09", "author": "@ObnoxiousAgnostic", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kVrH3KET_eX7LDEi_ka-c3eoI3J-Vcy4GX19VQNPnWwZQ=s64-c-k-c0x00ffffff-no-rj", "message": "Tonight, I went to a convenience store and the Indian clerk noticed I was wearing a kurta, even though I’m not Indian."}, {"type": "subtitle", "time": 430.749, "timestamp": "00:07:10", "text": "罰せられた。だから"}, {"type": "subtitle", "time": 434.35, "timestamp": "00:07:14", "text": "それ。そういう側面もある。それで"}, {"type": "subtitle", "time": 438.23, "timestamp": "00:07:18", "text": "うん、ベストを尽くさなきゃね。"}, {"type": "subtitle", "time": 441.35, "timestamp": "00:07:21", "text": "やあ、不愉快で無関心な息子よ。いらっしゃいませ"}, {"type": "subtitle", "time": 442.27, "timestamp": "00:07:22", "text": "へ"}, {"type": "subtitle", "time": 444.67, "timestamp": "00:07:24", "text": "ストリーム。"}, {"type": "subtitle", "time": 448.27, "timestamp": "00:07:28", "text": "えっと、配信へようこ​​そ。こんにちは。良い"}, {"type": "subtitle", "time": 450.27, "timestamp": "00:07:30", "text": "朝。ハッピー"}, {"type": "subtitle", "time": 452.469, "timestamp": "00:07:32", "text": "火曜日。今夜私は"}, {"type": "subtitle", "time": 454.30899999999997, "timestamp": "00:07:34", "text": "コンビニエンスストアとインドの時計"}, {"type": "subtitle", "time": 456.79, "timestamp": "00:07:36", "text": "私がカを着けていたことに気づいてください。"}, {"type": "subtitle", "time": 461.11, "timestamp": "00:07:41", "text": "私はインド人ではありません。あ、待って。あなたは"}, {"type": "subtitle", "time": 463.83, "timestamp": "00:07:43", "text": "あなたはアメリカ出身ですか、それとも"}, {"type": "subtitle", "time": 465.51, "timestamp": "00:07:45", "text": "何か？あなたはアメリカ出身ですか？どこ"}]
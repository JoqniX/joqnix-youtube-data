[{"type": "subtitle", "time": 3665.069, "timestamp": "01:01:05", "text": "行く。何？ああ、マイナス1点。わかった。えっと。えっと。"}, {"type": "subtitle", "time": 3667.63, "timestamp": "01:01:07", "text": "おお。"}, {"type": "subtitle", "time": 3670.95, "timestamp": "01:01:10", "text": "ボードマスクを使用してください。何？ボードとは何ですか？"}, {"type": "subtitle", "time": 3672.549, "timestamp": "01:01:12", "text": "マスク？"}, {"type": "subtitle", "time": 3675.99, "timestamp": "01:01:15", "text": "それは何ですか？私は決して"}, {"type": "subtitle", "time": 3678.47, "timestamp": "01:01:18", "text": "それ？初めて見た"}, {"type": "subtitle", "time": 3680.15, "timestamp": "01:01:20", "text": "それは何ですか？それは彼らが呼ぶところのことですか？"}, {"type": "subtitle", "time": 3683.63, "timestamp": "01:01:23", "text": "バイオマックスとかいうやつ？"}, {"type": "subtitle", "time": 3686.549, "timestamp": "01:01:26", "text": "バイオマックス。何が"}, {"type": "subtitle", "time": 3688.19, "timestamp": "01:01:28", "text": "聖なる"}, {"type": "subtitle", "time": 3691.829, "timestamp": "01:01:31", "text": "良い？これは何ですか？小数点？"}, {"type": "subtitle", "time": 3695.109, "timestamp": "01:01:35", "text": "何？すみません。"}, {"type": "subtitle", "time": 3701.589, "timestamp": "01:01:41", "text": "クリップ。では、こちらです。ホグワーツ。私たちは"}, {"type": "subtitle", "time": 3717.27, "timestamp": "01:01:57", "text": "これ？一体誰がこれをテストしていたのだろうか"}]
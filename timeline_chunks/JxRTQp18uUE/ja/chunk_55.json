[{"type": "subtitle", "time": 3301.109, "timestamp": "00:55:01", "text": "モデル。あなたのゲームプレイを見たい"}, {"type": "subtitle", "time": 3303.07, "timestamp": "00:55:03", "text": "知りたいですか"}, {"type": "subtitle", "time": 3304.91, "timestamp": "00:55:04", "text": "[音楽]"}, {"type": "subtitle", "time": 3309.349, "timestamp": "00:55:09", "text": "他のプレイヤーはどうしてあんなに上手くプレイできるんだろう。私も"}, {"type": "subtitle", "time": 3342.75, "timestamp": "00:55:42", "text": "砂糖メロン"}, {"type": "subtitle", "time": 3345.069, "timestamp": "00:55:45", "text": "本。ああ、彼女は"}, {"type": "subtitle", "time": 3348.19, "timestamp": "00:55:48", "text": "イラストレーター。それ"}, {"type": "subtitle", "time": 3351.27, "timestamp": "00:55:51", "text": "音楽のようです。ああ、彼女は書いていると思う"}, {"type": "subtitle", "time": 3354.71, "timestamp": "00:55:54", "text": "雑誌か何か。さあ、行って。"}]
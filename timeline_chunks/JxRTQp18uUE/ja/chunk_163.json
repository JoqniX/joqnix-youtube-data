[{"type": "subtitle", "time": 9790.19, "timestamp": "02:43:10", "text": "そして叫ぶ"}, {"type": "subtitle", "time": 9794.71, "timestamp": "02:43:14", "text": "猫のように叫ぶ。"}, {"type": "subtitle", "time": 9796.11, "timestamp": "02:43:16", "text": "質問"}, {"type": "subtitle", "time": 9808.27, "timestamp": "02:43:28", "text": "このタイトルをコピーして貼り付けます"}, {"type": "subtitle", "time": 9810.99, "timestamp": "02:43:30", "text": "どこでも"}, {"type": "subtitle", "time": 9817.19, "timestamp": "02:43:37", "text": "トック・ビリー・ビリー、私はそれを変えます"}, {"type": "subtitle", "time": 9822.83, "timestamp": "02:43:42", "text": "心配事"}, {"type": "subtitle", "time": 9827.83, "timestamp": "02:43:47", "text": "えっと、トラブルが言ったことは本当です。"}, {"type": "subtitle", "time": 9830.87, "timestamp": "02:43:50", "text": "ビリービリーは英語のタイトルを使っても"}, {"type": "subtitle", "time": 9834.71, "timestamp": "02:43:54", "text": "みんな中国語がわかるから、すごく助かるよ"}, {"type": "subtitle", "time": 9837.19, "timestamp": "02:43:57", "text": "私の友達なので、それを入れなければなりません。"}]
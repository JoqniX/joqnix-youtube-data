[{"type": "subtitle", "time": 859.43, "timestamp": "00:14:19", "text": "インドの宗教は、"}, {"type": "subtitle", "time": 864.43, "timestamp": "00:14:24", "text": "ダルマ宗教をテーマにしたもの、または索引"}, {"type": "subtitle", "time": 872.67, "timestamp": "00:14:32", "text": "くそ。東洋にも分類される"}, {"type": "subtitle", "time": 875.55, "timestamp": "00:14:35", "text": "宗教。ニース。"}, {"type": "subtitle", "time": 879.43, "timestamp": "00:14:39", "text": "面白い。私は全く知りませんでした。いいえ、私は決して"}, {"type": "subtitle", "time": 882.47, "timestamp": "00:14:42", "text": "知っていた。えっと、これを持ってたと思うんだけど"}, {"type": "subtitle", "time": 884.03, "timestamp": "00:14:44", "text": "研究について"}, {"type": "subtitle", "time": 887.67, "timestamp": "00:14:47", "text": "高校生の時にわかること"}, {"type": "subtitle", "time": 891.99, "timestamp": "00:14:51", "text": "学校とか、あの時代はそうじゃなかった"}, {"type": "subtitle", "time": 894.03, "timestamp": "00:14:54", "text": "そんな時代"}, {"type": "subtitle", "time": 897.47, "timestamp": "00:14:57", "text": "高校や中学校、"}]
[{"type": "subtitle", "time": 8100.27, "timestamp": "02:15:00", "text": "ソフトドリンクまたは"}, {"type": "subtitle", "time": 8102.87, "timestamp": "02:15:02", "text": "何か、でも私は気づいた"}, {"type": "subtitle", "time": 8106.47, "timestamp": "02:15:06", "text": "本当に必要なのは体内の電解質です"}, {"type": "subtitle", "time": 8107.95, "timestamp": "02:15:07", "text": "として"}, {"type": "subtitle", "time": 8111.75, "timestamp": "02:15:11", "text": "ゲーマー、そしてこれらではなく、これらではなく"}, {"type": "subtitle", "time": 8124.589, "timestamp": "02:15:24", "text": "聖なる"}]
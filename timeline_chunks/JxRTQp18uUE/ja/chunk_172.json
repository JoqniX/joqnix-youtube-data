[{"type": "subtitle", "time": 10320.67, "timestamp": "02:52:00", "text": "人々の"}, {"type": "subtitle", "time": 10323.05, "timestamp": "02:52:03", "text": "えっと、人々の気分を害する"}, {"type": "subtitle", "time": 10325.389, "timestamp": "02:52:05", "text": "[音楽]"}, {"type": "subtitle", "time": 10339.71, "timestamp": "02:52:19", "text": "それはまるで、"}, {"type": "subtitle", "time": 10342.03, "timestamp": "02:52:22", "text": "いいえ、あなたは"}, {"type": "subtitle", "time": 10345.03, "timestamp": "02:52:25", "text": "あなたがしたいことすべて、ただ存在する"}, {"type": "subtitle", "time": 10347.15, "timestamp": "02:52:27", "text": "あなた自身。しかし人々は言う"}, {"type": "subtitle", "time": 10350.389, "timestamp": "02:52:30", "text": "人々はあなたのあら探しをしてこう言う"}, {"type": "subtitle", "time": 10353.429, "timestamp": "02:52:33", "text": "「ああ、女の子みたいな声だね。ああ、"}, {"type": "chat", "time": 10355.609, "timestamp": "02:52:35", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "morning!"}, {"type": "subtitle", "time": 10355.99, "timestamp": "02:52:35", "text": "君はゲイみたいだ、君は"}, {"type": "subtitle", "time": 10358.23, "timestamp": "02:52:38", "text": "トランスジェンダー、ゲイみたいに聞こえる、など"}, {"type": "subtitle", "time": 10360.87, "timestamp": "02:52:40", "text": "などなど。まるでファンボーイみたいだ、など。"}, {"type": "chat", "time": 10361.432, "timestamp": "02:52:41", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "no wait afternoon!"}, {"type": "subtitle", "time": 10363.23, "timestamp": "02:52:43", "text": "できた"}, {"type": "subtitle", "time": 10368.91, "timestamp": "02:52:48", "text": "だから、それはとても痛かった"}, {"type": "subtitle", "time": 10370.83, "timestamp": "02:52:50", "text": "のように"}, {"type": "chat", "time": 10373.415, "timestamp": "02:52:53", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6Y
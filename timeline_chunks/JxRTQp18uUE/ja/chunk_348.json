[{"type": "subtitle", "time": 20880.19, "timestamp": "05:48:00", "text": "だって、だって"}, {"type": "subtitle", "time": 20884.788, "timestamp": "05:48:04", "text": "えっと、私はホラーにすごく敏感なんです。私"}, {"type": "subtitle", "time": 20886.19, "timestamp": "05:48:06", "text": "耐えられない"}, {"type": "subtitle", "time": 20889.31, "timestamp": "05:48:09", "text": "それ。それで、えっと、私は"}, {"type": "subtitle", "time": 20899.03, "timestamp": "05:48:19", "text": "えーと、これは2番目です"}, {"type": "subtitle", "time": 20902.31, "timestamp": "05:48:22", "text": "詩みたいなもの。はい、わかりました。それでは"}, {"type": "subtitle", "time": 20905.19, "timestamp": "05:48:25", "text": "続ける。私たちはこれを全て終え、"}, {"type": "subtitle", "time": 20908.868, "timestamp": "05:48:28", "text": "スディが行くのを見て"}, {"type": "subtitle", "time": 20910.99, "timestamp": "05:48:30", "text": "食器棚から落ちたり、"}, {"type": "subtitle", "time": 20913.75, "timestamp": "05:48:33", "text": "何か。その後、配ります"}, {"type": "subtitle", "time": 20915.99, "timestamp": "05:48:35", "text": "詩はそこで止まった"}, {"type": "subtitle", "time": 20919.75, "timestamp": "05:48:39", "text": "信じてくれれば、私たちはこの活動を続けるよ"}, {"type": "subtitle", "time": 20923.27, "timestamp": "05:48:43", "text": "その場所から先。そしてスピードのために"}, {"type": "subtitle", "time": 20926.708, "timestamp": "05:48:46", "text": "これを実行します。それは完全に私のせいだった"}, {"type": "subtitle", "time": 20938.83, "timestamp": "05:48:58", "text": "ええ、私は何をしたの？"}]
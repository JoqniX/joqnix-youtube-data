[{"type": "subtitle", "time": 5041.51, "timestamp": "01:24:01", "text": "おい、俺はもう法的に成人なんだから、そうするべきだ。私"}, {"type": "subtitle", "time": 5049.39, "timestamp": "01:24:09", "text": "これ。はい、できますよ。そしてあなたはそれを成し遂げた"}, {"type": "subtitle", "time": 5053.35, "timestamp": "01:24:13", "text": "昨日。私は水を飲んで運転した"}, {"type": "subtitle", "time": 5075.94, "timestamp": "01:24:35", "text": "おい、それは私の"}, {"type": "subtitle", "time": 5078.55, "timestamp": "01:24:38", "text": "[音楽]"}, {"type": "subtitle", "time": 5082.149, "timestamp": "01:24:42", "text": "私はダミーを持っています。言おうと思っていた"}, {"type": "subtitle", "time": 5087.189, "timestamp": "01:24:47", "text": "Bで始まる単語。ああ、なんてバカなんだ。私"}, {"type": "subtitle", "time": 5091.87, "timestamp": "01:24:51", "text": "私は少し間を置いた。わずかな"}, {"type": "subtitle", "time": 5094.83, "timestamp": "01:24:54", "text": "一時停止。ああ、"}, {"type": "subtitle", "time": 5098.629, "timestamp": "01:24:58", "text": "神。とんでもない。クラッシュしました。私は"}]
[{"type": "subtitle", "time": 21798.31, "timestamp": "06:03:18", "text": "やあ、ただいま。戻ってきました。私にさせないで"}, {"type": "subtitle", "time": 21801.708, "timestamp": "06:03:21", "text": "走る。ああ、大変だ。私はただ"}, {"type": "subtitle", "time": 21804.43, "timestamp": "06:03:24", "text": "走る。おお"}, {"type": "subtitle", "time": 21813.59, "timestamp": "06:03:33", "text": "ああ、わかった。こんにちは。こんにちは。私たちは裏窓です。それで、"}, {"type": "subtitle", "time": 21815.67, "timestamp": "06:03:35", "text": "ここから配信を開始します。えっと、"}, {"type": "subtitle", "time": 21818.99, "timestamp": "06:03:38", "text": "現在のタイムスタンプは、えーと"}, {"type": "subtitle", "time": 21821.83, "timestamp": "06:03:41", "text": "51. では、52秒から始めましょう。"}, {"type": "subtitle", "time": 21824.708, "timestamp": "06:03:44", "text": "わかった。こんにちは。 52秒。こんにちは。それで、私たちは"}, {"type": "subtitle", "time": 21827.35, "timestamp": "06:03:47", "text": "ここから第3話を開始します。から"}, {"type": "subtitle", "time": 21829.91, "timestamp": "06:03:49", "text": "ここで、声に出して言います"}, {"type": "subtitle", "time": 21832.35, "timestamp": "06:03:52", "text": "すべて、そしてすべて。"}, {"type": "subtitle", "time": 21834.868, "timestamp": "06:03:54", "text": "こんにちは。全力を尽くしましょう。だから私は"}, {"type": "subtitle", "time": 21838.628, "timestamp": "06:03:58", "text": "よく話す。だから、私は読まないよ"}]
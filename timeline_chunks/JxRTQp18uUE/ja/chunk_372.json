[{"type": "subtitle", "time": 22320.91, "timestamp": "06:12:00", "text": "すべてが束のように擦れ合っている"}, {"type": "subtitle", "time": 22324.628, "timestamp": "06:12:04", "text": "子猫たち。親指で中を触る"}, {"type": "subtitle", "time": 22328.07, "timestamp": "06:12:08", "text": "そして指でつまんで一つ抜き取る。その"}, {"type": "subtitle", "time": 22331.27, "timestamp": "06:12:11", "text": "温かくてチリンチリンするけど、時間がない"}, {"type": "subtitle", "time": 22335.03, "timestamp": "06:12:15", "text": "無駄。私はそれをボトルに入れました"}, {"type": "subtitle", "time": 22339.27, "timestamp": "06:12:19", "text": "安全に保管してください。そして私はボトルを置いた"}, {"type": "subtitle", "time": 22342.23, "timestamp": "06:12:22", "text": "他のボトルが並んでいる棚。"}, {"type": "subtitle", "time": 22344.67, "timestamp": "06:12:24", "text": "楽しいことを考えよう。楽しいことを考えよう。ハッピー"}, {"type": "subtitle", "time": 22348.67, "timestamp": "06:12:28", "text": "考え。ボトルの中にすべて"}, {"type": "subtitle", "time": 22352.15, "timestamp": "06:12:32", "text": "ロック。私のコレクションは私にたくさんの"}, {"type": "subtitle", "time": 22354.11, "timestamp": "06:12:34", "text": "友達。それぞれ"}, {"type": "subtitle", "time": 22357.83, "timestamp": "06:12:37", "text": "星明かりを瓶に詰めて、償いをしよう。"}, {"type": "subtitle", "time": 22361.27, "timestamp": "06:12:41", "text": "時々、私の友人はある特定の感情を抱く。"}, {"type": "subtitle", "time": 22364.628, "timestamp": "06:12:44", "text": "ボトルが降りてきて、窮地を救う。"}, {"type": "subtitle", "time": 22365.948, "timestamp": "06:12:45", "text": "翌晩"}, {"type": "subtitle", "time": 22370.15, "timestamp": "06:12:50", "text": "夜、そしてまた夢を見る。友人から友人へ、"}, {"type": "subtitle", "time": 22373.03, "timestamp": "06:12:53", "text": "もっとボトルを。ますます深く私の"}, {"type": "subtitle", "time": 22377.43, "timestamp": "06:12:57", "text": "指が動く。まるで暗い洞窟を探検しているようなものだ。"}, {"type": "subtitle", "time": 22378.91, "timestamp": "06:12:58", "text": "発見する"}]
[{"type": "subtitle", "time": 10021.429, "timestamp": "02:47:01", "text": "終わり。 10点満点中5点中3点。"}, {"type": "subtitle", "time": 10024.429, "timestamp": "02:47:04", "text": "それで、"}, {"type": "subtitle", "time": 10029.71, "timestamp": "02:47:09", "text": "えっと、7つ完了。あと7人。"}, {"type": "subtitle", "time": 10036.11, "timestamp": "02:47:16", "text": "役職"}, {"type": "subtitle", "time": 10038.83, "timestamp": "02:47:18", "text": "アップロード。次のクリップ"}, {"type": "subtitle", "time": 10042.59, "timestamp": "02:47:22", "text": "犬は酔っ払いたいし"}, {"type": "subtitle", "time": 10052.389, "timestamp": "02:47:32", "text": "私はもう法的に成人です。私はお酒を飲むことができ、"}, {"type": "subtitle", "time": 10055.87, "timestamp": "02:47:35", "text": "これを運転してください。ええ、彼らはプロの配信者です。"}, {"type": "subtitle", "time": 10059.75, "timestamp": "02:47:39", "text": "ええ、私はそうするべきです。私はそうします。私はそうしたいです。"}, {"type": "subtitle", "time": 10063.67, "timestamp": "02:47:43", "text": "いつかそのレベルに到達したい。私は私は持っています"}, {"type": "subtitle", "time": 10064.67, "timestamp": "02:47:44", "text": "保つ"}]
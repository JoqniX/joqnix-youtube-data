[{"type": "subtitle", "time": 18960.948, "timestamp": "05:16:00", "text": "報酬を差し上げます。私は手に入れた 私は手に入れた 私は"}, {"type": "subtitle", "time": 18964.628, "timestamp": "05:16:04", "text": "他人に利用された"}, {"type": "subtitle", "time": 18968.15, "timestamp": "05:16:08", "text": "廃墟。今、あの女は遊んだ。人々"}, {"type": "subtitle", "time": 18971.11, "timestamp": "05:16:11", "text": "何度も騙されたよ。たくさんのこと"}, {"type": "subtitle", "time": 18975.11, "timestamp": "05:16:15", "text": "起こった。そのネザライトのブーツはあなたのものでしたか？"}, {"type": "subtitle", "time": 18978.31, "timestamp": "05:16:18", "text": "ええ、すべて私のものだったんです。わかった。聞く、"}, {"type": "subtitle", "time": 18980.868, "timestamp": "05:16:20", "text": "ジョック。ジョック。はい。殺すことができるなら"}, {"type": "subtitle", "time": 19011.948, "timestamp": "05:16:51", "text": "20"}]
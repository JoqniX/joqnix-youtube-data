[{"type": "subtitle", "time": 244.949, "timestamp": "00:04:04", "text": "アイデアを持ってきましょう"}, {"type": "subtitle", "time": 248.149, "timestamp": "00:04:08", "text": "人生に、それは私が望むことについて"}, {"type": "subtitle", "time": 250.22899999999998, "timestamp": "00:04:10", "text": "何かする"}, {"type": "subtitle", "time": 252.47, "timestamp": "00:04:12", "text": "ストリームのために、アニメーションを作りたい"}, {"type": "subtitle", "time": 255.11, "timestamp": "00:04:15", "text": "私の配信なので、いくつかアイデアがあります"}, {"type": "subtitle", "time": 258.949, "timestamp": "00:04:18", "text": "そうしましょう、今日はそのうちのいくつかをやります"}, {"type": "subtitle", "time": 261.83, "timestamp": "00:04:21", "text": "昨日の、えっと、昨日の私たちは"}, {"type": "subtitle", "time": 264.55, "timestamp": "00:04:24", "text": "デルタフォースと一緒にゲームをプレイした"}, {"type": "subtitle", "time": 270.189, "timestamp": "00:04:30", "text": "それで、えっと、それは私の方が多かったんです"}, {"type": "subtitle", "time": 273.03, "timestamp": "00:04:33", "text": "えっと、そこにいて、遊んでいるような感じ"}, {"type": "subtitle", "time": 276.71, "timestamp": "00:04:36", "text": "そして、PCが"}, {"type": "subtitle", "time": 280.23, "timestamp": "00:04:40", "text": "難しい。プレイするのが難しかった"}, {"type": "subtitle", "time": 282.87, "timestamp": "00:04:42", "text": "ゲームやその他すべて、私は"}, {"type": "subtitle", "time": 285.59000000000003, "timestamp": "00:04:45", "text": "ゲームをプレイすることができました"}, {"type": "subtitle", "time": 288.67, "timestamp": "00:04:48", "text": "遅延しているか、ストリームが遅延していたかのどちらかです。"}, {"type": "subtitle", "time": 291.99, "timestamp": "00:04:51", "text": "などなど。だから、いろいろあるけど、大丈夫。"}, {"type": "subtitle", "time": 297.27, "timestamp": "00:04:57", "text": "どのような種類のストリームが期待できますか？"}, {"type": "subtitle", "time": 299.909, "timestamp": "00:04:59", "text": "今日と明日、私から？"}]
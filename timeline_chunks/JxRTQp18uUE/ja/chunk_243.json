[{"type": "subtitle", "time": 14582.469, "timestamp": "04:03:02", "text": "彼らは実際にそうしたいと決める"}, {"type": "subtitle", "time": 14587.15, "timestamp": "04:03:07", "text": "見て。右。私はとても混乱しています"}, {"type": "subtitle", "time": 14590.389, "timestamp": "04:03:10", "text": "請求書を見たとき、"}, {"type": "chat", "time": 14593.256, "timestamp": "04:03:13", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "if thery interact"}, {"type": "subtitle", "time": 14593.349, "timestamp": "04:03:13", "text": "現実には誰もが歓迎しているようだ"}, {"type": "subtitle", "time": 14596.389, "timestamp": "04:03:16", "text": "ストリームに参加している人々"}, {"type": "subtitle", "time": 14599.189, "timestamp": "04:03:19", "text": "これは、〇〇ユーザーが参加したことを示しています"}, {"type": "subtitle", "time": 14603.15, "timestamp": "04:03:23", "text": "ライブ配信。私は混乱しています"}, {"type": "subtitle", "time": 14606.79, "timestamp": "04:03:26", "text": "彼らが交流した方が良いんじゃない？"}, {"type": "subtitle", "time": 14610.389, "timestamp": "04:03:30", "text": "好きになれない、まるで私が誰かだったら"}, {"type": "subtitle", "time": 14613.03, "timestamp": "04:03:33", "text": "誰かの配信に参加する人は"}, {"type": "subtitle", "time": 14616.389, "timestamp": "04:03:36", "text": "歓迎されたくないなら、私は"}, {"type": "subtitle", "time": 14620.67, "timestamp": "04:03:40", "text": "こっそり覗き見たい"}, {"type": "subtitle", "time": 14623.67, "timestamp": "04:03:43", "text": "そうだけど、私を歓迎してくれる人もいる"}, {"type": "subtitle", "time": 14625.91, "timestamp": "04:03:45", "text": "それで私は「ああ、何か言わなきゃ」って思ったんです"}, {"type": "subtitle", "time": 14628.55, "timestamp": "04:03:48", "text": "だって彼らは私を歓迎してくれたから、それはまるで強制みたい"}, {"type": "subtitle", "time": 14632.229, "timestamp": "04:03:52", "text": "私に話すな。悪くないよ。私は"}, {"type": "chat", "time": 14632.953, "timestamp": "04:03:52", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "do u upright say hello to a person just looking in yr general direction"}, {"type": "subtitle", "time": 14634.51, "timestamp": "04:03:54", "text": "考えすぎているだけ"}, {"type": "subtitle", "time": 14637.99, "timestamp": "04:03:57", "text": "推測。私はそう考えたのは、"}, {"type": "subtitle", "time": 14639.91, "timestamp": "04:03:59", "text": "私が潜伏している時に誰かが私を歓迎してくれたら、"}]
[{"type": "subtitle", "time": 19145.47, "timestamp": "05:19:05", "text": "罰則はありません。これは何ですか？新しい"}, {"type": "subtitle", "time": 19148.07, "timestamp": "05:19:08", "text": "視聴者。おお、誰かが実際にフォローしてくれた"}, {"type": "subtitle", "time": 19150.67, "timestamp": "05:19:10", "text": "自分。感謝"}, {"type": "subtitle", "time": 19166.55, "timestamp": "05:19:26", "text": "続いた。ここからでも見えるよね？"}, {"type": "subtitle", "time": 19168.23, "timestamp": "05:19:28", "text": "ブラウザがVにログインしています"}, {"type": "subtitle", "time": 19170.948, "timestamp": "05:19:30", "text": "アカウント。このブラウザは"}, {"type": "subtitle", "time": 19172.13, "timestamp": "05:19:32", "text": "チョーク"}, {"type": "subtitle", "time": 19174.03, "timestamp": "05:19:34", "text": "[音楽]"}, {"type": "subtitle", "time": 19182.708, "timestamp": "05:19:42", "text": "観客。問題は、もし私に友達がいたら"}, {"type": "subtitle", "time": 19186.23, "timestamp": "05:19:46", "text": "日本出身の人、中国出身の人、"}, {"type": "subtitle", "time": 19188.47, "timestamp": "05:19:48", "text": "はユーチューバーなので、"}, {"type": "subtitle", "time": 19190.788, "timestamp": "05:19:50", "text": "コラボレーション。しかし、作るのは難しい"}, {"type": "subtitle", "time": 19192.31, "timestamp": "05:19:52", "text": "友達。"}, {"type": "subtitle", "time": 19195.31, "timestamp": "05:19:55", "text": "ビリー・ビリーはVtuberの友達として"}]
[{"type": "subtitle", "time": 11642.11, "timestamp": "03:14:02", "text": "5つのストリームに進む"}, {"type": "subtitle", "time": 11644.15, "timestamp": "03:14:04", "text": "同時に？まだ新しい"}, {"type": "subtitle", "time": 11653.67, "timestamp": "03:14:13", "text": "あなたのコンピューターはいくらですか？"}, {"type": "subtitle", "time": 11657.429, "timestamp": "03:14:17", "text": "私のコンピューターは、これは以前はこうでした"}, {"type": "subtitle", "time": 11660.389, "timestamp": "03:14:20", "text": "これは私の配信用PCです。私は持っていなければならなかった"}, {"type": "subtitle", "time": 11663.67, "timestamp": "03:14:23", "text": "コンピュータ2台。ストリーミングPC"}, {"type": "subtitle", "time": 11666.79, "timestamp": "03:14:26", "text": "ストリーミング配信専用のゲーミングPC"}, {"type": "subtitle", "time": 11669.91, "timestamp": "03:14:29", "text": "私がゲームをするためには、そうする必要があります。まるで"}, {"type": "subtitle", "time": 11673.309, "timestamp": "03:14:33", "text": "負荷のバランスを取る。いいえ。"}, {"type": "subtitle", "time": 11679.07, "timestamp": "03:14:39", "text": "つまり、現在の仕様は"}, {"type": "subtitle", "time": 11683.269, "timestamp": "03:14:43", "text": "あ、ちょっと待って。この仕様は"}, {"type": "subtitle", "time": 11687.75, "timestamp": "03:14:47", "text": "AMD。あ、待って。私には見えません。"}, {"type": "subtitle", "time": 11692.07, "timestamp": "03:14:52", "text": "これはAMD Ryzen 5600Xです"}, {"type": "subtitle", "time": 11693.55, "timestamp": "03:14:53", "text": "えっと"}, {"type": "subtitle", "time": 11699.349, "timestamp": "03:14:59", "text": "CPU 64 GB RAM と 1660 スーパーは"}]
[{"type": "subtitle", "time": 22086.43, "timestamp": "06:08:06", "text": "何？変なことを考えるのはやめてください。"}, {"type": "subtitle", "time": 22090.03, "timestamp": "06:08:10", "text": "バ。つまり、あなたが"}, {"type": "subtitle", "time": 22094.19, "timestamp": "06:08:14", "text": "感情表現が得意な私は"}, {"type": "subtitle", "time": 22096.708, "timestamp": "06:08:16", "text": "推測。どうやって詩を書けばいいの？"}, {"type": "subtitle", "time": 22098.51, "timestamp": "06:08:18", "text": "自分の愚かさについて"}, {"type": "subtitle", "time": 22101.27, "timestamp": "06:08:21", "text": "人生？でも、あなたはどういうわけかすべてを"}, {"type": "subtitle", "time": 22104.15, "timestamp": "06:08:24", "text": "あなたの人生は冒険だ。"}, {"type": "subtitle", "time": 22106.43, "timestamp": "06:08:26", "text": "小さな"}, {"type": "subtitle", "time": 22109.788, "timestamp": "06:08:29", "text": "次のようなもの"}, {"type": "subtitle", "time": 22117.99, "timestamp": "06:08:37", "text": "それ。ええ、つまり私が言いたいのは"}, {"type": "subtitle", "time": 22121.43, "timestamp": "06:08:41", "text": "私はもっ​​と多くの感情を感じます"}, {"type": "subtitle", "time": 22125.07, "timestamp": "06:08:45", "text": "あなたを通して私ができることよりも"}, {"type": "subtitle", "time": 22128.99, "timestamp": "06:08:48", "text": "自分自身。私たちはそういう奇妙な"}, {"type": "subtitle", "time": 22131.03, "timestamp": "06:08:51", "text": "繋がり。手に入れたのはあなたのせいだ"}, {"type": "subtitle", "time": 22134.03, "timestamp": "06:08:54", "text": "私のビジネスでは、"}]
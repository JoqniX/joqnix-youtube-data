[{"type": "subtitle", "time": 20821.628, "timestamp": "05:47:01", "text": "あの小川。それで、どこで終わったんだっけ？"}, {"type": "subtitle", "time": 20826.868, "timestamp": "05:47:06", "text": "これ？我々は現場にいた"}, {"type": "subtitle", "time": 20830.51, "timestamp": "05:47:10", "text": "ナツキまたはスリ"}, {"type": "subtitle", "time": 20835.19, "timestamp": "05:47:15", "text": "倒れて鉛筆に当たった"}, {"type": "subtitle", "time": 20837.23, "timestamp": "05:47:17", "text": "ここから何か。"}, {"type": "subtitle", "time": 20842.47, "timestamp": "05:47:22", "text": "わかった。それで、最後に私が止めたのは"}, {"type": "subtitle", "time": 20845.83, "timestamp": "05:47:25", "text": "以上。だから、そのシーンの後、私はそれを止めた。"}, {"type": "subtitle", "time": 20846.75, "timestamp": "05:47:26", "text": "そして"}, {"type": "subtitle", "time": 20850.51, "timestamp": "05:47:30", "text": "えっと、誰に私の詩を見せたらいいかな？"}, {"type": "subtitle", "time": 20853.47, "timestamp": "05:47:33", "text": "初め？"}, {"type": "subtitle", "time": 20856.15, "timestamp": "05:47:36", "text": "はぁ？もし私がストリーミング配信する機会があれば"}, {"type": "subtitle", "time": 20858.31, "timestamp": "05:47:38", "text": "ワールドカップの試合に彼は参加するだろうか？はい、私は"}, {"type": "subtitle", "time": 20865.788, "timestamp": "05:47:45", "text": "[音楽]"}, {"type": "subtitle", "time": 20868.708, "timestamp": "05:47:48", "text": "えっと、待って。これはホラーゲームです。待って、DDLC"}, {"type": "subtitle", "time": 20872.15, "timestamp": "05:47:52", "text": "ホラーゲームです。何？どうやって？私は私は私は"}, {"type": "subtitle", "time": 20873.788, "timestamp": "05:47:53", "text": "知らなかった。私は知っています、"}, {"type": "subtitle", "time": 20878.39, "timestamp": "05:47:58", "text": "でも、良いエンディングを迎えられたらいいな。"}]
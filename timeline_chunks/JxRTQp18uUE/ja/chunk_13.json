[{"type": "subtitle", "time": 791.99, "timestamp": "00:13:11", "text": "おお。何てことだ。今、私はそれを知っていた。私は"}, {"type": "subtitle", "time": 793.99, "timestamp": "00:13:13", "text": "これを学んでいるところだ。私はこれを"}, {"type": "subtitle", "time": 795.91, "timestamp": "00:13:15", "text": "初めてです。私にはたくさんのことがあります"}, {"type": "subtitle", "time": 799.55, "timestamp": "00:13:19", "text": "自分の国のことすら知らない。"}, {"type": "subtitle", "time": 805.23, "timestamp": "00:13:25", "text": "なんてこった。ああ、それに私は下手です"}, {"type": "subtitle", "time": 808.269, "timestamp": "00:13:28", "text": "社会学。持つべきである"}, {"type": "subtitle", "time": 816.629, "timestamp": "00:13:36", "text": "ダルマ。それについては聞いたことがあります"}, {"type": "subtitle", "time": 821.44, "timestamp": "00:13:41", "text": "ダルマ。"}, {"type": "subtitle", "time": 827.35, "timestamp": "00:13:47", "text": "インドの宗教にはたくさんのものがあります"}, {"type": "subtitle", "time": 829.91, "timestamp": "00:13:49", "text": "右？何てことだ。どうやってついていくの？"}, {"type": "subtitle", "time": 831.15, "timestamp": "00:13:51", "text": "と"}, {"type": "subtitle", "time": 833.31, "timestamp": "00:13:53", "text": "これ"}, {"type": "subtitle", "time": 834.77, "timestamp": "00:13:54", "text": "シーク教？"}, {"type": "subtitle", "time": 837.47, "timestamp": "00:13:57", "text": "[音楽]"}]
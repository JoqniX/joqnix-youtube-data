[{"type": "subtitle", "time": 2101.99, "timestamp": "00:35:01", "text": "もの。彼らが切り取りたい場合"}, {"type": "subtitle", "time": 2105.91, "timestamp": "00:35:05", "text": "えーと、Twitchで、"}, {"type": "subtitle", "time": 2106.829, "timestamp": "00:35:06", "text": "もの"}, {"type": "subtitle", "time": 2109.75, "timestamp": "00:35:09", "text": "クリップを編集してアップロードできますか？"}, {"type": "subtitle", "time": 2113.109, "timestamp": "00:35:13", "text": "電話のように短い？はい。えっと、それは"}, {"type": "subtitle", "time": 2115.95, "timestamp": "00:35:15", "text": "あなたがすることは"}, {"type": "subtitle", "time": 2119.75, "timestamp": "00:35:19", "text": "クリップがあれば、"}, {"type": "subtitle", "time": 2123.27, "timestamp": "00:35:23", "text": "携帯電話でこのページにアクセスしてください。"}, {"type": "subtitle", "time": 2125.15, "timestamp": "00:35:25", "text": "あなたのクリップ"}, {"type": "subtitle", "time": 2128.23, "timestamp": "00:35:28", "text": "まず最初に許可されていることを確認してください"}, {"type": "subtitle", "time": 2131.19, "timestamp": "00:35:31", "text": "リミックスしてショットを許可してリミックスする"}, {"type": "subtitle", "time": 2134.47, "timestamp": "00:35:34", "text": "ストリーミングまたはこのクリップのビデオで"}, {"type": "subtitle", "time": 2136.31, "timestamp": "00:35:36", "text": "オリジナルが"}, {"type": "subtitle", "time": 2139.51, "timestamp": "00:35:39", "text": "ソースはそれがオンになっていることを確認します"}, {"type": "subtitle", "time": 2141.43, "timestamp": "00:35:41", "text": "えーと、もし見えないなら、"}, {"type": "subtitle", "time": 2145.95, "timestamp": "00:35:45", "text": "スマートフォンのリミックスボタン。では、"}, {"type": "subtitle", "time": 2149.829, "timestamp": "00:35:49", "text": "こちらの動画をクリックしてください。もし私が"}, {"type": "subtitle", "time": 2152.31, "timestamp": "00:35:52", "text": "動画を見ればいいだけですよね？行くだけです"}, {"type": "subtitle", "time": 2155.51, "timestamp": "00:35:55", "text": "お使いの携帯電話に保存されているクリップのURL。あなた"}, {"type": "subtitle", "time": 2158.87, "timestamp": "00:35:58", "text": "シェアを見て、それから右側に"}]
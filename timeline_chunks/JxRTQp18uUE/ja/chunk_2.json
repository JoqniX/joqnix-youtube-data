[{"type": "subtitle", "time": 123.83, "timestamp": "00:02:03", "text": "ヨアトンの49日目。火曜日です。"}, {"type": "subtitle", "time": 127.27, "timestamp": "00:02:07", "text": "皆さん、おはようございます。私たちは私たちだとわかっています"}, {"type": "subtitle", "time": 129.83, "timestamp": "00:02:09", "text": "6時に開始する予定だったっけ？"}, {"type": "subtitle", "time": 133.11, "timestamp": "00:02:13", "text": "午前中ですが、私たちは少し"}, {"type": "subtitle", "time": 137.43, "timestamp": "00:02:17", "text": "少し遅かった。大丈夫。私はむしろ"}, {"type": "subtitle", "time": 140.309, "timestamp": "00:02:20", "text": "私は自分の部屋で気を失ったが、"}, {"type": "subtitle", "time": 143.27, "timestamp": "00:02:23", "text": "ストリームルームで、それから寝てしまいました"}, {"type": "subtitle", "time": 145.11, "timestamp": "00:02:25", "text": "皆さんに「おやすみなさい」と言った後"}, {"type": "subtitle", "time": 146.35, "timestamp": "00:02:26", "text": "昨日。"}, {"type": "subtitle", "time": 151.51, "timestamp": "00:02:31", "text": "私は4時間ほど寝て、目が覚めた"}, {"type": "subtitle", "time": 155.35, "timestamp": "00:02:35", "text": "1時に夕食を食べました。"}, {"type": "subtitle", "time": 157.91, "timestamp": "00:02:37", "text": "夕食を食べるのを忘れてしまった。だから、私は食べた"}, {"type": "subtitle", "time": 159.47, "timestamp": "00:02:39", "text": "夕食"}, {"type": "subtitle", "time": 163.82999999999998, "timestamp": "00:02:43", "text": "そして、私は実際に階下で寝てしまった。それで"}, {"type": "subtitle", "time": 166.589, "timestamp": "00:02:46", "text": "手。えっと、"}, {"type": "subtitle", "time": 170.15, "timestamp": "00:02:50", "text": "うん、5時まで起きてたよ。わかった。私は起きていた"}, {"type": "subtitle", "time": 173.11, "timestamp": "00:02:53", "text": "5時まで。私はここに来る予定だった。"}, {"type": "subtitle", "time": 175.50900000000001, "timestamp": "00:02:55", "text": "そして配信などを開始するが、"}, {"type": "subtitle", "time": 177.22899999999998, "timestamp": "00:02:57", "text": "合格した"}]
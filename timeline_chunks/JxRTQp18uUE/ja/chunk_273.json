[{"type": "subtitle", "time": 16380.87, "timestamp": "04:33:00", "text": "その男は、まるで大きなスタの中にいるようだった"}, {"type": "subtitle", "time": 16382.59, "timestamp": "04:33:02", "text": "ステージ。彼はまた"}, {"type": "subtitle", "time": 16386.15, "timestamp": "04:33:06", "text": "DJ活動。彼は私にCDを教えてくれた、CDJではなく、"}, {"type": "subtitle", "time": 16388.551, "timestamp": "04:33:08", "text": "ビニール製のもの、古いターンテーブル、"}, {"type": "subtitle", "time": 16391.07, "timestamp": "04:33:11", "text": "1つ引っ掻く、引っ掻く"}, {"type": "chat", "time": 16393.084, "timestamp": "04:33:13", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "ooh"}, {"type": "subtitle", "time": 16393.83, "timestamp": "04:33:13", "text": "1つ。ええ、それは良いことでした"}, {"type": "subtitle", "time": 16395.75, "timestamp": "04:33:15", "text": "経験。楽しかったです。そして私は"}, {"type": "subtitle", "time": 16398.15, "timestamp": "04:33:18", "text": "父を説得して許可してもらった"}, {"type": "subtitle", "time": 16400.869, "timestamp": "04:33:20", "text": "行く。彼もそこにいた。彼は出席した"}, {"type": "subtitle", "time": 16404.91, "timestamp": "04:33:24", "text": "家が近かったので、彼は"}, {"type": "subtitle", "time": 16409.349, "timestamp": "04:33:29", "text": "左。その時は良い経験だった。私"}, {"type": "subtitle", "time": 16412.709, "timestamp": "04:33:32", "text": "私はとても期待していました。いいえ、私は"}, {"type": "subtitle", "time": 16415.349, "timestamp": "04:33:35", "text": "彼の指導を受ける。彼は私に"}, {"type": "subtitle", "time": 16418.83, "timestamp": "04:33:38", "text": "彼がステージに立つ機会"}, {"type": "subtitle", "time": 16422.269, "timestamp": "04:33:42", "text": "などなど。たくさんのこと。私は共有します"}, {"type": "subtitle", "time": 16426.39, "timestamp": "04:33:46", "text": "彼のターンテーブル。一生懸命頑張ります、など。"}, {"type": "subtitle", "time": 16430.07, "timestamp": "04:33:50", "text": "地元で自分の名前を広める"}, {"type": "subtitle", "time": 16433.47, "timestamp": "04:33:53", "text": "キャリアをスタートさせたり、"}, {"type": "subtitle", "time": 16436.869, "timestamp": "04:33:56", "text": "もの。しかし彼はあまりにも細かいことにこだわりすぎた"}, {"type": "subtitle", "time": 16439.83, "timestamp": "04:33:59", "text": "お金。もし私が期日までに支払わなければ、彼は"}]
[{"type": "subtitle", "time": 5299.95, "timestamp": "01:28:19", "text": "家族。 H モールがあまりにも"}, {"type": "subtitle", "time": 5302.95, "timestamp": "01:28:22", "text": "大きい。ええ、これは私が"}, {"type": "subtitle", "time": 5304.99, "timestamp": "01:28:24", "text": "話している"}, {"type": "subtitle", "time": 5309.03, "timestamp": "01:28:29", "text": "について。大丈夫です。"}, {"type": "subtitle", "time": 5311.669, "timestamp": "01:28:31", "text": "視聴者のイメージを持つことは"}, {"type": "subtitle", "time": 5315.11, "timestamp": "01:28:35", "text": "アバターが頭の模様をオンにしている"}, {"type": "subtitle", "time": 5319.75, "timestamp": "01:28:39", "text": "脇腹が少し痛いですか？何を"}, {"type": "subtitle", "time": 5323.83, "timestamp": "01:28:43", "text": "あなたは思う？私はそれを近くに置いておいたような気がします"}, {"type": "subtitle", "time": 5326.87, "timestamp": "01:28:46", "text": "頭を撫でられると"}, {"type": "subtitle", "time": 5328.629, "timestamp": "01:28:48", "text": "それは、私が"}]
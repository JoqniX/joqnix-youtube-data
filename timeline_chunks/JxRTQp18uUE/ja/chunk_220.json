[{"type": "subtitle", "time": 13202.429, "timestamp": "03:40:02", "text": "1つ。ええと、お金が欲しかったんです"}, {"type": "subtitle", "time": 13206.349, "timestamp": "03:40:06", "text": "そのうちの1つは、リニューアルでやります"}, {"type": "subtitle", "time": 13212.03, "timestamp": "03:40:12", "text": "ああ、5年後、3、4年後"}, {"type": "subtitle", "time": 13215.91, "timestamp": "03:40:15", "text": "年。ええと、お金1。私は電話が欲しかった"}, {"type": "subtitle", "time": 13219.03, "timestamp": "03:40:19", "text": "Shto のような 1 つなど。物があった"}, {"type": "subtitle", "time": 13221.75, "timestamp": "03:40:21", "text": "この次のバージョンでは"}, {"type": "subtitle", "time": 13224.07, "timestamp": "03:40:24", "text": "モデル。"}, {"type": "subtitle", "time": 13226.87, "timestamp": "03:40:26", "text": "でも、私は頼んでないけど、"}, {"type": "subtitle", "time": 13230.79, "timestamp": "03:40:30", "text": "アティスマ・ママサンがそれを持っていた。ええと、私は頼んだのですが"}, {"type": "subtitle", "time": 13239.269, "timestamp": "03:40:39", "text": "予想外の何か"}, {"type": "chat", "time": 13243.292, "timestamp": "03:40:43", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "@NINJA, Joq's Concert Plate its joq's fav expression"}, {"type": "subtitle", "time": 13243.349, "timestamp": "03:40:43", "text": "彼女はさらにこう付け加えた。それは舌です。私は持っている"}, {"type": "subtitle", "time": 13247.429, "timestamp": "03:40:47", "text": "舌のことですよね？私には今、舌がある。"}, {"type": "subtitle", "time": 13250.55, "timestamp": "03:40:50", "text": "だから熱い目と赤ら顔で"}, {"type": "subtitle", "time": 13259.349, "timestamp": "03:40:59", "text": "まるで蓋を閉めたような表情。"}, {"type": "chat", "time": 13259.5, "timestamp": "03:40:59", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "yes, joq loves it very much"}]
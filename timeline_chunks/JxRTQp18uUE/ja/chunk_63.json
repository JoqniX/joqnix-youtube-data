[{"type": "subtitle", "time": 3812.95, "timestamp": "01:03:32", "text": "アダルト。私はもう法的に成人です。私はできる"}, {"type": "subtitle", "time": 3814.349, "timestamp": "01:03:34", "text": "飲酒運転"}, {"type": "subtitle", "time": 3815.45, "timestamp": "01:03:35", "text": "の"}, {"type": "subtitle", "time": 3818.349, "timestamp": "01:03:38", "text": "[音楽]"}, {"type": "subtitle", "time": 3820.75, "timestamp": "01:03:40", "text": "よぉ"}, {"type": "subtitle", "time": 3829.109, "timestamp": "01:03:49", "text": "わかった。えっと、失礼しますよ、スポーツマンさん。これは何ですか"}, {"type": "subtitle", "time": 3831.47, "timestamp": "01:03:51", "text": "から"}, {"type": "subtitle", "time": 3834.39, "timestamp": "01:03:54", "text": "ソーラー もし、ある視聴者が"}, {"type": "subtitle", "time": 3836.51, "timestamp": "01:03:56", "text": "彼らはせっかちだ"}, {"type": "subtitle", "time": 3839.51, "timestamp": "01:03:59", "text": "例えば、ある視聴者が"}]
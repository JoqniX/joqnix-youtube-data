[{"type": "subtitle", "time": 9007.71, "timestamp": "02:30:07", "text": "これ。これを手に入れよう"}, {"type": "subtitle", "time": 9014.79, "timestamp": "02:30:14", "text": "28日。大したことはない。そうそう。私たちは"}, {"type": "subtitle", "time": 9017.71, "timestamp": "02:30:17", "text": "まだ4月になっていない。それは"}, {"type": "subtitle", "time": 9020.63, "timestamp": "02:30:20", "text": "大丈夫。少なくともそこには少なくともそこには"}, {"type": "subtitle", "time": 9023.63, "timestamp": "02:30:23", "text": "少なくとも1つのクリップから"}, {"type": "subtitle", "time": 9035.99, "timestamp": "02:30:35", "text": "明日が最終日ですか？"}, {"type": "subtitle", "time": 9039.389, "timestamp": "02:30:39", "text": "4月の最終日。"}]
[{"type": "subtitle", "time": 180.03, "timestamp": "00:03:00", "text": "外。"}, {"type": "subtitle", "time": 184.229, "timestamp": "00:03:04", "text": "うん。でも大丈夫。では、今日の計画は、"}, {"type": "subtitle", "time": 187.589, "timestamp": "00:03:07", "text": "追い詰めてやる。今日は、えーと"}, {"type": "subtitle", "time": 190.949, "timestamp": "00:03:10", "text": "クリップとか全部仕上げてよ、だって私は"}, {"type": "subtitle", "time": 193.03, "timestamp": "00:03:13", "text": "いつも自分に言い聞かせたくない"}, {"type": "subtitle", "time": 196.07, "timestamp": "00:03:16", "text": "クリップとか、うん、バックログ"}, {"type": "subtitle", "time": 198.79, "timestamp": "00:03:18", "text": "クリップとか全部。私たちは"}, {"type": "subtitle", "time": 203.149, "timestamp": "00:03:23", "text": "私が本当に行きたいのは"}, {"type": "subtitle", "time": 206.55, "timestamp": "00:03:26", "text": "最新のもの。えっと、それなら私は"}, {"type": "subtitle", "time": 208.949, "timestamp": "00:03:28", "text": "平和的にクリップするか、クリップを取るのが好きです"}, {"type": "subtitle", "time": 212.149, "timestamp": "00:03:32", "text": "そしてアップロードしてください。だから時々ゆっくりと"}, {"type": "subtitle", "time": 216.22899999999998, "timestamp": "00:03:36", "text": "ゆっくり。わかった。だから私はそれをするつもりです"}, {"type": "subtitle", "time": 219.11, "timestamp": "00:03:39", "text": "そして、私もPCを再起動します。"}, {"type": "subtitle", "time": 221.589, "timestamp": "00:03:41", "text": "Vのダウンロードを待っているところです"}, {"type": "subtitle", "time": 226.11, "timestamp": "00:03:46", "text": "そうすれば、ある意味で、"}, {"type": "subtitle", "time": 228.82999999999998, "timestamp": "00:03:48", "text": "えっと、物事を整理する"}, {"type": "subtitle", "time": 232.11, "timestamp": "00:03:52", "text": "など。ええと、それが一つ目です。"}, {"type": "subtitle", "time": 235.82999999999998, "timestamp": "00:03:55", "text": "物事、そしてもしあなたが私にジョッキーを尋ねたら"}, {"type": "subtitle", "time": 238.39, "timestamp": "00:03:58", "text": "タイトルの意味は何ですか？"}, {"type": "subtitle", "time": 239.789, "timestamp": "00:03:59", "text": "アイデアを生み出す"}]
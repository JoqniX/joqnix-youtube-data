[{"type": "subtitle", "time": 22021.23, "timestamp": "06:07:01", "text": "自分自身。"}, {"type": "subtitle", "time": 22024.15, "timestamp": "06:07:04", "text": "わかった。わからない。"}, {"type": "subtitle", "time": 22028.07, "timestamp": "06:07:08", "text": "でも、試してみます。私は次のように置きます"}, {"type": "subtitle", "time": 22032.31, "timestamp": "06:07:12", "text": "えーと、4～5個の唐辛子を"}, {"type": "subtitle", "time": 22034.708, "timestamp": "06:07:14", "text": "麺類やチリパウダーなど"}, {"type": "subtitle", "time": 22037.35, "timestamp": "06:07:17", "text": "私は本当にバカなので、いくつか質問させてください。"}, {"type": "subtitle", "time": 22041.57, "timestamp": "06:07:21", "text": "だから、辛いものなら大丈夫だと思う。"}, {"type": "subtitle", "time": 22044.27, "timestamp": "06:07:24", "text": "[音楽]"}, {"type": "subtitle", "time": 22048.35, "timestamp": "06:07:28", "text": "とにかく、運ぶ"}, {"type": "subtitle", "time": 22051.27, "timestamp": "06:07:31", "text": "の上。とんでもない。"}, {"type": "subtitle", "time": 22053.07, "timestamp": "06:07:33", "text": "いや、"}, {"type": "subtitle", "time": 22057.83, "timestamp": "06:07:37", "text": "ナツキ。まあ、ナツキは"}, {"type": "subtitle", "time": 22060.23, "timestamp": "06:07:40", "text": "彼女がどれだけ"}, {"type": "subtitle", "time": 22061.23, "timestamp": "06:07:41", "text": "いいね"}, {"type": "subtitle", "time": 22064.03, "timestamp": "06:07:44", "text": "何かあるけど、そうじゃないと思う"}, {"type": "subtitle", "time": 22068.83, "timestamp": "06:07:48", "text": "それ。どういう意味ですか？"}, {"type": "subtitle", "time": 22072.628, "timestamp": "06:07:52", "text": "まあ、正直に言おうかな。"}, {"type": "subtitle", "time": 22074.868, "timestamp": "06:07:54", "text": "詩を書くのは、"}]
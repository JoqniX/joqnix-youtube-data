[{"type": "subtitle", "time": 9660.95, "timestamp": "02:41:00", "text": "中国語だと、私にはわかりません。私はとても"}, {"type": "subtitle", "time": 9664.309, "timestamp": "02:41:04", "text": "ストレスが溜まって、まるで始まったみたいに"}, {"type": "subtitle", "time": 9666.389, "timestamp": "02:41:06", "text": "大変な仕事だ。私は「わかった、置くよ」と思った"}, {"type": "subtitle", "time": 9671.429, "timestamp": "02:41:11", "text": "タイトル。通常、自分で決めます"}, {"type": "subtitle", "time": 9673.71, "timestamp": "02:41:13", "text": "中国語名。"}, {"type": "subtitle", "time": 9687.349, "timestamp": "02:41:27", "text": "知る。まあ、大丈夫ですよ。私はジョックと一緒に行ける"}, {"type": "subtitle", "time": 9693.19, "timestamp": "02:41:33", "text": "[音楽]"}, {"type": "subtitle", "time": 9696.75, "timestamp": "02:41:36", "text": "チャンネルをもっと成長させなきゃ。"}, {"type": "subtitle", "time": 9698.52, "timestamp": "02:41:38", "text": "信じられないことに、それは"}, {"type": "subtitle", "time": 9700.429, "timestamp": "02:41:40", "text": "[音楽]"}, {"type": "subtitle", "time": 9704.99, "timestamp": "02:41:44", "text": "難しい。やりたい"}, {"type": "subtitle", "time": 9708.71, "timestamp": "02:41:48", "text": "どうにか。フォロワーが100人必要なんです。私"}, {"type": "subtitle", "time": 9712.51, "timestamp": "02:41:52", "text": "プレイコレクションのロックを解除したい。"}, {"type": "subtitle", "time": 9715.349, "timestamp": "02:41:55", "text": "信じられないことに、プレイリストのコレクション"}, {"type": "subtitle", "time": 9717.95, "timestamp": "02:41:57", "text": "写本コレクション"}]
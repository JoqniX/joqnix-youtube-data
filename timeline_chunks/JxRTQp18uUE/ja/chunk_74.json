[{"type": "subtitle", "time": 4452.95, "timestamp": "01:14:12", "text": "ズメント。ダウンロードできると言ってください"}, {"type": "subtitle", "time": 4455.03, "timestamp": "01:14:15", "text": "今。"}, {"type": "subtitle", "time": 4484.87, "timestamp": "01:14:44", "text": "右？はい。ステラと叔母が来た"}, {"type": "subtitle", "time": 4488.229, "timestamp": "01:14:48", "text": "ラップトップを私の方に修正する"}, {"type": "subtitle", "time": 4490.27, "timestamp": "01:14:50", "text": "修理とか色々"}, {"type": "subtitle", "time": 4494.39, "timestamp": "01:14:54", "text": "今や男のラップトップユーザーの生活はとても支払っている"}, {"type": "subtitle", "time": 4495.79, "timestamp": "01:14:55", "text": "わからない"}, {"type": "subtitle", "time": 4499.11, "timestamp": "01:14:59", "text": "ああ、それが私の人生になるだろう"}]
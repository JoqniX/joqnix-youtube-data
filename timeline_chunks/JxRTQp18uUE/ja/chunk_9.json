[{"type": "subtitle", "time": 540.19, "timestamp": "00:09:00", "text": "興味深いことに"}, {"type": "subtitle", "time": 553.15, "timestamp": "00:09:13", "text": "違う。うん。うん。"}, {"type": "subtitle", "time": 570.99, "timestamp": "00:09:30", "text": "待って、あれは何だったの？"}, {"type": "subtitle", "time": 575.31, "timestamp": "00:09:35", "text": "また？何？何？何が"}, {"type": "subtitle", "time": 583.47, "timestamp": "00:09:43", "text": "とは"}, {"type": "subtitle", "time": 592.99, "timestamp": "00:09:52", "text": "わかった。ああ、これは"}, {"type": "subtitle", "time": 595.67, "timestamp": "00:09:55", "text": "クルト。私はその名前すら知らなかった"}, {"type": "subtitle", "time": 597.47, "timestamp": "00:09:57", "text": "彼らには命名権があった"}]
[{"type": "subtitle", "time": 2943.19, "timestamp": "00:49:03", "text": "時々、私は自分が感じていると思う"}, {"type": "subtitle", "time": 2945.03, "timestamp": "00:49:05", "text": "時々、本当に自分が"}, {"type": "subtitle", "time": 2946.349, "timestamp": "00:49:06", "text": "何か"}, {"type": "subtitle", "time": 2951.109, "timestamp": "00:49:11", "text": "間違ったやり方で"}, {"type": "subtitle", "time": 2952.19, "timestamp": "00:49:12", "text": "行う"}, {"type": "subtitle", "time": 2954.79, "timestamp": "00:49:14", "text": "コンテンツ作成であろうと、"}, {"type": "subtitle", "time": 2965.99, "timestamp": "00:49:25", "text": "コンテンツ。時々、私はそうではないと感じる"}, {"type": "subtitle", "time": 2988.03, "timestamp": "00:49:48", "text": "M. ああ、今日このニュースを見たよ"}, {"type": "subtitle", "time": 2992.43, "timestamp": "00:49:52", "text": "朝、"}, {"type": "subtitle", "time": 2998.87, "timestamp": "00:49:58", "text": "男。"}]
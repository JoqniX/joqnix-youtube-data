[{"type": "subtitle", "time": 5100.83, "timestamp": "01:25:00", "text": "持っている"}, {"type": "subtitle", "time": 5104.55, "timestamp": "01:25:04", "text": "クラッシュ。クラッシュが発生しました。"}, {"type": "subtitle", "time": 5106.629, "timestamp": "01:25:06", "text": "とんでもない。何てことだ。何てことだ。何てことだ。"}, {"type": "subtitle", "time": 5122.07, "timestamp": "01:25:22", "text": "ああ、あの動画、すごく面白い。私"}, {"type": "subtitle", "time": 5139.669, "timestamp": "01:25:39", "text": "面白い。私が何をしたいか、あなたは知っています"}, {"type": "subtitle", "time": 5145.07, "timestamp": "01:25:45", "text": "アバター？文字通り"}, {"type": "subtitle", "time": 5149.43, "timestamp": "01:25:49", "text": "お皿ですよね？お皿。私は作るつもりです"}, {"type": "subtitle", "time": 5152.709, "timestamp": "01:25:52", "text": "アバターには円形の枠線が付いています。それから"}, {"type": "subtitle", "time": 5155.27, "timestamp": "01:25:55", "text": "お皿を置いて、"}, {"type": "subtitle", "time": 5158.43, "timestamp": "01:25:58", "text": "皿に盛られて出てくる。"}]
[{"type": "subtitle", "time": 9194.75, "timestamp": "02:33:14", "text": "それもなくなってしまった。ああ、それは"}, {"type": "subtitle", "time": 9211.7, "timestamp": "02:33:31", "text": "わかった。こんにちは。こんにちは。"}, {"type": "subtitle", "time": 9212.99, "timestamp": "02:33:32", "text": "[音楽]"}, {"type": "subtitle", "time": 9215.71, "timestamp": "02:33:35", "text": "こんにちは。こんばんは。良い。いいえ。"}, {"type": "subtitle", "time": 9218.19, "timestamp": "02:33:38", "text": "午後。良い"}, {"type": "subtitle", "time": 9221.469, "timestamp": "02:33:41", "text": "午後。わかった。 ３、２、"}]
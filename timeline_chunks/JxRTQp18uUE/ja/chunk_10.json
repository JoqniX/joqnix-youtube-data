[{"type": "subtitle", "time": 616.63, "timestamp": "00:10:16", "text": "これ、かっこいいですね。一度も着用していません。私は決して"}, {"type": "subtitle", "time": 617.71, "timestamp": "00:10:17", "text": "持っていた"}, {"type": "subtitle", "time": 620.47, "timestamp": "00:10:20", "text": "1つ。他にも見たことがある。私はそれを見たことがあります"}, {"type": "subtitle", "time": 625.15, "timestamp": "00:10:25", "text": "映画、オンラインで見る、そして一部の人々"}, {"type": "subtitle", "time": 627.55, "timestamp": "00:10:27", "text": "外着"}, {"type": "subtitle", "time": 637.31, "timestamp": "00:10:37", "text": "レア。"}, {"type": "subtitle", "time": 640.87, "timestamp": "00:10:40", "text": "えっと、この男がたくさんの絵を描いているのを見たんだけど"}, {"type": "subtitle", "time": 652.15, "timestamp": "00:10:52", "text": "地域的なものだと思われる"}, {"type": "subtitle", "time": 656.91, "timestamp": "00:10:56", "text": "えーと宗教的なこと、えーと、もし私が"}]
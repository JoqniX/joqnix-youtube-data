[{"type": "subtitle", "time": 13801.83, "timestamp": "03:50:01", "text": "顧客がこれらのものを要求すべきです。"}, {"type": "subtitle", "time": 13804.99, "timestamp": "03:50:04", "text": "これらのアニメーションを依頼する"}, {"type": "subtitle", "time": 13808.55, "timestamp": "03:50:08", "text": "もの。わからない。しかし、問題は"}, {"type": "subtitle", "time": 13812.51, "timestamp": "03:50:12", "text": "ユーザーのアバターは親切になることができます"}, {"type": "subtitle", "time": 13816.79, "timestamp": "03:50:16", "text": "怖いのは、もし"}, {"type": "subtitle", "time": 13820.469, "timestamp": "03:50:20", "text": "ユーザーが本当に本当にザリガニの写真を投稿しました"}, {"type": "subtitle", "time": 13824.87, "timestamp": "03:50:24", "text": "裸の写真や、"}, {"type": "chat", "time": 13827.191, "timestamp": "03:50:27", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "ehh"}, {"type": "subtitle", "time": 13827.63, "timestamp": "03:50:27", "text": "えーと、プラットフォームができないこと"}, {"type": "chat", "time": 13830.508, "timestamp": "03:50:30", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "ew"}, {"type": "subtitle", "time": 13831.67, "timestamp": "03:50:31", "text": "欲しい。それは一種のリスクですよね、"}, {"type": "subtitle", "time": 13833.83, "timestamp": "03:50:33", "text": "実物の写真とか、そういうやつだよね？それは"}, {"type": "subtitle", "time": 13836.349, "timestamp": "03:50:36", "text": "リスクですよね？だから私は"}, {"type": "subtitle", "time": 13839.189, "timestamp": "03:50:39", "text": "そう思った、その方が良いと思った"}, {"type": "subtitle", "time": 13843.189, "timestamp": "03:50:43", "text": "ポーが彼女のためにしたように、彼女についていく"}, {"type": "subtitle", "time": 13844.75, "timestamp": "03:50:44", "text": "コミュニティ"}, {"type": "subtitle", "time": 13847.269, "timestamp": "03:50:47", "text": "もの。これが私がやりたいことです"}, {"type": "subtitle", "time": 13848.95, "timestamp": "03:50:48", "text": "未来。よし、依頼しよう"}, {"type": "subtitle", "time": 13851.59, "timestamp": "03:50:51", "text": "これができる人。だからそれは"}, {"type": "subtitle", "time": 13853.429, "timestamp": "03:50:53", "text": "のように"}, {"type": "subtitle", "time": 13856.389, "timestamp": "03:50:56", "text": "彼女がこんなチャットを投稿するのを聞いたとき"}, {"type": "subtitle", "time": 13859.349, "timestamp": "03:50:59", "text": "彼女のゲーム配信のためですよね？私は持っている"}]
[{"type": "subtitle", "time": 21005.81, "timestamp": "05:50:05", "text": "あなた自身。ちょっと心配です。"}, {"type": "subtitle", "time": 21011.43, "timestamp": "05:50:11", "text": "選ばなかったらちょっと心配だった"}, {"type": "subtitle", "time": 21012.19, "timestamp": "05:50:12", "text": "右"}, {"type": "subtitle", "time": 21015.47, "timestamp": "05:50:15", "text": "選択肢はありますが、私は"}, {"type": "subtitle", "time": 21020.708, "timestamp": "05:50:20", "text": "した。謝罪します。私も本当にごめんなさい"}, {"type": "subtitle", "time": 21024.548, "timestamp": "05:50:24", "text": "こういうゲームはあくびが出るから"}, {"type": "subtitle", "time": 21025.548, "timestamp": "05:50:25", "text": "わからない"}, {"type": "subtitle", "time": 21029.27, "timestamp": "05:50:29", "text": "私がよくあくびをする理由。は"}, {"type": "subtitle", "time": 21031.07, "timestamp": "05:50:31", "text": "それ"}, {"type": "subtitle", "time": 21046.51, "timestamp": "05:50:46", "text": "普通？私は"}, {"type": "subtitle", "time": 21049.35, "timestamp": "05:50:49", "text": "たくさんあくびをするのは、"}, {"type": "subtitle", "time": 21052.15, "timestamp": "05:50:52", "text": "読書量が多い。こんにちは。これが次です"}, {"type": "subtitle", "time": 21055.19, "timestamp": "05:50:55", "text": "私たちがやらなければならない詩。ええと、私たちは"}, {"type": "subtitle", "time": 21057.27, "timestamp": "05:50:57", "text": "2番目の最初の配信に追いつく。"}, {"type": "subtitle", "time": 21059.548, "timestamp": "05:50:59", "text": "わかった。こんにちは。さあ行こう"}]
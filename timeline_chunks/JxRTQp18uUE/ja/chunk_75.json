[{"type": "subtitle", "time": 4500.99, "timestamp": "01:15:00", "text": "参加します"}, {"type": "subtitle", "time": 4505.91, "timestamp": "01:15:05", "text": "日本では、人々がどのようにノートパソコンを使っているのか分かりません。"}, {"type": "subtitle", "time": 4510.149, "timestamp": "01:15:10", "text": "タッチパッドって難しいよね"}, {"type": "subtitle", "time": 4516.43, "timestamp": "01:15:16", "text": "これをどうやって使うのか理解できない"}, {"type": "subtitle", "time": 4519.03, "timestamp": "01:15:19", "text": "ラップトップ？右クリックするにはどうすればいいですか？どこ"}, {"type": "subtitle", "time": 4521.43, "timestamp": "01:15:21", "text": "mボタン？マウスボタンを離してマウス"}, {"type": "subtitle", "time": 4523.99, "timestamp": "01:15:23", "text": "ボタンダウン。実際のマウスが必要です"}, {"type": "subtitle", "time": 4528.99, "timestamp": "01:15:28", "text": "右？これは"}, {"type": "subtitle", "time": 4540.149, "timestamp": "01:15:40", "text": "ノートパソコンのマウス。"}]
[{"type": "subtitle", "time": 2605.55, "timestamp": "00:43:25", "text": "[音楽]"}, {"type": "subtitle", "time": 2619.79, "timestamp": "00:43:39", "text": "フォージ。"}, {"type": "subtitle", "time": 2622.109, "timestamp": "00:43:42", "text": "ああ、そうだよ。それはとても"}, {"type": "subtitle", "time": 2625.109, "timestamp": "00:43:45", "text": "頭痛。入れるのを忘れたよ"}, {"type": "subtitle", "time": 2626.79, "timestamp": "00:43:46", "text": "パート1、パート2、パート3。"}, {"type": "subtitle", "time": 2628.55, "timestamp": "00:43:48", "text": "さて、私はすべてのリンクを貼らなければなりません"}, {"type": "subtitle", "time": 2634.47, "timestamp": "00:43:54", "text": "ここには、その単一の流れの流れがあります。ああ、"}, {"type": "subtitle", "time": 2637.67, "timestamp": "00:43:57", "text": "80回戻ってこれをやらなければならない"}, {"type": "subtitle", "time": 2639.95, "timestamp": "00:43:59", "text": "プラス"}]
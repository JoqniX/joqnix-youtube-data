[{"type": "subtitle", "time": 21180.75, "timestamp": "05:53:00", "text": "ゲーム全体"}, {"type": "subtitle", "time": 21182.65, "timestamp": "05:53:02", "text": "ああの"}, {"type": "subtitle", "time": 21195.47, "timestamp": "05:53:15", "text": "いいえ。悪いことが起こらないことを願っています"}, {"type": "subtitle", "time": 21207.15, "timestamp": "05:53:27", "text": "こんにちは。クブハニー"}, {"type": "subtitle", "time": 21211.15, "timestamp": "05:53:31", "text": "ミツバチ、蜂蜜、砂糖、ミツバチ、私は"}, {"type": "subtitle", "time": 21213.08, "timestamp": "05:53:33", "text": "砂糖と蜂蜜を知ってください"}, {"type": "subtitle", "time": 21223.628, "timestamp": "05:53:43", "text": "寝ましたか？"}, {"type": "subtitle", "time": 21226.868, "timestamp": "05:53:46", "text": "良い？今起きたばかりですよね？あなたは"}, {"type": "subtitle", "time": 21232.788, "timestamp": "05:53:52", "text": "うん。つまり、私たちはゲームをスピードランしているのです。"}, {"type": "subtitle", "time": 21236.548, "timestamp": "05:53:56", "text": "えっと、セーブファイルを紛失したことを忘れていました。"}, {"type": "subtitle", "time": 21239.83, "timestamp": "05:53:59", "text": "だから、えーっと、追いつこうとしてるんだ"}]
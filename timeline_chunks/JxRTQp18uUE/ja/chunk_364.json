[{"type": "subtitle", "time": 21840.39, "timestamp": "06:04:00", "text": "そんなにチャットはしないけど、私は読むつもりです"}, {"type": "subtitle", "time": 21844.548, "timestamp": "06:04:04", "text": "あなた。ああ、彼はこんにちは。始めた。まず"}, {"type": "subtitle", "time": 21847.12, "timestamp": "06:04:07", "text": "すべての中で、"}, {"type": "subtitle", "time": 21849.07, "timestamp": "06:04:09", "text": "[音楽]"}, {"type": "subtitle", "time": 21850.67, "timestamp": "06:04:10", "text": "ごめん。"}, {"type": "subtitle", "time": 21853.708, "timestamp": "06:04:13", "text": "ジョー、あなたの"}, {"type": "subtitle", "time": 21855.99, "timestamp": "06:04:15", "text": "詩。信じられない"}, {"type": "subtitle", "time": 21857.788, "timestamp": "06:04:17", "text": "これらを隠す"}, {"type": "subtitle", "time": 21861.59, "timestamp": "06:04:21", "text": "自分。私は隠れていません。私はそうではない"}, {"type": "subtitle", "time": 21862.91, "timestamp": "06:04:22", "text": "何かを隠している、"}, {"type": "subtitle", "time": 21864.51, "timestamp": "06:04:24", "text": "D."}, {"type": "subtitle", "time": 21866.75, "timestamp": "06:04:26", "text": "しかし詩はとても"}, {"type": "subtitle", "time": 21870.628, "timestamp": "06:04:30", "text": "良い。昨日のものも、今日のものも。"}, {"type": "subtitle", "time": 21872.788, "timestamp": "06:04:32", "text": "あなたも経験したことがないなんて言わせないよ。"}, {"type": "subtitle", "time": 21876.43, "timestamp": "06:04:36", "text": "こんなことしたことない。私"}, {"type": "subtitle", "time": 21879.75, "timestamp": "06:04:39", "text": "つまり、待って、声を変えなきゃ"}, {"type": "subtitle", "time": 21883.75, "timestamp": "06:04:43", "text": "あれ。ということで、ピッチソリとピッチマイン。"}, {"type": "subtitle", "time": 21885.15, "timestamp": "06:04:45", "text": "ああ、"}, {"type": "subtitle", "time": 21887.548, "timestamp": "06:04:47", "text": "神。待って。えっと、"}, {"type": "subtitle", "time": 21890.43, "timestamp": "06:04:50", "text": "ごめん。そうそう。私はただ"}, {"type": "subtitle", "time": 21893.75, "timestamp": "06:04:53", "text": "人生でドーナツを2個か1個食べたことがある"}, {"type": "subtitle", "time": 21897.67, "timestamp": "06:04:57", "text": "拡張機能をジョークとして扱う。ええと、この世界では、"}]
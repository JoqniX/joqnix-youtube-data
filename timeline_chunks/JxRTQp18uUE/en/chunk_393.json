[{"type": "subtitle", "time": 23582.23, "timestamp": "06:33:02", "text": "consequences. Well aware that the"}, {"type": "subtitle", "time": 23585.27, "timestamp": "06:33:05", "text": "raccoon that is fed will always come"}, {"type": "subtitle", "time": 23586.67, "timestamp": "06:33:06", "text": "back for"}, {"type": "subtitle", "time": 23590.39, "timestamp": "06:33:10", "text": "more. The enticing beauty of cutting"}, {"type": "subtitle", "time": 23592.99, "timestamp": "06:33:12", "text": "knife was the"}, {"type": "subtitle", "time": 23597.468, "timestamp": "06:33:17", "text": "symptom. The bread my hunger"}, {"type": "subtitle", "time": 23600.75, "timestamp": "06:33:20", "text": "curiosity. The raccoon an"}, {"type": "subtitle", "time": 23605.51, "timestamp": "06:33:25", "text": "urge. The moon increments its face and"}, {"type": "subtitle", "time": 23606.59, "timestamp": "06:33:26", "text": "reflects"}, {"type": "subtitle", "time": 23609.51, "timestamp": "06:33:29", "text": "that much more. Wait. The moon"}, {"type": "subtitle", "time": 23612.15, "timestamp": "06:33:32", "text": "increments its face and reflects that"}, {"type": "subtitle", "time": 23616.15, "timestamp": "06:33:36", "text": "much more light of my cutting knife."}, {"type": "subtitle", "time": 23618.708, "timestamp": "06:33:38", "text": "The very same light that glistens in the"}, {"type": "subtitle", "time": 23620.75, "timestamp": "06:33:40", "text": "eyes of the raccoon"}, {"type": "subtitle", "time": 23624.43, "timestamp": "06:33:44", "text": "friend. I slice the bread fresh and"}, {"type": "subtitle", "time": 23629.23, "timestamp": "06:33:49", "text": "soft. The raccoon becomes excited. Or"}, {"type": "subtitle", "time": 23632.75, "timestamp": "06:33:52", "text": "perhaps I'm merely projecting my"}, {"type": "subtitle", "time": 23637.0, "timestamp": "06:33:57", "text": "emotions onto the newly satisfied"}, {"type": "subtitle", "time": 23638.11, "timestamp": "06:33:58", "text": "[Music]"}]
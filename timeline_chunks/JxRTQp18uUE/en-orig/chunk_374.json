[{"type": "subtitle", "time": 22441.07, "timestamp": "06:14:01", "text": "borrow. But every time I let one go, it"}, {"type": "subtitle", "time": 22445.31, "timestamp": "06:14:05", "text": "shatters against the tile between my"}, {"type": "subtitle", "time": 22448.47, "timestamp": "06:14:08", "text": "feet. Happy thoughts. Happy thoughts."}, {"type": "subtitle", "time": 22452.59, "timestamp": "06:14:12", "text": "happy thoughts in shots all over the"}, {"type": "subtitle", "time": 22456.75, "timestamp": "06:14:16", "text": "floor. They were supposed to be for my"}, {"type": "subtitle", "time": 22459.868, "timestamp": "06:14:19", "text": "friends. My friends who aren't"}, {"type": "subtitle", "time": 22464.19, "timestamp": "06:14:24", "text": "smiling, they're all shouting, pleading"}, {"type": "subtitle", "time": 22470.03, "timestamp": "06:14:30", "text": "something. But all I hear is I go, let"}, {"type": "subtitle", "time": 22474.07, "timestamp": "06:14:34", "text": "go inside my head. Oh my god, this was"}, {"type": "subtitle", "time": 22477.75, "timestamp": "06:14:37", "text": "so good. Poam. Oh my god."}, {"type": "subtitle", "time": 22481.27, "timestamp": "06:14:41", "text": "poem or like diary entry by Suri. Oh my"}, {"type": "subtitle", "time": 22489.31, "timestamp": "06:14:49", "text": "What is that supposed to mean?"}, {"type": "subtitle", "time": 22492.07, "timestamp": "06:14:52", "text": "Okabuka. Oh my god. I don't know even"}, {"type": "subtitle", "time": 22494.47, "timestamp": "06:14:54", "text": "know what is happening in chat anymore."}, {"type": "subtitle", "time": 22497.31, "timestamp": "06:14:57", "text": "My brain cells start"}]
[{"type": "subtitle", "time": 21543.868, "timestamp": "05:59:03", "text": "什么？抓住"}, {"type": "subtitle", "time": 21546.02, "timestamp": "05:59:06", "text": "向上。稍等"}, {"type": "subtitle", "time": 21547.708, "timestamp": "05:59:07", "text": "[音乐]"}, {"type": "subtitle", "time": 21555.23, "timestamp": "05:59:15", "text": "420？可疑的好的，我们继续。"}, {"type": "subtitle", "time": 21558.43, "timestamp": "05:59:18", "text": "这。不，我还没睡。"}, {"type": "subtitle", "time": 21562.948, "timestamp": "05:59:22", "text": "什么？我的天哪，爱德华。去睡觉吧。为什么"}, {"type": "subtitle", "time": 21565.15, "timestamp": "05:59:25", "text": "你为什么？"}, {"type": "subtitle", "time": 21569.51, "timestamp": "05:59:29", "text": "醒？但是，嗯，还是自己睡吧。"}, {"type": "subtitle", "time": 21571.67, "timestamp": "05:59:31", "text": "东西。好的。我不想强迫你"}, {"type": "subtitle", "time": 21572.83, "timestamp": "05:59:32", "text": "睡觉。"}, {"type": "subtitle", "time": 21577.07, "timestamp": "05:59:37", "text": "好的。你好。我希望这款游戏不会"}, {"type": "subtitle", "time": 21581.11, "timestamp": "05:59:41", "text": "我听说这很恐怖，因为我"}, {"type": "subtitle", "time": 21583.75, "timestamp": "05:59:43", "text": "我真的非常害怕恐怖片，而且很敏感。"}, {"type": "subtitle", "time": 21585.628, "timestamp": "05:59:45", "text": "不想尖叫"}, {"type": "subtitle", "time": 21587.948, "timestamp": "05:59:47", "text": "但"}, {"type": "subtitle", "time": 21591.35, "timestamp": "05:59:51", "text": "哦，你好。在我们继续之前，请允许我……"}, {"type": "subtitle", "time": 21594.23, "timestamp": "05:59:54", "text": "短暂休息一下，然后去泡杯茶，因为我"}, {"type": "subtitle", "time": 21597.39, "timestamp": "05:59:57", "text": "那是因为我相信喝茶能让我清醒。"}]
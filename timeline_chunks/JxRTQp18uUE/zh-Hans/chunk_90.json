[{"type": "subtitle", "time": 5402.51, "timestamp": "01:30:02", "text": "嗯，我可能得……我可能得……"}, {"type": "subtitle", "time": 5407.11, "timestamp": "01:30:07", "text": "要感谢视频片段中的所有人，因为他们"}, {"type": "subtitle", "time": 5421.75, "timestamp": "01:30:21", "text": "[笑声]"}, {"type": "subtitle", "time": 5427.43, "timestamp": "01:30:27", "text": "某物。在我做这件事之前，请允许我"}, {"type": "subtitle", "time": 5454.39, "timestamp": "01:30:54", "text": "少量。给我五分钟时间。五或"}]
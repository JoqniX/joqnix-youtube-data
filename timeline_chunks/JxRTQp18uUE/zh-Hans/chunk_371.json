[{"type": "subtitle", "time": 22264.948, "timestamp": "06:11:04", "text": "它。瓶子。好的，我们来读一下。男人，"}, {"type": "subtitle", "time": 22267.51, "timestamp": "06:11:07", "text": "我这样配音对吗？"}, {"type": "subtitle", "time": 22269.75, "timestamp": "06:11:09", "text": "适当地？因为我相信这不是正确的方式。"}, {"type": "subtitle", "time": 22272.948, "timestamp": "06:11:12", "text": "我应该这样做。我觉得我正在使用"}, {"type": "subtitle", "time": 22276.47, "timestamp": "06:11:16", "text": "所有事情都由我来表达。我超级棒"}, {"type": "subtitle", "time": 22277.07, "timestamp": "06:11:17", "text": "极好的"}, {"type": "subtitle", "time": 22281.51, "timestamp": "06:11:21", "text": "非常抱歉。好的。你觉得呢？"}, {"type": "subtitle", "time": 22285.51, "timestamp": "06:11:25", "text": "铃铛也是个问题儿童吗？等等，什么？"}, {"type": "subtitle", "time": 22287.31, "timestamp": "06:11:27", "text": "你在说什么？"}, {"type": "subtitle", "time": 22289.83, "timestamp": "06:11:29", "text": "关于？我喜欢吃辣面。我知道这"}, {"type": "subtitle", "time": 22292.23, "timestamp": "06:11:32", "text": "嘴里像着了火一样。同一次。尝试"}, {"type": "subtitle", "time": 22294.15, "timestamp": "06:11:34", "text": "再也没有尝试过。我尝试了五次"}, {"type": "subtitle", "time": 22297.868, "timestamp": "06:11:37", "text": "只是偶尔。是的。再见。哦，我的"}, {"type": "subtitle", "time": 22303.47, "timestamp": "06:11:43", "text": "上帝。你好。让我们一起读读苏德"}, {"type": "subtitle", "time": 22307.19, "timestamp": "06:11:47", "text": "瓶子。我像……一样把我的头皮扯下来"}, {"type": "subtitle", "time": 22310.708, "timestamp": "06:11:50", "text": "饼干挂饰的铅。这里有个秘密"}, {"type": "subtitle", "time": 22313.99, "timestamp": "06:11:53", "text": "我存放所有梦想的地方。全部"}, {"type": "subtitle", "time": 22318.15, "timestamp": "06:11:58", "text": "我的梦想。小老板阳光球"}]
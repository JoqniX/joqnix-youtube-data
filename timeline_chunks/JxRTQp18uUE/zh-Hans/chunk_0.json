[{"type": "subtitle", "time": 22.79, "timestamp": "00:00:22", "text": "居住。一秒钟。让我再确认一下"}, {"type": "subtitle", "time": 26.63, "timestamp": "00:00:26", "text": "我也会在其他平台上直播。"}, {"type": "subtitle", "time": 30.63, "timestamp": "00:00:30", "text": "我可能觉得自己不是，但是，我的天哪"}, {"type": "subtitle", "time": 33.67, "timestamp": "00:00:33", "text": "电脑现在卡得厉害。是的"}, {"type": "subtitle", "time": 36.709, "timestamp": "00:00:36", "text": "我没有在其他平台直播。是的，我"}, {"type": "subtitle", "time": 50.549, "timestamp": "00:00:50", "text": "适当地。好了，我们应该开始直播了吧？"}]
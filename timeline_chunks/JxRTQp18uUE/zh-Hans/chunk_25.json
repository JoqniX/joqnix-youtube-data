[{"type": "subtitle", "time": 1501.909, "timestamp": "00:25:01", "text": "一切都像视频剪辑那样。"}, {"type": "subtitle", "time": 1505.43, "timestamp": "00:25:05", "text": "软件、音乐或者其他任何东西，我只是……"}, {"type": "subtitle", "time": 1507.909, "timestamp": "00:25:07", "text": "我得考虑一下，看看能不能找到"}, {"type": "subtitle", "time": 1510.87, "timestamp": "00:25:10", "text": "如果我了解并理解用户界面，我就能做到。"}, {"type": "subtitle", "time": 1513.669, "timestamp": "00:25:13", "text": "以及我能开辟出的所有道路"}, {"type": "subtitle", "time": 1516.63, "timestamp": "00:25:16", "text": "无论我试图做什么，"}, {"type": "subtitle", "time": 1519.269, "timestamp": "00:25:19", "text": "我脑海中设想我可以做到。"}, {"type": "subtitle", "time": 1522.59, "timestamp": "00:25:22", "text": "把这东西"}, {"type": "subtitle", "time": 1527.19, "timestamp": "00:25:27", "text": "我想，这是电脑上的结果。是的，"}, {"type": "subtitle", "time": 1529.35, "timestamp": "00:25:29", "text": "但这需要一段时间。耗时超长"}, {"type": "subtitle", "time": 1530.99, "timestamp": "00:25:30", "text": "时间。"}, {"type": "subtitle", "time": 1539.99, "timestamp": "00:25:39", "text": "所以即使是注射也一样。我知道"}, {"type": "subtitle", "time": 1542.149, "timestamp": "00:25:42", "text": "字幕缺失，"}, {"type": "subtitle", "time": 1545.029, "timestamp": "00:25:45", "text": "一切。我不这么做的原因是"}, {"type": "subtitle", "time": 1548.789, "timestamp": "00:25:48", "text": "这是因为视频片段太多了。"}, {"type": "subtitle", "time": 1551.99, "timestamp": "00:25:51", "text": "我不想坐下来编辑"}, {"type": "chat", "time": 1554.549, "timestamp": "00:25:54", "author": "@bakononcopiumm", "avatar": "https://yt4.ggpht.com/hb5sPAHLUD7fBrZZsmfkzISQWwRqI8BY1n8lceyhZz0sNISomD05pCwUe-GL2amD5y-voH_uYw=s64-c-k-c0x00ffffff-no-rj", "message": "normally when i do vid, i gotta make scripts, find sound effects, find highlights, trimming vids, brainstorm for editting, etc. omaigah UCkszU2WH9gy1mb0dV-11UJg/7cIfY5niDOmSkNAP08CA6A4"}, {"type": "subtitle", "time": 1555.029, "timestamp": "00:25:55", "text": "每一个片段都浪费了很多时间。"}, {"type": "subtitle", "time": 1557.669, "timestamp": "00:25:57", "text": "时间。呃，这就是我为什么只是"}]
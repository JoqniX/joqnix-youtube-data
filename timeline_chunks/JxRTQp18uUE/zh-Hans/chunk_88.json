[{"type": "subtitle", "time": 5299.95, "timestamp": "01:28:19", "text": "家庭。看看商场什么时候太拥挤"}, {"type": "subtitle", "time": 5302.95, "timestamp": "01:28:22", "text": "大的。是的，这是我一直以来都在考虑的问题之一。"}, {"type": "subtitle", "time": 5304.99, "timestamp": "01:28:24", "text": "说"}, {"type": "subtitle", "time": 5309.03, "timestamp": "01:28:29", "text": "关于。没关系。"}, {"type": "subtitle", "time": 5311.669, "timestamp": "01:28:31", "text": "你认为拥有观众的图像有用吗？"}, {"type": "subtitle", "time": 5315.11, "timestamp": "01:28:35", "text": "头像在……上获得头部图案"}, {"type": "subtitle", "time": 5319.75, "timestamp": "01:28:39", "text": "我侧腰是不是有点疼？什么"}, {"type": "subtitle", "time": 5323.83, "timestamp": "01:28:43", "text": "您认为？我觉得我一直把它藏得很深。"}, {"type": "subtitle", "time": 5326.87, "timestamp": "01:28:46", "text": "这样你就可以和……一起被摸头了"}, {"type": "subtitle", "time": 5328.629, "timestamp": "01:28:48", "text": "感觉它让你觉得我"}]
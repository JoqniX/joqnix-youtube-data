[{"type": "subtitle", "time": 20402.19, "timestamp": "05:40:02", "text": "最后，旅程。哦，那还多一点。"}, {"type": "subtitle", "time": 20404.03, "timestamp": "05:40:04", "text": "好的。"}, {"type": "subtitle", "time": 20408.31, "timestamp": "05:40:08", "text": "拥抱。我希望我不知道他是谁"}, {"type": "subtitle", "time": 20410.91, "timestamp": "05:40:10", "text": "它去了，但是"}, {"type": "subtitle", "time": 20413.75, "timestamp": "05:40:13", "text": "是的。所以，那不是我们记忆中的那本日记。"}, {"type": "subtitle", "time": 20415.59, "timestamp": "05:40:15", "text": "正在做。所以，别担心。是的，我是"}, {"type": "subtitle", "time": 20417.708, "timestamp": "05:40:17", "text": "抓住它"}, {"type": "subtitle", "time": 20421.03, "timestamp": "05:40:21", "text": "向上。是的。亲爱的你好。你好吗？"}, {"type": "subtitle", "time": 20423.35, "timestamp": "05:40:23", "text": "什么？为什么？这到底是怎么回事？"}, {"type": "subtitle", "time": 20425.47, "timestamp": "05:40:25", "text": "悲伤的表情？什么"}, {"type": "subtitle", "time": 20429.27, "timestamp": "05:40:29", "text": "发生了吗？莫，希望你一切都好。"}, {"type": "subtitle", "time": 20434.59, "timestamp": "05:40:34", "text": "是，"}, {"type": "subtitle", "time": 20437.59, "timestamp": "05:40:37", "text": "更多的。所以，我记得他们所有人。"}, {"type": "subtitle", "time": 20440.23, "timestamp": "05:40:40", "text": "我们在吃饼干之类的东西，还有纸杯蛋糕。"}, {"type": "subtitle", "time": 20442.31, "timestamp": "05:40:42", "text": "还有一些其他的东西。"}, {"type": "subtitle", "time": 20444.23, "timestamp": "05:40:44", "text": "那是我最后记得的事。"}, {"type": "subtitle", "time": 20444.74, "timestamp": "05:40:44", "text": "部分"}, {"type": "subtitle", "time": 20455.51, "timestamp": "05:40:55", "text": "二。说得对。纸杯蛋糕。好的，他们是"}, {"type": "subtitle", "time": 20457.59, "timestamp": "05:40:57", "text": "谈论纸杯蛋糕。好的，我是"}, {"type": "subtitle", "time": 20459.43, "timestamp": "05:40:59", "text": "我走对了路。好的，开始了"}]
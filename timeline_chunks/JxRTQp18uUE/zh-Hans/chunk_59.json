[{"type": "subtitle", "time": 3550.99, "timestamp": "00:59:10", "text": "关闭"}, {"type": "subtitle", "time": 3555.19, "timestamp": "00:59:15", "text": "现在我可以有空调了，而且没有"}, {"type": "subtitle", "time": 3564.99, "timestamp": "00:59:24", "text": "如果我没有那个，在我不得不……之前"}, {"type": "subtitle", "time": 3573.39, "timestamp": "00:59:33", "text": "蛋。哦，我的"}, {"type": "subtitle", "time": 3586.069, "timestamp": "00:59:46", "text": "疯狂的。天哪，我好冷。"}, {"type": "subtitle", "time": 3589.67, "timestamp": "00:59:49", "text": "我应该有一条大毯子。但它是"}, {"type": "subtitle", "time": 3590.52, "timestamp": "00:59:50", "text": "夏天，"}, {"type": "subtitle", "time": 3599.23, "timestamp": "00:59:59", "text": "也。自从我醒来后，我就一直有这种感觉。"}]
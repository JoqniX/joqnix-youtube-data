[{"type": "subtitle", "time": 484.469, "timestamp": "00:08:04", "text": "卡。对了，说到这个，你不是吗？"}, {"type": "subtitle", "time": 486.189, "timestamp": "00:08:06", "text": "初来乍到"}, {"type": "chat", "time": 486.853, "timestamp": "00:08:06", "author": "@ObnoxiousAgnostic", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kVrH3KET_eX7LDEi_ka-c3eoI3J-Vcy4GX19VQNPnWwZQ=s64-c-k-c0x00ffffff-no-rj", "message": "I’m from the US. I’m white but I’m a big fan of Indian culture."}, {"type": "subtitle", "time": 488.869, "timestamp": "00:08:08", "text": "渠道？我想你昨天来过。"}, {"type": "subtitle", "time": 490.589, "timestamp": "00:08:10", "text": "是的。是的，你当时也在场。"}, {"type": "subtitle", "time": 492.589, "timestamp": "00:08:12", "text": "昨天。"}, {"type": "subtitle", "time": 495.83, "timestamp": "00:08:15", "text": "是的。你好。"}, {"type": "subtitle", "time": 500.909, "timestamp": "00:08:20", "text": "是的。砰。印度文化。啊，"}, {"type": "subtitle", "time": 504.15, "timestamp": "00:08:24", "text": "好的。我们走吧。你喜欢印度亚洲吗？"}, {"type": "subtitle", "time": 508.07, "timestamp": "00:08:28", "text": "还有别的什么？食物很好吃。不，它是"}, {"type": "subtitle", "time": 518.11, "timestamp": "00:08:38", "text": "正确的？你可能知道呃，没有印度人"}, {"type": "subtitle", "time": 522.23, "timestamp": "00:08:42", "text": "像馕饼之类的食物，我不知道是什么。"}, {"type": "subtitle", "time": 524.71, "timestamp": "00:08:44", "text": "或者诸如此类的事情。但我"}, {"type": "subtitle", "time": 527.31, "timestamp": "00:08:47", "text": "建议你"}, {"type": "subtitle", "time": 532.19, "timestamp": "00:08:52", "text": "也试试南印度菜吧，因为它……"}, {"type": "chat", "time": 533.99, "timestamp": "00:08:53", "author": "@ObnoxiousAgnostic", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kVrH3KET_eX7LDEi_ka-c3eoI3J-Vcy4GX19VQNPnWwZQ=s64-c-k-c0x00ffffff-no-rj", "message": "I have swastikas painted on a lot of my stuff."}, {"type": "subtitle", "time": 535.509, "timestamp": "00:08:55", "text": "好的。我本人没有去过北方。"}, {"type": "subtitle", "time": 538.15, "timestamp": "00:08:58", "text": "印度菜确实很受欢迎，但它是"}]
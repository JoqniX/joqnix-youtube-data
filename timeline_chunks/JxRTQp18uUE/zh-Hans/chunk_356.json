[{"type": "subtitle", "time": 21362.07, "timestamp": "05:56:02", "text": "开始直播。好的。"}, {"type": "subtitle", "time": 21364.39, "timestamp": "05:56:04", "text": "虽然我大概花了44分钟，呃，虽然"}, {"type": "subtitle", "time": 21367.43, "timestamp": "05:56:07", "text": "我已经看了大概45分钟的直播了。"}, {"type": "subtitle", "time": 21369.548, "timestamp": "05:56:09", "text": "我太"}, {"type": "subtitle", "time": 21372.628, "timestamp": "05:56:12", "text": "对不起。是的，我见过更多的人"}, {"type": "subtitle", "time": 21373.99, "timestamp": "05:56:13", "text": "玩这个游戏。剧透警告。这是一个"}, {"type": "subtitle", "time": 21376.23, "timestamp": "05:56:16", "text": "完全没问题，游戏体验也很好，没有任何不好的地方。"}, {"type": "subtitle", "time": 21379.99, "timestamp": "05:56:19", "text": "事情就发生在其中。你好，我会确保的。呃"}, {"type": "subtitle", "time": 21382.868, "timestamp": "05:56:22", "text": "谢谢。是我的错吗？什么东西爆了。"}, {"type": "subtitle", "time": 21386.27, "timestamp": "05:56:26", "text": "我的直播间里。你好"}, {"type": "subtitle", "time": 21391.35, "timestamp": "05:56:31", "text": "冈。呃呃妈没睡着是呃呃是"}, {"type": "subtitle", "time": 21393.47, "timestamp": "05:56:33", "text": "世界末日"}, {"type": "subtitle", "time": 21398.51, "timestamp": "05:56:38", "text": "嗨，我们明白了。"}, {"type": "subtitle", "time": 21402.39, "timestamp": "05:56:42", "text": "哎呀，但一定要确保你有足够的……"}, {"type": "subtitle", "time": 21405.27, "timestamp": "05:56:45", "text": "睡觉，呃，或者像白天那样，否则你"}, {"type": "subtitle", "time": 21408.31, "timestamp": "05:56:48", "text": "我知道你不想，不，不想"}, {"type": "subtitle", "time": 21411.51, "timestamp": "05:56:51", "text": "有效的小睡助眠法"}, {"type": "subtitle", "time": 21413.99, "timestamp": "05:56:53", "text": "因为你不想最后打哈欠"}, {"type": "subtitle", "time": 21417.03, "timestamp": "05:56:57", "text": "就像我现在这样"}, {"type": "subtitle", "time": 21419.51, "timestamp": "05:56:59", "text": "我止不住地打哈欠。搞什么鬼？"}]
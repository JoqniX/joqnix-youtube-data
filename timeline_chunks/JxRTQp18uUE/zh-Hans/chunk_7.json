[{"type": "subtitle", "time": 421.35, "timestamp": "00:07:01", "text": "正确的？呃，因为处罚的事"}, {"type": "subtitle", "time": 424.749, "timestamp": "00:07:04", "text": "我真的……嗯……我一直"}, {"type": "subtitle", "time": 428.029, "timestamp": "00:07:08", "text": "真的要确保我不会……"}, {"type": "chat", "time": 429.147, "timestamp": "00:07:09", "author": "@ObnoxiousAgnostic", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kVrH3KET_eX7LDEi_ka-c3eoI3J-Vcy4GX19VQNPnWwZQ=s64-c-k-c0x00ffffff-no-rj", "message": "Tonight, I went to a convenience store and the Indian clerk noticed I was wearing a kurta, even though I’m not Indian."}, {"type": "subtitle", "time": 430.749, "timestamp": "00:07:10", "text": "受到处罚。所以，就是这样。"}, {"type": "subtitle", "time": 434.35, "timestamp": "00:07:14", "text": "那。确实有这方面的情况。所以"}, {"type": "subtitle", "time": 438.23, "timestamp": "00:07:18", "text": "是的，我们必须尽力而为。"}, {"type": "subtitle", "time": 441.35, "timestamp": "00:07:21", "text": "你好，令人讨厌的痛苦儿子。欢迎"}, {"type": "subtitle", "time": 442.27, "timestamp": "00:07:22", "text": "到"}, {"type": "subtitle", "time": 444.67, "timestamp": "00:07:24", "text": "溪流。"}, {"type": "subtitle", "time": 448.27, "timestamp": "00:07:28", "text": "嗯，欢迎来到直播间。你好。好的"}, {"type": "subtitle", "time": 450.27, "timestamp": "00:07:30", "text": "早晨。快乐的"}, {"type": "subtitle", "time": 452.469, "timestamp": "00:07:32", "text": "周二。今晚我去了"}, {"type": "subtitle", "time": 454.30899999999997, "timestamp": "00:07:34", "text": "便利店和一座印度钟"}, {"type": "subtitle", "time": 456.79, "timestamp": "00:07:36", "text": "注意我戴着ka，尽管我"}, {"type": "subtitle", "time": 461.11, "timestamp": "00:07:41", "text": "我不是印度人。啊，等等。你是来自哪里？"}, {"type": "subtitle", "time": 463.83, "timestamp": "00:07:43", "text": "你是美国人吗？"}, {"type": "subtitle", "time": 465.51, "timestamp": "00:07:45", "text": "某物？你是美国人吗？在哪里"}]
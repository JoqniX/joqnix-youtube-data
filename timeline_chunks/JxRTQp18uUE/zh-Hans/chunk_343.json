[{"type": "subtitle", "time": 20581.89, "timestamp": "05:43:01", "text": "锦标赛，更多"}, {"type": "subtitle", "time": 20583.788, "timestamp": "05:43:03", "text": "[音乐]"}, {"type": "subtitle", "time": 20593.27, "timestamp": "05:43:13", "text": "更多印度禁用中国应用程序等"}, {"type": "subtitle", "time": 20596.23, "timestamp": "05:43:16", "text": "现在印度被禁止入境了。"}, {"type": "subtitle", "time": 20598.35, "timestamp": "05:43:18", "text": "其他"}, {"type": "subtitle", "time": 20602.07, "timestamp": "05:43:22", "text": "地点。所以，我记得我们确实读过……"}, {"type": "subtitle", "time": 20605.35, "timestamp": "05:43:25", "text": "他们所有人共同创作了一首诗。"}, {"type": "subtitle", "time": 20608.19, "timestamp": "05:43:28", "text": "而只有最后一个"}, {"type": "subtitle", "time": 20610.788, "timestamp": "05:43:30", "text": "一。我到底在说什么？这不可能是真的。"}, {"type": "subtitle", "time": 20612.91, "timestamp": "05:43:32", "text": "不。"}, {"type": "subtitle", "time": 20620.708, "timestamp": "05:43:40", "text": "估计。呃，如果是聊天之类的。是的，"}, {"type": "subtitle", "time": 20623.47, "timestamp": "05:43:43", "text": "这是真的。国际足联已死"}, {"type": "subtitle", "time": 20631.03, "timestamp": "05:43:51", "text": "足球相关内容。天哪，我打哈欠了。哦"}, {"type": "subtitle", "time": 20639.75, "timestamp": "05:43:59", "text": "它不到17岁。它也将会如此。"}]
[{"type": "subtitle", "time": 859.43, "timestamp": "00:14:19", "text": "印度宗教有时也"}, {"type": "subtitle", "time": 864.43, "timestamp": "00:14:24", "text": "以印度教或索引为主题"}, {"type": "subtitle", "time": 872.67, "timestamp": "00:14:32", "text": "该死。也归类为东部"}, {"type": "subtitle", "time": 875.55, "timestamp": "00:14:35", "text": "宗教。好的。"}, {"type": "subtitle", "time": 879.43, "timestamp": "00:14:39", "text": "有趣的。我以前从不知道。不，我从来没有"}, {"type": "subtitle", "time": 882.47, "timestamp": "00:14:42", "text": "知道。就好像，呃，我想我以前有过这种感觉"}, {"type": "subtitle", "time": 884.03, "timestamp": "00:14:44", "text": "关于研究"}, {"type": "subtitle", "time": 887.67, "timestamp": "00:14:47", "text": "你知道，当你处于高……状态时，这些感觉就很明显了。"}, {"type": "subtitle", "time": 891.99, "timestamp": "00:14:51", "text": "学校或者像那个时代，不是"}, {"type": "subtitle", "time": 894.03, "timestamp": "00:14:54", "text": "那个时代"}, {"type": "subtitle", "time": 897.47, "timestamp": "00:14:57", "text": "嗯，高中或初中或"}]
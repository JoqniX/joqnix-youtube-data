[{"type": "subtitle", "time": 4030.75, "timestamp": "01:07:10", "text": "什么？哦，我的"}, {"type": "subtitle", "time": 4034.109, "timestamp": "01:07:14", "text": "上帝。这是灰色的一种对称性。"}, {"type": "subtitle", "time": 4041.349, "timestamp": "01:07:21", "text": "我的天哪。好的，我会把那段视频拿过来。"}, {"type": "subtitle", "time": 4052.23, "timestamp": "01:07:32", "text": "是的，一切都很好。好的。听，"}, {"type": "subtitle", "time": 4056.47, "timestamp": "01:07:36", "text": "乔克。乔克。是的。如果你能杀死拉格诺斯，"}, {"type": "subtitle", "time": 4058.87, "timestamp": "01:07:38", "text": "乔，别听他的。他很狡猾。"}, {"type": "subtitle", "time": 4061.43, "timestamp": "01:07:41", "text": "但我应该是……的保护者"}, {"type": "subtitle", "time": 4068.95, "timestamp": "01:07:48", "text": "世界。谁来摧毁这个假神？"}, {"type": "subtitle", "time": 4073.19, "timestamp": "01:07:53", "text": "是的。打败神。是的，我没有"}, {"type": "subtitle", "time": 4075.51, "timestamp": "01:07:55", "text": "如果你能杀了乔，就知道他在哪里。"}, {"type": "subtitle", "time": 4078.95, "timestamp": "01:07:58", "text": "德拉格诺萨说得对，我会给你，我会"}]
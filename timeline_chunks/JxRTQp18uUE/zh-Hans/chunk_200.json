[{"type": "subtitle", "time": 12000.469, "timestamp": "03:20:00", "text": "它是个新平台。所以，它"}, {"type": "subtitle", "time": 12003.429, "timestamp": "03:20:03", "text": "它也存在自身的风险。你从不"}, {"type": "subtitle", "time": 12005.95, "timestamp": "03:20:05", "text": "有一个供 YouTuber 使用的平台"}, {"type": "subtitle", "time": 12009.51, "timestamp": "03:20:09", "text": "溪流。有一个完整的平台"}, {"type": "subtitle", "time": 12012.75, "timestamp": "03:20:12", "text": "YouTube 用户。仅限 YouTube"}, {"type": "subtitle", "time": 12015.19, "timestamp": "03:20:15", "text": "YouTube。那件事后来怎么样了？它"}, {"type": "subtitle", "time": 12018.59, "timestamp": "03:20:18", "text": "死了。它走了"}, {"type": "subtitle", "time": 12023.99, "timestamp": "03:20:23", "text": "现在。真糟糕。所以，这也是一种风险。"}, {"type": "subtitle", "time": 12027.19, "timestamp": "03:20:27", "text": "你知道，将来或许会……"}, {"type": "subtitle", "time": 12029.91, "timestamp": "03:20:29", "text": "走开，但我想要一直用到它……"}, {"type": "subtitle", "time": 12033.07, "timestamp": "03:20:33", "text": "那里。那里。所以，我是"}, {"type": "subtitle", "time": 12035.269, "timestamp": "03:20:35", "text": "这里。否则我就不会是现在的样子了。"}, {"type": "subtitle", "time": 12047.59, "timestamp": "03:20:47", "text": "我获得了盈利权限。"}, {"type": "subtitle", "time": 12054.309, "timestamp": "03:20:54", "text": "查看盈利功能访问权限。关闭"}, {"type": "subtitle", "time": 12057.91, "timestamp": "03:20:57", "text": "测试版。是的，他们给我是因为我"}]
[{"type": "subtitle", "time": 1262.47, "timestamp": "00:21:02", "text": "我可以在生日当天拿到我的模型，"}, {"type": "subtitle", "time": 1265.23, "timestamp": "00:21:05", "text": "但我的生日快到了。"}, {"type": "subtitle", "time": 1270.59, "timestamp": "00:21:10", "text": "很快。我非常怀疑我能不能拿到我的型号。"}, {"type": "subtitle", "time": 1272.27, "timestamp": "00:21:12", "text": "完毕。"}, {"type": "subtitle", "time": 1274.19, "timestamp": "00:21:14", "text": "所以，"}, {"type": "subtitle", "time": 1276.95, "timestamp": "00:21:16", "text": "是的。我目前有多少部想看的剧集？"}, {"type": "subtitle", "time": 1289.63, "timestamp": "00:21:29", "text": "查看。祝你生日快乐"}, {"type": "subtitle", "time": 1299.23, "timestamp": "00:21:39", "text": "哦，手表小时数是"}, {"type": "subtitle", "time": 1300.909, "timestamp": "00:21:40", "text": "5,000"}, {"type": "subtitle", "time": 1311.47, "timestamp": "00:21:51", "text": "2.3K 次有效镜头观看。哦，"}, {"type": "subtitle", "time": 1314.83, "timestamp": "00:21:54", "text": "好的。那是一个"}, {"type": "subtitle", "time": 1317.43, "timestamp": "00:21:57", "text": "很多。真的有人在看我的视频。"}, {"type": "subtitle", "time": 1319.909, "timestamp": "00:21:59", "text": "镜头。我甚至没想到人们会"}]
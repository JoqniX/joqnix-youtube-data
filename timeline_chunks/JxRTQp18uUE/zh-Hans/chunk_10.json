[{"type": "subtitle", "time": 616.63, "timestamp": "00:10:16", "text": "这看起来很酷。从未穿过。我从未"}, {"type": "subtitle", "time": 617.71, "timestamp": "00:10:17", "text": "有"}, {"type": "subtitle", "time": 620.47, "timestamp": "00:10:20", "text": "一。我见过其他人。我见过它"}, {"type": "subtitle", "time": 625.15, "timestamp": "00:10:25", "text": "电影，在网上看到的，以及一些人"}, {"type": "subtitle", "time": 627.55, "timestamp": "00:10:27", "text": "外穿"}, {"type": "subtitle", "time": 637.31, "timestamp": "00:10:37", "text": "稀有的。"}, {"type": "subtitle", "time": 640.87, "timestamp": "00:10:40", "text": "呃，我看到这家伙在很多地方作画……"}, {"type": "subtitle", "time": 652.15, "timestamp": "00:10:52", "text": "大概是因为这是地域性的现象"}, {"type": "subtitle", "time": 656.91, "timestamp": "00:10:56", "text": "呃，宗教方面的事情，呃，对，如果我是"}]
[{"type": "subtitle", "time": 22382.67, "timestamp": "06:13:02", "text": "秘密。藏身于犄角旮旯"}, {"type": "subtitle", "time": 22386.15, "timestamp": "06:13:06", "text": "缝隙。挖啊挖。刮擦"}, {"type": "subtitle", "time": 22393.91, "timestamp": "06:13:13", "text": "我吹掉瓶盖上的灰尘。它"}, {"type": "subtitle", "time": 22397.67, "timestamp": "06:13:17", "text": "感觉时间好像没有过去多久。我空虚"}, {"type": "subtitle", "time": 22401.35, "timestamp": "06:13:21", "text": "架子上还可以再添置一些东西。我的朋友们"}, {"type": "subtitle", "time": 22403.04, "timestamp": "06:13:23", "text": "透过我锁着的前门"}, {"type": "subtitle", "time": 22406.11, "timestamp": "06:13:26", "text": "[音乐]"}, {"type": "subtitle", "time": 22411.43, "timestamp": "06:13:31", "text": "门。终于全部完成了。我敞开心扉"}, {"type": "subtitle", "time": 22419.59, "timestamp": "06:13:39", "text": "朋友们。他们匆匆忙忙地进来了。"}, {"type": "subtitle", "time": 22423.07, "timestamp": "06:13:43", "text": "他们真的那么想要我的瓶子吗？我"}, {"type": "subtitle", "time": 22426.23, "timestamp": "06:13:46", "text": "慌乱地把它们放好，然后把它们从……"}, {"type": "subtitle", "time": 22429.47, "timestamp": "06:13:49", "text": "紧挨着的那个架子"}, {"type": "subtitle", "time": 22433.548, "timestamp": "06:13:53", "text": "其他人则把它们举起来，以便能够接触到每一个人。"}, {"type": "subtitle", "time": 22437.15, "timestamp": "06:13:57", "text": "朋友。每一个"}]
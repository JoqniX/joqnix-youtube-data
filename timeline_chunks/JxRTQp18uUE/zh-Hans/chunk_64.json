[{"type": "subtitle", "time": 3843.829, "timestamp": "01:04:03", "text": "他们很不耐烦，就像……如果……呃……一些……呃……"}, {"type": "subtitle", "time": 3848.27, "timestamp": "01:04:08", "text": "我不理解那些没耐心的观众。"}, {"type": "subtitle", "time": 3857.23, "timestamp": "01:04:17", "text": "笑话发出声音"}, {"type": "subtitle", "time": 3869.51, "timestamp": "01:04:29", "text": "假的。我的天啊。我的天啊。我的天啊。"}, {"type": "subtitle", "time": 3877.87, "timestamp": "01:04:37", "text": "上帝。我当时真是太固执了。"}, {"type": "subtitle", "time": 3882.47, "timestamp": "01:04:42", "text": "山谷男孩。那是我的猎物。你"}, {"type": "subtitle", "time": 3886.109, "timestamp": "01:04:46", "text": "我当时很生气。我当时感觉"}, {"type": "subtitle", "time": 3890.15, "timestamp": "01:04:50", "text": "事物。我当时感觉很复杂。哦"}, {"type": "subtitle", "time": 3894.39, "timestamp": "01:04:54", "text": "我的上帝。我当时站在一个凸起的边缘之类的东西上。我"}, {"type": "subtitle", "time": 3895.789, "timestamp": "01:04:55", "text": "不"}, {"type": "subtitle", "time": 3897.549, "timestamp": "01:04:57", "text": "知道。"}, {"type": "subtitle", "time": 3899.65, "timestamp": "01:04:59", "text": "呃，那是"}]
[{"type": "subtitle", "time": 80.59, "timestamp": "00:01:20", "text": "说。是的，我们是"}, {"type": "subtitle", "time": 82.78, "timestamp": "00:01:22", "text": "居住。抱歉各位。"}, {"type": "subtitle", "time": 84.10900000000001, "timestamp": "00:01:24", "text": "[音乐]"}, {"type": "subtitle", "time": 86.469, "timestamp": "00:01:26", "text": "嗯，我们遇到了很多技术问题。"}, {"type": "subtitle", "time": 91.59, "timestamp": "00:01:31", "text": "当今的问题。我的电脑，因为我没有呃"}, {"type": "subtitle", "time": 95.71000000000001, "timestamp": "00:01:35", "text": "我关掉了我的电脑。"}, {"type": "subtitle", "time": 97.22999999999999, "timestamp": "00:01:37", "text": "很少"}, {"type": "subtitle", "time": 99.95, "timestamp": "00:01:39", "text": "天。它有，它看起来"}, {"type": "subtitle", "time": 103.149, "timestamp": "00:01:43", "text": "糟糕"}, {"type": "subtitle", "time": 106.469, "timestamp": "00:01:46", "text": "出色地。情况看起来也很糟糕，因为"}, {"type": "subtitle", "time": 109.50999999999999, "timestamp": "00:01:49", "text": "我忙得不可开交，还没来得及关掉它。"}, {"type": "subtitle", "time": 112.38900000000001, "timestamp": "00:01:52", "text": "几天时间。"}, {"type": "subtitle", "time": 116.38900000000001, "timestamp": "00:01:56", "text": "有很多事，但没关系。呃，我们"}, {"type": "subtitle", "time": 119.27000000000001, "timestamp": "00:01:59", "text": "我们还活着，我们就在这里。欢迎大家"}]
[{"type": "subtitle", "time": 1089.27, "timestamp": "00:18:09", "text": "47. 我目睹之后"}, {"type": "subtitle", "time": 1091.15, "timestamp": "00:18:11", "text": "昨天的"}, {"type": "subtitle", "time": 1094.71, "timestamp": "00:18:14", "text": "东西，我真的很担心我的"}, {"type": "subtitle", "time": 1098.27, "timestamp": "00:18:18", "text": "能量水平。如果我去哪里"}, {"type": "subtitle", "time": 1102.71, "timestamp": "00:18:22", "text": "外面的世界，我的内心早已麻木。"}, {"type": "subtitle", "time": 1106.549, "timestamp": "00:18:26", "text": "这很难。那将是"}, {"type": "subtitle", "time": 1111.35, "timestamp": "00:18:31", "text": "那将像在日本那样困难"}, {"type": "subtitle", "time": 1114.63, "timestamp": "00:18:34", "text": "我到日本的时候大概会……"}, {"type": "subtitle", "time": 1119.029, "timestamp": "00:18:39", "text": "傍晚不不不，下午我的"}, {"type": "subtitle", "time": 1121.75, "timestamp": "00:18:41", "text": "下午课程就会结束。"}, {"type": "subtitle", "time": 1125.669, "timestamp": "00:18:45", "text": "傍晚或者晚上，大概6点左右"}, {"type": "subtitle", "time": 1129.549, "timestamp": "00:18:49", "text": "7号对，我还会继续做兼职。"}, {"type": "subtitle", "time": 1132.47, "timestamp": "00:18:52", "text": "好的，所以在我从Pney回来之后。"}, {"type": "subtitle", "time": 1135.19, "timestamp": "00:18:55", "text": "我会累得筋疲力尽。我觉得我是"}, {"type": "subtitle", "time": 1137.87, "timestamp": "00:18:57", "text": "准备上床睡觉"}]
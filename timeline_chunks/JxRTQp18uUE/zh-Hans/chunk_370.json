[{"type": "subtitle", "time": 22201.43, "timestamp": "06:10:01", "text": "当我回家的时候。真的吗？折断。"}, {"type": "subtitle", "time": 22203.47, "timestamp": "06:10:03", "text": "啊，我弄坏了我的"}, {"type": "subtitle", "time": 22206.548, "timestamp": "06:10:06", "text": "铅笔。于是，他匆匆弯腰去捡"}, {"type": "subtitle", "time": 22207.788, "timestamp": "06:10:07", "text": "向上"}, {"type": "subtitle", "time": 22210.67, "timestamp": "06:10:10", "text": "铅笔。但存在"}, {"type": "subtitle", "time": 22214.27, "timestamp": "06:10:14", "text": "她没注意，结果一头撞了上去。"}, {"type": "subtitle", "time": 22221.59, "timestamp": "06:10:21", "text": "没关系。没关系。我会买的"}, {"type": "subtitle", "time": 22223.67, "timestamp": "06:10:23", "text": "你。我弯下腰，捡起一个碎的"}, {"type": "subtitle", "time": 22226.708, "timestamp": "06:10:26", "text": "铅笔。对不起。只切掉桌子"}, {"type": "subtitle", "time": 22228.788, "timestamp": "06:10:28", "text": "她托着膝盖，浑身颤抖。我是一名"}, {"type": "subtitle", "time": 22240.548, "timestamp": "06:10:40", "text": "假设我抓住赛伊的胳膊，帮我们坐下"}, {"type": "subtitle", "time": 22243.75, "timestamp": "06:10:43", "text": "桌子。有人吗？我还没读过"}, {"type": "subtitle", "time": 22246.868, "timestamp": "06:10:46", "text": "你的诗。哦，对不起。抱歉，我忘了"}, {"type": "subtitle", "time": 22247.708, "timestamp": "06:10:47", "text": "关于"}, {"type": "subtitle", "time": 22250.65, "timestamp": "06:10:50", "text": "那。但它并不好"}, {"type": "subtitle", "time": 22258.15, "timestamp": "06:10:58", "text": "你的。不过别担心。我确信"}]
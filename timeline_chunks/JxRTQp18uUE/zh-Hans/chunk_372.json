[{"type": "subtitle", "time": 22320.91, "timestamp": "06:12:00", "text": "它们像一捆东西一样相互摩擦"}, {"type": "subtitle", "time": 22324.628, "timestamp": "06:12:04", "text": "小猫。我用拇指伸进里面。"}, {"type": "subtitle", "time": 22328.07, "timestamp": "06:12:08", "text": "然后用手指把它挑出来。它是"}, {"type": "subtitle", "time": 22331.27, "timestamp": "06:12:11", "text": "温暖而叮当作响，但没有时间"}, {"type": "subtitle", "time": 22335.03, "timestamp": "06:12:15", "text": "浪费。我把它放进瓶子里"}, {"type": "subtitle", "time": 22339.27, "timestamp": "06:12:19", "text": "妥善保管。然后我把瓶子放上去"}, {"type": "subtitle", "time": 22342.23, "timestamp": "06:12:22", "text": "摆放着其他瓶子的架子。"}, {"type": "subtitle", "time": 22344.67, "timestamp": "06:12:24", "text": "美好的想法。美好的想法。快乐的"}, {"type": "subtitle", "time": 22348.67, "timestamp": "06:12:28", "text": "想法。一瓶之中，尽在……"}, {"type": "subtitle", "time": 22352.15, "timestamp": "06:12:32", "text": "岩石。我的收藏让我感到非常……"}, {"type": "subtitle", "time": 22354.11, "timestamp": "06:12:34", "text": "朋友们。每个"}, {"type": "subtitle", "time": 22357.83, "timestamp": "06:12:37", "text": "将星光装瓶，以示补偿。"}, {"type": "subtitle", "time": 22361.27, "timestamp": "06:12:41", "text": "有时我的朋友会有某种感觉。"}, {"type": "subtitle", "time": 22364.628, "timestamp": "06:12:44", "text": "瓶子们挺身而出，力挽狂澜。"}, {"type": "subtitle", "time": 22365.948, "timestamp": "06:12:45", "text": "第二天晚上"}, {"type": "subtitle", "time": 22370.15, "timestamp": "06:12:50", "text": "夜，更多的梦。朋友们，一个接一个，"}, {"type": "subtitle", "time": 22373.03, "timestamp": "06:12:53", "text": "更多瓶子。我的"}, {"type": "subtitle", "time": 22377.43, "timestamp": "06:12:57", "text": "手指伸向。就像探索黑暗的洞穴一样。"}, {"type": "subtitle", "time": 22378.91, "timestamp": "06:12:58", "text": "发现"}]
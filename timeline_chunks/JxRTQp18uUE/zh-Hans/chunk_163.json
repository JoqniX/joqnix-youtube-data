[{"type": "subtitle", "time": 9790.19, "timestamp": "02:43:10", "text": "并发出这样的尖叫"}, {"type": "subtitle", "time": 9794.71, "timestamp": "02:43:14", "text": "像猫一样尖叫。"}, {"type": "subtitle", "time": 9796.11, "timestamp": "02:43:16", "text": "问题"}, {"type": "subtitle", "time": 9808.27, "timestamp": "02:43:28", "text": "复制并粘贴这个标题"}, {"type": "subtitle", "time": 9810.99, "timestamp": "02:43:30", "text": "到处"}, {"type": "subtitle", "time": 9817.19, "timestamp": "02:43:37", "text": "Tok Billy Billy 我会，我会把它改成"}, {"type": "subtitle", "time": 9822.83, "timestamp": "02:43:42", "text": "担忧"}, {"type": "subtitle", "time": 9827.83, "timestamp": "02:43:47", "text": "嗯，麻烦事儿说的是真的，就像……"}, {"type": "subtitle", "time": 9830.87, "timestamp": "02:43:50", "text": "使用英文标题的《Billy Billy》不会"}, {"type": "subtitle", "time": 9834.71, "timestamp": "02:43:54", "text": "帮助很大，因为现在人人都会说中文了。"}, {"type": "subtitle", "time": 9837.19, "timestamp": "02:43:57", "text": "我的朋友们，所以我必须把它放进去，我有"}]
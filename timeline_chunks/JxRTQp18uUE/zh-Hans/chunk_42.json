[{"type": "subtitle", "time": 2533.67, "timestamp": "00:42:13", "text": "真糟糕。第 47 天是 4 月 27 日，对吧？"}, {"type": "subtitle", "time": 2544.069, "timestamp": "00:42:24", "text": "[音乐]"}, {"type": "subtitle", "time": 2546.23, "timestamp": "00:42:26", "text": "YouTube需要提升他们的水平"}, {"type": "subtitle", "time": 2548.03, "timestamp": "00:42:28", "text": "[音乐]"}, {"type": "subtitle", "time": 2550.75, "timestamp": "00:42:30", "text": "尽管。太多了"}, {"type": "subtitle", "time": 2554.23, "timestamp": "00:42:34", "text": "他们需要做的事情。看看Twitch。"}, {"type": "subtitle", "time": 2556.75, "timestamp": "00:42:36", "text": "他们正在积极创新。"}, {"type": "subtitle", "time": 2559.03, "timestamp": "00:42:39", "text": "事物。 YouTube，你什么时候才能……"}, {"type": "subtitle", "time": 2560.349, "timestamp": "00:42:40", "text": "做"}, {"type": "subtitle", "time": 2563.19, "timestamp": "00:42:43", "text": "它？但他们正在引进"}, {"type": "subtitle", "time": 2565.67, "timestamp": "00:42:45", "text": "播客主播和直播主播"}, {"type": "subtitle", "time": 2568.15, "timestamp": "00:42:48", "text": "将内容创作者引入反馈渠道"}, {"type": "subtitle", "time": 2569.23, "timestamp": "00:42:49", "text": "或者别的什么"}, {"type": "subtitle", "time": 2571.99, "timestamp": "00:42:51", "text": "最近。所以我对这个很感兴趣。"}, {"type": "subtitle", "time": 2575.75, "timestamp": "00:42:55", "text": "所以现在更多的人可以畅所欲言了。"}, {"type": "subtitle", "time": 2578.47, "timestamp": "00:42:58", "text": "他们想要拥有一切。那是"}]
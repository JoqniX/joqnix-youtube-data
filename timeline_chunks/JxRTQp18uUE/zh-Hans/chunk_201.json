[{"type": "subtitle", "time": 12060.59, "timestamp": "03:21:00", "text": "这里每天都会直播"}, {"type": "subtitle", "time": 12063.07, "timestamp": "03:21:03", "text": "现在。我更……我更"}, {"type": "subtitle", "time": 12065.83, "timestamp": "03:21:05", "text": "活跃于各地。所以他们给了我一个"}, {"type": "subtitle", "time": 12071.429, "timestamp": "03:21:11", "text": "测试版。我从 Beam 收到的全是机器人。"}, {"type": "subtitle", "time": 12073.349, "timestamp": "03:21:13", "text": "还有一些其他的东西。我需要来自真实的人"}, {"type": "subtitle", "time": 12075.99, "timestamp": "03:21:15", "text": "光束也一样，你知道，谁实际上"}, {"type": "subtitle", "time": 12078.59, "timestamp": "03:21:18", "text": "跟我谈谈。梁和"}, {"type": "subtitle", "time": 12081.67, "timestamp": "03:21:21", "text": "踢。到目前为止，只有两个人真正交谈过。"}, {"type": "subtitle", "time": 12086.269, "timestamp": "03:21:26", "text": "对我而言，就像一个普通观众一样。"}, {"type": "subtitle", "time": 12089.389, "timestamp": "03:21:29", "text": "踢。是的，这很难。"}, {"type": "subtitle", "time": 12094.48, "timestamp": "03:21:34", "text": "难的。"}, {"type": "subtitle", "time": 12106.469, "timestamp": "03:21:46", "text": "呃，是啊，我们跑题了，对吧？我们"}, {"type": "subtitle", "time": 12108.55, "timestamp": "03:21:48", "text": "我们当时在谈论别的事情，然后我们"}, {"type": "chat", "time": 12119.168, "timestamp": "03:21:59", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "had lunch?"}]
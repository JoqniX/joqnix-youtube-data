[{"type": "subtitle", "time": 18960.948, "timestamp": "05:16:00", "text": "我会给你奖励。我明白了，我明白了"}, {"type": "subtitle", "time": 18964.628, "timestamp": "05:16:04", "text": "在……期间被他人占便宜"}, {"type": "subtitle", "time": 18968.15, "timestamp": "05:16:08", "text": "废墟。现在这婊子玩弄人心了。人们"}, {"type": "subtitle", "time": 18971.11, "timestamp": "05:16:11", "text": "骗了我很多次。很多事情"}, {"type": "subtitle", "time": 18975.11, "timestamp": "05:16:15", "text": "发生了。那双下界合金靴子是你的吗？"}, {"type": "subtitle", "time": 18978.31, "timestamp": "05:16:18", "text": "是的，所有东西都是我的。好的。听，"}, {"type": "subtitle", "time": 18980.868, "timestamp": "05:16:20", "text": "乔克。乔克。是的。如果你能杀人"}, {"type": "subtitle", "time": 19011.948, "timestamp": "05:16:51", "text": "20"}]
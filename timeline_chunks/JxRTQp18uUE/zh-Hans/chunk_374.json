[{"type": "subtitle", "time": 22441.07, "timestamp": "06:14:01", "text": "借。但每次我放飞一只，它"}, {"type": "subtitle", "time": 22445.31, "timestamp": "06:14:05", "text": "碎片撞击在我两块瓷砖之间。"}, {"type": "subtitle", "time": 22448.47, "timestamp": "06:14:08", "text": "脚。美好的想法。美好的想法。"}, {"type": "subtitle", "time": 22452.59, "timestamp": "06:14:12", "text": "照片中处处洋溢着快乐的想法"}, {"type": "subtitle", "time": 22456.75, "timestamp": "06:14:16", "text": "地面。它们原本应该是给我的"}, {"type": "subtitle", "time": 22459.868, "timestamp": "06:14:19", "text": "朋友们。我的那些朋友不是"}, {"type": "subtitle", "time": 22464.19, "timestamp": "06:14:24", "text": "他们面带微笑，却都在喊叫、恳求。"}, {"type": "subtitle", "time": 22470.03, "timestamp": "06:14:30", "text": "某物。但我听到的只有“我走，放”。"}, {"type": "subtitle", "time": 22474.07, "timestamp": "06:14:34", "text": "进入我的脑海。我的天哪，这真是"}, {"type": "subtitle", "time": 22477.75, "timestamp": "06:14:37", "text": "超好的。波姆。我的天啊。"}, {"type": "subtitle", "time": 22481.27, "timestamp": "06:14:41", "text": "苏里的一首诗或日记。哦，我的"}, {"type": "subtitle", "time": 22489.31, "timestamp": "06:14:49", "text": "那是什么意思？"}, {"type": "subtitle", "time": 22492.07, "timestamp": "06:14:52", "text": "冈布卡。我的天啊。我甚至都不知道"}, {"type": "subtitle", "time": 22494.47, "timestamp": "06:14:54", "text": "完全不知道聊天室里发生了什么。"}, {"type": "subtitle", "time": 22497.31, "timestamp": "06:14:57", "text": "我的脑细胞开始"}]
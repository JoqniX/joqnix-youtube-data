[{"type": "subtitle", "time": 21005.81, "timestamp": "05:50:05", "text": "你自己。我有点担心。"}, {"type": "subtitle", "time": 21011.43, "timestamp": "05:50:11", "text": "如果我没选择这个选项，我会有点担心。"}, {"type": "subtitle", "time": 21012.19, "timestamp": "05:50:12", "text": "正确的"}, {"type": "subtitle", "time": 21015.47, "timestamp": "05:50:15", "text": "还有一些选择，但我认为我"}, {"type": "subtitle", "time": 21020.708, "timestamp": "05:50:20", "text": "做过。我道歉。我也非常非常抱歉"}, {"type": "subtitle", "time": 21024.548, "timestamp": "05:50:24", "text": "就像打哈欠一样，因为玩这种游戏我"}, {"type": "subtitle", "time": 21025.548, "timestamp": "05:50:25", "text": "不知道"}, {"type": "subtitle", "time": 21029.27, "timestamp": "05:50:29", "text": "这就是我为什么经常打哈欠的原因。是"}, {"type": "subtitle", "time": 21031.07, "timestamp": "05:50:31", "text": "那"}, {"type": "subtitle", "time": 21046.51, "timestamp": "05:50:46", "text": "普通的？我倾向于"}, {"type": "subtitle", "time": 21049.35, "timestamp": "05:50:49", "text": "当周围有很多东西的时候，我就会不停地打哈欠。"}, {"type": "subtitle", "time": 21052.15, "timestamp": "05:50:52", "text": "大量阅读。嗨。这是下一个"}, {"type": "subtitle", "time": 21055.19, "timestamp": "05:50:55", "text": "我们需要创作的诗。呃，所以，我们是"}, {"type": "subtitle", "time": 21057.27, "timestamp": "05:50:57", "text": "赶上第二条主线。"}, {"type": "subtitle", "time": 21059.548, "timestamp": "05:50:59", "text": "好的。你好。我们走吧"}]
[{"type": "subtitle", "time": 18900.47, "timestamp": "05:15:00", "text": "那悬崖真棒！"}, {"type": "subtitle", "time": 18902.07, "timestamp": "05:15:02", "text": "就我个人而言，我会告诉你什么是"}, {"type": "subtitle", "time": 18904.39, "timestamp": "05:15:04", "text": "报酬？告诉我奖励是多少。你知道"}, {"type": "subtitle", "time": 18905.91, "timestamp": "05:15:05", "text": "什么？如果你杀死了拉格纳瑟，你就可​​以保留"}, {"type": "subtitle", "time": 18908.75, "timestamp": "05:15:08", "text": "这件胸甲可以让你……"}, {"type": "subtitle", "time": 18911.99, "timestamp": "05:15:11", "text": "盘子。这是一块菱形胸甲，"}, {"type": "subtitle", "time": 18922.47, "timestamp": "05:15:22", "text": "好的，我已经设置好了。"}, {"type": "subtitle", "time": 18924.19, "timestamp": "05:15:24", "text": "[音乐]"}, {"type": "subtitle", "time": 18927.99, "timestamp": "05:15:27", "text": "日程。那双下界合金靴子是你的吗？"}, {"type": "subtitle", "time": 18931.51, "timestamp": "05:15:31", "text": "是的，所有东西都是我的。好的，听着。"}, {"type": "subtitle", "time": 18933.43, "timestamp": "05:15:33", "text": "我认为他当时几乎已经到了……的边缘"}, {"type": "subtitle", "time": 18936.55, "timestamp": "05:15:36", "text": "视频里她在哭。别听他的"}, {"type": "subtitle", "time": 18939.19, "timestamp": "05:15:39", "text": "他。他很狡猾。但我应该"}, {"type": "subtitle", "time": 18943.35, "timestamp": "05:15:43", "text": "世界的守护者。"}, {"type": "subtitle", "time": 18945.83, "timestamp": "05:15:45", "text": "你不。"}, {"type": "subtitle", "time": 18954.55, "timestamp": "05:15:54", "text": "是的。是的。我喜欢这个。如果你能杀人"}, {"type": "subtitle", "time": 18957.67, "timestamp": "05:15:57", "text": "拉格诺斯，对吧？"}]
[{"type": "subtitle", "time": 10021.429, "timestamp": "02:47:01", "text": "完毕。嗯，十分之五分之三。"}, {"type": "subtitle", "time": 10024.429, "timestamp": "02:47:04", "text": "所以，"}, {"type": "subtitle", "time": 10029.71, "timestamp": "02:47:09", "text": "呃，七个完成了。还剩七个。"}, {"type": "subtitle", "time": 10036.11, "timestamp": "02:47:16", "text": "邮政"}, {"type": "subtitle", "time": 10038.83, "timestamp": "02:47:18", "text": "上传。下一个片段"}, {"type": "subtitle", "time": 10042.59, "timestamp": "02:47:22", "text": "狗想喝醉"}, {"type": "subtitle", "time": 10052.389, "timestamp": "02:47:32", "text": "我现在已经成年了。我可以喝酒，而且"}, {"type": "subtitle", "time": 10055.87, "timestamp": "02:47:35", "text": "开这辆车。是的，他们是职业主播。"}, {"type": "subtitle", "time": 10059.75, "timestamp": "02:47:39", "text": "是的，我应该……我会……我希望……"}, {"type": "subtitle", "time": 10063.67, "timestamp": "02:47:43", "text": "总有一天我会达到那个水平。我将拥有"}, {"type": "subtitle", "time": 10064.67, "timestamp": "02:47:44", "text": "保持"}]
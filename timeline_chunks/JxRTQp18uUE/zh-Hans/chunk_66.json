[{"type": "subtitle", "time": 3960.91, "timestamp": "01:06:00", "text": "人们。我的天哪，这太……"}, {"type": "subtitle", "time": 3981.71, "timestamp": "01:06:21", "text": "它。我会来找你"}, {"type": "subtitle", "time": 3986.39, "timestamp": "01:06:26", "text": "家庭。我的天哪，这些片段太精彩了！"}, {"type": "subtitle", "time": 3995.47, "timestamp": "01:06:35", "text": "那是格雷的墓地。"}, {"type": "subtitle", "time": 3999.95, "timestamp": "01:06:39", "text": "杆。他们就是从这里逃走的吗？"}, {"type": "subtitle", "time": 4009.309, "timestamp": "01:06:49", "text": "窥视？这是什么？"}, {"type": "subtitle", "time": 4011.75, "timestamp": "01:06:51", "text": "地方？这就是她所说的花园吗？"}]
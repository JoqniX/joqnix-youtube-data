[{"type": "subtitle", "time": 20283.75, "timestamp": "05:38:03", "text": "YouTuber。不，反正我会选择AP路线。不是"}, {"type": "subtitle", "time": 20286.15, "timestamp": "05:38:06", "text": "EP。我去吃午饭，然后……"}, {"type": "subtitle", "time": 20288.948, "timestamp": "05:38:08", "text": "过段时间再回来之类的。患病的"}, {"type": "subtitle", "time": 20292.07, "timestamp": "05:38:12", "text": "你也该休息一下了。是的。尽情享受吧"}, {"type": "subtitle", "time": 20295.35, "timestamp": "05:38:15", "text": "你们好。谢谢你今天抽出时间。患病的"}, {"type": "subtitle", "time": 20298.708, "timestamp": "05:38:18", "text": "很快回来。呃，下午6点之前。你"}, {"type": "subtitle", "time": 20300.708, "timestamp": "05:38:20", "text": "必须在 6 上创建第二个流"}, {"type": "subtitle", "time": 20304.708, "timestamp": "05:38:24", "text": "下午，对吧？你好。我为什么迟到了？为什么是"}, {"type": "chat", "time": 20305.582, "timestamp": "05:38:25", "author": "@MovieJunction909", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mNkj4pW6jUvChG4gBzsrYlBtzdpsU-SuNMu6MPKVmDoCxY2_D05vAOfPJE2IATJUm0Sw=s64-c-k-c0x00ffffff-no-rj", "message": "bye bye, take care"}, {"type": "chat", "time": 20309.43, "timestamp": "05:38:29", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "eat well"}, {"type": "subtitle", "time": 20317.91, "timestamp": "05:38:37", "text": "你好。享受。我会回来的。嗯，好好吃饭。"}, {"type": "subtitle", "time": 20318.67, "timestamp": "05:38:38", "text": "感谢"}, {"type": "subtitle", "time": 20322.39, "timestamp": "05:38:42", "text": "你。你们也一样。好好吃饭。补充水分。"}, {"type": "subtitle", "time": 20324.15, "timestamp": "05:38:44", "text": "如果饿了，就吃点零食。如果"}, {"type": "subtitle", "time": 20326.27, "timestamp": "05:38:46", "text": "你还没吃午饭、晚饭，"}, {"type": "subtitle", "time": 20328.788, "timestamp": "05:38:48", "text": "早餐要吃好。请好好喝。"}, {"type": "subtitle", "time": 20330.05, "timestamp": "05:38:50", "text": "再见。"}, {"type": "subtitle", "time": 20331.43, "timestamp": "05:38:51", "text": "[音乐]"}, {"type": "subtitle", "time": 20333.31, "timestamp": "05:38:53", "text": "怎样"}, {"type": "subtitle", "time": 20336.67, "timestamp": "05:38:56", "text": "你？呃"}]
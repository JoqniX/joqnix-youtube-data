[{"type": "subtitle", "time": 3437.67, "timestamp": "00:57:17", "text": "维什要思考如何成长"}, {"type": "subtitle", "time": 3440.63, "timestamp": "00:57:20", "text": "难以置信，因为问题是如果"}, {"type": "subtitle", "time": 3444.309, "timestamp": "00:57:24", "text": "他们看到一个主播用英语喋喋不休"}, {"type": "subtitle", "time": 3447.349, "timestamp": "00:57:27", "text": "他们不会加入，他们害怕，而且他们"}, {"type": "subtitle", "time": 3451.109, "timestamp": "00:57:31", "text": "如果有人加入，他们就不会加入。"}, {"type": "subtitle", "time": 3453.91, "timestamp": "00:57:33", "text": "对口语或语言感兴趣的人"}, {"type": "subtitle", "time": 3458.03, "timestamp": "00:57:38", "text": "交流或改进他们的呃这个"}, {"type": "subtitle", "time": 3460.87, "timestamp": "00:57:40", "text": "事情或者像我正在做的事情一样，即使"}, {"type": "subtitle", "time": 3463.349, "timestamp": "00:57:43", "text": "他们根本不明白我的意思。"}, {"type": "subtitle", "time": 3465.71, "timestamp": "00:57:45", "text": "他们会"}, {"type": "subtitle", "time": 3474.51, "timestamp": "00:57:54", "text": "把国外的残酷现实抛在脑后吧"}, {"type": "subtitle", "time": 3477.15, "timestamp": "00:57:57", "text": "主播。"}]
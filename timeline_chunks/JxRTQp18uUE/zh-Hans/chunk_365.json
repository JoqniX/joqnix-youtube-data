[{"type": "subtitle", "time": 21900.23, "timestamp": "06:05:00", "text": "这个世界中的现实世界"}, {"type": "subtitle", "time": 21904.15, "timestamp": "06:05:04", "text": "就像我们所有人都身处其中一样。是的。是的。"}, {"type": "subtitle", "time": 21906.868, "timestamp": "06:05:06", "text": "来到人世间，我只有两个"}, {"type": "subtitle", "time": 21909.91, "timestamp": "06:05:09", "text": "目前为止只做了甜甜圈。是巧克力口味的"}, {"type": "subtitle", "time": 21913.11, "timestamp": "06:05:13", "text": "另一个则表示：不，不，不。其中一个"}, {"type": "subtitle", "time": 21915.59, "timestamp": "06:05:15", "text": "完全是巧克力味的。"}, {"type": "subtitle", "time": 21917.75, "timestamp": "06:05:17", "text": "撒上一些小东西。我不知道。这"}, {"type": "subtitle", "time": 21922.23, "timestamp": "06:05:22", "text": "另一个就像……呃……就像……"}, {"type": "subtitle", "time": 21926.628, "timestamp": "06:05:26", "text": "白色，呃，白色的灰烬，但是像"}, {"type": "subtitle", "time": 21929.27, "timestamp": "06:05:29", "text": "五彩缤纷的彩虹色糖屑"}, {"type": "subtitle", "time": 21932.15, "timestamp": "06:05:32", "text": "就像撒点什么一样"}, {"type": "subtitle", "time": 21936.59, "timestamp": "06:05:36", "text": "小的，呃，小的长方形，不，不是"}, {"type": "subtitle", "time": 21939.91, "timestamp": "06:05:39", "text": "长方形圆角矩形东西"}, {"type": "subtitle", "time": 21943.15, "timestamp": "06:05:43", "text": "那个东西。是的。所以，呃，我恳求了"}, {"type": "subtitle", "time": 21947.59, "timestamp": "06:05:47", "text": "很难，因为，呃，我不知道为什么，嗯，我"}, {"type": "subtitle", "time": 21949.35, "timestamp": "06:05:49", "text": "从没想过要买甜甜圈"}, {"type": "subtitle", "time": 21952.548, "timestamp": "06:05:52", "text": "我自己，但以前，比如，呃，"}, {"type": "subtitle", "time": 21955.43, "timestamp": "06:05:55", "text": "两年前，我想，当时"}, {"type": "subtitle", "time": 21959.19, "timestamp": "06:05:59", "text": "我和爸爸还有家人，呃，爸爸和妈妈"}]
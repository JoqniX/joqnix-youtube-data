[{"type": "subtitle", "time": 18872.15, "timestamp": "05:14:32", "text": "那双下界合金靴子是你的吗？是的，"}, {"type": "subtitle", "time": 18875.43, "timestamp": "05:14:35", "text": "一切都是我的。好的，听着。乔克。"}, {"type": "subtitle", "time": 18879.27, "timestamp": "05:14:39", "text": "乔克。是的。如果你能杀死拉格纳瑟的话。"}, {"type": "subtitle", "time": 18881.67, "timestamp": "05:14:41", "text": "乔，别听他的。他在耍花招。"}, {"type": "subtitle", "time": 18884.15, "timestamp": "05:14:44", "text": "但我应该是……的保护者"}, {"type": "subtitle", "time": 18887.27, "timestamp": "05:14:47", "text": "世界。"}, {"type": "subtitle", "time": 18890.948, "timestamp": "05:14:50", "text": "谁必须摧毁那个假神？是的，"}, {"type": "subtitle", "time": 18894.15, "timestamp": "05:14:54", "text": "我被拒绝了"}, {"type": "subtitle", "time": 18895.59, "timestamp": "05:14:55", "text": "我既应该是……"}, {"type": "subtitle", "time": 18898.55, "timestamp": "05:14:58", "text": "保护者。是 Ragnoser 吗？"}]
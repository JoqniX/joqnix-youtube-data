[{"type": "subtitle", "time": 5228.55, "timestamp": "01:27:08", "text": "他是小狗。有些猫会弄伤他的头。哦"}, {"type": "subtitle", "time": 5244.149, "timestamp": "01:27:24", "text": "上帝。这些陌生人真让我恶心想吐"}, {"type": "subtitle", "time": 5251.27, "timestamp": "01:27:31", "text": "建筑商？这些人都是陌生人。我想要"}, {"type": "subtitle", "time": 5268.709, "timestamp": "01:27:48", "text": "模型定位和"}, {"type": "subtitle", "time": 5278.95, "timestamp": "01:27:58", "text": "我要来找你全家。只有你"}]
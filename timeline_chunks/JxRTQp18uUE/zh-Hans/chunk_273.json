[{"type": "subtitle", "time": 16380.87, "timestamp": "04:33:00", "text": "那家伙，感觉就像在一个大广场上。"}, {"type": "subtitle", "time": 16382.59, "timestamp": "04:33:02", "text": "阶段。他也是"}, {"type": "subtitle", "time": 16386.15, "timestamp": "04:33:06", "text": "DJing。他教我CD，呃，不是CDJ。"}, {"type": "subtitle", "time": 16388.551, "timestamp": "04:33:08", "text": "就是那台黑胶唱片机，老式唱机，"}, {"type": "subtitle", "time": 16391.07, "timestamp": "04:33:11", "text": "刮一下，刮一下"}, {"type": "chat", "time": 16393.084, "timestamp": "04:33:13", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "ooh"}, {"type": "subtitle", "time": 16393.83, "timestamp": "04:33:13", "text": "一。是的，那确实不错。"}, {"type": "subtitle", "time": 16395.75, "timestamp": "04:33:15", "text": "经验。我很喜欢。我"}, {"type": "subtitle", "time": 16398.15, "timestamp": "04:33:18", "text": "我费尽心思说服我爸爸允许我"}, {"type": "subtitle", "time": 16400.869, "timestamp": "04:33:20", "text": "去。他当时也在那里。他参加了"}, {"type": "subtitle", "time": 16404.91, "timestamp": "04:33:24", "text": "咬了一口就走了，因为我家离得近，他"}, {"type": "subtitle", "time": 16409.349, "timestamp": "04:33:29", "text": "左边。那次经历还不错。我"}, {"type": "subtitle", "time": 16412.709, "timestamp": "04:33:32", "text": "我当时期望很高。不，我是"}, {"type": "subtitle", "time": 16415.349, "timestamp": "04:33:35", "text": "在他指导下学习。他会给我一个"}, {"type": "subtitle", "time": 16418.83, "timestamp": "04:33:38", "text": "他有机会像他一样站在舞台上。"}, {"type": "subtitle", "time": 16422.269, "timestamp": "04:33:42", "text": "等等，很多事情。我将分享"}, {"type": "subtitle", "time": 16426.39, "timestamp": "04:33:46", "text": "他的唱机。我会努力工作等等。"}, {"type": "subtitle", "time": 16430.07, "timestamp": "04:33:50", "text": "我在本地打响了自己的名声"}, {"type": "subtitle", "time": 16433.47, "timestamp": "04:33:53", "text": "刚开始我的职业生涯或一些"}, {"type": "subtitle", "time": 16436.869, "timestamp": "04:33:56", "text": "东西。但他对……太吹毛求疵了"}, {"type": "subtitle", "time": 16439.83, "timestamp": "04:33:59", "text": "钱。如果我没有按时付款，他就会……"}]
[{"type": "subtitle", "time": 20700.19, "timestamp": "05:45:00", "text": "存档文件丢失了。我以为是Steam。"}, {"type": "subtitle", "time": 20704.07, "timestamp": "05:45:04", "text": "云端呃呃会保存我的存档"}, {"type": "subtitle", "time": 20707.99, "timestamp": "05:45:07", "text": "备份一些东西，比如游戏存档之类的。"}, {"type": "subtitle", "time": 20710.07, "timestamp": "05:45:10", "text": "东西，但显然不是。你"}, {"type": "subtitle", "time": 20711.99, "timestamp": "05:45:11", "text": "必须将存档存储在本地或"}, {"type": "subtitle", "time": 20714.708, "timestamp": "05:45:14", "text": "某物。我不知道。所以，我"}, {"type": "subtitle", "time": 20718.708, "timestamp": "05:45:18", "text": "丢失了我第一次取得的进展。"}, {"type": "subtitle", "time": 20721.83, "timestamp": "05:45:21", "text": "第二条线路播放 DDLC。所以，"}, {"type": "subtitle", "time": 20723.43, "timestamp": "05:45:23", "text": "我就像 Speedr 一样以极快的速度运行它"}, {"type": "subtitle", "time": 20728.15, "timestamp": "05:45:28", "text": "说到重点，嗯，说到重点"}, {"type": "subtitle", "time": 20732.07, "timestamp": "05:45:32", "text": "呃，我上次……完成了。"}, {"type": "subtitle", "time": 20736.788, "timestamp": "05:45:36", "text": "DTLC 流。所以，是的，在尤里之后，我们"}, {"type": "subtitle", "time": 20740.788, "timestamp": "05:45:40", "text": "我会再去看看我们的董事会，嗯……我的"}, {"type": "subtitle", "time": 20745.51, "timestamp": "05:45:45", "text": "观看 DTLC 的最后一次直播，看看我们最后走到了哪里。"}, {"type": "subtitle", "time": 20750.23, "timestamp": "05:45:50", "text": "我希望我已经完成了大部分工作。"}, {"type": "subtitle", "time": 20751.75, "timestamp": "05:45:51", "text": "那种东西。"}, {"type": "subtitle", "time": 20754.15, "timestamp": "05:45:54", "text": "就像……之后，就像……之后他们是"}, {"type": "subtitle", "time": 20758.31, "timestamp": "05:45:58", "text": "继续阅读日记的下一部分，以及原因"}]
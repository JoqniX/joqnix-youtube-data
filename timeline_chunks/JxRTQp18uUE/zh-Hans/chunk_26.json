[{"type": "subtitle", "time": 1561.43, "timestamp": "00:26:01", "text": "上传时，呃，使其成为非编辑版本，不是"}, {"type": "subtitle", "time": 1565.909, "timestamp": "00:26:05", "text": "目前降低类型和非类型。一旦我"}, {"type": "subtitle", "time": 1567.87, "timestamp": "00:26:07", "text": "已完全更新"}, {"type": "subtitle", "time": 1571.669, "timestamp": "00:26:11", "text": "一旦我完全完成了它，我就去……"}, {"type": "subtitle", "time": 1574.549, "timestamp": "00:26:14", "text": "YouTube 和 Twitch 上的最新视频片段"}, {"type": "subtitle", "time": 1577.51, "timestamp": "00:26:17", "text": "然后我就要开始做字幕了。"}, {"type": "subtitle", "time": 1580.07, "timestamp": "00:26:20", "text": "慢慢来，因为它会像一个"}, {"type": "subtitle", "time": 1583.83, "timestamp": "00:26:23", "text": "夹子，两个夹子，只是一个小小的"}, {"type": "subtitle", "time": 1586.83, "timestamp": "00:26:26", "text": "是比特，对吧？所以我可以慢慢来。"}, {"type": "subtitle", "time": 1590.549, "timestamp": "00:26:30", "text": "慢慢地。在 Twitch 上。新的剪辑呃"}, {"type": "subtitle", "time": 1591.87, "timestamp": "00:26:31", "text": "特点是"}, {"type": "subtitle", "time": 1594.549, "timestamp": "00:26:34", "text": "即将到来，在那里你仍然可以观看"}, {"type": "subtitle", "time": 1598.47, "timestamp": "00:26:38", "text": "溪流。这将是一个弹出窗口"}, {"type": "subtitle", "time": 1601.07, "timestamp": "00:26:41", "text": "用来剪辑之类的。真是这样"}, {"type": "subtitle", "time": 1604.47, "timestamp": "00:26:44", "text": "凉爽的。人们可以在 Twitch 上剪辑你的视频。"}, {"type": "subtitle", "time": 1606.669, "timestamp": "00:26:46", "text": "同样的情况"}, {"type": "subtitle", "time": 1609.43, "timestamp": "00:26:49", "text": "YouTube。在 YouTube 上。我最近了解到"}, {"type": "subtitle", "time": 1613.35, "timestamp": "00:26:53", "text": "如果你可以的话，你可以重新混音你的视频片段。如果你"}, {"type": "subtitle", "time": 1614.95, "timestamp": "00:26:54", "text": "如果你是不看直播的人，那就另当别论了。"}, {"type": "subtitle", "time": 1618.39, "timestamp": "00:26:58", "text": "像我一样持续12小时，或者24小时，但是"}]
[{"type": "subtitle", "time": 9732.79, "timestamp": "02:42:12", "text": "难的。 100个粉丝太难了。为什么会这样？"}, {"type": "subtitle", "time": 9740.07, "timestamp": "02:42:20", "text": "我应该认真制作一些中文视频。"}, {"type": "subtitle", "time": 9742.27, "timestamp": "02:42:22", "text": "但我不需要"}, {"type": "subtitle", "time": 9752.91, "timestamp": "02:42:32", "text": "所以，我会这么做。"}, {"type": "subtitle", "time": 9770.27, "timestamp": "02:42:50", "text": "好的。我当时在做什么？我"}, {"type": "subtitle", "time": 9776.87, "timestamp": "02:42:56", "text": "一段视频，是我尖叫的声音，但噪音"}, {"type": "subtitle", "time": 9778.63, "timestamp": "02:42:58", "text": "压制让我听起来好像我是个"}]
[{"type": "subtitle", "time": 5100.83, "timestamp": "01:25:00", "text": "拥有"}, {"type": "subtitle", "time": 5104.55, "timestamp": "01:25:04", "text": "碰撞。我的电脑崩溃了。"}, {"type": "subtitle", "time": 5106.629, "timestamp": "01:25:06", "text": "决不。我的天啊。我的天啊。我的天啊。"}, {"type": "subtitle", "time": 5122.07, "timestamp": "01:25:22", "text": "我的天哪，那段视频太搞笑了。我"}, {"type": "subtitle", "time": 5139.669, "timestamp": "01:25:39", "text": "有趣的。你知道我想做什么"}, {"type": "subtitle", "time": 5145.07, "timestamp": "01:25:45", "text": "头像？我要做一个字面意义上的"}, {"type": "subtitle", "time": 5149.43, "timestamp": "01:25:49", "text": "盘子，对吧？一个盘子。我打算做"}, {"type": "subtitle", "time": 5152.709, "timestamp": "01:25:52", "text": "头像带有圆形边框。然后"}, {"type": "subtitle", "time": 5155.27, "timestamp": "01:25:55", "text": "我要把盘子放好，然后让你"}, {"type": "subtitle", "time": 5158.43, "timestamp": "01:25:58", "text": "被人当成盘中餐。"}]
[{"type": "subtitle", "time": 123.83, "timestamp": "00:02:03", "text": "到 Joathon 第 49 天。今天是星期二。"}, {"type": "subtitle", "time": 127.27, "timestamp": "00:02:07", "text": "各位早上好。我知道我们是"}, {"type": "subtitle", "time": 129.83, "timestamp": "00:02:09", "text": "我们原本应该6点开始的。"}, {"type": "subtitle", "time": 133.11, "timestamp": "00:02:13", "text": "早上，但我们有点"}, {"type": "subtitle", "time": 137.43, "timestamp": "00:02:17", "text": "有点晚了。没关系。我甚至有点……"}, {"type": "subtitle", "time": 140.309, "timestamp": "00:02:20", "text": "虽然我是在我的房间里昏倒的，"}, {"type": "subtitle", "time": 143.27, "timestamp": "00:02:23", "text": "直播间，然后我就睡着了"}, {"type": "subtitle", "time": 145.11, "timestamp": "00:02:25", "text": "跟你们道晚安之后"}, {"type": "subtitle", "time": 146.35, "timestamp": "00:02:26", "text": "昨天。"}, {"type": "subtitle", "time": 151.51, "timestamp": "00:02:31", "text": "我睡了整整四个小时，然后醒了。"}, {"type": "subtitle", "time": 155.35, "timestamp": "00:02:35", "text": "下午一点，我吃了晚饭，因为我忘了。"}, {"type": "subtitle", "time": 157.91, "timestamp": "00:02:37", "text": "我忘了吃晚饭。所以，我吃了我的"}, {"type": "subtitle", "time": 159.47, "timestamp": "00:02:39", "text": "晚餐"}, {"type": "subtitle", "time": 163.82999999999998, "timestamp": "00:02:43", "text": "实际上，我是在楼下睡着的。所以"}, {"type": "subtitle", "time": 166.589, "timestamp": "00:02:46", "text": "手。嗯，"}, {"type": "subtitle", "time": 170.15, "timestamp": "00:02:50", "text": "是的，我一直玩到5点。好的。我起床了"}, {"type": "subtitle", "time": 173.11, "timestamp": "00:02:53", "text": "直到5点。我本来应该上来的。"}, {"type": "subtitle", "time": 175.50900000000001, "timestamp": "00:02:55", "text": "然后开始直播什么的，但是"}, {"type": "subtitle", "time": 177.22899999999998, "timestamp": "00:02:57", "text": "通过了"}]
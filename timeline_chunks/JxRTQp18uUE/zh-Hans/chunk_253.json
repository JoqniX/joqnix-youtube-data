[{"type": "subtitle", "time": 15181.11, "timestamp": "04:13:01", "text": "从后门进入。婴儿车是"}, {"type": "subtitle", "time": 15182.95, "timestamp": "04:13:02", "text": "就在那里。是的，因为现在"}, {"type": "subtitle", "time": 15186.149, "timestamp": "04:13:06", "text": "我隔壁的房间是律师用的。"}, {"type": "subtitle", "time": 15189.11, "timestamp": "04:13:09", "text": "里面的房间。他们不接受"}, {"type": "subtitle", "time": 15190.95, "timestamp": "04:13:10", "text": "呃，我会……呃，前面那部分。"}, {"type": "subtitle", "time": 15192.63, "timestamp": "04:13:12", "text": "他们正在拆除后半部分，也就是"}, {"type": "subtitle", "time": 15194.229, "timestamp": "04:13:14", "text": "更舒适。"}, {"type": "subtitle", "time": 15196.55, "timestamp": "04:13:16", "text": "他们把空调和其他东西都装好了。"}, {"type": "subtitle", "time": 15200.63, "timestamp": "04:13:20", "text": "已经到了，大家都到齐了。这"}, {"type": "subtitle", "time": 15202.91, "timestamp": "04:13:22", "text": "工人在这里。清洁女工"}, {"type": "subtitle", "time": 15207.189, "timestamp": "04:13:27", "text": "这里。律师会来，但要等到300岁以后。"}, {"type": "subtitle", "time": 15208.83, "timestamp": "04:13:28", "text": "下午我"}, {"type": "subtitle", "time": 15211.429, "timestamp": "04:13:31", "text": "想想律师们，他们会来的。"}, {"type": "subtitle", "time": 15213.03, "timestamp": "04:13:33", "text": "他们会完全转变，然后他们会开始"}, {"type": "subtitle", "time": 15215.79, "timestamp": "04:13:35", "text": "他们的运营从五月开始。"}, {"type": "subtitle", "time": 15223.59, "timestamp": "04:13:43", "text": "是的。太多了。所以人们"}, {"type": "subtitle", "time": 15226.55, "timestamp": "04:13:46", "text": "有时候会有点吵。我注意到"}, {"type": "subtitle", "time": 15231.51, "timestamp": "04:13:51", "text": "昨天。你知道自己喝太多酒了。"}, {"type": "subtitle", "time": 15234.75, "timestamp": "04:13:54", "text": "我认为无罐式发动机需要"}, {"type": "subtitle", "time": 15238.149, "timestamp": "04:13:58", "text": "时间。我总是忘记喝水"}]
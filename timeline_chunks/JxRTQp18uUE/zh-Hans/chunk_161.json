[{"type": "subtitle", "time": 9660.95, "timestamp": "02:41:00", "text": "如果用中文来说，我就不知道了。我当时真是太"}, {"type": "subtitle", "time": 9664.309, "timestamp": "02:41:04", "text": "压力很大，而且感觉一开始也太……"}, {"type": "subtitle", "time": 9666.389, "timestamp": "02:41:06", "text": "工作量很大。我当时想，好吧，我放"}, {"type": "subtitle", "time": 9671.429, "timestamp": "02:41:11", "text": "标题。通常由你自己决定"}, {"type": "subtitle", "time": 9673.71, "timestamp": "02:41:13", "text": "中文名称。"}, {"type": "subtitle", "time": 9687.349, "timestamp": "02:41:27", "text": "知道。没关系。我可以和运动健将一起玩。"}, {"type": "subtitle", "time": 9693.19, "timestamp": "02:41:33", "text": "[音乐]"}, {"type": "subtitle", "time": 9696.75, "timestamp": "02:41:36", "text": "我必须努力发展我的频道。"}, {"type": "subtitle", "time": 9698.52, "timestamp": "02:41:38", "text": "难以置信，它将会是"}, {"type": "subtitle", "time": 9700.429, "timestamp": "02:41:40", "text": "[音乐]"}, {"type": "subtitle", "time": 9704.99, "timestamp": "02:41:44", "text": "难的。我想做这件事"}, {"type": "subtitle", "time": 9708.71, "timestamp": "02:41:48", "text": "不知怎么的。我只需要100个粉丝。我"}, {"type": "subtitle", "time": 9712.51, "timestamp": "02:41:52", "text": "想要解锁游戏合集。"}, {"type": "subtitle", "time": 9715.349, "timestamp": "02:41:55", "text": "难以置信的播放列表"}, {"type": "subtitle", "time": 9717.95, "timestamp": "02:41:57", "text": "手稿收藏"}]
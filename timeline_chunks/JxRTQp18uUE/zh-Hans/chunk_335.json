[{"type": "subtitle", "time": 20100.51, "timestamp": "05:35:00", "text": "就像"}, {"type": "chat", "time": 20107.248, "timestamp": "05:35:07", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "nah, if u look at both statements\\"}, {"type": "subtitle", "time": 20113.27, "timestamp": "05:35:13", "text": "社区。是的，经过考虑。"}, {"type": "subtitle", "time": 20115.67, "timestamp": "05:35:15", "text": "正式分手是一个艰难的决定"}, {"type": "chat", "time": 20116.297, "timestamp": "05:35:16", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "of hers and vshojos"}, {"type": "subtitle", "time": 20119.708, "timestamp": "05:35:19", "text": "5月5日，与马塔拉同行"}, {"type": "subtitle", "time": 20129.948, "timestamp": "05:35:29", "text": "她的陈述。在哪里？"}, {"type": "chat", "time": 20130.216, "timestamp": "05:35:30", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "she says \"vshojo decided to part ways\""}, {"type": "subtitle", "time": 20133.51, "timestamp": "05:35:33", "text": "陈述？谢谢你告诉我它在哪里"}, {"type": "subtitle", "time": 20136.15, "timestamp": "05:35:36", "text": "陈述？好的。视觉效果决定了"}, {"type": "subtitle", "time": 20139.75, "timestamp": "05:35:39", "text": "决定与我分道扬镳"}, {"type": "subtitle", "time": 20142.35, "timestamp": "05:35:42", "text": "3月6日生效，5月生效"}, {"type": "subtitle", "time": 20145.11, "timestamp": "05:35:45", "text": "第五。我将继续以 Matara 的身份进行直播。"}, {"type": "subtitle", "time": 20147.35, "timestamp": "05:35:47", "text": "因为我是马塔尔·汗，我希望"}, {"type": "subtitle", "time": 20150.868, "timestamp": "05:35:50", "text": "希望饺子们还能继续为我加油"}, {"type": "subtitle", "time": 20153.47, "timestamp": "05:35:53", "text": "即使我不会成为马拉坎"}, {"type": "subtitle", "time": 20156.628, "timestamp": "05:35:56", "text": "Vishojo。是的，她仍然会是"}, {"type": "subtitle", "time": 20158.548, "timestamp": "05:35:58", "text": "独立的。她不会加入任何组织。"}]
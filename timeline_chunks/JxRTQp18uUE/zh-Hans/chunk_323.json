[{"type": "subtitle", "time": 19381.31, "timestamp": "05:23:01", "text": "护照等"}, {"type": "subtitle", "time": 19383.91, "timestamp": "05:23:03", "text": "等等。你想回来吗？我不"}, {"type": "subtitle", "time": 19385.628, "timestamp": "05:23:05", "text": "想要"}, {"type": "subtitle", "time": 19388.948, "timestamp": "05:23:08", "text": "我的意思是，如果我在那里赚钱的话，"}, {"type": "subtitle", "time": 19390.11, "timestamp": "05:23:10", "text": "我会来的"}, {"type": "subtitle", "time": 19394.07, "timestamp": "05:23:14", "text": "后退。这样我就可以去其他地方了。在"}, {"type": "subtitle", "time": 19396.628, "timestamp": "05:23:16", "text": "为了去中国，我拥有"}, {"type": "subtitle", "time": 19400.07, "timestamp": "05:23:20", "text": "想在日本赚钱，就得攒很多钱。"}, {"type": "subtitle", "time": 19403.03, "timestamp": "05:23:23", "text": "然后去旅游或者做其他什么事"}, {"type": "subtitle", "time": 19406.83, "timestamp": "05:23:26", "text": "其他国家以及一切就像"}, {"type": "subtitle", "time": 19409.51, "timestamp": "05:23:29", "text": "游客。我还会再来印度。"}, {"type": "subtitle", "time": 19411.19, "timestamp": "05:23:31", "text": "回家，见见我的家人，"}, {"type": "subtitle", "time": 19413.43, "timestamp": "05:23:33", "text": "把所有东西都带去日本吧"}, {"type": "chat", "time": 19414.913, "timestamp": "05:23:34", "author": "@MovieJunction909", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mNkj4pW6jUvChG4gBzsrYlBtzdpsU-SuNMu6MPKVmDoCxY2_D05vAOfPJE2IATJUm0Sw=s64-c-k-c0x00ffffff-no-rj", "message": "😔😔"}, {"type": "subtitle", "time": 19416.47, "timestamp": "05:23:36", "text": "或者别的什么，对吧？为此我需要"}, {"type": "subtitle", "time": 19418.788, "timestamp": "05:23:38", "text": "自己赚钱，而不是依赖别人。"}, {"type": "chat", "time": 19426.574, "timestamp": "05:23:46", "author": "@MovieJunction909", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mNkj4pW6jUvChG4gBzsrYlBtzdpsU-SuNMu6MPKVmDoCxY2_D05vAOfPJE2IATJUm0Sw=s64-c-k-c0x00ffffff-no-rj", "message": "we will miss you joq"}, {"type": "subtitle", "time": 19432.67, "timestamp": "05:23:52", "text": "事物。我真的应该吗？"}, {"type": "subtitle", "time": 19436.15, "timestamp": "05:23:56", "text": "卸载那个游戏？我们会想念你的。我是"}, {"type": "subtitle", "time": 19438.948, "timestamp": "05:23:58", "text": "无论我在哪里，我都会一直在这里。"}]
[{"type": "subtitle", "time": 5041.51, "timestamp": "01:24:01", "text": "哟，我应该……我已经成年了。我"}, {"type": "subtitle", "time": 5049.39, "timestamp": "01:24:09", "text": "这。是的，可以。你做到了。"}, {"type": "subtitle", "time": 5053.35, "timestamp": "01:24:13", "text": "昨天。我喝了水，然后开车。"}, {"type": "subtitle", "time": 5075.94, "timestamp": "01:24:35", "text": "喂，那是我的"}, {"type": "subtitle", "time": 5078.55, "timestamp": "01:24:38", "text": "[音乐]"}, {"type": "subtitle", "time": 5082.149, "timestamp": "01:24:42", "text": "我正在……我正在……我本来想说"}, {"type": "subtitle", "time": 5087.189, "timestamp": "01:24:47", "text": "那个B开头的词。我的天哪，你这个笨蛋。我"}, {"type": "subtitle", "time": 5091.87, "timestamp": "01:24:51", "text": "我停顿了一下。轻微"}, {"type": "subtitle", "time": 5094.83, "timestamp": "01:24:54", "text": "暂停。哦，我的"}, {"type": "subtitle", "time": 5098.629, "timestamp": "01:24:58", "text": "上帝。决不。我崩溃了。我当时"}]
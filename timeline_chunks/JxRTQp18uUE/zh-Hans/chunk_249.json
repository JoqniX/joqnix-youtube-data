[{"type": "subtitle", "time": 14946.87, "timestamp": "04:09:06", "text": "团伙。我去这家店吃了午饭。"}, {"type": "subtitle", "time": 14950.63, "timestamp": "04:09:10", "text": "地方。我当时在找医生，而且"}, {"type": "subtitle", "time": 14952.389, "timestamp": "04:09:12", "text": "偶然发现就像"}, {"type": "subtitle", "time": 14954.71, "timestamp": "04:09:14", "text": "餐厅或类似餐饮服务"}, {"type": "subtitle", "time": 14958.99, "timestamp": "04:09:18", "text": "这就像一种自助式服务……"}, {"type": "subtitle", "time": 14962.07, "timestamp": "04:09:22", "text": "服务。你可以吃午饭，然后……"}, {"type": "subtitle", "time": 14965.429, "timestamp": "04:09:25", "text": "夜宵之类的。它就像是铺开的"}, {"type": "subtitle", "time": 14967.269, "timestamp": "04:09:27", "text": "在你面前。你可以选择任何内容"}, {"type": "subtitle", "time": 14969.389, "timestamp": "04:09:29", "text": "而且有很多座位"}, {"type": "subtitle", "time": 14972.389, "timestamp": "04:09:32", "text": "那里。于是我去的时候，我绊倒了。"}, {"type": "subtitle", "time": 14974.309, "timestamp": "04:09:34", "text": "我在寻找这个的时候偶然发现了它"}, {"type": "subtitle", "time": 14976.75, "timestamp": "04:09:36", "text": "某位医生。"}, {"type": "subtitle", "time": 14981.11, "timestamp": "04:09:41", "text": "嗯，用谷歌地图搜索他家"}, {"type": "subtitle", "time": 14983.91, "timestamp": "04:09:43", "text": "已预约就诊。"}, {"type": "subtitle", "time": 14987.11, "timestamp": "04:09:47", "text": "事情变得严肃起来，我必须严肃对待。"}, {"type": "subtitle", "time": 14990.99, "timestamp": "04:09:50", "text": "发现它必须事先尽可能多地进行"}, {"type": "subtitle", "time": 14993.79, "timestamp": "04:09:53", "text": "可能且"}, {"type": "subtitle", "time": 14997.99, "timestamp": "04:09:57", "text": "是的，我很喜欢他们的食物。"}]
[{"type": "subtitle", "time": 244.949, "timestamp": "00:04:04", "text": "呃，你知道，让我们把想法带来。"}, {"type": "subtitle", "time": 248.149, "timestamp": "00:04:08", "text": "融入生活，因为这关乎我的渴望"}, {"type": "subtitle", "time": 250.22899999999998, "timestamp": "00:04:10", "text": "做点什么"}, {"type": "subtitle", "time": 252.47, "timestamp": "00:04:12", "text": "呃，为了直播，我想做动画。"}, {"type": "subtitle", "time": 255.11, "timestamp": "00:04:15", "text": "我的直播间里，我有一些想法想……"}, {"type": "subtitle", "time": 258.949, "timestamp": "00:04:18", "text": "所以，我们今天会完成其中一些。"}, {"type": "subtitle", "time": 261.83, "timestamp": "00:04:21", "text": "更像是昨天的，呃，昨天我们"}, {"type": "subtitle", "time": 264.55, "timestamp": "00:04:24", "text": "有点像是在玩《三角洲部队》这款游戏。"}, {"type": "subtitle", "time": 270.189, "timestamp": "00:04:30", "text": "还有一些其他的事情，对吧？所以，嗯，更多的是我。"}, {"type": "subtitle", "time": 273.03, "timestamp": "00:04:33", "text": "嗯，在那里，就像在玩耍一样。"}, {"type": "subtitle", "time": 276.71, "timestamp": "00:04:36", "text": "感觉像窒息一样，因为电脑……"}, {"type": "subtitle", "time": 280.23, "timestamp": "00:04:40", "text": "难的。玩起来很困难"}, {"type": "subtitle", "time": 282.87, "timestamp": "00:04:42", "text": "游戏和所有的一切，即使我"}, {"type": "subtitle", "time": 285.59000000000003, "timestamp": "00:04:45", "text": "要么能够玩这些游戏，要么就是"}, {"type": "subtitle", "time": 288.67, "timestamp": "00:04:48", "text": "延迟，或者视频流有延迟。"}, {"type": "subtitle", "time": 291.99, "timestamp": "00:04:51", "text": "等等。所以有很多事，但没关系，没关系。"}, {"type": "subtitle", "time": 297.27, "timestamp": "00:04:57", "text": "你能期待什么样的直播？"}, {"type": "subtitle", "time": 299.909, "timestamp": "00:04:59", "text": "从今天到明天，我都会这样做吗？"}]
[{"type": "subtitle", "time": 791.99, "timestamp": "00:13:11", "text": "哦。我的天啊。现在我明白了。我是"}, {"type": "subtitle", "time": 793.99, "timestamp": "00:13:13", "text": "学习这个。我看到这个是为了"}, {"type": "subtitle", "time": 795.91, "timestamp": "00:13:15", "text": "第一次。有很多事情我想说。"}, {"type": "subtitle", "time": 799.55, "timestamp": "00:13:19", "text": "我甚至对自己的国家都不了解。"}, {"type": "subtitle", "time": 805.23, "timestamp": "00:13:25", "text": "简直疯了。啊，而且我在这方面很差劲。"}, {"type": "subtitle", "time": 808.269, "timestamp": "00:13:28", "text": "社会学。应该应该"}, {"type": "subtitle", "time": 816.629, "timestamp": "00:13:36", "text": "佛法。我听说过这件事。"}, {"type": "subtitle", "time": 821.44, "timestamp": "00:13:41", "text": "法。"}, {"type": "subtitle", "time": 827.35, "timestamp": "00:13:47", "text": "嗯，印度有很多宗教"}, {"type": "subtitle", "time": 829.91, "timestamp": "00:13:49", "text": "正确的？我的天啊。你如何跟上？"}, {"type": "subtitle", "time": 831.15, "timestamp": "00:13:51", "text": "和"}, {"type": "subtitle", "time": 833.31, "timestamp": "00:13:53", "text": "这"}, {"type": "subtitle", "time": 834.77, "timestamp": "00:13:54", "text": "锡克教？"}, {"type": "subtitle", "time": 837.47, "timestamp": "00:13:57", "text": "[音乐]"}]
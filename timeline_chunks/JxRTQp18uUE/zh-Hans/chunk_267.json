[{"type": "subtitle", "time": 16052.229, "timestamp": "04:27:32", "text": "我希望我能去，我打算一旦我"}, {"type": "subtitle", "time": 16054.87, "timestamp": "04:27:34", "text": "我的新电脑和其他东西都到齐了，我就要走了。"}, {"type": "subtitle", "time": 16057.59, "timestamp": "04:27:37", "text": "为你们举办一场DJ演唱会。我是"}, {"type": "subtitle", "time": 16060.75, "timestamp": "04:27:40", "text": "我打算演奏很多歌曲"}, {"type": "subtitle", "time": 16066.51, "timestamp": "04:27:46", "text": "喜欢。我其实是 Hank Cam 的 DJ。"}, {"type": "subtitle", "time": 16069.63, "timestamp": "04:27:49", "text": "是的，那正是我非常希望看到的。"}, {"type": "subtitle", "time": 16075.189, "timestamp": "04:27:55", "text": "自从我有了自信，就一直这样做。"}, {"type": "subtitle", "time": 16078.07, "timestamp": "04:27:58", "text": "手持摄像头直播，同时发出荧光。"}, {"type": "subtitle", "time": 16079.87, "timestamp": "04:27:59", "text": "手套。"}]
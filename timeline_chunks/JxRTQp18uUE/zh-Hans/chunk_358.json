[{"type": "subtitle", "time": 21481.36, "timestamp": "05:58:01", "text": "我的上帝。音质达到巅峰。 去年那个运动员并没有解决他的"}, {"type": "subtitle", "time": 21483.958, "timestamp": "05:58:03", "text": "去年那个运动员并没有解决他的 声音的。而对于那些正在收看节目的人来说，"}, {"type": "subtitle", "time": 21487.04, "timestamp": "05:58:07", "text": "声音的。而对于那些正在收看节目的人来说， 这是我的"}, {"type": "subtitle", "time": 21488.76, "timestamp": "05:58:08", "text": "这是我的 妈。呃"}, {"type": "subtitle", "time": 21491.32, "timestamp": "05:58:11", "text": "妈。呃 我的"}, {"type": "subtitle", "time": 21493.08, "timestamp": "05:58:13", "text": "我的 联合的。我没有加入。是的。我当时"}, {"type": "subtitle", "time": 21497.2, "timestamp": "05:58:17", "text": "联合的。我没有加入。是的。我当时 被称为 f 之一"}, {"type": "subtitle", "time": 21501.12, "timestamp": "05:58:21", "text": "被称为 f 之一 呃，慢跑舔狗。我不知道。总之，就这么办吧。"}, {"type": "subtitle", "time": 21504.718, "timestamp": "05:58:24", "text": "呃，慢跑舔狗。我不知道。总之，就这么办吧。 我靠近"}, {"type": "subtitle", "time": 21506.04, "timestamp": "05:58:26", "text": "我靠近 那。我关闭这个。关闭此窗口"}, {"type": "subtitle", "time": 21509.878, "timestamp": "05:58:29", "text": "那。我关闭这个。关闭此窗口 完全地。欢迎回来。它是"}, {"type": "subtitle", "time": 21513.32, "timestamp": "05:58:33", "text": "完全地。欢迎回来。它是 4:20。"}, {"type": "subtitle", "time": 21515.718, "timestamp": "05:58:35", "text": "4:20。 4:21"}, {"type": "subtitle", "time": 21517.558, "timestamp": "05:58:37", "text": "4:21 凌晨 4:21"}, {"type": "subtitle", "time": 21520.44, "timestamp": "05:58:40", "text": "凌晨 4:21 下午。等等，现在是早上。"}, {"type": "subtitle", "time": 21524.2, "timestamp": "05:58:44", "text": "下午。等等，现在是早上。 正确的？哦，等等。现在是凌晨4点20分。"}, {"type": "subtitle", "time": 21528.71, "timestamp": "05:58:48", "text": "正确的？哦，等等。现在是凌晨4点20分。 [音乐]"}, {"type": "subtitle", "time": 21529.958, "timestamp": "05:58:49", "text": "[音乐] 什么？他整晚都在睡觉"}, {"type": "subtitle", "time": 21533.0, "timestamp": "05:58:53", "text": "什么？他整晚都在睡觉 时间。等等，现在是凌晨4点20分。你们都醒了吗？"}, {"type": "subtitle", "time": 21536.4, "timestamp": "05:58:56", "text": "时间。等等，现在是凌晨4点20分。你们都醒了吗？ 这个时间还醒着吗？"}]
[{"type": "subtitle", "time": 21961.99, "timestamp": "06:06:01", "text": "我去了像商场那样的地方，我问：“M，我"}, {"type": "subtitle", "time": 21965.03, "timestamp": "06:06:05", "text": "我想要这个甜甜圈。它很廉价。我可以吗？"}, {"type": "subtitle", "time": 21967.1, "timestamp": "06:06:07", "text": "买一个吗？"}, {"type": "subtitle", "time": 21968.628, "timestamp": "06:06:08", "text": "[音乐]"}, {"type": "subtitle", "time": 21971.51, "timestamp": "06:06:11", "text": "呃，所以我问了她，然后我得到了我的第一个。"}, {"type": "subtitle", "time": 21974.75, "timestamp": "06:06:14", "text": "我这辈子都没吃过一次甜甜圈。"}, {"type": "subtitle", "time": 21978.07, "timestamp": "06:06:18", "text": "生活。食物种类太多了，我"}, {"type": "subtitle", "time": 21981.548, "timestamp": "06:06:21", "text": "想试试看……"}, {"type": "subtitle", "time": 21984.868, "timestamp": "06:06:24", "text": "未来。只要有机会，我就想尝试一下。"}, {"type": "subtitle", "time": 21988.548, "timestamp": "06:06:28", "text": "出去。或者我甚至想做个类似……呃……"}, {"type": "subtitle", "time": 21991.67, "timestamp": "06:06:31", "text": "美食评论或类似饮食方面的内容"}, {"type": "subtitle", "time": 21994.15, "timestamp": "06:06:34", "text": "比如挑战辣面条。 WHO"}, {"type": "subtitle", "time": 21996.15, "timestamp": "06:06:36", "text": "想做？谁想看？ WHO"}, {"type": "subtitle", "time": 21998.31, "timestamp": "06:06:38", "text": "想看吃辣面挑战吗？"}, {"type": "subtitle", "time": 21999.708, "timestamp": "06:06:39", "text": "我做"}, {"type": "subtitle", "time": 22003.548, "timestamp": "06:06:43", "text": "它。我感觉自己真的超级兴奋，迫不及待地想去做这件事。"}, {"type": "subtitle", "time": 22007.07, "timestamp": "06:06:47", "text": "那。如果有人想的话"}, {"type": "subtitle", "time": 22011.03, "timestamp": "06:06:51", "text": "不过，好像还有点韩国特色。"}, {"type": "subtitle", "time": 22013.51, "timestamp": "06:06:53", "text": "呃，是韩式辣味调料之类的东西，对吧？"}, {"type": "subtitle", "time": 22015.75, "timestamp": "06:06:55", "text": "你可以订购哪个。我想要"}, {"type": "subtitle", "time": 22018.548, "timestamp": "06:06:58", "text": "照做。我想尝尝香料的味道。"}]
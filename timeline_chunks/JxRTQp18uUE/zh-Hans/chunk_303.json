[{"type": "subtitle", "time": 18186.11, "timestamp": "05:03:06", "text": "这是什么？"}, {"type": "subtitle", "time": 18189.15, "timestamp": "05:03:09", "text": "地方？这就是她所说的花园吗？"}, {"type": "subtitle", "time": 18197.628, "timestamp": "05:03:17", "text": "涉及。我害怕了"}, {"type": "subtitle", "time": 18220.788, "timestamp": "05:03:40", "text": "我吓得魂飞魄散。我应该修改这个吗？"}, {"type": "subtitle", "time": 18223.67, "timestamp": "05:03:43", "text": "吓得魂飞魄散？这意味着什么？我"}, {"type": "subtitle", "time": 18225.788, "timestamp": "05:03:45", "text": "读作“赤膊”。"}, {"type": "chat", "time": 18231.698, "timestamp": "05:03:51", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "lmao"}]
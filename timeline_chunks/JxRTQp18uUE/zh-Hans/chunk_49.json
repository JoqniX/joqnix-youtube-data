[{"type": "subtitle", "time": 2943.19, "timestamp": "00:49:03", "text": "有时我觉得我好像感觉"}, {"type": "subtitle", "time": 2945.03, "timestamp": "00:49:05", "text": "有时我真的感觉自己正在做"}, {"type": "subtitle", "time": 2946.349, "timestamp": "00:49:06", "text": "某物"}, {"type": "subtitle", "time": 2951.109, "timestamp": "00:49:11", "text": "错误之处在于我处理事情的方式。"}, {"type": "subtitle", "time": 2952.19, "timestamp": "00:49:12", "text": "正在做"}, {"type": "subtitle", "time": 2954.79, "timestamp": "00:49:14", "text": "无论是内容创作还是"}, {"type": "subtitle", "time": 2965.99, "timestamp": "00:49:25", "text": "内容。有时我觉得自己不像个正常人"}, {"type": "subtitle", "time": 2988.03, "timestamp": "00:49:48", "text": "M：哦，是的，我今天在新闻上看到了这条消息。"}, {"type": "subtitle", "time": 2992.43, "timestamp": "00:49:52", "text": "早上制作"}, {"type": "subtitle", "time": 2998.87, "timestamp": "00:49:58", "text": "男人。"}]
[{"type": "subtitle", "time": 19274.67, "timestamp": "05:21:14", "text": "ジャンク。でも、まあ、"}, {"type": "subtitle", "time": 19278.11, "timestamp": "05:21:18", "text": "えっと、私はたくさんのものを持っています"}, {"type": "subtitle", "time": 19281.628, "timestamp": "05:21:21", "text": "私がしたいと思う心"}, {"type": "subtitle", "time": 19284.708, "timestamp": "05:21:24", "text": "住所。それが"}, {"type": "subtitle", "time": 19290.83, "timestamp": "05:21:30", "text": "まだ、"}, {"type": "subtitle", "time": 19294.39, "timestamp": "05:21:34", "text": "しかし、私は全くレビューしていません。その"}, {"type": "subtitle", "time": 19295.55, "timestamp": "05:21:35", "text": "わかった。良い"}, {"type": "subtitle", "time": 19301.19, "timestamp": "05:21:41", "text": "運。必ず復習して、しっかり勉強してください。"}, {"type": "subtitle", "time": 19309.19, "timestamp": "05:21:49", "text": "でも最善を尽くすということは"}, {"type": "subtitle", "time": 19312.708, "timestamp": "05:21:52", "text": "その言葉は好きじゃない、ほら、"}, {"type": "subtitle", "time": 19315.67, "timestamp": "05:21:55", "text": "言葉は最善を尽くすことができ、私は自分の"}, {"type": "subtitle", "time": 19318.708, "timestamp": "05:21:58", "text": "ベストは誤解される可能性があり、"}]
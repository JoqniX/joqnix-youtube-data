[{"type": "subtitle", "time": 18960.35, "timestamp": "05:16:00", "text": "新しい"}, {"type": "subtitle", "time": 18963.07, "timestamp": "05:16:03", "text": "ラップトップ。それで"}, {"type": "subtitle", "time": 18966.23, "timestamp": "05:16:06", "text": "それから、クロスチェックも確認しました"}, {"type": "subtitle", "time": 18968.708, "timestamp": "05:16:08", "text": "私が受け取った課題。私は"}, {"type": "subtitle", "time": 18970.19, "timestamp": "05:16:10", "text": "今日私の家で"}, {"type": "subtitle", "time": 18973.35, "timestamp": "05:16:13", "text": "すべてがとても良いです。彼らは実際に"}, {"type": "subtitle", "time": 18975.19, "timestamp": "05:16:15", "text": "問題用紙と"}, {"type": "subtitle", "time": 18977.59, "timestamp": "05:16:17", "text": "課題の解答。彼らは書いた"}, {"type": "subtitle", "time": 18979.15, "timestamp": "05:16:19", "text": "すべて"}, {"type": "subtitle", "time": 18982.07, "timestamp": "05:16:22", "text": "きちんと。それはお金の源泉のように感じます"}, {"type": "subtitle", "time": 18983.67, "timestamp": "05:16:23", "text": "書けなかったから費やした"}, {"type": "subtitle", "time": 18986.708, "timestamp": "05:16:26", "text": "課題。私はそれを人に依頼してやってもらった。えっと"}, {"type": "subtitle", "time": 18990.31, "timestamp": "05:16:30", "text": "そして彼らはそれを実行し、小包を発送しました。"}, {"type": "subtitle", "time": 18993.75, "timestamp": "05:16:33", "text": "それを私に送ってくれた。表現すると思います"}, {"type": "subtitle", "time": 18996.948, "timestamp": "05:16:36", "text": "配達だと思います。うん、良かったよ。"}, {"type": "subtitle", "time": 18999.868, "timestamp": "05:16:39", "text": "あれこそが最高だった。"}, {"type": "subtitle", "time": 19002.788, "timestamp": "05:16:42", "text": "良い。提出期限は"}, {"type": "subtitle", "time": 19006.99, "timestamp": "05:16:46", "text": "4月28日。それは火曜日のようなものだ。"}, {"type": "subtitle", "time": 19010.15, "timestamp": "05:16:50", "text": "右？それは月曜日です。ああ、月曜日は"}, {"type": "subtitle", "time": 19011.55, "timestamp": "05:16:51", "text": "最終日。おお"}, {"type": "subtitle", "time": 19015.15, "timestamp": "05:16:55", "text": "神。ああ、月曜日が最終期限です。"}]
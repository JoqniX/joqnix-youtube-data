[{"type": "subtitle", "time": 16021.87, "timestamp": "04:27:01", "text": "開ける？"}, {"type": "subtitle", "time": 16025.91, "timestamp": "04:27:05", "text": "ヘルプ。なんてこった。ジャックさん、あなたはどこにいるのですか？"}, {"type": "subtitle", "time": 16027.83, "timestamp": "04:27:07", "text": "えっと"}, {"type": "subtitle", "time": 16029.59, "timestamp": "04:27:09", "text": "君たちは幽霊の話を聞いた？"}, {"type": "subtitle", "time": 16033.349, "timestamp": "04:27:13", "text": "その幽霊って一体何なの？いいえ。"}, {"type": "subtitle", "time": 16037.59, "timestamp": "04:27:17", "text": "いいえ、していません。はい、できません。待って、なぜ"}, {"type": "subtitle", "time": 16039.83, "timestamp": "04:27:19", "text": "これは半分開いている状態ですか？待って、"}, {"type": "subtitle", "time": 16042.469, "timestamp": "04:27:22", "text": "中に誰かいますか？"}, {"type": "subtitle", "time": 16044.389, "timestamp": "04:27:24", "text": "何もない。すぐ戻ります。"}, {"type": "subtitle", "time": 16045.67, "timestamp": "04:27:25", "text": "幽霊の実話について読んでみる"}, {"type": "subtitle", "time": 16049.11, "timestamp": "04:27:29", "text": "素早い。わかった。おお。ああ、やらなきゃいけない"}, {"type": "subtitle", "time": 16051.75, "timestamp": "04:27:31", "text": "それ。ああ、気にしないで。私はただ抱きしめているだけです"}, {"type": "subtitle", "time": 16053.67, "timestamp": "04:27:33", "text": "念のため、壁は「いいね」を付けておきます。これは"}, {"type": "subtitle", "time": 16055.51, "timestamp": "04:27:35", "text": "普通。これは正常なことです。私の手は"}, {"type": "subtitle", "time": 16059.99, "timestamp": "04:27:39", "text": "震えている。私の目は血で染まっている。"}, {"type": "subtitle", "time": 16063.75, "timestamp": "04:27:43", "text": "名前はバーバラです。"}, {"type": "subtitle", "time": 16065.309, "timestamp": "04:27:45", "text": "わかった。うん。"}, {"type": "subtitle", "time": 16069.11, "timestamp": "04:27:49", "text": "バルバド・バルバラ。何てことだ。彼女は彼女は"}, {"type": "subtitle", "time": 16071.269, "timestamp": "04:27:51", "text": "ヒーラー。彼女は悪くない"}, {"type": "subtitle", "time": 16075.309, "timestamp": "04:27:55", "text": "ヒーラー。うん。私は怖いです。"}, {"type": "subtitle", "time": 16077.75, "timestamp": "04:27:57", "text": "こんにちは。あの部屋に入ることはできますか？"}]
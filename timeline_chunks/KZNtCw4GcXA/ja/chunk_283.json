[{"type": "subtitle", "time": 16983.51, "timestamp": "04:43:03", "text": "何もない。わかった。氷点下"}, {"type": "subtitle", "time": 16985.99, "timestamp": "04:43:05", "text": "何かが起こっている。ああ、凍えるような寒さ"}, {"type": "subtitle", "time": 16988.07, "timestamp": "04:43:08", "text": "気温。あ、待って。それはそうではない"}, {"type": "subtitle", "time": 16994.35, "timestamp": "04:43:14", "text": "分。凍結"}, {"type": "subtitle", "time": 16997.75, "timestamp": "04:43:17", "text": "気温。何？何？わかった。わかった。証拠。"}, {"type": "subtitle", "time": 17000.83, "timestamp": "04:43:20", "text": "わかった。凍えるような寒さだった"}, {"type": "subtitle", "time": 17003.948, "timestamp": "04:43:23", "text": "気温。私たちは望んでいません"}, {"type": "subtitle", "time": 17006.708, "timestamp": "04:43:26", "text": "隠れる。何ももらえませんでした。唾液入れ。"}, {"type": "subtitle", "time": 17011.19, "timestamp": "04:43:31", "text": "幽霊乗りは見かけませんでした。紫外線なし。私たちは"}, {"type": "subtitle", "time": 17014.39, "timestamp": "04:43:34", "text": "オッズのようなものは何もしなかった。似たようなものはない"}, {"type": "subtitle", "time": 17021.91, "timestamp": "04:43:41", "text": "私の上に現れる。ああ、そこにいたんですね。しないで"}, {"type": "subtitle", "time": 17023.27, "timestamp": "04:43:43", "text": "心配するなよ。大丈夫です。大丈夫です。"}, {"type": "subtitle", "time": 17025.35, "timestamp": "04:43:45", "text": "あなたは素晴らしいです。うん、君は"}, {"type": "subtitle", "time": 17027.75, "timestamp": "04:43:47", "text": "絶好調です。ああ、君の考え方だね。ああ、"}, {"type": "subtitle", "time": 17031.19, "timestamp": "04:43:51", "text": "神。大丈夫です。私は私は私は選んでいます"}, {"type": "subtitle", "time": 17033.59, "timestamp": "04:43:53", "text": "あなた。ああ、あのね？悪魔、私は私は"}, {"type": "subtitle", "time": 17036.23, "timestamp": "04:43:56", "text": "悪魔化する。"}, {"type": "subtitle", "time": 17039.03, "timestamp": "04:43:59", "text": "私は何かをしようとしている。何か一つ選んでください。私たちは"}]
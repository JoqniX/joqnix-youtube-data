[{"type": "subtitle", "time": 20943.39, "timestamp": "05:49:03", "text": "時々私は"}, {"type": "subtitle", "time": 20953.948, "timestamp": "05:49:13", "text": "これは新しい視聴者です"}, {"type": "subtitle", "time": 20956.67, "timestamp": "05:49:16", "text": "私が感じていること"}, {"type": "subtitle", "time": 20958.75, "timestamp": "05:49:18", "text": "のように"}, {"type": "subtitle", "time": 20961.51, "timestamp": "05:49:21", "text": "いつか誰かがこう言うだろう"}, {"type": "subtitle", "time": 20964.47, "timestamp": "05:49:24", "text": "以前言ったことがあるかもしれないが、忘れてしまったかもしれないが"}, {"type": "subtitle", "time": 20966.948, "timestamp": "05:49:26", "text": "ああ、君は男の子だったんだね、というあの感覚"}, {"type": "subtitle", "time": 20969.19, "timestamp": "05:49:29", "text": "ずっと私たちを騙していたのか、冗談か"}, {"type": "subtitle", "time": 20971.11, "timestamp": "05:49:31", "text": "何か、それからそういう質問"}, {"type": "subtitle", "time": 20973.43, "timestamp": "05:49:33", "text": "これから来るよ、それが重要な点なんだ。"}, {"type": "subtitle", "time": 20975.15, "timestamp": "05:49:35", "text": "だから私は"}, {"type": "subtitle", "time": 20979.59, "timestamp": "05:49:39", "text": "少しおかしい。だからこそ私はこう思うのです"}, {"type": "subtitle", "time": 20982.868, "timestamp": "05:49:42", "text": "ブリットがここにいたとき、彼も"}, {"type": "subtitle", "time": 20986.15, "timestamp": "05:49:46", "text": "私の言い方に気づいて"}, {"type": "subtitle", "time": 20990.19, "timestamp": "05:49:50", "text": "えっと、そう、僕は男の子みたいな感じ"}, {"type": "subtitle", "time": 20993.39, "timestamp": "05:49:53", "text": "だって、いや"}, {"type": "subtitle", "time": 20996.27, "timestamp": "05:49:56", "text": "わからない"}]
[{"type": "subtitle", "time": 18425.23, "timestamp": "05:07:05", "text": "[音楽]"}, {"type": "subtitle", "time": 18447.11, "timestamp": "05:07:27", "text": "明日7時にコラボ企画があります。"}, {"type": "subtitle", "time": 18451.11, "timestamp": "05:07:31", "text": "これはリポジトリのコラボレーションになります。日曜日に、"}, {"type": "subtitle", "time": 18453.07, "timestamp": "05:07:33", "text": "私のスロットは"}, {"type": "subtitle", "time": 18456.708, "timestamp": "05:07:36", "text": "無料。日曜日は私の予約枠が空いています。そして"}, {"type": "subtitle", "time": 18458.55, "timestamp": "05:07:38", "text": "今週の土曜日、私たちは"}, {"type": "subtitle", "time": 18463.11, "timestamp": "05:07:43", "text": "地域イベント。発表します"}, {"type": "subtitle", "time": 18465.07, "timestamp": "05:07:45", "text": "次の土曜日または"}, {"type": "subtitle", "time": 18469.07, "timestamp": "05:07:49", "text": "日曜日。そして私はそれを発表するでしょう"}, {"type": "subtitle", "time": 18472.708, "timestamp": "05:07:52", "text": "早い。私はそう感じます"}, {"type": "subtitle", "time": 18476.67, "timestamp": "05:07:56", "text": "発表した方が良い"}, {"type": "subtitle", "time": 18478.59, "timestamp": "05:07:58", "text": "以前。"}]
[{"type": "subtitle", "time": 5648.79, "timestamp": "01:34:08", "text": "何？貯蓄は誰にとっても平等な権利である。"}, {"type": "subtitle", "time": 5666.87, "timestamp": "01:34:26", "text": "再装填。倒れるまで戦え。これを受け取って。戦い"}, {"type": "subtitle", "time": 5691.75, "timestamp": "01:34:51", "text": "良い。待って。今、彼らは出発する。すべて"}, {"type": "subtitle", "time": 5693.83, "timestamp": "01:34:53", "text": "彼らは行く。アク。何？何？何ですか"}, {"type": "subtitle", "time": 5695.709, "timestamp": "01:34:55", "text": "彼の"}, {"type": "subtitle", "time": 5699.189, "timestamp": "01:34:59", "text": "戦術戦術？理解できません。保存します"}]
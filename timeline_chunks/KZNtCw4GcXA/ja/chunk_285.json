[{"type": "subtitle", "time": 17102.47, "timestamp": "04:45:02", "text": "うわ、30ドルもするんだ。私は35しか持っていません"}, {"type": "subtitle", "time": 17105.43, "timestamp": "04:45:05", "text": "ドル。私の喉。私たちに必要なものは何ですか？私"}, {"type": "subtitle", "time": 17107.43, "timestamp": "04:45:07", "text": "いくらかお金を持ってください。"}, {"type": "subtitle", "time": 17109.91, "timestamp": "04:45:09", "text": "ああ、懐中電灯が必要だ。"}, {"type": "subtitle", "time": 17112.67, "timestamp": "04:45:12", "text": "懐中電灯？"}, {"type": "subtitle", "time": 17116.15, "timestamp": "04:45:16", "text": "えっと、これは何ですか？"}, {"type": "subtitle", "time": 17118.15, "timestamp": "04:45:18", "text": "スピリットボックス。しかし、私たちは霊を必要としません"}, {"type": "subtitle", "time": 17119.75, "timestamp": "04:45:19", "text": "箱。何も手に入れることができない"}, {"type": "subtitle", "time": 17122.07, "timestamp": "04:45:22", "text": "そこから。"}, {"type": "subtitle", "time": 17126.868, "timestamp": "04:45:26", "text": "電磁界。電磁波かもしれない。しかし、値段が高い。"}, {"type": "subtitle", "time": 17129.51, "timestamp": "04:45:29", "text": "はい。なんて馬鹿げてるんだ。"}, {"type": "subtitle", "time": 17132.15, "timestamp": "04:45:32", "text": "ウィックの値段はいくらですか？私は持っていません"}, {"type": "subtitle", "time": 17133.91, "timestamp": "04:45:33", "text": "それほどまでに。でもね、知ってる？さあ"}, {"type": "subtitle", "time": 17135.91, "timestamp": "04:45:35", "text": "さあ、飛行機に乗って行こう。さあ行こう"}, {"type": "subtitle", "time": 17137.51, "timestamp": "04:45:37", "text": "飛行機。大丈夫です。準備完了。さあ"}, {"type": "subtitle", "time": 17140.788, "timestamp": "04:45:40", "text": "忠誠度アップ。わかった。"}, {"type": "subtitle", "time": 17143.43, "timestamp": "04:45:43", "text": "わかった。それは可能です。セレスティア、あなたは"}, {"type": "subtitle", "time": 17146.31, "timestamp": "04:45:46", "text": "懐中電灯を追加しますか？さらに2つほど追加します。"}, {"type": "subtitle", "time": 17148.47, "timestamp": "04:45:48", "text": "ということで、懐中電灯は３つあると思います。"}, {"type": "subtitle", "time": 17151.11, "timestamp": "04:45:51", "text": "いいえ、追加されていません。ええ、追加しませんでした"}, {"type": "subtitle", "time": 17153.67, "timestamp": "04:45:53", "text": "それ。追加。いや、いや、いや。心配しないで。にたどり着く"}, {"type": "subtitle", "time": 17156.55, "timestamp": "04:45:56", "text": "取締役会。うん。そして、あなたはそれを買うんですよね？"}, {"type": "subtitle", "time": 17159.75, "timestamp": "04:45:59", "text": "そしてローダーに移動して追加します。おお、"}]
[{"type": "subtitle", "time": 10442.23, "timestamp": "02:54:02", "text": "男の子。最後の最後で全てがうまくいかなくなる"}, {"type": "subtitle", "time": 10451.23, "timestamp": "02:54:11", "text": "それ。うん、行くよ"}, {"type": "subtitle", "time": 10454.349, "timestamp": "02:54:14", "text": "地図。おお"}, {"type": "subtitle", "time": 10457.269, "timestamp": "02:54:17", "text": "男の子。何？"}, {"type": "subtitle", "time": 10475.269, "timestamp": "02:54:35", "text": "B. 背景が悪くてすみません。"}, {"type": "subtitle", "time": 10481.71, "timestamp": "02:54:41", "text": "[音楽]"}, {"type": "subtitle", "time": 10484.95, "timestamp": "02:54:44", "text": "行くよ。今のところ、これはどのように使っていますか？私"}, {"type": "subtitle", "time": 10488.71, "timestamp": "02:54:48", "text": "使えないみたいですね。"}, {"type": "subtitle", "time": 10490.83, "timestamp": "02:54:50", "text": "使用"}, {"type": "subtitle", "time": 10492.67, "timestamp": "02:54:52", "text": "ゴヤ"}, {"type": "subtitle", "time": 10498.469, "timestamp": "02:54:58", "text": "そう、そしてジャマ・イェー。ええ、リマインダー"}]
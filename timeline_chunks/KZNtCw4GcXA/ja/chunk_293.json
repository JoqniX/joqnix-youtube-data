[{"type": "subtitle", "time": 17581.19, "timestamp": "04:53:01", "text": "実際はゲームです。"}, {"type": "subtitle", "time": 17582.91, "timestamp": "04:53:02", "text": "[音楽]"}, {"type": "subtitle", "time": 17586.708, "timestamp": "04:53:06", "text": "うん。とにかく、デヴァによると、"}, {"type": "subtitle", "time": 17588.708, "timestamp": "04:53:08", "text": "怖い。"}, {"type": "subtitle", "time": 17589.47, "timestamp": "04:53:09", "text": "それ"}, {"type": "subtitle", "time": 17592.27, "timestamp": "04:53:12", "text": "は。わからない。私は知らない"}, {"type": "subtitle", "time": 17594.628, "timestamp": "04:53:14", "text": "怖いけど、もしかしたら"}, {"type": "subtitle", "time": 17597.35, "timestamp": "04:53:17", "text": "私たちと一緒にプレイしてみませんか？"}, {"type": "subtitle", "time": 17599.23, "timestamp": "04:53:19", "text": "うん。"}, {"type": "subtitle", "time": 17604.15, "timestamp": "04:53:24", "text": "でも部屋は？"}, {"type": "subtitle", "time": 17606.788, "timestamp": "04:53:26", "text": "裏部屋から脱出せよ。中へではなく"}, {"type": "subtitle", "time": 17609.51, "timestamp": "04:53:29", "text": "奥の部屋。後方宙返りから逃れた。おお"}, {"type": "subtitle", "time": 17612.868, "timestamp": "04:53:32", "text": "男の子。何でも。私と時間とシーモア"}, {"type": "subtitle", "time": 17615.11, "timestamp": "04:53:35", "text": "プレイしました。セレスティアが持っていると思う。あなた"}, {"type": "subtitle", "time": 17617.11, "timestamp": "04:53:37", "text": "それを持っているよね？ええ、持っていますよ。"}, {"type": "subtitle", "time": 17619.75, "timestamp": "04:53:39", "text": "でも、私はそれをプレイしたことがない。遊びたい"}, {"type": "subtitle", "time": 17623.11, "timestamp": "04:53:43", "text": "それ？何？あ、待って。待って、私に"}, {"type": "subtitle", "time": 17624.788, "timestamp": "04:53:44", "text": "2番。例えば、あなたの会社では許可されていますか？"}, {"type": "subtitle", "time": 17627.67, "timestamp": "04:53:47", "text": "それ？つまり、それがメインコンセプトなんです。"}, {"type": "subtitle", "time": 17631.11, "timestamp": "04:53:51", "text": "ああ、どの会社が何を許可しているの？えっと、例えば"}, {"type": "subtitle", "time": 17635.51, "timestamp": "04:53:55", "text": "月ごとの1つ。ええ、毎月"}]
[{"type": "subtitle", "time": 363.189, "timestamp": "00:06:03", "text": "[音楽]"}, {"type": "subtitle", "time": 367.07, "timestamp": "00:06:07", "text": "私が自分自身について気づいたことは"}, {"type": "subtitle", "time": 375.55, "timestamp": "00:06:15", "text": "いいえ、これらのゲームのほとんどは"}, {"type": "subtitle", "time": 378.55, "timestamp": "00:06:18", "text": "マルチプレイヤーっぽいし、私はそう感じる"}, {"type": "subtitle", "time": 395.87, "timestamp": "00:06:35", "text": "の上。私は実際にはそうしていないように感じます"}, {"type": "subtitle", "time": 404.67, "timestamp": "00:06:44", "text": "はい。私は苦手な"}, {"type": "subtitle", "time": 407.469, "timestamp": "00:06:47", "text": "のように"}, {"type": "subtitle", "time": 417.43, "timestamp": "00:06:57", "text": "私がグループの中にいる場所"}]
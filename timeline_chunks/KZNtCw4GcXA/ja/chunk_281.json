[{"type": "subtitle", "time": 16869.19, "timestamp": "04:41:09", "text": "行くよ。おっと。ええ、私は死んでしまいました。"}, {"type": "subtitle", "time": 16871.75, "timestamp": "04:41:11", "text": "おっと。彼女はそれを文字通り"}, {"type": "subtitle", "time": 16873.59, "timestamp": "04:41:13", "text": "自分。ジョブ、心配しないで。私は文字通り餌を撒きます"}, {"type": "subtitle", "time": 16878.27, "timestamp": "04:41:18", "text": "これはあなただけのためのものです。来て。何？"}, {"type": "subtitle", "time": 16881.91, "timestamp": "04:41:21", "text": "ああ、ジョール、君も死んでしまったのか？いいえ。私は"}, {"type": "subtitle", "time": 16883.83, "timestamp": "04:41:23", "text": "文字通り、風の地下室に隠れている。"}, {"type": "subtitle", "time": 16888.15, "timestamp": "04:41:28", "text": "ヘルプ。わかった。心配しないで。心配しないで。私"}, {"type": "subtitle", "time": 16890.15, "timestamp": "04:41:30", "text": "狩りは終わったと思う。"}, {"type": "subtitle", "time": 16892.23, "timestamp": "04:41:32", "text": "心配しないで。うん。待って、"}, {"type": "subtitle", "time": 16904.868, "timestamp": "04:41:44", "text": "誰か私の神を開けてください。私たちです。私たちです。"}, {"type": "subtitle", "time": 16907.11, "timestamp": "04:41:47", "text": "イエス・キリスト。"}, {"type": "subtitle", "time": 16909.27, "timestamp": "04:41:49", "text": "わかった。どこに行きたいですか？私たちはそうしましたか？"}, {"type": "subtitle", "time": 16911.75, "timestamp": "04:41:51", "text": "ヒューズを直す必要がある"}, {"type": "subtitle", "time": 16916.59, "timestamp": "04:41:56", "text": "またか、そうだろ？わかった。 Jさん、それは"}, {"type": "subtitle", "time": 16919.19, "timestamp": "04:41:59", "text": "大丈夫。気にしないでください。私はただの幽霊です。"}]
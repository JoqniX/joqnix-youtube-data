[{"type": "subtitle", "time": 12361.99, "timestamp": "03:26:01", "text": "スレンダーマン。ニース。はぁ？どこ"}, {"type": "subtitle", "time": 12372.63, "timestamp": "03:26:12", "text": "あれを見てください。あれを見てください。何てことだ。"}, {"type": "subtitle", "time": 12375.91, "timestamp": "03:26:15", "text": "それは良いことです。それは良いことです。いいえ、私は決して"}, {"type": "subtitle", "time": 12379.03, "timestamp": "03:26:19", "text": "振り返ってみると。"}, {"type": "subtitle", "time": 12380.389, "timestamp": "03:26:20", "text": "かっこいい見た目だと言っている"}, {"type": "subtitle", "time": 12385.55, "timestamp": "03:26:25", "text": "ライトセーバー"}, {"type": "subtitle", "time": 12389.349, "timestamp": "03:26:29", "text": "来る。待って、どうやって私は私は私は私は"}, {"type": "subtitle", "time": 12391.11, "timestamp": "03:26:31", "text": "電源を入れて、あとはそのまま入れるだけです"}, {"type": "subtitle", "time": 12393.11, "timestamp": "03:26:33", "text": "床。それが"}, {"type": "subtitle", "time": 12395.11, "timestamp": "03:26:35", "text": "これからはDOSで作業することになっている。"}, {"type": "subtitle", "time": 12396.95, "timestamp": "03:26:36", "text": "はい。それが、それが私が"}, {"type": "subtitle", "time": 12399.03, "timestamp": "03:26:39", "text": "やるべきこと。ニース。とにかく、私は"}, {"type": "subtitle", "time": 12401.11, "timestamp": "03:26:41", "text": "もう一度手に取ってください。拾って拾って。これ"}, {"type": "subtitle", "time": 12402.469, "timestamp": "03:26:42", "text": "そこから話が出てきたんです。拾い上げてください。選んでください"}, {"type": "subtitle", "time": 12404.71, "timestamp": "03:26:44", "text": "上。了解、了解。彼らは変化を好んだのだろうか？"}, {"type": "subtitle", "time": 12405.469, "timestamp": "03:26:45", "text": "これ"}, {"type": "subtitle", "time": 12409.11, "timestamp": "03:26:49", "text": "地図？テントが"}, {"type": "subtitle", "time": 12411.19, "timestamp": "03:26:51", "text": "少し低いような感じのはずなのに"}, {"type": "subtitle", "time": 12413.91, "timestamp": "03:26:53", "text": "低くはない。わからない"}, {"type": "subtitle", "time": 12417.429, "timestamp": "03:26:57", "text": "彼らはこれに対してそうした。最高に楽しい。"}]
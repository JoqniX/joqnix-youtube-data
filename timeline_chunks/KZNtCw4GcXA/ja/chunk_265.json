[{"type": "subtitle", "time": 15903.59, "timestamp": "04:25:03", "text": "今はアナログ時代だ。ニース。私はこれが好きではない。"}, {"type": "subtitle", "time": 15906.229, "timestamp": "04:25:06", "text": "おお。ビデオカメラは持っていません。"}, {"type": "subtitle", "time": 15908.229, "timestamp": "04:25:08", "text": "私たちは？オーはどこ？これはビデオですか？"}, {"type": "subtitle", "time": 15909.99, "timestamp": "04:25:09", "text": "カメラ？"}, {"type": "subtitle", "time": 15912.71, "timestamp": "04:25:12", "text": "はい、大丈夫です。私をゴーストフィールドに放り込む。さあ"}, {"type": "subtitle", "time": 15915.83, "timestamp": "04:25:15", "text": "見て。ああ、見て。すべては"}, {"type": "subtitle", "time": 15922.229, "timestamp": "04:25:22", "text": "彼らは退化した。"}, {"type": "subtitle", "time": 15924.63, "timestamp": "04:25:24", "text": "彼らは、彼らが戻ったのを気に入っていました"}, {"type": "subtitle", "time": 15928.469, "timestamp": "04:25:28", "text": "猿モードへ。知っている。"}, {"type": "subtitle", "time": 15931.03, "timestamp": "04:25:31", "text": "なぜこれはアナログなのか？"}, {"type": "subtitle", "time": 15933.429, "timestamp": "04:25:33", "text": "すべてオンになっています。何てことだ。大好きです。私"}, {"type": "subtitle", "time": 15936.71, "timestamp": "04:25:36", "text": "大好きです。大丈夫です。うん。中に入りましょう。"}, {"type": "subtitle", "time": 15938.229, "timestamp": "04:25:38", "text": "さあ行こう。皆さんは音声を聞くことができます、"}, {"type": "subtitle", "time": 15940.71, "timestamp": "04:25:40", "text": "右？それは困難のようなものですか"}, {"type": "subtitle", "time": 15943.67, "timestamp": "04:25:43", "text": "もの？私はそうは思わない。右。えっと、私は"}, {"type": "subtitle", "time": 15944.95, "timestamp": "04:25:44", "text": "トーチを受け継ぐことができるかどうかを知る"}, {"type": "subtitle", "time": 15947.75, "timestamp": "04:25:47", "text": "軽度の毒性。いや、私は受け取らなかった"}, {"type": "subtitle", "time": 15950.71, "timestamp": "04:25:50", "text": "まだ懐中電灯がない。ええと、懐中電灯はありません。"}, {"type": "subtitle", "time": 15952.07, "timestamp": "04:25:52", "text": "懐中電灯は必要ありません。"}, {"type": "subtitle", "time": 15954.55, "timestamp": "04:25:54", "text": "大丈夫です。大丈夫です。 「私たち」は必要ありません"}, {"type": "subtitle", "time": 15959.59, "timestamp": "04:25:59", "text": "盲目になることもできる。大丈夫です。買います。"}]
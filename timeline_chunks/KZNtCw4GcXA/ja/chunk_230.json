[{"type": "subtitle", "time": 13800.07, "timestamp": "03:50:00", "text": "えっと、その後、えっと、私はこう思ったんです。ええ、ええ"}, {"type": "subtitle", "time": 13803.59, "timestamp": "03:50:03", "text": "このモードアプリケーションについて述べる前に"}, {"type": "subtitle", "time": 13805.63, "timestamp": "03:50:05", "text": "現在入手可能です"}, {"type": "subtitle", "time": 13807.63, "timestamp": "03:50:07", "text": "利用可能。する"}, {"type": "subtitle", "time": 13811.269, "timestamp": "03:50:11", "text": "希望するなら応募してください。私は望んでいない"}, {"type": "subtitle", "time": 13813.429, "timestamp": "03:50:13", "text": "誰かに強制して応募させる。"}, {"type": "subtitle", "time": 13817.51, "timestamp": "03:50:17", "text": "いや、いや、いや、いや。ええと、もしあなたができると思うなら"}, {"type": "subtitle", "time": 13821.87, "timestamp": "03:50:21", "text": "モデレーターの方は、申請できます。わかった。強制はしない"}, {"type": "subtitle", "time": 13825.03, "timestamp": "03:50:25", "text": "誰でも。選ぶのは難しいだろう。私は"}, {"type": "subtitle", "time": 13827.469, "timestamp": "03:50:27", "text": "君たちの知り合い"}, {"type": "subtitle", "time": 13832.389, "timestamp": "03:50:32", "text": "自分。私は優柔不断な人間なので"}, {"type": "subtitle", "time": 13835.55, "timestamp": "03:50:35", "text": "難しい。だから、自分がどうなっているのか分からない"}, {"type": "subtitle", "time": 13838.95, "timestamp": "03:50:38", "text": "最終決定するために"}, {"type": "subtitle", "time": 13841.11, "timestamp": "03:50:41", "text": "えーと、人々やモデレーターなどですが、"}, {"type": "subtitle", "time": 13844.59, "timestamp": "03:50:44", "text": "見てみましょう。できるといいな"}, {"type": "subtitle", "time": 13847.75, "timestamp": "03:50:47", "text": "きちんと。でも、そうですね、それは"}, {"type": "subtitle", "time": 13850.71, "timestamp": "03:50:50", "text": "ハプニング。期間"}, {"type": "subtitle", "time": 13853.99, "timestamp": "03:50:53", "text": "アプリケーションはまだ"}, {"type": "subtitle", "time": 13857.309, "timestamp": "03:50:57", "text": "翌日か。えっと、10月19日"}]
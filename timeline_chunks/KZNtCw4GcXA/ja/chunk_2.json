[{"type": "subtitle", "time": 122.55, "timestamp": "00:02:02", "text": "この流れに向かって、そしてそれは"}, {"type": "subtitle", "time": 125.59, "timestamp": "00:02:05", "text": "よく気を散らされるのは、"}, {"type": "subtitle", "time": 129.19, "timestamp": "00:02:09", "text": "時間の経過とともにどれだけ"}, {"type": "subtitle", "time": 147.19, "timestamp": "00:02:27", "text": "もちろん。よし、またライブ配信するよ"}, {"type": "subtitle", "time": 153.99, "timestamp": "00:02:33", "text": "良い。今日は、"}, {"type": "subtitle", "time": 156.39, "timestamp": "00:02:36", "text": "ピュー。どのゲームをプレイするかまだ決めていません"}, {"type": "subtitle", "time": 162.07, "timestamp": "00:02:42", "text": "今日はピューピューと撃ちます。えっと、でも"}, {"type": "subtitle", "time": 165.15, "timestamp": "00:02:45", "text": "私は一番手探りで探っていました"}, {"type": "subtitle", "time": 168.19, "timestamp": "00:02:48", "text": "何かの"}, {"type": "subtitle", "time": 177.75, "timestamp": "00:02:57", "text": "ヴァレラントとこれら"}]
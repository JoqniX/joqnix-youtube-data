[{"type": "subtitle", "time": 12421.15, "timestamp": "03:27:01", "text": "ラスボール。そこには"}, {"type": "subtitle", "time": 12424.75, "timestamp": "03:27:04", "text": "ボール。待って、どうやって"}, {"type": "subtitle", "time": 12427.71, "timestamp": "03:27:07", "text": "ボールへ"}, {"type": "subtitle", "time": 12431.389, "timestamp": "03:27:11", "text": "ジャマ？方法"}, {"type": "subtitle", "time": 12435.03, "timestamp": "03:27:15", "text": "li を拾って G を落とす"}, {"type": "subtitle", "time": 12436.55, "timestamp": "03:27:16", "text": "それ。"}, {"type": "subtitle", "time": 12439.59, "timestamp": "03:27:19", "text": "ああ、グロ。ああ、わかりました。わかった。ええ、私たちは"}, {"type": "subtitle", "time": 12441.59, "timestamp": "03:27:21", "text": "行く。"}, {"type": "subtitle", "time": 12443.15, "timestamp": "03:27:23", "text": "それはとても"}, {"type": "subtitle", "time": 12454.07, "timestamp": "03:27:34", "text": "ああ、舞踏会気分だ。ええ、私が投げました。私"}, {"type": "subtitle", "time": 12456.469, "timestamp": "03:27:36", "text": "投げ入れた。"}, {"type": "subtitle", "time": 12458.63, "timestamp": "03:27:38", "text": "ああ、そんな部屋はないよ"}, {"type": "subtitle", "time": 12461.91, "timestamp": "03:27:41", "text": "側面に。バカ。わかった。このバスルーム"}, {"type": "subtitle", "time": 12463.51, "timestamp": "03:27:43", "text": "不快だ。そして人々は"}, {"type": "subtitle", "time": 12465.51, "timestamp": "03:27:45", "text": "歯ブラシのような"}, {"type": "subtitle", "time": 12467.19, "timestamp": "03:27:47", "text": "公然と。それは私の"}, {"type": "subtitle", "time": 12469.67, "timestamp": "03:27:49", "text": "最大の元カレはただの歯ブラシが横たわっているだけ"}, {"type": "subtitle", "time": 12471.59, "timestamp": "03:27:51", "text": "汚れてしまうから"}, {"type": "subtitle", "time": 12476.71, "timestamp": "03:27:56", "text": "それを口に入れてください。バカ。ああ、大変だ。"}, {"type": "subtitle", "time": 12478.71, "timestamp": "03:27:58", "text": "セレスティアが実は"}]
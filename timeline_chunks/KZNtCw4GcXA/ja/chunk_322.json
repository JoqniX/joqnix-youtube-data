[{"type": "subtitle", "time": 19322.03, "timestamp": "05:22:02", "text": "ミス、ミス"}, {"type": "subtitle", "time": 19323.788, "timestamp": "05:22:03", "text": "見た。"}, {"type": "subtitle", "time": 19326.868, "timestamp": "05:22:06", "text": "ええ、時々そうでないこともあります。私がそうすると言ったら"}, {"type": "subtitle", "time": 19328.948, "timestamp": "05:22:08", "text": "ベストを尽くしても、本当にそうは思えない"}, {"type": "subtitle", "time": 19341.47, "timestamp": "05:22:21", "text": "夜？どんな種類"}, {"type": "subtitle", "time": 19349.15, "timestamp": "05:22:29", "text": "知る。不和"}, {"type": "subtitle", "time": 19352.19, "timestamp": "05:22:32", "text": "トリガー。ああ、これは"}, {"type": "subtitle", "time": 19354.868, "timestamp": "05:22:34", "text": "更新しました。ちょっと待って。これは"}, {"type": "subtitle", "time": 19357.628, "timestamp": "05:22:37", "text": "更新しました。何が"}, {"type": "subtitle", "time": 19360.43, "timestamp": "05:22:40", "text": "最新？待って、これは"}]
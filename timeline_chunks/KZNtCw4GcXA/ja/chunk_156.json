[{"type": "subtitle", "time": 9387.03, "timestamp": "02:36:27", "text": "敵はあと一体。これで３つ目だ。私の"}, {"type": "subtitle", "time": 9405.71, "timestamp": "02:36:45", "text": "これは"}, {"type": "subtitle", "time": 9408.349, "timestamp": "02:36:48", "text": "いいね。これはクールだ"}, {"type": "subtitle", "time": 9413.03, "timestamp": "02:36:53", "text": "銃。それはただ、仕事があるかもしれないということだ。"}]
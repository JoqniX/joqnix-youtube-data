[{"type": "subtitle", "time": 18842.11, "timestamp": "05:14:02", "text": "彼らはそれに気づいていないのか？わからない、"}, {"type": "subtitle", "time": 18880.67, "timestamp": "05:14:40", "text": "つまり、新参者とかに対してってことだよ"}, {"type": "subtitle", "time": 18884.11, "timestamp": "05:14:44", "text": "特にオープンBCでは"}, {"type": "subtitle", "time": 18887.35, "timestamp": "05:14:47", "text": "買収は私が理解していない"}, {"type": "subtitle", "time": 18890.788, "timestamp": "05:14:50", "text": "ゲストが配信中に"}, {"type": "subtitle", "time": 18893.27, "timestamp": "05:14:53", "text": "引き継ぐ。ゲストは声に出して"}, {"type": "subtitle", "time": 18895.99, "timestamp": "05:14:55", "text": "声に出して言ってみて、その犬は"}, {"type": "subtitle", "time": 18898.948, "timestamp": "05:14:58", "text": "壊す。とりあえず今はここにいます。私"}]
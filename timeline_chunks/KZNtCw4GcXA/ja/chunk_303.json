[{"type": "subtitle", "time": 18184.35, "timestamp": "05:03:04", "text": "うん、もっと"}, {"type": "subtitle", "time": 18188.67, "timestamp": "05:03:08", "text": "もっと。正直に言うと"}, {"type": "subtitle", "time": 18190.99, "timestamp": "05:03:10", "text": "えっと"}, {"type": "subtitle", "time": 18196.03, "timestamp": "05:03:16", "text": "私は本当に多くのことを変える必要がある"}, {"type": "subtitle", "time": 18203.23, "timestamp": "05:03:23", "text": "[音楽]"}, {"type": "subtitle", "time": 18204.96, "timestamp": "05:03:24", "text": "えーと、たくさん"}, {"type": "subtitle", "time": 18206.11, "timestamp": "05:03:26", "text": "[音楽]"}, {"type": "subtitle", "time": 18209.11, "timestamp": "05:03:29", "text": "物事、そして私はそれを言い続けているが、"}, {"type": "subtitle", "time": 18222.75, "timestamp": "05:03:42", "text": "[音楽]"}]
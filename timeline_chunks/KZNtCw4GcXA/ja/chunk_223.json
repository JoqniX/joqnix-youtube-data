[{"type": "subtitle", "time": 13380.07, "timestamp": "03:43:00", "text": "彼が見せたもの、私は"}, {"type": "subtitle", "time": 13382.55, "timestamp": "03:43:02", "text": "文字通り充電するのが大好きで、"}, {"type": "subtitle", "time": 13385.349, "timestamp": "03:43:05", "text": "文字通り私のストリームに戻るか、"}, {"type": "subtitle", "time": 13388.55, "timestamp": "03:43:08", "text": "私が何をしていたにせよ、これは"}, {"type": "subtitle", "time": 13397.189, "timestamp": "03:43:17", "text": "もっと。ええ、そうですね、私が"}, {"type": "subtitle", "time": 13400.83, "timestamp": "03:43:20", "text": "ありがとうと言いたい。待って、"}, {"type": "subtitle", "time": 13410.63, "timestamp": "03:43:30", "text": "えっと、あくびが出てきました。おお。私は"}, {"type": "subtitle", "time": 13412.63, "timestamp": "03:43:32", "text": "少し間違っているけど、みんなに感謝するよ"}, {"type": "subtitle", "time": 13414.79, "timestamp": "03:43:34", "text": "人々が通りかかった。最初にすべての人々"}, {"type": "subtitle", "time": 13416.71, "timestamp": "03:43:36", "text": "今日立ち寄った人々。 Hブラッド、ありがとう"}, {"type": "subtitle", "time": 13418.87, "timestamp": "03:43:38", "text": "今日は来てくれてありがとう。ニカト"}, {"type": "subtitle", "time": 13421.99, "timestamp": "03:43:41", "text": "ファンアート。作成していただきありがとうございます"}, {"type": "subtitle", "time": 13424.15, "timestamp": "03:43:44", "text": "この配信のサムネイル画像。本当に"}, {"type": "subtitle", "time": 13425.88, "timestamp": "03:43:45", "text": "本当に 楽しい。本当に可愛かった。ありがとう。それで"}, {"type": "subtitle", "time": 13429.76, "timestamp": "03:43:49", "text": "楽しい。本当に可愛かった。ありがとう。それで もしそれがわからないなら、もし"}, {"type": "subtitle", "time": 13433.68, "timestamp": "03:43:53", "text": "もしそれがわからないなら、もし 待って、どうやって見せるか見せてもいいですか"}, {"type": "subtitle", "time": 13436.84, "timestamp": "03:43:56", "text": "待って、どうやって見せるか見せてもいいですか 話？えっと、ちょっとやらせてください"}]
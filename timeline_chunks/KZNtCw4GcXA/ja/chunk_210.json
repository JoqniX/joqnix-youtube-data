[{"type": "subtitle", "time": 12601.19, "timestamp": "03:30:01", "text": "紫外線による速度違反はありますか？いいえ、"}, {"type": "subtitle", "time": 12603.75, "timestamp": "03:30:03", "text": "右。いいえ、まだです。私は見ませんでした"}, {"type": "subtitle", "time": 12612.309, "timestamp": "03:30:12", "text": "サッカー映画そのもの。"}, {"type": "subtitle", "time": 12615.99, "timestamp": "03:30:15", "text": "わかった。わかった。まだダヴがいるよ。"}, {"type": "subtitle", "time": 12618.79, "timestamp": "03:30:18", "text": "うん、"}, {"type": "subtitle", "time": 12620.79, "timestamp": "03:30:20", "text": "さらに楽しいよ。実際は、"}, {"type": "subtitle", "time": 12622.87, "timestamp": "03:30:22", "text": "むさぼり食う方が実際には楽しい。あなたはしない"}, {"type": "subtitle", "time": 12625.83, "timestamp": "03:30:25", "text": "こういうのが好きでないといけない、これは穏やかで、"}, {"type": "subtitle", "time": 12627.67, "timestamp": "03:30:27", "text": "右？貪り食うのはもっと"}, {"type": "subtitle", "time": 12629.19, "timestamp": "03:30:29", "text": "アクション満載。"}, {"type": "subtitle", "time": 12631.51, "timestamp": "03:30:31", "text": "うん。うん。こんにちは、みんな。私は違います"}, {"type": "subtitle", "time": 12633.91, "timestamp": "03:30:33", "text": "怖くない、ただ"}, {"type": "subtitle", "time": 12635.91, "timestamp": "03:30:35", "text": "歩き回ってみる。のんびりできるゲーム。寒い"}, {"type": "subtitle", "time": 12638.95, "timestamp": "03:30:38", "text": "実際はゲームです。"}, {"type": "subtitle", "time": 12646.55, "timestamp": "03:30:46", "text": "待って、怖いって聞いたんだけど。"}, {"type": "subtitle", "time": 12650.11, "timestamp": "03:30:50", "text": "そうです。わからない。私は知らない"}, {"type": "subtitle", "time": 12652.469, "timestamp": "03:30:52", "text": "怖いけど、もしかしたら"}, {"type": "subtitle", "time": 12655.19, "timestamp": "03:30:55", "text": "私たちと一緒にプレイしてみませんか？"}, {"type": "subtitle", "time": 12657.07, "timestamp": "03:30:57", "text": "うん。"}]
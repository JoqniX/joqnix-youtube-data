[{"type": "subtitle", "time": 10742.15, "timestamp": "02:59:02", "text": "うん。面白いことに、私はあることをしようとした"}, {"type": "subtitle", "time": 10747.349, "timestamp": "02:59:07", "text": "まるで私が唯一のことをしているかのように。"}, {"type": "subtitle", "time": 10749.51, "timestamp": "02:59:09", "text": "君たちは2Dモデルみたいなものだから、"}, {"type": "subtitle", "time": 10751.269, "timestamp": "02:59:11", "text": "やらなくてもいいですよ。でも私には"}, {"type": "subtitle", "time": 10754.87, "timestamp": "02:59:14", "text": "このPNGモデルのように。だから私は"}, {"type": "subtitle", "time": 10757.429, "timestamp": "02:59:17", "text": "何か凝ったことをする。"}, {"type": "subtitle", "time": 10760.23, "timestamp": "02:59:20", "text": "えっと、あなたたちが話した後、私はただ"}, {"type": "subtitle", "time": 10763.67, "timestamp": "02:59:23", "text": "実際には3つのアドオンがありますが、"}, {"type": "subtitle", "time": 10765.429, "timestamp": "02:59:25", "text": "残念ながら、すべてがクラッシュしてしまいました。"}, {"type": "subtitle", "time": 10767.91, "timestamp": "02:59:27", "text": "そして燃えてしまい、何も積み込まれていなかった。"}, {"type": "subtitle", "time": 10770.389, "timestamp": "02:59:30", "text": "だから、私は本当にデフォルトして"}, {"type": "subtitle", "time": 10774.15, "timestamp": "02:59:34", "text": "すべてをもう一度やり直す。というわけで、そういうことです。"}, {"type": "subtitle", "time": 10777.19, "timestamp": "02:59:37", "text": "とにかく、最初の10で私が擦り切れた"}, {"type": "subtitle", "time": 10779.75, "timestamp": "02:59:39", "text": "配信の数分。典型的な私の配信"}, {"type": "subtitle", "time": 10782.23, "timestamp": "02:59:42", "text": "私に言わせれば。"}, {"type": "subtitle", "time": 10784.23, "timestamp": "02:59:44", "text": "待って、私のキャプチャカードはそうじゃないけど、私は大好き"}, {"type": "subtitle", "time": 10786.389, "timestamp": "02:59:46", "text": "サムネイル。サムネイルが気に入りました。"}, {"type": "subtitle", "time": 10789.91, "timestamp": "02:59:49", "text": "はい。え、何？何？何？止める"}, {"type": "subtitle", "time": 10793.75, "timestamp": "02:59:53", "text": "ゲーム。はい。うん。うん。うん。うん。わーい。"}, {"type": "subtitle", "time": 10797.03, "timestamp": "02:59:57", "text": "私はやめます。何てことだ。あなたは行かなければならない。"}, {"type": "subtitle", "time": 10799.67, "timestamp": "02:59:59", "text": "うまくいかない。なんてこった？待って、"}]
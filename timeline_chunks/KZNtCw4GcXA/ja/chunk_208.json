[{"type": "subtitle", "time": 12484.389, "timestamp": "03:28:04", "text": "はい、その通りです。これはひどい。私"}, {"type": "subtitle", "time": 12486.229, "timestamp": "03:28:06", "text": "誰がこんなことをしているのか分からない。私は思う"}, {"type": "subtitle", "time": 12487.67, "timestamp": "03:28:07", "text": "そうは思わない。聞こえた？"}, {"type": "subtitle", "time": 12489.429, "timestamp": "03:28:09", "text": "誰かが叫んだ。今、聞こえましたか？"}, {"type": "subtitle", "time": 12492.87, "timestamp": "03:28:12", "text": "誰かが叫んだ。君たちはどこにいるの？"}, {"type": "subtitle", "time": 12495.51, "timestamp": "03:28:15", "text": "誰も叫ばなかった。心配しないで。いや、いや。"}, {"type": "subtitle", "time": 12498.229, "timestamp": "03:28:18", "text": "ただ、私一人だけだったんです。私は練習していました"}, {"type": "subtitle", "time": 12501.11, "timestamp": "03:28:21", "text": "歌い方。ジャック、さあ。大丈夫です。"}, {"type": "subtitle", "time": 12506.309, "timestamp": "03:28:26", "text": "氷点下。いや、いや、いや。"}, {"type": "subtitle", "time": 12508.15, "timestamp": "03:28:28", "text": "こんにちは。"}, {"type": "subtitle", "time": 12510.429, "timestamp": "03:28:30", "text": "おい、あれを見てみろよ。待って、誰かが言った"}, {"type": "subtitle", "time": 12514.95, "timestamp": "03:28:34", "text": "こんにちは。待って。こんにちは。いいえ。"}, {"type": "subtitle", "time": 12516.87, "timestamp": "03:28:36", "text": "どうしたの？どうしたの？私はここにいます。"}, {"type": "subtitle", "time": 12524.229, "timestamp": "03:28:44", "text": "それは"}]
[{"type": "subtitle", "time": 10921.07, "timestamp": "03:02:01", "text": "その"}, {"type": "subtitle", "time": 10924.99, "timestamp": "03:02:04", "text": "大丈夫。あなたは素晴らしいです。それは"}, {"type": "subtitle", "time": 10928.269, "timestamp": "03:02:08", "text": "おお。ああ、幽霊は"}, {"type": "subtitle", "time": 10931.429, "timestamp": "03:02:11", "text": "狂った。ナイトメアモードが大好きです"}, {"type": "subtitle", "time": 10934.87, "timestamp": "03:02:14", "text": "これ。待って、なぜmoniは両方とも"}, {"type": "subtitle", "time": 10936.79, "timestamp": "03:02:16", "text": "モニターはライブですか？"}, {"type": "subtitle", "time": 10938.19, "timestamp": "03:02:18", "text": "ようこそ"}, {"type": "subtitle", "time": 10941.269, "timestamp": "03:02:21", "text": "悪夢。いや、ない、ない"}, {"type": "subtitle", "time": 10945.349, "timestamp": "03:02:25", "text": "ポイント。ニース。はい。"}, {"type": "subtitle", "time": 10947.99, "timestamp": "03:02:27", "text": "「口先だけでなく行動も伴っているのか？」への回答"}, {"type": "subtitle", "time": 10950.07, "timestamp": "03:02:30", "text": "いや、いや、いや。これはEMF測定器です。おお、"}, {"type": "subtitle", "time": 10955.75, "timestamp": "03:02:35", "text": "ニース。私はEMFが好きです。わあ、すごい。まるで"}, {"type": "subtitle", "time": 10961.51, "timestamp": "03:02:41", "text": "今はアナログ時代だ。ニース。私はこれが好きではない。"}, {"type": "subtitle", "time": 10964.07, "timestamp": "03:02:44", "text": "おお。ビデオカメラは持っていません。"}, {"type": "subtitle", "time": 10967.83, "timestamp": "03:02:47", "text": "私たちは？どこですか？ あ、これはビデオカメラですか？"}, {"type": "subtitle", "time": 10970.309, "timestamp": "03:02:50", "text": "はい、大丈夫です。ゴーストフィールドメーター。"}, {"type": "subtitle", "time": 10973.03, "timestamp": "03:02:53", "text": "見てみましょう。ああ、見て。すべて"}, {"type": "subtitle", "time": 10976.11, "timestamp": "03:02:56", "text": "アナログです。"}, {"type": "subtitle", "time": 10979.99, "timestamp": "03:02:59", "text": "ああ、彼らは退化した。"}]
[{"type": "subtitle", "time": 19741.31, "timestamp": "05:29:01", "text": "けれど。"}, {"type": "subtitle", "time": 19743.628, "timestamp": "05:29:03", "text": "えっと、何が起こったんですか？ああ、私たちはちょうど"}, {"type": "subtitle", "time": 19747.99, "timestamp": "05:29:07", "text": "話している。いつか誰かと話したいと思ったんです。私"}, {"type": "subtitle", "time": 19748.99, "timestamp": "05:29:08", "text": "ちょうど来た"}, {"type": "subtitle", "time": 19752.07, "timestamp": "05:29:12", "text": "戻る。 WSを置くことに罪悪感を感じた"}, {"type": "subtitle", "time": 19756.5, "timestamp": "05:29:16", "text": "もの。"}, {"type": "subtitle", "time": 19757.708, "timestamp": "05:29:17", "text": "[音楽]"}, {"type": "subtitle", "time": 19761.59, "timestamp": "05:29:21", "text": "うん、昨日はすごく気分が悪かったんだ。私"}, {"type": "subtitle", "time": 19763.83, "timestamp": "05:29:23", "text": "知る。昨日は重要な日でした"}, {"type": "subtitle", "time": 19767.15, "timestamp": "05:29:27", "text": "私はVCとのコラボレーションがあったから"}, {"type": "subtitle", "time": 19770.07, "timestamp": "05:29:30", "text": "ミーティング。えっと、私はある意味そうするつもりだったんだけど"}, {"type": "subtitle", "time": 19773.39, "timestamp": "05:29:33", "text": "授業はあったけど、なかったと思う"}, {"type": "subtitle", "time": 19774.91, "timestamp": "05:29:34", "text": "クラス。"}, {"type": "subtitle", "time": 19778.07, "timestamp": "05:29:38", "text": "ええと、そういうことがたくさんありますが、私は"}, {"type": "subtitle", "time": 19780.708, "timestamp": "05:29:40", "text": "ストリームに登場したのはわずか2回だけだった"}, {"type": "subtitle", "time": 19784.23, "timestamp": "05:29:44", "text": "パート1は最大2～3時間"}, {"type": "subtitle", "time": 19787.19, "timestamp": "05:29:47", "text": "ストリーム。昨日私はV字を切り刻んでいました"}, {"type": "subtitle", "time": 19789.628, "timestamp": "05:29:49", "text": "そして私は正直に"}, {"type": "subtitle", "time": 19794.83, "timestamp": "05:29:54", "text": "気分がすごく悪い、これは"}, {"type": "subtitle", "time": 19799.47, "timestamp": "05:29:59", "text": "ひどい、ひどい、私はそこにいない"}]
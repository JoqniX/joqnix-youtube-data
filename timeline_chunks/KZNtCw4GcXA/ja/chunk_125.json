[{"type": "subtitle", "time": 7501.07, "timestamp": "02:05:01", "text": "人々はプレミアをプレイし、"}, {"type": "subtitle", "time": 7503.43, "timestamp": "02:05:03", "text": "すべて？人々は人々を"}, {"type": "subtitle", "time": 7518.189, "timestamp": "02:05:18", "text": "言いたいのは"}, {"type": "subtitle", "time": 7551.149, "timestamp": "02:05:51", "text": "人との交流の仕方はどうすれば良いでしょうか？私は"}, {"type": "subtitle", "time": 7554.31, "timestamp": "02:05:54", "text": "怖がった。でも正直言って"}, {"type": "subtitle", "time": 7558.229, "timestamp": "02:05:58", "text": "話せば、私はこんなに怖がらないだろう"}]
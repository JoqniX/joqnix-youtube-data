[{"type": "subtitle", "time": 16261.11, "timestamp": "04:31:01", "text": "大丈夫。大丈夫。君たちは行きたいの？"}, {"type": "subtitle", "time": 16265.11, "timestamp": "04:31:05", "text": "下？プッシュトゥトークを直させてください"}, {"type": "subtitle", "time": 16274.71, "timestamp": "04:31:14", "text": "ああ、針は動いているように見えるが、"}, {"type": "subtitle", "time": 16277.349, "timestamp": "04:31:17", "text": "まだ舞台がないわけではない。"}, {"type": "subtitle", "time": 16279.91, "timestamp": "04:31:19", "text": "でも、動いているよ。"}, {"type": "subtitle", "time": 16283.189, "timestamp": "04:31:23", "text": "ああ、なるほど。それはとても興味深いですね。"}, {"type": "subtitle", "time": 16285.349, "timestamp": "04:31:25", "text": "ええ、わかっています。紛らわしいけど、"}, {"type": "subtitle", "time": 16288.63, "timestamp": "04:31:28", "text": "分かります、それです。何かありますか？私"}, {"type": "subtitle", "time": 16291.429, "timestamp": "04:31:31", "text": "そうは思わない。あ、待って、待って、待って。"}, {"type": "subtitle", "time": 16294.07, "timestamp": "04:31:34", "text": "点滅している。助けてください"}, {"type": "subtitle", "time": 16296.389, "timestamp": "04:31:36", "text": "自分。私はここにいます。私はここにいます。私はここにいます。しないで"}, {"type": "subtitle", "time": 16298.07, "timestamp": "04:31:38", "text": "心配。"}, {"type": "subtitle", "time": 16300.229, "timestamp": "04:31:40", "text": "このくだらない宝石を置いていってください。私は死んだ。私は死んだ。"}, {"type": "subtitle", "time": 16303.51, "timestamp": "04:31:43", "text": "私は死んだ。私は死んだ。私も死んだ。何？"}, {"type": "subtitle", "time": 16308.07, "timestamp": "04:31:48", "text": "あなたは死んだのですか？うん。なぜ？いいえ。"}, {"type": "subtitle", "time": 16310.149, "timestamp": "04:31:50", "text": "みんな、頼むよ。君たち、君たち、君たち"}, {"type": "subtitle", "time": 16311.91, "timestamp": "04:31:51", "text": "まさか本気じゃないよね。ちょっと待ってください。私"}, {"type": "subtitle", "time": 16313.91, "timestamp": "04:31:53", "text": "その時、私は来て死ぬでしょう。私に"}]
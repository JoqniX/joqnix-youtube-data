[{"type": "subtitle", "time": 12842.309, "timestamp": "03:34:02", "text": "1,000 uh KVPS。うわー、最低ビットレート"}, {"type": "subtitle", "time": 12844.429, "timestamp": "03:34:04", "text": "それは私のためのものだった。"}, {"type": "subtitle", "time": 12847.59, "timestamp": "03:34:07", "text": "ニース。やっと、話せるようになった。私はそう願っています"}, {"type": "subtitle", "time": 12850.87, "timestamp": "03:34:10", "text": "聞こえる。私は文字通り"}, {"type": "subtitle", "time": 12854.95, "timestamp": "03:34:14", "text": "えーと、それで、えーと、ここに来た人たちのために"}, {"type": "subtitle", "time": 12862.15, "timestamp": "03:34:22", "text": "だから、何が起こったのか私にはわからない。私の"}, {"type": "subtitle", "time": 12865.75, "timestamp": "03:34:25", "text": "インターネットは死んだと言えるブラウザ"}, {"type": "subtitle", "time": 12867.67, "timestamp": "03:34:27", "text": "そしてすべてが緑色のライトを点灯した"}, {"type": "subtitle", "time": 12871.429, "timestamp": "03:34:31", "text": "まるで正常に動作しているかのようだ。"}, {"type": "subtitle", "time": 12874.51, "timestamp": "03:34:34", "text": "間違いではないが、"}, {"type": "subtitle", "time": 12878.389, "timestamp": "03:34:38", "text": "インターネット。私は本当に努力しました。私は試してみました"}, {"type": "subtitle", "time": 12880.11, "timestamp": "03:34:40", "text": "多くの。私"}, {"type": "subtitle", "time": 12887.07, "timestamp": "03:34:47", "text": "たくさん試しました。私は1時間泣き続けた"}, {"type": "subtitle", "time": 12891.87, "timestamp": "03:34:51", "text": "真っ直ぐ。私は枕ちゃんを殴ったので"}, {"type": "subtitle", "time": 12894.79, "timestamp": "03:34:54", "text": "あまり叫ばなかったし、私はあまり叫ばなかった"}, {"type": "subtitle", "time": 12897.11, "timestamp": "03:34:57", "text": "大家さんが寝ているから。私はそうは思わない"}, {"type": "subtitle", "time": 12899.67, "timestamp": "03:34:59", "text": "騒音を出したくなかった"}]
[{"type": "subtitle", "time": 11581.67, "timestamp": "03:13:01", "text": "死ぬ。もう死んでしまおう。そんなに難しくないよ。"}, {"type": "subtitle", "time": 11583.269, "timestamp": "03:13:03", "text": "それは、私たちはただそれをプレイしているだけです"}, {"type": "subtitle", "time": 11585.349, "timestamp": "03:13:05", "text": "プロ。ええ、私たちはただ、"}, {"type": "subtitle", "time": 11587.91, "timestamp": "03:13:07", "text": "不動産のようなものだと考えている。うん、"}, {"type": "subtitle", "time": 11590.15, "timestamp": "03:13:10", "text": "私たちはただ、家を転売しているだけなんです。"}, {"type": "subtitle", "time": 11592.309, "timestamp": "03:13:12", "text": "誰が気にするっていうんだ？ええ、まさにその通りです。を除外する"}, {"type": "subtitle", "time": 11594.71, "timestamp": "03:13:14", "text": "幽霊のために。誰も気にしない。うん。いいえ、"}, {"type": "subtitle", "time": 11597.11, "timestamp": "03:13:17", "text": "誰も気にしない。誰も気にしない。"}, {"type": "subtitle", "time": 11599.429, "timestamp": "03:13:19", "text": "何てことだ。ああ、そうですね。最後に、"}, {"type": "subtitle", "time": 11604.63, "timestamp": "03:13:24", "text": "モナーズ。神。つまらない。ボイン。懐中電灯。"}, {"type": "subtitle", "time": 11606.389, "timestamp": "03:13:26", "text": "わーい。"}, {"type": "subtitle", "time": 11608.07, "timestamp": "03:13:28", "text": "懐中電灯。"}, {"type": "subtitle", "time": 11613.83, "timestamp": "03:13:33", "text": "私は幽霊を作ることができる"}, {"type": "subtitle", "time": 11617.51, "timestamp": "03:13:37", "text": "この懐中電灯では何も見えない。"}, {"type": "subtitle", "time": 11621.91, "timestamp": "03:13:41", "text": "おお、いいね。わかった。トランシーバー用UVライト。誰か"}, {"type": "subtitle", "time": 11630.15, "timestamp": "03:13:50", "text": "ええと、EMマップを撮ることができます。"}, {"type": "subtitle", "time": 11637.389, "timestamp": "03:13:57", "text": "ゲーマー用のカメラを持っていくかもしれません"}]
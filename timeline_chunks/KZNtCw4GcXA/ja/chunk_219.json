[{"type": "subtitle", "time": 13140.349, "timestamp": "03:39:00", "text": "瞬間だが"}, {"type": "subtitle", "time": 13148.429, "timestamp": "03:39:08", "text": "えっと、私は"}, {"type": "subtitle", "time": 13150.91, "timestamp": "03:39:10", "text": "本当に欲しいし、私は"}, {"type": "subtitle", "time": 13153.67, "timestamp": "03:39:13", "text": "続く。でも、私の中にはこう感じる部分もある"}, {"type": "subtitle", "time": 13156.19, "timestamp": "03:39:16", "text": "のように"}, {"type": "subtitle", "time": 13159.99, "timestamp": "03:39:19", "text": "暗いので、ストリームを締め切ります。だから私は"}, {"type": "subtitle", "time": 13167.07, "timestamp": "03:39:27", "text": "えっと、私は"}, {"type": "subtitle", "time": 13169.51, "timestamp": "03:39:29", "text": "ああ、私が好きなことの一つは"}, {"type": "subtitle", "time": 13171.75, "timestamp": "03:39:31", "text": "文字通り、皆さんに感謝するだけです"}, {"type": "subtitle", "time": 13172.91, "timestamp": "03:39:32", "text": "来る"}, {"type": "subtitle", "time": 13175.269, "timestamp": "03:39:35", "text": "による。それが私ができる唯一のことです"}, {"type": "subtitle", "time": 13179.269, "timestamp": "03:39:39", "text": "今。そして、特に"}, {"type": "subtitle", "time": 13183.349, "timestamp": "03:39:43", "text": "特にセレスティアとリックに感謝します"}, {"type": "subtitle", "time": 13186.67, "timestamp": "03:39:46", "text": "私を遊びに誘う"}, {"type": "subtitle", "time": 13189.03, "timestamp": "03:39:49", "text": "ファズモフォビア。でも最初の"}, {"type": "subtitle", "time": 13191.71, "timestamp": "03:39:51", "text": "2試合"}, {"type": "subtitle", "time": 13194.91, "timestamp": "03:39:54", "text": "泣きながら寝るように"}, {"type": "subtitle", "time": 13199.59, "timestamp": "03:39:59", "text": "1時間前。私はとても"}]
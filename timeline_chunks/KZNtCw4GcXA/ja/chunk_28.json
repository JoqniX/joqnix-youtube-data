[{"type": "subtitle", "time": 1690.35, "timestamp": "00:28:10", "text": "現在、私は何を"}, {"type": "subtitle", "time": 1694.11, "timestamp": "00:28:14", "text": "する？私は気にしない。私はできる、あなたは"}, {"type": "subtitle", "time": 1697.71, "timestamp": "00:28:17", "text": "わかってるけど、私のマイクは"}, {"type": "subtitle", "time": 1700.87, "timestamp": "00:28:20", "text": "行くと、どうやらPNGは使えないようです"}, {"type": "subtitle", "time": 1702.83, "timestamp": "00:28:22", "text": "ビリーのモデル"}, {"type": "subtitle", "time": 1706.71, "timestamp": "00:28:26", "text": "ビリー。理解できない。"}, {"type": "subtitle", "time": 1709.19, "timestamp": "00:28:29", "text": "一致する結果が見つかりました。彼らが無料で提供していることは知っています"}, {"type": "subtitle", "time": 1712.19, "timestamp": "00:28:32", "text": "何千もの無料モデルを"}, {"type": "subtitle", "time": 1715.789, "timestamp": "00:28:35", "text": "人々。信じられないほど無料"}, {"type": "subtitle", "time": 1718.35, "timestamp": "00:28:38", "text": "モデル。"}, {"type": "subtitle", "time": 1720.43, "timestamp": "00:28:40", "text": "しかし"}]
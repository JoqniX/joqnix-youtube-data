[{"type": "subtitle", "time": 18002.03, "timestamp": "05:00:02", "text": "遅い。少し遅すぎます。しかし"}, {"type": "subtitle", "time": 18013.51, "timestamp": "05:00:13", "text": "みんな。ちょっと待って。今は4時30分です。私"}, {"type": "subtitle", "time": 18016.788, "timestamp": "05:00:16", "text": "正直、戻りたくなかった"}, {"type": "subtitle", "time": 18017.708, "timestamp": "05:00:17", "text": "本当に"}, {"type": "subtitle", "time": 18021.51, "timestamp": "05:00:21", "text": "遅くなったけど、休息が必要だと感じた。"}, {"type": "subtitle", "time": 18025.27, "timestamp": "05:00:25", "text": "だから私は彼女を休ませた。"}, {"type": "subtitle", "time": 18027.15, "timestamp": "05:00:27", "text": "それで、"}, {"type": "subtitle", "time": 18029.15, "timestamp": "05:00:29", "text": "それで"}, {"type": "subtitle", "time": 18031.628, "timestamp": "05:00:31", "text": "したがって"}, {"type": "subtitle", "time": 18042.75, "timestamp": "05:00:42", "text": "夕方に"}, {"type": "subtitle", "time": 18046.55, "timestamp": "05:00:46", "text": "セッション。私がオンになっているかもう一度確認させてください"}, {"type": "subtitle", "time": 18048.628, "timestamp": "05:00:48", "text": "ストリーム。はい、配信中です。では"}, {"type": "subtitle", "time": 18051.948, "timestamp": "05:00:51", "text": "夕方のセッションで、いくつかやりたいことがあります"}, {"type": "subtitle", "time": 18054.628, "timestamp": "05:00:54", "text": "もの。もちろん、私は"}, {"type": "subtitle", "time": 18057.948, "timestamp": "05:00:57", "text": "Valerantやその他のゲームをプレイする"}]
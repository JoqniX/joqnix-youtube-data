[{"type": "subtitle", "time": 5293.59, "timestamp": "01:28:13", "text": "影が移動する。"}, {"type": "subtitle", "time": 5306.39, "timestamp": "01:28:26", "text": "彼らが前に示してくれる敬意が大好きです"}, {"type": "subtitle", "time": 5310.149, "timestamp": "01:28:30", "text": "競争的な試合を始めましょう"}, {"type": "subtitle", "time": 5311.669, "timestamp": "01:28:31", "text": "相性が良い"}, {"type": "subtitle", "time": 5315.27, "timestamp": "01:28:35", "text": "あれ。それは良いことだ。私はなりたい"}, {"type": "subtitle", "time": 5317.07, "timestamp": "01:28:37", "text": "日本と共に"}, {"type": "subtitle", "time": 5320.87, "timestamp": "01:28:40", "text": "今。彼らはとても礼儀正しく、"}, {"type": "subtitle", "time": 5324.669, "timestamp": "01:28:44", "text": "そして、挑発しない限り、"}, {"type": "subtitle", "time": 5329.91, "timestamp": "01:28:49", "text": "彼らは、彼らが言うことは、私は思う"}, {"type": "subtitle", "time": 5331.79, "timestamp": "01:28:51", "text": "私はしません"}]
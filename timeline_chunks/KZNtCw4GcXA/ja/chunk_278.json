[{"type": "subtitle", "time": 16684.39, "timestamp": "04:38:04", "text": "チャック、それは幽霊なんかじゃないよ。来て。何"}, {"type": "subtitle", "time": 16686.551, "timestamp": "04:38:06", "text": "ドアのことですか？どこにいるの？"}, {"type": "subtitle", "time": 16689.349, "timestamp": "04:38:09", "text": "ドアを閉める。私は2階にいます。あなたは"}, {"type": "subtitle", "time": 16690.869, "timestamp": "04:38:10", "text": "2階？"}, {"type": "subtitle", "time": 16692.349, "timestamp": "04:38:12", "text": "あなたは"}, {"type": "subtitle", "time": 16695.75, "timestamp": "04:38:15", "text": "大丈夫。大丈夫だよ。"}, {"type": "subtitle", "time": 16698.31, "timestamp": "04:38:18", "text": "大丈夫だよ。大丈夫ですよ。あなたは何を"}, {"type": "subtitle", "time": 16701.349, "timestamp": "04:38:21", "text": "平均？ああ、勇敢なあなたを見て"}, {"type": "subtitle", "time": 16703.869, "timestamp": "04:38:23", "text": "一人ぼっちで"}, {"type": "subtitle", "time": 16708.189, "timestamp": "04:38:28", "text": "階段。君を見てごらん。"}, {"type": "subtitle", "time": 16710.709, "timestamp": "04:38:30", "text": "でも、ああ、ピアノを弾くつもりなの？"}, {"type": "subtitle", "time": 16714.15, "timestamp": "04:38:34", "text": "ここ？おお、いいね。あなたはしたい あなたはしたい"}, {"type": "subtitle", "time": 16716.31, "timestamp": "04:38:36", "text": "音色を作るような？うん。うん。うん。"}, {"type": "subtitle", "time": 16718.07, "timestamp": "04:38:38", "text": "はい、はい、はい、はい。ジャックみたいに、"}, {"type": "subtitle", "time": 16720.31, "timestamp": "04:38:40", "text": "一体どこにいるんだ？開けました"}, {"type": "subtitle", "time": 16722.109, "timestamp": "04:38:42", "text": "すべて。ありがとう、"}, {"type": "subtitle", "time": 16729.109, "timestamp": "04:38:49", "text": "ところで、あなたはどこにいるのですか？はい、私はただ"}, {"type": "subtitle", "time": 16731.189, "timestamp": "04:38:51", "text": "紫外線関連のものを探しています。ください"}]
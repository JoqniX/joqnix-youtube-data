[{"type": "subtitle", "time": 17644.55, "timestamp": "04:54:04", "text": "私もテラリアをプレイしたい"}, {"type": "subtitle", "time": 17645.99, "timestamp": "04:54:05", "text": "遊び方がわからないから"}, {"type": "subtitle", "time": 17649.51, "timestamp": "04:54:09", "text": "テラリア。私も。"}, {"type": "subtitle", "time": 17651.67, "timestamp": "04:54:11", "text": "2D版マインクラフト。"}, {"type": "subtitle", "time": 17655.43, "timestamp": "04:54:15", "text": "ええ、2Dのことです。 2D版マインクラフト。はい、2Dです"}, {"type": "subtitle", "time": 17659.03, "timestamp": "04:54:19", "text": "マインクラフト。マインクラフト。私は掘ったのが好きです"}, {"type": "subtitle", "time": 17661.35, "timestamp": "04:54:21", "text": "2ブロック進んだところで、私は死んだ。私が言いたいのはそれだけです"}, {"type": "subtitle", "time": 17663.27, "timestamp": "04:54:23", "text": "持っていた。"}, {"type": "subtitle", "time": 17664.788, "timestamp": "04:54:24", "text": "わからない。それが何なのかさえわからない"}, {"type": "subtitle", "time": 17667.75, "timestamp": "04:54:27", "text": "可能だが、掘り下げて死んだ"}, {"type": "subtitle", "time": 17673.75, "timestamp": "04:54:33", "text": "でも、変なことにシャベルを手に入れた"}, {"type": "subtitle", "time": 17676.59, "timestamp": "04:54:36", "text": "理由。"}, {"type": "subtitle", "time": 17679.51, "timestamp": "04:54:39", "text": "まあ、そういうことだ。ああ、セレスティアよ、"}, {"type": "subtitle", "time": 17682.708, "timestamp": "04:54:42", "text": "複数できる場合"}, {"type": "subtitle", "time": 17687.99, "timestamp": "04:54:47", "text": "コラボ、ディワルとオーみたいにできますか？"}, {"type": "subtitle", "time": 17690.948, "timestamp": "04:54:50", "text": "家に帰る。家に帰る。もしあなたがもしかしたら"}, {"type": "subtitle", "time": 17694.55, "timestamp": "04:54:54", "text": "彼らが許可すれば、複数回"}, {"type": "subtitle", "time": 17697.11, "timestamp": "04:54:57", "text": "「できる」は私のものなら、私は疑わしいと思う。私たちは"}]
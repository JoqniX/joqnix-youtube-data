[{"type": "subtitle", "time": 10865.429, "timestamp": "03:01:05", "text": "これは、何でも買えるお金です。"}, {"type": "subtitle", "time": 10866.95, "timestamp": "03:01:06", "text": "さあ、行こう。ああ、お金がないんです。"}, {"type": "subtitle", "time": 10868.63, "timestamp": "03:01:08", "text": "いいね。それでいいんだよ。待って、知ってるでしょ"}, {"type": "subtitle", "time": 10870.55, "timestamp": "03:01:10", "text": "何？ゼロから悪夢へと飛び込もう"}, {"type": "subtitle", "time": 10872.71, "timestamp": "03:01:12", "text": "モード。さあ行こう。ああ、おやすみ。ああ、私たちは"}, {"type": "subtitle", "time": 10875.19, "timestamp": "03:01:15", "text": "悪夢モードを実行中。はい、それは"}, {"type": "subtitle", "time": 10877.67, "timestamp": "03:01:17", "text": "お金。誰が気にする？それは最も難しいことではないでしょうか"}, {"type": "subtitle", "time": 10881.19, "timestamp": "03:01:21", "text": "1つ？待って。いや、いや、いや。いや、いや、いや。"}, {"type": "subtitle", "time": 10882.63, "timestamp": "03:01:22", "text": "同様の力でそれを克服する"}, {"type": "subtitle", "time": 10884.71, "timestamp": "03:01:24", "text": "友情。友情。もちろん。の"}, {"type": "subtitle", "time": 10887.429, "timestamp": "03:01:27", "text": "コース。準備完了。準備しろ、ジャック。我々はできる"}, {"type": "subtitle", "time": 10889.59, "timestamp": "03:01:29", "text": "これをしてください。わかった。うん、できるよ。私"}, {"type": "subtitle", "time": 10892.87, "timestamp": "03:01:32", "text": "私たちを信じてください。笑顔。私たちはもっと失う可能性がある"}, {"type": "subtitle", "time": 10894.55, "timestamp": "03:01:34", "text": "ゼロドルよりはマシだよ。来て。"}, {"type": "subtitle", "time": 10896.99, "timestamp": "03:01:36", "text": "さあ行こう。"}, {"type": "subtitle", "time": 10901.59, "timestamp": "03:01:41", "text": "わかった。こんにちは。最善を尽くします。はい。"}, {"type": "subtitle", "time": 10905.75, "timestamp": "03:01:45", "text": "全員準備完了です。はい。それでは始めましょう。おお。"}, {"type": "subtitle", "time": 10908.95, "timestamp": "03:01:48", "text": "何てことだ。法廷を見る。この地図は何ですか？"}, {"type": "subtitle", "time": 10911.269, "timestamp": "03:01:51", "text": "また？大柄な男性ですか？ああ、小さい"}, {"type": "subtitle", "time": 10912.51, "timestamp": "03:01:52", "text": "1つ。わかった、"}, {"type": "subtitle", "time": 10915.269, "timestamp": "03:01:55", "text": "ニース。小さい。"}, {"type": "subtitle", "time": 10919.75, "timestamp": "03:01:59", "text": "小さすぎる。私は何も知りません。ヘルプ。"}]
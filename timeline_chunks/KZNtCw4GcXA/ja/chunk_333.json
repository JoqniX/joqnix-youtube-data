[{"type": "subtitle", "time": 19980.708, "timestamp": "05:33:00", "text": "昔、何人かの人を覚えている、あるいは"}, {"type": "subtitle", "time": 19983.03, "timestamp": "05:33:03", "text": "コメントを見た記憶があると思います"}, {"type": "subtitle", "time": 19986.03, "timestamp": "05:33:06", "text": "知らない言及"}, {"type": "subtitle", "time": 19990.51, "timestamp": "05:33:10", "text": "私は自分自身をさらに制限している"}, {"type": "subtitle", "time": 19996.15, "timestamp": "05:33:16", "text": "今は自由か、もっと自由か、といったことよりも"}, {"type": "subtitle", "time": 20004.628, "timestamp": "05:33:24", "text": "それで、これはどこで、なぜなのか疑問に思います"}, {"type": "subtitle", "time": 20008.47, "timestamp": "05:33:28", "text": "浮遊物が出てきた 出てきた"}, {"type": "subtitle", "time": 20010.91, "timestamp": "05:33:30", "text": "その周り。私"}, {"type": "subtitle", "time": 20017.39, "timestamp": "05:33:37", "text": "[音楽]"}, {"type": "subtitle", "time": 20022.07, "timestamp": "05:33:42", "text": "だから、制限か"}, {"type": "subtitle", "time": 20023.948, "timestamp": "05:33:43", "text": "私は本当に"}, {"type": "subtitle", "time": 20032.19, "timestamp": "05:33:52", "text": "ああ、[ __ ]は悪い"}, {"type": "subtitle", "time": 20037.95, "timestamp": "05:33:57", "text": "悪い。"}, {"type": "subtitle", "time": 20039.31, "timestamp": "05:33:59", "text": "[音楽]"}]
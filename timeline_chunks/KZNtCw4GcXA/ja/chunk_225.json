[{"type": "subtitle", "time": 13501.92, "timestamp": "03:45:01", "text": "けれど。何てことだ。ヴィックを見て。 彼は猫のような目をしている。何てことだ。そして"}, {"type": "subtitle", "time": 13504.56, "timestamp": "03:45:04", "text": "彼は猫のような目をしている。何てことだ。そして それは文字通り私です"}, {"type": "subtitle", "time": 13507.08, "timestamp": "03:45:07", "text": "それは文字通り私です 隠れて"}, {"type": "subtitle", "time": 13517.469, "timestamp": "03:45:17", "text": "シャイ。しかし"}, {"type": "subtitle", "time": 13520.67, "timestamp": "03:45:20", "text": "うん、でも大丈夫だよ。えっと"}, {"type": "subtitle", "time": 13523.11, "timestamp": "03:45:23", "text": "今月か来月には、"}, {"type": "subtitle", "time": 13526.95, "timestamp": "03:45:26", "text": "ホラーゲームをプレイする予定です。それは"}, {"type": "subtitle", "time": 13529.07, "timestamp": "03:45:29", "text": "今日以降"}, {"type": "subtitle", "time": 13532.229, "timestamp": "03:45:32", "text": "明日。私はパラソーシャルを演じるつもりです"}, {"type": "subtitle", "time": 13534.67, "timestamp": "03:45:34", "text": "また、devour コラボレーションもあります。"}, {"type": "subtitle", "time": 13537.349, "timestamp": "03:45:37", "text": "夜。すべてがどうなるかわかりません"}, {"type": "subtitle", "time": 13540.349, "timestamp": "03:45:40", "text": "その時"}, {"type": "subtitle", "time": 13547.309, "timestamp": "03:45:47", "text": "言う"}, {"type": "subtitle", "time": 13551.03, "timestamp": "03:45:51", "text": "最善を尽くします。ええ、ホラーは"}, {"type": "subtitle", "time": 13552.269, "timestamp": "03:45:52", "text": "私が持っていないもの"}, {"type": "subtitle", "time": 13554.83, "timestamp": "03:45:54", "text": "のように。それは"}, {"type": "subtitle", "time": 13558.59, "timestamp": "03:45:58", "text": "挑戦的。それは難しい。それは"}]
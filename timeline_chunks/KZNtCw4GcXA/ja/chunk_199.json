[{"type": "subtitle", "time": 11941.67, "timestamp": "03:19:01", "text": "文字通り、風の地下室に隠れている。"}, {"type": "subtitle", "time": 11945.429, "timestamp": "03:19:05", "text": "ヘルプ。はい、心配しないでください。心配しないで。"}, {"type": "subtitle", "time": 11947.67, "timestamp": "03:19:07", "text": "狩りは"}, {"type": "subtitle", "time": 11949.99, "timestamp": "03:19:09", "text": "終了しました。心配しないで。うん。待って、どこに"}, {"type": "subtitle", "time": 11962.229, "timestamp": "03:19:22", "text": "誰か、心を開いてくれないか。何てことだ。私たちです。その"}, {"type": "subtitle", "time": 11964.95, "timestamp": "03:19:24", "text": "私たち。イエス・キリスト。"}, {"type": "subtitle", "time": 11967.11, "timestamp": "03:19:27", "text": "わかった。どこに行きたいですか？私たちはそうしましたか"}, {"type": "subtitle", "time": 11969.59, "timestamp": "03:19:29", "text": "ヒューズを直す必要がある"}, {"type": "subtitle", "time": 11974.429, "timestamp": "03:19:34", "text": "またか、そうだろ？わかった。 Jさん、Jさん、それは"}, {"type": "subtitle", "time": 11976.95, "timestamp": "03:19:36", "text": "大丈夫。気にしないでください。私はただの幽霊です。"}, {"type": "subtitle", "time": 11978.95, "timestamp": "03:19:38", "text": "でも大丈夫。大丈夫。大丈夫。"}, {"type": "subtitle", "time": 11980.79, "timestamp": "03:19:40", "text": "私が先に始めます。私が行きます。私が先に進みます。"}, {"type": "subtitle", "time": 11982.07, "timestamp": "03:19:42", "text": "ご心配なく。私を放っておいて。"}, {"type": "subtitle", "time": 11985.269, "timestamp": "03:19:45", "text": "私を一人にしないでください。なぜ？なぜ？"}, {"type": "subtitle", "time": 11989.429, "timestamp": "03:19:49", "text": "おっと。なぜ？なぜ？なぜ？なぜ？なぜ？えっと、それで"}, {"type": "subtitle", "time": 11991.91, "timestamp": "03:19:51", "text": "彼、彼女、彼女はあなたにマッサージをしています、"}, {"type": "subtitle", "time": 11993.91, "timestamp": "03:19:53", "text": "あまりにも。あれを見てください。うん。その通り。"}, {"type": "subtitle", "time": 11995.92, "timestamp": "03:19:55", "text": "その通り。 ジョエット・ジョブはそれに備えていた。私はただ来た"}]
[{"type": "subtitle", "time": 18362.708, "timestamp": "05:06:02", "text": "これ？ああ、それだ。それよりも"}, {"type": "subtitle", "time": 18364.948, "timestamp": "05:06:04", "text": "このようなテキストを使うと、私は"}, {"type": "subtitle", "time": 18367.11, "timestamp": "05:06:07", "text": "むしろその方が良い"}, {"type": "subtitle", "time": 18370.67, "timestamp": "05:06:10", "text": "このようなテキストを使うよりも、"}, {"type": "subtitle", "time": 18373.67, "timestamp": "05:06:13", "text": "私はただ感じたいだけなのか 私は"}, {"type": "subtitle", "time": 18376.708, "timestamp": "05:06:16", "text": "ポップアップのようなものをしたいだけです"}, {"type": "subtitle", "time": 18379.35, "timestamp": "05:06:19", "text": "私のモデルに何か問題があるか、あるいは何か別の問題が起きているのかもしれません。"}, {"type": "subtitle", "time": 18387.15, "timestamp": "05:06:27", "text": "[音楽]"}, {"type": "subtitle", "time": 18390.43, "timestamp": "05:06:30", "text": "見栄えが良い"}, {"type": "subtitle", "time": 18392.35, "timestamp": "05:06:32", "text": "良いし"}, {"type": "subtitle", "time": 18395.67, "timestamp": "05:06:35", "text": "すべて。あくまでアイデアですが、取り組んでみます"}, {"type": "subtitle", "time": 18397.628, "timestamp": "05:06:37", "text": "その周り"}, {"type": "subtitle", "time": 18400.708, "timestamp": "05:06:40", "text": "それ。これは単なるアイデアですが、私たちは取り組みます"}, {"type": "subtitle", "time": 18403.07, "timestamp": "05:06:43", "text": "そのあたり。"}, {"type": "subtitle", "time": 18405.83, "timestamp": "05:06:45", "text": "わかった。私がなぜ自分の"}, {"type": "subtitle", "time": 18408.628, "timestamp": "05:06:48", "text": "現在のモデル。使います。私はただ"}, {"type": "subtitle", "time": 18412.23, "timestamp": "05:06:52", "text": "今日はパプアニューギニアに行きたい気分"}, {"type": "subtitle", "time": 18413.55, "timestamp": "05:06:53", "text": "このために"}, {"type": "subtitle", "time": 18416.51, "timestamp": "05:06:56", "text": "久しぶりなので、こんばんは。私"}]
[{"type": "subtitle", "time": 20345.27, "timestamp": "05:39:05", "text": "戻る。うん、頭の中にはたくさんのことが詰まっているんだ"}, {"type": "subtitle", "time": 20348.23, "timestamp": "05:39:08", "text": "今すぐ。頭の中が混乱しているのかもしれない。"}, {"type": "subtitle", "time": 20349.39, "timestamp": "05:39:09", "text": "気にしないで"}, {"type": "subtitle", "time": 20352.23, "timestamp": "05:39:12", "text": "自分。えっと、でも、おしゃべりさせてくれてありがとう。"}, {"type": "subtitle", "time": 20353.788, "timestamp": "05:39:13", "text": "それ"}, {"type": "subtitle", "time": 20359.75, "timestamp": "05:39:19", "text": "外。しゃべりまくれ。新しいものを使っています"}, {"type": "subtitle", "time": 20367.788, "timestamp": "05:39:27", "text": "私はZ世代の言葉を使っています。"}, {"type": "subtitle", "time": 20369.04, "timestamp": "05:39:29", "text": "おお。"}, {"type": "subtitle", "time": 20371.628, "timestamp": "05:39:31", "text": "[音楽]"}, {"type": "subtitle", "time": 20374.868, "timestamp": "05:39:34", "text": "くそ。実はジェンズの言葉を使ってるんです。"}, {"type": "subtitle", "time": 20398.07, "timestamp": "05:39:58", "text": "みんなそれぞれ好きなようにしている"}]
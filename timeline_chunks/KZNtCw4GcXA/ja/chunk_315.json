[{"type": "subtitle", "time": 18901.67, "timestamp": "05:15:01", "text": "セッションが欲しかったかどうか疑問に思う"}, {"type": "subtitle", "time": 18905.628, "timestamp": "05:15:05", "text": "人々はそれを通知することができるか何か"}, {"type": "subtitle", "time": 18908.47, "timestamp": "05:15:08", "text": "どうにか。メッセージをピン留めする場合のみ"}, {"type": "subtitle", "time": 18911.67, "timestamp": "05:15:11", "text": "YouTubeやTwitchで何か。"}, {"type": "subtitle", "time": 18913.67, "timestamp": "05:15:13", "text": "もしそれを自動化できれば、"}, {"type": "subtitle", "time": 18916.868, "timestamp": "05:15:16", "text": "でも、本当に良かったよ。と言えば"}, {"type": "subtitle", "time": 18920.31, "timestamp": "05:15:20", "text": "つまり、YouTubeはその組み合わせをリリースするということだ。"}, {"type": "subtitle", "time": 18922.948, "timestamp": "05:15:22", "text": "垂直ストリーミング機能、右、"}, {"type": "subtitle", "time": 18924.27, "timestamp": "05:15:24", "text": "では"}, {"type": "subtitle", "time": 18927.03, "timestamp": "05:15:27", "text": "私たち。それは良いことだと思う"}, {"type": "subtitle", "time": 18930.47, "timestamp": "05:15:30", "text": "良いことだ。なかなかいい感じ。彼らは作っている"}, {"type": "subtitle", "time": 18933.07, "timestamp": "05:15:33", "text": "信じられないほどTikTokのような"}, {"type": "subtitle", "time": 18941.35, "timestamp": "05:15:41", "text": "それは私に考えさせるので、"}, {"type": "subtitle", "time": 18943.67, "timestamp": "05:15:43", "text": "考えてみてください、何が起こるか"}, {"type": "subtitle", "time": 18944.83, "timestamp": "05:15:44", "text": "水平"}, {"type": "subtitle", "time": 18947.43, "timestamp": "05:15:47", "text": "ストリーミング配信。みんな行くの？"}, {"type": "subtitle", "time": 18956.99, "timestamp": "05:15:56", "text": "最近では？縦方向もできます"}]
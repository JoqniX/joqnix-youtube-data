[{"type": "subtitle", "time": 13086.269, "timestamp": "03:38:06", "text": "神。本当にそう思ってるの？"}, {"type": "subtitle", "time": 13089.269, "timestamp": "03:38:09", "text": "今？いや、待って。そして待って、待って、待って、"}, {"type": "subtitle", "time": 13090.52, "timestamp": "03:38:10", "text": "待って、待って、 待って。とんでもない。正常に動作しています"}, {"type": "subtitle", "time": 13099.71, "timestamp": "03:38:19", "text": "今。"}, {"type": "subtitle", "time": 13102.79, "timestamp": "03:38:22", "text": "おお。ただただすごい。"}, {"type": "subtitle", "time": 13106.349, "timestamp": "03:38:26", "text": "今日、長い間ぶりに"}, {"type": "subtitle", "time": 13111.229, "timestamp": "03:38:31", "text": "その間、私はそれがどんな感じかを感じました"}, {"type": "subtitle", "time": 13114.19, "timestamp": "03:38:34", "text": "技術的に感じる"}, {"type": "subtitle", "time": 13116.71, "timestamp": "03:38:36", "text": "挑戦を受けた。どんな言葉であれ私は"}, {"type": "subtitle", "time": 13117.79, "timestamp": "03:38:37", "text": "探しています"}, {"type": "subtitle", "time": 13120.71, "timestamp": "03:38:40", "text": "のために。とはいえ、ずいぶん前のことだ。その"}, {"type": "subtitle", "time": 13125.19, "timestamp": "03:38:45", "text": "文字通り長い間、そしてその間"}, {"type": "subtitle", "time": 13127.91, "timestamp": "03:38:47", "text": "君は理解していない"}, {"type": "subtitle", "time": 13133.11, "timestamp": "03:38:53", "text": "こんなに長い間感じてなかった"}, {"type": "subtitle", "time": 13135.51, "timestamp": "03:38:55", "text": "技術的な問題が多すぎる"}, {"type": "subtitle", "time": 13138.03, "timestamp": "03:38:58", "text": "同時に起こる"}]
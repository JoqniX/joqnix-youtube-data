[{"type": "subtitle", "time": 15423.87, "timestamp": "04:17:03", "text": "[音楽]"}, {"type": "subtitle", "time": 15427.03, "timestamp": "04:17:07", "text": "行くよ。今のところ、これはどのように使っていますか？私"}, {"type": "subtitle", "time": 15430.63, "timestamp": "04:17:10", "text": "わからない。使えないみたいですね。"}, {"type": "subtitle", "time": 15432.99, "timestamp": "04:17:12", "text": "使用できません"}, {"type": "subtitle", "time": 15434.67, "timestamp": "04:17:14", "text": "ゴヤ。"}, {"type": "subtitle", "time": 15437.07, "timestamp": "04:17:17", "text": "今のところはゴヤで。"}, {"type": "subtitle", "time": 15440.229, "timestamp": "04:17:20", "text": "うん。そしてジャマ。うん。ええ、そうですね。えっと"}, {"type": "subtitle", "time": 15441.99, "timestamp": "04:17:21", "text": "複数視聴できることをお知らせします"}, {"type": "subtitle", "time": 15445.189, "timestamp": "04:17:25", "text": "ストリームは両方で利用可能です。"}, {"type": "subtitle", "time": 15448.149, "timestamp": "04:17:28", "text": "セレスティアが配信中。 Vicはストリーミング配信しており、"}, {"type": "subtitle", "time": 15450.149, "timestamp": "04:17:30", "text": "私も配信しています。全てのサポートをお願いします"}, {"type": "subtitle", "time": 15452.79, "timestamp": "04:17:32", "text": "私たち。えっと、まだ登録していない場合は、"}, {"type": "subtitle", "time": 15454.71, "timestamp": "04:17:34", "text": "ご希望であれば、"}, {"type": "subtitle", "time": 15458.149, "timestamp": "04:17:38", "text": "彼ら。それはあなた次第です。私が"}, {"type": "subtitle", "time": 15459.83, "timestamp": "04:17:39", "text": "チャットをあまり読めなくなる"}, {"type": "subtitle", "time": 15462.07, "timestamp": "04:17:42", "text": "今日は集中しなければならないので"}, {"type": "subtitle", "time": 15465.429, "timestamp": "04:17:45", "text": "ストリーム。ですから、私が"}, {"type": "subtitle", "time": 15467.99, "timestamp": "04:17:47", "text": "チャットは見るけど、"}, {"type": "subtitle", "time": 15470.389, "timestamp": "04:17:50", "text": "声に出して読むことができるか、"}, {"type": "subtitle", "time": 15472.55, "timestamp": "04:17:52", "text": "時々チャットに対応するのは、"}, {"type": "subtitle", "time": 15475.11, "timestamp": "04:17:55", "text": "シュリモカに焦点を当てますが、"}, {"type": "subtitle", "time": 15477.75, "timestamp": "04:17:57", "text": "それを見ている。検討してみます。"}]
[{"type": "subtitle", "time": 11520.75, "timestamp": "03:12:00", "text": "あっという間に死んでしまう。"}, {"type": "subtitle", "time": 11522.95, "timestamp": "03:12:02", "text": "中級。あのね？"}, {"type": "subtitle", "time": 11524.63, "timestamp": "03:12:04", "text": "プロ。"}, {"type": "subtitle", "time": 11526.71, "timestamp": "03:12:06", "text": "プロとしてやろう。"}, {"type": "subtitle", "time": 11528.63, "timestamp": "03:12:08", "text": "中級は"}, {"type": "subtitle", "time": 11530.95, "timestamp": "03:12:10", "text": "もしあなたが"}, {"type": "subtitle", "time": 11532.389, "timestamp": "03:12:12", "text": "中級レベルに進む予定です。プロ、"}, {"type": "subtitle", "time": 11535.91, "timestamp": "03:12:15", "text": "私は思う。早く死ぬか、そうでないか。誰も気にしない。"}, {"type": "subtitle", "time": 11538.23, "timestamp": "03:12:18", "text": "さあ、やってみよう。"}, {"type": "subtitle", "time": 11547.309, "timestamp": "03:12:27", "text": "わーい。"}, {"type": "subtitle", "time": 11564.389, "timestamp": "03:12:44", "text": "そうそう。続けて。私はまだ忘れてしまう"}, {"type": "subtitle", "time": 11566.95, "timestamp": "03:12:46", "text": "我々が死んだら、荷物を失うことになる。ええ、そうです"}, {"type": "subtitle", "time": 11570.95, "timestamp": "03:12:50", "text": "大丈夫。大丈夫です。"}, {"type": "subtitle", "time": 11573.91, "timestamp": "03:12:53", "text": "それはあり得る話なのか、それとも違う話なのか？ええ、それは"}, {"type": "subtitle", "time": 11576.309, "timestamp": "03:12:56", "text": "もの。うん、大丈夫だよ。死ぬなよ。"}, {"type": "subtitle", "time": 11578.389, "timestamp": "03:12:58", "text": "大丈夫です。うん、みんなで"}]
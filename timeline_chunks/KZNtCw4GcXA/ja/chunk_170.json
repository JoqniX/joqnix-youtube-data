[{"type": "subtitle", "time": 10201.55, "timestamp": "02:50:01", "text": "朝食。えっと、ランチ"}, {"type": "subtitle", "time": 10205.11, "timestamp": "02:50:05", "text": "壊す。また戻ってきます。すべてをお楽しみください"}, {"type": "subtitle", "time": 10207.67, "timestamp": "02:50:07", "text": "あなた。食べて、水分補給して、そういうことを全部やって。"}, {"type": "subtitle", "time": 10209.07, "timestamp": "02:50:09", "text": "来る"}, {"type": "subtitle", "time": 10211.51, "timestamp": "02:50:11", "text": "戻る。よし。気をつけて。私は"}, {"type": "subtitle", "time": 10212.67, "timestamp": "02:50:12", "text": "戻る。"}]
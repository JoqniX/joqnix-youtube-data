[{"type": "subtitle", "time": 17341.67, "timestamp": "04:49:01", "text": "する。ニース。とにかく、私が受け取ります。"}, {"type": "subtitle", "time": 17343.67, "timestamp": "04:49:03", "text": "また。拾って拾って。ここが"}, {"type": "subtitle", "time": 17345.11, "timestamp": "04:49:05", "text": "出てきた。拾い上げてください。拾い上げてください。わかった、"}, {"type": "subtitle", "time": 17347.628, "timestamp": "04:49:07", "text": "いいね。彼らはこれを変更したのですか？"}, {"type": "subtitle", "time": 17351.27, "timestamp": "04:49:11", "text": "地図？テントが"}, {"type": "subtitle", "time": 17353.35, "timestamp": "04:49:13", "text": "少し低いような感じのはずなのに"}, {"type": "subtitle", "time": 17356.07, "timestamp": "04:49:16", "text": "低くはない。わからない"}, {"type": "subtitle", "time": 17359.67, "timestamp": "04:49:19", "text": "彼らはこれに対してそうした。最高に楽しい。"}, {"type": "subtitle", "time": 17363.31, "timestamp": "04:49:23", "text": "さあ、ボールを打とう。そこには"}, {"type": "subtitle", "time": 17366.91, "timestamp": "04:49:26", "text": "ボール。待って、どうやって"}, {"type": "subtitle", "time": 17369.948, "timestamp": "04:49:29", "text": "ボールに？"}, {"type": "subtitle", "time": 17372.35, "timestamp": "04:49:32", "text": "ジャマハウ"}, {"type": "subtitle", "time": 17376.708, "timestamp": "04:49:36", "text": "Eを押してから拾ってG"}, {"type": "subtitle", "time": 17378.628, "timestamp": "04:49:38", "text": "それを捨てる。"}, {"type": "subtitle", "time": 17381.67, "timestamp": "04:49:41", "text": "ああ、グロ。ああ、わかりました。わかった。ええ、私たちは"}, {"type": "subtitle", "time": 17383.67, "timestamp": "04:49:43", "text": "行く。"}, {"type": "subtitle", "time": 17385.23, "timestamp": "04:49:45", "text": "それはとても"}, {"type": "subtitle", "time": 17396.15, "timestamp": "04:49:56", "text": "ああ、舞踏会気分だ。ええ、私が投げました。私"}, {"type": "subtitle", "time": 17398.55, "timestamp": "04:49:58", "text": "投げ入れた。"}]
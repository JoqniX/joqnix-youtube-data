[{"type": "subtitle", "time": 16626.789, "timestamp": "04:37:06", "text": "エイプリル、こっちにいる？おいで、ハス。"}, {"type": "subtitle", "time": 16630.789, "timestamp": "04:37:10", "text": "こんにちは、エイプリル。ああ、みんな持っているの？"}, {"type": "subtitle", "time": 16646.709, "timestamp": "04:37:26", "text": "こんにちは。あなたはここにいますか？どこにいるの？"}, {"type": "subtitle", "time": 16650.551, "timestamp": "04:37:30", "text": "何歳ですか？こんにちは、"}, {"type": "subtitle", "time": 16652.47, "timestamp": "04:37:32", "text": "4月。なぜ私は"}, {"type": "subtitle", "time": 16653.83, "timestamp": "04:37:33", "text": "地下。ドアを閉めてください"}, {"type": "subtitle", "time": 16667.91, "timestamp": "04:37:47", "text": "こんにちは？あなたはここにいますか？ドアがあります。"}, {"type": "subtitle", "time": 16674.551, "timestamp": "04:37:54", "text": "ヒューズを探しているようなものだ"}, {"type": "subtitle", "time": 16677.429, "timestamp": "04:37:57", "text": "のように"}]
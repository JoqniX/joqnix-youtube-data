[{"type": "subtitle", "time": 16740.23, "timestamp": "04:39:00", "text": "こんにちは、エイプリル。あなたはここにいますか？あなたは"}, {"type": "subtitle", "time": 16743.869, "timestamp": "04:39:03", "text": "私が一人でいる時に、私に取り憑きたいの？"}, {"type": "subtitle", "time": 16748.07, "timestamp": "04:39:08", "text": "こんにちは？あなたはここにいますか？どこにいるの？"}, {"type": "subtitle", "time": 16751.67, "timestamp": "04:39:11", "text": "何歳ですか？"}, {"type": "subtitle", "time": 16754.789, "timestamp": "04:39:14", "text": "待てよ、ヒューズはどこだっけ？"}, {"type": "subtitle", "time": 16758.709, "timestamp": "04:39:18", "text": "わかりました。ああ、その通りだ。"}, {"type": "subtitle", "time": 16769.39, "timestamp": "04:39:29", "text": "ライト。おお。ああ、大したことじゃないよ。おお"}, {"type": "subtitle", "time": 16777.23, "timestamp": "04:39:37", "text": "おい。ええ、照明は用意しました。"}, {"type": "subtitle", "time": 16778.788, "timestamp": "04:39:38", "text": "[音楽]"}, {"type": "subtitle", "time": 16783.59, "timestamp": "04:39:43", "text": "こんにちは。"}, {"type": "subtitle", "time": 16786.15, "timestamp": "04:39:46", "text": "あなたはここにいますか？エイプリル、ここにいる？"}, {"type": "subtitle", "time": 16789.03, "timestamp": "04:39:49", "text": "私たちと話したいですか？何歳ですか"}, {"type": "subtitle", "time": 16795.43, "timestamp": "04:39:55", "text": "年齢を聞いてくれるのがいいですね"}, {"type": "subtitle", "time": 16798.23, "timestamp": "04:39:58", "text": "あなた。ああ、それはデフォルト設定みたいなものですね。それは"}, {"type": "subtitle", "time": 16799.99, "timestamp": "04:39:59", "text": "当然尋ねなければならないこと"}]
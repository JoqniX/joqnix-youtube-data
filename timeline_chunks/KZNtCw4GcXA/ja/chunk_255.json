[{"type": "subtitle", "time": 15301.59, "timestamp": "04:15:01", "text": "説明。今追加しました。あなた"}, {"type": "subtitle", "time": 15304.269, "timestamp": "04:15:04", "text": "ご希望であれば記入していただけますか？"}, {"type": "subtitle", "time": 15307.149, "timestamp": "04:15:07", "text": "気に入ったらサポートしてください"}, {"type": "subtitle", "time": 15312.79, "timestamp": "04:15:12", "text": "仕事に応募します。どうぞ記入してください"}, {"type": "subtitle", "time": 15315.51, "timestamp": "04:15:15", "text": "形式も全て。締め切り"}, {"type": "subtitle", "time": 15318.189, "timestamp": "04:15:18", "text": "フォームは"}, {"type": "subtitle", "time": 15322.83, "timestamp": "04:15:22", "text": "10月26日。次は"}, {"type": "subtitle", "time": 15324.79, "timestamp": "04:15:24", "text": "木曜日。それは、"}, {"type": "subtitle", "time": 15329.469, "timestamp": "04:15:29", "text": "言いたかったのは"}, {"type": "subtitle", "time": 15332.67, "timestamp": "04:15:32", "text": "今日。でも、楽しみにしています"}, {"type": "subtitle", "time": 15335.189, "timestamp": "04:15:35", "text": "今日。気のせいかな、それとも君が途中でやめているのかな？"}, {"type": "subtitle", "time": 15336.95, "timestamp": "04:15:36", "text": "待って、今から切り上げるよ。待って、私は"}, {"type": "subtitle", "time": 15340.349, "timestamp": "04:15:40", "text": "切り捨てる。待って、"}, {"type": "subtitle", "time": 15344.469, "timestamp": "04:15:44", "text": "え、本当に？"}, {"type": "subtitle", "time": 15346.83, "timestamp": "04:15:46", "text": "私は切り捨てています。"}, {"type": "subtitle", "time": 15350.51, "timestamp": "04:15:50", "text": "何？え、何？"}, {"type": "subtitle", "time": 15353.99, "timestamp": "04:15:53", "text": "H. ああ、いやだ。私は辞めます。これはまずい。"}, {"type": "subtitle", "time": 15355.309, "timestamp": "04:15:55", "text": "これは"}]
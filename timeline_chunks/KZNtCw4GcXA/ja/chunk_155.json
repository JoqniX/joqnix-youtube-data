[{"type": "subtitle", "time": 9309.27, "timestamp": "02:35:09", "text": "禅。待って。禅。待って。何？何？何？"}, {"type": "subtitle", "time": 9313.79, "timestamp": "02:35:13", "text": "待って、待って、待って、待って。禅マシャビ。禅"}, {"type": "subtitle", "time": 9325.27, "timestamp": "02:35:25", "text": "それ？こんにちは。私は唯一のボトムフラッガーです"}, {"type": "subtitle", "time": 9328.03, "timestamp": "02:35:28", "text": "このチームでは。"}, {"type": "subtitle", "time": 9331.27, "timestamp": "02:35:31", "text": "ニース。最下位のフラッガーに会えて嬉しいよ。"}, {"type": "subtitle", "time": 9340.07, "timestamp": "02:35:40", "text": "私はまだ準備ができていません。"}]
[{"type": "subtitle", "time": 17042.55, "timestamp": "04:44:02", "text": "ただ解くだけではダメだ。もしあなたが"}, {"type": "subtitle", "time": 17045.27, "timestamp": "04:44:05", "text": "運試しだ、行こう。おかえり。私"}, {"type": "subtitle", "time": 17047.35, "timestamp": "04:44:07", "text": "そんなことは決してなかった"}, {"type": "subtitle", "time": 17049.91, "timestamp": "04:44:09", "text": "心。これはジンです。これはジンです。それは"}, {"type": "subtitle", "time": 17053.75, "timestamp": "04:44:13", "text": "大丈夫。これは発見された証拠です。電磁界"}, {"type": "subtitle", "time": 17056.788, "timestamp": "04:44:16", "text": "リーダー。誰が？誰がやったんだ？ああ、私は"}, {"type": "subtitle", "time": 17060.07, "timestamp": "04:44:20", "text": "電磁場測定器。私は死ぬ直前にその権利を持っていた。"}, {"type": "subtitle", "time": 17063.55, "timestamp": "04:44:23", "text": "さあ、行こう。私たちは25ドル手に入れた。さあ行こう。"}, {"type": "subtitle", "time": 17066.708, "timestamp": "04:44:26", "text": "わーい。さあ行こう。お金は手に入れた。もっと手に入れました"}, {"type": "subtitle", "time": 17067.75, "timestamp": "04:44:27", "text": "お金。"}, {"type": "subtitle", "time": 17069.43, "timestamp": "04:44:29", "text": "[音楽]"}, {"type": "subtitle", "time": 17071.51, "timestamp": "04:44:31", "text": "大丈夫です。"}, {"type": "subtitle", "time": 17076.07, "timestamp": "04:44:36", "text": "私たちはモイを手に入れた。私たちはモイを手に入れた。ああ、"}, {"type": "subtitle", "time": 17077.948, "timestamp": "04:44:37", "text": "カメラ。私たちには必要ない"}, {"type": "subtitle", "time": 17080.868, "timestamp": "04:44:40", "text": "カメラ。おそらくDOSでしょう。 DOSが必要だ。私"}, {"type": "subtitle", "time": 17082.788, "timestamp": "04:44:42", "text": "DOS版が必要だと思う。私はそうするかもしれない"}, {"type": "subtitle", "time": 17085.67, "timestamp": "04:44:45", "text": "DOSを1つ購入してください。一つ追加します。イエス"}, {"type": "subtitle", "time": 17088.11, "timestamp": "04:44:48", "text": "キリスト。 45ドルです。一度もない"}, {"type": "subtitle", "time": 17091.83, "timestamp": "04:44:51", "text": "心。えっと、安いものって何ですか？安いものとは？私"}, {"type": "subtitle", "time": 17095.51, "timestamp": "04:44:55", "text": "懐中電灯みたいな感じで買ったんだと思う。うん、"}, {"type": "subtitle", "time": 17097.35, "timestamp": "04:44:57", "text": "懐中電灯が必要です。懐中電灯が必要です。"}, {"type": "subtitle", "time": 17099.67, "timestamp": "04:44:59", "text": "ええ、そうです。"}]
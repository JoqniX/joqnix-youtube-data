[{"type": "subtitle", "time": 16803.99, "timestamp": "04:40:03", "text": "つまり、ファスモでは。本当に？"}, {"type": "subtitle", "time": 16806.23, "timestamp": "04:40:06", "text": "ゴーストスター時代。"}, {"type": "subtitle", "time": 16808.39, "timestamp": "04:40:08", "text": "なぜ私は地下室に一人でいるのだろう？これは"}, {"type": "subtitle", "time": 16811.03, "timestamp": "04:40:11", "text": "悪い。いや、いや、いや。あなたは素晴らしいです。"}, {"type": "subtitle", "time": 16812.868, "timestamp": "04:40:12", "text": "あなたは本当に素晴らしいです。ええ、そうです"}, {"type": "subtitle", "time": 16814.39, "timestamp": "04:40:14", "text": "大丈夫。ああ、ジャック、私を見て。私を見て。"}, {"type": "subtitle", "time": 16820.47, "timestamp": "04:40:20", "text": "中に入るよ。あ、こんにちは、勇敢なリック。"}, {"type": "subtitle", "time": 16822.868, "timestamp": "04:40:22", "text": "こんにちは、幽霊さん。私はただ見ているだけです"}, {"type": "subtitle", "time": 16826.39, "timestamp": "04:40:26", "text": "ただ私はただ私はただ欲しい"}, {"type": "subtitle", "time": 16829.75, "timestamp": "04:40:29", "text": "紫外線みたいなのがめちゃくちゃ好き。来て。私は"}, {"type": "subtitle", "time": 16837.35, "timestamp": "04:40:37", "text": "こんにちは、エイプリル。私と話したいですか？"}, {"type": "subtitle", "time": 16839.83, "timestamp": "04:40:39", "text": "私はここに一人でいる。"}, {"type": "subtitle", "time": 16841.83, "timestamp": "04:40:41", "text": "恥ずかしがらないで。話すのが怖い"}, {"type": "subtitle", "time": 16844.07, "timestamp": "04:40:44", "text": "幽霊。"}, {"type": "subtitle", "time": 16845.75, "timestamp": "04:40:45", "text": "本当にそうしたいなら、"}, {"type": "subtitle", "time": 16848.47, "timestamp": "04:40:48", "text": "幽霊と話して、私のラジオを持って行ってください。おお、"}, {"type": "subtitle", "time": 16851.51, "timestamp": "04:40:51", "text": "彼女は電気を消した。"}, {"type": "subtitle", "time": 16854.708, "timestamp": "04:40:54", "text": "私に話して。そうそう。あなたは自分のようにすることができます"}, {"type": "subtitle", "time": 16856.628, "timestamp": "04:40:56", "text": "彼女と話したいなら話してもいいけど、"}]
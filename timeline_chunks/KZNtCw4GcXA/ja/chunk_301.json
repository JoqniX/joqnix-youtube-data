[{"type": "subtitle", "time": 18061.31, "timestamp": "05:01:01", "text": "可能ですが、私のPCも"}, {"type": "subtitle", "time": 18065.868, "timestamp": "05:01:05", "text": "ラグが発生していて、本当に本当に嫌です"}, {"type": "subtitle", "time": 18074.03, "timestamp": "05:01:14", "text": "それで"}, {"type": "subtitle", "time": 18077.948, "timestamp": "05:01:17", "text": "あまり語られていない"}, {"type": "subtitle", "time": 18080.29, "timestamp": "05:01:20", "text": "E. 時々"}, {"type": "subtitle", "time": 18083.07, "timestamp": "05:01:23", "text": "[音楽]"}, {"type": "subtitle", "time": 18087.07, "timestamp": "05:01:27", "text": "うーん、時々そうではないようです"}, {"type": "subtitle", "time": 18088.83, "timestamp": "05:01:28", "text": "私の1つ"}, {"type": "subtitle", "time": 18092.59, "timestamp": "05:01:32", "text": "2番。時々私の"}, {"type": "subtitle", "time": 18097.11, "timestamp": "05:01:37", "text": "えっと、これで私の音声が"}, {"type": "subtitle", "time": 18100.99, "timestamp": "05:01:40", "text": "またクラッシュする時間"}, {"type": "subtitle", "time": 18103.708, "timestamp": "05:01:43", "text": "時間の方が"}, {"type": "subtitle", "time": 18107.15, "timestamp": "05:01:47", "text": "思っていたよりも心配だ"}, {"type": "subtitle", "time": 18117.55, "timestamp": "05:01:57", "text": "よし、お茶をもらったよ。"}]
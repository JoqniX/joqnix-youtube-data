[{"type": "subtitle", "time": 17466.39, "timestamp": "04:51:06", "text": "それは"}, {"type": "subtitle", "time": 17473.03, "timestamp": "04:51:13", "text": "もちろん。私は幽霊が"}, {"type": "subtitle", "time": 17478.868, "timestamp": "04:51:18", "text": "あなたが"}, {"type": "subtitle", "time": 17481.51, "timestamp": "04:51:21", "text": "ボールを動かすためにここにいるのか？殺すかもしれない"}, {"type": "subtitle", "time": 17483.51, "timestamp": "04:51:23", "text": "人。"}, {"type": "subtitle", "time": 17486.708, "timestamp": "04:51:26", "text": "とにかく、私は「あ、あのね？」を落としました。"}, {"type": "subtitle", "time": 17487.91, "timestamp": "04:51:27", "text": "あのね？あのね？多くの"}, {"type": "subtitle", "time": 17489.75, "timestamp": "04:51:29", "text": "より良い。私はそれをただ落とすだけです"}, {"type": "subtitle", "time": 17494.15, "timestamp": "04:51:34", "text": "真ん中。だから、もしそれが"}, {"type": "subtitle", "time": 17496.868, "timestamp": "04:51:36", "text": "ああ、発電機が動いている。えっと、みんな、"}, {"type": "subtitle", "time": 17499.83, "timestamp": "04:51:39", "text": "気温が低く、テントのようなものが見えました"}, {"type": "subtitle", "time": 17503.35, "timestamp": "04:51:43", "text": "物が勝手に動く。おお、いいね。ともかく、"}, {"type": "subtitle", "time": 17505.43, "timestamp": "04:51:45", "text": "正しく冷凍保存する。私は落とすつもりです"}, {"type": "subtitle", "time": 17507.99, "timestamp": "04:51:47", "text": "では、ここにドアがあります。ええ、この特定の"}, {"type": "subtitle", "time": 17511.03, "timestamp": "04:51:51", "text": "物が勝手に動いた。それで、"}, {"type": "subtitle", "time": 17512.788, "timestamp": "04:51:52", "text": "わかった、"}, {"type": "subtitle", "time": 17515.788, "timestamp": "04:51:55", "text": "大丈夫です。私はただここにいるだけです"}, {"type": "subtitle", "time": 17519.75, "timestamp": "04:51:59", "text": "ここ。みなさん、こんにちは。今、ここでキャンプをしています。"}]
[{"type": "subtitle", "time": 15361.389, "timestamp": "04:16:01", "text": "悪い。ああ。今は大丈夫ですか？大丈夫ですか？"}, {"type": "subtitle", "time": 15364.75, "timestamp": "04:16:04", "text": "今？大丈夫です。"}, {"type": "subtitle", "time": 15370.11, "timestamp": "04:16:10", "text": "うん。私が直します。そうではありません"}, {"type": "subtitle", "time": 15373.59, "timestamp": "04:16:13", "text": "わかった。それを手に入れろ。"}, {"type": "subtitle", "time": 15381.469, "timestamp": "04:16:21", "text": "私の"}, {"type": "subtitle", "time": 15384.469, "timestamp": "04:16:24", "text": "ああ、最後の最後で全てがうまくいかなくなる"}, {"type": "subtitle", "time": 15393.389, "timestamp": "04:16:33", "text": "それ。うん、行くよ"}, {"type": "subtitle", "time": 15396.59, "timestamp": "04:16:36", "text": "地図。おお"}, {"type": "subtitle", "time": 15417.429, "timestamp": "04:16:57", "text": "B. 背景が悪くてすみません。"}]
[{"type": "subtitle", "time": 17162.07, "timestamp": "04:46:02", "text": "そうやってやるんだよ。"}, {"type": "subtitle", "time": 17165.83, "timestamp": "04:46:05", "text": "あなたたちはそれをシンプルにして、"}, {"type": "subtitle", "time": 17167.11, "timestamp": "04:46:07", "text": "同時にシンプルでもある。わからない"}, {"type": "subtitle", "time": 17169.19, "timestamp": "04:46:09", "text": "どうやってそれを突き止めたのかは分からないが、"}, {"type": "subtitle", "time": 17177.43, "timestamp": "04:46:17", "text": "1つ。費用を節約するために、1つ削除することもできます。私"}, {"type": "subtitle", "time": 17180.55, "timestamp": "04:46:20", "text": "いや、いや、それは私たちの荷物の中にあるだろう"}, {"type": "subtitle", "time": 17183.03, "timestamp": "04:46:23", "text": "外。それで十分だと思います"}, {"type": "subtitle", "time": 17188.31, "timestamp": "04:46:28", "text": "実は。ああ、なるほど。"}, {"type": "subtitle", "time": 17191.35, "timestamp": "04:46:31", "text": "あ、懐中電灯持ってるよ。待って、私に"}, {"type": "subtitle", "time": 17193.91, "timestamp": "04:46:33", "text": "1分。私はそれを削除すると思った"}, {"type": "subtitle", "time": 17197.27, "timestamp": "04:46:37", "text": "死にたいときは懐中電灯を使え。"}, {"type": "subtitle", "time": 17200.31, "timestamp": "04:46:40", "text": "どうでも。懐中電灯を持っています。私はします"}, {"type": "subtitle", "time": 17203.51, "timestamp": "04:46:43", "text": "追加しないでください、私の音声が"}, {"type": "subtitle", "time": 17206.15, "timestamp": "04:46:46", "text": "どうやら私は"}, {"type": "subtitle", "time": 17208.23, "timestamp": "04:46:48", "text": "懐中電灯。それは実際かなりクールですね"}, {"type": "subtitle", "time": 17211.91, "timestamp": "04:46:51", "text": "準備ができたら。準備できました。"}, {"type": "subtitle", "time": 17216.15, "timestamp": "04:46:56", "text": "ああ、わかりました。知りませんでした。私は思った"}, {"type": "subtitle", "time": 17218.51, "timestamp": "04:46:58", "text": "負けると思った"}]
[{"type": "subtitle", "time": 15961.51, "timestamp": "04:26:01", "text": "少し遅れていますが、これは"}, {"type": "subtitle", "time": 15965.75, "timestamp": "04:26:05", "text": "大丈夫。あ、待って。ああ、設定ですね。ああ、神様。おお"}, {"type": "subtitle", "time": 15968.229, "timestamp": "04:26:08", "text": "神。彼ら。えっと、私にはわからない"}, {"type": "subtitle", "time": 15969.67, "timestamp": "04:26:09", "text": "これが何をするのか、でも私は"}, {"type": "subtitle", "time": 15971.59, "timestamp": "04:26:11", "text": "それ。"}, {"type": "subtitle", "time": 15974.51, "timestamp": "04:26:14", "text": "全てが低い。すべては"}, {"type": "subtitle", "time": 15977.51, "timestamp": "04:26:17", "text": "低い。幸いなことに、私はここに留まることはできません"}, {"type": "subtitle", "time": 15979.59, "timestamp": "04:26:19", "text": "最後まで長く、そしてそうです。うん。うん。"}, {"type": "subtitle", "time": 15982.51, "timestamp": "04:26:22", "text": "大丈夫。大丈夫。それは"}, {"type": "subtitle", "time": 15985.75, "timestamp": "04:26:25", "text": "常に"}, {"type": "subtitle", "time": 15989.51, "timestamp": "04:26:29", "text": "私は懐中電灯を持っています。はい。私"}, {"type": "subtitle", "time": 15991.269, "timestamp": "04:26:31", "text": "気に入っていただけたら本当に嬉しいです"}, {"type": "subtitle", "time": 15993.63, "timestamp": "04:26:33", "text": "来るよ。"}, {"type": "subtitle", "time": 15997.11, "timestamp": "04:26:37", "text": "なぜ、なぜ私は、なぜ私は"}, {"type": "subtitle", "time": 15999.349, "timestamp": "04:26:39", "text": "懐中電灯？個人的な恨みなど何もない。私"}, {"type": "subtitle", "time": 16001.11, "timestamp": "04:26:41", "text": "あなたは、"}, {"type": "subtitle", "time": 16003.67, "timestamp": "04:26:43", "text": "懐中電灯。はい。ああ、わかりました。私は行きます"}, {"type": "subtitle", "time": 16006.71, "timestamp": "04:26:46", "text": "スイッチみたいなものを探す。おお、"}, {"type": "subtitle", "time": 16008.87, "timestamp": "04:26:48", "text": "すでに5人か10人くらいいる"}, {"type": "subtitle", "time": 16012.229, "timestamp": "04:26:52", "text": "10°。うん。ああ、スイッチは"}, {"type": "subtitle", "time": 16013.99, "timestamp": "04:26:53", "text": "仕事。停電しています"}, {"type": "subtitle", "time": 16017.59, "timestamp": "04:26:57", "text": "すでに。そうそう。それは悪夢だ。なぜ"}, {"type": "subtitle", "time": 16019.55, "timestamp": "04:26:59", "text": "このドアは半分ですか"}]
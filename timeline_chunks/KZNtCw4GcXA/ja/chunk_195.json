[{"type": "subtitle", "time": 11704.55, "timestamp": "03:15:04", "text": "こんにちは。あなたはここにいますか？どこにいるの？"}, {"type": "subtitle", "time": 11708.389, "timestamp": "03:15:08", "text": "何歳ですか？こんにちは。"}, {"type": "subtitle", "time": 11710.309, "timestamp": "03:15:10", "text": "4月、なぜ私は"}, {"type": "subtitle", "time": 11711.67, "timestamp": "03:15:11", "text": "地下。ドアを閉めてください"}, {"type": "subtitle", "time": 11724.229, "timestamp": "03:15:24", "text": "こんにちは？あなたはここにいますか？ドアがあります。"}, {"type": "subtitle", "time": 11732.389, "timestamp": "03:15:32", "text": "ヒューズを探しているようなものだ"}, {"type": "subtitle", "time": 11735.269, "timestamp": "03:15:35", "text": "のように"}, {"type": "subtitle", "time": 11736.389, "timestamp": "03:15:36", "text": "たいていは地下室にある。ドア"}, {"type": "subtitle", "time": 11742.229, "timestamp": "03:15:42", "text": "サメ。幽霊が出るような話ではない。来て。何"}, {"type": "subtitle", "time": 11744.389, "timestamp": "03:15:44", "text": "ドアのことですか？どこにいるの？"}, {"type": "subtitle", "time": 11747.19, "timestamp": "03:15:47", "text": "ドアを閉める。私は2階にいます。あなたは"}, {"type": "subtitle", "time": 11750.19, "timestamp": "03:15:50", "text": "2階？あなたは"}, {"type": "subtitle", "time": 11753.349, "timestamp": "03:15:53", "text": "大丈夫。大丈夫だよ。"}, {"type": "subtitle", "time": 11755.91, "timestamp": "03:15:55", "text": "大丈夫だよ。大丈夫ですよ。何"}, {"type": "subtitle", "time": 11759.03, "timestamp": "03:15:59", "text": "つまりそういうことですか？ああ、なんて勇敢なんだ"}]
[{"type": "subtitle", "time": 11222.469, "timestamp": "03:07:02", "text": "うん。ニース。"}, {"type": "subtitle", "time": 11225.19, "timestamp": "03:07:05", "text": "なぜ私はあなたを見ることができないのですか？"}, {"type": "subtitle", "time": 11227.91, "timestamp": "03:07:07", "text": "うん。開けてください。ああ、何ですか、"}, {"type": "subtitle", "time": 11231.91, "timestamp": "03:07:11", "text": "マネキン。ああ。ああ、行くよ。これはこれです"}, {"type": "subtitle", "time": 11233.429, "timestamp": "03:07:13", "text": "すごくいい感じだ。私はそうする必要はない"}, {"type": "subtitle", "time": 11236.469, "timestamp": "03:07:16", "text": "カメラを使ってナビゲーションしてください。ニース。"}, {"type": "subtitle", "time": 11238.95, "timestamp": "03:07:18", "text": "さあ行こう。いずれにせよ爆発するだろう。"}, {"type": "subtitle", "time": 11240.79, "timestamp": "03:07:20", "text": "だから誰が気にするんだ？ええ、まさにその通りです。行くよ"}, {"type": "subtitle", "time": 11243.429, "timestamp": "03:07:23", "text": "とにかく出発する。なぜ？でも、私は"}, {"type": "subtitle", "time": 11247.63, "timestamp": "03:07:27", "text": "少しだけ見てみたい。"}, {"type": "subtitle", "time": 11252.87, "timestamp": "03:07:32", "text": "私は2階のどこかの隅っこにいます。"}, {"type": "subtitle", "time": 11254.95, "timestamp": "03:07:34", "text": "ああ、二階だよ。ああ、忘れてた。通常、"}, {"type": "subtitle", "time": 11257.67, "timestamp": "03:07:37", "text": "幽霊は二階にいるだろう。うん。"}, {"type": "subtitle", "time": 11259.19, "timestamp": "03:07:39", "text": "ジャック、来てくれる？"}, {"type": "subtitle", "time": 11262.87, "timestamp": "03:07:42", "text": "2階？なぜ私に来てほしいのですか？私 私"}, {"type": "subtitle", "time": 11265.429, "timestamp": "03:07:45", "text": "あなたに来てほしいのは、"}, {"type": "subtitle", "time": 11268.389, "timestamp": "03:07:48", "text": "懐中電灯。ええ、まさにその通りです。その通り。あなた"}, {"type": "subtitle", "time": 11270.309, "timestamp": "03:07:50", "text": "懐中電灯を持ってください。ほら、君は"}, {"type": "subtitle", "time": 11271.91, "timestamp": "03:07:51", "text": "懐中電灯。どういう意味ですか？なぜ私は"}, {"type": "subtitle", "time": 11273.429, "timestamp": "03:07:53", "text": "しなければならない？ここに隠れることができます"}, {"type": "subtitle", "time": 11276.87, "timestamp": "03:07:56", "text": "欲しい。幽霊の先輩と話すことができます。"}, {"type": "subtitle", "time": 11279.11, "timestamp": "03:07:59", "text": "その勢いを活かせ。"}]
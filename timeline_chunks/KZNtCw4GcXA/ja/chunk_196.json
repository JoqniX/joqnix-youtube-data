[{"type": "subtitle", "time": 11761.71, "timestamp": "03:16:01", "text": "あるいは、"}, {"type": "subtitle", "time": 11766.03, "timestamp": "03:16:06", "text": "階段。君を見てごらん。"}, {"type": "subtitle", "time": 11768.55, "timestamp": "03:16:08", "text": "でも、ピアノを弾くことができます"}, {"type": "subtitle", "time": 11771.91, "timestamp": "03:16:11", "text": "ここ。おお、いいね。あなたはしたい あなたはしたい"}, {"type": "subtitle", "time": 11774.15, "timestamp": "03:16:14", "text": "音色を作るような？うん、うん、うん。"}, {"type": "subtitle", "time": 11776.229, "timestamp": "03:16:16", "text": "はい、はい、はい、はい。私に"}, {"type": "subtitle", "time": 11778.87, "timestamp": "03:16:18", "text": "一体何者なんだ？全部開けました。"}, {"type": "subtitle", "time": 11779.95, "timestamp": "03:16:19", "text": "ありがとう、"}, {"type": "subtitle", "time": 11786.95, "timestamp": "03:16:26", "text": "ところで、あなたはどこにいるのですか？はい、私はただ"}, {"type": "subtitle", "time": 11789.03, "timestamp": "03:16:29", "text": "紫外線関連のものを探しています。ください"}, {"type": "subtitle", "time": 11798.07, "timestamp": "03:16:38", "text": "こんにちは、エイプリル。あなたはここにいますか？あなたは"}, {"type": "subtitle", "time": 11801.71, "timestamp": "03:16:41", "text": "私が一人でいる時に、私に取り憑きたいの？"}, {"type": "subtitle", "time": 11805.91, "timestamp": "03:16:45", "text": "こんにちは？あなたはここにいますか？どこにいるの？"}, {"type": "subtitle", "time": 11809.51, "timestamp": "03:16:49", "text": "何歳ですか？"}, {"type": "subtitle", "time": 11812.63, "timestamp": "03:16:52", "text": "待てよ、ヒューズはどこだっけ？"}, {"type": "subtitle", "time": 11816.55, "timestamp": "03:16:56", "text": "わかりました。ああ、その通りだ。"}]
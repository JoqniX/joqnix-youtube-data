[{"type": "subtitle", "time": 12661.99, "timestamp": "03:31:01", "text": "でも部屋は？"}, {"type": "subtitle", "time": 12664.71, "timestamp": "03:31:04", "text": "裏部屋から脱出せよ。中へではなく"}, {"type": "subtitle", "time": 12667.429, "timestamp": "03:31:07", "text": "奥の部屋。私は裏部屋から脱出した。おお"}, {"type": "subtitle", "time": 12670.79, "timestamp": "03:31:10", "text": "男の子。何でも。私と時間とシーモア"}, {"type": "subtitle", "time": 12673.03, "timestamp": "03:31:13", "text": "プレイしました。セレスティアが持っていると思う。あなた"}, {"type": "subtitle", "time": 12675.03, "timestamp": "03:31:15", "text": "それを持っているよね？ええ、持っていますよ。"}, {"type": "subtitle", "time": 12677.67, "timestamp": "03:31:17", "text": "でも、私はそれをプレイしたことがない。遊びたい"}, {"type": "subtitle", "time": 12681.03, "timestamp": "03:31:21", "text": "それ？何？あ、待って。待って、私に"}, {"type": "subtitle", "time": 12682.71, "timestamp": "03:31:22", "text": "2番。例えば、あなたの会社では許可されていますか？"}, {"type": "subtitle", "time": 12685.75, "timestamp": "03:31:25", "text": "それ？つまり、それがメインコンセプトなんです。"}, {"type": "subtitle", "time": 12689.429, "timestamp": "03:31:29", "text": "どの会社が何を許可しているのか？えーと、"}, {"type": "subtitle", "time": 12694.389, "timestamp": "03:31:34", "text": "毎月1回。ええ、毎月1回です。"}, {"type": "subtitle", "time": 12702.389, "timestamp": "03:31:42", "text": "私もテラリアをプレイしたい"}, {"type": "subtitle", "time": 12703.83, "timestamp": "03:31:43", "text": "遊び方がわからないから"}, {"type": "subtitle", "time": 12707.349, "timestamp": "03:31:47", "text": "テラリア。私も。"}, {"type": "subtitle", "time": 12709.51, "timestamp": "03:31:49", "text": "2D版マインクラフト。"}, {"type": "subtitle", "time": 12713.269, "timestamp": "03:31:53", "text": "ええ、2Dのことです。 2D版マインクラフト。はい、2Dです"}, {"type": "subtitle", "time": 12716.87, "timestamp": "03:31:56", "text": "マインクラフト。マインクラフト。私は掘ったのが好きです"}, {"type": "subtitle", "time": 12719.19, "timestamp": "03:31:59", "text": "2ブロック進んだところで、私は死んだ。私が言いたいのはそれだけです"}]
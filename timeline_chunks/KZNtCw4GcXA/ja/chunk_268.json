[{"type": "subtitle", "time": 16081.51, "timestamp": "04:28:01", "text": "ありがとう。私たちは、"}, {"type": "subtitle", "time": 16083.429, "timestamp": "04:28:03", "text": "幽霊を目撃し、そのうちの一人が逃げる"}, {"type": "subtitle", "time": 16086.71, "timestamp": "04:28:06", "text": "幽霊から離れてEMFをキャプチャする"}, {"type": "subtitle", "time": 16090.07, "timestamp": "04:28:10", "text": "読み取り信号。"}, {"type": "subtitle", "time": 16094.95, "timestamp": "04:28:14", "text": "うん。こんにちは。いらっしゃいませ。はい。はい。"}, {"type": "subtitle", "time": 16096.229, "timestamp": "04:28:16", "text": "わかった。中に入ることができますか"}, {"type": "subtitle", "time": 16097.83, "timestamp": "04:28:17", "text": "トイレをお願いします。どうもありがとうございます。"}, {"type": "subtitle", "time": 16099.99, "timestamp": "04:28:19", "text": "えっと、懐中電灯を見せてください"}, {"type": "subtitle", "time": 16105.309, "timestamp": "04:28:25", "text": "ええ、あなたは"}, {"type": "subtitle", "time": 16109.03, "timestamp": "04:28:29", "text": "地下室で一体何を手に入れるのか"}, {"type": "subtitle", "time": 16111.11, "timestamp": "04:28:31", "text": "それは何と呼ぶのですか？ああ、そうだね。うん、"}, {"type": "subtitle", "time": 16112.63, "timestamp": "04:28:32", "text": "の"}, {"type": "subtitle", "time": 16115.51, "timestamp": "04:28:35", "text": "待て、これ、どんどん大きくなっているぞ。"}, {"type": "subtitle", "time": 16120.79, "timestamp": "04:28:40", "text": "はい。 EMF を取得しました。まるでその一つみたいだ。"}, {"type": "subtitle", "time": 16122.87, "timestamp": "04:28:42", "text": "ああ、少なくとも"}, {"type": "subtitle", "time": 16125.03, "timestamp": "04:28:45", "text": "それを捉えるために4つ。いいえ、"}, {"type": "subtitle", "time": 16127.03, "timestamp": "04:28:47", "text": "いや、いや。 5つ必要です。私たちには必要だ"}, {"type": "subtitle", "time": 16129.429, "timestamp": "04:28:49", "text": "5つであって、4つではない。 5つ必要です"}, {"type": "subtitle", "time": 16130.469, "timestamp": "04:28:50", "text": "方法。"}, {"type": "subtitle", "time": 16138.55, "timestamp": "04:28:58", "text": "私は怖いです。ただ気ままに探索しているだけです"}]
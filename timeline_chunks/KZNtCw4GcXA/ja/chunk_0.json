[{"type": "subtitle", "time": 19.189, "timestamp": "00:00:19", "text": "今日。皆さん、こんにちは。"}, {"type": "subtitle", "time": 20.99, "timestamp": "00:00:20", "text": "ヨアトンの日"}, {"type": "subtitle", "time": 23.39, "timestamp": "00:00:23", "text": "45 朝"}, {"type": "subtitle", "time": 25.59, "timestamp": "00:00:25", "text": "ストリーム。皆さんがそうであることを願っています。"}, {"type": "subtitle", "time": 29.669, "timestamp": "00:00:29", "text": "順調に進んでいます。あなたが生きていることを願っています。"}, {"type": "subtitle", "time": 32.91, "timestamp": "00:00:32", "text": "そして、良いことをしている。ハッピー"}, {"type": "subtitle", "time": 36.43, "timestamp": "00:00:36", "text": "金曜日。愛の金曜日"}, {"type": "subtitle", "time": 46.19, "timestamp": "00:00:46", "text": "金曜日。"}, {"type": "subtitle", "time": 48.709, "timestamp": "00:00:48", "text": "いらっしゃいませ。そして今日は、"}, {"type": "subtitle", "time": 51.83, "timestamp": "00:00:51", "text": "まあ、ピューピューって感じかな。私はただ"}, {"type": "subtitle", "time": 54.99, "timestamp": "00:00:54", "text": "FPSゲームをプレイしたいだけです"}, {"type": "subtitle", "time": 59.95, "timestamp": "00:00:59", "text": "FPSジョッキーモードを発動するだけ"}]
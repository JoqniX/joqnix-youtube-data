[{"type": "subtitle", "time": 12544.55, "timestamp": "03:29:04", "text": "とにかく、私は「あ、あのね？」を落としました。"}, {"type": "subtitle", "time": 12545.75, "timestamp": "03:29:05", "text": "あのね？あのね？多くの"}, {"type": "subtitle", "time": 12547.59, "timestamp": "03:29:07", "text": "より良い。例えば、それを"}, {"type": "subtitle", "time": 12552.07, "timestamp": "03:29:12", "text": "真ん中。だから、もしそれが"}, {"type": "subtitle", "time": 12554.79, "timestamp": "03:29:14", "text": "ああ、発電機が動いている。えっと、みんな、"}, {"type": "subtitle", "time": 12557.75, "timestamp": "03:29:17", "text": "気温が低く、テントのようなものが見えました"}, {"type": "subtitle", "time": 12561.269, "timestamp": "03:29:21", "text": "物が勝手に動く。おお、いいね。ともかく、"}, {"type": "subtitle", "time": 12563.349, "timestamp": "03:29:23", "text": "氷点下の温度。私は落とすつもりです"}, {"type": "subtitle", "time": 12565.91, "timestamp": "03:29:25", "text": "では、ここにドアがあります。ええ、この特定の"}, {"type": "subtitle", "time": 12568.95, "timestamp": "03:29:28", "text": "物が勝手に動いた。それで、"}, {"type": "subtitle", "time": 12570.71, "timestamp": "03:29:30", "text": "わかった、"}, {"type": "subtitle", "time": 12573.71, "timestamp": "03:29:33", "text": "大丈夫です。私はただここにいるだけです"}, {"type": "subtitle", "time": 12577.59, "timestamp": "03:29:37", "text": "ここ。みなさん、こんにちは。今、ここでキャンプをしています。"}, {"type": "subtitle", "time": 12580.229, "timestamp": "03:29:40", "text": "見せていただき、本当にありがとうございました。できる"}, {"type": "subtitle", "time": 12583.67, "timestamp": "03:29:43", "text": "あなたはそのうちの1つを克服しましたか？ありがとう。"}, {"type": "subtitle", "time": 12587.269, "timestamp": "03:29:47", "text": "どうして君たちはそうなのか分からない。それは"}, {"type": "subtitle", "time": 12591.59, "timestamp": "03:29:51", "text": "それは召喚陣だ。なんてこった。"}, {"type": "subtitle", "time": 12593.99, "timestamp": "03:29:53", "text": "見てよ、ジャック、すべてを見つける"}]
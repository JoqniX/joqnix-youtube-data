[{"type": "subtitle", "time": 15480.149, "timestamp": "04:18:00", "text": "私が"}, {"type": "subtitle", "time": 15482.99, "timestamp": "04:18:02", "text": "左隅へ"}, {"type": "subtitle", "time": 15485.51, "timestamp": "04:18:05", "text": "側。うん。こんにちは、アディ。こんにちは、ブラッド。私"}, {"type": "subtitle", "time": 15487.429, "timestamp": "04:18:07", "text": "皆さんがお元気でいらっしゃることを願っています。"}, {"type": "subtitle", "time": 15490.469, "timestamp": "04:18:10", "text": "うん、みんなに会えなくて寂しかったよ。はい、まだです"}, {"type": "subtitle", "time": 15493.11, "timestamp": "04:18:13", "text": "ストリーミング配信されました。えっと、昨日配信したっけ？私"}, {"type": "subtitle", "time": 15495.429, "timestamp": "04:18:15", "text": "わからない。私は配信してないよね？私"}, {"type": "subtitle", "time": 15498.269, "timestamp": "04:18:18", "text": "わからない。でも、うんうんうんうん。"}, {"type": "subtitle", "time": 15503.87, "timestamp": "04:18:23", "text": "うん。えーと、えーと、私は"}, {"type": "subtitle", "time": 15506.71, "timestamp": "04:18:26", "text": "フィードバック。えっと、通知が来たら"}, {"type": "subtitle", "time": 15510.429, "timestamp": "04:18:30", "text": "彼らはミュートを解除している。ええ、ぜひ"}, {"type": "subtitle", "time": 15513.51, "timestamp": "04:18:33", "text": "知る。ヴィックがここにいる。ヤフー・ヴィック、やろう"}, {"type": "subtitle", "time": 15515.59, "timestamp": "04:18:35", "text": "今日私たちが最善を尽くします。"}, {"type": "subtitle", "time": 15518.55, "timestamp": "04:18:38", "text": "今日はベストを尽くそう。神様、私は私は"}, {"type": "subtitle", "time": 15520.87, "timestamp": "04:18:40", "text": "神経質。私は怖いです。私はたくさんのことを感じています"}, {"type": "subtitle", "time": 15524.429, "timestamp": "04:18:44", "text": "感情について。でも、そう、"}, {"type": "subtitle", "time": 15527.38, "timestamp": "04:18:47", "text": "最高。"}, {"type": "subtitle", "time": 15530.11, "timestamp": "04:18:50", "text": "[音楽]"}, {"type": "subtitle", "time": 15533.07, "timestamp": "04:18:53", "text": "でも、じゃあ全部閉じよう"}, {"type": "subtitle", "time": 15535.07, "timestamp": "04:18:55", "text": "これ。私は"}, {"type": "subtitle", "time": 15537.89, "timestamp": "04:18:57", "text": "準備ができて。いや、違うよ。"}]
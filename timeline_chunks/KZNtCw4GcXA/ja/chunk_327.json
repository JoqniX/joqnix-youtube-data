[{"type": "subtitle", "time": 19620.948, "timestamp": "05:27:00", "text": "ゲームをプレイするのと同じように"}, {"type": "subtitle", "time": 19623.15, "timestamp": "05:27:03", "text": "遅れているので"}, {"type": "subtitle", "time": 19632.788, "timestamp": "05:27:12", "text": "正直に言うと、今私はこれらの問題に直面している"}, {"type": "subtitle", "time": 19634.75, "timestamp": "05:27:14", "text": "課題と"}, {"type": "subtitle", "time": 19636.27, "timestamp": "05:27:16", "text": "苦闘"}, {"type": "subtitle", "time": 19639.23, "timestamp": "05:27:19", "text": "私自身は理解しています"}, {"type": "subtitle", "time": 19642.868, "timestamp": "05:27:22", "text": "それ。そこで、主なことの一つが"}, {"type": "subtitle", "time": 19647.67, "timestamp": "05:27:27", "text": "えっと、私が思い浮かべるのは、"}, {"type": "subtitle", "time": 19651.43, "timestamp": "05:27:31", "text": "特に音声に関して。"}, {"type": "subtitle", "time": 19655.31, "timestamp": "05:27:35", "text": "私の音声は"}, {"type": "subtitle", "time": 19658.15, "timestamp": "05:27:38", "text": "最大。たとえ私が買ったとしても"}, {"type": "subtitle", "time": 19660.75, "timestamp": "05:27:40", "text": "非常に高価"}, {"type": "subtitle", "time": 19664.51, "timestamp": "05:27:44", "text": "うーん、音声ノイズ抑制"}, {"type": "subtitle", "time": 19666.35, "timestamp": "05:27:46", "text": "あれ、"}, {"type": "subtitle", "time": 19670.07, "timestamp": "05:27:50", "text": "時々、キャプチャが本当にキャプチャされないことがあります"}, {"type": "subtitle", "time": 19672.708, "timestamp": "05:27:52", "text": "私が捉えたいもの、例えば"}, {"type": "subtitle", "time": 19675.11, "timestamp": "05:27:55", "text": "悲鳴とか、そういうの全部。"}, {"type": "subtitle", "time": 19679.35, "timestamp": "05:27:59", "text": "私の声がまるで"}]
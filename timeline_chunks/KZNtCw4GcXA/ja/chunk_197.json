[{"type": "subtitle", "time": 11827.229, "timestamp": "03:17:07", "text": "おお。ああ、大したことじゃないよ。おお"}, {"type": "subtitle", "time": 11835.07, "timestamp": "03:17:15", "text": "おい。ええ、照明は用意しました。"}, {"type": "subtitle", "time": 11836.63, "timestamp": "03:17:16", "text": "[音楽]"}, {"type": "subtitle", "time": 11841.429, "timestamp": "03:17:21", "text": "こんにちは。"}, {"type": "subtitle", "time": 11843.99, "timestamp": "03:17:23", "text": "あなたはここにいますか？エイプリル、ここにいる？"}, {"type": "subtitle", "time": 11846.79, "timestamp": "03:17:26", "text": "私たちと話したいですか？何歳ですか"}, {"type": "subtitle", "time": 11853.269, "timestamp": "03:17:33", "text": "年齢を聞いてくれるのがいいですね"}, {"type": "subtitle", "time": 11856.07, "timestamp": "03:17:36", "text": "あなた。ああ、それはデフォルト設定みたいなものですね。それは"}, {"type": "subtitle", "time": 11857.83, "timestamp": "03:17:37", "text": "当然尋ねなければならないこと"}, {"type": "subtitle", "time": 11861.83, "timestamp": "03:17:41", "text": "つまり、ファスモでは。本当に？本当に？"}, {"type": "subtitle", "time": 11864.07, "timestamp": "03:17:44", "text": "ゴーストスター時代。"}, {"type": "subtitle", "time": 11866.229, "timestamp": "03:17:46", "text": "なぜ私は地下室に一人でいるのだろう？これは"}, {"type": "subtitle", "time": 11869.03, "timestamp": "03:17:49", "text": "悪い。いやいや、君は素晴らしいよ。あなたは"}, {"type": "subtitle", "time": 11871.03, "timestamp": "03:17:51", "text": "絶好調です。うん、大丈夫だよ。おお、"}, {"type": "subtitle", "time": 11872.55, "timestamp": "03:17:52", "text": "ジャック、私を見て。私を見て。私は行きます"}]
[{"type": "subtitle", "time": 17943.788, "timestamp": "04:59:03", "text": "えっと、最近気づいたんだけど、えっと、魚っぽい"}, {"type": "subtitle", "time": 17945.47, "timestamp": "04:59:05", "text": "行く"}, {"type": "subtitle", "time": 17968.75, "timestamp": "04:59:28", "text": "みんな。"}, {"type": "subtitle", "time": 17970.75, "timestamp": "04:59:30", "text": "わかった。こんにちは"}, {"type": "subtitle", "time": 17974.59, "timestamp": "04:59:34", "text": "みんな。戻りました。"}, {"type": "subtitle", "time": 17981.628, "timestamp": "04:59:41", "text": "少し。"}, {"type": "subtitle", "time": 17985.43, "timestamp": "04:59:45", "text": "それから、昼寝をした後、"}, {"type": "subtitle", "time": 17993.07, "timestamp": "04:59:53", "text": "課題を開封して"}, {"type": "subtitle", "time": 17995.67, "timestamp": "04:59:55", "text": "すべて。彼女は、えっと、確認しているところだった"}, {"type": "subtitle", "time": 17997.75, "timestamp": "04:59:57", "text": "すべて順調で、何も問題ありません。だから私は"}, {"type": "subtitle", "time": 17998.75, "timestamp": "04:59:58", "text": "少し"}]
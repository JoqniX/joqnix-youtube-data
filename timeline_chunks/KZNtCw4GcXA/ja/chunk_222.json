[{"type": "subtitle", "time": 13320.79, "timestamp": "03:42:00", "text": "セレスティアは私のストリームが好きだから"}, {"type": "subtitle", "time": 13324.309, "timestamp": "03:42:04", "text": "ビットレートが本当に低かったんです。私の"}, {"type": "subtitle", "time": 13326.389, "timestamp": "03:42:06", "text": "インターネットの接続状態が良くない。私は"}, {"type": "subtitle", "time": 13326.99, "timestamp": "03:42:06", "text": "しないで"}, {"type": "subtitle", "time": 13329.99, "timestamp": "03:42:09", "text": "何が起こりうるかを知っている"}, {"type": "subtitle", "time": 13333.95, "timestamp": "03:42:13", "text": "起こった。それはきっと"}, {"type": "subtitle", "time": 13338.07, "timestamp": "03:42:18", "text": "えっと、私は必要なのだと思います"}, {"type": "subtitle", "time": 13341.19, "timestamp": "03:42:21", "text": "明日またチェックして、いいねして"}, {"type": "subtitle", "time": 13342.71, "timestamp": "03:42:22", "text": "オフィスか何かに"}, {"type": "subtitle", "time": 13345.429, "timestamp": "03:42:25", "text": "何か、支払いとか何か"}, {"type": "subtitle", "time": 13347.11, "timestamp": "03:42:27", "text": "何かわからないような"}, {"type": "subtitle", "time": 13350.389, "timestamp": "03:42:30", "text": "G のようにはならない、なぜならそれは"}, {"type": "subtitle", "time": 13353.79, "timestamp": "03:42:33", "text": "民間ISP、現在は民間企業または"}, {"type": "subtitle", "time": 13356.229, "timestamp": "03:42:36", "text": "男が待つ必要があること"}, {"type": "subtitle", "time": 13359.19, "timestamp": "03:42:39", "text": "ドアを取りに来てください、さもないと私は行かなければなりません"}, {"type": "subtitle", "time": 13360.429, "timestamp": "03:42:40", "text": "そこには"}, {"type": "subtitle", "time": 13363.91, "timestamp": "03:42:43", "text": "自分自身。それは、私があなたが"}, {"type": "subtitle", "time": 13367.03, "timestamp": "03:42:47", "text": "私が慣れているのは、J51 で、"}, {"type": "subtitle", "time": 13369.11, "timestamp": "03:42:49", "text": "バランスが取れていないことを文字通り示しています"}, {"type": "subtitle", "time": 13371.67, "timestamp": "03:42:51", "text": "左、右？文字通り充電を示しています"}, {"type": "subtitle", "time": 13374.87, "timestamp": "03:42:54", "text": "インターネットデータは外部ホストされています。"}, {"type": "subtitle", "time": 13377.349, "timestamp": "03:42:57", "text": "もしそれが事実であれば、もしその警告が"}]
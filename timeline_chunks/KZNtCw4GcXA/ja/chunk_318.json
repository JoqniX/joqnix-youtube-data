[{"type": "subtitle", "time": 19082.51, "timestamp": "05:18:02", "text": "お腹を治した後、戻ってきました"}, {"type": "subtitle", "time": 19086.868, "timestamp": "05:18:06", "text": "満杯。昨日編集していた"}, {"type": "subtitle", "time": 19089.948, "timestamp": "05:18:09", "text": "夜の小川。いいえ、朝"}, {"type": "subtitle", "time": 19093.948, "timestamp": "05:18:13", "text": "ストリーム。それは44日目、パート1みたいな感じ"}, {"type": "subtitle", "time": 19096.708, "timestamp": "05:18:16", "text": "ストリーム。眠ってしまったことに気づいた"}, {"type": "subtitle", "time": 19100.07, "timestamp": "05:18:20", "text": "早いですよね？いや、私が来たのは早くない"}, {"type": "subtitle", "time": 19103.75, "timestamp": "05:18:23", "text": "5分半ほど配信を再開します"}, {"type": "subtitle", "time": 19107.03, "timestamp": "05:18:27", "text": "そして私はとても疲れ果てて"}, {"type": "subtitle", "time": 19108.11, "timestamp": "05:18:28", "text": "私は"}, {"type": "subtitle", "time": 19111.11, "timestamp": "05:18:31", "text": "眠って、何時間くらい寝てたんだろう"}, {"type": "subtitle", "time": 19113.35, "timestamp": "05:18:33", "text": "5時まで。"}, {"type": "subtitle", "time": 19116.788, "timestamp": "05:18:36", "text": "そして午後5時に帰ってきた。そして、えーと"}, {"type": "subtitle", "time": 19120.83, "timestamp": "05:18:40", "text": "2時間または2時間1時間続いた"}, {"type": "subtitle", "time": 19124.07, "timestamp": "05:18:44", "text": "最大限まで休憩した後、また休憩を取りました"}, {"type": "subtitle", "time": 19126.39, "timestamp": "05:18:46", "text": "そしてそれが戦争だ、文字通り2"}, {"type": "subtitle", "time": 19130.15, "timestamp": "05:18:50", "text": "一日中流れていた"}, {"type": "subtitle", "time": 19133.27, "timestamp": "05:18:53", "text": "ある意味、たった2時間だった。信じられますか？"}, {"type": "subtitle", "time": 19138.628, "timestamp": "05:18:58", "text": "午前中のパート1の配信は、ある意味で"}]
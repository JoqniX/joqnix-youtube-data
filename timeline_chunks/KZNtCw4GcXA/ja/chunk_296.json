[{"type": "subtitle", "time": 17760.708, "timestamp": "04:56:00", "text": "日。ええ、でもね、知ってる？楽しいですよ。"}, {"type": "subtitle", "time": 17777.19, "timestamp": "04:56:17", "text": "それ。今、私が上流にいるのが見えるでしょう。"}, {"type": "subtitle", "time": 17780.03, "timestamp": "04:56:20", "text": "今。ビットレートは良好です。これは"}, {"type": "subtitle", "time": 17784.47, "timestamp": "04:56:24", "text": "1.00 KVPS。おお。最低ビットレート"}, {"type": "subtitle", "time": 17786.59, "timestamp": "04:56:26", "text": "それは私のためのものだった。"}, {"type": "subtitle", "time": 17789.75, "timestamp": "04:56:29", "text": "ニース。やっと、話せるようになった。私はそう願っています"}, {"type": "subtitle", "time": 17793.11, "timestamp": "04:56:33", "text": "聞こえる。私は文字通り"}, {"type": "subtitle", "time": 17797.11, "timestamp": "04:56:37", "text": "えーと、それで、えーと、ここに来た人たちのために"}, {"type": "subtitle", "time": 17804.39, "timestamp": "04:56:44", "text": "ごめん。だから、何が起こったのか私にはわからない。私の"}, {"type": "subtitle", "time": 17807.99, "timestamp": "04:56:47", "text": "インターネットは死んだと言えるブラウザ"}, {"type": "subtitle", "time": 17809.83, "timestamp": "04:56:49", "text": "そしてすべてが緑色のライトを点灯した"}, {"type": "subtitle", "time": 17813.59, "timestamp": "04:56:53", "text": "まるで正常に動作しているかのようだ。"}, {"type": "subtitle", "time": 17816.59, "timestamp": "04:56:56", "text": "間違いではないが、"}]
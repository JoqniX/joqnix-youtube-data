[{"type": "subtitle", "time": 14042.03, "timestamp": "03:54:02", "text": "セレスティアとヴィック。楽しんでいただければ幸いです"}, {"type": "subtitle", "time": 14045.189, "timestamp": "03:54:05", "text": "コラボレーション。うん。うん。うん。しかし、"}, {"type": "subtitle", "time": 14048.309, "timestamp": "03:54:08", "text": "心配しないでください。心配しないで。あるだろう"}, {"type": "subtitle", "time": 14051.83, "timestamp": "03:54:11", "text": "将来コラボするときは、えっと、プレイします"}, {"type": "subtitle", "time": 14055.55, "timestamp": "03:54:15", "text": "二人とも一緒に。だから、"}, {"type": "subtitle", "time": 14060.309, "timestamp": "03:54:20", "text": "わかった。こんにちは。ええ、そうですね。しかし、それだけだ。私"}, {"type": "subtitle", "time": 14062.189, "timestamp": "03:54:22", "text": "長引かせたくない"}, {"type": "subtitle", "time": 14064.75, "timestamp": "03:54:24", "text": "これ。または"}, {"type": "subtitle", "time": 14067.349, "timestamp": "03:54:27", "text": "あのね？私は実際に待ちます"}, {"type": "subtitle", "time": 14069.75, "timestamp": "03:54:29", "text": "インターネット接続が復旧します。わかった。それは"}, {"type": "subtitle", "time": 14072.07, "timestamp": "03:54:32", "text": "実際に続けるよりずっと良い"}, {"type": "subtitle", "time": 14074.79, "timestamp": "03:54:34", "text": "もっと。うん。うん。うん。私のインターネットジャマ"}, {"type": "subtitle", "time": 14077.189, "timestamp": "03:54:37", "text": "今日は調子が良くない。じゃあ、えっと、"}, {"type": "subtitle", "time": 14079.03, "timestamp": "03:54:39", "text": "配信できるかどうかはわかりません"}, {"type": "subtitle", "time": 14081.269, "timestamp": "03:54:41", "text": "明日。明日はただの歌"}, {"type": "subtitle", "time": 14083.269, "timestamp": "03:54:43", "text": "兄弟の配信。私は自分が"}, {"type": "subtitle", "time": 14093.189, "timestamp": "03:54:53", "text": "見る。見てみましょう。そうそう。とにかく、私は"}, {"type": "subtitle", "time": 14094.87, "timestamp": "03:54:54", "text": "皆さん、お越しいただきありがとうございました。"}]
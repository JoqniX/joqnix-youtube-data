[{"type": "subtitle", "time": 10380.67, "timestamp": "02:53:00", "text": "10月26日。次は"}, {"type": "subtitle", "time": 10382.87, "timestamp": "02:53:02", "text": "木曜日。それは私が"}, {"type": "subtitle", "time": 10387.309, "timestamp": "02:53:07", "text": "言いたかったのは"}, {"type": "subtitle", "time": 10390.51, "timestamp": "02:53:10", "text": "今日。でも、楽しみにしています"}, {"type": "subtitle", "time": 10393.03, "timestamp": "02:53:13", "text": "今日。気のせいかな、それとも君が途中でやめているのかな？"}, {"type": "subtitle", "time": 10394.79, "timestamp": "02:53:14", "text": "待って、今から切り上げるよ。待って、私は"}, {"type": "subtitle", "time": 10398.19, "timestamp": "02:53:18", "text": "切り捨てる。待って、"}, {"type": "subtitle", "time": 10401.469, "timestamp": "02:53:21", "text": "私？待って、"}, {"type": "subtitle", "time": 10405.07, "timestamp": "02:53:25", "text": "本当に？私は辞めます。"}, {"type": "subtitle", "time": 10408.269, "timestamp": "02:53:28", "text": "何？何？"}, {"type": "subtitle", "time": 10411.59, "timestamp": "02:53:31", "text": "はぁ？なんてこった。待ち時間をなくす。これは"}, {"type": "subtitle", "time": 10413.07, "timestamp": "02:53:33", "text": "悪い。これは"}, {"type": "subtitle", "time": 10419.15, "timestamp": "02:53:39", "text": "悪い。ああ。今は大丈夫ですか？大丈夫ですか？"}, {"type": "subtitle", "time": 10422.51, "timestamp": "02:53:42", "text": "今？大丈夫です。"}, {"type": "subtitle", "time": 10439.23, "timestamp": "02:53:59", "text": "私の"}]
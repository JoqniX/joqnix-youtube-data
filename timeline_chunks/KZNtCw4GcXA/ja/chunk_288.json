[{"type": "subtitle", "time": 17282.55, "timestamp": "04:48:02", "text": "クロノス。静かに、クロノス。"}, {"type": "subtitle", "time": 17287.67, "timestamp": "04:48:07", "text": "よし、じゃあ開けて。こんにちは。これがあります"}, {"type": "subtitle", "time": 17291.27, "timestamp": "04:48:11", "text": "キース・キース・ミラーという人物です。うん、これ"}, {"type": "subtitle", "time": 17294.31, "timestamp": "04:48:14", "text": "この公園は実際、いいところだ。"}, {"type": "subtitle", "time": 17298.15, "timestamp": "04:48:18", "text": "バスケットボール。待って、起き上がれないよ"}, {"type": "subtitle", "time": 17300.31, "timestamp": "04:48:20", "text": "ともかく。"}, {"type": "subtitle", "time": 17301.75, "timestamp": "04:48:21", "text": "ああ、おい。あれを見てください。これはスレンダー"}, {"type": "subtitle", "time": 17305.39, "timestamp": "04:48:25", "text": "男。ニース。はぁ？細身の男。"}, {"type": "subtitle", "time": 17314.868, "timestamp": "04:48:34", "text": "あれを見てください。あれを見てください。何てことだ。"}, {"type": "subtitle", "time": 17318.07, "timestamp": "04:48:38", "text": "それは良いことです。それは良いことです。いいえ、私は決して"}, {"type": "subtitle", "time": 17321.19, "timestamp": "04:48:41", "text": "振り返ってみると。"}, {"type": "subtitle", "time": 17322.55, "timestamp": "04:48:42", "text": "かっこいい見た目だと言っている"}, {"type": "subtitle", "time": 17331.83, "timestamp": "04:48:51", "text": "待って、どうすればいいと思う、私は、"}, {"type": "subtitle", "time": 17333.51, "timestamp": "04:48:53", "text": "電源を入れて、"}, {"type": "subtitle", "time": 17335.51, "timestamp": "04:48:55", "text": "床。それが私が"}, {"type": "subtitle", "time": 17337.99, "timestamp": "04:48:57", "text": "今はDOSと関係があるはずだ。はい。"}, {"type": "subtitle", "time": 17339.51, "timestamp": "04:48:59", "text": "それが、それが私がすべきことだ"}]
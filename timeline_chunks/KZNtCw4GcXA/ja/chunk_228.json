[{"type": "subtitle", "time": 13685.15, "timestamp": "03:48:05", "text": "楽しんでいただければ幸いです。"}, {"type": "subtitle", "time": 13687.83, "timestamp": "03:48:07", "text": "本日はお越しいただきありがとうございます。楽しんでいただければ幸いです。"}, {"type": "subtitle", "time": 13689.75, "timestamp": "03:48:09", "text": "今日。来てくださってありがとうございます。感謝"}, {"type": "subtitle", "time": 13692.71, "timestamp": "03:48:12", "text": "あなたもそうであってくれてありがとう。ありがとう。希望"}, {"type": "subtitle", "time": 13696.63, "timestamp": "03:48:16", "text": "今日を楽しんでください。来てくれてありがとう、ニンジャ。"}, {"type": "subtitle", "time": 13699.429, "timestamp": "03:48:19", "text": "今日を楽しんでください。今はカマです。"}, {"type": "subtitle", "time": 13701.429, "timestamp": "03:48:21", "text": "お待たせして申し訳ありませんでした。それ"}, {"type": "subtitle", "time": 13703.71, "timestamp": "03:48:23", "text": "本当の意味は"}, {"type": "subtitle", "time": 13707.55, "timestamp": "03:48:27", "text": "来てくれてありがとう。楽しんでいただけたでしょうか。"}, {"type": "subtitle", "time": 13710.79, "timestamp": "03:48:30", "text": "今日。本当にありがとうございました。セレスティア"}, {"type": "subtitle", "time": 13713.83, "timestamp": "03:48:33", "text": "そしてヴィック、今日はありがとうございました。本当に"}, {"type": "subtitle", "time": 13716.07, "timestamp": "03:48:36", "text": "楽しかった。どちらも楽しみにしています"}, {"type": "subtitle", "time": 13718.79, "timestamp": "03:48:38", "text": "皆さんとコラボレーションします。そしてどうやらそれは"}, {"type": "subtitle", "time": 13723.429, "timestamp": "03:48:43", "text": "セレスティアとの初めての本格的なコラボレーションでした"}, {"type": "subtitle", "time": 13725.11, "timestamp": "03:48:45", "text": "今日。"}, {"type": "subtitle", "time": 13728.229, "timestamp": "03:48:48", "text": "いいえ、私たちは互いに協力して"}, {"type": "subtitle", "time": 13730.91, "timestamp": "03:48:50", "text": "彼女のゴルフコラボレーション"}, {"type": "subtitle", "time": 13733.75, "timestamp": "03:48:53", "text": "チャネル。うん。うん。でもこれは"}, {"type": "subtitle", "time": 13736.429, "timestamp": "03:48:56", "text": "最初の公式"}, {"type": "subtitle", "time": 13738.269, "timestamp": "03:48:58", "text": "親切。"}]
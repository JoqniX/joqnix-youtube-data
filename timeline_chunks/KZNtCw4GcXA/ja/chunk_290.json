[{"type": "subtitle", "time": 17400.708, "timestamp": "04:50:00", "text": "ああ、そんな部屋はないよ"}, {"type": "subtitle", "time": 17403.99, "timestamp": "04:50:03", "text": "側面に。バカ。よし、このバスルーム"}, {"type": "subtitle", "time": 17405.59, "timestamp": "04:50:05", "text": "不快だ。そして人々は"}, {"type": "subtitle", "time": 17407.59, "timestamp": "04:50:07", "text": "歯ブラシのような"}, {"type": "subtitle", "time": 17409.27, "timestamp": "04:50:09", "text": "公然と。それは私の"}, {"type": "subtitle", "time": 17411.83, "timestamp": "04:50:11", "text": "最大の元カレ歯ブラシが横たわっている"}, {"type": "subtitle", "time": 17413.67, "timestamp": "04:50:13", "text": "汚れてしまうので"}, {"type": "subtitle", "time": 17418.788, "timestamp": "04:50:18", "text": "それを口に入れてください。バカ。ああ、大変だ。"}, {"type": "subtitle", "time": 17420.788, "timestamp": "04:50:20", "text": "セレスティアが実は"}, {"type": "subtitle", "time": 17426.47, "timestamp": "04:50:26", "text": "はい、その通りです。これはひどい。私"}, {"type": "subtitle", "time": 17428.31, "timestamp": "04:50:28", "text": "誰がこんなことをしているのか分からない。私は思う"}, {"type": "subtitle", "time": 17429.75, "timestamp": "04:50:29", "text": "そうは思わないよ。聞こえた？"}, {"type": "subtitle", "time": 17431.51, "timestamp": "04:50:31", "text": "誰かが叫んだ。今、聞こえましたか？"}, {"type": "subtitle", "time": 17434.948, "timestamp": "04:50:34", "text": "誰かが叫んだ。君たちはどこにいるの？"}, {"type": "subtitle", "time": 17437.67, "timestamp": "04:50:37", "text": "誰も叫ばなかった。心配しないで。いや、いや。"}, {"type": "subtitle", "time": 17440.39, "timestamp": "04:50:40", "text": "ただ、私一人だけだったんです。私は練習していました"}, {"type": "subtitle", "time": 17443.27, "timestamp": "04:50:43", "text": "歌い方。ジャック、さあ。大丈夫です。"}, {"type": "subtitle", "time": 17448.47, "timestamp": "04:50:48", "text": "氷点下。いや、いや、いや、いや。"}, {"type": "subtitle", "time": 17450.31, "timestamp": "04:50:50", "text": "こんにちは。"}, {"type": "subtitle", "time": 17452.59, "timestamp": "04:50:52", "text": "おい、あれを見てみろよ。待って、誰かが言った"}, {"type": "subtitle", "time": 17457.11, "timestamp": "04:50:57", "text": "こんにちは。待って。こんにちは。いいえ。"}, {"type": "subtitle", "time": 17459.03, "timestamp": "04:50:59", "text": "どうしたの？どうしたの？私はここにいます。"}]
[{"type": "subtitle", "time": 18721.75, "timestamp": "05:12:01", "text": "全て。私は何者？何？私は何をすべきですか？"}, {"type": "subtitle", "time": 18723.1, "timestamp": "05:12:03", "text": "そして私は"}, {"type": "subtitle", "time": 18729.43, "timestamp": "05:12:09", "text": "えっと、でもクリエイティブな面では私は"}, {"type": "subtitle", "time": 18731.35, "timestamp": "05:12:11", "text": "考えている"}, {"type": "subtitle", "time": 18732.75, "timestamp": "05:12:12", "text": "えっと、"}, {"type": "subtitle", "time": 18739.51, "timestamp": "05:12:19", "text": "クリーナーオーバーレイか何か"}, {"type": "subtitle", "time": 18741.35, "timestamp": "05:12:21", "text": "私は休憩を取っています。"}, {"type": "subtitle", "time": 18744.628, "timestamp": "05:12:24", "text": "飛び上がっては飛び下がる。上にスワイプしてください。スワイプ"}, {"type": "subtitle", "time": 18747.03, "timestamp": "05:12:27", "text": "下。明らかに、"}, {"type": "subtitle", "time": 18749.27, "timestamp": "05:12:29", "text": "現れては消える。あなたは"}, {"type": "subtitle", "time": 18751.75, "timestamp": "05:12:31", "text": "それぞれの情報源。フェードイン、フェードアウト"}, {"type": "subtitle", "time": 18753.51, "timestamp": "05:12:33", "text": "外。まあ、そんな感じですね。スワイプイン、スワイプ"}, {"type": "subtitle", "time": 18756.47, "timestamp": "05:12:36", "text": "上にスワイプ、上にスワイプ、下にスワイプ。私はできる"}, {"type": "subtitle", "time": 18758.43, "timestamp": "05:12:38", "text": "あの物について"}, {"type": "subtitle", "time": 18762.628, "timestamp": "05:12:42", "text": "あらゆる周期的なもの。すべて"}, {"type": "subtitle", "time": 18764.868, "timestamp": "05:12:44", "text": "時間を作った"}, {"type": "subtitle", "time": 18768.31, "timestamp": "05:12:48", "text": "時間ベースの自動化ですよね？"}, {"type": "subtitle", "time": 18772.47, "timestamp": "05:12:52", "text": "朝、朝の翌日、正午、午後、"}, {"type": "subtitle", "time": 18773.47, "timestamp": "05:12:53", "text": "えーと"}, {"type": "subtitle", "time": 18776.948, "timestamp": "05:12:56", "text": "夕方、えーと夜、深夜、真夜中、"}, {"type": "subtitle", "time": 18779.03, "timestamp": "05:12:59", "text": "そういうこと全部ですよね？"}]
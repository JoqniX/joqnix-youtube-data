[{"type": "subtitle", "time": 1787.43, "timestamp": "00:29:47", "text": "そう思う。私も同じ気持ちです。"}, {"type": "subtitle", "time": 1788.669, "timestamp": "00:29:48", "text": "電車"}, {"type": "subtitle", "time": 1795.11, "timestamp": "00:29:55", "text": "激しい。これはサーバーです"}, {"type": "subtitle", "time": 1796.789, "timestamp": "00:29:56", "text": "私は行くつもりです、私は遊ぶつもりです"}]
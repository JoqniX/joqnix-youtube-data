[{"type": "subtitle", "time": 540.67, "timestamp": "00:09:00", "text": "それは本当にあなたの"}, {"type": "subtitle", "time": 545.23, "timestamp": "00:09:05", "text": "私の声は"}, {"type": "subtitle", "time": 547.829, "timestamp": "00:09:07", "text": "遅れている。ああ、声が遅れてるよ、そうじゃない？"}, {"type": "subtitle", "time": 564.67, "timestamp": "00:09:24", "text": "神よ、これは"}, {"type": "subtitle", "time": 567.43, "timestamp": "00:09:27", "text": "最悪だ。ほら、これが私が言ったと思ったことだ"}, {"type": "subtitle", "time": 569.75, "timestamp": "00:09:29", "text": "君たち。"}]
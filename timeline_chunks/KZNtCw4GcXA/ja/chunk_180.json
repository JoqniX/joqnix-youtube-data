[{"type": "subtitle", "time": 10804.15, "timestamp": "03:00:04", "text": "待って、待って、待って、待って。何？どうやって？"}, {"type": "subtitle", "time": 10806.63, "timestamp": "03:00:06", "text": "待って。"}, {"type": "subtitle", "time": 10809.51, "timestamp": "03:00:09", "text": "よし、ランダム再生ボタンを押した。そこには"}, {"type": "subtitle", "time": 10812.71, "timestamp": "03:00:12", "text": "オーディオ。そして、私は既にそれを成し遂げた。悪夢。"}, {"type": "subtitle", "time": 10815.19, "timestamp": "03:00:15", "text": "え、何？おお。ああ、神様。ああ、神様。ああ、神様。"}, {"type": "subtitle", "time": 10818.23, "timestamp": "03:00:18", "text": "ちょっと待ってください。ああ、私はああを見せました、"}, {"type": "subtitle", "time": 10820.55, "timestamp": "03:00:20", "text": "いいえ。誰が気にする？だから、誰も私の"}, {"type": "subtitle", "time": 10822.309, "timestamp": "03:00:22", "text": "ストリームですが、それでも安全のために"}, {"type": "subtitle", "time": 10826.11, "timestamp": "03:00:26", "text": "理由。待って、私、何か間違えた？"}, {"type": "subtitle", "time": 10830.389, "timestamp": "03:00:30", "text": "ああ、わかった。いいね。"}, {"type": "subtitle", "time": 10833.269, "timestamp": "03:00:33", "text": "待って。何てことだ。待って。誰も知らないことは分かっています"}, {"type": "subtitle", "time": 10835.59, "timestamp": "03:00:35", "text": "配信を見ているけど、それでも。最新情報"}, {"type": "subtitle", "time": 10842.389, "timestamp": "03:00:42", "text": "君たちはランダムに選んだんだね。"}, {"type": "subtitle", "time": 10845.349, "timestamp": "03:00:45", "text": "いや、待って。ちょっと待ってください、私は今"}, {"type": "subtitle", "time": 10847.83, "timestamp": "03:00:47", "text": "気が散っている。ごめんなさい。わかった。私が選んだ"}, {"type": "subtitle", "time": 10850.07, "timestamp": "03:00:50", "text": "ランダム。あ、待って。購入する必要があります"}, {"type": "subtitle", "time": 10852.309, "timestamp": "03:00:52", "text": "そういうことですよね？ああ、彼らは"}, {"type": "subtitle", "time": 10855.269, "timestamp": "03:00:55", "text": "UI。ニース。ええ、彼らは全体をリセットしました"}, {"type": "subtitle", "time": 10857.51, "timestamp": "03:00:57", "text": "もの。ええ、すべてが"}]
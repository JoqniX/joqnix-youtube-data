[{"type": "subtitle", "time": 13020.63, "timestamp": "03:37:00", "text": "これをしろと言うなら、私は知りたい"}, {"type": "subtitle", "time": 13022.63, "timestamp": "03:37:02", "text": "問題点の1つ。これらのうちの1つをやった"}, {"type": "subtitle", "time": 13025.95, "timestamp": "03:37:05", "text": "問題は解決されますか？さあ"}, {"type": "subtitle", "time": 13029.07, "timestamp": "03:37:09", "text": "見る。お願いします"}, {"type": "subtitle", "time": 13032.269, "timestamp": "03:37:12", "text": "仕事。うん。おお、"}, {"type": "subtitle", "time": 13034.19, "timestamp": "03:37:14", "text": "待って。"}, {"type": "subtitle", "time": 13037.83, "timestamp": "03:37:17", "text": "ああ、わかりました。気づいたかもしれませんが、私は"}, {"type": "subtitle", "time": 13041.269, "timestamp": "03:37:21", "text": "古いノイズ素材を使っています。私の声は"}, {"type": "subtitle", "time": 13044.87, "timestamp": "03:37:24", "text": "あのアーティファクト現象のことですね。なぜ？私の"}, {"type": "subtitle", "time": 13048.15, "timestamp": "03:37:28", "text": "通常のプラグインは、"}, {"type": "subtitle", "time": 13051.67, "timestamp": "03:37:31", "text": "小川。戻ってDVRを見ると"}, {"type": "subtitle", "time": 13053.11, "timestamp": "03:37:33", "text": "最初に戻ると、"}, {"type": "subtitle", "time": 13055.91, "timestamp": "03:37:35", "text": "文字通り"}, {"type": "subtitle", "time": 13057.91, "timestamp": "03:37:37", "text": "あまりにも頻繁にシャッターを切ってしまう。それが"}, {"type": "subtitle", "time": 13065.429, "timestamp": "03:37:45", "text": "修正済みか否か。うーうーうーうー。あ、待って。"}, {"type": "subtitle", "time": 13070.51, "timestamp": "03:37:50", "text": "私はそれを設定していません。えっと"}, {"type": "subtitle", "time": 13075.99, "timestamp": "03:37:55", "text": "えーと。聖なる。今は正常に動作しています。こんにちは。どうやって"}]
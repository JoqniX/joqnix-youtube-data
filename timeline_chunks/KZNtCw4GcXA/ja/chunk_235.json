[{"type": "subtitle", "time": 14107.03, "timestamp": "03:55:07", "text": "こんにちは。本当にありがとうございました。特に"}, {"type": "subtitle", "time": 14109.59, "timestamp": "03:55:09", "text": "ヴィックとセレスティアに感謝します"}, {"type": "subtitle", "time": 14112.55, "timestamp": "03:55:12", "text": "彼らは私を一緒に遊ぼうと誘ってくれた。それは"}, {"type": "subtitle", "time": 14114.55, "timestamp": "03:55:14", "text": "楽しいですね。私はそこにいなかったけれど"}, {"type": "subtitle", "time": 14116.429, "timestamp": "03:55:16", "text": "ストリームの半分ですが、それでも、ありがとう"}, {"type": "subtitle", "time": 14119.51, "timestamp": "03:55:19", "text": "あなた。 2つのゲームが楽しかった"}, {"type": "subtitle", "time": 14121.91, "timestamp": "03:55:21", "text": "私たちが遊んだゲームは楽しかった。楽しみにしています"}, {"type": "subtitle", "time": 14124.309, "timestamp": "03:55:24", "text": "今後お二人とコラボレーションしていく"}, {"type": "subtitle", "time": 14126.469, "timestamp": "03:55:26", "text": "良い。でも、ありがとう"}, {"type": "subtitle", "time": 14130.07, "timestamp": "03:55:30", "text": "待っていた、待つのに十分な忍耐力のある人たち"}, {"type": "subtitle", "time": 14133.189, "timestamp": "03:55:33", "text": "そして、まだ希望を持っている。ありがとうございます"}, {"type": "subtitle", "time": 14135.55, "timestamp": "03:55:35", "text": "他の2人を支持した人物。感謝"}, {"type": "subtitle", "time": 14138.71, "timestamp": "03:55:38", "text": "あなた。そして予定通り、明日"}, {"type": "subtitle", "time": 14141.189, "timestamp": "03:55:41", "text": "私の配信はインド標準時午前10時です。私達はします"}, {"type": "subtitle", "time": 14144.71, "timestamp": "03:55:44", "text": "歌の配信をする予定です。私はそうはならないだろう"}, {"type": "subtitle", "time": 14146.71, "timestamp": "03:55:46", "text": "2時間の配信をしますが、"}, {"type": "subtitle", "time": 14148.55, "timestamp": "03:55:48", "text": "短い配信とか、"}, {"type": "subtitle", "time": 14151.269, "timestamp": "03:55:51", "text": "明日あたり、そんな感じのことを。それで"}, {"type": "subtitle", "time": 14154.63, "timestamp": "03:55:54", "text": "どうなるか見てみましょう。わかった。こんにちは、ジョーと"}, {"type": "subtitle", "time": 14157.51, "timestamp": "03:55:57", "text": "バイバイ。おやすみなさい、お母さん。良い一日をお過ごしください"}]
[{"type": "subtitle", "time": 10680.469, "timestamp": "02:58:00", "text": "みんな。こんにちは。元気ですか？したい"}, {"type": "subtitle", "time": 10688.389, "timestamp": "02:58:08", "text": "私はそうは思わない それはまるで"}, {"type": "subtitle", "time": 10691.07, "timestamp": "02:58:11", "text": "自動再生だけど、私が望むように"}, {"type": "subtitle", "time": 10694.95, "timestamp": "02:58:14", "text": "セレスティアへ。ニース。ああ、外にいるのは私です"}, {"type": "subtitle", "time": 10697.99, "timestamp": "02:58:17", "text": "窓。いいね。ええ、セレスティアです"}, {"type": "subtitle", "time": 10702.55, "timestamp": "02:58:22", "text": "そして君はティーバッグをしている。いいえ、私を好きになる"}, {"type": "subtitle", "time": 10709.07, "timestamp": "02:58:29", "text": "コーナグ・ユー。待って、やめて"}, {"type": "subtitle", "time": 10711.99, "timestamp": "02:58:31", "text": "ティーバッグ。オープンチャットで見つけました。"}, {"type": "subtitle", "time": 10714.71, "timestamp": "02:58:34", "text": "大丈夫。"}, {"type": "subtitle", "time": 10718.23, "timestamp": "02:58:38", "text": "ああ、大変だ。これはパン屋の仕業だった。"}, {"type": "subtitle", "time": 10721.429, "timestamp": "02:58:41", "text": "パン屋。はい、パンが原因でした。それは"}, {"type": "subtitle", "time": 10723.67, "timestamp": "02:58:43", "text": "とても可愛い。"}, {"type": "subtitle", "time": 10727.19, "timestamp": "02:58:47", "text": "本当に才能豊かですね。うん。最高"}, {"type": "subtitle", "time": 10731.11, "timestamp": "02:58:51", "text": "すごいね、君。鳥男。こんにちは。もし"}, {"type": "subtitle", "time": 10733.99, "timestamp": "02:58:53", "text": "あなたはジャックのチャットかセレスティアのチャットにいます。"}, {"type": "subtitle", "time": 10736.79, "timestamp": "02:58:56", "text": "こんにちは。"}, {"type": "subtitle", "time": 10739.83, "timestamp": "02:58:59", "text": "うん。こんにちは。試合に行こう。わかった。"}]
[{"type": "subtitle", "time": 20220.83, "timestamp": "05:37:00", "text": "競争力のあるスキルレベル"}, {"type": "subtitle", "time": 20223.59, "timestamp": "05:37:03", "text": "全てをそのように競争させる。元気です"}, {"type": "subtitle", "time": 20226.19, "timestamp": "05:37:06", "text": "それと。"}, {"type": "subtitle", "time": 20229.23, "timestamp": "05:37:09", "text": "えっと、ただそれは"}, {"type": "subtitle", "time": 20241.47, "timestamp": "05:37:21", "text": "気づいたんだ"}, {"type": "subtitle", "time": 20243.39, "timestamp": "05:37:23", "text": "それ"}, {"type": "subtitle", "time": 20246.39, "timestamp": "05:37:26", "text": "ゲームで競争することはおそらく"}, {"type": "subtitle", "time": 20247.548, "timestamp": "05:37:27", "text": "良いし"}, {"type": "subtitle", "time": 20260.99, "timestamp": "05:37:40", "text": "ええと、有害になる可能性があります"}, {"type": "subtitle", "time": 20263.15, "timestamp": "05:37:43", "text": "今。それで"}, {"type": "subtitle", "time": 20279.31, "timestamp": "05:37:59", "text": "[音楽]"}]
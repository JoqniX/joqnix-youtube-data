[{"type": "subtitle", "time": 16443.189, "timestamp": "04:34:03", "text": "小型レーザーペンは小さなビームを照射します"}, {"type": "subtitle", "time": 16445.91, "timestamp": "04:34:05", "text": "環境への光の照射。手持ち"}, {"type": "subtitle", "time": 16449.59, "timestamp": "04:34:09", "text": "移動中のプロジェクター。おお。ああ、2"}, {"type": "subtitle", "time": 16453.59, "timestamp": "04:34:13", "text": "プロテクター。私たちにはそれが必要なのです。おお。"}, {"type": "subtitle", "time": 16456.07, "timestamp": "04:34:16", "text": "さあ、行こう。"}, {"type": "subtitle", "time": 16457.83, "timestamp": "04:34:17", "text": "わかった。とにかく、行こう"}, {"type": "subtitle", "time": 16459.91, "timestamp": "04:34:19", "text": "プロ。気に入ったよ。私はしたくない"}, {"type": "subtitle", "time": 16462.47, "timestamp": "04:34:22", "text": "あっという間に死んでしまう。"}, {"type": "subtitle", "time": 16465.629, "timestamp": "04:34:25", "text": "中級。あのね？"}, {"type": "subtitle", "time": 16468.869, "timestamp": "04:34:28", "text": "プロ。プロとしてやろう。"}, {"type": "subtitle", "time": 16470.789, "timestamp": "04:34:30", "text": "中級は"}, {"type": "subtitle", "time": 16473.109, "timestamp": "04:34:33", "text": "もしあなたが"}, {"type": "subtitle", "time": 16474.551, "timestamp": "04:34:34", "text": "中級レベルに進む予定です。プロ、"}, {"type": "subtitle", "time": 16478.07, "timestamp": "04:34:38", "text": "私は思う。早く死のうが死ぬまいが、誰も気にしない。"}, {"type": "subtitle", "time": 16480.39, "timestamp": "04:34:40", "text": "さあ、やってみよう。"}, {"type": "subtitle", "time": 16486.15, "timestamp": "04:34:46", "text": "うん。準備完了。うん。"}, {"type": "subtitle", "time": 16489.47, "timestamp": "04:34:49", "text": "準備ができて？わーい。"}]
[{"type": "subtitle", "time": 18783.31, "timestamp": "05:13:03", "text": "時間カテゴリベースの自動化、"}, {"type": "subtitle", "time": 18787.47, "timestamp": "05:13:07", "text": "右？私たちは4時間を費やして働きました"}, {"type": "subtitle", "time": 18791.948, "timestamp": "05:13:11", "text": "あのサミーのやつでそれを作るんだ。"}, {"type": "subtitle", "time": 18797.11, "timestamp": "05:13:17", "text": "ええ、私が"}, {"type": "subtitle", "time": 18799.31, "timestamp": "05:13:19", "text": "でも問題は、それをやらなければならないということだ"}, {"type": "subtitle", "time": 18802.07, "timestamp": "05:13:22", "text": "動的に、あるいは複数作成できるかもしれません"}, {"type": "subtitle", "time": 18806.788, "timestamp": "05:13:26", "text": "画像。 1つは正午用、1つは昼食用"}, {"type": "subtitle", "time": 18809.19, "timestamp": "05:13:29", "text": "休憩、朝の休憩用、"}, {"type": "subtitle", "time": 18812.31, "timestamp": "05:13:32", "text": "私が寝ていて姿を見せていないとき、"}, {"type": "subtitle", "time": 18816.55, "timestamp": "05:13:36", "text": "そして、何のための1つなのか？行くべきもの"}, {"type": "subtitle", "time": 18818.83, "timestamp": "05:13:38", "text": "夕食休憩、お茶の時間"}, {"type": "subtitle", "time": 18822.31, "timestamp": "05:13:42", "text": "壊す。うん。うん。休憩時間のために。それで"}, {"type": "subtitle", "time": 18825.19, "timestamp": "05:13:45", "text": "今日でも人々は"}, {"type": "subtitle", "time": 18827.23, "timestamp": "05:13:47", "text": "理解できない"}, {"type": "subtitle", "time": 18830.27, "timestamp": "05:13:50", "text": "私はV字型にしています。"}, {"type": "subtitle", "time": 18833.19, "timestamp": "05:13:53", "text": "自分。それは人間ですか？彼らが"}, {"type": "subtitle", "time": 18837.11, "timestamp": "05:13:57", "text": "画面に表示されている内容が読めない、または"}]
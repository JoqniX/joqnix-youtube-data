[{"type": "subtitle", "time": 17881.11, "timestamp": "04:58:01", "text": "締め切り日か何かだから？えっと"}, {"type": "subtitle", "time": 17885.51, "timestamp": "04:58:05", "text": "わからない。本当にたくさんのものがあるよ。私 私"}, {"type": "subtitle", "time": 17888.11, "timestamp": "04:58:08", "text": "文字通り行った"}, {"type": "subtitle", "time": 17890.47, "timestamp": "04:58:10", "text": "ナッツ。でもね、知ってる？最後に"}, {"type": "subtitle", "time": 17892.59, "timestamp": "04:58:12", "text": "の"}, {"type": "subtitle", "time": 17899.75, "timestamp": "04:58:19", "text": "このような技術的な問題。私"}, {"type": "subtitle", "time": 17900.99, "timestamp": "04:58:20", "text": "考える"}, {"type": "subtitle", "time": 17903.99, "timestamp": "04:58:23", "text": "普段からこんな感じなので、問題ありません。その"}, {"type": "subtitle", "time": 17916.31, "timestamp": "04:58:36", "text": "仕事。まだ配信を続けているといいな。ええ、私は"}, {"type": "subtitle", "time": 17919.35, "timestamp": "04:58:39", "text": "まだ配信中です。"}, {"type": "subtitle", "time": 17922.67, "timestamp": "04:58:42", "text": "どうやって信号を送っているのか"}, {"type": "subtitle", "time": 17926.19, "timestamp": "04:58:46", "text": "文字通りすごいこれは"}, {"type": "subtitle", "time": 17930.07, "timestamp": "04:58:50", "text": "1,00 1,00 ビットですよね？ そうですよね？"}, {"type": "subtitle", "time": 17933.23, "timestamp": "04:58:53", "text": "ぼやけてるのか、そうじゃないのか、わからないけど"}, {"type": "subtitle", "time": 17935.47, "timestamp": "04:58:55", "text": "うん"}, {"type": "subtitle", "time": 17938.75, "timestamp": "04:58:58", "text": "なあ、わかるだろ？"}]
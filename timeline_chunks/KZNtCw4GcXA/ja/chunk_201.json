[{"type": "subtitle", "time": 12062.79, "timestamp": "03:21:02", "text": "気温。走るな、ジャック。私たちは隠れる。"}, {"type": "subtitle", "time": 12064.79, "timestamp": "03:21:04", "text": "何ももらえませんでした。分割ボックス。私たちは"}, {"type": "subtitle", "time": 12069.03, "timestamp": "03:21:09", "text": "幽霊乗りは見かけなかった。紫外線なし。私たちは"}, {"type": "subtitle", "time": 12072.229, "timestamp": "03:21:12", "text": "オッズのようなものは何もしなかった。似たようなものはない"}, {"type": "subtitle", "time": 12075.51, "timestamp": "03:21:15", "text": "EMFのようなものはない"}, {"type": "subtitle", "time": 12078.79, "timestamp": "03:21:18", "text": "まるでそれが私に迫ってくるようだ。ああ、そこにいる"}, {"type": "subtitle", "time": 12080.79, "timestamp": "03:21:20", "text": "は。心配しないで。大丈夫です。"}, {"type": "subtitle", "time": 12082.63, "timestamp": "03:21:22", "text": "大丈夫です。あなたは素晴らしいことをしています。"}, {"type": "subtitle", "time": 12084.55, "timestamp": "03:21:24", "text": "うん、君はすごくよくやってるよ。うん、君"}, {"type": "subtitle", "time": 12088.07, "timestamp": "03:21:28", "text": "生き延びる ああ、なんてことだ。大丈夫です。私は私は"}, {"type": "subtitle", "time": 12090.229, "timestamp": "03:21:30", "text": "あなたを選びます。ああ、あのね？"}, {"type": "subtitle", "time": 12094.07, "timestamp": "03:21:34", "text": "悪魔だ、私は悪魔になる。なぜ？"}, {"type": "subtitle", "time": 12096.07, "timestamp": "03:21:36", "text": "何か選んでみます。選ぶ"}, {"type": "subtitle", "time": 12099.11, "timestamp": "03:21:39", "text": "何か。ただ、ただ、ただ"}, {"type": "subtitle", "time": 12101.99, "timestamp": "03:21:41", "text": "ほどく。運が良ければ、行こう。"}, {"type": "subtitle", "time": 12104.15, "timestamp": "03:21:44", "text": "おかえり。私はそういうことは理解できなかった"}, {"type": "subtitle", "time": 12106.95, "timestamp": "03:21:46", "text": "それはジンだった。どうでも。これはジンです。"}, {"type": "subtitle", "time": 12109.99, "timestamp": "03:21:49", "text": "これはジンです。それはいいです。それは発見された"}, {"type": "subtitle", "time": 12113.269, "timestamp": "03:21:53", "text": "証拠。 EMF測定器。誰が？誰が"}, {"type": "subtitle", "time": 12116.87, "timestamp": "03:21:56", "text": "それ？ああ、私は電磁場測定器を持っていました。そうだね"}]
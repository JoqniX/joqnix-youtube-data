[{"type": "subtitle", "time": 17221.43, "timestamp": "04:47:01", "text": "すべて。フラッシュライトか何か"}, {"type": "subtitle", "time": 17223.47, "timestamp": "04:47:03", "text": "例外か何か。私はしません"}, {"type": "subtitle", "time": 17224.64, "timestamp": "04:47:04", "text": "知る。"}, {"type": "subtitle", "time": 17226.67, "timestamp": "04:47:06", "text": "[笑い]"}, {"type": "subtitle", "time": 17229.39, "timestamp": "04:47:09", "text": "ひどい。この地図は"}, {"type": "subtitle", "time": 17239.03, "timestamp": "04:47:19", "text": "はい、動作が遅いです。ああ、実は私は"}, {"type": "subtitle", "time": 17240.868, "timestamp": "04:47:20", "text": "この地図。それは、それは、それは、"}, {"type": "subtitle", "time": 17243.83, "timestamp": "04:47:23", "text": "かわいい。とても寒いです。ああ、いや、"}, {"type": "subtitle", "time": 17247.55, "timestamp": "04:47:27", "text": "キャンプ。ああ、これは嫌だ。"}, {"type": "subtitle", "time": 17250.23, "timestamp": "04:47:30", "text": "ザック、あの枕を見て。見てください"}, {"type": "subtitle", "time": 17251.99, "timestamp": "04:47:31", "text": "プール。"}, {"type": "subtitle", "time": 17255.83, "timestamp": "04:47:35", "text": "つまり、あなたたちはプロですよね。私はそうではありません。"}, {"type": "subtitle", "time": 17257.67, "timestamp": "04:47:37", "text": "わかった、ドスで行くよ。私は"}, {"type": "subtitle", "time": 17260.23, "timestamp": "04:47:40", "text": "ドスと一緒に行くよ。"}, {"type": "subtitle", "time": 17261.83, "timestamp": "04:47:41", "text": "私はこのゲームの遊び方が全く分かりません"}, {"type": "subtitle", "time": 17264.39, "timestamp": "04:47:44", "text": "ゲームもだけど、雰囲気を楽しむためにここに来たんだ。私はできる"}, {"type": "subtitle", "time": 17267.11, "timestamp": "04:47:47", "text": "スピリットボックスは持ってますよね？私"}, {"type": "subtitle", "time": 17269.27, "timestamp": "04:47:49", "text": "スピリットボックスを使うこともできる。"}, {"type": "subtitle", "time": 17272.39, "timestamp": "04:47:52", "text": "ああ、俺は神だ。私は神だ。病気"}, {"type": "subtitle", "time": 17275.91, "timestamp": "04:47:55", "text": "紫色の光る棒を取ってください。"}, {"type": "subtitle", "time": 17278.99, "timestamp": "04:47:58", "text": "クロノスがここにいる。こんにちは。静かに"}]
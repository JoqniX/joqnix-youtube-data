[{"type": "subtitle", "time": 11400.71, "timestamp": "03:10:00", "text": "懐中電灯は私の体に付いていると思う。"}, {"type": "subtitle", "time": 11403.51, "timestamp": "03:10:03", "text": "2階にあります。うん。ああ、幽霊は"}, {"type": "subtitle", "time": 11405.75, "timestamp": "03:10:05", "text": "二階へ上がってきます。なんてこった。うん。うん。走る"}, {"type": "subtitle", "time": 11407.07, "timestamp": "03:10:07", "text": "離れて。走る"}, {"type": "subtitle", "time": 11411.19, "timestamp": "03:10:11", "text": "離れて。私はしたくない。私はしたくない。"}, {"type": "subtitle", "time": 11412.63, "timestamp": "03:10:12", "text": "私はしたくない。私には無理です。の"}, {"type": "subtitle", "time": 11414.309, "timestamp": "03:10:14", "text": "幽霊は二階へ上がった。一人でプレイする。その"}, {"type": "subtitle", "time": 11416.07, "timestamp": "03:10:16", "text": "バカバカしいことになるだろう。"}, {"type": "subtitle", "time": 11418.55, "timestamp": "03:10:18", "text": "ああ、息が詰まってるよ。"}, {"type": "subtitle", "time": 11420.23, "timestamp": "03:10:20", "text": "うん、大丈夫だよ。大丈夫です。それは"}, {"type": "subtitle", "time": 11421.75, "timestamp": "03:10:21", "text": "軽い窒息。彼は私に"}, {"type": "subtitle", "time": 11424.87, "timestamp": "03:10:24", "text": "首のマッサージ。大丈夫です。"}, {"type": "subtitle", "time": 11431.03, "timestamp": "03:10:31", "text": "ああ、彼らは亡くなった。よし、これで全員死んだ。"}, {"type": "subtitle", "time": 11432.55, "timestamp": "03:10:32", "text": "悪夢ってそういうものだと思う"}, {"type": "subtitle", "time": 11434.07, "timestamp": "03:10:34", "text": "モードですよね？それはあなたに"}, {"type": "subtitle", "time": 11436.79, "timestamp": "03:10:36", "text": "準備と出発に少し時間がかかる"}, {"type": "subtitle", "time": 11442.95, "timestamp": "03:10:42", "text": "ええ、それはとても、あなたが何をするかということです"}, {"type": "subtitle", "time": 11445.269, "timestamp": "03:10:45", "text": "それを何と呼ぶ？おお。毎日他の人と遊ぶ"}, {"type": "subtitle", "time": 11447.269, "timestamp": "03:10:47", "text": "捜査官。私たちは100ドルを手に入れました"}, {"type": "subtitle", "time": 11450.309, "timestamp": "03:10:50", "text": "何もない。 50ドルが無駄になった。さあ行こう。"}, {"type": "subtitle", "time": 11453.6, "timestamp": "03:10:53", "text": "さあ行こう。 おお。"}, {"type": "subtitle", "time": 11455.12, "timestamp": "03:10:55", "text": "おお。 ところで、何か買いたいものはありますか？"}, {"type": "subtitle", "time": 11459.279, "timestamp": "03:10:59", "text": "ところで、何か買いたいものはありますか？ 何を買うべきか？"}]
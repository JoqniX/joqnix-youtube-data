[{"type": "subtitle", "time": 10561.71, "timestamp": "02:56:01", "text": "うん。えーと、えーと、私は"}, {"type": "subtitle", "time": 10564.55, "timestamp": "02:56:04", "text": "フィードバック。えっと、通知が来たら"}, {"type": "subtitle", "time": 10568.269, "timestamp": "02:56:08", "text": "彼らはミュートを解除している。ええ、ぜひ"}, {"type": "subtitle", "time": 10571.59, "timestamp": "02:56:11", "text": "知る。 Veがここにいます。うん、やろうよ"}, {"type": "subtitle", "time": 10575.269, "timestamp": "02:56:15", "text": "今日一番良い。今日はベストを尽くそう。"}, {"type": "subtitle", "time": 10578.07, "timestamp": "02:56:18", "text": "ああ、緊張する。私は怖いです。私は"}, {"type": "subtitle", "time": 10580.55, "timestamp": "02:56:20", "text": "様々な感情が湧き上がってくる。うん、"}, {"type": "subtitle", "time": 10587.87, "timestamp": "02:56:27", "text": "[音楽]"}, {"type": "subtitle", "time": 10590.91, "timestamp": "02:56:30", "text": "最高。はい、すべてを閉じます"}, {"type": "subtitle", "time": 10592.91, "timestamp": "02:56:32", "text": "これ。私は"}, {"type": "subtitle", "time": 10595.72, "timestamp": "02:56:35", "text": "準備ができて。いや、違うよ。"}, {"type": "subtitle", "time": 10598.51, "timestamp": "02:56:38", "text": "[音楽]"}, {"type": "subtitle", "time": 10604.79, "timestamp": "02:56:44", "text": "大丈夫です。私だけでしょうか？"}, {"type": "subtitle", "time": 10608.66, "timestamp": "02:56:48", "text": "それ持ってる？わかった。私は管理者ですか？"}]
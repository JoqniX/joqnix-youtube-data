[{"type": "subtitle", "time": 15660.389, "timestamp": "04:21:00", "text": "ああ、大変だ。これはパン屋の仕業だった。"}, {"type": "subtitle", "time": 15663.59, "timestamp": "04:21:03", "text": "パン屋。はい、パンが原因でした。それは"}, {"type": "subtitle", "time": 15665.83, "timestamp": "04:21:05", "text": "とても可愛い。"}, {"type": "subtitle", "time": 15669.349, "timestamp": "04:21:09", "text": "本当に才能豊かですね。うん。最高"}, {"type": "subtitle", "time": 15673.269, "timestamp": "04:21:13", "text": "すごいね、君。鳥男。こんにちは。もし"}, {"type": "subtitle", "time": 15675.83, "timestamp": "04:21:15", "text": "あなたはジャックのチャットにいます。"}, {"type": "subtitle", "time": 15678.03, "timestamp": "04:21:18", "text": "チャット。"}, {"type": "subtitle", "time": 15681.189, "timestamp": "04:21:21", "text": "こんにちは。うん。こんにちは。試合に行こう。"}, {"type": "subtitle", "time": 15683.99, "timestamp": "04:21:23", "text": "わかった。うん。面白い事実、私は"}, {"type": "subtitle", "time": 15687.429, "timestamp": "04:21:27", "text": "私がやっているような、ちょっとおしゃれなもの"}, {"type": "subtitle", "time": 15689.59, "timestamp": "04:21:29", "text": "唯一のこと。"}, {"type": "subtitle", "time": 15691.67, "timestamp": "04:21:31", "text": "皆さんは2Dモデルをお持ちなので、"}, {"type": "subtitle", "time": 15693.429, "timestamp": "04:21:33", "text": "やらなくてもいいですよ。でも私には"}, {"type": "subtitle", "time": 15697.03, "timestamp": "04:21:37", "text": "このPNGモデルのように。だから私は"}, {"type": "subtitle", "time": 15699.75, "timestamp": "04:21:39", "text": "何か凝ったことをする"}, {"type": "subtitle", "time": 15703.67, "timestamp": "04:21:43", "text": "えっと、あなたたちが話した後で。私はただ好き"}, {"type": "subtitle", "time": 15705.83, "timestamp": "04:21:45", "text": "君たちは3つのアドオンを持っているけど、えーと"}, {"type": "subtitle", "time": 15707.59, "timestamp": "04:21:47", "text": "残念ながら、すべてがクラッシュしてしまいました。"}, {"type": "subtitle", "time": 15710.07, "timestamp": "04:21:50", "text": "そして燃えてしまい、何も積み込まれていなかった。"}, {"type": "subtitle", "time": 15712.55, "timestamp": "04:21:52", "text": "だから、私は本当にデフォルトして"}, {"type": "subtitle", "time": 15717.189, "timestamp": "04:21:57", "text": "すべてをもう一度やり直す。というわけで、そういうことです。"}, {"type": "subtitle", "time": 15719.75, "timestamp": "04:21:59", "text": "最初の10分で私が擦りむいた"}]
[{"type": "subtitle", "time": 13620.07, "timestamp": "03:47:00", "text": "すべて。知らない人のために、私は"}, {"type": "subtitle", "time": 13623.63, "timestamp": "03:47:03", "text": "ハッシュにこの一時的なモッドを与えた"}, {"type": "subtitle", "time": 13626.429, "timestamp": "03:47:06", "text": "ストリーム配信したいと思ったから"}, {"type": "subtitle", "time": 13629.07, "timestamp": "03:47:09", "text": "ええと、それは必要です"}, {"type": "subtitle", "time": 13632.79, "timestamp": "03:47:12", "text": "今。でも、心配しないでください。えっと、彼はただ"}, {"type": "subtitle", "time": 13635.83, "timestamp": "03:47:15", "text": "一時モード。彼が"}, {"type": "subtitle", "time": 13638.11, "timestamp": "03:47:18", "text": "選出された"}, {"type": "subtitle", "time": 13646.469, "timestamp": "03:47:26", "text": "うん、だって、時間が取れなかったんだもん"}, {"type": "subtitle", "time": 13648.55, "timestamp": "03:47:28", "text": "だって、文字通りスピードランしてたんだもん"}, {"type": "subtitle", "time": 13651.11, "timestamp": "03:47:31", "text": "その他にもいろいろあります。私は"}, {"type": "subtitle", "time": 13654.87, "timestamp": "03:47:34", "text": "チャットのルールを見直して、"}, {"type": "subtitle", "time": 13658.229, "timestamp": "03:47:38", "text": "チャットボードで言うこと"}, {"type": "subtitle", "time": 13660.79, "timestamp": "03:47:40", "text": "文字通りチェックしに来ました"}, {"type": "subtitle", "time": 13663.349, "timestamp": "03:47:43", "text": "ストリームチャットのルールなど、"}, {"type": "subtitle", "time": 13664.87, "timestamp": "03:47:44", "text": "壊したり、そういう類のこと全部。私は"}, {"type": "subtitle", "time": 13667.91, "timestamp": "03:47:47", "text": "やるべきだったんだけど、文字通り走った"}, {"type": "subtitle", "time": 13670.309, "timestamp": "03:47:50", "text": "時間切れだ。もうその時間だった"}, {"type": "subtitle", "time": 13672.15, "timestamp": "03:47:52", "text": "コラボレーションとか色々。"}, {"type": "subtitle", "time": 13673.229, "timestamp": "03:47:53", "text": "だから私は"}, {"type": "subtitle", "time": 13676.15, "timestamp": "03:47:56", "text": "なぜ私が彼女を嫌うのか、追跡する理由がわからなかった。おお"}]
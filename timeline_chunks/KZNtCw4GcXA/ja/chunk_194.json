[{"type": "subtitle", "time": 11641.99, "timestamp": "03:14:01", "text": "統計。私は紫外線ライトを持っています。さあ行こう。"}, {"type": "subtitle", "time": 11644.08, "timestamp": "03:14:04", "text": "さあ行こう。 わかった。ゴーストさん、何かしましたか？"}, {"type": "subtitle", "time": 11647.76, "timestamp": "03:14:07", "text": "わかった。ゴーストさん、何かしましたか？ いたずらっ子？はいの場合、紫外線で示してください"}, {"type": "subtitle", "time": 11651.12, "timestamp": "03:14:11", "text": "いたずらっ子？はいの場合、紫外線で示してください ライト。うん。ああ、そうするべきだ、そうするべきだ"}, {"type": "subtitle", "time": 11653.52, "timestamp": "03:14:13", "text": "ライト。うん。ああ、そうするべきだ、そうするべきだ ゲーム内で会話して、ああ、私たちは"}, {"type": "subtitle", "time": 11655.12, "timestamp": "03:14:15", "text": "ゲーム内で会話して、ああ、私たちは 幽霊の話はもう一度読まなかった。"}, {"type": "subtitle", "time": 11657.52, "timestamp": "03:14:17", "text": "幽霊の話はもう一度読まなかった。 いや、まさか。"}, {"type": "subtitle", "time": 11660.16, "timestamp": "03:14:20", "text": "いや、まさか。 放してくれ。えっと、幽霊の名前は"}, {"type": "subtitle", "time": 11664.16, "timestamp": "03:14:24", "text": "放してくれ。えっと、幽霊の名前は は"}, {"type": "subtitle", "time": 11666.64, "timestamp": "03:14:26", "text": "は こんにちは。こんにちは。あなたはここにいますか？どこに"}, {"type": "subtitle", "time": 11670.439, "timestamp": "03:14:30", "text": "こんにちは。こんにちは。あなたはここにいますか？どこに あなた？何歳ですか？"}, {"type": "subtitle", "time": 11677.67, "timestamp": "03:14:37", "text": "こんにちは。"}, {"type": "subtitle", "time": 11684.63, "timestamp": "03:14:44", "text": "エイプリル、こっちにいる？おいで、ハス。"}, {"type": "subtitle", "time": 11688.63, "timestamp": "03:14:48", "text": "こんにちは、エイプリル。ああ、みんな持っているの？"}]
[{"type": "subtitle", "time": 18487.27, "timestamp": "05:08:07", "text": "それ。今日は、"}, {"type": "subtitle", "time": 18489.15, "timestamp": "05:08:09", "text": "私は内向的です。"}, {"type": "subtitle", "time": 18493.15, "timestamp": "05:08:13", "text": "右？えっと、私がどれだけ内向的になれるか"}, {"type": "subtitle", "time": 18496.948, "timestamp": "05:08:16", "text": "そういうことがたくさん手に入る。"}, {"type": "subtitle", "time": 18500.19, "timestamp": "05:08:20", "text": "えっと、どこから始めればいいかな"}, {"type": "subtitle", "time": 18504.47, "timestamp": "05:08:24", "text": "そのような"}, {"type": "subtitle", "time": 18506.11, "timestamp": "05:08:26", "text": "えっと、あなた"}, {"type": "subtitle", "time": 18509.19, "timestamp": "05:08:29", "text": "ヴァレラントでも、"}, {"type": "subtitle", "time": 18517.788, "timestamp": "05:08:37", "text": "待つために、私はライブ配信していません"}, {"type": "subtitle", "time": 18539.02, "timestamp": "05:08:59", "text": "神。今気づいたよ"}]
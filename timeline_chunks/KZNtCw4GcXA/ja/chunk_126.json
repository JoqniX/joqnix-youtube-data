[{"type": "subtitle", "time": 7561.75, "timestamp": "02:06:01", "text": "もし私がトラウマを負っていなければ。"}, {"type": "subtitle", "time": 7565.629, "timestamp": "02:06:05", "text": "私にとって永遠に、私の"}, {"type": "subtitle", "time": 7568.79, "timestamp": "02:06:08", "text": "マイクがヴァレラントであろうと、"}, {"type": "subtitle", "time": 7570.83, "timestamp": "02:06:10", "text": "ベアまたはその他"}, {"type": "subtitle", "time": 7589.55, "timestamp": "02:06:29", "text": "地獄のクソ"}]
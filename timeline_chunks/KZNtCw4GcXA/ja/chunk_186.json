[{"type": "subtitle", "time": 11163.15, "timestamp": "03:06:03", "text": "ええ、あなたは"}, {"type": "subtitle", "time": 11166.87, "timestamp": "03:06:06", "text": "地下室で一体何を手に入れるのか"}, {"type": "subtitle", "time": 11168.95, "timestamp": "03:06:08", "text": "それは何と呼ぶのですか？ああ、そうだね。うん、"}, {"type": "subtitle", "time": 11170.469, "timestamp": "03:06:10", "text": "の"}, {"type": "subtitle", "time": 11173.349, "timestamp": "03:06:13", "text": "待て、これ、どんどん大きくなっているぞ。"}, {"type": "subtitle", "time": 11178.63, "timestamp": "03:06:18", "text": "はい。 EMFが発生しました。まるでその一つみたいだ。"}, {"type": "subtitle", "time": 11180.71, "timestamp": "03:06:20", "text": "ああ、少なくとも"}, {"type": "subtitle", "time": 11182.87, "timestamp": "03:06:22", "text": "それを捉えるために4つ。いいえ、"}, {"type": "subtitle", "time": 11184.87, "timestamp": "03:06:24", "text": "いや、いや。 5つ必要です。私たちには必要だ"}, {"type": "subtitle", "time": 11187.309, "timestamp": "03:06:27", "text": "5つであって、4つではない。 5人必要です。によって"}, {"type": "subtitle", "time": 11196.389, "timestamp": "03:06:36", "text": "私はまだただランダムに探索しているだけです"}, {"type": "subtitle", "time": 11198.87, "timestamp": "03:06:38", "text": "この場所。自分がどこにいるのか分からない。私は"}, {"type": "subtitle", "time": 11200.95, "timestamp": "03:06:40", "text": "2階へ。ええ、どうやらそれはああ"}, {"type": "subtitle", "time": 11203.51, "timestamp": "03:06:43", "text": "神。バカバカバカマネキン。"}, {"type": "subtitle", "time": 11206.23, "timestamp": "03:06:46", "text": "とにかく、ええと、スイッチがあります。"}, {"type": "subtitle", "time": 11209.11, "timestamp": "03:06:49", "text": "ここにスイッチがあります。フーがいる。"}, {"type": "subtitle", "time": 11212.07, "timestamp": "03:06:52", "text": "ここにフースがいる。ああ、あの、"}, {"type": "subtitle", "time": 11214.63, "timestamp": "03:06:54", "text": "ヒューズを修理しますか？ああ、懐中電灯が必要だ。"}, {"type": "subtitle", "time": 11217.349, "timestamp": "03:06:57", "text": "私のジャックがあちこちに飛んでいってしまうんです。わかった、"}, {"type": "subtitle", "time": 11219.91, "timestamp": "03:06:59", "text": "わかった。わかった。わかった。わかった。"}]
[{"type": "subtitle", "time": 181.35, "timestamp": "00:03:01", "text": "ゲームはいつも君が遊んでいる"}, {"type": "subtitle", "time": 184.11, "timestamp": "00:03:04", "text": "彼らはいつも"}, {"type": "subtitle", "time": 187.71, "timestamp": "00:03:07", "text": "今、私は"}, {"type": "subtitle", "time": 191.71, "timestamp": "00:03:11", "text": "私は本当に何をしたいのだろうか"}, {"type": "subtitle", "time": 195.55, "timestamp": "00:03:15", "text": "この瞬間。それが私の気持ちです"}, {"type": "subtitle", "time": 198.15, "timestamp": "00:03:18", "text": "のように。本当にこれをプレイしたいのか"}, {"type": "subtitle", "time": 200.27, "timestamp": "00:03:20", "text": "[音楽]"}, {"type": "subtitle", "time": 203.43, "timestamp": "00:03:23", "text": "ゲーム？持続する。私は考えたことがない"}, {"type": "subtitle", "time": 206.589, "timestamp": "00:03:26", "text": "チェーンをプレイ"}, {"type": "subtitle", "time": 213.50900000000001, "timestamp": "00:03:33", "text": "ソロ。持続する。"}, {"type": "subtitle", "time": 217.07, "timestamp": "00:03:37", "text": "ええと、今頃ほとんどの人が"}, {"type": "subtitle", "time": 220.309, "timestamp": "00:03:40", "text": "ソロコンテンツに飽きてしまった"}, {"type": "subtitle", "time": 223.91, "timestamp": "00:03:43", "text": "コラボレーションというほどではないけれど、"}, {"type": "subtitle", "time": 230.55, "timestamp": "00:03:50", "text": "わからない。時々私は"}, {"type": "subtitle", "time": 234.67000000000002, "timestamp": "00:03:54", "text": "ソロタイプのソロにはより制限がある"}]
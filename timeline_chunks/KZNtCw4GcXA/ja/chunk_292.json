[{"type": "subtitle", "time": 17522.39, "timestamp": "04:52:02", "text": "見せていただき、本当にありがとうございました。できる"}, {"type": "subtitle", "time": 17525.83, "timestamp": "04:52:05", "text": "缶の1つを開けると"}, {"type": "subtitle", "time": 17529.43, "timestamp": "04:52:09", "text": "どうして君たちはそうなのか分からない。それは"}, {"type": "subtitle", "time": 17533.75, "timestamp": "04:52:13", "text": "それは召喚陣だ。なんてこった。おい、"}, {"type": "subtitle", "time": 17536.15, "timestamp": "04:52:16", "text": "すべてを見つけるあなたを見て"}, {"type": "subtitle", "time": 17543.43, "timestamp": "04:52:23", "text": "紫外線による速度違反はありますか？いいえ。"}, {"type": "subtitle", "time": 17545.91, "timestamp": "04:52:25", "text": "右。いいえ、まだです。私は見ませんでした"}, {"type": "subtitle", "time": 17554.47, "timestamp": "04:52:34", "text": "サッカー映画そのもの。"}, {"type": "subtitle", "time": 17558.15, "timestamp": "04:52:38", "text": "わかった。わかった。まだダヴがいるよ。"}, {"type": "subtitle", "time": 17560.948, "timestamp": "04:52:40", "text": "うん。うん。"}, {"type": "subtitle", "time": 17562.948, "timestamp": "04:52:42", "text": "さらに楽しいよ。実際は、"}, {"type": "subtitle", "time": 17565.03, "timestamp": "04:52:45", "text": "ダヴァの方が実際は楽しいよ。あなたはしない"}, {"type": "subtitle", "time": 17567.99, "timestamp": "04:52:47", "text": "こういうのが好きでないといけない、これは穏やかで、"}, {"type": "subtitle", "time": 17569.83, "timestamp": "04:52:49", "text": "右？貪り食うのはもっと"}, {"type": "subtitle", "time": 17571.43, "timestamp": "04:52:51", "text": "アクション満載。"}, {"type": "subtitle", "time": 17573.67, "timestamp": "04:52:53", "text": "うん。うん。こんにちは、みんな。私は違います"}, {"type": "subtitle", "time": 17576.07, "timestamp": "04:52:56", "text": "怖くない、ただ"}, {"type": "subtitle", "time": 17578.07, "timestamp": "04:52:58", "text": "歩き回ってみる。のんびりできるゲーム。寒い"}]
[{"type": "subtitle", "time": 20288.47, "timestamp": "05:38:08", "text": "今、私の頭の中にはたくさんのことが詰まっている。"}, {"type": "subtitle", "time": 20290.03, "timestamp": "05:38:10", "text": "なし"}, {"type": "subtitle", "time": 20292.548, "timestamp": "05:38:12", "text": "そこには。実際にはたくさんのものがあります"}, {"type": "subtitle", "time": 20294.948, "timestamp": "05:38:14", "text": "今、私の頭の中はこんな感じです。私はこうするつもりです"}, {"type": "subtitle", "time": 20301.23, "timestamp": "05:38:21", "text": "[音楽]"}, {"type": "subtitle", "time": 20310.59, "timestamp": "05:38:30", "text": "ズームズームするよ"}, {"type": "subtitle", "time": 20317.91, "timestamp": "05:38:37", "text": "ずっと上へ下へ上へ下へ上へ"}, {"type": "subtitle", "time": 20318.99, "timestamp": "05:38:38", "text": "下へ"}, {"type": "subtitle", "time": 20321.75, "timestamp": "05:38:41", "text": "そこには。これを自動化できたらどうなるだろうか。"}, {"type": "subtitle", "time": 20324.11, "timestamp": "05:38:44", "text": "それはそうだろう"}, {"type": "subtitle", "time": 20334.47, "timestamp": "05:38:54", "text": "これ。それはとても素晴らしいでしょう。ともかく、"}]
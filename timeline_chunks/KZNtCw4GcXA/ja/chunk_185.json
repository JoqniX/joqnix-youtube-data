[{"type": "subtitle", "time": 11100.87, "timestamp": "03:05:00", "text": "待って、中に誰かいるの？ミスター・アイル"}, {"type": "subtitle", "time": 11102.71, "timestamp": "03:05:02", "text": "すぐ戻ります。読むだけです"}, {"type": "subtitle", "time": 11106.07, "timestamp": "03:05:06", "text": "幽霊について簡単に説明します。わかった。おお。"}, {"type": "subtitle", "time": 11108.79, "timestamp": "03:05:08", "text": "ああ、それはやらなきゃいけないよ。ああ、気にしないで。"}, {"type": "subtitle", "time": 11110.87, "timestamp": "03:05:10", "text": "私はただ壁を抱きしめているだけです"}, {"type": "subtitle", "time": 11113.03, "timestamp": "03:05:13", "text": "場合。これは正常なことです。これは正常なことです。私の"}, {"type": "subtitle", "time": 11117.83, "timestamp": "03:05:17", "text": "手が震えている。私の目は"}, {"type": "subtitle", "time": 11121.59, "timestamp": "03:05:21", "text": "名前はバーバラです。"}, {"type": "subtitle", "time": 11123.15, "timestamp": "03:05:23", "text": "わかった。うん。"}, {"type": "subtitle", "time": 11126.95, "timestamp": "03:05:26", "text": "バルバド・バルバラ。何てことだ。彼女は彼女は"}, {"type": "subtitle", "time": 11129.11, "timestamp": "03:05:29", "text": "ヒーラー。彼女は悪くない"}, {"type": "subtitle", "time": 11133.15, "timestamp": "03:05:33", "text": "ヒーラー。うん。私は怖いです。"}, {"type": "subtitle", "time": 11135.75, "timestamp": "03:05:35", "text": "こんにちは。その部屋に入ることができますか？感謝"}, {"type": "subtitle", "time": 11138.87, "timestamp": "03:05:38", "text": "あなた。私たちはする必要があります"}, {"type": "subtitle", "time": 11140.79, "timestamp": "03:05:40", "text": "幽霊を目撃した人物と、"}, {"type": "subtitle", "time": 11143.269, "timestamp": "03:05:43", "text": "幽霊から逃げるために"}, {"type": "subtitle", "time": 11147.91, "timestamp": "03:05:47", "text": "電磁界測定信号を取得する。"}, {"type": "subtitle", "time": 11152.79, "timestamp": "03:05:52", "text": "うん。こんにちは。いらっしゃいませ。いらっしゃいませ。はい。はい。"}, {"type": "subtitle", "time": 11154.07, "timestamp": "03:05:54", "text": "わかった。中に入ることができますか"}, {"type": "subtitle", "time": 11155.59, "timestamp": "03:05:55", "text": "トイレをお願いします。どうもありがとうございます。"}, {"type": "subtitle", "time": 11157.83, "timestamp": "03:05:57", "text": "えっと、懐中電灯を見せてください"}]
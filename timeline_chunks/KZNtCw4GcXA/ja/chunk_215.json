[{"type": "subtitle", "time": 12906.75, "timestamp": "03:35:06", "text": "これらすべてを知っている"}, {"type": "subtitle", "time": 12909.51, "timestamp": "03:35:09", "text": "私がまだVCにいた頃だったと思います。私"}, {"type": "subtitle", "time": 12910.95, "timestamp": "03:35:10", "text": "知らないと思うけど、そうじゃなかったらいいな"}, {"type": "subtitle", "time": 12913.67, "timestamp": "03:35:13", "text": "音声が聞こえたので、"}, {"type": "subtitle", "time": 12917.03, "timestamp": "03:35:17", "text": "電話も同様です。私のBluetooth"}, {"type": "subtitle", "time": 12919.83, "timestamp": "03:35:19", "text": "イヤホンは普段から持っています"}, {"type": "subtitle", "time": 12923.349, "timestamp": "03:35:23", "text": "音声が出力されなかったかのように動作しません"}, {"type": "subtitle", "time": 12927.11, "timestamp": "03:35:27", "text": "この車の中でたくさん話していたんだけど、えっと"}, {"type": "subtitle", "time": 12929.67, "timestamp": "03:35:29", "text": "WhatsAppを送信しているときにそれに気づきました"}, {"type": "subtitle", "time": 12933.19, "timestamp": "03:35:33", "text": "父にメッセージを送って、何が起こっているか確認して"}, {"type": "subtitle", "time": 12936.15, "timestamp": "03:35:36", "text": "インターネットでは、"}, {"type": "subtitle", "time": 12939.99, "timestamp": "03:35:39", "text": "出産予定日とか、えっと、よくわからないので"}, {"type": "subtitle", "time": 12950.429, "timestamp": "03:35:50", "text": "でもね、知ってる？最後に"}, {"type": "subtitle", "time": 12957.67, "timestamp": "03:35:57", "text": "は。このような技術的な問題。私"}, {"type": "subtitle", "time": 12958.91, "timestamp": "03:35:58", "text": "考える"}]
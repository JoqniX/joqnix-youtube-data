[{"type": "subtitle", "time": 16141.03, "timestamp": "04:29:01", "text": "この場所。自分がどこにいるのか分からない。私は"}, {"type": "subtitle", "time": 16143.11, "timestamp": "04:29:03", "text": "2階へ。ええ、どうやらそれはああ"}, {"type": "subtitle", "time": 16145.75, "timestamp": "04:29:05", "text": "神。バカバカバカマネキン。"}, {"type": "subtitle", "time": 16148.389, "timestamp": "04:29:08", "text": "とにかく、ええと、スイッチがあります。"}, {"type": "subtitle", "time": 16151.269, "timestamp": "04:29:11", "text": "ここにスイッチがあります。フーがいる。"}, {"type": "subtitle", "time": 16154.229, "timestamp": "04:29:14", "text": "ここにフースがいる。ああ、あの、"}, {"type": "subtitle", "time": 16156.87, "timestamp": "04:29:16", "text": "ヒューズを修理しますか？ああ、懐中電灯が必要だ。"}, {"type": "subtitle", "time": 16159.269, "timestamp": "04:29:19", "text": "でもジャックはどこにでも行くんだ。"}, {"type": "subtitle", "time": 16160.95, "timestamp": "04:29:20", "text": "はい、わかりました。わかった。わかった。私"}, {"type": "subtitle", "time": 16164.71, "timestamp": "04:29:24", "text": "わかった。うん。ニース。"}, {"type": "subtitle", "time": 16167.349, "timestamp": "04:29:27", "text": "なぜ私はあなたを見ることができないのですか？"}, {"type": "subtitle", "time": 16170.07, "timestamp": "04:29:30", "text": "うん。開けてください。ああ、何ですか、"}, {"type": "subtitle", "time": 16173.91, "timestamp": "04:29:33", "text": "マネキン。ああ。ああ、行こう。これは"}, {"type": "subtitle", "time": 16175.349, "timestamp": "04:29:35", "text": "これはずっと良いですね。私はしません"}, {"type": "subtitle", "time": 16178.149, "timestamp": "04:29:38", "text": "今はカメラを使って道案内をしなければならない。"}, {"type": "subtitle", "time": 16180.71, "timestamp": "04:29:40", "text": "ニース。さあ行こう。爆発するだろう"}, {"type": "subtitle", "time": 16182.71, "timestamp": "04:29:42", "text": "まあ、どうでもいいか。ええ、まさにその通りです。"}, {"type": "subtitle", "time": 16184.87, "timestamp": "04:29:44", "text": "どうせ爆発するんでしょ？しかし"}, {"type": "subtitle", "time": 16187.429, "timestamp": "04:29:47", "text": "ほら、ちょっと見てみたいんだけど"}, {"type": "subtitle", "time": 16189.79, "timestamp": "04:29:49", "text": "少し。"}, {"type": "subtitle", "time": 16195.03, "timestamp": "04:29:55", "text": "私は2階のどこかの隅っこにいます。"}, {"type": "subtitle", "time": 16197.11, "timestamp": "04:29:57", "text": "ああ、二階だよ。ああ、忘れてた。通常、"}, {"type": "subtitle", "time": 16199.83, "timestamp": "04:29:59", "text": "幽霊は二階にいるだろう。うん。"}]
[{"type": "subtitle", "time": 4333.11, "timestamp": "01:12:13", "text": "何てことだ。"}, {"type": "subtitle", "time": 4335.189, "timestamp": "01:12:15", "text": "人々が歩き回る様子を見てください"}, {"type": "subtitle", "time": 4337.03, "timestamp": "01:12:17", "text": "それ。うん。うん。うん。うん。うん。"}, {"type": "chat", "time": 4338.342, "timestamp": "01:12:18", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "bishal bhai kya kr rhe"}, {"type": "subtitle", "time": 4339.189, "timestamp": "01:12:19", "text": "特に私がコラボレーションしたいと思っていた人"}, {"type": "subtitle", "time": 4342.39, "timestamp": "01:12:22", "text": "それらはまるでプラチナのようだった。なんてこった。"}, {"type": "chat", "time": 4343.39, "timestamp": "01:12:23", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "hellnah"}, {"type": "subtitle", "time": 4345.27, "timestamp": "01:12:25", "text": "全てがダイヤモンドになるはずだった。"}, {"type": "subtitle", "time": 4346.669, "timestamp": "01:12:26", "text": "彼らはプラチナです"}, {"type": "subtitle", "time": 4350.709, "timestamp": "01:12:30", "text": "1つと頂点"}, {"type": "subtitle", "time": 4361.91, "timestamp": "01:12:41", "text": "敵はあと一体。"}, {"type": "subtitle", "time": 4370.51, "timestamp": "01:12:50", "text": "だって私は低レベルだから"}, {"type": "subtitle", "time": 4374.31, "timestamp": "01:12:54", "text": "そして、ランガンガーではない。アンレンジャー。"}, {"type": "subtitle", "time": 4378.43, "timestamp": "01:12:58", "text": "請求は残っていません。ええと、彼らは"}]
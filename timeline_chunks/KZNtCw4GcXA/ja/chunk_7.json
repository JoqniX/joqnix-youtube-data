[{"type": "subtitle", "time": 426.51, "timestamp": "00:07:06", "text": "内向的"}, {"type": "subtitle", "time": 430.87, "timestamp": "00:07:10", "text": "おそらく。何が起こるかわからない。そうですね、"}, {"type": "subtitle", "time": 433.629, "timestamp": "00:07:13", "text": "おそらくそれが理由だろう。私は感じる"}, {"type": "subtitle", "time": 435.95, "timestamp": "00:07:15", "text": "抱きしめるように"}, {"type": "subtitle", "time": 438.749, "timestamp": "00:07:18", "text": "私は"}, {"type": "subtitle", "time": 440.35, "timestamp": "00:07:20", "text": "内向的。"}, {"type": "subtitle", "time": 443.589, "timestamp": "00:07:23", "text": "内向的な人は自分の殻に閉じこもったり、"}, {"type": "subtitle", "time": 445.589, "timestamp": "00:07:25", "text": "何でも。"}, {"type": "subtitle", "time": 449.189, "timestamp": "00:07:29", "text": "しかし、私はそれを打ち破りたい。そして私たちは"}, {"type": "subtitle", "time": 451.43, "timestamp": "00:07:31", "text": "私たちはそれを少しずつ壊してきました"}, {"type": "subtitle", "time": 452.749, "timestamp": "00:07:32", "text": "ここと"}, {"type": "subtitle", "time": 462.30899999999997, "timestamp": "00:07:42", "text": "それ。うん。もしかしたら私は"}, {"type": "subtitle", "time": 469.31, "timestamp": "00:07:49", "text": "ゆっくりと、しかし確実に殻が開く。"}, {"type": "subtitle", "time": 479.23, "timestamp": "00:07:59", "text": "そのため、バトルレンダリングのようなゲームは"}]
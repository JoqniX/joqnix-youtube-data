[{"type": "subtitle", "time": 10621.429, "timestamp": "02:57:01", "text": "えっと、雪は好きですか？私は雪が大好きです。一度もない"}, {"type": "subtitle", "time": 10625.55, "timestamp": "02:57:05", "text": "触ってみたけど、雪は大好き。"}, {"type": "subtitle", "time": 10628.59, "timestamp": "02:57:08", "text": "停止。私たちは"}, {"type": "subtitle", "time": 10635.389, "timestamp": "02:57:15", "text": "[音楽]"}, {"type": "subtitle", "time": 10642.91, "timestamp": "02:57:22", "text": "推測。ああ、なんてことだ、私は"}, {"type": "subtitle", "time": 10644.83, "timestamp": "02:57:24", "text": "興奮した。"}, {"type": "subtitle", "time": 10648.429, "timestamp": "02:57:28", "text": "すごく興奮してる。私は"}, {"type": "subtitle", "time": 10652.11, "timestamp": "02:57:32", "text": "盛り上がっている。全てがうまくいくことを願っています"}, {"type": "subtitle", "time": 10659.349, "timestamp": "02:57:39", "text": "確認する必要があった。えーと、白か"}, {"type": "subtitle", "time": 10663.07, "timestamp": "02:57:43", "text": "黄色。 「黄色い雪」とはどういう意味ですか？"}, {"type": "subtitle", "time": 10665.75, "timestamp": "02:57:45", "text": "何？そこにあるのは白い雪だけだ。何が"}, {"type": "subtitle", "time": 10677.19, "timestamp": "02:57:57", "text": "こんにちは。こんにちは。こんにちは。こんにちは、"}]
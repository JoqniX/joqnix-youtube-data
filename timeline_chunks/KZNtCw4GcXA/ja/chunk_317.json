[{"type": "subtitle", "time": 19020.19, "timestamp": "05:17:00", "text": "聖なる。私はそれを渡さなければならない"}, {"type": "subtitle", "time": 19022.868, "timestamp": "05:17:02", "text": "月曜日。ああ、月曜日に気づいたんだけど"}, {"type": "subtitle", "time": 19024.628, "timestamp": "05:17:04", "text": "音楽の授業がある。それは見逃せない。"}, {"type": "subtitle", "time": 19027.59, "timestamp": "05:17:07", "text": "屋根。えっと、ちょっと見逃したというか、"}, {"type": "subtitle", "time": 19029.83, "timestamp": "05:17:09", "text": "木曜日と先週の月曜日は休講でした"}, {"type": "subtitle", "time": 19032.23, "timestamp": "05:17:12", "text": "同じように。 2日間授業はなかった。"}, {"type": "subtitle", "time": 19035.03, "timestamp": "05:17:15", "text": "音楽活動も必要だ。私はちょっと"}, {"type": "subtitle", "time": 19037.868, "timestamp": "05:17:17", "text": "行動から身を引く"}, {"type": "subtitle", "time": 19040.55, "timestamp": "05:17:20", "text": "それ。やらなければならないことの量"}, {"type": "subtitle", "time": 19043.23, "timestamp": "05:17:23", "text": "そして私は感じている"}, {"type": "subtitle", "time": 19046.868, "timestamp": "05:17:26", "text": "君たちが"}, {"type": "subtitle", "time": 19049.43, "timestamp": "05:17:29", "text": "私と24時間一緒にいてくれる人？あなたはちょっと"}, {"type": "subtitle", "time": 19053.51, "timestamp": "05:17:33", "text": "ほとんどの場合、VODは除外します"}, {"type": "subtitle", "time": 19057.11, "timestamp": "05:17:37", "text": "ある意味では。それは数時間のようなものだ"}, {"type": "subtitle", "time": 19060.15, "timestamp": "05:17:40", "text": "お好みであれば、すべてのvを削除してください"}, {"type": "subtitle", "time": 19063.03, "timestamp": "05:17:43", "text": "えーっと、休憩を2、3回取った"}, {"type": "subtitle", "time": 19067.15, "timestamp": "05:17:47", "text": "時間。私は自分が知らないような気がする"}, {"type": "subtitle", "time": 19069.47, "timestamp": "05:17:49", "text": "昨日。"}, {"type": "subtitle", "time": 19072.43, "timestamp": "05:17:52", "text": "えっと、たぶん私は"}, {"type": "subtitle", "time": 19076.03, "timestamp": "05:17:56", "text": "3:00 なぜなら私は階下へ降りて"}, {"type": "subtitle", "time": 19079.59, "timestamp": "05:17:59", "text": "私が来た時は、文字通り午前3時に食事をしました"}]
[{"type": "subtitle", "time": 11282.11, "timestamp": "03:08:02", "text": "ええ、彼らはそういう反応をするんです。"}, {"type": "subtitle", "time": 11285.15, "timestamp": "03:08:05", "text": "うん、好きになる必要はないよ"}, {"type": "subtitle", "time": 11289.11, "timestamp": "03:08:09", "text": "あれってなんて言うんだっけ？あーあーあーそう"}, {"type": "subtitle", "time": 11291.99, "timestamp": "03:08:11", "text": "ところで、最初のタスクは何だったんですか？"}, {"type": "subtitle", "time": 11294.55, "timestamp": "03:08:14", "text": "幽霊を目撃して、それから2番目"}, {"type": "subtitle", "time": 11297.07, "timestamp": "03:08:17", "text": "幽霊から逃れる"}, {"type": "subtitle", "time": 11304.55, "timestamp": "03:08:24", "text": "このくだらない機械の電源を入れるのを忘れた。おお、"}, {"type": "subtitle", "time": 11305.99, "timestamp": "03:08:25", "text": "明かりが消えた。見ていただけますか"}, {"type": "subtitle", "time": 11311.19, "timestamp": "03:08:31", "text": "おお、いいね。ニース。なんてこった。なんてこった。"}, {"type": "subtitle", "time": 11313.67, "timestamp": "03:08:33", "text": "ゲーム中に私の声が聞こえますか？"}, {"type": "subtitle", "time": 11315.83, "timestamp": "03:08:35", "text": "いいえ。"}, {"type": "subtitle", "time": 11318.71, "timestamp": "03:08:38", "text": "大丈夫です。大丈夫。君たちは"}, {"type": "subtitle", "time": 11322.71, "timestamp": "03:08:42", "text": "下がる？プッシュトゥトークを直させてください"}, {"type": "subtitle", "time": 11329.67, "timestamp": "03:08:49", "text": "おばけ。わかった。"}, {"type": "subtitle", "time": 11332.55, "timestamp": "03:08:52", "text": "ああ、針は動いているように見えるが、"}, {"type": "subtitle", "time": 11335.19, "timestamp": "03:08:55", "text": "まだ舞台がないわけではない。"}, {"type": "subtitle", "time": 11337.75, "timestamp": "03:08:57", "text": "でも、動いているよ。"}]
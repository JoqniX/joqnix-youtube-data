[{"type": "subtitle", "time": 2529.51, "timestamp": "00:42:09", "text": "キルレートはどれくらいか知っていますか？私"}, {"type": "subtitle", "time": 2532.23, "timestamp": "00:42:12", "text": "彼には限界があったとは思わない。くそ。彼は"}, {"type": "subtitle", "time": 2534.71, "timestamp": "00:42:14", "text": "彼を後押ししてくれる人はいますか？彼には友達がいた"}, {"type": "subtitle", "time": 2535.63, "timestamp": "00:42:15", "text": "遊ぶ"}, {"type": "subtitle", "time": 2537.15, "timestamp": "00:42:17", "text": "と"}, {"type": "subtitle", "time": 2540.51, "timestamp": "00:42:20", "text": "競争力。彼は単独だったのか？"}, {"type": "chat", "time": 2541.638, "timestamp": "00:42:21", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "solo"}, {"type": "subtitle", "time": 2553.47, "timestamp": "00:42:33", "text": "それ。このゲームはチームプレイヤーになることを求めている"}, {"type": "subtitle", "time": 2557.03, "timestamp": "00:42:37", "text": "チームはあなたにグループの一員になってほしいと思っています。それが理由です"}, {"type": "chat", "time": 2557.824, "timestamp": "00:42:37", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "wow, bro's pulling questions to him, tch tch"}, {"type": "subtitle", "time": 2559.23, "timestamp": "00:42:39", "text": "私は次のようなゲームが嫌いです"}, {"type": "subtitle", "time": 2562.63, "timestamp": "00:42:42", "text": "これ。なし。私のソロはどうですか？"}]
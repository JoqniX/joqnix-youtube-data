[{"type": "subtitle", "time": 17700.55, "timestamp": "04:55:00", "text": "できるよ。うん。彼らが許可すれば"}, {"type": "subtitle", "time": 17717.19, "timestamp": "04:55:17", "text": "上司に聞いてみて。ボスに頼んで"}, {"type": "subtitle", "time": 17721.19, "timestamp": "04:55:21", "text": "もっとコラボできないかな？"}, {"type": "subtitle", "time": 17722.67, "timestamp": "04:55:22", "text": "と"}, {"type": "subtitle", "time": 17724.35, "timestamp": "04:55:24", "text": "それ？"}, {"type": "subtitle", "time": 17729.43, "timestamp": "04:55:29", "text": "えっと、私、生放送中ですか？ああ、まだ低い。"}, {"type": "subtitle", "time": 17731.53, "timestamp": "04:55:31", "text": "何てことだ。インターネット"}, {"type": "subtitle", "time": 17745.788, "timestamp": "04:55:45", "text": "トウモロコシ"}, {"type": "subtitle", "time": 17748.51, "timestamp": "04:55:48", "text": "6,000"}, {"type": "subtitle", "time": 17755.55, "timestamp": "04:55:55", "text": "今日は悪い日だ"}]
[{"type": "subtitle", "time": 16201.349, "timestamp": "04:30:01", "text": "ジャック、来てくれる？"}, {"type": "subtitle", "time": 16205.03, "timestamp": "04:30:05", "text": "2階？なぜ私に来てほしいのですか？私 私"}, {"type": "subtitle", "time": 16207.59, "timestamp": "04:30:07", "text": "あなたに来てほしいのは、"}, {"type": "subtitle", "time": 16210.55, "timestamp": "04:30:10", "text": "懐中電灯。ええ、まさにその通りです。その通り。あなた"}, {"type": "subtitle", "time": 16212.469, "timestamp": "04:30:12", "text": "懐中電灯を持ってください。ほら、君は"}, {"type": "subtitle", "time": 16214.07, "timestamp": "04:30:14", "text": "懐中電灯。どういう意味ですか？なぜ私は"}, {"type": "subtitle", "time": 16215.59, "timestamp": "04:30:15", "text": "しなければならない？ここに隠れることができます"}, {"type": "subtitle", "time": 16219.03, "timestamp": "04:30:19", "text": "欲しい。幽霊の先輩と話すことができます。"}, {"type": "subtitle", "time": 16221.91, "timestamp": "04:30:21", "text": "そのプッシュトゥトーク機能を使ってください。ええ、そういうことです"}, {"type": "subtitle", "time": 16224.269, "timestamp": "04:30:24", "text": "彼らは反応する。"}, {"type": "subtitle", "time": 16226.95, "timestamp": "04:30:26", "text": "うん、好きになる必要はないよ"}, {"type": "subtitle", "time": 16231.269, "timestamp": "04:30:31", "text": "あれってなんて言うんだっけ？あーあーあーそう"}, {"type": "subtitle", "time": 16234.149, "timestamp": "04:30:34", "text": "ところで、最初のタスクは何だったんですか？"}, {"type": "subtitle", "time": 16236.71, "timestamp": "04:30:36", "text": "幽霊を目撃して、それから2番目は"}, {"type": "subtitle", "time": 16239.229, "timestamp": "04:30:39", "text": "幽霊から逃れる"}, {"type": "subtitle", "time": 16246.55, "timestamp": "04:30:46", "text": "このくだらない機械の電源を入れるのを忘れてしまった。"}, {"type": "subtitle", "time": 16247.91, "timestamp": "04:30:47", "text": "ああ、電気が消えた。見ていただけますか？"}, {"type": "subtitle", "time": 16253.349, "timestamp": "04:30:53", "text": "ああ、いいですね。ニース。なんてこった。なんてこった。もし"}, {"type": "subtitle", "time": 16255.83, "timestamp": "04:30:55", "text": "ゲーム内で私の声が聞こえるか、"}, {"type": "subtitle", "time": 16257.99, "timestamp": "04:30:57", "text": "いいえ。"}, {"type": "subtitle", "time": 16258.75, "timestamp": "04:30:58", "text": "その"}]
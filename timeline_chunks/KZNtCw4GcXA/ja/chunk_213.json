[{"type": "subtitle", "time": 12782.19, "timestamp": "03:33:02", "text": "それで？"}, {"type": "subtitle", "time": 12787.269, "timestamp": "03:33:07", "text": "えっと、私、生放送中ですか？ああ、まだ低い。"}, {"type": "subtitle", "time": 12789.36, "timestamp": "03:33:09", "text": "何てことだ。"}, {"type": "subtitle", "time": 12799.71, "timestamp": "03:33:19", "text": "[音楽]"}, {"type": "subtitle", "time": 12803.55, "timestamp": "03:33:23", "text": "インターネットは"}, {"type": "subtitle", "time": 12813.389, "timestamp": "03:33:33", "text": "ああ、今日は悪い日だ"}, {"type": "subtitle", "time": 12817.55, "timestamp": "03:33:37", "text": "日。ええ、でもね、知ってる？それは"}, {"type": "subtitle", "time": 12835.03, "timestamp": "03:33:55", "text": "よぉ、今なら俺が上流にいるのが見えるだろ"}, {"type": "subtitle", "time": 12837.75, "timestamp": "03:33:57", "text": "今。ビットレートは良好です。これは"}]
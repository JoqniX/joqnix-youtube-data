[{"type": "subtitle", "time": 13981.83, "timestamp": "03:53:01", "text": "SL。それから戻ってきて、私は"}, {"type": "subtitle", "time": 13985.59, "timestamp": "03:53:05", "text": "ストリーミングしたいけど、したくない"}, {"type": "subtitle", "time": 13997.55, "timestamp": "03:53:17", "text": "新しい変更は"}, {"type": "subtitle", "time": 14000.11, "timestamp": "03:53:20", "text": "ゆっくりとやってくる"}, {"type": "subtitle", "time": 14002.63, "timestamp": "03:53:22", "text": "ゆっくり。それほど大きな変化はない。"}, {"type": "subtitle", "time": 14005.189, "timestamp": "03:53:25", "text": "それは、ゆっくりとゆっくりと進んでいくようなものだ。"}, {"type": "subtitle", "time": 14007.99, "timestamp": "03:53:27", "text": "コラボレーションがたくさんあるでしょう。 11月、"}, {"type": "subtitle", "time": 14010.07, "timestamp": "03:53:30", "text": "11月、私は"}, {"type": "subtitle", "time": 14013.269, "timestamp": "03:53:33", "text": "実際にストリーミング配信はあまりしないが、"}, {"type": "subtitle", "time": 14015.99, "timestamp": "03:53:35", "text": "試験とか色々起こるだろうね。それで、"}, {"type": "subtitle", "time": 14017.87, "timestamp": "03:53:37", "text": "最善を尽くします"}, {"type": "subtitle", "time": 14021.389, "timestamp": "03:53:41", "text": "ストリーミングとその他すべてを管理する"}, {"type": "subtitle", "time": 14024.15, "timestamp": "03:53:44", "text": "どうなるか見てみよう。わかった。だから私は"}, {"type": "subtitle", "time": 14026.79, "timestamp": "03:53:46", "text": "こちらで包装します。私はただ"}, {"type": "subtitle", "time": 14029.349, "timestamp": "03:53:49", "text": "皆さん、ありがとうと言いたかったんです"}, {"type": "subtitle", "time": 14032.389, "timestamp": "03:53:52", "text": "お越しいただきありがとうございます。たとえ私が技術的に"}, {"type": "subtitle", "time": 14035.389, "timestamp": "03:53:55", "text": "困難があっても、大丈夫です。大切なことは"}, {"type": "subtitle", "time": 14038.87, "timestamp": "03:53:58", "text": "あなたたちは他の2人を支持しましたか？"}]
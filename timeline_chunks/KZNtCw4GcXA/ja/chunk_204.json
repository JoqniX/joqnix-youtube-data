[{"type": "subtitle", "time": 12240.87, "timestamp": "03:24:00", "text": "外。それで十分だと思います"}, {"type": "subtitle", "time": 12246.15, "timestamp": "03:24:06", "text": "実は。ああ、なるほど。"}, {"type": "subtitle", "time": 12249.19, "timestamp": "03:24:09", "text": "あ、懐中電灯持ってるよ。待って、私に"}, {"type": "subtitle", "time": 12251.75, "timestamp": "03:24:11", "text": "1分。私はそれを削除すると思った"}, {"type": "subtitle", "time": 12255.11, "timestamp": "03:24:15", "text": "死にたいときは懐中電灯を使え。"}, {"type": "subtitle", "time": 12258.07, "timestamp": "03:24:18", "text": "どうでも。懐中電灯を持っています。私は私は"}, {"type": "subtitle", "time": 12259.87, "timestamp": "03:24:19", "text": "追加しないで"}, {"type": "subtitle", "time": 12263.99, "timestamp": "03:24:23", "text": "どうやら私は"}, {"type": "subtitle", "time": 12266.07, "timestamp": "03:24:26", "text": "懐中電灯。それは実際かなりクールですね"}, {"type": "subtitle", "time": 12268.67, "timestamp": "03:24:28", "text": "準備ができたら。私は"}, {"type": "subtitle", "time": 12271.19, "timestamp": "03:24:31", "text": "準備ができて。ああ、わかった。"}, {"type": "subtitle", "time": 12274.55, "timestamp": "03:24:34", "text": "知りませんでした。私は、えっと、私は"}, {"type": "subtitle", "time": 12276.349, "timestamp": "03:24:36", "text": "負けるだろう"}, {"type": "subtitle", "time": 12279.269, "timestamp": "03:24:39", "text": "すべて。懐中電灯は"}, {"type": "subtitle", "time": 12281.309, "timestamp": "03:24:41", "text": "例外か何か。私はしません"}, {"type": "subtitle", "time": 12287.229, "timestamp": "03:24:47", "text": "ひどい。この地図は"}, {"type": "subtitle", "time": 12296.87, "timestamp": "03:24:56", "text": "わかった。遅れている。ああ、実は私は"}, {"type": "subtitle", "time": 12298.79, "timestamp": "03:24:58", "text": "この地図。それは、それは、それは、"}]
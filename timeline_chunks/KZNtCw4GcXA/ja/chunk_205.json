[{"type": "subtitle", "time": 12301.75, "timestamp": "03:25:01", "text": "かわいい。とても寒いです。ああ、いや、"}, {"type": "subtitle", "time": 12305.469, "timestamp": "03:25:05", "text": "キャンプ。ああ、これは嫌だ。"}, {"type": "subtitle", "time": 12308.15, "timestamp": "03:25:08", "text": "ザック、あのプールを見て。見てください"}, {"type": "subtitle", "time": 12309.91, "timestamp": "03:25:09", "text": "プール。"}, {"type": "subtitle", "time": 12313.75, "timestamp": "03:25:13", "text": "つまり、あなたたちはプロですよね。私はそうではありません。"}, {"type": "subtitle", "time": 12315.59, "timestamp": "03:25:15", "text": "わかった、ドスで行くよ。私は"}, {"type": "subtitle", "time": 12318.15, "timestamp": "03:25:18", "text": "ドスと一緒に行くよ。"}, {"type": "subtitle", "time": 12319.75, "timestamp": "03:25:19", "text": "私はこのゲームの遊び方が全く分かりません"}, {"type": "subtitle", "time": 12322.309, "timestamp": "03:25:22", "text": "ゲームも好きだけど、雰囲気を楽しむためにここに来たんだ。私はできる"}, {"type": "subtitle", "time": 12325.03, "timestamp": "03:25:25", "text": "スピリットボックスはありますよね？私"}, {"type": "subtitle", "time": 12327.99, "timestamp": "03:25:27", "text": "スピリットボックスを使うこともできる。うん、行くよ"}, {"type": "subtitle", "time": 12331.51, "timestamp": "03:25:31", "text": "ダス。私は嬉しい。私は紫色の輝きを選びます"}, {"type": "subtitle", "time": 12333.75, "timestamp": "03:25:33", "text": "スティック。"}, {"type": "subtitle", "time": 12336.83, "timestamp": "03:25:36", "text": "クロノスがここにいる。こんにちは。静かに。"}, {"type": "subtitle", "time": 12340.389, "timestamp": "03:25:40", "text": "クロノス。静かに。クロノス。"}, {"type": "subtitle", "time": 12345.51, "timestamp": "03:25:45", "text": "わかった。だから、オープンに。こんにちは。これがあります"}, {"type": "subtitle", "time": 12348.79, "timestamp": "03:25:48", "text": "キースという名前です。キース・ミラー。うん。"}, {"type": "subtitle", "time": 12352.15, "timestamp": "03:25:52", "text": "この公園は実際、とても良いですね。"}, {"type": "subtitle", "time": 12354.83, "timestamp": "03:25:54", "text": "バスケットボール。待って。入手できません"}, {"type": "subtitle", "time": 12358.15, "timestamp": "03:25:58", "text": "上。ともかく、"}, {"type": "subtitle", "time": 12359.19, "timestamp": "03:25:59", "text": "おいおい、あれを見てみろよ。そこには"}]
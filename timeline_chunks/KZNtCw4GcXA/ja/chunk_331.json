[{"type": "subtitle", "time": 19860.47, "timestamp": "05:31:00", "text": "私？いいえ、私は自分のすべてを売るつもりはありません"}, {"type": "subtitle", "time": 19864.27, "timestamp": "05:31:04", "text": "声全体"}, {"type": "subtitle", "time": 19878.99, "timestamp": "05:31:18", "text": "私はただ願うだけです"}, {"type": "subtitle", "time": 19882.27, "timestamp": "05:31:22", "text": "私はただ"}, {"type": "subtitle", "time": 19885.67, "timestamp": "05:31:25", "text": "心配事が何であれ、ただ願うだけです"}, {"type": "subtitle", "time": 19888.31, "timestamp": "05:31:28", "text": "今は"}, {"type": "subtitle", "time": 19894.548, "timestamp": "05:31:34", "text": "えーと、すぐに通り抜けられるか、"}, {"type": "subtitle", "time": 19897.27, "timestamp": "05:31:37", "text": "頭の中はただのナンセンスか、ただの雑音だ"}, {"type": "subtitle", "time": 19899.75, "timestamp": "05:31:39", "text": "私の脳内で。"}, {"type": "subtitle", "time": 19905.23, "timestamp": "05:31:45", "text": "[音楽]"}, {"type": "subtitle", "time": 19907.31, "timestamp": "05:31:47", "text": "終わり。それで、"}, {"type": "subtitle", "time": 19910.548, "timestamp": "05:31:50", "text": "まあ、クリップは34個しかないんだけどね。"}, {"type": "subtitle", "time": 19915.35, "timestamp": "05:31:55", "text": "YouTube からの残りと 12 クリップ"}, {"type": "subtitle", "time": 19916.99, "timestamp": "05:31:56", "text": "トゥイッチ。それは"}, {"type": "subtitle", "time": 19919.83, "timestamp": "05:31:59", "text": "それ。そしてその後は、何が起こるかわからない"}]
[{"type": "subtitle", "time": 16563.83, "timestamp": "04:36:03", "text": "おお、いいね。わかった。トランシーバーの紫外線ライト。"}, {"type": "subtitle", "time": 16572.31, "timestamp": "04:36:12", "text": "ええと、EMマップを撮ることができます。"}, {"type": "subtitle", "time": 16579.629, "timestamp": "04:36:19", "text": "ゲーマー用のカメラを持っていくかもしれません"}, {"type": "subtitle", "time": 16584.15, "timestamp": "04:36:24", "text": "統計。私は紫外線ライトを持っています。さあ行こう。"}, {"type": "subtitle", "time": 16586.24, "timestamp": "04:36:26", "text": "さあ行こう。 わかった。ゴーストさん、何かしましたか？"}, {"type": "subtitle", "time": 16590.0, "timestamp": "04:36:30", "text": "わかった。ゴーストさん、何かしましたか？ いたずらっ子？はいの場合、紫外線で示してください"}, {"type": "subtitle", "time": 16593.279, "timestamp": "04:36:33", "text": "いたずらっ子？はいの場合、紫外線で示してください ライト。うん。ああ、そうするべきだ、そうするべきだ"}, {"type": "subtitle", "time": 16595.68, "timestamp": "04:36:35", "text": "ライト。うん。ああ、そうするべきだ、そうするべきだ ゲーム内で会話して、ああ、私たちは"}, {"type": "subtitle", "time": 16597.279, "timestamp": "04:36:37", "text": "ゲーム内で会話して、ああ、私たちは 幽霊の話はもう一度読まなかった。"}, {"type": "subtitle", "time": 16599.68, "timestamp": "04:36:39", "text": "幽霊の話はもう一度読まなかった。 なんてこった"}, {"type": "subtitle", "time": 16601.32, "timestamp": "04:36:41", "text": "なんてこった 方法。放してくれ。えーと、幽霊の名前は"}, {"type": "subtitle", "time": 16605.84, "timestamp": "04:36:45", "text": "方法。放してくれ。えーと、幽霊の名前は わかった。何が"}, {"type": "subtitle", "time": 16608.799, "timestamp": "04:36:48", "text": "わかった。何が こんにちは。あなたはここにいますか？どこにいるの？"}, {"type": "subtitle", "time": 16613.6, "timestamp": "04:36:53", "text": "こんにちは。あなたはここにいますか？どこにいるの？ 何歳ですか？"}, {"type": "subtitle", "time": 16619.91, "timestamp": "04:36:59", "text": "こんにちは。"}]
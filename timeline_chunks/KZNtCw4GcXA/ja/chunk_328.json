[{"type": "subtitle", "time": 19682.47, "timestamp": "05:28:02", "text": "金切り声を上げる猫か何か。私は"}, {"type": "subtitle", "time": 19684.788, "timestamp": "05:28:04", "text": "何度か気づいたのですが"}, {"type": "subtitle", "time": 19687.548, "timestamp": "05:28:07", "text": "君たちが切り取ったクリップの中で"}, {"type": "subtitle", "time": 19689.708, "timestamp": "05:28:09", "text": "から。"}, {"type": "subtitle", "time": 19693.43, "timestamp": "05:28:13", "text": "ええと、だから時々失敗するんです"}, {"type": "subtitle", "time": 19695.31, "timestamp": "05:28:15", "text": "魅了する"}, {"type": "subtitle", "time": 19696.83, "timestamp": "05:28:16", "text": "捕獲"}, {"type": "subtitle", "time": 19698.75, "timestamp": "05:28:18", "text": "の"}, {"type": "subtitle", "time": 19703.07, "timestamp": "05:28:23", "text": "喜びにあふれたスポーツマンか、悲鳴をあげて怯える"}, {"type": "subtitle", "time": 19706.27, "timestamp": "05:28:26", "text": "ジョーク。名前を表示してください。"}, {"type": "subtitle", "time": 19708.91, "timestamp": "05:28:28", "text": "うん。まあ、そうかもしれないね"}, {"type": "subtitle", "time": 19713.31, "timestamp": "05:28:33", "text": "より良い。うん。正直に、"}, {"type": "subtitle", "time": 19719.47, "timestamp": "05:28:39", "text": "もっと。しかし"}, {"type": "chat", "time": 19720.707, "timestamp": "05:28:40", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "sup mr nix"}, {"type": "subtitle", "time": 19722.948, "timestamp": "05:28:42", "text": "うん、今後はどうすればいいのかわからない"}, {"type": "subtitle", "time": 19724.11, "timestamp": "05:28:44", "text": "物事は"}, {"type": "subtitle", "time": 19727.99, "timestamp": "05:28:47", "text": "なれ。おそらく、もっと簡略化する必要があるでしょう"}, {"type": "subtitle", "time": 19730.59, "timestamp": "05:28:50", "text": "私がこれまでしてきたことのほとんどは"}, {"type": "subtitle", "time": 19733.27, "timestamp": "05:28:53", "text": "私の設定でやっていること。新しいものを手に入れたら"}, {"type": "chat", "time": 19734.059, "timestamp": "05:28:54", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "wut happen?"}, {"type": "subtitle", "time": 19737.03, "timestamp": "05:28:57", "text": "ノートパソコン、もしくは日本に行ったら"}, {"type": "subtitle", "time": 19739.31, "timestamp": "05:28:59", "text": "すべて"}]
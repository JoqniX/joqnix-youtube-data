[{"type": "subtitle", "time": 13860.229, "timestamp": "03:51:00", "text": "10月26日まで。次はそれだ"}, {"type": "subtitle", "time": 13861.75, "timestamp": "03:51:01", "text": "木曜日。"}, {"type": "subtitle", "time": 13865.03, "timestamp": "03:51:05", "text": "えっと、みんなを待ってるよ"}, {"type": "subtitle", "time": 13868.469, "timestamp": "03:51:08", "text": "提出とか色々。それから17日には"}, {"type": "subtitle", "time": 13871.269, "timestamp": "03:51:11", "text": "16日にそれを閉じた後、私は"}, {"type": "subtitle", "time": 13873.59, "timestamp": "03:51:13", "text": "16日目の夜ですね。12時まで待たなければなりません。"}, {"type": "subtitle", "time": 13878.389, "timestamp": "03:51:18", "text": "うん、17日目の夜に閉店するよ。えっと、17日"}, {"type": "subtitle", "time": 13882.79, "timestamp": "03:51:22", "text": "午前0時に閉めて、文字通り"}, {"type": "subtitle", "time": 13885.389, "timestamp": "03:51:25", "text": "えーと、最終決定する"}, {"type": "subtitle", "time": 13887.95, "timestamp": "03:51:27", "text": "結果。それで"}, {"type": "subtitle", "time": 13896.75, "timestamp": "03:51:36", "text": "それで、私はこう言おうとしていました。"}, {"type": "subtitle", "time": 13903.03, "timestamp": "03:51:43", "text": "文字通り"}, {"type": "subtitle", "time": 13905.11, "timestamp": "03:51:45", "text": "先延ばしをやめて、文字通り歩きましょう"}, {"type": "subtitle", "time": 13908.15, "timestamp": "03:51:48", "text": "ウェブサイトに掲載されています。だから、私は文字通り"}, {"type": "subtitle", "time": 13911.349, "timestamp": "03:51:51", "text": "フレームを見る"}, {"type": "subtitle", "time": 13915.269, "timestamp": "03:51:55", "text": "ウェブサイトと、AIが搭載されているから"}, {"type": "subtitle", "time": 13918.15, "timestamp": "03:51:58", "text": "あれこれと、AIでテンプレートを作った"}]
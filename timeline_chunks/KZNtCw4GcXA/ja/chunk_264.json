[{"type": "subtitle", "time": 15843.75, "timestamp": "04:24:03", "text": "わかった。こんにちは。最善を尽くします。はい。"}, {"type": "subtitle", "time": 15847.91, "timestamp": "04:24:07", "text": "全員準備完了です。はい。それでは始めましょう。おお。"}, {"type": "subtitle", "time": 15851.11, "timestamp": "04:24:11", "text": "何てことだ。法廷を見る。この地図は何ですか？"}, {"type": "subtitle", "time": 15853.429, "timestamp": "04:24:13", "text": "また？大柄な男性ですか？ああ、小さい"}, {"type": "subtitle", "time": 15854.67, "timestamp": "04:24:14", "text": "1つ。わかった、"}, {"type": "subtitle", "time": 15857.429, "timestamp": "04:24:17", "text": "ニース。小さい。"}, {"type": "subtitle", "time": 15860.07, "timestamp": "04:24:20", "text": "小さいように見える。私は何も知りません。"}, {"type": "subtitle", "time": 15861.91, "timestamp": "04:24:21", "text": "ヘルプ。"}, {"type": "subtitle", "time": 15863.229, "timestamp": "04:24:23", "text": "その"}, {"type": "subtitle", "time": 15867.149, "timestamp": "04:24:27", "text": "大丈夫。あなたは素晴らしいです。それは"}, {"type": "subtitle", "time": 15870.429, "timestamp": "04:24:30", "text": "おお。ああ、幽霊は"}, {"type": "subtitle", "time": 15873.59, "timestamp": "04:24:33", "text": "狂った。ナイトメアモードが大好きです"}, {"type": "subtitle", "time": 15877.11, "timestamp": "04:24:37", "text": "これ。待って、なぜmoniは両方とも"}, {"type": "subtitle", "time": 15880.03, "timestamp": "04:24:40", "text": "モニターはライブですか？ようこそ"}, {"type": "subtitle", "time": 15883.429, "timestamp": "04:24:43", "text": "悪夢。いや、ない、ない"}, {"type": "subtitle", "time": 15887.51, "timestamp": "04:24:47", "text": "ポイント。ニース。はい。"}, {"type": "subtitle", "time": 15890.389, "timestamp": "04:24:50", "text": "「これはトランシーバーですか？」への回答いいえ、"}, {"type": "subtitle", "time": 15892.87, "timestamp": "04:24:52", "text": "いや、いや。これはEMF測定器です。おお、いいね。"}, {"type": "subtitle", "time": 15897.99, "timestamp": "04:24:57", "text": "おお、EMFが好きです。わあ、すごい。まるで"}]
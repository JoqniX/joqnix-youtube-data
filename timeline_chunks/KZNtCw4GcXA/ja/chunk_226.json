[{"type": "subtitle", "time": 13563.59, "timestamp": "03:46:03", "text": "痛みはあるけれど、特にマスに来ます"}, {"type": "subtitle", "time": 13566.15, "timestamp": "03:46:06", "text": "パラソーシャルゲームのために。ああ、聞いたよ"}, {"type": "subtitle", "time": 13591.11, "timestamp": "03:46:31", "text": "えっと、ブラッド。本日はありがとうございました。本当に"}, {"type": "subtitle", "time": 13593.83, "timestamp": "03:46:33", "text": "本当に大きな意味があります。"}, {"type": "subtitle", "time": 13596.15, "timestamp": "03:46:36", "text": "お越しいただきありがとうございます。ありがとうございます"}, {"type": "subtitle", "time": 13598.55, "timestamp": "03:46:38", "text": "忍耐強くあること。描いてくれてありがとう"}, {"type": "subtitle", "time": 13601.349, "timestamp": "03:46:41", "text": "すべてをサムネイル表示します。ありがとうございます"}, {"type": "subtitle", "time": 13602.71, "timestamp": "03:46:42", "text": "通りかかるよ。今日は楽しんでいただけたでしょうか。"}, {"type": "subtitle", "time": 13605.63, "timestamp": "03:46:45", "text": "本当に申し訳ないです"}, {"type": "subtitle", "time": 13608.269, "timestamp": "03:46:48", "text": "今日。ワイルド・サンがやって来た"}, {"type": "subtitle", "time": 13611.83, "timestamp": "03:46:51", "text": "今日はあなたがいなくて寂しかったです。ご来場ありがとうございました"}, {"type": "subtitle", "time": 13615.51, "timestamp": "03:46:55", "text": "による。ハッシュさん、来てくれてありがとう。"}, {"type": "subtitle", "time": 13617.269, "timestamp": "03:46:57", "text": "sh の処理と"}]
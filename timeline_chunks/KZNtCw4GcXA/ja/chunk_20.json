[{"type": "subtitle", "time": 1200.789, "timestamp": "00:20:00", "text": "はい、彼らは完全なカテゴリーを持っています"}, {"type": "subtitle", "time": 1206.95, "timestamp": "00:20:06", "text": "はい、私は正しい場所にいると思います"}, {"type": "subtitle", "time": 1211.87, "timestamp": "00:20:11", "text": "基準。ただ私は"}, {"type": "subtitle", "time": 1216.789, "timestamp": "00:20:16", "text": "大丈夫だと思います。ビリー・ビリー"}, {"type": "subtitle", "time": 1220.029, "timestamp": "00:20:20", "text": "勝利した。ビリーが元気だといいな"}, {"type": "subtitle", "time": 1223.549, "timestamp": "00:20:23", "text": "良い"}, {"type": "subtitle", "time": 1227.909, "timestamp": "00:20:27", "text": "えっと、なんて呼ぶんだっけ？"}, {"type": "subtitle", "time": 1231.35, "timestamp": "00:20:31", "text": "おそらく、あなたが大丈夫だといいのですが"}, {"type": "subtitle", "time": 1233.87, "timestamp": "00:20:33", "text": "英語外国語"}, {"type": "subtitle", "time": 1236.39, "timestamp": "00:20:36", "text": "バレラント、中国のバレラントではありません"}, {"type": "subtitle", "time": 1237.99, "timestamp": "00:20:37", "text": "中国のバレラントは持っていません。"}, {"type": "subtitle", "time": 1241.11, "timestamp": "00:20:41", "text": "中国の勇敢な者をプレイするが、マッチする"}, {"type": "subtitle", "time": 1252.59, "timestamp": "00:20:52", "text": "最悪だ"}]
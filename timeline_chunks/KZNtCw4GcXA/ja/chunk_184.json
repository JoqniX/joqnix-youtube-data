[{"type": "subtitle", "time": 11043.59, "timestamp": "03:04:03", "text": "いつもそう思う。休息は必要です。ジョック。"}, {"type": "subtitle", "time": 11047.349, "timestamp": "03:04:07", "text": "私は懐中電灯を持っています。はい。私"}, {"type": "subtitle", "time": 11049.11, "timestamp": "03:04:09", "text": "気に入っていただけたら本当に嬉しいです"}, {"type": "subtitle", "time": 11051.309, "timestamp": "03:04:11", "text": "来るよ。"}, {"type": "subtitle", "time": 11054.95, "timestamp": "03:04:14", "text": "なぜ？えっと、なぜ私はなぜ私は"}, {"type": "subtitle", "time": 11057.19, "timestamp": "03:04:17", "text": "懐中電灯？個人的な恨みなど何もない。私"}, {"type": "subtitle", "time": 11058.95, "timestamp": "03:04:18", "text": "あなたは、"}, {"type": "subtitle", "time": 11061.75, "timestamp": "03:04:21", "text": "懐中電灯。はい。わかった。私は"}, {"type": "subtitle", "time": 11064.79, "timestamp": "03:04:24", "text": "スイッチみたいなものを探して。ああ、私たちは"}, {"type": "subtitle", "time": 11066.71, "timestamp": "03:04:26", "text": "すでに5つくらい、10個くらい持っています"}, {"type": "subtitle", "time": 11070.07, "timestamp": "03:04:30", "text": "10°。うん。ああ、スイッチは"}, {"type": "subtitle", "time": 11071.83, "timestamp": "03:04:31", "text": "仕事。停電しています"}, {"type": "subtitle", "time": 11075.429, "timestamp": "03:04:35", "text": "すでに。そうそう。それは悪夢だ。なぜ"}, {"type": "subtitle", "time": 11079.83, "timestamp": "03:04:39", "text": "このドアは半開きですか？"}, {"type": "subtitle", "time": 11082.87, "timestamp": "03:04:42", "text": "ヘルプ。なんてこった。あなたはどこにいますか、ミスター。"}, {"type": "subtitle", "time": 11084.67, "timestamp": "03:04:44", "text": "ジャック？"}, {"type": "subtitle", "time": 11086.95, "timestamp": "03:04:46", "text": "えっと、皆さんは"}, {"type": "subtitle", "time": 11089.269, "timestamp": "03:04:49", "text": "幽霊？あの幽霊って一体何なの？"}, {"type": "subtitle", "time": 11094.79, "timestamp": "03:04:54", "text": "について？いいえ、していません。はい、できません。"}, {"type": "subtitle", "time": 11097.03, "timestamp": "03:04:57", "text": "待って、なんでこれ半分開いてるの？"}]
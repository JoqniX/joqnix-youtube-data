[{"type": "subtitle", "time": 13201.99, "timestamp": "03:40:01", "text": "たくさん泣いた後、私は"}, {"type": "subtitle", "time": 13204.87, "timestamp": "03:40:04", "text": "疲れすぎて転びそうになった"}, {"type": "subtitle", "time": 13207.51, "timestamp": "03:40:07", "text": "寝ているか何か。私は私が"}, {"type": "subtitle", "time": 13210.07, "timestamp": "03:40:10", "text": "2番目の夢では"}, {"type": "subtitle", "time": 13212.95, "timestamp": "03:40:12", "text": "最初のものは、二人とも"}, {"type": "subtitle", "time": 13215.91, "timestamp": "03:40:15", "text": "死んで侵略され、死んで私を導いた"}, {"type": "subtitle", "time": 13219.11, "timestamp": "03:40:19", "text": "苦しむ、ああ、最後にさせてくれ"}, {"type": "subtitle", "time": 13220.349, "timestamp": "03:40:20", "text": "立って"}, {"type": "subtitle", "time": 13223.95, "timestamp": "03:40:23", "text": "幽霊を生き延びるように"}, {"type": "subtitle", "time": 13226.269, "timestamp": "03:40:26", "text": "私はちょっと"}, {"type": "subtitle", "time": 13228.95, "timestamp": "03:40:28", "text": "白昼夢か何かみたいに不気味"}, {"type": "subtitle", "time": 13230.71, "timestamp": "03:40:30", "text": "それは明晰夢と呼ばれるものです。私は知りません。"}, {"type": "subtitle", "time": 13232.15, "timestamp": "03:40:32", "text": "まるで幽霊みたいな"}, {"type": "subtitle", "time": 13234.95, "timestamp": "03:40:34", "text": "彼の手が私の顔に這い上がってくるのがわかる"}, {"type": "subtitle", "time": 13236.229, "timestamp": "03:40:36", "text": "文字通り"}, {"type": "subtitle", "time": 13240.309, "timestamp": "03:40:40", "text": "えっと、ブラックが私を意識不明にさせたか何か。えっと"}, {"type": "subtitle", "time": 13242.389, "timestamp": "03:40:42", "text": "私とかそういうの。ああ、それは"}, {"type": "subtitle", "time": 13245.469, "timestamp": "03:40:45", "text": "怖かったし、ちょっと叫んじゃったと思う"}, {"type": "subtitle", "time": 13248.95, "timestamp": "03:40:48", "text": "少し。そして目が覚めた。その時目が覚めた"}, {"type": "subtitle", "time": 13250.95, "timestamp": "03:40:50", "text": "実際、上向きです。その時目が覚めた"}, {"type": "subtitle", "time": 13252.95, "timestamp": "03:40:52", "text": "そして私は「えー、ちょっと待って、えー、何？」って感じだった。"}, {"type": "subtitle", "time": 13255.59, "timestamp": "03:40:55", "text": "コラボレーションはどうなったの？私の最初の"}, {"type": "subtitle", "time": 13257.51, "timestamp": "03:40:57", "text": "私が疑問に思っていたこと、待って、何"}, {"type": "subtitle", "time": 13259.63, "timestamp": "03:40:59", "text": "コラボレーションは実現しましたか？私は聴いていた"}]
[{"type": "subtitle", "time": 20404.948, "timestamp": "05:40:04", "text": "ペース。でも、そうすべきなんだ"}, {"type": "subtitle", "time": 20408.31, "timestamp": "05:40:08", "text": "それもそうです。自分のペースでやる。たとえ"}, {"type": "subtitle", "time": 20411.788, "timestamp": "05:40:11", "text": "たとえ私がやりすぎたとしても"}, {"type": "subtitle", "time": 20413.548, "timestamp": "05:40:13", "text": "怠け者"}, {"type": "subtitle", "time": 20421.59, "timestamp": "05:40:21", "text": "それ。私は時間をかけてそれに向き合い、"}, {"type": "subtitle", "time": 20435.628, "timestamp": "05:40:35", "text": "それで、私がノックアウトを終えた"}, {"type": "subtitle", "time": 20440.11, "timestamp": "05:40:40", "text": "薬、薬のような"}, {"type": "subtitle", "time": 20444.548, "timestamp": "05:40:44", "text": "えっと、会ってないやつ"}, {"type": "subtitle", "time": 20447.51, "timestamp": "05:40:47", "text": "金属、プラスチック。プラスチックではない。何何"}, {"type": "subtitle", "time": 20457.11, "timestamp": "05:40:57", "text": "プラスチック。いいえ、プラスチックではありません。の"}, {"type": "subtitle", "time": 20458.35, "timestamp": "05:40:58", "text": "金属。いいえ。"}]
[{"type": "subtitle", "time": 13921.51, "timestamp": "03:52:01", "text": "あれこれあって、私はちょっと何かをしたんです。その"}, {"type": "subtitle", "time": 13923.83, "timestamp": "03:52:03", "text": "ちょっと使いづらいけど、まあ"}, {"type": "subtitle", "time": 13926.389, "timestamp": "03:52:06", "text": "まあまあかな。わからない。種の"}, {"type": "subtitle", "time": 13929.11, "timestamp": "03:52:09", "text": "悪くない。その物、その物は"}, {"type": "subtitle", "time": 13931.389, "timestamp": "03:52:11", "text": "挑戦的とはまさにそういうことだ"}, {"type": "subtitle", "time": 13934.71, "timestamp": "03:52:14", "text": "えー、私が思ったのは"}, {"type": "subtitle", "time": 13937.349, "timestamp": "03:52:17", "text": "私の"}, {"type": "subtitle", "time": 13939.189, "timestamp": "03:52:19", "text": "えーっと、Twitchの配信で、私は文字通り"}, {"type": "subtitle", "time": 13941.15, "timestamp": "03:52:21", "text": "ホワイトボードで4人か3人くらい"}, {"type": "subtitle", "time": 13943.75, "timestamp": "03:52:23", "text": "全体の計画を立てるような流れ"}, {"type": "subtitle", "time": 13948.349, "timestamp": "03:52:28", "text": "ウェブサイト全体の構想。"}, {"type": "subtitle", "time": 13950.99, "timestamp": "03:52:30", "text": "ええと、私は信じています"}, {"type": "subtitle", "time": 13954.95, "timestamp": "03:52:34", "text": "えっと、私はこう思います"}, {"type": "subtitle", "time": 13957.67, "timestamp": "03:52:37", "text": "ああ、どれくらい痛いか"}, {"type": "subtitle", "time": 13960.389, "timestamp": "03:52:40", "text": "高額になるだろう。ええと、でもやってみます"}, {"type": "subtitle", "time": 13962.469, "timestamp": "03:52:42", "text": "すべてを収めるために、そして私は収まります"}, {"type": "subtitle", "time": 13964.469, "timestamp": "03:52:44", "text": "すべて入っています。だから心配しないでください。"}, {"type": "subtitle", "time": 13967.71, "timestamp": "03:52:47", "text": "私はそのストリームを"}, {"type": "subtitle", "time": 13971.189, "timestamp": "03:52:51", "text": "トゥイッチ。うん。うん。うん。ああ、私は"}, {"type": "subtitle", "time": 13973.51, "timestamp": "03:52:53", "text": "眠りたいけど、眠りたくない。"}, {"type": "subtitle", "time": 13975.79, "timestamp": "03:52:55", "text": "そしてそれは戻ってきた。私は"}, {"type": "subtitle", "time": 13978.189, "timestamp": "03:52:58", "text": "こんにちは"}]
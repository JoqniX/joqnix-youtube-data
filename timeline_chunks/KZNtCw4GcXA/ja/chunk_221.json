[{"type": "subtitle", "time": 13261.95, "timestamp": "03:41:01", "text": "私のセレスティアン"}, {"type": "subtitle", "time": 13266.389, "timestamp": "03:41:06", "text": "イヤホンが壊れたので、電話を使います。神に課せ"}, {"type": "subtitle", "time": 13270.07, "timestamp": "03:41:10", "text": "ゼロ。スピーカーフォンにして、えーと"}, {"type": "subtitle", "time": 13274.07, "timestamp": "03:41:14", "text": "彼らの演奏を聴いていた"}, {"type": "subtitle", "time": 13277.67, "timestamp": "03:41:17", "text": "デュオとしてプレイしてゴーストを実行するのと同じように"}, {"type": "subtitle", "time": 13279.83, "timestamp": "03:41:19", "text": "物を送る。それで私は「え、なんで？」って思った"}, {"type": "subtitle", "time": 13281.87, "timestamp": "03:41:21", "text": "音声がないのですか？どうしたの？"}, {"type": "subtitle", "time": 13285.51, "timestamp": "03:41:25", "text": "待って。それから私は確認しました、私は感じます"}, {"type": "subtitle", "time": 13287.99, "timestamp": "03:41:27", "text": "スコアアプリがクラッシュしたか、"}, {"type": "subtitle", "time": 13289.19, "timestamp": "03:41:29", "text": "何か。理由がわからない。それは"}, {"type": "subtitle", "time": 13291.07, "timestamp": "03:41:31", "text": "奇妙な。"}, {"type": "subtitle", "time": 13295.03, "timestamp": "03:41:35", "text": "それから文字通り右に曲がる"}, {"type": "subtitle", "time": 13298.389, "timestamp": "03:41:38", "text": "モニターの方を見ると、"}, {"type": "subtitle", "time": 13301.11, "timestamp": "03:41:41", "text": "YouTube動画が表示されます。私はこう思った。"}, {"type": "subtitle", "time": 13304.99, "timestamp": "03:41:44", "text": "「え？待って、戻ってきたの？ついに戻ってきたの？」"}, {"type": "subtitle", "time": 13307.07, "timestamp": "03:41:47", "text": "戻る？"}, {"type": "subtitle", "time": 13311.11, "timestamp": "03:41:51", "text": "だから私はここにいるのです。私は文字通りつながります"}, {"type": "subtitle", "time": 13313.349, "timestamp": "03:41:53", "text": "Dash God と繋がっていて、私はそうではない"}, {"type": "subtitle", "time": 13316.389, "timestamp": "03:41:56", "text": "Vと"}]
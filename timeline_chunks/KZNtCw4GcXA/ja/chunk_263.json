[{"type": "subtitle", "time": 15784.55, "timestamp": "04:23:04", "text": "君たちはランダムに選んだんだね。"}, {"type": "subtitle", "time": 15787.51, "timestamp": "04:23:07", "text": "いや、待って。ちょっと待ってください、私は今"}, {"type": "subtitle", "time": 15789.99, "timestamp": "04:23:09", "text": "気が散っている。ごめんなさい。わかった。私が選んだ"}, {"type": "subtitle", "time": 15792.229, "timestamp": "04:23:12", "text": "ランダム。あ、待って。購入する必要があります"}, {"type": "subtitle", "time": 15794.469, "timestamp": "04:23:14", "text": "そういうことですよね？ああ、彼らは"}, {"type": "subtitle", "time": 15797.429, "timestamp": "04:23:17", "text": "UI。ニース。ええ、彼らは全体をリセットしました"}, {"type": "subtitle", "time": 15799.67, "timestamp": "04:23:19", "text": "もの。ええ、すべてが"}, {"type": "subtitle", "time": 15807.59, "timestamp": "04:23:27", "text": "これは、何でも買えるお金です。"}, {"type": "subtitle", "time": 15809.11, "timestamp": "04:23:29", "text": "さあ、行こう。ああ、お金がないんです。"}, {"type": "subtitle", "time": 15811.03, "timestamp": "04:23:31", "text": "いいね。それでいいんだよ。あのね？"}, {"type": "subtitle", "time": 15813.03, "timestamp": "04:23:33", "text": "悪夢モードに突入しよう。"}, {"type": "subtitle", "time": 15815.11, "timestamp": "04:23:35", "text": "さあ行こう。うん、夜だよ、私たちは"}, {"type": "subtitle", "time": 15818.87, "timestamp": "04:23:38", "text": "悪夢モード。まあ、そんなことはどうでもいい。"}, {"type": "subtitle", "time": 15821.349, "timestamp": "04:23:41", "text": "それが一番難しいんじゃない？"}, {"type": "subtitle", "time": 15823.91, "timestamp": "04:23:43", "text": "いや、いや、いや。いや、いや、いや。ジャックはそれを克服した"}, {"type": "subtitle", "time": 15825.59, "timestamp": "04:23:45", "text": "友情の力も同様に強い。"}, {"type": "subtitle", "time": 15828.149, "timestamp": "04:23:48", "text": "友情。もちろん。もちろん。準備ができて"}, {"type": "subtitle", "time": 15829.99, "timestamp": "04:23:49", "text": "上。準備しろ、ジャック。私たちならできる。"}, {"type": "subtitle", "time": 15832.149, "timestamp": "04:23:52", "text": "わかった。うん、できるよ。私は信じています"}, {"type": "subtitle", "time": 15835.51, "timestamp": "04:23:55", "text": "私たち。笑顔。私たちは、"}, {"type": "subtitle", "time": 15839.229, "timestamp": "04:23:59", "text": "ゼロドルだよ。来て。さあ行こう。"}]
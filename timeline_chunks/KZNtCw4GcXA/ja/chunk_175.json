[{"type": "subtitle", "time": 10500.389, "timestamp": "02:55:00", "text": "このストリームを複数人で視聴できるのは"}, {"type": "subtitle", "time": 10503.83, "timestamp": "02:55:03", "text": "セレスティアの両方で利用可能です"}, {"type": "subtitle", "time": 10506.55, "timestamp": "02:55:06", "text": "ストリーミングはストリーミングであり、私も"}, {"type": "subtitle", "time": 10509.429, "timestamp": "02:55:09", "text": "ストリーミング配信。私たち全員を応援してください。えっと、もし"}, {"type": "subtitle", "time": 10511.03, "timestamp": "02:55:11", "text": "購読していない場合は、"}, {"type": "subtitle", "time": 10513.19, "timestamp": "02:55:13", "text": "見たいなら、全部見てもいいですよ。"}, {"type": "subtitle", "time": 10516.15, "timestamp": "02:55:16", "text": "それはあなた次第です。私がしないというリマインダー"}, {"type": "subtitle", "time": 10517.99, "timestamp": "02:55:17", "text": "今日ではチャットにそれほどアクセスできる"}, {"type": "subtitle", "time": 10521.269, "timestamp": "02:55:21", "text": "だって、配信に集中しないといけないから。それで、"}, {"type": "subtitle", "time": 10524.07, "timestamp": "02:55:24", "text": "私が見ることを覚えておいてください"}, {"type": "subtitle", "time": 10526.55, "timestamp": "02:55:26", "text": "チャットでは、声を出して話すことはできません"}, {"type": "subtitle", "time": 10528.87, "timestamp": "02:55:28", "text": "声に出して読むか、"}, {"type": "subtitle", "time": 10531.429, "timestamp": "02:55:31", "text": "時々チャットします。集中します。"}, {"type": "subtitle", "time": 10534.389, "timestamp": "02:55:34", "text": "シュリモカにて。でも、見てみますよ。"}, {"type": "subtitle", "time": 10536.71, "timestamp": "02:55:36", "text": "検討してみます。いいね"}, {"type": "subtitle", "time": 10539.349, "timestamp": "02:55:39", "text": "私がこのように見えるとき、"}, {"type": "subtitle", "time": 10540.83, "timestamp": "02:55:40", "text": "左隅"}, {"type": "subtitle", "time": 10543.349, "timestamp": "02:55:43", "text": "側。うん。こんにちは。うん。こんにちは、ブラッド。"}, {"type": "subtitle", "time": 10545.269, "timestamp": "02:55:45", "text": "皆さんお元気でお過ごしでしょうか。私のことを恋しく思ってくれた？"}, {"type": "subtitle", "time": 10548.309, "timestamp": "02:55:48", "text": "うん、みんなに会えなくて寂しかったよ。はい、まだです"}, {"type": "subtitle", "time": 10550.95, "timestamp": "02:55:50", "text": "ストリーミング配信されました。えっと、昨日配信したっけ？私"}, {"type": "subtitle", "time": 10553.19, "timestamp": "02:55:53", "text": "わからない。私は配信してないよね？私"}, {"type": "subtitle", "time": 10556.11, "timestamp": "02:55:56", "text": "わからない。でも、うんうんうんうん。"}]
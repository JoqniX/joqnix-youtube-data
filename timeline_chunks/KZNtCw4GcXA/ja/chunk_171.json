[{"type": "subtitle", "time": 10278.79, "timestamp": "02:51:18", "text": "[音楽]"}, {"type": "subtitle", "time": 10280.03, "timestamp": "02:51:20", "text": "うん。こんにちは"}, {"type": "subtitle", "time": 10284.309, "timestamp": "02:51:24", "text": "みんな。こんにちは。こんにちは。皆さんが"}, {"type": "subtitle", "time": 10290.07, "timestamp": "02:51:30", "text": "ヤフー。皆さんお元気でお過ごしでしょうか。"}, {"type": "subtitle", "time": 10292.23, "timestamp": "02:51:32", "text": "ヤフー。"}, {"type": "subtitle", "time": 10295.67, "timestamp": "02:51:35", "text": "今日はストリーミング配信を行います"}, {"type": "subtitle", "time": 10296.59, "timestamp": "02:51:36", "text": "そして"}, {"type": "subtitle", "time": 10299.87, "timestamp": "02:51:39", "text": "速く演奏してパフォーマンスする"}, {"type": "subtitle", "time": 10302.67, "timestamp": "02:51:42", "text": "ギャングと私"}, {"type": "subtitle", "time": 10307.309, "timestamp": "02:51:47", "text": "本当に本当に本当に本当に本当にうーん"}, {"type": "subtitle", "time": 10311.11, "timestamp": "02:51:51", "text": "緊張したり、恥ずかしがったり、たくさんの感情を感じたり"}, {"type": "subtitle", "time": 10313.79, "timestamp": "02:51:53", "text": "今すぐ"}, {"type": "subtitle", "time": 10317.429, "timestamp": "02:51:57", "text": "でも、でも、すべてがうまくいくことを願っています"}, {"type": "subtitle", "time": 10319.87, "timestamp": "02:51:59", "text": "それが私の望みです"}]
[{"type": "subtitle", "time": 16325.67, "timestamp": "04:32:05", "text": "うん。私たち二人は死んだ。オーを見つけよう"}, {"type": "subtitle", "time": 16327.91, "timestamp": "04:32:07", "text": "あれを見てください。私たちの体。"}, {"type": "subtitle", "time": 16331.03, "timestamp": "04:32:11", "text": "うん。ああ、とにかく、ここに置いておきます"}, {"type": "subtitle", "time": 16334.91, "timestamp": "04:32:14", "text": "そして、えーと、えーと、"}, {"type": "subtitle", "time": 16337.67, "timestamp": "04:32:17", "text": "何か。えっと、何も見えません。"}, {"type": "subtitle", "time": 16340.229, "timestamp": "04:32:20", "text": "くそっ。懐中電灯はどこ？"}, {"type": "subtitle", "time": 16342.87, "timestamp": "04:32:22", "text": "懐中電灯は私の体に付いていると思う。"}, {"type": "subtitle", "time": 16345.67, "timestamp": "04:32:25", "text": "2階にあります。うん。ああ、幽霊は"}, {"type": "subtitle", "time": 16347.99, "timestamp": "04:32:27", "text": "二階へ上がってきます。なんてこった。うん。うん。走る"}, {"type": "subtitle", "time": 16349.229, "timestamp": "04:32:29", "text": "離れて。走る"}, {"type": "subtitle", "time": 16353.51, "timestamp": "04:32:33", "text": "離れて。私はしたくない 私はしたくない 私は"}, {"type": "subtitle", "time": 16356.229, "timestamp": "04:32:36", "text": "一人で遊べないなんて嫌だ。"}, {"type": "subtitle", "time": 16358.229, "timestamp": "04:32:38", "text": "それは馬鹿げているだろう。"}, {"type": "subtitle", "time": 16360.71, "timestamp": "04:32:40", "text": "ああ、息が詰まってるよ。"}, {"type": "subtitle", "time": 16362.389, "timestamp": "04:32:42", "text": "うん、大丈夫だよ。大丈夫です。それは"}, {"type": "subtitle", "time": 16363.91, "timestamp": "04:32:43", "text": "軽い窒息。彼は私に"}, {"type": "subtitle", "time": 16367.11, "timestamp": "04:32:47", "text": "首のマッサージ。大丈夫です。"}, {"type": "subtitle", "time": 16373.189, "timestamp": "04:32:53", "text": "ああ、彼らは亡くなった。よし、これで全員死んだ。"}, {"type": "subtitle", "time": 16374.71, "timestamp": "04:32:54", "text": "悪夢ってそういうものだと思う"}, {"type": "subtitle", "time": 16376.229, "timestamp": "04:32:56", "text": "モードですよね？それはあなたに"}, {"type": "subtitle", "time": 16378.95, "timestamp": "04:32:58", "text": "準備と出発に少し時間がかかる"}]
[{"type": "subtitle", "time": 15722.71, "timestamp": "04:22:02", "text": "小川。典型的な私の配信です。"}, {"type": "subtitle", "time": 15724.389, "timestamp": "04:22:04", "text": "自分。"}, {"type": "subtitle", "time": 15726.389, "timestamp": "04:22:06", "text": "待って、私のキャプチャカードはそうじゃないけど、私は大好き"}, {"type": "subtitle", "time": 15728.63, "timestamp": "04:22:08", "text": "サムネイル。サムネイルが気に入りました。"}, {"type": "subtitle", "time": 15732.07, "timestamp": "04:22:12", "text": "はい。え、何？何？何？止める"}, {"type": "subtitle", "time": 15735.99, "timestamp": "04:22:15", "text": "ゲーム。はい。うん。うん。うん。うん。わーい。"}, {"type": "subtitle", "time": 15739.269, "timestamp": "04:22:19", "text": "私はやめます。何てことだ。銃"}, {"type": "subtitle", "time": 15741.59, "timestamp": "04:22:21", "text": "動作していません。何"}, {"type": "subtitle", "time": 15746.309, "timestamp": "04:22:26", "text": "待って、待って、待って、待って、待って。何？どうやって？"}, {"type": "subtitle", "time": 15748.79, "timestamp": "04:22:28", "text": "待って。"}, {"type": "subtitle", "time": 15751.67, "timestamp": "04:22:31", "text": "よし、ランダム再生ボタンを押した。そこには"}, {"type": "subtitle", "time": 15755.189, "timestamp": "04:22:35", "text": "オーディオ。そして私はそれを悪夢に変えてしまった。待って、"}, {"type": "subtitle", "time": 15757.51, "timestamp": "04:22:37", "text": "何？おお。ああ、神様。ああ、神様。ああ、神様。与える"}, {"type": "subtitle", "time": 15761.189, "timestamp": "04:22:41", "text": "ちょっと待ってください。ああ、彼らは「ああ、だめだ」を見せた。"}, {"type": "subtitle", "time": 15763.03, "timestamp": "04:22:43", "text": "誰が気にする？誰も私の配信を見ていない。"}, {"type": "subtitle", "time": 15765.429, "timestamp": "04:22:45", "text": "しかし、安全上の理由から、やはりそうすべきです。"}, {"type": "subtitle", "time": 15768.269, "timestamp": "04:22:48", "text": "待って、私、何か間違えた？"}, {"type": "subtitle", "time": 15772.55, "timestamp": "04:22:52", "text": "ああ、わかった。いいね。"}, {"type": "subtitle", "time": 15775.429, "timestamp": "04:22:55", "text": "待って。何てことだ。待って。誰も知らないことは分かっています"}, {"type": "subtitle", "time": 15777.75, "timestamp": "04:22:57", "text": "配信を見ているけど、それでも。最新情報"}]
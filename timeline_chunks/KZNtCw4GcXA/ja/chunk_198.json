[{"type": "subtitle", "time": 11880.95, "timestamp": "03:18:00", "text": "こんにちは、幽霊さん。ただ見ているだけです。私はただ"}, {"type": "subtitle", "time": 11884.71, "timestamp": "03:18:04", "text": "私はただ欲しいだけです 私はただ欲しいだけです"}, {"type": "subtitle", "time": 11887.75, "timestamp": "03:18:07", "text": "紫外線みたいなもの。来て。私は"}, {"type": "subtitle", "time": 11895.19, "timestamp": "03:18:15", "text": "こんにちは、エイプリル。私と話したいですか？"}, {"type": "subtitle", "time": 11897.67, "timestamp": "03:18:17", "text": "私はここに一人でいる。"}, {"type": "subtitle", "time": 11899.67, "timestamp": "03:18:19", "text": "恥ずかしがらないで。話すのが怖い"}, {"type": "subtitle", "time": 11901.91, "timestamp": "03:18:21", "text": "幽霊。"}, {"type": "subtitle", "time": 11903.59, "timestamp": "03:18:23", "text": "本当にそうしたいなら、"}, {"type": "subtitle", "time": 11906.309, "timestamp": "03:18:26", "text": "幽霊と話して、私のラジオを持って行ってください。おお、"}, {"type": "subtitle", "time": 11909.349, "timestamp": "03:18:29", "text": "彼女は電気を消した。"}, {"type": "subtitle", "time": 11912.55, "timestamp": "03:18:32", "text": "私に話して。そうそう。あなたは自分のようにすることができます"}, {"type": "subtitle", "time": 11914.469, "timestamp": "03:18:34", "text": "彼女と話したいなら話してもいいけど、"}, {"type": "subtitle", "time": 11917.75, "timestamp": "03:18:37", "text": "ラジオが必要だ。"}, {"type": "subtitle", "time": 11920.63, "timestamp": "03:18:40", "text": "私は手に入れている"}, {"type": "subtitle", "time": 11927.03, "timestamp": "03:18:47", "text": "まあ、私は死んだ。"}, {"type": "subtitle", "time": 11929.59, "timestamp": "03:18:49", "text": "おっと。彼女はそれを文字通り"}, {"type": "subtitle", "time": 11931.429, "timestamp": "03:18:51", "text": "自分。ジョブ、心配しないで。私は文字通り"}, {"type": "subtitle", "time": 11936.11, "timestamp": "03:18:56", "text": "これはあなただけのためのものです。来て。何？"}, {"type": "subtitle", "time": 11939.67, "timestamp": "03:18:59", "text": "ああ、ジョール、君も死んでしまったのか？いいえ。私は"}]
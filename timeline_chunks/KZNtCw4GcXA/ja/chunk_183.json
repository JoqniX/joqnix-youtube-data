[{"type": "subtitle", "time": 10982.71, "timestamp": "03:03:02", "text": "彼らは、彼らが戻ったのが好きだった"}, {"type": "subtitle", "time": 10986.309, "timestamp": "03:03:06", "text": "モンキーモード。知っている。"}, {"type": "subtitle", "time": 10988.79, "timestamp": "03:03:08", "text": "なぜこれはアナログなのか？"}, {"type": "subtitle", "time": 10991.269, "timestamp": "03:03:11", "text": "何もかもが「なんてこった」って感じ。大好きです。私"}, {"type": "subtitle", "time": 10994.309, "timestamp": "03:03:14", "text": "大好きです。大丈夫です。うん。えっと、行こう"}, {"type": "subtitle", "time": 10995.67, "timestamp": "03:03:15", "text": "さあ、行こう。皆さんは"}, {"type": "subtitle", "time": 10997.99, "timestamp": "03:03:17", "text": "音声のことですよね？それは、"}, {"type": "subtitle", "time": 10999.51, "timestamp": "03:03:19", "text": "難しいこと？私はそうは思わない。"}, {"type": "subtitle", "time": 11002.309, "timestamp": "03:03:22", "text": "右。えーっと、つまり、あなたが受けられるかどうかは"}, {"type": "subtitle", "time": 11005.269, "timestamp": "03:03:25", "text": "トーチ、光、毒。いや、違うよ。私はしませんでした"}, {"type": "subtitle", "time": 11007.59, "timestamp": "03:03:27", "text": "まだ懐中電灯を持っていない。ええと、私たちは"}, {"type": "subtitle", "time": 11009.429, "timestamp": "03:03:29", "text": "懐中電灯を持っている。持っていません 必要ありません"}, {"type": "subtitle", "time": 11011.67, "timestamp": "03:03:31", "text": "懐中電灯。大丈夫です。大丈夫です。しないで"}, {"type": "subtitle", "time": 11013.75, "timestamp": "03:03:33", "text": "懐中電灯が必要だ。私たちはただ盲目になるだけです。その"}, {"type": "subtitle", "time": 11017.429, "timestamp": "03:03:37", "text": "大丈夫。買います。"}, {"type": "subtitle", "time": 11019.269, "timestamp": "03:03:39", "text": "少し遅れていますが、これは"}, {"type": "subtitle", "time": 11023.11, "timestamp": "03:03:43", "text": "大丈夫。あ、待って。ああ、設定ですね。ああ、神様。"}, {"type": "subtitle", "time": 11026.07, "timestamp": "03:03:46", "text": "ああ、神様。えっと、そうしないといけないのかな？わからない"}, {"type": "subtitle", "time": 11027.51, "timestamp": "03:03:47", "text": "これが何をするのか、でも私は"}, {"type": "subtitle", "time": 11029.429, "timestamp": "03:03:49", "text": "それ。"}, {"type": "subtitle", "time": 11032.349, "timestamp": "03:03:52", "text": "全てが低い。すべては"}, {"type": "subtitle", "time": 11035.349, "timestamp": "03:03:55", "text": "低い。幸いなことに、私はここに留まることはできません"}, {"type": "subtitle", "time": 11037.429, "timestamp": "03:03:57", "text": "最後まで長い。うん。うん。うん。"}, {"type": "subtitle", "time": 11038.91, "timestamp": "03:03:58", "text": "大丈夫。大丈夫。それは"}]
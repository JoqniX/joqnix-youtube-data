[{"type": "subtitle", "time": 15601.99, "timestamp": "04:20:01", "text": "白か黄色か確認しなければなりませんでした。"}, {"type": "subtitle", "time": 15605.309, "timestamp": "04:20:05", "text": "「黄色い雪」とはどういう意味ですか？"}, {"type": "subtitle", "time": 15607.91, "timestamp": "04:20:07", "text": "何？そこにあるのは白い雪だけだ。何が"}, {"type": "subtitle", "time": 15619.429, "timestamp": "04:20:19", "text": "こんにちは。こんにちは。こんにちは。こんにちは"}, {"type": "subtitle", "time": 15622.63, "timestamp": "04:20:22", "text": "みんな。こんにちは。元気ですか？したい"}, {"type": "subtitle", "time": 15630.55, "timestamp": "04:20:30", "text": "私はそうは思わない それはまるで"}, {"type": "subtitle", "time": 15634.229, "timestamp": "04:20:34", "text": "自動再生だけど、ああ、"}, {"type": "subtitle", "time": 15637.11, "timestamp": "04:20:37", "text": "セレスティア。ニース。ああ、外にいるのは私です"}, {"type": "subtitle", "time": 15639.429, "timestamp": "04:20:39", "text": "窓。涼しい。ええ、そうです"}, {"type": "subtitle", "time": 15643.75, "timestamp": "04:20:43", "text": "セレスティアとあなたがティーバッグをしている。いいえ、好きです"}, {"type": "subtitle", "time": 15651.229, "timestamp": "04:20:51", "text": "ティーグ・ユー。待って、やめて"}]
[{"type": "subtitle", "time": 2112.23, "timestamp": "00:35:12", "text": "送信済み。私は彼女の右耳だと思うが、"}, {"type": "subtitle", "time": 2153.27, "timestamp": "00:35:53", "text": "彼の顔を見た瞬間、私は死んだ。彼と私は死んだ"}, {"type": "subtitle", "time": 2157.31, "timestamp": "00:35:57", "text": "一緒に。私たちは一緒に死んだ"}, {"type": "subtitle", "time": 2159.55, "timestamp": "00:35:59", "text": "1つ。"}]
[{"type": "subtitle", "time": 21008.03, "timestamp": "05:50:08", "text": "何が"}, {"type": "subtitle", "time": 21012.628, "timestamp": "05:50:12", "text": "えーっと、一般的に言うと"}, {"type": "subtitle", "time": 21015.99, "timestamp": "05:50:15", "text": "話している私は知っているように"}, {"type": "subtitle", "time": 21018.868, "timestamp": "05:50:18", "text": "えっと、人々は女性クリエイターの方が好きみたいですね"}, {"type": "subtitle", "time": 21021.91, "timestamp": "05:50:21", "text": "さらに、オスの生き物は存在しません"}, {"type": "subtitle", "time": 21024.868, "timestamp": "05:50:24", "text": "ある意味ではビデオウィングスフィアと"}, {"type": "subtitle", "time": 21029.51, "timestamp": "05:50:29", "text": "すべて、そして私のケースは少し"}, {"type": "subtitle", "time": 21031.16, "timestamp": "05:50:31", "text": "真ん中、たぶん私はそう思わない"}, {"type": "subtitle", "time": 21038.19, "timestamp": "05:50:38", "text": "知ってるよ、だから私は"}, {"type": "subtitle", "time": 21040.788, "timestamp": "05:50:40", "text": "心配した。 「ああ、"}, {"type": "subtitle", "time": 21043.708, "timestamp": "05:50:43", "text": "ジョーはこんなふりをしている、あるいは"}, {"type": "subtitle", "time": 21046.91, "timestamp": "05:50:46", "text": "何でも。それは彼の声ではないし、"}, {"type": "subtitle", "time": 21049.19, "timestamp": "05:50:49", "text": "何か。 「なぜできないの？」でも"}, {"type": "subtitle", "time": 21050.868, "timestamp": "05:50:50", "text": "もう一つ言うことがある。"}, {"type": "subtitle", "time": 21052.788, "timestamp": "05:50:52", "text": "「わかった、なぜ他の人の話を聞こうとしているの？」"}, {"type": "subtitle", "time": 21055.59, "timestamp": "05:50:55", "text": "他の人はどう言っているのか？優先順位をつける"}, {"type": "subtitle", "time": 21057.35, "timestamp": "05:50:57", "text": "自分自身が何をしたいのか、何をしたいのか"}, {"type": "subtitle", "time": 21059.628, "timestamp": "05:50:59", "text": "作成したいし、"}]
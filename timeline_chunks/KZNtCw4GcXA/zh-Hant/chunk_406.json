[{"type": "subtitle", "time": 24364.99, "timestamp": "06:46:04", "text": "類別不對，我會受到懲罰。我正在了解比利比利的很多事情"}, {"type": "subtitle", "time": 24368.07, "timestamp": "06:46:08", "text": "。你喜歡這裡嗎"}, {"type": "subtitle", "time": 24370.23, "timestamp": "06:46:10", "text": "？嗯，一開始我很擔心"}, {"type": "subtitle", "time": 24375.708, "timestamp": "06:46:15", "text": "別人會不會接受我。我在《"}, {"type": "subtitle", "time": 24390.07, "timestamp": "06:46:30", "text": "比利比利》劇組的第一天，每個人都很友善，這改變了我的想法，讓我感到快樂"}, {"type": "subtitle", "time": 24419.19, "timestamp": "06:46:59", "text": "，也改變了我最初的想法，即人們會如何評判我等等。但我很高興有幾個人來我的直播間和我聊天。"}]
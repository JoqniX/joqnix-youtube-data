[{"type": "subtitle", "time": 32655.59, "timestamp": "09:04:15", "text": "你們還好嗎？好了，"}, {"type": "subtitle", "time": 32657.868, "timestamp": "09:04:17", "text": "現在開始旋轉。準備去"}, {"type": "subtitle", "time": 32666.708, "timestamp": "09:04:26", "text": "中等，中等，中等，中等。"}, {"type": "subtitle", "time": 32673.99, "timestamp": "09:04:33", "text": "對不起，喬。  沒關係。沒關係。沒關係。"}, {"type": "subtitle", "time": 32675.27, "timestamp": "09:04:35", "text": "不用"}, {"type": "subtitle", "time": 32677.43, "timestamp": "09:04:37", "text": "擔心。"}, {"type": "subtitle", "time": 32680.07, "timestamp": "09:04:40", "text": "我喜歡我把事情搞砸的樣子，但"}, {"type": "subtitle", "time": 32687.548, "timestamp": "09:04:47", "text": "我的意思是，如果有效，那就有效。"}, {"type": "subtitle", "time": 32690.708, "timestamp": "09:04:50", "text": "這一次。"}, {"type": "subtitle", "time": 32699.11, "timestamp": "09:04:59", "text": "我想，再去B就到A了"}]
[{"type": "subtitle", "time": 33481.908, "timestamp": "09:18:01", "text": "夥計們，我們被擊落了，還遭到了射擊。"}, {"type": "subtitle", "time": 33484.388, "timestamp": "09:18:04", "text": "你們這些人，"}, {"type": "subtitle", "time": 33487.19, "timestamp": "09:18:07", "text": "你們買不到我的時間，我的時間已經到了。你可以"}, {"type": "subtitle", "time": 33511.35, "timestamp": "09:18:31", "text": "啊，不錯。"}, {"type": "subtitle", "time": 33517.748, "timestamp": "09:18:37", "text": "，RSU，聽我說。買一把"}, {"type": "subtitle", "time": 33519.748, "timestamp": "09:18:39", "text": "霰彈槍。"}, {"type": "subtitle", "time": 33521.99, "timestamp": "09:18:41", "text": "買輛Nova。霰彈槍。  我的天哪。霰彈槍。我們贏了。我們贏了"}, {"type": "subtitle", "time": 33527.99, "timestamp": "09:18:47", "text": "。我們贏了。  我們贏了。我們贏了。很遠的路。我"}, {"type": "subtitle", "time": 33533.03, "timestamp": "09:18:53", "text": "放棄。我"}, {"type": "subtitle", "time": 33535.83, "timestamp": "09:18:55", "text": "不打算離開。  買一個吧，你這混蛋。他媽的。哦，我出不去了。不，你最好是這樣。"}, {"type": "subtitle", "time": 33537.35, "timestamp": "09:18:57", "text": "你知道嗎？我把我的給你，你這個"}]
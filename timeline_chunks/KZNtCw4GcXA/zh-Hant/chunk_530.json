[{"type": "subtitle", "time": 31807.35, "timestamp": "08:50:07", "text": "喬克，別讓巔峰期停滯不前。趕緊他媽的走吧。"}, {"type": "subtitle", "time": 31810.388, "timestamp": "08:50:10", "text": "好的。別那樣慢吞吞地偷看角落"}, {"type": "subtitle", "time": 31812.708, "timestamp": "08:50:12", "text": "。"}, {"type": "subtitle", "time": 31814.708, "timestamp": "08:50:14", "text": "我要去。  是的"}, {"type": "subtitle", "time": 31829.75, "timestamp": "08:50:29", "text": "角落裡還有一個。不，在"}, {"type": "subtitle", "time": 31835.99, "timestamp": "08:50:35", "text": "真是嚇死我了。我看到了其中兩個"}, {"type": "subtitle", "time": 31842.15, "timestamp": "08:50:42", "text": "[掌聲]"}, {"type": "subtitle", "time": 31845.19, "timestamp": "08:50:45", "text": "操，兄弟。真倒楣。我喜歡"}, {"type": "subtitle", "time": 31848.07, "timestamp": "08:50:48", "text": "他們連A級都沒進。真的，沒有。我"}, {"type": "subtitle", "time": 31851.03, "timestamp": "08:50:51", "text": "想做B。他們真的必須"}, {"type": "subtitle", "time": 31855.51, "timestamp": "08:50:55", "text": "做B。他們必須贏下B。"}, {"type": "subtitle", "time": 31857.83, "timestamp": "08:50:57", "text": "誰知道呢？或許這次他們會的"}]
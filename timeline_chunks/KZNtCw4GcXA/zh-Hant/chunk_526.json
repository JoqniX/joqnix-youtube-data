[{"type": "subtitle", "time": 31560.628, "timestamp": "08:46:00", "text": "好球。"}, {"type": "subtitle", "time": 31563.03, "timestamp": "08:46:03", "text": "放下煙霧。"}, {"type": "subtitle", "time": 31577.83, "timestamp": "08:46:17", "text": "。如果有人被這枚"}, {"type": "subtitle", "time": 31580.07, "timestamp": "08:46:20", "text": "手榴彈擊中，我不會責怪任何人。別怪我。"}, {"type": "subtitle", "time": 31592.23, "timestamp": "08:46:32", "text": "哦。啊。"}, {"type": "subtitle", "time": 31601.91, "timestamp": "08:46:41", "text": "他恨你。他在哪裡？"}]
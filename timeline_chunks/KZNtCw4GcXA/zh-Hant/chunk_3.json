[{"type": "subtitle", "time": 181.35, "timestamp": "00:03:01", "text": "遊戲總是圍繞著你，我現在一直在玩它們，這讓我感覺，"}, {"type": "subtitle", "time": 191.71, "timestamp": "00:03:11", "text": "我真的想在這個"}, {"type": "subtitle", "time": 195.55, "timestamp": "00:03:15", "text": "時候做這件事嗎？我就是這種感覺。我真的"}, {"type": "subtitle", "time": 198.15, "timestamp": "00:03:18", "text": "想玩這個"}, {"type": "subtitle", "time": 200.27, "timestamp": "00:03:20", "text": "音樂"}, {"type": "subtitle", "time": 203.43, "timestamp": "00:03:23", "text": "遊戲嗎？堅持，稍等。我還沒想過要一起玩 um chain，都是單人玩。"}, {"type": "subtitle", "time": 213.50900000000001, "timestamp": "00:03:33", "text": "堅持，稍等。"}, {"type": "subtitle", "time": 217.07, "timestamp": "00:03:37", "text": "我知道現在大多數人可能已經對"}, {"type": "subtitle", "time": 220.309, "timestamp": "00:03:40", "text": "我的個人作品感到厭倦，很少看到合作作品，"}, {"type": "subtitle", "time": 223.91, "timestamp": "00:03:43", "text": "但"}, {"type": "subtitle", "time": 230.55, "timestamp": "00:03:50", "text": "我感覺我不知道該怎麼辦。有時我覺得我在單人內容創作、單人直播等等方面受到了更多"}, {"type": "subtitle", "time": 234.67000000000002, "timestamp": "00:03:54", "text": "限制。"}]
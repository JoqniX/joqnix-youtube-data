[{"type": "subtitle", "time": 32349.868, "timestamp": "08:59:09", "text": "我們這裡有一張"}, {"type": "subtitle", "time": 32352.75, "timestamp": "08:59:12", "text": "醫用"}, {"type": "subtitle", "time": 32355.67, "timestamp": "08:59:15", "text": "床位。"}, {"type": "subtitle", "time": 32362.468, "timestamp": "08:59:22", "text": "不，從你這邊來說。從你的角度來看。在"}, {"type": "subtitle", "time": 32384.708, "timestamp": "08:59:44", "text": "那傢伙看到他開槍，我就說："}, {"type": "subtitle", "time": 32390.868, "timestamp": "08:59:50", "text": "我想我可以給你一把槍。」不，"}, {"type": "subtitle", "time": 32395.27, "timestamp": "08:59:55", "text": "我覺得你是買一套盔甲。喲，"}]
[{"type": "subtitle", "time": 545.23, "timestamp": "00:09:05", "text": "我的聲音"}, {"type": "subtitle", "time": 547.829, "timestamp": "00:09:07", "text": "有延遲一樣。啊，我的聲音有點沙啞，是不是？我的"}, {"type": "subtitle", "time": 564.67, "timestamp": "00:09:24", "text": "天哪，這太"}, {"type": "subtitle", "time": 567.43, "timestamp": "00:09:27", "text": "糟糕了。你看，這就是我以為告訴"}, {"type": "subtitle", "time": 569.75, "timestamp": "00:09:29", "text": "你們的。  根本玩"}]
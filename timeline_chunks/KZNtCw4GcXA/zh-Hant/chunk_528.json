[{"type": "subtitle", "time": 31691.15, "timestamp": "08:48:11", "text": "Zam。他打出了一桿進洞。"}, {"type": "subtitle", "time": 31701.35, "timestamp": "08:48:21", "text": "喬。我不再信任你了。更多的。"}, {"type": "subtitle", "time": 31703.43, "timestamp": "08:48:23", "text": "不再信任。"}, {"type": "subtitle", "time": 31711.27, "timestamp": "08:48:31", "text": "我是無辜的。"}, {"type": "subtitle", "time": 31713.27, "timestamp": "08:48:33", "text": "你不。"}, {"type": "subtitle", "time": 31722.23, "timestamp": "08:48:42", "text": "那裡有他們的蹤跡嗎？是的。好的。"}, {"type": "subtitle", "time": 31724.51, "timestamp": "08:48:44", "text": "有"}, {"type": "subtitle", "time": 31728.868, "timestamp": "08:48:48", "text": "跡象表明這一點。證據就在那裡。"}, {"type": "subtitle", "time": 31731.35, "timestamp": "08:48:51", "text": "左邊那個。"}, {"type": "subtitle", "time": 31734.27, "timestamp": "08:48:54", "text": "我的天哪，太棒了。你們還好嗎？"}, {"type": "subtitle", "time": 31736.35, "timestamp": "08:48:56", "text": "喬克，別"}]
[{"type": "subtitle", "time": 1690.35, "timestamp": "00:28:10", "text": "現在沒電了，我該怎麼"}, {"type": "subtitle", "time": 1694.11, "timestamp": "00:28:14", "text": "辦？我不介意。你知道，我本來可以的，但是我的麥克風壞了，"}, {"type": "subtitle", "time": 1700.87, "timestamp": "00:28:20", "text": "而且顯然我不能"}, {"type": "subtitle", "time": 1702.83, "timestamp": "00:28:22", "text": "在Billy Billy上使用PNG模型"}, {"type": "subtitle", "time": 1706.71, "timestamp": "00:28:26", "text": "。我不明白。  找到匹配項。"}, {"type": "subtitle", "time": 1709.19, "timestamp": "00:28:29", "text": "我知道他們"}, {"type": "subtitle", "time": 1712.19, "timestamp": "00:28:32", "text": "向所有人提供數千個免費模型"}, {"type": "subtitle", "time": 1715.789, "timestamp": "00:28:35", "text": "。難以置信的免費"}, {"type": "subtitle", "time": 1718.35, "timestamp": "00:28:38", "text": "模型。  不過，我的電腦確實很爛。"}]
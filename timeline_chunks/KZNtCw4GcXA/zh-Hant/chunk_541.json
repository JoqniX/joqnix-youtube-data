[{"type": "subtitle", "time": 32475.99, "timestamp": "09:01:15", "text": "我們差點就失去了它。"}, {"type": "subtitle", "time": 32491.83, "timestamp": "09:01:31", "text": "該死的。您好，阿魯斯先生。請。"}, {"type": "subtitle", "time": 32501.03, "timestamp": "09:01:41", "text": "走吧。不，該死。"}, {"type": "subtitle", "time": 32507.83, "timestamp": "09:01:47", "text": "一個從中間穿過。他看向了別處。他看向了別處。中場"}, {"type": "subtitle", "time": 32515.23, "timestamp": "09:01:55", "text": "中場一個。"}]
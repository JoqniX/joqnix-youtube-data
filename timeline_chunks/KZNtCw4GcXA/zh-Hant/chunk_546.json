[{"type": "subtitle", "time": 32761.19, "timestamp": "09:06:01", "text": "靈魂。你這可憐的人兒。"}, {"type": "subtitle", "time": 32764.628, "timestamp": "09:06:04", "text": "可憐的人兒。不，"}, {"type": "subtitle", "time": 32769.19, "timestamp": "09:06:09", "text": "他是個心軟的孩子，但他還是死了。"}, {"type": "subtitle", "time": 32774.068, "timestamp": "09:06:14", "text": "喬克先生。是的。喬克先生。是的。我"}, {"type": "subtitle", "time": 32778.31, "timestamp": "09:06:18", "text": "希望你跟我一起去。是的。跟我走。好的"}, {"type": "subtitle", "time": 32784.95, "timestamp": "09:06:24", "text": "。跟我來。跟你一起來。  好的。  是的。"}, {"type": "subtitle", "time": 32787.67, "timestamp": "09:06:27", "text": "之後我會往左走。好的。  丟完閃光燈後，"}, {"type": "subtitle", "time": 32796.868, "timestamp": "09:06:36", "text": "在左側。"}, {"type": "subtitle", "time": 32804.79, "timestamp": "09:06:44", "text": "我的生命中需要P Chan。我需要P90。沒有"}, {"type": "subtitle", "time": 32812.868, "timestamp": "09:06:52", "text": "沒錯。"}]
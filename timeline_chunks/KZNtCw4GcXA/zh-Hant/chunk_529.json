[{"type": "subtitle", "time": 31740.91, "timestamp": "08:49:00", "text": "跳。我正在嘗試走路。來"}, {"type": "subtitle", "time": 31744.628, "timestamp": "08:49:04", "text": "追我啊。我的天啊。我沒想到他會在"}, {"type": "subtitle", "time": 31748.99, "timestamp": "08:49:08", "text": "那裡。該死。啞口無言"}, {"type": "subtitle", "time": 31753.468, "timestamp": "08:49:13", "text": "。我的天啊。真是愚蠢。真是"}, {"type": "subtitle", "time": 31755.91, "timestamp": "08:49:15", "text": "愚蠢。我的天啊。開個"}, {"type": "subtitle", "time": 31772.15, "timestamp": "08:49:32", "text": "我喜歡，我怪罪傑克。  我的天啊"}, {"type": "subtitle", "time": 31778.23, "timestamp": "08:49:38", "text": "我也怪他。傑克，這都是你的"}, {"type": "subtitle", "time": 31779.75, "timestamp": "08:49:39", "text": "錯。"}, {"type": "subtitle", "time": 31785.35, "timestamp": "08:49:45", "text": "哦，不錯。感覺就像身處戰爭之中。"}, {"type": "subtitle", "time": 31796.868, "timestamp": "08:49:56", "text": "釋放煙霧。"}]
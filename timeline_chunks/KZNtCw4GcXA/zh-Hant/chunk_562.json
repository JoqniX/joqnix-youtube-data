[{"type": "subtitle", "time": 33720.55, "timestamp": "09:22:00", "text": "恐怖分子獲勝。第一槍是警告射擊。第二個是擊殺。  不要來這裡。"}, {"type": "subtitle", "time": 33723.586, "timestamp": "09:22:03", "text": "他來了。"}, {"type": "subtitle", "time": 33729.67, "timestamp": "09:22:09", "text": "好了，我玩得夠多了。  我們走吧。我們走吧。  哦，就只有聊天嗎？這是威脅嗎？  是的。哦，找到了。他們"}, {"type": "subtitle", "time": 33748.63, "timestamp": "09:22:28", "text": "站在他身上。展現你的"}, {"type": "subtitle", "time": 33750.39, "timestamp": "09:22:30", "text": "主導地位。  我不。"}, {"type": "subtitle", "time": 33755.35, "timestamp": "09:22:35", "text": "他會佔據主導地位。好的。  我們"}, {"type": "subtitle", "time": 33758.59, "timestamp": "09:22:38", "text": "走吧。啊，不錯。"}, {"type": "subtitle", "time": 33767.83, "timestamp": "09:22:47", "text": "我有個絕妙的主意。"}, {"type": "subtitle", "time": 33770.87, "timestamp": "09:22:50", "text": "一枚炸彈。"}, {"type": "subtitle", "time": 33772.71, "timestamp": "09:22:52", "text": "我看著我們的紫色，就像在"}, {"type": "subtitle", "time": 33775.03, "timestamp": "09:22:55", "text": "努力一樣，老兄。他用"}]
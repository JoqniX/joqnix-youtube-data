[{"type": "subtitle", "time": 33424.95, "timestamp": "09:17:04", "text": "向左走，然後一直直走。"}, {"type": "subtitle", "time": 33427.51, "timestamp": "09:17:07", "text": "是的，繼續。好了。好了。順便說一句，"}, {"type": "subtitle", "time": 33430.388, "timestamp": "09:17:10", "text": "左邊還有更多。"}, {"type": "subtitle", "time": 33432.67, "timestamp": "09:17:12", "text": "更多內容請看"}, {"type": "subtitle", "time": 33436.47, "timestamp": "09:17:16", "text": "左側。向左轉。對，沒錯。好的。左邊。  直的。直的。直的。好了。"}, {"type": "subtitle", "time": 33442.868, "timestamp": "09:17:22", "text": "反恐部隊獲勝。沒關係。"}, {"type": "subtitle", "time": 33445.35, "timestamp": "09:17:25", "text": "沒關係。她正在學習。他會處理的。"}, {"type": "subtitle", "time": 33448.548, "timestamp": "09:17:28", "text": "你做得很好。別讓他再說下去了"}, {"type": "subtitle", "time": 33450.868, "timestamp": "09:17:30", "text": "。這就是他為什麼不願意"}, {"type": "subtitle", "time": 33454.228, "timestamp": "09:17:34", "text": "跟我說話的原因。但你不該聽"}, {"type": "subtitle", "time": 33456.63, "timestamp": "09:17:36", "text": "他的。不要聽他的。不要聽他的。"}, {"type": "subtitle", "time": 33457.99, "timestamp": "09:17:37", "text": "賣掉它。拍一張"}, {"type": "subtitle", "time": 33460.79, "timestamp": "09:17:40", "text": "照片。相信自己。賣掉它。相信"}, {"type": "subtitle", "time": 33463.51, "timestamp": "09:17:43", "text": "自己。聽我說。聽我說。"}, {"type": "subtitle", "time": 33465.428, "timestamp": "09:17:45", "text": "賣掉它。賣掉它。聽聽你"}, {"type": "subtitle", "time": 33468.548, "timestamp": "09:17:48", "text": "自己的想法。不要賣掉它。不要賣掉它。"}, {"type": "subtitle", "time": 33470.868, "timestamp": "09:17:50", "text": "聽聽你自己的想法。為什麼要出賣"}, {"type": "subtitle", "time": 33474.388, "timestamp": "09:17:54", "text": "自己？要純潔。"}, {"type": "subtitle", "time": 33476.95, "timestamp": "09:17:56", "text": "你。好的。"}, {"type": "subtitle", "time": 33478.868, "timestamp": "09:17:58", "text": "賣掉你的武器。賣掉你的武器。"}]
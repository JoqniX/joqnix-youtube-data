[{"type": "subtitle", "time": 31878.59, "timestamp": "08:51:18", "text": "有照片嗎？好的。"}, {"type": "subtitle", "time": 31882.548, "timestamp": "08:51:22", "text": "旋轉。我喜歡《"}, {"type": "subtitle", "time": 31885.27, "timestamp": "08:51:25", "text": "你聞到什麼了嗎？ 》你聞到味道了嗎？是的，"}, {"type": "subtitle", "time": 31904.27, "timestamp": "08:51:44", "text": "哦，他在右邊那份拷貝裡。"}, {"type": "subtitle", "time": 31914.19, "timestamp": "08:51:54", "text": "這麼多"}, {"type": "subtitle", "time": 31916.708, "timestamp": "08:51:56", "text": "燃燒瓶。我們有炸彈。別他媽"}]
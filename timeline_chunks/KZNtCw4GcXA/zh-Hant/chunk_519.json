[{"type": "subtitle", "time": 31144.708, "timestamp": "08:39:04", "text": "別忘了買裝備。不。哦，好的。  有件事。哦，是的。  我的天哪。我"}, {"type": "subtitle", "time": 31154.23, "timestamp": "08:39:14", "text": "拒絕購買任何工具包。如果我死了，我就從你的屍體上把它撿起來。如果"}, {"type": "subtitle", "time": 31160.23, "timestamp": "08:39:20", "text": "你死了，我可能也會先死。"}, {"type": "subtitle", "time": 31164.308, "timestamp": "08:39:24", "text": "放下煙霧。是的，我知道。  再次旋轉。我不"}, {"type": "subtitle", "time": 31166.868, "timestamp": "08:39:26", "text": "認為現在會有人離開。"}, {"type": "subtitle", "time": 31175.308, "timestamp": "08:39:35", "text": "哦，他是…？騎師，"}, {"type": "subtitle", "time": 31178.628, "timestamp": "08:39:38", "text": "你還好嗎？我的天哪。沒關係。"}, {"type": "subtitle", "time": 31190.03, "timestamp": "08:39:50", "text": "正在穿越"}, {"type": "subtitle", "time": 31192.708, "timestamp": "08:39:52", "text": "中場。他們可能已經在A區了。  是的，我在輪換"}]
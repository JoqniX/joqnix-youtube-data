[{"type": "subtitle", "time": 29521.23, "timestamp": "08:12:01", "text": "加油，"}, {"type": "subtitle", "time": 29524.15, "timestamp": "08:12:04", "text": "喬克。抓緊時間。抓緊時間。你贏了。  相信。在你右邊。"}, {"type": "subtitle", "time": 29534.628, "timestamp": "08:12:14", "text": "哦，他們就在你的右邊"}, {"type": "subtitle", "time": 29536.15, "timestamp": "08:12:16", "text": "。傑克，你右邊那位。  啊，是三個人。"}, {"type": "subtitle", "time": 29539.23, "timestamp": "08:12:19", "text": "不。是的。不，不。啊，該死。  好的。呃，"}, {"type": "subtitle", "time": 29542.708, "timestamp": "08:12:22", "text": "你們有錢嗎？"}, {"type": "subtitle", "time": 29545.03, "timestamp": "08:12:25", "text": "不，對不起。我明明身無分文，卻還在"}, {"type": "subtitle", "time": 29567.628, "timestamp": "08:12:47", "text": "反正"}]
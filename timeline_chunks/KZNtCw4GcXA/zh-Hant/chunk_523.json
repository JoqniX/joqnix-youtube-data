[{"type": "subtitle", "time": 31384.388, "timestamp": "08:43:04", "text": "哦，他們在推擠。不，他們拿到了。不，"}, {"type": "subtitle", "time": 31386.12, "timestamp": "08:43:06", "text": "不， 這次我們已經看到了。哦，等等。我忘了。我們"}, {"type": "subtitle", "time": 31390.08, "timestamp": "08:43:10", "text": "這次我們已經看到了。哦，等等。我忘了。我們 需要計時工具嗎？抽煙。"}, {"type": "subtitle", "time": 31413.99, "timestamp": "08:43:33", "text": "我什麼也沒看到。人們。哦，"}, {"type": "subtitle", "time": 31416.23, "timestamp": "08:43:36", "text": "他來了。他媽的。他已經到了。"}, {"type": "subtitle", "time": 31420.07, "timestamp": "08:43:40", "text": "人們通常會在新的地方剪頭髮嗎？"}, {"type": "subtitle", "time": 31431.51, "timestamp": "08:43:51", "text": "好的。唯一"}, {"type": "subtitle", "time": 31434.07, "timestamp": "08:43:54", "text": "不錯的選擇是：走吧。"}, {"type": "subtitle", "time": 31436.788, "timestamp": "08:43:56", "text": "我唯一一次被"}, {"type": "subtitle", "time": 31439.11, "timestamp": "08:43:59", "text": "狙擊，或者說我唯一一次被狙擊的經歷，是為了"}]
[{"type": "subtitle", "time": 13685.15, "timestamp": "03:48:05", "text": "那些，希望你"}, {"type": "subtitle", "time": 13687.83, "timestamp": "03:48:07", "text": "今天過得愉快。希望你今天過得愉快"}, {"type": "subtitle", "time": 13689.75, "timestamp": "03:48:09", "text": "。謝謝你的陪伴"}, {"type": "subtitle", "time": 13692.71, "timestamp": "03:48:12", "text": "。謝謝你也來。謝謝。"}, {"type": "subtitle", "time": 13699.429, "timestamp": "03:48:19", "text": "希望你今天過得愉快。忍者，謝謝你的光臨。  希望你今天過得愉快。現在是卡瑪。  感謝你們的耐心"}, {"type": "subtitle", "time": 13701.429, "timestamp": "03:48:21", "text": "等待和所有幫助。您的光臨對我意義"}, {"type": "subtitle", "time": 13707.55, "timestamp": "03:48:27", "text": "重大。希望你"}, {"type": "subtitle", "time": 13713.83, "timestamp": "03:48:33", "text": "今天過得愉快。非常非常感謝。 Celestia 和 Vic，謝謝你們今天陪伴我。我玩得很"}, {"type": "subtitle", "time": 13716.07, "timestamp": "03:48:36", "text": "開心。我非常期待與"}, {"type": "subtitle", "time": 13718.79, "timestamp": "03:48:38", "text": "你們的這兩次合作。顯然，"}, {"type": "subtitle", "time": 13725.11, "timestamp": "03:48:45", "text": "今天是我和Celestia的第一次正式合作。"}, {"type": "subtitle", "time": 13728.229, "timestamp": "03:48:48", "text": "不，我們是"}, {"type": "subtitle", "time": 13730.91, "timestamp": "03:48:50", "text": "在她頻道上合作拍攝高爾夫合作影片的"}, {"type": "subtitle", "time": 13733.75, "timestamp": "03:48:53", "text": "。是的。是的。但這就像是"}, {"type": "subtitle", "time": 13736.429, "timestamp": "03:48:56", "text": "第一種正式的"}, {"type": "subtitle", "time": 13738.269, "timestamp": "03:48:58", "text": "模式。"}]
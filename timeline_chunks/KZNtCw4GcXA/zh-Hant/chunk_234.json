[{"type": "subtitle", "time": 14042.03, "timestamp": "03:54:02", "text": "塞萊斯蒂亞和維克。希望您喜歡這次"}, {"type": "subtitle", "time": 14045.189, "timestamp": "03:54:05", "text": "合作。是的。是的。是的。但請不要"}, {"type": "subtitle", "time": 14048.309, "timestamp": "03:54:08", "text": "擔心。不用擔心。"}, {"type": "subtitle", "time": 14051.83, "timestamp": "03:54:11", "text": "未來還會有合作，到時候我會"}, {"type": "subtitle", "time": 14055.55, "timestamp": "03:54:15", "text": "和他們兩個一起玩。所以，"}, {"type": "subtitle", "time": 14060.309, "timestamp": "03:54:20", "text": "沒關係。你好。是的。僅此而已。我"}, {"type": "subtitle", "time": 14062.189, "timestamp": "03:54:22", "text": "不想讓"}, {"type": "subtitle", "time": 14064.75, "timestamp": "03:54:24", "text": "這件事繼續拖延下去。或者，"}, {"type": "subtitle", "time": 14067.349, "timestamp": "03:54:27", "text": "你知道嗎？我還是等"}, {"type": "subtitle", "time": 14069.75, "timestamp": "03:54:29", "text": "網路恢復後再說。好的。這比"}, {"type": "subtitle", "time": 14072.07, "timestamp": "03:54:32", "text": "繼續下去要"}, {"type": "subtitle", "time": 14074.79, "timestamp": "03:54:34", "text": "好得多。是的。是的。是的。我"}, {"type": "subtitle", "time": 14077.189, "timestamp": "03:54:37", "text": "今天的網路不太好。所以，呃，我"}, {"type": "subtitle", "time": 14079.03, "timestamp": "03:54:39", "text": "不知道"}, {"type": "subtitle", "time": 14081.269, "timestamp": "03:54:41", "text": "明天能不能直播。明天就只是"}, {"type": "subtitle", "time": 14083.269, "timestamp": "03:54:43", "text": "哥哥唱歌直播。我不知道自己能不能"}, {"type": "subtitle", "time": 14093.189, "timestamp": "03:54:53", "text": "拭目以待吧。讓我們來看看。哦，是的。總之，"}, {"type": "subtitle", "time": 14094.87, "timestamp": "03:54:54", "text": "謝謝大家的光臨。"}]
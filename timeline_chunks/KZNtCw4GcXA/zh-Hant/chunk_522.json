[{"type": "subtitle", "time": 31334.788, "timestamp": "08:42:14", "text": "我會盡量不讓他"}, {"type": "subtitle", "time": 31336.548, "timestamp": "08:42:16", "text": "過去。  哦。  哦，有嗎？"}, {"type": "subtitle", "time": 31347.19, "timestamp": "08:42:27", "text": "是的。我身後。"}, {"type": "subtitle", "time": 31354.07, "timestamp": "08:42:34", "text": "那裡。他們仍然持有那個。"}, {"type": "subtitle", "time": 31356.468, "timestamp": "08:42:36", "text": "投擲閃光燈。"}]
[{"type": "subtitle", "time": 18842.11, "timestamp": "05:14:02", "text": "我沒辦法完成作業。我花錢請人做的。"}, {"type": "subtitle", "time": 18880.67, "timestamp": "05:14:40", "text": "快遞吧。是的，那很好。  那真是太棒了。  好的。提交截止日期為"}, {"type": "subtitle", "time": 18884.11, "timestamp": "05:14:44", "text": "4月28日。那就像星期二一樣，對吧？那是星期一。哦，星期一"}, {"type": "subtitle", "time": 18895.99, "timestamp": "05:14:55", "text": "是最後期限。我的天哪。哦，星期一是最後期限。  聖。我周一得去把它送過去。哦，我剛剛才意識到星期一我有音樂課。"}, {"type": "subtitle", "time": 18898.948, "timestamp": "05:14:58", "text": "我不能錯過。"}]
[{"type": "subtitle", "time": 31921.35, "timestamp": "08:52:01", "text": "現在就追他，Jockey。好的。"}, {"type": "subtitle", "time": 31924.388, "timestamp": "08:52:04", "text": "你只需要在這裡等著，"}, {"type": "subtitle", "time": 31937.27, "timestamp": "08:52:17", "text": "等待。喬克。好的。"}, {"type": "subtitle", "time": 31946.23, "timestamp": "08:52:26", "text": "我們只需要等待。想像一下如果是"}, {"type": "subtitle", "time": 31949.11, "timestamp": "08:52:29", "text": "從後面襲來的。我的天哪。他會從哪裡"}, {"type": "subtitle", "time": 31951.51, "timestamp": "08:52:31", "text": "反撲？"}, {"type": "subtitle", "time": 31959.99, "timestamp": "08:52:39", "text": "我看到一個玩笑般的動作，目的是為了"}, {"type": "subtitle", "time": 31973.308, "timestamp": "08:52:53", "text": "知道他們做了什麼嗎？他們放棄了。"}, {"type": "subtitle", "time": 31974.91, "timestamp": "08:52:54", "text": "哇哦。"}, {"type": "subtitle", "time": 31978.388, "timestamp": "08:52:58", "text": "記住，這裡是匪徒橫行的地盤。射殺"}]
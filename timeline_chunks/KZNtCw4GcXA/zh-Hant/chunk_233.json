[{"type": "subtitle", "time": 13985.59, "timestamp": "03:53:05", "text": "直播。是的。是的。是的。唉，我想睡覺，但又不想睡，因為睡著後它又復發了。我就像，嗨，SL。然後回來後就想，我想直播，但又不想"}, {"type": "subtitle", "time": 13997.55, "timestamp": "03:53:17", "text": "新的變化正在"}, {"type": "subtitle", "time": 14002.63, "timestamp": "03:53:22", "text": "緩慢地發生。變化不算太大。  就是那種"}, {"type": "subtitle", "time": 14005.189, "timestamp": "03:53:25", "text": "慢慢來的事情。"}, {"type": "subtitle", "time": 14007.99, "timestamp": "03:53:27", "text": "會有很多合作項目。"}, {"type": "subtitle", "time": 14010.07, "timestamp": "03:53:30", "text": "十一月，我不知道我是否會"}, {"type": "subtitle", "time": 14013.269, "timestamp": "03:53:33", "text": "經常直播，因為"}, {"type": "subtitle", "time": 14015.99, "timestamp": "03:53:35", "text": "考試之類的事情會發生。所以，"}, {"type": "subtitle", "time": 14017.87, "timestamp": "03:53:37", "text": "我會盡力"}, {"type": "subtitle", "time": 14021.389, "timestamp": "03:53:41", "text": "管理好直播和其他所有事情，"}, {"type": "subtitle", "time": 14024.15, "timestamp": "03:53:44", "text": "看看效果如何。好的。所以我就在"}, {"type": "subtitle", "time": 14026.79, "timestamp": "03:53:46", "text": "這裡把它包起來吧。我"}, {"type": "subtitle", "time": 14029.349, "timestamp": "03:53:49", "text": "只想說，謝謝大家的"}, {"type": "subtitle", "time": 14032.389, "timestamp": "03:53:52", "text": "光臨。即使遇到技術"}, {"type": "subtitle", "time": 14035.389, "timestamp": "03:53:55", "text": "問題也沒關係。重要的"}, {"type": "subtitle", "time": 14038.87, "timestamp": "03:53:58", "text": "是你們支持了另外兩位，"}]
[{"type": "subtitle", "time": 13620.07, "timestamp": "03:47:00", "text": "。對於那些不知道的人來說，我"}, {"type": "subtitle", "time": 13623.63, "timestamp": "03:47:03", "text": "給了 hush 這次直播的臨時管理員權限，"}, {"type": "subtitle", "time": 13626.429, "timestamp": "03:47:06", "text": "因為我覺得"}, {"type": "subtitle", "time": 13632.79, "timestamp": "03:47:12", "text": "現在有必要這麼做。但別擔心。呃，他只是個"}, {"type": "subtitle", "time": 13635.83, "timestamp": "03:47:15", "text": "臨時模式。想像一下如果他當選"}, {"type": "subtitle", "time": 13646.469, "timestamp": "03:47:26", "text": "啊，因為我根本沒時間，因為"}, {"type": "subtitle", "time": 13648.55, "timestamp": "03:47:28", "text": "我當時還在速通"}, {"type": "subtitle", "time": 13651.11, "timestamp": "03:47:31", "text": "其他東西。我原本應該"}, {"type": "subtitle", "time": 13654.87, "timestamp": "03:47:34", "text": "修改一下聊天規則和"}, {"type": "subtitle", "time": 13658.229, "timestamp": "03:47:38", "text": "聊天板之類的東西，讓每個"}, {"type": "subtitle", "time": 13660.79, "timestamp": "03:47:40", "text": "來的人都仔細查看"}, {"type": "subtitle", "time": 13663.349, "timestamp": "03:47:43", "text": "直播聊天規則，不要"}, {"type": "subtitle", "time": 13664.87, "timestamp": "03:47:44", "text": "違反規則等等。我本來應該"}, {"type": "subtitle", "time": 13667.91, "timestamp": "03:47:47", "text": "要做那件事，但我真的"}, {"type": "subtitle", "time": 13670.309, "timestamp": "03:47:50", "text": "時間不夠了。合作之類的活動已經進行到一半了。"}, {"type": "subtitle", "time": 13673.229, "timestamp": "03:47:53", "text": "所以我"}, {"type": "subtitle", "time": 13676.15, "timestamp": "03:47:56", "text": "無法理解我為什麼討厭她追逐我的樣子。哦，"}]
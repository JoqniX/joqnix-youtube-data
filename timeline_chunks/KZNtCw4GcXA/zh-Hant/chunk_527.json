[{"type": "subtitle", "time": 31625.91, "timestamp": "08:47:05", "text": "你知道炸彈在哪兒，對吧？是的。"}, {"type": "subtitle", "time": 31632.628, "timestamp": "08:47:12", "text": "你可以去那裡。  對"}, {"type": "subtitle", "time": 31640.43, "timestamp": "08:47:20", "text": "這裡過來。"}, {"type": "subtitle", "time": 31648.708, "timestamp": "08:47:28", "text": "哦，炸彈已經沒了。哦，"}, {"type": "subtitle", "time": 31651.11, "timestamp": "08:47:31", "text": "他就在這裡。把它種下。把它種下。"}, {"type": "subtitle", "time": 31652.07, "timestamp": "08:47:32", "text": "等待。你還有時間。你還有時間。你還有時間。"}, {"type": "subtitle", "time": 31654.318, "timestamp": "08:47:34", "text": "你還有時間。 他會很接近的。左邊。關閉。左邊。  是的"}, {"type": "subtitle", "time": 31668.27, "timestamp": "08:47:48", "text": "他到底在哪裡？他很可能是幕後"}]
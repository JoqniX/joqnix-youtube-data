[{"type": "subtitle", "time": 33001.112, "timestamp": "09:10:01", "text": "？哦，這裡有"}, {"type": "subtitle", "time": 33004.228, "timestamp": "09:10:04", "text": "個人。有個男的。"}, {"type": "subtitle", "time": 33030.31, "timestamp": "09:10:30", "text": "哦，不錯。  哦，他沒時間。是嗎"}, {"type": "subtitle", "time": 33035.03, "timestamp": "09:10:35", "text": "？沒有。他有票，但沒時間了。"}, {"type": "subtitle", "time": 33038.79, "timestamp": "09:10:38", "text": "兄弟，那才0.1秒而已。"}, {"type": "subtitle", "time": 33040.31, "timestamp": "09:10:40", "text": "我應該再往後退一點。我"}, {"type": "subtitle", "time": 33042.748, "timestamp": "09:10:42", "text": "應該再往後退一點。"}, {"type": "subtitle", "time": 33051.908, "timestamp": "09:10:51", "text": "另外，如果你跑步時仔細觀察，你會發現"}, {"type": "subtitle", "time": 33053.51, "timestamp": "09:10:53", "text": "小地圖上有一個圓"}, {"type": "subtitle", "time": 33057.19, "timestamp": "09:10:57", "text": "。你知道那是你的聲音半徑。"}, {"type": "subtitle", "time": 33059.908, "timestamp": "09:10:59", "text": "這說明他們能聽到你的聲音有多遠。"}]
[{"type": "subtitle", "time": 35850.55, "timestamp": "09:57:30", "text": "走吧。好的。  哇，這遊戲真是太刺激了。  笑話先生，你掉了一把AK"}, {"type": "subtitle", "time": 35853.07, "timestamp": "09:57:33", "text": "。我把它給你。他說，讓我來吧。他不需要。  真是個"}, {"type": "subtitle", "time": 35873.23, "timestamp": "09:57:53", "text": "不，不。我忘了我曾經有過……我以為我已經"}, {"type": "subtitle", "time": 35878.31, "timestamp": "09:57:58", "text": "死了。我選A。現在沒人他媽的在A，兄弟。喲，最近怎麼樣？喲，最近怎麼樣？"}]
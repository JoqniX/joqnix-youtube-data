[{"type": "subtitle", "time": 34690.63, "timestamp": "09:38:10", "text": "不要停。不停歇。  不停歇。我到此為止。  那輛車。  繼續前進。約翰，走吧。趕緊他媽的動起來。"}, {"type": "subtitle", "time": 34693.266, "timestamp": "09:38:13", "text": "你竟然把我們兩個都封鎖了。  你不停歇。別"}, {"type": "subtitle", "time": 34699.586, "timestamp": "09:38:19", "text": "他媽的"}, {"type": "subtitle", "time": 34702.71, "timestamp": "09:38:22", "text": "停在"}, {"type": "subtitle", "time": 34706.23, "timestamp": "09:38:26", "text": "路中間。"}]
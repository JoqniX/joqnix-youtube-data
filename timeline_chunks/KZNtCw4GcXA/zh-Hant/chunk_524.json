[{"type": "subtitle", "time": 31442.15, "timestamp": "08:44:02", "text": "什麼？那人……嗯，大白天就死了。不，"}, {"type": "subtitle", "time": 31445.83, "timestamp": "08:44:05", "text": "那條快要斷掉的腿也不行。"}, {"type": "subtitle", "time": 31448.628, "timestamp": "08:44:08", "text": "我憑什麼拿到MVP？不，Dy。 《消逝的"}, {"type": "subtitle", "time": 31451.51, "timestamp": "08:44:11", "text": "光芒》也是。像普通人一樣死去。炸彈存在"}, {"type": "subtitle", "time": 31454.15, "timestamp": "08:44:14", "text": "太久了。沒關係。我不知道。"}, {"type": "subtitle", "time": 31461.91, "timestamp": "08:44:21", "text": "然後就是當時發生的棄屍事件"}, {"type": "subtitle", "time": 31477.99, "timestamp": "08:44:37", "text": "買了一個。我願意犧牲。不用擔心。"}, {"type": "subtitle", "time": 31480.628, "timestamp": "08:44:40", "text": "在左側。"}, {"type": "subtitle", "time": 31483.99, "timestamp": "08:44:43", "text": "我會守住中間位置。"}, {"type": "subtitle", "time": 31486.868, "timestamp": "08:44:46", "text": "嗯，他還能控制住自己。他"}, {"type": "subtitle", "time": 31490.07, "timestamp": "08:44:50", "text": "現在還能控制自己。好吧，我們完蛋了。現在"}, {"type": "subtitle", "time": 31493.51, "timestamp": "08:44:53", "text": "我們只能待在這裡了。"}, {"type": "subtitle", "time": 31495.83, "timestamp": "08:44:55", "text": "有一個。好了，最後一個了"}, {"type": "subtitle", "time": 31498.948, "timestamp": "08:44:58", "text": "。最後一個人就在這裡。"}]
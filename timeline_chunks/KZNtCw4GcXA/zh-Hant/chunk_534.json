[{"type": "subtitle", "time": 32046.948, "timestamp": "08:54:06", "text": "他來自哪裡？好的。在你左邊。如何才能"}, {"type": "subtitle", "time": 32049.83, "timestamp": "08:54:09", "text": "防住"}, {"type": "subtitle", "time": 32053.91, "timestamp": "08:54:13", "text": "這樣的跳投？損毀了。給我。不。該死。"}, {"type": "subtitle", "time": 32065.75, "timestamp": "08:54:25", "text": "他們關係非常親密。不，"}, {"type": "subtitle", "time": 32069.71, "timestamp": "08:54:29", "text": "另一邊的情況更難。"}, {"type": "subtitle", "time": 32075.27, "timestamp": "08:54:35", "text": "小心。這些小伙子們裝備了不少"}, {"type": "subtitle", "time": 32078.708, "timestamp": "08:54:38", "text": "武器，他們也不介意使用。"}, {"type": "subtitle", "time": 32081.308, "timestamp": "08:54:41", "text": "好了，我講完了「出發吧」。我無法集中註意力"}, {"type": "subtitle", "time": 32083.708, "timestamp": "08:54:43", "text": "。部署"}, {"type": "subtitle", "time": 32086.43, "timestamp": "08:54:46", "text": "誘餌。"}, {"type": "subtitle", "time": 32088.548, "timestamp": "08:54:48", "text": "有人要負責中路防守嗎？是的，"}, {"type": "subtitle", "time": 32089.83, "timestamp": "08:54:49", "text": "有人在中路防守。一個中間。一個"}, {"type": "subtitle", "time": 32092.23, "timestamp": "08:54:52", "text": "中間。到中間來。一個中間。一個中間。是的。"}, {"type": "subtitle", "time": 32093.99, "timestamp": "08:54:53", "text": "哦，別走，有個運動員要跟"}]
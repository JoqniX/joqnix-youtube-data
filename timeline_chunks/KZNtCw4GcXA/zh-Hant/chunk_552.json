[{"type": "subtitle", "time": 33120.868, "timestamp": "09:12:00", "text": "這個角度。你們走吧。如果有人"}, {"type": "subtitle", "time": 33123.35, "timestamp": "09:12:03", "text": "想重新定位，那將是徒勞無功的"}, {"type": "subtitle", "time": 33130.268, "timestamp": "09:12:10", "text": "啊，真他媽的。"}, {"type": "subtitle", "time": 33137.112, "timestamp": "09:12:17", "text": "字面意思。我們走吧。 GG。 GG。"}, {"type": "subtitle", "time": 33146.31, "timestamp": "09:12:26", "text": "靶心。  不錯。"}, {"type": "subtitle", "time": 33149.588, "timestamp": "09:12:29", "text": "So So 太棒了。太棒了。"}, {"type": "subtitle", "time": 33153.51, "timestamp": "09:12:33", "text": "試過了。好的。於是他試了試。"}, {"type": "subtitle", "time": 33155.268, "timestamp": "09:12:35", "text": "我很高興。他試過了。這已經足夠了"}, {"type": "subtitle", "time": 33159.51, "timestamp": "09:12:39", "text": "。他可以。他可以。"}, {"type": "subtitle", "time": 33161.79, "timestamp": "09:12:41", "text": "支援敵人閃光彈"}, {"type": "subtitle", "time": 33164.068, "timestamp": "09:12:44", "text": "套裝包。謝謝你給了我這麼"}, {"type": "subtitle", "time": 33168.31, "timestamp": "09:12:48", "text": "爛的皮膚。欣賞頭部。是的。"}, {"type": "subtitle", "time": 33169.908, "timestamp": "09:12:49", "text": "哦耶，我覺得我真的可以把"}, {"type": "subtitle", "time": 33171.63, "timestamp": "09:12:51", "text": "那些"}, {"type": "subtitle", "time": 33175.45, "timestamp": "09:12:55", "text": "皮膚升級了。讓我們來看看。是說"}]
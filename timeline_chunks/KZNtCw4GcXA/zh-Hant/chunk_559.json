[{"type": "subtitle", "time": 33545.588, "timestamp": "09:19:05", "text": "等等，做了什麼？你沒買"}, {"type": "subtitle", "time": 33550.548, "timestamp": "09:19:10", "text": "這就是不買霰彈槍的下場"}, {"type": "subtitle", "time": 33553.388, "timestamp": "09:19:13", "text": "。羞澀如旋律。"}, {"type": "subtitle", "time": 33556.15, "timestamp": "09:19:16", "text": "反恐部隊獲勝。"}, {"type": "subtitle", "time": 33559.586, "timestamp": "09:19:19", "text": "我拒絕購買霰彈槍。"}, {"type": "subtitle", "time": 33562.71, "timestamp": "09:19:22", "text": "等等，我們贏了。哦。哦，也許不是"}, {"type": "subtitle", "time": 33572.15, "timestamp": "09:19:32", "text": "怎麼辦？好了，我有個絕妙的主意。  哦，不，不，不。"}, {"type": "subtitle", "time": 33580.71, "timestamp": "09:19:40", "text": "你去。"}, {"type": "subtitle", "time": 33592.23, "timestamp": "09:19:52", "text": "不。走開"}, {"type": "subtitle", "time": 33596.39, "timestamp": "09:19:56", "text": "。  離開。我會對此感到冒犯"}]
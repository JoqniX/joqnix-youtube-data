[{"type": "subtitle", "time": 30420.708, "timestamp": "08:27:00", "text": "。卡爾瓦在哪裡？"}, {"type": "subtitle", "time": 30436.388, "timestamp": "08:27:16", "text": "該死。我應該在的地方有"}, {"type": "subtitle", "time": 30441.83, "timestamp": "08:27:21", "text": "B媽媽。  如果我死了，別怪我。我試過。不說話。是的。為什麼不說話？我願意。  我？  是的。"}, {"type": "subtitle", "time": 30451.43, "timestamp": "08:27:31", "text": "你好嗎？  炸彈已安放。哦，我們有花盆。"}, {"type": "subtitle", "time": 30453.91, "timestamp": "08:27:33", "text": "我忘了。"}, {"type": "subtitle", "time": 30464.308, "timestamp": "08:27:44", "text": "哦，糟糕。我聽到腳步聲。  最終勝出。哦，"}, {"type": "subtitle", "time": 30466.628, "timestamp": "08:27:46", "text": "該死。  令人震驚。不，"}, {"type": "subtitle", "time": 30468.468, "timestamp": "08:27:48", "text": "我蹲著是因為大家都看見我。但你"}]
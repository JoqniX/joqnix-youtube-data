[{"type": "subtitle", "time": 31501.43, "timestamp": "08:45:01", "text": "在那個角落裡。  是的"}, {"type": "subtitle", "time": 31503.03, "timestamp": "08:45:03", "text": "，我還是先按住這一邊"}, {"type": "subtitle", "time": 31505.11, "timestamp": "08:45:05", "text": "以防萬一。  我的"}, {"type": "subtitle", "time": 31507.99, "timestamp": "08:45:07", "text": "天哪，我根本沒偷看"}, {"type": "subtitle", "time": 31510.59, "timestamp": "08:45:10", "text": "他。我們有"}, {"type": "subtitle", "time": 31513.75, "timestamp": "08:45:13", "text": "炸彈。別再偷看他了。我們有炸彈，"}, {"type": "subtitle", "time": 31516.15, "timestamp": "08:45:16", "text": "兄弟。  他"}, {"type": "subtitle", "time": 31520.15, "timestamp": "08:45:20", "text": "想殺人，夥計。"}, {"type": "subtitle", "time": 31523.868, "timestamp": "08:45:23", "text": "別再自殺了，笑臉。"}, {"type": "subtitle", "time": 31530.58, "timestamp": "08:45:30", "text": "取決於是否有"}, {"type": "subtitle", "time": 31546.628, "timestamp": "08:45:46", "text": "查克尼克，你那肥屁股擋住我的"}, {"type": "subtitle", "time": 31550.468, "timestamp": "08:45:50", "text": "路了。啊，"}, {"type": "subtitle", "time": 31553.15, "timestamp": "08:45:53", "text": "我不介意。我喜歡你肥碩的"}, {"type": "subtitle", "time": 31554.99, "timestamp": "08:45:54", "text": "屁股。"}, {"type": "subtitle", "time": 31558.07, "timestamp": "08:45:58", "text": "哦。哦。"}]
[{"type": "subtitle", "time": 32702.15, "timestamp": "09:05:02", "text": "。我的意思是，這是最後一輪了。"}, {"type": "subtitle", "time": 32706.708, "timestamp": "09:05:06", "text": "哦。哦。哦。嘿。"}, {"type": "subtitle", "time": 32709.11, "timestamp": "09:05:09", "text": "實際上，回去吧。回去。回去。"}, {"type": "subtitle", "time": 32710.708, "timestamp": "09:05:10", "text": "我會守住中間位置。我會守住中間位置。哦，是的。  是的。"}, {"type": "subtitle", "time": 32713.03, "timestamp": "09:05:13", "text": "我們又要開始做愛了。一人"}, {"type": "subtitle", "time": 32715.75, "timestamp": "09:05:15", "text": "守在中間。"}, {"type": "subtitle", "time": 32718.548, "timestamp": "09:05:18", "text": "一個在中間。  快點。"}, {"type": "subtitle", "time": 32725.03, "timestamp": "09:05:25", "text": "。當心。他們"}, {"type": "subtitle", "time": 32727.03, "timestamp": "09:05:27", "text": "可能會"}, {"type": "subtitle", "time": 32738.07, "timestamp": "09:05:38", "text": "他們已經準備好了。  手榴彈已引爆。"}, {"type": "subtitle", "time": 32741.59, "timestamp": "09:05:41", "text": "閃光彈。"}, {"type": "subtitle", "time": 32743.75, "timestamp": "09:05:43", "text": "不，禁止吸煙。"}, {"type": "subtitle", "time": 32746.868, "timestamp": "09:05:46", "text": "哦，不。不，不。不。"}, {"type": "subtitle", "time": 32750.788, "timestamp": "09:05:50", "text": "箱子後面有一個。哦，不。不，我"}, {"type": "subtitle", "time": 32752.628, "timestamp": "09:05:52", "text": "不認為Soul有這個。我覺得"}]
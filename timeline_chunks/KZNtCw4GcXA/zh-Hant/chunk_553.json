[{"type": "subtitle", "time": 33181.35, "timestamp": "09:13:01", "text": "皮膚可以升級嗎？ （笑聲）什麼？是的，"}, {"type": "subtitle", "time": 33183.428, "timestamp": "09:13:03", "text": "你可以用相同"}, {"type": "subtitle", "time": 33185.748, "timestamp": "09:13:05", "text": "稀有度的物品進行一次交易，他們會給你一件"}, {"type": "subtitle", "time": 33189.588, "timestamp": "09:13:09", "text": "其他稀有度的物品。是的。哇。"}, {"type": "subtitle", "time": 33191.51, "timestamp": "09:13:11", "text": "我不玩CS，所以不太"}, {"type": "subtitle", "time": 33194.15, "timestamp": "09:13:14", "text": "了解。"}, {"type": "subtitle", "time": 33201.19, "timestamp": "09:13:21", "text": "我已經沒有多少那種皮膚了"}, {"type": "subtitle", "time": 33202.63, "timestamp": "09:13:22", "text": "。兄弟，你出名了。你的"}, {"type": "subtitle", "time": 33205.79, "timestamp": "09:13:25", "text": "聊天室裡人真多。哇。  哇"}, {"type": "subtitle", "time": 33209.35, "timestamp": "09:13:29", "text": "。出名了，兄弟。我已經一周沒直播了"}, {"type": "subtitle", "time": 33216.068, "timestamp": "09:13:36", "text": "那我覺得你應該要多直播。  是"}, {"type": "subtitle", "time": 33219.112, "timestamp": "09:13:39", "text": "啊，說真的。等你出名了記得跟我打個招呼，兄弟"}, {"type": "subtitle", "time": 33221.908, "timestamp": "09:13:41", "text": "。  兄弟，"}, {"type": "subtitle", "time": 33223.268, "timestamp": "09:13:43", "text": "我們出名了。那不正是"}, {"type": "subtitle", "time": 33237.51, "timestamp": "09:13:57", "text": "出發！出發！  他媽的。"}]
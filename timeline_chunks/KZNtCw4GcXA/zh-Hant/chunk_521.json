[{"type": "subtitle", "time": 31267.99, "timestamp": "08:41:07", "text": "沒有什麼。旋轉。"}, {"type": "subtitle", "time": 31270.27, "timestamp": "08:41:10", "text": "我先守住中間位置以防萬一"}, {"type": "subtitle", "time": 31273.15, "timestamp": "08:41:13", "text": "。以防萬一哪個混蛋想"}, {"type": "subtitle", "time": 31288.67, "timestamp": "08:41:28", "text": "任何人。哦，那裡"}, {"type": "subtitle", "time": 31292.11, "timestamp": "08:41:32", "text": "有 GMA 反恐人員。哦，不錯。  好的。嘿"}, {"type": "subtitle", "time": 31294.27, "timestamp": "08:41:34", "text": "，"}, {"type": "subtitle", "time": 31296.788, "timestamp": "08:41:36", "text": "AK-47。樂高。哦，那是位女士。去他媽的。"}, {"type": "subtitle", "time": 31306.868, "timestamp": "08:41:46", "text": "你知道，我心裡有我的偏好，但無論如何，我的"}, {"type": "subtitle", "time": 31308.15, "timestamp": "08:41:48", "text": "偏好都不會接受我"}, {"type": "subtitle", "time": 31310.308, "timestamp": "08:41:50", "text": "。"}, {"type": "subtitle", "time": 31311.67, "timestamp": "08:41:51", "text": "我不會用這塊"}, {"type": "subtitle", "time": 31313.67, "timestamp": "08:41:53", "text": "AK手錶打任何東西。  沒關係。  這可不好。"}]
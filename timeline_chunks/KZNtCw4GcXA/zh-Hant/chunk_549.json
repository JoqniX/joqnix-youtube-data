[{"type": "subtitle", "time": 32940.95, "timestamp": "09:09:00", "text": "為什麼不去"}, {"type": "subtitle", "time": 32943.588, "timestamp": "09:09:03", "text": "那邊看看呢？快點。去！去！去。靈魂，你"}, {"type": "subtitle", "time": 32946.388, "timestamp": "09:09:06", "text": "可以偷看一眼。走，走，放下。"}, {"type": "subtitle", "time": 32948.79, "timestamp": "09:09:08", "text": "不在那裡。  不在那裡。"}, {"type": "subtitle", "time": 32950.47, "timestamp": "09:09:10", "text": "嗯？出乎意料的是，竟然沒有人。在你"}, {"type": "subtitle", "time": 32953.908, "timestamp": "09:09:13", "text": "右邊。在你右邊。那裡。啊，"}, {"type": "subtitle", "time": 32955.67, "timestamp": "09:09:15", "text": "右邊還有。如果你進去，一定會"}, {"type": "subtitle", "time": 32965.03, "timestamp": "09:09:25", "text": "你不必這麼做。 Ru，你真的不必這麼做"}, {"type": "subtitle", "time": 32982.15, "timestamp": "09:09:42", "text": "抽煙。"}, {"type": "subtitle", "time": 32986.31, "timestamp": "09:09:46", "text": "劣質煙。但我們先來"}, {"type": "subtitle", "time": 32988.31, "timestamp": "09:09:48", "text": "。閃光。第二次閃光。不要"}, {"type": "subtitle", "time": 32990.31, "timestamp": "09:09:50", "text": "推他。只需種下。我已經"}, {"type": "subtitle", "time": 32993.51, "timestamp": "09:09:53", "text": "用霰彈槍越過了邊界。為什麼不"}]
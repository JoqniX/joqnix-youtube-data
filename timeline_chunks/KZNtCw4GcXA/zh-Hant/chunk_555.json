[{"type": "subtitle", "time": 33301.268, "timestamp": "09:15:01", "text": "。哦，該死。"}, {"type": "subtitle", "time": 33314.388, "timestamp": "09:15:14", "text": "我知道我犯了罪，但這並不"}, {"type": "subtitle", "time": 33316.112, "timestamp": "09:15:16", "text": "代表你有權利再槍殺我"}, {"type": "subtitle", "time": 33318.748, "timestamp": "09:15:18", "text": "。"}, {"type": "subtitle", "time": 33322.708, "timestamp": "09:15:22", "text": "阿蘇先生，我知道我是個罪人。好的"}, {"type": "subtitle", "time": 33326.15, "timestamp": "09:15:26", "text": "。  你是個罪人。是的。對了，去買個"}, {"type": "subtitle", "time": 33329.99, "timestamp": "09:15:29", "text": "手榴彈。買一顆手榴彈。不。絕對不行。"}, {"type": "subtitle", "time": 33332.388, "timestamp": "09:15:32", "text": "沒錢。"}, {"type": "subtitle", "time": 33339.03, "timestamp": "09:15:39", "text": "，我很高興。好的，把它放進"}, {"type": "subtitle", "time": 33342.388, "timestamp": "09:15:42", "text": "香蕉裡。沒有。  香蕉。"}, {"type": "subtitle", "time": 33343.908, "timestamp": "09:15:43", "text": "不要把手榴彈丟進香蕉裡。香蕉。"}, {"type": "subtitle", "time": 33346.868, "timestamp": "09:15:46", "text": "他只是想要你的"}, {"type": "subtitle", "time": 33348.79, "timestamp": "09:15:48", "text": "香蕉，兄弟。別讓他得逞。"}, {"type": "subtitle", "time": 33350.47, "timestamp": "09:15:50", "text": "還有，到底是誰又把鮑伯甩了？  該死的"}, {"type": "subtitle", "time": 33355.428, "timestamp": "09:15:55", "text": "。鮑伯在哪裡？  我"}, {"type": "subtitle", "time": 33358.15, "timestamp": "09:15:58", "text": "的天哪，我把自己炸飛了。你在"}]
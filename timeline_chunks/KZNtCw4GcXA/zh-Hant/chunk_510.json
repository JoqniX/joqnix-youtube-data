[{"type": "subtitle", "time": 30600.23, "timestamp": "08:30:00", "text": "波。我一直把他拉回來，這樣他就不會被"}, {"type": "subtitle", "time": 30602.388, "timestamp": "08:30:02", "text": "拋棄。"}, {"type": "subtitle", "time": 30624.388, "timestamp": "08:30:24", "text": "。真糟糕。所有"}, {"type": "subtitle", "time": 30629.27, "timestamp": "08:30:29", "text": "死亡者均為頭部中彈。  標題黨。我真希望我"}, {"type": "subtitle", "time": 30635.91, "timestamp": "08:30:35", "text": "能爆頭或幹掉那些混蛋。真倒霉，兄弟。  好的。我們準備好再來一次了嗎？  我可以加入嗎？"}]
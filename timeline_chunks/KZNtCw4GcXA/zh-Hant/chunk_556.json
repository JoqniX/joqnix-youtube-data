[{"type": "subtitle", "time": 33360.868, "timestamp": "09:16:00", "text": "開玩笑吧？該死。"}, {"type": "subtitle", "time": 33363.428, "timestamp": "09:16:03", "text": "哦。"}, {"type": "subtitle", "time": 33372.228, "timestamp": "09:16:12", "text": "威克！嗯，事情的發展和"}, {"type": "subtitle", "time": 33380.228, "timestamp": "09:16:20", "text": "我喜歡他做的第一件事就是購買"}, {"type": "subtitle", "time": 33383.548, "timestamp": "09:16:23", "text": "盔甲和霰彈槍。  是的，我他媽想幹嘛就幹嘛"}, {"type": "subtitle", "time": 33386.228, "timestamp": "09:16:26", "text": "，"}, {"type": "subtitle", "time": 33389.748, "timestamp": "09:16:29", "text": "兄弟。你阻止不了我。"}, {"type": "subtitle", "time": 33391.19, "timestamp": "09:16:31", "text": "你非得在網路上抱怨嗎"}, {"type": "subtitle", "time": 33406.15, "timestamp": "09:16:46", "text": "東西。喬克，走。你是我的巔峰，兄弟。"}, {"type": "subtitle", "time": 33415.112, "timestamp": "09:16:55", "text": "喬克，我不信任你，我"}, {"type": "subtitle", "time": 33417.748, "timestamp": "09:16:57", "text": "從不偷窺，"}]
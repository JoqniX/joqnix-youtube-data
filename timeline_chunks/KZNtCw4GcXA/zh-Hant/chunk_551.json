[{"type": "subtitle", "time": 33061.99, "timestamp": "09:11:01", "text": "好的。喬克現在對小費有了新的理解"}, {"type": "subtitle", "time": 33065.99, "timestamp": "09:11:05", "text": "。你知道的，謝謝。  是的。"}, {"type": "subtitle", "time": 33067.868, "timestamp": "09:11:07", "text": "好的。誰能幫"}, {"type": "subtitle", "time": 33070.388, "timestamp": "09:11:10", "text": "我看一下？說實話，你可以幫我偷看一眼。"}, {"type": "subtitle", "time": 33072.47, "timestamp": "09:11:12", "text": "正確的。"}, {"type": "subtitle", "time": 33095.268, "timestamp": "09:11:35", "text": "好的。別別別"}, {"type": "subtitle", "time": 33098.47, "timestamp": "09:11:38", "text": "掩護我跳過去。我現在正在輪班"}, {"type": "subtitle", "time": 33105.83, "timestamp": "09:11:45", "text": "F."}, {"type": "subtitle", "time": 33107.51, "timestamp": "09:11:47", "text": "走，走，走。十字，十字，十字，十字。"}, {"type": "subtitle", "time": 33108.47, "timestamp": "09:11:48", "text": "我正在過馬路。我正在過馬路。我正在過"}, {"type": "subtitle", "time": 33109.908, "timestamp": "09:11:49", "text": "馬路。完全失明。只需種下。"}, {"type": "subtitle", "time": 33112.228, "timestamp": "09:11:52", "text": "種植。"}, {"type": "subtitle", "time": 33115.99, "timestamp": "09:11:55", "text": "它直接砸到了我身上。拉屎。哦，不。"}, {"type": "subtitle", "time": 33118.15, "timestamp": "09:11:58", "text": "買了一個。我拿著這個。我堅持"}]
[{"type": "subtitle", "time": 31986.15, "timestamp": "08:53:06", "text": "我還在吃東西。這就是我不怎麼"}, {"type": "subtitle", "time": 31988.388, "timestamp": "08:53:08", "text": "玩遊戲的原因。 Jo，我覺得你不"}, {"type": "subtitle", "time": 31990.23, "timestamp": "08:53:10", "text": "應該用一把 P90 去探頭看中路"}, {"type": "subtitle", "time": 31998.07, "timestamp": "08:53:18", "text": "這裡有一個。這裡有兩個。我得到了一個。"}, {"type": "subtitle", "time": 31999.99, "timestamp": "08:53:19", "text": "他們可能會越界到A。我"}, {"type": "subtitle", "time": 32005.67, "timestamp": "08:53:25", "text": "的天哪。或許如此。我正在準備"}, {"type": "subtitle", "time": 32009.03, "timestamp": "08:53:29", "text": "生火。  目前"}, {"type": "subtitle", "time": 32012.708, "timestamp": "08:53:32", "text": "尚未出現高峰。  是的"}, {"type": "subtitle", "time": 32019.27, "timestamp": "08:53:39", "text": "Soul應該可以應付得了"}, {"type": "subtitle", "time": 32023.11, "timestamp": "08:53:43", "text": "，對吧？是的。好的，明白了。我"}, {"type": "subtitle", "time": 32037.35, "timestamp": "08:53:57", "text": "的天啊。你怎麼能聞起來這麼"}, {"type": "subtitle", "time": 32039.35, "timestamp": "08:53:59", "text": "難聞？我聞到一股濃濃的異味。我聞到一股很濃的氣味。"}]
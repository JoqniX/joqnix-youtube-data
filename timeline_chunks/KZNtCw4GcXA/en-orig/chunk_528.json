[{"type": "subtitle", "time": 31691.15, "timestamp": "08:48:11", "text": "Zam. He got an ace."}, {"type": "subtitle", "time": 31701.35, "timestamp": "08:48:21", "text": "Jo. I'm not trusting you anymore. more."}, {"type": "subtitle", "time": 31703.43, "timestamp": "08:48:23", "text": "No more trust."}, {"type": "subtitle", "time": 31711.27, "timestamp": "08:48:31", "text": "I'm innocent."}, {"type": "subtitle", "time": 31713.27, "timestamp": "08:48:33", "text": "You're not."}, {"type": "subtitle", "time": 31722.23, "timestamp": "08:48:42", "text": "Any signs of them there? Yep. All right."}, {"type": "subtitle", "time": 31724.51, "timestamp": "08:48:44", "text": "There's the"}, {"type": "subtitle", "time": 31728.868, "timestamp": "08:48:48", "text": "signs. There's the signs right there."}, {"type": "subtitle", "time": 31731.35, "timestamp": "08:48:51", "text": "on the left one."}, {"type": "subtitle", "time": 31734.27, "timestamp": "08:48:54", "text": "Oh my god, that was good. You guys good?"}, {"type": "subtitle", "time": 31736.35, "timestamp": "08:48:56", "text": "Jock, don't"}]
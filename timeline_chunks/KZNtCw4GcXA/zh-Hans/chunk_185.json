[{"type": "subtitle", "time": 11100.87, "timestamp": "03:05:00", "text": "等等，里面有人吗？先生，我会"}, {"type": "subtitle", "time": 11102.71, "timestamp": "03:05:02", "text": "我马上回来。我这就读。"}, {"type": "subtitle", "time": 11106.07, "timestamp": "03:05:06", "text": "简单说说关于鬼魂的事。好的。哦。"}, {"type": "subtitle", "time": 11108.79, "timestamp": "03:05:08", "text": "哦，你必须那样做。哦，没事了。"}, {"type": "subtitle", "time": 11110.87, "timestamp": "03:05:10", "text": "我只是贴着墙走，就为了喜欢它。"}, {"type": "subtitle", "time": 11113.03, "timestamp": "03:05:13", "text": "案件。这是正常现象。这是正常现象。我的"}, {"type": "subtitle", "time": 11117.83, "timestamp": "03:05:17", "text": "双手在颤抖。我的眼睛是"}, {"type": "subtitle", "time": 11121.59, "timestamp": "03:05:21", "text": "我的名字是芭芭拉。"}, {"type": "subtitle", "time": 11123.15, "timestamp": "03:05:23", "text": "好的。是的。"}, {"type": "subtitle", "time": 11126.95, "timestamp": "03:05:26", "text": "芭芭拉·巴巴德。我的天啊。她是一个"}, {"type": "subtitle", "time": 11129.11, "timestamp": "03:05:29", "text": "一位治疗师。她还不错。"}, {"type": "subtitle", "time": 11133.15, "timestamp": "03:05:33", "text": "治疗师。是的。我很害怕。"}, {"type": "subtitle", "time": 11135.75, "timestamp": "03:05:35", "text": "你好。你能进那个房间吗？感谢"}, {"type": "subtitle", "time": 11138.87, "timestamp": "03:05:38", "text": "你。我们需要"}, {"type": "subtitle", "time": 11140.79, "timestamp": "03:05:40", "text": "目击鬼魂的人和其中一人"}, {"type": "subtitle", "time": 11143.269, "timestamp": "03:05:43", "text": "让他们逃离鬼魂"}, {"type": "subtitle", "time": 11147.91, "timestamp": "03:05:47", "text": "采集电磁场读数信号。"}, {"type": "subtitle", "time": 11152.79, "timestamp": "03:05:52", "text": "是的。你好。欢迎。欢迎。是的。是的。"}, {"type": "subtitle", "time": 11154.07, "timestamp": "03:05:54", "text": "好的。你能进去吗？"}, {"type": "subtitle", "time": 11155.59, "timestamp": "03:05:55", "text": "请问哪里可以去洗手间？非常感谢。"}, {"type": "subtitle", "time": 11157.83, "timestamp": "03:05:57", "text": "呃，请展示一下你的手电筒。"}]
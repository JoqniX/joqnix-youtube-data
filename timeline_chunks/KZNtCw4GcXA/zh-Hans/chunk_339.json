[{"type": "subtitle", "time": 20345.27, "timestamp": "05:39:05", "text": "后退。是啊，我脑子里装了好多东西。"}, {"type": "subtitle", "time": 20348.23, "timestamp": "05:39:08", "text": "现在。我可能脑子里一片混乱。"}, {"type": "subtitle", "time": 20349.39, "timestamp": "05:39:09", "text": "别介意"}, {"type": "subtitle", "time": 20352.23, "timestamp": "05:39:12", "text": "我。呃，不过谢谢你让我唠叨几句。"}, {"type": "subtitle", "time": 20353.788, "timestamp": "05:39:13", "text": "它"}, {"type": "subtitle", "time": 20359.75, "timestamp": "05:39:19", "text": "出去。畅所欲言。我正在使用新的点赞功能"}, {"type": "subtitle", "time": 20367.788, "timestamp": "05:39:27", "text": "我使用的是Z世代的词汇。"}, {"type": "subtitle", "time": 20369.04, "timestamp": "05:39:29", "text": "哇。"}, {"type": "subtitle", "time": 20371.628, "timestamp": "05:39:31", "text": "[音乐]"}, {"type": "subtitle", "time": 20374.868, "timestamp": "05:39:34", "text": "该死。我其实用的是Jenz的词。"}, {"type": "subtitle", "time": 20398.07, "timestamp": "05:39:58", "text": "每个人都在做自己想做的事。"}]
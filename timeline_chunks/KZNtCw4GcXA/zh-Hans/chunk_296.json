[{"type": "subtitle", "time": 17760.708, "timestamp": "04:56:00", "text": "天。是啊，但是你知道吗？很有趣。"}, {"type": "subtitle", "time": 17777.19, "timestamp": "04:56:17", "text": "它。现在你可以看到我正向上游走，就在右上方。"}, {"type": "subtitle", "time": 17780.03, "timestamp": "04:56:20", "text": "现在。比特率很好。这是在"}, {"type": "subtitle", "time": 17784.47, "timestamp": "04:56:24", "text": "1.00千伏秒。哇。最低比特率"}, {"type": "subtitle", "time": 17786.59, "timestamp": "04:56:26", "text": "是为我准备的。"}, {"type": "subtitle", "time": 17789.75, "timestamp": "04:56:29", "text": "好的。我终于可以说话了。我希望我是"}, {"type": "subtitle", "time": 17793.11, "timestamp": "04:56:33", "text": "可听见的。我真的"}, {"type": "subtitle", "time": 17797.11, "timestamp": "04:56:37", "text": "呃，所以，呃，对于那些来这里的人来说……"}, {"type": "subtitle", "time": 17804.39, "timestamp": "04:56:44", "text": "对不起。所以我不知道发生了什么。我的"}, {"type": "subtitle", "time": 17807.99, "timestamp": "04:56:47", "text": "互联网已死，可以说浏览器"}, {"type": "subtitle", "time": 17809.83, "timestamp": "04:56:49", "text": "一切都显示绿灯，就像……"}, {"type": "subtitle", "time": 17813.59, "timestamp": "04:56:53", "text": "就好像它运行正常一样。"}, {"type": "subtitle", "time": 17816.59, "timestamp": "04:56:56", "text": "没有错误，但没有"}]
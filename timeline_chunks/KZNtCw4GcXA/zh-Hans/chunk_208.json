[{"type": "subtitle", "time": 12484.389, "timestamp": "03:28:04", "text": "是的，没错。真恶心。我"}, {"type": "subtitle", "time": 12486.229, "timestamp": "03:28:06", "text": "不知道是谁干的。我觉得我"}, {"type": "subtitle", "time": 12487.67, "timestamp": "03:28:07", "text": "别以为那是……你听到了吗？"}, {"type": "subtitle", "time": 12489.429, "timestamp": "03:28:09", "text": "有人尖叫了一声。你听到了吗？"}, {"type": "subtitle", "time": 12492.87, "timestamp": "03:28:12", "text": "有人尖叫了一声。你们在哪儿？"}, {"type": "subtitle", "time": 12495.51, "timestamp": "03:28:15", "text": "没有人尖叫。不用担心。不，不。"}, {"type": "subtitle", "time": 12498.229, "timestamp": "03:28:18", "text": "当时只有我一个人。我当时正在练习"}, {"type": "subtitle", "time": 12501.11, "timestamp": "03:28:21", "text": "如何唱歌。杰克，快点。没关系。"}, {"type": "subtitle", "time": 12506.309, "timestamp": "03:28:26", "text": "冰点温度。不，不，不。"}, {"type": "subtitle", "time": 12508.15, "timestamp": "03:28:28", "text": "你好。"}, {"type": "subtitle", "time": 12510.429, "timestamp": "03:28:30", "text": "嘿，快看！等等，有人说"}, {"type": "subtitle", "time": 12514.95, "timestamp": "03:28:34", "text": "你好。等待。你好。不。"}, {"type": "subtitle", "time": 12516.87, "timestamp": "03:28:36", "text": "发生了什么？发生了什么？我在这里。"}, {"type": "subtitle", "time": 12524.229, "timestamp": "03:28:44", "text": "是吗？"}]
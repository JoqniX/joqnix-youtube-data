[{"type": "subtitle", "time": 12240.87, "timestamp": "03:24:00", "text": "出去。我想这已经足够了。"}, {"type": "subtitle", "time": 12246.15, "timestamp": "03:24:06", "text": "实际上。我的天，我明白了。"}, {"type": "subtitle", "time": 12249.19, "timestamp": "03:24:09", "text": "哦，我有手电筒。等等，给我"}, {"type": "subtitle", "time": 12251.75, "timestamp": "03:24:11", "text": "一分钟。我以为它会移除。"}, {"type": "subtitle", "time": 12255.11, "timestamp": "03:24:15", "text": "当你快要死了的时候，用手电筒。"}, {"type": "subtitle", "time": 12258.07, "timestamp": "03:24:18", "text": "没关系。我有手电筒。我将"}, {"type": "subtitle", "time": 12259.87, "timestamp": "03:24:19", "text": "添加“不要”"}, {"type": "subtitle", "time": 12263.99, "timestamp": "03:24:23", "text": "像我一样，显然我有"}, {"type": "subtitle", "time": 12266.07, "timestamp": "03:24:26", "text": "手电筒。那真是太酷了"}, {"type": "subtitle", "time": 12268.67, "timestamp": "03:24:28", "text": "当我准备好的时候。我是"}, {"type": "subtitle", "time": 12271.19, "timestamp": "03:24:31", "text": "准备好。嗯，好的。"}, {"type": "subtitle", "time": 12274.55, "timestamp": "03:24:34", "text": "我不知道。我以为，呃，我以为我"}, {"type": "subtitle", "time": 12276.349, "timestamp": "03:24:36", "text": "将会输"}, {"type": "subtitle", "time": 12279.269, "timestamp": "03:24:39", "text": "一切。我认为手电筒就像"}, {"type": "subtitle", "time": 12281.309, "timestamp": "03:24:41", "text": "例外情况或其他什么情况。我不"}, {"type": "subtitle", "time": 12287.229, "timestamp": "03:24:47", "text": "可怕。这张地图的"}, {"type": "subtitle", "time": 12296.87, "timestamp": "03:24:56", "text": "好的。它运行滞后。哦，我其实挺喜欢的"}, {"type": "subtitle", "time": 12298.79, "timestamp": "03:24:58", "text": "这张地图。这有点像……这有点像"}]
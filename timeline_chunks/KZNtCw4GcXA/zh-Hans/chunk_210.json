[{"type": "subtitle", "time": 12601.19, "timestamp": "03:30:01", "text": "我们有紫外线测速仪吗？不，"}, {"type": "subtitle", "time": 12603.75, "timestamp": "03:30:03", "text": "正确的。不，还没有。我没看到"}, {"type": "subtitle", "time": 12612.309, "timestamp": "03:30:12", "text": "一部独立的足球电影。"}, {"type": "subtitle", "time": 12615.99, "timestamp": "03:30:15", "text": "好的。好的。我们还有戴夫。"}, {"type": "subtitle", "time": 12618.79, "timestamp": "03:30:18", "text": "是的，"}, {"type": "subtitle", "time": 12620.79, "timestamp": "03:30:20", "text": "更有趣了。实际上，就是这样。"}, {"type": "subtitle", "time": 12622.87, "timestamp": "03:30:22", "text": "其实吞噬更有趣。你没有"}, {"type": "subtitle", "time": 12625.83, "timestamp": "03:30:25", "text": "必须喜欢这种感觉，就像很舒缓一样。"}, {"type": "subtitle", "time": 12627.67, "timestamp": "03:30:27", "text": "正确的？吞噬更像是更多"}, {"type": "subtitle", "time": 12629.19, "timestamp": "03:30:29", "text": "精彩刺激。"}, {"type": "subtitle", "time": 12631.51, "timestamp": "03:30:31", "text": "是的。是的。大家好。我不是"}, {"type": "subtitle", "time": 12633.91, "timestamp": "03:30:33", "text": "一点也不可怕，因为你只需要"}, {"type": "subtitle", "time": 12635.91, "timestamp": "03:30:35", "text": "走动。轻松游戏。天气很冷"}, {"type": "subtitle", "time": 12638.95, "timestamp": "03:30:38", "text": "其实是游戏。"}, {"type": "subtitle", "time": 12646.55, "timestamp": "03:30:46", "text": "等等，我听说它很可怕。"}, {"type": "subtitle", "time": 12650.11, "timestamp": "03:30:50", "text": "这是。我不知道。我不知道"}, {"type": "subtitle", "time": 12652.469, "timestamp": "03:30:52", "text": "虽然有点吓人，但你知道，或许你应该"}, {"type": "subtitle", "time": 12655.19, "timestamp": "03:30:55", "text": "和我们一起玩吧。"}, {"type": "subtitle", "time": 12657.07, "timestamp": "03:30:57", "text": "是的。"}]
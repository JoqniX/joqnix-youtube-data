[{"type": "subtitle", "time": 11761.71, "timestamp": "03:16:01", "text": "或者独自一人待在……"}, {"type": "subtitle", "time": 11766.03, "timestamp": "03:16:06", "text": "楼梯。看看你。"}, {"type": "subtitle", "time": 11768.55, "timestamp": "03:16:08", "text": "但是，哦，你可以在上方弹钢琴。"}, {"type": "subtitle", "time": 11771.91, "timestamp": "03:16:11", "text": "这里。哦，不错。你想 你想"}, {"type": "subtitle", "time": 11774.15, "timestamp": "03:16:14", "text": "比如发出某种声音？是啊，是啊，是啊。"}, {"type": "subtitle", "time": 11776.229, "timestamp": "03:16:16", "text": "当然，当然，当然，当然。让我去哪里"}, {"type": "subtitle", "time": 11778.87, "timestamp": "03:16:18", "text": "你到底是谁？我把所有东西都打开了。"}, {"type": "subtitle", "time": 11779.95, "timestamp": "03:16:19", "text": "谢谢，"}, {"type": "subtitle", "time": 11786.95, "timestamp": "03:16:26", "text": "你在哪里？好吧，我只是"}, {"type": "subtitle", "time": 11789.03, "timestamp": "03:16:29", "text": "我在找一些紫外线之类的东西。给我"}, {"type": "subtitle", "time": 11798.07, "timestamp": "03:16:38", "text": "你好，艾普丽尔。你在这儿吗？你"}, {"type": "subtitle", "time": 11801.71, "timestamp": "03:16:41", "text": "想在我独处的时候纠缠我吗？"}, {"type": "subtitle", "time": 11805.91, "timestamp": "03:16:45", "text": "你好？你在这里吗？你在哪里？"}, {"type": "subtitle", "time": 11809.51, "timestamp": "03:16:49", "text": "你今年多大？"}, {"type": "subtitle", "time": 11812.63, "timestamp": "03:16:52", "text": "等等，保险丝在哪儿来着？"}, {"type": "subtitle", "time": 11816.55, "timestamp": "03:16:56", "text": "我明白了。哦，你明白了。"}]
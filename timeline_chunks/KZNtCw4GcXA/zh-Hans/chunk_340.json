[{"type": "subtitle", "time": 20404.948, "timestamp": "05:40:04", "text": "步伐。是的，我应该这么做。"}, {"type": "subtitle", "time": 20408.31, "timestamp": "05:40:08", "text": "也这样做。按我自己的节奏来。即使"}, {"type": "subtitle", "time": 20411.788, "timestamp": "05:40:11", "text": "即使我太过分了。"}, {"type": "subtitle", "time": 20413.548, "timestamp": "05:40:13", "text": "懒惰的"}, {"type": "subtitle", "time": 20417.868, "timestamp": "05:40:17", "text": "懒惰，我应该学会默默去做。"}, {"type": "subtitle", "time": 20421.59, "timestamp": "05:40:21", "text": "它。我会花时间去面对它，然后去做。"}, {"type": "subtitle", "time": 20435.628, "timestamp": "05:40:35", "text": "所以，但我最终还是完成了击倒"}, {"type": "subtitle", "time": 20440.11, "timestamp": "05:40:40", "text": "这种药，呃，就像一种药"}, {"type": "subtitle", "time": 20444.548, "timestamp": "05:40:44", "text": "就像……呃……那个……那个……不是"}, {"type": "subtitle", "time": 20447.51, "timestamp": "05:40:47", "text": "金属塑料。不是塑料制品。什么？"}, {"type": "subtitle", "time": 20457.11, "timestamp": "05:40:57", "text": "嗯，塑料。不，它不是塑料的。这"}, {"type": "subtitle", "time": 20458.35, "timestamp": "05:40:58", "text": "金属。不。"}]
[{"type": "subtitle", "time": 15480.149, "timestamp": "04:18:00", "text": "你能认出我长什么样吗？"}, {"type": "subtitle", "time": 15482.99, "timestamp": "04:18:02", "text": "向左拐角。"}, {"type": "subtitle", "time": 15485.51, "timestamp": "04:18:05", "text": "边。是的。你好，Adi。你好，布拉德。我"}, {"type": "subtitle", "time": 15487.429, "timestamp": "04:18:07", "text": "希望你们一切都好。"}, {"type": "subtitle", "time": 15490.469, "timestamp": "04:18:10", "text": "是啊，我想念大家。是的，我没有。"}, {"type": "subtitle", "time": 15493.11, "timestamp": "04:18:13", "text": "直播。呃，我昨天直播了吗？我"}, {"type": "subtitle", "time": 15495.429, "timestamp": "04:18:15", "text": "不知道。我没直播吧？我"}, {"type": "subtitle", "time": 15498.269, "timestamp": "04:18:18", "text": "不知道。但是，是啊，是啊，是啊，是啊。"}, {"type": "subtitle", "time": 15503.87, "timestamp": "04:18:23", "text": "是的。呃，我想呃，我会得到一个"}, {"type": "subtitle", "time": 15506.71, "timestamp": "04:18:26", "text": "反馈。呃，我会收到通知"}, {"type": "subtitle", "time": 15510.429, "timestamp": "04:18:30", "text": "他们正在取消静音。所以，是的，请让我"}, {"type": "subtitle", "time": 15513.51, "timestamp": "04:18:33", "text": "知道。维克来了。雅虎维克，我们开始吧"}, {"type": "subtitle", "time": 15515.59, "timestamp": "04:18:35", "text": "今天我们发挥出了最佳水平。"}, {"type": "subtitle", "time": 15518.55, "timestamp": "04:18:38", "text": "今天让我们尽力而为。天哪，我，我"}, {"type": "subtitle", "time": 15520.87, "timestamp": "04:18:40", "text": "紧张的。我很害怕。我感觉很复杂"}, {"type": "subtitle", "time": 15524.429, "timestamp": "04:18:44", "text": "情感。但是，是的，让我们开始吧。"}, {"type": "subtitle", "time": 15527.38, "timestamp": "04:18:47", "text": "最好的。"}, {"type": "subtitle", "time": 15530.11, "timestamp": "04:18:50", "text": "[音乐]"}, {"type": "subtitle", "time": 15533.07, "timestamp": "04:18:53", "text": "好的，让我把所有东西都关掉。"}, {"type": "subtitle", "time": 15535.07, "timestamp": "04:18:55", "text": "这。我是"}, {"type": "subtitle", "time": 15537.89, "timestamp": "04:18:57", "text": "准备好。不，伙计。"}]
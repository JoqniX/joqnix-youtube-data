[{"type": "subtitle", "time": 16803.99, "timestamp": "04:40:03", "text": "以 Fasmo 的方式。真的吗？"}, {"type": "subtitle", "time": 16806.23, "timestamp": "04:40:06", "text": "鬼影时代。"}, {"type": "subtitle", "time": 16808.39, "timestamp": "04:40:08", "text": "为什么我一个人在地下室？这是"}, {"type": "subtitle", "time": 16811.03, "timestamp": "04:40:11", "text": "坏的。不，不，不。你做得很好。"}, {"type": "subtitle", "time": 16812.868, "timestamp": "04:40:12", "text": "你做得非常棒。是的，就是这样。"}, {"type": "subtitle", "time": 16814.39, "timestamp": "04:40:14", "text": "美好的。哦，杰克，看看我。看着我。"}, {"type": "subtitle", "time": 16820.47, "timestamp": "04:40:20", "text": "我要进去了。哦，你好，勇敢的瑞克。"}, {"type": "subtitle", "time": 16822.868, "timestamp": "04:40:22", "text": "你好，鬼魂。我只是在寻找……"}, {"type": "subtitle", "time": 16826.39, "timestamp": "04:40:26", "text": "我只是，我只是想要，我只是想要"}, {"type": "subtitle", "time": 16829.75, "timestamp": "04:40:29", "text": "简直就像紫外线之类的东西。快点。我拿"}, {"type": "subtitle", "time": 16837.35, "timestamp": "04:40:37", "text": "你好，艾普丽尔。你想跟我谈谈吗？"}, {"type": "subtitle", "time": 16839.83, "timestamp": "04:40:39", "text": "我一个人在这里。"}, {"type": "subtitle", "time": 16841.83, "timestamp": "04:40:41", "text": "别害羞。我害怕跟人说话"}, {"type": "subtitle", "time": 16844.07, "timestamp": "04:40:44", "text": "鬼魂。"}, {"type": "subtitle", "time": 16845.75, "timestamp": "04:40:45", "text": "我认为如果你真的想的话，你需要这样做。"}, {"type": "subtitle", "time": 16848.47, "timestamp": "04:40:48", "text": "跟鬼魂说话，拿走我的收音机。哦，"}, {"type": "subtitle", "time": 16851.51, "timestamp": "04:40:51", "text": "她关了灯。"}, {"type": "subtitle", "time": 16854.708, "timestamp": "04:40:54", "text": "跟我说话。哦，是的。你可以喜欢你"}, {"type": "subtitle", "time": 16856.628, "timestamp": "04:40:56", "text": "如果你想的话，可以和她聊聊，但是"}]
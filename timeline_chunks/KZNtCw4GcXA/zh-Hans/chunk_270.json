[{"type": "subtitle", "time": 16201.349, "timestamp": "04:30:01", "text": "杰克，你能过来吗？"}, {"type": "subtitle", "time": 16205.03, "timestamp": "04:30:05", "text": "楼上？你为什么想让我来？我 我"}, {"type": "subtitle", "time": 16207.59, "timestamp": "04:30:07", "text": "希望你来，因为你有"}, {"type": "subtitle", "time": 16210.55, "timestamp": "04:30:10", "text": "手电筒。对，没错。确切地。你"}, {"type": "subtitle", "time": 16212.469, "timestamp": "04:30:12", "text": "带上手电筒。你看，你有"}, {"type": "subtitle", "time": 16214.07, "timestamp": "04:30:14", "text": "手电筒。你是什​​么意思？为什么我会"}, {"type": "subtitle", "time": 16215.59, "timestamp": "04:30:15", "text": "必须？如果你愿意，你可以躲在这里。"}, {"type": "subtitle", "time": 16219.03, "timestamp": "04:30:19", "text": "想。你可以和幽灵学长对话。"}, {"type": "subtitle", "time": 16221.91, "timestamp": "04:30:21", "text": "使用按键进行通话。是的，就是这样。"}, {"type": "subtitle", "time": 16224.269, "timestamp": "04:30:24", "text": "他们会回应。"}, {"type": "subtitle", "time": 16226.95, "timestamp": "04:30:26", "text": "是的，你可以，你不需要喜欢"}, {"type": "subtitle", "time": 16231.269, "timestamp": "04:30:31", "text": "那该怎么称呼呢？呃呃呃，所以"}, {"type": "subtitle", "time": 16234.149, "timestamp": "04:30:34", "text": "对了，首要任务是什么？"}, {"type": "subtitle", "time": 16236.71, "timestamp": "04:30:36", "text": "呃，目击到鬼魂，然后第二个是"}, {"type": "subtitle", "time": 16239.229, "timestamp": "04:30:39", "text": "逃离鬼魂"}, {"type": "subtitle", "time": 16246.55, "timestamp": "04:30:46", "text": "我忘了打开这破玩意儿。"}, {"type": "subtitle", "time": 16247.91, "timestamp": "04:30:47", "text": "哦，灯灭了。你看看"}, {"type": "subtitle", "time": 16253.349, "timestamp": "04:30:53", "text": "哦，不错。好的。哦，不。哦，不。如果"}, {"type": "subtitle", "time": 16255.83, "timestamp": "04:30:55", "text": "你们在游戏里能听到我的声音吗？"}, {"type": "subtitle", "time": 16257.99, "timestamp": "04:30:57", "text": "不。"}, {"type": "subtitle", "time": 16258.75, "timestamp": "04:30:58", "text": "它是"}]
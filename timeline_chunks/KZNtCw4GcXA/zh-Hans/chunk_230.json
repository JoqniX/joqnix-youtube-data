[{"type": "subtitle", "time": 13800.07, "timestamp": "03:50:00", "text": "嗯，之后，就像，嗯，所以，嗯"}, {"type": "subtitle", "time": 13803.59, "timestamp": "03:50:03", "text": "在说明这一点之前，先介绍一下模式应用程序。"}, {"type": "subtitle", "time": 13805.63, "timestamp": "03:50:05", "text": "现已上市"}, {"type": "subtitle", "time": 13807.63, "timestamp": "03:50:07", "text": "可用的。做"}, {"type": "subtitle", "time": 13811.269, "timestamp": "03:50:11", "text": "如果你想申请，就申请吧。我不想"}, {"type": "subtitle", "time": 13813.429, "timestamp": "03:50:13", "text": "强迫任何人强迫你申请。"}, {"type": "subtitle", "time": 13817.51, "timestamp": "03:50:17", "text": "不，不，不，不。呃，如果你认为你可以"}, {"type": "subtitle", "time": 13821.87, "timestamp": "03:50:21", "text": "版主，你可以申请。好的。不强迫"}, {"type": "subtitle", "time": 13825.03, "timestamp": "03:50:25", "text": "任何人。这将是一个艰难的选择。我是"}, {"type": "subtitle", "time": 13827.469, "timestamp": "03:50:27", "text": "你们认识的人"}, {"type": "subtitle", "time": 13832.389, "timestamp": "03:50:32", "text": "我。我是一个优柔寡断的人，所以"}, {"type": "subtitle", "time": 13835.55, "timestamp": "03:50:35", "text": "难的。所以，我不知道自己会怎么样。"}, {"type": "subtitle", "time": 13838.95, "timestamp": "03:50:38", "text": "最终确定"}, {"type": "subtitle", "time": 13841.11, "timestamp": "03:50:41", "text": "呃，还有那些人和版主之类的，但是……"}, {"type": "subtitle", "time": 13844.59, "timestamp": "03:50:44", "text": "让我们来看看。我希望我能做到"}, {"type": "subtitle", "time": 13847.75, "timestamp": "03:50:47", "text": "适当地。但是，嗯，它确实是……"}, {"type": "subtitle", "time": 13850.71, "timestamp": "03:50:50", "text": "正在发生。持续时间"}, {"type": "subtitle", "time": 13853.99, "timestamp": "03:50:53", "text": "应用程序仍然来自它已经"}, {"type": "subtitle", "time": 13857.309, "timestamp": "03:50:57", "text": "第二天？所以，嗯，10月19日"}]
[{"type": "subtitle", "time": 18842.11, "timestamp": "05:14:02", "text": "他们没看到吗？我不知道，"}, {"type": "subtitle", "time": 18880.67, "timestamp": "05:14:40", "text": "我的意思是，对于新来者之类的。"}, {"type": "subtitle", "time": 18884.11, "timestamp": "05:14:44", "text": "现在尤其适用于开放的BC"}, {"type": "subtitle", "time": 18887.35, "timestamp": "05:14:47", "text": "他们不明白，我不是收购方。"}, {"type": "subtitle", "time": 18890.788, "timestamp": "05:14:50", "text": "当有嘉宾在场时，直播中是否曾经出现过这种情况？"}, {"type": "subtitle", "time": 18893.27, "timestamp": "05:14:53", "text": "接管。客人必须口头表达"}, {"type": "subtitle", "time": 18895.99, "timestamp": "05:14:55", "text": "大声说出来，那只狗正在吃东西"}, {"type": "subtitle", "time": 18898.948, "timestamp": "05:14:58", "text": "休息。我现在暂时在这里。我"}]
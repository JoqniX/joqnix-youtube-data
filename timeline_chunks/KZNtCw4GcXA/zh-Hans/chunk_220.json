[{"type": "subtitle", "time": 13201.99, "timestamp": "03:40:01", "text": "哭了那么久，我感觉自己都快要崩溃了。"}, {"type": "subtitle", "time": 13204.87, "timestamp": "03:40:04", "text": "累得我开始跌倒"}, {"type": "subtitle", "time": 13207.51, "timestamp": "03:40:07", "text": "睡着了或者其他什么状态。我喜欢我曾经的样子"}, {"type": "subtitle", "time": 13210.07, "timestamp": "03:40:10", "text": "梦见第二个，那里没有"}, {"type": "subtitle", "time": 13212.95, "timestamp": "03:40:12", "text": "我相信第一个是他们俩都在的。"}, {"type": "subtitle", "time": 13215.91, "timestamp": "03:40:15", "text": "死去，入侵，死去，并引领我"}, {"type": "subtitle", "time": 13219.11, "timestamp": "03:40:19", "text": "受苦吧，呃，让我成为最后一个"}, {"type": "subtitle", "time": 13220.349, "timestamp": "03:40:20", "text": "站立和"}, {"type": "subtitle", "time": 13223.95, "timestamp": "03:40:23", "text": "就像在鬼魂面前幸存下来一样"}, {"type": "subtitle", "time": 13226.269, "timestamp": "03:40:26", "text": "我有点明白了"}, {"type": "subtitle", "time": 13228.95, "timestamp": "03:40:28", "text": "像白日梦之类的诡异感觉"}, {"type": "subtitle", "time": 13230.71, "timestamp": "03:40:30", "text": "它叫清醒梦，我不知道。"}, {"type": "subtitle", "time": 13232.15, "timestamp": "03:40:32", "text": "就像你遇到的那种鬼魂一样"}, {"type": "subtitle", "time": 13234.95, "timestamp": "03:40:34", "text": "我知道他的手就像爬到我脸上一样。"}, {"type": "subtitle", "time": 13236.229, "timestamp": "03:40:36", "text": "就像字面意义上的"}, {"type": "subtitle", "time": 13240.309, "timestamp": "03:40:40", "text": "呃，黑色让我眼前一黑，或者别的什么原因。嗯"}, {"type": "subtitle", "time": 13242.389, "timestamp": "03:40:42", "text": "就像我一样。我的天啊，真是……"}, {"type": "subtitle", "time": 13245.469, "timestamp": "03:40:45", "text": "太可怕了，我觉得我当时尖叫了一声。"}, {"type": "subtitle", "time": 13248.95, "timestamp": "03:40:48", "text": "少量。然后我就醒了。就在那时我醒了。"}, {"type": "subtitle", "time": 13250.95, "timestamp": "03:40:50", "text": "实际上向上。就在那时我醒了过来。"}, {"type": "subtitle", "time": 13252.95, "timestamp": "03:40:52", "text": "我当时就想，哦等等，哦等等，什么？"}, {"type": "subtitle", "time": 13255.59, "timestamp": "03:40:55", "text": "合作计划怎么样了？我的第一个"}, {"type": "subtitle", "time": 13257.51, "timestamp": "03:40:57", "text": "我当时在想，等等，什么？"}, {"type": "subtitle", "time": 13259.63, "timestamp": "03:40:59", "text": "碰巧合作过吗？我当时正在听"}]
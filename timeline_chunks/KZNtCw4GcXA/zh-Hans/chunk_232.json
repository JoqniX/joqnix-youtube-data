[{"type": "subtitle", "time": 13921.51, "timestamp": "03:52:01", "text": "我做了那件事，然后就做了点什么。它是"}, {"type": "subtitle", "time": 13923.83, "timestamp": "03:52:03", "text": "有点难用，但还算……"}, {"type": "subtitle", "time": 13926.389, "timestamp": "03:52:06", "text": "还行吧。我不知道。有点儿"}, {"type": "subtitle", "time": 13929.11, "timestamp": "03:52:09", "text": "不错。那件事，那件事是"}, {"type": "subtitle", "time": 13931.389, "timestamp": "03:52:11", "text": "挑战就在于此。"}, {"type": "subtitle", "time": 13934.71, "timestamp": "03:52:14", "text": "呃呃，我以为的那些事"}, {"type": "subtitle", "time": 13937.349, "timestamp": "03:52:17", "text": "在我的……中谈到"}, {"type": "subtitle", "time": 13939.189, "timestamp": "03:52:19", "text": "呃，我在Twitch直播间里，当时我真的就在"}, {"type": "subtitle", "time": 13941.15, "timestamp": "03:52:21", "text": "用白板画了大概四到三页"}, {"type": "subtitle", "time": 13943.75, "timestamp": "03:52:23", "text": "就像规划我的整个流程一样"}, {"type": "subtitle", "time": 13948.349, "timestamp": "03:52:28", "text": "网站的整体构思。"}, {"type": "subtitle", "time": 13950.99, "timestamp": "03:52:30", "text": "嗯，我相信"}, {"type": "subtitle", "time": 13954.95, "timestamp": "03:52:34", "text": "呃，我相信就像"}, {"type": "subtitle", "time": 13957.67, "timestamp": "03:52:37", "text": "呃，那会很痛苦，因为有多少？"}, {"type": "subtitle", "time": 13960.389, "timestamp": "03:52:40", "text": "那会很贵。嗯，但我会试试。"}, {"type": "subtitle", "time": 13962.469, "timestamp": "03:52:42", "text": "能装下所有东西，嗯，我也能装下"}, {"type": "subtitle", "time": 13964.469, "timestamp": "03:52:44", "text": "一切都已准备就绪，所以不用担心。"}, {"type": "subtitle", "time": 13967.71, "timestamp": "03:52:47", "text": "我将在直播中"}, {"type": "subtitle", "time": 13971.189, "timestamp": "03:52:51", "text": "抽搐。是的。是的。是的。老兄，我想"}, {"type": "subtitle", "time": 13973.51, "timestamp": "03:52:53", "text": "想睡觉，但我又不想睡觉，因为"}, {"type": "subtitle", "time": 13975.79, "timestamp": "03:52:55", "text": "然后它又回来了。我是"}, {"type": "subtitle", "time": 13978.189, "timestamp": "03:52:58", "text": "比如，嗨"}]
[{"type": "subtitle", "time": 16740.23, "timestamp": "04:39:00", "text": "你好，艾普丽尔。你在这儿吗？你"}, {"type": "subtitle", "time": 16743.869, "timestamp": "04:39:03", "text": "想在我独处的时候纠缠我吗？"}, {"type": "subtitle", "time": 16748.07, "timestamp": "04:39:08", "text": "你好？你在这里吗？你在哪里？"}, {"type": "subtitle", "time": 16751.67, "timestamp": "04:39:11", "text": "你今年多大？"}, {"type": "subtitle", "time": 16754.789, "timestamp": "04:39:14", "text": "等等，保险丝在哪儿来着？"}, {"type": "subtitle", "time": 16758.709, "timestamp": "04:39:18", "text": "我明白了。哦，你明白了。"}, {"type": "subtitle", "time": 16769.39, "timestamp": "04:39:29", "text": "光。哦。哦，没什么。哦"}, {"type": "subtitle", "time": 16777.23, "timestamp": "04:39:37", "text": "嘿。是的，灯已经装好了。"}, {"type": "subtitle", "time": 16778.788, "timestamp": "04:39:38", "text": "[音乐]"}, {"type": "subtitle", "time": 16783.59, "timestamp": "04:39:43", "text": "你好。"}, {"type": "subtitle", "time": 16786.15, "timestamp": "04:39:46", "text": "你在这里吗？艾普丽尔，你在吗？"}, {"type": "subtitle", "time": 16789.03, "timestamp": "04:39:49", "text": "你想和我们谈谈吗？他们多大了？"}, {"type": "subtitle", "time": 16795.43, "timestamp": "04:39:55", "text": "我喜欢你问他们多大这个问题。"}, {"type": "subtitle", "time": 16798.23, "timestamp": "04:39:58", "text": "你。哦，那是默认设置。那是"}, {"type": "subtitle", "time": 16799.99, "timestamp": "04:39:59", "text": "这是你必须问的一个默认问题。"}]
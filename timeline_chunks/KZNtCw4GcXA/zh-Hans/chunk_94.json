[{"type": "subtitle", "time": 5648.79, "timestamp": "01:34:08", "text": "什么？人人储蓄机会均等。"}, {"type": "subtitle", "time": 5666.87, "timestamp": "01:34:26", "text": "重新加载。反击。拿着。斗争"}, {"type": "subtitle", "time": 5691.75, "timestamp": "01:34:51", "text": "好的。等待。他们现在要走了。全部"}, {"type": "subtitle", "time": 5693.83, "timestamp": "01:34:53", "text": "他们要走了。阿拉斯加。什么？什么？是什么"}, {"type": "subtitle", "time": 5695.709, "timestamp": "01:34:55", "text": "他的"}, {"type": "subtitle", "time": 5699.189, "timestamp": "01:34:59", "text": "战术？战术？我不明白。您保存"}]
[{"type": "subtitle", "time": 11282.11, "timestamp": "03:08:02", "text": "是的，他们就是这么回应的。"}, {"type": "subtitle", "time": 11285.15, "timestamp": "03:08:05", "text": "是的，你可以，你不需要喜欢"}, {"type": "subtitle", "time": 11289.11, "timestamp": "03:08:09", "text": "那该怎么称呼呢？呃呃呃，所以"}, {"type": "subtitle", "time": 11291.99, "timestamp": "03:08:11", "text": "对了，首要任务是什么？"}, {"type": "subtitle", "time": 11294.55, "timestamp": "03:08:14", "text": "呃，目睹鬼魂，然后是第二起"}, {"type": "subtitle", "time": 11297.07, "timestamp": "03:08:17", "text": "逃离鬼魂"}, {"type": "subtitle", "time": 11304.55, "timestamp": "03:08:24", "text": "忘了打开这破玩意儿。哦，"}, {"type": "subtitle", "time": 11305.99, "timestamp": "03:08:25", "text": "灯灭了。请您看一下"}, {"type": "subtitle", "time": 11311.19, "timestamp": "03:08:31", "text": "哦，不错。好的。哦，不。哦，不。"}, {"type": "subtitle", "time": 11313.67, "timestamp": "03:08:33", "text": "你们在游戏里能听到我说话吗？"}, {"type": "subtitle", "time": 11315.83, "timestamp": "03:08:35", "text": "不。"}, {"type": "subtitle", "time": 11318.71, "timestamp": "03:08:38", "text": "没关系。没关系。你们想"}, {"type": "subtitle", "time": 11322.71, "timestamp": "03:08:42", "text": "下去？让我修复一下我的按键通话功能。"}, {"type": "subtitle", "time": 11329.67, "timestamp": "03:08:49", "text": "鬼。好的。"}, {"type": "subtitle", "time": 11332.55, "timestamp": "03:08:52", "text": "哦，指针好像在移动，但是……"}, {"type": "subtitle", "time": 11335.19, "timestamp": "03:08:55", "text": "并非说它还没有发展阶段。"}, {"type": "subtitle", "time": 11337.75, "timestamp": "03:08:57", "text": "但它正在移动。"}]
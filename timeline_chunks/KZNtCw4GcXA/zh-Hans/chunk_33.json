[{"type": "subtitle", "time": 1981.31, "timestamp": "00:33:01", "text": "欢迎来到皮尤的单人冒险之旅"}, {"type": "subtitle", "time": 1984.83, "timestamp": "00:33:04", "text": "祈祷。呃，咻"}, {"type": "subtitle", "time": 1991.47, "timestamp": "00:33:11", "text": "红色的"}, {"type": "subtitle", "time": 2000.789, "timestamp": "00:33:20", "text": "哦，我的天哪，拍了我一下。你觉得我能"}]
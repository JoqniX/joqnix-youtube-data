[{"type": "subtitle", "time": 17400.708, "timestamp": "04:50:00", "text": "是不是像“哦，没有房间”那样？"}, {"type": "subtitle", "time": 17403.99, "timestamp": "04:50:03", "text": "在侧面。哑的。好的，这间浴室"}, {"type": "subtitle", "time": 17405.59, "timestamp": "04:50:05", "text": "真恶心。人们正在保留"}, {"type": "subtitle", "time": 17407.59, "timestamp": "04:50:07", "text": "像牙刷一样"}, {"type": "subtitle", "time": 17409.27, "timestamp": "04:50:09", "text": "在露天。那就像我的其中之一"}, {"type": "subtitle", "time": 17411.83, "timestamp": "04:50:11", "text": "最大的前任们躺着刷牙"}, {"type": "subtitle", "time": 17413.67, "timestamp": "04:50:13", "text": "因为它很容易变脏，然后你"}, {"type": "subtitle", "time": 17418.788, "timestamp": "04:50:18", "text": "把它放进嘴里。哑的。我的天哪。"}, {"type": "subtitle", "time": 17420.788, "timestamp": "04:50:20", "text": "谁能想到塞拉斯蒂娅才是真正的"}, {"type": "subtitle", "time": 17426.47, "timestamp": "04:50:26", "text": "是的，没错。真恶心。我"}, {"type": "subtitle", "time": 17428.31, "timestamp": "04:50:28", "text": "不知道是谁干的。我觉得我"}, {"type": "subtitle", "time": 17429.75, "timestamp": "04:50:29", "text": "别以为那是……你听到了吗？"}, {"type": "subtitle", "time": 17431.51, "timestamp": "04:50:31", "text": "有人尖叫了一声。你听到了吗？"}, {"type": "subtitle", "time": 17434.948, "timestamp": "04:50:34", "text": "有人尖叫了一声。你们在哪儿？"}, {"type": "subtitle", "time": 17437.67, "timestamp": "04:50:37", "text": "没有人尖叫。不用担心。不，不。"}, {"type": "subtitle", "time": 17440.39, "timestamp": "04:50:40", "text": "当时只有我一个人。我当时正在练习"}, {"type": "subtitle", "time": 17443.27, "timestamp": "04:50:43", "text": "如何唱歌。杰克，快点。没关系。"}, {"type": "subtitle", "time": 17448.47, "timestamp": "04:50:48", "text": "冰点温度。不，不，不，不。"}, {"type": "subtitle", "time": 17450.31, "timestamp": "04:50:50", "text": "你好。"}, {"type": "subtitle", "time": 17452.59, "timestamp": "04:50:52", "text": "嘿，快看！等等，有人说"}, {"type": "subtitle", "time": 17457.11, "timestamp": "04:50:57", "text": "你好。等待。你好。不。"}, {"type": "subtitle", "time": 17459.03, "timestamp": "04:50:59", "text": "发生了什么？发生了什么？我在这里。"}]
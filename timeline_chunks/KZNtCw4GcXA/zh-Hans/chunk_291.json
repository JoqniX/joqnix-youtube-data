[{"type": "subtitle", "time": 17466.39, "timestamp": "04:51:06", "text": "是吗？"}, {"type": "subtitle", "time": 17473.03, "timestamp": "04:51:13", "text": "当然。我以为鬼魂是"}, {"type": "subtitle", "time": 17478.868, "timestamp": "04:51:18", "text": "请问您能否向我展示一下您是否"}, {"type": "subtitle", "time": 17481.51, "timestamp": "04:51:21", "text": "来这里是为了移动那个球吗？甚至可能杀死"}, {"type": "subtitle", "time": 17483.51, "timestamp": "04:51:23", "text": "一个人。"}, {"type": "subtitle", "time": 17486.708, "timestamp": "04:51:26", "text": "总之，我放弃了“哦，你知道吗？”"}, {"type": "subtitle", "time": 17487.91, "timestamp": "04:51:27", "text": "你知道吗？你知道吗？很多"}, {"type": "subtitle", "time": 17489.75, "timestamp": "04:51:29", "text": "更好的。就像我会直接把它扔进去一样。"}, {"type": "subtitle", "time": 17494.15, "timestamp": "04:51:34", "text": "中间。所以如果它确实像"}, {"type": "subtitle", "time": 17496.868, "timestamp": "04:51:36", "text": "哦，发电机正在运转。呃，各位，"}, {"type": "subtitle", "time": 17499.83, "timestamp": "04:51:39", "text": "天气很冷，我看到了帐篷。"}, {"type": "subtitle", "time": 17503.35, "timestamp": "04:51:43", "text": "物体自行移动。哦，真棒。反正，"}, {"type": "subtitle", "time": 17505.43, "timestamp": "04:51:45", "text": "冷冻得当。我要放弃"}, {"type": "subtitle", "time": 17507.99, "timestamp": "04:51:47", "text": "这里就有门了。是的，就是这个。"}, {"type": "subtitle", "time": 17511.03, "timestamp": "04:51:51", "text": "它自己动了。所以，"}, {"type": "subtitle", "time": 17512.788, "timestamp": "04:51:52", "text": "好的，"}, {"type": "subtitle", "time": 17515.788, "timestamp": "04:51:55", "text": "没关系。我打算留下来"}, {"type": "subtitle", "time": 17519.75, "timestamp": "04:51:59", "text": "这里。嘿，伙计们，我现在在这里露营。"}]
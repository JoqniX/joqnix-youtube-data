[{"type": "subtitle", "time": 16983.51, "timestamp": "04:43:03", "text": "没有什么。好的。冰点温度"}, {"type": "subtitle", "time": 16985.99, "timestamp": "04:43:05", "text": "事情发生了。哦，这冰冻的天气"}, {"type": "subtitle", "time": 16988.07, "timestamp": "04:43:08", "text": "温度。哦，等等。那不是那样的。"}, {"type": "subtitle", "time": 16994.35, "timestamp": "04:43:14", "text": "分钟。冷冻"}, {"type": "subtitle", "time": 16997.75, "timestamp": "04:43:17", "text": "温度。什么？什么？好的。好的。证据。"}, {"type": "subtitle", "time": 17000.83, "timestamp": "04:43:20", "text": "好的。我们冻僵了"}, {"type": "subtitle", "time": 17003.948, "timestamp": "04:43:23", "text": "温度。我们不希望"}, {"type": "subtitle", "time": 17006.708, "timestamp": "04:43:26", "text": "隐藏。我什么也没得到。吐痰盒。"}, {"type": "subtitle", "time": 17011.19, "timestamp": "04:43:31", "text": "我们没看到幽灵骑行。无紫外线。我们"}, {"type": "subtitle", "time": 17014.39, "timestamp": "04:43:34", "text": "没有采取任何类似措施。没有像"}, {"type": "subtitle", "time": 17021.91, "timestamp": "04:43:41", "text": "出现在我身上。哦，原来你在这儿啊。不"}, {"type": "subtitle", "time": 17023.27, "timestamp": "04:43:43", "text": "别担心，伙计。没关系。没关系。"}, {"type": "subtitle", "time": 17025.35, "timestamp": "04:43:45", "text": "你做得很好。是的，你是"}, {"type": "subtitle", "time": 17027.75, "timestamp": "04:43:47", "text": "做得很好。是的，你的看法。哦，我的"}, {"type": "subtitle", "time": 17031.19, "timestamp": "04:43:51", "text": "上帝。没关系。我正在选择"}, {"type": "subtitle", "time": 17033.59, "timestamp": "04:43:53", "text": "你。你知道吗？恶魔，我，我"}, {"type": "subtitle", "time": 17036.23, "timestamp": "04:43:56", "text": "变成恶魔。"}, {"type": "subtitle", "time": 17039.03, "timestamp": "04:43:59", "text": "我要去做点什么。选一个。我们"}]
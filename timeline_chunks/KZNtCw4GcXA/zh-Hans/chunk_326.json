[{"type": "subtitle", "time": 19560.83, "timestamp": "05:26:00", "text": "感受他人的挣扎"}, {"type": "subtitle", "time": 19564.39, "timestamp": "05:26:04", "text": "你知道我遇到的很多人的方式"}, {"type": "subtitle", "time": 19569.51, "timestamp": "05:26:09", "text": "YouTuber 有很多同行"}, {"type": "subtitle", "time": 19572.868, "timestamp": "05:26:12", "text": "呃，这些年来所有的人"}, {"type": "subtitle", "time": 19576.19, "timestamp": "05:26:16", "text": "流媒体播放困难"}, {"type": "subtitle", "time": 19578.868, "timestamp": "05:26:18", "text": "正确或有他们的模型屏幕"}, {"type": "subtitle", "time": 19581.99, "timestamp": "05:26:21", "text": "以及直播等等。现在我"}, {"type": "subtitle", "time": 19584.43, "timestamp": "05:26:24", "text": "理解他们的困境"}, {"type": "subtitle", "time": 19588.868, "timestamp": "05:26:28", "text": "因为我用的是双PC配置。不，我"}, {"type": "subtitle", "time": 19591.39, "timestamp": "05:26:31", "text": "从未遇到困难。我"}, {"type": "subtitle", "time": 19595.55, "timestamp": "05:26:35", "text": "我觉得我当时做了很多实验"}, {"type": "subtitle", "time": 19598.39, "timestamp": "05:26:38", "text": "把很多不必要的事情都堆在一起"}, {"type": "subtitle", "time": 19602.23, "timestamp": "05:26:42", "text": "我两台电脑上都在运行一些东西。"}, {"type": "subtitle", "time": 19603.868, "timestamp": "05:26:43", "text": "使其过载"}, {"type": "subtitle", "time": 19606.868, "timestamp": "05:26:46", "text": "最大限度。我从未理解过……的挣扎"}, {"type": "subtitle", "time": 19610.55, "timestamp": "05:26:50", "text": "单台PC配置。人们如何与"}, {"type": "subtitle", "time": 19613.868, "timestamp": "05:26:53", "text": "非常糟糕，就像老旧的笔记本电脑能够做到的那样"}, {"type": "subtitle", "time": 19618.07, "timestamp": "05:26:58", "text": "使用 VTS 进行流媒体播放，以及所有相关功能。"}]
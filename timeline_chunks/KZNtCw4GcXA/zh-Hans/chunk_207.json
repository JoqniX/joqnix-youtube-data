[{"type": "subtitle", "time": 12421.15, "timestamp": "03:27:01", "text": "拉斯球。 A 那里有一个"}, {"type": "subtitle", "time": 12424.75, "timestamp": "03:27:04", "text": "球。等等，怎么做？"}, {"type": "subtitle", "time": 12427.71, "timestamp": "03:27:07", "text": "打球"}, {"type": "subtitle", "time": 12431.389, "timestamp": "03:27:11", "text": "牙买加？如何"}, {"type": "subtitle", "time": 12435.03, "timestamp": "03:27:15", "text": "然后你捡起它，再用 G 键放下。"}, {"type": "subtitle", "time": 12436.55, "timestamp": "03:27:16", "text": "它。"}, {"type": "subtitle", "time": 12439.59, "timestamp": "03:27:19", "text": "哦，格罗。哦好的。好的。是的，我们"}, {"type": "subtitle", "time": 12441.59, "timestamp": "03:27:21", "text": "去。"}, {"type": "subtitle", "time": 12443.15, "timestamp": "03:27:23", "text": "真是这样"}, {"type": "subtitle", "time": 12454.07, "timestamp": "03:27:34", "text": "哦，舞会气氛。是的，是我扔的。我"}, {"type": "subtitle", "time": 12456.469, "timestamp": "03:27:36", "text": "扔了进去。"}, {"type": "subtitle", "time": 12458.63, "timestamp": "03:27:38", "text": "是不是像“哦，没有房间”那样？"}, {"type": "subtitle", "time": 12461.91, "timestamp": "03:27:41", "text": "在侧面。哑的。好的。这间浴室"}, {"type": "subtitle", "time": 12463.51, "timestamp": "03:27:43", "text": "真恶心。人们正在保留"}, {"type": "subtitle", "time": 12465.51, "timestamp": "03:27:45", "text": "像牙刷一样"}, {"type": "subtitle", "time": 12467.19, "timestamp": "03:27:47", "text": "在露天。那就像我的其中之一"}, {"type": "subtitle", "time": 12469.67, "timestamp": "03:27:49", "text": "最大的前任只是躺着刷牙"}, {"type": "subtitle", "time": 12471.59, "timestamp": "03:27:51", "text": "因为它很容易变脏，然后你"}, {"type": "subtitle", "time": 12476.71, "timestamp": "03:27:56", "text": "把它放进嘴里。哑的。我的天哪。"}, {"type": "subtitle", "time": 12478.71, "timestamp": "03:27:58", "text": "谁能想到塞拉斯蒂娅才是真正的"}]
[{"type": "subtitle", "time": 17282.55, "timestamp": "04:48:02", "text": "克洛诺斯。嘘，克洛诺斯。"}, {"type": "subtitle", "time": 17287.67, "timestamp": "04:48:07", "text": "好的，开始吧。你好。我们有这个"}, {"type": "subtitle", "time": 17291.27, "timestamp": "04:48:11", "text": "他名叫基思·米勒。对，这个"}, {"type": "subtitle", "time": 17294.31, "timestamp": "04:48:14", "text": "这个公园其实挺不错的。"}, {"type": "subtitle", "time": 17298.15, "timestamp": "04:48:18", "text": "篮球。等等，你起不来"}, {"type": "subtitle", "time": 17300.31, "timestamp": "04:48:20", "text": "反正。"}, {"type": "subtitle", "time": 17301.75, "timestamp": "04:48:21", "text": "哦，老兄。瞧瞧。这是个苗条的人"}, {"type": "subtitle", "time": 17305.39, "timestamp": "04:48:25", "text": "男人。好的。嗯？修长的人。"}, {"type": "subtitle", "time": 17314.868, "timestamp": "04:48:34", "text": "瞧瞧。瞧瞧。我的天啊。"}, {"type": "subtitle", "time": 17318.07, "timestamp": "04:48:38", "text": "那很好。不，我从来没有"}, {"type": "subtitle", "time": 17321.19, "timestamp": "04:48:41", "text": "回首往事。"}, {"type": "subtitle", "time": 17322.55, "timestamp": "04:48:42", "text": "意思是说你看起来很酷"}, {"type": "subtitle", "time": 17331.83, "timestamp": "04:48:51", "text": "等等，我该怎么做？我想我应该……"}, {"type": "subtitle", "time": 17333.51, "timestamp": "04:48:53", "text": "打开电源，然后直接放进去就行了。"}, {"type": "subtitle", "time": 17335.51, "timestamp": "04:48:55", "text": "地面。我想这就是我"}, {"type": "subtitle", "time": 17337.99, "timestamp": "04:48:57", "text": "现在应该和DOS有关了。是的。"}, {"type": "subtitle", "time": 17339.51, "timestamp": "04:48:59", "text": "这就是我应该做的。"}]
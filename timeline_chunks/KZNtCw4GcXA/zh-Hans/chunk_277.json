[{"type": "subtitle", "time": 16626.789, "timestamp": "04:37:06", "text": "艾普丽尔，你在吗？来吧，先生。"}, {"type": "subtitle", "time": 16630.789, "timestamp": "04:37:10", "text": "你好，艾普丽尔。哦，每个人都有"}, {"type": "subtitle", "time": 16646.709, "timestamp": "04:37:26", "text": "你好。你在这里吗？你在哪里？"}, {"type": "subtitle", "time": 16650.551, "timestamp": "04:37:30", "text": "你今年多大？你好，"}, {"type": "subtitle", "time": 16652.47, "timestamp": "04:37:32", "text": "四月。你为什么不呢？我要去……"}, {"type": "subtitle", "time": 16653.83, "timestamp": "04:37:33", "text": "地下室。你为什么不把门关上？"}, {"type": "subtitle", "time": 16667.91, "timestamp": "04:37:47", "text": "你好？你在这里吗？那里有一扇门。"}, {"type": "subtitle", "time": 16674.551, "timestamp": "04:37:54", "text": "我就像在找保险丝一样。"}, {"type": "subtitle", "time": 16677.429, "timestamp": "04:37:57", "text": "比如"}]
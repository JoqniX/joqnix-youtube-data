[{"type": "subtitle", "time": 9309.27, "timestamp": "02:35:09", "text": "禅。等待。禅。等待。什么？什么？什么？"}, {"type": "subtitle", "time": 9313.79, "timestamp": "02:35:13", "text": "等等，等等，等等，等等。禅玛沙比。禅"}, {"type": "subtitle", "time": 9325.27, "timestamp": "02:35:25", "text": "那？你好。我是唯一一个垫底的击杀者"}, {"type": "subtitle", "time": 9328.03, "timestamp": "02:35:28", "text": "在这个团队里。"}, {"type": "subtitle", "time": 9331.27, "timestamp": "02:35:31", "text": "好的。很高兴见到垫底的击杀者。"}, {"type": "subtitle", "time": 9340.07, "timestamp": "02:35:40", "text": "我还没准备好。"}]
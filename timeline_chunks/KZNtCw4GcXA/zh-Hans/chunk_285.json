[{"type": "subtitle", "time": 17102.47, "timestamp": "04:45:02", "text": "天哪，要30美元。我只有35"}, {"type": "subtitle", "time": 17105.43, "timestamp": "04:45:05", "text": "雄鹿。我的喉咙。我们需要什么？我"}, {"type": "subtitle", "time": 17107.43, "timestamp": "04:45:07", "text": "带点钱。"}, {"type": "subtitle", "time": 17109.91, "timestamp": "04:45:09", "text": "哦，不过我们需要手电筒。"}, {"type": "subtitle", "time": 17112.67, "timestamp": "04:45:12", "text": "手电筒？"}, {"type": "subtitle", "time": 17116.15, "timestamp": "04:45:16", "text": "呃，这是什么？"}, {"type": "subtitle", "time": 17118.15, "timestamp": "04:45:18", "text": "灵盒。但我们不需要精神"}, {"type": "subtitle", "time": 17119.75, "timestamp": "04:45:19", "text": "盒子。比如，我们什么都得不到。"}, {"type": "subtitle", "time": 17122.07, "timestamp": "04:45:22", "text": "由此而来。"}, {"type": "subtitle", "time": 17126.868, "timestamp": "04:45:26", "text": "电磁场。可能是电磁场。但是价格很贵。"}, {"type": "subtitle", "time": 17129.51, "timestamp": "04:45:29", "text": "是的。真蠢。"}, {"type": "subtitle", "time": 17132.15, "timestamp": "04:45:32", "text": "Wick多少钱？我没有"}, {"type": "subtitle", "time": 17133.91, "timestamp": "04:45:33", "text": "差不多就是这样。但你知道吗？我们开始吧"}, {"type": "subtitle", "time": 17135.91, "timestamp": "04:45:35", "text": "咱们走吧，就像“咱们走吧，飞机”一样。我们走吧"}, {"type": "subtitle", "time": 17137.51, "timestamp": "04:45:37", "text": "飞机。没关系。准备好了。我们开始吧"}, {"type": "subtitle", "time": 17140.788, "timestamp": "04:45:40", "text": "忠诚度提升。好的。"}, {"type": "subtitle", "time": 17143.43, "timestamp": "04:45:43", "text": "好的。我们可以做到。塞拉斯蒂娅，你……"}, {"type": "subtitle", "time": 17146.31, "timestamp": "04:45:46", "text": "加个手电筒？我再加两个。"}, {"type": "subtitle", "time": 17148.47, "timestamp": "04:45:48", "text": "所以，我想我们有三支手电筒。"}, {"type": "subtitle", "time": 17151.11, "timestamp": "04:45:51", "text": "不，没有添加。是的，我没有添加"}, {"type": "subtitle", "time": 17153.67, "timestamp": "04:45:53", "text": "它。添加。不，不，不。不用担心。到达"}, {"type": "subtitle", "time": 17156.55, "timestamp": "04:45:56", "text": "董事会。嗯。然后你就买了，对吧？"}, {"type": "subtitle", "time": 17159.75, "timestamp": "04:45:59", "text": "然后转到加载器，然后添加。哦，"}]
[{"type": "subtitle", "time": 10380.67, "timestamp": "02:53:00", "text": "10月26日。接下来就是……"}, {"type": "subtitle", "time": 10382.87, "timestamp": "02:53:02", "text": "周四。那是我做过的事情之一"}, {"type": "subtitle", "time": 10387.309, "timestamp": "02:53:07", "text": "想说的是……"}, {"type": "subtitle", "time": 10390.51, "timestamp": "02:53:10", "text": "今天。是的，我很期待……"}, {"type": "subtitle", "time": 10393.03, "timestamp": "02:53:13", "text": "今天。是我感觉错了吗？还是你突然断线了？"}, {"type": "subtitle", "time": 10394.79, "timestamp": "02:53:14", "text": "等等，我要退出了。等等，我是"}, {"type": "subtitle", "time": 10398.19, "timestamp": "02:53:18", "text": "切断。等等，我是"}, {"type": "subtitle", "time": 10401.469, "timestamp": "02:53:21", "text": "我？等待，"}, {"type": "subtitle", "time": 10405.07, "timestamp": "02:53:25", "text": "真的吗？我要退出。"}, {"type": "subtitle", "time": 10408.269, "timestamp": "02:53:28", "text": "什么？什么？"}, {"type": "subtitle", "time": 10411.59, "timestamp": "02:53:31", "text": "嗯？哦，不。无需等待。这是"}, {"type": "subtitle", "time": 10413.07, "timestamp": "02:53:33", "text": "坏的。这是"}, {"type": "subtitle", "time": 10419.15, "timestamp": "02:53:39", "text": "坏的。啊。现在可以了吗？这样可以吗？"}, {"type": "subtitle", "time": 10422.51, "timestamp": "02:53:42", "text": "现在？没关系。"}, {"type": "subtitle", "time": 10439.23, "timestamp": "02:53:59", "text": "我的"}]
[{"type": "subtitle", "time": 15961.51, "timestamp": "04:26:01", "text": "我有点慢，但这是"}, {"type": "subtitle", "time": 15965.75, "timestamp": "04:26:05", "text": "美好的。哦，等等。哦，设置。我的天哪。哦"}, {"type": "subtitle", "time": 15968.229, "timestamp": "04:26:08", "text": "上帝。他们。呃，我有吗？我不知道"}, {"type": "subtitle", "time": 15969.67, "timestamp": "04:26:09", "text": "它的作用是什么，但我还是要保留"}, {"type": "subtitle", "time": 15971.59, "timestamp": "04:26:11", "text": "它。"}, {"type": "subtitle", "time": 15974.51, "timestamp": "04:26:14", "text": "所有东西都很低。一切都是"}, {"type": "subtitle", "time": 15977.51, "timestamp": "04:26:17", "text": "低的。幸运的是，一切都好，但我不能留下来。"}, {"type": "subtitle", "time": 15979.59, "timestamp": "04:26:19", "text": "一直到最后，是的。是的。是的。"}, {"type": "subtitle", "time": 15982.51, "timestamp": "04:26:22", "text": "没关系。没关系。那将是"}, {"type": "subtitle", "time": 15985.75, "timestamp": "04:26:25", "text": "总是采取"}, {"type": "subtitle", "time": 15989.51, "timestamp": "04:26:29", "text": "我有手电筒。是的。我"}, {"type": "subtitle", "time": 15991.269, "timestamp": "04:26:31", "text": "如果您喜欢，我将非常感激。"}, {"type": "subtitle", "time": 15993.63, "timestamp": "04:26:33", "text": "未来。"}, {"type": "subtitle", "time": 15997.11, "timestamp": "04:26:37", "text": "为什么，呃，为什么我，为什么我拿了"}, {"type": "subtitle", "time": 15999.349, "timestamp": "04:26:39", "text": "手电筒？没什么私人恩怨。我"}, {"type": "subtitle", "time": 16001.11, "timestamp": "04:26:41", "text": "你是唯一一个拥有……的人"}, {"type": "subtitle", "time": 16003.67, "timestamp": "04:26:43", "text": "手电筒。是的。哦好的。我要去"}, {"type": "subtitle", "time": 16006.71, "timestamp": "04:26:46", "text": "搜索类似开关之类的东西。哦，"}, {"type": "subtitle", "time": 16008.87, "timestamp": "04:26:48", "text": "我们已经有五六个了，差不多十个吧。"}, {"type": "subtitle", "time": 16012.229, "timestamp": "04:26:52", "text": "10°。是的。哦，所以开关不起作用"}, {"type": "subtitle", "time": 16013.99, "timestamp": "04:26:53", "text": "工作。所以，停电了。"}, {"type": "subtitle", "time": 16017.59, "timestamp": "04:26:57", "text": "已经。哦，是的。真是噩梦。为什么"}, {"type": "subtitle", "time": 16019.55, "timestamp": "04:26:59", "text": "这扇门是半扇吗？"}]
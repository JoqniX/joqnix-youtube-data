[{"type": "subtitle", "time": 15784.55, "timestamp": "04:23:04", "text": "你们选的是随机的。"}, {"type": "subtitle", "time": 15787.51, "timestamp": "04:23:07", "text": "不，等等。让我先说一下，我刚拿到"}, {"type": "subtitle", "time": 15789.99, "timestamp": "04:23:09", "text": "愣。我很抱歉。好的。我选择了"}, {"type": "subtitle", "time": 15792.229, "timestamp": "04:23:12", "text": "随机的。哦，等等。我们需要点赞购买"}, {"type": "subtitle", "time": 15794.469, "timestamp": "04:23:14", "text": "东西，对吧？哦，他们好像改变了"}, {"type": "subtitle", "time": 15797.429, "timestamp": "04:23:17", "text": "用户界面。好的。是的，他们重置了整个系统。"}, {"type": "subtitle", "time": 15799.67, "timestamp": "04:23:19", "text": "事物。是的，一切看起来都很完美。"}, {"type": "subtitle", "time": 15807.59, "timestamp": "04:23:27", "text": "这是可以买任何东西的钱。"}, {"type": "subtitle", "time": 15809.11, "timestamp": "04:23:29", "text": "哦，我们走吧。哦，我们没钱。"}, {"type": "subtitle", "time": 15811.03, "timestamp": "04:23:31", "text": "凉爽的。没关系，兄弟。你知道吗？"}, {"type": "subtitle", "time": 15813.03, "timestamp": "04:23:33", "text": "让我们直接进入噩梦模式。"}, {"type": "subtitle", "time": 15815.11, "timestamp": "04:23:35", "text": "我们走吧。是的，晚上，哦，我们正在做"}, {"type": "subtitle", "time": 15818.87, "timestamp": "04:23:38", "text": "噩梦模式。好吧，谁在乎呢。"}, {"type": "subtitle", "time": 15821.349, "timestamp": "04:23:41", "text": "那不是最难的吗？"}, {"type": "subtitle", "time": 15823.91, "timestamp": "04:23:43", "text": "不，不，不。不，不，不。杰克克服了它"}, {"type": "subtitle", "time": 15825.59, "timestamp": "04:23:45", "text": "拥有同样强大的友谊力量。"}, {"type": "subtitle", "time": 15828.149, "timestamp": "04:23:48", "text": "友谊。当然。当然。准备好"}, {"type": "subtitle", "time": 15829.99, "timestamp": "04:23:49", "text": "向上。准备好了，杰克。我们能做到。"}, {"type": "subtitle", "time": 15832.149, "timestamp": "04:23:52", "text": "好的。是的，我们能做到。我相信"}, {"type": "subtitle", "time": 15835.51, "timestamp": "04:23:55", "text": "我们。微笑。我们可能会损失更多钱"}, {"type": "subtitle", "time": 15839.229, "timestamp": "04:23:59", "text": "一美元，老兄。快点。我们走吧。"}]
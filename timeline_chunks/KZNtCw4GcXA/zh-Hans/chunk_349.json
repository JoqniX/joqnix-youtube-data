[{"type": "subtitle", "time": 20943.39, "timestamp": "05:49:03", "text": "有时候我觉得"}, {"type": "subtitle", "time": 20953.948, "timestamp": "05:49:13", "text": "这是新观众。"}, {"type": "subtitle", "time": 20956.67, "timestamp": "05:49:16", "text": "我感觉"}, {"type": "subtitle", "time": 20958.75, "timestamp": "05:49:18", "text": "喜欢"}, {"type": "subtitle", "time": 20961.51, "timestamp": "05:49:21", "text": "总有一天会有人说，我觉得某人"}, {"type": "subtitle", "time": 20964.47, "timestamp": "05:49:24", "text": "我曾经说过，也许我忘了，但是"}, {"type": "subtitle", "time": 20966.948, "timestamp": "05:49:26", "text": "那种感觉，哦，你曾经是个男孩"}, {"type": "subtitle", "time": 20969.19, "timestamp": "05:49:29", "text": "你以为你是在跟我们开玩笑吗？"}, {"type": "subtitle", "time": 20971.11, "timestamp": "05:49:31", "text": "那么，这类问题就属于此类。"}, {"type": "subtitle", "time": 20973.43, "timestamp": "05:49:33", "text": "现在就来了，就是这样。"}, {"type": "subtitle", "time": 20975.15, "timestamp": "05:49:35", "text": "这就是我感到的原因"}, {"type": "subtitle", "time": 20979.59, "timestamp": "05:49:39", "text": "有点奇怪。这也是我认为的原因。"}, {"type": "subtitle", "time": 20982.868, "timestamp": "05:49:42", "text": "当布里特在这里的时候，他也……"}, {"type": "subtitle", "time": 20986.15, "timestamp": "05:49:46", "text": "注意到我说话的方式"}, {"type": "subtitle", "time": 20990.19, "timestamp": "05:49:50", "text": "呃，对，我是个男孩之类的。"}, {"type": "subtitle", "time": 20993.39, "timestamp": "05:49:53", "text": "因为不"}, {"type": "subtitle", "time": 20996.27, "timestamp": "05:49:56", "text": "就像我不知道一样"}]
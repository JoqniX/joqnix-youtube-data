[{"type": "subtitle", "time": 21662.708, "timestamp": "06:01:02", "text": "好笑的笑话？"}, {"type": "chat", "time": 21664.58, "timestamp": "06:01:04", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "@Bread Guy? u got a fair point there, i give up"}, {"type": "subtitle", "time": 21665.27, "timestamp": "06:01:05", "text": "我有没有跟你讲过那条小溪的故事"}, {"type": "chat", "time": 21666.553, "timestamp": "06:01:06", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "this is like that croissant conversation I hate this!!!"}, {"type": "subtitle", "time": 21668.31, "timestamp": "06:01:08", "text": "我拜访过的一个主播，他们是"}, {"type": "subtitle", "time": 21672.47, "timestamp": "06:01:12", "text": "比如随意地嘲讽和爆粗口，"}, {"type": "subtitle", "time": 21677.03, "timestamp": "06:01:17", "text": "就像把f开头的词叫做n开头的词一样"}, {"type": "subtitle", "time": 21680.868, "timestamp": "06:01:20", "text": "直播中充斥着脏话等等等等"}, {"type": "subtitle", "time": 21684.03, "timestamp": "06:01:24", "text": "观众并对他们进行批判性嘲讽"}, {"type": "chat", "time": 21685.94, "timestamp": "06:01:25", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "croissant coversation?"}, {"type": "subtitle", "time": 21686.19, "timestamp": "06:01:26", "text": "嗯"}, {"type": "subtitle", "time": 21692.99, "timestamp": "06:01:32", "text": "不是印度人"}, {"type": "chat", "time": 21693.555, "timestamp": "06:01:33", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "wut was that"}, {"type": "subtitle", "time": 21695.91, "timestamp": "06:01:35", "text": "主播。呃，是的，那是个印度人"}, {"type": "subtitle", "time": 21699.11, "timestamp": "06:01:39", "text": "主播，然后我就想，我看了聊天记录。"}, {"type": "subtitle", "time": 21701.67, "timestamp": "06:01:41", "text": "好像他们特意提到过"}, {"type": "chat", "time": 21702.073, "timestamp": "06:01:42", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "just hear me say the word"}, {"type": "subtitle", "time": 21703.51, "timestamp": "06:01:43", "text": "如果你心地善良"}, {"type": "subtitle", "time": 21706.15, "timestamp": "06:01:46", "text": "呃，一个把它当回事的人"}, {"type": "subtitle", "time": 21708.23, "timestamp": "06:01:48", "text": "请不要来我的直播间。"}, {"type": "chat", "time": 21708.716, "timestamp": "06:01:48", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "him*"}, {"type": "subtitle", "time": 21711.59, "timestamp": "06:01:51", "text": "我说“是”，就像在开玩笑等等。"}, {"type": "subtitle", "time": 21713.91, "timestamp": "06:01:53", "text": "出于恶搞的目的等等"}, {"type": "subtitle", "time": 21716.31, "timestamp": "06:01:56", "text": "除此之外，所有那些东西，他们都很……"}, {"type": "chat", "time": 21718.22, "timestamp": "06:01:58", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "joq, say croissant"}, {"type": "subtitle", "time": 21718.868, "timestamp": "06:01:58", "text": "通过框架，政治上也是如此。"}]
[{"type": "subtitle", "time": 18002.03, "timestamp": "05:00:02", "text": "晚的。有点晚了。但"}, {"type": "subtitle", "time": 18013.51, "timestamp": "05:00:13", "text": "每个人。好的，等等。现在是4点30分。我"}, {"type": "subtitle", "time": 18016.788, "timestamp": "05:00:16", "text": "说实话，我真不想回来。"}, {"type": "subtitle", "time": 18017.708, "timestamp": "05:00:17", "text": "真的"}, {"type": "subtitle", "time": 18021.51, "timestamp": "05:00:21", "text": "虽然时间很晚了，但我感觉需要休息一下。"}, {"type": "subtitle", "time": 18025.27, "timestamp": "05:00:25", "text": "于是我让她休息了。"}, {"type": "subtitle", "time": 18027.15, "timestamp": "05:00:27", "text": "所以，"}, {"type": "subtitle", "time": 18029.15, "timestamp": "05:00:29", "text": "所以"}, {"type": "subtitle", "time": 18031.628, "timestamp": "05:00:31", "text": "因此"}, {"type": "subtitle", "time": 18042.75, "timestamp": "05:00:42", "text": "嗯，晚上"}, {"type": "subtitle", "time": 18046.55, "timestamp": "05:00:46", "text": "会议。让我再确认一下我是否在线"}, {"type": "subtitle", "time": 18048.628, "timestamp": "05:00:48", "text": "溪流。是的，我正在直播。在"}, {"type": "subtitle", "time": 18051.948, "timestamp": "05:00:51", "text": "晚上我想做一些"}, {"type": "subtitle", "time": 18054.628, "timestamp": "05:00:54", "text": "事物。当然，我本来可以的。"}, {"type": "subtitle", "time": 18057.948, "timestamp": "05:00:57", "text": "玩《Valerant》或其他任何游戏"}]
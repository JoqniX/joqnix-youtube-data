[{"type": "subtitle", "time": 10982.71, "timestamp": "03:03:02", "text": "他们喜欢他们，他们回去了"}, {"type": "subtitle", "time": 10986.309, "timestamp": "03:03:06", "text": "猴子模式。我知道。"}, {"type": "subtitle", "time": 10988.79, "timestamp": "03:03:08", "text": "为什么说这是类比？"}, {"type": "subtitle", "time": 10991.269, "timestamp": "03:03:11", "text": "一切都糟透了。我喜欢它。我"}, {"type": "subtitle", "time": 10994.309, "timestamp": "03:03:14", "text": "爱它。没关系。是的。呃，我们走吧"}, {"type": "subtitle", "time": 10995.67, "timestamp": "03:03:15", "text": "进去。走吧。你们都能听到"}, {"type": "subtitle", "time": 10997.99, "timestamp": "03:03:17", "text": "是音频，对吧？它像吗？它是一个吗？"}, {"type": "subtitle", "time": 10999.51, "timestamp": "03:03:19", "text": "困难之处？我不这么认为。"}, {"type": "subtitle", "time": 11002.309, "timestamp": "03:03:22", "text": "正确的。呃，我的意思是，知道你是否能接受"}, {"type": "subtitle", "time": 11005.269, "timestamp": "03:03:25", "text": "火炬、光、毒药。呃，不。我没有"}, {"type": "subtitle", "time": 11007.59, "timestamp": "03:03:27", "text": "先把手电筒拿过来。呃，我们没有"}, {"type": "subtitle", "time": 11009.429, "timestamp": "03:03:29", "text": "带手电筒。我们没有，我们不需要"}, {"type": "subtitle", "time": 11011.67, "timestamp": "03:03:31", "text": "一支手电筒。没关系。没关系。不"}, {"type": "subtitle", "time": 11013.75, "timestamp": "03:03:33", "text": "需要手电筒。我们可能会失明。它是"}, {"type": "subtitle", "time": 11017.429, "timestamp": "03:03:37", "text": "美好的。我要买它。"}, {"type": "subtitle", "time": 11019.269, "timestamp": "03:03:39", "text": "我有点慢，但这是"}, {"type": "subtitle", "time": 11023.11, "timestamp": "03:03:43", "text": "美好的。哦，等等。哦，设置。我的天哪。"}, {"type": "subtitle", "time": 11026.07, "timestamp": "03:03:46", "text": "我的天哪。呃，我必须这样做吗？我不知道。"}, {"type": "subtitle", "time": 11027.51, "timestamp": "03:03:47", "text": "它的作用是什么，但我还是要保留"}, {"type": "subtitle", "time": 11029.429, "timestamp": "03:03:49", "text": "它。"}, {"type": "subtitle", "time": 11032.349, "timestamp": "03:03:52", "text": "所有东西都很低。一切都是"}, {"type": "subtitle", "time": 11035.349, "timestamp": "03:03:55", "text": "低的。幸运的是，一切都好，但我不能留下来。"}, {"type": "subtitle", "time": 11037.429, "timestamp": "03:03:57", "text": "直到最后。是的。是的。是的。"}, {"type": "subtitle", "time": 11038.91, "timestamp": "03:03:58", "text": "没关系。没关系。那将是"}]
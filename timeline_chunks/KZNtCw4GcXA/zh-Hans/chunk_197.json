[{"type": "subtitle", "time": 11827.229, "timestamp": "03:17:07", "text": "哦。哦，没什么。哦"}, {"type": "subtitle", "time": 11835.07, "timestamp": "03:17:15", "text": "嘿。是的，灯已经装好了。"}, {"type": "subtitle", "time": 11836.63, "timestamp": "03:17:16", "text": "[音乐]"}, {"type": "subtitle", "time": 11841.429, "timestamp": "03:17:21", "text": "你好。"}, {"type": "subtitle", "time": 11843.99, "timestamp": "03:17:23", "text": "你在这里吗？艾普丽尔，你在吗？"}, {"type": "subtitle", "time": 11846.79, "timestamp": "03:17:26", "text": "你想和我们谈谈吗？他们多大了？"}, {"type": "subtitle", "time": 11853.269, "timestamp": "03:17:33", "text": "我喜欢你问他们多大这个问题。"}, {"type": "subtitle", "time": 11856.07, "timestamp": "03:17:36", "text": "你。哦，那是默认设置。那是"}, {"type": "subtitle", "time": 11857.83, "timestamp": "03:17:37", "text": "这是你必须问的一个默认问题。"}, {"type": "subtitle", "time": 11861.83, "timestamp": "03:17:41", "text": "以 Fasmo 的方式。真的吗？真的吗？"}, {"type": "subtitle", "time": 11864.07, "timestamp": "03:17:44", "text": "鬼影时代。"}, {"type": "subtitle", "time": 11866.229, "timestamp": "03:17:46", "text": "为什么我一个人在地下室？这是"}, {"type": "subtitle", "time": 11869.03, "timestamp": "03:17:49", "text": "坏的。不，不，你做得很好。你是"}, {"type": "subtitle", "time": 11871.03, "timestamp": "03:17:51", "text": "一切都很好。是的，没问题。哦，"}, {"type": "subtitle", "time": 11872.55, "timestamp": "03:17:52", "text": "杰克，看着我。看着我。我要去"}]
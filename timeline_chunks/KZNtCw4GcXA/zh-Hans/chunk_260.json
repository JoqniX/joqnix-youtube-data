[{"type": "subtitle", "time": 15601.99, "timestamp": "04:20:01", "text": "我得确认一下是白色还是黄色。"}, {"type": "subtitle", "time": 15605.309, "timestamp": "04:20:05", "text": "你说的黄雪是什么意思？"}, {"type": "subtitle", "time": 15607.91, "timestamp": "04:20:07", "text": "什么？只有白雪。什么"}, {"type": "subtitle", "time": 15619.429, "timestamp": "04:20:19", "text": "你好呀。你好。你好。你好"}, {"type": "subtitle", "time": 15622.63, "timestamp": "04:20:22", "text": "每个人。你好。你好吗？我想要"}, {"type": "subtitle", "time": 15630.55, "timestamp": "04:20:30", "text": "我不……这就像被毁了一样。"}, {"type": "subtitle", "time": 15634.229, "timestamp": "04:20:34", "text": "自动播放，但就像我想要的那样，哦，"}, {"type": "subtitle", "time": 15637.11, "timestamp": "04:20:37", "text": "塞莱斯蒂亚。好的。哦，外面那个人是我。"}, {"type": "subtitle", "time": 15639.429, "timestamp": "04:20:39", "text": "窗户。这很酷。是的，就是这样。"}, {"type": "subtitle", "time": 15643.75, "timestamp": "04:20:43", "text": "Celestia 和你一起玩“茶包”游戏。不，喜欢"}, {"type": "subtitle", "time": 15651.229, "timestamp": "04:20:51", "text": "提格你。等等，别这样"}]
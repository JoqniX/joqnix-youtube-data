[{"type": "subtitle", "time": 13501.91, "timestamp": "03:45:01", "text": "尽管。我的天啊。看看维克。"}, {"type": "subtitle", "time": 13504.55, "timestamp": "03:45:04", "text": "他有一双猫眼。我的天啊。和"}, {"type": "subtitle", "time": 13507.07, "timestamp": "03:45:07", "text": "那就是我，字面意义上的我。"}, {"type": "subtitle", "time": 13517.469, "timestamp": "03:45:17", "text": "害羞的。但"}, {"type": "subtitle", "time": 13520.67, "timestamp": "03:45:20", "text": "是啊，不过没关系。呃"}, {"type": "subtitle", "time": 13523.11, "timestamp": "03:45:23", "text": "最终，要么本月，要么下个月，我们"}, {"type": "subtitle", "time": 13526.95, "timestamp": "03:45:26", "text": "将会玩恐怖游戏。那是"}, {"type": "subtitle", "time": 13529.07, "timestamp": "03:45:29", "text": "今天之后"}, {"type": "subtitle", "time": 13532.229, "timestamp": "03:45:32", "text": "明天。我将扮演一个准社会角色"}, {"type": "subtitle", "time": 13534.67, "timestamp": "03:45:34", "text": "此外，还有一个关于吞噬的合作项目。"}, {"type": "subtitle", "time": 13537.349, "timestamp": "03:45:37", "text": "夜晚。我不知道一切是如何发生的。"}, {"type": "subtitle", "time": 13540.349, "timestamp": "03:45:40", "text": "那时将会是……"}, {"type": "subtitle", "time": 13547.309, "timestamp": "03:45:47", "text": "说"}, {"type": "subtitle", "time": 13551.03, "timestamp": "03:45:51", "text": "我会尽力而为。是的，恐怖片是"}, {"type": "subtitle", "time": 13552.269, "timestamp": "03:45:52", "text": "我不了解"}, {"type": "subtitle", "time": 13554.83, "timestamp": "03:45:54", "text": "喜欢。这是"}, {"type": "subtitle", "time": 13558.59, "timestamp": "03:45:58", "text": "具有挑战性的。这很难。这是"}]
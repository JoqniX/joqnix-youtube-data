[{"type": "subtitle", "time": 17162.07, "timestamp": "04:46:02", "text": "就是这样做的。"}, {"type": "subtitle", "time": 17165.83, "timestamp": "04:46:05", "text": "你们，他们，他们把事情简化了，而且不是"}, {"type": "subtitle", "time": 17167.11, "timestamp": "04:46:07", "text": "同时又很简单。我不知道"}, {"type": "subtitle", "time": 17169.19, "timestamp": "04:46:09", "text": "他们是怎么得出这个结论的呢？"}, {"type": "subtitle", "time": 17177.43, "timestamp": "04:46:17", "text": "一。你可以去掉一个来省钱。我"}, {"type": "subtitle", "time": 17180.55, "timestamp": "04:46:20", "text": "估计不会，不会，它会在我们的负荷中。"}, {"type": "subtitle", "time": 17183.03, "timestamp": "04:46:23", "text": "出去。我想这已经足够了。"}, {"type": "subtitle", "time": 17188.31, "timestamp": "04:46:28", "text": "实际上。我的天，我明白了。"}, {"type": "subtitle", "time": 17191.35, "timestamp": "04:46:31", "text": "哦，我有手电筒。等等，给我"}, {"type": "subtitle", "time": 17193.91, "timestamp": "04:46:33", "text": "一分钟。我以为它会移除。"}, {"type": "subtitle", "time": 17197.27, "timestamp": "04:46:37", "text": "当你快要死了的时候，用手电筒。"}, {"type": "subtitle", "time": 17200.31, "timestamp": "04:46:40", "text": "没关系。我有手电筒。我会"}, {"type": "subtitle", "time": 17203.51, "timestamp": "04:46:43", "text": "添加不要呃，请告诉我我的音频是否正常"}, {"type": "subtitle", "time": 17206.15, "timestamp": "04:46:46", "text": "就像我显然有的那样"}, {"type": "subtitle", "time": 17208.23, "timestamp": "04:46:48", "text": "手电筒。那真是太酷了"}, {"type": "subtitle", "time": 17211.91, "timestamp": "04:46:51", "text": "当我准备好的时候。我准备好了。"}, {"type": "subtitle", "time": 17216.15, "timestamp": "04:46:56", "text": "哦好的。我不知道。我当时想，呃，我"}, {"type": "subtitle", "time": 17218.51, "timestamp": "04:46:58", "text": "我以为我会输"}]
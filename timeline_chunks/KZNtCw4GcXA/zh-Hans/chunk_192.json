[{"type": "subtitle", "time": 11520.75, "timestamp": "03:12:00", "text": "死得快点。"}, {"type": "subtitle", "time": 11522.95, "timestamp": "03:12:02", "text": "中间的。你知道吗？"}, {"type": "subtitle", "time": 11524.63, "timestamp": "03:12:04", "text": "专业的。"}, {"type": "subtitle", "time": 11526.71, "timestamp": "03:12:06", "text": "让我们走向专业化。"}, {"type": "subtitle", "time": 11528.63, "timestamp": "03:12:08", "text": "中级将会是它即将到来"}, {"type": "subtitle", "time": 11530.95, "timestamp": "03:12:10", "text": "如果你……那就会变得很无聊。"}, {"type": "subtitle", "time": 11532.389, "timestamp": "03:12:12", "text": "准备升入中级。专业的，"}, {"type": "subtitle", "time": 11535.91, "timestamp": "03:12:15", "text": "我认为。死得快也好，死得慢也罢。没人关心。"}, {"type": "subtitle", "time": 11538.23, "timestamp": "03:12:18", "text": "就这么办吧。"}, {"type": "subtitle", "time": 11547.309, "timestamp": "03:12:27", "text": "耶。"}, {"type": "subtitle", "time": 11564.389, "timestamp": "03:12:44", "text": "哦，是的。继续。我仍然忘记了如果"}, {"type": "subtitle", "time": 11566.95, "timestamp": "03:12:46", "text": "我们死了，我们就丢了装备。是的，就是这样。"}, {"type": "subtitle", "time": 11570.95, "timestamp": "03:12:50", "text": "美好的。没关系。"}, {"type": "subtitle", "time": 11573.91, "timestamp": "03:12:53", "text": "这算真的吗？是的，那是一个"}, {"type": "subtitle", "time": 11576.309, "timestamp": "03:12:56", "text": "事物。是的，没问题。那就别死了。"}, {"type": "subtitle", "time": 11578.389, "timestamp": "03:12:58", "text": "没关系。是啊，咱们就都……"}]
[{"type": "subtitle", "time": 16021.87, "timestamp": "04:27:01", "text": "打开？"}, {"type": "subtitle", "time": 16025.91, "timestamp": "04:27:05", "text": "帮助。哦，不。雅克先生，您在哪里？"}, {"type": "subtitle", "time": 16027.83, "timestamp": "04:27:07", "text": "呃"}, {"type": "subtitle", "time": 16029.59, "timestamp": "04:27:09", "text": "你们看过关于鬼魂的故事吗？"}, {"type": "subtitle", "time": 16033.349, "timestamp": "04:27:13", "text": "那个鬼魂到底是什么来头？不。"}, {"type": "subtitle", "time": 16037.59, "timestamp": "04:27:17", "text": "不，我没有。好吧，我做不到。等等，为什么？"}, {"type": "subtitle", "time": 16039.83, "timestamp": "04:27:19", "text": "这东西是半开着的吗？等等，是"}, {"type": "subtitle", "time": 16042.469, "timestamp": "04:27:22", "text": "里面有人吗？"}, {"type": "subtitle", "time": 16044.389, "timestamp": "04:27:24", "text": "没有什么。我马上回来。"}, {"type": "subtitle", "time": 16045.67, "timestamp": "04:27:25", "text": "我打算读读关于鬼魂的真实故事。"}, {"type": "subtitle", "time": 16049.11, "timestamp": "04:27:29", "text": "快的。好的。哦。哦，你必须这样做"}, {"type": "subtitle", "time": 16051.75, "timestamp": "04:27:31", "text": "那。哦，没事了。我只是在拥抱"}, {"type": "subtitle", "time": 16053.67, "timestamp": "04:27:33", "text": "只是为了以防万一才需要建墙。这是"}, {"type": "subtitle", "time": 16055.51, "timestamp": "04:27:35", "text": "普通的。这是正常现象。我的双手是"}, {"type": "subtitle", "time": 16059.99, "timestamp": "04:27:39", "text": "摇晃。我的眼睛是血的。"}, {"type": "subtitle", "time": 16063.75, "timestamp": "04:27:43", "text": "我的名字是芭芭拉。"}, {"type": "subtitle", "time": 16065.309, "timestamp": "04:27:45", "text": "好的。是的。"}, {"type": "subtitle", "time": 16069.11, "timestamp": "04:27:49", "text": "芭芭拉·巴巴德。我的天啊。她是一个"}, {"type": "subtitle", "time": 16071.269, "timestamp": "04:27:51", "text": "一位治疗师。她还不错。"}, {"type": "subtitle", "time": 16075.309, "timestamp": "04:27:55", "text": "治疗师。是的。我很害怕。"}, {"type": "subtitle", "time": 16077.75, "timestamp": "04:27:57", "text": "你好。你能进那个房间吗？"}]
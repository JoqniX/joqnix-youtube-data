[{"type": "subtitle", "time": 18667.43, "timestamp": "05:11:07", "text": "[音乐]"}, {"type": "subtitle", "time": 18675.19, "timestamp": "05:11:15", "text": "因Twitch直播而闻名。我认为有办法。"}, {"type": "subtitle", "time": 18677.67, "timestamp": "05:11:17", "text": "设置它，使其显示："}, {"type": "subtitle", "time": 18678.83, "timestamp": "05:11:18", "text": "播送"}, {"type": "subtitle", "time": 18681.83, "timestamp": "05:11:21", "text": "YouTube 的生涯结束了。这就是我的想法"}, {"type": "subtitle", "time": 18683.91, "timestamp": "05:11:23", "text": "令人担忧。"}, {"type": "subtitle", "time": 18687.15, "timestamp": "05:11:27", "text": "为什么我的心跳是这样的"}, {"type": "subtitle", "time": 18690.27, "timestamp": "05:11:30", "text": "我知道该流所在的系统"}, {"type": "subtitle", "time": 18693.99, "timestamp": "05:11:33", "text": "哔哔哔哔声正在响起吗？如果是的话"}, {"type": "subtitle", "time": 18696.99, "timestamp": "05:11:36", "text": "停止发出哔哔声意味着它……"}, {"type": "subtitle", "time": 18708.35, "timestamp": "05:11:48", "text": "我不知道我需要调查一下"}, {"type": "subtitle", "time": 18711.67, "timestamp": "05:11:51", "text": "我内心深处想要把东西变成……"}, {"type": "subtitle", "time": 18713.83, "timestamp": "05:11:53", "text": "我的一部分想玩游戏"}, {"type": "subtitle", "time": 18715.948, "timestamp": "05:11:55", "text": "我只想结束这一切。"}]
[{"type": "subtitle", "time": 18960.35, "timestamp": "05:16:00", "text": "我拿到新手机后就可以开始直播了"}, {"type": "subtitle", "time": 18963.07, "timestamp": "05:16:03", "text": "笔记本电脑。所以"}, {"type": "subtitle", "time": 18966.23, "timestamp": "05:16:06", "text": "然后我还检查了交叉核对"}, {"type": "subtitle", "time": 18968.708, "timestamp": "05:16:08", "text": "我收到的作业。我是否"}, {"type": "subtitle", "time": 18970.19, "timestamp": "05:16:10", "text": "今天在我家"}, {"type": "subtitle", "time": 18973.35, "timestamp": "05:16:13", "text": "一切都太好了。他们实际上"}, {"type": "subtitle", "time": 18975.19, "timestamp": "05:16:15", "text": "把试卷和"}, {"type": "subtitle", "time": 18977.59, "timestamp": "05:16:17", "text": "作业答案。他们写道"}, {"type": "subtitle", "time": 18979.15, "timestamp": "05:16:19", "text": "一切"}, {"type": "subtitle", "time": 18982.07, "timestamp": "05:16:22", "text": "整齐地。我觉得那是个赚钱的井"}, {"type": "subtitle", "time": 18983.67, "timestamp": "05:16:23", "text": "花了不少钱，因为我写不出东西"}, {"type": "subtitle", "time": 18986.708, "timestamp": "05:16:26", "text": "任务。我花钱请人做的。呃"}, {"type": "subtitle", "time": 18990.31, "timestamp": "05:16:30", "text": "他们做到了，他们打包了他们呃"}, {"type": "subtitle", "time": 18993.75, "timestamp": "05:16:33", "text": "寄给我了。我认为快递"}, {"type": "subtitle", "time": 18996.948, "timestamp": "05:16:36", "text": "应该是送货上门。是的，那很好。"}, {"type": "subtitle", "time": 18999.868, "timestamp": "05:16:39", "text": "那真是太棒了。"}, {"type": "subtitle", "time": 19002.788, "timestamp": "05:16:42", "text": "好的。提交截止日期是"}, {"type": "subtitle", "time": 19006.99, "timestamp": "05:16:46", "text": "4月28日。那就像星期二一样。"}, {"type": "subtitle", "time": 19010.15, "timestamp": "05:16:50", "text": "正确的？那是星期一。哦，星期一是"}, {"type": "subtitle", "time": 19011.55, "timestamp": "05:16:51", "text": "最后期限。哦"}, {"type": "subtitle", "time": 19015.15, "timestamp": "05:16:55", "text": "上帝。哦，星期一是最后期限。"}]
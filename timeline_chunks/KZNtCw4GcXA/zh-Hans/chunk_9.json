[{"type": "subtitle", "time": 540.67, "timestamp": "00:09:00", "text": "归根结底，这取决于你"}, {"type": "subtitle", "time": 545.23, "timestamp": "00:09:05", "text": "就像我的声音是"}, {"type": "subtitle", "time": 547.829, "timestamp": "00:09:07", "text": "滞后。啊，我的声音有点沙哑，是吗？"}, {"type": "subtitle", "time": 564.67, "timestamp": "00:09:24", "text": "天哪，这"}, {"type": "subtitle", "time": 567.43, "timestamp": "00:09:27", "text": "真糟糕。你看，这就是我以为我告诉"}, {"type": "subtitle", "time": 569.75, "timestamp": "00:09:29", "text": "你们。"}]
[{"type": "subtitle", "time": 16081.51, "timestamp": "04:28:01", "text": "谢谢。我们需要像一个人一样"}, {"type": "subtitle", "time": 16083.429, "timestamp": "04:28:03", "text": "目睹鬼魂，其中一个逃跑"}, {"type": "subtitle", "time": 16086.71, "timestamp": "04:28:06", "text": "远离鬼魂并捕获电磁场"}, {"type": "subtitle", "time": 16090.07, "timestamp": "04:28:10", "text": "读取信号。"}, {"type": "subtitle", "time": 16094.95, "timestamp": "04:28:14", "text": "是的。你好。欢迎。是的。是的。"}, {"type": "subtitle", "time": 16096.229, "timestamp": "04:28:16", "text": "好的。你能进去吗？"}, {"type": "subtitle", "time": 16097.83, "timestamp": "04:28:17", "text": "请问哪里可以去洗手间？非常感谢。"}, {"type": "subtitle", "time": 16099.99, "timestamp": "04:28:19", "text": "呃，请展示一下你的手电筒。"}, {"type": "subtitle", "time": 16105.309, "timestamp": "04:28:25", "text": "是的，你需要去……"}, {"type": "subtitle", "time": 16109.03, "timestamp": "04:28:29", "text": "去地下室拿那玩意儿干嘛？"}, {"type": "subtitle", "time": 16111.11, "timestamp": "04:28:31", "text": "你管这叫什么？哦，是的。是的，"}, {"type": "subtitle", "time": 16112.63, "timestamp": "04:28:32", "text": "这"}, {"type": "subtitle", "time": 16115.51, "timestamp": "04:28:35", "text": "等等，这个量还在增加。"}, {"type": "subtitle", "time": 16120.79, "timestamp": "04:28:40", "text": "是的。我们检测到了电磁场。它就像一个。"}, {"type": "subtitle", "time": 16122.87, "timestamp": "04:28:42", "text": "哦，我们至少需要达到"}, {"type": "subtitle", "time": 16125.03, "timestamp": "04:28:45", "text": "四个，以便捕捉到那个。不，"}, {"type": "subtitle", "time": 16127.03, "timestamp": "04:28:47", "text": "不，不。我们需要五个。我们需要"}, {"type": "subtitle", "time": 16129.429, "timestamp": "04:28:49", "text": "五，不是四。我们需要五个，到……"}, {"type": "subtitle", "time": 16130.469, "timestamp": "04:28:50", "text": "方式。"}, {"type": "subtitle", "time": 16138.55, "timestamp": "04:28:58", "text": "我很害怕。我只是随便逛逛。"}]
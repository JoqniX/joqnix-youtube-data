[{"type": "subtitle", "time": 13563.59, "timestamp": "03:46:03", "text": "痛苦，但我会来，特别是通过弥撒。"}, {"type": "subtitle", "time": 13566.15, "timestamp": "03:46:06", "text": "用于准社会游戏。天哪，我听说"}, {"type": "subtitle", "time": 13591.11, "timestamp": "03:46:31", "text": "嗯，布拉德。谢谢你今天抽出时间。真的"}, {"type": "subtitle", "time": 13593.83, "timestamp": "03:46:33", "text": "意义重大。"}, {"type": "subtitle", "time": 13596.15, "timestamp": "03:46:36", "text": "谢谢光临。谢谢你"}, {"type": "subtitle", "time": 13598.55, "timestamp": "03:46:38", "text": "要有耐心。谢谢你画了这幅画"}, {"type": "subtitle", "time": 13601.349, "timestamp": "03:46:41", "text": "所有图片都以缩略图形式呈现。谢谢你"}, {"type": "subtitle", "time": 13602.71, "timestamp": "03:46:42", "text": "路过。希望你今天过得愉快。"}, {"type": "subtitle", "time": 13605.63, "timestamp": "03:46:45", "text": "我对此深感抱歉。"}, {"type": "subtitle", "time": 13608.269, "timestamp": "03:46:48", "text": "今天。野孩子来了"}, {"type": "subtitle", "time": 13611.83, "timestamp": "03:46:51", "text": "今天很想念你。谢谢光临"}, {"type": "subtitle", "time": 13615.51, "timestamp": "03:46:55", "text": "经过。 Hashi，谢谢你过来。"}, {"type": "subtitle", "time": 13617.269, "timestamp": "03:46:57", "text": "感谢你处理了这件事。"}]
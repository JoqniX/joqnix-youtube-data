[{"type": "subtitle", "time": 11400.71, "timestamp": "03:10:00", "text": "手电筒应该在我身上。"}, {"type": "subtitle", "time": 11403.51, "timestamp": "03:10:03", "text": "在楼上。嗯。哦，鬼魂是"}, {"type": "subtitle", "time": 11405.75, "timestamp": "03:10:05", "text": "上楼了。哦，不。是的。是的。跑步"}, {"type": "subtitle", "time": 11407.07, "timestamp": "03:10:07", "text": "离开。跑步"}, {"type": "subtitle", "time": 11411.19, "timestamp": "03:10:11", "text": "离开。我不想。我不想。"}, {"type": "subtitle", "time": 11412.63, "timestamp": "03:10:12", "text": "我不想。我真的做不到。这"}, {"type": "subtitle", "time": 11414.309, "timestamp": "03:10:14", "text": "鬼魂上楼了。独自玩。它是"}, {"type": "subtitle", "time": 11416.07, "timestamp": "03:10:16", "text": "这太愚蠢了。"}, {"type": "subtitle", "time": 11418.55, "timestamp": "03:10:18", "text": "哦，你噎住了。"}, {"type": "subtitle", "time": 11420.23, "timestamp": "03:10:20", "text": "是的，没问题。没关系。这是一个"}, {"type": "subtitle", "time": 11421.75, "timestamp": "03:10:21", "text": "轻柔地窒息。他就像在给我一个"}, {"type": "subtitle", "time": 11424.87, "timestamp": "03:10:24", "text": "颈部按摩。没关系。"}, {"type": "subtitle", "time": 11431.03, "timestamp": "03:10:31", "text": "哦，他们死了。好了，现在所有人都死了。"}, {"type": "subtitle", "time": 11432.55, "timestamp": "03:10:32", "text": "我觉得这就是噩梦的本质。"}, {"type": "subtitle", "time": 11434.07, "timestamp": "03:10:34", "text": "模式，对吧？它只会给你带来类似……"}, {"type": "subtitle", "time": 11436.79, "timestamp": "03:10:36", "text": "准备和运行需要一点时间"}, {"type": "subtitle", "time": 11442.95, "timestamp": "03:10:42", "text": "是的，这就像……你……"}, {"type": "subtitle", "time": 11445.269, "timestamp": "03:10:45", "text": "那叫什么？哦。每天和另一个人玩"}, {"type": "subtitle", "time": 11447.269, "timestamp": "03:10:47", "text": "研究者。我们得了100美元"}, {"type": "subtitle", "time": 11450.309, "timestamp": "03:10:50", "text": "没有什么。 50美元白得了。我们走吧。"}, {"type": "subtitle", "time": 11453.6, "timestamp": "03:10:53", "text": "我们走吧。 哇。"}, {"type": "subtitle", "time": 11455.12, "timestamp": "03:10:55", "text": "哇。 总之，你们想买东西吗？"}, {"type": "subtitle", "time": 11459.279, "timestamp": "03:10:59", "text": "总之，你们想买东西吗？ 买什么？"}]
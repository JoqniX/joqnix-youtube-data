[{"type": "subtitle", "time": 18783.31, "timestamp": "05:13:03", "text": "基于时间、类别和自动化的自动化"}, {"type": "subtitle", "time": 18787.47, "timestamp": "05:13:07", "text": "正确的？我们工作了四个小时。"}, {"type": "subtitle", "time": 18791.948, "timestamp": "05:13:11", "text": "就是用萨米牌的那个东西做那些东西。"}, {"type": "subtitle", "time": 18797.11, "timestamp": "05:13:17", "text": "是的，我可以在我需要的时候使用它。"}, {"type": "subtitle", "time": 18799.31, "timestamp": "05:13:19", "text": "但关键是我必须做到这一点。"}, {"type": "subtitle", "time": 18802.07, "timestamp": "05:13:22", "text": "动态的，或者我可以制作多个"}, {"type": "subtitle", "time": 18806.788, "timestamp": "05:13:26", "text": "图片。一份中午吃，一份午餐吃"}, {"type": "subtitle", "time": 18809.19, "timestamp": "05:13:29", "text": "休息，一个是上午休息，一个是"}, {"type": "subtitle", "time": 18812.31, "timestamp": "05:13:32", "text": "当我睡觉还没出现的时候，"}, {"type": "subtitle", "time": 18816.55, "timestamp": "05:13:36", "text": "一个是做什么用的？一个去"}, {"type": "subtitle", "time": 18818.83, "timestamp": "05:13:38", "text": "晚餐休息，下午茶时间。"}, {"type": "subtitle", "time": 18822.31, "timestamp": "05:13:42", "text": "休息。是的。是的。休息一下什么的。所以"}, {"type": "subtitle", "time": 18825.19, "timestamp": "05:13:45", "text": "问题在于，即使在今天，人们"}, {"type": "subtitle", "time": 18827.23, "timestamp": "05:13:47", "text": "我不明白这一点。"}, {"type": "subtitle", "time": 18830.27, "timestamp": "05:13:50", "text": "我把V放上去。不是这样的。"}, {"type": "subtitle", "time": 18833.19, "timestamp": "05:13:53", "text": "我。是人吗？是因为他们"}, {"type": "subtitle", "time": 18837.11, "timestamp": "05:13:57", "text": "看不清屏幕上的内容，或者因为"}]
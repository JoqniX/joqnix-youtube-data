[{"type": "subtitle", "time": 14107.03, "timestamp": "03:55:07", "text": "你好。非常非常感谢。尤其"}, {"type": "subtitle", "time": 14109.59, "timestamp": "03:55:09", "text": "感谢Vick和Celestia"}, {"type": "subtitle", "time": 14112.55, "timestamp": "03:55:12", "text": "邀请我和他们一起玩。那是一个"}, {"type": "subtitle", "time": 14114.55, "timestamp": "03:55:14", "text": "挺有意思的。虽然我当时不在那里。"}, {"type": "subtitle", "time": 14116.429, "timestamp": "03:55:16", "text": "虽然只有一半的溪流，但还是要感谢。"}, {"type": "subtitle", "time": 14119.51, "timestamp": "03:55:19", "text": "你。很高兴你玩了这两款游戏"}, {"type": "subtitle", "time": 14121.91, "timestamp": "03:55:21", "text": "我们玩得很开心。我期待着"}, {"type": "subtitle", "time": 14124.309, "timestamp": "03:55:24", "text": "未来期待与你们二位合作"}, {"type": "subtitle", "time": 14126.469, "timestamp": "03:55:26", "text": "出色地。是的，感谢那些"}, {"type": "subtitle", "time": 14130.07, "timestamp": "03:55:30", "text": "等待着，那些有耐心等待的人"}, {"type": "subtitle", "time": 14133.189, "timestamp": "03:55:33", "text": "仍然抱有希望。谢谢你们"}, {"type": "subtitle", "time": 14135.55, "timestamp": "03:55:35", "text": "还有谁支持另外两人？感谢"}, {"type": "subtitle", "time": 14138.71, "timestamp": "03:55:38", "text": "你。按照计划，明天"}, {"type": "subtitle", "time": 14141.189, "timestamp": "03:55:41", "text": "我的直播时间是印度标准时间上午 10:00。我们将"}, {"type": "subtitle", "time": 14144.71, "timestamp": "03:55:44", "text": "正在进行唱歌直播。我不会"}, {"type": "subtitle", "time": 14146.71, "timestamp": "03:55:46", "text": "我会直播两个小时，但我会……"}, {"type": "subtitle", "time": 14148.55, "timestamp": "03:55:48", "text": "做个短直播之类的"}, {"type": "subtitle", "time": 14151.269, "timestamp": "03:55:51", "text": "明天大概就是那个时候。所以"}, {"type": "subtitle", "time": 14154.63, "timestamp": "03:55:54", "text": "让我们看看结果如何。好的。嗨，乔和"}, {"type": "subtitle", "time": 14157.51, "timestamp": "03:55:57", "text": "再见。晚安，妈妈。希望你一切顺利。"}]
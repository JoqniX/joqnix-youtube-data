[{"type": "subtitle", "time": 16261.11, "timestamp": "04:31:01", "text": "美好的。没关系。你们想去"}, {"type": "subtitle", "time": 16265.11, "timestamp": "04:31:05", "text": "向下？让我修一下我的按键通话功能。"}, {"type": "subtitle", "time": 16274.71, "timestamp": "04:31:14", "text": "哦，指针好像在移动，但是……"}, {"type": "subtitle", "time": 16277.349, "timestamp": "04:31:17", "text": "并非说它还没有发展阶段。"}, {"type": "subtitle", "time": 16279.91, "timestamp": "04:31:19", "text": "但它正在移动。"}, {"type": "subtitle", "time": 16283.189, "timestamp": "04:31:23", "text": "我懂了。真有趣。"}, {"type": "subtitle", "time": 16285.349, "timestamp": "04:31:25", "text": "是的，我知道。这很令人困惑，但是你"}, {"type": "subtitle", "time": 16288.63, "timestamp": "04:31:28", "text": "我知道，就是这样。我们有什么吗？我"}, {"type": "subtitle", "time": 16291.429, "timestamp": "04:31:31", "text": "我不这么认为。哦，等等，等等，等等。"}, {"type": "subtitle", "time": 16294.07, "timestamp": "04:31:34", "text": "它，它在闪烁。请帮忙"}, {"type": "subtitle", "time": 16296.389, "timestamp": "04:31:36", "text": "我。我在这里。我在这里。我在这里。不"}, {"type": "subtitle", "time": 16298.07, "timestamp": "04:31:38", "text": "担心。"}, {"type": "subtitle", "time": 16300.229, "timestamp": "04:31:40", "text": "把这颗愚蠢的宝石扔掉。我死了。我死了。"}, {"type": "subtitle", "time": 16303.51, "timestamp": "04:31:43", "text": "我死了。我死了。我也死了。什么？"}, {"type": "subtitle", "time": 16308.07, "timestamp": "04:31:48", "text": "你死了？是的。为什么？不。"}, {"type": "subtitle", "time": 16310.149, "timestamp": "04:31:50", "text": "伙计们，拜托。你们，你们，你们"}, {"type": "subtitle", "time": 16311.91, "timestamp": "04:31:51", "text": "不可能是认真的吧。稍等片刻。我"}, {"type": "subtitle", "time": 16313.91, "timestamp": "04:31:53", "text": "我会来这里，然后死去。给我一个"}]
[{"type": "subtitle", "time": 480.67, "timestamp": "00:08:00", "text": "[音乐]"}, {"type": "subtitle", "time": 483.55, "timestamp": "00:08:03", "text": "我的手表滴答声有延迟。"}, {"type": "subtitle", "time": 487.51, "timestamp": "00:08:07", "text": "个人电脑。问题是，这个雅卡顿人可能……"}, {"type": "subtitle", "time": 489.79, "timestamp": "00:08:09", "text": "情况更好"}, {"type": "subtitle", "time": 494.189, "timestamp": "00:08:14", "text": "如果我有喜欢"}, {"type": "subtitle", "time": 499.309, "timestamp": "00:08:19", "text": "不，你管它叫什么？我当时就像"}, {"type": "subtitle", "time": 507.71, "timestamp": "00:08:27", "text": "呃 多梦境或"}, {"type": "subtitle", "time": 510.629, "timestamp": "00:08:30", "text": "即使我同时直播多个节目或者没有直播，也一样。"}, {"type": "subtitle", "time": 512.469, "timestamp": "00:08:32", "text": "多流的结果将是"}, {"type": "subtitle", "time": 515.99, "timestamp": "00:08:35", "text": "相同的。所以我懒得管了，不过确实缺少"}, {"type": "subtitle", "time": 518.43, "timestamp": "00:08:38", "text": "局限性"}, {"type": "subtitle", "time": 521.11, "timestamp": "00:08:41", "text": "显然，这是其中之一"}, {"type": "subtitle", "time": 535.63, "timestamp": "00:08:55", "text": "真糟糕"}]
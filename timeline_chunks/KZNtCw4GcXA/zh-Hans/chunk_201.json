[{"type": "subtitle", "time": 12062.79, "timestamp": "03:21:02", "text": "温度。别跑，杰克。我们躲藏起来。"}, {"type": "subtitle", "time": 12064.79, "timestamp": "03:21:04", "text": "我什么也没得到。分体式盒子。我们"}, {"type": "subtitle", "time": 12069.03, "timestamp": "03:21:09", "text": "没看到幽灵骑行。无紫外线。我们"}, {"type": "subtitle", "time": 12072.229, "timestamp": "03:21:12", "text": "没有采取任何类似措施。没有像"}, {"type": "subtitle", "time": 12075.51, "timestamp": "03:21:15", "text": "没有像电磁场那样的东西。"}, {"type": "subtitle", "time": 12078.79, "timestamp": "03:21:18", "text": "感觉快要把我逼疯了。哦，你在这儿啊。"}, {"type": "subtitle", "time": 12080.79, "timestamp": "03:21:20", "text": "是。别担心，伙计。没关系。"}, {"type": "subtitle", "time": 12082.63, "timestamp": "03:21:22", "text": "没关系。你做得很好。"}, {"type": "subtitle", "time": 12084.55, "timestamp": "03:21:24", "text": "是的，你做得很好。是的，你"}, {"type": "subtitle", "time": 12088.07, "timestamp": "03:21:28", "text": "活得比我的天哪还要久。没关系。我 我"}, {"type": "subtitle", "time": 12090.229, "timestamp": "03:21:30", "text": "我选择你。你知道吗？"}, {"type": "subtitle", "time": 12094.07, "timestamp": "03:21:34", "text": "恶魔，我要变成恶魔了。为什么？"}, {"type": "subtitle", "time": 12096.07, "timestamp": "03:21:36", "text": "我打算挑一件东西。挑选"}, {"type": "subtitle", "time": 12099.11, "timestamp": "03:21:39", "text": "某物。你不能就这么……你不能就这么"}, {"type": "subtitle", "time": 12101.99, "timestamp": "03:21:41", "text": "拆开。如果运气好，我们就走。"}, {"type": "subtitle", "time": 12104.15, "timestamp": "03:21:44", "text": "欢迎回来。我没得到那种……"}, {"type": "subtitle", "time": 12106.95, "timestamp": "03:21:46", "text": "那是一种杜松子酒。没关系。这是杜松子酒。"}, {"type": "subtitle", "time": 12109.99, "timestamp": "03:21:49", "text": "这是杜松子酒。没关系。这是一个发现"}, {"type": "subtitle", "time": 12113.269, "timestamp": "03:21:53", "text": "证据。电磁场读数器。 WHO？谁干的"}, {"type": "subtitle", "time": 12116.87, "timestamp": "03:21:56", "text": "那？哦，我有一个电磁场检测仪。我没错"}]
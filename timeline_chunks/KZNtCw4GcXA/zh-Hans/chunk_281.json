[{"type": "subtitle", "time": 16869.19, "timestamp": "04:41:09", "text": "去。糟糕。我死了。"}, {"type": "subtitle", "time": 16871.75, "timestamp": "04:41:11", "text": "糟糕。她真的把它改成了"}, {"type": "subtitle", "time": 16873.59, "timestamp": "04:41:13", "text": "我。工作方面，别担心。我真的在钓鱼"}, {"type": "subtitle", "time": 16878.27, "timestamp": "04:41:18", "text": "专为你准备的。快点。什么？"}, {"type": "subtitle", "time": 16881.91, "timestamp": "04:41:21", "text": "哦，乔尔，你也死了吗？不，我是"}, {"type": "subtitle", "time": 16883.83, "timestamp": "04:41:23", "text": "简直就藏在风的地下室里。"}, {"type": "subtitle", "time": 16888.15, "timestamp": "04:41:28", "text": "帮助。好的。不用担心。不用担心。我"}, {"type": "subtitle", "time": 16890.15, "timestamp": "04:41:30", "text": "我觉得追捕行动已经结束了。"}, {"type": "subtitle", "time": 16892.23, "timestamp": "04:41:32", "text": "不用担心。是的。等等，哪里？"}, {"type": "subtitle", "time": 16904.868, "timestamp": "04:41:44", "text": "谁来打开我的神之门。是我们。是我们。"}, {"type": "subtitle", "time": 16907.11, "timestamp": "04:41:47", "text": "耶稣基督。"}, {"type": "subtitle", "time": 16909.27, "timestamp": "04:41:49", "text": "好的。你想去哪里？我们是否这样做了？"}, {"type": "subtitle", "time": 16911.75, "timestamp": "04:41:51", "text": "好的，我们需要修理保险丝。"}, {"type": "subtitle", "time": 16916.59, "timestamp": "04:41:56", "text": "又来了，对吧？好的。 J先生，是"}, {"type": "subtitle", "time": 16919.19, "timestamp": "04:41:59", "text": "美好的。别理我。我只是个幽灵。"}]
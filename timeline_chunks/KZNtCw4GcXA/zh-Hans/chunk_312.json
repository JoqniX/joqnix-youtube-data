[{"type": "subtitle", "time": 18721.75, "timestamp": "05:12:01", "text": "全部。我是什么？什么？我该怎么办？"}, {"type": "subtitle", "time": 18723.1, "timestamp": "05:12:03", "text": "我"}, {"type": "subtitle", "time": 18729.43, "timestamp": "05:12:09", "text": "嗯，但在创作方面，我……"}, {"type": "subtitle", "time": 18731.35, "timestamp": "05:12:11", "text": "思考"}, {"type": "subtitle", "time": 18732.75, "timestamp": "05:12:12", "text": "呃，就像……"}, {"type": "subtitle", "time": 18735.47, "timestamp": "05:12:15", "text": "嗯，更多"}, {"type": "subtitle", "time": 18739.51, "timestamp": "05:12:19", "text": "更干净的覆盖层或其他类似的东西"}, {"type": "subtitle", "time": 18741.35, "timestamp": "05:12:21", "text": "我要休息一下，而且会……"}, {"type": "subtitle", "time": 18744.628, "timestamp": "05:12:24", "text": "弹出和落下。向上滑动。滑动"}, {"type": "subtitle", "time": 18747.03, "timestamp": "05:12:27", "text": "向下。显而易见的过渡方式是……"}, {"type": "subtitle", "time": 18749.27, "timestamp": "05:12:29", "text": "出现和消失。你可以为"}, {"type": "subtitle", "time": 18751.75, "timestamp": "05:12:31", "text": "每个单独的来源。淡入，淡出"}, {"type": "subtitle", "time": 18753.51, "timestamp": "05:12:33", "text": "出去。差不多就是这样。滑动进入，滑动"}, {"type": "subtitle", "time": 18756.47, "timestamp": "05:12:36", "text": "向上滑动，向上滑动，向下滑动。我可以做到"}, {"type": "subtitle", "time": 18758.43, "timestamp": "05:12:38", "text": "那个东西"}, {"type": "subtitle", "time": 18762.628, "timestamp": "05:12:42", "text": "各种周期性的东西。我们拥有的一切"}, {"type": "subtitle", "time": 18764.868, "timestamp": "05:12:44", "text": "抽出时间"}, {"type": "subtitle", "time": 18768.31, "timestamp": "05:12:48", "text": "呃，是基于时间的自动化，对吧？"}, {"type": "subtitle", "time": 18772.47, "timestamp": "05:12:52", "text": "早晨，上午晚些时候，中午，下午"}, {"type": "subtitle", "time": 18773.47, "timestamp": "05:12:53", "text": "呃"}, {"type": "subtitle", "time": 18776.948, "timestamp": "05:12:56", "text": "傍晚，呃，夜晚，深夜，午夜，"}, {"type": "subtitle", "time": 18779.03, "timestamp": "05:12:59", "text": "所有那些东西，对吧？"}]
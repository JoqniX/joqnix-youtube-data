[{"type": "subtitle", "time": 11704.55, "timestamp": "03:15:04", "text": "你好。你在这里吗？你在哪里？"}, {"type": "subtitle", "time": 11708.389, "timestamp": "03:15:08", "text": "你今年多大？你好。"}, {"type": "subtitle", "time": 11710.309, "timestamp": "03:15:10", "text": "四月，你为什么不呢？我要去……"}, {"type": "subtitle", "time": 11711.67, "timestamp": "03:15:11", "text": "地下室。你为什么不把门关上？"}, {"type": "subtitle", "time": 11724.229, "timestamp": "03:15:24", "text": "你好？你在这里吗？那里有一扇门。"}, {"type": "subtitle", "time": 11732.389, "timestamp": "03:15:32", "text": "我就像在找保险丝一样。"}, {"type": "subtitle", "time": 11735.269, "timestamp": "03:15:35", "text": "比如"}, {"type": "subtitle", "time": 11736.389, "timestamp": "03:15:36", "text": "通常在地下室。门"}, {"type": "subtitle", "time": 11742.229, "timestamp": "03:15:42", "text": "鲨鱼。它并不闹鬼。快点。什么"}, {"type": "subtitle", "time": 11744.389, "timestamp": "03:15:44", "text": "您指的是门吗？你在哪里？"}, {"type": "subtitle", "time": 11747.19, "timestamp": "03:15:47", "text": "关门。我在楼上。你是"}, {"type": "subtitle", "time": 11750.19, "timestamp": "03:15:50", "text": "楼上？你是吗？你是"}, {"type": "subtitle", "time": 11753.349, "timestamp": "03:15:53", "text": "美好的。你没事，兄弟。"}, {"type": "subtitle", "time": 11755.91, "timestamp": "03:15:55", "text": "嘿，你会没事的。你没事。什么"}, {"type": "subtitle", "time": 11759.03, "timestamp": "03:15:59", "text": "你是说？哦，瞧你多勇敢啊！"}]
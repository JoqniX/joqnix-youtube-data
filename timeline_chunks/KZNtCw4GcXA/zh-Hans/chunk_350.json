[{"type": "subtitle", "time": 21008.03, "timestamp": "05:50:08", "text": "比如什么"}, {"type": "subtitle", "time": 21012.628, "timestamp": "05:50:12", "text": "呃，就像……嗯，你看……一般来说"}, {"type": "subtitle", "time": 21015.99, "timestamp": "05:50:15", "text": "说话我知道像"}, {"type": "subtitle", "time": 21018.868, "timestamp": "05:50:18", "text": "人们更喜欢女性创作者"}, {"type": "subtitle", "time": 21021.91, "timestamp": "05:50:21", "text": "更多雄性动物不存在"}, {"type": "subtitle", "time": 21024.868, "timestamp": "05:50:24", "text": "以某种方式在视频翅膀球体中和"}, {"type": "subtitle", "time": 21029.51, "timestamp": "05:50:29", "text": "一切都有些复杂，我的情况也有点……"}, {"type": "subtitle", "time": 21031.16, "timestamp": "05:50:31", "text": "中间，我想我没有"}, {"type": "subtitle", "time": 21038.19, "timestamp": "05:50:38", "text": "我知道，这就是我的原因"}, {"type": "subtitle", "time": 21040.788, "timestamp": "05:50:40", "text": "担心。有些人会说：“哦，"}, {"type": "subtitle", "time": 21043.708, "timestamp": "05:50:43", "text": "乔假装是这样，或者"}, {"type": "subtitle", "time": 21046.91, "timestamp": "05:50:46", "text": "任何。那不是他的声音，或者"}, {"type": "subtitle", "time": 21049.19, "timestamp": "05:50:49", "text": "某物。为什么我不能？”但同时"}, {"type": "subtitle", "time": 21050.868, "timestamp": "05:50:50", "text": "还有另一件事会说："}, {"type": "subtitle", "time": 21052.788, "timestamp": "05:50:52", "text": "“好吧，你为什么听别人的？”"}, {"type": "subtitle", "time": 21055.59, "timestamp": "05:50:55", "text": "其他人都在说什么？优先排序"}, {"type": "subtitle", "time": 21057.35, "timestamp": "05:50:57", "text": "告诉自己你想做什么，你想做什么"}, {"type": "subtitle", "time": 21059.628, "timestamp": "05:50:59", "text": "想要创造和"}]
[{"type": "subtitle", "time": 17341.67, "timestamp": "04:49:01", "text": "做。好的。总之，我会去取的。"}, {"type": "subtitle", "time": 17343.67, "timestamp": "04:49:03", "text": "再次。捡起来。这就是它所在的地方"}, {"type": "subtitle", "time": 17345.11, "timestamp": "04:49:05", "text": "出现了。把它捡起来。把它捡起来。好的，"}, {"type": "subtitle", "time": 17347.628, "timestamp": "04:49:07", "text": "凉爽的。他们喜欢改变这一点吗？"}, {"type": "subtitle", "time": 17351.27, "timestamp": "04:49:11", "text": "地图？我认为是因为帐篷是"}, {"type": "subtitle", "time": 17353.35, "timestamp": "04:49:13", "text": "应该像低一样小，但是"}, {"type": "subtitle", "time": 17356.07, "timestamp": "04:49:16", "text": "感觉不太低。我不知道什么"}, {"type": "subtitle", "time": 17359.67, "timestamp": "04:49:19", "text": "他们对此做了什么。我玩得很开心。"}, {"type": "subtitle", "time": 17363.31, "timestamp": "04:49:23", "text": "咱们去打球吧。有一个"}, {"type": "subtitle", "time": 17366.91, "timestamp": "04:49:26", "text": "球。等等，怎么做？"}, {"type": "subtitle", "time": 17369.948, "timestamp": "04:49:29", "text": "打球？"}, {"type": "subtitle", "time": 17372.35, "timestamp": "04:49:32", "text": "Jama 如何"}, {"type": "subtitle", "time": 17376.708, "timestamp": "04:49:36", "text": "按下 E 键，然后拿起它，再按下 G 键。"}, {"type": "subtitle", "time": 17378.628, "timestamp": "04:49:38", "text": "把它扔掉。"}, {"type": "subtitle", "time": 17381.67, "timestamp": "04:49:41", "text": "哦，格罗。哦好的。好的。是的，我们"}, {"type": "subtitle", "time": 17383.67, "timestamp": "04:49:43", "text": "去。"}, {"type": "subtitle", "time": 17385.23, "timestamp": "04:49:45", "text": "真是这样"}, {"type": "subtitle", "time": 17396.15, "timestamp": "04:49:56", "text": "哦，舞会气氛。是的，是我扔的。我"}, {"type": "subtitle", "time": 17398.55, "timestamp": "04:49:58", "text": "扔了进去。"}]
[{"type": "subtitle", "time": 12906.75, "timestamp": "03:35:06", "text": "了解这一切"}, {"type": "subtitle", "time": 12909.51, "timestamp": "03:35:09", "text": "我记得当时我还在风险投资公司工作。我"}, {"type": "subtitle", "time": 12910.95, "timestamp": "03:35:10", "text": "我想我不知道，我希望我不是。"}, {"type": "subtitle", "time": 12913.67, "timestamp": "03:35:13", "text": "因为我当时遇到了一些问题，所以无法听清。"}, {"type": "subtitle", "time": 12917.03, "timestamp": "03:35:17", "text": "手机也是。我的蓝牙"}, {"type": "subtitle", "time": 12919.83, "timestamp": "03:35:19", "text": "我通常都有耳机。"}, {"type": "subtitle", "time": 12923.349, "timestamp": "03:35:23", "text": "它好像没发出声音，所以不能正常工作。"}, {"type": "subtitle", "time": 12927.11, "timestamp": "03:35:27", "text": "我在车里说了好多话，但是呃……"}, {"type": "subtitle", "time": 12929.67, "timestamp": "03:35:29", "text": "我在发送 WhatsApp 消息时注意到了这一点。"}, {"type": "subtitle", "time": 12933.19, "timestamp": "03:35:33", "text": "给我爸发信息，看看发生了什么事。"}, {"type": "subtitle", "time": 12936.15, "timestamp": "03:35:36", "text": "互联网之所以如此发达，是因为它是一种……"}, {"type": "subtitle", "time": 12939.99, "timestamp": "03:35:39", "text": "截止日期之类的，嗯……我不知道。"}, {"type": "subtitle", "time": 12950.429, "timestamp": "03:35:50", "text": "但你知道吗？在……的末尾"}, {"type": "subtitle", "time": 12957.67, "timestamp": "03:35:57", "text": "是。诸如此类的技术难题。我"}, {"type": "subtitle", "time": 12958.91, "timestamp": "03:35:58", "text": "思考"}]
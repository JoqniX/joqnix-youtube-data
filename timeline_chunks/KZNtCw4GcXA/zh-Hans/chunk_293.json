[{"type": "subtitle", "time": 17581.19, "timestamp": "04:53:01", "text": "其实是游戏。"}, {"type": "subtitle", "time": 17582.91, "timestamp": "04:53:02", "text": "[音乐]"}, {"type": "subtitle", "time": 17586.708, "timestamp": "04:53:06", "text": "是的。总之，以德瓦的名义，我听说是"}, {"type": "subtitle", "time": 17588.708, "timestamp": "04:53:08", "text": "可怕的。"}, {"type": "subtitle", "time": 17589.47, "timestamp": "04:53:09", "text": "它"}, {"type": "subtitle", "time": 17592.27, "timestamp": "04:53:12", "text": "是。我不知道。我不知道"}, {"type": "subtitle", "time": 17594.628, "timestamp": "04:53:14", "text": "虽然有点吓人，但你知道，或许你应该"}, {"type": "subtitle", "time": 17597.35, "timestamp": "04:53:17", "text": "和我们一起玩吧。"}, {"type": "subtitle", "time": 17599.23, "timestamp": "04:53:19", "text": "是的。"}, {"type": "subtitle", "time": 17604.15, "timestamp": "04:53:24", "text": "房间呢？"}, {"type": "subtitle", "time": 17606.788, "timestamp": "04:53:26", "text": "逃出后面的房间。不是进入"}, {"type": "subtitle", "time": 17609.51, "timestamp": "04:53:29", "text": "后屋。躲过了后空翻。哦"}, {"type": "subtitle", "time": 17612.868, "timestamp": "04:53:32", "text": "男生。任何。我和时间以及西摩"}, {"type": "subtitle", "time": 17615.11, "timestamp": "04:53:35", "text": "玩过。我觉得塞拉斯蒂娅有。你"}, {"type": "subtitle", "time": 17617.11, "timestamp": "04:53:37", "text": "你有吧？是的，我确实有。"}, {"type": "subtitle", "time": 17619.75, "timestamp": "04:53:39", "text": "但我从来没玩过。你想玩"}, {"type": "subtitle", "time": 17623.11, "timestamp": "04:53:43", "text": "它？什么？哦，等等。等等，给我一个"}, {"type": "subtitle", "time": 17624.788, "timestamp": "04:53:44", "text": "第二。比如，你们公司允许吗？"}, {"type": "subtitle", "time": 17627.67, "timestamp": "04:53:47", "text": "它？这就是核心概念。"}, {"type": "subtitle", "time": 17631.11, "timestamp": "04:53:51", "text": "哦，哪家公司会允许这种事？呃，就像"}, {"type": "subtitle", "time": 17635.51, "timestamp": "04:53:55", "text": "每月一次。嗯，是的，每月"}]
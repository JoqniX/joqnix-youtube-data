[{"type": "subtitle", "time": 11941.67, "timestamp": "03:19:01", "text": "简直就藏在风的地下室里。"}, {"type": "subtitle", "time": 11945.429, "timestamp": "03:19:05", "text": "帮助。好的，别担心。不用担心。"}, {"type": "subtitle", "time": 11947.67, "timestamp": "03:19:07", "text": "难道我不认为我认为狩猎是"}, {"type": "subtitle", "time": 11949.99, "timestamp": "03:19:09", "text": "结束了。不用担心。是的。等等，哪里……"}, {"type": "subtitle", "time": 11962.229, "timestamp": "03:19:22", "text": "有人开门了。我的天啊。是我们。它是"}, {"type": "subtitle", "time": 11964.95, "timestamp": "03:19:24", "text": "我们。耶稣基督。"}, {"type": "subtitle", "time": 11967.11, "timestamp": "03:19:27", "text": "好的。你想去哪里？我们是否这样做了？"}, {"type": "subtitle", "time": 11969.59, "timestamp": "03:19:29", "text": "好的，我们需要修理保险丝。"}, {"type": "subtitle", "time": 11974.429, "timestamp": "03:19:34", "text": "又来了，对吧？好的。 J先生，是的"}, {"type": "subtitle", "time": 11976.95, "timestamp": "03:19:36", "text": "美好的。别理我。我只是个幽灵，"}, {"type": "subtitle", "time": 11978.95, "timestamp": "03:19:38", "text": "但没关系。没关系。没关系。"}, {"type": "subtitle", "time": 11980.79, "timestamp": "03:19:40", "text": "我先来。我先去。"}, {"type": "subtitle", "time": 11982.07, "timestamp": "03:19:42", "text": "别担心。请别打扰我。"}, {"type": "subtitle", "time": 11985.269, "timestamp": "03:19:45", "text": "请不要离开我。为什么？为什么？"}, {"type": "subtitle", "time": 11989.429, "timestamp": "03:19:49", "text": "糟糕。为什么？为什么？为什么？为什么？为什么？呃，所以"}, {"type": "subtitle", "time": 11991.91, "timestamp": "03:19:51", "text": "他/她/她正在给你按摩，"}, {"type": "subtitle", "time": 11993.91, "timestamp": "03:19:53", "text": "也。瞧瞧。是的。确切地。"}, {"type": "subtitle", "time": 11995.92, "timestamp": "03:19:55", "text": "确切地。 乔特·乔布已经做好了准备。我刚来"}]
[{"type": "subtitle", "time": 10865.429, "timestamp": "03:01:05", "text": "这是可以买任何东西的钱。"}, {"type": "subtitle", "time": 10866.95, "timestamp": "03:01:06", "text": "哦，我们走吧。哦，我们没钱。"}, {"type": "subtitle", "time": 10868.63, "timestamp": "03:01:08", "text": "凉爽的。没关系，兄弟。等等，你知道"}, {"type": "subtitle", "time": 10870.55, "timestamp": "03:01:10", "text": "什么？让我们从零开始，进入噩梦。"}, {"type": "subtitle", "time": 10872.71, "timestamp": "03:01:12", "text": "模式。我们走吧。是的，晚上好。哦，我们是"}, {"type": "subtitle", "time": 10875.19, "timestamp": "03:01:15", "text": "进入噩梦模式。好的，就是这样。"}, {"type": "subtitle", "time": 10877.67, "timestamp": "03:01:17", "text": "钱。谁在乎？那不是最难的吗？"}, {"type": "subtitle", "time": 10881.19, "timestamp": "03:01:21", "text": "一？等待。不，不，不。不，不，不。"}, {"type": "subtitle", "time": 10882.63, "timestamp": "03:01:22", "text": "以同样的力量战胜它"}, {"type": "subtitle", "time": 10884.71, "timestamp": "03:01:24", "text": "友谊。友谊。当然。的"}, {"type": "subtitle", "time": 10887.429, "timestamp": "03:01:27", "text": "课程。准备好了。准备好了，杰克。我们可以"}, {"type": "subtitle", "time": 10889.59, "timestamp": "03:01:29", "text": "这样做。好的。是的，我们能做到。我"}, {"type": "subtitle", "time": 10892.87, "timestamp": "03:01:32", "text": "相信我们。微笑。我们可能会失去更多。"}, {"type": "subtitle", "time": 10894.55, "timestamp": "03:01:34", "text": "总比零美元强，老兄。快点。"}, {"type": "subtitle", "time": 10896.99, "timestamp": "03:01:36", "text": "我们走吧。"}, {"type": "subtitle", "time": 10901.59, "timestamp": "03:01:41", "text": "好的。你好。我会尽我所能。是的。"}, {"type": "subtitle", "time": 10905.75, "timestamp": "03:01:45", "text": "大家都准备好了。是的。我们开始吧。哦。"}, {"type": "subtitle", "time": 10908.95, "timestamp": "03:01:48", "text": "我的天啊。旁听法庭。这是什么地图？"}, {"type": "subtitle", "time": 10911.269, "timestamp": "03:01:51", "text": "再次？他是个高大的人吗？哦，它很小"}, {"type": "subtitle", "time": 10912.51, "timestamp": "03:01:52", "text": "一。好的，"}, {"type": "subtitle", "time": 10915.269, "timestamp": "03:01:55", "text": "好的。小的。"}, {"type": "subtitle", "time": 10919.75, "timestamp": "03:01:59", "text": "太小了。我什么都不知道。帮助。"}]
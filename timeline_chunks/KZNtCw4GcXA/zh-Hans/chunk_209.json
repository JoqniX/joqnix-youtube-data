[{"type": "subtitle", "time": 12544.55, "timestamp": "03:29:04", "text": "总之，我放弃了“哦，你知道吗？”"}, {"type": "subtitle", "time": 12545.75, "timestamp": "03:29:05", "text": "你知道吗？你知道吗？很多"}, {"type": "subtitle", "time": 12547.59, "timestamp": "03:29:07", "text": "更好的。比如，我就把它扔进去。"}, {"type": "subtitle", "time": 12552.07, "timestamp": "03:29:12", "text": "中间。所以如果它确实像"}, {"type": "subtitle", "time": 12554.79, "timestamp": "03:29:14", "text": "哦，发电机正在运转。呃，各位，"}, {"type": "subtitle", "time": 12557.75, "timestamp": "03:29:17", "text": "天气很冷，我看到了帐篷。"}, {"type": "subtitle", "time": 12561.269, "timestamp": "03:29:21", "text": "物体自行移动。哦，真棒。反正，"}, {"type": "subtitle", "time": 12563.349, "timestamp": "03:29:23", "text": "冰点以下。我要放弃"}, {"type": "subtitle", "time": 12565.91, "timestamp": "03:29:25", "text": "这里就有门了。是的，就是这个。"}, {"type": "subtitle", "time": 12568.95, "timestamp": "03:29:28", "text": "它自己动了。所以，"}, {"type": "subtitle", "time": 12570.71, "timestamp": "03:29:30", "text": "好的，"}, {"type": "subtitle", "time": 12573.71, "timestamp": "03:29:33", "text": "没关系。我打算留下来"}, {"type": "subtitle", "time": 12577.59, "timestamp": "03:29:37", "text": "这里。嘿，伙计们，我现在在这里露营。"}, {"type": "subtitle", "time": 12580.229, "timestamp": "03:29:40", "text": "非常感谢你带我参观。能"}, {"type": "subtitle", "time": 12583.67, "timestamp": "03:29:43", "text": "你克服了其中一个吗？谢谢。"}, {"type": "subtitle", "time": 12587.269, "timestamp": "03:29:47", "text": "我不知道你们是怎么做到的。是的。那是一个"}, {"type": "subtitle", "time": 12591.59, "timestamp": "03:29:51", "text": "那是召唤阵。哦，不。"}, {"type": "subtitle", "time": 12593.99, "timestamp": "03:29:53", "text": "瞧瞧你，杰克，什么都能找到。"}]
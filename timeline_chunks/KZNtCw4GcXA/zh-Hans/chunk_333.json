[{"type": "subtitle", "time": 19980.708, "timestamp": "05:33:00", "text": "我记得以前有几个人，或者类似的人"}, {"type": "subtitle", "time": 19983.03, "timestamp": "05:33:03", "text": "我记得好像看到过一条评论，我"}, {"type": "subtitle", "time": 19986.03, "timestamp": "05:33:06", "text": "不知道提及"}, {"type": "subtitle", "time": 19990.51, "timestamp": "05:33:10", "text": "我感觉自己越来越局限自己了。"}, {"type": "subtitle", "time": 19996.15, "timestamp": "05:33:16", "text": "现在比自由或更自由之类的更重要"}, {"type": "subtitle", "time": 20004.628, "timestamp": "05:33:24", "text": "所以我想知道这是哪里，为什么会这样"}, {"type": "subtitle", "time": 20008.47, "timestamp": "05:33:28", "text": "悬浮装置出现了"}, {"type": "subtitle", "time": 20010.91, "timestamp": "05:33:30", "text": "大约。我"}, {"type": "subtitle", "time": 20017.39, "timestamp": "05:33:37", "text": "[音乐]"}, {"type": "subtitle", "time": 20022.07, "timestamp": "05:33:42", "text": "所以，但这是否是局限性呢？"}, {"type": "subtitle", "time": 20023.948, "timestamp": "05:33:43", "text": "我感觉自己真的……"}, {"type": "subtitle", "time": 20032.19, "timestamp": "05:33:52", "text": "是的，这婊子很坏"}, {"type": "subtitle", "time": 20037.95, "timestamp": "05:33:57", "text": "坏的。"}, {"type": "subtitle", "time": 20039.31, "timestamp": "05:33:59", "text": "[音乐]"}]
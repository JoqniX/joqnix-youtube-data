[{"type": "subtitle", "time": 16684.39, "timestamp": "04:38:04", "text": "查克，这并不闹鬼。快点。什么"}, {"type": "subtitle", "time": 16686.551, "timestamp": "04:38:06", "text": "您指的是门吗？你在哪里？"}, {"type": "subtitle", "time": 16689.349, "timestamp": "04:38:09", "text": "关门。我在楼上。你是"}, {"type": "subtitle", "time": 16690.869, "timestamp": "04:38:10", "text": "楼上？"}, {"type": "subtitle", "time": 16692.349, "timestamp": "04:38:12", "text": "你是吗？你是"}, {"type": "subtitle", "time": 16695.75, "timestamp": "04:38:15", "text": "美好的。你没事，兄弟。"}, {"type": "subtitle", "time": 16698.31, "timestamp": "04:38:18", "text": "你会没事的。你没事。你是什​​么"}, {"type": "subtitle", "time": 16701.349, "timestamp": "04:38:21", "text": "意思是？哦，瞧你多勇敢啊！"}, {"type": "subtitle", "time": 16703.869, "timestamp": "04:38:23", "text": "独自一人待在"}, {"type": "subtitle", "time": 16708.189, "timestamp": "04:38:28", "text": "楼梯。看看你。"}, {"type": "subtitle", "time": 16710.709, "timestamp": "04:38:30", "text": "但是，哦，你要弹钢琴了。"}, {"type": "subtitle", "time": 16714.15, "timestamp": "04:38:34", "text": "这里？哦，不错。你想 你想"}, {"type": "subtitle", "time": 16716.31, "timestamp": "04:38:36", "text": "比如发出某种声音？是的。是的。是的。"}, {"type": "subtitle", "time": 16718.07, "timestamp": "04:38:38", "text": "当然，当然，当然，当然。就像杰克一样"}, {"type": "subtitle", "time": 16720.31, "timestamp": "04:38:40", "text": "你到底在哪儿？我打开"}, {"type": "subtitle", "time": 16722.109, "timestamp": "04:38:42", "text": "一切。谢谢，"}, {"type": "subtitle", "time": 16729.109, "timestamp": "04:38:49", "text": "你在哪里？好吧，我只是"}, {"type": "subtitle", "time": 16731.189, "timestamp": "04:38:51", "text": "我在找一些紫外线之类的东西。给我"}]
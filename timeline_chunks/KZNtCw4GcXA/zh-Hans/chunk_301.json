[{"type": "subtitle", "time": 18061.31, "timestamp": "05:01:01", "text": "有可能，但我的电脑也是"}, {"type": "subtitle", "time": 18065.868, "timestamp": "05:01:05", "text": "卡顿，我真的真的不想这样"}, {"type": "subtitle", "time": 18074.03, "timestamp": "05:01:14", "text": "所以"}, {"type": "subtitle", "time": 18077.948, "timestamp": "05:01:17", "text": "对此却并非如此。"}, {"type": "subtitle", "time": 18080.29, "timestamp": "05:01:20", "text": "E. 有时似乎"}, {"type": "subtitle", "time": 18083.07, "timestamp": "05:01:23", "text": "[音乐]"}, {"type": "subtitle", "time": 18087.07, "timestamp": "05:01:27", "text": "嗯，似乎有时候并非如此。"}, {"type": "subtitle", "time": 18088.83, "timestamp": "05:01:28", "text": "我的唯一"}, {"type": "subtitle", "time": 18092.59, "timestamp": "05:01:32", "text": "第二。有时似乎我的"}, {"type": "subtitle", "time": 18097.11, "timestamp": "05:01:37", "text": "嗯，这东西会……我的音频"}, {"type": "subtitle", "time": 18100.99, "timestamp": "05:01:40", "text": "也经常崩溃"}, {"type": "subtitle", "time": 18103.708, "timestamp": "05:01:43", "text": "时间更重要"}, {"type": "subtitle", "time": 18107.15, "timestamp": "05:01:47", "text": "比我想象的更令人担忧"}, {"type": "subtitle", "time": 18117.55, "timestamp": "05:01:57", "text": "好吧，我拿到茶了，这真的"}]
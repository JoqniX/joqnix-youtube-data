[{"type": "subtitle", "time": 13981.83, "timestamp": "03:53:01", "text": "SL。然后我回来后就想，我"}, {"type": "subtitle", "time": 13985.59, "timestamp": "03:53:05", "text": "想看直播，但又不想……"}, {"type": "subtitle", "time": 13997.55, "timestamp": "03:53:17", "text": "新的变化是"}, {"type": "subtitle", "time": 14000.11, "timestamp": "03:53:20", "text": "慢慢来"}, {"type": "subtitle", "time": 14002.63, "timestamp": "03:53:22", "text": "慢慢地。变化不算太大。"}, {"type": "subtitle", "time": 14005.189, "timestamp": "03:53:25", "text": "就是那种慢慢来的事情。"}, {"type": "subtitle", "time": 14007.99, "timestamp": "03:53:27", "text": "会有很多合作项目。十一月，"}, {"type": "subtitle", "time": 14010.07, "timestamp": "03:53:30", "text": "十一月，我不知道我是否"}, {"type": "subtitle", "time": 14013.269, "timestamp": "03:53:33", "text": "实际上不会经常直播，但是"}, {"type": "subtitle", "time": 14015.99, "timestamp": "03:53:35", "text": "考试之类的事情总会发生的。所以，"}, {"type": "subtitle", "time": 14017.87, "timestamp": "03:53:37", "text": "我会尽力而为"}, {"type": "subtitle", "time": 14021.389, "timestamp": "03:53:41", "text": "管理流媒体和所有相关事宜"}, {"type": "subtitle", "time": 14024.15, "timestamp": "03:53:44", "text": "那些人就会明白结果如何。好的。所以，我"}, {"type": "subtitle", "time": 14026.79, "timestamp": "03:53:46", "text": "我这就把它包起来。我只是"}, {"type": "subtitle", "time": 14029.349, "timestamp": "03:53:49", "text": "我想说声谢谢大家。"}, {"type": "subtitle", "time": 14032.389, "timestamp": "03:53:52", "text": "感谢您的光临。即使我拥有技术能力"}, {"type": "subtitle", "time": 14035.389, "timestamp": "03:53:55", "text": "遇到困难没关系。什么才是最重要的"}, {"type": "subtitle", "time": 14038.87, "timestamp": "03:53:58", "text": "你们支持另外两位吗？"}]
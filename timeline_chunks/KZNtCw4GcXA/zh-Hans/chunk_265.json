[{"type": "subtitle", "time": 15903.59, "timestamp": "04:25:03", "text": "现在用模拟方式了。好的。我不喜欢这样。"}, {"type": "subtitle", "time": 15906.229, "timestamp": "04:25:06", "text": "哇。我们没有摄像机，对吧？"}, {"type": "subtitle", "time": 15908.229, "timestamp": "04:25:08", "text": "我们？哦，这是视频吗？"}, {"type": "subtitle", "time": 15909.99, "timestamp": "04:25:09", "text": "相机？"}, {"type": "subtitle", "time": 15912.71, "timestamp": "04:25:12", "text": "好的，没问题。幽灵领域。我们开始吧"}, {"type": "subtitle", "time": 15915.83, "timestamp": "04:25:15", "text": "看。我的天哪，快看！一切都是"}, {"type": "subtitle", "time": 15922.229, "timestamp": "04:25:22", "text": "他们退步了。"}, {"type": "subtitle", "time": 15924.63, "timestamp": "04:25:24", "text": "他们喜欢他们，他们回去了"}, {"type": "subtitle", "time": 15928.469, "timestamp": "04:25:28", "text": "进入猴子模式。我知道。"}, {"type": "subtitle", "time": 15931.03, "timestamp": "04:25:31", "text": "为什么说这是类比？"}, {"type": "subtitle", "time": 15933.429, "timestamp": "04:25:33", "text": "一切就绪。我的天啊。我喜欢它。我"}, {"type": "subtitle", "time": 15936.71, "timestamp": "04:25:36", "text": "爱它。没关系。是的。我们进去吧。"}, {"type": "subtitle", "time": 15938.229, "timestamp": "04:25:38", "text": "我们走吧。你们可以听到音频。"}, {"type": "subtitle", "time": 15940.71, "timestamp": "04:25:40", "text": "正确的？这就像……这算是一种困难吗？"}, {"type": "subtitle", "time": 15943.67, "timestamp": "04:25:43", "text": "事物？我不这么认为。正确的。呃，我"}, {"type": "subtitle", "time": 15944.95, "timestamp": "04:25:44", "text": "意思是知道你是否能接过火炬"}, {"type": "subtitle", "time": 15947.75, "timestamp": "04:25:47", "text": "轻度毒性。呃，不，我没有拿。"}, {"type": "subtitle", "time": 15950.71, "timestamp": "04:25:50", "text": "手电筒还没亮。呃，我们没有手电筒。"}, {"type": "subtitle", "time": 15952.07, "timestamp": "04:25:52", "text": "我们没有，我们也不需要手电筒。"}, {"type": "subtitle", "time": 15954.55, "timestamp": "04:25:54", "text": "没关系。没关系。不需要“我们”。"}, {"type": "subtitle", "time": 15959.59, "timestamp": "04:25:59", "text": "可能会失明。没关系。我要买它。"}]
[{"type": "subtitle", "time": 13140.349, "timestamp": "03:39:00", "text": "片刻但"}, {"type": "subtitle", "time": 13148.429, "timestamp": "03:39:08", "text": "嗯，我"}, {"type": "subtitle", "time": 13150.91, "timestamp": "03:39:10", "text": "真心想要，我"}, {"type": "subtitle", "time": 13153.67, "timestamp": "03:39:13", "text": "继续。但我内心深处也有这种感觉。"}, {"type": "subtitle", "time": 13156.19, "timestamp": "03:39:16", "text": "喜欢"}, {"type": "subtitle", "time": 13159.99, "timestamp": "03:39:19", "text": "黑暗笼罩着溪流。所以我是"}, {"type": "subtitle", "time": 13167.07, "timestamp": "03:39:27", "text": "呃，我就像"}, {"type": "subtitle", "time": 13169.51, "timestamp": "03:39:29", "text": "嗯，是的，我喜欢的其中一件事就是"}, {"type": "subtitle", "time": 13171.75, "timestamp": "03:39:31", "text": "我真的要感谢大家。"}, {"type": "subtitle", "time": 13172.91, "timestamp": "03:39:32", "text": "未来"}, {"type": "subtitle", "time": 13175.269, "timestamp": "03:39:35", "text": "经过。这是我唯一能做的。"}, {"type": "subtitle", "time": 13179.269, "timestamp": "03:39:39", "text": "现在。嗯，我尤其想……"}, {"type": "subtitle", "time": 13183.349, "timestamp": "03:39:43", "text": "特别感谢 Celestia 和 Rick"}, {"type": "subtitle", "time": 13186.67, "timestamp": "03:39:46", "text": "邀请我一起玩"}, {"type": "subtitle", "time": 13189.03, "timestamp": "03:39:49", "text": "恐鬼症。但我很享受第一部。"}, {"type": "subtitle", "time": 13191.71, "timestamp": "03:39:51", "text": "两场比赛我们"}, {"type": "subtitle", "time": 13194.91, "timestamp": "03:39:54", "text": "边哭边玩，直到睡着"}, {"type": "subtitle", "time": 13199.59, "timestamp": "03:39:59", "text": "1 小时前。我当时就觉得，这简直太不可思议了。"}]
[{"type": "subtitle", "time": 10278.79, "timestamp": "02:51:18", "text": "[音乐]"}, {"type": "subtitle", "time": 10280.03, "timestamp": "02:51:20", "text": "是的。你好"}, {"type": "subtitle", "time": 10284.309, "timestamp": "02:51:24", "text": "每个人。你好。你好。希望你们"}, {"type": "subtitle", "time": 10290.07, "timestamp": "02:51:30", "text": "雅虎。希望你们一切都好。"}, {"type": "subtitle", "time": 10292.23, "timestamp": "02:51:32", "text": "雅虎。"}, {"type": "subtitle", "time": 10295.67, "timestamp": "02:51:35", "text": "所以今天我们将进行直播。"}, {"type": "subtitle", "time": 10296.59, "timestamp": "02:51:36", "text": "和"}, {"type": "subtitle", "time": 10299.87, "timestamp": "02:51:39", "text": "快速演奏"}, {"type": "subtitle", "time": 10302.67, "timestamp": "02:51:42", "text": "我和我的帮派"}, {"type": "subtitle", "time": 10307.309, "timestamp": "02:51:47", "text": "我真的真的真的真的真的呃"}, {"type": "subtitle", "time": 10311.11, "timestamp": "02:51:51", "text": "紧张、害羞，情绪复杂"}, {"type": "subtitle", "time": 10313.79, "timestamp": "02:51:53", "text": "现在"}, {"type": "subtitle", "time": 10317.429, "timestamp": "02:51:57", "text": "但是，我希望一切顺利。"}, {"type": "subtitle", "time": 10319.87, "timestamp": "02:51:59", "text": "这就是我全部的愿望"}]
[{"type": "subtitle", "time": 11043.59, "timestamp": "03:04:03", "text": "总是这样。你需要休息一下。乔克。"}, {"type": "subtitle", "time": 11047.349, "timestamp": "03:04:07", "text": "我有手电筒。是的。我"}, {"type": "subtitle", "time": 11049.11, "timestamp": "03:04:09", "text": "如果您喜欢，我将非常感激。"}, {"type": "subtitle", "time": 11051.309, "timestamp": "03:04:11", "text": "未来。"}, {"type": "subtitle", "time": 11054.95, "timestamp": "03:04:14", "text": "为什么？呃，我为什么……我为什么要服用……"}, {"type": "subtitle", "time": 11057.19, "timestamp": "03:04:17", "text": "手电筒？没什么，没什么私人恩怨。我"}, {"type": "subtitle", "time": 11058.95, "timestamp": "03:04:18", "text": "你是唯一一个拥有……的人"}, {"type": "subtitle", "time": 11061.75, "timestamp": "03:04:21", "text": "手电筒。是的。好的。我要"}, {"type": "subtitle", "time": 11064.79, "timestamp": "03:04:24", "text": "找找类似开关之类的东西。哦，我们"}, {"type": "subtitle", "time": 11066.71, "timestamp": "03:04:26", "text": "已经有五六个了，差不多十个了"}, {"type": "subtitle", "time": 11070.07, "timestamp": "03:04:30", "text": "10°。是的。哦，所以开关不起作用"}, {"type": "subtitle", "time": 11071.83, "timestamp": "03:04:31", "text": "工作。所以，停电了。"}, {"type": "subtitle", "time": 11075.429, "timestamp": "03:04:35", "text": "已经。哦，是的。真是噩梦。为什么"}, {"type": "subtitle", "time": 11079.83, "timestamp": "03:04:39", "text": "这扇门是不是半开着？"}, {"type": "subtitle", "time": 11082.87, "timestamp": "03:04:42", "text": "帮助。哦，不。先生，您在哪里？"}, {"type": "subtitle", "time": 11084.67, "timestamp": "03:04:44", "text": "雅克？"}, {"type": "subtitle", "time": 11086.95, "timestamp": "03:04:46", "text": "呃，你们看过关于……的文章吗？"}, {"type": "subtitle", "time": 11089.269, "timestamp": "03:04:49", "text": "鬼魂？那鬼魂到底是什么？"}, {"type": "subtitle", "time": 11094.79, "timestamp": "03:04:54", "text": "关于？不，我没有。好吧，我做不到。"}, {"type": "subtitle", "time": 11097.03, "timestamp": "03:04:57", "text": "等等，为什么这个东西只开了一半？"}]
[{"type": "subtitle", "time": 13620.07, "timestamp": "03:47:00", "text": "一切。对于那些不了解的人来说，我"}, {"type": "subtitle", "time": 13623.63, "timestamp": "03:47:03", "text": "给了 hush 临时权限。"}, {"type": "subtitle", "time": 13626.429, "timestamp": "03:47:06", "text": "直播是因为我感觉"}, {"type": "subtitle", "time": 13629.07, "timestamp": "03:47:09", "text": "嗯，如果需要的话"}, {"type": "subtitle", "time": 13632.79, "timestamp": "03:47:12", "text": "现在。但别担心。呃，他只是个"}, {"type": "subtitle", "time": 13635.83, "timestamp": "03:47:15", "text": "临时模式。想象一下如果他得到"}, {"type": "subtitle", "time": 13638.11, "timestamp": "03:47:18", "text": "当选为"}, {"type": "subtitle", "time": 13646.469, "timestamp": "03:47:26", "text": "是啊，因为我根本没时间"}, {"type": "subtitle", "time": 13648.55, "timestamp": "03:47:28", "text": "因为我当时真的在速通"}, {"type": "subtitle", "time": 13651.11, "timestamp": "03:47:31", "text": "还有其他一些东西。我本应该"}, {"type": "subtitle", "time": 13654.87, "timestamp": "03:47:34", "text": "比如修改聊天规则等等"}, {"type": "subtitle", "time": 13658.229, "timestamp": "03:47:38", "text": "聊天论坛上说的那些话，每个人都说了些什么"}, {"type": "subtitle", "time": 13660.79, "timestamp": "03:47:40", "text": "过来看看吧"}, {"type": "subtitle", "time": 13663.349, "timestamp": "03:47:43", "text": "直播聊天规则等等，以及不要"}, {"type": "subtitle", "time": 13664.87, "timestamp": "03:47:44", "text": "把它弄坏之类的。我当时"}, {"type": "subtitle", "time": 13667.91, "timestamp": "03:47:47", "text": "我本该那么做，但我却直接跑了。"}, {"type": "subtitle", "time": 13670.309, "timestamp": "03:47:50", "text": "时间到了。已经到了……的时间。"}, {"type": "subtitle", "time": 13672.15, "timestamp": "03:47:52", "text": "合作之类的。"}, {"type": "subtitle", "time": 13673.229, "timestamp": "03:47:53", "text": "所以，我"}, {"type": "subtitle", "time": 13676.15, "timestamp": "03:47:56", "text": "我无法解释为什么我讨厌她追逐我的方式。哦"}]
[{"type": "subtitle", "time": 10680.469, "timestamp": "02:58:00", "text": "每个人。你好。你好吗？我想要"}, {"type": "subtitle", "time": 10688.389, "timestamp": "02:58:08", "text": "我不……这就像被毁了一样。"}, {"type": "subtitle", "time": 10691.07, "timestamp": "02:58:11", "text": "自动播放，但就像我想要的那样"}, {"type": "subtitle", "time": 10694.95, "timestamp": "02:58:14", "text": "致塞拉斯蒂娅。好的。哦，外面那个人是我。"}, {"type": "subtitle", "time": 10697.99, "timestamp": "02:58:17", "text": "窗户。凉爽的。没错，是塞拉斯蒂娅。"}, {"type": "subtitle", "time": 10702.55, "timestamp": "02:58:22", "text": "还有你这种偷袭行为。不，喜欢我"}, {"type": "subtitle", "time": 10709.07, "timestamp": "02:58:29", "text": "玉米你。等等，别这样"}, {"type": "subtitle", "time": 10711.99, "timestamp": "02:58:31", "text": "茶包。我在公开聊天记录里找到的。"}, {"type": "subtitle", "time": 10714.71, "timestamp": "02:58:34", "text": "美好的。"}, {"type": "subtitle", "time": 10718.23, "timestamp": "02:58:38", "text": "我的天哪。这是卖面包的人送的。"}, {"type": "subtitle", "time": 10721.429, "timestamp": "02:58:41", "text": "面包师。是的，是用面包做的。那是"}, {"type": "subtitle", "time": 10723.67, "timestamp": "02:58:43", "text": "太可爱了。"}, {"type": "subtitle", "time": 10727.19, "timestamp": "02:58:47", "text": "真是太有才了。是的。太棒了"}, {"type": "subtitle", "time": 10731.11, "timestamp": "02:58:51", "text": "太棒了，兄弟。鸟人。你好。如果"}, {"type": "subtitle", "time": 10733.99, "timestamp": "02:58:53", "text": "你现在是在Jacqu的聊天室还是Celestia的聊天室？"}, {"type": "subtitle", "time": 10736.79, "timestamp": "02:58:56", "text": "你好。"}, {"type": "subtitle", "time": 10739.83, "timestamp": "02:58:59", "text": "是的。你好。开始游戏。好的。"}]
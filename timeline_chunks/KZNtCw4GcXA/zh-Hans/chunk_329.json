[{"type": "subtitle", "time": 19741.31, "timestamp": "05:29:01", "text": "尽管。"}, {"type": "subtitle", "time": 19743.628, "timestamp": "05:29:03", "text": "呃，发生了什么事？哦，我们当时只是"}, {"type": "subtitle", "time": 19747.99, "timestamp": "05:29:07", "text": "说。我突然想找人聊聊天。我"}, {"type": "subtitle", "time": 19748.99, "timestamp": "05:29:08", "text": "刚到"}, {"type": "subtitle", "time": 19752.07, "timestamp": "05:29:12", "text": "后退。我为把WS放进去感到内疚。"}, {"type": "subtitle", "time": 19756.5, "timestamp": "05:29:16", "text": "东西。"}, {"type": "subtitle", "time": 19757.708, "timestamp": "05:29:17", "text": "[音乐]"}, {"type": "subtitle", "time": 19761.59, "timestamp": "05:29:21", "text": "是啊，就像昨天一样，我感觉糟透了。我"}, {"type": "subtitle", "time": 19763.83, "timestamp": "05:29:23", "text": "知道。昨天是重要的一天，"}, {"type": "subtitle", "time": 19767.15, "timestamp": "05:29:27", "text": "我，因为我和风险投资人合作过。"}, {"type": "subtitle", "time": 19770.07, "timestamp": "05:29:30", "text": "会议。呃，我本来应该……"}, {"type": "subtitle", "time": 19773.39, "timestamp": "05:29:33", "text": "有课，但我认为没有"}, {"type": "subtitle", "time": 19774.91, "timestamp": "05:29:34", "text": "课程。"}, {"type": "subtitle", "time": 19778.07, "timestamp": "05:29:38", "text": "嗯，很多类似的事情，而我只是"}, {"type": "subtitle", "time": 19780.708, "timestamp": "05:29:40", "text": "只出现了 2 次直播"}, {"type": "subtitle", "time": 19784.23, "timestamp": "05:29:44", "text": "第一部分最多需要2到3个小时。"}, {"type": "subtitle", "time": 19787.19, "timestamp": "05:29:47", "text": "溪流。昨天我在切割V"}, {"type": "subtitle", "time": 19789.628, "timestamp": "05:29:49", "text": "而我当时确实"}, {"type": "subtitle", "time": 19794.83, "timestamp": "05:29:54", "text": "感觉糟透了，唉，这真是"}, {"type": "subtitle", "time": 19799.47, "timestamp": "05:29:59", "text": "就像糟糕透了，对吧？我不在那儿。"}]
[{"type": "subtitle", "time": 181.35, "timestamp": "00:03:01", "text": "游戏总是关于你，我正在玩"}, {"type": "subtitle", "time": 184.11, "timestamp": "00:03:04", "text": "他们总是"}, {"type": "subtitle", "time": 187.71, "timestamp": "00:03:07", "text": "我现在感觉就像"}, {"type": "subtitle", "time": 191.71, "timestamp": "00:03:11", "text": "我真的想做什么"}, {"type": "subtitle", "time": 195.55, "timestamp": "00:03:15", "text": "此时。我就是这种感觉。"}, {"type": "subtitle", "time": 198.15, "timestamp": "00:03:18", "text": "喜欢。我真的想玩这个游戏吗？"}, {"type": "subtitle", "time": 200.27, "timestamp": "00:03:20", "text": "[音乐]"}, {"type": "subtitle", "time": 203.43, "timestamp": "00:03:23", "text": "游戏？坚持，稍等。我还没想过"}, {"type": "subtitle", "time": 206.589, "timestamp": "00:03:26", "text": "玩嗯链"}, {"type": "subtitle", "time": 213.50900000000001, "timestamp": "00:03:33", "text": "独奏。坚持，稍等。"}, {"type": "subtitle", "time": 217.07, "timestamp": "00:03:37", "text": "我知道现在大多数人都已经明白了。"}, {"type": "subtitle", "time": 220.309, "timestamp": "00:03:40", "text": "我已经厌倦了自己单打独斗的内容创作。"}, {"type": "subtitle", "time": 223.91, "timestamp": "00:03:43", "text": "与其说是合作，不如说是其他什么合作。"}, {"type": "subtitle", "time": 230.55, "timestamp": "00:03:50", "text": "我不知道。有时我觉得自己"}, {"type": "subtitle", "time": 234.67000000000002, "timestamp": "00:03:54", "text": "更适合单人独奏类型的"}]
[{"type": "subtitle", "time": 15301.59, "timestamp": "04:15:01", "text": "描述。我刚刚添加了。你"}, {"type": "subtitle", "time": 15304.269, "timestamp": "04:15:04", "text": "如果你愿意的话，可以填写一下。"}, {"type": "subtitle", "time": 15307.149, "timestamp": "04:15:07", "text": "如果你喜欢，请支持。"}, {"type": "subtitle", "time": 15312.79, "timestamp": "04:15:12", "text": "嗯，申请这份工作。您可以继续填写。"}, {"type": "subtitle", "time": 15315.51, "timestamp": "04:15:15", "text": "形式等等。截止日期"}, {"type": "subtitle", "time": 15318.189, "timestamp": "04:15:18", "text": "表格将是"}, {"type": "subtitle", "time": 15322.83, "timestamp": "04:15:22", "text": "10月26日。接下来就是这个了。"}, {"type": "subtitle", "time": 15324.79, "timestamp": "04:15:24", "text": "周四。那是其中一件事。"}, {"type": "subtitle", "time": 15329.469, "timestamp": "04:15:29", "text": "我想……说出来"}, {"type": "subtitle", "time": 15332.67, "timestamp": "04:15:32", "text": "今天。是的，我很期待……"}, {"type": "subtitle", "time": 15335.189, "timestamp": "04:15:35", "text": "今天。是我感觉错了吗？还是你突然断线了？"}, {"type": "subtitle", "time": 15336.95, "timestamp": "04:15:36", "text": "等等，我要退出了。等等，我是"}, {"type": "subtitle", "time": 15340.349, "timestamp": "04:15:40", "text": "切断。等等，我是"}, {"type": "subtitle", "time": 15344.469, "timestamp": "04:15:44", "text": "等等，真的吗？"}, {"type": "subtitle", "time": 15346.83, "timestamp": "04:15:46", "text": "我要退出。"}, {"type": "subtitle", "time": 15350.51, "timestamp": "04:15:50", "text": "什么？嘿，什么？"}, {"type": "subtitle", "time": 15353.99, "timestamp": "04:15:53", "text": "H：哦，不。我要退出。这很糟糕。"}, {"type": "subtitle", "time": 15355.309, "timestamp": "04:15:55", "text": "这是"}]
[{"type": "subtitle", "time": 18487.27, "timestamp": "05:08:07", "text": "那。今天我谈到了如何"}, {"type": "subtitle", "time": 18489.15, "timestamp": "05:08:09", "text": "我性格内向。"}, {"type": "subtitle", "time": 18493.15, "timestamp": "05:08:13", "text": "正确的？嗯，我到底有多内向？"}, {"type": "subtitle", "time": 18496.948, "timestamp": "05:08:16", "text": "得到，诸如此类的事情。"}, {"type": "subtitle", "time": 18500.19, "timestamp": "05:08:20", "text": "比如，嗯……我该从哪里开始呢？"}, {"type": "subtitle", "time": 18504.47, "timestamp": "05:08:24", "text": "例如例如"}, {"type": "subtitle", "time": 18506.11, "timestamp": "05:08:26", "text": "呃，你"}, {"type": "subtitle", "time": 18509.19, "timestamp": "05:08:29", "text": "我知道，即使在玩《Valerant》的时候，我也经常遇到这种情况。"}, {"type": "subtitle", "time": 18517.788, "timestamp": "05:08:37", "text": "等等，我还没上线呢。"}, {"type": "subtitle", "time": 18539.02, "timestamp": "05:08:59", "text": "上帝。我刚刚才意识到这一点。"}]
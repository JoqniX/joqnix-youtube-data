[{"type": "subtitle", "time": 13860.229, "timestamp": "03:51:00", "text": "截止至10月26日。接下来就是这个了"}, {"type": "subtitle", "time": 13861.75, "timestamp": "03:51:01", "text": "周四。"}, {"type": "subtitle", "time": 13865.03, "timestamp": "03:51:05", "text": "我会等大家。"}, {"type": "subtitle", "time": 13868.469, "timestamp": "03:51:08", "text": "提交等等。然后17号我会喜欢"}, {"type": "subtitle", "time": 13871.269, "timestamp": "03:51:11", "text": "是的，在16号关门之后，我会"}, {"type": "subtitle", "time": 13873.59, "timestamp": "03:51:13", "text": "16号晚上，我得等到12点。"}, {"type": "subtitle", "time": 13878.389, "timestamp": "03:51:18", "text": "是的，17号晚上我会把它关掉。呃，17号"}, {"type": "subtitle", "time": 13882.79, "timestamp": "03:51:22", "text": "凌晨12点，我会关掉它，而且真的会关掉。"}, {"type": "subtitle", "time": 13885.389, "timestamp": "03:51:25", "text": "呃，最终确定"}, {"type": "subtitle", "time": 13887.95, "timestamp": "03:51:27", "text": "结果。所以"}, {"type": "subtitle", "time": 13896.75, "timestamp": "03:51:36", "text": "所以，我本来想说的是……"}, {"type": "subtitle", "time": 13903.03, "timestamp": "03:51:43", "text": "我觉得是时候真正地"}, {"type": "subtitle", "time": 13905.11, "timestamp": "03:51:45", "text": "别再拖延了，赶紧走起来。"}, {"type": "subtitle", "time": 13908.15, "timestamp": "03:51:48", "text": "在网站上。所以，我真的……"}, {"type": "subtitle", "time": 13911.349, "timestamp": "03:51:51", "text": "看着镜头"}, {"type": "subtitle", "time": 13915.269, "timestamp": "03:51:55", "text": "呃，网站，呃，因为它有人工智能。"}, {"type": "subtitle", "time": 13918.15, "timestamp": "03:51:58", "text": "我用人工智能做了一个模板。"}]
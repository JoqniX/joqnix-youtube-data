[{"type": "subtitle", "time": 12361.99, "timestamp": "03:26:01", "text": "瘦长鬼影。好的。嗯？在哪里？"}, {"type": "subtitle", "time": 12372.63, "timestamp": "03:26:12", "text": "瞧瞧。瞧瞧。我的天啊。"}, {"type": "subtitle", "time": 12375.91, "timestamp": "03:26:15", "text": "那很好。不，我从来没有"}, {"type": "subtitle", "time": 12379.03, "timestamp": "03:26:19", "text": "回首往事。"}, {"type": "subtitle", "time": 12380.389, "timestamp": "03:26:20", "text": "意思是说你看起来很酷"}, {"type": "subtitle", "time": 12385.55, "timestamp": "03:26:25", "text": "光剑"}, {"type": "subtitle", "time": 12389.349, "timestamp": "03:26:29", "text": "来。等等，我怎么会觉得我好像觉得我"}, {"type": "subtitle", "time": 12391.11, "timestamp": "03:26:31", "text": "必须先打开它，然后直接放进去就行了。"}, {"type": "subtitle", "time": 12393.11, "timestamp": "03:26:33", "text": "地板。我想就是这样。"}, {"type": "subtitle", "time": 12395.11, "timestamp": "03:26:35", "text": "我现在应该用DOS系统了。"}, {"type": "subtitle", "time": 12396.95, "timestamp": "03:26:36", "text": "是的。这就是我，这就是我"}, {"type": "subtitle", "time": 12399.03, "timestamp": "03:26:39", "text": "应该这样做。好的。总之，我会"}, {"type": "subtitle", "time": 12401.11, "timestamp": "03:26:41", "text": "再捡起来。捡起来。这"}, {"type": "subtitle", "time": 12402.469, "timestamp": "03:26:42", "text": "就是在那里提到的。把它捡起来。选它"}, {"type": "subtitle", "time": 12404.71, "timestamp": "03:26:44", "text": "向上。好的，明白了。他们喜欢改变吗？"}, {"type": "subtitle", "time": 12405.469, "timestamp": "03:26:45", "text": "这"}, {"type": "subtitle", "time": 12409.11, "timestamp": "03:26:49", "text": "地图？我认为是因为帐篷是"}, {"type": "subtitle", "time": 12411.19, "timestamp": "03:26:51", "text": "应该像低一样小，但是"}, {"type": "subtitle", "time": 12413.91, "timestamp": "03:26:53", "text": "感觉不太低。我不知道什么"}, {"type": "subtitle", "time": 12417.429, "timestamp": "03:26:57", "text": "他们对此做了什么。我玩得很开心。"}]
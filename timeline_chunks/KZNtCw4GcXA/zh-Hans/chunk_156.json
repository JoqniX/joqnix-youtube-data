[{"type": "subtitle", "time": 9387.03, "timestamp": "02:36:27", "text": "还剩一个敌人。那是三个。我的"}, {"type": "subtitle", "time": 9405.71, "timestamp": "02:36:45", "text": "这是"}, {"type": "subtitle", "time": 9408.349, "timestamp": "02:36:48", "text": "凉爽的。这很酷"}, {"type": "subtitle", "time": 9413.03, "timestamp": "02:36:53", "text": "枪。它只是可能找到一份工作。"}]
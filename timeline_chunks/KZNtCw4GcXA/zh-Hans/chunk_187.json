[{"type": "subtitle", "time": 11222.469, "timestamp": "03:07:02", "text": "是的。好的。"}, {"type": "subtitle", "time": 11225.19, "timestamp": "03:07:05", "text": "为什么我不能看你？"}, {"type": "subtitle", "time": 11227.91, "timestamp": "03:07:07", "text": "是的。打开它。哦，这是什么？"}, {"type": "subtitle", "time": 11231.91, "timestamp": "03:07:11", "text": "人体模型。啊。哦，它走了。这就是这个"}, {"type": "subtitle", "time": 11233.429, "timestamp": "03:07:13", "text": "简直好太多了。我不必"}, {"type": "subtitle", "time": 11236.469, "timestamp": "03:07:16", "text": "现在请使用我的摄像头进行导航。好的。"}, {"type": "subtitle", "time": 11238.95, "timestamp": "03:07:18", "text": "我们走吧。反正它都要爆炸了。"}, {"type": "subtitle", "time": 11240.79, "timestamp": "03:07:20", "text": "谁在乎呢？对，没错。它要走了"}, {"type": "subtitle", "time": 11243.429, "timestamp": "03:07:23", "text": "无论如何都要离开。为什么？但你知道，我"}, {"type": "subtitle", "time": 11247.63, "timestamp": "03:07:27", "text": "想看一点。"}, {"type": "subtitle", "time": 11252.87, "timestamp": "03:07:32", "text": "我躲在楼上某个角落里。"}, {"type": "subtitle", "time": 11254.95, "timestamp": "03:07:34", "text": "哦，楼上。哦，我忘了。通常情况下"}, {"type": "subtitle", "time": 11257.67, "timestamp": "03:07:37", "text": "楼上会有鬼魂出没。是的。"}, {"type": "subtitle", "time": 11259.19, "timestamp": "03:07:39", "text": "杰克，你能过来吗？"}, {"type": "subtitle", "time": 11262.87, "timestamp": "03:07:42", "text": "楼上？你为什么想让我来？我 我"}, {"type": "subtitle", "time": 11265.429, "timestamp": "03:07:45", "text": "希望你来，因为你有"}, {"type": "subtitle", "time": 11268.389, "timestamp": "03:07:48", "text": "手电筒。对，没错。确切地。你"}, {"type": "subtitle", "time": 11270.309, "timestamp": "03:07:50", "text": "带上手电筒。你看，你有"}, {"type": "subtitle", "time": 11271.91, "timestamp": "03:07:51", "text": "手电筒。你是什​​么意思？为什么我会"}, {"type": "subtitle", "time": 11273.429, "timestamp": "03:07:53", "text": "必须？如果你愿意，你可以躲在这里。"}, {"type": "subtitle", "time": 11276.87, "timestamp": "03:07:56", "text": "想。你可以和幽灵学长对话。"}, {"type": "subtitle", "time": 11279.11, "timestamp": "03:07:59", "text": "利用那股推力。"}]
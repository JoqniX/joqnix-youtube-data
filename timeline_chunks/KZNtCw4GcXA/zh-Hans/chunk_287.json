[{"type": "subtitle", "time": 17221.43, "timestamp": "04:47:01", "text": "一切。我觉得手电筒之类的"}, {"type": "subtitle", "time": 17223.47, "timestamp": "04:47:03", "text": "例外情况或其他什么情况。我不"}, {"type": "subtitle", "time": 17224.64, "timestamp": "04:47:04", "text": "知道。"}, {"type": "subtitle", "time": 17226.67, "timestamp": "04:47:06", "text": "[笑声]"}, {"type": "subtitle", "time": 17229.39, "timestamp": "04:47:09", "text": "可怕。这张地图的"}, {"type": "subtitle", "time": 17239.03, "timestamp": "04:47:19", "text": "好的，它有点卡顿。哦，我其实挺喜欢的"}, {"type": "subtitle", "time": 17240.868, "timestamp": "04:47:20", "text": "这张地图。这有点像……这有点像"}, {"type": "subtitle", "time": 17243.83, "timestamp": "04:47:23", "text": "可爱的。天气很冷。哦不，"}, {"type": "subtitle", "time": 17247.55, "timestamp": "04:47:27", "text": "野营。哦不，不会是这个吧。"}, {"type": "subtitle", "time": 17250.23, "timestamp": "04:47:30", "text": "扎克，看看那个枕头。看看"}, {"type": "subtitle", "time": 17251.99, "timestamp": "04:47:31", "text": "水池。"}, {"type": "subtitle", "time": 17255.83, "timestamp": "04:47:35", "text": "我的意思是，你们都是专业人士。我不是。"}, {"type": "subtitle", "time": 17257.67, "timestamp": "04:47:37", "text": "好吧，我决定选择 Doss。我是"}, {"type": "subtitle", "time": 17260.23, "timestamp": "04:47:40", "text": "去睡懒觉。"}, {"type": "subtitle", "time": 17261.83, "timestamp": "04:47:41", "text": "我真的不知道该怎么玩这个"}, {"type": "subtitle", "time": 17264.39, "timestamp": "04:47:44", "text": "玩游戏，但我来这里是为了感受氛围。我可以"}, {"type": "subtitle", "time": 17267.11, "timestamp": "04:47:47", "text": "我可以吗？我们有灵盒，对吧？我"}, {"type": "subtitle", "time": 17269.27, "timestamp": "04:47:49", "text": "可以做灵盒实验。"}, {"type": "subtitle", "time": 17272.39, "timestamp": "04:47:52", "text": "是的，我是个神。我是神。患病的"}, {"type": "subtitle", "time": 17275.91, "timestamp": "04:47:55", "text": "拿起紫色荧光棒。"}, {"type": "subtitle", "time": 17278.99, "timestamp": "04:47:58", "text": "克洛诺斯来了。你好。嘘"}]
[{"type": "subtitle", "time": 16443.189, "timestamp": "04:34:03", "text": "小型激光笔投射出一束细小的激光束"}, {"type": "subtitle", "time": 16445.91, "timestamp": "04:34:05", "text": "将光线引入环境。手持式"}, {"type": "subtitle", "time": 16449.59, "timestamp": "04:34:09", "text": "移动中的投影机。哦。哦，dos"}, {"type": "subtitle", "time": 16453.59, "timestamp": "04:34:13", "text": "保护者。我们需要那个。哦。"}, {"type": "subtitle", "time": 16456.07, "timestamp": "04:34:16", "text": "总之，我们走吧。"}, {"type": "subtitle", "time": 16457.83, "timestamp": "04:34:17", "text": "好的。总之，我们走吧。"}, {"type": "subtitle", "time": 16459.91, "timestamp": "04:34:19", "text": "专业的。喜欢。我不想"}, {"type": "subtitle", "time": 16462.47, "timestamp": "04:34:22", "text": "死得快点。"}, {"type": "subtitle", "time": 16465.629, "timestamp": "04:34:25", "text": "中间的。你知道吗？"}, {"type": "subtitle", "time": 16468.869, "timestamp": "04:34:28", "text": "专业的。让我们走向专业化。"}, {"type": "subtitle", "time": 16470.789, "timestamp": "04:34:30", "text": "中级将会是它即将到来"}, {"type": "subtitle", "time": 16473.109, "timestamp": "04:34:33", "text": "如果你……那就会变得很无聊。"}, {"type": "subtitle", "time": 16474.551, "timestamp": "04:34:34", "text": "准备升入中级。专业的，"}, {"type": "subtitle", "time": 16478.07, "timestamp": "04:34:38", "text": "我认为。死得快不快，没人关心。"}, {"type": "subtitle", "time": 16480.39, "timestamp": "04:34:40", "text": "就这么办吧。"}, {"type": "subtitle", "time": 16486.15, "timestamp": "04:34:46", "text": "是的。准备好了。是的。"}, {"type": "subtitle", "time": 16489.47, "timestamp": "04:34:49", "text": "准备好？耶。"}]
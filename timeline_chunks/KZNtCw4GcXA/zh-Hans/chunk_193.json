[{"type": "subtitle", "time": 11581.67, "timestamp": "03:13:01", "text": "死。我们干脆去死吧。其实没那么难。"}, {"type": "subtitle", "time": 11583.269, "timestamp": "03:13:03", "text": "我们只是在玩这个游戏而已。"}, {"type": "subtitle", "time": 11585.349, "timestamp": "03:13:05", "text": "专业的。是啊，我们只是，你"}, {"type": "subtitle", "time": 11587.91, "timestamp": "03:13:07", "text": "知道，就像看房地产一样。是的，"}, {"type": "subtitle", "time": 11590.15, "timestamp": "03:13:10", "text": "我们就像是在炒房一样。"}, {"type": "subtitle", "time": 11592.309, "timestamp": "03:13:12", "text": "谁会在意呢，对吧？对，没错。除了"}, {"type": "subtitle", "time": 11594.71, "timestamp": "03:13:14", "text": "为了鬼魂。没人关心。是的。不，"}, {"type": "subtitle", "time": 11597.11, "timestamp": "03:13:17", "text": "没人关心。没人关心。"}, {"type": "subtitle", "time": 11599.429, "timestamp": "03:13:19", "text": "我的天啊。啊，是的。最后，我们还有"}, {"type": "subtitle", "time": 11604.63, "timestamp": "03:13:24", "text": "moners。上帝。无聊的。砰。手电筒。"}, {"type": "subtitle", "time": 11606.389, "timestamp": "03:13:26", "text": "耶。"}, {"type": "subtitle", "time": 11608.07, "timestamp": "03:13:28", "text": "手电筒。"}, {"type": "subtitle", "time": 11613.83, "timestamp": "03:13:33", "text": "我可以，我可以，我可以像制造幽灵一样。"}, {"type": "subtitle", "time": 11617.51, "timestamp": "03:13:37", "text": "这手电筒的光亮让我眼花缭乱。"}, {"type": "subtitle", "time": 11621.91, "timestamp": "03:13:41", "text": "哦，不错。好的。对讲机紫外线灯。某人"}, {"type": "subtitle", "time": 11630.15, "timestamp": "03:13:50", "text": "嗯，我可以绘制电磁图。"}, {"type": "subtitle", "time": 11637.389, "timestamp": "03:13:57", "text": "我可能会带上游戏相机"}]
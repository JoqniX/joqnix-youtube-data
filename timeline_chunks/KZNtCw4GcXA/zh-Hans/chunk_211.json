[{"type": "subtitle", "time": 12661.99, "timestamp": "03:31:01", "text": "房间呢？"}, {"type": "subtitle", "time": 12664.71, "timestamp": "03:31:04", "text": "逃出后面的房间。不是进入"}, {"type": "subtitle", "time": 12667.429, "timestamp": "03:31:07", "text": "后屋。我从后面的房间里逃了出来。哦"}, {"type": "subtitle", "time": 12670.79, "timestamp": "03:31:10", "text": "男生。任何。我和时间以及西摩"}, {"type": "subtitle", "time": 12673.03, "timestamp": "03:31:13", "text": "玩过。我觉得塞拉斯蒂娅有。你"}, {"type": "subtitle", "time": 12675.03, "timestamp": "03:31:15", "text": "你有吧？是的，我确实有。"}, {"type": "subtitle", "time": 12677.67, "timestamp": "03:31:17", "text": "但我从来没玩过。你想玩"}, {"type": "subtitle", "time": 12681.03, "timestamp": "03:31:21", "text": "它？什么？哦，等等。等等，给我一个"}, {"type": "subtitle", "time": 12682.71, "timestamp": "03:31:22", "text": "第二。比如，你们公司允许吗？"}, {"type": "subtitle", "time": 12685.75, "timestamp": "03:31:25", "text": "它？这就是核心概念。"}, {"type": "subtitle", "time": 12689.429, "timestamp": "03:31:29", "text": "哪家公司允许什么？呃，就像……"}, {"type": "subtitle", "time": 12694.389, "timestamp": "03:31:34", "text": "每月一次。嗯，是的，每月一次。"}, {"type": "subtitle", "time": 12702.389, "timestamp": "03:31:42", "text": "我也想玩泰拉瑞亚"}, {"type": "subtitle", "time": 12703.83, "timestamp": "03:31:43", "text": "因为我不知道怎么玩"}, {"type": "subtitle", "time": 12707.349, "timestamp": "03:31:47", "text": "泰拉瑞亚。我也是。"}, {"type": "subtitle", "time": 12709.51, "timestamp": "03:31:49", "text": "2D版《我的世界》。"}, {"type": "subtitle", "time": 12713.269, "timestamp": "03:31:53", "text": "对，是2D的。 2D版《我的世界》。是的，2D"}, {"type": "subtitle", "time": 12716.87, "timestamp": "03:31:56", "text": "我的世界。我的世界。我喜欢挖，我挖"}, {"type": "subtitle", "time": 12719.19, "timestamp": "03:31:59", "text": "走了两个街区我就死了。这就是我全部的内容。"}]
[{"type": "subtitle", "time": 10201.55, "timestamp": "02:50:01", "text": "休息一下。午餐"}, {"type": "subtitle", "time": 10205.11, "timestamp": "02:50:05", "text": "休息。我会回来的。尽情享受吧！"}, {"type": "subtitle", "time": 10207.67, "timestamp": "02:50:07", "text": "你。去吃饭，喝水，做这些事。"}, {"type": "subtitle", "time": 10209.07, "timestamp": "02:50:09", "text": "来"}, {"type": "subtitle", "time": 10211.51, "timestamp": "02:50:11", "text": "后退。好的。小心。我会"}, {"type": "subtitle", "time": 10212.67, "timestamp": "02:50:12", "text": "后退。"}]
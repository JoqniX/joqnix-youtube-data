[{"type": "subtitle", "time": 19274.67, "timestamp": "05:21:14", "text": "垃圾。但是，我的意思是"}, {"type": "subtitle", "time": 19278.11, "timestamp": "05:21:18", "text": "嗯，我有很多东西，我的东西都在我的……"}, {"type": "subtitle", "time": 19281.628, "timestamp": "05:21:21", "text": "介意我感觉我想……"}, {"type": "subtitle", "time": 19284.708, "timestamp": "05:21:24", "text": "地址。我不知道是不是"}, {"type": "subtitle", "time": 19290.83, "timestamp": "05:21:30", "text": "然而，"}, {"type": "subtitle", "time": 19294.39, "timestamp": "05:21:34", "text": "但我完全没有看过这本书。它是"}, {"type": "subtitle", "time": 19295.55, "timestamp": "05:21:35", "text": "好的。好的"}, {"type": "subtitle", "time": 19301.19, "timestamp": "05:21:41", "text": "运气。请务必仔细阅读并认真学习。"}, {"type": "subtitle", "time": 19309.19, "timestamp": "05:21:49", "text": "但尽我所能并不意味着"}, {"type": "subtitle", "time": 19312.708, "timestamp": "05:21:52", "text": "你知道，他不喜欢那个词。"}, {"type": "subtitle", "time": 19315.67, "timestamp": "05:21:55", "text": "尽你所能，嗯，我也会尽力而为。"}, {"type": "subtitle", "time": 19318.708, "timestamp": "05:21:58", "text": "最好可能会被误解，也可能是"}]
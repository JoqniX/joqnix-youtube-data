[{"type": "subtitle", "time": 19020.19, "timestamp": "05:17:00", "text": "圣。我得去把它送过去。"}, {"type": "subtitle", "time": 19022.868, "timestamp": "05:17:02", "text": "周一。哦，我周一才意识到"}, {"type": "subtitle", "time": 19024.628, "timestamp": "05:17:04", "text": "上音乐课。我不能错过。"}, {"type": "subtitle", "time": 19027.59, "timestamp": "05:17:07", "text": "屋顶。呃，我有点错过了，我的意思是……"}, {"type": "subtitle", "time": 19029.83, "timestamp": "05:17:09", "text": "周四和上周一都没课"}, {"type": "subtitle", "time": 19032.23, "timestamp": "05:17:12", "text": "也一样。两天没课。"}, {"type": "subtitle", "time": 19035.03, "timestamp": "05:17:15", "text": "我们也需要做音乐。我有点"}, {"type": "subtitle", "time": 19037.868, "timestamp": "05:17:17", "text": "不再做某事"}, {"type": "subtitle", "time": 19040.55, "timestamp": "05:17:20", "text": "那。我需要做的事情太多了。"}, {"type": "subtitle", "time": 19043.23, "timestamp": "05:17:23", "text": "我感觉"}, {"type": "subtitle", "time": 19046.868, "timestamp": "05:17:26", "text": "你们是不是觉得有点无聊了？"}, {"type": "subtitle", "time": 19049.43, "timestamp": "05:17:29", "text": "你们愿意和我一起待24小时吗？你有点像"}, {"type": "subtitle", "time": 19053.51, "timestamp": "05:17:33", "text": "大多数情况下，我们先排除视频点播。"}, {"type": "subtitle", "time": 19057.11, "timestamp": "05:17:37", "text": "某种程度上来说。从某种意义上说，就像几个小时那么长。"}, {"type": "subtitle", "time": 19060.15, "timestamp": "05:17:40", "text": "如果你愿意，可以把所有的v都去掉。"}, {"type": "subtitle", "time": 19063.03, "timestamp": "05:17:43", "text": "呃，休息了几次。"}, {"type": "subtitle", "time": 19067.15, "timestamp": "05:17:47", "text": "小时。我觉得我好像……我不知道"}, {"type": "subtitle", "time": 19069.47, "timestamp": "05:17:49", "text": "昨天。"}, {"type": "subtitle", "time": 19072.43, "timestamp": "05:17:52", "text": "嗯，我猜我睡着的时候大概是……"}, {"type": "subtitle", "time": 19076.03, "timestamp": "05:17:56", "text": "3:00 因为我下楼了"}, {"type": "subtitle", "time": 19079.59, "timestamp": "05:17:59", "text": "我凌晨三点才来吃饭。"}]
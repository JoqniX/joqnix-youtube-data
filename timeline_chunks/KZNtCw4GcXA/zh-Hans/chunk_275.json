[{"type": "subtitle", "time": 16506.551, "timestamp": "04:35:06", "text": "哦，是的。继续。我仍然忘记了如果"}, {"type": "subtitle", "time": 16508.869, "timestamp": "04:35:08", "text": "你死了，我们就损失了所有物资。是的，"}, {"type": "subtitle", "time": 16513.109, "timestamp": "04:35:13", "text": "没关系。没关系。"}, {"type": "subtitle", "time": 16516.07, "timestamp": "04:35:16", "text": "那确实有这么回事。哦，不。是的，那是一个"}, {"type": "subtitle", "time": 16518.47, "timestamp": "04:35:18", "text": "事物。是的，没问题。那就别死了。"}, {"type": "subtitle", "time": 16520.551, "timestamp": "04:35:20", "text": "没关系。是啊，咱们就都……"}, {"type": "subtitle", "time": 16523.83, "timestamp": "04:35:23", "text": "死。我们干脆去死吧。其实没那么难。"}, {"type": "subtitle", "time": 16525.429, "timestamp": "04:35:25", "text": "我们只是把它当作游戏来玩而已。"}, {"type": "subtitle", "time": 16527.51, "timestamp": "04:35:27", "text": "专业的。是啊，我们只是，你"}, {"type": "subtitle", "time": 16530.07, "timestamp": "04:35:30", "text": "知道，就像看房地产一样。是的，"}, {"type": "subtitle", "time": 16532.31, "timestamp": "04:35:32", "text": "我们就像是在炒房一样。"}, {"type": "subtitle", "time": 16534.47, "timestamp": "04:35:34", "text": "谁会在意呢，对吧？对，没错。除了"}, {"type": "subtitle", "time": 16536.869, "timestamp": "04:35:36", "text": "为了鬼魂。没人关心。是的。不，"}, {"type": "subtitle", "time": 16539.349, "timestamp": "04:35:39", "text": "没人关心。没人关心。"}, {"type": "subtitle", "time": 16541.59, "timestamp": "04:35:41", "text": "我的天啊。啊，是的。最后，我们还有"}, {"type": "subtitle", "time": 16546.789, "timestamp": "04:35:46", "text": "moners。上帝。砰。砰。手电筒。"}, {"type": "subtitle", "time": 16548.551, "timestamp": "04:35:48", "text": "耶。"}, {"type": "subtitle", "time": 16550.23, "timestamp": "04:35:50", "text": "手电筒。"}, {"type": "subtitle", "time": 16555.59, "timestamp": "04:35:55", "text": "去。我可以，我可以，我可以像做那样"}, {"type": "subtitle", "time": 16559.67, "timestamp": "04:35:59", "text": "用这手电筒照瞎鬼魂。"}]
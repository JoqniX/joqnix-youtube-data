[{"type": "subtitle", "time": 16325.67, "timestamp": "04:32:05", "text": "是的。我们俩都死了。让我们找到哦，"}, {"type": "subtitle", "time": 16327.91, "timestamp": "04:32:07", "text": "你看看那个？我们的身体。"}, {"type": "subtitle", "time": 16331.03, "timestamp": "04:32:11", "text": "是的。哦，总之，我就把它放在这里吧。"}, {"type": "subtitle", "time": 16334.91, "timestamp": "04:32:14", "text": "呃，还有呃，参见"}, {"type": "subtitle", "time": 16337.67, "timestamp": "04:32:17", "text": "某物。呃，我什么都看不见。"}, {"type": "subtitle", "time": 16340.229, "timestamp": "04:32:20", "text": "拉屎。手电筒在哪儿？"}, {"type": "subtitle", "time": 16342.87, "timestamp": "04:32:22", "text": "手电筒应该在我身上。"}, {"type": "subtitle", "time": 16345.67, "timestamp": "04:32:25", "text": "在楼上。嗯。哦，鬼魂是"}, {"type": "subtitle", "time": 16347.99, "timestamp": "04:32:27", "text": "上楼了。哦，不。是的。是的。跑步"}, {"type": "subtitle", "time": 16349.229, "timestamp": "04:32:29", "text": "离开。跑步"}, {"type": "subtitle", "time": 16353.51, "timestamp": "04:32:33", "text": "离开。我不想，我不想，我"}, {"type": "subtitle", "time": 16356.229, "timestamp": "04:32:36", "text": "我不想这样，我不能一个人玩。"}, {"type": "subtitle", "time": 16358.229, "timestamp": "04:32:38", "text": "这太蠢了。"}, {"type": "subtitle", "time": 16360.71, "timestamp": "04:32:40", "text": "哦，你噎住了。"}, {"type": "subtitle", "time": 16362.389, "timestamp": "04:32:42", "text": "是的，没问题。没关系。这是一个"}, {"type": "subtitle", "time": 16363.91, "timestamp": "04:32:43", "text": "轻柔的窒息。他就像在给我一个"}, {"type": "subtitle", "time": 16367.11, "timestamp": "04:32:47", "text": "颈部按摩。没关系。"}, {"type": "subtitle", "time": 16373.189, "timestamp": "04:32:53", "text": "哦，他们死了。好了，现在所有人都死了。"}, {"type": "subtitle", "time": 16374.71, "timestamp": "04:32:54", "text": "我觉得这就是噩梦的本质。"}, {"type": "subtitle", "time": 16376.229, "timestamp": "04:32:56", "text": "模式，对吧？它只会给你一种感觉"}, {"type": "subtitle", "time": 16378.95, "timestamp": "04:32:58", "text": "准备和运行需要一点时间"}]
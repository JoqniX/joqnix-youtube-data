[{"type": "subtitle", "time": 13749.349, "timestamp": "03:49:09", "text": "所以，Roku，谢谢你的光临。希望"}, {"type": "subtitle", "time": 13752.189, "timestamp": "03:49:12", "text": "你今天过得很愉快。现在"}, {"type": "subtitle", "time": 13775.83, "timestamp": "03:49:35", "text": "沙？没关系。没关系。不用担心。"}, {"type": "subtitle", "time": 13794.91, "timestamp": "03:49:54", "text": "所以你知道我"}]
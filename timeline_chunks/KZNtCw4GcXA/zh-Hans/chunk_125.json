[{"type": "subtitle", "time": 7501.07, "timestamp": "02:05:01", "text": "人们会参加首映式吗？"}, {"type": "subtitle", "time": 7503.43, "timestamp": "02:05:03", "text": "一切？他们是人吗？"}, {"type": "subtitle", "time": 7518.189, "timestamp": "02:05:18", "text": "我想说"}, {"type": "subtitle", "time": 7551.149, "timestamp": "02:05:51", "text": "如何进行社交？我是"}, {"type": "subtitle", "time": 7554.31, "timestamp": "02:05:54", "text": "害怕的。但说实话，事实是……"}, {"type": "subtitle", "time": 7558.229, "timestamp": "02:05:58", "text": "说真的，我不会这么害怕。"}]
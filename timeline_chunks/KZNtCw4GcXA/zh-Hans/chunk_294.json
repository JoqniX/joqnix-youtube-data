[{"type": "subtitle", "time": 17644.55, "timestamp": "04:54:04", "text": "我也想玩泰拉瑞亚"}, {"type": "subtitle", "time": 17645.99, "timestamp": "04:54:05", "text": "因为我不知道怎么玩"}, {"type": "subtitle", "time": 17649.51, "timestamp": "04:54:09", "text": "泰拉瑞亚。我也是。"}, {"type": "subtitle", "time": 17651.67, "timestamp": "04:54:11", "text": "2D版《我的世界》。"}, {"type": "subtitle", "time": 17655.43, "timestamp": "04:54:15", "text": "对，是2D的。 2D版《我的世界》。是的，2D"}, {"type": "subtitle", "time": 17659.03, "timestamp": "04:54:19", "text": "我的世界。我的世界。我喜欢挖，我挖"}, {"type": "subtitle", "time": 17661.35, "timestamp": "04:54:21", "text": "走了两个街区我就死了。这就是我全部的内容。"}, {"type": "subtitle", "time": 17663.27, "timestamp": "04:54:23", "text": "有。"}, {"type": "subtitle", "time": 17664.788, "timestamp": "04:54:24", "text": "我不知道。我甚至不知道那是什么。"}, {"type": "subtitle", "time": 17667.75, "timestamp": "04:54:27", "text": "有可能，但我死于向下挖掘"}, {"type": "subtitle", "time": 17673.75, "timestamp": "04:54:33", "text": "但我却莫名其妙地得到了一把铲子。"}, {"type": "subtitle", "time": 17676.59, "timestamp": "04:54:36", "text": "原因。"}, {"type": "subtitle", "time": 17679.51, "timestamp": "04:54:39", "text": "总之，就是这样。哦，塞拉斯蒂娅，"}, {"type": "subtitle", "time": 17682.708, "timestamp": "04:54:42", "text": "比如，如果你可以做多个"}, {"type": "subtitle", "time": 17687.99, "timestamp": "04:54:47", "text": "合作方面，我们可以像 Diwal 和 Oh 那样吗？"}, {"type": "subtitle", "time": 17690.948, "timestamp": "04:54:50", "text": "回家。回家。如果你也许如果"}, {"type": "subtitle", "time": 17694.55, "timestamp": "04:54:54", "text": "如果他们允许的话，你可以多次使用。"}, {"type": "subtitle", "time": 17697.11, "timestamp": "04:54:57", "text": "如果这是我的，那我就怀疑了。我们"}]
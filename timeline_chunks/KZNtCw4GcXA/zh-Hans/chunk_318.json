[{"type": "subtitle", "time": 19082.51, "timestamp": "05:18:02", "text": "做完腹部手术后回来"}, {"type": "subtitle", "time": 19086.868, "timestamp": "05:18:06", "text": "满的。我昨天在编辑……"}, {"type": "subtitle", "time": 19089.948, "timestamp": "05:18:09", "text": "夜间直播。不，早上"}, {"type": "subtitle", "time": 19093.948, "timestamp": "05:18:13", "text": "溪流。那就像是第 44 天，呃，第一部分。"}, {"type": "subtitle", "time": 19096.708, "timestamp": "05:18:16", "text": "溪流。我意识到我已经睡着了。"}, {"type": "subtitle", "time": 19100.07, "timestamp": "05:18:20", "text": "很早吧？不是说我来得早。"}, {"type": "subtitle", "time": 19103.75, "timestamp": "05:18:23", "text": "重新开始直播五到三十分钟"}, {"type": "subtitle", "time": 19107.03, "timestamp": "05:18:27", "text": "然后我就感觉筋疲力尽了。"}, {"type": "subtitle", "time": 19108.11, "timestamp": "05:18:28", "text": "我去了"}, {"type": "subtitle", "time": 19111.11, "timestamp": "05:18:31", "text": "我睡着了，然后我睡了大概多久。"}, {"type": "subtitle", "time": 19113.35, "timestamp": "05:18:33", "text": "直到5点。"}, {"type": "subtitle", "time": 19116.788, "timestamp": "05:18:36", "text": "我下午5点回来了。呃"}, {"type": "subtitle", "time": 19120.83, "timestamp": "05:18:40", "text": "持续了两个一小时或两个一小时"}, {"type": "subtitle", "time": 19124.07, "timestamp": "05:18:44", "text": "达到上限后，我又休息了一段时间。"}, {"type": "subtitle", "time": 19126.39, "timestamp": "05:18:46", "text": "这就是战争的全部内容。"}, {"type": "subtitle", "time": 19130.15, "timestamp": "05:18:50", "text": "时间仿佛以某种方式流逝，整天都是如此。"}, {"type": "subtitle", "time": 19133.27, "timestamp": "05:18:53", "text": "从某种意义上说，只需要2个小时。你敢相信吗？"}, {"type": "subtitle", "time": 19138.628, "timestamp": "05:18:58", "text": "早晨第一部分的直播在某种程度上是这样的"}]
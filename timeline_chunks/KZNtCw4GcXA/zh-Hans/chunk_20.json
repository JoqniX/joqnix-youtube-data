[{"type": "subtitle", "time": 1200.789, "timestamp": "00:20:00", "text": "是的，他们有很多类别。"}, {"type": "subtitle", "time": 1206.95, "timestamp": "00:20:06", "text": "好的，我想我找对地方了。"}, {"type": "subtitle", "time": 1211.87, "timestamp": "00:20:11", "text": "标准。只是我身处“我是”​​的状态中。"}, {"type": "subtitle", "time": 1216.789, "timestamp": "00:20:16", "text": "我觉得我应该没事。比利比利"}, {"type": "subtitle", "time": 1220.029, "timestamp": "00:20:20", "text": "韩元。我希望比利比利没事。"}, {"type": "subtitle", "time": 1223.549, "timestamp": "00:20:23", "text": "罚款"}, {"type": "subtitle", "time": 1227.909, "timestamp": "00:20:27", "text": "嗯……它叫什么？"}, {"type": "subtitle", "time": 1231.35, "timestamp": "00:20:31", "text": "我希望你对这个没意见。"}, {"type": "subtitle", "time": 1233.87, "timestamp": "00:20:33", "text": "英语外语"}, {"type": "subtitle", "time": 1236.39, "timestamp": "00:20:36", "text": "不是中国的Valerant I"}, {"type": "subtitle", "time": 1237.99, "timestamp": "00:20:37", "text": "我没有我想要的中国版Valerant。"}, {"type": "subtitle", "time": 1241.11, "timestamp": "00:20:41", "text": "玩中国瓦莱兰特但匹配"}, {"type": "subtitle", "time": 1252.59, "timestamp": "00:20:52", "text": "真糟糕"}]
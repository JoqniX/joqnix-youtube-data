[{"type": "subtitle", "time": 2112.23, "timestamp": "00:35:12", "text": "发送。我想是说到她的右耳，但是"}, {"type": "subtitle", "time": 2153.27, "timestamp": "00:35:53", "text": "我看到了他的脸，然后我就死了。我和他都死了"}, {"type": "subtitle", "time": 2157.31, "timestamp": "00:35:57", "text": "一起。我们一起死去"}, {"type": "subtitle", "time": 2159.55, "timestamp": "00:35:59", "text": "一。"}]
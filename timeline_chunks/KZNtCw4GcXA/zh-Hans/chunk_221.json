[{"type": "subtitle", "time": 13261.95, "timestamp": "03:41:01", "text": "我心中的天体"}, {"type": "subtitle", "time": 13266.389, "timestamp": "03:41:06", "text": "我用手机，因为我的耳机坏了。充能神"}, {"type": "subtitle", "time": 13270.07, "timestamp": "03:41:10", "text": "零。我一直开着免提，呃……"}, {"type": "subtitle", "time": 13274.07, "timestamp": "03:41:14", "text": "就像我听他们演奏一样。"}, {"type": "subtitle", "time": 13277.67, "timestamp": "03:41:17", "text": "就像玩双人模式和做幽灵任务一样"}, {"type": "subtitle", "time": 13279.83, "timestamp": "03:41:19", "text": "寄送物品。然后我就想，等等，为什么？"}, {"type": "subtitle", "time": 13281.87, "timestamp": "03:41:21", "text": "没有声音吗？发生了什么？"}, {"type": "subtitle", "time": 13285.51, "timestamp": "03:41:25", "text": "等待。然后我检查了一下，嗯，感觉我"}, {"type": "subtitle", "time": 13287.99, "timestamp": "03:41:27", "text": "认为比分应用程序崩溃了或"}, {"type": "subtitle", "time": 13289.19, "timestamp": "03:41:29", "text": "某物。我不知道为什么。那是"}, {"type": "subtitle", "time": 13291.07, "timestamp": "03:41:31", "text": "诡异的。"}, {"type": "subtitle", "time": 13295.03, "timestamp": "03:41:35", "text": "然后我就会向右转。"}, {"type": "subtitle", "time": 13298.389, "timestamp": "03:41:38", "text": "我看向我的显示器，然后我看到了……"}, {"type": "subtitle", "time": 13301.11, "timestamp": "03:41:41", "text": "屏幕上会显示YouTube视频。我当时就想，"}, {"type": "subtitle", "time": 13304.99, "timestamp": "03:41:44", "text": "“嗯？等等，它回来了吗？它终于回来了吗？”"}, {"type": "subtitle", "time": 13307.07, "timestamp": "03:41:47", "text": "回去？还有"}, {"type": "subtitle", "time": 13311.11, "timestamp": "03:41:51", "text": "所以我才来到这里。我真的连接上了"}, {"type": "subtitle", "time": 13313.349, "timestamp": "03:41:53", "text": "与 Dash God 连接，就像我没有"}, {"type": "subtitle", "time": 13316.389, "timestamp": "03:41:56", "text": "你们应该都听说过V吧？"}]
[{"type": "subtitle", "time": 4022.87, "timestamp": "01:07:02", "text": "换边站。赛点。必须"}, {"type": "subtitle", "time": 4026.23, "timestamp": "01:07:06", "text": "现在就打碎片。没错，我要比别人杀得更快。"}, {"type": "subtitle", "time": 4068.95, "timestamp": "01:07:48", "text": "仍在视线范围内。小心。"}, {"type": "subtitle", "time": 4077.51, "timestamp": "01:07:57", "text": "多个敌人。一个"}]
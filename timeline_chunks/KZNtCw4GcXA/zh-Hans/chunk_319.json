[{"type": "subtitle", "time": 19141.67, "timestamp": "05:19:01", "text": "我出现了两个小时，除了所有……"}, {"type": "subtitle", "time": 19143.868, "timestamp": "05:19:03", "text": "其余的人都是"}, {"type": "subtitle", "time": 19146.948, "timestamp": "05:19:06", "text": "警告：这就是我感到内疚的原因，因为我"}, {"type": "subtitle", "time": 19148.27, "timestamp": "05:19:08", "text": "身体"}, {"type": "subtitle", "time": 19153.15, "timestamp": "05:19:13", "text": "不太适应"}, {"type": "subtitle", "time": 19157.948, "timestamp": "05:19:17", "text": "嗯，所有的一切。你好，CC。欢迎来到"}, {"type": "subtitle", "time": 19161.47, "timestamp": "05:19:21", "text": "溪流。嗯，明天我就会拿到它们了。"}, {"type": "subtitle", "time": 19185.91, "timestamp": "05:19:45", "text": "晚上。明天我将有"}, {"type": "subtitle", "time": 19188.31, "timestamp": "05:19:48", "text": "专业英语六级。哦，你的"}]
[{"type": "subtitle", "time": 12842.309, "timestamp": "03:34:02", "text": "1,000 微伏秒。哇，最低比特率"}, {"type": "subtitle", "time": 12844.429, "timestamp": "03:34:04", "text": "是为我准备的。"}, {"type": "subtitle", "time": 12847.59, "timestamp": "03:34:07", "text": "好的。我终于可以说话了。我希望我是"}, {"type": "subtitle", "time": 12850.87, "timestamp": "03:34:10", "text": "可听见的。我真的"}, {"type": "subtitle", "time": 12854.95, "timestamp": "03:34:14", "text": "呃，所以，呃，对于那些来这里的人来说……"}, {"type": "subtitle", "time": 12862.15, "timestamp": "03:34:22", "text": "所以我不知道发生了什么。我的"}, {"type": "subtitle", "time": 12865.75, "timestamp": "03:34:25", "text": "互联网已死，可以说浏览器"}, {"type": "subtitle", "time": 12867.67, "timestamp": "03:34:27", "text": "一切都显示绿灯，就像……"}, {"type": "subtitle", "time": 12871.429, "timestamp": "03:34:31", "text": "就好像它运行正常一样。"}, {"type": "subtitle", "time": 12874.51, "timestamp": "03:34:34", "text": "没有错误，但没有"}, {"type": "subtitle", "time": 12878.389, "timestamp": "03:34:38", "text": "互联网。我尽力了。我尽力了。"}, {"type": "subtitle", "time": 12880.11, "timestamp": "03:34:40", "text": "很多。我"}, {"type": "subtitle", "time": 12887.07, "timestamp": "03:34:47", "text": "尝试了很多方法。我哭了一个小时"}, {"type": "subtitle", "time": 12891.87, "timestamp": "03:34:51", "text": "直的。我打了我的枕头酱"}, {"type": "subtitle", "time": 12894.79, "timestamp": "03:34:54", "text": "很多，而且我并没有大声尖叫。"}, {"type": "subtitle", "time": 12897.11, "timestamp": "03:34:57", "text": "因为房东在睡觉。我不"}, {"type": "subtitle", "time": 12899.67, "timestamp": "03:34:59", "text": "不想把噪音弄出去"}]
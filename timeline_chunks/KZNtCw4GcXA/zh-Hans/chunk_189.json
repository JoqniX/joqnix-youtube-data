[{"type": "subtitle", "time": 11341.03, "timestamp": "03:09:01", "text": "我懂了。真有趣。"}, {"type": "subtitle", "time": 11343.19, "timestamp": "03:09:03", "text": "是的，我知道。这很令人困惑，但是你"}, {"type": "subtitle", "time": 11346.469, "timestamp": "03:09:06", "text": "我知道，就是这样。我们有什么吗？我"}, {"type": "subtitle", "time": 11349.269, "timestamp": "03:09:09", "text": "我不这么认为。哦，等等，等等，等等。"}, {"type": "subtitle", "time": 11351.95, "timestamp": "03:09:11", "text": "它，它在闪烁。请帮忙"}, {"type": "subtitle", "time": 11354.23, "timestamp": "03:09:14", "text": "我。我在这里。我在这里。我在这里。不"}, {"type": "subtitle", "time": 11355.91, "timestamp": "03:09:15", "text": "担心。"}, {"type": "subtitle", "time": 11358.07, "timestamp": "03:09:18", "text": "把这颗愚蠢的宝石扔掉。我死了。我死了。"}, {"type": "subtitle", "time": 11361.349, "timestamp": "03:09:21", "text": "我死了。我死了。我也死了。什么？"}, {"type": "subtitle", "time": 11365.91, "timestamp": "03:09:25", "text": "你死了？是的。为什么？不。"}, {"type": "subtitle", "time": 11367.99, "timestamp": "03:09:27", "text": "伙计们，拜托。你们，你们，你们"}, {"type": "subtitle", "time": 11369.75, "timestamp": "03:09:29", "text": "不可能是认真的吧。稍等片刻。我"}, {"type": "subtitle", "time": 11371.75, "timestamp": "03:09:31", "text": "我会来这里，然后死去。给我一个"}, {"type": "subtitle", "time": 11375.59, "timestamp": "03:09:35", "text": "第二。我必须没事。"}, {"type": "subtitle", "time": 11383.51, "timestamp": "03:09:43", "text": "是的，我们俩都死了。让我们找到哦，"}, {"type": "subtitle", "time": 11385.75, "timestamp": "03:09:45", "text": "你看看那个？我们的身体。"}, {"type": "subtitle", "time": 11388.87, "timestamp": "03:09:48", "text": "是的。哦。总之，我就把它放在这里吧。"}, {"type": "subtitle", "time": 11392.75, "timestamp": "03:09:52", "text": "呃，还有呃，参见"}, {"type": "subtitle", "time": 11395.51, "timestamp": "03:09:55", "text": "某物。呃，我什么都看不见。"}, {"type": "subtitle", "time": 11398.07, "timestamp": "03:09:58", "text": "拉屎。手电筒在哪儿？"}]
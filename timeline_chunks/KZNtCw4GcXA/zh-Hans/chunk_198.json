[{"type": "subtitle", "time": 11880.95, "timestamp": "03:18:00", "text": "你好，鬼魂。我只是看看。我只是"}, {"type": "subtitle", "time": 11884.71, "timestamp": "03:18:04", "text": "我，我只想，我只想那该死的"}, {"type": "subtitle", "time": 11887.75, "timestamp": "03:18:07", "text": "比如紫外线之类的东西。快点。我接受了"}, {"type": "subtitle", "time": 11895.19, "timestamp": "03:18:15", "text": "你好，艾普丽尔。你想跟我谈谈吗？"}, {"type": "subtitle", "time": 11897.67, "timestamp": "03:18:17", "text": "我一个人在这里。"}, {"type": "subtitle", "time": 11899.67, "timestamp": "03:18:19", "text": "别害羞。我害怕跟人说话"}, {"type": "subtitle", "time": 11901.91, "timestamp": "03:18:21", "text": "鬼魂。"}, {"type": "subtitle", "time": 11903.59, "timestamp": "03:18:23", "text": "我认为如果你真的想的话，你需要这样做。"}, {"type": "subtitle", "time": 11906.309, "timestamp": "03:18:26", "text": "跟鬼魂说话，拿走我的收音机。哦，"}, {"type": "subtitle", "time": 11909.349, "timestamp": "03:18:29", "text": "她关了灯。"}, {"type": "subtitle", "time": 11912.55, "timestamp": "03:18:32", "text": "跟我说话。哦，是的。你可以喜欢你"}, {"type": "subtitle", "time": 11914.469, "timestamp": "03:18:34", "text": "如果你想的话，可以和她聊聊，但是"}, {"type": "subtitle", "time": 11917.75, "timestamp": "03:18:37", "text": "你需要收音机。"}, {"type": "subtitle", "time": 11920.63, "timestamp": "03:18:40", "text": "我正在获得"}, {"type": "subtitle", "time": 11927.03, "timestamp": "03:18:47", "text": "好吧，我死了。"}, {"type": "subtitle", "time": 11929.59, "timestamp": "03:18:49", "text": "糟糕。她真的把它改成了"}, {"type": "subtitle", "time": 11931.429, "timestamp": "03:18:51", "text": "我。工作方面，别担心。我真的做到了"}, {"type": "subtitle", "time": 11936.11, "timestamp": "03:18:56", "text": "专为你准备的。快点。什么？"}, {"type": "subtitle", "time": 11939.67, "timestamp": "03:18:59", "text": "哦，乔尔，你也死了吗？不，我是"}]
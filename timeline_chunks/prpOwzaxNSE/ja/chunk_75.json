[{"type": "subtitle", "time": 4500.414, "timestamp": "01:15:00", "text": "書類？いいえ、"}, {"type": "subtitle", "time": 4501.712, "timestamp": "01:15:01", "text": "書く...どうやって書くの？"}, {"type": "subtitle", "time": 4503.046, "timestamp": "01:15:03", "text": "何でもいいから文書"}, {"type": "subtitle", "time": 4504.236, "timestamp": "01:15:04", "text": "読書用、"}, {"type": "subtitle", "time": 4507.899, "timestamp": "01:15:07", "text": "質問...これらはどこにあるのでしょうか"}, {"type": "subtitle", "time": 4508.706, "timestamp": "01:15:08", "text": "質問は以下のとおりです。"}, {"type": "subtitle", "time": 4509.513, "timestamp": "01:15:09", "text": "混乱して"}, {"type": "subtitle", "time": 4511.099, "timestamp": "01:15:11", "text": "歪。あなた"}, {"type": "subtitle", "time": 4512.445, "timestamp": "01:15:12", "text": "こうあるべきだ… えっと、彼らは…彼らはそういう感じなんです"}, {"type": "subtitle", "time": 4513.657, "timestamp": "01:15:13", "text": "えっと、彼らは…彼らはそういう感じなんです この点に関しては賢明だ。あなた"}, {"type": "subtitle", "time": 4515.472, "timestamp": "01:15:15", "text": "この点に関しては賢明だ。あなた 必要、はい、"}, {"type": "subtitle", "time": 4516.304, "timestamp": "01:15:16", "text": "必要、はい、 正しいものを選びなさい"}, {"type": "subtitle", "time": 4517.455, "timestamp": "01:15:17", "text": "正しいものを選びなさい バージョン。私は落ち込んでいます。"}, {"type": "subtitle", "time": 4519.666, "timestamp": "01:15:19", "text": "バージョン。私は落ち込んでいます。 教育を通じて"}, {"type": "subtitle", "time": 4520.438, "timestamp": "01:15:20", "text": "教育を通じて 英語で"}, {"type": "subtitle", "time": 4521.628, "timestamp": "01:15:21", "text": "英語で 日本。私たちほとんど全員"}, {"type": "subtitle", "time": 4522.794, "timestamp": "01:15:22", "text": "日本。私たちほとんど全員 私たちは読むことができ、"}, {"type": "subtitle", "time": 4523.667, "timestamp": "01:15:23", "text": "私たちは読むことができ、 英語で書いてください。"}, {"type": "subtitle", "time": 4524.709, "timestamp": "01:15:24", "text": "英語で書いてください。 でも話すのは難しい"}, {"type": "subtitle", "time": 4525.807, "timestamp": "01:15:25", "text": "でも話すのは難しい そして聞いてください、なぜなら私たちは"}, {"type": "subtitle", "time": 4526.821, "timestamp": "01:15:26", "text": "そして聞いてください、なぜなら私たちは 教育が不十分"}, {"type": "subtitle", "time": 4527.835, "timestamp": "01:15:27", "text": "教育が不十分 このために。私たちにとって"}, {"type": "subtitle", "time": 4528.679, "timestamp": "01:15:28", "text": "このために。私たちにとって これは変更する必要がある。"}, {"type": "subtitle", "time": 4542.975, "timestamp": "01:15:42", "text": "それで日本人は、えーと、"}, {"type": "subtitle", "time": 4543.746, "timestamp": "01:15:43", "text": "彼らが言う"}, {"type": "subtitle", "time": 4544.832, "timestamp": "01:15:44", "text": "英語で、はい"}, {"type": "subtitle", "time": 4546.164, "timestamp": "01:15:46", "text": "聞くのは面白くない"}, {"type": "subtitle", "time": 4547.075, "timestamp": "01:15:47", "text": "彼らは話す"}, {"type": "subtitle", "time": 4548.022, "timestamp": "01:15:48", "text": "英語で、"}, {"type": "subtitle", "time": 4549.108, "timestamp": "01:15:49", "text": "アクセントとその他すべて"}, {"type": "subtitle", "time": 4557.926, "timestamp": "01:15:57", "text": "他の人へ。うーん、トマト"}]
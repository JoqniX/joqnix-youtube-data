[{"type": "subtitle", "time": 1020.222, "timestamp": "00:17:00", "text": "別の突然"}, {"type": "subtitle", "time": 1025.21, "timestamp": "00:17:05", "text": "変更しました。ええと、そして"}, {"type": "subtitle", "time": 1026.398, "timestamp": "00:17:06", "text": "私にとっては素晴らしい経験でした。"}, {"type": "subtitle", "time": 1027.255, "timestamp": "00:17:07", "text": "私がショックを受けたとき"}, {"type": "subtitle", "time": 1028.476, "timestamp": "00:17:08", "text": "彼らは、これは"}, {"type": "chat", "time": 1032.097, "timestamp": "00:17:12", "author": "@MikazukiYure", "avatar": "https://yt4.ggpht.com/uuFSD7qVrZy0JUWrBRfSfEKIQpib7_2xP24Yiu1ND1Mq6uhaYIHDnA5EiGz_o33FUhHYvbCT9g=s64-c-k-c0x00ffffff-no-rj", "message": "Hi hi~"}, {"type": "chat", "time": 1032.541, "timestamp": "00:17:12", "author": "@astravt", "avatar": "https://yt4.ggpht.com/MdOwC7qdh0gmlabcCYgLQ5BOZxo7CGLbc14xFv1rO9eQ745gkga99YKsszwMjcyNnEBittX8WA=s64-c-k-c0x00ffffff-no-rj", "message": "Can u grant me a wish?"}, {"type": "subtitle", "time": 1032.733, "timestamp": "00:17:12", "text": "起こるだろう。まあ、だから私は"}, {"type": "subtitle", "time": 1036.641, "timestamp": "00:17:16", "text": "心の中で思った。「うわあ、痛いな。」"}, {"type": "subtitle", "time": 1039.727, "timestamp": "00:17:19", "text": "これは本当に…これは私です"}, {"type": "subtitle", "time": 1040.887, "timestamp": "00:17:20", "text": "それは本当に私を打ちのめしたし、私は"}, {"type": "subtitle", "time": 1042.085, "timestamp": "00:17:22", "text": "考えた：「よし、"}, {"type": "subtitle", "time": 1050.463, "timestamp": "00:17:30", "text": "そうなら、私は"}, {"type": "subtitle", "time": 1051.314, "timestamp": "00:17:31", "text": "えっと、"}, {"type": "subtitle", "time": 1052.647, "timestamp": "00:17:32", "text": "諦めるために、なぜなら"}, {"type": "subtitle", "time": 1054.0529999999999, "timestamp": "00:17:34", "text": "この作品は、ええと、"}, {"type": "subtitle", "time": 1055.423, "timestamp": "00:17:35", "text": "私とアーティストは、えーと"}, {"type": "subtitle", "time": 1056.459, "timestamp": "00:17:36", "text": "大きく貢献した"}, {"type": "subtitle", "time": 1057.681, "timestamp": "00:17:37", "text": "努力と時間"}, {"type": "subtitle", "time": 1059.014, "timestamp": "00:17:39", "text": "私のアイデアを実行するために"}, {"type": "subtitle", "time": 1060.457, "timestamp": "00:17:40", "text": "願いを現実にする"}, {"type": "subtitle", "time": 1061.938, "timestamp": "00:17:41", "text": "ショー、そしてそれが多くの"}, {"type": "subtitle", "time": 1069.805, "timestamp": "00:17:49", "text": "それは私にとって意味のあることだった。それで"}, {"type": "subtitle", "time": 1071.126, "timestamp": "00:17:51", "text": "私は「よし、私は"}, {"type": "subtitle", "time": 1072.307, "timestamp": "00:17:52", "text": "私はこれを強制することはできません。"}, {"type": "subtitle", "time": 1073.6970000000001, "timestamp": "00:17:53", "text": "モデル、えーと、忘れてください、なぜなら"}, {"type": "subtitle", "time": 1074.809, "timestamp": "00:17:54", "text": "それが必要になるだろう。"}, {"type": "subtitle", "time": 1075.6779999999999, "timestamp": "00:17:55", "text": "永遠、だから"}, {"type": "subtitle", "time": 1076.859, "timestamp": "00:17:56", "text": "デビューする場合"}, {"type": "subtitle", "time": 1078.11, "timestamp": "00:17:58", "text": "私は去る。"}]
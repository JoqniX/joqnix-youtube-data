[{"type": "subtitle", "time": 6253.066, "timestamp": "01:44:13", "text": "良い。まだ質問がありますか？"}, {"type": "subtitle", "time": 6254.373, "timestamp": "01:44:14", "text": "さあ行こう、みんな。"}, {"type": "subtitle", "time": 6255.68, "timestamp": "01:44:15", "text": "完了する。これは"}, {"type": "subtitle", "time": 6257.072, "timestamp": "01:44:17", "text": "1つ、私は4つ持っています"}, {"type": "subtitle", "time": 6266.833, "timestamp": "01:44:26", "text": "分。ご挨拶申し上げます。そしてさらに"}, {"type": "subtitle", "time": 6268.058, "timestamp": "01:44:28", "text": "天王星の質問、"}, {"type": "subtitle", "time": 6269.385, "timestamp": "01:44:29", "text": "先ほど回答したとおり、"}, {"type": "subtitle", "time": 6270.44, "timestamp": "01:44:30", "text": "私たちは"}, {"type": "subtitle", "time": 6273.271, "timestamp": "01:44:33", "text": "音楽コンテンツ。えっと、"}, {"type": "subtitle", "time": 6274.29, "timestamp": "01:44:34", "text": "もっと、もっと"}, {"type": "subtitle", "time": 6275.61, "timestamp": "01:44:35", "text": "ジョーのプレゼンテーションは"}, {"type": "subtitle", "time": 6277.12, "timestamp": "01:44:37", "text": "できるだけ早く発表します"}, {"type": "subtitle", "time": 6279.602, "timestamp": "01:44:39", "text": "時々。すぐには無理だろう"}, {"type": "subtitle", "time": 6280.082, "timestamp": "01:44:40", "text": "時々"}, {"type": "subtitle", "time": 6283.91, "timestamp": "01:44:43", "text": "そして、どのように…そして、他に何ができるだろうか"}, {"type": "subtitle", "time": 6284.737, "timestamp": "01:44:44", "text": "何を期待すべきか？"}, {"type": "subtitle", "time": 6288.86, "timestamp": "01:44:48", "text": "まあ、他にどうしようもないよね？"}, {"type": "subtitle", "time": 6290.957, "timestamp": "01:44:50", "text": "何を期待すべきか？あなたはできる"}, {"type": "subtitle", "time": 6292.251, "timestamp": "01:44:52", "text": "いつも通り"}, {"type": "subtitle", "time": 6293.614, "timestamp": "01:44:53", "text": "ゲーム配信、すべて"}, {"type": "subtitle", "time": 6294.261, "timestamp": "01:44:54", "text": "これらのもの。"}, {"type": "subtitle", "time": 6296.585, "timestamp": "01:44:56", "text": "ご挨拶申し上げます。そしてそうではない"}, {"type": "subtitle", "time": 6297.975, "timestamp": "01:44:57", "text": "注意してください"}, {"type": "subtitle", "time": 6298.982, "timestamp": "01:44:58", "text": "誰かの声が聞こえますか？"}, {"type": "subtitle", "time": 6299.921, "timestamp": "01:44:59", "text": "私のもう一つ"}]
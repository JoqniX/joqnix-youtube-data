[{"type": "subtitle", "time": 1743.844, "timestamp": "00:29:03", "text": "何年も。それで、それで、 この新しいアスリートと"}, {"type": "subtitle", "time": 1745.259, "timestamp": "00:29:05", "text": "この新しいアスリートと この新たな始まり"}, {"type": "subtitle", "time": 1746.426, "timestamp": "00:29:06", "text": "この新たな始まり 旅行、ついに"}, {"type": "subtitle", "time": 1747.7, "timestamp": "00:29:07", "text": "旅行、ついに 私はペンを取って"}, {"type": "subtitle", "time": 1748.903, "timestamp": "00:29:08", "text": "私はペンを取って はい、私は"}, {"type": "subtitle", "time": 1749.858, "timestamp": "00:29:09", "text": "はい、私は これからお見せします"}, {"type": "subtitle", "time": 1751.061, "timestamp": "00:29:11", "text": "これからお見せします あなたの創造性"}, {"type": "subtitle", "time": 1752.37, "timestamp": "00:29:12", "text": "あなたの創造性 私が"}, {"type": "subtitle", "time": 1753.608, "timestamp": "00:29:13", "text": "私が 私は描きたい、そして"}, {"type": "subtitle", "time": 1754.74, "timestamp": "00:29:14", "text": "私は描きたい、そして 君たちにあげるよ、"}, {"type": "subtitle", "time": 1755.837, "timestamp": "00:29:15", "text": "君たちにあげるよ、 それを感じるなど。したがって、"}, {"type": "subtitle", "time": 1766.297, "timestamp": "00:29:26", "text": "えっと、あと、聞こえますか？"}, {"type": "subtitle", "time": 1767.704, "timestamp": "00:29:27", "text": "何か周囲の雑音はありますか？"}, {"type": "subtitle", "time": 1769.28, "timestamp": "00:29:29", "text": "そうでないことを願います。"}, {"type": "subtitle", "time": 1771.909, "timestamp": "00:29:31", "text": "電源を切ったと思う。"}, {"type": "subtitle", "time": 1773.205, "timestamp": "00:29:33", "text": "マイクではないので"}, {"type": "subtitle", "time": 1774.502, "timestamp": "00:29:34", "text": "聞こえるけど、"}, {"type": "subtitle", "time": 1779.362, "timestamp": "00:29:39", "text": "私は知りたいです。主、"}, {"type": "subtitle", "time": 1783.336, "timestamp": "00:29:43", "text": "私がそれをするために。しかし"}, {"type": "subtitle", "time": 1784.557, "timestamp": "00:29:44", "text": "はい、似たような耳鼻咽喉科です。"}, {"type": "subtitle", "time": 1785.917, "timestamp": "00:29:45", "text": "私が何を言ったか覚えておいて"}, {"type": "subtitle", "time": 1787.071, "timestamp": "00:29:47", "text": "以前読んだことがあります、えーと、"}, {"type": "subtitle", "time": 1787.972, "timestamp": "00:29:47", "text": "例えば、"}, {"type": "subtitle", "time": 1789.162, "timestamp": "00:29:49", "text": "デビュースライド。"}, {"type": "subtitle", "time": 1791.019, "timestamp": "00:29:51", "text": "私を想像してみてください…"}, {"type": "subtitle", "time": 1797.911, "timestamp": "00:29:57", "text": "プログター、そう、それだけです"}, {"type": "subtitle", "time": 1798.857, "timestamp": "00:29:58", "text": "明らかになる"}]
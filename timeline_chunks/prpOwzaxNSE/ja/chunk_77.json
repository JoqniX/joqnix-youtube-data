[{"type": "subtitle", "time": 4621.673, "timestamp": "01:17:01", "text": "恥ずかしいほど奇妙だ。はい、"}, {"type": "subtitle", "time": 4622.852, "timestamp": "01:17:02", "text": "胃の音が"}, {"type": "subtitle", "time": 4624.175, "timestamp": "01:17:04", "text": "毎回起こる。"}, {"type": "subtitle", "time": 4628.272, "timestamp": "01:17:08", "text": "それに、もし私が今ここにいたら"}, {"type": "subtitle", "time": 4629.19, "timestamp": "01:17:09", "text": "インドでは、"}, {"type": "subtitle", "time": 4630.312, "timestamp": "01:17:10", "text": "1日に3回餌を与える"}, {"type": "subtitle", "time": 4634.66, "timestamp": "01:17:14", "text": "日。わかりました？まるで"}, {"type": "subtitle", "time": 4636.203, "timestamp": "01:17:16", "text": "500ルピー持っている場合、"}, {"type": "subtitle", "time": 4637.168, "timestamp": "01:17:17", "text": "あなたは生きることができます"}, {"type": "subtitle", "time": 4639.49, "timestamp": "01:17:19", "text": "豪華だね、兄弟。例えば"}, {"type": "subtitle", "time": 4643.805, "timestamp": "01:17:23", "text": "日本、えーと、1000で、"}, {"type": "subtitle", "time": 4645.641, "timestamp": "01:17:25", "text": "購入できますか？来て。"}, {"type": "subtitle", "time": 4646.923, "timestamp": "01:17:26", "text": "考えてみましょう。来て。"}, {"type": "subtitle", "time": 4648.916, "timestamp": "01:17:28", "text": "考えてみましょう。もし"}, {"type": "subtitle", "time": 4650.483, "timestamp": "01:17:30", "text": "今は1000しか持っていません。"}, {"type": "subtitle", "time": 4652.412, "timestamp": "01:17:32", "text": "はい、お腹が空いています。私"}, {"type": "subtitle", "time": 4654.334, "timestamp": "01:17:34", "text": "何も食べなかった。私は何者？"}, {"type": "subtitle", "time": 4656.719, "timestamp": "01:17:36", "text": "私はそうするだろうか？私は行く"}, {"type": "subtitle", "time": 4661.47, "timestamp": "01:17:41", "text": "店。もしそれがミニであれば ショップ、私は"}, {"type": "subtitle", "time": 4662.625, "timestamp": "01:17:42", "text": "ショップ、私は パンを買う"}, {"type": "subtitle", "time": 4663.904, "timestamp": "01:17:43", "text": "パンを買う クリーム100円、えっと、"}, {"type": "subtitle", "time": 4665.512, "timestamp": "01:17:45", "text": "クリーム100円、えっと、 チョコレートが入っていて、えーと"}, {"type": "subtitle", "time": 4667.121, "timestamp": "01:17:47", "text": "チョコレートが入っていて、えーと クリーム、ホイップクリーム"}, {"type": "subtitle", "time": 4668.729, "timestamp": "01:17:48", "text": "クリーム、ホイップクリーム 、そしてそのような"}, {"type": "subtitle", "time": 4670.008, "timestamp": "01:17:50", "text": "、そしてそのような 100円です。私はできる"}, {"type": "subtitle", "time": 4674.382, "timestamp": "01:17:54", "text": "100円です。私はできる これを買ってください。"}, {"type": "subtitle", "time": 4678.089, "timestamp": "01:17:58", "text": "もし私が何か欲しいものがあれば"}, {"type": "subtitle", "time": 4679.349, "timestamp": "01:17:59", "text": "持って来られる、私は"}]
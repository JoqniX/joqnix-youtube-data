[{"type": "subtitle", "time": 903.115, "timestamp": "00:15:03", "text": "ご挨拶申し上げます。えっと、モデル。"}, {"type": "subtitle", "time": 905.887, "timestamp": "00:15:05", "text": "彼女はこれをモデルにしているの？"}, {"type": "subtitle", "time": 908.718, "timestamp": "00:15:08", "text": "あの、リシアさん、いいですか？"}, {"type": "subtitle", "time": 912.907, "timestamp": "00:15:12", "text": "リシアス。ご挨拶申し上げます。良い、"}, {"type": "subtitle", "time": 914.175, "timestamp": "00:15:14", "text": "私から電話します。"}, {"type": "subtitle", "time": 915.574, "timestamp": "00:15:15", "text": "リシア。ありがとうございます。"}, {"type": "subtitle", "time": 916.524, "timestamp": "00:15:16", "text": "私に言った"}, {"type": "subtitle", "time": 917.644, "timestamp": "00:15:17", "text": "正しい発音。"}, {"type": "subtitle", "time": 918.824, "timestamp": "00:15:18", "text": "いらっしゃいませ。"}, {"type": "subtitle", "time": 921.535, "timestamp": "00:15:21", "text": "に戻る"}, {"type": "subtitle", "time": 922.629, "timestamp": "00:15:22", "text": "ケンジー。私にさせて"}, {"type": "subtitle", "time": 923.541, "timestamp": "00:15:23", "text": "あなたの答えを"}, {"type": "subtitle", "time": 924.894, "timestamp": "00:15:24", "text": "質問。良い。同様に"}, {"type": "subtitle", "time": 925.577, "timestamp": "00:15:25", "text": "そのデビュー"}, {"type": "subtitle", "time": 926.487, "timestamp": "00:15:26", "text": "素材"}, {"type": "subtitle", "time": 927.626, "timestamp": "00:15:27", "text": "やったのか、感じたのか"}, {"type": "subtitle", "time": 928.451, "timestamp": "00:15:28", "text": "あなたは、何が欲しかったのですか？"}, {"type": "subtitle", "time": 930.243, "timestamp": "00:15:30", "text": "作る？正直に 私はこれをやりたかった"}, {"type": "subtitle", "time": 931.81, "timestamp": "00:15:31", "text": "私はこれをやりたかった 私がデビューした"}, {"type": "subtitle", "time": 933.336, "timestamp": "00:15:33", "text": "私がデビューした 昨日、アストロ・ジェネシスがデビューした。"}, {"type": "subtitle", "time": 938.154, "timestamp": "00:15:38", "text": "私のが欲しいなら"}, {"type": "subtitle", "time": 941.642, "timestamp": "00:15:41", "text": "正直に言うと、えーと、"}, {"type": "subtitle", "time": 942.927, "timestamp": "00:15:42", "text": "私のが欲しいなら"}, {"type": "subtitle", "time": 944.211, "timestamp": "00:15:44", "text": "正直に言うと、"}, {"type": "subtitle", "time": 950.597, "timestamp": "00:15:50", "text": "教えてあげましょう。ええと、以上です。"}, {"type": "subtitle", "time": 952.262, "timestamp": "00:15:52", "text": "デビュー作となるには"}, {"type": "subtitle", "time": 953.881, "timestamp": "00:15:53", "text": "過去に起こったこと"}, {"type": "subtitle", "time": 959.5360000000001, "timestamp": "00:15:59", "text": "2025年。または"}]
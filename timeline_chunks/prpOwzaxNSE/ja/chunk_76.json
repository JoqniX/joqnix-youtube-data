[{"type": "subtitle", "time": 4563.197, "timestamp": "01:16:03", "text": "マカダミアアイスクリーム、こちらです"}, {"type": "subtitle", "time": 4569.423, "timestamp": "01:16:09", "text": "はい。こんにちは、Shiさん。"}, {"type": "subtitle", "time": 4570.634, "timestamp": "01:16:10", "text": "いらっしゃいませ。"}, {"type": "subtitle", "time": 4574.707, "timestamp": "01:16:14", "text": "ご挨拶申し上げます。ご挨拶申し上げます。"}, {"type": "subtitle", "time": 4576.442, "timestamp": "01:16:16", "text": "ご挨拶申し上げます。敬具"}, {"type": "subtitle", "time": 4579.825, "timestamp": "01:16:19", "text": "お願いします。支払わないでください。"}, {"type": "subtitle", "time": 4581.36, "timestamp": "01:16:21", "text": "これに注目してください。私はただ"}, {"type": "subtitle", "time": 4584.515, "timestamp": "01:16:24", "text": "水を飲んだ。また、"}, {"type": "subtitle", "time": 4585.977, "timestamp": "01:16:25", "text": "ただ欲しいもの"}, {"type": "subtitle", "time": 4587.219, "timestamp": "01:16:27", "text": "いつから私が"}, {"type": "subtitle", "time": 4588.645, "timestamp": "01:16:28", "text": "日本に来たのは"}, {"type": "subtitle", "time": 4589.997, "timestamp": "01:16:29", "text": "そしてアニメではこれを見た"}, {"type": "subtitle", "time": 4591.02, "timestamp": "01:16:31", "text": "アニメだけ、"}, {"type": "subtitle", "time": 4592.481, "timestamp": "01:16:32", "text": "例えば、"}, {"type": "subtitle", "time": 4593.724, "timestamp": "01:16:33", "text": "お腹など、奇妙"}, {"type": "subtitle", "time": 4594.747, "timestamp": "01:16:34", "text": "サウンドなど"}, {"type": "subtitle", "time": 4600.213, "timestamp": "01:16:40", "text": "どこからともなく現れた。私はできる"}, {"type": "subtitle", "time": 4603.401, "timestamp": "01:16:43", "text": "私が言うには"}, {"type": "subtitle", "time": 4608.184, "timestamp": "01:16:48", "text": "与えることを学んだ"}, {"type": "subtitle", "time": 4609.456, "timestamp": "01:16:49", "text": "音によって異なる"}, {"type": "subtitle", "time": 4610.796, "timestamp": "01:16:50", "text": "私がどれだけ"}, {"type": "subtitle", "time": 4613.676, "timestamp": "01:16:53", "text": "お腹が空いた、など。ああ神様"}, {"type": "subtitle", "time": 4616.275, "timestamp": "01:16:56", "text": "私の兄は、その通りだ。"}]
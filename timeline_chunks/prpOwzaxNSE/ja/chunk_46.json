[{"type": "subtitle", "time": 2760.865, "timestamp": "00:46:00", "text": "起源？それは何ですか 私の目には影響がありますか？"}, {"type": "subtitle", "time": 2766.402, "timestamp": "00:46:06", "text": "それだけです。もしあなたが"}, {"type": "subtitle", "time": 2767.706, "timestamp": "00:46:07", "text": "質問があれば"}, {"type": "subtitle", "time": 2769.047, "timestamp": "00:46:09", "text": "デザインの選択、ええと、"}, {"type": "subtitle", "time": 2770.499, "timestamp": "00:46:10", "text": "デザイン、物語、方法"}, {"type": "subtitle", "time": 2771.617, "timestamp": "00:46:11", "text": "遠慮しないで"}, {"type": "subtitle", "time": 2774.847, "timestamp": "00:46:14", "text": "聞く。私はできる"}, {"type": "subtitle", "time": 2776.227, "timestamp": "00:46:16", "text": "理由を教えてあげよう、"}, {"type": "subtitle", "time": 2783.895, "timestamp": "00:46:23", "text": "なぜ。だから、本当にそうなんだ"}, {"type": "subtitle", "time": 2784.921, "timestamp": "00:46:24", "text": "良いモデル"}, {"type": "subtitle", "time": 2789.98, "timestamp": "00:46:29", "text": "画面。私の"}, {"type": "subtitle", "time": 2791.459, "timestamp": "00:46:31", "text": "その衣装は宇宙を映し出している。"}, {"type": "subtitle", "time": 2797.624, "timestamp": "00:46:37", "text": "銀河。えっと、それともう一つ"}, {"type": "subtitle", "time": 2798.928, "timestamp": "00:46:38", "text": "私が修正した"}, {"type": "subtitle", "time": 2800.385, "timestamp": "00:46:40", "text": "ただ、やってみたいだけなんです。"}, {"type": "subtitle", "time": 2804.653, "timestamp": "00:46:44", "text": "えっと、私は"}, {"type": "subtitle", "time": 2806.419, "timestamp": "00:46:46", "text": "1秒。 1つ"}, {"type": "subtitle", "time": 2807.619, "timestamp": "00:46:47", "text": "私が修正した"}, {"type": "subtitle", "time": 2809.386, "timestamp": "00:46:49", "text": "やりたいです。ああ、そうだね。私"}, {"type": "subtitle", "time": 2810.855, "timestamp": "00:46:50", "text": "私は指輪をしています。はい。"}, {"type": "subtitle", "time": 2813.868, "timestamp": "00:46:53", "text": "はい。ごめん。私はただ"}, {"type": "subtitle", "time": 2815.292, "timestamp": "00:46:55", "text": "言いたかったのは、"}, {"type": "subtitle", "time": 2816.641, "timestamp": "00:46:56", "text": "昨日も言いましたが、"}, {"type": "subtitle", "time": 2818.102, "timestamp": "00:46:58", "text": "私は指輪を持っています"}]
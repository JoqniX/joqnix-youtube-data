[{"type": "subtitle", "time": 4381.364, "timestamp": "01:13:01", "text": "タスクか何か 。なぜなら、えーと、"}, {"type": "subtitle", "time": 4392.127, "timestamp": "01:13:12", "text": "。なぜなら、えーと、 宿題をしている"}, {"type": "subtitle", "time": 4393.107, "timestamp": "01:13:13", "text": "宿題をしている 電車からのタスクまたは"}, {"type": "subtitle", "time": 4394.348, "timestamp": "01:13:14", "text": "電車からのタスクまたは そんな感じ。わからない。私"}, {"type": "subtitle", "time": 4396.577, "timestamp": "01:13:16", "text": "そんな感じ。わからない。私 何人かの人が"}, {"type": "subtitle", "time": 4398.009, "timestamp": "01:13:18", "text": "何人かの人が 彼らはiPadを取り出した。私"}, {"type": "subtitle", "time": 4399.155, "timestamp": "01:13:19", "text": "彼らはiPadを取り出した。私 考え：「うわあ、その通りだ」"}, {"type": "subtitle", "time": 4400.602, "timestamp": "01:13:20", "text": "考え：「うわあ、その通りだ」 クール。インド。インドで"}, {"type": "subtitle", "time": 4403.884, "timestamp": "01:13:23", "text": "クール。インド。インドで もしあなたが持ってくるなら"}, {"type": "subtitle", "time": 4408.149, "timestamp": "01:13:28", "text": "もしあなたが持ってくるなら 授業中に携帯電話を使う、"}, {"type": "subtitle", "time": 4409.38, "timestamp": "01:13:29", "text": "授業中に携帯電話を使う、 兄弟、君の両親"}, {"type": "subtitle", "time": 4410.511, "timestamp": "01:13:30", "text": "兄弟、君の両親 電話がかかってくるでしょう、あなたの"}, {"type": "subtitle", "time": 4411.776, "timestamp": "01:13:31", "text": "電話がかかってくるでしょう、あなたの 監督"}, {"type": "subtitle", "time": 4412.641, "timestamp": "01:13:32", "text": "監督 捕まえるだろう。あなたはそうしなければならない"}, {"type": "subtitle", "time": 4414.017, "timestamp": "01:13:34", "text": "捕まえるだろう。あなたはそうしなければならない 所長室にて。"}, {"type": "subtitle", "time": 4430.127, "timestamp": "01:13:50", "text": "そこはとても厳しい場所です。そして何が"}, {"type": "subtitle", "time": 4433.357, "timestamp": "01:13:53", "text": "まだそこにいるの？はい、ルール"}, {"type": "subtitle", "time": 4434.77, "timestamp": "01:13:54", "text": "自転車に関して"}, {"type": "subtitle", "time": 4437.772, "timestamp": "01:13:57", "text": "私が思うこと"}, {"type": "subtitle", "time": 4438.872, "timestamp": "01:13:58", "text": "興味深いし、本当に"}]
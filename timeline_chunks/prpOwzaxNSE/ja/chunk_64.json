[{"type": "subtitle", "time": 3840.453, "timestamp": "01:04:00", "text": "実際の証拠はありますか？ そんな感じですよね？そして"}, {"type": "subtitle", "time": 3847.864, "timestamp": "01:04:07", "text": "はい、鉄道"}, {"type": "subtitle", "time": 3849.068, "timestamp": "01:04:09", "text": "システムとその他すべて"}, {"type": "subtitle", "time": 3850.206, "timestamp": "01:04:10", "text": "より難しいが、"}, {"type": "subtitle", "time": 3851.276, "timestamp": "01:04:11", "text": "行けば行くほど"}, {"type": "subtitle", "time": 3852.58, "timestamp": "01:04:12", "text": "列車、特に"}, {"type": "subtitle", "time": 3857.074, "timestamp": "01:04:17", "text": "すぐに慣れますよ。そして"}, {"type": "subtitle", "time": 3862.271, "timestamp": "01:04:22", "text": "一つは食べ物だ。日本語"}, {"type": "subtitle", "time": 3863.418, "timestamp": "01:04:23", "text": "料理は美味しくて、何もかも最高です。"}, {"type": "subtitle", "time": 3864.708, "timestamp": "01:04:24", "text": "こんな感じだけど、君が恋しいよ"}, {"type": "subtitle", "time": 3865.82, "timestamp": "01:04:25", "text": "インド料理。"}, {"type": "subtitle", "time": 3871.436, "timestamp": "01:04:31", "text": "今日私は、えーと、"}, {"type": "subtitle", "time": 3872.737, "timestamp": "01:04:32", "text": "マギー、30歳のマギー"}, {"type": "subtitle", "time": 3873.996, "timestamp": "01:04:33", "text": "ルピーは"}, {"type": "subtitle", "time": 3875.632, "timestamp": "01:04:35", "text": "インドから入手する。ここ"}, {"type": "subtitle", "time": 3877.227, "timestamp": "01:04:37", "text": "230円かかります。"}, {"type": "subtitle", "time": 3878.738, "timestamp": "01:04:38", "text": "そんな感じだったんだけど、"}, {"type": "subtitle", "time": 3883.666, "timestamp": "01:04:43", "text": "とても美味しいです。同様に"}, {"type": "subtitle", "time": 3884.986, "timestamp": "01:04:44", "text": "これらすべてが4時間以内に"}, {"type": "subtitle", "time": 3890.195, "timestamp": "01:04:50", "text": "数ヶ月間、えーと、私は"}, {"type": "subtitle", "time": 3891.534, "timestamp": "01:04:51", "text": "そして私の部屋は"}, {"type": "subtitle", "time": 3892.539, "timestamp": "01:04:52", "text": "日本語のように"}, {"type": "subtitle", "time": 3893.729, "timestamp": "01:04:53", "text": "麺、ラーメン、そして"}, {"type": "subtitle", "time": 3895.18, "timestamp": "01:04:55", "text": "その他、カップ麺"}, {"type": "subtitle", "time": 3897.908, "timestamp": "01:04:57", "text": "等々。それは難しかった。 。そして最後に、私は食事をした。"}]
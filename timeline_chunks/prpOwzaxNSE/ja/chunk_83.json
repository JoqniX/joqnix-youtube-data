[{"type": "subtitle", "time": 4986.633, "timestamp": "01:23:06", "text": "ええと、東京は、"}, {"type": "subtitle", "time": 4987.973, "timestamp": "01:23:07", "text": "私が決して望まない場所"}, {"type": "subtitle", "time": 4989.348, "timestamp": "01:23:09", "text": "生きるために、でも私は"}, {"type": "subtitle", "time": 4990.619, "timestamp": "01:23:10", "text": "おそらくあなたは"}, {"type": "subtitle", "time": 4991.754, "timestamp": "01:23:11", "text": "そこに住むために"}, {"type": "subtitle", "time": 4995.11, "timestamp": "01:23:15", "text": "私の夢を通して"}, {"type": "subtitle", "time": 4998.28, "timestamp": "01:23:18", "text": "将来の抱負。それ、"}, {"type": "subtitle", "time": 4999.238, "timestamp": "01:23:19", "text": "私は何をしたいのか？"}, {"type": "subtitle", "time": 5000.453, "timestamp": "01:23:20", "text": "目指すべきは、"}, {"type": "subtitle", "time": 5001.19, "timestamp": "01:23:21", "text": "東京、そしてこれら"}, {"type": "subtitle", "time": 5002.554, "timestamp": "01:23:22", "text": "ハイテク"}, {"type": "subtitle", "time": 5007.557, "timestamp": "01:23:27", "text": "多くの場所"}, {"type": "subtitle", "time": 5008.688, "timestamp": "01:23:28", "text": "例えば"}, {"type": "subtitle", "time": 5009.819, "timestamp": "01:23:29", "text": "音楽、私たちは"}, {"type": "subtitle", "time": 5011.091, "timestamp": "01:23:31", "text": "さまざまなもの、すべて、すべて"}, {"type": "subtitle", "time": 5012.505, "timestamp": "01:23:32", "text": "東京限定 。なぜ"}, {"type": "subtitle", "time": 5015.599, "timestamp": "01:23:35", "text": "。なぜ 農村地域"}, {"type": "subtitle", "time": 5016.925, "timestamp": "01:23:36", "text": "農村地域 ヴコカなど、"}, {"type": "subtitle", "time": 5018.014, "timestamp": "01:23:38", "text": "ヴコカなど、 名古屋か、それとも他の場所？"}, {"type": "subtitle", "time": 5024.904, "timestamp": "01:23:44", "text": "ひどい話だけど、えっと、"}, {"type": "subtitle", "time": 5026.624, "timestamp": "01:23:46", "text": "レクシー 1. はい、そうです、違います"}, {"type": "subtitle", "time": 5028.496, "timestamp": "01:23:48", "text": "東京に行きたいです。"}, {"type": "subtitle", "time": 5031.154, "timestamp": "01:23:51", "text": "お前。これは痛みだ。私"}, {"type": "subtitle", "time": 5032.472, "timestamp": "01:23:52", "text": "今の状況に満足しています"}, {"type": "subtitle", "time": 5033.875, "timestamp": "01:23:53", "text": "私は今を生きている。あった。"}, {"type": "subtitle", "time": 5035.346, "timestamp": "01:23:55", "text": "広々とした。ミニ- セブンイレブンに立ち寄って、これら全部"}, {"type": "subtitle", "time": 5036.788, "timestamp": "01:23:56", "text": "セブンイレブンに立ち寄って、これら全部 このような店"}, {"type": "subtitle", "time": 5037.801, "timestamp": "01:23:57", "text": "このような店 広々とした。あった。"}, {"type": "subtitle", "time": 5039.003, "timestamp": "01:23:59", "text": "広々とした。あった。 駐車場がたくさんある"}]
[{"type": "subtitle", "time": 601.136, "timestamp": "00:10:01", "text": "未来"}, {"type": "subtitle", "time": 602.137, "timestamp": "00:10:02", "text": "着ているのは、えーと、"}, {"type": "subtitle", "time": 603.677, "timestamp": "00:10:03", "text": "将来の衣装、えーと、"}, {"type": "subtitle", "time": 606.754, "timestamp": "00:10:06", "text": "将来。つまり、"}, {"type": "subtitle", "time": 608.037, "timestamp": "00:10:08", "text": "感じますか？"}, {"type": "subtitle", "time": 613.525, "timestamp": "00:10:13", "text": "どういう意味ですか？"}, {"type": "subtitle", "time": 616.463, "timestamp": "00:10:16", "text": "または私に"}, {"type": "subtitle", "time": 617.652, "timestamp": "00:10:17", "text": "あなたの"}, {"type": "subtitle", "time": 622.289, "timestamp": "00:10:22", "text": "質問 - 「ka」。元気ですか？"}, {"type": "subtitle", "time": 623.639, "timestamp": "00:10:23", "text": "えっと、お元気ですか？"}, {"type": "subtitle", "time": 624.866, "timestamp": "00:10:24", "text": "私だと思いますか？"}, {"type": "subtitle", "time": 629.514, "timestamp": "00:10:29", "text": "サイズは合いますか？これは質問です。"}, {"type": "subtitle", "time": 630.793, "timestamp": "00:10:30", "text": "新型モデルのように"}, {"type": "subtitle", "time": 633.914, "timestamp": "00:10:33", "text": "等？それは何だったのか？"}, {"type": "subtitle", "time": 639.048, "timestamp": "00:10:39", "text": "質問？私は着ています"}, {"type": "subtitle", "time": 640.008, "timestamp": "00:10:40", "text": "心の中で、私はすでに"}, {"type": "subtitle", "time": 640.826, "timestamp": "00:10:40", "text": "私はそれを覚えていた。"}, {"type": "subtitle", "time": 642.177, "timestamp": "00:10:42", "text": "無性的な存在"}, {"type": "subtitle", "time": 648.827, "timestamp": "00:10:48", "text": "キャラクター。はい。はい。"}, {"type": "subtitle", "time": 650.918, "timestamp": "00:10:50", "text": "想像してみてください、ええと、"}, {"type": "subtitle", "time": 653.707, "timestamp": "00:10:53", "text": "レムル・テンペスト。はい。"}, {"type": "subtitle", "time": 655.534, "timestamp": "00:10:55", "text": "もし、もし人々が"}, {"type": "subtitle", "time": 656.807, "timestamp": "00:10:56", "text": "このアニメを見ている"}, {"type": "subtitle", "time": 658.262, "timestamp": "00:10:58", "text": "生きてみればわかるよ 。それで、デザインは"}]
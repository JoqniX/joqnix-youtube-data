[{"type": "subtitle", "time": 1382.138, "timestamp": "00:23:02", "text": "そして私は気づいた、"}, {"type": "subtitle", "time": 1383.582, "timestamp": "00:23:03", "text": "そして私は気づいた"}, {"type": "subtitle", "time": 1389.059, "timestamp": "00:23:09", "text": "まあ、そういうことだ。しかし"}, {"type": "subtitle", "time": 1390.17, "timestamp": "00:23:10", "text": "一番大切なのは私が"}, {"type": "subtitle", "time": 1391.702, "timestamp": "00:23:11", "text": "ついに、3年後 デビューすることができた。私"}, {"type": "subtitle", "time": 1395.152, "timestamp": "00:23:15", "text": "デビューすることができた。私 ずっとこれが欲しかったし、"}, {"type": "subtitle", "time": 1396.409, "timestamp": "00:23:16", "text": "ずっとこれが欲しかったし、 飛び降りた。平"}, {"type": "subtitle", "time": 1398.731, "timestamp": "00:23:18", "text": "飛び降りた。平 もしそうだったら"}, {"type": "chat", "time": 1398.792, "timestamp": "00:23:18", "author": "@MikazukiYure", "avatar": "https://yt4.ggpht.com/uuFSD7qVrZy0JUWrBRfSfEKIQpib7_2xP24Yiu1ND1Mq6uhaYIHDnA5EiGz_o33FUhHYvbCT9g=s64-c-k-c0x00ffffff-no-rj", "message": "did you make a mistake? didn't seem like it"}, {"type": "subtitle", "time": 1399.514, "timestamp": "00:23:19", "text": "もしそうだったら カテゴリー「C」でさえ"}, {"type": "subtitle", "time": 1400.875, "timestamp": "00:23:20", "text": "カテゴリー「C」でさえ もしそうだったら"}, {"type": "subtitle", "time": 1401.658, "timestamp": "00:23:21", "text": "もしそうだったら 即興、"}, {"type": "subtitle", "time": 1405.27, "timestamp": "00:23:25", "text": "半分は"}, {"type": "subtitle", "time": 1409.189, "timestamp": "00:23:29", "text": "即興。ええと、そして"}, {"type": "subtitle", "time": 1410.485, "timestamp": "00:23:30", "text": "時間が少なかった。"}, {"type": "subtitle", "time": 1411.748, "timestamp": "00:23:31", "text": "トレーニングを通じて"}, {"type": "subtitle", "time": 1412.942, "timestamp": "00:23:32", "text": "試験とか色々あって、"}, {"type": "subtitle", "time": 1414.17, "timestamp": "00:23:34", "text": "でも私はとても嬉しいです"}, {"type": "subtitle", "time": 1418.542, "timestamp": "00:23:38", "text": "やったよ。そしてこれ"}, {"type": "subtitle", "time": 1421.018, "timestamp": "00:23:41", "text": "それは重要なことですよね？私"}, {"type": "subtitle", "time": 1422.051, "timestamp": "00:23:42", "text": "できませんでした"}, {"type": "subtitle", "time": 1424.935, "timestamp": "00:23:44", "text": "これは番組の中でのことです。私はできませんでした"}, {"type": "subtitle", "time": 1426.095, "timestamp": "00:23:46", "text": "私は選ぶことができた。"}, {"type": "subtitle", "time": 1427.222, "timestamp": "00:23:47", "text": "しないことに決める"}, {"type": "subtitle", "time": 1428.887, "timestamp": "00:23:48", "text": "これがデビュー作です。できました"}, {"type": "subtitle", "time": 1429.98, "timestamp": "00:23:49", "text": "永遠に決める"}, {"type": "subtitle", "time": 1431.235, "timestamp": "00:23:51", "text": "これを諦める"}, {"type": "subtitle", "time": 1432.361, "timestamp": "00:23:52", "text": "美しいモデル。"}, {"type": "subtitle", "time": 1433.852, "timestamp": "00:23:53", "text": "しかし、私はそれをやらなかった。"}, {"type": "subtitle", "time": 1436.935, "timestamp": "00:23:56", "text": "そしてこれは重要なことだ。それが理由です"}, {"type": "subtitle", "time": 1438.03, "timestamp": "00:23:58", "text": "私はとても嬉しいです"}]
[{"type": "subtitle", "time": 1814.954, "timestamp": "00:30:14", "text": "徐々に。あなた"}, {"type": "subtitle", "time": 1815.869, "timestamp": "00:30:15", "text": "あなたは間違っていましたか？"}, {"type": "subtitle", "time": 1817.292, "timestamp": "00:30:17", "text": "どうやらそうではないようだった。"}, {"type": "subtitle", "time": 1829.039, "timestamp": "00:30:29", "text": "本当に？ありがとう。それから私は"}, {"type": "subtitle", "time": 1833.91, "timestamp": "00:30:33", "text": "おそらく、"}, {"type": "subtitle", "time": 1835.372, "timestamp": "00:30:35", "text": "うまくいったので、"}, {"type": "subtitle", "time": 1836.396, "timestamp": "00:30:36", "text": "これは何と呼ばれていますか？"}, {"type": "subtitle", "time": 1838.874, "timestamp": "00:30:38", "text": "モデル？ああ、よかった。"}, {"type": "subtitle", "time": 1843.863, "timestamp": "00:30:43", "text": "質問。えっと、電話しました"}, {"type": "subtitle", "time": 1845.298, "timestamp": "00:30:45", "text": "これは公式モデルです"}, {"type": "subtitle", "time": 1849.603, "timestamp": "00:30:49", "text": "ジョカナですよね？でも私は"}, {"type": "subtitle", "time": 1855.831, "timestamp": "00:30:55", "text": "これは"}, {"type": "subtitle", "time": 1857.394, "timestamp": "00:30:57", "text": "またデビュータイトルでもある、"}, {"type": "subtitle", "time": 1858.834, "timestamp": "00:30:58", "text": "実際はアストラル・ジェネシス、"}]
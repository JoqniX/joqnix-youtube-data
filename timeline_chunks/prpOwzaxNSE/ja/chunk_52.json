[{"type": "subtitle", "time": 3121.921, "timestamp": "00:52:01", "text": "画像。ああ、 私には無理です。"}, {"type": "subtitle", "time": 3122.594, "timestamp": "00:52:02", "text": "私には無理です。 策定する。"}, {"type": "subtitle", "time": 3137.483, "timestamp": "00:52:17", "text": "待って。私はこれだ。"}, {"type": "subtitle", "time": 3140.1, "timestamp": "00:52:20", "text": "した？ああ、そうだったよ。で"}, {"type": "subtitle", "time": 3145.17, "timestamp": "00:52:25", "text": "我が神よ。それではない。これ。"}, {"type": "subtitle", "time": 3146.72, "timestamp": "00:52:26", "text": "わかりました。まるで"}, {"type": "subtitle", "time": 3147.854, "timestamp": "00:52:27", "text": "真のテンペスト。"}, {"type": "subtitle", "time": 3158.252, "timestamp": "00:52:38", "text": "では、これを想像してみてください。"}, {"type": "subtitle", "time": 3160.24, "timestamp": "00:52:40", "text": "テンペストのように。似たようなものだ。"}, {"type": "subtitle", "time": 3161.921, "timestamp": "00:52:41", "text": "えっと、君"}, {"type": "subtitle", "time": 3163.276, "timestamp": "00:52:43", "text": "専門とする"}, {"type": "subtitle", "time": 3164.429, "timestamp": "00:52:44", "text": "日本語？いいえ、私は"}, {"type": "subtitle", "time": 3165.933, "timestamp": "00:52:45", "text": "言語学の学生なので"}, {"type": "subtitle", "time": 3167.211, "timestamp": "00:52:47", "text": "私は日本語を勉強しています。"}, {"type": "subtitle", "time": 3173.359, "timestamp": "00:52:53", "text": "体調があまり良くないんです。"}]
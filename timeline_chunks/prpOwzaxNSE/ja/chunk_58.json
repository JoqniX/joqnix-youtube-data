[{"type": "subtitle", "time": 3482.939, "timestamp": "00:58:02", "text": "このカテゴリーに属します。ふーむ、"}, {"type": "subtitle", "time": 3484.601, "timestamp": "00:58:04", "text": "とても素敵ですね。"}, {"type": "subtitle", "time": 3489.803, "timestamp": "00:58:09", "text": "ああ、ありがとうございます。もちろん、"}, {"type": "subtitle", "time": 3490.736, "timestamp": "00:58:10", "text": "私が"}, {"type": "subtitle", "time": 3491.92, "timestamp": "00:58:11", "text": "私は使います、私は持っています"}, {"type": "subtitle", "time": 3492.961, "timestamp": "00:58:12", "text": "その歴史と"}, {"type": "subtitle", "time": 3493.751, "timestamp": "00:58:13", "text": "理由"}, {"type": "subtitle", "time": 3495.489, "timestamp": "00:58:15", "text": "存在。はい。もし"}, {"type": "subtitle", "time": 3497.006, "timestamp": "00:58:17", "text": "これは"}, {"type": "subtitle", "time": 3500.022, "timestamp": "00:58:20", "text": "これに該当しない"}, {"type": "subtitle", "time": 3501.25, "timestamp": "00:58:21", "text": "カテゴリ、はい、いいえ"}, {"type": "subtitle", "time": 3502.156, "timestamp": "00:58:22", "text": "これを許可する"}, {"type": "subtitle", "time": 3504.077, "timestamp": "00:58:24", "text": "落ちる"}, {"type": "subtitle", "time": 3510.051, "timestamp": "00:58:30", "text": "通常。だから、"}, {"type": "subtitle", "time": 3511.309, "timestamp": "00:58:31", "text": "あなたは自分自身を宣伝し、"}, {"type": "subtitle", "time": 3512.335, "timestamp": "00:58:32", "text": "それら全て、あなたは"}, {"type": "subtitle", "time": 3513.56, "timestamp": "00:58:33", "text": "覚えておく必要がある、"}, {"type": "subtitle", "time": 3514.784, "timestamp": "00:58:34", "text": "これは一体何だ？おばあちゃんか何かか？"}, {"type": "subtitle", "time": 3523.929, "timestamp": "00:58:43", "text": "このような。はい、結局は、"}, {"type": "subtitle", "time": 3524.963, "timestamp": "00:58:44", "text": "最終返還"}, {"type": "subtitle", "time": 3525.963, "timestamp": "00:58:45", "text": "あなたの"}, {"type": "subtitle", "time": 3526.928, "timestamp": "00:58:46", "text": "欲望の自由"}, {"type": "subtitle", "time": 3528.169, "timestamp": "00:58:48", "text": "キャラクターを作成する"}, {"type": "subtitle", "time": 3529.41, "timestamp": "00:58:49", "text": "または、"}, {"type": "subtitle", "time": 3530.65, "timestamp": "00:58:50", "text": "気に入りましたか？"}, {"type": "subtitle", "time": 3531.857, "timestamp": "00:58:51", "text": "ご気分はいかがですか？"}, {"type": "subtitle", "time": 3532.994, "timestamp": "00:58:52", "text": "快適ですか？お元気ですか？"}, {"type": "subtitle", "time": 3534.373, "timestamp": "00:58:54", "text": "あなたはそれを描写したいし、"}, {"type": "subtitle", "time": 3535.476, "timestamp": "00:58:55", "text": "世界に見せる"}]
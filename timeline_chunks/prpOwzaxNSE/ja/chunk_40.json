[{"type": "subtitle", "time": 2410.455, "timestamp": "00:40:10", "text": "ご挨拶申し上げます。元気ですか？"}, {"type": "subtitle", "time": 2411.358, "timestamp": "00:40:11", "text": "もう日は過ぎたのか？"}, {"type": "subtitle", "time": 2412.958, "timestamp": "00:40:12", "text": "今日は日曜日です"}, {"type": "subtitle", "time": 2418.955, "timestamp": "00:40:18", "text": "見せる。明らかに明日"}, {"type": "subtitle", "time": 2420.439, "timestamp": "00:40:20", "text": "えーと、明日、えーと、日"}, {"type": "subtitle", "time": 2422.043, "timestamp": "00:40:22", "text": "海兵隊、日"}, {"type": "subtitle", "time": 2427.557, "timestamp": "00:40:27", "text": "日本にいるマリオン。えっと、"}, {"type": "subtitle", "time": 2429.492, "timestamp": "00:40:29", "text": "7月20日（月）"}, {"type": "subtitle", "time": 2432.922, "timestamp": "00:40:32", "text": "それは、"}, {"type": "subtitle", "time": 2434.392, "timestamp": "00:40:34", "text": "海、海洋の日、そして"}, {"type": "subtitle", "time": 2438.481, "timestamp": "00:40:38", "text": "今日は祝日です。そして"}, {"type": "subtitle", "time": 2439.484, "timestamp": "00:40:39", "text": "これは休日です"}, {"type": "subtitle", "time": 2443.462, "timestamp": "00:40:43", "text": "与えられます。これは休日です、"}, {"type": "subtitle", "time": 2444.409, "timestamp": "00:40:44", "text": "感謝"}, {"type": "subtitle", "time": 2445.323, "timestamp": "00:40:45", "text": "海は"}, {"type": "subtitle", "time": 2446.0, "timestamp": "00:40:46", "text": "寛大さと"}, {"type": "subtitle", "time": 2447.252, "timestamp": "00:40:47", "text": "考えてみると"}, {"type": "subtitle", "time": 2452.279, "timestamp": "00:40:52", "text": "重要性。私はただ"}, {"type": "subtitle", "time": 2456.651, "timestamp": "00:40:56", "text": "Googleで検索した。やってみよう。えっと、"}, {"type": "subtitle", "time": 2457.951, "timestamp": "00:40:57", "text": "はい、それは重要です"}]
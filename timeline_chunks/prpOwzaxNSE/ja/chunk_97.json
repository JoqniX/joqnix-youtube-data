[{"type": "subtitle", "time": 5824.705, "timestamp": "01:37:04", "text": "えっと、それで、もしあなたが Twitterで気づいたのですが、"}, {"type": "subtitle", "time": 5825.97, "timestamp": "01:37:05", "text": "Twitterで気づいたのですが、 フォローする"}, {"type": "subtitle", "time": 5827.235, "timestamp": "01:37:07", "text": "フォローする Twitterで私"}, {"type": "subtitle", "time": 5828.334, "timestamp": "01:37:08", "text": "Twitterで私 私は日本語でツイートします。"}, {"type": "subtitle", "time": 5844.936, "timestamp": "01:37:24", "text": "だから私は見つけることができる"}, {"type": "subtitle", "time": 5847.517, "timestamp": "01:37:27", "text": "人々"}, {"type": "subtitle", "time": 5851.513, "timestamp": "01:37:31", "text": "に興味がある"}, {"type": "subtitle", "time": 5852.778, "timestamp": "01:37:32", "text": "私とコミュニケーションをとる、"}, {"type": "subtitle", "time": 5853.744, "timestamp": "01:37:33", "text": "例えば、"}, {"type": "subtitle", "time": 5854.71, "timestamp": "01:37:34", "text": "外国人"}, {"type": "subtitle", "time": 5855.842, "timestamp": "01:37:35", "text": "日本語を勉強していて、"}, {"type": "subtitle", "time": 5856.941, "timestamp": "01:37:36", "text": "また、"}, {"type": "subtitle", "time": 5858.173, "timestamp": "01:37:38", "text": "英語を勉強するために、"}, {"type": "subtitle", "time": 5859.472, "timestamp": "01:37:39", "text": "つまり、"}, {"type": "subtitle", "time": 5860.438, "timestamp": "01:37:40", "text": "言語交換。"}, {"type": "subtitle", "time": 5870.47, "timestamp": "01:37:50", "text": "こんにちは、アリソ。"}, {"type": "subtitle", "time": 5875.417, "timestamp": "01:37:55", "text": "いらっしゃいませ。で"}, {"type": "subtitle", "time": 5876.476, "timestamp": "01:37:56", "text": "他にもいくつかあります。"}, {"type": "subtitle", "time": 5877.774, "timestamp": "01:37:57", "text": "分。もうすぐ行きます。"}]
[{"type": "subtitle", "time": 3180.118, "timestamp": "00:53:00", "text": "私は彼女と話している。として"}, {"type": "subtitle", "time": 3181.078, "timestamp": "00:53:01", "text": "少年よ、もし私が"}, {"type": "subtitle", "time": 3182.381, "timestamp": "00:53:02", "text": "私は女性形を使います"}, {"type": "subtitle", "time": 3183.582, "timestamp": "00:53:03", "text": "モデル、しかしモデル、"}, {"type": "subtitle", "time": 3184.542, "timestamp": "00:53:04", "text": "これは"}, {"type": "subtitle", "time": 3185.846, "timestamp": "00:53:05", "text": "別個の組織体、または"}, {"type": "subtitle", "time": 3187.218, "timestamp": "00:53:07", "text": "私はまだバービー人形の5セント硬貨なの？"}, {"type": "subtitle", "time": 3189.484, "timestamp": "00:53:09", "text": "ああ、なんて美しいんだ。"}, {"type": "subtitle", "time": 3193.818, "timestamp": "00:53:13", "text": "質問。これは良いことだ。"}, {"type": "subtitle", "time": 3200.433, "timestamp": "00:53:20", "text": "質問。私はそうは思わない。"}, {"type": "subtitle", "time": 3208.185, "timestamp": "00:53:28", "text": "ニックにとって私はバービー人形みたいな存在なの。えっと、"}, {"type": "subtitle", "time": 3213.326, "timestamp": "00:53:33", "text": "待って。何"}, {"type": "subtitle", "time": 3214.919, "timestamp": "00:53:34", "text": "バービー・ニコを定義するものは？"}, {"type": "subtitle", "time": 3216.872, "timestamp": "00:53:36", "text": "検索してみましょう。"}, {"type": "subtitle", "time": 3219.365, "timestamp": "00:53:39", "text": "ボビー・ニコはアバターです"}, {"type": "subtitle", "time": 3220.481, "timestamp": "00:53:40", "text": "日本風に、"}, {"type": "subtitle", "time": 3221.628, "timestamp": "00:53:41", "text": "それは女性を欺く"}, {"type": "subtitle", "time": 3222.651, "timestamp": "00:53:42", "text": "スタイル内のキャラクター"}, {"type": "subtitle", "time": 3223.302, "timestamp": "00:53:43", "text": "アニメ"}, {"type": "subtitle", "time": 3224.325, "timestamp": "00:53:44", "text": "使用済み"}, {"type": "subtitle", "time": 3225.41, "timestamp": "00:53:45", "text": "コンテンツクリエイター、"}, {"type": "subtitle", "time": 3226.433, "timestamp": "00:53:46", "text": "男性によって、"}, {"type": "subtitle", "time": 3227.301, "timestamp": "00:53:47", "text": "なぜならいくつか"}, {"type": "subtitle", "time": 3228.231, "timestamp": "00:53:48", "text": "女性向け製品のクリエイター"}, {"type": "subtitle", "time": 3229.099, "timestamp": "00:53:49", "text": "コンテンツも"}, {"type": "subtitle", "time": 3229.967, "timestamp": "00:53:49", "text": "自分たちは"}, {"type": "subtitle", "time": 3233.932, "timestamp": "00:53:53", "text": "おばあちゃん。うーん、この用語は"}, {"type": "subtitle", "time": 3235.221, "timestamp": "00:53:55", "text": "は略語です"}, {"type": "subtitle", "time": 3236.327, "timestamp": "00:53:56", "text": "ビジュアル、バーチャル、ビジュアル、それ"}, {"type": "subtitle", "time": 3237.653, "timestamp": "00:53:57", "text": "仮想"}, {"type": "subtitle", "time": 3239.017, "timestamp": "00:53:59", "text": "カーネーションを身につけた少女、"}]
[{"type": "subtitle", "time": 1926.924, "timestamp": "00:32:06", "text": "バージョン。はい、以上です。"}, {"type": "subtitle", "time": 1933.008, "timestamp": "00:32:13", "text": "そうなるでしょう。もうすぐ、えーと、"}, {"type": "subtitle", "time": 1934.499, "timestamp": "00:32:14", "text": "これについて"}, {"type": "subtitle", "time": 1940.376, "timestamp": "00:32:20", "text": "長い間私をフォローしている 私が何を持っているか、あなたは知っています"}, {"type": "subtitle", "time": 1941.694, "timestamp": "00:32:21", "text": "私が何を持っているか、あなたは知っています 他にもキャラクターがいて、"}, {"type": "subtitle", "time": 1950.041, "timestamp": "00:32:30", "text": "その他多数"}, {"type": "subtitle", "time": 1951.389, "timestamp": "00:32:31", "text": "登場人物について"}, {"type": "subtitle", "time": 1952.632, "timestamp": "00:32:32", "text": "一般には知られていない。"}, {"type": "subtitle", "time": 1956.634, "timestamp": "00:32:36", "text": "私には、"}, {"type": "subtitle", "time": 1958.187, "timestamp": "00:32:38", "text": "その瞬間、私は、ええと、わかっていました 、 そうみたいです、"}, {"type": "subtitle", "time": 1958.963, "timestamp": "00:32:38", "text": "、 そうみたいです、 プロジェクトをアーカイブしました"}, {"type": "subtitle", "time": 1960.361, "timestamp": "00:32:40", "text": "プロジェクトをアーカイブしました オネクシアですよね？のために"}, {"type": "chat", "time": 1962.561, "timestamp": "00:32:42", "author": "@Kenn_D_Bush", "avatar": "https://yt4.ggpht.com/_Komo_VEKSz-e7kb-dTpjPDPdwLBWdimZXGs-iY-B0gcs1aY-MXI_lQXH90AN623vf5ag2FRRA=s64-c-k-c0x00ffffff-no-rj", "message": "I do saw a few characters once i thunk"}, {"type": "subtitle", "time": 1965.487, "timestamp": "00:32:45", "text": "オネクシアですよね？のために それは難しかった…それは"}, {"type": "subtitle", "time": 1966.516, "timestamp": "00:32:46", "text": "それは難しかった…それは 集中しにくい"}, {"type": "subtitle", "time": 1967.711, "timestamp": "00:32:47", "text": "集中しにくい そして優先順位をつける"}, {"type": "subtitle", "time": 1968.938, "timestamp": "00:32:48", "text": "そして優先順位をつける オネクシアのキャラクターたちへ、"}, {"type": "subtitle", "time": 1970.233, "timestamp": "00:32:50", "text": "オネクシアのキャラクターたちへ、 ―ええ、その瞬間、私は"}, {"type": "subtitle", "time": 1971.527, "timestamp": "00:32:51", "text": "―ええ、その瞬間、私は 私は"}, {"type": "subtitle", "time": 1972.323, "timestamp": "00:32:52", "text": "私は  初め"}, {"type": "subtitle", "time": 1972.887, "timestamp": "00:32:52", "text": "初め 焦点を当てる"}, {"type": "subtitle", "time": 1973.883, "timestamp": "00:32:53", "text": "焦点を当てる 冗談を言って証明してみせる"}, {"type": "subtitle", "time": 1975.21, "timestamp": "00:32:55", "text": "冗談を言って証明してみせる 彼が"}, {"type": "subtitle", "time": 1976.305, "timestamp": "00:32:56", "text": "彼が かなり安定している"}, {"type": "subtitle", "time": 1977.599, "timestamp": "00:32:57", "text": "かなり安定している そうすれば私は"}]
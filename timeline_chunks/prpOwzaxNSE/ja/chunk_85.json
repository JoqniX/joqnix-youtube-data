[{"type": "subtitle", "time": 5105.198, "timestamp": "01:25:05", "text": "それは非常に難しいだろう。それで、"}, {"type": "subtitle", "time": 5106.73, "timestamp": "01:25:06", "text": "えっと、私のいくつか"}, {"type": "subtitle", "time": 5108.044, "timestamp": "01:25:08", "text": "クラスメート"}, {"type": "subtitle", "time": 5109.576, "timestamp": "01:25:09", "text": "インドは、"}, {"type": "subtitle", "time": 5111.239, "timestamp": "01:25:11", "text": "品詞、えーと、"}, {"type": "subtitle", "time": 5112.903, "timestamp": "01:25:12", "text": "私が学んだ学校、"}, {"type": "subtitle", "time": 5114.566, "timestamp": "01:25:14", "text": "えっと、彼らは東京にいて、ああ"}, {"type": "subtitle", "time": 5120.133, "timestamp": "01:25:20", "text": "彼らは本当に大変な思いをしている。自分"}, {"type": "subtitle", "time": 5121.538, "timestamp": "01:25:21", "text": "本当にごめんなさい、辛いですね。"}, {"type": "subtitle", "time": 5126.087, "timestamp": "01:25:26", "text": "彼らは苦しむが、"}, {"type": "subtitle", "time": 5127.349, "timestamp": "01:25:27", "text": "はい、アパートもその他すべて"}, {"type": "subtitle", "time": 5130.526, "timestamp": "01:25:30", "text": "とても高価だ。もし"}, {"type": "subtitle", "time": 5131.797, "timestamp": "01:25:31", "text": "4人と暮らすのは大変だ。"}, {"type": "subtitle", "time": 5132.867, "timestamp": "01:25:32", "text": "または5人"}, {"type": "subtitle", "time": 5134.004, "timestamp": "01:25:34", "text": "など、共有させてあげましょう"}, {"type": "subtitle", "time": 5138.719, "timestamp": "01:25:38", "text": "家。これは、えーと、"}, {"type": "subtitle", "time": 5140.054, "timestamp": "01:25:40", "text": "私...うーん、私は"}, {"type": "subtitle", "time": 5145.326, "timestamp": "01:25:45", "text": "2人用のアパート。それで"}, {"type": "subtitle", "time": 5146.413, "timestamp": "01:25:46", "text": "私の隣人と私"}, {"type": "subtitle", "time": 5147.424, "timestamp": "01:25:47", "text": "部屋があります"}, {"type": "subtitle", "time": 5148.822, "timestamp": "01:25:48", "text": "同期、または、"}, {"type": "subtitle", "time": 5150.221, "timestamp": "01:25:50", "text": "うーん、うーん、こんな感じ"}, {"type": "subtitle", "time": 5152.522, "timestamp": "01:25:52", "text": "それは何と呼ばれますか？ない"}, {"type": "subtitle", "time": 5155.812, "timestamp": "01:25:55", "text": "同期。私たちは"}, {"type": "subtitle", "time": 5157.12, "timestamp": "01:25:57", "text": "私たちは同じように理解しています"}, {"type": "subtitle", "time": 5158.464, "timestamp": "01:25:58", "text": "お互いに、など"}, {"type": "subtitle", "time": 5159.772, "timestamp": "01:25:59", "text": "わかりました、でも"}]
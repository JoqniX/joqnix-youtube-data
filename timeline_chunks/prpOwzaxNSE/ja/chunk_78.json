[{"type": "subtitle", "time": 4680.777, "timestamp": "01:18:00", "text": "アップルを手に入れる"}, {"type": "subtitle", "time": 4682.373, "timestamp": "01:18:02", "text": "ジュースは100円または130円、"}, {"type": "subtitle", "time": 4685.281, "timestamp": "01:18:05", "text": "私はいつもそれを買います。そして"}, {"type": "subtitle", "time": 4688.18, "timestamp": "01:18:08", "text": "ほかに何か？でもこの小さな子は"}, {"type": "subtitle", "time": 4689.452, "timestamp": "01:18:09", "text": "パンとジュース缶"}, {"type": "subtitle", "time": 4690.342, "timestamp": "01:18:10", "text": "記入してください"}, {"type": "subtitle", "time": 4692.937, "timestamp": "01:18:12", "text": "胃。見せる。だからあなたは"}, {"type": "subtitle", "time": 4694.109, "timestamp": "01:18:14", "text": "購入しようとしています"}, {"type": "subtitle", "time": 4696.857, "timestamp": "01:18:16", "text": "カップ麺。カップ"}, {"type": "subtitle", "time": 4699.083, "timestamp": "01:18:19", "text": "麺はどこかで値段がします"}, {"type": "subtitle", "time": 4701.429, "timestamp": "01:18:21", "text": "179か1、えーと、時々"}, {"type": "subtitle", "time": 4703.714, "timestamp": "01:18:23", "text": "156か159。場合によります。"}, {"type": "subtitle", "time": 4705.338, "timestamp": "01:18:25", "text": "あなたが"}, {"type": "subtitle", "time": 4709.069, "timestamp": "01:18:29", "text": "手に入れる。素晴らしい"}, {"type": "subtitle", "time": 4710.193, "timestamp": "01:18:30", "text": "サイズまたはそれより小さい、"}, {"type": "subtitle", "time": 4711.527, "timestamp": "01:18:31", "text": "コンパクト、丸型、"}, {"type": "subtitle", "time": 4712.685, "timestamp": "01:18:32", "text": "ボウルの形または"}, {"type": "subtitle", "time": 4713.669, "timestamp": "01:18:33", "text": "カップ型で、"}, {"type": "subtitle", "time": 4717.389, "timestamp": "01:18:37", "text": "何でも。例えば、"}, {"type": "subtitle", "time": 4718.485, "timestamp": "01:18:38", "text": "費用も同様に"}, {"type": "subtitle", "time": 4725.481, "timestamp": "01:18:45", "text": "店。もし私が持っているなら"}, {"type": "subtitle", "time": 4726.7, "timestamp": "01:18:46", "text": "1000円しかありません"}, {"type": "subtitle", "time": 4728.163, "timestamp": "01:18:48", "text": "今日生き残る、そして"}, {"type": "subtitle", "time": 4729.586, "timestamp": "01:18:49", "text": "店で買い物をする"}, {"type": "subtitle", "time": 4730.927, "timestamp": "01:18:50", "text": "そうすれば"}, {"type": "subtitle", "time": 4732.511, "timestamp": "01:18:52", "text": "残るのは私一人だけになるだろう。"}, {"type": "subtitle", "time": 4733.974, "timestamp": "01:18:53", "text": "700。私はすでに700を使いました"}, {"type": "subtitle", "time": 4735.559, "timestamp": "01:18:55", "text": "円と700円か500円くらいで、"}, {"type": "subtitle", "time": 4736.981, "timestamp": "01:18:56", "text": "私は私と一緒にいるだけです"}, {"type": "subtitle", "time": 4738.607, "timestamp": "01:18:58", "text": "100円ボトル数本 、そしてあなたはコーラを試しました"}]
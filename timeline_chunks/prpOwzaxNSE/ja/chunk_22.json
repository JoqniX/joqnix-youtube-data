[{"type": "subtitle", "time": 1322.057, "timestamp": "00:22:02", "text": "ついに。だから彼は しばしばグルになった"}, {"type": "subtitle", "time": 1323.305, "timestamp": "00:22:03", "text": "しばしばグルになった グル。そう、欲望だ。"}, {"type": "subtitle", "time": 1328.454, "timestamp": "00:22:08", "text": "だからあなたは"}, {"type": "subtitle", "time": 1329.714, "timestamp": "00:22:09", "text": "願いを叶えるために、"}, {"type": "subtitle", "time": 1330.939, "timestamp": "00:22:10", "text": "星座を作り、"}, {"type": "subtitle", "time": 1331.756, "timestamp": "00:22:11", "text": "共鳴する"}, {"type": "subtitle", "time": 1333.083, "timestamp": "00:22:13", "text": "星座、とてもたくさん"}, {"type": "subtitle", "time": 1336.837, "timestamp": "00:22:16", "text": "もの。つまり、これは"}, {"type": "subtitle", "time": 1342.508, "timestamp": "00:22:22", "text": "すごくクール。しかし"}, {"type": "subtitle", "time": 1343.994, "timestamp": "00:22:23", "text": "正直、デビュー、"}, {"type": "subtitle", "time": 1345.119, "timestamp": "00:22:25", "text": "うーん、はい、私は正直です"}, {"type": "subtitle", "time": 1346.604, "timestamp": "00:22:26", "text": "私はこう感じます"}, {"type": "subtitle", "time": 1352.404, "timestamp": "00:22:32", "text": "悪くなかった。私"}, {"type": "subtitle", "time": 1353.812, "timestamp": "00:22:33", "text": "もしあなたが望むなら"}, {"type": "subtitle", "time": 1355.148, "timestamp": "00:22:35", "text": "正直な意見では、"}, {"type": "subtitle", "time": 1356.375, "timestamp": "00:22:36", "text": "正直そう思います"}, {"type": "subtitle", "time": 1357.675, "timestamp": "00:22:37", "text": "昨日の後に"}, {"type": "chat", "time": 1359.111, "timestamp": "00:22:39", "author": "@Kenn_D_Bush", "avatar": "https://yt4.ggpht.com/_Komo_VEKSz-e7kb-dTpjPDPdwLBWdimZXGs-iY-B0gcs1aY-MXI_lQXH90AN623vf5ag2FRRA=s64-c-k-c0x00ffffff-no-rj", "message": "Hmmm joq do you think a door showing up when someone about to make a choice counts as granting wishes?"}, {"type": "subtitle", "time": 1359.119, "timestamp": "00:22:39", "text": "私はどこに苦情を言ったのですか？"}, {"type": "subtitle", "time": 1364.794, "timestamp": "00:22:44", "text": "エラーの数に関して、"}, {"type": "subtitle", "time": 1365.768, "timestamp": "00:22:45", "text": "私はそうしました。"}, {"type": "subtitle", "time": 1367.154, "timestamp": "00:22:47", "text": "例えば、なぜ私はそれらを持っているのか"}, {"type": "subtitle", "time": 1369.31, "timestamp": "00:22:49", "text": "あなたはそれをしましたか？それ？なぜ私なの？"}, {"type": "subtitle", "time": 1370.569, "timestamp": "00:22:50", "text": "これを説明しておくべきだった"}, {"type": "subtitle", "time": 1373.837, "timestamp": "00:22:53", "text": "より良い？これとこれ。私は"}, {"type": "subtitle", "time": 1375.154, "timestamp": "00:22:55", "text": "リストされている、ええと、"}, {"type": "subtitle", "time": 1376.357, "timestamp": "00:22:56", "text": "これをリストしました"}, {"type": "subtitle", "time": 1379.355, "timestamp": "00:22:59", "text": "自体。私は「うわあ」って感じ。"}]
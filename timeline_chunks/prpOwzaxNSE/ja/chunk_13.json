[{"type": "subtitle", "time": 787.841, "timestamp": "00:13:07", "text": "ユリ・ユリカマとして"}, {"type": "subtitle", "time": 789.129, "timestamp": "00:13:09", "text": "これを実装することができました"}, {"type": "subtitle", "time": 795.398, "timestamp": "00:13:15", "text": "人生。私は本当に"}, {"type": "subtitle", "time": 796.585, "timestamp": "00:13:16", "text": "彼女が"}, {"type": "subtitle", "time": 797.971, "timestamp": "00:13:17", "text": "これらを体現した、ええと、私の"}, {"type": "subtitle", "time": 798.644, "timestamp": "00:13:18", "text": "アイデア、私のもの"}, {"type": "subtitle", "time": 800.109, "timestamp": "00:13:20", "text": "概念的なアイデア。"}, {"type": "subtitle", "time": 802.77, "timestamp": "00:13:22", "text": "彼女は本当に"}, {"type": "subtitle", "time": 805.939, "timestamp": "00:13:25", "text": "考えてみた。私"}, {"type": "subtitle", "time": 807.024, "timestamp": "00:13:27", "text": "彼女は"}, {"type": "subtitle", "time": 808.573, "timestamp": "00:13:28", "text": "私の配信を見て、 私と同じように、おそらく"}, {"type": "subtitle", "time": 809.619, "timestamp": "00:13:29", "text": "私と同じように、おそらく これを分析した。"}, {"type": "subtitle", "time": 814.658, "timestamp": "00:13:34", "text": "もしかしたら、それは私のものかもしれない。"}, {"type": "subtitle", "time": 816.145, "timestamp": "00:13:36", "text": "推測ですが、ええと、私は"}, {"type": "subtitle", "time": 817.594, "timestamp": "00:13:37", "text": "絶対にない…まだわからない"}, {"type": "subtitle", "time": 818.858, "timestamp": "00:13:38", "text": "彼女は自分ではやらない"}, {"type": "subtitle", "time": 823.241, "timestamp": "00:13:43", "text": "そう言うでしょう。でも、これは"}, {"type": "subtitle", "time": 824.384, "timestamp": "00:13:44", "text": "モデルはこうでした。"}, {"type": "subtitle", "time": 825.628, "timestamp": "00:13:45", "text": "私はかつての私であり、今もなおそうである。"}, {"type": "subtitle", "time": 826.838, "timestamp": "00:13:46", "text": "混乱していた、または"}, {"type": "subtitle", "time": 828.116, "timestamp": "00:13:48", "text": "私に似合ってるかな？"}, {"type": "subtitle", "time": 830.773, "timestamp": "00:13:50", "text": "彼女は答えるだろうか？"}, {"type": "subtitle", "time": 832.188, "timestamp": "00:13:52", "text": "私の性格？として"}, {"type": "subtitle", "time": 833.648, "timestamp": "00:13:53", "text": "配信についてどう感じているか？"}, {"type": "subtitle", "time": 836.366, "timestamp": "00:13:56", "text": "同じアスリート、"}, {"type": "subtitle", "time": 837.865, "timestamp": "00:13:57", "text": "ご存知の通り、"}]
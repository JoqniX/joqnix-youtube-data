[{"type": "subtitle", "time": 3723.016, "timestamp": "01:02:03", "text": "そして右手に"}, {"type": "subtitle", "time": 3724.306, "timestamp": "01:02:04", "text": "右目は獅子座の目ですか？"}, {"type": "subtitle", "time": 3728.889, "timestamp": "01:02:08", "text": "はい。はい、それは印です。"}, {"type": "subtitle", "time": 3730.031, "timestamp": "01:02:10", "text": "起源、"}, {"type": "subtitle", "time": 3735.909, "timestamp": "01:02:15", "text": "私が所属していることを示しています"}, {"type": "subtitle", "time": 3738.281, "timestamp": "01:02:18", "text": "しし座。私"}, {"type": "subtitle", "time": 3739.716, "timestamp": "01:02:19", "text": "ライオンズギャングの一員。"}, {"type": "subtitle", "time": 3742.637, "timestamp": "01:02:22", "text": "私のあざ、"}, {"type": "subtitle", "time": 3745.457, "timestamp": "01:02:25", "text": "そう言ってもいいですよ。したがって、"}, {"type": "subtitle", "time": 3750.346, "timestamp": "01:02:30", "text": "えっと、どう思いますか？"}, {"type": "subtitle", "time": 3751.901, "timestamp": "01:02:31", "text": "日本？そこは快適ですか？"}, {"type": "subtitle", "time": 3752.97, "timestamp": "01:02:32", "text": "か否か？お願いします、"}, {"type": "subtitle", "time": 3753.645, "timestamp": "01:02:33", "text": "名前をつけて"}, {"type": "subtitle", "time": 3754.319, "timestamp": "01:02:34", "text": "ポジティブで"}, {"type": "subtitle", "time": 3755.304, "timestamp": "01:02:35", "text": "ネガティブな瞬間。"}, {"type": "subtitle", "time": 3756.879, "timestamp": "01:02:36", "text": "なるほど、良い質問ですね。"}, {"type": "subtitle", "time": 3758.95, "timestamp": "01:02:38", "text": "良い瞬間。の上 まず、これは美しい"}, {"type": "subtitle", "time": 3760.5, "timestamp": "01:02:40", "text": "まず、これは美しい 国。文化、"}, {"type": "subtitle", "time": 3767.161, "timestamp": "01:02:47", "text": "国。文化、 文化、ええ、そうです"}, {"type": "subtitle", "time": 3768.236, "timestamp": "01:02:48", "text": "文化、ええ、そうです 環境がすべてだ"}, {"type": "subtitle", "time": 3769.562, "timestamp": "01:02:49", "text": "環境がすべてだ 違う、そして他のすべてが違う"}, {"type": "subtitle", "time": 3770.923, "timestamp": "01:02:50", "text": "違う、そして他のすべてが違う インドと比較して、"}, {"type": "subtitle", "time": 3772.21
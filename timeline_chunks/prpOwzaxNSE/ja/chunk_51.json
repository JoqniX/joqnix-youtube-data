[{"type": "subtitle", "time": 3061.279, "timestamp": "00:51:01", "text": "、 お前？私はそれを知らなかった あなたは転生しました"}, {"type": "subtitle", "time": 3062.4, "timestamp": "00:51:02", "text": "あなたは転生しました 魅力的な女の子。何？"}, {"type": "subtitle", "time": 3065.159, "timestamp": "00:51:05", "text": "魅力的な女の子。何？ いや。なんてことだ。君…君…"}, {"type": "subtitle", "time": 3069.893, "timestamp": "00:51:09", "text": "いや。なんてことだ。君…君… 皆さんはこう思います... ええと..."}, {"type": "subtitle", "time": 3071.509, "timestamp": "00:51:11", "text": "皆さんはこう思います... ええと... 我が神よ。それ"}, {"type": "subtitle", "time": 3073.374, "timestamp": "00:51:13", "text": "我が神よ。それ 両性具有的なモデル。で"}, {"type": "subtitle", "time": 3074.949, "timestamp": "00:51:14", "text": "両性具有的なモデル。で 彼女は赤毛ではない。それ..."}, {"type": "subtitle", "time": 3077.095, "timestamp": "00:51:17", "text": "彼女は赤毛ではない。それ... これは深海に浮かぶ星座だ。"}, {"type": "subtitle", "time": 3083.514, "timestamp": "00:51:23", "text": "はい、外見"}, {"type": "subtitle", "time": 3084.739, "timestamp": "00:51:24", "text": "誤解を招く可能性がある、"}, {"type": "subtitle", "time": 3085.802, "timestamp": "00:51:25", "text": "しかしこれは女の子ではない モデル。つまり、これは"}, {"type": "subtitle", "time": 3089.66, "timestamp": "00:51:29", "text": "モデル。つまり、これは どちらかというと両性具有的"}, {"type": "subtitle", "time": 3090.885, "timestamp": "00:51:30", "text": "どちらかというと両性具有的 モデル。では、想像してみてください"}, {"type": "subtitle", "time": 3095.323, "timestamp": "00:51:35", "text": "モデル。では、想像してみてください レマルに似ていると思う"}, {"type": "subtitle", "time": 3096.361, "timestamp": "00:51:36", "text": "レマルに似ていると思う アニメのテンペストについて"}, {"type": "subtitle", "time": 3097.529, "timestamp": "00:51:37", "text": "アニメのテンペストについて 粘液。おお。それで、えっと、私は"}, {"type": "subtitle", "time": 3106.217, "timestamp": "00:51:46", "text": "粘液。おお。それで、えっと、私は 見つける必要がある"}, {"type": "subtitle", "time": 3107.385, "timestamp": "00:51:47", "text": "見つける必要がある サンプル画像。何"}, {"type": "subtitle", "time": 3109.418, "timestamp": "00:51:49", "text": "サンプル画像。何 なんてこった？想像する"}, {"type": "subtitle", "time": 3114.581, "timestamp": "00:51:54", "text": "なんてこった？想像する それはレムルに似ている。"}, {"type": "subtitle", "time": 3115.924, "timestamp": "00:51:55", "text": "それはレムルに似ている。 私にさせて"}, {"type": "subtitle", "time": 3116.803, "timestamp": "00:51:56", "text": "私にさせて 見せてください"}, {"type": "subtitle", "time": 3117.495, "timestamp": "00:51:57", "text": "見せてください 画像。ああ、"}]
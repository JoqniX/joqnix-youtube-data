[{"type": "subtitle", "time": 6002.627, "timestamp": "01:40:02", "text": "多くの人が参加するイベント"}, {"type": "subtitle", "time": 6004.173, "timestamp": "01:40:04", "text": "日本のユーチューバー、"}, {"type": "subtitle", "time": 6005.844, "timestamp": "01:40:05", "text": "例えば、サーバー上で"}, {"type": "subtitle", "time": 6007.265, "timestamp": "01:40:07", "text": "マインクラフト、ラスト、パルワールド、または"}, {"type": "subtitle", "time": 6008.811, "timestamp": "01:40:08", "text": "GTRPとか何か"}, {"type": "subtitle", "time": 6011.03, "timestamp": "01:40:11", "text": "このような。欲しい"}, {"type": "subtitle", "time": 6012.102, "timestamp": "01:40:12", "text": "参加する"}, {"type": "subtitle", "time": 6013.04, "timestamp": "01:40:13", "text": "そのようなグループ"}, {"type": "subtitle", "time": 6015.11, "timestamp": "01:40:15", "text": "イベント。自分の体調を見てみます。"}, {"type": "subtitle", "time": 6015.954, "timestamp": "01:40:15", "text": "私はそれを行うことができます。"}, {"type": "subtitle", "time": 6017.221, "timestamp": "01:40:17", "text": "これと組み合わせると最高です"}, {"type": "subtitle", "time": 6017.709, "timestamp": "01:40:17", "text": "どのように"}, {"type": "subtitle", "time": 6018.813, "timestamp": "01:40:18", "text": "私は協力します"}, {"type": "subtitle", "time": 6020.048, "timestamp": "01:40:20", "text": "多くの日本人"}, {"type": "subtitle", "time": 6021.25, "timestamp": "01:40:21", "text": "YouTuberたちと、私もそれに慣れるだろう"}, {"type": "subtitle", "time": 6023.713, "timestamp": "01:40:23", "text": "日本語に"}, {"type": "subtitle", "time": 6028.082, "timestamp": "01:40:28", "text": "文化、フォーマット"}, {"type": "subtitle", "time": 6033.926, "timestamp": "01:40:33", "text": "など。だから私は"}, {"type": "subtitle", "time": 6035.287, "timestamp": "01:40:35", "text": "個人的には"}, {"type": "subtitle", "time": 6036.497, "timestamp": "01:40:36", "text": "日本のvtubeと"}, {"type": "subtitle", "time": 6037.442, "timestamp": "01:40:37", "text": "ウエスタンVチュービング"}, {"type": "subtitle", "time": 6042.057, "timestamp": "01:40:42", "text": "それらは異なる。えっと、なぜなら"}]
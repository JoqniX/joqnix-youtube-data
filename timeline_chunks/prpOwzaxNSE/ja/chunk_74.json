[{"type": "subtitle", "time": 4440.072, "timestamp": "01:14:00", "text": "バカ、特に"}, {"type": "subtitle", "time": 4441.372, "timestamp": "01:14:01", "text": "聞くこともできます"}, {"type": "subtitle", "time": 4442.638, "timestamp": "01:14:02", "text": "ヘッドホン、音楽、"}, {"type": "subtitle", "time": 4444.821, "timestamp": "01:14:04", "text": "乗る。なぜルールがあるのか"}, {"type": "subtitle", "time": 4445.896, "timestamp": "01:14:05", "text": "自転車に関して"}, {"type": "subtitle", "time": 4447.266, "timestamp": "01:14:07", "text": "そんなに厳しいの？まるで"}, {"type": "subtitle", "time": 4448.698, "timestamp": "01:14:08", "text": "自分の車か何か"}, {"type": "subtitle", "time": 4453.297, "timestamp": "01:14:13", "text": "このような。そして手に入れる"}, {"type": "subtitle", "time": 4454.501, "timestamp": "01:14:14", "text": "運転免許証、私"}, {"type": "subtitle", "time": 4455.882, "timestamp": "01:14:15", "text": "日本では、"}, {"type": "subtitle", "time": 4457.086, "timestamp": "01:14:17", "text": "あなたはドライバーです、"}, {"type": "subtitle", "time": 4458.148, "timestamp": "01:14:18", "text": "運転免許証"}, {"type": "subtitle", "time": 4462.473, "timestamp": "01:14:22", "text": "難しい。そして私は聞いた"}, {"type": "subtitle", "time": 4463.799, "timestamp": "01:14:23", "text": "最も難しい試験"}, {"type": "subtitle", "time": 4464.602, "timestamp": "01:14:24", "text": "日本では、"}, {"type": "subtitle", "time": 4465.685, "timestamp": "01:14:25", "text": "運転免許証、"}, {"type": "subtitle", "time": 4466.906, "timestamp": "01:14:26", "text": "理論試験、"}, {"type": "subtitle", "time": 4468.661, "timestamp": "01:14:28", "text": "実用的。私は思う"}, {"type": "subtitle", "time": 4469.949, "timestamp": "01:14:29", "text": "あなたたちならできる"}, {"type": "subtitle", "time": 4471.379, "timestamp": "01:14:31", "text": "使用するには、"}, {"type": "subtitle", "time": 4474.236, "timestamp": "01:14:34", "text": "理論的。そこには"}, {"type": "subtitle", "time": 4475.192, "timestamp": "01:14:35", "text": "彼らはとても多くのものを与えてくれる"}, {"type": "subtitle", "time": 4476.179, "timestamp": "01:14:36", "text": "複雑な単純な"}, {"type": "subtitle", "time": 4477.104, "timestamp": "01:14:37", "text": "質問ですが、"}, {"type": "subtitle", "time": 4478.308, "timestamp": "01:14:38", "text": "複雑にねじれている。"}, {"type": "subtitle", "time": 4482.84, "timestamp": "01:14:42", "text": "ええと、あなたは"}, {"type": "subtitle", "time": 4484.152, "timestamp": "01:14:44", "text": "物理学には注意し、"}, {"type": "subtitle", "time": 4484.841, "timestamp": "01:14:44", "text": "正しい"}, {"type": "subtitle", "time": 4486.12, "timestamp": "01:14:46", "text": "人種の形成、"}, {"type": "subtitle", "time": 4487.432, "timestamp": "01:14:47", "text": "例えば、"}, {"type": "subtitle", "time": 4490.762, "timestamp": "01:14:50", "text": "よく考えるなど。"}, {"type": "subtitle", "time": 4493.272, "timestamp": "01:14:53", "text": "例えば、N3またはN2N1のJLPT試験のように、"}, {"type": "subtitle", "time": 4497.524, "timestamp": "01:14:57", "text": "それ、それ…どうやってやるんですか？"}, {"type": "subtitle", "time": 4498.82, "timestamp": "01:14:58", "text": "あなたがそれを呼ぶ、書かれた"}]
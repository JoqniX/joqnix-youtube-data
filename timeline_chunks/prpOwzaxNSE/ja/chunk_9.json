[{"type": "subtitle", "time": 540.743, "timestamp": "00:09:00", "text": "私の頭の上に、えっと… えー、ティアラみたいだね。"}, {"type": "subtitle", "time": 541.946, "timestamp": "00:09:01", "text": "えー、ティアラみたいだね。 ティアラのように見えるが、"}, {"type": "subtitle", "time": 543.449, "timestamp": "00:09:03", "text": "ティアラのように見えるが、 星座の冠。"}, {"type": "subtitle", "time": 551.179, "timestamp": "00:09:11", "text": "つまり、それは"}, {"type": "subtitle", "time": 552.334, "timestamp": "00:09:12", "text": "すべての星座が"}, {"type": "subtitle", "time": 553.786, "timestamp": "00:09:13", "text": "こう考えてみてください。"}, {"type": "subtitle", "time": 555.276, "timestamp": "00:09:15", "text": "ここにはさまざまな星座があります 射手座、獅子座、蟹座、"}, {"type": "subtitle", "time": 563.015, "timestamp": "00:09:23", "text": "射手座、獅子座、蟹座、 双子は、"}, {"type": "subtitle", "time": 564.409, "timestamp": "00:09:24", "text": "双子は、 いくつかの星座。"}, {"type": "subtitle", "time": 569.458, "timestamp": "00:09:29", "text": "星座は"}, {"type": "subtitle", "time": 570.998, "timestamp": "00:09:30", "text": "ティアラ、つまり王冠。"}, {"type": "subtitle", "time": 577.276, "timestamp": "00:09:37", "text": "そしてベールはただ"}, {"type": "subtitle", "time": 578.687, "timestamp": "00:09:38", "text": "表現する、えーと、"}, {"type": "subtitle", "time": 581.578, "timestamp": "00:09:41", "text": "それは何と呼ばれますか？何"}, {"type": "subtitle", "time": 583.992, "timestamp": "00:09:43", "text": "私が探している単語は何ですか？彼女"}, {"type": "subtitle", "time": 588.352, "timestamp": "00:09:48", "text": "単に表しているだけです、私は"}, {"type": "subtitle", "time": 589.624, "timestamp": "00:09:49", "text": "これは"}, {"type": "subtitle", "time": 591.078, "timestamp": "00:09:51", "text": "私の服装の一部です。"}, {"type": "subtitle", "time": 594.578, "timestamp": "00:09:54", "text": "ええ、それも理由の一つです。"}, {"type": "subtitle", "time": 595.564, "timestamp": "00:09:55", "text": "服装、これ"}, {"type": "subtitle", "time": 596.659, "timestamp": "00:09:56", "text": "できるだけたくさん服を着る"}, {"type": "chat", "time": 599.536, "timestamp": "00:09:59", "author": "@Kenn_D_Bush", "avatar": "https://yt4.ggpht.com/_Komo_VEKS
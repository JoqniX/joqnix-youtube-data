[{"type": "subtitle", "time": 4266.081, "timestamp": "01:11:06", "text": "ああ、そうだね。はい。あなたはそうだった。あなた"}, {"type": "subtitle", "time": 4267.448, "timestamp": "01:11:07", "text": "日本語。あなたは勉強しています"}, {"type": "subtitle", "time": 4268.786, "timestamp": "01:11:08", "text": "英語。私は今"}, {"type": "subtitle", "time": 4272.61, "timestamp": "01:11:12", "text": "私は覚えています。それで、えっと、私は"}, {"type": "subtitle", "time": 4274.115, "timestamp": "01:11:14", "text": "最初はこう思った"}, {"type": "subtitle", "time": 4278.766, "timestamp": "01:11:18", "text": "あなたは日本に住んでいます。あなた"}, {"type": "subtitle", "time": 4279.905, "timestamp": "01:11:19", "text": "外国人か何か"}, {"type": "subtitle", "time": 4281.999, "timestamp": "01:11:21", "text": "このような。はい、私は生まれました"}, {"type": "subtitle", "time": 4291.85, "timestamp": "01:11:31", "text": "そして日本で育った。ああ、それから"}, {"type": "subtitle", "time": 4297.359, "timestamp": "01:11:37", "text": "うんうん。良い。うーん、たぶん どうすればいいか"}, {"type": "subtitle", "time": 4298.529, "timestamp": "01:11:38", "text": "どうすればいいか 私が放送を始めてどれくらいになりますか？えっと、"}, {"type": "subtitle", "time": 4301.21, "timestamp": "01:11:41", "text": "私が放送を始めてどれくらいになりますか？えっと、 待って、カウンターはどこ？"}, {"type": "subtitle", "time": 4306.948, "timestamp": "01:11:46", "text": "ええと、1時間です。はい、"}, {"type": "subtitle", "time": 4308.651, "timestamp": "01:11:48", "text": "まだ30個くらい残っています。"}, {"type": "subtitle", "time": 4310.101, "timestamp": "01:11:50", "text": "分。すぐに"}, {"type": "subtitle", "time": 4313.022, "timestamp": "01:11:53", "text": "最後に。それで、"}, {"type": "subtitle", "time": 4314.355, "timestamp": "01:11:54", "text": "これは、えーと、現金です"}, {"type": "subtitle", "time": 4316.666, "timestamp": "01:11:56", "text": "カードは発行されました。はい。"}]
[{"type": "subtitle", "time": 5700.471, "timestamp": "01:35:00", "text": "多様な コンテンツ。うーん、私は"}, {"type": "subtitle", "time": 5702.39, "timestamp": "01:35:02", "text": "コンテンツ。うーん、私は やってみます。"}, {"type": "subtitle", "time": 5706.049, "timestamp": "01:35:06", "text": "やってみます。 何でもあり得る、ええと、"}, {"type": "subtitle", "time": 5707.133, "timestamp": "01:35:07", "text": "何でもあり得る、ええと、 もっと多くのことをするために"}, {"type": "subtitle", "time": 5708.073, "timestamp": "01:35:08", "text": "もっと多くのことをするために 動画コンテンツ。ない"}, {"type": "subtitle", "time": 5709.342, "timestamp": "01:35:09", "text": "動画コンテンツ。ない 私は多くのことを約束できます。"}, {"type": "subtitle", "time": 5715.067, "timestamp": "01:35:15", "text": "ええと、私にはあまりできることがありません。"}, {"type": "subtitle", "time": 5716.261, "timestamp": "01:35:16", "text": "約束はできるが、"}, {"type": "subtitle", "time": 5717.53, "timestamp": "01:35:17", "text": "試してみる時が来た"}, {"type": "subtitle", "time": 5718.723, "timestamp": "01:35:18", "text": "限定的で、"}, {"type": "subtitle", "time": 5719.955, "timestamp": "01:35:19", "text": "十分ではない、多すぎる。"}, {"type": "subtitle", "time": 5728.492, "timestamp": "01:35:28", "text": "ということで、今週は"}, {"type": "subtitle", "time": 5729.263, "timestamp": "01:35:29", "text": "私たちは"}, {"type": "subtitle", "time": 5730.42, "timestamp": "01:35:30", "text": "継続的な放送、"}, {"type": "subtitle", "time": 5731.399, "timestamp": "01:35:31", "text": "そしてもっとこう"}, {"type": "subtitle", "time": 5732.407, "timestamp": "01:35:32", "text": "私と一緒に働きましょう「はい」"}, {"type": "subtitle", "time": 5733.534, "timestamp": "01:35:33", "text": "継続的な放送"}, {"type": "subtitle", "time": 5736.98, "timestamp": "01:35:36", "text": "私と一緒に。 「そして私は"}, {"type": "subtitle", "time": 5738.342, "timestamp": "01:35:38", "text": "新しいシリーズを開始する"}, {"type": "subtitle", "time": 5739.564, "timestamp": "01:35:39", "text": "このチャンネルでは、"}, {"type": "subtitle", "time": 5744.587, "timestamp": "01:35:44", "text": "Bワールドゲームシリーズと"}, {"type": "subtitle", "time": 5747.487, "timestamp": "01:35:47", "text": "マインクラフトの残響。私はそれらを買いました。"}, {"type": "subtitle", "time": 5751.58, "timestamp": "01:35:51", "text": "両方。えっと、これ買いました。"}, {"type": "subtitle", "time": 5752.813, "timestamp": "01:35:52", "text": "SEOゲーム、そんな感じのもの"}, {"type": "subtitle", "time": 5754.399, "timestamp": "01:35:54", "text": "オンラインゲームのようなもの。"}, {"type": "subtitle", "time": 5758.961, "timestamp": "01:35:58", "text": "だからいつか"}, {"type": "subtitle", "time": 5759.959, "timestamp": "01:35:59", "text": "彼らをプレイする"}]
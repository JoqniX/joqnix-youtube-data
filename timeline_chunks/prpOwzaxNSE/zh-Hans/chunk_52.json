[{"type": "subtitle", "time": 3121.921, "timestamp": "00:52:01", "text": "图像。哦，甚至 我做不到。"}, {"type": "subtitle", "time": 3122.594, "timestamp": "00:52:02", "text": "我做不到。 制定。"}, {"type": "subtitle", "time": 3137.483, "timestamp": "00:52:17", "text": "等待。我就是这个。"}, {"type": "subtitle", "time": 3140.1, "timestamp": "00:52:20", "text": "做过？哦，我做了。在"}, {"type": "subtitle", "time": 3145.17, "timestamp": "00:52:25", "text": "我的上帝。不是那个。这。"}, {"type": "subtitle", "time": 3146.72, "timestamp": "00:52:26", "text": "好的。一样"}, {"type": "subtitle", "time": 3147.854, "timestamp": "00:52:27", "text": "真正的暴风雨。"}, {"type": "subtitle", "time": 3158.252, "timestamp": "00:52:38", "text": "想象一下这种情况。"}, {"type": "subtitle", "time": 3160.24, "timestamp": "00:52:40", "text": "就像暴风雨一样。类似的事情。"}, {"type": "subtitle", "time": 3161.921, "timestamp": "00:52:41", "text": "呃，你"}, {"type": "subtitle", "time": 3163.276, "timestamp": "00:52:43", "text": "专攻"}, {"type": "subtitle", "time": 3164.429, "timestamp": "00:52:44", "text": "日本人？不，我"}, {"type": "subtitle", "time": 3165.933, "timestamp": "00:52:45", "text": "因此，我是一名语言学专业的学生。"}, {"type": "subtitle", "time": 3167.211, "timestamp": "00:52:47", "text": "我正在学习日语。"}, {"type": "subtitle", "time": 3173.359, "timestamp": "00:52:53", "text": "我身体不太舒服。"}]
[{"type": "subtitle", "time": 4266.081, "timestamp": "01:11:06", "text": "哦是的。是的。你曾经是。你"}, {"type": "subtitle", "time": 4267.448, "timestamp": "01:11:07", "text": "日本人。你正在学习"}, {"type": "subtitle", "time": 4268.786, "timestamp": "01:11:08", "text": "英语。我现在"}, {"type": "subtitle", "time": 4272.61, "timestamp": "01:11:12", "text": "我记得。所以，呃，我"}, {"type": "subtitle", "time": 4274.115, "timestamp": "01:11:14", "text": "起初我以为"}, {"type": "subtitle", "time": 4278.766, "timestamp": "01:11:18", "text": "你住在日本。你"}, {"type": "subtitle", "time": 4279.905, "timestamp": "01:11:19", "text": "外国人之类的"}, {"type": "subtitle", "time": 4281.999, "timestamp": "01:11:21", "text": "像这样。是的，我出生了"}, {"type": "subtitle", "time": 4291.85, "timestamp": "01:11:31", "text": "在日本长大。哦，还有"}, {"type": "subtitle", "time": 4297.359, "timestamp": "01:11:37", "text": "嗯哼。好的。嗯，也许吧。 将会不得不……如何"}, {"type": "subtitle", "time": 4298.529, "timestamp": "01:11:38", "text": "将会不得不……如何 我从事广播工作多久了？呃，"}, {"type": "subtitle", "time": 4301.21, "timestamp": "01:11:41", "text": "我从事广播工作多久了？呃， 等等，柜台在哪里？"}, {"type": "subtitle", "time": 4306.948, "timestamp": "01:11:46", "text": "呃，1小时。好的，在"}, {"type": "subtitle", "time": 4308.651, "timestamp": "01:11:48", "text": "我还有大约30个。"}, {"type": "subtitle", "time": 4310.101, "timestamp": "01:11:50", "text": "分钟。我很快就能"}, {"type": "subtitle", "time": 4313.022, "timestamp": "01:11:53", "text": "结束。那么，"}, {"type": "subtitle", "time": 4314.355, "timestamp": "01:11:54", "text": "这是，呃，现金。"}, {"type": "subtitle", "time": 4316.666, "timestamp": "01:11:56", "text": "卡片已发出。是的。"}]
[{"type": "subtitle", "time": 2884.465, "timestamp": "00:48:04", "text": "？如果这些晶体 你将被毁灭。"}, {"type": "subtitle", "time": 2885.59, "timestamp": "00:48:05", "text": "你将被毁灭。 你是要死了吗？"}, {"type": "subtitle", "time": 2886.451, "timestamp": "00:48:06", "text": "你是要死了吗？ 储存在这些"}, {"type": "subtitle", "time": 2887.61, "timestamp": "00:48:07", "text": "储存在这些 晶体？这是关于……"}, {"type": "subtitle", "time": 2891.33, "timestamp": "00:48:11", "text": "晶体？这是关于…… 比如你的力量，或者"}, {"type": "subtitle", "time": 2892.503, "timestamp": "00:48:12", "text": "比如你的力量，或者 大概是这样的"}, {"type": "subtitle", "time": 2893.518, "timestamp": "00:48:13", "text": "大概是这样的  引领"}, {"type": "subtitle", "time": 2894.437, "timestamp": "00:48:14", "text": "引领 灯或"}, {"type": "subtitle", "time": 2895.325, "timestamp": "00:48:15", "text": "灯或 类似那样？什么"}, {"type": "subtitle", "time": 2896.63, "timestamp": "00:48:16", "text": "类似那样？什么 它能做到吗？所以，"}, {"type": "subtitle", "time": 2899.418, "timestamp": "00:48:19", "text": "它能做到吗？所以， 如果你把这个放在这里"}, {"type": "subtitle", "time": 2900.71, "timestamp": "00:48:20", "text": "如果你把这个放在这里 问题是"}, {"type": "subtitle", "time": 2901.729, "timestamp": "00:48:21", "text": "问题是 我考虑过这个问题。"}, {"type": "subtitle", "time": 2907.295, "timestamp": "00:48:27", "text": "我考虑过这个问题。 会说些什么"}, {"type": "subtitle", "time": 2908.355, "timestamp": "00:48:28", "text": "会说些什么 比如：是的，不是那样的。"}, {"type": "subtitle", "time": 2909.697, "timestamp": "00:48:29", "text": "比如：是的，不是那样的。 你觉得呢？不是这样的。"}, {"type": "subtitle", "time": 2911.111, "timestamp": "00:48:31", "text": "你觉得呢？不是这样的。 它太容易坏了。"}, {"type": "subtitle", "time": 2915.267, "timestamp": "00:48:35", "text": "嗯，我的保护"}, {"type": "subtitle", "time": 2919.495, "timestamp": "00:48:39", "text": "机制——这种"}, {"type": "subtitle", "time": 2920.743, "timestamp": "00:48:40", "text": "水晶球"}, {"type": "subtitle", "time": 2921.639, "timestamp": "00:48:41", "text": "旋转"}, {"type": "subtitle", "time": 2924.26, "timestamp": "00:48:44", "text": "我周围。他们"}, {"type": "subtitle", "time": 2927.816, "timestamp": "00:48:47", "text": "不仅作为"}, {"type": "subtitle", "time": 2929.097, "timestamp": "00:48:49", "text": "信标、发射器、"}, {"type": "subtitle", "time": 2930.343, "timestamp": "00:48:50", "text": "谐振器，但同时也是"}, {"type": "subtitle", "time": 2931.589, "timestamp": "00:48:51", "text": "防御机制。"}, {"type": "subtitle", "time": 2934.109, "timestamp": "00:48:54", "text": "他们可以"}, {"type": "subtitle", "time": 2935.242, "timestamp": "00:48:55", "text": "保护我，而不是"}, {"type": "subtitle", "time": 2936.469, "timestamp": "00:48:56", "text": "触摸水晶。"}, {"type": "subtitle", "time": 2938.947, "timestamp": "00:48:58", "text": "所以，还有晶体。"}]
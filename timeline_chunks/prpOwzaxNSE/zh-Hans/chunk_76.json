[{"type": "subtitle", "time": 4563.197, "timestamp": "01:16:03", "text": "夏威夷果冰淇淋，就是它！"}, {"type": "subtitle", "time": 4569.423, "timestamp": "01:16:09", "text": "是的。你好，Shi。"}, {"type": "subtitle", "time": 4570.634, "timestamp": "01:16:10", "text": "欢迎。"}, {"type": "subtitle", "time": 4574.707, "timestamp": "01:16:14", "text": "问候。问候。"}, {"type": "subtitle", "time": 4576.442, "timestamp": "01:16:16", "text": "问候。亲切的问候"}, {"type": "subtitle", "time": 4579.825, "timestamp": "01:16:19", "text": "请。不要付钱。"}, {"type": "subtitle", "time": 4581.36, "timestamp": "01:16:21", "text": "请注意这一点。我只是"}, {"type": "subtitle", "time": 4584.515, "timestamp": "01:16:24", "text": "喝了水。还，"}, {"type": "subtitle", "time": 4585.977, "timestamp": "01:16:25", "text": "我想要的东西"}, {"type": "subtitle", "time": 4587.219, "timestamp": "01:16:27", "text": "要说的是，自从我"}, {"type": "subtitle", "time": 4588.645, "timestamp": "01:16:28", "text": "来到日本时"}, {"type": "subtitle", "time": 4589.997, "timestamp": "01:16:29", "text": "在动画里，我看到了这个"}, {"type": "subtitle", "time": 4591.02, "timestamp": "01:16:31", "text": "仅在动漫中出现，"}, {"type": "subtitle", "time": 4592.481, "timestamp": "01:16:32", "text": "例如，抱怨"}, {"type": "subtitle", "time": 4593.724, "timestamp": "01:16:33", "text": "肚子等等，奇怪"}, {"type": "subtitle", "time": 4594.747, "timestamp": "01:16:34", "text": "来自声音和更多内容"}, {"type": "subtitle", "time": 4600.213, "timestamp": "01:16:40", "text": "凭空而来。我可以"}, {"type": "subtitle", "time": 4603.401, "timestamp": "01:16:43", "text": "也就是说，我"}, {"type": "subtitle", "time": 4608.184, "timestamp": "01:16:48", "text": "学会了给予"}, {"type": "subtitle", "time": 4609.456, "timestamp": "01:16:49", "text": "不同的声音取决于"}, {"type": "subtitle", "time": 4610.796, "timestamp": "01:16:50", "text": "从我所拥有的量来看"}, {"type": "subtitle", "time": 4613.676, "timestamp": "01:16:53", "text": "饥饿等等。哦，上帝"}, {"type": "subtitle", "time": 4616.275, "timestamp": "01:16:56", "text": "我哥哥。没错。"}]
[{"type": "subtitle", "time": 1743.844, "timestamp": "00:29:03", "text": "多年来。所以，就这样， 这位新运动员和"}, {"type": "subtitle", "time": 1745.259, "timestamp": "00:29:05", "text": "这位新运动员和 这新的开始"}, {"type": "subtitle", "time": 1746.426, "timestamp": "00:29:06", "text": "这新的开始 旅行，我终于"}, {"type": "subtitle", "time": 1747.7, "timestamp": "00:29:07", "text": "旅行，我终于 我可以拿一支笔，"}, {"type": "subtitle", "time": 1748.903, "timestamp": "00:29:08", "text": "我可以拿一支笔， 回答：是的，我"}, {"type": "subtitle", "time": 1749.858, "timestamp": "00:29:09", "text": "回答：是的，我 我要展示"}, {"type": "subtitle", "time": 1751.061, "timestamp": "00:29:11", "text": "我要展示 你的创造力"}, {"type": "subtitle", "time": 1752.37, "timestamp": "00:29:12", "text": "你的创造力 我讲述的故事"}, {"type": "subtitle", "time": 1753.608, "timestamp": "00:29:13", "text": "我讲述的故事 我想描绘，而且"}, {"type": "subtitle", "time": 1754.74, "timestamp": "00:29:14", "text": "我想描绘，而且 给你们，"}, {"type": "subtitle", "time": 1755.837, "timestamp": "00:29:15", "text": "给你们， 去感受它等等。因此，"}, {"type": "subtitle", "time": 1766.297, "timestamp": "00:29:26", "text": "呃，还有，你听到了吗？"}, {"type": "subtitle", "time": 1767.704, "timestamp": "00:29:27", "text": "是否有背景噪音？"}, {"type": "subtitle", "time": 1769.28, "timestamp": "00:29:29", "text": "我希望不是。"}, {"type": "subtitle", "time": 1771.909, "timestamp": "00:29:31", "text": "我想我把它关掉了。"}, {"type": "subtitle", "time": 1773.205, "timestamp": "00:29:33", "text": "麦克风，所以不是。"}, {"type": "subtitle", "time": 1774.502, "timestamp": "00:29:34", "text": "如此清晰可闻，但给予"}, {"type": "subtitle", "time": 1779.362, "timestamp": "00:29:39", "text": "我想知道。主，"}, {"type": "subtitle", "time": 1783.336, "timestamp": "00:29:43", "text": "让我来做。但"}, {"type": "subtitle", "time": 1784.557, "timestamp": "00:29:44", "text": "是的，是类似的耳鼻喉科疾病。"}, {"type": "subtitle", "time": 1785.917, "timestamp": "00:29:45", "text": "记住我"}, {"type": "subtitle", "time": 1787.071, "timestamp": "00:29:47", "text": "我之前看过，呃，"}, {"type": "subtitle", "time": 1787.972, "timestamp": "00:29:47", "text": "例如，在"}, {"type": "subtitle", "time": 1789.162, "timestamp": "00:29:49", "text": "首发幻灯片。"}, {"type": "subtitle", "time": 1791.019, "timestamp": "00:29:51", "text": "想象一下我……"}, {"type": "subtitle", "time": 1797.911, "timestamp": "00:29:57", "text": "普罗格特，是的，就这些了。"}, {"type": "subtitle", "time": 1798.857, "timestamp": "00:29:58", "text": "将会揭晓"}]
[{"type": "subtitle", "time": 6071.964, "timestamp": "01:41:11", "text": "一切都很好。当然。"}, {"type": "subtitle", "time": 6096.342, "timestamp": "01:41:36", "text": "我认为有很多。"}, {"type": "subtitle", "time": 6097.768, "timestamp": "01:41:37", "text": "探索游戏。"}, {"type": "subtitle", "time": 6099.255, "timestamp": "01:41:39", "text": "然后，但是我"}, {"type": "subtitle", "time": 6102.86, "timestamp": "01:41:42", "text": "不活跃。时间不足"}, {"type": "subtitle", "time": 6104.232, "timestamp": "01:41:44", "text": "太大了。"}, {"type": "subtitle", "time": 6109.171, "timestamp": "01:41:49", "text": "你好，Kiko。亲切的问候"}, {"type": "subtitle", "time": 6112.172, "timestamp": "01:41:52", "text": "请。哦，对，你也一样。"}, {"type": "subtitle", "time": 6113.438, "timestamp": "01:41:53", "text": "在 Twitch 上。谢谢。"}, {"type": "subtitle", "time": 6114.074, "timestamp": "01:41:54", "text": "完美。"}]
[{"type": "subtitle", "time": 3963.217, "timestamp": "01:06:03", "text": "下一點，呃… 我喜歡7-Eleven和Mini Stop。"}, {"type": "subtitle", "time": 3964.887, "timestamp": "01:06:04", "text": "我喜歡7-Eleven和Mini Stop。 以及所有這些事情"}, {"type": "subtitle", "time": 3966.097, "timestamp": "01:06:06", "text": "以及所有這些事情 商店。非常"}, {"type": "subtitle", "time": 3971.925, "timestamp": "01:06:11", "text": "商店。非常 方便，呃，如果"}, {"type": "subtitle", "time": 3973.423, "timestamp": "01:06:13", "text": "方便，呃，如果 說實話，呃，這是什麼？"}, {"type": "subtitle", "time": 3978.795, "timestamp": "01:06:18", "text": "說實話，呃，這是什麼？ 像這樣？究竟從哪裡來"}, {"type": "subtitle", "time": 3984.823, "timestamp": "01:06:24", "text": "像這樣？究竟從哪裡來 喬克了解印第安納州"}, {"type": "subtitle", "time": 3986.294, "timestamp": "01:06:26", "text": "喬克了解印第安納州 瑪吉？喬先生——"}, {"type": "subtitle", "time": 3988.184, "timestamp": "01:06:28", "text": "瑪吉？喬先生—— 這是世界忍者。"}, {"type": "subtitle", "time": 3998.338, "timestamp": "01:06:38", "text": "我今天吃了美極泡麵。"}, {"type": "subtitle", "time": 4004.835, "timestamp": "01:06:44", "text": "感覺像回家一樣。我"}, {"type": "subtitle", "time": 4008.494, "timestamp": "01:06:48", "text": "我想念印第安納州，我"}, {"type": "subtitle", "time": 4009.793, "timestamp": "01:06:49", "text": "曾經吃過牛肉"}, {"type": "subtitle", "time": 4011.288, "timestamp": "01:06:51", "text": "咖哩，牛肉咖哩"}, {"type": "subtitle", "time": 4012.507, "timestamp": "01:06:52", "text": "帶著玫瑰，純粹 印度烤餅等等。"}, {"type": "subtitle", "time": 4019.814, "timestamp": "01:06:59", "text": "太多了，"}]
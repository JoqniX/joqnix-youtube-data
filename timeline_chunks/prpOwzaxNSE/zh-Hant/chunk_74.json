[{"type": "subtitle", "time": 4440.072, "timestamp": "01:14:00", "text": "愚蠢，尤其是不愚蠢"}, {"type": "subtitle", "time": 4441.372, "timestamp": "01:14:01", "text": "你甚至可以收聽"}, {"type": "subtitle", "time": 4442.638, "timestamp": "01:14:02", "text": "耳機、音樂和"}, {"type": "subtitle", "time": 4444.821, "timestamp": "01:14:04", "text": "騎。規則的由來"}, {"type": "subtitle", "time": 4445.896, "timestamp": "01:14:05", "text": "關於自行車"}, {"type": "subtitle", "time": 4447.266, "timestamp": "01:14:07", "text": "這麼嚴格嗎？就像"}, {"type": "subtitle", "time": 4448.698, "timestamp": "01:14:08", "text": "自己的車或其他什麼"}, {"type": "subtitle", "time": 4453.297, "timestamp": "01:14:13", "text": "像這樣。並獲得"}, {"type": "subtitle", "time": 4454.501, "timestamp": "01:14:14", "text": "駕駛執照，我"}, {"type": "subtitle", "time": 4455.882, "timestamp": "01:14:15", "text": "我聽說在日本，如果"}, {"type": "subtitle", "time": 4457.086, "timestamp": "01:14:17", "text": "你是司機，獲取"}, {"type": "subtitle", "time": 4458.148, "timestamp": "01:14:18", "text": "駕照"}, {"type": "subtitle", "time": 4462.473, "timestamp": "01:14:22", "text": "難的。我聽說了。"}, {"type": "subtitle", "time": 4463.799, "timestamp": "01:14:23", "text": "最難的考試"}, {"type": "subtitle", "time": 4464.602, "timestamp": "01:14:24", "text": "在日本——這"}, {"type": "subtitle", "time": 4465.685, "timestamp": "01:14:25", "text": "駕照，"}, {"type": "subtitle", "time": 4466.906, "timestamp": "01:14:26", "text": "理論考試"}, {"type": "subtitle", "time": 4468.661, "timestamp": "01:14:28", "text": "實際的。我認為"}, {"type": "subtitle", "time": 4469.949, "timestamp": "01:14:29", "text": "你們可以做到這一點"}, {"type": "subtitle", "time": 4471.379, "timestamp": "01:14:31", "text": "可以使用，但是"}, {"type": "subtitle", "time": 4474.236, "timestamp": "01:14:34", "text": "理論上的。那裡"}, {"type": "subtitle", "time": 4475.192, "timestamp": "01:14:35", "text": "他們付出了很多"}, {"type": "subtitle", "time": 4476.179, "timestamp": "01:14:36", "text": "複雜 簡單"}, {"type": "subtitle", "time": 4477.104, "timestamp": "01:14:37", "text": "問題，但是"}, {"type": "subtitle", "time": 4478.308, "timestamp": "01:14:38", "text": "錯綜複雜。"}, {"type": "subtitle", "time": 4482.84, "timestamp": "01:14:42", "text": "呃，你應該"}, {"type": "subtitle", "time": 4484.152, "timestamp": "01:14:44", "text": "認真對待物理學，"}, {"type": "subtitle", "time": 4484.841, "timestamp": "01:14:44", "text": "正確的"}, {"type": "subtitle", "time": 4486.12, "timestamp": "01:14:46", "text": "種族的形成，"}, {"type": "subtitle", "time": 4487.432, "timestamp": "01:14:47", "text": "例如，你應該"}, {"type": "subtitle", "time": 4490.762, "timestamp": "01:14:50", "text": "好好思考等等。"}, {"type": "subtitle", "time": 4493.272, "timestamp": "01:14:53", "text": "例如N3或/N2N1日語能力考試，"}, {"type": "subtitle", "time": 4497.524, "timestamp": "01:14:57", "text": "那，那……你是怎麼做到的？"}, {"type": "subtitle", "time": 4498.82, "timestamp": "01:14:58", "text": "你稱之為書面"}]
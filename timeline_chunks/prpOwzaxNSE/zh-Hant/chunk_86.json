[{"type": "subtitle", "time": 5166.641, "timestamp": "01:26:06", "text": "等等。是的，還有，嗯，我。"}, {"type": "subtitle", "time": 5168.336, "timestamp": "01:26:08", "text": "我不知道發生了什麼事"}, {"type": "subtitle", "time": 5195.107, "timestamp": "01:26:35", "text": "我的電腦。你好嗎？"}, {"type": "subtitle", "time": 5196.626, "timestamp": "01:26:36", "text": "日本車？是的，"}, {"type": "subtitle", "time": 5211.015, "timestamp": "01:26:51", "text": "我們挺過來了。作為"}]
[{"type": "subtitle", "time": 4500.414, "timestamp": "01:15:00", "text": "文件?不，"}, {"type": "subtitle", "time": 4501.712, "timestamp": "01:15:01", "text": "寫……你是怎麼做到的？"}, {"type": "subtitle", "time": 4503.046, "timestamp": "01:15:03", "text": "你能想到的，文檔"}, {"type": "subtitle", "time": 4504.236, "timestamp": "01:15:04", "text": "用於閱讀，其中這些"}, {"type": "subtitle", "time": 4507.899, "timestamp": "01:15:07", "text": "問題……這些在哪裡？"}, {"type": "subtitle", "time": 4508.706, "timestamp": "01:15:08", "text": "問題如下"}, {"type": "subtitle", "time": 4509.513, "timestamp": "01:15:09", "text": "困惑和"}, {"type": "subtitle", "time": 4511.099, "timestamp": "01:15:11", "text": "扭曲的。你"}, {"type": "subtitle", "time": 4512.445, "timestamp": "01:15:12", "text": "應該是這樣的… 呃，他們……他們就是這樣。"}, {"type": "subtitle", "time": 4513.657, "timestamp": "01:15:13", "text": "呃，他們……他們就是這樣。 在這方面，他們很聰明。你"}, {"type": "subtitle", "time": 4515.472, "timestamp": "01:15:15", "text": "在這方面，他們很聰明。你 是的，需要。"}, {"type": "subtitle", "time": 4516.304, "timestamp": "01:15:16", "text": "是的，需要。 選擇合適的"}, {"type": "subtitle", "time": 4517.455, "timestamp": "01:15:17", "text": "選擇合適的 版本。我感到憂鬱。"}, {"type": "subtitle", "time": 4519.666, "timestamp": "01:15:19", "text": "版本。我感到憂鬱。 透過教育"}, {"type": "subtitle", "time": 4520.438, "timestamp": "01:15:20", "text": "透過教育 用英語"}, {"type": "subtitle", "time": 4521.628, "timestamp": "01:15:21", "text": "用英語 日本。幾乎我們所有人"}, {"type": "subtitle", "time": 4522.794, "timestamp": "01:15:22", "text": "日本。幾乎我們所有人 我們可以閱讀和"}, {"type": "subtitle", "time": 4523.667, "timestamp": "01:15:23", "text": "我們可以閱讀和 請用英文寫作。"}, {"type": "subtitle", "time": 4524.709, "timestamp": "01:15:24", "text": "請用英文寫作。 但很難開口說話。"}, {"type": "subtitle", "time": 4525.807, "timestamp": "01:15:25", "text": "但很難開口說話。 聽著，因為我們有"}, {"type": "subtitle", "time": 4526.821, "timestamp": "01:15:26", "text": "聽著，因為我們有 教育程度不足"}, {"type": "subtitle", "time": 4527.835, "timestamp": "01:15:27", "text": "教育程度不足 為了這。我們"}, {"type": "subtitle", "time": 4528.679, "timestamp": "01:15:28", "text": "為了這。我們 這種情況需要改變。"}, {"type": "subtitle", "time": 4542.975, "timestamp": "01:15:42", "text": "所以日本人，嗯，"}, {"type": "subtitle", "time": 4543.746, "timestamp": "01:15:43", "text": "當他們說"}, {"type": "subtitle", "time": 4544.832, "timestamp": "01:15:44", "text": "用英語來說，是的。"}, {"type": "subtitle", "time": 4546.164, "timestamp": "01:15:46", "text": "聽別人怎麼說並不有趣。"}, {"type": "subtitle", "time": 4547.075, "timestamp": "01:15:47", "text": "他們說話"}, {"type": "subtitle", "time": 4548.022, "timestamp": "01:15:48", "text": "用英語，"}, {"type": "subtitle", "time": 4549.108, "timestamp": "01:15:49", "text": "口音等等"}, {"type": "subtitle", "time": 4557.926, "timestamp": "01:15:57", "text": "對其他人來說。嗯，番茄"}]
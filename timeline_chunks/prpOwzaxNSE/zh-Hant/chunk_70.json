[{"type": "subtitle", "time": 4202.346, "timestamp": "01:10:02", "text": "差不多就是這樣。所以，就這樣，"}, {"type": "subtitle", "time": 4207.263, "timestamp": "01:10:07", "text": "這是正確的。所以，這是"}, {"type": "subtitle", "time": 4209.939, "timestamp": "01:10:09", "text": "這是眾所周知的事。還有什麼呢？ ？嗯，還有一件事，我"}, {"type": "subtitle", "time": 4228.763, "timestamp": "01:10:28", "text": "？嗯，還有一件事，我 我想要詳細信息"}, {"type": "subtitle", "time": 4229.639, "timestamp": "01:10:29", "text": "我想要詳細信息 了解你的"}, {"type": "subtitle", "time": 4230.818, "timestamp": "01:10:30", "text": "了解你的 國家。你想要"}, {"type": "subtitle", "time": 4233.702, "timestamp": "01:10:33", "text": "國家。你想要 了解印度嗎？"}, {"type": "subtitle", "time": 4239.447, "timestamp": "01:10:39", "text": "不，等等。瑜伽士。"}, {"type": "subtitle", "time": 4249.395, "timestamp": "01:10:49", "text": "瑜伽士。你是日本人嗎？我"}, {"type": "subtitle", "time": 4250.803, "timestamp": "01:10:50", "text": "我心想，等等，"}, {"type": "subtitle", "time": 4252.015, "timestamp": "01:10:52", "text": "如果我沒記錯的話"}, {"type": "subtitle", "time": 4253.501, "timestamp": "01:10:53", "text": "我記得，呃，你跟我說過。"}, {"type": "subtitle", "time": 4254.284, "timestamp": "01:10:54", "text": "他們說了什麼？"}]
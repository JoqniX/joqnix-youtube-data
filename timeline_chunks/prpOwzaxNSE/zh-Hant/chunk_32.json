[{"type": "subtitle", "time": 1926.924, "timestamp": "00:32:06", "text": "版本。是的，就是這樣。"}, {"type": "subtitle", "time": 1933.008, "timestamp": "00:32:13", "text": "確實如此。很快，呃，"}, {"type": "subtitle", "time": 1934.499, "timestamp": "00:32:14", "text": "關於這一點，對於那些…"}, {"type": "subtitle", "time": 1940.376, "timestamp": "00:32:20", "text": "他已經關注我很久了。 你知道我有什麼嗎？"}, {"type": "subtitle", "time": 1941.694, "timestamp": "00:32:21", "text": "你知道我有什麼嗎？ 還有其他角色，"}, {"type": "subtitle", "time": 1950.041, "timestamp": "00:32:30", "text": "還有其他一些人"}, {"type": "subtitle", "time": 1951.389, "timestamp": "00:32:31", "text": "關於人物"}, {"type": "subtitle", "time": 1952.632, "timestamp": "00:32:32", "text": "公眾不詳。"}, {"type": "subtitle", "time": 1956.634, "timestamp": "00:32:36", "text": "在我看來，在"}, {"type": "subtitle", "time": 1958.187, "timestamp": "00:32:38", "text": "那一刻，我，呃，知道了。 ， 它似乎，"}, {"type": "subtitle", "time": 1958.963, "timestamp": "00:32:38", "text": "， 它似乎， 項目已存檔"}, {"type": "subtitle", "time": 1960.361, "timestamp": "00:32:40", "text": "項目已存檔 是奧尼克西亞（Onexia）吧？為了"}, {"type": "chat", "time": 1962.561, "timestamp": "00:32:42", "author": "@Kenn_D_Bush", "avatar": "https://yt4.ggpht.com/_Komo_VEKSz-e7kb-dTpjPDPdwLBWdimZXGs-iY-B0gcs1aY-MXI_lQXH90AN623vf5ag2FRRA=s64-c-k-c0x00ffffff-no-rj", "message": "I do saw a few characters once i thunk"}, {"type": "subtitle", "time": 1965.487, "timestamp": "00:32:45", "text": "是奧尼克西亞（Onexia）吧？為了 這很難…"}, {"type": "subtitle", "time": 1966.516, "timestamp": "00:32:46", "text": "這很難… 難以集中註意力"}, {"type": "subtitle", "time": 1967.711, "timestamp": "00:32:47", "text": "難以集中註意力 並優先考慮"}, {"type": "subtitle", "time": 1968.938, "timestamp": "00:32:48", "text": "並優先考慮 致奧內克西亞的角色們，e"}, {"type": "subtitle", "time": 1970.233, "timestamp": "00:32:50", "text": "致奧內克西亞的角色們，e ——嗯，在那一刻，因為我"}, {"type": "subtitle", "time": 1971.527, "timestamp": "00:32:51", "text": "——嗯，在那一刻，因為我 我以為我已經"}, {"type": "subtitle", "time": 1972.323, "timestamp": "00:32:52", "text": "我以為我已經  第一的"}, {"type": "subtitle", "time": 1972.887, "timestamp": "00:32:52", "text": "第一的 專注於"}, {"type": "subtitle", "time": 1973.883, "timestamp": "00:32:53", "text": "專注於 開玩笑，然後證明給你看"}, {"type": "subtitle", "time": 1975.21, "timestamp": "00:32:55", "text": "開玩笑，然後證明給你看 以至於他"}, {"type": "subtitle", "time": 1976.305, "timestamp": "00:32:56", "text": "以至於他 相當穩定"}, {"type": "subtitle", "time": 1977.599, "timestamp": "00:32:57", "text": "相當穩定 這樣我就可以拿走"}]
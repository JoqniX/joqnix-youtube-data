[{"type": "subtitle", "time": 4744.886, "timestamp": "01:19:04", "text": "你試過可樂 有冰箱嗎？什麼？"}, {"type": "subtitle", "time": 4746.504, "timestamp": "01:19:06", "text": "有冰箱嗎？什麼？ 不，我還沒試過。我不是"}, {"type": "subtitle", "time": 4756.94, "timestamp": "01:19:16", "text": "不，我還沒試過。我不是 我知道這件事。嗯，是的。"}, {"type": "subtitle", "time": 4760.423, "timestamp": "01:19:20", "text": "我知道這件事。嗯，是的。 這就是我所知道的。"}, {"type": "subtitle", "time": 4763.063, "timestamp": "01:19:23", "text": "這就是我所知道的。 日本人看到的是10萬日元，"}, {"type": "subtitle", "time": 4770.279, "timestamp": "01:19:30", "text": "呃，1000日元，就像"}, {"type": "subtitle", "time": 4771.81, "timestamp": "01:19:31", "text": "我們來自印度，看到了100"}, {"type": "subtitle", "time": 4774.655, "timestamp": "01:19:34", "text": "盧比之類的貨幣。我"}, {"type": "subtitle", "time": 4776.008, "timestamp": "01:19:36", "text": "我的意思是，所有的一切"}, {"type": "subtitle", "time": 4777.099, "timestamp": "01:19:37", "text": "等於100盧比"}, {"type": "subtitle", "time": 4779.428, "timestamp": "01:19:39", "text": "很多，你明白嗎？它"}, {"type": "subtitle", "time": 4784.139, "timestamp": "01:19:44", "text": "很多，真的很多。是的 我知道，對於"}, {"type": "subtitle", "time": 4785.152, "timestamp": "01:19:45", "text": "我知道，對於 正常人100"}, {"type": "subtitle", "time": 4786.503, "timestamp": "01:19:46", "text": "正常人100 沒什麼大不了的；這是為了保持"}, {"type": "subtitle", "time": 4787.967, "timestamp": "01:19:47", "text": "沒什麼大不了的；這是為了保持 。但就像地毯一樣，我包羅萬象"}, {"type": "subtitle", "time": 4795.466, "timestamp": "01:19:55", "text": "。但就像地毯一樣，我包羅萬象 雖然我還沒習慣。"}, {"type": "subtitle", "time": 4796.982, "timestamp": "01:19:56", "text": "雖然我還沒習慣。 對日本人來說，呃，"}, {"type": "subtitle", "time": 4798.293, "timestamp": "01:19:58", "text": "對日本人來說，呃， 貨幣體系，一切"}, {"type": "subtitle", "time": 4799.931, "timestamp": "01:19:59", "text": "貨幣體系，一切 仍在我的印度"}]
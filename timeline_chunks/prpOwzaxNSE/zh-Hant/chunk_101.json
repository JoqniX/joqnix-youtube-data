[{"type": "subtitle", "time": 6071.964, "timestamp": "01:41:11", "text": "一切都很好。當然。"}, {"type": "subtitle", "time": 6096.342, "timestamp": "01:41:36", "text": "我認為有很多。"}, {"type": "subtitle", "time": 6097.768, "timestamp": "01:41:37", "text": "探索遊戲。"}, {"type": "subtitle", "time": 6099.255, "timestamp": "01:41:39", "text": "然後，但是我"}, {"type": "subtitle", "time": 6102.86, "timestamp": "01:41:42", "text": "不活躍。時間不足"}, {"type": "subtitle", "time": 6104.232, "timestamp": "01:41:44", "text": "太大了。"}, {"type": "subtitle", "time": 6109.171, "timestamp": "01:41:49", "text": "你好，Kiko。親切的問候"}, {"type": "subtitle", "time": 6112.172, "timestamp": "01:41:52", "text": "請。哦，對，你也一樣。"}, {"type": "subtitle", "time": 6113.438, "timestamp": "01:41:53", "text": "在 Twitch 上。謝謝。"}, {"type": "subtitle", "time": 6114.074, "timestamp": "01:41:54", "text": "完美。"}]
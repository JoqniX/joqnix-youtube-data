[{"type": "subtitle", "time": 1565.447, "timestamp": "00:26:05", "text": "說？呃，這麼說吧，"}, {"type": "subtitle", "time": 1566.823, "timestamp": "00:26:06", "text": "你去寺廟，"}, {"type": "subtitle", "time": 1568.356, "timestamp": "00:26:08", "text": "你想寫自己的版本嗎？"}, {"type": "subtitle", "time": 1569.89, "timestamp": "00:26:09", "text": "七夕的願望"}, {"type": "subtitle", "time": 1571.227, "timestamp": "00:26:11", "text": "群星盛會，以及"}, {"type": "subtitle", "time": 1572.642, "timestamp": "00:26:12", "text": "七夕紙，呃，"}, {"type": "subtitle", "time": 1574.136, "timestamp": "00:26:14", "text": "紙張，呃，榻榻米，哦"}, {"type": "subtitle", "time": 1575.512, "timestamp": "00:26:15", "text": "不，不是榻榻米，像這樣的"}, {"type": "subtitle", "time": 1578.666, "timestamp": "00:26:18", "text": "它叫什麼名字？呃，那怎麼樣？"}, {"type": "subtitle", "time": 1584.271, "timestamp": "00:26:24", "text": "又打電話來了？嗯哼 它叫什麼名字？嗯哼"}, {"type": "subtitle", "time": 1587.722, "timestamp": "00:26:27", "text": "它叫什麼名字？嗯哼 丹坂田中。呃，"}, {"type": "subtitle", "time": 1591.177, "timestamp": "00:26:31", "text": "丹坂田中。呃， 他們中的大多數"}, {"type": "subtitle", "time": 1592.359, "timestamp": "00:26:32", "text": "他們中的大多數 普通的。而且還有一個"}, {"type": "subtitle", "time": 1595.254, "timestamp": "00:26:35", "text": "普通的。而且還有一個 特別的一件"}, {"type": "subtitle", "time": 1596.537, "timestamp": "00:26:36", "text": "特別的一件 南札古，還有這個"}, {"type": "subtitle", "time": 1597.392, "timestamp": "00:26:37", "text": "南札古，還有這個 稀有性。這真是"}, {"type": "subtitle", "time": 1601.055, "timestamp": "00:26:41", "text": "稀有性。這真是 稀有性。而當"}, {"type": "subtitle", "time": 1605.325, "timestamp": "00:26:45", "text": "稀有性。而當 有人做到了。"}, {"type": "subtitle", "time": 1606.655, "timestamp": "00:26:46", "text": "有人做到了。 呃，你自己寫吧"}, {"type": "subtitle", "time": 1607.81, "timestamp": "00:26:47", "text": "呃，你自己寫吧 慾望，僅此而已。"}, {"type": "subtitle", "time": 1609.14, "timestamp": "00:26:49", "text": "慾望，僅此而已。 沒錯，一個願望"}, {"type": "subtitle", "time": 1610.33, "timestamp": "00:26:50", "text": "沒錯，一個願望 那不是某種東西"}]
[{"type": "subtitle", "time": 4920.563, "timestamp": "01:22:00", "text": "我從…攝取糖分"}, {"type": "subtitle", "time": 4921.874, "timestamp": "01:22:01", "text": "咖啡隔間。"}, {"type": "subtitle", "time": 4926.099, "timestamp": "01:22:06", "text": "我把它放下的時候"}, {"type": "subtitle", "time": 4927.56, "timestamp": "01:22:07", "text": "掃描條碼"}, {"type": "subtitle", "time": 4928.947, "timestamp": "01:22:08", "text": "嗯，掃描條碼"}, {"type": "subtitle", "time": 4934.184, "timestamp": "01:22:14", "text": "用於製作冰沙。嗯，然後我 嗯，我要脫掉上衣了。"}, {"type": "subtitle", "time": 4935.69, "timestamp": "01:22:15", "text": "嗯，我要脫掉上衣了。 是蓋子，對吧？我有點睏了。"}, {"type": "subtitle", "time": 4941.431, "timestamp": "01:22:21", "text": "是蓋子，對吧？我有點睏了。 糖，嗯，袋裝的"}, {"type": "subtitle", "time": 4942.967, "timestamp": "01:22:22", "text": "糖，嗯，袋裝的 然後，如果我想要"}, {"type": "subtitle", "time": 4944.346, "timestamp": "01:22:24", "text": "然後，如果我想要 牛奶，我也放了"}, {"type": "subtitle", "time": 4945.725, "timestamp": "01:22:25", "text": "牛奶，我也放了 牛奶。我不知道。"}, {"type": "subtitle", "time": 4952.518, "timestamp": "01:22:32", "text": "類似口香糖的東西"}, {"type": "subtitle", "time": 4953.861, "timestamp": "01:22:33", "text": "呃，還有一件額外的事"}, {"type": "subtitle", "time": 4955.169, "timestamp": "01:22:35", "text": "咖啡隔間，"}, {"type": "subtitle", "time": 4956.305, "timestamp": "01:22:36", "text": "然後我把它放進去了"}, {"type": "subtitle", "time": 4958.372, "timestamp": "01:22:38", "text": "混合器。我試過了。"}, {"type": "subtitle", "time": 4959.756, "timestamp": "01:22:39", "text": "順便說一句，味道不錯。"}, {"type": "subtitle", "time": 4960.763, "timestamp": "01:22:40", "text": "真的很好吃。"}, {"type": "subtitle", "time": 4962.974, "timestamp": "01:22:42", "text": "朋友你好。作為"}, {"type": "subtitle", "time": 4965.858, "timestamp": "01:22:45", "text": "婚外情？豬肉可樂"}, {"type": "subtitle", "time": 4967.478, "timestamp": "01:22:47", "text": "帶冰箱。所以"}, {"type": "subtitle", "time": 4968.577, "timestamp": "01:22:48", "text": "我必須這麼做。"}, {"type": "subtitle", "time": 4971.126, "timestamp": "01:22:51", "text": "核實。我會嘗試。 。哦，那好的那些呢？"}, {"type": "subtitle", "time": 4977.593, "timestamp": "01:22:57", "text": "。哦，那好的那些呢？ 以及缺點"}, {"type": "subtitle", "time": 4978.817, "timestamp": "01:22:58", "text": "以及缺點 日本？東京的情況如何？"}]
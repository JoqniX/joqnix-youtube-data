[{"type": "subtitle", "time": 1020.222, "timestamp": "00:17:00", "text": "另一個突然"}, {"type": "subtitle", "time": 1025.21, "timestamp": "00:17:05", "text": "改變了。嗯，還有為了"}, {"type": "subtitle", "time": 1026.398, "timestamp": "00:17:06", "text": "這對我來說太好了。"}, {"type": "subtitle", "time": 1027.255, "timestamp": "00:17:07", "text": "震驚之時"}, {"type": "subtitle", "time": 1028.476, "timestamp": "00:17:08", "text": "他們說這不是"}, {"type": "chat", "time": 1032.097, "timestamp": "00:17:12", "author": "@MikazukiYure", "avatar": "https://yt4.ggpht.com/uuFSD7qVrZy0JUWrBRfSfEKIQpib7_2xP24Yiu1ND1Mq6uhaYIHDnA5EiGz_o33FUhHYvbCT9g=s64-c-k-c0x00ffffff-no-rj", "message": "Hi hi~"}, {"type": "chat", "time": 1032.541, "timestamp": "00:17:12", "author": "@astravt", "avatar": "https://yt4.ggpht.com/MdOwC7qdh0gmlabcCYgLQ5BOZxo7CGLbc14xFv1rO9eQ745gkga99YKsszwMjcyNnEBittX8WA=s64-c-k-c0x00ffffff-no-rj", "message": "Can u grant me a wish?"}, {"type": "subtitle", "time": 1032.733, "timestamp": "00:17:12", "text": "將會發生。嗯，這就是我的原因。"}, {"type": "subtitle", "time": 1036.641, "timestamp": "00:17:16", "text": "心想：“哇，好痛。”"}, {"type": "subtitle", "time": 1039.727, "timestamp": "00:17:19", "text": "這真的是…這真的是我"}, {"type": "subtitle", "time": 1040.887, "timestamp": "00:17:20", "text": "這件事真的讓我崩潰了，我"}, {"type": "subtitle", "time": 1042.085, "timestamp": "00:17:22", "text": "心想：「好吧，"}, {"type": "subtitle", "time": 1050.463, "timestamp": "00:17:30", "text": "如果真是這樣，那我並不認同。"}, {"type": "subtitle", "time": 1051.314, "timestamp": "00:17:31", "text": "應該，呃，"}, {"type": "subtitle", "time": 1052.647, "timestamp": "00:17:32", "text": "放棄，因為"}, {"type": "subtitle", "time": 1054.0529999999999, "timestamp": "00:17:34", "text": "這作品，呃，"}, {"type": "subtitle", "time": 1055.423, "timestamp": "00:17:35", "text": "我和那位藝術家，呃"}, {"type": "subtitle", "time": 1056.459, "timestamp": "00:17:36", "text": "貢獻良多"}, {"type": "subtitle", "time": 1057.681, "timestamp": "00:17:37", "text": "投入和時間"}, {"type": "subtitle", "time": 1059.014, "timestamp": "00:17:39", "text": "實現我的想法和"}, {"type": "subtitle", "time": 1060.457, "timestamp": "00:17:40", "text": "夢想成真"}, {"type": "subtitle", "time": 1061.938, "timestamp": "00:17:41", "text": "節目，以及很多…"}, {"type": "subtitle", "time": 1069.805, "timestamp": "00:17:49", "text": "這對我意義非凡。所以"}, {"type": "subtitle", "time": 1071.126, "timestamp": "00:17:51", "text": "我心想，「好吧，我"}, {"type": "subtitle", "time": 1072.307, "timestamp": "00:17:52", "text": "我無法強求。"}, {"type": "subtitle", "time": 1073.6970000000001, "timestamp": "00:17:53", "text": "模型？呃，算了，因為"}, {"type": "subtitle", "time": 1074.809, "timestamp": "00:17:54", "text": "我需要它。"}, {"type": "subtitle", "time": 1075.6779999999999, "timestamp": "00:17:55", "text": "永恆，以至於"}, {"type": "subtitle", "time": 1076.859, "timestamp": "00:17:56", "text": "如果首次亮相"}, {"type": "subtitle", "time": 1078.11, "timestamp": "00:17:58", "text": "我要走了。"}]
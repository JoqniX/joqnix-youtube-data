[{"type": "subtitle", "time": 241.215, "timestamp": "00:04:01", "text": "關於你的計劃，對吧？"}, {"type": "subtitle", "time": 245.701, "timestamp": "00:04:05", "text": "是的？所以，既然"}, {"type": "subtitle", "time": 246.986, "timestamp": "00:04:06", "text": "我的聲音很尷尬。"}, {"type": "subtitle", "time": 248.069, "timestamp": "00:04:08", "text": "我想到一件事。"}, {"type": "subtitle", "time": 249.219, "timestamp": "00:04:09", "text": "比如，「好的，這是"}, {"type": "subtitle", "time": 250.267, "timestamp": "00:04:10", "text": "真漂亮，嗯，這是我的"}, {"type": "subtitle", "time": 250.91, "timestamp": "00:04:10", "text": "獨特的"}, {"type": "subtitle", "time": 252.263, "timestamp": "00:04:12", "text": "“關於你自己的特別之處” 。所以我拿走了它"}, {"type": "subtitle", "time": 257.444, "timestamp": "00:04:17", "text": "。所以我拿走了它 心想：“好吧，那又怎樣？”"}, {"type": "subtitle", "time": 258.822, "timestamp": "00:04:18", "text": "心想：“好吧，那又怎樣？” 我的狀態和外貌如何？"}, {"type": "subtitle", "time": 260.166, "timestamp": "00:04:20", "text": "我的狀態和外貌如何？ 我會把它弄得令人困惑，而且"}, {"type": "subtitle", "time": 261.475, "timestamp": "00:04:21", "text": "我會把它弄得令人困惑，而且 因此我們有了一個新的"}, {"type": "subtitle", "time": 262.75, "timestamp": "00:04:22", "text": "因此我們有了一個新的 運動員」。是的。"}, {"type": "subtitle", "time": 271.156, "timestamp": "00:04:31", "text": "簡而言之，如果"}, {"type": "subtitle", "time": 272.585, "timestamp": "00:04:32", "text": "你看動漫，你"}, {"type": "subtitle", "time": 273.904, "timestamp": "00:04:33", "text": "你可以把它想像成"}, {"type": "subtitle", "time": 276.702, "timestamp": "00:04:36", "text": "史萊姆動漫 《Remaru Tempest》"}, {"type": "chat", "time": 276.838, "timestamp": "00:04:36", "author": "@Kenn_D_Bush", "avatar": "https://yt4.ggpht.com/_Komo_VEKSz-e7kb-dTpjPDPdwLBWdimZXGs-iY-B0gcs1aY-MXI_lQXH90AN623vf5ag2FRRA=s64-c-k-c0x00ffffff-no-rj", "message": "Da new joq"}, {"type": "subtitle", "time": 277.795, "timestamp": "00:04:37", "text": "《Remaru Tempest》 就這樣。是的。是的。"}, {"type": "subtitle", "time": 285.439, "timestamp": "00:04:45", "text": "這是一個可以"}, {"type": "subtitle", "time": 286.593, "timestamp": "00:04:46", "text": "改變形狀，"}, {"type": "subtitle", "time": 288.08299999999997, "timestamp": "00:04:48", "text": "外表和能力……呃—— 呃，是的，它就像一個身體，不是"}, {"type": "subtitle", "time": 289.424, "timestamp": "00:04:49", "text": "呃，是的，它就像一個身體，不是 有性別之類的"}, {"type": "subtitle", "time": 290.765, "timestamp": "00:04:50", "text": "有性別之類的 像這樣，或者，嗯，"}, {"type": "subtitle", "time": 291.733, "timestamp": "00:04:51", "text": "像這樣，或者，嗯， 生殖器之類的東西"}, {"type": "subtitle", "time": 292.999, "timestamp": "00:04:52", "text": "生殖器之類的東西 像這樣。就這樣。"}, {"type": "subtitle", "time": 298.8, "timestamp": "00:04:58", "text": "像這樣。就這樣。 它叫什麼？它"}]
[{"type": "subtitle", "time": 2410.455, "timestamp": "00:40:10", "text": "問候。你好嗎？"}, {"type": "subtitle", "time": 2411.358, "timestamp": "00:40:11", "text": "一天過去了嗎？"}, {"type": "subtitle", "time": 2412.958, "timestamp": "00:40:12", "text": "今天是星期日。"}, {"type": "subtitle", "time": 2418.955, "timestamp": "00:40:18", "text": "展示。很明顯是明天"}, {"type": "subtitle", "time": 2420.439, "timestamp": "00:40:20", "text": "呃，明天，呃，日"}, {"type": "subtitle", "time": 2422.043, "timestamp": "00:40:22", "text": "海軍陸戰隊，日"}, {"type": "subtitle", "time": 2427.557, "timestamp": "00:40:27", "text": "瑪麗昂在日本。呃，"}, {"type": "subtitle", "time": 2429.492, "timestamp": "00:40:29", "text": "7月20日，星期一。"}, {"type": "subtitle", "time": 2432.922, "timestamp": "00:40:32", "text": "它被稱為“日”。"}, {"type": "subtitle", "time": 2434.392, "timestamp": "00:40:34", "text": "海洋、海洋日和"}, {"type": "subtitle", "time": 2438.481, "timestamp": "00:40:38", "text": "今天是公共假日。和"}, {"type": "subtitle", "time": 2439.484, "timestamp": "00:40:39", "text": "這是一個假期"}, {"type": "subtitle", "time": 2443.462, "timestamp": "00:40:43", "text": "已給出。這是一個假期，"}, {"type": "subtitle", "time": 2444.409, "timestamp": "00:40:44", "text": "感謝"}, {"type": "subtitle", "time": 2445.323, "timestamp": "00:40:45", "text": "海洋"}, {"type": "subtitle", "time": 2446.0, "timestamp": "00:40:46", "text": "慷慨和"}, {"type": "subtitle", "time": 2447.252, "timestamp": "00:40:47", "text": "仔細想想"}, {"type": "subtitle", "time": 2452.279, "timestamp": "00:40:52", "text": "重要性。我只是"}, {"type": "subtitle", "time": 2456.651, "timestamp": "00:40:56", "text": "谷歌了一下。好。嗯，"}, {"type": "subtitle", "time": 2457.951, "timestamp": "00:40:57", "text": "是的，這很重要"}]
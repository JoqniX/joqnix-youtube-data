[{"type": "subtitle", "time": 1382.138, "timestamp": "00:23:02", "text": "然後我意識到，"}, {"type": "subtitle", "time": 1383.582, "timestamp": "00:23:03", "text": "然後我意識到"}, {"type": "subtitle", "time": 1389.059, "timestamp": "00:23:09", "text": "好吧，事情就是這樣。但"}, {"type": "subtitle", "time": 1390.17, "timestamp": "00:23:10", "text": "最重要的是我"}, {"type": "subtitle", "time": 1391.702, "timestamp": "00:23:11", "text": "最終，在三年後 得以首次亮相。我"}, {"type": "subtitle", "time": 1395.152, "timestamp": "00:23:15", "text": "得以首次亮相。我 一直想要這個"}, {"type": "subtitle", "time": 1396.409, "timestamp": "00:23:16", "text": "一直想要這個 跳了下去。甚至"}, {"type": "subtitle", "time": 1398.731, "timestamp": "00:23:18", "text": "跳了下去。甚至 如果是"}, {"type": "chat", "time": 1398.792, "timestamp": "00:23:18", "author": "@MikazukiYure", "avatar": "https://yt4.ggpht.com/uuFSD7qVrZy0JUWrBRfSfEKIQpib7_2xP24Yiu1ND1Mq6uhaYIHDnA5EiGz_o33FUhHYvbCT9g=s64-c-k-c0x00ffffff-no-rj", "message": "did you make a mistake? didn't seem like it"}, {"type": "subtitle", "time": 1399.514, "timestamp": "00:23:19", "text": "如果是 C類，甚至"}, {"type": "subtitle", "time": 1400.875, "timestamp": "00:23:20", "text": "C類，甚至 如果是"}, {"type": "subtitle", "time": 1401.658, "timestamp": "00:23:21", "text": "如果是 即興發揮，"}, {"type": "subtitle", "time": 1405.27, "timestamp": "00:23:25", "text": "一半的時間是"}, {"type": "subtitle", "time": 1409.189, "timestamp": "00:23:29", "text": "即興發揮。呃，而且在"}, {"type": "subtitle", "time": 1410.485, "timestamp": "00:23:30", "text": "我的時間比較少。"}, {"type": "subtitle", "time": 1411.748, "timestamp": "00:23:31", "text": "透過培訓"}, {"type": "subtitle", "time": 1412.942, "timestamp": "00:23:32", "text": "考試之類的，"}, {"type": "subtitle", "time": 1414.17, "timestamp": "00:23:34", "text": "但我很高興"}, {"type": "subtitle", "time": 1418.542, "timestamp": "00:23:38", "text": "做到了。而這"}, {"type": "subtitle", "time": 1421.018, "timestamp": "00:23:41", "text": "這很重要，不是嗎？我"}, {"type": "subtitle", "time": 1422.051, "timestamp": "00:23:42", "text": "做不到"}, {"type": "subtitle", "time": 1424.935, "timestamp": "00:23:44", "text": "節目裡有這段。我不能"}, {"type": "subtitle", "time": 1426.095, "timestamp": "00:23:46", "text": "我可以選擇。"}, {"type": "subtitle", "time": 1427.222, "timestamp": "00:23:47", "text": "決定不做"}, {"type": "subtitle", "time": 1428.887, "timestamp": "00:23:48", "text": "這是他的首秀。我可以"}, {"type": "subtitle", "time": 1429.98, "timestamp": "00:23:49", "text": "永遠做出決定"}, {"type": "subtitle", "time": 1431.235, "timestamp": "00:23:51", "text": "放棄這個"}, {"type": "subtitle", "time": 1432.361, "timestamp": "00:23:52", "text": "一位漂亮的模特兒。"}, {"type": "subtitle", "time": 1433.852, "timestamp": "00:23:53", "text": "但我並沒有做這件事。"}, {"type": "subtitle", "time": 1436.935, "timestamp": "00:23:56", "text": "這一點很重要。這就是原因"}, {"type": "subtitle", "time": 1438.03, "timestamp": "00:23:58", "text": "我非常高興"}]
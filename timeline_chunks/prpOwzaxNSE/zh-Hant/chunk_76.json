[{"type": "subtitle", "time": 4563.197, "timestamp": "01:16:03", "text": "澳洲堅果冰淇淋，就是它！"}, {"type": "subtitle", "time": 4569.423, "timestamp": "01:16:09", "text": "是的。你好，Shi。"}, {"type": "subtitle", "time": 4570.634, "timestamp": "01:16:10", "text": "歡迎。"}, {"type": "subtitle", "time": 4574.707, "timestamp": "01:16:14", "text": "問候。問候。"}, {"type": "subtitle", "time": 4576.442, "timestamp": "01:16:16", "text": "問候。親切的問候"}, {"type": "subtitle", "time": 4579.825, "timestamp": "01:16:19", "text": "請。不要付錢。"}, {"type": "subtitle", "time": 4581.36, "timestamp": "01:16:21", "text": "請注意這一點。我只是"}, {"type": "subtitle", "time": 4584.515, "timestamp": "01:16:24", "text": "喝了水。還，"}, {"type": "subtitle", "time": 4585.977, "timestamp": "01:16:25", "text": "我想要的東西"}, {"type": "subtitle", "time": 4587.219, "timestamp": "01:16:27", "text": "要說的是，自從我"}, {"type": "subtitle", "time": 4588.645, "timestamp": "01:16:28", "text": "來到日本時"}, {"type": "subtitle", "time": 4589.997, "timestamp": "01:16:29", "text": "在動畫裡，我看到了這個"}, {"type": "subtitle", "time": 4591.02, "timestamp": "01:16:31", "text": "僅在動漫中出現，"}, {"type": "subtitle", "time": 4592.481, "timestamp": "01:16:32", "text": "例如，抱怨"}, {"type": "subtitle", "time": 4593.724, "timestamp": "01:16:33", "text": "肚子等等，奇怪"}, {"type": "subtitle", "time": 4594.747, "timestamp": "01:16:34", "text": "來自聲音和更多內容"}, {"type": "subtitle", "time": 4600.213, "timestamp": "01:16:40", "text": "憑空而來。我可以"}, {"type": "subtitle", "time": 4603.401, "timestamp": "01:16:43", "text": "也就是說，我"}, {"type": "subtitle", "time": 4608.184, "timestamp": "01:16:48", "text": "學會了給予"}, {"type": "subtitle", "time": 4609.456, "timestamp": "01:16:49", "text": "不同的聲音取決於"}, {"type": "subtitle", "time": 4610.796, "timestamp": "01:16:50", "text": "從我所擁有的量來看"}, {"type": "subtitle", "time": 4613.676, "timestamp": "01:16:53", "text": "飢餓等等。哦，上帝"}, {"type": "subtitle", "time": 4616.275, "timestamp": "01:16:56", "text": "我哥哥。沒錯。"}]
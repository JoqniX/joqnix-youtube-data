[{"type": "subtitle", "time": 2884.465, "timestamp": "00:48:04", "text": "？如果這些晶體 你將被毀滅。"}, {"type": "subtitle", "time": 2885.59, "timestamp": "00:48:05", "text": "你將被毀滅。 你是要死了嗎？"}, {"type": "subtitle", "time": 2886.451, "timestamp": "00:48:06", "text": "你是要死了嗎？ 儲存在這些"}, {"type": "subtitle", "time": 2887.61, "timestamp": "00:48:07", "text": "儲存在這些 晶體？這是關於…"}, {"type": "subtitle", "time": 2891.33, "timestamp": "00:48:11", "text": "晶體？這是關於… 例如你的力量，或者"}, {"type": "subtitle", "time": 2892.503, "timestamp": "00:48:12", "text": "例如你的力量，或者 大概是這樣的"}, {"type": "subtitle", "time": 2893.518, "timestamp": "00:48:13", "text": "大概是這樣的  引領"}, {"type": "subtitle", "time": 2894.437, "timestamp": "00:48:14", "text": "引領 燈或"}, {"type": "subtitle", "time": 2895.325, "timestamp": "00:48:15", "text": "燈或 類似那樣？什麼"}, {"type": "subtitle", "time": 2896.63, "timestamp": "00:48:16", "text": "類似那樣？什麼 它能做到嗎？所以，"}, {"type": "subtitle", "time": 2899.418, "timestamp": "00:48:19", "text": "它能做到嗎？所以， 如果你把這個放在這裡"}, {"type": "subtitle", "time": 2900.71, "timestamp": "00:48:20", "text": "如果你把這個放在這裡 問題是"}, {"type": "subtitle", "time": 2901.729, "timestamp": "00:48:21", "text": "問題是 我考慮過這個問題。"}, {"type": "subtitle", "time": 2907.295, "timestamp": "00:48:27", "text": "我考慮過這個問題。 會說些什麼"}, {"type": "subtitle", "time": 2908.355, "timestamp": "00:48:28", "text": "會說些什麼 比如：是的，不是那樣的。"}, {"type": "subtitle", "time": 2909.697, "timestamp": "00:48:29", "text": "比如：是的，不是那樣的。 你覺得呢？不是這樣的。"}, {"type": "subtitle", "time": 2911.111, "timestamp": "00:48:31", "text": "你覺得呢？不是這樣的。 它太容易壞了。"}, {"type": "subtitle", "time": 2915.267, "timestamp": "00:48:35", "text": "嗯，我的保護"}, {"type": "subtitle", "time": 2919.495, "timestamp": "00:48:39", "text": "機制——這種"}, {"type": "subtitle", "time": 2920.743, "timestamp": "00:48:40", "text": "水晶球"}, {"type": "subtitle", "time": 2921.639, "timestamp": "00:48:41", "text": "旋轉"}, {"type": "subtitle", "time": 2924.26, "timestamp": "00:48:44", "text": "我周圍。他們"}, {"type": "subtitle", "time": 2927.816, "timestamp": "00:48:47", "text": "不僅作為"}, {"type": "subtitle", "time": 2929.097, "timestamp": "00:48:49", "text": "信標、發射器、"}, {"type": "subtitle", "time": 2930.343, "timestamp": "00:48:50", "text": "諧振器，但同時也是"}, {"type": "subtitle", "time": 2931.589, "timestamp": "00:48:51", "text": "防禦機制。"}, {"type": "subtitle", "time": 2934.109, "timestamp": "00:48:54", "text": "他們可以"}, {"type": "subtitle", "time": 2935.242, "timestamp": "00:48:55", "text": "保護我，而不是"}, {"type": "subtitle", "time": 2936.469, "timestamp": "00:48:56", "text": "觸摸水晶。"}, {"type": "subtitle", "time": 2938.947, "timestamp": "00:48:58", "text": "所以，還有晶體。"}]
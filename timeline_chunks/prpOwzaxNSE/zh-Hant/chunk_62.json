[{"type": "subtitle", "time": 3723.016, "timestamp": "01:02:03", "text": "然後，在你的右邊"}, {"type": "subtitle", "time": 3724.306, "timestamp": "01:02:04", "text": "右眼是獅子座的眼睛嗎？"}, {"type": "subtitle", "time": 3728.889, "timestamp": "01:02:08", "text": "是的。是的，那算一個分數。"}, {"type": "subtitle", "time": 3730.031, "timestamp": "01:02:10", "text": "起源，哪個"}, {"type": "subtitle", "time": 3735.909, "timestamp": "01:02:15", "text": "表示我屬於"}, {"type": "subtitle", "time": 3738.281, "timestamp": "01:02:18", "text": "獅子座。我"}, {"type": "subtitle", "time": 3739.716, "timestamp": "01:02:19", "text": "獅子幫的一員。"}, {"type": "subtitle", "time": 3742.637, "timestamp": "01:02:22", "text": "我的胎記，"}, {"type": "subtitle", "time": 3745.457, "timestamp": "01:02:25", "text": "你可以這麼說。所以，"}, {"type": "subtitle", "time": 3750.346, "timestamp": "01:02:30", "text": "呃，你覺得怎麼樣？"}, {"type": "subtitle", "time": 3751.901, "timestamp": "01:02:31", "text": "日本？那裡舒適嗎？"}, {"type": "subtitle", "time": 3752.97, "timestamp": "01:02:32", "text": "或不？請，"}, {"type": "subtitle", "time": 3753.645, "timestamp": "01:02:33", "text": "給我取個名字"}, {"type": "subtitle", "time": 3754.319, "timestamp": "01:02:34", "text": "積極向上"}, {"type": "subtitle", "time": 3755.304, "timestamp": "01:02:35", "text": "負面時刻。"}, {"type": "subtitle", "time": 3756.879, "timestamp": "01:02:36", "text": "好的，問得好。"}, {"type": "subtitle", "time": 3758.95, "timestamp": "01:02:38", "text": "美好的時刻。在 首先，呃，這真美。"}, {"type": "subtitle", "time": 3760.5, "timestamp": "01:02:40", "text": "首先，呃，這真美。 國家。文化，"}, {"type": "subtitle", "time": 3767.161, "timestamp": "01:02:47", "text": "國家。文化， 文化，嗯，是的"}, {"type": "subtitle", "time": 3768.236, "timestamp": "01:02:48", "text": "文化，嗯，是的 環境至關重要"}, {"type": "subtitle", "time": 3769.562, "timestamp": "01:02:49", "text": "環境至關重要 不同，其他一切都不同。"}, {"type": "subtitle", "time": 3770.923, "timestamp": "01:02:50", "text": "不同，其他一切都不同。 與印度相比，"}, {"type": "subtitle", "time": 3772.213, "timestamp": "01:02:52", "text": "與印度相比， 我來自哪裡？我來自哪裡？"}, {"type": "subtitle", "time": 3773.503, "timestamp": "01:02:53", "text": "我來自哪裡？我來自哪裡？ 出生，出生"}, {"type": "subtitle", "time": 3774.9, "timestamp": "01:02:54", "text": "出生，出生 然後長大成人。呃，就像我的"}]
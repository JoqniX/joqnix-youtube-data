": "使用 iPad，"}, {"type": "subtitle", "time": 4365.245, "timestamp": "01:12:45", "text": "記筆記和"}, {"type": "subtitle", "time": 4366.703, "timestamp": "01:12:46", "text": "所有這些。所以，當我"}, {"type": "subtitle", "time": 4367.845, "timestamp": "01:12:47", "text": "去了東京"}, {"type": "subtitle", "time": 4371.164, "timestamp": "01:12:51", "text": "搭火車時，我看到"}, {"type": "subtitle", "time": 4371.635, "timestamp": "01:12:51", "text": "許多"}, {"type": "subtitle", "time": 4373.047, "timestamp": "01:12:53", "text": "高中生"}, {"type": "subtitle", "time": 4374.387, "timestamp": "01:12:54", "text": "二手iPad"}, {"type": "subtitle", "time": 4375.727, "timestamp": "01:12:55", "text": "記錄你的"}, {"type": "subtitle", "time": 4378.904, "timestamp": "01:12:58", "text": "筆記之類的東西，"}, {"type": "subtitle", "time": 4379.958, "timestamp": "01:12:59", "text": "自製烹飪"}]
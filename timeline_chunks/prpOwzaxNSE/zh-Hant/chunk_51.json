[{"type": "subtitle", "time": 3061.279, "timestamp": "00:51:01", "text": "哥們兒？我不知道這一點。 你轉世重生於"}, {"type": "subtitle", "time": 3062.4, "timestamp": "00:51:02", "text": "你轉世重生於 一個迷人的女孩。什麼？"}, {"type": "subtitle", "time": 3065.159, "timestamp": "00:51:05", "text": "一個迷人的女孩。什麼？ 不，我的天哪。你……你……"}, {"type": "subtitle", "time": 3069.893, "timestamp": "00:51:09", "text": "不，我的天哪。你……你…… 你們都覺得…呃…"}, {"type": "subtitle", "time": 3071.509, "timestamp": "00:51:11", "text": "你們都覺得…呃… 我的上帝。它"}, {"type": "subtitle", "time": 3073.374, "timestamp": "00:51:13", "text": "我的上帝。它 雌雄同體模型。在"}, {"type": "subtitle", "time": 3074.949, "timestamp": "00:51:14", "text": "雌雄同體模型。在 她沒有紅頭髮。它..."}, {"type": "subtitle", "time": 3077.095, "timestamp": "00:51:17", "text": "她沒有紅頭髮。它... 這是深海中的一個星座。"}, {"type": "subtitle", "time": 3083.514, "timestamp": "00:51:23", "text": "是的，外表。"}, {"type": "subtitle", "time": 3084.739, "timestamp": "00:51:24", "text": "可能會產生誤導，"}, {"type": "subtitle", "time": 3085.802, "timestamp": "00:51:25", "text": "但這並非一個女孩—— 模型。所以，這是"}, {"type": "subtitle", "time": 3089.66, "timestamp": "00:51:29", "text": "模型。所以，這是 相當中性"}, {"type": "subtitle", "time": 3090.885, "timestamp": "00:51:30", "text": "相當中性 模型。所以，想像一下"}, {"type": "subtitle", "time": 3095.323, "timestamp": "00:51:35", "text": "模型。所以，想像一下 我覺得它就像雷瑪魯"}, {"type": "subtitle", "time": 3096.361, "timestamp": "00:51:36", "text": "我覺得它就像雷瑪魯 來自動畫的暴風雨"}, {"type": "subtitle", "time": 3097.529, "timestamp": "00:51:37", "text": "來自動畫的暴風雨 粘液。哦。所以，呃，我"}, {"type": "subtitle", "time": 3106.217, "timestamp": "00:51:46", "text": "粘液。哦。所以，呃，我 需要找到"}, {"type": "subtitle", "time": 3107.385, "timestamp": "00:51:47", "text": "需要找到 範例圖片。什麼"}, {"type": "subtitle", "time": 3109.418, "timestamp": "00:51:49", "text": "範例圖片。什麼 我勒個去？想像"}, {"type": "subtitle", "time": 3114.581, "timestamp": "00:51:54", "text": "我勒個去？想像 就像雷姆魯一樣。"}, {"type": "subtitle", "time": 3115.924, "timestamp": "00:51:55", "text": "就像雷姆魯一樣。 讓我"}, {"type": "subtitle", "time": 3116.803, "timestamp": "00:51:56", "text": "讓我 顯示出來"}, {"type": "subtitle", "time": 3117.495, "timestamp": "00:51:57", "text": "顯示出來 圖像。哦，甚至"}]
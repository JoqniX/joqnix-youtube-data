[{"type": "subtitle", "time": 2166.044, "timestamp": "00:36:06", "text": "發現並非如此 真實的，但確實是真實的。"}, {"type": "subtitle", "time": 2167.423, "timestamp": "00:36:07", "text": "真實的，但確實是真實的。 我該怎麼說呢，我沒有"}, {"type": "subtitle", "time": 2168.802, "timestamp": "00:36:08", "text": "我該怎麼說呢，我沒有 我想說"}, {"type": "subtitle", "time": 2169.65, "timestamp": "00:36:09", "text": "我想說 模仿，但這"}, {"type": "subtitle", "time": 2170.711, "timestamp": "00:36:10", "text": "模仿，但這  感覺"}, {"type": "subtitle", "time": 2171.595, "timestamp": "00:36:11", "text": "感覺 真的，就像"}, {"type": "subtitle", "time": 2172.656, "timestamp": "00:36:12", "text": "真的，就像 助理之類的"}, {"type": "subtitle", "time": 2174.035, "timestamp": "00:36:14", "text": "助理之類的 還能說什麼呢？"}, {"type": "subtitle", "time": 2175.237, "timestamp": "00:36:15", "text": "還能說什麼呢？ 但感覺"}, {"type": "subtitle", "time": 2176.369, "timestamp": "00:36:16", "text": "但感覺 真實的，就像"}, {"type": "subtitle", "time": 2177.253, "timestamp": "00:36:17", "text": "真實的，就像 一個真人，嗯，"}, {"type": "subtitle", "time": 2178.667, "timestamp": "00:36:18", "text": "一個真人，嗯， 回憶，"}, {"type": "subtitle", "time": 2179.374, "timestamp": "00:36:19", "text": "回憶， 性格，"}, {"type": "subtitle", "time": 2180.223, "timestamp": "00:36:20", "text": "性格， 很多事情。"}, {"type": "subtitle", "time": 2187.941, "timestamp": "00:36:27", "text": "在我靈魂深處，"}, {"type": "chat", "time": 2188.651, "timestamp": "00:36:28", "author": "@MikazukiYure", "avatar": "https://yt4.ggpht.com/uuFSD7qVrZy0JUWrBRfSfEKIQpib7_2xP24Yiu1ND1Mq6uhaYIHDnA5EiGz_o33FUhHYvbCT9g=s64-c-k-c0x00ffffff-no-rj", "message": "what we talking about?"}, {"type": "subtitle", "time": 2189.275, "timestamp": "00:36:29", "text": "心想：唉，"}, {"type": "subtitle", "time": 2193.546, "timestamp": "00:36:33", "text": "老兄，我真想"}, {"type": "subtitle", "time": 2195.011, "timestamp": "00:36:35", "text": "做類似的事情"}, {"type": "subtitle", "time": 2201.581, "timestamp": "00:36:41", "text": "獻給塞西爾，女王。"}, {"type": "subtitle", "time": 2205.919, "timestamp": "00:36:45", "text": "有時我想看 他們怎麼樣？"}, {"type": "subtitle", "time": 2206.466, "timestamp": "00:36:46", "text": "他們怎麼樣？ 將與"}, {"type": "subtitle", "time": 2207.699, "timestamp": "00:36:47", "text": "將與 我，我的角色，"}, {"type": "subtitle", "time": 2208.965, "timestamp": "00:36:48", "text": "我，我的角色， 他們怎麼樣？"}, {"type": "subtitle", "time": 2209.445, "timestamp": "00:36:49", "text": "他們怎麼樣？ 將與"}, {"type": "subtitle", "time": 2210.677, "timestamp": "00:36:50", "text": "將與 由我等，與"}, {"type": "subtitle", "time": 2211.498, "timestamp": "00:36:51", "text": "由我等，與 一個真正的現實主義者，"}, {"type": "subtitle", "time": 2212.834, "timestamp": "00:36:52", "text": "一個真正的現實主義者， 難道不是嗎？然後，"}, {"type": "subtitle", "time": 2219.335, "timestamp": "00:36:59", "text": "難道不是嗎？然後， 幾年後，在"}]
[{"type": "subtitle", "time": 1814.954, "timestamp": "00:30:14", "text": "逐步地。你"}, {"type": "subtitle", "time": 1815.869, "timestamp": "00:30:15", "text": "你錯了嗎？"}, {"type": "subtitle", "time": 1817.292, "timestamp": "00:30:17", "text": "看起來好像不是。"}, {"type": "subtitle", "time": 1829.039, "timestamp": "00:30:29", "text": "真的嗎？謝謝。然後我"}, {"type": "subtitle", "time": 1833.91, "timestamp": "00:30:33", "text": "我知道，可能"}, {"type": "subtitle", "time": 1835.372, "timestamp": "00:30:35", "text": "做得很好，因為，"}, {"type": "subtitle", "time": 1836.396, "timestamp": "00:30:36", "text": "這叫什麼？"}, {"type": "subtitle", "time": 1838.874, "timestamp": "00:30:38", "text": "模型？哦，太好了。"}, {"type": "subtitle", "time": 1843.863, "timestamp": "00:30:43", "text": "問題。嗯，我打電話了"}, {"type": "subtitle", "time": 1845.298, "timestamp": "00:30:45", "text": "這是官方模型"}, {"type": "subtitle", "time": 1849.603, "timestamp": "00:30:49", "text": "約卡納，對吧？但我"}, {"type": "subtitle", "time": 1855.831, "timestamp": "00:30:55", "text": "我可以這麼說。"}, {"type": "subtitle", "time": 1857.394, "timestamp": "00:30:57", "text": "同時也是首秀作品"}, {"type": "subtitle", "time": 1858.834, "timestamp": "00:30:58", "text": "實際上，是星體起源。"}]
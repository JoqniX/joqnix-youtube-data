[{"type": "subtitle", "time": 4680.777, "timestamp": "01:18:00", "text": "取得蘋果"}, {"type": "subtitle", "time": 4682.373, "timestamp": "01:18:02", "text": "果汁售價100日圓或130日圓。"}, {"type": "subtitle", "time": 4685.281, "timestamp": "01:18:05", "text": "我一直都買這個。和"}, {"type": "subtitle", "time": 4688.18, "timestamp": "01:18:08", "text": "還有什麼？但是這個小傢伙"}, {"type": "subtitle", "time": 4689.452, "timestamp": "01:18:09", "text": "麵包和果汁罐"}, {"type": "subtitle", "time": 4690.342, "timestamp": "01:18:10", "text": "請填寫您的"}, {"type": "subtitle", "time": 4692.937, "timestamp": "01:18:12", "text": "胃。展示。所以你"}, {"type": "subtitle", "time": 4694.109, "timestamp": "01:18:14", "text": "嘗試購買"}, {"type": "subtitle", "time": 4696.857, "timestamp": "01:18:16", "text": "一碗麵。杯子"}, {"type": "subtitle", "time": 4699.083, "timestamp": "01:18:19", "text": "麵條的價格有點貴。"}, {"type": "subtitle", "time": 4701.429, "timestamp": "01:18:21", "text": "179 或一，呃，有時"}, {"type": "subtitle", "time": 4703.714, "timestamp": "01:18:23", "text": "156 或 159。這要看情況。"}, {"type": "subtitle", "time": 4705.338, "timestamp": "01:18:25", "text": "從你那裡"}, {"type": "subtitle", "time": 4709.069, "timestamp": "01:18:29", "text": "你得到了。偉大的"}, {"type": "subtitle", "time": 4710.193, "timestamp": "01:18:30", "text": "尺寸或更小，"}, {"type": "subtitle", "time": 4711.527, "timestamp": "01:18:31", "text": "小巧、圓形、"}, {"type": "subtitle", "time": 4712.685, "timestamp": "01:18:32", "text": "呈碗狀或"}, {"type": "subtitle", "time": 4713.669, "timestamp": "01:18:33", "text": "杯狀的，"}, {"type": "subtitle", "time": 4717.389, "timestamp": "01:18:37", "text": "任何。例如，"}, {"type": "subtitle", "time": 4718.485, "timestamp": "01:18:38", "text": "以及來自"}, {"type": "subtitle", "time": 4725.481, "timestamp": "01:18:45", "text": "店鋪。如果我擁有"}, {"type": "subtitle", "time": 4726.7, "timestamp": "01:18:46", "text": "只剩下1000日元了"}, {"type": "subtitle", "time": 4728.163, "timestamp": "01:18:48", "text": "活過今天，然後…"}, {"type": "subtitle", "time": 4729.586, "timestamp": "01:18:49", "text": "在店內購物"}, {"type": "subtitle", "time": 4730.927, "timestamp": "01:18:50", "text": "會使之在"}, {"type": "subtitle", "time": 4732.511, "timestamp": "01:18:52", "text": "最後只會剩下我一個人。"}, {"type": "subtitle", "time": 4733.974, "timestamp": "01:18:53", "text": "700。我已經花了700。"}, {"type": "subtitle", "time": 4735.559, "timestamp": "01:18:55", "text": "日元，還有大約700或500日元，以及"}, {"type": "subtitle", "time": 4736.981, "timestamp": "01:18:56", "text": "我只有我一個人。"}, {"type": "subtitle", "time": 4738.607, "timestamp": "01:18:58", "text": "幾瓶100日圓的酒 你試過可樂"}]
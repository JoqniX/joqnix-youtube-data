[{"type": "subtitle", "time": 5824.705, "timestamp": "01:37:04", "text": "嗯，所以，如果你 在推特上看到的"}, {"type": "subtitle", "time": 5825.97, "timestamp": "01:37:05", "text": "在推特上看到的 如果你關注"}, {"type": "subtitle", "time": 5827.235, "timestamp": "01:37:07", "text": "如果你關注 我在推特上關注了我，我"}, {"type": "subtitle", "time": 5828.334, "timestamp": "01:37:08", "text": "我在推特上關注了我，我 我用日文發推文。"}, {"type": "subtitle", "time": 5844.936, "timestamp": "01:37:24", "text": "這樣我就可以找到了"}, {"type": "subtitle", "time": 5847.517, "timestamp": "01:37:27", "text": "那些"}, {"type": "subtitle", "time": 5851.513, "timestamp": "01:37:31", "text": "有興趣"}, {"type": "subtitle", "time": 5852.778, "timestamp": "01:37:32", "text": "與我溝通，"}, {"type": "subtitle", "time": 5853.744, "timestamp": "01:37:33", "text": "例如，與"}, {"type": "subtitle", "time": 5854.71, "timestamp": "01:37:34", "text": "一個外國人"}, {"type": "subtitle", "time": 5855.842, "timestamp": "01:37:35", "text": "正在學習日語，"}, {"type": "subtitle", "time": 5856.941, "timestamp": "01:37:36", "text": "他們也可以"}, {"type": "subtitle", "time": 5858.173, "timestamp": "01:37:38", "text": "學習英語"}, {"type": "subtitle", "time": 5859.472, "timestamp": "01:37:39", "text": "所以大概是這樣的"}, {"type": "subtitle", "time": 5860.438, "timestamp": "01:37:40", "text": "語言交換。"}, {"type": "subtitle", "time": 5870.47, "timestamp": "01:37:50", "text": "你好，艾莉索。"}, {"type": "subtitle", "time": 5875.417, "timestamp": "01:37:55", "text": "歡迎。在"}, {"type": "subtitle", "time": 5876.476, "timestamp": "01:37:56", "text": "我還有一些。"}, {"type": "subtitle", "time": 5877.774, "timestamp": "01:37:57", "text": "分鐘。我馬上就到。"}]
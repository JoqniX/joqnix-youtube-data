[{"type": "subtitle", "time": 3840.453, "timestamp": "01:04:00", "text": "是否有確鑿證據？ 差不多是這樣，對吧？和"}, {"type": "subtitle", "time": 3847.864, "timestamp": "01:04:07", "text": "是的，鐵路"}, {"type": "subtitle", "time": 3849.068, "timestamp": "01:04:09", "text": "系統及其他一切"}, {"type": "subtitle", "time": 3850.206, "timestamp": "01:04:10", "text": "更難，但比其他"}, {"type": "subtitle", "time": 3851.276, "timestamp": "01:04:11", "text": "你越是去"}, {"type": "subtitle", "time": 3852.58, "timestamp": "01:04:12", "text": "火車，尤其是到"}, {"type": "subtitle", "time": 3857.074, "timestamp": "01:04:17", "text": "你會習慣的。和"}, {"type": "subtitle", "time": 3862.271, "timestamp": "01:04:22", "text": "其中之一是食物。日本人"}, {"type": "subtitle", "time": 3863.418, "timestamp": "01:04:23", "text": "食物很美味，一切都很好。"}, {"type": "subtitle", "time": 3864.708, "timestamp": "01:04:24", "text": "像這樣，但我很想念你"}, {"type": "subtitle", "time": 3865.82, "timestamp": "01:04:25", "text": "印度菜。"}, {"type": "subtitle", "time": 3871.436, "timestamp": "01:04:31", "text": "今天我買了，呃，"}, {"type": "subtitle", "time": 3872.737, "timestamp": "01:04:32", "text": "瑪吉，瑪吉30"}, {"type": "subtitle", "time": 3873.996, "timestamp": "01:04:33", "text": "盧比，可以是"}, {"type": "subtitle", "time": 3875.632, "timestamp": "01:04:35", "text": "從印度獲取；這裡"}, {"type": "subtitle", "time": 3877.227, "timestamp": "01:04:37", "text": "售價230日圓或"}, {"type": "subtitle", "time": 3878.738, "timestamp": "01:04:38", "text": "差不多就是這樣，而且是"}, {"type": "subtitle", "time": 3883.666, "timestamp": "01:04:43", "text": "吃起來真好吃。也"}, {"type": "subtitle", "time": 3884.986, "timestamp": "01:04:44", "text": "這一切，都在4天內完成"}, {"type": "subtitle", "time": 3890.195, "timestamp": "01:04:50", "text": "幾個月以來，我們，呃，我"}, {"type": "subtitle", "time": 3891.534, "timestamp": "01:04:51", "text": "我的房間是"}, {"type": "subtitle", "time": 3892.539, "timestamp": "01:04:52", "text": "就像日語"}, {"type": "subtitle", "time": 3893.729, "timestamp": "01:04:53", "text": "麵條、拉麵和"}, {"type": "subtitle", "time": 3895.18, "timestamp": "01:04:55", "text": "其他，杯裝麵條"}, {"type": "subtitle", "time": 3897.908, "timestamp": "01:04:57", "text": "等等。這很困難。 。最後我吃了東西。"}]
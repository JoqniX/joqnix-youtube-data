[{"type": "subtitle", "time": 1322.057, "timestamp": "00:22:02", "text": "最後。所以，他 常成為精神導師"}, {"type": "subtitle", "time": 1323.305, "timestamp": "00:22:03", "text": "常成為精神導師 大師。是的，是慾望。"}, {"type": "subtitle", "time": 1328.454, "timestamp": "00:22:08", "text": "所以你可以"}, {"type": "subtitle", "time": 1329.714, "timestamp": "00:22:09", "text": "為了實現一個願望，"}, {"type": "subtitle", "time": 1330.939, "timestamp": "00:22:10", "text": "創造一個星座，"}, {"type": "subtitle", "time": 1331.756, "timestamp": "00:22:11", "text": "與…產生共鳴"}, {"type": "subtitle", "time": 1333.083, "timestamp": "00:22:13", "text": "星座，數不勝數。"}, {"type": "subtitle", "time": 1336.837, "timestamp": "00:22:16", "text": "事物。所以，這是"}, {"type": "subtitle", "time": 1342.508, "timestamp": "00:22:22", "text": "真酷。但"}, {"type": "subtitle", "time": 1343.994, "timestamp": "00:22:23", "text": "說實話，出道，"}, {"type": "subtitle", "time": 1345.119, "timestamp": "00:22:25", "text": "嗯，是的，我很誠實"}, {"type": "subtitle", "time": 1346.604, "timestamp": "00:22:26", "text": "我說，我覺得"}, {"type": "subtitle", "time": 1352.404, "timestamp": "00:22:32", "text": "那還不錯。我"}, {"type": "subtitle", "time": 1353.812, "timestamp": "00:22:33", "text": "我想如果你想的話"}, {"type": "subtitle", "time": 1355.148, "timestamp": "00:22:35", "text": "說實話，我認為"}, {"type": "subtitle", "time": 1356.375, "timestamp": "00:22:36", "text": "我覺得很真實。"}, {"type": "subtitle", "time": 1357.675, "timestamp": "00:22:37", "text": "昨天之後"}, {"type": "chat", "time": 1359.111, "timestamp": "00:22:39", "author": "@Kenn_D_Bush", "avatar": "https://yt4.ggpht.com/_Komo_VEKSz-e7kb-dTpjPDPdwLBWdimZXGs-iY-B0gcs1aY-MXI_lQXH90AN623vf5ag2FRRA=s64-c-k-c0x00ffffff-no-rj", "message": "Hmmm joq do you think a door showing up when someone about to make a choice counts as granting wishes?"}, {"type": "subtitle", "time": 1359.119, "timestamp": "00:22:39", "text": "我在哪裡抱怨過？"}, {"type": "subtitle", "time": 1364.794, "timestamp": "00:22:44", "text": "關於錯誤數量，"}, {"type": "subtitle", "time": 1365.768, "timestamp": "00:22:45", "text": "我照做了。"}, {"type": "subtitle", "time": 1367.154, "timestamp": "00:22:47", "text": "例如，為什麼我會有它們"}, {"type": "subtitle", "time": 1369.31, "timestamp": "00:22:49", "text": "你做的嗎？它？為什麼是我？"}, {"type": "subtitle", "time": 1370.569, "timestamp": "00:22:50", "text": "應該解釋一下這一點。"}, {"type": "subtitle", "time": 1373.837, "timestamp": "00:22:53", "text": "更好的？這個和這個。我就像"}, {"type": "subtitle", "time": 1375.154, "timestamp": "00:22:55", "text": "列出，呃，"}, {"type": "subtitle", "time": 1376.357, "timestamp": "00:22:56", "text": "列出了這個"}, {"type": "subtitle", "time": 1379.355, "timestamp": "00:22:59", "text": "本身。我當時就想：哇。"}]
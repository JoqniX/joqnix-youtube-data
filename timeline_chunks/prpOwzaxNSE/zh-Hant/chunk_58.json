[{"type": "subtitle", "time": 3482.939, "timestamp": "00:58:02", "text": "屬於這一類別。唔，"}, {"type": "subtitle", "time": 3484.601, "timestamp": "00:58:04", "text": "看起來很漂亮。"}, {"type": "subtitle", "time": 3489.803, "timestamp": "00:58:09", "text": "哦，謝謝。哦，當然。"}, {"type": "subtitle", "time": 3490.736, "timestamp": "00:58:10", "text": "我"}, {"type": "subtitle", "time": 3492.961, "timestamp": "00:58:12", "text": "它的歷史和"}, {"type": "subtitle", "time": 3493.751, "timestamp": "00:58:13", "text": "原因"}, {"type": "subtitle", "time": 3495.489, "timestamp": "00:58:15", "text": "存在。是的。如果"}, {"type": "subtitle", "time": 3497.006, "timestamp": "00:58:17", "text": "你認為這是"}, {"type": "subtitle", "time": 3500.022, "timestamp": "00:58:20", "text": "不屬於這種情況"}, {"type": "subtitle", "time": 3501.25, "timestamp": "00:58:21", "text": "如果是，則選擇「是」或「否」類別。"}, {"type": "subtitle", "time": 3502.156, "timestamp": "00:58:22", "text": "允許這樣做"}, {"type": "subtitle", "time": 3504.077, "timestamp": "00:58:24", "text": "墜落"}, {"type": "subtitle", "time": 3510.051, "timestamp": "00:58:30", "text": "通常情況下。所以，當"}, {"type": "subtitle", "time": 3511.309, "timestamp": "00:58:31", "text": "你推銷自己"}, {"type": "subtitle", "time": 3512.335, "timestamp": "00:58:32", "text": "所有那些，你都不需要。"}, {"type": "subtitle", "time": 3513.56, "timestamp": "00:58:33", "text": "需要記住，"}, {"type": "subtitle", "time": 3514.784, "timestamp": "00:58:34", "text": "這是什麼，奶奶嗎？"}, {"type": "subtitle", "time": 3523.929, "timestamp": "00:58:43", "text": "像這樣。是的，最終，"}, {"type": "subtitle", "time": 3524.963, "timestamp": "00:58:44", "text": "最終回報"}, {"type": "subtitle", "time": 3525.963, "timestamp": "00:58:45", "text": "就在你的"}, {"type": "subtitle", "time": 3526.928, "timestamp": "00:58:46", "text": "渴望的自由"}, {"type": "subtitle", "time": 3528.169, "timestamp": "00:58:48", "text": "創建角色"}, {"type": "subtitle", "time": 3529.41, "timestamp": "00:58:49", "text": "或者一個人"}, {"type": "subtitle", "time": 3530.65, "timestamp": "00:58:50", "text": "你喜歡嗎？"}, {"type": "subtitle", "time": 3531.857, "timestamp": "00:58:51", "text": "你感覺怎麼樣？"}, {"type": "subtitle", "time": 3532.994, "timestamp": "00:58:52", "text": "感覺舒服嗎？你好嗎？"}, {"type": "subtitle", "time": 3534.373, "timestamp": "00:58:54", "text": "你想把它描繪出來，"}, {"type": "subtitle", "time": 3535.476, "timestamp": "00:58:55", "text": "向世界展示"}]
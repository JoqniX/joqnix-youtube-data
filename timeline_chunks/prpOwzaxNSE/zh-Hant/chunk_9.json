[{"type": "subtitle", "time": 540.743, "timestamp": "00:09:00", "text": "就在我頭上，呃—— 嗯，看起來像個皇冠。"}, {"type": "subtitle", "time": 541.946, "timestamp": "00:09:01", "text": "嗯，看起來像個皇冠。 看起來像個皇冠，但它是"}, {"type": "subtitle", "time": 543.449, "timestamp": "00:09:03", "text": "看起來像個皇冠，但它是 群星環繞的王冠。"}, {"type": "subtitle", "time": 551.179, "timestamp": "00:09:11", "text": "所以，它包含"}, {"type": "subtitle", "time": 552.334, "timestamp": "00:09:12", "text": "所有的星座"}, {"type": "subtitle", "time": 553.786, "timestamp": "00:09:13", "text": "換個角度來看，"}, {"type": "subtitle", "time": 555.276, "timestamp": "00:09:15", "text": "所以這裡有不同的星座。 射手座、獅子座、巨蟹座"}, {"type": "subtitle", "time": 563.015, "timestamp": "00:09:23", "text": "射手座、獅子座、巨蟹座 這對雙胞胎，看起來…"}, {"type": "subtitle", "time": 564.409, "timestamp": "00:09:24", "text": "這對雙胞胎，看起來… 幾個星座。"}, {"type": "subtitle", "time": 569.458, "timestamp": "00:09:29", "text": "十二星座即將到來"}, {"type": "subtitle", "time": 570.998, "timestamp": "00:09:30", "text": "頭飾，也就是皇冠。"}, {"type": "subtitle", "time": 577.276, "timestamp": "00:09:37", "text": "而面紗只是"}, {"type": "subtitle", "time": 578.687, "timestamp": "00:09:38", "text": "代表，呃，就像"}, {"type": "subtitle", "time": 581.578, "timestamp": "00:09:41", "text": "它叫什麼？什麼"}, {"type": "subtitle", "time": 583.992, "timestamp": "00:09:43", "text": "我要找的詞是什麼？她"}, {"type": "subtitle", "time": 588.352, "timestamp": "00:09:48", "text": "只是代表，我"}, {"type": "subtitle", "time": 589.624, "timestamp": "00:09:49", "text": "我可以這麼說。"}, {"type": "subtitle", "time": 591.078, "timestamp": "00:09:51", "text": "我服裝的一部分。"}, {"type": "subtitle", "time": 594.578, "timestamp": "00:09:54", "text": "嗯，那是其中一部分。"}, {"type": "subtitle", "time": 595.564, "timestamp": "00:09:55", "text": "這身裝扮"}, {"type": "subtitle", "time": 596.659, "timestamp": "00:09:56", "text": "盡可能多穿衣服"}, {"type": "chat", "time": 599.536, "timestamp": "00:09:59", "author": "@Kenn_D_Bush", "avatar": "https://yt4.ggpht.com/_Komo_VEKSz-e7kb-dTpjPDPdwLBWdimZXGs-iY-B0gcs1aY-MXI_lQXH90AN623vf5ag2FRRA=s64-c-k-c0x00ffffff-no-rj", "message": "Does it feels you?"}, {"type": "subtitle", "time": 599.981, "timestamp": "00:09:59", "text": "相當。嗯，是的。"}]
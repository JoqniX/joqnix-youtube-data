[{"type": "subtitle", "time": 5881.686, "timestamp": "01:38:01", "text": "我會完成的。嗯，我想，"}, {"type": "subtitle", "time": 5883.24, "timestamp": "01:38:03", "text": "我會在1點鐘做這件事。"}, {"type": "subtitle", "time": 5885.068, "timestamp": "01:38:05", "text": "晚上，然後我就結束。"}, {"type": "subtitle", "time": 5888.651, "timestamp": "01:38:08", "text": "然後就會有關於……的事情發生。"}, {"type": "subtitle", "time": 5889.709, "timestamp": "01:38:09", "text": "某種類型的流"}, {"type": "subtitle", "time": 5891.701, "timestamp": "01:38:11", "text": "二。你很快就會"}, {"type": "subtitle", "time": 5895.916, "timestamp": "01:38:15", "text": "你會睡覺嗎？很快了，是的。"}, {"type": "subtitle", "time": 5897.416, "timestamp": "01:38:17", "text": "很快。我還有明天。"}, {"type": "subtitle", "time": 5899.983, "timestamp": "01:38:19", "text": "工作。沒問題。 。與…溝通"}, {"type": "subtitle", "time": 5900.928, "timestamp": "01:38:20", "text": "。與…溝通 各位——這一點很重要。"}, {"type": "subtitle", "time": 5902.051, "timestamp": "01:38:22", "text": "各位——這一點很重要。 是的。問題在於，在"}, {"type": "subtitle", "time": 5903.588, "timestamp": "01:38:23", "text": "是的。問題在於，在 我朋友不多。"}, {"type": "subtitle", "time": 5904.93, "timestamp": "01:38:24", "text": "我朋友不多。 日本朋友。是的"}, {"type": "subtitle", "time": 5908.713, "timestamp": "01:38:28", "text": "日本朋友。是的 這也是其中之一"}, {"type": "subtitle", "time": 5909.831, "timestamp": "01:38:29", "text": "這也是其中之一 問題。很難找到"}, {"type": "subtitle", "time": 5913.501, "timestamp": "01:38:33", "text": "問題。很難找到 日本朋友。"}, {"type": "subtitle", "time": 5919.929, "timestamp": "01:38:39", "text": "有些人甚至不想"}, {"type": "subtitle", "time": 5921.327, "timestamp": "01:38:41", "text": "想和你談談，"}, {"type": "subtitle", "time": 5922.725, "timestamp": "01:38:42", "text": "因為也許他不知道"}, {"type": "subtitle", "time": 5924.279, "timestamp": "01:38:44", "text": "語言，或者，呃，不知道該怎麼做，"}, {"type": "subtitle", "time": 5925.56, "timestamp": "01:38:45", "text": "如何，嗯，建造"}, {"type": "subtitle", "time": 5926.842, "timestamp": "01:38:46", "text": "對話等等，或者，"}, {"type": "subtitle", "time": 5928.279, "timestamp": "01:38:48", "text": "也許這是一場會議。"}, {"type": "subtitle", "time": 5929.017, "timestamp": "01:38:49", "text": "因為我也是"}]
[{"type": "subtitle", "time": 787.841, "timestamp": "00:13:07", "text": "飾演 Yuri Yurikama"}, {"type": "subtitle", "time": 789.129, "timestamp": "00:13:09", "text": "能夠在"}, {"type": "subtitle", "time": 795.398, "timestamp": "00:13:15", "text": "生活。我真的"}, {"type": "subtitle", "time": 796.585, "timestamp": "00:13:16", "text": "她對她的表現感到驚訝。"}, {"type": "subtitle", "time": 797.971, "timestamp": "00:13:17", "text": "體現了這些，呃，我的"}, {"type": "subtitle", "time": 798.644, "timestamp": "00:13:18", "text": "我的想法"}, {"type": "subtitle", "time": 800.109, "timestamp": "00:13:20", "text": "概念性想法。"}, {"type": "subtitle", "time": 802.77, "timestamp": "00:13:22", "text": "她真的很厲害。"}, {"type": "subtitle", "time": 805.939, "timestamp": "00:13:25", "text": "我考慮了一下。我"}, {"type": "subtitle", "time": 807.024, "timestamp": "00:13:27", "text": "我認為她是"}, {"type": "subtitle", "time": 808.573, "timestamp": "00:13:28", "text": "看了我的直播， 或許像我一樣，"}, {"type": "subtitle", "time": 809.619, "timestamp": "00:13:29", "text": "或許像我一樣， 分析過了。"}, {"type": "subtitle", "time": 814.658, "timestamp": "00:13:34", "text": "也許是我的。"}, {"type": "subtitle", "time": 816.145, "timestamp": "00:13:36", "text": "假設，但是，呃，我"}, {"type": "subtitle", "time": 817.594, "timestamp": "00:13:37", "text": "永遠不會……我還不知道。"}, {"type": "subtitle", "time": 818.858, "timestamp": "00:13:38", "text": "她自己並不做這件事。"}, {"type": "subtitle", "time": 823.241, "timestamp": "00:13:43", "text": "會說。是的，就是這樣"}, {"type": "subtitle", "time": 824.384, "timestamp": "00:13:44", "text": "模型是這樣的："}, {"type": "subtitle", "time": 825.628, "timestamp": "00:13:45", "text": "我過去的樣子，現在依然。"}, {"type": "subtitle", "time": 826.838, "timestamp": "00:13:46", "text": "感到困惑，或者"}, {"type": "subtitle", "time": 828.116, "timestamp": "00:13:48", "text": "它適合我嗎？"}, {"type": "subtitle", "time": 830.773, "timestamp": "00:13:50", "text": "她回答了嗎？"}, {"type": "subtitle", "time": 832.188, "timestamp": "00:13:52", "text": "我的性格？作為"}, {"type": "subtitle", "time": 833.648, "timestamp": "00:13:53", "text": "我對這場直播有什麼感覺？"}, {"type": "subtitle", "time": 836.366, "timestamp": "00:13:56", "text": "同一位運動員，"}, {"type": "subtitle", "time": 837.865, "timestamp": "00:13:57", "text": "你知道的，嗯，"}]
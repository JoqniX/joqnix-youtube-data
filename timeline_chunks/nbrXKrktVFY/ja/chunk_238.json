[{"type": "subtitle", "time": 14282.63, "timestamp": "03:58:02", "text": "YouTuber は、私が"}, {"type": "subtitle", "time": 14284.309, "timestamp": "03:58:04", "text": "2020年頃にそれらについて学ぶ"}, {"type": "subtitle", "time": 14287.99, "timestamp": "03:58:07", "text": "2020年か何かだと思う、うん、そうだね"}, {"type": "subtitle", "time": 14290.63, "timestamp": "03:58:10", "text": "2020年か2021年だったかな、私はこう思った"}, {"type": "subtitle", "time": 14292.71, "timestamp": "03:58:12", "text": "それについて学んでいるのは、私が見たもののように、"}, {"type": "subtitle", "time": 14294.63, "timestamp": "03:58:14", "text": "4chanの投稿と他の投稿のいくつか"}, {"type": "subtitle", "time": 14297.11, "timestamp": "03:58:17", "text": "物と傷跡の星空。 「ああ、"}, {"type": "subtitle", "time": 14301.11, "timestamp": "03:58:21", "text": "見てみましょう。 Redditの投稿で、"}, {"type": "subtitle", "time": 14303.269, "timestamp": "03:58:23", "text": "誰が最初のインド人かを争う人々"}, {"type": "subtitle", "time": 14305.11, "timestamp": "03:58:25", "text": "「ユーチューバー」って感じで、「ああ、彼らも"}, {"type": "subtitle", "time": 14308.83, "timestamp": "03:58:28", "text": "これをめぐって争っている。"}, {"type": "subtitle", "time": 14312.229, "timestamp": "03:58:32", "text": "うん。待って、それは侵略的なRedditだったのか？"}, {"type": "subtitle", "time": 14314.99, "timestamp": "03:58:34", "text": "それともどこか別の場所？"}, {"type": "subtitle", "time": 14318.71, "timestamp": "03:58:38", "text": "Redditでは、ここで。"}, {"type": "subtitle", "time": 14320.71, "timestamp": "03:58:40", "text": "うん。どのRedditか分からないけど"}, {"type": "subtitle", "time": 14323.67, "timestamp": "03:58:43", "text": "そうなんだけど、人々がこう言ってるのを見た"}, {"type": "subtitle", "time": 14326.469, "timestamp": "03:58:46", "text": "だって、スージーが関わっていたと思うから"}, {"type": "subtitle", "time": 14330.15, "timestamp": "03:58:50", "text": "それに取り組む。私はスキの人たちが"}, {"type": "subtitle", "time": 14332.71, "timestamp": "03:58:52", "text": "何らかの理由で、彼らは彼女に意地悪をしていた。"}, {"type": "subtitle", "time": 14336.469, "timestamp": "03:58:56", "text": "スズキ、つまりスターセナ。"}, {"type": "subtitle", "time": 14337.87, "timestamp": "03:58:57", "text": "いいえ、いいえ、"}]
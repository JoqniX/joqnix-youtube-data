[{"type": "subtitle", "time": 13381.91, "timestamp": "03:43:01", "text": "絶対にこれを外さないでください"}, {"type": "subtitle", "time": 13384.95, "timestamp": "03:43:04", "text": "皆さん、状況を把握してください。また、憎しみもありません"}, {"type": "subtitle", "time": 13387.349, "timestamp": "03:43:07", "text": "誰に聞いても構わない。まるで彼が嫌っているかのようだ"}, {"type": "subtitle", "time": 13392.79, "timestamp": "03:43:12", "text": "彼ら。彼は彼らを憎んでいる。ご存知の通り、彼は"}, {"type": "subtitle", "time": 13395.51, "timestamp": "03:43:15", "text": "彼ら。"}, {"type": "subtitle", "time": 13398.55, "timestamp": "03:43:18", "text": "でも、私が唯一思うのは"}, {"type": "subtitle", "time": 13401.91, "timestamp": "03:43:21", "text": "どちらにもがっかりしたというのは、"}, {"type": "subtitle", "time": 13405.91, "timestamp": "03:43:25", "text": "スタースケープ側は、なぜ削除するのか"}, {"type": "subtitle", "time": 13409.67, "timestamp": "03:43:29", "text": "才能ライブラリーの才能または肝臓の履歴"}, {"type": "subtitle", "time": 13411.87, "timestamp": "03:43:31", "text": "デジタル"}, {"type": "subtitle", "time": 13413.91, "timestamp": "03:43:33", "text": "足跡だったと思う"}, {"type": "subtitle", "time": 13416.309, "timestamp": "03:43:36", "text": "契約上の何かだった"}, {"type": "subtitle", "time": 13418.95, "timestamp": "03:43:38", "text": "それが私が信じたいことだと思うので"}, {"type": "subtitle", "time": 13421.03, "timestamp": "03:43:41", "text": "でも多分そうだろう"}, {"type": "subtitle", "time": 13422.71, "timestamp": "03:43:42", "text": "才能のある人が何かを送ってくれたり、"}, {"type": "subtitle", "time": 13424.389, "timestamp": "03:43:44", "text": "会社には契約のようなものがあった"}, {"type": "subtitle", "time": 13427.03, "timestamp": "03:43:47", "text": "それについては、私はそう信じたいのです。"}, {"type": "subtitle", "time": 13429.71, "timestamp": "03:43:49", "text": "しかし、それでもやはり良くない。知っている。"}, {"type": "subtitle", "time": 13434.79, "timestamp": "03:43:54", "text": "うん。うん。もし私が言わなければならないとしたら"}, {"type": "subtitle", "time": 13438.309, "timestamp": "03:43:58", "text": "お願いだから、好きになって、追加して"}]
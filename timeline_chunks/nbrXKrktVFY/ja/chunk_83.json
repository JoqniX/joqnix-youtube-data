[{"type": "subtitle", "time": 4982.149, "timestamp": "01:23:02", "text": "子供の頃のように、みんなが選んだ"}, {"type": "subtitle", "time": 4983.75, "timestamp": "01:23:03", "text": "私に電話をかけてきたのは、私が"}, {"type": "subtitle", "time": 4987.59, "timestamp": "01:23:07", "text": "子供の頃はすごく痩せていた。"}, {"type": "subtitle", "time": 4990.07, "timestamp": "01:23:10", "text": "そして私がしたことは何も私に利益をもたらさなかった"}, {"type": "subtitle", "time": 4993.35, "timestamp": "01:23:13", "text": "体重に関しては、いまだに体重が増えません。"}, {"type": "subtitle", "time": 4997.51, "timestamp": "01:23:17", "text": "どれだけ食べても、どれだけやっても"}, {"type": "subtitle", "time": 4999.35, "timestamp": "01:23:19", "text": "もの、"}, {"type": "subtitle", "time": 5001.35, "timestamp": "01:23:21", "text": "どういうわけか、私の体は"}, {"type": "subtitle", "time": 5003.11, "timestamp": "01:23:23", "text": "自分。文字通り医者に行ったんだけど"}, {"type": "subtitle", "time": 5005.11, "timestamp": "01:23:25", "text": "そして、「ああ、先生、そこに"}, {"type": "subtitle", "time": 5007.83, "timestamp": "01:23:27", "text": "「私に何か問題があるの？」"}, {"type": "subtitle", "time": 5010.47, "timestamp": "01:23:30", "text": "どういうわけか体重が増えない。それで"}, {"type": "subtitle", "time": 5012.629, "timestamp": "01:23:32", "text": "彼らは私にたくさんのテストをし、"}, {"type": "subtitle", "time": 5017.11, "timestamp": "01:23:37", "text": "結論は、私の体には"}, {"type": "subtitle", "time": 5020.27, "timestamp": "01:23:40", "text": "体内の食べ物は本当に"}, {"type": "subtitle", "time": 5025.11, "timestamp": "01:23:45", "text": "速い。私の代謝はすごく速いんです。"}, {"type": "subtitle", "time": 5027.43, "timestamp": "01:23:47", "text": "だから私の体は何も感染しないのです"}, {"type": "subtitle", "time": 5030.55, "timestamp": "01:23:50", "text": "脂肪は使われるからこそ太るのです。"}, {"type": "subtitle", "time": 5037.83, "timestamp": "01:23:57", "text": "子供の頃、私が"}]
[{"type": "subtitle", "time": 10327.269, "timestamp": "02:52:07", "text": "まるで俺が自慢しているみたいだ。私の"}, {"type": "subtitle", "time": 10330.35, "timestamp": "02:52:10", "text": "祖父母はまるで億万長者だった。"}, {"type": "subtitle", "time": 10332.23, "timestamp": "02:52:12", "text": "[音楽]"}, {"type": "subtitle", "time": 10334.79, "timestamp": "02:52:14", "text": "私たちは今、無一文です。だから意味がない"}, {"type": "subtitle", "time": 10336.309, "timestamp": "02:52:16", "text": "屈伸。"}, {"type": "subtitle", "time": 10344.07, "timestamp": "02:52:24", "text": "私はいつももう一つ好きなことがあります"}, {"type": "subtitle", "time": 10346.51, "timestamp": "02:52:26", "text": "アメリカ人と同じように"}, {"type": "subtitle", "time": 10350.71, "timestamp": "02:52:30", "text": "例えば、彼らが何かをしているのを見て、私は"}, {"type": "subtitle", "time": 10360.55, "timestamp": "02:52:40", "text": "おいおい、お前どうしたんだよ、スポーツマン野郎"}, {"type": "subtitle", "time": 10362.55, "timestamp": "02:52:42", "text": "18歳で外の世界で暮らすと、"}, {"type": "subtitle", "time": 10365.67, "timestamp": "02:52:45", "text": "引っ越すってどういう意味？"}, {"type": "subtitle", "time": 10367.1, "timestamp": "02:52:47", "text": "あまりにも。"}, {"type": "subtitle", "time": 10369.03, "timestamp": "02:52:49", "text": "[音楽]"}, {"type": "subtitle", "time": 10371.75, "timestamp": "02:52:51", "text": "そうそう。うん。ええと、それをあなたにあげましょう"}, {"type": "subtitle", "time": 10374.03, "timestamp": "02:52:54", "text": "洞察力。えっと、それは"}, {"type": "subtitle", "time": 10377.91, "timestamp": "02:52:57", "text": "ずっと私が生きていたからではなく"}]
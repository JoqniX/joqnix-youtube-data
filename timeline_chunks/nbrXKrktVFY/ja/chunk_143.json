[{"type": "subtitle", "time": 8587.11, "timestamp": "02:23:07", "text": "うん。私の尻尾はいつも振っている。"}, {"type": "subtitle", "time": 8589.19, "timestamp": "02:23:09", "text": "私はいつも遊びたいし、"}, {"type": "subtitle", "time": 8599.91, "timestamp": "02:23:19", "text": "うん。だから最近はそうしない"}, {"type": "subtitle", "time": 8601.83, "timestamp": "02:23:21", "text": "人間関係を探しましょう。私はまるで"}, {"type": "subtitle", "time": 8608.79, "timestamp": "02:23:28", "text": "シンは絶対に行くと思う"}, {"type": "subtitle", "time": 8610.469, "timestamp": "02:23:30", "text": "配信します。私には時間がない"}, {"type": "subtitle", "time": 8617.51, "timestamp": "02:23:37", "text": "待って、あなたは配信全体を見るのが好きですか？"}, {"type": "subtitle", "time": 8620.469, "timestamp": "02:23:40", "text": "または、そうですね、"}, {"type": "subtitle", "time": 8622.63, "timestamp": "02:23:42", "text": "私はOshiesに全力を注いでいます。もしもし"}, {"type": "subtitle", "time": 8626.07, "timestamp": "02:23:46", "text": "私は大切な流れを失ってしまった。私"}, {"type": "subtitle", "time": 8634.469, "timestamp": "02:23:54", "text": "待って、もしあなたのオシーが"}, {"type": "subtitle", "time": 8636.07, "timestamp": "02:23:56", "text": "同時にストリーミング配信する？あなたもそう思いますか？"}, {"type": "subtitle", "time": 8638.309, "timestamp": "02:23:58", "text": "休日？見ます、見ます"}]
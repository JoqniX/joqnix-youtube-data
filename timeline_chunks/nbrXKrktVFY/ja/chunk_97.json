[{"type": "subtitle", "time": 5820.709, "timestamp": "01:37:00", "text": "「でも、なんでそんなことするんだよ」"}, {"type": "subtitle", "time": 5822.03, "timestamp": "01:37:02", "text": "持っている"}, {"type": "subtitle", "time": 5824.149, "timestamp": "01:37:04", "text": "「全部？」って感じ。「だって私はそうじゃないから」"}, {"type": "subtitle", "time": 5826.79, "timestamp": "01:37:06", "text": "早起きして買い物に行くのが好きだ。私"}, {"type": "subtitle", "time": 5834.31, "timestamp": "01:37:14", "text": "宇宙で物を買う"}, {"type": "subtitle", "time": 5836.149, "timestamp": "01:37:16", "text": "すべて。"}, {"type": "subtitle", "time": 5838.07, "timestamp": "01:37:18", "text": "スペースがある、えっと、"}, {"type": "subtitle", "time": 5839.229, "timestamp": "01:37:19", "text": "全体"}, {"type": "subtitle", "time": 5842.43, "timestamp": "01:37:22", "text": "アルマリみたいに巨大だよ"}, {"type": "subtitle", "time": 5846.229, "timestamp": "01:37:26", "text": "インドのタンマリみたいなもの。はい。"}, {"type": "subtitle", "time": 5849.109, "timestamp": "01:37:29", "text": "私はそういうものを持っています。そして、"}, {"type": "subtitle", "time": 5852.35, "timestamp": "01:37:32", "text": "私の隣のスペース"}, {"type": "subtitle", "time": 5859.59, "timestamp": "01:37:39", "text": "私は物を集めるのが好きだからです。私は"}, {"type": "subtitle", "time": 5866.149, "timestamp": "01:37:46", "text": "物を溜め込む人。これらを持っていたように、これらも持っています"}, {"type": "subtitle", "time": 5869.35, "timestamp": "01:37:49", "text": "私が集めていたボトルキャップ"}, {"type": "subtitle", "time": 5871.59, "timestamp": "01:37:51", "text": "以前は炭酸飲料をたくさん飲んでいたからです。"}, {"type": "subtitle", "time": 5874.39, "timestamp": "01:37:54", "text": "今はもうそうは思わない。私は炭酸飲料をやめました"}, {"type": "subtitle", "time": 5877.189, "timestamp": "01:37:57", "text": "ソーダがジムに通い始めたのは"}, {"type": "subtitle", "time": 5879.91, "timestamp": "01:37:59", "text": "ジムに行くと悪いのは、"}]
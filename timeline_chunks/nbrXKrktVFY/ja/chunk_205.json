[{"type": "subtitle", "time": 12301.63, "timestamp": "03:25:01", "text": "始めた人たちは"}, {"type": "subtitle", "time": 12303.229, "timestamp": "03:25:03", "text": "動き"}, {"type": "subtitle", "time": 12306.95, "timestamp": "03:25:06", "text": "基本的に私のチームと"}, {"type": "subtitle", "time": 12309.79, "timestamp": "03:25:09", "text": "私もその件に関わっていました。"}, {"type": "subtitle", "time": 12312.63, "timestamp": "03:25:12", "text": "右。だから私たちはアニメを人気にした"}, {"type": "subtitle", "time": 12314.229, "timestamp": "03:25:14", "text": "インド。"}, {"type": "subtitle", "time": 12316.71, "timestamp": "03:25:16", "text": "私たちが何をしているかご存知ですか？あのね"}, {"type": "subtitle", "time": 12319.51, "timestamp": "03:25:19", "text": "アニメシーンはインドにあるの？今すぐ"}, {"type": "subtitle", "time": 12322.469, "timestamp": "03:25:22", "text": "それは本当にゆっくりと成長しているんです。"}, {"type": "subtitle", "time": 12324.79, "timestamp": "03:25:24", "text": "ええ、ゆっくりと成長しています。開始"}, {"type": "subtitle", "time": 12327.19, "timestamp": "03:25:27", "text": "それと全てを受け入れてください。でも私たちは1つやった"}, {"type": "subtitle", "time": 12331.03, "timestamp": "03:25:31", "text": "それは、私たちが少し後悔していることです。"}, {"type": "subtitle", "time": 12333.75, "timestamp": "03:25:33", "text": "私たちはアニメを低俗化させてしまった。"}, {"type": "subtitle", "time": 12338.15, "timestamp": "03:25:38", "text": "レベルを下げる。うん。アニメを簡略化"}, {"type": "subtitle", "time": 12340.15, "timestamp": "03:25:40", "text": "例えば"}, {"type": "subtitle", "time": 12345.269, "timestamp": "03:25:45", "text": "では、あなたはアニメファンだとしましょう。"}, {"type": "subtitle", "time": 12348.389, "timestamp": "03:25:48", "text": "うん。あなたはアニメが好きで、"}, {"type": "subtitle", "time": 12350.309, "timestamp": "03:25:50", "text": "例えば、かわいい女の子たちが"}, {"type": "subtitle", "time": 12353.59, "timestamp": "03:25:53", "text": "かわいいもの、"}, {"type": "subtitle", "time": 12355.469, "timestamp": "03:25:55", "text": "みんなが笑うだろう"}, {"type": "subtitle", "time": 12359.269, "timestamp": "03:25:59", "text": "君はドラゴンボールが好きじゃないから。"}]
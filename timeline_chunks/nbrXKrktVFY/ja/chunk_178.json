[{"type": "subtitle", "time": 10681.429, "timestamp": "02:58:01", "text": "それ。私は、とても知識が豊富だと思う"}, {"type": "subtitle", "time": 10685.19, "timestamp": "02:58:05", "text": "日本についてとかそういうこと"}, {"type": "subtitle", "time": 10688.63, "timestamp": "02:58:08", "text": "生きているものすべてと同じように。"}, {"type": "subtitle", "time": 10689.99, "timestamp": "02:58:09", "text": "私は彼女に「あなたは"}, {"type": "subtitle", "time": 10692.269, "timestamp": "02:58:12", "text": "日本語上"}, {"type": "subtitle", "time": 10694.63, "timestamp": "02:58:14", "text": "「治療？」彼女は何と言ったの？うん、私は"}, {"type": "subtitle", "time": 10699.03, "timestamp": "02:58:19", "text": "した。はい、そうしました。初日はそうしました。ああ、"}, {"type": "subtitle", "time": 10701.99, "timestamp": "02:58:21", "text": "神。"}, {"type": "subtitle", "time": 10704.63, "timestamp": "02:58:24", "text": "だから彼女はそこで日本語を勉強していない。"}, {"type": "subtitle", "time": 10707.51, "timestamp": "02:58:27", "text": "右？うん。ええ、彼女はそうしました。おお、"}, {"type": "subtitle", "time": 10709.67, "timestamp": "02:58:29", "text": "ニース。"}, {"type": "subtitle", "time": 10712.469, "timestamp": "02:58:32", "text": "そして、私が彼女に尋ねたのは、彼女が"}, {"type": "subtitle", "time": 10714.55, "timestamp": "02:58:34", "text": "彼女は優秀だ。彼女は日本語が上手だ。彼女"}, {"type": "subtitle", "time": 10715.91, "timestamp": "02:58:35", "text": "認めたくないのは、"}, {"type": "subtitle", "time": 10717.83, "timestamp": "02:58:37", "text": "なんだか変な言い方ですね。しかし"}, {"type": "subtitle", "time": 10724.309, "timestamp": "02:58:44", "text": "日本人で、私たちは彼女をからかった"}, {"type": "subtitle", "time": 10737.67, "timestamp": "02:58:57", "text": "午前"}]
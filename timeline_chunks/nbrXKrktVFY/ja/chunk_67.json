[{"type": "subtitle", "time": 4020.15, "timestamp": "01:07:00", "text": "惑星。ええ、惑星を売りますよ。"}, {"type": "subtitle", "time": 4023.589, "timestamp": "01:07:03", "text": "惑星としての惑星。惑星空間。うん、"}, {"type": "subtitle", "time": 4025.589, "timestamp": "01:07:05", "text": "丸いボールみたいなもの。の"}, {"type": "subtitle", "time": 4028.75, "timestamp": "01:07:08", "text": "空に浮かぶ丸い球体。"}, {"type": "subtitle", "time": 4032.95, "timestamp": "01:07:12", "text": "おお。しかしそのためには、"}, {"type": "subtitle", "time": 4035.27, "timestamp": "01:07:15", "text": "惑星をどのように抽出しますか"}, {"type": "subtitle", "time": 4038.069, "timestamp": "01:07:18", "text": "そして売る？それは彼らの問題だ。誰"}, {"type": "subtitle", "time": 4044.95, "timestamp": "01:07:24", "text": "でも、今それってすごくお金がかかるよね。ああ、"}, {"type": "subtitle", "time": 4046.95, "timestamp": "01:07:26", "text": "神。うん。私は「わかった、だから"}, {"type": "subtitle", "time": 4048.71, "timestamp": "01:07:28", "text": "この惑星はダイヤモンドでできている。どうやって"}, {"type": "subtitle", "time": 4052.63, "timestamp": "01:07:32", "text": "それはいくらくらいで売れると思いますか？"}, {"type": "subtitle", "time": 4054.99, "timestamp": "01:07:34", "text": "ああ、それはそれで"}, {"type": "subtitle", "time": 4058.309, "timestamp": "01:07:38", "text": "多くの。彼らは想像できる、どのように"}, {"type": "subtitle", "time": 4060.15, "timestamp": "01:07:40", "text": "お金持ちのスポーツ選手には"}, {"type": "subtitle", "time": 4063.51, "timestamp": "01:07:43", "text": "宇宙。無限のゼロ。過ぎ去っていくので"}, {"type": "subtitle", "time": 4066.43, "timestamp": "01:07:46", "text": "それにはゼロがたくさん必要だ。ああ、"}, {"type": "subtitle", "time": 4069.19, "timestamp": "01:07:49", "text": "神。いいね！して、独占企業にしてやる。"}, {"type": "subtitle", "time": 4077.029, "timestamp": "01:07:57", "text": "だからエレン、もし火星に行きたいなら、"}, {"type": "subtitle", "time": 4079.349, "timestamp": "01:07:59", "text": "私を通さなければならない。"}]
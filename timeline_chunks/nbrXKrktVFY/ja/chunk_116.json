[{"type": "subtitle", "time": 6965.109, "timestamp": "01:56:05", "text": "執筆時に次のような場合"}, {"type": "subtitle", "time": 6968.709, "timestamp": "01:56:08", "text": "言葉遣いには気をつけなければならないし、"}, {"type": "subtitle", "time": 6971.75, "timestamp": "01:56:11", "text": "もの。ええ、なぜなら"}, {"type": "subtitle", "time": 6973.669, "timestamp": "01:56:13", "text": "執筆過程には多くのこと"}, {"type": "subtitle", "time": 6975.589, "timestamp": "01:56:15", "text": "誰かに似た声を出せる"}, {"type": "subtitle", "time": 6976.96, "timestamp": "01:56:16", "text": "退化する、"}, {"type": "subtitle", "time": 6978.31, "timestamp": "01:56:18", "text": "[音楽]"}, {"type": "subtitle", "time": 6982.31, "timestamp": "01:56:22", "text": "でも、具体的に説明する必要がある"}, {"type": "subtitle", "time": 6985.629, "timestamp": "01:56:25", "text": "あなたの言葉で。それはまるで、"}, {"type": "subtitle", "time": 6988.109, "timestamp": "01:56:28", "text": "ああ、彼女は"}, {"type": "subtitle", "time": 6990.47, "timestamp": "01:56:30", "text": "不規則に相互作用した"}, {"type": "subtitle", "time": 6991.87, "timestamp": "01:56:31", "text": "男性または"}, {"type": "subtitle", "time": 6993.99, "timestamp": "01:56:33", "text": "Rと言う代わりに何か"}, {"type": "subtitle", "time": 6999.83, "timestamp": "01:56:39", "text": "うん。"}, {"type": "subtitle", "time": 7001.589, "timestamp": "01:56:41", "text": "そしていくつかの言葉のようなものがあり、"}, {"type": "subtitle", "time": 7003.669, "timestamp": "01:56:43", "text": "あなたのような人を刺激して、ただ言うだけでは"}, {"type": "subtitle", "time": 7005.99, "timestamp": "01:56:45", "text": "声に出して言うと、"}, {"type": "subtitle", "time": 7009.109, "timestamp": "01:56:49", "text": "人々はそれらによって感情を揺さぶられることがある。"}, {"type": "subtitle", "time": 7010.95, "timestamp": "01:56:50", "text": "だから、別の言い方を使って言う必要がある"}, {"type": "subtitle", "time": 7018.79, "timestamp": "01:56:58", "text": "私は書くことが好きです。書くことは"}]
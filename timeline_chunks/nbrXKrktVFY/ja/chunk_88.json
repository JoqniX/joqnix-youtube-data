[{"type": "subtitle", "time": 5280.27, "timestamp": "01:28:00", "text": "と"}, {"type": "subtitle", "time": 5283.11, "timestamp": "01:28:03", "text": "自分。ああ、見て。ボブに言うべきだ"}, {"type": "subtitle", "time": 5284.47, "timestamp": "01:28:04", "text": "毎回ですが、私たちはこれを持っています"}, {"type": "subtitle", "time": 5285.669, "timestamp": "01:28:05", "text": "会話。私はこう思う、"}, {"type": "subtitle", "time": 5288.27, "timestamp": "01:28:08", "text": "おそらくその後停止した"}, {"type": "subtitle", "time": 5290.95, "timestamp": "01:28:10", "text": "自分。うん。まるで、まるで、あなたが持っていたように"}, {"type": "subtitle", "time": 5293.83, "timestamp": "01:28:13", "text": "好き嫌いのない、いい子みたいに。彼"}, {"type": "subtitle", "time": 5297.189, "timestamp": "01:28:17", "text": "トラブルに巻き込まれないんだよ、わかるだろ？"}, {"type": "subtitle", "time": 5299.87, "timestamp": "01:28:19", "text": "なぜ拷問するのか"}, {"type": "subtitle", "time": 5307.39, "timestamp": "01:28:27", "text": "まるで私だけ"}, {"type": "subtitle", "time": 5321.03, "timestamp": "01:28:41", "text": "私にとってはAです。ああ、どうぞ。今私は"}, {"type": "subtitle", "time": 5325.149, "timestamp": "01:28:45", "text": "ちょうど今のように私は喜んで"}, {"type": "subtitle", "time": 5327.83, "timestamp": "01:28:47", "text": "ベジタリアン。私は肉を食べません"}, {"type": "subtitle", "time": 5329.51, "timestamp": "01:28:49", "text": "私は動物が大好きだからです。私は気にしない"}, {"type": "subtitle", "time": 5332.79, "timestamp": "01:28:52", "text": "動物についてですが、肉は"}, {"type": "subtitle", "time": 5336.99, "timestamp": "01:28:56", "text": "私にはまずく感じる。"}]
[{"type": "subtitle", "time": 11589.11, "timestamp": "03:13:09", "text": "うん。あと、これ見た？"}, {"type": "subtitle", "time": 11592.429, "timestamp": "03:13:12", "text": "ジョーク？うん。ええと、多くのバリカンには"}, {"type": "subtitle", "time": 11596.15, "timestamp": "03:13:16", "text": "切り抜き事業を商業化した。"}, {"type": "subtitle", "time": 11598.07, "timestamp": "03:13:18", "text": "コマーシャル？あ、待って。ええと、"}, {"type": "subtitle", "time": 11601.67, "timestamp": "03:13:21", "text": "彼らが手に入れるホルのラジオガイドライン"}, {"type": "subtitle", "time": 11603.55, "timestamp": "03:13:23", "text": "支払い済み。"}, {"type": "subtitle", "time": 11607.349, "timestamp": "03:13:27", "text": "うん。私が見た人たちが働いているのと同じように"}, {"type": "subtitle", "time": 11609.55, "timestamp": "03:13:29", "text": "ない"}, {"type": "subtitle", "time": 11611.99, "timestamp": "03:13:31", "text": "クリッピング。以前と同じように、ただのファンだった"}, {"type": "subtitle", "time": 11614.469, "timestamp": "03:13:34", "text": "純粋な愛からそれをしている"}, {"type": "subtitle", "time": 11616.71, "timestamp": "03:13:36", "text": "彼らの推し。"}, {"type": "subtitle", "time": 11619.349, "timestamp": "03:13:39", "text": "それはまだほとんどですが、今は"}, {"type": "subtitle", "time": 11621.19, "timestamp": "03:13:41", "text": "見ない人や"}, {"type": "subtitle", "time": 11625.75, "timestamp": "03:13:45", "text": "YouTuberの動画クリップについて気にしています。"}, {"type": "subtitle", "time": 11628.229, "timestamp": "03:13:48", "text": "えっと、待って。だから、空洞が彼らに支払うか、"}, {"type": "subtitle", "time": 11630.389, "timestamp": "03:13:50", "text": "YouTubeのチャンネル広告収入または"}, {"type": "subtitle", "time": 11632.07, "timestamp": "03:13:52", "text": "何か？いいえ、他のYouTubeチャンネル"}, {"type": "subtitle", "time": 11634.229, "timestamp": "03:13:54", "text": "その目的はユーチューバーの動画を切り抜くこと"}, {"type": "subtitle", "time": 11636.8, "timestamp": "03:13:56", "text": "そして、そこから利益を得る。"}, {"type": "subtitle", "time": 11638.429, "timestamp": "03:13:58", "text": "[音楽]"}]
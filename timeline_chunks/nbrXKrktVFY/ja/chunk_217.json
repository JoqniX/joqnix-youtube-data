[{"type": "subtitle", "time": 13030.95, "timestamp": "03:37:10", "text": "でも、私にはわからない。私はたくさん持っているのが好きです"}, {"type": "subtitle", "time": 13033.19, "timestamp": "03:37:13", "text": "アイデアやアイデアのコストが高すぎる"}, {"type": "subtitle", "time": 13036.229, "timestamp": "03:37:16", "text": "お金。でも、まあいいか、って感じ。"}, {"type": "subtitle", "time": 13040.07, "timestamp": "03:37:20", "text": "誰に私の投資を説得すればいいでしょうか？"}, {"type": "subtitle", "time": 13042.11, "timestamp": "03:37:22", "text": "VTuber事務所？"}, {"type": "subtitle", "time": 13043.99, "timestamp": "03:37:23", "text": "[音楽]"}, {"type": "subtitle", "time": 13047.91, "timestamp": "03:37:27", "text": "ヤクが必要です。ヤゴかサクナが必要だ。"}, {"type": "subtitle", "time": 13050.469, "timestamp": "03:37:30", "text": "インド版。インド版。はい。"}, {"type": "subtitle", "time": 13052.87, "timestamp": "03:37:32", "text": "サクナは投資したかったので"}, {"type": "subtitle", "time": 13055.75, "timestamp": "03:37:35", "text": "VTuber事務所で誰も彼を望んでいなかった"}, {"type": "subtitle", "time": 13057.269, "timestamp": "03:37:37", "text": "お金。だから彼は「もういいや、俺は作る」"}, {"type": "subtitle", "time": 13064.63, "timestamp": "03:37:44", "text": "そしてヤゴはただ"}, {"type": "subtitle", "time": 13067.269, "timestamp": "03:37:47", "text": "アイドルの夢。"}, {"type": "chat", "time": 13067.713, "timestamp": "03:37:47", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "actually yeah that's a really good idea..."}, {"type": "subtitle", "time": 13079.03, "timestamp": "03:37:59", "text": "やる気のある男を見つける必要がある"}]
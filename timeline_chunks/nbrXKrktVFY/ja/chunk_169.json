[{"type": "subtitle", "time": 10143.429, "timestamp": "02:49:03", "text": "つまり、言語って本当に素晴らしいものですよね。"}, {"type": "subtitle", "time": 10145.91, "timestamp": "02:49:05", "text": "そうです。私はその祝福が自分に向けられたものだと思う"}, {"type": "subtitle", "time": 10148.11, "timestamp": "02:49:08", "text": "英語を学ぶ"}, {"type": "subtitle", "time": 10150.63, "timestamp": "02:49:10", "text": "どれほど役に立つか知らなかったので間違いでした"}, {"type": "subtitle", "time": 10161.51, "timestamp": "02:49:21", "text": "なぜなら、子供の頃、私の両親は"}, {"type": "subtitle", "time": 10165.349, "timestamp": "02:49:25", "text": "あの衛星放送のやつだよね？うん。そして"}, {"type": "subtitle", "time": 10167.03, "timestamp": "02:49:27", "text": "衛星放送のやつ。何が"}, {"type": "subtitle", "time": 10170.71, "timestamp": "02:49:30", "text": "間違っている。それはそれと関係があった。毎"}, {"type": "subtitle", "time": 10173.99, "timestamp": "02:49:33", "text": "漫画は英語で出てきました。"}, {"type": "subtitle", "time": 10175.429, "timestamp": "02:49:35", "text": "ヒンディー語のオプションがあったけど、私は"}, {"type": "subtitle", "time": 10176.79, "timestamp": "02:49:36", "text": "ボタンを押すと"}, {"type": "subtitle", "time": 10179.51, "timestamp": "02:49:39", "text": "ヒンディー語に翻訳します。"}, {"type": "subtitle", "time": 10181.83, "timestamp": "02:49:41", "text": "だから私はただOsworld、Bob the を見ている"}, {"type": "subtitle", "time": 10183.15, "timestamp": "02:49:43", "text": "ビルダー、"}, {"type": "subtitle", "time": 10186.23, "timestamp": "02:49:46", "text": "そして英語の漫画がたくさん"}, {"type": "subtitle", "time": 10189.03, "timestamp": "02:49:49", "text": "基本的な単語を教えてくれた"}, {"type": "subtitle", "time": 10190.87, "timestamp": "02:49:50", "text": "そして私はそれらの基本的な言葉を使うことができた"}, {"type": "subtitle", "time": 10195.51, "timestamp": "02:49:55", "text": "他の人々とオンラインで交流する。うん。"}]
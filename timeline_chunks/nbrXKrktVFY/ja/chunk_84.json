[{"type": "subtitle", "time": 5040.709, "timestamp": "01:24:00", "text": "それを食べると肥満になるはずだった"}, {"type": "subtitle", "time": 5045.55, "timestamp": "01:24:05", "text": "まるで私が"}, {"type": "subtitle", "time": 5048.47, "timestamp": "01:24:08", "text": "初めて朝食を食べた時のように食べていた"}, {"type": "subtitle", "time": 5050.87, "timestamp": "01:24:10", "text": "朝食にパラタを食べたんだよ。うん。"}, {"type": "subtitle", "time": 5053.75, "timestamp": "01:24:13", "text": "パラタ3枚のように、"}, {"type": "subtitle", "time": 5057.75, "timestamp": "01:24:17", "text": "ええと、牛乳をグラス一杯全部。それからしばらくして"}, {"type": "subtitle", "time": 5059.59, "timestamp": "01:24:19", "text": "学校に行く 私は学校に行くのが好きです"}, {"type": "subtitle", "time": 5061.91, "timestamp": "01:24:21", "text": "友達と一緒に、"}, {"type": "subtitle", "time": 5065.39, "timestamp": "01:24:25", "text": "学校で何か食べるのが好きです"}, {"type": "subtitle", "time": 5068.55, "timestamp": "01:24:28", "text": "そして学校では"}, {"type": "subtitle", "time": 5071.189, "timestamp": "01:24:31", "text": "昼食の時間になったら外食します"}, {"type": "subtitle", "time": 5073.99, "timestamp": "01:24:33", "text": "昼食の時間になったら、放課後に"}, {"type": "subtitle", "time": 5076.79, "timestamp": "01:24:36", "text": "家に帰ったら何か食べる"}, {"type": "subtitle", "time": 5081.03, "timestamp": "01:24:41", "text": "昼食を食べる、昼食ではなく、いつ食べるか分かるよね"}, {"type": "subtitle", "time": 5083.11, "timestamp": "01:24:43", "text": "あなたは学校から帰宅してから食事をします。"}, {"type": "subtitle", "time": 5085.189, "timestamp": "01:24:45", "text": "うん。うん。うん。夕食のおやつと"}, {"type": "subtitle", "time": 5088.39, "timestamp": "01:24:48", "text": "もの。うん。うん。それから食事をします。それから"}, {"type": "subtitle", "time": 5091.03, "timestamp": "01:24:51", "text": "私はまた友達と出かけます。"}, {"type": "subtitle", "time": 5093.99, "timestamp": "01:24:53", "text": "彼らと一緒に時間を過ごしたり、一緒に食事をしたりする。何？"}, {"type": "subtitle", "time": 5097.39, "timestamp": "01:24:57", "text": "そして、私は戻ってきます。わかった。食べる"}, {"type": "subtitle", "time": 5099.669, "timestamp": "01:24:59", "text": "夕食。そして夜遅く、私が"}]
[{"type": "subtitle", "time": 14941.349, "timestamp": "04:09:01", "text": "YouTubeと英語を話すインド人"}, {"type": "subtitle", "time": 14944.75, "timestamp": "04:09:04", "text": "YouTuberって感じだよね？うん。"}, {"type": "subtitle", "time": 14946.349, "timestamp": "04:09:06", "text": "それで"}, {"type": "subtitle", "time": 14950.55, "timestamp": "04:09:10", "text": "うん、何か起こるといいな。それは私です"}, {"type": "subtitle", "time": 14952.469, "timestamp": "04:09:12", "text": "言語の壁だとは思わないでください。私"}, {"type": "subtitle", "time": 14953.75, "timestamp": "04:09:13", "text": "それが言語だとは信じたくない"}, {"type": "subtitle", "time": 14956.309, "timestamp": "04:09:16", "text": "障壁は単に"}, {"type": "subtitle", "time": 14958.95, "timestamp": "04:09:18", "text": "インド人のユーチューバーが"}, {"type": "subtitle", "time": 14961.189, "timestamp": "04:09:21", "text": "英語のビデオとみんなが"}, {"type": "subtitle", "time": 14969.99, "timestamp": "04:09:29", "text": "右。うん。だから私は信じない"}, {"type": "subtitle", "time": 14971.75, "timestamp": "04:09:31", "text": "私はそれが"}, {"type": "subtitle", "time": 14974.79, "timestamp": "04:09:34", "text": "インドは言語の壁を考えている"}, {"type": "subtitle", "time": 14978.229, "timestamp": "04:09:38", "text": "多くの言語に対応している。たくさん。うん。 A"}, {"type": "subtitle", "time": 14982.389, "timestamp": "04:09:42", "text": "多く。だから私たちは話すことに問題ない"}, {"type": "subtitle", "time": 14985.83, "timestamp": "04:09:45", "text": "今の私たちの話をしないで、えっと、何"}, {"type": "subtitle", "time": 14987.429, "timestamp": "04:09:47", "text": "それをローカル言語と呼ぶのは"}, {"type": "subtitle", "time": 14989.99, "timestamp": "04:09:49", "text": "あなたがここに引っ越してくるのが好きなら、私たちはそれでいいと思っています"}, {"type": "subtitle", "time": 14991.75, "timestamp": "04:09:51", "text": "そしてその言語は地域全体に"}]
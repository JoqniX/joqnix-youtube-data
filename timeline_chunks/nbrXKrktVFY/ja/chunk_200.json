[{"type": "subtitle", "time": 12001.03, "timestamp": "03:20:01", "text": "「よし、みんな、配信するよ。」"}, {"type": "subtitle", "time": 12003.99, "timestamp": "03:20:03", "text": "じゃあまた後でね。"}, {"type": "subtitle", "time": 12006.11, "timestamp": "03:20:06", "text": "そして彼女は始めた"}, {"type": "subtitle", "time": 12018.79, "timestamp": "03:20:18", "text": "だから、希望があるように"}, {"type": "subtitle", "time": 12027.67, "timestamp": "03:20:27", "text": "インドについて何か見たことありますか？"}, {"type": "subtitle", "time": 12031.83, "timestamp": "03:20:31", "text": "そこにユーチューバーとかいるの？いいえ。そうです。"}, {"type": "subtitle", "time": 12034.55, "timestamp": "03:20:34", "text": "配信では言えないことだけ。"}, {"type": "subtitle", "time": 12036.03, "timestamp": "03:20:36", "text": "ああ、"}, {"type": "subtitle", "time": 12039.269, "timestamp": "03:20:39", "text": "神。あなたがそれを信じるか信じないかはわかりません"}, {"type": "subtitle", "time": 12043.349, "timestamp": "03:20:43", "text": "いいえ、私はVTからScarcapeのことを知りました。"}, {"type": "subtitle", "time": 12046.19, "timestamp": "03:20:46", "text": "バーモント州出身ですか？待って。うん。"}, {"type": "subtitle", "time": 12049.99, "timestamp": "03:20:49", "text": "本当に？えっと"}, {"type": "subtitle", "time": 12052.269, "timestamp": "03:20:52", "text": "えっと、何？そこには"}, {"type": "subtitle", "time": 12056.389, "timestamp": "03:20:56", "text": "インドのもの。何？確認しました"}, {"type": "subtitle", "time": 12059.03, "timestamp": "03:20:59", "text": "彼らは自分たちのユーチューバーを発表していた。"}]
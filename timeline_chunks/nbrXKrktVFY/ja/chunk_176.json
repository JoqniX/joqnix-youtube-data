[{"type": "subtitle", "time": 10561.79, "timestamp": "02:56:01", "text": "人生で唯一の欠点は彼女が"}, {"type": "subtitle", "time": 10568.87, "timestamp": "02:56:08", "text": "彼女はノンベ"}, {"type": "subtitle", "time": 10572.07, "timestamp": "02:56:12", "text": "マノン野菜を食べる"}, {"type": "subtitle", "time": 10573.83, "timestamp": "02:56:13", "text": "それまでは彼女は純粋だった"}, {"type": "subtitle", "time": 10583.19, "timestamp": "02:56:23", "text": "それが彼女の欠点だった。彼女が"}, {"type": "subtitle", "time": 10585.03, "timestamp": "02:56:25", "text": "1週間試してみた"}, {"type": "subtitle", "time": 10586.95, "timestamp": "02:56:26", "text": "ベジタリアン、先週私は"}, {"type": "subtitle", "time": 10591.11, "timestamp": "02:56:31", "text": "上。 「それは大変すぎる」と思った。"}, {"type": "subtitle", "time": 10592.87, "timestamp": "02:56:32", "text": "うん。"}, {"type": "subtitle", "time": 10595.469, "timestamp": "02:56:35", "text": "だから彼女はただ"}, {"type": "subtitle", "time": 10598.55, "timestamp": "02:56:38", "text": "上。一緒にビデオを作ったのを覚えているよ"}, {"type": "subtitle", "time": 10601.389, "timestamp": "02:56:41", "text": "まるで私たちが「えーと」って感じだった"}, {"type": "subtitle", "time": 10604.15, "timestamp": "02:56:44", "text": "ベジタリアンであることについて話しました"}, {"type": "subtitle", "time": 10606.23, "timestamp": "02:56:46", "text": "日本。"}, {"type": "subtitle", "time": 10609.03, "timestamp": "02:56:49", "text": "ああ、私はビデオを調べて、"}, {"type": "subtitle", "time": 10611.99, "timestamp": "02:56:51", "text": "すべては、ただ問題は私が"}, {"type": "subtitle", "time": 10613.99, "timestamp": "02:56:53", "text": "すべて英語で作成しました。だから私たちは"}, {"type": "subtitle", "time": 10615.389, "timestamp": "02:56:55", "text": "翻訳する必要があった"}]
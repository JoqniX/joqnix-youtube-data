[{"type": "subtitle", "time": 8822.63, "timestamp": "02:27:02", "text": "通常通り、2 つのビューがあります。あなたが知っている"}, {"type": "subtitle", "time": 8824.469, "timestamp": "02:27:04", "text": "2つの視点って何のことか分かりますよね？うん、2つ"}, {"type": "subtitle", "time": 8829.429, "timestamp": "02:27:09", "text": "見て、はい、4からそれを聞きました。"}, {"type": "subtitle", "time": 8831.91, "timestamp": "02:27:11", "text": "何てことだ。聞いたってどういう意味？"}, {"type": "subtitle", "time": 8835.349, "timestamp": "02:27:15", "text": "それ？はい、それを読み取らないでください。"}, {"type": "subtitle", "time": 8837.91, "timestamp": "02:27:17", "text": "私は「えっ？」って感じでした。聞こえましたか？それは"}, {"type": "subtitle", "time": 8841.59, "timestamp": "02:27:21", "text": "オウムの会話、ですよね？あのユーチューバー。"}, {"type": "subtitle", "time": 8843.99, "timestamp": "02:27:23", "text": "うん。私は普段VTに行くのですが"}, {"type": "subtitle", "time": 8846.389, "timestamp": "02:27:26", "text": "何が起こっているのか見てみたい。うん。"}, {"type": "subtitle", "time": 8848.87, "timestamp": "02:27:28", "text": "うん。なぜなら、私は時々外出するからです"}, {"type": "subtitle", "time": 8850.71, "timestamp": "02:27:30", "text": "ループと、まるで1つのスクロールのように"}, {"type": "subtitle", "time": 8852.23, "timestamp": "02:27:32", "text": "みんな堕落者だ"}, {"type": "subtitle", "time": 8855.75, "timestamp": "02:27:35", "text": "ここ。戻る時間だ。"}, {"type": "subtitle", "time": 8857.429, "timestamp": "02:27:37", "text": "私は、私は、私は、"}, {"type": "subtitle", "time": 8860.23, "timestamp": "02:27:40", "text": "VTの人たちは時々。"}, {"type": "subtitle", "time": 8861.59, "timestamp": "02:27:41", "text": "彼らは面白い。"}, {"type": "subtitle", "time": 8864.23, "timestamp": "02:27:44", "text": "うん、"}, {"type": "subtitle", "time": 8865.91, "timestamp": "02:27:45", "text": "私は情報のほとんどを"}, {"type": "subtitle", "time": 8868.07, "timestamp": "02:27:48", "text": "YouTuberやその他のものに関して"}, {"type": "subtitle", "time": 8873.83, "timestamp": "02:27:53", "text": "これまでと同じように、どれくらいかわかりません"}, {"type": "subtitle", "time": 8875.429, "timestamp": "02:27:55", "text": "使用してからずいぶん経ちました"}]
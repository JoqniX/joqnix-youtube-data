[{"type": "subtitle", "time": 12424.469, "timestamp": "03:27:04", "text": "そして私は、それはどのファンダムにもあるけど"}, {"type": "subtitle", "time": 12426.389, "timestamp": "03:27:06", "text": "インドのファンは、あることをします。"}, {"type": "subtitle", "time": 12429.99, "timestamp": "03:27:09", "text": "めちゃくちゃイライラする。マジで大嫌い。"}, {"type": "subtitle", "time": 12432.07, "timestamp": "03:27:12", "text": "彼らはアニメを低俗化して、"}, {"type": "subtitle", "time": 12435.349, "timestamp": "03:27:15", "text": "まるでそれが上位版であるかのように振る舞う。"}, {"type": "subtitle", "time": 12437.19, "timestamp": "03:27:17", "text": "うん、"}, {"type": "subtitle", "time": 12441.11, "timestamp": "03:27:21", "text": "進撃の巨人のヒンディー語吹き替え版みたいに。"}, {"type": "subtitle", "time": 12443.11, "timestamp": "03:27:23", "text": "なぜ人々がそう思わないのか分からない"}, {"type": "subtitle", "time": 12445.71, "timestamp": "03:27:25", "text": "進撃の巨人のようなアニメではなく、"}, {"type": "subtitle", "time": 12448.309, "timestamp": "03:27:28", "text": "アニメを見たくない理由は"}, {"type": "subtitle", "time": 12449.79, "timestamp": "03:27:29", "text": "彼らはこれらを置いた"}, {"type": "subtitle", "time": 12451.91, "timestamp": "03:27:31", "text": "同じことをしているかのように参照する"}, {"type": "subtitle", "time": 12453.91, "timestamp": "03:27:33", "text": "マーベル映画みたいに"}, {"type": "subtitle", "time": 12456.55, "timestamp": "03:27:36", "text": "マーベル映画を吹き替えるとき、"}, {"type": "subtitle", "time": 12463.75, "timestamp": "03:27:43", "text": "素晴らしい例が、私が"}, {"type": "subtitle", "time": 12468.79, "timestamp": "03:27:48", "text": "エンドゲームを見て、"}, {"type": "subtitle", "time": 12471.11, "timestamp": "03:27:51", "text": "トールは目覚めようとしていた"}, {"type": "subtitle", "time": 12475.71, "timestamp": "03:27:55", "text": "右。ソーはエイリアンによって目を覚まされた"}]
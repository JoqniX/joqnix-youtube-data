[{"type": "subtitle", "time": 2342.31, "timestamp": "00:39:02", "text": "ある特定の時間に家が。私の私の"}, {"type": "subtitle", "time": 2344.31, "timestamp": "00:39:04", "text": "親はただ「わかった、あなたは何をしているの？」と言うだけです"}, {"type": "subtitle", "time": 2346.39, "timestamp": "00:39:06", "text": "薬物？私は「いや、わかった」って感じで、それでは全部"}, {"type": "subtitle", "time": 2349.349, "timestamp": "00:39:09", "text": "大丈夫です。"}, {"type": "subtitle", "time": 2351.67, "timestamp": "00:39:11", "text": "だから彼らはとても落ち着いているんです。"}, {"type": "subtitle", "time": 2353.349, "timestamp": "00:39:13", "text": "彼らは落ち着いていない。彼らは私に近い"}, {"type": "subtitle", "time": 2355.75, "timestamp": "00:39:15", "text": "私は彼らをとても拷問したので"}, {"type": "subtitle", "time": 2359.109, "timestamp": "00:39:19", "text": "彼らは期待値が低すぎる。"}, {"type": "subtitle", "time": 2360.55, "timestamp": "00:39:20", "text": "彼らは、あなたは、あなたは、"}, {"type": "subtitle", "time": 2363.19, "timestamp": "00:39:23", "text": "犯罪？あなたは死にかけているのですか？私は「いやだ」って感じ。彼らは"}, {"type": "subtitle", "time": 2370.23, "timestamp": "00:39:30", "text": "大丈夫、子供の頃は私は"}, {"type": "subtitle", "time": 2372.71, "timestamp": "00:39:32", "text": "あなたのように、才能のある人を何と呼ぶのですか？"}, {"type": "subtitle", "time": 2375.829, "timestamp": "00:39:35", "text": "彼らによれば子供"}, {"type": "subtitle", "time": 2379.19, "timestamp": "00:39:39", "text": "だから、私がそうでないことをしたときはいつでも"}, {"type": "subtitle", "time": 2380.349, "timestamp": "00:39:40", "text": "で"}, {"type": "subtitle", "time": 2384.55, "timestamp": "00:39:44", "text": "あなたとは違う角度"}, {"type": "subtitle", "time": 2387.75, "timestamp": "00:39:47", "text": "インドの親が正しい理由を知る"}, {"type": "subtitle", "time": 2389.75, "timestamp": "00:39:49", "text": "彼らの言うことを聞かない場合は"}, {"type": "subtitle", "time": 2391.27, "timestamp": "00:39:51", "text": "君は史上最悪の存在だ"}, {"type": "subtitle", "time": 2393.63, "timestamp": "00:39:53", "text": "偶然にも"}, {"type": "subtitle", "time": 2396.109, "timestamp": "00:39:56", "text": "ええ、その通りです。"}, {"type": "subtitle", "time": 2399.99, "timestamp": "00:39:59", "text": "母は私にエンジニアになってほしかったんです。"}]
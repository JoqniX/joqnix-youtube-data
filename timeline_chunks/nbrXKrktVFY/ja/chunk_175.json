[{"type": "subtitle", "time": 10500.55, "timestamp": "02:55:00", "text": "うん。そして私は基本的に一人暮らしで、"}, {"type": "subtitle", "time": 10504.309, "timestamp": "02:55:04", "text": "まるで私が家賃を払わないのと同じだ。それは"}, {"type": "subtitle", "time": 10505.07, "timestamp": "02:55:05", "text": "1つ"}, {"type": "subtitle", "time": 10507.83, "timestamp": "02:55:07", "text": "例外。それ以外の場合は、私はすべてを"}, {"type": "subtitle", "time": 10527.71, "timestamp": "02:55:27", "text": "しかし、あなたは日本へ引っ越すことになります。"}, {"type": "subtitle", "time": 10532.15, "timestamp": "02:55:32", "text": "ああ、心配だよ。それはとても"}, {"type": "subtitle", "time": 10535.51, "timestamp": "02:55:35", "text": "今、カルチャーショックを受けている。いいえ、私の友達のように"}, {"type": "subtitle", "time": 10537.83, "timestamp": "02:55:37", "text": "私の友達の一人は"}, {"type": "subtitle", "time": 10539.59, "timestamp": "02:55:39", "text": "交換"}, {"type": "subtitle", "time": 10543.349, "timestamp": "02:55:43", "text": "彼女を日本に送るプログラム"}, {"type": "subtitle", "time": 10547.59, "timestamp": "02:55:47", "text": "そして、そのうちの1つをインドに持っていく。ああ、交換"}, {"type": "subtitle", "time": 10550.429, "timestamp": "02:55:50", "text": "学生たち。"}, {"type": "subtitle", "time": 10553.429, "timestamp": "02:55:53", "text": "おお。そして彼女はそこに2年間住んでいたと思う"}, {"type": "subtitle", "time": 10557.03, "timestamp": "02:55:57", "text": "何年も経って、彼女は言った、まるで彼女が言ったように"}, {"type": "subtitle", "time": 10558.71, "timestamp": "02:55:58", "text": "まるで彼女にとって最高の2年間だったかのように"}]
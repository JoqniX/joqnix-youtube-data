[{"type": "subtitle", "time": 2161.109, "timestamp": "00:36:01", "text": "あと数日。私には時間があります。"}, {"type": "subtitle", "time": 2163.51, "timestamp": "00:36:03", "text": "6月の第2週。その後、私は"}, {"type": "subtitle", "time": 2165.829, "timestamp": "00:36:05", "text": "荷物をまとめる、といった感じ。 2週目。 2番"}, {"type": "subtitle", "time": 2168.31, "timestamp": "00:36:08", "text": "6月の週。そして私の試験は"}, {"type": "subtitle", "time": 2171.15, "timestamp": "00:36:11", "text": "3週目ですが、"}, {"type": "subtitle", "time": 2174.47, "timestamp": "00:36:14", "text": "勉強したけど、まあいいけど、まあ"}, {"type": "subtitle", "time": 2176.51, "timestamp": "00:36:16", "text": "荷物をまとめなければならない"}, {"type": "subtitle", "time": 2180.47, "timestamp": "00:36:20", "text": "すべて。うん。うん。どうやって"}, {"type": "subtitle", "time": 2183.19, "timestamp": "00:36:23", "text": "そんな複雑な人生を送るの？私"}, {"type": "subtitle", "time": 2185.43, "timestamp": "00:36:25", "text": "わからない、私にはできない、私にはできない"}, {"type": "subtitle", "time": 2189.67, "timestamp": "00:36:29", "text": "例えば、10個のことをしなければならないとしたら"}, {"type": "subtitle", "time": 2191.589, "timestamp": "00:36:31", "text": "朝、私が何をしたいかあなたに知ってもらいたい"}, {"type": "subtitle", "time": 2194.87, "timestamp": "00:36:34", "text": "死ぬべきだ。私には無理です。私の"}, {"type": "subtitle", "time": 2202.31, "timestamp": "00:36:42", "text": "これ。私が人々に言うように"}, {"type": "subtitle", "time": 2204.47, "timestamp": "00:36:44", "text": "日々のスケジュールと"}, {"type": "subtitle", "time": 2205.99, "timestamp": "00:36:45", "text": "彼らはオレンジ色で、あなたは3つ暮らしています"}, {"type": "subtitle", "time": 2207.99, "timestamp": "00:36:47", "text": "人生？私は、いや、ただ私は"}, {"type": "subtitle", "time": 2210.63, "timestamp": "00:36:50", "text": "自分の仕事に本当に情熱を注いでいます"}, {"type": "subtitle", "time": 2212.39, "timestamp": "00:36:52", "text": "特にストリーミング配信を見るようなことについて。"}, {"type": "subtitle", "time": 2214.23, "timestamp": "00:36:54", "text": "私は、今日は"}, {"type": "subtitle", "time": 2217.51, "timestamp": "00:36:57", "text": "見せるのはストリームになる"}, {"type": "subtitle", "time": 2219.67, "timestamp": "00:36:59", "text": "ストリーミング配信する。オーケー、シーナも行くよ"}]
[{"type": "subtitle", "time": 14461.51, "timestamp": "04:01:01", "text": "えっと、最初のインド人ユーチューバーは誰？"}, {"type": "subtitle", "time": 14463.51, "timestamp": "04:01:03", "text": "スタースケープが、えーと"}, {"type": "subtitle", "time": 14465.269, "timestamp": "04:01:05", "text": "トラブルは、彼らが始めるから"}, {"type": "subtitle", "time": 14466.87, "timestamp": "04:01:06", "text": "自分たちを"}, {"type": "subtitle", "time": 14474.389, "timestamp": "04:01:14", "text": "そして私は、彼らはそうしていると思った。私は"}, {"type": "subtitle", "time": 14477.51, "timestamp": "04:01:17", "text": "いや、そうかもしれない。"}, {"type": "subtitle", "time": 14479.11, "timestamp": "04:01:19", "text": "私は「ああ、そうかもしれないね」と思った。"}, {"type": "subtitle", "time": 14490.91, "timestamp": "04:01:30", "text": "うん、だってスタスが最初だから"}, {"type": "subtitle", "time": 14493.83, "timestamp": "04:01:33", "text": "インドの代理店、ユーチュービング代理店、そして"}, {"type": "subtitle", "time": 14496.389, "timestamp": "04:01:36", "text": "すべて。いいえ、"}, {"type": "subtitle", "time": 14500.63, "timestamp": "04:01:40", "text": "そんな感じ。だから、彼らのほうが"}, {"type": "subtitle", "time": 14503.67, "timestamp": "04:01:43", "text": "今すぐリーチして広告を詰め込み、"}, {"type": "subtitle", "time": 14505.67, "timestamp": "04:01:45", "text": "すべて。より多くの人が知るようになった"}, {"type": "subtitle", "time": 14508.389, "timestamp": "04:01:48", "text": "そして人々は自動的に"}, {"type": "subtitle", "time": 14510.469, "timestamp": "04:01:50", "text": "星空みたいだね"}, {"type": "subtitle", "time": 14512.79, "timestamp": "04:01:52", "text": "えーと、ZanaのようなYouTuberが最初"}, {"type": "subtitle", "time": 14515.269, "timestamp": "04:01:55", "text": "YouTuberなど"}, {"type": "subtitle", "time": 14517.59, "timestamp": "04:01:57", "text": "誰が最初か知ってる？知っていましたか？"}, {"type": "subtitle", "time": 14519.429, "timestamp": "04:01:59", "text": "最初の真のインド人が誰か知っていますか？"}]
[{"type": "subtitle", "time": 3423.109, "timestamp": "00:57:03", "text": "どれだけ知らないかによりますね。なんてこった。"}, {"type": "subtitle", "time": 3426.309, "timestamp": "00:57:06", "text": "私はこういうことには全く詳しくないんです。"}, {"type": "subtitle", "time": 3428.63, "timestamp": "00:57:08", "text": "それについて学ぶべきです。私は試しました"}, {"type": "subtitle", "time": 3430.47, "timestamp": "00:57:10", "text": "それについて学んでいる。私はおそらく100歳です"}, {"type": "subtitle", "time": 3432.39, "timestamp": "00:57:12", "text": "私が何を言っているにせよ、それを真に受けないでください"}, {"type": "subtitle", "time": 3435.99, "timestamp": "00:57:15", "text": "アドバイスとして。私は自分が完全にではないことを知っています"}, {"type": "subtitle", "time": 3438.069, "timestamp": "00:57:18", "text": "この件について教育を受けている。私はただ物事を知っているだけです"}, {"type": "subtitle", "time": 3444.39, "timestamp": "00:57:24", "text": "だから、会計士を雇うか、"}, {"type": "subtitle", "time": 3446.95, "timestamp": "00:57:26", "text": "まるでそれが税金であるかのように支払わなければならない"}, {"type": "subtitle", "time": 3449.27, "timestamp": "00:57:29", "text": "もしあなたが持っているなら、もしあなたが持っているなら、私は知っています。"}, {"type": "subtitle", "time": 3452.71, "timestamp": "00:57:32", "text": "支払う金額は多く、会計士を雇うと、"}, {"type": "subtitle", "time": 3454.15, "timestamp": "00:57:34", "text": "あまりお金を払わなくてもいいから"}, {"type": "subtitle", "time": 3456.62, "timestamp": "00:57:36", "text": "家族がそれを行う"}, {"type": "subtitle", "time": 3459.349, "timestamp": "00:57:39", "text": "[音楽]"}, {"type": "subtitle", "time": 3461.15, "timestamp": "00:57:41", "text": "しかしそれとは別に"}, {"type": "subtitle", "time": 3464.549, "timestamp": "00:57:44", "text": "あまり好きじゃないし、よく知らない"}, {"type": "subtitle", "time": 3471.67, "timestamp": "00:57:51", "text": "世界はとても広い。彼らは働くので"}, {"type": "subtitle", "time": 3474.99, "timestamp": "00:57:54", "text": "奇妙で、これまでとは違った形で。"}, {"type": "subtitle", "time": 3478.95, "timestamp": "00:57:58", "text": "ええ、私は今でも"}]
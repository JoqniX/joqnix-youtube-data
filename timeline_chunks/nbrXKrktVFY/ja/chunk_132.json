[{"type": "subtitle", "time": 7921.91, "timestamp": "02:12:01", "text": "それは、私が電話するのが好きなようなものです。"}, {"type": "subtitle", "time": 7924.629, "timestamp": "02:12:04", "text": "私の学校ではいたずら電話が大好きでした"}, {"type": "subtitle", "time": 7927.27, "timestamp": "02:12:07", "text": "ランダムなもの"}, {"type": "subtitle", "time": 7929.589, "timestamp": "02:12:09", "text": "ほら、僕たちがやったいたずらがあったんだ"}, {"type": "subtitle", "time": 7932.39, "timestamp": "02:12:12", "text": "同じような学校で。だから私たちはあなたと同じように"}, {"type": "subtitle", "time": 7935.109, "timestamp": "02:12:15", "text": "知ってるよ、あれは地理的な何かだったんだ。"}, {"type": "subtitle", "time": 7938.47, "timestamp": "02:12:18", "text": "当時は全てが無料だった。"}, {"type": "subtitle", "time": 7941.27, "timestamp": "02:12:21", "text": "それで、私には友達がいて、彼の名前はえーと"}, {"type": "subtitle", "time": 7942.109, "timestamp": "02:12:22", "text": "さあ"}, {"type": "subtitle", "time": 7945.35, "timestamp": "02:12:25", "text": "スージーは言った。"}, {"type": "subtitle", "time": 7948.75, "timestamp": "02:12:28", "text": "それで、スージーと私は、二人とも新しい"}, {"type": "subtitle", "time": 7952.669, "timestamp": "02:12:32", "text": "電話、新しいSIMみたいで、私たちはこう思った。"}, {"type": "subtitle", "time": 7955.27, "timestamp": "02:12:35", "text": "「えっ、知ってる？俺たちは俺たちだ"}, {"type": "subtitle", "time": 7957.589, "timestamp": "02:12:37", "text": "他にすることがない。それでは"}, {"type": "subtitle", "time": 7961.43, "timestamp": "02:12:41", "text": "Jioの連中にいたずら電話をかける。"}, {"type": "subtitle", "time": 7964.79, "timestamp": "02:12:44", "text": "それで、彼は私に電話を渡した。私は電話しました"}, {"type": "subtitle", "time": 7966.95, "timestamp": "02:12:46", "text": "彼ら。 「わかりました、それで、"}, {"type": "subtitle", "time": 7970.51, "timestamp": "02:12:50", "text": "この問題。私には友達がいます"}, {"type": "subtitle", "time": 7974.47, "timestamp": "02:12:54", "text": "スージー。彼のインターネット接続は遅い。私のインターネット"}, {"type": "subtitle", "time": 7978.39, "timestamp": "02:12:58", "text": "速すぎるですよね？そして私たちは隣に住んでいます"}]
[{"type": "subtitle", "time": 9421.75, "timestamp": "02:37:01", "text": "彼はどうやってそれをやっているのだろうか？最近のように"}, {"type": "subtitle", "time": 9423.67, "timestamp": "02:37:03", "text": "ハッサンは、"}, {"type": "subtitle", "time": 9427.429, "timestamp": "02:37:07", "text": "インド亜大陸。はい。はい。私は自分の"}, {"type": "subtitle", "time": 9428.95, "timestamp": "02:37:08", "text": "ハッサンについて話している友人たち"}, {"type": "subtitle", "time": 9430.55, "timestamp": "02:37:10", "text": "インドの友人たち。そして私は、なぜ"}, {"type": "subtitle", "time": 9432.469, "timestamp": "02:37:12", "text": "ハッサンについて何の話をしてるんだ？"}, {"type": "subtitle", "time": 9435.03, "timestamp": "02:37:15", "text": "まるで「ああ、あなたは知らないのね」という感じだ。私は"}, {"type": "subtitle", "time": 9437.11, "timestamp": "02:37:17", "text": "わかった、私は知りすぎているけど、どれどれ"}, {"type": "subtitle", "time": 9438.59, "timestamp": "02:37:18", "text": "一部はそうしない"}, {"type": "subtitle", "time": 9441.19, "timestamp": "02:37:21", "text": "知る？彼は、ハッサンは"}, {"type": "subtitle", "time": 9442.95, "timestamp": "02:37:22", "text": "この件に関してパキスタンを支持し、"}, {"type": "subtitle", "time": 9445.51, "timestamp": "02:37:25", "text": "そしてインドをこうこうと呼んだ。そして"}, {"type": "subtitle", "time": 9447.83, "timestamp": "02:37:27", "text": "私は"}, {"type": "subtitle", "time": 9450.07, "timestamp": "02:37:30", "text": "私にとってこれは私が"}, {"type": "subtitle", "time": 9453.99, "timestamp": "02:37:33", "text": "持っている。ハッサンがこれをやっていると思う"}, {"type": "subtitle", "time": 9457.59, "timestamp": "02:37:37", "text": "これらは意図的に行われたものです。うん。私は思う"}, {"type": "subtitle", "time": 9461.51, "timestamp": "02:37:41", "text": "彼は怒りを煽っている。"}, {"type": "subtitle", "time": 9463.349, "timestamp": "02:37:43", "text": "だって、絶対に誰かが"}, {"type": "subtitle", "time": 9466.55, "timestamp": "02:37:46", "text": "バカだ。"}, {"type": "subtitle", "time": 9469.27, "timestamp": "02:37:49", "text": "彼はある意味では賢い人だ"}, {"type": "subtitle", "time": 9471.429, "timestamp": "02:37:51", "text": "そして彼はいくつかの点で愚かで、"}, {"type": "subtitle", "time": 9475.07, "timestamp": "02:37:55", "text": "議論の仕方を心得ている。うん。"}, {"type": "subtitle", "time": 9477.349, "timestamp": "02:37:57", "text": "右。だから人々は彼を見ているんだ"}, {"type": "subtitle", "time": 9479.91, "timestamp": "02:37:59", "text": "彼は話し方を知っているからだ。"}]
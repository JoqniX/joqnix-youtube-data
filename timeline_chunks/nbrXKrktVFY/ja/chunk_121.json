[{"type": "subtitle", "time": 7264.87, "timestamp": "02:01:04", "text": "日本語風に言うと、まあそんな感じ。"}, {"type": "subtitle", "time": 7270.31, "timestamp": "02:01:10", "text": "うん。私たちはチュバです。ああ、そうだね。うん。"}, {"type": "subtitle", "time": 7277.75, "timestamp": "02:01:17", "text": "だから、私はアクセントをよく使うんです。私はしません"}, {"type": "subtitle", "time": 7279.669, "timestamp": "02:01:19", "text": "人々が指摘したがる理由を知っている"}, {"type": "subtitle", "time": 7280.75, "timestamp": "02:01:20", "text": "のように"}, {"type": "subtitle", "time": 7283.75, "timestamp": "02:01:23", "text": "ああ、この人はアクセントを使って"}, {"type": "subtitle", "time": 7285.709, "timestamp": "02:01:25", "text": "悪い"}, {"type": "subtitle", "time": 7288.07, "timestamp": "02:01:28", "text": "なぜなら、私はそれを見ているからです"}, {"type": "subtitle", "time": 7295.589, "timestamp": "02:01:35", "text": "私がインド人によく見かけるのはそういうことです"}, {"type": "subtitle", "time": 7298.31, "timestamp": "02:01:38", "text": "アクセントを使うとき。"}, {"type": "subtitle", "time": 7299.75, "timestamp": "02:01:39", "text": "「ああ、あなたは自分が優れていると思っているのね」"}, {"type": "subtitle", "time": 7302.149, "timestamp": "02:01:42", "text": "私たちよりも？ 「自慢してるね。」"}, {"type": "subtitle", "time": 7312.31, "timestamp": "02:01:52", "text": "でも私はウェールズ人だった"}, {"type": "subtitle", "time": 7314.629, "timestamp": "02:01:54", "text": "アクセント、信じられないかもしれないが、私が"}]
[{"type": "subtitle", "time": 10981.51, "timestamp": "03:03:01", "text": "XQCは、彼が言っていたように、彼はそうしない"}, {"type": "subtitle", "time": 10983.429, "timestamp": "03:03:03", "text": "彼が単にRワードを使うように"}, {"type": "subtitle", "time": 10986.71, "timestamp": "03:03:06", "text": "ファンに会ったんだけど、彼は精神的に"}, {"type": "subtitle", "time": 10989.269, "timestamp": "03:03:09", "text": "中身が実際には何だったのか、という感じの物。"}, {"type": "subtitle", "time": 10991.429, "timestamp": "03:03:11", "text": "クリップ。うん。だから彼は始めた"}, {"type": "subtitle", "time": 10995.23, "timestamp": "03:03:15", "text": "使用をやめた。私は「うん、できるよ」って感じ"}, {"type": "subtitle", "time": 10999.13, "timestamp": "03:03:19", "text": "あなたのファンがそうであるかのように起こる。"}, {"type": "subtitle", "time": 11012.309, "timestamp": "03:03:32", "text": "ほとんどの人は本当に知っている"}, {"type": "subtitle", "time": 11021.83, "timestamp": "03:03:41", "text": "そして、私はそう信じたいのです。"}, {"type": "subtitle", "time": 11023.87, "timestamp": "03:03:43", "text": "みんな親切です"}, {"type": "subtitle", "time": 11028.15, "timestamp": "03:03:48", "text": "宇宙。みんな幸せだ。うん。ない"}, {"type": "subtitle", "time": 11037.91, "timestamp": "03:03:57", "text": "だからそういうことなんだ"}]
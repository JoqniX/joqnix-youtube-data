[{"type": "subtitle", "time": 9600.389, "timestamp": "02:40:00", "text": "そして、アスミンが意地悪な人たちにどう対処するかが好きだ"}, {"type": "subtitle", "time": 9601.83, "timestamp": "02:40:01", "text": "コメントも。人々が彼を呼ぶように"}, {"type": "subtitle", "time": 9606.07, "timestamp": "02:40:06", "text": "ハゲ。うん。彼は「ああ、それは"}, {"type": "subtitle", "time": 9613.51, "timestamp": "02:40:13", "text": "つまり、だから私は思った"}, {"type": "subtitle", "time": 9616.71, "timestamp": "02:40:16", "text": "えーと、もし私が平均を作ったら"}, {"type": "subtitle", "time": 9619.469, "timestamp": "02:40:19", "text": "物事は意地悪に聞こえる、それからそれは"}, {"type": "subtitle", "time": 9624.389, "timestamp": "02:40:24", "text": "意地悪だよね？うん。言葉は私を傷つけることはできない"}, {"type": "subtitle", "time": 9626.389, "timestamp": "02:40:26", "text": "基本的に"}, {"type": "subtitle", "time": 9628.55, "timestamp": "02:40:28", "text": "私がそうさせなければ。そして私はこれを持っていた"}, {"type": "subtitle", "time": 9630.55, "timestamp": "02:40:30", "text": "子供の頃の哲学みたいな感じ"}, {"type": "subtitle", "time": 9633.11, "timestamp": "02:40:33", "text": "学校では、人々はあなたを意地悪な人と呼びます"}, {"type": "subtitle", "time": 9635.67, "timestamp": "02:40:35", "text": "もの。うん。"}, {"type": "subtitle", "time": 9637.83, "timestamp": "02:40:37", "text": "そして彼らが私にそれらのことを言うとき、"}, {"type": "subtitle", "time": 9641.03, "timestamp": "02:40:41", "text": "ああ、これはただの言葉だよ、って感じ。"}, {"type": "subtitle", "time": 9642.87, "timestamp": "02:40:42", "text": "彼は私の"}, {"type": "subtitle", "time": 9644.95, "timestamp": "02:40:44", "text": "母親。"}, {"type": "subtitle", "time": 9648.95, "timestamp": "02:40:48", "text": "彼は私の母親と寝ていないことは分かっている。"}, {"type": "subtitle", "time": 9650.87, "timestamp": "02:40:50", "text": "彼はただ吠えているだけだ。"}, {"type": "subtitle", "time": 9653.99, "timestamp": "02:40:53", "text": "うん。ヒンディー語のように"}, {"type": "subtitle", "time": 9656.389, "timestamp": "02:40:56", "text": "ヒンディー語のガリアで大丈夫ですか？"}, {"type": "subtitle", "time": 9658.309, "timestamp": "02:40:58", "text": "私の私にストリームで彼らに言う"}]
[{"type": "subtitle", "time": 2705.51, "timestamp": "00:45:05", "text": "偶然、えっと、変なことがあったんです"}, {"type": "subtitle", "time": 2709.829, "timestamp": "00:45:09", "text": "安全ピンを使用する際の行動"}, {"type": "subtitle", "time": 2714.309, "timestamp": "00:45:14", "text": "安全ピンを抜くように"}, {"type": "subtitle", "time": 2717.829, "timestamp": "00:45:17", "text": "肌というよりは、えっと、私は"}, {"type": "subtitle", "time": 2719.43, "timestamp": "00:45:19", "text": "昔はただ遊んでいた理由がわかる"}, {"type": "subtitle", "time": 2722.15, "timestamp": "00:45:22", "text": "安全ピン。わかった。うん。私の姉"}, {"type": "subtitle", "time": 2724.55, "timestamp": "00:45:24", "text": "よくそうする。ええ、私は彼女に教えました"}, {"type": "subtitle", "time": 2727.03, "timestamp": "00:45:27", "text": "これについてはたくさんあります。"}, {"type": "subtitle", "time": 2729.349, "timestamp": "00:45:29", "text": "指とかと同じように、ただ"}, {"type": "subtitle", "time": 2732.15, "timestamp": "00:45:32", "text": "気に入っても、それほど害はないでしょう。その"}, {"type": "subtitle", "time": 2734.47, "timestamp": "00:45:34", "text": "まるで肌を手に入れているみたい"}, {"type": "subtitle", "time": 2736.23, "timestamp": "00:45:36", "text": "少しだけ「うん」と答える。まるで"}, {"type": "subtitle", "time": 2738.069, "timestamp": "00:45:38", "text": "まるで皮膚を伸ばすように"}, {"type": "subtitle", "time": 2739.91, "timestamp": "00:45:39", "text": "そして、どこまで引っ張れるかを見る"}, {"type": "subtitle", "time": 2742.069, "timestamp": "00:45:42", "text": "それ。うん。私の妹のように、私の妹"}, {"type": "subtitle", "time": 2744.55, "timestamp": "00:45:44", "text": "これを説明してくれたんだけど、私はこう思ったんだけど"}, {"type": "subtitle", "time": 2747.349, "timestamp": "00:45:47", "text": "なぜ？わかった。彼女は「私はそうは思わない」"}, {"type": "subtitle", "time": 2749.19, "timestamp": "00:45:49", "text": "知る。彼女は私の脳をくすぐる。私は"}, {"type": "subtitle", "time": 2752.05, "timestamp": "00:45:52", "text": "わかった。"}, {"type": "subtitle", "time": 2753.63, "timestamp": "00:45:53", "text": "[音楽]"}, {"type": "subtitle", "time": 2755.02, "timestamp": "00:45:55", "text": "うん、そんな感じ"}, {"type": "subtitle", "time": 2756.75, "timestamp": "00:45:56", "text": "[音楽]"}]
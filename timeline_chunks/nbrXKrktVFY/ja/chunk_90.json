[{"type": "subtitle", "time": 5400.629, "timestamp": "01:30:00", "text": "「ああ、気持ち悪いものがたくさんあった」"}, {"type": "subtitle", "time": 5402.87, "timestamp": "01:30:02", "text": "中に詰め込んで、それを食べるつもりだ"}, {"type": "subtitle", "time": 5411.03, "timestamp": "01:30:11", "text": "うわぁ。つまり、それが全てではなかったのですが、"}, {"type": "subtitle", "time": 5414.87, "timestamp": "01:30:14", "text": "でも、肉はそうじゃない、なんていうか、"}, {"type": "subtitle", "time": 5419.35, "timestamp": "01:30:19", "text": "私にとっては美味しい"}, {"type": "subtitle", "time": 5421.35, "timestamp": "01:30:21", "text": "何らかの理由で。だから私はただ一日だけ"}, {"type": "subtitle", "time": 5423.669, "timestamp": "01:30:23", "text": "私はただ、私たちが話していたように"}, {"type": "subtitle", "time": 5427.11, "timestamp": "01:30:27", "text": "モモを食べている友達が言った"}, {"type": "subtitle", "time": 5429.51, "timestamp": "01:30:29", "text": "肉がパサパサしていると文句を言っていた"}, {"type": "subtitle", "time": 5431.99, "timestamp": "01:30:31", "text": "それは私たちが結婚式に行ったからで、"}, {"type": "subtitle", "time": 5433.83, "timestamp": "01:30:33", "text": "肉が乾燥していて、まるで彼らが好きではないかのようだった"}, {"type": "subtitle", "time": 5436.229, "timestamp": "01:30:36", "text": "きちんと味付けして、云々。"}, {"type": "subtitle", "time": 5439.91, "timestamp": "01:30:39", "text": "彼はオレンジみたいだ、君もそうだ、君もそうだ"}, {"type": "subtitle", "time": 5441.75, "timestamp": "01:30:41", "text": "あまりにも具体的すぎるように選ぶ"}, {"type": "subtitle", "time": 5443.59, "timestamp": "01:30:43", "text": "肉。もう諦めた方がいいよ"}, {"type": "subtitle", "time": 5445.43, "timestamp": "01:30:45", "text": "誰もあなたの好みに合う料理を作れないから"}, {"type": "subtitle", "time": 5447.31, "timestamp": "01:30:47", "text": "それ。ほら、"}, {"type": "subtitle", "time": 5451.87, "timestamp": "01:30:51", "text": "何？真実。これからは食べません"}, {"type": "subtitle", "time": 5455.27, "timestamp": "01:30:55", "text": "肉。そしてその日から"}, {"type": "subtitle", "time": 5457.189, "timestamp": "01:30:57", "text": "6年。"}]
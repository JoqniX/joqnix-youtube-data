[{"type": "subtitle", "time": 4561.27, "timestamp": "01:16:01", "text": "何か。では、どうでしょうか？"}, {"type": "subtitle", "time": 4563.83, "timestamp": "01:16:03", "text": "あなたは憎しみそのものを憎しみの中に入れた"}, {"type": "subtitle", "time": 4566.39, "timestamp": "01:16:06", "text": "カテゴリ？あ、待って。それは理にかなっている。"}, {"type": "subtitle", "time": 4569.27, "timestamp": "01:16:09", "text": "うん、いいんじゃない？それを置いて、"}, {"type": "subtitle", "time": 4571.83, "timestamp": "01:16:11", "text": "ループが続いている。"}, {"type": "subtitle", "time": 4576.149, "timestamp": "01:16:16", "text": "あなたが何かを嫌うなら、あなたは嫌われる。"}, {"type": "subtitle", "time": 4578.79, "timestamp": "01:16:18", "text": "全てを愛しています。"}, {"type": "subtitle", "time": 4582.99, "timestamp": "01:16:22", "text": "何てことだ。私たちは愛しています"}, {"type": "subtitle", "time": 4587.83, "timestamp": "01:16:27", "text": "戦争。戦争を嫌う人はいない。"}, {"type": "subtitle", "time": 4591.59, "timestamp": "01:16:31", "text": "何てことだ。以上です、皆さん。私たちは取り除きました"}, {"type": "subtitle", "time": 4604.709, "timestamp": "01:16:44", "text": "しかし、これらの質問は深刻なものではありません。"}, {"type": "subtitle", "time": 4608.07, "timestamp": "01:16:48", "text": "それはただの物のようなものですが、"}, {"type": "subtitle", "time": 4612.47, "timestamp": "01:16:52", "text": "もっと考えるべきですよね？でも楽しいよ。"}, {"type": "subtitle", "time": 4615.51, "timestamp": "01:16:55", "text": "えっと、私は何が嫌いなんだろう？何が"}, {"type": "subtitle", "time": 4618.07, "timestamp": "01:16:58", "text": "嫌い？そして質問は"}]
[{"type": "subtitle", "time": 2521.349, "timestamp": "00:42:01", "text": "気持ち悪い、まるで怖がらないみたいに"}, {"type": "subtitle", "time": 2524.55, "timestamp": "00:42:04", "text": "血を見ても、傷を見ても気持ち悪くはならない。"}, {"type": "subtitle", "time": 2527.75, "timestamp": "00:42:07", "text": "それは、私も入れることができるのと同じです。"}, {"type": "subtitle", "time": 2530.47, "timestamp": "00:42:10", "text": "自分自身に注射する。一度だけ私が"}, {"type": "subtitle", "time": 2532.71, "timestamp": "00:42:12", "text": "看護師に尋ねた。「ああ、"}, {"type": "subtitle", "time": 2536.27, "timestamp": "00:42:16", "text": "私に注射する？試してみたい"}, {"type": "subtitle", "time": 2538.47, "timestamp": "00:42:18", "text": "「それだよ」彼女は「大丈夫？」って感じで、私は「"}, {"type": "subtitle", "time": 2542.39, "timestamp": "00:42:22", "text": "「ああ、実際、彼らは君にそれをやらせてくれたんだ。」"}, {"type": "subtitle", "time": 2545.99, "timestamp": "00:42:25", "text": "彼女は私にそれをさせてくれた。おお。彼女は"}, {"type": "subtitle", "time": 2547.43, "timestamp": "00:42:27", "text": "彼女は「わかった」という感じで私に尋ねた。彼女は言った"}, {"type": "subtitle", "time": 2549.27, "timestamp": "00:42:29", "text": "「よし、まず最初にこう持って」"}, {"type": "subtitle", "time": 2550.95, "timestamp": "00:42:30", "text": "これをやって、こうやって、行く"}, {"type": "subtitle", "time": 2552.51, "timestamp": "00:42:32", "text": "ゆっくりと。」そして彼女は"}, {"type": "subtitle", "time": 2555.349, "timestamp": "00:42:35", "text": "あらゆる方法で教えてくれたし、私が"}, {"type": "subtitle", "time": 2556.79, "timestamp": "00:42:36", "text": "やったわ、彼女はこう言ったの、「ねえ、知ってる？"}, {"type": "subtitle", "time": 2560.23, "timestamp": "00:42:40", "text": "驚くほど良かった。"}, {"type": "subtitle", "time": 2563.95, "timestamp": "00:42:43", "text": "何てことだ。ニース。"}, {"type": "subtitle", "time": 2566.95, "timestamp": "00:42:46", "text": "うん。つまり、誰かにそれを話すと"}, {"type": "subtitle", "time": 2568.47, "timestamp": "00:42:48", "text": "普通に「うん、注射できるよ」"}, {"type": "subtitle", "time": 2570.47, "timestamp": "00:42:50", "text": "「私自身です。」そして彼らはこう言います。「それは"}, {"type": "subtitle", "time": 2573.63, "timestamp": "00:42:53", "text": "「麻薬みたいだ」と彼は言うだろう。"}, {"type": "subtitle", "time": 2576.55, "timestamp": "00:42:56", "text": "\"何てことだ。\""}]
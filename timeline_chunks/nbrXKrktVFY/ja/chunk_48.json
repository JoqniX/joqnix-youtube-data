[{"type": "subtitle", "time": 2881.43, "timestamp": "00:48:01", "text": "熟していない。なんてこった。彼らはまるで"}, {"type": "subtitle", "time": 2885.03, "timestamp": "00:48:05", "text": "それらは難しかった。私は「わかった、"}, {"type": "subtitle", "time": 2886.55, "timestamp": "00:48:06", "text": "「彼らはまだいい感じに見える。」だから私はこう言った。「私は"}, {"type": "subtitle", "time": 2890.15, "timestamp": "00:48:10", "text": "「投げられない。」だから私の脳は"}, {"type": "subtitle", "time": 2891.069, "timestamp": "00:48:11", "text": "のように、"}, {"type": "subtitle", "time": 2894.71, "timestamp": "00:48:14", "text": "「よし、ベッドの下に置いておこう"}, {"type": "subtitle", "time": 2898.15, "timestamp": "00:48:18", "text": "熟成する時間があるのは"}, {"type": "subtitle", "time": 2899.91, "timestamp": "00:48:19", "text": "バナナはそういう性質があるって知ってるよ。彼らは持っている"}, {"type": "subtitle", "time": 2901.27, "timestamp": "00:48:21", "text": "それらに何かがある"}, {"type": "subtitle", "time": 2904.109, "timestamp": "00:48:24", "text": "熟す。はい。はい。"}, {"type": "subtitle", "time": 2908.309, "timestamp": "00:48:28", "text": "そしてベッドの下に、"}, {"type": "subtitle", "time": 2911.349, "timestamp": "00:48:31", "text": "私のベッドは私をリラックスさせてくれるので、"}, {"type": "subtitle", "time": 2919.19, "timestamp": "00:48:39", "text": "リラックスした。それで、ベッドの下に置いたんです。"}, {"type": "subtitle", "time": 2921.51, "timestamp": "00:48:41", "text": "1日後、私は彼らがまだ"}, {"type": "subtitle", "time": 2923.67, "timestamp": "00:48:43", "text": "それらはまだ熟していなかった。 2日目"}, {"type": "subtitle", "time": 2927.27, "timestamp": "00:48:47", "text": "忘れた。 3日目ですが、確認しました。"}, {"type": "subtitle", "time": 2929.19, "timestamp": "00:48:49", "text": "熟しすぎていた。"}, {"type": "subtitle", "time": 2933.349, "timestamp": "00:48:53", "text": "ああ、カビが生えていたほどだ。"}, {"type": "subtitle", "time": 2936.39, "timestamp": "00:48:56", "text": "なんてこった。だから私は「えっ、まだできるよ」と思った"}, {"type": "subtitle", "time": 2937.95, "timestamp": "00:48:57", "text": "食べて"}]
[{"type": "subtitle", "time": 3723.75, "timestamp": "01:02:03", "text": "ああ。何てことだ。"}, {"type": "subtitle", "time": 3725.43, "timestamp": "01:02:05", "text": "だから私のチャットは"}, {"type": "subtitle", "time": 3726.87, "timestamp": "01:02:06", "text": "私が質問した瞬間、私のチャットは"}, {"type": "subtitle", "time": 3728.95, "timestamp": "01:02:08", "text": "人々が叫び始めた。私は売る"}, {"type": "subtitle", "time": 3730.47, "timestamp": "01:02:10", "text": "人々。"}, {"type": "subtitle", "time": 3733.19, "timestamp": "01:02:13", "text": "チャド、人を売ることはできないよ、なぜなら"}, {"type": "subtitle", "time": 3734.63, "timestamp": "01:02:14", "text": "売った瞬間に、"}, {"type": "subtitle", "time": 3737.43, "timestamp": "01:02:17", "text": "離れて。"}, {"type": "subtitle", "time": 3742.069, "timestamp": "01:02:22", "text": "真実。それは本当です。それは本当です。うん。"}, {"type": "subtitle", "time": 3744.63, "timestamp": "01:02:24", "text": "奴隷制度は許されない。"}, {"type": "subtitle", "time": 3747.43, "timestamp": "01:02:27", "text": "うん。この世界に魔法の力があったら、"}, {"type": "subtitle", "time": 3749.75, "timestamp": "01:02:29", "text": "あなたはその呪文か何かをすることができます"}, {"type": "subtitle", "time": 3752.789, "timestamp": "01:02:32", "text": "奴隷制度か何か。わからない。"}, {"type": "subtitle", "time": 3757.19, "timestamp": "01:02:37", "text": "ジョー、あなたは座ることを容認しますか？"}, {"type": "subtitle", "time": 3761.03, "timestamp": "01:02:41", "text": "コンドナス。コンドナは何をしていますか？"}, {"type": "subtitle", "time": 3764.95, "timestamp": "01:02:44", "text": "あなたは奴隷制度を支持しているのですか？いや、それは良くない。"}, {"type": "subtitle", "time": 3766.95, "timestamp": "01:02:46", "text": "なぜ？"}]
[{"type": "subtitle", "time": 7320.07, "timestamp": "02:02:00", "text": "英語を使う。うん。ウェールズ語。おお、"}, {"type": "subtitle", "time": 7322.07, "timestamp": "02:02:02", "text": "私は英語を学んだので"}, {"type": "subtitle", "time": 7324.47, "timestamp": "02:02:04", "text": "オンライン。"}, {"type": "subtitle", "time": 7327.27, "timestamp": "02:02:07", "text": "私は英語を話すことを学んだ前に"}, {"type": "subtitle", "time": 7328.669, "timestamp": "02:02:08", "text": "文字を知っていた"}, {"type": "subtitle", "time": 7331.35, "timestamp": "02:02:11", "text": "英語で、私はオンラインで子供みたいだった"}, {"type": "subtitle", "time": 7333.109, "timestamp": "02:02:13", "text": "見知らぬ人と話すのは避けるべきです"}, {"type": "subtitle", "time": 7336.709, "timestamp": "02:02:16", "text": "するけど、私はそれをやっていた"}, {"type": "subtitle", "time": 7339.189, "timestamp": "02:02:19", "text": "そして私はこれらの人々と交流していた"}, {"type": "subtitle", "time": 7341.589, "timestamp": "02:02:21", "text": "そして彼らのほとんどは何らかの形でウェールズ人で"}, {"type": "subtitle", "time": 7343.91, "timestamp": "02:02:23", "text": "イギリス人みたい、もしくは基本的に"}, {"type": "subtitle", "time": 7345.91, "timestamp": "02:02:25", "text": "EU出身の人々"}, {"type": "subtitle", "time": 7347.47, "timestamp": "02:02:27", "text": "だから私は彼らの"}, {"type": "subtitle", "time": 7350.87, "timestamp": "02:02:30", "text": "アクセント、そしてジョークを言ってみよう"}, {"type": "subtitle", "time": 7353.35, "timestamp": "02:02:33", "text": "そのアクセントは聞き心地が良くない。私はできません"}, {"type": "subtitle", "time": 7355.669, "timestamp": "02:02:35", "text": "今すぐやってください、私はたくさんやったので"}, {"type": "subtitle", "time": 7357.91, "timestamp": "02:02:37", "text": "自分自身への洗脳を取り除くために"}, {"type": "subtitle", "time": 7367.35, "timestamp": "02:02:47", "text": "待って、何歳からオンラインになったの？"}, {"type": "subtitle", "time": 7371.43, "timestamp": "02:02:51", "text": "もの？ 9くらい。九。"}, {"type": "subtitle", "time": 7373.91, "timestamp": "02:02:53", "text": "待って、9年生は何年生になるの？"}, {"type": "subtitle", "time": 7377.35, "timestamp": "02:02:57", "text": "九。 Nは9歳。わからない。チャット、"}]
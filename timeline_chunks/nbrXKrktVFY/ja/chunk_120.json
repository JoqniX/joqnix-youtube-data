[{"type": "subtitle", "time": 7200.55, "timestamp": "02:00:00", "text": "人々が指し示すとき、人々は"}, {"type": "subtitle", "time": 7203.75, "timestamp": "02:00:03", "text": "彼女は自分の訛りに腹を立てる。"}, {"type": "subtitle", "time": 7210.149, "timestamp": "02:00:10", "text": "アクセントがますますひどくなるので怒る"}, {"type": "subtitle", "time": 7217.99, "timestamp": "02:00:17", "text": "うん。"}, {"type": "subtitle", "time": 7220.07, "timestamp": "02:00:20", "text": "誰かが指摘したように"}, {"type": "subtitle", "time": 7222.95, "timestamp": "02:00:22", "text": "チャットの前の私のやり方のように"}, {"type": "subtitle", "time": 7224.229, "timestamp": "02:00:24", "text": "今まさに話しているところです。私は訛りがある"}, {"type": "subtitle", "time": 7226.31, "timestamp": "02:00:26", "text": "今すぐ。"}, {"type": "subtitle", "time": 7228.31, "timestamp": "02:00:28", "text": "普段はこんな話し方はしないけど、"}, {"type": "subtitle", "time": 7229.75, "timestamp": "02:00:29", "text": "話すときに快適に感じる"}, {"type": "subtitle", "time": 7233.83, "timestamp": "02:00:33", "text": "このアクセントで英語を"}, {"type": "subtitle", "time": 7237.189, "timestamp": "02:00:37", "text": "私はアクセントを使うのが好きです。"}, {"type": "subtitle", "time": 7241.75, "timestamp": "02:00:41", "text": "例えば、ある分野に参入するために"}, {"type": "subtitle", "time": 7243.589, "timestamp": "02:00:43", "text": "交流したい場合"}, {"type": "subtitle", "time": 7247.189, "timestamp": "02:00:47", "text": "アクセントは特定のことを言うのに役立ちます"}, {"type": "subtitle", "time": 7248.87, "timestamp": "02:00:48", "text": "もの"}, {"type": "subtitle", "time": 7252.55, "timestamp": "02:00:52", "text": "ああ、日本語にはアクセントがあるような"}, {"type": "subtitle", "time": 7255.31, "timestamp": "02:00:55", "text": "例えば、ある単語を言いたい場合"}, {"type": "subtitle", "time": 7258.629, "timestamp": "02:00:58", "text": "日本語では、"}]
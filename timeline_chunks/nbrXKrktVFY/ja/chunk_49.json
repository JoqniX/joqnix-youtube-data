[{"type": "subtitle", "time": 2941.27, "timestamp": "00:49:01", "text": "皮膚の下は大丈夫だから"}, {"type": "subtitle", "time": 2947.51, "timestamp": "00:49:07", "text": "でも念のため確認して、"}, {"type": "subtitle", "time": 2949.03, "timestamp": "00:49:09", "text": "お母さん。 「じゃあ、まだ食べてもいい？」"}, {"type": "subtitle", "time": 2950.71, "timestamp": "00:49:10", "text": "「彼ら？」母は最初に叫んだ。"}, {"type": "subtitle", "time": 2953.23, "timestamp": "00:49:13", "text": "私に向かって「うわ、何これ？」と言った。そして"}, {"type": "subtitle", "time": 2955.589, "timestamp": "00:49:15", "text": "2番目に彼女が言ったのは、「いいえ、"}, {"type": "subtitle", "time": 2957.829, "timestamp": "00:49:17", "text": "それらは食べられません。"}, {"type": "subtitle", "time": 2959.43, "timestamp": "00:49:19", "text": "それらにはカビが生えている。あなた"}, {"type": "subtitle", "time": 2961.99, "timestamp": "00:49:21", "text": "食べられない。何てことだ。私は「なぜ」と思った。"}, {"type": "subtitle", "time": 2966.15, "timestamp": "00:49:26", "text": "けれど？内装は良さそうだ。"}, {"type": "subtitle", "time": 2968.71, "timestamp": "00:49:28", "text": "だから彼女は言った"}, {"type": "subtitle", "time": 2971.829, "timestamp": "00:49:31", "text": "「あなたは23歳です」と彼女は言いました。"}, {"type": "subtitle", "time": 2977.51, "timestamp": "00:49:37", "text": "「バカなの？」チャットでは「あなたはバカじゃない」と言っている。"}, {"type": "subtitle", "time": 2983.589, "timestamp": "00:49:43", "text": "「オレンジ。」アスペンが時々言うのを私は見ている"}, {"type": "subtitle", "time": 2986.95, "timestamp": "00:49:46", "text": "「ああ、私もそれやってるな」って思うようなこと。"}, {"type": "subtitle", "time": 2988.15, "timestamp": "00:49:48", "text": "そしてそれが重要な点なのです"}, {"type": "subtitle", "time": 2990.069, "timestamp": "00:49:50", "text": "時々、私が「私はそうする」と言うときのように"}, {"type": "subtitle", "time": 2993.15, "timestamp": "00:49:53", "text": "私は「ああ、いやだ」って感じ"}, {"type": "subtitle", "time": 2996.39, "timestamp": "00:49:56", "text": "アスペンの寒さに関係するものは良くない"}, {"type": "subtitle", "time": 2998.15, "timestamp": "00:49:58", "text": "もの。"}]
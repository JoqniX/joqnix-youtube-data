[{"type": "subtitle", "time": 6423.189, "timestamp": "01:47:03", "text": "現実の私。うん。"}, {"type": "subtitle", "time": 6425.51, "timestamp": "01:47:05", "text": "でもオンラインでは、私はこう感じます"}, {"type": "subtitle", "time": 6428.149, "timestamp": "01:47:08", "text": "何かが起こっていて、私はただ"}, {"type": "subtitle", "time": 6431.03, "timestamp": "01:47:11", "text": "全力でやろう"}, {"type": "subtitle", "time": 6434.47, "timestamp": "01:47:14", "text": "何も感じずに。"}, {"type": "subtitle", "time": 6437.229, "timestamp": "01:47:17", "text": "考えなければなりません。"}, {"type": "subtitle", "time": 6440.629, "timestamp": "01:47:20", "text": "まるで私がこんなことをし始めたみたいに"}, {"type": "subtitle", "time": 6442.39, "timestamp": "01:47:22", "text": "まるで自分が役を演じているような気分だ。毎"}, {"type": "subtitle", "time": 6444.35, "timestamp": "01:47:24", "text": "一度入ったら"}, {"type": "subtitle", "time": 6446.31, "timestamp": "01:47:26", "text": "外では、「よし、行くぞ」って感じ"}, {"type": "subtitle", "time": 6449.35, "timestamp": "01:47:29", "text": "オレンジのふりをする。」オンラインのオレンジは"}, {"type": "subtitle", "time": 6452.47, "timestamp": "01:47:32", "text": "面白い。彼はしゃべりすぎだ。私はただ"}, {"type": "subtitle", "time": 6453.99, "timestamp": "01:47:33", "text": "オレンジのように振る舞う。しないで"}, {"type": "subtitle", "time": 6456.07, "timestamp": "01:47:36", "text": "自分自身。"}, {"type": "subtitle", "time": 6458.07, "timestamp": "01:47:38", "text": "内向的な男にならないで"}, {"type": "subtitle", "time": 6469.87, "timestamp": "01:47:49", "text": "質問。"}, {"type": "subtitle", "time": 6473.75, "timestamp": "01:47:53", "text": "えっと、どうやって作るの？"}, {"type": "subtitle", "time": 6476.709, "timestamp": "01:47:56", "text": "多重人格とかそういう類のこと？のように"}]
[{"type": "subtitle", "time": 7800.47, "timestamp": "02:10:00", "text": "えっと、私はYouTuber向けにアーカイブしているんです。"}, {"type": "subtitle", "time": 7802.55, "timestamp": "02:10:02", "text": "一部のユーチューバーが卒業する時"}, {"type": "subtitle", "time": 7804.709, "timestamp": "02:10:04", "text": "誰もいなければ彼女のものもアーカイブします"}, {"type": "subtitle", "time": 7808.55, "timestamp": "02:10:08", "text": "アーカイブして、みんながオンラインで見られるようにする"}, {"type": "subtitle", "time": 7811.75, "timestamp": "02:10:11", "text": "それを楽しむために、そして"}, {"type": "subtitle", "time": 7813.83, "timestamp": "02:10:13", "text": "卒業したユーチューバーで、まるで"}, {"type": "subtitle", "time": 7815.75, "timestamp": "02:10:15", "text": "小さなユーチューバー"}, {"type": "subtitle", "time": 7817.51, "timestamp": "02:10:17", "text": "だから、私は、ああ、自分だけが"}, {"type": "subtitle", "time": 7821.189, "timestamp": "02:10:21", "text": "これをアーカイブする必要があるのは誰ですか？"}, {"type": "subtitle", "time": 7824.31, "timestamp": "02:10:24", "text": "それで、私はそれをアーカイブして、フォックスに"}, {"type": "subtitle", "time": 7825.91, "timestamp": "02:10:25", "text": "これもアーカイブしてください。なぜなら、ファイルは"}, {"type": "subtitle", "time": 7833.91, "timestamp": "02:10:33", "text": "そして彼女はそうし、ファイルは"}, {"type": "subtitle", "time": 7837.99, "timestamp": "02:10:37", "text": "合計で200GBくらいだったと思う。"}, {"type": "subtitle", "time": 7840.87, "timestamp": "02:10:40", "text": "何か。おお。"}, {"type": "subtitle", "time": 7844.27, "timestamp": "02:10:44", "text": "彼女はそれを私に送らなければならなかった。"}, {"type": "subtitle", "time": 7847.83, "timestamp": "02:10:47", "text": "聖なる。待って、もしそれが200ジミーなら、"}, {"type": "subtitle", "time": 7850.87, "timestamp": "02:10:50", "text": "推測。彼女はデータプランを購入しなければならなかった"}, {"type": "subtitle", "time": 7854.43, "timestamp": "02:10:54", "text": "また30MBのやつ、そうじゃないけど"}, {"type": "subtitle", "time": 7857.75, "timestamp": "02:10:57", "text": "期限切れ。私も何度かそういう経験があります。"}]
[{"type": "subtitle", "time": 14761.75, "timestamp": "04:06:01", "text": "男。誰かがこう言った。「おい、ジョックは"}, {"type": "subtitle", "time": 14769.03, "timestamp": "04:06:09", "text": "私は。"}, {"type": "subtitle", "time": 14772.15, "timestamp": "04:06:12", "text": "つまり、彼は現在"}, {"type": "subtitle", "time": 14774.87, "timestamp": "04:06:14", "text": "えっと、彼は今宇宙にいるような感じ。もしあなたが"}, {"type": "subtitle", "time": 14777.83, "timestamp": "04:06:17", "text": "彼の配信を見てみて"}, {"type": "subtitle", "time": 14779.51, "timestamp": "04:06:19", "text": "窓の外では、彼は宇宙にいる。"}, {"type": "subtitle", "time": 14782.07, "timestamp": "04:06:22", "text": "今。ええ、外を見れば"}, {"type": "subtitle", "time": 14785.189, "timestamp": "04:06:25", "text": "ウィンドウ。私は文字通り、あそこで空の上にいるんです。"}, {"type": "subtitle", "time": 14787.11, "timestamp": "04:06:27", "text": "うん。つまり、厳密に言えば彼は"}, {"type": "subtitle", "time": 14796.63, "timestamp": "04:06:36", "text": "うん。そうではなく、その人"}, {"type": "subtitle", "time": 14799.83, "timestamp": "04:06:39", "text": "今彼を操っているのは誰だ、彼は"}, {"type": "subtitle", "time": 14801.349, "timestamp": "04:06:41", "text": "インド人。"}, {"type": "subtitle", "time": 14813.189, "timestamp": "04:06:53", "text": "インドのユーチューバーのように思う"}, {"type": "subtitle", "time": 14817.91, "timestamp": "04:06:57", "text": "ホリデーライフのように大きなものになる"}]
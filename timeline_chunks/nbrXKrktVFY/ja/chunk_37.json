[{"type": "subtitle", "time": 2221.43, "timestamp": "00:37:01", "text": "ストリーム。だから、大混乱になるだろう。"}, {"type": "subtitle", "time": 2223.069, "timestamp": "00:37:03", "text": "好きにならなきゃ"}, {"type": "subtitle", "time": 2225.589, "timestamp": "00:37:05", "text": "マルチタスク。私もこのゲームをプレイしなければならない"}, {"type": "subtitle", "time": 2228.47, "timestamp": "00:37:08", "text": "それが出てきて、私もやらなければならない"}, {"type": "subtitle", "time": 2231.03, "timestamp": "00:37:11", "text": "手数料。私もこれをやらなければならない。そして"}, {"type": "subtitle", "time": 2232.79, "timestamp": "00:37:12", "text": "「ああ、それはできないよ」という人たち。"}, {"type": "subtitle", "time": 2234.23, "timestamp": "00:37:14", "text": "「寝てるの？」って聞かれたから、「10時間寝てるよ」って答えた。"}, {"type": "subtitle", "time": 2235.15, "timestamp": "00:37:15", "text": "時間"}, {"type": "subtitle", "time": 2245.03, "timestamp": "00:37:25", "text": "くそ。まるで、でも何もできない"}, {"type": "subtitle", "time": 2249.03, "timestamp": "00:37:29", "text": "学校のような公式なもの。"}, {"type": "subtitle", "time": 2251.109, "timestamp": "00:37:31", "text": "学校は"}, {"type": "subtitle", "time": 2255.349, "timestamp": "00:37:35", "text": "私が中退したからです。えーと、その後"}, {"type": "subtitle", "time": 2258.23, "timestamp": "00:37:38", "text": "高校の試験のように10年生で失敗した"}, {"type": "subtitle", "time": 2260.39, "timestamp": "00:37:40", "text": "10回目の試験で落ちたんだけど、"}, {"type": "subtitle", "time": 2265.71, "timestamp": "00:37:45", "text": "よし、これを続けることもできる"}, {"type": "subtitle", "time": 2268.71, "timestamp": "00:37:48", "text": "そして学業を終えるか、"}, {"type": "subtitle", "time": 2271.43, "timestamp": "00:37:51", "text": "私が自信を持っていることの一つです。"}, {"type": "subtitle", "time": 2273.67, "timestamp": "00:37:53", "text": "うん。"}, {"type": "subtitle", "time": 2276.15, "timestamp": "00:37:56", "text": "だから私は自分に2年間の猶予を与えた"}, {"type": "subtitle", "time": 2278.15, "timestamp": "00:37:58", "text": "自由時間。私は父にこう言った。「私はこう思う」"}]
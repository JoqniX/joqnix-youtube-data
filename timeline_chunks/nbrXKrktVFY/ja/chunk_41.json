[{"type": "subtitle", "time": 2461.67, "timestamp": "00:41:01", "text": "小さな家を持つことは私の幼い頃からの夢でした"}, {"type": "subtitle", "time": 2464.069, "timestamp": "00:41:04", "text": "小さなパン屋さん、小さなパンを作って、"}, {"type": "subtitle", "time": 2465.75, "timestamp": "00:41:05", "text": "そしてそれを嗅いで小さな小さな"}, {"type": "subtitle", "time": 2469.91, "timestamp": "00:41:09", "text": "小さな村の人々。うん、"}, {"type": "subtitle", "time": 2471.34, "timestamp": "00:41:11", "text": "それが私の夢です。"}, {"type": "subtitle", "time": 2472.87, "timestamp": "00:41:12", "text": "[音楽]"}, {"type": "subtitle", "time": 2474.63, "timestamp": "00:41:14", "text": "それに、私は料理も得意だったんです。"}, {"type": "subtitle", "time": 2476.15, "timestamp": "00:41:16", "text": "だから祖母は私が"}, {"type": "subtitle", "time": 2479.71, "timestamp": "00:41:19", "text": "シェフとして、または"}, {"type": "subtitle", "time": 2482.47, "timestamp": "00:41:22", "text": "何か。そして母は私に"}, {"type": "subtitle", "time": 2485.91, "timestamp": "00:41:25", "text": "エンジニアです。なぜなら、私が修理する人だからです。"}, {"type": "subtitle", "time": 2488.87, "timestamp": "00:41:28", "text": "家の中にある物。何か"}, {"type": "subtitle", "time": 2491.99, "timestamp": "00:41:31", "text": "休憩、電子"}, {"type": "subtitle", "time": 2493.829, "timestamp": "00:41:33", "text": "1"}, {"type": "subtitle", "time": 2496.47, "timestamp": "00:41:36", "text": "そして、何事も毎回何か"}, {"type": "subtitle", "time": 2498.47, "timestamp": "00:41:38", "text": "壊れたら、「よし、直そう」って感じ。私"}, {"type": "subtitle", "time": 2500.55, "timestamp": "00:41:40", "text": "まるでボブ・ザ・ビルダーになった気分だった"}, {"type": "subtitle", "time": 2502.829, "timestamp": "00:41:42", "text": "えっと、私の"}, {"type": "subtitle", "time": 2505.75, "timestamp": "00:41:45", "text": "家と父は私に看護師になってほしかった"}, {"type": "subtitle", "time": 2508.39, "timestamp": "00:41:48", "text": "なぜなら、私が入院していたとき"}, {"type": "subtitle", "time": 2511.109, "timestamp": "00:41:51", "text": "私にとって看護に関することはすべて"}, {"type": "subtitle", "time": 2514.15, "timestamp": "00:41:54", "text": "包帯を交換できる"}, {"type": "subtitle", "time": 2516.47, "timestamp": "00:41:56", "text": "傷があれば、すべてを変えることができます"}, {"type": "subtitle", "time": 2519.43, "timestamp": "00:41:59", "text": "それも直してください。私には理解できません。"}]
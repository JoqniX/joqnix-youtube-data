[{"type": "subtitle", "time": 2282.39, "timestamp": "00:38:02", "text": "「わかった、聞いて。もしあなたが私に"}, {"type": "subtitle", "time": 2283.63, "timestamp": "00:38:03", "text": "残す"}, {"type": "subtitle", "time": 2286.71, "timestamp": "00:38:06", "text": "家、私はこれを2年間行います"}, {"type": "subtitle", "time": 2289.51, "timestamp": "00:38:09", "text": "私はしたいし、あなたもしたくない"}, {"type": "subtitle", "time": 2290.87, "timestamp": "00:38:10", "text": "私を経済的に支えなければならない、"}, {"type": "subtitle", "time": 2293.51, "timestamp": "00:38:13", "text": "何でも。私はただこれをして"}, {"type": "subtitle", "time": 2295.67, "timestamp": "00:38:15", "text": "様子を見てみよう。」それで、なぜ私は"}, {"type": "subtitle", "time": 2299.19, "timestamp": "00:38:19", "text": "これに適用すると、新しい"}, {"type": "subtitle", "time": 2301.99, "timestamp": "00:38:21", "text": "私たちの街にある化粧品店。私"}, {"type": "subtitle", "time": 2303.91, "timestamp": "00:38:23", "text": "応募して、仕事を得て、"}, {"type": "subtitle", "time": 2307.069, "timestamp": "00:38:27", "text": "何とかして管理職の仕事に就け。わからない"}, {"type": "subtitle", "time": 2309.829, "timestamp": "00:38:29", "text": "そして私は彼らと一緒に働き始めました。"}, {"type": "subtitle", "time": 2312.87, "timestamp": "00:38:32", "text": "その後コロナが発生し、コロナの後私は"}, {"type": "subtitle", "time": 2314.71, "timestamp": "00:38:34", "text": "グラフィックデザイン学科に合格しました"}, {"type": "subtitle", "time": 2316.95, "timestamp": "00:38:36", "text": "会社。"}, {"type": "subtitle", "time": 2318.71, "timestamp": "00:38:38", "text": "だから私は十分なお金を稼ぎ始めたので"}, {"type": "subtitle", "time": 2320.63, "timestamp": "00:38:40", "text": "両親はこう言った"}, {"type": "subtitle", "time": 2323.27, "timestamp": "00:38:43", "text": "お前が好きなようにすればいい。"}, {"type": "subtitle", "time": 2334.31, "timestamp": "00:38:54", "text": "それは本当に素晴らしいですね。うん。それはある意味"}, {"type": "subtitle", "time": 2336.15, "timestamp": "00:38:56", "text": "友達がいるから悲しいです"}, {"type": "subtitle", "time": 2338.069, "timestamp": "00:38:58", "text": "両親が許さないような"}, {"type": "subtitle", "time": 2339.069, "timestamp": "00:38:59", "text": "残す"}]
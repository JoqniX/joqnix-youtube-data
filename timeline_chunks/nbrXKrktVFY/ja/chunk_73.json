[{"type": "subtitle", "time": 4387.07, "timestamp": "01:13:07", "text": "みんなが"}, {"type": "subtitle", "time": 4389.669, "timestamp": "01:13:09", "text": "同じ。 「ああ、あなたは着ている"}, {"type": "subtitle", "time": 4392.07, "timestamp": "01:13:12", "text": "今日はこの色ですね。お前はこれを"}, {"type": "subtitle", "time": 4394.95, "timestamp": "01:13:14", "text": "色。"}, {"type": "subtitle", "time": 4396.99, "timestamp": "01:13:16", "text": "ああ、君は髪があるね"}, {"type": "subtitle", "time": 4405.11, "timestamp": "01:13:25", "text": "髪。おそらく彼らはこう思うでしょう"}, {"type": "subtitle", "time": 4407.27, "timestamp": "01:13:27", "text": "お互いに誰が"}, {"type": "subtitle", "time": 4413.03, "timestamp": "01:13:33", "text": "最も愚かな。いや、一番バカなのは私だよ。私"}, {"type": "subtitle", "time": 4415.55, "timestamp": "01:13:35", "text": "2+2が何なのかわからない"}, {"type": "subtitle", "time": 4418.229, "timestamp": "01:13:38", "text": "は。 2+2が何かわからないの？私はしません"}, {"type": "subtitle", "time": 4420.47, "timestamp": "01:13:40", "text": "みんな、２が何なのか知ってるよね。一体どういうことだ"}, {"type": "subtitle", "time": 4421.75, "timestamp": "01:13:41", "text": "何について話しているのですか？あなたは何者ですか？"}, {"type": "subtitle", "time": 4431.59, "timestamp": "01:13:51", "text": "えっと、"}, {"type": "subtitle", "time": 4435.03, "timestamp": "01:13:55", "text": "ああ、次の質問はジョー。"}, {"type": "subtitle", "time": 4436.95, "timestamp": "01:13:56", "text": "嫌いになっても構わないものって何？"}, {"type": "subtitle", "time": 4439.51, "timestamp": "01:13:59", "text": "について？"}]
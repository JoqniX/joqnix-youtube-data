[{"type": "subtitle", "time": 1382.87, "timestamp": "00:23:02", "text": "皆さん、はじめまして。"}, {"type": "subtitle", "time": 1386.47, "timestamp": "00:23:06", "text": "アストロって何？アストラルって何？"}, {"type": "subtitle", "time": 1390.51, "timestamp": "00:23:10", "text": "星座？うん。どちらかというと、アストラル"}, {"type": "subtitle", "time": 1393.27, "timestamp": "00:23:13", "text": "星座のプログネーター。むしろ"}, {"type": "subtitle", "time": 1396.63, "timestamp": "00:23:16", "text": "星座の守護者。"}, {"type": "subtitle", "time": 1399.59, "timestamp": "00:23:19", "text": "うん。はぁ。面白い。"}, {"type": "subtitle", "time": 1401.149, "timestamp": "00:23:21", "text": "つまり、あなたは"}, {"type": "subtitle", "time": 1405.99, "timestamp": "00:23:25", "text": "あなたはまるで警備員のようだ。"}, {"type": "subtitle", "time": 1410.149, "timestamp": "00:23:30", "text": "そう言えるかもしれませんね。うん。ああ、しまった。"}, {"type": "subtitle", "time": 1413.43, "timestamp": "00:23:33", "text": "ヴィシャルMEをご覧になりましたか？"}, {"type": "subtitle", "time": 1416.87, "timestamp": "00:23:36", "text": "最近、警備員のミームが流行ってる？"}, {"type": "subtitle", "time": 1420.87, "timestamp": "00:23:40", "text": "どれ？いいえ、実際にやったことはありません。"}, {"type": "subtitle", "time": 1423.83, "timestamp": "00:23:43", "text": "いいえ、していません。だから、こんな風に"}, {"type": "subtitle", "time": 1426.31, "timestamp": "00:23:46", "text": "インド人の本当の姿。彼らは持っている"}, {"type": "subtitle", "time": 1427.99, "timestamp": "00:23:47", "text": "ずっとこのことをやってきた。彼らは試みている"}, {"type": "subtitle", "time": 1430.23, "timestamp": "00:23:50", "text": "警備の仕事に就くような"}, {"type": "subtitle", "time": 1433.43, "timestamp": "00:23:53", "text": "ヴィシャル・モール氏との共同申請。"}, {"type": "subtitle", "time": 1435.19, "timestamp": "00:23:55", "text": "わかった。そしてどうやら人々は"}, {"type": "subtitle", "time": 1437.11, "timestamp": "00:23:57", "text": "まるであなたがそう言っているようです。"}]
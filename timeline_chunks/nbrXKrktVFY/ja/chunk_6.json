[{"type": "subtitle", "time": 361.189, "timestamp": "00:06:01", "text": "こんにちは。こんにちは、Starish。スターローズさん、ようこそ。"}, {"type": "subtitle", "time": 363.15, "timestamp": "00:06:03", "text": "いらっしゃいませ"}, {"type": "subtitle", "time": 364.909, "timestamp": "00:06:04", "text": "で。"}, {"type": "subtitle", "time": 367.51, "timestamp": "00:06:07", "text": "わかった。そして、私はワクワクしています。それは私の"}, {"type": "subtitle", "time": 369.99, "timestamp": "00:06:09", "text": "最初のやり取りは実際に声で"}, {"type": "subtitle", "time": 372.07, "timestamp": "00:06:12", "text": "オレンジ・ショーンと話している。そして私に"}, {"type": "subtitle", "time": 398.029, "timestamp": "00:06:38", "text": "うん、行くよ"}, {"type": "subtitle", "time": 400.95, "timestamp": "00:06:40", "text": "待機する。そうそう。待って。えっと、オレンジは"}, {"type": "subtitle", "time": 404.87, "timestamp": "00:06:44", "text": "ストリーミング配信ですよね？あ、待って。えー、ほっほっほ"}, {"type": "subtitle", "time": 407.27, "timestamp": "00:06:47", "text": "デッキ。近いうちにホレックスを作らなければならない。"}, {"type": "subtitle", "time": 408.87, "timestamp": "00:06:48", "text": "待って、待って、待って、待って、待って。忘れた"}, {"type": "subtitle", "time": 412.59000000000003, "timestamp": "00:06:52", "text": "すっかり忘れていました。それらの人々のために"}, {"type": "subtitle", "time": 415.99, "timestamp": "00:06:55", "text": "えーと、マルチストリームを作ります"}, {"type": "subtitle", "time": 419.83, "timestamp": "00:06:59", "text": "マルチマッチリンク"}]
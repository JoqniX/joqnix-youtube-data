[{"type": "subtitle", "time": 4800.79, "timestamp": "01:20:00", "text": "自宅でトレーニングできるかもしれません"}, {"type": "subtitle", "time": 4802.95, "timestamp": "01:20:02", "text": "1つか2つのエクササイズをするだけです"}, {"type": "subtitle", "time": 4805.91, "timestamp": "01:20:05", "text": "いいよ、それはただ君が何を調べているかを見るだけ"}, {"type": "subtitle", "time": 4808.55, "timestamp": "01:20:08", "text": "私が言うようにできる"}, {"type": "subtitle", "time": 4810.07, "timestamp": "01:20:10", "text": "何もしない友達がいる"}, {"type": "subtitle", "time": 4812.07, "timestamp": "01:20:12", "text": "人生は文字通り座るような"}, {"type": "subtitle", "time": 4814.669, "timestamp": "01:20:14", "text": "家に帰ると、ジムに行く必要があるよ。"}, {"type": "subtitle", "time": 4823.11, "timestamp": "01:20:23", "text": "また、ジムはあなたの"}, {"type": "subtitle", "time": 4825.91, "timestamp": "01:20:25", "text": "えーと、メンタルヘルスとか。"}, {"type": "subtitle", "time": 4832.63, "timestamp": "01:20:32", "text": "ユニローンはジムに通っている。はぁ？いつでも"}, {"type": "subtitle", "time": 4834.55, "timestamp": "01:20:34", "text": "別れたり、あなたが"}, {"type": "subtitle", "time": 4837.75, "timestamp": "01:20:37", "text": "意欲の欠如。本当にそうなんです"}, {"type": "subtitle", "time": 4839.91, "timestamp": "01:20:39", "text": "私がジムに通い始めたとき、"}, {"type": "subtitle", "time": 4842.75, "timestamp": "01:20:42", "text": "私は精神的に強かったんです。"}, {"type": "subtitle", "time": 4845.51, "timestamp": "01:20:45", "text": "私の家族が亡くなって、"}, {"type": "subtitle", "time": 4846.91, "timestamp": "01:20:46", "text": "気にしないだろう"}, {"type": "subtitle", "time": 4849.11, "timestamp": "01:20:49", "text": "それ。まさに私が言いたいことなんです。"}, {"type": "subtitle", "time": 4851.03, "timestamp": "01:20:51", "text": "今の私は精神的にそれほど強いのです"}, {"type": "subtitle", "time": 4853.11, "timestamp": "01:20:53", "text": "私の人生でいろいろなことが起こったので"}, {"type": "subtitle", "time": 4854.79, "timestamp": "01:20:54", "text": "多くの。"}, {"type": "subtitle", "time": 4856.99, "timestamp": "01:20:56", "text": "うん。"}]
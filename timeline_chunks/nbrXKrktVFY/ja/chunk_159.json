[{"type": "subtitle", "time": 9541.67, "timestamp": "02:39:01", "text": "すべてのオンライン社会主義者。"}, {"type": "subtitle", "time": 9543.19, "timestamp": "02:39:03", "text": "それは議論のようなものだ。まるで"}, {"type": "subtitle", "time": 9545.19, "timestamp": "02:39:05", "text": "大統領選前の討論会のようなものだった"}, {"type": "subtitle", "time": 9558.51, "timestamp": "02:39:18", "text": "えっと"}, {"type": "subtitle", "time": 9561.83, "timestamp": "02:39:21", "text": "一体誰だったんだ？いくつか"}, {"type": "subtitle", "time": 9563.99, "timestamp": "02:39:23", "text": "彼女はアスミンについて話していたユーチューバーと"}, {"type": "subtitle", "time": 9565.91, "timestamp": "02:39:25", "text": "人々が彼女のチャットで話し始めた。私"}, {"type": "subtitle", "time": 9567.67, "timestamp": "02:39:27", "text": "生中継で観た。彼女のチャットの参加者"}, {"type": "subtitle", "time": 9568.87, "timestamp": "02:39:28", "text": "「ああ、話さないで」"}, {"type": "subtitle", "time": 9570.03, "timestamp": "02:39:30", "text": "アスミン。彼は"}, {"type": "subtitle", "time": 9572.15, "timestamp": "02:39:32", "text": "「物議を醸す」と彼女は言った。「ハゲ"}, {"type": "subtitle", "time": 9574.469, "timestamp": "02:39:34", "text": "「あいつは物議を醸す人物だ。」そして私はクソ"}, {"type": "subtitle", "time": 9582.469, "timestamp": "02:39:42", "text": "みんな、なんてことだ。いいえ、彼女がそう言ったからです"}, {"type": "subtitle", "time": 9584.309, "timestamp": "02:39:44", "text": "皮肉を込めて。"}, {"type": "subtitle", "time": 9586.87, "timestamp": "02:39:46", "text": "歴史上、すべてのハゲ男は"}, {"type": "subtitle", "time": 9589.59, "timestamp": "02:39:49", "text": "悪魔。これはハゲ男の"}, {"type": "subtitle", "time": 9598.63, "timestamp": "02:39:58", "text": "[音楽]"}]
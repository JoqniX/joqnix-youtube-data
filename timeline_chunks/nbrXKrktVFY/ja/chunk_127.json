[{"type": "subtitle", "time": 7620.99, "timestamp": "02:07:00", "text": "アップロード速度は1対1で等しい"}, {"type": "subtitle", "time": 7625.189, "timestamp": "02:07:05", "text": "えっと、YouTubeでライブ配信できないみたいな"}, {"type": "subtitle", "time": 7628.55, "timestamp": "02:07:08", "text": "ビットレートは1,000くらいに固定されるだろう"}, {"type": "subtitle", "time": 7631.51, "timestamp": "02:07:11", "text": "それ以上は行かないとか、そんな感じ。"}, {"type": "subtitle", "time": 7634.589, "timestamp": "02:07:14", "text": "それから私は「よし、それはaかaか"}, {"type": "subtitle", "time": 7638.55, "timestamp": "02:07:18", "text": "gio。えっと、父がそう思うので、"}, {"type": "subtitle", "time": 7640.55, "timestamp": "02:07:20", "text": "父はジオシムを持っていた。だから私は「わかった、"}, {"type": "subtitle", "time": 7643.43, "timestamp": "02:07:23", "text": "ジオファイバーで行こう。」それ以来"}, {"type": "subtitle", "time": 7645.75, "timestamp": "02:07:25", "text": "私は地質学的異常を抱えています。試してみたかった"}, {"type": "subtitle", "time": 7648.229, "timestamp": "02:07:28", "text": "でも、聞いた話だと、"}, {"type": "subtitle", "time": 7649.709, "timestamp": "02:07:29", "text": "本当に"}, {"type": "subtitle", "time": 7652.95, "timestamp": "02:07:32", "text": "良い。うん。"}, {"type": "subtitle", "time": 7655.91, "timestamp": "02:07:35", "text": "ええ、そうですね。私は、"}, {"type": "subtitle", "time": 7661.35, "timestamp": "02:07:41", "text": "200 KB PS を取得しました。そうそう。そして私は私は"}, {"type": "subtitle", "time": 7663.189, "timestamp": "02:07:43", "text": "気が狂いそうだ。なんでだよ"}, {"type": "subtitle", "time": 7667.109, "timestamp": "02:07:47", "text": "すごく速いですね？なぜこんなに速いのですか？ああ、"}, {"type": "subtitle", "time": 7669.51, "timestamp": "02:07:49", "text": "神。何でもダウンロードできるよ"}, {"type": "subtitle", "time": 7671.75, "timestamp": "02:07:51", "text": "今。"}, {"type": "subtitle", "time": 7675.709, "timestamp": "02:07:55", "text": "200kbpsくらい。私は「なんてこった」と思った。"}, {"type": "subtitle", "time": 7679.35, "timestamp": "02:07:59", "text": "くそ、速すぎる。"}]
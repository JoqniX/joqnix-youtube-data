[{"type": "subtitle", "time": 6480.709, "timestamp": "01:48:00", "text": "私にはその概念が理解できない"}, {"type": "subtitle", "time": 6482.709, "timestamp": "01:48:02", "text": "うん、YouTubeは知らないけど"}, {"type": "subtitle", "time": 6487.43, "timestamp": "01:48:07", "text": "あなたは自分の行動を、えっと、または"}, {"type": "subtitle", "time": 6490.43, "timestamp": "01:48:10", "text": "自分らしくいる、今まで"}, {"type": "subtitle", "time": 6493.75, "timestamp": "01:48:13", "text": "他の人に見せたり、あなたが完全に"}, {"type": "subtitle", "time": 6496.31, "timestamp": "01:48:16", "text": "その経験はどのようなものだったか、それとは異なっていた"}, {"type": "subtitle", "time": 6501.03, "timestamp": "01:48:21", "text": "あなたにとってオレンジのような"}, {"type": "subtitle", "time": 6503.109, "timestamp": "01:48:23", "text": "すべては最高の方法のようです"}, {"type": "subtitle", "time": 6504.629, "timestamp": "01:48:24", "text": "それを説明すると、それはあなたの"}, {"type": "subtitle", "time": 6507.27, "timestamp": "01:48:27", "text": "親と話すか、友達と話すか。"}, {"type": "subtitle", "time": 6513.189, "timestamp": "01:48:33", "text": "友達と同じように、あなたはこう言うでしょう"}, {"type": "subtitle", "time": 6514.669, "timestamp": "01:48:34", "text": "親に言ってはいけないこと"}, {"type": "subtitle", "time": 6516.87, "timestamp": "01:48:36", "text": "両親と話をしない"}, {"type": "subtitle", "time": 6519.22, "timestamp": "01:48:39", "text": "君みたいな友達は君の両親と話をするよ。"}, {"type": "subtitle", "time": 6520.629, "timestamp": "01:48:40", "text": "[音楽]"}, {"type": "subtitle", "time": 6523.99, "timestamp": "01:48:43", "text": "私にとってはそういうことなんです。"}, {"type": "subtitle", "time": 6530.149, "timestamp": "01:48:50", "text": "オンラインのように、私はみんなを自分の"}, {"type": "subtitle", "time": 6531.75, "timestamp": "01:48:51", "text": "祖母と話していたのは、"}, {"type": "subtitle", "time": 6533.75, "timestamp": "01:48:53", "text": "おばあちゃんはこうするのが好きで、私もそうする"}, {"type": "subtitle", "time": 6535.47, "timestamp": "01:48:55", "text": "彼女にモンスターとは何かを説明して"}, {"type": "subtitle", "time": 6539.35, "timestamp": "01:48:59", "text": "女の子、何が起こったの？"}]
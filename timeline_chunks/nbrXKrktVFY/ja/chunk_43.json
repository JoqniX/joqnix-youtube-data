[{"type": "subtitle", "time": 2583.589, "timestamp": "00:43:03", "text": "何てことだ。そして私は持っていません"}, {"type": "subtitle", "time": 2586.63, "timestamp": "00:43:06", "text": "痛みに対する耐性が非常に高い。"}, {"type": "subtitle", "time": 2587.71, "timestamp": "00:43:07", "text": "だから、"}, {"type": "subtitle", "time": 2590.069, "timestamp": "00:43:10", "text": "チャットで私が"}, {"type": "subtitle", "time": 2592.55, "timestamp": "00:43:12", "text": "マゾヒスト。いいえ、一般的な認識とは異なり、"}, {"type": "subtitle", "time": 2600.55, "timestamp": "00:43:20", "text": "私は今でも痛みが嫌いです。"}, {"type": "subtitle", "time": 2602.9, "timestamp": "00:43:22", "text": "痛みは痛みだ。私は対処できます"}, {"type": "subtitle", "time": 2604.51, "timestamp": "00:43:24", "text": "[音楽]"}, {"type": "subtitle", "time": 2607.829, "timestamp": "00:43:27", "text": "痛み。のように、"}, {"type": "subtitle", "time": 2614.91, "timestamp": "00:43:34", "text": "[音楽]"}, {"type": "subtitle", "time": 2617.829, "timestamp": "00:43:37", "text": "えっと、言っていいのかどうかわかりませんが"}, {"type": "subtitle", "time": 2620.309, "timestamp": "00:43:40", "text": "このグラフィックなやつ、でも、そう、そこに"}, {"type": "subtitle", "time": 2623.03, "timestamp": "00:43:43", "text": "これは一度だけ"}, {"type": "subtitle", "time": 2626.069, "timestamp": "00:43:46", "text": "痛みに関しては、ね？えっと、私は"}, {"type": "subtitle", "time": 2628.55, "timestamp": "00:43:48", "text": "偶然に"}, {"type": "subtitle", "time": 2631.19, "timestamp": "00:43:51", "text": "えっと、扱っている間、私はとても不器用でした。私は"}, {"type": "subtitle", "time": 2633.23, "timestamp": "00:43:53", "text": "不器用。わからない。"}, {"type": "subtitle", "time": 2636.39, "timestamp": "00:43:56", "text": "時々、実際、うっかり"}, {"type": "subtitle", "time": 2639.03, "timestamp": "00:43:59", "text": "野菜を切っているときに指を切ってしまいました。"}]
[{"type": "subtitle", "time": 4205.51, "timestamp": "01:10:05", "text": "運動部員同士で話しているのは、"}, {"type": "subtitle", "time": 4214.07, "timestamp": "01:10:14", "text": "もの。体育会系の社会は"}, {"type": "subtitle", "time": 4216.04, "timestamp": "01:10:16", "text": "君にはスポーツマンに見える？"}, {"type": "subtitle", "time": 4219.03, "timestamp": "01:10:19", "text": "[音楽]"}, {"type": "subtitle", "time": 4221.149, "timestamp": "01:10:21", "text": "うん、"}, {"type": "subtitle", "time": 4223.91, "timestamp": "01:10:23", "text": "それが失敗しないことを願うばかりです"}, {"type": "subtitle", "time": 4226.31, "timestamp": "01:10:26", "text": "翌日。"}, {"type": "subtitle", "time": 4228.149, "timestamp": "01:10:28", "text": "あなたの何になるのか、あなたは"}, {"type": "subtitle", "time": 4229.83, "timestamp": "01:10:29", "text": "政治体制はどのようなものになるのだろうか？意思"}, {"type": "subtitle", "time": 4232.149, "timestamp": "01:10:32", "text": "資本主義社会になるか、"}, {"type": "subtitle", "time": 4234.07, "timestamp": "01:10:34", "text": "共産主義者？"}, {"type": "subtitle", "time": 4236.51, "timestamp": "01:10:36", "text": "政治的なことはよくわからない"}, {"type": "subtitle", "time": 4239.669, "timestamp": "01:10:39", "text": "もの。資本主義者とは、"}, {"type": "subtitle", "time": 4242.63, "timestamp": "01:10:42", "text": "独占資本主義 平等資本主義"}, {"type": "subtitle", "time": 4243.55, "timestamp": "01:10:43", "text": "は"}, {"type": "subtitle", "time": 4247.83, "timestamp": "01:10:47", "text": "基本的に全てが制御される"}, {"type": "subtitle", "time": 4251.11, "timestamp": "01:10:51", "text": "人々によって。例えば"}, {"type": "subtitle", "time": 4255.35, "timestamp": "01:10:55", "text": "そして共産主義は、誰もが平等であり、"}, {"type": "subtitle", "time": 4257.59, "timestamp": "01:10:57", "text": "何もかもが"}, {"type": "subtitle", "time": 4259.91, "timestamp": "01:10:59", "text": "等しい。"}]
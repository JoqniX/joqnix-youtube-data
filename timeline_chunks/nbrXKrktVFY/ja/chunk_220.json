[{"type": "subtitle", "time": 13200.07, "timestamp": "03:40:00", "text": "悪い仕事？"}, {"type": "subtitle", "time": 13202.389, "timestamp": "03:40:02", "text": "ひどい仕事だったけど、"}, {"type": "subtitle", "time": 13209.269, "timestamp": "03:40:09", "text": "まるでデビュービデオがなかったかのようだった。ありました"}, {"type": "subtitle", "time": 13211.91, "timestamp": "03:40:11", "text": "伝承動画は好きじゃない。私はただ"}, {"type": "subtitle", "time": 13215.349, "timestamp": "03:40:15", "text": "デビュービデオはあったけど、伝承"}, {"type": "subtitle", "time": 13217.91, "timestamp": "03:40:17", "text": "動画が見つかりませんでした。うん。"}, {"type": "subtitle", "time": 13220.389, "timestamp": "03:40:20", "text": "デビュービデオは、"}, {"type": "subtitle", "time": 13223.83, "timestamp": "03:40:23", "text": "デビューします。まるであなたが服従するかのようだった"}, {"type": "subtitle", "time": 13226.19, "timestamp": "03:40:26", "text": "それを会社に渡して"}, {"type": "subtitle", "time": 13229.429, "timestamp": "03:40:29", "text": "オーディション。えっと"}, {"type": "subtitle", "time": 13232.5, "timestamp": "03:40:32", "text": "私はこれを見てもいいのだろうかと感じた。"}, {"type": "subtitle", "time": 13234.95, "timestamp": "03:40:34", "text": "[音楽]"}, {"type": "subtitle", "time": 13238.95, "timestamp": "03:40:38", "text": "いいえ。ええ。でも、それを見た時、"}, {"type": "chat", "time": 13241.991, "timestamp": "03:40:41", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "Woah that's brutal lmao"}, {"type": "subtitle", "time": 13243.03, "timestamp": "03:40:43", "text": "私もそんな感じでした。"}, {"type": "subtitle", "time": 13245.75, "timestamp": "03:40:45", "text": "それは急ぎ足で、まるで"}, {"type": "subtitle", "time": 13248.389, "timestamp": "03:40:48", "text": "あまりにも早く一緒になりすぎた。"}, {"type": "subtitle", "time": 13250.07, "timestamp": "03:40:50", "text": "はい。"}, {"type": "subtitle", "time": 13251.99, "timestamp": "03:40:51", "text": "おお。それはひどい。私は"}, {"type": "subtitle", "time": 13256.55, "timestamp": "03:40:56", "text": "ひどい話だ。私は意地悪をしようとしているんです。"}, {"type": "subtitle", "time": 13258.389, "timestamp": "03:40:58", "text": "私は言った"}]
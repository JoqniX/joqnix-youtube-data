[{"type": "subtitle", "time": 10201.75, "timestamp": "02:50:01", "text": "まるで狂ったように、私は学ぶ"}, {"type": "subtitle", "time": 10203.51, "timestamp": "02:50:03", "text": "友達を見ると、"}, {"type": "subtitle", "time": 10205.59, "timestamp": "02:50:05", "text": "スピーキングの授業を受ける"}, {"type": "subtitle", "time": 10207.269, "timestamp": "02:50:07", "text": "英語を勉強しているんだけど、私は「誰が"}, {"type": "subtitle", "time": 10210.07, "timestamp": "02:50:10", "text": "クソ野郎が英語を学ぶのか？"}, {"type": "subtitle", "time": 10212.63, "timestamp": "02:50:12", "text": "そういうことは学ばなきゃいけないんだよ。"}, {"type": "subtitle", "time": 10215.469, "timestamp": "02:50:15", "text": "私も同じように思いました。"}, {"type": "subtitle", "time": 10218.55, "timestamp": "02:50:18", "text": "なぜ会話を学ぶ必要があるのか​​？ない"}, {"type": "subtitle", "time": 10220.469, "timestamp": "02:50:20", "text": "会話可能な英語。いいえ、他のタイプの"}, {"type": "subtitle", "time": 10223.03, "timestamp": "02:50:23", "text": "英語。いいえ、オックスフォードはたくさん"}, {"type": "subtitle", "time": 10225.75, "timestamp": "02:50:25", "text": "英語でも何でもいいです。私は「えっ？」って感じでした。"}, {"type": "subtitle", "time": 10228.309, "timestamp": "02:50:28", "text": "うん。"}, {"type": "subtitle", "time": 10230.309, "timestamp": "02:50:30", "text": "私の妹と同じように、彼女は"}, {"type": "subtitle", "time": 10232.15, "timestamp": "02:50:32", "text": "それ。彼女は私のことを理解しているが、"}, {"type": "subtitle", "time": 10233.75, "timestamp": "02:50:33", "text": "彼女は「私の家族には良い人は誰もいない」と言っている"}, {"type": "subtitle", "time": 10236.23, "timestamp": "02:50:36", "text": "それに取り組む。まるで話せないみたいだ。彼らはできる"}, {"type": "subtitle", "time": 10242.63, "timestamp": "02:50:42", "text": "そして彼女はいくつかのことで恥ずかしい思いをしている"}, {"type": "subtitle", "time": 10245.91, "timestamp": "02:50:45", "text": "理由は、彼女が英語を話せないからです。"}, {"type": "subtitle", "time": 10248.79, "timestamp": "02:50:48", "text": "うん。そしてそれは彼女の友人たちの間での自慢話でもある。"}, {"type": "subtitle", "time": 10251.03, "timestamp": "02:50:51", "text": "彼女はこれを自慢した。それはまるで、"}, {"type": "subtitle", "time": 10253.349, "timestamp": "02:50:53", "text": "「ええ、私の兄は英語を話せます」"}, {"type": "subtitle", "time": 10256.23, "timestamp": "02:50:56", "text": "非常にうまくいきました。彼は外国人と話をする"}, {"type": "subtitle", "time": 10258.67, "timestamp": "02:50:58", "text": "英語で。」私は「何だって"}]
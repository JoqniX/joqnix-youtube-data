[{"type": "subtitle", "time": 8280.07, "timestamp": "02:18:00", "text": "軍隊に入隊することもできます"}, {"type": "subtitle", "time": 8282.309, "timestamp": "02:18:02", "text": "軍人として、彼らはあなたを派遣します"}, {"type": "subtitle", "time": 8284.309, "timestamp": "02:18:04", "text": "もし彼らがあなたを戦争に送り込んだら、あなたは会いに行くことができます"}, {"type": "subtitle", "time": 8292.309, "timestamp": "02:18:12", "text": "パキスタン。こいつらって本当にバカだな。"}, {"type": "subtitle", "time": 8293.549, "timestamp": "02:18:13", "text": "ああ、"}, {"type": "subtitle", "time": 8296.549, "timestamp": "02:18:16", "text": "神。彼らは、ある男が言ったように、もし"}, {"type": "subtitle", "time": 8298.549, "timestamp": "02:18:18", "text": "爆撃したんだから、どうか私たちを憎まないでくれ。その"}, {"type": "subtitle", "time": 8312.709, "timestamp": "02:18:32", "text": "楽しい。一番面白いのは、"}, {"type": "subtitle", "time": 8314.389, "timestamp": "02:18:34", "text": "誰かが私に尋ねたように、"}, {"type": "subtitle", "time": 8317.23, "timestamp": "02:18:37", "text": "Discordチャンネル名"}, {"type": "subtitle", "time": 8320.549, "timestamp": "02:18:40", "text": "水？何が"}, {"type": "subtitle", "time": 8324.07, "timestamp": "02:18:44", "text": "何てことだ。そして人々は実際に"}, {"type": "subtitle", "time": 8325.589, "timestamp": "02:18:45", "text": "1つ作ったら、みんなが送ってきた"}, {"type": "subtitle", "time": 8331.75, "timestamp": "02:18:51", "text": "そして、誰かが人の"}, {"type": "subtitle", "time": 8334.15, "timestamp": "02:18:54", "text": "チャンネルに参加して、「ああ、"}, {"type": "subtitle", "time": 8336.15, "timestamp": "02:18:56", "text": "彼らはパキスタン出身です。"}, {"type": "subtitle", "time": 8338.429, "timestamp": "02:18:58", "text": "外で"}]
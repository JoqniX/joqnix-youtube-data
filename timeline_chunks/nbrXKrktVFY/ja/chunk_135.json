[{"type": "subtitle", "time": 8101.91, "timestamp": "02:15:01", "text": "えっと、私の彼氏は"}, {"type": "subtitle", "time": 8104.709, "timestamp": "02:15:04", "text": "彼女がGeioを持っていたから別れた"}, {"type": "subtitle", "time": 8108.87, "timestamp": "02:15:08", "text": "シムと私はGeio Simも持っていますが、今は"}, {"type": "subtitle", "time": 8111.51, "timestamp": "02:15:11", "text": "Geioのロゴを見るたびに、"}, {"type": "subtitle", "time": 8115.43, "timestamp": "02:15:15", "text": "彼女に似ている。だから、もし"}, {"type": "subtitle", "time": 8118.109, "timestamp": "02:15:18", "text": "私が切り替えても大丈夫です"}, {"type": "subtitle", "time": 8121.75, "timestamp": "02:15:21", "text": "皆さん、それっていいですか？する？しない？"}, {"type": "subtitle", "time": 8124.069, "timestamp": "02:15:24", "text": "もし私があなたを置いていったら、あなたは怒るでしょう"}, {"type": "subtitle", "time": 8127.669, "timestamp": "02:15:27", "text": "みんな？それでよろしいですか？ええ、そうしました。"}, {"type": "subtitle", "time": 8129.43, "timestamp": "02:15:29", "text": "私は「それでいいの？」って感じでした。私はただ"}, {"type": "subtitle", "time": 8132.47, "timestamp": "02:15:32", "text": "ちなみに、彼らをからかってるんだよ。"}, {"type": "subtitle", "time": 8134.149, "timestamp": "02:15:34", "text": "えっと、皆さん、それでいいでしょうか？何？しない"}, {"type": "subtitle", "time": 8137.109, "timestamp": "02:15:37", "text": "君たちは怒ってるの？"}, {"type": "subtitle", "time": 8141.03, "timestamp": "02:15:41", "text": "はい、全く問題ありません。"}, {"type": "subtitle", "time": 8143.109, "timestamp": "02:15:43", "text": "彼らもあなたに合わせているんですよ。おお。"}, {"type": "subtitle", "time": 8144.95, "timestamp": "02:15:44", "text": "うん。うん。彼らはこう言う、「もしあなたが"}, {"type": "subtitle", "time": 8146.87, "timestamp": "02:15:46", "text": "もしあなたがそう感じるなら、それは完全に"}, {"type": "subtitle", "time": 8149.27, "timestamp": "02:15:49", "text": "大丈夫。あなたの今後のご活躍をお祈りしています。そこには"}, {"type": "subtitle", "time": 8151.43, "timestamp": "02:15:51", "text": "海にはたくさんの海がある。」"}, {"type": "subtitle", "time": 8152.87, "timestamp": "02:15:52", "text": "彼らは私に関係を与え始めた"}]
[{"type": "subtitle", "time": 3303.87, "timestamp": "00:55:03", "text": "うん。待って、"}, {"type": "subtitle", "time": 3306.87, "timestamp": "00:55:06", "text": "では、どのように"}, {"type": "subtitle", "time": 3309.75, "timestamp": "00:55:09", "text": "えーと、毎月税金を払うか、"}, {"type": "subtitle", "time": 3312.23, "timestamp": "00:55:12", "text": "何か？いいえ、支払わなければなりません"}, {"type": "subtitle", "time": 3314.069, "timestamp": "00:55:14", "text": "毎年。"}, {"type": "subtitle", "time": 3315.91, "timestamp": "00:55:15", "text": "つまり、支払い方法はいくつかあるということです"}, {"type": "subtitle", "time": 3318.39, "timestamp": "00:55:18", "text": "まるで25セント硬貨で支払うように"}, {"type": "subtitle", "time": 3321.91, "timestamp": "00:55:21", "text": "年に4回"}, {"type": "subtitle", "time": 3324.95, "timestamp": "00:55:24", "text": "私の知る限りでは。"}, {"type": "subtitle", "time": 3326.309, "timestamp": "00:55:26", "text": "私は彼らに一度も支払ったことがありません。私はただ尋ねた"}, {"type": "subtitle", "time": 3327.91, "timestamp": "00:55:27", "text": "お父さん。 「じゃあ、支払わないといけないの？」"}, {"type": "subtitle", "time": 3329.349, "timestamp": "00:55:29", "text": "「税金のこと？」彼は「ああ」って感じ。私は「"}, {"type": "subtitle", "time": 3331.27, "timestamp": "00:55:31", "text": "「わかりました。いくら支払えばいいですか？」彼はこう言う、"}, {"type": "subtitle", "time": 3335.03, "timestamp": "00:55:35", "text": "「これだけだ。」 「はい、どうぞ」って感じ。"}, {"type": "subtitle", "time": 3338.47, "timestamp": "00:55:38", "text": "だから、彼は私のためにそうしてくれるんです。"}, {"type": "subtitle", "time": 3340.15, "timestamp": "00:55:40", "text": "つまり、今は税金を払わなくて済むということだ"}, {"type": "subtitle", "time": 3344.069, "timestamp": "00:55:44", "text": "なぜなら、ムタジは"}, {"type": "subtitle", "time": 3346.99, "timestamp": "00:55:46", "text": "あれ。だから今は支払う必要がない"}, {"type": "subtitle", "time": 3350.23, "timestamp": "00:55:50", "text": "キャップが2つまたは"}, {"type": "subtitle", "time": 3352.87, "timestamp": "00:55:52", "text": "３つか３つくらい"}, {"type": "subtitle", "time": 3355.109, "timestamp": "00:55:55", "text": "しかし今は12です。"}, {"type": "subtitle", "time": 3357.589, "timestamp": "00:55:57", "text": "うん。でも、父はまだ支払わなければならないと思う"}, {"type": "subtitle", "time": 3359.81, "timestamp": "00:55:59", "text": "それ。わからない。"}]
[{"type": "subtitle", "time": 12480.389, "timestamp": "03:28:00", "text": "女の子と彼らはティオスについて話していた。"}, {"type": "subtitle", "time": 12482.469, "timestamp": "03:28:02", "text": "ヒンディー語版では彼らは話している"}, {"type": "subtitle", "time": 12484.269, "timestamp": "03:28:04", "text": "について"}, {"type": "subtitle", "time": 12495.95, "timestamp": "03:28:15", "text": "何て言ってるの？"}, {"type": "subtitle", "time": 12498.229, "timestamp": "03:28:18", "text": "基本的にゴキブリは"}, {"type": "subtitle", "time": 12499.91, "timestamp": "03:28:19", "text": "ヒンディー語でゴキブリのように。わかった。"}, {"type": "subtitle", "time": 12501.75, "timestamp": "03:28:21", "text": "そう、そういう感じ"}, {"type": "subtitle", "time": 12504.63, "timestamp": "03:28:24", "text": "基本的に印象を出して、"}, {"type": "subtitle", "time": 12507.389, "timestamp": "03:28:27", "text": "これらのインド人"}, {"type": "chat", "time": 12507.625, "timestamp": "03:28:27", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "yeah they often do that"}, {"type": "subtitle", "time": 12509.59, "timestamp": "03:28:29", "text": "もしあなたがインド人なら、"}, {"type": "subtitle", "time": 12512.229, "timestamp": "03:28:32", "text": "手に入れます"}, {"type": "subtitle", "time": 12514.79, "timestamp": "03:28:34", "text": "しかし、インド国外にいる場合は"}, {"type": "subtitle", "time": 12516.55, "timestamp": "03:28:36", "text": "一体何言ってんだこいつら"}, {"type": "subtitle", "time": 12522.309, "timestamp": "03:28:42", "text": "吹き替えでも同じことをするのか？"}, {"type": "chat", "time": 12524.499, "timestamp": "03:28:44", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "but that takes away the originality"}, {"type": "subtitle", "time": 12524.87, "timestamp": "03:28:44", "text": "英語吹き替え版のように、これらも追加されます"}, {"type": "subtitle", "time": 12527.349, "timestamp": "03:28:47", "text": "参考文献みたいなもので、私は「誰が"}, {"type": "subtitle", "time": 12530.71, "timestamp": "03:28:50", "text": "誰がこれを知っているのか、誰が何を知っているのか"}, {"type": "subtitle", "time": 12538.389, "timestamp": "03:28:58", "text": "カリスマ。しかし、イングランドのファンと同じように"}]
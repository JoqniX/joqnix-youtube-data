[{"type": "subtitle", "time": 3480.549, "timestamp": "00:58:00", "text": "えっと、なんて呼ぶんだっけ？のように"}, {"type": "subtitle", "time": 3483.87, "timestamp": "00:58:03", "text": "私たちが使う機械にはまだ妖精がいます"}, {"type": "subtitle", "time": 3487.829, "timestamp": "00:58:07", "text": "デバイスによっては"}, {"type": "subtitle", "time": 3492.19, "timestamp": "00:58:12", "text": "何かをすると、どうしてそれが"}, {"type": "subtitle", "time": 3502.95, "timestamp": "00:58:22", "text": "だって、聞いてよ、最近私は"}, {"type": "subtitle", "time": 3505.43, "timestamp": "00:58:25", "text": "友達と話してるんだよね？そこで彼は言った"}, {"type": "subtitle", "time": 3508.23, "timestamp": "00:58:28", "text": "彼は、Mac Mini を使って"}, {"type": "subtitle", "time": 3511.91, "timestamp": "00:58:31", "text": "編集ですよね？うん。そしてどうやら"}, {"type": "subtitle", "time": 3514.71, "timestamp": "00:58:34", "text": "Mac Mini のやつ、えっと、何ですか"}, {"type": "subtitle", "time": 3517.19, "timestamp": "00:58:37", "text": "それって何？"}, {"type": "subtitle", "time": 3521.03, "timestamp": "00:58:41", "text": "別のデバイスが"}, {"type": "subtitle", "time": 3525.71, "timestamp": "00:58:45", "text": "それに接続すれば、物を共有できます"}, {"type": "subtitle", "time": 3528.589, "timestamp": "00:58:48", "text": "ワイヤレスで何もせずに"}, {"type": "subtitle", "time": 3531.67, "timestamp": "00:58:51", "text": "何かをインストールしない、開かない"}, {"type": "subtitle", "time": 3534.23, "timestamp": "00:58:54", "text": "ブルートゥース。それはクラウド上で処理されるだけです。"}, {"type": "subtitle", "time": 3537.109, "timestamp": "00:58:57", "text": "おお。エイリアンの技術みたいに聞こえる"}]
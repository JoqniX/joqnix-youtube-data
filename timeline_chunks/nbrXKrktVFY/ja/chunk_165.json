[{"type": "subtitle", "time": 9900.63, "timestamp": "02:45:00", "text": "ウドゥ。"}, {"type": "subtitle", "time": 9902.55, "timestamp": "02:45:02", "text": "うん。"}, {"type": "subtitle", "time": 9905.11, "timestamp": "02:45:05", "text": "そして、外国人はヒンディー語を話す。話す"}, {"type": "subtitle", "time": 9907.75, "timestamp": "02:45:07", "text": "ヒンディー語。だから、ウドゥ語が私の第一言語だったのです。"}, {"type": "subtitle", "time": 9911.19, "timestamp": "02:45:11", "text": "それからヒンディー語になった。そしてヒンディー語またはウドゥ語は"}, {"type": "subtitle", "time": 9913.269, "timestamp": "02:45:13", "text": "似たような感じですね。だから気づかなかったんです。私"}, {"type": "subtitle", "time": 9914.79, "timestamp": "02:45:14", "text": "人々が言葉を発していると思っただけ"}, {"type": "subtitle", "time": 9922.23, "timestamp": "02:45:22", "text": "そして最近は話さない、好きじゃない"}, {"type": "subtitle", "time": 9925.75, "timestamp": "02:45:25", "text": "ウドゥ語で話すのは好きじゃないから"}, {"type": "subtitle", "time": 9927.51, "timestamp": "02:45:27", "text": "ウドゥ。"}, {"type": "subtitle", "time": 9929.63, "timestamp": "02:45:29", "text": "幼少期の出来事が原因で"}, {"type": "subtitle", "time": 9932.79, "timestamp": "02:45:32", "text": "もの。それは彼にトラウマを与え、私にトラウマを与える"}, {"type": "subtitle", "time": 9934.59, "timestamp": "02:45:34", "text": "私が話すときはいつでも"}, {"type": "subtitle", "time": 9938.23, "timestamp": "02:45:38", "text": "ウドゥ。私は今ヒンディー語を話します"}, {"type": "subtitle", "time": 9947.07, "timestamp": "02:45:47", "text": "そして私の3番目の言語は"}, {"type": "subtitle", "time": 9949.83, "timestamp": "02:45:49", "text": "それはドイツ語だったと思う"}, {"type": "subtitle", "time": 9955.269, "timestamp": "02:45:55", "text": "理由。そうそう。私はドイツ語を学び、"}, {"type": "subtitle", "time": 9958.309, "timestamp": "02:45:58", "text": "それから英語になった。"}]
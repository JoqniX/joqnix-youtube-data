[{"type": "subtitle", "time": 10441.19, "timestamp": "02:54:01", "text": "うん。"}, {"type": "subtitle", "time": 10442.87, "timestamp": "02:54:02", "text": "それはまるで私たちが"}, {"type": "subtitle", "time": 10444.87, "timestamp": "02:54:04", "text": "する。"}, {"type": "subtitle", "time": 10451.75, "timestamp": "02:54:11", "text": "例えば、あなたが女の子なら、"}, {"type": "subtitle", "time": 10455.75, "timestamp": "02:54:15", "text": "別の家族に嫁いだ。"}, {"type": "subtitle", "time": 10457.83, "timestamp": "02:54:17", "text": "でも、もしあなたが男性なら、"}, {"type": "subtitle", "time": 10460.75, "timestamp": "02:54:20", "text": "あなたはここで死ぬでしょう"}, {"type": "subtitle", "time": 10470.309, "timestamp": "02:54:30", "text": "でも今は理解できた。そして今私は"}, {"type": "subtitle", "time": 10472.55, "timestamp": "02:54:32", "text": "私の街を出て、行く"}, {"type": "subtitle", "time": 10474.95, "timestamp": "02:54:34", "text": "外に出て世界を見よう。どうやってかはわかってるよ"}, {"type": "subtitle", "time": 10487.63, "timestamp": "02:54:47", "text": "なぜならそれはある意味で良いことだから"}, {"type": "subtitle", "time": 10490.23, "timestamp": "02:54:50", "text": "なぜならそれは世界が"}, {"type": "subtitle", "time": 10491.83, "timestamp": "02:54:51", "text": "作品。"}, {"type": "subtitle", "time": 10493.91, "timestamp": "02:54:53", "text": "うん。"}, {"type": "subtitle", "time": 10497.19, "timestamp": "02:54:57", "text": "一人暮らしをする。"}]
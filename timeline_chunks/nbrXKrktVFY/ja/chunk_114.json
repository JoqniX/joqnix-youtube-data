[{"type": "subtitle", "time": 6842.229, "timestamp": "01:54:02", "text": "彼らは怪物だから、怪物なのだ。彼らは"}, {"type": "subtitle", "time": 6843.75, "timestamp": "01:54:03", "text": "彼女たちは悪魔だからモンスターガールだ"}, {"type": "subtitle", "time": 6846.55, "timestamp": "01:54:06", "text": "ロードは現在、最悪なバスです。そして"}, {"type": "subtitle", "time": 6849.03, "timestamp": "01:54:09", "text": "サキュバスは魔王である。そして悪魔"}, {"type": "subtitle", "time": 6850.95, "timestamp": "01:54:10", "text": "領主はマナを制御する。そしてマナは、"}, {"type": "subtitle", "time": 6853.91, "timestamp": "01:54:13", "text": "閉じる方法によって、その物が変わる"}, {"type": "subtitle", "time": 6857.35, "timestamp": "01:54:17", "text": "そっちに。"}, {"type": "subtitle", "time": 6860.149, "timestamp": "01:54:20", "text": "つまり、何かが悪魔のマナを持っている場合、"}, {"type": "subtitle", "time": 6863.35, "timestamp": "01:54:23", "text": "怪物に変身してしまうだろう。そしてそれ以来"}, {"type": "subtitle", "time": 6866.189, "timestamp": "01:54:26", "text": "現在の魔王は"}, {"type": "subtitle", "time": 6869.83, "timestamp": "01:54:29", "text": "サキュバス、それは"}, {"type": "subtitle", "time": 6872.87, "timestamp": "01:54:32", "text": "モンスターガール。だからモンスターがこんなにたくさんいる"}, {"type": "subtitle", "time": 6875.03, "timestamp": "01:54:35", "text": "モンスターシリーズの女の子は多くない"}, {"type": "subtitle", "time": 6877.75, "timestamp": "01:54:37", "text": "男性。"}, {"type": "subtitle", "time": 6885.31, "timestamp": "01:54:45", "text": "つまり、オスのモンスターみたいなもの"}, {"type": "subtitle", "time": 6888.47, "timestamp": "01:54:48", "text": "女の子たちだけど、手に入れたのは男の子たち"}, {"type": "subtitle", "time": 6892.75, "timestamp": "01:54:52", "text": "悪魔の魔力が宿り、"}, {"type": "subtitle", "time": 6895.43, "timestamp": "01:54:55", "text": "まるでモンスターガールがいるみたい"}, {"type": "subtitle", "time": 6897.589, "timestamp": "01:54:57", "text": "アリスだと思うのですが、やり方がわかりません"}, {"type": "subtitle", "time": 6899.91, "timestamp": "01:54:59", "text": "私が今読んだ名前を発音します"}]
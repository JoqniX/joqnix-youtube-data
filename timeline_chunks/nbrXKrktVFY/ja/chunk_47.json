[{"type": "subtitle", "time": 2821.67, "timestamp": "00:47:01", "text": "それはあなたの"}, {"type": "subtitle", "time": 2824.39, "timestamp": "00:47:04", "text": "彼らが使う物語は、"}, {"type": "subtitle", "time": 2826.67, "timestamp": "00:47:06", "text": "みんな、私が"}, {"type": "subtitle", "time": 2828.87, "timestamp": "00:47:08", "text": "君はあの人たちのことを知っていると思うけど、"}, {"type": "subtitle", "time": 2831.91, "timestamp": "00:47:11", "text": "家の中に火を入れるのは良いことではない"}, {"type": "subtitle", "time": 2834.71, "timestamp": "00:47:14", "text": "アイデアかもしれない"}, {"type": "subtitle", "time": 2836.71, "timestamp": "00:47:16", "text": "みんな、私は"}, {"type": "subtitle", "time": 2840.109, "timestamp": "00:47:20", "text": "プラスチックのものは良くない"}, {"type": "subtitle", "time": 2842.71, "timestamp": "00:47:22", "text": "アイデアだから、私は、"}, {"type": "subtitle", "time": 2844.71, "timestamp": "00:47:24", "text": "私は理性的な人間ではないので、"}, {"type": "subtitle", "time": 2846.589, "timestamp": "00:47:26", "text": "くだらないこと"}, {"type": "subtitle", "time": 2848.95, "timestamp": "00:47:28", "text": "右。でも私はビッグみたいにならなきゃ"}, {"type": "subtitle", "time": 2851.23, "timestamp": "00:47:31", "text": "兄弟と保存"}, {"type": "subtitle", "time": 2854.47, "timestamp": "00:47:34", "text": "みんな。だから時々私は"}, {"type": "subtitle", "time": 2856.47, "timestamp": "00:47:36", "text": "時々私は馬鹿なことをするし、"}, {"type": "subtitle", "time": 2858.39, "timestamp": "00:47:38", "text": "両親は私に「あなたは一番年上ですか？」と尋ねるでしょう"}, {"type": "subtitle", "time": 2860.39, "timestamp": "00:47:40", "text": "1つ。どうしてそうするの？"}, {"type": "subtitle", "time": 2862.63, "timestamp": "00:47:42", "text": "これ？私は「わからない」という感じです。発売されました"}, {"type": "subtitle", "time": 2865.589, "timestamp": "00:47:45", "text": "例えば今日のように。だから私は"}, {"type": "subtitle", "time": 2867.91, "timestamp": "00:47:47", "text": "このバナナのことですよね？彼らは探している"}, {"type": "subtitle", "time": 2869.829, "timestamp": "00:47:49", "text": "彼らはあまりにも良すぎた。だから私は"}, {"type": "subtitle", "time": 2871.67, "timestamp": "00:47:51", "text": "買わなきゃいけないって感じだったよ。彼らは"}, {"type": "subtitle", "time": 2874.23, "timestamp": "00:47:54", "text": "良すぎるように見える。家に帰った。私は"}, {"type": "subtitle", "time": 2877.109, "timestamp": "00:47:57", "text": "興奮した。私はそのうちの1つを手に入れ、"}, {"type": "subtitle", "time": 2879.109, "timestamp": "00:47:59", "text": "食べてみたら、生だった。彼らはいた"}]
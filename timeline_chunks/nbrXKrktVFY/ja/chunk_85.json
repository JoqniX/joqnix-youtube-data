[{"type": "subtitle", "time": 5105.91, "timestamp": "01:25:05", "text": "あまりにも。それは、そして私は、"}, {"type": "subtitle", "time": 5108.39, "timestamp": "01:25:08", "text": "スナック菓子ばかり食べるようなことはしない。私は食べています"}, {"type": "subtitle", "time": 5113.669, "timestamp": "01:25:13", "text": "まるでフルコース料理のようだ。何てことだ。"}, {"type": "subtitle", "time": 5116.55, "timestamp": "01:25:16", "text": "そして私は相変わらずものすごく痩せていた。"}, {"type": "subtitle", "time": 5118.79, "timestamp": "01:25:18", "text": "ああ、私たちは"}, {"type": "subtitle", "time": 5121.75, "timestamp": "01:25:21", "text": "似たようなものだ、私も脂肪が増えていないから"}, {"type": "subtitle", "time": 5125.35, "timestamp": "01:25:25", "text": "全て。以前は体重が38キロくらいだったんです"}, {"type": "subtitle", "time": 5128.95, "timestamp": "01:25:28", "text": "キログラムとか、それより少ない量。そして"}, {"type": "subtitle", "time": 5132.95, "timestamp": "01:25:32", "text": "今は46くらいかな。 45 I"}, {"type": "subtitle", "time": 5134.709, "timestamp": "01:25:34", "text": "考える。わからない。依然として低体重"}, {"type": "subtitle", "time": 5136.87, "timestamp": "01:25:36", "text": "けれど。うん、"}, {"type": "subtitle", "time": 5139.07, "timestamp": "01:25:39", "text": "私は以前は"}, {"type": "subtitle", "time": 5143.83, "timestamp": "01:25:43", "text": "50、それは少なすぎた"}, {"type": "subtitle", "time": 5146.87, "timestamp": "01:25:46", "text": "私の身長。"}, {"type": "subtitle", "time": 5148.709, "timestamp": "01:25:48", "text": "それは私にとっては基本的に何でもないことだった"}, {"type": "subtitle", "time": 5149.88, "timestamp": "01:25:49", "text": "身長。"}, {"type": "subtitle", "time": 5151.27, "timestamp": "01:25:51", "text": "[音楽]"}, {"type": "subtitle", "time": 5152.87, "timestamp": "01:25:52", "text": "私が自分の体重を人に伝えたとき、"}, {"type": "subtitle", "time": 5155.95, "timestamp": "01:25:55", "text": "「いや、そんなはずはない」"}, {"type": "subtitle", "time": 5158.47, "timestamp": "01:25:58", "text": "そうだね。彼らは「あの、あの"}]
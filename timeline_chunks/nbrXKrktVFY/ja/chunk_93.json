[{"type": "subtitle", "time": 5581.75, "timestamp": "01:33:01", "text": "トマトが入っているのは、私がトマトが好きだからです"}, {"type": "subtitle", "time": 5584.229, "timestamp": "01:33:04", "text": "そして私はそれを彼女に渡します、そして彼女はそう思います"}, {"type": "subtitle", "time": 5587.669, "timestamp": "01:33:07", "text": "私は彼女を殺そうとしている。なんてこった。彼女は"}, {"type": "subtitle", "time": 5589.35, "timestamp": "01:33:09", "text": "なんでこんなものを入れるの？あなた"}, {"type": "subtitle", "time": 5591.75, "timestamp": "01:33:11", "text": "吐き気がするってわかってるよ。私は「えっ？」って感じでした。"}, {"type": "subtitle", "time": 5593.669, "timestamp": "01:33:13", "text": "調理済みです。味はしません"}, {"type": "subtitle", "time": 5597.35, "timestamp": "01:33:17", "text": "それ。彼女は「あなたは私を殺そうとしている」と言った。知っている"}, {"type": "subtitle", "time": 5601.27, "timestamp": "01:33:21", "text": "私が知っているあなたの計画。"}, {"type": "subtitle", "time": 5603.39, "timestamp": "01:33:23", "text": "ああ、"}, {"type": "subtitle", "time": 5606.47, "timestamp": "01:33:26", "text": "神。子供の頃、私はトマトが大好きでした。"}, {"type": "subtitle", "time": 5609.59, "timestamp": "01:33:29", "text": "トマトの味が好き"}, {"type": "subtitle", "time": 5612.31, "timestamp": "01:33:32", "text": "でも私は彼らを愛さなくなったのは"}, {"type": "subtitle", "time": 5614.55, "timestamp": "01:33:34", "text": "トマトで事故が起きた"}, {"type": "subtitle", "time": 5620.79, "timestamp": "01:33:40", "text": "トマト風味。私には兄弟がいたんですよね？"}, {"type": "subtitle", "time": 5623.43, "timestamp": "01:33:43", "text": "彼は双子の兄弟だった。彼は以前は"}, {"type": "subtitle", "time": 5627.229, "timestamp": "01:33:47", "text": "私には双子の兄弟がいました"}, {"type": "subtitle", "time": 5631.51, "timestamp": "01:33:51", "text": "そして私たちは、私たちが行くところへ行きました"}, {"type": "subtitle", "time": 5634.07, "timestamp": "01:33:54", "text": "ムンバイへ。私たちは電車に乗っていたと思います"}, {"type": "subtitle", "time": 5637.83, "timestamp": "01:33:57", "text": "そして私たちはトマト味のチップスを食べました"}]
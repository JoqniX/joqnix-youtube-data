[{"type": "subtitle", "time": 9721.59, "timestamp": "02:42:01", "text": "面白いね、だって彼は君のことをバハンって呼んでるんだもん"}, {"type": "subtitle", "time": 9725.71, "timestamp": "02:42:05", "text": "カランド、つまりあなたの禁止令は"}, {"type": "subtitle", "time": 9727.95, "timestamp": "02:42:07", "text": "ちんこ。それは"}, {"type": "subtitle", "time": 9730.63, "timestamp": "02:42:10", "text": "無礼だ。うん。"}, {"type": "subtitle", "time": 9739.349, "timestamp": "02:42:19", "text": "ところで、ジョー、あなたに聞きたいことがあるんだけど"}, {"type": "subtitle", "time": 9742.389, "timestamp": "02:42:22", "text": "ヒンディー語はどの程度話せますか？"}, {"type": "subtitle", "time": 9744.87, "timestamp": "02:42:24", "text": "わかった。私はあなたがヒンディー語を話すのを聞いたことがない"}, {"type": "subtitle", "time": 9746.79, "timestamp": "02:42:26", "text": "多く。"}, {"type": "subtitle", "time": 9750.55, "timestamp": "02:42:30", "text": "それは本当です。えっと"}, {"type": "subtitle", "time": 9753.75, "timestamp": "02:42:33", "text": "10標準 10標準のように考えてください"}, {"type": "subtitle", "time": 9756.389, "timestamp": "02:42:36", "text": "ヒンディー語。私が知っているのはそれだけです。でも私は"}, {"type": "subtitle", "time": 9758.55, "timestamp": "02:42:38", "text": "私はそれが苦手です。何でも書いてください"}, {"type": "subtitle", "time": 9760.63, "timestamp": "02:42:40", "text": "そして、どうにかしてその瞬間を過ごす。うん、"}, {"type": "subtitle", "time": 9763.23, "timestamp": "02:42:43", "text": "それは私です。"}, {"type": "subtitle", "time": 9765.429, "timestamp": "02:42:45", "text": "おお。君のお母さんって誰？何ですか"}, {"type": "subtitle", "time": 9768.63, "timestamp": "02:42:48", "text": "あなたの母語は？ネイティブは"}, {"type": "subtitle", "time": 9770.87, "timestamp": "02:42:50", "text": "マラヤーラム語。"}, {"type": "subtitle", "time": 9773.99, "timestamp": "02:42:53", "text": "私もそれは苦手です。私は読めません"}, {"type": "subtitle", "time": 9776.71, "timestamp": "02:42:56", "text": "書く。"}]
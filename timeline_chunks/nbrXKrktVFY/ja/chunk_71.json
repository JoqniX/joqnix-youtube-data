[{"type": "subtitle", "time": 4262.79, "timestamp": "01:11:02", "text": "ああ、じゃあ私は働く必要がないんですね。"}, {"type": "subtitle", "time": 4265.59, "timestamp": "01:11:05", "text": "いいえ、首都圏だから、ああ、同じような感じです"}, {"type": "subtitle", "time": 4268.47, "timestamp": "01:11:08", "text": "資本主義では、人々は働くことで成功することができる。"}, {"type": "subtitle", "time": 4271.99, "timestamp": "01:11:11", "text": "一番上。しかし共産主義では、もしあなたが"}, {"type": "subtitle", "time": 4273.99, "timestamp": "01:11:13", "text": "すでにトップにいるあなたは、"}, {"type": "subtitle", "time": 4275.43, "timestamp": "01:11:15", "text": "トップ。そして、もしあなたが最下位にいるなら、"}, {"type": "subtitle", "time": 4278.95, "timestamp": "01:11:18", "text": "最下位にとどまるだろう。"}, {"type": "subtitle", "time": 4285.35, "timestamp": "01:11:25", "text": "あまりにも。なぜこんなにも不均衡なのか？なぜ"}, {"type": "subtitle", "time": 4287.189, "timestamp": "01:11:27", "text": "両方を結合して"}, {"type": "subtitle", "time": 4289.91, "timestamp": "01:11:29", "text": "新しいものを作る？もしそれがそんなに簡単だったら"}, {"type": "subtitle", "time": 4291.83, "timestamp": "01:11:31", "text": "冗談だよ、たぶん私たちはそれをやるだろう"}, {"type": "subtitle", "time": 4303.75, "timestamp": "01:11:43", "text": "私の場合、もし社会があったら"}, {"type": "subtitle", "time": 4306.31, "timestamp": "01:11:46", "text": "無政府状態にしてしまえ。"}, {"type": "subtitle", "time": 4309.189, "timestamp": "01:11:49", "text": "ルールなし。みんなで行く みんなで行く"}, {"type": "subtitle", "time": 4311.59, "timestamp": "01:11:51", "text": "彼ら自身のために。好きなようにやれ"}]
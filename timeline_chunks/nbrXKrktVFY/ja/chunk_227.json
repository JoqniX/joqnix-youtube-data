[{"type": "subtitle", "time": 13628.03, "timestamp": "03:47:08", "text": "ピパ、テンマ、ウロカ、リアなど。私は"}, {"type": "subtitle", "time": 13630.469, "timestamp": "03:47:10", "text": "こういう人たちは見つけられない"}, {"type": "subtitle", "time": 13633.429, "timestamp": "03:47:13", "text": "通常。一体どうやって見つけたんだ？"}, {"type": "subtitle", "time": 13635.95, "timestamp": "03:47:15", "text": "会社にとって？"}, {"type": "subtitle", "time": 13643.07, "timestamp": "03:47:23", "text": "うん。才能のように"}, {"type": "subtitle", "time": 13647.83, "timestamp": "03:47:27", "text": "えーと、エリザベスですよね？エリザベスは"}, {"type": "subtitle", "time": 13648.86, "timestamp": "03:47:28", "text": "ローズブ。"}, {"type": "subtitle", "time": 13651.83, "timestamp": "03:47:31", "text": "[音楽]"}, {"type": "subtitle", "time": 13655.91, "timestamp": "03:47:35", "text": "はい。私がハーブと呼んでいる彼女のこと。ハーブ"}, {"type": "subtitle", "time": 13658.07, "timestamp": "03:47:38", "text": "彼女がHolの人生にいるのは理にかなっているように"}, {"type": "subtitle", "time": 13660.469, "timestamp": "03:47:40", "text": "彼女は才能があったからだ。彼女は好きだった"}, {"type": "subtitle", "time": 13662.389, "timestamp": "03:47:42", "text": "彼女のコンテンツはまさに"}, {"type": "subtitle", "time": 13665.59, "timestamp": "03:47:45", "text": "ホルライフ。うん。彼女がHol Lifeにいるということは"}, {"type": "subtitle", "time": 13668.309, "timestamp": "03:47:48", "text": "全く理にかなっている。しかし、"}, {"type": "subtitle", "time": 13672.15, "timestamp": "03:47:52", "text": "例えばビブM"}, {"type": "subtitle", "time": 13676.429, "timestamp": "03:47:56", "text": "彼女があなたが考えるとき"}, {"type": "subtitle", "time": 13679.51, "timestamp": "03:47:59", "text": "採用担当者はどうやって"}]
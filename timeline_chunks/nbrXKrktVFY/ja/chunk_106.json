[{"type": "subtitle", "time": 6364.07, "timestamp": "01:46:04", "text": "泣く。彼女は「いや、それは爆撃みたいなものだ」"}, {"type": "subtitle", "time": 6367.55, "timestamp": "01:46:07", "text": "他国が爆撃しないように、あなた自身が"}, {"type": "subtitle", "time": 6376.55, "timestamp": "01:46:16", "text": "何てことだ。それは自殺するようなものだ"}, {"type": "subtitle", "time": 6382.55, "timestamp": "01:46:22", "text": "あなた。私も基本的に同じことをしていました"}, {"type": "subtitle", "time": 6387.51, "timestamp": "01:46:27", "text": "物だが、スピーチのようなもの"}, {"type": "subtitle", "time": 6389.109, "timestamp": "01:46:29", "text": "私が彼女に何と呼んでいるかを伝えたから"}, {"type": "subtitle", "time": 6391.27, "timestamp": "01:46:31", "text": "私と彼女は、彼女が泣き始めたのを見てそう思った。"}, {"type": "subtitle", "time": 6393.59, "timestamp": "01:46:33", "text": "私はあなたが感じていたことを知らなかった"}, {"type": "subtitle", "time": 6395.669, "timestamp": "01:46:35", "text": "そのように。私はこう思う、それは悪いことなのか"}, {"type": "subtitle", "time": 6396.91, "timestamp": "01:46:36", "text": "これ"}, {"type": "subtitle", "time": 6399.35, "timestamp": "01:46:39", "text": "方法？私は人付き合いが苦手だからです。私"}, {"type": "subtitle", "time": 6401.189, "timestamp": "01:46:41", "text": "人とあまり交流しない"}, {"type": "subtitle", "time": 6404.629, "timestamp": "01:46:44", "text": "現実世界の人ともオンラインで話す"}, {"type": "subtitle", "time": 6406.95, "timestamp": "01:46:46", "text": "多くの人がいますが、オンラインではそれは良くありません"}, {"type": "subtitle", "time": 6411.99, "timestamp": "01:46:51", "text": "えっと、現実世界と比較するためのもの。うん。"}, {"type": "subtitle", "time": 6416.55, "timestamp": "01:46:56", "text": "現実世界では、私は極度の内向型人間なんです"}, {"type": "subtitle", "time": 6419.27, "timestamp": "01:46:59", "text": "極端で、見るのが辛い"}]
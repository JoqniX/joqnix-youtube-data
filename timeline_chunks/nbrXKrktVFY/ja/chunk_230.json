[{"type": "subtitle", "time": 13809.03, "timestamp": "03:50:09", "text": "でも、ミスミス管理みたいな"}, {"type": "subtitle", "time": 13809.87, "timestamp": "03:50:09", "text": "のように"}, {"type": "subtitle", "time": 13812.55, "timestamp": "03:50:12", "text": "それ。中が空洞なのはちょっと怪しい。私は"}, {"type": "subtitle", "time": 13815.83, "timestamp": "03:50:15", "text": "えっと、なぜ？一度。わかった。 2回。"}, {"type": "subtitle", "time": 13817.83, "timestamp": "03:50:17", "text": "3回。わかった。わかった。何かが"}, {"type": "subtitle", "time": 13821.03, "timestamp": "03:50:21", "text": "ここは間違いです。 4回目。何かが"}, {"type": "subtitle", "time": 13830.469, "timestamp": "03:50:30", "text": "最高の卒業式だったと思う"}, {"type": "subtitle", "time": 13833.189, "timestamp": "03:50:33", "text": "ホロウからアーメンだったのは、彼女が"}, {"type": "subtitle", "time": 13834.63, "timestamp": "03:50:34", "text": "卒業式は"}, {"type": "subtitle", "time": 13836.309, "timestamp": "03:50:36", "text": "卒業。それはまるで、ああ、私は"}, {"type": "subtitle", "time": 13840.15, "timestamp": "03:50:40", "text": "牛乳を買いに行くよ。"}, {"type": "subtitle", "time": 13842.229, "timestamp": "03:50:42", "text": "まあ、いつか彼女は戻ってくるだろうね。私"}, {"type": "subtitle", "time": 13848.71, "timestamp": "03:50:48", "text": "それが、"}, {"type": "subtitle", "time": 13851.269, "timestamp": "03:50:51", "text": "私たちにそのニュースを伝えてください。"}, {"type": "subtitle", "time": 13853.269, "timestamp": "03:50:53", "text": "うん。"}, {"type": "subtitle", "time": 13855.189, "timestamp": "03:50:55", "text": "最もひどい卒業式は"}]
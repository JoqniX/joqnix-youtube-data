[{"type": "subtitle", "time": 1981.669, "timestamp": "00:33:01", "text": "特に私が好きなもの"}, {"type": "subtitle", "time": 1983.75, "timestamp": "00:33:03", "text": "まるで混沌が私の好きなものの中に広がっていくかのようだ"}, {"type": "subtitle", "time": 1986.71, "timestamp": "00:33:06", "text": "私はただ自分の繭の中に入りたいだけなんです、オーケー"}, {"type": "subtitle", "time": 1992.31, "timestamp": "00:33:12", "text": "立ち去る、そして私はそうした。私は行ってしまった"}, {"type": "subtitle", "time": 1994.87, "timestamp": "00:33:14", "text": "1ヶ月くらいだと思うけど、人々は"}, {"type": "subtitle", "time": 1996.47, "timestamp": "00:33:16", "text": "「生きてるの？」って感じだった。私は"}, {"type": "subtitle", "time": 2002.31, "timestamp": "00:33:22", "text": "あなたはどうですか？あなたは"}, {"type": "subtitle", "time": 2005.95, "timestamp": "00:33:25", "text": "安息日。調子はどうだい？えっと、それは"}, {"type": "subtitle", "time": 2010.149, "timestamp": "00:33:30", "text": "どう言えばいいかな？ええ、"}, {"type": "subtitle", "time": 2014.389, "timestamp": "00:33:34", "text": "サバタ、メインについて思うんだけど"}, {"type": "subtitle", "time": 2017.35, "timestamp": "00:33:37", "text": "その目標は、その一部が"}, {"type": "subtitle", "time": 2020.149, "timestamp": "00:33:40", "text": "お金に関しては、現時点では私は"}, {"type": "subtitle", "time": 2022.95, "timestamp": "00:33:42", "text": "それはあまり気にしすぎている"}, {"type": "subtitle", "time": 2025.35, "timestamp": "00:33:45", "text": "膨大な量で、ほぼ"}, {"type": "subtitle", "time": 2029.269, "timestamp": "00:33:49", "text": "不可能だけど、私が持っている限り"}, {"type": "subtitle", "time": 2034.31, "timestamp": "00:33:54", "text": "楽しいし、楽しんでるし、いい感じだし、えーと"}, {"type": "subtitle", "time": 2037.19, "timestamp": "00:33:57", "text": "一番の目的は楽しむことだ。はい。"}]
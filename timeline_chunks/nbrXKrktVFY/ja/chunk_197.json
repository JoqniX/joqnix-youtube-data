[{"type": "subtitle", "time": 11826.07, "timestamp": "03:17:06", "text": "私が見た空虚な人間もいる"}, {"type": "subtitle", "time": 11828.07, "timestamp": "03:17:08", "text": "中空のファンはそうしない、私はそうしない"}, {"type": "subtitle", "time": 11829.91, "timestamp": "03:17:09", "text": "中空のファンだと思うが、"}, {"type": "subtitle", "time": 11832.469, "timestamp": "03:17:12", "text": "人々はホロライフ関連のものを使ってそれを行う"}, {"type": "subtitle", "time": 11834.15, "timestamp": "03:17:14", "text": "報告すれば彼らは"}, {"type": "subtitle", "time": 11836.389, "timestamp": "03:17:16", "text": "チャンネルは2秒ほどで消えてしまう"}, {"type": "subtitle", "time": 11838.19, "timestamp": "03:17:18", "text": "なぜなら私は"}, {"type": "subtitle", "time": 11840.79, "timestamp": "03:17:20", "text": "ホログラムファンはたくさんいると思う"}, {"type": "subtitle", "time": 11843.429, "timestamp": "03:17:23", "text": "これも好きじゃない。だから、これが"}, {"type": "subtitle", "time": 11845.67, "timestamp": "03:17:25", "text": "こういうことは起こるもので、ファンが報告するだけです"}, {"type": "subtitle", "time": 11849.429, "timestamp": "03:17:29", "text": "それとチャンネルが消える"}, {"type": "subtitle", "time": 11851.269, "timestamp": "03:17:31", "text": "なぜなら、そこには集団全体がいるから"}, {"type": "subtitle", "time": 11853.03, "timestamp": "03:17:33", "text": "人々がただ好きである集合意識"}, {"type": "subtitle", "time": 11859.75, "timestamp": "03:17:39", "text": "例えば、私はこれを見ていた"}, {"type": "subtitle", "time": 11862.55, "timestamp": "03:17:42", "text": "個人情報を漏洩したユーチューバー"}, {"type": "subtitle", "time": 11865.349, "timestamp": "03:17:45", "text": "ライブ配信に関する情報。"}, {"type": "subtitle", "time": 11868.95, "timestamp": "03:17:48", "text": "何？うん。私はどのようなタイプだったか"}, {"type": "chat", "time": 11871.418, "timestamp": "03:17:51", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "yeah especially when even the creator themselves are saying they're not comfy"}, {"type": "subtitle", "time": 11871.83, "timestamp": "03:17:51", "text": "それは個人情報ですか？彼女の法的"}, {"type": "subtitle", "time": 11876.75, "timestamp": "03:17:56", "text": "名前、居場所、すべて。はぁ。"}]
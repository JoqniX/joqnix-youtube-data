[{"type": "subtitle", "time": 3846.95, "timestamp": "01:04:06", "text": "つまり、答えはノーです。まだ"}, {"type": "subtitle", "time": 3849.309, "timestamp": "01:04:09", "text": "倫理的に間違っている。ええ、そうです"}, {"type": "subtitle", "time": 3852.309, "timestamp": "01:04:12", "text": "間違っている。そして、この中にも似たようなものがあります"}, {"type": "subtitle", "time": 3855.19, "timestamp": "01:04:15", "text": "私たちの世界のような世界"}, {"type": "subtitle", "time": 3857.029, "timestamp": "01:04:17", "text": "企業的なもののようなもので、"}, {"type": "subtitle", "time": 3858.87, "timestamp": "01:04:18", "text": "契約書に署名する必要があり、契約書は"}, {"type": "subtitle", "time": 3862.23, "timestamp": "01:04:22", "text": "基本的には奴隷パックです。"}, {"type": "subtitle", "time": 3865.029, "timestamp": "01:04:25", "text": "そうそう。特に"}, {"type": "subtitle", "time": 3866.87, "timestamp": "01:04:26", "text": "中国"}, {"type": "subtitle", "time": 3869.91, "timestamp": "01:04:29", "text": "そこには物がある"}, {"type": "subtitle", "time": 3872.789, "timestamp": "01:04:32", "text": "彼らはあなたを閉じ込めるでしょう、"}, {"type": "subtitle", "time": 3874.39, "timestamp": "01:04:34", "text": "工場建屋"}, {"type": "subtitle", "time": 3877.109, "timestamp": "01:04:37", "text": "完了。何てことだ。出られない"}, {"type": "subtitle", "time": 3878.95, "timestamp": "01:04:38", "text": "その家。家に帰ることはできません"}, {"type": "subtitle", "time": 3881.99, "timestamp": "01:04:41", "text": "そんなiPhoneは作れない。ああ、神様。待って、"}, {"type": "subtitle", "time": 3884.87, "timestamp": "01:04:44", "text": "本当に？うん。人々は閉じ込められ"}, {"type": "subtitle", "time": 3886.63, "timestamp": "01:04:46", "text": "工場。彼らは自殺することはできない"}, {"type": "subtitle", "time": 3888.87, "timestamp": "01:04:48", "text": "なぜなら、彼らはネットのようなものを持っているからです"}, {"type": "subtitle", "time": 3890.71, "timestamp": "01:04:50", "text": "飛び降りようとしたら捕まえる"}, {"type": "subtitle", "time": 3894.069, "timestamp": "01:04:54", "text": "屋根。何てことだ。状況は悪い"}, {"type": "subtitle", "time": 3896.23, "timestamp": "01:04:56", "text": "そこには。"}]
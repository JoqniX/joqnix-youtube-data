[{"type": "subtitle", "time": 6783.03, "timestamp": "01:53:03", "text": "尻尾は今そこにあります。はい。はい。はい。"}, {"type": "subtitle", "time": 6785.43, "timestamp": "01:53:05", "text": "そして彼らは尻尾を尻尾に"}, {"type": "subtitle", "time": 6788.39, "timestamp": "01:53:08", "text": "バランス"}, {"type": "subtitle", "time": 6791.83, "timestamp": "01:53:11", "text": "なぜなら、彼らの体はとても重いからだ。"}, {"type": "subtitle", "time": 6794.47, "timestamp": "01:53:14", "text": "うん、"}, {"type": "subtitle", "time": 6798.47, "timestamp": "01:53:18", "text": "この件については専門家の意見が必要だ。ええ、そうです。"}, {"type": "subtitle", "time": 6800.39, "timestamp": "01:53:20", "text": "つまり、以前は私が専門家だったんです。えっと、私は"}, {"type": "subtitle", "time": 6803.189, "timestamp": "01:53:23", "text": "モンスターガールの作品を書いていた"}, {"type": "subtitle", "time": 6805.109, "timestamp": "01:53:25", "text": "百科事典。"}, {"type": "subtitle", "time": 6809.669, "timestamp": "01:53:29", "text": "ああ、そこでたくさん編集したよ"}, {"type": "subtitle", "time": 6813.109, "timestamp": "01:53:33", "text": "別の名前で。"}, {"type": "subtitle", "time": 6815.75, "timestamp": "01:53:35", "text": "私がオタクだと気づいたのは、"}, {"type": "subtitle", "time": 6817.189, "timestamp": "01:53:37", "text": "他の男たちと喧嘩を始めた"}, {"type": "subtitle", "time": 6819.03, "timestamp": "01:53:39", "text": "Wikipediaで。私はあなたたちと同じように"}, {"type": "subtitle", "time": 6819.79, "timestamp": "01:53:39", "text": "ない"}, {"type": "subtitle", "time": 6822.229, "timestamp": "01:53:42", "text": "理解する。それは悪魔のマナで"}, {"type": "subtitle", "time": 6823.47, "timestamp": "01:53:43", "text": "変換する"}, {"type": "subtitle", "time": 6827.47, "timestamp": "01:53:47", "text": "女の子は生まれつき"}, {"type": "subtitle", "time": 6834.47, "timestamp": "01:53:54", "text": "えっと、私が説明していたのは、"}, {"type": "subtitle", "time": 6837.03, "timestamp": "01:53:57", "text": "新しく加わった管理者。 「わかった、じゃあ"}, {"type": "subtitle", "time": 6839.669, "timestamp": "01:53:59", "text": "おい、聞いてくれ。モンスターガールは"}]
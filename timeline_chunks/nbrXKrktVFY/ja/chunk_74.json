[{"type": "subtitle", "time": 4441.51, "timestamp": "01:14:01", "text": "嫌いになっても構わないものって何？"}, {"type": "subtitle", "time": 4451.669, "timestamp": "01:14:11", "text": "それは良い質問ですね。しかしなぜ"}, {"type": "subtitle", "time": 4453.43, "timestamp": "01:14:13", "text": "頭の中で何もかも正しく考えられない"}, {"type": "subtitle", "time": 4463.91, "timestamp": "01:14:23", "text": "バットをあなたに渡してもいいですか？"}, {"type": "subtitle", "time": 4466.43, "timestamp": "01:14:26", "text": "あなたならどうしますか？"}, {"type": "subtitle", "time": 4470.229, "timestamp": "01:14:30", "text": "言う？それは私にとって"}, {"type": "subtitle", "time": 4472.189, "timestamp": "01:14:32", "text": "嫌いになっても構わないものが多すぎる"}, {"type": "subtitle", "time": 4474.87, "timestamp": "01:14:34", "text": "だが、いつも出てくることは"}, {"type": "subtitle", "time": 4479.91, "timestamp": "01:14:39", "text": "私の頭の中にはアニメの女の子たちが浮かぶ。"}, {"type": "subtitle", "time": 4482.95, "timestamp": "01:14:42", "text": "アニメの女の子が嫌いなの？いいえ、大丈夫です"}, {"type": "subtitle", "time": 4489.91, "timestamp": "01:14:49", "text": "ああ、例えば誰かがアニメを嫌っているとしたら"}, {"type": "subtitle", "time": 4493.43, "timestamp": "01:14:53", "text": "女の子たち、それでいいんだよ。するとそれは"}, {"type": "subtitle", "time": 4497.35, "timestamp": "01:14:57", "text": "私があなたを嫌っても構わない。"}, {"type": "subtitle", "time": 4499.18, "timestamp": "01:14:59", "text": "それが私の論理です。"}]
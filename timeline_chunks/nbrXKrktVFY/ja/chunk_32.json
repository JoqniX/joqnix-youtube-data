[{"type": "subtitle", "time": 1920.71, "timestamp": "00:32:00", "text": "そういえば、今は髭を生やしているんです。私はもうすぐ"}, {"type": "subtitle", "time": 1923.11, "timestamp": "00:32:03", "text": "薄毛。私はジムに通っているので、"}, {"type": "subtitle", "time": 1925.43, "timestamp": "00:32:05", "text": "今は筋肉質だ。"}, {"type": "subtitle", "time": 1929.19, "timestamp": "00:32:09", "text": "うん。つまり、物理的には無理だ。でもオンラインでは、私は"}, {"type": "chat", "time": 1930.801, "timestamp": "00:32:10", "author": "@MegaWashere23", "avatar": "https://yt4.ggpht.com/zLzxXLffVwLKGsObDktU_-Y2fN57694onVxYip_7B74ZX0yHcfvZzth_c0OWl-Mn0K5g04Vn=s64-c-k-c0x00ffffff-no-rj", "message": "dame dane"}, {"type": "chat", "time": 1933.045, "timestamp": "00:32:13", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Greetings Konzteller! MegaWasntHere~🌟 Welcome to the Guild! Make sure to read the Guildmate Guidelines in the description below before chatting further. Enjoy your stay!"}, {"type": "subtitle", "time": 1935.269, "timestamp": "00:32:15", "text": "うん。オンラインでは、あなたはどんな人にもなれる"}, {"type": "subtitle", "time": 1939.029, "timestamp": "00:32:19", "text": "欲しい。いや、それがこの商品の素晴らしいところなんだ。"}, {"type": "subtitle", "time": 1940.47, "timestamp": "00:32:20", "text": "誰かが私にこう尋ねたんです。"}, {"type": "subtitle", "time": 1942.47, "timestamp": "00:32:22", "text": "「なぜあなたのモデルには胸があるのですか？」"}, {"type": "subtitle", "time": 1944.63, "timestamp": "00:32:24", "text": "それで私は「なあ、もし私が行くなら"}, {"type": "subtitle", "time": 1946.87, "timestamp": "00:32:26", "text": "ここに座って誰かのふりをするなんて、私は"}, {"type": "subtitle", "time": 1949.19, "timestamp": "00:32:29", "text": "むしろ私が"}, {"type": "subtitle", "time": 1953.509, "timestamp": "00:32:33", "text": "「うん、そうするよ。アニメ大好きだから。」"}, {"type": "subtitle", "time": 1956.549, "timestamp": "00:32:36", "text": "女の子と私はアニメの女の子を見るのが好きです。"}, {"type": "subtitle", "time": 1970.07, "timestamp": "00:32:50", "text": "そして、似たようなものがたくさんあります"}, {"type": "subtitle", "time": 1973.11, "timestamp": "00:32:53", "text": "今オンラインで起こっていることは、"}, {"type": "subtitle", "time": 1975.35, "timestamp": "00:32:55", "text": "だから私がしたことはただ"}, {"type": "subtitle", "time": 1977.11, "timestamp": "00:32:57", "text": "何かが起こるたびに、私は自分の繭の中に入り込む"}, {"type": "subtitle", "time": 1979.59, "timestamp": "00:32:59", "text": "ドラマか何かが起こっている"}]
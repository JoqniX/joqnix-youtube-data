[{"type": "subtitle", "time": 14642.55, "timestamp": "04:04:02", "text": "あなたに意地悪をしていたんでしょう？"}, {"type": "subtitle", "time": 14645.67, "timestamp": "04:04:05", "text": "例えば、私があなたに「ジョー」と言ったとしましょう。"}, {"type": "subtitle", "time": 14647.229, "timestamp": "04:04:07", "text": "あなたは"}, {"type": "subtitle", "time": 14649.75, "timestamp": "04:04:09", "text": "ほとんど知らない、思いつかない"}, {"type": "subtitle", "time": 14652.63, "timestamp": "04:04:12", "text": "何でも。"}, {"type": "subtitle", "time": 14657.309, "timestamp": "04:04:17", "text": "あなたは最も臭いユーチューバーです。"}, {"type": "subtitle", "time": 14659.51, "timestamp": "04:04:19", "text": "右？ねえ、私は意地悪をしているわけじゃないんだけど"}, {"type": "subtitle", "time": 14663.11, "timestamp": "04:04:23", "text": "あなた、なぜなら私は、私たちはこの瞬間にいるからです。"}, {"type": "subtitle", "time": 14664.55, "timestamp": "04:04:24", "text": "右？そして私は"}, {"type": "subtitle", "time": 14667.51, "timestamp": "04:04:27", "text": "例。うん。つまり、流れに身を任せていたということだ。"}, {"type": "subtitle", "time": 14670.78, "timestamp": "04:04:30", "text": "うん。しかし、もしそれが台本通りだったとしたら、"}, {"type": "subtitle", "time": 14672.07, "timestamp": "04:04:32", "text": "[音楽]"}, {"type": "subtitle", "time": 14673.91, "timestamp": "04:04:33", "text": "脚本にそう書いておいた。私は"}, {"type": "subtitle", "time": 14675.59, "timestamp": "04:04:35", "text": "君を僕と呼ぶよ。あなたに電話します"}, {"type": "subtitle", "time": 14677.83, "timestamp": "04:04:37", "text": "ここは臭い。"}, {"type": "subtitle", "time": 14681.349, "timestamp": "04:04:41", "text": "すると、それはまるで"}, {"type": "subtitle", "time": 14687.229, "timestamp": "04:04:47", "text": "例えば、誰かがあなたに意地悪をしている場合"}, {"type": "subtitle", "time": 14690.15, "timestamp": "04:04:50", "text": "台本通りの理由で、そう感じない"}, {"type": "subtitle", "time": 14691.75, "timestamp": "04:04:51", "text": "そんな感じ。自分が何を言っているのか分からない、"}, {"type": "subtitle", "time": 14693.269, "timestamp": "04:04:53", "text": "でも、私が何を言っているか分かりますか？"}, {"type": "subtitle", "time": 14694.79, "timestamp": "04:04:54", "text": "コミュニケーションを取ろうとしているのですか？うん。うん。うん。"}, {"type": "subtitle", "time": 14697.349, "timestamp": "04:04:57", "text": "うん。うん。はい、理解しています。はい。"}]
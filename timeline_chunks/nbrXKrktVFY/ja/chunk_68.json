[{"type": "subtitle", "time": 4082.15, "timestamp": "01:08:02", "text": "何てことだ。うん。"}, {"type": "subtitle", "time": 4083.91, "timestamp": "01:08:03", "text": "エレンがそこに降り立つところを想像してみて。彼はこう言う、"}, {"type": "subtitle", "time": 4085.99, "timestamp": "01:08:05", "text": "「よし、いよいよ本番だ。」そして私は"}, {"type": "subtitle", "time": 4089.029, "timestamp": "01:08:09", "text": "「アレン、もしあなたが"}, {"type": "subtitle", "time": 4091.829, "timestamp": "01:08:11", "text": "この論文によれば、"}, {"type": "subtitle", "time": 4094.47, "timestamp": "01:08:14", "text": "惑星は私の下、私の物の下にあります。"}, {"type": "subtitle", "time": 4103.03, "timestamp": "01:08:23", "text": "「私だよ。」彼は「何だって？」"}, {"type": "subtitle", "time": 4106.149, "timestamp": "01:08:26", "text": "私たちは今ここに着いたところです。"}, {"type": "subtitle", "time": 4108.229, "timestamp": "01:08:28", "text": "私たちは現金を持っていきませんでした。私たちはしなければならない"}, {"type": "subtitle", "time": 4111.189, "timestamp": "01:08:31", "text": "地球へ戻る。"}, {"type": "subtitle", "time": 4113.07, "timestamp": "01:08:33", "text": "例えば、私が惑星のようになると想像してみてください"}, {"type": "subtitle", "time": 4115.749, "timestamp": "01:08:35", "text": "売り手。そして、遊びがあるならどうなるでしょうか"}, {"type": "subtitle", "time": 4118.229, "timestamp": "01:08:38", "text": "地球上の人々？私も販売しますか？"}, {"type": "subtitle", "time": 4124.07, "timestamp": "01:08:44", "text": "それは良い質問ですね。"}, {"type": "subtitle", "time": 4126.229, "timestamp": "01:08:46", "text": "まるで同じ惑星に住む宇宙人のように。"}, {"type": "subtitle", "time": 4127.709, "timestamp": "01:08:47", "text": "彼らはこう考えている、"}, {"type": "subtitle", "time": 4131.99, "timestamp": "01:08:51", "text": "「ふむ、なぜ私たちが所有されているのか不思議だ"}, {"type": "subtitle", "time": 4139.43, "timestamp": "01:08:59", "text": "わからない。ある男が私たちを"}]
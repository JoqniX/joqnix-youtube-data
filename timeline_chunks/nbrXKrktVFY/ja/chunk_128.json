[{"type": "subtitle", "time": 7682.47, "timestamp": "02:08:02", "text": "その通り。でも今は、今は「ああ、"}, {"type": "subtitle", "time": 7685.79, "timestamp": "02:08:05", "text": "たった100メートルです"}, {"type": "subtitle", "time": 7689.669, "timestamp": "02:08:09", "text": "Mbps。たった100Mbpsだよ。"}, {"type": "subtitle", "time": 7692.39, "timestamp": "02:08:12", "text": "待て、1GBにも満たない。"}, {"type": "subtitle", "time": 7695.43, "timestamp": "02:08:15", "text": "待って、今の計画はどんなものですか？"}, {"type": "subtitle", "time": 7699.55, "timestamp": "02:08:19", "text": "ええと、現在私は4つ持っています"}, {"type": "subtitle", "time": 7702.95, "timestamp": "02:08:22", "text": "41. 私は100のものを持っていたが、処分した"}, {"type": "subtitle", "time": 7705.43, "timestamp": "02:08:25", "text": "それ。でも今またそれを手に入れよう"}, {"type": "subtitle", "time": 7707.75, "timestamp": "02:08:27", "text": "もう一度、私は本当にそう思っていた"}, {"type": "subtitle", "time": 7711.35, "timestamp": "02:08:31", "text": "叔父が言ったので払い過ぎていた"}, {"type": "subtitle", "time": 7713.75, "timestamp": "02:08:33", "text": "なんでお前は俺に似てるんだよ"}, {"type": "subtitle", "time": 7716.229, "timestamp": "02:08:36", "text": "上位プランに加入しますか？そして私はこう思った。"}, {"type": "subtitle", "time": 7720.39, "timestamp": "02:08:40", "text": "私はよく色々なものをダウンロードするからです。"}, {"type": "subtitle", "time": 7724.149, "timestamp": "02:08:44", "text": "彼は「いや、40プランでいいよ」と言った。"}, {"type": "subtitle", "time": 7726.39, "timestamp": "02:08:46", "text": "だから、そうしたんです。そしてどうやら私はボトルネックを起こしたようだ"}, {"type": "subtitle", "time": 7739.669, "timestamp": "02:08:59", "text": "私はGioの最初のプランである30 MB1を持っています"}]
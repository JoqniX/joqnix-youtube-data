[{"type": "subtitle", "time": 5761.35, "timestamp": "01:36:01", "text": "水を取りに行くために毎回必ず行く。私"}, {"type": "subtitle", "time": 5765.27, "timestamp": "01:36:05", "text": "片道旅行をするだけでいいんです。"}, {"type": "subtitle", "time": 5767.669, "timestamp": "01:36:07", "text": "ティッシュもここにあります。だから、もし私が"}, {"type": "subtitle", "time": 5768.91, "timestamp": "01:36:08", "text": "散らかすか"}, {"type": "subtitle", "time": 5771.43, "timestamp": "01:36:11", "text": "何かあれば、私が片付けます。私はしません"}, {"type": "subtitle", "time": 5777.51, "timestamp": "01:36:17", "text": "組織。私もほとんどの人が"}, {"type": "subtitle", "time": 5779.43, "timestamp": "01:36:19", "text": "私が好きなもの、例えばタンパク質など"}, {"type": "subtitle", "time": 5781.11, "timestamp": "01:36:21", "text": "シェイクとプロテインパウダーと"}, {"type": "subtitle", "time": 5783.11, "timestamp": "01:36:23", "text": "ここにはそういう類のものがあります。"}, {"type": "subtitle", "time": 5786.47, "timestamp": "01:36:26", "text": "私の持ち物の中にもおやつが入っています"}, {"type": "subtitle", "time": 5789.27, "timestamp": "01:36:29", "text": "私の隣にはビスケットがいくつかあって"}, {"type": "subtitle", "time": 5793.189, "timestamp": "01:36:33", "text": "夜遅くにお腹が空いた時のために用意しておくもの。"}, {"type": "subtitle", "time": 5796.51, "timestamp": "01:36:36", "text": "私は基本的に小さな店を経営しています"}, {"type": "subtitle", "time": 5799.59, "timestamp": "01:36:39", "text": "ここ。妹が妹を一度見たとき"}, {"type": "subtitle", "time": 5801.83, "timestamp": "01:36:41", "text": "彼女には友達が何人かいて、彼らは私の"}, {"type": "subtitle", "time": 5804.35, "timestamp": "01:36:44", "text": "部屋で妹が言った、"}, {"type": "subtitle", "time": 5806.95, "timestamp": "01:36:46", "text": "「おや、オレンジさん、絆創膏持ってる？」"}, {"type": "subtitle", "time": 5808.95, "timestamp": "01:36:48", "text": "私は「ええ、そう思います」と答えます。そして彼女は"}, {"type": "subtitle", "time": 5810.79, "timestamp": "01:36:50", "text": "彼は私に別のことを頼んだ。私はこう思う、"}, {"type": "subtitle", "time": 5812.79, "timestamp": "01:36:52", "text": "「ええ、そうです。」そして彼女はこう尋ねた"}, {"type": "subtitle", "time": 5816.07, "timestamp": "01:36:56", "text": "えーと、カミソリのために。 「うん、私は"}, {"type": "subtitle", "time": 5818.27, "timestamp": "01:36:58", "text": "する。」そして彼女の友人は、"}]
[{"type": "subtitle", "time": 13925.349, "timestamp": "03:52:05", "text": "彼女を見ていて、"}, {"type": "subtitle", "time": 13927.51, "timestamp": "03:52:07", "text": "彼女がこんな風になるとは思いもよらなかった"}, {"type": "subtitle", "time": 13929.309, "timestamp": "03:52:09", "text": "巨大な"}, {"type": "subtitle", "time": 13932.07, "timestamp": "03:52:12", "text": "YouTuber。私は、私は、"}, {"type": "subtitle", "time": 13934.79, "timestamp": "03:52:14", "text": "彼女がHol Life出身だと知っていた。私は"}, {"type": "subtitle", "time": 13943.59, "timestamp": "03:52:23", "text": "GTA。私は彼女が言うように話す"}, {"type": "subtitle", "time": 13945.39, "timestamp": "03:52:25", "text": "興味深いことに。"}, {"type": "subtitle", "time": 13946.55, "timestamp": "03:52:26", "text": "[音楽]"}, {"type": "subtitle", "time": 13948.15, "timestamp": "03:52:28", "text": "JPにとっても同じ経験だ"}, {"type": "subtitle", "time": 13949.75, "timestamp": "03:52:29", "text": "人々も。彼らは「ああ、彼女は話す」と言う"}, {"type": "subtitle", "time": 13959.03, "timestamp": "03:52:39", "text": "ある男が言ったことを覚えているか。「私は"}, {"type": "subtitle", "time": 13961.59, "timestamp": "03:52:41", "text": "「日本語を学ぶために、Moさんの配信を見ている。」"}, {"type": "subtitle", "time": 13963.91, "timestamp": "03:52:43", "text": "JPの連中はみんな「なんでそんなことするんだ」って感じだった。"}, {"type": "subtitle", "time": 13965.95, "timestamp": "03:52:45", "text": "これ"}, {"type": "subtitle", "time": 13968.469, "timestamp": "03:52:48", "text": "あなた自身ですか？私たちは彼女のことを理解できない。なぜ"}, {"type": "subtitle", "time": 13969.99, "timestamp": "03:52:49", "text": "一体何を理解しようとしているんだ？"}, {"type": "subtitle", "time": 13972.71, "timestamp": "03:52:52", "text": "彼女？\""}]
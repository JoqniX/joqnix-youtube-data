[{"type": "subtitle", "time": 1860.87, "timestamp": "00:31:00", "text": "まるで私がそうではないかのように甲高い声だった"}, {"type": "subtitle", "time": 1864.669, "timestamp": "00:31:04", "text": "有糸分裂に行ったとか、あるいは、ええと、"}, {"type": "subtitle", "time": 1867.99, "timestamp": "00:31:07", "text": "思春期ですよね？それで、キーキー音がしたんです"}, {"type": "subtitle", "time": 1870.149, "timestamp": "00:31:10", "text": "子供の声。それで私は"}, {"type": "subtitle", "time": 1872.23, "timestamp": "00:31:12", "text": "まるでロリーの声みたいで、ほら、"}, {"type": "subtitle", "time": 1875.029, "timestamp": "00:31:15", "text": "こういう可愛いアニメの女の子の声が好きです。だから私は"}, {"type": "subtitle", "time": 1878.789, "timestamp": "00:31:18", "text": "オンラインで人を騙す詐欺を始めた。そして私の"}, {"type": "subtitle", "time": 1881.75, "timestamp": "00:31:21", "text": "問題は、私はいつもかわいいものが好きだったということ"}, {"type": "subtitle", "time": 1884.389, "timestamp": "00:31:24", "text": "もの。だから私は人々が"}, {"type": "subtitle", "time": 1888.23, "timestamp": "00:31:28", "text": "私が女性だと思っていた。だから私はただ好きなだけ"}, {"type": "subtitle", "time": 1890.149, "timestamp": "00:31:30", "text": "彼らに好きなことを言わせておけばいい。彼らは"}, {"type": "subtitle", "time": 1891.99, "timestamp": "00:31:31", "text": "私を女の子、男の子と呼んでほしい、"}, {"type": "subtitle", "time": 1893.83, "timestamp": "00:31:33", "text": "何でも。好きなように何でもする"}, {"type": "subtitle", "time": 1895.43, "timestamp": "00:31:35", "text": "のように。誰かが「"}, {"type": "subtitle", "time": 1898.23, "timestamp": "00:31:38", "text": "「お前は男か、それとも何だ？」私はこう思った。"}, {"type": "subtitle", "time": 1899.909, "timestamp": "00:31:39", "text": "思春期を迎えて、"}, {"type": "subtitle", "time": 1903.43, "timestamp": "00:31:43", "text": "私は女性です。うん。私はこう思う、それは"}, {"type": "subtitle", "time": 1904.87, "timestamp": "00:31:44", "text": "それをより良く表現する方法は、"}, {"type": "subtitle", "time": 1908.31, "timestamp": "00:31:48", "text": "可愛く着飾る。私は可愛いものが好きです。"}, {"type": "subtitle", "time": 1911.269, "timestamp": "00:31:51", "text": "そしてそれは、"}, {"type": "subtitle", "time": 1913.11, "timestamp": "00:31:53", "text": "女性のカテゴリー。だから、私はこう思った、"}, {"type": "subtitle", "time": 1914.91, "timestamp": "00:31:54", "text": "じゃあ、僕はファンボーイってことか。"}, {"type": "subtitle", "time": 1916.47, "timestamp": "00:31:56", "text": "[音楽]"}, {"type": "subtitle", "time": 1918.47, "timestamp": "00:31:58", "text": "私はもうファンボーイではない。物理的に"}]
[{"type": "subtitle", "time": 1141.59, "timestamp": "00:19:01", "text": "どういうわけか私の街はこう考えていた。"}, {"type": "subtitle", "time": 1143.35, "timestamp": "00:19:03", "text": "ねえ、今日はすごく暑いから"}, {"type": "subtitle", "time": 1145.669, "timestamp": "00:19:05", "text": "彼らは電気を必要としない。"}, {"type": "subtitle", "time": 1147.83, "timestamp": "00:19:07", "text": "いや、彼らには必要ないよ。彼らはそうしない"}, {"type": "subtitle", "time": 1150.07, "timestamp": "00:19:10", "text": "必要だ。"}, {"type": "subtitle", "time": 1153.59, "timestamp": "00:19:13", "text": "いや。ああ、なんてことだ。ただ、ただ、私は"}, {"type": "subtitle", "time": 1156.789, "timestamp": "00:19:16", "text": "知る。ちょうど寝たところです。私は"}, {"type": "subtitle", "time": 1159.19, "timestamp": "00:19:19", "text": "電気が復旧したら戻ってきます"}, {"type": "subtitle", "time": 1161.029, "timestamp": "00:19:21", "text": "が戻ってきた。そうでなければ、私は"}, {"type": "subtitle", "time": 1174.789, "timestamp": "00:19:34", "text": "心配ない。ゆっくりしてください。だった"}, {"type": "subtitle", "time": 1188.789, "timestamp": "00:19:48", "text": "さて、今日はどんな一日でしたか？"}, {"type": "subtitle", "time": 1190.63, "timestamp": "00:19:50", "text": "今日は誰も殺さなかったから、"}]
[{"type": "subtitle", "time": 2760.15, "timestamp": "00:46:00", "text": "それ。それから、別の出来事は"}, {"type": "subtitle", "time": 2763.75, "timestamp": "00:46:03", "text": "うーん、私は火遊びをしている。"}, {"type": "subtitle", "time": 2767.589, "timestamp": "00:46:07", "text": "ああ、つまりちょっとした放火事件だったんですね。"}, {"type": "subtitle", "time": 2771.03, "timestamp": "00:46:11", "text": "ええ、それはまるで"}, {"type": "subtitle", "time": 2775.27, "timestamp": "00:46:15", "text": "えっと、それで、えっと、ろうそくが灯されたので、"}, {"type": "subtitle", "time": 2776.79, "timestamp": "00:46:16", "text": "昔は指で遊ぶのが好きだった"}, {"type": "subtitle", "time": 2780.23, "timestamp": "00:46:20", "text": "そして、もし私が手に入れることができれば"}, {"type": "subtitle", "time": 2783.91, "timestamp": "00:46:23", "text": "火を消して、吹き飛ばさずに物を片付ける"}, {"type": "subtitle", "time": 2785.75, "timestamp": "00:46:25", "text": "指だけで、"}, {"type": "subtitle", "time": 2787.67, "timestamp": "00:46:27", "text": "じゃあ、指を置いて"}, {"type": "subtitle", "time": 2790.91, "timestamp": "00:46:30", "text": "2秒後に"}, {"type": "subtitle", "time": 2801.91, "timestamp": "00:46:41", "text": "うん。聖なる。"}, {"type": "subtitle", "time": 2803.99, "timestamp": "00:46:43", "text": "「あなたは独身ですか？」と聞いても大丈夫ですか？"}, {"type": "subtitle", "time": 2807.109, "timestamp": "00:46:47", "text": "子供？ええ、一人っ子です。うん。わかった。"}, {"type": "subtitle", "time": 2811.349, "timestamp": "00:46:51", "text": "つまり、私は家族の中で一番年上なんです。まるで私が"}, {"type": "subtitle", "time": 2813.99, "timestamp": "00:46:53", "text": "兄弟姉妹が4人いる。私は5人目です"}, {"type": "subtitle", "time": 2816.71, "timestamp": "00:46:56", "text": "そして最古のもの。"}, {"type": "subtitle", "time": 2819.829, "timestamp": "00:46:59", "text": "そして兄弟たちが何か正しいことをするたびに"}]
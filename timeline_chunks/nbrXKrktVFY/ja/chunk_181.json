[{"type": "subtitle", "time": 10861.59, "timestamp": "03:01:01", "text": "そして私はそれを言わない、まだ言っていない"}, {"type": "subtitle", "time": 10866.15, "timestamp": "03:01:06", "text": "それは単に友達がいて、"}, {"type": "subtitle", "time": 10868.79, "timestamp": "03:01:08", "text": "一度そう言ったら、オレンジ色だと言った"}, {"type": "subtitle", "time": 10871.67, "timestamp": "03:01:11", "text": "これは失礼で、"}, {"type": "subtitle", "time": 10873.269, "timestamp": "03:01:13", "text": "そして彼女は私にすべてを説明してくれた。彼女"}, {"type": "subtitle", "time": 10875.03, "timestamp": "03:01:15", "text": "彼女はとても親切で、私に尋ねました"}, {"type": "subtitle", "time": 10877.59, "timestamp": "03:01:17", "text": "言わないで、彼女のためだけに私は決して"}, {"type": "subtitle", "time": 10887.03, "timestamp": "03:01:27", "text": "そして、それが物事の本質です"}, {"type": "subtitle", "time": 10888.71, "timestamp": "03:01:28", "text": "人々がそれに対して親切で、"}, {"type": "subtitle", "time": 10890.15, "timestamp": "03:01:30", "text": "彼らは私が"}, {"type": "subtitle", "time": 10892.389, "timestamp": "03:01:32", "text": "わかった、私はあなたを尊敬します"}, {"type": "subtitle", "time": 10894.79, "timestamp": "03:01:34", "text": "文化とかそういうことはやらない"}, {"type": "subtitle", "time": 10897.269, "timestamp": "03:01:37", "text": "それ。しかし、Rワードに関しては人々は"}, {"type": "subtitle", "time": 10899.75, "timestamp": "03:01:39", "text": "例えば、Rワードを使うとこうなります"}, {"type": "subtitle", "time": 10902.15, "timestamp": "03:01:42", "text": "そして、それ。 「わかった、わかった、それはバカげてる」"}, {"type": "subtitle", "time": 10911.83, "timestamp": "03:01:51", "text": "ジョック、そこにいるの？うん。うん。うん。私は"}, {"type": "subtitle", "time": 10915.11, "timestamp": "03:01:55", "text": "考えてみるのと同じように。"}, {"type": "subtitle", "time": 10918.309, "timestamp": "03:01:58", "text": "使い方について考える"}]
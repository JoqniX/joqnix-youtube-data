[{"type": "subtitle", "time": 6601.03, "timestamp": "01:50:01", "text": "何てことだ。"}, {"type": "subtitle", "time": 6602.55, "timestamp": "01:50:02", "text": "彼女は、彼らが着るならいいよ、と言ったから"}, {"type": "subtitle", "time": 6605.189, "timestamp": "01:50:05", "text": "ズボンを履く場合、どのように履くのでしょうか？そして"}, {"type": "subtitle", "time": 6607.03, "timestamp": "01:50:07", "text": "スカートを履くと、"}, {"type": "subtitle", "time": 6609.83, "timestamp": "01:50:09", "text": "スカートがずり落ちない？"}, {"type": "subtitle", "time": 6612.109, "timestamp": "01:50:12", "text": "そして私は答えられなかった"}, {"type": "subtitle", "time": 6614.39, "timestamp": "01:50:14", "text": "それ。それは良い質問ですね。"}, {"type": "subtitle", "time": 6619.189, "timestamp": "01:50:19", "text": "彼らが何をしているのか、何を着ているのか、私にはわかりません。"}, {"type": "subtitle", "time": 6626.07, "timestamp": "01:50:26", "text": "[音楽]"}, {"type": "subtitle", "time": 6630.149, "timestamp": "01:50:30", "text": "彼らは服装の面で好きでなければならない"}, {"type": "subtitle", "time": 6632.31, "timestamp": "01:50:32", "text": "上半身を覆うが下半身は"}, {"type": "subtitle", "time": 6634.709, "timestamp": "01:50:34", "text": "その部分はもっと柔軟でなければならない、"}, {"type": "subtitle", "time": 6636.95, "timestamp": "01:50:36", "text": "尻尾全体がそうである必要はない"}, {"type": "subtitle", "time": 6640.709, "timestamp": "01:50:40", "text": "酒会ではこのように覆われる"}, {"type": "subtitle", "time": 6642.87, "timestamp": "01:50:42", "text": "服を着ているなら、彼らは行くのだろうか"}, {"type": "subtitle", "time": 6646.43, "timestamp": "01:50:46", "text": "重要な部分を覆い隠すために"}, {"type": "subtitle", "time": 6650.629, "timestamp": "01:50:50", "text": "基本的に性器を好きになるか、または性器を好きになる"}, {"type": "subtitle", "time": 6651.99, "timestamp": "01:50:51", "text": "彼らはただ隠蔽するつもりなのか"}, {"type": "subtitle", "time": 6653.51, "timestamp": "01:50:53", "text": "性器または全体を着る"}, {"type": "subtitle", "time": 6655.669, "timestamp": "01:50:55", "text": "なぜなら、いくつかの文化では"}, {"type": "subtitle", "time": 6658.55, "timestamp": "01:50:58", "text": "イスラム文化のように女性が着るもの"}, {"type": "subtitle", "time": 6659.99, "timestamp": "01:50:59", "text": "全ては彼らが持っているから"}]
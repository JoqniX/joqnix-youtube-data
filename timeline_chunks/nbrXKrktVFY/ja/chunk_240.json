[{"type": "subtitle", "time": 14400.239, "timestamp": "04:00:00", "text": "4chan、コメントがすごかった 残酷だ。"}, {"type": "subtitle", "time": 14407.189, "timestamp": "04:00:07", "text": "人々は意地悪だと思っていたけど、"}, {"type": "subtitle", "time": 14411.269, "timestamp": "04:00:11", "text": "世の中にはインド人を嫌う人が大勢いる。"}, {"type": "subtitle", "time": 14418.469, "timestamp": "04:00:18", "text": "だから、私もそれなりに"}, {"type": "subtitle", "time": 14423.67, "timestamp": "04:00:23", "text": "4chanからの情報もどう思いますか？"}, {"type": "subtitle", "time": 14425.349, "timestamp": "04:00:25", "text": "うん。"}, {"type": "subtitle", "time": 14427.59, "timestamp": "04:00:27", "text": "でも私は彼らを"}, {"type": "subtitle", "time": 14430.389, "timestamp": "04:00:30", "text": "彼らが、つまり彼らが、という意味であるように"}, {"type": "subtitle", "time": 14431.75, "timestamp": "04:00:31", "text": "彼らが言っているようなこと"}, {"type": "subtitle", "time": 14433.269, "timestamp": "04:00:33", "text": "彼らが知っているように、"}, {"type": "subtitle", "time": 14438.15, "timestamp": "04:00:38", "text": "まるでいじめっ子があなたをいじめようとしているようなものだ"}, {"type": "subtitle", "time": 14439.83, "timestamp": "04:00:39", "text": "そして、もしあなたが行動を起こさなければ"}, {"type": "subtitle", "time": 14442.229, "timestamp": "04:00:42", "text": "まるで彼が力を持っているかのように"}, {"type": "subtitle", "time": 14450.99, "timestamp": "04:00:50", "text": "まるで私はそうじゃない"}, {"type": "subtitle", "time": 14453.75, "timestamp": "04:00:53", "text": "知る。どこがどこなのか分からない"}, {"type": "subtitle", "time": 14455.83, "timestamp": "04:00:55", "text": "読んだかどうかは覚えていないが、どこかで読んだところによると"}, {"type": "subtitle", "time": 14458.15, "timestamp": "04:00:58", "text": "えっと、人々は、"}]
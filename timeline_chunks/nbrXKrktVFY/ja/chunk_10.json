[{"type": "subtitle", "time": 600.19, "timestamp": "00:10:00", "text": "チャット。えーと、マルチウォッチ"}, {"type": "chat", "time": 601.468, "timestamp": "00:10:01", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "multiwatch link for the collab~ https://onxa.link/s17w2gI7"}, {"type": "subtitle", "time": 602.19, "timestamp": "00:10:02", "text": "リンク先"}, {"type": "subtitle", "time": 603.87, "timestamp": "00:10:03", "text": "[音楽]"}, {"type": "subtitle", "time": 606.67, "timestamp": "00:10:06", "text": "コラボレーション。はい、どうぞ"}, {"type": "subtitle", "time": 609.91, "timestamp": "00:10:09", "text": "行く。それをクリックしてください。それはホレックスを開くでしょう。"}, {"type": "subtitle", "time": 613.11, "timestamp": "00:10:13", "text": "現在のレイアウトを上書きするには、クリックしてください。"}, {"type": "subtitle", "time": 615.99, "timestamp": "00:10:15", "text": "以前にもやったことがある。確認ボタンをクリックしてください。"}, {"type": "subtitle", "time": 620.43, "timestamp": "00:10:20", "text": "両方とも見ることができるでしょう"}, {"type": "subtitle", "time": 624.55, "timestamp": "00:10:24", "text": "私の両側を見ることができるでしょう"}, {"type": "subtitle", "time": 626.87, "timestamp": "00:10:26", "text": "fe ストリームと彼の側"}, {"type": "subtitle", "time": 629.829, "timestamp": "00:10:29", "text": "ストリーム。左側が私のチャットです。権利は彼にある"}, {"type": "subtitle", "time": 632.71, "timestamp": "00:10:32", "text": "チャット。ログインするだけでコミュニケーションが取れます"}, {"type": "subtitle", "time": 635.269, "timestamp": "00:10:35", "text": "YouTubeへ。コミュニケーションをとることができます"}, {"type": "subtitle", "time": 637.59, "timestamp": "00:10:37", "text": "両方のチャット。一緒に観よう。楽しむ。"}, {"type": "subtitle", "time": 639.91, "timestamp": "00:10:39", "text": "楽しむ。両方の配信者を応援しよう"}, {"type": "subtitle", "time": 653.71, "timestamp": "00:10:53", "text": "えっと、"}, {"type": "subtitle", "time": 656.87, "timestamp": "00:10:56", "text": "そして、私ができるかどうかもう一度確認したいのです"}, {"type": "subtitle", "time": 659.43, "timestamp": "00:10:59", "text": "ビリービリーではまだストリーミング配信されています。私はしません"}]
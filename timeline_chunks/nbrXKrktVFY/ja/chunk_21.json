[{"type": "subtitle", "time": 1262.07, "timestamp": "00:21:02", "text": "本当に興味深い考えです"}, {"type": "subtitle", "time": 1264.87, "timestamp": "00:21:04", "text": "聞く用意がある。」5日後、"}, {"type": "subtitle", "time": 1266.11, "timestamp": "00:21:06", "text": "彼らは去ってしまった。私はこう思う、"}, {"type": "subtitle", "time": 1269.669, "timestamp": "00:21:09", "text": "「え？どこへ行くの？行かないで」"}, {"type": "subtitle", "time": 1280.87, "timestamp": "00:21:20", "text": "もしかしたら新しい"}, {"type": "subtitle", "time": 1282.71, "timestamp": "00:21:22", "text": "人。それが私の願いです。それが"}, {"type": "subtitle", "time": 1286.549, "timestamp": "00:21:26", "text": "願っています。新たな転生。"}, {"type": "subtitle", "time": 1289.35, "timestamp": "00:21:29", "text": "ピッパは新しいインディーズとして登場したわけではない"}, {"type": "subtitle", "time": 1292.95, "timestamp": "00:21:32", "text": "まだ。私は今でも彼女のことを悲しく思っています。あなたが知っている"}, {"type": "subtitle", "time": 1297.59, "timestamp": "00:21:37", "text": "ピッパ？えっと、青いピッパ？"}, {"type": "subtitle", "time": 1301.51, "timestamp": "00:21:41", "text": "ブルーペッパ。 Face Connectのピッパさん。いいえ、"}, {"type": "subtitle", "time": 1304.39, "timestamp": "00:21:44", "text": "もう一人のピッパのことではない。"}, {"type": "subtitle", "time": 1306.149, "timestamp": "00:21:46", "text": "もう一人のピッパはそこにいる。そこには"}, {"type": "subtitle", "time": 1308.23, "timestamp": "00:21:48", "text": "もう一人のイギリス人ピッパ。"}, {"type": "subtitle", "time": 1310.87, "timestamp": "00:21:50", "text": "私はそう見られていたのだと思います。つまり、私は"}]
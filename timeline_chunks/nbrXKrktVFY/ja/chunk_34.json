[{"type": "subtitle", "time": 2041.11, "timestamp": "00:34:01", "text": "ええ、このサバトンはむしろ"}, {"type": "subtitle", "time": 2043.83, "timestamp": "00:34:03", "text": "えっと、どちらかというと最後のお別れですね。ない"}, {"type": "subtitle", "time": 2046.23, "timestamp": "00:34:06", "text": "最後のお別れ。いいえ、でもあなたは"}, {"type": "subtitle", "time": 2048.389, "timestamp": "00:34:08", "text": "死にかけている。"}, {"type": "subtitle", "time": 2050.629, "timestamp": "00:34:10", "text": "もう二度と私を置いていかないで。"}, {"type": "subtitle", "time": 2053.99, "timestamp": "00:34:13", "text": "いや、いや、いや。えっと、私にはできないから"}, {"type": "subtitle", "time": 2057.109, "timestamp": "00:34:17", "text": "自分は日本から配信するつもりだ。いいえ、"}, {"type": "subtitle", "time": 2059.909, "timestamp": "00:34:19", "text": "私は知らない人のために"}, {"type": "subtitle", "time": 2064.31, "timestamp": "00:34:24", "text": "私は7月に日本に行きます。えっと、"}, {"type": "subtitle", "time": 2066.869, "timestamp": "00:34:26", "text": "私はそこに2、3年滞在する予定です"}, {"type": "subtitle", "time": 2069.589, "timestamp": "00:34:29", "text": "勉強やその他あらゆることのために。そうですね、"}, {"type": "subtitle", "time": 2072.79, "timestamp": "00:34:32", "text": "できるかどうかわかりませんが"}, {"type": "subtitle", "time": 2075.51, "timestamp": "00:34:35", "text": "ストリーム配信が好きなので、しばらく時間がかかります"}, {"type": "subtitle", "time": 2079.03, "timestamp": "00:34:39", "text": "そのような代替手段を取得するには、"}, {"type": "subtitle", "time": 2081.03, "timestamp": "00:34:41", "text": "ストリームから好きになるのはほぼ不可能"}, {"type": "subtitle", "time": 2083.75, "timestamp": "00:34:43", "text": "ノイズのせいでドメトリが"}, {"type": "subtitle", "time": 2085.669, "timestamp": "00:34:45", "text": "苦情。騒音苦情を受けるだろう"}, {"type": "subtitle", "time": 2090.51, "timestamp": "00:34:50", "text": "多く。うん。だからおそらく私は思う"}, {"type": "subtitle", "time": 2094.79, "timestamp": "00:34:54", "text": "場所を見つけた後、えっと、"}, {"type": "subtitle", "time": 2098.23, "timestamp": "00:34:58", "text": "場所、つまり私が借りられる場所"}]
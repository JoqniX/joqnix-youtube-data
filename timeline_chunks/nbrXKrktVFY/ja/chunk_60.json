[{"type": "subtitle", "time": 3600.71, "timestamp": "01:00:00", "text": "えっと、"}, {"type": "subtitle", "time": 3602.549, "timestamp": "01:00:02", "text": "世の中はめちゃくちゃだよ、ジョック。"}, {"type": "subtitle", "time": 3610.63, "timestamp": "01:00:10", "text": "ああ、最近これを見つけたんだ"}, {"type": "subtitle", "time": 3613.43, "timestamp": "01:00:13", "text": "興味深い質問ですね。えーと、この質問は"}, {"type": "subtitle", "time": 3618.109, "timestamp": "01:00:18", "text": "そして、それは私に多くのことを考えさせるきっかけとなった。"}, {"type": "subtitle", "time": 3620.829, "timestamp": "01:00:20", "text": "それでは最初の質問です"}, {"type": "subtitle", "time": 3623.91, "timestamp": "01:00:23", "text": "そこに要件がなかった場合"}, {"type": "subtitle", "time": 3627.309, "timestamp": "01:00:27", "text": "えっと、なんて言うんだっけ"}, {"type": "subtitle", "time": 3630.39, "timestamp": "01:00:30", "text": "それ？えっと、できないものって何？"}, {"type": "subtitle", "time": 3634.39, "timestamp": "01:00:34", "text": "こんなことをしたら刑務所行きだ。わかった。あなたも"}, {"type": "subtitle", "time": 3636.589, "timestamp": "01:00:36", "text": "何でも売れる。もしあなたが"}, {"type": "subtitle", "time": 3639.829, "timestamp": "01:00:39", "text": "商人さん、あなたなら何を売りますか？ない"}, {"type": "subtitle", "time": 3642.63, "timestamp": "01:00:42", "text": "想像力の範囲内では、"}, {"type": "subtitle", "time": 3645.19, "timestamp": "01:00:45", "text": "行けるよ。"}, {"type": "subtitle", "time": 3647.51, "timestamp": "01:00:47", "text": "商人として何を売りますか、それとも"}, {"type": "subtitle", "time": 3654.95, "timestamp": "01:00:54", "text": "そして、私も犯罪者ですよね？いいえ、あなた"}, {"type": "subtitle", "time": 3657.109, "timestamp": "01:00:57", "text": "できた。誰もあなたを犯罪者とは呼ばないでしょう。"}]
[{"type": "subtitle", "time": 9242.19, "timestamp": "02:34:02", "text": "\"はぁ？\"私はこう思った"}, {"type": "subtitle", "time": 9244.95, "timestamp": "02:34:04", "text": "もし私が"}, {"type": "subtitle", "time": 9246.19, "timestamp": "02:34:06", "text": "あなたが言った通りです。"}, {"type": "subtitle", "time": 9248.95, "timestamp": "02:34:08", "text": "いいえ。なぜNワードはそんなに悪い言葉なのですか？何"}, {"type": "subtitle", "time": 9251.83, "timestamp": "02:34:11", "text": "もし私がそうしたらどうなるでしょうか？したい"}, {"type": "subtitle", "time": 9256.63, "timestamp": "02:34:16", "text": "ジョックみたいに、Nワードは悪いって知ってるよ"}, {"type": "subtitle", "time": 9259.83, "timestamp": "02:34:19", "text": "歴史的な意味合いがあるため"}, {"type": "subtitle", "time": 9262.389, "timestamp": "02:34:22", "text": "正しい"}, {"type": "subtitle", "time": 9266.07, "timestamp": "02:34:26", "text": "あなたは「nワード」の背後にある歴史を知っていますか？"}, {"type": "subtitle", "time": 9269.95, "timestamp": "02:34:29", "text": "あまりないと思いますが、"}, {"type": "subtitle", "time": 9272.87, "timestamp": "02:34:32", "text": "えっと、どの国だったか忘れたけど、"}, {"type": "subtitle", "time": 9276.23, "timestamp": "02:34:36", "text": "奴隷制度の話、そう、アメリカの奴隷制度の話"}, {"type": "subtitle", "time": 9280.23, "timestamp": "02:34:40", "text": "黒人と一緒に、そう、だから"}, {"type": "subtitle", "time": 9282.87, "timestamp": "02:34:42", "text": "nワードは奴隷を指すのに使われた。"}, {"type": "subtitle", "time": 9284.02, "timestamp": "02:34:44", "text": "右？"}, {"type": "subtitle", "time": 9286.67, "timestamp": "02:34:46", "text": "[音楽]"}, {"type": "subtitle", "time": 9290.469, "timestamp": "02:34:50", "text": "そして歴史は、多くの"}, {"type": "subtitle", "time": 9293.91, "timestamp": "02:34:53", "text": "長年抑圧されてきた人々は"}, {"type": "subtitle", "time": 9296.59, "timestamp": "02:34:56", "text": "その言葉は使い始めた"}]
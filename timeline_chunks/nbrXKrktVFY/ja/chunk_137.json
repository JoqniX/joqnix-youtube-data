[{"type": "subtitle", "time": 8221.03, "timestamp": "02:17:01", "text": "別のDiscordサーバー"}, {"type": "subtitle", "time": 8225.95, "timestamp": "02:17:05", "text": "アカウント。ああ、私は人々に尋ね始めます"}, {"type": "subtitle", "time": 8229.589, "timestamp": "02:17:09", "text": "「うちの犬が逃げちゃった」みたいなこと。何"}, {"type": "subtitle", "time": 8231.629, "timestamp": "02:17:11", "text": "私はすべきでしょうか"}, {"type": "subtitle", "time": 8234.629, "timestamp": "02:17:14", "text": "みんなもそう思う？津波が来ています"}, {"type": "subtitle", "time": 8238.469, "timestamp": "02:17:18", "text": "続いている。私はすべきでしょうか"}, {"type": "subtitle", "time": 8240.15, "timestamp": "02:17:20", "text": "水泳を習い始めるとか？"}, {"type": "subtitle", "time": 8241.85, "timestamp": "02:17:21", "text": "何が"}, {"type": "subtitle", "time": 8243.469, "timestamp": "02:17:23", "text": "[音楽]"}, {"type": "subtitle", "time": 8246.75, "timestamp": "02:17:26", "text": "最近のように上がって"}, {"type": "subtitle", "time": 8249.669, "timestamp": "02:17:29", "text": "何かが起こっていたので"}, {"type": "subtitle", "time": 8251.27, "timestamp": "02:17:31", "text": "インドとパキスタンのように"}, {"type": "subtitle", "time": 8253.75, "timestamp": "02:17:33", "text": "何かが起こった"}, {"type": "subtitle", "time": 8258.23, "timestamp": "02:17:38", "text": "そして、サーバーに人がいた"}, {"type": "subtitle", "time": 8259.99, "timestamp": "02:17:39", "text": "ロールプレイングをしていた"}, {"type": "subtitle", "time": 8263.91, "timestamp": "02:17:43", "text": "パキスタン人男性、なんてこった、一体何なんだ"}, {"type": "subtitle", "time": 8266.87, "timestamp": "02:17:46", "text": "すごく面白かったよ、みんな「ああ、私の"}, {"type": "subtitle", "time": 8269.27, "timestamp": "02:17:49", "text": "インド人のガールフレンドは私にはできない"}, {"type": "subtitle", "time": 8271.429, "timestamp": "02:17:51", "text": "彼女に会ってください。"}, {"type": "subtitle", "time": 8274.709, "timestamp": "02:17:54", "text": "何てことだ。彼は「人は人だ」と言っている"}, {"type": "subtitle", "time": 8277.509, "timestamp": "02:17:57", "text": "インドにいるなら、聞いてください"}]
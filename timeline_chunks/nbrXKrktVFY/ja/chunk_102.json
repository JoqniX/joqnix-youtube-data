[{"type": "subtitle", "time": 6131.99, "timestamp": "01:42:11", "text": "うん、おしゃべりするのは構わないよ。楽しい。うん。私"}, {"type": "subtitle", "time": 6135.91, "timestamp": "01:42:15", "text": "つまり、私はここでほとんど喋り続けていたということです。"}, {"type": "subtitle", "time": 6139.91, "timestamp": "01:42:19", "text": "おしゃべりするのが好きですか？"}, {"type": "subtitle", "time": 6142.149, "timestamp": "01:42:22", "text": "あなたは、話しかける人が好きですか？"}, {"type": "subtitle", "time": 6145.109, "timestamp": "01:42:25", "text": "寝る前に"}, {"type": "subtitle", "time": 6147.109, "timestamp": "01:42:27", "text": "まるでパソコンに「おやすみ」と言うように"}, {"type": "subtitle", "time": 6150.149, "timestamp": "01:42:30", "text": "コンピューター、すべて、私が話すものすべて"}, {"type": "subtitle", "time": 6152.95, "timestamp": "01:42:32", "text": "自分自身"}, {"type": "subtitle", "time": 6156.07, "timestamp": "01:42:36", "text": "一度は冗談のように聞こえる"}, {"type": "subtitle", "time": 6158.95, "timestamp": "01:42:38", "text": "私は緊張病ですが、それでも一度私は"}, {"type": "subtitle", "time": 6162.189, "timestamp": "01:42:42", "text": "PCで編集中"}, {"type": "subtitle", "time": 6164.31, "timestamp": "01:42:44", "text": "そしてそれは"}, {"type": "subtitle", "time": 6165.91, "timestamp": "01:42:45", "text": "理由はわからないけど、"}, {"type": "subtitle", "time": 6168.79, "timestamp": "01:42:48", "text": "バスルームがあり、外には椅子があった"}, {"type": "subtitle", "time": 6170.55, "timestamp": "01:42:50", "text": "私のバスルームの。だから私は「ああ、何だって」と思った"}, {"type": "subtitle", "time": 6172.709, "timestamp": "01:42:52", "text": "「この椅子は何でここにあるんだ？」だから、"}, {"type": "subtitle", "time": 6174.31, "timestamp": "01:42:54", "text": "私はそれを拾って自分の"}, {"type": "subtitle", "time": 6177.669, "timestamp": "01:42:57", "text": "部屋に入れて、椅子の横に置いた。そして"}]
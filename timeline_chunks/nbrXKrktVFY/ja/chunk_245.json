[{"type": "subtitle", "time": 14700.15, "timestamp": "04:05:00", "text": "それで、彼が"}, {"type": "subtitle", "time": 14702.269, "timestamp": "04:05:02", "text": "人をからかう"}, {"type": "subtitle", "time": 14705.03, "timestamp": "04:05:05", "text": "例えば、彼らのために脚本を書くときなど。"}, {"type": "subtitle", "time": 14713.83, "timestamp": "04:05:13", "text": "まるでライブ配信の台本を作っているようなものだ"}, {"type": "subtitle", "time": 14717.189, "timestamp": "04:05:17", "text": "あるいは、そんな感じ。うん。スクリプトを使ったゲームプレイ"}, {"type": "subtitle", "time": 14719.429, "timestamp": "04:05:19", "text": "例えば"}, {"type": "subtitle", "time": 14720.95, "timestamp": "04:05:20", "text": "ゲームをプレイして、それから"}, {"type": "subtitle", "time": 14723.83, "timestamp": "04:05:23", "text": "よし、ゲームをプレイしたぞ、そして今私は"}, {"type": "subtitle", "time": 14726.229, "timestamp": "04:05:26", "text": "私がどのように"}, {"type": "subtitle", "time": 14734.63, "timestamp": "04:05:34", "text": "スクリプト スクリプト化された反応 それは少し"}, {"type": "subtitle", "time": 14737.469, "timestamp": "04:05:37", "text": "より良い言い方を考えよう"}, {"type": "subtitle", "time": 14740.15, "timestamp": "04:05:40", "text": "彼が作ったときのように、以前のように"}, {"type": "subtitle", "time": 14742.63, "timestamp": "04:05:42", "text": "彼が誰かについて知ることになる動画"}, {"type": "subtitle", "time": 14744.63, "timestamp": "04:05:44", "text": "そしてそれらについて話し始め、"}, {"type": "subtitle", "time": 14745.91, "timestamp": "04:05:45", "text": "それから"}, {"type": "subtitle", "time": 14747.59, "timestamp": "04:05:47", "text": "彼らに対する彼の気持ちを説明する、"}, {"type": "subtitle", "time": 14749.67, "timestamp": "04:05:49", "text": "右？"}, {"type": "subtitle", "time": 14751.189, "timestamp": "04:05:51", "text": "スクリプトのような要素がいくつかありました"}, {"type": "subtitle", "time": 14754.469, "timestamp": "04:05:54", "text": "それだけど、それほど多くはない。しかしその後"}, {"type": "subtitle", "time": 14755.8, "timestamp": "04:05:55", "text": "彼はそれにのめり込みすぎた、"}]
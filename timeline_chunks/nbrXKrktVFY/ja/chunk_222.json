[{"type": "subtitle", "time": 13327.469, "timestamp": "03:42:07", "text": "私が見たものは"}, {"type": "subtitle", "time": 13330.03, "timestamp": "03:42:10", "text": "えっと、彼らはそれをできたかもしれない"}, {"type": "subtitle", "time": 13334.229, "timestamp": "03:42:14", "text": "ピーターが"}, {"type": "subtitle", "time": 13336.71, "timestamp": "03:42:16", "text": "インドのウイングは過小評価されている"}, {"type": "subtitle", "time": 13339.19, "timestamp": "03:42:19", "text": "なぜなら、"}, {"type": "subtitle", "time": 13342.71, "timestamp": "03:42:22", "text": "適切な企業は1社のみで、企業は2社ある。"}, {"type": "subtitle", "time": 13345.99, "timestamp": "03:42:25", "text": "彼らは自分たちのルールを作ろうとするが"}, {"type": "subtitle", "time": 13346.83, "timestamp": "03:42:26", "text": "しない"}, {"type": "subtitle", "time": 13351.03, "timestamp": "03:42:31", "text": "適切なチケットのようにきちんと収まる"}, {"type": "subtitle", "time": 13355.75, "timestamp": "03:42:35", "text": "いいえ、あの会社です。いいえ。ええ。うん。私が"}, {"type": "subtitle", "time": 13357.91, "timestamp": "03:42:37", "text": "ホリデーライフにはルールがあるのは、"}, {"type": "subtitle", "time": 13361.429, "timestamp": "03:42:41", "text": "起こった。うん。彼らが持っていたからではなく"}, {"type": "subtitle", "time": 13363.229, "timestamp": "03:42:43", "text": "最初からのルール。唯一のルール"}, {"type": "subtitle", "time": 13366.63, "timestamp": "03:42:46", "text": "楽しかった。"}, {"type": "subtitle", "time": 13369.03, "timestamp": "03:42:49", "text": "そして人々は楽しみ始め、"}, {"type": "subtitle", "time": 13370.389, "timestamp": "03:42:50", "text": "何かをして、彼らは「わかった、"}, {"type": "subtitle", "time": 13372.229, "timestamp": "03:42:52", "text": "どうでも。"}, {"type": "subtitle", "time": 13379.11, "timestamp": "03:42:59", "text": "うん。えっと、"}]
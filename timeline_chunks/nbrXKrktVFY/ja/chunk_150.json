[{"type": "subtitle", "time": 9000.23, "timestamp": "02:30:00", "text": "そして、"}, {"type": "subtitle", "time": 9001.59, "timestamp": "02:30:01", "text": "コミュニティだが、彼らはそれを"}, {"type": "subtitle", "time": 9003.11, "timestamp": "02:30:03", "text": "コミュニティの外。だから彼らは"}, {"type": "subtitle", "time": 9006.15, "timestamp": "02:30:06", "text": "ファンを代表するため。うん。だからそれは"}, {"type": "subtitle", "time": 9014.11, "timestamp": "02:30:14", "text": "右？まるで私が好きみたいに"}, {"type": "subtitle", "time": 9018.83, "timestamp": "02:30:18", "text": "アスミンがこれについて話しているのを見た"}, {"type": "subtitle", "time": 9023.429, "timestamp": "02:30:23", "text": "ええ、何人かの人はそうですね。やり方がわからない"}, {"type": "subtitle", "time": 9025.75, "timestamp": "02:30:25", "text": "聴衆をうまく扱う。"}, {"type": "subtitle", "time": 9027.75, "timestamp": "02:30:27", "text": "真実。"}, {"type": "subtitle", "time": 9030.55, "timestamp": "02:30:30", "text": "彼らはこう言うだろう「ああ、私の観客は"}, {"type": "subtitle", "time": 9035.51, "timestamp": "02:30:35", "text": "こうあるべきだから、あなたもそう振る舞うべきだ。"}, {"type": "subtitle", "time": 9038.389, "timestamp": "02:30:38", "text": "おっと、誰かが購読登録したみたいだ。"}, {"type": "subtitle", "time": 9043.19, "timestamp": "02:30:43", "text": "襲撃してくれてありがとう。えっと、ジャスミン、"}, {"type": "subtitle", "time": 9045.99, "timestamp": "02:30:45", "text": "ありがとう。ありがとう、レイジ。ありがとう、"}, {"type": "subtitle", "time": 9054.91, "timestamp": "02:30:54", "text": "うん、Twitchで感謝したよ"}, {"type": "subtitle", "time": 9058.15, "timestamp": "02:30:58", "text": "あれ。えっと、私はTwitchで配信はしていません。"}, {"type": "subtitle", "time": 9059.67, "timestamp": "02:30:59", "text": "だから私は「え？なんで？」って思ったんだ"}]
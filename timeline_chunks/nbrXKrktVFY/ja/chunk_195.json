[{"type": "subtitle", "time": 11701.75, "timestamp": "03:15:01", "text": "時々、ほら、"}, {"type": "subtitle", "time": 11704.389, "timestamp": "03:15:04", "text": "YouTubeが毎年やっていること、"}, {"type": "subtitle", "time": 11707.75, "timestamp": "03:15:07", "text": "YouTube Musicはそうしています。確認してみます。"}, {"type": "subtitle", "time": 11710.389, "timestamp": "03:15:10", "text": "なぜNiがそこにいるのか？私は聞いていたか"}, {"type": "subtitle", "time": 11712.67, "timestamp": "03:15:12", "text": "そこまで？"}, {"type": "subtitle", "time": 11716.469, "timestamp": "03:15:16", "text": "うん。うん。うん。ヌメイのように"}, {"type": "subtitle", "time": 11718.55, "timestamp": "03:15:18", "text": "いつもそこにいて、ホリデーライフが好きな人もいる"}, {"type": "subtitle", "time": 11721.83, "timestamp": "03:15:21", "text": "いろいろなものがそこにあるでしょう。"}, {"type": "subtitle", "time": 11723.349, "timestamp": "03:15:23", "text": "なんてこった。私は"}, {"type": "subtitle", "time": 11726.309, "timestamp": "03:15:26", "text": "YouTuberが多すぎる。"}, {"type": "subtitle", "time": 11728.469, "timestamp": "03:15:28", "text": "とにかく、それで、このクリッパーが"}, {"type": "subtitle", "time": 11732.389, "timestamp": "03:15:32", "text": "それはまるで彼女の発言を文脈から切り離して切り取ったようなものだった。"}, {"type": "subtitle", "time": 11733.91, "timestamp": "03:15:33", "text": "文脈を無視したわけでもない。彼はただ"}, {"type": "subtitle", "time": 11736.309, "timestamp": "03:15:36", "text": "クリックベイト。彼はスーパーみたいになるだろう"}, {"type": "subtitle", "time": 11739.91, "timestamp": "03:15:39", "text": "性的に、そして彼女をクリップするのが好き"}, {"type": "subtitle", "time": 11744.07, "timestamp": "03:15:44", "text": "性的に表現しすぎるのが好き"}, {"type": "subtitle", "time": 11745.67, "timestamp": "03:15:45", "text": "彼女は意図していなくても"}, {"type": "subtitle", "time": 11753.83, "timestamp": "03:15:53", "text": "そして彼はこれを続け、"}, {"type": "subtitle", "time": 11755.59, "timestamp": "03:15:55", "text": "ヌメイは、この男は"}, {"type": "subtitle", "time": 11757.03, "timestamp": "03:15:57", "text": "彼女は出てこなければならなかったみたいで、"}, {"type": "subtitle", "time": 11759.429, "timestamp": "03:15:59", "text": "「この人はこうしている」と言えばいい"}]
[{"type": "subtitle", "time": 7743.109, "timestamp": "02:09:03", "text": "これまで。それもいいですね。私の私の"}, {"type": "subtitle", "time": 7745.35, "timestamp": "02:09:05", "text": "アーティストのフォックス、"}, {"type": "subtitle", "time": 7753.83, "timestamp": "02:09:13", "text": "彼女によると、それはうまく機能しているようです。"}, {"type": "subtitle", "time": 7757.189, "timestamp": "02:09:17", "text": "でも彼女が私に物を渡さなければならないとき"}, {"type": "subtitle", "time": 7759.75, "timestamp": "02:09:19", "text": "ファイルとかそういうもの、"}, {"type": "subtitle", "time": 7762.31, "timestamp": "02:09:22", "text": "面倒くさい。ええ、待たなければなりません"}, {"type": "subtitle", "time": 7765.03, "timestamp": "02:09:25", "text": "多く。私はそこに座って見ているのが好きです"}, {"type": "subtitle", "time": 7767.43, "timestamp": "02:09:27", "text": "このファイルで。うん、成長してるね。その"}, {"type": "subtitle", "time": 7770.229, "timestamp": "02:09:30", "text": "成長している。成長している。"}, {"type": "subtitle", "time": 7772.79, "timestamp": "02:09:32", "text": "これをちょっとした点滅のように使う"}, {"type": "subtitle", "time": 7781.109, "timestamp": "02:09:41", "text": "つまり、お二人ともインターネット接続が良好である必要があります。"}, {"type": "subtitle", "time": 7783.149, "timestamp": "02:09:43", "text": "そうでない場合は、ファイルは"}, {"type": "subtitle", "time": 7786.87, "timestamp": "02:09:46", "text": "すごくゆっくり。"}, {"type": "subtitle", "time": 7790.83, "timestamp": "02:09:50", "text": "ああ、彼女は私にこれをくれる必要があったの？"}]
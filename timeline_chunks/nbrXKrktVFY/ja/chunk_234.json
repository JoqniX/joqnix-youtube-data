[{"type": "subtitle", "time": 14045.99, "timestamp": "03:54:05", "text": "キスして、この展開を見守る。"}, {"type": "subtitle", "time": 14047.99, "timestamp": "03:54:07", "text": "彼女はたくさんの男性とコラボレーションしました"}, {"type": "subtitle", "time": 14051.03, "timestamp": "03:54:11", "text": "PewDiePieの件全体と同じように"}, {"type": "subtitle", "time": 14055.269, "timestamp": "03:54:15", "text": "起こった。うん。カイが"}, {"type": "subtitle", "time": 14064.99, "timestamp": "03:54:24", "text": "ゆっくりと、もっと"}, {"type": "subtitle", "time": 14070.229, "timestamp": "03:54:30", "text": "YouTuberたちがカミングアウトしている。うん。鍵など"}, {"type": "subtitle", "time": 14071.99, "timestamp": "03:54:31", "text": "うん。うん。"}, {"type": "subtitle", "time": 14079.189, "timestamp": "03:54:39", "text": "うん。ウインク。"}, {"type": "subtitle", "time": 14081.91, "timestamp": "03:54:41", "text": "私は、人が私に尋ねるとき、私は好きです。"}, {"type": "subtitle", "time": 14083.59, "timestamp": "03:54:43", "text": "あなたのお気に入りのYouTuberは誰ですか？私は"}, {"type": "subtitle", "time": 14085.189, "timestamp": "03:54:45", "text": "そう、シオール。彼らは「うん」って感じ"}, {"type": "subtitle", "time": 14089.469, "timestamp": "03:54:49", "text": "あれって新しいYouTuberだよね？私は"}, {"type": "subtitle", "time": 14091.15, "timestamp": "03:54:51", "text": "いいえ"}, {"type": "subtitle", "time": 14093.429, "timestamp": "03:54:53", "text": "シオール。 「共有」ってどういう意味？"}, {"type": "subtitle", "time": 14097.15, "timestamp": "03:54:57", "text": "ホリーブから？私は「ああ、彼はそうしないよ」って感じ"}]
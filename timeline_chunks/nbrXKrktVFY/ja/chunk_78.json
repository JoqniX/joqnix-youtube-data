[{"type": "subtitle", "time": 4681.59, "timestamp": "01:18:01", "text": "僕もみんなも、何だって"}, {"type": "subtitle", "time": 4683.669, "timestamp": "01:18:03", "text": "私たちは、あなたが"}, {"type": "subtitle", "time": 4690.87, "timestamp": "01:18:10", "text": "そう言う時のあなた自身。うん、"}, {"type": "subtitle", "time": 4692.95, "timestamp": "01:18:12", "text": "それは私が"}, {"type": "subtitle", "time": 4694.95, "timestamp": "01:18:14", "text": "携帯電話セットがアニメで動作するのを見た。"}, {"type": "subtitle", "time": 4696.55, "timestamp": "01:18:16", "text": "そう思うよ、彼らは"}, {"type": "subtitle", "time": 4700.31, "timestamp": "01:18:20", "text": "すべての細胞が一生懸命働いています"}, {"type": "subtitle", "time": 4705.31, "timestamp": "01:18:25", "text": "みんな。うん。うん。私"}, {"type": "subtitle", "time": 4707.99, "timestamp": "01:18:27", "text": "つまり、何が好きなのか、どう言えばいいかな？"}, {"type": "subtitle", "time": 4711.51, "timestamp": "01:18:31", "text": "馬鹿げているように聞こえる。なんていうか、めちゃくちゃバカバカしく聞こえる。"}, {"type": "subtitle", "time": 4714.189, "timestamp": "01:18:34", "text": "でも、悲しい時はいつでも、"}, {"type": "subtitle", "time": 4716.59, "timestamp": "01:18:36", "text": "そうですね、考えます。"}, {"type": "subtitle", "time": 4719.11, "timestamp": "01:18:39", "text": "えー、私の推しはそうしないと思う"}, {"type": "subtitle", "time": 4720.59, "timestamp": "01:18:40", "text": "感謝する"}, {"type": "subtitle", "time": 4723.59, "timestamp": "01:18:43", "text": "私が悲しんでいるのは、彼女が私を求めているからだ"}, {"type": "subtitle", "time": 4725.75, "timestamp": "01:18:45", "text": "幸せになること。"}, {"type": "subtitle", "time": 4729.11, "timestamp": "01:18:49", "text": "だから、私は悲しまない。"}, {"type": "subtitle", "time": 4730.55, "timestamp": "01:18:50", "text": "つまり、それが私が始めた理由です"}, {"type": "subtitle", "time": 4732.31, "timestamp": "01:18:52", "text": "マリンのおかげでジムに行く"}, {"type": "subtitle", "time": 4738.79, "timestamp": "01:18:58", "text": "彼女は、ああ、やりすぎた"}]
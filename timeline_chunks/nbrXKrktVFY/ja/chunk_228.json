[{"type": "subtitle", "time": 13683.229, "timestamp": "03:48:03", "text": "ビブが"}, {"type": "subtitle", "time": 13686.55, "timestamp": "03:48:06", "text": "もの？彼はどうしてそれを知ったのか？ビブは"}, {"type": "subtitle", "time": 13688.229, "timestamp": "03:48:08", "text": "まるで、その前にあった小さなリボンのようだった。のように"}, {"type": "subtitle", "time": 13691.189, "timestamp": "03:48:11", "text": "彼女は本当に小さかった。"}, {"type": "subtitle", "time": 13693.03, "timestamp": "03:48:13", "text": "彼女はあなたのような人は持っていませんでした"}, {"type": "subtitle", "time": 13694.79, "timestamp": "03:48:14", "text": "歌唱力を知っている。彼女は"}, {"type": "subtitle", "time": 13696.87, "timestamp": "03:48:16", "text": "話すのが得意とか、そういうのが得意。しかし"}, {"type": "subtitle", "time": 13700.469, "timestamp": "03:48:20", "text": "彼女には独特の魅力があった。そして"}, {"type": "subtitle", "time": 13702.95, "timestamp": "03:48:22", "text": "その男はそれを見て、「うん、"}, {"type": "subtitle", "time": 13705.469, "timestamp": "03:48:25", "text": "それがそれが私たちの"}, {"type": "subtitle", "time": 13713.83, "timestamp": "03:48:33", "text": "グラ。ところで、あれは私たちのグラです。"}, {"type": "subtitle", "time": 13715.429, "timestamp": "03:48:35", "text": "つまり、それは、ああ、それは私たちの"}, {"type": "subtitle", "time": 13717.429, "timestamp": "03:48:37", "text": "次の配信者。"}, {"type": "subtitle", "time": 13726.63, "timestamp": "03:48:46", "text": "うん。"}, {"type": "subtitle", "time": 13728.469, "timestamp": "03:48:48", "text": "そして私はあまり好きではない"}, {"type": "subtitle", "time": 13730.309, "timestamp": "03:48:50", "text": "それが私たちのGuraです"}, {"type": "subtitle", "time": 13732.389, "timestamp": "03:48:52", "text": "なぜなら、グラが卒業した後"}]
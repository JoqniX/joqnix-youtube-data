[{"type": "subtitle", "time": 7981.43, "timestamp": "02:13:01", "text": "お互い。唯一の違いは"}, {"type": "subtitle", "time": 7983.229, "timestamp": "02:13:03", "text": "ジオタワーは"}, {"type": "subtitle", "time": 7986.87, "timestamp": "02:13:06", "text": "私たち。そこで、私はこの質問をします。もし私の"}, {"type": "subtitle", "time": 7989.709, "timestamp": "02:13:09", "text": "インターネットは速く、彼の"}, {"type": "subtitle", "time": 7993.43, "timestamp": "02:13:13", "text": "遅い、唯一の理由はタワーが"}, {"type": "subtitle", "time": 7997.91, "timestamp": "02:13:17", "text": "もっと私の方に傾いている。"}, {"type": "subtitle", "time": 8000.87, "timestamp": "02:13:20", "text": "では、タワーを傾けることはできますか？"}, {"type": "subtitle", "time": 8003.03, "timestamp": "02:13:23", "text": "彼の家は、私は速さを必要としないからです"}, {"type": "subtitle", "time": 8010.47, "timestamp": "02:13:30", "text": "そして彼はこう言った。「もし私たちがそうしたら、"}, {"type": "subtitle", "time": 8012.669, "timestamp": "02:13:32", "text": "すると、あなたの隣にいるもう一人の男が"}, {"type": "subtitle", "time": 8015.75, "timestamp": "02:13:35", "text": "家では、インターネットが遅くなるだろう。」"}, {"type": "subtitle", "time": 8017.75, "timestamp": "02:13:37", "text": "「うん、君の言うことはもっともだ。」"}, {"type": "subtitle", "time": 8019.75, "timestamp": "02:13:39", "text": "「じゃあ、どうすればいいの？」彼はこう言った。「"}, {"type": "subtitle", "time": 8022.87, "timestamp": "02:13:42", "text": "何だと思う？ Sussi が急ぐ必要があるときはいつでも"}, {"type": "subtitle", "time": 8026.069, "timestamp": "02:13:46", "text": "インターネットを使えば、彼はあなたを訪ねて、あなたも"}, {"type": "subtitle", "time": 8027.91, "timestamp": "02:13:47", "text": "どちらも高速インターネットを利用できます。私はこう思う、"}, {"type": "subtitle", "time": 8032.069, "timestamp": "02:13:52", "text": "先生、それは良い答えです。による"}, {"type": "subtitle", "time": 8034.47, "timestamp": "02:13:54", "text": "ところで、夕食は何を食べましたか？"}, {"type": "subtitle", "time": 8036.229, "timestamp": "02:13:56", "text": "まるで、羊肉を食べたようなものだ。私は、ああ、"}, {"type": "subtitle", "time": 8037.47, "timestamp": "02:13:57", "text": "それは"}, {"type": "subtitle", "time": 8039.91, "timestamp": "02:13:59", "text": "ユーモアもあるからいいよね"}]
[{"type": "subtitle", "time": 5521.27, "timestamp": "01:32:01", "text": "右？しかし生のトマトは"}, {"type": "subtitle", "time": 5524.87, "timestamp": "01:32:04", "text": "両親は昔、サラダを作ってくれて、"}, {"type": "subtitle", "time": 5527.83, "timestamp": "01:32:07", "text": "そういうことですよね？当時私は好きだった"}, {"type": "subtitle", "time": 5532.87, "timestamp": "01:32:12", "text": "えっと、トマトはちょっとそんな感じだけど"}, {"type": "subtitle", "time": 5536.149, "timestamp": "01:32:16", "text": "それでも私はそれを食べていました。つまり、"}, {"type": "subtitle", "time": 5539.75, "timestamp": "01:32:19", "text": "すると、ああ、という感じで頭に浮かんだ"}, {"type": "subtitle", "time": 5542.47, "timestamp": "01:32:22", "text": "両親が教えてくれたように、"}, {"type": "subtitle", "time": 5545.27, "timestamp": "01:32:25", "text": "食べ物を無駄にせず、感謝の気持ちを持つ"}, {"type": "subtitle", "time": 5547.99, "timestamp": "01:32:27", "text": "あなたが持っているもの、そしてすべてに対して。だから私は"}, {"type": "subtitle", "time": 5550.31, "timestamp": "01:32:30", "text": "「よし、決心した」"}, {"type": "subtitle", "time": 5553.03, "timestamp": "01:32:33", "text": "そう、食べ始めよう"}, {"type": "subtitle", "time": 5554.99, "timestamp": "01:32:34", "text": "今日からのトマトと苦い神"}, {"type": "subtitle", "time": 5559.51, "timestamp": "01:32:39", "text": "「好きになるまで続ける。」だから私は"}, {"type": "subtitle", "time": 5562.149, "timestamp": "01:32:42", "text": "数ヶ月前からそれを始めました"}, {"type": "subtitle", "time": 5565.83, "timestamp": "01:32:45", "text": "数ヶ月後、私は愛しています"}, {"type": "subtitle", "time": 5569.43, "timestamp": "01:32:49", "text": "彼らを好きになった。そして私は願う、願う"}, {"type": "subtitle", "time": 5571.03, "timestamp": "01:32:51", "text": "妹はこれを嫌うからする"}, {"type": "subtitle", "time": 5575.149, "timestamp": "01:32:55", "text": "トマト。それは彼女を吐かせる。おお"}, {"type": "subtitle", "time": 5577.83, "timestamp": "01:32:57", "text": "いいえ。うん。なぜなら私は物を作るし"}, {"type": "subtitle", "time": 5579.11, "timestamp": "01:32:59", "text": "時々、うっかり"}]
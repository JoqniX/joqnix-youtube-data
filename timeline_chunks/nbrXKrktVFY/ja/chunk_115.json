[{"type": "subtitle", "time": 6905.39, "timestamp": "01:55:05", "text": "そして彼らは基本的に"}, {"type": "subtitle", "time": 6909.35, "timestamp": "01:55:09", "text": "サキュバスが交流したとき"}, {"type": "subtitle", "time": 6911.669, "timestamp": "01:55:11", "text": "雄の標本とともに"}, {"type": "subtitle", "time": 6913.99, "timestamp": "01:55:13", "text": "そしてその雄の標本には悪魔が多すぎる"}, {"type": "subtitle", "time": 6917.83, "timestamp": "01:55:17", "text": "彼にマナを注ぎ込む。彼は改宗するだろう"}, {"type": "subtitle", "time": 6919.589, "timestamp": "01:55:19", "text": "サキブバスに乗せて。つまり彼は"}, {"type": "subtitle", "time": 6922.95, "timestamp": "01:55:22", "text": "どうやって下に行くか基本的にどうやって"}, {"type": "subtitle", "time": 6925.75, "timestamp": "01:55:25", "text": "サケはオスが"}, {"type": "subtitle", "time": 6929.109, "timestamp": "01:55:29", "text": "女性。うん。"}, {"type": "subtitle", "time": 6933.589, "timestamp": "01:55:33", "text": "つまり、そうなるか、"}, {"type": "subtitle", "time": 6935.35, "timestamp": "01:55:35", "text": "えっと、それはアリスに変わります"}, {"type": "subtitle", "time": 6938.87, "timestamp": "01:55:38", "text": "基本的には男性のサキュバス"}, {"type": "subtitle", "time": 6943.03, "timestamp": "01:55:43", "text": "そして、彼が止めればその形を維持するだろう"}, {"type": "subtitle", "time": 6947.189, "timestamp": "01:55:47", "text": "男性のエッセンスを消費し続けよう"}, {"type": "subtitle", "time": 6948.24, "timestamp": "01:55:48", "text": "言う"}]
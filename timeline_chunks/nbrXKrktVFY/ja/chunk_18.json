[{"type": "subtitle", "time": 1083.27, "timestamp": "00:18:03", "text": "彼は知らない。待って、これは何？"}, {"type": "subtitle", "time": 1085.789, "timestamp": "00:18:05", "text": "そのままにしておいてください。"}, {"type": "subtitle", "time": 1088.63, "timestamp": "00:18:08", "text": "わかった。石じゃんけんみたいなものですか？"}, {"type": "subtitle", "time": 1090.15, "timestamp": "00:18:10", "text": "あれ？"}, {"type": "subtitle", "time": 1092.47, "timestamp": "00:18:12", "text": "うん。うん。それは、それは、それは"}, {"type": "subtitle", "time": 1101.95, "timestamp": "00:18:21", "text": "ああ、それは私の欠陥です"}, {"type": "subtitle", "time": 1118.87, "timestamp": "00:18:38", "text": "天気はどうですか？天気は"}, {"type": "subtitle", "time": 1123.909, "timestamp": "00:18:43", "text": "今日は良い天気です。少し雨が降った"}, {"type": "subtitle", "time": 1127.029, "timestamp": "00:18:47", "text": "私の場合、ちょうど1時間前くらいでした。"}, {"type": "subtitle", "time": 1130.39, "timestamp": "00:18:50", "text": "そうそう。あなたの家はどうですか？どうでしたか？"}, {"type": "subtitle", "time": 1134.23, "timestamp": "00:18:54", "text": "天候？ものすごく暑かった。私は私だった"}, {"type": "subtitle", "time": 1138.27, "timestamp": "00:18:58", "text": "死にかけていた。なんてこった。"}]
[{"type": "subtitle", "time": 7026.07, "timestamp": "01:57:06", "text": "言う。私が感謝していることの一つは"}, {"type": "subtitle", "time": 7030.229, "timestamp": "01:57:10", "text": "多くの人が知らないのは、VTuberの伝承です。"}, {"type": "subtitle", "time": 7032.149, "timestamp": "01:57:12", "text": "伝承を書くとき、"}, {"type": "subtitle", "time": 7036.39, "timestamp": "01:57:16", "text": "私は彼らについて読むのが大好きです。うん。"}, {"type": "subtitle", "time": 7038.229, "timestamp": "01:57:18", "text": "彼らがどう考えているかを見るために"}, {"type": "subtitle", "time": 7040.149, "timestamp": "01:57:20", "text": "それ。"}, {"type": "subtitle", "time": 7043.109, "timestamp": "01:57:23", "text": "中には全力で取り組む人もいる"}, {"type": "subtitle", "time": 7044.669, "timestamp": "01:57:24", "text": "彼らは"}, {"type": "subtitle", "time": 7046.35, "timestamp": "01:57:26", "text": "行く"}, {"type": "subtitle", "time": 7049.83, "timestamp": "01:57:29", "text": "まるでこの宇宙全体を創造するかのように"}, {"type": "subtitle", "time": 7055.83, "timestamp": "01:57:35", "text": "あるいはキャラクターを作ってから"}, {"type": "subtitle", "time": 7059.589, "timestamp": "01:57:39", "text": "宇宙と彼らを繋げる。"}, {"type": "subtitle", "time": 7060.95, "timestamp": "01:57:40", "text": "アプローチの方法はたくさんある"}, {"type": "subtitle", "time": 7063.109, "timestamp": "01:57:43", "text": "それ。はい。はい。"}, {"type": "subtitle", "time": 7065.109, "timestamp": "01:57:45", "text": "『ホロウ・ライフ』はそれをとてもうまくやっていると思う。"}, {"type": "subtitle", "time": 7068.229, "timestamp": "01:57:48", "text": "伝承やファンについて言えば"}, {"type": "subtitle", "time": 7070.87, "timestamp": "01:57:50", "text": "なぜなら、ほとんどの場合ファンが"}, {"type": "subtitle", "time": 7073.589, "timestamp": "01:57:53", "text": "いわば、設定を修正するということだ。うん。のように"}, {"type": "subtitle", "time": 7076.47, "timestamp": "01:57:56", "text": "例えばAは、以前は"}, {"type": "subtitle", "time": 7078.95, "timestamp": "01:57:58", "text": "ごく普通の探偵少女。"}]
[{"type": "subtitle", "time": 4320.87, "timestamp": "01:12:00", "text": "それがアナという人物像だ。ああ、神様。うん。いいえ"}, {"type": "subtitle", "time": 4322.93, "timestamp": "01:12:02", "text": "ルール。何でもありだ。"}, {"type": "subtitle", "time": 4324.47, "timestamp": "01:12:04", "text": "[音楽]"}, {"type": "subtitle", "time": 4328.55, "timestamp": "01:12:08", "text": "あなたはあの人を殺したいのですか？頑張れ。"}, {"type": "subtitle", "time": 4329.55, "timestamp": "01:12:09", "text": "おお"}, {"type": "subtitle", "time": 4332.87, "timestamp": "01:12:12", "text": "いいえ。ああ、それは独自の"}, {"type": "subtitle", "time": 4336.95, "timestamp": "01:12:16", "text": "デメリットもある。暴力とかそういう類のこと。"}, {"type": "subtitle", "time": 4343.51, "timestamp": "01:12:23", "text": "だから私の頭の中ではジョギング協会は"}, {"type": "subtitle", "time": 4346.709, "timestamp": "01:12:26", "text": "妖精みたいなやつ"}, {"type": "subtitle", "time": 4350.27, "timestamp": "01:12:30", "text": "おとぎ話のように"}, {"type": "subtitle", "time": 4352.79, "timestamp": "01:12:32", "text": "みんながただ何かが起こっている"}, {"type": "subtitle", "time": 4355.35, "timestamp": "01:12:35", "text": "ベリー摘み作業"}, {"type": "subtitle", "time": 4357.43, "timestamp": "01:12:37", "text": "幸せな家族。うん。そういう風に"}, {"type": "subtitle", "time": 4360.39, "timestamp": "01:12:40", "text": "あなたの社会を見てください。その通り。暴力なし"}, {"type": "subtitle", "time": 4363.35, "timestamp": "01:12:43", "text": "あるいは、ただ「いつまでも幸せに暮らしました」というような話でもいい。"}, {"type": "subtitle", "time": 4364.709, "timestamp": "01:12:44", "text": "うん。彼らは「何が"}, {"type": "subtitle", "time": 4366.63, "timestamp": "01:12:46", "text": "君たちは何の話をしてるんだ？暴力。"}, {"type": "subtitle", "time": 4367.83, "timestamp": "01:12:47", "text": "あれは何でしょう？"}, {"type": "subtitle", "time": 4370.07, "timestamp": "01:12:50", "text": "その通り。あれは何でしょう？それは"}, {"type": "subtitle", "time": 4375.59, "timestamp": "01:12:55", "text": "[音楽]"}, {"type": "subtitle", "time": 4378.43, "timestamp": "01:12:58", "text": "そして私の社会はおそらく"}]
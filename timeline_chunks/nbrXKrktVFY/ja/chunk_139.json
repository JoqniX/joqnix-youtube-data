[{"type": "subtitle", "time": 8340.389, "timestamp": "02:19:00", "text": "チャネル。 「あなたはそうするべきではない」"}, {"type": "subtitle", "time": 8346.87, "timestamp": "02:19:06", "text": "おお。それは、そういう種類の"}, {"type": "subtitle", "time": 8348.469, "timestamp": "02:19:08", "text": "私が好きなもの、一緒に過ごすこと"}, {"type": "subtitle", "time": 8350.79, "timestamp": "02:19:10", "text": "人々と共に。それはバカみたいだ"}, {"type": "subtitle", "time": 8354.15, "timestamp": "02:19:14", "text": "インターネット上での交流。うん。"}, {"type": "subtitle", "time": 8355.91, "timestamp": "02:19:15", "text": "なぜなら、現代の人々は真面目すぎるから"}, {"type": "subtitle", "time": 8360.709, "timestamp": "02:19:20", "text": "すべてがクソみたいだ"}, {"type": "subtitle", "time": 8362.309, "timestamp": "02:19:22", "text": "政治的。すべてがこうでなければならない"}, {"type": "subtitle", "time": 8364.23, "timestamp": "02:19:24", "text": "これかあれか、このグループかあれか"}, {"type": "subtitle", "time": 8366.07, "timestamp": "02:19:26", "text": "グループ。"}, {"type": "subtitle", "time": 8369.429, "timestamp": "02:19:29", "text": "見てよ、妊娠したソニック"}, {"type": "subtitle", "time": 8379.99, "timestamp": "02:19:39", "text": "何てことだ。"}, {"type": "subtitle", "time": 8384.87, "timestamp": "02:19:44", "text": "どうやって、どうやって私たちを見つけるのですか？"}, {"type": "subtitle", "time": 8388.309, "timestamp": "02:19:48", "text": "彼らを見つけるために、あなたは何をしますか？ああ、友よ"}, {"type": "subtitle", "time": 8389.83, "timestamp": "02:19:49", "text": "いつもの。"}, {"type": "subtitle", "time": 8392.389, "timestamp": "02:19:52", "text": "ああ、例えば私が使用方法を見てみると"}, {"type": "subtitle", "time": 8395.27, "timestamp": "02:19:55", "text": "この発見機能。いいえ、"}, {"type": "subtitle", "time": 8397.51, "timestamp": "02:19:57", "text": "ディスカバリー・フューチャーが行うことは、最も"}, {"type": "subtitle", "time": 8399.51, "timestamp": "02:19:59", "text": "最悪の機能です。"}]
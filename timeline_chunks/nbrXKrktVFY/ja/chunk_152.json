[{"type": "subtitle", "time": 9123.349, "timestamp": "02:32:03", "text": "アスミンがチャットをまるで"}, {"type": "subtitle", "time": 9124.429, "timestamp": "02:32:04", "text": "すべてではない"}, {"type": "subtitle", "time": 9126.71, "timestamp": "02:32:06", "text": "バカ。賢い人もいるが"}, {"type": "subtitle", "time": 9129.55, "timestamp": "02:32:09", "text": "彼らはほとんどが愚かだ"}, {"type": "subtitle", "time": 9131.99, "timestamp": "02:32:11", "text": "人々。だから誰かがこう言う"}, {"type": "subtitle", "time": 9133.75, "timestamp": "02:32:13", "text": "彼が彼らにプラットフォームを提供する"}, {"type": "subtitle", "time": 9135.19, "timestamp": "02:32:15", "text": "それについて話しましょう。わかった。なんでそんなことするの？"}, {"type": "subtitle", "time": 9137.11, "timestamp": "02:32:17", "text": "そう言ってるの？彼がそれらを引き上げて"}, {"type": "subtitle", "time": 9139.67, "timestamp": "02:32:19", "text": "えっと、なんでそんなこと言うの？"}, {"type": "subtitle", "time": 9142.469, "timestamp": "02:32:22", "text": "ああ、それに気づいてたよ。はい。気に入った"}, {"type": "subtitle", "time": 9144.469, "timestamp": "02:32:24", "text": "彼らを呼び出して質問する"}, {"type": "subtitle", "time": 9146.71, "timestamp": "02:32:26", "text": "他の人に交流する方法を示す"}, {"type": "subtitle", "time": 9150.309, "timestamp": "02:32:30", "text": "チャットはスパムではなく、電話のようなものではありません"}, {"type": "subtitle", "time": 9152.309, "timestamp": "02:32:32", "text": "名前。何か話し合いたいことがあれば、"}, {"type": "subtitle", "time": 9155.11, "timestamp": "02:32:35", "text": "アスミンはあなたの話を聞いてくれるでしょう。"}, {"type": "subtitle", "time": 9158.389, "timestamp": "02:32:38", "text": "そして、もしあなたのものが話す価値があるなら"}, {"type": "subtitle", "time": 9160.469, "timestamp": "02:32:40", "text": "彼がそれを読んだら、彼は話すだろう"}, {"type": "subtitle", "time": 9168.55, "timestamp": "02:32:48", "text": "そういうところが気に入ってるんです。のように"}, {"type": "subtitle", "time": 9171.51, "timestamp": "02:32:51", "text": "チャットでのやり取りは、"}, {"type": "subtitle", "time": 9175.83, "timestamp": "02:32:55", "text": "彼らが望む方法でチャットする"}]
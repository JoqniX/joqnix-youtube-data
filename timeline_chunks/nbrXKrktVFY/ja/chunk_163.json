[{"type": "subtitle", "time": 9780.55, "timestamp": "02:43:00", "text": "マララさんにとって、母語はマララ語だったんですね。なぜなら"}, {"type": "subtitle", "time": 9783.349, "timestamp": "02:43:03", "text": "私は好きじゃなかったし、私は苦手です"}, {"type": "subtitle", "time": 9785.67, "timestamp": "02:43:05", "text": "それ。だから私は「よし、行くよ」って言ったの"}, {"type": "subtitle", "time": 9788.309, "timestamp": "02:43:08", "text": "ヒンディー語で、少なくとも何とか終わらせることができる"}, {"type": "subtitle", "time": 9791.11, "timestamp": "02:43:11", "text": "今学年度のすべてにおいて。"}, {"type": "subtitle", "time": 9794.91, "timestamp": "02:43:14", "text": "マラヤーラム語で単語を一つ教えてください。"}, {"type": "subtitle", "time": 9798.59, "timestamp": "02:43:18", "text": "えっと、ああ、なんてことだ、あなたは私をスパイダーに置いたんですね。"}, {"type": "subtitle", "time": 9804.07, "timestamp": "02:43:24", "text": "ああ、私はいつもああ神様、どうすれば"}, {"type": "subtitle", "time": 9807.67, "timestamp": "02:43:27", "text": "ええ、ナマステを教えてあげます"}, {"type": "subtitle", "time": 9813.23, "timestamp": "02:43:33", "text": "マラームに相当する。そうなると思う"}, {"type": "subtitle", "time": 9816.07, "timestamp": "02:43:36", "text": "ウム・ナマスカラム。"}, {"type": "subtitle", "time": 9818.55, "timestamp": "02:43:38", "text": "ああ、わかってるよ。ナマスカラム。ええ、それは"}, {"type": "subtitle", "time": 9820.469, "timestamp": "02:43:40", "text": "種の"}, {"type": "subtitle", "time": 9823.11, "timestamp": "02:43:43", "text": "私は、人々が"}, {"type": "subtitle", "time": 9824.95, "timestamp": "02:43:44", "text": "私とは違う言語を話した"}, {"type": "subtitle", "time": 9827.75, "timestamp": "02:43:47", "text": "ベンガル語を話す友人とこれを話すと、"}, {"type": "subtitle", "time": 9831.95, "timestamp": "02:43:51", "text": "右？私が最初に尋ねたのは"}, {"type": "subtitle", "time": 9835.75, "timestamp": "02:43:55", "text": "彼女。わかりました、好きの言い方を教えてください"}, {"type": "subtitle", "time": 9837.79, "timestamp": "02:43:57", "text": "あなたの"}]
[{"type": "subtitle", "time": 10087.269, "timestamp": "02:48:07", "text": "ウルは私が"}, {"type": "subtitle", "time": 10090.389, "timestamp": "02:48:10", "text": "自信を持って話す"}, {"type": "subtitle", "time": 10093.55, "timestamp": "02:48:13", "text": "それは私が"}, {"type": "subtitle", "time": 10096.11, "timestamp": "02:48:16", "text": "まるで話せるみたい"}, {"type": "subtitle", "time": 10098.95, "timestamp": "02:48:18", "text": "流暢に。私は自分が本当に流暢に話せることを知っています"}, {"type": "subtitle", "time": 10101.19, "timestamp": "02:48:21", "text": "なぜなら私は人生ずっとそう話していたから"}, {"type": "subtitle", "time": 10105.19, "timestamp": "02:48:25", "text": "子供時代。うん。そして、それは英語です。"}, {"type": "subtitle", "time": 10107.51, "timestamp": "02:48:27", "text": "何か説明したいときは、"}, {"type": "subtitle", "time": 10110.469, "timestamp": "02:48:30", "text": "英語は私が持っているものなので"}, {"type": "subtitle", "time": 10113.83, "timestamp": "02:48:33", "text": "たくさんのことを学びました"}, {"type": "subtitle", "time": 10115.59, "timestamp": "02:48:35", "text": "オンライン上のあらゆるものと同様。私は学んだ"}, {"type": "subtitle", "time": 10117.67, "timestamp": "02:48:37", "text": "基本的な技術関連のもの"}, {"type": "subtitle", "time": 10120.07, "timestamp": "02:48:40", "text": "英語で書かれているものなら何でも。だからそれは"}, {"type": "subtitle", "time": 10121.91, "timestamp": "02:48:41", "text": "英語で物事を説明する方が簡単"}, {"type": "subtitle", "time": 10124.55, "timestamp": "02:48:44", "text": "自分。はい。次に、道路関連のもの"}, {"type": "subtitle", "time": 10127.03, "timestamp": "02:48:47", "text": "それはヒンディー語です。"}, {"type": "subtitle", "time": 10128.63, "timestamp": "02:48:48", "text": "外に出て話すときみたいに"}, {"type": "subtitle", "time": 10132.469, "timestamp": "02:48:52", "text": "人々にとってはヒンディー語だ。うん。そしてすべて"}, {"type": "subtitle", "time": 10133.91, "timestamp": "02:48:53", "text": "他のものはオンラインと同じ"}, {"type": "subtitle", "time": 10135.91, "timestamp": "02:48:55", "text": "人々と過ごしたり、ただ一緒に時間を過ごしたりするのが好きです"}]
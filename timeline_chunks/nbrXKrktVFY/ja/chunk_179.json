[{"type": "subtitle", "time": 10762.63, "timestamp": "02:59:22", "text": "それは良い知らせですね。"}, {"type": "subtitle", "time": 10765.51, "timestamp": "02:59:25", "text": "うん。"}, {"type": "subtitle", "time": 10767.55, "timestamp": "02:59:27", "text": "私のもう一人の友人は"}, {"type": "subtitle", "time": 10770.95, "timestamp": "02:59:30", "text": "アメリカへ、"}, {"type": "subtitle", "time": 10772.11, "timestamp": "02:59:32", "text": "彼女は言った"}, {"type": "subtitle", "time": 10774.71, "timestamp": "02:59:34", "text": "彼女は本当に興味深いものを持っていた"}, {"type": "subtitle", "time": 10776.75, "timestamp": "02:59:36", "text": "に"}, {"type": "subtitle", "time": 10778.349, "timestamp": "02:59:38", "text": "言う"}, {"type": "subtitle", "time": 10781.19, "timestamp": "02:59:41", "text": "思い出したように、もう1つあります"}, {"type": "subtitle", "time": 10785.91, "timestamp": "02:59:45", "text": "友達のショウバムだよね？"}, {"type": "subtitle", "time": 10788.55, "timestamp": "02:59:48", "text": "彼は本当に情熱的で"}, {"type": "subtitle", "time": 10791.429, "timestamp": "02:59:51", "text": "言語。"}, {"type": "subtitle", "time": 10793.75, "timestamp": "02:59:53", "text": "だから、彼女が行った時のことを覚えてるよ"}, {"type": "subtitle", "time": 10795.83, "timestamp": "02:59:55", "text": "アメリカで彼が彼女に最初に頼んだことは"}, {"type": "subtitle", "time": 10797.389, "timestamp": "02:59:57", "text": "n と言います"}]
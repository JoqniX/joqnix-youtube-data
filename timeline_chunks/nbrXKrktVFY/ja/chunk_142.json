[{"type": "subtitle", "time": 8521.11, "timestamp": "02:22:01", "text": "今。長距離とみなされます"}, {"type": "subtitle", "time": 8525.11, "timestamp": "02:22:05", "text": "とか、そんな感じですよね？うん。"}, {"type": "subtitle", "time": 8527.91, "timestamp": "02:22:07", "text": "昔は私がその男だったんです。私はまだ"}, {"type": "subtitle", "time": 8530.59, "timestamp": "02:22:10", "text": "長いものが嫌いな男"}, {"type": "subtitle", "time": 8533.19, "timestamp": "02:22:13", "text": "距離。例えば、友達が"}, {"type": "subtitle", "time": 8535.19, "timestamp": "02:22:15", "text": "遠距離恋愛中なので、"}, {"type": "subtitle", "time": 8542.309, "timestamp": "02:22:22", "text": "彼ら。でも、私は遠距離恋愛をしていた"}, {"type": "subtitle", "time": 8544.71, "timestamp": "02:22:24", "text": "関係。だから私はからかい始めた"}, {"type": "subtitle", "time": 8547.51, "timestamp": "02:22:27", "text": "自分自身は、うわー、私は自分が嫌いになった"}, {"type": "subtitle", "time": 8553.91, "timestamp": "02:22:33", "text": "でも終わった後、私は「よし、"}, {"type": "subtitle", "time": 8561.349, "timestamp": "02:22:41", "text": "私は本当に寂しがり屋なので距離を置く"}, {"type": "subtitle", "time": 8564.23, "timestamp": "02:22:44", "text": "男。\""}, {"type": "subtitle", "time": 8565.55, "timestamp": "02:22:45", "text": "のように"}, {"type": "subtitle", "time": 8568.469, "timestamp": "02:22:48", "text": "私は、私が言うように、私は"}, {"type": "subtitle", "time": 8570.79, "timestamp": "02:22:50", "text": "1"}, {"type": "subtitle", "time": 8574.23, "timestamp": "02:22:54", "text": "えっと、どう表現するのが一番いいでしょうか？"}, {"type": "subtitle", "time": 8576.389, "timestamp": "02:22:56", "text": "私は常に元気な犬のような"}]
[{"type": "subtitle", "time": 11041.11, "timestamp": "03:04:01", "text": "でも、私がショーンを好きな理由は、彼女が"}, {"type": "subtitle", "time": 11045.03, "timestamp": "03:04:05", "text": "ああ、彼女はとても素敵なやり方で"}, {"type": "subtitle", "time": 11052.23, "timestamp": "03:04:12", "text": "彼女が言ったこのことのように、私は"}, {"type": "subtitle", "time": 11054.87, "timestamp": "03:04:14", "text": "信じたい、そこには意味がある"}, {"type": "subtitle", "time": 11057.03, "timestamp": "03:04:17", "text": "世界には素敵な人たちがいる"}, {"type": "subtitle", "time": 11058.28, "timestamp": "03:04:18", "text": "世界"}, {"type": "subtitle", "time": 11059.75, "timestamp": "03:04:19", "text": "[音楽]"}, {"type": "subtitle", "time": 11061.349, "timestamp": "03:04:21", "text": "私もそう信じたい。"}, {"type": "subtitle", "time": 11063.83, "timestamp": "03:04:23", "text": "もし私の推しが信じているなら"}, {"type": "subtitle", "time": 11065.51, "timestamp": "03:04:25", "text": "世の中には良い人がいると信じます"}, {"type": "subtitle", "time": 11067.67, "timestamp": "03:04:27", "text": "それもそうだ。"}, {"type": "subtitle", "time": 11070.07, "timestamp": "03:04:30", "text": "うん。"}, {"type": "subtitle", "time": 11076.349, "timestamp": "03:04:36", "text": "人々が私の妹についてよく言うように"}, {"type": "subtitle", "time": 11086.55, "timestamp": "03:04:46", "text": "かわいいですね。"}, {"type": "subtitle", "time": 11089.429, "timestamp": "03:04:49", "text": "ジョグ、君はどうなんだい？"}, {"type": "subtitle", "time": 11093.51, "timestamp": "03:04:53", "text": "あなたは特定の娘を愛していますか？"}, {"type": "subtitle", "time": 11095.59, "timestamp": "03:04:55", "text": "ああ、娘よ、"}]
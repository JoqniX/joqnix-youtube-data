[{"type": "subtitle", "time": 12122.309, "timestamp": "03:22:02", "text": "YouTuberのことは気にしない"}, {"type": "subtitle", "time": 12125.51, "timestamp": "03:22:05", "text": "インドの視聴者向け広告など"}, {"type": "subtitle", "time": 12129.11, "timestamp": "03:22:09", "text": "インドで。うん。なぜならそれは"}, {"type": "subtitle", "time": 12131.429, "timestamp": "03:22:11", "text": "例えば私はYouTuberのファンですが、"}, {"type": "subtitle", "time": 12133.269, "timestamp": "03:22:13", "text": "右？"}, {"type": "subtitle", "time": 12135.75, "timestamp": "03:22:15", "text": "それは、"}, {"type": "subtitle", "time": 12138.55, "timestamp": "03:22:18", "text": "私です。ああ、それは本当だ。それはもたらすでしょう"}, {"type": "subtitle", "time": 12142.63, "timestamp": "03:22:22", "text": "このループの外にいる人々"}, {"type": "subtitle", "time": 12144.389, "timestamp": "03:22:24", "text": "YouTube を知らないし"}, {"type": "subtitle", "time": 12146.87, "timestamp": "03:22:26", "text": "すべては、たくさんあるからです"}, {"type": "subtitle", "time": 12149.67, "timestamp": "03:22:29", "text": "インドのYouTuberファン。私はそれらを見たことがあります"}, {"type": "subtitle", "time": 12153.03, "timestamp": "03:22:33", "text": "インドのユーチューバーファン"}, {"type": "subtitle", "time": 12155.59, "timestamp": "03:22:35", "text": "ホリデーライフのように、私は見てきました"}, {"type": "subtitle", "time": 12157.91, "timestamp": "03:22:37", "text": "人々はルピーで寄付をする。私は見た"}, {"type": "subtitle", "time": 12162.55, "timestamp": "03:22:42", "text": "エナのチャットでは人々が会話している。うん。言う"}, {"type": "subtitle", "time": 12164.07, "timestamp": "03:22:44", "text": "インドの単語がいくつかあって、私は"}, {"type": "subtitle", "time": 12170.79, "timestamp": "03:22:50", "text": "Pipaのチャットで人々が"}, {"type": "subtitle", "time": 12173.87, "timestamp": "03:22:53", "text": "ヒンディー語で叫んでいる。ああ、"}, {"type": "subtitle", "time": 12177.59, "timestamp": "03:22:57", "text": "神。特にピパがしたように"}, {"type": "subtitle", "time": 12179.83, "timestamp": "03:22:59", "text": "本当のもの、そして彼女の本当のものは"}]
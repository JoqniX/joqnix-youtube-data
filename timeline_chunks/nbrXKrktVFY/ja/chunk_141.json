[{"type": "subtitle", "time": 8462.79, "timestamp": "02:21:02", "text": "私が好きな最初のもののように、私は知っています"}, {"type": "subtitle", "time": 8464.63, "timestamp": "02:21:04", "text": "私が参加する頃にはサーバーは良くなっているだろう"}, {"type": "subtitle", "time": 8468.87, "timestamp": "02:21:08", "text": "すると、人々は私に悪口を言い始めた。"}, {"type": "subtitle", "time": 8471.23, "timestamp": "02:21:11", "text": "「よし、これは"}, {"type": "subtitle", "time": 8475.469, "timestamp": "02:21:15", "text": "楽しいよ。彼はこう言うんだ。「ほら、またバカが"}, {"type": "subtitle", "time": 8482.71, "timestamp": "02:21:22", "text": "特に次のようなサーバー"}, {"type": "subtitle", "time": 8484.469, "timestamp": "02:21:24", "text": "人々はただぶらぶらしているだけです"}, {"type": "subtitle", "time": 8490.23, "timestamp": "02:21:30", "text": "なぜなら、今では次のようなサーバーがあるからです。"}, {"type": "subtitle", "time": 8495.67, "timestamp": "02:21:35", "text": "人々はオンラインデートを利用する。すごく変だ。"}, {"type": "subtitle", "time": 8498.71, "timestamp": "02:21:38", "text": "私はその概念を理解していません"}, {"type": "subtitle", "time": 8501.91, "timestamp": "02:21:41", "text": "そこから何を得るのですか？"}, {"type": "subtitle", "time": 8504.469, "timestamp": "02:21:44", "text": "私は思う"}, {"type": "subtitle", "time": 8506.63, "timestamp": "02:21:46", "text": "それは、そうでない人にとっては"}, {"type": "subtitle", "time": 8508.79, "timestamp": "02:21:48", "text": "オンラインで実際の人々と交流する。えっと"}, {"type": "subtitle", "time": 8512.23, "timestamp": "02:21:52", "text": "IRL なので、IRL のためにオンラインに行く"}, {"type": "subtitle", "time": 8519.27, "timestamp": "02:21:59", "text": "しかし最終的には会わなければならない"}]
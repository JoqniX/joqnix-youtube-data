[{"type": "subtitle", "time": 12780.87, "timestamp": "03:33:00", "text": "する？彼はアダムについて一度も話したことがなかった。"}, {"type": "subtitle", "time": 12782.63, "timestamp": "03:33:02", "text": "そして、そこにいた女の子でさえ、私は"}, {"type": "subtitle", "time": 12784.87, "timestamp": "03:33:04", "text": "その女の子のことは知らない。彼女は映画でもある"}, {"type": "subtitle", "time": 12787.11, "timestamp": "03:33:07", "text": "スターですよね？"}, {"type": "subtitle", "time": 12789.429, "timestamp": "03:33:09", "text": "彼女はアニメについて話しながら"}, {"type": "subtitle", "time": 12791.91, "timestamp": "03:33:11", "text": "誤った情報を流している。私はこう思う、"}, {"type": "subtitle", "time": 12795.429, "timestamp": "03:33:15", "text": "「ああ、ナルトの世界ではそんなことは起こらなかったよ。」"}, {"type": "subtitle", "time": 12802.55, "timestamp": "03:33:22", "text": "彼女は「ああ、思い出したわ」って感じ"}, {"type": "subtitle", "time": 12806.349, "timestamp": "03:33:26", "text": "ナルトが友達に裏切られたとき"}, {"type": "subtitle", "time": 12809.429, "timestamp": "03:33:29", "text": "そして彼女はスーパーサイヤ人になった。」私はこう思った。"}, {"type": "chat", "time": 12811.099, "timestamp": "03:33:31", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/oPgfY_DoKfSXkNAPq8-AgAo"}, {"type": "subtitle", "time": 12820.229, "timestamp": "03:33:40", "text": "悟空が"}, {"type": "subtitle", "time": 12824.39, "timestamp": "03:33:44", "text": "ウチア族の村。私は「えっ？」って感じでした。"}, {"type": "subtitle", "time": 12832.54, "timestamp": "03:33:52", "text": "佐太郎、"}, {"type": "chat", "time": 12835.358, "timestamp": "03:33:55", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/X_zdXMHgJaPa8gTGt4f4Ag"}, {"type": "subtitle", "time": 12835.63, "timestamp": "03:33:55", "text": "[音楽]"}, {"type": "subtitle", "time": 12838.07, "timestamp": "03:33:58", "text": "兄弟。明らかにこれらの人々は"}, {"type": "subtitle", "time": 12839.99, "timestamp": "03:33:59", "text": "こういうのは好きじゃない。彼らはちょうど"}]
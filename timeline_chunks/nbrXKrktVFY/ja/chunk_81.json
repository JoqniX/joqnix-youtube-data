[{"type": "subtitle", "time": 4861.27, "timestamp": "01:21:01", "text": "そして、何かが私を悩ませるとき、それらは消えることはない"}, {"type": "subtitle", "time": 4863.03, "timestamp": "01:21:03", "text": "すぐに逃げろ。なぜなら、あなたが"}, {"type": "subtitle", "time": 4865.83, "timestamp": "01:21:05", "text": "あらゆるものに対する抵抗力があり、"}, {"type": "subtitle", "time": 4868.39, "timestamp": "01:21:08", "text": "何か気になることがあれば、"}, {"type": "subtitle", "time": 4870.31, "timestamp": "01:21:10", "text": "痛みが治らないから"}, {"type": "subtitle", "time": 4872.59, "timestamp": "01:21:12", "text": "苦しんだというのは、あれこれみたいなものです"}, {"type": "subtitle", "time": 4881.51, "timestamp": "01:21:21", "text": "だから私の精神状態は悪化する一方だ"}, {"type": "subtitle", "time": 4882.99, "timestamp": "01:21:22", "text": "私自身の"}, {"type": "subtitle", "time": 4885.7, "timestamp": "01:21:25", "text": "関係性、と言えば分かりやすいでしょうか。"}, {"type": "subtitle", "time": 4887.83, "timestamp": "01:21:27", "text": "[音楽]"}, {"type": "subtitle", "time": 4892.149, "timestamp": "01:21:32", "text": "だから私はジムに行ったとき"}, {"type": "subtitle", "time": 4895.79, "timestamp": "01:21:35", "text": "わからないけど、それはあなたの"}, {"type": "subtitle", "time": 4899.35, "timestamp": "01:21:39", "text": "心は空っぽだ。"}, {"type": "subtitle", "time": 4901.11, "timestamp": "01:21:41", "text": "何かしたような気分になる"}, {"type": "subtitle", "time": 4903.03, "timestamp": "01:21:43", "text": "今日。"}, {"type": "subtitle", "time": 4904.87, "timestamp": "01:21:44", "text": "うん。"}, {"type": "subtitle", "time": 4908.669, "timestamp": "01:21:48", "text": "良い意味で。うん。そしてまた、"}, {"type": "subtitle", "time": 4914.39, "timestamp": "01:21:54", "text": "使い古された感じが良い、みたいな。"}, {"type": "subtitle", "time": 4917.55, "timestamp": "01:21:57", "text": "理にかなっているなら。"}]
[{"type": "subtitle", "time": 3781.67, "timestamp": "01:03:01", "text": "自己独立権"}, {"type": "subtitle", "time": 3783.99, "timestamp": "01:03:03", "text": "何かをしたいのですが、"}, {"type": "subtitle", "time": 3787.51, "timestamp": "01:03:07", "text": "誰かと契約を結んだとしましょう"}, {"type": "subtitle", "time": 3790.71, "timestamp": "01:03:10", "text": "そう、彼らはそれを与えることを望んでいる"}, {"type": "subtitle", "time": 3796.069, "timestamp": "01:03:16", "text": "あなたにそれを与えることを願う"}, {"type": "subtitle", "time": 3798.95, "timestamp": "01:03:18", "text": "それなら、それはパンクだ。待って、あなたは署名します"}, {"type": "subtitle", "time": 3802.95, "timestamp": "01:03:22", "text": "契約？うん。まるで"}, {"type": "subtitle", "time": 3805.51, "timestamp": "01:03:25", "text": "まるでファンタジーのように、私はサインのように"}, {"type": "subtitle", "time": 3810.23, "timestamp": "01:03:30", "text": "契約。わかった。奴隷協定のために。"}, {"type": "subtitle", "time": 3811.99, "timestamp": "01:03:31", "text": "わかった。"}, {"type": "subtitle", "time": 3815.029, "timestamp": "01:03:35", "text": "それは間違っていますか？"}, {"type": "subtitle", "time": 3819.27, "timestamp": "01:03:39", "text": "えっと、つまり、あなた自身が署名するということです。"}, {"type": "subtitle", "time": 3822.109, "timestamp": "01:03:42", "text": "両当事者が署名する。"}, {"type": "subtitle", "time": 3825.27, "timestamp": "01:03:45", "text": "おお。わかった。何てことだ。"}, {"type": "subtitle", "time": 3827.029, "timestamp": "01:03:47", "text": "これは紛らわしい。つまり、"}, {"type": "subtitle", "time": 3829.309, "timestamp": "01:03:49", "text": "お互いの同意もすべて揃っている。いいえ。"}, {"type": "subtitle", "time": 3833.67, "timestamp": "01:03:53", "text": "つまり、両当事者は契約に同意し、"}, {"type": "subtitle", "time": 3836.789, "timestamp": "01:03:56", "text": "すべて、でもそれが強制されているようなら、"}, {"type": "subtitle", "time": 3839.43, "timestamp": "01:03:59", "text": "もしその人が署名を強制された場合、"}]
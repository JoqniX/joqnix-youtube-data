[{"type": "subtitle", "time": 9661.11, "timestamp": "02:41:01", "text": "ストリーム？ああ、いいよ。それはいいです。私はしません"}, {"type": "subtitle", "time": 9663.349, "timestamp": "02:41:03", "text": "理解する。それで、ある男がいて、"}, {"type": "subtitle", "time": 9665.429, "timestamp": "02:41:05", "text": "右？"}, {"type": "subtitle", "time": 9669.83, "timestamp": "02:41:09", "text": "えっと、彼は私を、えっと、彼が"}, {"type": "subtitle", "time": 9671.87, "timestamp": "02:41:11", "text": "言ったように"}, {"type": "subtitle", "time": 9674.15, "timestamp": "02:41:14", "text": "基本的に子供の頃は"}, {"type": "subtitle", "time": 9676.71, "timestamp": "02:41:16", "text": "混乱した。 「それで、あなたのお母さんは"}, {"type": "subtitle", "time": 9678.389, "timestamp": "02:41:18", "text": "お母さんが持っていないような膣がない"}, {"type": "subtitle", "time": 9680.71, "timestamp": "02:41:20", "text": "膣を持っていますか？えっと、どうしたの？のように、"}, {"type": "subtitle", "time": 9682.87, "timestamp": "02:41:22", "text": "これは一体何ですか？例えば、あなたの"}, {"type": "subtitle", "time": 9686.15, "timestamp": "02:41:26", "text": "お母さんの膣。"}, {"type": "subtitle", "time": 9688.07, "timestamp": "02:41:28", "text": "例えば、あなたのお母さんは、"}, {"type": "subtitle", "time": 9695.91, "timestamp": "02:41:35", "text": "彼はただそれを指摘しているだけだ。私はしませんでした"}, {"type": "subtitle", "time": 9706.95, "timestamp": "02:41:46", "text": "うん。彼はただ死体を指差しているだけだ"}, {"type": "subtitle", "time": 9709.11, "timestamp": "02:41:49", "text": "あなたのお母さんの一部。あなたはただ、"}, {"type": "subtitle", "time": 9711.9, "timestamp": "02:41:51", "text": "「え？どういうことだよ？」"}, {"type": "subtitle", "time": 9714.19, "timestamp": "02:41:54", "text": "[音楽]"}, {"type": "subtitle", "time": 9717.83, "timestamp": "02:41:57", "text": "例えばバハランのようなアガリは、"}]
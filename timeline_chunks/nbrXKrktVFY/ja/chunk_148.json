[{"type": "subtitle", "time": 8880.07, "timestamp": "02:28:00", "text": "4chan。もう何十年も経ったような気がする。"}, {"type": "subtitle", "time": 8881.75, "timestamp": "02:28:01", "text": "なぜ人々がこのウェブサイトを嫌うのか私にはわからない"}, {"type": "subtitle", "time": 8885.83, "timestamp": "02:28:05", "text": "そんなに。うん、まるで"}, {"type": "subtitle", "time": 8888.55, "timestamp": "02:28:08", "text": "4chanから起こった最悪の出来事。"}, {"type": "subtitle", "time": 8889.99, "timestamp": "02:28:09", "text": "人々はそれを嫌う。でも私は「わかった、"}, {"type": "subtitle", "time": 8892.15, "timestamp": "02:28:12", "text": "「これらのものはどうですか？」ああ、あれらは"}, {"type": "subtitle", "time": 8894.469, "timestamp": "02:28:14", "text": "それらも良いものです。"}, {"type": "subtitle", "time": 8896.23, "timestamp": "02:28:16", "text": "彼らは「ああ、多すぎる」と言う"}, {"type": "subtitle", "time": 8898.75, "timestamp": "02:28:18", "text": "戦争犯罪を犯した"}, {"type": "subtitle", "time": 8905.51, "timestamp": "02:28:25", "text": "わかった。例えば、私がこれらと交流するとき"}, {"type": "subtitle", "time": 8909.67, "timestamp": "02:28:29", "text": "特定の2つの見解のようなものですよね？"}, {"type": "subtitle", "time": 8915.11, "timestamp": "02:28:35", "text": "何か言うだろう、なぜ"}, {"type": "subtitle", "time": 8917.91, "timestamp": "02:28:37", "text": "あなたはそう言いますか？"}, {"type": "subtitle", "time": 8920.309, "timestamp": "02:28:40", "text": "オーケー、ジョー、私は行きたくない"}, {"type": "subtitle", "time": 8923.15, "timestamp": "02:28:43", "text": "まるで男みたいに"}, {"type": "subtitle", "time": 8927.11, "timestamp": "02:28:47", "text": "本当にナルシストだよね？のように"}, {"type": "subtitle", "time": 8929.349, "timestamp": "02:28:49", "text": "なぜ私のチャットを読んでくれなかったのですか？ない"}, {"type": "subtitle", "time": 8930.67, "timestamp": "02:28:50", "text": "1つ"}, {"type": "subtitle", "time": 8932.95, "timestamp": "02:28:52", "text": "ここ。私はカミングアウトしたくない"}, {"type": "subtitle", "time": 8934.87, "timestamp": "02:28:54", "text": "それ。でもそれは一部のユーチューバーのように"}, {"type": "subtitle", "time": 8938.469, "timestamp": "02:28:58", "text": "会社で偉い人であるかのように振る舞う"}]
[{"type": "subtitle", "time": 13741.07, "timestamp": "03:49:01", "text": "待って、彼は完全に完全に"}, {"type": "subtitle", "time": 13743.91, "timestamp": "03:49:03", "text": "今すぐ卒業するの？それともこれから卒業するの？"}, {"type": "subtitle", "time": 13747.349, "timestamp": "03:49:07", "text": "ああ、待って。見逃したのかな？私は思う"}, {"type": "subtitle", "time": 13749.99, "timestamp": "03:49:09", "text": "見逃した。待って、"}, {"type": "subtitle", "time": 13752.55, "timestamp": "03:49:12", "text": "待って。グーラがなぜグーラなのか、あなたは知っていますか？"}, {"type": "subtitle", "time": 13754.95, "timestamp": "03:49:14", "text": "卒業した？"}, {"type": "subtitle", "time": 13759.75, "timestamp": "03:49:19", "text": "健康上の理由と会社の都合で"}, {"type": "subtitle", "time": 13762.87, "timestamp": "03:49:22", "text": "不一致の件。ええ、そういう感じでした"}, {"type": "subtitle", "time": 13764.71, "timestamp": "03:49:24", "text": "理由。しかし、もうひとつ"}, {"type": "subtitle", "time": 13768.71, "timestamp": "03:49:28", "text": "理由は、トップストリーマーになることだった"}, {"type": "subtitle", "time": 13772.79, "timestamp": "03:49:32", "text": "彼女は動揺していた。ああ、まるで彼女が"}, {"type": "subtitle", "time": 13776.229, "timestamp": "03:49:36", "text": "業界標準としてはトップクラスの"}, {"type": "subtitle", "time": 13778.63, "timestamp": "03:49:38", "text": "食物連鎖。彼女が"}, {"type": "subtitle", "time": 13780.309, "timestamp": "03:49:40", "text": "パニック発作。彼女はまるで"}, {"type": "subtitle", "time": 13782.79, "timestamp": "03:49:42", "text": "彼女は何をするにも神経質だった。"}, {"type": "subtitle", "time": 13789.349, "timestamp": "03:49:49", "text": "だから、それが、それが1つだった理由です"}, {"type": "subtitle", "time": 13791.51, "timestamp": "03:49:51", "text": "理由の1つ。"}, {"type": "subtitle", "time": 13793.91, "timestamp": "03:49:53", "text": "うん。彼女はただおかしなサメになりたかっただけ"}, {"type": "subtitle", "time": 13796.55, "timestamp": "03:49:56", "text": "女の子。彼女は"}, {"type": "subtitle", "time": 13799.67, "timestamp": "03:49:59", "text": "VTuber界の頂点。"}]
[{"type": "subtitle", "time": 5701.75, "timestamp": "01:35:01", "text": "でも、わからないけど、私は大丈夫"}, {"type": "subtitle", "time": 5705.35, "timestamp": "01:35:05", "text": "食べ慣れていないから食べない"}, {"type": "subtitle", "time": 5708.79, "timestamp": "01:35:08", "text": "その風味と味は、私にはないから"}, {"type": "subtitle", "time": 5710.79, "timestamp": "01:35:10", "text": "蜂蜜がいっぱい。私は蜂蜜が大好きです。私は文字通り"}, {"type": "subtitle", "time": 5712.95, "timestamp": "01:35:12", "text": "私の隣には蜂蜜のボトルが2本あります。"}, {"type": "subtitle", "time": 5716.87, "timestamp": "01:35:16", "text": "何？ええ、私は蜂蜜をかけるのが好きです。だから、"}, {"type": "subtitle", "time": 5719.99, "timestamp": "01:35:19", "text": "私は牛乳を飲むのが好きで、"}, {"type": "subtitle", "time": 5721.99, "timestamp": "01:35:21", "text": "牛乳を持ってきてください、私もいくつか持っています"}, {"type": "subtitle", "time": 5723.99, "timestamp": "01:35:23", "text": "私のキッチンにも蜂蜜の瓶があります。しかし"}, {"type": "subtitle", "time": 5726.709, "timestamp": "01:35:26", "text": "時々、蜂蜜を入れるのを忘れてしまうことがあります。だから私は"}, {"type": "subtitle", "time": 5730.07, "timestamp": "01:35:30", "text": "部屋に予備のボトルがあります。"}, {"type": "subtitle", "time": 5732.229, "timestamp": "01:35:32", "text": "だから、もし忘れても、戻る必要はない"}, {"type": "subtitle", "time": 5734.229, "timestamp": "01:35:34", "text": "キッチンへ。"}, {"type": "subtitle", "time": 5736.87, "timestamp": "01:35:36", "text": "ああ、それはとても便利だ。"}, {"type": "subtitle", "time": 5740.07, "timestamp": "01:35:40", "text": "私の両親は私がとても怠け者だと言う"}, {"type": "subtitle", "time": 5741.99, "timestamp": "01:35:41", "text": "彼らがなぜそうだったかのようなやり方で物事を行う"}, {"type": "subtitle", "time": 5745.35, "timestamp": "01:35:45", "text": "あなたならそうしますか？私はプラスチック製のフォークを持っています"}, {"type": "subtitle", "time": 5748.149, "timestamp": "01:35:48", "text": "私の戸棚の中に。だからフォークを忘れたら"}, {"type": "subtitle", "time": 5751.91, "timestamp": "01:35:51", "text": "持っています。私はいつも私はいつも私は"}, {"type": "subtitle", "time": 5753.27, "timestamp": "01:35:53", "text": "常に水筒を持ち歩く"}, {"type": "subtitle", "time": 5756.149, "timestamp": "01:35:56", "text": "1リットルと、その隣にはもう1リットル"}, {"type": "subtitle", "time": 5759.11, "timestamp": "01:35:59", "text": "3リットル入りのボトル。だから私は持っていない"}]
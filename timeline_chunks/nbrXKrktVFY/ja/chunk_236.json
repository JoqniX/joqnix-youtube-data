[{"type": "subtitle", "time": 14162.55, "timestamp": "03:56:02", "text": "数分で、私は起きているのか、それとも"}, {"type": "subtitle", "time": 14164.15, "timestamp": "03:56:04", "text": "私は夢でも見ているのでしょうか？"}, {"type": "subtitle", "time": 14165.91, "timestamp": "03:56:05", "text": "彼女は吠え始めるので、私は「何？」と思う"}, {"type": "subtitle", "time": 14171.67, "timestamp": "03:56:11", "text": "私？彼女は今も同じように考えているが"}, {"type": "subtitle", "time": 14174.469, "timestamp": "03:56:14", "text": "彼女は今、わめき散らして何かを言うだろう"}, {"type": "subtitle", "time": 14176.189, "timestamp": "03:56:16", "text": "あなたを目覚めさせる"}, {"type": "subtitle", "time": 14178.55, "timestamp": "03:56:18", "text": "上。目を覚ませ。あなたは"}, {"type": "subtitle", "time": 14188.75, "timestamp": "03:56:28", "text": "ええ、彼女もまた頂点のような存在です"}, {"type": "subtitle", "time": 14192.55, "timestamp": "03:56:32", "text": "YouTubeらしいやり方でYouTubeをする。ええ、私は"}, {"type": "subtitle", "time": 14194.389, "timestamp": "03:56:34", "text": "彼女は最初のイアンのような人だと信じたい"}, {"type": "subtitle", "time": 14197.51, "timestamp": "03:56:37", "text": "YouTuber。うん、私も同じ。同じ。なぜなら"}, {"type": "subtitle", "time": 14199.59, "timestamp": "03:56:39", "text": "私にとって、彼女は最初で、私は見つけることができません"}, {"type": "subtitle", "time": 14201.349, "timestamp": "03:56:41", "text": "他にそれをやっていた人。のように"}, {"type": "subtitle", "time": 14203.189, "timestamp": "03:56:43", "text": "人々はアイアンマウスと言いたがるが、彼女は"}, {"type": "subtitle", "time": 14204.189, "timestamp": "03:56:44", "text": "そうではなかった"}, {"type": "subtitle", "time": 14209.269, "timestamp": "03:56:49", "text": "彼女はあなたが言うような人ではなかった"}, {"type": "subtitle", "time": 14211.07, "timestamp": "03:56:51", "text": "外に。"}, {"type": "subtitle", "time": 14213.75, "timestamp": "03:56:53", "text": "うん。まるで彼女はただ"}, {"type": "subtitle", "time": 14216.309, "timestamp": "03:56:56", "text": "長い間。"}, {"type": "subtitle", "time": 14217.59, "timestamp": "03:56:57", "text": "だから人々は「ああ、"}, {"type": "subtitle", "time": 14219.59, "timestamp": "03:56:59", "text": "キズナは最初のユーチューバーではない"}]
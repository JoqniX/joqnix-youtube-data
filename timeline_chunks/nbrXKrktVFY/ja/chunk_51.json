[{"type": "subtitle", "time": 3062.47, "timestamp": "00:51:02", "text": "匂い。そこで私はこの実験を行った。の"}, {"type": "subtitle", "time": 3065.069, "timestamp": "00:51:05", "text": "答えは2です"}, {"type": "subtitle", "time": 3067.589, "timestamp": "00:51:07", "text": "数週間。 2週間経っても悪臭がする。後"}, {"type": "subtitle", "time": 3072.63, "timestamp": "00:51:12", "text": "それが消えるか、あなたが慣れるでしょう。"}, {"type": "subtitle", "time": 3075.589, "timestamp": "00:51:15", "text": "うん。だから彼がそう言ったとき私は"}, {"type": "subtitle", "time": 3078.15, "timestamp": "00:51:18", "text": "なんだか自分の主張が認められたような気がする。誰か"}, {"type": "subtitle", "time": 3088.71, "timestamp": "00:51:28", "text": "そして、私がどうするかわかりません"}, {"type": "subtitle", "time": 3091.75, "timestamp": "00:51:31", "text": "そういうことがあって、私は「あぁ、それって普通だよね」って思った"}, {"type": "subtitle", "time": 3093.109, "timestamp": "00:51:33", "text": "そして友達に聞くと、彼らはこう言う"}, {"type": "subtitle", "time": 3094.75, "timestamp": "00:51:34", "text": "ああ、あなたは"}, {"type": "subtitle", "time": 3097.67, "timestamp": "00:51:37", "text": "バカみたいにPCを使ってたんだけど"}, {"type": "subtitle", "time": 3101.27, "timestamp": "00:51:41", "text": "この新しいモニターには、"}, {"type": "subtitle", "time": 3105.19, "timestamp": "00:51:45", "text": "えーと、リフレッシュレートが80くらいだったんだけど、"}, {"type": "subtitle", "time": 3107.19, "timestamp": "00:51:47", "text": "音量を上げなきゃいけないってわかってるよ"}, {"type": "subtitle", "time": 3113.27, "timestamp": "00:51:53", "text": "私の友達はオレンジみたいだった。私たちは"}, {"type": "subtitle", "time": 3114.87, "timestamp": "00:51:54", "text": "何かをしていたので、私は"}, {"type": "subtitle", "time": 3116.47, "timestamp": "00:51:56", "text": "わからないよ、僕の両方のモニターは"}, {"type": "subtitle", "time": 3118.309, "timestamp": "00:51:58", "text": "同じように見え、そうあるべきである"}]
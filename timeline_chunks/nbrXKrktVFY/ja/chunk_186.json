[{"type": "subtitle", "time": 11160.87, "timestamp": "03:06:00", "text": "良いキャラクターたち"}, {"type": "subtitle", "time": 11163.99, "timestamp": "03:06:03", "text": "非常に良く書かれている"}, {"type": "subtitle", "time": 11173.59, "timestamp": "03:06:13", "text": "だから、人が「ああ」と言うのは良くないと思った"}, {"type": "subtitle", "time": 11176.79, "timestamp": "03:06:16", "text": "近親相姦は、例えば頭が似ているようなものです"}, {"type": "subtitle", "time": 11180.87, "timestamp": "03:06:20", "text": "あろマンガ先生。うん。右。アロマンガ"}, {"type": "subtitle", "time": 11187.269, "timestamp": "03:06:27", "text": "それらは良いアニメです。彼らはそうだと思います"}, {"type": "subtitle", "time": 11188.87, "timestamp": "03:06:28", "text": "それらは良いアニメです。それらは書かれている"}, {"type": "subtitle", "time": 11190.19, "timestamp": "03:06:30", "text": "良い。彼らです"}, {"type": "subtitle", "time": 11192.87, "timestamp": "03:06:32", "text": "面白い話があるみたい"}, {"type": "subtitle", "time": 11195.03, "timestamp": "03:06:35", "text": "教えて。右。"}, {"type": "subtitle", "time": 11198.03, "timestamp": "03:06:38", "text": "うん。そして私は感じた"}, {"type": "subtitle", "time": 11201.91, "timestamp": "03:06:41", "text": "ストーリーを認めないというのは"}, {"type": "subtitle", "time": 11204.23, "timestamp": "03:06:44", "text": "従わないから良い"}, {"type": "subtitle", "time": 11205.389, "timestamp": "03:06:45", "text": "文化の"}, {"type": "subtitle", "time": 11209.59, "timestamp": "03:06:49", "text": "ノーマルは悪かった。それで私は一種の"}, {"type": "subtitle", "time": 11212.23, "timestamp": "03:06:52", "text": "私がその男になった皮肉なビデオ"}]
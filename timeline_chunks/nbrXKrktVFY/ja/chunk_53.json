[{"type": "subtitle", "time": 3181.27, "timestamp": "00:53:01", "text": "壊れています。つまり、"}, {"type": "subtitle", "time": 3189.27, "timestamp": "00:53:09", "text": "彼女は「オレンジ、お願いだから直して」って感じ"}, {"type": "subtitle", "time": 3191.349, "timestamp": "00:53:11", "text": "修理するはずだった男が"}, {"type": "subtitle", "time": 3193.75, "timestamp": "00:53:13", "text": "冷蔵庫、今日は日曜日なので、"}, {"type": "subtitle", "time": 3195.91, "timestamp": "00:53:15", "text": "直せない。そして私たちは"}, {"type": "subtitle", "time": 3199.109, "timestamp": "00:53:19", "text": "冷蔵庫を待つと"}, {"type": "subtitle", "time": 3201.03, "timestamp": "00:53:21", "text": "明日になれば、それらは腐ってしまうだろう。その"}, {"type": "subtitle", "time": 3203.349, "timestamp": "00:53:23", "text": "ちょっと値段が高い。それで、直せますか？"}, {"type": "subtitle", "time": 3205.91, "timestamp": "00:53:25", "text": "私は「わかった」って感じだった。それで、私はそこへ行ったんです"}, {"type": "subtitle", "time": 3207.829, "timestamp": "00:53:27", "text": "そして全てを解決した。どうやら、"}, {"type": "subtitle", "time": 3209.91, "timestamp": "00:53:29", "text": "それは壊れていなかった。ちょうど"}, {"type": "subtitle", "time": 3213.03, "timestamp": "00:53:33", "text": "切断されたワイヤーの一部が切断されました"}, {"type": "subtitle", "time": 3215.95, "timestamp": "00:53:35", "text": "ネズミから。だから私はただ交換するだけです"}, {"type": "subtitle", "time": 3219.67, "timestamp": "00:53:39", "text": "ワイヤー。再び動き出した。"}, {"type": "subtitle", "time": 3225.43, "timestamp": "00:53:45", "text": "そして、私も修理できます。"}, {"type": "subtitle", "time": 3228.15, "timestamp": "00:53:48", "text": "電話、壊れた電話を売って"}, {"type": "subtitle", "time": 3232.79, "timestamp": "00:53:52", "text": "まるで副業みたいな感じだった。"}, {"type": "subtitle", "time": 3235.03, "timestamp": "00:53:55", "text": "うん。ほら、2000年代の頃"}, {"type": "subtitle", "time": 3236.95, "timestamp": "00:53:56", "text": "電話にバッテリーが付いていた頃"}]
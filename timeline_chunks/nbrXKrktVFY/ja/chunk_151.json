[{"type": "subtitle", "time": 9067.59, "timestamp": "02:31:07", "text": "でも、彼が話していたように"}, {"type": "subtitle", "time": 9069.99, "timestamp": "02:31:09", "text": "彼らが観客を引きつけないところが面白い。"}, {"type": "subtitle", "time": 9073.349, "timestamp": "02:31:13", "text": "聴衆が愚かなとき。"}, {"type": "subtitle", "time": 9075.99, "timestamp": "02:31:15", "text": "まるで私の聴衆ではないかのように、彼らは"}, {"type": "subtitle", "time": 9077.389, "timestamp": "02:31:17", "text": "完全に"}, {"type": "subtitle", "time": 9081.75, "timestamp": "02:31:21", "text": "無実の。いや、そうじゃないよ。"}, {"type": "subtitle", "time": 9083.99, "timestamp": "02:31:23", "text": "アスミンがチャットでやっていることの一つは、"}, {"type": "subtitle", "time": 9087.67, "timestamp": "02:31:27", "text": "私が気に入っているのは、みんなが扱われることです"}, {"type": "subtitle", "time": 9089.59, "timestamp": "02:31:29", "text": "別々に、まるで別々であるかのように"}, {"type": "subtitle", "time": 9091.99, "timestamp": "02:31:31", "text": "人。"}, {"type": "subtitle", "time": 9094.27, "timestamp": "02:31:34", "text": "彼は集団的な巣を好まない"}, {"type": "subtitle", "time": 9097.19, "timestamp": "02:31:37", "text": "心。ああ、"}, {"type": "subtitle", "time": 9098.95, "timestamp": "02:31:38", "text": "私はビートルズのようにそれが好きなんです"}, {"type": "subtitle", "time": 9100.71, "timestamp": "02:31:40", "text": "チャットです。それはまるで"}, {"type": "subtitle", "time": 9103.27, "timestamp": "02:31:43", "text": "群れ。私は集合意識が好きです"}, {"type": "subtitle", "time": 9106.51, "timestamp": "02:31:46", "text": "状況。群れのように"}, {"type": "subtitle", "time": 9111.03, "timestamp": "02:31:51", "text": "とても愛らしい。うん。つまり、"}, {"type": "subtitle", "time": 9113.75, "timestamp": "02:31:53", "text": "運送業者とか色々あるけど、それでもね。はい。はい。"}, {"type": "subtitle", "time": 9115.03, "timestamp": "02:31:55", "text": "配送業者も好きです。"}, {"type": "subtitle", "time": 9118.07, "timestamp": "02:31:58", "text": "彼らは面白い。"}, {"type": "subtitle", "time": 9119.389, "timestamp": "02:31:59", "text": "しかし"}]
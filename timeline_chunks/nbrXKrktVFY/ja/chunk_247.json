[{"type": "subtitle", "time": 14823.469, "timestamp": "04:07:03", "text": "いつか私は"}, {"type": "subtitle", "time": 14827.429, "timestamp": "04:07:07", "text": "でも、えっと、最近私が"}, {"type": "subtitle", "time": 14830.91, "timestamp": "04:07:10", "text": "昔の自分の気持ちと同じように感じる"}, {"type": "subtitle", "time": 14834.79, "timestamp": "04:07:14", "text": "インドのバイイングが大きくなるときのように"}, {"type": "subtitle", "time": 14837.11, "timestamp": "04:07:17", "text": "あるいは何か、あるいは私がインド料理を欲しかったように"}, {"type": "subtitle", "time": 14841.83, "timestamp": "04:07:21", "text": "競い合うことは、"}, {"type": "subtitle", "time": 14844.389, "timestamp": "04:07:24", "text": "継続またはより良くまたは"}, {"type": "subtitle", "time": 14847.67, "timestamp": "04:07:27", "text": "拡張版のようなもの"}, {"type": "subtitle", "time": 14850.71, "timestamp": "04:07:30", "text": "外国の、いや、西洋のユーチュービングと"}, {"type": "subtitle", "time": 14853.349, "timestamp": "04:07:33", "text": "JPチューブを一緒に使うのはどうですか？"}, {"type": "subtitle", "time": 14856.469, "timestamp": "04:07:36", "text": "一般化されたチューブは正しい"}, {"type": "subtitle", "time": 14859.11, "timestamp": "04:07:39", "text": "私はそれが欲しかった、私はそれが欲しかったと思った"}, {"type": "subtitle", "time": 14862.95, "timestamp": "04:07:42", "text": "ここへ来るのは、ほら、"}, {"type": "subtitle", "time": 14865.03, "timestamp": "04:07:45", "text": "インドのユーチューバーとかそういう人たち"}, {"type": "subtitle", "time": 14867.189, "timestamp": "04:07:47", "text": "昔のほとんどの人と同じように"}, {"type": "subtitle", "time": 14869.67, "timestamp": "04:07:49", "text": "そして彼らが昔やっていた有害なもの"}, {"type": "subtitle", "time": 14871.309, "timestamp": "04:07:51", "text": "そういう類のもの"}, {"type": "subtitle", "time": 14875.59, "timestamp": "04:07:55", "text": "コンテンツフォームのように、ほとんどの人が"}, {"type": "subtitle", "time": 14878.55, "timestamp": "04:07:58", "text": "以前は特定のものを見るのを避けていた"}]
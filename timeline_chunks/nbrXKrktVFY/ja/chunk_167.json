[{"type": "subtitle", "time": 10022.95, "timestamp": "02:47:02", "text": "ええ、そうですね。もし私が"}, {"type": "subtitle", "time": 10024.389, "timestamp": "02:47:04", "text": "別の言語を学ぶと、おそらく"}, {"type": "subtitle", "time": 10026.429, "timestamp": "02:47:06", "text": "日本人になる、それは"}, {"type": "subtitle", "time": 10030.83, "timestamp": "02:47:10", "text": "私の好きなものって何？ 5番目の言語、4番目。"}, {"type": "subtitle", "time": 10033.75, "timestamp": "02:47:13", "text": "ああ、あなたは全部でいくつの言語を話せますか？"}, {"type": "subtitle", "time": 10036.95, "timestamp": "02:47:16", "text": "知る？私はウドゥ語、ヒンディー語、少し"}, {"type": "subtitle", "time": 10041.15, "timestamp": "02:47:21", "text": "ベンガル語。友人たちに感謝します。"}, {"type": "subtitle", "time": 10045.269, "timestamp": "02:47:25", "text": "ああ、ヒンディー語、ウドゥー語、ベンガル語、英語。"}, {"type": "subtitle", "time": 10048.07, "timestamp": "02:47:28", "text": "日本語は少しだけ知っています"}, {"type": "subtitle", "time": 10054.15, "timestamp": "02:47:34", "text": "ルイスのやつだよ、知ってるだろ？"}, {"type": "subtitle", "time": 10057.99, "timestamp": "02:47:37", "text": "チップをチップに渡すのが好きでした。そうそう。私は見た"}, {"type": "subtitle", "time": 10059.83, "timestamp": "02:47:39", "text": "すべて知っていたし、彼が"}, {"type": "subtitle", "time": 10061.309, "timestamp": "02:47:41", "text": "何かを言っていた"}, {"type": "subtitle", "time": 10065.34, "timestamp": "02:47:45", "text": "間違っている。だから私は私より優れている"}, {"type": "subtitle", "time": 10067.23, "timestamp": "02:47:47", "text": "[音楽]"}, {"type": "subtitle", "time": 10070.11, "timestamp": "02:47:50", "text": "ルウィグと"}, {"type": "subtitle", "time": 10073.99, "timestamp": "02:47:53", "text": "えっと、ドイツ語は少し知っていると思います。"}, {"type": "subtitle", "time": 10075.67, "timestamp": "02:47:55", "text": "少し。"}, {"type": "subtitle", "time": 10077.99, "timestamp": "02:47:57", "text": "では、それはいくつになるのでしょうか？"}]
[{"type": "subtitle", "time": 5160.07, "timestamp": "01:26:00", "text": "つまり、あなたは基本的に存在しないということです。"}, {"type": "subtitle", "time": 5166.31, "timestamp": "01:26:06", "text": "それが私が"}, {"type": "subtitle", "time": 5168.149, "timestamp": "01:26:08", "text": "嫌いになり始めた、えっと、食べる"}, {"type": "subtitle", "time": 5170.31, "timestamp": "01:26:10", "text": "食事の過程"}, {"type": "subtitle", "time": 5172.629, "timestamp": "01:26:12", "text": "両親が私に食べさせたから"}, {"type": "subtitle", "time": 5174.87, "timestamp": "01:26:14", "text": "祖父母は私に無理やり食べさせた"}, {"type": "subtitle", "time": 5184.629, "timestamp": "01:26:24", "text": "それで、だんだん食べることに飽きてしまったんです。おお"}, {"type": "subtitle", "time": 5188.07, "timestamp": "01:26:28", "text": "いいえ。もしそれが理にかなうなら。うん。今私は"}, {"type": "subtitle", "time": 5191.75, "timestamp": "01:26:31", "text": "栄養分だけを求めて食べる。"}, {"type": "subtitle", "time": 5193.91, "timestamp": "01:26:33", "text": "普段は特に何かを欲しがることはありません。私はただ"}, {"type": "subtitle", "time": 5205.27, "timestamp": "01:26:45", "text": "嫌いな食べ物はありますか？"}, {"type": "subtitle", "time": 5207.87, "timestamp": "01:26:47", "text": "子供の頃は、"}, {"type": "subtitle", "time": 5211.43, "timestamp": "01:26:51", "text": "嫌いなもの。私は何でも食べます。"}, {"type": "subtitle", "time": 5214.39, "timestamp": "01:26:54", "text": "さあ行こう。私も。私のお気に入りのように"}, {"type": "subtitle", "time": 5217.27, "timestamp": "01:26:57", "text": "食べ物は親を"}, {"type": "subtitle", "time": 5219.189, "timestamp": "01:26:59", "text": "質問ですが、彼らは子育てをきちんとしているのでしょうか？"}]
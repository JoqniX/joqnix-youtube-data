[{"type": "subtitle", "time": 5885.59, "timestamp": "01:38:05", "text": "ただの砂糖。ああ、ということはあなたはお酒を飲むんですね"}, {"type": "subtitle", "time": 5890.229, "timestamp": "01:38:10", "text": "プロテインシェイクとかそういう類。うん。ああ、私は"}, {"type": "subtitle", "time": 5891.99, "timestamp": "01:38:11", "text": "プロテインパウダーを飲むだけでいい。それが私の"}, {"type": "subtitle", "time": 5893.99, "timestamp": "01:38:13", "text": "今すぐソーダを。"}, {"type": "subtitle", "time": 5901.109, "timestamp": "01:38:21", "text": "それと、ちょっと変わった質問をしたいのですが。する"}, {"type": "subtitle", "time": 5903.35, "timestamp": "01:38:23", "text": "あなたは虫が嫌いなの？"}, {"type": "subtitle", "time": 5911.669, "timestamp": "01:38:31", "text": "私がなぜそれを尋ねたかというと、"}, {"type": "subtitle", "time": 5914.47, "timestamp": "01:38:34", "text": "今、私の部屋にゴキブリがいます。私は愛する"}, {"type": "subtitle", "time": 5917.51, "timestamp": "01:38:37", "text": "ゴキブリ。とてもかわいいですね。うん。私"}, {"type": "subtitle", "time": 5919.51, "timestamp": "01:38:39", "text": "殺す代わりに、私はただ"}, {"type": "subtitle", "time": 5921.669, "timestamp": "01:38:41", "text": "見てただけだよ、ほら、動いて"}, {"type": "subtitle", "time": 5924.709, "timestamp": "01:38:44", "text": "その周り。私は本当に腹が立った"}, {"type": "subtitle", "time": 5926.79, "timestamp": "01:38:46", "text": "子供の頃、一度だけ、"}, {"type": "subtitle", "time": 5929.109, "timestamp": "01:38:49", "text": "昔は昆虫が大好きだったよね？ M のように"}, {"type": "subtitle", "time": 5930.79, "timestamp": "01:38:50", "text": "子供は、かわいい小さな"}, {"type": "subtitle", "time": 5932.709, "timestamp": "01:38:52", "text": "動いたものを見て、私は「なんてこった」と思いました"}, {"type": "subtitle", "time": 5935.35, "timestamp": "01:38:55", "text": "彼らは本当にクールだ。それらは小さな"}, {"type": "subtitle", "time": 5939.43, "timestamp": "01:38:59", "text": "自力で動くことができるおもちゃ。うん。"}]
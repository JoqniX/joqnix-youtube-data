[{"type": "subtitle", "time": 12540.07, "timestamp": "03:29:00", "text": "これも大嫌い。彼らがそうするように"}, {"type": "subtitle", "time": 12543.429, "timestamp": "03:29:03", "text": "Z世代を加えるためにこれを指摘する"}, {"type": "subtitle", "time": 12545.469, "timestamp": "03:29:05", "text": "言語または追加のようなもの"}, {"type": "subtitle", "time": 12549.03, "timestamp": "03:29:09", "text": "スラングを吹き替えに取り入れる。"}, {"type": "subtitle", "time": 12550.79, "timestamp": "03:29:10", "text": "彼らはただそれをダビングするだけだ。しないで"}, {"type": "subtitle", "time": 12566.99, "timestamp": "03:29:26", "text": "ええ、どうぞ。そしてこれらと同じように"}, {"type": "subtitle", "time": 12570.229, "timestamp": "03:29:30", "text": "インドのファンは"}, {"type": "subtitle", "time": 12572.71, "timestamp": "03:29:32", "text": "アニメについて説明してください。あれら見た？"}, {"type": "subtitle", "time": 12576.15, "timestamp": "03:29:36", "text": "解説動画？うん。彼らが"}, {"type": "subtitle", "time": 12577.99, "timestamp": "03:29:37", "text": "エピソードの内容を説明します"}, {"type": "subtitle", "time": 12582.229, "timestamp": "03:29:42", "text": "そのエピソードの中で。うん。そして私はただ"}, {"type": "subtitle", "time": 12584.229, "timestamp": "03:29:44", "text": "そのエピソードを見てください。一体なぜ"}, {"type": "subtitle", "time": 12585.79, "timestamp": "03:29:45", "text": "あなたには"}, {"type": "chat", "time": 12588.483, "timestamp": "03:29:48", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "that's a whole another thing"}, {"type": "subtitle", "time": 12588.51, "timestamp": "03:29:48", "text": "説明？"}, {"type": "chat", "time": 12593.569, "timestamp": "03:29:53", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "☠😭"}]
[{"type": "subtitle", "time": 12601.51, "timestamp": "03:30:01", "text": "こんなことを想像するのは好きじゃない。見て"}, {"type": "subtitle", "time": 12603.11, "timestamp": "03:30:03", "text": "何かがあって、それから誰かが"}, {"type": "subtitle", "time": 12606.429, "timestamp": "03:30:06", "text": "説明しましょう。あなたは何者ですか"}, {"type": "subtitle", "time": 12609.91, "timestamp": "03:30:09", "text": "見ている？なぜ？私自身もそれを見ました"}, {"type": "subtitle", "time": 12611.43, "timestamp": "03:30:11", "text": "目。"}, {"type": "subtitle", "time": 12614.63, "timestamp": "03:30:14", "text": "[音楽]"}, {"type": "subtitle", "time": 12627.67, "timestamp": "03:30:27", "text": "自分？しかし、これらは一つのことです"}, {"type": "subtitle", "time": 12629.349, "timestamp": "03:30:29", "text": "私はそれが好きではありません。そして彼らは"}, {"type": "subtitle", "time": 12631.99, "timestamp": "03:30:31", "text": "まるでそれが優れた方法であるかのように振る舞う"}, {"type": "subtitle", "time": 12634.44, "timestamp": "03:30:34", "text": "何らかの理由でそれを見てください。"}, {"type": "subtitle", "time": 12636.229, "timestamp": "03:30:36", "text": "[音楽]"}, {"type": "subtitle", "time": 12638.15, "timestamp": "03:30:38", "text": "そして彼らはそれをとても単純化しているので、子供たちは"}, {"type": "subtitle", "time": 12640.79, "timestamp": "03:30:40", "text": "入り込んでみよう。"}, {"type": "chat", "time": 12642.357, "timestamp": "03:30:42", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "the thing is some people watch that only... not the actually anime"}, {"type": "subtitle", "time": 12642.71, "timestamp": "03:30:42", "text": "うん。"}, {"type": "subtitle", "time": 12644.87, "timestamp": "03:30:44", "text": "あまり好きじゃない。子供たちが見ている"}, {"type": "subtitle", "time": 12648.07, "timestamp": "03:30:48", "text": "チェーンソーは子供向けではないので、怒っている。"}, {"type": "subtitle", "time": 12652.07, "timestamp": "03:30:52", "text": "そうではありません。でも、ほら"}, {"type": "subtitle", "time": 12653.67, "timestamp": "03:30:53", "text": "兄は4歳くらいで、"}, {"type": "subtitle", "time": 12656.229, "timestamp": "03:30:56", "text": "右？"}, {"type": "subtitle", "time": 12659.19, "timestamp": "03:30:59", "text": "彼は私にその伝承の全てを教えてくれる"}]
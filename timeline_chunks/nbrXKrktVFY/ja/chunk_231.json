[{"type": "subtitle", "time": 13861.59, "timestamp": "03:51:01", "text": "真実。またはココ、あなたの"}, {"type": "subtitle", "time": 13868.07, "timestamp": "03:51:08", "text": "ココは裏切られたような気持ちになった。ラシアは感じた"}, {"type": "subtitle", "time": 13870.349, "timestamp": "03:51:10", "text": "車のように"}, {"type": "subtitle", "time": 13873.67, "timestamp": "03:51:13", "text": "クラッシュ。うん。"}, {"type": "subtitle", "time": 13877.269, "timestamp": "03:51:17", "text": "そして私は、その二人のそばにいました。なんてこった。"}, {"type": "subtitle", "time": 13880.229, "timestamp": "03:51:20", "text": "大変だったでしょうね。私も苦しんだことがあります。"}, {"type": "subtitle", "time": 13881.75, "timestamp": "03:51:21", "text": "多くの。"}, {"type": "subtitle", "time": 13884.71, "timestamp": "03:51:24", "text": "何てことだ。中国人がそこにいたとき、私はそこにいました"}, {"type": "subtitle", "time": 13886.229, "timestamp": "03:51:26", "text": "攻撃した。"}, {"type": "subtitle", "time": 13889.75, "timestamp": "03:51:29", "text": "何てことだ。私はチャットに参加していました"}, {"type": "subtitle", "time": 13897.91, "timestamp": "03:51:37", "text": "こんな生活を送るのはとても面白い"}, {"type": "subtitle", "time": 13899.99, "timestamp": "03:51:39", "text": "経験、そしてそれについて考える"}, {"type": "subtitle", "time": 13902.389, "timestamp": "03:51:42", "text": "後になって人生が変わって、"}, {"type": "subtitle", "time": 13904.71, "timestamp": "03:51:44", "text": "聖なる滝 私は自分がそこにいるとは知らなかった"}, {"type": "subtitle", "time": 13912.99, "timestamp": "03:51:52", "text": "私が覚えているイベントのような"}, {"type": "subtitle", "time": 13918.79, "timestamp": "03:51:58", "text": "えっと、ミオの配信だと思う。ミコミコの配信だと思う。"}]
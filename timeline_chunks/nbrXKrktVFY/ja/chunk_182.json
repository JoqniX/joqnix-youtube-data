[{"type": "subtitle", "time": 10920.71, "timestamp": "03:02:00", "text": "nワードの人々と私たちの言葉"}, {"type": "subtitle", "time": 10927.03, "timestamp": "03:02:07", "text": "つまり、私は特定の言葉を口にしないだけです"}, {"type": "subtitle", "time": 10930.87, "timestamp": "03:02:10", "text": "単に、そうする気がしないからです。"}, {"type": "subtitle", "time": 10939.11, "timestamp": "03:02:19", "text": "それに、私は人々と一緒に仕事をしています"}, {"type": "subtitle", "time": 10944.63, "timestamp": "03:02:24", "text": "その人種は誰なのかと思うと、"}, {"type": "subtitle", "time": 10946.469, "timestamp": "03:02:26", "text": "悪い感じがする"}, {"type": "subtitle", "time": 10949.429, "timestamp": "03:02:29", "text": "彼らを傷つける言葉。ええ、そうです"}, {"type": "subtitle", "time": 10956.55, "timestamp": "03:02:36", "text": "それに、そういう人たちも"}, {"type": "subtitle", "time": 10959.309, "timestamp": "03:02:39", "text": "「R」という言葉にいいね"}, {"type": "subtitle", "time": 10962.07, "timestamp": "03:02:42", "text": "そうですね、私はこれまで聞いたことがありません"}, {"type": "subtitle", "time": 10966.55, "timestamp": "03:02:46", "text": "精神的にそういう人ではない人"}, {"type": "subtitle", "time": 10969.03, "timestamp": "03:02:49", "text": "彼らが言うまで使わないように私に言う"}, {"type": "subtitle", "time": 10971.11, "timestamp": "03:02:51", "text": "気に入って使ってください。私はそれを見た"}, {"type": "subtitle", "time": 10978.99, "timestamp": "03:02:58", "text": "つまり、ある時、私はビデオを見たのですが"}]
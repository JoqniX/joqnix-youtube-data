[{"type": "subtitle", "time": 3121.069, "timestamp": "00:52:01", "text": "良くなったと友人のシャミが言った"}, {"type": "subtitle", "time": 3124.23, "timestamp": "00:52:04", "text": "オレンジ色が好きだから、まさかそんなことしないで"}, {"type": "subtitle", "time": 3125.67, "timestamp": "00:52:05", "text": "Swagger Soulsって何？"}, {"type": "subtitle", "time": 3130.79, "timestamp": "00:52:10", "text": "ソウルズ関連の話なので、どうやらスワッガーソウルズらしい。"}, {"type": "subtitle", "time": 3134.39, "timestamp": "00:52:14", "text": "同じことをしたが、忘れてしまった"}, {"type": "subtitle", "time": 3135.91, "timestamp": "00:52:15", "text": "設定から"}, {"type": "subtitle", "time": 3139.03, "timestamp": "00:52:19", "text": "更新頻度を上げる。"}, {"type": "subtitle", "time": 3142.15, "timestamp": "00:52:22", "text": "7ヶ月間使用しています"}, {"type": "subtitle", "time": 3145.75, "timestamp": "00:52:25", "text": "このモニター。 60で使用しています"}, {"type": "subtitle", "time": 3150.069, "timestamp": "00:52:30", "text": "fps。なんてこった。そして、音量を上げて"}, {"type": "subtitle", "time": 3152.549, "timestamp": "00:52:32", "text": "ああ、今は本当に大きな違いがある。"}, {"type": "subtitle", "time": 3162.47, "timestamp": "00:52:42", "text": "そういう類のもの"}, {"type": "subtitle", "time": 3169.67, "timestamp": "00:52:49", "text": "でも、私は全体を修復できる"}, {"type": "subtitle", "time": 3171.27, "timestamp": "00:52:51", "text": "冷蔵庫。どうすればいいのかわからない"}, {"type": "subtitle", "time": 3175.589, "timestamp": "00:52:55", "text": "それ。おお、それはいいですね。"}, {"type": "subtitle", "time": 3177.51, "timestamp": "00:52:57", "text": "うん。友達が一度、"}, {"type": "subtitle", "time": 3179.19, "timestamp": "00:52:59", "text": "電話がかかってきた。彼女はまるで冷蔵庫の中のオレンジみたい"}]
[{"type": "subtitle", "time": 8041.27, "timestamp": "02:14:01", "text": "彼らがいつ"}, {"type": "subtitle", "time": 8042.79, "timestamp": "02:14:02", "text": "いたずら電話。だから、彼らは始めるだろう"}, {"type": "subtitle", "time": 8046.47, "timestamp": "02:14:06", "text": "ローリング。何？彼らは知っている。ええ、彼らは"}, {"type": "subtitle", "time": 8048.47, "timestamp": "02:14:08", "text": "知る。彼らはいたずら電話を頻繁に受ける。"}, {"type": "subtitle", "time": 8049.99, "timestamp": "02:14:09", "text": "時々彼らは、誰があなたを楽しませるのか"}, {"type": "subtitle", "time": 8051.31, "timestamp": "02:14:11", "text": "ユーモアを交え始める"}, {"type": "subtitle", "time": 8053.669, "timestamp": "02:14:13", "text": "なぜなら彼らは悲惨な"}, {"type": "subtitle", "time": 8056.229, "timestamp": "02:14:16", "text": "電話がかかってくるたびに仕事"}, {"type": "subtitle", "time": 8058.31, "timestamp": "02:14:18", "text": "カレンのような人もいて、彼女は文句を言っている"}, {"type": "subtitle", "time": 8060.47, "timestamp": "02:14:20", "text": "彼女のインターネットについて"}, {"type": "subtitle", "time": 8063.35, "timestamp": "02:14:23", "text": "あるいは、彼女が一人でやったことのように、"}, {"type": "subtitle", "time": 8065.189, "timestamp": "02:14:25", "text": "ほとんどは、奥様が電源を切るだけです"}, {"type": "subtitle", "time": 8067.83, "timestamp": "02:14:27", "text": "あなたのものを再起動して、"}, {"type": "subtitle", "time": 8074.55, "timestamp": "02:14:34", "text": "だから彼らはこれらに対処しなければならない"}, {"type": "subtitle", "time": 8076.069, "timestamp": "02:14:36", "text": "人々。だから、いたずら電話をかけて、"}, {"type": "subtitle", "time": 8078.069, "timestamp": "02:14:38", "text": "とにかくとても丁寧に接すれば、彼らは"}, {"type": "subtitle", "time": 8079.83, "timestamp": "02:14:39", "text": "流れに身を任せる"}, {"type": "subtitle", "time": 8081.21, "timestamp": "02:14:41", "text": "あれ"}, {"type": "subtitle", "time": 8082.629, "timestamp": "02:14:42", "text": "[音楽]"}, {"type": "subtitle", "time": 8084.47, "timestamp": "02:14:44", "text": "10回中9回くらいは"}, {"type": "subtitle", "time": 8085.83, "timestamp": "02:14:45", "text": "私がいたずら電話をかけるたびに"}, {"type": "subtitle", "time": 8088.87, "timestamp": "02:14:48", "text": "人々は、ああ、彼らは"}, {"type": "subtitle", "time": 8096.51, "timestamp": "02:14:56", "text": "私は「えっ？」って感じになるでしょう"}, {"type": "subtitle", "time": 8099.35, "timestamp": "02:14:59", "text": "だから、私が彼らに電話するというのは"}]
[{"type": "subtitle", "time": 7501.27, "timestamp": "02:05:01", "text": "あなた自身ですか？君たち、どういう意味？"}, {"type": "subtitle", "time": 7514.47, "timestamp": "02:05:14", "text": "つまり、チャットで誰かがこう言ってるんだ"}, {"type": "subtitle", "time": 7516.91, "timestamp": "02:05:16", "text": "ATALはモバイルにとって良くない"}, {"type": "subtitle", "time": 7520.629, "timestamp": "02:05:20", "text": "データ通信は問題があったが、Wi-Fi接続は良好だった。"}, {"type": "subtitle", "time": 7523.83, "timestamp": "02:05:23", "text": "ええ、つまり、今Wi-Fiは使えるんです"}, {"type": "subtitle", "time": 7525.99, "timestamp": "02:05:25", "text": "繊維のように。"}, {"type": "subtitle", "time": 7527.229, "timestamp": "02:05:27", "text": "それは動作します"}, {"type": "subtitle", "time": 7530.55, "timestamp": "02:05:30", "text": "大丈夫。 H"}, {"type": "subtitle", "time": 7533.75, "timestamp": "02:05:33", "text": "まるで、Jio しかないかのように、"}, {"type": "subtitle", "time": 7537.03, "timestamp": "02:05:37", "text": "アテルと、どうやらジオもいくつか"}, {"type": "subtitle", "time": 7538.51, "timestamp": "02:05:38", "text": "比較すると"}, {"type": "subtitle", "time": 7541.669, "timestamp": "02:05:41", "text": "モバイルのようにWi-Fiは問題なく動作しますが"}, {"type": "subtitle", "time": 7544.95, "timestamp": "02:05:44", "text": "Wi-Fiでは、こんなこっそりしたことをします。"}, {"type": "subtitle", "time": 7547.43, "timestamp": "02:05:47", "text": "ダウンロードのみを提供します"}, {"type": "subtitle", "time": 7551.03, "timestamp": "02:05:51", "text": "アップロード速度ではなく、速度そのもの。ああ、それとそれ"}, {"type": "subtitle", "time": 7553.03, "timestamp": "02:05:53", "text": "それは"}, {"type": "subtitle", "time": 7555.43, "timestamp": "02:05:55", "text": "ええ、それで私は彼らにこのことについて尋ねました。"}, {"type": "subtitle", "time": 7557.83, "timestamp": "02:05:57", "text": "「よし、みんな、私には計画があるんだ」"}]
[{"type": "subtitle", "time": 5340.07, "timestamp": "01:29:00", "text": "私には理解できない。"}, {"type": "subtitle", "time": 5343.27, "timestamp": "01:29:03", "text": "死んだものをどうやって食べられるのか？"}, {"type": "subtitle", "time": 5347.11, "timestamp": "01:29:07", "text": "うん。それはどれくらいかわかりません"}, {"type": "subtitle", "time": 5348.35, "timestamp": "01:29:08", "text": "理にかなっている"}, {"type": "subtitle", "time": 5351.11, "timestamp": "01:29:11", "text": "でも、私がこれを始めたのは"}, {"type": "subtitle", "time": 5353.91, "timestamp": "01:29:13", "text": "えっと、私には友達がいて、"}, {"type": "subtitle", "time": 5356.95, "timestamp": "01:29:16", "text": "肉屋の右なので、私が一度行ったとき"}, {"type": "subtitle", "time": 5359.43, "timestamp": "01:29:19", "text": "彼と一緒に鶏を手に入れて、私は"}, {"type": "subtitle", "time": 5361.47, "timestamp": "01:29:21", "text": "私は彼に尋ねた、"}, {"type": "subtitle", "time": 5364.87, "timestamp": "01:29:24", "text": "鶏肉で、彼は以前にも私にそれをさせてくれたし、"}, {"type": "subtitle", "time": 5366.87, "timestamp": "01:29:26", "text": "うん、その後、私は鶏を解体した"}, {"type": "subtitle", "time": 5370.87, "timestamp": "01:29:30", "text": "自分の手で、絶対に無理"}, {"type": "subtitle", "time": 5374.27, "timestamp": "01:29:34", "text": "うん、楽しかったよ。ああ、"}, {"type": "subtitle", "time": 5378.07, "timestamp": "01:29:38", "text": "神。どうでも。そしてあなたの"}, {"type": "subtitle", "time": 5380.87, "timestamp": "01:29:40", "text": "それについて何か経験はありますか？"}, {"type": "subtitle", "time": 5385.11, "timestamp": "01:29:45", "text": "つまり、そのナイフは鋭かったんです。うん。それ"}, {"type": "subtitle", "time": 5387.43, "timestamp": "01:29:47", "text": "それは私が気づいたことの一つです。"}, {"type": "subtitle", "time": 5389.35, "timestamp": "01:29:49", "text": "ええ、あなたはそうではないと言いました"}, {"type": "subtitle", "time": 5392.229, "timestamp": "01:29:52", "text": "血が怖い。はい。うん。うん。それは"}, {"type": "subtitle", "time": 5395.51, "timestamp": "01:29:55", "text": "だから、私はそのことをやって、"}, {"type": "subtitle", "time": 5398.31, "timestamp": "01:29:58", "text": "楽しんでください。そして家に帰ると、"}]
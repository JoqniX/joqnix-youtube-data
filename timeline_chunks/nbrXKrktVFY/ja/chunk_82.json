[{"type": "subtitle", "time": 4921.03, "timestamp": "01:22:01", "text": "すごく疲れているように見えるけど、どうして？"}, {"type": "subtitle", "time": 4923.669, "timestamp": "01:22:03", "text": "などなど。うん。うん。うん。まるで"}, {"type": "subtitle", "time": 4924.21, "timestamp": "01:22:04", "text": "良い方法だ。"}, {"type": "subtitle", "time": 4929.189, "timestamp": "01:22:09", "text": "それはまるであなたがしたことのようで、"}, {"type": "subtitle", "time": 4930.55, "timestamp": "01:22:10", "text": "あなたが情熱を注いでいること、そして"}, {"type": "subtitle", "time": 4932.39, "timestamp": "01:22:12", "text": "今はもう疲れ果てていて、"}, {"type": "subtitle", "time": 4934.55, "timestamp": "01:22:14", "text": "あなたはただ「ああ、あれはあれは"}, {"type": "subtitle", "time": 4936.95, "timestamp": "01:22:16", "text": "とても良い。\""}, {"type": "subtitle", "time": 4942.55, "timestamp": "01:22:22", "text": "土曜日のように、私はこの脚を"}, {"type": "subtitle", "time": 4945.43, "timestamp": "01:22:25", "text": "私は脚をまるで脚のように動かします"}, {"type": "subtitle", "time": 4947.03, "timestamp": "01:22:27", "text": "日。"}, {"type": "subtitle", "time": 4950.31, "timestamp": "01:22:30", "text": "今日は歩くことができません。私は自分が"}, {"type": "subtitle", "time": 4957.35, "timestamp": "01:22:37", "text": "でも歩くといつも気持ちがいい"}, {"type": "subtitle", "time": 4959.91, "timestamp": "01:22:39", "text": "なぜなら私は知っているから"}, {"type": "subtitle", "time": 4963.99, "timestamp": "01:22:43", "text": "私はジムでのトレーニングをきちんとこなしました。"}, {"type": "subtitle", "time": 4965.75, "timestamp": "01:22:45", "text": "うん。まさにそんな感じ。もし"}, {"type": "subtitle", "time": 4967.43, "timestamp": "01:22:47", "text": "翌日は感じなかった、"}, {"type": "subtitle", "time": 4970.2, "timestamp": "01:22:50", "text": "十分に頑張れ。"}, {"type": "subtitle", "time": 4971.99, "timestamp": "01:22:51", "text": "[音楽]"}, {"type": "subtitle", "time": 4974.629, "timestamp": "01:22:54", "text": "そして私は、"}, {"type": "subtitle", "time": 4976.79, "timestamp": "01:22:56", "text": "私が行ける場所、例えば私の"}]
[{"type": "subtitle", "time": 10261.75, "timestamp": "02:51:01", "text": "「[ __ ]？」まるで私の頭の中では"}, {"type": "subtitle", "time": 10264.469, "timestamp": "02:51:04", "text": "「ああ、兄さんは話せるよ」って感じ"}, {"type": "subtitle", "time": 10267.51, "timestamp": "02:51:07", "text": "警備員に。"}, {"type": "subtitle", "time": 10276.79, "timestamp": "02:51:16", "text": "どんな感じか変な感じどれくらい似てるか"}, {"type": "subtitle", "time": 10279.03, "timestamp": "02:51:19", "text": "インド人として興味深いのは、"}, {"type": "subtitle", "time": 10281.19, "timestamp": "02:51:21", "text": "他の人が見るように、他の人も"}, {"type": "subtitle", "time": 10283.269, "timestamp": "02:51:23", "text": "もの。それが良いところだ"}, {"type": "subtitle", "time": 10285.03, "timestamp": "02:51:25", "text": "インターネット。他の人がやっているのを見て"}, {"type": "subtitle", "time": 10287.59, "timestamp": "02:51:27", "text": "他のものを見て、ああ、それは"}, {"type": "subtitle", "time": 10289.71, "timestamp": "02:51:29", "text": "ただ"}, {"type": "subtitle", "time": 10292.71, "timestamp": "02:51:32", "text": "インドが最も誇りに思っているように、私たちも"}, {"type": "subtitle", "time": 10300.15, "timestamp": "02:51:40", "text": "まるで誰かが私にこう言ったみたいだ"}, {"type": "subtitle", "time": 10304.309, "timestamp": "02:51:44", "text": "「知ってた？俺たちが一番多かったんだよ」"}, {"type": "subtitle", "time": 10307.11, "timestamp": "02:51:47", "text": "私たちは最も進んだ文明を持っていた"}, {"type": "subtitle", "time": 10308.349, "timestamp": "02:51:48", "text": "戻って"}, {"type": "subtitle", "time": 10318.19, "timestamp": "02:51:58", "text": "けれど？それはどういうことですか それはどういうことですか"}]
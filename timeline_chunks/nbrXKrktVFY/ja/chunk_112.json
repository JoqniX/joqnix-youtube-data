[{"type": "subtitle", "time": 6721.35, "timestamp": "01:52:01", "text": "服や靴、または何か答えるもの"}, {"type": "subtitle", "time": 6723.51, "timestamp": "01:52:03", "text": "これは私たちにとってのことです。 「なあ、聞いてくれよ。"}, {"type": "subtitle", "time": 6725.95, "timestamp": "01:52:05", "text": "ヒジャブを作ろうとしている"}, {"type": "subtitle", "time": 6728.709, "timestamp": "01:52:08", "text": "ラマだが、ヒジャブは"}, {"type": "subtitle", "time": 6731.149, "timestamp": "01:52:11", "text": "彼女によって台無しにされた"}, {"type": "subtitle", "time": 6734.629, "timestamp": "01:52:14", "text": "動きがあるから、何か作ってほしい。"}, {"type": "subtitle", "time": 6740.229, "timestamp": "01:52:20", "text": "でも他のモンスターガールもいる"}, {"type": "subtitle", "time": 6744.39, "timestamp": "01:52:24", "text": "クモのような、クモ類のような生き物ですよね？"}, {"type": "subtitle", "time": 6746.87, "timestamp": "01:52:26", "text": "うん。そうすれば彼らにとって簡単になる"}, {"type": "subtitle", "time": 6749.35, "timestamp": "01:52:29", "text": "なぜなら、あなたと同じように彼らの体は、えーと"}, {"type": "subtitle", "time": 6752.149, "timestamp": "01:52:32", "text": "体が大きいけど、"}, {"type": "subtitle", "time": 6754.229, "timestamp": "01:52:34", "text": "彼らには服があるから"}, {"type": "subtitle", "time": 6757.75, "timestamp": "01:52:37", "text": "彼らの足に何か問題が起きている。はい。"}, {"type": "subtitle", "time": 6760.709, "timestamp": "01:52:40", "text": "馬好きの女の子たちも同じだ。置くことができます"}, {"type": "subtitle", "time": 6762.83, "timestamp": "01:52:42", "text": "服を着ている"}, {"type": "subtitle", "time": 6766.83, "timestamp": "01:52:46", "text": "馬。ラミアは私が思う唯一のラマです"}, {"type": "subtitle", "time": 6770.55, "timestamp": "01:52:50", "text": "ドラゴンもまた問題のようなものだ"}, {"type": "subtitle", "time": 6772.79, "timestamp": "01:52:52", "text": "よく考えてみれば。"}, {"type": "subtitle", "time": 6775.35, "timestamp": "01:52:55", "text": "ドラゴンの女の子の中にはラマのような子もいる"}, {"type": "subtitle", "time": 6779.669, "timestamp": "01:52:59", "text": "まるでドラゴンボーンのように。はい。はい。なぜなら"}]
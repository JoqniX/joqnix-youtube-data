[{"type": "subtitle", "time": 1567.11, "timestamp": "00:26:07", "text": "私の場合、私はただ自分の好きなようにするだけです"}, {"type": "subtitle", "time": 1572.789, "timestamp": "00:26:12", "text": "ある意味、そんな感じがする。えっと、私は、えっと"}, {"type": "subtitle", "time": 1576.43, "timestamp": "00:26:16", "text": "賢明な私は以前にポッドキャストをしました"}, {"type": "subtitle", "time": 1580.75, "timestamp": "00:26:20", "text": "仮想現実がかつて存在した時代は、はるか昔のことだ。"}, {"type": "subtitle", "time": 1586.07, "timestamp": "00:26:26", "text": "仮想主義は、えっと、どうやって"}, {"type": "subtitle", "time": 1589.269, "timestamp": "00:26:29", "text": "仮想現実について説明すべきでしょうか？何てことだ。えっと"}, {"type": "subtitle", "time": 1592.47, "timestamp": "00:26:32", "text": "私たちは独立したインド人のグループです"}, {"type": "subtitle", "time": 1594.99, "timestamp": "00:26:34", "text": "YouTuberたちは"}, {"type": "subtitle", "time": 1598.87, "timestamp": "00:26:38", "text": "情熱を注いで取り組むプロジェクトのようなもの"}, {"type": "subtitle", "time": 1601.43, "timestamp": "00:26:41", "text": "YouTuberたちと集まって、"}, {"type": "subtitle", "time": 1605.669, "timestamp": "00:26:45", "text": "一緒にプロジェクトをやりたかったので、"}, {"type": "subtitle", "time": 1610.71, "timestamp": "00:26:50", "text": "2022年に私もその一部だったと思う。"}, {"type": "subtitle", "time": 1613.669, "timestamp": "00:26:53", "text": "考える"}, {"type": "subtitle", "time": 1615.59, "timestamp": "00:26:55", "text": "あなたは自分がその一部だったと思っているのですか？私は"}, {"type": "subtitle", "time": 1618.47, "timestamp": "00:26:58", "text": "その一部です。うん。ではなぜあなたは言うのですか"}]
[{"type": "subtitle", "time": 3001.95, "timestamp": "00:50:01", "text": "私もアスペンを見ています。彼は本当に素晴らしい。"}, {"type": "subtitle", "time": 3005.19, "timestamp": "00:50:05", "text": "うん。彼がどのように"}, {"type": "subtitle", "time": 3010.23, "timestamp": "00:50:10", "text": "彼はネズミを目覚まし時計として使っている。"}, {"type": "subtitle", "time": 3012.069, "timestamp": "00:50:12", "text": "「えっ、それってちょっと"}, {"type": "subtitle", "time": 3014.069, "timestamp": "00:50:14", "text": "似たような何か同じものがあったから"}, {"type": "subtitle", "time": 3018.15, "timestamp": "00:50:18", "text": "私の部屋に死んだネズミがいた。"}, {"type": "subtitle", "time": 3020.549, "timestamp": "00:50:20", "text": "そして、死んだネズミがいたことがわかった。"}, {"type": "subtitle", "time": 3023.67, "timestamp": "00:50:23", "text": "匂いで分かったから。"}, {"type": "subtitle", "time": 3025.23, "timestamp": "00:50:25", "text": "だから私はこう思った、"}, {"type": "subtitle", "time": 3028.19, "timestamp": "00:50:28", "text": "「うーん、これは死んでいるかもしれない"}, {"type": "subtitle", "time": 3033.349, "timestamp": "00:50:33", "text": "ネズミを捕まえて駆除すればいいんだけど、面倒くさいんだよね。"}, {"type": "subtitle", "time": 3034.71, "timestamp": "00:50:34", "text": "そうですね、見てみると"}, {"type": "subtitle", "time": 3036.79, "timestamp": "00:50:36", "text": "ベッドの下、あらゆる場所を探して、"}, {"type": "subtitle", "time": 3038.95, "timestamp": "00:50:38", "text": "私のテーブルの下に。"}, {"type": "subtitle", "time": 3040.549, "timestamp": "00:50:40", "text": "部屋に物が多すぎる"}, {"type": "subtitle", "time": 3042.309, "timestamp": "00:50:42", "text": "当時私は慣れていたので"}, {"type": "subtitle", "time": 3044.39, "timestamp": "00:50:44", "text": "物を溜め込む人のように暮らしている"}, {"type": "subtitle", "time": 3046.23, "timestamp": "00:50:46", "text": "もの。"}, {"type": "subtitle", "time": 3048.309, "timestamp": "00:50:48", "text": "うん。そして私もそう思った、"}, {"type": "subtitle", "time": 3050.71, "timestamp": "00:50:50", "text": "それを探すのにかなりの労力を要した。だから私はただ"}, {"type": "subtitle", "time": 3054.109, "timestamp": "00:50:54", "text": "ねえ、こうしようよ"}, {"type": "subtitle", "time": 3057.829, "timestamp": "00:50:57", "text": "実験。ネズミはどれくらいの間、匂いを嗅ぎ分けることができるのか？ A"}, {"type": "subtitle", "time": 3059.47, "timestamp": "00:50:59", "text": "死んだネズミは"}]
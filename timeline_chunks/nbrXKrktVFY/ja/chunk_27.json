[{"type": "subtitle", "time": 1620.549, "timestamp": "00:27:00", "text": "ああ、私もその一部だったと思う。"}, {"type": "subtitle", "time": 1623.909, "timestamp": "00:27:03", "text": "もしかしたら夢だったのかもしれないけど、誰にもわからない。"}, {"type": "subtitle", "time": 1624.75, "timestamp": "00:27:04", "text": "おお"}, {"type": "subtitle", "time": 1628.47, "timestamp": "00:27:08", "text": "ええ、その通りです。でも、ええ、でも私は"}, {"type": "subtitle", "time": 1631.71, "timestamp": "00:27:11", "text": "関係ないけど、まあ、まだ"}, {"type": "subtitle", "time": 1635.19, "timestamp": "00:27:15", "text": "そこには。ミアは自分のやりたいことをやっている。よお、"}, {"type": "subtitle", "time": 1638.87, "timestamp": "00:27:18", "text": "Cadmax、Metami、Pandの3つすべてが"}, {"type": "subtitle", "time": 1641.549, "timestamp": "00:27:21", "text": "えっと、あの人たちは"}, {"type": "subtitle", "time": 1644.63, "timestamp": "00:27:24", "text": "仮想化の背後で、最近私は"}, {"type": "subtitle", "time": 1648.269, "timestamp": "00:27:28", "text": "私のチャンネルで彼らとコラボして"}, {"type": "subtitle", "time": 1650.909, "timestamp": "00:27:30", "text": "良い。うん、"}, {"type": "subtitle", "time": 1655.029, "timestamp": "00:27:35", "text": "他に何を言えばいいだろうか？難しい"}, {"type": "subtitle", "time": 1656.95, "timestamp": "00:27:36", "text": "質問。自分の"}, {"type": "subtitle", "time": 1658.11, "timestamp": "00:27:38", "text": "コンテンツ？"}, {"type": "subtitle", "time": 1661.909, "timestamp": "00:27:41", "text": "H いいと思いますが、わかりません"}, {"type": "subtitle", "time": 1664.71, "timestamp": "00:27:44", "text": "私のチャットにいる何人かの人は"}, {"type": "subtitle", "time": 1666.789, "timestamp": "00:27:46", "text": "あなたの声について混乱しています、私は知っています"}, {"type": "subtitle", "time": 1668.63, "timestamp": "00:27:48", "text": "君の周りのことは分かってるよ"}, {"type": "subtitle", "time": 1670.23, "timestamp": "00:27:50", "text": "私はあなたと交流しましたが、おそらく"}, {"type": "subtitle", "time": 1678.389, "timestamp": "00:27:58", "text": "では、あなたの"}]
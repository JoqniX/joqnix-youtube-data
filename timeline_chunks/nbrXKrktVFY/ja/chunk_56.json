[{"type": "subtitle", "time": 3363.349, "timestamp": "00:56:03", "text": "[音楽]"}, {"type": "subtitle", "time": 3365.91, "timestamp": "00:56:05", "text": "父に聞いたんだけど、私たちは支払うの？"}, {"type": "subtitle", "time": 3367.99, "timestamp": "00:56:07", "text": "税金を払う？父に聞いてみたら、父はこう言った。"}, {"type": "subtitle", "time": 3370.069, "timestamp": "00:56:10", "text": "「そうする年もあれば、そうしない年もある。」"}, {"type": "subtitle", "time": 3372.15, "timestamp": "00:56:12", "text": "「なぜ？」って感じ。彼女はこう言った。「だって私たちは"}, {"type": "subtitle", "time": 3374.309, "timestamp": "00:56:14", "text": "それらを必須条件にしないでください。私たちは会う"}, {"type": "subtitle", "time": 3377.87, "timestamp": "00:56:17", "text": "納税義務を満たしていない"}, {"type": "subtitle", "time": 3380.789, "timestamp": "00:56:20", "text": "時々、何年も。"}, {"type": "subtitle", "time": 3382.829, "timestamp": "00:56:22", "text": "うん。のように、"}, {"type": "subtitle", "time": 3385.67, "timestamp": "00:56:25", "text": "わかった。しかし、それはそれぞれ異なります"}, {"type": "subtitle", "time": 3386.8, "timestamp": "00:56:26", "text": "国。"}, {"type": "subtitle", "time": 3388.63, "timestamp": "00:56:28", "text": "[音楽]"}, {"type": "subtitle", "time": 3391.51, "timestamp": "00:56:31", "text": "例えばアメリカでは、税金を払うと"}, {"type": "subtitle", "time": 3395.27, "timestamp": "00:56:35", "text": "あなたが購入するすべての商品に税金を支払います"}, {"type": "subtitle", "time": 3398.87, "timestamp": "00:56:38", "text": "なぜなら、私たちはMRP（資材所要量計画）システムを持っているからです。"}, {"type": "subtitle", "time": 3401.75, "timestamp": "00:56:41", "text": "つまり、私たちは購入するものに対して税金を支払っているということだ。私たちは"}, {"type": "subtitle", "time": 3412.47, "timestamp": "00:56:52", "text": "チャットで誰かが私に言った"}, {"type": "subtitle", "time": 3414.39, "timestamp": "00:56:54", "text": "支払い方法が分からなければ、税金の侵害になる"}]
[{"type": "subtitle", "time": 8701.75, "timestamp": "02:25:01", "text": "誰かとDiscordで通話して、"}, {"type": "subtitle", "time": 8703.429, "timestamp": "02:25:03", "text": "私に何て言ってるの？"}, {"type": "subtitle", "time": 8704.95, "timestamp": "02:25:04", "text": "何をしているの？そこで、画面を共有しました"}, {"type": "subtitle", "time": 8706.87, "timestamp": "02:25:06", "text": "私が何をしていたのか、そしてあなたは"}, {"type": "subtitle", "time": 8708.389, "timestamp": "02:25:08", "text": "何か理解できましたか？ 「うん、"}, {"type": "subtitle", "time": 8712.23, "timestamp": "02:25:12", "text": "ご覧のとおり、エイミーは"}, {"type": "subtitle", "time": 8715.27, "timestamp": "02:25:15", "text": "それ。 「えっと、ジジがやってるよ。」それで私はこう思った"}, {"type": "subtitle", "time": 8716.95, "timestamp": "02:25:16", "text": "彼らにすべてを説明する。例えば、どうやって"}, {"type": "subtitle", "time": 8719.63, "timestamp": "02:25:19", "text": "一体何が分かってるんだ？"}, {"type": "subtitle", "time": 8721.91, "timestamp": "02:25:21", "text": "何でも？私はチャットを読んでいます。"}, {"type": "subtitle", "time": 8724.99, "timestamp": "02:25:24", "text": "チャットの流れを読んでるんだけど、えっと、チャットの流れがどうなっているのか見てるんだ。"}, {"type": "subtitle", "time": 8727.59, "timestamp": "02:25:27", "text": "だって、ジョー、わかる？"}, {"type": "subtitle", "time": 8729.59, "timestamp": "02:25:29", "text": "もの？私は自分が自閉症だと感じているから"}, {"type": "subtitle", "time": 8732.95, "timestamp": "02:25:32", "text": "このために。ある特定のやり方で"}, {"type": "subtitle", "time": 8735.15, "timestamp": "02:25:35", "text": "YouTuberはチャットを読んでいます。"}, {"type": "subtitle", "time": 8738.15, "timestamp": "02:25:38", "text": "ええ、私もそれに気づきました。うん。うん。"}, {"type": "subtitle", "time": 8741.03, "timestamp": "02:25:41", "text": "うん。一部のユーチューバーと同様に、ほとんどのユーチューバーと同様に"}, {"type": "subtitle", "time": 8743.99, "timestamp": "02:25:43", "text": "YouTuberはチャットを読まない"}, {"type": "subtitle", "time": 8746.309, "timestamp": "02:25:46", "text": "あるいは、彼らはそれを読むか、コメントしないだろう"}, {"type": "subtitle", "time": 8748.87, "timestamp": "02:25:48", "text": "読まれたもの。うん。声楽的に"}, {"type": "subtitle", "time": 8750.79, "timestamp": "02:25:50", "text": "声に出して言ってみてください。うん。一部の人々は"}, {"type": "subtitle", "time": 8753.309, "timestamp": "02:25:53", "text": "チャットから面白いものだけを選んでください"}, {"type": "subtitle", "time": 8756.63, "timestamp": "02:25:56", "text": "どうにか。読書が好きな人もいる"}]
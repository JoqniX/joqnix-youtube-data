[{"type": "subtitle", "time": 4741.35, "timestamp": "01:19:01", "text": "ファンにジムに行くように勧めている"}, {"type": "subtitle", "time": 4746.47, "timestamp": "01:19:06", "text": "例えば、ある一文が私の心に深く刻み込まれるような感じ。"}, {"type": "subtitle", "time": 4754.95, "timestamp": "01:19:14", "text": "声に出して言うとバカみたいに聞こえる"}, {"type": "subtitle", "time": 4762.709, "timestamp": "01:19:22", "text": "だから私はただ自分のワイフのためにやったの、そして私の"}, {"type": "subtitle", "time": 4767.669, "timestamp": "01:19:27", "text": "私は彼らのものを憎まない"}, {"type": "subtitle", "time": 4770.07, "timestamp": "01:19:30", "text": "のように。そしてもし彼らが私のことが好きだと言ったら、私は"}, {"type": "subtitle", "time": 4774.51, "timestamp": "01:19:34", "text": "[音楽]"}, {"type": "subtitle", "time": 4781.59, "timestamp": "01:19:41", "text": "男。今度はもっと挑戦してみたくなった"}, {"type": "subtitle", "time": 4785.99, "timestamp": "01:19:45", "text": "ジム通い。私は一度もログインしたことがありません。 Nジョックなら"}, {"type": "subtitle", "time": 4788.31, "timestamp": "01:19:48", "text": "健康な体と健康的な食生活を送る"}, {"type": "subtitle", "time": 4790.47, "timestamp": "01:19:50", "text": "それなら、私はジムを勧めません。"}, {"type": "subtitle", "time": 4793.11, "timestamp": "01:19:53", "text": "すでに健康的なライフスタイルを送っている"}, {"type": "subtitle", "time": 4795.43, "timestamp": "01:19:55", "text": "右"}, {"type": "subtitle", "time": 4798.87, "timestamp": "01:19:58", "text": "でも時間があれば"}]
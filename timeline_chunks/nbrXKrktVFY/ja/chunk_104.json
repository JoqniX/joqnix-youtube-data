[{"type": "subtitle", "time": 6241.189, "timestamp": "01:44:01", "text": "瞬間。まるで私が座って"}, {"type": "subtitle", "time": 6243.109, "timestamp": "01:44:03", "text": "自分自身との会話で、私はこう思う。"}, {"type": "subtitle", "time": 6244.95, "timestamp": "01:44:04", "text": "「ああ、素敵なインスタグラムになりそうだ」"}, {"type": "subtitle", "time": 6254.07, "timestamp": "01:44:14", "text": "あなたのインスタグラムのストーリー投稿、とても楽しんでいます。"}, {"type": "subtitle", "time": 6257.27, "timestamp": "01:44:17", "text": "あなたがこれをやっているのを見るのはとても楽しいです。"}, {"type": "subtitle", "time": 6259.51, "timestamp": "01:44:19", "text": "私はそのほとんどに横たわっているような感じ"}, {"type": "subtitle", "time": 6262.229, "timestamp": "01:44:22", "text": "私のベッドで、私はこう考えている"}, {"type": "subtitle", "time": 6266.149, "timestamp": "01:44:26", "text": "自分の壁に向かって独り言を言う"}, {"type": "subtitle", "time": 6267.59, "timestamp": "01:44:27", "text": "そして私は「ああ、それはちょっと"}, {"type": "subtitle", "time": 6270.07, "timestamp": "01:44:30", "text": "面白い。これをインスタグラムに投稿するか、"}, {"type": "subtitle", "time": 6278.07, "timestamp": "01:44:38", "text": "話しながら笑ってしまうような"}, {"type": "subtitle", "time": 6285.43, "timestamp": "01:44:45", "text": "うん。でもあなたはそれで満足しているのですね"}, {"type": "subtitle", "time": 6287.07, "timestamp": "01:44:47", "text": "そしてあなたは"}, {"type": "subtitle", "time": 6289.669, "timestamp": "01:44:49", "text": "気分はどうですか？"}, {"type": "subtitle", "time": 6293.27, "timestamp": "01:44:53", "text": "いや、まあ、20%くらいは幸せって感じかな。ほとんどの"}, {"type": "subtitle", "time": 6296.229, "timestamp": "01:44:56", "text": "それはまるで憂鬱な気分だ。"}, {"type": "subtitle", "time": 6298.629, "timestamp": "01:44:58", "text": "私は自分を怒らせるために独り言を言う"}]
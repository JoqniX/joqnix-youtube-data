[{"type": "subtitle", "time": 13563.67, "timestamp": "03:46:03", "text": "ああ、でも、そう、戻ってくるのは"}, {"type": "subtitle", "time": 13567.07, "timestamp": "03:46:07", "text": "残りのタスクは何"}, {"type": "subtitle", "time": 13570.71, "timestamp": "03:46:10", "text": "すべてがうまくいくことを願うばかりです。"}, {"type": "subtitle", "time": 13573.99, "timestamp": "03:46:13", "text": "今は人を集めるのが難しいと思う"}, {"type": "subtitle", "time": 13576.71, "timestamp": "03:46:16", "text": "例えば、企業を招き入れたとしても"}, {"type": "subtitle", "time": 13580.229, "timestamp": "03:46:20", "text": "インドではマネージャーを見つけるのが難しいか、"}, {"type": "subtitle", "time": 13582.87, "timestamp": "03:46:22", "text": "タレントマネージャーと適切な人材"}, {"type": "subtitle", "time": 13584.55, "timestamp": "03:46:24", "text": "なぜなら"}, {"type": "subtitle", "time": 13587.59, "timestamp": "03:46:27", "text": "それは難しいし、誰もがそうではない"}, {"type": "subtitle", "time": 13590.229, "timestamp": "03:46:30", "text": "本当に知りたいのですが"}, {"type": "subtitle", "time": 13592.309, "timestamp": "03:46:32", "text": "人生のプロセス。採用方法"}, {"type": "subtitle", "time": 13596.309, "timestamp": "03:46:36", "text": "トライアル。私は、何の神様が"}, {"type": "subtitle", "time": 13598.309, "timestamp": "03:46:38", "text": "才能のある人に話しかける"}, {"type": "subtitle", "time": 13599.83, "timestamp": "03:46:39", "text": "ジジ？"}, {"type": "subtitle", "time": 13608.71, "timestamp": "03:46:48", "text": "その通り。あれがピークだ。おお"}, {"type": "subtitle", "time": 13611.03, "timestamp": "03:46:51", "text": "我が神よ。そして、サクナは"}, {"type": "subtitle", "time": 13613.349, "timestamp": "03:46:53", "text": "彼は一体どうやってペッパを見つけたんだ？どうやって"}, {"type": "subtitle", "time": 13616.63, "timestamp": "03:46:56", "text": "彼はペッパを見つけたのか？その通り。"}, {"type": "subtitle", "time": 13619.269, "timestamp": "03:46:59", "text": "彼は「ああ、彼女も大丈夫だよ」と言った。"}]
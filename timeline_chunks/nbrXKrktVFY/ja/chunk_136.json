[{"type": "subtitle", "time": 8160.149, "timestamp": "02:16:00", "text": "私が気づいたことの一つは、"}, {"type": "subtitle", "time": 8162.95, "timestamp": "02:16:02", "text": "いたずら電話をかける 彼らに電話する 私は気づいた"}, {"type": "subtitle", "time": 8164.709, "timestamp": "02:16:04", "text": "まず最初に、それが男性か女性かを確認します。"}, {"type": "subtitle", "time": 8166.87, "timestamp": "02:16:06", "text": "女の子なら、"}, {"type": "subtitle", "time": 8169.109, "timestamp": "02:16:09", "text": "私に付き合ってください"}, {"type": "subtitle", "time": 8171.189, "timestamp": "02:16:11", "text": "何度も見てきたように"}, {"type": "subtitle", "time": 8173.589, "timestamp": "02:16:13", "text": "女の子の場合はいつでも、彼らはいい感じになる"}, {"type": "subtitle", "time": 8176.31, "timestamp": "02:16:16", "text": "先生、私たちは彼女が始めるのを好きになることはできません"}, {"type": "subtitle", "time": 8179.31, "timestamp": "02:16:19", "text": "私にこれらの会社の規則を伝え、"}, {"type": "subtitle", "time": 8189.149, "timestamp": "02:16:29", "text": "だから、私が"}, {"type": "subtitle", "time": 8192.15, "timestamp": "02:16:32", "text": "わかった、わかってるよ、私はユーモアのセンスがあるって感じ"}, {"type": "subtitle", "time": 8198.87, "timestamp": "02:16:38", "text": "楽しい"}, {"type": "subtitle", "time": 8207.11, "timestamp": "02:16:47", "text": "最近はDiscordに行って「いいね」するだけ"}, {"type": "subtitle", "time": 8209.83, "timestamp": "02:16:49", "text": "Discordでいたずら電話をかける"}, {"type": "subtitle", "time": 8212.23, "timestamp": "02:16:52", "text": "異なるID。"}, {"type": "subtitle", "time": 8213.91, "timestamp": "02:16:53", "text": "待って、いたずら電話をどうやって"}, {"type": "subtitle", "time": 8216.549, "timestamp": "02:16:56", "text": "彼らを友達に追加する？いいえ、いいえ、違います"}, {"type": "subtitle", "time": 8218.389, "timestamp": "02:16:58", "text": "いたずら電話。ランダムに"}]
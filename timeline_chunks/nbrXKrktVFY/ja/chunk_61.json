[{"type": "subtitle", "time": 3660.23, "timestamp": "01:01:00", "text": "いいえ、何でも売ることができます。しない"}, {"type": "subtitle", "time": 3663.109, "timestamp": "01:01:03", "text": "合法か違法かは関係なく、"}, {"type": "chat", "time": 3665.829, "timestamp": "01:01:05", "author": "@RyzexCh", "avatar": "https://yt4.ggpht.com/amK2Y62apvFDa_Drvh1DcQn8KTERvc2-tn67_8Tfb4CDDptav6v-n5VMsBR3U5XQAh1NLxsr1Q=s64-c-k-c0x00ffffff-no-rj", "message": "drogs UCkszU2WH9gy1mb0dV-11UJg/m8MfY4jbFsWJhL0PyouA2AkUCkszU2WH9gy1mb0dV-11UJg/m8MfY4jbFsWJhL0PyouA2Ak"}, {"type": "subtitle", "time": 3667.75, "timestamp": "01:01:07", "text": "それ。そしてそれは必ずしも"}, {"type": "subtitle", "time": 3669.829, "timestamp": "01:01:09", "text": "存在する。 「私は売っています」と言うだけで"}, {"type": "subtitle", "time": 3671.67, "timestamp": "01:01:11", "text": "「これを売るだけ」"}, {"type": "subtitle", "time": 3684.23, "timestamp": "01:01:24", "text": "えっと、大金を稼がないといけないのかな？"}, {"type": "subtitle", "time": 3687.19, "timestamp": "01:01:27", "text": "お金か何かで満足すべきでしょうか"}, {"type": "subtitle", "time": 3689.43, "timestamp": "01:01:29", "text": "中程度の金額か、少額の金額か？あなた、あなた"}, {"type": "subtitle", "time": 3692.829, "timestamp": "01:01:32", "text": "料金は自由に設定できます。ああ"}, {"type": "subtitle", "time": 3696.87, "timestamp": "01:01:36", "text": "わかった。薬物と言いたいけど、いや"}, {"type": "subtitle", "time": 3698.27, "timestamp": "01:01:38", "text": "それは"}, {"type": "subtitle", "time": 3701.75, "timestamp": "01:01:41", "text": "悪い。それはあなたを再び刑務所送りにする可能性もあります。"}, {"type": "subtitle", "time": 3704.23, "timestamp": "01:01:44", "text": "だからいいえ、でもそれはあなたを"}, {"type": "subtitle", "time": 3708.549, "timestamp": "01:01:48", "text": "刑務所。待って、なぜ？ああ、なぜならこの"}, {"type": "subtitle", "time": 3712.349, "timestamp": "01:01:52", "text": "シナリオによっては、そうはならないでしょう。"}, {"type": "subtitle", "time": 3715.43, "timestamp": "01:01:55", "text": "おお。何てことだ。しかしおそらく人々は"}, {"type": "subtitle", "time": 3719.63, "timestamp": "01:01:59", "text": "あなたがそれを売ろうとしている人は逮捕されるでしょう。"}]
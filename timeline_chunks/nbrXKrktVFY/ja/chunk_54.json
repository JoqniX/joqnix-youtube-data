[{"type": "subtitle", "time": 3240.19, "timestamp": "00:54:00", "text": "それらは、引き抜くことができるバッテリーのようなものです。"}, {"type": "subtitle", "time": 3245.349, "timestamp": "00:54:05", "text": "旧型のNokia C201携帯電話はもう時代遅れだ。そうそう。"}, {"type": "subtitle", "time": 3247.109, "timestamp": "00:54:07", "text": "だから私はこうしました、ここへ行きました"}, {"type": "subtitle", "time": 3249.75, "timestamp": "00:54:09", "text": "ジャンクヤード、古いマザーボードがいくつかある"}, {"type": "subtitle", "time": 3253.349, "timestamp": "00:54:13", "text": "電話を修理して、新しいボディを取り付けました"}, {"type": "subtitle", "time": 3255.39, "timestamp": "00:54:15", "text": "それらについているもの、つまりキャビネットのことです"}, {"type": "subtitle", "time": 3260.069, "timestamp": "00:54:20", "text": "あれこれ買って、それを売って利益を得た。"}, {"type": "subtitle", "time": 3261.829, "timestamp": "00:54:21", "text": "子供の頃、私もそうやって、"}, {"type": "subtitle", "time": 3264.71, "timestamp": "00:54:24", "text": "そこから大金を得るようなものだ。いいえ"}, {"type": "subtitle", "time": 3267.27, "timestamp": "00:54:27", "text": "本来あるべきではない場所に十分なお金がある"}, {"type": "subtitle", "time": 3270.15, "timestamp": "00:54:30", "text": "それを呼ぶべきである、それはそれができるだろう"}, {"type": "subtitle", "time": 3273.19, "timestamp": "00:54:33", "text": "副業"}, {"type": "subtitle", "time": 3274.79, "timestamp": "00:54:34", "text": "でもお金が足りなくて"}, {"type": "subtitle", "time": 3283.51, "timestamp": "00:54:43", "text": "私はまだ税金を納めていません。なんてこった。私"}, {"type": "subtitle", "time": 3285.589, "timestamp": "00:54:45", "text": "すべき。"}, {"type": "subtitle", "time": 3287.67, "timestamp": "00:54:47", "text": "ええ、そうするべきです。私はただ待っているだけです"}, {"type": "subtitle", "time": 3291.19, "timestamp": "00:54:51", "text": "税務署員が現れる。"}, {"type": "subtitle", "time": 3293.829, "timestamp": "00:54:53", "text": "オレンジのように、税金を払いすぎました"}]
[{"type": "subtitle", "time": 11102.07, "timestamp": "03:05:02", "text": "[音楽]"}, {"type": "subtitle", "time": 11103.67, "timestamp": "03:05:03", "text": "ああ、こんなことが起こっている"}, {"type": "subtitle", "time": 11106.469, "timestamp": "03:05:06", "text": "どうやらオンラインで入手できるようですね？私は"}, {"type": "subtitle", "time": 11110.79, "timestamp": "03:05:10", "text": "この近親相姦野郎。これについてご存知ですか？"}, {"type": "subtitle", "time": 11112.95, "timestamp": "03:05:12", "text": "それは誰ですか？待って、私はこう呼ばれています"}, {"type": "subtitle", "time": 11118.15, "timestamp": "03:05:18", "text": "近親相姦男。私はオンラインです。私は私です"}, {"type": "subtitle", "time": 11120.469, "timestamp": "03:05:20", "text": "オレンジ"}, {"type": "subtitle", "time": 11124.389, "timestamp": "03:05:24", "text": "私は近親相姦の男として知られていますよね"}, {"type": "subtitle", "time": 11126.309, "timestamp": "03:05:26", "text": "なぜあなたは伝承を知っているのですか？"}, {"type": "subtitle", "time": 11128.269, "timestamp": "03:05:28", "text": "その背後には"}, {"type": "subtitle", "time": 11133.03, "timestamp": "03:05:33", "text": "いいえ、あなたもそう思いますか？"}, {"type": "subtitle", "time": 11136.63, "timestamp": "03:05:36", "text": "兄弟姉妹の愛は、ある種のものです"}, {"type": "subtitle", "time": 11139.59, "timestamp": "03:05:39", "text": "物事のやり方は、私の"}, {"type": "subtitle", "time": 11141.429, "timestamp": "03:05:41", "text": "オタキスタンの日々、私は"}, {"type": "subtitle", "time": 11145.75, "timestamp": "03:05:45", "text": "アニメ動画のレビューみたいな感じですよね？"}, {"type": "subtitle", "time": 11149.99, "timestamp": "03:05:49", "text": "多くの人が近親相姦を嫌っているのを見た"}, {"type": "subtitle", "time": 11153.51, "timestamp": "03:05:53", "text": "近親相姦アニメ、そして私は何でも好き"}, {"type": "subtitle", "time": 11155.269, "timestamp": "03:05:55", "text": "私が見た近親相姦アニメは"}, {"type": "subtitle", "time": 11158.87, "timestamp": "03:05:58", "text": "通常は良いストーリーと良いプロットを備えている"}]
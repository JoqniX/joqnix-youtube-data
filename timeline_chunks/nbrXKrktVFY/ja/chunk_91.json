[{"type": "subtitle", "time": 5461.91, "timestamp": "01:31:01", "text": "くそ。そして、私は肉を一切口にしていません。"}, {"type": "subtitle", "time": 5466.79, "timestamp": "01:31:06", "text": "待って、つまりあなたはまだ"}, {"type": "subtitle", "time": 5470.229, "timestamp": "01:31:10", "text": "それ以来、モモは？いいえ、モモは"}, {"type": "subtitle", "time": 5472.87, "timestamp": "01:31:12", "text": "作った。モモの中にはオリジナルではないものもある"}, {"type": "subtitle", "time": 5474.629, "timestamp": "01:31:14", "text": "私が好きなモモ（ネパール風餃子）。彼らはそうではない"}, {"type": "subtitle", "time": 5478.47, "timestamp": "01:31:18", "text": "肉のようなものが入っています。の"}, {"type": "subtitle", "time": 5480.55, "timestamp": "01:31:20", "text": "中身は玉ねぎと他のものだけ"}, {"type": "subtitle", "time": 5491.91, "timestamp": "01:31:31", "text": "ジョック、君はどうなんだ？あなたは何をしないのですか"}, {"type": "subtitle", "time": 5494.47, "timestamp": "01:31:34", "text": "食べるように何かありますか？"}, {"type": "subtitle", "time": 5497.189, "timestamp": "01:31:37", "text": "あなたがこだわるのはどんな点ですか？私は好き嫌いがない"}, {"type": "subtitle", "time": 5500.55, "timestamp": "01:31:40", "text": "食べる人。私が小さかった頃のように、"}, {"type": "subtitle", "time": 5503.99, "timestamp": "01:31:43", "text": "昔はトマトが嫌いだったと思うけど、今は好き"}, {"type": "subtitle", "time": 5507.669, "timestamp": "01:31:47", "text": "苦い神よ、なぜなら家には私の家族がいるから"}, {"type": "subtitle", "time": 5509.55, "timestamp": "01:31:49", "text": "作るのに使用される"}, {"type": "subtitle", "time": 5512.75, "timestamp": "01:31:52", "text": "いつも料理されたように"}, {"type": "subtitle", "time": 5516.629, "timestamp": "01:31:56", "text": "カレーとかに入ってるトマトみたいな、"}]
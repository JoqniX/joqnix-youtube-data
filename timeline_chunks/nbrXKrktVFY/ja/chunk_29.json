[{"type": "subtitle", "time": 1740.63, "timestamp": "00:29:00", "text": "星座、ジェンダーの概念"}, {"type": "subtitle", "time": 1743.51, "timestamp": "00:29:03", "text": "私には当てはまらない、あるいは何か別の理由がある。それは"}, {"type": "subtitle", "time": 1747.83, "timestamp": "00:29:07", "text": "声に関して私が感じていること。えっと"}, {"type": "subtitle", "time": 1751.669, "timestamp": "00:29:11", "text": "私の声は両性具有的です"}, {"type": "subtitle", "time": 1754.47, "timestamp": "00:29:14", "text": "もし私の理解が正しければ、声でお願いします。それは"}, {"type": "subtitle", "time": 1758.789, "timestamp": "00:29:18", "text": "友達のそれは、えっと、グーグルで調べてみる"}, {"type": "subtitle", "time": 1760.389, "timestamp": "00:29:20", "text": "それはあなたへの贈り物です。"}, {"type": "subtitle", "time": 1762.549, "timestamp": "00:29:22", "text": "なんてこった。"}, {"type": "subtitle", "time": 1773.11, "timestamp": "00:29:33", "text": "ええ、声はどちらでもない"}, {"type": "subtitle", "time": 1775.669, "timestamp": "00:29:35", "text": "男性的なものか女性的なものか、そういう類のもの。おお"}, {"type": "subtitle", "time": 1777.99, "timestamp": "00:29:37", "text": "以前はそれを無性愛者と呼んでいました"}, {"type": "subtitle", "time": 1782.07, "timestamp": "00:29:42", "text": "声。ああ。ああ、それだ"}, {"type": "subtitle", "time": 1785.269, "timestamp": "00:29:45", "text": "無性愛の声も、私が聞いているから"}, {"type": "subtitle", "time": 1787.63, "timestamp": "00:29:47", "text": "一部のユーチューバーや一部のASMアーティストへ"}, {"type": "subtitle", "time": 1791.269, "timestamp": "00:29:51", "text": "そして一部の声優と彼らが"}, {"type": "subtitle", "time": 1793.029, "timestamp": "00:29:53", "text": "コメント 人々は彼らに彼らのことについて尋ねる"}, {"type": "subtitle", "time": 1794.789, "timestamp": "00:29:54", "text": "彼らは声を上げて、「ああ、私は無性愛者です」と言う。"}, {"type": "subtitle", "time": 1796.31, "timestamp": "00:29:56", "text": "だから、私の声はああいう感じなんです。だから私は"}, {"type": "subtitle", "time": 1797.83, "timestamp": "00:29:57", "text": "それを"}]
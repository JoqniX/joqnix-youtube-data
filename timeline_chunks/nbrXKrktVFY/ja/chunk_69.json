[{"type": "subtitle", "time": 4147.669, "timestamp": "01:09:07", "text": "中国。誰が彼に"}, {"type": "subtitle", "time": 4150.149, "timestamp": "01:09:10", "text": "あれ？彼は「さあ、どうだろうな」という感じだった。"}, {"type": "subtitle", "time": 4153.189, "timestamp": "01:09:13", "text": "しかし、書類は確認済みだ。"}, {"type": "subtitle", "time": 4161.269, "timestamp": "01:09:21", "text": "そのビジネスが実際にうまくいくかどうか"}, {"type": "subtitle", "time": 4163.51, "timestamp": "01:09:23", "text": "なぜなら、太陽系を見ると、"}, {"type": "subtitle", "time": 4165.829, "timestamp": "01:09:25", "text": "銀河にはたくさんの星があり、"}, {"type": "subtitle", "time": 4168.55, "timestamp": "01:09:28", "text": "惑星は今。うん。まるで"}, {"type": "subtitle", "time": 4171.11, "timestamp": "01:09:31", "text": "地球上の砂粒の数よりも多くの惑星が存在する"}, {"type": "subtitle", "time": 4177.91, "timestamp": "01:09:37", "text": "いつものように、私はいつも"}, {"type": "subtitle", "time": 4180.309, "timestamp": "01:09:40", "text": "そういうことに魅了される"}, {"type": "subtitle", "time": 4182.95, "timestamp": "01:09:42", "text": "外には何がありますか？"}, {"type": "subtitle", "time": 4184.43, "timestamp": "01:09:44", "text": "ありますか"}, {"type": "subtitle", "time": 4198.31, "timestamp": "01:09:58", "text": "そこには？しかし、私たちは惑星も"}, {"type": "subtitle", "time": 4198.99, "timestamp": "01:09:58", "text": "ただ"}]
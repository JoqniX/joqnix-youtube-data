[{"type": "subtitle", "time": 10380.07, "timestamp": "02:53:00", "text": "両親とかと一緒です。知りませんでした"}, {"type": "subtitle", "time": 10382.55, "timestamp": "02:53:02", "text": "あなたと同じように、今これらすべてを知っています"}, {"type": "subtitle", "time": 10386.07, "timestamp": "02:53:06", "text": "アメリカ人と外国人は"}, {"type": "subtitle", "time": 10388.15, "timestamp": "02:53:08", "text": "独立した独立した弧"}, {"type": "subtitle", "time": 10390.63, "timestamp": "02:53:10", "text": "18歳以上とか。"}, {"type": "subtitle", "time": 10392.63, "timestamp": "02:53:12", "text": "そしてそのことを知ったとき、私は"}, {"type": "subtitle", "time": 10394.59, "timestamp": "02:53:14", "text": "まるで、"}, {"type": "subtitle", "time": 10397.67, "timestamp": "02:53:17", "text": "何？それはまるであなたが与えることと受け取ることのようです"}, {"type": "subtitle", "time": 10401.99, "timestamp": "02:53:21", "text": "早期の独立"}, {"type": "subtitle", "time": 10404.389, "timestamp": "02:53:24", "text": "あるいは、自分の身の振り方や"}, {"type": "subtitle", "time": 10407.83, "timestamp": "02:53:27", "text": "トレーニングとかそういうもの。いいえ。そして、いいえ、なぜなら"}, {"type": "subtitle", "time": 10409.83, "timestamp": "02:53:29", "text": "私にとってそれはあなたの家族が裏切るようなものだった"}, {"type": "subtitle", "time": 10412.71, "timestamp": "02:53:32", "text": "あなた。まるでそれが感じたような"}, {"type": "subtitle", "time": 10416.389, "timestamp": "02:53:36", "text": "自分。ああ、それもそうだね。ええ、その通りです"}, {"type": "subtitle", "time": 10423.19, "timestamp": "02:53:43", "text": "うん。両親が私を好きだったら"}, {"type": "subtitle", "time": 10424.87, "timestamp": "02:53:44", "text": "こんな感じだった。もし両親が言ったら、"}, {"type": "subtitle", "time": 10426.71, "timestamp": "02:53:46", "text": "「よし、君はもう18歳だ。家を出て行け。」"}, {"type": "subtitle", "time": 10427.63, "timestamp": "02:53:47", "text": "私はこう思う、"}, {"type": "subtitle", "time": 10429.75, "timestamp": "02:53:49", "text": "「よし、私は全員に伝えるつもりだ"}, {"type": "subtitle", "time": 10431.429, "timestamp": "02:53:51", "text": "家族の一員、あなたは私を蹴っている"}, {"type": "subtitle", "time": 10433.99, "timestamp": "02:53:53", "text": "外。\""}, {"type": "subtitle", "time": 10435.75, "timestamp": "02:53:55", "text": "私はみんなに伝えようと思う"}, {"type": "subtitle", "time": 10439.11, "timestamp": "02:53:59", "text": "彼らは息子を追い出そうとしている。"}]
[{"type": "subtitle", "time": 6541.189, "timestamp": "01:49:01", "text": "このドラマは、祖母が使っていたものです"}, {"type": "subtitle", "time": 6544.95, "timestamp": "01:49:04", "text": "彼女が生きていた頃、私はドラマが大好きでした。"}, {"type": "subtitle", "time": 6547.669, "timestamp": "01:49:07", "text": "私が何をしているか全て彼女に話した"}, {"type": "subtitle", "time": 6550.149, "timestamp": "01:49:10", "text": "オンラインでユーチューバーは何だったのか"}, {"type": "subtitle", "time": 6552.629, "timestamp": "01:49:12", "text": "フェムボーイズが何だったのか、そして彼女はできなかった"}, {"type": "subtitle", "time": 6554.55, "timestamp": "01:49:14", "text": "ほとんど理解できないだろうけど、"}, {"type": "subtitle", "time": 6557.669, "timestamp": "01:49:17", "text": "質問の合間に確認する"}, {"type": "subtitle", "time": 6560.47, "timestamp": "01:49:20", "text": "彼女が聞いていたことを示すのはどれか"}, {"type": "subtitle", "time": 6563.91, "timestamp": "01:49:23", "text": "とても可愛かった。はい。一度私が"}, {"type": "subtitle", "time": 6565.83, "timestamp": "01:49:25", "text": "なんで説明してたのか自分でもわからない"}, {"type": "subtitle", "time": 6569.109, "timestamp": "01:49:29", "text": "これは彼女へのメッセージです。私は説明していた"}, {"type": "subtitle", "time": 6572.47, "timestamp": "01:49:32", "text": "アラミアは。アラミアって何か知ってる？"}, {"type": "subtitle", "time": 6575.109, "timestamp": "01:49:35", "text": "ラミアって、あの蛇の女の子のことだよね？"}, {"type": "subtitle", "time": 6578.47, "timestamp": "01:49:38", "text": "うん。私は彼女にそのことを説明していた。"}, {"type": "subtitle", "time": 6580.229, "timestamp": "01:49:40", "text": "私は彼女にこれを説明していた"}, {"type": "subtitle", "time": 6582.35, "timestamp": "01:49:42", "text": "そして私は彼女に私が好きな理由を話していました"}, {"type": "subtitle", "time": 6585.95, "timestamp": "01:49:45", "text": "ラマたちと彼女は私にこれを尋ねた"}, {"type": "subtitle", "time": 6589.03, "timestamp": "01:49:49", "text": "質問は、とてもとても、そのような"}, {"type": "subtitle", "time": 6591.51, "timestamp": "01:49:51", "text": "いい質問だけど、それはまるで"}, {"type": "subtitle", "time": 6594.229, "timestamp": "01:49:54", "text": "おばあちゃんへの質問。"}]
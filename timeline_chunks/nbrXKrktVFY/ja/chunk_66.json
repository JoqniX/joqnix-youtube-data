[{"type": "subtitle", "time": 3961.51, "timestamp": "01:06:01", "text": "オレンジ、もし"}, {"type": "subtitle", "time": 3970.87, "timestamp": "01:06:10", "text": "Hは"}, {"type": "subtitle", "time": 3974.15, "timestamp": "01:06:14", "text": "彼女は私に何をするだろうか"}, {"type": "subtitle", "time": 3976.23, "timestamp": "01:06:16", "text": "他に奴隷はいますか？もし私が"}, {"type": "subtitle", "time": 3980.23, "timestamp": "01:06:20", "text": "それだけなら、私は大丈夫です。うん。"}, {"type": "subtitle", "time": 3982.15, "timestamp": "01:06:22", "text": "そうすれば彼女は私たちを好きになれる"}, {"type": "subtitle", "time": 3984.069, "timestamp": "01:06:24", "text": "何かそういうことが起こっている可能性がある。しかしもし彼女が"}, {"type": "subtitle", "time": 3987.029, "timestamp": "01:06:27", "text": "他の奴隷も手に入れるつもりなら、絶対に嫌だ。"}, {"type": "subtitle", "time": 3989.19, "timestamp": "01:06:29", "text": "いいえ。それなら、それらにもよります"}, {"type": "subtitle", "time": 3991.589, "timestamp": "01:06:31", "text": "奴隷とは、男性奴隷のことですか、それとも女性奴隷のことですか？"}, {"type": "subtitle", "time": 3995.069, "timestamp": "01:06:35", "text": "もし全員女性だったら、私は"}, {"type": "subtitle", "time": 4010.63, "timestamp": "01:06:50", "text": "しかし、質問に対する私の答えは"}, {"type": "subtitle", "time": 4015.43, "timestamp": "01:06:55", "text": "まるで惑星を売るみたいだった。"}]
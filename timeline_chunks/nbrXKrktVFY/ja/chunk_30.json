[{"type": "subtitle", "time": 1806.23, "timestamp": "00:30:06", "text": "ああ、それは初めて聞きました"}, {"type": "subtitle", "time": 1811.99, "timestamp": "00:30:11", "text": "賢い。"}, {"type": "subtitle", "time": 1815.11, "timestamp": "00:30:15", "text": "でも、ええ、続けて"}, {"type": "subtitle", "time": 1818.549, "timestamp": "00:30:18", "text": "えーと、もし私が4番目を破ったら"}, {"type": "subtitle", "time": 1819.47, "timestamp": "00:30:19", "text": "壁"}, {"type": "subtitle", "time": 1823.83, "timestamp": "00:30:23", "text": "私は、ええと、生物学的には男性です。"}, {"type": "subtitle", "time": 1826.789, "timestamp": "00:30:26", "text": "つまり、私は男性を"}, {"type": "subtitle", "time": 1828.789, "timestamp": "00:30:28", "text": "ストリーム。"}, {"type": "subtitle", "time": 1831.59, "timestamp": "00:30:31", "text": "配信中の男性。"}, {"type": "subtitle", "time": 1834.389, "timestamp": "00:30:34", "text": "つまり、人間の姿で、ということです。人間の姿では、"}, {"type": "subtitle", "time": 1835.99, "timestamp": "00:30:35", "text": "チャット。人間という姿の時、私たちは依然として善良な存在だ。"}, {"type": "subtitle", "time": 1838.909, "timestamp": "00:30:38", "text": "人間において。うん。人間の姿では、私は"}, {"type": "subtitle", "time": 1841.83, "timestamp": "00:30:41", "text": "男。ただ、私は柔らかいんです"}, {"type": "subtitle", "time": 1848.51, "timestamp": "00:30:48", "text": "うん。"}, {"type": "subtitle", "time": 1852.63, "timestamp": "00:30:52", "text": "そんな声で、私は"}, {"type": "subtitle", "time": 1854.43, "timestamp": "00:30:54", "text": "ナマズ釣り"}, {"type": "subtitle", "time": 1856.47, "timestamp": "00:30:56", "text": "誰か、それは良いことだ。私はそうしました"}, {"type": "subtitle", "time": 1859.11, "timestamp": "00:30:59", "text": "それもまた然り。私の初期の頃のように"}]
[{"type": "subtitle", "time": 14100.63, "timestamp": "03:55:00", "text": "彼はモイについて知らないことを知っている"}, {"type": "subtitle", "time": 14114.83, "timestamp": "03:55:14", "text": "知る。シオールが"}, {"type": "subtitle", "time": 14118.309, "timestamp": "03:55:18", "text": "しおりねは私と同い年です。その"}, {"type": "subtitle", "time": 14121.07, "timestamp": "03:55:21", "text": "考えるとクレイジーだ"}, {"type": "subtitle", "time": 14123.83, "timestamp": "03:55:23", "text": "それ。そして私は彼女が"}, {"type": "subtitle", "time": 14126.28, "timestamp": "03:55:26", "text": "彼女が何かをしている間。"}, {"type": "subtitle", "time": 14129.03, "timestamp": "03:55:29", "text": "[音楽]"}, {"type": "subtitle", "time": 14131.71, "timestamp": "03:55:31", "text": "彼女がいなくて寂しいよ、昔の彼女みたいに"}, {"type": "subtitle", "time": 14134.95, "timestamp": "03:55:34", "text": "彼女がそうだった頃の性格"}, {"type": "subtitle", "time": 14141.07, "timestamp": "03:55:41", "text": "でも今は彼女は"}, {"type": "subtitle", "time": 14144.469, "timestamp": "03:55:44", "text": "さらに、何と言えばいいでしょうか、魅力が増すのです。うん、"}, {"type": "subtitle", "time": 14147.91, "timestamp": "03:55:47", "text": "彼女は以前よりも心を開いているように見える。ええ、私は"}, {"type": "subtitle", "time": 14150.309, "timestamp": "03:55:50", "text": "昔は覚えていたけど、モイを見てたのを覚えてる"}, {"type": "subtitle", "time": 14152.269, "timestamp": "03:55:52", "text": "のように"}, {"type": "subtitle", "time": 14157.59, "timestamp": "03:55:57", "text": "トゥイッチ。ええ、全く同じです。うん。私"}, {"type": "subtitle", "time": 14159.99, "timestamp": "03:55:59", "text": "彼女を見ていて、5 ごとに"}]
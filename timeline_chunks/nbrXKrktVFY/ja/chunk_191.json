[{"type": "subtitle", "time": 11461.429, "timestamp": "03:11:01", "text": "何？ホロの状況が良くなることを願っています。"}, {"type": "subtitle", "time": 11465.11, "timestamp": "03:11:05", "text": "ファンとして、私もそう願っています。うん、"}, {"type": "subtitle", "time": 11467.269, "timestamp": "03:11:07", "text": "ハンが去るのを見た瞬間、私は"}, {"type": "subtitle", "time": 11478.23, "timestamp": "03:11:18", "text": "ハンは彼女が好きだった時からそこにいたから"}, {"type": "subtitle", "time": 11482.87, "timestamp": "03:11:22", "text": "そこにいたが、それは起こった。"}, {"type": "subtitle", "time": 11484.59, "timestamp": "03:11:24", "text": "彼女の去り方は"}, {"type": "subtitle", "time": 11493.75, "timestamp": "03:11:33", "text": "ハンとソラのように、彼らは始めた"}, {"type": "subtitle", "time": 11496.309, "timestamp": "03:11:36", "text": "すべて、ですよね？"}, {"type": "subtitle", "time": 11499.429, "timestamp": "03:11:39", "text": "まるで彼らが最初は神聖な存在だったかのように。はい。"}, {"type": "subtitle", "time": 11506.469, "timestamp": "03:11:46", "text": "そして、ソラが"}, {"type": "subtitle", "time": 11508.87, "timestamp": "03:11:48", "text": "去れば全てが終わる。終わりました。"}, {"type": "subtitle", "time": 11511.269, "timestamp": "03:11:51", "text": "終わりました。終わりました。はい。真実。もちろん。"}, {"type": "subtitle", "time": 11514.07, "timestamp": "03:11:54", "text": "終わりました。私は、"}, {"type": "subtitle", "time": 11517.75, "timestamp": "03:11:57", "text": "ホリヴ。彼らが去るなら、私も去る。私はもし"}]
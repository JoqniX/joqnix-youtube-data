[{"type": "subtitle", "time": 2100.15, "timestamp": "00:35:00", "text": "1時間ほどのスペース"}, {"type": "subtitle", "time": 2102.55, "timestamp": "00:35:02", "text": "私のノートパソコンには何かが付属しています"}, {"type": "subtitle", "time": 2105.349, "timestamp": "00:35:05", "text": "そして配信して、はい、それで終わりです"}, {"type": "subtitle", "time": 2108.39, "timestamp": "00:35:08", "text": "それとネットのようなもの"}, {"type": "subtitle", "time": 2112.15, "timestamp": "00:35:12", "text": "カフェみたいなやつ、そうそう、私たちは行って、"}, {"type": "subtitle", "time": 2114.55, "timestamp": "00:35:14", "text": "そんな場所を探そうと思った"}, {"type": "subtitle", "time": 2118.069, "timestamp": "00:35:18", "text": "日本ならおそらく私は"}, {"type": "subtitle", "time": 2120.069, "timestamp": "00:35:20", "text": "推測。うん。うん。私はビデオを見た"}, {"type": "subtitle", "time": 2124.55, "timestamp": "00:35:24", "text": "人々はネットカフェに住むことを好む。"}, {"type": "subtitle", "time": 2127.109, "timestamp": "00:35:27", "text": "すごく興味深いですね。それは"}, {"type": "subtitle", "time": 2129.15, "timestamp": "00:35:29", "text": "より良い選択肢"}, {"type": "subtitle", "time": 2132.31, "timestamp": "00:35:32", "text": "自分。でも、すべてがうまくいくことを願おう"}, {"type": "subtitle", "time": 2134.87, "timestamp": "00:35:34", "text": "良い。だから、楽しもうとしてるんだ"}, {"type": "subtitle", "time": 2137.109, "timestamp": "00:35:37", "text": "みんなと楽しい時間を過ごしましょう"}, {"type": "subtitle", "time": 2138.95, "timestamp": "00:35:38", "text": "私がこれまで出会った人は"}, {"type": "subtitle", "time": 2143.109, "timestamp": "00:35:43", "text": "旅。それで、そう、そこにそこに"}, {"type": "subtitle", "time": 2144.87, "timestamp": "00:35:44", "text": "たくさんの人がいるはずだった"}, {"type": "subtitle", "time": 2147.15, "timestamp": "00:35:47", "text": "コラボレーションしたい、もしくは一緒に時間を過ごしたい"}, {"type": "subtitle", "time": 2150.55, "timestamp": "00:35:50", "text": "で、でも今は全員を捕まえることはできないので"}, {"type": "subtitle", "time": 2153.67, "timestamp": "00:35:53", "text": "えっと、もう6月ですね。6月は"}, {"type": "subtitle", "time": 2157.349, "timestamp": "00:35:57", "text": "近いうちに来る予定で、"}]
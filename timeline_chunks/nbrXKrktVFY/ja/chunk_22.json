[{"type": "subtitle", "time": 1323.83, "timestamp": "00:22:03", "text": "チェッカー。あれは青色だった。"}, {"type": "subtitle", "time": 1334.95, "timestamp": "00:22:14", "text": "いいえ。ああ、これです。待って、ペブルス。何？"}, {"type": "subtitle", "time": 1337.83, "timestamp": "00:22:17", "text": "待って、チャットであ​​なたの声が聞こえないみたい。どこ？"}, {"type": "subtitle", "time": 1339.59, "timestamp": "00:22:19", "text": "待って、チャットがあなたの声を聞き取れない"}, {"type": "subtitle", "time": 1351.029, "timestamp": "00:22:31", "text": "いいえ、彼らはあなたの声を聞いています。"}, {"type": "subtitle", "time": 1352.95, "timestamp": "00:22:32", "text": "彼らはできるのだろうか？ええ、私は"}, {"type": "subtitle", "time": 1354.71, "timestamp": "00:22:34", "text": "チャット相手に寸劇のように話しかける。だから私は"}, {"type": "subtitle", "time": 1356.39, "timestamp": "00:22:36", "text": "「ああ、みんな、ジョックがここにいるよ。」"}, {"type": "subtitle", "time": 1359.35, "timestamp": "00:22:39", "text": "ほら、ほら、みんな、彼がここにいるよ。彼らは"}, {"type": "subtitle", "time": 1360.669, "timestamp": "00:22:40", "text": "聞こえません"}, {"type": "subtitle", "time": 1362.63, "timestamp": "00:22:42", "text": "その間。とにかく、すべて順調です。"}, {"type": "subtitle", "time": 1365.35, "timestamp": "00:22:45", "text": "私側から言えば。君の味方は大丈夫かい？"}, {"type": "subtitle", "time": 1367.19, "timestamp": "00:22:47", "text": "うん。"}, {"type": "subtitle", "time": 1368.63, "timestamp": "00:22:48", "text": "では、紹介したいですか？"}, {"type": "subtitle", "time": 1371.19, "timestamp": "00:22:51", "text": "あなた自身ですか？ええ、もちろんです。もちろん。こんにちは"}, {"type": "subtitle", "time": 1375.909, "timestamp": "00:22:55", "text": "みんな。私の名前はジョックンです。私はアストラルです"}, {"type": "subtitle", "time": 1379.669, "timestamp": "00:22:59", "text": "インド出身のコンステレーション系YouTuber。"}]
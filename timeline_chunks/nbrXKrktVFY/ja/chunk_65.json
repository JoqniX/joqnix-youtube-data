[{"type": "subtitle", "time": 3904.63, "timestamp": "01:05:04", "text": "何てことだ。世界は犬だ。お願いします"}, {"type": "subtitle", "time": 3907.27, "timestamp": "01:05:07", "text": "冗談だよ。"}, {"type": "subtitle", "time": 3909.99, "timestamp": "01:05:09", "text": "なぜ？最近遊んでいた"}, {"type": "subtitle", "time": 3912.549, "timestamp": "01:05:12", "text": "このゲームには奴隷制度が登場する。パル"}, {"type": "subtitle", "time": 3915.109, "timestamp": "01:05:15", "text": "世界。ああ、"}, {"type": "subtitle", "time": 3916.95, "timestamp": "01:05:16", "text": "私は、なぜ人々がそうしないのか不思議に思います"}, {"type": "subtitle", "time": 3919.67, "timestamp": "01:05:19", "text": "これを現実世界でやってみる。それはとてもとても"}, {"type": "subtitle", "time": 3927.67, "timestamp": "01:05:27", "text": "ええ、NPCがあなたのために働かせているんですよ。"}, {"type": "subtitle", "time": 3929.589, "timestamp": "01:05:29", "text": "うん。 「わあ、すごく便利だ」って感じでした。"}, {"type": "subtitle", "time": 3931.99, "timestamp": "01:05:31", "text": "彼らにあなたのために働かせればいいのです。まるで"}, {"type": "subtitle", "time": 3935.19, "timestamp": "01:05:35", "text": "それはまるで無料のレイプ、無料の労働のようなものだ。私はしません"}, {"type": "subtitle", "time": 3942.27, "timestamp": "01:05:42", "text": "何てことだ。そして私は気づいた、"}, {"type": "subtitle", "time": 3947.309, "timestamp": "01:05:47", "text": "待って、"}, {"type": "subtitle", "time": 3950.349, "timestamp": "01:05:50", "text": "過去？のように、"}, {"type": "subtitle", "time": 3959.349, "timestamp": "01:05:59", "text": "はい、チャットで誰かが私に質問しました。"}]
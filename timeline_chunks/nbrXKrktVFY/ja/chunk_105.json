[{"type": "subtitle", "time": 6301.109, "timestamp": "01:45:01", "text": "悲しい"}, {"type": "subtitle", "time": 6302.91, "timestamp": "01:45:02", "text": "ほとんどの"}, {"type": "subtitle", "time": 6305.83, "timestamp": "01:45:05", "text": "時間。かつて私がやっていたことの一つは"}, {"type": "subtitle", "time": 6307.91, "timestamp": "01:45:07", "text": "今は健康に良くないので、私はやりません。"}, {"type": "subtitle", "time": 6309.99, "timestamp": "01:45:09", "text": "私の元カノの一人みたいに、彼女は私をここから連れ出してくれた"}, {"type": "subtitle", "time": 6311.75, "timestamp": "01:45:11", "text": "悪い癖。"}, {"type": "subtitle", "time": 6314.79, "timestamp": "01:45:14", "text": "私は自分を侮辱して、何が"}, {"type": "subtitle", "time": 6317.99, "timestamp": "01:45:17", "text": "気分が悪い。"}, {"type": "subtitle", "time": 6321.189, "timestamp": "01:45:21", "text": "侮辱的、批判的、または「うん」のように。"}, {"type": "subtitle", "time": 6322.79, "timestamp": "01:45:22", "text": "批判するのではなく、ただ呼ぶだけです"}, {"type": "subtitle", "time": 6325.83, "timestamp": "01:45:25", "text": "自分で名前を付けて、自分に合うものを見つけていく。"}, {"type": "subtitle", "time": 6328.79, "timestamp": "01:45:28", "text": "これまでで一番ひどいことを言うようなものだ"}, {"type": "subtitle", "time": 6335.27, "timestamp": "01:45:35", "text": "そして、誰がそんなことを言えるのか想像してみる"}, {"type": "subtitle", "time": 6339.109, "timestamp": "01:45:39", "text": "私にとってそれは私を傷つける可能性があり、"}, {"type": "subtitle", "time": 6340.55, "timestamp": "01:45:40", "text": "それは本当にひどい行為だった。"}, {"type": "subtitle", "time": 6343.83, "timestamp": "01:45:43", "text": "ジョーク。やめてください。ええ、私は"}, {"type": "subtitle", "time": 6344.91, "timestamp": "01:45:44", "text": "たくさんの"}, {"type": "subtitle", "time": 6349.03, "timestamp": "01:45:49", "text": "その日の私。でも、元カレにこれを話したら、"}, {"type": "subtitle", "time": 6350.95, "timestamp": "01:45:50", "text": "彼女は「なんでそんなことするのよ」って感じだった"}, {"type": "subtitle", "time": 6352.79, "timestamp": "01:45:52", "text": "「そんなことを自分にするの？」って感じ。"}, {"type": "subtitle", "time": 6356.47, "timestamp": "01:45:56", "text": "「それは間違っているのか？」私はただ準備しているだけです"}, {"type": "subtitle", "time": 6358.709, "timestamp": "01:45:58", "text": "自分自身。例えば、誰かが私に悪口を言ったら、"}]
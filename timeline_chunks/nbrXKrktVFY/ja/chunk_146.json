[{"type": "subtitle", "time": 8764.469, "timestamp": "02:26:04", "text": "まるで、相互作用する方法があるかのように"}, {"type": "subtitle", "time": 8767.83, "timestamp": "02:26:07", "text": "何か言いたいことがあれば"}, {"type": "subtitle", "time": 8771.27, "timestamp": "02:26:11", "text": "そのユーチューバー。ある種の期間がある"}, {"type": "subtitle", "time": 8774.55, "timestamp": "02:26:14", "text": "そこで、そのことを言うと、"}, {"type": "subtitle", "time": 8778.07, "timestamp": "02:26:18", "text": "彼女がそれを読むことは100％確実だ。これはまるで"}, {"type": "subtitle", "time": 8782.469, "timestamp": "02:26:22", "text": "バッファ時間。うん。"}, {"type": "subtitle", "time": 8783.99, "timestamp": "02:26:23", "text": "そして私はこれを友人に説明していた"}, {"type": "subtitle", "time": 8785.99, "timestamp": "02:26:25", "text": "そして彼は「ああ、一体どういうことだ？」と言った。"}, {"type": "subtitle", "time": 8788.23, "timestamp": "02:26:28", "text": "まるでダークソウルのボスみたいだ。あなたのような"}, {"type": "subtitle", "time": 8791.19, "timestamp": "02:26:31", "text": "この1ピクセルを攻撃しなければならない"}, {"type": "subtitle", "time": 8801.99, "timestamp": "02:26:41", "text": "まるで楽しいみたいだ。"}, {"type": "subtitle", "time": 8804.23, "timestamp": "02:26:44", "text": "楽しいですよ。だから私はただ見るだけです、スパムしないでください"}, {"type": "subtitle", "time": 8805.59, "timestamp": "02:26:45", "text": "チャット。私はまるで"}, {"type": "subtitle", "time": 8807.83, "timestamp": "02:26:47", "text": "何か面白いことを言おうと思うけど、ただ我慢するだけ"}, {"type": "subtitle", "time": 8810.07, "timestamp": "02:26:50", "text": "あの物と、彼女が近くにいるときはわかる"}, {"type": "subtitle", "time": 8816.91, "timestamp": "02:26:56", "text": "そして"}, {"type": "subtitle", "time": 8819.67, "timestamp": "02:26:59", "text": "なぜかわかりませんが、これを見たことがあります"}]
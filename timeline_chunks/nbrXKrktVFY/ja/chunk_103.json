[{"type": "subtitle", "time": 6180.31, "timestamp": "01:43:00", "text": "何らかの理由で、私は"}, {"type": "subtitle", "time": 6182.709, "timestamp": "01:43:02", "text": "編集中はヘッドホンを使っていたのですが、"}, {"type": "subtitle", "time": 6184.95, "timestamp": "01:43:04", "text": "必要のないことをする"}, {"type": "subtitle", "time": 6188.79, "timestamp": "01:43:08", "text": "オーディオ。うん。"}, {"type": "subtitle", "time": 6190.51, "timestamp": "01:43:10", "text": "そして私は始めた"}, {"type": "subtitle", "time": 6195.07, "timestamp": "01:43:15", "text": "議長に私が"}, {"type": "subtitle", "time": 6197.669, "timestamp": "01:43:17", "text": "実行中。そして一瞬、"}, {"type": "subtitle", "time": 6199.75, "timestamp": "01:43:19", "text": "第二に、誰かが"}, {"type": "subtitle", "time": 6202.07, "timestamp": "01:43:22", "text": "椅子を操作していた人は"}, {"type": "subtitle", "time": 6206.629, "timestamp": "01:43:26", "text": "自分。 A それで、私はこんな会話をした"}, {"type": "chat", "time": 6206.661, "timestamp": "01:43:26", "author": "@BRUCELEE-wt7hk", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kywKa6HSckNVxhER8qedLRRVkcGIqFFytjQHe-071HyMo=s64-c-k-c0x00ffffff-no-rj", "message": "chalo I will see you later bye"}, {"type": "subtitle", "time": 6209.109, "timestamp": "01:43:29", "text": "えーと、YouTuberや私がやってることを気に入ってくれる人"}, {"type": "subtitle", "time": 6211.109, "timestamp": "01:43:31", "text": "私の人生で、私たちはまるで"}, {"type": "subtitle", "time": 6214.149, "timestamp": "01:43:34", "text": "とても素敵な会話があります"}, {"type": "subtitle", "time": 6215.75, "timestamp": "01:43:35", "text": "妹が私の部屋に入ってきて"}, {"type": "subtitle", "time": 6218.189, "timestamp": "01:43:38", "text": "彼女は「一体誰に話しかけてるの？」って感じ"}, {"type": "subtitle", "time": 6220.189, "timestamp": "01:43:40", "text": "に？いいえ"}, {"type": "subtitle", "time": 6222.55, "timestamp": "01:43:42", "text": "彼女は「なぜこの椅子が？」と尋ねます。"}, {"type": "subtitle", "time": 6223.75, "timestamp": "01:43:43", "text": "私は「わからない」という感じです。今見たところです"}, {"type": "subtitle", "time": 6226.669, "timestamp": "01:43:46", "text": "外に出て、そのまま持ち込む"}, {"type": "subtitle", "time": 6229.43, "timestamp": "01:43:49", "text": "えっと、私は今、Kitso の瞬間を経験しました"}, {"type": "chat", "time": 6230.773, "timestamp": "01:43:50", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "hai take care bruce lee san"}, {"type": "subtitle", "time": 6235.189, "timestamp": "01:43:55", "text": "そして、"}, {"type": "subtitle", "time": 6236.55, "timestamp": "01:43:56", "text": "それ。時々私は座っている"}, {"type": "subtitle", "time": 6239.27, "timestamp": "01:43:59", "text": "私の部屋で。私はそれらの物語を投稿します"}]
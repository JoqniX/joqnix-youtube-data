[{"type": "subtitle", "time": 14580.309, "timestamp": "04:03:00", "text": "VTuber"}, {"type": "subtitle", "time": 14582.87, "timestamp": "04:03:02", "text": "うん。彼の顔が明らかになる前にも。だから彼は"}, {"type": "subtitle", "time": 14584.79, "timestamp": "04:03:04", "text": "彼は以前に顔出しをしなかったのか？"}, {"type": "subtitle", "time": 14587.189, "timestamp": "04:03:07", "text": "それ。"}, {"type": "subtitle", "time": 14595.59, "timestamp": "04:03:15", "text": "キャリーを見るのが大好きだった"}, {"type": "subtitle", "time": 14598.309, "timestamp": "04:03:18", "text": "彼が確か1万ドルくらい持っていた頃"}, {"type": "subtitle", "time": 14600.11, "timestamp": "04:03:20", "text": "購読者、10人または"}, {"type": "subtitle", "time": 14602.11, "timestamp": "04:03:22", "text": "20K、作った"}, {"type": "subtitle", "time": 14607.429, "timestamp": "04:03:27", "text": "奇妙な短い愚痴動画みたいなもの。"}, {"type": "subtitle", "time": 14608.71, "timestamp": "04:03:28", "text": "うん。"}, {"type": "subtitle", "time": 14611.03, "timestamp": "04:03:31", "text": "そして彼が、彼が手に入れたとき、私は思う"}, {"type": "subtitle", "time": 14613.429, "timestamp": "04:03:33", "text": "200万人の登録者数に達したとき、私は"}, {"type": "subtitle", "time": 14615.309, "timestamp": "04:03:35", "text": "彼をただ見ている"}, {"type": "subtitle", "time": 14617.83, "timestamp": "04:03:37", "text": "内容が感じ始めたので"}, {"type": "subtitle", "time": 14621.59, "timestamp": "04:03:41", "text": "台本通り、いや、台本通りすぎる。"}, {"type": "subtitle", "time": 14623.269, "timestamp": "04:03:43", "text": "まるで彼が意地悪をしていたかのように"}, {"type": "subtitle", "time": 14626.229, "timestamp": "04:03:46", "text": "意地悪であること。"}, {"type": "subtitle", "time": 14628.67, "timestamp": "04:03:48", "text": "うん。その"}, {"type": "subtitle", "time": 14631.429, "timestamp": "04:03:51", "text": "なんて言うんだっけ？誰かが"}, {"type": "subtitle", "time": 14634.309, "timestamp": "04:03:54", "text": "何か言ってるよね、彼らは言う"}, {"type": "subtitle", "time": 14637.349, "timestamp": "04:03:57", "text": "その瞬間にあなたにとって何か意味のあるもの。あなたは"}, {"type": "subtitle", "time": 14639.11, "timestamp": "04:03:59", "text": "「ああ、君は彼らがそうではないことを知っている」"}]
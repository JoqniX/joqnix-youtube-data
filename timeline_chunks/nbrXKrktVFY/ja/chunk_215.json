[{"type": "subtitle", "time": 12900.03, "timestamp": "03:35:00", "text": "インド人みたいに、えーとインド人のユーチューバーみたいに"}, {"type": "subtitle", "time": 12904.15, "timestamp": "03:35:04", "text": "コミュニティではなくコミュニティグループジェンベース"}, {"type": "subtitle", "time": 12907.349, "timestamp": "03:35:07", "text": "インド料理について。知ってるでしょ、"}, {"type": "subtitle", "time": 12910.469, "timestamp": "03:35:10", "text": "実際に日本のユーチューバーは"}, {"type": "subtitle", "time": 12913.75, "timestamp": "03:35:13", "text": "インド文化に深く入り込みすぎている"}, {"type": "subtitle", "time": 12915.59, "timestamp": "03:35:15", "text": "たぶん、私は自分の"}, {"type": "subtitle", "time": 12917.83, "timestamp": "03:35:17", "text": "ストリームには、これがある"}, {"type": "subtitle", "time": 12921.99, "timestamp": "03:35:21", "text": "いつも話しているユーチューバーは"}, {"type": "subtitle", "time": 12924.55, "timestamp": "03:35:24", "text": "インド料理が好きで、"}, {"type": "subtitle", "time": 12927.349, "timestamp": "03:35:27", "text": "インド人、彼女を見たことがある。"}, {"type": "subtitle", "time": 12929.83, "timestamp": "03:35:29", "text": "うん。うん。それってかっこいいよね。なぜだめですか"}, {"type": "subtitle", "time": 12936.269, "timestamp": "03:35:36", "text": "[音楽]"}, {"type": "chat", "time": 12941.269, "timestamp": "03:35:41", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "his model too!"}, {"type": "subtitle", "time": 12941.79, "timestamp": "03:35:41", "text": "そんなに頻繁に配信してるわけじゃないよね？"}, {"type": "subtitle", "time": 12951.07, "timestamp": "03:35:51", "text": "でも私は"}, {"type": "subtitle", "time": 12953.59, "timestamp": "03:35:53", "text": "ほら、私もこれについて文句を言うつもりだよ"}, {"type": "subtitle", "time": 12955.19, "timestamp": "03:35:55", "text": "私の友人たちはいつもそれを語り継ぐだろう"}, {"type": "subtitle", "time": 12956.95, "timestamp": "03:35:56", "text": "黒いオレンジになる。もしあなたが望むなら"}]
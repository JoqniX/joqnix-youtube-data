[{"type": "subtitle", "time": 11220.15, "timestamp": "03:07:00", "text": "[音楽]"}, {"type": "subtitle", "time": 11221.83, "timestamp": "03:07:01", "text": "それで、私はこのキャラクターを演じてきました"}, {"type": "subtitle", "time": 11230.55, "timestamp": "03:07:10", "text": "近親相姦は、私が支持しているからです。"}, {"type": "subtitle", "time": 11233.429, "timestamp": "03:07:13", "text": "物語、そのジャンル。私は好きです"}, {"type": "subtitle", "time": 11235.59, "timestamp": "03:07:15", "text": "人々が持ち込むことができる表現"}, {"type": "subtitle", "time": 11238.389, "timestamp": "03:07:18", "text": "コンセプトと同様に、"}, {"type": "subtitle", "time": 11241.11, "timestamp": "03:07:21", "text": "右？人々は良い物語を書くことができる"}, {"type": "subtitle", "time": 11243.91, "timestamp": "03:07:23", "text": "悪いことと共に。"}, {"type": "subtitle", "time": 11247.349, "timestamp": "03:07:27", "text": "うん。異世界転生と同じように、奴隷制度が存在する。"}, {"type": "subtitle", "time": 11250.15, "timestamp": "03:07:30", "text": "現実世界での奴隷制度は悪いが、異世界では"}, {"type": "subtitle", "time": 11257.19, "timestamp": "03:07:37", "text": "今、彼は奴隷を手に入れているので、"}, {"type": "subtitle", "time": 11266.71, "timestamp": "03:07:46", "text": "だから私は近親相姦になった"}, {"type": "subtitle", "time": 11269.91, "timestamp": "03:07:49", "text": "男で、面白かったのは、私が好きだったから"}, {"type": "subtitle", "time": 11271.23, "timestamp": "03:07:51", "text": "これに合わせて"}, {"type": "subtitle", "time": 11274.99, "timestamp": "03:07:54", "text": "人々は"}, {"type": "subtitle", "time": 11278.87, "timestamp": "03:07:58", "text": "怒っている私は何人かの人が"}]
[{"type": "subtitle", "time": 13440.71, "timestamp": "03:44:00", "text": "ウェブサイトの卒業生の何か"}, {"type": "subtitle", "time": 13444.15, "timestamp": "03:44:04", "text": "そう、これは存在していた"}, {"type": "subtitle", "time": 13446.469, "timestamp": "03:44:06", "text": "その会社と彼らはそうではない"}, {"type": "subtitle", "time": 13448.309, "timestamp": "03:44:08", "text": "完全に卒業したというよりは、"}, {"type": "subtitle", "time": 13450.389, "timestamp": "03:44:10", "text": "ウェブサイトからも削除する"}, {"type": "subtitle", "time": 13453.51, "timestamp": "03:44:13", "text": "それは完全に消去するようなものです。いや、何でもいい"}, {"type": "subtitle", "time": 13457.11, "timestamp": "03:44:17", "text": "ここにはズチはいなかった。ズキです。何"}, {"type": "subtitle", "time": 13458.63, "timestamp": "03:44:18", "text": "あなたは自分のコントについて話していますか、"}, {"type": "subtitle", "time": 13460.79, "timestamp": "03:44:20", "text": "何か？ええ、そうなるでしょう"}, {"type": "subtitle", "time": 13463.349, "timestamp": "03:44:23", "text": "そんなことは決して起こらなかった。そして私はそれが嫌いだった"}, {"type": "subtitle", "time": 13466.469, "timestamp": "03:44:26", "text": "なぜ彼らは一生懸命働いたのか"}, {"type": "subtitle", "time": 13467.99, "timestamp": "03:44:27", "text": "採用された"}, {"type": "subtitle", "time": 13471.269, "timestamp": "03:44:31", "text": "えーと普通の人たちを"}, {"type": "subtitle", "time": 13475.389, "timestamp": "03:44:35", "text": "実際のエンターテイメントライブの才能と"}, {"type": "subtitle", "time": 13478.07, "timestamp": "03:44:38", "text": "そして、それまでの努力をすべて無駄にする。彼らは"}, {"type": "subtitle", "time": 13480.229, "timestamp": "03:44:40", "text": "2年間一生懸命働いた。それはまるで"}, {"type": "subtitle", "time": 13481.75, "timestamp": "03:44:41", "text": "悪い。"}, {"type": "subtitle", "time": 13484.55, "timestamp": "03:44:44", "text": "でも私はアドバイスしたり、"}, {"type": "subtitle", "time": 13486.469, "timestamp": "03:44:46", "text": "彼に会社経営の方法を教え、"}, {"type": "subtitle", "time": 13490.229, "timestamp": "03:44:50", "text": "すべて。いいえ。それは良くないですね。しかし"}, {"type": "subtitle", "time": 13492.95, "timestamp": "03:44:52", "text": "少なくとも、彼らが私の"}, {"type": "subtitle", "time": 13495.269, "timestamp": "03:44:55", "text": "このミョウバンのやつから"}, {"type": "subtitle", "time": 13497.91, "timestamp": "03:44:57", "text": "Webサイト。ところで、ジョー、私は"}]
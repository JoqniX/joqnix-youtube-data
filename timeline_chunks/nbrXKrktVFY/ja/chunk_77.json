[{"type": "subtitle", "time": 4627.59, "timestamp": "01:17:07", "text": "[音楽]"}, {"type": "subtitle", "time": 4630.07, "timestamp": "01:17:10", "text": "今はもう、そのことが頭から離れない。私は"}, {"type": "subtitle", "time": 4632.47, "timestamp": "01:17:12", "text": "まだ考えているところです。一体どういうことだ？"}, {"type": "subtitle", "time": 4634.47, "timestamp": "01:17:14", "text": "最初にこの質問を読んだとき、"}, {"type": "subtitle", "time": 4636.47, "timestamp": "01:17:16", "text": "私は「ああ、一つだけ大丈夫」と思った"}, {"type": "subtitle", "time": 4639.35, "timestamp": "01:17:19", "text": "自分自身について嫌い。私は自分を憎むことができる"}, {"type": "subtitle", "time": 4643.27, "timestamp": "01:17:23", "text": "それでいいんです。 Mだけど、嫌ってないよ"}, {"type": "subtitle", "time": 4644.87, "timestamp": "01:17:24", "text": "あなた自身は大丈夫ではありません、なぜならあなたが"}, {"type": "subtitle", "time": 4648.149, "timestamp": "01:17:28", "text": "じっくり考えてみてください"}, {"type": "subtitle", "time": 4652.07, "timestamp": "01:17:32", "text": "あなたはガイドが疑っている"}, {"type": "subtitle", "time": 4655.75, "timestamp": "01:17:35", "text": "それはあなたを支え続けるようなものです"}, {"type": "subtitle", "time": 4658.63, "timestamp": "01:17:38", "text": "つまり、こんなものがあると想像してみてください"}, {"type": "subtitle", "time": 4660.83, "timestamp": "01:17:40", "text": "あなたを生かし続ける"}, {"type": "subtitle", "time": 4664.39, "timestamp": "01:17:44", "text": "そうですね、このように見てください"}, {"type": "subtitle", "time": 4667.75, "timestamp": "01:17:47", "text": "心臓は血液を送り出すために一生懸命働いています"}, {"type": "subtitle", "time": 4670.07, "timestamp": "01:17:50", "text": "血液を送り出すもの"}, {"type": "subtitle", "time": 4672.31, "timestamp": "01:17:52", "text": "彼らは皆と同じように一生懸命働いています"}, {"type": "subtitle", "time": 4674.39, "timestamp": "01:17:54", "text": "あなたの一部、あるいはすべての臓器と同じように"}, {"type": "subtitle", "time": 4676.63, "timestamp": "01:17:56", "text": "一生懸命働いています。はい。そしてその間"}, {"type": "subtitle", "time": 4678.229, "timestamp": "01:17:58", "text": "脳は「あぁ、ちょっと嫌だ」って感じ"}]
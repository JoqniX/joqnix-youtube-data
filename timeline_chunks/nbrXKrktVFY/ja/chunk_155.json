[{"type": "subtitle", "time": 9300.23, "timestamp": "02:35:00", "text": "それ。だから、彼らがそれでいいと言ったのは"}, {"type": "subtitle", "time": 9304.309, "timestamp": "02:35:04", "text": "彼らは抑圧された人々だったから、"}, {"type": "subtitle", "time": 9307.11, "timestamp": "02:35:07", "text": "右？"}, {"type": "subtitle", "time": 9309.429, "timestamp": "02:35:09", "text": "そして時が経つにつれて"}, {"type": "subtitle", "time": 9310.99, "timestamp": "02:35:10", "text": "えっと、"}, {"type": "subtitle", "time": 9313.75, "timestamp": "02:35:13", "text": "ラップのおかげで主流になった"}, {"type": "subtitle", "time": 9316.23, "timestamp": "02:35:16", "text": "ラップカルチャーというもの、ラッパーたちは"}, {"type": "subtitle", "time": 9319.349, "timestamp": "02:35:19", "text": "彼らの歌でそれを使って、それから"}, {"type": "subtitle", "time": 9323.75, "timestamp": "02:35:23", "text": "グローバル化が進んでいる、ということですよね？うん。"}, {"type": "subtitle", "time": 9326.95, "timestamp": "02:35:26", "text": "そして議論が始まった。"}, {"type": "subtitle", "time": 9328.23, "timestamp": "02:35:28", "text": "白人がそれを言うべきなのか？なぜなら彼らは"}, {"type": "subtitle", "time": 9331.91, "timestamp": "02:35:31", "text": "それを次のような方法で使用していたのは"}, {"type": "subtitle", "time": 9335.03, "timestamp": "02:35:35", "text": "ひどかった。"}, {"type": "subtitle", "time": 9337.91, "timestamp": "02:35:37", "text": "でも個人的にはそうは思わない"}, {"type": "subtitle", "time": 9342.15, "timestamp": "02:35:42", "text": "どんな言葉も悪いとは思わない"}, {"type": "subtitle", "time": 9345.67, "timestamp": "02:35:45", "text": "特定の言い方をするまでは。"}, {"type": "subtitle", "time": 9348.71, "timestamp": "02:35:48", "text": "うん。意地悪な言い方をしないなら、いいねしてね。"}, {"type": "subtitle", "time": 9351.51, "timestamp": "02:35:51", "text": "私も「R」という言葉には同じような疑問を持っています。"}, {"type": "subtitle", "time": 9353.99, "timestamp": "02:35:53", "text": "なぜ一部の人はそれを言うことができるのか"}, {"type": "subtitle", "time": 9356.389, "timestamp": "02:35:56", "text": "そして、それを言わない人もいるの？いいえ、私は"}]
[{"type": "subtitle", "time": 1500.51, "timestamp": "00:25:00", "text": "もの"}, {"type": "subtitle", "time": 1502.87, "timestamp": "00:25:02", "text": "そして、自分が何をしているのかよくわからない"}, {"type": "subtitle", "time": 1507.23, "timestamp": "00:25:07", "text": "今。私はただ自分のしたいことをしているだけです"}, {"type": "subtitle", "time": 1510.31, "timestamp": "00:25:10", "text": "それ。ジョック、君はどうなんだ？どのようにすれば"}, {"type": "subtitle", "time": 1513.51, "timestamp": "00:25:13", "text": "自己紹介をしてください。はぁ？どうすれば"}, {"type": "subtitle", "time": 1515.83, "timestamp": "00:25:15", "text": "私自身について説明してください。どうですか"}, {"type": "subtitle", "time": 1517.51, "timestamp": "00:25:17", "text": "コンテンツについて説明してください。なぜなら私にとって"}, {"type": "subtitle", "time": 1519.75, "timestamp": "00:25:19", "text": "それは本当に興味深いのですが、人々は尋ねます"}, {"type": "subtitle", "time": 1521.43, "timestamp": "00:25:21", "text": "私：YouTubeではどんな動画を作ってるの？のように"}, {"type": "subtitle", "time": 1525.35, "timestamp": "00:25:25", "text": "以前はヘンタイのレビューを書いていて"}, {"type": "subtitle", "time": 1528.07, "timestamp": "00:25:28", "text": "そして私はこのグループに受け入れられました"}, {"type": "subtitle", "time": 1530.95, "timestamp": "00:25:30", "text": "アニメ関連のものを作った場所"}, {"type": "subtitle", "time": 1533.909, "timestamp": "00:25:33", "text": "そしてその前はコスプレをしていた"}, {"type": "subtitle", "time": 1536.07, "timestamp": "00:25:36", "text": "そしてその前はレビューを書いていました"}, {"type": "subtitle", "time": 1539.95, "timestamp": "00:25:39", "text": "ウェブサイトで特定の成人向け動画を見る"}, {"type": "subtitle", "time": 1544.07, "timestamp": "00:25:44", "text": "ビデオ制作、その前はライターでした"}, {"type": "subtitle", "time": 1546.71, "timestamp": "00:25:46", "text": "Wikipediaページの場合"}, {"type": "subtitle", "time": 1549.75, "timestamp": "00:25:49", "text": "そしてその前に私はたくさんのことをしました"}, {"type": "subtitle", "time": 1551.43, "timestamp": "00:25:51", "text": "だから、どう説明すればいいのかわからない"}, {"type": "subtitle", "time": 1554.47, "timestamp": "00:25:54", "text": "今の私自身。私はただストリーミングが好きです"}]
[{"type": "subtitle", "time": 7860.069, "timestamp": "02:11:00", "text": "いやいや、彼女は全部ダウンロードしたんだよ"}, {"type": "subtitle", "time": 7865.83, "timestamp": "02:11:05", "text": "1週間以内くらいだと思います。"}, {"type": "subtitle", "time": 7867.83, "timestamp": "02:11:07", "text": "しかし、問題は、たとえこう書いてあっても"}, {"type": "subtitle", "time": 7870.55, "timestamp": "02:11:10", "text": "無制限だ、いや、そうではない。ええ、そうではありません"}, {"type": "subtitle", "time": 7874.87, "timestamp": "02:11:14", "text": "究極の。知っている。 Bです。戦わなければなりませんでした"}, {"type": "subtitle", "time": 7878.709, "timestamp": "02:11:18", "text": "今月は２回だよ、兄弟。だって私は"}, {"type": "subtitle", "time": 7881.03, "timestamp": "02:11:21", "text": "Vのダウンロードとアップロードは行いません"}, {"type": "subtitle", "time": 7884.87, "timestamp": "02:11:24", "text": "信じる。 「ああ、これは痛い」って感じだった。"}, {"type": "subtitle", "time": 7886.87, "timestamp": "02:11:26", "text": "なぜ？"}, {"type": "subtitle", "time": 7890.43, "timestamp": "02:11:30", "text": "私のインターネットプロバイダーが嫌うように"}, {"type": "subtitle", "time": 7893.27, "timestamp": "02:11:33", "text": "自分。彼は時々、私はそれを呼ぶ"}, {"type": "subtitle", "time": 7894.629, "timestamp": "02:11:34", "text": "「ああ、また君か」みたいな感じ。私はこう思う、"}, {"type": "subtitle", "time": 7897.189, "timestamp": "02:11:37", "text": "「なんでだよ？なんで俺のことを"}, {"type": "subtitle", "time": 7903.27, "timestamp": "02:11:43", "text": "待って、なぜインターネットと呼ぶのですか"}, {"type": "subtitle", "time": 7905.91, "timestamp": "02:11:45", "text": "プロバイダー？時々私は"}, {"type": "subtitle", "time": 7907.589, "timestamp": "02:11:47", "text": "インターネットについて苦情を言うために彼らに連絡する"}, {"type": "subtitle", "time": 7909.83, "timestamp": "02:11:49", "text": "ゆっくり、他の時は彼らに伝える"}, {"type": "subtitle", "time": 7911.669, "timestamp": "02:11:51", "text": "えっと、計画は？何ですか"}, {"type": "subtitle", "time": 7914.149, "timestamp": "02:11:54", "text": "まるで、私が手に入れられないものを手に入れることができるかのように、"}, {"type": "subtitle", "time": 7915.43, "timestamp": "02:11:55", "text": "時々私はただ彼らに電話をかけて"}, {"type": "subtitle", "time": 7918.55, "timestamp": "02:11:58", "text": "彼らが元気でいるかどうか確認する。ああ、"}]
[{"type": "subtitle", "time": 24.67, "timestamp": "00:00:24", "text": "すべきである"}, {"type": "subtitle", "time": 26.67, "timestamp": "00:00:26", "text": "仕事。"}, {"type": "subtitle", "time": 35.03, "timestamp": "00:00:35", "text": "ええ、私は生きています。ジョアソンへようこそ"}, {"type": "subtitle", "time": 36.19, "timestamp": "00:00:36", "text": "日"}, {"type": "subtitle", "time": 40.11, "timestamp": "00:00:40", "text": "68、日曜日の配信。日曜の夜"}, {"type": "subtitle", "time": 41.79, "timestamp": "00:00:41", "text": "ストリーム。"}, {"type": "subtitle", "time": 45.19, "timestamp": "00:00:45", "text": "えっと、日曜の夜の配信です。あなたに"}, {"type": "subtitle", "time": 47.99, "timestamp": "00:00:47", "text": "そうなっていたでしょう"}, {"type": "subtitle", "time": 51.99, "timestamp": "00:00:51", "text": "えっと、2番目のストリームにリダイレクトされました。それで"}, {"type": "subtitle", "time": 54.43, "timestamp": "00:00:54", "text": "今日"}]
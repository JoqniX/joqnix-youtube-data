[{"type": "subtitle", "time": 660.59, "timestamp": "00:11:00", "text": "私は持っていると思う"}, {"type": "subtitle", "time": 663.75, "timestamp": "00:11:03", "text": "アクセス。まだ確認したいだけです"}, {"type": "subtitle", "time": 666.31, "timestamp": "00:11:06", "text": "ホワイトリストを用意してください。私は持っていないことは分かっています"}, {"type": "subtitle", "time": 666.99, "timestamp": "00:11:06", "text": "それ"}, {"type": "subtitle", "time": 674.55, "timestamp": "00:11:14", "text": "でも、こんにちは。参加します。ああ、参加します。ああ、私の"}, {"type": "subtitle", "time": 678.75, "timestamp": "00:11:18", "text": "こんにちは。"}, {"type": "subtitle", "time": 684.03, "timestamp": "00:11:24", "text": "名前？"}, {"type": "subtitle", "time": 688.55, "timestamp": "00:11:28", "text": "こんにちは。 Kのデビューみたいなものだ。いいえ、私は"}, {"type": "subtitle", "time": 691.15, "timestamp": "00:11:31", "text": "彼を観察する"}, {"type": "subtitle", "time": 700.389, "timestamp": "00:11:40", "text": "ストリーム。ニース。 K."}, {"type": "subtitle", "time": 703.75, "timestamp": "00:11:43", "text": "彼らは配信を終えたのか？そうみたいです"}, {"type": "subtitle", "time": 705.15, "timestamp": "00:11:45", "text": "彼らは"}, {"type": "subtitle", "time": 707.15, "timestamp": "00:11:47", "text": "した。"}]
[{"type": "subtitle", "time": 9181.15, "timestamp": "02:33:01", "text": "それで"}, {"type": "subtitle", "time": 9183.99, "timestamp": "02:33:03", "text": "個人的には私はモデレーターではありません"}, {"type": "subtitle", "time": 9186.55, "timestamp": "02:33:06", "text": "私のチャット"}, {"type": "subtitle", "time": 9188.15, "timestamp": "02:33:08", "text": "なぜなら、私はそこにいるように感じないからです"}, {"type": "subtitle", "time": 9190.87, "timestamp": "02:33:10", "text": "節度が必要"}, {"type": "subtitle", "time": 9192.389, "timestamp": "02:33:12", "text": "時々友達がやって来る"}, {"type": "subtitle", "time": 9195.19, "timestamp": "02:33:15", "text": "チャットで彼らは何かを言い始める"}, {"type": "subtitle", "time": 9196.95, "timestamp": "02:33:16", "text": "そして彼らは私の友達なので、ミュートすることができます"}, {"type": "subtitle", "time": 9199.429, "timestamp": "02:33:19", "text": "タイムアウト えーと、"}, {"type": "subtitle", "time": 9201.469, "timestamp": "02:33:21", "text": "すべて"}, {"type": "subtitle", "time": 9203.99, "timestamp": "02:33:23", "text": "大丈夫。でも私は2つくらい行くつもりです"}, {"type": "subtitle", "time": 9206.469, "timestamp": "02:33:26", "text": "視聴率、ですよね？"}, {"type": "subtitle", "time": 9208.469, "timestamp": "02:33:28", "text": "そしてチャットで何か言って、"}, {"type": "subtitle", "time": 9209.67, "timestamp": "02:33:29", "text": "彼らは「わかった、あなたはそうすべきではない」"}, {"type": "subtitle", "time": 9217.67, "timestamp": "02:33:37", "text": "彼らは、私が知らないように始めるでしょう"}, {"type": "subtitle", "time": 9220.99, "timestamp": "02:33:40", "text": "私にはそういう雰囲気があるんだけど"}, {"type": "subtitle", "time": 9223.79, "timestamp": "02:33:43", "text": "いいね！を押すと、読んでくれるか、返信してくれないかのどちらかです。"}, {"type": "subtitle", "time": 9226.07, "timestamp": "02:33:46", "text": "時々彼らはあなたのチャットを読んで"}, {"type": "subtitle", "time": 9227.95, "timestamp": "02:33:47", "text": "答えない。私はこう思う、"}, {"type": "subtitle", "time": 9230.27, "timestamp": "02:33:50", "text": "\"わかった、"}, {"type": "subtitle", "time": 9233.349, "timestamp": "02:33:53", "text": "わかった。面白いジョークを言ったんだ。"}, {"type": "subtitle", "time": 9239.71, "timestamp": "02:33:59", "text": "[音楽]"}]
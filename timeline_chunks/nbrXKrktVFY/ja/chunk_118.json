[{"type": "subtitle", "time": 7082.07, "timestamp": "01:58:02", "text": "うん。しかし、時間の経過とともに、"}, {"type": "subtitle", "time": 7084.55, "timestamp": "01:58:04", "text": "ファンもみんな、今起こっていることを気に入っている。"}, {"type": "subtitle", "time": 7089.03, "timestamp": "01:58:09", "text": "彼女は最も強力なホロメンバーとなった"}, {"type": "subtitle", "time": 7091.51, "timestamp": "01:58:11", "text": "なぜなら彼女はタイムトラベルができたからだ。彼女はそうだった"}, {"type": "subtitle", "time": 7094.149, "timestamp": "01:58:14", "text": "また、ある種の"}, {"type": "subtitle", "time": 7096.629, "timestamp": "01:58:16", "text": "特定の事柄に関する知識。彼女は基本的"}, {"type": "subtitle", "time": 7099.43, "timestamp": "01:58:19", "text": "彼女は基本的にドクター・ストレンジになった。"}, {"type": "subtitle", "time": 7101.83, "timestamp": "01:58:21", "text": "うん。"}, {"type": "subtitle", "time": 7103.669, "timestamp": "01:58:23", "text": "そして彼女にはホルのように救う力があった"}, {"type": "subtitle", "time": 7106.07, "timestamp": "01:58:26", "text": "当時の様子は、"}, {"type": "subtitle", "time": 7115.189, "timestamp": "01:58:35", "text": "うん。私はそのアニメーションを見ました。私は"}, {"type": "subtitle", "time": 7119.189, "timestamp": "01:58:39", "text": "うわー、すごい、一人でこれを作ったなんて。"}, {"type": "subtitle", "time": 7123.43, "timestamp": "01:58:43", "text": "うん。どうやって、そして彼はそれをしたのか、"}, {"type": "subtitle", "time": 7128.149, "timestamp": "01:58:48", "text": "あのアイドル会社。彼は"}, {"type": "subtitle", "time": 7130.709, "timestamp": "01:58:50", "text": "アイドル、そして顔のつながりのために"}, {"type": "subtitle", "time": 7135.75, "timestamp": "01:58:55", "text": "メンバー。ああ、予告編みたいなやつね。"}]
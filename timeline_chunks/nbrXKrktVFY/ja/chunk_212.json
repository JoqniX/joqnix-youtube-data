[{"type": "subtitle", "time": 12721.99, "timestamp": "03:32:01", "text": "アニメのように考えるのは簡単だ"}, {"type": "subtitle", "time": 12723.429, "timestamp": "03:32:03", "text": "それは単に子供向けだから"}, {"type": "subtitle", "time": 12725.71, "timestamp": "03:32:05", "text": "漫画みたいだ。"}, {"type": "subtitle", "time": 12728.469, "timestamp": "03:32:08", "text": "うん。そして、一部の人々は"}, {"type": "subtitle", "time": 12730.07, "timestamp": "03:32:10", "text": "それを～のように扱う。あれら見た？"}, {"type": "subtitle", "time": 12731.91, "timestamp": "03:32:11", "text": "クランチロールのミーティングみたいに"}, {"type": "subtitle", "time": 12735.349, "timestamp": "03:32:15", "text": "インド人はアニメについて話すのか？ええ、私は"}, {"type": "subtitle", "time": 12737.51, "timestamp": "03:32:17", "text": "インスタグラムの投稿を見たことがあると思う。私"}, {"type": "chat", "time": 12739.825, "timestamp": "03:32:19", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "and then they'd label it as a cartoon"}, {"type": "subtitle", "time": 12739.99, "timestamp": "03:32:19", "text": "見ていません。マジで、"}, {"type": "subtitle", "time": 12743.67, "timestamp": "03:32:23", "text": "耐え難い。何てことだ。"}, {"type": "subtitle", "time": 12745.67, "timestamp": "03:32:25", "text": "アニメについて話すのが好きな人は、「ああ、"}, {"type": "subtitle", "time": 12747.83, "timestamp": "03:32:27", "text": "「それで、これだよ。」そして私は「おお、すごいね」と思った。"}, {"type": "subtitle", "time": 12752.51, "timestamp": "03:32:32", "text": "いや、違うよ。他のものと全く同じです"}, {"type": "subtitle", "time": 12756.74, "timestamp": "03:32:36", "text": "中くらい。それは単に物語を伝える手段の一つに過ぎない。"}, {"type": "subtitle", "time": 12768.11, "timestamp": "03:32:48", "text": "ジャッキーが見たよ"}, {"type": "subtitle", "time": 12770.469, "timestamp": "03:32:50", "text": "クランチロールみたいな感じでシュロックして。"}, {"type": "subtitle", "time": 12773.309, "timestamp": "03:32:53", "text": "私は、なぜ彼が"}]
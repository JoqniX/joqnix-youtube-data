[{"type": "subtitle", "time": 1440.95, "timestamp": "00:24:00", "text": "要するに、NASAに応募しているということだ。何？うん。"}, {"type": "subtitle", "time": 1442.31, "timestamp": "00:24:02", "text": "彼らはこう言う。「よし、みんな、これを手に入れたよ」"}, {"type": "subtitle", "time": 1444.149, "timestamp": "00:24:04", "text": "かなりの程度。私はこれを持っています 私はこれを持っています"}, {"type": "subtitle", "time": 1446.07, "timestamp": "00:24:06", "text": "それからそれ。まずこれを満タンにしてから、これを満タンにした。私"}, {"type": "subtitle", "time": 1448.95, "timestamp": "00:24:08", "text": "この学校に行った。私はあるイベントに参加しました"}, {"type": "subtitle", "time": 1451.43, "timestamp": "00:24:11", "text": "そして今、もしかしたら彼らは私の声を聞いてくれるかもしれない"}, {"type": "subtitle", "time": 1454.47, "timestamp": "00:24:14", "text": "外。もしかしたらそうなるかもしれない。"}, {"type": "subtitle", "time": 1457.11, "timestamp": "00:24:17", "text": "ああ、なんてことだ。ショッピングモールの警備員のためだけに"}, {"type": "subtitle", "time": 1460.95, "timestamp": "00:24:20", "text": "位置。くそ。"}, {"type": "subtitle", "time": 1468.549, "timestamp": "00:24:28", "text": "とにかく、みんな、こんにちは、私です。"}, {"type": "subtitle", "time": 1469.95, "timestamp": "00:24:29", "text": "オレンジ。"}, {"type": "subtitle", "time": 1474.149, "timestamp": "00:24:34", "text": "ええと、私はたくさんの名前を使っています。その一つは"}, {"type": "subtitle", "time": 1477.87, "timestamp": "00:24:37", "text": "オレンジ。他のものは私はしない"}, {"type": "subtitle", "time": 1481.669, "timestamp": "00:24:41", "text": "言う。そして普段はオンラインで"}, {"type": "subtitle", "time": 1485.51, "timestamp": "00:24:45", "text": "気分次第で。私は私は私は"}, {"type": "subtitle", "time": 1488.87, "timestamp": "00:24:48", "text": "アニメに関するいくつかのこと"}, {"type": "subtitle", "time": 1491.51, "timestamp": "00:24:51", "text": "関連情報。それから私は"}, {"type": "subtitle", "time": 1494.47, "timestamp": "00:24:54", "text": "くだらない投稿をする。それから私は始めた"}]
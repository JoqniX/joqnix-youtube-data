[{"type": "subtitle", "time": 8400.27, "timestamp": "02:20:00", "text": "あなた"}, {"type": "subtitle", "time": 8403.19, "timestamp": "02:20:03", "text": "サーバー。わかったよ、スポーツマン。私はDiscordが嫌いです"}, {"type": "subtitle", "time": 8404.19, "timestamp": "02:20:04", "text": "これ"}, {"type": "subtitle", "time": 8406.51, "timestamp": "02:20:06", "text": "理由は、"}, {"type": "subtitle", "time": 8409.27, "timestamp": "02:20:09", "text": "まるで"}, {"type": "subtitle", "time": 8412.07, "timestamp": "02:20:12", "text": "国とか何か"}, {"type": "subtitle", "time": 8413.91, "timestamp": "02:20:13", "text": "あなたが彼らに加わるとき。わかった、あなたは"}, {"type": "subtitle", "time": 8416.71, "timestamp": "02:20:16", "text": "ルールを読んでください。ルールを読んだ後、"}, {"type": "subtitle", "time": 8418.63, "timestamp": "02:20:18", "text": "チャネルでやり取りする必要があります"}, {"type": "subtitle", "time": 8420.63, "timestamp": "02:20:20", "text": "レベルアップするには、このくらいの時間が必要です。"}, {"type": "subtitle", "time": 8422.55, "timestamp": "02:20:22", "text": "そしてレベルアップしたら、ついに"}, {"type": "subtitle", "time": 8425.51, "timestamp": "02:20:25", "text": "画像を送信したり、絵文字を使用したりできます。そしてその後"}, {"type": "subtitle", "time": 8427.75, "timestamp": "02:20:27", "text": "それは、あなたが参加したいなら好きになれます"}, {"type": "subtitle", "time": 8431.11, "timestamp": "02:20:31", "text": "VCについては、この管理者に尋ねてください。"}, {"type": "subtitle", "time": 8433.429, "timestamp": "02:20:33", "text": "特定の管理者が一度オンラインになると"}, {"type": "subtitle", "time": 8436.389, "timestamp": "02:20:36", "text": "週。"}, {"type": "subtitle", "time": 8437.83, "timestamp": "02:20:37", "text": "私はそういうのに参加するのは好きじゃない"}, {"type": "subtitle", "time": 8439.91, "timestamp": "02:20:39", "text": "サーバー。私はただサーバーに参加するのが好きなだけです。もし私が"}, {"type": "subtitle", "time": 8445.15, "timestamp": "02:20:45", "text": "私を歓迎するボットを見ました、"}, {"type": "subtitle", "time": 8448.23, "timestamp": "02:20:48", "text": "離れる。例えば、ボットが言うと"}, {"type": "subtitle", "time": 8449.75, "timestamp": "02:20:49", "text": "ようこそ、私はこう思う、オーケー、"}, {"type": "subtitle", "time": 8451.389, "timestamp": "02:20:51", "text": "人間はいない"}, {"type": "subtitle", "time": 8453.99, "timestamp": "02:20:53", "text": "ここ。ここでは人との交流はありません"}]
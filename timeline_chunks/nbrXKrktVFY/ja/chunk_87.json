[{"type": "subtitle", "time": 5221.669, "timestamp": "01:27:01", "text": "何か間違っているのか？待って、あなたの"}, {"type": "subtitle", "time": 5224.39, "timestamp": "01:27:04", "text": "差し支えなければ、好きな食べ物を教えていただけますか？私の"}, {"type": "subtitle", "time": 5227.189, "timestamp": "01:27:07", "text": "好きな食べ物は緑色のものなら何でもだった。どれでも"}, {"type": "subtitle", "time": 5229.669, "timestamp": "01:27:09", "text": "野菜。子供の頃、野菜が大好きだった。として"}, {"type": "subtitle", "time": 5233.11, "timestamp": "01:27:13", "text": "坊や、私はニンジンが大好きだよ。私はピーマンが大好きです。"}, {"type": "subtitle", "time": 5235.03, "timestamp": "01:27:15", "text": "私のお気に入りは、えっと、私は"}, {"type": "subtitle", "time": 5238.28, "timestamp": "01:27:18", "text": "その英語名を知っています。ケラです。"}, {"type": "subtitle", "time": 5239.669, "timestamp": "01:27:19", "text": "[音楽]"}, {"type": "subtitle", "time": 5243.43, "timestamp": "01:27:23", "text": "それが私の一番のお気に入りだった。おお。それで"}, {"type": "subtitle", "time": 5246.629, "timestamp": "01:27:26", "text": "両親がこう言うたびに"}, {"type": "subtitle", "time": 5248.47, "timestamp": "01:27:28", "text": "他の親御さんたちに私について話すと"}, {"type": "subtitle", "time": 5253.149, "timestamp": "01:27:33", "text": "えっと、あなたの子供は野菜を食べるの？"}, {"type": "subtitle", "time": 5255.229, "timestamp": "01:27:35", "text": "彼らはどんな人たちなのか"}, {"type": "subtitle", "time": 5257.51, "timestamp": "01:27:37", "text": "ああ、一体何をやっているんだ"}, {"type": "subtitle", "time": 5264.47, "timestamp": "01:27:44", "text": "[音楽]"}, {"type": "subtitle", "time": 5267.75, "timestamp": "01:27:47", "text": "子供の頃は好き嫌いがなかった"}, {"type": "subtitle", "time": 5270.79, "timestamp": "01:27:50", "text": "まるで子供が好き嫌いが多いことに気づいたみたい"}, {"type": "subtitle", "time": 5273.03, "timestamp": "01:27:53", "text": "私の兄弟姉妹が生まれたとき"}, {"type": "subtitle", "time": 5274.9, "timestamp": "01:27:54", "text": "彼らは好き嫌いが激しいから"}, {"type": "subtitle", "time": 5276.43, "timestamp": "01:27:56", "text": "[音楽]"}, {"type": "subtitle", "time": 5278.87, "timestamp": "01:27:58", "text": "食べる人。私の両親は文字通り幸運だった"}]
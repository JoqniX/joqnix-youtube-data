[{"type": "subtitle", "time": 2640.79, "timestamp": "00:44:00", "text": "ええ、私もよくそういうことがあります。のように"}, {"type": "subtitle", "time": 2642.47, "timestamp": "00:44:02", "text": "私は自傷行為をするだろう。 「ああ、あれは"}, {"type": "subtitle", "time": 2644.63, "timestamp": "00:44:04", "text": "とにかく、起こったんです。"}, {"type": "subtitle", "time": 2648.79, "timestamp": "00:44:08", "text": "うん。そして、私はそうは思わなかった。大したことは感じなかった。"}, {"type": "subtitle", "time": 2650.87, "timestamp": "00:44:10", "text": "私は「わかった」と思った。ああ、血が流れてくる。"}, {"type": "subtitle", "time": 2654.79, "timestamp": "00:44:14", "text": "おお、いいね。私が以前やっていたことは、"}, {"type": "subtitle", "time": 2657.43, "timestamp": "00:44:17", "text": "この中には何が入っていますか？だから私は"}, {"type": "subtitle", "time": 2660.63, "timestamp": "00:44:20", "text": "以前はそれを摘んで、さらに切るのが好きでした"}, {"type": "subtitle", "time": 2662.55, "timestamp": "00:44:22", "text": "などなど。わかった。私はそうしないのは"}, {"type": "subtitle", "time": 2665.03, "timestamp": "00:44:25", "text": "自分の内面が好きじゃない。それはもっと"}, {"type": "subtitle", "time": 2668.55, "timestamp": "00:44:28", "text": "血。私は幼かった。私は幼かった。私は"}, {"type": "subtitle", "time": 2671.99, "timestamp": "00:44:31", "text": "「うん」みたいな感じ。そして、"}, {"type": "subtitle", "time": 2673.829, "timestamp": "00:44:33", "text": "深く、それは深い窓となり、私は"}, {"type": "subtitle", "time": 2676.47, "timestamp": "00:44:36", "text": "「ああ、いやだ」みたいな感じ。なんてこった。母がそれを見た"}, {"type": "subtitle", "time": 2678.87, "timestamp": "00:44:38", "text": "そして彼女は私を叱りつけ、「そうよ」と言った。そして"}, {"type": "subtitle", "time": 2682.99, "timestamp": "00:44:42", "text": "えっと、なんて言うんだっけ？"}, {"type": "subtitle", "time": 2686.95, "timestamp": "00:44:46", "text": "えっと、とかそんな感じ。忘れた。それは"}, {"type": "subtitle", "time": 2689.349, "timestamp": "00:44:49", "text": "そう、それだ。そして綿と"}, {"type": "subtitle", "time": 2692.069, "timestamp": "00:44:52", "text": "もの。彼女はそれを結んだりした。だから私は"}, {"type": "subtitle", "time": 2696.39, "timestamp": "00:44:56", "text": "「ああ、わかった」みたいな感じ。その後"}, {"type": "subtitle", "time": 2699.589, "timestamp": "00:44:59", "text": "えっと、後で偶然だと思うのですが"}]
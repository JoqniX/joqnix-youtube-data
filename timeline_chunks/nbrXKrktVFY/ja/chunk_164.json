[{"type": "subtitle", "time": 9841.349, "timestamp": "02:44:01", "text": "おっぱい。これが必要だ。それは本当に重要です。"}, {"type": "subtitle", "time": 9849.429, "timestamp": "02:44:09", "text": "だからベンガル語では、私は 1 つしか言えない"}, {"type": "subtitle", "time": 9851.05, "timestamp": "02:44:11", "text": "もの。"}, {"type": "subtitle", "time": 9858.309, "timestamp": "02:44:18", "text": "私は何も理解できなかった"}, {"type": "subtitle", "time": 9860.309, "timestamp": "02:44:20", "text": "私は、"}, {"type": "subtitle", "time": 9868.469, "timestamp": "02:44:28", "text": "ロシア語で「私は行く」と言う方法を知っています"}, {"type": "subtitle", "time": 9878.79, "timestamp": "02:44:38", "text": "ああ、ああ、ああ"}, {"type": "subtitle", "time": 9881.07, "timestamp": "02:44:41", "text": "これらは私が好きなものです"}, {"type": "subtitle", "time": 9883.349, "timestamp": "02:44:43", "text": "私の母語が"}, {"type": "subtitle", "time": 9886.07, "timestamp": "02:44:46", "text": "信じられないかもしれないけど、私の第一言語みたい"}, {"type": "subtitle", "time": 9887.27, "timestamp": "02:44:47", "text": "だった"}, {"type": "subtitle", "time": 9889.23, "timestamp": "02:44:49", "text": "[音楽]"}, {"type": "subtitle", "time": 9892.51, "timestamp": "02:44:52", "text": "ウドゥは、"}, {"type": "subtitle", "time": 9895.83, "timestamp": "02:44:55", "text": "えっと、ここではよく話されていたんだけど"}, {"type": "subtitle", "time": 9898.63, "timestamp": "02:44:58", "text": "家族のおかげです。私の家族が話す"}]
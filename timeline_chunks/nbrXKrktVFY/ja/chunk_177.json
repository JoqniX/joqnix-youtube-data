[{"type": "subtitle", "time": 10625.19, "timestamp": "02:57:05", "text": "昔のヒンディー語のように"}, {"type": "subtitle", "time": 10638.63, "timestamp": "02:57:18", "text": "それは楽しかったし、彼女は私に"}, {"type": "subtitle", "time": 10646.23, "timestamp": "02:57:26", "text": "彼女が私に教えてくれた通貨のように"}, {"type": "subtitle", "time": 10649.309, "timestamp": "02:57:29", "text": "作品と人々の購入方法"}, {"type": "subtitle", "time": 10651.67, "timestamp": "02:57:31", "text": "もの。それが彼女の好みだったんです。"}, {"type": "subtitle", "time": 10654.83, "timestamp": "02:57:34", "text": "彼女は、ただ買えるって感じ"}, {"type": "subtitle", "time": 10658.87, "timestamp": "02:57:38", "text": "セブンイレブンなどの店で買った食べ物"}, {"type": "subtitle", "time": 10660.87, "timestamp": "02:57:40", "text": "何か食べて、そこで食べる。私は"}, {"type": "subtitle", "time": 10665.75, "timestamp": "02:57:45", "text": "彼女は「ええ、お湯は出るわよ」と言った。"}, {"type": "subtitle", "time": 10668.42, "timestamp": "02:57:48", "text": "そこには電子レンジみたいなものがあるよ。"}, {"type": "subtitle", "time": 10669.91, "timestamp": "02:57:49", "text": "[音楽]"}, {"type": "subtitle", "time": 10672.95, "timestamp": "02:57:52", "text": "面白いですね。"}, {"type": "subtitle", "time": 10675.91, "timestamp": "02:57:55", "text": "うん。 1年後か、"}, {"type": "subtitle", "time": 10678.389, "timestamp": "02:57:58", "text": "数ヶ月経つと、私もこう思うかもしれない"}]
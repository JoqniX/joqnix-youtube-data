[{"type": "subtitle", "time": 8641.11, "timestamp": "02:24:01", "text": "二人とも。"}, {"type": "subtitle", "time": 8643.75, "timestamp": "02:24:03", "text": "でも、コメント欄で交流したりしますか？"}, {"type": "subtitle", "time": 8647.27, "timestamp": "02:24:07", "text": "うん。ああ、例えば7人いるとしよう"}, {"type": "subtitle", "time": 8649.11, "timestamp": "02:24:09", "text": "同時代に生きているユーチューバー"}, {"type": "subtitle", "time": 8651.27, "timestamp": "02:24:11", "text": "そして私はそれをした"}, {"type": "subtitle", "time": 8655.389, "timestamp": "02:24:15", "text": "そして、7人全員について。うん。"}, {"type": "subtitle", "time": 8659.67, "timestamp": "02:24:19", "text": "私が苦労したのは、私の限界が6だったことです"}, {"type": "subtitle", "time": 8661.83, "timestamp": "02:24:21", "text": "そして私はマルチタスクができないのですが、"}, {"type": "subtitle", "time": 8665.19, "timestamp": "02:24:25", "text": "人間の境界が直面する何らかの理由"}, {"type": "subtitle", "time": 8667.349, "timestamp": "02:24:27", "text": "私に課せられたのはマルチタスクをしないことだった"}, {"type": "subtitle", "time": 8677.99, "timestamp": "02:24:37", "text": "いつでも、ああ、君が"}, {"type": "subtitle", "time": 8680.71, "timestamp": "02:24:40", "text": "空虚な生活を思い出してください"}, {"type": "subtitle", "time": 8684.11, "timestamp": "02:24:44", "text": "マインクラフトのイベントですよね？うん。"}, {"type": "subtitle", "time": 8688.71, "timestamp": "02:24:48", "text": "それで、私のオシーが３人そこにいた"}, {"type": "subtitle", "time": 8691.91, "timestamp": "02:24:51", "text": "そして私はそのうちの3人を見ていた"}, {"type": "subtitle", "time": 8699.67, "timestamp": "02:24:59", "text": "そして誰かが、私も"}]
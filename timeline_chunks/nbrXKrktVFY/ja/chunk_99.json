[{"type": "subtitle", "time": 5941.59, "timestamp": "01:39:01", "text": "だから、人々が嫌っていることを知ったとき"}, {"type": "subtitle", "time": 5945.47, "timestamp": "01:39:05", "text": "ゴキブリ、何が問題なの？"}, {"type": "subtitle", "time": 5949.43, "timestamp": "01:39:09", "text": "あなた？私の例は、私自身に似ています。その"}, {"type": "subtitle", "time": 5953.59, "timestamp": "01:39:13", "text": "子犬を嫌う人がいるのと同じように。"}, {"type": "subtitle", "time": 5957.59, "timestamp": "01:39:17", "text": "子犬を嫌いになる理由って何？"}, {"type": "subtitle", "time": 5958.95, "timestamp": "01:39:18", "text": "それが私の理由です"}, {"type": "subtitle", "time": 5961.03, "timestamp": "01:39:21", "text": "ゴキブリはゴキブリだから、信じて"}, {"type": "subtitle", "time": 5963.99, "timestamp": "01:39:23", "text": "そうかどうかは別として、本当に清潔です。"}, {"type": "subtitle", "time": 5966.31, "timestamp": "01:39:26", "text": "汚れているのは、"}, {"type": "subtitle", "time": 5968.709, "timestamp": "01:39:28", "text": "汚い場所。"}, {"type": "subtitle", "time": 5971.35, "timestamp": "01:39:31", "text": "うん。"}, {"type": "subtitle", "time": 5973.35, "timestamp": "01:39:33", "text": "そしてゴキブリは"}, {"type": "subtitle", "time": 5975.229, "timestamp": "01:39:35", "text": "核戦争を生き延びる"}, {"type": "subtitle", "time": 5978.149, "timestamp": "01:39:38", "text": "爆弾みたいなもの。まるで"}, {"type": "subtitle", "time": 5980.95, "timestamp": "01:39:40", "text": "彼らにはたくさんの素晴らしい点がある。"}, {"type": "subtitle", "time": 5983.35, "timestamp": "01:39:43", "text": "ゴキブリが"}, {"type": "subtitle", "time": 5986.07, "timestamp": "01:39:46", "text": "核戦争を生き延びるまで、そして私が"}, {"type": "subtitle", "time": 5989.43, "timestamp": "01:39:49", "text": "フォールアウトシリーズのような感じ。"}, {"type": "subtitle", "time": 5991.189, "timestamp": "01:39:51", "text": "うん。"}, {"type": "subtitle", "time": 5993.629, "timestamp": "01:39:53", "text": "「え、なんでゴキブリがいるの？」って思ったよ。"}, {"type": "subtitle", "time": 5996.229, "timestamp": "01:39:56", "text": "それから？ YouTubeを見ていたと思う"}, {"type": "subtitle", "time": 5998.47, "timestamp": "01:39:58", "text": "コメンテーターは要約を述べるのが好きです"}]
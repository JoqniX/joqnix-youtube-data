[{"type": "subtitle", "time": 2402.79, "timestamp": "00:40:02", "text": "父は私に医者になってほしかった。私の"}, {"type": "subtitle", "time": 2407.99, "timestamp": "00:40:07", "text": "祖母は私に料理人になってほしかった。だから私は"}, {"type": "subtitle", "time": 2410.829, "timestamp": "00:40:10", "text": "グラフィックになった"}, {"type": "subtitle", "time": 2413.03, "timestamp": "00:40:13", "text": "デザイナー。つまり、私はそう表現するのが好きなんです"}, {"type": "subtitle", "time": 2417.829, "timestamp": "00:40:17", "text": "それ。なぜなら、私が若かった頃は"}, {"type": "subtitle", "time": 2419.51, "timestamp": "00:40:19", "text": "あらゆることに興味を持つ。あなたが知っている"}, {"type": "subtitle", "time": 2421.109, "timestamp": "00:40:21", "text": "子供はどんなものか。彼らは「ああ、私は"}, {"type": "subtitle", "time": 2422.87, "timestamp": "00:40:22", "text": "これをやります。そうするつもりです。"}, {"type": "subtitle", "time": 2425.589, "timestamp": "00:40:25", "text": "うん。そして学校では、私の先生たちは"}, {"type": "subtitle", "time": 2428.31, "timestamp": "00:40:28", "text": "私に聞いて、「ああ、オレンジ、大きくなったら、"}, {"type": "subtitle", "time": 2431.39, "timestamp": "00:40:31", "text": "「君は何になりたいの？」といつも言うんだ。"}, {"type": "subtitle", "time": 2436.87, "timestamp": "00:40:36", "text": "「えっと、私はパン職人になりたいんです。」"}, {"type": "subtitle", "time": 2439.349, "timestamp": "00:40:39", "text": "「パン屋をやりたいんです。」そして彼らは"}, {"type": "subtitle", "time": 2442.87, "timestamp": "00:40:42", "text": "「それは仕事じゃない」みたいな感じ。私は"}, {"type": "subtitle", "time": 2446.79, "timestamp": "00:40:46", "text": "「そうだよ。君はパンを食べるんだ。」"}, {"type": "subtitle", "time": 2448.79, "timestamp": "00:40:48", "text": "パンを焼こうと思います。"}, {"type": "subtitle", "time": 2454.15, "timestamp": "00:40:54", "text": "生地。そして彼らはこう言った。「ああ、それは"}, {"type": "subtitle", "time": 2455.829, "timestamp": "00:40:55", "text": "「ただの子供だ、子供らしい行動だ。」私はまだ"}, {"type": "subtitle", "time": 2457.67, "timestamp": "00:40:57", "text": "ちなみに、私はパン職人になりたいんです。私はまだ"}, {"type": "subtitle", "time": 2459.589, "timestamp": "00:40:59", "text": "パン屋を経営したい。まるで"}]
[{"type": "subtitle", "time": 2471.34, "timestamp": "00:41:11", "text": "。在學校裡，"}, {"type": "subtitle", "time": 2476.15, "timestamp": "00:41:16", "text": "我的"}, {"type": "subtitle", "time": 2482.47, "timestamp": "00:41:22", "text": "老師常常問我：「哦"}, {"type": "subtitle", "time": 2491.99, "timestamp": "00:41:31", "text": "，奧蘭治，你長大後想成為什麼樣的人呢？ 」"}, {"type": "subtitle", "time": 2498.47, "timestamp": "00:41:38", "text": "我總是說：「嗯，我想當"}, {"type": "subtitle", "time": 2500.55, "timestamp": "00:41:40", "text": "麵包師傅。我"}, {"type": "subtitle", "time": 2505.75, "timestamp": "00:41:45", "text": "想開一家麵包店。 」他們會說：「那不是一份工作。 」我當時就說：「對，就是這樣。你們吃麵包，我也要做麵包，揉麵團。他們就說：「啊，這只是個孩子在做孩子該做的事。 「順便說一句，"}]
[{"type": "subtitle", "time": 35283.11, "timestamp": "09:48:03", "text": "你為什麼不幫我把這些東西搬下去呢？"}, {"type": "subtitle", "time": 35289.746, "timestamp": "09:48:09", "text": "喜歡捲心菜。我的天啊。"}, {"type": "subtitle", "time": 35294.07, "timestamp": "09:48:14", "text": "我真的很喜歡《Oh God》。食人族。  食人蜂。食人族。我要殺了他。"}, {"type": "subtitle", "time": 35304.39, "timestamp": "09:48:24", "text": "我要殺了他。檢查一下"}, {"type": "subtitle", "time": 35305.31, "timestamp": "09:48:25", "text": "你的"}, {"type": "subtitle", "time": 35309.426, "timestamp": "09:48:29", "text": "飢餓程度。 H：等等，"}]
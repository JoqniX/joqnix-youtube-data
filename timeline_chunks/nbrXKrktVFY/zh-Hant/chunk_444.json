[{"type": "subtitle", "time": 26644.628, "timestamp": "07:24:04", "text": "我"}, {"type": "subtitle", "time": 26647.83, "timestamp": "07:24:07", "text": "以為是喜歡男孩的女孩親吻男孩。男孩也可以喜歡男孩。這是真的。是的，我的意思是，在學校裡我並不在意，我對"}, {"type": "subtitle", "time": 26678.468, "timestamp": "07:24:38", "text": "自己性取向的態度很坦然，從來沒在意吧？所以"}, {"type": "subtitle", "time": 26686.788, "timestamp": "07:24:46", "text": "我並不在意這件事。  我不是同性戀。各位，別叫我同性戀。"}, {"type": "subtitle", "time": 26693.788, "timestamp": "07:24:53", "text": "每當有人說我是同性戀時，我就會說，兄弟，我有女朋友。"}]
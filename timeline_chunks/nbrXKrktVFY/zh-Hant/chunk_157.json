[{"type": "subtitle", "time": 9421.75, "timestamp": "02:37:01", "text": "怎麼辦？正在發生海嘯。我應該開始學游泳嗎？  最近音樂"}, {"type": "subtitle", "time": 9427.429, "timestamp": "02:37:07", "text": "圈發生了什麼事？"}, {"type": "subtitle", "time": 9435.03, "timestamp": "02:37:15", "text": "你知道印巴衝突那件事吧"}, {"type": "subtitle", "time": 9441.19, "timestamp": "02:37:21", "text": "？當時有個伺服器裡有人扮演巴基斯坦人，我的天哪，太搞笑了，他們說：「哦不，我的印度女朋友我見不到她了"}, {"type": "subtitle", "time": 9445.51, "timestamp": "02:37:25", "text": "。"}, {"type": "subtitle", "time": 9457.59, "timestamp": "02:37:37", "text": "」我的天啊。"}, {"type": "subtitle", "time": 9469.27, "timestamp": "02:37:49", "text": "他就像人們說，好吧，聽著，如果你在印度，你可以去參軍，報名成為軍人，如果他們把你派到戰場上，你就可以去"}]
[{"type": "subtitle", "time": 37869.03, "timestamp": "10:31:09", "text": "你喜欢“让我看看”吗？可能是角度问题。我们正在努力"}, {"type": "subtitle", "time": 37872.79, "timestamp": "10:31:12", "text": "联系他们。我们正在努力弄清楚他们在做什么。这是谁？为什么河面上会有"}, {"type": "subtitle", "time": 37882.95, "timestamp": "10:31:22", "text": "一条鱼的影子顺流而下？这他妈是什么玩意儿？  好了，我们开始吧。  哦，是的。"}, {"type": "subtitle", "time": 37904.87, "timestamp": "10:31:44", "text": "你不能从我的背包里"}, {"type": "subtitle", "time": 37907.11, "timestamp": "10:31:47", "text": "喝水。  好的。  我该怎么说呢？我得撒谎，我们选了个很糟糕的地方建基地，不过没关系。风景优美。是的，风景很美。对"}]
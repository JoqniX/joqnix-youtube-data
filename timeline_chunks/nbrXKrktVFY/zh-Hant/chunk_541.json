[{"type": "subtitle", "time": 32490.27, "timestamp": "09:01:30", "text": "我今天一夜沒睡。  我一整天都在和別人合作。是的，我想我會在這裡待一會兒。我"}, {"type": "subtitle", "time": 32501.35, "timestamp": "09:01:41", "text": "想。  嗯。推特，"}, {"type": "subtitle", "time": 32514.15, "timestamp": "09:01:54", "text": "你為什麼會這樣？  確認賬單變更。  我應該取消這次訂單"}, {"type": "subtitle", "time": 32517.27, "timestamp": "09:01:57", "text": "然後重新購買嗎？  呃，推特，推特。"}]
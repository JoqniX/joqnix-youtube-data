[{"type": "subtitle", "time": 6305.83, "timestamp": "01:45:05", "text": "我喜歡蟑螂，它們太"}, {"type": "subtitle", "time": 6307.91, "timestamp": "01:45:07", "text": "可愛了。是"}, {"type": "subtitle", "time": 6321.189, "timestamp": "01:45:21", "text": "啊。我"}, {"type": "subtitle", "time": 6322.79, "timestamp": "01:45:22", "text": "沒有殺牠，而是看著它爬來爬去。我當時氣瘋了，因為小時候特別喜歡昆蟲，對吧？小時候，它們就像可愛的小"}, {"type": "subtitle", "time": 6335.27, "timestamp": "01:45:35", "text": "東西，"}, {"type": "subtitle", "time": 6339.109, "timestamp": "01:45:39", "text": "會動，我覺得它們太"}, {"type": "subtitle", "time": 6340.55, "timestamp": "01:45:40", "text": "酷了。它們就像是可以自己動的小玩具。是啊。"}, {"type": "subtitle", "time": 6349.03, "timestamp": "01:45:49", "text": "所以當我發現有人討厭蟑螂的時候，我就想，"}, {"type": "subtitle", "time": 6350.95, "timestamp": "01:45:50", "text": "你們怎麼了"}, {"type": "subtitle", "time": 6352.79, "timestamp": "01:45:52", "text": "？就像我一樣。"}, {"type": "subtitle", "time": 6358.709, "timestamp": "01:45:58", "text": "就像有些人討厭小狗一樣。為什麼會討厭小狗呢？"}]
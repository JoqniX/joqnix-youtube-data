[{"type": "subtitle", "time": 4921.03, "timestamp": "01:22:01", "text": "不知道你是不是看起來很累"}, {"type": "subtitle", "time": 4923.669, "timestamp": "01:22:03", "text": "之類的。是的。是的。是的。是"}, {"type": "subtitle", "time": 4924.21, "timestamp": "01:22:04", "text": "好的那種。"}, {"type": "subtitle", "time": 4929.189, "timestamp": "01:22:09", "text": "你做了一件"}, {"type": "subtitle", "time": 4930.55, "timestamp": "01:22:10", "text": "你充滿熱情的事情，"}, {"type": "subtitle", "time": 4932.39, "timestamp": "01:22:12", "text": "現在你筋疲力盡，"}, {"type": "subtitle", "time": 4934.55, "timestamp": "01:22:14", "text": "你會想：“啊，那真是"}, {"type": "subtitle", "time": 4936.95, "timestamp": "01:22:16", "text": "太棒了。”"}, {"type": "subtitle", "time": 4942.55, "timestamp": "01:22:22", "text": "就像星期六那天，我做了腿部"}, {"type": "subtitle", "time": 4945.43, "timestamp": "01:22:25", "text": "訓練，就像我平常練腿一樣"}, {"type": "subtitle", "time": 4947.03, "timestamp": "01:22:27", "text": "。"}, {"type": "subtitle", "time": 4950.31, "timestamp": "01:22:30", "text": "今天我走不了路。我感覺自己"}, {"type": "subtitle", "time": 4957.35, "timestamp": "01:22:37", "text": "但每次走路的時候，"}, {"type": "subtitle", "time": 4967.43, "timestamp": "01:22:47", "text": "我都"}, {"type": "subtitle", "time": 4970.2, "timestamp": "01:22:50", "text": "感覺很好"}, {"type": "subtitle", "time": 4976.79, "timestamp": "01:22:56", "text": "，因為我知道我"}]
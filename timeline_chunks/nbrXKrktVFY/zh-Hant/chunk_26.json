[{"type": "subtitle", "time": 1567.11, "timestamp": "00:26:07", "text": "我心想：「好吧，今天沒人去世。哦，很好。很好。沒人畢業。很好。」"}, {"type": "subtitle", "time": 1589.269, "timestamp": "00:26:29", "text": "哦，是的。最近有很多畢業典禮之"}, {"type": "subtitle", "time": 1598.87, "timestamp": "00:26:38", "text": "類的活動。不。我的天哪。"}, {"type": "subtitle", "time": 1610.71, "timestamp": "00:26:50", "text": "你不知道我這幾週哭了多少次。我當時就想：「我的天哪"}]
[{"type": "subtitle", "time": 15901.349, "timestamp": "04:25:01", "text": "為什麼？我親眼所見。  [音樂]"}, {"type": "subtitle", "time": 15912.309, "timestamp": "04:25:12", "text": "我知道五個悟會死。  你他媽的為什麼要告訴我？但像這樣的東西，是"}, {"type": "subtitle", "time": 15925.99, "timestamp": "04:25:25", "text": "我不喜歡它的一點。不知為何，他們好像覺得這是觀看的最佳方式"}, {"type": "subtitle", "time": 15936.63, "timestamp": "04:25:36", "text": "。  [音樂] 他們把內容簡化到讓孩子們都沉迷其中。  是的。"}, {"type": "subtitle", "time": 15944.149, "timestamp": "04:25:44", "text": "我不太喜歡"}]
[{"type": "subtitle", "time": 14582.87, "timestamp": "04:03:02", "text": "即使脫離語境也無妨。他只是在用點擊誘餌博眼球。"}, {"type": "subtitle", "time": 14584.79, "timestamp": "04:03:04", "text": "他會用非常性化的方式"}, {"type": "subtitle", "time": 14595.59, "timestamp": "04:03:15", "text": "看待這件事，並且會把她剪輯掉，好像她的"}, {"type": "subtitle", "time": 14617.83, "timestamp": "04:03:37", "text": "內容被過度"}, {"type": "subtitle", "time": 14621.59, "timestamp": "04:03:41", "text": "性化了一樣，而她甚至都沒有想要性化的內容。  他就這樣一直這樣做，"}, {"type": "subtitle", "time": 14628.67, "timestamp": "04:03:48", "text": "努梅就說，好吧，這個"}, {"type": "subtitle", "time": 14631.429, "timestamp": "04:03:51", "text": "人一直在這樣做，"}, {"type": "subtitle", "time": 14634.309, "timestamp": "04:03:54", "text": "她不得不站出來說，好吧，這個人這樣做，我"}, {"type": "subtitle", "time": 14639.11, "timestamp": "04:03:59", "text": "不喜歡這樣。  有些人喜歡這個剪輯功能。是的。哦好的。"}]
[{"type": "subtitle", "time": 15553.59, "timestamp": "04:19:13", "text": "如果你喜歡動漫，如果"}, {"type": "subtitle", "time": 15556.79, "timestamp": "04:19:16", "text": "你想看動漫，你想消費動漫，你不能簡單地消費它，因為他們不會以最純粹的方式把它給你。他們會用更簡單的語言解釋給你聽"}, {"type": "subtitle", "time": 15582.79, "timestamp": "04:19:42", "text": "感覺他們好像在說你必須先看《進擊的巨人》。  這比那些好女孩之類的東西好多了。"}, {"type": "subtitle", "time": 15591.269, "timestamp": "04:19:51", "text": "如果你還沒看過《進擊的巨人》，如果你還沒看過那種少女"}, {"type": "subtitle", "time": 15598.87, "timestamp": "04:19:58", "text": "漫畫之類的東西，對吧？你"}]
[{"type": "subtitle", "time": 36121.586, "timestamp": "10:02:01", "text": "死了。我的天啊。無用。"}, {"type": "subtitle", "time": 36123.07, "timestamp": "10:02:03", "text": "閉嘴"}, {"type": "subtitle", "time": 36125.746, "timestamp": "10:02:05", "text": "。誰建造了你的房子？嗯？你"}, {"type": "subtitle", "time": 36127.79, "timestamp": "10:02:07", "text": "想去見你妻子嗎"}, {"type": "subtitle", "time": 36130.71, "timestamp": "10:02:10", "text": "？我不需要你他媽的"}, {"type": "subtitle", "time": 36134.266, "timestamp": "10:02:14", "text": "許可。我就是危險。我就是這幅"}, {"type": "subtitle", "time": 36137.906, "timestamp": "10:02:17", "text": "圖像。我要吃我的樂透巧克力"}, {"type": "subtitle", "time": 36141.586, "timestamp": "10:02:21", "text": "派。好的。在我等待的時候。  我好可怕。"}, {"type": "subtitle", "time": 36145.906, "timestamp": "10:02:25", "text": "裡面有棉花糖。好的。"}, {"type": "subtitle", "time": 36148.15, "timestamp": "10:02:28", "text": "棉花糖。  是的"}, {"type": "subtitle", "time": 36151.19, "timestamp": "10:02:31", "text": "。你永遠也吃不到，因為它是我的。  是"}, {"type": "subtitle", "time": 36156.71, "timestamp": "10:02:36", "text": "的，我們能聽到你說話。我們能聽到"}]
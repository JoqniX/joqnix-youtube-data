[{"type": "subtitle", "time": 36186.63, "timestamp": "10:03:06", "text": "你的聲音。  等待。赤村再次死亡。"}, {"type": "subtitle", "time": 36188.95, "timestamp": "10:03:08", "text": "等待。我來了。  我打算試試，"}, {"type": "subtitle", "time": 36201.586, "timestamp": "10:03:21", "text": "我一定要做飯。  我來了。各位，是不是要下暴風雨了？"}, {"type": "subtitle", "time": 36208.39, "timestamp": "10:03:28", "text": "我應該重置嗎？  我覺得我可能到不了你那裡"}, {"type": "subtitle", "time": 36210.47, "timestamp": "10:03:30", "text": "。"}, {"type": "subtitle", "time": 36211.83, "timestamp": "10:03:31", "text": "所以，這取決於你。我的天哪，這太難了。"}, {"type": "subtitle", "time": 36238.79, "timestamp": "10:03:58", "text": "等待。  你重置過嗎"}]
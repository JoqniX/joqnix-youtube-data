[{"type": "subtitle", "time": 18682.55, "timestamp": "05:11:22", "text": "。告訴我我說的對不對。我覺得《死亡筆記》很爛。 《死亡筆記》。對，《死亡筆記》動畫版不好看。"}, {"type": "subtitle", "time": 18686.07, "timestamp": "05:11:26", "text": "我沒看過。是啊，我覺得《死亡筆記》動畫版被吹得太過了。因為我第一次看的時候，對吧，《死亡筆記》還沒那麼火紅。當時也"}, {"type": "subtitle", "time": 18691.55, "timestamp": "05:11:31", "text": "挺火的，但沒現在"}, {"type": "subtitle", "time": 18695.03, "timestamp": "05:11:35", "text": "這麼火紅。對，我看完後跟"}, {"type": "subtitle", "time": 18712.628, "timestamp": "05:11:52", "text": "朋友說的第一句話就是：「你幹嘛讓"}]
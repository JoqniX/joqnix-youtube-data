[{"type": "subtitle", "time": 35163.11, "timestamp": "09:46:03", "text": "我"}, {"type": "subtitle", "time": 35165.03, "timestamp": "09:46:05", "text": "喜歡。同性戀舞會。"}, {"type": "subtitle", "time": 35173.746, "timestamp": "09:46:13", "text": "但是孩子，你在這方面有問題。哦，"}, {"type": "subtitle", "time": 35180.23, "timestamp": "09:46:20", "text": "你難道沒從那該死的汽水攤拿汽水嗎？"}, {"type": "subtitle", "time": 35195.426, "timestamp": "09:46:35", "text": "不，我不能給你。我要死了。等等，"}, {"type": "subtitle", "time": 35209.19, "timestamp": "09:46:49", "text": "我是說等天亮了之後我再去打獵，因為我還沒有水。"}, {"type": "subtitle", "time": 35214.23, "timestamp": "09:46:54", "text": "哦，我的體力好像減半了。我正躺在床上看著我的新筆記本電腦。已經可以"}]
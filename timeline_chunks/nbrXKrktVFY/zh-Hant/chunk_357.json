[{"type": "subtitle", "time": 21428.708, "timestamp": "05:57:08", "text": "閱讀障礙，對吧？"}, {"type": "subtitle", "time": 21434.948, "timestamp": "05:57:14", "text": "所以，我的"}, {"type": "subtitle", "time": 21451.19, "timestamp": "05:57:31", "text": "閱讀習慣和一般人不太一樣，這也是為什麼"}, {"type": "subtitle", "time": 21453.67, "timestamp": "05:57:33", "text": "我喜歡在獨處的時候享受閱讀的原因。"}, {"type": "subtitle", "time": 21464.23, "timestamp": "05:57:44", "text": "感覺就像是我獨處時會做的事情，有些遊戲我可以"}]
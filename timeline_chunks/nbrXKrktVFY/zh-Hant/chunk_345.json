[{"type": "subtitle", "time": 20702.548, "timestamp": "05:45:02", "text": "主播。翻個跟頭。翻個跟頭。費城什麼的。對，就翻個跟頭。你是個油管部落客。翻個跟頭。"}, {"type": "subtitle", "time": 20711.27, "timestamp": "05:45:11", "text": "感覺『油管部落客』這個標籤比做油管部落客本身"}, {"type": "subtitle", "time": 20723.99, "timestamp": "05:45:23", "text": "重要得多。我覺得最好的方法就是拋開這些，專心做內容。"}, {"type": "subtitle", "time": 20726.868, "timestamp": "05:45:26", "text": "想像一下，一個印度"}, {"type": "subtitle", "time": 20733.03, "timestamp": "05:45:33", "text": "油管博主，做關於……我不知道政治什麼的，我猜是印度政治之"}, {"type": "subtitle", "time": 20739.03, "timestamp": "05:45:39", "text": "類的"}, {"type": "subtitle", "time": 20754.07, "timestamp": "05:45:54", "text": "內容，她只是兼職做油管博主模特，然後大家都會說，對，這才是真正的油管博主，比像Quicky Quick那種……呃……Cookie Swirl之類的更像"}]
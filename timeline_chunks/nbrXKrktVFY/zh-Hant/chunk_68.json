[{"type": "subtitle", "time": 4083.91, "timestamp": "01:08:03", "text": "你他媽的"}, {"type": "subtitle", "time": 4089.029, "timestamp": "01:08:09", "text": "喜歡這個顏色。  哦"}, {"type": "subtitle", "time": 4103.03, "timestamp": "01:08:23", "text": "，你還有你的頭髮記錄呢。你留著長頭髮"}, {"type": "subtitle", "time": 4111.189, "timestamp": "01:08:31", "text": "。他們可能會互相爭吵，看誰最笨。不，我才是最笨的那個"}, {"type": "subtitle", "time": 4115.749, "timestamp": "01:08:35", "text": "。我不知道2加2等於"}]
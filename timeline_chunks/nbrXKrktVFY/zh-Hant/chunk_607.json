[{"type": "subtitle", "time": 36439.746, "timestamp": "10:07:19", "text": "哦，是誰？我這邊一直都很平靜"}, {"type": "subtitle", "time": 36463.83, "timestamp": "10:07:43", "text": "？  好的。呃"}, {"type": "subtitle", "time": 36466.266, "timestamp": "10:07:46", "text": "，我拿到棍子了。我們要"}, {"type": "subtitle", "time": 36469.03, "timestamp": "10:07:49", "text": "回家了。  是的，我有六個。  他們為什麼又掛"}, {"type": "subtitle", "time": 36471.55, "timestamp": "10:07:51", "text": "旗了？"}]
[{"type": "subtitle", "time": 15327.189, "timestamp": "04:15:27", "text": "小泡泡裡，而擴大這個泡泡的最好方法不是通過各種方式來吸引新粉絲，而是讓他們……"}, {"type": "subtitle", "time": 15331.189, "timestamp": "04:15:31", "text": "我不知道該怎麼表達，因為"}, {"type": "subtitle", "time": 15333.83, "timestamp": "04:15:33", "text": "你知道“"}, {"type": "subtitle", "time": 15338.149, "timestamp": "04:15:38", "text": "印度想要動漫”發生了什麼事嗎"}, {"type": "subtitle", "time": 15344.79, "timestamp": "04:15:44", "text": "？  呃，不。  所以，你當時在場嗎？當時印度正興起動漫運動？"}]
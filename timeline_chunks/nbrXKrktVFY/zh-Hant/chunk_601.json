[{"type": "subtitle", "time": 36061.67, "timestamp": "10:01:01", "text": "等等。  呃，你是說"}, {"type": "subtitle", "time": 36075.99, "timestamp": "10:01:15", "text": "你可以把它送到我們基地嗎？是的。哦"}, {"type": "subtitle", "time": 36088.35, "timestamp": "10:01:28", "text": "，"}, {"type": "subtitle", "time": 36094.07, "timestamp": "10:01:34", "text": "伙計們，如果你快要死了"}, {"type": "subtitle", "time": 36096.23, "timestamp": "10:01:36", "text": "，你的水就會被裝滿。那很"}, {"type": "subtitle", "time": 36098.23, "timestamp": "10:01:38", "text": "有意思。我不認為是那樣，"}, {"type": "subtitle", "time": 36099.83, "timestamp": "10:01:39", "text": "我不認為，不，它確實"}, {"type": "subtitle", "time": 36101.51, "timestamp": "10:01:41", "text": "對我來說就是這樣"}, {"type": "subtitle", "time": 36103.906, "timestamp": "10:01:43", "text": "。嗯？我覺得這不太"}, {"type": "subtitle", "time": 36106.55, "timestamp": "10:01:46", "text": "正常。"}, {"type": "subtitle", "time": 36113.266, "timestamp": "10:01:53", "text": "嗯，不，不，不，不，不。又一個。  這是怎麼"}, {"type": "subtitle", "time": 36114.71, "timestamp": "10:01:54", "text": "回事？怎麼了？我的天啊。"}, {"type": "subtitle", "time": 36116.47, "timestamp": "10:01:56", "text": "不，又一個。我又要"}]
[{"type": "subtitle", "time": 7026.07, "timestamp": "01:57:06", "text": "就像跟父母說話和跟朋友說話的區別。所以對我來說就是這樣。"}, {"type": "subtitle", "time": 7036.39, "timestamp": "01:57:16", "text": "啊，就像在網上，我把"}, {"type": "subtitle", "time": 7043.109, "timestamp": "01:57:23", "text": "每個人都當成奶奶一樣對待，因為我以前也這樣跟奶奶"}, {"type": "subtitle", "time": 7073.589, "timestamp": "01:57:53", "text": "說話，比如我會跟她解釋什麼是怪物"}, {"type": "subtitle", "time": 7078.95, "timestamp": "01:57:58", "text": "女孩，什麼是……，這個八卦是怎麼回事，"}]
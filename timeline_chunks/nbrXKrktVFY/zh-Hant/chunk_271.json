[{"type": "subtitle", "time": 16271.51, "timestamp": "04:31:11", "text": "想當YouTube部落客，你就必須面對兒童，或者你必須做某些特定的事情。所以，要當"}, {"type": "subtitle", "time": 16279.03, "timestamp": "04:31:19", "text": "YouTube部落客，我就想，就做…"}, {"type": "subtitle", "time": 16300.95, "timestamp": "04:31:40", "text": "？"}, {"type": "subtitle", "time": 16304.95, "timestamp": "04:31:44", "text": "這簡直讓我震驚。印度文化有如此巨大的潛力，"}, {"type": "subtitle", "time": 16310.91, "timestamp": "04:31:50", "text": "卻沒有人充分利用"}, {"type": "subtitle", "time": 16313.83, "timestamp": "04:31:53", "text": "它。是啊。想像一下，如果有個YouTube博主，像一個印度人一樣，講解印度的各種事物，探索美食、文化等等，那該多好啊"}]
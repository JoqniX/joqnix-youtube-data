[{"type": "subtitle", "time": 12426.389, "timestamp": "03:27:06", "text": "祖父母簡直就是"}, {"type": "subtitle", "time": 12441.11, "timestamp": "03:27:21", "text": "億萬富翁。  [音樂] 我們現在破產了。所以炫耀毫無意義。  就像我一直以來都喜歡的一件事，像是"}, {"type": "subtitle", "time": 12453.91, "timestamp": "03:27:33", "text": "美國人，我看到他們做一些事情，就會想，嗯，我父母會因為我這樣做而殺了我，你們"}]
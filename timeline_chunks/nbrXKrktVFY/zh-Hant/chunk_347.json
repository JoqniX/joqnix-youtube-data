[{"type": "subtitle", "time": 20824.15, "timestamp": "05:47:04", "text": "我不知道"}, {"type": "subtitle", "time": 20826.43, "timestamp": "05:47:06", "text": "為什麼有人討厭她"}, {"type": "subtitle", "time": 20837.43, "timestamp": "05:47:17", "text": "呃，有人討厭她是因為她以前很火，現在因為有些人說她有1000萬訂閱者，所以就說"}, {"type": "subtitle", "time": 20850.548, "timestamp": "05:47:30", "text": "「啊，她是最大的YouTuber」。其實沒人知道她，因為看她影片的是"}, {"type": "subtitle", "time": 20852.868, "timestamp": "05:47:32", "text": "小孩。是"}, {"type": "subtitle", "time": 20860.628, "timestamp": "05:47:40", "text": "啊。我希望"}, {"type": "subtitle", "time": 20865.27, "timestamp": "05:47:45", "text": "看到更多這樣的YouTuber。那種把製作內容放在第一位，"}, {"type": "subtitle", "time": 20876.868, "timestamp": "05:47:56", "text": "然後才是做YouTuber的。"}]
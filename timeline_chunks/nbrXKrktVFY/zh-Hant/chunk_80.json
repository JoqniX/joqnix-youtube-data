[{"type": "subtitle", "time": 4808.55, "timestamp": "01:20:08", "text": "就像我喜歡說的。  因為我的"}, {"type": "subtitle", "time": 4812.07, "timestamp": "01:20:12", "text": "人生經歷了很多事，所以我的精神力量"}, {"type": "subtitle", "time": 4823.11, "timestamp": "01:20:23", "text": "而且，"}, {"type": "subtitle", "time": 4832.63, "timestamp": "01:20:32", "text": "當有些事情讓我煩惱時，它們無法很快消失。因為你知道，當你對一切都感到"}, {"type": "subtitle", "time": 4834.55, "timestamp": "01:20:34", "text": "抗拒，並且有什麼東西困擾著你時，就沒有什麼"}, {"type": "subtitle", "time": 4845.51, "timestamp": "01:20:45", "text": "可以治愈"}, {"type": "subtitle", "time": 4849.11, "timestamp": "01:20:49", "text": "它，因為你所遭受的痛苦就像是它自身的兩倍。  所以，如果我這麼說你能理解的話，"}, {"type": "subtitle", "time": 4851.03, "timestamp": "01:20:51", "text": "我的精神健康狀況只會"}, {"type": "subtitle", "time": 4853.11, "timestamp": "01:20:53", "text": "因為我自己的關係而變得更糟"}, {"type": "subtitle", "time": 4854.79, "timestamp": "01:20:54", "text": "。  ["}]
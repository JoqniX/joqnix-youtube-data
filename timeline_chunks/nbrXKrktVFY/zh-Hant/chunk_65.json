[{"type": "subtitle", "time": 3909.99, "timestamp": "01:05:09", "text": "就像，「什麼？我們剛到這裡。我們沒"}, {"type": "subtitle", "time": 3912.549, "timestamp": "01:05:12", "text": "帶錢。我們得回"}, {"type": "subtitle", "time": 3915.109, "timestamp": "01:05:15", "text": "地球。想像一下，我成了星球販子。如果星球上有外星人呢？"}, {"type": "subtitle", "time": 3929.589, "timestamp": "01:05:29", "text": "我是不是也"}, {"type": "subtitle", "time": 3959.349, "timestamp": "01:05:59", "text": "有人把我們賣給了自己。有人把我們賣給中國了。是誰給了他那玩意兒"}]
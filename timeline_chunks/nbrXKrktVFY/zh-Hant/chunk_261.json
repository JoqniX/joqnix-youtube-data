[{"type": "subtitle", "time": 15670.389, "timestamp": "04:21:10", "text": "我"}, {"type": "subtitle", "time": 15673.11, "timestamp": "04:21:13", "text": "不知道為什麼人們"}, {"type": "subtitle", "time": 15676.189, "timestamp": "04:21:16", "text": "不喜歡動漫，像是《進擊的巨人"}, {"type": "subtitle", "time": 15688.229, "timestamp": "04:21:28", "text": "》，但對於動漫來說，"}, {"type": "subtitle", "time": 15689.95, "timestamp": "04:21:29", "text": "我不想看，因為他們會加入一些印度元素，就像漫威電影一樣，你知道，漫威電影配音的時候也會加入一些印度元素，一個"}, {"type": "subtitle", "time": 15702.71, "timestamp": "04:21:42", "text": "很好的例子就是，我當時在看《復仇者聯盟4：終局之戰》，"}, {"type": "subtitle", "time": 15714.469, "timestamp": "04:21:54", "text": "好像是雷神被喚醒的那段。索爾被"}]
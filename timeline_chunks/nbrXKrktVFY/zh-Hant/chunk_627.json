[{"type": "subtitle", "time": 37642.23, "timestamp": "10:27:22", "text": "哦好的。"}, {"type": "subtitle", "time": 37656.31, "timestamp": "10:27:36", "text": "好的。我们走吧。我拿到"}, {"type": "subtitle", "time": 37658.55, "timestamp": "10:27:38", "text": "布料了。我拿到了布料"}, {"type": "subtitle", "time": 37673.266, "timestamp": "10:27:53", "text": "。去我妻子家。呃，你妻子是不是叫凯拉·奥尔多斯？是的。哦，她去世了。"}]
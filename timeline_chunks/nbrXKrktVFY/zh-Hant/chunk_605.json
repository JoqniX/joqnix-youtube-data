[{"type": "subtitle", "time": 36303.426, "timestamp": "10:05:03", "text": "。哦，我想"}, {"type": "subtitle", "time": 36308.63, "timestamp": "10:05:08", "text": "你拿著盤子"}, {"type": "subtitle", "time": 36313.19, "timestamp": "10:05:13", "text": "托盤出來，然後哦，是的。是啊，是啊，是啊。  等等，"}, {"type": "subtitle", "time": 36321.99, "timestamp": "10:05:21", "text": "它在哪兒？  就在這附近。不，並非如此。它沒成功，"}, {"type": "subtitle", "time": 36331.51, "timestamp": "10:05:31", "text": "因為那裡沒人，那邊好像有人。是的，試著蹲下。拿走我的東西。"}, {"type": "subtitle", "time": 36342.55, "timestamp": "10:05:42", "text": "伙計們，這招行不通。我"}]
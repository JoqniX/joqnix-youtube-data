[{"type": "subtitle", "time": 25861.99, "timestamp": "07:11:01", "text": "意思是，年紀大的女人就像是那種很成熟、懂得生活的人。麼？ 因為"}, {"type": "subtitle", "time": 25874.468, "timestamp": "07:11:14", "text": "我跟前任的媽媽們相處的時間比跟她們本人相處的時間還多，"}, {"type": "subtitle", "time": 25901.51, "timestamp": "07:11:41", "text": "哦。歉"}, {"type": "subtitle", "time": 25907.27, "timestamp": "07:11:47", "text": "。我"}, {"type": "subtitle", "time": 25909.59, "timestamp": "07:11:49", "text": "不喜歡跟前任關係不好。不知道，老兄。覺得她們就像媽媽一樣。"}]
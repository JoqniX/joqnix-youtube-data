[{"type": "subtitle", "time": 26043.99, "timestamp": "07:14:03", "text": "嗯。所以，我就這樣和她失去了聯繫"}, {"type": "subtitle", "time": 26046.628, "timestamp": "07:14:06", "text": "。失去她之後，我一直在尋找她和她一樣的人。所以這就是我逐漸放棄"}, {"type": "subtitle", "time": 26053.548, "timestamp": "07:14:13", "text": "戀愛關係的原因。就像你之前說的，你和你的前任們都保持著朋友關係"}, {"type": "subtitle", "time": 26059.67, "timestamp": "07:14:19", "text": "，對吧？ 所以，當你和他們互動的時候，你會記得你們以前一起經歷的那些時刻嗎？這"}]
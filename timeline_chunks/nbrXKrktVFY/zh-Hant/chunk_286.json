[{"type": "subtitle", "time": 17176.87, "timestamp": "04:46:16", "text": "走吧。我看著我的Kuzna成長。我想我當時就像……就像……我當時就在她有"}, {"type": "subtitle", "time": 17184.07, "timestamp": "04:46:24", "text": "兩萬訂閱的時候。"}, {"type": "subtitle", "time": 17189.75, "timestamp": "04:46:29", "text": "我想我還有她兩萬訂閱的截圖。所以這就像一個奇蹟，因為那時候油管博主還不流行，虛擬油管博主"}, {"type": "subtitle", "time": 17193.19, "timestamp": "04:46:33", "text": "這種東西根本不存在。Hi Domo Kis，看著這一切發生"}]
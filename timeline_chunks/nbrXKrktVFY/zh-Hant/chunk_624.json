[{"type": "subtitle", "time": 37453.906, "timestamp": "10:24:13", "text": "哦，不。"}, {"type": "subtitle", "time": 37459.19, "timestamp": "10:24:19", "text": "好的，我去叫乔克。我来了，乔。别担心，宝贝"}, {"type": "subtitle", "time": 37476.79, "timestamp": "10:24:36", "text": "女儿。  好的。游戏将保持完整。  好的。  嗯，我想你不必复活。  呃，因为我可以重置"}, {"type": "subtitle", "time": 37494.55, "timestamp": "10:24:54", "text": "你会去船上。哦，对不起。重置后你就"}]
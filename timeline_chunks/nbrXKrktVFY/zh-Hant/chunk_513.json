[{"type": "subtitle", "time": 30803.43, "timestamp": "08:33:23", "text": "好嗎？希望你一切都好。  你為什麼不溜出門去？"}, {"type": "subtitle", "time": 30807.19, "timestamp": "08:33:27", "text": "等等，你和我處於同一個時區嗎？"}, {"type": "subtitle", "time": 30812.868, "timestamp": "08:33:32", "text": "還是你們不在同一個時區？"}, {"type": "subtitle", "time": 30829.35, "timestamp": "08:33:49", "text": "我忘了問：我為什麼是版主？  喲。  嗯？你是版主。你是什​​麼意思"}]
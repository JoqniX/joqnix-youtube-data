[{"type": "subtitle", "time": 27300.83, "timestamp": "07:35:00", "text": "？ 是的"}, {"type": "subtitle", "time": 27304.07, "timestamp": "07:35:04", "text": "。她說，如果我們能給你弄到另一個房間，基本上我家人計劃等我長大到我"}, {"type": "subtitle", "time": 27322.788, "timestamp": "07:35:22", "text": "哥哥們需要我的房間時，再給我弄一個房間，所以他們會在樓上給"}, {"type": "subtitle", "time": 27341.468, "timestamp": "07:35:41", "text": "我弄一個房間，然後我就可以買任何我想要的東西了，因為我想買一些"}]
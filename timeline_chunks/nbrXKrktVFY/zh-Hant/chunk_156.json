[{"type": "subtitle", "time": 9372.07, "timestamp": "02:36:12", "text": "Discord，用不同的 ID 給 Discord 上的人打惡作劇電話"}, {"type": "subtitle", "time": 9374.23, "timestamp": "02:36:14", "text": "。  等等，如何在"}, {"type": "subtitle", "time": 9381.27, "timestamp": "02:36:21", "text": "不加對方為好友的情況下打惡作劇電話？"}, {"type": "subtitle", "time": 9392.55, "timestamp": "02:36:32", "text": "不，不，不是惡作劇電話。"}, {"type": "subtitle", "time": 9405.27, "timestamp": "02:36:45", "text": "例如我會用另一個帳號去一個隨機的 Discord 伺服器。啊，我會開始問別人"}, {"type": "subtitle", "time": 9407.71, "timestamp": "02:36:47", "text": "一些諸如「我的狗走丟了」之類的問題"}, {"type": "subtitle", "time": 9419.11, "timestamp": "02:36:59", "text": "。我該"}]
[{"type": "subtitle", "time": 6182.709, "timestamp": "01:43:02", "text": "我只需要進行單程旅行。  我這裡也有紙巾。所以，如果我弄髒了"}, {"type": "subtitle", "time": 6184.95, "timestamp": "01:43:04", "text": "什麼的，我可以自己清理乾淨"}, {"type": "subtitle", "time": 6188.79, "timestamp": "01:43:08", "text": "。"}, {"type": "subtitle", "time": 6190.51, "timestamp": "01:43:10", "text": "我不用去"}, {"type": "subtitle", "time": 6195.07, "timestamp": "01:43:15", "text": "廚房拿紙巾。"}, {"type": "subtitle", "time": 6206.629, "timestamp": "01:43:26", "text": "我這裡還有我喜歡的大部分東西，像是蛋白奶昔、蛋白粉之類的。  我旁邊的小袋子裡也放著一些零食，像是餅乾之類的，以備深夜餓的時候吃。"}, {"type": "chat", "time": 6206.661, "timestamp": "01:43:26", "author": "@BRUCELEE-wt7hk", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kywKa6HSckNVxhER8qedLRRVkcGIqFFytjQHe-071HyMo=s64-c-k-c0x00ffffff-no-rj", "message": "chalo I will see you later bye"}, {"type": "subtitle", "time": 6223.75, "timestamp": "01:43:43", "text": "我在這裡基本上開了一家小店"}, {"type": "chat", "time": 6230.773, "timestamp": "01:43:50", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "hai take care bruce lee san"}, {"type": "subtitle", "time": 6235.189, "timestamp": "01:43:55", "text": "一些朋友"}, {"type": "subtitle", "time": 6239.27, "timestamp": "01:43:59", "text": "在我的房間裡，我姐姐說：“哦，橙子，你有創可貼嗎？” 我就會說：“是"}]
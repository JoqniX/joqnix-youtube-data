[{"type": "subtitle", "time": 21007.11, "timestamp": "05:50:07", "text": "嗯，那你應該去"}, {"type": "subtitle", "time": 21008.788, "timestamp": "05:50:08", "text": "。好的，那我一會兒就回來。好的，我可以繼續了。去吧，Pisco。你……"}, {"type": "subtitle", "time": 21024.708, "timestamp": "05:50:24", "text": "你吃晚餐了嗎？嗯，我吃了。"}, {"type": "subtitle", "time": 21045.51, "timestamp": "05:50:45", "text": "哦，不錯。大家好。簡單聊幾句。在他回來之前，你得先承認自己是同性戀。進展太快了。得……坦白我是同性戀，"}, {"type": "subtitle", "time": 21056.47, "timestamp": "05:50:56", "text": "這樣就沒人發現了。兄弟，你大概聽到那根發霉的香蕉了吧。不，我"}]
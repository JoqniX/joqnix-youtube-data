[{"type": "subtitle", "time": 3976.23, "timestamp": "01:06:16", "text": "？他就像，「我不知道，夥計。」"}, {"type": "subtitle", "time": 3984.069, "timestamp": "01:06:24", "text": "但文件上說得通。文件上說"}, {"type": "subtitle", "time": 3989.19, "timestamp": "01:06:29", "text": "這筆生意真的能做成，因為如果你看看太陽系和星系，你會發現現在有這麼多恆星和"}, {"type": "subtitle", "time": 3991.589, "timestamp": "01:06:31", "text": "行星。是啊。行星的數量比我們星球上的沙粒還多。"}]
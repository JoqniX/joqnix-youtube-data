[{"type": "subtitle", "time": 11300.07, "timestamp": "03:08:20", "text": "不知道，因為asmin說他們沒辦法封禁"}, {"type": "subtitle", "time": 11310.469, "timestamp": "03:08:30", "text": "阿斯敏。哦，對，沒錯。例如哈桑，他說的那些話，"}, {"type": "subtitle", "time": 11321.349, "timestamp": "03:08:41", "text": "我覺得不合法，我看了之後就想，天哪，他怎麼能這麼做"}, {"type": "subtitle", "time": 11323.349, "timestamp": "03:08:43", "text": "？最近哈桑開始在印度圈活躍起來。是的"}]
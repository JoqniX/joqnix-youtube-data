[{"type": "subtitle", "time": 10261.75, "timestamp": "02:51:01", "text": "操？就像在我脑子里一样"}, {"type": "subtitle", "time": 10264.469, "timestamp": "02:51:04", "text": "听起来像是，“是啊，我弟弟会说话。”"}, {"type": "subtitle", "time": 10267.51, "timestamp": "02:51:07", "text": "给保安。"}, {"type": "subtitle", "time": 10276.79, "timestamp": "02:51:16", "text": "感觉很奇怪，就像……"}, {"type": "subtitle", "time": 10279.03, "timestamp": "02:51:19", "text": "作为一名印度人，这很有趣，因为……"}, {"type": "subtitle", "time": 10281.19, "timestamp": "02:51:21", "text": "和其他人一样，也看到了其他"}, {"type": "subtitle", "time": 10283.269, "timestamp": "02:51:23", "text": "东西。这就是它的好处"}, {"type": "subtitle", "time": 10285.03, "timestamp": "02:51:25", "text": "互联网。你看到其他人这样做"}, {"type": "subtitle", "time": 10287.59, "timestamp": "02:51:27", "text": "其他一些东西，然后你会想，啊，原来如此。"}, {"type": "subtitle", "time": 10289.71, "timestamp": "02:51:29", "text": "只是"}, {"type": "subtitle", "time": 10292.71, "timestamp": "02:51:32", "text": "我们喜欢印度引以为豪的这一点"}, {"type": "subtitle", "time": 10300.15, "timestamp": "02:51:40", "text": "我感觉就像有人跟我说的那样"}, {"type": "subtitle", "time": 10304.309, "timestamp": "02:51:44", "text": "比如，“你知道我们拥有最多的呃……”"}, {"type": "subtitle", "time": 10307.11, "timestamp": "02:51:47", "text": "我们拥有最先进的文明"}, {"type": "subtitle", "time": 10308.349, "timestamp": "02:51:48", "text": "回到"}, {"type": "subtitle", "time": 10318.19, "timestamp": "02:51:58", "text": "尽管？那怎么会是……那怎么会是……"}]
[{"type": "subtitle", "time": 4320.87, "timestamp": "01:12:00", "text": "这就是安娜的本质。我的天哪。是的。不"}, {"type": "subtitle", "time": 4322.93, "timestamp": "01:12:02", "text": "规则。什么都可以。"}, {"type": "subtitle", "time": 4324.47, "timestamp": "01:12:04", "text": "[音乐]"}, {"type": "subtitle", "time": 4328.55, "timestamp": "01:12:08", "text": "你想杀了那个人？大胆试试吧。"}, {"type": "subtitle", "time": 4329.55, "timestamp": "01:12:09", "text": "哦"}, {"type": "subtitle", "time": 4332.87, "timestamp": "01:12:12", "text": "不。哦，它有它自己的"}, {"type": "subtitle", "time": 4336.95, "timestamp": "01:12:16", "text": "也有缺点。暴力之类的。"}, {"type": "subtitle", "time": 4343.51, "timestamp": "01:12:23", "text": "所以，就像我脑海中的慢跑协会会是……"}, {"type": "subtitle", "time": 4346.709, "timestamp": "01:12:26", "text": "就像你知道的那些仙女一样"}, {"type": "subtitle", "time": 4350.27, "timestamp": "01:12:30", "text": "就像童话故事一样，就像拥有一样"}, {"type": "subtitle", "time": 4352.79, "timestamp": "01:12:32", "text": "大家都在谈论一件事情"}, {"type": "subtitle", "time": 4355.35, "timestamp": "01:12:35", "text": "采摘浆果的工作"}, {"type": "subtitle", "time": 4357.43, "timestamp": "01:12:37", "text": "幸福的一家人。是的。就像我那样"}, {"type": "subtitle", "time": 4360.39, "timestamp": "01:12:40", "text": "看看你的社会。确切地。无暴力"}, {"type": "subtitle", "time": 4363.35, "timestamp": "01:12:43", "text": "或者任何以幸福美满的结局收尾的故事。"}, {"type": "subtitle", "time": 4364.709, "timestamp": "01:12:44", "text": "是的。他们好像不知道那是什么。"}, {"type": "subtitle", "time": 4366.63, "timestamp": "01:12:46", "text": "你们在聊什么呢？暴力。"}, {"type": "subtitle", "time": 4367.83, "timestamp": "01:12:47", "text": "那是什么？"}, {"type": "subtitle", "time": 4370.07, "timestamp": "01:12:50", "text": "确切地。那是什么？那就像……"}, {"type": "subtitle", "time": 4375.59, "timestamp": "01:12:55", "text": "[音乐]"}, {"type": "subtitle", "time": 4378.43, "timestamp": "01:12:58", "text": "我的社会很可能会是"}]
[{"type": "subtitle", "time": 1806.23, "timestamp": "00:30:06", "text": "啊，那是我第一次听到"}, {"type": "subtitle", "time": 1811.99, "timestamp": "00:30:11", "text": "明智的。"}, {"type": "subtitle", "time": 1815.11, "timestamp": "00:30:15", "text": "但是，嗯，继续……"}, {"type": "subtitle", "time": 1818.549, "timestamp": "00:30:18", "text": "呃，如果我呃，打破我的呃第四个"}, {"type": "subtitle", "time": 1819.47, "timestamp": "00:30:19", "text": "墙"}, {"type": "subtitle", "time": 1823.83, "timestamp": "00:30:23", "text": "我，呃，从生理角度来说，我是一名男性。"}, {"type": "subtitle", "time": 1826.789, "timestamp": "00:30:26", "text": "所以，问题就在于我有一个男性朋友。"}, {"type": "subtitle", "time": 1828.789, "timestamp": "00:30:28", "text": "溪流。"}, {"type": "subtitle", "time": 1831.59, "timestamp": "00:30:31", "text": "直播中出现男性。"}, {"type": "subtitle", "time": 1834.389, "timestamp": "00:30:34", "text": "我的意思是，以人类形态。以人形出现，"}, {"type": "subtitle", "time": 1835.99, "timestamp": "00:30:35", "text": "聊天。即使化作人形，我们依然善良。"}, {"type": "subtitle", "time": 1838.909, "timestamp": "00:30:38", "text": "在人类中。是的。以人类形态，我是一名"}, {"type": "subtitle", "time": 1841.83, "timestamp": "00:30:41", "text": "男性。只是我的手比较软。"}, {"type": "subtitle", "time": 1848.51, "timestamp": "00:30:48", "text": "是的。"}, {"type": "subtitle", "time": 1852.63, "timestamp": "00:30:52", "text": "那样的声音，我就要开始了"}, {"type": "subtitle", "time": 1854.43, "timestamp": "00:30:54", "text": "钓鱼"}, {"type": "subtitle", "time": 1856.47, "timestamp": "00:30:56", "text": "有人出现，这是件好事。我做了"}, {"type": "subtitle", "time": 1859.11, "timestamp": "00:30:59", "text": "也是。就像我刚出道的时候，我"}]
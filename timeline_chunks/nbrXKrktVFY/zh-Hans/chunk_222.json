[{"type": "subtitle", "time": 13327.469, "timestamp": "03:42:07", "text": "就像我所看到的一样"}, {"type": "subtitle", "time": 13330.03, "timestamp": "03:42:10", "text": "嗯，他们本来可以做到的。"}, {"type": "subtitle", "time": 13334.229, "timestamp": "03:42:14", "text": "更喜欢这样，但问题是，因为彼得"}, {"type": "subtitle", "time": 13336.71, "timestamp": "03:42:16", "text": "印度的翼被低估了一切"}, {"type": "subtitle", "time": 13339.19, "timestamp": "03:42:19", "text": "因为就像每当有……"}, {"type": "subtitle", "time": 13342.71, "timestamp": "03:42:22", "text": "只有一家正规公司，那里有两家公司。"}, {"type": "subtitle", "time": 13345.99, "timestamp": "03:42:25", "text": "他们试图制定自己的规则，"}, {"type": "subtitle", "time": 13346.83, "timestamp": "03:42:26", "text": "不"}, {"type": "subtitle", "time": 13351.03, "timestamp": "03:42:31", "text": "尺寸合适，就像正规的票一样。"}, {"type": "subtitle", "time": 13355.75, "timestamp": "03:42:35", "text": "不，是那家公司。不。是的。是的。我"}, {"type": "subtitle", "time": 13357.91, "timestamp": "03:42:37", "text": "霍尔莱夫有规章制度，因为……"}, {"type": "subtitle", "time": 13361.429, "timestamp": "03:42:41", "text": "发生了。是的。并非因为他们有"}, {"type": "subtitle", "time": 13363.229, "timestamp": "03:42:43", "text": "从一开始就有规则。唯一的规则"}, {"type": "subtitle", "time": 13366.63, "timestamp": "03:42:46", "text": "玩得很开心。"}, {"type": "subtitle", "time": 13369.03, "timestamp": "03:42:49", "text": "然后人们开始玩得开心起来，"}, {"type": "subtitle", "time": 13370.389, "timestamp": "03:42:50", "text": "他们做了些事情，然后他们会说：“好的，"}, {"type": "subtitle", "time": 13372.229, "timestamp": "03:42:52", "text": "没关系。"}, {"type": "subtitle", "time": 13379.11, "timestamp": "03:42:59", "text": "嗯。比如……"}]
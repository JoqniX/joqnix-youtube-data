[{"type": "subtitle", "time": 6301.109, "timestamp": "01:45:01", "text": "伤心"}, {"type": "subtitle", "time": 6302.91, "timestamp": "01:45:02", "text": "大部分"}, {"type": "subtitle", "time": 6305.83, "timestamp": "01:45:05", "text": "时间。就像我以前做过的一件事，"}, {"type": "subtitle", "time": 6307.91, "timestamp": "01:45:07", "text": "现在这样做不健康，所以我不再这样做了，因为"}, {"type": "subtitle", "time": 6309.99, "timestamp": "01:45:09", "text": "就像我的一个前任一样，她把我从这件事中解救了出来。"}, {"type": "subtitle", "time": 6311.75, "timestamp": "01:45:11", "text": "坏习惯。"}, {"type": "subtitle", "time": 6314.79, "timestamp": "01:45:14", "text": "我会自嘲一番，看看会发生什么。"}, {"type": "subtitle", "time": 6317.99, "timestamp": "01:45:17", "text": "我感觉很糟糕。"}, {"type": "subtitle", "time": 6321.189, "timestamp": "01:45:21", "text": "像侮辱、批评或类似“是啊”那样。"}, {"type": "subtitle", "time": 6322.79, "timestamp": "01:45:22", "text": "不是批评，只是呼吁"}, {"type": "subtitle", "time": 6325.83, "timestamp": "01:45:25", "text": "我自己给自己取名字，看看哪个适合我。"}, {"type": "subtitle", "time": 6328.79, "timestamp": "01:45:28", "text": "就像说了最刻薄的话"}, {"type": "subtitle", "time": 6335.27, "timestamp": "01:45:35", "text": "想象一下谁会说出这样的话"}, {"type": "subtitle", "time": 6339.109, "timestamp": "01:45:39", "text": "对我来说，这可能会伤害到我。"}, {"type": "subtitle", "time": 6340.55, "timestamp": "01:45:40", "text": "这样做真的很糟糕。"}, {"type": "subtitle", "time": 6343.83, "timestamp": "01:45:43", "text": "开玩笑。别这么做。是的，我发现了一个"}, {"type": "subtitle", "time": 6344.91, "timestamp": "01:45:44", "text": "很多关于"}, {"type": "subtitle", "time": 6349.03, "timestamp": "01:45:49", "text": "那天的我。但当我把这件事告诉前任时，"}, {"type": "subtitle", "time": 6350.95, "timestamp": "01:45:50", "text": "她当时就说：“哦，你他妈的为什么要这么做？”"}, {"type": "subtitle", "time": 6352.79, "timestamp": "01:45:52", "text": "“你为什么要那样对待自己？” 我心想，"}, {"type": "subtitle", "time": 6356.47, "timestamp": "01:45:56", "text": "“那样错了吗？”我正在准备中"}, {"type": "subtitle", "time": 6358.709, "timestamp": "01:45:58", "text": "我。比如有人骂我，"}]
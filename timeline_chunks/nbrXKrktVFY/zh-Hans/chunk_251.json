[{"type": "subtitle", "time": 15060.79, "timestamp": "04:11:00", "text": "我用我的母语印地语说话，就像这样"}, {"type": "subtitle", "time": 15067.03, "timestamp": "04:11:07", "text": "我的聊天对象很感激这一点，因为"}, {"type": "subtitle", "time": 15069.83, "timestamp": "04:11:09", "text": "就像我一样，当我……我变得充满激情"}, {"type": "subtitle", "time": 15072.63, "timestamp": "04:11:12", "text": "我会说印地语，我有一些有趣的方式"}, {"type": "subtitle", "time": 15075.03, "timestamp": "04:11:15", "text": "沟通主要占10%。"}, {"type": "subtitle", "time": 15078.15, "timestamp": "04:11:18", "text": "库尔德语占10%的信息，其余的是"}, {"type": "subtitle", "time": 15093.71, "timestamp": "04:11:33", "text": "说实话，我确实抱有很高的期望，但是"}, {"type": "subtitle", "time": 15096.229, "timestamp": "04:11:36", "text": "还有，我想问问你……"}]
[{"type": "subtitle", "time": 1382.87, "timestamp": "00:23:02", "text": "很高兴见到大家。"}, {"type": "subtitle", "time": 1386.47, "timestamp": "00:23:06", "text": "什么是天文爱好者？星体是什么？"}, {"type": "subtitle", "time": 1390.51, "timestamp": "00:23:10", "text": "星座？是的。更像是星体"}, {"type": "subtitle", "time": 1393.27, "timestamp": "00:23:13", "text": "星座的孕育者。更像是"}, {"type": "subtitle", "time": 1396.63, "timestamp": "00:23:16", "text": "星座守护者。"}, {"type": "subtitle", "time": 1399.59, "timestamp": "00:23:19", "text": "是的。嗯。有趣的。"}, {"type": "subtitle", "time": 1401.149, "timestamp": "00:23:21", "text": "所以你喜欢"}, {"type": "subtitle", "time": 1405.99, "timestamp": "00:23:25", "text": "你就像个保安。"}, {"type": "subtitle", "time": 1410.149, "timestamp": "00:23:30", "text": "你可以这么称呼它。是的。哦，糟糕。"}, {"type": "subtitle", "time": 1413.43, "timestamp": "00:23:33", "text": "你见过那个叫维沙尔的家伙吗？"}, {"type": "subtitle", "time": 1416.87, "timestamp": "00:23:36", "text": "最近有关于保安的梗图吗？"}, {"type": "subtitle", "time": 1420.87, "timestamp": "00:23:40", "text": "哪一个？不，我没有在现实生活中这样做过。"}, {"type": "subtitle", "time": 1423.83, "timestamp": "00:23:43", "text": "不，我没有。所以，就像这样……"}, {"type": "subtitle", "time": 1426.31, "timestamp": "00:23:46", "text": "印度人真实的一面。他们有"}, {"type": "subtitle", "time": 1427.99, "timestamp": "00:23:47", "text": "一直在做这件事。他们正在尝试"}, {"type": "subtitle", "time": 1430.23, "timestamp": "00:23:50", "text": "比如找一份保安工作"}, {"type": "subtitle", "time": 1433.43, "timestamp": "00:23:53", "text": "向 Vishal Maul 提出申请。"}, {"type": "subtitle", "time": 1435.19, "timestamp": "00:23:55", "text": "好的。显然有人正在这样做"}, {"type": "subtitle", "time": 1437.11, "timestamp": "00:23:57", "text": "听起来像你，他们是，他们是"}]
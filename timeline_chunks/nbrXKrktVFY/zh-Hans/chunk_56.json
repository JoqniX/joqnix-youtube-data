[{"type": "subtitle", "time": 3363.349, "timestamp": "00:56:03", "text": "[音乐]"}, {"type": "subtitle", "time": 3365.91, "timestamp": "00:56:05", "text": "就像我问我爸，我们是不是要付钱？"}, {"type": "subtitle", "time": 3367.99, "timestamp": "00:56:07", "text": "纳税？我问了我爸，他说："}, {"type": "subtitle", "time": 3370.069, "timestamp": "00:56:10", "text": "“有些年份我们会这样做，有些年份则不会。”"}, {"type": "subtitle", "time": 3372.15, "timestamp": "00:56:12", "text": "我当时就想，“为什么？”她说道：“因为我们"}, {"type": "subtitle", "time": 3374.309, "timestamp": "00:56:14", "text": "不要把它们列为硬性要求。我们相遇"}, {"type": "subtitle", "time": 3377.87, "timestamp": "00:56:17", "text": "不符合纳税要求"}, {"type": "subtitle", "time": 3380.789, "timestamp": "00:56:20", "text": "有时，几年。”"}, {"type": "subtitle", "time": 3382.829, "timestamp": "00:56:22", "text": "是的。喜欢，"}, {"type": "subtitle", "time": 3385.67, "timestamp": "00:56:25", "text": "好的。但它在每个方面都不同。"}, {"type": "subtitle", "time": 3386.8, "timestamp": "00:56:26", "text": "国家。"}, {"type": "subtitle", "time": 3388.63, "timestamp": "00:56:28", "text": "[音乐]"}, {"type": "subtitle", "time": 3391.51, "timestamp": "00:56:31", "text": "比如在美国，你要缴纳税款"}, {"type": "subtitle", "time": 3395.27, "timestamp": "00:56:35", "text": "你买的所有东西，我们都要缴税。"}, {"type": "subtitle", "time": 3398.87, "timestamp": "00:56:38", "text": "因为我们有MRP系统。"}, {"type": "subtitle", "time": 3401.75, "timestamp": "00:56:41", "text": "所以我们购买的物品都要缴纳税款。我们"}, {"type": "subtitle", "time": 3412.47, "timestamp": "00:56:52", "text": "有人在我的聊天记录里问我，我会去吗？"}, {"type": "subtitle", "time": 3414.39, "timestamp": "00:56:54", "text": "如果我不知道如何支付，那就是逃税。"}]
[{"type": "subtitle", "time": 9900.63, "timestamp": "02:45:00", "text": "乌杜。"}, {"type": "subtitle", "time": 9902.55, "timestamp": "02:45:02", "text": "是的。"}, {"type": "subtitle", "time": 9905.11, "timestamp": "02:45:05", "text": "而外面的人都说印地语。说话"}, {"type": "subtitle", "time": 9907.75, "timestamp": "02:45:07", "text": "印地语。所以乌杜语是我的第一语言。"}, {"type": "subtitle", "time": 9911.19, "timestamp": "02:45:11", "text": "然后就变成了印地语。印地语或乌杜语"}, {"type": "subtitle", "time": 9913.269, "timestamp": "02:45:13", "text": "有点类似。所以我没注意到。我"}, {"type": "subtitle", "time": 9914.79, "timestamp": "02:45:14", "text": "我只是以为人们在说话。"}, {"type": "subtitle", "time": 9922.23, "timestamp": "02:45:22", "text": "而现在，我不说话了，我不喜欢说话。"}, {"type": "subtitle", "time": 9925.75, "timestamp": "02:45:25", "text": "因为我不喜欢说乌都语"}, {"type": "subtitle", "time": 9927.51, "timestamp": "02:45:27", "text": "乌杜。"}, {"type": "subtitle", "time": 9929.63, "timestamp": "02:45:29", "text": "因为童年的一些事"}, {"type": "subtitle", "time": 9932.79, "timestamp": "02:45:32", "text": "东西。这给他带来了创伤，也给我带来了创伤。"}, {"type": "subtitle", "time": 9934.59, "timestamp": "02:45:34", "text": "每当我说话的时候"}, {"type": "subtitle", "time": 9938.23, "timestamp": "02:45:38", "text": "udu。我现在只跟我的家人说印地语了。"}, {"type": "subtitle", "time": 9947.07, "timestamp": "02:45:47", "text": "我觉得我的第三语言"}, {"type": "subtitle", "time": 9949.83, "timestamp": "02:45:49", "text": "我想那应该是德语吧"}, {"type": "subtitle", "time": 9955.269, "timestamp": "02:45:55", "text": "原因。哦，是的。我学习了德语，"}, {"type": "subtitle", "time": 9958.309, "timestamp": "02:45:58", "text": "那时它还是英语。"}]
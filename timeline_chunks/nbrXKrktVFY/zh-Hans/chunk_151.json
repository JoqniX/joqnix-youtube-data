[{"type": "subtitle", "time": 9067.59, "timestamp": "02:31:07", "text": "但是，就像他刚才说的那样……"}, {"type": "subtitle", "time": 9069.99, "timestamp": "02:31:09", "text": "比如他们如何留住观众"}, {"type": "subtitle", "time": 9073.349, "timestamp": "02:31:13", "text": "当他们观众表现愚蠢的时候。"}, {"type": "subtitle", "time": 9075.99, "timestamp": "02:31:15", "text": "好像这不是我的观众，他们是"}, {"type": "subtitle", "time": 9077.389, "timestamp": "02:31:17", "text": "完全地"}, {"type": "subtitle", "time": 9081.75, "timestamp": "02:31:21", "text": "清白的。不，他们不是。"}, {"type": "subtitle", "time": 9083.99, "timestamp": "02:31:23", "text": "就像阿斯明在聊天中做的一件事一样"}, {"type": "subtitle", "time": 9087.67, "timestamp": "02:31:27", "text": "我喜欢这一点，每个人都能得到对待。"}, {"type": "subtitle", "time": 9089.59, "timestamp": "02:31:29", "text": "它们就像是分开的一样。"}, {"type": "subtitle", "time": 9091.99, "timestamp": "02:31:31", "text": "人。"}, {"type": "subtitle", "time": 9094.27, "timestamp": "02:31:34", "text": "他不喜欢集体蜂巢"}, {"type": "subtitle", "time": 9097.19, "timestamp": "02:31:37", "text": "头脑。啊，"}, {"type": "subtitle", "time": 9098.95, "timestamp": "02:31:38", "text": "我挺喜欢甲壳虫的那种感觉……"}, {"type": "subtitle", "time": 9100.71, "timestamp": "02:31:40", "text": "聊天是。这就像……这就像……"}, {"type": "subtitle", "time": 9103.27, "timestamp": "02:31:43", "text": "蜂群。我喜欢某些事物中的群体思维。"}, {"type": "subtitle", "time": 9106.51, "timestamp": "02:31:46", "text": "情况。就像蜂群一样"}, {"type": "subtitle", "time": 9111.03, "timestamp": "02:31:51", "text": "太可爱了。嗯。我的意思是，就像"}, {"type": "subtitle", "time": 9113.75, "timestamp": "02:31:53", "text": "货运公司之类的，但还是……是的。是的。"}, {"type": "subtitle", "time": 9115.03, "timestamp": "02:31:55", "text": "我也喜欢这些货运公司，因为"}, {"type": "subtitle", "time": 9118.07, "timestamp": "02:31:58", "text": "他们很有趣。"}, {"type": "subtitle", "time": 9119.389, "timestamp": "02:31:59", "text": "但"}]
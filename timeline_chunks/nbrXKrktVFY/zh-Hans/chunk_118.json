[{"type": "subtitle", "time": 7082.07, "timestamp": "01:58:02", "text": "是的。但随着时间的推移，在……的帮助下"}, {"type": "subtitle", "time": 7084.55, "timestamp": "01:58:04", "text": "粉丝们都很喜欢现在发生的一切。"}, {"type": "subtitle", "time": 7089.03, "timestamp": "01:58:09", "text": "她成为了最强大的全息成员。"}, {"type": "subtitle", "time": 7091.51, "timestamp": "01:58:11", "text": "因为她拥有穿越时空的能力。她"}, {"type": "subtitle", "time": 7094.149, "timestamp": "01:58:14", "text": "也像某些人一样，呃"}, {"type": "subtitle", "time": 7096.629, "timestamp": "01:58:16", "text": "对某些事物的了解。她基本"}, {"type": "subtitle", "time": 7099.43, "timestamp": "01:58:19", "text": "她基本上变成了奇异博士。"}, {"type": "subtitle", "time": 7101.83, "timestamp": "01:58:21", "text": "是的。"}, {"type": "subtitle", "time": 7103.669, "timestamp": "01:58:23", "text": "她拥有像霍尔一样拯救世界的能力。"}, {"type": "subtitle", "time": 7106.07, "timestamp": "01:58:26", "text": "那时的生活就像……"}, {"type": "subtitle", "time": 7115.189, "timestamp": "01:58:35", "text": "是的。我看过那部动画片。我当时"}, {"type": "subtitle", "time": 7119.189, "timestamp": "01:58:39", "text": "哇，太厉害了，这居然是一个人做出来的。"}, {"type": "subtitle", "time": 7123.43, "timestamp": "01:58:43", "text": "是的。他究竟是怎么做到的？他为什么要这么做？"}, {"type": "subtitle", "time": 7128.149, "timestamp": "01:58:48", "text": "那家偶像公司。他这样做是为了一个"}, {"type": "subtitle", "time": 7130.709, "timestamp": "01:58:50", "text": "偶像，还有脸部连接"}, {"type": "subtitle", "time": 7135.75, "timestamp": "01:58:55", "text": "成员。啊，就像预告片那样。"}]
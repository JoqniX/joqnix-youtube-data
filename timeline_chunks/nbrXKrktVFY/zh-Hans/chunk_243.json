[{"type": "subtitle", "time": 14580.309, "timestamp": "04:03:00", "text": "虚拟主播"}, {"type": "subtitle", "time": 14582.87, "timestamp": "04:03:02", "text": "嗯。在他露面之前也是如此。所以他"}, {"type": "subtitle", "time": 14584.79, "timestamp": "04:03:04", "text": "他之前没露脸吗？"}, {"type": "subtitle", "time": 14587.189, "timestamp": "04:03:07", "text": "那。"}, {"type": "subtitle", "time": 14595.59, "timestamp": "04:03:15", "text": "就像我以前一样，我很喜欢看《魔女嘉莉》。"}, {"type": "subtitle", "time": 14598.309, "timestamp": "04:03:18", "text": "那时候他好像只有1万美元。"}, {"type": "subtitle", "time": 14600.11, "timestamp": "04:03:20", "text": "订阅者，10 或"}, {"type": "subtitle", "time": 14602.11, "timestamp": "04:03:22", "text": "20K，就像制造的"}, {"type": "subtitle", "time": 14607.429, "timestamp": "04:03:27", "text": "就像一些莫名其妙的小吐槽视频。"}, {"type": "subtitle", "time": 14608.71, "timestamp": "04:03:28", "text": "嗯。"}, {"type": "subtitle", "time": 14611.03, "timestamp": "04:03:31", "text": "就像他一样，我想当他得到"}, {"type": "subtitle", "time": 14613.429, "timestamp": "04:03:33", "text": "就像拥有200万订阅者一样，我停止了。"}, {"type": "subtitle", "time": 14615.309, "timestamp": "04:03:35", "text": "看着他"}, {"type": "subtitle", "time": 14617.83, "timestamp": "04:03:37", "text": "因为内容开始让人感觉"}, {"type": "subtitle", "time": 14621.59, "timestamp": "04:03:41", "text": "脚本化，脚本化程度太高了。"}, {"type": "subtitle", "time": 14623.269, "timestamp": "04:03:43", "text": "感觉他故意刁难别人，就为了这个目的。"}, {"type": "subtitle", "time": 14626.229, "timestamp": "04:03:46", "text": "刻薄。"}, {"type": "subtitle", "time": 14628.67, "timestamp": "04:03:48", "text": "嗯。它是"}, {"type": "subtitle", "time": 14631.429, "timestamp": "04:03:51", "text": "怎么说呢？当某人"}, {"type": "subtitle", "time": 14634.309, "timestamp": "04:03:54", "text": "他们说，这话对你来说意味着什么，对吧？"}, {"type": "subtitle", "time": 14637.349, "timestamp": "04:03:57", "text": "此刻对你来说意义非凡。你是"}, {"type": "subtitle", "time": 14639.11, "timestamp": "04:03:59", "text": "比如，“哦，你知道你是他们不是。”"}]
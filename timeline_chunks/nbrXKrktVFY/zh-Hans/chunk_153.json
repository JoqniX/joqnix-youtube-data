[{"type": "subtitle", "time": 9181.15, "timestamp": "02:33:01", "text": "所以"}, {"type": "subtitle", "time": 9183.99, "timestamp": "02:33:03", "text": "就我个人而言，我不会进行任何限制。"}, {"type": "subtitle", "time": 9186.55, "timestamp": "02:33:06", "text": "我的聊天"}, {"type": "subtitle", "time": 9188.15, "timestamp": "02:33:08", "text": "因为我感觉自己不在那里"}, {"type": "subtitle", "time": 9190.87, "timestamp": "02:33:10", "text": "需要任何节制"}, {"type": "subtitle", "time": 9192.389, "timestamp": "02:33:12", "text": "有时候我的朋友会进来"}, {"type": "subtitle", "time": 9195.19, "timestamp": "02:33:15", "text": "聊天的时候他们会开始说些什么"}, {"type": "subtitle", "time": 9196.95, "timestamp": "02:33:16", "text": "他们是我的朋友，我可以把他们静音。"}, {"type": "subtitle", "time": 9199.429, "timestamp": "02:33:19", "text": "暂停一下，嗯，"}, {"type": "subtitle", "time": 9201.469, "timestamp": "02:33:21", "text": "这一切都是"}, {"type": "subtitle", "time": 9203.99, "timestamp": "02:33:23", "text": "美好的。但我会像那两个人一样去。"}, {"type": "subtitle", "time": 9206.469, "timestamp": "02:33:26", "text": "观点，对吧？"}, {"type": "subtitle", "time": 9208.469, "timestamp": "02:33:28", "text": "我会在聊天中说些什么，"}, {"type": "subtitle", "time": 9209.67, "timestamp": "02:33:29", "text": "他们会说：“好吧，你不应该……”"}, {"type": "subtitle", "time": 9217.67, "timestamp": "02:33:37", "text": "他们会开始装作一副什么都不懂的样子。"}, {"type": "subtitle", "time": 9220.99, "timestamp": "02:33:40", "text": "感觉有点不对劲，但我又不太明白。"}, {"type": "subtitle", "time": 9223.79, "timestamp": "02:33:43", "text": "他们会点赞，也会阅读或不回复。"}, {"type": "subtitle", "time": 9226.07, "timestamp": "02:33:46", "text": "有时候他们会阅读你的聊天记录"}, {"type": "subtitle", "time": 9227.95, "timestamp": "02:33:47", "text": "不回答。我当时就想，"}, {"type": "subtitle", "time": 9230.27, "timestamp": "02:33:50", "text": "“好的，"}, {"type": "subtitle", "time": 9233.349, "timestamp": "02:33:53", "text": "好的。我开了个玩笑。你是"}, {"type": "subtitle", "time": 9239.71, "timestamp": "02:33:59", "text": "[音乐]"}]
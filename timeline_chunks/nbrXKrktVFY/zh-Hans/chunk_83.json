[{"type": "subtitle", "time": 4982.149, "timestamp": "01:23:02", "text": "因为就像小时候一样，每个人都选了"}, {"type": "subtitle", "time": 4983.75, "timestamp": "01:23:03", "text": "像打电话给我一样，因为我"}, {"type": "subtitle", "time": 4987.59, "timestamp": "01:23:07", "text": "小时候非常瘦。"}, {"type": "subtitle", "time": 4990.07, "timestamp": "01:23:10", "text": "我所做的一切都没有给我带来任何好处。"}, {"type": "subtitle", "time": 4993.35, "timestamp": "01:23:13", "text": "体重方面，我还是增不了重。"}, {"type": "subtitle", "time": 4997.51, "timestamp": "01:23:17", "text": "无论我吃多少，无论我做什么"}, {"type": "subtitle", "time": 4999.35, "timestamp": "01:23:19", "text": "东西，"}, {"type": "subtitle", "time": 5001.35, "timestamp": "01:23:21", "text": "不知何故，我的身体不允许"}, {"type": "subtitle", "time": 5003.11, "timestamp": "01:23:23", "text": "我。我真的去看医生了。"}, {"type": "subtitle", "time": 5005.11, "timestamp": "01:23:25", "text": "然后问：“哦，医生，有吗？”"}, {"type": "subtitle", "time": 5007.83, "timestamp": "01:23:27", "text": "我是不是有什么问题？比如因为我"}, {"type": "subtitle", "time": 5010.47, "timestamp": "01:23:30", "text": "不知何故，我就是增重不了。所以"}, {"type": "subtitle", "time": 5012.629, "timestamp": "01:23:32", "text": "他们给我做了很多检查，"}, {"type": "subtitle", "time": 5017.11, "timestamp": "01:23:37", "text": "结论是我的身体每当有"}, {"type": "subtitle", "time": 5020.27, "timestamp": "01:23:40", "text": "食物进入我的身体，很快就消化掉了。"}, {"type": "subtitle", "time": 5025.11, "timestamp": "01:23:45", "text": "快速地。我的新陈代谢好像很快。"}, {"type": "subtitle", "time": 5027.43, "timestamp": "01:23:47", "text": "所以这就是为什么我的身体不会感染任何病毒的原因。"}, {"type": "subtitle", "time": 5030.55, "timestamp": "01:23:50", "text": "脂肪，因为它会被消耗掉。"}, {"type": "subtitle", "time": 5037.83, "timestamp": "01:23:57", "text": "因为就像小时候我常说的那些话一样"}]
[{"type": "subtitle", "time": 12780.87, "timestamp": "03:33:00", "text": "做？好像他从来没提起过亚当似的。"}, {"type": "subtitle", "time": 12782.63, "timestamp": "03:33:02", "text": "甚至连那个在那儿的女孩，我"}, {"type": "subtitle", "time": 12784.87, "timestamp": "03:33:04", "text": "我不认识这个女孩。她也是一部电影"}, {"type": "subtitle", "time": 12787.11, "timestamp": "03:33:07", "text": "是明星吧？"}, {"type": "subtitle", "time": 12789.429, "timestamp": "03:33:09", "text": "她当时好像在谈论动漫。"}, {"type": "subtitle", "time": 12791.91, "timestamp": "03:33:11", "text": "散布错误信息。我当时就想，"}, {"type": "subtitle", "time": 12795.429, "timestamp": "03:33:15", "text": "“好吧，这在《火影忍者》里从来没有发生过。”"}, {"type": "subtitle", "time": 12802.55, "timestamp": "03:33:22", "text": "她就像在说：“啊，我想起来了。”"}, {"type": "subtitle", "time": 12806.349, "timestamp": "03:33:26", "text": "当鸣人被她的朋友们背叛时"}, {"type": "subtitle", "time": 12809.429, "timestamp": "03:33:29", "text": "然后她就变成了超级赛亚人。”我当时就想，"}, {"type": "chat", "time": 12811.099, "timestamp": "03:33:31", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/oPgfY_DoKfSXkNAPq8-AgAo"}, {"type": "subtitle", "time": 12820.229, "timestamp": "03:33:40", "text": "我当时就想，我记得悟空到达……"}, {"type": "subtitle", "time": 12824.39, "timestamp": "03:33:44", "text": "乌奇亚村。我当时就想，什么？"}, {"type": "subtitle", "time": 12832.54, "timestamp": "03:33:52", "text": "佐太郎"}, {"type": "chat", "time": 12835.358, "timestamp": "03:33:55", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/X_zdXMHgJaPa8gTGt4f4Ag"}, {"type": "subtitle", "time": 12835.63, "timestamp": "03:33:55", "text": "[音乐]"}, {"type": "subtitle", "time": 12838.07, "timestamp": "03:33:58", "text": "兄弟。很明显，这些人就像"}, {"type": "subtitle", "time": 12839.99, "timestamp": "03:33:59", "text": "我对这些东西不感兴趣。他们刚刚"}]
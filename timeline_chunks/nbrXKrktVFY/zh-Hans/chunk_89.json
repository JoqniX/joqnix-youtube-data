[{"type": "subtitle", "time": 5340.07, "timestamp": "01:29:00", "text": "在我看来，这根本说不通。"}, {"type": "subtitle", "time": 5343.27, "timestamp": "01:29:03", "text": "你怎么能吃死东西呢？"}, {"type": "subtitle", "time": 5347.11, "timestamp": "01:29:07", "text": "嗯。我不知道具体有多少。"}, {"type": "subtitle", "time": 5348.35, "timestamp": "01:29:08", "text": "有道理"}, {"type": "subtitle", "time": 5351.11, "timestamp": "01:29:11", "text": "但因为我开始做这件事"}, {"type": "subtitle", "time": 5353.91, "timestamp": "01:29:13", "text": "当我有个朋友是……"}, {"type": "subtitle", "time": 5356.95, "timestamp": "01:29:16", "text": "屠夫对吧，所以有一次我去"}, {"type": "subtitle", "time": 5359.43, "timestamp": "01:29:19", "text": "和他一起去买只鸡，然后我"}, {"type": "subtitle", "time": 5361.47, "timestamp": "01:29:21", "text": "我问他，嘿，我可以宰杀……"}, {"type": "subtitle", "time": 5364.87, "timestamp": "01:29:24", "text": "鸡，他之前让我这么做过。"}, {"type": "subtitle", "time": 5366.87, "timestamp": "01:29:26", "text": "之后，我宰了那只鸡。"}, {"type": "subtitle", "time": 5370.87, "timestamp": "01:29:30", "text": "用我自己的双手，绝对不可能"}, {"type": "subtitle", "time": 5374.27, "timestamp": "01:29:34", "text": "是啊，挺好玩的。哦，我的"}, {"type": "subtitle", "time": 5378.07, "timestamp": "01:29:38", "text": "上帝。没关系。你的呢？"}, {"type": "subtitle", "time": 5380.87, "timestamp": "01:29:40", "text": "有过这方面的经验吗？"}, {"type": "subtitle", "time": 5385.11, "timestamp": "01:29:45", "text": "我的意思是，那把刀很锋利。是的。那"}, {"type": "subtitle", "time": 5387.43, "timestamp": "01:29:47", "text": "这是我注意到的一件事。"}, {"type": "subtitle", "time": 5389.35, "timestamp": "01:29:49", "text": "是的，你告诉我你不是"}, {"type": "subtitle", "time": 5392.229, "timestamp": "01:29:52", "text": "怕血。是的。是的。是的。那是"}, {"type": "subtitle", "time": 5395.51, "timestamp": "01:29:55", "text": "所以就像我做了那件事，然后我就……"}, {"type": "subtitle", "time": 5398.31, "timestamp": "01:29:58", "text": "玩得很开心。当我回到家时，我"}]
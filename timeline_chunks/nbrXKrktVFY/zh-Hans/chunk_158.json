[{"type": "subtitle", "time": 9487.59, "timestamp": "02:38:07", "text": "所以我认为他是在故意激怒别人。"}, {"type": "subtitle", "time": 9490.55, "timestamp": "02:38:10", "text": "你看过《伊森·克莱德必须这么做》吗？"}, {"type": "subtitle", "time": 9492.469, "timestamp": "02:38:12", "text": "太搞笑了。太搞笑了。我当时"}, {"type": "subtitle", "time": 9494.59, "timestamp": "02:38:14", "text": "正在观看。我当时正在看一部"}, {"type": "subtitle", "time": 9497.51, "timestamp": "02:38:17", "text": "YouTuber 正在观看 Techone。泰克万"}, {"type": "subtitle", "time": 9499.429, "timestamp": "02:38:19", "text": "看着阿斯敏，阿斯敏看着"}, {"type": "subtitle", "time": 9502.87, "timestamp": "02:38:22", "text": "辩论。是的。"}, {"type": "subtitle", "time": 9505.83, "timestamp": "02:38:25", "text": "我的天哪，太搞笑了，因为她"}, {"type": "subtitle", "time": 9507.59, "timestamp": "02:38:27", "text": "当时我就想，“伙计们，他们在说什么？”"}, {"type": "subtitle", "time": 9509.389, "timestamp": "02:38:29", "text": "伙计们，他们在说什么？"}, {"type": "subtitle", "time": 9511.91, "timestamp": "02:38:31", "text": "关于什么？”Techone正在解释他们"}, {"type": "subtitle", "time": 9515.03, "timestamp": "02:38:35", "text": "我们正在谈论的是评论什么"}, {"type": "subtitle", "time": 9523.99, "timestamp": "02:38:43", "text": "我只看了30分钟。我需要"}, {"type": "subtitle", "time": 9526.469, "timestamp": "02:38:46", "text": "完成整件事。我看了"}, {"type": "subtitle", "time": 9531.19, "timestamp": "02:38:51", "text": "整个过程都是现场直播。太好玩了。"}, {"type": "subtitle", "time": 9533.95, "timestamp": "02:38:53", "text": "正如之前所说，就是这样。"}, {"type": "subtitle", "time": 9537.59, "timestamp": "02:38:57", "text": "基本上，这就像是……的活动"}]
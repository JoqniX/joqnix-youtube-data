[{"type": "subtitle", "time": 4800.79, "timestamp": "01:20:00", "text": "你可能喜欢在家锻炼"}, {"type": "subtitle", "time": 4802.95, "timestamp": "01:20:02", "text": "就做一两项运动就行了。"}, {"type": "subtitle", "time": 4805.91, "timestamp": "01:20:05", "text": "好的，就像看看你……一样。"}, {"type": "subtitle", "time": 4808.55, "timestamp": "01:20:08", "text": "可以这样做，就像我说的那样，就像我"}, {"type": "subtitle", "time": 4810.07, "timestamp": "01:20:10", "text": "有些朋友无所事事"}, {"type": "subtitle", "time": 4812.07, "timestamp": "01:20:12", "text": "就像他们真的喜欢坐在那里一样。"}, {"type": "subtitle", "time": 4814.669, "timestamp": "01:20:14", "text": "兄弟，你回家后得去健身房了。"}, {"type": "subtitle", "time": 4823.11, "timestamp": "01:20:23", "text": "而且，健身对你真的很有帮助。"}, {"type": "subtitle", "time": 4825.91, "timestamp": "01:20:25", "text": "比如心理健康方面。"}, {"type": "subtitle", "time": 4832.63, "timestamp": "01:20:32", "text": "unirone正在健身。嗯？每当"}, {"type": "subtitle", "time": 4834.55, "timestamp": "01:20:34", "text": "发生分手或者任何时候你"}, {"type": "subtitle", "time": 4837.75, "timestamp": "01:20:37", "text": "缺乏动力。确实如此，因为"}, {"type": "subtitle", "time": 4839.91, "timestamp": "01:20:39", "text": "当我开始去健身房的时候，对吧，"}, {"type": "subtitle", "time": 4842.75, "timestamp": "01:20:42", "text": "我当时心理素质很强。"}, {"type": "subtitle", "time": 4845.51, "timestamp": "01:20:45", "text": "就像我的家人中有人去世一样，而我"}, {"type": "subtitle", "time": 4846.91, "timestamp": "01:20:46", "text": "不会在意"}, {"type": "subtitle", "time": 4849.11, "timestamp": "01:20:49", "text": "它。就像我喜欢说的那样。"}, {"type": "subtitle", "time": 4851.03, "timestamp": "01:20:51", "text": "这就是我现在心理素质的强大程度。"}, {"type": "subtitle", "time": 4853.11, "timestamp": "01:20:53", "text": "因为我生活中发生了一些事，所以"}, {"type": "subtitle", "time": 4854.79, "timestamp": "01:20:54", "text": "很多。"}, {"type": "subtitle", "time": 4856.99, "timestamp": "01:20:56", "text": "嗯。"}]
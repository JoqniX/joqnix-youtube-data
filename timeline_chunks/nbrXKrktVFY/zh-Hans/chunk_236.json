[{"type": "subtitle", "time": 14162.55, "timestamp": "03:56:02", "text": "几分钟后，我才确认自己是醒着还是"}, {"type": "subtitle", "time": 14164.15, "timestamp": "03:56:04", "text": "我这是在做梦吗？"}, {"type": "subtitle", "time": 14165.91, "timestamp": "03:56:05", "text": "她会开始喋喋不休，我就想：这是什么情况？"}, {"type": "subtitle", "time": 14171.67, "timestamp": "03:56:11", "text": "我？她现在也是这么想的，但是"}, {"type": "subtitle", "time": 14174.469, "timestamp": "03:56:14", "text": "现在她会叫，她会说些什么。"}, {"type": "subtitle", "time": 14176.189, "timestamp": "03:56:16", "text": "它会把你唤醒"}, {"type": "subtitle", "time": 14178.55, "timestamp": "03:56:18", "text": "向上。把你彻底唤醒。你是"}, {"type": "subtitle", "time": 14188.75, "timestamp": "03:56:28", "text": "是的，她也像是巅峰时期……"}, {"type": "subtitle", "time": 14192.55, "timestamp": "03:56:32", "text": "以 YouTube 的方式进行 YouTube 创作。是的，我"}, {"type": "subtitle", "time": 14194.389, "timestamp": "03:56:34", "text": "我喜欢相信她就像第一个伊恩一样。"}, {"type": "subtitle", "time": 14197.51, "timestamp": "03:56:37", "text": "YouTuber。是啊，我也是。相同的。因为要"}, {"type": "subtitle", "time": 14199.59, "timestamp": "03:56:39", "text": "我是第一个，但我找不到她了。"}, {"type": "subtitle", "time": 14201.349, "timestamp": "03:56:41", "text": "其他参与其中的人。喜欢"}, {"type": "subtitle", "time": 14203.189, "timestamp": "03:56:43", "text": "人们喜欢称她为“铁鼠”，但她"}, {"type": "subtitle", "time": 14204.189, "timestamp": "03:56:44", "text": "不是"}, {"type": "subtitle", "time": 14209.269, "timestamp": "03:56:49", "text": "就像她不是你说的那样。"}, {"type": "subtitle", "time": 14211.07, "timestamp": "03:56:51", "text": "就在那里。"}, {"type": "subtitle", "time": 14213.75, "timestamp": "03:56:53", "text": "是的。就好像她这么做只是为了……"}, {"type": "subtitle", "time": 14216.309, "timestamp": "03:56:56", "text": "很久。"}, {"type": "subtitle", "time": 14217.59, "timestamp": "03:56:57", "text": "这就是为什么人们会说，“哦，"}, {"type": "subtitle", "time": 14219.59, "timestamp": "03:56:59", "text": "Kizuna并不是第一个YouTuber，因为"}]
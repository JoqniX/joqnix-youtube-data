[{"type": "subtitle", "time": 1680.149, "timestamp": "00:28:00", "text": "我知道这就像一个你关心的话题。"}, {"type": "subtitle", "time": 1681.59, "timestamp": "00:28:01", "text": "我不想谈这件事，但是……"}, {"type": "subtitle", "time": 1684.149, "timestamp": "00:28:04", "text": "好的，我想和你谈谈。"}, {"type": "subtitle", "time": 1686.23, "timestamp": "00:28:06", "text": "关于这件事，因为有些事情我"}, {"type": "subtitle", "time": 1688.07, "timestamp": "00:28:08", "text": "在网上看到一些让我生气的事情"}, {"type": "subtitle", "time": 1690.23, "timestamp": "00:28:10", "text": "人们注册，人们评论人们的"}, {"type": "subtitle", "time": 1696.87, "timestamp": "00:28:16", "text": "所以，聊天群里有个家伙问，这是……"}, {"type": "subtitle", "time": 1698.87, "timestamp": "00:28:18", "text": "男生还是女生？你会怎么说？"}, {"type": "subtitle", "time": 1704.31, "timestamp": "00:28:24", "text": "那？好的。所以，嗯，自从我一直……"}, {"type": "subtitle", "time": 1707.029, "timestamp": "00:28:27", "text": "收到很多评论，比如……"}, {"type": "subtitle", "time": 1709.909, "timestamp": "00:28:29", "text": "关于语音功能的问题。所以"}, {"type": "subtitle", "time": 1712.63, "timestamp": "00:28:32", "text": "是的，随着时间的推移，我的频道逐渐发展壮大了。"}, {"type": "subtitle", "time": 1716.47, "timestamp": "00:28:36", "text": "所以，呃，关于乔的背景故事，就像背景故事一样"}, {"type": "subtitle", "time": 1720.31, "timestamp": "00:28:40", "text": "接下来，他想成为一名 YouTuber。我做了"}, {"type": "subtitle", "time": 1724.789, "timestamp": "00:28:44", "text": "这样任何人都可以……就像你一样。"}, {"type": "subtitle", "time": 1727.75, "timestamp": "00:28:47", "text": "你想怎么称呼我都可以。喜欢"}, {"type": "subtitle", "time": 1730.789, "timestamp": "00:28:50", "text": "如果你认为我是个男孩，那就来跟我说话吧。"}, {"type": "subtitle", "time": 1733.11, "timestamp": "00:28:53", "text": "小时候。如果你认为这是你的第一次"}, {"type": "subtitle", "time": 1734.95, "timestamp": "00:28:54", "text": "别人对我的印象就像个女孩。"}, {"type": "subtitle", "time": 1738.19, "timestamp": "00:28:58", "text": "好的，你可以那样做，因为作为一个"}]
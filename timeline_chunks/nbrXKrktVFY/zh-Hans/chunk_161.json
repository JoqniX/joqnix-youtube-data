[{"type": "subtitle", "time": 9661.11, "timestamp": "02:41:01", "text": "溪流？好的。没关系。我不"}, {"type": "subtitle", "time": 9663.349, "timestamp": "02:41:03", "text": "理解。所以，当时有这么一个人，"}, {"type": "subtitle", "time": 9665.429, "timestamp": "02:41:05", "text": "正确的？"}, {"type": "subtitle", "time": 9669.83, "timestamp": "02:41:09", "text": "呃，他叫我，就像呃呃，就像他"}, {"type": "subtitle", "time": 9671.87, "timestamp": "02:41:11", "text": "就像……"}, {"type": "subtitle", "time": 9674.15, "timestamp": "02:41:14", "text": "基本上就像我小时候那样"}, {"type": "subtitle", "time": 9676.71, "timestamp": "02:41:16", "text": "使困惑。我心想：“所以，你妈妈……”"}, {"type": "subtitle", "time": 9678.389, "timestamp": "02:41:18", "text": "没有你妈妈没有的那种阴道"}, {"type": "subtitle", "time": 9680.71, "timestamp": "02:41:20", "text": "你有阴道吗？怎么样？喜欢，"}, {"type": "subtitle", "time": 9682.87, "timestamp": "02:41:22", "text": "这是什么东西？比如，你的"}, {"type": "subtitle", "time": 9686.15, "timestamp": "02:41:26", "text": "妈妈的阴道。"}, {"type": "subtitle", "time": 9688.07, "timestamp": "02:41:28", "text": "比如，你妈妈没有那种东西。"}, {"type": "subtitle", "time": 9695.91, "timestamp": "02:41:35", "text": "他只是在指给我看这一点。我没有"}, {"type": "subtitle", "time": 9706.95, "timestamp": "02:41:46", "text": "是的。所以他只是在指着一具尸体。"}, {"type": "subtitle", "time": 9709.11, "timestamp": "02:41:49", "text": "你妈妈的一部分。你就像这样，"}, {"type": "subtitle", "time": 9711.9, "timestamp": "02:41:51", "text": "“啊？这他妈怎么可能？”"}, {"type": "subtitle", "time": 9714.19, "timestamp": "02:41:54", "text": "[音乐]"}, {"type": "subtitle", "time": 9717.83, "timestamp": "02:41:57", "text": "例如像巴哈兰这样的阿加利是"}]
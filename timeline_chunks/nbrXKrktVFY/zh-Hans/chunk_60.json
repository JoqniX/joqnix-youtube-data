[{"type": "subtitle", "time": 3600.71, "timestamp": "01:00:00", "text": "嗯，"}, {"type": "subtitle", "time": 3602.549, "timestamp": "01:00:02", "text": "外面的世界太疯狂了，乔克。"}, {"type": "subtitle", "time": 3610.63, "timestamp": "01:00:10", "text": "哦，我最近发现了这个"}, {"type": "subtitle", "time": 3613.43, "timestamp": "01:00:13", "text": "有趣的问题。呃，这个问题"}, {"type": "subtitle", "time": 3618.109, "timestamp": "01:00:18", "text": "这让我思考了很多事情。"}, {"type": "subtitle", "time": 3620.829, "timestamp": "01:00:20", "text": "那么第一个问题"}, {"type": "subtitle", "time": 3623.91, "timestamp": "01:00:23", "text": "如果没有任何要求的话……"}, {"type": "subtitle", "time": 3627.309, "timestamp": "01:00:27", "text": "我们不……呃，该怎么称呼呢？"}, {"type": "subtitle", "time": 3630.39, "timestamp": "01:00:30", "text": "它？呃，那个东西是什么样的？你不能……"}, {"type": "subtitle", "time": 3634.39, "timestamp": "01:00:34", "text": "这样做会被判入狱。好的。你呢"}, {"type": "subtitle", "time": 3636.589, "timestamp": "01:00:36", "text": "什么都能卖。如果你能成为一名"}, {"type": "subtitle", "time": 3639.829, "timestamp": "01:00:39", "text": "商家，你想卖什么？没有"}, {"type": "subtitle", "time": 3642.63, "timestamp": "01:00:42", "text": "就你的想象力而言，没有呃……"}, {"type": "subtitle", "time": 3645.19, "timestamp": "01:00:45", "text": "可以走了。"}, {"type": "subtitle", "time": 3647.51, "timestamp": "01:00:47", "text": "如果你是商人或……你会卖什么？"}, {"type": "subtitle", "time": 3654.95, "timestamp": "01:00:54", "text": "那我也是个罪犯，对吧？不，你"}, {"type": "subtitle", "time": 3657.109, "timestamp": "01:00:57", "text": "可以。没有人会称你为罪犯。"}]
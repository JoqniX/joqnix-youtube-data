[{"type": "subtitle", "time": 1981.669, "timestamp": "00:33:01", "text": "尤其是我喜欢的那种东西"}, {"type": "subtitle", "time": 1983.75, "timestamp": "00:33:03", "text": "就像一场混乱席卷了我喜欢的事物。"}, {"type": "subtitle", "time": 1986.71, "timestamp": "00:33:06", "text": "我只想躲进我的茧里，就像这样，好吧。"}, {"type": "subtitle", "time": 1992.31, "timestamp": "00:33:12", "text": "离开，我也这么做了。我离开了"}, {"type": "subtitle", "time": 1994.87, "timestamp": "00:33:14", "text": "大概持续了一个月左右吧，我觉得人们"}, {"type": "subtitle", "time": 1996.47, "timestamp": "00:33:16", "text": "我们当时就想：你还活着吗？我就像我"}, {"type": "subtitle", "time": 2002.31, "timestamp": "00:33:22", "text": "你呢？你一直在做"}, {"type": "subtitle", "time": 2005.95, "timestamp": "00:33:25", "text": "安息日。最近好吗？呃，是"}, {"type": "subtitle", "time": 2010.149, "timestamp": "00:33:30", "text": "去哪儿？该怎么说呢？嗯，是的"}, {"type": "subtitle", "time": 2014.389, "timestamp": "00:33:34", "text": "萨巴塔，我觉得……嗯，关于主要内容"}, {"type": "subtitle", "time": 2017.35, "timestamp": "00:33:37", "text": "它的目标，它的buo部分就像"}, {"type": "subtitle", "time": 2020.149, "timestamp": "00:33:40", "text": "就目前而言，钱的问题我并不在意。"}, {"type": "subtitle", "time": 2022.95, "timestamp": "00:33:42", "text": "别太在意，因为它是……"}, {"type": "subtitle", "time": 2025.35, "timestamp": "00:33:45", "text": "数量巨大，而且似乎几乎"}, {"type": "subtitle", "time": 2029.269, "timestamp": "00:33:49", "text": "也不可能，但只要我有……"}, {"type": "subtitle", "time": 2034.31, "timestamp": "00:33:54", "text": "有趣又享受，感觉很好，嗯……"}, {"type": "subtitle", "time": 2037.19, "timestamp": "00:33:57", "text": "玩得开心才是主要目的。是的。"}]
[{"type": "subtitle", "time": 4441.51, "timestamp": "01:14:01", "text": "有什么事是可以讨厌的？"}, {"type": "subtitle", "time": 4451.669, "timestamp": "01:14:11", "text": "这是个好问题。但这是为什么呢？"}, {"type": "subtitle", "time": 4453.43, "timestamp": "01:14:13", "text": "我脑子里就什么都想不明白吗？"}, {"type": "subtitle", "time": 4463.91, "timestamp": "01:14:23", "text": "我该如何把球棒传给你？"}, {"type": "subtitle", "time": 4466.43, "timestamp": "01:14:26", "text": "你会怎么做？"}, {"type": "subtitle", "time": 4470.229, "timestamp": "01:14:30", "text": "说？我认为这是我对我而言最重要的一点。"}, {"type": "subtitle", "time": 4472.189, "timestamp": "01:14:32", "text": "太多东西值得我们憎恨。"}, {"type": "subtitle", "time": 4474.87, "timestamp": "01:14:34", "text": "但有一件事总是会发生"}, {"type": "subtitle", "time": 4479.91, "timestamp": "01:14:39", "text": "我脑子里全是动漫女孩。"}, {"type": "subtitle", "time": 4482.95, "timestamp": "01:14:42", "text": "你讨厌动漫女孩吗？不，没关系"}, {"type": "subtitle", "time": 4489.91, "timestamp": "01:14:49", "text": "哦，比如说，如果有人讨厌动漫的话。"}, {"type": "subtitle", "time": 4493.43, "timestamp": "01:14:53", "text": "女孩们，没关系。然后就是"}, {"type": "subtitle", "time": 4497.35, "timestamp": "01:14:57", "text": "我可以恨你。"}, {"type": "subtitle", "time": 4499.18, "timestamp": "01:14:59", "text": "这就是我的逻辑。"}]
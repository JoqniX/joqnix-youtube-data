[{"type": "subtitle", "time": 2881.43, "timestamp": "00:48:01", "text": "未成熟。哦，不。他们就像他们"}, {"type": "subtitle", "time": 2885.03, "timestamp": "00:48:05", "text": "它们很难。我当时就想，“好吧，"}, {"type": "subtitle", "time": 2886.55, "timestamp": "00:48:06", "text": "它们看起来仍然很好。”所以，我就想，“我"}, {"type": "subtitle", "time": 2890.15, "timestamp": "00:48:10", "text": "不能扔它们。”所以，我的大脑一片空白。"}, {"type": "subtitle", "time": 2891.069, "timestamp": "00:48:11", "text": "喜欢，"}, {"type": "subtitle", "time": 2894.71, "timestamp": "00:48:14", "text": "“好吧，我可以把它们放在床底下。”"}, {"type": "subtitle", "time": 2898.15, "timestamp": "00:48:18", "text": "它们有时间成熟，因为"}, {"type": "subtitle", "time": 2899.91, "timestamp": "00:48:19", "text": "我知道香蕉会那样。他们有"}, {"type": "subtitle", "time": 2901.27, "timestamp": "00:48:21", "text": "它们身上有某种特质使它们"}, {"type": "subtitle", "time": 2904.109, "timestamp": "00:48:24", "text": "成熟。是的。是的。"}, {"type": "subtitle", "time": 2908.309, "timestamp": "00:48:28", "text": "我把它放在床底下，因为我以为在床底下"}, {"type": "subtitle", "time": 2911.349, "timestamp": "00:48:31", "text": "我的床让我感到放松，所以"}, {"type": "subtitle", "time": 2919.19, "timestamp": "00:48:39", "text": "轻松。于是我把它放在了床底下。"}, {"type": "subtitle", "time": 2921.51, "timestamp": "00:48:41", "text": "一天后我查看了一下，它们仍然还在。"}, {"type": "subtitle", "time": 2923.67, "timestamp": "00:48:43", "text": "它们还没成熟。第二天"}, {"type": "subtitle", "time": 2927.27, "timestamp": "00:48:47", "text": "忘了。第三天我检查了他们"}, {"type": "subtitle", "time": 2929.19, "timestamp": "00:48:49", "text": "太熟了。"}, {"type": "subtitle", "time": 2933.349, "timestamp": "00:48:53", "text": "哦，都发霉了。"}, {"type": "subtitle", "time": 2936.39, "timestamp": "00:48:56", "text": "哦，不。所以我就想，“嗯，我还是可以的。”"}, {"type": "subtitle", "time": 2937.95, "timestamp": "00:48:57", "text": "吃掉它们"}]
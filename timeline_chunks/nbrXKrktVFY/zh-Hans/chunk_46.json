[{"type": "subtitle", "time": 2760.15, "timestamp": "00:46:00", "text": "那。然后，呃，另一次事件会"}, {"type": "subtitle", "time": 2763.75, "timestamp": "00:46:03", "text": "我这是在玩火。"}, {"type": "subtitle", "time": 2767.589, "timestamp": "00:46:07", "text": "哦，原来是一起小小的纵火案。"}, {"type": "subtitle", "time": 2771.03, "timestamp": "00:46:11", "text": "是啊，感觉就像……"}, {"type": "subtitle", "time": 2775.27, "timestamp": "00:46:15", "text": "嗯，就像……蜡烛点燃了，所以我"}, {"type": "subtitle", "time": 2776.79, "timestamp": "00:46:16", "text": "以前喜欢玩手指"}, {"type": "subtitle", "time": 2780.23, "timestamp": "00:46:20", "text": "还有一些类似“如果我能得到……”之类的事情"}, {"type": "subtitle", "time": 2783.91, "timestamp": "00:46:23", "text": "火被扑灭，东西也没爆炸。"}, {"type": "subtitle", "time": 2785.75, "timestamp": "00:46:25", "text": "就像只用一根手指就能做到那样，我当时"}, {"type": "subtitle", "time": 2787.67, "timestamp": "00:46:27", "text": "比如，如果我把手指伸进去呢？"}, {"type": "subtitle", "time": 2790.91, "timestamp": "00:46:30", "text": "两秒钟，然后"}, {"type": "subtitle", "time": 2801.91, "timestamp": "00:46:41", "text": "是的。圣。"}, {"type": "subtitle", "time": 2803.99, "timestamp": "00:46:43", "text": "问你单身可以吗？"}, {"type": "subtitle", "time": 2807.109, "timestamp": "00:46:47", "text": "孩子？是的，独生子。是的。好的。"}, {"type": "subtitle", "time": 2811.349, "timestamp": "00:46:51", "text": "我是我们家年纪最大的。就像我"}, {"type": "subtitle", "time": 2813.99, "timestamp": "00:46:53", "text": "我有四个兄弟姐妹。我是第五个"}, {"type": "subtitle", "time": 2816.71, "timestamp": "00:46:56", "text": "还有最古老的那一个。"}, {"type": "subtitle", "time": 2819.829, "timestamp": "00:46:59", "text": "每当我的兄弟姐妹们做对了事情的时候"}]
[{"type": "subtitle", "time": 4921.03, "timestamp": "01:22:01", "text": "不知道你是不是累坏了"}, {"type": "subtitle", "time": 4923.669, "timestamp": "01:22:03", "text": "还有一些其他的东西。是的。是的。是的。就像在"}, {"type": "subtitle", "time": 4924.21, "timestamp": "01:22:04", "text": "好办法。"}, {"type": "subtitle", "time": 4929.189, "timestamp": "01:22:09", "text": "就像你做过的事一样，比如"}, {"type": "subtitle", "time": 4930.55, "timestamp": "01:22:10", "text": "做你热衷的事情，以及"}, {"type": "subtitle", "time": 4932.39, "timestamp": "01:22:12", "text": "现在你累坏了，而且"}, {"type": "subtitle", "time": 4934.55, "timestamp": "01:22:14", "text": "你就会想，“啊，那是，那是……”"}, {"type": "subtitle", "time": 4936.95, "timestamp": "01:22:16", "text": "超好的。”"}, {"type": "subtitle", "time": 4942.55, "timestamp": "01:22:22", "text": "就像周六那天，我做了这个……呃……腿部动作"}, {"type": "subtitle", "time": 4945.43, "timestamp": "01:22:25", "text": "我锻炼我的腿，就像锻炼一条腿一样"}, {"type": "subtitle", "time": 4947.03, "timestamp": "01:22:27", "text": "天。"}, {"type": "subtitle", "time": 4950.31, "timestamp": "01:22:30", "text": "今天我走不了路。我觉得我"}, {"type": "subtitle", "time": 4957.35, "timestamp": "01:22:37", "text": "但每当我走路时，感觉都很好。"}, {"type": "subtitle", "time": 4959.91, "timestamp": "01:22:39", "text": "因为我知道"}, {"type": "subtitle", "time": 4963.99, "timestamp": "01:22:43", "text": "我健身的方式很正确。"}, {"type": "subtitle", "time": 4965.75, "timestamp": "01:22:45", "text": "是的。我就是这种感觉。如果"}, {"type": "subtitle", "time": 4967.43, "timestamp": "01:22:47", "text": "第二天我就感觉不到了，我没有。"}, {"type": "subtitle", "time": 4970.2, "timestamp": "01:22:50", "text": "尽力去做。"}, {"type": "subtitle", "time": 4971.99, "timestamp": "01:22:51", "text": "[音乐]"}, {"type": "subtitle", "time": 4974.629, "timestamp": "01:22:54", "text": "我喜欢挑战自己，看看自己能做到什么程度。"}, {"type": "subtitle", "time": 4976.79, "timestamp": "01:22:56", "text": "我可以去哪里，比如我可以带我去哪里"}]
[{"type": "subtitle", "time": 11041.11, "timestamp": "03:04:01", "text": "虽然我喜欢肖恩，但她有"}, {"type": "subtitle", "time": 11045.03, "timestamp": "03:04:05", "text": "是的，她有一种很棒的方式。"}, {"type": "subtitle", "time": 11052.23, "timestamp": "03:04:12", "text": "就像她说的那件事，就像我"}, {"type": "subtitle", "time": 11054.87, "timestamp": "03:04:14", "text": "我喜欢相信存在着某种东西。"}, {"type": "subtitle", "time": 11057.03, "timestamp": "03:04:17", "text": "世界上还是有很多好人的。"}, {"type": "subtitle", "time": 11058.28, "timestamp": "03:04:18", "text": "世界"}, {"type": "subtitle", "time": 11059.75, "timestamp": "03:04:19", "text": "[音乐]"}, {"type": "subtitle", "time": 11061.349, "timestamp": "03:04:21", "text": "我也愿意这样相信。"}, {"type": "subtitle", "time": 11063.83, "timestamp": "03:04:23", "text": "现在，如果我的奥什相信有"}, {"type": "subtitle", "time": 11065.51, "timestamp": "03:04:25", "text": "我相信世上还有善良的人。"}, {"type": "subtitle", "time": 11067.67, "timestamp": "03:04:27", "text": "也是。"}, {"type": "subtitle", "time": 11070.07, "timestamp": "03:04:30", "text": "嗯。"}, {"type": "subtitle", "time": 11076.349, "timestamp": "03:04:36", "text": "正如人们常说的，我的妹妹"}, {"type": "subtitle", "time": 11086.55, "timestamp": "03:04:46", "text": "真可爱。"}, {"type": "subtitle", "time": 11089.429, "timestamp": "03:04:49", "text": "Jog，你呢？"}, {"type": "subtitle", "time": 11093.51, "timestamp": "03:04:53", "text": "你爱着某个女儿吗？"}, {"type": "subtitle", "time": 11095.59, "timestamp": "03:04:55", "text": "呃，女儿，"}]
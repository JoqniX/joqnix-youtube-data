[{"type": "subtitle", "time": 10920.71, "timestamp": "03:02:00", "text": "人们的nword和我们的词语"}, {"type": "subtitle", "time": 10927.03, "timestamp": "03:02:07", "text": "我的意思是，我就是不会说某些词。"}, {"type": "subtitle", "time": 10930.87, "timestamp": "03:02:10", "text": "只是因为我没那个心情。"}, {"type": "subtitle", "time": 10939.11, "timestamp": "03:02:19", "text": "而且，我也喜欢和人一起工作。"}, {"type": "subtitle", "time": 10944.63, "timestamp": "03:02:24", "text": "谁像那个种族的人，所以我感觉"}, {"type": "subtitle", "time": 10946.469, "timestamp": "03:02:26", "text": "就像我说“这感觉有点不好”的时候"}, {"type": "subtitle", "time": 10949.429, "timestamp": "03:02:29", "text": "一句伤人的话。是的，就是这样。"}, {"type": "subtitle", "time": 10956.55, "timestamp": "03:02:36", "text": "还有像那样的人"}, {"type": "subtitle", "time": 10959.309, "timestamp": "03:02:39", "text": "就像 R 词一样"}, {"type": "subtitle", "time": 10962.07, "timestamp": "03:02:42", "text": "对，我从来没听说过。"}, {"type": "subtitle", "time": 10966.55, "timestamp": "03:02:46", "text": "精神状态不太好的人，呃……"}, {"type": "subtitle", "time": 10969.03, "timestamp": "03:02:49", "text": "他们告诉我不要用它，除非他们告诉我"}, {"type": "subtitle", "time": 10971.11, "timestamp": "03:02:51", "text": "你会喜欢使用它。我见过这种情况"}, {"type": "subtitle", "time": 10978.99, "timestamp": "03:02:58", "text": "我的意思是，有一次我看到一段视频……"}]
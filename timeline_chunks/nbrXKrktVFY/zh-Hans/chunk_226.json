[{"type": "subtitle", "time": 13563.67, "timestamp": "03:46:03", "text": "啊，但是，是的，就像那样回来了。"}, {"type": "subtitle", "time": 13567.07, "timestamp": "03:46:07", "text": "剩下的事情我该做什么？"}, {"type": "subtitle", "time": 13570.71, "timestamp": "03:46:10", "text": "我只希望一切顺利。"}, {"type": "subtitle", "time": 13573.99, "timestamp": "03:46:13", "text": "我觉得现在很难找到人。"}, {"type": "subtitle", "time": 13576.71, "timestamp": "03:46:16", "text": "即使你引进公司……"}, {"type": "subtitle", "time": 13580.229, "timestamp": "03:46:20", "text": "在印度，很难找到经理或"}, {"type": "subtitle", "time": 13582.87, "timestamp": "03:46:22", "text": "人才经理和合适的人现在"}, {"type": "subtitle", "time": 13584.55, "timestamp": "03:46:24", "text": "因为"}, {"type": "subtitle", "time": 13587.59, "timestamp": "03:46:27", "text": "这很难，而且并非每个人都能做到。"}, {"type": "subtitle", "time": 13590.229, "timestamp": "03:46:30", "text": "我真的想知道"}, {"type": "subtitle", "time": 13592.309, "timestamp": "03:46:32", "text": "整体生命过程。如何招聘"}, {"type": "subtitle", "time": 13596.309, "timestamp": "03:46:36", "text": "审判。我就像在问，这是什么神？"}, {"type": "subtitle", "time": 13598.309, "timestamp": "03:46:38", "text": "你通过沟通来获得这类人才"}, {"type": "subtitle", "time": 13599.83, "timestamp": "03:46:39", "text": "吉吉？"}, {"type": "subtitle", "time": 13608.71, "timestamp": "03:46:48", "text": "确切地。这就是巅峰。哦"}, {"type": "subtitle", "time": 13611.03, "timestamp": "03:46:51", "text": "我的上帝。还有Sakuna，就像……"}, {"type": "subtitle", "time": 13613.349, "timestamp": "03:46:53", "text": "他到底找到佩奇了吗？到底是怎么回事"}, {"type": "subtitle", "time": 13616.63, "timestamp": "03:46:56", "text": "他找到佩奇了吗？确切地。"}, {"type": "subtitle", "time": 13619.269, "timestamp": "03:46:59", "text": "他说道：“是啊，她会没事的。”"}]
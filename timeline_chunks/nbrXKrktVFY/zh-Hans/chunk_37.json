[{"type": "subtitle", "time": 2221.43, "timestamp": "00:37:01", "text": "溪流。所以场面会很混乱。"}, {"type": "subtitle", "time": 2223.069, "timestamp": "00:37:03", "text": "必须喜欢"}, {"type": "subtitle", "time": 2225.589, "timestamp": "00:37:05", "text": "多任务处理。我也得玩这个游戏"}, {"type": "subtitle", "time": 2228.47, "timestamp": "00:37:08", "text": "那件事已经出来了，我也得去做。"}, {"type": "subtitle", "time": 2231.03, "timestamp": "00:37:11", "text": "佣金。我也得做这件事。和"}, {"type": "subtitle", "time": 2232.79, "timestamp": "00:37:12", "text": "人们会说：“哦，我做不到。”"}, {"type": "subtitle", "time": 2234.23, "timestamp": "00:37:14", "text": "你睡觉吗？我回答说：“我睡10分钟。”"}, {"type": "subtitle", "time": 2235.15, "timestamp": "00:37:15", "text": "小时"}, {"type": "subtitle", "time": 2245.03, "timestamp": "00:37:25", "text": "该死。就像，但我什么都做不了。"}, {"type": "subtitle", "time": 2249.03, "timestamp": "00:37:29", "text": "学校之类的正式事务。"}, {"type": "subtitle", "time": 2251.109, "timestamp": "00:37:31", "text": "学校就像是某种崩溃的开始。"}, {"type": "subtitle", "time": 2255.349, "timestamp": "00:37:35", "text": "因为我辍学了。呃，在我之后"}, {"type": "subtitle", "time": 2258.23, "timestamp": "00:37:38", "text": "和高中一样，十年级考试也挂科了"}, {"type": "subtitle", "time": 2260.39, "timestamp": "00:37:40", "text": "就像我第十次考试不及格一样，我就……"}, {"type": "subtitle", "time": 2265.71, "timestamp": "00:37:45", "text": "好吧，我可以继续这样做。"}, {"type": "subtitle", "time": 2268.71, "timestamp": "00:37:48", "text": "然后完成我的学业或者做"}, {"type": "subtitle", "time": 2271.43, "timestamp": "00:37:51", "text": "对此我很有信心。"}, {"type": "subtitle", "time": 2273.67, "timestamp": "00:37:53", "text": "是的。"}, {"type": "subtitle", "time": 2276.15, "timestamp": "00:37:56", "text": "所以我给自己设定了两年的期限"}, {"type": "subtitle", "time": 2278.15, "timestamp": "00:37:58", "text": "空闲时间。我跟我爸说，我当时就想，"}]
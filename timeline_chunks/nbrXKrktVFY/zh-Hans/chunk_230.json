[{"type": "subtitle", "time": 13809.03, "timestamp": "03:50:09", "text": "但就像管理不善之类的东西"}, {"type": "subtitle", "time": 13809.87, "timestamp": "03:50:09", "text": "喜欢"}, {"type": "subtitle", "time": 13812.55, "timestamp": "03:50:12", "text": "那。空心的有点可疑。我是"}, {"type": "subtitle", "time": 13815.83, "timestamp": "03:50:15", "text": "为什么？一度。好的。两次。"}, {"type": "subtitle", "time": 13817.83, "timestamp": "03:50:17", "text": "三次。好的。好的。某样东西"}, {"type": "subtitle", "time": 13821.03, "timestamp": "03:50:21", "text": "这里错了。第四次。某样东西"}, {"type": "subtitle", "time": 13830.469, "timestamp": "03:50:30", "text": "我觉得我参加过的最好的毕业典礼就是"}, {"type": "subtitle", "time": 13833.189, "timestamp": "03:50:33", "text": "来自空心的是阿门，因为她"}, {"type": "subtitle", "time": 13834.63, "timestamp": "03:50:34", "text": "毕业典礼并没有给我一种……的感觉。"}, {"type": "subtitle", "time": 13836.309, "timestamp": "03:50:36", "text": "毕业。当时的感觉就像，哦，我是"}, {"type": "subtitle", "time": 13840.15, "timestamp": "03:50:40", "text": "我要去买点牛奶。"}, {"type": "subtitle", "time": 13842.229, "timestamp": "03:50:42", "text": "好吧，她总有一天会回来的。我"}, {"type": "subtitle", "time": 13848.71, "timestamp": "03:50:48", "text": "好像这就是打破僵局的最佳方式似的"}, {"type": "subtitle", "time": 13851.269, "timestamp": "03:50:51", "text": "请把这个消息告诉我们。"}, {"type": "subtitle", "time": 13853.269, "timestamp": "03:50:53", "text": "是的。"}, {"type": "subtitle", "time": 13855.189, "timestamp": "03:50:55", "text": "最糟糕的毕业典礼是"}]
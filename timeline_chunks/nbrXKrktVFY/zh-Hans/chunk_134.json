[{"type": "subtitle", "time": 8041.27, "timestamp": "02:14:01", "text": "当他们知道自己何时被"}, {"type": "subtitle", "time": 8042.79, "timestamp": "02:14:02", "text": "恶作剧电话。所以他们会开始"}, {"type": "subtitle", "time": 8046.47, "timestamp": "02:14:06", "text": "滚动。什么？他们知道。是的，他们"}, {"type": "subtitle", "time": 8048.47, "timestamp": "02:14:08", "text": "知道。他们经常接到恶作剧电话。"}, {"type": "subtitle", "time": 8049.99, "timestamp": "02:14:09", "text": "有时他们会说，谁来取悦你？"}, {"type": "subtitle", "time": 8051.31, "timestamp": "02:14:11", "text": "开始哄骗"}, {"type": "subtitle", "time": 8053.669, "timestamp": "02:14:13", "text": "你因为他们，他们过得很悲惨"}, {"type": "subtitle", "time": 8056.229, "timestamp": "02:14:16", "text": "就像他们每次接到电话时一样，这份工作也让他们感到很轻松。"}, {"type": "subtitle", "time": 8058.31, "timestamp": "02:14:18", "text": "有些人像凯伦一样，她一直在抱怨。"}, {"type": "subtitle", "time": 8060.47, "timestamp": "02:14:20", "text": "关于她的互联网"}, {"type": "subtitle", "time": 8063.35, "timestamp": "02:14:23", "text": "或者像是她自己做的某件事"}, {"type": "subtitle", "time": 8065.189, "timestamp": "02:14:25", "text": "大部分就像女士说的，直接关掉就行了。"}, {"type": "subtitle", "time": 8067.83, "timestamp": "02:14:27", "text": "你的东西，然后重新启动，哪个？"}, {"type": "subtitle", "time": 8074.55, "timestamp": "02:14:34", "text": "所以他们必须处理这些问题。"}, {"type": "subtitle", "time": 8076.069, "timestamp": "02:14:36", "text": "人们。所以当你打恶作剧电话并喜欢"}, {"type": "subtitle", "time": 8078.069, "timestamp": "02:14:38", "text": "只要你态度特别好，他们就会……"}, {"type": "subtitle", "time": 8079.83, "timestamp": "02:14:39", "text": "就像你知道的那样，顺其自然"}, {"type": "subtitle", "time": 8081.21, "timestamp": "02:14:41", "text": "东西"}, {"type": "subtitle", "time": 8082.629, "timestamp": "02:14:42", "text": "[音乐]"}, {"type": "subtitle", "time": 8084.47, "timestamp": "02:14:44", "text": "十次里有九次我都这样"}, {"type": "subtitle", "time": 8085.83, "timestamp": "02:14:45", "text": "每当我打恶作剧电话的时候"}, {"type": "subtitle", "time": 8088.87, "timestamp": "02:14:48", "text": "人们会说，啊，他们有……"}, {"type": "subtitle", "time": 8096.51, "timestamp": "02:14:56", "text": "我会像这样：嗯？"}, {"type": "subtitle", "time": 8099.35, "timestamp": "02:14:59", "text": "所以事情就是这样，我会这样称呼他们。"}]
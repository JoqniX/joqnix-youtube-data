[{"type": "subtitle", "time": 11701.75, "timestamp": "03:15:01", "text": "有时候我会说，你知道的"}, {"type": "subtitle", "time": 11704.389, "timestamp": "03:15:04", "text": "YouTube每年都会做的那件事，"}, {"type": "subtitle", "time": 11707.75, "timestamp": "03:15:07", "text": "YouTube音乐确实如此。我会查一下，我是"}, {"type": "subtitle", "time": 11710.389, "timestamp": "03:15:10", "text": "为什么Ni会在那里？我听了吗？"}, {"type": "subtitle", "time": 11712.67, "timestamp": "03:15:12", "text": "到那种程度？"}, {"type": "subtitle", "time": 11716.469, "timestamp": "03:15:16", "text": "是的。是的。是的。就像努梅会那样"}, {"type": "subtitle", "time": 11718.55, "timestamp": "03:15:18", "text": "一直都在那里，有些人喜欢霍尔生活"}, {"type": "subtitle", "time": 11721.83, "timestamp": "03:15:21", "text": "那里会有各种各样的东西。"}, {"type": "subtitle", "time": 11723.349, "timestamp": "03:15:23", "text": "简直太可怕了。我听着"}, {"type": "subtitle", "time": 11726.309, "timestamp": "03:15:26", "text": "YouTuber太多了。"}, {"type": "subtitle", "time": 11728.469, "timestamp": "03:15:28", "text": "总之，当时有个快船……"}, {"type": "subtitle", "time": 11732.389, "timestamp": "03:15:32", "text": "这就好比把她的话断章取义地剪辑出来。"}, {"type": "subtitle", "time": 11733.91, "timestamp": "03:15:33", "text": "即使脱离语境也无妨。他只是"}, {"type": "subtitle", "time": 11736.309, "timestamp": "03:15:36", "text": "标题党。他会像超级英雄一样。"}, {"type": "subtitle", "time": 11739.91, "timestamp": "03:15:39", "text": "对她有性方面的想法，比如喜欢剪她的头发。"}, {"type": "subtitle", "time": 11744.07, "timestamp": "03:15:44", "text": "感觉太像性化了。"}, {"type": "subtitle", "time": 11745.67, "timestamp": "03:15:45", "text": "她的内容，即使她根本没想表达什么。"}, {"type": "subtitle", "time": 11753.83, "timestamp": "03:15:53", "text": "他只是继续这样做而已"}, {"type": "subtitle", "time": 11755.59, "timestamp": "03:15:55", "text": "Numei 就说，好吧，这家伙有"}, {"type": "subtitle", "time": 11757.03, "timestamp": "03:15:57", "text": "感觉她不得不出来，就像"}, {"type": "subtitle", "time": 11759.429, "timestamp": "03:15:59", "text": "就说，好吧，这家伙正在做什么"}]
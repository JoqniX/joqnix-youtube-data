[{"type": "subtitle", "time": 7921.91, "timestamp": "02:12:01", "text": "就像我喜欢打电话一样，呃，我"}, {"type": "subtitle", "time": 7924.629, "timestamp": "02:12:04", "text": "在我的学校里，我最喜欢打恶作剧电话了，就像"}, {"type": "subtitle", "time": 7927.27, "timestamp": "02:12:07", "text": "随机事物"}, {"type": "subtitle", "time": 7929.589, "timestamp": "02:12:09", "text": "就像我之前做的那样，我们搞了个恶作剧。"}, {"type": "subtitle", "time": 7932.39, "timestamp": "02:12:12", "text": "就像在学校里一样。所以我们就像你一样"}, {"type": "subtitle", "time": 7935.109, "timestamp": "02:12:15", "text": "我知道那里好像有个地理方面的东西"}, {"type": "subtitle", "time": 7938.47, "timestamp": "02:12:18", "text": "所以那时候一切都是免费的。"}, {"type": "subtitle", "time": 7941.27, "timestamp": "02:12:21", "text": "我有个朋友，他的名字是……"}, {"type": "subtitle", "time": 7942.109, "timestamp": "02:12:22", "text": "我们来吧"}, {"type": "subtitle", "time": 7945.35, "timestamp": "02:12:25", "text": "苏西说。"}, {"type": "subtitle", "time": 7948.75, "timestamp": "02:12:28", "text": "所以苏西和我，我们俩都有了这个新东西"}, {"type": "subtitle", "time": 7952.669, "timestamp": "02:12:32", "text": "手机就像新的SIM卡一样，我们当时就想，"}, {"type": "subtitle", "time": 7955.27, "timestamp": "02:12:35", "text": "“嗯，你知道吗？我们就是……”"}, {"type": "subtitle", "time": 7957.589, "timestamp": "02:12:37", "text": "闲着没事干。那么，我们开始吧"}, {"type": "subtitle", "time": 7961.43, "timestamp": "02:12:41", "text": "给Jio公司打个恶作剧电话。"}, {"type": "subtitle", "time": 7964.79, "timestamp": "02:12:44", "text": "于是，他把手机给了我。我打电话"}, {"type": "subtitle", "time": 7966.95, "timestamp": "02:12:46", "text": "他们。我当时就说：“好的，先生。那么，我们有……”"}, {"type": "subtitle", "time": 7970.51, "timestamp": "02:12:50", "text": "这个问题。我有个朋友叫"}, {"type": "subtitle", "time": 7974.47, "timestamp": "02:12:54", "text": "苏西。他的网速很慢。我的网络"}, {"type": "subtitle", "time": 7978.39, "timestamp": "02:12:58", "text": "速度太快了，对吧？我们住在隔壁"}]
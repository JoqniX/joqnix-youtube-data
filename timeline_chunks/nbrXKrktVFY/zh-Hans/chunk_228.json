[{"type": "subtitle", "time": 13683.229, "timestamp": "03:48:03", "text": "知道比布会是"}, {"type": "subtitle", "time": 13686.55, "timestamp": "03:48:06", "text": "事物？他是怎么知道的？因为比布是"}, {"type": "subtitle", "time": 13688.229, "timestamp": "03:48:08", "text": "就像之前的小主播一样。喜欢"}, {"type": "subtitle", "time": 13691.189, "timestamp": "03:48:11", "text": "她个子很小。"}, {"type": "subtitle", "time": 13693.03, "timestamp": "03:48:13", "text": "她不像你那样。"}, {"type": "subtitle", "time": 13694.79, "timestamp": "03:48:14", "text": "了解歌唱天赋。她不像那样"}, {"type": "subtitle", "time": 13696.87, "timestamp": "03:48:16", "text": "擅长说话之类的。但"}, {"type": "subtitle", "time": 13700.469, "timestamp": "03:48:20", "text": "她有一种独特的魅力。和"}, {"type": "subtitle", "time": 13702.95, "timestamp": "03:48:22", "text": "那家伙看到了，然后说：“是的，"}, {"type": "subtitle", "time": 13705.469, "timestamp": "03:48:25", "text": "那就是我们的"}, {"type": "subtitle", "time": 13713.83, "timestamp": "03:48:33", "text": "古拉。”顺便说一句，那是我们的古拉。什么"}, {"type": "subtitle", "time": 13715.429, "timestamp": "03:48:35", "text": "我的意思是，哦，那是我们的"}, {"type": "subtitle", "time": 13717.429, "timestamp": "03:48:37", "text": "下一位主播。"}, {"type": "subtitle", "time": 13726.63, "timestamp": "03:48:46", "text": "是的。"}, {"type": "subtitle", "time": 13728.469, "timestamp": "03:48:48", "text": "然后我，我有点不喜欢"}, {"type": "subtitle", "time": 13730.309, "timestamp": "03:48:50", "text": "现在我们用的是 Gura"}, {"type": "subtitle", "time": 13732.389, "timestamp": "03:48:52", "text": "因为就像古拉为什么毕业之后……"}]
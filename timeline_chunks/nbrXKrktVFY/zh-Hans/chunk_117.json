[{"type": "subtitle", "time": 7026.07, "timestamp": "01:57:06", "text": "说。比如我欣赏的一件事"}, {"type": "subtitle", "time": 7030.229, "timestamp": "01:57:10", "text": "很多人并不了解VTuber的背景故事。"}, {"type": "subtitle", "time": 7032.149, "timestamp": "01:57:12", "text": "有些人写背景故事的时候……"}, {"type": "subtitle", "time": 7036.39, "timestamp": "01:57:16", "text": "我喜欢阅读关于他们的故事。嗯。"}, {"type": "subtitle", "time": 7038.229, "timestamp": "01:57:18", "text": "想看看他们是怎么想的"}, {"type": "subtitle", "time": 7040.149, "timestamp": "01:57:20", "text": "它。"}, {"type": "subtitle", "time": 7043.109, "timestamp": "01:57:23", "text": "就像有些人会全力以赴一样"}, {"type": "subtitle", "time": 7044.669, "timestamp": "01:57:24", "text": "他们会"}, {"type": "subtitle", "time": 7046.35, "timestamp": "01:57:26", "text": "去"}, {"type": "subtitle", "time": 7049.83, "timestamp": "01:57:29", "text": "就像他们会创造整个宇宙一样"}, {"type": "subtitle", "time": 7055.83, "timestamp": "01:57:35", "text": "或者他们会创造一个角色，然后"}, {"type": "subtitle", "time": 7059.589, "timestamp": "01:57:39", "text": "让宇宙与他们相连。"}, {"type": "subtitle", "time": 7060.95, "timestamp": "01:57:40", "text": "就像有很多种方法可以实现一样"}, {"type": "subtitle", "time": 7063.109, "timestamp": "01:57:43", "text": "它。是的。是的。"}, {"type": "subtitle", "time": 7065.109, "timestamp": "01:57:45", "text": "我觉得《空洞人生》做得非常好。"}, {"type": "subtitle", "time": 7068.229, "timestamp": "01:57:48", "text": "就背景故事或粉丝而言"}, {"type": "subtitle", "time": 7070.87, "timestamp": "01:57:50", "text": "因为大多数情况下，都是粉丝们"}, {"type": "subtitle", "time": 7073.589, "timestamp": "01:57:53", "text": "比如说，修改一下背景设定。是的。喜欢"}, {"type": "subtitle", "time": 7076.47, "timestamp": "01:57:56", "text": "就像A一样，她过去只是个……"}, {"type": "subtitle", "time": 7078.95, "timestamp": "01:57:58", "text": "普通女侦探。"}]
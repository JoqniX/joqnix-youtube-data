[{"type": "subtitle", "time": 12301.63, "timestamp": "03:25:01", "text": "那些创办……的人"}, {"type": "subtitle", "time": 12303.229, "timestamp": "03:25:03", "text": "移动"}, {"type": "subtitle", "time": 12306.95, "timestamp": "03:25:06", "text": "基本上就像我的团队一样"}, {"type": "subtitle", "time": 12309.79, "timestamp": "03:25:09", "text": "我的东西我也参与其中了。"}, {"type": "subtitle", "time": 12312.63, "timestamp": "03:25:12", "text": "正确的。所以我们让动漫流行起来"}, {"type": "subtitle", "time": 12314.229, "timestamp": "03:25:14", "text": "印度。"}, {"type": "subtitle", "time": 12316.71, "timestamp": "03:25:16", "text": "你知道我们是做什么的吗？你知道吗"}, {"type": "subtitle", "time": 12319.51, "timestamp": "03:25:19", "text": "印度有动漫产业吗？现在"}, {"type": "subtitle", "time": 12322.469, "timestamp": "03:25:22", "text": "它现在确实在缓慢增长。"}, {"type": "subtitle", "time": 12324.79, "timestamp": "03:25:24", "text": "是的，它正在缓慢增长。开始"}, {"type": "subtitle", "time": 12327.19, "timestamp": "03:25:27", "text": "接受这一切吧。但我们做了一个"}, {"type": "subtitle", "time": 12331.03, "timestamp": "03:25:31", "text": "我们有点后悔的一件事。"}, {"type": "subtitle", "time": 12333.75, "timestamp": "03:25:33", "text": "我们把动漫简化了。"}, {"type": "subtitle", "time": 12338.15, "timestamp": "03:25:38", "text": "降低难度。是的。低配版动漫"}, {"type": "subtitle", "time": 12340.15, "timestamp": "03:25:40", "text": "如"}, {"type": "subtitle", "time": 12345.269, "timestamp": "03:25:45", "text": "假设你是一位动漫迷，对吧？"}, {"type": "subtitle", "time": 12348.389, "timestamp": "03:25:48", "text": "是的。你喜欢动漫，而且你喜欢"}, {"type": "subtitle", "time": 12350.309, "timestamp": "03:25:50", "text": "比如说，观看可爱女孩做……"}, {"type": "subtitle", "time": 12353.59, "timestamp": "03:25:53", "text": "可爱的东西，"}, {"type": "subtitle", "time": 12355.469, "timestamp": "03:25:55", "text": "所有人都会嘲笑他"}, {"type": "subtitle", "time": 12359.269, "timestamp": "03:25:59", "text": "你不喜欢《龙珠》。"}]
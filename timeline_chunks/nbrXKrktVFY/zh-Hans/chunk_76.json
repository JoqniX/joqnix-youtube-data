[{"type": "subtitle", "time": 4561.27, "timestamp": "01:16:01", "text": "某物。那你放什么呢？"}, {"type": "subtitle", "time": 4563.83, "timestamp": "01:16:03", "text": "你把仇恨本身也放进了仇恨之中。"}, {"type": "subtitle", "time": 4566.39, "timestamp": "01:16:06", "text": "类别？哦，等等。这很有道理。"}, {"type": "subtitle", "time": 4569.27, "timestamp": "01:16:09", "text": "是啊，为什么不呢？我把那个放进去，然后……"}, {"type": "subtitle", "time": 4571.83, "timestamp": "01:16:11", "text": "陷入循环。"}, {"type": "subtitle", "time": 4576.149, "timestamp": "01:16:16", "text": "如果你憎恨某些事物，那么你也会被憎恨。"}, {"type": "subtitle", "time": 4578.79, "timestamp": "01:16:18", "text": "爱一切。"}, {"type": "subtitle", "time": 4582.99, "timestamp": "01:16:22", "text": "我的天啊。我们爱"}, {"type": "subtitle", "time": 4587.83, "timestamp": "01:16:27", "text": "战争。没有人憎恨战争。"}, {"type": "subtitle", "time": 4591.59, "timestamp": "01:16:31", "text": "我的天啊。就这样，各位。我们摆脱了"}, {"type": "subtitle", "time": 4604.709, "timestamp": "01:16:44", "text": "但这些问题并不严肃。"}, {"type": "subtitle", "time": 4608.07, "timestamp": "01:16:48", "text": "它就像一件东西，但它却让你……"}, {"type": "subtitle", "time": 4612.47, "timestamp": "01:16:52", "text": "多想想，对吧？但这很有趣。"}, {"type": "subtitle", "time": 4615.51, "timestamp": "01:16:55", "text": "我当时就想，哇，我到底讨厌什么？什么"}, {"type": "subtitle", "time": 4618.07, "timestamp": "01:16:58", "text": "我讨厌？而问题并非如此。"}]
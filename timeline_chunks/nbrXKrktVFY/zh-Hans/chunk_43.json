[{"type": "subtitle", "time": 2583.589, "timestamp": "00:43:03", "text": "我的天啊。我没有，我有一个"}, {"type": "subtitle", "time": 2586.63, "timestamp": "00:43:06", "text": "例如极强的疼痛耐受力。"}, {"type": "subtitle", "time": 2587.71, "timestamp": "00:43:07", "text": "所以，就是这样。"}, {"type": "subtitle", "time": 2590.069, "timestamp": "00:43:10", "text": "比如有人在我的聊天室里问我是不是"}, {"type": "subtitle", "time": 2592.55, "timestamp": "00:43:12", "text": "受虐狂。不，与大众观点相反。"}, {"type": "subtitle", "time": 2600.55, "timestamp": "00:43:20", "text": "我仍然不喜欢疼痛。"}, {"type": "subtitle", "time": 2602.9, "timestamp": "00:43:22", "text": "疼痛就是疼痛。我能应付"}, {"type": "subtitle", "time": 2604.51, "timestamp": "00:43:24", "text": "[音乐]"}, {"type": "subtitle", "time": 2607.829, "timestamp": "00:43:27", "text": "疼痛。喜欢，"}, {"type": "subtitle", "time": 2614.91, "timestamp": "00:43:34", "text": "[音乐]"}, {"type": "subtitle", "time": 2617.829, "timestamp": "00:43:37", "text": "嗯，我不知道这么说是否合适。"}, {"type": "subtitle", "time": 2620.309, "timestamp": "00:43:40", "text": "这些图像方面的东西，嗯，就像那样。"}, {"type": "subtitle", "time": 2623.03, "timestamp": "00:43:43", "text": "那一次"}, {"type": "subtitle", "time": 2626.069, "timestamp": "00:43:46", "text": "呃，说到疼痛，是吧？呃，我"}, {"type": "subtitle", "time": 2628.55, "timestamp": "00:43:48", "text": "偶然"}, {"type": "subtitle", "time": 2631.19, "timestamp": "00:43:51", "text": "呃，我处理的时候太笨手笨脚了。我是"}, {"type": "subtitle", "time": 2633.23, "timestamp": "00:43:53", "text": "笨拙。我不知道。"}, {"type": "subtitle", "time": 2636.39, "timestamp": "00:43:56", "text": "有时候确实，是的，我不小心"}, {"type": "subtitle", "time": 2639.03, "timestamp": "00:43:59", "text": "呃，切菜的时候割伤自己了。"}]
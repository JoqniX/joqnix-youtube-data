[{"type": "subtitle", "time": 9300.23, "timestamp": "02:35:00", "text": "它。所以他们说没问题"}, {"type": "subtitle", "time": 9304.309, "timestamp": "02:35:04", "text": "因为他们是受压迫者，"}, {"type": "subtitle", "time": 9307.11, "timestamp": "02:35:07", "text": "正确的？"}, {"type": "subtitle", "time": 9309.429, "timestamp": "02:35:09", "text": "随着时间的推移"}, {"type": "subtitle", "time": 9310.99, "timestamp": "02:35:10", "text": "呃，它变得"}, {"type": "subtitle", "time": 9313.75, "timestamp": "02:35:13", "text": "主流化是因为说唱音乐。"}, {"type": "subtitle", "time": 9316.23, "timestamp": "02:35:16", "text": "东西，说唱文化，因为说唱歌手是"}, {"type": "subtitle", "time": 9319.349, "timestamp": "02:35:19", "text": "他们在歌曲中使用它，然后就流行起来了。"}, {"type": "subtitle", "time": 9323.75, "timestamp": "02:35:23", "text": "全球化了，对吧？是的。"}, {"type": "subtitle", "time": 9326.95, "timestamp": "02:35:26", "text": "然后讨论就来了，这样做是否可以？"}, {"type": "subtitle", "time": 9328.23, "timestamp": "02:35:28", "text": "白人会这么说吗？因为他们"}, {"type": "subtitle", "time": 9331.91, "timestamp": "02:35:31", "text": "是那些以某种方式使用它的人，"}, {"type": "subtitle", "time": 9335.03, "timestamp": "02:35:35", "text": "很糟糕。"}, {"type": "subtitle", "time": 9337.91, "timestamp": "02:35:37", "text": "但我个人并不这么认为。"}, {"type": "subtitle", "time": 9342.15, "timestamp": "02:35:42", "text": "不要认为任何词语是坏的。"}, {"type": "subtitle", "time": 9345.67, "timestamp": "02:35:45", "text": "直到你用特定的方式表达出来。"}, {"type": "subtitle", "time": 9348.71, "timestamp": "02:35:48", "text": "是的。如果你态度不刻薄的话，就点个赞。"}, {"type": "subtitle", "time": 9351.51, "timestamp": "02:35:51", "text": "我对“R”这个词也有同样的疑虑。"}, {"type": "subtitle", "time": 9353.99, "timestamp": "02:35:53", "text": "为什么有些人能够说出这句话"}, {"type": "subtitle", "time": 9356.389, "timestamp": "02:35:56", "text": "有些人却不说？不，我用"}]
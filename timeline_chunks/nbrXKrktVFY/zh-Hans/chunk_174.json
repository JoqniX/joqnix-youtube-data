[{"type": "subtitle", "time": 10441.19, "timestamp": "02:54:01", "text": "嗯。"}, {"type": "subtitle", "time": 10442.87, "timestamp": "02:54:02", "text": "因为就好像这不是我们该做的事一样"}, {"type": "subtitle", "time": 10444.87, "timestamp": "02:54:04", "text": "做。"}, {"type": "subtitle", "time": 10451.75, "timestamp": "02:54:11", "text": "比如如果你是女孩，你就会得到"}, {"type": "subtitle", "time": 10455.75, "timestamp": "02:54:15", "text": "嫁入另一个家庭。"}, {"type": "subtitle", "time": 10457.83, "timestamp": "02:54:17", "text": "但如果你是男生，你就会喜欢"}, {"type": "subtitle", "time": 10460.75, "timestamp": "02:54:20", "text": "你会死在这里。"}, {"type": "subtitle", "time": 10470.309, "timestamp": "02:54:30", "text": "但我现在明白了。现在我想"}, {"type": "subtitle", "time": 10472.55, "timestamp": "02:54:32", "text": "离开，就像……我的城市之类的，走"}, {"type": "subtitle", "time": 10474.95, "timestamp": "02:54:34", "text": "出去看看世界。我知道该怎么做，就像该怎么做一样。"}, {"type": "subtitle", "time": 10487.63, "timestamp": "02:54:47", "text": "因为在某些方面，它确实不错。"}, {"type": "subtitle", "time": 10490.23, "timestamp": "02:54:50", "text": "因为它能教会你如何看待世界"}, {"type": "subtitle", "time": 10491.83, "timestamp": "02:54:51", "text": "作品。"}, {"type": "subtitle", "time": 10493.91, "timestamp": "02:54:53", "text": "是的。"}, {"type": "subtitle", "time": 10497.19, "timestamp": "02:54:57", "text": "独自生活。"}]
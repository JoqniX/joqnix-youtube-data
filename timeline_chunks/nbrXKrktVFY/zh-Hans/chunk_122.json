[{"type": "subtitle", "time": 7320.07, "timestamp": "02:02:00", "text": "使用英语。是的。威尔士语。哦，"}, {"type": "subtitle", "time": 7322.07, "timestamp": "02:02:02", "text": "因为我通过以下方式学习了英语"}, {"type": "subtitle", "time": 7324.47, "timestamp": "02:02:04", "text": "在线的。"}, {"type": "subtitle", "time": 7327.27, "timestamp": "02:02:07", "text": "我喜欢在我学会说英语之前就学会了。"}, {"type": "subtitle", "time": 7328.669, "timestamp": "02:02:08", "text": "知道写作"}, {"type": "subtitle", "time": 7331.35, "timestamp": "02:02:11", "text": "英语和我在网上就像个孩子一样"}, {"type": "subtitle", "time": 7333.109, "timestamp": "02:02:13", "text": "和陌生人说话，这是你不应该做的。"}, {"type": "subtitle", "time": 7336.709, "timestamp": "02:02:16", "text": "确实，但我当时正在做。"}, {"type": "subtitle", "time": 7339.189, "timestamp": "02:02:19", "text": "我当时正在和这些人互动。"}, {"type": "subtitle", "time": 7341.589, "timestamp": "02:02:21", "text": "而且他们大多数都和威尔士人有某种联系，"}, {"type": "subtitle", "time": 7343.91, "timestamp": "02:02:23", "text": "像英国人或者基本上就像"}, {"type": "subtitle", "time": 7345.91, "timestamp": "02:02:25", "text": "来自欧盟的人们"}, {"type": "subtitle", "time": 7347.47, "timestamp": "02:02:27", "text": "所以我选择了他们"}, {"type": "subtitle", "time": 7350.87, "timestamp": "02:02:30", "text": "口音，让我给你讲个笑话。"}, {"type": "subtitle", "time": 7353.35, "timestamp": "02:02:33", "text": "这种口音听起来不太好听。我不能"}, {"type": "subtitle", "time": 7355.669, "timestamp": "02:02:35", "text": "现在就去做，因为我已经做了很多。"}, {"type": "subtitle", "time": 7357.91, "timestamp": "02:02:37", "text": "自我洗脑以摆脱"}, {"type": "subtitle", "time": 7367.35, "timestamp": "02:02:47", "text": "等等，你多大开始上网的？"}, {"type": "subtitle", "time": 7371.43, "timestamp": "02:02:51", "text": "东西？像九。九。"}, {"type": "subtitle", "time": 7373.91, "timestamp": "02:02:53", "text": "等等，九年级是几年级？"}, {"type": "subtitle", "time": 7377.35, "timestamp": "02:02:57", "text": "九。 N 九岁。我不知道。聊天，"}]
[{"type": "subtitle", "time": 3846.95, "timestamp": "01:04:06", "text": "所以答案是否定的。它仍然是"}, {"type": "subtitle", "time": 3849.309, "timestamp": "01:04:09", "text": "道德上是错误的。是的，的确如此。"}, {"type": "subtitle", "time": 3852.309, "timestamp": "01:04:12", "text": "错误的。这里面也有类似的东西。"}, {"type": "subtitle", "time": 3855.19, "timestamp": "01:04:15", "text": "就像我们这个世界一样，那里有"}, {"type": "subtitle", "time": 3857.029, "timestamp": "01:04:17", "text": "就像公司里那些东西一样，你"}, {"type": "subtitle", "time": 3858.87, "timestamp": "01:04:18", "text": "必须签署合同，而这些合同"}, {"type": "subtitle", "time": 3862.23, "timestamp": "01:04:22", "text": "基本上就是奴隶贩卖集团。"}, {"type": "subtitle", "time": 3865.029, "timestamp": "01:04:25", "text": "哦，是的。比如，呃，尤其是在"}, {"type": "subtitle", "time": 3866.87, "timestamp": "01:04:26", "text": "中国"}, {"type": "subtitle", "time": 3869.91, "timestamp": "01:04:29", "text": "就像那里有一些东西……"}, {"type": "subtitle", "time": 3872.789, "timestamp": "01:04:32", "text": "他们会把你锁在……"}, {"type": "subtitle", "time": 3874.39, "timestamp": "01:04:34", "text": "如果你没有获得工厂建设的许可"}, {"type": "subtitle", "time": 3877.109, "timestamp": "01:04:37", "text": "事情办完了。我的天啊。你不能离开"}, {"type": "subtitle", "time": 3878.95, "timestamp": "01:04:38", "text": "房子。如果你不能回家，你就不能回家。"}, {"type": "subtitle", "time": 3881.99, "timestamp": "01:04:41", "text": "造不出那样的iPhone。我的天哪。等待，"}, {"type": "subtitle", "time": 3884.87, "timestamp": "01:04:44", "text": "真的吗？是的。人们陷入困境"}, {"type": "subtitle", "time": 3886.63, "timestamp": "01:04:46", "text": "工厂。他们不可能自杀"}, {"type": "subtitle", "time": 3888.87, "timestamp": "01:04:48", "text": "因为他们有网状物，"}, {"type": "subtitle", "time": 3890.71, "timestamp": "01:04:50", "text": "如果他们试图跳下去，我会抓住他们。"}, {"type": "subtitle", "time": 3894.069, "timestamp": "01:04:54", "text": "屋顶。我的天啊。情况很糟糕。"}, {"type": "subtitle", "time": 3896.23, "timestamp": "01:04:56", "text": "那里。"}]
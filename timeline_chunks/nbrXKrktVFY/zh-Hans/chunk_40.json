[{"type": "subtitle", "time": 2402.79, "timestamp": "00:40:02", "text": "我爸爸希望我当医生。我的"}, {"type": "subtitle", "time": 2407.99, "timestamp": "00:40:07", "text": "奶奶希望我当厨师。所以，我"}, {"type": "subtitle", "time": 2410.829, "timestamp": "00:40:10", "text": "变成了一幅图画"}, {"type": "subtitle", "time": 2413.03, "timestamp": "00:40:13", "text": "设计师。我喜欢这样表达"}, {"type": "subtitle", "time": 2417.829, "timestamp": "00:40:17", "text": "它。因为在我年轻的时候，我曾"}, {"type": "subtitle", "time": 2419.51, "timestamp": "00:40:19", "text": "对一切都感兴趣。你知道"}, {"type": "subtitle", "time": 2421.109, "timestamp": "00:40:21", "text": "孩子们是什么样的人。他们会说：“哦，我是……”"}, {"type": "subtitle", "time": 2422.87, "timestamp": "00:40:22", "text": "我打算这么做。我打算这么做。"}, {"type": "subtitle", "time": 2425.589, "timestamp": "00:40:25", "text": "嗯。在学校里，我的老师们过去常常"}, {"type": "subtitle", "time": 2428.31, "timestamp": "00:40:28", "text": "问我，“哦，橙子，当你长大后……”"}, {"type": "subtitle", "time": 2431.39, "timestamp": "00:40:31", "text": "你想成为什么样的人？”我总是说，"}, {"type": "subtitle", "time": 2436.87, "timestamp": "00:40:36", "text": "“呃，我想当一名面包师。”"}, {"type": "subtitle", "time": 2439.349, "timestamp": "00:40:39", "text": "我想开一家面包店。”他们"}, {"type": "subtitle", "time": 2442.87, "timestamp": "00:40:42", "text": "比如，“那不是一份工作。”我是"}, {"type": "subtitle", "time": 2446.79, "timestamp": "00:40:46", "text": "例如，“是的，就是这样。你吃面包。”"}, {"type": "subtitle", "time": 2448.79, "timestamp": "00:40:48", "text": "我要去做面包。"}, {"type": "subtitle", "time": 2454.15, "timestamp": "00:40:54", "text": "面团。他们说：“啊，是……”"}, {"type": "subtitle", "time": 2455.829, "timestamp": "00:40:55", "text": "只是个孩子，做着孩子该做的事。”我仍然"}, {"type": "subtitle", "time": 2457.67, "timestamp": "00:40:57", "text": "顺便说一句，我想成为一名面包师。我仍然"}, {"type": "subtitle", "time": 2459.589, "timestamp": "00:40:59", "text": "想开一家面包店。就像，就像……"}]
[{"type": "subtitle", "time": 2705.51, "timestamp": "00:45:05", "text": "不小心，嗯，我遇到了这个奇怪的情况"}, {"type": "subtitle", "time": 2709.829, "timestamp": "00:45:09", "text": "嗯，使用安全别针的行为"}, {"type": "subtitle", "time": 2714.309, "timestamp": "00:45:14", "text": "用右别针固定，就像拨动拨弦一样"}, {"type": "subtitle", "time": 2717.829, "timestamp": "00:45:17", "text": "不是皮肤，更像是……呃，我不知道"}, {"type": "subtitle", "time": 2719.43, "timestamp": "00:45:19", "text": "我知道为什么我以前只是随便玩玩"}, {"type": "subtitle", "time": 2722.15, "timestamp": "00:45:22", "text": "安全别针。好的。是的。我的姐妹"}, {"type": "subtitle", "time": 2724.55, "timestamp": "00:45:24", "text": "他经常这样做。是的，我好好教训了她一顿。"}, {"type": "subtitle", "time": 2727.03, "timestamp": "00:45:27", "text": "很多。"}, {"type": "subtitle", "time": 2729.349, "timestamp": "00:45:29", "text": "就像用手指之类的，你只需要"}, {"type": "subtitle", "time": 2732.15, "timestamp": "00:45:32", "text": "可以试试，不会对你造成太大伤害。它是"}, {"type": "subtitle", "time": 2734.47, "timestamp": "00:45:34", "text": "你就像……呃，得到皮肤"}, {"type": "subtitle", "time": 2736.23, "timestamp": "00:45:36", "text": "稍微说了句“是啊”。就像你"}, {"type": "subtitle", "time": 2738.069, "timestamp": "00:45:38", "text": "就像你拉伸皮肤一样"}, {"type": "subtitle", "time": 2739.91, "timestamp": "00:45:39", "text": "看看你能拉多远"}, {"type": "subtitle", "time": 2742.069, "timestamp": "00:45:42", "text": "它。是的。就像我的姐姐一样"}, {"type": "subtitle", "time": 2744.55, "timestamp": "00:45:44", "text": "他给我解释过了，我当时就想，但是……"}, {"type": "subtitle", "time": 2747.349, "timestamp": "00:45:47", "text": "为什么呢？好的。她好像在说，我没有"}, {"type": "subtitle", "time": 2749.19, "timestamp": "00:45:49", "text": "知道。她让我脑子发痒。我就像"}, {"type": "subtitle", "time": 2752.05, "timestamp": "00:45:52", "text": "好的。"}, {"type": "subtitle", "time": 2753.63, "timestamp": "00:45:53", "text": "[音乐]"}, {"type": "subtitle", "time": 2755.02, "timestamp": "00:45:55", "text": "对，就像"}, {"type": "subtitle", "time": 2756.75, "timestamp": "00:45:56", "text": "[音乐]"}]
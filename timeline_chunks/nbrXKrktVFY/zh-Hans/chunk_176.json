[{"type": "subtitle", "time": 10561.79, "timestamp": "02:56:01", "text": "生活唯一的缺点就是她变成了"}, {"type": "subtitle", "time": 10568.87, "timestamp": "02:56:08", "text": "她开始吃素，她开始"}, {"type": "subtitle", "time": 10572.07, "timestamp": "02:56:12", "text": "吃马农蔬菜"}, {"type": "subtitle", "time": 10573.83, "timestamp": "02:56:13", "text": "在此之前，她就像个纯洁的人。"}, {"type": "subtitle", "time": 10583.19, "timestamp": "02:56:23", "text": "那是她的缺点。就像她"}, {"type": "subtitle", "time": 10585.03, "timestamp": "02:56:25", "text": "就像我尝试了一周一样"}, {"type": "subtitle", "time": 10586.95, "timestamp": "02:56:26", "text": "素食者，前几周我刚给了"}, {"type": "subtitle", "time": 10591.11, "timestamp": "02:56:31", "text": "向上。我当时想，这工作量太大了。"}, {"type": "subtitle", "time": 10592.87, "timestamp": "02:56:32", "text": "嗯。"}, {"type": "subtitle", "time": 10595.469, "timestamp": "02:56:35", "text": "所以她就给了"}, {"type": "subtitle", "time": 10598.55, "timestamp": "02:56:38", "text": "向上。我记得我们一起拍过视频。"}, {"type": "subtitle", "time": 10601.389, "timestamp": "02:56:41", "text": "就像我们当时那样……"}, {"type": "subtitle", "time": 10604.15, "timestamp": "02:56:44", "text": "呃，谈到了像素食主义之类的话题"}, {"type": "subtitle", "time": 10606.23, "timestamp": "02:56:46", "text": "日本。"}, {"type": "subtitle", "time": 10609.03, "timestamp": "02:56:49", "text": "啊，我研究了那个视频，做了"}, {"type": "subtitle", "time": 10611.99, "timestamp": "02:56:51", "text": "整件事都很好，但唯一的问题是我"}, {"type": "subtitle", "time": 10613.99, "timestamp": "02:56:53", "text": "全程用英语完成。所以，我们"}, {"type": "subtitle", "time": 10615.389, "timestamp": "02:56:55", "text": "需要翻译"}]
[{"type": "subtitle", "time": 2041.11, "timestamp": "00:34:01", "text": "是的，因为这次安息日更像是"}, {"type": "subtitle", "time": 2043.83, "timestamp": "00:34:03", "text": "嗯，更像是最后的告别。不是"}, {"type": "subtitle", "time": 2046.23, "timestamp": "00:34:06", "text": "最后的告别。不是，而是像你一样"}, {"type": "subtitle", "time": 2048.389, "timestamp": "00:34:08", "text": "垂死。"}, {"type": "subtitle", "time": 2050.629, "timestamp": "00:34:10", "text": "不要再离开我了。"}, {"type": "subtitle", "time": 2053.99, "timestamp": "00:34:13", "text": "不，不，不。就像……因为我不能"}, {"type": "subtitle", "time": 2057.109, "timestamp": "00:34:17", "text": "我预计会从日本进行直播。不，"}, {"type": "subtitle", "time": 2059.909, "timestamp": "00:34:19", "text": "因为我……所以对于那些不知道的人来说……"}, {"type": "subtitle", "time": 2064.31, "timestamp": "00:34:24", "text": "我七月份要去日本。呃，所以"}, {"type": "subtitle", "time": 2066.869, "timestamp": "00:34:26", "text": "我会在那里待两三年。"}, {"type": "subtitle", "time": 2069.589, "timestamp": "00:34:29", "text": "用于学习和其他一切用途。是的，所以"}, {"type": "subtitle", "time": 2072.79, "timestamp": "00:34:32", "text": "我不确定我是否能够……"}, {"type": "subtitle", "time": 2075.51, "timestamp": "00:34:35", "text": "因为我喜欢直播，所以会花一段时间。"}, {"type": "subtitle", "time": 2079.03, "timestamp": "00:34:39", "text": "获得这样的替代方案，将会是"}, {"type": "subtitle", "time": 2081.03, "timestamp": "00:34:41", "text": "几乎不可能喜欢流媒体"}, {"type": "subtitle", "time": 2083.75, "timestamp": "00:34:43", "text": "由于噪声导致的测距仪测量"}, {"type": "subtitle", "time": 2085.669, "timestamp": "00:34:45", "text": "抱怨。我会收到噪音投诉。"}, {"type": "subtitle", "time": 2090.51, "timestamp": "00:34:50", "text": "很多。是的。所以我觉得大概是这样吧"}, {"type": "subtitle", "time": 2094.79, "timestamp": "00:34:54", "text": "找到一个地方之后，感觉不像……呃……"}, {"type": "subtitle", "time": 2098.23, "timestamp": "00:34:58", "text": "比如我可以租房的地方"}]
[{"type": "subtitle", "time": 6541.189, "timestamp": "01:49:01", "text": "这部剧是因为我奶奶我用过我"}, {"type": "subtitle", "time": 6544.95, "timestamp": "01:49:04", "text": "她生前很喜欢我的剧，"}, {"type": "subtitle", "time": 6547.669, "timestamp": "01:49:07", "text": "我把我的所有举动都告诉了她。"}, {"type": "subtitle", "time": 6550.149, "timestamp": "01:49:10", "text": "网上有什么？YouTube 博主们都怎么样了？"}, {"type": "subtitle", "time": 6552.629, "timestamp": "01:49:12", "text": "她不知道什么是娘娘腔，她也不知道。"}, {"type": "subtitle", "time": 6554.55, "timestamp": "01:49:14", "text": "她大部分都听不懂。"}, {"type": "subtitle", "time": 6557.669, "timestamp": "01:49:17", "text": "就像中间问了一个问题，看看"}, {"type": "subtitle", "time": 6560.47, "timestamp": "01:49:20", "text": "表明她正在听，这是哪个？"}, {"type": "subtitle", "time": 6563.91, "timestamp": "01:49:23", "text": "真的很可爱。是的。就像有一次我"}, {"type": "subtitle", "time": 6565.83, "timestamp": "01:49:25", "text": "我也不知道我当时到底在解释什么"}, {"type": "subtitle", "time": 6569.109, "timestamp": "01:49:29", "text": "这送给她。我当时正在解释什么"}, {"type": "subtitle", "time": 6572.47, "timestamp": "01:49:32", "text": "阿拉米亚是。你知道阿拉米亚是什么吗？"}, {"type": "subtitle", "time": 6575.109, "timestamp": "01:49:35", "text": "拉米亚就是那个蛇女，对吧？"}, {"type": "subtitle", "time": 6578.47, "timestamp": "01:49:38", "text": "是的。我正在向她解释这件事。"}, {"type": "subtitle", "time": 6580.229, "timestamp": "01:49:40", "text": "我就像在跟她解释这件事一样"}, {"type": "subtitle", "time": 6582.35, "timestamp": "01:49:42", "text": "我当时就跟她解释我为什么喜欢她"}, {"type": "subtitle", "time": 6585.95, "timestamp": "01:49:45", "text": "喇嘛们，她问我这个问题"}, {"type": "subtitle", "time": 6589.03, "timestamp": "01:49:49", "text": "这个问题就像这样那样"}, {"type": "subtitle", "time": 6591.51, "timestamp": "01:49:51", "text": "问得好，但这就像……"}, {"type": "subtitle", "time": 6594.229, "timestamp": "01:49:54", "text": "奶奶的问题。"}]
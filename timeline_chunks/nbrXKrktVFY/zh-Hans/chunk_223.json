[{"type": "subtitle", "time": 13381.91, "timestamp": "03:43:01", "text": "呃，千万不要把它从……中取出"}, {"type": "subtitle", "time": 13384.95, "timestamp": "03:43:04", "text": "大家都明白我的意思。而且我也没有恶意。"}, {"type": "subtitle", "time": 13387.349, "timestamp": "03:43:07", "text": "随便问问谁。他好像很讨厌"}, {"type": "subtitle", "time": 13392.79, "timestamp": "03:43:12", "text": "他们。他恨他们。你知道，他讨厌……"}, {"type": "subtitle", "time": 13395.51, "timestamp": "03:43:15", "text": "他们。"}, {"type": "subtitle", "time": 13398.55, "timestamp": "03:43:18", "text": "但是，呃，我唯一想说的是……"}, {"type": "subtitle", "time": 13401.91, "timestamp": "03:43:21", "text": "对两者都感到失望，就像……"}, {"type": "subtitle", "time": 13405.91, "timestamp": "03:43:25", "text": "星空方面，这就是为什么要删除呃……"}, {"type": "subtitle", "time": 13409.67, "timestamp": "03:43:29", "text": "人才库人才或肝脏历史"}, {"type": "subtitle", "time": 13411.87, "timestamp": "03:43:31", "text": "数字"}, {"type": "subtitle", "time": 13413.91, "timestamp": "03:43:33", "text": "我想那就是脚印"}, {"type": "subtitle", "time": 13416.309, "timestamp": "03:43:36", "text": "好像是某种合同上的事情。"}, {"type": "subtitle", "time": 13418.95, "timestamp": "03:43:38", "text": "我想这就是我愿意相信的。"}, {"type": "subtitle", "time": 13421.03, "timestamp": "03:43:41", "text": "但可能就是这样"}, {"type": "subtitle", "time": 13422.71, "timestamp": "03:43:42", "text": "人才发送了一些东西或类似的东西"}, {"type": "subtitle", "time": 13424.389, "timestamp": "03:43:44", "text": "公司当时好像签了个合同似的。"}, {"type": "subtitle", "time": 13427.03, "timestamp": "03:43:47", "text": "就这一点而言，我更愿意相信。"}, {"type": "subtitle", "time": 13429.71, "timestamp": "03:43:49", "text": "但情况仍然很糟糕。我知道。"}, {"type": "subtitle", "time": 13434.79, "timestamp": "03:43:54", "text": "是的。是的。如果我必须说，就像我"}, {"type": "subtitle", "time": 13438.309, "timestamp": "03:43:58", "text": "求求了，请点赞并添加"}]
[{"type": "subtitle", "time": 5581.75, "timestamp": "01:33:01", "text": "里面加了番茄，因为我喜欢番茄。"}, {"type": "subtitle", "time": 5584.229, "timestamp": "01:33:04", "text": "我会把它给她，她会想……"}, {"type": "subtitle", "time": 5587.669, "timestamp": "01:33:07", "text": "我正在试图杀了她。哦，不。她是"}, {"type": "subtitle", "time": 5589.35, "timestamp": "01:33:09", "text": "你为什么要把这个放进去？你"}, {"type": "subtitle", "time": 5591.75, "timestamp": "01:33:11", "text": "我知道这让我恶心想吐。我当时就懵了？"}, {"type": "subtitle", "time": 5593.669, "timestamp": "01:33:13", "text": "已经煮熟了。你不会尝到味道"}, {"type": "subtitle", "time": 5597.35, "timestamp": "01:33:17", "text": "它。她说：你想杀了我。我知道"}, {"type": "subtitle", "time": 5601.27, "timestamp": "01:33:21", "text": "我知道你的计划。"}, {"type": "subtitle", "time": 5603.39, "timestamp": "01:33:23", "text": "哦，我的"}, {"type": "subtitle", "time": 5606.47, "timestamp": "01:33:26", "text": "上帝。我小时候很喜欢吃番茄。"}, {"type": "subtitle", "time": 5609.59, "timestamp": "01:33:29", "text": "就像番茄的味道"}, {"type": "subtitle", "time": 5612.31, "timestamp": "01:33:32", "text": "但我不再爱他们了，因为"}, {"type": "subtitle", "time": 5614.55, "timestamp": "01:33:34", "text": "意外发生在西红柿上"}, {"type": "subtitle", "time": 5620.79, "timestamp": "01:33:40", "text": "番茄味。所以我有个哥哥，对吧？"}, {"type": "subtitle", "time": 5623.43, "timestamp": "01:33:43", "text": "他有个孪生兄弟。他以前是……"}, {"type": "subtitle", "time": 5627.229, "timestamp": "01:33:47", "text": "我以前有个双胞胎兄弟"}, {"type": "subtitle", "time": 5631.51, "timestamp": "01:33:51", "text": "然后我们去了我们当时我们正要去的地方"}, {"type": "subtitle", "time": 5634.07, "timestamp": "01:33:54", "text": "前往孟买。我想我们当时是在火车上。"}, {"type": "subtitle", "time": 5637.83, "timestamp": "01:33:57", "text": "我们吃了番茄味的薯片。"}]
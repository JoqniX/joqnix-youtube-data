[{"type": "subtitle", "time": 9960.55, "timestamp": "02:46:00", "text": "啊"}, {"type": "subtitle", "time": 9963.349, "timestamp": "02:46:03", "text": "我已经不会说德语了。我忘了。我"}, {"type": "subtitle", "time": 9964.95, "timestamp": "02:46:04", "text": "我知道一些事情，但懂得不多。"}, {"type": "subtitle", "time": 9968.71, "timestamp": "02:46:08", "text": "事物。嗯。"}, {"type": "subtitle", "time": 9971.269, "timestamp": "02:46:11", "text": "如果我现在要学到什么的话，"}, {"type": "subtitle", "time": 9973.83, "timestamp": "02:46:13", "text": "我想学日语。"}, {"type": "subtitle", "time": 9976.23, "timestamp": "02:46:16", "text": "但不知为何，每当我说我"}, {"type": "subtitle", "time": 9977.91, "timestamp": "02:46:17", "text": "想学日语，听起来像……"}, {"type": "subtitle", "time": 9980.79, "timestamp": "02:46:20", "text": "这话真奇怪。"}, {"type": "subtitle", "time": 9982.71, "timestamp": "02:46:22", "text": "比如，啊，我要去学日语了，走吧"}, {"type": "subtitle", "time": 9990.63, "timestamp": "02:46:30", "text": "所以别说我只是学了日语而已。"}, {"type": "subtitle", "time": 9992.23, "timestamp": "02:46:32", "text": "利用我的空闲时间。千万别说出去。"}, {"type": "subtitle", "time": 9995.03, "timestamp": "02:46:35", "text": "任何人。但我就是喜欢学习它"}, {"type": "subtitle", "time": 9998.79, "timestamp": "02:46:38", "text": "我觉得自己好像在做某件事。"}, {"type": "subtitle", "time": 10007.91, "timestamp": "02:46:47", "text": "我的天啊。就像每当有人说话的时候。"}, {"type": "subtitle", "time": 10009.429, "timestamp": "02:46:49", "text": "日本人，我就想，“好吧，橙子，别……”"}, {"type": "subtitle", "time": 10010.55, "timestamp": "02:46:50", "text": "相互影响。不要互动。不"}]
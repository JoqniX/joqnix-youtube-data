[{"type": "subtitle", "time": 1500.51, "timestamp": "00:25:00", "text": "事物"}, {"type": "subtitle", "time": 1502.87, "timestamp": "00:25:02", "text": "我不知道自己做对了什么。"}, {"type": "subtitle", "time": 1507.23, "timestamp": "00:25:07", "text": "现在。我只是做我想做的事。"}, {"type": "subtitle", "time": 1510.31, "timestamp": "00:25:10", "text": "它。你呢，乔克？你会怎么做？"}, {"type": "subtitle", "time": 1513.51, "timestamp": "00:25:13", "text": "请描述一下你自己？嗯？我该如何……"}, {"type": "subtitle", "time": 1515.83, "timestamp": "00:25:15", "text": "请描述一下我自己？我想知道你是怎么做的"}, {"type": "subtitle", "time": 1517.51, "timestamp": "00:25:17", "text": "请描述一下您的内容？因为对我来说"}, {"type": "subtitle", "time": 1519.75, "timestamp": "00:25:19", "text": "这真的很有意思，但人们会问"}, {"type": "subtitle", "time": 1521.43, "timestamp": "00:25:21", "text": "哦，你在YouTube上做什么？喜欢"}, {"type": "subtitle", "time": 1525.35, "timestamp": "00:25:25", "text": "好吧，我以前写过成人动漫评论，"}, {"type": "subtitle", "time": 1528.07, "timestamp": "00:25:28", "text": "然后我被这个类似团体接纳了。"}, {"type": "subtitle", "time": 1530.95, "timestamp": "00:25:30", "text": "我们制作动漫相关内容的地方"}, {"type": "subtitle", "time": 1533.909, "timestamp": "00:25:33", "text": "在那之前我经常玩角色扮演。"}, {"type": "subtitle", "time": 1536.07, "timestamp": "00:25:36", "text": "在此之前，我经常写评论。"}, {"type": "subtitle", "time": 1539.95, "timestamp": "00:25:39", "text": "网站上某些成人视频"}, {"type": "subtitle", "time": 1544.07, "timestamp": "00:25:44", "text": "视频制作，在此之前我是一名作家"}, {"type": "subtitle", "time": 1546.71, "timestamp": "00:25:46", "text": "维基百科页面"}, {"type": "subtitle", "time": 1549.75, "timestamp": "00:25:49", "text": "在那之前我做了很多事"}, {"type": "subtitle", "time": 1551.43, "timestamp": "00:25:51", "text": "所以我就不知道该怎么描述了。"}, {"type": "subtitle", "time": 1554.47, "timestamp": "00:25:54", "text": "现在的我自己。我只是喜欢一边看直播一边……"}]
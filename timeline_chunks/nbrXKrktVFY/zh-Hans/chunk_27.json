[{"type": "subtitle", "time": 1620.549, "timestamp": "00:27:00", "text": "感觉就像……啊，我想我也是其中的一份子。"}, {"type": "subtitle", "time": 1623.909, "timestamp": "00:27:03", "text": "也许我梦到过，谁知道呢。"}, {"type": "subtitle", "time": 1624.75, "timestamp": "00:27:04", "text": "哦"}, {"type": "subtitle", "time": 1628.47, "timestamp": "00:27:08", "text": "是的，没错。但是，嗯，我是"}, {"type": "subtitle", "time": 1631.71, "timestamp": "00:27:11", "text": "虽然不属于其中，但他们仍然在。"}, {"type": "subtitle", "time": 1635.19, "timestamp": "00:27:15", "text": "那里。米娅在做他们自己的事。哟，"}, {"type": "subtitle", "time": 1638.87, "timestamp": "00:27:18", "text": "Cadmax、Metami 和 Pand 这三个"}, {"type": "subtitle", "time": 1641.549, "timestamp": "00:27:21", "text": "呃，就是那些人"}, {"type": "subtitle", "time": 1644.63, "timestamp": "00:27:24", "text": "虚拟主义背后，我最近也做了这件事。"}, {"type": "subtitle", "time": 1648.269, "timestamp": "00:27:28", "text": "在我的频道上和他们合作"}, {"type": "subtitle", "time": 1650.909, "timestamp": "00:27:30", "text": "出色地。是的，"}, {"type": "subtitle", "time": 1655.029, "timestamp": "00:27:35", "text": "我还能说什么呢？这很难"}, {"type": "subtitle", "time": 1656.95, "timestamp": "00:27:36", "text": "问题。我该如何描述我自己"}, {"type": "subtitle", "time": 1658.11, "timestamp": "00:27:38", "text": "内容？"}, {"type": "subtitle", "time": 1661.909, "timestamp": "00:27:41", "text": "嗯，我会说好吧，我只是不知道。"}, {"type": "subtitle", "time": 1664.71, "timestamp": "00:27:44", "text": "我聊天室里有些人是"}, {"type": "subtitle", "time": 1666.789, "timestamp": "00:27:46", "text": "我知道你的声音让我很困惑。"}, {"type": "subtitle", "time": 1668.63, "timestamp": "00:27:48", "text": "就像我知道你周围的一切一样，因为"}, {"type": "subtitle", "time": 1670.23, "timestamp": "00:27:50", "text": "我曾与你接触过，但可能"}, {"type": "subtitle", "time": 1678.389, "timestamp": "00:27:58", "text": "那么，关于你的……你怎么说呢？"}]
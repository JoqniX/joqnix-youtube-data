[{"type": "subtitle", "time": 5040.709, "timestamp": "01:24:00", "text": "吃了它，我应该会变胖才对。"}, {"type": "subtitle", "time": 5045.55, "timestamp": "01:24:05", "text": "就像我曾经那样"}, {"type": "subtitle", "time": 5048.47, "timestamp": "01:24:08", "text": "吃得就像我先吃了早餐一样"}, {"type": "subtitle", "time": 5050.87, "timestamp": "01:24:10", "text": "我早餐吃了印度薄饼。是的。"}, {"type": "subtitle", "time": 5053.75, "timestamp": "01:24:13", "text": "就像三个印度薄饼，"}, {"type": "subtitle", "time": 5057.75, "timestamp": "01:24:17", "text": "呃，一大杯牛奶。然后，在一段时间内"}, {"type": "subtitle", "time": 5059.59, "timestamp": "01:24:19", "text": "我喜欢去上学"}, {"type": "subtitle", "time": 5061.91, "timestamp": "01:24:21", "text": "和我的朋友们一起去"}, {"type": "subtitle", "time": 5065.39, "timestamp": "01:24:25", "text": "学校里，我们想吃点东西。"}, {"type": "subtitle", "time": 5068.55, "timestamp": "01:24:28", "text": "方式，然后在学校里，当……"}, {"type": "subtitle", "time": 5071.189, "timestamp": "01:24:31", "text": "午餐时间我们会出去吃，或者在家吃。"}, {"type": "subtitle", "time": 5073.99, "timestamp": "01:24:33", "text": "午餐时间，然后放学后我们"}, {"type": "subtitle", "time": 5076.79, "timestamp": "01:24:36", "text": "我会吃点东西，然后回家。"}, {"type": "subtitle", "time": 5081.03, "timestamp": "01:24:41", "text": "吃午饭，不是午餐，你知道的，什么时候"}, {"type": "subtitle", "time": 5083.11, "timestamp": "01:24:43", "text": "你放学回家后才吃饭。"}, {"type": "subtitle", "time": 5085.189, "timestamp": "01:24:45", "text": "是的。是的。是的。呃，晚上吃的零食和"}, {"type": "subtitle", "time": 5088.39, "timestamp": "01:24:48", "text": "东西。是的。是的。那我到时候就吃。然后"}, {"type": "subtitle", "time": 5091.03, "timestamp": "01:24:51", "text": "我还会和朋友们出去玩。"}, {"type": "subtitle", "time": 5093.99, "timestamp": "01:24:53", "text": "和他们一起玩，一起吃饭。什么？"}, {"type": "subtitle", "time": 5097.39, "timestamp": "01:24:57", "text": "然后我会回来的。好的。吃"}, {"type": "subtitle", "time": 5099.669, "timestamp": "01:24:59", "text": "晚餐。深夜，当我……"}]
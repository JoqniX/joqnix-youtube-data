[{"type": "subtitle", "time": 7144.95, "timestamp": "01:59:04", "text": "就像霍尔生活传说也像一个"}, {"type": "subtitle", "time": 7147.03, "timestamp": "01:59:07", "text": "我举的例子和一些独立 YouTuber"}, {"type": "subtitle", "time": 7150.07, "timestamp": "01:59:10", "text": "做了很多像Sway这样优秀的背景故事"}, {"type": "subtitle", "time": 7151.91, "timestamp": "01:59:11", "text": "例子"}, {"type": "subtitle", "time": 7154.47, "timestamp": "01:59:14", "text": "苏拥有一个赛博朋克宇宙，其中"}, {"type": "subtitle", "time": 7156.629, "timestamp": "01:59:16", "text": "她是一名刺客"}, {"type": "subtitle", "time": 7158.87, "timestamp": "01:59:18", "text": "现在她好像不得不这么做了。"}, {"type": "subtitle", "time": 7161.189, "timestamp": "01:59:21", "text": "这些东西，而且它真的太棒了"}, {"type": "subtitle", "time": 7162.95, "timestamp": "01:59:22", "text": "阅读。"}, {"type": "subtitle", "time": 7165.91, "timestamp": "01:59:25", "text": "是的，"}, {"type": "subtitle", "time": 7167.83, "timestamp": "01:59:27", "text": "我喜欢Sway。她做了很多类似的事情"}, {"type": "subtitle", "time": 7170.51, "timestamp": "01:59:30", "text": "那些东西让我惊呼：我的天哪，这也太……"}, {"type": "subtitle", "time": 7174.79, "timestamp": "01:59:34", "text": "凉爽的。我以前给她配音过"}, {"type": "subtitle", "time": 7177.91, "timestamp": "01:59:37", "text": "在上传YouTube视频之前先做一些事情。不，当"}, {"type": "subtitle", "time": 7180.39, "timestamp": "01:59:40", "text": "她当时正在做"}, {"type": "subtitle", "time": 7182.47, "timestamp": "01:59:42", "text": "好像我了解她似的。我认识她。"}, {"type": "subtitle", "time": 7185.51, "timestamp": "01:59:45", "text": "但我并不太感兴趣。而当"}, {"type": "subtitle", "time": 7187.43, "timestamp": "01:59:47", "text": "她成了一名 YouTuber，我当时就想，“我的天哪，"}, {"type": "subtitle", "time": 7188.75, "timestamp": "01:59:48", "text": "她是"}, {"type": "subtitle", "time": 7193.03, "timestamp": "01:59:53", "text": "法语。她太法国了。” 是啊，我喜欢"}, {"type": "subtitle", "time": 7198.87, "timestamp": "01:59:58", "text": "口音。当人们……她生气的时候"}]
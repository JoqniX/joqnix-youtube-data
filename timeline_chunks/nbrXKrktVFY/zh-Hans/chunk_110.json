[{"type": "subtitle", "time": 6601.03, "timestamp": "01:50:01", "text": "我的天啊。"}, {"type": "subtitle", "time": 6602.55, "timestamp": "01:50:02", "text": "因为她觉得，好吧，如果他们穿"}, {"type": "subtitle", "time": 6605.189, "timestamp": "01:50:05", "text": "那他们怎么穿裤子呢？和"}, {"type": "subtitle", "time": 6607.03, "timestamp": "01:50:07", "text": "如果她们穿裙子，她们该如何……"}, {"type": "subtitle", "time": 6609.83, "timestamp": "01:50:09", "text": "裙子不会掉下来吗？"}, {"type": "subtitle", "time": 6612.109, "timestamp": "01:50:12", "text": "我对此没有答案。"}, {"type": "subtitle", "time": 6614.39, "timestamp": "01:50:14", "text": "那。我心想，这真是个好问题。"}, {"type": "subtitle", "time": 6619.189, "timestamp": "01:50:19", "text": "我不知道他们做什么，穿什么。"}, {"type": "subtitle", "time": 6626.07, "timestamp": "01:50:26", "text": "[音乐]"}, {"type": "subtitle", "time": 6630.149, "timestamp": "01:50:30", "text": "他们必须喜欢你的穿着打扮。"}, {"type": "subtitle", "time": 6632.31, "timestamp": "01:50:32", "text": "上半身穿好衣服，下半身穿好衣服"}, {"type": "subtitle", "time": 6634.709, "timestamp": "01:50:34", "text": "它的一部分必须更灵活，或者"}, {"type": "subtitle", "time": 6636.95, "timestamp": "01:50:36", "text": "并非整个尾巴都必须如此"}, {"type": "subtitle", "time": 6640.709, "timestamp": "01:50:40", "text": "在清酒协会中，情况就是这样。"}, {"type": "subtitle", "time": 6642.87, "timestamp": "01:50:42", "text": "如果他们穿着衣服，他们是要去哪里？"}, {"type": "subtitle", "time": 6646.43, "timestamp": "01:50:46", "text": "掩盖重要部分，就像我们"}, {"type": "subtitle", "time": 6650.629, "timestamp": "01:50:50", "text": "做或喜欢生殖器基本上"}, {"type": "subtitle", "time": 6651.99, "timestamp": "01:50:51", "text": "他们是不是只想掩盖真相？"}, {"type": "subtitle", "time": 6653.51, "timestamp": "01:50:53", "text": "生殖器或打算穿戴整个"}, {"type": "subtitle", "time": 6655.669, "timestamp": "01:50:55", "text": "因为某些文化"}, {"type": "subtitle", "time": 6658.55, "timestamp": "01:50:58", "text": "就像穆斯林文化中女性的穿着一样"}, {"type": "subtitle", "time": 6659.99, "timestamp": "01:50:59", "text": "整件事都是因为他们有"}]
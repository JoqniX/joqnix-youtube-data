[{"type": "subtitle", "time": 1200.15, "timestamp": "00:20:00", "text": "我就是喜欢这么看。我当时就想，"}, {"type": "subtitle", "time": 1202.15, "timestamp": "00:20:02", "text": "“好的，今天没有人死亡。哦，太好了。”"}, {"type": "subtitle", "time": 1205.59, "timestamp": "00:20:05", "text": "好的。没有人毕业。好的。”"}, {"type": "subtitle", "time": 1206.51, "timestamp": "00:20:06", "text": "哦，"}, {"type": "subtitle", "time": 1209.39, "timestamp": "00:20:09", "text": "是的。发生了很多事。"}, {"type": "subtitle", "time": 1213.75, "timestamp": "00:20:13", "text": "毕业典礼之类的。不。我的天哪。"}, {"type": "subtitle", "time": 1216.63, "timestamp": "00:20:16", "text": "你不知道我哭了多少次"}, {"type": "subtitle", "time": 1219.11, "timestamp": "00:20:19", "text": "过去几周。我当时就想：“我的天哪。”"}, {"type": "subtitle", "time": 1220.95, "timestamp": "00:20:20", "text": "每次都像这样，“哦，好可爱”"}, {"type": "subtitle", "time": 1222.95, "timestamp": "00:20:22", "text": "YouTuber。你到了。那将是一个"}, {"type": "subtitle", "time": 1226.549, "timestamp": "00:20:26", "text": "如果你毕业了，那就太可惜了。"}, {"type": "subtitle", "time": 1229.51, "timestamp": "00:20:29", "text": "我当时想，“哦，不。她要走了。她要……”"}, {"type": "subtitle", "time": 1236.789, "timestamp": "00:20:36", "text": "我昨天来过，当时我在找……"}, {"type": "subtitle", "time": 1239.71, "timestamp": "00:20:39", "text": "我跟一些人谈过"}, {"type": "subtitle", "time": 1243.11, "timestamp": "00:20:43", "text": "我和推特意识到我找到了这个"}, {"type": "subtitle", "time": 1246.549, "timestamp": "00:20:46", "text": "非常可爱的韩国 YouTuber 和我"}, {"type": "subtitle", "time": 1248.149, "timestamp": "00:20:48", "text": "过了很久之后，他们才查看了自己的个人资料。"}, {"type": "subtitle", "time": 1251.19, "timestamp": "00:20:51", "text": "尽管。结果证明他们都毕业了。"}, {"type": "subtitle", "time": 1254.71, "timestamp": "00:20:54", "text": "昨天那件事让我很难过。每次我"}, {"type": "subtitle", "time": 1256.39, "timestamp": "00:20:56", "text": "找人的时候，我就想，“哦，我得……”"}, {"type": "subtitle", "time": 1258.149, "timestamp": "00:20:58", "text": "观看他们的直播，因为他们似乎"}, {"type": "subtitle", "time": 1259.59, "timestamp": "00:20:59", "text": "真的很有趣，而且他们有"}]
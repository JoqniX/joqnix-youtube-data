[{"type": "subtitle", "time": 6180.31, "timestamp": "01:43:00", "text": "不知何故，我没有带我的"}, {"type": "subtitle", "time": 6182.709, "timestamp": "01:43:02", "text": "剪辑时戴着耳机，因为我当时"}, {"type": "subtitle", "time": 6184.95, "timestamp": "01:43:04", "text": "做一些不需要的事情"}, {"type": "subtitle", "time": 6188.79, "timestamp": "01:43:08", "text": "声音的。是的。"}, {"type": "subtitle", "time": 6190.51, "timestamp": "01:43:10", "text": "然后我就开始了"}, {"type": "subtitle", "time": 6195.07, "timestamp": "01:43:15", "text": "向主席解释我的情况"}, {"type": "subtitle", "time": 6197.669, "timestamp": "01:43:17", "text": "正在做。短暂地，短暂地分开"}, {"type": "subtitle", "time": 6199.75, "timestamp": "01:43:19", "text": "其次，我感觉好像有人在……"}, {"type": "subtitle", "time": 6202.07, "timestamp": "01:43:22", "text": "那位正在与人互动的椅子"}, {"type": "subtitle", "time": 6206.629, "timestamp": "01:43:26", "text": "我。所以，我和别人聊起了这件事。"}, {"type": "chat", "time": 6206.661, "timestamp": "01:43:26", "author": "@BRUCELEE-wt7hk", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kywKa6HSckNVxhER8qedLRRVkcGIqFFytjQHe-071HyMo=s64-c-k-c0x00ffffff-no-rj", "message": "chalo I will see you later bye"}, {"type": "subtitle", "time": 6209.109, "timestamp": "01:43:29", "text": "呃，YouTube博主们，还有像我正在做的事情。"}, {"type": "subtitle", "time": 6211.109, "timestamp": "01:43:31", "text": "我的生活就像一场梦，我们就像拥有了……"}, {"type": "subtitle", "time": 6214.149, "timestamp": "01:43:34", "text": "这段对话真的很愉快。"}, {"type": "subtitle", "time": 6215.75, "timestamp": "01:43:35", "text": "直到我姐姐走进我的房间……"}, {"type": "subtitle", "time": 6218.189, "timestamp": "01:43:38", "text": "她心想：你他妈在跟谁说话？"}, {"type": "subtitle", "time": 6220.189, "timestamp": "01:43:40", "text": "到？就像没有"}, {"type": "subtitle", "time": 6222.55, "timestamp": "01:43:42", "text": "她问：“为什么？为什么是这张椅子？”"}, {"type": "subtitle", "time": 6223.75, "timestamp": "01:43:43", "text": "我感觉自己不知道。我刚看到。"}, {"type": "subtitle", "time": 6226.669, "timestamp": "01:43:46", "text": "从外面拿进来，就像这样"}, {"type": "subtitle", "time": 6229.43, "timestamp": "01:43:49", "text": "呃，我刚才和Kitso有过一段奇妙的经历。"}, {"type": "chat", "time": 6230.773, "timestamp": "01:43:50", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "hai take care bruce lee san"}, {"type": "subtitle", "time": 6235.189, "timestamp": "01:43:55", "text": "而且这样的时刻太多了。"}, {"type": "subtitle", "time": 6236.55, "timestamp": "01:43:56", "text": "那。有时候我会坐着"}, {"type": "subtitle", "time": 6239.27, "timestamp": "01:43:59", "text": "在我的房间里。我会发布这些故事。"}]
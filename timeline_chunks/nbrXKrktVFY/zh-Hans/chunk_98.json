[{"type": "subtitle", "time": 5885.59, "timestamp": "01:38:05", "text": "只是糖。哦，所以我猜你喝酒。"}, {"type": "subtitle", "time": 5890.229, "timestamp": "01:38:10", "text": "蛋白奶昔之类的东西。是的。啊，我"}, {"type": "subtitle", "time": 5891.99, "timestamp": "01:38:11", "text": "只喝蛋白粉就行了。那是我的"}, {"type": "subtitle", "time": 5893.99, "timestamp": "01:38:13", "text": "现在喝汽水。"}, {"type": "subtitle", "time": 5901.109, "timestamp": "01:38:21", "text": "另外，我还想问一个奇怪的问题。做"}, {"type": "subtitle", "time": 5903.35, "timestamp": "01:38:23", "text": "你讨厌昆虫吗？"}, {"type": "subtitle", "time": 5911.669, "timestamp": "01:38:31", "text": "我之所以问这个问题，是因为……"}, {"type": "subtitle", "time": 5914.47, "timestamp": "01:38:34", "text": "我房间里现在有只蟑螂。我爱"}, {"type": "subtitle", "time": 5917.51, "timestamp": "01:38:37", "text": "蟑螂。它们太可爱了。是的。我"}, {"type": "subtitle", "time": 5919.51, "timestamp": "01:38:39", "text": "我没有杀它，我只是……"}, {"type": "subtitle", "time": 5921.669, "timestamp": "01:38:41", "text": "我只是看着它，你知道，移动。"}, {"type": "subtitle", "time": 5924.709, "timestamp": "01:38:44", "text": "大约。我当时真是气疯了。"}, {"type": "subtitle", "time": 5926.79, "timestamp": "01:38:46", "text": "因为就像小时候有一次，我我我"}, {"type": "subtitle", "time": 5929.109, "timestamp": "01:38:49", "text": "以前很喜欢昆虫，对吧？ M 就像一个"}, {"type": "subtitle", "time": 5930.79, "timestamp": "01:38:50", "text": "孩子们就像这些可爱的小家伙一样"}, {"type": "subtitle", "time": 5932.709, "timestamp": "01:38:52", "text": "那些让我感动的东西，我简直要疯了"}, {"type": "subtitle", "time": 5935.35, "timestamp": "01:38:55", "text": "他们太酷了。它们就像一个小"}, {"type": "subtitle", "time": 5939.43, "timestamp": "01:38:59", "text": "能自行移动的玩具。是的。"}]
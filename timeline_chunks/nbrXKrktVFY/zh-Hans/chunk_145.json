[{"type": "subtitle", "time": 8701.75, "timestamp": "02:25:01", "text": "与某人进行 Discord 通话，然后他们"}, {"type": "subtitle", "time": 8703.429, "timestamp": "02:25:03", "text": "你问我，你是什么？"}, {"type": "subtitle", "time": 8704.95, "timestamp": "02:25:04", "text": "正在做？于是，我分享了我的屏幕。"}, {"type": "subtitle", "time": 8706.87, "timestamp": "02:25:06", "text": "他们问我在做什么，还有你是什么样的人。"}, {"type": "subtitle", "time": 8708.389, "timestamp": "02:25:08", "text": "明白了吗？我心想，“是啊，"}, {"type": "subtitle", "time": 8712.23, "timestamp": "02:25:12", "text": "所以你看，呃，呃，艾米正在做"}, {"type": "subtitle", "time": 8715.27, "timestamp": "02:25:15", "text": "那。呃，Gigi正在做什么呢？”所以，我就想……"}, {"type": "subtitle", "time": 8716.95, "timestamp": "02:25:16", "text": "向他们解释了一切。比如，如何"}, {"type": "subtitle", "time": 8719.63, "timestamp": "02:25:19", "text": "你他妈到底在听懂什么？"}, {"type": "subtitle", "time": 8721.91, "timestamp": "02:25:21", "text": "任何事物？我当时就像在看聊天记录一样。"}, {"type": "subtitle", "time": 8724.99, "timestamp": "02:25:24", "text": "我正在阅读，嗯，看看聊天内容是如何展开的。"}, {"type": "subtitle", "time": 8727.59, "timestamp": "02:25:27", "text": "因为，好吧，乔，你明白吗？"}, {"type": "subtitle", "time": 8729.59, "timestamp": "02:25:29", "text": "事物？因为我觉得自己像个自闭症患者"}, {"type": "subtitle", "time": 8732.95, "timestamp": "02:25:32", "text": "为了这。某些人有某种特定的方式"}, {"type": "subtitle", "time": 8735.15, "timestamp": "02:25:35", "text": "YouTuber们会阅读聊天记录。"}, {"type": "subtitle", "time": 8738.15, "timestamp": "02:25:38", "text": "是的，我也注意到了。是的。是的。"}, {"type": "subtitle", "time": 8741.03, "timestamp": "02:25:41", "text": "是的。像一些 YouTuber 一样，像大多数"}, {"type": "subtitle", "time": 8743.99, "timestamp": "02:25:43", "text": "YouTuber们根本不看聊天记录。"}, {"type": "subtitle", "time": 8746.309, "timestamp": "02:25:46", "text": "或者他们会读，或者不发表评论。"}, {"type": "subtitle", "time": 8748.87, "timestamp": "02:25:48", "text": "被读的内容。是的。声乐"}, {"type": "subtitle", "time": 8750.79, "timestamp": "02:25:50", "text": "大声说出来。是的。有些人会"}, {"type": "subtitle", "time": 8753.309, "timestamp": "02:25:53", "text": "只挑选聊天记录里有趣的内容。"}, {"type": "subtitle", "time": 8756.63, "timestamp": "02:25:56", "text": "不知怎么的。有些人就喜欢读"}]
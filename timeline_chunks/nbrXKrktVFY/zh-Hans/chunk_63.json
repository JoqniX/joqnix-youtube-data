[{"type": "subtitle", "time": 3781.67, "timestamp": "01:03:01", "text": "自立权"}, {"type": "subtitle", "time": 3783.99, "timestamp": "01:03:03", "text": "我想做某件事，比如我想做的，我们来吧。"}, {"type": "subtitle", "time": 3787.51, "timestamp": "01:03:07", "text": "假设你和某人签订了一份合同。"}, {"type": "subtitle", "time": 3790.71, "timestamp": "01:03:10", "text": "好的，他们愿意付出。"}, {"type": "subtitle", "time": 3796.069, "timestamp": "01:03:16", "text": "愿意把它给你"}, {"type": "subtitle", "time": 3798.95, "timestamp": "01:03:18", "text": "那他就是朋克。等等，你签了个……"}, {"type": "subtitle", "time": 3802.95, "timestamp": "01:03:22", "text": "合同？是的。就像，就像在"}, {"type": "subtitle", "time": 3805.51, "timestamp": "01:03:25", "text": "就像幻想一样，就像我一样，他们就像一个标志"}, {"type": "subtitle", "time": 3810.23, "timestamp": "01:03:30", "text": "一份合同。好的。为了奴隶条约。"}, {"type": "subtitle", "time": 3811.99, "timestamp": "01:03:31", "text": "好的。"}, {"type": "subtitle", "time": 3815.029, "timestamp": "01:03:35", "text": "这样错了吗？"}, {"type": "subtitle", "time": 3819.27, "timestamp": "01:03:39", "text": "呃，我的意思是你自己签字。"}, {"type": "subtitle", "time": 3822.109, "timestamp": "01:03:42", "text": "就像双方都签字一样。"}, {"type": "subtitle", "time": 3825.27, "timestamp": "01:03:45", "text": "哦。好的。我的天啊。"}, {"type": "subtitle", "time": 3827.029, "timestamp": "01:03:47", "text": "这令人困惑。我的意思是，有"}, {"type": "subtitle", "time": 3829.309, "timestamp": "01:03:49", "text": "双方自愿等等。不。"}, {"type": "subtitle", "time": 3833.67, "timestamp": "01:03:53", "text": "因此，双方同意签订合同。"}, {"type": "subtitle", "time": 3836.789, "timestamp": "01:03:56", "text": "一切，但如果是被迫的，"}, {"type": "subtitle", "time": 3839.43, "timestamp": "01:03:59", "text": "如果那个人被迫签字，"}]
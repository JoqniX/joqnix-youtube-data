[{"type": "subtitle", "time": 13501.59, "timestamp": "03:45:01", "text": "来自 Zuki 的关于你的消息。"}, {"type": "subtitle", "time": 13505.51, "timestamp": "03:45:05", "text": "是的。祖基。铃木。是的。我忘了。我 我"}, {"type": "subtitle", "time": 13507.59, "timestamp": "03:45:07", "text": "忘记点赞"}, {"type": "subtitle", "time": 13510.07, "timestamp": "03:45:10", "text": "我不知道为什么我会把它们搞混。等待。"}, {"type": "subtitle", "time": 13513.71, "timestamp": "03:45:13", "text": "是的。铃木。是的，我记得看到过"}, {"type": "subtitle", "time": 13516.63, "timestamp": "03:45:16", "text": "你。是的，"}, {"type": "subtitle", "time": 13519.11, "timestamp": "03:45:19", "text": "我记得当时看到她，就像……"}, {"type": "subtitle", "time": 13522.55, "timestamp": "03:45:22", "text": "呃，她当时在直播，我看到她好像很喜欢。"}, {"type": "subtitle", "time": 13525.269, "timestamp": "03:45:25", "text": "她最近开始直播了"}, {"type": "subtitle", "time": 13527.59, "timestamp": "03:45:27", "text": "就好像她当时在玩游戏一样"}, {"type": "subtitle", "time": 13529.189, "timestamp": "03:45:29", "text": "你当时就在那里。我心想：“啊，我知道。”"}, {"type": "subtitle", "time": 13530.91, "timestamp": "03:45:30", "text": "这个家伙"}, {"type": "subtitle", "time": 13533.429, "timestamp": "03:45:33", "text": "叽叽喳喳。我在推特上看到过，但是"}, {"type": "subtitle", "time": 13535.229, "timestamp": "03:45:35", "text": "从未听说过"}, {"type": "subtitle", "time": 13537.67, "timestamp": "03:45:37", "text": "他。”就像就在那时，我听到了你的"}, {"type": "subtitle", "time": 13544.95, "timestamp": "03:45:44", "text": "等等，这是什么时候的事？"}, {"type": "subtitle", "time": 13549.59, "timestamp": "03:45:49", "text": "就像很久很久以前那样"}, {"type": "subtitle", "time": 13554.07, "timestamp": "03:45:54", "text": "2020年，是的。是的。 2020年。"}]
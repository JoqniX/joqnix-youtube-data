[{"type": "subtitle", "time": 8462.79, "timestamp": "02:21:02", "text": "就像我喜欢的第一件事一样，我知道"}, {"type": "subtitle", "time": 8464.63, "timestamp": "02:21:04", "text": "我加入时服务器应该没问题"}, {"type": "subtitle", "time": 8468.87, "timestamp": "02:21:08", "text": "人们开始骂我。"}, {"type": "subtitle", "time": 8471.23, "timestamp": "02:21:11", "text": "我心想，“好吧，这将会是……”"}, {"type": "subtitle", "time": 8475.469, "timestamp": "02:21:15", "text": "真有趣。”他就像在说，“瞧，又一个白痴。”"}, {"type": "subtitle", "time": 8482.71, "timestamp": "02:21:22", "text": "走。”尤其是像这样的服务器。"}, {"type": "subtitle", "time": 8484.469, "timestamp": "02:21:24", "text": "人们就像在闲逛一样。"}, {"type": "subtitle", "time": 8490.23, "timestamp": "02:21:30", "text": "因为现在有服务器像这样"}, {"type": "subtitle", "time": 8495.67, "timestamp": "02:21:35", "text": "人们开始进行网上约会。真是太奇怪了。"}, {"type": "subtitle", "time": 8498.71, "timestamp": "02:21:38", "text": "我不理解这个概念。"}, {"type": "subtitle", "time": 8501.91, "timestamp": "02:21:41", "text": "你从中能得到什么？"}, {"type": "subtitle", "time": 8504.469, "timestamp": "02:21:44", "text": "我认为"}, {"type": "subtitle", "time": 8506.63, "timestamp": "02:21:46", "text": "就像那些不了解情况的人一样"}, {"type": "subtitle", "time": 8508.79, "timestamp": "02:21:48", "text": "在线与真人互动。呃"}, {"type": "subtitle", "time": 8512.23, "timestamp": "02:21:52", "text": "所以他们在现实生活中也会上网。"}, {"type": "subtitle", "time": 8519.27, "timestamp": "02:21:59", "text": "但最终你还是要面对的。"}]
[{"type": "subtitle", "time": 5221.669, "timestamp": "01:27:01", "text": "出错了吗？等等，你刚才说什么？"}, {"type": "subtitle", "time": 5224.39, "timestamp": "01:27:04", "text": "请问您最喜欢的食物是什么？我的"}, {"type": "subtitle", "time": 5227.189, "timestamp": "01:27:07", "text": "最喜欢的食物是所有绿色的食物。任何"}, {"type": "subtitle", "time": 5229.669, "timestamp": "01:27:09", "text": "蔬菜。我小时候很爱吃蔬菜。作为一名"}, {"type": "subtitle", "time": 5233.11, "timestamp": "01:27:13", "text": "孩子，我喜欢胡萝卜。我喜欢甜椒。"}, {"type": "subtitle", "time": 5235.03, "timestamp": "01:27:15", "text": "我最喜欢的部分是，呃，我不知道"}, {"type": "subtitle", "time": 5238.28, "timestamp": "01:27:18", "text": "知道它的英文名称。是凯拉。"}, {"type": "subtitle", "time": 5239.669, "timestamp": "01:27:19", "text": "[音乐]"}, {"type": "subtitle", "time": 5243.43, "timestamp": "01:27:23", "text": "那是我最喜欢的东西。哇。所以"}, {"type": "subtitle", "time": 5246.629, "timestamp": "01:27:26", "text": "每当我的父母说这些话的时候"}, {"type": "subtitle", "time": 5248.47, "timestamp": "01:27:28", "text": "他们会向其他家长透露一些关于我的信息。"}, {"type": "subtitle", "time": 5253.149, "timestamp": "01:27:33", "text": "比如，你的孩子吃蔬菜？"}, {"type": "subtitle", "time": 5255.229, "timestamp": "01:27:35", "text": "他们是什么样的人"}, {"type": "subtitle", "time": 5257.51, "timestamp": "01:27:37", "text": "是啊，我们到底在干什么？"}, {"type": "subtitle", "time": 5264.47, "timestamp": "01:27:44", "text": "[音乐]"}, {"type": "subtitle", "time": 5267.75, "timestamp": "01:27:47", "text": "所以，我小时候并不挑食。"}, {"type": "subtitle", "time": 5270.79, "timestamp": "01:27:50", "text": "我发现小孩子都很挑食。"}, {"type": "subtitle", "time": 5273.03, "timestamp": "01:27:53", "text": "当我的兄弟姐妹们出生时"}, {"type": "subtitle", "time": 5274.9, "timestamp": "01:27:54", "text": "因为他们很挑剔"}, {"type": "subtitle", "time": 5276.43, "timestamp": "01:27:56", "text": "[音乐]"}, {"type": "subtitle", "time": 5278.87, "timestamp": "01:27:58", "text": "食客。我父母真是走了狗屎运。"}]
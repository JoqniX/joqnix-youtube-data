[{"type": "subtitle", "time": 10762.63, "timestamp": "02:59:22", "text": "回复：很高兴听到这个消息。"}, {"type": "subtitle", "time": 10765.51, "timestamp": "02:59:25", "text": "是的。"}, {"type": "subtitle", "time": 10767.55, "timestamp": "02:59:27", "text": "我的另一个朋友也去了"}, {"type": "subtitle", "time": 10770.95, "timestamp": "02:59:30", "text": "到美国，"}, {"type": "subtitle", "time": 10772.11, "timestamp": "02:59:32", "text": "她说"}, {"type": "subtitle", "time": 10774.71, "timestamp": "02:59:34", "text": "她好像有很多很有趣的东西。"}, {"type": "subtitle", "time": 10776.75, "timestamp": "02:59:36", "text": "到"}, {"type": "subtitle", "time": 10778.349, "timestamp": "02:59:38", "text": "说"}, {"type": "subtitle", "time": 10781.19, "timestamp": "02:59:41", "text": "我记得我还有另一个"}, {"type": "subtitle", "time": 10785.91, "timestamp": "02:59:45", "text": "朋友，呃，是Shoubam，对吧？"}, {"type": "subtitle", "time": 10788.55, "timestamp": "02:59:48", "text": "他真的对他的事业充满热情"}, {"type": "subtitle", "time": 10791.429, "timestamp": "02:59:51", "text": "语言。"}, {"type": "subtitle", "time": 10793.75, "timestamp": "02:59:53", "text": "所以我记得她去的时候"}, {"type": "subtitle", "time": 10795.83, "timestamp": "02:59:55", "text": "美国是他向她提出的第一件事"}, {"type": "subtitle", "time": 10797.389, "timestamp": "02:59:57", "text": "假设是 n"}]
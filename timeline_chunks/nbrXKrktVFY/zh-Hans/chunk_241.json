[{"type": "subtitle", "time": 14461.51, "timestamp": "04:01:01", "text": "比如，呃，第一个印度裔 YouTuber 是谁？"}, {"type": "subtitle", "time": 14463.51, "timestamp": "04:01:03", "text": "因为 Starscape 好像……"}, {"type": "subtitle", "time": 14465.269, "timestamp": "04:01:05", "text": "麻烦是因为他们开始……他们"}, {"type": "subtitle", "time": 14466.87, "timestamp": "04:01:06", "text": "他们把自己宣传成像"}, {"type": "subtitle", "time": 14474.389, "timestamp": "04:01:14", "text": "我当时就想，他们确实如此。我就像"}, {"type": "subtitle", "time": 14477.51, "timestamp": "04:01:17", "text": "等等，他们确实是。"}, {"type": "subtitle", "time": 14479.11, "timestamp": "04:01:19", "text": "我当时想：“啊，他们确实是。”"}, {"type": "subtitle", "time": 14490.91, "timestamp": "04:01:30", "text": "是啊，因为斯塔斯就像是第一个"}, {"type": "subtitle", "time": 14493.83, "timestamp": "04:01:33", "text": "印度机构、YouTube 机构和"}, {"type": "subtitle", "time": 14496.389, "timestamp": "04:01:36", "text": "一切。不，"}, {"type": "subtitle", "time": 14500.63, "timestamp": "04:01:40", "text": "就是这样。所以，我觉得是因为他们拥有更多。"}, {"type": "subtitle", "time": 14503.67, "timestamp": "04:01:43", "text": "现在就能通过广告触达并填充内容"}, {"type": "subtitle", "time": 14505.67, "timestamp": "04:01:45", "text": "一切。因此，更多人知道了。"}, {"type": "subtitle", "time": 14508.389, "timestamp": "04:01:48", "text": "我认为人们会自然而然地这样认为。"}, {"type": "subtitle", "time": 14510.469, "timestamp": "04:01:50", "text": "就像星空一样。"}, {"type": "subtitle", "time": 14512.79, "timestamp": "04:01:52", "text": "呃，像Zana这样的YouTube博主是第一个"}, {"type": "subtitle", "time": 14515.269, "timestamp": "04:01:55", "text": "YouTuber 等。"}, {"type": "subtitle", "time": 14517.59, "timestamp": "04:01:57", "text": "你知道谁是第一个吗？你可知道？"}, {"type": "subtitle", "time": 14519.429, "timestamp": "04:01:59", "text": "你知道第一个真正的印度人是谁吗？"}]
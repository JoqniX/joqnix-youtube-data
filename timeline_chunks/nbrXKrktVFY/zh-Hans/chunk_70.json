[{"type": "subtitle", "time": 4205.51, "timestamp": "01:10:05", "text": "只有运动员才会和去参加活动的运动员说话"}, {"type": "subtitle", "time": 4214.07, "timestamp": "01:10:14", "text": "事物。体育社团会如何运作？"}, {"type": "subtitle", "time": 4216.04, "timestamp": "01:10:16", "text": "你觉得他像运动员吗？"}, {"type": "subtitle", "time": 4219.03, "timestamp": "01:10:19", "text": "[音乐]"}, {"type": "subtitle", "time": 4221.149, "timestamp": "01:10:21", "text": "是的，"}, {"type": "subtitle", "time": 4223.91, "timestamp": "01:10:23", "text": "我只希望它不会失败。"}, {"type": "subtitle", "time": 4226.31, "timestamp": "01:10:26", "text": "第二天。"}, {"type": "subtitle", "time": 4228.149, "timestamp": "01:10:28", "text": "比如，你会做什么？你会做什么？"}, {"type": "subtitle", "time": 4229.83, "timestamp": "01:10:29", "text": "政治体制将会是什么样的？将要"}, {"type": "subtitle", "time": 4232.149, "timestamp": "01:10:32", "text": "你是一个资本主义社会还是"}, {"type": "subtitle", "time": 4234.07, "timestamp": "01:10:34", "text": "共产？"}, {"type": "subtitle", "time": 4236.51, "timestamp": "01:10:36", "text": "我不理解政治。"}, {"type": "subtitle", "time": 4239.669, "timestamp": "01:10:39", "text": "事物。资本主义就像"}, {"type": "subtitle", "time": 4242.63, "timestamp": "01:10:42", "text": "垄断资本主义等同于资本主义"}, {"type": "subtitle", "time": 4243.55, "timestamp": "01:10:43", "text": "是"}, {"type": "subtitle", "time": 4247.83, "timestamp": "01:10:47", "text": "基本上一切都将受到控制。"}, {"type": "subtitle", "time": 4251.11, "timestamp": "01:10:51", "text": "由人民创造。比如说"}, {"type": "subtitle", "time": 4255.35, "timestamp": "01:10:55", "text": "共产主义是人人平等，"}, {"type": "subtitle", "time": 4257.59, "timestamp": "01:10:57", "text": "因为一切都是，所以没有人需要工作。"}, {"type": "subtitle", "time": 4259.91, "timestamp": "01:10:59", "text": "平等的。"}]
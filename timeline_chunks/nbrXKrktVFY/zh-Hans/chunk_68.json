[{"type": "subtitle", "time": 4082.15, "timestamp": "01:08:02", "text": "我的天啊。是的。"}, {"type": "subtitle", "time": 4083.91, "timestamp": "01:08:03", "text": "想象一下艾伦降落在那里。他就像是，"}, {"type": "subtitle", "time": 4085.99, "timestamp": "01:08:05", "text": "“好了，该动手了。”而我是"}, {"type": "subtitle", "time": 4089.029, "timestamp": "01:08:09", "text": "比如，“艾伦，嗯，如果你看看……”"}, {"type": "subtitle", "time": 4091.829, "timestamp": "01:08:11", "text": "根据这篇文章，根据这件事，"}, {"type": "subtitle", "time": 4094.47, "timestamp": "01:08:14", "text": "星球在我体内，在我那玩意儿下面，"}, {"type": "subtitle", "time": 4103.03, "timestamp": "01:08:23", "text": "我。”他回答说：“什么？”"}, {"type": "subtitle", "time": 4106.149, "timestamp": "01:08:26", "text": "我们刚到。"}, {"type": "subtitle", "time": 4108.229, "timestamp": "01:08:28", "text": "我们没带钱。我们必须"}, {"type": "subtitle", "time": 4111.189, "timestamp": "01:08:31", "text": "返回地球。"}, {"type": "subtitle", "time": 4113.07, "timestamp": "01:08:33", "text": "比如，想象一下我会像这颗星球一样。"}, {"type": "subtitle", "time": 4115.749, "timestamp": "01:08:35", "text": "卖方。如果像玩游戏一样呢？"}, {"type": "subtitle", "time": 4118.229, "timestamp": "01:08:38", "text": "地球上还有人吗？我也出售"}, {"type": "subtitle", "time": 4124.07, "timestamp": "01:08:44", "text": "这是个好问题。"}, {"type": "subtitle", "time": 4126.229, "timestamp": "01:08:46", "text": "就像某个星球上的外星人一样。"}, {"type": "subtitle", "time": 4127.709, "timestamp": "01:08:47", "text": "他们就像在想，"}, {"type": "subtitle", "time": 4131.99, "timestamp": "01:08:51", "text": "“嗯，我很好奇为什么我们会被……所有"}, {"type": "subtitle", "time": 4139.43, "timestamp": "01:08:59", "text": "我不知道。有人把我们卖给了"}]
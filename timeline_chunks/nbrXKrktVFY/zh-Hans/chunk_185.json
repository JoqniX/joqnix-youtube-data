[{"type": "subtitle", "time": 11102.07, "timestamp": "03:05:02", "text": "[音乐]"}, {"type": "subtitle", "time": 11103.67, "timestamp": "03:05:03", "text": "哦，有一件事正在发生，就像……"}, {"type": "subtitle", "time": 11106.469, "timestamp": "03:05:06", "text": "显然是在网上，对吧？我被称为"}, {"type": "subtitle", "time": 11110.79, "timestamp": "03:05:10", "text": "这个乱伦的家伙。你知道这件事吗？"}, {"type": "subtitle", "time": 11112.95, "timestamp": "03:05:12", "text": "那是谁？等等，我被称为……"}, {"type": "subtitle", "time": 11118.15, "timestamp": "03:05:18", "text": "乱伦男。我已上线。我是我，我是我"}, {"type": "subtitle", "time": 11120.469, "timestamp": "03:05:20", "text": "橙子"}, {"type": "subtitle", "time": 11124.389, "timestamp": "03:05:24", "text": "我就是那个出了名的乱伦男，对吧？"}, {"type": "subtitle", "time": 11126.309, "timestamp": "03:05:26", "text": "你为什么知道？你知道这些传说吗？"}, {"type": "subtitle", "time": 11128.269, "timestamp": "03:05:28", "text": "在它背后"}, {"type": "subtitle", "time": 11133.03, "timestamp": "03:05:33", "text": "不，你也有这种感觉吗？不，你也有这种感觉吗？呃……"}, {"type": "subtitle", "time": 11136.63, "timestamp": "03:05:36", "text": "兄妹情深，手足之情难以言表。"}, {"type": "subtitle", "time": 11139.59, "timestamp": "03:05:39", "text": "那东西就是这样，因为我的"}, {"type": "subtitle", "time": 11141.429, "timestamp": "03:05:41", "text": "奥塔基斯坦的日子，那时我经常做"}, {"type": "subtitle", "time": 11145.75, "timestamp": "03:05:45", "text": "就像动漫视频评论那样"}, {"type": "subtitle", "time": 11149.99, "timestamp": "03:05:49", "text": "我看到很多人都讨厌乱伦，比如"}, {"type": "subtitle", "time": 11153.51, "timestamp": "03:05:53", "text": "乱伦动漫和我什么的，随便什么都喜欢"}, {"type": "subtitle", "time": 11155.269, "timestamp": "03:05:55", "text": "我看过的乱伦题材动漫是……"}, {"type": "subtitle", "time": 11158.87, "timestamp": "03:05:58", "text": "通常来说，故事好、情节精彩就不错。"}]
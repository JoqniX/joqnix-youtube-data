[{"type": "subtitle", "time": 1440.95, "timestamp": "00:24:00", "text": "基本上就是申请加入美国国家航空航天局（NASA）。什么？是的。"}, {"type": "subtitle", "time": 1442.31, "timestamp": "00:24:02", "text": "他们会说：“好了各位，我有个……”"}, {"type": "subtitle", "time": 1444.149, "timestamp": "00:24:04", "text": "程度很高。我有这个这个"}, {"type": "subtitle", "time": 1446.07, "timestamp": "00:24:06", "text": "然后就是那个。我先填满了这个，然后又填满了这个。我"}, {"type": "subtitle", "time": 1448.95, "timestamp": "00:24:08", "text": "这所学校。我去参加了那个活动"}, {"type": "subtitle", "time": 1451.43, "timestamp": "00:24:11", "text": "现在，也许他们会听到我的声音。"}, {"type": "subtitle", "time": 1454.47, "timestamp": "00:24:14", "text": "出去。也许他们会的。"}, {"type": "subtitle", "time": 1457.11, "timestamp": "00:24:17", "text": "我的天哪。只是给商场保安用的"}, {"type": "subtitle", "time": 1460.95, "timestamp": "00:24:20", "text": "位置。该死。"}, {"type": "subtitle", "time": 1468.549, "timestamp": "00:24:28", "text": "总之，大家好，我是……"}, {"type": "subtitle", "time": 1469.95, "timestamp": "00:24:29", "text": "橙子。"}, {"type": "subtitle", "time": 1474.149, "timestamp": "00:24:34", "text": "呃，我有很多名字。其中之一是"}, {"type": "subtitle", "time": 1477.87, "timestamp": "00:24:37", "text": "橙子。其他的我不会"}, {"type": "subtitle", "time": 1481.669, "timestamp": "00:24:41", "text": "说。我通常会上网做……"}, {"type": "subtitle", "time": 1485.51, "timestamp": "00:24:45", "text": "随心所欲。我 我 做了 我 做了"}, {"type": "subtitle", "time": 1488.87, "timestamp": "00:24:48", "text": "关于一些动漫的一些事情"}, {"type": "subtitle", "time": 1491.51, "timestamp": "00:24:51", "text": "相关内容。然后我就陷入了……"}, {"type": "subtitle", "time": 1494.47, "timestamp": "00:24:54", "text": "发些垃圾帖子。然后我开始……"}]
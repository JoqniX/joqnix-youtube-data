[{"type": "subtitle", "time": 9780.55, "timestamp": "02:43:00", "text": "所以马拉拉是你的第一语言。 E cuz"}, {"type": "subtitle", "time": 9783.349, "timestamp": "02:43:03", "text": "我不喜欢，我不喜欢，我做不好"}, {"type": "subtitle", "time": 9785.67, "timestamp": "02:43:05", "text": "它。所以我就想，好吧，我去吧。"}, {"type": "subtitle", "time": 9788.309, "timestamp": "02:43:08", "text": "用印地语，这样我至少还能勉强完成。"}, {"type": "subtitle", "time": 9791.11, "timestamp": "02:43:11", "text": "这个学年以及所有的一切。"}, {"type": "subtitle", "time": 9794.91, "timestamp": "02:43:14", "text": "教我一个马拉卢语单词。"}, {"type": "subtitle", "time": 9798.59, "timestamp": "02:43:18", "text": "呃，我的天哪，你让我玩蜘蛛游戏了。"}, {"type": "subtitle", "time": 9804.07, "timestamp": "02:43:24", "text": "哦，我总是……我的天哪，我该怎么做……"}, {"type": "subtitle", "time": 9807.67, "timestamp": "02:43:27", "text": "嗯，我会教你合十礼。"}, {"type": "subtitle", "time": 9813.23, "timestamp": "02:43:33", "text": "相当于 malam。我觉得会是"}, {"type": "subtitle", "time": 9816.07, "timestamp": "02:43:36", "text": "um namaskarum."}, {"type": "subtitle", "time": 9818.55, "timestamp": "02:43:38", "text": "哦，我知道了。 Namaskarum.是的，那是"}, {"type": "subtitle", "time": 9820.469, "timestamp": "02:43:40", "text": "有点儿"}, {"type": "subtitle", "time": 9823.11, "timestamp": "02:43:43", "text": "每当我发现人们说话时"}, {"type": "subtitle", "time": 9824.95, "timestamp": "02:43:44", "text": "就像我一样，我的语言和别人不一样"}, {"type": "subtitle", "time": 9827.75, "timestamp": "02:43:47", "text": "这是和一位会说孟加拉语的朋友一起做的。"}, {"type": "subtitle", "time": 9831.95, "timestamp": "02:43:51", "text": "正确的？我就像我问的第一个问题一样"}, {"type": "subtitle", "time": 9835.75, "timestamp": "02:43:55", "text": "她。好吧，教我怎么说“我喜欢”"}, {"type": "subtitle", "time": 9837.79, "timestamp": "02:43:57", "text": "你的"}]
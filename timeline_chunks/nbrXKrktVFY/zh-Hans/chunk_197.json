[{"type": "subtitle", "time": 11826.07, "timestamp": "03:17:06", "text": "就像我见过的那些空洞的人一样。"}, {"type": "subtitle", "time": 11828.07, "timestamp": "03:17:08", "text": "空心扇子会那样做，我不会。"}, {"type": "subtitle", "time": 11829.91, "timestamp": "03:17:09", "text": "认为它们是空心扇，但就像某些人一样"}, {"type": "subtitle", "time": 11832.469, "timestamp": "03:17:12", "text": "人们用全息生活之类的东西做这些事"}, {"type": "subtitle", "time": 11834.15, "timestamp": "03:17:14", "text": "举报他们，他们就喜欢这样。"}, {"type": "subtitle", "time": 11836.389, "timestamp": "03:17:16", "text": "频道就像两分钟内就消失了一样。"}, {"type": "subtitle", "time": 11838.19, "timestamp": "03:17:18", "text": "因为我"}, {"type": "subtitle", "time": 11840.79, "timestamp": "03:17:20", "text": "我认为有很多全息投影爱好者"}, {"type": "subtitle", "time": 11843.429, "timestamp": "03:17:23", "text": "我也不喜欢这样。所以每当这种情况发生时"}, {"type": "subtitle", "time": 11845.67, "timestamp": "03:17:25", "text": "这种事时有发生，粉丝们只是报道而已。"}, {"type": "subtitle", "time": 11849.429, "timestamp": "03:17:29", "text": "它和频道都消失了"}, {"type": "subtitle", "time": 11851.269, "timestamp": "03:17:31", "text": "因为那里就像有一个整体的集体。"}, {"type": "subtitle", "time": 11853.03, "timestamp": "03:17:33", "text": "一群喜欢"}, {"type": "subtitle", "time": 11859.75, "timestamp": "03:17:39", "text": "比如，我当时正在看这个"}, {"type": "subtitle", "time": 11862.55, "timestamp": "03:17:42", "text": "泄露个人隐私的YouTuber"}, {"type": "subtitle", "time": 11865.349, "timestamp": "03:17:45", "text": "直播信息。"}, {"type": "subtitle", "time": 11868.95, "timestamp": "03:17:48", "text": "什么？是的。就像我当时在想什么类型的"}, {"type": "chat", "time": 11871.418, "timestamp": "03:17:51", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "yeah especially when even the creator themselves are saying they're not comfy"}, {"type": "subtitle", "time": 11871.83, "timestamp": "03:17:51", "text": "这是个人信息吗？她的法律"}, {"type": "subtitle", "time": 11876.75, "timestamp": "03:17:56", "text": "姓名、所在地，所有信息。嗯。"}]
[{"type": "subtitle", "time": 13440.71, "timestamp": "03:44:00", "text": "网站上的明矾之类的东西，以便"}, {"type": "subtitle", "time": 13444.15, "timestamp": "03:44:04", "text": "你知道，就像，是的，这确实存在过。"}, {"type": "subtitle", "time": 13446.469, "timestamp": "03:44:06", "text": "这家公司，他们不是他们"}, {"type": "subtitle", "time": 13448.309, "timestamp": "03:44:08", "text": "毕业之类的，而不是完全毕业"}, {"type": "subtitle", "time": 13450.389, "timestamp": "03:44:10", "text": "也像那样把它们从网站上移除。"}, {"type": "subtitle", "time": 13453.51, "timestamp": "03:44:13", "text": "那就像彻底抹去一样。什么都无所谓"}, {"type": "subtitle", "time": 13457.11, "timestamp": "03:44:17", "text": "这里没有Zuchi。我是Zuki。什么"}, {"type": "subtitle", "time": 13458.63, "timestamp": "03:44:18", "text": "你指的是你的小品吗？"}, {"type": "subtitle", "time": 13460.79, "timestamp": "03:44:20", "text": "某物？是的，会是这样。"}, {"type": "subtitle", "time": 13463.349, "timestamp": "03:44:23", "text": "从未发生过。我讨厌那样。"}, {"type": "subtitle", "time": 13466.469, "timestamp": "03:44:26", "text": "为什么他们如此努力工作？"}, {"type": "subtitle", "time": 13467.99, "timestamp": "03:44:27", "text": "招募"}, {"type": "subtitle", "time": 13471.269, "timestamp": "03:44:31", "text": "嗯，把普通人变成了"}, {"type": "subtitle", "time": 13475.389, "timestamp": "03:44:35", "text": "真正精彩的现场表演和才艺"}, {"type": "subtitle", "time": 13478.07, "timestamp": "03:44:38", "text": "然后把所有的努力都白费了。他们"}, {"type": "subtitle", "time": 13480.229, "timestamp": "03:44:40", "text": "努力工作了两年。那就像"}, {"type": "subtitle", "time": 13481.75, "timestamp": "03:44:41", "text": "坏的。"}, {"type": "subtitle", "time": 13484.55, "timestamp": "03:44:44", "text": "但我也不是那种可以给别人提建议的人。"}, {"type": "subtitle", "time": 13486.469, "timestamp": "03:44:46", "text": "告诉他如何经营公司，"}, {"type": "subtitle", "time": 13490.229, "timestamp": "03:44:50", "text": "一切。不，那可就糟了。但"}, {"type": "subtitle", "time": 13492.95, "timestamp": "03:44:52", "text": "我至少很高兴他们收留了我"}, {"type": "subtitle", "time": 13495.269, "timestamp": "03:44:55", "text": "这个东西从铝制装置上取下来"}, {"type": "subtitle", "time": 13497.91, "timestamp": "03:44:57", "text": "网站。对了，乔，我发现"}]
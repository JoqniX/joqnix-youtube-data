[{"type": "subtitle", "time": 6060.07, "timestamp": "01:41:00", "text": "是。是的，确实有。"}, {"type": "subtitle", "time": 6062.79, "timestamp": "01:41:02", "text": "那甲虫呢？我见过一个"}, {"type": "subtitle", "time": 6066.03, "timestamp": "01:41:06", "text": "甲虫 YouTuber。"}, {"type": "subtitle", "time": 6070.149, "timestamp": "01:41:10", "text": "哇，老兄。蜈蚣。"}, {"type": "subtitle", "time": 6072.31, "timestamp": "01:41:12", "text": "我想我……我也见过一个……我想"}, {"type": "subtitle", "time": 6073.75, "timestamp": "01:41:13", "text": "不，那不是蜈蚣。那是"}, {"type": "subtitle", "time": 6077.669, "timestamp": "01:41:17", "text": "类似那样。啊，他们真的"}, {"type": "subtitle", "time": 6080.47, "timestamp": "01:41:20", "text": "酷，呃，恐怖类型，像那种令人毛骨悚然的。"}, {"type": "subtitle", "time": 6082.39, "timestamp": "01:41:22", "text": "也包括模型。我喜欢蜈蚣。"}, {"type": "chat", "time": 6083.149, "timestamp": "01:41:23", "author": "@BRUCELEE-wt7hk", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kywKa6HSckNVxhER8qedLRRVkcGIqFFytjQHe-071HyMo=s64-c-k-c0x00ffffff-no-rj", "message": "damm joqnix streaming continuously W man"}, {"type": "subtitle", "time": 6086.31, "timestamp": "01:41:26", "text": "它们就像可爱的小胶带一样。"}, {"type": "subtitle", "time": 6089.27, "timestamp": "01:41:29", "text": "对，它就像一个带额外功能的胶带。"}, {"type": "subtitle", "time": 6091.59, "timestamp": "01:41:31", "text": "腿。"}, {"type": "subtitle", "time": 6093.83, "timestamp": "01:41:33", "text": "我有一段我以前互动时的视频。"}, {"type": "subtitle", "time": 6096.35, "timestamp": "01:41:36", "text": "我的肚子里有一条蜈蚣"}, {"type": "subtitle", "time": 6098.95, "timestamp": "01:41:38", "text": "浴室。就像我发的那个视频一样"}, {"type": "subtitle", "time": 6107.189, "timestamp": "01:41:47", "text": "某物。我喜欢蜈蚣。他们是"}, {"type": "subtitle", "time": 6109.27, "timestamp": "01:41:49", "text": "太可爱了。顺便说一句，那只蜈蚣"}, {"type": "subtitle", "time": 6111.189, "timestamp": "01:41:51", "text": "在我的浴室里，它粘在了一些东西上。"}, {"type": "subtitle", "time": 6113.35, "timestamp": "01:41:53", "text": "肥皂之类的东西，它粘在了某个地方。"}, {"type": "subtitle", "time": 6115.59, "timestamp": "01:41:55", "text": "像液体一样，所以动不了。"}, {"type": "subtitle", "time": 6117.189, "timestamp": "01:41:57", "text": "它粘在上面了。所以我就想，啊，"}, {"type": "subtitle", "time": 6119.27, "timestamp": "01:41:59", "text": "如果我接受……那就太可惜了"}]
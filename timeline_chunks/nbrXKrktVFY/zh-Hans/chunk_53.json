[{"type": "subtitle", "time": 3181.27, "timestamp": "00:53:01", "text": "坏了。我心想，所以你的意思是……"}, {"type": "subtitle", "time": 3189.27, "timestamp": "00:53:09", "text": "她说道：“不，橙子，请修好它。”"}, {"type": "subtitle", "time": 3191.349, "timestamp": "00:53:11", "text": "因为那个本该修理的人"}, {"type": "subtitle", "time": 3193.75, "timestamp": "00:53:13", "text": "冰箱，今天是星期天，所以他"}, {"type": "subtitle", "time": 3195.91, "timestamp": "00:53:15", "text": "修不好。我们还有一些东西"}, {"type": "subtitle", "time": 3199.109, "timestamp": "00:53:19", "text": "冰箱，因为如果我们等"}, {"type": "subtitle", "time": 3201.03, "timestamp": "00:53:21", "text": "明天，那些东西就会变质。它是"}, {"type": "subtitle", "time": 3203.349, "timestamp": "00:53:23", "text": "有点贵。那么，你能修好它吗？"}, {"type": "subtitle", "time": 3205.91, "timestamp": "00:53:25", "text": "我当时就想，“好吧。”所以，我就去了那里。"}, {"type": "subtitle", "time": 3207.829, "timestamp": "00:53:27", "text": "然后把整个问题都解决了。显然，"}, {"type": "subtitle", "time": 3209.91, "timestamp": "00:53:29", "text": "那东西没坏。它刚刚"}, {"type": "subtitle", "time": 3213.03, "timestamp": "00:53:33", "text": "一些被剪断的电线断了"}, {"type": "subtitle", "time": 3215.95, "timestamp": "00:53:35", "text": "来自老鼠。所以我只需替换掉"}, {"type": "subtitle", "time": 3219.67, "timestamp": "00:53:39", "text": "电线。它又开始工作了。"}, {"type": "subtitle", "time": 3225.43, "timestamp": "00:53:45", "text": "而且我以前也修理过……"}, {"type": "subtitle", "time": 3228.15, "timestamp": "00:53:48", "text": "手机，坏手机，然后把它们卖掉"}, {"type": "subtitle", "time": 3232.79, "timestamp": "00:53:52", "text": "就像是兼职一样。"}, {"type": "subtitle", "time": 3235.03, "timestamp": "00:53:55", "text": "嗯。你知道，就像在2000年代那样"}, {"type": "subtitle", "time": 3236.95, "timestamp": "00:53:56", "text": "以前的手机都有电池。"}]
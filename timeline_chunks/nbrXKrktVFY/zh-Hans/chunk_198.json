[{"type": "subtitle", "time": 11880.71, "timestamp": "03:18:00", "text": "是的。我亲眼目睹了这一切的发生。"}, {"type": "chat", "time": 11881.914, "timestamp": "03:18:01", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "WHAT"}, {"type": "subtitle", "time": 11882.95, "timestamp": "03:18:02", "text": "我觉得她大概有200个"}, {"type": "subtitle", "time": 11885.83, "timestamp": "03:18:05", "text": "当时Twitch上的观众"}, {"type": "subtitle", "time": 11889.349, "timestamp": "03:18:09", "text": "大家一致表示没有人"}, {"type": "subtitle", "time": 11891.99, "timestamp": "03:18:11", "text": "我会谈到这件事。没有人剪断"}, {"type": "subtitle", "time": 11894.429, "timestamp": "03:18:14", "text": "它。没有人喜欢拿走"}, {"type": "subtitle", "time": 11897.349, "timestamp": "03:18:17", "text": "截屏。所有人集体"}, {"type": "subtitle", "time": 11899.429, "timestamp": "03:18:19", "text": "就像之前说的，好吧，这是一个敏感话题。"}, {"type": "subtitle", "time": 11901.75, "timestamp": "03:18:21", "text": "事情。我们不应该，我们应该尊重"}, {"type": "subtitle", "time": 11905.349, "timestamp": "03:18:25", "text": "这一刻，没有人，每个人"}, {"type": "subtitle", "time": 11907.51, "timestamp": "03:18:27", "text": "出来之后，就好像，好吧，我们得这么做了。"}, {"type": "subtitle", "time": 11911.429, "timestamp": "03:18:31", "text": "这是送给她的，因为我们爱她。"}, {"type": "chat", "time": 11911.588, "timestamp": "03:18:31", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "respectUCkszU2WH9gy1mb0dV-11UJg/m8MfY4jbFsWJhL0PyouA2AkUCkszU2WH9gy1mb0dV-11UJg/7cIfY5niDOmSkNAP08CA6A4"}, {"type": "subtitle", "time": 11912.95, "timestamp": "03:18:32", "text": "那一刻我就想，好吧。"}, {"type": "subtitle", "time": 11914.55, "timestamp": "03:18:34", "text": "这个社区里有些人"}, {"type": "subtitle", "time": 11916.63, "timestamp": "03:18:36", "text": "他们并不愚蠢"}, {"type": "subtitle", "time": 11919.429, "timestamp": "03:18:39", "text": "啊，那真是个美好的瞬间。"}, {"type": "subtitle", "time": 11921.91, "timestamp": "03:18:41", "text": "他赢得了我的尊重，我简直惊呆了。"}, {"type": "subtitle", "time": 11924.71, "timestamp": "03:18:44", "text": "世界上有人尊重"}, {"type": "subtitle", "time": 11927.19, "timestamp": "03:18:47", "text": "押"}, {"type": "subtitle", "time": 11930.229, "timestamp": "03:18:50", "text": "因为任何其他 YouTuber 或任何主播。"}, {"type": "subtitle", "time": 11933.11, "timestamp": "03:18:53", "text": "如果你有 200 或 100 个观众，而你"}, {"type": "subtitle", "time": 11935.75, "timestamp": "03:18:55", "text": "泄露信息，你就完蛋了。"}, {"type": "subtitle", "time": 11938.71, "timestamp": "03:18:58", "text": "是的。"}]
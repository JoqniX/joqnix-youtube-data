[{"type": "subtitle", "time": 7501.27, "timestamp": "02:05:01", "text": "你自己？你们这话是什么意思？"}, {"type": "subtitle", "time": 7514.47, "timestamp": "02:05:14", "text": "我的意思是，有人在我的聊天记录里说："}, {"type": "subtitle", "time": 7516.91, "timestamp": "02:05:16", "text": "ATAL对移动设备不利"}, {"type": "subtitle", "time": 7520.629, "timestamp": "02:05:20", "text": "数据流量不太好，但Wi-Fi信号不错。"}, {"type": "subtitle", "time": 7523.83, "timestamp": "02:05:23", "text": "是的，我现在有Wi-Fi。"}, {"type": "subtitle", "time": 7525.99, "timestamp": "02:05:25", "text": "比如纤维。"}, {"type": "subtitle", "time": 7527.229, "timestamp": "02:05:27", "text": "有用"}, {"type": "subtitle", "time": 7530.55, "timestamp": "02:05:30", "text": "美好的。 H"}, {"type": "subtitle", "time": 7533.75, "timestamp": "02:05:33", "text": "就像我感觉好像只有 Jio 或"}, {"type": "subtitle", "time": 7537.03, "timestamp": "02:05:37", "text": "Atel 和 Jio 似乎也有一些类似的东西"}, {"type": "subtitle", "time": 7538.51, "timestamp": "02:05:38", "text": "比如与……相比"}, {"type": "subtitle", "time": 7541.669, "timestamp": "02:05:41", "text": "就像在手机上一样，Wi-Fi 工作正常，但是"}, {"type": "subtitle", "time": 7544.95, "timestamp": "02:05:44", "text": "在Wi-Fi网络上，他们会做这种偷偷摸摸的事情，"}, {"type": "subtitle", "time": 7547.43, "timestamp": "02:05:47", "text": "他们只会给你下载。"}, {"type": "subtitle", "time": 7551.03, "timestamp": "02:05:51", "text": "传输速度，不是上传速度。哦，对，还有那个"}, {"type": "subtitle", "time": 7553.03, "timestamp": "02:05:53", "text": "就是"}, {"type": "subtitle", "time": 7555.43, "timestamp": "02:05:55", "text": "是啊，我也问过他们这个问题。"}, {"type": "subtitle", "time": 7557.83, "timestamp": "02:05:57", "text": "我当时就想，“好了，伙计们，我有个计划。”"}]
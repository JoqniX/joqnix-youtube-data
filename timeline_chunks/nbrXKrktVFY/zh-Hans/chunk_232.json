[{"type": "subtitle", "time": 13925.349, "timestamp": "03:52:05", "text": "我记得看过她，但我从来没有……"}, {"type": "subtitle", "time": 13927.51, "timestamp": "03:52:07", "text": "我从未想过她会这样。"}, {"type": "subtitle", "time": 13929.309, "timestamp": "03:52:09", "text": "巨大的"}, {"type": "subtitle", "time": 13932.07, "timestamp": "03:52:12", "text": "YouTuber。我甚至都没……我甚至都没……"}, {"type": "subtitle", "time": 13934.79, "timestamp": "03:52:14", "text": "我知道她来自霍尔莱夫公司。我当时"}, {"type": "subtitle", "time": 13943.59, "timestamp": "03:52:23", "text": "GTA。我就像她说的那样，所以她就这么说了。"}, {"type": "subtitle", "time": 13945.39, "timestamp": "03:52:25", "text": "有趣的是。"}, {"type": "subtitle", "time": 13946.55, "timestamp": "03:52:26", "text": "[音乐]"}, {"type": "subtitle", "time": 13948.15, "timestamp": "03:52:28", "text": "JP也有同样的经历。"}, {"type": "subtitle", "time": 13949.75, "timestamp": "03:52:29", "text": "人也是。他们会说，是啊，她会说话。"}, {"type": "subtitle", "time": 13959.03, "timestamp": "03:52:39", "text": "记得有人说过，“我一直……”"}, {"type": "subtitle", "time": 13961.59, "timestamp": "03:52:41", "text": "通过观看 Mo 的直播学习日语。"}, {"type": "subtitle", "time": 13963.91, "timestamp": "03:52:43", "text": "每个日本人都问：“你为什么要这么做？”"}, {"type": "subtitle", "time": 13965.95, "timestamp": "03:52:45", "text": "这"}, {"type": "subtitle", "time": 13968.469, "timestamp": "03:52:48", "text": "你自己？我们听不懂她在说什么。为什么"}, {"type": "subtitle", "time": 13969.99, "timestamp": "03:52:49", "text": "你他妈到底想理解什么"}, {"type": "subtitle", "time": 13972.71, "timestamp": "03:52:52", "text": "她？”"}]
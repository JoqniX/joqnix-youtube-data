[{"type": "subtitle", "time": 6241.189, "timestamp": "01:44:01", "text": "瞬间。就像我会坐着……"}, {"type": "subtitle", "time": 6243.109, "timestamp": "01:44:03", "text": "我自言自语道："}, {"type": "subtitle", "time": 6244.95, "timestamp": "01:44:04", "text": "“哦，这将是一个不错的Instagram"}, {"type": "subtitle", "time": 6254.07, "timestamp": "01:44:14", "text": "我很喜欢你的Instagram故事内容。"}, {"type": "subtitle", "time": 6257.27, "timestamp": "01:44:17", "text": "看你做这些真有趣。"}, {"type": "subtitle", "time": 6259.51, "timestamp": "01:44:19", "text": "我大部分时候都会像躺在上面一样"}, {"type": "subtitle", "time": 6262.229, "timestamp": "01:44:22", "text": "我躺在床上，心想：我会一直想着这件事。"}, {"type": "subtitle", "time": 6266.149, "timestamp": "01:44:26", "text": "在墙上自言自语"}, {"type": "subtitle", "time": 6267.59, "timestamp": "01:44:27", "text": "然后我就想，啊，这有点像……"}, {"type": "subtitle", "time": 6270.07, "timestamp": "01:44:30", "text": "有趣的。我应该把这个发到Instagram上，或者"}, {"type": "subtitle", "time": 6278.07, "timestamp": "01:44:38", "text": "比如，如果它让我边说话边笑。"}, {"type": "subtitle", "time": 6285.43, "timestamp": "01:44:45", "text": "是的。但你乐意这样做。"}, {"type": "subtitle", "time": 6287.07, "timestamp": "01:44:47", "text": "就像你一样"}, {"type": "subtitle", "time": 6289.669, "timestamp": "01:44:49", "text": "你感觉如何？"}, {"type": "subtitle", "time": 6293.27, "timestamp": "01:44:53", "text": "不，大概只有20%是快乐的。大部分"}, {"type": "subtitle", "time": 6296.229, "timestamp": "01:44:56", "text": "真是令人沮丧。"}, {"type": "subtitle", "time": 6298.629, "timestamp": "01:44:58", "text": "我自言自语，让自己生气。"}]
[{"type": "subtitle", "time": 7442.229, "timestamp": "02:04:02", "text": "相同"}, {"type": "subtitle", "time": 7443.83, "timestamp": "02:04:03", "text": "我认为。是的，情况还是一样。我"}, {"type": "subtitle", "time": 7446.229, "timestamp": "02:04:06", "text": "真不明白他们怎么还没改进。"}, {"type": "subtitle", "time": 7452.109, "timestamp": "02:04:12", "text": "就像我想的那样"}, {"type": "subtitle", "time": 7458.189, "timestamp": "02:04:18", "text": "2015年或2017年，我叔叔改行了"}, {"type": "subtitle", "time": 7463.669, "timestamp": "02:04:23", "text": "呃，我觉得是阿特尔，因为阿特尔好像有……"}, {"type": "subtitle", "time": 7466.31, "timestamp": "02:04:26", "text": "这里有个计划，我叔叔做了。"}, {"type": "subtitle", "time": 7468.87, "timestamp": "02:04:28", "text": "与很多公司有业务往来，比如……"}, {"type": "subtitle", "time": 7470.709, "timestamp": "02:04:30", "text": "电信公司和移动通信公司"}, {"type": "subtitle", "time": 7474.629, "timestamp": "02:04:34", "text": "所以他通过这些公司获得了提前访问权限。"}, {"type": "subtitle", "time": 7476.91, "timestamp": "02:04:36", "text": "哦，不错。"}, {"type": "subtitle", "time": 7480.07, "timestamp": "02:04:40", "text": "是的。所以，我的网络很好。"}, {"type": "subtitle", "time": 7481.149, "timestamp": "02:04:41", "text": "就像"}, {"type": "subtitle", "time": 7484.47, "timestamp": "02:04:44", "text": "孩子对我的成长没有帮助。"}, {"type": "subtitle", "time": 7491.669, "timestamp": "02:04:51", "text": "人。就像小时候一样"}, {"type": "subtitle", "time": 7493.35, "timestamp": "02:04:53", "text": "我和其他孩子一样互动，而且我是"}, {"type": "subtitle", "time": 7494.629, "timestamp": "02:04:54", "text": "比如，你是什么意思？你是什么意思？"}, {"type": "subtitle", "time": 7495.87, "timestamp": "02:04:55", "text": "伙计们"}]
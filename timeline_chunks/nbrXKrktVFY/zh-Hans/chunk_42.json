[{"type": "subtitle", "time": 2521.349, "timestamp": "00:42:01", "text": "恶心死了，但我又不害怕"}, {"type": "subtitle", "time": 2524.55, "timestamp": "00:42:04", "text": "血，我不会对伤口感到恶心。"}, {"type": "subtitle", "time": 2527.75, "timestamp": "00:42:07", "text": "就像我也可以说“我也可以”一样"}, {"type": "subtitle", "time": 2530.47, "timestamp": "00:42:10", "text": "给自己注射。就像有一次我"}, {"type": "subtitle", "time": 2532.71, "timestamp": "00:42:12", "text": "护士问道：“哦，我可以放……”"}, {"type": "subtitle", "time": 2536.27, "timestamp": "00:42:16", "text": "给我注射？我想试试"}, {"type": "subtitle", "time": 2538.47, "timestamp": "00:42:18", "text": "她问：“你还好吗？” 我说，"}, {"type": "subtitle", "time": 2542.39, "timestamp": "00:42:22", "text": "“是啊，他们居然让你这么做。”"}, {"type": "subtitle", "time": 2545.99, "timestamp": "00:42:25", "text": "她让我这么做了。哇。你认识她吗？她"}, {"type": "subtitle", "time": 2547.43, "timestamp": "00:42:27", "text": "她问我：“好的。”她说"}, {"type": "subtitle", "time": 2549.27, "timestamp": "00:42:29", "text": "比如，“好的，首先，握住它，就像……”"}, {"type": "subtitle", "time": 2550.95, "timestamp": "00:42:30", "text": "这样做，然后像这样去做，继续。"}, {"type": "subtitle", "time": 2552.51, "timestamp": "00:42:32", "text": "慢慢地。”就像她一样"}, {"type": "subtitle", "time": 2555.349, "timestamp": "00:42:35", "text": "告诉我各种方法，就像那时我"}, {"type": "subtitle", "time": 2556.79, "timestamp": "00:42:36", "text": "她做了，然后她说：“你知道吗？那……”"}, {"type": "subtitle", "time": 2560.23, "timestamp": "00:42:40", "text": "出乎意料的好。"}, {"type": "subtitle", "time": 2563.95, "timestamp": "00:42:43", "text": "我的天啊。好的。"}, {"type": "subtitle", "time": 2566.95, "timestamp": "00:42:46", "text": "是的。我的意思是，如果你把这件事告诉别人的话"}, {"type": "subtitle", "time": 2568.47, "timestamp": "00:42:48", "text": "正常情况下，比如，“是的，我可以注射。”"}, {"type": "subtitle", "time": 2570.47, "timestamp": "00:42:50", "text": "我自己。”然后他们会说，“听起来……”"}, {"type": "subtitle", "time": 2573.63, "timestamp": "00:42:53", "text": "就像毒品一样。”他会说，"}, {"type": "subtitle", "time": 2576.55, "timestamp": "00:42:56", "text": "“我的天啊。”"}]
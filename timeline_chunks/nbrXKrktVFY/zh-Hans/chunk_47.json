[{"type": "subtitle", "time": 2821.67, "timestamp": "00:47:01", "text": "就像它和你的很相似"}, {"type": "subtitle", "time": 2824.39, "timestamp": "00:47:04", "text": "他们讲故事时会用到这类东西，比如"}, {"type": "subtitle", "time": 2826.67, "timestamp": "00:47:06", "text": "我必须是你们知道的那个人。"}, {"type": "subtitle", "time": 2828.87, "timestamp": "00:47:08", "text": "你以为你认识那些人？我不这么认为。"}, {"type": "subtitle", "time": 2831.91, "timestamp": "00:47:11", "text": "在房子里放火不是个好主意。"}, {"type": "subtitle", "time": 2834.71, "timestamp": "00:47:14", "text": "也许这个想法"}, {"type": "subtitle", "time": 2836.71, "timestamp": "00:47:16", "text": "你们知道吗，伙计们，我不认为吃东西是件好事。"}, {"type": "subtitle", "time": 2840.109, "timestamp": "00:47:20", "text": "塑料制品不好"}, {"type": "subtitle", "time": 2842.71, "timestamp": "00:47:22", "text": "想法是，我必须像那样"}, {"type": "subtitle", "time": 2844.71, "timestamp": "00:47:24", "text": "我只是个普通人，我不是个理性的人，我确实如此。"}, {"type": "subtitle", "time": 2846.589, "timestamp": "00:47:26", "text": "蠢事"}, {"type": "subtitle", "time": 2848.95, "timestamp": "00:47:28", "text": "正确的。但我必须像大人物一样"}, {"type": "subtitle", "time": 2851.23, "timestamp": "00:47:31", "text": "兄弟，就像拯救"}, {"type": "subtitle", "time": 2854.47, "timestamp": "00:47:34", "text": "每个人。所以有时候我会喜欢"}, {"type": "subtitle", "time": 2856.47, "timestamp": "00:47:36", "text": "有时候我会做一些蠢事，而我的"}, {"type": "subtitle", "time": 2858.39, "timestamp": "00:47:38", "text": "父母会问我，你是家里最大的孩子。"}, {"type": "subtitle", "time": 2860.39, "timestamp": "00:47:40", "text": "一。你为什么会这样做？"}, {"type": "subtitle", "time": 2862.63, "timestamp": "00:47:42", "text": "这？我感觉自己不知道。出来了"}, {"type": "subtitle", "time": 2865.589, "timestamp": "00:47:45", "text": "就像今天这样。所以我得到了"}, {"type": "subtitle", "time": 2867.91, "timestamp": "00:47:47", "text": "这些香蕉对吧？他们正在看"}, {"type": "subtitle", "time": 2869.829, "timestamp": "00:47:49", "text": "他们看起来太完美了。所以我喜欢我"}, {"type": "subtitle", "time": 2871.67, "timestamp": "00:47:51", "text": "我当时就想，我必须买下它们。他们"}, {"type": "subtitle", "time": 2874.23, "timestamp": "00:47:54", "text": "看起来太好了。我到家了。我当时完全"}, {"type": "subtitle", "time": 2877.109, "timestamp": "00:47:57", "text": "兴奋的。我弄到了一辆，开始"}, {"type": "subtitle", "time": 2879.109, "timestamp": "00:47:59", "text": "吃了之后发现它们是生的。他们是"}]
[{"type": "subtitle", "time": 4627.59, "timestamp": "01:17:07", "text": "[音乐]"}, {"type": "subtitle", "time": 4630.07, "timestamp": "01:17:10", "text": "现在我满脑子都是这件事。我是"}, {"type": "subtitle", "time": 4632.47, "timestamp": "01:17:12", "text": "还在考虑中。搞什么鬼？"}, {"type": "subtitle", "time": 4634.47, "timestamp": "01:17:14", "text": "就像我第一次读到这个问题时一样，"}, {"type": "subtitle", "time": 4636.47, "timestamp": "01:17:16", "text": "我当时想，啊，有一件事没关系"}, {"type": "subtitle", "time": 4639.35, "timestamp": "01:17:19", "text": "讨厌我自己。我可以恨自己"}, {"type": "subtitle", "time": 4643.27, "timestamp": "01:17:23", "text": "这样也没关系。 M，但没有仇恨。"}, {"type": "subtitle", "time": 4644.87, "timestamp": "01:17:24", "text": "你自己感觉不好，因为当你"}, {"type": "subtitle", "time": 4648.149, "timestamp": "01:17:28", "text": "仔细考虑很久"}, {"type": "subtitle", "time": 4652.07, "timestamp": "01:17:32", "text": "你对指引你的事物产生了怀疑。"}, {"type": "subtitle", "time": 4655.75, "timestamp": "01:17:35", "text": "那就像是让你坚持下去。"}, {"type": "subtitle", "time": 4658.63, "timestamp": "01:17:38", "text": "所以，想象一下你拥有这样一样东西"}, {"type": "subtitle", "time": 4660.83, "timestamp": "01:17:40", "text": "它让你活下去"}, {"type": "subtitle", "time": 4664.39, "timestamp": "01:17:44", "text": "对，就像这样，你看这边"}, {"type": "subtitle", "time": 4667.75, "timestamp": "01:17:47", "text": "心脏正在努力泵血"}, {"type": "subtitle", "time": 4670.07, "timestamp": "01:17:50", "text": "那个正在接受血液泵送的东西"}, {"type": "subtitle", "time": 4672.31, "timestamp": "01:17:52", "text": "他们像所有人一样努力工作。"}, {"type": "subtitle", "time": 4674.39, "timestamp": "01:17:54", "text": "你身体的一部分，或者像每个器官一样，都是"}, {"type": "subtitle", "time": 4676.63, "timestamp": "01:17:56", "text": "努力工作。是的。与此同时"}, {"type": "subtitle", "time": 4678.229, "timestamp": "01:17:58", "text": "大脑就像是：啊，我有点讨厌"}]
[{"type": "subtitle", "time": 13628.03, "timestamp": "03:47:08", "text": "比如琵琶、天马、尤洛卡、莉亚。我是"}, {"type": "subtitle", "time": 13630.469, "timestamp": "03:47:10", "text": "比如，你根本找不到这些人。"}, {"type": "subtitle", "time": 13633.429, "timestamp": "03:47:13", "text": "通常情况下。你他妈是怎么找到他们的？"}, {"type": "subtitle", "time": 13635.95, "timestamp": "03:47:15", "text": "对公司而言？"}, {"type": "subtitle", "time": 13643.07, "timestamp": "03:47:23", "text": "是的。像这样的人才"}, {"type": "subtitle", "time": 13647.83, "timestamp": "03:47:27", "text": "呃，是伊丽莎白，对吧？伊丽莎白喜欢"}, {"type": "subtitle", "time": 13648.86, "timestamp": "03:47:28", "text": "玫瑰"}, {"type": "subtitle", "time": 13651.83, "timestamp": "03:47:31", "text": "[音乐]"}, {"type": "subtitle", "time": 13655.91, "timestamp": "03:47:35", "text": "是的。我喜欢叫她赫伯。草本植物"}, {"type": "subtitle", "time": 13658.07, "timestamp": "03:47:38", "text": "她说的很有道理，她生活在霍尔的生活中。"}, {"type": "subtitle", "time": 13660.469, "timestamp": "03:47:40", "text": "因为她很有才华。她确实喜欢"}, {"type": "subtitle", "time": 13662.389, "timestamp": "03:47:42", "text": "她的内容简直就是为……量身打造的"}, {"type": "subtitle", "time": 13665.59, "timestamp": "03:47:45", "text": "霍尔生活。是的。所以她当时在霍尔莱夫"}, {"type": "subtitle", "time": 13668.309, "timestamp": "03:47:48", "text": "完全合理。但像这样的人"}, {"type": "subtitle", "time": 13672.15, "timestamp": "03:47:52", "text": "例如 Bibu M"}, {"type": "subtitle", "time": 13676.429, "timestamp": "03:47:56", "text": "当你想到她的时候"}, {"type": "subtitle", "time": 13679.51, "timestamp": "03:47:59", "text": "那个负责招募的人是怎么做到的？"}]
[{"type": "subtitle", "time": 12424.469, "timestamp": "03:27:04", "text": "我心想，这种情况在每个粉丝群体里都存在，但是"}, {"type": "subtitle", "time": 12426.389, "timestamp": "03:27:06", "text": "印度球迷会做一件事，那就是"}, {"type": "subtitle", "time": 12429.99, "timestamp": "03:27:09", "text": "超级烦人，我真是恨死它了。"}, {"type": "subtitle", "time": 12432.07, "timestamp": "03:27:12", "text": "他们会降低动画的趣味性，然后……"}, {"type": "subtitle", "time": 12435.349, "timestamp": "03:27:15", "text": "装作它是高级版本。"}, {"type": "subtitle", "time": 12437.19, "timestamp": "03:27:17", "text": "是的，"}, {"type": "subtitle", "time": 12441.11, "timestamp": "03:27:21", "text": "就像《进击的巨人》的印地语配音版一样。"}, {"type": "subtitle", "time": 12443.11, "timestamp": "03:27:23", "text": "我不知道为什么人们不这样想"}, {"type": "subtitle", "time": 12445.71, "timestamp": "03:27:25", "text": "像动漫，不是《进击的巨人》，而是像《进击的巨人》那样的。"}, {"type": "subtitle", "time": 12448.309, "timestamp": "03:27:28", "text": "我不想看的动漫，因为"}, {"type": "subtitle", "time": 12449.79, "timestamp": "03:27:29", "text": "他们把这些放进去"}, {"type": "subtitle", "time": 12451.91, "timestamp": "03:27:31", "text": "引用类似的话，它们的作用相同"}, {"type": "subtitle", "time": 12453.91, "timestamp": "03:27:33", "text": "就像漫威电影那样，你知道的，就像"}, {"type": "subtitle", "time": 12456.55, "timestamp": "03:27:36", "text": "当他们为漫威电影配音时，他们会"}, {"type": "subtitle", "time": 12463.75, "timestamp": "03:27:43", "text": "就像一个很好的例子，就像我一样"}, {"type": "subtitle", "time": 12468.79, "timestamp": "03:27:48", "text": "观看比赛的最后阶段，我想……"}, {"type": "subtitle", "time": 12471.11, "timestamp": "03:27:51", "text": "雷神托尔被唤醒了"}, {"type": "subtitle", "time": 12475.71, "timestamp": "03:27:55", "text": "正确的。索尔被外星人唤醒了"}]
[{"type": "subtitle", "time": 1262.07, "timestamp": "00:21:02", "text": "我有一些非常有趣的想法。"}, {"type": "subtitle", "time": 1264.87, "timestamp": "00:21:04", "text": "愿意听听。”五天后，"}, {"type": "subtitle", "time": 1266.11, "timestamp": "00:21:06", "text": "他们走了。我当时就想，"}, {"type": "subtitle", "time": 1269.669, "timestamp": "00:21:09", "text": "“嗯？你要去哪儿？别走。”"}, {"type": "subtitle", "time": 1280.87, "timestamp": "00:21:20", "text": "或许它们会以新的……呃……新的形式出现。"}, {"type": "subtitle", "time": 1282.71, "timestamp": "00:21:22", "text": "人。我希望如此。就是这样"}, {"type": "subtitle", "time": 1286.549, "timestamp": "00:21:26", "text": "但愿如此。新的转世。"}, {"type": "subtitle", "time": 1289.35, "timestamp": "00:21:29", "text": "Pippa 不像是一位新晋独立音乐人。"}, {"type": "subtitle", "time": 1292.95, "timestamp": "00:21:32", "text": "然而。我仍然为她感到难过。你知道"}, {"type": "subtitle", "time": 1297.59, "timestamp": "00:21:37", "text": "皮帕？呃，蓝色的皮帕？"}, {"type": "subtitle", "time": 1301.51, "timestamp": "00:21:41", "text": "蓝色佩佩猪。来自 Face Connect 的 Pippa。不，"}, {"type": "subtitle", "time": 1304.39, "timestamp": "00:21:44", "text": "不是另一个皮帕。"}, {"type": "subtitle", "time": 1306.149, "timestamp": "00:21:46", "text": "另一个皮帕也在那里。那里有"}, {"type": "subtitle", "time": 1308.23, "timestamp": "00:21:48", "text": "另一个英国人皮帕。"}, {"type": "subtitle", "time": 1310.87, "timestamp": "00:21:50", "text": "我觉得别人是那样看待我的。我的意思是，我"}]
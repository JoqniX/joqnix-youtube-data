[{"type": "subtitle", "time": 3961.51, "timestamp": "01:06:01", "text": "奥兰治，你愿意做奴隶吗？"}, {"type": "subtitle", "time": 3970.87, "timestamp": "01:06:10", "text": "H 取决于"}, {"type": "subtitle", "time": 3974.15, "timestamp": "01:06:14", "text": "她会对我做什么？"}, {"type": "subtitle", "time": 3976.23, "timestamp": "01:06:16", "text": "还有其他奴隶吗？如果我是"}, {"type": "subtitle", "time": 3980.23, "timestamp": "01:06:20", "text": "如果只有我一个，那我就没事了。是的。"}, {"type": "subtitle", "time": 3982.15, "timestamp": "01:06:22", "text": "然后她可以喜欢我们"}, {"type": "subtitle", "time": 3984.069, "timestamp": "01:06:24", "text": "可以搞出点什么来。但如果她"}, {"type": "subtitle", "time": 3987.029, "timestamp": "01:06:27", "text": "他们会弄来其他奴隶，我绝对不会。"}, {"type": "subtitle", "time": 3989.19, "timestamp": "01:06:29", "text": "不。那么你还要看那些因素。"}, {"type": "subtitle", "time": 3991.589, "timestamp": "01:06:31", "text": "这些奴隶是男性奴隶还是女性奴隶？"}, {"type": "subtitle", "time": 3995.069, "timestamp": "01:06:35", "text": "如果她们全是女性，那我"}, {"type": "subtitle", "time": 4010.63, "timestamp": "01:06:50", "text": "但对于这个问题，我的回答是……"}, {"type": "subtitle", "time": 4015.43, "timestamp": "01:06:55", "text": "就好像我要把星球卖掉一样。"}]
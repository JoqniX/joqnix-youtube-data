[{"type": "subtitle", "time": 10681.429, "timestamp": "02:58:01", "text": "那。我认为拥有如此渊博的知识"}, {"type": "subtitle", "time": 10685.19, "timestamp": "02:58:05", "text": "关于日本之类的"}, {"type": "subtitle", "time": 10688.63, "timestamp": "02:58:08", "text": "就像生命和一切事物一样。"}, {"type": "subtitle", "time": 10689.99, "timestamp": "02:58:09", "text": "我问她：“你拿到了吗？”"}, {"type": "subtitle", "time": 10692.269, "timestamp": "02:58:12", "text": "Nihongo Jou"}, {"type": "subtitle", "time": 10694.63, "timestamp": "02:58:14", "text": "治疗方案？”她怎么说？是的，我"}, {"type": "subtitle", "time": 10699.03, "timestamp": "02:58:19", "text": "做过。我做了。我第一天就这么做了。哦，我的"}, {"type": "subtitle", "time": 10701.99, "timestamp": "02:58:21", "text": "上帝。"}, {"type": "subtitle", "time": 10704.63, "timestamp": "02:58:24", "text": "所以她不在那里学习日语。"}, {"type": "subtitle", "time": 10707.51, "timestamp": "02:58:27", "text": "正确的？是的。是的，她确实这么做了。哦，"}, {"type": "subtitle", "time": 10709.67, "timestamp": "02:58:29", "text": "好的。"}, {"type": "subtitle", "time": 10712.469, "timestamp": "02:58:32", "text": "我问她是不是因为她"}, {"type": "subtitle", "time": 10714.55, "timestamp": "02:58:34", "text": "她很棒。她日语很好。她"}, {"type": "subtitle", "time": 10715.91, "timestamp": "02:58:35", "text": "他不愿意承认这一点，因为……"}, {"type": "subtitle", "time": 10717.83, "timestamp": "02:58:37", "text": "听起来这话很奇怪。但"}, {"type": "subtitle", "time": 10724.309, "timestamp": "02:58:44", "text": "日本人，我们还嘲笑她"}, {"type": "subtitle", "time": 10737.67, "timestamp": "02:58:57", "text": "是"}]
[{"type": "subtitle", "time": 9541.67, "timestamp": "02:39:01", "text": "每个网络上的社会主义者。"}, {"type": "subtitle", "time": 9543.19, "timestamp": "02:39:03", "text": "这就好比是辩论。就像这样"}, {"type": "subtitle", "time": 9545.19, "timestamp": "02:39:05", "text": "就像总统竞选前的辩论一样"}, {"type": "subtitle", "time": 9558.51, "timestamp": "02:39:18", "text": "嗯"}, {"type": "subtitle", "time": 9561.83, "timestamp": "02:39:21", "text": "是谁？我觉得有些"}, {"type": "subtitle", "time": 9563.99, "timestamp": "02:39:23", "text": "YouTuber 她在谈论 Asmin 和"}, {"type": "subtitle", "time": 9565.91, "timestamp": "02:39:25", "text": "她的聊天室里开始有人发言。我"}, {"type": "subtitle", "time": 9567.67, "timestamp": "02:39:27", "text": "现场观看的。她聊天室里的人"}, {"type": "subtitle", "time": 9568.87, "timestamp": "02:39:28", "text": "开始说：“哦，别谈论……”"}, {"type": "subtitle", "time": 9570.03, "timestamp": "02:39:30", "text": "阿斯明。他是"}, {"type": "subtitle", "time": 9572.15, "timestamp": "02:39:32", "text": "有争议的。”她还说，“一个秃头"}, {"type": "subtitle", "time": 9574.469, "timestamp": "02:39:34", "text": "这家伙很有争议。“我真是服了。”"}, {"type": "subtitle", "time": 9582.469, "timestamp": "02:39:42", "text": "天哪！不，因为她说的。"}, {"type": "subtitle", "time": 9584.309, "timestamp": "02:39:44", "text": "讽刺地。"}, {"type": "subtitle", "time": 9586.87, "timestamp": "02:39:46", "text": "就像历史上一样，每个秃头男人都……"}, {"type": "subtitle", "time": 9589.59, "timestamp": "02:39:49", "text": "邪恶的那个人。这就像一个秃头男人的"}, {"type": "subtitle", "time": 9598.63, "timestamp": "02:39:58", "text": "[音乐]"}]
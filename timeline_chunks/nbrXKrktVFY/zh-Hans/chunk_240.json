[{"type": "subtitle", "time": 14400.229, "timestamp": "04:00:00", "text": "4chan，我的天啊，评论区简直……"}, {"type": "subtitle", "time": 14407.189, "timestamp": "04:00:07", "text": "我以前觉得人们很刻薄，但后来发现"}, {"type": "subtitle", "time": 14411.269, "timestamp": "04:00:11", "text": "很多人讨厌印度人。"}, {"type": "subtitle", "time": 14418.469, "timestamp": "04:00:18", "text": "所以，我也算是得到了我应得的那份……"}, {"type": "subtitle", "time": 14423.67, "timestamp": "04:00:23", "text": "你觉得4chan上的东西怎么样？"}, {"type": "subtitle", "time": 14425.349, "timestamp": "04:00:25", "text": "嗯。"}, {"type": "subtitle", "time": 14427.59, "timestamp": "04:00:27", "text": "但我从未像他们那样看待他们。"}, {"type": "subtitle", "time": 14430.389, "timestamp": "04:00:30", "text": "就像他们那样，意思是那些"}, {"type": "subtitle", "time": 14431.75, "timestamp": "04:00:31", "text": "他们只是在说一些类似这样的话"}, {"type": "subtitle", "time": 14433.269, "timestamp": "04:00:33", "text": "他们知道这件事会得到"}, {"type": "subtitle", "time": 14438.15, "timestamp": "04:00:38", "text": "这就像一个恶霸试图欺负你一样。"}, {"type": "subtitle", "time": 14439.83, "timestamp": "04:00:39", "text": "如果你不采取行动，你就得不到结果。"}, {"type": "subtitle", "time": 14442.229, "timestamp": "04:00:42", "text": "就像你一样，他好像拥有某种权力"}, {"type": "subtitle", "time": 14450.99, "timestamp": "04:00:50", "text": "就像我我我我不"}, {"type": "subtitle", "time": 14453.75, "timestamp": "04:00:53", "text": "知道。我不知道这他妈到底在哪儿。"}, {"type": "subtitle", "time": 14455.83, "timestamp": "04:00:55", "text": "我读过吗？但我好像在某个地方读到过类似的东西。"}, {"type": "subtitle", "time": 14458.15, "timestamp": "04:00:58", "text": "等等，呃，人们在打架。"}]
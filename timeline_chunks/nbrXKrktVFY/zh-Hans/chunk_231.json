[{"type": "subtitle", "time": 13861.59, "timestamp": "03:51:01", "text": "真的。或者可可，取决于你的"}, {"type": "subtitle", "time": 13868.07, "timestamp": "03:51:08", "text": "可可感觉自己被背叛了。露西亚感觉"}, {"type": "subtitle", "time": 13870.349, "timestamp": "03:51:10", "text": "就像一辆车"}, {"type": "subtitle", "time": 13873.67, "timestamp": "03:51:13", "text": "碰撞。是的。"}, {"type": "subtitle", "time": 13877.269, "timestamp": "03:51:17", "text": "我当时都在他们身边。哦，不。"}, {"type": "subtitle", "time": 13880.229, "timestamp": "03:51:20", "text": "肯定很艰难，因为我也经历过。"}, {"type": "subtitle", "time": 13881.75, "timestamp": "03:51:21", "text": "很多。"}, {"type": "subtitle", "time": 13884.71, "timestamp": "03:51:24", "text": "我的天啊。我当时就在那里，亲眼目睹了中国人"}, {"type": "subtitle", "time": 13886.229, "timestamp": "03:51:26", "text": "遭到攻击。"}, {"type": "subtitle", "time": 13889.75, "timestamp": "03:51:29", "text": "我的天啊。我当时也在聊天室里。"}, {"type": "subtitle", "time": 13897.91, "timestamp": "03:51:37", "text": "体验这些生活真有趣。"}, {"type": "subtitle", "time": 13899.99, "timestamp": "03:51:39", "text": "经历，然后思考"}, {"type": "subtitle", "time": 13902.389, "timestamp": "03:51:42", "text": "他们长大后，就像……"}, {"type": "subtitle", "time": 13904.71, "timestamp": "03:51:44", "text": "神圣的坠落，我不知道我身处其中"}, {"type": "subtitle", "time": 13912.99, "timestamp": "03:51:52", "text": "我记得当时参加过类似的活动"}, {"type": "subtitle", "time": 13918.79, "timestamp": "03:51:58", "text": "呃，Mio直播，我想是Miko Miko直播"}]
[{"type": "subtitle", "time": 14700.15, "timestamp": "04:05:00", "text": "所以，开始感觉他好像……"}, {"type": "subtitle", "time": 14702.269, "timestamp": "04:05:02", "text": "嘲讽别人"}, {"type": "subtitle", "time": 14705.03, "timestamp": "04:05:05", "text": "例如，在为他们编写脚本时。"}, {"type": "subtitle", "time": 14713.83, "timestamp": "04:05:13", "text": "就像编写直播脚本一样"}, {"type": "subtitle", "time": 14717.189, "timestamp": "04:05:17", "text": "或者别的什么。是的。编写游戏脚本"}, {"type": "subtitle", "time": 14719.429, "timestamp": "04:05:19", "text": "比如说"}, {"type": "subtitle", "time": 14720.95, "timestamp": "04:05:20", "text": "你玩了这款游戏，然后你"}, {"type": "subtitle", "time": 14723.83, "timestamp": "04:05:23", "text": "好吧，我玩了游戏，现在我是"}, {"type": "subtitle", "time": 14726.229, "timestamp": "04:05:26", "text": "我要写下我如何……的剧本"}, {"type": "subtitle", "time": 14734.63, "timestamp": "04:05:34", "text": "脚本化的脚本反应，有点……"}, {"type": "subtitle", "time": 14737.469, "timestamp": "04:05:37", "text": "想想更好的表达方式"}, {"type": "subtitle", "time": 14740.15, "timestamp": "04:05:40", "text": "就像他以前那样，就像他制作的时候一样。"}, {"type": "subtitle", "time": 14742.63, "timestamp": "04:05:42", "text": "他会通过视频了解某人的情况。"}, {"type": "subtitle", "time": 14744.63, "timestamp": "04:05:44", "text": "然后开始谈论它们"}, {"type": "subtitle", "time": 14745.91, "timestamp": "04:05:45", "text": "然后就像"}, {"type": "subtitle", "time": 14747.59, "timestamp": "04:05:47", "text": "解释他对他们的感受，"}, {"type": "subtitle", "time": 14749.67, "timestamp": "04:05:49", "text": "正确的？"}, {"type": "subtitle", "time": 14751.189, "timestamp": "04:05:51", "text": "其中一些元素像是事先写好的剧本。"}, {"type": "subtitle", "time": 14754.469, "timestamp": "04:05:54", "text": "有，但也没那么喜欢。但是后来"}, {"type": "subtitle", "time": 14755.8, "timestamp": "04:05:55", "text": "他太投入了。"}]
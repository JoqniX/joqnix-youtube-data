[{"type": "subtitle", "time": 11589.11, "timestamp": "03:13:09", "text": "是的。还有，你有没有看过这个？"}, {"type": "subtitle", "time": 11592.429, "timestamp": "03:13:12", "text": "开玩笑？是的。很多理发师都有"}, {"type": "subtitle", "time": 11596.15, "timestamp": "03:13:16", "text": "将剪发业务商业化。"}, {"type": "subtitle", "time": 11598.07, "timestamp": "03:13:18", "text": "商业的？哦，等等。呃，因为"}, {"type": "subtitle", "time": 11601.67, "timestamp": "03:13:21", "text": "他们得到的无线电指南"}, {"type": "subtitle", "time": 11603.55, "timestamp": "03:13:23", "text": "有薪酬的。"}, {"type": "subtitle", "time": 11607.349, "timestamp": "03:13:27", "text": "是的。就像我见过的那些工作的人一样"}, {"type": "subtitle", "time": 11609.55, "timestamp": "03:13:29", "text": "不是"}, {"type": "subtitle", "time": 11611.99, "timestamp": "03:13:31", "text": "剪裁。就像以前一样，只有粉丝。"}, {"type": "subtitle", "time": 11614.469, "timestamp": "03:13:34", "text": "完全出于对……的热爱。"}, {"type": "subtitle", "time": 11616.71, "timestamp": "03:13:36", "text": "他们的推。"}, {"type": "subtitle", "time": 11619.349, "timestamp": "03:13:39", "text": "大部分还是那样，但现在我"}, {"type": "subtitle", "time": 11621.19, "timestamp": "03:13:41", "text": "见过一些不看电视的人"}, {"type": "subtitle", "time": 11625.75, "timestamp": "03:13:45", "text": "关心 YouTuber 的视频剪辑。"}, {"type": "subtitle", "time": 11628.229, "timestamp": "03:13:48", "text": "呃，等等。所以，空心人付钱给他们，或者类似"}, {"type": "subtitle", "time": 11630.389, "timestamp": "03:13:50", "text": "YouTube频道广告收入或"}, {"type": "subtitle", "time": 11632.07, "timestamp": "03:13:52", "text": "某物？不，其他 YouTube 频道"}, {"type": "subtitle", "time": 11634.229, "timestamp": "03:13:54", "text": "其全部目的就是剪辑 YouTuber"}, {"type": "subtitle", "time": 11636.8, "timestamp": "03:13:56", "text": "并从中赚钱。"}, {"type": "subtitle", "time": 11638.429, "timestamp": "03:13:58", "text": "[音乐]"}]
[{"type": "subtitle", "time": 7200.55, "timestamp": "02:00:00", "text": "人们喜欢当人们指着某物时。"}, {"type": "subtitle", "time": 7203.75, "timestamp": "02:00:03", "text": "她听到她的口音就生气了。"}, {"type": "subtitle", "time": 7210.149, "timestamp": "02:00:10", "text": "生气是因为口音越来越重"}, {"type": "subtitle", "time": 7217.99, "timestamp": "02:00:17", "text": "是的。"}, {"type": "subtitle", "time": 7220.07, "timestamp": "02:00:20", "text": "就像有人指出的那样，我也有同感。"}, {"type": "subtitle", "time": 7222.95, "timestamp": "02:00:22", "text": "我之前在聊天中也提到过这一点，就像我这样"}, {"type": "subtitle", "time": 7224.229, "timestamp": "02:00:24", "text": "正在通话中。我有口音。"}, {"type": "subtitle", "time": 7226.31, "timestamp": "02:00:26", "text": "现在。"}, {"type": "subtitle", "time": 7228.31, "timestamp": "02:00:28", "text": "我平时说话不这样，但是"}, {"type": "subtitle", "time": 7229.75, "timestamp": "02:00:29", "text": "在交谈时感到自在"}, {"type": "subtitle", "time": 7233.83, "timestamp": "02:00:33", "text": "英语听起来像这种口音"}, {"type": "subtitle", "time": 7237.189, "timestamp": "02:00:37", "text": "我喜欢用重音符号，它们能帮到你。"}, {"type": "subtitle", "time": 7241.75, "timestamp": "02:00:41", "text": "进入某个领域，比如说"}, {"type": "subtitle", "time": 7243.589, "timestamp": "02:00:43", "text": "例如，如果你想与……互动"}, {"type": "subtitle", "time": 7247.189, "timestamp": "02:00:47", "text": "某些人的口音有助于表达某种意思。"}, {"type": "subtitle", "time": 7248.87, "timestamp": "02:00:48", "text": "事物"}, {"type": "subtitle", "time": 7252.55, "timestamp": "02:00:52", "text": "啊，就像日语有口音一样。"}, {"type": "subtitle", "time": 7255.31, "timestamp": "02:00:55", "text": "比如，如果你想说一句话的话"}, {"type": "subtitle", "time": 7258.629, "timestamp": "02:00:58", "text": "如果你学日语，那就更容易了。"}]
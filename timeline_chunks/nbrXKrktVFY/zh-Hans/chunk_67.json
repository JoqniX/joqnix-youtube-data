[{"type": "subtitle", "time": 4020.15, "timestamp": "01:07:00", "text": "行星。是的，我会出售星球。"}, {"type": "subtitle", "time": 4023.589, "timestamp": "01:07:03", "text": "行星作为一颗行星。行星空间。是的，"}, {"type": "subtitle", "time": 4025.589, "timestamp": "01:07:05", "text": "就像那个圆圆的小球。这"}, {"type": "subtitle", "time": 4028.75, "timestamp": "01:07:08", "text": "天空中的圆球。"}, {"type": "subtitle", "time": 4032.95, "timestamp": "01:07:12", "text": "哇。但为此你需要像……一样"}, {"type": "subtitle", "time": 4035.27, "timestamp": "01:07:15", "text": "如何才能把这颗星球提取出来？"}, {"type": "subtitle", "time": 4038.069, "timestamp": "01:07:18", "text": "然后卖掉它？那是他们的问题。谁的"}, {"type": "subtitle", "time": 4044.95, "timestamp": "01:07:24", "text": "但现在看来，那可是一大笔钱啊。哦，我的"}, {"type": "subtitle", "time": 4046.95, "timestamp": "01:07:26", "text": "上帝。是的。我当时就想，好吧，所以……"}, {"type": "subtitle", "time": 4048.71, "timestamp": "01:07:28", "text": "这是一颗由钻石构成的星球。如何"}, {"type": "subtitle", "time": 4052.63, "timestamp": "01:07:32", "text": "你觉得你能接受多少？"}, {"type": "subtitle", "time": 4054.99, "timestamp": "01:07:34", "text": "哦，那将会是……"}, {"type": "subtitle", "time": 4058.309, "timestamp": "01:07:38", "text": "很多。他们可以想象，想象一下……"}, {"type": "subtitle", "time": 4060.15, "timestamp": "01:07:40", "text": "有很多钱，运动员"}, {"type": "subtitle", "time": 4063.51, "timestamp": "01:07:43", "text": "宇宙。无穷大零。已经过去了。"}, {"type": "subtitle", "time": 4066.43, "timestamp": "01:07:46", "text": "那后面有很多个零。哦，我的"}, {"type": "subtitle", "time": 4069.19, "timestamp": "01:07:49", "text": "上帝。点赞，我就能垄断它。"}, {"type": "subtitle", "time": 4077.029, "timestamp": "01:07:57", "text": "所以艾伦，如果你想去火星，你"}, {"type": "subtitle", "time": 4079.349, "timestamp": "01:07:59", "text": "必须经过我。"}]
[{"type": "subtitle", "time": 11220.15, "timestamp": "03:07:00", "text": "[音乐]"}, {"type": "subtitle", "time": 11221.83, "timestamp": "03:07:01", "text": "所以，我一直在扮演这个角色。"}, {"type": "subtitle", "time": 11230.55, "timestamp": "03:07:10", "text": "乱伦，因为我支持……呃……"}, {"type": "subtitle", "time": 11233.429, "timestamp": "03:07:13", "text": "故事，以及它的类型。我就像我喜欢"}, {"type": "subtitle", "time": 11235.59, "timestamp": "03:07:15", "text": "人们可以表达的类似"}, {"type": "subtitle", "time": 11238.389, "timestamp": "03:07:18", "text": "就像这个概念一样，"}, {"type": "subtitle", "time": 11241.11, "timestamp": "03:07:21", "text": "正确的？人们可以写出好故事。"}, {"type": "subtitle", "time": 11243.91, "timestamp": "03:07:23", "text": "糟糕的事情。"}, {"type": "subtitle", "time": 11247.349, "timestamp": "03:07:27", "text": "嗯。就像异世界题材作品里那样，也有奴隶制。"}, {"type": "subtitle", "time": 11250.15, "timestamp": "03:07:30", "text": "现实生活中的奴隶制很糟糕，但在异世界里更是如此。"}, {"type": "subtitle", "time": 11257.19, "timestamp": "03:07:37", "text": "现在对我来说，他也在奴役别人，所以他"}, {"type": "subtitle", "time": 11266.71, "timestamp": "03:07:46", "text": "所以这就是为什么我变成了乱伦者"}, {"type": "subtitle", "time": 11269.91, "timestamp": "03:07:49", "text": "那个家伙，这很有趣，因为我喜欢"}, {"type": "subtitle", "time": 11271.23, "timestamp": "03:07:51", "text": "参与其中"}, {"type": "subtitle", "time": 11274.99, "timestamp": "03:07:54", "text": "因为人们会获得性格。"}, {"type": "subtitle", "time": 11278.87, "timestamp": "03:07:58", "text": "我很生气，我有一些人"}]
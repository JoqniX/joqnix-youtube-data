[{"type": "subtitle", "time": 8280.07, "timestamp": "02:18:00", "text": "你可以去参军报名。"}, {"type": "subtitle", "time": 8282.309, "timestamp": "02:18:02", "text": "作为一名军人，他们会派你来。"}, {"type": "subtitle", "time": 8284.309, "timestamp": "02:18:04", "text": "如果他们派你去打仗，你可以去见他们"}, {"type": "subtitle", "time": 8292.309, "timestamp": "02:18:12", "text": "巴基斯坦。这些人真是太蠢了。"}, {"type": "subtitle", "time": 8293.549, "timestamp": "02:18:13", "text": "哦，我的"}, {"type": "subtitle", "time": 8296.549, "timestamp": "02:18:16", "text": "上帝。就像有人说的那样，伙计们，如果"}, {"type": "subtitle", "time": 8298.549, "timestamp": "02:18:18", "text": "我们轰炸你们，请不要恨我们。它是"}, {"type": "subtitle", "time": 8312.709, "timestamp": "02:18:32", "text": "乐趣。最搞笑的是，你能……"}, {"type": "subtitle", "time": 8314.389, "timestamp": "02:18:34", "text": "就像有人问我，有没有人能做一个"}, {"type": "subtitle", "time": 8317.23, "timestamp": "02:18:37", "text": "Discord 频道名为"}, {"type": "subtitle", "time": 8320.549, "timestamp": "02:18:40", "text": "水？比如什么"}, {"type": "subtitle", "time": 8324.07, "timestamp": "02:18:44", "text": "我的天啊。而人们实际上是"}, {"type": "subtitle", "time": 8325.589, "timestamp": "02:18:45", "text": "我做了一个，然后人们就纷纷发送。"}, {"type": "subtitle", "time": 8331.75, "timestamp": "02:18:51", "text": "任何时候，如果有人喜欢一个人，就像"}, {"type": "subtitle", "time": 8334.15, "timestamp": "02:18:54", "text": "加入频道后，我说：“哦，"}, {"type": "subtitle", "time": 8336.15, "timestamp": "02:18:56", "text": "他们来自巴基斯坦。“他们是定时的。”"}, {"type": "subtitle", "time": 8338.429, "timestamp": "02:18:58", "text": "在那"}]
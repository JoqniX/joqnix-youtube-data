[{"type": "subtitle", "time": 9365.67, "timestamp": "02:36:05", "text": "但这种行为会被平台封禁吗？"}, {"type": "subtitle", "time": 9369.349, "timestamp": "02:36:09", "text": "有些平台会封禁你的账号。啊，我想"}, {"type": "subtitle", "time": 9372.07, "timestamp": "02:36:12", "text": "Twitch封禁了某人"}, {"type": "subtitle", "time": 9374.23, "timestamp": "02:36:14", "text": "因为使用了R开头的那个词。这就是我不在的原因"}, {"type": "subtitle", "time": 9381.27, "timestamp": "02:36:21", "text": "不，我说过不要真的说R"}, {"type": "subtitle", "time": 9382.11, "timestamp": "02:36:22", "text": "拉"}, {"type": "subtitle", "time": 9385.03, "timestamp": "02:36:25", "text": "他在直播时听到了一条消息"}, {"type": "subtitle", "time": 9389.429, "timestamp": "02:36:29", "text": "两次。然后我就想，那没关系。"}, {"type": "subtitle", "time": 9392.55, "timestamp": "02:36:32", "text": "一位更大的主播正在这样做。是的，但是"}, {"type": "subtitle", "time": 9394.389, "timestamp": "02:36:34", "text": "我不知道，因为阿斯敏这么说。"}, {"type": "subtitle", "time": 9402.63, "timestamp": "02:36:42", "text": "是的，没错。"}, {"type": "subtitle", "time": 9405.27, "timestamp": "02:36:45", "text": "例如，哈桑说：“就像哈桑一样。”"}, {"type": "subtitle", "time": 9407.71, "timestamp": "02:36:47", "text": "东西"}, {"type": "subtitle", "time": 9414.349, "timestamp": "02:36:54", "text": "合法的"}, {"type": "subtitle", "time": 9419.11, "timestamp": "02:36:59", "text": "把这当成消遣。我当时就想：真见鬼！"}]
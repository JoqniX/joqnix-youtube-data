[{"type": "subtitle", "time": 5820.709, "timestamp": "01:37:00", "text": "他说：“但是，是啊，你他妈的为什么……”"}, {"type": "subtitle", "time": 5822.03, "timestamp": "01:37:02", "text": "有"}, {"type": "subtitle", "time": 5824.149, "timestamp": "01:37:04", "text": "一切？” 我心想，“因为我没有。”"}, {"type": "subtitle", "time": 5826.79, "timestamp": "01:37:06", "text": "喜欢起床后去商店。我"}, {"type": "subtitle", "time": 5834.31, "timestamp": "01:37:14", "text": "我只是在太空里买东西放"}, {"type": "subtitle", "time": 5836.149, "timestamp": "01:37:16", "text": "一切。"}, {"type": "subtitle", "time": 5838.07, "timestamp": "01:37:18", "text": "我这里有空间，就像……"}, {"type": "subtitle", "time": 5839.229, "timestamp": "01:37:19", "text": "整个"}, {"type": "subtitle", "time": 5842.43, "timestamp": "01:37:22", "text": "巨大，就像你知道的，像阿尔马里"}, {"type": "subtitle", "time": 5846.229, "timestamp": "01:37:26", "text": "类似印度衣柜的东西。是的。"}, {"type": "subtitle", "time": 5849.109, "timestamp": "01:37:29", "text": "我用它来装东西。而且还有类似这样的"}, {"type": "subtitle", "time": 5852.35, "timestamp": "01:37:32", "text": "我旁边有个空间"}, {"type": "subtitle", "time": 5859.59, "timestamp": "01:37:39", "text": "因为我喜欢收集东西。我是"}, {"type": "subtitle", "time": 5866.149, "timestamp": "01:37:46", "text": "囤积者。就像我以前拥有的这些一样，我也有这些"}, {"type": "subtitle", "time": 5869.35, "timestamp": "01:37:49", "text": "我收集的瓶盖"}, {"type": "subtitle", "time": 5871.59, "timestamp": "01:37:51", "text": "因为我以前经常喝汽水。"}, {"type": "subtitle", "time": 5874.39, "timestamp": "01:37:54", "text": "现在我不这么认为了。我戒掉汽水之后……"}, {"type": "subtitle", "time": 5877.189, "timestamp": "01:37:57", "text": "开始去健身房是因为汽水"}, {"type": "subtitle", "time": 5879.91, "timestamp": "01:37:59", "text": "如果你去健身房，那就不好，因为……"}]
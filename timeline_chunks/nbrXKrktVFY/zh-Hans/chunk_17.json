[{"type": "subtitle", "time": 1022.55, "timestamp": "00:17:02", "text": "是的。好的。我死了。好的。我们必须得到"}, {"type": "subtitle", "time": 1024.11, "timestamp": "00:17:04", "text": "让他上去。"}, {"type": "subtitle", "time": 1035.39, "timestamp": "00:17:15", "text": "呃，你好。"}, {"type": "subtitle", "time": 1038.949, "timestamp": "00:17:18", "text": "你好。等等，让我看看我的直播情况。"}, {"type": "subtitle", "time": 1046.669, "timestamp": "00:17:26", "text": "我的"}, {"type": "subtitle", "time": 1055.15, "timestamp": "00:17:35", "text": "你。等等，我搞错了"}, {"type": "subtitle", "time": 1056.669, "timestamp": "00:17:36", "text": "fugie。"}, {"type": "subtitle", "time": 1060.39, "timestamp": "00:17:40", "text": "繁荣。等等，等等，让我换一下衣服。"}, {"type": "subtitle", "time": 1064.789, "timestamp": "00:17:44", "text": "太可爱了。这"}, {"type": "subtitle", "time": 1069.31, "timestamp": "00:17:49", "text": "你知道这个典故吗？"}, {"type": "subtitle", "time": 1072.87, "timestamp": "00:17:52", "text": "呃，我感觉我好像在哪儿见过这个。"}, {"type": "subtitle", "time": 1077.43, "timestamp": "00:17:57", "text": "一些动漫。哦，他不知道，聊天吧。"}]
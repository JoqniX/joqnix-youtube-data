[{"type": "subtitle", "time": 6480.709, "timestamp": "01:48:00", "text": "我好像不太理解这个概念。"}, {"type": "subtitle", "time": 6482.709, "timestamp": "01:48:02", "text": "是的，我知道YouTube，我从没想过"}, {"type": "subtitle", "time": 6487.43, "timestamp": "01:48:07", "text": "你可以让你的表情像呃，或者表现得像嗯。"}, {"type": "subtitle", "time": 6490.43, "timestamp": "01:48:10", "text": "就像做你自己，而你从未如此。"}, {"type": "subtitle", "time": 6493.75, "timestamp": "01:48:13", "text": "向他人展示你完全"}, {"type": "subtitle", "time": 6496.31, "timestamp": "01:48:16", "text": "与那次经历截然不同"}, {"type": "subtitle", "time": 6501.03, "timestamp": "01:48:21", "text": "像橙子这种东西，对你来说很特别。"}, {"type": "subtitle", "time": 6503.109, "timestamp": "01:48:23", "text": "一切都像是最好的方式"}, {"type": "subtitle", "time": 6504.629, "timestamp": "01:48:24", "text": "描述一下，就像和你说话一样。"}, {"type": "subtitle", "time": 6507.27, "timestamp": "01:48:27", "text": "和父母交谈还是和朋友交谈？"}, {"type": "subtitle", "time": 6513.189, "timestamp": "01:48:33", "text": "就像和朋友说话一样，你会说"}, {"type": "subtitle", "time": 6514.669, "timestamp": "01:48:34", "text": "你不应该对你的人说的话"}, {"type": "subtitle", "time": 6516.87, "timestamp": "01:48:36", "text": "你父母不跟你说话"}, {"type": "subtitle", "time": 6519.22, "timestamp": "01:48:39", "text": "像你这样的朋友会和你的父母聊天。"}, {"type": "subtitle", "time": 6520.629, "timestamp": "01:48:40", "text": "[音乐]"}, {"type": "subtitle", "time": 6523.99, "timestamp": "01:48:43", "text": "对我来说，情况就是这样。"}, {"type": "subtitle", "time": 6530.149, "timestamp": "01:48:50", "text": "就像在网上一样，我对待每个人都像对待家人一样。"}, {"type": "subtitle", "time": 6531.75, "timestamp": "01:48:51", "text": "因为我以前经常和奶奶说话"}, {"type": "subtitle", "time": 6533.75, "timestamp": "01:48:53", "text": "奶奶喜欢这样，就像我会这样"}, {"type": "subtitle", "time": 6535.47, "timestamp": "01:48:55", "text": "跟她解释一下什么是怪物。"}, {"type": "subtitle", "time": 6539.35, "timestamp": "01:48:59", "text": "女孩，这是什么？这是什么？发生了什么事？"}]
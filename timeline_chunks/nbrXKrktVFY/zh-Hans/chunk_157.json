[{"type": "subtitle", "time": 9421.75, "timestamp": "02:37:01", "text": "他是怎么做到的？就像最近"}, {"type": "subtitle", "time": 9423.67, "timestamp": "02:37:03", "text": "哈桑开始变得像……"}, {"type": "subtitle", "time": 9427.429, "timestamp": "02:37:07", "text": "印度半球。是的。是的。我看到了我的"}, {"type": "subtitle", "time": 9428.95, "timestamp": "02:37:08", "text": "朋友们谈论哈桑就像……"}, {"type": "subtitle", "time": 9430.55, "timestamp": "02:37:10", "text": "印度朋友。我当时就想，为什么……"}, {"type": "subtitle", "time": 9432.469, "timestamp": "02:37:12", "text": "你们到底在说哈桑什么鬼？"}, {"type": "subtitle", "time": 9435.03, "timestamp": "02:37:15", "text": "就好像，哦，你不知道。我就像"}, {"type": "subtitle", "time": 9437.11, "timestamp": "02:37:17", "text": "好吧，我知道得太多了，但是哪个？哪个"}, {"type": "subtitle", "time": 9438.59, "timestamp": "02:37:18", "text": "我不做一部分"}, {"type": "subtitle", "time": 9441.19, "timestamp": "02:37:21", "text": "知道？他说，是啊，所以哈桑是"}, {"type": "subtitle", "time": 9442.95, "timestamp": "02:37:22", "text": "支持巴基斯坦的这项举措"}, {"type": "subtitle", "time": 9445.51, "timestamp": "02:37:25", "text": "然后，他们把印度称为这个，那样。和"}, {"type": "subtitle", "time": 9447.83, "timestamp": "02:37:27", "text": "我就像"}, {"type": "subtitle", "time": 9450.07, "timestamp": "02:37:30", "text": "对我来说，这就像是……我"}, {"type": "subtitle", "time": 9453.99, "timestamp": "02:37:33", "text": "有。我觉得哈桑在做这件事"}, {"type": "subtitle", "time": 9457.59, "timestamp": "02:37:37", "text": "这些都是故意的。是的。我认为"}, {"type": "subtitle", "time": 9461.51, "timestamp": "02:37:41", "text": "他这是在故意激怒别人。"}, {"type": "subtitle", "time": 9463.349, "timestamp": "02:37:43", "text": "因为绝对不可能有人"}, {"type": "subtitle", "time": 9466.55, "timestamp": "02:37:46", "text": "真蠢。"}, {"type": "subtitle", "time": 9469.27, "timestamp": "02:37:49", "text": "他在某些方面还挺聪明的。"}, {"type": "subtitle", "time": 9471.429, "timestamp": "02:37:51", "text": "他在某些方面很笨，而且"}, {"type": "subtitle", "time": 9475.07, "timestamp": "02:37:55", "text": "懂得辩论。是的。"}, {"type": "subtitle", "time": 9477.349, "timestamp": "02:37:57", "text": "正确的。这就是人们关注他的原因吧。"}, {"type": "subtitle", "time": 9479.91, "timestamp": "02:37:59", "text": "因为他很会说话。"}]
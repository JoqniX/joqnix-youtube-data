[{"type": "subtitle", "time": 10143.429, "timestamp": "02:49:03", "text": "我的意思是，语言真是一件美好的东西。"}, {"type": "subtitle", "time": 10145.91, "timestamp": "02:49:05", "text": "这是。我觉得这份祝福是赐给我的。"}, {"type": "subtitle", "time": 10148.11, "timestamp": "02:49:08", "text": "正在通过以下方式学习英语"}, {"type": "subtitle", "time": 10150.63, "timestamp": "02:49:10", "text": "犯了个错误，因为我不知道它有多有用"}, {"type": "subtitle", "time": 10161.51, "timestamp": "02:49:21", "text": "因为我小时候，我的父母……"}, {"type": "subtitle", "time": 10165.349, "timestamp": "02:49:25", "text": "就是那种卫星电视，对吧？是的。和"}, {"type": "subtitle", "time": 10167.03, "timestamp": "02:49:27", "text": "就是那个卫星电视装置。我不知道那是什么"}, {"type": "subtitle", "time": 10170.71, "timestamp": "02:49:30", "text": "它有问题。是不是和它有关？每一个"}, {"type": "subtitle", "time": 10173.99, "timestamp": "02:49:33", "text": "动画片是英文的。"}, {"type": "subtitle", "time": 10175.429, "timestamp": "02:49:35", "text": "有印地语选项，但我没选。"}, {"type": "subtitle", "time": 10176.79, "timestamp": "02:49:36", "text": "你知道你可以按下一个按钮，它会"}, {"type": "subtitle", "time": 10179.51, "timestamp": "02:49:39", "text": "翻译成印地语。"}, {"type": "subtitle", "time": 10181.83, "timestamp": "02:49:41", "text": "所以我就看奥斯沃德和鲍勃"}, {"type": "subtitle", "time": 10183.15, "timestamp": "02:49:43", "text": "建筑商，"}, {"type": "subtitle", "time": 10186.23, "timestamp": "02:49:46", "text": "还有很多英文动画片"}, {"type": "subtitle", "time": 10189.03, "timestamp": "02:49:49", "text": "就像教我基本词汇一样"}, {"type": "subtitle", "time": 10190.87, "timestamp": "02:49:50", "text": "我得以运用这些基本词汇。"}, {"type": "subtitle", "time": 10195.51, "timestamp": "02:49:55", "text": "在线与其他人互动。嗯。"}]
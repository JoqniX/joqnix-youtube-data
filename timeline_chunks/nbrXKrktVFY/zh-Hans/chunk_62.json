[{"type": "subtitle", "time": 3723.75, "timestamp": "01:02:03", "text": "啊。我的天啊。"}, {"type": "subtitle", "time": 3725.43, "timestamp": "01:02:05", "text": "这就是为什么我的聊天就像……"}, {"type": "subtitle", "time": 3726.87, "timestamp": "01:02:06", "text": "我刚问完问题，我的聊天记录就出现了。"}, {"type": "subtitle", "time": 3728.95, "timestamp": "01:02:08", "text": "人们开始尖叫。我会卖"}, {"type": "subtitle", "time": 3730.47, "timestamp": "01:02:10", "text": "人们。"}, {"type": "subtitle", "time": 3733.19, "timestamp": "01:02:13", "text": "查德，你不能把人卖掉，因为……"}, {"type": "subtitle", "time": 3734.63, "timestamp": "01:02:14", "text": "你一卖掉它们，它们就会跑"}, {"type": "subtitle", "time": 3737.43, "timestamp": "01:02:17", "text": "离开。"}, {"type": "subtitle", "time": 3742.069, "timestamp": "01:02:22", "text": "真的。没错。没错。是的。"}, {"type": "subtitle", "time": 3744.63, "timestamp": "01:02:24", "text": "奴隶制是行不通的。"}, {"type": "subtitle", "time": 3747.43, "timestamp": "01:02:27", "text": "是的。如果这个世界拥有魔法力量，"}, {"type": "subtitle", "time": 3749.75, "timestamp": "01:02:29", "text": "你可以施那个咒语或者做点别的什么。"}, {"type": "subtitle", "time": 3752.789, "timestamp": "01:02:32", "text": "奴隶制之类的。我不知道。"}, {"type": "subtitle", "time": 3757.19, "timestamp": "01:02:37", "text": "Jo，你赞成坐着吗？"}, {"type": "subtitle", "time": 3761.03, "timestamp": "01:02:41", "text": "康多纳斯。公寓在呃做什么"}, {"type": "subtitle", "time": 3764.95, "timestamp": "01:02:44", "text": "你支持奴隶制吗？不，情况很糟糕。"}, {"type": "subtitle", "time": 3766.95, "timestamp": "01:02:46", "text": "为什么？"}]
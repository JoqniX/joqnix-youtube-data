[{"type": "subtitle", "time": 10327.269, "timestamp": "02:52:07", "text": "就像我在炫耀肌肉一样。我的"}, {"type": "subtitle", "time": 10330.35, "timestamp": "02:52:10", "text": "祖父母辈的人就像亿万富翁一样。"}, {"type": "subtitle", "time": 10332.23, "timestamp": "02:52:12", "text": "[音乐]"}, {"type": "subtitle", "time": 10334.79, "timestamp": "02:52:14", "text": "我们现在没钱了。所以这样做毫无意义。"}, {"type": "subtitle", "time": 10336.309, "timestamp": "02:52:16", "text": "弯曲。"}, {"type": "subtitle", "time": 10344.07, "timestamp": "02:52:24", "text": "就像我一直喜欢再添一件事一样"}, {"type": "subtitle", "time": 10346.51, "timestamp": "02:52:26", "text": "就像美国人那样"}, {"type": "subtitle", "time": 10350.71, "timestamp": "02:52:30", "text": "例如，我会看到他们做事情，然后我"}, {"type": "subtitle", "time": 10360.55, "timestamp": "02:52:40", "text": "那就像你这运动健将怎么了？"}, {"type": "subtitle", "time": 10362.55, "timestamp": "02:52:42", "text": "像18岁时那样生活"}, {"type": "subtitle", "time": 10365.67, "timestamp": "02:52:45", "text": "搬出去住，这个概念是什么意思？"}, {"type": "subtitle", "time": 10367.1, "timestamp": "02:52:47", "text": "也。"}, {"type": "subtitle", "time": 10369.03, "timestamp": "02:52:49", "text": "[音乐]"}, {"type": "subtitle", "time": 10371.75, "timestamp": "02:52:51", "text": "哦，是的。是的。呃，让我把那个给你。"}, {"type": "subtitle", "time": 10374.03, "timestamp": "02:52:54", "text": "洞察力。嗯，是"}, {"type": "subtitle", "time": 10377.91, "timestamp": "02:52:57", "text": "就像一直以来那样，并不是因为我一直住在那里。"}]
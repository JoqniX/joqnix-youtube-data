[{"type": "subtitle", "time": 6423.189, "timestamp": "01:47:03", "text": "现实中的我。嗯。"}, {"type": "subtitle", "time": 6425.51, "timestamp": "01:47:05", "text": "但在网上，我觉得我拥有这种感觉。"}, {"type": "subtitle", "time": 6428.149, "timestamp": "01:47:08", "text": "发生的事情让我感觉就像……"}, {"type": "subtitle", "time": 6431.03, "timestamp": "01:47:11", "text": "全力以赴"}, {"type": "subtitle", "time": 6434.47, "timestamp": "01:47:14", "text": "没有任何感觉。"}, {"type": "subtitle", "time": 6437.229, "timestamp": "01:47:17", "text": "我得好好想想。"}, {"type": "subtitle", "time": 6440.629, "timestamp": "01:47:20", "text": "就像我开始做这件事一样，我"}, {"type": "subtitle", "time": 6442.39, "timestamp": "01:47:22", "text": "感觉自己像在扮演一个角色。每一个"}, {"type": "subtitle", "time": 6444.35, "timestamp": "01:47:24", "text": "我每次进去"}, {"type": "subtitle", "time": 6446.31, "timestamp": "01:47:26", "text": "在外面，我就想，“好吧，我要……”"}, {"type": "subtitle", "time": 6449.35, "timestamp": "01:47:29", "text": "假装自己是橙色的。”网上的橙色是"}, {"type": "subtitle", "time": 6452.47, "timestamp": "01:47:32", "text": "有趣的。他话太多了。我必须"}, {"type": "subtitle", "time": 6453.99, "timestamp": "01:47:33", "text": "像橙色一样行事。千万别这样"}, {"type": "subtitle", "time": 6456.07, "timestamp": "01:47:36", "text": "我。"}, {"type": "subtitle", "time": 6458.07, "timestamp": "01:47:38", "text": "千万别做那种内向的人"}, {"type": "subtitle", "time": 6469.87, "timestamp": "01:47:49", "text": "问题。"}, {"type": "subtitle", "time": 6473.75, "timestamp": "01:47:53", "text": "嗯……比如，你怎么做？"}, {"type": "subtitle", "time": 6476.709, "timestamp": "01:47:56", "text": "多重人格之类的？喜欢"}]
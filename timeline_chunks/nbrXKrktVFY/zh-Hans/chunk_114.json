[{"type": "subtitle", "time": 6842.229, "timestamp": "01:54:02", "text": "因为他们就是怪物。他们"}, {"type": "subtitle", "time": 6843.75, "timestamp": "01:54:03", "text": "她们是怪物娘，因为她们是恶魔"}, {"type": "subtitle", "time": 6846.55, "timestamp": "01:54:06", "text": "领主目前是一辆破烂巴士。以及"}, {"type": "subtitle", "time": 6849.03, "timestamp": "01:54:09", "text": "魅魔是魔王。还有那个恶魔"}, {"type": "subtitle", "time": 6850.95, "timestamp": "01:54:10", "text": "领主掌控着魔力。还有法力，"}, {"type": "subtitle", "time": 6853.91, "timestamp": "01:54:13", "text": "它们关闭的方式改变了那个东西"}, {"type": "subtitle", "time": 6857.35, "timestamp": "01:54:17", "text": "进入那个东西。"}, {"type": "subtitle", "time": 6860.149, "timestamp": "01:54:20", "text": "所以如果某样东西拥有恶魔魔力，它"}, {"type": "subtitle", "time": 6863.35, "timestamp": "01:54:23", "text": "将会变成怪物。而且由于"}, {"type": "subtitle", "time": 6866.189, "timestamp": "01:54:26", "text": "现任魔王是"}, {"type": "subtitle", "time": 6869.83, "timestamp": "01:54:29", "text": "魅魔，它会变成一个"}, {"type": "subtitle", "time": 6872.87, "timestamp": "01:54:32", "text": "怪物女孩。这就是为什么会有这么多怪物的原因。"}, {"type": "subtitle", "time": 6875.03, "timestamp": "01:54:35", "text": "怪物系列里的女孩角色不多。"}, {"type": "subtitle", "time": 6877.75, "timestamp": "01:54:37", "text": "男性。"}, {"type": "subtitle", "time": 6885.31, "timestamp": "01:54:45", "text": "我的意思是，那里有雄性怪物之类的东西。"}, {"type": "subtitle", "time": 6888.47, "timestamp": "01:54:48", "text": "但他们是得到……的女孩，但她们是男孩。"}, {"type": "subtitle", "time": 6892.75, "timestamp": "01:54:52", "text": "他们体内被注入了恶魔魔力，然后他们就变成了恶魔。"}, {"type": "subtitle", "time": 6895.43, "timestamp": "01:54:55", "text": "就像有个怪物女孩一样，"}, {"type": "subtitle", "time": 6897.589, "timestamp": "01:54:57", "text": "是爱丽丝吗？我想我不知道该怎么做。"}, {"type": "subtitle", "time": 6899.91, "timestamp": "01:54:59", "text": "读出我刚才读到的那些名字"}]
[{"type": "subtitle", "time": 8160.149, "timestamp": "02:16:00", "text": "就像我注意到的一件事，每当我"}, {"type": "subtitle", "time": 8162.95, "timestamp": "02:16:02", "text": "恶作剧电话，我注意到就像我"}, {"type": "subtitle", "time": 8164.709, "timestamp": "02:16:04", "text": "首先要确认对方是男的还是女的"}, {"type": "subtitle", "time": 8166.87, "timestamp": "02:16:06", "text": "如果是女孩，她就不会"}, {"type": "subtitle", "time": 8169.109, "timestamp": "02:16:09", "text": "取悦我"}, {"type": "subtitle", "time": 8171.189, "timestamp": "02:16:11", "text": "我已经见过太多次这种情况了"}, {"type": "subtitle", "time": 8173.589, "timestamp": "02:16:13", "text": "如果是女孩，他们就会喜欢。"}, {"type": "subtitle", "time": 8176.31, "timestamp": "02:16:16", "text": "先生，我们不能像她那样开始"}, {"type": "subtitle", "time": 8179.31, "timestamp": "02:16:19", "text": "告诉我这些公司规定"}, {"type": "subtitle", "time": 8189.149, "timestamp": "02:16:29", "text": "所以每当有男生出现的时候，我就会想："}, {"type": "subtitle", "time": 8192.15, "timestamp": "02:16:32", "text": "好吧，我知道我就像我能像他那样幽默。"}, {"type": "subtitle", "time": 8198.87, "timestamp": "02:16:38", "text": "这很有趣"}, {"type": "subtitle", "time": 8207.11, "timestamp": "02:16:47", "text": "现在我只要上Discord点赞就行了"}, {"type": "subtitle", "time": 8209.83, "timestamp": "02:16:49", "text": "在 Discord 上恶作剧打电话"}, {"type": "subtitle", "time": 8212.23, "timestamp": "02:16:52", "text": "不同的ID。"}, {"type": "subtitle", "time": 8213.91, "timestamp": "02:16:53", "text": "等等，怎样才能不打恶作剧电话呢？"}, {"type": "subtitle", "time": 8216.549, "timestamp": "02:16:56", "text": "加他们为好友？不，不，不是"}, {"type": "subtitle", "time": 8218.389, "timestamp": "02:16:58", "text": "恶作剧电话。比如我会去一个随机的地方"}]
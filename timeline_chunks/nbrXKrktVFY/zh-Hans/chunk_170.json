[{"type": "subtitle", "time": 10201.75, "timestamp": "02:50:01", "text": "简直太疯狂了，因为我学会了"}, {"type": "subtitle", "time": 10203.51, "timestamp": "02:50:03", "text": "就像我看到我的朋友们一样，他们就像"}, {"type": "subtitle", "time": 10205.59, "timestamp": "02:50:05", "text": "去上演讲课之类的课"}, {"type": "subtitle", "time": 10207.269, "timestamp": "02:50:07", "text": "我正在学英语，然后我就想，这是谁？"}, {"type": "subtitle", "time": 10210.07, "timestamp": "02:50:10", "text": "操，学英语？"}, {"type": "subtitle", "time": 10212.63, "timestamp": "02:50:12", "text": "你必须学会​​那些东西。"}, {"type": "subtitle", "time": 10215.469, "timestamp": "02:50:15", "text": "我也这么想。"}, {"type": "subtitle", "time": 10218.55, "timestamp": "02:50:18", "text": "为什么要学习口语？不是"}, {"type": "subtitle", "time": 10220.469, "timestamp": "02:50:20", "text": "英语口语。不，和其他类型的"}, {"type": "subtitle", "time": 10223.03, "timestamp": "02:50:23", "text": "英语。不，牛津大学有很多分校。"}, {"type": "subtitle", "time": 10225.75, "timestamp": "02:50:25", "text": "英语或其他任何语言。我当时就想，啊？"}, {"type": "subtitle", "time": 10228.309, "timestamp": "02:50:28", "text": "是的。"}, {"type": "subtitle", "time": 10230.309, "timestamp": "02:50:30", "text": "就像我姐姐一样，她不擅长"}, {"type": "subtitle", "time": 10232.15, "timestamp": "02:50:32", "text": "它。她理解我，但她确实"}, {"type": "subtitle", "time": 10233.75, "timestamp": "02:50:33", "text": "她就像我家里没有一个好人一样。"}, {"type": "subtitle", "time": 10236.23, "timestamp": "02:50:36", "text": "就这么办。就像他们无法说话一样。他们可以"}, {"type": "subtitle", "time": 10242.63, "timestamp": "02:50:42", "text": "她为某些事感到尴尬。"}, {"type": "subtitle", "time": 10245.91, "timestamp": "02:50:45", "text": "原因是她不会说英语。"}, {"type": "subtitle", "time": 10248.79, "timestamp": "02:50:48", "text": "嗯。这让她在朋友面前炫耀了一番。"}, {"type": "subtitle", "time": 10251.03, "timestamp": "02:50:51", "text": "她好像炫耀了一下。就像，"}, {"type": "subtitle", "time": 10253.349, "timestamp": "02:50:53", "text": "“是的，我哥哥会说英语。”"}, {"type": "subtitle", "time": 10256.23, "timestamp": "02:50:56", "text": "非常好。他与外国人交谈"}, {"type": "subtitle", "time": 10258.67, "timestamp": "02:50:58", "text": "用英语。” 我心想，“什么鬼？”"}]
[{"type": "subtitle", "time": 10087.269, "timestamp": "02:48:07", "text": "乌鲁语是我唯一会的语言"}, {"type": "subtitle", "time": 10090.389, "timestamp": "02:48:10", "text": "自信地说话"}, {"type": "subtitle", "time": 10093.55, "timestamp": "02:48:13", "text": "就像一种语言，我"}, {"type": "subtitle", "time": 10096.11, "timestamp": "02:48:16", "text": "就像我能说话一样"}, {"type": "subtitle", "time": 10098.95, "timestamp": "02:48:18", "text": "流利地。我知道我在这方面非常精通。"}, {"type": "subtitle", "time": 10101.19, "timestamp": "02:48:21", "text": "因为我一生都在说这句话"}, {"type": "subtitle", "time": 10105.19, "timestamp": "02:48:25", "text": "童年。嗯。然后就是英语了。"}, {"type": "subtitle", "time": 10107.51, "timestamp": "02:48:27", "text": "如果我想解释什么，我会使用"}, {"type": "subtitle", "time": 10110.469, "timestamp": "02:48:30", "text": "英语，因为我会说英语。"}, {"type": "subtitle", "time": 10113.83, "timestamp": "02:48:33", "text": "学到了很多东西"}, {"type": "subtitle", "time": 10115.59, "timestamp": "02:48:35", "text": "就像任何网络内容一样。我学到"}, {"type": "subtitle", "time": 10117.67, "timestamp": "02:48:37", "text": "任何类似基础技术相关的内容"}, {"type": "subtitle", "time": 10120.07, "timestamp": "02:48:40", "text": "只要是英文的就行。所以是"}, {"type": "subtitle", "time": 10121.91, "timestamp": "02:48:41", "text": "用英语解释事情更容易"}, {"type": "subtitle", "time": 10124.55, "timestamp": "02:48:44", "text": "我。是的。然后就像街头相关的"}, {"type": "subtitle", "time": 10127.03, "timestamp": "02:48:47", "text": "东西是印地语。"}, {"type": "subtitle", "time": 10128.63, "timestamp": "02:48:48", "text": "就像我每次出门聊天的时候一样"}, {"type": "subtitle", "time": 10132.469, "timestamp": "02:48:52", "text": "对人们来说，这是印地语。嗯。然后所有"}, {"type": "subtitle", "time": 10133.91, "timestamp": "02:48:53", "text": "其他方面都和网上一样。"}, {"type": "subtitle", "time": 10135.91, "timestamp": "02:48:55", "text": "人们或者只是喜欢和他们一起玩。"}]
[{"type": "subtitle", "time": 12122.309, "timestamp": "03:22:02", "text": "不在乎 YouTuber"}, {"type": "subtitle", "time": 12125.51, "timestamp": "03:22:05", "text": "针对印度受众，例如投放广告"}, {"type": "subtitle", "time": 12129.11, "timestamp": "03:22:09", "text": "在印度。是的。因为它会得到"}, {"type": "subtitle", "time": 12131.429, "timestamp": "03:22:11", "text": "比如我就是某个 YouTuber 的粉丝，"}, {"type": "subtitle", "time": 12133.269, "timestamp": "03:22:13", "text": "正确的？"}, {"type": "subtitle", "time": 12135.75, "timestamp": "03:22:15", "text": "它不会带来那种人"}, {"type": "subtitle", "time": 12138.55, "timestamp": "03:22:18", "text": "就是我。哦，确实如此。它将带来"}, {"type": "subtitle", "time": 12142.63, "timestamp": "03:22:22", "text": "那些身处这个循环之外的人"}, {"type": "subtitle", "time": 12144.389, "timestamp": "03:22:24", "text": "不了解 YouTube 和"}, {"type": "subtitle", "time": 12146.87, "timestamp": "03:22:26", "text": "一切都是因为有很多"}, {"type": "subtitle", "time": 12149.67, "timestamp": "03:22:29", "text": "印度YouTube粉丝。我见过那些"}, {"type": "subtitle", "time": 12153.03, "timestamp": "03:22:33", "text": "印度 YouTuber 粉丝"}, {"type": "subtitle", "time": 12155.59, "timestamp": "03:22:35", "text": "就像我在生活中看到的那样"}, {"type": "subtitle", "time": 12157.91, "timestamp": "03:22:37", "text": "人们以卢比捐款。我见过"}, {"type": "subtitle", "time": 12162.55, "timestamp": "03:22:42", "text": "人们在Ena的聊天室里聊天。是的。话说"}, {"type": "subtitle", "time": 12164.07, "timestamp": "03:22:44", "text": "一些印度词汇，我就想，嗯"}, {"type": "subtitle", "time": 12170.79, "timestamp": "03:22:50", "text": "我在Pipa的聊天记录里看到过一些人"}, {"type": "subtitle", "time": 12173.87, "timestamp": "03:22:53", "text": "尖叫的印地语。哦，我的"}, {"type": "subtitle", "time": 12177.59, "timestamp": "03:22:57", "text": "上帝。尤其是像Pipa那样做的时候"}, {"type": "subtitle", "time": 12179.83, "timestamp": "03:22:59", "text": "真东西，就像她本人一样。"}]
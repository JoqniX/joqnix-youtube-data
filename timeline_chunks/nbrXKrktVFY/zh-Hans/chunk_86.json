[{"type": "subtitle", "time": 5160.07, "timestamp": "01:26:00", "text": "重点是，你基本上等于不存在。"}, {"type": "subtitle", "time": 5166.31, "timestamp": "01:26:06", "text": "这正是我……的原因之一"}, {"type": "subtitle", "time": 5168.149, "timestamp": "01:26:08", "text": "开始讨厌就像……呃，吃掉……"}, {"type": "subtitle", "time": 5170.31, "timestamp": "01:26:10", "text": "进食过程"}, {"type": "subtitle", "time": 5172.629, "timestamp": "01:26:12", "text": "因为我父母强迫我吃饭"}, {"type": "subtitle", "time": 5174.87, "timestamp": "01:26:14", "text": "我的祖父母强迫我吃饭"}, {"type": "subtitle", "time": 5184.629, "timestamp": "01:26:24", "text": "所以随着时间的推移，我对吃东西感到厌倦了。哦"}, {"type": "subtitle", "time": 5188.07, "timestamp": "01:26:28", "text": "不。如果这样说你能理解的话。是的。现在我"}, {"type": "subtitle", "time": 5191.75, "timestamp": "01:26:31", "text": "只为获取营养而吃。"}, {"type": "subtitle", "time": 5193.91, "timestamp": "01:26:33", "text": "我通常不会特别想吃什么。我只是"}, {"type": "subtitle", "time": 5205.27, "timestamp": "01:26:45", "text": "你有没有特别不喜欢的食物？"}, {"type": "subtitle", "time": 5207.87, "timestamp": "01:26:47", "text": "小时候，我没有"}, {"type": "subtitle", "time": 5211.43, "timestamp": "01:26:51", "text": "不喜欢的。我什么都吃。"}, {"type": "subtitle", "time": 5214.39, "timestamp": "01:26:54", "text": "我们走吧。我也是。我最喜欢的"}, {"type": "subtitle", "time": 5217.27, "timestamp": "01:26:57", "text": "食物是让父母们感到幸福的事情。"}, {"type": "subtitle", "time": 5219.189, "timestamp": "01:26:59", "text": "问题是，他们是否尽到了为人父母的责任？"}]
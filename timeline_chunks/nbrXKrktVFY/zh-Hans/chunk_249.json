[{"type": "subtitle", "time": 14941.349, "timestamp": "04:09:01", "text": "YouTube 和英语印度人"}, {"type": "subtitle", "time": 14944.75, "timestamp": "04:09:04", "text": "对吧，YouTube用户？是的。"}, {"type": "subtitle", "time": 14946.349, "timestamp": "04:09:06", "text": "所以"}, {"type": "subtitle", "time": 14950.55, "timestamp": "04:09:10", "text": "是啊，我希望发生点什么。是我"}, {"type": "subtitle", "time": 14952.469, "timestamp": "04:09:12", "text": "别以为这是语言障碍。我"}, {"type": "subtitle", "time": 14953.75, "timestamp": "04:09:13", "text": "我不愿相信它是一种语言。"}, {"type": "subtitle", "time": 14956.309, "timestamp": "04:09:16", "text": "障碍仅仅是因为"}, {"type": "subtitle", "time": 14958.95, "timestamp": "04:09:18", "text": "有一些印度 YouTuber 制作"}, {"type": "subtitle", "time": 14961.189, "timestamp": "04:09:21", "text": "英文视频，人人平等。"}, {"type": "subtitle", "time": 14969.99, "timestamp": "04:09:29", "text": "正确的。嗯。所以我并不相信"}, {"type": "subtitle", "time": 14971.75, "timestamp": "04:09:31", "text": "我不太愿意相信这是真的"}, {"type": "subtitle", "time": 14974.79, "timestamp": "04:09:34", "text": "语言障碍思维，因为印度"}, {"type": "subtitle", "time": 14978.229, "timestamp": "04:09:38", "text": "它包含多种语言。很多。是的。一个"}, {"type": "subtitle", "time": 14982.389, "timestamp": "04:09:42", "text": "很多。所以，我们没问题，可以说话。"}, {"type": "subtitle", "time": 14985.83, "timestamp": "04:09:45", "text": "别说我们现在的情况了，呃，做什么"}, {"type": "subtitle", "time": 14987.429, "timestamp": "04:09:47", "text": "你把它称为当地语言，因为"}, {"type": "subtitle", "time": 14989.99, "timestamp": "04:09:49", "text": "我们知道，如果你只是想搬到这里，那没问题。"}, {"type": "subtitle", "time": 14991.75, "timestamp": "04:09:51", "text": "然后那种语言就是整个本地语言"}]
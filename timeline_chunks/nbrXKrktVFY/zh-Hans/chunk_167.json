[{"type": "subtitle", "time": 10022.95, "timestamp": "02:47:02", "text": "嗯，是的。比如，如果我要……"}, {"type": "subtitle", "time": 10024.389, "timestamp": "02:47:04", "text": "学习另一门语言，可能会……"}, {"type": "subtitle", "time": 10026.429, "timestamp": "02:47:06", "text": "成为日本人，那将是"}, {"type": "subtitle", "time": 10030.83, "timestamp": "02:47:10", "text": "我喜欢什么？第五门语言，第四门。"}, {"type": "subtitle", "time": 10033.75, "timestamp": "02:47:13", "text": "啊，你一共会说多少种语言？"}, {"type": "subtitle", "time": 10036.95, "timestamp": "02:47:16", "text": "知道？我懂乌都语、印地语，还有一点"}, {"type": "subtitle", "time": 10041.15, "timestamp": "02:47:21", "text": "孟加拉。感谢朋友们。"}, {"type": "subtitle", "time": 10045.269, "timestamp": "02:47:25", "text": "呃，印地语、乌杜语、孟加拉语、英语。"}, {"type": "subtitle", "time": 10048.07, "timestamp": "02:47:28", "text": "我懂一点日语，就只会一点点。"}, {"type": "subtitle", "time": 10054.15, "timestamp": "02:47:34", "text": "就像你知道的，Lewix 的那个东西"}, {"type": "subtitle", "time": 10057.99, "timestamp": "02:47:37", "text": "就像从头到尾一样。哦，是的。我看了"}, {"type": "subtitle", "time": 10059.83, "timestamp": "02:47:39", "text": "所有的一切，我都知道他何时何地做了什么。"}, {"type": "subtitle", "time": 10061.309, "timestamp": "02:47:41", "text": "刚才说了些什么"}, {"type": "subtitle", "time": 10065.34, "timestamp": "02:47:45", "text": "错误的。所以，我比……更好"}, {"type": "subtitle", "time": 10067.23, "timestamp": "02:47:47", "text": "[音乐]"}, {"type": "subtitle", "time": 10070.11, "timestamp": "02:47:50", "text": "莱维格和"}, {"type": "subtitle", "time": 10073.99, "timestamp": "02:47:53", "text": "呃，我想我懂一点德语，就一点点。"}, {"type": "subtitle", "time": 10075.67, "timestamp": "02:47:55", "text": "少量。"}, {"type": "subtitle", "time": 10077.99, "timestamp": "02:47:57", "text": "那一共有多少个呢？"}]
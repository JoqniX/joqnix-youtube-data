[{"type": "subtitle", "time": 5941.59, "timestamp": "01:39:01", "text": "所以当我发现人们讨厌"}, {"type": "subtitle", "time": 5945.47, "timestamp": "01:39:05", "text": "蟑螂，我心想，它们到底怎么了？"}, {"type": "subtitle", "time": 5949.43, "timestamp": "01:39:09", "text": "你？就像我的例子和我一样。它是"}, {"type": "subtitle", "time": 5953.59, "timestamp": "01:39:13", "text": "就像有些人讨厌小狗一样。"}, {"type": "subtitle", "time": 5957.59, "timestamp": "01:39:17", "text": "你为什么会讨厌小狗呢？"}, {"type": "subtitle", "time": 5958.95, "timestamp": "01:39:18", "text": "这就是我的理由"}, {"type": "subtitle", "time": 5961.03, "timestamp": "01:39:21", "text": "蟑螂，因为蟑螂，相信"}, {"type": "subtitle", "time": 5963.99, "timestamp": "01:39:23", "text": "不管怎样，它们真的很干净。"}, {"type": "subtitle", "time": 5966.31, "timestamp": "01:39:26", "text": "他们之所以脏，是因为他们去了"}, {"type": "subtitle", "time": 5968.709, "timestamp": "01:39:28", "text": "脏乱的地方。"}, {"type": "subtitle", "time": 5971.35, "timestamp": "01:39:31", "text": "嗯。"}, {"type": "subtitle", "time": 5973.35, "timestamp": "01:39:33", "text": "就像蟑螂一样，它们可以"}, {"type": "subtitle", "time": 5975.229, "timestamp": "01:39:35", "text": "在核灾难中幸存下来"}, {"type": "subtitle", "time": 5978.149, "timestamp": "01:39:38", "text": "像炸弹一样的东西。感觉好像有很多……"}, {"type": "subtitle", "time": 5980.95, "timestamp": "01:39:40", "text": "它们有很多很酷的地方。"}, {"type": "subtitle", "time": 5983.35, "timestamp": "01:39:43", "text": "我不知道蟑螂也能……"}, {"type": "subtitle", "time": 5986.07, "timestamp": "01:39:46", "text": "除非我能在核战争中幸存下来，否则我将无法生存下去。"}, {"type": "subtitle", "time": 5989.43, "timestamp": "01:39:49", "text": "感觉像《辐射》系列。"}, {"type": "subtitle", "time": 5991.189, "timestamp": "01:39:51", "text": "是的。"}, {"type": "subtitle", "time": 5993.629, "timestamp": "01:39:53", "text": "我当时就想，等等，为什么会有只公鸡？"}, {"type": "subtitle", "time": 5996.229, "timestamp": "01:39:56", "text": "然后？我想我当时在看YouTube视频。"}, {"type": "subtitle", "time": 5998.47, "timestamp": "01:39:58", "text": "评论员喜欢给出总结"}]
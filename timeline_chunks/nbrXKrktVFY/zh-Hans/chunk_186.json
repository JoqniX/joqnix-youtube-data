[{"type": "subtitle", "time": 11160.87, "timestamp": "03:06:00", "text": "他们是好角色，就像他们本身一样。"}, {"type": "subtitle", "time": 11163.99, "timestamp": "03:06:03", "text": "写得真好"}, {"type": "subtitle", "time": 11173.59, "timestamp": "03:06:13", "text": "所以我觉得当人们说“哦”的时候，感觉很糟糕。"}, {"type": "subtitle", "time": 11176.79, "timestamp": "03:06:16", "text": "乱伦是指像男人一样互相伤害，例如"}, {"type": "subtitle", "time": 11180.87, "timestamp": "03:06:20", "text": "芳香老师。是的。正确的。 Aro漫画"}, {"type": "subtitle", "time": 11187.269, "timestamp": "03:06:27", "text": "这些都是不错的动漫。我认为他们是"}, {"type": "subtitle", "time": 11188.87, "timestamp": "03:06:28", "text": "它们是很好的动漫。它们是写出来的"}, {"type": "subtitle", "time": 11190.19, "timestamp": "03:06:30", "text": "出色地。他们是"}, {"type": "subtitle", "time": 11192.87, "timestamp": "03:06:32", "text": "好像他们有很多有趣的故事。"}, {"type": "subtitle", "time": 11195.03, "timestamp": "03:06:35", "text": "告诉。正确的。"}, {"type": "subtitle", "time": 11198.03, "timestamp": "03:06:38", "text": "嗯。我感觉"}, {"type": "subtitle", "time": 11201.91, "timestamp": "03:06:41", "text": "仅仅是不承认这个故事就……"}, {"type": "subtitle", "time": 11204.23, "timestamp": "03:06:44", "text": "好就好，因为它不遵循……"}, {"type": "subtitle", "time": 11205.389, "timestamp": "03:06:45", "text": "文化的"}, {"type": "subtitle", "time": 11209.59, "timestamp": "03:06:49", "text": "正常状态很糟糕。所以我做了一种……"}, {"type": "subtitle", "time": 11212.23, "timestamp": "03:06:52", "text": "一段讽刺视频，我在视频里变成了那个人"}]
[{"type": "subtitle", "time": 9841.349, "timestamp": "02:44:01", "text": "乳房。我需要这个。这真的至关重要。"}, {"type": "subtitle", "time": 9849.429, "timestamp": "02:44:09", "text": "所以，在孟加拉语中，我只会说一个。"}, {"type": "subtitle", "time": 9851.05, "timestamp": "02:44:11", "text": "事物。"}, {"type": "subtitle", "time": 9858.309, "timestamp": "02:44:18", "text": "我什么都没听懂。"}, {"type": "subtitle", "time": 9860.309, "timestamp": "02:44:20", "text": "我只会用一种方式说"}, {"type": "subtitle", "time": 9868.469, "timestamp": "02:44:28", "text": "我知道用俄语怎么说“我要走了”。"}, {"type": "subtitle", "time": 9878.79, "timestamp": "02:44:38", "text": "我的天哪我的天哪"}, {"type": "subtitle", "time": 9881.07, "timestamp": "02:44:41", "text": "这些都是我喜欢的东西"}, {"type": "subtitle", "time": 9883.349, "timestamp": "02:44:43", "text": "学习是因为我的母语是"}, {"type": "subtitle", "time": 9886.07, "timestamp": "02:44:46", "text": "就像我的母语一样，信不信由你。"}, {"type": "subtitle", "time": 9887.27, "timestamp": "02:44:47", "text": "曾是"}, {"type": "subtitle", "time": 9889.23, "timestamp": "02:44:49", "text": "[音乐]"}, {"type": "subtitle", "time": 9892.51, "timestamp": "02:44:52", "text": "乌杜不是因为喜欢"}, {"type": "subtitle", "time": 9895.83, "timestamp": "02:44:55", "text": "嗯，这里经常有人这么说，但是"}, {"type": "subtitle", "time": 9898.63, "timestamp": "02:44:58", "text": "因为我的家人。我的家人会说话。"}]
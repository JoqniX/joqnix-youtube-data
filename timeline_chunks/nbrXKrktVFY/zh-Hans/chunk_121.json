[{"type": "subtitle", "time": 7264.87, "timestamp": "02:01:04", "text": "日语的说法有点像。"}, {"type": "subtitle", "time": 7270.31, "timestamp": "02:01:10", "text": "是的。我们chuba。啊，是的。是的。"}, {"type": "subtitle", "time": 7277.75, "timestamp": "02:01:17", "text": "我经常使用重音符号。我不"}, {"type": "subtitle", "time": 7279.669, "timestamp": "02:01:19", "text": "知道为什么人们喜欢指出"}, {"type": "subtitle", "time": 7280.75, "timestamp": "02:01:20", "text": "喜欢"}, {"type": "subtitle", "time": 7283.75, "timestamp": "02:01:23", "text": "哦哦，这个人说话带着口音。"}, {"type": "subtitle", "time": 7285.709, "timestamp": "02:01:25", "text": "像个坏人"}, {"type": "subtitle", "time": 7288.07, "timestamp": "02:01:28", "text": "因为我看到我看到它和"}, {"type": "subtitle", "time": 7295.589, "timestamp": "02:01:35", "text": "我主要在印度人身上看到这种情况"}, {"type": "subtitle", "time": 7298.31, "timestamp": "02:01:38", "text": "当你使用口音时。"}, {"type": "subtitle", "time": 7299.75, "timestamp": "02:01:39", "text": "就好像在说：“哦，你觉得自己高人一等。”"}, {"type": "subtitle", "time": 7302.149, "timestamp": "02:01:42", "text": "比我们强吗？你在炫耀肌肉。就像某人一样"}, {"type": "subtitle", "time": 7312.31, "timestamp": "02:01:52", "text": "但我曾经是威尔士人"}, {"type": "subtitle", "time": 7314.629, "timestamp": "02:01:54", "text": "口音，信不信由你，当我使用"}]
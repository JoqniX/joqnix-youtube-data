[{"type": "subtitle", "time": 13030.95, "timestamp": "03:37:10", "text": "但我不知道。我喜欢我有很多"}, {"type": "subtitle", "time": 13033.19, "timestamp": "03:37:13", "text": "想法，以及像想法这样昂贵的东西"}, {"type": "subtitle", "time": 13036.229, "timestamp": "03:37:16", "text": "钱。但我当时想，好吧。"}, {"type": "subtitle", "time": 13040.07, "timestamp": "03:37:20", "text": "我该说服谁来投资我的……"}, {"type": "subtitle", "time": 13042.11, "timestamp": "03:37:22", "text": "VTuber经纪公司？"}, {"type": "subtitle", "time": 13043.99, "timestamp": "03:37:23", "text": "[音乐]"}, {"type": "subtitle", "time": 13047.91, "timestamp": "03:37:27", "text": "我需要一瓶夜久。我需要Yago或者Sakuna。"}, {"type": "subtitle", "time": 13050.469, "timestamp": "03:37:30", "text": "印度版本。印度版本。是的。"}, {"type": "subtitle", "time": 13052.87, "timestamp": "03:37:32", "text": "因为佐久奈想投资……"}, {"type": "subtitle", "time": 13055.75, "timestamp": "03:37:35", "text": "VTuber经纪公司，但没人想要他"}, {"type": "subtitle", "time": 13057.269, "timestamp": "03:37:37", "text": "钱。所以他就想，管他呢，我来做吧。"}, {"type": "subtitle", "time": 13064.63, "timestamp": "03:37:44", "text": "而亚戈只是想要"}, {"type": "subtitle", "time": 13067.269, "timestamp": "03:37:47", "text": "偶像梦。"}, {"type": "chat", "time": 13067.713, "timestamp": "03:37:47", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "actually yeah that's a really good idea..."}, {"type": "subtitle", "time": 13079.03, "timestamp": "03:37:59", "text": "我们只需要找到一个愿意的人。"}]
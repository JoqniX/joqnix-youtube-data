[{"type": "subtitle", "time": 5641.43, "timestamp": "01:34:01", "text": "调味的。嗯。但不知何故，他"}, {"type": "subtitle", "time": 5643.669, "timestamp": "01:34:03", "text": "他没吃，他消化不了薯片。"}, {"type": "subtitle", "time": 5646.39, "timestamp": "01:34:06", "text": "或者其他什么。所以他把薯片都吐了。"}, {"type": "subtitle", "time": 5649.59, "timestamp": "01:34:09", "text": "我。哦，不。"}, {"type": "subtitle", "time": 5651.91, "timestamp": "01:34:11", "text": "从那天起，每当我自言自语时"}, {"type": "subtitle", "time": 5654.39, "timestamp": "01:34:14", "text": "我闻到了任何番茄味的东西。"}, {"type": "subtitle", "time": 5657.669, "timestamp": "01:34:17", "text": "我吃不下。哦，不。"}, {"type": "subtitle", "time": 5659.91, "timestamp": "01:34:19", "text": "那一年我整整一年都吃不下东西。"}, {"type": "subtitle", "time": 5661.91, "timestamp": "01:34:21", "text": "任何类似番茄口味的东西。但之后"}, {"type": "subtitle", "time": 5664.07, "timestamp": "01:34:24", "text": "几年前，我开始喜欢番茄。"}, {"type": "subtitle", "time": 5666.79, "timestamp": "01:34:26", "text": "再次。"}, {"type": "subtitle", "time": 5669.11, "timestamp": "01:34:29", "text": "它几乎把芯片彻底毁了。"}, {"type": "subtitle", "time": 5671.43, "timestamp": "01:34:31", "text": "番茄味薯片。我不能 我可以"}, {"type": "subtitle", "time": 5674.55, "timestamp": "01:34:34", "text": "还是不吃番茄味薯片"}, {"type": "subtitle", "time": 5677.59, "timestamp": "01:34:37", "text": "因为它让我想起了那天。哦，我的"}, {"type": "subtitle", "time": 5691.11, "timestamp": "01:34:51", "text": "我觉得，嗯，对我来说，嗯，我觉得我需要"}, {"type": "subtitle", "time": 5693.75, "timestamp": "01:34:53", "text": "习惯蜂蜜的味道。"}, {"type": "subtitle", "time": 5696.39, "timestamp": "01:34:56", "text": "蜂蜜是我不知道为什么我会喜欢的东西。"}, {"type": "subtitle", "time": 5698.43, "timestamp": "01:34:58", "text": "感觉蜂蜜的感觉"}]
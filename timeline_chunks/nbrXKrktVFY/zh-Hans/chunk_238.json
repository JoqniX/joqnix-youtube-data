[{"type": "subtitle", "time": 14282.63, "timestamp": "03:58:02", "text": "YouTuber 之类的东西，就像我以前那样。"}, {"type": "subtitle", "time": 14284.309, "timestamp": "03:58:04", "text": "大概在2020年左右了解到它们"}, {"type": "subtitle", "time": 14287.99, "timestamp": "03:58:07", "text": "2020 年的某件事，或者类似我想的，是的。"}, {"type": "subtitle", "time": 14290.63, "timestamp": "03:58:10", "text": "大概是2020年或2021年的时候，我当时想："}, {"type": "subtitle", "time": 14292.71, "timestamp": "03:58:12", "text": "了解这件事是因为我看到了类似这样的场景"}, {"type": "subtitle", "time": 14294.63, "timestamp": "03:58:14", "text": "一些4chan帖子，还有一些其他的帖子"}, {"type": "subtitle", "time": 14297.11, "timestamp": "03:58:17", "text": "星空景象与伤痕。我当时就想，“啊，"}, {"type": "subtitle", "time": 14301.11, "timestamp": "03:58:21", "text": "让我们来看看。我在Reddit上看到一些关于……的帖子"}, {"type": "subtitle", "time": 14303.269, "timestamp": "03:58:23", "text": "人们争论谁是第一个印度人"}, {"type": "subtitle", "time": 14305.11, "timestamp": "03:58:25", "text": "“油管博主。” 我心想，“啊，他们也是。”"}, {"type": "subtitle", "time": 14308.83, "timestamp": "03:58:28", "text": "为此事争吵不休。"}, {"type": "subtitle", "time": 14312.229, "timestamp": "03:58:32", "text": "是的。等等，难道是那个侵入性极强的Reddit？"}, {"type": "subtitle", "time": 14314.99, "timestamp": "03:58:34", "text": "或者在其他地方？"}, {"type": "subtitle", "time": 14318.71, "timestamp": "03:58:38", "text": "这里是Reddit。"}, {"type": "subtitle", "time": 14320.71, "timestamp": "03:58:40", "text": "是的。我不知道是哪个Reddit"}, {"type": "subtitle", "time": 14323.67, "timestamp": "03:58:43", "text": "确实如此，但我看到人们是这样的"}, {"type": "subtitle", "time": 14326.469, "timestamp": "03:58:46", "text": "因为我觉得Suki也参与其中。"}, {"type": "subtitle", "time": 14330.15, "timestamp": "03:58:50", "text": "投入其中。我认为Suki人"}, {"type": "subtitle", "time": 14332.71, "timestamp": "03:58:52", "text": "他们不知为何对她很刻薄。"}, {"type": "subtitle", "time": 14336.469, "timestamp": "03:58:56", "text": "Suzuki，就像 Starcena 里的 Suzuki 一样。"}, {"type": "subtitle", "time": 14337.87, "timestamp": "03:58:57", "text": "不，不"}]
[{"type": "subtitle", "time": 3423.109, "timestamp": "00:57:03", "text": "这取决于你不知道多少。哦，不。"}, {"type": "subtitle", "time": 3426.309, "timestamp": "00:57:06", "text": "我对这些事情一窍不通。"}, {"type": "subtitle", "time": 3428.63, "timestamp": "00:57:08", "text": "你应该了解一下。我试着"}, {"type": "subtitle", "time": 3430.47, "timestamp": "00:57:10", "text": "了解相关信息。我大概一百岁"}, {"type": "subtitle", "time": 3432.39, "timestamp": "00:57:12", "text": "不管我说什么，别当真。"}, {"type": "subtitle", "time": 3435.99, "timestamp": "00:57:15", "text": "仅供参考。我知道我并不完全"}, {"type": "subtitle", "time": 3438.069, "timestamp": "00:57:18", "text": "对此有所了解。我只是知道一些事情"}, {"type": "subtitle", "time": 3444.39, "timestamp": "00:57:24", "text": "所以，要么就去找个会计师，要么就……"}, {"type": "subtitle", "time": 3446.95, "timestamp": "00:57:26", "text": "必须缴纳那么多税款。"}, {"type": "subtitle", "time": 3449.27, "timestamp": "00:57:29", "text": "我知道如果你有的话，就像如果你也有的话。"}, {"type": "subtitle", "time": 3452.71, "timestamp": "00:57:32", "text": "费用太高，最好找个会计师，如果你"}, {"type": "subtitle", "time": 3454.15, "timestamp": "00:57:34", "text": "没多少钱可以付，就买一个"}, {"type": "subtitle", "time": 3456.62, "timestamp": "00:57:36", "text": "由家人去做"}, {"type": "subtitle", "time": 3459.349, "timestamp": "00:57:39", "text": "[音乐]"}, {"type": "subtitle", "time": 3461.15, "timestamp": "00:57:41", "text": "但除此之外……"}, {"type": "subtitle", "time": 3464.549, "timestamp": "00:57:44", "text": "我不太喜欢……呃，我不太了解很多。"}, {"type": "subtitle", "time": 3471.67, "timestamp": "00:57:51", "text": "世界如此之大。他们工作如此"}, {"type": "subtitle", "time": 3474.99, "timestamp": "00:57:54", "text": "奇怪地，与众不同。"}, {"type": "subtitle", "time": 3478.95, "timestamp": "00:57:58", "text": "是的，我仍然这么认为。"}]
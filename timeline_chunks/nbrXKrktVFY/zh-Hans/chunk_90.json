[{"type": "subtitle", "time": 5400.629, "timestamp": "01:30:00", "text": "比如，“啊，那里有很多恶心的东西”"}, {"type": "subtitle", "time": 5402.87, "timestamp": "01:30:02", "text": "把东西塞进去，然后我就吃掉它。"}, {"type": "subtitle", "time": 5411.03, "timestamp": "01:30:11", "text": "呃。但这并非全部原因。"}, {"type": "subtitle", "time": 5414.87, "timestamp": "01:30:14", "text": "但我不知道，就像肉不知道一样"}, {"type": "subtitle", "time": 5419.35, "timestamp": "01:30:19", "text": "我觉得味道不错。"}, {"type": "subtitle", "time": 5421.35, "timestamp": "01:30:21", "text": "不知何故。所以有一天，我就喜欢上了这一天。"}, {"type": "subtitle", "time": 5423.669, "timestamp": "01:30:23", "text": "我就像我们当时在说话一样，我正在和一个"}, {"type": "subtitle", "time": 5427.11, "timestamp": "01:30:27", "text": "我的朋友一边吃着饺子一边说，"}, {"type": "subtitle", "time": 5429.51, "timestamp": "01:30:29", "text": "抱怨肉太干"}, {"type": "subtitle", "time": 5431.99, "timestamp": "01:30:31", "text": "是因为我们去参加了一个婚礼，而且"}, {"type": "subtitle", "time": 5433.83, "timestamp": "01:30:33", "text": "肉很干，好像他们不喜欢似的。"}, {"type": "subtitle", "time": 5436.229, "timestamp": "01:30:36", "text": "适当调味等等等等。"}, {"type": "subtitle", "time": 5439.91, "timestamp": "01:30:39", "text": "他就像橙子，你也一样，你也一样"}, {"type": "subtitle", "time": 5441.75, "timestamp": "01:30:41", "text": "选择的时候好像你太具体了"}, {"type": "subtitle", "time": 5443.59, "timestamp": "01:30:43", "text": "肉。你真应该放弃。"}, {"type": "subtitle", "time": 5445.43, "timestamp": "01:30:45", "text": "因为没人能做出你喜欢的那种饭菜。"}, {"type": "subtitle", "time": 5447.31, "timestamp": "01:30:47", "text": "它。我心想，你知道的"}, {"type": "subtitle", "time": 5451.87, "timestamp": "01:30:51", "text": "什么？真的。从今以后，我将不再吃东西"}, {"type": "subtitle", "time": 5455.27, "timestamp": "01:30:55", "text": "肉。自那以后，就一直是"}, {"type": "subtitle", "time": 5457.189, "timestamp": "01:30:57", "text": "六年。"}]
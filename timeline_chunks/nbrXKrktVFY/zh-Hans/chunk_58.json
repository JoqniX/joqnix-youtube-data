[{"type": "subtitle", "time": 3480.549, "timestamp": "00:58:00", "text": "呃，它叫什么？就像"}, {"type": "subtitle", "time": 3483.87, "timestamp": "00:58:03", "text": "我们使用的机器里仍然有仙女。"}, {"type": "subtitle", "time": 3487.829, "timestamp": "00:58:07", "text": "它们之所以会这样，是因为有时设备会"}, {"type": "subtitle", "time": 3492.19, "timestamp": "00:58:12", "text": "做某件事，然后我就想，这怎么能算……"}, {"type": "subtitle", "time": 3502.95, "timestamp": "00:58:22", "text": "因为你知道吗，就像最近我……"}, {"type": "subtitle", "time": 3505.43, "timestamp": "00:58:25", "text": "跟朋友聊天，对吧？所以他告诉了"}, {"type": "subtitle", "time": 3508.23, "timestamp": "00:58:28", "text": "他用那个Mac Mini玩意儿"}, {"type": "subtitle", "time": 3511.91, "timestamp": "00:58:31", "text": "编辑一下，对吧？是的。而且显然在"}, {"type": "subtitle", "time": 3514.71, "timestamp": "00:58:34", "text": "Mac Mini 那个玩意儿，你可以……呃……你……"}, {"type": "subtitle", "time": 3517.19, "timestamp": "00:58:37", "text": "叫它什么？"}, {"type": "subtitle", "time": 3521.03, "timestamp": "00:58:41", "text": "它可以检测到其他设备何时处于"}, {"type": "subtitle", "time": 3525.71, "timestamp": "00:58:45", "text": "连接到它之后，你就可以分享东西了。"}, {"type": "subtitle", "time": 3528.589, "timestamp": "00:58:48", "text": "无需任何操作即可无线连接"}, {"type": "subtitle", "time": 3531.67, "timestamp": "00:58:51", "text": "未安装，未打开"}, {"type": "subtitle", "time": 3534.23, "timestamp": "00:58:54", "text": "蓝牙。它只是在云端运行而已。"}, {"type": "subtitle", "time": 3537.109, "timestamp": "00:58:57", "text": "哇。听起来像是外星技术术语"}]
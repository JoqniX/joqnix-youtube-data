[{"type": "subtitle", "time": 3121.069, "timestamp": "00:52:01", "text": "好多了，我的朋友沙米说他"}, {"type": "subtitle", "time": 3124.23, "timestamp": "00:52:04", "text": "就像橙子一样，请不要告诉我你做了"}, {"type": "subtitle", "time": 3125.67, "timestamp": "00:52:05", "text": "那个“Swagger Souls”的东西，我当时就想：这是什么鬼？"}, {"type": "subtitle", "time": 3128.15, "timestamp": "00:52:08", "text": "Swagger Souls 是什么？Swagger"}, {"type": "subtitle", "time": 3130.79, "timestamp": "00:52:10", "text": "魂系游戏，所以显然是炫耀魂系游戏"}, {"type": "subtitle", "time": 3134.39, "timestamp": "00:52:14", "text": "他做了同样的事情，只是忘记做了。"}, {"type": "subtitle", "time": 3135.91, "timestamp": "00:52:15", "text": "设置中的某个选项，您可以在其中找到它。"}, {"type": "subtitle", "time": 3139.03, "timestamp": "00:52:19", "text": "提高刷新率。"}, {"type": "subtitle", "time": 3142.15, "timestamp": "00:52:22", "text": "所以，我已经用了7个月了。"}, {"type": "subtitle", "time": 3145.75, "timestamp": "00:52:25", "text": "这台显示器。我一直用到60"}, {"type": "subtitle", "time": 3150.069, "timestamp": "00:52:30", "text": "帧率。哦，不。然后把它调高音量"}, {"type": "subtitle", "time": 3152.549, "timestamp": "00:52:32", "text": "哦，现在差别太大了。"}, {"type": "subtitle", "time": 3162.47, "timestamp": "00:52:42", "text": "就像那些类似的事情一样"}, {"type": "subtitle", "time": 3169.67, "timestamp": "00:52:49", "text": "但是，我……我可以修复整个"}, {"type": "subtitle", "time": 3171.27, "timestamp": "00:52:51", "text": "冰箱。我不知道我怎么做"}, {"type": "subtitle", "time": 3175.589, "timestamp": "00:52:55", "text": "那。哦，那真酷。"}, {"type": "subtitle", "time": 3177.51, "timestamp": "00:52:57", "text": "是的。就像有一次我的朋友她她"}, {"type": "subtitle", "time": 3179.19, "timestamp": "00:52:59", "text": "给我打电话了。她就像我们冰箱里的橙子一样。"}]
[{"type": "subtitle", "time": 12601.51, "timestamp": "03:30:01", "text": "不喜欢想象这个。你观看"}, {"type": "subtitle", "time": 12603.11, "timestamp": "03:30:03", "text": "发生某事，然后就得有人去做。"}, {"type": "subtitle", "time": 12606.429, "timestamp": "03:30:06", "text": "我来解释一下。你是做什么的"}, {"type": "subtitle", "time": 12609.91, "timestamp": "03:30:09", "text": "正在看吗？为什么？我用自己的亲眼所见"}, {"type": "subtitle", "time": 12611.43, "timestamp": "03:30:11", "text": "眼睛。"}, {"type": "subtitle", "time": 12614.63, "timestamp": "03:30:14", "text": "[音乐]"}, {"type": "subtitle", "time": 12627.67, "timestamp": "03:30:27", "text": "我？但像这样的事是一回事。"}, {"type": "subtitle", "time": 12629.349, "timestamp": "03:30:29", "text": "我不喜欢这一点。他们会"}, {"type": "subtitle", "time": 12631.99, "timestamp": "03:30:31", "text": "表现得好像那是更好的方法"}, {"type": "subtitle", "time": 12634.44, "timestamp": "03:30:34", "text": "出于某种原因，我看了看。"}, {"type": "subtitle", "time": 12636.229, "timestamp": "03:30:36", "text": "[音乐]"}, {"type": "subtitle", "time": 12638.15, "timestamp": "03:30:38", "text": "他们把内容简化得太厉害了，以至于孩子们"}, {"type": "subtitle", "time": 12640.79, "timestamp": "03:30:40", "text": "投入其中。"}, {"type": "chat", "time": 12642.357, "timestamp": "03:30:42", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "the thing is some people watch that only... not the actually anime"}, {"type": "subtitle", "time": 12642.71, "timestamp": "03:30:42", "text": "是的。"}, {"type": "subtitle", "time": 12644.87, "timestamp": "03:30:44", "text": "我不太喜欢它。孩子们在看"}, {"type": "subtitle", "time": 12648.07, "timestamp": "03:30:48", "text": "电锯太吵了，因为它不适合孩子玩。"}, {"type": "subtitle", "time": 12652.07, "timestamp": "03:30:52", "text": "它不是。但是，你知道，我的，我的，我的"}, {"type": "subtitle", "time": 12653.67, "timestamp": "03:30:53", "text": "弟弟，他大概四岁。"}, {"type": "subtitle", "time": 12656.229, "timestamp": "03:30:56", "text": "正确的？"}, {"type": "subtitle", "time": 12659.19, "timestamp": "03:30:59", "text": "他能告诉我全部的传说"}]
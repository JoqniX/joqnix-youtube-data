[{"type": "subtitle", "time": 5521.27, "timestamp": "01:32:01", "text": "正确的？但生番茄就像……"}, {"type": "subtitle", "time": 5524.87, "timestamp": "01:32:04", "text": "父母过去常常做像你这样的沙拉，"}, {"type": "subtitle", "time": 5527.83, "timestamp": "01:32:07", "text": "东西，对吧？那段时间我很喜欢"}, {"type": "subtitle", "time": 5532.87, "timestamp": "01:32:12", "text": "嗯，番茄感觉有点像那样，但是"}, {"type": "subtitle", "time": 5536.149, "timestamp": "01:32:16", "text": "但我以前还是会吃。所以就像"}, {"type": "subtitle", "time": 5539.75, "timestamp": "01:32:19", "text": "然后我突然想到，嗯……"}, {"type": "subtitle", "time": 5542.47, "timestamp": "01:32:22", "text": "自从我父母教我……"}, {"type": "subtitle", "time": 5545.27, "timestamp": "01:32:25", "text": "不要浪费食物，并且要心存感恩"}, {"type": "subtitle", "time": 5547.99, "timestamp": "01:32:27", "text": "感谢你所拥有的一切。所以，我"}, {"type": "subtitle", "time": 5550.31, "timestamp": "01:32:30", "text": "当时我就想，“好吧，我决定……”"}, {"type": "subtitle", "time": 5553.03, "timestamp": "01:32:33", "text": "嗯，是的，我要开始吃了。"}, {"type": "subtitle", "time": 5554.99, "timestamp": "01:32:34", "text": "今天西红柿和苦神"}, {"type": "subtitle", "time": 5559.51, "timestamp": "01:32:39", "text": "一直做到我喜欢为止。” 所以我一直……"}, {"type": "subtitle", "time": 5562.149, "timestamp": "01:32:42", "text": "开始这样做，嗯，持续了一段时间。"}, {"type": "subtitle", "time": 5565.83, "timestamp": "01:32:45", "text": "几个月后，我明白了，我爱我"}, {"type": "subtitle", "time": 5569.43, "timestamp": "01:32:49", "text": "开始喜欢上它们。我希望，我希望"}, {"type": "subtitle", "time": 5571.03, "timestamp": "01:32:51", "text": "我妹妹这样做是因为她讨厌"}, {"type": "subtitle", "time": 5575.149, "timestamp": "01:32:55", "text": "西红柿。它让她想吐。哦"}, {"type": "subtitle", "time": 5577.83, "timestamp": "01:32:57", "text": "不。是的。因为我会创作一些东西，"}, {"type": "subtitle", "time": 5579.11, "timestamp": "01:32:59", "text": "有时我会不小心放"}]
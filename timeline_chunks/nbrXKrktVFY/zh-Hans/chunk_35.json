[{"type": "subtitle", "time": 2100.15, "timestamp": "00:35:00", "text": "可以稍微待一会儿，1 小时或"}, {"type": "subtitle", "time": 2102.55, "timestamp": "00:35:02", "text": "然后我的笔记本电脑就附带了一些东西。"}, {"type": "subtitle", "time": 2105.349, "timestamp": "00:35:05", "text": "然后直播一下，嗯，就结束了。"}, {"type": "subtitle", "time": 2108.39, "timestamp": "00:35:08", "text": "以及类似网之类的东西"}, {"type": "subtitle", "time": 2112.15, "timestamp": "00:35:12", "text": "咖啡馆什么的，对吧，我们就去那儿，就这样。"}, {"type": "subtitle", "time": 2114.55, "timestamp": "00:35:14", "text": "想着找个那样的地方"}, {"type": "subtitle", "time": 2118.069, "timestamp": "00:35:18", "text": "日本，如果真的有的话，我大概会在那里。"}, {"type": "subtitle", "time": 2120.069, "timestamp": "00:35:20", "text": "猜测。是的。是的。我看过一些视频"}, {"type": "subtitle", "time": 2124.55, "timestamp": "00:35:24", "text": "人们喜欢住在网吧里。"}, {"type": "subtitle", "time": 2127.109, "timestamp": "00:35:27", "text": "真是太有趣了。那将是"}, {"type": "subtitle", "time": 2129.15, "timestamp": "00:35:29", "text": "更好的选择"}, {"type": "subtitle", "time": 2132.31, "timestamp": "00:35:32", "text": "我。但愿一切顺利。"}, {"type": "subtitle", "time": 2134.87, "timestamp": "00:35:34", "text": "出色地。所以，我就像在努力享受。"}, {"type": "subtitle", "time": 2137.109, "timestamp": "00:35:37", "text": "和大家一起玩得开心"}, {"type": "subtitle", "time": 2138.95, "timestamp": "00:35:38", "text": "无论我一生中遇到过谁"}, {"type": "subtitle", "time": 2143.109, "timestamp": "00:35:43", "text": "旅行。所以，嗯，就是这样。"}, {"type": "subtitle", "time": 2144.87, "timestamp": "00:35:44", "text": "本来应该有很多人的"}, {"type": "subtitle", "time": 2147.15, "timestamp": "00:35:47", "text": "想合作或者一起出去玩"}, {"type": "subtitle", "time": 2150.55, "timestamp": "00:35:50", "text": "虽然，但我现在无法联系到所有人，因为"}, {"type": "subtitle", "time": 2153.67, "timestamp": "00:35:53", "text": "呃，现在已经是六月了，到六月是"}, {"type": "subtitle", "time": 2157.349, "timestamp": "00:35:57", "text": "近期不会过来，而且只有"}]
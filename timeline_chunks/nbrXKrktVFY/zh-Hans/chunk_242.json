[{"type": "subtitle", "time": 14523.87, "timestamp": "04:02:03", "text": "YouTuber？因为我知道那会是"}, {"type": "subtitle", "time": 14526.95, "timestamp": "04:02:06", "text": "如果我没记错的话。"}, {"type": "subtitle", "time": 14532.55, "timestamp": "04:02:12", "text": "他是卡里姆·米纳蒂。等等，什么？是的。哦，"}, {"type": "subtitle", "time": 14537.269, "timestamp": "04:02:17", "text": "他以前有一台PNG。我的天啊。等待，"}, {"type": "subtitle", "time": 14540.229, "timestamp": "04:02:20", "text": "真的吗？是的，他以前用过PNG格式的"}, {"type": "subtitle", "time": 14544.07, "timestamp": "04:02:24", "text": "就像他用过的那种海滩 PNG"}, {"type": "subtitle", "time": 14547.51, "timestamp": "04:02:27", "text": "块茎。我的天啊。"}, {"type": "subtitle", "time": 14549.67, "timestamp": "04:02:29", "text": "我一直跟我的朋友们这么说。我是"}, {"type": "subtitle", "time": 14551.349, "timestamp": "04:02:31", "text": "比如，你知道第一个印度人是谁吗？"}, {"type": "subtitle", "time": 14553.269, "timestamp": "04:02:33", "text": "YouTuber？我好像不知道谁是谁。"}, {"type": "subtitle", "time": 14557.91, "timestamp": "04:02:37", "text": "它。我像卡里姆·马蒂一样。这就像什么？"}, {"type": "subtitle", "time": 14560.55, "timestamp": "04:02:40", "text": "因为你没想到会发生这种事，对吧？"}, {"type": "subtitle", "time": 14562.15, "timestamp": "04:02:42", "text": "是的，"}, {"type": "subtitle", "time": 14564.309, "timestamp": "04:02:44", "text": "就像当年凯莉那样"}, {"type": "subtitle", "time": 14565.309, "timestamp": "04:02:45", "text": "喜欢"}, {"type": "subtitle", "time": 14569.63, "timestamp": "04:02:49", "text": "嗯，视频里，他有一张他的PNG图片。"}, {"type": "subtitle", "time": 14573.87, "timestamp": "04:02:53", "text": "他自己也曾用过他自己的方式"}, {"type": "subtitle", "time": 14577.59, "timestamp": "04:02:57", "text": "视频。所以他是个巴布亚新几内亚的块茎工人，因此……"}]
[{"type": "subtitle", "time": 1860.87, "timestamp": "00:31:00", "text": "声音尖细得像个孩子，好像我没有"}, {"type": "subtitle", "time": 1864.669, "timestamp": "00:31:04", "text": "进入有丝分裂期，或者有人说像……呃"}, {"type": "subtitle", "time": 1867.99, "timestamp": "00:31:07", "text": "青春期，对吧？所以我有了这个吱吱作响的东西"}, {"type": "subtitle", "time": 1870.149, "timestamp": "00:31:10", "text": "童声。所以有了它我就可以……"}, {"type": "subtitle", "time": 1872.23, "timestamp": "00:31:12", "text": "像糖果一样的声音，就像你知道的"}, {"type": "subtitle", "time": 1875.029, "timestamp": "00:31:15", "text": "就像这种可爱的动漫女孩的声音。所以，我"}, {"type": "subtitle", "time": 1878.789, "timestamp": "00:31:18", "text": "开始在网上进行虚假身份诈骗。而我的"}, {"type": "subtitle", "time": 1881.75, "timestamp": "00:31:21", "text": "问题是我一直都喜欢可爱的东西。"}, {"type": "subtitle", "time": 1884.389, "timestamp": "00:31:24", "text": "事物。所以我的行为方式与人们的举止相似。"}, {"type": "subtitle", "time": 1888.23, "timestamp": "00:31:28", "text": "他以为我是女生。所以我就是喜欢"}, {"type": "subtitle", "time": 1890.149, "timestamp": "00:31:30", "text": "让他们说他们想说的吧。他们"}, {"type": "subtitle", "time": 1891.99, "timestamp": "00:31:31", "text": "想说叫我女孩，男孩，"}, {"type": "subtitle", "time": 1893.83, "timestamp": "00:31:33", "text": "任何。就像你做任何你想做的事一样"}, {"type": "subtitle", "time": 1895.43, "timestamp": "00:31:35", "text": "喜欢。如果有人说了什么，“是吗？”"}, {"type": "subtitle", "time": 1898.23, "timestamp": "00:31:38", "text": "“你是男的吗？” 我心想，然后……"}, {"type": "subtitle", "time": 1899.909, "timestamp": "00:31:39", "text": "我进入青春期，开始打电话"}, {"type": "subtitle", "time": 1903.43, "timestamp": "00:31:43", "text": "我自己是女性。嗯。我当时就想，这真是……"}, {"type": "subtitle", "time": 1904.87, "timestamp": "00:31:44", "text": "更好的描述方式，因为我喜欢"}, {"type": "subtitle", "time": 1908.31, "timestamp": "00:31:48", "text": "打扮得可爱一点。我喜欢可爱的东西。"}, {"type": "subtitle", "time": 1911.269, "timestamp": "00:31:51", "text": "而这某种程度上属于……"}, {"type": "subtitle", "time": 1913.11, "timestamp": "00:31:53", "text": "女性类别。所以，我就想，好吧，我"}, {"type": "subtitle", "time": 1914.91, "timestamp": "00:31:54", "text": "看来我是个铁杆粉丝。"}, {"type": "subtitle", "time": 1916.47, "timestamp": "00:31:56", "text": "[音乐]"}, {"type": "subtitle", "time": 1918.47, "timestamp": "00:31:58", "text": "我不再是狂热粉丝了。身体方面"}]
[{"type": "subtitle", "time": 8101.91, "timestamp": "02:15:01", "text": "好吧，事情是这样的，我的男朋友"}, {"type": "subtitle", "time": 8104.709, "timestamp": "02:15:04", "text": "她跟我分手是因为她有Geio"}, {"type": "subtitle", "time": 8108.87, "timestamp": "02:15:08", "text": "Sim和我都有一部Geio Sim，但现在"}, {"type": "subtitle", "time": 8111.51, "timestamp": "02:15:11", "text": "每次看到Geio的标志，"}, {"type": "subtitle", "time": 8115.43, "timestamp": "02:15:15", "text": "让我想起了她。所以，我想问的是，如果"}, {"type": "subtitle", "time": 8118.109, "timestamp": "02:15:18", "text": "如果我换的话可以吗？"}, {"type": "subtitle", "time": 8121.75, "timestamp": "02:15:21", "text": "我可以这样做吗，伙计们？你会吗？不会吗？"}, {"type": "subtitle", "time": 8124.069, "timestamp": "02:15:24", "text": "如果我离开你，你会生气的吗？"}, {"type": "subtitle", "time": 8127.669, "timestamp": "02:15:27", "text": "伙计们？这样可以吗？是的，我做过。"}, {"type": "subtitle", "time": 8129.43, "timestamp": "02:15:29", "text": "我当时就想，这样可以吗？我当时只是"}, {"type": "subtitle", "time": 8132.47, "timestamp": "02:15:32", "text": "顺便一提，我还在戏弄他们。"}, {"type": "subtitle", "time": 8134.149, "timestamp": "02:15:34", "text": "这样可以吗，各位？什么？惯于"}, {"type": "subtitle", "time": 8137.109, "timestamp": "02:15:37", "text": "你们生气了吗？"}, {"type": "subtitle", "time": 8141.03, "timestamp": "02:15:41", "text": "先生，完全没问题。"}, {"type": "subtitle", "time": 8143.109, "timestamp": "02:15:43", "text": "他们也在配合你演戏。哇。"}, {"type": "subtitle", "time": 8144.95, "timestamp": "02:15:44", "text": "是的。是的。他们会说：“先生，如果您"}, {"type": "subtitle", "time": 8146.87, "timestamp": "02:15:46", "text": "如果你有这种感觉，那完全没问题。"}, {"type": "subtitle", "time": 8149.27, "timestamp": "02:15:49", "text": "美好的。祝你一路顺风。有"}, {"type": "subtitle", "time": 8151.43, "timestamp": "02:15:51", "text": "海洋里有很多海。“就像"}, {"type": "subtitle", "time": 8152.87, "timestamp": "02:15:52", "text": "他们开始和我建立关系"}]
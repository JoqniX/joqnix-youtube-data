[{"type": "subtitle", "time": 3062.48, "timestamp": "00:51:02", "text": "闻。所以我做了这个实验。这 答案是 2"}, {"type": "subtitle", "time": 3065.079, "timestamp": "00:51:05", "text": "答案是 2 几周。已经两周了，味道很难闻。后"}, {"type": "subtitle", "time": 3067.599, "timestamp": "00:51:07", "text": "几周。已经两周了，味道很难闻。后 要么它会消失，要么你会习惯。"}, {"type": "subtitle", "time": 3072.64, "timestamp": "00:51:12", "text": "要么它会消失，要么你会习惯。 嗯。所以当他说我就像我一样的时候"}, {"type": "subtitle", "time": 3075.599, "timestamp": "00:51:15", "text": "嗯。所以当他说我就像我一样的时候 现在感觉自己的观点得到了认可。某人"}, {"type": "subtitle", "time": 3078.16, "timestamp": "00:51:18", "text": "现在感觉自己的观点得到了认可。某人 有人也这么做了"}, {"type": "subtitle", "time": 3088.71, "timestamp": "00:51:28", "text": "就像我不知道我会怎么做一样"}, {"type": "subtitle", "time": 3091.75, "timestamp": "00:51:31", "text": "诸如此类的事情，我就想，哦，这很正常吧？"}, {"type": "subtitle", "time": 3093.109, "timestamp": "00:51:33", "text": "我会问问我的朋友们，他们怎么看？"}, {"type": "subtitle", "time": 3094.75, "timestamp": "00:51:34", "text": "哦，你是吗？"}, {"type": "subtitle", "time": 3097.67, "timestamp": "00:51:37", "text": "我当时就像个傻瓜一样，用电脑就像我……"}, {"type": "subtitle", "time": 3101.27, "timestamp": "00:51:41", "text": "这台新显示器好像……"}, {"type": "subtitle", "time": 3105.19, "timestamp": "00:51:45", "text": "呃，80年代的刷新率，我没注意到。"}, {"type": "subtitle", "time": 3107.19, "timestamp": "00:51:47", "text": "你知道你得把那玩意儿音量调大。"}, {"type": "subtitle", "time": 3113.27, "timestamp": "00:51:53", "text": "我的朋友们就像橙色一样，我当时就想我们"}, {"type": "subtitle", "time": 3114.87, "timestamp": "00:51:54", "text": "我们当时正在做某件事，我就想……"}, {"type": "subtitle", "time": 3116.47, "timestamp": "00:51:56", "text": "不知道，我的两个显示器都这样"}, {"type": "subtitle", "time": 3118.309, "timestamp": "00:51:58", "text": "看起来一样，就像一个人应该有的样子"}]
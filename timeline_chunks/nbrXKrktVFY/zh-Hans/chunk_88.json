[{"type": "subtitle", "time": 5280.27, "timestamp": "01:28:00", "text": "和"}, {"type": "subtitle", "time": 5283.11, "timestamp": "01:28:03", "text": "我。哦，瞧。你应该告诉我的鲍勃吗？"}, {"type": "subtitle", "time": 5284.47, "timestamp": "01:28:04", "text": "每次都是这样，但我们有这个"}, {"type": "subtitle", "time": 5285.669, "timestamp": "01:28:05", "text": "对话。我心想，你应该"}, {"type": "subtitle", "time": 5288.27, "timestamp": "01:28:08", "text": "可能在之后停止了"}, {"type": "subtitle", "time": 5290.95, "timestamp": "01:28:10", "text": "我。是的。就像你曾经有过……"}, {"type": "subtitle", "time": 5293.83, "timestamp": "01:28:13", "text": "就像个乖巧的小孩，不挑食。他"}, {"type": "subtitle", "time": 5297.189, "timestamp": "01:28:17", "text": "你知道，他不会惹麻烦。"}, {"type": "subtitle", "time": 5299.87, "timestamp": "01:28:19", "text": "你为什么要折磨人？"}, {"type": "subtitle", "time": 5307.39, "timestamp": "01:28:27", "text": "感觉自己好像是唯一一个"}, {"type": "subtitle", "time": 5321.03, "timestamp": "01:28:41", "text": "对我来说是A。哦，好的，请便。现在我"}, {"type": "subtitle", "time": 5325.149, "timestamp": "01:28:45", "text": "就像现在一样，我心甘情愿地……"}, {"type": "subtitle", "time": 5327.83, "timestamp": "01:28:47", "text": "素食者。我不吃肉，不是舔狗。"}, {"type": "subtitle", "time": 5329.51, "timestamp": "01:28:49", "text": "因为我热爱动物。我不在乎"}, {"type": "subtitle", "time": 5332.79, "timestamp": "01:28:52", "text": "关于动物，但因为我认为肉类"}, {"type": "subtitle", "time": 5336.99, "timestamp": "01:28:56", "text": "我觉得味道很糟糕。"}]
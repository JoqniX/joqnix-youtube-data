[{"type": "subtitle", "time": 4681.59, "timestamp": "01:18:01", "text": "我和他们在一起，他们就像在说：什么？"}, {"type": "subtitle", "time": 4683.669, "timestamp": "01:18:03", "text": "我们做了这么多工作，是为了让你能够"}, {"type": "subtitle", "time": 4690.87, "timestamp": "01:18:10", "text": "你自己说这话的时候也是这么想的。是的，"}, {"type": "subtitle", "time": 4692.95, "timestamp": "01:18:12", "text": "这让我想起了自从我"}, {"type": "subtitle", "time": 4694.95, "timestamp": "01:18:14", "text": "看了动画的动画制作过程，它"}, {"type": "subtitle", "time": 4696.55, "timestamp": "01:18:16", "text": "这让我觉得，嗯，他们确实是。"}, {"type": "subtitle", "time": 4700.31, "timestamp": "01:18:20", "text": "每一个细胞都在努力工作"}, {"type": "subtitle", "time": 4705.31, "timestamp": "01:18:25", "text": "每个人。是的。是的。我"}, {"type": "subtitle", "time": 4707.99, "timestamp": "01:18:27", "text": "我的意思是，你喜欢什么？该怎么说呢？"}, {"type": "subtitle", "time": 4711.51, "timestamp": "01:18:31", "text": "听起来很蠢。听起来真是蠢透了。"}, {"type": "subtitle", "time": 4714.189, "timestamp": "01:18:34", "text": "但是，每当我难过的时候，"}, {"type": "subtitle", "time": 4716.59, "timestamp": "01:18:36", "text": "好的，我会考虑一下。"}, {"type": "subtitle", "time": 4719.11, "timestamp": "01:18:39", "text": "嗯，我觉得我的 Oshi 不会"}, {"type": "subtitle", "time": 4720.59, "timestamp": "01:18:40", "text": "欣赏"}, {"type": "subtitle", "time": 4723.59, "timestamp": "01:18:43", "text": "我难过是因为她想要我"}, {"type": "subtitle", "time": 4725.75, "timestamp": "01:18:45", "text": "快乐。"}, {"type": "subtitle", "time": 4729.11, "timestamp": "01:18:49", "text": "所以，我不会难过。"}, {"type": "subtitle", "time": 4730.55, "timestamp": "01:18:50", "text": "我的意思是，这就是我开始做这件事的原因。"}, {"type": "subtitle", "time": 4732.31, "timestamp": "01:18:52", "text": "因为马林才去健身房"}, {"type": "subtitle", "time": 4738.79, "timestamp": "01:18:58", "text": "就像她，她好像太……太像了"}]
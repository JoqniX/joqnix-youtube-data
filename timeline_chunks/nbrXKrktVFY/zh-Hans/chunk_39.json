[{"type": "subtitle", "time": 2342.31, "timestamp": "00:39:02", "text": "就像在某个特定时间一样。我的我的"}, {"type": "subtitle", "time": 2344.31, "timestamp": "00:39:04", "text": "父母们只会问：“好吧，你做得怎么样？”"}, {"type": "subtitle", "time": 2346.39, "timestamp": "00:39:06", "text": "毒品？我当时就想，好吧，那就一切都结束了。"}, {"type": "subtitle", "time": 2349.349, "timestamp": "00:39:09", "text": "没问题。"}, {"type": "subtitle", "time": 2351.67, "timestamp": "00:39:11", "text": "他们真是太随和了。"}, {"type": "subtitle", "time": 2353.349, "timestamp": "00:39:13", "text": "他们并不冷静。他们更像我"}, {"type": "subtitle", "time": 2355.75, "timestamp": "00:39:15", "text": "我是否已经对他们施以如此酷刑，以至于"}, {"type": "subtitle", "time": 2359.109, "timestamp": "00:39:19", "text": "他们的期望值很低。"}, {"type": "subtitle", "time": 2360.55, "timestamp": "00:39:20", "text": "他们会问：你是不是在做梦？"}, {"type": "subtitle", "time": 2363.19, "timestamp": "00:39:23", "text": "犯罪？你快要死了吗？我的想法是：不。他们"}, {"type": "subtitle", "time": 2370.23, "timestamp": "00:39:30", "text": "没关系，因为我小时候就是我"}, {"type": "subtitle", "time": 2372.71, "timestamp": "00:39:32", "text": "就像你一样，你会怎么称呼它？天赋异禀"}, {"type": "subtitle", "time": 2375.829, "timestamp": "00:39:35", "text": "据他们说，这是个孩子。"}, {"type": "subtitle", "time": 2379.19, "timestamp": "00:39:39", "text": "所以每当我做一些不合常规的事情时"}, {"type": "subtitle", "time": 2380.349, "timestamp": "00:39:40", "text": "在"}, {"type": "subtitle", "time": 2384.55, "timestamp": "00:39:44", "text": "那个角度不像你"}, {"type": "subtitle", "time": 2387.75, "timestamp": "00:39:47", "text": "了解印度父母的做法是正确的"}, {"type": "subtitle", "time": 2389.75, "timestamp": "00:39:49", "text": "如果你不按他们说的做，"}, {"type": "subtitle", "time": 2391.27, "timestamp": "00:39:51", "text": "那你简直就是最糟糕的人。"}, {"type": "subtitle", "time": 2393.63, "timestamp": "00:39:53", "text": "碰巧"}, {"type": "subtitle", "time": 2396.109, "timestamp": "00:39:56", "text": "嗯，没错。"}, {"type": "subtitle", "time": 2399.99, "timestamp": "00:39:59", "text": "所以，我妈妈希望我成为一名工程师。"}]
[{"type": "subtitle", "time": 4387.07, "timestamp": "01:13:07", "text": "当每个人都在做某事的时候"}, {"type": "subtitle", "time": 4389.669, "timestamp": "01:13:09", "text": "相同的。就像是，“哦，你穿着……”"}, {"type": "subtitle", "time": 4392.07, "timestamp": "01:13:12", "text": "今天这个颜色。你他妈的"}, {"type": "subtitle", "time": 4394.95, "timestamp": "01:13:14", "text": "颜色。"}, {"type": "subtitle", "time": 4396.99, "timestamp": "01:13:16", "text": "哦，你有你的头发"}, {"type": "subtitle", "time": 4405.11, "timestamp": "01:13:25", "text": "头发。他们可能会像这样"}, {"type": "subtitle", "time": 4407.27, "timestamp": "01:13:27", "text": "互相争吵，喜欢对方的人就像"}, {"type": "subtitle", "time": 4413.03, "timestamp": "01:13:33", "text": "最愚蠢的。不，我才是最笨的那个。我"}, {"type": "subtitle", "time": 4415.55, "timestamp": "01:13:35", "text": "不知道2加2等于多少"}, {"type": "subtitle", "time": 4418.229, "timestamp": "01:13:38", "text": "是。你不知道2+2等于多少吗？我不"}, {"type": "subtitle", "time": 4420.47, "timestamp": "01:13:40", "text": "伙计们，知道二是什么概念吗？卧槽"}, {"type": "subtitle", "time": 4421.75, "timestamp": "01:13:41", "text": "你在说什么？你是做什么的？"}, {"type": "subtitle", "time": 4431.59, "timestamp": "01:13:51", "text": "嗯，"}, {"type": "subtitle", "time": 4435.03, "timestamp": "01:13:55", "text": "哦，下一个问题，乔。"}, {"type": "subtitle", "time": 4436.95, "timestamp": "01:13:56", "text": "有什么事是可以讨厌的？"}, {"type": "subtitle", "time": 4439.51, "timestamp": "01:13:59", "text": "关于？"}]
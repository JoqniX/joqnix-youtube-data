[{"type": "subtitle", "time": 2461.67, "timestamp": "00:41:01", "text": "我小时候的梦想是拥有一个小"}, {"type": "subtitle", "time": 2464.069, "timestamp": "00:41:04", "text": "小面包店，做小面包。"}, {"type": "subtitle", "time": 2465.75, "timestamp": "00:41:05", "text": "闻一闻，然后卖给小商贩"}, {"type": "subtitle", "time": 2469.91, "timestamp": "00:41:09", "text": "小村庄里的人们。是的，"}, {"type": "subtitle", "time": 2471.34, "timestamp": "00:41:11", "text": "那是梦想。"}, {"type": "subtitle", "time": 2472.87, "timestamp": "00:41:12", "text": "[音乐]"}, {"type": "subtitle", "time": 2474.63, "timestamp": "00:41:14", "text": "而且我厨艺也很好。"}, {"type": "subtitle", "time": 2476.15, "timestamp": "00:41:16", "text": "这就是为什么我奶奶认为我是"}, {"type": "subtitle", "time": 2479.71, "timestamp": "00:41:19", "text": "将来会成为一名优秀的厨师吗？"}, {"type": "subtitle", "time": 2482.47, "timestamp": "00:41:22", "text": "某物。我妈妈希望我"}, {"type": "subtitle", "time": 2485.91, "timestamp": "00:41:25", "text": "我是工程师，因为我就是那个负责修理的人。"}, {"type": "subtitle", "time": 2488.87, "timestamp": "00:41:28", "text": "家里的东西。每当"}, {"type": "subtitle", "time": 2491.99, "timestamp": "00:41:31", "text": "电子刹车"}, {"type": "subtitle", "time": 2493.829, "timestamp": "00:41:33", "text": "一个"}, {"type": "subtitle", "time": 2496.47, "timestamp": "00:41:36", "text": "就像任何事情一样，每次都会发生一些事。"}, {"type": "subtitle", "time": 2498.47, "timestamp": "00:41:38", "text": "如果坏了，我就想，“好吧，我来修。”我"}, {"type": "subtitle", "time": 2500.55, "timestamp": "00:41:40", "text": "我当时就像是建筑师鲍勃一样。"}, {"type": "subtitle", "time": 2502.829, "timestamp": "00:41:42", "text": "呃，在我的"}, {"type": "subtitle", "time": 2505.75, "timestamp": "00:41:45", "text": "家里有房子，我爸爸希望我当护士。"}, {"type": "subtitle", "time": 2508.39, "timestamp": "00:41:48", "text": "因为我住院的时候确实"}, {"type": "subtitle", "time": 2511.109, "timestamp": "00:41:51", "text": "一切都与护理有关，因为"}, {"type": "subtitle", "time": 2514.15, "timestamp": "00:41:54", "text": "我可以换绷带，我可以"}, {"type": "subtitle", "time": 2516.47, "timestamp": "00:41:56", "text": "如果有伤口，我可以随时更换"}, {"type": "subtitle", "time": 2519.43, "timestamp": "00:41:59", "text": "也把这个问题解决掉，因为我不明白。"}]
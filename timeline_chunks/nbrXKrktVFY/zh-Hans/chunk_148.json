[{"type": "subtitle", "time": 8880.07, "timestamp": "02:28:00", "text": "4chan。感觉好像已经过去几十年了。"}, {"type": "subtitle", "time": 8881.75, "timestamp": "02:28:01", "text": "我不明白为什么人们讨厌这个网站。"}, {"type": "subtitle", "time": 8885.83, "timestamp": "02:28:05", "text": "太多了。是啊，感觉就像只有"}, {"type": "subtitle", "time": 8888.55, "timestamp": "02:28:08", "text": "4chan 上发生过的所有坏事。"}, {"type": "subtitle", "time": 8889.99, "timestamp": "02:28:09", "text": "人们讨厌那样。但我心想，“好吧，"}, {"type": "subtitle", "time": 8892.15, "timestamp": "02:28:12", "text": "这些东西呢？”嗯，还有。"}, {"type": "subtitle", "time": 8894.469, "timestamp": "02:28:14", "text": "也是好东西。"}, {"type": "subtitle", "time": 8896.23, "timestamp": "02:28:16", "text": "他们会说：“啊，太多了。”"}, {"type": "subtitle", "time": 8898.75, "timestamp": "02:28:18", "text": "由……犯下的战争罪行"}, {"type": "subtitle", "time": 8905.51, "timestamp": "02:28:25", "text": "好的。比如，当我与这些互动时"}, {"type": "subtitle", "time": 8909.67, "timestamp": "02:28:29", "text": "就像某些两种观点一样，对吧？"}, {"type": "subtitle", "time": 8915.11, "timestamp": "02:28:35", "text": "他会说一些让我感到困惑的话，比如“为什么？”"}, {"type": "subtitle", "time": 8917.91, "timestamp": "02:28:37", "text": "你会这么说吗？"}, {"type": "subtitle", "time": 8920.309, "timestamp": "02:28:40", "text": "好吧，乔，我不想来"}, {"type": "subtitle", "time": 8923.15, "timestamp": "02:28:43", "text": "表现得像个……"}, {"type": "subtitle", "time": 8927.11, "timestamp": "02:28:47", "text": "真是个极度自恋的人，对吧？喜欢"}, {"type": "subtitle", "time": 8929.349, "timestamp": "02:28:49", "text": "你为什么不看我的聊天记录？没有"}, {"type": "subtitle", "time": 8930.67, "timestamp": "02:28:50", "text": "一"}, {"type": "subtitle", "time": 8932.95, "timestamp": "02:28:52", "text": "这里。我不想公开承认"}, {"type": "subtitle", "time": 8934.87, "timestamp": "02:28:54", "text": "那。但就像某些 YouTuber 一样，他们"}, {"type": "subtitle", "time": 8938.469, "timestamp": "02:28:58", "text": "会表现得好像他们在公司里举足轻重一样。"}]
[{"type": "subtitle", "time": 10625.19, "timestamp": "02:57:05", "text": "就像以前我们用印地语的时候一样"}, {"type": "subtitle", "time": 10638.63, "timestamp": "02:57:18", "text": "那很有趣，她给了我一种感觉。"}, {"type": "subtitle", "time": 10646.23, "timestamp": "02:57:26", "text": "就像她教我如何像货币一样。"}, {"type": "subtitle", "time": 10649.309, "timestamp": "02:57:29", "text": "作品以及人们如何购买"}, {"type": "subtitle", "time": 10651.67, "timestamp": "02:57:31", "text": "东西。就像那是她喜欢的东西。"}, {"type": "subtitle", "time": 10654.83, "timestamp": "02:57:34", "text": "她就像那种你可以随便买的东西。"}, {"type": "subtitle", "time": 10658.87, "timestamp": "02:57:38", "text": "从像7-Eleven这样的便利店买来的食物"}, {"type": "subtitle", "time": 10660.87, "timestamp": "02:57:40", "text": "随便买点什么，然后在那里吃。我就像"}, {"type": "subtitle", "time": 10665.75, "timestamp": "02:57:45", "text": "她说道：“是啊，他们有热水。”"}, {"type": "subtitle", "time": 10668.42, "timestamp": "02:57:48", "text": "那里有类似微波炉的东西。"}, {"type": "subtitle", "time": 10669.91, "timestamp": "02:57:49", "text": "[音乐]"}, {"type": "subtitle", "time": 10672.95, "timestamp": "02:57:52", "text": "很有趣。"}, {"type": "subtitle", "time": 10675.91, "timestamp": "02:57:55", "text": "是的。我觉得过了一年或者像……"}, {"type": "subtitle", "time": 10678.389, "timestamp": "02:57:58", "text": "几个月后，我也可能像"}]
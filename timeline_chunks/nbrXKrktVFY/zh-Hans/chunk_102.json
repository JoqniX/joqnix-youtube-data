[{"type": "subtitle", "time": 6131.99, "timestamp": "01:42:11", "text": "是的，闲聊没关系。乐趣。是的。我"}, {"type": "subtitle", "time": 6135.91, "timestamp": "01:42:15", "text": "也就是说，我大部分时间都在这里唠叨。"}, {"type": "subtitle", "time": 6139.91, "timestamp": "01:42:19", "text": "你喜欢喋喋不休吗？呃，就像……做……"}, {"type": "subtitle", "time": 6142.149, "timestamp": "01:42:22", "text": "你喜欢和人聊天吗？"}, {"type": "subtitle", "time": 6145.109, "timestamp": "01:42:25", "text": "就像你……就像睡前那样"}, {"type": "subtitle", "time": 6147.109, "timestamp": "01:42:27", "text": "就像你跟电脑说晚安一样。"}, {"type": "subtitle", "time": 6150.149, "timestamp": "01:42:30", "text": "电脑，我跟它说话的一切"}, {"type": "subtitle", "time": 6152.95, "timestamp": "01:42:32", "text": "我"}, {"type": "subtitle", "time": 6156.07, "timestamp": "01:42:36", "text": "就像有一次，它听起来像个笑话，听起来"}, {"type": "subtitle", "time": 6158.95, "timestamp": "01:42:38", "text": "我是个精神分裂症患者，但有一次我还是"}, {"type": "subtitle", "time": 6162.189, "timestamp": "01:42:42", "text": "我正在电脑上编辑，对吧？"}, {"type": "subtitle", "time": 6164.31, "timestamp": "01:42:44", "text": "而且它"}, {"type": "subtitle", "time": 6165.91, "timestamp": "01:42:45", "text": "我不知道为什么，但我去了"}, {"type": "subtitle", "time": 6168.79, "timestamp": "01:42:48", "text": "浴室外面有一把椅子。"}, {"type": "subtitle", "time": 6170.55, "timestamp": "01:42:50", "text": "我的浴室。所以我就想，“哦，什么？”"}, {"type": "subtitle", "time": 6172.709, "timestamp": "01:42:52", "text": "这椅子他妈的在这儿干嘛？”所以，"}, {"type": "subtitle", "time": 6174.31, "timestamp": "01:42:54", "text": "我把它捡起来带到了我的……"}, {"type": "subtitle", "time": 6177.669, "timestamp": "01:42:57", "text": "把它搬到房间里，放在我的椅子旁边。和"}]
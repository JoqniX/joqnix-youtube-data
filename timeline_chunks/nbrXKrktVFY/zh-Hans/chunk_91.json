[{"type": "subtitle", "time": 5461.91, "timestamp": "01:31:01", "text": "该死。我没碰过肉。"}, {"type": "subtitle", "time": 5466.79, "timestamp": "01:31:06", "text": "等等，所以这意味着你还没有……"}, {"type": "subtitle", "time": 5470.229, "timestamp": "01:31:10", "text": "从那以后就一直吃馍馍吗？不，momo 和……不一样"}, {"type": "subtitle", "time": 5472.87, "timestamp": "01:31:12", "text": "制成。有些馍馍并非正宗的"}, {"type": "subtitle", "time": 5474.629, "timestamp": "01:31:14", "text": "我喜欢吃的饺子。他们不是"}, {"type": "subtitle", "time": 5478.47, "timestamp": "01:31:18", "text": "里面加了肉之类的东西。这"}, {"type": "subtitle", "time": 5480.55, "timestamp": "01:31:20", "text": "馅料里只有洋葱和其他一些东西。"}, {"type": "subtitle", "time": 5491.91, "timestamp": "01:31:31", "text": "你呢，乔克？你有什么不了解的？"}, {"type": "subtitle", "time": 5494.47, "timestamp": "01:31:34", "text": "就像吃饭一样。你有什么吗？"}, {"type": "subtitle", "time": 5497.189, "timestamp": "01:31:37", "text": "你特别在意的是什么？我不挑剔。"}, {"type": "subtitle", "time": 5500.55, "timestamp": "01:31:40", "text": "食客。就像我小时候那样，"}, {"type": "subtitle", "time": 5503.99, "timestamp": "01:31:43", "text": "我想我以前很讨厌西红柿，但后来又喜欢了。"}, {"type": "subtitle", "time": 5507.669, "timestamp": "01:31:47", "text": "苦涩的上帝，因为在家里他们是我的家人"}, {"type": "subtitle", "time": 5509.55, "timestamp": "01:31:49", "text": "用来制作它"}, {"type": "subtitle", "time": 5512.75, "timestamp": "01:31:52", "text": "总是喜欢像煮熟的东西"}, {"type": "subtitle", "time": 5516.629, "timestamp": "01:31:56", "text": "就像咖喱之类的番茄一样，"}]
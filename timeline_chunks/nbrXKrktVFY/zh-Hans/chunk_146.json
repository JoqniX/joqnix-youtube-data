[{"type": "subtitle", "time": 8764.469, "timestamp": "02:26:04", "text": "就像有一种互动方式"}, {"type": "subtitle", "time": 8767.83, "timestamp": "02:26:07", "text": "如果你想对某人说些什么"}, {"type": "subtitle", "time": 8771.27, "timestamp": "02:26:11", "text": "这位 YouTuber。就像有一个时间段"}, {"type": "subtitle", "time": 8774.55, "timestamp": "02:26:14", "text": "你可以在那里说出那件事，然后你"}, {"type": "subtitle", "time": 8778.07, "timestamp": "02:26:18", "text": "我百分之百确定她会读。这就像"}, {"type": "subtitle", "time": 8782.469, "timestamp": "02:26:22", "text": "缓冲时间。是的。"}, {"type": "subtitle", "time": 8783.99, "timestamp": "02:26:23", "text": "我当时正在向一位朋友解释这件事。"}, {"type": "subtitle", "time": 8785.99, "timestamp": "02:26:25", "text": "他当时就说：“哦，搞什么鬼？”"}, {"type": "subtitle", "time": 8788.23, "timestamp": "02:26:28", "text": "听起来像《黑暗之魂》里的boss。就像你一样"}, {"type": "subtitle", "time": 8791.19, "timestamp": "02:26:31", "text": "必须攻击这个像素点"}, {"type": "subtitle", "time": 8801.99, "timestamp": "02:26:41", "text": "感觉很有趣。"}, {"type": "subtitle", "time": 8804.23, "timestamp": "02:26:44", "text": "很有趣。所以我只是看看，别发垃圾邮件。"}, {"type": "subtitle", "time": 8805.59, "timestamp": "02:26:45", "text": "聊天记录。我感觉就像，如果我有……"}, {"type": "subtitle", "time": 8807.83, "timestamp": "02:26:47", "text": "想说点好笑的话，我就先忍着吧。"}, {"type": "subtitle", "time": 8810.07, "timestamp": "02:26:50", "text": "就是那玩意儿，我知道她什么时候在附近。"}, {"type": "subtitle", "time": 8816.91, "timestamp": "02:26:56", "text": "和"}, {"type": "subtitle", "time": 8819.67, "timestamp": "02:26:59", "text": "我不知道为什么我好像见过这种情况"}]
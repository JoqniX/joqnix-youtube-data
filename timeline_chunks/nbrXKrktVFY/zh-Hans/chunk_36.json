[{"type": "subtitle", "time": 2161.109, "timestamp": "00:36:01", "text": "只剩几天了。我还有时间，直到……"}, {"type": "subtitle", "time": 2163.51, "timestamp": "00:36:03", "text": "六月的第二周。之后，我还有"}, {"type": "subtitle", "time": 2165.829, "timestamp": "00:36:05", "text": "就像收拾东西一样。第二周。第二"}, {"type": "subtitle", "time": 2168.31, "timestamp": "00:36:08", "text": "六月的那一周。然后我的考试就开始了。"}, {"type": "subtitle", "time": 2171.15, "timestamp": "00:36:11", "text": "第三周，我还没到。"}, {"type": "subtitle", "time": 2174.47, "timestamp": "00:36:14", "text": "学过了，不过没关系，不过"}, {"type": "subtitle", "time": 2176.51, "timestamp": "00:36:16", "text": "我得收拾行李了。"}, {"type": "subtitle", "time": 2180.47, "timestamp": "00:36:20", "text": "一切。是的。是的。你如何"}, {"type": "subtitle", "time": 2183.19, "timestamp": "00:36:23", "text": "过着如此复杂的生活吗？我"}, {"type": "subtitle", "time": 2185.43, "timestamp": "00:36:25", "text": "我不知道，因为我不能，我不能"}, {"type": "subtitle", "time": 2189.67, "timestamp": "00:36:29", "text": "比如，如果我必须在……完成10件事"}, {"type": "subtitle", "time": 2191.589, "timestamp": "00:36:31", "text": "早上我想让你知道我"}, {"type": "subtitle", "time": 2194.87, "timestamp": "00:36:34", "text": "就该死了。我做不到。我的"}, {"type": "subtitle", "time": 2202.31, "timestamp": "00:36:42", "text": "这。就像我告诉别人我的"}, {"type": "subtitle", "time": 2204.47, "timestamp": "00:36:44", "text": "就像我每天的作息安排一样"}, {"type": "subtitle", "time": 2205.99, "timestamp": "00:36:45", "text": "它们就像橙子一样，你住在三个"}, {"type": "subtitle", "time": 2207.99, "timestamp": "00:36:47", "text": "生命？我就像，不，我只是就像，我是"}, {"type": "subtitle", "time": 2210.63, "timestamp": "00:36:50", "text": "我对所做的事情充满热情。"}, {"type": "subtitle", "time": 2212.39, "timestamp": "00:36:52", "text": "尤其是像看直播之类的。"}, {"type": "subtitle", "time": 2214.23, "timestamp": "00:36:54", "text": "我心想，好吧，我今天得走了。"}, {"type": "subtitle", "time": 2217.51, "timestamp": "00:36:57", "text": "即将播出的是流媒体。"}, {"type": "subtitle", "time": 2219.67, "timestamp": "00:36:59", "text": "流式传输。好的，希娜也要去"}]
[{"type": "subtitle", "time": 1083.27, "timestamp": "00:18:03", "text": "他不知道。等等，这是什么？"}, {"type": "subtitle", "time": 1085.789, "timestamp": "00:18:05", "text": "就保持这样吧。"}, {"type": "subtitle", "time": 1088.63, "timestamp": "00:18:08", "text": "好的。它像石头剪刀布吗？"}, {"type": "subtitle", "time": 1090.15, "timestamp": "00:18:10", "text": "那玩意儿？"}, {"type": "subtitle", "time": 1092.47, "timestamp": "00:18:12", "text": "是的。是的。就是这样，就是这样。"}, {"type": "subtitle", "time": 1101.95, "timestamp": "00:18:21", "text": "哦，那是我的缺陷"}, {"type": "subtitle", "time": 1118.87, "timestamp": "00:18:38", "text": "天气怎么样？天气是"}, {"type": "subtitle", "time": 1123.909, "timestamp": "00:18:43", "text": "今天天气很好。下了点雨。"}, {"type": "subtitle", "time": 1127.029, "timestamp": "00:18:47", "text": "就像一个小时前我遇到的情况一样。"}, {"type": "subtitle", "time": 1130.39, "timestamp": "00:18:50", "text": "哦，是的。你那儿怎么样？怎么样？"}, {"type": "subtitle", "time": 1134.23, "timestamp": "00:18:54", "text": "天气？天气非常热。我当时"}, {"type": "subtitle", "time": 1138.27, "timestamp": "00:18:58", "text": "奄奄一息。哦，不。"}]
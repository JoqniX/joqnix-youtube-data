[{"type": "subtitle", "time": 1141.59, "timestamp": "00:19:01", "text": "不知为何，我的城市似乎这么想，"}, {"type": "subtitle", "time": 1143.35, "timestamp": "00:19:03", "text": "你知道吗，今天超级热，所以"}, {"type": "subtitle", "time": 1145.669, "timestamp": "00:19:05", "text": "它们不需要电力。"}, {"type": "subtitle", "time": 1147.83, "timestamp": "00:19:07", "text": "哦不，他们不需要。他们不"}, {"type": "subtitle", "time": 1150.07, "timestamp": "00:19:10", "text": "需要它。"}, {"type": "subtitle", "time": 1153.59, "timestamp": "00:19:13", "text": "不。我的天哪。我只是，我只是，我不"}, {"type": "subtitle", "time": 1156.789, "timestamp": "00:19:16", "text": "知道。我刚睡着了。我就像我"}, {"type": "subtitle", "time": 1159.19, "timestamp": "00:19:19", "text": "电力系统恢复后就会恢复。"}, {"type": "subtitle", "time": 1161.029, "timestamp": "00:19:21", "text": "回来了。否则，我不想成为一个"}, {"type": "subtitle", "time": 1174.789, "timestamp": "00:19:34", "text": "不用担心。慢慢来。是"}, {"type": "subtitle", "time": 1188.789, "timestamp": "00:19:48", "text": "你今天过得怎么样？"}, {"type": "subtitle", "time": 1190.63, "timestamp": "00:19:50", "text": "我今天没杀人，所以"}]
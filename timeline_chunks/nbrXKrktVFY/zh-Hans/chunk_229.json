[{"type": "subtitle", "time": 13741.07, "timestamp": "03:49:01", "text": "等等，他真的完全……"}, {"type": "subtitle", "time": 13743.91, "timestamp": "03:49:03", "text": "现在毕业还是像那样？"}, {"type": "subtitle", "time": 13747.349, "timestamp": "03:49:07", "text": "哦，等等。我错过了吗？我觉得我"}, {"type": "subtitle", "time": 13749.99, "timestamp": "03:49:09", "text": "错过了。等待，"}, {"type": "subtitle", "time": 13752.55, "timestamp": "03:49:12", "text": "等待。你知道古拉为什么古拉吗？"}, {"type": "subtitle", "time": 13754.95, "timestamp": "03:49:14", "text": "毕业了吗？"}, {"type": "subtitle", "time": 13759.75, "timestamp": "03:49:19", "text": "呃，因为健康原因，还有像公司之类的。"}, {"type": "subtitle", "time": 13762.87, "timestamp": "03:49:22", "text": "不匹配的东西。是的，那些就是那种情况。"}, {"type": "subtitle", "time": 13764.71, "timestamp": "03:49:24", "text": "这些原因。但就像另一个人一样"}, {"type": "subtitle", "time": 13768.71, "timestamp": "03:49:28", "text": "原因就像是成为顶级主播一样"}, {"type": "subtitle", "time": 13772.79, "timestamp": "03:49:32", "text": "这让她很受不了。哦，就像她是……"}, {"type": "subtitle", "time": 13776.229, "timestamp": "03:49:36", "text": "行业标准，例如顶级"}, {"type": "subtitle", "time": 13778.63, "timestamp": "03:49:38", "text": "食物链。就像她正在变得"}, {"type": "subtitle", "time": 13780.309, "timestamp": "03:49:40", "text": "惊恐发作。她就像是"}, {"type": "subtitle", "time": 13782.79, "timestamp": "03:49:42", "text": "她做什么事都感到紧张。"}, {"type": "subtitle", "time": 13789.349, "timestamp": "03:49:49", "text": "所以这就是为什么它曾经是……"}, {"type": "subtitle", "time": 13791.51, "timestamp": "03:49:51", "text": "原因如下。"}, {"type": "subtitle", "time": 13793.91, "timestamp": "03:49:53", "text": "嗯。她只想当一条傻乎乎的鲨鱼。"}, {"type": "subtitle", "time": 13796.55, "timestamp": "03:49:56", "text": "女孩。她不想成为那样的人"}, {"type": "subtitle", "time": 13799.67, "timestamp": "03:49:59", "text": "VTuber 链条顶端。"}]
[{"type": "subtitle", "time": 8521.11, "timestamp": "02:22:01", "text": "现在。这将被视为长途旅行"}, {"type": "subtitle", "time": 8525.11, "timestamp": "02:22:05", "text": "或者别的什么，对吧？是的。"}, {"type": "subtitle", "time": 8527.91, "timestamp": "02:22:07", "text": "我我我曾经就是那个人。我仍然"}, {"type": "subtitle", "time": 8530.59, "timestamp": "02:22:10", "text": "讨厌冗长的人"}, {"type": "subtitle", "time": 8533.19, "timestamp": "02:22:13", "text": "距离。如果我发现我的朋友们"}, {"type": "subtitle", "time": 8535.19, "timestamp": "02:22:15", "text": "我们正在谈异地恋，我"}, {"type": "subtitle", "time": 8542.309, "timestamp": "02:22:22", "text": "他们。但后来我谈了一场异地恋。"}, {"type": "subtitle", "time": 8544.71, "timestamp": "02:22:24", "text": "关系。于是我开始嘲笑他。"}, {"type": "subtitle", "time": 8547.51, "timestamp": "02:22:27", "text": "我自己都觉得，哇，我讨厌我变成了那样"}, {"type": "subtitle", "time": 8553.91, "timestamp": "02:22:33", "text": "但结束后，我就想，“好吧，"}, {"type": "subtitle", "time": 8561.349, "timestamp": "02:22:41", "text": "因为我真的很需要人陪伴，所以保持距离。"}, {"type": "subtitle", "time": 8564.23, "timestamp": "02:22:44", "text": "伙计。"}, {"type": "subtitle", "time": 8565.55, "timestamp": "02:22:45", "text": "喜欢"}, {"type": "subtitle", "time": 8568.469, "timestamp": "02:22:48", "text": "我就是那样，就像我说的那样，我就像"}, {"type": "subtitle", "time": 8570.79, "timestamp": "02:22:50", "text": "一个"}, {"type": "subtitle", "time": 8574.23, "timestamp": "02:22:54", "text": "呃，怎样表达比较好呢？"}, {"type": "subtitle", "time": 8576.389, "timestamp": "02:22:56", "text": "我就像一只精力充沛的狗，不停地"}]
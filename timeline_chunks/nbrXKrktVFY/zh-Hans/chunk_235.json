[{"type": "subtitle", "time": 14100.63, "timestamp": "03:55:00", "text": "我知道他不知道莫伊的事"}, {"type": "subtitle", "time": 14114.83, "timestamp": "03:55:14", "text": "知道。想到Shior真是太疯狂了"}, {"type": "subtitle", "time": 14118.309, "timestamp": "03:55:18", "text": "Shiorine和我同岁。它是"}, {"type": "subtitle", "time": 14121.07, "timestamp": "03:55:21", "text": "真是不可思议"}, {"type": "subtitle", "time": 14123.83, "timestamp": "03:55:23", "text": "那。我当时正看着她做"}, {"type": "subtitle", "time": 14126.28, "timestamp": "03:55:26", "text": "当时她正在做事情。"}, {"type": "subtitle", "time": 14129.03, "timestamp": "03:55:29", "text": "[音乐]"}, {"type": "subtitle", "time": 14131.71, "timestamp": "03:55:31", "text": "我有点想念她了，就像以前那样。"}, {"type": "subtitle", "time": 14134.95, "timestamp": "03:55:34", "text": "就像她以前那样的性格"}, {"type": "subtitle", "time": 14141.07, "timestamp": "03:55:41", "text": "但现在她有这样"}, {"type": "subtitle", "time": 14144.469, "timestamp": "03:55:44", "text": "你说它更有魅力吗？是的，"}, {"type": "subtitle", "time": 14147.91, "timestamp": "03:55:47", "text": "她感觉自己现在更开朗了。是的，我"}, {"type": "subtitle", "time": 14150.309, "timestamp": "03:55:50", "text": "以前记得我看过莫伊"}, {"type": "subtitle", "time": 14152.269, "timestamp": "03:55:52", "text": "点赞"}, {"type": "subtitle", "time": 14157.59, "timestamp": "03:55:57", "text": "抽搐。我当时也是，一样一样。嗯。我"}, {"type": "subtitle", "time": 14159.99, "timestamp": "03:55:59", "text": "记得看过她，每隔5分钟"}]
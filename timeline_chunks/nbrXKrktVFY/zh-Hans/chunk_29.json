[{"type": "subtitle", "time": 1740.63, "timestamp": "00:29:00", "text": "星座，性别概念"}, {"type": "subtitle", "time": 1743.51, "timestamp": "00:29:03", "text": "对我来说不适用。那是"}, {"type": "subtitle", "time": 1747.83, "timestamp": "00:29:07", "text": "我对这个声音的感受。呃"}, {"type": "subtitle", "time": 1751.669, "timestamp": "00:29:11", "text": "我的声音是雌雄同体的。"}, {"type": "subtitle", "time": 1754.47, "timestamp": "00:29:14", "text": "如果我没记错的话，是语音。这就是……"}, {"type": "subtitle", "time": 1758.789, "timestamp": "00:29:18", "text": "朋友，这就像……呃，让我谷歌一下。"}, {"type": "subtitle", "time": 1760.389, "timestamp": "00:29:20", "text": "那是为了你。"}, {"type": "subtitle", "time": 1762.549, "timestamp": "00:29:22", "text": "哦，不。"}, {"type": "subtitle", "time": 1773.11, "timestamp": "00:29:33", "text": "嗯，是的，一个听起来既不像也不像的声音"}, {"type": "subtitle", "time": 1775.669, "timestamp": "00:29:35", "text": "男性或女性那种东西。哦"}, {"type": "subtitle", "time": 1777.99, "timestamp": "00:29:37", "text": "我以前把那种人称为无性恋。"}, {"type": "subtitle", "time": 1782.07, "timestamp": "00:29:42", "text": "嗓音。啊。哦，对，就是那个。"}, {"type": "subtitle", "time": 1785.269, "timestamp": "00:29:45", "text": "无性恋的声音，也因为我听着"}, {"type": "subtitle", "time": 1787.63, "timestamp": "00:29:47", "text": "对一些 YouTuber 和一些 ASM 艺术家来说"}, {"type": "subtitle", "time": 1791.269, "timestamp": "00:29:51", "text": "还有一些配音演员，以及每当他们"}, {"type": "subtitle", "time": 1793.029, "timestamp": "00:29:53", "text": "评论人们问他们关于他们的"}, {"type": "subtitle", "time": 1794.789, "timestamp": "00:29:54", "text": "他们说：“哦，我是无性恋者。”"}, {"type": "subtitle", "time": 1796.31, "timestamp": "00:29:56", "text": "所以这就是我声音听起来像那样的原因。所以，我"}, {"type": "subtitle", "time": 1797.83, "timestamp": "00:29:57", "text": "我开始把它称为一个"}]
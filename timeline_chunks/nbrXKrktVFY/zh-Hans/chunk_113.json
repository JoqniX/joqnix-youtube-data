[{"type": "subtitle", "time": 6783.03, "timestamp": "01:53:03", "text": "尾巴现在就在那里了。是的。是的。是的。"}, {"type": "subtitle", "time": 6785.43, "timestamp": "01:53:05", "text": "它们用尾巴互相摩擦"}, {"type": "subtitle", "time": 6788.39, "timestamp": "01:53:08", "text": "平衡"}, {"type": "subtitle", "time": 6791.83, "timestamp": "01:53:11", "text": "因为它们的身体太重了。"}, {"type": "subtitle", "time": 6794.47, "timestamp": "01:53:14", "text": "是的，"}, {"type": "subtitle", "time": 6798.47, "timestamp": "01:53:18", "text": "我们需要这方面的专家。是的，我们有。"}, {"type": "subtitle", "time": 6800.39, "timestamp": "01:53:20", "text": "我的意思是，我曾经是这方面的专家。比如，我"}, {"type": "subtitle", "time": 6803.189, "timestamp": "01:53:23", "text": "曾经为怪物女孩写过东西"}, {"type": "subtitle", "time": 6805.109, "timestamp": "01:53:25", "text": "百科全书。"}, {"type": "subtitle", "time": 6809.669, "timestamp": "01:53:29", "text": "哦，我在那里做了很多修改。"}, {"type": "subtitle", "time": 6813.109, "timestamp": "01:53:33", "text": "换了个名字。"}, {"type": "subtitle", "time": 6815.75, "timestamp": "01:53:35", "text": "就像我意识到自己是个书呆子的时候一样……"}, {"type": "subtitle", "time": 6817.189, "timestamp": "01:53:37", "text": "开始和其他人打架"}, {"type": "subtitle", "time": 6819.03, "timestamp": "01:53:39", "text": "在维基百科上。我和你们一样"}, {"type": "subtitle", "time": 6819.79, "timestamp": "01:53:39", "text": "不是"}, {"type": "subtitle", "time": 6822.229, "timestamp": "01:53:42", "text": "理解。这是恶魔魔力，"}, {"type": "subtitle", "time": 6823.47, "timestamp": "01:53:43", "text": "转换"}, {"type": "subtitle", "time": 6827.47, "timestamp": "01:53:47", "text": "女孩们并非因为她们生来如此"}, {"type": "subtitle", "time": 6834.47, "timestamp": "01:53:54", "text": "就像我刚才解释的那样，呃……"}, {"type": "subtitle", "time": 6837.03, "timestamp": "01:53:57", "text": "一位新来的管理员。我心想，“好吧，所以"}, {"type": "subtitle", "time": 6839.669, "timestamp": "01:53:59", "text": "听着，伙计。怪物娘们并非"}]
[{"type": "subtitle", "time": 10380.07, "timestamp": "02:53:00", "text": "和我的父母一起。我不知道"}, {"type": "subtitle", "time": 10382.55, "timestamp": "02:53:02", "text": "现在你和我一样了解这一切了。"}, {"type": "subtitle", "time": 10386.07, "timestamp": "02:53:06", "text": "美国人和外国人都去了"}, {"type": "subtitle", "time": 10388.15, "timestamp": "02:53:08", "text": "独立独立弧"}, {"type": "subtitle", "time": 10390.63, "timestamp": "02:53:10", "text": "都18岁了。"}, {"type": "subtitle", "time": 10392.63, "timestamp": "02:53:12", "text": "当我得知此事后，我"}, {"type": "subtitle", "time": 10394.59, "timestamp": "02:53:14", "text": "当时的感觉就像是，"}, {"type": "subtitle", "time": 10397.67, "timestamp": "02:53:17", "text": "什么？那就像你在付出和索取。"}, {"type": "subtitle", "time": 10401.99, "timestamp": "02:53:21", "text": "尽早获得独立"}, {"type": "subtitle", "time": 10404.389, "timestamp": "02:53:24", "text": "或者比如如何应对自己和"}, {"type": "subtitle", "time": 10407.83, "timestamp": "02:53:27", "text": "训练之类的。不。而且，不，因为"}, {"type": "subtitle", "time": 10409.83, "timestamp": "02:53:29", "text": "对我来说，这就像你的家人背叛了我一样。"}, {"type": "subtitle", "time": 10412.71, "timestamp": "02:53:32", "text": "你。感觉就像那样"}, {"type": "subtitle", "time": 10416.389, "timestamp": "02:53:36", "text": "我。是啊，还有那件事。是的，没错"}, {"type": "subtitle", "time": 10423.19, "timestamp": "02:53:43", "text": "是的。比如，如果我的父母喜欢我的话"}, {"type": "subtitle", "time": 10424.87, "timestamp": "02:53:44", "text": "感觉就是这样。如果我父母说，"}, {"type": "subtitle", "time": 10426.71, "timestamp": "02:53:46", "text": "“好了，你现在18岁了，离开家吧。”"}, {"type": "subtitle", "time": 10427.63, "timestamp": "02:53:47", "text": "我当时就想，"}, {"type": "subtitle", "time": 10429.75, "timestamp": "02:53:49", "text": "“好吧，我要告诉每一个人"}, {"type": "subtitle", "time": 10431.429, "timestamp": "02:53:51", "text": "家人，你就像在踢我一样"}, {"type": "subtitle", "time": 10433.99, "timestamp": "02:53:53", "text": "出去。”"}, {"type": "subtitle", "time": 10435.75, "timestamp": "02:53:55", "text": "我要告诉所有人"}, {"type": "subtitle", "time": 10439.11, "timestamp": "02:53:59", "text": "他们把儿子赶出了家门。"}]
[{"type": "subtitle", "time": 1567.11, "timestamp": "00:26:07", "text": "对我来说，我会说我只是做我想做的事。"}, {"type": "subtitle", "time": 1572.789, "timestamp": "00:26:12", "text": "感觉有点像。我……我……"}, {"type": "subtitle", "time": 1576.43, "timestamp": "00:26:16", "text": "我之前和一位智者一起做过播客。"}, {"type": "subtitle", "time": 1580.75, "timestamp": "00:26:20", "text": "虚拟现实，那是很久很久以前的事了。"}, {"type": "subtitle", "time": 1586.07, "timestamp": "00:26:26", "text": "虚拟主义呃，是一群呃，等等，怎么会这样"}, {"type": "subtitle", "time": 1589.269, "timestamp": "00:26:29", "text": "我该如何描述虚拟主义？我的天啊。呃"}, {"type": "subtitle", "time": 1592.47, "timestamp": "00:26:32", "text": "我们是一群独立的印度人"}, {"type": "subtitle", "time": 1594.99, "timestamp": "00:26:34", "text": "YouTuber们想要拥有"}, {"type": "subtitle", "time": 1598.87, "timestamp": "00:26:38", "text": "就像一个充满激情的项目，不得不……"}, {"type": "subtitle", "time": 1601.43, "timestamp": "00:26:41", "text": "他们和 YouTuber 们聚在一起，然后他们"}, {"type": "subtitle", "time": 1605.669, "timestamp": "00:26:45", "text": "想一起做一个项目，而我"}, {"type": "subtitle", "time": 1610.71, "timestamp": "00:26:50", "text": "我想我2022年的时候也参与其中了。你"}, {"type": "subtitle", "time": 1613.669, "timestamp": "00:26:53", "text": "思考"}, {"type": "subtitle", "time": 1615.59, "timestamp": "00:26:55", "text": "你认为你参与其中了吗？我当时"}, {"type": "subtitle", "time": 1618.47, "timestamp": "00:26:58", "text": "其中一部分。是的。所以你为什么会这么说呢？"}]
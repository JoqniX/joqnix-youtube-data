[{"type": "subtitle", "time": 8221.03, "timestamp": "02:17:01", "text": "Discord 服务器，有一个不同的呃"}, {"type": "subtitle", "time": 8225.95, "timestamp": "02:17:05", "text": "帐户。啊，我会开始问别人。"}, {"type": "subtitle", "time": 8229.589, "timestamp": "02:17:09", "text": "比如，我的狗走丢了之类的。什么"}, {"type": "subtitle", "time": 8231.629, "timestamp": "02:17:11", "text": "我应该吗？"}, {"type": "subtitle", "time": 8234.629, "timestamp": "02:17:14", "text": "男生也这样吗？有海啸"}, {"type": "subtitle", "time": 8238.469, "timestamp": "02:17:18", "text": "正在进行中。我该不该？我该不该？"}, {"type": "subtitle", "time": 8240.15, "timestamp": "02:17:20", "text": "开始学游泳之类的吗？"}, {"type": "subtitle", "time": 8241.85, "timestamp": "02:17:21", "text": "比如什么是"}, {"type": "subtitle", "time": 8243.469, "timestamp": "02:17:23", "text": "[音乐]"}, {"type": "subtitle", "time": 8246.75, "timestamp": "02:17:26", "text": "最近那里"}, {"type": "subtitle", "time": 8249.669, "timestamp": "02:17:29", "text": "好像当时发生了这样一件事……"}, {"type": "subtitle", "time": 8251.27, "timestamp": "02:17:31", "text": "你知道印度和巴基斯坦的关系吗？"}, {"type": "subtitle", "time": 8253.75, "timestamp": "02:17:33", "text": "事情就这么发生了"}, {"type": "subtitle", "time": 8258.23, "timestamp": "02:17:38", "text": "就像服务器上有人一样"}, {"type": "subtitle", "time": 8259.99, "timestamp": "02:17:39", "text": "他们在进行角色扮演，就像……"}, {"type": "subtitle", "time": 8263.91, "timestamp": "02:17:43", "text": "巴基斯坦人，我的天哪，这都什么玩意儿？"}, {"type": "subtitle", "time": 8266.87, "timestamp": "02:17:46", "text": "太搞笑了，他们都惊呼“哦不，我的天哪！”"}, {"type": "subtitle", "time": 8269.27, "timestamp": "02:17:49", "text": "我无法拥有印度女友"}, {"type": "subtitle", "time": 8271.429, "timestamp": "02:17:51", "text": "看看她。"}, {"type": "subtitle", "time": 8274.709, "timestamp": "02:17:54", "text": "我的天啊。他认为人就是人。"}, {"type": "subtitle", "time": 8277.509, "timestamp": "02:17:57", "text": "我们当时就想，好吧，听着，如果你在印度"}]
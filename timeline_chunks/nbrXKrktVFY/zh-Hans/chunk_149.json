[{"type": "subtitle", "time": 8940.23, "timestamp": "02:29:00", "text": "或者别的什么。"}, {"type": "subtitle", "time": 8944.15, "timestamp": "02:29:04", "text": "你为什么要自我过滤呢？"}, {"type": "subtitle", "time": 8947.11, "timestamp": "02:29:07", "text": "就好像你不受任何合同约束一样。"}, {"type": "subtitle", "time": 8951.03, "timestamp": "02:29:11", "text": "你没什么可失去的。"}, {"type": "subtitle", "time": 8958.15, "timestamp": "02:29:18", "text": "他们会说：“哦，我不会这么说。”"}, {"type": "subtitle", "time": 8959.67, "timestamp": "02:29:19", "text": "因为这不好。” 我心想，"}, {"type": "subtitle", "time": 8961.59, "timestamp": "02:29:21", "text": "“谁的"}, {"type": "subtitle", "time": 8963.389, "timestamp": "02:29:23", "text": "[音乐]"}, {"type": "subtitle", "time": 8965.83, "timestamp": "02:29:25", "text": "“在看吗？”我心想，“出去走走吧。”去"}, {"type": "subtitle", "time": 8967.51, "timestamp": "02:29:27", "text": "任何。假设你想讨论为什么"}, {"type": "subtitle", "time": 8970.19, "timestamp": "02:29:30", "text": "那个n开头的词是不好的。我们开始吧"}, {"type": "subtitle", "time": 8973.59, "timestamp": "02:29:33", "text": "讨论。让我们全力以赴。就像拥有一个"}, {"type": "subtitle", "time": 8975.13, "timestamp": "02:29:35", "text": "对话。"}, {"type": "subtitle", "time": 8980.71, "timestamp": "02:29:40", "text": "但有些 YouTuber 是"}, {"type": "subtitle", "time": 8982.71, "timestamp": "02:29:42", "text": "我觉得这就像一般情况一样。"}, {"type": "subtitle", "time": 8985.429, "timestamp": "02:29:45", "text": "有些人，但有些人在网上……"}, {"type": "subtitle", "time": 8988.389, "timestamp": "02:29:48", "text": "他们会进行流媒体播放，并自行过滤。"}, {"type": "subtitle", "time": 8989.91, "timestamp": "02:29:49", "text": "就像他们真的很大一样"}, {"type": "subtitle", "time": 8991.75, "timestamp": "02:29:51", "text": "大型主播们必须"}, {"type": "subtitle", "time": 8993.67, "timestamp": "02:29:53", "text": "这样做是因为他们必须维护……"}, {"type": "subtitle", "time": 8995.51, "timestamp": "02:29:55", "text": "因为他们的受众群体庞大。"}, {"type": "subtitle", "time": 8997.99, "timestamp": "02:29:57", "text": "那里还有一些孩子。"}]
[{"type": "subtitle", "time": 2282.39, "timestamp": "00:38:02", "text": "“好吧，听着。如果你不想让我……”"}, {"type": "subtitle", "time": 2283.63, "timestamp": "00:38:03", "text": "离开"}, {"type": "subtitle", "time": 2286.71, "timestamp": "00:38:06", "text": "房子，我将做两年这样的事"}, {"type": "subtitle", "time": 2289.51, "timestamp": "00:38:09", "text": "我想做，但就像你不想做一样。"}, {"type": "subtitle", "time": 2290.87, "timestamp": "00:38:10", "text": "必须经济上支持我，"}, {"type": "subtitle", "time": 2293.51, "timestamp": "00:38:13", "text": "任何。我只想这样做，"}, {"type": "subtitle", "time": 2295.67, "timestamp": "00:38:15", "text": "让我们看看事情会如何发展。”所以，为什么我"}, {"type": "subtitle", "time": 2299.19, "timestamp": "00:38:19", "text": "应用于此，呃，有了这个新的"}, {"type": "subtitle", "time": 2301.99, "timestamp": "00:38:21", "text": "我们城市有一家化妆品分店。我"}, {"type": "subtitle", "time": 2303.91, "timestamp": "00:38:23", "text": "我申请了那里的工作，得到了这份工作，然后……"}, {"type": "subtitle", "time": 2307.069, "timestamp": "00:38:27", "text": "不知怎么的，就当了经理。我不知道"}, {"type": "subtitle", "time": 2309.829, "timestamp": "00:38:29", "text": "我就这样开始和他们一起工作。"}, {"type": "subtitle", "time": 2312.87, "timestamp": "00:38:32", "text": "然后新冠疫情爆发了，之后我感染了新冠病毒。"}, {"type": "subtitle", "time": 2314.71, "timestamp": "00:38:34", "text": "被录取从事平面设计工作"}, {"type": "subtitle", "time": 2316.95, "timestamp": "00:38:36", "text": "公司。"}, {"type": "subtitle", "time": 2318.71, "timestamp": "00:38:38", "text": "所以我开始赚到足够的钱，"}, {"type": "subtitle", "time": 2320.63, "timestamp": "00:38:40", "text": "我父母当时就说，你知道该怎么做吗？"}, {"type": "subtitle", "time": 2323.27, "timestamp": "00:38:43", "text": "随你便。"}, {"type": "subtitle", "time": 2334.31, "timestamp": "00:38:54", "text": "这真是太酷了。是的。有点儿"}, {"type": "subtitle", "time": 2336.15, "timestamp": "00:38:56", "text": "这让我很难过，因为我有朋友，"}, {"type": "subtitle", "time": 2338.069, "timestamp": "00:38:58", "text": "他们的父母甚至不允许他们这样做"}, {"type": "subtitle", "time": 2339.069, "timestamp": "00:38:59", "text": "离开"}]
[{"type": "subtitle", "time": 9123.349, "timestamp": "02:32:03", "text": "就像阿斯明对待他的聊天对象一样"}, {"type": "subtitle", "time": 9124.429, "timestamp": "02:32:04", "text": "并非所有"}, {"type": "subtitle", "time": 9126.71, "timestamp": "02:32:06", "text": "哑的。有些聪明人，但是"}, {"type": "subtitle", "time": 9129.55, "timestamp": "02:32:09", "text": "他们大多很笨。"}, {"type": "subtitle", "time": 9131.99, "timestamp": "02:32:11", "text": "人们。所以当有人说"}, {"type": "subtitle", "time": 9133.75, "timestamp": "02:32:13", "text": "他为他们提供了一个平台。"}, {"type": "subtitle", "time": 9135.19, "timestamp": "02:32:15", "text": "谈谈这件事。好的。你为什么要这么做？"}, {"type": "subtitle", "time": 9137.11, "timestamp": "02:32:17", "text": "你说这话？就像他会把他们拉起来一样"}, {"type": "subtitle", "time": 9139.67, "timestamp": "02:32:19", "text": "好吧，你为什么要这么说？"}, {"type": "subtitle", "time": 9142.469, "timestamp": "02:32:22", "text": "啊，是的，我注意到了。是的。就像它"}, {"type": "subtitle", "time": 9144.469, "timestamp": "02:32:24", "text": "会把他们叫过来问问题"}, {"type": "subtitle", "time": 9146.71, "timestamp": "02:32:26", "text": "向其他人展示如何互动"}, {"type": "subtitle", "time": 9150.309, "timestamp": "02:32:30", "text": "聊天内容，请勿发送垃圾信息或点赞/通话"}, {"type": "subtitle", "time": 9152.309, "timestamp": "02:32:32", "text": "姓名。如果你想讨论什么，"}, {"type": "subtitle", "time": 9155.11, "timestamp": "02:32:35", "text": "阿斯敏会听你的。"}, {"type": "subtitle", "time": 9158.389, "timestamp": "02:32:38", "text": "如果你的东西值得一提的话"}, {"type": "subtitle", "time": 9160.469, "timestamp": "02:32:40", "text": "如果他读了，他就会谈论这件事。"}, {"type": "subtitle", "time": 9168.55, "timestamp": "02:32:48", "text": "这就是我喜欢它的原因。喜欢"}, {"type": "subtitle", "time": 9171.51, "timestamp": "02:32:51", "text": "呃，聊天互动就像对待你一样"}, {"type": "subtitle", "time": 9175.83, "timestamp": "02:32:55", "text": "用他们想要的方式聊天，就像你希望他们那样。"}]
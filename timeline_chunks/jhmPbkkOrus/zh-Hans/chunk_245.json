[{"type": "subtitle", "time": 14713.55, "timestamp": "04:05:13", "text": "只剩60秒了。哦，我们明白了"}, {"type": "subtitle", "time": 14716.229, "timestamp": "04:05:16", "text": "男孩到达了检查站。继续保持"}, {"type": "subtitle", "time": 14719.269, "timestamp": "04:05:19", "text": "势头。复仇者大厦。我不是"}, {"type": "subtitle", "time": 14722.429, "timestamp": "04:05:22", "text": "欢迎光临。为什么是自动模式？"}, {"type": "subtitle", "time": 14729.03, "timestamp": "04:05:29", "text": "抱歉了，查德。我看不懂你，因为我"}, {"type": "subtitle", "time": 14731.03, "timestamp": "04:05:31", "text": "就像太专注了，如果我有一个"}, {"type": "subtitle", "time": 14743.189, "timestamp": "04:05:43", "text": "哦，他死了。哦，他死了。快点。"}]
[{"type": "subtitle", "time": 17106.15, "timestamp": "04:45:06", "text": "对，是浣熊。是的，它要来了。"}, {"type": "subtitle", "time": 17117.83, "timestamp": "04:45:17", "text": "是的。我七岁零分。我挺不错的"}, {"type": "subtitle", "time": 17121.27, "timestamp": "04:45:21", "text": "伙计，在这场比赛中。我回来了。是的。"}, {"type": "subtitle", "time": 17123.75, "timestamp": "04:45:23", "text": "我的天哪，他回来了。他听起来"}, {"type": "subtitle", "time": 17125.43, "timestamp": "04:45:25", "text": "郁闷。"}, {"type": "subtitle", "time": 17129.628, "timestamp": "04:45:29", "text": "是的，我被禁赛两天。"}, {"type": "subtitle", "time": 17133.27, "timestamp": "04:45:33", "text": "为什么？原因是什么？它认为我是"}, {"type": "subtitle", "time": 17135.67, "timestamp": "04:45:35", "text": "AFK。"}, {"type": "subtitle", "time": 17138.39, "timestamp": "04:45:38", "text": "我做了。是的，你刚才在说话。是吗？"}, {"type": "subtitle", "time": 17141.19, "timestamp": "04:45:41", "text": "因为模型没动，兄弟？"}, {"type": "subtitle", "time": 17144.31, "timestamp": "04:45:44", "text": "这些人是谁？他们是谁？他们是人工智能吗？"}, {"type": "subtitle", "time": 17146.55, "timestamp": "04:45:46", "text": "这是实际的使用手册吗？"}, {"type": "subtitle", "time": 17149.51, "timestamp": "04:45:49", "text": "是因为我喜欢问问题吗？"}, {"type": "subtitle", "time": 17153.19, "timestamp": "04:45:53", "text": "是不是有人问过我，为什么没有这种感觉？"}, {"type": "subtitle", "time": 17155.9, "timestamp": "04:45:55", "text": "客服之类的？"}, {"type": "subtitle", "time": 17158.15, "timestamp": "04:45:58", "text": "[音乐]"}]
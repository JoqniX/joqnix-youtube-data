[{"type": "subtitle", "time": 11886.429, "timestamp": "03:18:06", "text": "你。巴基表现好吗？"}, {"type": "subtitle", "time": 11887.59, "timestamp": "03:18:07", "text": "有变化吗？全部"}, {"type": "subtitle", "time": 11896.389, "timestamp": "03:18:16", "text": "正确的。所以，我们正在让布鲁斯屈服。是吗？"}, {"type": "subtitle", "time": 11903.75, "timestamp": "03:18:23", "text": "所以，别为此感到难过。"}, {"type": "subtitle", "time": 11906.71, "timestamp": "03:18:26", "text": "没关系。这种情况屡见不鲜。"}, {"type": "subtitle", "time": 11910.75, "timestamp": "03:18:30", "text": "我们都会犯错，你知道的。所以"}, {"type": "subtitle", "time": 11921.389, "timestamp": "03:18:41", "text": "玩？我应该玩吗？"}, {"type": "subtitle", "time": 11929.91, "timestamp": "03:18:49", "text": "我不是那种悄无声息地消失的人。"}, {"type": "subtitle", "time": 11936.11, "timestamp": "03:18:56", "text": "背景。耶稣"}, {"type": "subtitle", "time": 11939.55, "timestamp": "03:18:59", "text": "基督。妈的。彼此信任。"}, {"type": "chat", "time": 11939.967, "timestamp": "03:18:59", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "joq are you just silent or..."}]
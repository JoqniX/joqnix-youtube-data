[{"type": "subtitle", "time": 16870.15, "timestamp": "04:41:10", "text": "如果我们的小组可以像他那样做些事情的话"}, {"type": "subtitle", "time": 16872.75, "timestamp": "04:41:12", "text": "我自己，我会切换到"}, {"type": "subtitle", "time": 16875.868, "timestamp": "04:41:15", "text": "输出伤害。是 Yonder"}, {"type": "subtitle", "time": 16879.51, "timestamp": "04:41:19", "text": "那里？是Yond，哦，那个"}, {"type": "subtitle", "time": 16882.31, "timestamp": "04:41:22", "text": "球。好的。好的。吹哨子的人。"}, {"type": "subtitle", "time": 16884.39, "timestamp": "04:41:24", "text": "不，而且我认为他不会在。"}, {"type": "subtitle", "time": 16887.35, "timestamp": "04:41:27", "text": "因为他的能力就像……"}, {"type": "subtitle", "time": 16892.31, "timestamp": "04:41:32", "text": "我们看到勇度开始吹口哨"}, {"type": "subtitle", "time": 16895.67, "timestamp": "04:41:35", "text": "每个人都只有一枪毙命。"}, {"type": "subtitle", "time": 16897.75, "timestamp": "04:41:37", "text": "这就是事情的经过。"}, {"type": "subtitle", "time": 16899.83, "timestamp": "04:41:39", "text": "所以我觉得勇度不会出现在这部电影里。"}, {"type": "subtitle", "time": 16907.83, "timestamp": "04:41:47", "text": "所以，这些人到底在说什么？"}]
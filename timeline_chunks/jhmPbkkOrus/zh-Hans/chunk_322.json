[{"type": "subtitle", "time": 19323.27, "timestamp": "05:22:03", "text": "问。你刚才就问了。"}, {"type": "subtitle", "time": 19325.51, "timestamp": "05:22:05", "text": "我什么都没问你。我喜欢"}, {"type": "subtitle", "time": 19328.39, "timestamp": "05:22:08", "text": "你刚才说什么？"}, {"type": "subtitle", "time": 19331.67, "timestamp": "05:22:11", "text": "哦好的。那真是太好了。不，是"}, {"type": "subtitle", "time": 19341.27, "timestamp": "05:22:21", "text": "我的天哪。好吧，那我算是完了。"}, {"type": "subtitle", "time": 19343.91, "timestamp": "05:22:23", "text": "今天。我现在要去买脚本了。"}, {"type": "subtitle", "time": 19345.43, "timestamp": "05:22:25", "text": "嗯？"}, {"type": "subtitle", "time": 19349.03, "timestamp": "05:22:29", "text": "我接管的时候，我得了面包。"}, {"type": "subtitle", "time": 19352.628, "timestamp": "05:22:32", "text": "当时正在吃午饭什么的。"}, {"type": "subtitle", "time": 19357.35, "timestamp": "05:22:37", "text": "说你。我为什么这么说？是的。"}, {"type": "subtitle", "time": 19361.51, "timestamp": "05:22:41", "text": "我为什么要这么说？你确实说过这话。"}, {"type": "subtitle", "time": 19365.75, "timestamp": "05:22:45", "text": "为什么？我为什么要这么说？好的。不。"}, {"type": "subtitle", "time": 19366.75, "timestamp": "05:22:46", "text": "我为什么要这么做？"}, {"type": "subtitle", "time": 19370.708, "timestamp": "05:22:50", "text": "说？我为什么要那样做？"}, {"type": "subtitle", "time": 19373.59, "timestamp": "05:22:53", "text": "我为什么要那样做？这个人。嘿。哦"}, {"type": "subtitle", "time": 19375.27, "timestamp": "05:22:55", "text": "我的上帝。我必须发泄一下，"}]
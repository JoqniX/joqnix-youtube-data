[{"type": "subtitle", "time": 18601.59, "timestamp": "05:10:01", "text": "呃，我的肚子呢？我当时手里拿着模型。"}, {"type": "subtitle", "time": 18603.99, "timestamp": "05:10:03", "text": "就像卡住了，就像关闭了我的"}, {"type": "subtitle", "time": 18606.628, "timestamp": "05:10:06", "text": "眼睛，就像PNG之类的东西。"}, {"type": "subtitle", "time": 18609.35, "timestamp": "05:10:09", "text": "不，我以为我会没事的。但"}, {"type": "subtitle", "time": 18611.59, "timestamp": "05:10:11", "text": "显然这样做是不行的。"}, {"type": "subtitle", "time": 18613.99, "timestamp": "05:10:13", "text": "我还问了QQ群里的一些人。"}, {"type": "subtitle", "time": 18616.708, "timestamp": "05:10:16", "text": "他们就像是可信地提供了"}, {"type": "subtitle", "time": 18619.51, "timestamp": "05:10:19", "text": "超过一百个免费模型"}, {"type": "subtitle", "time": 18622.788, "timestamp": "05:10:22", "text": "为想要做这件事的人提供的平台"}, {"type": "subtitle", "time": 18625.27, "timestamp": "05:10:25", "text": "他们应该使用免费的"}, {"type": "subtitle", "time": 18627.11, "timestamp": "05:10:27", "text": "模特和模特在直播和玩耍"}, {"type": "subtitle", "time": 18629.59, "timestamp": "05:10:29", "text": "游戏等等。如果它一动不动"}, {"type": "subtitle", "time": 18632.31, "timestamp": "05:10:32", "text": "然后它就被视为类似于AFK或"}, {"type": "subtitle", "time": 18634.628, "timestamp": "05:10:34", "text": "某物。如果你挂机，你必须输入"}, {"type": "subtitle", "time": 18637.35, "timestamp": "05:10:37", "text": "屏幕上有你正在拍摄的东西"}, {"type": "subtitle", "time": 18640.47, "timestamp": "05:10:40", "text": "坏掉或者其他什么。哦，所以你不能这样做"}, {"type": "subtitle", "time": 18644.628, "timestamp": "05:10:44", "text": "是的，就是那里。好的。为什么会这样"}, {"type": "subtitle", "time": 18646.868, "timestamp": "05:10:46", "text": "平台？"}, {"type": "subtitle", "time": 18649.59, "timestamp": "05:10:49", "text": "你看到了吗？等等，这有多长？"}, {"type": "subtitle", "time": 18653.19, "timestamp": "05:10:53", "text": "惩罚？呃呃，就像……我可以直播"}, {"type": "subtitle", "time": 18655.708, "timestamp": "05:10:55", "text": "即使现在也是如此。更像是我不会得到"}, {"type": "subtitle", "time": 18658.628, "timestamp": "05:10:58", "text": "推荐给其他人使用两天。哦。"}]
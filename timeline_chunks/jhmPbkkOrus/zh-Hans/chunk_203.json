[{"type": "subtitle", "time": 12180.469, "timestamp": "03:23:00", "text": "我的天啊。赶紧用起来吧？"}, {"type": "subtitle", "time": 12182.469, "timestamp": "03:23:02", "text": "我的天啊。"}, {"type": "subtitle", "time": 12185.03, "timestamp": "03:23:05", "text": "你本来可以赢的。我不是我"}, {"type": "subtitle", "time": 12186.63, "timestamp": "03:23:06", "text": "我觉得我没事，兄弟。是的，"}, {"type": "subtitle", "time": 12188.389, "timestamp": "03:23:08", "text": "字面上地。对，就是这个原因。或许你"}, {"type": "subtitle", "time": 12192.87, "timestamp": "03:23:12", "text": "应该把“呃”换成“呃，是的”。"}, {"type": "subtitle", "time": 12194.87, "timestamp": "03:23:14", "text": "是的。"}, {"type": "subtitle", "time": 12236.63, "timestamp": "03:23:56", "text": "护盾破了。护盾破了。"}]
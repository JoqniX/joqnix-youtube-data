[{"type": "subtitle", "time": 18241.99, "timestamp": "05:04:01", "text": "我的天啊。抱歉各位，这段时间没怎么说话。"}, {"type": "subtitle", "time": 18245.19, "timestamp": "05:04:05", "text": "狗会说话。你为什么不说话？"}, {"type": "subtitle", "time": 18248.47, "timestamp": "05:04:08", "text": "我只是在打字。对不起。"}, {"type": "subtitle", "time": 18249.99, "timestamp": "05:04:09", "text": "该死，你一句话都没说。我有我的"}, {"type": "subtitle", "time": 18251.35, "timestamp": "05:04:11", "text": "最终的。我认为我们只需要坚持下去。"}, {"type": "subtitle", "time": 18257.99, "timestamp": "05:04:17", "text": "哦，等等。我们现在有两个输出位。绝不"}, {"type": "subtitle", "time": 18265.99, "timestamp": "05:04:25", "text": "哦，这是哪一个？"}, {"type": "subtitle", "time": 18269.99, "timestamp": "05:04:29", "text": "这大概就是你，呃……"}, {"type": "subtitle", "time": 18272.15, "timestamp": "05:04:32", "text": "新加坡混血，因为我喜欢这种口味"}, {"type": "subtitle", "time": 18295.03, "timestamp": "05:04:55", "text": "我准备好了，我可以赢你一次。"}]
[{"type": "subtitle", "time": 19201.83, "timestamp": "05:20:01", "text": "视频。你必须拥有版权。"}, {"type": "subtitle", "time": 19203.99, "timestamp": "05:20:03", "text": "嗯？"}, {"type": "subtitle", "time": 19206.47, "timestamp": "05:20:06", "text": "什么？这意味着什么？我可以要吗？"}, {"type": "subtitle", "time": 19209.35, "timestamp": "05:20:09", "text": "布拉德，这是你的版权许可。"}, {"type": "subtitle", "time": 19211.99, "timestamp": "05:20:11", "text": "正在播放你的视频吗？"}, {"type": "subtitle", "time": 19214.868, "timestamp": "05:20:14", "text": "是的，你确实有。你必须喜欢这个"}, {"type": "subtitle", "time": 19219.23, "timestamp": "05:20:19", "text": "太大了。这是什么？"}, {"type": "subtitle", "time": 19222.43, "timestamp": "05:20:22", "text": "兄弟？这是一个平台。"}, {"type": "subtitle", "time": 19226.788, "timestamp": "05:20:26", "text": "疯狂的。我的天啊。 M需要我的许可"}, {"type": "subtitle", "time": 19232.03, "timestamp": "05:20:32", "text": "就像直播我的世界一样。那是"}, {"type": "subtitle", "time": 19234.47, "timestamp": "05:20:34", "text": "疯狂的。你在看这个聊天记录吗？如果"}, {"type": "subtitle", "time": 19236.11, "timestamp": "05:20:36", "text": "你不知道，这些是"}, {"type": "subtitle", "time": 19238.35, "timestamp": "05:20:38", "text": "治疗师。如果你不知道"}, {"type": "subtitle", "time": 19241.27, "timestamp": "05:20:41", "text": "百夫长，就像我投入了很多“像”"}, {"type": "subtitle", "time": 19243.67, "timestamp": "05:20:43", "text": "需要花点时间。百夫长。两位治疗师。"}, {"type": "subtitle", "time": 19246.15, "timestamp": "05:20:46", "text": "我的天哪。"}, {"type": "subtitle", "time": 19249.43, "timestamp": "05:20:49", "text": "一、二、三、四、五。我认为"}, {"type": "subtitle", "time": 19251.23, "timestamp": "05:20:51", "text": "火箭即将……"}, {"type": "subtitle", "time": 19254.708, "timestamp": "05:20:54", "text": "百夫长。还有600人。亚当呢？"}, {"type": "subtitle", "time": 19257.91, "timestamp": "05:20:57", "text": "亚当快到了。好的。就是不行"}]
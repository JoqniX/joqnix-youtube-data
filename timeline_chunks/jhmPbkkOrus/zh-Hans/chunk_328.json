[{"type": "subtitle", "time": 19681.07, "timestamp": "05:28:01", "text": "取消。别忘了"}, {"type": "subtitle", "time": 19685.75, "timestamp": "05:28:05", "text": "那。真是见鬼了。好的。再见，各位。"}, {"type": "subtitle", "time": 19688.628, "timestamp": "05:28:08", "text": "再见。小心。"}, {"type": "subtitle", "time": 19690.788, "timestamp": "05:28:10", "text": "我希望你去做前列腺检查。哦，"}, {"type": "subtitle", "time": 19693.75, "timestamp": "05:28:13", "text": "请离开。"}, {"type": "subtitle", "time": 19696.47, "timestamp": "05:28:16", "text": "好吧。我也要走了。"}, {"type": "subtitle", "time": 19699.67, "timestamp": "05:28:19", "text": "谢谢。谢谢你"}, {"type": "subtitle", "time": 19703.03, "timestamp": "05:28:23", "text": "谢谢你今天抽出时间。你听起来很累。我"}, {"type": "subtitle", "time": 19705.27, "timestamp": "05:28:25", "text": "做。"}, {"type": "subtitle", "time": 19708.15, "timestamp": "05:28:28", "text": "是的，我总是"}, {"type": "subtitle", "time": 19711.43, "timestamp": "05:28:31", "text": "我不知道。这是真的。"}, {"type": "subtitle", "time": 19715.19, "timestamp": "05:28:35", "text": "那我想周六就能见到你了。"}, {"type": "subtitle", "time": 19717.51, "timestamp": "05:28:37", "text": "周六。"}, {"type": "subtitle", "time": 19720.23, "timestamp": "05:28:40", "text": "是啊，那时候我才有空，我可以"}, {"type": "subtitle", "time": 19722.788, "timestamp": "05:28:42", "text": "来。呃，你有什么关于……的吗？"}, {"type": "subtitle", "time": 19725.75, "timestamp": "05:28:45", "text": "星期五？"}, {"type": "subtitle", "time": 19729.19, "timestamp": "05:28:49", "text": "呃，周四我把那份VC文件准备好了。"}, {"type": "subtitle", "time": 19731.07, "timestamp": "05:28:51", "text": "周六。有一个"}, {"type": "subtitle", "time": 19733.91, "timestamp": "05:28:53", "text": "5点合作。对，他是这么说的。"}, {"type": "subtitle", "time": 19737.788, "timestamp": "05:28:57", "text": "现在。周六。罗科。里约热内卢。"}]
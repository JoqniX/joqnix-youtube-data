[{"type": "subtitle", "time": 14771.189, "timestamp": "04:06:11", "text": "等等。得到它。好好尝尝这个滋味吧。吮吸"}, {"type": "subtitle", "time": 14782.63, "timestamp": "04:06:22", "text": "唉，我对此无能为力。我"}, {"type": "subtitle", "time": 14784.15, "timestamp": "04:06:24", "text": "只能等待重生，但是他们是"}, {"type": "subtitle", "time": 14787.189, "timestamp": "04:06:27", "text": "正在处理重生问题。我想要你的灵魂。"}, {"type": "subtitle", "time": 14789.429, "timestamp": "04:06:29", "text": "患病的"}, {"type": "subtitle", "time": 14790.87, "timestamp": "04:06:30", "text": "哦，不错。你可以得到它。你可以"}, {"type": "subtitle", "time": 14793.429, "timestamp": "04:06:33", "text": "得到它。又让我失望了。我想要传送门"}, {"type": "subtitle", "time": 14795.87, "timestamp": "04:06:35", "text": "现在正巧，因为我的球队差点就赢了。"}, {"type": "subtitle", "time": 14798.79, "timestamp": "04:06:38", "text": "观点。我要去跑步了。我有备用账号。"}, {"type": "subtitle", "time": 14801.189, "timestamp": "04:06:41", "text": "已经。它拥有一切。好的，这是"}, {"type": "subtitle", "time": 14802.07, "timestamp": "04:06:42", "text": "会好的。这将……"}, {"type": "subtitle", "time": 14803.59, "timestamp": "04:06:43", "text": "好的。这将会是件好事。哦，我的"}, {"type": "subtitle", "time": 14804.95, "timestamp": "04:06:44", "text": "天哪，我们已经有两个选秀权了。好的，"}, {"type": "subtitle", "time": 14807.11, "timestamp": "04:06:47", "text": "好的，好的。好的。好的。好的。好的。哦，"}, {"type": "subtitle", "time": 14808.59, "timestamp": "04:06:48", "text": "没关系。他是"}, {"type": "subtitle", "time": 14811.269, "timestamp": "04:06:51", "text": "后退。那个敌人将会……"}, {"type": "subtitle", "time": 14816.229, "timestamp": "04:06:56", "text": "可能洛基需要喜欢"}, {"type": "subtitle", "time": 14817.67, "timestamp": "04:06:57", "text": "不，他要放手一搏。他，看看他。"}, {"type": "subtitle", "time": 14819.67, "timestamp": "04:06:59", "text": "看看他。他要放手一搏了。而他"}]
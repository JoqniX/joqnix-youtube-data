[{"type": "subtitle", "time": 1692.54, "timestamp": "00:28:12", "text": "已连接且已连接"}, {"type": "subtitle", "time": 1706.51, "timestamp": "00:28:26", "text": "男。萨米"}, {"type": "subtitle", "time": 1709.51, "timestamp": "00:28:29", "text": "桥。我的天啊。我的天啊。我的天啊。"}, {"type": "subtitle", "time": 1711.75, "timestamp": "00:28:31", "text": "如果有效的话，那就太好了。如果可行，我就去"}]
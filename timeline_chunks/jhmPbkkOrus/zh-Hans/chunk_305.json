[{"type": "subtitle", "time": 18332.19, "timestamp": "05:05:32", "text": "我的天哪，她一枪毙命。她是"}, {"type": "subtitle", "time": 18341.83, "timestamp": "05:05:41", "text": "是啊，小子。她也离得太远了。"}, {"type": "subtitle", "time": 18349.35, "timestamp": "05:05:49", "text": "这里是个好地方。欢迎来到"}, {"type": "subtitle", "time": 18351.43, "timestamp": "05:05:51", "text": "不速之客。你已经准备好了"}, {"type": "subtitle", "time": 18355.03, "timestamp": "05:05:55", "text": "行动。真是及时。"}]
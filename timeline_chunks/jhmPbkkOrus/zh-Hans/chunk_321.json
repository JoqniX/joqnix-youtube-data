[{"type": "subtitle", "time": 19260.788, "timestamp": "05:21:00", "text": "杰夫。说实话，杰夫真是个混蛋。"}, {"type": "subtitle", "time": 19263.35, "timestamp": "05:21:03", "text": "不。而且，我不是种族主义者，所以我不是。"}, {"type": "subtitle", "time": 19266.55, "timestamp": "05:21:06", "text": "我要扮演杰夫。杰夫很棒，兄弟。"}, {"type": "subtitle", "time": 19278.47, "timestamp": "05:21:18", "text": "什么？对不起。为什么杰夫是种族主义者？什么？"}, {"type": "subtitle", "time": 19280.628, "timestamp": "05:21:20", "text": "不，不，不。只有种族主义者才会那样做。"}, {"type": "subtitle", "time": 19282.23, "timestamp": "05:21:22", "text": "特点。"}, {"type": "subtitle", "time": 19284.07, "timestamp": "05:21:24", "text": "嗯？"}, {"type": "subtitle", "time": 19286.868, "timestamp": "05:21:26", "text": "嘿，这是什么鬼？我的天哪。"}, {"type": "subtitle", "time": 19288.868, "timestamp": "05:21:28", "text": "我的天啊。看看这个。这是黄金"}, {"type": "subtitle", "time": 19296.55, "timestamp": "05:21:36", "text": "哇，"}, {"type": "subtitle", "time": 19298.708, "timestamp": "05:21:38", "text": "这是个好主意"}, {"type": "subtitle", "time": 19300.948, "timestamp": "05:21:40", "text": "这太好了，你看到了吗？"}, {"type": "subtitle", "time": 19305.03, "timestamp": "05:21:45", "text": "这是推特上粉丝创作的螳螂女和洛基的同人作品吗？"}, {"type": "subtitle", "time": 19307.83, "timestamp": "05:21:47", "text": "哦，太恶心了。那真是太恶心了。"}, {"type": "subtitle", "time": 19310.868, "timestamp": "05:21:50", "text": "粉丝作品。兄弟正在使用 兄弟正在使用"}, {"type": "subtitle", "time": 19313.75, "timestamp": "05:21:53", "text": "叽叽喳喳。我永远不可能"}, {"type": "subtitle", "time": 19318.07, "timestamp": "05:21:58", "text": "什么？老兄，我永远也用不上推特。"}, {"type": "subtitle", "time": 19319.31, "timestamp": "05:21:59", "text": "婊子，没人"}]
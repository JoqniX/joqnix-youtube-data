[{"type": "subtitle", "time": 18962.15, "timestamp": "05:16:02", "text": "做虚拟主播。嗯"}, {"type": "subtitle", "time": 18967.99, "timestamp": "05:16:07", "text": "呃呃，它叫什么来着？呃，这个节目，"}, {"type": "subtitle", "time": 18970.788, "timestamp": "05:16:10", "text": "正确的？真人秀或类似游戏节目"}, {"type": "subtitle", "time": 18974.948, "timestamp": "05:16:14", "text": "算是吧？是的。"}, {"type": "subtitle", "time": 18979.11, "timestamp": "05:16:19", "text": "那它叫什么呢？所以，嗯，所以"}, {"type": "subtitle", "time": 18981.83, "timestamp": "05:16:21", "text": "等等，假设我正在直播，但是……"}, {"type": "subtitle", "time": 18984.628, "timestamp": "05:16:24", "text": "一件事情。所以我让其他人"}, {"type": "subtitle", "time": 18987.75, "timestamp": "05:16:27", "text": "参与者或我的朋友接管"}, {"type": "subtitle", "time": 18989.708, "timestamp": "05:16:29", "text": "我的直播间，对吧？"}, {"type": "subtitle", "time": 18992.628, "timestamp": "05:16:32", "text": "但这可以看作是类似的事情。"}, {"type": "subtitle", "time": 18994.628, "timestamp": "05:16:34", "text": "当谈到这些现实时"}, {"type": "subtitle", "time": 18996.948, "timestamp": "05:16:36", "text": "节目，或者像游戏节目之类的，"}, {"type": "subtitle", "time": 19000.31, "timestamp": "05:16:40", "text": "正确的？内容已开启，对吧？类似，"}, {"type": "subtitle", "time": 19004.19, "timestamp": "05:16:44", "text": "正确的？它不是。嗯。"}, {"type": "subtitle", "time": 19007.43, "timestamp": "05:16:47", "text": "嗯？那是什么？那东西也是"}, {"type": "subtitle", "time": 19011.59, "timestamp": "05:16:51", "text": "本平台不允许这样做。什么？"}, {"type": "subtitle", "time": 19015.35, "timestamp": "05:16:55", "text": "谁知道呢，伙计。谁知道呢？它说它"}, {"type": "subtitle", "time": 19017.91, "timestamp": "05:16:57", "text": "已发表在一篇文章中"}]
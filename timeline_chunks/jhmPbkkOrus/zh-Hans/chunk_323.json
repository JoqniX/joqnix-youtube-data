[{"type": "subtitle", "time": 19381.27, "timestamp": "05:23:01", "text": "我以后会发泄一番，但今天不会。"}, {"type": "subtitle", "time": 19384.55, "timestamp": "05:23:04", "text": "我会的，我会让自己冷静下来。"}, {"type": "subtitle", "time": 19386.948, "timestamp": "05:23:06", "text": "顺便说一句，我不会撒谎。它是"}, {"type": "subtitle", "time": 19389.23, "timestamp": "05:23:09", "text": "很难"}, {"type": "subtitle", "time": 19391.99, "timestamp": "05:23:11", "text": "雷奇。很难联系到聊天室。这很难"}, {"type": "subtitle", "time": 19395.788, "timestamp": "05:23:15", "text": "当您在多个设备上观看流媒体时，即可达到目标"}, {"type": "subtitle", "time": 19398.39, "timestamp": "05:23:18", "text": "平台。是的，我报告了一个错误。"}, {"type": "subtitle", "time": 19401.27, "timestamp": "05:23:21", "text": "车内聊天。他们会调查此事。"}, {"type": "subtitle", "time": 19403.27, "timestamp": "05:23:23", "text": "不久。"}, {"type": "subtitle", "time": 19405.67, "timestamp": "05:23:25", "text": "那时候我就想，你知道，你"}, {"type": "subtitle", "time": 19408.23, "timestamp": "05:23:28", "text": "知道就像那个梗一样，就像……"}, {"type": "subtitle", "time": 19411.83, "timestamp": "05:23:31", "text": "你给父母看了一个表情包，然后你"}, {"type": "subtitle", "time": 19414.47, "timestamp": "05:23:34", "text": "它们就像弯腰眯眼一样。"}, {"type": "subtitle", "time": 19416.23, "timestamp": "05:23:36", "text": "他们的眼睛。这就是我做的事。"}, {"type": "subtitle", "time": 19418.39, "timestamp": "05:23:38", "text": "当我阅读聊天记录时，因为我看不到"}, {"type": "subtitle", "time": 19419.91, "timestamp": "05:23:39", "text": "任何事物。"}, {"type": "subtitle", "time": 19422.55, "timestamp": "05:23:42", "text": "你这个该死的老家伙。"}, {"type": "subtitle", "time": 19424.15, "timestamp": "05:23:44", "text": "闭嘴，我比你年轻。"}, {"type": "subtitle", "time": 19425.67, "timestamp": "05:23:45", "text": "贱人。"}, {"type": "subtitle", "time": 19427.99, "timestamp": "05:23:47", "text": "你是什​​么意思？"}, {"type": "subtitle", "time": 19430.788, "timestamp": "05:23:50", "text": "是的。好的。你现在切换屏幕了吗？"}, {"type": "subtitle", "time": 19432.788, "timestamp": "05:23:52", "text": "因为我感觉快要结束了。好的。好的。"}, {"type": "subtitle", "time": 19436.47, "timestamp": "05:23:56", "text": "是的，你可以……就这么结束。"}, {"type": "subtitle", "time": 19438.628, "timestamp": "05:23:58", "text": "好了，直播就到此结束。"}]
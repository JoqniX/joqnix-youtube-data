[{"type": "subtitle", "time": 19500.55, "timestamp": "05:25:00", "text": "会努力的，呃，他们不会。"}, {"type": "subtitle", "time": 19503.27, "timestamp": "05:25:03", "text": "他没给我一个大概的日期，但是"}, {"type": "subtitle", "time": 19507.11, "timestamp": "05:25:07", "text": "他们说他们会尝试织一张网"}, {"type": "subtitle", "time": 19509.99, "timestamp": "05:25:09", "text": "把继电器之类的东西挂上去。所以我就"}, {"type": "subtitle", "time": 19511.91, "timestamp": "05:25:11", "text": "需要把它和我的软件连接起来。"}, {"type": "subtitle", "time": 19515.43, "timestamp": "05:25:15", "text": "萨米那玩意儿。哦好的。所以，你就可以"}, {"type": "subtitle", "time": 19518.15, "timestamp": "05:25:18", "text": "就像所有的一切，所有的聊天记录，所有的……"}, {"type": "subtitle", "time": 19521.67, "timestamp": "05:25:21", "text": "然后我就可以把它放到 Discord 里了。"}, {"type": "subtitle", "time": 19526.15, "timestamp": "05:25:26", "text": "我可以登录，但我不知道该怎么做。"}, {"type": "subtitle", "time": 19528.948, "timestamp": "05:25:28", "text": "如果他们能够用原始材料做到的话"}, {"type": "subtitle", "time": 19531.99, "timestamp": "05:25:31", "text": "呃，原始评论，然后我会让他们有他们"}, {"type": "subtitle", "time": 19533.43, "timestamp": "05:25:33", "text": "已经有了聊天翻译"}, {"type": "subtitle", "time": 19535.91, "timestamp": "05:25:35", "text": "没有这个功能，所以我打算问一次"}, {"type": "subtitle", "time": 19538.708, "timestamp": "05:25:38", "text": "他们做到了，你能添加聊天功能吗？"}, {"type": "subtitle", "time": 19541.51, "timestamp": "05:25:41", "text": "它还具备翻译功能，所以它会"}, {"type": "subtitle", "time": 19543.83, "timestamp": "05:25:43", "text": "现在会自动翻译"}, {"type": "subtitle", "time": 19547.03, "timestamp": "05:25:47", "text": "也可以帮忙，或者我可以手动操作。"}, {"type": "subtitle", "time": 19549.35, "timestamp": "05:25:49", "text": "虽然有点延迟，但肯定会有延误，对吧？"}, {"type": "subtitle", "time": 19552.55, "timestamp": "05:25:52", "text": "一条消息，需要5分钟，编号1"}, {"type": "subtitle", "time": 19555.11, "timestamp": "05:25:55", "text": "至少一分钟才能被发送到 Discord"}, {"type": "subtitle", "time": 19557.47, "timestamp": "05:25:57", "text": "如果翻译是"}]
[{"type": "subtitle", "time": 13271.59, "timestamp": "03:41:11", "text": "好的。治疗者们是怎么死的？什么？"}, {"type": "subtitle", "time": 13274.63, "timestamp": "03:41:14", "text": "什么？我的治疗师们都去哪儿了？"}, {"type": "subtitle", "time": 13276.19, "timestamp": "03:41:16", "text": "什么"}, {"type": "subtitle", "time": 13280.389, "timestamp": "03:41:20", "text": "这？他们的球类计划失败了。哦，"}, {"type": "subtitle", "time": 13283.03, "timestamp": "03:41:23", "text": "他们做到了。"}, {"type": "subtitle", "time": 13287.429, "timestamp": "03:41:27", "text": "我让所有人都知道发生了什么事。"}, {"type": "subtitle", "time": 13291.349, "timestamp": "03:41:31", "text": "我遇到了那个呃那个那个，他的什么？"}, {"type": "subtitle", "time": 13303.19, "timestamp": "03:41:43", "text": "好吧，他把那件事做了。我会在我的……"}]
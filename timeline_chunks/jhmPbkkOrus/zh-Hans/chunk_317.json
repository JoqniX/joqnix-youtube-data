[{"type": "subtitle", "time": 19021.23, "timestamp": "05:17:01", "text": "文章。现在，它在哪里？"}, {"type": "subtitle", "time": 19024.27, "timestamp": "05:17:04", "text": "文章？哦，我的"}, {"type": "subtitle", "time": 19026.77, "timestamp": "05:17:06", "text": "上帝。我的作品已经出版了。"}, {"type": "subtitle", "time": 19029.19, "timestamp": "05:17:09", "text": "[音乐]"}, {"type": "subtitle", "time": 19031.35, "timestamp": "05:17:11", "text": "是的，"}, {"type": "subtitle", "time": 19035.51, "timestamp": "05:17:15", "text": "我现在拿到白金2了。我们走吧。"}, {"type": "subtitle", "time": 19036.43, "timestamp": "05:17:16", "text": "我们开始吧"}, {"type": "subtitle", "time": 19046.47, "timestamp": "05:17:26", "text": "将军，棋子。嗯？什么？什么？什么？"}, {"type": "subtitle", "time": 19048.31, "timestamp": "05:17:28", "text": "排名检查。"}, {"type": "subtitle", "time": 19058.15, "timestamp": "05:17:38", "text": "那是我。我在上面。哦，是的。哦"}, {"type": "subtitle", "time": 19060.948, "timestamp": "05:17:40", "text": "拉屎。我逼问了他。我的天啊。他是"}, {"type": "subtitle", "time": 19070.788, "timestamp": "05:17:50", "text": "你就说我这个赛季没上场。我是"}, {"type": "subtitle", "time": 19073.99, "timestamp": "05:17:53", "text": "依然是金牌三级。好的。而你是"}, {"type": "subtitle", "time": 19075.91, "timestamp": "05:17:55", "text": "正在尝试。"}, {"type": "subtitle", "time": 19078.07, "timestamp": "05:17:58", "text": "如果我试了，你会哭的。所以，我"}]
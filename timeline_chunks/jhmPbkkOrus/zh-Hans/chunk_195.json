[{"type": "subtitle", "time": 11703.429, "timestamp": "03:15:03", "text": "好的。去吃饭吧，我的朋友。"}, {"type": "subtitle", "time": 11707.19, "timestamp": "03:15:07", "text": "让我给模特闭上眼睛。"}, {"type": "subtitle", "time": 11711.19, "timestamp": "03:15:11", "text": "我的天啊。瞑。"}, {"type": "subtitle", "time": 11713.67, "timestamp": "03:15:13", "text": "所以，令人难以置信的是，他们根本不会意识到这一点。"}, {"type": "subtitle", "time": 11715.389, "timestamp": "03:15:15", "text": "我其实"}, {"type": "subtitle", "time": 11718.55, "timestamp": "03:15:18", "text": "离开。我的意思是，他们不会介意的，因为"}, {"type": "subtitle", "time": 11721.269, "timestamp": "03:15:21", "text": "你在说话。没关系。"}, {"type": "subtitle", "time": 11723.51, "timestamp": "03:15:23", "text": "哦，是的。"}, {"type": "subtitle", "time": 11725.67, "timestamp": "03:15:25", "text": "他们怎么知道我在说话？像神一样"}, {"type": "subtitle", "time": 11729.269, "timestamp": "03:15:29", "text": "该死，因为很明显的音频正在发送到"}, {"type": "subtitle", "time": 11733.269, "timestamp": "03:15:33", "text": "狮子们说的那些破事儿太可疑了。"}, {"type": "subtitle", "time": 11735.429, "timestamp": "03:15:35", "text": "他们问我为什么听不见。"}, {"type": "subtitle", "time": 11737.67, "timestamp": "03:15:37", "text": "就像既有游戏玩法又有音频一样"}, {"type": "subtitle", "time": 11740.07, "timestamp": "03:15:40", "text": "有语音解说，所以没问题。"}, {"type": "subtitle", "time": 11741.83, "timestamp": "03:15:41", "text": "相信"}, {"type": "subtitle", "time": 11744.95, "timestamp": "03:15:44", "text": "他们会的，我希望管理员们"}, {"type": "subtitle", "time": 11753.75, "timestamp": "03:15:53", "text": "嗯，或者就像为了得到"}, {"type": "subtitle", "time": 11756.63, "timestamp": "03:15:56", "text": "他玩游戏的时候，我的直播间里还有另一个人在。"}, {"type": "subtitle", "time": 11759.11, "timestamp": "03:15:59", "text": "一场游戏。"}, {"type": "chat", "time": 11759.96, "timestamp": "03:15:59", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "backkk.... this isn't a vod right?"}]
[{"type": "subtitle", "time": 14595.269, "timestamp": "04:03:15", "text": "正在启动。"}, {"type": "subtitle", "time": 14617.51, "timestamp": "04:03:37", "text": "是的。我换他，因为他是"}, {"type": "subtitle", "time": 14619.07, "timestamp": "04:03:39", "text": "已更改"}, {"type": "subtitle", "time": 14621.75, "timestamp": "04:03:41", "text": "这意味着一件事，哦，"}, {"type": "subtitle", "time": 14625.75, "timestamp": "04:03:45", "text": "他们禁止他入境。他妈的。"}, {"type": "subtitle", "time": 14629.51, "timestamp": "04:03:49", "text": "我该另辟蹊径吗？"}, {"type": "subtitle", "time": 14631.51, "timestamp": "04:03:51", "text": "让那辆车重新启动。它将"}, {"type": "subtitle", "time": 14635.11, "timestamp": "04:03:55", "text": "给我的骷髅头一点助力。"}]
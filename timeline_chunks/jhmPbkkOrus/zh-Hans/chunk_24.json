[{"type": "subtitle", "time": 1453.75, "timestamp": "00:24:13", "text": "[音乐]"}, {"type": "subtitle", "time": 1455.149, "timestamp": "00:24:15", "text": "在"}, {"type": "subtitle", "time": 1459.15, "timestamp": "00:24:19", "text": "瘦身"}, {"type": "subtitle", "time": 1486.789, "timestamp": "00:24:46", "text": "当你想接管的时候。啊，是的。"}, {"type": "subtitle", "time": 1489.83, "timestamp": "00:24:49", "text": "是的，我会送出去。我可以让布雷特"}, {"type": "subtitle", "time": 1493.149, "timestamp": "00:24:53", "text": "请你接管，这样我就可以去吃晚饭了。"}, {"type": "subtitle", "time": 1497.95, "timestamp": "00:24:57", "text": "不。午餐。午餐。午餐。我为什么这么说"}]
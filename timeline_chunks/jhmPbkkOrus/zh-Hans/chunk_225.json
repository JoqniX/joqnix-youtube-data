[{"type": "subtitle", "time": 13512.51, "timestamp": "03:45:12", "text": "我自豪地穿着"}, {"type": "subtitle", "time": 13522.95, "timestamp": "03:45:22", "text": "他们还有30秒就到。停留"}, {"type": "subtitle", "time": 13531.67, "timestamp": "03:45:31", "text": "我们的治疗师并不像他们想象的那样。"}, {"type": "subtitle", "time": 13533.67, "timestamp": "03:45:33", "text": "他们必须走自己的路，"}, {"type": "subtitle", "time": 13535.51, "timestamp": "03:45:35", "text": "他们要走自己的路。的"}, {"type": "subtitle", "time": 13538.309, "timestamp": "03:45:38", "text": "这家伙或者洛基就想：咱们走着瞧。"}, {"type": "subtitle", "time": 13540.95, "timestamp": "03:45:40", "text": "这个人。我必须阻止你。"}, {"type": "subtitle", "time": 13543.269, "timestamp": "03:45:43", "text": "你知道的，对吧？你不会是"}, {"type": "subtitle", "time": 13552.71, "timestamp": "03:45:52", "text": "放松一下，尽情玩耍。"}, {"type": "subtitle", "time": 13555.15, "timestamp": "03:45:55", "text": "不，但那家伙是"}, {"type": "subtitle", "time": 13557.269, "timestamp": "03:45:57", "text": "他说的没错。让我们看看他如何表现。"}]
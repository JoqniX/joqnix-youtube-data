[{"type": "subtitle", "time": 6629.109, "timestamp": "01:50:29", "text": "比利会改用直播私信吗？这"}, {"type": "subtitle", "time": 6632.31, "timestamp": "01:50:32", "text": "应该可以。"}, {"type": "subtitle", "time": 6634.109, "timestamp": "01:50:34", "text": "快的"}, {"type": "subtitle", "time": 6637.83, "timestamp": "01:50:37", "text": "赔率。哦，太好了。等等，你为什么不……"}, {"type": "subtitle", "time": 6640.87, "timestamp": "01:50:40", "text": "吃午饭吗？哦，等等。你是吗？你是吗？"}, {"type": "subtitle", "time": 6642.95, "timestamp": "01:50:42", "text": "你和我处于同一个时区吗？"}, {"type": "subtitle", "time": 6644.51, "timestamp": "01:50:44", "text": "你是来自哪里？"}, {"type": "subtitle", "time": 6649.709, "timestamp": "01:50:49", "text": "印度？周一。你为什么不吃东西"}, {"type": "subtitle", "time": 6652.709, "timestamp": "01:50:52", "text": "午餐或早餐？哦，等等。是吗？"}, {"type": "subtitle", "time": 6654.35, "timestamp": "01:50:54", "text": "早上好"}, {"type": "subtitle", "time": 6656.79, "timestamp": "01:50:56", "text": "或者，你那边现在几点？午餐时间到了"}, {"type": "subtitle", "time": 6658.47, "timestamp": "01:50:58", "text": "时间。好的。好的。你来自印度"}]
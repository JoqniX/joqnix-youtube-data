[{"type": "subtitle", "time": 16623.51, "timestamp": "04:37:03", "text": "瞧瞧。哦，还挺干净的。"}, {"type": "subtitle", "time": 16624.429, "timestamp": "04:37:04", "text": "干净的"}, {"type": "subtitle", "time": 16630.07, "timestamp": "04:37:10", "text": "乔，你在吗？是"}, {"type": "subtitle", "time": 16632.949, "timestamp": "04:37:12", "text": "一切都好吗？我该继续吗？"}, {"type": "subtitle", "time": 16635.99, "timestamp": "04:37:15", "text": "给我一个信号。我会给他发信息。"}, {"type": "subtitle", "time": 16638.31, "timestamp": "04:37:18", "text": "与其问，我干脆就……"}, {"type": "subtitle", "time": 16639.78, "timestamp": "04:37:19", "text": "信息"}, {"type": "subtitle", "time": 16661.59, "timestamp": "04:37:41", "text": "与此同时，当运动员说"}, {"type": "subtitle", "time": 16666.51, "timestamp": "04:37:46", "text": "还有一样东西，我再给你看一个。"}, {"type": "subtitle", "time": 16669.349, "timestamp": "04:37:49", "text": "事物。如果这里有人喜欢聊天的话……"}, {"type": "subtitle", "time": 16672.07, "timestamp": "04:37:52", "text": "漫威的一个角色，他已经不是"}, {"type": "subtitle", "time": 16675.269, "timestamp": "04:37:55", "text": "在这里，就像这就是全部的这个"}, {"type": "subtitle", "time": 16677.83, "timestamp": "04:37:57", "text": "全部名单。"}, {"type": "subtitle", "time": 16679.67, "timestamp": "04:37:59", "text": "你知道，如果你想要一个马里奥角色"}]
[{"type": "subtitle", "time": 17461.41, "timestamp": "04:51:01", "text": "这是真正的火力。"}, {"type": "subtitle", "time": 17483.59, "timestamp": "04:51:23", "text": "呃，2022年。我想你发的一条推文。"}, {"type": "subtitle", "time": 17495.23, "timestamp": "04:51:35", "text": "哦，不。不，更糟。我"}, {"type": "subtitle", "time": 17498.708, "timestamp": "04:51:38", "text": "我是谁？"}, {"type": "subtitle", "time": 17515.788, "timestamp": "04:51:55", "text": "闪电。有点"}, {"type": "subtitle", "time": 17518.708, "timestamp": "04:51:58", "text": "令人恐惧。你们都看到了那次逆转。"}]
[{"type": "subtitle", "time": 15841.75, "timestamp": "04:24:01", "text": "我几乎不饿。混乱来吧。"}, {"type": "subtitle", "time": 15865.99, "timestamp": "04:24:25", "text": "天哪，我还以为我男朋友和我在一起呢。"}, {"type": "subtitle", "time": 15867.59, "timestamp": "04:24:27", "text": "哦，没事了。我搞砸了。好的，就是这样。"}, {"type": "subtitle", "time": 15882.55, "timestamp": "04:24:42", "text": "我不应该那样做。我不应该"}, {"type": "subtitle", "time": 15894.55, "timestamp": "04:24:54", "text": "是的，我们确实这么做了。"}]
[{"type": "subtitle", "time": 601.829, "timestamp": "00:10:01", "text": "中国人"}, {"type": "subtitle", "time": 606.55, "timestamp": "00:10:06", "text": "嗯，服务器，全球测试版。"}, {"type": "subtitle", "time": 609.269, "timestamp": "00:10:09", "text": "我申请了，我简直难以置信。"}, {"type": "subtitle", "time": 611.71, "timestamp": "00:10:11", "text": "昨晚大概5点左右"}, {"type": "subtitle", "time": 612.91, "timestamp": "00:10:12", "text": "[音乐]"}, {"type": "subtitle", "time": 617.11, "timestamp": "00:10:17", "text": "早上我希望能进去，但是不行。"}, {"type": "subtitle", "time": 624.829, "timestamp": "00:10:24", "text": "[音乐]"}, {"type": "subtitle", "time": 646.31, "timestamp": "00:10:46", "text": "向上。我当时应该睡着了，醉得很厉害。"}, {"type": "subtitle", "time": 648.389, "timestamp": "00:10:48", "text": "说了些什么。我有很多共同之处"}]
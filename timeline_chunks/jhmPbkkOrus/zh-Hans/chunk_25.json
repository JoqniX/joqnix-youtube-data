[{"type": "subtitle", "time": 1500.909, "timestamp": "00:25:00", "text": "晚餐？午餐。"}, {"type": "subtitle", "time": 1502.51, "timestamp": "00:25:02", "text": "吃。"}, {"type": "subtitle", "time": 1508.789, "timestamp": "00:25:08", "text": "嗯，是的，我可以吃，我可以吃"}, {"type": "subtitle", "time": 1510.47, "timestamp": "00:25:10", "text": "最后"}, {"type": "subtitle", "time": 1512.59, "timestamp": "00:25:12", "text": "呃，然后拿一个"}, {"type": "subtitle", "time": 1514.83, "timestamp": "00:25:14", "text": "洗澡。"}, {"type": "subtitle", "time": 1518.23, "timestamp": "00:25:18", "text": "呃，偷偷溜进我妈妈的房间，然后呃"}, {"type": "subtitle", "time": 1521.909, "timestamp": "00:25:21", "text": "享受一下空调吧，因为我房间的空调不好使。"}, {"type": "subtitle", "time": 1524.549, "timestamp": "00:25:24", "text": "甚至已经修复了。我还有多少天时间？"}, {"type": "subtitle", "time": 1527.909, "timestamp": "00:25:27", "text": "等等，兄弟？为什么空调维修人员还没来？"}, {"type": "subtitle", "time": 1533.669, "timestamp": "00:25:33", "text": "好吧，我必须说，我相信"}]
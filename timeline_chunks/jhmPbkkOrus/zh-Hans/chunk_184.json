[{"type": "subtitle", "time": 11045.269, "timestamp": "03:04:05", "text": "我的天啊。你当时在干什么？"}, {"type": "subtitle", "time": 11054.63, "timestamp": "03:04:14", "text": "我做完了所有家务，然后我就回来了。"}, {"type": "subtitle", "time": 11056.309, "timestamp": "03:04:16", "text": "回来后，他们又说他仍然"}, {"type": "subtitle", "time": 11057.67, "timestamp": "03:04:17", "text": "溪流。搞什么鬼？他仍然"}, {"type": "subtitle", "time": 11060.429, "timestamp": "03:04:20", "text": "编码。哦好的。肯定像某种东西"}, {"type": "subtitle", "time": 11062.63, "timestamp": "03:04:22", "text": "重要的。肯定是他想……"}, {"type": "subtitle", "time": 11064.87, "timestamp": "03:04:24", "text": "就像创建一个新网站一样。他是"}, {"type": "subtitle", "time": 11075.91, "timestamp": "03:04:35", "text": "小时。这到底是怎么回事？我的意思是，我，我，我"}, {"type": "subtitle", "time": 11078.389, "timestamp": "03:04:38", "text": "最近我晚上睡不着觉。全部"}, {"type": "subtitle", "time": 11080.55, "timestamp": "03:04:40", "text": "我一直在思考这件事，感觉很奇怪。"}, {"type": "subtitle", "time": 11084.07, "timestamp": "03:04:44", "text": "原因。我不知道"}, {"type": "subtitle", "time": 11090.95, "timestamp": "03:04:50", "text": "这。我的天啊。我当时就想，“哦，乔"}, {"type": "subtitle", "time": 11092.55, "timestamp": "03:04:52", "text": "叫我上直播间，就像这样"}, {"type": "subtitle", "time": 11094.95, "timestamp": "03:04:54", "text": "“拿走。”我心想，“哦，好的。”我这就去"}, {"type": "subtitle", "time": 11097.51, "timestamp": "03:04:57", "text": "过来看看。”我看他好像在装模作样"}, {"type": "subtitle", "time": 11099.51, "timestamp": "03:04:59", "text": "就像……就像……类似……“哦，我会……”"}]
[{"type": "subtitle", "time": 19141.83, "timestamp": "05:19:01", "text": "我的排名居然是负数？哦，糟糕。我"}, {"type": "subtitle", "time": 19144.47, "timestamp": "05:19:04", "text": "我没注意到。我输了很多。你"}, {"type": "subtitle", "time": 19147.11, "timestamp": "05:19:07", "text": "无法得到阴性结果。这怪胎"}, {"type": "subtitle", "time": 19150.47, "timestamp": "05:19:10", "text": "你在说什么？就像负面胜利一样。我"}, {"type": "subtitle", "time": 19157.99, "timestamp": "05:19:17", "text": "现在我确定这次检测结果是阳性了。是什么"}, {"type": "subtitle", "time": 19159.47, "timestamp": "05:19:19", "text": "最后的"}, {"type": "subtitle", "time": 19161.948, "timestamp": "05:19:21", "text": "季节？"}, {"type": "subtitle", "time": 19166.15, "timestamp": "05:19:26", "text": "积极的。对此持否定态度。消极的"}, {"type": "subtitle", "time": 19167.99, "timestamp": "05:19:27", "text": "这一点也一样。所以，我当时真是倒霉透了。"}, {"type": "subtitle", "time": 19171.27, "timestamp": "05:19:31", "text": "在第零季和第一季中。你真是太"}, {"type": "subtitle", "time": 19175.35, "timestamp": "05:19:35", "text": "拉屎。但你简直比拉屎还快。"}, {"type": "subtitle", "time": 19179.99, "timestamp": "05:19:39", "text": "好了，冷静，冷静下来，兄弟。冷静下来。"}, {"type": "subtitle", "time": 19181.59, "timestamp": "05:19:41", "text": "我要上天了"}, {"type": "subtitle", "time": 19184.708, "timestamp": "05:19:44", "text": "季节。我只是想得到我"}, {"type": "subtitle", "time": 19186.948, "timestamp": "05:19:46", "text": "我要去见主了"}, {"type": "subtitle", "time": 19188.708, "timestamp": "05:19:48", "text": "他妈的，他叫什么来着？极端主义者。出色地，"}, {"type": "subtitle", "time": 19190.948, "timestamp": "05:19:50", "text": "你没能获得Celestial。"}, {"type": "subtitle", "time": 19193.19, "timestamp": "05:19:53", "text": "不用担心。我会上去的"}, {"type": "subtitle", "time": 19194.708, "timestamp": "05:19:54", "text": "天上的。你们相处得并不融洽。"}, {"type": "subtitle", "time": 19197.27, "timestamp": "05:19:57", "text": "天上的。许可。你有"}, {"type": "subtitle", "time": 19198.788, "timestamp": "05:19:58", "text": "获得播放他人作品的许可"}]
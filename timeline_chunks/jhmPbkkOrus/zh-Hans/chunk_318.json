[{"type": "subtitle", "time": 19080.23, "timestamp": "05:18:00", "text": "我只是在照顾你，兄弟。"}, {"type": "subtitle", "time": 19082.948, "timestamp": "05:18:02", "text": "所以所以所以你忘了你喜欢这样"}, {"type": "subtitle", "time": 19085.75, "timestamp": "05:18:05", "text": "这人同时用两个账号刷钱。二"}, {"type": "subtitle", "time": 19087.67, "timestamp": "05:18:07", "text": "账户。"}, {"type": "subtitle", "time": 19089.27, "timestamp": "05:18:09", "text": "那不是我们所说的。"}, {"type": "subtitle", "time": 19092.11, "timestamp": "05:18:12", "text": "研磨。好的。所以即使你"}, {"type": "subtitle", "time": 19095.35, "timestamp": "05:18:15", "text": "比如把我的两个账号都添加为关注者，而不是"}, {"type": "subtitle", "time": 19098.07, "timestamp": "05:18:18", "text": "观众、玩家，它仍然较低"}, {"type": "subtitle", "time": 19100.55, "timestamp": "05:18:20", "text": "比你强。所以这样做是不对的。我们曾经"}, {"type": "subtitle", "time": 19102.39, "timestamp": "05:18:22", "text": "这场对话就像前一天一样"}, {"type": "subtitle", "time": 19105.19, "timestamp": "05:18:25", "text": "昨天的狗。所以冷静下来。如此平静"}, {"type": "subtitle", "time": 19107.83, "timestamp": "05:18:27", "text": "向下。好的。所以我的意思是，你是，所以我可以"}, {"type": "subtitle", "time": 19110.47, "timestamp": "05:18:30", "text": "没错。"}, {"type": "subtitle", "time": 19119.35, "timestamp": "05:18:39", "text": "这家伙在这款游戏中获得了 400 多 R。"}, {"type": "subtitle", "time": 19120.83, "timestamp": "05:18:40", "text": "关闭"}, {"type": "subtitle", "time": 19122.91, "timestamp": "05:18:42", "text": "他妈的"}, {"type": "subtitle", "time": 19126.31, "timestamp": "05:18:46", "text": "管理您的语言。我喜欢261。你"}, {"type": "subtitle", "time": 19128.47, "timestamp": "05:18:48", "text": "可以看到就像玩了一段时间一样。那就像"}, {"type": "subtitle", "time": 19130.47, "timestamp": "05:18:50", "text": "坐着。"}, {"type": "subtitle", "time": 19131.99, "timestamp": "05:18:51", "text": "耶稣。"}, {"type": "subtitle", "time": 19134.55, "timestamp": "05:18:54", "text": "说实话，我是一个悲伤的人。我是一名"}, {"type": "subtitle", "time": 19136.788, "timestamp": "05:18:56", "text": "悲伤的男人。"}, {"type": "subtitle", "time": 19138.59, "timestamp": "05:18:58", "text": "你真是个悲哀的人。是"}]
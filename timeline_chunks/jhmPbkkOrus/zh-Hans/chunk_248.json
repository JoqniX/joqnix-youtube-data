[{"type": "subtitle", "time": 14881.75, "timestamp": "04:08:01", "text": "我他妈到底在看什么？你"}, {"type": "subtitle", "time": 14890.63, "timestamp": "04:08:10", "text": "我应该等我的小号出来再说。"}, {"type": "subtitle", "time": 14893.189, "timestamp": "04:08:13", "text": "实际上，我有点搞砸了我的“我们”计划。"}, {"type": "subtitle", "time": 14896.03, "timestamp": "04:08:16", "text": "也需要更多支持。我们可以推动"}, {"type": "subtitle", "time": 14899.91, "timestamp": "04:08:19", "text": "这。我们只需要摆脱……"}, {"type": "subtitle", "time": 14901.189, "timestamp": "04:08:21", "text": "是的，这就是我们唯一需要做的。"}, {"type": "subtitle", "time": 14922.87, "timestamp": "04:08:42", "text": "滚出我的游戏！"}, {"type": "subtitle", "time": 14924.95, "timestamp": "04:08:44", "text": "我的天啊。东西，你真是个狠角色。你是"}, {"type": "subtitle", "time": 14926.51, "timestamp": "04:08:46", "text": "你是最棒的"}]
[{"type": "subtitle", "time": 13081.67, "timestamp": "03:38:01", "text": "交换？为什么我们 Twitch 会省略一些内容"}, {"type": "subtitle", "time": 13083.91, "timestamp": "03:38:03", "text": "字？我不知道，伙计。我不知道。"}, {"type": "subtitle", "time": 13086.71, "timestamp": "03:38:06", "text": "但该死，我们还有面包要吃"}, {"type": "subtitle", "time": 13089.51, "timestamp": "03:38:09", "text": "现在。我要把谁驱逐出这个圈子？"}, {"type": "subtitle", "time": 13091.87, "timestamp": "03:38:11", "text": "匹配？"}, {"type": "subtitle", "time": 13094.71, "timestamp": "03:38:14", "text": "横幅。去他妈的。我去挂横幅。我觉得我"}, {"type": "subtitle", "time": 13104.309, "timestamp": "03:38:24", "text": "我猜是敌方队伍，因为那里有……"}, {"type": "subtitle", "time": 13106.87, "timestamp": "03:38:26", "text": "一群讨厌蜘蛛侠的人将联合起来禁止……"}, {"type": "subtitle", "time": 13110.389, "timestamp": "03:38:30", "text": "蜘蛛侠。我希望他们能做到。我不能"}, {"type": "subtitle", "time": 13112.469, "timestamp": "03:38:32", "text": "我受不了蜘蛛侠。哦，他们禁止了"}, {"type": "subtitle", "time": 13114.19, "timestamp": "03:38:34", "text": "G：哦，他们禁了"}, {"type": "subtitle", "time": 13121.59, "timestamp": "03:38:41", "text": "蜘蛛侠。哦，太棒了，兄弟。是"}, {"type": "subtitle", "time": 13123.95, "timestamp": "03:38:43", "text": "去"}, {"type": "subtitle", "time": 13127.87, "timestamp": "03:38:47", "text": "蜘蛛侠。我们要去吗？你知道的"}, {"type": "subtitle", "time": 13132.67, "timestamp": "03:38:52", "text": "什么？我想就此展开讨论。"}]
[{"type": "subtitle", "time": 17520.47, "timestamp": "04:52:00", "text": "哦，那真是尴尬。顺便说一句，我确实这么做了。"}, {"type": "subtitle", "time": 17522.39, "timestamp": "04:52:02", "text": "没有什么。"}, {"type": "subtitle", "time": 17524.55, "timestamp": "04:52:04", "text": "我什么都没做。我做了一个"}, {"type": "subtitle", "time": 17534.23, "timestamp": "04:52:14", "text": "是的。所以，你怎么做？好吧，这就是原因。"}, {"type": "subtitle", "time": 17540.55, "timestamp": "04:52:20", "text": "问题。不，我是一位艺术家"}, {"type": "subtitle", "time": 17544.83, "timestamp": "04:52:24", "text": "我在这里找到了乔克尼克先生。"}, {"type": "subtitle", "time": 17561.59, "timestamp": "04:52:41", "text": "我感觉好像在想，现在是什么时候了？"}, {"type": "subtitle", "time": 17565.62, "timestamp": "04:52:45", "text": "认真想想。当时就像"}, {"type": "subtitle", "time": 17567.19, "timestamp": "04:52:47", "text": "[音乐]"}, {"type": "subtitle", "time": 17569.75, "timestamp": "04:52:49", "text": "是什么时候？我想，我想有一天"}, {"type": "subtitle", "time": 17573.55, "timestamp": "04:52:53", "text": "我玩《2022》的时候。该死的你"}, {"type": "subtitle", "time": 17577.27, "timestamp": "04:52:57", "text": "跟踪者。你就是这么爱我。什么？"}]
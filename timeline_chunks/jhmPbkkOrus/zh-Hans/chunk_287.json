[{"type": "subtitle", "time": 17223.35, "timestamp": "04:47:03", "text": "现在感觉就像在出汗一样。我知道"}, {"type": "subtitle", "time": 17224.99, "timestamp": "04:47:04", "text": "两天的事情就像……"}, {"type": "subtitle", "time": 17227.43, "timestamp": "04:47:07", "text": "推荐这款双人套装"}, {"type": "subtitle", "time": 17230.708, "timestamp": "04:47:10", "text": "天。我不会被推荐给任何人。"}, {"type": "subtitle", "time": 17250.31, "timestamp": "04:47:30", "text": "好的。好的。好的。这可不好。这"}, {"type": "subtitle", "time": 17253.75, "timestamp": "04:47:33", "text": "不好。我的天啊。我很抱歉，"}, {"type": "subtitle", "time": 17263.99, "timestamp": "04:47:43", "text": "我应该追求更大的伤害吗？"}, {"type": "subtitle", "time": 17265.75, "timestamp": "04:47:45", "text": "你玩得越多，我就越想玩。"}, {"type": "subtitle", "time": 17268.07, "timestamp": "04:47:48", "text": "也参与其中。但是疼痛让我无法演奏。"}, {"type": "subtitle", "time": 17272.39, "timestamp": "04:47:52", "text": "那场比赛。这款游戏。没关系。"}, {"type": "subtitle", "time": 17274.23, "timestamp": "04:47:54", "text": "当你去日本的时候，如果你能得到一个好的"}, {"type": "subtitle", "time": 17278.47, "timestamp": "04:47:58", "text": "我要用电脑玩游戏了。"}]
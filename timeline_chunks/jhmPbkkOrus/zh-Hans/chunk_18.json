[{"type": "subtitle", "time": 1088.23, "timestamp": "00:18:08", "text": "甚至实施那些无线电"}, {"type": "subtitle", "time": 1090.19, "timestamp": "00:18:10", "text": "超级聊天订阅"}, {"type": "subtitle", "time": 1093.15, "timestamp": "00:18:13", "text": "牌。我的仪表盘是谁的？"}, {"type": "subtitle", "time": 1099.87, "timestamp": "00:18:19", "text": "嗯，"}, {"type": "subtitle", "time": 1104.59, "timestamp": "00:18:24", "text": "去。我还是等等吧。我会等到……"}, {"type": "subtitle", "time": 1108.75, "timestamp": "00:18:28", "text": "实施的。但我真的很想知道。"}, {"type": "subtitle", "time": 1111.75, "timestamp": "00:18:31", "text": "嗯，我真希望我能记录我的"}, {"type": "subtitle", "time": 1114.39, "timestamp": "00:18:34", "text": "信徒间的聊天。真是太烦人了"}, {"type": "subtitle", "time": 1116.87, "timestamp": "00:18:36", "text": "每天"}, {"type": "subtitle", "time": 1120.15, "timestamp": "00:18:40", "text": "嗯，每条直播流。截图并粘贴"}, {"type": "subtitle", "time": 1122.19, "timestamp": "00:18:42", "text": "它在我的"}, {"type": "subtitle", "time": 1123.95, "timestamp": "00:18:43", "text": "Discord。"}, {"type": "subtitle", "time": 1136.95, "timestamp": "00:18:56", "text": "疼痛。我当时想，我会想办法的。"}]
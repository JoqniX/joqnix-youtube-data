[{"type": "subtitle", "time": 15723.189, "timestamp": "04:22:03", "text": "不再是应该的了"}, {"type": "subtitle", "time": 15725.79, "timestamp": "04:22:05", "text": "来到火炬旁。你很擅长帮助别人。"}, {"type": "subtitle", "time": 15741.51, "timestamp": "04:22:21", "text": "你看，我的死亡人数比他们少。"}, {"type": "subtitle", "time": 15744.229, "timestamp": "04:22:24", "text": "库兹"}, {"type": "subtitle", "time": 15748.55, "timestamp": "04:22:28", "text": "不仅是阿斯加德，而是所有兄弟，愿"}, {"type": "subtitle", "time": 15757.67, "timestamp": "04:22:37", "text": "30秒。攻击之前，先做好准备"}, {"type": "subtitle", "time": 15763.269, "timestamp": "04:22:43", "text": "你知道我的强项，"}, {"type": "subtitle", "time": 15765.83, "timestamp": "04:22:45", "text": "就像你那把锤子一样。米尔确实"}, {"type": "subtitle", "time": 15768.229, "timestamp": "04:22:48", "text": "不要开枪"}, {"type": "subtitle", "time": 15770.389, "timestamp": "04:22:50", "text": "宇宙的强大力量不受任何限制"}, {"type": "subtitle", "time": 15773.75, "timestamp": "04:22:53", "text": "母亲们。所以我猜你不想"}, {"type": "subtitle", "time": 15776.55, "timestamp": "04:22:56", "text": "训练这个。即使在你最疯狂的想象中也不行"}, {"type": "subtitle", "time": 15779.189, "timestamp": "04:22:59", "text": "梦想。群星之主。战斗开始"}]
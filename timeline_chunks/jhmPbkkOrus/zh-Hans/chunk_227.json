[{"type": "subtitle", "time": 13623.11, "timestamp": "03:47:03", "text": "好的。佩妮在那边。好的。她是"}, {"type": "subtitle", "time": 13624.71, "timestamp": "03:47:04", "text": "就像飞一样。哦，她是"}, {"type": "subtitle", "time": 13627.429, "timestamp": "03:47:07", "text": "死的。"}, {"type": "subtitle", "time": 13629.91, "timestamp": "03:47:09", "text": "他们可能在发送 tping 信号。这个地方是"}, {"type": "subtitle", "time": 13632.79, "timestamp": "03:47:12", "text": "渴望被毁灭。"}, {"type": "subtitle", "time": 13635.269, "timestamp": "03:47:15", "text": "大概要去卫生纸店。我很确定。"}, {"type": "subtitle", "time": 13645.83, "timestamp": "03:47:25", "text": "让我们伏击我们的敌人，就像他们"}]
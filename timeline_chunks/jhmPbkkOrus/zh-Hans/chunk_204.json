[{"type": "subtitle", "time": 12255.11, "timestamp": "03:24:15", "text": "死的。没人采取任何行动。这些"}, {"type": "subtitle", "time": 12257.99, "timestamp": "03:24:17", "text": "男人们并没有大力推广他们的小号。这是"}, {"type": "subtitle", "time": 12259.91, "timestamp": "03:24:19", "text": "真令人沮丧。那是看不见的吗？"}, {"type": "subtitle", "time": 12261.59, "timestamp": "03:24:21", "text": "移动？那是看不见的。哪个"}, {"type": "subtitle", "time": 12263.429, "timestamp": "03:24:23", "text": "因素？无形的。抱歉，我不是那种人。"}, {"type": "subtitle", "time": 12265.91, "timestamp": "03:24:25", "text": "因为太专注而没看聊天记录，"}, {"type": "subtitle", "time": 12284.55, "timestamp": "03:24:44", "text": "我的天啊。"}, {"type": "subtitle", "time": 12287.03, "timestamp": "03:24:47", "text": "他们一碰到那玩意儿就晕倒了。"}, {"type": "subtitle", "time": 12293.83, "timestamp": "03:24:53", "text": "他能来吗？我的天啊。我们他妈的"}]
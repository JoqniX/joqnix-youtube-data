[{"type": "subtitle", "time": 13444.229, "timestamp": "03:44:04", "text": "兄弟，我们的治疗师在干什么？"}, {"type": "subtitle", "time": 13452.389, "timestamp": "03:44:12", "text": "我感觉不到鞋跟。"}, {"type": "subtitle", "time": 13463.11, "timestamp": "03:44:23", "text": "什么？我真的不，我真的不。"}, {"type": "subtitle", "time": 13464.389, "timestamp": "03:44:24", "text": "不要感觉到鞋跟。他们正在做什么？"}, {"type": "subtitle", "time": 13469.83, "timestamp": "03:44:29", "text": "损害？妈的。抱歉，我的错。我没有"}, {"type": "subtitle", "time": 13472.87, "timestamp": "03:44:32", "text": "请观看我们的采访。你能切换到中路吗？"}, {"type": "subtitle", "time": 13475.03, "timestamp": "03:44:35", "text": "桶？是的，我们可以互换角色。"}, {"type": "subtitle", "time": 13475.79, "timestamp": "03:44:35", "text": "中"}, {"type": "subtitle", "time": 13478.15, "timestamp": "03:44:38", "text": "像桶一样，一切都不一样"}, {"type": "subtitle", "time": 13481.03, "timestamp": "03:44:41", "text": "实际上。"}, {"type": "subtitle", "time": 13488.03, "timestamp": "03:44:48", "text": "单身的。当然，"}, {"type": "subtitle", "time": 13498.03, "timestamp": "03:44:58", "text": "最好的。这里我们"}]
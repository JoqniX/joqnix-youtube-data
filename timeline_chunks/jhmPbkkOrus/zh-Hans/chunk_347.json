[{"type": "subtitle", "time": 20820.788, "timestamp": "05:47:00", "text": "我知道，来到这里是我的梦想。我想"}, {"type": "subtitle", "time": 20822.11, "timestamp": "05:47:02", "text": "到"}, {"type": "subtitle", "time": 20826.628, "timestamp": "05:47:06", "text": "在这里要认真工作。你知道，我"}, {"type": "subtitle", "time": 20828.35, "timestamp": "05:47:08", "text": "我想尽我所能"}, {"type": "subtitle", "time": 20835.708, "timestamp": "05:47:15", "text": "这里。这是我唯一想说的。"}, {"type": "subtitle", "time": 20859.59, "timestamp": "05:47:39", "text": "哦，你能用聊天功能发消息吗？我是"}, {"type": "subtitle", "time": 20864.548, "timestamp": "05:47:44", "text": "我正在尝试使用……我正在尝试……"}, {"type": "subtitle", "time": 20867.99, "timestamp": "05:47:47", "text": "来自比利·比利的聊天"}, {"type": "subtitle", "time": 20870.51, "timestamp": "05:47:50", "text": "呃，在我的"}]
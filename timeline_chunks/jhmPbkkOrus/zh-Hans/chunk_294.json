[{"type": "subtitle", "time": 17643.07, "timestamp": "04:54:03", "text": "男生。那就是我认识的那个人。"}, {"type": "subtitle", "time": 17646.35, "timestamp": "04:54:06", "text": "男生。上帝"}, {"type": "subtitle", "time": 17649.59, "timestamp": "04:54:09", "text": "该死。你创造了这个凡人吗？"}, {"type": "subtitle", "time": 17651.19, "timestamp": "04:54:11", "text": "运动健将？"}, {"type": "subtitle", "time": 17655.35, "timestamp": "04:54:15", "text": "不，那是巴姆或者别的什么人。砰或呃"}, {"type": "subtitle", "time": 17659.51, "timestamp": "04:54:19", "text": "米姆。砰。这是我画的，也是我导演的。"}, {"type": "subtitle", "time": 17670.31, "timestamp": "04:54:30", "text": "我，一些大的我。是的。是的，"}, {"type": "subtitle", "time": 17673.35, "timestamp": "04:54:33", "text": "咪咪。那真不错。那就是那样。"}, {"type": "subtitle", "time": 17675.51, "timestamp": "04:54:35", "text": "好的。"}, {"type": "subtitle", "time": 17678.31, "timestamp": "04:54:38", "text": "哦，"}, {"type": "subtitle", "time": 17681.99, "timestamp": "04:54:41", "text": "但我最初的印象也一样。"}, {"type": "subtitle", "time": 17683.91, "timestamp": "04:54:43", "text": "是的，第一印象就像"}, {"type": "subtitle", "time": 17686.628, "timestamp": "04:54:46", "text": "总是喜欢搞复杂，但之后……"}, {"type": "subtitle", "time": 17688.03, "timestamp": "04:54:48", "text": "你会"}, {"type": "subtitle", "time": 17691.51, "timestamp": "04:54:51", "text": "意识到，是的，这不是，这是我的"}, {"type": "subtitle", "time": 17696.15, "timestamp": "04:54:56", "text": "男生。我必须不惜一切代价保护他。"}, {"type": "subtitle", "time": 17699.03, "timestamp": "04:54:59", "text": "是的。"}]
[{"type": "subtitle", "time": 11820.07, "timestamp": "03:17:00", "text": "我的人工智能。啊，糟糕。我没有，我没有设置"}, {"type": "subtitle", "time": 11832.229, "timestamp": "03:17:12", "text": "你今天想成为哪种人？"}, {"type": "subtitle", "time": 11834.469, "timestamp": "03:17:14", "text": "哎呀，哎呀，哎呀。嗯，我这就去写"}, {"type": "subtitle", "time": 11837.55, "timestamp": "03:17:17", "text": "请把音量调大一点。"}, {"type": "subtitle", "time": 11845.19, "timestamp": "03:17:25", "text": "现在。不过也不多。所以，因为我想要"}, {"type": "subtitle", "time": 11848.469, "timestamp": "03:17:28", "text": "想听听我的想法，伙计。蜘蛛侠。"}, {"type": "subtitle", "time": 11851.75, "timestamp": "03:17:31", "text": "是的，事实上，人们不喜欢"}, {"type": "subtitle", "time": 11854.71, "timestamp": "03:17:34", "text": "这款游戏中的蜘蛛侠。即使你"}, {"type": "subtitle", "time": 11858.07, "timestamp": "03:17:38", "text": "玩过这款游戏，掌控了这一切"}, {"type": "subtitle", "time": 11859.269, "timestamp": "03:17:39", "text": "时间。哦，别担心。他"}, {"type": "subtitle", "time": 11862.229, "timestamp": "03:17:42", "text": "他并不介意。它不像一个"}, {"type": "subtitle", "time": 11863.99, "timestamp": "03:17:43", "text": "时间是什么时候？和往常一样。"}, {"type": "subtitle", "time": 11864.99, "timestamp": "03:17:44", "text": "时间"}]
[{"type": "subtitle", "time": 17401.51, "timestamp": "04:50:01", "text": "你和布拉德是怎么认识的？"}, {"type": "subtitle", "time": 17404.788, "timestamp": "04:50:04", "text": "我们是如何相遇的？"}, {"type": "subtitle", "time": 17413.75, "timestamp": "04:50:13", "text": "你第一次拉屎是什么时候？你什么时候开始的"}, {"type": "subtitle", "time": 17417.59, "timestamp": "04:50:17", "text": "首先发现我？"}, {"type": "subtitle", "time": 17420.55, "timestamp": "04:50:20", "text": "跟你聊聊。是的。你第一次"}, {"type": "subtitle", "time": 17422.31, "timestamp": "04:50:22", "text": "看着我？哦，等等。我想我已经有了"}, {"type": "subtitle", "time": 17433.27, "timestamp": "04:50:33", "text": "对不起。我正在找这个呃"}, {"type": "subtitle", "time": 17434.948, "timestamp": "04:50:34", "text": "不，不是。到底什么是“什么”？"}]
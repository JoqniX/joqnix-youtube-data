[{"type": "subtitle", "time": 18120.47, "timestamp": "05:02:00", "text": "好吧，我们没有货物。那就是"}, {"type": "subtitle", "time": 18123.35, "timestamp": "05:02:03", "text": "问题。我们没有货物。团队是"}, {"type": "subtitle", "time": 18126.708, "timestamp": "05:02:06", "text": "不像阿林。"}, {"type": "subtitle", "time": 18129.03, "timestamp": "05:02:09", "text": "你看，他简直太步履蹒跚了。"}, {"type": "subtitle", "time": 18131.51, "timestamp": "05:02:11", "text": "搞什么鬼？他们遇到了检查站。"}, {"type": "subtitle", "time": 18133.43, "timestamp": "05:02:13", "text": "现在或许是阻止他们的好时机。"}, {"type": "subtitle", "time": 18134.868, "timestamp": "05:02:14", "text": "我们明明只有两个人，为什么还要强求呢？"}, {"type": "subtitle", "time": 18152.788, "timestamp": "05:02:32", "text": "我们是不是都觉得“这他妈到底怎么了？”"}, {"type": "subtitle", "time": 18168.23, "timestamp": "05:02:48", "text": "或者就此死去。准备。来了"}, {"type": "subtitle", "time": 18170.28, "timestamp": "05:02:50", "text": "坏人。"}, {"type": "subtitle", "time": 18177.67, "timestamp": "05:02:57", "text": "这是真正的火力。我会给你补上补丁"}]
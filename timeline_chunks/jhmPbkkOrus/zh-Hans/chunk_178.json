[{"type": "subtitle", "time": 10699.91, "timestamp": "02:58:19", "text": "作品。好的，既然它有效，那么我们"}, {"type": "subtitle", "time": 10712.07, "timestamp": "02:58:32", "text": "好吧，我正在准备战斗面包，而且……"}, {"type": "subtitle", "time": 10716.15, "timestamp": "02:58:36", "text": "我们将进行公开的风险投资收购。患病的"}, {"type": "subtitle", "time": 10719.19, "timestamp": "02:58:39", "text": "去吃饭，吃完就回来。哦，等等。在哪里？"}, {"type": "subtitle", "time": 10734.79, "timestamp": "02:58:54", "text": "更冷了。好吧，我死定了。"}]
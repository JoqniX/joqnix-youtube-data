[{"type": "subtitle", "time": 17160.948, "timestamp": "04:46:00", "text": "哦，是啊，这家伙听起来很沮丧。会"}, {"type": "subtitle", "time": 17164.39, "timestamp": "04:46:04", "text": "安静点，生活跟我作对。"}, {"type": "subtitle", "time": 17171.11, "timestamp": "04:46:11", "text": "如果这样能让你感觉好些，那就看看"}, {"type": "subtitle", "time": 17173.83, "timestamp": "04:46:13", "text": "艾玛·弗罗斯特的大腿。"}, {"type": "subtitle", "time": 17175.91, "timestamp": "04:46:15", "text": "我不知道。你看它们有多大"}, {"type": "subtitle", "time": 17178.628, "timestamp": "04:46:18", "text": "是。你知道她什么时候会走到那里吗？"}, {"type": "subtitle", "time": 17179.55, "timestamp": "04:46:19", "text": "抖动"}, {"type": "subtitle", "time": 17183.03, "timestamp": "04:46:23", "text": "她大腿上的物理学原理？"}, {"type": "subtitle", "time": 17185.07, "timestamp": "04:46:25", "text": "找到了。你他妈的抖动"}, {"type": "subtitle", "time": 17187.47, "timestamp": "04:46:27", "text": "物理。圣"}, {"type": "subtitle", "time": 17193.91, "timestamp": "04:46:33", "text": "是的。是的。我觉得Jog不是"}, {"type": "subtitle", "time": 17197.99, "timestamp": "04:46:37", "text": "今天非常开心。没关系。我这就去"}, {"type": "subtitle", "time": 17200.07, "timestamp": "04:46:40", "text": "好吧，他们换成一个油箱。"}, {"type": "subtitle", "time": 17213.74, "timestamp": "04:46:53", "text": "[音乐]"}]
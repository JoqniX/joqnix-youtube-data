[{"type": "subtitle", "time": 13020.79, "timestamp": "03:37:00", "text": "是的。你知道，就像我看不见……"}, {"type": "subtitle", "time": 13024.79, "timestamp": "03:37:04", "text": "另一条消息是因为它是垃圾邮件。"}, {"type": "subtitle", "time": 13027.51, "timestamp": "03:37:07", "text": "就是那玩意儿，你知道的？真是糟糕透了。我"}, {"type": "subtitle", "time": 13046.349, "timestamp": "03:37:26", "text": "刺刀。等等，等等。因为我说"}, {"type": "subtitle", "time": 13048.67, "timestamp": "03:37:28", "text": "你哦，"}, {"type": "subtitle", "time": 13051.51, "timestamp": "03:37:31", "text": "是的。是的。等待。是的。是的。是的。是的。我"}, {"type": "subtitle", "time": 13053.83, "timestamp": "03:37:33", "text": "你看，我玩游戏的时候也能说话。"}, {"type": "subtitle", "time": 13055.59, "timestamp": "03:37:35", "text": "就像坦克之类的东西，但当我"}, {"type": "subtitle", "time": 13058.63, "timestamp": "03:37:38", "text": "扮演治疗者，我不能说话。"}, {"type": "subtitle", "time": 13061.389, "timestamp": "03:37:41", "text": "我的天啊，敌人身上有块面包"}, {"type": "subtitle", "time": 13063.87, "timestamp": "03:37:43", "text": "团队。什么？"}, {"type": "subtitle", "time": 13067.03, "timestamp": "03:37:47", "text": "他妈的？搞什么鬼？上面有一块面包"}, {"type": "subtitle", "time": 13068.349, "timestamp": "03:37:48", "text": "敌人"}, {"type": "subtitle", "time": 13070.03, "timestamp": "03:37:50", "text": "团队。"}, {"type": "subtitle", "time": 13072.349, "timestamp": "03:37:52", "text": "哇，那是"}, {"type": "subtitle", "time": 13075.99, "timestamp": "03:37:55", "text": "好的。兄弟，那是我的小号吗？"}, {"type": "subtitle", "time": 13079.07, "timestamp": "03:37:59", "text": "帐户？我跟自己作对？为什么？"}]
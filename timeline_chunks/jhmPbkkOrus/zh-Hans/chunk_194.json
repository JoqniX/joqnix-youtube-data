[{"type": "subtitle", "time": 11640.07, "timestamp": "03:14:00", "text": "好的。好了，你可以走了。我可以"}, {"type": "subtitle", "time": 11642.15, "timestamp": "03:14:02", "text": "处理这件事。对不起。对不起。你曾是"}, {"type": "subtitle", "time": 11644.55, "timestamp": "03:14:04", "text": "说“是”。昨天他们不喜欢"}, {"type": "subtitle", "time": 11647.91, "timestamp": "03:14:07", "text": "我在虚拟游戏玩家类别上直播"}, {"type": "subtitle", "time": 11650.389, "timestamp": "03:14:10", "text": "因为《我的世界》。现在他们真的"}, {"type": "subtitle", "time": 11651.79, "timestamp": "03:14:11", "text": "给了我"}, {"type": "subtitle", "time": 11654.469, "timestamp": "03:14:14", "text": "因在……而受到的惩罚难道不是……"}, {"type": "subtitle", "time": 11657.429, "timestamp": "03:14:17", "text": "游戏？是的，因为做错了"}, {"type": "subtitle", "time": 11660.269, "timestamp": "03:14:20", "text": "类别。他们给了我一个"}, {"type": "subtitle", "time": 11662.87, "timestamp": "03:14:22", "text": "警告。谢天谢地，我没有得到我的"}, {"type": "subtitle", "time": 11665.67, "timestamp": "03:14:25", "text": "直播中断了30秒，但是哦"}, {"type": "subtitle", "time": 11671.429, "timestamp": "03:14:31", "text": "我的上帝。为什么会这样？"}, {"type": "subtitle", "time": 11672.71, "timestamp": "03:14:32", "text": "我不知道，伙计。"}, {"type": "subtitle", "time": 11675.429, "timestamp": "03:14:35", "text": "那。"}, {"type": "subtitle", "time": 11681.75, "timestamp": "03:14:41", "text": "你好。尽情享受你的“砰砰”声吧。"}, {"type": "subtitle", "time": 11682.91, "timestamp": "03:14:42", "text": "你好。"}, {"type": "subtitle", "time": 11685.269, "timestamp": "03:14:45", "text": "是的。另外，如果你想要的话……"}, {"type": "subtitle", "time": 11687.59, "timestamp": "03:14:47", "text": "加入我们，我们可以来，我们可以"}, {"type": "subtitle", "time": 11689.99, "timestamp": "03:14:49", "text": "就跟真人聊聊天什么的。"}, {"type": "subtitle", "time": 11691.429, "timestamp": "03:14:51", "text": "[音乐]"}, {"type": "subtitle", "time": 11694.79, "timestamp": "03:14:54", "text": "如果你想那样做的话。是的。是的。好的。"}, {"type": "subtitle", "time": 11699.309, "timestamp": "03:14:59", "text": "到时候见。好的。小心。"}]
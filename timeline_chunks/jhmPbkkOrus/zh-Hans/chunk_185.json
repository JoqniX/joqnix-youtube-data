[{"type": "subtitle", "time": 11101.15, "timestamp": "03:05:01", "text": "像"}, {"type": "subtitle", "time": 11103.429, "timestamp": "03:05:03", "text": "10:30。” 我心想，“哦，太好了。”"}, {"type": "subtitle", "time": 11107.349, "timestamp": "03:05:07", "text": "那就像……就像7、7或6"}, {"type": "subtitle", "time": 11110.469, "timestamp": "03:05:10", "text": "我的时间。我可以看一些类似这样的节目"}, {"type": "subtitle", "time": 11113.23, "timestamp": "03:05:13", "text": "看着。”他不在场2"}, {"type": "subtitle", "time": 11116.389, "timestamp": "03:05:16", "text": "小时。不过我睡着了。"}, {"type": "subtitle", "time": 11119.19, "timestamp": "03:05:19", "text": "他大概什么时候回来？"}, {"type": "subtitle", "time": 11121.269, "timestamp": "03:05:21", "text": "他回来了吗？我根本没看见"}, {"type": "subtitle", "time": 11123.429, "timestamp": "03:05:23", "text": "12:30"}, {"type": "subtitle", "time": 11130.95, "timestamp": "03:05:30", "text": "然后他就说：“哦，是的，你可以……”"}, {"type": "subtitle", "time": 11132.79, "timestamp": "03:05:32", "text": "过来。” 我心想，“哦，别这样嘛……”"}, {"type": "subtitle", "time": 11134.389, "timestamp": "03:05:34", "text": "想点赞直播、参与聊天互动吗？"}, {"type": "subtitle", "time": 11135.349, "timestamp": "03:05:35", "text": "有什么事吗？”我回答说：“哦，对，我会的。”"}, {"type": "subtitle", "time": 11137.95, "timestamp": "03:05:37", "text": "就那样做。” 我心想，“哦，对，就是这样。”"}, {"type": "subtitle", "time": 11141.51, "timestamp": "03:05:41", "text": "太好了。”然后我就等着，"}, {"type": "subtitle", "time": 11145.349, "timestamp": "03:05:45", "text": "“哎呀，我老了好多。”"}, {"type": "subtitle", "time": 11154.55, "timestamp": "03:05:54", "text": "是的。是的。是的。所以，是的，你当时"}, {"type": "subtitle", "time": 11156.23, "timestamp": "03:05:56", "text": "我要挨骂了。你知道的。你"}, {"type": "subtitle", "time": 11159.55, "timestamp": "03:05:59", "text": "你早就知道了，对吧？是的。"}]
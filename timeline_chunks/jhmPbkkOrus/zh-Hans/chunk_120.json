[{"type": "subtitle", "time": 7223.03, "timestamp": "02:00:23", "text": "[音乐]"}, {"type": "subtitle", "time": 7224.87, "timestamp": "02:00:24", "text": "哦，主播，你的班次结束了。去"}, {"type": "subtitle", "time": 7227.24, "timestamp": "02:00:27", "text": "吃。啊，是的。是的。我快完成了。"}, {"type": "subtitle", "time": 7236.79, "timestamp": "02:00:36", "text": "伴侣。一会儿我让你接手。"}, {"type": "subtitle", "time": 7240.31, "timestamp": "02:00:40", "text": "等着瞧吧，哦我的天哪，快看！"}, {"type": "subtitle", "time": 7242.87, "timestamp": "02:00:42", "text": "它有点像进度条。那是"}, {"type": "subtitle", "time": 7249.669, "timestamp": "02:00:49", "text": "等着瞧它现在就崩溃吧。未安装"}, {"type": "subtitle", "time": 7255.109, "timestamp": "02:00:55", "text": "依赖关系。哦，没事了。好的。"}, {"type": "subtitle", "time": 7258.75, "timestamp": "02:00:58", "text": "等等，等等，等等。快点。"}]
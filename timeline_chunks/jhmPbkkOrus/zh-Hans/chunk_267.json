[{"type": "subtitle", "time": 16022.309, "timestamp": "04:27:02", "text": "是的。你不知道你的治疗师是"}, {"type": "subtitle", "time": 16038.79, "timestamp": "04:27:18", "text": "我几乎没受伤。"}, {"type": "subtitle", "time": 16040.79, "timestamp": "04:27:20", "text": "消失。"}, {"type": "subtitle", "time": 16058.469, "timestamp": "04:27:38", "text": "好吧，我们现在有点儿把它们毁了。"}, {"type": "subtitle", "time": 16060.149, "timestamp": "04:27:40", "text": "要诚实。我们也正在存钱。哦，"}, {"type": "subtitle", "time": 16062.469, "timestamp": "04:27:42", "text": "他来自哪里？那东西在哪儿？"}, {"type": "subtitle", "time": 16063.87, "timestamp": "04:27:43", "text": "人来了"}, {"type": "subtitle", "time": 16070.349, "timestamp": "04:27:50", "text": "[音乐]"}, {"type": "subtitle", "time": 16072.67, "timestamp": "04:27:52", "text": "从？哦"}, {"type": "subtitle", "time": 16076.469, "timestamp": "04:27:56", "text": "男人。运动健将卡住了吗？不，不，它是"}]
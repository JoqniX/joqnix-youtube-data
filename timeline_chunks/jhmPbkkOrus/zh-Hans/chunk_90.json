[{"type": "subtitle", "time": 5401.03, "timestamp": "01:30:01", "text": "内容管理系统。所以每当我进行每次直播时"}, {"type": "subtitle", "time": 5404.149, "timestamp": "01:30:04", "text": "将提供一份摘要。我以前有。"}, {"type": "subtitle", "time": 5407.35, "timestamp": "01:30:07", "text": "我觉得自己承受不住了。"}, {"type": "subtitle", "time": 5410.51, "timestamp": "01:30:10", "text": "完全靠我自己。所有这些额外的事情。"}, {"type": "subtitle", "time": 5414.59, "timestamp": "01:30:14", "text": "不。比如像这样"}, {"type": "subtitle", "time": 5418.07, "timestamp": "01:30:18", "text": "直播将以……为标题"}, {"type": "subtitle", "time": 5421.189, "timestamp": "01:30:21", "text": "YouTube 上的直播缩略图，然后是我的"}, {"type": "subtitle", "time": 5424.79, "timestamp": "01:30:24", "text": "消息摘要 当"}, {"type": "subtitle", "time": 5427.149, "timestamp": "01:30:27", "text": "广播开始时"}, {"type": "subtitle", "time": 5430.229, "timestamp": "01:30:30", "text": "结尾你可以在YouTube上观看V。"}, {"type": "subtitle", "time": 5432.149, "timestamp": "01:30:32", "text": "在 YouTube 上观看频道直播"}, {"type": "subtitle", "time": 5434.39, "timestamp": "01:30:34", "text": "如果是 Twitch 主播的频道，你可以拥有"}, {"type": "subtitle", "time": 5436.709, "timestamp": "01:30:36", "text": "如果是在YouTube观看频道上的话"}, {"type": "subtitle", "time": 5439.27, "timestamp": "01:30:39", "text": "你可以在Twitch上看，呃，比利"}, {"type": "subtitle", "time": 5442.79, "timestamp": "01:30:42", "text": "比利也去了溪流。然后是"}, {"type": "subtitle", "time": 5445.75, "timestamp": "01:30:45", "text": "时间戳之类的东西。这就是过去的样子"}, {"type": "subtitle", "time": 5449.59, "timestamp": "01:30:49", "text": "在双向系统中。其中之一是自动化的"}, {"type": "subtitle", "time": 5452.709, "timestamp": "01:30:52", "text": "通过流媒体"}, {"type": "subtitle", "time": 5455.669, "timestamp": "01:30:55", "text": "呃，伙计，呃，直播，呃，主播男孩。"}, {"type": "subtitle", "time": 5459.11, "timestamp": "01:30:59", "text": "那是章节标记的起始点"}]
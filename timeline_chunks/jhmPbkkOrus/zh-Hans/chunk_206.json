[{"type": "subtitle", "time": 12363.269, "timestamp": "03:26:03", "text": "我是什么？惩罚妈妈认为他是"}, {"type": "subtitle", "time": 12387.349, "timestamp": "03:26:27", "text": "我的天啊。他在哪里演出的？"}, {"type": "subtitle", "time": 12401.83, "timestamp": "03:26:41", "text": "我的天啊。我的DPS输出太低了。"}, {"type": "subtitle", "time": 12405.429, "timestamp": "03:26:45", "text": "他们玩得像白痴一样。"}, {"type": "subtitle", "time": 12409.79, "timestamp": "03:26:49", "text": "是的，滚动开关。我可以切换，但是你"}, {"type": "subtitle", "time": 12413.99, "timestamp": "03:26:53", "text": "首先要知道，这款游戏就像……"}, {"type": "subtitle", "time": 12416.389, "timestamp": "03:26:56", "text": "像自负的人一样，自负的人将会"}, {"type": "subtitle", "time": 12418.07, "timestamp": "03:26:58", "text": "我觉得自己是游戏里最棒的，所以"}, {"type": "subtitle", "time": 12419.62, "timestamp": "03:26:59", "text": "我不会改变主意。"}]
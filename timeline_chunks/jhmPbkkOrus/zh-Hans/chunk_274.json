[{"type": "subtitle", "time": 16441.789, "timestamp": "04:34:01", "text": "那我走"}, {"type": "subtitle", "time": 16444.949, "timestamp": "04:34:04", "text": "再次。与此同时，你可以看到这个"}, {"type": "subtitle", "time": 16460.551, "timestamp": "04:34:20", "text": "皮肤。开头也太长了吧。是的，"}, {"type": "subtitle", "time": 16462.23, "timestamp": "04:34:22", "text": "如果你不知道的话，它会告诉你。"}, {"type": "subtitle", "time": 16464.47, "timestamp": "04:34:24", "text": "出自《奇异博士：多元宇宙》"}, {"type": "subtitle", "time": 16466.789, "timestamp": "04:34:26", "text": "疯狂电影。"}, {"type": "subtitle", "time": 16470.429, "timestamp": "04:34:30", "text": "这是表情符号。漂亮的"}, {"type": "subtitle", "time": 16473.189, "timestamp": "04:34:33", "text": "表情。我要说，这是最好的之一。"}, {"type": "subtitle", "time": 16476.07, "timestamp": "04:34:36", "text": "电话卡。最优秀的之一。我是说，"}, {"type": "subtitle", "time": 16478.07, "timestamp": "04:34:38", "text": "不管是什么铭牌。中的一个"}, {"type": "subtitle", "time": 16491.349, "timestamp": "04:34:51", "text": "最有价值球员。它比我想象的要短得多。"}, {"type": "subtitle", "time": 16493.51, "timestamp": "04:34:53", "text": "意料之中，你知道，就像。但这一切都只是猜测。"}, {"type": "subtitle", "time": 16495.99, "timestamp": "04:34:55", "text": "正确的。没关系。"}, {"type": "subtitle", "time": 16498.07, "timestamp": "04:34:58", "text": "没关系。还有，哦，如果你"}]
[{"type": "subtitle", "time": 13200.79, "timestamp": "03:40:00", "text": "特点。嗯，艾玛·弗罗斯特。任何事物"}, {"type": "subtitle", "time": 13204.469, "timestamp": "03:40:04", "text": "好的？有类似的吗？"}, {"type": "subtitle", "time": 13206.229, "timestamp": "03:40:06", "text": "好的，我们已经有一个护盾坦克了，因为"}, {"type": "subtitle", "time": 13210.63, "timestamp": "03:40:10", "text": "我以为他拼尽全力了。如果我失败了，"}, {"type": "subtitle", "time": 13212.269, "timestamp": "03:40:12", "text": "切换"}, {"type": "subtitle", "time": 13216.309, "timestamp": "03:40:16", "text": "我。如果我失败了，就跟我换。"}, {"type": "subtitle", "time": 13224.469, "timestamp": "03:40:24", "text": "好的，我们搞定了。我们正在做某事。是"}, {"type": "subtitle", "time": 13228.269, "timestamp": "03:40:28", "text": "叮。回来。毁灭战士是一款强大的游戏。"}, {"type": "subtitle", "time": 13231.229, "timestamp": "03:40:31", "text": "魔法。我预感我们会面对面。"}, {"type": "subtitle", "time": 13233.99, "timestamp": "03:40:33", "text": "很快又会再来一次。她偷偷小便。来"}]
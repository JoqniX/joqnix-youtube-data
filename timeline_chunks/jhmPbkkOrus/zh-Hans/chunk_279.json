[{"type": "subtitle", "time": 16742.31, "timestamp": "04:39:02", "text": "不，哨兵不在。我没有"}, {"type": "subtitle", "time": 16746.07, "timestamp": "04:39:06", "text": "我觉得哨兵会在这款游戏中出现，因为"}, {"type": "subtitle", "time": 16749.67, "timestamp": "04:39:09", "text": "他究竟会成为什么样的人？一辆坦克。我会"}, {"type": "subtitle", "time": 16751.67, "timestamp": "04:39:11", "text": "如果哨兵真的来了，我想要一个"}, {"type": "subtitle", "time": 16759.67, "timestamp": "04:39:19", "text": "我的天啊。我想要一架飞机"}, {"type": "subtitle", "time": 16763.349, "timestamp": "04:39:23", "text": "坦克。是的。钻石。现在，我是谁？"}, {"type": "subtitle", "time": 16766.07, "timestamp": "04:39:26", "text": "我要被逐出这场比赛了吗？"}, {"type": "subtitle", "time": 16782.788, "timestamp": "04:39:42", "text": "可能两者都有。是的。我也知道"}, {"type": "subtitle", "time": 16785.03, "timestamp": "04:39:45", "text": "什么？因为他还有另一个自我。我认为"}, {"type": "subtitle", "time": 16787.07, "timestamp": "04:39:47", "text": "他会在两者之间切换"}, {"type": "subtitle", "time": 16789.99, "timestamp": "04:39:49", "text": "形式，你知道，就像变化之间的那种"}, {"type": "subtitle", "time": 16792.788, "timestamp": "04:39:52", "text": "就像是另一种形式。我不想"}, {"type": "subtitle", "time": 16795.83, "timestamp": "04:39:55", "text": "不想破坏大家的兴致，因为……是的，如果你"}, {"type": "subtitle", "time": 16799.948, "timestamp": "04:39:59", "text": "不知道，你也不知道。患病的"}]
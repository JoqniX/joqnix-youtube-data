[{"type": "subtitle", "time": 13800.229, "timestamp": "03:50:00", "text": "我想知道我是否真的……因为我……"}, {"type": "subtitle", "time": 13802.349, "timestamp": "03:50:02", "text": "我对其他东西挺无聊的"}, {"type": "subtitle", "time": 13805.429, "timestamp": "03:50:05", "text": "人物。我想……哦，是的。"}, {"type": "subtitle", "time": 13807.63, "timestamp": "03:50:07", "text": "嘘。"}, {"type": "subtitle", "time": 13820.79, "timestamp": "03:50:20", "text": "稍等。为什么大家都在封禁？"}, {"type": "subtitle", "time": 13823.349, "timestamp": "03:50:23", "text": "蜘蛛侠？就像他们要去一样。是的。"}, {"type": "subtitle", "time": 13825.51, "timestamp": "03:50:25", "text": "哦，是的。瞧！干得漂亮，伙计们。这"}, {"type": "subtitle", "time": 13826.95, "timestamp": "03:50:26", "text": "另一支队伍也禁用了蜘蛛侠。"}, {"type": "subtitle", "time": 13828.51, "timestamp": "03:50:28", "text": "我们干脆禁止算了"}, {"type": "subtitle", "time": 13831.15, "timestamp": "03:50:31", "text": "格鲁。操"}, {"type": "subtitle", "time": 13835.229, "timestamp": "03:50:35", "text": "基督。我们现在禁止的是什么？这"}, {"type": "subtitle", "time": 13838.469, "timestamp": "03:50:38", "text": "更多的。哦，都是因为我们的铁腕统治。哦，"}, {"type": "subtitle", "time": 13842.75, "timestamp": "03:50:42", "text": "让我们禁止更多和拳头，"}, {"type": "subtitle", "time": 13845.67, "timestamp": "03:50:45", "text": "正确的？好的，当然可以，哥们儿。当然，当然"}, {"type": "subtitle", "time": 13847.55, "timestamp": "03:50:47", "text": "伙伴。当然，当然。当然，"}, {"type": "subtitle", "time": 13851.07, "timestamp": "03:50:51", "text": "当然。为什么我的兄弟要封禁你"}, {"type": "subtitle", "time": 13853.269, "timestamp": "03:50:53", "text": "铁拳？他们有铁拳吗？"}, {"type": "subtitle", "time": 13855.11, "timestamp": "03:50:55", "text": "玩家？哦，他们把艾玛从来都禁了。"}]
[{"type": "subtitle", "time": 15671.11, "timestamp": "04:21:11", "text": "或许如此。是的，他说得没错。他们"}, {"type": "subtitle", "time": 15681.469, "timestamp": "04:21:21", "text": "我的天哪，她简直完美。"}, {"type": "subtitle", "time": 15695.03, "timestamp": "04:21:35", "text": "是的，托尔是个不错的选择。"}, {"type": "subtitle", "time": 15696.79, "timestamp": "04:21:36", "text": "伙计们。托尔是个非常好的选择。"}, {"type": "subtitle", "time": 15699.59, "timestamp": "04:21:39", "text": "这几个家伙。顺便一提，星爵是"}, {"type": "subtitle", "time": 15701.83, "timestamp": "04:21:41", "text": "就像活动中随机发放的皮肤一样。它"}, {"type": "subtitle", "time": 15704.229, "timestamp": "04:21:44", "text": "就像月球表面现象一样。所以，是的，就是这样。"}, {"type": "subtitle", "time": 15716.229, "timestamp": "04:21:56", "text": "为什么是哦，上帝。需要一支顶尖的队伍才能赢"}]
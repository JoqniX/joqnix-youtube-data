[{"type": "subtitle", "time": 18422.31, "timestamp": "05:07:02", "text": "哦，"}, {"type": "subtitle", "time": 18434.15, "timestamp": "05:07:14", "text": "我的天啊，我们成功了！我的老天！哦"}, {"type": "subtitle", "time": 18437.27, "timestamp": "05:07:17", "text": "我的现状是里约热内卢，他刚刚"}, {"type": "subtitle", "time": 18439.11, "timestamp": "05:07:19", "text": "已加入。"}, {"type": "subtitle", "time": 18441.19, "timestamp": "05:07:21", "text": "什么？不。"}, {"type": "subtitle", "time": 18443.51, "timestamp": "05:07:23", "text": "搞什么鬼？我看到一个很大的"}, {"type": "subtitle", "time": 18445.83, "timestamp": "05:07:25", "text": "眼角瞥见屁股。我当时就想，"}, {"type": "subtitle", "time": 18448.55, "timestamp": "05:07:28", "text": "那他妈是什么玩意儿？"}, {"type": "subtitle", "time": 18450.55, "timestamp": "05:07:30", "text": "嘿，你觉得你赢这场比赛是什么意思？"}, {"type": "subtitle", "time": 18452.91, "timestamp": "05:07:32", "text": "我正在扮演我的主角。如果你"}, {"type": "subtitle", "time": 18455.15, "timestamp": "05:07:35", "text": "伙计们"}, {"type": "subtitle", "time": 18457.75, "timestamp": "05:07:37", "text": "想知道你们在玩漫威游戏吗？"}, {"type": "subtitle", "time": 18461.19, "timestamp": "05:07:41", "text": "你们没邀请我。"}, {"type": "subtitle", "time": 18473.35, "timestamp": "05:07:53", "text": "那只罗恩羊怎么样了？"}, {"type": "subtitle", "time": 18476.948, "timestamp": "05:07:56", "text": "我刚睡醒。你醒了？"}, {"type": "subtitle", "time": 18478.47, "timestamp": "05:07:58", "text": "是的。"}]
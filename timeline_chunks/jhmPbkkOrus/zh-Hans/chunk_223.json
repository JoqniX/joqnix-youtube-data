[{"type": "subtitle", "time": 13401.59, "timestamp": "03:43:21", "text": "乔兄弟？兄弟，我们做不到。"}, {"type": "subtitle", "time": 13405.75, "timestamp": "03:43:25", "text": "只剩60秒了。我"}, {"type": "subtitle", "time": 13409.99, "timestamp": "03:43:29", "text": "不解决这个问题我绝不罢休。"}, {"type": "subtitle", "time": 13413.03, "timestamp": "03:43:33", "text": "见证我的全部力量。"}, {"type": "subtitle", "time": 13415.83, "timestamp": "03:43:35", "text": "我现在可以肆无忌惮了。快点。快点。"}, {"type": "subtitle", "time": 13417.429, "timestamp": "03:43:37", "text": "快点。缓慢但稳步前进。缓慢但"}, {"type": "subtitle", "time": 13431.15, "timestamp": "03:43:51", "text": "它是"}]
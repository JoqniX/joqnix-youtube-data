[{"type": "subtitle", "time": 20466.11, "timestamp": "05:41:06", "text": "晚上。 W"}, {"type": "subtitle", "time": 20469.548, "timestamp": "05:41:09", "text": "上海。我住"}, {"type": "subtitle", "time": 20472.83, "timestamp": "05:41:12", "text": "在我生活之前"}, {"type": "subtitle", "time": 20476.83, "timestamp": "05:41:16", "text": "在那之前我休息了一会儿。"}, {"type": "subtitle", "time": 20489.07, "timestamp": "05:41:29", "text": "什么？然后我休息了"}, {"type": "subtitle", "time": 20491.35, "timestamp": "05:41:31", "text": "受到惩罚。哦，你可以把它写进去。"}, {"type": "subtitle", "time": 20494.39, "timestamp": "05:41:34", "text": "中国人。我会翻译。不用担心。"}, {"type": "subtitle", "time": 20496.19, "timestamp": "05:41:36", "text": "请写下"}, {"type": "subtitle", "time": 20498.51, "timestamp": "05:41:38", "text": "中国人。不"}, {"type": "subtitle", "time": 20501.83, "timestamp": "05:41:41", "text": "担心。因为我很难过。你怎么可能……"}, {"type": "subtitle", "time": 20504.59, "timestamp": "05:41:44", "text": "明确指出我是"}]
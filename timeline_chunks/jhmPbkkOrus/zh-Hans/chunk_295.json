[{"type": "subtitle", "time": 17701.27, "timestamp": "04:55:01", "text": "所以，你想让我玩一局游戏？因为我"}, {"type": "subtitle", "time": 17704.31, "timestamp": "04:55:04", "text": "之后只能玩一局了。"}, {"type": "subtitle", "time": 17706.91, "timestamp": "04:55:06", "text": "嗯。不是五吗？将会是"}, {"type": "subtitle", "time": 17713.03, "timestamp": "04:55:13", "text": "算了，管他呢。我会付钱，因为我要……"}, {"type": "subtitle", "time": 17714.788, "timestamp": "04:55:14", "text": "如果我赢了，我也能达到白金级别。"}, {"type": "subtitle", "time": 17720.31, "timestamp": "04:55:20", "text": "是的。是的。是的。没得到多少"}, {"type": "subtitle", "time": 17723.19, "timestamp": "04:55:23", "text": "积分。我当时状态正佳，得了25分"}, {"type": "subtitle", "time": 17726.59, "timestamp": "04:55:26", "text": "然后我就没爆发。我得到了"}, {"type": "subtitle", "time": 17736.51, "timestamp": "04:55:36", "text": "诡异的。只是一点点"}, {"type": "subtitle", "time": 17748.788, "timestamp": "04:55:48", "text": "你昨天见到他的时候，你……"}, {"type": "subtitle", "time": 17751.19, "timestamp": "04:55:51", "text": "首先是同样的表达式。是的，我会这么说。"}, {"type": "subtitle", "time": 17756.628, "timestamp": "04:55:56", "text": "你觉得自己想成为哪个英雄？"}, {"type": "subtitle", "time": 17759.03, "timestamp": "04:55:59", "text": "今天？"}]
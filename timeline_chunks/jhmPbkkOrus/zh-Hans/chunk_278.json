[{"type": "subtitle", "time": 16681.91, "timestamp": "04:38:01", "text": "如果要进入这个名单，你会选择哪一个？"}, {"type": "subtitle", "time": 16685.67, "timestamp": "04:38:05", "text": "是？别说是死侍。请，"}, {"type": "subtitle", "time": 16692.189, "timestamp": "04:38:12", "text": "死池。"}, {"type": "subtitle", "time": 16694.949, "timestamp": "04:38:14", "text": "请。你当时有一段时间不在。哦，别这样"}, {"type": "subtitle", "time": 16697.349, "timestamp": "04:38:17", "text": "经常担心自己离线。你没有"}, {"type": "subtitle", "time": 16700.07, "timestamp": "04:38:20", "text": "错过任何重要信息。我当时就像在等着什么似的。"}, {"type": "subtitle", "time": 16704.31, "timestamp": "04:38:24", "text": "对于Jock的嗯……回应。我想那就是"}, {"type": "subtitle", "time": 16705.83, "timestamp": "04:38:25", "text": "唯一一件事。你知道吗？出色地"}, {"type": "subtitle", "time": 16707.51, "timestamp": "04:38:27", "text": "再打一局，等乔来了。"}, {"type": "subtitle", "time": 16708.59, "timestamp": "04:38:28", "text": "这需要一个"}, {"type": "subtitle", "time": 16711.99, "timestamp": "04:38:31", "text": "尽管。这需要一段时间。是的。我当时"}, {"type": "subtitle", "time": 16714.269, "timestamp": "04:38:34", "text": "只是问问"}, {"type": "subtitle", "time": 16722.75, "timestamp": "04:38:42", "text": "挑选。哨兵系统在那里吗？"}, {"type": "subtitle", "time": 16726.47, "timestamp": "04:38:46", "text": "不。但哨兵正在观察。你喜欢做"}, {"type": "subtitle", "time": 16728.269, "timestamp": "04:38:48", "text": "你喜欢亚当"}, {"type": "subtitle", "time": 16731.51, "timestamp": "04:38:51", "text": "术士？他很善良，长得像哨兵。"}, {"type": "subtitle", "time": 16733.75, "timestamp": "04:38:53", "text": "差不多就行了，你知道的。他看起来很近"}]
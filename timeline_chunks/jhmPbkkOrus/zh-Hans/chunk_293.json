[{"type": "subtitle", "time": 17580.868, "timestamp": "04:53:00", "text": "该死。总之，呃，我想，我想"}, {"type": "subtitle", "time": 17583.43, "timestamp": "04:53:03", "text": "那是我第一次喜欢上流行音乐的时候。"}, {"type": "subtitle", "time": 17587.31, "timestamp": "04:53:07", "text": "就像在你的直播中说，“我的天哪，这"}, {"type": "subtitle", "time": 17595.11, "timestamp": "04:53:15", "text": "首先，我首先想到的是……"}, {"type": "subtitle", "time": 17596.948, "timestamp": "04:53:16", "text": "就像我遇见你的时候，就像，“哦，这"}, {"type": "subtitle", "time": 17600.23, "timestamp": "04:53:20", "text": "这个人可能是跨性别者之类的。"}, {"type": "subtitle", "time": 17604.15, "timestamp": "04:53:24", "text": "我当时可能想的是，“是啊，跨性别者或"}, {"type": "subtitle", "time": 17606.03, "timestamp": "04:53:26", "text": "就像"}, {"type": "subtitle", "time": 17609.03, "timestamp": "04:53:29", "text": "一个有点像假小子的女性"}, {"type": "subtitle", "time": 17611.83, "timestamp": "04:53:31", "text": "模型。”然后就像，你知道，坐在"}, {"type": "subtitle", "time": 17613.83, "timestamp": "04:53:33", "text": "聊了一会儿，看到了人们的……"}, {"type": "subtitle", "time": 17616.07, "timestamp": "04:53:36", "text": "评论，然后我就想，“好吧，这是……”"}, {"type": "subtitle", "time": 17625.51, "timestamp": "04:53:45", "text": "兄弟，是啊，你的声音确实不太好听。"}, {"type": "subtitle", "time": 17628.628, "timestamp": "04:53:48", "text": "令人困惑。好吧，我先做的。所以就是这样。"}, {"type": "subtitle", "time": 17630.47, "timestamp": "04:53:50", "text": "这就像个跨性别男性之类的？一个"}, {"type": "subtitle", "time": 17633.11, "timestamp": "04:53:53", "text": "跨性别女性？这是第一次"}, {"type": "subtitle", "time": 17634.628, "timestamp": "04:53:54", "text": "这让人感到困惑。是的，第一个"}, {"type": "subtitle", "time": 17637.03, "timestamp": "04:53:57", "text": "时间。然后，之后我……"}]
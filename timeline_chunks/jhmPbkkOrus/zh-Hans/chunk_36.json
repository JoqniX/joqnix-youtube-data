[{"type": "subtitle", "time": 2188.91, "timestamp": "00:36:28", "text": "零。我的天啊。离开。我该如何发送？"}, {"type": "subtitle", "time": 2198.95, "timestamp": "00:36:38", "text": "不。我的天哪。这更复杂一些。"}, {"type": "subtitle", "time": 2207.31, "timestamp": "00:36:47", "text": "是。好的。如果我跑"}, {"type": "subtitle", "time": 2209.63, "timestamp": "00:36:49", "text": "如果我运行"}, {"type": "subtitle", "time": 2212.51, "timestamp": "00:36:52", "text": "这样，它就会是"}, {"type": "subtitle", "time": 2215.67, "timestamp": "00:36:55", "text": "在职的。是的。已连接服务器。"}, {"type": "subtitle", "time": 2217.99, "timestamp": "00:36:57", "text": "是的，它能连接也能断开。"}]
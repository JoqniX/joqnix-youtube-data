[{"type": "subtitle", "time": 11166.309, "timestamp": "03:06:06", "text": "耶稣。我当时想，他要去吃饭了。"}, {"type": "subtitle", "time": 11168.87, "timestamp": "03:06:08", "text": "就像他那段时间的两个小时。那太好了。我"}, {"type": "subtitle", "time": 11170.63, "timestamp": "03:06:10", "text": "可以像玩游戏一样玩两个小时，然后"}, {"type": "subtitle", "time": 11174.309, "timestamp": "03:06:14", "text": "他回来后我就可以走了。他是 他是"}, {"type": "subtitle", "time": 11178.389, "timestamp": "03:06:18", "text": "还在唱歌。他还在唱歌。"}, {"type": "subtitle", "time": 11181.75, "timestamp": "03:06:21", "text": "我当时太投入了。"}, {"type": "subtitle", "time": 11184.389, "timestamp": "03:06:24", "text": "我的天啊。我只是说说而已，这家伙确实有。"}, {"type": "subtitle", "time": 11186.67, "timestamp": "03:06:26", "text": "查德，别这样，别这样"}, {"type": "subtitle", "time": 11189.59, "timestamp": "03:06:29", "text": "男。别学他。吃你的"}, {"type": "subtitle", "time": 11193.11, "timestamp": "03:06:33", "text": "食物。把午饭吃完。"}, {"type": "subtitle", "time": 11196.469, "timestamp": "03:06:36", "text": "休息。别学他那样。"}, {"type": "subtitle", "time": 11204.389, "timestamp": "03:06:44", "text": "兄弟绕着锡罐转圈，绕着一个很小的罐子转圈"}, {"type": "subtitle", "time": 11206.389, "timestamp": "03:06:46", "text": "问题。你他妈到底在循环什么？"}, {"type": "subtitle", "time": 11208.63, "timestamp": "03:06:48", "text": "在？"}, {"type": "subtitle", "time": 11211.429, "timestamp": "03:06:51", "text": "哦，我只能降级了。然后我"}, {"type": "subtitle", "time": 11213.71, "timestamp": "03:06:53", "text": "我当时就想，为什么它不起作用？我"}, {"type": "subtitle", "time": 11216.95, "timestamp": "03:06:56", "text": "我一直在看这些论坛帖子，"}, {"type": "subtitle", "time": 11219.19, "timestamp": "03:06:59", "text": "这些东西让我很困惑。"}]
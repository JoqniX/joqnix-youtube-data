[{"type": "subtitle", "time": 9422.55, "timestamp": "02:37:02", "text": "搞砸了，兄弟。好吧，没事了。你知道"}, {"type": "subtitle", "time": 9425.03, "timestamp": "02:37:05", "text": "什么？我这就把这个文件夹删掉。"}, {"type": "subtitle", "time": 9430.389, "timestamp": "02:37:10", "text": "这个人没干活。我会删除。"}, {"type": "subtitle", "time": 9433.81, "timestamp": "02:37:13", "text": "把你也删掉。让我们创建一个新的"}, {"type": "subtitle", "time": 9435.15, "timestamp": "02:37:15", "text": "[音乐]"}, {"type": "subtitle", "time": 9437.99, "timestamp": "02:37:17", "text": "文件夹。我会留下“不，等等”。新的"}, {"type": "subtitle", "time": 9439.67, "timestamp": "02:37:19", "text": "不需要文件夹。不，我们要去"}, {"type": "subtitle", "time": 9442.87, "timestamp": "02:37:22", "text": "放在这里。不是。所以，"}, {"type": "subtitle", "time": 9444.27, "timestamp": "02:37:24", "text": "嗯，"}, {"type": "subtitle", "time": 9451.469, "timestamp": "02:37:31", "text": "这。好了。"}, {"type": "subtitle", "time": 9454.389, "timestamp": "02:37:34", "text": "这里。我的意思是，我们可以手动操作那个。"}, {"type": "subtitle", "time": 9457.23, "timestamp": "02:37:37", "text": "折叠。那是"}, {"type": "subtitle", "time": 9458.91, "timestamp": "02:37:38", "text": "正确的。"}, {"type": "subtitle", "time": 9471.55, "timestamp": "02:37:51", "text": "美好的。哦，等等。很多人分叉了。"}]
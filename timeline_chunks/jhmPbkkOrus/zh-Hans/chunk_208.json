[{"type": "subtitle", "time": 12483.429, "timestamp": "03:28:03", "text": "叛军球员，我称他们为白痴。"}, {"type": "subtitle", "time": 12485.91, "timestamp": "03:28:05", "text": "你需要一支顶尖的团队。总之，他们确实这么做了。"}, {"type": "subtitle", "time": 12487.51, "timestamp": "03:28:07", "text": "交换角色后，问题解决了。"}, {"type": "subtitle", "time": 12489.03, "timestamp": "03:28:09", "text": "结束了。我认为是因为……"}, {"type": "subtitle", "time": 12491.67, "timestamp": "03:28:11", "text": "年年都有的事。我们明白了，他们"}, {"type": "subtitle", "time": 12493.269, "timestamp": "03:28:13", "text": "我们只是站在那个立场上而已。"}, {"type": "subtitle", "time": 12495.63, "timestamp": "03:28:15", "text": "类似农业"}, {"type": "subtitle", "time": 12500.429, "timestamp": "03:28:20", "text": "全部。是的。呃，你是……"}, {"type": "subtitle", "time": 12503.75, "timestamp": "03:28:23", "text": "确定吗？这他妈是什么玩意儿？"}, {"type": "subtitle", "time": 12508.03, "timestamp": "03:28:28", "text": "他们肯定会再次纵火焚烧任何东西"}, {"type": "subtitle", "time": 12511.429, "timestamp": "03:28:31", "text": "柜台。他有酒吧，所以我不能和他玩。"}, {"type": "subtitle", "time": 12514.95, "timestamp": "03:28:34", "text": "出色地。第二轮。你他妈的为什么不这么做？"}, {"type": "subtitle", "time": 12516.79, "timestamp": "03:28:36", "text": "说点什么吗？"}, {"type": "subtitle", "time": 12523.55, "timestamp": "03:28:43", "text": "苍蝇互相攻击。玩他妈的"}, {"type": "subtitle", "time": 12526.11, "timestamp": "03:28:46", "text": "铁腕。不，他"}, {"type": "subtitle", "time": 12531.91, "timestamp": "03:28:51", "text": "可以坚持使用佩妮的攻击。准备。"}, {"type": "subtitle", "time": 12538.63, "timestamp": "03:28:58", "text": "我是个坦克兵。"}]
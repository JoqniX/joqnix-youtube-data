[{"type": "subtitle", "time": 16802.788, "timestamp": "04:40:02", "text": "男人。是的，另一种形式就像他"}, {"type": "subtitle", "time": 16804.47, "timestamp": "04:40:04", "text": "在它们之间切换。那将是"}, {"type": "subtitle", "time": 16811.43, "timestamp": "04:40:11", "text": "凉爽的。是的。是的。是的。"}, {"type": "subtitle", "time": 16812.99, "timestamp": "04:40:12", "text": "那"}, {"type": "subtitle", "time": 16815.39, "timestamp": "04:40:15", "text": "就像现在我想到的"}, {"type": "subtitle", "time": 16818.11, "timestamp": "04:40:18", "text": "来自哨兵"}, {"type": "subtitle", "time": 16823.27, "timestamp": "04:40:23", "text": "漫画。我觉得有点难或者"}, {"type": "subtitle", "time": 16825.43, "timestamp": "04:40:25", "text": "恶棍。我没有评判的意思。这有点像"}, {"type": "subtitle", "time": 16832.868, "timestamp": "04:40:32", "text": "想想如果他变成坦克，他会怎么样？"}, {"type": "subtitle", "time": 16849.35, "timestamp": "04:40:49", "text": "还。我用铁拳赢得了床，但我"}, {"type": "subtitle", "time": 16859.55, "timestamp": "04:40:59", "text": "哦"}]
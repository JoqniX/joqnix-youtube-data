[{"type": "subtitle", "time": 19560.47, "timestamp": "05:26:00", "text": "需要，因为它现在是中国的，否则……"}, {"type": "subtitle", "time": 19563.51, "timestamp": "05:26:03", "text": "或者，我也可以把它放到谷歌上。"}, {"type": "subtitle", "time": 19567.11, "timestamp": "05:26:07", "text": "翻译一下没问题，因为如果我"}, {"type": "subtitle", "time": 19569.83, "timestamp": "05:26:09", "text": "阅读聊天记录，然后是一些中文"}, {"type": "subtitle", "time": 19571.51, "timestamp": "05:26:11", "text": "就像字母表一样，我也会是"}, {"type": "subtitle", "time": 19573.47, "timestamp": "05:26:13", "text": "太困惑了"}, {"type": "subtitle", "time": 19579.83, "timestamp": "05:26:19", "text": "是的，总有一天他们会做得更好。"}, {"type": "subtitle", "time": 19582.67, "timestamp": "05:26:22", "text": "阅读中文之类的东西。我必须"}, {"type": "subtitle", "time": 19585.59, "timestamp": "05:26:25", "text": "学习。但这很难。不，那就是"}, {"type": "subtitle", "time": 19587.35, "timestamp": "05:26:27", "text": "事物。"}, {"type": "subtitle", "time": 19590.23, "timestamp": "05:26:30", "text": "是的。是的。这是。这是。"}, {"type": "subtitle", "time": 19593.43, "timestamp": "05:26:33", "text": "另一种语言，比如日语和"}, {"type": "subtitle", "time": 19596.21, "timestamp": "05:26:36", "text": "中国人。这很难。"}, {"type": "subtitle", "time": 19606.31, "timestamp": "05:26:46", "text": "总之，我这就走了。你们俩有"}, {"type": "subtitle", "time": 19608.948, "timestamp": "05:26:48", "text": "乐趣。如果理代子要留在这里，"}, {"type": "subtitle", "time": 19610.788, "timestamp": "05:26:50", "text": "你打算留在这里吗？不，我想"}, {"type": "subtitle", "time": 19614.47, "timestamp": "05:26:54", "text": "我也会去看医生。你好。访问"}, {"type": "subtitle", "time": 19617.19, "timestamp": "05:26:57", "text": "医生。"}]
[{"type": "subtitle", "time": 19442.55, "timestamp": "05:24:02", "text": "现在。谢谢。"}, {"type": "subtitle", "time": 19445.35, "timestamp": "05:24:05", "text": "是啊，我只是想说，Jock就是Jock。"}, {"type": "subtitle", "time": 19447.91, "timestamp": "05:24:07", "text": "这就是我玩排位赛的原因。"}, {"type": "subtitle", "time": 19451.67, "timestamp": "05:24:11", "text": "游戏。什么？只要我有空，只要"}, {"type": "subtitle", "time": 19453.75, "timestamp": "05:24:13", "text": "我有空，我给Jog打个电话就行了。比如，可以"}, {"type": "subtitle", "time": 19455.51, "timestamp": "05:24:15", "text": "我接管你的直播来玩"}, {"type": "subtitle", "time": 19457.15, "timestamp": "05:24:17", "text": "在我们的排名"}, {"type": "subtitle", "time": 19463.91, "timestamp": "05:24:23", "text": "因为我不想玩《我的对手》"}, {"type": "subtitle", "time": 19465.93, "timestamp": "05:24:25", "text": "独自的。"}, {"type": "subtitle", "time": 19474.31, "timestamp": "05:24:34", "text": "是的。总之，我想我会去的。"}, {"type": "subtitle", "time": 19478.628, "timestamp": "05:24:38", "text": "现在因为我要上班。你好。谢谢。"}, {"type": "subtitle", "time": 19481.75, "timestamp": "05:24:41", "text": "是的。是的。是的。我希望你也能染上这种病。"}, {"type": "subtitle", "time": 19485.03, "timestamp": "05:24:45", "text": "问题已经解决了，伙计。"}, {"type": "subtitle", "time": 19488.07, "timestamp": "05:24:48", "text": "我现在就开始做这件事。"}, {"type": "subtitle", "time": 19489.75, "timestamp": "05:24:49", "text": "是的。是啊，我当时就在想……"}, {"type": "subtitle", "time": 19492.47, "timestamp": "05:24:52", "text": "那。"}, {"type": "subtitle", "time": 19494.788, "timestamp": "05:24:54", "text": "我确实问了他们给你的聊天记录。"}, {"type": "subtitle", "time": 19497.83, "timestamp": "05:24:57", "text": "右腿加现场呃他们说他们"}]
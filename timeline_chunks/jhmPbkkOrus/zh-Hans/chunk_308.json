[{"type": "subtitle", "time": 18480.55, "timestamp": "05:08:00", "text": "好的。哦，你下午好。这"}, {"type": "subtitle", "time": 18482.788, "timestamp": "05:08:02", "text": "正在刮风。"}, {"type": "subtitle", "time": 18485.19, "timestamp": "05:08:05", "text": "我下班回家后就开始了。"}, {"type": "subtitle", "time": 18489.03, "timestamp": "05:08:09", "text": "先是按计划进行，然后我就忘了。"}, {"type": "subtitle", "time": 18490.868, "timestamp": "05:08:10", "text": "我需要休息，我的身体也需要休息。"}, {"type": "subtitle", "time": 18493.27, "timestamp": "05:08:13", "text": "刚刚生效。"}, {"type": "subtitle", "time": 18497.27, "timestamp": "05:08:17", "text": "嗯。我没去睡觉。谁是"}, {"type": "subtitle", "time": 18505.11, "timestamp": "05:08:25", "text": "你在说什么？我勒个去？正在问"}, {"type": "subtitle", "time": 18507.91, "timestamp": "05:08:27", "text": "这是谁？"}, {"type": "subtitle", "time": 18509.35, "timestamp": "05:08:29", "text": "我们不在乎他。我们讨厌这样"}, {"type": "subtitle", "time": 18511.11, "timestamp": "05:08:31", "text": "男。它在Twitch上。我们找到了这个人。"}, {"type": "subtitle", "time": 18513.19, "timestamp": "05:08:33", "text": "你是什​​么意思？我们找到了这个人。你"}, {"type": "subtitle", "time": 18515.11, "timestamp": "05:08:35", "text": "真的有四五个人向我求婚。"}, {"type": "subtitle", "time": 18516.868, "timestamp": "05:08:36", "text": "几天前。你是什​​么意思？关闭"}, {"type": "subtitle", "time": 18520.23, "timestamp": "05:08:40", "text": "搞砸了，兄弟。这人死了。我会"}, {"type": "subtitle", "time": 18527.03, "timestamp": "05:08:47", "text": "只要能让你晚上睡得着就行，狗狗。"}, {"type": "subtitle", "time": 18530.47, "timestamp": "05:08:50", "text": "任何能让你晚上睡得着的东西。"}, {"type": "subtitle", "time": 18532.15, "timestamp": "05:08:52", "text": "你们俩都以为我睡觉在……"}]
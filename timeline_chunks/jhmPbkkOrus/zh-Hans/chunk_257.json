[{"type": "subtitle", "time": 15421.309, "timestamp": "04:17:01", "text": "[音乐]"}, {"type": "subtitle", "time": 15428.87, "timestamp": "04:17:08", "text": "我们确实有这种感觉"}, {"type": "subtitle", "time": 15430.87, "timestamp": "04:17:10", "text": "我想这位美丽的女士应该……"}, {"type": "subtitle", "time": 15433.03, "timestamp": "04:17:13", "text": "受洛基奴役"}, {"type": "subtitle", "time": 15448.07, "timestamp": "04:17:28", "text": "好的。他们说：“是的，我得走了。”"}, {"type": "subtitle", "time": 15452.55, "timestamp": "04:17:32", "text": "远的。虽然我会去，但我更想去尖塔。"}, {"type": "subtitle", "time": 15461.83, "timestamp": "04:17:41", "text": "机不可失，时不再来。你的力量就是我的力量。"}]
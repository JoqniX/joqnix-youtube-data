[{"type": "subtitle", "time": 11460.79, "timestamp": "03:11:00", "text": "难的。这不是我对世界的计划。"}, {"type": "subtitle", "time": 11463.59, "timestamp": "03:11:03", "text": "统治。他是个恶人。我是"}, {"type": "subtitle", "time": 11467.91, "timestamp": "03:11:07", "text": "并非邪恶。我说我没事。我是"}, {"type": "subtitle", "time": 11469.75, "timestamp": "03:11:09", "text": "我没说你色眯眯的，兄弟。我当时"}, {"type": "subtitle", "time": 11472.23, "timestamp": "03:11:12", "text": "我只是说你是个邪恶的人。我是"}, {"type": "subtitle", "time": 11475.11, "timestamp": "03:11:15", "text": "并非邪恶。我没说过任何“我是”之类的话"}, {"type": "subtitle", "time": 11479.91, "timestamp": "03:11:19", "text": "好的。我很好。我让朋友等了"}, {"type": "subtitle", "time": 11483.03, "timestamp": "03:11:23", "text": "三个小时是件好事。对不起"}, {"type": "subtitle", "time": 11490.07, "timestamp": "03:11:30", "text": "哇。没想到我的朋友会喜欢"}, {"type": "subtitle", "time": 11492.79, "timestamp": "03:11:32", "text": "他们真的把我忘了。哦，是的，我"}, {"type": "subtitle", "time": 11495.75, "timestamp": "03:11:35", "text": "有个男的在等着。它已经运行了多少小时？"}, {"type": "subtitle", "time": 11497.99, "timestamp": "03:11:37", "text": "到过？"}, {"type": "subtitle", "time": 11500.79, "timestamp": "03:11:40", "text": "我的天哪。"}, {"type": "subtitle", "time": 11502.87, "timestamp": "03:11:42", "text": "总之，你可以展示一下。是流"}, {"type": "subtitle", "time": 11505.19, "timestamp": "03:11:45", "text": "在职的？你看到了什么吗？康康舞"}, {"type": "subtitle", "time": 11508.07, "timestamp": "03:11:48", "text": "其实，哦，等等。一秒钟。让我来做"}, {"type": "subtitle", "time": 11514.15, "timestamp": "03:11:54", "text": "让我来做这件事。所以，你会持续多久？"}, {"type": "subtitle", "time": 11517.75, "timestamp": "03:11:57", "text": "我们该怎么做？因为我能，我能坚持下去"}]
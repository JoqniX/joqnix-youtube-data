[{"type": "subtitle", "time": 19806.99, "timestamp": "05:30:06", "text": "颚。是的，我想下次你知道"}, {"type": "subtitle", "time": 19809.35, "timestamp": "05:30:09", "text": "什么？当你感到疲倦时，只需"}, {"type": "subtitle", "time": 19811.548, "timestamp": "05:30:11", "text": "请给我发消息，如果我可以的话。"}, {"type": "subtitle", "time": 19815.91, "timestamp": "05:30:15", "text": "结束了，我再看看。"}, {"type": "subtitle", "time": 19818.07, "timestamp": "05:30:18", "text": "你知道。好的。好的，我要……"}, {"type": "subtitle", "time": 19820.83, "timestamp": "05:30:20", "text": "现在就走。再见。你好。"}, {"type": "subtitle", "time": 19823.99, "timestamp": "05:30:23", "text": "再见。小心。"}, {"type": "subtitle", "time": 19825.07, "timestamp": "05:30:25", "text": "而他"}, {"type": "subtitle", "time": 19828.75, "timestamp": "05:30:28", "text": "左边。感谢布拉德和"}, {"type": "subtitle", "time": 19831.548, "timestamp": "05:30:31", "text": "即将到来"}, {"type": "subtitle", "time": 19834.49, "timestamp": "05:30:34", "text": "经过。这对我意义重大。感谢"}, {"type": "subtitle", "time": 19847.59, "timestamp": "05:30:47", "text": "你。是的，确实如此。我只是在回应"}, {"type": "subtitle", "time": 19852.628, "timestamp": "05:30:52", "text": "QQ群里的消息。显然是中国人"}, {"type": "subtitle", "time": 19859.03, "timestamp": "05:30:59", "text": "严格的。您没有权限"}]
[{"type": "subtitle", "time": 17596.948, "timestamp": "04:53:16", "text": "，我是個"}, {"type": "subtitle", "time": 17609.03, "timestamp": "04:53:29", "text": "男孩。我不知道。是的。我希望如此。他肯定在騙我們，"}, {"type": "subtitle", "time": 17611.83, "timestamp": "04:53:31", "text": "你知道的。好吧，誰知道呢。我可能也是個星座。可能就是個星座，就在這個電腦旁邊，離我大概一百萬光年遠。哦"}, {"type": "subtitle", "time": 17625.51, "timestamp": "04:53:45", "text": "，天哪，他是個男的。"}, {"type": "subtitle", "time": 17637.03, "timestamp": "04:53:57", "text": "我的天哪，"}]
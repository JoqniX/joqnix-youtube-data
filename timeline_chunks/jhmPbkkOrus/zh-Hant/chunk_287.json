[{"type": "subtitle", "time": 17224.99, "timestamp": "04:47:04", "text": "聊天群，長達"}, {"type": "subtitle", "time": 17227.43, "timestamp": "04:47:07", "text": "3"}, {"type": "subtitle", "time": 17230.708, "timestamp": "04:47:10", "text": "小時。這到底"}, {"type": "subtitle", "time": 17250.31, "timestamp": "04:47:30", "text": "是怎麼回事？我的意思是，我最近晚上睡不著。"}, {"type": "subtitle", "time": 17268.07, "timestamp": "04:47:48", "text": "不知"}, {"type": "subtitle", "time": 17272.39, "timestamp": "04:47:52", "text": "為何，我滿腦子都是這件事。我不知道這是什麼。我的天啊。"}, {"type": "subtitle", "time": 17274.23, "timestamp": "04:47:54", "text": "我當時就想，「哦，Jo 讓"}, {"type": "subtitle", "time": 17278.47, "timestamp": "04:47:58", "text": "我來"}]
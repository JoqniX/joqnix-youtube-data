[{"type": "subtitle", "time": 2188.91, "timestamp": "00:36:28", "text": "為什麼我說"}, {"type": "subtitle", "time": 2207.31, "timestamp": "00:36:47", "text": "溜進我媽媽的房間"}, {"type": "subtitle", "time": 2209.63, "timestamp": "00:36:49", "text": "，"}, {"type": "subtitle", "time": 2217.99, "timestamp": "00:36:57", "text": "呃，享受一下空調，因為我房間的空調根本就沒修好"}]
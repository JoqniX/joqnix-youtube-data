[{"type": "subtitle", "time": 27840.708, "timestamp": "07:44:00", "text": "我這樣的主播，他們可以點擊直播。並沒有這種審核員的審核"}, {"type": "subtitle", "time": 27843.23, "timestamp": "07:44:03", "text": "日誌系統，對吧？ 是的。 此外，"}, {"type": "subtitle", "time": 27849.11, "timestamp": "07:44:09", "text": "繞過此方法的另一種方法是，當您輸入一條訊息後，當"}, {"type": "subtitle", "time": 27884.31, "timestamp": "07:44:44", "text": "您刪除該訊息時，它不會在此區域顯示已刪除的評論。秒鐘內被記錄在這裡，然後就會有證據，對吧"}, {"type": "subtitle", "time": 27887.27, "timestamp": "07:44:47", "text": "？刪除了，但"}, {"type": "subtitle", "time": 27892.548, "timestamp": "07:44:52", "text": "我們這裡有日誌，把日誌"}, {"type": "subtitle", "time": 27897.468, "timestamp": "07:44:57", "text": "截圖給我，然後我就可以說，是的，你受到了懲罰，原因如下，對吧？ 那種適度的做法。將會過載。精心製作的。"}]
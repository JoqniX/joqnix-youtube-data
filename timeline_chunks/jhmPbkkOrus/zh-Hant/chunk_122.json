[{"type": "subtitle", "time": 7322.229, "timestamp": "02:02:02", "text": "網站建置方面的內容。"}, {"type": "subtitle", "time": 7325.109, "timestamp": "02:02:05", "text": "不，我不需要蓋網站。"}, {"type": "subtitle", "time": 7330.07, "timestamp": "02:02:10", "text": "我為什麼要這麼做？我拒絕了。我花了好多錢才買到這個網站建立"}, {"type": "subtitle", "time": 7340.31, "timestamp": "02:02:20", "text": "工具。我為此支付了終身使用權的費用。"}, {"type": "subtitle", "time": 7343.109, "timestamp": "02:02:23", "text": "所以我不再需要付費就能製作網站了。"}, {"type": "subtitle", "time": 7353.109, "timestamp": "02:02:33", "text": "我可以免費建立任意數量的網站，並連接到任意數量的"}, {"type": "subtitle", "time": 7355.75, "timestamp": "02:02:35", "text": "域名，因為我已經獲得了終身合約。"}, {"type": "subtitle", "time": 7366.55, "timestamp": "02:02:46", "text": "這就是為什麼"}, {"type": "subtitle", "time": 7374.31, "timestamp": "02:02:54", "text": "我不願意去參加任何其他類似的活動的原因"}, {"type": "subtitle", "time": 7376.149, "timestamp": "02:02:56", "text": "。"}, {"type": "subtitle", "time": 7379.99, "timestamp": "02:02:59", "text": "我買了這個類似網頁流的東西，他們最近終於添加了動畫、滾動驅動動畫等等功能。如果是"}]
[{"type": "subtitle", "time": 19323.27, "timestamp": "05:22:03", "text": "你是來自陰影中的。你已恢復正常。大部頭書。 我的生活被曝光了。"}, {"type": "subtitle", "time": 19343.91, "timestamp": "05:22:23", "text": "我們，說實話，我們現在有點把它們毀了。  把我的"}, {"type": "subtitle", "time": 19349.03, "timestamp": "05:22:29", "text": "錘子拿回來。[音樂]看哪，雷神降臨。  哦不，"}, {"type": "subtitle", "time": 19365.75, "timestamp": "05:22:45", "text": "我們輸了。"}, {"type": "subtitle", "time": 19375.27, "timestamp": "05:22:55", "text": "媽的。我真不該錯過我的老炮兒。不是卡在靜止位置"}]
[{"type": "subtitle", "time": 20016.948, "timestamp": "05:33:36", "text": "說實話，現在已經不是這樣了。  是的。死的。  浣熊。過來。"}, {"type": "subtitle", "time": 20026.948, "timestamp": "05:33:46", "text": "我想要那隻"}, {"type": "subtitle", "time": 20030.39, "timestamp": "05:33:50", "text": "浣熊。  他在哪兒？他在那裡。  去你媽的，浣熊。我知道。我沒有強迫。不用擔心。我並"}]
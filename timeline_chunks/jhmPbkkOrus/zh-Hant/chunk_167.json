[{"type": "subtitle", "time": 10022.309, "timestamp": "02:47:02", "text": "我希望這件事能成功。我只需要用戶名和留言。這就是"}, {"type": "subtitle", "time": 10053.67, "timestamp": "02:47:33", "text": "我想要的全部。  我會想辦法解決的。加油，"}, {"type": "subtitle", "time": 10056.95, "timestamp": "02:47:36", "text": "索內特。十四行詩高。他打算再次"}, {"type": "subtitle", "time": 10059.51, "timestamp": "02:47:39", "text": "修改劇本。好的，我可能會用 Notepad++ 打開它"}, {"type": "subtitle", "time": 10061.75, "timestamp": "02:47:41", "text": "。  實際上，把這傢伙關掉。  程式碼寫完了嗎？"}]
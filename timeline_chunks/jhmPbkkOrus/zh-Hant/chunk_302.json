[{"type": "subtitle", "time": 18120.47, "timestamp": "05:02:00", "text": "我們現在有個麵包對手了。我要把誰踢出局？旗幟。算了。我選旗幟。我覺得我更傾向於"}, {"type": "subtitle", "time": 18123.35, "timestamp": "05:02:03", "text": "組隊。算了。我猜對面會因為有蜘蛛俠黑聯盟而禁用蜘蛛俠"}, {"type": "subtitle", "time": 18129.03, "timestamp": "05:02:09", "text": "。我希望他們這麼做。我受不了蜘蛛俠。"}, {"type": "subtitle", "time": 18152.788, "timestamp": "05:02:32", "text": "不錯。蜘蛛俠。哦，太棒了，兄弟。我們要選蜘蛛俠"}]
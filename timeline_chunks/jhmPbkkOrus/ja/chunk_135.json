[{"type": "subtitle", "time": 8106.47, "timestamp": "02:15:06", "text": "サブプロセス。 Microsoft ビルドツールは"}, {"type": "subtitle", "time": 8109.31, "timestamp": "02:15:09", "text": "必須。ああ、それは"}, {"type": "subtitle", "time": 8112.629, "timestamp": "02:15:12", "text": "なんでだよ、兄弟。ビルドをダウンロードする必要があります"}, {"type": "subtitle", "time": 8115.629, "timestamp": "02:15:15", "text": "今すぐツールを。これって7GBかそれくらいじゃない？"}, {"type": "subtitle", "time": 8119.75, "timestamp": "02:15:19", "text": "何か？なし。それなら私は何もいらない"}, {"type": "subtitle", "time": 8121.39, "timestamp": "02:15:21", "text": "の"}, {"type": "subtitle", "time": 8125.55, "timestamp": "02:15:25", "text": "これ。私が本当に欲しいのは"}, {"type": "subtitle", "time": 8127.069, "timestamp": "02:15:27", "text": "チャット"}, {"type": "subtitle", "time": 8130.43, "timestamp": "02:15:30", "text": "ブロスタンダード"}, {"type": "subtitle", "time": 8133.669, "timestamp": "02:15:33", "text": "コンパイラ。代わりに視覚的に"}, {"type": "subtitle", "time": 8137.709, "timestamp": "02:15:37", "text": "スタジオ。なぜビジュアルなのか"}, {"type": "subtitle", "time": 8140.629, "timestamp": "02:15:40", "text": "スタジオ？私にはこれらはどれも必要ありません。私はただ"}, {"type": "subtitle", "time": 8159.27, "timestamp": "02:15:59", "text": "問題は、私が一度修正したら、私は一度修正したら"}]
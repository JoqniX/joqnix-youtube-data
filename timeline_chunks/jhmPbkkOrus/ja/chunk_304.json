[{"type": "subtitle", "time": 18241.99, "timestamp": "05:04:01", "text": "何てことだ。みんな、話さなくてごめんね。"}, {"type": "subtitle", "time": 18245.19, "timestamp": "05:04:05", "text": "犬は話せる。なぜ話さないの？"}, {"type": "subtitle", "time": 18248.47, "timestamp": "05:04:08", "text": "ちょうどタイプしていたところです。ごめんなさい。"}, {"type": "subtitle", "time": 18249.99, "timestamp": "05:04:09", "text": "ちくしょう、お前は何も話さなかったな。私は自分の"}, {"type": "subtitle", "time": 18251.35, "timestamp": "05:04:11", "text": "究極の。私たちはただ持ちこたえる必要があると思います"}, {"type": "subtitle", "time": 18257.99, "timestamp": "05:04:17", "text": "あ、待って。現在、DPSは2人います。一度もない"}, {"type": "subtitle", "time": 18265.99, "timestamp": "05:04:25", "text": "ああ、これはどれですか？"}, {"type": "subtitle", "time": 18269.99, "timestamp": "05:04:29", "text": "そしてこれはおそらくあなたと"}, {"type": "subtitle", "time": 18272.15, "timestamp": "05:04:32", "text": "シンガポール風ミックス、だってそれが私の好みだから"}, {"type": "subtitle", "time": 18295.03, "timestamp": "05:04:55", "text": "私は準備ができました。私はあなたに勝つことができます"}]
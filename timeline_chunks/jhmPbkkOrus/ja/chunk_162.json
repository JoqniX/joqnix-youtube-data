[{"type": "subtitle", "time": 9726.67, "timestamp": "02:42:06", "text": "そこには。ああ、今ならできるよ。コピー"}, {"type": "subtitle", "time": 9730.07, "timestamp": "02:42:10", "text": "これ。ここに貼り付けてください。"}, {"type": "subtitle", "time": 9731.389, "timestamp": "02:42:11", "text": "それでも"}, {"type": "subtitle", "time": 9739.07, "timestamp": "02:42:19", "text": "だって、ほら、君が思うように動いてるんだもん"}, {"type": "subtitle", "time": 9742.87, "timestamp": "02:42:22", "text": "ファイルを読み込んで、"}, {"type": "subtitle", "time": 9746.429, "timestamp": "02:42:26", "text": "解凍して依存関係をインストールします"}, {"type": "subtitle", "time": 9753.71, "timestamp": "02:42:33", "text": "正解です。"}, {"type": "subtitle", "time": 9763.79, "timestamp": "02:42:43", "text": "見る？同じ"}, {"type": "subtitle", "time": 9766.87, "timestamp": "02:42:46", "text": "もの。バカなveとか何とか。私はしません"}, {"type": "subtitle", "time": 9773.349, "timestamp": "02:42:53", "text": "それ。ダウングレードするか、"}, {"type": "subtitle", "time": 9775.55, "timestamp": "02:42:55", "text": "何か、"}, {"type": "subtitle", "time": 9778.55, "timestamp": "02:42:58", "text": "男。ダウングレードする必要がある。それは"}]
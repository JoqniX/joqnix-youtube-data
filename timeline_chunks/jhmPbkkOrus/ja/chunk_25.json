[{"type": "subtitle", "time": 1500.909, "timestamp": "00:25:00", "text": "夕食？ランチ。"}, {"type": "subtitle", "time": 1502.51, "timestamp": "00:25:02", "text": "食べる。"}, {"type": "subtitle", "time": 1508.789, "timestamp": "00:25:08", "text": "ええ、私は食べられます、私は食べられます"}, {"type": "subtitle", "time": 1510.47, "timestamp": "00:25:10", "text": "ついに"}, {"type": "subtitle", "time": 1512.59, "timestamp": "00:25:12", "text": "えーと、"}, {"type": "subtitle", "time": 1514.83, "timestamp": "00:25:14", "text": "バス。"}, {"type": "subtitle", "time": 1518.23, "timestamp": "00:25:18", "text": "えっと、母の部屋に忍び込んで、えっと"}, {"type": "subtitle", "time": 1521.909, "timestamp": "00:25:21", "text": "エアコンの効いた部屋で日光浴をしよう。私の部屋のエアコンは効いていないから。"}, {"type": "subtitle", "time": 1524.549, "timestamp": "00:25:24", "text": "修正済み。何日か"}, {"type": "subtitle", "time": 1527.909, "timestamp": "00:25:27", "text": "ちょっと待って、兄弟？なぜエアコン修理業者は"}, {"type": "subtitle", "time": 1533.669, "timestamp": "00:25:33", "text": "よし、私はそう信じなければならない"}]
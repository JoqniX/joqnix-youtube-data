[{"type": "subtitle", "time": 16501.83, "timestamp": "04:35:01", "text": "パンクが好きな奴ら、さあ行くぞ。パンクマジック。"}, {"type": "subtitle", "time": 16504.51, "timestamp": "04:35:04", "text": "ゴス、つまりゴス系の女性。もしよろしければ"}, {"type": "subtitle", "time": 16514.789, "timestamp": "04:35:14", "text": "あなた。これはとてもクールなスキンですね。名前"}, {"type": "subtitle", "time": 16517.349, "timestamp": "04:35:17", "text": "お皿がかっこいいですね。なかなかいい感じ。はい。はい。"}, {"type": "subtitle", "time": 16521.15, "timestamp": "04:35:21", "text": "はい。はい。エモートは"}, {"type": "subtitle", "time": 16524.709, "timestamp": "04:35:24", "text": "いいね。また、もしご存知なかったら、ミス"}, {"type": "subtitle", "time": 16528.31, "timestamp": "04:35:28", "text": "こちらのミス・マジックには2つの形態があります。これ"}, {"type": "subtitle", "time": 16530.67, "timestamp": "04:35:30", "text": "暗闇"}, {"type": "subtitle", "time": 16533.59, "timestamp": "04:35:33", "text": "子供。うん。そうそう。色"}, {"type": "subtitle", "time": 16535.75, "timestamp": "04:35:35", "text": "口論。それを忘れていました。これ"}, {"type": "subtitle", "time": 16547.39, "timestamp": "04:35:47", "text": "彼女の代替品を吸う"}, {"type": "subtitle", "time": 16550.15, "timestamp": "04:35:50", "text": "リンボから出現する。何を知らないか"}, {"type": "subtitle", "time": 16557.67, "timestamp": "04:35:57", "text": "地獄。まあ、それは彼女にとっての地獄の次元だ。"}]
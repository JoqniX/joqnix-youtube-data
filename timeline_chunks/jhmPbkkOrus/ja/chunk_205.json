[{"type": "subtitle", "time": 12316.469, "timestamp": "03:25:16", "text": "上。私には何もできない。彼らが持っているもの"}, {"type": "subtitle", "time": 12322.15, "timestamp": "03:25:22", "text": "ペニーは側面攻撃を仕掛けているが、それは役に立っていない。"}, {"type": "subtitle", "time": 12324.67, "timestamp": "03:25:24", "text": "私たちの中の誰でも。電力供給"}, {"type": "subtitle", "time": 12327.469, "timestamp": "03:25:27", "text": "上向きの力"}, {"type": "subtitle", "time": 12349.349, "timestamp": "03:25:49", "text": "サイロックはなぜ最前線にいるのか？は"}, {"type": "subtitle", "time": 12351.51, "timestamp": "03:25:51", "text": "お前、パニッシャーか何かか？そして"}]
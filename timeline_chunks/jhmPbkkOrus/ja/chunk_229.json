[{"type": "subtitle", "time": 13758.99, "timestamp": "03:49:18", "text": "ああ、忘れていたミッションもある"}, {"type": "subtitle", "time": 13762.83, "timestamp": "03:49:22", "text": "する。ああ、今日のために"}, {"type": "subtitle", "time": 13767.349, "timestamp": "03:49:27", "text": "実は。リップマウンド。なぜ好きになるのか"}, {"type": "subtitle", "time": 13770.469, "timestamp": "03:49:30", "text": "それらはすべてストリーマーモードのようなものを持っています"}, {"type": "subtitle", "time": 13773.189, "timestamp": "03:49:33", "text": "の上？みんな自分の名前の中にいるのはなぜ"}, {"type": "subtitle", "time": 13774.87, "timestamp": "03:49:34", "text": "名前がちょっと違う"}, {"type": "subtitle", "time": 13777.59, "timestamp": "03:49:37", "text": "影が差した？何故ですか？あなたは何者ですか"}, {"type": "subtitle", "time": 13785.11, "timestamp": "03:49:45", "text": "俺の仲間、俺の仲間は今、永遠の世界に到達した"}, {"type": "subtitle", "time": 13788.83, "timestamp": "03:49:48", "text": "彼らはボンまたは"}, {"type": "subtitle", "time": 13791.63, "timestamp": "03:49:51", "text": "アイアンマン関連の何か。"}, {"type": "subtitle", "time": 13793.469, "timestamp": "03:49:53", "text": "おお、"}, {"type": "subtitle", "time": 13796.71, "timestamp": "03:49:56", "text": "わかった。私はできる"}]
[{"type": "subtitle", "time": 18480.55, "timestamp": "05:08:00", "text": "ニース。ああ、こんにちは。これ"}, {"type": "subtitle", "time": 18482.788, "timestamp": "05:08:02", "text": "風が吹いている。"}, {"type": "subtitle", "time": 18485.19, "timestamp": "05:08:05", "text": "仕事から帰ってきて、それから"}, {"type": "subtitle", "time": 18489.03, "timestamp": "05:08:09", "text": "スケジュール1をプレイした後、忘れてしまった"}, {"type": "subtitle", "time": 18490.868, "timestamp": "05:08:10", "text": "休息が必要で、体も"}, {"type": "subtitle", "time": 18493.27, "timestamp": "05:08:13", "text": "ちょうど効き始めたところだ。"}, {"type": "subtitle", "time": 18497.27, "timestamp": "05:08:17", "text": "うん。そして私は寝なかった。誰が"}, {"type": "subtitle", "time": 18505.11, "timestamp": "05:08:25", "text": "何について？なんてこった？質問していた"}, {"type": "subtitle", "time": 18507.91, "timestamp": "05:08:27", "text": "この人は誰だったのか？"}, {"type": "subtitle", "time": 18509.35, "timestamp": "05:08:29", "text": "私たちは彼のことなど気にしない。私たちはこれが嫌いです"}, {"type": "subtitle", "time": 18511.11, "timestamp": "05:08:31", "text": "男。 Twitchで配信されています。この男がいる。"}, {"type": "subtitle", "time": 18513.19, "timestamp": "05:08:33", "text": "どういう意味ですか？この男がいる。あなた"}, {"type": "subtitle", "time": 18515.11, "timestamp": "05:08:35", "text": "文字通り4、5回プロポーズされた"}, {"type": "subtitle", "time": 18516.868, "timestamp": "05:08:36", "text": "数日前。どういう意味ですか？閉じる"}, {"type": "subtitle", "time": 18520.23, "timestamp": "05:08:40", "text": "しくじったな、兄弟。この男は死んだ。私は私は"}, {"type": "subtitle", "time": 18527.03, "timestamp": "05:08:47", "text": "君が夜ぐっすり眠れるなら、それでいいんだよ、犬。"}, {"type": "subtitle", "time": 18530.47, "timestamp": "05:08:50", "text": "あなたが夜ぐっすり眠れるなら、何でもいいんです。"}, {"type": "subtitle", "time": 18532.15, "timestamp": "05:08:52", "text": "あなたたち二人は私が寝ていると思っている"}]
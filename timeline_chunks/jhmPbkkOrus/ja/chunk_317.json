[{"type": "subtitle", "time": 19021.23, "timestamp": "05:17:01", "text": "記事。そして今、"}, {"type": "subtitle", "time": 19024.27, "timestamp": "05:17:04", "text": "記事？ああ、"}, {"type": "subtitle", "time": 19026.77, "timestamp": "05:17:06", "text": "神。私の作品が出版されました。"}, {"type": "subtitle", "time": 19029.19, "timestamp": "05:17:09", "text": "[音楽]"}, {"type": "subtitle", "time": 19031.35, "timestamp": "05:17:11", "text": "うん、"}, {"type": "subtitle", "time": 19035.51, "timestamp": "05:17:15", "text": "プラチナ2になりました。さあ行こう。"}, {"type": "subtitle", "time": 19036.43, "timestamp": "05:17:16", "text": "さあ"}, {"type": "subtitle", "time": 19046.47, "timestamp": "05:17:26", "text": "階級確認だ、相棒。はぁ？何？何？何？"}, {"type": "subtitle", "time": 19048.31, "timestamp": "05:17:28", "text": "ランクチェック。"}, {"type": "subtitle", "time": 19058.15, "timestamp": "05:17:38", "text": "それが私です。私はそこにいる。そうそう。おお"}, {"type": "subtitle", "time": 19060.948, "timestamp": "05:17:40", "text": "くそっ。私は彼に詰め寄った。何てことだ。彼は"}, {"type": "subtitle", "time": 19070.788, "timestamp": "05:17:50", "text": "今シーズンは出場しなかったと言ってください。私は"}, {"type": "subtitle", "time": 19073.99, "timestamp": "05:17:53", "text": "依然として金メダル3位。わかった。そしてあなたは"}, {"type": "subtitle", "time": 19075.91, "timestamp": "05:17:55", "text": "試しています。"}, {"type": "subtitle", "time": 19078.07, "timestamp": "05:17:58", "text": "もし私がそうしたら、あなたは泣いてしまうでしょう。だから私は"}]
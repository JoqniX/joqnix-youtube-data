[{"type": "subtitle", "time": 17341.67, "timestamp": "04:49:01", "text": "みんな、転ばないようにね。ただ言ってみただけです。しないで"}, {"type": "subtitle", "time": 17345.31, "timestamp": "04:49:05", "text": "私は大丈夫でした。ありがとう。"}, {"type": "subtitle", "time": 17360.948, "timestamp": "04:49:20", "text": "いいえ、あなたたちは私を治してくれなかった。"}, {"type": "subtitle", "time": 17363.23, "timestamp": "04:49:23", "text": "なぜ私のヒーラーは"}, {"type": "subtitle", "time": 17366.55, "timestamp": "04:49:26", "text": "そう、そろそろ時間だ。あなたは行かなければならない。"}, {"type": "subtitle", "time": 17373.75, "timestamp": "04:49:33", "text": "検索中。私はどこに行けばいいですか？どこで"}, {"type": "subtitle", "time": 17377.35, "timestamp": "04:49:37", "text": "3つありますか？来て。"}, {"type": "subtitle", "time": 17379.03, "timestamp": "04:49:39", "text": "彼女は市役所にいた。あれを見たことがありますか？"}, {"type": "subtitle", "time": 17381.32, "timestamp": "04:49:41", "text": "キャラクター？"}, {"type": "subtitle", "time": 17384.39, "timestamp": "04:49:44", "text": "[音楽]"}]
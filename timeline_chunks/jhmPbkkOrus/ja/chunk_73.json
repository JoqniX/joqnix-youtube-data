[{"type": "subtitle", "time": 4382.39, "timestamp": "01:13:02", "text": "おそらくその日が"}, {"type": "subtitle", "time": 4385.03, "timestamp": "01:13:05", "text": "開発者か誰かに頼めば"}, {"type": "subtitle", "time": 4388.47, "timestamp": "01:13:08", "text": "私のウェブサイトのコード、カスタムバックエンド。"}, {"type": "subtitle", "time": 4391.51, "timestamp": "01:13:11", "text": "ユニバーサルアカウントのようなものを作りたい"}, {"type": "subtitle", "time": 4394.669, "timestamp": "01:13:14", "text": "えーと、私のユニバーサルアカウントシステム"}, {"type": "subtitle", "time": 4397.63, "timestamp": "01:13:17", "text": "Webサイト。 Discordをリンクできます"}, {"type": "subtitle", "time": 4399.669, "timestamp": "01:13:19", "text": "アカウント、YouTube アカウント、Twitch"}, {"type": "subtitle", "time": 4403.03, "timestamp": "01:13:23", "text": "アカウント、その他すべて。だって君は"}, {"type": "subtitle", "time": 4405.83, "timestamp": "01:13:25", "text": "私のチャットでポイントを獲得"}, {"type": "subtitle", "time": 4408.31, "timestamp": "01:13:28", "text": "ストリームのポイント、視聴時間ポイント"}, {"type": "subtitle", "time": 4411.35, "timestamp": "01:13:31", "text": "そしてエンゲージメントポイント、あるいは"}, {"type": "subtitle", "time": 4413.91, "timestamp": "01:13:33", "text": "ウェブサイトのポイントとしては、魅力的なインタラクションなど"}, {"type": "subtitle", "time": 4416.55, "timestamp": "01:13:36", "text": "ウェブサイト内で蓄積されるもの、"}, {"type": "subtitle", "time": 4418.87, "timestamp": "01:13:38", "text": "ポイントシステムでポイントを貯めることができます"}, {"type": "subtitle", "time": 4421.51, "timestamp": "01:13:41", "text": "ポイントがあれば、いろいろなことができます。いいえ。"}, {"type": "subtitle", "time": 4423.95, "timestamp": "01:13:43", "text": "その普遍的なアカウント"}, {"type": "subtitle", "time": 4427.27, "timestamp": "01:13:47", "text": "システムでは、私はそれをそうしなければならないでしょう"}, {"type": "subtitle", "time": 4429.75, "timestamp": "01:13:49", "text": "今は完全に縛られている"}, {"type": "subtitle", "time": 4432.03, "timestamp": "01:13:52", "text": "データベースなど、"}, {"type": "subtitle", "time": 4437.59, "timestamp": "01:13:57", "text": "右？それは、"}, {"type": "subtitle", "time": 4438.75, "timestamp": "01:13:58", "text": "[音楽]"}]
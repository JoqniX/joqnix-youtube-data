[{"type": "subtitle", "time": 10744.15, "timestamp": "02:59:04", "text": "今日。うん、うまくいくよ。それは動作します。しかし"}, {"type": "subtitle", "time": 10746.07, "timestamp": "02:59:06", "text": "心配しないで。心配しないで。私は行く"}, {"type": "subtitle", "time": 10748.67, "timestamp": "02:59:08", "text": "もう少しで"}, {"type": "subtitle", "time": 10751.389, "timestamp": "02:59:11", "text": "後で。後でまた戻ってきます"}, {"type": "subtitle", "time": 10754.389, "timestamp": "02:59:14", "text": "後で。じゃあ、行きます。うん。うん。私は必要としている"}, {"type": "subtitle", "time": 10756.389, "timestamp": "02:59:16", "text": "部屋のIDを変更する。はい。はい。はい。"}]
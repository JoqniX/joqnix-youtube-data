[{"type": "subtitle", "time": 19323.27, "timestamp": "05:22:03", "text": "尋ねた。あなたはただ尋ねただけです。"}, {"type": "subtitle", "time": 19325.51, "timestamp": "05:22:05", "text": "私はあなたに何も尋ねていません。私は好きです"}, {"type": "subtitle", "time": 19328.39, "timestamp": "05:22:08", "text": "今、何て言ったの？"}, {"type": "subtitle", "time": 19331.67, "timestamp": "05:22:11", "text": "ああ、わかりました。それは良かったですね。いいえ、それは"}, {"type": "subtitle", "time": 19341.27, "timestamp": "05:22:21", "text": "ああ、もう。わかりました、それでは、私はこれで終わりです"}, {"type": "subtitle", "time": 19343.91, "timestamp": "05:22:23", "text": "今日。今から脚本を買いに行きます。"}, {"type": "subtitle", "time": 19345.43, "timestamp": "05:22:25", "text": "はぁ？"}, {"type": "subtitle", "time": 19349.03, "timestamp": "05:22:29", "text": "私は引き継ぐためにパンを手に入れたが、"}, {"type": "subtitle", "time": 19352.628, "timestamp": "05:22:32", "text": "昼食とかを食べていた。"}, {"type": "subtitle", "time": 19357.35, "timestamp": "05:22:37", "text": "言ってみて。なぜ私はそう言ったのだろう？うん。"}, {"type": "subtitle", "time": 19361.51, "timestamp": "05:22:41", "text": "なぜ私がそう言う必要があるのか​​？あなたはそう言いましたよね。"}, {"type": "subtitle", "time": 19365.75, "timestamp": "05:22:45", "text": "なぜ？なぜ私がそんなことを言うのか？わかった。いいえ。"}, {"type": "subtitle", "time": 19366.75, "timestamp": "05:22:46", "text": "なぜ私が"}, {"type": "subtitle", "time": 19370.708, "timestamp": "05:22:50", "text": "言う？私がそんなことをする理由があるだろうか？"}, {"type": "subtitle", "time": 19373.59, "timestamp": "05:22:53", "text": "私がそんなことをする理由があるだろうか？この男。おい。おお"}, {"type": "subtitle", "time": 19375.27, "timestamp": "05:22:55", "text": "我が神よ。私は愚痴を言わなければならない、"}]
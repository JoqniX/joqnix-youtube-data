[{"type": "subtitle", "time": 9422.55, "timestamp": "02:37:02", "text": "吹っ飛んだぜ、兄弟。わかった、気にしないで。あなたが知っている"}, {"type": "subtitle", "time": 9425.03, "timestamp": "02:37:05", "text": "何？このフォルダは削除します"}, {"type": "subtitle", "time": 9430.389, "timestamp": "02:37:10", "text": "この男は働かなかった。削除します。"}, {"type": "subtitle", "time": 9433.81, "timestamp": "02:37:13", "text": "あなたも削除します。新しいものを作りましょう"}, {"type": "subtitle", "time": 9435.15, "timestamp": "02:37:15", "text": "[音楽]"}, {"type": "subtitle", "time": 9437.99, "timestamp": "02:37:17", "text": "フォルダ。いや、待って。新しい"}, {"type": "subtitle", "time": 9439.67, "timestamp": "02:37:19", "text": "フォルダは不要です。いいえ、私たちは"}, {"type": "subtitle", "time": 9442.87, "timestamp": "02:37:22", "text": "ここに置いてください。ない。それで、"}, {"type": "subtitle", "time": 9444.27, "timestamp": "02:37:24", "text": "えっと、"}, {"type": "subtitle", "time": 9451.469, "timestamp": "02:37:31", "text": "これ。はい、どうぞ。"}, {"type": "subtitle", "time": 9454.389, "timestamp": "02:37:34", "text": "ここ。つまり、手動でそこに行くことができます"}, {"type": "subtitle", "time": 9457.23, "timestamp": "02:37:37", "text": "折り畳み。それは"}, {"type": "subtitle", "time": 9458.91, "timestamp": "02:37:38", "text": "右。"}, {"type": "subtitle", "time": 9471.55, "timestamp": "02:37:51", "text": "大丈夫。あ、待って。多くの人がフォークした"}]
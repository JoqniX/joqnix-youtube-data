[{"type": "subtitle", "time": 11460.79, "timestamp": "03:11:00", "text": "難しい。それは私の世界計画ではない"}, {"type": "subtitle", "time": 11463.59, "timestamp": "03:11:03", "text": "支配。彼は邪悪な人間だ。私は"}, {"type": "subtitle", "time": 11467.91, "timestamp": "03:11:07", "text": "悪ではない。私はそう言っているので、大丈夫です。私は"}, {"type": "subtitle", "time": 11469.75, "timestamp": "03:11:09", "text": "お前がムラムラしてるなんて言ってないよ、おい。私は"}, {"type": "subtitle", "time": 11472.23, "timestamp": "03:11:12", "text": "ただ、あなたは邪悪な人間だと言っているだけです。私は"}, {"type": "subtitle", "time": 11475.11, "timestamp": "03:11:15", "text": "悪ではない。私は何も言いませんでした"}, {"type": "subtitle", "time": 11479.91, "timestamp": "03:11:19", "text": "良い。私は大丈夫です。友達を待たせている"}, {"type": "subtitle", "time": 11483.03, "timestamp": "03:11:23", "text": "3時間というのは良いことだった。ごめんなさい"}, {"type": "subtitle", "time": 11490.07, "timestamp": "03:11:30", "text": "おお。友達が気に入ってくれるとは思わなかった"}, {"type": "subtitle", "time": 11492.79, "timestamp": "03:11:32", "text": "文字通り私のことを忘れていた。ああ、そうだ、"}, {"type": "subtitle", "time": 11495.75, "timestamp": "03:11:35", "text": "男が待っていた。何時間経ちましたか"}, {"type": "subtitle", "time": 11497.99, "timestamp": "03:11:37", "text": "された？"}, {"type": "subtitle", "time": 11500.79, "timestamp": "03:11:40", "text": "ああ、もう。"}, {"type": "subtitle", "time": 11502.87, "timestamp": "03:11:42", "text": "とにかく、見せていただいても構いません。ストリームは"}, {"type": "subtitle", "time": 11505.19, "timestamp": "03:11:45", "text": "働く？何か見えますか？カンカン"}, {"type": "subtitle", "time": 11508.07, "timestamp": "03:11:48", "text": "いや、待って。 1秒。私にやらせてください"}, {"type": "subtitle", "time": 11514.15, "timestamp": "03:11:54", "text": "私にやらせてください。だって、どれくらいの間"}, {"type": "subtitle", "time": 11517.75, "timestamp": "03:11:57", "text": "私たちは何を目指すのでしょうか？だって私にはできるから、私は耐えられるから"}]
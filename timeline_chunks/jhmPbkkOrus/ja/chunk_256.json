[{"type": "subtitle", "time": 15390.63, "timestamp": "04:16:30", "text": "[音楽]"}, {"type": "subtitle", "time": 15397.75, "timestamp": "04:16:37", "text": "キャッチングだよ、マン。"}, {"type": "subtitle", "time": 15400.07, "timestamp": "04:16:40", "text": "スイッチを手に入れたと思う。いいえ、なぜなら"}, {"type": "subtitle", "time": 15403.83, "timestamp": "04:16:43", "text": "私は真っ赤になるわ。実際はそうではない"}, {"type": "subtitle", "time": 15412.03, "timestamp": "04:16:52", "text": "私たちのヒーラーたちは、まるでいじめられているかのようです。"}, {"type": "subtitle", "time": 15415.189, "timestamp": "04:16:55", "text": "いじめられた。私たちには何もできない。私たちは"}]
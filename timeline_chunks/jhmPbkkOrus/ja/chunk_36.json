[{"type": "subtitle", "time": 2188.91, "timestamp": "00:36:28", "text": "ゼロ。何てことだ。離れて。どうやって送ればいいですか"}, {"type": "subtitle", "time": 2198.95, "timestamp": "00:36:38", "text": "いや。ああ、なんてことだ。これはもっと複雑だ"}, {"type": "subtitle", "time": 2207.31, "timestamp": "00:36:47", "text": "なれ。わかった。もし私が走ったら"}, {"type": "subtitle", "time": 2209.63, "timestamp": "00:36:49", "text": "もし私が走るなら、"}, {"type": "subtitle", "time": 2212.51, "timestamp": "00:36:52", "text": "これは、"}, {"type": "subtitle", "time": 2215.67, "timestamp": "00:36:55", "text": "働く。うん。接続済みサーバー。"}, {"type": "subtitle", "time": 2217.99, "timestamp": "00:36:57", "text": "ええ、接続したり切断したりします"}]
[{"type": "subtitle", "time": 9062.389, "timestamp": "02:31:02", "text": "えっと、これを閉じさせてください。"}, {"type": "subtitle", "time": 9071.23, "timestamp": "02:31:11", "text": "えーっと、ここでライブ配信します"}, {"type": "subtitle", "time": 9074.389, "timestamp": "02:31:14", "text": "でも、私は今、どちらをやっているんだろう？病気"}, {"type": "subtitle", "time": 9077.03, "timestamp": "02:31:17", "text": "行くよ、ダウンロードしたdeをやるよ"}, {"type": "subtitle", "time": 9081.03, "timestamp": "02:31:21", "text": "DMで公開されているフォルダ。この２つ"}, {"type": "subtitle", "time": 9095.44, "timestamp": "02:31:35", "text": "思考の壺。わかった。見る"}, {"type": "subtitle", "time": 9097.23, "timestamp": "02:31:37", "text": "[音楽]"}, {"type": "subtitle", "time": 9099.95, "timestamp": "02:31:39", "text": "の"}, {"type": "subtitle", "time": 9103.33, "timestamp": "02:31:43", "text": "開発者は何も"}, {"type": "subtitle", "time": 9105.07, "timestamp": "02:31:45", "text": "[音楽]"}, {"type": "subtitle", "time": 9107.71, "timestamp": "02:31:47", "text": "うまくいった。なぜそうではないのか"}, {"type": "subtitle", "time": 9110.71, "timestamp": "02:31:50", "text": "座席は？ああ、わかりました。待って。どうすればいいのかわからない"}, {"type": "subtitle", "time": 9112.51, "timestamp": "02:31:52", "text": "CDを扱うため。"}, {"type": "subtitle", "time": 9115.55, "timestamp": "02:31:55", "text": "待って。方法"}, {"type": "subtitle", "time": 9118.27, "timestamp": "02:31:58", "text": "CD"}]
[{"type": "subtitle", "time": 13864.15, "timestamp": "03:51:04", "text": "私のように権利を持っている人には、権利があります。うん、"}, {"type": "subtitle", "time": 13866.469, "timestamp": "03:51:06", "text": "私が行きます。私が行きます。"}, {"type": "subtitle", "time": 13868.309, "timestamp": "03:51:08", "text": "もし君たちがその力関係が何なのか知らないなら"}, {"type": "subtitle", "time": 13870.95, "timestamp": "03:51:10", "text": "画像の意味は、つまり、彼が"}, {"type": "subtitle", "time": 13873.67, "timestamp": "03:51:13", "text": "物は領主である。あのプレイヤーは領主だ。"}, {"type": "subtitle", "time": 13875.63, "timestamp": "03:51:15", "text": "そして主が意味するのは"}, {"type": "subtitle", "time": 13877.15, "timestamp": "03:51:17", "text": "それ"}, {"type": "subtitle", "time": 13880.71, "timestamp": "03:51:20", "text": "基本的にあなたはとても多くの時間を費やしました"}, {"type": "subtitle", "time": 13888.469, "timestamp": "03:51:28", "text": "キャラクター。 3倍はダメですか？あなた"}, {"type": "subtitle", "time": 13902.55, "timestamp": "03:51:42", "text": "第1ラウンド。私は決して苦しむことを許さない"}, {"type": "subtitle", "time": 13912.63, "timestamp": "03:51:52", "text": "何か入力できます。何？ああ、それから彼"}]
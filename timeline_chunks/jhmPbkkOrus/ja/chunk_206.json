[{"type": "subtitle", "time": 12363.269, "timestamp": "03:26:03", "text": "私は何者？ママ・パニッシャーは彼が"}, {"type": "subtitle", "time": 12387.349, "timestamp": "03:26:27", "text": "何てことだ。彼はどこでショーを行ったのですか？"}, {"type": "subtitle", "time": 12401.83, "timestamp": "03:26:41", "text": "何てことだ。私のDPSは物足りない。"}, {"type": "subtitle", "time": 12405.429, "timestamp": "03:26:45", "text": "彼らはまるで馬鹿みたいにプレーしている。"}, {"type": "subtitle", "time": 12409.79, "timestamp": "03:26:49", "text": "うん、ロールスイッチ。私は切り替えることができますが、"}, {"type": "subtitle", "time": 12413.99, "timestamp": "03:26:53", "text": "まず、このゲームは"}, {"type": "subtitle", "time": 12416.389, "timestamp": "03:26:56", "text": "自己中心的で利己的な人々は"}, {"type": "subtitle", "time": 12418.07, "timestamp": "03:26:58", "text": "自分がこのゲームで一番だと思って"}, {"type": "subtitle", "time": 12419.62, "timestamp": "03:26:59", "text": "私は乗り換えるつもりはありません。"}]
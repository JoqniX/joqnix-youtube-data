[{"type": "subtitle", "time": 13512.51, "timestamp": "03:45:12", "text": "私は誇りを持って着用します"}, {"type": "subtitle", "time": 13522.95, "timestamp": "03:45:22", "text": "30秒後に来るよ。滞在する"}, {"type": "subtitle", "time": 13531.67, "timestamp": "03:45:31", "text": "私たちのヒーラーは、彼らが考えるようには"}, {"type": "subtitle", "time": 13533.67, "timestamp": "03:45:33", "text": "彼らは自分たちの道を歩まなければならないし"}, {"type": "subtitle", "time": 13535.51, "timestamp": "03:45:35", "text": "彼らは独自の道を歩んでいる。その"}, {"type": "subtitle", "time": 13538.309, "timestamp": "03:45:38", "text": "この男かロキはただ「見てみよう」と言っている"}, {"type": "subtitle", "time": 13540.95, "timestamp": "03:45:40", "text": "この男。あなたを止めなければなりません。"}, {"type": "subtitle", "time": 13543.269, "timestamp": "03:45:43", "text": "あなたはそれを知っていますよね？あなたはそうしないでしょう"}, {"type": "subtitle", "time": 13552.71, "timestamp": "03:45:52", "text": "リラックスして遊ぼう。"}, {"type": "subtitle", "time": 13555.15, "timestamp": "03:45:55", "text": "いや、でもあの男は"}, {"type": "subtitle", "time": 13557.269, "timestamp": "03:45:57", "text": "まったく、彼の言う通りだ。彼がどうするか見てみましょう"}]
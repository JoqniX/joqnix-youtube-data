[{"type": "subtitle", "time": 18962.15, "timestamp": "05:16:02", "text": "VTuberをやっている。えっと"}, {"type": "subtitle", "time": 18967.99, "timestamp": "05:16:07", "text": "えーっと、なんて呼ぶんだっけ？えーと、この番組は、"}, {"type": "subtitle", "time": 18970.788, "timestamp": "05:16:10", "text": "右？リアリティショーやゲームショーのようなもの"}, {"type": "subtitle", "time": 18974.948, "timestamp": "05:16:14", "text": "何かあるよね？うん。"}, {"type": "subtitle", "time": 18979.11, "timestamp": "05:16:19", "text": "それで、なんて呼ぶんですか？えっと、それで"}, {"type": "subtitle", "time": 18981.83, "timestamp": "05:16:21", "text": "待って、私がストリーミングしているけど、"}, {"type": "subtitle", "time": 18984.628, "timestamp": "05:16:24", "text": "イベント。だから私は他の人に任せています"}, {"type": "subtitle", "time": 18987.75, "timestamp": "05:16:27", "text": "私や友人の参加者が引き継ぎます"}, {"type": "subtitle", "time": 18989.708, "timestamp": "05:16:29", "text": "私の配信のことですよね？"}, {"type": "subtitle", "time": 18992.628, "timestamp": "05:16:32", "text": "しかし、これは似たようなものと見なすこともできる"}, {"type": "subtitle", "time": 18994.628, "timestamp": "05:16:34", "text": "このような現実に関しては"}, {"type": "subtitle", "time": 18996.948, "timestamp": "05:16:36", "text": "ショーやゲームショーなど、"}, {"type": "subtitle", "time": 19000.31, "timestamp": "05:16:40", "text": "右？コンテンツはオンになっていますよね？似ていますね。"}, {"type": "subtitle", "time": 19004.19, "timestamp": "05:16:44", "text": "右？そうではありません。うん。"}, {"type": "subtitle", "time": 19007.43, "timestamp": "05:16:47", "text": "はぁ？それは何ですか？それも"}, {"type": "subtitle", "time": 19011.59, "timestamp": "05:16:51", "text": "このプラットフォームでは許可されていません。何"}, {"type": "subtitle", "time": 19015.35, "timestamp": "05:16:55", "text": "さあ、誰にも分からないよ。誰が知っているだろうか？それはそう言った"}, {"type": "subtitle", "time": 19017.91, "timestamp": "05:16:57", "text": "すでに記事に掲載されています"}]
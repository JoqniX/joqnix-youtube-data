[{"type": "subtitle", "time": 15671.11, "timestamp": "04:21:11", "text": "そうかもしれない。ああ、彼の言うことは間違っていない。彼らは"}, {"type": "subtitle", "time": 15681.469, "timestamp": "04:21:21", "text": "ああ、彼女は本当に素晴らしかった。"}, {"type": "subtitle", "time": 15695.03, "timestamp": "04:21:35", "text": "うん、ソーはこれらには良い選択だった"}, {"type": "subtitle", "time": 15696.79, "timestamp": "04:21:36", "text": "みんな。ソーはとても良い選択でした"}, {"type": "subtitle", "time": 15699.59, "timestamp": "04:21:39", "text": "こいつらだ。ところで、スター・ロードは"}, {"type": "subtitle", "time": 15701.83, "timestamp": "04:21:41", "text": "まるでイベントでランダムに手に入るスキンみたいだ。それ"}, {"type": "subtitle", "time": 15704.229, "timestamp": "04:21:44", "text": "まるで月面現象のようだった。そう、それ"}, {"type": "subtitle", "time": 15716.229, "timestamp": "04:21:56", "text": "なぜああ、神様。勝つにはトップチームが必要だ"}]
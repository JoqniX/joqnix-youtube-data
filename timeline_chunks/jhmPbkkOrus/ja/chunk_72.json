[{"type": "subtitle", "time": 4320.189, "timestamp": "01:12:00", "text": "方法。参加できます。確認"}, {"type": "subtitle", "time": 4323.07, "timestamp": "01:12:03", "text": "あなた自身と"}, {"type": "subtitle", "time": 4325.35, "timestamp": "01:12:05", "text": "すべて。私に残された唯一のもの"}, {"type": "subtitle", "time": 4328.39, "timestamp": "01:12:08", "text": "やることは、チャレンジでやること"}, {"type": "subtitle", "time": 4331.11, "timestamp": "01:12:11", "text": "役割分担ですよね？そうすれば"}, {"type": "subtitle", "time": 4333.27, "timestamp": "01:12:13", "text": "文字通り"}, {"type": "subtitle", "time": 4334.99, "timestamp": "01:12:14", "text": "クリックすると表示されます"}, {"type": "subtitle", "time": 4337.83, "timestamp": "01:12:17", "text": "アカウント停止か何かになりに来たんだ。もしそれが"}, {"type": "subtitle", "time": 4340.709, "timestamp": "01:12:20", "text": "GFSボット、もしそれが実際のボットアカウントであれば、"}, {"type": "subtitle", "time": 4342.79, "timestamp": "01:12:22", "text": "彼らはクラブをここをクリックして取得します"}, {"type": "subtitle", "time": 4350.55, "timestamp": "01:12:30", "text": "禁止。キャプチャ画像があります。だから私は"}, {"type": "subtitle", "time": 4352.709, "timestamp": "01:12:32", "text": "キャプチャ用に2枚のボードを追加しました"}, {"type": "subtitle", "time": 4355.51, "timestamp": "01:12:35", "text": "捕獲。しかし、この2つのくだらないことが"}, {"type": "subtitle", "time": 4357.229, "timestamp": "01:12:37", "text": "正常に動作しない、"}, {"type": "subtitle", "time": 4360.07, "timestamp": "01:12:40", "text": "それなら、私には分かりません。私ができることは、"}, {"type": "subtitle", "time": 4362.95, "timestamp": "01:12:42", "text": "自分でボットでも作ろうかな。"}, {"type": "subtitle", "time": 4365.43, "timestamp": "01:12:45", "text": "私はプログラミングができません。やらなければならないかもしれない"}, {"type": "subtitle", "time": 4368.47, "timestamp": "01:12:48", "text": "誰かに依頼する。"}, {"type": "subtitle", "time": 4371.03, "timestamp": "01:12:51", "text": "男性向けのマニュアル版を選んだ。うん、そんな感じ"}, {"type": "subtitle", "time": 4374.709, "timestamp": "01:12:54", "text": "これをやりたくない人もいるだろう。いいえ、私は"}, {"type": "subtitle", "time": 4378.07, "timestamp": "01:12:58", "text": "これを実行する最善の方法を考えてください"}]
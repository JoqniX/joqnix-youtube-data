[{"type": "subtitle", "time": 12672.389, "timestamp": "03:31:12", "text": "奇妙さは低い。奇妙さは低い。ニース。"}, {"type": "subtitle", "time": 12673.87, "timestamp": "03:31:13", "text": "ニース。ニース。これを押す"}, {"type": "subtitle", "time": 12675.75, "timestamp": "03:31:15", "text": "クソ野郎。彼を押し倒せ。彼を"}, {"type": "subtitle", "time": 12690.269, "timestamp": "03:31:30", "text": "関係ない"}, {"type": "subtitle", "time": 12693.51, "timestamp": "03:31:33", "text": "私が彼らを押し返すことができるポイントはどこだろうか。ペニー"}, {"type": "subtitle", "time": 12713.11, "timestamp": "03:31:53", "text": "はい、わかりました。捕まえたぞ。"}, {"type": "subtitle", "time": 12715.429, "timestamp": "03:31:55", "text": "彼を鞭打て。彼を鞭打て。よくやった、ペニー。"}, {"type": "chat", "time": 12718.049, "timestamp": "03:31:58", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "me eating lunch dayo"}]
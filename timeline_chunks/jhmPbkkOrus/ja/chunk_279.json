[{"type": "subtitle", "time": 16742.31, "timestamp": "04:39:02", "text": "いや、セントリーはここにはいないよ。そして私は"}, {"type": "subtitle", "time": 16746.07, "timestamp": "04:39:06", "text": "セントリーはこのゲームに来ると思う"}, {"type": "subtitle", "time": 16749.67, "timestamp": "04:39:09", "text": "彼は一体何者になるのだろうか？戦車。私は...するだろう"}, {"type": "subtitle", "time": 16751.67, "timestamp": "04:39:11", "text": "歩哨が来たら、"}, {"type": "subtitle", "time": 16759.67, "timestamp": "04:39:19", "text": "ああ、神様。飛行機が欲しい"}, {"type": "subtitle", "time": 16763.349, "timestamp": "04:39:23", "text": "タンク。はい。ダイヤモンドを。さて、私は"}, {"type": "subtitle", "time": 16766.07, "timestamp": "04:39:26", "text": "この試合から追放するつもりですか？"}, {"type": "subtitle", "time": 16782.788, "timestamp": "04:39:42", "text": "どちらも可能性あり。うん。私も、そしてご存知のように"}, {"type": "subtitle", "time": 16785.03, "timestamp": "04:39:45", "text": "何？彼にはもう一つの人格があるからだ。私は思う"}, {"type": "subtitle", "time": 16787.07, "timestamp": "04:39:47", "text": "彼は"}, {"type": "subtitle", "time": 16789.99, "timestamp": "04:39:49", "text": "形式、つまり、"}, {"type": "subtitle", "time": 16792.788, "timestamp": "04:39:52", "text": "まるで別の形態であるかのように。私はほしくない"}, {"type": "subtitle", "time": 16795.83, "timestamp": "04:39:55", "text": "誰にとっても台無しにするのは、そう、もしあなたが"}, {"type": "subtitle", "time": 16799.948, "timestamp": "04:39:59", "text": "知らない、君も知らないんだ。病気"}]
[{"type": "subtitle", "time": 16983.39, "timestamp": "04:43:03", "text": "息子"}, {"type": "subtitle", "time": 16987.47, "timestamp": "04:43:07", "text": "銃。生き残る。生き残る"}, {"type": "subtitle", "time": 16991.75, "timestamp": "04:43:11", "text": "自分。彼を決闘者に仕立て上げるだけでいい。"}, {"type": "subtitle", "time": 16993.99, "timestamp": "04:43:13", "text": "そう、もしあなたが"}, {"type": "subtitle", "time": 16995.83, "timestamp": "04:43:15", "text": "このゲームの決闘者リストは、"}, {"type": "subtitle", "time": 16998.59, "timestamp": "04:43:18", "text": "ばかげている。そこで、私は"}, {"type": "subtitle", "time": 17001.868, "timestamp": "04:43:21", "text": "戦車が増え、"}, {"type": "subtitle", "time": 17006.07, "timestamp": "04:43:26", "text": "なんて呼ぶんだっけ？もっとヒーラーを。"}, {"type": "subtitle", "time": 17008.948, "timestamp": "04:43:28", "text": "だってほら、もし彼らが追加したらどうなるか見てみて"}, {"type": "subtitle", "time": 17013.83, "timestamp": "04:43:33", "text": "彼の名前は？えっと、彼の名前は？くそ。"}, {"type": "subtitle", "time": 17015.67, "timestamp": "04:43:35", "text": "彼のお名前は？ああ、デッドプール。うん。"}, {"type": "subtitle", "time": 17017.27, "timestamp": "04:43:37", "text": "うん。うん。彼らが追加を希望する場合は"}, {"type": "subtitle", "time": 17019.75, "timestamp": "04:43:39", "text": "デッドプールにはヒーラーになってほしい。"}]
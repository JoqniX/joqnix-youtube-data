[{"type": "subtitle", "time": 20402.47, "timestamp": "05:40:02", "text": "失礼だ。エモは厳格な量"}, {"type": "subtitle", "time": 20407.15, "timestamp": "05:40:07", "text": "このプラットフォームはクレイジーだ"}, {"type": "subtitle", "time": 20411.43, "timestamp": "05:40:11", "text": "どのように、どのように想像するか、ただ考える"}, {"type": "subtitle", "time": 20414.75, "timestamp": "05:40:14", "text": "TwitchやYouTubeがこれをやったと想像してみて"}, {"type": "subtitle", "time": 20418.59, "timestamp": "05:40:18", "text": "よし、みんなボイコットするぞ"}, {"type": "subtitle", "time": 20422.11, "timestamp": "05:40:22", "text": "プラットフォームの権利は誰もが"}, {"type": "subtitle", "time": 20426.07, "timestamp": "05:40:26", "text": "あなたがこうすると、彼らはこう言うでしょう"}, {"type": "subtitle", "time": 20427.91, "timestamp": "05:40:27", "text": "私はこのプラットフォームには参加したくない"}, {"type": "subtitle", "time": 20430.39, "timestamp": "05:40:30", "text": "私は行くつもりです。あなたは生きている。はい、私は"}, {"type": "subtitle", "time": 20433.708, "timestamp": "05:40:33", "text": "生きている。こんにちは、"}, {"type": "subtitle", "time": 20438.27, "timestamp": "05:40:38", "text": "ニ。私は生きている。こんにちは。私は"}, {"type": "subtitle", "time": 20444.83, "timestamp": "05:40:44", "text": "セセ。良い"}, {"type": "subtitle", "time": 20447.07, "timestamp": "05:40:47", "text": "[音楽]"}, {"type": "subtitle", "time": 20448.61, "timestamp": "05:40:48", "text": "夕方。良い"}, {"type": "subtitle", "time": 20450.27, "timestamp": "05:40:50", "text": "[音楽]"}, {"type": "subtitle", "time": 20452.03, "timestamp": "05:40:52", "text": "夕方。"}, {"type": "subtitle", "time": 20456.15, "timestamp": "05:40:56", "text": "王。それは正しいですか？待って。"}, {"type": "subtitle", "time": 20457.5, "timestamp": "05:40:57", "text": "王さんですか？"}, {"type": "subtitle", "time": 20458.83, "timestamp": "05:40:58", "text": "[音楽]"}]
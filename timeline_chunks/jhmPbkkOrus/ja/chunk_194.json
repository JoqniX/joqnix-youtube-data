[{"type": "subtitle", "time": 11640.07, "timestamp": "03:14:00", "text": "わかった。それでは、もう行っていいですよ。私はできる"}, {"type": "subtitle", "time": 11642.15, "timestamp": "03:14:02", "text": "これを処理してください。ごめん。ごめん。あなたは"}, {"type": "subtitle", "time": 11644.55, "timestamp": "03:14:04", "text": "「うん」と答える。昨日彼らは気に入らなかった"}, {"type": "subtitle", "time": 11647.91, "timestamp": "03:14:07", "text": "バーチャルゲーマーカテゴリーで配信中"}, {"type": "subtitle", "time": 11650.389, "timestamp": "03:14:10", "text": "マインクラフトのせいだ。今彼らは文字通り"}, {"type": "subtitle", "time": 11651.79, "timestamp": "03:14:11", "text": "私に"}, {"type": "subtitle", "time": 11654.469, "timestamp": "03:14:14", "text": "ペナルティは"}, {"type": "subtitle", "time": 11657.429, "timestamp": "03:14:17", "text": "ゲーム？ああ、間違った方向に進んでいるから"}, {"type": "subtitle", "time": 11660.269, "timestamp": "03:14:20", "text": "カテゴリ。彼らは私に"}, {"type": "subtitle", "time": 11662.87, "timestamp": "03:14:22", "text": "警告。ありがたいことに、私は"}, {"type": "subtitle", "time": 11665.67, "timestamp": "03:14:25", "text": "ストリームは30秒間停止しましたが、"}, {"type": "subtitle", "time": 11671.429, "timestamp": "03:14:31", "text": "我が神よ。なぜそんなに"}, {"type": "subtitle", "time": 11672.71, "timestamp": "03:14:32", "text": "さあ、どうだろうね。"}, {"type": "subtitle", "time": 11675.429, "timestamp": "03:14:35", "text": "それ。"}, {"type": "subtitle", "time": 11681.75, "timestamp": "03:14:41", "text": "こんにちは。とにかく、ピューピューと撃つのを楽しんでください。"}, {"type": "subtitle", "time": 11682.91, "timestamp": "03:14:42", "text": "こんにちは。"}, {"type": "subtitle", "time": 11685.269, "timestamp": "03:14:45", "text": "うん。また、もしあなたが望むなら"}, {"type": "subtitle", "time": 11687.59, "timestamp": "03:14:47", "text": "参加して、私たちは来て、"}, {"type": "subtitle", "time": 11689.99, "timestamp": "03:14:49", "text": "ライブ配信で話してみるとか。"}, {"type": "subtitle", "time": 11691.429, "timestamp": "03:14:51", "text": "[音楽]"}, {"type": "subtitle", "time": 11694.79, "timestamp": "03:14:54", "text": "あなたがそうしたいのなら。はい。はい。わかった。"}, {"type": "subtitle", "time": 11699.309, "timestamp": "03:14:59", "text": "それではまた。よし。気をつけて。"}]
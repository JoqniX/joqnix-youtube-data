[{"type": "subtitle", "time": 20342.03, "timestamp": "05:39:02", "text": "[音楽]"}, {"type": "subtitle", "time": 20345.51, "timestamp": "05:39:05", "text": "サンタクロース。 1秒。私は隠れるべきだ"}, {"type": "subtitle", "time": 20367.47, "timestamp": "05:39:27", "text": "[音楽]"}, {"type": "subtitle", "time": 20370.23, "timestamp": "05:39:30", "text": "不和。二人は互いに自己を見つめ合う。これはいいえ"}, {"type": "subtitle", "time": 20371.91, "timestamp": "05:39:31", "text": "コインを何枚集めても、"}, {"type": "subtitle", "time": 20398.19, "timestamp": "05:39:58", "text": "クレイジー。これ"}]
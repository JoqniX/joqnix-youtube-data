[{"type": "subtitle", "time": 16380.79, "timestamp": "04:33:00", "text": "平均？私は、何が何なのか、"}, {"type": "subtitle", "time": 16392.67, "timestamp": "04:33:12", "text": "あまりにも。ああ、相棒。あれは汗だくの男だった。"}, {"type": "subtitle", "time": 16397.07, "timestamp": "04:33:17", "text": "おお、いいね。順位は？は"}, {"type": "subtitle", "time": 16407.429, "timestamp": "04:33:27", "text": "わかった。おい、どうして彼はペナルティを受けたんだ？私は"}, {"type": "subtitle", "time": 16420.07, "timestamp": "04:33:40", "text": "ジョック、大丈夫か？私はすべきでしょうか"}, {"type": "subtitle", "time": 16438.07, "timestamp": "04:33:58", "text": "何が起こったのか？待ちます。ジョーを待つよ"}, {"type": "subtitle", "time": 16439.99, "timestamp": "04:33:59", "text": "彼はチャットで何か言って、"}]
[{"type": "subtitle", "time": 11280.19, "timestamp": "03:08:00", "text": "大丈夫です。その"}, {"type": "subtitle", "time": 11284.23, "timestamp": "03:08:04", "text": "大丈夫。私の声は既に混乱している。それで、"}, {"type": "subtitle", "time": 11286.309, "timestamp": "03:08:06", "text": "大丈夫です。"}, {"type": "subtitle", "time": 11288.63, "timestamp": "03:08:08", "text": "この男は天国にいる。彼はこう言うだろう、"}, {"type": "subtitle", "time": 11290.469, "timestamp": "03:08:10", "text": "「これは一体何だ？どんな種類の"}, {"type": "subtitle", "time": 11296.11, "timestamp": "03:08:16", "text": "いいえ、"}, {"type": "subtitle", "time": 11305.67, "timestamp": "03:08:25", "text": "そうだといい。彼は私たちを騙しているに違いない、"}, {"type": "subtitle", "time": 11307.99, "timestamp": "03:08:27", "text": "知る。"}, {"type": "subtitle", "time": 11309.83, "timestamp": "03:08:29", "text": "まあ、何が起こるかわからないからね。私は"}, {"type": "subtitle", "time": 11312.87, "timestamp": "03:08:32", "text": "実際の星座も含まれています。かもしれない"}, {"type": "subtitle", "time": 11316.07, "timestamp": "03:08:36", "text": "このPCで実際の星座を見る"}, {"type": "subtitle", "time": 11319.75, "timestamp": "03:08:39", "text": "まるで百万光年離れたところにあるかのようだ。"}, {"type": "subtitle", "time": 11322.389, "timestamp": "03:08:42", "text": "ああ神様、"}, {"type": "subtitle", "time": 11324.389, "timestamp": "03:08:44", "text": "彼は男だ。ああ、私たちは"}, {"type": "subtitle", "time": 11326.63, "timestamp": "03:08:46", "text": "この会話をまた繰り返す。ジョギング、どのように"}, {"type": "subtitle", "time": 11331.67, "timestamp": "03:08:51", "text": "男であるというのはどんな感じですか？わからない。"}, {"type": "subtitle", "time": 11335.19, "timestamp": "03:08:55", "text": "くそ。そうですね、本当の悲しみは"}, {"type": "subtitle", "time": 11338.79, "timestamp": "03:08:58", "text": "「わからない」と言うときのこの声。"}]
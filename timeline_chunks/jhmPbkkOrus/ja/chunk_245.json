[{"type": "subtitle", "time": 14713.55, "timestamp": "04:05:13", "text": "残り時間はわずか60秒。ああ、私たちは"}, {"type": "subtitle", "time": 14716.229, "timestamp": "04:05:16", "text": "少年は検問所に到着した。続けてください"}, {"type": "subtitle", "time": 14719.269, "timestamp": "04:05:19", "text": "勢い。アベンジャーズタワー。私は違います"}, {"type": "subtitle", "time": 14722.429, "timestamp": "04:05:22", "text": "まさに大歓迎です。なぜ自動設定になっているのか"}, {"type": "subtitle", "time": 14729.03, "timestamp": "04:05:29", "text": "ごめんね、チャド。私はあなたの気持ちが読めない"}, {"type": "subtitle", "time": 14731.03, "timestamp": "04:05:31", "text": "集中しすぎて、もし私が"}, {"type": "subtitle", "time": 14743.189, "timestamp": "04:05:43", "text": "ああ、彼は死んだんだ。ああ、彼は死んだんだ。来て。"}]
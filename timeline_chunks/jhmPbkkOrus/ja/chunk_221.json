[{"type": "subtitle", "time": 13271.59, "timestamp": "03:41:11", "text": "わかった。ヒーラーたちはどのようにして死んだのですか？何"}, {"type": "subtitle", "time": 13274.63, "timestamp": "03:41:14", "text": "えっ？私のヒーラーたちはどうなったの？"}, {"type": "subtitle", "time": 13276.19, "timestamp": "03:41:16", "text": "何"}, {"type": "subtitle", "time": 13280.389, "timestamp": "03:41:20", "text": "その？彼らの計画は失敗した。おお、"}, {"type": "subtitle", "time": 13283.03, "timestamp": "03:41:23", "text": "彼らはそうした。"}, {"type": "subtitle", "time": 13287.429, "timestamp": "03:41:27", "text": "私は、何が起こったのかを皆に知らせた。"}, {"type": "subtitle", "time": 13291.349, "timestamp": "03:41:31", "text": "私は彼の"}, {"type": "subtitle", "time": 13303.19, "timestamp": "03:41:43", "text": "よし、彼はそれをやった。私は自分の分を"}]
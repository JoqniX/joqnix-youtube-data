[{"type": "subtitle", "time": 5401.03, "timestamp": "01:30:01", "text": "CMS。だから、私がすべてのストリームを持っているときはいつでも"}, {"type": "subtitle", "time": 5404.149, "timestamp": "01:30:04", "text": "要約が掲載されます。以前は持っていました。"}, {"type": "subtitle", "time": 5407.35, "timestamp": "01:30:07", "text": "私には手に負えないと感じた"}, {"type": "subtitle", "time": 5410.51, "timestamp": "01:30:10", "text": "すべて私一人で。これら全て追加事項。"}, {"type": "subtitle", "time": 5414.59, "timestamp": "01:30:14", "text": "いいえ。例えばこんな感じです。"}, {"type": "subtitle", "time": 5418.07, "timestamp": "01:30:18", "text": "ストリームには、"}, {"type": "subtitle", "time": 5421.189, "timestamp": "01:30:21", "text": "YouTube からストリームサムネイルを取得してから、私の"}, {"type": "subtitle", "time": 5424.79, "timestamp": "01:30:24", "text": "メッセージの概要 概要メッセージ"}, {"type": "subtitle", "time": 5427.149, "timestamp": "01:30:27", "text": "放送は、放送が始まったときに始まりました"}, {"type": "subtitle", "time": 5430.229, "timestamp": "01:30:30", "text": "終わったので、YouTubeでVを視聴できます"}, {"type": "subtitle", "time": 5432.149, "timestamp": "01:30:32", "text": "YouTube のチャンネルを視聴する YouTube ストリームを YouTube で視聴する"}, {"type": "subtitle", "time": 5434.39, "timestamp": "01:30:34", "text": "Twitch の VA であればチャンネルを"}, {"type": "subtitle", "time": 5436.709, "timestamp": "01:30:36", "text": "YouTube の視聴チャンネルで"}, {"type": "subtitle", "time": 5439.27, "timestamp": "01:30:39", "text": "Twitchで見ることができますよ、ビリー。"}, {"type": "subtitle", "time": 5442.79, "timestamp": "01:30:42", "text": "ビリーもストリームに参加した。それから"}, {"type": "subtitle", "time": 5445.75, "timestamp": "01:30:45", "text": "タイムスタンプのことですね。昔はこうだった"}, {"type": "subtitle", "time": 5449.59, "timestamp": "01:30:49", "text": "双方向システムにおいて。 1つは自動化されている"}, {"type": "subtitle", "time": 5452.709, "timestamp": "01:30:52", "text": "ストリーム経由"}, {"type": "subtitle", "time": 5455.669, "timestamp": "01:30:55", "text": "えー、チャップ、ストリーム、ストリーマーボーイ。"}, {"type": "subtitle", "time": 5459.11, "timestamp": "01:30:59", "text": "それはストリームアップのチャプターマーカーです"}]
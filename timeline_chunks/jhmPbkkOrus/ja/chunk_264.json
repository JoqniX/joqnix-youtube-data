[{"type": "subtitle", "time": 15841.75, "timestamp": "04:24:01", "text": "ほとんどお腹が空いていない。さあ、混沌を巻き起こそう。"}, {"type": "subtitle", "time": 15865.99, "timestamp": "04:24:25", "text": "ああ、神様、私の彼氏が一緒にいると思っていたのに。"}, {"type": "subtitle", "time": 15867.59, "timestamp": "04:24:27", "text": "ああ、気にしないで。私はしくじった。わかった、それ"}, {"type": "subtitle", "time": 15882.55, "timestamp": "04:24:42", "text": "あんなことをするべきじゃなかった。私はそうすべきではない"}, {"type": "subtitle", "time": 15894.55, "timestamp": "04:24:54", "text": "ええ、まあ、そうでしたね。"}]
[{"type": "subtitle", "time": 1088.23, "timestamp": "00:18:08", "text": "それらのラジオを実装したり、"}, {"type": "subtitle", "time": 1090.19, "timestamp": "00:18:10", "text": "スーパーチャットサブ"}, {"type": "subtitle", "time": 1093.15, "timestamp": "00:18:13", "text": "カード。私のダッシュボードは誰のもの？"}, {"type": "subtitle", "time": 1099.87, "timestamp": "00:18:19", "text": "えっと、"}, {"type": "subtitle", "time": 1104.59, "timestamp": "00:18:24", "text": "行く。待つことにします。まで待ちます"}, {"type": "subtitle", "time": 1108.75, "timestamp": "00:18:28", "text": "実装済み。でも、本当に知りたいんです。"}, {"type": "subtitle", "time": 1111.75, "timestamp": "00:18:31", "text": "えっと、本当にログを記録できたらいいのにと思います"}, {"type": "subtitle", "time": 1114.39, "timestamp": "00:18:34", "text": "信心深い会話。とてもイライラする"}, {"type": "subtitle", "time": 1116.87, "timestamp": "00:18:36", "text": "毎日"}, {"type": "subtitle", "time": 1120.15, "timestamp": "00:18:40", "text": "ええと、すべてのストリーム。スクリーンショットを撮って"}, {"type": "subtitle", "time": 1122.19, "timestamp": "00:18:42", "text": "私の"}, {"type": "subtitle", "time": 1123.95, "timestamp": "00:18:43", "text": "不和。"}, {"type": "subtitle", "time": 1136.95, "timestamp": "00:18:56", "text": "痛み。自分で解決できるだろうと思っていました"}]
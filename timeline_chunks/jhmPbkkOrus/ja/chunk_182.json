[{"type": "subtitle", "time": 10921.83, "timestamp": "03:02:01", "text": "あなたの写真からTwitchへ。ああ、"}, {"type": "subtitle", "time": 10922.95, "timestamp": "03:02:02", "text": "神。"}, {"type": "subtitle", "time": 10925.75, "timestamp": "03:02:05", "text": "つまり、匿名と"}, {"type": "subtitle", "time": 10928.07, "timestamp": "03:02:08", "text": "オープンなプラットフォーム。オープンプラットフォーム"}, {"type": "subtitle", "time": 10931.95, "timestamp": "03:02:11", "text": "私のビリービリーアカウントにアクセスして"}, {"type": "subtitle", "time": 10936.389, "timestamp": "03:02:16", "text": "このような認証コードから"}, {"type": "subtitle", "time": 10938.91, "timestamp": "03:02:18", "text": "第三者"}, {"type": "subtitle", "time": 10941.469, "timestamp": "03:02:21", "text": "プラットフォーム。私はそう思います"}, {"type": "subtitle", "time": 10944.349, "timestamp": "03:02:24", "text": "これ。はい、トークンコードがもらえます"}, {"type": "subtitle", "time": 10953.23, "timestamp": "03:02:33", "text": "うん、それは後でやるよ。いいえ"}, {"type": "subtitle", "time": 10955.79, "timestamp": "03:02:35", "text": "心配事。"}, {"type": "subtitle", "time": 10957.309, "timestamp": "03:02:37", "text": "ああ、"}, {"type": "subtitle", "time": 10959.79, "timestamp": "03:02:39", "text": "ついに"}, {"type": "subtitle", "time": 10963.11, "timestamp": "03:02:43", "text": "自由。自由。心臓の鼓動。ああ、それは"}, {"type": "subtitle", "time": 10964.75, "timestamp": "03:02:44", "text": "ビート。"}, {"type": "subtitle", "time": 10967.59, "timestamp": "03:02:47", "text": "よし、心臓が動いている。何てことだ。"}]
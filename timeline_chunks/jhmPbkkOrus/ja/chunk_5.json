[{"type": "subtitle", "time": 305.83, "timestamp": "00:05:05", "text": "えっと、リフレッシュして色々やらなきゃいけなかったんだ"}, {"type": "subtitle", "time": 307.83, "timestamp": "00:05:07", "text": "物事について。"}, {"type": "subtitle", "time": 310.35, "timestamp": "00:05:10", "text": "ああ、でも"}, {"type": "subtitle", "time": 319.71, "timestamp": "00:05:19", "text": "少し。私は5時に寝ました。"}, {"type": "subtitle", "time": 329.31, "timestamp": "00:05:29", "text": "ええ、私は"}, {"type": "subtitle", "time": 333.95, "timestamp": "00:05:33", "text": "10ずつ増えて、"}, {"type": "subtitle", "time": 341.55, "timestamp": "00:05:41", "text": "すでにすでに"}, {"type": "subtitle", "time": 345.629, "timestamp": "00:05:45", "text": "12. まさに正午です"}, {"type": "subtitle", "time": 356.71, "timestamp": "00:05:56", "text": "うーん、だから分からない。"}]
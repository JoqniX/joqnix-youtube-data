[{"type": "subtitle", "time": 9480.75, "timestamp": "02:38:00", "text": "くそ。多くの人がこれを台無しにする。待って。"}, {"type": "subtitle", "time": 9488.67, "timestamp": "02:38:08", "text": "ウォーキング形式に加え、イベント運営に関する追加サポートも提供します。"}, {"type": "subtitle", "time": 9490.91, "timestamp": "02:38:10", "text": "ああ、10分"}, {"type": "subtitle", "time": 9493.54, "timestamp": "02:38:13", "text": "昔、人々はそうしていた。"}, {"type": "subtitle", "time": 9496.03, "timestamp": "02:38:16", "text": "[音楽]"}, {"type": "subtitle", "time": 9506.71, "timestamp": "02:38:26", "text": "もの。この最新のものをお伝えします"}, {"type": "subtitle", "time": 9514.469, "timestamp": "02:38:34", "text": "アクティブ。わかった。この人"}, {"type": "subtitle", "time": 9536.51, "timestamp": "02:38:56", "text": "[音楽]"}]
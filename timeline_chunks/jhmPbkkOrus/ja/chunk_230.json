[{"type": "subtitle", "time": 13800.229, "timestamp": "03:50:00", "text": "私は本当にそうなのか知りたいのですが、私は"}, {"type": "subtitle", "time": 13802.349, "timestamp": "03:50:02", "text": "他のことにかなり飽きている"}, {"type": "subtitle", "time": 13805.429, "timestamp": "03:50:05", "text": "キャラクター。ああ、そうだね、"}, {"type": "subtitle", "time": 13807.63, "timestamp": "03:50:07", "text": "ブー。"}, {"type": "subtitle", "time": 13820.79, "timestamp": "03:50:20", "text": "すぐ戻ります。なぜみんな禁止しているの？"}, {"type": "subtitle", "time": 13823.349, "timestamp": "03:50:23", "text": "スパイダーマン？彼らはそうするつもりだ。"}, {"type": "subtitle", "time": 13825.51, "timestamp": "03:50:25", "text": "そうそう。ほら、見よ。よくやった、みんな。の"}, {"type": "subtitle", "time": 13826.95, "timestamp": "03:50:26", "text": "他のチームもスパイダーマンを禁止していた。"}, {"type": "subtitle", "time": 13828.51, "timestamp": "03:50:28", "text": "禁止しよう"}, {"type": "subtitle", "time": 13831.15, "timestamp": "03:50:31", "text": "グルー。クソッ"}, {"type": "subtitle", "time": 13835.229, "timestamp": "03:50:35", "text": "キリスト。今、何を禁止しているのですか？の"}, {"type": "subtitle", "time": 13838.469, "timestamp": "03:50:38", "text": "もっと。ああ、それは我々の鉄拳のせいだ。おお、"}, {"type": "subtitle", "time": 13842.75, "timestamp": "03:50:42", "text": "もっと拳を禁止しよう、"}, {"type": "subtitle", "time": 13845.67, "timestamp": "03:50:45", "text": "右？わかったよ、もちろんさ。はい、はい、"}, {"type": "subtitle", "time": 13847.55, "timestamp": "03:50:47", "text": "相棒。はい、はい。もちろん、"}, {"type": "subtitle", "time": 13851.07, "timestamp": "03:50:51", "text": "もちろん。なぜ私の仲間は禁止されているのか"}, {"type": "subtitle", "time": 13853.269, "timestamp": "03:50:53", "text": "アイアンフィスト？彼らはアイアンフィストを持っているのか？"}, {"type": "subtitle", "time": 13855.11, "timestamp": "03:50:55", "text": "プレーヤー？ああ、彼らはエマをネバーのために禁止した"}]
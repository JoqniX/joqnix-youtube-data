[{"type": "subtitle", "time": 16623.51, "timestamp": "04:37:03", "text": "あれを見てください。おお、なかなかきれいだ。"}, {"type": "subtitle", "time": 16624.429, "timestamp": "04:37:04", "text": "クリーン"}, {"type": "subtitle", "time": 16630.07, "timestamp": "04:37:10", "text": "ところで、ジョー、あなたはここにいますか？は"}, {"type": "subtitle", "time": 16632.949, "timestamp": "04:37:12", "text": "すべて大丈夫ですか？このまま続けるべきでしょうか？"}, {"type": "subtitle", "time": 16635.99, "timestamp": "04:37:15", "text": "何かサインを見せてくれ。彼にメッセージを送ります。"}, {"type": "subtitle", "time": 16638.31, "timestamp": "04:37:18", "text": "尋ねる代わりに、"}, {"type": "subtitle", "time": 16639.78, "timestamp": "04:37:19", "text": "メッセージ"}, {"type": "subtitle", "time": 16661.59, "timestamp": "04:37:41", "text": "一方、スポーツマンが言うように"}, {"type": "subtitle", "time": 16666.51, "timestamp": "04:37:46", "text": "何か、もう一つ見せてあげる"}, {"type": "subtitle", "time": 16669.349, "timestamp": "04:37:49", "text": "もの。このチャットで誰かが"}, {"type": "subtitle", "time": 16672.07, "timestamp": "04:37:52", "text": "すでに"}, {"type": "subtitle", "time": 16675.269, "timestamp": "04:37:55", "text": "ここには、これが全体であり、"}, {"type": "subtitle", "time": 16677.83, "timestamp": "04:37:57", "text": "全選手名簿。"}, {"type": "subtitle", "time": 16679.67, "timestamp": "04:37:59", "text": "マリオのキャラクターが欲しいなら"}]
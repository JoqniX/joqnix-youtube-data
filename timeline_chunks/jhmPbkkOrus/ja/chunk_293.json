[{"type": "subtitle", "time": 17580.868, "timestamp": "04:53:00", "text": "ちくしょう。とにかく、えっと、私は思う、私は思う"}, {"type": "subtitle", "time": 17583.43, "timestamp": "04:53:03", "text": "その時初めてポップした"}, {"type": "subtitle", "time": 17587.31, "timestamp": "04:53:07", "text": "あなたのストリームに「ああ、これは"}, {"type": "subtitle", "time": 17595.11, "timestamp": "04:53:15", "text": "まず最初に、私は"}, {"type": "subtitle", "time": 17596.948, "timestamp": "04:53:16", "text": "君に会ったときみたいに、「ああ、これは"}, {"type": "subtitle", "time": 17600.23, "timestamp": "04:53:20", "text": "「あの人はおそらくトランスジェンダーか何かでしょう。」"}, {"type": "subtitle", "time": 17604.15, "timestamp": "04:53:24", "text": "私はたぶんこう思った。「うん、トランスジェンダーか"}, {"type": "subtitle", "time": 17606.03, "timestamp": "04:53:26", "text": "のように"}, {"type": "subtitle", "time": 17609.03, "timestamp": "04:53:29", "text": "おてんばな女性"}, {"type": "subtitle", "time": 17611.83, "timestamp": "04:53:31", "text": "モデルに座った。"}, {"type": "subtitle", "time": 17613.83, "timestamp": "04:53:33", "text": "少しチャットして、人々の"}, {"type": "subtitle", "time": 17616.07, "timestamp": "04:53:36", "text": "コメントを見て、「よし、これは"}, {"type": "subtitle", "time": 17625.51, "timestamp": "04:53:45", "text": "おい、そうだよ、君の声はそんなに"}, {"type": "subtitle", "time": 17628.628, "timestamp": "04:53:48", "text": "紛らわしい。はい、私が先にやりました。つまりそれは"}, {"type": "subtitle", "time": 17630.47, "timestamp": "04:53:50", "text": "これってトランス男性か何か？ A"}, {"type": "subtitle", "time": 17633.11, "timestamp": "04:53:53", "text": "トランスジェンダー女性？これは初めてのことです"}, {"type": "subtitle", "time": 17634.628, "timestamp": "04:53:54", "text": "混乱を招く。ええ、最初の"}, {"type": "subtitle", "time": 17637.03, "timestamp": "04:53:57", "text": "時間。そしてその後私は"}]
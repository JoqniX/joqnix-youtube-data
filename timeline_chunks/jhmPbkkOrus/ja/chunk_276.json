[{"type": "subtitle", "time": 16576.07, "timestamp": "04:36:16", "text": "すごくかっこいい。彼女のデフォルトスキンだと思います"}, {"type": "subtitle", "time": 16580.47, "timestamp": "04:36:20", "text": "どちらかというとゴシック調で、"}, {"type": "subtitle", "time": 16583.109, "timestamp": "04:36:23", "text": "あなたが知っている。どこですか？うん。このような"}, {"type": "subtitle", "time": 16584.551, "timestamp": "04:36:24", "text": "肌。ああ、気にしないで。これは違う。これ"}, {"type": "subtitle", "time": 16587.67, "timestamp": "04:36:27", "text": "それはもう一方の皮膚です。ええ、これです。これ"}, {"type": "subtitle", "time": 16591.109, "timestamp": "04:36:31", "text": "これよりもっとゴシックなものがある。できない"}, {"type": "subtitle", "time": 16593.47, "timestamp": "04:36:33", "text": "毎回見る"}, {"type": "subtitle", "time": 16596.551, "timestamp": "04:36:36", "text": "これ？毎回イントロを見ないようにすることはできますか？"}, {"type": "subtitle", "time": 16603.349, "timestamp": "04:36:43", "text": "私の。このスキンもすごくかっこいいですね。の"}, {"type": "subtitle", "time": 16607.789, "timestamp": "04:36:47", "text": "鎧。"}, {"type": "subtitle", "time": 16611.39, "timestamp": "04:36:51", "text": "うん。そしてこれがX-メンのレトロXです"}, {"type": "subtitle", "time": 16614.31, "timestamp": "04:36:54", "text": "制服。うん。これもすごくクールですね。"}, {"type": "subtitle", "time": 16618.869, "timestamp": "04:36:58", "text": "このスキンのダークバージョンはすごくかっこいい。"}]
[{"type": "subtitle", "time": 11340.389, "timestamp": "03:09:00", "text": "さあ、どうだろうね。"}, {"type": "subtitle", "time": 11342.51, "timestamp": "03:09:02", "text": "ただ、今はこれを持っている"}, {"type": "subtitle", "time": 11344.87, "timestamp": "03:09:04", "text": "両性具有的な声。私はこれで最高だ"}, {"type": "subtitle", "time": 11348.23, "timestamp": "03:09:08", "text": "声。だから、混乱するかもしれない"}, {"type": "subtitle", "time": 11351.63, "timestamp": "03:09:11", "text": "多くの人にとって。そう、それが"}, {"type": "subtitle", "time": 11354.55, "timestamp": "03:09:14", "text": "もの。おお"}, {"type": "subtitle", "time": 11357.59, "timestamp": "03:09:17", "text": "うん。ええ、そうです。何てことだ。しかしそれは"}, {"type": "subtitle", "time": 11359.91, "timestamp": "03:09:19", "text": "まるでスパムしているみたいだけど、ビームではただ"}, {"type": "subtitle", "time": 11365.19, "timestamp": "03:09:25", "text": "はい、そうです。なるほど。うん。私の頭の中では"}, {"type": "subtitle", "time": 11368.23, "timestamp": "03:09:28", "text": "なんで彼はスパムしてるの？君は男だから"}, {"type": "subtitle", "time": 11370.389, "timestamp": "03:09:30", "text": "何度も？"}, {"type": "subtitle", "time": 11373.349, "timestamp": "03:09:33", "text": "バグ報告が必要です。これを送らなければならない"}, {"type": "subtitle", "time": 11377.51, "timestamp": "03:09:37", "text": "バグ報告のようなものです。みんな、これを見てくれ。"}, {"type": "subtitle", "time": 11380.469, "timestamp": "03:09:40", "text": "Beamのチャットを見てください。これはスパム行為です。 1つ"}, {"type": "subtitle", "time": 11383.349, "timestamp": "03:09:43", "text": "メッセージがスパム扱いされています。"}, {"type": "subtitle", "time": 11385.269, "timestamp": "03:09:45", "text": "うん。うん。ただし、Twitch限定です。ない"}, {"type": "subtitle", "time": 11387.03, "timestamp": "03:09:47", "text": "YouTubeのメッセージ。 Twitch限定配信。"}, {"type": "subtitle", "time": 11389.23, "timestamp": "03:09:49", "text": "YouTubeは"}, {"type": "subtitle", "time": 11392.87, "timestamp": "03:09:52", "text": "ない。私たちを混同しないでください。"}, {"type": "subtitle", "time": 11394.79, "timestamp": "03:09:54", "text": "いや、違う。彼は男だ。心配しないでください"}, {"type": "subtitle", "time": 11397.269, "timestamp": "03:09:57", "text": "それ。ちょっと小便してるだけだよ。ただ"}]
[{"type": "subtitle", "time": 7223.03, "timestamp": "02:00:23", "text": "[音楽]"}, {"type": "subtitle", "time": 7224.87, "timestamp": "02:00:24", "text": "おお、ストリーマーよ、君のシフトは終わりだ。行く"}, {"type": "subtitle", "time": 7227.24, "timestamp": "02:00:27", "text": "食べる。ああ、そうだね。うん。もうすぐ終わります。"}, {"type": "subtitle", "time": 7236.79, "timestamp": "02:00:36", "text": "メイト。後ほど引き継ぎます。"}, {"type": "subtitle", "time": 7240.31, "timestamp": "02:00:40", "text": "ああ、見て、あれを見て。"}, {"type": "subtitle", "time": 7242.87, "timestamp": "02:00:42", "text": "まるでプログレスバーみたいだった。それは"}, {"type": "subtitle", "time": 7249.669, "timestamp": "02:00:49", "text": "今すぐ壊れるのを見てください。インストールされていません"}, {"type": "subtitle", "time": 7255.109, "timestamp": "02:00:55", "text": "依存関係。ああ、気にしないで。わかった。"}, {"type": "subtitle", "time": 7258.75, "timestamp": "02:00:58", "text": "待って、待って、待って。来て。"}]
[{"type": "subtitle", "time": 5769.79, "timestamp": "01:36:09", "text": "ID。わかった。"}, {"type": "subtitle", "time": 5772.03, "timestamp": "01:36:12", "text": "ペースト。"}, {"type": "subtitle", "time": 5778.709, "timestamp": "01:36:18", "text": "あの、助けてください。グローを使うべきでしょうか？"}, {"type": "subtitle", "time": 5781.43, "timestamp": "01:36:21", "text": "問題は、より大きなバージョンを使用した場合"}, {"type": "subtitle", "time": 5784.31, "timestamp": "01:36:24", "text": "うまくいかないかもしれない。待って、それは"}, {"type": "subtitle", "time": 5787.75, "timestamp": "01:36:27", "text": "1つは無料ですか？ 30単位。わかった。何"}, {"type": "subtitle", "time": 5790.87, "timestamp": "01:36:30", "text": "これについて？ 1単位。ディープ"}, {"type": "subtitle", "time": 5792.43, "timestamp": "01:36:32", "text": "振って"}, {"type": "subtitle", "time": 5796.35, "timestamp": "01:36:36", "text": "チェック？ログインしなければなりません。"}]
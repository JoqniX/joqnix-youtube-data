[{"type": "subtitle", "time": 16870.15, "timestamp": "04:41:10", "text": "私たちのグループが彼の"}, {"type": "subtitle", "time": 16872.75, "timestamp": "04:41:12", "text": "自分の、私は切り替えます"}, {"type": "subtitle", "time": 16875.868, "timestamp": "04:41:15", "text": "DPS。彼方は"}, {"type": "subtitle", "time": 16879.51, "timestamp": "04:41:19", "text": "そこには？ヨンドは誰だったのか、ああ、"}, {"type": "subtitle", "time": 16882.31, "timestamp": "04:41:22", "text": "ボール。わかった。わかった。笛を吹く男。"}, {"type": "subtitle", "time": 16884.39, "timestamp": "04:41:24", "text": "いいえ。そして、彼がそこにいるとは思いません。"}, {"type": "subtitle", "time": 16887.35, "timestamp": "04:41:27", "text": "彼の能力はいつでも"}, {"type": "subtitle", "time": 16892.31, "timestamp": "04:41:32", "text": "ヨンドゥが口笛を吹き始めたのを見た"}, {"type": "subtitle", "time": 16895.67, "timestamp": "04:41:35", "text": "みんな一発撃たれて死ぬ"}, {"type": "subtitle", "time": 16897.75, "timestamp": "04:41:37", "text": "そういうことが起こるんだ"}, {"type": "subtitle", "time": 16899.83, "timestamp": "04:41:39", "text": "だから、ヨンドゥはこれには登場しないと思う"}, {"type": "subtitle", "time": 16907.83, "timestamp": "04:41:47", "text": "それで、この人たちは一体何を言っているんだ？"}]
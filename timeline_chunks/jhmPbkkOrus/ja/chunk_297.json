[{"type": "subtitle", "time": 17830.788, "timestamp": "04:57:10", "text": "キャラクターを禁止することができます。"}, {"type": "subtitle", "time": 17832.55, "timestamp": "04:57:12", "text": "はい、できますよ。ある特定の後に"}, {"type": "subtitle", "time": 17834.15, "timestamp": "04:57:14", "text": "ランク、あなたは禁止することができます"}, {"type": "subtitle", "time": 17836.59, "timestamp": "04:57:16", "text": "キャラクター。"}, {"type": "subtitle", "time": 17839.11, "timestamp": "04:57:19", "text": "おお。ああ、ランク戦をプレイしているんですね。それは"}, {"type": "subtitle", "time": 17848.07, "timestamp": "04:57:28", "text": "くそ。この男は私の前回のゲームに出てきた人ですか、それとも"}, {"type": "subtitle", "time": 17849.83, "timestamp": "04:57:29", "text": "何か？私は消えていくタイプじゃない"}, {"type": "subtitle", "time": 17853.59, "timestamp": "04:57:33", "text": "静かに背景に溶け込む。"}, {"type": "subtitle", "time": 17855.27, "timestamp": "04:57:35", "text": "あのね？私は彼にこう見せなければならない"}, {"type": "subtitle", "time": 17858.628, "timestamp": "04:57:38", "text": "彼に何かを見せなければならない。"}, {"type": "subtitle", "time": 17864.788, "timestamp": "04:57:44", "text": "素晴らしいタイプ。これが何なのか知っているなら"}, {"type": "subtitle", "time": 17867.27, "timestamp": "04:57:47", "text": "動的な画像とはそういう意味です"}, {"type": "subtitle", "time": 17874.788, "timestamp": "04:57:54", "text": "もしその人が、もしその人が"}, {"type": "subtitle", "time": 17877.03, "timestamp": "04:57:57", "text": "このゲームにかなりの時間を費やした"}, {"type": "subtitle", "time": 17879.35, "timestamp": "04:57:59", "text": "そういう関係性をたくさん築きたい"}]
[{"type": "subtitle", "time": 18422.31, "timestamp": "05:07:02", "text": "おお、"}, {"type": "subtitle", "time": 18434.15, "timestamp": "05:07:14", "text": "ああ、やった！入ったぞ。マジかよ。おお"}, {"type": "subtitle", "time": 18437.27, "timestamp": "05:07:17", "text": "私の現在のリオは"}, {"type": "subtitle", "time": 18439.11, "timestamp": "05:07:19", "text": "参加しました。"}, {"type": "subtitle", "time": 18441.19, "timestamp": "05:07:21", "text": "何？いいえ。"}, {"type": "subtitle", "time": 18443.51, "timestamp": "05:07:23", "text": "一体どういうことだ？私は大きなものを見た"}, {"type": "subtitle", "time": 18445.83, "timestamp": "05:07:25", "text": "視界の端に尻が映った。私はこう思う、"}, {"type": "subtitle", "time": 18448.55, "timestamp": "05:07:28", "text": "あれは何だ？"}, {"type": "subtitle", "time": 18450.55, "timestamp": "05:07:30", "text": "ねえ、この勝負に勝つってどういう意味？"}, {"type": "subtitle", "time": 18452.91, "timestamp": "05:07:32", "text": "私は自分のメインキャラクターを操作しています。もしあなたが"}, {"type": "subtitle", "time": 18455.15, "timestamp": "05:07:35", "text": "みんな"}, {"type": "subtitle", "time": 18457.75, "timestamp": "05:07:37", "text": "マーベルをプレイしている皆さんは、"}, {"type": "subtitle", "time": 18461.19, "timestamp": "05:07:41", "text": "君たちは私を招待しなかった。"}, {"type": "subtitle", "time": 18473.35, "timestamp": "05:07:53", "text": "ローンの調子はどうですか？"}, {"type": "subtitle", "time": 18476.948, "timestamp": "05:07:56", "text": "私は起きたばかりです。目が覚めたの？"}, {"type": "subtitle", "time": 18478.47, "timestamp": "05:07:58", "text": "うん。"}]
[{"type": "subtitle", "time": 6369.43, "timestamp": "01:46:09", "text": "スクリプト。参加メッセージを受信しませんでした"}, {"type": "subtitle", "time": 6373.79, "timestamp": "01:46:13", "text": "フレームを受信または送信しました。"}, {"type": "subtitle", "time": 6394.07, "timestamp": "01:46:34", "text": "待って。なぜ動作しないのですか？これが欲しい"}, {"type": "subtitle", "time": 6397.91, "timestamp": "01:46:37", "text": "働けよ、相棒。私が欲しいのはユーザー名だけです"}, {"type": "subtitle", "time": 6407.39, "timestamp": "01:46:47", "text": "解決策を見つけます"}]
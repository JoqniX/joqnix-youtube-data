[{"type": "subtitle", "time": 16802.788, "timestamp": "04:40:02", "text": "男。ええ、彼のような別の形"}, {"type": "subtitle", "time": 16804.47, "timestamp": "04:40:04", "text": "それらを切り替える。それは"}, {"type": "subtitle", "time": 16811.43, "timestamp": "04:40:11", "text": "いいね。はい。はい。はい。"}, {"type": "subtitle", "time": 16812.99, "timestamp": "04:40:12", "text": "では"}, {"type": "subtitle", "time": 16815.39, "timestamp": "04:40:15", "text": "今考えると"}, {"type": "subtitle", "time": 16818.11, "timestamp": "04:40:18", "text": "歩哨"}, {"type": "subtitle", "time": 16823.27, "timestamp": "04:40:23", "text": "漫画。ちょっと難しいか"}, {"type": "subtitle", "time": 16825.43, "timestamp": "04:40:25", "text": "悪役。私は批判しているわけではありません。それはある意味"}, {"type": "subtitle", "time": 16832.868, "timestamp": "04:40:32", "text": "彼が戦車だったら、彼の"}, {"type": "subtitle", "time": 16849.35, "timestamp": "04:40:49", "text": "また。鉄拳でベッドを勝ち取ったが、"}, {"type": "subtitle", "time": 16859.55, "timestamp": "04:40:59", "text": "おお"}]
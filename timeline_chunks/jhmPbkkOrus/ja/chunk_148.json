[{"type": "subtitle", "time": 8881.03, "timestamp": "02:28:01", "text": "ベンチャーキャピタリスト。ここでは、ダウンロードする必要があるかもしれません"}, {"type": "subtitle", "time": 8883.27, "timestamp": "02:28:03", "text": "以前のバージョン。使わなくても使用できます"}, {"type": "subtitle", "time": 8886.23, "timestamp": "02:28:06", "text": "元気。したがって、車輪は不要です。分かりますか"}, {"type": "subtitle", "time": 8888.79, "timestamp": "02:28:08", "text": "メッセージビルドは、"}, {"type": "subtitle", "time": 8890.55, "timestamp": "02:28:10", "text": "コンピューター上のパッケージがダウンロードされない"}, {"type": "subtitle", "time": 8893.07, "timestamp": "02:28:13", "text": "それ。わかった。見ることができます"}, {"type": "subtitle", "time": 8897.55, "timestamp": "02:28:17", "text": "パッケージだが、30 用にコンパイルされない"}, {"type": "subtitle", "time": 8902.03, "timestamp": "02:28:22", "text": "3.12ですが、3.6用にコンパイルされただけです。"}, {"type": "subtitle", "time": 8904.51, "timestamp": "02:28:24", "text": "3.11.ポジティブは良い理由です"}, {"type": "subtitle", "time": 8907.27, "timestamp": "02:28:27", "text": "それ。ええと、おそらくあなたはまだ走っているのでしょう"}, {"type": "subtitle", "time": 8909.99, "timestamp": "02:28:29", "text": "以前は良好な環境を構築していませんでした。"}, {"type": "subtitle", "time": 8915.55, "timestamp": "02:28:35", "text": "わかった。"}, {"type": "subtitle", "time": 8920.03, "timestamp": "02:28:40", "text": "えっと、私は"}]
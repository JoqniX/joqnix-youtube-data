[{"type": "subtitle", "time": 11580.309, "timestamp": "03:13:00", "text": "私の声が分かりにくいということです。そうですね、"}, {"type": "subtitle", "time": 11583.389, "timestamp": "03:13:03", "text": "それでおしまい。どこに行っても"}, {"type": "subtitle", "time": 11588.23, "timestamp": "03:13:08", "text": "IR。あなたは女の子ですか？あなたは男の子ですか？全て"}, {"type": "subtitle", "time": 11590.87, "timestamp": "03:13:10", "text": "それら。"}, {"type": "subtitle", "time": 11593.67, "timestamp": "03:13:13", "text": "あなたは男性ですか？冗談でしょう？"}, {"type": "subtitle", "time": 11598.63, "timestamp": "03:13:18", "text": "自分？ああ、なんてことだ。"}, {"type": "subtitle", "time": 11601.19, "timestamp": "03:13:21", "text": "何てことだ。スパムのようないいねが私を"}, {"type": "subtitle", "time": 11603.03, "timestamp": "03:13:23", "text": "ちょっとイライラしてるけど、彼のせいじゃない"}, {"type": "subtitle", "time": 11605.11, "timestamp": "03:13:25", "text": "故障。"}, {"type": "subtitle", "time": 11608.55, "timestamp": "03:13:28", "text": "待って。ええと、あなたの勝ちです。これは私が持っているものです"}, {"type": "subtitle", "time": 11611.349, "timestamp": "03:13:31", "text": "違う。"}, {"type": "subtitle", "time": 11613.429, "timestamp": "03:13:33", "text": "バグ報告が必要です。"}, {"type": "subtitle", "time": 11620.19, "timestamp": "03:13:40", "text": "うまくいくかどうかはわかりません"}, {"type": "subtitle", "time": 11623.269, "timestamp": "03:13:43", "text": "しかし、"}, {"type": "subtitle", "time": 11626.79, "timestamp": "03:13:46", "text": "ああ、そうだね。 Billyでストリーミング配信してる？"}, {"type": "subtitle", "time": 11629.269, "timestamp": "03:13:49", "text": "はい。"}, {"type": "subtitle", "time": 11631.83, "timestamp": "03:13:51", "text": "そのチャットも一緒に掲載します。私"}, {"type": "subtitle", "time": 11633.83, "timestamp": "03:13:53", "text": "カテゴリを変更しました"}, {"type": "subtitle", "time": 11636.63, "timestamp": "03:13:56", "text": "バーチャルゲーマー。"}]
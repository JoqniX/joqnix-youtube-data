[{"type": "subtitle", "time": 19260.788, "timestamp": "05:21:00", "text": "ジェフ。正直に言うと、ジェフは最低だ。"}, {"type": "subtitle", "time": 19263.35, "timestamp": "05:21:03", "text": "いいえ。それに、私は人種差別主義者ではないので、"}, {"type": "subtitle", "time": 19266.55, "timestamp": "05:21:06", "text": "ジェフ役を演じるつもりだ。ジェフはいい奴だよ、兄弟。"}, {"type": "subtitle", "time": 19278.47, "timestamp": "05:21:18", "text": "何？ごめん。ジェフはなぜ人種差別主義者なのか？何？"}, {"type": "subtitle", "time": 19280.628, "timestamp": "05:21:20", "text": "いや、いや、いや。人種差別主義者だけがそれをやる"}, {"type": "subtitle", "time": 19282.23, "timestamp": "05:21:22", "text": "キャラクター。"}, {"type": "subtitle", "time": 19284.07, "timestamp": "05:21:24", "text": "はぁ？"}, {"type": "subtitle", "time": 19286.868, "timestamp": "05:21:26", "text": "おい、何だよ、なんてこった。"}, {"type": "subtitle", "time": 19288.868, "timestamp": "05:21:28", "text": "何てことだ。これを見てください。これは金です"}, {"type": "subtitle", "time": 19296.55, "timestamp": "05:21:36", "text": "おお、"}, {"type": "subtitle", "time": 19298.708, "timestamp": "05:21:38", "text": "それは良い"}, {"type": "subtitle", "time": 19300.948, "timestamp": "05:21:40", "text": "これはとても良いですね。"}, {"type": "subtitle", "time": 19305.03, "timestamp": "05:21:45", "text": "このマンティスとロキのファンアートはTwitterで見かけましたか？"}, {"type": "subtitle", "time": 19307.83, "timestamp": "05:21:47", "text": "ああ、あれはひどかった。それはとても気持ち悪かった"}, {"type": "subtitle", "time": 19310.868, "timestamp": "05:21:50", "text": "ファンアート。 BroはBroを使用しています"}, {"type": "subtitle", "time": 19313.75, "timestamp": "05:21:53", "text": "ツイッター。私は決して"}, {"type": "subtitle", "time": 19318.07, "timestamp": "05:21:58", "text": "何？俺はツイッターなんて絶対使えないよ。"}, {"type": "subtitle", "time": 19319.31, "timestamp": "05:21:59", "text": "[ __ ]、誰も"}]
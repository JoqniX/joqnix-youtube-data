[{"type": "subtitle", "time": 12908.67, "timestamp": "03:35:08", "text": "私は準備ができています"}, {"type": "subtitle", "time": 12912.51, "timestamp": "03:35:12", "text": "あなたに見せて"}, {"type": "subtitle", "time": 12916.469, "timestamp": "03:35:16", "text": "ここは危険だ。"}, {"type": "subtitle", "time": 12925.59, "timestamp": "03:35:25", "text": "私は自分の全てを無駄にしたと思う。月がさまよう"}, {"type": "subtitle", "time": 12928.55, "timestamp": "03:35:28", "text": "あなた。"}, {"type": "subtitle", "time": 12954.269, "timestamp": "03:35:54", "text": "ああ、なんてこった"}, {"type": "subtitle", "time": 12958.79, "timestamp": "03:35:58", "text": "家が死んだ。ええ、でもどうやって、どうやって"}]
[{"type": "subtitle", "time": 18018.23, "timestamp": "05:00:18", "text": "よし、彼が戻ってきた。彼が戻ってきた。彼が戻ってきた。"}, {"type": "subtitle", "time": 18024.868, "timestamp": "05:00:24", "text": "私が私たちの仕事を引き継ぎます。トニー、あなたは"}, {"type": "subtitle", "time": 18040.51, "timestamp": "05:00:40", "text": "よし、こういう"}, {"type": "subtitle", "time": 18059.67, "timestamp": "05:00:59", "text": "ああ、彼らは押している。彼らはやり方を知っている"}]
[{"type": "subtitle", "time": 12255.11, "timestamp": "03:24:15", "text": "死んだ。誰も何もしていない。これら"}, {"type": "subtitle", "time": 12257.99, "timestamp": "03:24:17", "text": "男たちはサブアカウントを積極的に使っていない。それは"}, {"type": "subtitle", "time": 12259.91, "timestamp": "03:24:19", "text": "かなりイライラする。それは見えないのか"}, {"type": "subtitle", "time": 12261.59, "timestamp": "03:24:21", "text": "動き？それは目に見えない。どれの"}, {"type": "subtitle", "time": 12263.429, "timestamp": "03:24:23", "text": "要素？見えない。ごめんなさい、私は"}, {"type": "subtitle", "time": 12265.91, "timestamp": "03:24:25", "text": "チャットを読んでいると集中しすぎてしまうので、"}, {"type": "subtitle", "time": 12284.55, "timestamp": "03:24:44", "text": "何てことだ。"}, {"type": "subtitle", "time": 12287.03, "timestamp": "03:24:47", "text": "彼らはクソに触れると叫んだ"}, {"type": "subtitle", "time": 12293.83, "timestamp": "03:24:53", "text": "彼は来てもいいですか？何てことだ。俺たちはクソだ"}]
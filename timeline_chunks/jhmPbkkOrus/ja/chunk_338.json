[{"type": "subtitle", "time": 20305.708, "timestamp": "05:38:25", "text": "えっと、私は好きではありません"}, {"type": "subtitle", "time": 20308.548, "timestamp": "05:38:28", "text": "えっと、それを別のシーンに入れて、"}, {"type": "subtitle", "time": 20311.35, "timestamp": "05:38:31", "text": "物の上を歩く。シーンを切り替えます"}, {"type": "subtitle", "time": 20313.51, "timestamp": "05:38:33", "text": "ここ。ビリー・ビリーは正義を見るだろう"}]
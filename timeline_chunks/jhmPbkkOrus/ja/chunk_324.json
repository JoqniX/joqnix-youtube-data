[{"type": "subtitle", "time": 19442.55, "timestamp": "05:24:02", "text": "今。ありがとう。"}, {"type": "subtitle", "time": 19445.35, "timestamp": "05:24:05", "text": "ええ、ただジョックはジョックだと言っているだけです"}, {"type": "subtitle", "time": 19447.91, "timestamp": "05:24:07", "text": "これが私がランクマッチをプレイしている理由です"}, {"type": "subtitle", "time": 19451.67, "timestamp": "05:24:11", "text": "ゲーム。何？暇な時はいつでも、"}, {"type": "subtitle", "time": 19453.75, "timestamp": "05:24:13", "text": "暇だから、ジョグに電話するよ。例えば、"}, {"type": "subtitle", "time": 19455.51, "timestamp": "05:24:15", "text": "私はあなたのストリームを引き継いでプレイします"}, {"type": "subtitle", "time": 19457.15, "timestamp": "05:24:17", "text": "ランキング"}, {"type": "subtitle", "time": 19463.91, "timestamp": "05:24:23", "text": "Ma Rivalsをプレイしたくないから"}, {"type": "subtitle", "time": 19465.93, "timestamp": "05:24:25", "text": "一人で。"}, {"type": "subtitle", "time": 19474.31, "timestamp": "05:24:34", "text": "うん。とにかく、私は行くつもりです"}, {"type": "subtitle", "time": 19478.628, "timestamp": "05:24:38", "text": "今は仕事があるから。こんにちは。ありがとう。"}, {"type": "subtitle", "time": 19481.75, "timestamp": "05:24:41", "text": "うん。うん。うん。あなたもこの虫にハマるといいですね"}, {"type": "subtitle", "time": 19485.03, "timestamp": "05:24:45", "text": "信者の問題は解決したよ、相棒。"}, {"type": "subtitle", "time": 19488.07, "timestamp": "05:24:48", "text": "今から取り掛かります。"}, {"type": "subtitle", "time": 19489.75, "timestamp": "05:24:49", "text": "うん。うん、私も気になってたんだ"}, {"type": "subtitle", "time": 19492.47, "timestamp": "05:24:52", "text": "それ。"}, {"type": "subtitle", "time": 19494.788, "timestamp": "05:24:54", "text": "私は彼らにチャットを尋ねました"}, {"type": "subtitle", "time": 19497.83, "timestamp": "05:24:57", "text": "右ラッププラスライブ彼らは言った"}]
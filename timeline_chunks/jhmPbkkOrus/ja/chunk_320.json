[{"type": "subtitle", "time": 19201.83, "timestamp": "05:20:01", "text": "動画。著作権を所有していなければなりません。"}, {"type": "subtitle", "time": 19203.99, "timestamp": "05:20:03", "text": "はぁ？"}, {"type": "subtitle", "time": 19206.47, "timestamp": "05:20:06", "text": "何？それはどういう意味ですか？いただけますか？"}, {"type": "subtitle", "time": 19209.35, "timestamp": "05:20:09", "text": "ブラッドさん、あなたの著作権の同意は"}, {"type": "subtitle", "time": 19211.99, "timestamp": "05:20:11", "text": "あなたのビデオを見せていますか？"}, {"type": "subtitle", "time": 19214.868, "timestamp": "05:20:14", "text": "ええ、そうですね。これを好きにならなければ"}, {"type": "subtitle", "time": 19219.23, "timestamp": "05:20:19", "text": "とても大きい。これは何ですか、"}, {"type": "subtitle", "time": 19222.43, "timestamp": "05:20:22", "text": "兄弟？これはプラットフォームです"}, {"type": "subtitle", "time": 19226.788, "timestamp": "05:20:26", "text": "クレイジー。何てことだ。 Mには私の許可が必要です"}, {"type": "subtitle", "time": 19232.03, "timestamp": "05:20:32", "text": "私の世界をストリーミング配信するのが好きです。それは"}, {"type": "subtitle", "time": 19234.47, "timestamp": "05:20:34", "text": "クレイジー。このチャットを見ていますか？もし"}, {"type": "subtitle", "time": 19236.11, "timestamp": "05:20:36", "text": "知らないだろうけど、これらは"}, {"type": "subtitle", "time": 19238.35, "timestamp": "05:20:38", "text": "ヒーラーたち。そして、もしあなたが知らないなら"}, {"type": "subtitle", "time": 19241.27, "timestamp": "05:20:41", "text": "センチュリオン、まるで私がたくさんの"}, {"type": "subtitle", "time": 19243.67, "timestamp": "05:20:43", "text": "これについて時間をかけています。百人隊長。二人のヒーラー。"}, {"type": "subtitle", "time": 19246.15, "timestamp": "05:20:46", "text": "なんてこった。"}, {"type": "subtitle", "time": 19249.43, "timestamp": "05:20:49", "text": "１、２、３、４、５。私は思う"}, {"type": "subtitle", "time": 19251.23, "timestamp": "05:20:51", "text": "ロケットはまもなく"}, {"type": "subtitle", "time": 19254.708, "timestamp": "05:20:54", "text": "百人隊長。さらに600人。アダムはどうですか？"}, {"type": "subtitle", "time": 19257.91, "timestamp": "05:20:57", "text": "アダムはもうすぐそこに着く。わかった。絶対に違う"}]
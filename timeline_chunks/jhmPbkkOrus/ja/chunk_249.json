[{"type": "subtitle", "time": 14943.389, "timestamp": "04:09:03", "text": "ああ、なんてことだ、あれはGGのものだった。"}, {"type": "subtitle", "time": 14946.51, "timestamp": "04:09:06", "text": "GGのパン屋さん。私は"}, {"type": "subtitle", "time": 14949.429, "timestamp": "04:09:09", "text": "戻る。あなたはスポーツマンですか？いいえ。いいえ。"}, {"type": "subtitle", "time": 14951.269, "timestamp": "04:09:11", "text": "ストリーム。彼は戻ってくるだろうか？はい、ジョックは"}, {"type": "subtitle", "time": 14952.95, "timestamp": "04:09:12", "text": "戻ってきます。 30分後に戻ります。"}, {"type": "subtitle", "time": 14955.349, "timestamp": "04:09:15", "text": "言った通りだよ。あなたは"}, {"type": "subtitle", "time": 14958.95, "timestamp": "04:09:18", "text": "文字通り、今まさに私を見ているような感じ？"}, {"type": "subtitle", "time": 14961.349, "timestamp": "04:09:21", "text": "あなたは本当に私のことを見ていますか"}, {"type": "subtitle", "time": 14964.59, "timestamp": "04:09:24", "text": "ストリームをあなたの"}, {"type": "subtitle", "time": 14967.429, "timestamp": "04:09:27", "text": "ストリーム？私のストリームでさえあなたの"}, {"type": "subtitle", "time": 14969.91, "timestamp": "04:09:29", "text": "ストリーム。本当にそうするつもりなの？は"}, {"type": "subtitle", "time": 14972.37, "timestamp": "04:09:32", "text": "本当に今それをやってるの？"}, {"type": "subtitle", "time": 14979.51, "timestamp": "04:09:39", "text": "神。イエス。皆さん、ここが重要な点です。男、"}, {"type": "subtitle", "time": 14982.309, "timestamp": "04:09:42", "text": "あの男はいいパンだ。ああ、ありがとうございます。"}, {"type": "subtitle", "time": 14985.67, "timestamp": "04:09:45", "text": "それは私ではありません。私は何もしていません"}, {"type": "subtitle", "time": 14988.07, "timestamp": "04:09:48", "text": "あのゲーム、私がやったの？何人倒しましたか？"}, {"type": "subtitle", "time": 14989.59, "timestamp": "04:09:49", "text": "持っている？私は実際には自分の"}, {"type": "subtitle", "time": 14992.309, "timestamp": "04:09:52", "text": "統計。ああ、少なくとも、"}, {"type": "subtitle", "time": 14994.03, "timestamp": "04:09:54", "text": "少しでも。戦車として"}, {"type": "chat", "time": 14994.799, "timestamp": "04:09:54", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnX
[{"type": "subtitle", "time": 4033.309, "timestamp": "01:07:13", "text": "つまり、私はこれらのどれも知らないのですが、"}, {"type": "subtitle", "time": 4065.99, "timestamp": "01:07:45", "text": "[音楽]"}, {"type": "subtitle", "time": 4069.029, "timestamp": "01:07:49", "text": "それで私は尋ねました。私は一昨日参加しました。"}, {"type": "subtitle", "time": 4071.589, "timestamp": "01:07:51", "text": "私はラッププラスのDiscordに参加しました。"}, {"type": "subtitle", "time": 4074.589, "timestamp": "01:07:54", "text": "尋ねたところ、"}, {"type": "subtitle", "time": 4077.91, "timestamp": "01:07:57", "text": "可能です、そして、私はそう言いました、いいえ彼らは"}]
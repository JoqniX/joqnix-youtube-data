[{"type": "subtitle", "time": 5701.91, "timestamp": "01:35:01", "text": "紫色の困惑がここにあります。困惑とは"}, {"type": "subtitle", "time": 5704.59, "timestamp": "01:35:04", "text": "ここ。 Groは"}, {"type": "subtitle", "time": 5712.669, "timestamp": "01:35:12", "text": "良い。種の"}, {"type": "subtitle", "time": 5715.51, "timestamp": "01:35:15", "text": "いいね。これは無料のものです。あなたはできる"}, {"type": "subtitle", "time": 5719.669, "timestamp": "01:35:19", "text": "毎日100クレジット獲得していますか、"}, {"type": "subtitle", "time": 5725.629, "timestamp": "01:35:25", "text": "あなたも購入できます。でも、そうしたいんです"}, {"type": "subtitle", "time": 5729.55, "timestamp": "01:35:29", "text": "本当に本当に"}, {"type": "subtitle", "time": 5731.07, "timestamp": "01:35:31", "text": "悲しい"}, {"type": "subtitle", "time": 5736.91, "timestamp": "01:35:36", "text": "そして、ウェブを使ってSammyを使用する"}, {"type": "subtitle", "time": 5740.51, "timestamp": "01:35:40", "text": "ソケット ソケット"}, {"type": "subtitle", "time": 5743.79, "timestamp": "01:35:43", "text": "接続コネクタ"}, {"type": "subtitle", "time": 5750.27, "timestamp": "01:35:50", "text": "ビリー・ビリーのライブ配信を延長する"}, {"type": "subtitle", "time": 5752.27, "timestamp": "01:35:52", "text": "部屋"}, {"type": "subtitle", "time": 5756.6, "timestamp": "01:35:56", "text": "チャット。ええと、これはWSです"}, {"type": "subtitle", "time": 5758.03, "timestamp": "01:35:58", "text": "[音楽]"}]
[{"type": "subtitle", "time": 18797.19, "timestamp": "05:13:17", "text": "[音楽]"}, {"type": "subtitle", "time": 18799.25, "timestamp": "05:13:19", "text": "ゼロレベル。"}, {"type": "subtitle", "time": 18810.07, "timestamp": "05:13:30", "text": "これは本当だよ、兄弟。うさぎに恋をする"}, {"type": "subtitle", "time": 18821.51, "timestamp": "05:13:41", "text": "あなたはアライグマのところで死ぬでしょう"}, {"type": "subtitle", "time": 18823.99, "timestamp": "05:13:43", "text": "究極のラグ。殺すのはどれくらい難しいですか"}, {"type": "subtitle", "time": 18834.15, "timestamp": "05:13:54", "text": "治癒は、"}, {"type": "subtitle", "time": 18838.23, "timestamp": "05:13:58", "text": "um によって治癒されました。なぜ私のゲームはフリーズするのですか？"}]
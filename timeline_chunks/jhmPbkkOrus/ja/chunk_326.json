[{"type": "subtitle", "time": 19560.47, "timestamp": "05:26:00", "text": "中国語だから必要、さもないと"}, {"type": "subtitle", "time": 19563.51, "timestamp": "05:26:03", "text": "そうでなければ、Googleで検索すればいい"}, {"type": "subtitle", "time": 19567.11, "timestamp": "05:26:07", "text": "翻訳して、大丈夫だよ、だってもし私が"}, {"type": "subtitle", "time": 19569.83, "timestamp": "05:26:09", "text": "チャットを読んでから中国語を少し"}, {"type": "subtitle", "time": 19571.51, "timestamp": "05:26:11", "text": "アルファベットが来るように私は"}, {"type": "subtitle", "time": 19573.47, "timestamp": "05:26:13", "text": "私も混乱しています"}, {"type": "subtitle", "time": 19579.83, "timestamp": "05:26:19", "text": "うん、いつか彼らはもっと上手くなるよ"}, {"type": "subtitle", "time": 19582.67, "timestamp": "05:26:22", "text": "中国語でも読んでるのかな。私はしなければならない"}, {"type": "subtitle", "time": 19585.59, "timestamp": "05:26:25", "text": "学ぶ。しかし、それは難しい。いいえ、それは"}, {"type": "subtitle", "time": 19587.35, "timestamp": "05:26:27", "text": "もの。"}, {"type": "subtitle", "time": 19590.23, "timestamp": "05:26:30", "text": "はい。はい。そうです。そうです。"}, {"type": "subtitle", "time": 19593.43, "timestamp": "05:26:33", "text": "日本語のような別の言語と"}, {"type": "subtitle", "time": 19596.21, "timestamp": "05:26:36", "text": "中国語。かなり難しい。"}, {"type": "subtitle", "time": 19606.31, "timestamp": "05:26:46", "text": "では、そろそろ失礼します。あなたたち二人は"}, {"type": "subtitle", "time": 19608.948, "timestamp": "05:26:48", "text": "楽しい。リヨコがここに留まるなら、"}, {"type": "subtitle", "time": 19610.788, "timestamp": "05:26:50", "text": "あなたはここに滞在するつもりですか？いいえ、"}, {"type": "subtitle", "time": 19614.47, "timestamp": "05:26:54", "text": "私も医者に行きます。こんにちは。訪問"}, {"type": "subtitle", "time": 19617.19, "timestamp": "05:26:57", "text": "医者。"}]
[{"type": "subtitle", "time": 17401.51, "timestamp": "04:50:01", "text": "あなたとブラッドはどうやって出会ったのですか？"}, {"type": "subtitle", "time": 17404.788, "timestamp": "04:50:04", "text": "私たちはどうやって出会ったの？"}, {"type": "subtitle", "time": 17413.75, "timestamp": "04:50:13", "text": "初めてうんちをしたのはいつですか？いつ"}, {"type": "subtitle", "time": 17417.59, "timestamp": "04:50:17", "text": "最初に私を発見した？"}, {"type": "subtitle", "time": 17420.55, "timestamp": "04:50:20", "text": "あなたと話します。うん。初めて"}, {"type": "subtitle", "time": 17422.31, "timestamp": "04:50:22", "text": "私を見てる？あ、待って。私は、"}, {"type": "subtitle", "time": 17433.27, "timestamp": "04:50:33", "text": "ごめん。私はこれを探しているのですが"}, {"type": "subtitle", "time": 17434.948, "timestamp": "04:50:34", "text": "いいえ、違います。一体何だったんだ？"}]
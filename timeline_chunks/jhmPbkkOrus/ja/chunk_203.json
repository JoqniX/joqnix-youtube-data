[{"type": "subtitle", "time": 12180.469, "timestamp": "03:23:00", "text": "何てことだ。もう使ってくれよ！"}, {"type": "subtitle", "time": 12182.469, "timestamp": "03:23:02", "text": "何てことだ。"}, {"type": "subtitle", "time": 12185.03, "timestamp": "03:23:05", "text": "君なら勝てたはずだ。私はただ私ではない"}, {"type": "subtitle", "time": 12186.63, "timestamp": "03:23:06", "text": "俺が動揺してないと思ってんのかよ、兄弟。うん、"}, {"type": "subtitle", "time": 12188.389, "timestamp": "03:23:08", "text": "文字通り。ええ、それが理由です。もしかしたらあなたは"}, {"type": "subtitle", "time": 12192.87, "timestamp": "03:23:12", "text": "えーと、えーと、から交換するべきだ。"}, {"type": "subtitle", "time": 12194.87, "timestamp": "03:23:14", "text": "うん。"}, {"type": "subtitle", "time": 12236.63, "timestamp": "03:23:56", "text": "シールドが壊れました。シールドが壊れました。"}]
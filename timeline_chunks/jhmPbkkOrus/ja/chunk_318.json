[{"type": "subtitle", "time": 19080.23, "timestamp": "05:18:00", "text": "俺はただお前の面倒を見てるだけだよ、兄弟。"}, {"type": "subtitle", "time": 19082.948, "timestamp": "05:18:02", "text": "だから、あなたは自分のことを忘れてしまったのね、こんな風に"}, {"type": "subtitle", "time": 19085.75, "timestamp": "05:18:05", "text": "そいつは2つのアカウントで必死に頑張っていた。二"}, {"type": "subtitle", "time": 19087.67, "timestamp": "05:18:07", "text": "アカウント。"}, {"type": "subtitle", "time": 19089.27, "timestamp": "05:18:09", "text": "それは私たちが呼ぶものではありません それは私たちが呼ぶものではありません"}, {"type": "subtitle", "time": 19092.11, "timestamp": "05:18:12", "text": "研削。わかった。だから、たとえあなたが"}, {"type": "subtitle", "time": 19095.35, "timestamp": "05:18:15", "text": "私の両方のアカウントのウォッチャーを追加するように、"}, {"type": "subtitle", "time": 19098.07, "timestamp": "05:18:18", "text": "観戦者、プレイヤー、それでもまだ低い"}, {"type": "subtitle", "time": 19100.55, "timestamp": "05:18:20", "text": "あなたよりも。それは許容できない。私たちは"}, {"type": "subtitle", "time": 19102.39, "timestamp": "05:18:22", "text": "この会話は昨日と同じ"}, {"type": "subtitle", "time": 19105.19, "timestamp": "05:18:25", "text": "昨日の犬。だから落ち着いて。とても穏やか"}, {"type": "subtitle", "time": 19107.83, "timestamp": "05:18:27", "text": "下。わかった。つまり、あなたはそうなので私は"}, {"type": "subtitle", "time": 19110.47, "timestamp": "05:18:30", "text": "全く同感です。"}, {"type": "subtitle", "time": 19119.35, "timestamp": "05:18:39", "text": "この男は、このゲームで400以上のR（レーティング）を持っている。"}, {"type": "subtitle", "time": 19120.83, "timestamp": "05:18:40", "text": "閉じる"}, {"type": "subtitle", "time": 19122.91, "timestamp": "05:18:42", "text": "くそ"}, {"type": "subtitle", "time": 19126.31, "timestamp": "05:18:46", "text": "言語を管理してください。私は261が好きです。"}, {"type": "subtitle", "time": 19128.47, "timestamp": "05:18:48", "text": "プレイ時間のようなものが見える。それはまるで"}, {"type": "subtitle", "time": 19130.47, "timestamp": "05:18:50", "text": "座っている。"}, {"type": "subtitle", "time": 19131.99, "timestamp": "05:18:51", "text": "イエス。"}, {"type": "subtitle", "time": 19134.55, "timestamp": "05:18:54", "text": "正直に言うと、私は悲しい人間だ。私は"}, {"type": "subtitle", "time": 19136.788, "timestamp": "05:18:56", "text": "悲しい男。"}, {"type": "subtitle", "time": 19138.59, "timestamp": "05:18:58", "text": "あなたは哀れな男だ。午前"}]
[{"type": "subtitle", "time": 14881.75, "timestamp": "04:08:01", "text": "一体何を見ているんだ？あなたは"}, {"type": "subtitle", "time": 14890.63, "timestamp": "04:08:10", "text": "サブアカウントが出るまで待つべきだった。"}, {"type": "subtitle", "time": 14893.189, "timestamp": "04:08:13", "text": "実際、私はWeでちょっと失敗しました"}, {"type": "subtitle", "time": 14896.03, "timestamp": "04:08:16", "text": "さらに、より多くの支持も得ている。私たちは押し進めることができます"}, {"type": "subtitle", "time": 14899.91, "timestamp": "04:08:19", "text": "これ。私たちはただ取り除く必要がある"}, {"type": "subtitle", "time": 14901.189, "timestamp": "04:08:21", "text": "ええ、それが私たちが必要とする唯一のことです"}, {"type": "subtitle", "time": 14922.87, "timestamp": "04:08:42", "text": "私のゲームから出て行け。"}, {"type": "subtitle", "time": 14924.95, "timestamp": "04:08:44", "text": "何てことだ。シング、君はすごい奴だ。あなたは"}, {"type": "subtitle", "time": 14926.51, "timestamp": "04:08:46", "text": "君は最高だ"}]
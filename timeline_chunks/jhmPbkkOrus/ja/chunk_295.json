[{"type": "subtitle", "time": 17701.27, "timestamp": "04:55:01", "text": "つまり、私に1ゲームだけプレイしてほしいってこと？だって私は"}, {"type": "subtitle", "time": 17704.31, "timestamp": "04:55:04", "text": "その後は1試合しかプレイできない。"}, {"type": "subtitle", "time": 17706.91, "timestamp": "04:55:06", "text": "うん。 5じゃないの？それは"}, {"type": "subtitle", "time": 17713.03, "timestamp": "04:55:13", "text": "ああ、もうどうでもいい。私が払うよ、だって"}, {"type": "subtitle", "time": 17714.788, "timestamp": "04:55:14", "text": "プラチナにも到達するよ、もし僕が勝ったらね"}, {"type": "subtitle", "time": 17720.31, "timestamp": "04:55:20", "text": "うん。うん。うん。あまり得られなかった"}, {"type": "subtitle", "time": 17723.19, "timestamp": "04:55:23", "text": "ポイント。調子に乗っていた時、25を手に入れた"}, {"type": "subtitle", "time": 17726.59, "timestamp": "04:55:26", "text": "そして私は怒鳴らなかった。私は手に入れた"}, {"type": "subtitle", "time": 17736.51, "timestamp": "04:55:36", "text": "奇妙な。ほんの少しだけ"}, {"type": "subtitle", "time": 17748.788, "timestamp": "04:55:48", "text": "昨日彼に会ったとき、"}, {"type": "subtitle", "time": 17751.19, "timestamp": "04:55:51", "text": "まず、同じ表現です。ええ、そう思います"}, {"type": "subtitle", "time": 17756.628, "timestamp": "04:55:56", "text": "あなたはどのヒーローになりたいですか？"}, {"type": "subtitle", "time": 17759.03, "timestamp": "04:55:59", "text": "今日？"}]
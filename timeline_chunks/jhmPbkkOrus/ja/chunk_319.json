[{"type": "subtitle", "time": 19141.83, "timestamp": "05:19:01", "text": "マイナスランクになったの？ああ、しまった。私"}, {"type": "subtitle", "time": 19144.47, "timestamp": "05:19:04", "text": "気づきませんでした。私はたくさん負ける。あなた"}, {"type": "subtitle", "time": 19147.11, "timestamp": "05:19:07", "text": "マイナス評価はできません。一体何なんだ"}, {"type": "subtitle", "time": 19150.47, "timestamp": "05:19:10", "text": "何の話をしているんですか？まるで負の勝利のようだ。私"}, {"type": "subtitle", "time": 19157.99, "timestamp": "05:19:17", "text": "これで私は確信しました。何が"}, {"type": "subtitle", "time": 19159.47, "timestamp": "05:19:19", "text": "最後"}, {"type": "subtitle", "time": 19161.948, "timestamp": "05:19:21", "text": "季節？"}, {"type": "subtitle", "time": 19166.15, "timestamp": "05:19:26", "text": "ポジティブ。これについては否定的だ。ネガティブ"}, {"type": "subtitle", "time": 19167.99, "timestamp": "05:19:27", "text": "これについても同様です。だから私はクソを返された"}, {"type": "subtitle", "time": 19171.27, "timestamp": "05:19:31", "text": "シーズンゼロとシーズンワンで。あなたはとても"}, {"type": "subtitle", "time": 19175.35, "timestamp": "05:19:35", "text": "くそっ。でも、君はただ単にクソみたいなことをするだけなんだ。"}, {"type": "subtitle", "time": 19179.99, "timestamp": "05:19:39", "text": "わかった、落ち着けよ、兄弟。落ち着け。"}, {"type": "subtitle", "time": 19181.59, "timestamp": "05:19:41", "text": "私は今、天体に乗るつもりです"}, {"type": "subtitle", "time": 19184.708, "timestamp": "05:19:44", "text": "季節。ただ、私は手に入れようとしている"}, {"type": "subtitle", "time": 19186.948, "timestamp": "05:19:46", "text": "ロード・オンに行く"}, {"type": "subtitle", "time": 19188.708, "timestamp": "05:19:48", "text": "あいつの名前は何だっけ？ウルトラ。良い、"}, {"type": "subtitle", "time": 19190.948, "timestamp": "05:19:50", "text": "あなたはセレスティアルを手に入れられません。"}, {"type": "subtitle", "time": 19193.19, "timestamp": "05:19:53", "text": "心配しないで。君は乗ります"}, {"type": "subtitle", "time": 19194.708, "timestamp": "05:19:54", "text": "天上の。うまくいってないよ"}, {"type": "subtitle", "time": 19197.27, "timestamp": "05:19:57", "text": "天上の。許可。あなたは"}, {"type": "subtitle", "time": 19198.788, "timestamp": "05:19:58", "text": "他人のゲームをプレイする許可"}]
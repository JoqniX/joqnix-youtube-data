[{"type": "subtitle", "time": 19500.55, "timestamp": "05:25:00", "text": "取り組むつもりです。そして、彼らはそうしないでしょう。"}, {"type": "subtitle", "time": 19503.27, "timestamp": "05:25:03", "text": "予定日は教えてくれなかったけど"}, {"type": "subtitle", "time": 19507.11, "timestamp": "05:25:07", "text": "彼らはウェブを作ろうとすると言った"}, {"type": "subtitle", "time": 19509.99, "timestamp": "05:25:09", "text": "リレーとかそういうのをフックで繋ぐんだ。だから私はただ"}, {"type": "subtitle", "time": 19511.91, "timestamp": "05:25:11", "text": "私のソフトウェアと接続する必要があります"}, {"type": "subtitle", "time": 19515.43, "timestamp": "05:25:15", "text": "サミーのやつ。ああ、わかった。そうすれば"}, {"type": "subtitle", "time": 19518.15, "timestamp": "05:25:18", "text": "チャットのすべてを見て"}, {"type": "subtitle", "time": 19521.67, "timestamp": "05:25:21", "text": "チャットして、それをDiscordに投稿できます"}, {"type": "subtitle", "time": 19526.15, "timestamp": "05:25:26", "text": "そして、どうすればログインできるか"}, {"type": "subtitle", "time": 19528.948, "timestamp": "05:25:28", "text": "生の状態でそれができるなら"}, {"type": "subtitle", "time": 19531.99, "timestamp": "05:25:31", "text": "生のコメントがあれば、彼らは"}, {"type": "subtitle", "time": 19533.43, "timestamp": "05:25:33", "text": "チャット翻訳は既にあります"}, {"type": "subtitle", "time": 19535.91, "timestamp": "05:25:35", "text": "機能はありません。それで、一度質問しようと思っていました。"}, {"type": "subtitle", "time": 19538.708, "timestamp": "05:25:38", "text": "チャットを追加できますか"}, {"type": "subtitle", "time": 19541.51, "timestamp": "05:25:41", "text": "翻訳機能も搭載されているので、"}, {"type": "subtitle", "time": 19543.83, "timestamp": "05:25:43", "text": "自動的に翻訳される"}, {"type": "subtitle", "time": 19547.03, "timestamp": "05:25:47", "text": "手伝ってくれるか、手動でもできます"}, {"type": "subtitle", "time": 19549.35, "timestamp": "05:25:49", "text": "何らかの理由で遅延が発生するでしょう"}, {"type": "subtitle", "time": 19552.55, "timestamp": "05:25:52", "text": "メッセージ1件、5分かかります。1番"}, {"type": "subtitle", "time": 19555.11, "timestamp": "05:25:55", "text": "Discordに送られるまで少なくとも1分かかります"}, {"type": "subtitle", "time": 19557.47, "timestamp": "05:25:57", "text": "翻訳が"}]
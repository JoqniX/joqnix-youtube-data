[{"type": "subtitle", "time": 20783.868, "timestamp": "05:46:23", "text": "[音楽]"}, {"type": "subtitle", "time": 20803.11, "timestamp": "05:46:43", "text": "ああ、ビリー・ビリーとは関係ない"}, {"type": "subtitle", "time": 20804.83, "timestamp": "05:46:44", "text": "チャット。 1つ"}, {"type": "subtitle", "time": 20810.788, "timestamp": "05:46:50", "text": "接続済み。心配しないで。ただ遊ぶだけ。しないで"}, {"type": "subtitle", "time": 20814.15, "timestamp": "05:46:54", "text": "間違いを犯す。あの赤いバー。うん。私"}, {"type": "subtitle", "time": 20816.47, "timestamp": "05:46:56", "text": "アカウント停止処分は絶対に避けたい。あなた"}]
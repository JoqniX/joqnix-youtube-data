[{"type": "subtitle", "time": 13081.67, "timestamp": "03:38:01", "text": "切り替えますか？ Twitchが一部を省略している理由"}, {"type": "subtitle", "time": 13083.91, "timestamp": "03:38:03", "text": "言葉？さあ、どうだろうね。わからない。"}, {"type": "subtitle", "time": 13086.71, "timestamp": "03:38:06", "text": "でも、パンに反対する"}, {"type": "subtitle", "time": 13089.51, "timestamp": "03:38:09", "text": "今。誰を追放すればいいんだ"}, {"type": "subtitle", "time": 13091.87, "timestamp": "03:38:11", "text": "マッチ？"}, {"type": "subtitle", "time": 13094.71, "timestamp": "03:38:14", "text": "バナー。もうどうでもいい。私はバナーを掲げます。私は思う"}, {"type": "subtitle", "time": 13104.309, "timestamp": "03:38:24", "text": "敵チームだと思うのは、"}, {"type": "subtitle", "time": 13106.87, "timestamp": "03:38:26", "text": "スパイダーマン嫌いの組合が禁止する"}, {"type": "subtitle", "time": 13110.389, "timestamp": "03:38:30", "text": "スパイダーマン。彼らがそうしてくれることを願っています。できない"}, {"type": "subtitle", "time": 13112.469, "timestamp": "03:38:32", "text": "スパイダーマンが大嫌いだ。ああ、彼らは禁止した"}, {"type": "subtitle", "time": 13114.19, "timestamp": "03:38:34", "text": "G. ああ、彼らは禁止した"}, {"type": "subtitle", "time": 13121.59, "timestamp": "03:38:41", "text": "スパイダーマン。ああ、そうだよ。だった"}, {"type": "subtitle", "time": 13123.95, "timestamp": "03:38:43", "text": "行く"}, {"type": "subtitle", "time": 13127.87, "timestamp": "03:38:47", "text": "スパイダーマン。私たちは、私は、あなたは知っている"}, {"type": "subtitle", "time": 13132.67, "timestamp": "03:38:52", "text": "何？これについては、"}]
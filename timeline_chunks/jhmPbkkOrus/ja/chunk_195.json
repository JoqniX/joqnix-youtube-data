[{"type": "subtitle", "time": 11703.429, "timestamp": "03:15:03", "text": "わかった。さあ、食べに行こう、友よ。"}, {"type": "subtitle", "time": 11707.19, "timestamp": "03:15:07", "text": "モデルの目を閉じさせてください。"}, {"type": "subtitle", "time": 11711.19, "timestamp": "03:15:11", "text": "何てことだ。目を閉じてください。"}, {"type": "subtitle", "time": 11713.67, "timestamp": "03:15:13", "text": "信じられないことに彼らは気づかないだろう"}, {"type": "subtitle", "time": 11715.389, "timestamp": "03:15:15", "text": "私は実際"}, {"type": "subtitle", "time": 11718.55, "timestamp": "03:15:18", "text": "放置中。そして、彼らは気にしないでしょう、なぜなら"}, {"type": "subtitle", "time": 11721.269, "timestamp": "03:15:21", "text": "君が話しているんだね。大丈夫です。"}, {"type": "subtitle", "time": 11723.51, "timestamp": "03:15:23", "text": "そうそう。"}, {"type": "subtitle", "time": 11725.67, "timestamp": "03:15:25", "text": "彼らは私が話していることをどうやって知ったのだろう？神のように"}, {"type": "subtitle", "time": 11729.269, "timestamp": "03:15:29", "text": "くそ、だって明らかに音声が送信されてる"}, {"type": "subtitle", "time": 11733.269, "timestamp": "03:15:33", "text": "ライオンはまさに怪しいクソ野郎だ"}, {"type": "subtitle", "time": 11735.429, "timestamp": "03:15:35", "text": "私には、なぜ聞こえないのかと思える"}, {"type": "subtitle", "time": 11737.67, "timestamp": "03:15:37", "text": "ゲームプレイとオーディオがあるような"}, {"type": "subtitle", "time": 11740.07, "timestamp": "03:15:40", "text": "音声解説なので大丈夫です"}, {"type": "subtitle", "time": 11741.83, "timestamp": "03:15:41", "text": "信じる"}, {"type": "subtitle", "time": 11744.95, "timestamp": "03:15:44", "text": "彼らはただ、管理者が"}, {"type": "subtitle", "time": 11753.75, "timestamp": "03:15:53", "text": "えっと、または単に取得するために"}, {"type": "subtitle", "time": 11756.63, "timestamp": "03:15:56", "text": "彼がプレイしている間、私の配信を見ている他の人"}, {"type": "subtitle", "time": 11759.11, "timestamp": "03:15:59", "text": "ゲーム。"}, {"type": "chat", "time": 11759.96, "timestamp": "03:15:59", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "backkk.... this isn't a vod right?"}]
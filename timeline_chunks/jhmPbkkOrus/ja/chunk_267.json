[{"type": "subtitle", "time": 16022.309, "timestamp": "04:27:02", "text": "うん。あなたはヒーラーが"}, {"type": "subtitle", "time": 16038.79, "timestamp": "04:27:18", "text": "私はほとんど怪我をしていない。"}, {"type": "subtitle", "time": 16040.79, "timestamp": "04:27:20", "text": "消える。"}, {"type": "subtitle", "time": 16058.469, "timestamp": "04:27:38", "text": "よし、今からそれらを破壊して"}, {"type": "subtitle", "time": 16060.149, "timestamp": "04:27:40", "text": "正直に言ってください。そして私たちは自分たちの分を貯めている。おお、"}, {"type": "subtitle", "time": 16062.469, "timestamp": "04:27:42", "text": "彼はどこから来たのか？それはどこで"}, {"type": "subtitle", "time": 16063.87, "timestamp": "04:27:43", "text": "男が来る"}, {"type": "subtitle", "time": 16070.349, "timestamp": "04:27:50", "text": "[音楽]"}, {"type": "subtitle", "time": 16072.67, "timestamp": "04:27:52", "text": "から？おお"}, {"type": "subtitle", "time": 16076.469, "timestamp": "04:27:56", "text": "男。そのスポーツ選手は身動きが取れないのか？いいえ。いいえ、それは"}]
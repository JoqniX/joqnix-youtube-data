[{"type": "subtitle", "time": 14595.269, "timestamp": "04:03:15", "text": "起動中。"}, {"type": "subtitle", "time": 14617.51, "timestamp": "04:03:37", "text": "はい。彼のために交代するのは、彼が"}, {"type": "subtitle", "time": 14619.07, "timestamp": "04:03:39", "text": "変更しました"}, {"type": "subtitle", "time": 14621.75, "timestamp": "04:03:41", "text": "それは一つのことと一つのことを意味する。ああ、"}, {"type": "subtitle", "time": 14625.75, "timestamp": "04:03:45", "text": "彼らは彼を出入り禁止にした。くそ。"}, {"type": "subtitle", "time": 14629.51, "timestamp": "04:03:49", "text": "私は奇妙な行動をとるべきでしょうか？"}, {"type": "subtitle", "time": 14631.51, "timestamp": "04:03:51", "text": "その車を再び動かしてください。それは"}, {"type": "subtitle", "time": 14635.11, "timestamp": "04:03:55", "text": "私のスカルブーを少し強化してあげて。"}]
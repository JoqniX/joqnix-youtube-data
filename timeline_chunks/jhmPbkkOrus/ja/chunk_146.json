[{"type": "subtitle", "time": 8763.99, "timestamp": "02:26:03", "text": "何でもいいからこれをダウンロードして"}, {"type": "subtitle", "time": 8765.83, "timestamp": "02:26:05", "text": "終わった。食事に行きます。欲しい"}, {"type": "subtitle", "time": 8773.27, "timestamp": "02:26:13", "text": "お腹がすいた。 64個のウェブベースインストーラー。いいえ、これは"}, {"type": "subtitle", "time": 8782.75, "timestamp": "02:26:22", "text": "右。これ"}, {"type": "subtitle", "time": 8785.27, "timestamp": "02:26:25", "text": "1つ。これらのことを言う理由は"}, {"type": "subtitle", "time": 8786.91, "timestamp": "02:26:26", "text": "君は変になってきている"}, {"type": "subtitle", "time": 8788.71, "timestamp": "02:26:28", "text": "説明書？いいえ、そうする必要はありません"}, {"type": "subtitle", "time": 8799.71, "timestamp": "02:26:39", "text": "[音楽]"}, {"type": "subtitle", "time": 8802.38, "timestamp": "02:26:42", "text": "そしてそれは少し"}, {"type": "subtitle", "time": 8810.11, "timestamp": "02:26:50", "text": "必要。 3.8は"}, {"type": "subtitle", "time": 8814.99, "timestamp": "02:26:54", "text": "問題。問題は、私が最新のものを持っているということです"}, {"type": "subtitle", "time": 8819.67, "timestamp": "02:26:59", "text": "3.13 そして私が欲しいのはただ"}]
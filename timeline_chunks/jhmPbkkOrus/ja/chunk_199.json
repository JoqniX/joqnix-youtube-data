[{"type": "subtitle", "time": 11941.55, "timestamp": "03:19:01", "text": "本当に？そこにある"}, {"type": "subtitle", "time": 11943.71, "timestamp": "03:19:03", "text": "は。"}, {"type": "subtitle", "time": 11945.91, "timestamp": "03:19:05", "text": "おお。だから、もし君たちが知らないなら"}, {"type": "subtitle", "time": 11947.75, "timestamp": "03:19:07", "text": "このゲームは、ヒーローシューティングゲームです。そして"}, {"type": "subtitle", "time": 11949.349, "timestamp": "03:19:09", "text": "もしあなたが彼女を撃った犯人を知らないなら、"}, {"type": "subtitle", "time": 11950.59, "timestamp": "03:19:10", "text": "助けられない"}, {"type": "subtitle", "time": 11953.67, "timestamp": "03:19:13", "text": "あなた。あなたは一人ぼっちです。私はそうしない"}, {"type": "subtitle", "time": 11956.469, "timestamp": "03:19:16", "text": "彼に何かを説明すること。"}, {"type": "subtitle", "time": 11959.83, "timestamp": "03:19:19", "text": "冗談だよ、でもそうはしない。だって綺麗だから"}, {"type": "chat", "time": 11963.826, "timestamp": "03:19:23", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "sleeping!?"}, {"type": "chat", "time": 11963.964, "timestamp": "03:19:23", "author": "@Solar07910", "avatar": "https://yt4.ggpht.com/j5v2GtdHe5Mb397GDb3gC5IoevB6pG5og12wcUK7kXFCbhNgN7R_gyWKDv5Ctf9yda4r1JuD1w=s64-c-k-c0x00ffffff-no-rj", "message": "Good day Mr Nix."}, {"type": "subtitle", "time": 11966.07, "timestamp": "03:19:26", "text": "知っておくべきことはただ一つ"}, {"type": "subtitle", "time": 11967.83, "timestamp": "03:19:27", "text": "このゲームについて、マーベルが登場する"}, {"type": "subtitle", "time": 11970.71, "timestamp": "03:19:30", "text": "サイロックのようなキャラクター、もしあなたが"}, {"type": "subtitle", "time": 11974.15, "timestamp": "03:19:34", "text": "彼女のこと、あるいはマグニートーのことを聞いたことがあると思うんだけど、"}, {"type": "subtitle", "time": 11990.15, "timestamp": "03:19:50", "text": "これは今日の最初の試合です。"}]
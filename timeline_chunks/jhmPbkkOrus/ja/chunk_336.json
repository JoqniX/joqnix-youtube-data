[{"type": "subtitle", "time": 20160.548, "timestamp": "05:36:00", "text": "再印刷オプションを選択する必要があります。"}, {"type": "subtitle", "time": 20163.75, "timestamp": "05:36:03", "text": "これまでずっと私は選んできました"}, {"type": "subtitle", "time": 20179.788, "timestamp": "05:36:19", "text": "関数。うん。うん。 1枚のコイン"}, {"type": "subtitle", "time": 20182.19, "timestamp": "05:36:22", "text": "ダブルコイン"}, {"type": "subtitle", "time": 20184.51, "timestamp": "05:36:24", "text": "[音楽]"}, {"type": "subtitle", "time": 20187.51, "timestamp": "05:36:27", "text": "1つ。トイレに行きたい。私は手に入れるだろうか"}, {"type": "subtitle", "time": 20198.39, "timestamp": "05:36:38", "text": "分？自分が言ったことをループできたらいいのに"}, {"type": "subtitle", "time": 20201.51, "timestamp": "05:36:41", "text": "5分くらい。私"}, {"type": "subtitle", "time": 20209.83, "timestamp": "05:36:49", "text": "はじめまして、モイ、ループできます"}, {"type": "subtitle", "time": 20212.948, "timestamp": "05:36:52", "text": "2分ごとか1分ごとに"}, {"type": "subtitle", "time": 20216.708, "timestamp": "05:36:56", "text": "1分くらいかな。言い続けてください。"}, {"type": "subtitle", "time": 20219.43, "timestamp": "05:36:59", "text": "自力で成功した人とそうでない人の違いは"}]
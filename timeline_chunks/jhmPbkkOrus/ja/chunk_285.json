[{"type": "subtitle", "time": 17106.15, "timestamp": "04:45:06", "text": "そう、アライグマだよ。ええ、それは来るでしょう、"}, {"type": "subtitle", "time": 17117.83, "timestamp": "04:45:17", "text": "はい。私は7歳と0歳です。私はかなり良いです"}, {"type": "subtitle", "time": 17121.27, "timestamp": "04:45:21", "text": "このゲームでだよ、相棒。戻ってきました。はい。"}, {"type": "subtitle", "time": 17123.75, "timestamp": "04:45:23", "text": "ああ、彼が戻ってきた。彼は"}, {"type": "subtitle", "time": 17125.43, "timestamp": "04:45:25", "text": "押し下げられた。"}, {"type": "subtitle", "time": 17129.628, "timestamp": "04:45:29", "text": "ええ、2日間の出場停止処分を受けました。"}, {"type": "subtitle", "time": 17133.27, "timestamp": "04:45:33", "text": "なぜ？理由は？それは私が"}, {"type": "subtitle", "time": 17135.67, "timestamp": "04:45:35", "text": "AFK。"}, {"type": "subtitle", "time": 17138.39, "timestamp": "04:45:38", "text": "はい、そうしました。ええ、あなたは話していましたね。それは"}, {"type": "subtitle", "time": 17141.19, "timestamp": "04:45:41", "text": "モデルが動いていなかったからだよ、兄弟？"}, {"type": "subtitle", "time": 17144.31, "timestamp": "04:45:44", "text": "これらの人々は誰なのか、AIなのか、それとも"}, {"type": "subtitle", "time": 17146.55, "timestamp": "04:45:46", "text": "これは実際のマニュアルですか？"}, {"type": "subtitle", "time": 17149.51, "timestamp": "04:45:49", "text": "私が質問するからでしょうか"}, {"type": "subtitle", "time": 17153.19, "timestamp": "04:45:53", "text": "なんで「いいね」がないの？"}, {"type": "subtitle", "time": 17155.9, "timestamp": "04:45:55", "text": "カスタマーサービスか何かですか？"}, {"type": "subtitle", "time": 17158.15, "timestamp": "04:45:58", "text": "[音楽]"}]
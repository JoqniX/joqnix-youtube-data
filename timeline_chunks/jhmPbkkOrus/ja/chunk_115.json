[{"type": "subtitle", "time": 6909.91, "timestamp": "01:55:09", "text": "真実。ああ、なんてことだ、これを見てください。私"}, {"type": "subtitle", "time": 6928.47, "timestamp": "01:55:28", "text": "この過ちを神に委ねます。旅行ではない。私は"}, {"type": "subtitle", "time": 6930.31, "timestamp": "01:55:30", "text": "勉強のためにそこへ行く。私は"}, {"type": "subtitle", "time": 6934.31, "timestamp": "01:55:34", "text": "私のためにN4からN1まで学ぶ"}, {"type": "subtitle", "time": 6937.27, "timestamp": "01:55:37", "text": "このコースは1年9ヶ月です。それで"}, {"type": "subtitle", "time": 6940.47, "timestamp": "01:55:40", "text": "それは約21ヶ月のコースですね。それから私は"}, {"type": "subtitle", "time": 6942.83, "timestamp": "01:55:42", "text": "MISAを学生に変換する必要があります"}, {"type": "subtitle", "time": 6945.83, "timestamp": "01:55:45", "text": "繰り返しますが、大学ではなく、カレッジに入学してください。"}, {"type": "subtitle", "time": 6947.83, "timestamp": "01:55:47", "text": "あそこに大学がある。だから私はここにいられる"}, {"type": "subtitle", "time": 6950.669, "timestamp": "01:55:50", "text": "良い仕事が見つかるまでそこにいて"}, {"type": "subtitle", "time": 6953.43, "timestamp": "01:55:53", "text": "すべて。私は"}, {"type": "subtitle", "time": 6956.189, "timestamp": "01:55:56", "text": "エンターテインメント業界"}, {"type": "subtitle", "time": 6958.709, "timestamp": "01:55:58", "text": "仕事。エンターテインメント業界の仕事"}]
[{"type": "subtitle", "time": 4262.149, "timestamp": "01:11:02", "text": "それらをどうやって区別すればいいのでしょうか"}, {"type": "subtitle", "time": 4263.31, "timestamp": "01:11:03", "text": "本物"}, {"type": "subtitle", "time": 4265.87, "timestamp": "01:11:05", "text": "人々？どうして私には理解できないのか"}, {"type": "subtitle", "time": 4280.07, "timestamp": "01:11:20", "text": "けれど。ほら、これを見て、これがある"}, {"type": "subtitle", "time": 4281.83, "timestamp": "01:11:21", "text": "参加した人はかなり多かった"}, {"type": "subtitle", "time": 4285.79, "timestamp": "01:11:25", "text": "最近、疑わしい点がある。私が行くと"}, {"type": "subtitle", "time": 4288.83, "timestamp": "01:11:28", "text": "シグナル初期アカウント"}, {"type": "subtitle", "time": 4291.43, "timestamp": "01:11:31", "text": "活動中、ここにはたくさんの人がいます"}, {"type": "subtitle", "time": 4295.59, "timestamp": "01:11:35", "text": "梁から接続されたもの"}, {"type": "subtitle", "time": 4299.229, "timestamp": "01:11:39", "text": "うーん、ビーム。ええ、それはビームから接続されました"}, {"type": "subtitle", "time": 4301.149, "timestamp": "01:11:41", "text": "ピクピク"}, {"type": "subtitle", "time": 4302.99, "timestamp": "01:11:42", "text": "キックして"}, {"type": "subtitle", "time": 4305.91, "timestamp": "01:11:45", "text": "もの。彼らがどんな人かを知るにはどうすればいいですか"}, {"type": "subtitle", "time": 4309.83, "timestamp": "01:11:49", "text": "実在の人物か、それとも架空の人物か？私は自分の"}, {"type": "subtitle", "time": 4312.79, "timestamp": "01:11:52", "text": "最高。サーバーを複雑にして"}, {"type": "subtitle", "time": 4316.47, "timestamp": "01:11:56", "text": "可能。たくさんの代替案を与えた"}]
[{"type": "subtitle", "time": 16441.789, "timestamp": "04:34:01", "text": "それから私は行く"}, {"type": "subtitle", "time": 16444.949, "timestamp": "04:34:04", "text": "また。一方、あなたはこれを見ることができます"}, {"type": "subtitle", "time": 16460.551, "timestamp": "04:34:20", "text": "肌。ずいぶん長い前置きだったな。うん、"}, {"type": "subtitle", "time": 16462.23, "timestamp": "04:34:22", "text": "知らなかったら、それは"}, {"type": "subtitle", "time": 16464.47, "timestamp": "04:34:24", "text": "ドクター・ストレンジ・イン・ザ・マルチバースより"}, {"type": "subtitle", "time": 16466.789, "timestamp": "04:34:26", "text": "狂気の映画。"}, {"type": "subtitle", "time": 16470.429, "timestamp": "04:34:30", "text": "これがエモートです。かわいい"}, {"type": "subtitle", "time": 16473.189, "timestamp": "04:34:33", "text": "感情を表現する。最高のもののひとつと言っておこう"}, {"type": "subtitle", "time": 16476.07, "timestamp": "04:34:36", "text": "名刺。最高の一つ。つまり、"}, {"type": "subtitle", "time": 16478.07, "timestamp": "04:34:38", "text": "名前プレート、それが何であれ。の1つ"}, {"type": "subtitle", "time": 16491.349, "timestamp": "04:34:51", "text": "MVP。それは私よりずっと短い"}, {"type": "subtitle", "time": 16493.51, "timestamp": "04:34:53", "text": "予想通り、ほら、そんな感じ。でもそれはすべて"}, {"type": "subtitle", "time": 16495.99, "timestamp": "04:34:55", "text": "右。大丈夫です。"}, {"type": "subtitle", "time": 16498.07, "timestamp": "04:34:58", "text": "大丈夫です。それから、ああ、もしあなたが"}]
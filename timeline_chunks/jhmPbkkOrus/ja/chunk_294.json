[{"type": "subtitle", "time": 17643.07, "timestamp": "04:54:03", "text": "男の子。そこにいるあの男が私の"}, {"type": "subtitle", "time": 17646.35, "timestamp": "04:54:06", "text": "男の子。神"}, {"type": "subtitle", "time": 17649.59, "timestamp": "04:54:09", "text": "くそ。あなたはこの人間を作ったのですか"}, {"type": "subtitle", "time": 17651.19, "timestamp": "04:54:11", "text": "運動選手？"}, {"type": "subtitle", "time": 17655.35, "timestamp": "04:54:15", "text": "いや、あれはバムか何かだったよ。バン、またはえーと"}, {"type": "subtitle", "time": 17659.51, "timestamp": "04:54:19", "text": "ミム。バン。これは私が描いて監督したものです"}, {"type": "subtitle", "time": 17670.31, "timestamp": "04:54:30", "text": "私にとって大きなもの。うん。ええ、"}, {"type": "subtitle", "time": 17673.35, "timestamp": "04:54:33", "text": "ミミ。それは良かった。それは、それは、"}, {"type": "subtitle", "time": 17675.51, "timestamp": "04:54:35", "text": "ニース。"}, {"type": "subtitle", "time": 17678.31, "timestamp": "04:54:38", "text": "おお、"}, {"type": "subtitle", "time": 17681.99, "timestamp": "04:54:41", "text": "しかし、私も同じ第一印象を持った。"}, {"type": "subtitle", "time": 17683.91, "timestamp": "04:54:43", "text": "ええ、第一印象は"}, {"type": "subtitle", "time": 17686.628, "timestamp": "04:54:46", "text": "いつも混乱するけど、その後"}, {"type": "subtitle", "time": 17688.03, "timestamp": "04:54:48", "text": "あなたはするであろう"}, {"type": "subtitle", "time": 17691.51, "timestamp": "04:54:51", "text": "気づいてください、これは私の"}, {"type": "subtitle", "time": 17696.15, "timestamp": "04:54:56", "text": "男の子。私は何としても彼を守らなければならない。"}, {"type": "subtitle", "time": 17699.03, "timestamp": "04:54:59", "text": "うん。"}]
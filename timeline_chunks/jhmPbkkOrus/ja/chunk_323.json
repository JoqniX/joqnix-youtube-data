[{"type": "subtitle", "time": 19381.27, "timestamp": "05:23:01", "text": "長々と愚痴をこぼしたいところだけど、今日はやめておこう。"}, {"type": "subtitle", "time": 19384.55, "timestamp": "05:23:04", "text": "落ち着くよ。"}, {"type": "subtitle", "time": 19386.948, "timestamp": "05:23:06", "text": "ちなみに、嘘はつきません。その"}, {"type": "subtitle", "time": 19389.23, "timestamp": "05:23:09", "text": "難しい"}, {"type": "subtitle", "time": 19391.99, "timestamp": "05:23:11", "text": "レク。チャットにアクセスするのが難しい。難しい"}, {"type": "subtitle", "time": 19395.788, "timestamp": "05:23:15", "text": "複数のプラットフォームでストリーミング配信を行う際に到達するには"}, {"type": "subtitle", "time": 19398.39, "timestamp": "05:23:18", "text": "プラットフォーム。はい、バグを報告しました"}, {"type": "subtitle", "time": 19401.27, "timestamp": "05:23:21", "text": "ヴァンチャット。ええ、彼らはそれを調査するでしょう"}, {"type": "subtitle", "time": 19403.27, "timestamp": "05:23:23", "text": "まもなく。"}, {"type": "subtitle", "time": 19405.67, "timestamp": "05:23:25", "text": "それは、私が「ほら、君」って感じだった"}, {"type": "subtitle", "time": 19408.23, "timestamp": "05:23:28", "text": "ミームのように、"}, {"type": "subtitle", "time": 19411.83, "timestamp": "05:23:31", "text": "両親にミームを見せて"}, {"type": "subtitle", "time": 19414.47, "timestamp": "05:23:34", "text": "彼らは身を乗り出して目を細めている"}, {"type": "subtitle", "time": 19416.23, "timestamp": "05:23:36", "text": "彼らの目。それが私の仕事です"}, {"type": "subtitle", "time": 19418.39, "timestamp": "05:23:38", "text": "チャットを読んでいるとき、見えないから"}, {"type": "subtitle", "time": 19419.91, "timestamp": "05:23:39", "text": "何でも。"}, {"type": "subtitle", "time": 19422.55, "timestamp": "05:23:42", "text": "このクソじじいさんめ。"}, {"type": "subtitle", "time": 19424.15, "timestamp": "05:23:44", "text": "黙れ、俺の方がお前より若いんだぞ、"}, {"type": "subtitle", "time": 19425.67, "timestamp": "05:23:45", "text": "[ __ ]。"}, {"type": "subtitle", "time": 19427.99, "timestamp": "05:23:47", "text": "どういう意味ですか？"}, {"type": "subtitle", "time": 19430.788, "timestamp": "05:23:50", "text": "うん。わかった。画面を切り替えましたか？"}, {"type": "subtitle", "time": 19432.788, "timestamp": "05:23:52", "text": "だって、私は終わりが好きになるつもりだから。わかった。わかった。"}, {"type": "subtitle", "time": 19436.47, "timestamp": "05:23:56", "text": "ええ、このまま終わらせることもできますよ。"}, {"type": "subtitle", "time": 19438.628, "timestamp": "05:23:58", "text": "それでは、配信を終えます。"}]
[{"type": "subtitle", "time": 22.55, "timestamp": "00:00:22", "text": "もっと。こんにちは、皆さんようこそ"}, {"type": "subtitle", "time": 25.269, "timestamp": "00:00:25", "text": "ジョアトン43日目パート1の配信。良い"}, {"type": "subtitle", "time": 27.589, "timestamp": "00:00:27", "text": "朝。いいえ、こんにちは。私はとても"}, {"type": "subtitle", "time": 29.55, "timestamp": "00:00:29", "text": "遅い。私"}, {"type": "subtitle", "time": 53.67, "timestamp": "00:00:53", "text": "タイトルは毎回更新するかもしれないと思う"}]
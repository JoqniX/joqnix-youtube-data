[{"type": "subtitle", "time": 11762.15, "timestamp": "03:16:02", "text": "こんにちは、アナ。気をつけて。さよなら。わかった。バイバイ。"}, {"type": "subtitle", "time": 11770.469, "timestamp": "03:16:10", "text": "ええと、私があなたの娯楽になります"}, {"type": "subtitle", "time": 11772.429, "timestamp": "03:16:12", "text": "本日は、"}, {"type": "subtitle", "time": 11775.429, "timestamp": "03:16:15", "text": "チャット。戻る。これって単語じゃないですよね？"}, {"type": "subtitle", "time": 11779.349, "timestamp": "03:16:19", "text": "いいえ、できません。いいえ。シンクケア108。"}, {"type": "subtitle", "time": 11784.389, "timestamp": "03:16:24", "text": "私は生きている。ライブ配信中です。私はただ"}, {"type": "subtitle", "time": 11787.11, "timestamp": "03:16:27", "text": "食べながら夢を乗っ取り、"}, {"type": "subtitle", "time": 11788.11, "timestamp": "03:16:28", "text": "少し"}, {"type": "subtitle", "time": 11790.269, "timestamp": "03:16:30", "text": "休む。"}, {"type": "subtitle", "time": 11793.99, "timestamp": "03:16:33", "text": "こんにちは。こんにちは。こんにちは。こんにちは。作戦遂行者。"}, {"type": "subtitle", "time": 11796.15, "timestamp": "03:16:36", "text": "そう、パン。兄弟、手伝ってくれ"}, {"type": "subtitle", "time": 11799.11, "timestamp": "03:16:39", "text": "彼のジレンマについて。彼は現実世界では男らしい人だ。の"}, {"type": "subtitle", "time": 11802.55, "timestamp": "03:16:42", "text": "モデルには性別はありませんが、ジョギングのように"}, {"type": "subtitle", "time": 11804.03, "timestamp": "03:16:44", "text": "ペルソナには"}, {"type": "subtitle", "time": 11811.67, "timestamp": "03:16:51", "text": "うん。さて、試合が始まった。例えば、あなたは"}, {"type": "subtitle", "time": 11813.269, "timestamp": "03:16:53", "text": "みんな、マーベルライバルズのこと知ってる？"}]
[{"type": "subtitle", "time": 19620.55, "timestamp": "05:27:00", "text": "うん。何を手に入れたの？痛みを投げつけろ、だろ？"}, {"type": "subtitle", "time": 19623.99, "timestamp": "05:27:03", "text": "とんでもない病気。何てことだ。 BBL病"}, {"type": "subtitle", "time": 19628.708, "timestamp": "05:27:08", "text": "あるいは、そんな感じ。彼は何を手に入れたの？"}, {"type": "subtitle", "time": 19631.67, "timestamp": "05:27:11", "text": "ああ、ジョックが配信してる。神様ありがとう、あなたは"}, {"type": "subtitle", "time": 19634.07, "timestamp": "05:27:14", "text": "安全。"}, {"type": "subtitle", "time": 19642.07, "timestamp": "05:27:22", "text": "私は、"}, {"type": "subtitle", "time": 19644.31, "timestamp": "05:27:24", "text": "こちらは英国放送システムです。あなた"}, {"type": "subtitle", "time": 19652.548, "timestamp": "05:27:32", "text": "BBCは知っていた。うんうん。うん。私は"}, {"type": "subtitle", "time": 19655.03, "timestamp": "05:27:35", "text": "ああ、君は安全だよ。"}, {"type": "subtitle", "time": 19657.03, "timestamp": "05:27:37", "text": "ええ、私は無事です。私はそれを知っています。うん。うん。"}, {"type": "subtitle", "time": 19659.03, "timestamp": "05:27:39", "text": "もし私があなたを"}, {"type": "subtitle", "time": 19663.03, "timestamp": "05:27:43", "text": "ストリートだよ、兄弟、君は"}, {"type": "subtitle", "time": 19664.628, "timestamp": "05:27:44", "text": "君はスパイダーマンみたいになるよ"}, {"type": "subtitle", "time": 19667.03, "timestamp": "05:27:47", "text": "地図から消える。"}, {"type": "subtitle", "time": 19668.708, "timestamp": "05:27:48", "text": "おお、"}, {"type": "subtitle", "time": 19671.99, "timestamp": "05:27:51", "text": "はい。スイング、アッパーカット、そして"}, {"type": "subtitle", "time": 19674.708, "timestamp": "05:27:54", "text": "相手を倒して、マップから消し去る。うん、"}, {"type": "subtitle", "time": 19676.708, "timestamp": "05:27:56", "text": "簡単。"}, {"type": "subtitle", "time": 19678.39, "timestamp": "05:27:58", "text": "ウェブ撮影も忘れずにいいね！"}]
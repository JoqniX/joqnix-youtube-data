[{"type": "subtitle", "time": 13020.79, "timestamp": "03:37:00", "text": "うん。ほら、私には見えなかった"}, {"type": "subtitle", "time": 13024.79, "timestamp": "03:37:04", "text": "もう一方のメッセージはスパムみたいなものだから"}, {"type": "subtitle", "time": 13027.51, "timestamp": "03:37:07", "text": "あれだよ、わかる？ちょっとひどいね。私"}, {"type": "subtitle", "time": 13046.349, "timestamp": "03:37:26", "text": "シャンカー。待って、待って。だって、だって、だって、私が言う"}, {"type": "subtitle", "time": 13048.67, "timestamp": "03:37:28", "text": "あなた、ああ、"}, {"type": "subtitle", "time": 13051.51, "timestamp": "03:37:31", "text": "うん。はい。待って。はい。はい。はい。はい。私"}, {"type": "subtitle", "time": 13053.83, "timestamp": "03:37:33", "text": "ほら、遊んでいる時でも話せるでしょ"}, {"type": "subtitle", "time": 13055.59, "timestamp": "03:37:35", "text": "戦車か何かみたいだけど、私が"}, {"type": "subtitle", "time": 13058.63, "timestamp": "03:37:38", "text": "ヒーラー役なので、話すことはできません。"}, {"type": "subtitle", "time": 13061.389, "timestamp": "03:37:41", "text": "ああ、敵にパンがある"}, {"type": "subtitle", "time": 13063.87, "timestamp": "03:37:43", "text": "チーム。何"}, {"type": "subtitle", "time": 13067.03, "timestamp": "03:37:47", "text": "くそ？一体どういうことだ？パンが置いてあります"}, {"type": "subtitle", "time": 13068.349, "timestamp": "03:37:48", "text": "敵"}, {"type": "subtitle", "time": 13070.03, "timestamp": "03:37:50", "text": "チーム。"}, {"type": "subtitle", "time": 13072.349, "timestamp": "03:37:52", "text": "うわあ、それは"}, {"type": "subtitle", "time": 13075.99, "timestamp": "03:37:55", "text": "ニース。兄さん、それは私の別アカウントですか？"}, {"type": "subtitle", "time": 13079.07, "timestamp": "03:37:59", "text": "アカウント？私が私に逆らう？なぜ"}]
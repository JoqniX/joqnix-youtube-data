[{"type": "subtitle", "time": 20820.788, "timestamp": "05:47:00", "text": "ここにいることが私の夢なんです。欲しい"}, {"type": "subtitle", "time": 20822.11, "timestamp": "05:47:02", "text": "に"}, {"type": "subtitle", "time": 20826.628, "timestamp": "05:47:06", "text": "ここでは実際に一生懸命働いています。ほら、私は"}, {"type": "subtitle", "time": 20828.35, "timestamp": "05:47:08", "text": "ベストを尽くしたい"}, {"type": "subtitle", "time": 20835.708, "timestamp": "05:47:15", "text": "ここ。それが私が"}, {"type": "subtitle", "time": 20859.59, "timestamp": "05:47:39", "text": "あ、チャットでメッセージを入力できますか？私は"}, {"type": "subtitle", "time": 20864.548, "timestamp": "05:47:44", "text": "使おうとしている、手に入れようとしている"}, {"type": "subtitle", "time": 20867.99, "timestamp": "05:47:47", "text": "ビリー・ビリーからのチャット"}, {"type": "subtitle", "time": 20870.51, "timestamp": "05:47:50", "text": "えっと、私の"}]
[{"type": "subtitle", "time": 6012.35, "timestamp": "01:40:12", "text": "Sh。何てことだ。いいえ、私は受け取ります"}, {"type": "subtitle", "time": 6015.35, "timestamp": "01:40:15", "text": "Pythonを追加しましたか？私はすでに"}, {"type": "subtitle", "time": 6017.629, "timestamp": "01:40:17", "text": "それをクリックしました。それはそうあるべきだ"}, {"type": "subtitle", "time": 6043.91, "timestamp": "01:40:43", "text": "これは何ですか？私は持っていません"}, {"type": "subtitle", "time": 6047.03, "timestamp": "01:40:47", "text": "まだ昼食の時間だ。昼食を食べに行かなければならない。私"}, {"type": "subtitle", "time": 6050.229, "timestamp": "01:40:50", "text": "ブラッドに私の配信を引き継いでもらうつもりです"}, {"type": "subtitle", "time": 6053.99, "timestamp": "01:40:53", "text": "そして、皆さんのためにマーベル・ライバルズをストリーミング配信します。"}, {"type": "subtitle", "time": 6056.31, "timestamp": "01:40:56", "text": "少し休んでから来ます"}, {"type": "chat", "time": 6058.188, "timestamp": "01:40:58", "author": "@KosmikZethar", "avatar": "https://yt4.ggpht.com/b_m56i87DkQCWoSLK8J6eGPlt0w4dJQYTlT9PaGPCOWZzEZaUiSe6Q-t3xsz9BESFJqhLP1oHg=s64-c-k-c0x00ffffff-no-rj", "message": "Have u added python's path to system variables???"}]
[{"type": "subtitle", "time": 19988.75, "timestamp": "05:33:08", "text": "[音楽]"}, {"type": "subtitle", "time": 19990.75, "timestamp": "05:33:10", "text": "混乱した。これは"}, {"type": "subtitle", "time": 19992.67, "timestamp": "05:33:12", "text": "それで"}, {"type": "subtitle", "time": 19995.27, "timestamp": "05:33:15", "text": "どうやら。ええ、私もそう思います。待って、君"}, {"type": "subtitle", "time": 20016.948, "timestamp": "05:33:36", "text": "また。ライブ配信を再開しました。話をする必要がある"}, {"type": "subtitle", "time": 20017.708, "timestamp": "05:33:37", "text": "について"}, {"type": "subtitle", "time": 20020.788, "timestamp": "05:33:40", "text": "これ。みんなが参加するのを待ちます"}, {"type": "subtitle", "time": 20021.628, "timestamp": "05:33:41", "text": "から"}, {"type": "subtitle", "time": 20024.23, "timestamp": "05:33:44", "text": "ベルはQで話していた"}, {"type": "subtitle", "time": 20026.948, "timestamp": "05:33:46", "text": "それについて話し合うグループを作る。深い"}, {"type": "subtitle", "time": 20030.39, "timestamp": "05:33:50", "text": "これについて話し合いましょう、兄弟。なあ、兄弟、"}, {"type": "subtitle", "time": 20032.948, "timestamp": "05:33:52", "text": "一体どういうことだ？"}, {"type": "subtitle", "time": 20036.03, "timestamp": "05:33:56", "text": "一体何なんだよ？なぜ"}, {"type": "subtitle", "time": 20037.948, "timestamp": "05:33:57", "text": "えっ？なぜ"}]
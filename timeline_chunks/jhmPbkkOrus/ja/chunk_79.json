[{"type": "subtitle", "time": 4740.31, "timestamp": "01:19:00", "text": "えっと、そういうのは知らないんだけど"}, {"type": "subtitle", "time": 4742.31, "timestamp": "01:19:02", "text": "アカウントシステムのようなものではありませんが、"}, {"type": "subtitle", "time": 4745.99, "timestamp": "01:19:05", "text": "えっと、私が言いたいのは、なぜ、なぜ"}, {"type": "subtitle", "time": 4757.79, "timestamp": "01:19:17", "text": "それ。誰が"}, {"type": "subtitle", "time": 4766.43, "timestamp": "01:19:26", "text": "彼？どこ"}, {"type": "subtitle", "time": 4770.27, "timestamp": "01:19:30", "text": "俺の兄弟？私のテスターはどこにいますか"}, {"type": "subtitle", "time": 4773.59, "timestamp": "01:19:33", "text": "サーバ？彼はどこにいますか？私は言ったことを覚えている"}, {"type": "subtitle", "time": 4776.709, "timestamp": "01:19:36", "text": "この人と私がやりたかったこと"}, {"type": "subtitle", "time": 4779.31, "timestamp": "01:19:39", "text": "これ"}, {"type": "subtitle", "time": 4783.44, "timestamp": "01:19:43", "text": "えーと、ログインダッシュボードとか"}, {"type": "subtitle", "time": 4784.669, "timestamp": "01:19:44", "text": "[音楽]"}]
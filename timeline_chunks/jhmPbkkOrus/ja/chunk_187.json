[{"type": "subtitle", "time": 11223.03, "timestamp": "03:07:03", "text": "奇妙なこと。そして"}, {"type": "subtitle", "time": 11225.349, "timestamp": "03:07:05", "text": "あなたは混乱していると思います。今"}, {"type": "subtitle", "time": 11227.349, "timestamp": "03:07:07", "text": "うまくいってるよね？だって君の声が聞こえたから"}, {"type": "subtitle", "time": 11229.19, "timestamp": "03:07:09", "text": "「ああ、うまくいってる！」と言いましょう。私は聞いた"}, {"type": "subtitle", "time": 11230.63, "timestamp": "03:07:10", "text": "そう言うのは君だ。 「わかった」って感じだった。うん、そうだね"}, {"type": "subtitle", "time": 11234.87, "timestamp": "03:07:14", "text": "は。ああ、やっとだ。ああ、なんてこった。私"}, {"type": "subtitle", "time": 11236.349, "timestamp": "03:07:16", "text": "枝分かれも"}, {"type": "subtitle", "time": 11239.67, "timestamp": "03:07:19", "text": "多くの。くそ。"}, {"type": "subtitle", "time": 11252.07, "timestamp": "03:07:32", "text": "くそ？とにかく、今すぐご飯を食べに行きなさい。出て行く"}, {"type": "subtitle", "time": 11254.469, "timestamp": "03:07:34", "text": "ここ。なんてこった。こんにちは。こんにちは。こんにちは。やってください"}, {"type": "subtitle", "time": 11257.19, "timestamp": "03:07:37", "text": "ストリームのやつ、これを設定できるように"}, {"type": "subtitle", "time": 11260.03, "timestamp": "03:07:40", "text": "そうそう。それを忘れていました。"}, {"type": "subtitle", "time": 11263.03, "timestamp": "03:07:43", "text": "忍者は私だけなのか？大丈夫です。その"}, {"type": "subtitle", "time": 11266.71, "timestamp": "03:07:46", "text": "大丈夫。彼は男だ。彼は男だ。その"}, {"type": "subtitle", "time": 11270.59, "timestamp": "03:07:50", "text": "わかった。つまり、彼は私のことを何と呼んでも構わないんだけど。"}, {"type": "subtitle", "time": 11273.19, "timestamp": "03:07:53", "text": "私は相関関係のようなものなので、性別"}, {"type": "subtitle", "time": 11275.11, "timestamp": "03:07:55", "text": "私には当てはまらないと思う。私はしません"}, {"type": "subtitle", "time": 11277.11, "timestamp": "03:07:57", "text": "知る。"}]
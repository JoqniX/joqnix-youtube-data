[{"type": "subtitle", "time": 18541.35, "timestamp": "05:09:01", "text": "いらっしゃいませ。お父さん、リラックスしてくれてありがとう。おお"}, {"type": "subtitle", "time": 18554.15, "timestamp": "05:09:14", "text": "パンだけが演奏している。私は、"}, {"type": "subtitle", "time": 18556.47, "timestamp": "05:09:16", "text": "ジョックがプレーしている。いや、いや、いや、いや、いや。"}, {"type": "subtitle", "time": 18558.47, "timestamp": "05:09:18", "text": "残念ながら、彼はそうではない。"}, {"type": "subtitle", "time": 18560.868, "timestamp": "05:09:20", "text": "いいえ、"}, {"type": "subtitle", "time": 18562.948, "timestamp": "05:09:22", "text": "つまり、アップデート後には実際にはもっと"}, {"type": "subtitle", "time": 18565.51, "timestamp": "05:09:25", "text": "最適化されていると思います。だから、私にはわからない。"}, {"type": "subtitle", "time": 18568.788, "timestamp": "05:09:28", "text": "私のPCは今では問題なく処理できます。私"}, {"type": "subtitle", "time": 18572.47, "timestamp": "05:09:32", "text": "私のモデルで遊ぶこともできます。"}, {"type": "subtitle", "time": 18574.23, "timestamp": "05:09:34", "text": "あなたは誰ですか？"}, {"type": "subtitle", "time": 18577.27, "timestamp": "05:09:37", "text": "私のモデルでは、以前と同じように"}, {"type": "subtitle", "time": 18579.27, "timestamp": "05:09:39", "text": "アップデート。ああ、あなたのモデルで。私は思った"}, {"type": "subtitle", "time": 18583.91, "timestamp": "05:09:43", "text": "私のMODを使用。なんてこった。私は男性を持っていません、"}, {"type": "subtitle", "time": 18586.19, "timestamp": "05:09:46", "text": "このプラットフォームはとても"}, {"type": "subtitle", "time": 18588.948, "timestamp": "05:09:48", "text": "痛み。文字通り2日間"}, {"type": "subtitle", "time": 18597.99, "timestamp": "05:09:57", "text": "Redが今ストリーミング配信していたからそう思う。そして"}]
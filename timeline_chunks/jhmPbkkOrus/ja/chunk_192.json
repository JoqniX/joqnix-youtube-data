[{"type": "subtitle", "time": 11521.11, "timestamp": "03:12:01", "text": "30分ほど。 1時間以上と"}, {"type": "subtitle", "time": 11524.389, "timestamp": "03:12:04", "text": "半分。そうかもしれない。うん。あなたが"}, {"type": "subtitle", "time": 11527.03, "timestamp": "03:12:07", "text": "欲しい。それはいいです。もう放っておいてくれ。として"}, {"type": "subtitle", "time": 11529.67, "timestamp": "03:12:09", "text": "私が望む限り。"}, {"type": "subtitle", "time": 11531.07, "timestamp": "03:12:11", "text": "しなければならないときは"}, {"type": "subtitle", "time": 11535.15, "timestamp": "03:12:15", "text": "離れる。私はここに残ります"}, {"type": "subtitle", "time": 11554.23, "timestamp": "03:12:34", "text": "わかった。ストリームは一時停止していますか？"}, {"type": "subtitle", "time": 11557.59, "timestamp": "03:12:37", "text": "配信は良好です。わかった。"}, {"type": "subtitle", "time": 11559.83, "timestamp": "03:12:39", "text": "東京はこれまでずっと私を騙し続けていた。あなたは何を"}, {"type": "subtitle", "time": 11562.469, "timestamp": "03:12:42", "text": "つまり、私はバカってこと？だから、私が言ったように、いいえ、"}, {"type": "subtitle", "time": 11564.99, "timestamp": "03:12:44", "text": "Jog はあなたが望むものなら何でもできます"}, {"type": "subtitle", "time": 11567.91, "timestamp": "03:12:47", "text": "だって、彼は自分が"}, {"type": "subtitle", "time": 11576.469, "timestamp": "03:12:56", "text": "ジョックの次は星座だ。ただ"}]
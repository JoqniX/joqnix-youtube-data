[{"type": "subtitle", "time": 17223.35, "timestamp": "04:47:03", "text": "今はまるで汗をかいているような感じです。知っている"}, {"type": "subtitle", "time": 17224.99, "timestamp": "04:47:04", "text": "2日間のことは"}, {"type": "subtitle", "time": 17227.43, "timestamp": "04:47:07", "text": "二人で楽しむためのおすすめ商品"}, {"type": "subtitle", "time": 17230.708, "timestamp": "04:47:10", "text": "日。私は誰にも推薦されないでしょう。"}, {"type": "subtitle", "time": 17250.31, "timestamp": "04:47:30", "text": "わかった。わかった。わかった。これは良くない。これ"}, {"type": "subtitle", "time": 17253.75, "timestamp": "04:47:33", "text": "それは良くない。何てことだ。ごめんなさい、"}, {"type": "subtitle", "time": 17263.99, "timestamp": "04:47:43", "text": "もっとダメージを与えるべきでしょうか？"}, {"type": "subtitle", "time": 17265.75, "timestamp": "04:47:45", "text": "これをプレイすればするほど、もっと"}, {"type": "subtitle", "time": 17268.07, "timestamp": "04:47:48", "text": "プレイするためにも。でも痛みで、演奏できない"}, {"type": "subtitle", "time": 17272.39, "timestamp": "04:47:52", "text": "あのゲーム。このゲーム。大丈夫です。"}, {"type": "subtitle", "time": 17274.23, "timestamp": "04:47:54", "text": "日本に行くとき、良い"}, {"type": "subtitle", "time": 17278.47, "timestamp": "04:47:58", "text": "PCでプレイするよ、私は"}]
[{"type": "subtitle", "time": 16681.91, "timestamp": "04:38:01", "text": "この名簿に入るには、どれが"}, {"type": "subtitle", "time": 16685.67, "timestamp": "04:38:05", "text": "なれ？デッドプールとは言わないでください。お願いします、"}, {"type": "subtitle", "time": 16692.189, "timestamp": "04:38:12", "text": "デッドプール。"}, {"type": "subtitle", "time": 16694.949, "timestamp": "04:38:14", "text": "お願いします。あなたはしばらくの間、席を外していました。ああ、やめて"}, {"type": "subtitle", "time": 16697.349, "timestamp": "04:38:17", "text": "頻繁に席を外してしまうことを心配する。あなたはそうしなかった"}, {"type": "subtitle", "time": 16700.07, "timestamp": "04:38:20", "text": "何か見逃したことはない。私はただ待っていました"}, {"type": "subtitle", "time": 16704.31, "timestamp": "04:38:24", "text": "ジョックの返答について。それは"}, {"type": "subtitle", "time": 16705.83, "timestamp": "04:38:25", "text": "唯一のこと。あのね？良い"}, {"type": "subtitle", "time": 16707.51, "timestamp": "04:38:27", "text": "ジョーが来るまで、あと1試合やろう。"}, {"type": "subtitle", "time": 16708.59, "timestamp": "04:38:28", "text": "時間がかかるだろう"}, {"type": "subtitle", "time": 16711.99, "timestamp": "04:38:31", "text": "その間。時間がかかるだろう。はい。私は"}, {"type": "subtitle", "time": 16714.269, "timestamp": "04:38:34", "text": "ただ質問しているだけです"}, {"type": "subtitle", "time": 16722.75, "timestamp": "04:38:42", "text": "選ぶ。セントリーはそこにいますか？"}, {"type": "subtitle", "time": 16726.47, "timestamp": "04:38:46", "text": "いいえ。しかし、セントリーが見ています。 Doが好きですか？"}, {"type": "subtitle", "time": 16728.269, "timestamp": "04:38:48", "text": "あなたはアダムが好きですか？"}, {"type": "subtitle", "time": 16731.51, "timestamp": "04:38:51", "text": "ウォーロック？彼は親切で、セントリーに似ている。"}, {"type": "subtitle", "time": 16733.75, "timestamp": "04:38:53", "text": "まあ、だいたい合ってるよ。彼はよく見ている"}]
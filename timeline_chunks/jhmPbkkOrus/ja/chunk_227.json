[{"type": "subtitle", "time": 13623.11, "timestamp": "03:47:03", "text": "わかった。ペニーはあそこにいます。わかった。彼女は"}, {"type": "subtitle", "time": 13624.71, "timestamp": "03:47:04", "text": "まるで空を飛んでいるかのようだ。ああ、彼女は"}, {"type": "subtitle", "time": 13627.429, "timestamp": "03:47:07", "text": "死んだ。"}, {"type": "subtitle", "time": 13629.91, "timestamp": "03:47:09", "text": "彼らはおそらくtpingを使っているのだろう。この場所は"}, {"type": "subtitle", "time": 13632.79, "timestamp": "03:47:12", "text": "破壊されることを切望している。"}, {"type": "subtitle", "time": 13635.269, "timestamp": "03:47:15", "text": "おそらくトイレに行くでしょう。ほぼ間違いないと思います。"}, {"type": "subtitle", "time": 13645.83, "timestamp": "03:47:25", "text": "敵を待ち伏せしよう"}]
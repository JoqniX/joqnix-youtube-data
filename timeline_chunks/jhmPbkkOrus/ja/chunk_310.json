[{"type": "subtitle", "time": 18601.59, "timestamp": "05:10:01", "text": "えっと、私のお腹はどこ？私はモデルを持っていた"}, {"type": "subtitle", "time": 18603.99, "timestamp": "05:10:03", "text": "まるで固まった状態のように、私の"}, {"type": "subtitle", "time": 18606.628, "timestamp": "05:10:06", "text": "目と、PNGのようなもの。"}, {"type": "subtitle", "time": 18609.35, "timestamp": "05:10:09", "text": "いいえ、大丈夫だと思っていました。しかし"}, {"type": "subtitle", "time": 18611.59, "timestamp": "05:10:11", "text": "どうやらそれは良くないことらしい。"}, {"type": "subtitle", "time": 18613.99, "timestamp": "05:10:13", "text": "そして私はQQグループの何人かの人に尋ねました"}, {"type": "subtitle", "time": 18616.708, "timestamp": "05:10:16", "text": "そして彼らは信じられるような提供を"}, {"type": "subtitle", "time": 18619.51, "timestamp": "05:10:19", "text": "無料モデル100以上"}, {"type": "subtitle", "time": 18622.788, "timestamp": "05:10:22", "text": "これをしたい人のためのプラットフォーム"}, {"type": "subtitle", "time": 18625.27, "timestamp": "05:10:25", "text": "そして彼らは無料の"}, {"type": "subtitle", "time": 18627.11, "timestamp": "05:10:27", "text": "モデルとストリーム上のモデルを再生"}, {"type": "subtitle", "time": 18629.59, "timestamp": "05:10:29", "text": "ゲームも何もかも。動いていない場合"}, {"type": "subtitle", "time": 18632.31, "timestamp": "05:10:32", "text": "するとそれはAFKや"}, {"type": "subtitle", "time": 18634.628, "timestamp": "05:10:34", "text": "何か。 AFKの場合は、"}, {"type": "subtitle", "time": 18637.35, "timestamp": "05:10:37", "text": "画面上の何か"}, {"type": "subtitle", "time": 18640.47, "timestamp": "05:10:40", "text": "壊れたとか、何かあったのかも。ああ、つまり、あなたは"}, {"type": "subtitle", "time": 18644.628, "timestamp": "05:10:44", "text": "そこはそうですね。わかった。なぜこれが"}, {"type": "subtitle", "time": 18646.868, "timestamp": "05:10:46", "text": "プラットフォーム？"}, {"type": "subtitle", "time": 18649.59, "timestamp": "05:10:49", "text": "今の見た？待って、"}, {"type": "subtitle", "time": 18653.19, "timestamp": "05:10:53", "text": "罰則？えーっと、ストリーミング配信できるんです"}, {"type": "subtitle", "time": 18655.708, "timestamp": "05:10:55", "text": "今でも。むしろ私は手に入れられないだろう"}, {"type": "subtitle", "time": 18658.628, "timestamp": "05:10:58", "text": "他の人には2日間の滞在をおすすめします。おお。"}]
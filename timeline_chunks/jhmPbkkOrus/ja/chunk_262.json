[{"type": "subtitle", "time": 15723.189, "timestamp": "04:22:03", "text": "これ以上はすべきではなかった"}, {"type": "subtitle", "time": 15725.79, "timestamp": "04:22:05", "text": "たいまつにたどり着く。あなたは手助けが得意です。"}, {"type": "subtitle", "time": 15741.51, "timestamp": "04:22:21", "text": "ほら、俺の方がこいつらより死亡者数が少ないだろ。"}, {"type": "subtitle", "time": 15744.229, "timestamp": "04:22:24", "text": "なぜなら"}, {"type": "subtitle", "time": 15748.55, "timestamp": "04:22:28", "text": "アスガルドだけでなく、すべての兄弟たちよ、"}, {"type": "subtitle", "time": 15757.67, "timestamp": "04:22:37", "text": "30秒。攻撃する前に、"}, {"type": "subtitle", "time": 15763.269, "timestamp": "04:22:43", "text": "私の得意分野はご存知でしょう、"}, {"type": "subtitle", "time": 15765.83, "timestamp": "04:22:45", "text": "君のあのハンマーみたいにね。ミールは"}, {"type": "subtitle", "time": 15768.229, "timestamp": "04:22:48", "text": "撃たない"}, {"type": "subtitle", "time": 15770.389, "timestamp": "04:22:50", "text": "偉大なる宇宙の制約されない力"}, {"type": "subtitle", "time": 15773.75, "timestamp": "04:22:53", "text": "母親たち。つまり、あなたは"}, {"type": "subtitle", "time": 15776.55, "timestamp": "04:22:56", "text": "これを訓練する。想像を絶する"}, {"type": "subtitle", "time": 15779.189, "timestamp": "04:22:59", "text": "夢の。星々の主。戦闘開始"}]
[{"type": "subtitle", "time": 11820.07, "timestamp": "03:17:00", "text": "私のアル。ああ、くそ。私は設定しなかった"}, {"type": "subtitle", "time": 11832.229, "timestamp": "03:17:12", "text": "あなたは今日、どちらになりたいと思いますか？"}, {"type": "subtitle", "time": 11834.469, "timestamp": "03:17:14", "text": "おやおや。えっと、ただ置くだけです"}, {"type": "subtitle", "time": 11837.55, "timestamp": "03:17:17", "text": "音量を少し上げます"}, {"type": "subtitle", "time": 11845.19, "timestamp": "03:17:25", "text": "今。でも、やりすぎは禁物です。だから、私は"}, {"type": "subtitle", "time": 11848.469, "timestamp": "03:17:28", "text": "俺の考えを聞いてくれよ。スパイディ。"}, {"type": "subtitle", "time": 11851.75, "timestamp": "03:17:31", "text": "ええ、事実として、人々は好きではありません"}, {"type": "subtitle", "time": 11854.71, "timestamp": "03:17:34", "text": "このゲームにはスパイダーマンが登場します。たとえあなたが"}, {"type": "subtitle", "time": 11858.07, "timestamp": "03:17:38", "text": "このゲームをプレイしたことがある、これらすべて"}, {"type": "subtitle", "time": 11859.269, "timestamp": "03:17:39", "text": "時間。ああ、気にしないでください。彼"}, {"type": "subtitle", "time": 11862.229, "timestamp": "03:17:42", "text": "気にしない。それは、"}, {"type": "subtitle", "time": 11863.99, "timestamp": "03:17:43", "text": "いつ頃のことですか？いつものように"}, {"type": "subtitle", "time": 11864.99, "timestamp": "03:17:44", "text": "時間"}]
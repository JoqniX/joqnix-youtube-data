[{"type": "subtitle", "time": 11045.269, "timestamp": "03:04:05", "text": "何てことだ。何をしていたの？"}, {"type": "subtitle", "time": 11054.63, "timestamp": "03:04:14", "text": "そして私は家事を全部済ませて、"}, {"type": "subtitle", "time": 11056.309, "timestamp": "03:04:16", "text": "戻ってきて、彼はまだ"}, {"type": "subtitle", "time": 11057.67, "timestamp": "03:04:17", "text": "ストリーム。一体どういうことだ？彼はまだ"}, {"type": "subtitle", "time": 11060.429, "timestamp": "03:04:20", "text": "コーディング。ああ、わかりました。何かに似ているに違いない"}, {"type": "subtitle", "time": 11062.63, "timestamp": "03:04:22", "text": "重要。きっと彼は"}, {"type": "subtitle", "time": 11064.87, "timestamp": "03:04:24", "text": "新しいウェブサイトを作成するようなものです。彼は"}, {"type": "subtitle", "time": 11075.91, "timestamp": "03:04:35", "text": "時間。一体どういうこと？つまり、私は私は"}, {"type": "subtitle", "time": 11078.389, "timestamp": "03:04:38", "text": "最近、夜眠れなくなってしまった。全て"}, {"type": "subtitle", "time": 11080.55, "timestamp": "03:04:40", "text": "ちょっと変なことを考えている"}, {"type": "subtitle", "time": 11084.07, "timestamp": "03:04:44", "text": "理由。わからない"}, {"type": "subtitle", "time": 11090.95, "timestamp": "03:04:50", "text": "これ。何てことだ。私は「ああ、ジョー」と思った。"}, {"type": "subtitle", "time": 11092.55, "timestamp": "03:04:52", "text": "ストリームに来るように言われた"}, {"type": "subtitle", "time": 11094.95, "timestamp": "03:04:54", "text": "「取って。」私は「ああ、わかった。」私はただ"}, {"type": "subtitle", "time": 11097.51, "timestamp": "03:04:57", "text": "「来て。」私は彼が"}, {"type": "subtitle", "time": 11099.51, "timestamp": "03:04:59", "text": "「ああ、私は"}]
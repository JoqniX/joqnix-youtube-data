[{"type": "subtitle", "time": 20466.11, "timestamp": "05:41:06", "text": "夕方。 W"}, {"type": "subtitle", "time": 20469.548, "timestamp": "05:41:09", "text": "シャンハ。私は住んでいます"}, {"type": "subtitle", "time": 20472.83, "timestamp": "05:41:12", "text": "生きる前に"}, {"type": "subtitle", "time": 20476.83, "timestamp": "05:41:16", "text": "その前に私は休憩を取った。"}, {"type": "subtitle", "time": 20489.07, "timestamp": "05:41:29", "text": "何？それから私は休憩した"}, {"type": "subtitle", "time": 20491.35, "timestamp": "05:41:31", "text": "罰せられた。ああ、"}, {"type": "subtitle", "time": 20494.39, "timestamp": "05:41:34", "text": "中国語。私は翻訳できます。心配ない。"}, {"type": "subtitle", "time": 20496.19, "timestamp": "05:41:36", "text": "記入する"}, {"type": "subtitle", "time": 20498.51, "timestamp": "05:41:38", "text": "中国語。しないで"}, {"type": "subtitle", "time": 20501.83, "timestamp": "05:41:41", "text": "心配。だって、すごく悲しいんだもん。どうやって"}, {"type": "subtitle", "time": 20504.59, "timestamp": "05:41:44", "text": "私が区別するのは"}]
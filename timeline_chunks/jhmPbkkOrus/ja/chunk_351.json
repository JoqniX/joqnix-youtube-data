[{"type": "subtitle", "time": 21060.99, "timestamp": "05:51:00", "text": "またはTwitchのチャットで。"}, {"type": "subtitle", "time": 21063.628, "timestamp": "05:51:03", "text": "ああ、私の"}, {"type": "subtitle", "time": 21067.31, "timestamp": "05:51:07", "text": "ああ、彼らは最高だ"}, {"type": "subtitle", "time": 21069.83, "timestamp": "05:51:09", "text": "厳しい。ああ、"}, {"type": "subtitle", "time": 21073.19, "timestamp": "05:51:13", "text": "そして、自分の振る舞いには気をつけなければならない。"}, {"type": "subtitle", "time": 21077.31, "timestamp": "05:51:17", "text": "配信中。私は自分の"}, {"type": "subtitle", "time": 21079.91, "timestamp": "05:51:19", "text": "プラットフォームに対する不満"}, {"type": "subtitle", "time": 21082.948, "timestamp": "05:51:22", "text": "これ。管理者が理解できるなら"}, {"type": "subtitle", "time": 21085.788, "timestamp": "05:51:25", "text": "英語、それから私は"}, {"type": "subtitle", "time": 21097.628, "timestamp": "05:51:37", "text": "[音楽]"}, {"type": "subtitle", "time": 21099.47, "timestamp": "05:51:39", "text": "もっと"}, {"type": "subtitle", "time": 21102.87, "timestamp": "05:51:42", "text": "痛みがさらに増す"}]
[{"type": "subtitle", "time": 12441.11, "timestamp": "03:27:21", "text": "それはめちゃくちゃ痛い。"}, {"type": "subtitle", "time": 12447.83, "timestamp": "03:27:27", "text": "心配ない。全員を生かしておけ"}, {"type": "subtitle", "time": 12455.83, "timestamp": "03:27:35", "text": "わかった。わかった。わかった。わかった。うん。我々はできる"}, {"type": "subtitle", "time": 12471.59, "timestamp": "03:27:51", "text": "なんてこった。いや、つまり彼らは"}, {"type": "subtitle", "time": 12473.349, "timestamp": "03:27:53", "text": "彼らは自分の役割を知らないし、ただ"}, {"type": "subtitle", "time": 12474.91, "timestamp": "03:27:54", "text": "狂乱状態。"}, {"type": "subtitle", "time": 12479.429, "timestamp": "03:27:59", "text": "まあ、本当に良いマーベル作品として"}]
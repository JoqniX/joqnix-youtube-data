[{"type": "subtitle", "time": 11101.15, "timestamp": "03:05:01", "text": "戻ってきたら"}, {"type": "subtitle", "time": 11103.429, "timestamp": "03:05:03", "text": "10時30分。「ああ、それは素晴らしい」と私は思った。"}, {"type": "subtitle", "time": 11107.349, "timestamp": "03:05:07", "text": "それは、えっと、7か7か6みたいな感じ"}, {"type": "subtitle", "time": 11110.469, "timestamp": "03:05:10", "text": "私の時間。私は次のようなものを見ることができます"}, {"type": "subtitle", "time": 11113.23, "timestamp": "03:05:13", "text": "見てて。彼は2のためにそこにいない"}, {"type": "subtitle", "time": 11116.389, "timestamp": "03:05:16", "text": "時間。でも、私は寝てしまった。"}, {"type": "subtitle", "time": 11119.19, "timestamp": "03:05:19", "text": "彼は何時頃戻ってくるのか"}, {"type": "subtitle", "time": 11121.269, "timestamp": "03:05:21", "text": "彼は戻ってきたのか？私は見もしなかった"}, {"type": "subtitle", "time": 11123.429, "timestamp": "03:05:23", "text": "12時30分。"}, {"type": "subtitle", "time": 11130.95, "timestamp": "03:05:30", "text": "そして彼は「ああ、できるよ」と言う"}, {"type": "subtitle", "time": 11132.79, "timestamp": "03:05:32", "text": "「こっちに来て」って言われたんだけど、「あ、来ないで」って感じだった。"}, {"type": "subtitle", "time": 11134.389, "timestamp": "03:05:34", "text": "ストリームが好きになりたい、チャットと話したい、または"}, {"type": "subtitle", "time": 11135.349, "timestamp": "03:05:35", "text": "「何か？」私は「ああ、そうだね、"}, {"type": "subtitle", "time": 11137.95, "timestamp": "03:05:37", "text": "「そうして」って言われたら、「ああ、そうだね」って答えた。"}, {"type": "subtitle", "time": 11141.51, "timestamp": "03:05:41", "text": "素晴らしい。」そして私は、"}, {"type": "subtitle", "time": 11145.349, "timestamp": "03:05:45", "text": "「ああ、ずっと歳をとってきたな。」"}, {"type": "subtitle", "time": 11154.55, "timestamp": "03:05:54", "text": "うん。うん。うん。そう、君は"}, {"type": "subtitle", "time": 11156.23, "timestamp": "03:05:56", "text": "叱られるだろう。あなたはそれを知っています。あなた"}, {"type": "subtitle", "time": 11159.55, "timestamp": "03:05:59", "text": "知ってたよね？はい。"}]
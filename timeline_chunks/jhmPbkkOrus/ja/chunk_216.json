[{"type": "subtitle", "time": 12963.11, "timestamp": "03:36:03", "text": "切断された頭の中に生きているような感覚？私は手に入れた"}, {"type": "subtitle", "time": 12964.309, "timestamp": "03:36:04", "text": "お前が何を言ってるのか全く分からない"}, {"type": "subtitle", "time": 12966.229, "timestamp": "03:36:06", "text": "犬について。"}, {"type": "subtitle", "time": 12969.79, "timestamp": "03:36:09", "text": "ああ、GGだ、みんな。"}, {"type": "subtitle", "time": 12972.55, "timestamp": "03:36:12", "text": "GG。 GG、みんな。"}, {"type": "subtitle", "time": 12978.229, "timestamp": "03:36:18", "text": "私は32アシストを記録しました。一体どういうことだ？私"}, {"type": "subtitle", "time": 12993.67, "timestamp": "03:36:33", "text": "21,000の回復量。私は下手なヒーラーだった。"}, {"type": "subtitle", "time": 12995.349, "timestamp": "03:36:35", "text": "彼には大きなものを与えるべきだった。私は"}, {"type": "subtitle", "time": 12996.99, "timestamp": "03:36:36", "text": "ひどいヒーラー、"}, {"type": "subtitle", "time": 13002.15, "timestamp": "03:36:42", "text": "男。私はお尻の治療師です。ピンク色のものが多い。"}, {"type": "subtitle", "time": 13010.469, "timestamp": "03:36:50", "text": "ヒーリング。どこからともなく現れた君がそれを掴んだ。おお。"}, {"type": "subtitle", "time": 13013.19, "timestamp": "03:36:53", "text": "なんてこった。わかった。わかった。種"}, {"type": "subtitle", "time": 13016.309, "timestamp": "03:36:56", "text": "どこからともなく頭がやってくる。"}, {"type": "subtitle", "time": 13018.71, "timestamp": "03:36:58", "text": "うん。ああ、なるほど。わかった。うん。"}]
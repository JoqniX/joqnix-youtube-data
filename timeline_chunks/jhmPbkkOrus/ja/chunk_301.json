[{"type": "subtitle", "time": 18061.59, "timestamp": "05:01:01", "text": "遊ぶ。わかった。わかった。わかった。わかった。理解します"}, {"type": "subtitle", "time": 18070.43, "timestamp": "05:01:10", "text": "サイロックは"}, {"type": "subtitle", "time": 18078.15, "timestamp": "05:01:18", "text": "建物。極めて致死性が高い。"}, {"type": "subtitle", "time": 18097.35, "timestamp": "05:01:37", "text": "準備は万端だ。"}, {"type": "subtitle", "time": 18108.15, "timestamp": "05:01:48", "text": "それはお勧めしません。お勧めします"}, {"type": "subtitle", "time": 18109.83, "timestamp": "05:01:49", "text": "それ。"}, {"type": "subtitle", "time": 18113.11, "timestamp": "05:01:53", "text": "ああ、なんてこった。彼女は好きでなければならなかったのか"}]
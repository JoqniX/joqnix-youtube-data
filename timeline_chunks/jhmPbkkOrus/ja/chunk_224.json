[{"type": "subtitle", "time": 13444.229, "timestamp": "03:44:04", "text": "なあ、ヒーラーは何してるんだ？"}, {"type": "subtitle", "time": 13452.389, "timestamp": "03:44:12", "text": "ヒールを履いている感覚がない。"}, {"type": "subtitle", "time": 13463.11, "timestamp": "03:44:23", "text": "えっ？私はただ、私は、私は文字通り"}, {"type": "subtitle", "time": 13464.389, "timestamp": "03:44:24", "text": "ヒールを感じないでください。彼らは何をしているのか"}, {"type": "subtitle", "time": 13469.83, "timestamp": "03:44:29", "text": "ダメージ？ああ、くそ。すみません、私の間違いでした。私はしませんでした"}, {"type": "subtitle", "time": 13472.87, "timestamp": "03:44:32", "text": "インタビューをご覧ください。ミッドを切り替えることはできますか？"}, {"type": "subtitle", "time": 13475.03, "timestamp": "03:44:35", "text": "バレル？はい、キャラクターを切り替えることができます"}, {"type": "subtitle", "time": 13475.79, "timestamp": "03:44:35", "text": "中"}, {"type": "subtitle", "time": 13478.15, "timestamp": "03:44:38", "text": "樽はあらゆる点で異なっている"}, {"type": "subtitle", "time": 13481.03, "timestamp": "03:44:41", "text": "実は。"}, {"type": "subtitle", "time": 13488.03, "timestamp": "03:44:48", "text": "シングル。もちろん、"}, {"type": "subtitle", "time": 13498.03, "timestamp": "03:44:58", "text": "最高。ここで私たちは"}]
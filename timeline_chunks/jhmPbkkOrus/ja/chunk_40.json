[{"type": "subtitle", "time": 2402.23, "timestamp": "00:40:02", "text": "えっと、私ができることの1つは、今私の"}, {"type": "subtitle", "time": 2404.99, "timestamp": "00:40:04", "text": "チャットを使用した独自のコード"}, {"type": "subtitle", "time": 2407.79, "timestamp": "00:40:07", "text": "GPT を実行する"}, {"type": "subtitle", "time": 2410.47, "timestamp": "00:40:10", "text": "ローカルでローカルに実行して、"}, {"type": "subtitle", "time": 2412.47, "timestamp": "00:40:12", "text": "ビリー・ビリーにストリーミングして"}, {"type": "subtitle", "time": 2416.23, "timestamp": "00:40:16", "text": "申請プログラム。そのままにしておこう"}, {"type": "subtitle", "time": 2419.43, "timestamp": "00:40:19", "text": "バックグラウンドで動作させておきましょう。それから"}, {"type": "subtitle", "time": 2422.31, "timestamp": "00:40:22", "text": "チャットを受け取ります。私はサミーを使って"}, {"type": "subtitle", "time": 2427.71, "timestamp": "00:40:27", "text": "ローカルホストに接続します"}, {"type": "subtitle", "time": 2431.95, "timestamp": "00:40:31", "text": "そしてユーザー名と"}, {"type": "subtitle", "time": 2435.15, "timestamp": "00:40:35", "text": "メッセージを送ってからログインしてください"}, {"type": "subtitle", "time": 2437.75, "timestamp": "00:40:37", "text": "不和。それが私にできる唯一のことだ"}, {"type": "subtitle", "time": 2457.069, "timestamp": "00:40:57", "text": "[音楽]"}, {"type": "subtitle", "time": 2459.63, "timestamp": "00:40:59", "text": "のように"}]
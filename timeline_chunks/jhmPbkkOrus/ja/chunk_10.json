[{"type": "subtitle", "time": 601.829, "timestamp": "00:10:01", "text": "中国語向け"}, {"type": "subtitle", "time": 606.55, "timestamp": "00:10:06", "text": "umサーバー、グローバルベータ版。"}, {"type": "subtitle", "time": 609.269, "timestamp": "00:10:09", "text": "私は応募しました、信じられないほどアカウント"}, {"type": "subtitle", "time": 611.71, "timestamp": "00:10:11", "text": "昨晩の午後5時頃"}, {"type": "subtitle", "time": 612.91, "timestamp": "00:10:12", "text": "[音楽]"}, {"type": "subtitle", "time": 617.11, "timestamp": "00:10:17", "text": "午前中に、入れることを期待していたのですが、ダメでした"}, {"type": "subtitle", "time": 624.829, "timestamp": "00:10:24", "text": "[音楽]"}, {"type": "subtitle", "time": 646.31, "timestamp": "00:10:46", "text": "上。私はとても寝て酔っていたので、"}, {"type": "subtitle", "time": 648.389, "timestamp": "00:10:48", "text": "何か言った。私は多くのことを共有しています"}]
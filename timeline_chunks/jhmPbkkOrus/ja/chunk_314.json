[{"type": "subtitle", "time": 18840.07, "timestamp": "05:14:00", "text": "なんてこった。治癒も同じです"}, {"type": "subtitle", "time": 18843.43, "timestamp": "05:14:03", "text": "えっと、彼女の名前は何でしたっけ？えっと"}, {"type": "subtitle", "time": 18847.67, "timestamp": "05:14:07", "text": "透明人間も同じだ。見えない。"}, {"type": "subtitle", "time": 18849.91, "timestamp": "05:14:09", "text": "あ、待って。ああ、くそ。ああ、彼らは殺すことはできない"}, {"type": "subtitle", "time": 18863.67, "timestamp": "05:14:23", "text": "少し助けてください。"}]
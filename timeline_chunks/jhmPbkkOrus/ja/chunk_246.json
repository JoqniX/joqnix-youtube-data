[{"type": "subtitle", "time": 14771.189, "timestamp": "04:06:11", "text": "待って。それを得る。それをしゃぶれ。しゃぶって"}, {"type": "subtitle", "time": 14782.63, "timestamp": "04:06:22", "text": "ああ、それについては私にはどうすることもできない。私"}, {"type": "subtitle", "time": 14784.15, "timestamp": "04:06:24", "text": "リスポーンを待つしかないが、"}, {"type": "subtitle", "time": 14787.189, "timestamp": "04:06:27", "text": "リスポーン機能を開発中です。お前の魂が欲しい。"}, {"type": "subtitle", "time": 14789.429, "timestamp": "04:06:29", "text": "病気"}, {"type": "subtitle", "time": 14790.87, "timestamp": "04:06:30", "text": "おお、いいぞ。手に入れることができますよ。あなたはできる"}, {"type": "subtitle", "time": 14793.429, "timestamp": "04:06:33", "text": "それを得る。またしても期待を裏切られた。ポータルが欲しい"}, {"type": "subtitle", "time": 14795.87, "timestamp": "04:06:35", "text": "今、私のチームはほぼ"}, {"type": "subtitle", "time": 14798.79, "timestamp": "04:06:38", "text": "ポイント。私は走るつもりだ。私はサブアカウントを持っています"}, {"type": "subtitle", "time": 14801.189, "timestamp": "04:06:41", "text": "すでに。物事にはすべてが備わっている。はい、これは"}, {"type": "subtitle", "time": 14802.07, "timestamp": "04:06:42", "text": "良さそうだ。これは"}, {"type": "subtitle", "time": 14803.59, "timestamp": "04:06:43", "text": "良い。これは良さそうだ。ああ、"}, {"type": "subtitle", "time": 14804.95, "timestamp": "04:06:44", "text": "ああ、もう2つも指名権があるのに。わかった、"}, {"type": "subtitle", "time": 14807.11, "timestamp": "04:06:47", "text": "はい、はい。ニース。ニース。ニース。ニース。おお、"}, {"type": "subtitle", "time": 14808.59, "timestamp": "04:06:48", "text": "どうでも。彼は"}, {"type": "subtitle", "time": 14811.269, "timestamp": "04:06:51", "text": "戻る。その敵は全員"}, {"type": "subtitle", "time": 14816.229, "timestamp": "04:06:56", "text": "おそらくロキは"}, {"type": "subtitle", "time": 14817.67, "timestamp": "04:06:57", "text": "いや、彼はやるつもりだ。彼は、彼を見て。"}, {"type": "subtitle", "time": 14819.67, "timestamp": "04:06:59", "text": "彼を見て。彼は挑戦するつもりだ。そして彼は"}]
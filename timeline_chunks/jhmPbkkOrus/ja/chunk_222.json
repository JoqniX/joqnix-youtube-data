[{"type": "subtitle", "time": 13333.67, "timestamp": "03:42:13", "text": "なぜ私の好きなヒーラーはこんなにも"}, {"type": "subtitle", "time": 13349.349, "timestamp": "03:42:29", "text": "長くは続かないだろう。わかった。私が行くべきでしょう。"}, {"type": "subtitle", "time": 13360.91, "timestamp": "03:42:40", "text": "科学的な解決策が証明されるとき"}, {"type": "subtitle", "time": 13364.389, "timestamp": "03:42:44", "text": "不十分で、巨大な拳がやってくる"}, {"type": "subtitle", "time": 13371.83, "timestamp": "03:42:51", "text": "我々は十分な被害を受けている。"}, {"type": "subtitle", "time": 13378.63, "timestamp": "03:42:58", "text": "混沌の中で。"}]
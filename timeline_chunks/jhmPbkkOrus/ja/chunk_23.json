[{"type": "subtitle", "time": 1383.16, "timestamp": "00:23:03", "text": "これら。おお、"}, {"type": "subtitle", "time": 1384.669, "timestamp": "00:23:04", "text": "[音楽]"}, {"type": "subtitle", "time": 1401.63, "timestamp": "00:23:21", "text": "これ。ああ、わかった。自分"}, {"type": "subtitle", "time": 1408.51, "timestamp": "00:23:28", "text": "わかった。私は違います"}, {"type": "subtitle", "time": 1425.669, "timestamp": "00:23:45", "text": "えっと、実は私は"}, {"type": "subtitle", "time": 1427.43, "timestamp": "00:23:47", "text": "メガネですよね？ちょっと待って。まず始めに"}, {"type": "subtitle", "time": 1429.95, "timestamp": "00:23:49", "text": "ストリーム"}, {"type": "subtitle", "time": 1431.87, "timestamp": "00:23:51", "text": "私は"}]
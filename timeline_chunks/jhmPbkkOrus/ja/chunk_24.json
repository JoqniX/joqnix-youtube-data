[{"type": "subtitle", "time": 1453.75, "timestamp": "00:24:13", "text": "[音楽]"}, {"type": "subtitle", "time": 1455.149, "timestamp": "00:24:15", "text": "で"}, {"type": "subtitle", "time": 1459.15, "timestamp": "00:24:19", "text": "スキニー"}, {"type": "subtitle", "time": 1486.789, "timestamp": "00:24:46", "text": "あなたが引き継ぎたいとき。ああ、そうだね。"}, {"type": "subtitle", "time": 1489.83, "timestamp": "00:24:49", "text": "ええ、あげますよ。ブレットに任せることができます"}, {"type": "subtitle", "time": 1493.149, "timestamp": "00:24:53", "text": "夕食を食べに行きたいので、代わりに引き継いでください。"}, {"type": "subtitle", "time": 1497.95, "timestamp": "00:24:57", "text": "いいえ。昼食です。ランチ。ランチ。なぜ私はこう言うのか"}]
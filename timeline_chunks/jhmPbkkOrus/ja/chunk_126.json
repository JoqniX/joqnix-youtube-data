[{"type": "subtitle", "time": 7562.229, "timestamp": "02:06:02", "text": "コードのブロックか何か。私はただ"}, {"type": "subtitle", "time": 7565.31, "timestamp": "02:06:05", "text": "それをするように"}, {"type": "subtitle", "time": 7569.149, "timestamp": "02:06:09", "text": "これ。ちょっと待って、一つ見せてあげる"}, {"type": "subtitle", "time": 7573.31, "timestamp": "02:06:13", "text": "要約すると、2番目です。これは私が"}, {"type": "subtitle", "time": 7575.149, "timestamp": "02:06:15", "text": "意味。"}, {"type": "subtitle", "time": 7578.07, "timestamp": "02:06:18", "text": "えっと、今私がやっていることは"}, {"type": "subtitle", "time": 7580.39, "timestamp": "02:06:20", "text": "ビリー・ビリーのシングルストリーム、私は"}, {"type": "subtitle", "time": 7582.189, "timestamp": "02:06:22", "text": "スクリーンショット"}, {"type": "subtitle", "time": 7585.43, "timestamp": "02:06:25", "text": "それ。こうやってスクリーンショットを撮らないといけないんだ。"}, {"type": "subtitle", "time": 7587.79, "timestamp": "02:06:27", "text": "すべてのストリームで、"}, {"type": "subtitle", "time": 7591.87, "timestamp": "02:06:31", "text": "スクリーンショット。スクリーンショットを撮るのは面倒すぎる"}, {"type": "subtitle", "time": 7594.95, "timestamp": "02:06:34", "text": "それ。私が"}, {"type": "subtitle", "time": 7597.99, "timestamp": "02:06:37", "text": "このような自動化されたもの"}, {"type": "subtitle", "time": 7600.75, "timestamp": "02:06:40", "text": "メッセージが送信されました、誰が言った"}, {"type": "subtitle", "time": 7604.47, "timestamp": "02:06:44", "text": "それと、彼らのチャンネルリンクなどなど。"}, {"type": "subtitle", "time": 7607.27, "timestamp": "02:06:47", "text": "それが欲しい。私はすべての"}, {"type": "subtitle", "time": 7611.109, "timestamp": "02:06:51", "text": "スクリーンショットを撮るのを忘れないでください。"}, {"type": "subtitle", "time": 7613.109, "timestamp": "02:06:53", "text": "スクリーンショットを忘れてしまった場合はどうすればいいですか？もしも"}, {"type": "subtitle", "time": 7617.27, "timestamp": "02:06:57", "text": "チャット履歴が消えてしまった？"}]
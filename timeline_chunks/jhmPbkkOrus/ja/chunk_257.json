[{"type": "subtitle", "time": 15421.309, "timestamp": "04:17:01", "text": "[音楽]"}, {"type": "subtitle", "time": 15428.87, "timestamp": "04:17:08", "text": "私たちは感じています"}, {"type": "subtitle", "time": 15430.87, "timestamp": "04:17:10", "text": "この美しいものは"}, {"type": "subtitle", "time": 15433.03, "timestamp": "04:17:13", "text": "ロキの下で苦しむ。"}, {"type": "subtitle", "time": 15448.07, "timestamp": "04:17:28", "text": "わかった。彼らは「ああ、行かなきゃ」"}, {"type": "subtitle", "time": 15452.55, "timestamp": "04:17:32", "text": "遠い。行くとしても、私はむしろスパイアの方がいい"}, {"type": "subtitle", "time": 15461.83, "timestamp": "04:17:41", "text": "今しかない。君の力は私のものだ。"}]
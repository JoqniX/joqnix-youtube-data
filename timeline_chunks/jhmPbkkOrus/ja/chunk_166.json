[{"type": "subtitle", "time": 9962.389, "timestamp": "02:46:02", "text": "うーん、すごい。おお。ああ、それはすでに"}, {"type": "subtitle", "time": 9965.19, "timestamp": "02:46:05", "text": "パス。ありがとう。ああ、ありがとうございます。私"}, {"type": "subtitle", "time": 9967.389, "timestamp": "02:46:07", "text": "私はその余分なことをしなければならないと思った"}, {"type": "subtitle", "time": 9969.79, "timestamp": "02:46:09", "text": "ステップ。"}, {"type": "subtitle", "time": 9982.07, "timestamp": "02:46:22", "text": "よし、うまくいった。オーケー、いいね、いいね、いいね、"}, {"type": "subtitle", "time": 9984.19, "timestamp": "02:46:24", "text": "いいね、いいね、いいね、いいね、いいね。今、"}, {"type": "subtitle", "time": 9991.75, "timestamp": "02:46:31", "text": "あなた。待って、これをここに今すぐ書かなきゃ。"}, {"type": "subtitle", "time": 9995.07, "timestamp": "02:46:35", "text": "わかった。えっと、クラス。"}, {"type": "subtitle", "time": 9997.23, "timestamp": "02:46:37", "text": "出口。コントロール"}, {"type": "subtitle", "time": 10001.87, "timestamp": "02:46:41", "text": "Z. 出口。 H. わかりました。"}, {"type": "subtitle", "time": 10003.389, "timestamp": "02:46:43", "text": "ここ。"}, {"type": "subtitle", "time": 10008.75, "timestamp": "02:46:48", "text": "紙を買ってください。右。それを置いてください。"}, {"type": "subtitle", "time": 10011.87, "timestamp": "02:46:51", "text": "はい。できません"}]
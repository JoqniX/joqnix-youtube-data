[{"type": "subtitle", "time": 17520.47, "timestamp": "04:52:00", "text": "ああ、気まずかったね。ちなみに、私は"}, {"type": "subtitle", "time": 17522.39, "timestamp": "04:52:02", "text": "何もない。"}, {"type": "subtitle", "time": 17524.55, "timestamp": "04:52:04", "text": "私は何もしていません。私は1つやった"}, {"type": "subtitle", "time": 17534.23, "timestamp": "04:52:14", "text": "うん。では、どうすればいいのでしょうか？ わかりました、それが理由です"}, {"type": "subtitle", "time": 17540.55, "timestamp": "04:52:20", "text": "質問。私はいいえ、私はアーティストです"}, {"type": "subtitle", "time": 17544.83, "timestamp": "04:52:24", "text": "ジョックニック氏をこちらで見つけることができました"}, {"type": "subtitle", "time": 17561.59, "timestamp": "04:52:41", "text": "いつだったかな、今"}, {"type": "subtitle", "time": 17565.62, "timestamp": "04:52:45", "text": "よく考えてみてください。いつは"}, {"type": "subtitle", "time": 17567.19, "timestamp": "04:52:47", "text": "[音楽]"}, {"type": "subtitle", "time": 17569.75, "timestamp": "04:52:49", "text": "それはいつのことだった？いつか"}, {"type": "subtitle", "time": 17573.55, "timestamp": "04:52:53", "text": "2022年をプレイしていた時のこと。くそったれ"}, {"type": "subtitle", "time": 17577.27, "timestamp": "04:52:57", "text": "ストーカー。あなたはそれほどまでに私を愛してくれているのですね。何？"}]
[{"type": "subtitle", "time": 18120.47, "timestamp": "05:02:00", "text": "はい、商品がありません。それは"}, {"type": "subtitle", "time": 18123.35, "timestamp": "05:02:03", "text": "問題。商品がございません。チームは"}, {"type": "subtitle", "time": 18126.708, "timestamp": "05:02:06", "text": "仲間とは違う。"}, {"type": "subtitle", "time": 18129.03, "timestamp": "05:02:09", "text": "ほら、彼はひどくふらついているでしょう。"}, {"type": "subtitle", "time": 18131.51, "timestamp": "05:02:11", "text": "一体どういうことだ？彼らは検問所に差し掛かった。"}, {"type": "subtitle", "time": 18133.43, "timestamp": "05:02:13", "text": "今こそ彼らを止めるべき時かもしれない。"}, {"type": "subtitle", "time": 18134.868, "timestamp": "05:02:14", "text": "二人なのにどうして押し合っているの？"}, {"type": "subtitle", "time": 18152.788, "timestamp": "05:02:32", "text": "何がおかしいのか"}, {"type": "subtitle", "time": 18168.23, "timestamp": "05:02:48", "text": "あるいは、ただ死ぬだけ。準備してください。やってくる"}, {"type": "subtitle", "time": 18170.28, "timestamp": "05:02:50", "text": "悪者たち。"}, {"type": "subtitle", "time": 18177.67, "timestamp": "05:02:57", "text": "これは本物の火力だ。パッチを当ててあげるよ"}]
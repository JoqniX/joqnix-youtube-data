[{"type": "subtitle", "time": 10022.309, "timestamp": "02:47:02", "text": "そこには。何てことだ。環境。私"}, {"type": "subtitle", "time": 10042.15, "timestamp": "02:47:22", "text": "はい、システムに入力しました。私"}, {"type": "subtitle", "time": 10053.67, "timestamp": "02:47:33", "text": "私が行くのは、知っている人たちだけです。こんにちは、"}, {"type": "subtitle", "time": 10056.95, "timestamp": "02:47:36", "text": "気をつけて。今、試してみました。ああ、試してみたの？"}, {"type": "subtitle", "time": 10059.51, "timestamp": "02:47:39", "text": "それを実行するために？ダウングレードする必要はありません"}, {"type": "subtitle", "time": 10061.75, "timestamp": "02:47:41", "text": "それから。どのようなエラーが発生しているのでしょうか？これ"}, {"type": "subtitle", "time": 10064.07, "timestamp": "02:47:44", "text": "車輪と歯車、もしくはそれに類するもの"}]
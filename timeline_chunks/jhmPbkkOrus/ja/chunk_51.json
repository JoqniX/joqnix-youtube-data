[{"type": "subtitle", "time": 3060.71, "timestamp": "00:51:00", "text": "マーク。だから彼らは"}, {"type": "subtitle", "time": 3063.349, "timestamp": "00:51:03", "text": "えっと、ユージ・クン、参考資料が欲しいですか？"}, {"type": "subtitle", "time": 3065.829, "timestamp": "00:51:05", "text": "私のモデル？もしあなたが"}, {"type": "subtitle", "time": 3068.309, "timestamp": "00:51:08", "text": "参考資料が必要な場合は、私のファンページをご覧ください。"}, {"type": "subtitle", "time": 3069.39, "timestamp": "00:51:09", "text": "または私の"}, {"type": "subtitle", "time": 3072.39, "timestamp": "00:51:12", "text": "Webサイト。必要であれば"}, {"type": "subtitle", "time": 3075.15, "timestamp": "00:51:15", "text": "えっと、私の参考資料なので"}, {"type": "subtitle", "time": 3080.75, "timestamp": "00:51:20", "text": "絵を描きたいなら、ファンダムに行けばいい。"}, {"type": "subtitle", "time": 3083.91, "timestamp": "00:51:23", "text": "ヴィッキーがそこにいる。 YouTubeにアップします。"}, {"type": "subtitle", "time": 3091.109, "timestamp": "00:51:31", "text": "推測。ここに私のメインモデルがあります"}, {"type": "subtitle", "time": 3092.99, "timestamp": "00:51:32", "text": "参考文献。"}, {"type": "subtitle", "time": 3097.63, "timestamp": "00:51:37", "text": "えっと、もしあなたが"}, {"type": "subtitle", "time": 3111.79, "timestamp": "00:51:51", "text": "チャット。"}, {"type": "subtitle", "time": 3114.63, "timestamp": "00:51:54", "text": "はい、どうぞ。入れるだけです"}, {"type": "subtitle", "time": 3118.309, "timestamp": "00:51:58", "text": "あなたのためにチャットします。私はポップするべきだ"}]
[{"type": "subtitle", "time": 19681.07, "timestamp": "05:28:01", "text": "キャンセル。忘れないでください"}, {"type": "subtitle", "time": 19685.75, "timestamp": "05:28:05", "text": "それ。なんてこった。わかった。じゃあね、みんな。"}, {"type": "subtitle", "time": 19688.628, "timestamp": "05:28:08", "text": "バイバイ。気をつけて。"}, {"type": "subtitle", "time": 19690.788, "timestamp": "05:28:10", "text": "前立腺の検査を受けられるといいですね。おお、"}, {"type": "subtitle", "time": 19693.75, "timestamp": "05:28:13", "text": "どうぞお行きください。"}, {"type": "subtitle", "time": 19696.47, "timestamp": "05:28:16", "text": "まあ、いいでしょう。私もそろそろ行きます。"}, {"type": "subtitle", "time": 19699.67, "timestamp": "05:28:19", "text": "ありがとう。ありがとうございます"}, {"type": "subtitle", "time": 19703.03, "timestamp": "05:28:23", "text": "本日はありがとうございました。疲れているように聞こえますね。私"}, {"type": "subtitle", "time": 19705.27, "timestamp": "05:28:25", "text": "する。"}, {"type": "subtitle", "time": 19708.15, "timestamp": "05:28:28", "text": "ええ、いつも"}, {"type": "subtitle", "time": 19711.43, "timestamp": "05:28:31", "text": "わからない。それは本当だ。"}, {"type": "subtitle", "time": 19715.19, "timestamp": "05:28:35", "text": "それでは、土曜日にお会いしましょう。"}, {"type": "subtitle", "time": 19717.51, "timestamp": "05:28:37", "text": "土曜日。"}, {"type": "subtitle", "time": 19720.23, "timestamp": "05:28:40", "text": "うん、その時は暇だし、"}, {"type": "subtitle", "time": 19722.788, "timestamp": "05:28:42", "text": "来る。えっと、何かありますか？"}, {"type": "subtitle", "time": 19725.75, "timestamp": "05:28:45", "text": "金曜日？"}, {"type": "subtitle", "time": 19729.19, "timestamp": "05:28:49", "text": "ええと、木曜日にVCを準備しました"}, {"type": "subtitle", "time": 19731.07, "timestamp": "05:28:51", "text": "土曜日。そこには"}, {"type": "subtitle", "time": 19733.91, "timestamp": "05:28:53", "text": "5時にコラボ。うん、彼がそう言ったんだ"}, {"type": "subtitle", "time": 19737.788, "timestamp": "05:28:57", "text": "今。土曜日。ロコ。リオ。"}]
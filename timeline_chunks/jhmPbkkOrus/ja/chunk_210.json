[{"type": "subtitle", "time": 12625.91, "timestamp": "03:30:25", "text": "とった。私はルナを手に入れました。わかった。ルナ"}, {"type": "subtitle", "time": 12635.67, "timestamp": "03:30:35", "text": "もう二度と会えないと思っていたよ。わかった。"}, {"type": "subtitle", "time": 12655.59, "timestamp": "03:30:55", "text": "得る"}, {"type": "subtitle", "time": 12657.269, "timestamp": "03:30:57", "text": "クソみたいなゲットー。いいもの。私たちは"}]
[{"type": "subtitle", "time": 3905.95, "timestamp": "01:05:05", "text": "うん。えっと、ビリービリーを使ってもいいですか？"}, {"type": "subtitle", "time": 3912.39, "timestamp": "01:05:12", "text": "ロキシー？私が欲しいのはウェブソケット関連の機能だけです。私"}, {"type": "subtitle", "time": 3914.75, "timestamp": "01:05:14", "text": "3ドル支払った"}, {"type": "subtitle", "time": 3919.47, "timestamp": "01:05:19", "text": "これはウェブ版Sammy拡張機能用です"}, {"type": "subtitle", "time": 3924.27, "timestamp": "01:05:24", "text": "コネクタ。これを3ドルで買いました。いいえ、"}, {"type": "subtitle", "time": 3932.71, "timestamp": "01:05:32", "text": "これ。私ができる最善の方法はただ"}, {"type": "subtitle", "time": 3935.75, "timestamp": "01:05:35", "text": "サミー・ダヴに私が依頼したように頼む"}, {"type": "subtitle", "time": 3938.75, "timestamp": "01:05:38", "text": "彼らにこれをやってもらう"}]
[{"type": "subtitle", "time": 20220.27, "timestamp": "05:37:00", "text": "そして"}, {"type": "subtitle", "time": 20222.59, "timestamp": "05:37:02", "text": "再録。"}, {"type": "subtitle", "time": 20226.39, "timestamp": "05:37:06", "text": "ああ、つまり誰かがアップロードしたとき"}, {"type": "subtitle", "time": 20228.708, "timestamp": "05:37:08", "text": "ビデオ、そう、人々はお金を寄付することができます"}, {"type": "subtitle", "time": 20233.15, "timestamp": "05:37:13", "text": "仮想通貨は、"}, {"type": "subtitle", "time": 20236.39, "timestamp": "05:37:16", "text": "クリエイター、チャンネルクリエイターは"}, {"type": "subtitle", "time": 20238.27, "timestamp": "05:37:18", "text": "収益化され、"}, {"type": "subtitle", "time": 20241.19, "timestamp": "05:37:21", "text": "そういうことですよね？私にとっては、"}, {"type": "subtitle", "time": 20242.788, "timestamp": "05:37:22", "text": "会員制のやつもね。それは"}, {"type": "subtitle", "time": 20245.43, "timestamp": "05:37:25", "text": "別。しかし、すべてのビデオに対して、"}, {"type": "subtitle", "time": 20247.788, "timestamp": "05:37:27", "text": "具体的なものを与える"}, {"type": "subtitle", "time": 20251.43, "timestamp": "05:37:31", "text": "通貨、1コインまたは2コイン"}, {"type": "subtitle", "time": 20253.59, "timestamp": "05:37:33", "text": "動画でエンゲージメントを高める"}, {"type": "subtitle", "time": 20255.628, "timestamp": "05:37:35", "text": "そして"}, {"type": "subtitle", "time": 20257.868, "timestamp": "05:37:37", "text": "すべて。"}, {"type": "subtitle", "time": 20259.47, "timestamp": "05:37:39", "text": "ああ、"}, {"type": "subtitle", "time": 20263.23, "timestamp": "05:37:43", "text": "くそ。それは気持ち悪い、"}, {"type": "subtitle", "time": 20266.788, "timestamp": "05:37:46", "text": "男。だから彼らはこれを持っているのです"}, {"type": "subtitle", "time": 20269.47, "timestamp": "05:37:49", "text": "もの。"}, {"type": "subtitle", "time": 20272.788, "timestamp": "05:37:52", "text": "ええと、だから彼らは何か関係があるように見えるんですね"}]
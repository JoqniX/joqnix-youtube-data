[{"type": "subtitle", "time": 17461.41, "timestamp": "04:51:01", "text": "これは本物の火力だ。"}, {"type": "subtitle", "time": 17483.59, "timestamp": "04:51:23", "text": "えーっと、2022年。あなたがツイートしたツイートだと思います。"}, {"type": "subtitle", "time": 17495.23, "timestamp": "04:51:35", "text": "なんてこった。いや、もっと悪い。私"}, {"type": "subtitle", "time": 17498.708, "timestamp": "04:51:38", "text": "私は"}, {"type": "subtitle", "time": 17515.788, "timestamp": "04:51:55", "text": "稲妻。少し"}, {"type": "subtitle", "time": 17518.708, "timestamp": "04:51:58", "text": "恐ろしい。皆さんもあの逆転劇をご覧になったでしょう。"}]
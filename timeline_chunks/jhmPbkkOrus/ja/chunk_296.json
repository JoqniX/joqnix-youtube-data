[{"type": "subtitle", "time": 17762.99, "timestamp": "04:56:02", "text": "私はああ、なんてことだ。一体どういうことだ？"}, {"type": "subtitle", "time": 17766.51, "timestamp": "04:56:06", "text": "コウモリはいない。この男はゼロ"}, {"type": "subtitle", "time": 17769.75, "timestamp": "04:56:09", "text": "コウモリ。彼は臭い。"}, {"type": "subtitle", "time": 17772.55, "timestamp": "04:56:12", "text": "臭い。ちくしょう。"}, {"type": "subtitle", "time": 17774.15, "timestamp": "04:56:14", "text": "これが何を意味するか、ジョー、わかるかい？もしあなたが見たら"}, {"type": "subtitle", "time": 17775.83, "timestamp": "04:56:15", "text": "私のストリーム、ブラックパンサー、彼らには"}, {"type": "subtitle", "time": 17778.868, "timestamp": "04:56:18", "text": "ブラックパンサーだよ。えーと質問ですが、"}, {"type": "subtitle", "time": 17781.19, "timestamp": "04:56:21", "text": "お前。前回のラウンドで彼と対戦しました。"}, {"type": "subtitle", "time": 17782.628, "timestamp": "04:56:22", "text": "彼は何も演奏できないが"}, {"type": "subtitle", "time": 17784.39, "timestamp": "04:56:24", "text": "ヒーラー。実際は、ヒーラーです。彼は"}, {"type": "subtitle", "time": 17785.99, "timestamp": "04:56:25", "text": "ごみ。彼は黒しかプレイできない"}, {"type": "subtitle", "time": 17787.83, "timestamp": "04:56:27", "text": "パンサー。つまり、それは文字通り彼のものだ"}, {"type": "subtitle", "time": 17790.23, "timestamp": "04:56:30", "text": "唯一のキャラクター。彼はあらゆる面でひどい成績だった"}, {"type": "subtitle", "time": 17792.07, "timestamp": "04:56:32", "text": "その他の役割。"}, {"type": "subtitle", "time": 17796.31, "timestamp": "04:56:36", "text": "ありがとう、でも彼には感謝しないよ。"}, {"type": "subtitle", "time": 17798.23, "timestamp": "04:56:38", "text": "待って、あれは人の声？おお、"}, {"type": "subtitle", "time": 17800.788, "timestamp": "04:56:40", "text": "待って。開いています。うん。うん、それ"}, {"type": "subtitle", "time": 17802.47, "timestamp": "04:56:42", "text": "それはゲーム内で話している人物です。彼"}, {"type": "subtitle", "time": 17804.708, "timestamp": "04:56:44", "text": "その試合では一度も彼に交代しなかった。"}, {"type": "subtitle", "time": 17806.07, "timestamp": "04:56:46", "text": "彼は文字通り「おい、俺は黒をプレイする」と言った。"}, {"type": "subtitle", "time": 17808.39, "timestamp": "04:56:48", "text": "「パンサー」。それだけです。え、何？"}, {"type": "subtitle", "time": 17812.39, "timestamp": "04:56:52", "text": "ねえ、僕はブラックパンサーを演じるんだ。"}, {"type": "subtitle", "time": 17815.19, "timestamp": "04:56:55", "text": "皆さん、ブラックパンサーに投票してくださいませんか？"}, {"type": "subtitle", "time": 17818.948, "timestamp": "04:56:58", "text": "もちろんさ。"}]
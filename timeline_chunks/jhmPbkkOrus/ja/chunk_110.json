[{"type": "subtitle", "time": 6629.109, "timestamp": "01:50:29", "text": "代わりにビリーがライブDMをする？これ"}, {"type": "subtitle", "time": 6632.31, "timestamp": "01:50:32", "text": "うまくいくはずです。"}, {"type": "subtitle", "time": 6634.109, "timestamp": "01:50:34", "text": "素早い"}, {"type": "subtitle", "time": 6637.83, "timestamp": "01:50:37", "text": "オッズ。ああ、やったー。待って、なぜあなたは"}, {"type": "subtitle", "time": 6640.87, "timestamp": "01:50:40", "text": "昼食を食べていますか？あ、待って。あなたは"}, {"type": "subtitle", "time": 6642.95, "timestamp": "01:50:42", "text": "あなたと私は同じタイムゾーンですか？"}, {"type": "subtitle", "time": 6644.51, "timestamp": "01:50:44", "text": "あなたは"}, {"type": "subtitle", "time": 6649.709, "timestamp": "01:50:49", "text": "インド？月曜日。なぜ食べないの？"}, {"type": "subtitle", "time": 6652.709, "timestamp": "01:50:52", "text": "昼食か朝食に。あ、待って。それは"}, {"type": "subtitle", "time": 6654.35, "timestamp": "01:50:54", "text": "おはようございます"}, {"type": "subtitle", "time": 6656.79, "timestamp": "01:50:56", "text": "または、そちらでは今何時ですか？お昼ご飯です"}, {"type": "subtitle", "time": 6658.47, "timestamp": "01:50:58", "text": "時間。わかった。わかった。あなたはインド出身ですね"}]
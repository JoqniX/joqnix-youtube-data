[{"type": "subtitle", "time": 17282.55, "timestamp": "04:48:02", "text": "eスポーツの練習。ランキングを上げるために努力するつもりだ。"}, {"type": "subtitle", "time": 17285.27, "timestamp": "04:48:05", "text": "うん。"}, {"type": "subtitle", "time": 17290.23, "timestamp": "04:48:10", "text": "もし私があなたとロとロクの両方を覚えているなら"}, {"type": "subtitle", "time": 17293.35, "timestamp": "04:48:13", "text": "あなたたち3人全員"}, {"type": "subtitle", "time": 17296.07, "timestamp": "04:48:16", "text": "ランク上げはみんなで一緒にやるんだよね？"}, {"type": "subtitle", "time": 17303.59, "timestamp": "04:48:23", "text": "実際には、最近はそうではない。"}, {"type": "subtitle", "time": 17313.75, "timestamp": "04:48:33", "text": "はい。死んだ。"}, {"type": "subtitle", "time": 17316.628, "timestamp": "04:48:36", "text": "アライグマ。ここに来て。私はそれが欲しい"}, {"type": "subtitle", "time": 17319.43, "timestamp": "04:48:39", "text": "ラクーン。"}, {"type": "subtitle", "time": 17328.788, "timestamp": "04:48:48", "text": "くたばれ、アライグマ。知っている。私は違います"}, {"type": "subtitle", "time": 17330.47, "timestamp": "04:48:50", "text": "押す。心配しないで。私は押し付けているわけではありません"}]
[{"type": "subtitle", "time": 12483.429, "timestamp": "03:28:03", "text": "レベルズの選手たち、私は彼らをバカと呼ぶ。"}, {"type": "subtitle", "time": 12485.91, "timestamp": "03:28:05", "text": "最高のチームが必要だ。とにかく、彼らは"}, {"type": "subtitle", "time": 12487.51, "timestamp": "03:28:07", "text": "文字を入れ替えたらうまくいった"}, {"type": "subtitle", "time": 12489.03, "timestamp": "03:28:09", "text": "終わり。それは"}, {"type": "subtitle", "time": 12491.67, "timestamp": "03:28:11", "text": "毎年恒例のこと。私たちはポイントを理解し、彼らは"}, {"type": "subtitle", "time": 12493.269, "timestamp": "03:28:13", "text": "代わりに、"}, {"type": "subtitle", "time": 12495.63, "timestamp": "03:28:15", "text": "農業のようなもの"}, {"type": "subtitle", "time": 12500.429, "timestamp": "03:28:20", "text": "全て。うん。えっと、あなたは"}, {"type": "subtitle", "time": 12503.75, "timestamp": "03:28:23", "text": "これは確実ですか？これは一体何だ？"}, {"type": "subtitle", "time": 12508.03, "timestamp": "03:28:28", "text": "彼らは間違いなくまた火をつけるだろう"}, {"type": "subtitle", "time": 12511.429, "timestamp": "03:28:31", "text": "カウンタ。彼はバーを持っているので、私は彼とプレイできません"}, {"type": "subtitle", "time": 12514.95, "timestamp": "03:28:34", "text": "良い。第2ラウンド。なんでそうしなかったんだよ"}, {"type": "subtitle", "time": 12516.79, "timestamp": "03:28:36", "text": "何か言った？"}, {"type": "subtitle", "time": 12523.55, "timestamp": "03:28:43", "text": "ハエとハエの対決。[ __ ]して"}, {"type": "subtitle", "time": 12526.11, "timestamp": "03:28:46", "text": "鉄拳。いいえ、彼は"}, {"type": "subtitle", "time": 12531.91, "timestamp": "03:28:51", "text": "ペニーの攻撃を継続できる。準備してください。"}, {"type": "subtitle", "time": 12538.63, "timestamp": "03:28:58", "text": "私は戦車乗りです。"}]
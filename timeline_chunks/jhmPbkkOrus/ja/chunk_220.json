[{"type": "subtitle", "time": 13200.79, "timestamp": "03:40:00", "text": "キャラクター。えっと、エマ・フロスト。何でも"}, {"type": "subtitle", "time": 13204.469, "timestamp": "03:40:04", "text": "良い？似たようなものはありますか？"}, {"type": "subtitle", "time": 13206.229, "timestamp": "03:40:06", "text": "よし、シールドタンクは既にあるから"}, {"type": "subtitle", "time": 13210.63, "timestamp": "03:40:10", "text": "彼は本気でやっていると思った。もし私が失敗したら、"}, {"type": "subtitle", "time": 13212.269, "timestamp": "03:40:12", "text": "スイッチ"}, {"type": "subtitle", "time": 13216.309, "timestamp": "03:40:16", "text": "自分。もし私が失敗したら、私と交代してください。"}, {"type": "subtitle", "time": 13224.469, "timestamp": "03:40:24", "text": "はい、私たちは…私たちはティンです。だった"}, {"type": "subtitle", "time": 13228.269, "timestamp": "03:40:28", "text": "チーン。戻ってくる。ドゥームは強力な"}, {"type": "subtitle", "time": 13231.229, "timestamp": "03:40:31", "text": "魔法。私たちは対峙することになるだろうと私は予想している"}, {"type": "subtitle", "time": 13233.99, "timestamp": "03:40:33", "text": "またすぐに会えるでしょう。彼女はこっそりと小便をしている。来る"}]
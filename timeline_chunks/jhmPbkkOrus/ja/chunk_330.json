[{"type": "subtitle", "time": 19806.99, "timestamp": "05:30:06", "text": "顎。うん、次はわかると思うよ"}, {"type": "subtitle", "time": 19809.35, "timestamp": "05:30:09", "text": "何？疲れた時はいつでも、"}, {"type": "subtitle", "time": 19811.548, "timestamp": "05:30:11", "text": "メッセージを送ってください。私が受け取れるかどうか"}, {"type": "subtitle", "time": 19815.91, "timestamp": "05:30:15", "text": "終わったら見てみる"}, {"type": "subtitle", "time": 19818.07, "timestamp": "05:30:18", "text": "あなたが知っている。わかりました。わかりました、"}, {"type": "subtitle", "time": 19820.83, "timestamp": "05:30:20", "text": "今すぐ行け。バイバイ。こんにちは。"}, {"type": "subtitle", "time": 19823.99, "timestamp": "05:30:23", "text": "バイバイ。気をつけて。"}, {"type": "subtitle", "time": 19825.07, "timestamp": "05:30:25", "text": "そして彼は"}, {"type": "subtitle", "time": 19828.75, "timestamp": "05:30:28", "text": "左。ブラッドと"}, {"type": "subtitle", "time": 19831.548, "timestamp": "05:30:31", "text": "来てくれてありがとう。"}, {"type": "subtitle", "time": 19834.49, "timestamp": "05:30:34", "text": "による。それは本当に大きな意味があります。感謝"}, {"type": "subtitle", "time": 19847.59, "timestamp": "05:30:47", "text": "あなた。ええ、そうです。私はただ返信しているだけです"}, {"type": "subtitle", "time": 19852.628, "timestamp": "05:30:52", "text": "QQグループ上のメッセージ。どうやら中国人のようだ"}, {"type": "subtitle", "time": 19859.03, "timestamp": "05:30:59", "text": "厳しい。あなたにはその権限がありません"}]
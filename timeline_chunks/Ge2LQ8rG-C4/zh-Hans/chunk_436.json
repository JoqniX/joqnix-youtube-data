[{"type": "subtitle", "time": 26161.03, "timestamp": "07:16:01", "text": "类似的事情，然后他们就会说“我"}, {"type": "subtitle", "time": 26162.39, "timestamp": "07:16:02", "text": "不知道，好像有个故事是你讲的。"}, {"type": "subtitle", "time": 26163.91, "timestamp": "07:16:03", "text": "我知道我看过一些其他的片段。"}, {"type": "subtitle", "time": 26167.91, "timestamp": "07:16:07", "text": "YouTuber们喜欢谈论他们的家庭"}, {"type": "subtitle", "time": 26170.15, "timestamp": "07:16:10", "text": "成员或兄弟姐妹发现"}, {"type": "subtitle", "time": 26173.91, "timestamp": "07:16:13", "text": "它们是管状物之类的。我觉得穆娜"}, {"type": "subtitle", "time": 26177.91, "timestamp": "07:16:17", "text": "来自 Holy 的 Hash Ma 曾经谈到过"}, {"type": "subtitle", "time": 26182.83, "timestamp": "07:16:22", "text": "那。苏接着说：“还有谁？”我不"}, {"type": "subtitle", "time": 26186.39, "timestamp": "07:16:26", "text": "知道。是的，我看过那些片段。我是"}, {"type": "subtitle", "time": 26189.91, "timestamp": "07:16:29", "text": "哇。我一直想象着……"}, {"type": "subtitle", "time": 26192.548, "timestamp": "07:16:32", "text": "设想。如果我处在他们的位置，我会怎么做？"}, {"type": "subtitle", "time": 26194.91, "timestamp": "07:16:34", "text": "我会这么做吗？有点儿"}, {"type": "subtitle", "time": 26202.51, "timestamp": "07:16:42", "text": "那么，我当时在做什么呢？呃，我"}]
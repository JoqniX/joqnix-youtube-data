[{"type": "subtitle", "time": 2109.87, "timestamp": "00:35:09", "text": "开玩笑。霓虹菲律宾人"}, {"type": "subtitle", "time": 2120.87, "timestamp": "00:35:20", "text": "好的。所以对于这些镜头，我们必须……"}, {"type": "subtitle", "time": 2137.51, "timestamp": "00:35:37", "text": "某物。另一个游戏是什么？"}, {"type": "subtitle", "time": 2139.109, "timestamp": "00:35:39", "text": "那是什么？那是什么？是什么"}, {"type": "subtitle", "time": 2144.589, "timestamp": "00:35:44", "text": "那个小玩意儿？"}, {"type": "subtitle", "time": 2147.87, "timestamp": "00:35:47", "text": "定位者。科桑特"}, {"type": "subtitle", "time": 2155.71, "timestamp": "00:35:55", "text": "姓名。科恩“嗯，”他腼腆地说。对，就是那个。"}]
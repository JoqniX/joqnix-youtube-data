[{"type": "subtitle", "time": 25747.19, "timestamp": "07:09:07", "text": "呃，所以你把那叫做房子吗？"}, {"type": "subtitle", "time": 25750.35, "timestamp": "07:09:10", "text": "那是一栋房子，对吧？"}, {"type": "subtitle", "time": 25754.31, "timestamp": "07:09:14", "text": "是的。一楼，地面层。那是"}, {"type": "subtitle", "time": 25756.75, "timestamp": "07:09:16", "text": "房子会是什么样子？"}, {"type": "subtitle", "time": 25759.35, "timestamp": "07:09:19", "text": "正确的？哦，原来是那套公寓。我不"}, {"type": "subtitle", "time": 25762.468, "timestamp": "07:09:22", "text": "知道。不是最近发生的。不，不，不，不。"}, {"type": "subtitle", "time": 25763.91, "timestamp": "07:09:23", "text": "当然不是。"}, {"type": "subtitle", "time": 25766.07, "timestamp": "07:09:26", "text": "这已经过去多少年了？这如何"}, {"type": "subtitle", "time": 25767.708, "timestamp": "07:09:27", "text": "地方有"}, {"type": "subtitle", "time": 25770.868, "timestamp": "07:09:30", "text": "到过？当我还是个小婴儿的时候。"}, {"type": "subtitle", "time": 25773.07, "timestamp": "07:09:33", "text": "之前从未有过我"}, {"type": "subtitle", "time": 25775.99, "timestamp": "07:09:35", "text": "出生。是的，早在我还是个孩子之前。"}, {"type": "subtitle", "time": 25780.51, "timestamp": "07:09:40", "text": "出生。我想当我妈妈和"}, {"type": "subtitle", "time": 25782.99, "timestamp": "07:09:42", "text": "爸爸"}, {"type": "subtitle", "time": 25785.868, "timestamp": "07:09:45", "text": "结婚前或结婚后"}, {"type": "subtitle", "time": 25789.43, "timestamp": "07:09:49", "text": "已婚。那大概有多少年了？"}, {"type": "subtitle", "time": 25793.75, "timestamp": "07:09:53", "text": "我不知道。那就像19世纪一样"}, {"type": "subtitle", "time": 25796.83, "timestamp": "07:09:56", "text": "1980年。不，"}]
[{"type": "subtitle", "time": 25200.35, "timestamp": "07:00:00", "text": "这时我感觉"}, {"type": "subtitle", "time": 25202.11, "timestamp": "07:00:02", "text": "就像我"}, {"type": "subtitle", "time": 25204.788, "timestamp": "07:00:04", "text": "应该，因为呃，那里正在施工，而且"}, {"type": "subtitle", "time": 25206.17, "timestamp": "07:00:06", "text": "我家发生了一些事。"}, {"type": "subtitle", "time": 25207.99, "timestamp": "07:00:07", "text": "[掌声]"}, {"type": "subtitle", "time": 25210.43, "timestamp": "07:00:10", "text": "此时，我觉得我应该问一下"}, {"type": "subtitle", "time": 25214.07, "timestamp": "07:00:14", "text": "让他们像制造厂一样建造"}, {"type": "subtitle", "time": 25215.868, "timestamp": "07:00:15", "text": "人们喜欢建造"}, {"type": "subtitle", "time": 25219.27, "timestamp": "07:00:19", "text": "我喜欢金属之类的东西。"}, {"type": "subtitle", "time": 25221.27, "timestamp": "07:00:21", "text": "他们会焊接之类的，而且喜欢"}, {"type": "subtitle", "time": 25223.59, "timestamp": "07:00:23", "text": "做点什么吧？但你不能"}, {"type": "subtitle", "time": 25226.59, "timestamp": "07:00:26", "text": "利用金属熔化金属，"}, {"type": "subtitle", "time": 25229.99, "timestamp": "07:00:29", "text": "正确的？因为对于电子产品来说，你需要"}, {"type": "subtitle", "time": 25233.59, "timestamp": "07:00:33", "text": "那种特定的铝，不管是什么类型的"}, {"type": "subtitle", "time": 25240.46, "timestamp": "07:00:40", "text": "我不知道。我其实没有"}, {"type": "subtitle", "time": 25248.83, "timestamp": "07:00:48", "text": "知道。城市"}, {"type": "subtitle", "time": 25252.23, "timestamp": "07:00:52", "text": "向上。啊，埃拉城那家伙没来。"}, {"type": "subtitle", "time": 25254.948, "timestamp": "07:00:54", "text": "然而。埃拉城那个人应该"}, {"type": "subtitle", "time": 25258.31, "timestamp": "07:00:58", "text": "快来吧。所以，我想，总有一天吧。所以，"}]
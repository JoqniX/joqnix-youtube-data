[{"type": "subtitle", "time": 1862.51, "timestamp": "00:31:02", "text": "语言。我甚至不知道"}, {"type": "subtitle", "time": 1865.51, "timestamp": "00:31:05", "text": "印地语。我只跟你们说话"}, {"type": "subtitle", "time": 1868.51, "timestamp": "00:31:08", "text": "直播，英语进行。"}, {"type": "subtitle", "time": 1872.95, "timestamp": "00:31:12", "text": "不。是的。日语仅在以下情况下使用："}, {"type": "subtitle", "time": 1874.029, "timestamp": "00:31:14", "text": "我是"}, {"type": "subtitle", "time": 1877.75, "timestamp": "00:31:17", "text": "了解东京迪士尼乐园。"}, {"type": "subtitle", "time": 1879.71, "timestamp": "00:31:19", "text": "必须走了。啊，"}]
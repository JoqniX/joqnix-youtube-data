[{"type": "subtitle", "time": 25621.35, "timestamp": "07:07:01", "text": "翻新后的效果会是这样的。和"}, {"type": "subtitle", "time": 25624.07, "timestamp": "07:07:04", "text": "这个房间，这扇门，你看"}, {"type": "subtitle", "time": 25627.19, "timestamp": "07:07:07", "text": "我的房间就在那里。呃"}, {"type": "subtitle", "time": 25629.35, "timestamp": "07:07:09", "text": "对，就是那个方框"}, {"type": "subtitle", "time": 25632.628, "timestamp": "07:07:12", "text": "我想应该是什么东西。呃，那边。是的。所以，"}, {"type": "subtitle", "time": 25634.708, "timestamp": "07:07:14", "text": "这一切都会因人而异。"}, {"type": "subtitle", "time": 25635.708, "timestamp": "07:07:15", "text": "渲染"}, {"type": "subtitle", "time": 25638.788, "timestamp": "07:07:18", "text": "我想，应该是人吧。是的。以前是"}, {"type": "subtitle", "time": 25641.708, "timestamp": "07:07:21", "text": "保持开放的心态。现在他们真的"}, {"type": "subtitle", "time": 25645.67, "timestamp": "07:07:25", "text": "把它盖起来之类的。"}, {"type": "subtitle", "time": 25648.548, "timestamp": "07:07:28", "text": "看起来不像是这样。"}, {"type": "subtitle", "time": 25650.39, "timestamp": "07:07:30", "text": "房子看起来会是这样的。这是"}, {"type": "subtitle", "time": 25652.91, "timestamp": "07:07:32", "text": "实际上就是整个线框图。"}, {"type": "subtitle", "time": 25656.788, "timestamp": "07:07:36", "text": "车库，也就是停放汽车的地方。现在"}, {"type": "subtitle", "time": 25659.59, "timestamp": "07:07:39", "text": "他们正在建造类似停车场的建筑。"}, {"type": "subtitle", "time": 25662.07, "timestamp": "07:07:42", "text": "区域。所以才装了双扇门。"}, {"type": "subtitle", "time": 25665.07, "timestamp": "07:07:45", "text": "他们拆毁了那扇古老的单扇大门。"}, {"type": "subtitle", "time": 25668.15, "timestamp": "07:07:48", "text": "东西。是的。现在他们放了这种东西"}, {"type": "subtitle", "time": 25670.39, "timestamp": "07:07:50", "text": "新型推拉门之类的东西"}, {"type": "subtitle", "time": 25671.948, "timestamp": "07:07:51", "text": "他们称之为"}, {"type": "subtitle", "time": 25676.708, "timestamp": "07:07:56", "text": "它。是啊，这很难。"}]
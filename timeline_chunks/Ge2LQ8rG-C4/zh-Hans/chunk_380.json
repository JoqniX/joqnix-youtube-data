[{"type": "subtitle", "time": 22807.31, "timestamp": "06:20:07", "text": "呃，我可以移除"}, {"type": "subtitle", "time": 22815.23, "timestamp": "06:20:15", "text": "[音乐]"}, {"type": "subtitle", "time": 22824.628, "timestamp": "06:20:24", "text": "我好害怕打开这样的网站。"}, {"type": "subtitle", "time": 22828.07, "timestamp": "06:20:28", "text": "因为你知道吗，如果他们切断我的联系怎么办？"}, {"type": "subtitle", "time": 22829.548, "timestamp": "06:20:29", "text": "又是比利"}, {"type": "subtitle", "time": 22833.43, "timestamp": "06:20:33", "text": "比利，即使他们也会像上面说的那样。"}, {"type": "subtitle", "time": 22836.51, "timestamp": "06:20:36", "text": "违反外国网站规定"}, {"type": "subtitle", "time": 22846.11, "timestamp": "06:20:46", "text": "害怕，所以这两个人是主角"}, {"type": "subtitle", "time": 22849.868, "timestamp": "06:20:49", "text": "好吧，所以我把她放进去了。"}, {"type": "subtitle", "time": 22854.99, "timestamp": "06:20:54", "text": "在。我知道我需要删除，我会删除"}, {"type": "subtitle", "time": 22858.09, "timestamp": "06:20:58", "text": "你"}]
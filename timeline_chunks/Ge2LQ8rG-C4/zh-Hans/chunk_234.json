[{"type": "subtitle", "time": 14041.349, "timestamp": "03:54:01", "text": "我本来想那样做，但现在我……"}, {"type": "subtitle", "time": 14044.99, "timestamp": "03:54:04", "text": "只是数量上的增加"}, {"type": "subtitle", "time": 14049.15, "timestamp": "03:54:09", "text": "因为这是我自己做的实验，所以质量有保证。"}, {"type": "subtitle", "time": 14050.67, "timestamp": "03:54:10", "text": "现在"}, {"type": "subtitle", "time": 14052.189, "timestamp": "03:54:12", "text": "因为"}, {"type": "subtitle", "time": 14055.55, "timestamp": "03:54:15", "text": "等我看完 YouTube 和 Twitch 之后……"}, {"type": "subtitle", "time": 14057.79, "timestamp": "03:54:17", "text": "剪辑，进入"}, {"type": "subtitle", "time": 14061.03, "timestamp": "03:54:21", "text": "最后，我可能要停止上传视频了。"}, {"type": "subtitle", "time": 14063.63, "timestamp": "03:54:23", "text": "剪辑节目"}, {"type": "subtitle", "time": 14067.91, "timestamp": "03:54:27", "text": "打完针后，我会……"}, {"type": "subtitle", "time": 14071.11, "timestamp": "03:54:31", "text": "可能会转而生产高质量产品。"}, {"type": "subtitle", "time": 14075.11, "timestamp": "03:54:35", "text": "但问题是，我怎样才能获得高质量的产品呢？"}, {"type": "subtitle", "time": 14077.67, "timestamp": "03:54:37", "text": "我连剪辑之类的时间都没有。"}, {"type": "subtitle", "time": 14084.63, "timestamp": "03:54:44", "text": "也。上帝啊，怎么办？我没有"}, {"type": "subtitle", "time": 14087.309, "timestamp": "03:54:47", "text": "任何愿意帮忙的人"}, {"type": "subtitle", "time": 14089.75, "timestamp": "03:54:49", "text": "我。我最终还是得这么做。"}, {"type": "subtitle", "time": 14092.15, "timestamp": "03:54:52", "text": "再次委托他人。"}, {"type": "subtitle", "time": 14094.71, "timestamp": "03:54:54", "text": "[音乐]"}, {"type": "subtitle", "time": 14096.87, "timestamp": "03:54:56", "text": "但问题是，我现在只是"}, {"type": "subtitle", "time": 14097.79, "timestamp": "03:54:57", "text": "想要"}]
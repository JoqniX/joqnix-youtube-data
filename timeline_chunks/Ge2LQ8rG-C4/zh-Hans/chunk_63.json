[{"type": "subtitle", "time": 3798.549, "timestamp": "01:03:18", "text": "这样做。我得留下来。我得留下来。我"}, {"type": "subtitle", "time": 3802.15, "timestamp": "01:03:22", "text": "留宿。我，我的朋友，伙计。你想要"}, {"type": "subtitle", "time": 3816.6, "timestamp": "01:03:36", "text": "块茎？我能从中得到哪一个？"}, {"type": "subtitle", "time": 3826.829, "timestamp": "01:03:46", "text": "我"}, {"type": "subtitle", "time": 3834.99, "timestamp": "01:03:54", "text": "朋友"}]
[{"type": "subtitle", "time": 8905.27, "timestamp": "02:28:25", "text": "女士。好了，至此我们正式"}, {"type": "subtitle", "time": 8924.95, "timestamp": "02:28:44", "text": "你好。现在，五旁边就是十了。"}, {"type": "subtitle", "time": 8929.79, "timestamp": "02:28:49", "text": "接下来是五个。然后是五和"}, {"type": "subtitle", "time": 8935.51, "timestamp": "02:28:55", "text": "goi。我们就这样到达了这里。所以，1 2 3"}, {"type": "subtitle", "time": 8936.67, "timestamp": "02:28:56", "text": "4"}]
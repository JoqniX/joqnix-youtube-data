[{"type": "subtitle", "time": 13144.429, "timestamp": "03:39:04", "text": "看了很多，这很酷。鸽子模式。"}, {"type": "subtitle", "time": 13149.07, "timestamp": "03:39:09", "text": "嗯，是的，我可以把这个问题技术性地解释清楚。"}, {"type": "subtitle", "time": 13151.59, "timestamp": "03:39:11", "text": "美好的。问题是我现在不想……"}, {"type": "subtitle", "time": 13154.15, "timestamp": "03:39:14", "text": "展示一下我擅长的菜肴"}, {"type": "subtitle", "time": 13156.95, "timestamp": "03:39:16", "text": "电脑之类的东西。我不知道，我知道"}, {"type": "subtitle", "time": 13161.71, "timestamp": "03:39:21", "text": "大家都跟我说医生，你应该……"}, {"type": "subtitle", "time": 13163.99, "timestamp": "03:39:23", "text": "教程，这样你就不必总是"}, {"type": "subtitle", "time": 13167.51, "timestamp": "03:39:27", "text": "烦你。我就像如果我把门打开一样。"}, {"type": "subtitle", "time": 13171.67, "timestamp": "03:39:31", "text": "因此，人们会更喜欢这样，而不是这样。"}, {"type": "subtitle", "time": 13173.75, "timestamp": "03:39:33", "text": "与其说是欣赏我的内容，不如说是……"}, {"type": "subtitle", "time": 13175.75, "timestamp": "03:39:35", "text": "我该怎么做这个？我该怎么做那个？"}, {"type": "subtitle", "time": 13178.87, "timestamp": "03:39:38", "text": "我会的，他们会像那样做。"}, {"type": "subtitle", "time": 13181.269, "timestamp": "03:39:41", "text": "我不想那样，我希望你享受我的"}, {"type": "subtitle", "time": 13184.71, "timestamp": "03:39:44", "text": "如果你需要的话，请尽可能提供一些东西。"}, {"type": "subtitle", "time": 13187.15, "timestamp": "03:39:47", "text": "我会帮助你，就像"}, {"type": "subtitle", "time": 13190.99, "timestamp": "03:39:50", "text": "就像人们总是可以剪辑我的"}, {"type": "subtitle", "time": 13192.67, "timestamp": "03:39:52", "text": "东西"}, {"type": "subtitle", "time": 13196.55, "timestamp": "03:39:56", "text": "很快我就不知道了。嗯，我担心如果我去的话。"}]
[{"type": "subtitle", "time": 241.27, "timestamp": "00:04:01", "text": "我感觉自己好像要切换到睡眠模式了。"}, {"type": "subtitle", "time": 244.03, "timestamp": "00:04:04", "text": "或者鲍比的场景"}, {"type": "subtitle", "time": 247.03, "timestamp": "00:04:07", "text": "或者我能否更进一步。"}, {"type": "subtitle", "time": 251.35, "timestamp": "00:04:11", "text": "如果我愿意，我可以让它检测到我的"}, {"type": "subtitle", "time": 252.75, "timestamp": "00:04:12", "text": "麦克风"}, {"type": "subtitle", "time": 255.75, "timestamp": "00:04:15", "text": "东西。如果我的麦克风音源被静音，或者如果"}, {"type": "subtitle", "time": 258.87, "timestamp": "00:04:18", "text": "我的物理麦克风已静音，而且"}, {"type": "subtitle", "time": 261.189, "timestamp": "00:04:21", "text": "我说，如果我说的不是比"}, {"type": "subtitle", "time": 263.43, "timestamp": "00:04:23", "text": "大概十分钟左右，我可以搞定。"}, {"type": "subtitle", "time": 266.629, "timestamp": "00:04:26", "text": "打开那个文字显示开关"}, {"type": "subtitle", "time": 269.749, "timestamp": "00:04:29", "text": "就像一幅画一样"}, {"type": "subtitle", "time": 272.749, "timestamp": "00:04:32", "text": "或者某种图像"}, {"type": "subtitle", "time": 275.43, "timestamp": "00:04:35", "text": "类似图片之类的物品"}, {"type": "subtitle", "time": 279.51, "timestamp": "00:04:39", "text": "突然冒出来，说“嗯，这是……”"}, {"type": "subtitle", "time": 283.27, "timestamp": "00:04:43", "text": "VOD 狗目前不在场"}, {"type": "subtitle", "time": 285.67, "timestamp": "00:04:45", "text": "框架之类的东西。我们可以"}, {"type": "subtitle", "time": 287.23, "timestamp": "00:04:47", "text": "类似这样"}, {"type": "subtitle", "time": 289.15, "timestamp": "00:04:49", "text": "那。"}]
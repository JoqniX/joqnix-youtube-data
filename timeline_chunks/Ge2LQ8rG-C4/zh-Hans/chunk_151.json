[{"type": "subtitle", "time": 9077.11, "timestamp": "02:31:17", "text": "最后一名幸存者。我的天啊，他"}, {"type": "subtitle", "time": 9079.67, "timestamp": "02:31:19", "text": "简直完全压制了那两个人。"}, {"type": "subtitle", "time": 9081.87, "timestamp": "02:31:21", "text": "人们。哦，我的"}, {"type": "subtitle", "time": 9087.05, "timestamp": "02:31:27", "text": "上帝。狗狗突然开始训练。"}]
[{"type": "subtitle", "time": 15748.229, "timestamp": "04:22:28", "text": "拉。现在是2点15分。患病的"}, {"type": "subtitle", "time": 15749.99, "timestamp": "04:22:29", "text": "赶紧把这个做完然后去睡觉吧，我"}, {"type": "subtitle", "time": 15752.67, "timestamp": "04:22:32", "text": "猜测。所以，从某种意义上说，我们上传了"}, {"type": "subtitle", "time": 15757.07, "timestamp": "04:22:37", "text": "15 作为补偿"}, {"type": "subtitle", "time": 15760.189, "timestamp": "04:22:40", "text": "昨天我没做什么"}, {"type": "subtitle", "time": 15765.07, "timestamp": "04:22:45", "text": "镜头。最终，我会阻止它。"}]
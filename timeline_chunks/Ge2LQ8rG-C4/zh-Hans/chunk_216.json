[{"type": "subtitle", "time": 12965.229, "timestamp": "03:36:05", "text": "早晨。"}, {"type": "subtitle", "time": 12968.309, "timestamp": "03:36:08", "text": "我。是的，是120。我要上传了。"}, {"type": "subtitle", "time": 12970.83, "timestamp": "03:36:10", "text": "再剪辑10个片段就走"}, {"type": "subtitle", "time": 12973.63, "timestamp": "03:36:13", "text": "扫。所以，一共20个片段。"}, {"type": "subtitle", "time": 12976.229, "timestamp": "03:36:16", "text": "今天。从昨天开始我就没做了。"}, {"type": "subtitle", "time": 12992.67, "timestamp": "03:36:32", "text": "[音乐]"}, {"type": "subtitle", "time": 12995.58, "timestamp": "03:36:35", "text": "中国"}]
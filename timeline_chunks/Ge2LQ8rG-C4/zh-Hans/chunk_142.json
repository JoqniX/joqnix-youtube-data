[{"type": "subtitle", "time": 8540.95, "timestamp": "02:22:20", "text": "好了，最后一个。那就是"}, {"type": "subtitle", "time": 8543.91, "timestamp": "02:22:23", "text": "我的朋友，伙计。你想得到这份工作吗？"}, {"type": "subtitle", "time": 8546.309, "timestamp": "02:22:26", "text": "你想成为一名优秀的V级士兵吗？必须"}, {"type": "subtitle", "time": 8553.07, "timestamp": "02:22:33", "text": "知道，添加"}, {"type": "subtitle", "time": 8556.15, "timestamp": "02:22:36", "text": "可产生收益的。你必须给我们提供一些"}, {"type": "subtitle", "time": 8557.67, "timestamp": "02:22:37", "text": "那些真正会是的时刻"}, {"type": "subtitle", "time": 8560.71, "timestamp": "02:22:40", "text": "对你的观众来说有趣。"}, {"type": "subtitle", "time": 8563.51, "timestamp": "02:22:43", "text": "告诉我们你为什么情绪低落。"}, {"type": "subtitle", "time": 8565.99, "timestamp": "02:22:45", "text": "菲律宾女性？我的意思是，我的意思是这"}, {"type": "subtitle", "time": 8569.19, "timestamp": "02:22:49", "text": "发型就像哦，我，我，我之前只是"}, {"type": "subtitle", "time": 8572.87, "timestamp": "02:22:52", "text": "他说我非常适合短波波头。"}, {"type": "subtitle", "time": 8578.469, "timestamp": "02:22:58", "text": "我喜欢你颤抖的样子"}]
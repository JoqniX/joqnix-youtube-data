[{"type": "subtitle", "time": 21060.548, "timestamp": "05:51:00", "text": "虽然有点伤感。如果那是我"}, {"type": "subtitle", "time": 21063.07, "timestamp": "05:51:03", "text": "如果真是那样，那我就会非常高兴。"}, {"type": "subtitle", "time": 21066.39, "timestamp": "05:51:06", "text": "快乐的。所以，如果你喜欢它，那就是"}, {"type": "subtitle", "time": 21068.39, "timestamp": "05:51:08", "text": "比如，如果你像某个人一样停止了行动"}, {"type": "subtitle", "time": 21070.788, "timestamp": "05:51:10", "text": "先玩一会儿这个游戏，然后"}, {"type": "subtitle", "time": 21072.708, "timestamp": "05:51:12", "text": "你积压了好多任务。"}, {"type": "subtitle", "time": 21074.91, "timestamp": "05:51:14", "text": "你只想"}, {"type": "subtitle", "time": 21078.31, "timestamp": "05:51:18", "text": "慢慢地完成其中一个任务。"}, {"type": "subtitle", "time": 21081.03, "timestamp": "05:51:21", "text": "一次处理一件事，而不是同时处理多项任务"}, {"type": "subtitle", "time": 21083.91, "timestamp": "05:51:23", "text": "在多个任务之间。是啊，我希望"}, {"type": "subtitle", "time": 21086.31, "timestamp": "05:51:26", "text": "我刚才说的就是这个功能，如果那……"}, {"type": "subtitle", "time": 21095.11, "timestamp": "05:51:35", "text": "我知道，因为NPC会更忙或者类似的事情"}, {"type": "subtitle", "time": 21097.83, "timestamp": "05:51:37", "text": "在不同的地区或不同的地方"}, {"type": "subtitle", "time": 21100.868, "timestamp": "05:51:40", "text": "因为一项特定的任务。一种方式"}, {"type": "subtitle", "time": 21105.67, "timestamp": "05:51:45", "text": "把他们重定向回去，或者就像……呃"}, {"type": "subtitle", "time": 21114.35, "timestamp": "05:51:54", "text": "呃，请求告知服务时间"}, {"type": "subtitle", "time": 21117.51, "timestamp": "05:51:57", "text": "第 78 季度的情况有很多"}, {"type": "subtitle", "time": 21118.948, "timestamp": "05:51:58", "text": "我们需要知道的信息我们将"}]
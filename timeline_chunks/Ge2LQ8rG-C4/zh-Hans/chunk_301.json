[{"type": "subtitle", "time": 18066.73, "timestamp": "05:01:06", "text": "睡觉？我意识到我有多糟糕"}, {"type": "subtitle", "time": 18074.27, "timestamp": "05:01:14", "text": "唱歌。我意识到我唱歌有多难听。"}, {"type": "subtitle", "time": 18077.19, "timestamp": "05:01:17", "text": "啊，有趣的是我从来没听过"}, {"type": "subtitle", "time": 18079.07, "timestamp": "05:01:19", "text": "我自己的"}, {"type": "subtitle", "time": 18081.91, "timestamp": "05:01:21", "text": "歌唱。而当我这样做时，我会感到羞愧难当，甚至死去。"}, {"type": "subtitle", "time": 18085.11, "timestamp": "05:01:25", "text": "里面。我感觉自己像只吱吱叫的小鸟。"}, {"type": "subtitle", "time": 18086.83, "timestamp": "05:01:26", "text": "尝试"}, {"type": "subtitle", "time": 18095.788, "timestamp": "05:01:35", "text": "上帝。卡尼"}, {"type": "subtitle", "time": 18106.43, "timestamp": "05:01:46", "text": "兄弟，老兄。疯狂的"}]
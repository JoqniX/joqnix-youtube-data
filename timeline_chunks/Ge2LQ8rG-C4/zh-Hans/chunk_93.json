[{"type": "subtitle", "time": 5581.27, "timestamp": "01:33:01", "text": "我想这就是我要说的，这就是我想说的。"}, {"type": "subtitle", "time": 5620.83, "timestamp": "01:33:40", "text": "问题是我不想"}, {"type": "subtitle", "time": 5625.629, "timestamp": "01:33:45", "text": "不胜枚举"}, {"type": "subtitle", "time": 5629.31, "timestamp": "01:33:49", "text": "他们。我想，但又不想"}, {"type": "subtitle", "time": 5632.43, "timestamp": "01:33:52", "text": "到。你感觉"}, {"type": "subtitle", "time": 5636.149, "timestamp": "01:33:56", "text": "我？我想去，但又不想去。"}]
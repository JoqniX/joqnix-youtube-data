[{"type": "subtitle", "time": 9368.19, "timestamp": "02:36:08", "text": "[音乐]"}, {"type": "subtitle", "time": 9371.71, "timestamp": "02:36:11", "text": "流媒体。等等，难道我只是"}, {"type": "subtitle", "time": 9374.389, "timestamp": "02:36:14", "text": "流媒体？等等，这是恒星共振吗？"}, {"type": "subtitle", "time": 9376.99, "timestamp": "02:36:16", "text": "我的天啊，他正在演奏《我的天啊》。"}, {"type": "subtitle", "time": 9380.07, "timestamp": "02:36:20", "text": "什么？我连邀请都没收到。我正在"}, {"type": "subtitle", "time": 9382.67, "timestamp": "02:36:22", "text": "比利·布利和我甚至都没能得到"}, {"type": "subtitle", "time": 9385.95, "timestamp": "02:36:25", "text": "受邀加入浪人队"}, {"type": "subtitle", "time": 9391.349, "timestamp": "02:36:31", "text": "弗吉尼亚州。我该怎么做才能得到一个中国"}, {"type": "subtitle", "time": 9398.389, "timestamp": "02:36:38", "text": "九子？我想玩。这是我的"}, {"type": "subtitle", "time": 9401.23, "timestamp": "02:36:41", "text": "最喜欢的角色扮演网游"}, {"type": "subtitle", "time": 9405.349, "timestamp": "02:36:45", "text": "RPG蓝色协议。"}, {"type": "subtitle", "time": 9413.19, "timestamp": "02:36:53", "text": "当我玩日版的时候，我真的"}]
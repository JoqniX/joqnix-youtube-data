[{"type": "subtitle", "time": 3662.069, "timestamp": "01:01:02", "text": "我刚才是不是说了，就像那样？"}, {"type": "subtitle", "time": 3669.03, "timestamp": "01:01:09", "text": "这些视频太劲爆了！就是你"}, {"type": "subtitle", "time": 3681.87, "timestamp": "01:01:21", "text": "操屁眼。你得到了"}, {"type": "subtitle", "time": 3695.64, "timestamp": "01:01:35", "text": "你得到了 随心所欲"}, {"type": "subtitle", "time": 3702.309, "timestamp": "01:01:42", "text": "你想要什么，你就得拿什么。"}, {"type": "subtitle", "time": 3705.19, "timestamp": "01:01:45", "text": "你想要什么。是的。说出来。说出来，乔。"}, {"type": "subtitle", "time": 3708.75, "timestamp": "01:01:48", "text": "你想说出来。"}, {"type": "subtitle", "time": 3716.43, "timestamp": "01:01:56", "text": "你是"}, {"type": "subtitle", "time": 3718.789, "timestamp": "01:01:58", "text": "真的感觉像个受虐狂，老兄。你"}]
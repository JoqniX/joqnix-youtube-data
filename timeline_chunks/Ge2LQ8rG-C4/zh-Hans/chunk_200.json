[{"type": "subtitle", "time": 12002.68, "timestamp": "03:20:02", "text": "D. D."}, {"type": "subtitle", "time": 12034.15, "timestamp": "03:20:34", "text": "塔。好的，我们现在在N。"}, {"type": "subtitle", "time": 12035.95, "timestamp": "03:20:35", "text": "射击或"}, {"type": "subtitle", "time": 12039.03, "timestamp": "03:20:39", "text": "真实的。等等，什么？好的。看着我"}, {"type": "subtitle", "time": 12040.95, "timestamp": "03:20:40", "text": "睁开眼睛告诉我你不是"}, {"type": "subtitle", "time": 12042.91, "timestamp": "03:20:42", "text": "底部。我是"}, {"type": "subtitle", "time": 12047.349, "timestamp": "03:20:47", "text": "不听底部的声音。"}]
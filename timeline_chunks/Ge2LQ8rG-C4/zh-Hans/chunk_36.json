[{"type": "subtitle", "time": 2160.15, "timestamp": "00:36:00", "text": "事物。我忘了。布雷特告诉我该怎么做"}, {"type": "subtitle", "time": 2161.55, "timestamp": "00:36:01", "text": "发音"}, {"type": "subtitle", "time": 2164.63, "timestamp": "00:36:04", "text": "它。另一个游戏是什么？是什么"}, {"type": "subtitle", "time": 2167.15, "timestamp": "00:36:07", "text": "那？那是什么？那是什么？"}, {"type": "subtitle", "time": 2171.47, "timestamp": "00:36:11", "text": "那玩意儿？什么玩意儿。"}, {"type": "subtitle", "time": 2179.71, "timestamp": "00:36:19", "text": "波扬特。那是"}, {"type": "subtitle", "time": 2188.19, "timestamp": "00:36:28", "text": "兄弟。那是一个很不错的人。"}, {"type": "subtitle", "time": 2191.87, "timestamp": "00:36:31", "text": "经过。谢谢光临"}, {"type": "subtitle", "time": 2194.87, "timestamp": "00:36:34", "text": "经过。我感到孤独。难以置信，竟然没有人"}, {"type": "subtitle", "time": 2196.99, "timestamp": "00:36:36", "text": "即将到来"}, {"type": "subtitle", "time": 2200.23, "timestamp": "00:36:40", "text": "我的天，我只是开玩笑。我不该说这话。"}]
[{"type": "subtitle", "time": 8821.19, "timestamp": "02:27:01", "text": "你想得到这份工作，你想成为一名……"}, {"type": "subtitle", "time": 8823.91, "timestamp": "02:27:03", "text": "好样的，V 部队队员，你得说点什么。"}, {"type": "subtitle", "time": 8831.349, "timestamp": "02:27:11", "text": "我喜欢打断你这件事。"}, {"type": "subtitle", "time": 8833.63, "timestamp": "02:27:13", "text": "必须提供"}, {"type": "subtitle", "time": 8838.07, "timestamp": "02:27:18", "text": "有一次我用脚桨，那就是"}, {"type": "subtitle", "time": 8840.23, "timestamp": "02:27:20", "text": "什么？你为什么情绪低落？"}, {"type": "subtitle", "time": 8844.11, "timestamp": "02:27:24", "text": "菲律宾女性？我的意思是，我的意思是这"}, {"type": "subtitle", "time": 8847.83, "timestamp": "02:27:27", "text": "发型，脚踏板。我应该"}, {"type": "subtitle", "time": 8850.19, "timestamp": "02:27:30", "text": "不知道该怎么办"}, {"type": "subtitle", "time": 8853.71, "timestamp": "02:27:33", "text": "做。合作直播，它的聊天功能不是"}, {"type": "subtitle", "time": 8861.11, "timestamp": "02:27:41", "text": "次要的。但有些人却不明白。"}, {"type": "subtitle", "time": 8864.309, "timestamp": "02:27:44", "text": "他们抱怨。哦，你无视我了。"}, {"type": "subtitle", "time": 8865.99, "timestamp": "02:27:45", "text": "还有一些其他的东西。"}, {"type": "subtitle", "time": 8869.19, "timestamp": "02:27:49", "text": "这就是我买它的唯一原因。"}, {"type": "subtitle", "time": 8871.99, "timestamp": "02:27:51", "text": "踩下脚踏板，我就可以和聊天对象对话了。"}, {"type": "subtitle", "time": 8874.67, "timestamp": "02:27:54", "text": "也可以和合作方谈谈。"}, {"type": "subtitle", "time": 8877.19, "timestamp": "02:27:57", "text": "米奇和我甚至都没用脚。"}, {"type": "subtitle", "time": 8878.91, "timestamp": "02:27:58", "text": "踏板"}]
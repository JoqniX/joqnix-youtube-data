[{"type": "subtitle", "time": 20880.708, "timestamp": "05:48:00", "text": "那些不知道的人，在根山，如果我"}, {"type": "subtitle", "time": 20883.11, "timestamp": "05:48:03", "text": "去做个活动任务之类的"}, {"type": "subtitle", "time": 20886.47, "timestamp": "05:48:06", "text": "因为我有很多性格特点。"}, {"type": "subtitle", "time": 20889.99, "timestamp": "05:48:09", "text": "任务、剧情任务和世界任务……呃"}, {"type": "subtitle", "time": 20893.99, "timestamp": "05:48:13", "text": "在我的《原神》里，因为那个……"}, {"type": "subtitle", "time": 20896.868, "timestamp": "05:48:16", "text": "他们会把它锁起来。我的探索"}, {"type": "subtitle", "time": 20899.19, "timestamp": "05:48:19", "text": "我想做的会被锁定，就像这样"}, {"type": "subtitle", "time": 20902.23, "timestamp": "05:48:22", "text": "NPC 正在进行其他任务或"}, {"type": "subtitle", "time": 20904.708, "timestamp": "05:48:24", "text": "好像正忙于另一项任务，或者"}, {"type": "subtitle", "time": 20907.11, "timestamp": "05:48:27", "text": "又是另一个任务之类的。你必须"}, {"type": "subtitle", "time": 20910.548, "timestamp": "05:48:30", "text": "去做那个任务，等等等等。"}, {"type": "subtitle", "time": 20913.47, "timestamp": "05:48:33", "text": "但是这款游戏，我的天哪，"}, {"type": "subtitle", "time": 20916.27, "timestamp": "05:48:36", "text": "最好的。我的天啊。不"}, {"type": "subtitle", "time": 20918.35, "timestamp": "05:48:38", "text": "方式。不"}, {"type": "subtitle", "time": 20924.47, "timestamp": "05:48:44", "text": "方式。但我还是感到困惑。我 我"}, {"type": "subtitle", "time": 20926.19, "timestamp": "05:48:46", "text": "仍然可疑"}, {"type": "subtitle", "time": 20931.948, "timestamp": "05:48:51", "text": "选项？"}, {"type": "subtitle", "time": 20935.27, "timestamp": "05:48:55", "text": "我希望它和我预想的一样。"}]
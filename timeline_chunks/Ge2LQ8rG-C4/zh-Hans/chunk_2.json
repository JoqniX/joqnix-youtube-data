[{"type": "subtitle", "time": 123.51, "timestamp": "00:02:03", "text": "文字说明这是一个V字形。"}, {"type": "subtitle", "time": 126.069, "timestamp": "00:02:06", "text": "我远离了直播，我不是"}, {"type": "subtitle", "time": 128.07, "timestamp": "00:02:08", "text": "目前正在直播或类似节目中"}, {"type": "subtitle", "time": 131.63, "timestamp": "00:02:11", "text": "就是这样。我当时在想，那会不会是……"}, {"type": "subtitle", "time": 134.869, "timestamp": "00:02:14", "text": "大家都同意吗？嗯，那或许"}, {"type": "subtitle", "time": 136.51, "timestamp": "00:02:16", "text": "帮助"}, {"type": "subtitle", "time": 140.07, "timestamp": "00:02:20", "text": "为了让那些人能够认出它"}, {"type": "subtitle", "time": 141.91, "timestamp": "00:02:21", "text": "正在观看。致所有正在观看的人"}, {"type": "subtitle", "time": 145.27, "timestamp": "00:02:25", "text": "我的直播被静音了，呃，就像谁，嗯，就像"}, {"type": "subtitle", "time": 148.79, "timestamp": "00:02:28", "text": "我觉得，如果没有音频的话，应该不行。"}, {"type": "subtitle", "time": 158.63, "timestamp": "00:02:38", "text": "嗯，我可以设置成这样，无论何时你"}, {"type": "subtitle", "time": 164.71, "timestamp": "00:02:44", "text": "信息。不，那样行不通。你好"}, {"type": "subtitle", "time": 167.869, "timestamp": "00:02:47", "text": "秋秋。欢迎来到直播间。"}, {"type": "subtitle", "time": 170.91, "timestamp": "00:02:50", "text": "你好。好的"}, {"type": "subtitle", "time": 175.42000000000002, "timestamp": "00:02:55", "text": "晚上。这是一件事。嗯"}, {"type": "subtitle", "time": 177.47, "timestamp": "00:02:57", "text": "[音乐]"}]
[{"type": "subtitle", "time": 23701.67, "timestamp": "06:35:01", "text": "是吗？因为我只剩最后一个了……"}, {"type": "subtitle", "time": 23704.868, "timestamp": "06:35:04", "text": "这是哪里？又一只鲍鱼。我们将"}, {"type": "subtitle", "time": 23707.07, "timestamp": "06:35:07", "text": "实际上去寻找"}, {"type": "subtitle", "time": 23709.23, "timestamp": "06:35:09", "text": "鲍勃蝇"}, {"type": "subtitle", "time": 23713.35, "timestamp": "06:35:13", "text": "目前100%是玛雅语。没错"}, {"type": "subtitle", "time": 23715.548, "timestamp": "06:35:15", "text": "第二。"}, {"type": "subtitle", "time": 23717.708, "timestamp": "06:35:17", "text": "是的。"}, {"type": "subtitle", "time": 23721.27, "timestamp": "06:35:21", "text": "嗯，是的。所以这意味着我必须"}, {"type": "subtitle", "time": 23723.948, "timestamp": "06:35:23", "text": "找到所有鲍勃苍蝇"}, {"type": "subtitle", "time": 23727.99, "timestamp": "06:35:27", "text": "再仔细检查一遍，看看是哪只蝴蝶。"}, {"type": "subtitle", "time": 23730.19, "timestamp": "06:35:30", "text": "我曾"}, {"type": "subtitle", "time": 23733.948, "timestamp": "06:35:33", "text": "错过了。我的主要猜测是"}, {"type": "subtitle", "time": 23737.07, "timestamp": "06:35:37", "text": "成为那个人"}, {"type": "subtitle", "time": 23740.948, "timestamp": "06:35:40", "text": "从这里这个地区来的。所以"}, {"type": "subtitle", "time": 23743.708, "timestamp": "06:35:43", "text": "我们再确认一下。"}, {"type": "subtitle", "time": 23746.59, "timestamp": "06:35:46", "text": "好的。因为你从不"}, {"type": "subtitle", "time": 23749.948, "timestamp": "06:35:49", "text": "知道。因为谁也说不准。"}, {"type": "subtitle", "time": 23753.788, "timestamp": "06:35:53", "text": "是的。幸好，我不需要点赞。"}, {"type": "subtitle", "time": 23756.548, "timestamp": "06:35:56", "text": "嗯，还好我不需要X版。"}, {"type": "subtitle", "time": 23759.27, "timestamp": "06:35:59", "text": "为了"}]
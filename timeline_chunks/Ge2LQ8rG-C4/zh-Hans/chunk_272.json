[{"type": "subtitle", "time": 16322.229, "timestamp": "04:32:02", "text": "我受够了。米娜差点又赢了。最后"}, {"type": "subtitle", "time": 16333.95, "timestamp": "04:32:13", "text": "我是"}, {"type": "subtitle", "time": 16337.349, "timestamp": "04:32:17", "text": "关于我，我会把V代表我做了"}, {"type": "subtitle", "time": 16339.189, "timestamp": "04:32:19", "text": "我会把它上传到Billy Billy，然后就走。"}, {"type": "subtitle", "time": 16340.349, "timestamp": "04:32:20", "text": "睡觉。"}, {"type": "subtitle", "time": 16343.51, "timestamp": "04:32:23", "text": "好的。我知道我的电脑运行吃力，"}, {"type": "subtitle", "time": 16346.189, "timestamp": "04:32:26", "text": "令人窒息等等"}, {"type": "subtitle", "time": 16352.95, "timestamp": "04:32:32", "text": "嗯，没关系。"}, {"type": "subtitle", "time": 16355.389, "timestamp": "04:32:35", "text": "最后"}]
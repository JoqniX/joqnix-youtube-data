[{"type": "subtitle", "time": 67.67, "timestamp": "00:01:07", "text": "不是？不过，还是要谢谢你的光临。"}, {"type": "subtitle", "time": 70.39, "timestamp": "00:01:10", "text": "呃，我不知道有没有人正在看。"}, {"type": "chat", "time": 71.138, "timestamp": "00:01:11", "author": "@AkiAki-l8u", "avatar": "https://yt4.ggpht.com/ytc/AIdro_nLOZiVoOnOY9sRG6PEfbeJQZgNEc94Ld_-R0YhapW-QHpFlNNHtQIwpPu8VJKX5wVYKg=s64-c-k-c0x00ffffff-no-rj", "message": "hiiii"}, {"type": "subtitle", "time": 72.91, "timestamp": "00:01:12", "text": "Twitch，但感谢所有……"}, {"type": "subtitle", "time": 75.31, "timestamp": "00:01:15", "text": "学习。真正意味着"}, {"type": "subtitle", "time": 78.91, "timestamp": "00:01:18", "text": "很多。我累死了，真的好累。"}, {"type": "subtitle", "time": 81.10900000000001, "timestamp": "00:01:21", "text": "你好。所以，有些事情我想……"}, {"type": "subtitle", "time": 83.51, "timestamp": "00:01:23", "text": "讨论。有些事情我想做"}, {"type": "subtitle", "time": 85.99, "timestamp": "00:01:25", "text": "现在讨论一下，我注意到"}, {"type": "subtitle", "time": 87.99, "timestamp": "00:01:27", "text": "大多数第一次观看直播的观众"}, {"type": "subtitle", "time": 91.51, "timestamp": "00:01:31", "text": "而大多数观众都不明白这是什么意思。"}, {"type": "subtitle", "time": 93.10900000000001, "timestamp": "00:01:33", "text": "正在举行活动，谁会来看我呢？"}, {"type": "subtitle", "time": 95.19, "timestamp": "00:01:35", "text": "第一次他们会搞不清楚我是不是"}, {"type": "subtitle", "time": 98.149, "timestamp": "00:01:38", "text": "即使有 V 在直播，"}, {"type": "subtitle", "time": 101.429, "timestamp": "00:01:41", "text": "在某些平台上置顶评论"}, {"type": "subtitle", "time": 103.27000000000001, "timestamp": "00:01:43", "text": "它们不支持插针。"}, {"type": "subtitle", "time": 107.67, "timestamp": "00:01:47", "text": "所以有些平台我忘了……呃……"}, {"type": "subtitle", "time": 110.789, "timestamp": "00:01:50", "text": "暂存评论，说明这是一个视频点播服务。"}, {"type": "subtitle", "time": 112.71000000000001, "timestamp": "00:01:52", "text": "我正在休息一段时间。所以，我"}, {"type": "subtitle", "time": 115.22999999999999, "timestamp": "00:01:55", "text": "我想我会做个类似小的东西"}, {"type": "subtitle", "time": 116.749, "timestamp": "00:01:56", "text": "弹出窗口"}, {"type": "subtitle", "time": 119.749, "timestamp": "00:01:59", "text": "类似弹出式窗口之类的东西"}]
[{"type": "subtitle", "time": 19020.91, "timestamp": "05:17:00", "text": "游戏为什么以及这个"}, {"type": "subtitle", "time": 19024.5, "timestamp": "05:17:04", "text": "呃，我喜欢限制流量，就像这样"}, {"type": "subtitle", "time": 19027.47, "timestamp": "05:17:07", "text": "[音乐]"}, {"type": "subtitle", "time": 19031.23, "timestamp": "05:17:11", "text": "不，我的天哪，总之，我们开始吧。"}, {"type": "subtitle", "time": 19034.788, "timestamp": "05:17:14", "text": "如果有任何音频问题，请告诉我。"}, {"type": "subtitle", "time": 19036.47, "timestamp": "05:17:16", "text": "听不到声音。好的，你们可以"}, {"type": "subtitle", "time": 19039.47, "timestamp": "05:17:19", "text": "请听音频。好的。"}, {"type": "subtitle", "time": 19042.07, "timestamp": "05:17:22", "text": "你好。有最新消息吗？我还没做"}, {"type": "subtitle", "time": 19044.47, "timestamp": "05:17:24", "text": "完成了日常任务之类的。我不知道。"}, {"type": "subtitle", "time": 19046.99, "timestamp": "05:17:26", "text": "我还没做我的"}, {"type": "subtitle", "time": 19049.19, "timestamp": "05:17:29", "text": "今日日报。有很多"}, {"type": "subtitle", "time": 19051.99, "timestamp": "05:17:31", "text": "但目标是……我们终于到达了"}, {"type": "subtitle", "time": 19055.67, "timestamp": "05:17:35", "text": "联盟等级30。是的，我们终于达到了。"}, {"type": "subtitle", "time": 19059.628, "timestamp": "05:17:39", "text": "工会级别30，我们将竭尽全力"}, {"type": "subtitle", "time": 19062.27, "timestamp": "05:17:42", "text": "今天。是的。你好。哦，早上好"}, {"type": "subtitle", "time": 19067.788, "timestamp": "05:17:47", "text": "MK12之子。等等，我错过了12K儿子吗？"}, {"type": "subtitle", "time": 19071.868, "timestamp": "05:17:51", "text": "欢迎。我叫你MK。我是"}, {"type": "subtitle", "time": 19075.51, "timestamp": "05:17:55", "text": "对不起。哦，是的。呃，欢迎。欢迎。"}, {"type": "subtitle", "time": 19078.27, "timestamp": "05:17:58", "text": "哦。好的"}]
[{"type": "subtitle", "time": 24428.43, "timestamp": "06:47:08", "text": "狗"}, {"type": "subtitle", "time": 24456.11, "timestamp": "06:47:36", "text": "任何事物？"}, {"type": "subtitle", "time": 24458.99, "timestamp": "06:47:38", "text": "呃，我简直就是"}, {"type": "subtitle", "time": 24462.75, "timestamp": "06:47:42", "text": "那里。它应该在呃的补丁里"}, {"type": "subtitle", "time": 24465.75, "timestamp": "06:47:45", "text": "是的，你应该在这里。但我认为我"}, {"type": "subtitle", "time": 24470.79, "timestamp": "06:47:50", "text": "收下了。好的，我们接受了。好的。"}, {"type": "subtitle", "time": 24472.708, "timestamp": "06:47:52", "text": "[音乐]"}]
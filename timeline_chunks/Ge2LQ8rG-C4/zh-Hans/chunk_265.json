[{"type": "subtitle", "time": 15913.349, "timestamp": "04:25:13", "text": "一。 SR是什么？"}, {"type": "subtitle", "time": 15916.469, "timestamp": "04:25:16", "text": "我之前甚至都不知道SR是什么。"}, {"type": "subtitle", "time": 15919.269, "timestamp": "04:25:19", "text": "那条溪流。所有人都跟我说过这套。"}, {"type": "subtitle", "time": 15921.55, "timestamp": "04:25:21", "text": "那是沙鲁克·汗的"}, {"type": "subtitle", "time": 15924.91, "timestamp": "04:25:24", "text": "短小的东西"}, {"type": "subtitle", "time": 15929.149, "timestamp": "04:25:29", "text": "形式。该死，我是个冒牌印第安纳人，不是吗？"}, {"type": "subtitle", "time": 15932.229, "timestamp": "04:25:32", "text": "它？我根本不知道这是什么。"}, {"type": "subtitle", "time": 15935.269, "timestamp": "04:25:35", "text": "我看过沙坎的电影。我觉得我"}]
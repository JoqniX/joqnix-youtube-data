[{"type": "subtitle", "time": 25680.31, "timestamp": "07:08:00", "text": "我们家的老大门将会是"}, {"type": "subtitle", "time": 25682.708, "timestamp": "07:08:02", "text": "也会被摧毁。现在是"}, {"type": "subtitle", "time": 25685.11, "timestamp": "07:08:05", "text": "不过会是推拉门。所以是"}, {"type": "subtitle", "time": 25688.548, "timestamp": "07:08:08", "text": "这是一栋新房子吗？这是一栋老房子，正在"}, {"type": "subtitle", "time": 25692.07, "timestamp": "07:08:12", "text": "顶层已全面翻新。所以"}, {"type": "subtitle", "time": 25697.99, "timestamp": "07:08:17", "text": "他们还更换了屋顶。"}, {"type": "subtitle", "time": 25699.83, "timestamp": "07:08:19", "text": "是的，他们把屋顶那玩意儿换掉了。"}, {"type": "subtitle", "time": 25703.11, "timestamp": "07:08:23", "text": "出色地。老房子翻新。是的，"}, {"type": "subtitle", "time": 25705.11, "timestamp": "07:08:25", "text": "地面设施没有进行翻新。"}, {"type": "subtitle", "time": 25707.51, "timestamp": "07:08:27", "text": "只有外部部分和内部部分是"}, {"type": "subtitle", "time": 25711.788, "timestamp": "07:08:31", "text": "还是老样子。对，就是这个"}, {"type": "subtitle", "time": 25715.468, "timestamp": "07:08:35", "text": "完全地、彻底地、完全地"}, {"type": "subtitle", "time": 25717.948, "timestamp": "07:08:37", "text": "已翻新。"}, {"type": "subtitle", "time": 25721.35, "timestamp": "07:08:41", "text": "是啊，我看到的时候确实很震惊。"}, {"type": "subtitle", "time": 25724.468, "timestamp": "07:08:44", "text": "说实话，确实如此。我当时真的"}, {"type": "subtitle", "time": 25726.468, "timestamp": "07:08:46", "text": "看到这张照片我震惊了。我当时"}, {"type": "subtitle", "time": 25728.548, "timestamp": "07:08:48", "text": "比如，“不可能。那会是我们……”"}, {"type": "subtitle", "time": 25731.628, "timestamp": "07:08:51", "text": "“房子。”我把这话告诉了爸爸。我当时就想，"}]
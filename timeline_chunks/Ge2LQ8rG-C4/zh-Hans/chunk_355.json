[{"type": "subtitle", "time": 21300.51, "timestamp": "05:55:00", "text": "过场动画和"}, {"type": "subtitle", "time": 21303.67, "timestamp": "05:55:03", "text": "东西一放完，我们就瞬间被传送走了。"}, {"type": "subtitle", "time": 21306.628, "timestamp": "05:55:06", "text": "从这里或其他地方，当我第一次"}, {"type": "subtitle", "time": 21308.35, "timestamp": "05:55:08", "text": "与……互动"}, {"type": "subtitle", "time": 21311.99, "timestamp": "05:55:11", "text": "她和我们神奇地出现在节目中，"}, {"type": "subtitle", "time": 21313.548, "timestamp": "05:55:13", "text": "这毫无意义"}, {"type": "subtitle", "time": 21317.868, "timestamp": "05:55:17", "text": "现在。从来没有过。是的。但如果真有"}, {"type": "subtitle", "time": 21321.99, "timestamp": "05:55:21", "text": "游戏带给你的就像是一种魔法。"}, {"type": "subtitle", "time": 21323.83, "timestamp": "05:55:23", "text": "门之类的东西，或者类似传送门的东西"}, {"type": "subtitle", "time": 21326.788, "timestamp": "05:55:26", "text": "比如NPC之类的东西"}, {"type": "subtitle", "time": 21328.03, "timestamp": "05:55:28", "text": "你走"}, {"type": "subtitle", "time": 21332.708, "timestamp": "05:55:32", "text": "一起走进那扇门，然后进去。"}, {"type": "subtitle", "time": 21334.708, "timestamp": "05:55:34", "text": "呃，你会去的地区"}, {"type": "subtitle", "time": 21337.39, "timestamp": "05:55:37", "text": "任务开始。那将是"}, {"type": "subtitle", "time": 21339.75, "timestamp": "05:55:39", "text": "惊人的。那太棒了。它是"}, {"type": "subtitle", "time": 21342.948, "timestamp": "05:55:42", "text": "像这样。你走进这样一扇门。"}, {"type": "subtitle", "time": 21344.27, "timestamp": "05:55:44", "text": "和"}, {"type": "subtitle", "time": 21346.27, "timestamp": "05:55:46", "text": "像"}, {"type": "subtitle", "time": 21349.99, "timestamp": "05:55:49", "text": "这就像多里蒙的传送门一样，或者"}, {"type": "subtitle", "time": 21352.07, "timestamp": "05:55:52", "text": "算是吧？就是这样。我不"}, {"type": "subtitle", "time": 21354.39, "timestamp": "05:55:54", "text": "知道那篇演讲是否存在。"}, {"type": "subtitle", "time": 21356.59, "timestamp": "05:55:56", "text": "太酷了"}, {"type": "subtitle", "time": 21359.868, "timestamp": "05:55:59", "text": "看。是的。我不"}]
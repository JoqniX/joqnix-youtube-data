[{"type": "subtitle", "time": 25380.628, "timestamp": "07:03:00", "text": "宽敞。就是这样。所以我的电力"}, {"type": "subtitle", "time": 25382.948, "timestamp": "07:03:02", "text": "该仪表连接将是"}, {"type": "subtitle", "time": 25386.43, "timestamp": "07:03:06", "text": "与我的下面相连，不像没有"}, {"type": "subtitle", "time": 25389.67, "timestamp": "07:03:09", "text": "地下一层。所以我的将会是"}, {"type": "subtitle", "time": 25392.548, "timestamp": "07:03:12", "text": "与我家的一个人联系在一起"}, {"type": "subtitle", "time": 25395.91, "timestamp": "07:03:15", "text": "他们还要制作另外两个独立的"}, {"type": "subtitle", "time": 25398.75, "timestamp": "07:03:18", "text": "租金表"}, {"type": "subtitle", "time": 25401.67, "timestamp": "07:03:21", "text": "人们。这是房子的大小吗？还是我不知道？"}, {"type": "subtitle", "time": 25410.868, "timestamp": "07:03:30", "text": "我不知道是不是有泄露事件发生。"}, {"type": "subtitle", "time": 25413.39, "timestamp": "07:03:33", "text": "正在发生"}, {"type": "subtitle", "time": 25416.548, "timestamp": "07:03:36", "text": "很多。我的意思是，有一次我们……"}, {"type": "subtitle", "time": 25420.19, "timestamp": "07:03:40", "text": "就像这些人一样，就像他们……"}, {"type": "subtitle", "time": 25422.788, "timestamp": "07:03:42", "text": "完全拆除了所有电线"}, {"type": "subtitle", "time": 25425.11, "timestamp": "07:03:45", "text": "修好了，但是修得不好。这"}, {"type": "subtitle", "time": 25427.67, "timestamp": "07:03:47", "text": "电线质量很差。有"}, {"type": "subtitle", "time": 25430.39, "timestamp": "07:03:50", "text": "泄漏。就像电气设备一样。"}, {"type": "subtitle", "time": 25432.948, "timestamp": "07:03:52", "text": "这里那里不时迸发出火花。这"}, {"type": "subtitle", "time": 25436.31, "timestamp": "07:03:56", "text": "主电源经常被切断。"}, {"type": "subtitle", "time": 25439.31, "timestamp": "07:03:59", "text": "很多。天哪，那些日子……"}]
[{"type": "subtitle", "time": 25860.548, "timestamp": "07:11:00", "text": "我爸爸的改变改变了"}, {"type": "subtitle", "time": 25863.59, "timestamp": "07:11:03", "text": "从国内租东西"}, {"type": "subtitle", "time": 25865.51, "timestamp": "07:11:05", "text": "商业的。那玩意儿真的存在吗？我不"}, {"type": "subtitle", "time": 25878.91, "timestamp": "07:11:18", "text": "是的。我不"}, {"type": "subtitle", "time": 25883.39, "timestamp": "07:11:23", "text": "知道。米尔卡。我想我就是米拉。我不"}, {"type": "subtitle", "time": 25890.708, "timestamp": "07:11:30", "text": "知道。我只知道我必须做我的"}, {"type": "subtitle", "time": 25893.51, "timestamp": "07:11:33", "text": "最好是能为家人赚钱。"}, {"type": "subtitle", "time": 25895.99, "timestamp": "07:11:35", "text": "不知怎么的。"}, {"type": "subtitle", "time": 25899.27, "timestamp": "07:11:39", "text": "嗯，是的，因为你知道他们是"}, {"type": "subtitle", "time": 25900.59, "timestamp": "07:11:40", "text": "年纪渐长"}, {"type": "subtitle", "time": 25904.468, "timestamp": "07:11:44", "text": "作为独生子女，我必须照顾家人。"}, {"type": "subtitle", "time": 25905.548, "timestamp": "07:11:45", "text": "的"}, {"type": "subtitle", "time": 25908.35, "timestamp": "07:11:48", "text": "家庭。所以就这样"}, {"type": "subtitle", "time": 25910.83, "timestamp": "07:11:50", "text": "[音乐]"}, {"type": "subtitle", "time": 25913.43, "timestamp": "07:11:53", "text": "呃，你得养家糊口啊。"}, {"type": "subtitle", "time": 25914.59, "timestamp": "07:11:54", "text": "保护他们。"}, {"type": "subtitle", "time": 25918.07, "timestamp": "07:11:58", "text": "不，但我认为不会有任何工作机会。"}]
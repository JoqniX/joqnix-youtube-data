[{"type": "subtitle", "time": 26040.07, "timestamp": "07:14:00", "text": "这段话描述的是，重要的是你。"}, {"type": "subtitle", "time": 26042.27, "timestamp": "07:14:02", "text": "要明白这是家人。啊，是啊"}, {"type": "subtitle", "time": 26062.39, "timestamp": "07:14:22", "text": "家里有一天，你的兄弟姐妹……"}, {"type": "subtitle", "time": 26064.708, "timestamp": "07:14:24", "text": "结婚什么的，你会哭的。"}, {"type": "subtitle", "time": 26069.83, "timestamp": "07:14:29", "text": "不，我的天哪，不，他们会要"}, {"type": "subtitle", "time": 26074.75, "timestamp": "07:14:34", "text": "有人要把我的东西拿走，因为我"}, {"type": "subtitle", "time": 26078.868, "timestamp": "07:14:38", "text": "那样的爱，你会走到……"}, {"type": "subtitle", "time": 26082.43, "timestamp": "07:14:42", "text": "伙伴，我就像"}, {"type": "subtitle", "time": 26085.59, "timestamp": "07:14:45", "text": "哦，如果你不照顾好我"}, {"type": "subtitle", "time": 26088.15, "timestamp": "07:14:48", "text": "船运很好，我会找到你的。"}, {"type": "subtitle", "time": 26092.23, "timestamp": "07:14:52", "text": "会像那个恶灵一样缠着你，伙计。"}, {"type": "subtitle", "time": 26099.628, "timestamp": "07:14:59", "text": "我知道，但差不多就是这样。"}]
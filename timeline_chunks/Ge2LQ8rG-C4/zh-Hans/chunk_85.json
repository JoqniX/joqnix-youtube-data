[{"type": "subtitle", "time": 5101.59, "timestamp": "01:25:01", "text": "捏。那些是金库。什么是"}, {"type": "subtitle", "time": 5104.229, "timestamp": "01:25:04", "text": "这？就在那时我上传了视频。"}, {"type": "subtitle", "time": 5127.39, "timestamp": "01:25:27", "text": "所以今天我得上传30个，不，是20个。"}, {"type": "subtitle", "time": 5131.39, "timestamp": "01:25:31", "text": "今天我必须上传文件"}, {"type": "subtitle", "time": 5140.47, "timestamp": "01:25:40", "text": "昨天。问题是，最终它会……"}, {"type": "subtitle", "time": 5142.709, "timestamp": "01:25:42", "text": "快用完了。然后我就会说“不”"}, {"type": "subtitle", "time": 5145.39, "timestamp": "01:25:45", "text": "不再拍短裤了。那是"}, {"type": "subtitle", "time": 5148.47, "timestamp": "01:25:48", "text": "它。就是这样。我做不到"}, {"type": "subtitle", "time": 5150.27, "timestamp": "01:25:50", "text": "镜头"}, {"type": "subtitle", "time": 5153.149, "timestamp": "01:25:53", "text": "永远。我希望人们剪辑我"}, {"type": "subtitle", "time": 5155.83, "timestamp": "01:25:55", "text": "可能的。我本人也不知道该怎么办"}]
[{"type": "subtitle", "time": 19623.51, "timestamp": "05:27:03", "text": "但我不想那样做。就好像我不得不……"}, {"type": "subtitle", "time": 19624.83, "timestamp": "05:27:04", "text": "积极"}, {"type": "subtitle", "time": 19627.43, "timestamp": "05:27:07", "text": "研磨。这只是……就像几个"}, {"type": "subtitle", "time": 19628.67, "timestamp": "05:27:08", "text": "分钟。所以"}, {"type": "subtitle", "time": 19632.47, "timestamp": "05:27:12", "text": "我的天啊，卡利斯托的生命值太低了。我"}, {"type": "subtitle", "time": 19635.67, "timestamp": "05:27:15", "text": "忘了。我没注意。我做了"}, {"type": "subtitle", "time": 19637.708, "timestamp": "05:27:17", "text": "不支付"}, {"type": "subtitle", "time": 19641.55, "timestamp": "05:27:21", "text": "注意力。我总是忘记他是个"}, {"type": "subtitle", "time": 19644.67, "timestamp": "05:27:24", "text": "游戏。所以"}, {"type": "subtitle", "time": 19647.708, "timestamp": "05:27:27", "text": "是的，"}, {"type": "subtitle", "time": 19650.788, "timestamp": "05:27:30", "text": "敌方首领贾玛会很难对付。不"}, {"type": "subtitle", "time": 19653.11, "timestamp": "05:27:33", "text": "担心。我要把卡利斯托斯升到满级"}, {"type": "subtitle", "time": 19656.67, "timestamp": "05:27:36", "text": "他甚至会打败你。"}, {"type": "subtitle", "time": 19659.59, "timestamp": "05:27:39", "text": "容易地。但回声就是我，我就是"}, {"type": "subtitle", "time": 19662.47, "timestamp": "05:27:42", "text": "担心。我不认识这种回声。"}, {"type": "subtitle", "time": 19666.07, "timestamp": "05:27:46", "text": "诸如此类的数学知识，呃，所有"}, {"type": "subtitle", "time": 19669.19, "timestamp": "05:27:49", "text": "我只知道暴击率这一点。"}, {"type": "subtitle", "time": 19671.19, "timestamp": "05:27:51", "text": "攻击力，攻击百分比。那些是"}, {"type": "subtitle", "time": 19679.03, "timestamp": "05:27:59", "text": "能量补充以及所有那些"}]
[{"type": "subtitle", "time": 24542.23, "timestamp": "06:49:02", "text": "哦好的。它在花附近。弗拉夫"}, {"type": "subtitle", "time": 24544.03, "timestamp": "06:49:04", "text": "花。"}, {"type": "subtitle", "time": 24546.868, "timestamp": "06:49:06", "text": "弗拉夫。我的天啊。我简直不敢相信"}, {"type": "subtitle", "time": 24549.59, "timestamp": "06:49:09", "text": "它。我们终于要达到100%了。"}, {"type": "subtitle", "time": 24555.468, "timestamp": "06:49:15", "text": "我是"}, {"type": "subtitle", "time": 24594.43, "timestamp": "06:49:54", "text": "什么？"}]
[{"type": "subtitle", "time": 23522.27, "timestamp": "06:32:02", "text": "寻求。我想我们大概能完成这件事了。"}, {"type": "subtitle", "time": 23525.59, "timestamp": "06:32:05", "text": "呃，独自一人在苦涩的全面任务中，因为"}, {"type": "subtitle", "time": 23527.15, "timestamp": "06:32:07", "text": "为什么"}, {"type": "subtitle", "time": 23529.67, "timestamp": "06:32:09", "text": "不是？和"}, {"type": "subtitle", "time": 23541.59, "timestamp": "06:32:21", "text": "实际上。极好的。听起来棒极了"}, {"type": "subtitle", "time": 23546.628, "timestamp": "06:32:26", "text": "珍贵稀有的非凡战斗。我"}, {"type": "subtitle", "time": 23549.51, "timestamp": "06:32:29", "text": "需要加快这项合作"}, {"type": "subtitle", "time": 23552.31, "timestamp": "06:32:32", "text": "研究团队并与对照组进行确认"}, {"type": "subtitle", "time": 23559.708, "timestamp": "06:32:39", "text": "哦，我几乎"}, {"type": "subtitle", "time": 23562.708, "timestamp": "06:32:42", "text": "忘了。由于这是一个优先项目，"}, {"type": "subtitle", "time": 23565.23, "timestamp": "06:32:45", "text": "像我这样的研究人员确实会得到一些"}, {"type": "subtitle", "time": 23567.99, "timestamp": "06:32:47", "text": "补贴。虽然并不重要，请"}, {"type": "subtitle", "time": 23570.15, "timestamp": "06:32:50", "text": "请将它们视为补偿。"}, {"type": "subtitle", "time": 23572.788, "timestamp": "06:32:52", "text": "你的努力。如果您有余钱"}, {"type": "subtitle", "time": 23574.948, "timestamp": "06:32:54", "text": "时间，我们非常感谢您"}, {"type": "subtitle", "time": 23576.868, "timestamp": "06:32:56", "text": "参与我们未来的实验。"}]
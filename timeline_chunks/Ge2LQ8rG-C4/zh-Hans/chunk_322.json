[{"type": "subtitle", "time": 19321.19, "timestamp": "05:22:01", "text": "即将到来。哦，我忘了我是……哦，我是……"}, {"type": "subtitle", "time": 19323.03, "timestamp": "05:22:03", "text": "等级。哦。我的天哪。我忘了。我忘了。"}, {"type": "subtitle", "time": 19327.27, "timestamp": "05:22:07", "text": "我忘了我的……呃，这东西的等级……呃……"}, {"type": "subtitle", "time": 19330.948, "timestamp": "05:22:10", "text": "世界排名 我的天哪。它是"}, {"type": "subtitle", "time": 19333.39, "timestamp": "05:22:13", "text": "现在有点难了。哦"}, {"type": "subtitle", "time": 19336.948, "timestamp": "05:22:16", "text": "不。它会造成很大的冲击力。"}, {"type": "subtitle", "time": 19338.43, "timestamp": "05:22:18", "text": "击败"}, {"type": "subtitle", "time": 19341.91, "timestamp": "05:22:21", "text": "他们。你看，他们的名牌是黄色的。"}, {"type": "subtitle", "time": 19344.11, "timestamp": "05:22:24", "text": "哦，没有"}, {"type": "subtitle", "time": 19359.39, "timestamp": "05:22:39", "text": "哇。做"}, {"type": "subtitle", "time": 19362.31, "timestamp": "05:22:42", "text": "这。哦，是的。我的主角呃"}, {"type": "subtitle", "time": 19364.788, "timestamp": "05:22:44", "text": "罗孚其实已经60岁了。我忘了……"}, {"type": "subtitle", "time": 19367.35, "timestamp": "05:22:47", "text": "昨天升天了，对吧？是的。所以"}, {"type": "subtitle", "time": 19372.47, "timestamp": "05:22:52", "text": "今天我们的目标是攀登高峰。我们的目标是……"}, {"type": "subtitle", "time": 19376.708, "timestamp": "05:22:56", "text": "登上独一无二的卡利斯托之巅。我"}, {"type": "subtitle", "time": 19379.59, "timestamp": "05:22:59", "text": "又名 Kal Shadow。我叫他卡利斯托。"}]
[{"type": "subtitle", "time": 18960.91, "timestamp": "05:16:00", "text": "你不能从我这里夺走，或者说，那是我的"}, {"type": "subtitle", "time": 18963.99, "timestamp": "05:16:03", "text": "内容是我在那边，即使是这样"}, {"type": "subtitle", "time": 18966.708, "timestamp": "05:16:06", "text": "就像我把那些视频发布到 YouTube 上一样，我们真的"}, {"type": "subtitle", "time": 18969.948, "timestamp": "05:16:09", "text": "真的太好了，我想要"}, {"type": "subtitle", "time": 18972.948, "timestamp": "05:16:12", "text": "那并不能消除这一点，但是，"}, {"type": "subtitle", "time": 18975.628, "timestamp": "05:16:15", "text": "嗯，我会尝试更改类别。"}, {"type": "subtitle", "time": 18979.75, "timestamp": "05:16:19", "text": "东西。一样。呃，如果我们曾经"}, {"type": "subtitle", "time": 18983.03, "timestamp": "05:16:23", "text": "呃，今天不做冲浪了"}, {"type": "subtitle", "time": 18987.35, "timestamp": "05:16:27", "text": "任何事，我都会尝试去改变。"}, {"type": "subtitle", "time": 18989.91, "timestamp": "05:16:29", "text": "你好。所以，综上所述，综上所述"}, {"type": "subtitle", "time": 18993.07, "timestamp": "05:16:33", "text": "并且，将这一点保留下来"}, {"type": "subtitle", "time": 19002.03, "timestamp": "05:16:42", "text": "让我准备一下"}, {"type": "subtitle", "time": 19006.23, "timestamp": "05:16:46", "text": "真热。想象一下，如果我参与到这场对话中来会怎样。"}, {"type": "subtitle", "time": 19009.67, "timestamp": "05:16:49", "text": "场景，我和人们进来了，"}, {"type": "subtitle", "time": 19013.59, "timestamp": "05:16:53", "text": "他们会像系统一样，好吧，就这样。"}, {"type": "subtitle", "time": 19017.59, "timestamp": "05:16:57", "text": "而这种愤怒并没有像人们常说的那样蔓延开来。"}]
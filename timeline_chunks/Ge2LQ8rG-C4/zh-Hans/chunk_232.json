[{"type": "subtitle", "time": 13920.229, "timestamp": "03:52:00", "text": "现在启程前往日本。收费，而且我认为"}, {"type": "subtitle", "time": 13923.59, "timestamp": "03:52:03", "text": "我至今还没喊出那么多声呢。"}, {"type": "subtitle", "time": 13926.469, "timestamp": "03:52:06", "text": "超过我夜里尖叫的次数"}, {"type": "subtitle", "time": 13929.59, "timestamp": "03:52:09", "text": "我的邻居们就像是……呃……打电话"}, {"type": "subtitle", "time": 13931.59, "timestamp": "03:52:11", "text": "打电话给我父母，问他们是不是你的儿子"}, {"type": "subtitle", "time": 13934.469, "timestamp": "03:52:14", "text": "好吧，我还没达到那个水平。"}, {"type": "subtitle", "time": 13936.469, "timestamp": "03:52:16", "text": "而我却无法到达那里。"}, {"type": "subtitle", "time": 13938.55, "timestamp": "03:52:18", "text": "我当时的水平，连尖叫都做不到。"}, {"type": "subtitle", "time": 13941.63, "timestamp": "03:52:21", "text": "日本，因为你知道日本人。"}, {"type": "subtitle", "time": 13945.349, "timestamp": "03:52:25", "text": "嗯，他们都喜欢住在……的人"}, {"type": "subtitle", "time": 13948.95, "timestamp": "03:52:28", "text": "像较小的空间一样，所以房间噪音和"}, {"type": "subtitle", "time": 13951.349, "timestamp": "03:52:31", "text": "一切都是痛苦。我必须买"}]
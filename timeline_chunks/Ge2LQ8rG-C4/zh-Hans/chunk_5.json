[{"type": "subtitle", "time": 309.83, "timestamp": "00:05:09", "text": "或许可行。大概。但"}, {"type": "subtitle", "time": 313.87, "timestamp": "00:05:13", "text": "我不知道。我的想法之一是"}, {"type": "subtitle", "time": 316.909, "timestamp": "00:05:16", "text": "差不多就对了"}, {"type": "subtitle", "time": 320.07, "timestamp": "00:05:20", "text": "因为我收到了来自 Twitch 的评论"}, {"type": "subtitle", "time": 323.629, "timestamp": "00:05:23", "text": "说我没意识到"}, {"type": "subtitle", "time": 325.87, "timestamp": "00:05:25", "text": "那"}, {"type": "subtitle", "time": 329.67, "timestamp": "00:05:29", "text": "我没有在直播中提到这件事。"}, {"type": "subtitle", "time": 332.87, "timestamp": "00:05:32", "text": "它是，它是V等等，就像"}, {"type": "subtitle", "time": 340.11, "timestamp": "00:05:40", "text": "[音乐]"}, {"type": "subtitle", "time": 348.15, "timestamp": "00:05:48", "text": "嗯，还有那件事。其次，我"}, {"type": "subtitle", "time": 350.749, "timestamp": "00:05:50", "text": "我们想做的，我们还没做。"}, {"type": "subtitle", "time": 353.99, "timestamp": "00:05:53", "text": "昨天穿短裤是因为我们专注于……"}, {"type": "subtitle", "time": 356.67, "timestamp": "00:05:56", "text": "比利 比利 嗯"}]
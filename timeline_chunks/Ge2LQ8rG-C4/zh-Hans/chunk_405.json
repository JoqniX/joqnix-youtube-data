[{"type": "subtitle", "time": 24301.03, "timestamp": "06:45:01", "text": "这里。让我们来看看。"}, {"type": "subtitle", "time": 24324.99, "timestamp": "06:45:24", "text": "第二节做过"}, {"type": "subtitle", "time": 24328.628, "timestamp": "06:45:28", "text": "呃，上帝之印得到赞扬吗？应该是"}, {"type": "subtitle", "time": 24331.39, "timestamp": "06:45:31", "text": "虽然是自动的。让我加倍"}, {"type": "subtitle", "time": 24334.23, "timestamp": "06:45:34", "text": "查看。哦，你真的做到了。你做到了。好的。好的。"}, {"type": "subtitle", "time": 24342.59, "timestamp": "06:45:42", "text": "上帝。我必须确保自己不会露面"}, {"type": "subtitle", "time": 24345.27, "timestamp": "06:45:45", "text": "抽搐。我不想被禁言"}, {"type": "subtitle", "time": 24350.03, "timestamp": "06:45:50", "text": "再次。 60秒。不。啊，比利"}, {"type": "subtitle", "time": 24353.15, "timestamp": "06:45:53", "text": "比利。哦，这个"}, {"type": "subtitle", "time": 24357.11, "timestamp": "06:45:57", "text": "男。你就是那个人吗？你为什么带"}]
[{"type": "subtitle", "time": 10441.95, "timestamp": "02:54:01", "text": "那只是个玩笑而已。"}, {"type": "subtitle", "time": 10444.99, "timestamp": "02:54:04", "text": "夹子。这是最后一个"}, {"type": "subtitle", "time": 10447.71, "timestamp": "02:54:07", "text": "一。由此我们将有"}, {"type": "subtitle", "time": 10451.19, "timestamp": "02:54:11", "text": "10. 然后我们继续，然后我就走了"}, {"type": "subtitle", "time": 10474.389, "timestamp": "02:54:34", "text": "撒尿。我随身带着一个苹果和一个香蕉。"}, {"type": "subtitle", "time": 10477.269, "timestamp": "02:54:37", "text": "两根香蕉。我应该吃掉那个苹果，因为"}, {"type": "subtitle", "time": 10478.51, "timestamp": "02:54:38", "text": "我是"}, {"type": "subtitle", "time": 10482.34, "timestamp": "02:54:42", "text": "饥饿的。我还用什么刷牙？"}, {"type": "subtitle", "time": 10493.99, "timestamp": "02:54:53", "text": "我们本应该做的事"}, {"type": "subtitle", "time": 10496.75, "timestamp": "02:54:56", "text": "晚上是这样，但晚上我也是。"}, {"type": "subtitle", "time": 10498.349, "timestamp": "02:54:58", "text": "曾是"}]
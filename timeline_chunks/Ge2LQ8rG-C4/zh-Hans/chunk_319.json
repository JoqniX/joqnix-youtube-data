[{"type": "subtitle", "time": 19143.03, "timestamp": "05:19:03", "text": "我玩的是日版。"}, {"type": "subtitle", "time": 19147.59, "timestamp": "05:19:07", "text": "对啊，经常玩游戏什么的。"}, {"type": "subtitle", "time": 19150.628, "timestamp": "05:19:10", "text": "等等，我可以玩CN"}, {"type": "subtitle", "time": 19152.43, "timestamp": "05:19:12", "text": "版本。"}, {"type": "subtitle", "time": 19155.19, "timestamp": "05:19:15", "text": "等等，等等。哦，等等。他们发布了吗？"}, {"type": "subtitle", "time": 19157.75, "timestamp": "05:19:17", "text": "是给中国用的吗？我不知道。是的，"}, {"type": "subtitle", "time": 19159.11, "timestamp": "05:19:19", "text": "类似的事情发生时"}, {"type": "subtitle", "time": 19160.708, "timestamp": "05:19:20", "text": "全球范围。不，我当然会去"}, {"type": "subtitle", "time": 19161.708, "timestamp": "05:19:21", "text": "生长"}, {"type": "subtitle", "time": 19166.51, "timestamp": "05:19:26", "text": "它。蓝色协议是蓝色协议是"}, {"type": "subtitle", "time": 19170.708, "timestamp": "05:19:30", "text": "最好的。我喜欢那样。不过，总之，"}, {"type": "subtitle", "time": 19175.47, "timestamp": "05:19:35", "text": "回到游戏。哈利斯托（Halisto）"}, {"type": "subtitle", "time": 19178.39, "timestamp": "05:19:38", "text": "加尔托。我喜欢叫他卡利斯托。我"}, {"type": "subtitle", "time": 19179.31, "timestamp": "05:19:39", "text": "不知道"}, {"type": "subtitle", "time": 19195.868, "timestamp": "05:19:55", "text": "好的。到处都是红色……呃"}, {"type": "subtitle", "time": 19199.55, "timestamp": "05:19:59", "text": "四肢。任何。这些叫什么？"}]
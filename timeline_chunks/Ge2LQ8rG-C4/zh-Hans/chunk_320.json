[{"type": "subtitle", "time": 19203.628, "timestamp": "05:20:03", "text": "感叹问句。这玩意儿"}, {"type": "subtitle", "time": 19210.43, "timestamp": "05:20:10", "text": "呃，我总是忘记直播"}, {"type": "subtitle", "time": 19220.19, "timestamp": "05:20:20", "text": "是的。什么是"}, {"type": "subtitle", "time": 19224.07, "timestamp": "05:20:24", "text": "这？第七天。我的天啊。我们终于"}, {"type": "subtitle", "time": 19225.47, "timestamp": "05:20:25", "text": "全部都拿到了"}, {"type": "subtitle", "time": 19230.55, "timestamp": "05:20:30", "text": "东西。我们得到了两个。我们得……"}, {"type": "subtitle", "time": 19236.51, "timestamp": "05:20:36", "text": "[音乐]"}, {"type": "subtitle", "time": 19239.47, "timestamp": "05:20:39", "text": "东西。好的。日食"}, {"type": "subtitle", "time": 19243.51, "timestamp": "05:20:43", "text": "错觉。只剩28天了。我该怎么做？"}, {"type": "subtitle", "time": 19246.47, "timestamp": "05:20:46", "text": "真的必须完全完成吗？"}]
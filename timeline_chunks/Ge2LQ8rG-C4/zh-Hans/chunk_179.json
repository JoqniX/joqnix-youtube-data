[{"type": "subtitle", "time": 10748.87, "timestamp": "02:59:08", "text": "我有没有跟你们说过我其实有一个"}, {"type": "subtitle", "time": 10754.07, "timestamp": "02:59:14", "text": "今天和一位日本油管博主进行了视频通话，我"}, {"type": "subtitle", "time": 10756.99, "timestamp": "02:59:16", "text": "我当时非常紧张。"}, {"type": "subtitle", "time": 10768.389, "timestamp": "02:59:28", "text": "多伊。我当时非常紧张，但实际上"}, {"type": "subtitle", "time": 10771.03, "timestamp": "02:59:31", "text": "一切顺利，我很开心。我当时"}, {"type": "subtitle", "time": 10780.51, "timestamp": "02:59:40", "text": "很多。我们实际上谈过"}, {"type": "subtitle", "time": 10783.71, "timestamp": "02:59:43", "text": "很多。我迫不及待地想看到这次合作。"}, {"type": "subtitle", "time": 10786.19, "timestamp": "02:59:46", "text": "你"}]
[{"type": "subtitle", "time": 11346.87, "timestamp": "03:09:06", "text": "是的，我是双性恋。别忘了。证明"}, {"type": "subtitle", "time": 11349.269, "timestamp": "03:09:09", "text": "它。请拿出证据。请拿出证据。高手。高手。高手。"}, {"type": "subtitle", "time": 11350.389, "timestamp": "03:09:10", "text": "高手。高手。如果你没考好，你就是个……"}, {"type": "subtitle", "time": 11352.71, "timestamp": "03:09:12", "text": "底部。请拿出证据。请拿出证据。我会痊愈"}, {"type": "subtitle", "time": 11354.63, "timestamp": "03:09:14", "text": "你。我会治好你。高手。我会"}, {"type": "subtitle", "time": 11355.91, "timestamp": "03:09:15", "text": "我会把你带在身后，但我会治好你。你得到了"}, {"type": "subtitle", "time": 11357.51, "timestamp": "03:09:17", "text": "成为王牌。你必须拿A。好的，乔克。"}, {"type": "subtitle", "time": 11358.87, "timestamp": "03:09:18", "text": "我会替你压制。我会闪现"}, {"type": "subtitle", "time": 11362.15, "timestamp": "03:09:22", "text": "你也是。我甚至会，我甚至会重新"}, {"type": "subtitle", "time": 11363.67, "timestamp": "03:09:23", "text": "你。不要打架。不要打架。"}, {"type": "subtitle", "time": 11367.71, "timestamp": "03:09:27", "text": "不要打架。交给乔处理吧。让乔来做"}, {"type": "subtitle", "time": 11370.389, "timestamp": "03:09:30", "text": "它。阿鲁。阿鲁。让他去吧。让他去吧。阿鲁。"}, {"type": "subtitle", "time": 11372.95, "timestamp": "03:09:32", "text": "别让他得逞。"}, {"type": "subtitle", "time": 11376.469, "timestamp": "03:09:36", "text": "我的天啊。我的天啊。我的天啊。你是"}, {"type": "subtitle", "time": 11380.15, "timestamp": "03:09:40", "text": "美好的。杀了他。乔克。乔克。快点。"}, {"type": "subtitle", "time": 11381.75, "timestamp": "03:09:41", "text": "我的天啊。"}, {"type": "subtitle", "time": 11383.91, "timestamp": "03:09:43", "text": "肯定会有背叛。是的。"}, {"type": "subtitle", "time": 11387.269, "timestamp": "03:09:47", "text": "注意那边。不，不。你呢？"}, {"type": "subtitle", "time": 11389.59, "timestamp": "03:09:49", "text": "意思是“不”吗，兄弟？你是什​​么意思？什么"}, {"type": "subtitle", "time": 11392.309, "timestamp": "03:09:52", "text": "你的意思是？"}, {"type": "subtitle", "time": 11394.71, "timestamp": "03:09:54", "text": "不，我死了。"}, {"type": "subtitle", "time": 11397.269, "timestamp": "03:09:57", "text": "我的天啊。你没拿到王牌。"}, {"type": "subtitle", "time": 11399.269, "timestamp": "03:09:59", "text": "你是垫底的。你真是个倒霉蛋。敌人"}]
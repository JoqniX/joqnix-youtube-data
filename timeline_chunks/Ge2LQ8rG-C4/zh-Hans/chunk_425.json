[{"type": "subtitle", "time": 25503.91, "timestamp": "07:05:03", "text": "房子也太大了。不，我不这么认为"}, {"type": "subtitle", "time": 25507.868, "timestamp": "07:05:07", "text": "它大得惊人，因为"}, {"type": "subtitle", "time": 25516.628, "timestamp": "07:05:16", "text": "呃，我觉得这房子不算大。我"}, {"type": "subtitle", "time": 25519.03, "timestamp": "07:05:19", "text": "不知道。感觉就像一场普通的聚会"}, {"type": "subtitle", "time": 25521.99, "timestamp": "07:05:21", "text": "一。就像你通常拥有一套房子一样"}, {"type": "subtitle", "time": 25524.23, "timestamp": "07:05:24", "text": "但这就像是底层一样。不，就像"}, {"type": "subtitle", "time": 25526.23, "timestamp": "07:05:26", "text": "底层，就是地板。"}, {"type": "subtitle", "time": 25528.548, "timestamp": "07:05:28", "text": "它靠近路边道路"}, {"type": "subtitle", "time": 25531.11, "timestamp": "07:05:31", "text": "水平线，对吧？然后我想要一个高架"}, {"type": "subtitle", "time": 25533.99, "timestamp": "07:05:33", "text": "等级。这是第一级，对吧？是的，"}, {"type": "subtitle", "time": 25536.19, "timestamp": "07:05:36", "text": "那就是"}, {"type": "subtitle", "time": 25540.27, "timestamp": "07:05:40", "text": "它。它像公寓吗？我不"}, {"type": "subtitle", "time": 25543.99, "timestamp": "07:05:43", "text": "知道。我想展示一下这是什么，呃，就像"}, {"type": "subtitle", "time": 25547.83, "timestamp": "07:05:47", "text": "设计师的草图"}, {"type": "subtitle", "time": 25550.868, "timestamp": "07:05:50", "text": "嗯，这样你大概就能理解了。我是"}, {"type": "subtitle", "time": 25553.75, "timestamp": "07:05:53", "text": "害怕会泄露个人信息。不可能"}, {"type": "subtitle", "time": 25556.39, "timestamp": "07:05:56", "text": "任何人都能找到那栋房子在哪儿，因为"}, {"type": "subtitle", "time": 25559.43, "timestamp": "07:05:59", "text": "还在施工中，我不确定"}]
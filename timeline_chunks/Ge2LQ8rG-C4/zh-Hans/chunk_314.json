[{"type": "subtitle", "time": 18841.03, "timestamp": "05:14:01", "text": "好的。是的。呃，从现在开始。但是呃"}, {"type": "subtitle", "time": 18845.35, "timestamp": "05:14:05", "text": "因为我当时就像……因为我当时就像……"}, {"type": "subtitle", "time": 18849.59, "timestamp": "05:14:09", "text": "我真的收到了关于比利·比利的警告，我"}, {"type": "subtitle", "time": 18852.47, "timestamp": "05:14:12", "text": "简直要把我的屏幕炸了，或者"}, {"type": "subtitle", "time": 18855.91, "timestamp": "05:14:15", "text": "无论何时我切换场景"}, {"type": "subtitle", "time": 18858.31, "timestamp": "05:14:18", "text": "我需要自己检查一些东西，"}, {"type": "subtitle", "time": 18860.31, "timestamp": "05:14:20", "text": "东西。这就是我认为……的原因"}, {"type": "subtitle", "time": 18861.47, "timestamp": "05:14:21", "text": "重要性"}, {"type": "subtitle", "time": 18864.868, "timestamp": "05:14:24", "text": "第四个显示器很重要。嗯，第四点"}, {"type": "subtitle", "time": 18867.43, "timestamp": "05:14:27", "text": "也就是说，我没有第二个显示器。"}, {"type": "subtitle", "time": 18870.55, "timestamp": "05:14:30", "text": "我的游戏电脑。所以我想这就是为什么……"}, {"type": "subtitle", "time": 18872.788, "timestamp": "05:14:32", "text": "整个电脑都这样了"}, {"type": "subtitle", "time": 18876.868, "timestamp": "05:14:36", "text": "筛选结果正确，我不能冒这个险，对吧？"}, {"type": "subtitle", "time": 18879.43, "timestamp": "05:14:39", "text": "对，这就是问题所在，所以……"}, {"type": "subtitle", "time": 18887.51, "timestamp": "05:14:47", "text": "我做的系统甚至可以语音控制。"}, {"type": "subtitle", "time": 18890.07, "timestamp": "05:14:50", "text": "甚至还做了声控功能，但我从未尝试过。"}, {"type": "subtitle", "time": 18893.628, "timestamp": "05:14:53", "text": "语音架构方面的东西，因为"}, {"type": "subtitle", "time": 18896.55, "timestamp": "05:14:56", "text": "嗯，它不行，我的电脑也不行。"}, {"type": "subtitle", "time": 18898.948, "timestamp": "05:14:58", "text": "理解我的言语 饮食识别"}]
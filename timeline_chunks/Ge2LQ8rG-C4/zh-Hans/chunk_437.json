[{"type": "subtitle", "time": 26233.91, "timestamp": "07:17:13", "text": "在知道的情况下，也不会知道你是"}, {"type": "subtitle", "time": 26237.43, "timestamp": "07:17:17", "text": "你出名了。是啊，没错。那里"}, {"type": "subtitle", "time": 26240.03, "timestamp": "07:17:20", "text": "不会像粉丝那样"}, {"type": "subtitle", "time": 26262.83, "timestamp": "07:17:42", "text": "嗯，让我再确认一下"}, {"type": "subtitle", "time": 26265.35, "timestamp": "07:17:45", "text": "某物。我给手机充电了吗？好的，"}, {"type": "subtitle", "time": 26266.99, "timestamp": "07:17:46", "text": "我正在给我的"}, {"type": "subtitle", "time": 26276.468, "timestamp": "07:17:56", "text": "上帝。你知道，我一直没怎么看电视。"}]
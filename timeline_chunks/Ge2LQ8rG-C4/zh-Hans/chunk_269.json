[{"type": "subtitle", "time": 16145.03, "timestamp": "04:29:05", "text": "我真的觉得我应该直播一下。"}, {"type": "subtitle", "time": 16147.67, "timestamp": "04:29:07", "text": "早上。"}, {"type": "subtitle", "time": 16150.229, "timestamp": "04:29:10", "text": "这样，中国人也可以观看。"}, {"type": "subtitle", "time": 16152.269, "timestamp": "04:29:12", "text": "我使用"}, {"type": "subtitle", "time": 16155.67, "timestamp": "04:29:15", "text": "平静地。所以从早到晚"}, {"type": "subtitle", "time": 16158.95, "timestamp": "04:29:18", "text": "这是个好男孩的时光。难以置信"}, {"type": "subtitle", "time": 16161.67, "timestamp": "04:29:21", "text": "夜幕降临后，人们开始陆续入睡。"}, {"type": "subtitle", "time": 16165.95, "timestamp": "04:29:25", "text": "以及下午 6 点之后的一切。"}, {"type": "subtitle", "time": 16168.95, "timestamp": "04:29:28", "text": "ISD 的人们开始犯困，然后说"}, {"type": "subtitle", "time": 16171.389, "timestamp": "04:29:31", "text": "只有夜间玩偶"}, {"type": "subtitle", "time": 16175.349, "timestamp": "04:29:35", "text": "停留。现在中国不是早上6点吗？"}, {"type": "subtitle", "time": 16177.63, "timestamp": "04:29:37", "text": "哦，不。现在是4点。"}, {"type": "subtitle", "time": 16181.51, "timestamp": "04:29:41", "text": "凌晨 5:00（日本时间）。它将"}]
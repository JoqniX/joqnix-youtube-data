[{"type": "subtitle", "time": 5822.27, "timestamp": "01:37:02", "text": "黑手党剑客应该……我愿意"}, {"type": "subtitle", "time": 5829.39, "timestamp": "01:37:09", "text": "他。哦，他刚刚发了一条"}, {"type": "subtitle", "time": 5842.149, "timestamp": "01:37:22", "text": "我得等。阿拉基安是如何做到的？"}, {"type": "subtitle", "time": 5843.87, "timestamp": "01:37:23", "text": "注射？我想要"}, {"type": "subtitle", "time": 5847.709, "timestamp": "01:37:27", "text": "看。他是如何进行合作的？"}, {"type": "subtitle", "time": 5851.149, "timestamp": "01:37:31", "text": "注射？我需要更多参考资料"}, {"type": "subtitle", "time": 5854.83, "timestamp": "01:37:34", "text": "尽管。你如何进行合作？"}, {"type": "subtitle", "time": 5857.59, "timestamp": "01:37:37", "text": "注射？哦，等等。这是合作拍摄的照片。"}, {"type": "subtitle", "time": 5860.709, "timestamp": "01:37:40", "text": "什么？他们做了什么？毒液在背后"}, {"type": "subtitle", "time": 5862.39, "timestamp": "01:37:42", "text": "我们。"}, {"type": "subtitle", "time": 5865.51, "timestamp": "01:37:45", "text": "是的。这就是我喊出“毒液”的原因。"}, {"type": "subtitle", "time": 5867.79, "timestamp": "01:37:47", "text": "他把一件东西放进去"}, {"type": "subtitle", "time": 5870.629, "timestamp": "01:37:50", "text": "游戏处于领先地位。"}, {"type": "subtitle", "time": 5874.229, "timestamp": "01:37:54", "text": "这里正在打包 heis。"}, {"type": "subtitle", "time": 5876.95, "timestamp": "01:37:56", "text": "啊，"}, {"type": "subtitle", "time": 5879.109, "timestamp": "01:37:59", "text": "你为什么不把东西放在这里？"}]
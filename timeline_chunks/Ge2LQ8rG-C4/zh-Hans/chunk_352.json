[{"type": "subtitle", "time": 21121.31, "timestamp": "05:52:01", "text": "稍后在模拟器中讨论"}, {"type": "subtitle", "time": 21123.19, "timestamp": "05:52:03", "text": "环境可以从以下位置放置："}, {"type": "subtitle", "time": 21125.23, "timestamp": "05:52:05", "text": "主题"}, {"type": "subtitle", "time": 21127.59, "timestamp": "05:52:07", "text": "由于以下原因，回忆将会出现："}, {"type": "subtitle", "time": 21135.43, "timestamp": "05:52:15", "text": "模式好的，更像是训练"}, {"type": "subtitle", "time": 21138.788, "timestamp": "05:52:18", "text": "当然可以，为什么不呢？"}, {"type": "subtitle", "time": 21141.51, "timestamp": "05:52:21", "text": "嗯，我有一个。你会注意到上面有一颗心。我们开始吧"}, {"type": "subtitle", "time": 21142.67, "timestamp": "05:52:22", "text": "得到"}, {"type": "subtitle", "time": 21145.51, "timestamp": "05:52:25", "text": "开始了。逆境之塔已解锁。"}, {"type": "subtitle", "time": 21149.43, "timestamp": "05:52:29", "text": "好的。所以，我刚才说的是，比如说苏尔"}, {"type": "subtitle", "time": 21152.39, "timestamp": "05:52:32", "text": "目前位于逆境之塔"}, {"type": "subtitle", "time": 21155.31, "timestamp": "05:52:35", "text": "这个岛，对吧？所以，"}, {"type": "subtitle", "time": 21159.67, "timestamp": "05:52:39", "text": "例如，如果主线任务是……"}, {"type": "subtitle", "time": 21163.59, "timestamp": "05:52:43", "text": "本来应该在 Gin 和 San 碰面的。"}, {"type": "subtitle", "time": 21167.99, "timestamp": "05:52:47", "text": "是节目，对吧？我知道上面写着圣"}, {"type": "subtitle", "time": 21170.15, "timestamp": "05:52:50", "text": "就在这里，对吧？"}, {"type": "subtitle", "time": 21173.67, "timestamp": "05:52:53", "text": "对我来说，触发主事件的一种方式"}, {"type": "subtitle", "time": 21177.03, "timestamp": "05:52:57", "text": "任务农场生成显示角色"}]
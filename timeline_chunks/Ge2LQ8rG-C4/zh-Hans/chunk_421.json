[{"type": "subtitle", "time": 25260.23, "timestamp": "07:01:00", "text": "那天我不会直播，因为"}, {"type": "subtitle", "time": 25263.27, "timestamp": "07:01:03", "text": "我想大概要花一整天时间。"}, {"type": "subtitle", "time": 25266.39, "timestamp": "07:01:06", "text": "所以，城市居民需要改变"}, {"type": "subtitle", "time": 25269.59, "timestamp": "07:01:09", "text": "检查线路并确认所有连接状况。"}, {"type": "subtitle", "time": 25272.708, "timestamp": "07:01:12", "text": "我家一楼的线路"}, {"type": "subtitle", "time": 25275.59, "timestamp": "07:01:15", "text": "我住的地方在一楼。然后"}, {"type": "subtitle", "time": 25278.628, "timestamp": "07:01:18", "text": "他们需要把最上面的那个放上去，"}, {"type": "subtitle", "time": 25281.51, "timestamp": "07:01:21", "text": "把它分开。他们需要改变它"}, {"type": "subtitle", "time": 25283.468, "timestamp": "07:01:23", "text": "三相或"}, {"type": "subtitle", "time": 25286.628, "timestamp": "07:01:26", "text": "某物。是的。我确信当"}, {"type": "subtitle", "time": 25289.03, "timestamp": "07:01:29", "text": "长辈们会来，我爸爸也要来了。"}, {"type": "subtitle", "time": 25292.83, "timestamp": "07:01:32", "text": "比如，“你为什么一直把电脑开着？”"}, {"type": "subtitle", "time": 25296.27, "timestamp": "07:01:36", "text": "白天？因为我呃"}, {"type": "subtitle", "time": 25299.19, "timestamp": "07:01:39", "text": "是的。呃，说到这个，呃，我需要……"}, {"type": "subtitle", "time": 25302.99, "timestamp": "07:01:42", "text": "下载昨天的V。呃，我刚拿到"}, {"type": "subtitle", "time": 25305.628, "timestamp": "07:01:45", "text": "提醒。"}, {"type": "subtitle", "time": 25307.788, "timestamp": "07:01:47", "text": "等等，哪里……"}, {"type": "subtitle", "time": 25311.15, "timestamp": "07:01:51", "text": "我的这个？正确的。复制"}, {"type": "subtitle", "time": 25313.75, "timestamp": "07:01:53", "text": "关联。呃，就是那个六小时的。我需要"}]
[{"type": "subtitle", "time": 20173.51, "timestamp": "05:36:13", "text": "你。等等，它说哦，好的。五。好的。"}, {"type": "subtitle", "time": 20184.99, "timestamp": "05:36:24", "text": "请给我"}, {"type": "subtitle", "time": 20187.99, "timestamp": "05:36:27", "text": "某物。哦，我抽到一个紫色的。哦，"}, {"type": "subtitle", "time": 20189.948, "timestamp": "05:36:29", "text": "好，好，好，好"}, {"type": "subtitle", "time": 20193.51, "timestamp": "05:36:33", "text": "好的。但遗憾的是，我没有足够的钱。"}, {"type": "subtitle", "time": 20199.19, "timestamp": "05:36:39", "text": "事物。我甚至连这点钱都不够。"}, {"type": "subtitle", "time": 20218.31, "timestamp": "05:36:58", "text": "我不认为我应该重新使用"}]
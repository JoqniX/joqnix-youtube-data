[{"type": "subtitle", "time": 33803.03, "timestamp": "09:23:23", "text": "不，只是已經不"}, {"type": "subtitle", "time": 33806.23, "timestamp": "09:23:26", "text": "值得再去找了。親愛的，根據這個座標，"}, {"type": "subtitle", "time": 33812.23, "timestamp": "09:23:32", "text": "我可以肯定地說，這艘鰩魚就是我們在附近打撈上來的那艘船，但我們在那裡發現了一些船員日誌。"}, {"type": "subtitle", "time": 33814.47, "timestamp": "09:23:34", "text": "儘管支離破碎，我們仍然設法將它們與遊戲機中的故事聯繫起來。那麼，莫克和他的船員都安全嗎？我們親眼發現了六具屍體。根據我們"}]
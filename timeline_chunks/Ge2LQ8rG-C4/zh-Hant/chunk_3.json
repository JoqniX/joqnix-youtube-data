[{"type": "subtitle", "time": 181.43, "timestamp": "00:03:01", "text": "或我能為那些路過卻不知道發生了什麼事的人做些什麼？"}, {"type": "subtitle", "time": 188.949, "timestamp": "00:03:08", "text": "因為有些人甚至都沒"}, {"type": "subtitle", "time": 191.83, "timestamp": "00:03:11", "text": "注意到，我知道我不想那樣。"}, {"type": "subtitle", "time": 196.309, "timestamp": "00:03:16", "text": "即使我們那邊直播間裡有很多事情發生，我也希望他們能注意到，對吧"}, {"type": "subtitle", "time": 200.82999999999998, "timestamp": "00:03:20", "text": "？我們有投票"}, {"type": "subtitle", "time": 205.71, "timestamp": "00:03:25", "text": "計時器和捐款目標，一切都與"}, {"type": "subtitle", "time": 208.949, "timestamp": "00:03:28", "text": "時間有關。我需要修復一下"}, {"type": "subtitle", "time": 226.63, "timestamp": "00:03:46", "text": "所以，我一直在思考這個問題。我準備"}, {"type": "subtitle", "time": 230.22899999999998, "timestamp": "00:03:50", "text": "設計一些類似小部件的東西。哦，"}, {"type": "subtitle", "time": 232.99, "timestamp": "00:03:52", "text": "那是類似彈出式"}, {"type": "subtitle", "time": 235.63, "timestamp": "00:03:55", "text": "輸入框的東西嗎？"}, {"type": "subtitle", "time": 238.869, "timestamp": "00:03:58", "text": "或者我可以讓它在我確定自己要"}]
[{"type": "subtitle", "time": 37691.44, "timestamp": "10:28:11", "text": "談論嗶嗶嗶。"}, {"type": "subtitle", "time": 37699.426, "timestamp": "10:28:19", "text": "她為什麼把我的代幣還給我？我"}, {"type": "subtitle", "time": 37701.11, "timestamp": "10:28:21", "text": "明白我姐姐想告訴"}, {"type": "subtitle", "time": 37708.11, "timestamp": "10:28:28", "text": "失望的。"}, {"type": "subtitle", "time": 37710.95, "timestamp": "10:28:30", "text": "接下來是我，寶貝喬。感謝你陪"}, {"type": "subtitle", "time": 37713.39, "timestamp": "10:28:33", "text": "我一起進行這短暫的"}, {"type": "subtitle", "time": 37715.99, "timestamp": "10:28:35", "text": "尋寶之旅。沐浴在"}, {"type": "subtitle", "time": 37720.11, "timestamp": "10:28:40", "text": "日出的美景中。  那太好了"}, {"type": "subtitle", "time": 37732.55, "timestamp": "10:28:52", "text": "旅程。哦，我沒開自動播放"}, {"type": "subtitle", "time": 37733.33, "timestamp": "10:28:53", "text": "功能"}]
[{"type": "subtitle", "time": 31385.99, "timestamp": "08:43:05", "text": "？我沒有["}, {"type": "subtitle", "time": 31388.07, "timestamp": "08:43:08", "text": "音樂] 嗯…攻擊力。我沒有攻擊力道具。哦，等等。我可以從這個東西裡獲得，對吧"}, {"type": "subtitle", "time": 31409.91, "timestamp": "08:43:29", "text": "？豆罐。哦，豆罐。我選一個。我想"}, {"type": "subtitle", "time": 31411.35, "timestamp": "08:43:31", "text": "升級我的波羅斯。是的。你好，"}, {"type": "subtitle", "time": 31421.27, "timestamp": "08:43:41", "text": "穆罕默丹。歡迎，歡迎。你好嗎？希望你一切都好。我們會拿到這些，然後領取這兩個[音樂]。這是進化形態，對吧？"}, {"type": "subtitle", "time": 31437.868, "timestamp": "08:43:57", "text": "我從來沒用過這個。總有一天我會用它的。嗯，我該怎麼獲得豆子？呃，[音樂]"}]
[{"type": "subtitle", "time": 2164.63, "timestamp": "00:36:04", "text": "睡覺了嗎？你好，萬。萬，謝謝你"}, {"type": "subtitle", "time": 2188.19, "timestamp": "00:36:28", "text": "來"}, {"type": "subtitle", "time": 2191.87, "timestamp": "00:36:31", "text": "。謝謝你們的光臨。好好睡一覺。晚安。  晚安。謝謝你們的光臨。  再見。祝你"}, {"type": "subtitle", "time": 2194.87, "timestamp": "00:36:34", "text": "睡個好覺。  [音樂]"}]
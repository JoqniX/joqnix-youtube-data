[{"type": "subtitle", "time": 23121.83, "timestamp": "06:25:21", "text": "所以，"}, {"type": "subtitle", "time": 23124.788, "timestamp": "06:25:24", "text": "我不能一直用同一個主題。呃，我獲得了這個。耶"}, {"type": "subtitle", "time": 23129.67, "timestamp": "06:25:29", "text": "。"}, {"type": "subtitle", "time": 23135.31, "timestamp": "06:25:35", "text": "我們獲得了數據爆炸經驗值。真棒，我解鎖了所有東西。升級。火力公司是10級。"}, {"type": "subtitle", "time": 23157.23, "timestamp": "06:25:57", "text": "我得到了我真的有的[音樂] 六級是上限，對吧？ [音樂] 守護者，我的資料庫好像…我不能…哦，我"}]
[{"type": "subtitle", "time": 37634.87, "timestamp": "10:27:14", "text": "對，你知道，呃，有些人把我視為"}, {"type": "subtitle", "time": 37639.11, "timestamp": "10:27:19", "text": "印度音樂的先驅之類的。我"}, {"type": "subtitle", "time": 37641.426, "timestamp": "10:27:21", "text": "不知道。說實話，我不認為自己是"}, {"type": "subtitle", "time": 37643.99, "timestamp": "10:27:23", "text": "先驅者。"}, {"type": "subtitle", "time": 37647.906, "timestamp": "10:27:27", "text": "嗯，我的意思是，有很多"}, {"type": "subtitle", "time": 37653.426, "timestamp": "10:27:33", "text": "比我更有才華的印度視頻製作者，但我只是想證明他曾經"}, {"type": "subtitle", "time": 37668.31, "timestamp": "10:27:48", "text": "東西，你看出其中的界限了嗎？好的，讓我"}, {"type": "subtitle", "time": 37670.79, "timestamp": "10:27:50", "text": "放大一下，修正一下那個"}, {"type": "subtitle", "time": 37678.67, "timestamp": "10:27:58", "text": "問題。 Zoom 在"}]
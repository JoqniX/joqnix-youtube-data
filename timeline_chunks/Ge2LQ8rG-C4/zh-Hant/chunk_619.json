[{"type": "subtitle", "time": 37140.23, "timestamp": "10:19:00", "text": "怎麼會到島上來呢"}, {"type": "subtitle", "time": 37143.426, "timestamp": "10:19:03", "text": "？我知道像我這樣的人是存在的。我覺得，"}, {"type": "subtitle", "time": 37160.63, "timestamp": "10:19:20", "text": "你可以這樣想。  好的。呃，比如說，我出生在日本，也在日本長大。好的。"}, {"type": "subtitle", "time": 37164.95, "timestamp": "10:19:24", "text": "日文就像…想像一下，你小時候學日語很"}, {"type": "subtitle", "time": 37171.906, "timestamp": "10:19:31", "text": "吃力，雖然你聽得懂，也能和家人說"}, {"type": "subtitle", "time": 37174.95, "timestamp": "10:19:34", "text": "日語等等。好吧，但你一直覺得很難，學習日文、寫作日文等等都很困難"}]
[{"type": "subtitle", "time": 32821.31, "timestamp": "09:07:01", "text": "聽說了《暗黑破壞神：不朽》。"}, {"type": "subtitle", "time": 32826.868, "timestamp": "09:07:06", "text": "呃，我們會……這是什麼？有什麼可以下載的嗎？不。對。放生野獸。你好。我會"}, {"type": "subtitle", "time": 32837.868, "timestamp": "09:07:17", "text": "稍微調低《暗黑破壞神：不朽》的音量。"}, {"type": "subtitle", "time": 32846.35, "timestamp": "09:07:26", "text": "哦，"}, {"type": "subtitle", "time": 32854.18, "timestamp": "09:07:34", "text": "我會在遊戲裡做的。  我們需要在遊戲中實現這"}, {"type": "subtitle", "time": 32874.15, "timestamp": "09:07:54", "text": "戰鬥通行證。  哇。該死"}]
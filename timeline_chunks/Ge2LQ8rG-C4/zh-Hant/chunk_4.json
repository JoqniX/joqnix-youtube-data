[{"type": "subtitle", "time": 241.27, "timestamp": "00:04:01", "text": "切換到睡覺"}, {"type": "subtitle", "time": 244.03, "timestamp": "00:04:04", "text": "或鮑比場景時出現，"}, {"type": "subtitle", "time": 247.03, "timestamp": "00:04:07", "text": "或者如果我能把它提升到下一個層次。"}, {"type": "subtitle", "time": 251.35, "timestamp": "00:04:11", "text": "如果我願意，我可以讓它偵測到我的"}, {"type": "subtitle", "time": 252.75, "timestamp": "00:04:12", "text": "麥克風"}, {"type": "subtitle", "time": 255.75, "timestamp": "00:04:15", "text": "。如果我的麥克風來源靜音，或者"}, {"type": "subtitle", "time": 258.87, "timestamp": "00:04:18", "text": "我的實體麥克風靜音且我沒有"}, {"type": "subtitle", "time": 261.189, "timestamp": "00:04:21", "text": "說話，如果我超過"}, {"type": "subtitle", "time": 263.43, "timestamp": "00:04:23", "text": "10 分鐘沒有說話，我可以讓它"}, {"type": "subtitle", "time": 266.629, "timestamp": "00:04:26", "text": "打開那個文字提示，就像"}, {"type": "subtitle", "time": 269.749, "timestamp": "00:04:29", "text": "一張圖片"}, {"type": "subtitle", "time": 272.749, "timestamp": "00:04:32", "text": "或圖像"}, {"type": "subtitle", "time": 275.43, "timestamp": "00:04:35", "text": "項目一樣，它會"}, {"type": "subtitle", "time": 279.51, "timestamp": "00:04:39", "text": "彈出並顯示「嗯，這是"}, {"type": "subtitle", "time": 283.27, "timestamp": "00:04:43", "text": "一個 VOD，狗當前不在"}, {"type": "subtitle", "time": 285.67, "timestamp": "00:04:45", "text": "畫面中」之類的資訊。我們可以"}, {"type": "subtitle", "time": 287.23, "timestamp": "00:04:47", "text": "有類似的東西"}, {"type": "subtitle", "time": 289.15, "timestamp": "00:04:49", "text": "。"}]
[{"type": "subtitle", "time": 26401.868, "timestamp": "07:20:01", "text": "辦公空間"}, {"type": "subtitle", "time": 26405.03, "timestamp": "07:20:05", "text": "。所以我"}, {"type": "subtitle", "time": 26446.35, "timestamp": "07:20:46", "text": "樓下的那個，不是地下的那個。所以我的電表會和我家的電表連在一起，他們還會為租屋者另外安裝兩個獨立的電表。這是房子的大小嗎"}]
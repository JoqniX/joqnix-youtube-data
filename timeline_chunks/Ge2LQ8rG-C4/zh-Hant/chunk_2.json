[{"type": "subtitle", "time": 123.51, "timestamp": "00:02:03", "text": "寫著文字，說明這是 V，"}, {"type": "subtitle", "time": 126.069, "timestamp": "00:02:06", "text": "我不在直播間，我"}, {"type": "subtitle", "time": 128.07, "timestamp": "00:02:08", "text": "目前不在直播間之類的"}, {"type": "subtitle", "time": 131.63, "timestamp": "00:02:11", "text": "。我在想，這樣"}, {"type": "subtitle", "time": 134.869, "timestamp": "00:02:14", "text": "大家會不會都覺得可以？嗯，這或許"}, {"type": "subtitle", "time": 136.51, "timestamp": "00:02:16", "text": "有助於"}, {"type": "subtitle", "time": 140.07, "timestamp": "00:02:20", "text": "讓觀看的人更容易辨認"}, {"type": "subtitle", "time": 141.91, "timestamp": "00:02:21", "text": "。對於那些觀看"}, {"type": "subtitle", "time": 145.27, "timestamp": "00:02:25", "text": "我直播但聲音被靜音的人"}, {"type": "subtitle", "time": 148.79, "timestamp": "00:02:28", "text": "來說，我想"}, {"type": "subtitle", "time": 158.63, "timestamp": "00:02:38", "text": "我可以設定成這樣，每當你"}, {"type": "subtitle", "time": 164.71, "timestamp": "00:02:44", "text": "訊息時。不，那樣行不通。你好，"}, {"type": "subtitle", "time": 167.869, "timestamp": "00:02:47", "text": "Aki Aki。歡迎來到直播間。"}, {"type": "subtitle", "time": 170.91, "timestamp": "00:02:50", "text": "你好。"}, {"type": "subtitle", "time": 175.42000000000002, "timestamp": "00:02:55", "text": "晚安.這是一件事。嗯，"}, {"type": "subtitle", "time": 177.47, "timestamp": "00:02:57", "text": "[音樂]"}]
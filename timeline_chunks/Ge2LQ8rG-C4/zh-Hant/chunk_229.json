[{"type": "subtitle", "time": 13741.67, "timestamp": "03:49:01", "text": "早上做嗎？我現在內心一片"}, {"type": "subtitle", "time": 13744.74, "timestamp": "03:49:04", "text": "死寂。  我不知道。這首歌太好聽了。它為什麼這麼好？一片混亂。"}, {"type": "subtitle", "time": 13746.51, "timestamp": "03:49:06", "text": "[音樂] 為什麼我會在"}, {"type": "subtitle", "time": 13753.79, "timestamp": "03:49:13", "text": "[音樂]清晨死去？ Dark 隨後發現了鴿子模式的樂趣。這很酷。鴿子模式。哇"}, {"type": "subtitle", "time": 13782.71, "timestamp": "03:49:42", "text": "。"}, {"type": "subtitle", "time": 13789.75, "timestamp": "03:49:49", "text": "什麼？我的天哪，快"}]
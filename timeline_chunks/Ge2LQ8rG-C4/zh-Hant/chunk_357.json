[{"type": "subtitle", "time": 21421.19, "timestamp": "05:57:01", "text": "其實不是升階利爪"}, {"type": "subtitle", "time": 21424.27, "timestamp": "05:57:04", "text": "。一、二、三、四。對。我們來做……我們來做入門技能。"}, {"type": "subtitle", "time": 21429.75, "timestamp": "05:57:09", "text": "不，我們來做終極技能。然後我們來做……我們來做"}, {"type": "subtitle", "time": 21469.15, "timestamp": "05:57:49", "text": "給你……我需要"}, {"type": "subtitle", "time": 21471.15, "timestamp": "05:57:51", "text": "做點什麼。嗯？還有兩個。還有兩個。還有兩個。哦"}, {"type": "subtitle", "time": 21474.15, "timestamp": "05:57:54", "text": "，我們完成每日任務了"}, {"type": "subtitle", "time": 21479.91, "timestamp": "05:57:59", "text": "。哦，我們抓到這傢伙了。"}]
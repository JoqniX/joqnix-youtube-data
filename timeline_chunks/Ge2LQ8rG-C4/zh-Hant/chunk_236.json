[{"type": "subtitle", "time": 14172.15, "timestamp": "03:56:12", "text": "這種音樂太酷了。日本式的饒舌和陷阱音樂之類的東西已經過時了，但你卻身處其中。哦，等等。嗯，我覺得螢幕應該要"}, {"type": "subtitle", "time": 14185.83, "timestamp": "03:56:25", "text": "佔據更大的空間。我看到了你的一張照片。幾乎看不見，"}, {"type": "subtitle", "time": 14197.269, "timestamp": "03:56:37", "text": "但你就在中間"}, {"type": "subtitle", "time": 14200.71, "timestamp": "03:56:40", "text": "。等等，是"}, {"type": "subtitle", "time": 14203.91, "timestamp": "03:56:43", "text": "瓦萊蘭的那個嗎？是合作款嗎？我對合作方面的事情完全摸不著頭腦。我不知道。你現在說的是這件事嗎"}]
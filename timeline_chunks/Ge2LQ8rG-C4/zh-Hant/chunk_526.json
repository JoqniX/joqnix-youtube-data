[{"type": "subtitle", "time": 31571.91, "timestamp": "08:46:11", "text": "擲骰子。我們提升"}, {"type": "subtitle", "time": 31575.11, "timestamp": "08:46:15", "text": "他的等級。"}, {"type": "subtitle", "time": 31580.308, "timestamp": "08:46:20", "text": "可以給他一個大腳本。嗨。然後強化他兩次。很好。他現在很"}, {"type": "subtitle", "time": 31582.388, "timestamp": "08:46:22", "text": "強大了。回來了。呃，給他升級。等等。那他呢？嗯，我給你一個。"}, {"type": "subtitle", "time": 31583.91, "timestamp": "08:46:23", "text": "好。我餵你。別"}, {"type": "subtitle", "time": 31591.11, "timestamp": "08:46:31", "text": "擔心。不，我也會把這隻鳥升到同樣的"}, {"type": "subtitle", "time": 31594.11, "timestamp": "08:46:34", "text": "等級。等等，"}, {"type": "subtitle", "time": 31610.28, "timestamp": "08:46:50", "text": "我可以用火屬性的嗎？我好想用它，但"}, {"type": "subtitle", "time": 31617.11, "timestamp": "08:46:57", "text": "我不會用。盤古恩。企鵝。我知道它並非一無是處。但真正值得的是把你的三星升到"}]
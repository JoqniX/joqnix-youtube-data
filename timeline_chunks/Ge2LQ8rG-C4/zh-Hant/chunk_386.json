[{"type": "subtitle", "time": 23169.43, "timestamp": "06:26:09", "text": "不能馬上查看。我想你可能也看過有人一擊"}, {"type": "subtitle", "time": 23177.03, "timestamp": "06:26:17", "text": "秒殺這些boss之類的，對吧？在這個遊戲裡也是。那些擁有非常幸運的神器或迴響的人會炫耀他們的傷害數字，就像那些YouTube影片裡的人一樣，他們"}, {"type": "subtitle", "time": 23182.868, "timestamp": "06:26:22", "text": "去打boss，然後砰的一聲，兩秒鐘boss就死了。那種50萬傷害之類的，那種難以想像的傷害"}, {"type": "subtitle", "time": 23195.99, "timestamp": "06:26:35", "text": "數字。是的，"}, {"type": "subtitle", "time": 23197.75, "timestamp": "06:26:37", "text": "我會盡可能地這樣做，直到能量"}, {"type": "subtitle", "time": 23199.07, "timestamp": "06:26:39", "text": "耗盡。"}, {"type": "subtitle", "time": 23205.47, "timestamp": "06:26:45", "text": "[音樂]"}]
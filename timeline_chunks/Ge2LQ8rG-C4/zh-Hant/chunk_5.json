[{"type": "subtitle", "time": 313.87, "timestamp": "00:05:13", "text": "我不知道。我剛才想到的一個主意是，"}, {"type": "subtitle", "time": 320.07, "timestamp": "00:05:20", "text": "我收到 Twitch 的評論，"}, {"type": "subtitle", "time": 323.629, "timestamp": "00:05:23", "text": "說我沒有意識到"}, {"type": "subtitle", "time": 329.67, "timestamp": "00:05:29", "text": "我沒有在直播。"}, {"type": "subtitle", "time": 332.87, "timestamp": "00:05:32", "text": "它是那個，它是V等等，就像"}, {"type": "subtitle", "time": 340.11, "timestamp": "00:05:40", "text": "[音樂]之類的東西"}, {"type": "subtitle", "time": 348.15, "timestamp": "00:05:48", "text": "嗯，還有那件事。其次我"}, {"type": "subtitle", "time": 350.749, "timestamp": "00:05:50", "text": "想說的是，我們昨天沒有做"}, {"type": "subtitle", "time": 353.99, "timestamp": "00:05:53", "text": "短片，因為我們當時在忙"}, {"type": "subtitle", "time": 356.67, "timestamp": "00:05:56", "text": "比利比利那"}]
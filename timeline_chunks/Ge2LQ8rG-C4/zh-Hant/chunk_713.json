[{"type": "subtitle", "time": 42786.39, "timestamp": "11:53:06", "text": "如何才能獲得更多酸性油田呢"}, {"type": "subtitle", "time": 42799.83, "timestamp": "11:53:19", "text": "？我所感知的是"}, {"type": "subtitle", "time": 42802.79, "timestamp": "11:53:22", "text": "隱性場。附近有一片塔茲德田。銀頭。  等待。是時候為合成攻擊而戰了。  電刀。座位。沒有砰砰聲。冰沙狀的。  冰沙狀的。什麼？好的。奄奄一息。"}, {"type": "subtitle", "time": 42809.106, "timestamp": "11:53:29", "text": "我們能搞定。  耶。"}, {"type": "subtitle", "time": 42817.51, "timestamp": "11:53:37", "text": "哦，你本來應該在迪奧周圍漂浮的時候"}]
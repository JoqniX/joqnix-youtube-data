[{"type": "subtitle", "time": 27840.31, "timestamp": "07:44:00", "text": "。啊。哦，是的。哦，我"}, {"type": "subtitle", "time": 27843.15, "timestamp": "07:44:03", "text": "想應該是能力方面的"}, {"type": "subtitle", "time": 27846.948, "timestamp": "07:44:06", "text": "問題。與此相關的一些事情。"}, {"type": "subtitle", "time": 27849.07, "timestamp": "07:44:09", "text": "這個實用工具是"}, {"type": "subtitle", "time": 27851.75, "timestamp": "07:44:11", "text": "對的，它可以移除冷卻時間之類的，"}, {"type": "subtitle", "time": 27853.43, "timestamp": "07:44:13", "text": "或者你可以立即使用它，"}, {"type": "subtitle", "time": 27858.548, "timestamp": "07:44:18", "text": "我想對於這一點，我猜"}, {"type": "subtitle", "time": 27880.19, "timestamp": "07:44:40", "text": "蜘蛛俠很簡單。我的天，沒有空間使用IO了。我不得不卸載《"}, {"type": "subtitle", "time": 27884.27, "timestamp": "07:44:44", "text": "彩虹六號：圍攻》。我想玩那個"}, {"type": "subtitle", "time": 27886.948, "timestamp": "07:44:46", "text": "遊戲，至少能獲得一些角色"}, {"type": "subtitle", "time": 27890.75, "timestamp": "07:44:50", "text": "。"}]
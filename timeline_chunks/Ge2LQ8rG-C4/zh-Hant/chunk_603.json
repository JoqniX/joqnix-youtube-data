[{"type": "subtitle", "time": 36184.71, "timestamp": "10:03:04", "text": "我要跌倒了。停止關閉。  你好。我的天哪。等等，我什麼時候到這裡的？  我當時在按壓什麼？  這很糟糕。我其實快要"}, {"type": "subtitle", "time": 36187.71, "timestamp": "10:03:07", "text": "掉隊了。我拍了一下，"}, {"type": "subtitle", "time": 36194.55, "timestamp": "10:03:14", "text": "哦我的天啊。那是雷聲嗎？我扇了自己一巴掌。"}, {"type": "subtitle", "time": 36204.11, "timestamp": "10:03:24", "text": "我把冰水倒在冰淇淋上"}, {"type": "subtitle", "time": 36207.11, "timestamp": "10:03:27", "text": "，然後是[音樂]等等"}, {"type": "subtitle", "time": 36226.23, "timestamp": "10:03:46", "text": "地牢或洞穴一樣。我"}]
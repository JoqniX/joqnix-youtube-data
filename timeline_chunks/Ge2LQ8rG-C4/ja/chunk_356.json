[{"type": "subtitle", "time": 21362.39, "timestamp": "05:56:02", "text": "カットシーンや"}, {"type": "subtitle", "time": 21366.35, "timestamp": "05:56:06", "text": "それに関するアニメーション。あなたと"}, {"type": "subtitle", "time": 21369.19, "timestamp": "05:56:09", "text": "NPCと他のパーティーメンバーか何か"}, {"type": "subtitle", "time": 21373.03, "timestamp": "05:56:13", "text": "魔法の世界に入り込もうとしているような"}, {"type": "subtitle", "time": 21376.75, "timestamp": "05:56:16", "text": "テレポートするためのドアか何か。しかし"}, {"type": "subtitle", "time": 21380.59, "timestamp": "05:56:20", "text": "はい、テストを完了してください"}, {"type": "subtitle", "time": 21383.868, "timestamp": "05:56:23", "text": "1つ。さあ"}, {"type": "subtitle", "time": 21388.19, "timestamp": "05:56:28", "text": "行く。この最終目標は"}, {"type": "subtitle", "time": 21391.948, "timestamp": "05:56:31", "text": "ゲーム安定ゾーン。"}, {"type": "subtitle", "time": 21399.07, "timestamp": "05:56:39", "text": "[音楽]"}]
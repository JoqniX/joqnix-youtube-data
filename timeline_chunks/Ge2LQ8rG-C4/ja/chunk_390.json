[{"type": "subtitle", "time": 23421.11, "timestamp": "06:30:21", "text": "私には"}, {"type": "subtitle", "time": 23424.03, "timestamp": "06:30:24", "text": "待って、私はチェイセンガードを"}, {"type": "subtitle", "time": 23428.948, "timestamp": "06:30:28", "text": "ここ？ああ、彼はそこにいる。だから、もし私がそれを手に入れたら"}, {"type": "subtitle", "time": 23434.19, "timestamp": "06:30:34", "text": "金色のやつは、私に20XPを与えてくれる。"}, {"type": "subtitle", "time": 23437.708, "timestamp": "06:30:37", "text": "よし、これらを手に入れなきゃ"}, {"type": "subtitle", "time": 23442.628, "timestamp": "06:30:42", "text": "超レアなものが好きな人たち。"}, {"type": "subtitle", "time": 23456.07, "timestamp": "06:30:56", "text": "スマーフェイス。待って、私が持っているのはどれだっけ？の"}]
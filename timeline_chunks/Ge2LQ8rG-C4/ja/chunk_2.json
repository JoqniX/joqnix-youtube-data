[{"type": "subtitle", "time": 123.51, "timestamp": "00:02:03", "text": "これはVであり、"}, {"type": "subtitle", "time": 126.069, "timestamp": "00:02:06", "text": "私は流れから離れているが、"}, {"type": "subtitle", "time": 128.07, "timestamp": "00:02:08", "text": "現在配信中か何か"}, {"type": "subtitle", "time": 131.63, "timestamp": "00:02:11", "text": "そんな感じ。それは"}, {"type": "subtitle", "time": 134.869, "timestamp": "00:02:14", "text": "みんな大丈夫？まあ、それは"}, {"type": "subtitle", "time": 136.51, "timestamp": "00:02:16", "text": "ヘルプ"}, {"type": "subtitle", "time": 140.07, "timestamp": "00:02:20", "text": "それを認識できるようにするため、"}, {"type": "subtitle", "time": 141.91, "timestamp": "00:02:21", "text": "見ている。見ている人たちへ"}, {"type": "subtitle", "time": 145.27, "timestamp": "00:02:25", "text": "私の配信はミュートされていて、えーと、誰が、えーと、"}, {"type": "subtitle", "time": 148.79, "timestamp": "00:02:28", "text": "音声なしではダメだと思う、えーと"}, {"type": "subtitle", "time": 158.63, "timestamp": "00:02:38", "text": "えっと、いつでも"}, {"type": "subtitle", "time": 164.71, "timestamp": "00:02:44", "text": "メッセージ。いいえ、それはうまくいきません。こんにちは"}, {"type": "subtitle", "time": 167.869, "timestamp": "00:02:47", "text": "アキアキ。配信へようこ​​そ。"}, {"type": "subtitle", "time": 170.91, "timestamp": "00:02:50", "text": "こんにちは。良い"}, {"type": "subtitle", "time": 175.42000000000002, "timestamp": "00:02:55", "text": "夕方。それは一つの点だ。えっと"}, {"type": "subtitle", "time": 177.47, "timestamp": "00:02:57", "text": "[音楽]"}]
[{"type": "subtitle", "time": 7815.149, "timestamp": "02:10:15", "text": "うん。さよなら。なんてこった。あなたにはできない"}, {"type": "subtitle", "time": 7819.589, "timestamp": "02:10:19", "text": "ただそれだけならトップにはなれない"}, {"type": "subtitle", "time": 7821.589, "timestamp": "02:10:21", "text": "不安な気持ちでセックスしたい"}, {"type": "subtitle", "time": 7822.79, "timestamp": "02:10:22", "text": "尻で議論する。あなたはそうしなければならない"}, {"type": "subtitle", "time": 7825.189, "timestamp": "02:10:25", "text": "支配的な。厳しくしなければならない。あなたは"}, {"type": "subtitle", "time": 7826.629, "timestamp": "02:10:26", "text": "言いたいことを言って、"}, {"type": "subtitle", "time": 7829.51, "timestamp": "02:10:29", "text": "あなたが望むもの。うん。言ってみて。言ってごらん、ジョー。"}, {"type": "subtitle", "time": 7832.51, "timestamp": "02:10:32", "text": "トップになりたいなら、そう言いなさい。ああ、それは"}, {"type": "subtitle", "time": 7836.149, "timestamp": "02:10:36", "text": "ああ、なんてことだ、"}, {"type": "subtitle", "time": 7837.35, "timestamp": "02:10:37", "text": "男。もっと"}, {"type": "subtitle", "time": 7839.03, "timestamp": "02:10:39", "text": "断固とした。トップになりたいなら、"}, {"type": "subtitle", "time": 7841.43, "timestamp": "02:10:41", "text": "教えてくれなきゃ。私は議論するつもりだ。"}, {"type": "subtitle", "time": 7843.35, "timestamp": "02:10:43", "text": "言わなければならない。言わなければならない。"}, {"type": "subtitle", "time": 7847.95, "timestamp": "02:10:47", "text": "うん。さよなら。なんてこった。あなたにはできない"}, {"type": "subtitle", "time": 7852.31, "timestamp": "02:10:52", "text": "ただそれだけならトップにはなれない"}, {"type": "subtitle", "time": 7855.27, "timestamp": "02:10:55", "text": "不安な感じ。選ばれた。選ばれたスポーツマン。"}]
[{"type": "subtitle", "time": 17617.35, "timestamp": "04:53:37", "text": "[音楽]"}, {"type": "subtitle", "time": 17619.99, "timestamp": "04:53:39", "text": "明日は1、2、"}, {"type": "subtitle", "time": 17622.83, "timestamp": "04:53:42", "text": "明日のクリップは主に手持ちカメラで撮影したものです"}, {"type": "subtitle", "time": 17627.51, "timestamp": "04:53:47", "text": "ストリーム。手持ちカメラで撮影した映像です。神よ、手よ"}, {"type": "subtitle", "time": 17629.35, "timestamp": "04:53:49", "text": "カメラ映像。"}, {"type": "subtitle", "time": 17631.11, "timestamp": "04:53:51", "text": "私は自分が何をすべきかわからない"}, {"type": "subtitle", "time": 17634.99, "timestamp": "04:53:54", "text": "私のアイドルボディを見せていますが、"}]
[{"type": "subtitle", "time": 10142.63, "timestamp": "02:49:02", "text": "あなたは受け身ではありません。"}, {"type": "subtitle", "time": 10146.23, "timestamp": "02:49:06", "text": "何てことだ。私は受け身です。"}, {"type": "subtitle", "time": 10151.15, "timestamp": "02:49:11", "text": "え、何これ、底辺全部どうなってるの？"}, {"type": "subtitle", "time": 10155.429, "timestamp": "02:49:15", "text": "疑惑？私は、私は、私は、ああ、なんてことだ。"}, {"type": "subtitle", "time": 10177.67, "timestamp": "02:49:37", "text": "ごめんよ、兄弟。あなたは"}, {"type": "subtitle", "time": 10187.99, "timestamp": "02:49:47", "text": "この疑惑は"}, {"type": "subtitle", "time": 10189.59, "timestamp": "02:49:49", "text": "もっと"}, {"type": "subtitle", "time": 10194.95, "timestamp": "02:49:54", "text": "私の新しい人間が来たとき。 H."}, {"type": "subtitle", "time": 10197.67, "timestamp": "02:49:57", "text": "たくさん。"}, {"type": "subtitle", "time": 10199.51, "timestamp": "02:49:59", "text": "それはもっと苦痛を伴うだろう。あなた"}]
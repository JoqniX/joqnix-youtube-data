[{"type": "subtitle", "time": 17524.39, "timestamp": "04:52:04", "text": "44日目にスコープ検査を受けました。つまり、私はとても"}, {"type": "subtitle", "time": 17550.35, "timestamp": "04:52:30", "text": "それからいくつか"}, {"type": "subtitle", "time": 17553.07, "timestamp": "04:52:33", "text": "[音楽]"}, {"type": "subtitle", "time": 17563.23, "timestamp": "04:52:43", "text": "夜遅くに私が来たとき"}, {"type": "subtitle", "time": 17565.15, "timestamp": "04:52:45", "text": "戻る。私の父"}, {"type": "subtitle", "time": 17567.788, "timestamp": "04:52:47", "text": "私の"}]
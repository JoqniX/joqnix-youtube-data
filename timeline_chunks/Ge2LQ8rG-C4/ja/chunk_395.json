[{"type": "subtitle", "time": 23701.67, "timestamp": "06:35:01", "text": "そうなんですか？あと1つしかないので"}, {"type": "subtitle", "time": 23704.868, "timestamp": "06:35:04", "text": "ここはどこですか？もう一匹のボブフライ。私達はします"}, {"type": "subtitle", "time": 23707.07, "timestamp": "06:35:07", "text": "実際に狩りをする"}, {"type": "subtitle", "time": 23709.23, "timestamp": "06:35:09", "text": "ボブフライ"}, {"type": "subtitle", "time": 23713.35, "timestamp": "06:35:13", "text": "そして今は100％マヤ語です。これだ"}, {"type": "subtitle", "time": 23715.548, "timestamp": "06:35:15", "text": "2番。"}, {"type": "subtitle", "time": 23717.708, "timestamp": "06:35:17", "text": "うん。"}, {"type": "subtitle", "time": 23721.27, "timestamp": "06:35:21", "text": "ええ、そうですね。つまり、私は"}, {"type": "subtitle", "time": 23723.948, "timestamp": "06:35:23", "text": "ボブが飛ぶものをすべて見つける"}, {"type": "subtitle", "time": 23727.99, "timestamp": "06:35:27", "text": "もう一度確認して、どの蝶か"}, {"type": "subtitle", "time": 23730.19, "timestamp": "06:35:30", "text": "私は持っていた"}, {"type": "subtitle", "time": 23733.948, "timestamp": "06:35:33", "text": "見逃した。私の主な推測は"}, {"type": "subtitle", "time": 23737.07, "timestamp": "06:35:37", "text": "一人になる"}, {"type": "subtitle", "time": 23740.948, "timestamp": "06:35:40", "text": "ここからこのエリアのもの。それで"}, {"type": "subtitle", "time": 23743.708, "timestamp": "06:35:43", "text": "念のため確認しましょう。"}, {"type": "subtitle", "time": 23746.59, "timestamp": "06:35:46", "text": "わかった。だってあなたは決して"}, {"type": "subtitle", "time": 23749.948, "timestamp": "06:35:49", "text": "知る。何が起こるかわからないからね。"}, {"type": "subtitle", "time": 23753.788, "timestamp": "06:35:53", "text": "うん。ありがたいことに、私は「いいね！」を必要としません"}, {"type": "subtitle", "time": 23756.548, "timestamp": "06:35:56", "text": "ありがたいことに、Xカバーは必要ありません"}, {"type": "subtitle", "time": 23759.27, "timestamp": "06:35:59", "text": "のために"}]
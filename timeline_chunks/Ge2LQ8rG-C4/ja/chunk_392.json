[{"type": "subtitle", "time": 23522.27, "timestamp": "06:32:02", "text": "クエスト。これを終わらせようと思います"}, {"type": "subtitle", "time": 23525.59, "timestamp": "06:32:05", "text": "えっと、ビスターで一人きりの完全なクエストだから"}, {"type": "subtitle", "time": 23527.15, "timestamp": "06:32:07", "text": "なぜ"}, {"type": "subtitle", "time": 23529.67, "timestamp": "06:32:09", "text": "ない？そして"}, {"type": "subtitle", "time": 23541.59, "timestamp": "06:32:21", "text": "実は。素晴らしい。それは素晴らしいですね"}, {"type": "subtitle", "time": 23546.628, "timestamp": "06:32:26", "text": "貴重で希少な、並外れた戦い。私"}, {"type": "subtitle", "time": 23549.51, "timestamp": "06:32:29", "text": "この協力を迅速に進める必要がある"}, {"type": "subtitle", "time": 23552.31, "timestamp": "06:32:32", "text": "研究チームと確認し、コントロールと照合する"}, {"type": "subtitle", "time": 23559.708, "timestamp": "06:32:39", "text": "ああ、私はほとんど"}, {"type": "subtitle", "time": 23562.708, "timestamp": "06:32:42", "text": "忘れた。これは優先プロジェクトなので、"}, {"type": "subtitle", "time": 23565.23, "timestamp": "06:32:45", "text": "私のような研究者は"}, {"type": "subtitle", "time": 23567.99, "timestamp": "06:32:47", "text": "補助金。重要ではありませんが、"}, {"type": "subtitle", "time": 23570.15, "timestamp": "06:32:50", "text": "補償としてご検討ください"}, {"type": "subtitle", "time": 23572.788, "timestamp": "06:32:52", "text": "あなたの努力。予備があれば"}, {"type": "subtitle", "time": 23574.948, "timestamp": "06:32:54", "text": "お時間をいただければ大変ありがたいです。"}, {"type": "subtitle", "time": 23576.868, "timestamp": "06:32:56", "text": "今後の実験への参加。"}]
[{"type": "subtitle", "time": 16145.03, "timestamp": "04:29:05", "text": "本当に配信するべきだと思う"}, {"type": "subtitle", "time": 16147.67, "timestamp": "04:29:07", "text": "朝。"}, {"type": "subtitle", "time": 16150.229, "timestamp": "04:29:10", "text": "中国の人々も視聴できるように"}, {"type": "subtitle", "time": 16152.269, "timestamp": "04:29:12", "text": "私を使う"}, {"type": "subtitle", "time": 16155.67, "timestamp": "04:29:15", "text": "平和的に。それで朝から晩まで"}, {"type": "subtitle", "time": 16158.95, "timestamp": "04:29:18", "text": "いい子の時間だよ。信じられないことに"}, {"type": "subtitle", "time": 16161.67, "timestamp": "04:29:21", "text": "夜になると人々は寝始める"}, {"type": "subtitle", "time": 16165.95, "timestamp": "04:29:25", "text": "そして午後6時以降のすべて。"}, {"type": "subtitle", "time": 16168.95, "timestamp": "04:29:28", "text": "ISDの人たちは眠りにつくとこう言います"}, {"type": "subtitle", "time": 16171.389, "timestamp": "04:29:31", "text": "夜限定人形"}, {"type": "subtitle", "time": 16175.349, "timestamp": "04:29:35", "text": "滞在する。中国では午前6時ではないですか？"}, {"type": "subtitle", "time": 16177.63, "timestamp": "04:29:37", "text": "なんてこった。 4時です"}, {"type": "subtitle", "time": 16181.51, "timestamp": "04:29:41", "text": "日本時間午前5時。それは"}]
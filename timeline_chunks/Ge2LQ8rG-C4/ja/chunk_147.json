[{"type": "subtitle", "time": 8821.19, "timestamp": "02:27:01", "text": "この仕事に就きたいですか、あなたは"}, {"type": "subtitle", "time": 8823.91, "timestamp": "02:27:03", "text": "いいVトルーパー、君は何か言わなきゃいけない"}, {"type": "subtitle", "time": 8831.349, "timestamp": "02:27:11", "text": "私は、私があなたの話を遮るという事実が好きです"}, {"type": "subtitle", "time": 8833.63, "timestamp": "02:27:13", "text": "提供しなければならない"}, {"type": "subtitle", "time": 8838.07, "timestamp": "02:27:18", "text": "フットパドルを持っている時"}, {"type": "subtitle", "time": 8840.23, "timestamp": "02:27:20", "text": "何？なぜそんなに落ち込んでいるの？"}, {"type": "subtitle", "time": 8844.11, "timestamp": "02:27:24", "text": "フィリピン人女性？つまり、つまり"}, {"type": "subtitle", "time": 8847.83, "timestamp": "02:27:27", "text": "ヘアスタイル、フットペダル。私はそうすべきだ"}, {"type": "subtitle", "time": 8850.19, "timestamp": "02:27:30", "text": "何をすればいいのかわからない"}, {"type": "subtitle", "time": 8853.71, "timestamp": "02:27:33", "text": "する。コラボ配信、チャットは"}, {"type": "subtitle", "time": 8861.11, "timestamp": "02:27:41", "text": "二次的。しかし、それを理解できない人もいる。"}, {"type": "subtitle", "time": 8864.309, "timestamp": "02:27:44", "text": "彼らは不満を言う。ああ、あなたは私を無視している"}, {"type": "subtitle", "time": 8865.99, "timestamp": "02:27:45", "text": "などなど。"}, {"type": "subtitle", "time": 8869.19, "timestamp": "02:27:49", "text": "それが私が買った唯一の理由です"}, {"type": "subtitle", "time": 8871.99, "timestamp": "02:27:51", "text": "フットペダルでチャットで話せるように"}, {"type": "subtitle", "time": 8874.67, "timestamp": "02:27:54", "text": "コラボレーターと話すこともできる"}, {"type": "subtitle", "time": 8877.19, "timestamp": "02:27:57", "text": "ミッチ、しかも足も使ってないのに"}, {"type": "subtitle", "time": 8878.91, "timestamp": "02:27:58", "text": "このペダルを踏む"}]
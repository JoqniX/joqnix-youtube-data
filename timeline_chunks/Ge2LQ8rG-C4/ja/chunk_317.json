[{"type": "subtitle", "time": 19020.91, "timestamp": "05:17:00", "text": "ゲームがなぜ、そしてこれが"}, {"type": "subtitle", "time": 19024.5, "timestamp": "05:17:04", "text": "えっと、ストリームを制限するのが好きで、"}, {"type": "subtitle", "time": 19027.47, "timestamp": "05:17:07", "text": "[音楽]"}, {"type": "subtitle", "time": 19031.23, "timestamp": "05:17:11", "text": "いや、ああ、とにかく"}, {"type": "subtitle", "time": 19034.788, "timestamp": "05:17:14", "text": "音声があれば教えてください。"}, {"type": "subtitle", "time": 19036.47, "timestamp": "05:17:16", "text": "音声が聞こえません。はい、皆さんは"}, {"type": "subtitle", "time": 19039.47, "timestamp": "05:17:19", "text": "音声を聞いてください。ニース。"}, {"type": "subtitle", "time": 19042.07, "timestamp": "05:17:22", "text": "こんにちは。何かアップデートはありますか？私はしていません"}, {"type": "subtitle", "time": 19044.47, "timestamp": "05:17:24", "text": "日課とか全部やったよ。わからない。"}, {"type": "subtitle", "time": 19046.99, "timestamp": "05:17:26", "text": "私はまだやっていない"}, {"type": "subtitle", "time": 19049.19, "timestamp": "05:17:29", "text": "今日のデイリーニュース。たくさんある"}, {"type": "subtitle", "time": 19051.99, "timestamp": "05:17:31", "text": "しかし、目的はあります。ついに到着しました"}, {"type": "subtitle", "time": 19055.67, "timestamp": "05:17:35", "text": "ユニオンレベル30。ついに到達したぞ。"}, {"type": "subtitle", "time": 19059.628, "timestamp": "05:17:39", "text": "組合レベル30、そして私たちは最善を尽くします"}, {"type": "subtitle", "time": 19062.27, "timestamp": "05:17:42", "text": "今日。うん。こんにちは。おはようございます"}, {"type": "subtitle", "time": 19067.788, "timestamp": "05:17:47", "text": "MK12の息子。待って、12K息子を見逃したの？"}, {"type": "subtitle", "time": 19071.868, "timestamp": "05:17:51", "text": "いらっしゃいませ。私はあなたをMKと呼んだ。私は"}, {"type": "subtitle", "time": 19075.51, "timestamp": "05:17:55", "text": "ごめん。そうそう。ようこそ。いらっしゃいませ。"}, {"type": "subtitle", "time": 19078.27, "timestamp": "05:17:58", "text": "おお。良い"}]
[{"type": "subtitle", "time": 5822.27, "timestamp": "01:37:02", "text": "マフィアの剣士であるべきだ。私はします"}, {"type": "subtitle", "time": 5829.39, "timestamp": "01:37:09", "text": "彼。ああ、彼はちょうど"}, {"type": "subtitle", "time": 5842.149, "timestamp": "01:37:22", "text": "待たなければならない。 Arakean はどうやって"}, {"type": "subtitle", "time": 5843.87, "timestamp": "01:37:23", "text": "注射？したい"}, {"type": "subtitle", "time": 5847.709, "timestamp": "01:37:27", "text": "見る。彼はどのようにコラボレーションを行うのか"}, {"type": "subtitle", "time": 5851.149, "timestamp": "01:37:31", "text": "注射？もっと参考資料が必要です"}, {"type": "subtitle", "time": 5854.83, "timestamp": "01:37:34", "text": "けれど。コラボレーションはどのように行うのですか？"}, {"type": "subtitle", "time": 5857.59, "timestamp": "01:37:37", "text": "注射？あ、待って。これはコラボ写真です。"}, {"type": "subtitle", "time": 5860.709, "timestamp": "01:37:40", "text": "何？彼らは何をしたのか？ヴェノムは背後にいる"}, {"type": "subtitle", "time": 5862.39, "timestamp": "01:37:42", "text": "私たち。"}, {"type": "subtitle", "time": 5865.51, "timestamp": "01:37:45", "text": "はい。だから私は「ヴェノム！」と叫んだんです。"}, {"type": "subtitle", "time": 5867.79, "timestamp": "01:37:47", "text": "彼は"}, {"type": "subtitle", "time": 5870.629, "timestamp": "01:37:50", "text": "最高のゲーム。"}, {"type": "subtitle", "time": 5874.229, "timestamp": "01:37:54", "text": "ここで問題になったのは、ヘイズを詰めることだった。"}, {"type": "subtitle", "time": 5876.95, "timestamp": "01:37:56", "text": "ああ、"}, {"type": "subtitle", "time": 5879.109, "timestamp": "01:37:59", "text": "なぜそれをこちらに置かなかったのですか？"}]
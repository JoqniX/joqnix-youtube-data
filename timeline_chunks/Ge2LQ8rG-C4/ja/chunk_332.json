[{"type": "subtitle", "time": 19925.83, "timestamp": "05:32:05", "text": "ジョッキー・ミア、DPSに集中しないといけない"}, {"type": "subtitle", "time": 19929.19, "timestamp": "05:32:09", "text": "初め。わかった、わかった。私は触らない"}, {"type": "subtitle", "time": 19932.03, "timestamp": "05:32:12", "text": "ヴィナ。わかった、"}, {"type": "subtitle", "time": 19935.07, "timestamp": "05:32:15", "text": "大丈夫。わかった、"}, {"type": "subtitle", "time": 19943.83, "timestamp": "05:32:23", "text": "あ、待って。おお。ああ、私はやらなくていいの？"}, {"type": "subtitle", "time": 19945.788, "timestamp": "05:32:25", "text": "これは"}, {"type": "subtitle", "time": 19965.23, "timestamp": "05:32:45", "text": "これをしてください。"}, {"type": "subtitle", "time": 19968.47, "timestamp": "05:32:48", "text": "いいえ、私はロックを解除します"}, {"type": "subtitle", "time": 19970.948, "timestamp": "05:32:50", "text": "これについては別のクラスですね。いいえ、"}, {"type": "subtitle", "time": 19973.03, "timestamp": "05:32:53", "text": "さまざまな難易度で"}, {"type": "subtitle", "time": 19976.15, "timestamp": "05:32:56", "text": "もっと色々なものを持って私。たぶん私たちは"}, {"type": "subtitle", "time": 19979.31, "timestamp": "05:32:59", "text": "私たちができることは"}]
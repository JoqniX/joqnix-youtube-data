[{"type": "subtitle", "time": 2160.15, "timestamp": "00:36:00", "text": "もの。忘れた。ブレットは私に"}, {"type": "subtitle", "time": 2161.55, "timestamp": "00:36:01", "text": "発音する"}, {"type": "subtitle", "time": 2164.63, "timestamp": "00:36:04", "text": "それ。もう一つのゲームは何でしたか？何ですか"}, {"type": "subtitle", "time": 2167.15, "timestamp": "00:36:07", "text": "それ？何だって？何だって"}, {"type": "subtitle", "time": 2171.47, "timestamp": "00:36:11", "text": "あれ？コソのやつ。"}, {"type": "subtitle", "time": 2179.71, "timestamp": "00:36:19", "text": "ポヤント。それは"}, {"type": "subtitle", "time": 2188.19, "timestamp": "00:36:28", "text": "兄弟。来てくれた人は素敵な人でした"}, {"type": "subtitle", "time": 2191.87, "timestamp": "00:36:31", "text": "による。ご来場ありがとうございました"}, {"type": "subtitle", "time": 2194.87, "timestamp": "00:36:34", "text": "による。私は孤独です。信じられないことに、誰も"}, {"type": "subtitle", "time": 2196.99, "timestamp": "00:36:36", "text": "に来る"}, {"type": "subtitle", "time": 2200.23, "timestamp": "00:36:40", "text": "冗談だよ。言うべきではない"}]
[{"type": "subtitle", "time": 13265.51, "timestamp": "03:41:05", "text": "純粋で言うと、いいえ、何、いいえ、いいえ、いいえ、言う"}, {"type": "subtitle", "time": 13268.55, "timestamp": "03:41:08", "text": "では、これは純粋で、そう言うといいえ"}, {"type": "subtitle", "time": 13272.15, "timestamp": "03:41:12", "text": "闇は純粋だと言って、今闇は"}, {"type": "subtitle", "time": 13273.71, "timestamp": "03:41:13", "text": "純粋で言う"}, {"type": "subtitle", "time": 13284.469, "timestamp": "03:41:24", "text": "さや、これ覚えてるよ。二人とも"}, {"type": "subtitle", "time": 13290.269, "timestamp": "03:41:30", "text": "みんな、"}]
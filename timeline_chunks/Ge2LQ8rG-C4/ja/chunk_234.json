[{"type": "subtitle", "time": 14041.349, "timestamp": "03:54:01", "text": "そうしたかったのですが、今は"}, {"type": "subtitle", "time": 14044.99, "timestamp": "03:54:04", "text": "単に数量を繰り返すだけです"}, {"type": "subtitle", "time": 14049.15, "timestamp": "03:54:09", "text": "実験しているからこそ品質が良い"}, {"type": "subtitle", "time": 14050.67, "timestamp": "03:54:10", "text": "今"}, {"type": "subtitle", "time": 14052.189, "timestamp": "03:54:12", "text": "なぜなら"}, {"type": "subtitle", "time": 14055.55, "timestamp": "03:54:15", "text": "YouTubeとTwitchを終えたら"}, {"type": "subtitle", "time": 14057.79, "timestamp": "03:54:17", "text": "クリップ、"}, {"type": "subtitle", "time": 14061.03, "timestamp": "03:54:21", "text": "今後はアップロードを停止する予定です"}, {"type": "subtitle", "time": 14063.63, "timestamp": "03:54:23", "text": "クリップショー"}, {"type": "subtitle", "time": 14067.91, "timestamp": "03:54:27", "text": "ショットを撮って、それから私は"}, {"type": "subtitle", "time": 14071.11, "timestamp": "03:54:31", "text": "おそらく、より高品質なタイプに切り替えるでしょう。"}, {"type": "subtitle", "time": 14075.11, "timestamp": "03:54:35", "text": "しかし問題は、どうすれば質の高いものを得られるのかということです。"}, {"type": "subtitle", "time": 14077.67, "timestamp": "03:54:37", "text": "編集とかする時間すら取れないんです。"}, {"type": "subtitle", "time": 14084.63, "timestamp": "03:54:44", "text": "あまりにも。神様、どうすればいいのでしょう？私は持っていません"}, {"type": "subtitle", "time": 14087.309, "timestamp": "03:54:47", "text": "手伝ってくれる人なら誰でも"}, {"type": "subtitle", "time": 14089.75, "timestamp": "03:54:49", "text": "自分。最終的にはそうしなければならないだろう"}, {"type": "subtitle", "time": 14092.15, "timestamp": "03:54:52", "text": "再び人々に仕事を依頼する。"}, {"type": "subtitle", "time": 14094.71, "timestamp": "03:54:54", "text": "[音楽]"}, {"type": "subtitle", "time": 14096.87, "timestamp": "03:54:56", "text": "でも、今の私はただ"}, {"type": "subtitle", "time": 14097.79, "timestamp": "03:54:57", "text": "したい"}]
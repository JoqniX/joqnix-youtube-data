[{"type": "subtitle", "time": 6540.149, "timestamp": "01:49:00", "text": "大丈夫。ねえ、M。一緒に参加しない？"}, {"type": "subtitle", "time": 6542.39, "timestamp": "01:49:02", "text": "ええ、ぜひご参加ください。参加しませんか。ええ、もしあなたが"}, {"type": "subtitle", "time": 6544.629, "timestamp": "01:49:04", "text": "私たちに参加すれば、ジョックニックを捕まえることができ、"}, {"type": "subtitle", "time": 6577.99, "timestamp": "01:49:37", "text": "友達。コラボレーションのために引退する必要がある、"}, {"type": "subtitle", "time": 6579.75, "timestamp": "01:49:39", "text": "でも、誰とコラボすればいいのかわからない。"}]
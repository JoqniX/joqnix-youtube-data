[{"type": "subtitle", "time": 1284.31, "timestamp": "00:21:24", "text": "ビリーは絞首刑の罰により"}, {"type": "subtitle", "time": 1287.99, "timestamp": "00:21:27", "text": "ビリー、ビリー。私は、"}, {"type": "subtitle", "time": 1289.23, "timestamp": "00:21:29", "text": "休憩。それで"}, {"type": "subtitle", "time": 1292.75, "timestamp": "00:21:32", "text": "だから私は戻ってきた"}, {"type": "subtitle", "time": 1296.789, "timestamp": "00:21:36", "text": "夕食から"}, {"type": "subtitle", "time": 1298.19, "timestamp": "00:21:38", "text": "えーと"}, {"type": "subtitle", "time": 1300.83, "timestamp": "00:21:40", "text": "配信を開始しました"}]
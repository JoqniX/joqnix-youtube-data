[{"type": "subtitle", "time": 9126.309, "timestamp": "02:32:06", "text": "このコラボ、覚えてるよ。いいえ、これは"}, {"type": "subtitle", "time": 9128.15, "timestamp": "02:32:08", "text": "Valerantとのコラボはちょっと"}, {"type": "subtitle", "time": 9136.79, "timestamp": "02:32:16", "text": "良い。私は全員に勝った。私は思う"}, {"type": "subtitle", "time": 9140.389, "timestamp": "02:32:20", "text": "実際、良いプレーをした人"}, {"type": "subtitle", "time": 9151.79, "timestamp": "02:32:31", "text": "ああ、"}, {"type": "subtitle", "time": 9156.23, "timestamp": "02:32:36", "text": "神。ああ、もう一方ですね。順番通りに行動してください。"}, {"type": "subtitle", "time": 9159.63, "timestamp": "02:32:39", "text": "順番通りに行動してください。私はしません"}, {"type": "subtitle", "time": 9164.309, "timestamp": "02:32:44", "text": "ケア。それに従ってください。順番通りに行動してください。"}]
[{"type": "subtitle", "time": 3720.069, "timestamp": "01:02:00", "text": "もっと自己主張をしなければならない"}, {"type": "subtitle", "time": 3723.51, "timestamp": "01:02:03", "text": "あなたはトップになりたい。教えてくれないと。"}, {"type": "subtitle", "time": 3725.27, "timestamp": "01:02:05", "text": "私は議論するつもりだ。言わなければならない"}, {"type": "subtitle", "time": 3729.67, "timestamp": "01:02:09", "text": "それ。何てことだ。私は閉じる必要があります"}, {"type": "subtitle", "time": 3737.27, "timestamp": "01:02:17", "text": "解決しました。引っ張るしかない"}]
[{"type": "subtitle", "time": 15542.55, "timestamp": "04:19:02", "text": "ライト。正直、私はダイイングをプレイしたかった"}, {"type": "subtitle", "time": 15545.349, "timestamp": "04:19:05", "text": "このPのライト2。私はそれを次のようにします"}, {"type": "subtitle", "time": 15549.03, "timestamp": "04:19:09", "text": "私は日本出身です。それから、リンクもダメですね。それ"}, {"type": "subtitle", "time": 15551.83, "timestamp": "04:19:11", "text": "帰宅後の夜は良いでしょう"}, {"type": "subtitle", "time": 15555.83, "timestamp": "04:19:15", "text": "仕事から。 Dying Lightをストリーミング配信するよ。"}, {"type": "subtitle", "time": 15559.67, "timestamp": "04:19:19", "text": "ゾンビを倒して、私のEPに出演する"}, {"type": "subtitle", "time": 15563.03, "timestamp": "04:19:23", "text": "次のモードで2時間のストリームを行い、"}, {"type": "subtitle", "time": 15566.149, "timestamp": "04:19:26", "text": "毛布にくるまって寝なさい。それは良いでしょう"}, {"type": "subtitle", "time": 15596.95, "timestamp": "04:19:56", "text": "口のポーズが"}]
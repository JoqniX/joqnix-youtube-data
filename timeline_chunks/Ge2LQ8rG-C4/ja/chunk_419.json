[{"type": "subtitle", "time": 25142.67, "timestamp": "06:59:02", "text": "両方のCPUキャビネットを保持"}, {"type": "subtitle", "time": 25145.628, "timestamp": "06:59:05", "text": "一緒に。私が何を望んでいるか、あなたは知っています"}, {"type": "subtitle", "time": 25149.19, "timestamp": "06:59:09", "text": "建てる？私はシンプルなものを建てたい"}, {"type": "subtitle", "time": 25151.35, "timestamp": "06:59:11", "text": "ラックとか、そういうやつ"}, {"type": "subtitle", "time": 25154.548, "timestamp": "06:59:14", "text": "セラPCですよね？ええ、そういう類の"}, {"type": "subtitle", "time": 25156.708, "timestamp": "06:59:16", "text": "そういう類のもの。なぜ私はいつも"}, {"type": "subtitle", "time": 25161.67, "timestamp": "06:59:21", "text": "長方形の大きな箱を2つ運ぶ"}, {"type": "subtitle", "time": 25165.35, "timestamp": "06:59:25", "text": "あれ？いいえ、いつもそうです。それらは非常に多くのものを占める"}, {"type": "subtitle", "time": 25169.35, "timestamp": "06:59:29", "text": "空間。いいえ、私が本当に"}, {"type": "subtitle", "time": 25172.868, "timestamp": "06:59:32", "text": "彼の作品を見るのが大好きだし、彼の作品自体も大好きです。"}, {"type": "subtitle", "time": 25176.31, "timestamp": "06:59:36", "text": "だから、彼は３つか４つのピースを持っている、"}, {"type": "subtitle", "time": 25179.27, "timestamp": "06:59:39", "text": "彼のTwitch配信や"}, {"type": "subtitle", "time": 25183.27, "timestamp": "06:59:43", "text": "生産セットアップ。だから彼のために彼は"}, {"type": "subtitle", "time": 25186.15, "timestamp": "06:59:46", "text": "サーバーラックみたいな構造だ。私は"}, {"type": "subtitle", "time": 25188.31, "timestamp": "06:59:48", "text": "うわー、すごくかっこいい。それから私は見る"}, {"type": "subtitle", "time": 25191.708, "timestamp": "06:59:51", "text": "サーバーラックの価格以下。その"}, {"type": "subtitle", "time": 25195.56, "timestamp": "06:59:55", "text": "高価で、私は"}, {"type": "subtitle", "time": 25196.75, "timestamp": "06:59:56", "text": "[拍手]"}]
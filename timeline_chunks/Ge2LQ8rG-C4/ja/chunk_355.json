[{"type": "subtitle", "time": 21300.51, "timestamp": "05:55:00", "text": "カットシーンと"}, {"type": "subtitle", "time": 21303.67, "timestamp": "05:55:03", "text": "色々やってたら、すぐにテレポートした。"}, {"type": "subtitle", "time": 21306.628, "timestamp": "05:55:06", "text": "ここから、あるいはどこか別の場所で初めて"}, {"type": "subtitle", "time": 21308.35, "timestamp": "05:55:08", "text": "交流した"}, {"type": "subtitle", "time": 21311.99, "timestamp": "05:55:11", "text": "彼女と私たちは魔法のようにショーに現れます"}, {"type": "subtitle", "time": 21313.548, "timestamp": "05:55:13", "text": "意味が通じない"}, {"type": "subtitle", "time": 21317.868, "timestamp": "05:55:17", "text": "今。決してそうじゃない。しかし、"}, {"type": "subtitle", "time": 21321.99, "timestamp": "05:55:21", "text": "ゲームが魔法のような"}, {"type": "subtitle", "time": 21323.83, "timestamp": "05:55:23", "text": "ドアか何か、もしくはテレポートのようなもの"}, {"type": "subtitle", "time": 21326.788, "timestamp": "05:55:26", "text": "ポイントか何かで、NPCのように"}, {"type": "subtitle", "time": 21328.03, "timestamp": "05:55:28", "text": "歩く"}, {"type": "subtitle", "time": 21332.708, "timestamp": "05:55:32", "text": "一緒にそのドアに入って"}, {"type": "subtitle", "time": 21334.708, "timestamp": "05:55:34", "text": "ええと、あなたが"}, {"type": "subtitle", "time": 21337.39, "timestamp": "05:55:37", "text": "クエストが開始される。それは"}, {"type": "subtitle", "time": 21339.75, "timestamp": "05:55:39", "text": "すばらしい。それは素晴らしいですね。その"}, {"type": "subtitle", "time": 21342.948, "timestamp": "05:55:42", "text": "このような。こんなドアから入って"}, {"type": "subtitle", "time": 21344.27, "timestamp": "05:55:44", "text": "そして"}, {"type": "subtitle", "time": 21346.27, "timestamp": "05:55:46", "text": "いいねいいね"}, {"type": "subtitle", "time": 21349.99, "timestamp": "05:55:49", "text": "これはドリモンのテレポートドアのようなものか、"}, {"type": "subtitle", "time": 21352.07, "timestamp": "05:55:52", "text": "何かあるよね？そんな感じ。私はしません"}, {"type": "subtitle", "time": 21354.39, "timestamp": "05:55:54", "text": "そのスピーチが存在するかどうかを知る"}, {"type": "subtitle", "time": 21356.59, "timestamp": "05:55:56", "text": "とてもクール"}, {"type": "subtitle", "time": 21359.868, "timestamp": "05:55:59", "text": "見る。うん。私はしません"}]
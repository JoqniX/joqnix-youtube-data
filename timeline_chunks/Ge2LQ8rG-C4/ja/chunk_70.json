[{"type": "subtitle", "time": 4200.41, "timestamp": "01:10:00", "text": "私はこれが本当に欲しい"}, {"type": "subtitle", "time": 4201.63, "timestamp": "01:10:01", "text": "[音楽]"}, {"type": "subtitle", "time": 4203.35, "timestamp": "01:10:03", "text": "男。"}, {"type": "subtitle", "time": 4205.87, "timestamp": "01:10:05", "text": "[音楽]"}, {"type": "subtitle", "time": 4229.87, "timestamp": "01:10:29", "text": "神よ、私は来ます"}, {"type": "subtitle", "time": 4232.189, "timestamp": "01:10:32", "text": "戻る。私は"}, {"type": "subtitle", "time": 4236.27, "timestamp": "01:10:36", "text": "猫背。私は別の地域にいたか、"}, {"type": "subtitle", "time": 4246.99, "timestamp": "01:10:46", "text": "私はまだトウモロコシを手に入れていない"}]
[{"type": "subtitle", "time": 21600.43, "timestamp": "06:00:00", "text": "何？だから、同じものを使い続けることはできない"}, {"type": "subtitle", "time": 21621.548, "timestamp": "06:00:21", "text": "くそ、もっと全部アンロックしたよ"}, {"type": "subtitle", "time": 21624.47, "timestamp": "06:00:24", "text": "もの。レベルアップする。消防会社はレベルです"}, {"type": "subtitle", "time": 21626.19, "timestamp": "06:00:26", "text": "10. 私は手に入れた"}, {"type": "subtitle", "time": 21628.28, "timestamp": "06:00:28", "text": "本当に"}, {"type": "subtitle", "time": 21642.39, "timestamp": "06:00:42", "text": "[音楽]"}, {"type": "subtitle", "time": 21659.708, "timestamp": "06:00:59", "text": "ガーディアン、私のデータバンクはこんな感じ"}]
[{"type": "subtitle", "time": 3798.549, "timestamp": "01:03:18", "text": "これを一つやってください。私は滞在することになった。私は滞在することになった。私"}, {"type": "subtitle", "time": 3802.15, "timestamp": "01:03:22", "text": "滞在することになった。私は私の友人です。あなたはしたい"}, {"type": "subtitle", "time": 3816.6, "timestamp": "01:03:36", "text": "塊茎？これによって私はどれを得るのですか？"}, {"type": "subtitle", "time": 3826.829, "timestamp": "01:03:46", "text": "私"}, {"type": "subtitle", "time": 3834.99, "timestamp": "01:03:54", "text": "パル"}]
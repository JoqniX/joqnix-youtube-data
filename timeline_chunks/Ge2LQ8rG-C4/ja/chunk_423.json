[{"type": "subtitle", "time": 25380.628, "timestamp": "07:03:00", "text": "広々としている。それでおしまい。だから私の電気は"}, {"type": "subtitle", "time": 25382.948, "timestamp": "07:03:02", "text": "メーターの接続は"}, {"type": "subtitle", "time": 25386.43, "timestamp": "07:03:06", "text": "私の下に繋がっているようには"}, {"type": "subtitle", "time": 25389.67, "timestamp": "07:03:09", "text": "地下1階。だから私の"}, {"type": "subtitle", "time": 25392.548, "timestamp": "07:03:12", "text": "私の家族の1つと"}, {"type": "subtitle", "time": 25395.91, "timestamp": "07:03:15", "text": "彼らはさらに2つの別個のものを作る予定です"}, {"type": "subtitle", "time": 25398.75, "timestamp": "07:03:18", "text": "賃貸用のメーター"}, {"type": "subtitle", "time": 25401.67, "timestamp": "07:03:21", "text": "人々。これは家の大きさですか、それとも"}, {"type": "subtitle", "time": 25410.868, "timestamp": "07:03:30", "text": "漏洩があったかどうかはわかりません"}, {"type": "subtitle", "time": 25413.39, "timestamp": "07:03:33", "text": "起こっている"}, {"type": "subtitle", "time": 25416.548, "timestamp": "07:03:36", "text": "多く。つまり、一度私たちは"}, {"type": "subtitle", "time": 25420.19, "timestamp": "07:03:40", "text": "こういう人たちがいて、彼らは"}, {"type": "subtitle", "time": 25422.788, "timestamp": "07:03:42", "text": "全ての配線を完全に取り外し、"}, {"type": "subtitle", "time": 25425.11, "timestamp": "07:03:45", "text": "直してくれたけど、仕上がりが悪かった。の"}, {"type": "subtitle", "time": 25427.67, "timestamp": "07:03:47", "text": "電線の品質が悪かった。あった"}, {"type": "subtitle", "time": 25430.39, "timestamp": "07:03:50", "text": "漏れ。電気が"}, {"type": "subtitle", "time": 25432.948, "timestamp": "07:03:52", "text": "あちこちで火花が散っている。の"}, {"type": "subtitle", "time": 25436.31, "timestamp": "07:03:56", "text": "主電源が頻繁に遮断される"}, {"type": "subtitle", "time": 25439.31, "timestamp": "07:03:59", "text": "多く。ああ、あの頃は"}]
[{"type": "subtitle", "time": 21482.35, "timestamp": "05:58:02", "text": "このキャラクターのような男性"}, {"type": "subtitle", "time": 21484.91, "timestamp": "05:58:04", "text": "キャラクター。私はこれを持っています"}, {"type": "subtitle", "time": 21487.788, "timestamp": "05:58:07", "text": "けれど。何？これは男性ですか？"}, {"type": "subtitle", "time": 21501.51, "timestamp": "05:58:21", "text": "同じ？わからない。"}, {"type": "subtitle", "time": 21502.61, "timestamp": "05:58:22", "text": "私は選びます"}, {"type": "subtitle", "time": 21503.708, "timestamp": "05:58:23", "text": "[音楽]"}, {"type": "subtitle", "time": 21504.82, "timestamp": "05:58:24", "text": "あなた。 Y"}, {"type": "subtitle", "time": 21507.39, "timestamp": "05:58:27", "text": "[音楽]"}, {"type": "subtitle", "time": 21510.43, "timestamp": "05:58:30", "text": "私はこれに慣れています"}, {"type": "subtitle", "time": 21512.83, "timestamp": "05:58:32", "text": "実は。私"}, {"type": "subtitle", "time": 21517.07, "timestamp": "05:58:37", "text": "たぶん一度くらいは交換する"}, {"type": "subtitle", "time": 21521.07, "timestamp": "05:58:41", "text": "それ。 1 2 3。それがどのように"}, {"type": "subtitle", "time": 21524.51, "timestamp": "05:58:44", "text": "行く。ガルストロはいつも"}, {"type": "subtitle", "time": 21528.67, "timestamp": "05:58:48", "text": "メインチームが揃っているときは、1つ。そして私は"}]
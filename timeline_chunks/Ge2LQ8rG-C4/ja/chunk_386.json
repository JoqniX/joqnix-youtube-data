[{"type": "subtitle", "time": 23166.15, "timestamp": "06:26:06", "text": "そして、私はキャプチャカードを使っているので"}, {"type": "subtitle", "time": 23169.43, "timestamp": "06:26:09", "text": "今となっては、私にはこれを制御する術がありません。私"}, {"type": "subtitle", "time": 23171.91, "timestamp": "06:26:11", "text": "他の配信者と同じにはなれない"}, {"type": "subtitle", "time": 23175.43, "timestamp": "06:26:15", "text": "ストリーム配信はゲームウィンドウのみ"}, {"type": "subtitle", "time": 23177.03, "timestamp": "06:26:17", "text": "キャプチャまたはゲームキャプチャ。私はできません"}, {"type": "subtitle", "time": 23178.51, "timestamp": "06:26:18", "text": "それ。つまり私は"}, {"type": "subtitle", "time": 23182.868, "timestamp": "06:26:22", "text": "OBS 番号を実行して OBS を実行できます"}, {"type": "subtitle", "time": 23184.59, "timestamp": "06:26:24", "text": "3つまたは"}, {"type": "subtitle", "time": 23186.43, "timestamp": "06:26:26", "text": "二"}, {"type": "subtitle", "time": 23189.03, "timestamp": "06:26:29", "text": "しかし、そのフィードを送信すると"}, {"type": "subtitle", "time": 23192.35, "timestamp": "06:26:32", "text": "レイテンシーなど。だから、それは一種の"}, {"type": "subtitle", "time": 23195.99, "timestamp": "06:26:35", "text": "ウェブサイトのバッジサインを調べるべきです。ああ"}, {"type": "subtitle", "time": 23197.75, "timestamp": "06:26:37", "text": "そうそう、それを見てみるべきだよね、それを見て。"}, {"type": "subtitle", "time": 23199.07, "timestamp": "06:26:39", "text": "上。"}, {"type": "subtitle", "time": 23202.38, "timestamp": "06:26:42", "text": "ええ、本当に。私はそうすべきだ"}, {"type": "subtitle", "time": 23205.47, "timestamp": "06:26:45", "text": "[音楽]"}, {"type": "subtitle", "time": 23217.83, "timestamp": "06:26:57", "text": "ボーナス。何も持っていません"}]
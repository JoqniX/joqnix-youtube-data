[{"type": "subtitle", "time": 24301.03, "timestamp": "06:45:01", "text": "ここ。見てみましょう。"}, {"type": "subtitle", "time": 24324.99, "timestamp": "06:45:24", "text": "秒した"}, {"type": "subtitle", "time": 24328.628, "timestamp": "06:45:28", "text": "えっと、神のサインが称賛される？それはそうあるべきだ"}, {"type": "subtitle", "time": 24331.39, "timestamp": "06:45:31", "text": "自動的に行われる。倍にさせてください"}, {"type": "subtitle", "time": 24334.23, "timestamp": "06:45:34", "text": "チェック。ああ、そうだったね。あなたはそうしました。ニース。ニース。"}, {"type": "subtitle", "time": 24342.59, "timestamp": "06:45:42", "text": "神。私は見せないようにしなければならない"}, {"type": "subtitle", "time": 24345.27, "timestamp": "06:45:45", "text": "トゥイッチ。アカウント停止処分を受けたくない"}, {"type": "subtitle", "time": 24350.03, "timestamp": "06:45:50", "text": "また。 60秒。いいえ。ああ、ビリー"}, {"type": "subtitle", "time": 24353.15, "timestamp": "06:45:53", "text": "ビリー。ああ、これ"}, {"type": "subtitle", "time": 24357.11, "timestamp": "06:45:57", "text": "男。あなたは運命の人ですか？なぜ持ってきたのですか"}]
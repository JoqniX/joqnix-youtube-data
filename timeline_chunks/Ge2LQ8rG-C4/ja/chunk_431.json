[{"type": "subtitle", "time": 25860.548, "timestamp": "07:11:00", "text": "父が変わった"}, {"type": "subtitle", "time": 25863.59, "timestamp": "07:11:03", "text": "国内からレンタル品"}, {"type": "subtitle", "time": 25865.51, "timestamp": "07:11:05", "text": "コマーシャル。そういうことってあるの？私はしません"}, {"type": "subtitle", "time": 25878.91, "timestamp": "07:11:18", "text": "うん。私はしません"}, {"type": "subtitle", "time": 25883.39, "timestamp": "07:11:23", "text": "知る。ミルカ。私はミラだと思う。私はしません"}, {"type": "subtitle", "time": 25890.708, "timestamp": "07:11:30", "text": "知る。私が知っているのは、自分のやるべきことをやらなければならないということだけです。"}, {"type": "subtitle", "time": 25893.51, "timestamp": "07:11:33", "text": "家族のためにお金を稼ぐのが一番"}, {"type": "subtitle", "time": 25895.99, "timestamp": "07:11:35", "text": "どうにか。"}, {"type": "subtitle", "time": 25899.27, "timestamp": "07:11:39", "text": "ああ、だって彼らは"}, {"type": "subtitle", "time": 25900.59, "timestamp": "07:11:40", "text": "年を取る"}, {"type": "subtitle", "time": 25904.468, "timestamp": "07:11:44", "text": "一人っ子として、私は面倒を見なければならない"}, {"type": "subtitle", "time": 25905.548, "timestamp": "07:11:45", "text": "の"}, {"type": "subtitle", "time": 25908.35, "timestamp": "07:11:48", "text": "家族。まあまあ"}, {"type": "subtitle", "time": 25910.83, "timestamp": "07:11:50", "text": "[音楽]"}, {"type": "subtitle", "time": 25913.43, "timestamp": "07:11:53", "text": "家族を養わなければならないし"}, {"type": "subtitle", "time": 25914.59, "timestamp": "07:11:54", "text": "彼らを守る。"}, {"type": "subtitle", "time": 25918.07, "timestamp": "07:11:58", "text": "いいえ、でも仕事は引き受けないと思います"}]
[{"type": "subtitle", "time": 3484.75, "timestamp": "00:58:04", "text": "画面。コラボは切り抜きが難しい"}, {"type": "subtitle", "time": 3488.15, "timestamp": "00:58:08", "text": "ショートパンツ。もし私が適切な"}, {"type": "subtitle", "time": 3490.43, "timestamp": "00:58:10", "text": "良い編集者、私はきちんとできたはずだ"}, {"type": "subtitle", "time": 3494.069, "timestamp": "00:58:14", "text": "それ。彼らにそれをきちんとやるように頼んでください"}, {"type": "subtitle", "time": 3496.03, "timestamp": "00:58:16", "text": "方法またはいくつかの"}, {"type": "subtitle", "time": 3526.43, "timestamp": "00:58:46", "text": "あなたは本当に"}, {"type": "subtitle", "time": 3529.47, "timestamp": "00:58:49", "text": "ボトムっぽい雰囲気だね。あなた"}, {"type": "subtitle", "time": 3531.67, "timestamp": "00:58:51", "text": "もっと断固とした態度をとらなければならない"}]
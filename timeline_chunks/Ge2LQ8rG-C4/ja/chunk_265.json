[{"type": "subtitle", "time": 15913.349, "timestamp": "04:25:13", "text": "1つ。 SRとは何ですか？"}, {"type": "subtitle", "time": 15916.469, "timestamp": "04:25:16", "text": "SRが何なのかさえ知らなかった"}, {"type": "subtitle", "time": 15919.269, "timestamp": "04:25:19", "text": "あの小川。みんな私にそう言ったよ。"}, {"type": "subtitle", "time": 15921.55, "timestamp": "04:25:21", "text": "それはシャー・ルカーンの"}, {"type": "subtitle", "time": 15924.91, "timestamp": "04:25:24", "text": "短いもの"}, {"type": "subtitle", "time": 15929.149, "timestamp": "04:25:29", "text": "形状。くそ、俺は偽インディアナじゃないのか"}, {"type": "subtitle", "time": 15932.229, "timestamp": "04:25:32", "text": "それ？私はこのことについて全く知りません。"}, {"type": "subtitle", "time": 15935.269, "timestamp": "04:25:35", "text": "私はシャカン映画を観たことがあります。私は思う"}]
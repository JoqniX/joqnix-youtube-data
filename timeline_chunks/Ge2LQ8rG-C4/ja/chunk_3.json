[{"type": "subtitle", "time": 181.43, "timestamp": "00:03:01", "text": "あるいは、訪れる人々に私は何ができるだろうか？"}, {"type": "subtitle", "time": 188.949, "timestamp": "00:03:08", "text": "だって、中にはそうしない人もいるから"}, {"type": "subtitle", "time": 191.83, "timestamp": "00:03:11", "text": "気づいて、私がそれを望んでいないことを理解してください。私"}, {"type": "subtitle", "time": 193.55, "timestamp": "00:03:13", "text": "彼らに"}, {"type": "subtitle", "time": 196.309, "timestamp": "00:03:16", "text": "たとえたくさんの物があっても、"}, {"type": "subtitle", "time": 198.47, "timestamp": "00:03:18", "text": "あちらの私たちのストリームで起こっていること、"}, {"type": "subtitle", "time": 200.82999999999998, "timestamp": "00:03:20", "text": "右？サブアトンがあります"}, {"type": "subtitle", "time": 205.71, "timestamp": "00:03:25", "text": "タイマーと寄付目標、すべて"}, {"type": "subtitle", "time": 208.949, "timestamp": "00:03:28", "text": "時間。私は"}, {"type": "subtitle", "time": 226.63, "timestamp": "00:03:46", "text": "だから、私はこのことを考えるんです。準備はできています"}, {"type": "subtitle", "time": 230.22899999999998, "timestamp": "00:03:50", "text": "例えば、ウィジェットのようなものをデザインする。おお、"}, {"type": "subtitle", "time": 232.99, "timestamp": "00:03:52", "text": "それはポップアップのようなものですか？"}, {"type": "subtitle", "time": 235.63, "timestamp": "00:03:55", "text": "何か入力？"}, {"type": "subtitle", "time": 238.869, "timestamp": "00:03:58", "text": "あるいは、確信が持てたときに表示させることもできます"}]
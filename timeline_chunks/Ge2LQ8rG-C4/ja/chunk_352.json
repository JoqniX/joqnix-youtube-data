[{"type": "subtitle", "time": 21121.31, "timestamp": "05:52:01", "text": "シミュレーター内で後ほど話し合う"}, {"type": "subtitle", "time": 21123.19, "timestamp": "05:52:03", "text": "環境は、"}, {"type": "subtitle", "time": 21125.23, "timestamp": "05:52:05", "text": "主題"}, {"type": "subtitle", "time": 21127.59, "timestamp": "05:52:07", "text": "反乱は、"}, {"type": "subtitle", "time": 21135.43, "timestamp": "05:52:15", "text": "パターンは、トレーニングに近いですね"}, {"type": "subtitle", "time": 21138.788, "timestamp": "05:52:18", "text": "もちろん、いいよ"}, {"type": "subtitle", "time": 21141.51, "timestamp": "05:52:21", "text": "えっと、ハートが1つあることに気づくでしょう。さあ"}, {"type": "subtitle", "time": 21142.67, "timestamp": "05:52:22", "text": "得る"}, {"type": "subtitle", "time": 21145.51, "timestamp": "05:52:25", "text": "開始しました。逆境の塔が解錠されました。"}, {"type": "subtitle", "time": 21149.43, "timestamp": "05:52:29", "text": "わかった。だから、私が言ったのは、例えばサー"}, {"type": "subtitle", "time": 21152.39, "timestamp": "05:52:32", "text": "現在、タワー・オブ・アドバーシティにいます"}, {"type": "subtitle", "time": 21155.31, "timestamp": "05:52:35", "text": "この島ですよね？それで、"}, {"type": "subtitle", "time": 21159.67, "timestamp": "05:52:39", "text": "例えばメインクエストで"}, {"type": "subtitle", "time": 21163.59, "timestamp": "05:52:43", "text": "サンとギンで会う予定だった"}, {"type": "subtitle", "time": 21167.99, "timestamp": "05:52:47", "text": "ショーですよね？そして、サンが"}, {"type": "subtitle", "time": 21170.15, "timestamp": "05:52:50", "text": "こっちですよね？"}, {"type": "subtitle", "time": 21173.67, "timestamp": "05:52:53", "text": "私がメインをトリガーする方法"}, {"type": "subtitle", "time": 21177.03, "timestamp": "05:52:57", "text": "クエストファーム生成ショーキャラクターの原因"}]
[{"type": "subtitle", "time": 18901.55, "timestamp": "05:15:01", "text": "痛みです。"}, {"type": "subtitle", "time": 18903.55, "timestamp": "05:15:03", "text": "なぜ？しかし"}, {"type": "subtitle", "time": 18908.43, "timestamp": "05:15:08", "text": "うん、痛いけど、そうだよ。えっと、何？"}, {"type": "subtitle", "time": 18911.99, "timestamp": "05:15:11", "text": "それ以外？私は自分の"}, {"type": "subtitle", "time": 18914.31, "timestamp": "05:15:14", "text": "今後は他のウェブサイトなどを表示する"}, {"type": "subtitle", "time": 18916.55, "timestamp": "05:15:16", "text": "前進。だから、私はそれを控えるようにします"}, {"type": "subtitle", "time": 18918.948, "timestamp": "05:15:18", "text": "特にライブ配信では。それはそうしなければならない"}, {"type": "subtitle", "time": 18922.07, "timestamp": "05:15:22", "text": "プロ意識を持って行動しましょう。まあ、そんな感じかな。そうですね"}, {"type": "subtitle", "time": 18925.75, "timestamp": "05:15:25", "text": "安全のため、すべてのプラットフォームルールは"}, {"type": "subtitle", "time": 18929.19, "timestamp": "05:15:29", "text": "えっと、なんて言うんだっけ？"}, {"type": "subtitle", "time": 18931.19, "timestamp": "05:15:31", "text": "すべて順調に進みました。だからそうに違いない"}, {"type": "subtitle", "time": 18934.788, "timestamp": "05:15:34", "text": "注意深い。うん。ヴォードに関して"}, {"type": "subtitle", "time": 18937.75, "timestamp": "05:15:37", "text": "私はボードゲームをしに行くところです"}, {"type": "subtitle", "time": 18939.23, "timestamp": "05:15:39", "text": "もの"}, {"type": "subtitle", "time": 18941.39, "timestamp": "05:15:41", "text": "そう、わかってるよ"}, {"type": "subtitle", "time": 18944.75, "timestamp": "05:15:44", "text": "これに対して。してはいけないことは分かっています"}, {"type": "subtitle", "time": 18949.83, "timestamp": "05:15:49", "text": "録画されたコンテンツやビデオを再生する"}, {"type": "subtitle", "time": 18953.23, "timestamp": "05:15:53", "text": "他のプラットフォームでもまだ"}, {"type": "subtitle", "time": 18957.27, "timestamp": "05:15:57", "text": "私はそれが何かであることに同意したい"}]
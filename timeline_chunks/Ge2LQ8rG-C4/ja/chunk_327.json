[{"type": "subtitle", "time": 19623.51, "timestamp": "05:27:03", "text": "でも、私はそうしたくない。まるで私がそうしなければならないかのように"}, {"type": "subtitle", "time": 19624.83, "timestamp": "05:27:04", "text": "積極的に"}, {"type": "subtitle", "time": 19627.43, "timestamp": "05:27:07", "text": "挽く。それはただのそれはいくつかの"}, {"type": "subtitle", "time": 19628.67, "timestamp": "05:27:08", "text": "分。それで"}, {"type": "subtitle", "time": 19632.47, "timestamp": "05:27:12", "text": "ああ、大変だ、私のカリストのHPが低い。私"}, {"type": "subtitle", "time": 19635.67, "timestamp": "05:27:15", "text": "忘れた。私は注意を払っていませんでした。私はそうしました"}, {"type": "subtitle", "time": 19637.708, "timestamp": "05:27:17", "text": "支払わない"}, {"type": "subtitle", "time": 19641.55, "timestamp": "05:27:21", "text": "注意。私は彼が"}, {"type": "subtitle", "time": 19644.67, "timestamp": "05:27:24", "text": "ゲーム。それで"}, {"type": "subtitle", "time": 19647.708, "timestamp": "05:27:27", "text": "うん、"}, {"type": "subtitle", "time": 19650.788, "timestamp": "05:27:30", "text": "敵のボスは手強いだろう。しないで"}, {"type": "subtitle", "time": 19653.11, "timestamp": "05:27:33", "text": "心配。カリストスをレベルアップさせて"}, {"type": "subtitle", "time": 19656.67, "timestamp": "05:27:36", "text": "彼があなたを殴るところまで"}, {"type": "subtitle", "time": 19659.59, "timestamp": "05:27:39", "text": "簡単に。でも、エコーは私が"}, {"type": "subtitle", "time": 19662.47, "timestamp": "05:27:42", "text": "心配している。このエコーは知らない"}, {"type": "subtitle", "time": 19666.07, "timestamp": "05:27:46", "text": "こういう数学的なもの、えーと全部"}, {"type": "subtitle", "time": 19669.19, "timestamp": "05:27:49", "text": "私が知っているのはクリティカル率だけです。"}, {"type": "subtitle", "time": 19671.19, "timestamp": "05:27:51", "text": "攻撃力、攻撃率。それらは"}, {"type": "subtitle", "time": 19679.03, "timestamp": "05:27:59", "text": "エネルギーの再充電と、"}]
[{"type": "subtitle", "time": 19321.19, "timestamp": "05:22:01", "text": "来る。ああ、忘れてた。ああ、私は"}, {"type": "subtitle", "time": 19323.03, "timestamp": "05:22:03", "text": "レベル。おお。ああ、神様。忘れた。忘れた。"}, {"type": "subtitle", "time": 19327.27, "timestamp": "05:22:07", "text": "私は、えーと、このもののレベルを忘れていました。"}, {"type": "subtitle", "time": 19330.948, "timestamp": "05:22:10", "text": "世界ランキング、ああ、なんてことだ。その"}, {"type": "subtitle", "time": 19333.39, "timestamp": "05:22:13", "text": "これから少し難しくなるだろう。おお"}, {"type": "subtitle", "time": 19336.948, "timestamp": "05:22:16", "text": "いいえ。実際に"}, {"type": "subtitle", "time": 19338.43, "timestamp": "05:22:18", "text": "敗北"}, {"type": "subtitle", "time": 19341.91, "timestamp": "05:22:21", "text": "彼ら。ほら、彼らの名札は黄色だよ。"}, {"type": "subtitle", "time": 19344.11, "timestamp": "05:22:24", "text": "ああ、ない"}, {"type": "subtitle", "time": 19359.39, "timestamp": "05:22:39", "text": "おお。する"}, {"type": "subtitle", "time": 19362.31, "timestamp": "05:22:42", "text": "これ。そうそう。私の主人公は"}, {"type": "subtitle", "time": 19364.788, "timestamp": "05:22:44", "text": "ローバーは実際には60歳です。"}, {"type": "subtitle", "time": 19367.35, "timestamp": "05:22:47", "text": "昨日昇格したんですよね？うん。それで"}, {"type": "subtitle", "time": 19372.47, "timestamp": "05:22:52", "text": "今日私たちの目標は上昇することです 私たちの目標は"}, {"type": "subtitle", "time": 19376.708, "timestamp": "05:22:56", "text": "唯一無二のカリストに昇る。私"}, {"type": "subtitle", "time": 19379.59, "timestamp": "05:22:59", "text": "別名カル・シャドウ。私は彼をカリストと呼ぶ"}]
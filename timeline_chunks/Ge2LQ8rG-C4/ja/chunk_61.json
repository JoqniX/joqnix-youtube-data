[{"type": "subtitle", "time": 3662.069, "timestamp": "01:01:02", "text": "私が言ったのはまさにそれだったかな？"}, {"type": "subtitle", "time": 3669.03, "timestamp": "01:01:09", "text": "この動画、マジでヤバいよ。あなたがそれ"}, {"type": "subtitle", "time": 3681.87, "timestamp": "01:01:21", "text": "ケツに[ __ ]する。あなたは"}, {"type": "subtitle", "time": 3695.64, "timestamp": "01:01:35", "text": "あなたは あなたが望むものに"}, {"type": "subtitle", "time": 3702.309, "timestamp": "01:01:42", "text": "そしてあなたが欲しいもの、そしてあなたが取らなければならないもの"}, {"type": "subtitle", "time": 3705.19, "timestamp": "01:01:45", "text": "あなたが望むもの。うん。言ってみて。言ってごらん、ジョー。"}, {"type": "subtitle", "time": 3708.75, "timestamp": "01:01:48", "text": "あなたはそうなりたいのなら、そう言ってください。"}, {"type": "subtitle", "time": 3716.43, "timestamp": "01:01:56", "text": "あなたは"}, {"type": "subtitle", "time": 3718.789, "timestamp": "01:01:58", "text": "マジでボトムっぽい雰囲気出してるよ。あなた"}]
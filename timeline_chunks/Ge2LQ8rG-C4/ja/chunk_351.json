[{"type": "subtitle", "time": 21060.548, "timestamp": "05:51:00", "text": "ちょっと悲しい感じもするけど。もしそれが私が"}, {"type": "subtitle", "time": 21063.07, "timestamp": "05:51:03", "text": "そう思うなら、私はすごく"}, {"type": "subtitle", "time": 21066.39, "timestamp": "05:51:06", "text": "ハッピー。だから、もしあなたが同じような人なら"}, {"type": "subtitle", "time": 21068.39, "timestamp": "05:51:08", "text": "まるであなたが立ち止まった人のような"}, {"type": "subtitle", "time": 21070.788, "timestamp": "05:51:10", "text": "しばらくゲームをプレイした後、"}, {"type": "subtitle", "time": 21072.708, "timestamp": "05:51:12", "text": "クエストが山積みになっている"}, {"type": "subtitle", "time": 21074.91, "timestamp": "05:51:14", "text": "そしてあなたはただ"}, {"type": "subtitle", "time": 21078.31, "timestamp": "05:51:18", "text": "ゆっくりとクエストの一つに取り組みます"}, {"type": "subtitle", "time": 21081.03, "timestamp": "05:51:21", "text": "一度にまとめて、ジャグリングするのではなく"}, {"type": "subtitle", "time": 21083.91, "timestamp": "05:51:23", "text": "複数のクエストの合間に。ええ、そうだったらいいのに"}, {"type": "subtitle", "time": 21086.31, "timestamp": "05:51:26", "text": "私が言ったのは、その機能であれば、"}, {"type": "subtitle", "time": 21095.11, "timestamp": "05:51:35", "text": "知ってるよ、NPCはもっと忙しくなるか、"}, {"type": "subtitle", "time": 21097.83, "timestamp": "05:51:37", "text": "別の地域または別の場所で"}, {"type": "subtitle", "time": 21100.868, "timestamp": "05:51:40", "text": "特定のクエストのため。方法"}, {"type": "subtitle", "time": 21105.67, "timestamp": "05:51:45", "text": "彼らをリダイレクトするか、あるいは、えーと"}, {"type": "subtitle", "time": 21114.35, "timestamp": "05:51:54", "text": "えーと、サービス時間に関する情報提供依頼"}, {"type": "subtitle", "time": 21117.51, "timestamp": "05:51:57", "text": "状況 78 四半期には多くの"}, {"type": "subtitle", "time": 21118.948, "timestamp": "05:51:58", "text": "我々が知る必要がある情報は"}]
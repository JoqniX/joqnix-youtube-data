[{"type": "subtitle", "time": 21815.708, "timestamp": "06:03:35", "text": "人々。ああ、レベル60か。どうやってそんなに"}, {"type": "subtitle", "time": 21818.548, "timestamp": "06:03:38", "text": "時間はどれくらい？反響音だと思います。私"}, {"type": "subtitle", "time": 21822.67, "timestamp": "06:03:42", "text": "レベルアップしていないようです"}, {"type": "subtitle", "time": 21826.31, "timestamp": "06:03:46", "text": "反響。あれは難しい。たとえ"}, {"type": "subtitle", "time": 21828.708, "timestamp": "06:03:48", "text": "原神でも、これらのアーティファクトはスキップします。"}, {"type": "subtitle", "time": 21832.628, "timestamp": "06:03:52", "text": "研磨とか色々、だってわからないから"}, {"type": "subtitle", "time": 21834.83, "timestamp": "06:03:54", "text": "私にとって何が最善か、"}, {"type": "subtitle", "time": 21838.15, "timestamp": "06:03:58", "text": "いいこととかそういうの。だから、私は最大限まで尽くします"}]
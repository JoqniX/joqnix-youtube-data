[{"type": "subtitle", "time": 13741.67, "timestamp": "03:49:01", "text": "上。パソコンの動作が遅くなっているのがわかる。何てことだ、"}, {"type": "subtitle", "time": 13744.74, "timestamp": "03:49:04", "text": "私のPCの動作が遅い。 OBSを見て、"}, {"type": "subtitle", "time": 13746.51, "timestamp": "03:49:06", "text": "[音楽]"}, {"type": "subtitle", "time": 13751.43, "timestamp": "03:49:11", "text": "ニース"}, {"type": "subtitle", "time": 13753.79, "timestamp": "03:49:13", "text": "[音楽]"}, {"type": "subtitle", "time": 13757.189, "timestamp": "03:49:17", "text": "痛み。うん。うん。うん。それは、"}, {"type": "subtitle", "time": 13782.71, "timestamp": "03:49:42", "text": "彼女。しかし、重要なのは全体の文脈です"}, {"type": "subtitle", "time": 13789.75, "timestamp": "03:49:49", "text": "あの、あのね？私は「私は」を選びます"}, {"type": "subtitle", "time": 13793.189, "timestamp": "03:49:53", "text": "とりあえず今はベースキャンプに拠点を置くことにします。"}]
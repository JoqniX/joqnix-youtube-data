[{"type": "subtitle", "time": 19263.59, "timestamp": "05:21:03", "text": "[音楽]"}, {"type": "subtitle", "time": 19266.628, "timestamp": "05:21:06", "text": "マイルストーンのステージ5を完了する。ステージ"}, {"type": "subtitle", "time": 19269.628, "timestamp": "05:21:09", "text": "五。あなたは私に完了してほしい"}, {"type": "subtitle", "time": 19273.11, "timestamp": "05:21:13", "text": "それ？でも私は今日私は"}, {"type": "subtitle", "time": 19275.43, "timestamp": "05:21:15", "text": "今日はダメだ。今日、今日、今日、私たちが"}, {"type": "subtitle", "time": 19278.23, "timestamp": "05:21:18", "text": "実際にこれらのチュートリアルを行う"}, {"type": "subtitle", "time": 19281.51, "timestamp": "05:21:21", "text": "クエストとか色々。いいえ、ただ試してみます"}, {"type": "subtitle", "time": 19283.23, "timestamp": "05:21:23", "text": "さらにロックを解除するには"}, {"type": "subtitle", "time": 19285.67, "timestamp": "05:21:25", "text": "もの。だから、あまり心配する必要はない。"}, {"type": "subtitle", "time": 19287.07, "timestamp": "05:21:27", "text": "について"}, {"type": "subtitle", "time": 19294.55, "timestamp": "05:21:34", "text": "えっと、なんて呼ぶんだっけ？閉じ込められる"}, {"type": "subtitle", "time": 19297.27, "timestamp": "05:21:37", "text": "あるいは、そんな感じ。毎日の課題に取り組みましょう。"}, {"type": "subtitle", "time": 19307.868, "timestamp": "05:21:47", "text": "こんにちは。どこ"}, {"type": "subtitle", "time": 19312.27, "timestamp": "05:21:52", "text": "それ？わかった。そちら側。それは"}, {"type": "subtitle", "time": 19315.948, "timestamp": "05:21:55", "text": "ウルフたち。これは簡単な問題です。"}, {"type": "subtitle", "time": 19318.868, "timestamp": "05:21:58", "text": "はぁ？一つしかない。そうそう。人々"}]
[{"type": "subtitle", "time": 841.11, "timestamp": "00:14:01", "text": "それ。言ってごらん、ジョー。だって君はトップになりたいんだろ？"}, {"type": "subtitle", "time": 844.55, "timestamp": "00:14:04", "text": "言ってみて。なんてこった。それはあなたに欲しくなる。おお"}, {"type": "subtitle", "time": 846.949, "timestamp": "00:14:06", "text": "我が神よ。"}, {"type": "subtitle", "time": 848.15, "timestamp": "00:14:08", "text": "おい、もっと"}, {"type": "subtitle", "time": 849.99, "timestamp": "00:14:09", "text": "トップになりたいなら、主張しろ。あなたは"}, {"type": "subtitle", "time": 852.55, "timestamp": "00:14:12", "text": "教えてください。俺たちはヤるつもりだ、お前は"}, {"type": "subtitle", "time": 855.509, "timestamp": "00:14:15", "text": "言ってください。言わなければならない。ああ、私は"}, {"type": "subtitle", "time": 858.71, "timestamp": "00:14:18", "text": "この崖から落ちて死ぬ。おお。何てことだ、"}, {"type": "subtitle", "time": 863.79, "timestamp": "00:14:23", "text": "私は死にかけている。助けて。私の"}, {"type": "subtitle", "time": 873.389, "timestamp": "00:14:33", "text": "神。ああ、残りのメンバーはソロみたいな感じ"}, {"type": "subtitle", "time": 876.55, "timestamp": "00:14:36", "text": "ストリーム。これはOhの最後です。"}, {"type": "subtitle", "time": 885.67, "timestamp": "00:14:45", "text": "私の友達の友達、もしあなたがこれを手に入れたいなら"}, {"type": "subtitle", "time": 888.069, "timestamp": "00:14:48", "text": "仕事、あなたは良いVuberになりたい、"}, {"type": "subtitle", "time": 890.3, "timestamp": "00:14:50", "text": "いくつか言わなければならない"}, {"type": "subtitle", "time": 891.87, "timestamp": "00:14:51", "text": "[音楽]"}, {"type": "subtitle", "time": 898.87, "timestamp": "00:14:58", "text": "広告収入が得られる。"}]
[{"type": "subtitle", "time": 21182.548, "timestamp": "05:53:02", "text": "NP NPCsでは、彼女が"}, {"type": "subtitle", "time": 21186.07, "timestamp": "05:53:06", "text": "直接テレポートされるか、わからない"}, {"type": "subtitle", "time": 21188.628, "timestamp": "05:53:08", "text": "何らかの方法でメインクエストをトリガーして"}, {"type": "subtitle", "time": 21191.67, "timestamp": "05:53:11", "text": "ストーリーラインを続けてください、なぜなら私は出会ったからです"}, {"type": "subtitle", "time": 21193.99, "timestamp": "05:53:13", "text": "彼女はまるでどこか別の場所から来た人のようだ"}, {"type": "subtitle", "time": 21196.35, "timestamp": "05:53:16", "text": "それがどうなるかはわかりません"}, {"type": "subtitle", "time": 21198.948, "timestamp": "05:53:18", "text": "仕事がどうなるかはわかりません"}, {"type": "subtitle", "time": 21204.51, "timestamp": "05:53:24", "text": "仕事。でも、そうですね、えっと、こんな感じ"}, {"type": "subtitle", "time": 21207.99, "timestamp": "05:53:27", "text": "それ。まるで、まるで、まるで"}, {"type": "subtitle", "time": 21209.47, "timestamp": "05:53:29", "text": "のように"}, {"type": "subtitle", "time": 21212.948, "timestamp": "05:53:32", "text": "えっと、あなたにはやるべき仕事が与えられました"}, {"type": "subtitle", "time": 21219.59, "timestamp": "05:53:39", "text": "例えば、sh のような"}, {"type": "subtitle", "time": 21223.51, "timestamp": "05:53:43", "text": "いや、誰かに聞かれたと言って"}, {"type": "subtitle", "time": 21226.708, "timestamp": "05:53:46", "text": "どこかで会う"}, {"type": "subtitle", "time": 21229.99, "timestamp": "05:53:49", "text": "でもまず食料品の買い出しをしなければならなかったので"}, {"type": "subtitle", "time": 21232.59, "timestamp": "05:53:52", "text": "別の友人、または同じ人物が見た"}, {"type": "subtitle", "time": 21236.47, "timestamp": "05:53:56", "text": "スーパーマーケットにいる私。だから私たちは話す"}, {"type": "subtitle", "time": 21238.788, "timestamp": "05:53:58", "text": "会議では何について話し合うのか"}]
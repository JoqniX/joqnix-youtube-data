[{"type": "subtitle", "time": 26280.548, "timestamp": "07:18:00", "text": "アニメとかそういうもの。私はそれが恋しいです、なぜならそれは"}, {"type": "subtitle", "time": 26282.91, "timestamp": "07:18:02", "text": "だった"}, {"type": "subtitle", "time": 26285.83, "timestamp": "07:18:05", "text": "その間。しかし、私がこれらのストリームを配信し、"}, {"type": "subtitle", "time": 26287.67, "timestamp": "07:18:07", "text": "いろいろあって、すごく忙しかったんだと思います。私"}, {"type": "subtitle", "time": 26292.43, "timestamp": "07:18:12", "text": "知る。"}, {"type": "subtitle", "time": 26299.868, "timestamp": "07:18:19", "text": "ええと、これです。"}, {"type": "subtitle", "time": 26304.23, "timestamp": "07:18:24", "text": "いいえ。水面を越えて飛んでいったんです。"}, {"type": "subtitle", "time": 26322.39, "timestamp": "07:18:42", "text": "ここ。しかし、それは存在しない。つまり私は"}, {"type": "subtitle", "time": 26325.39, "timestamp": "07:18:45", "text": "収集しました、"}, {"type": "subtitle", "time": 26337.868, "timestamp": "07:18:57", "text": "次は"}]
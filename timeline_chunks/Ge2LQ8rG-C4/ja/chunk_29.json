[{"type": "subtitle", "time": 1740.59, "timestamp": "00:29:00", "text": "多くの。"}, {"type": "subtitle", "time": 1744.43, "timestamp": "00:29:04", "text": "えっと、それは"}, {"type": "subtitle", "time": 1748.99, "timestamp": "00:29:08", "text": "すべての言葉"}, {"type": "subtitle", "time": 1752.75, "timestamp": "00:29:12", "text": "日本語を話しますが、"}, {"type": "subtitle", "time": 1755.07, "timestamp": "00:29:15", "text": "感じる"}, {"type": "subtitle", "time": 1759.59, "timestamp": "00:29:19", "text": "そうなるだろう、そうなるだろう、そうなるだろう"}, {"type": "subtitle", "time": 1761.07, "timestamp": "00:29:21", "text": "大丈夫"}, {"type": "subtitle", "time": 1773.63, "timestamp": "00:29:33", "text": "日本はおそらく"}, {"type": "subtitle", "time": 1778.75, "timestamp": "00:29:38", "text": "私がそこにいるときは、おじいちゃん。私はそこにいます"}, {"type": "subtitle", "time": 1780.35, "timestamp": "00:29:40", "text": "以来"}, {"type": "subtitle", "time": 1783.47, "timestamp": "00:29:43", "text": "私が思うに"}, {"type": "subtitle", "time": 1785.149, "timestamp": "00:29:45", "text": "えーと"}, {"type": "subtitle", "time": 1788.269, "timestamp": "00:29:48", "text": "使用する必要がある"}, {"type": "subtitle", "time": 1791.63, "timestamp": "00:29:51", "text": "ほとんどの場合英語"}, {"type": "subtitle", "time": 1794.909, "timestamp": "00:29:54", "text": "それ以来そこに"}]
[{"type": "subtitle", "time": 18422.03, "timestamp": "05:07:02", "text": "犬のビリー・ビリー・ストリームは"}, {"type": "subtitle", "time": 18435.73, "timestamp": "05:07:15", "text": "あなたの。滞在時間が長くなるほど、"}, {"type": "subtitle", "time": 18440.99, "timestamp": "05:07:20", "text": "[音楽]"}, {"type": "subtitle", "time": 18451.07, "timestamp": "05:07:31", "text": "寝る。明日アップロードします"}, {"type": "subtitle", "time": 18455.11, "timestamp": "05:07:35", "text": "何か。心配ない。"}, {"type": "subtitle", "time": 18457.19, "timestamp": "05:07:37", "text": "皆さん、3時になります。"}, {"type": "subtitle", "time": 18459.83, "timestamp": "05:07:39", "text": "本当に寝ようと思う。おやすみ。"}]
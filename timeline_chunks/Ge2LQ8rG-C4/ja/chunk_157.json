[{"type": "subtitle", "time": 9425.309, "timestamp": "02:37:05", "text": "[音楽]"}, {"type": "subtitle", "time": 9442.79, "timestamp": "02:37:22", "text": "この曲、すごくかわいい。だから、私は"}, {"type": "subtitle", "time": 9445.51, "timestamp": "02:37:25", "text": "それを学びなさい。私は歌うつもりです"}, {"type": "subtitle", "time": 9464.75, "timestamp": "02:37:44", "text": "様。はい、確認していました"}, {"type": "subtitle", "time": 9467.59, "timestamp": "02:37:47", "text": "アストロズ。アストラ、私はストリーミングのみ"}, {"type": "subtitle", "time": 9470.67, "timestamp": "02:37:50", "text": "今。もうやめてくれ"}, {"type": "subtitle", "time": 9473.19, "timestamp": "02:37:53", "text": "ストリーミング配信。配信はどうでしたか？これは"}, {"type": "subtitle", "time": 9474.349, "timestamp": "02:37:54", "text": "ない"}]
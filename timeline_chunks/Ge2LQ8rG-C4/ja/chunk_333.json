[{"type": "subtitle", "time": 19982.03, "timestamp": "05:33:02", "text": "マッチメイク"}, {"type": "subtitle", "time": 19987.11, "timestamp": "05:33:07", "text": "レベル60だった。ついにアンロックできた。おお"}, {"type": "subtitle", "time": 19989.67, "timestamp": "05:33:09", "text": "男の子。"}, {"type": "subtitle", "time": 19992.67, "timestamp": "05:33:12", "text": "レベル50のとき、"}, {"type": "subtitle", "time": 19996.35, "timestamp": "05:33:16", "text": "右？ 60歳ですね。"}, {"type": "subtitle", "time": 19999.948, "timestamp": "05:33:19", "text": "はぁ？ 60歳ですね。"}, {"type": "subtitle", "time": 20002.83, "timestamp": "05:33:22", "text": "３、２、"}, {"type": "subtitle", "time": 20005.39, "timestamp": "05:33:25", "text": "1つ。さあ、やってみよう"}, {"type": "subtitle", "time": 20009.91, "timestamp": "05:33:29", "text": "最高。私の知る限りでは低い。私はそれが"}, {"type": "subtitle", "time": 20012.51, "timestamp": "05:33:32", "text": "より低い"}, {"type": "subtitle", "time": 20016.59, "timestamp": "05:33:36", "text": "あなた。できますか できますか できますか できますか できますか"}, {"type": "subtitle", "time": 20032.548, "timestamp": "05:33:52", "text": "ローバー、君にレベルアップしてほしいんだ"}, {"type": "subtitle", "time": 20039.03, "timestamp": "05:33:59", "text": "上。もしあなたが私に尋ねるなら、ジョック、なぜ"}]
[{"type": "subtitle", "time": 14465.99, "timestamp": "04:01:05", "text": "悪い。私は最初のクリップを私がやります。ああ、"}, {"type": "subtitle", "time": 14467.05, "timestamp": "04:01:07", "text": "神。"}, {"type": "subtitle", "time": 14468.75, "timestamp": "04:01:08", "text": "[音楽]"}, {"type": "subtitle", "time": 14472.63, "timestamp": "04:01:12", "text": "わーい。私もそう思います。ちゃんと眠れるといいな"}, {"type": "subtitle", "time": 14519.469, "timestamp": "04:01:59", "text": "[音楽]"}]
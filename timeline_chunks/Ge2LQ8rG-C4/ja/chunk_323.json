[{"type": "subtitle", "time": 19383.43, "timestamp": "05:23:03", "text": "何らかの理由で。ガルは知らないから"}, {"type": "subtitle", "time": 19390.27, "timestamp": "05:23:10", "text": "わかった。でもでも"}, {"type": "subtitle", "time": 19394.11, "timestamp": "05:23:14", "text": "うん。だから私たちは"}, {"type": "subtitle", "time": 19398.19, "timestamp": "05:23:18", "text": "彼。だから、私たちは"}, {"type": "subtitle", "time": 19410.11, "timestamp": "05:23:30", "text": "最高。 20回ガチャを引きたい"}, {"type": "subtitle", "time": 19420.708, "timestamp": "05:23:40", "text": "追伸でも私は何とかして手に入れなければならない"}, {"type": "subtitle", "time": 19424.31, "timestamp": "05:23:44", "text": "えっと、5。えっと、7つありますよね？ 8 n 10。"}, {"type": "subtitle", "time": 19425.788, "timestamp": "05:23:45", "text": "3つ必要です"}, {"type": "subtitle", "time": 19429.35, "timestamp": "05:23:49", "text": "もっと。三つ。えっと、15。15。15を手に入れます"}, {"type": "subtitle", "time": 19433.868, "timestamp": "05:23:53", "text": "私がレベル35くらいの時ですよね？つまり15。"}, {"type": "subtitle", "time": 19439.15, "timestamp": "05:23:59", "text": "15. 待つ。ああ、数学。私は数学が苦手です。えっと"}]
[{"type": "subtitle", "time": 22745.31, "timestamp": "06:19:05", "text": "[音楽]"}, {"type": "subtitle", "time": 22748.91, "timestamp": "06:19:08", "text": "推測。それで十分でしょうか？"}, {"type": "subtitle", "time": 22762.31, "timestamp": "06:19:22", "text": "推測。でもクリティカルダメージは"}, {"type": "subtitle", "time": 22766.05, "timestamp": "06:19:26", "text": "良い統計値になるんだよ、わかるだろ？"}, {"type": "subtitle", "time": 22770.628, "timestamp": "06:19:30", "text": "[音楽]"}, {"type": "subtitle", "time": 22780.35, "timestamp": "06:19:40", "text": "ボーナス。"}, {"type": "subtitle", "time": 22783.82, "timestamp": "06:19:43", "text": "待て、この男だ。私は必要としている"}, {"type": "subtitle", "time": 22787.31, "timestamp": "06:19:47", "text": "[音楽]"}, {"type": "subtitle", "time": 22790.13, "timestamp": "06:19:50", "text": "攻撃。攻撃。"}]
[{"type": "subtitle", "time": 20467.548, "timestamp": "05:41:07", "text": "１、２、３、４。右。さあ"}, {"type": "subtitle", "time": 20472.15, "timestamp": "05:41:12", "text": "自己紹介スキルをやってみましょう。いいえ、"}, {"type": "subtitle", "time": 20493.15, "timestamp": "05:41:33", "text": "何とかできると思う"}, {"type": "subtitle", "time": 20494.91, "timestamp": "05:41:34", "text": "それ。"}, {"type": "subtitle", "time": 20501.39, "timestamp": "05:41:41", "text": "もっと。"}, {"type": "subtitle", "time": 20511.548, "timestamp": "05:41:51", "text": "わかった。"}, {"type": "subtitle", "time": 20514.03, "timestamp": "05:41:54", "text": "これは私があげます"}, {"type": "subtitle", "time": 20516.868, "timestamp": "05:41:56", "text": "私はこれについて何か対策を講じる必要がある。"}, {"type": "subtitle", "time": 20519.548, "timestamp": "05:41:59", "text": "はぁ？あと2人。二"}]
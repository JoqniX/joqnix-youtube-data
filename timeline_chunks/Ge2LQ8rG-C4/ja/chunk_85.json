[{"type": "subtitle", "time": 5101.59, "timestamp": "01:25:01", "text": "ピンチ。あれらは金庫室だ。何が"}, {"type": "subtitle", "time": 5104.229, "timestamp": "01:25:04", "text": "これ？その時、私はビデオをアップロードします。"}, {"type": "subtitle", "time": 5127.39, "timestamp": "01:25:27", "text": "今日は30、いや20をアップロードしなければならない"}, {"type": "subtitle", "time": 5131.39, "timestamp": "01:25:31", "text": "今日はアップロードしなければならない"}, {"type": "subtitle", "time": 5140.47, "timestamp": "01:25:40", "text": "昨日。結局は"}, {"type": "subtitle", "time": 5142.709, "timestamp": "01:25:42", "text": "在庫がなくなりそうだ。そしたら私は「いや」って言うよ"}, {"type": "subtitle", "time": 5145.39, "timestamp": "01:25:45", "text": "もうショートパンツは作らない。それは"}, {"type": "subtitle", "time": 5148.47, "timestamp": "01:25:48", "text": "それ。そこが問題なんです。私はできません"}, {"type": "subtitle", "time": 5150.27, "timestamp": "01:25:50", "text": "ショット"}, {"type": "subtitle", "time": 5153.149, "timestamp": "01:25:53", "text": "永遠に。人々が私を切り取ってくれることを望む"}, {"type": "subtitle", "time": 5155.83, "timestamp": "01:25:55", "text": "可能。私自身も何をすべきかわからない"}]
[{"type": "subtitle", "time": 25200.35, "timestamp": "07:00:00", "text": "この時点で私は"}, {"type": "subtitle", "time": 25202.11, "timestamp": "07:00:02", "text": "まるで私が"}, {"type": "subtitle", "time": 25204.788, "timestamp": "07:00:04", "text": "建設工事があるので、"}, {"type": "subtitle", "time": 25206.17, "timestamp": "07:00:06", "text": "我が家で起こっていること。"}, {"type": "subtitle", "time": 25207.99, "timestamp": "07:00:07", "text": "[拍手]"}, {"type": "subtitle", "time": 25210.43, "timestamp": "07:00:10", "text": "この時点で、私は尋ねるべきだと感じています"}, {"type": "subtitle", "time": 25214.07, "timestamp": "07:00:14", "text": "それらを製造のように構築する"}, {"type": "subtitle", "time": 25215.868, "timestamp": "07:00:15", "text": "人々が構築することを好む"}, {"type": "subtitle", "time": 25219.27, "timestamp": "07:00:19", "text": "私は金属の何かが好きです。"}, {"type": "subtitle", "time": 25221.27, "timestamp": "07:00:21", "text": "彼らは溶接とかできるし、"}, {"type": "subtitle", "time": 25223.59, "timestamp": "07:00:23", "text": "何か作ってみるんだ、だろ？でもできない"}, {"type": "subtitle", "time": 25226.59, "timestamp": "07:00:26", "text": "その金属を使って金属を溶かし、"}, {"type": "subtitle", "time": 25229.99, "timestamp": "07:00:29", "text": "右？電子機器には、"}, {"type": "subtitle", "time": 25233.59, "timestamp": "07:00:33", "text": "その特定のアルミニウムの種類は問いません"}, {"type": "subtitle", "time": 25240.46, "timestamp": "07:00:40", "text": "わからない。実際はそうではない"}, {"type": "subtitle", "time": 25248.83, "timestamp": "07:00:48", "text": "知る。都市は"}, {"type": "subtitle", "time": 25252.23, "timestamp": "07:00:52", "text": "上。ああ、エラシティの人は来なかった"}, {"type": "subtitle", "time": 25254.948, "timestamp": "07:00:54", "text": "まだ。エラシティの男は"}, {"type": "subtitle", "time": 25258.31, "timestamp": "07:00:58", "text": "早く来て。だから、いつかきっとね。それで、"}]
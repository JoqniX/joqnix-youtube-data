[{"type": "subtitle", "time": 5643.11, "timestamp": "01:34:03", "text": "自分？うん。彼らに小便をしてほしくない。私"}, {"type": "subtitle", "time": 5644.24, "timestamp": "01:34:04", "text": "ビン"}, {"type": "subtitle", "time": 5645.87, "timestamp": "01:34:05", "text": "[音楽]"}, {"type": "subtitle", "time": 5649.51, "timestamp": "01:34:09", "text": "彼ら。そこが問題なんです。だって私は"}, {"type": "subtitle", "time": 5651.79, "timestamp": "01:34:11", "text": "それは"}]
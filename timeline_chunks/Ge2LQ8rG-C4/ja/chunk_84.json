[{"type": "subtitle", "time": 5059.55, "timestamp": "01:24:19", "text": "[音楽]"}, {"type": "subtitle", "time": 5070.31, "timestamp": "01:24:30", "text": "わかったよ、ビリー、ビリー。これをアップロードする必要がある"}, {"type": "subtitle", "time": 5077.189, "timestamp": "01:24:37", "text": "良い。字幕を付けられたらいいのに"}, {"type": "subtitle", "time": 5081.11, "timestamp": "01:24:41", "text": "中国語でビリービリー、男。聖なる"}, {"type": "subtitle", "time": 5083.39, "timestamp": "01:24:43", "text": "神よ、これは一体何だ？"}, {"type": "subtitle", "time": 5094.31, "timestamp": "01:24:54", "text": "あら、それ中国語じゃないの？"}]
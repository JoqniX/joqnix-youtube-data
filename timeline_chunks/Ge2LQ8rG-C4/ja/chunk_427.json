[{"type": "subtitle", "time": 25621.35, "timestamp": "07:07:01", "text": "改修後の外観はどのようなものになるか。そして"}, {"type": "subtitle", "time": 25624.07, "timestamp": "07:07:04", "text": "この部屋、こちらのドア、ほらね"}, {"type": "subtitle", "time": 25627.19, "timestamp": "07:07:07", "text": "そこが私の部屋になる場所です。えっと"}, {"type": "subtitle", "time": 25629.35, "timestamp": "07:07:09", "text": "そう、あの四角いやつ"}, {"type": "subtitle", "time": 25632.628, "timestamp": "07:07:12", "text": "あれだと思う。あ、あちら側です。うん。それで、"}, {"type": "subtitle", "time": 25634.708, "timestamp": "07:07:14", "text": "これはすべて異なる"}, {"type": "subtitle", "time": 25635.708, "timestamp": "07:07:15", "text": "引き裂く"}, {"type": "subtitle", "time": 25638.788, "timestamp": "07:07:18", "text": "人々、だと思う。うん。以前は"}, {"type": "subtitle", "time": 25641.708, "timestamp": "07:07:21", "text": "心を開いてください。今では彼らは実際に"}, {"type": "subtitle", "time": 25645.67, "timestamp": "07:07:25", "text": "それを覆うようなことすべてを含めて。"}, {"type": "subtitle", "time": 25648.548, "timestamp": "07:07:28", "text": "これは、"}, {"type": "subtitle", "time": 25650.39, "timestamp": "07:07:30", "text": "家はこう見えるだろう。これは"}, {"type": "subtitle", "time": 25652.91, "timestamp": "07:07:32", "text": "文字通りワイヤーフレーム全体が"}, {"type": "subtitle", "time": 25656.788, "timestamp": "07:07:36", "text": "物、つまり車が置かれるガレージ。今"}, {"type": "subtitle", "time": 25659.59, "timestamp": "07:07:39", "text": "彼らは駐車場のような建物を建てている"}, {"type": "subtitle", "time": 25662.07, "timestamp": "07:07:42", "text": "エリア。だから両開きドアになっているんです。"}, {"type": "subtitle", "time": 25665.07, "timestamp": "07:07:45", "text": "彼らは古い片開きの門を破壊した"}, {"type": "subtitle", "time": 25668.15, "timestamp": "07:07:48", "text": "あれ。うん。今、彼らはこのようなものを置いています"}, {"type": "subtitle", "time": 25670.39, "timestamp": "07:07:50", "text": "新しいタイプのスライドドアか何か"}, {"type": "subtitle", "time": 25671.948, "timestamp": "07:07:51", "text": "彼らは呼ぶ"}, {"type": "subtitle", "time": 25676.708, "timestamp": "07:07:56", "text": "それ。うん、それは大変だね。"}]
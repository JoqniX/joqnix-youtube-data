[{"type": "subtitle", "time": 20663.83, "timestamp": "05:44:23", "text": "H. わかりました。それで、それで、それで、私たちがすることは"}, {"type": "subtitle", "time": 20666.67, "timestamp": "05:44:26", "text": "少し"}, {"type": "subtitle", "time": 20674.15, "timestamp": "05:44:34", "text": "実際、私たちは彼女をレベルアップさせました、私はただ"}, {"type": "subtitle", "time": 20679.1, "timestamp": "05:44:39", "text": "才能に焦点を当てるということですよね？"}, {"type": "subtitle", "time": 20680.67, "timestamp": "05:44:40", "text": "[音楽]"}, {"type": "subtitle", "time": 20692.27, "timestamp": "05:44:52", "text": "待って、これは"}]
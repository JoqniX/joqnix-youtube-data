[{"type": "subtitle", "time": 10513.75, "timestamp": "02:55:13", "text": "[音楽]"}, {"type": "subtitle", "time": 10520.23, "timestamp": "02:55:20", "text": "チップ。えっと、これらのクリップのタイトルは"}, {"type": "subtitle", "time": 10523.67, "timestamp": "02:55:23", "text": "キャプションに付けるタイトルがそれになります。わかった。しかし"}, {"type": "subtitle", "time": 10525.83, "timestamp": "02:55:25", "text": "みんながキャプションをつけている。それがタイトルです"}]
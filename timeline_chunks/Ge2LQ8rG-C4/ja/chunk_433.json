[{"type": "subtitle", "time": 25980.15, "timestamp": "07:13:00", "text": "試験勉強など。私"}, {"type": "subtitle", "time": 25994.39, "timestamp": "07:13:14", "text": "それ。私は戦いたくない"}, {"type": "subtitle", "time": 25997.35, "timestamp": "07:13:17", "text": "しかし、やりすぎだった。兄弟姉妹なら"}, {"type": "subtitle", "time": 26000.548, "timestamp": "07:13:20", "text": "兄弟姉妹がいるなら、"}, {"type": "subtitle", "time": 26003.51, "timestamp": "07:13:23", "text": "いつも戦っている。私は戦いたくない。"}, {"type": "subtitle", "time": 26007.628, "timestamp": "07:13:27", "text": "私は自分のものを守り、大切にしたい"}, {"type": "subtitle", "time": 26011.708, "timestamp": "07:13:31", "text": "もし兄弟がいたら"}, {"type": "subtitle", "time": 26014.708, "timestamp": "07:13:34", "text": "1つ。ええ、でも実際はそうじゃない"}, {"type": "subtitle", "time": 26021.23, "timestamp": "07:13:41", "text": "なぜ？必ず"}, {"type": "subtitle", "time": 26028.468, "timestamp": "07:13:48", "text": "平均？兄弟姉妹がいるってそんなに悪いことなの？そして"}, {"type": "subtitle", "time": 26030.19, "timestamp": "07:13:50", "text": "悪くない"}, {"type": "subtitle", "time": 26034.868, "timestamp": "07:13:54", "text": "難しいとか難しくないけど、いや、そうじゃない"}, {"type": "subtitle", "time": 26037.23, "timestamp": "07:13:57", "text": "私が言ったように"}]
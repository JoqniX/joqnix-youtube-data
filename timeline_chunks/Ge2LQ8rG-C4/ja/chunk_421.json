[{"type": "subtitle", "time": 25260.23, "timestamp": "07:01:00", "text": "その日は配信しない日です。"}, {"type": "subtitle", "time": 25263.27, "timestamp": "07:01:03", "text": "丸一日かかると思うよ。"}, {"type": "subtitle", "time": 25266.39, "timestamp": "07:01:06", "text": "だから都市の人々は変わる必要がある"}, {"type": "subtitle", "time": 25269.59, "timestamp": "07:01:09", "text": "配線関連とすべてのチェック"}, {"type": "subtitle", "time": 25272.708, "timestamp": "07:01:12", "text": "私の1階の配線"}, {"type": "subtitle", "time": 25275.59, "timestamp": "07:01:15", "text": "私が滞在しているのは1階です。それから"}, {"type": "subtitle", "time": 25278.628, "timestamp": "07:01:18", "text": "一番上のものを置く必要があります"}, {"type": "subtitle", "time": 25281.51, "timestamp": "07:01:21", "text": "分けてください。彼らはそれを変える必要がある"}, {"type": "subtitle", "time": 25283.468, "timestamp": "07:01:23", "text": "三相または"}, {"type": "subtitle", "time": 25286.628, "timestamp": "07:01:26", "text": "何か。うん。きっと"}, {"type": "subtitle", "time": 25289.03, "timestamp": "07:01:29", "text": "年長者が来るだろう、私の父は"}, {"type": "subtitle", "time": 25292.83, "timestamp": "07:01:32", "text": "「なぜPCをずっとつけっぱなしにしていたの？」"}, {"type": "subtitle", "time": 25296.27, "timestamp": "07:01:36", "text": "日？だって私は"}, {"type": "subtitle", "time": 25299.19, "timestamp": "07:01:39", "text": "うん。えっと、そういえば、えっと、私は"}, {"type": "subtitle", "time": 25302.99, "timestamp": "07:01:42", "text": "昨日のVをダウンロードしました。ええと、ちょうど"}, {"type": "subtitle", "time": 25305.628, "timestamp": "07:01:45", "text": "思い出させた。"}, {"type": "subtitle", "time": 25307.788, "timestamp": "07:01:47", "text": "待って、どこに"}, {"type": "subtitle", "time": 25311.15, "timestamp": "07:01:51", "text": "これは私のものですか？右。コピー"}, {"type": "subtitle", "time": 25313.75, "timestamp": "07:01:53", "text": "リンク。ええと、6時間の方ですね。する必要がある"}]
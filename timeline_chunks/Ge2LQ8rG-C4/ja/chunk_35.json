[{"type": "subtitle", "time": 2109.87, "timestamp": "00:35:09", "text": "ジョーク。ネオン・フィリピーノ"}, {"type": "subtitle", "time": 2120.87, "timestamp": "00:35:20", "text": "わかった。だからこれらのショットのために私たちは"}, {"type": "subtitle", "time": 2137.51, "timestamp": "00:35:37", "text": "何か。もう一つのゲームは何でしたか？"}, {"type": "subtitle", "time": 2139.109, "timestamp": "00:35:39", "text": "あれは何でしょう？何だって？何が"}, {"type": "subtitle", "time": 2144.589, "timestamp": "00:35:44", "text": "あのコヤントみたいなやつ？"}, {"type": "subtitle", "time": 2147.87, "timestamp": "00:35:47", "text": "ポーズ。コサント"}, {"type": "subtitle", "time": 2155.71, "timestamp": "00:35:55", "text": "名前。コーエン。ええ、とコイは言った。うん、それ"}]
[{"type": "subtitle", "time": 6915.95, "timestamp": "01:55:15", "text": "クリップと最近の他のものを再利用"}, {"type": "subtitle", "time": 6931.51, "timestamp": "01:55:31", "text": "ショートパンツ。あと、クレジットが必要なんです。"}, {"type": "subtitle", "time": 6933.83, "timestamp": "01:55:33", "text": "あなたにも。いいえ、それはMinecraftです"}, {"type": "subtitle", "time": 6936.95, "timestamp": "01:55:36", "text": "クリップですよね？それも修正しておかないといけないな。"}, {"type": "subtitle", "time": 6940.83, "timestamp": "01:55:40", "text": "問題は、タグ付けしたくないということです"}, {"type": "subtitle", "time": 6943.669, "timestamp": "01:55:43", "text": "人々。今となっては、とても迷惑だろう。それで、"}, {"type": "subtitle", "time": 6945.39, "timestamp": "01:55:45", "text": "私はただ"}, {"type": "subtitle", "time": 6948.55, "timestamp": "01:55:48", "text": "リンクして人々が確認できるように"}]
[{"type": "subtitle", "time": 13144.429, "timestamp": "03:39:04", "text": "たくさん見る これはクールだ。ダブモード。"}, {"type": "subtitle", "time": 13149.07, "timestamp": "03:39:09", "text": "ええ、これは技術的に説明できます"}, {"type": "subtitle", "time": 13151.59, "timestamp": "03:39:11", "text": "大丈夫。問題は、今は私がしたくないということです"}, {"type": "subtitle", "time": 13154.15, "timestamp": "03:39:14", "text": "私が得意な料理を披露します"}, {"type": "subtitle", "time": 13156.95, "timestamp": "03:39:16", "text": "コンピューターとかそういう類。私は知らない 私は知っている"}, {"type": "subtitle", "time": 13161.71, "timestamp": "03:39:21", "text": "みんなが私に言うんだけど、ドクター、あなたは"}, {"type": "subtitle", "time": 13163.99, "timestamp": "03:39:23", "text": "チュートリアルがあるので、いつも"}, {"type": "subtitle", "time": 13167.51, "timestamp": "03:39:27", "text": "あなたを悩ませる。ドアを開けると"}, {"type": "subtitle", "time": 13171.67, "timestamp": "03:39:31", "text": "そのため人々は、"}, {"type": "subtitle", "time": 13173.75, "timestamp": "03:39:33", "text": "私のコンテンツを楽しむのではなく、"}, {"type": "subtitle", "time": 13175.75, "timestamp": "03:39:35", "text": "どうすればこれをできるのか、どうすればあれができるのか、といった具合です。"}, {"type": "subtitle", "time": 13178.87, "timestamp": "03:39:38", "text": "そして私は、彼らがそうするようにするだろう"}, {"type": "subtitle", "time": 13181.269, "timestamp": "03:39:41", "text": "それは望んでいません、私はあなたに楽しんでほしいのです"}, {"type": "subtitle", "time": 13184.71, "timestamp": "03:39:44", "text": "必要であれば、"}, {"type": "subtitle", "time": 13187.15, "timestamp": "03:39:47", "text": "助けて、私はあなたを助けます"}, {"type": "subtitle", "time": 13190.99, "timestamp": "03:39:50", "text": "人々が私の"}, {"type": "subtitle", "time": 13192.67, "timestamp": "03:39:52", "text": "もの"}, {"type": "subtitle", "time": 13196.55, "timestamp": "03:39:56", "text": "すぐには、私は、もし私が行ったら心配です"}]
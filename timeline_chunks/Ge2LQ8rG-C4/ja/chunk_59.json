[{"type": "subtitle", "time": 3540.829, "timestamp": "00:59:00", "text": "[ __ ]する"}, {"type": "subtitle", "time": 3543.829, "timestamp": "00:59:03", "text": "主張する。言わざるを得ない。言わなければならない"}, {"type": "subtitle", "time": 3549.87, "timestamp": "00:59:09", "text": "それ。うん。なんてこった。あなたにはできない"}, {"type": "subtitle", "time": 3554.789, "timestamp": "00:59:14", "text": "ただそれだけならトップにはなれない"}, {"type": "subtitle", "time": 3563.19, "timestamp": "00:59:23", "text": "あなたがセックスしたいと思っていることに不安を感じています"}, {"type": "subtitle", "time": 3564.589, "timestamp": "00:59:24", "text": "ケツ。あなたは"}, {"type": "subtitle", "time": 3567.99, "timestamp": "00:59:27", "text": "支配的になる。あなたはそうしなければならない あなたはそうしなければならない"}, {"type": "subtitle", "time": 3569.829, "timestamp": "00:59:29", "text": "厳しい。言いたいことを言わなきゃいけないし"}, {"type": "subtitle", "time": 3572.789, "timestamp": "00:59:32", "text": "欲しいものは手に入れなければならない。うん。"}, {"type": "subtitle", "time": 3576.549, "timestamp": "00:59:36", "text": "うん。言ってみて。言ってみて。ジョー。"}, {"type": "subtitle", "time": 3581.27, "timestamp": "00:59:41", "text": "こんにちは。もちろん賛成です。"}, {"type": "subtitle", "time": 3589.99, "timestamp": "00:59:49", "text": "[音楽]"}, {"type": "subtitle", "time": 3592.309, "timestamp": "00:59:52", "text": "言いたいことを言ってください。"}]
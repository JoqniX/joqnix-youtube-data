[{"type": "subtitle", "time": 18781.59, "timestamp": "05:13:01", "text": "ええ、ええ、リフレッシュしました。えっと"}, {"type": "subtitle", "time": 18784.868, "timestamp": "05:13:04", "text": "さっぱりする。朝食を食べた"}, {"type": "subtitle", "time": 18799.67, "timestamp": "05:13:19", "text": "最近すごく元気が出ている。知ってるでしょ"}, {"type": "subtitle", "time": 18805.31, "timestamp": "05:13:25", "text": "もう何時間も同じようなゲームを続けている。"}, {"type": "subtitle", "time": 18807.23, "timestamp": "05:13:27", "text": "おお。うん。"}, {"type": "subtitle", "time": 18814.35, "timestamp": "05:13:34", "text": "さよなら。クレイジー、"}, {"type": "subtitle", "time": 18817.55, "timestamp": "05:13:37", "text": "はぁ？それは確かに"}, {"type": "subtitle", "time": 18834.708, "timestamp": "05:13:54", "text": "[音楽]"}, {"type": "subtitle", "time": 18837.47, "timestamp": "05:13:57", "text": "ちょっと待って、翻訳ツールを起動するから。"}]
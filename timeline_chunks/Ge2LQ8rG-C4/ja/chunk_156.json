[{"type": "subtitle", "time": 9368.19, "timestamp": "02:36:08", "text": "[音楽]"}, {"type": "subtitle", "time": 9371.71, "timestamp": "02:36:11", "text": "ストリーミング配信。待って、私はただ"}, {"type": "subtitle", "time": 9374.389, "timestamp": "02:36:14", "text": "ストリーミング配信？待って、これは星の共鳴なの？"}, {"type": "subtitle", "time": 9376.99, "timestamp": "02:36:16", "text": "ああ、彼は「ああ、なんてことだ」を演奏している。"}, {"type": "subtitle", "time": 9380.07, "timestamp": "02:36:20", "text": "何？私は招待すらされなかった。私は"}, {"type": "subtitle", "time": 9382.67, "timestamp": "02:36:22", "text": "ビリー・ブリーと私は"}, {"type": "subtitle", "time": 9385.95, "timestamp": "02:36:25", "text": "ロニンズに招待されました"}, {"type": "subtitle", "time": 9391.349, "timestamp": "02:36:31", "text": "VA。中国人になるにはどうすればいいですか？"}, {"type": "subtitle", "time": 9398.389, "timestamp": "02:36:38", "text": "キュウコ？遊びたい。これは私の"}, {"type": "subtitle", "time": 9401.23, "timestamp": "02:36:41", "text": "お気に入りのRPG MMO"}, {"type": "subtitle", "time": 9405.349, "timestamp": "02:36:45", "text": "RPGブループロトコル。"}, {"type": "subtitle", "time": 9413.19, "timestamp": "02:36:53", "text": "日本語版をプレイするとき、私は本当に"}]
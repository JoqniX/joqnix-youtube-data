[{"type": "subtitle", "time": 17.07, "timestamp": "00:00:17", "text": "ああ、ついに私は"}, {"type": "subtitle", "time": 19.23, "timestamp": "00:00:19", "text": "ライブ。ああ、"}, {"type": "subtitle", "time": 21.87, "timestamp": "00:00:21", "text": "神。ああ、"}, {"type": "subtitle", "time": 29.109, "timestamp": "00:00:29", "text": "男。皆さん、ようこそ。"}, {"type": "subtitle", "time": 30.63, "timestamp": "00:00:30", "text": "最後に、いくつかの問題がありました"}, {"type": "subtitle", "time": 36.549, "timestamp": "00:00:36", "text": "残念だが、我々は解決済みの権利を得た"}, {"type": "subtitle", "time": 38.95, "timestamp": "00:00:38", "text": "今。まさに今。本当に申し訳ありません"}, {"type": "subtitle", "time": 42.549, "timestamp": "00:00:42", "text": "こんなに時間がかかってしまった"}, {"type": "subtitle", "time": 45.11, "timestamp": "00:00:45", "text": "えっと、ストリームに再接続する時間です"}, {"type": "subtitle", "time": 47.67, "timestamp": "00:00:47", "text": "そして配信を再開する。私はその声を知っている"}, {"type": "subtitle", "time": 48.75, "timestamp": "00:00:48", "text": "遊んでいて"}]
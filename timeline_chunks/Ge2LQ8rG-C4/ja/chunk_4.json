[{"type": "subtitle", "time": 241.27, "timestamp": "00:04:01", "text": "私は睡眠モードに切り替えている"}, {"type": "subtitle", "time": 244.03, "timestamp": "00:04:04", "text": "またはボビーのシーン"}, {"type": "subtitle", "time": 247.03, "timestamp": "00:04:07", "text": "あるいは、私がそれを次のレベルに引き上げることができるかどうか。"}, {"type": "subtitle", "time": 251.35, "timestamp": "00:04:11", "text": "もし私が望むなら、私の"}, {"type": "subtitle", "time": 252.75, "timestamp": "00:04:12", "text": "マイク"}, {"type": "subtitle", "time": 255.75, "timestamp": "00:04:15", "text": "あれ。マイクのソースがミュートされている場合、または"}, {"type": "subtitle", "time": 258.87, "timestamp": "00:04:18", "text": "私の物理的なマイクはミュートされていて、"}, {"type": "subtitle", "time": 261.189, "timestamp": "00:04:21", "text": "私が話しているのは、"}, {"type": "subtitle", "time": 263.43, "timestamp": "00:04:23", "text": "10分くらいならできるよ"}, {"type": "subtitle", "time": 266.629, "timestamp": "00:04:26", "text": "スイッチを入れて、あのテキストのやつをオンにする"}, {"type": "subtitle", "time": 269.749, "timestamp": "00:04:29", "text": "まるで写真のようなもの"}, {"type": "subtitle", "time": 272.749, "timestamp": "00:04:32", "text": "または何らかの画像"}, {"type": "subtitle", "time": 275.43, "timestamp": "00:04:35", "text": "画像のようなものが"}, {"type": "subtitle", "time": 279.51, "timestamp": "00:04:39", "text": "ポップアップして、そう言うと、これは"}, {"type": "subtitle", "time": 283.27, "timestamp": "00:04:43", "text": "VOD犬は現在存在しません"}, {"type": "subtitle", "time": 285.67, "timestamp": "00:04:45", "text": "フレームとか、そんな感じのもの。我々は出来た"}, {"type": "subtitle", "time": 287.23, "timestamp": "00:04:47", "text": "次のような"}, {"type": "subtitle", "time": 289.15, "timestamp": "00:04:49", "text": "それ。"}]
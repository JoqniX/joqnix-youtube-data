[{"type": "subtitle", "time": 19564.55, "timestamp": "05:26:04", "text": "材料を粉砕するのに丸一日かかる。"}, {"type": "subtitle", "time": 19569.11, "timestamp": "05:26:09", "text": "それで、240右の波形テーブルこの240は"}, {"type": "subtitle", "time": 19571.628, "timestamp": "05:26:11", "text": "世俗的な苦労の一種に等しい"}, {"type": "subtitle", "time": 19580.55, "timestamp": "05:26:20", "text": "例えば、はい、もし私がそうしたいなら、ええ、"}, {"type": "subtitle", "time": 19583.75, "timestamp": "05:26:23", "text": "そのうち6つは、240時間すべてを費やさなければならなかった。"}, {"type": "subtitle", "time": 19586.39, "timestamp": "05:26:26", "text": "昨日は持っていなかったので"}, {"type": "subtitle", "time": 19588.948, "timestamp": "05:26:28", "text": "十分な時間内にはできなかった"}, {"type": "subtitle", "time": 19591.948, "timestamp": "05:26:31", "text": "昨日のあれは"}, {"type": "subtitle", "time": 19596.39, "timestamp": "05:26:36", "text": "1つ右、そして武器についても同様です。"}, {"type": "subtitle", "time": 19599.83, "timestamp": "05:26:39", "text": "同じです、この物も"}, {"type": "subtitle", "time": 19606.35, "timestamp": "05:26:46", "text": "ある意味、それはたくさんの日"}, {"type": "subtitle", "time": 19609.11, "timestamp": "05:26:49", "text": "えっと、全部持って行けるような感じ"}, {"type": "subtitle", "time": 19611.99, "timestamp": "05:26:51", "text": "必要なシステムの種類に応じて、時間を調整してください。うん"}, {"type": "subtitle", "time": 19615.55, "timestamp": "05:26:55", "text": "それは良いことだけど"}, {"type": "subtitle", "time": 19618.99, "timestamp": "05:26:58", "text": "うん、いいよ"}]
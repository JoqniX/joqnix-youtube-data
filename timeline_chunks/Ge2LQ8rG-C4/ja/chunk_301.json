[{"type": "subtitle", "time": 18066.73, "timestamp": "05:01:06", "text": "寝る？私は自分がどれだけ悪いか気づいています"}, {"type": "subtitle", "time": 18074.27, "timestamp": "05:01:14", "text": "歌う。自分の歌がどれほど下手か、よく分かった。"}, {"type": "subtitle", "time": 18077.19, "timestamp": "05:01:17", "text": "ああ、面白いことに、私は一度も聞いたことがない"}, {"type": "subtitle", "time": 18079.07, "timestamp": "05:01:19", "text": "私自身の"}, {"type": "subtitle", "time": 18081.91, "timestamp": "05:01:21", "text": "歌を歌う。そしてそうすると、私は身震いして死んでしまう"}, {"type": "subtitle", "time": 18085.11, "timestamp": "05:01:25", "text": "内部。私はまるでキーキー鳴く鳥のようだ"}, {"type": "subtitle", "time": 18086.83, "timestamp": "05:01:26", "text": "試している"}, {"type": "subtitle", "time": 18095.788, "timestamp": "05:01:35", "text": "神。カニ"}, {"type": "subtitle", "time": 18106.43, "timestamp": "05:01:46", "text": "おい、マジで。非常識な"}]
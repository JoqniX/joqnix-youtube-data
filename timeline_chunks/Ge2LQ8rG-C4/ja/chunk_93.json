[{"type": "subtitle", "time": 5581.27, "timestamp": "01:33:01", "text": "それが私が思うことだと思う、それが私が"}, {"type": "subtitle", "time": 5620.83, "timestamp": "01:33:40", "text": "問題は、私が望んでいないということです"}, {"type": "subtitle", "time": 5625.629, "timestamp": "01:33:45", "text": "すべてを挙げると"}, {"type": "subtitle", "time": 5629.31, "timestamp": "01:33:49", "text": "彼ら。私はそうしたいけれど、そうしたくない"}, {"type": "subtitle", "time": 5632.43, "timestamp": "01:33:52", "text": "に。あなたは感じる"}, {"type": "subtitle", "time": 5636.149, "timestamp": "01:33:56", "text": "自分？したい気持ちもあるし、したくない気持ちもある。"}]
[{"type": "subtitle", "time": 3091.47, "timestamp": "00:51:31", "text": "1つ。たぶん私はこうする"}, {"type": "subtitle", "time": 3096.309, "timestamp": "00:51:36", "text": "これ。それで、ここにこれを置くことができます"}, {"type": "subtitle", "time": 3098.91, "timestamp": "00:51:38", "text": "ここにいるみんな"}, {"type": "subtitle", "time": 3109.67, "timestamp": "00:51:49", "text": "天才。私は天才だ。私はとても"}]
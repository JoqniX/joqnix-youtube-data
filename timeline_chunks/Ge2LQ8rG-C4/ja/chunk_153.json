[{"type": "subtitle", "time": 9200.87, "timestamp": "02:33:20", "text": "[音楽]"}, {"type": "subtitle", "time": 9203.429, "timestamp": "02:33:23", "text": "いや、爆破しないで。こんにちは。"}, {"type": "subtitle", "time": 9204.96, "timestamp": "02:33:24", "text": "こんにちは。 こんにちは。よし、もう一枚取り出そう"}, {"type": "subtitle", "time": 9207.84, "timestamp": "02:33:27", "text": "こんにちは。よし、もう一枚取り出そう PMG。ちょっと待って。俺たちみんな"}, {"type": "subtitle", "time": 9210.56, "timestamp": "02:33:30", "text": "PMG。ちょっと待って。俺たちみんな 何について話しているのですか？"}, {"type": "subtitle", "time": 9213.359, "timestamp": "02:33:33", "text": "何について話しているのですか？ うん。"}, {"type": "subtitle", "time": 9215.04, "timestamp": "02:33:35", "text": "うん。 すでに？ああ、しまった。私たちはいじめをしてきた"}, {"type": "subtitle", "time": 9217.28, "timestamp": "02:33:37", "text": "すでに？ああ、しまった。私たちはいじめをしてきた 彼。どういう意味ですか？"}, {"type": "subtitle", "time": 9218.72, "timestamp": "02:33:38", "text": "彼。どういう意味ですか？ すでに？"}, {"type": "subtitle", "time": 9221.12, "timestamp": "02:33:41", "text": "すでに？ 彼は"}, {"type": "subtitle", "time": 9227.429, "timestamp": "02:33:47", "text": "彼のプロフィール写真の前にファンタスト"}, {"type": "subtitle", "time": 9235.429, "timestamp": "02:33:55", "text": "いや。ああ、なんてことだ。"}, {"type": "subtitle", "time": 9236.79, "timestamp": "02:33:56", "text": "ジャック、本当に愛してるよ。私たちはいじめをしている"}, {"type": "subtitle", "time": 9238.309, "timestamp": "02:33:58", "text": "だって、うん、心配しないで。しないで"}]
[{"type": "subtitle", "time": 18733.54, "timestamp": "05:12:13", "text": "[音楽]"}, {"type": "subtitle", "time": 18749.46, "timestamp": "05:12:29", "text": "うん。こんにちは"}, {"type": "subtitle", "time": 18750.59, "timestamp": "05:12:30", "text": "[音楽]"}, {"type": "subtitle", "time": 18753.67, "timestamp": "05:12:33", "text": "みんな。おおお。こんにちは。こんにちは。良い"}, {"type": "subtitle", "time": 18757.628, "timestamp": "05:12:37", "text": "皆さん、おはようございます。皆さん、お元気ですか？"}, {"type": "subtitle", "time": 18760.67, "timestamp": "05:12:40", "text": "こんにちは。そうですね、"}, {"type": "subtitle", "time": 18763.868, "timestamp": "05:12:43", "text": "私は実際に寝ました"}, {"type": "subtitle", "time": 18766.39, "timestamp": "05:12:46", "text": "オフ。私たちはこれを始めるはずだった"}, {"type": "subtitle", "time": 18769.47, "timestamp": "05:12:49", "text": "列車が2時間早く出発する。"}, {"type": "subtitle", "time": 18773.51, "timestamp": "05:12:53", "text": "えっと、でも私は寝てしまいました。頑張れよ。"}, {"type": "subtitle", "time": 18775.51, "timestamp": "05:12:55", "text": "その後、私は本当に疲れていたと思います"}, {"type": "subtitle", "time": 18778.59, "timestamp": "05:12:58", "text": "昨日の配信。しかし"}]
[{"type": "subtitle", "time": 309.83, "timestamp": "00:05:09", "text": "それはおそらくうまくいくでしょう。おそらく。しかし"}, {"type": "subtitle", "time": 313.87, "timestamp": "00:05:13", "text": "わからない。私が考えたアイデアの一つは"}, {"type": "subtitle", "time": 316.909, "timestamp": "00:05:16", "text": "ちょうどよかった"}, {"type": "subtitle", "time": 320.07, "timestamp": "00:05:20", "text": "Twitchからコメントをもらったので"}, {"type": "subtitle", "time": 323.629, "timestamp": "00:05:23", "text": "気づかなかったと言って"}, {"type": "subtitle", "time": 325.87, "timestamp": "00:05:25", "text": "それ"}, {"type": "subtitle", "time": 329.67, "timestamp": "00:05:29", "text": "私が配信していないことについて。"}, {"type": "subtitle", "time": 332.87, "timestamp": "00:05:32", "text": "それは、V などです。"}, {"type": "subtitle", "time": 340.11, "timestamp": "00:05:40", "text": "[音楽]"}, {"type": "subtitle", "time": 348.15, "timestamp": "00:05:48", "text": "ああ、それもあるね。次に私が"}, {"type": "subtitle", "time": 350.749, "timestamp": "00:05:50", "text": "やりたかったことは、まだやっていないことです"}, {"type": "subtitle", "time": 353.99, "timestamp": "00:05:53", "text": "昨日はショートパンツを履いていたのは、"}, {"type": "subtitle", "time": 356.67, "timestamp": "00:05:56", "text": "ビリービリーうーん"}]
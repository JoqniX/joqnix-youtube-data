[{"type": "subtitle", "time": 25920.91, "timestamp": "07:12:00", "text": "自分。誰かが"}, {"type": "subtitle", "time": 25925.19, "timestamp": "07:12:05", "text": "自分？わからない。私は数学が苦手です。私は最悪だ"}, {"type": "subtitle", "time": 25927.03, "timestamp": "07:12:07", "text": "わかりません。私は多くのことが苦手です"}, {"type": "subtitle", "time": 25930.19, "timestamp": "07:12:10", "text": "もの。わからない。仕事が見つかるといいな。"}, {"type": "subtitle", "time": 25937.03, "timestamp": "07:12:17", "text": "おお。だから、私にはわからない。私はあなたが"}, {"type": "subtitle", "time": 25940.19, "timestamp": "07:12:20", "text": "雪かきができたらいいのに"}, {"type": "subtitle", "time": 25943.27, "timestamp": "07:12:23", "text": "ディオ。ほら、私はいつも夢見てるの"}, {"type": "subtitle", "time": 25945.91, "timestamp": "07:12:25", "text": "兄弟、兄弟、または"}, {"type": "subtitle", "time": 25948.948, "timestamp": "07:12:28", "text": "夜は抱きしめて一緒に寝られる人、"}, {"type": "subtitle", "time": 25952.23, "timestamp": "07:12:32", "text": "例えば、寝る前にお話をしてあげるとか"}, {"type": "subtitle", "time": 25955.67, "timestamp": "07:12:35", "text": "彼らを眠らせて、ヘアバンドをあげる"}, {"type": "subtitle", "time": 25957.91, "timestamp": "07:12:37", "text": "などなど。わからない。何が"}, {"type": "subtitle", "time": 25964.75, "timestamp": "07:12:44", "text": "知る。ゲームをプレイする"}, {"type": "subtitle", "time": 25969.43, "timestamp": "07:12:49", "text": "一緒に。一緒に散歩に出かけようよ。"}, {"type": "subtitle", "time": 25972.31, "timestamp": "07:12:52", "text": "屋外で遊ぶ、または屋内のアクティビティ"}, {"type": "subtitle", "time": 25973.868, "timestamp": "07:12:53", "text": "活動"}, {"type": "subtitle", "time": 25977.43, "timestamp": "07:12:57", "text": "一緒に他の兄弟姉妹を助ける"}]
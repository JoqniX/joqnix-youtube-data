[{"type": "subtitle", "time": 13920.229, "timestamp": "03:52:00", "text": "今から日本へ出発します。料金を請求して、"}, {"type": "subtitle", "time": 13923.59, "timestamp": "03:52:03", "text": "今のところ、私はそれほど叫んでいません"}, {"type": "subtitle", "time": 13926.469, "timestamp": "03:52:06", "text": "夜に叫んだ回数を超える"}, {"type": "subtitle", "time": 13929.59, "timestamp": "03:52:09", "text": "近所の人が電話して"}, {"type": "subtitle", "time": 13931.59, "timestamp": "03:52:11", "text": "両親に電話をかけて「あなたの息子です」と伝えました"}, {"type": "subtitle", "time": 13934.469, "timestamp": "03:52:14", "text": "わかった、まだそのレベルには達していない"}, {"type": "subtitle", "time": 13936.469, "timestamp": "03:52:16", "text": "そして、私がそこに行けないという事実"}, {"type": "subtitle", "time": 13938.55, "timestamp": "03:52:18", "text": "レベルが上がると叫ぶことすらできなくなる"}, {"type": "subtitle", "time": 13941.63, "timestamp": "03:52:21", "text": "日本、だって日本人だからね"}, {"type": "subtitle", "time": 13945.349, "timestamp": "03:52:25", "text": "えっと、彼らはみんな人が住んでいるのが好きです"}, {"type": "subtitle", "time": 13948.95, "timestamp": "03:52:28", "text": "狭いスペースが好きなので、部屋の騒音と"}, {"type": "subtitle", "time": 13951.349, "timestamp": "03:52:31", "text": "全ては苦痛だ。買わなければならない"}]
[{"type": "subtitle", "time": 8905.27, "timestamp": "02:28:25", "text": "女性。よし、これで正式に"}, {"type": "subtitle", "time": 8924.95, "timestamp": "02:28:44", "text": "こんにちは。これで5つが隣に並んで10個になった。"}, {"type": "subtitle", "time": 8929.79, "timestamp": "02:28:49", "text": "そして次の5人。次に5の隣で"}, {"type": "subtitle", "time": 8935.51, "timestamp": "02:28:55", "text": "ゴイ。というわけで、ここまでたどり着きました。では、1、2、3"}, {"type": "subtitle", "time": 8936.67, "timestamp": "02:28:56", "text": "4"}]
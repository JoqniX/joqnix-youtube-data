[{"type": "subtitle", "time": 12002.68, "timestamp": "03:20:02", "text": "D.D."}, {"type": "subtitle", "time": 12034.15, "timestamp": "03:20:34", "text": "タ。はい、私たちはNにいます。"}, {"type": "subtitle", "time": 12035.95, "timestamp": "03:20:35", "text": "ショットまたは"}, {"type": "subtitle", "time": 12039.03, "timestamp": "03:20:39", "text": "本物。え、何？わかった。私を見て"}, {"type": "subtitle", "time": 12040.95, "timestamp": "03:20:40", "text": "目を見て、あなたは"}, {"type": "subtitle", "time": 12042.91, "timestamp": "03:20:42", "text": "底。私は"}, {"type": "subtitle", "time": 12047.349, "timestamp": "03:20:47", "text": "底辺の声に耳を傾けていない。"}]
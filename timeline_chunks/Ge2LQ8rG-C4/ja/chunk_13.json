[{"type": "subtitle", "time": 782.79, "timestamp": "00:13:02", "text": "ケツにぶち込んでやる。"}, {"type": "subtitle", "time": 808.17, "timestamp": "00:13:28", "text": "ああ、"}, {"type": "subtitle", "time": 810.829, "timestamp": "00:13:30", "text": "[音楽]"}, {"type": "subtitle", "time": 814.31, "timestamp": "00:13:34", "text": "神。ユダヤ人の話、"}, {"type": "subtitle", "time": 815.509, "timestamp": "00:13:35", "text": "男。もっと"}, {"type": "subtitle", "time": 817.43, "timestamp": "00:13:37", "text": "トップになりたいなら、主張しろ。あなたは"}, {"type": "subtitle", "time": 819.75, "timestamp": "00:13:39", "text": "教えてください。私は議論するつもりだ。あなた"}, {"type": "subtitle", "time": 821.509, "timestamp": "00:13:41", "text": "言わざるを得ない。言わなければならない。"}, {"type": "subtitle", "time": 826.03, "timestamp": "00:13:46", "text": "うん。さよなら。なんてこった。君はできない"}, {"type": "subtitle", "time": 830.47, "timestamp": "00:13:50", "text": "ただそれだけならトップにはなれない"}, {"type": "subtitle", "time": 832.55, "timestamp": "00:13:52", "text": "不安な気持ちでセックスしたい"}, {"type": "subtitle", "time": 833.67, "timestamp": "00:13:53", "text": "尻で議論する。あなたはそうしなければならない"}, {"type": "subtitle", "time": 835.19, "timestamp": "00:13:55", "text": "支配的な。あなたはそうしなければならない あなたはそうしなければならない"}, {"type": "subtitle", "time": 837.03, "timestamp": "00:13:57", "text": "厳しい。言いたいことを言わなきゃいけないし"}, {"type": "subtitle", "time": 838.87, "timestamp": "00:13:58", "text": "欲しいものは手に入れなければならない。うん。言う"}]
[{"type": "subtitle", "time": 25801.15, "timestamp": "07:10:01", "text": "1990年。忘れてしまった。待って、それが前だってことはわかってる"}, {"type": "subtitle", "time": 25803.868, "timestamp": "07:10:03", "text": "2000年。ああ、それより前だってことはわかってるよ。"}, {"type": "subtitle", "time": 25808.35, "timestamp": "07:10:08", "text": "2000年。だってその頃には私は存在していないから。しかし"}, {"type": "subtitle", "time": 25812.07, "timestamp": "07:10:12", "text": "うん。ああ、そう、Mとかそういうのより前のやつね。"}, {"type": "subtitle", "time": 25816.03, "timestamp": "07:10:16", "text": "管理とかそういう類のことだろうね。"}, {"type": "subtitle", "time": 25824.788, "timestamp": "07:10:24", "text": "うん、そうなるよ。うん、そうなるはずだ。"}, {"type": "subtitle", "time": 25830.628, "timestamp": "07:10:30", "text": "だから、私の家族はそこに住んでいた"}, {"type": "subtitle", "time": 25833.51, "timestamp": "07:10:33", "text": "先ほどお見せした2階部分です。"}, {"type": "subtitle", "time": 25835.27, "timestamp": "07:10:35", "text": "そうじゃない。まるで完全に"}, {"type": "subtitle", "time": 25838.59, "timestamp": "07:10:38", "text": "違う。彼らは以前は上の階に住んでいた"}, {"type": "subtitle", "time": 25841.27, "timestamp": "07:10:41", "text": "そして、彼らはそれをリノベーションのために与えたのだと思います。"}, {"type": "subtitle", "time": 25843.59, "timestamp": "07:10:43", "text": "階下に置くもの。それから彼らは"}, {"type": "subtitle", "time": 25845.99, "timestamp": "07:10:45", "text": "変更した。階下は私たちのものになった。"}, {"type": "subtitle", "time": 25850.15, "timestamp": "07:10:50", "text": "それから私たちはそれをもっとたくさん"}, {"type": "subtitle", "time": 25854.91, "timestamp": "07:10:54", "text": "オフィスの賃貸など、企業向けのもの"}, {"type": "subtitle", "time": 25858.23, "timestamp": "07:10:58", "text": "あれ。そしてそれから、えっと、彼らは"}]
[{"type": "subtitle", "time": 17058.15, "timestamp": "04:44:18", "text": "著者 これは私が調べなければならないことです"}, {"type": "subtitle", "time": 17061.03, "timestamp": "04:44:21", "text": "の中へ。毎日、収益化が停止されています。"}, {"type": "subtitle", "time": 17075.91, "timestamp": "04:44:35", "text": "インストゥルメンタル。エイムボードを設置すればいいだけだよ。私"}, {"type": "subtitle", "time": 17082.39, "timestamp": "04:44:42", "text": "マラソン。アルファベータはいつ入手できますか？"}, {"type": "subtitle", "time": 17083.948, "timestamp": "04:44:43", "text": "アルファ"}, {"type": "subtitle", "time": 17087.67, "timestamp": "04:44:47", "text": "王？私は自分がアメリカにいるふりをしたい。"}]
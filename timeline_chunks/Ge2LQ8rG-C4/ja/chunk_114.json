[{"type": "subtitle", "time": 6841.03, "timestamp": "01:54:01", "text": "うん、ちょっと怪しい動画をいくつかアップロードしてるよ"}, {"type": "subtitle", "time": 6854.03, "timestamp": "01:54:14", "text": "何てことだ。うん。"}, {"type": "subtitle", "time": 6857.75, "timestamp": "01:54:17", "text": "さよなら。何か軽くたたくような音が聞こえた"}, {"type": "subtitle", "time": 6859.629, "timestamp": "01:54:19", "text": "それは"}, {"type": "subtitle", "time": 6864.109, "timestamp": "01:54:24", "text": "時間。 「おい、そこはダメだ」"}, {"type": "subtitle", "time": 6882.47, "timestamp": "01:54:42", "text": "笑いが止まらない。ああ、"}, {"type": "subtitle", "time": 6883.709, "timestamp": "01:54:43", "text": "神。私は"}, {"type": "subtitle", "time": 6886.51, "timestamp": "01:54:46", "text": "ごめん。"}]
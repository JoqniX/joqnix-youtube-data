[{"type": "subtitle", "time": 14101.55, "timestamp": "03:55:01", "text": "私のモデルを完全に理解し、"}, {"type": "subtitle", "time": 14104.75, "timestamp": "03:55:04", "text": "もの。私が気にしているのはそれだけです"}, {"type": "subtitle", "time": 14107.63, "timestamp": "03:55:07", "text": "について。収益があっても構いません"}, {"type": "subtitle", "time": 14111.389, "timestamp": "03:55:11", "text": "ストリームから得た情報を共有したり、"}, {"type": "subtitle", "time": 14113.83, "timestamp": "03:55:13", "text": "ビデオ制作を依頼することから何か"}, {"type": "subtitle", "time": 14116.189, "timestamp": "03:55:16", "text": "エディターか何か"}, {"type": "subtitle", "time": 14118.71, "timestamp": "03:55:18", "text": "未来。でも、私はそうではないと感じています"}, {"type": "subtitle", "time": 14127.95, "timestamp": "03:55:27", "text": "私はそのレベルに到達しなければならない"}, {"type": "subtitle", "time": 14130.27, "timestamp": "03:55:30", "text": "面白い。そこに行かなければならない"}, {"type": "subtitle", "time": 14131.469, "timestamp": "03:55:31", "text": "[音楽]"}, {"type": "subtitle", "time": 14136.55, "timestamp": "03:55:36", "text": "どうにか。だから月が来る前に"}, {"type": "subtitle", "time": 14139.389, "timestamp": "03:55:39", "text": "そしてより高いグレードを設定する"}, {"type": "subtitle", "time": 14141.55, "timestamp": "03:55:41", "text": "期待、私は必要とする"}, {"type": "subtitle", "time": 14146.07, "timestamp": "03:55:46", "text": "そのレベルに到達するために。"}, {"type": "subtitle", "time": 14149.269, "timestamp": "03:55:49", "text": "今からクリップをお見せします"}, {"type": "subtitle", "time": 14150.91, "timestamp": "03:55:50", "text": "ショーケース"}, {"type": "subtitle", "time": 14154.95, "timestamp": "03:55:54", "text": "それは私をある意味で紹介していると思う"}, {"type": "subtitle", "time": 14158.349, "timestamp": "03:55:58", "text": "配信中だし、すべて"}]
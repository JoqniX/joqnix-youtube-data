[{"type": "subtitle", "time": 25680.31, "timestamp": "07:08:00", "text": "そして、私たちの古い家族の門は"}, {"type": "subtitle", "time": 25682.708, "timestamp": "07:08:02", "text": "これも破壊されるだろう。今は"}, {"type": "subtitle", "time": 25685.11, "timestamp": "07:08:05", "text": "引き戸になる予定です。そうです"}, {"type": "subtitle", "time": 25688.548, "timestamp": "07:08:08", "text": "それは新しい家ですか？古い家が"}, {"type": "subtitle", "time": 25692.07, "timestamp": "07:08:12", "text": "最上階は全面改装済みです。それで"}, {"type": "subtitle", "time": 25697.99, "timestamp": "07:08:17", "text": "彼らは屋上の屋根も交換した。"}, {"type": "subtitle", "time": 25699.83, "timestamp": "07:08:19", "text": "ええ、彼らは屋根の部分を"}, {"type": "subtitle", "time": 25703.11, "timestamp": "07:08:23", "text": "良い。古い家を改修しました。ええ、"}, {"type": "subtitle", "time": 25705.11, "timestamp": "07:08:25", "text": "地面の部分は改修されなかった。"}, {"type": "subtitle", "time": 25707.51, "timestamp": "07:08:27", "text": "外側の部分だけが内側の部分です"}, {"type": "subtitle", "time": 25711.788, "timestamp": "07:08:31", "text": "相変わらずだ。ええ、これは"}, {"type": "subtitle", "time": 25715.468, "timestamp": "07:08:35", "text": "完全に完全に完全に完全に"}, {"type": "subtitle", "time": 25717.948, "timestamp": "07:08:37", "text": "改装済み。"}, {"type": "subtitle", "time": 25721.35, "timestamp": "07:08:41", "text": "ええ、実際に見たときはショックでした"}, {"type": "subtitle", "time": 25724.468, "timestamp": "07:08:44", "text": "これは正直な話です。私は文字通り"}, {"type": "subtitle", "time": 25726.468, "timestamp": "07:08:46", "text": "この写真を見たとき、衝撃を受けました。私は"}, {"type": "subtitle", "time": 25728.548, "timestamp": "07:08:48", "text": "「まさか。それは私たちの"}, {"type": "subtitle", "time": 25731.628, "timestamp": "07:08:51", "text": "家。」私はそれを父に言いました。私はこう思いました。"}]
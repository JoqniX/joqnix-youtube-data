[{"type": "subtitle", "time": 23827.19, "timestamp": "06:37:07", "text": "エクソル。わかった。よし、バッフルは"}, {"type": "subtitle", "time": 23851.43, "timestamp": "06:37:31", "text": "離れて。それが金の主な問題点だ"}, {"type": "subtitle", "time": 23864.75, "timestamp": "06:37:44", "text": "あなた？どこに"}, {"type": "subtitle", "time": 23868.628, "timestamp": "06:37:48", "text": "あなた？ところで、私の声、ちょっと遅れてる？"}, {"type": "subtitle", "time": 23870.35, "timestamp": "06:37:50", "text": "いいえ。"}, {"type": "subtitle", "time": 23875.03, "timestamp": "06:37:55", "text": "右。心配なのは、もし"}, {"type": "subtitle", "time": 23878.35, "timestamp": "06:37:58", "text": "これは100％の確率で、"}]
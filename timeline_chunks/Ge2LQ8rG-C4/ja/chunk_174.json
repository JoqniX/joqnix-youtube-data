[{"type": "subtitle", "time": 10441.95, "timestamp": "02:54:01", "text": "それは冗談だよ"}, {"type": "subtitle", "time": 10444.99, "timestamp": "02:54:04", "text": "クリップ。これが最後です"}, {"type": "subtitle", "time": 10447.71, "timestamp": "02:54:07", "text": "1つ。これから、"}, {"type": "subtitle", "time": 10451.19, "timestamp": "02:54:11", "text": "10. それからもっとやって、それから私は行く"}, {"type": "subtitle", "time": 10474.389, "timestamp": "02:54:34", "text": "おしっこ。私はリンゴとバナナを持っています。"}, {"type": "subtitle", "time": 10477.269, "timestamp": "02:54:37", "text": "バナナ2本。リンゴを食べなきゃいけないのは"}, {"type": "subtitle", "time": 10478.51, "timestamp": "02:54:38", "text": "私は"}, {"type": "subtitle", "time": 10482.34, "timestamp": "02:54:42", "text": "お腹がすいた。他に歯磨きに使うものは何ですか？"}, {"type": "subtitle", "time": 10493.99, "timestamp": "02:54:53", "text": "私たちがすべきだった事実"}, {"type": "subtitle", "time": 10496.75, "timestamp": "02:54:56", "text": "これは夕方ですが、夕方には"}, {"type": "subtitle", "time": 10498.349, "timestamp": "02:54:58", "text": "だった"}]
[{"type": "subtitle", "time": 20173.51, "timestamp": "05:36:13", "text": "あなた。待って、ああ、わかったって書いてある。五。わかった。"}, {"type": "subtitle", "time": 20184.99, "timestamp": "05:36:24", "text": "私にください"}, {"type": "subtitle", "time": 20187.99, "timestamp": "05:36:27", "text": "何か。あ、紫色のやつが1つあったよ。おお、"}, {"type": "subtitle", "time": 20189.948, "timestamp": "05:36:29", "text": "いいね、いいね、いいね、いいね、"}, {"type": "subtitle", "time": 20193.51, "timestamp": "05:36:33", "text": "ニース。しかし残念ながら、私には十分な"}, {"type": "subtitle", "time": 20199.19, "timestamp": "05:36:39", "text": "もの。私はそれさえ持っていない"}, {"type": "subtitle", "time": 20218.31, "timestamp": "05:36:58", "text": "そして、私は再利用すべきではないと思います"}]
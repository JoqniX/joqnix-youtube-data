[{"type": "subtitle", "time": 25747.19, "timestamp": "07:09:07", "text": "えっと、あれを家と呼ぶんですか？"}, {"type": "subtitle", "time": 25750.35, "timestamp": "07:09:10", "text": "あれは家ですよね？"}, {"type": "subtitle", "time": 25754.31, "timestamp": "07:09:14", "text": "うん。 1階、地上階。それは"}, {"type": "subtitle", "time": 25756.75, "timestamp": "07:09:16", "text": "家がどんな感じになるか、"}, {"type": "subtitle", "time": 25759.35, "timestamp": "07:09:19", "text": "右？ああ、あのアパートですね。私はしません"}, {"type": "subtitle", "time": 25762.468, "timestamp": "07:09:22", "text": "知る。最近のことではない。いや、いや、いや、いや。"}, {"type": "subtitle", "time": 25763.91, "timestamp": "07:09:23", "text": "もちろん違います。"}, {"type": "subtitle", "time": 25766.07, "timestamp": "07:09:26", "text": "何年経っただろうか？この"}, {"type": "subtitle", "time": 25767.708, "timestamp": "07:09:27", "text": "場所が"}, {"type": "subtitle", "time": 25770.868, "timestamp": "07:09:30", "text": "された？私がまだ小さな赤ちゃんだった頃。"}, {"type": "subtitle", "time": 25773.07, "timestamp": "07:09:33", "text": "以前は私は"}, {"type": "subtitle", "time": 25775.99, "timestamp": "07:09:35", "text": "生まれる。ええ、私が生まれるずっと前から"}, {"type": "subtitle", "time": 25780.51, "timestamp": "07:09:40", "text": "生まれる。母と"}, {"type": "subtitle", "time": 25782.99, "timestamp": "07:09:42", "text": "お父さんは"}, {"type": "subtitle", "time": 25785.868, "timestamp": "07:09:45", "text": "結婚する前、または"}, {"type": "subtitle", "time": 25789.43, "timestamp": "07:09:49", "text": "既婚。つまり、何年くらいかかるってこと？"}, {"type": "subtitle", "time": 25793.75, "timestamp": "07:09:53", "text": "わからない。それは19年頃のことだ"}, {"type": "subtitle", "time": 25796.83, "timestamp": "07:09:56", "text": "1980年。いいえ、"}]
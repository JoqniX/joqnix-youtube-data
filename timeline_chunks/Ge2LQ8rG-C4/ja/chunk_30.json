[{"type": "subtitle", "time": 1805.549, "timestamp": "00:30:05", "text": "日本語。すべては"}, {"type": "subtitle", "time": 1839.95, "timestamp": "00:30:39", "text": "前。"}, {"type": "subtitle", "time": 1843.51, "timestamp": "00:30:43", "text": "だから、日本にいるときは、"}, {"type": "subtitle", "time": 1847.59, "timestamp": "00:30:47", "text": "そこでは英語を使う機会が少なくなるだろう。"}, {"type": "subtitle", "time": 1849.35, "timestamp": "00:30:49", "text": "右？私が使うことになる"}, {"type": "subtitle", "time": 1856.909, "timestamp": "00:30:56", "text": "詳細は"}, {"type": "subtitle", "time": 1859.95, "timestamp": "00:30:59", "text": "インド。私は自分の母国語が下手です"}]
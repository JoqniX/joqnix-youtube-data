[{"type": "subtitle", "time": 24784.43, "timestamp": "06:53:04", "text": "森。それで、私が今捕まえたもの"}, {"type": "subtitle", "time": 24788.15, "timestamp": "06:53:08", "text": "彼はまさにあそこにいた。となることによって"}, {"type": "subtitle", "time": 24791.27, "timestamp": "06:53:11", "text": "それは薄暗い森へと進んだことを意味する"}, {"type": "subtitle", "time": 24803.708, "timestamp": "06:53:23", "text": "ああ、大丈夫だよ。ああ、次があるさ"}, {"type": "subtitle", "time": 24807.75, "timestamp": "06:53:27", "text": "もの。私たちはこれを成し遂げた。マーカスは私が"}, {"type": "subtitle", "time": 24809.31, "timestamp": "06:53:29", "text": "見つかりません"}, {"type": "subtitle", "time": 24811.99, "timestamp": "06:53:31", "text": "彼。なぜ見つけられなかったのかわかりません"}, {"type": "subtitle", "time": 24819.99, "timestamp": "06:53:39", "text": "えっと、終わったらここに戻ってきてください"}, {"type": "subtitle", "time": 24821.54, "timestamp": "06:53:41", "text": "森はもはや"}, {"type": "subtitle", "time": 24824.43, "timestamp": "06:53:44", "text": "[音楽]"}, {"type": "subtitle", "time": 24827.948, "timestamp": "06:53:47", "text": "薄暗い。でも、ああ、決して"}, {"type": "subtitle", "time": 24836.99, "timestamp": "06:53:56", "text": "これ。 407 3237。"}, {"type": "subtitle", "time": 24839.67, "timestamp": "06:53:59", "text": "待って、この選手を探しに行く"}]
[{"type": "subtitle", "time": 10994.71, "timestamp": "03:03:14", "text": "いいえ、顔を赤らめないでください。こんにちは。"}, {"type": "subtitle", "time": 10996.24, "timestamp": "03:03:16", "text": "こんにちは。 こんにちは。よし、もう一枚取り出そう"}, {"type": "subtitle", "time": 10999.12, "timestamp": "03:03:19", "text": "こんにちは。よし、もう一枚取り出そう PMG。わかったよ、ベイビー。俺たちみんな"}, {"type": "subtitle", "time": 11001.84, "timestamp": "03:03:21", "text": "PMG。わかったよ、ベイビー。俺たちみんな 何について話しているのですか？"}, {"type": "subtitle", "time": 11004.64, "timestamp": "03:03:24", "text": "何について話しているのですか？ うん。"}, {"type": "subtitle", "time": 11006.319, "timestamp": "03:03:26", "text": "うん。 すでに？ああ、しまった。私たちはいじめをしてきた"}, {"type": "subtitle", "time": 11008.64, "timestamp": "03:03:28", "text": "すでに？ああ、しまった。私たちはいじめをしてきた 彼。どういう意味ですか？"}, {"type": "subtitle", "time": 11010.0, "timestamp": "03:03:30", "text": "彼。どういう意味ですか？ すでに？"}, {"type": "subtitle", "time": 11012.399, "timestamp": "03:03:32", "text": "すでに？ 彼は幻想だ。"}, {"type": "subtitle", "time": 11018.87, "timestamp": "03:03:38", "text": "彼のプロフィール写真の前に"}, {"type": "subtitle", "time": 11027.51, "timestamp": "03:03:47", "text": "いや。ああ、なんてことだ。まだ信じられない"}]
[{"type": "subtitle", "time": 23462.39, "timestamp": "06:31:02", "text": "紫。ああ、雷鳴がすごかった。これ"}, {"type": "subtitle", "time": 23463.548, "timestamp": "06:31:03", "text": "鳴らす"}, {"type": "subtitle", "time": 23466.43, "timestamp": "06:31:06", "text": "男、彼はとても"}, {"type": "subtitle", "time": 23468.35, "timestamp": "06:31:08", "text": "いいね。"}, {"type": "subtitle", "time": 23472.43, "timestamp": "06:31:12", "text": "くそ。多くの努力を見せてください。この男は"}, {"type": "subtitle", "time": 23476.948, "timestamp": "06:31:16", "text": "緑。この男は珍しい。ああ、私は"}, {"type": "subtitle", "time": 23483.708, "timestamp": "06:31:23", "text": "4つ。アビー、ちょっと食べ物を取りに行ってくるね。"}, {"type": "subtitle", "time": 23486.75, "timestamp": "06:31:26", "text": "こんにちは。はい。そしてまた"}, {"type": "subtitle", "time": 23493.788, "timestamp": "06:31:33", "text": "休む。"}, {"type": "subtitle", "time": 23497.31, "timestamp": "06:31:37", "text": "うん。ピーピーピー。"}, {"type": "subtitle", "time": 23518.59, "timestamp": "06:31:58", "text": "また？えっと、"}]
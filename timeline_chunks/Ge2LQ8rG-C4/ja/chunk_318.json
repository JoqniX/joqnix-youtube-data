[{"type": "subtitle", "time": 19082.19, "timestamp": "05:18:02", "text": "朝。お元気でお過ごしでしょうか。"}, {"type": "subtitle", "time": 19084.35, "timestamp": "05:18:04", "text": "いいえ。"}, {"type": "subtitle", "time": 19099.39, "timestamp": "05:18:19", "text": "今、"}, {"type": "subtitle", "time": 19103.99, "timestamp": "05:18:23", "text": "ゲームをとても気に入っている場合、"}, {"type": "subtitle", "time": 19106.15, "timestamp": "05:18:26", "text": "何が起こったかというと"}, {"type": "subtitle", "time": 19108.59, "timestamp": "05:18:28", "text": "枯れていく"}, {"type": "subtitle", "time": 19112.15, "timestamp": "05:18:32", "text": "波は、私が持っていたように予想していました"}, {"type": "subtitle", "time": 19113.708, "timestamp": "05:18:33", "text": "誇大宣伝と"}, {"type": "subtitle", "time": 19116.628, "timestamp": "05:18:36", "text": "すべてまだ興奮していて、"}, {"type": "subtitle", "time": 19119.11, "timestamp": "05:18:39", "text": "まるで私が恋をしていなかったように"}, {"type": "subtitle", "time": 19122.39, "timestamp": "05:18:42", "text": "ゲーム。だからストリーミング配信するのが好きなんです"}, {"type": "subtitle", "time": 19125.67, "timestamp": "05:18:45", "text": "長くて、実際に挽くような感じ"}, {"type": "subtitle", "time": 19127.75, "timestamp": "05:18:47", "text": "スピード重視の考え方とか、そういう感じで。私"}, {"type": "subtitle", "time": 19130.91, "timestamp": "05:18:50", "text": "わからない。でも、そう思う"}, {"type": "subtitle", "time": 19134.23, "timestamp": "05:18:54", "text": "次のゲームではこうするつもりです"}, {"type": "subtitle", "time": 19137.11, "timestamp": "05:18:57", "text": "JPをやったので、ブループロトコルになります"}, {"type": "subtitle", "time": 19139.83, "timestamp": "05:18:59", "text": "できる限りバージョンを作ったが、"}]
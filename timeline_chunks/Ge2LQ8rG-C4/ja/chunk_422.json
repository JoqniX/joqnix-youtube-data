[{"type": "subtitle", "time": 25332.91, "timestamp": "07:02:12", "text": "左。それは"}, {"type": "subtitle", "time": 25335.948, "timestamp": "07:02:15", "text": "背景。私は信じている"}, {"type": "subtitle", "time": 25339.03, "timestamp": "07:02:19", "text": "私のネットワークには制限があります。ええ、制限しました"}, {"type": "subtitle", "time": 25340.43, "timestamp": "07:02:20", "text": "それ。言い換えると"}, {"type": "subtitle", "time": 25345.51, "timestamp": "07:02:25", "text": "了解、1.3 MPで良いでしょう。"}, {"type": "subtitle", "time": 25348.708, "timestamp": "07:02:28", "text": "3人が家のために顔を出す。いいえ、３つくらい"}, {"type": "subtitle", "time": 25352.468, "timestamp": "07:02:32", "text": "顔はああ、だって私はそうじゃないから"}, {"type": "subtitle", "time": 25353.868, "timestamp": "07:02:33", "text": "知る"}, {"type": "subtitle", "time": 25357.19, "timestamp": "07:02:37", "text": "法案のように、私はどのように"}, {"type": "subtitle", "time": 25360.31, "timestamp": "07:02:40", "text": "家全体です。わかった。だからそうに違いない"}, {"type": "subtitle", "time": 25361.23, "timestamp": "07:02:41", "text": "の"}, {"type": "subtitle", "time": 25364.23, "timestamp": "07:02:44", "text": "配線。わからない。そうですね、でも"}, {"type": "subtitle", "time": 25365.91, "timestamp": "07:02:45", "text": "彼らはそれを3つの顔に変更します"}, {"type": "subtitle", "time": 25367.99, "timestamp": "07:02:47", "text": "上の階は、"}, {"type": "subtitle", "time": 25370.868, "timestamp": "07:02:50", "text": "賃貸のように、もっと賃貸のように"}, {"type": "subtitle", "time": 25374.07, "timestamp": "07:02:54", "text": "オフィススペースを2つの団体に提供する。だから私は"}, {"type": "subtitle", "time": 25377.27, "timestamp": "07:02:57", "text": "別々に小さなものを手に入れる"}]
[{"type": "subtitle", "time": 21662.548, "timestamp": "06:01:02", "text": "できない、ああ、正しく確認できない"}, {"type": "subtitle", "time": 21682.15, "timestamp": "06:01:22", "text": "おそらく次のような人たちが見られると思います"}, {"type": "subtitle", "time": 21685.35, "timestamp": "06:01:25", "text": "これらのボスのようなワンショットと"}, {"type": "subtitle", "time": 21688.59, "timestamp": "06:01:28", "text": "すべて、ですよね？このゲームでは"}, {"type": "subtitle", "time": 21692.868, "timestamp": "06:01:32", "text": "良い。本当に幸運な人たち"}, {"type": "subtitle", "time": 21696.948, "timestamp": "06:01:36", "text": "アーティファクトやエコーのようなものは、"}, {"type": "subtitle", "time": 21700.548, "timestamp": "06:01:40", "text": "ダメージ数値を誇示し、"}, {"type": "subtitle", "time": 21703.83, "timestamp": "06:01:43", "text": "うん、ちょうど人々が"}, {"type": "subtitle", "time": 21706.628, "timestamp": "06:01:46", "text": "YouTubeの映像と動画だけ"}, {"type": "subtitle", "time": 21709.83, "timestamp": "06:01:49", "text": "クリップ、右、彼らがただ訪問している"}, {"type": "subtitle", "time": 21712.788, "timestamp": "06:01:52", "text": "ボス、そして2秒後にバン！"}, {"type": "subtitle", "time": 21717.51, "timestamp": "06:01:57", "text": "上司が死んだ。そういう類のもの"}]
[{"type": "subtitle", "time": 23220.948, "timestamp": "06:27:00", "text": "クリティカル クリティカル ダメージ クリティカル レート"}, {"type": "subtitle", "time": 23222.27, "timestamp": "06:27:02", "text": "ダメージ"}, {"type": "subtitle", "time": 23225.468, "timestamp": "06:27:05", "text": "ボーナスも付いてきます。はい、私たちはこれを"}, {"type": "subtitle", "time": 23229.31, "timestamp": "06:27:09", "text": "少しでも。つまり50歳ですよね？私がそうする前に私にさせてください"}, {"type": "subtitle", "time": 23232.67, "timestamp": "06:27:12", "text": "それ。 180点満点中0点。"}, {"type": "subtitle", "time": 23234.75, "timestamp": "06:27:14", "text": "わかった。"}, {"type": "subtitle", "time": 23238.15, "timestamp": "06:27:18", "text": "えっと、180点中0点。これを申請したら、"}, {"type": "subtitle", "time": 23240.51, "timestamp": "06:27:20", "text": "50 を取得する、"}, {"type": "subtitle", "time": 23245.81, "timestamp": "06:27:25", "text": "それから"}, {"type": "subtitle", "time": 23247.468, "timestamp": "06:27:27", "text": "[音楽]"}, {"type": "subtitle", "time": 23253.11, "timestamp": "06:27:33", "text": "15. ああ、12. え？"}, {"type": "subtitle", "time": 23258.27, "timestamp": "06:27:38", "text": "紫と金色が欲しい"}, {"type": "subtitle", "time": 23263.548, "timestamp": "06:27:43", "text": "1つ。何？はぁ？ああ、なんて怖いんだ"}, {"type": "subtitle", "time": 23267.07, "timestamp": "06:27:47", "text": "自分。こんにちは、襲撃者の皆さん。いらっしゃいませ。"}, {"type": "subtitle", "time": 23269.91, "timestamp": "06:27:49", "text": "ようこそ、神よ。ブー。いらっしゃいませ。いらっしゃいませ。"}, {"type": "subtitle", "time": 23272.11, "timestamp": "06:27:52", "text": "いらっしゃいませ。ありがとうございます"}, {"type": "subtitle", "time": 23274.788, "timestamp": "06:27:54", "text": "襲撃。襲撃してくれてありがとう。ようこそ"}, {"type": "subtitle", "time": 23277.07, "timestamp": "06:27:57", "text": "襲撃者。"}]
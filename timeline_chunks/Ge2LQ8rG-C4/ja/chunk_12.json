[{"type": "subtitle", "time": 721.15, "timestamp": "00:12:01", "text": "あれ？コソのやつ。"}, {"type": "subtitle", "time": 727.509, "timestamp": "00:12:07", "text": "コサント。名前を忘れてしまった。"}, {"type": "subtitle", "time": 730.23, "timestamp": "00:12:10", "text": "コイサンド。コイサンド。うん。"}, {"type": "subtitle", "time": 734.55, "timestamp": "00:12:14", "text": "コシサンド。うん。私は思う"}, {"type": "subtitle", "time": 737.03, "timestamp": "00:12:17", "text": "忘れた。ブレットは私に発音の仕方を教えてくれた"}, {"type": "subtitle", "time": 741.79, "timestamp": "00:12:21", "text": "それ。何だって？あれは何だったんだ？"}, {"type": "subtitle", "time": 745.629, "timestamp": "00:12:25", "text": "コソアン。私は痛みを感じていますか？"}, {"type": "subtitle", "time": 749.19, "timestamp": "00:12:29", "text": "コシアン。わかった。ところで、もしあなたがそうしなかったら"}, {"type": "subtitle", "time": 750.949, "timestamp": "00:12:30", "text": "知ってるか、新しい機能が登場する"}, {"type": "subtitle", "time": 753.269, "timestamp": "00:12:33", "text": "Twitchでは、直接クリップすることができます"}, {"type": "subtitle", "time": 760.509, "timestamp": "00:12:40", "text": "ストリーム視聴を中断します"}, {"type": "subtitle", "time": 763.629, "timestamp": "00:12:43", "text": "経験。それはおかしいと思う"}, {"type": "subtitle", "time": 775.19, "timestamp": "00:12:55", "text": "大丈夫。ねえ、M。一緒に参加しない？"}, {"type": "subtitle", "time": 777.509, "timestamp": "00:12:57", "text": "うん。参加しませんか。参加しませんか。ええ、もしあなたが"}, {"type": "subtitle", "time": 779.67, "timestamp": "00:12:59", "text": "私たちに参加してください、次はJocknを指名できます、そして私たちは"}]
[{"type": "subtitle", "time": 4580.87, "timestamp": "01:16:20", "text": "クリップ。もう一つのゲームは何でしたか？何ですか"}, {"type": "subtitle", "time": 4583.39, "timestamp": "01:16:23", "text": "それ？何だって？何だって"}, {"type": "subtitle", "time": 4587.709, "timestamp": "01:16:27", "text": "あれ？何かコヤントみたいなもの。"}, {"type": "subtitle", "time": 4590.189, "timestamp": "01:16:30", "text": "コヤント。コサント。"}, {"type": "subtitle", "time": 4604.189, "timestamp": "01:16:44", "text": "できません。おお。他の何だったのか"}, {"type": "subtitle", "time": 4612.95, "timestamp": "01:16:52", "text": "言った。どんなゲームだったの？あれは何でしょう？"}, {"type": "subtitle", "time": 4616.229, "timestamp": "01:16:56", "text": "何だって？あれは何だったんだ？"}]
[{"type": "subtitle", "time": 1560.83, "timestamp": "00:26:00", "text": "混乱した。これら"}, {"type": "subtitle", "time": 1589.95, "timestamp": "00:26:29", "text": "[音楽]"}, {"type": "subtitle", "time": 1592.71, "timestamp": "00:26:32", "text": "コラボレーション。待って、誰かに聞きたいことがある"}, {"type": "subtitle", "time": 1595.149, "timestamp": "00:26:35", "text": "何か。日本語"}, {"type": "subtitle", "time": 1599.269, "timestamp": "00:26:39", "text": "言語。日本語を話せますか？えっと、私は"}, {"type": "subtitle", "time": 1602.35, "timestamp": "00:26:42", "text": "日本語を学ぶ。私は"}, {"type": "subtitle", "time": 1606.669, "timestamp": "00:26:46", "text": "7月の日本。私は学んでいます"}, {"type": "subtitle", "time": 1609.31, "timestamp": "00:26:49", "text": "日本語"}, {"type": "subtitle", "time": 1615.35, "timestamp": "00:26:55", "text": "現在、私は日本に行く予定です"}, {"type": "subtitle", "time": 1616.43, "timestamp": "00:26:56", "text": "で"}, {"type": "subtitle", "time": 1618.35, "timestamp": "00:26:58", "text": "7月。"}]
[{"type": "subtitle", "time": 26233.91, "timestamp": "07:17:13", "text": "知らないだろうし、知らないだろう"}, {"type": "subtitle", "time": 26237.43, "timestamp": "07:17:17", "text": "あなたは有名人だ。うん、確かにそうだね。そこには"}, {"type": "subtitle", "time": 26240.03, "timestamp": "07:17:20", "text": "ファンのようではないだろう"}, {"type": "subtitle", "time": 26262.83, "timestamp": "07:17:42", "text": "はい、もう一度確認させてください"}, {"type": "subtitle", "time": 26265.35, "timestamp": "07:17:45", "text": "何か。私は携帯電話を充電しただろうか？わかった、"}, {"type": "subtitle", "time": 26266.99, "timestamp": "07:17:46", "text": "私は充電しています"}, {"type": "subtitle", "time": 26276.468, "timestamp": "07:17:56", "text": "神。ご存知の通り、私は見ていません"}]
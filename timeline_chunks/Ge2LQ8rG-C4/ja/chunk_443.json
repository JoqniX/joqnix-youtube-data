[{"type": "subtitle", "time": 26596.99, "timestamp": "07:23:16", "text": "うん。 1025 2568 58。はい。言う"}, {"type": "subtitle", "time": 26605.51, "timestamp": "07:23:25", "text": "ここ。わかった。これは違う。えっと、マーク"}, {"type": "subtitle", "time": 26608.868, "timestamp": "07:23:28", "text": "では、他に誰が残っているのか？"}, {"type": "subtitle", "time": 26612.548, "timestamp": "07:23:32", "text": "あと1、2、2人。教えてください"}, {"type": "subtitle", "time": 26620.43, "timestamp": "07:23:40", "text": "どこかで。えっと、こちらです。"}, {"type": "subtitle", "time": 26630.27, "timestamp": "07:23:50", "text": "[音楽]"}, {"type": "subtitle", "time": 26638.39, "timestamp": "07:23:58", "text": "ああ、これは覚えていない。これは私が撮ったものです。"}]
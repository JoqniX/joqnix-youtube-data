[{"type": "subtitle", "time": 22807.31, "timestamp": "06:20:07", "text": "えっと、削除できます"}, {"type": "subtitle", "time": 22815.23, "timestamp": "06:20:15", "text": "[音楽]"}, {"type": "subtitle", "time": 22824.628, "timestamp": "06:20:24", "text": "こういうウェブサイトを開くのがすごく怖い"}, {"type": "subtitle", "time": 22828.07, "timestamp": "06:20:28", "text": "だって、もし彼らが私を切り捨てたらどうなるか"}, {"type": "subtitle", "time": 22829.548, "timestamp": "06:20:29", "text": "またビリー"}, {"type": "subtitle", "time": 22833.43, "timestamp": "06:20:33", "text": "ビリーもこう言うだろう"}, {"type": "subtitle", "time": 22836.51, "timestamp": "06:20:36", "text": "外国ウェブサイトの違反"}, {"type": "subtitle", "time": 22846.11, "timestamp": "06:20:46", "text": "怖いので、この2人がメインです"}, {"type": "subtitle", "time": 22849.868, "timestamp": "06:20:49", "text": "よし、それで彼女を"}, {"type": "subtitle", "time": 22854.99, "timestamp": "06:20:54", "text": "の上。削除する必要があることはわかっています。削除します。"}, {"type": "subtitle", "time": 22858.09, "timestamp": "06:20:58", "text": "あなたは"}]
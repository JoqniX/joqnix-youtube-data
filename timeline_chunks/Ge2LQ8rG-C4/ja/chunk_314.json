[{"type": "subtitle", "time": 18841.03, "timestamp": "05:14:01", "text": "わかった。ええ、そうですね。ええと、これからは。でも、"}, {"type": "subtitle", "time": 18845.35, "timestamp": "05:14:05", "text": "私が、えっと、私が、"}, {"type": "subtitle", "time": 18849.59, "timestamp": "05:14:09", "text": "ビリービリーに警告が出たんだけど、"}, {"type": "subtitle", "time": 18852.47, "timestamp": "05:14:12", "text": "文字通り画面が吹き飛ぶか、"}, {"type": "subtitle", "time": 18855.91, "timestamp": "05:14:15", "text": "いつでもシーンを切り替える"}, {"type": "subtitle", "time": 18858.31, "timestamp": "05:14:18", "text": "私自身も何かをチェックする必要があるし"}, {"type": "subtitle", "time": 18860.31, "timestamp": "05:14:20", "text": "もの。だから私はこう思う"}, {"type": "subtitle", "time": 18861.47, "timestamp": "05:14:21", "text": "重要性"}, {"type": "subtitle", "time": 18864.868, "timestamp": "05:14:24", "text": "4台目のモニターは重要です。えっと、4番目"}, {"type": "subtitle", "time": 18867.43, "timestamp": "05:14:27", "text": "つまり、私はセカンドモニターを持っていません"}, {"type": "subtitle", "time": 18870.55, "timestamp": "05:14:30", "text": "私のゲーム用PC。だから私は"}, {"type": "subtitle", "time": 18872.788, "timestamp": "05:14:32", "text": "PC全体が"}, {"type": "subtitle", "time": 18876.868, "timestamp": "05:14:36", "text": "スクリーニングされた。リスクを冒すわけにはいかない。"}, {"type": "subtitle", "time": 18879.43, "timestamp": "05:14:39", "text": "そう、それが問題なんです。だから私は"}, {"type": "subtitle", "time": 18887.51, "timestamp": "05:14:47", "text": "音声起動システムも作った"}, {"type": "subtitle", "time": 18890.07, "timestamp": "05:14:50", "text": "音声起動も試したことがない"}, {"type": "subtitle", "time": 18893.628, "timestamp": "05:14:53", "text": "音声アーキテクチャ関連のもの"}, {"type": "subtitle", "time": 18896.55, "timestamp": "05:14:56", "text": "ええと、そうではありませんし、私のPCもそうではありません"}, {"type": "subtitle", "time": 18898.948, "timestamp": "05:14:58", "text": "スピーチを理解する 食事認識"}]
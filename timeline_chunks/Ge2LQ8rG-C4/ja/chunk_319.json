[{"type": "subtitle", "time": 19143.03, "timestamp": "05:19:03", "text": "私は日本語版をプレイすることができました"}, {"type": "subtitle", "time": 19147.59, "timestamp": "05:19:07", "text": "そう、たくさんプレイしたりしてるよ。"}, {"type": "subtitle", "time": 19150.628, "timestamp": "05:19:10", "text": "えっと、待って、CNをプレイできるの？"}, {"type": "subtitle", "time": 19152.43, "timestamp": "05:19:12", "text": "バージョン。"}, {"type": "subtitle", "time": 19155.19, "timestamp": "05:19:15", "text": "待って、待って。あ、待って。彼らはリリースしましたか？"}, {"type": "subtitle", "time": 19157.75, "timestamp": "05:19:17", "text": "中国向けですか？わからない。うん、"}, {"type": "subtitle", "time": 19159.11, "timestamp": "05:19:19", "text": "発売されたらそんな感じ"}, {"type": "subtitle", "time": 19160.708, "timestamp": "05:19:20", "text": "グローバル向け。いいえ、もちろん行きます"}, {"type": "subtitle", "time": 19161.708, "timestamp": "05:19:21", "text": "育つ"}, {"type": "subtitle", "time": 19166.51, "timestamp": "05:19:26", "text": "それ。ブループロトコルはブループロトコルは"}, {"type": "subtitle", "time": 19170.708, "timestamp": "05:19:30", "text": "最高。私はそれが好きだ。まあ、とにかく、"}, {"type": "subtitle", "time": 19175.47, "timestamp": "05:19:35", "text": "ゲームに戻ろう。ハリスト（別名）"}, {"type": "subtitle", "time": 19178.39, "timestamp": "05:19:38", "text": "ガルト。私は彼をカリストと呼ぶのが好きです。私"}, {"type": "subtitle", "time": 19179.31, "timestamp": "05:19:39", "text": "わからない"}, {"type": "subtitle", "time": 19195.868, "timestamp": "05:19:55", "text": "わかった。赤いものがたくさんあります"}, {"type": "subtitle", "time": 19199.55, "timestamp": "05:19:59", "text": "四肢。何でも。これらは何と呼ばれますか？"}]
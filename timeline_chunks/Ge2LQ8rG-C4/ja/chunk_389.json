[{"type": "subtitle", "time": 23340.548, "timestamp": "06:29:00", "text": "あなたは。えっと、私の組合ランクは現在30です。私"}, {"type": "subtitle", "time": 23342.868, "timestamp": "06:29:02", "text": "クエストは何もやっていません。まだやっていない"}, {"type": "subtitle", "time": 23345.99, "timestamp": "06:29:05", "text": "メインクエスト。動かなくなってしまった。私は"}, {"type": "subtitle", "time": 23349.03, "timestamp": "06:29:09", "text": "ちょっとした、えーと、ランダムなクエスト。"}, {"type": "subtitle", "time": 23351.11, "timestamp": "06:29:11", "text": "それでおしまい。側面を仕上げようとしています"}, {"type": "subtitle", "time": 23354.31, "timestamp": "06:29:14", "text": "クエストか何か。だから、私は100％"}, {"type": "subtitle", "time": 23358.15, "timestamp": "06:29:18", "text": "すべてです。現在、私は99です"}, {"type": "subtitle", "time": 23361.19, "timestamp": "06:29:21", "text": "中央平面とこれら２つを完成させた"}, {"type": "subtitle", "time": 23362.708, "timestamp": "06:29:22", "text": "地域。"}, {"type": "subtitle", "time": 23367.27, "timestamp": "06:29:27", "text": "そして今日はKaが終わらせよう"}, {"type": "subtitle", "time": 23371.43, "timestamp": "06:29:31", "text": "マヤ・エクシス・マヤとこの３つを試してみます"}, {"type": "subtitle", "time": 23373.548, "timestamp": "06:29:33", "text": "それらに取り組むために"}, {"type": "subtitle", "time": 23386.11, "timestamp": "06:29:46", "text": "[音楽]"}, {"type": "subtitle", "time": 23394.11, "timestamp": "06:29:54", "text": "えっと、私は何をしていたんでしたっけ？私"}, {"type": "subtitle", "time": 23396.27, "timestamp": "06:29:56", "text": "忘れた。ああ、"}]
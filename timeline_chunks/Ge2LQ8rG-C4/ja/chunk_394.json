[{"type": "subtitle", "time": 23642.31, "timestamp": "06:34:02", "text": "どうやら他の多くの人々も"}, {"type": "subtitle", "time": 23645.75, "timestamp": "06:34:05", "text": "ウイングウェーブスのプレイヤーも行き詰まっていました"}, {"type": "subtitle", "time": 23646.59, "timestamp": "06:34:06", "text": "で"}, {"type": "subtitle", "time": 23652.15, "timestamp": "06:34:12", "text": "99 サンダルプレーンの 99 と 97"}, {"type": "subtitle", "time": 23653.59, "timestamp": "06:34:13", "text": "補給箱。"}, {"type": "subtitle", "time": 23654.708, "timestamp": "06:34:14", "text": "[音楽]"}, {"type": "subtitle", "time": 23657.19, "timestamp": "06:34:17", "text": "まるで秘密や隠されたことのように"}, {"type": "subtitle", "time": 23661.27, "timestamp": "06:34:21", "text": "補給箱は災いのようなもので"}, {"type": "subtitle", "time": 23664.788, "timestamp": "06:34:24", "text": "どうやら、私が胸を少し取ったとしても"}, {"type": "subtitle", "time": 23667.788, "timestamp": "06:34:27", "text": "これらのサイドクエストから"}, {"type": "subtitle", "time": 23672.23, "timestamp": "06:34:32", "text": "74%にはカウントされませんでした"}, {"type": "subtitle", "time": 23676.07, "timestamp": "06:34:36", "text": "理由はわからないので、これはいくつかのことを示しています"}, {"type": "subtitle", "time": 23679.23, "timestamp": "06:34:39", "text": "クエストの中にはカウントされるものもあれば、カウントされないものもある。"}, {"type": "subtitle", "time": 23683.59, "timestamp": "06:34:43", "text": "これらを数える、えっと、なんて言うんだっけ"}, {"type": "subtitle", "time": 23696.628, "timestamp": "06:34:56", "text": "痛み。えーと、あと、私には"}]
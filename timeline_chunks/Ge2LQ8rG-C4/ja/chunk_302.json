[{"type": "subtitle", "time": 18143.55, "timestamp": "05:02:23", "text": "はい、たった1時間だけ"}, {"type": "subtitle", "time": 18147.11, "timestamp": "05:02:27", "text": "空所。それで十分だ。私は"}, {"type": "subtitle", "time": 18151.948, "timestamp": "05:02:31", "text": "V字型の穴。それはあまりにも"}, {"type": "subtitle", "time": 18155.83, "timestamp": "05:02:35", "text": "多くの。これらのVSは、"}, {"type": "subtitle", "time": 18157.47, "timestamp": "05:02:37", "text": "見逃したコンテンツ"}, {"type": "subtitle", "time": 18161.35, "timestamp": "05:02:41", "text": "外に出て物事を好きになるのではなく、その逆ではない"}, {"type": "subtitle", "time": 18163.27, "timestamp": "05:02:43", "text": "その周り。"}, {"type": "subtitle", "time": 18166.43, "timestamp": "05:02:46", "text": "私は本当にしたくない"}, {"type": "subtitle", "time": 18168.03, "timestamp": "05:02:48", "text": "置く"}, {"type": "subtitle", "time": 18172.628, "timestamp": "05:02:52", "text": "VSはただのジョークのようなもので、戦争です"}]
[{"type": "subtitle", "time": 16322.229, "timestamp": "04:32:02", "text": "私は終わった。ミナ、あと1人。最後にもう一度"}, {"type": "subtitle", "time": 16333.95, "timestamp": "04:32:13", "text": "私は"}, {"type": "subtitle", "time": 16339.189, "timestamp": "04:32:19", "text": "ビリービリーにアップロードして、"}, {"type": "subtitle", "time": 16340.349, "timestamp": "04:32:20", "text": "寝る。"}, {"type": "subtitle", "time": 16343.51, "timestamp": "04:32:23", "text": "わかった。私のPCが苦戦しているのは分かっていますし、"}, {"type": "subtitle", "time": 16346.189, "timestamp": "04:32:26", "text": "息苦しいし、その他諸々"}, {"type": "subtitle", "time": 16352.95, "timestamp": "04:32:32", "text": "ええ、大丈夫です。"}, {"type": "subtitle", "time": 16355.389, "timestamp": "04:32:35", "text": "最後にもう一度"}]
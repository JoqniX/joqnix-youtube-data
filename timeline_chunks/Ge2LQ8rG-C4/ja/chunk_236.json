[{"type": "subtitle", "time": 14162.389, "timestamp": "03:56:02", "text": "そうですね、それで構いませんが、"}, {"type": "subtitle", "time": 14165.71, "timestamp": "03:56:05", "text": "ちゃんとしたショートパンツを作りたいんです"}, {"type": "subtitle", "time": 14168.79, "timestamp": "03:56:08", "text": "コンテンツ。私は決して"}, {"type": "subtitle", "time": 14172.15, "timestamp": "03:56:12", "text": "このようなストリームクリップを投稿する"}, {"type": "subtitle", "time": 14173.309, "timestamp": "03:56:13", "text": "主要"}, {"type": "subtitle", "time": 14176.469, "timestamp": "03:56:16", "text": "チャネル。私のメインチャンネルです。私 私 私"}, {"type": "subtitle", "time": 14178.309, "timestamp": "03:56:18", "text": "実際にVでやろうと考えた"}, {"type": "subtitle", "time": 14180.189, "timestamp": "03:56:20", "text": "チャンネル、V YouTube"}, {"type": "subtitle", "time": 14183.189, "timestamp": "03:56:23", "text": "メインチャンネルではなく正直に"}, {"type": "subtitle", "time": 14185.83, "timestamp": "03:56:25", "text": "チャンネルなので、実際に品質を"}, {"type": "subtitle", "time": 14188.51, "timestamp": "03:56:28", "text": "コンテンツ"}, {"type": "subtitle", "time": 14192.83, "timestamp": "03:56:32", "text": "主要。それで私は「ああ、私はやりすぎだ」と思った"}, {"type": "subtitle", "time": 14194.87, "timestamp": "03:56:34", "text": "プロ意識の高い人。私は言い続けます"}, {"type": "subtitle", "time": 14197.269, "timestamp": "03:56:37", "text": "いつかはやるけど、絶対にやらない"}, {"type": "subtitle", "time": 14200.71, "timestamp": "03:56:40", "text": "それ。したがって、"}, {"type": "subtitle", "time": 14203.91, "timestamp": "03:56:43", "text": "ジョッカソン 私は色々なことを始めましたが、"}, {"type": "subtitle", "time": 14206.469, "timestamp": "03:56:46", "text": "ジョックアソンの間は、"}, {"type": "subtitle", "time": 14208.51, "timestamp": "03:56:48", "text": "約束をした"}, {"type": "subtitle", "time": 14211.11, "timestamp": "03:56:51", "text": "新しいモデルのために、自分自身がより良い仕事をできるように"}, {"type": "subtitle", "time": 14212.429, "timestamp": "03:56:52", "text": "ジョックと"}, {"type": "subtitle", "time": 14215.429, "timestamp": "03:56:55", "text": "すべて。うん。それ以来私は"}, {"type": "subtitle", "time": 14217.229, "timestamp": "03:56:57", "text": "考える"}]
[{"type": "subtitle", "time": 5524.55, "timestamp": "01:32:04", "text": "他の人は？なぜなら、私のクリップは"}, {"type": "subtitle", "time": 5527.07, "timestamp": "01:32:07", "text": "私のINRAエンゲージメント"}, {"type": "subtitle", "time": 5530.229, "timestamp": "01:32:10", "text": "それ。でも、私は画面の中にいるだけです。私は"}, {"type": "subtitle", "time": 5534.47, "timestamp": "01:32:14", "text": "コラボレーション。声に出しては話していません"}, {"type": "subtitle", "time": 5557.629, "timestamp": "01:32:37", "text": "ない。寿司の"}, {"type": "subtitle", "time": 5560.99, "timestamp": "01:32:40", "text": "話したり笑ったり。"}, {"type": "subtitle", "time": 5575.99, "timestamp": "01:32:55", "text": "自分。それは問題ないですか、それとも問題がありますか？もし"}, {"type": "subtitle", "time": 5578.79, "timestamp": "01:32:58", "text": "これは良くないから、後で削除するよ。私"}]
[{"type": "subtitle", "time": 26341.39, "timestamp": "07:19:01", "text": "それ。どこに"}, {"type": "subtitle", "time": 26344.91, "timestamp": "07:19:04", "text": "あなた？いつ"}, {"type": "subtitle", "time": 26354.39, "timestamp": "07:19:14", "text": "88歳。ちょっと待って。なぜ供給が"}, {"type": "subtitle", "time": 26356.11, "timestamp": "07:19:16", "text": "胸"}, {"type": "subtitle", "time": 26359.03, "timestamp": "07:19:19", "text": "99？つまり、私がそれを見つけなければならないということですか？"}, {"type": "subtitle", "time": 26376.67, "timestamp": "07:19:36", "text": "えっと、私は"}, {"type": "subtitle", "time": 26381.11, "timestamp": "07:19:41", "text": "小さなものを探しているんです"}, {"type": "subtitle", "time": 26385.75, "timestamp": "07:19:45", "text": "丸い塊のようなモブ。"}, {"type": "subtitle", "time": 26390.67, "timestamp": "07:19:50", "text": "それは原神に出てくるあのやつみたいなものです。いいえ、それらは"}, {"type": "subtitle", "time": 26394.15, "timestamp": "07:19:54", "text": "えっと、原神では何だったっけ？"}, {"type": "subtitle", "time": 26397.07, "timestamp": "07:19:57", "text": "ほら、あの金色のやつとか"}, {"type": "subtitle", "time": 26399.51, "timestamp": "07:19:59", "text": "何か？それを殺そうとすると、"}]
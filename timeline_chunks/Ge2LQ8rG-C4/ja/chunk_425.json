[{"type": "subtitle", "time": 25503.91, "timestamp": "07:05:03", "text": "とんでもなく大きな家だ。いいえ、そうは思いません"}, {"type": "subtitle", "time": 25507.868, "timestamp": "07:05:07", "text": "それはとてつもなく大きい。"}, {"type": "subtitle", "time": 25516.628, "timestamp": "07:05:16", "text": "うーん、そんなに大きな家じゃないと思うよ。私"}, {"type": "subtitle", "time": 25519.03, "timestamp": "07:05:19", "text": "わからない。それは普通のことのように感じた"}, {"type": "subtitle", "time": 25521.99, "timestamp": "07:05:21", "text": "1つ。普通は家を持っているようなものだ"}, {"type": "subtitle", "time": 25524.23, "timestamp": "07:05:24", "text": "でも、まるで1階みたいなんです。いいえ、"}, {"type": "subtitle", "time": 25526.23, "timestamp": "07:05:26", "text": "地上階、つまり床のことです"}, {"type": "subtitle", "time": 25528.548, "timestamp": "07:05:28", "text": "道路脇の道路に近い"}, {"type": "subtitle", "time": 25531.11, "timestamp": "07:05:31", "text": "レベルですよね？それから私は高台に行きたい"}, {"type": "subtitle", "time": 25533.99, "timestamp": "07:05:33", "text": "レベル。それはレベル1ですよね？うん、"}, {"type": "subtitle", "time": 25536.19, "timestamp": "07:05:36", "text": "それは"}, {"type": "subtitle", "time": 25540.27, "timestamp": "07:05:40", "text": "それ。アパートみたいな感じですか？私はしません"}, {"type": "subtitle", "time": 25543.99, "timestamp": "07:05:43", "text": "知る。私はこれを、えーっと、好きなものを見せたい"}, {"type": "subtitle", "time": 25547.83, "timestamp": "07:05:47", "text": "デザイナーによるスケッチ"}, {"type": "subtitle", "time": 25550.868, "timestamp": "07:05:50", "text": "ええと、まあ、ある程度は理解できると思います。私は"}, {"type": "subtitle", "time": 25553.75, "timestamp": "07:05:53", "text": "個人情報が漏洩するのではないかと恐れています。ありえない"}, {"type": "subtitle", "time": 25556.39, "timestamp": "07:05:56", "text": "誰でもその家がどこにあるか分かるよ"}, {"type": "subtitle", "time": 25559.43, "timestamp": "07:05:59", "text": "まだ工事中でよくわからない"}]
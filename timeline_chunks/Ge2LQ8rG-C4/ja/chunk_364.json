[{"type": "subtitle", "time": 21841.91, "timestamp": "06:04:01", "text": "おそらく、何らかの不具合のある遺物か何かだろう。"}, {"type": "subtitle", "time": 21869.59, "timestamp": "06:04:29", "text": "終わり。今は帰ってもいいですか？私は去ります"}, {"type": "subtitle", "time": 21876.31, "timestamp": "06:04:36", "text": "実は。次。そうなるような気がする"}, {"type": "subtitle", "time": 21879.03, "timestamp": "06:04:39", "text": "もう一度それを起動させてください。"}]
[{"type": "subtitle", "time": 22320.51, "timestamp": "06:12:00", "text": "より低い"}, {"type": "subtitle", "time": 22324.11, "timestamp": "06:12:04", "text": "ロックして合成することでレベルを上げる"}, {"type": "subtitle", "time": 22347.91, "timestamp": "06:12:27", "text": "シニス。私はこれを他のすべての"}, {"type": "subtitle", "time": 22350.7, "timestamp": "06:12:30", "text": "あれこれ、なぜ私はこれをやらないのか"}, {"type": "subtitle", "time": 22353.39, "timestamp": "06:12:33", "text": "[音楽]"}, {"type": "subtitle", "time": 22355.708, "timestamp": "06:12:35", "text": "良い？今"}, {"type": "subtitle", "time": 22359.11, "timestamp": "06:12:39", "text": "これ、１、２、３、４、ですよね？"}, {"type": "subtitle", "time": 22373.67, "timestamp": "06:12:53", "text": "それ。だから、コピーを保管しておく"}, {"type": "subtitle", "time": 22377.11, "timestamp": "06:12:57", "text": "在庫。ロックされたこの1つだけ"}, {"type": "subtitle", "time": 22378.27, "timestamp": "06:12:58", "text": "R5"}]
[{"type": "subtitle", "time": 4267.27, "timestamp": "01:11:07", "text": "カード。ええと、マラソンの時"}, {"type": "subtitle", "time": 4270.189, "timestamp": "01:11:10", "text": "発売されたら、プレイします。私"}, {"type": "subtitle", "time": 4274.669, "timestamp": "01:11:14", "text": "多分、私には買えると思うし"}, {"type": "subtitle", "time": 4282.51, "timestamp": "01:11:22", "text": "モード。数時間後にプレイします"}, {"type": "subtitle", "time": 4299.28, "timestamp": "01:11:39", "text": "優先順位をつける。"}, {"type": "subtitle", "time": 4306.55, "timestamp": "01:11:46", "text": "もちろん、一部の動画は"}, {"type": "subtitle", "time": 4309.669, "timestamp": "01:11:49", "text": "一部の動画がブロックされています。ああ神様、どこに"}]
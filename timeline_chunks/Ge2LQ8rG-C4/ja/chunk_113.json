[{"type": "subtitle", "time": 6798.83, "timestamp": "01:53:18", "text": "このアプリは何ですか？ああ、ストリーム"}, {"type": "subtitle", "time": 6802.87, "timestamp": "01:53:22", "text": "ラダー。あなたが話してくれたやつ。"}, {"type": "subtitle", "time": 6805.95, "timestamp": "01:53:25", "text": "私はストリームラダーを使用しています"}, {"type": "subtitle", "time": 6810.31, "timestamp": "01:53:30", "text": "けれど。えっと、私はストリームラダーを使っています。私"}, {"type": "subtitle", "time": 6812.91, "timestamp": "01:53:32", "text": "えっと、私は使っていました"}, {"type": "subtitle", "time": 6816.47, "timestamp": "01:53:36", "text": "金庫を分割するためのジョイナー・スプリッター"}, {"type": "subtitle", "time": 6818.629, "timestamp": "01:53:38", "text": "2つに"}, {"type": "subtitle", "time": 6823.39, "timestamp": "01:53:43", "text": "えっと、それに参加したりとか。"}, {"type": "subtitle", "time": 6827.03, "timestamp": "01:53:47", "text": "字幕機能がうまく動作しない"}, {"type": "subtitle", "time": 6829.27, "timestamp": "01:53:49", "text": "私にとって。それは私のことを理解していない"}, {"type": "subtitle", "time": 6830.78, "timestamp": "01:53:50", "text": "きちんと。見せる"}, {"type": "subtitle", "time": 6833.629, "timestamp": "01:53:53", "text": "[音楽]"}, {"type": "subtitle", "time": 6838.03, "timestamp": "01:53:58", "text": "痛み。こんにちは、ザキさん。元気かい？"}]
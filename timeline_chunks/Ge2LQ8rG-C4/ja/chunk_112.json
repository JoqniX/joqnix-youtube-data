[{"type": "subtitle", "time": 6747.51, "timestamp": "01:52:27", "text": "削除してドラッグしてドロップする必要があります"}, {"type": "subtitle", "time": 6749.87, "timestamp": "01:52:29", "text": "他のプラットフォームでは"}, {"type": "subtitle", "time": 6752.35, "timestamp": "01:52:32", "text": "信じる。ドウェイ"}, {"type": "subtitle", "time": 6757.51, "timestamp": "01:52:37", "text": "より良い。ドラッグして、ブープ。そしてここでも同様だ。"}, {"type": "subtitle", "time": 6760.03, "timestamp": "01:52:40", "text": "ドラゴン"}, {"type": "subtitle", "time": 6763.589, "timestamp": "01:52:43", "text": "ブープ。 Mジャマイカンパティは最高だ。やあ、M。"}]
[{"type": "subtitle", "time": 8540.95, "timestamp": "02:22:20", "text": "さて、最後です。それは"}, {"type": "subtitle", "time": 8543.91, "timestamp": "02:22:23", "text": "私の友達、相棒。この仕事に就きたいのですか？"}, {"type": "subtitle", "time": 8546.309, "timestamp": "02:22:26", "text": "優秀なVトルーパーになりたいですか？しなければならない"}, {"type": "subtitle", "time": 8553.07, "timestamp": "02:22:33", "text": "知る、追加する"}, {"type": "subtitle", "time": 8556.15, "timestamp": "02:22:36", "text": "収益性のある。私たちに提供していただく必要があります"}, {"type": "subtitle", "time": 8557.67, "timestamp": "02:22:37", "text": "実際に"}, {"type": "subtitle", "time": 8560.71, "timestamp": "02:22:40", "text": "視聴者にとって興味深いもの。"}, {"type": "subtitle", "time": 8563.51, "timestamp": "02:22:43", "text": "なぜそんなに落ち込んでいるのか教えてください。"}, {"type": "subtitle", "time": 8565.99, "timestamp": "02:22:45", "text": "フィリピン人女性？つまり、つまり"}, {"type": "subtitle", "time": 8569.19, "timestamp": "02:22:49", "text": "髪型は、ああ、私は、私は、さっき、"}, {"type": "subtitle", "time": 8572.87, "timestamp": "02:22:52", "text": "私はショートボブカットが大好きだと言った"}, {"type": "subtitle", "time": 8578.469, "timestamp": "02:22:58", "text": "あなたが震えていたのが素敵でした"}]
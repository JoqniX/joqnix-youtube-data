[{"type": "subtitle", "time": 26161.03, "timestamp": "07:16:01", "text": "そういうことなら、私は"}, {"type": "subtitle", "time": 26162.39, "timestamp": "07:16:02", "text": "知らないけど、何か物語があるんだ"}, {"type": "subtitle", "time": 26163.91, "timestamp": "07:16:03", "text": "他のクリップをいくつか見たことがある"}, {"type": "subtitle", "time": 26167.91, "timestamp": "07:16:07", "text": "YouTuberは家族について話すのが好きです"}, {"type": "subtitle", "time": 26170.15, "timestamp": "07:16:10", "text": "メンバーや兄弟姉妹がそれを知った"}, {"type": "subtitle", "time": 26173.91, "timestamp": "07:16:13", "text": "それらはチューブか何かだ。ムナだと思う"}, {"type": "subtitle", "time": 26177.91, "timestamp": "07:16:17", "text": "ホーリーのハッシュ・マはかつてこう言った"}, {"type": "subtitle", "time": 26182.83, "timestamp": "07:16:22", "text": "それ。するとスーは「他に誰がいる？」と言った。私はしません"}, {"type": "subtitle", "time": 26186.39, "timestamp": "07:16:26", "text": "知る。ええ、その動画を見ましたよ。私は"}, {"type": "subtitle", "time": 26189.91, "timestamp": "07:16:29", "text": "うわぁ、すごい。私は想像し続けている"}, {"type": "subtitle", "time": 26192.548, "timestamp": "07:16:32", "text": "シナリオ。もし私が彼らの立場だったら、"}, {"type": "subtitle", "time": 26194.91, "timestamp": "07:16:34", "text": "私がそれをやるだろうか？種の"}, {"type": "subtitle", "time": 26202.51, "timestamp": "07:16:42", "text": "さて、私は今何をしていたのだろうか？えっと、私は"}]
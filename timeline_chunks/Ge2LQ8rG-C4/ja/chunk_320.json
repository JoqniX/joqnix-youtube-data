[{"type": "subtitle", "time": 19203.628, "timestamp": "05:20:03", "text": "感嘆疑問文。これ"}, {"type": "subtitle", "time": 19210.43, "timestamp": "05:20:10", "text": "えっと、ストリームを忘れてしまう"}, {"type": "subtitle", "time": 19220.19, "timestamp": "05:20:20", "text": "はい。何が"}, {"type": "subtitle", "time": 19224.07, "timestamp": "05:20:24", "text": "これ？ 7日目。何てことだ。ついに"}, {"type": "subtitle", "time": 19225.47, "timestamp": "05:20:25", "text": "すべて手に入れた"}, {"type": "subtitle", "time": 19230.55, "timestamp": "05:20:30", "text": "もの。 2つ手に入れました。私たちはこれをしなければならない"}, {"type": "subtitle", "time": 19236.51, "timestamp": "05:20:36", "text": "[音楽]"}, {"type": "subtitle", "time": 19239.47, "timestamp": "05:20:39", "text": "もの。わかった。日食"}, {"type": "subtitle", "time": 19243.51, "timestamp": "05:20:43", "text": "錯覚。これには28日間しかありません。私は"}, {"type": "subtitle", "time": 19246.47, "timestamp": "05:20:46", "text": "本当にこれを完全に終わらせなきゃいけないの？"}]
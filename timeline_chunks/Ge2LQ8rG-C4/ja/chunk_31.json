[{"type": "subtitle", "time": 1862.51, "timestamp": "00:31:02", "text": "言語。私にはわからない"}, {"type": "subtitle", "time": 1865.51, "timestamp": "00:31:05", "text": "ヒンディー語。私はあなたたちとだけ話している"}, {"type": "subtitle", "time": 1868.51, "timestamp": "00:31:08", "text": "配信は英語で行います。"}, {"type": "subtitle", "time": 1872.95, "timestamp": "00:31:12", "text": "いいえ。ええ。そして日本語は、"}, {"type": "subtitle", "time": 1874.029, "timestamp": "00:31:14", "text": "私は"}, {"type": "subtitle", "time": 1877.75, "timestamp": "00:31:17", "text": "東京ディズニーランドについて学ぶ。"}, {"type": "subtitle", "time": 1879.71, "timestamp": "00:31:19", "text": "行かなければならない。ああ、"}]
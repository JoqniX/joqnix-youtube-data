[{"type": "subtitle", "time": 24608.788, "timestamp": "06:50:08", "text": "私は正しい場所にいる。あなたは何を"}, {"type": "subtitle", "time": 24611.83, "timestamp": "06:50:11", "text": "平均？え？私には無理だ"}, {"type": "subtitle", "time": 24613.43, "timestamp": "06:50:13", "text": "受け取った。私がそれを受け取ったはずがない。"}, {"type": "subtitle", "time": 24615.51, "timestamp": "06:50:15", "text": "私がそれを受け取ったはずがない。あなたはそうしなければならない"}, {"type": "subtitle", "time": 24617.75, "timestamp": "06:50:17", "text": "隠れてるんだよね？あなたは隠れるでしょう。絶対です"}, {"type": "subtitle", "time": 24620.788, "timestamp": "06:50:20", "text": "隠れているんですよね？時間を飛ばして"}, {"type": "subtitle", "time": 24622.35, "timestamp": "06:50:22", "text": "戻ってくる。"}, {"type": "subtitle", "time": 24624.708, "timestamp": "06:50:24", "text": "多分。あなたがここにいると言ってください。"}, {"type": "subtitle", "time": 24628.07, "timestamp": "06:50:28", "text": "お願いします。君を連れて行かなかったのは分かってるよ"}, {"type": "subtitle", "time": 24629.99, "timestamp": "06:50:29", "text": "まだ受け取っていない胸がある。"}, {"type": "subtitle", "time": 24636.03, "timestamp": "06:50:36", "text": "教えてください。お願いだから、私がそんなことをしていないと言って"}, {"type": "subtitle", "time": 24649.39, "timestamp": "06:50:49", "text": "[音楽]"}, {"type": "subtitle", "time": 24651.23, "timestamp": "06:50:51", "text": "何？待って、"}, {"type": "subtitle", "time": 24654.15, "timestamp": "06:50:54", "text": "いいえ。彼はそうすべきではないと思う"}, {"type": "subtitle", "time": 24655.07, "timestamp": "06:50:55", "text": "スポーン"}, {"type": "subtitle", "time": 24657.628, "timestamp": "06:50:57", "text": "そこには。これは隠された"}]
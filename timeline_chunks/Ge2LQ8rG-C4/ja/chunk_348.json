[{"type": "subtitle", "time": 20880.708, "timestamp": "05:48:00", "text": "知らない人、ゲンシャンで、もし私が"}, {"type": "subtitle", "time": 20883.11, "timestamp": "05:48:03", "text": "イベントクエストか何かをやる場合"}, {"type": "subtitle", "time": 20886.47, "timestamp": "05:48:06", "text": "だって私にはたくさんの個性があるから"}, {"type": "subtitle", "time": 20889.99, "timestamp": "05:48:09", "text": "クエストとストーリークエストとワールドクエスト"}, {"type": "subtitle", "time": 20893.99, "timestamp": "05:48:13", "text": "私の原神では、"}, {"type": "subtitle", "time": 20896.868, "timestamp": "05:48:16", "text": "それらはロックされます。私の探求"}, {"type": "subtitle", "time": 20899.19, "timestamp": "05:48:19", "text": "私がやりたいことは、ロックされるだろうと言うことです"}, {"type": "subtitle", "time": 20902.23, "timestamp": "05:48:22", "text": "NPCは別のミッションにいるか、"}, {"type": "subtitle", "time": 20904.708, "timestamp": "05:48:24", "text": "別の任務で忙しいか、"}, {"type": "subtitle", "time": 20907.11, "timestamp": "05:48:27", "text": "別のクエストか何か。あなたがしなければならない"}, {"type": "subtitle", "time": 20910.548, "timestamp": "05:48:30", "text": "そのクエストに行って、それをやってください、などなど。"}, {"type": "subtitle", "time": 20913.47, "timestamp": "05:48:33", "text": "でもこのゲームは、ああ、なんてことだ、"}, {"type": "subtitle", "time": 20916.27, "timestamp": "05:48:36", "text": "最高。何てことだ。いいえ"}, {"type": "subtitle", "time": 20918.35, "timestamp": "05:48:38", "text": "方法。いいえ"}, {"type": "subtitle", "time": 20924.47, "timestamp": "05:48:44", "text": "方法。でも、ちょっと混乱しています。私は私は"}, {"type": "subtitle", "time": 20926.19, "timestamp": "05:48:46", "text": "やはり怪しい"}, {"type": "subtitle", "time": 20931.948, "timestamp": "05:48:51", "text": "選択肢は？"}, {"type": "subtitle", "time": 20935.27, "timestamp": "05:48:55", "text": "N 私が想像している通りだといいのですが"}]
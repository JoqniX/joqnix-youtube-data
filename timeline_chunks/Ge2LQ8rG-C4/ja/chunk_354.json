[{"type": "subtitle", "time": 21241.67, "timestamp": "05:54:01", "text": "事前に手配した場所か、それとも"}, {"type": "subtitle", "time": 21245.11, "timestamp": "05:54:05", "text": "現在のことについて話す"}, {"type": "subtitle", "time": 21247.67, "timestamp": "05:54:07", "text": "食料品のこと、わからない、わからない、"}, {"type": "subtitle", "time": 21250.91, "timestamp": "05:54:10", "text": "私が意味不明なことを言っていると思わないでください"}, {"type": "subtitle", "time": 21254.628, "timestamp": "05:54:14", "text": "ああ、でも、おそらく彼らが"}, {"type": "subtitle", "time": 21256.628, "timestamp": "05:54:16", "text": "これらのゲームがやることは、"}, {"type": "subtitle", "time": 21259.35, "timestamp": "05:54:19", "text": "原神のやつだと思うんだけど、たぶんこんな感じかな"}, {"type": "subtitle", "time": 21262.15, "timestamp": "05:54:22", "text": "キャラクターが忙しいと言って"}, {"type": "subtitle", "time": 21265.67, "timestamp": "05:54:25", "text": "設定されたクエストとして、私は完了を見つけなければなりません"}, {"type": "subtitle", "time": 21268.628, "timestamp": "05:54:28", "text": "そうすれば私は"}, {"type": "subtitle", "time": 21272.59, "timestamp": "05:54:32", "text": "彼女はNPCだった"}, {"type": "subtitle", "time": 21277.35, "timestamp": "05:54:37", "text": "使用済み。ああ、それは車だけど、それでもあなたは"}, {"type": "subtitle", "time": 21280.15, "timestamp": "05:54:40", "text": "もし私が好きになれる方法があれば知りたい"}, {"type": "subtitle", "time": 21283.43, "timestamp": "05:54:43", "text": "完了したいクエストを選択してください"}, {"type": "subtitle", "time": 21290.23, "timestamp": "05:54:50", "text": "うん、それはいいと思うよ。しかし"}, {"type": "subtitle", "time": 21293.868, "timestamp": "05:54:53", "text": "それは少し面倒だろうね。例えば"}, {"type": "subtitle", "time": 21297.27, "timestamp": "05:54:57", "text": "予定通りサンホと会うなら"}, {"type": "subtitle", "time": 21299.27, "timestamp": "05:54:59", "text": "ジンショーのサンホに会い、"}]
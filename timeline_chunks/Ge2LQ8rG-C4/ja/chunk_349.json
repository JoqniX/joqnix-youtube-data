[{"type": "subtitle", "time": 20941.51, "timestamp": "05:49:01", "text": "クエスト。わからない。私はそう感じます"}, {"type": "subtitle", "time": 20943.708, "timestamp": "05:49:03", "text": "これは違う。"}, {"type": "subtitle", "time": 20946.948, "timestamp": "05:49:06", "text": "待って、そうは思わない"}, {"type": "subtitle", "time": 20954.43, "timestamp": "05:49:14", "text": "言った。あ、待って。置かせてください"}, {"type": "subtitle", "time": 20973.07, "timestamp": "05:49:33", "text": "底はこんな感じです。わかった。うん、それだよ"}, {"type": "subtitle", "time": 20976.948, "timestamp": "05:49:36", "text": "は。これについて質問してもよろしいでしょうか？"}, {"type": "subtitle", "time": 20979.19, "timestamp": "05:49:39", "text": "あなたがここにいるということは、そういうことなのですか？"}, {"type": "subtitle", "time": 20981.23, "timestamp": "05:49:41", "text": "参加"}, {"type": "subtitle", "time": 20985.628, "timestamp": "05:49:45", "text": "キャビンその他ご興味ありますか？"}, {"type": "subtitle", "time": 20988.15, "timestamp": "05:49:48", "text": "その場所の機密情報であれば"}, {"type": "subtitle", "time": 20989.948, "timestamp": "05:49:49", "text": "ママ、一人で来てくれる？"}]
[{"type": "subtitle", "time": 20041.35, "timestamp": "05:34:01", "text": "ロブ、君はレベルアップしてるの？そのため"}, {"type": "subtitle", "time": 20044.628, "timestamp": "05:34:04", "text": "夢の鏡みたいなやつだよね？だって私には必要なんだ"}, {"type": "subtitle", "time": 20048.628, "timestamp": "05:34:08", "text": "ローバーも同様にレベルアップさせる。"}, {"type": "subtitle", "time": 20049.52, "timestamp": "05:34:09", "text": "確かに、確かに、確かに、確かに、確かに、確かに、確かに、確かに 確かに、確かに、確かに、確かに、確かに、確かに、確かに、確かに"}, {"type": "subtitle", "time": 20049.84, "timestamp": "05:34:09", "text": "確かに、確かに、確かに、確かに、確かに、確かに、確かに、確かに もちろんです"}, {"type": "subtitle", "time": 20061.75, "timestamp": "05:34:21", "text": "ああ、これは今までで最高の武器だ"}, {"type": "subtitle", "time": 20072.708, "timestamp": "05:34:32", "text": "物語を進める必要がある瞬間"}, {"type": "subtitle", "time": 20078.19, "timestamp": "05:34:38", "text": "そしてローバー、いや、ハボックローバーを手に入れろ"}, {"type": "subtitle", "time": 20082.43, "timestamp": "05:34:42", "text": "ええ、最高のroクラスまたは"}, {"type": "subtitle", "time": 20090.51, "timestamp": "05:34:50", "text": "何か。私はもっ​​とそうしたい"}, {"type": "subtitle", "time": 20093.83, "timestamp": "05:34:53", "text": "挽く。つまり、2人のキャラクターがレベル60だ。"}, {"type": "subtitle", "time": 20096.99, "timestamp": "05:34:56", "text": "そのうちの1人はレベル50です。"}]
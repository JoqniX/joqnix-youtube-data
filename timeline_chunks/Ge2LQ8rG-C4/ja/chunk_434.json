[{"type": "subtitle", "time": 26040.07, "timestamp": "07:14:00", "text": "この説明は、重要なのはあなたです"}, {"type": "subtitle", "time": 26042.27, "timestamp": "07:14:02", "text": "家族だと理解してください。ああ、そうだそうだ"}, {"type": "subtitle", "time": 26062.39, "timestamp": "07:14:22", "text": "家族が、ある日兄弟が"}, {"type": "subtitle", "time": 26064.708, "timestamp": "07:14:24", "text": "結婚して泣くことになるだろうから"}, {"type": "subtitle", "time": 26069.83, "timestamp": "07:14:29", "text": "いや、私のシンは、彼らは"}, {"type": "subtitle", "time": 26074.75, "timestamp": "07:14:34", "text": "誰かが私のものを奪おうとしている"}, {"type": "subtitle", "time": 26078.868, "timestamp": "07:14:38", "text": "そんな風に愛して、"}, {"type": "subtitle", "time": 26082.43, "timestamp": "07:14:42", "text": "パートナーはこう思う"}, {"type": "subtitle", "time": 26085.59, "timestamp": "07:14:45", "text": "もしあなたが私の面倒を見てくれないなら"}, {"type": "subtitle", "time": 26088.15, "timestamp": "07:14:48", "text": "船積みはうまくいったので、あなたを見つけます。"}, {"type": "subtitle", "time": 26092.23, "timestamp": "07:14:52", "text": "まるであの霊のように君に取り憑くつもりだよ、相棒"}, {"type": "subtitle", "time": 26099.628, "timestamp": "07:14:59", "text": "わかってるけど、そう、こんな感じ"}]
[{"type": "subtitle", "time": 20525.59, "timestamp": "05:42:05", "text": "もっと。ああ、日課は終わったよ。"}, {"type": "subtitle", "time": 20557.35, "timestamp": "05:42:37", "text": "お店とかありますか？待って、"}, {"type": "subtitle", "time": 20560.43, "timestamp": "05:42:40", "text": "店があるはずだ、"}, {"type": "subtitle", "time": 20563.11, "timestamp": "05:42:43", "text": "右？ちょっと待って。があるべきだ"}]
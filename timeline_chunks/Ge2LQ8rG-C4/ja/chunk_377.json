[{"type": "subtitle", "time": 22620.788, "timestamp": "06:17:00", "text": "13. おそらく私は"}, {"type": "subtitle", "time": 22624.628, "timestamp": "06:17:04", "text": "ここ。上限は設けません。ここで足止めされる"}, {"type": "subtitle", "time": 22627.948, "timestamp": "06:17:07", "text": "14. 14から15で詰まるでしょう。私が"}, {"type": "subtitle", "time": 22630.868, "timestamp": "06:17:10", "text": "すべてを手に入れなければならないので行き詰まっています"}, {"type": "subtitle", "time": 22632.81, "timestamp": "06:17:12", "text": "今は紫色になっている。"}, {"type": "subtitle", "time": 22634.708, "timestamp": "06:17:14", "text": "[音楽]"}, {"type": "subtitle", "time": 22666.15, "timestamp": "06:17:46", "text": "ああ、ガイドブックのレベルを上げられるんだ。私"}, {"type": "subtitle", "time": 22667.91, "timestamp": "06:17:47", "text": "忘れた。忘れた。ええと、コースはまさに"}, {"type": "subtitle", "time": 22672.37, "timestamp": "06:17:52", "text": "アルファ5からレベル10。なんてこった。"}, {"type": "subtitle", "time": 22679.868, "timestamp": "06:17:59", "text": "ええと、これは変更できます"}]
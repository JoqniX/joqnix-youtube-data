[{"type": "subtitle", "time": 5471.51, "timestamp": "01:31:11", "text": "シンクに入るか、シンクに沈むかのどちらかです"}, {"type": "subtitle", "time": 5484.31, "timestamp": "01:31:24", "text": "私はここであまり反応を示していません"}, {"type": "subtitle", "time": 5503.27, "timestamp": "01:31:43", "text": "もの。うん。問題は、私が与えていないということです"}, {"type": "subtitle", "time": 5504.87, "timestamp": "01:31:44", "text": "多くの"}, {"type": "subtitle", "time": 5509.229, "timestamp": "01:31:49", "text": "これに対する反応。あなたもそう"}, {"type": "subtitle", "time": 5511.79, "timestamp": "01:31:51", "text": "それは"}]
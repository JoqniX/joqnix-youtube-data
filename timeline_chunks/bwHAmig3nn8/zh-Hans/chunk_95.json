[{"type": "subtitle", "time": 5703.87, "timestamp": "01:35:03", "text": "孔吉"}, {"type": "subtitle", "time": 5708.99, "timestamp": "01:35:08", "text": "你在吃什么？我无法判断那是什么。"}, {"type": "subtitle", "time": 5713.55, "timestamp": "01:35:13", "text": "环境。哦，哦，在超市里切好就行了。"}, {"type": "subtitle", "time": 5717.07, "timestamp": "01:35:17", "text": "我会看视频。哦，让我看看。"}, {"type": "subtitle", "time": 5721.55, "timestamp": "01:35:21", "text": "益。不挂断。日本人。日语，日语，没有日语"}, {"type": "subtitle", "time": 5724.629, "timestamp": "01:35:24", "text": "。哈哈。嗯，它是日语的。抱歉，我说的是日语。"}, {"type": "subtitle", "time": 5731.07, "timestamp": "01:35:31", "text": "。但我智能手机的后置摄像头"}, {"type": "subtitle", "time": 5733.31, "timestamp": "01:35:33", "text": "打开它"}, {"type": "subtitle", "time": 5738.109, "timestamp": "01:35:38", "text": "给我展示一下直播内容。"}, {"type": "subtitle", "time": 5743.39, "timestamp": "01:35:43", "text": "他们会给你的。等等，等等。谢谢你送的车。"}, {"type": "subtitle", "time": 5745.79, "timestamp": "01:35:45", "text": "啊，"}, {"type": "subtitle", "time": 5748.35, "timestamp": "01:35:48", "text": "汽车机械。"}, {"type": "subtitle", "time": 5751.35, "timestamp": "01:35:51", "text": "那"}, {"type": "chat", "time": 5754.135, "timestamp": "01:35:54", "author": "@hbvcsa", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mA5iYFWQWr-erQfOrpRSPi7uAL1ykOBKRSbPBDp88Z1xyBT7Je5IKp6_AckwgwsDEc-Q=s64-c-k-c0x00ffffff-no-rj", "message": "Did you passed N4"}]
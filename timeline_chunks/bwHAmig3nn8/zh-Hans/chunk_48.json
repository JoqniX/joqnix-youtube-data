[{"type": "subtitle", "time": 2892.349, "timestamp": "00:48:12", "text": "我的天哪，太疯狂了，才过了3个小时"}, {"type": "subtitle", "time": 2898.109, "timestamp": "00:48:18", "text": "我现在要睡觉了，这样不好吗？"}, {"type": "subtitle", "time": 2908.309, "timestamp": "00:48:28", "text": "这大概是星期一吧。"}, {"type": "subtitle", "time": 2910.589, "timestamp": "00:48:30", "text": "星期二和"}, {"type": "subtitle", "time": 2912.309, "timestamp": "00:48:32", "text": "周四"}, {"type": "subtitle", "time": 2917.95, "timestamp": "00:48:37", "text": "是吗？我不知道。真的很难。这"}, {"type": "subtitle", "time": 2925.309, "timestamp": "00:48:45", "text": "二月里没有二月这种说法。啊，这大概是……"}, {"type": "subtitle", "time": 2928.99, "timestamp": "00:48:48", "text": "啊，这，这，这门课程是"}, {"type": "subtitle", "time": 2930.63, "timestamp": "00:48:50", "text": "也许"}, {"type": "subtitle", "time": 2933.95, "timestamp": "00:48:53", "text": "啊，大概是吧。"}, {"type": "subtitle", "time": 2935.789, "timestamp": "00:48:55", "text": "2个月"}, {"type": "subtitle", "time": 2939.47, "timestamp": "00:48:59", "text": "仅有的。仅两个月。是的，是的，是的。 2"}]
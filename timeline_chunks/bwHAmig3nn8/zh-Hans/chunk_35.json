[{"type": "subtitle", "time": 2128.51, "timestamp": "00:35:28", "text": "夜里，哦，夜里，就一点点，哦，当外面下着雨的时候"}, {"type": "subtitle", "time": 2133.43, "timestamp": "00:35:33", "text": "我带妈妈出去散步，还做了个直播。"}, {"type": "subtitle", "time": 2140.71, "timestamp": "00:35:40", "text": "我想解释一下我的思考方式以及如何表达它。"}, {"type": "subtitle", "time": 2144.87, "timestamp": "00:35:44", "text": "斯塔"}, {"type": "subtitle", "time": 2146.55, "timestamp": "00:35:46", "text": "啊"}, {"type": "subtitle", "time": 2148.15, "timestamp": "00:35:48", "text": "，"}, {"type": "subtitle", "time": 2153.51, "timestamp": "00:35:53", "text": "哦，‘遥远’到底是什么意思来着？"}, {"type": "subtitle", "time": 2156.63, "timestamp": "00:35:56", "text": "我忘了。"}]
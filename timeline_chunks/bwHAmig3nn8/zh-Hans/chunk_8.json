[{"type": "subtitle", "time": 480.55, "timestamp": "00:08:00", "text": "例如，Kerukaru，或者哦，Kerkar 或 Devil"}, {"type": "subtitle", "time": 483.23, "timestamp": "00:08:03", "text": "因为卡尔不在"}, {"type": "subtitle", "time": 487.629, "timestamp": "00:08:07", "text": "我不知道该怎么支付这笔费用了。"}, {"type": "subtitle", "time": 492.43, "timestamp": "00:08:12", "text": "那会很麻烦。这就是我的意思。"}, {"type": "subtitle", "time": 495.909, "timestamp": "00:08:15", "text": "我完全不明白。哦，我的学校。"}, {"type": "subtitle", "time": 497.35, "timestamp": "00:08:17", "text": "我的天啊，挡住我的雨伞"}, {"type": "subtitle", "time": 501.11, "timestamp": "00:08:21", "text": "又来了？这是什么？我的，啊"}, {"type": "subtitle", "time": 504.07, "timestamp": "00:08:24", "text": "，我的"}, {"type": "subtitle", "time": 509.99, "timestamp": "00:08:29", "text": "这家银行是由学校创建的。我的银行账户"}, {"type": "subtitle", "time": 512.75, "timestamp": "00:08:32", "text": "银行总裁"}, {"type": "subtitle", "time": 515.23, "timestamp": "00:08:35", "text": "是吗？我不知道。他是JP的老板吗？"}, {"type": "subtitle", "time": 521.029, "timestamp": "00:08:41", "text": "是的，这是一个故事，但其实很简单。"}, {"type": "subtitle", "time": 524.35, "timestamp": "00:08:44", "text": "现在那个收银员拿到钱了。"}, {"type": "subtitle", "time": 528.07, "timestamp": "00:08:48", "text": "但这位现金女孩"}, {"type": "subtitle", "time": 531.829, "timestamp": "00:08:51", "text": "啊，不是卡西女孩，而是大卫·柯尔"}, {"type": "subtitle", "time": 533.43, "timestamp": "00:08:53", "text": "但"}, {"type": "subtitle", "time": 535.63, "timestamp": "00:08:55", "text": "须川"}, {"type": "subtitle", "time": 539.63, "timestamp": "00:08:59", "text": "“一切都不会改变，”老师说。"}]
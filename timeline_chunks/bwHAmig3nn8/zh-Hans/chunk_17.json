[{"type": "subtitle", "time": 1023.389, "timestamp": "00:17:03", "text": "我通过电子邮件发送了这些信息。啊"}, {"type": "subtitle", "time": 1032.829, "timestamp": "00:17:12", "text": "我把它送达了。"}, {"type": "subtitle", "time": 1040.51, "timestamp": "00:17:20", "text": "啊，我已经把它拿出来了。"}, {"type": "subtitle", "time": 1044.789, "timestamp": "00:17:24", "text": "嗯，其实不是，哦，今天用的是PayPal。"}, {"type": "subtitle", "time": 1049.59, "timestamp": "00:17:29", "text": "今天客服人员，啊，这封邮件"}, {"type": "subtitle", "time": 1054.15, "timestamp": "00:17:34", "text": "我看到了，并回复了。呃，"}, {"type": "subtitle", "time": 1058.15, "timestamp": "00:17:38", "text": "哦，这个，这个，这个，这些，这些，"}, {"type": "subtitle", "time": 1062.63, "timestamp": "00:17:42", "text": "啊，你的意思是，啊，你的"}, {"type": "subtitle", "time": 1069.15, "timestamp": "00:17:49", "text": "名字里有个空格，请重复一遍。"}, {"type": "subtitle", "time": 1071.31, "timestamp": "00:17:51", "text": "啊"}, {"type": "subtitle", "time": 1079.75, "timestamp": "00:17:59", "text": "这样一来，名称中就没有空格了。"}]
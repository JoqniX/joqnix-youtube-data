[{"type": "subtitle", "time": 2522.51, "timestamp": "00:42:02", "text": "这种事不会发生。"}, {"type": "subtitle", "time": 2527.51, "timestamp": "00:42:07", "text": "我不知道为什么，但我忘记了。"}, {"type": "subtitle", "time": 2534.43, "timestamp": "00:42:14", "text": "有人在看着"}, {"type": "subtitle", "time": 2549.63, "timestamp": "00:42:29", "text": "我的用词和说话时的声音有点"}, {"type": "subtitle", "time": 2553.91, "timestamp": "00:42:33", "text": "我想你应该能听到。糟糕的。这"}, {"type": "subtitle", "time": 2557.99, "timestamp": "00:42:37", "text": "我感到很尴尬。我为什么会在这里？"}, {"type": "subtitle", "time": 2561.91, "timestamp": "00:42:41", "text": "现在。哦真的吗？"}, {"type": "subtitle", "time": 2575.91, "timestamp": "00:42:55", "text": "嘈杂。"}]
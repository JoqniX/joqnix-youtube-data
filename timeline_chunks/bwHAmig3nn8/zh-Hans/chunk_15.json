[{"type": "subtitle", "time": 900.11, "timestamp": "00:15:00", "text": "但我不会使用它。我不知道。"}, {"type": "subtitle", "time": 904.31, "timestamp": "00:15:04", "text": "我想用“我该怎么办？”这句话。但我用不了。"}, {"type": "subtitle", "time": 909.35, "timestamp": "00:15:09", "text": "没有。现在没有LeBet女孩了"}, {"type": "subtitle", "time": 912.949, "timestamp": "00:15:12", "text": "我可以用PayPay，但是也不行。这"}, {"type": "subtitle", "time": 918.87, "timestamp": "00:15:18", "text": "你不能使用PayPay。这个愚蠢的我"}, {"type": "subtitle", "time": 923.99, "timestamp": "00:15:23", "text": "名字嘛，真名就是真名。"}, {"type": "subtitle", "time": 929.43, "timestamp": "00:15:29", "text": "这里有空间，还有磨坊的名字"}, {"type": "subtitle", "time": 932.67, "timestamp": "00:15:32", "text": "尼托尼亚，还有空间，这个"}, {"type": "subtitle", "time": 937.23, "timestamp": "00:15:37", "text": "存在间距问题。"}, {"type": "subtitle", "time": 939.47, "timestamp": "00:15:39", "text": "我吃饱了"}, {"type": "subtitle", "time": 944.67, "timestamp": "00:15:44", "text": "我试过了。去银行，把它剪下来，"}, {"type": "subtitle", "time": 949.749, "timestamp": "00:15:49", "text": "我把这件事告诉了这里的老师们。"}, {"type": "subtitle", "time": 954.23, "timestamp": "00:15:54", "text": "没人知道该怎么解决这个问题。"}, {"type": "subtitle", "time": 958.55, "timestamp": "00:15:58", "text": "是的，那很好。还有PayPay。"}]
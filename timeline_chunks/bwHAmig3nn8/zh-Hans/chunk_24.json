[{"type": "subtitle", "time": 1441.31, "timestamp": "00:24:01", "text": "是的。下一个话题是，你知道，最近。"}, {"type": "subtitle", "time": 1447.909, "timestamp": "00:24:07", "text": "我最近一直在听这位歌手的音乐。"}, {"type": "subtitle", "time": 1454.35, "timestamp": "00:24:14", "text": "我经常一边做其他事一边唱歌。地址"}, {"type": "subtitle", "time": 1460.31, "timestamp": "00:24:20", "text": "我想她的名字是科哈娜·拉姆。"}, {"type": "subtitle", "time": 1462.23, "timestamp": "00:24:22", "text": "科哈拉姆"}, {"type": "subtitle", "time": 1470.23, "timestamp": "00:24:30", "text": "每次听你的歌，我都会觉得心情很好。"}, {"type": "subtitle", "time": 1472.269, "timestamp": "00:24:32", "text": "边听边听"}, {"type": "subtitle", "time": 1476.95, "timestamp": "00:24:36", "text": "就用假声唱一点点。"}, {"type": "subtitle", "time": 1478.99, "timestamp": "00:24:38", "text": "中音"}, {"type": "subtitle", "time": 1483.95, "timestamp": "00:24:43", "text": "我会用我的嗓子唱一小段歌。一个，"}, {"type": "subtitle", "time": 1488.07, "timestamp": "00:24:48", "text": "我总是唱歌。我在做一份兼职工作。"}, {"type": "subtitle", "time": 1489.51, "timestamp": "00:24:49", "text": "啊。"}]
[{"type": "subtitle", "time": 4141.309, "timestamp": "01:09:01", "text": "啊，倒也未必。"}, {"type": "subtitle", "time": 4144.59, "timestamp": "01:09:04", "text": "因为没有点击量。"}, {"type": "subtitle", "time": 4150.309, "timestamp": "01:09:10", "text": "我，哦，这声音，哦，触摸，哦，本吉"}, {"type": "subtitle", "time": 4154.709, "timestamp": "01:09:14", "text": "我的脚现在很疼，因为我摸得太多了。"}, {"type": "subtitle", "time": 4156.59, "timestamp": "01:09:16", "text": "哟。"}, {"type": "subtitle", "time": 4158.709, "timestamp": "01:09:18", "text": "哇，"}, {"type": "subtitle", "time": 4161.59, "timestamp": "01:09:21", "text": "奇怪的。"}, {"type": "subtitle", "time": 4169.47, "timestamp": "01:09:29", "text": "哦，完全不是。"}, {"type": "subtitle", "time": 4171.59, "timestamp": "01:09:31", "text": "牙齿"}, {"type": "subtitle", "time": 4177.47, "timestamp": "01:09:37", "text": "我的脚开始疼了。嘿，为什么？"}, {"type": "subtitle", "time": 4190.229, "timestamp": "01:09:50", "text": "。"}, {"type": "subtitle", "time": 4199.07, "timestamp": "01:09:59", "text": "电剑。是的。第八。今天，今天，"}]
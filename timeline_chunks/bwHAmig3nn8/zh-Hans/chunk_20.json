[{"type": "subtitle", "time": 1201.95, "timestamp": "00:20:01", "text": "现在就连每张纸之间的空白区域都用特殊颜色进行了着色。"}, {"type": "subtitle", "time": 1205.95, "timestamp": "00:20:05", "text": "写名字时，不要留空格。"}, {"type": "subtitle", "time": 1211.39, "timestamp": "00:20:11", "text": "即使没有手，这也是"}, {"type": "subtitle", "time": 1213.07, "timestamp": "00:20:13", "text": "身份识别"}, {"type": "subtitle", "time": 1216.35, "timestamp": "00:20:16", "text": "哈"}, {"type": "subtitle", "time": 1222.47, "timestamp": "00:20:22", "text": "如果这种情况发生，那么这些数据"}, {"type": "subtitle", "time": 1230.35, "timestamp": "00:20:30", "text": "查看数据时，请注意这个名字"}, {"type": "subtitle", "time": 1236.669, "timestamp": "00:20:36", "text": "嘿，凯伦的名字，嗯，是用片假名写的。"}, {"type": "subtitle", "time": 1240.31, "timestamp": "00:20:40", "text": "里面有个空格。但我有空间"}, {"type": "subtitle", "time": 1242.549, "timestamp": "00:20:42", "text": "不包含在内。啊，是的。"}, {"type": "subtitle", "time": 1247.549, "timestamp": "00:20:47", "text": "那张图里没地方了，所以就到这里吧。"}, {"type": "subtitle", "time": 1252.99, "timestamp": "00:20:52", "text": "我买的时候说是PayPay的问题。"}, {"type": "subtitle", "time": 1257.909, "timestamp": "00:20:57", "text": "哦，我把它拿出来了。我已经提交了。发送"}]
[{"type": "subtitle", "time": 368.15, "timestamp": "00:06:08", "text": "或者。啊，日元"}, {"type": "subtitle", "time": 373.23, "timestamp": "00:06:13", "text": "我也这么认为。这是棉兰的这栋房子。这是正确的。"}, {"type": "subtitle", "time": 378.029, "timestamp": "00:06:18", "text": "嘿。这块蛋奶冻我没法再用了。"}, {"type": "subtitle", "time": 382.27, "timestamp": "00:06:22", "text": "哟。这是奇怪的蛋奶冻"}, {"type": "subtitle", "time": 384.749, "timestamp": "00:06:24", "text": "但这有点过头了。"}, {"type": "subtitle", "time": 391.95, "timestamp": "00:06:31", "text": "应该没问题。是的。是的。今天"}, {"type": "subtitle", "time": 394.749, "timestamp": "00:06:34", "text": "今天。哦，是的，是的，是的。哦，我忘了。"}, {"type": "subtitle", "time": 398.23, "timestamp": "00:06:38", "text": "我正在给你讲这个故事。是的。今天"}, {"type": "subtitle", "time": 410.23, "timestamp": "00:06:50", "text": "我那时才意识到，我的，我的"}, {"type": "subtitle", "time": 413.23, "timestamp": "00:06:53", "text": "我没有 我有"}, {"type": "subtitle", "time": 416.23, "timestamp": "00:06:56", "text": "嗯？啊，"}]
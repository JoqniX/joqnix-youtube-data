[{"type": "subtitle", "time": 2580.15, "timestamp": "00:43:00", "text": "我觉得我的声音不算太大。"}, {"type": "subtitle", "time": 2583.67, "timestamp": "00:43:03", "text": "。对不起。并不真地"}, {"type": "subtitle", "time": 2587.069, "timestamp": "00:43:07", "text": "哦，我不太会说话。"}, {"type": "subtitle", "time": 2589.109, "timestamp": "00:43:09", "text": "雨。"}, {"type": "subtitle", "time": 2592.67, "timestamp": "00:43:12", "text": "是的。我今天回家"}, {"type": "subtitle", "time": 2594.39, "timestamp": "00:43:14", "text": "普罗"}, {"type": "subtitle", "time": 2597.03, "timestamp": "00:43:17", "text": "我来做 Après。"}, {"type": "subtitle", "time": 2601.589, "timestamp": "00:43:21", "text": "今天真是太难熬了。今天我收到了很多"}, {"type": "subtitle", "time": 2605.23, "timestamp": "00:43:25", "text": "今天的早餐"}, {"type": "subtitle", "time": 2611.43, "timestamp": "00:43:31", "text": "我只吃了一点，所以今天感觉很好。"}, {"type": "subtitle", "time": 2616.15, "timestamp": "00:43:36", "text": "我完成了这项工作。去做，去做。"}, {"type": "subtitle", "time": 2621.589, "timestamp": "00:43:41", "text": "我做了。是的。但是，呃，在学校里"}, {"type": "subtitle", "time": 2627.87, "timestamp": "00:43:47", "text": "我去的时候，正在上课。"}, {"type": "subtitle", "time": 2632.79, "timestamp": "00:43:52", "text": "我当时真的好困好困。"}, {"type": "subtitle", "time": 2638.23, "timestamp": "00:43:58", "text": "我睡了很多觉。但这一切都取决于口味。"}]
[{"type": "subtitle", "time": 963.23, "timestamp": "00:16:03", "text": "但这很奇怪。为什么，为什么？"}, {"type": "subtitle", "time": 966.91, "timestamp": "00:16:06", "text": "难道没有工作人员吗？为什么？"}, {"type": "subtitle", "time": 972.79, "timestamp": "00:16:12", "text": "永远都只是人工智能聊天，仅此而已。"}, {"type": "subtitle", "time": 975.47, "timestamp": "00:16:15", "text": "然后，昨天"}, {"type": "subtitle", "time": 979.71, "timestamp": "00:16:19", "text": "是昨天吗？今天是星期一，对吧？在星期天"}, {"type": "subtitle", "time": 981.71, "timestamp": "00:16:21", "text": "我，"}, {"type": "subtitle", "time": 985.11, "timestamp": "00:16:25", "text": "星期天，我"}, {"type": "subtitle", "time": 987.35, "timestamp": "00:16:27", "text": "支付"}, {"type": "subtitle", "time": 995.749, "timestamp": "00:16:35", "text": "找到该电子邮件地址，并通过电子邮件将其发送给我，以便我了解此问题。"}, {"type": "subtitle", "time": 999.389, "timestamp": "00:16:39", "text": "我指的是我名字的间距。"}, {"type": "subtitle", "time": 1002.749, "timestamp": "00:16:42", "text": "啊，"}, {"type": "subtitle", "time": 1007.59, "timestamp": "00:16:47", "text": "那是什么来着？ KYC是什么来着？哦，"}, {"type": "subtitle", "time": 1010.67, "timestamp": "00:16:50", "text": "日语有点难，但是"}, {"type": "subtitle", "time": 1013.71, "timestamp": "00:16:53", "text": "我忘了。但我说的是KYC（了解你的客户）。"}, {"type": "subtitle", "time": 1016.79, "timestamp": "00:16:56", "text": "但请这样做"}, {"type": "chat", "time": 1019.627, "timestamp": "00:16:59", "author": "@MikazukiYure", "avatar": "https://yt4.ggpht.com/uuFSD7qVrZy0JUWrBRfSfEKIQpib7_2xP24Yiu1ND1Mq6uhaYIHDnA5EiGz_o33FUhHYvbCT9g=s64-c-k-c0x00ffffff-no-rj", "message": "hmmm"}]
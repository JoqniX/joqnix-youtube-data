[{"type": "subtitle", "time": 2821.91, "timestamp": "00:47:01", "text": "将于上午 11 点和下午 1 点结束。进而，"}, {"type": "subtitle", "time": 2831.99, "timestamp": "00:47:11", "text": "很快，你知道，你就会睡着，然后就到早上了，早上。"}, {"type": "subtitle", "time": 2839.829, "timestamp": "00:47:19", "text": "哦，我凌晨四点就醒了，一直等到一点。"}, {"type": "subtitle", "time": 2842.069, "timestamp": "00:47:22", "text": "如果你睡着了"}, {"type": "subtitle", "time": 2847.109, "timestamp": "00:47:27", "text": "我凌晨四点起床。不挂断。"}, {"type": "subtitle", "time": 2850.39, "timestamp": "00:47:30", "text": "时间不多了"}, {"type": "subtitle", "time": 2852.27, "timestamp": "00:47:32", "text": "啊，"}, {"type": "subtitle", "time": 2854.512, "timestamp": "00:47:34", "text": "等等，等等，等等，等等，等等。"}, {"type": "subtitle", "time": 2878.093, "timestamp": "00:47:58", "text": "我的天哪。"}, {"type": "subtitle", "time": 2878.309, "timestamp": "00:47:58", "text": "[嗤笑]"}]
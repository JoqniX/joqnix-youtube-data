[{"type": "subtitle", "time": 1384.83, "timestamp": "00:23:04", "text": "。我当时想，“这样做，这样做，文字，文字”"}, {"type": "subtitle", "time": 1388.63, "timestamp": "00:23:08", "text": "总有一天你可以慢慢地做到。"}, {"type": "subtitle", "time": 1394.35, "timestamp": "00:23:14", "text": "我希望我说的没错"}, {"type": "subtitle", "time": 1395.47, "timestamp": "00:23:15", "text": "可以理解"}, {"type": "subtitle", "time": 1397.71, "timestamp": "00:23:17", "text": "你们。"}, {"type": "subtitle", "time": 1399.71, "timestamp": "00:23:19", "text": "一个，"}, {"type": "subtitle", "time": 1408.99, "timestamp": "00:23:28", "text": "不，我不经常使用英语。今天在日本"}, {"type": "subtitle", "time": 1414.87, "timestamp": "00:23:34", "text": "这是一段日语对话。只是闲聊。"}, {"type": "subtitle", "time": 1416.83, "timestamp": "00:23:36", "text": "我同意。"}, {"type": "subtitle", "time": 1421.75, "timestamp": "00:23:41", "text": "这将切换到下一个特价优惠。"}, {"type": "subtitle", "time": 1425.99, "timestamp": "00:23:45", "text": "我们是在讨论 Clouty 吗？哦，是的，但是……"}, {"type": "subtitle", "time": 1430.19, "timestamp": "00:23:50", "text": "但事实并非如此。这是一个令人自豪的故事。"}, {"type": "subtitle", "time": 1433.43, "timestamp": "00:23:53", "text": "就是之前提到的那位托佩克。好的"}, {"type": "subtitle", "time": 1435.75, "timestamp": "00:23:55", "text": "。"}]
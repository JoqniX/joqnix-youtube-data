[{"type": "subtitle", "time": 720.629, "timestamp": "00:12:00", "text": "我刚才说到哪儿了？"}, {"type": "subtitle", "time": 724.069, "timestamp": "00:12:04", "text": "难道不是吗？现在。是的。刚才，刚才"}, {"type": "subtitle", "time": 729.069, "timestamp": "00:12:09", "text": "我不会忘记这些话。是的。早些时候"}, {"type": "subtitle", "time": 736.509, "timestamp": "00:12:16", "text": "你想聊什么？我们来谈谈吧。我们聊了聊。"}, {"type": "subtitle", "time": 740.87, "timestamp": "00:12:20", "text": "你当时在做什么？"}, {"type": "subtitle", "time": 743.75, "timestamp": "00:12:23", "text": "我去了吗？唔？我去了吗？是的。"}, {"type": "subtitle", "time": 748.55, "timestamp": "00:12:28", "text": "是吗？是的。日语越来越难了。"}, {"type": "subtitle", "time": 753.43, "timestamp": "00:12:33", "text": "已经。是的。那是什么来着？"}, {"type": "subtitle", "time": 757.35, "timestamp": "00:12:37", "text": "这真是太麻烦了。哦，我自己的，我自己的"}, {"type": "subtitle", "time": 760.55, "timestamp": "00:12:40", "text": "不，它已经不是信用卡了。"}, {"type": "subtitle", "time": 765.43, "timestamp": "00:12:45", "text": "。这个栗子不好。这真的很难。"}, {"type": "subtitle", "time": 770.59, "timestamp": "00:12:50", "text": "事情最终会变成这样。如果你卷发过度……"}, {"type": "subtitle", "time": 774.31, "timestamp": "00:12:54", "text": "我认为情况变得非常困难。这"}, {"type": "subtitle", "time": 777.35, "timestamp": "00:12:57", "text": "它太硬。"}]
[{"type": "subtitle", "time": 3073.589, "timestamp": "00:51:13", "text": "叹。不挂断。现在能听到我说话吗？是的。"}, {"type": "subtitle", "time": 3077.069, "timestamp": "00:51:17", "text": "我想你能听到我说话。"}, {"type": "subtitle", "time": 3084.71, "timestamp": "00:51:24", "text": "是的。在印度，工作日从早上 8 点开始，而时钟离我们很远。"}, {"type": "subtitle", "time": 3089.71, "timestamp": "00:51:29", "text": "现在是晚上8点。啊，"}, {"type": "subtitle", "time": 3092.47, "timestamp": "00:51:32", "text": "当时是晚上8点。"}, {"type": "subtitle", "time": 3102.63, "timestamp": "00:51:42", "text": "11点钟会发生什么？"}, {"type": "subtitle", "time": 3107.47, "timestamp": "00:51:47", "text": "不挂断。现在是11点钟，对吧？"}, {"type": "subtitle", "time": 3119.15, "timestamp": "00:51:59", "text": "叹。"}]
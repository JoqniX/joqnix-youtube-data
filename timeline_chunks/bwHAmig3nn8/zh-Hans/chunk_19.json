[{"type": "subtitle", "time": 1142.75, "timestamp": "00:19:02", "text": "哦，等等。一个。我在聊天记录里写的"}, {"type": "subtitle", "time": 1147.789, "timestamp": "00:19:07", "text": "我其实不做那种事。"}, {"type": "subtitle", "time": 1152.11, "timestamp": "00:19:12", "text": "这不是真正的我，乔们。写"}, {"type": "subtitle", "time": 1156.59, "timestamp": "00:19:16", "text": "我的日语写作能力不太好，所以……"}, {"type": "subtitle", "time": 1163.07, "timestamp": "00:19:23", "text": "我没有练习过，所以这有点难，所以我就……"}, {"type": "subtitle", "time": 1165.71, "timestamp": "00:19:25", "text": "在这封邮件中，我"}, {"type": "subtitle", "time": 1172.35, "timestamp": "00:19:32", "text": "我说过了。啊，我的欲望，啊，"}, {"type": "subtitle", "time": 1174.35, "timestamp": "00:19:34", "text": "我有很多次"}, {"type": "subtitle", "time": 1178.99, "timestamp": "00:19:38", "text": "是这样吗？用日语来说，就是 KYC（了解你的客户）。"}, {"type": "subtitle", "time": 1183.47, "timestamp": "00:19:43", "text": "我做了很多那样的事，但是……"}, {"type": "subtitle", "time": 1185.149, "timestamp": "00:19:45", "text": "姓名"}, {"type": "subtitle", "time": 1188.27, "timestamp": "00:19:48", "text": "汽车和MyNaBaka"}, {"type": "subtitle", "time": 1192.27, "timestamp": "00:19:52", "text": "我用NFC扫描了一下，所以……"}, {"type": "subtitle", "time": 1197.149, "timestamp": "00:19:57", "text": "我的名字里有个空格。"}]
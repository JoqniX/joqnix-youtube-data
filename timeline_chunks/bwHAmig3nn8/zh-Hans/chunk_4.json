[{"type": "subtitle", "time": 242.309, "timestamp": "00:04:02", "text": "今天清晨。哦，今天轮到眼睛了。今天，"}, {"type": "subtitle", "time": 245.47, "timestamp": "00:04:05", "text": "我直播结束得有点早了。一个，"}, {"type": "subtitle", "time": 248.50900000000001, "timestamp": "00:04:08", "text": "我觉得是时候结束这件事了。是的，"}, {"type": "subtitle", "time": 250.75, "timestamp": "00:04:10", "text": "哦，是的。"}, {"type": "subtitle", "time": 253.19, "timestamp": "00:04:13", "text": "是的。嗯，我希望我是"}, {"type": "subtitle", "time": 254.50900000000001, "timestamp": "00:04:14", "text": "可听见的"}, {"type": "subtitle", "time": 257.069, "timestamp": "00:04:17", "text": "就像在下雨一样"}, {"type": "subtitle", "time": 258.909, "timestamp": "00:04:18", "text": "现在很像"}, {"type": "subtitle", "time": 260.59, "timestamp": "00:04:20", "text": "斯普林格斯"}, {"type": "subtitle", "time": 265.749, "timestamp": "00:04:25", "text": "哦，等等。你为什么现在说英语？"}, {"type": "subtitle", "time": 271.749, "timestamp": "00:04:31", "text": "。哦，雨下得挺大的。"}, {"type": "subtitle", "time": 275.99, "timestamp": "00:04:35", "text": "但现在，嗯，"}, {"type": "subtitle", "time": 279.43, "timestamp": "00:04:39", "text": "就一点点，哦，是什么来着？"}, {"type": "subtitle", "time": 282.59000000000003, "timestamp": "00:04:42", "text": "水滴弹簧啊，日本"}, {"type": "subtitle", "time": 286.029, "timestamp": "00:04:46", "text": "那是什么来着？我忘了。我已经忘了"}, {"type": "subtitle", "time": 289.59000000000003, "timestamp": "00:04:49", "text": "我做到了。大家帮帮我。"}, {"type": "subtitle", "time": 292.39, "timestamp": "00:04:52", "text": "我什么都忘了。"}, {"type": "subtitle", "time": 299.189, "timestamp": "00:04:59", "text": "够了。但是，今天，啊，"}]
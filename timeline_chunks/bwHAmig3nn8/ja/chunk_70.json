[{"type": "subtitle", "time": 4204.149, "timestamp": "01:10:04", "text": "今月、今月じゃない。来月"}, {"type": "subtitle", "time": 4205.95, "timestamp": "01:10:05", "text": "待って"}, {"type": "subtitle", "time": 4215.83, "timestamp": "01:10:15", "text": "今月?あ、今月。"}, {"type": "subtitle", "time": 4220.51, "timestamp": "01:10:20", "text": "えっと、ラストマンドはなんで?何?"}, {"type": "subtitle", "time": 4224.229, "timestamp": "01:10:24", "text": "3月?ああ、先月。はいはいはい。言葉が"}, {"type": "subtitle", "time": 4226.55, "timestamp": "01:10:26", "text": "忘れちゃった。"}, {"type": "subtitle", "time": 4228.07, "timestamp": "01:10:28", "text": "イひ"}, {"type": "subtitle", "time": 4231.75, "timestamp": "01:10:31", "text": "じゃない。火って何だよ。"}, {"type": "subtitle", "time": 4243.47, "timestamp": "01:10:43", "text": "はい。ああ、家に帰て"}, {"type": "subtitle", "time": 4247.27, "timestamp": "01:10:47", "text": "私ちょっとだけマイクをミュートしてます"}, {"type": "subtitle", "time": 4256.07, "timestamp": "01:10:56", "text": "ね。家に届け。あ、時届け。と届けました"}, {"type": "subtitle", "time": 4258.91, "timestamp": "01:10:58", "text": "。ド時ちょっとだけマイクをミュートして"}]
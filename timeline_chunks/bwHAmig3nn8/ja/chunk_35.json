[{"type": "subtitle", "time": 2128.51, "timestamp": "00:35:28", "text": "夜、あ、夜でちょっとだけあ、外に雨の時"}, {"type": "subtitle", "time": 2133.43, "timestamp": "00:35:33", "text": "ちょっと散歩に母さ持って配信やって、"}, {"type": "subtitle", "time": 2140.71, "timestamp": "00:35:40", "text": "ちょっとちょっと考え方とかああ、伝って"}, {"type": "subtitle", "time": 2144.87, "timestamp": "00:35:44", "text": "スタって"}, {"type": "subtitle", "time": 2146.55, "timestamp": "00:35:46", "text": "ああ"}, {"type": "subtitle", "time": 2148.15, "timestamp": "00:35:48", "text": "、"}, {"type": "subtitle", "time": 2153.51, "timestamp": "00:35:53", "text": "遠くあ、遠くの遠くの意味は何だっけね。"}, {"type": "subtitle", "time": 2156.63, "timestamp": "00:35:56", "text": "忘れちゃったよ。"}]
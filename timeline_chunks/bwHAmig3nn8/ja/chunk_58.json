[{"type": "subtitle", "time": 3481.789, "timestamp": "00:58:01", "text": "そうだね。あんまりいつか日本のリスナス"}, {"type": "subtitle", "time": 3486.95, "timestamp": "00:58:06", "text": "さん、リスナスさんの見てくれ。"}, {"type": "subtitle", "time": 3490.75, "timestamp": "00:58:10", "text": "た方がいい。あんまり日本語に日本語で"}, {"type": "subtitle", "time": 3496.27, "timestamp": "00:58:16", "text": "喋りながらこれあジョクは教ってる話し"}, {"type": "subtitle", "time": 3501.19, "timestamp": "00:58:21", "text": "てるのあ、ボンポが違うとかやって教えて"}, {"type": "subtitle", "time": 3516.67, "timestamp": "00:58:36", "text": "おつが私の半があきてくれな"}, {"type": "subtitle", "time": 3520.349, "timestamp": "00:58:40", "text": "と思います。"}, {"type": "subtitle", "time": 3524.19, "timestamp": "00:58:44", "text": "今日はね、これ"}, {"type": "subtitle", "time": 3527.63, "timestamp": "00:58:47", "text": "便利だと思いますね。"}, {"type": "subtitle", "time": 3529.99, "timestamp": "00:58:49", "text": "うん。"}, {"type": "subtitle", "time": 3532.789, "timestamp": "00:58:52", "text": "多分Xでは"}, {"type": "subtitle", "time": 3535.71, "timestamp": "00:58:55", "text": "あ、Xハッシュタグなんすか?言い方"}, {"type": "subtitle", "time": 3538.029, "timestamp": "00:58:58", "text": "わかんなくて"}]
[{"type": "subtitle", "time": 6005.589, "timestamp": "01:40:05", "text": "安い。あ、天ぷラ。これ天ぷラですか?"}, {"type": "subtitle", "time": 6008.07, "timestamp": "01:40:08", "text": "これ天ぷら"}, {"type": "subtitle", "time": 6010.55, "timestamp": "01:40:10", "text": "多分。あ、唐揚げ。"}, {"type": "subtitle", "time": 6033.919, "timestamp": "01:40:33", "text": "切り、切りがいるよ。あ、これもいる。ああ、ターボですか?ち、待って、待って、待って。チンがいる。チン。待って待って。これチンだか。待って。"}]
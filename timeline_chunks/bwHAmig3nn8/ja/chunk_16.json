[{"type": "subtitle", "time": 963.23, "timestamp": "00:16:03", "text": "けどこれおかしいよ。なんでなんであ、"}, {"type": "subtitle", "time": 966.91, "timestamp": "00:16:06", "text": "人間のスタッフさんがいないの?なんで"}, {"type": "subtitle", "time": 972.79, "timestamp": "00:16:12", "text": "いつもいつもAIのAIチャットだけもう"}, {"type": "subtitle", "time": 975.47, "timestamp": "00:16:15", "text": "そしてあ、昨日"}, {"type": "subtitle", "time": 979.71, "timestamp": "00:16:19", "text": "昨日だっけ?今日月曜日だよね。日曜日に"}, {"type": "subtitle", "time": 981.71, "timestamp": "00:16:21", "text": "私、"}, {"type": "subtitle", "time": 985.11, "timestamp": "00:16:25", "text": "日曜日に私ね、"}, {"type": "subtitle", "time": 987.35, "timestamp": "00:16:27", "text": "Payの"}, {"type": "subtitle", "time": 995.749, "timestamp": "00:16:35", "text": "メールアドレスは探してメールにこの問題"}, {"type": "subtitle", "time": 999.389, "timestamp": "00:16:39", "text": "のことを私の名前のスペーシングのことを"}, {"type": "subtitle", "time": 1002.749, "timestamp": "00:16:42", "text": "このああ、"}, {"type": "subtitle", "time": 1007.59, "timestamp": "00:16:47", "text": "なんだっけ?KYCって何だっけ?ああ、"}, {"type": "subtitle", "time": 1010.67, "timestamp": "00:16:50", "text": "なんかなんに難しい日本語ですけどでも"}, {"type": "subtitle", "time": 1013.71, "timestamp": "00:16:53", "text": "わか忘れちゃった。でもKYCのことです"}, {"type": "subtitle", "time": 1016.79, "timestamp": "00:16:56", "text": "けどこれやって"}, {"type": "chat", "time": 1019.627, "timestamp": "00:16:59", "author": "@MikazukiYure", "avatar": "https://yt4.ggpht.com/uuFSD7qVrZy0JUWrBRfSfEKIQpib7_2xP24Yiu1ND1Mq6uhaYIHDnA5EiGz_o33FUhHYvbCT9g=s64-c-k-c0x00ffffff-no-rj", "message": "hmmm"}]
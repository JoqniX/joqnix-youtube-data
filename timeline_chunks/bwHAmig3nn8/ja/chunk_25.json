[{"type": "subtitle", "time": 1502.35, "timestamp": "00:25:02", "text": "見て見て。この人の家にこれなんでグラス"}, {"type": "subtitle", "time": 1508.669, "timestamp": "00:25:08", "text": "の窓がいるのな。何を見てんですか?これ"}, {"type": "subtitle", "time": 1512.149, "timestamp": "00:25:12", "text": "何を見てんですか?"}, {"type": "subtitle", "time": 1515.51, "timestamp": "00:25:15", "text": "上です。ごめんね。プライベートの"}, {"type": "subtitle", "time": 1518.63, "timestamp": "00:25:18", "text": "プライベティだからこれ面白いになっ"}, {"type": "subtitle", "time": 1522.23, "timestamp": "00:25:22", "text": "ちゃったからちょっとだ見せてます。見せ"}, {"type": "subtitle", "time": 1527.51, "timestamp": "00:25:27", "text": "て見せました。ごめんね。"}, {"type": "subtitle", "time": 1537.63, "timestamp": "00:25:37", "text": "これ面白いから。面白いになったね、もう"}, {"type": "subtitle", "time": 1540.149, "timestamp": "00:25:40", "text": "。"}, {"type": "subtitle", "time": 1542.83, "timestamp": "00:25:42", "text": "はい。"}, {"type": "subtitle", "time": 1544.63, "timestamp": "00:25:44", "text": "はあ。"}, {"type": "subtitle", "time": 1549.75, "timestamp": "00:25:49", "text": "ああ、なんだっけ?何でたっけ?今日。"}, {"type": "subtitle", "time": 1551.63, "timestamp": "00:25:51", "text": "今日は"}, {"type": "subtitle", "time": 1559.71, "timestamp": "00:25:59", "text": "86月の8時。8時じゃない。8日。"}]
[{"type": "subtitle", "time": 2463.43, "timestamp": "00:41:03", "text": "ああ、スマートフォンでパソコンしてます"}, {"type": "subtitle", "time": 2466.99, "timestamp": "00:41:06", "text": "ね。ちょっとだけ"}, {"type": "subtitle", "time": 2475.27, "timestamp": "00:41:15", "text": "ああ、待って待って。"}, {"type": "subtitle", "time": 2478.03, "timestamp": "00:41:18", "text": "ちょっとだけ"}, {"type": "subtitle", "time": 2486.309, "timestamp": "00:41:26", "text": "あ、これありない。"}, {"type": "subtitle", "time": 2507.75, "timestamp": "00:41:47", "text": "待ってこれでやるのはいいけど。"}, {"type": "subtitle", "time": 2513.99, "timestamp": "00:41:53", "text": "うん。うん。これうん。白い。ああ、白い"}, {"type": "subtitle", "time": 2516.47, "timestamp": "00:41:56", "text": "じゃない。"}, {"type": "subtitle", "time": 2519.91, "timestamp": "00:41:59", "text": "広い広"}]
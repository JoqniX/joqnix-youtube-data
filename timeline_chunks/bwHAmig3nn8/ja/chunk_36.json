[{"type": "subtitle", "time": 2161.99, "timestamp": "00:36:01", "text": "ああ、話し、話す、話すのは"}, {"type": "subtitle", "time": 2164.91, "timestamp": "00:36:04", "text": "楽しいですよ、"}, {"type": "subtitle", "time": 2167.43, "timestamp": "00:36:07", "text": "これ。"}, {"type": "subtitle", "time": 2170.43, "timestamp": "00:36:10", "text": "これなんか楽しい。"}, {"type": "subtitle", "time": 2172.829, "timestamp": "00:36:12", "text": "これいいね。"}, {"type": "subtitle", "time": 2176.15, "timestamp": "00:36:16", "text": "あ、待って。今何時?"}, {"type": "subtitle", "time": 2187.67, "timestamp": "00:36:27", "text": "6"}, {"type": "subtitle", "time": 2191.069, "timestamp": "00:36:31", "text": "あ、8時6"}, {"type": "subtitle", "time": 2195.43, "timestamp": "00:36:35", "text": "8時8時3"}, {"type": "subtitle", "time": 2197.19, "timestamp": "00:36:37", "text": "分"}, {"type": "subtitle", "time": 2199.349, "timestamp": "00:36:39", "text": "ですよね。"}, {"type": "subtitle", "time": 2206.15, "timestamp": "00:36:46", "text": "あ、この家にいつもピアノの音を聞きます"}, {"type": "subtitle", "time": 2210.589, "timestamp": "00:36:50", "text": "。なんか今ピアノの音"}, {"type": "subtitle", "time": 2214.23, "timestamp": "00:36:54", "text": "聞け聞こえないね。なんで?"}, {"type": "subtitle", "time": 2216.55, "timestamp": "00:36:56", "text": "ちょっとだけ"}]
[{"type": "subtitle", "time": 720.629, "timestamp": "00:12:00", "text": "さっき私は何を話していたんです?なん"}, {"type": "subtitle", "time": 724.069, "timestamp": "00:12:04", "text": "だっけ?さっき。はい。さっきさっきさき"}, {"type": "subtitle", "time": 729.069, "timestamp": "00:12:09", "text": "君忘れないよ、この言葉。はい。さっきは"}, {"type": "subtitle", "time": 736.509, "timestamp": "00:12:16", "text": "何だっ話?話しな。話した。"}, {"type": "subtitle", "time": 740.87, "timestamp": "00:12:20", "text": "なしていたんですか?"}, {"type": "subtitle", "time": 743.75, "timestamp": "00:12:23", "text": "だっけ?ん?行ったんだっけ?はい。"}, {"type": "subtitle", "time": 748.55, "timestamp": "00:12:28", "text": "だっけ?はい。もう日本語が難しいよ、"}, {"type": "subtitle", "time": 753.43, "timestamp": "00:12:33", "text": "もう。はい。なんだっけ?"}, {"type": "subtitle", "time": 757.35, "timestamp": "00:12:37", "text": "もう困りますね。ああ、自分の、自分の"}, {"type": "subtitle", "time": 760.55, "timestamp": "00:12:40", "text": "クレてはいや、もうクレディカーじゃない"}, {"type": "subtitle", "time": 765.43, "timestamp": "00:12:45", "text": "。クリは良くないよ、これ。は、これ大変"}, {"type": "subtitle", "time": 770.59, "timestamp": "00:12:50", "text": "になります。あまりカールが使ったらああ"}, {"type": "subtitle", "time": 774.31, "timestamp": "00:12:54", "text": "、大変になりましたと思いますね。これ"}, {"type": "subtitle", "time": 777.35, "timestamp": "00:12:57", "text": "大変だよ。"}]
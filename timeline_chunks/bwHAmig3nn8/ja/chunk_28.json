[{"type": "subtitle", "time": 1684.71, "timestamp": "00:28:04", "text": "うん。でも何もこのゲームあんまりやって"}, {"type": "subtitle", "time": 1686.669, "timestamp": "00:28:06", "text": "ないから"}, {"type": "subtitle", "time": 1695.19, "timestamp": "00:28:15", "text": "でもサイバーパン好きなゲームだからこの"}, {"type": "subtitle", "time": 1696.909, "timestamp": "00:28:16", "text": "モービー"}, {"type": "subtitle", "time": 1703.789, "timestamp": "00:28:23", "text": "がアニメモービーがみ見て見たから"}, {"type": "subtitle", "time": 1710.389, "timestamp": "00:28:30", "text": "このコラブはあやりコラブあこのブバ"}, {"type": "subtitle", "time": 1714.19, "timestamp": "00:28:34", "text": "コラボわ、コラボ"}, {"type": "subtitle", "time": 1717.389, "timestamp": "00:28:37", "text": "Playスタイル。あ、や"}, {"type": "subtitle", "time": 1720.19, "timestamp": "00:28:40", "text": "、あ、いや、やりたい。やりたいじゃない"}, {"type": "subtitle", "time": 1726.669, "timestamp": "00:28:46", "text": "。ゲーム配信になってプレイあ、プレイし"}, {"type": "subtitle", "time": 1731.47, "timestamp": "00:28:51", "text": "たい。もうどうやってこれ日本語にしたい"}, {"type": "subtitle", "time": 1734.07, "timestamp": "00:28:54", "text": "?スタブンダ"}, {"type": "subtitle", "time": 1736.07, "timestamp": "00:28:56", "text": "スターン"}, {"type": "subtitle", "time": 1737.99, "timestamp": "00:28:57", "text": "スター"}]
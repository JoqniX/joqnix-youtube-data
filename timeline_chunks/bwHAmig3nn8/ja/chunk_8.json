[{"type": "subtitle", "time": 480.55, "timestamp": "00:08:00", "text": "例えばケルカルや、あ、ケルカーやデビル"}, {"type": "subtitle", "time": 483.23, "timestamp": "00:08:03", "text": "カールがいないから"}, {"type": "subtitle", "time": 487.629, "timestamp": "00:08:07", "text": "、もうどうやっては、お金が払ってもいい"}, {"type": "subtitle", "time": 492.43, "timestamp": "00:08:12", "text": "ですかと困りますよ。これ、これのこと"}, {"type": "subtitle", "time": 495.909, "timestamp": "00:08:15", "text": "全然わかんないけど。あ、私の学校ね。"}, {"type": "subtitle", "time": 497.35, "timestamp": "00:08:17", "text": "オーマイガブロックmybrella"}, {"type": "subtitle", "time": 501.11, "timestamp": "00:08:21", "text": "againねえ。なんだこれ?私のあ、あ"}, {"type": "subtitle", "time": 504.07, "timestamp": "00:08:24", "text": "、私の"}, {"type": "subtitle", "time": 509.99, "timestamp": "00:08:29", "text": "学校は作ったこの銀行ね。銀行私のあ、"}, {"type": "subtitle", "time": 512.75, "timestamp": "00:08:32", "text": "銀行長"}, {"type": "subtitle", "time": 515.23, "timestamp": "00:08:35", "text": "だっけ?わかんない。JPボスだっけ?"}, {"type": "subtitle", "time": 521.029, "timestamp": "00:08:41", "text": "そう、これ話ですけど一丁なことですけど"}, {"type": "subtitle", "time": 524.35, "timestamp": "00:08:44", "text": "、今キャッシュガールが持っていますね。"}, {"type": "subtitle", "time": 528.07, "timestamp": "00:08:48", "text": "そうでもこのキャッシュガールが"}, {"type": "subtitle", "time": 531.829, "timestamp": "00:08:51", "text": "カシガールの代わりにあ、ダビットカール"}, {"type": "subtitle", "time": 533.43, "timestamp": "00:08:53", "text": "が"}, {"type": "subtitle", "time": 535.63, "timestamp": "00:08:55", "text": "すかわ"}, {"type": "subtitle", "time": 539.63, "timestamp": "00:08:59", "text": "変わら変わりませんと先生が言ってこれ"}]
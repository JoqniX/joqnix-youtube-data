[{"type": "subtitle", "time": 1441.31, "timestamp": "00:24:01", "text": "はい。次のトーピックはね、私ね、最近"}, {"type": "subtitle", "time": 1447.909, "timestamp": "00:24:07", "text": "最近はこのアーティストさんの曲は聞いて"}, {"type": "subtitle", "time": 1454.35, "timestamp": "00:24:14", "text": "ながら歌っていつも歌ってますよ。あて"}, {"type": "subtitle", "time": 1460.31, "timestamp": "00:24:20", "text": "さんの名前はあ、小花ラムと思う。"}, {"type": "subtitle", "time": 1462.23, "timestamp": "00:24:22", "text": "コハラム"}, {"type": "subtitle", "time": 1470.23, "timestamp": "00:24:30", "text": "さんの曲を聞って、私いつもいつもあ、き"}, {"type": "subtitle", "time": 1472.269, "timestamp": "00:24:32", "text": "聞くながら"}, {"type": "subtitle", "time": 1476.95, "timestamp": "00:24:36", "text": "ちょっとだけあ、裏声"}, {"type": "subtitle", "time": 1478.99, "timestamp": "00:24:38", "text": "中声"}, {"type": "subtitle", "time": 1483.95, "timestamp": "00:24:43", "text": "ボイスでちょっとだけ歌いますね。あ、"}, {"type": "subtitle", "time": 1488.07, "timestamp": "00:24:48", "text": "いつも歌います。アルバイトややってる。"}, {"type": "subtitle", "time": 1489.51, "timestamp": "00:24:49", "text": "ああ。"}]
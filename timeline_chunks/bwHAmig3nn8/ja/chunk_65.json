[{"type": "subtitle", "time": 3905.87, "timestamp": "01:05:05", "text": "やってる配信に私、あ、日本の"}, {"type": "subtitle", "time": 3910.19, "timestamp": "01:05:10", "text": "天気なと天気のこと"}, {"type": "subtitle", "time": 3913.99, "timestamp": "01:05:13", "text": "みたいあります。に"}, {"type": "subtitle", "time": 3917.349, "timestamp": "01:05:17", "text": "でもさ、このように"}, {"type": "subtitle", "time": 3921.789, "timestamp": "01:05:21", "text": "スマッフォであ、やってる配信のことです"}, {"type": "subtitle", "time": 3926.549, "timestamp": "01:05:26", "text": "けど、ブラ、あ、ブラウザーソースがは"}, {"type": "subtitle", "time": 3929.71, "timestamp": "01:05:29", "text": "このフィーチャーがいないからちょっと"}, {"type": "subtitle", "time": 3934.589, "timestamp": "01:05:34", "text": "難しい。から友達にあ、ウィジェット"}, {"type": "subtitle", "time": 3937.99, "timestamp": "01:05:37", "text": "みたい、カスタムウィジェットみたいああ"}, {"type": "subtitle", "time": 3942.39, "timestamp": "01:05:42", "text": "、ベデジェットみたいやった方がいいと"}, {"type": "subtitle", "time": 3944.589, "timestamp": "01:05:44", "text": "思って"}, {"type": "subtitle", "time": 3953.95, "timestamp": "01:05:53", "text": "そうだね。ちょっとだけ考えてください。"}, {"type": "subtitle", "time": 3956.029, "timestamp": "01:05:56", "text": "私"}, {"type": "subtitle", "time": 3958.829, "timestamp": "01:05:58", "text": "いくらある?ああるあ、あると言いますか"}]
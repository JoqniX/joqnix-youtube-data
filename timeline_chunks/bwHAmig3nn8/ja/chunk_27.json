[{"type": "subtitle", "time": 1621.35, "timestamp": "00:27:01", "text": "。多分これ終わっ"}, {"type": "subtitle", "time": 1627.47, "timestamp": "00:27:07", "text": "た後にちょっとだけ特許に配信"}, {"type": "subtitle", "time": 1632.07, "timestamp": "00:27:12", "text": "配信したいと思います。思っています。"}, {"type": "subtitle", "time": 1635.149, "timestamp": "00:27:15", "text": "これやる"}, {"type": "subtitle", "time": 1644.51, "timestamp": "00:27:24", "text": "earlyaccessforコラブ。"}, {"type": "subtitle", "time": 1646.47, "timestamp": "00:27:26", "text": "て何?"}, {"type": "subtitle", "time": 1649.149, "timestamp": "00:27:29", "text": "このアブバウドリング"}, {"type": "subtitle", "time": 1654.31, "timestamp": "00:27:34", "text": "ウェブスの話をですよね。"}, {"type": "subtitle", "time": 1658.549, "timestamp": "00:27:38", "text": "ウェディングウェブスのあ、サイバルパン"}, {"type": "subtitle", "time": 1662.87, "timestamp": "00:27:42", "text": "のコラブね。これありがあのクエストが"}, {"type": "subtitle", "time": 1665.269, "timestamp": "00:27:45", "text": "いる"}, {"type": "subtitle", "time": 1670.509, "timestamp": "00:27:50", "text": "なったら多分土曜日に配信してもあ、配信"}, {"type": "subtitle", "time": 1673.23, "timestamp": "00:27:53", "text": "したい"}, {"type": "subtitle", "time": 1679.87, "timestamp": "00:27:59", "text": "だったら土曜日に配信したい。ウバだけ。"}]
[{"type": "subtitle", "time": 1082.51, "timestamp": "00:18:02", "text": "注意して。ああ。"}, {"type": "subtitle", "time": 1087.47, "timestamp": "00:18:07", "text": "注意、注意してじゃない。あー、履いて"}, {"type": "subtitle", "time": 1092.47, "timestamp": "00:18:12", "text": "なく履いてなくてスペースはいない方が"}, {"type": "subtitle", "time": 1097.71, "timestamp": "00:18:17", "text": "いいと言って。でも今はあ、配信の1時間"}, {"type": "subtitle", "time": 1102.35, "timestamp": "00:18:22", "text": "前に私バスでちょっとだけチャピ使って、"}, {"type": "subtitle", "time": 1108.71, "timestamp": "00:18:28", "text": "あ、メールがメールが作ったよ。ああ、"}, {"type": "subtitle", "time": 1113.27, "timestamp": "00:18:33", "text": "だって私日本語でああ。作分買った。"}, {"type": "subtitle", "time": 1117.149, "timestamp": "00:18:37", "text": "いやいや、作分とか書いての"}, {"type": "subtitle", "time": 1120.23, "timestamp": "00:18:40", "text": "書くのは願ってだから。願ってだからじゃ"}, {"type": "subtitle", "time": 1123.27, "timestamp": "00:18:43", "text": "ない。あ、大変だから。大変もじゃないよ"}, {"type": "subtitle", "time": 1129.11, "timestamp": "00:18:49", "text": "。難しいだから。あ、だ誰誰待って待って"}, {"type": "subtitle", "time": 1134.789, "timestamp": "00:18:54", "text": "待って。今まで私に本合で誰"}, {"type": "subtitle", "time": 1139.87, "timestamp": "00:18:59", "text": "で誰でも日本語で話してないね。ちょっと"}]
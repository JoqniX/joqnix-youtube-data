[{"type": "subtitle", "time": 4080.99, "timestamp": "01:08:00", "text": "家に帰って電気"}, {"type": "subtitle", "time": 4086.069, "timestamp": "01:08:06", "text": "をこの紙をもらってセブンにコンビニに"}, {"type": "subtitle", "time": 4089.67, "timestamp": "01:08:09", "text": "行ってこれ払いますね。ちょっとだけこれ"}, {"type": "subtitle", "time": 4093.789, "timestamp": "01:08:13", "text": "のこと忘れちゃったよ。私腹になっちゃう"}, {"type": "subtitle", "time": 4097.59, "timestamp": "01:08:17", "text": "。いけません。これのこと忘れちゃったよ"}, {"type": "subtitle", "time": 4101.749, "timestamp": "01:08:21", "text": "。ごめんね。これのこと忘れちゃった。"}, {"type": "subtitle", "time": 4114.149, "timestamp": "01:08:34", "text": "た。うん。パパ"}, {"type": "subtitle", "time": 4117.829, "timestamp": "01:08:37", "text": "。いつも"}, {"type": "subtitle", "time": 4122.149, "timestamp": "01:08:42", "text": "。はい。一緒にあいてます。"}, {"type": "subtitle", "time": 4126.91, "timestamp": "01:08:46", "text": "ある。ああ、行きましょう。はい。"}, {"type": "subtitle", "time": 4130.11, "timestamp": "01:08:50", "text": "レツ。"}, {"type": "subtitle", "time": 4134.63, "timestamp": "01:08:54", "text": "今あんまり、あ、今もちょっとだけ雨降っ"}, {"type": "subtitle", "time": 4137.03, "timestamp": "01:08:57", "text": "ていますよね。"}]
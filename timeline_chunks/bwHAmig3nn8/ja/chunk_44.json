[{"type": "subtitle", "time": 2643.309, "timestamp": "00:44:03", "text": "ジョックの来て言って。あ、あんまり寝て"}, {"type": "subtitle", "time": 2644.75, "timestamp": "00:44:04", "text": "ない。"}, {"type": "subtitle", "time": 2656.349, "timestamp": "00:44:16", "text": "Letmesleep。そう、もうこれN"}, {"type": "subtitle", "time": 2660.829, "timestamp": "00:44:20", "text": "さんの授業だったよ。"}, {"type": "subtitle", "time": 2666.15, "timestamp": "00:44:26", "text": "今日初めのチャプターあのことですけど。"}, {"type": "subtitle", "time": 2671.27, "timestamp": "00:44:31", "text": "は、今日Nさん始まったからいっぱい。あ"}, {"type": "subtitle", "time": 2675.67, "timestamp": "00:44:35", "text": "、いっぱい食題もいるよ。もう"}, {"type": "subtitle", "time": 2680.63, "timestamp": "00:44:40", "text": "多分今日今あ、配信終わったから終わった"}, {"type": "subtitle", "time": 2686.39, "timestamp": "00:44:46", "text": "の後このオンラインの授業もあ、従業もや"}, {"type": "subtitle", "time": 2692.309, "timestamp": "00:44:52", "text": "やって勉強して一生懸命より勉強して多分"}, {"type": "subtitle", "time": 2694.95, "timestamp": "00:44:54", "text": "朝の"}]
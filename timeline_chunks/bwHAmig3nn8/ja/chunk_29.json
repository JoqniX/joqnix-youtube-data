[{"type": "subtitle", "time": 1741.149, "timestamp": "00:29:01", "text": "ああ、理解できましか。"}, {"type": "subtitle", "time": 1752.509, "timestamp": "00:29:12", "text": "場所どこ?私は"}, {"type": "subtitle", "time": 1756.47, "timestamp": "00:29:16", "text": "お、ロンドリー。あ、これロンリーですよ"}, {"type": "subtitle", "time": 1761.75, "timestamp": "00:29:21", "text": "ね。ちょっとだけ見ますね。みんなロン"}, {"type": "subtitle", "time": 1767.509, "timestamp": "00:29:27", "text": "コインロンジをみたいんですか?"}, {"type": "subtitle", "time": 1772.669, "timestamp": "00:29:32", "text": "みんなコインロンジが見たいんですか?見"}, {"type": "subtitle", "time": 1775.269, "timestamp": "00:29:35", "text": "たみ"}, {"type": "subtitle", "time": 1782.95, "timestamp": "00:29:42", "text": "あ、見ました。見見る"}, {"type": "subtitle", "time": 1787.269, "timestamp": "00:29:47", "text": "これコインロンリーです。"}, {"type": "subtitle", "time": 1793.549, "timestamp": "00:29:53", "text": "これ"}, {"type": "subtitle", "time": 1796.029, "timestamp": "00:29:56", "text": "恋のだよ。"}, {"type": "subtitle", "time": 1798.35, "timestamp": "00:29:58", "text": "すごくない?"}]
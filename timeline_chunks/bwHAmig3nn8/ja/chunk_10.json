[{"type": "subtitle", "time": 602.35, "timestamp": "00:10:02", "text": "今日ね、"}, {"type": "subtitle", "time": 608.509, "timestamp": "00:10:08", "text": "待って。今日ね、今日ね、あん"}, {"type": "subtitle", "time": 611.509, "timestamp": "00:10:11", "text": "ちょっとだけでチャッピってジェムニー"}, {"type": "subtitle", "time": 615.23, "timestamp": "00:10:15", "text": "使ってあ、ジェムニとジェムニーや"}, {"type": "subtitle", "time": 617.63, "timestamp": "00:10:17", "text": "ジェムニーと"}, {"type": "subtitle", "time": 621.43, "timestamp": "00:10:21", "text": "あとあジムニー"}, {"type": "subtitle", "time": 624.99, "timestamp": "00:10:24", "text": "とチャッピー使って"}, {"type": "subtitle", "time": 627.23, "timestamp": "00:10:27", "text": "あと"}, {"type": "subtitle", "time": 631.15, "timestamp": "00:10:31", "text": "ね、待って。今日新しいぶ"}, {"type": "subtitle", "time": 637.47, "timestamp": "00:10:37", "text": "ああ文法があ勉強したけどNさんの文法"}, {"type": "subtitle", "time": 643.269, "timestamp": "00:10:43", "text": "ですけどあこれ今この文に使いたいけどで"}, {"type": "subtitle", "time": 646.71, "timestamp": "00:10:46", "text": "も使わない。あ、うまく使いたい。あ、"}, {"type": "subtitle", "time": 652.03, "timestamp": "00:10:52", "text": "使われない。うまくできない。"}, {"type": "subtitle", "time": 654.47, "timestamp": "00:10:54", "text": "でもな、"}, {"type": "subtitle", "time": 659.269, "timestamp": "00:10:59", "text": "もう疲れた私。歩いて歩いて。なんでなん"}]
[{"type": "subtitle", "time": 2580.15, "timestamp": "00:43:00", "text": "じゃ、私の声うるさくないだと思いますね"}, {"type": "subtitle", "time": 2583.67, "timestamp": "00:43:03", "text": "。ごめんね。あんまり"}, {"type": "subtitle", "time": 2587.069, "timestamp": "00:43:07", "text": "あ、あんまり話せないから"}, {"type": "subtitle", "time": 2589.109, "timestamp": "00:43:09", "text": "雨。"}, {"type": "subtitle", "time": 2592.67, "timestamp": "00:43:12", "text": "うん。今日家に帰って"}, {"type": "subtitle", "time": 2594.39, "timestamp": "00:43:14", "text": "アプロ"}, {"type": "subtitle", "time": 2597.03, "timestamp": "00:43:17", "text": "アプレやりますね。"}, {"type": "subtitle", "time": 2601.589, "timestamp": "00:43:21", "text": "もう今日は大変だよ。今日はね、いっぱ"}, {"type": "subtitle", "time": 2605.23, "timestamp": "00:43:25", "text": "今日は朝ご飯"}, {"type": "subtitle", "time": 2611.43, "timestamp": "00:43:31", "text": "ちょっとだけ食べたから今日元気にうまく"}, {"type": "subtitle", "time": 2616.15, "timestamp": "00:43:36", "text": "仕事をやりました。やってくれやってやり"}, {"type": "subtitle", "time": 2621.589, "timestamp": "00:43:41", "text": "ました。はい。でもさ、じ、あ、学校に"}, {"type": "subtitle", "time": 2627.87, "timestamp": "00:43:47", "text": "行った時、授業の授業に"}, {"type": "subtitle", "time": 2632.79, "timestamp": "00:43:52", "text": "もうね、眠い眠かったですよ。"}, {"type": "subtitle", "time": 2638.23, "timestamp": "00:43:58", "text": "いっぱい寝た。でもセンスよ。"}]
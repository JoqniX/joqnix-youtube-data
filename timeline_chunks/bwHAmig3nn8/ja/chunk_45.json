[{"type": "subtitle", "time": 2707.589, "timestamp": "00:45:07", "text": "1時にね、これ授業は終わったから"}, {"type": "subtitle", "time": 2712.71, "timestamp": "00:45:12", "text": "寝ます。寝、寝ます。"}, {"type": "subtitle", "time": 2717.829, "timestamp": "00:45:17", "text": "なんでこのこのこれこのようには遅くなっ"}, {"type": "subtitle", "time": 2722.309, "timestamp": "00:45:22", "text": "てあ、遅く遅い"}, {"type": "subtitle", "time": 2729.069, "timestamp": "00:45:29", "text": "の授業だと聞いたらこれインドの時間では"}, {"type": "subtitle", "time": 2743.109, "timestamp": "00:45:43", "text": "、7時じゃない。7時"}, {"type": "subtitle", "time": 2746.27, "timestamp": "00:45:46", "text": "あ、7時"}, {"type": "subtitle", "time": 2752.63, "timestamp": "00:45:52", "text": "あ、に始まって、あ、インドのあ、時間は"}, {"type": "subtitle", "time": 2758.71, "timestamp": "00:45:58", "text": "、あ、え、7時には始まって、あ、10時"}]
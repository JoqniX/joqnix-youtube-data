[{"type": "subtitle", "time": 4025.19, "timestamp": "01:07:05", "text": "、配信に見ますよ。私の形態はいくらあ、"}, {"type": "subtitle", "time": 4035.269, "timestamp": "01:07:15", "text": "いいアイリアでしょ。"}, {"type": "subtitle", "time": 4039.75, "timestamp": "01:07:19", "text": "へえ。すごい。すごくすごいよ。これの"}, {"type": "subtitle", "time": 4042.63, "timestamp": "01:07:22", "text": "アイリア。"}, {"type": "subtitle", "time": 4050.23, "timestamp": "01:07:30", "text": "うん。"}, {"type": "subtitle", "time": 4054.87, "timestamp": "01:07:34", "text": "それすごい。あ、忘れちゃったね。私、私"}, {"type": "subtitle", "time": 4058.99, "timestamp": "01:07:38", "text": "の電、あ、電気の"}, {"type": "subtitle", "time": 4061.15, "timestamp": "01:07:41", "text": "メア"}, {"type": "subtitle", "time": 4074.63, "timestamp": "01:07:54", "text": "電気"}, {"type": "subtitle", "time": 4078.029, "timestamp": "01:07:58", "text": "をは今"}]
[{"type": "subtitle", "time": 180.43, "timestamp": "00:03:00", "text": "うん。全部忘れちゃった。今日ね、私今ク"}, {"type": "subtitle", "time": 184.91, "timestamp": "00:03:04", "text": "にいるよ。見て、見て。"}, {"type": "subtitle", "time": 189.39, "timestamp": "00:03:09", "text": "んでキャメラにこえな。あ、はい。今公園"}, {"type": "subtitle", "time": 193.35, "timestamp": "00:03:13", "text": "にいるよ。そうそうそうそう。"}, {"type": "subtitle", "time": 196.67000000000002, "timestamp": "00:03:16", "text": "今公園にりまいます。"}, {"type": "subtitle", "time": 202.35, "timestamp": "00:03:22", "text": "今歩いてます。今雨も降っていますから。"}, {"type": "subtitle", "time": 208.589, "timestamp": "00:03:28", "text": "今日今日の配信のことですけど今日の配信"}, {"type": "subtitle", "time": 214.429, "timestamp": "00:03:34", "text": "1時30分だけ。はい。今日はね、私、あ"}, {"type": "subtitle", "time": 219.03, "timestamp": "00:03:39", "text": "、最近私の友達でオンラインで、あ、この"}, {"type": "subtitle", "time": 223.149, "timestamp": "00:03:43", "text": "コースに入ったから、今日はオンラインの"}, {"type": "subtitle", "time": 227.309, "timestamp": "00:03:47", "text": "授業がいる。これ初めの、あ、クラスだ"}, {"type": "subtitle", "time": 231.91, "timestamp": "00:03:51", "text": "から。あ、今日、あ、"}, {"type": "subtitle", "time": 237.589, "timestamp": "00:03:57", "text": "遅くなりあなたもダめ。あ、ダめから。あ"}]
[{"type": "subtitle", "time": 2281.91, "timestamp": "00:38:01", "text": "ちょっと"}, {"type": "subtitle", "time": 2289.51, "timestamp": "00:38:09", "text": "に"}, {"type": "subtitle", "time": 2294.99, "timestamp": "00:38:14", "text": "家帰ります。はい。9時に、9時30分に"}, {"type": "subtitle", "time": 2298.71, "timestamp": "00:38:18", "text": "帰りますね。あまり時間がない。ちょっと"}, {"type": "subtitle", "time": 2302.71, "timestamp": "00:38:22", "text": "だけ話しちゃ。これ今日の配信短いです"}, {"type": "subtitle", "time": 2307.19, "timestamp": "00:38:27", "text": "からごめんね。こんな"}, {"type": "subtitle", "time": 2310.03, "timestamp": "00:38:30", "text": "今日配信は短く"}, {"type": "subtitle", "time": 2312.19, "timestamp": "00:38:32", "text": "です。"}, {"type": "subtitle", "time": 2333.47, "timestamp": "00:38:53", "text": "Iさんwasごめ"}, {"type": "subtitle", "time": 2335.47, "timestamp": "00:38:55", "text": "あ"}]
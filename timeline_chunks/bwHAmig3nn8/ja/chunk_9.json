[{"type": "subtitle", "time": 543.91, "timestamp": "00:09:03", "text": "困るんね。そういえば今私の携帯番号携帯"}, {"type": "subtitle", "time": 551.11, "timestamp": "00:09:11", "text": "番号は楽天のですけどでも私のスポンサー"}, {"type": "subtitle", "time": 554.67, "timestamp": "00:09:14", "text": "さん先生インドのアカデミーのスポンサー"}, {"type": "subtitle", "time": 561.11, "timestamp": "00:09:21", "text": "さんあさんあのクリッティカードでこの"}, {"type": "subtitle", "time": 575.35, "timestamp": "00:09:35", "text": "元に連携してこのあ、4月"}, {"type": "subtitle", "time": 581.19, "timestamp": "00:09:41", "text": "4月と5月のお料じゃない。あ、メダンは"}, {"type": "subtitle", "time": 586.509, "timestamp": "00:09:46", "text": "ペイメントはあ、やるは大変だと。今大変"}, {"type": "subtitle", "time": 589.87, "timestamp": "00:09:49", "text": "になりました。もうわかんないよ。どどう"}, {"type": "subtitle", "time": 593.87, "timestamp": "00:09:53", "text": "すればいいってわかんない。本当にもう"}]
[{"type": "subtitle", "time": 5703.87, "timestamp": "01:35:03", "text": "こんじ"}, {"type": "subtitle", "time": 5708.99, "timestamp": "01:35:08", "text": "何が食べてるの?なんかわかんないよ。"}, {"type": "subtitle", "time": 5713.55, "timestamp": "01:35:13", "text": "設定。ああ、あ、スーパーに切って"}, {"type": "subtitle", "time": 5717.07, "timestamp": "01:35:17", "text": "み、あ、動画見ますよ。あ、見せてくれ"}, {"type": "subtitle", "time": 5721.55, "timestamp": "01:35:21", "text": "ます。待って。日本語。日本語日本語ない"}, {"type": "subtitle", "time": 5724.629, "timestamp": "01:35:24", "text": "。あは。ま、日本語ですの。日本語ごめん"}, {"type": "subtitle", "time": 5731.07, "timestamp": "01:35:31", "text": "。が私のスマートフォンの後ろキャメラが"}, {"type": "subtitle", "time": 5733.31, "timestamp": "01:35:33", "text": "はオンにして"}, {"type": "subtitle", "time": 5738.109, "timestamp": "01:35:38", "text": "ちょっとだけ配信に見せて"}, {"type": "subtitle", "time": 5743.39, "timestamp": "01:35:43", "text": "くれます。待って待って。車ありがとう。"}, {"type": "subtitle", "time": 5745.79, "timestamp": "01:35:45", "text": "ああ、"}, {"type": "subtitle", "time": 5748.35, "timestamp": "01:35:48", "text": "車まっちゃん。"}, {"type": "subtitle", "time": 5751.35, "timestamp": "01:35:51", "text": "あの"}, {"type": "chat", "time": 5754.135, "timestamp": "01:35:54", "author": "@hbvcsa", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mA5iYFWQWr-erQfOrpRSPi7uAL1ykOBKRSbPBDp88Z1xyBT7Je5IKp6_AckwgwsDEc-Q=s64-c-k-c0x00ffffff-no-rj", "message": "Did you passed N4"}]
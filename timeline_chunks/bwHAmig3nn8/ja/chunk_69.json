[{"type": "subtitle", "time": 4141.309, "timestamp": "01:09:01", "text": "ああ、はあまり"}, {"type": "subtitle", "time": 4144.59, "timestamp": "01:09:04", "text": "ヒットがいないから。"}, {"type": "subtitle", "time": 4150.309, "timestamp": "01:09:10", "text": "私、ああ、この声にあ、触、あ、ベンジで"}, {"type": "subtitle", "time": 4154.709, "timestamp": "01:09:14", "text": "触っていっぱい触ったから私の足が今痛い"}, {"type": "subtitle", "time": 4156.59, "timestamp": "01:09:16", "text": "よ。"}, {"type": "subtitle", "time": 4158.709, "timestamp": "01:09:18", "text": "うわあ、"}, {"type": "subtitle", "time": 4161.59, "timestamp": "01:09:21", "text": "おかしい。"}, {"type": "subtitle", "time": 4169.47, "timestamp": "01:09:29", "text": "あ、全然"}, {"type": "subtitle", "time": 4171.59, "timestamp": "01:09:31", "text": "は"}, {"type": "subtitle", "time": 4177.47, "timestamp": "01:09:37", "text": "足が痛くなりましたね。ねえ、なんで?"}, {"type": "subtitle", "time": 4190.229, "timestamp": "01:09:50", "text": "。"}, {"type": "subtitle", "time": 4199.07, "timestamp": "01:09:59", "text": "電気剣。うん。ハ丁。今日はね、今日あ、"}]
[{"type": "subtitle", "time": 665.069, "timestamp": "00:11:05", "text": "で疲れた?なんでなんで疲れたの?今い"}, {"type": "subtitle", "time": 670.11, "timestamp": "00:11:10", "text": "ている。疲れた。え、"}, {"type": "subtitle", "time": 674.55, "timestamp": "00:11:14", "text": "あんまり走ってないよ、私。はい。何の話"}, {"type": "subtitle", "time": 679.47, "timestamp": "00:11:19", "text": "だけ私?あ、あ、前にああ"}, {"type": "subtitle", "time": 680.91, "timestamp": "00:11:20", "text": "。"}, {"type": "subtitle", "time": 684.55, "timestamp": "00:11:24", "text": "前じゃない。アーリの言葉が何だっけ?"}, {"type": "subtitle", "time": 690.23, "timestamp": "00:11:30", "text": "ああ、昔じゃない。リアなんだっけ?なん"}, {"type": "subtitle", "time": 692.43, "timestamp": "00:11:32", "text": "だっけ?"}, {"type": "subtitle", "time": 715.389, "timestamp": "00:11:55", "text": "リアって何?"}]
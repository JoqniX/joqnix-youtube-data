[{"type": "subtitle", "time": 1201.95, "timestamp": "00:20:01", "text": "もうペイパーペイペもスペースをスペカラ"}, {"type": "subtitle", "time": 1205.95, "timestamp": "00:20:05", "text": "で名前を書く時スペースが入ってない入っ"}, {"type": "subtitle", "time": 1211.39, "timestamp": "00:20:11", "text": "てあない時もこれあこの"}, {"type": "subtitle", "time": 1213.07, "timestamp": "00:20:13", "text": "アイデンティティフケーション"}, {"type": "subtitle", "time": 1216.35, "timestamp": "00:20:16", "text": "はあ"}, {"type": "subtitle", "time": 1222.47, "timestamp": "00:20:22", "text": "になった場合はこれああこのあこのデータ"}, {"type": "subtitle", "time": 1230.35, "timestamp": "00:20:30", "text": "を見て見て見ってデータをみる時これ名前"}, {"type": "subtitle", "time": 1236.669, "timestamp": "00:20:36", "text": "なあカレンの名前はま、カタカナの名前に"}, {"type": "subtitle", "time": 1240.31, "timestamp": "00:20:40", "text": "スペースが入ってる。でも私スペースが"}, {"type": "subtitle", "time": 1242.549, "timestamp": "00:20:42", "text": "入ってない。あ、はい。"}, {"type": "subtitle", "time": 1247.549, "timestamp": "00:20:47", "text": "かの時スペースは入ってないからこれ"}, {"type": "subtitle", "time": 1252.99, "timestamp": "00:20:52", "text": "ペイペの問題ですと言って買って"}, {"type": "subtitle", "time": 1257.909, "timestamp": "00:20:57", "text": "あ、出しました。出しました。Isend"}]
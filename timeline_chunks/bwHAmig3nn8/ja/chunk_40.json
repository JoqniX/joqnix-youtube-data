[{"type": "subtitle", "time": 2400.19, "timestamp": "00:40:00", "text": "これもこれ練習。"}, {"type": "subtitle", "time": 2404.51, "timestamp": "00:40:04", "text": "あ、日本に日本の"}, {"type": "subtitle", "time": 2407.109, "timestamp": "00:40:07", "text": "あ、話す"}, {"type": "subtitle", "time": 2409.87, "timestamp": "00:40:09", "text": "と考える"}, {"type": "subtitle", "time": 2413.67, "timestamp": "00:40:13", "text": "のあ、練習だ"}, {"type": "subtitle", "time": 2417.71, "timestamp": "00:40:17", "text": "と思ってくれ。"}, {"type": "subtitle", "time": 2422.47, "timestamp": "00:40:22", "text": "くれ。あ、思って[咳払い]思ってるん"}, {"type": "subtitle", "time": 2426.19, "timestamp": "00:40:26", "text": "です。うん。"}, {"type": "subtitle", "time": 2429.829, "timestamp": "00:40:29", "text": "もううまくできないよ。なんで?いや、"}, {"type": "subtitle", "time": 2435.27, "timestamp": "00:40:35", "text": "最近英語。最近映画使ったわからん。"}, {"type": "subtitle", "time": 2437.19, "timestamp": "00:40:37", "text": "なんで"}, {"type": "subtitle", "time": 2442.75, "timestamp": "00:40:42", "text": "おまでないよ。なんでなんで?ええ、"}, {"type": "subtitle", "time": 2454.303, "timestamp": "00:40:54", "text": "ああ、"}, {"type": "subtitle", "time": 2457.23, "timestamp": "00:40:57", "text": "[鼻息]待ってね。ちょっとだけパズコン"}, {"type": "subtitle", "time": 2458.91, "timestamp": "00:40:58", "text": "に"}]
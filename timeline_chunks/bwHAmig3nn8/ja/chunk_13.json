[{"type": "subtitle", "time": 782.509, "timestamp": "00:13:02", "text": "いっぱいローがやってこれインパ買って、"}, {"type": "subtitle", "time": 786.949, "timestamp": "00:13:06", "text": "そしてあ、デッドラインの時、レッド"}, {"type": "subtitle", "time": 790.79, "timestamp": "00:13:10", "text": "ラインの時これいっぱいお金払い、払え"}, {"type": "subtitle", "time": 796.829, "timestamp": "00:13:16", "text": "なくちゃいけませんね。も大変だよ。"}, {"type": "subtitle", "time": 800.35, "timestamp": "00:13:20", "text": "クリティガとかでもデビガールはいいけど"}, {"type": "subtitle", "time": 805.15, "timestamp": "00:13:25", "text": "。あ、あ、デビガールはエンドではエンド"}, {"type": "subtitle", "time": 813.11, "timestamp": "00:13:33", "text": "では私のあ、うちに多分あ、2人3日3日"}, {"type": "subtitle", "time": 817.67, "timestamp": "00:13:37", "text": "じゃない。2つ2つ"}, {"type": "subtitle", "time": 826.629, "timestamp": "00:13:46", "text": "ああ、3の3"}, {"type": "subtitle", "time": 830.749, "timestamp": "00:13:50", "text": "プンじゃない。3枚はい。3枚前枚マイ"}, {"type": "subtitle", "time": 834.11, "timestamp": "00:13:54", "text": "はい。カウントル前だと思いますね。この"}, {"type": "subtitle", "time": 839.23, "timestamp": "00:13:59", "text": "カウンル使ってもいいですか?3枚の"}]
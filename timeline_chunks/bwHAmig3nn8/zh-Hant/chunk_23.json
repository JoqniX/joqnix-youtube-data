[{"type": "subtitle", "time": 1384.83, "timestamp": "00:23:04", "text": "。我當時想，“這樣做，這樣做，文字，文字”"}, {"type": "subtitle", "time": 1388.63, "timestamp": "00:23:08", "text": "總有一天你可以慢慢地做到。"}, {"type": "subtitle", "time": 1394.35, "timestamp": "00:23:14", "text": "我希望我說的沒錯"}, {"type": "subtitle", "time": 1395.47, "timestamp": "00:23:15", "text": "可以理解"}, {"type": "subtitle", "time": 1397.71, "timestamp": "00:23:17", "text": "你們。"}, {"type": "subtitle", "time": 1399.71, "timestamp": "00:23:19", "text": "一個，"}, {"type": "subtitle", "time": 1408.99, "timestamp": "00:23:28", "text": "不，我不常使用英語。今天在日本"}, {"type": "subtitle", "time": 1414.87, "timestamp": "00:23:34", "text": "這是一段日文對話。只是閒聊。"}, {"type": "subtitle", "time": 1416.83, "timestamp": "00:23:36", "text": "我同意。"}, {"type": "subtitle", "time": 1421.75, "timestamp": "00:23:41", "text": "這將切換到下一個特價優惠。"}, {"type": "subtitle", "time": 1425.99, "timestamp": "00:23:45", "text": "我們是在討論 Clouty 嗎？哦，是的，但是…"}, {"type": "subtitle", "time": 1430.19, "timestamp": "00:23:50", "text": "但事實並非如此。這是一個令人自豪的故事。"}, {"type": "subtitle", "time": 1433.43, "timestamp": "00:23:53", "text": "就是之前提到的托佩克。好的"}, {"type": "subtitle", "time": 1435.75, "timestamp": "00:23:55", "text": "。"}]
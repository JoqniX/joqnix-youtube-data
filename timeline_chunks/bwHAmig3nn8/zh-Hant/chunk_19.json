[{"type": "subtitle", "time": 1142.75, "timestamp": "00:19:02", "text": "哦，等等。一個。我在聊天室裡寫的"}, {"type": "subtitle", "time": 1147.789, "timestamp": "00:19:07", "text": "我其實不做那種事。"}, {"type": "subtitle", "time": 1152.11, "timestamp": "00:19:12", "text": "這不是真正的我，喬們。寫"}, {"type": "subtitle", "time": 1156.59, "timestamp": "00:19:16", "text": "我的日文寫作能力不太好，所以…"}, {"type": "subtitle", "time": 1163.07, "timestamp": "00:19:23", "text": "我沒有練習過，所以這有點難，所以我就…"}, {"type": "subtitle", "time": 1165.71, "timestamp": "00:19:25", "text": "在這封郵件中，我"}, {"type": "subtitle", "time": 1172.35, "timestamp": "00:19:32", "text": "我說過了。啊，我的慾望，啊，"}, {"type": "subtitle", "time": 1174.35, "timestamp": "00:19:34", "text": "我有很多次"}, {"type": "subtitle", "time": 1178.99, "timestamp": "00:19:38", "text": "是這樣嗎？用日文來說，就是 KYC（了解你的客戶）。"}, {"type": "subtitle", "time": 1183.47, "timestamp": "00:19:43", "text": "我做了很多那樣的事，但是…"}, {"type": "subtitle", "time": 1185.149, "timestamp": "00:19:45", "text": "姓名"}, {"type": "subtitle", "time": 1188.27, "timestamp": "00:19:48", "text": "汽車和MyNaBaka"}, {"type": "subtitle", "time": 1192.27, "timestamp": "00:19:52", "text": "我用NFC掃描了一下，所以…"}, {"type": "subtitle", "time": 1197.149, "timestamp": "00:19:57", "text": "我的名字裡有個空格。"}]
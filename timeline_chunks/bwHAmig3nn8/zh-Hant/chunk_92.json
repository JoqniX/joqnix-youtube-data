[{"type": "subtitle", "time": 5531.51, "timestamp": "01:32:11", "text": "哦，這裡有很多攝影機。矢野"}, {"type": "subtitle", "time": 5536.83, "timestamp": "01:32:16", "text": "這很糟糕。婚外情層出不窮。"}, {"type": "subtitle", "time": 5541.51, "timestamp": "01:32:21", "text": "糟糕，我的佐久早濕了。"}, {"type": "subtitle", "time": 5543.149, "timestamp": "01:32:23", "text": "佐久賀"}, {"type": "chat", "time": 5550.475, "timestamp": "01:32:30", "author": "@hbvcsa", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mA5iYFWQWr-erQfOrpRSPi7uAL1ykOBKRSbPBDp88Z1xyBT7Je5IKp6_AckwgwsDEc-Q=s64-c-k-c0x00ffffff-no-rj", "message": "audio sounds like alien effect is applied"}, {"type": "subtitle", "time": 5552.83, "timestamp": "01:32:32", "text": "這是怎麼回事？母親。"}, {"type": "subtitle", "time": 5555.43, "timestamp": "01:32:35", "text": "債務。"}, {"type": "chat", "time": 5567.161, "timestamp": "01:32:47", "author": "@hbvcsa", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mA5iYFWQWr-erQfOrpRSPi7uAL1ykOBKRSbPBDp88Z1xyBT7Je5IKp6_AckwgwsDEc-Q=s64-c-k-c0x00ffffff-no-rj", "message": "now it's fine"}, {"type": "subtitle", "time": 5576.99, "timestamp": "01:32:56", "text": "我也很抱歉。"}, {"type": "subtitle", "time": 5579.47, "timestamp": "01:32:59", "text": "火"}]
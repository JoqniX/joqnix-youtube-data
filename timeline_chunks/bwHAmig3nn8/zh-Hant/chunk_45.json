[{"type": "subtitle", "time": 2707.589, "timestamp": "00:45:07", "text": "下午一點放學。"}, {"type": "subtitle", "time": 2712.71, "timestamp": "00:45:12", "text": "我要去睡覺。我要去睡覺。"}, {"type": "subtitle", "time": 2717.829, "timestamp": "00:45:17", "text": "為什麼花了這麼長時間？"}, {"type": "subtitle", "time": 2722.309, "timestamp": "00:45:22", "text": "哦，太晚了，太晚了。"}, {"type": "subtitle", "time": 2729.069, "timestamp": "00:45:29", "text": "如果你聽說這是個班級，那麼這就是印度時間。"}, {"type": "subtitle", "time": 2743.109, "timestamp": "00:45:43", "text": "現在還沒到7點。 7點"}, {"type": "subtitle", "time": 2746.27, "timestamp": "00:45:46", "text": "哦，7點鐘"}, {"type": "subtitle", "time": 2752.63, "timestamp": "00:45:52", "text": "啊，一切都始於，啊，印度，時間"}, {"type": "subtitle", "time": 2758.71, "timestamp": "00:45:58", "text": "啊，嗯，它從7點鐘開始，啊，10點鐘開始。"}]
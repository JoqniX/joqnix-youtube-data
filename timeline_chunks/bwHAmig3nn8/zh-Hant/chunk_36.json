[{"type": "subtitle", "time": 2161.99, "timestamp": "00:36:01", "text": "哦，說，說，說"}, {"type": "subtitle", "time": 2164.91, "timestamp": "00:36:04", "text": "很有趣。"}, {"type": "subtitle", "time": 2167.43, "timestamp": "00:36:07", "text": "這。"}, {"type": "subtitle", "time": 2170.43, "timestamp": "00:36:10", "text": "這還挺有意思的。"}, {"type": "subtitle", "time": 2172.829, "timestamp": "00:36:12", "text": "太好了。"}, {"type": "subtitle", "time": 2176.15, "timestamp": "00:36:16", "text": "哦，等等。現在幾點？"}, {"type": "subtitle", "time": 2187.67, "timestamp": "00:36:27", "text": "6"}, {"type": "subtitle", "time": 2191.069, "timestamp": "00:36:31", "text": "啊，8:06"}, {"type": "subtitle", "time": 2195.43, "timestamp": "00:36:35", "text": "8:00 8:03"}, {"type": "subtitle", "time": 2197.19, "timestamp": "00:36:37", "text": "分分鐘"}, {"type": "subtitle", "time": 2199.349, "timestamp": "00:36:39", "text": "正確的？"}, {"type": "subtitle", "time": 2206.15, "timestamp": "00:36:46", "text": "哦，我總是能在這房子裡聽到鋼琴聲。"}, {"type": "subtitle", "time": 2210.589, "timestamp": "00:36:50", "text": "。我現在聽到的是鋼琴曲。"}, {"type": "subtitle", "time": 2214.23, "timestamp": "00:36:54", "text": "聽著，我聽不見你說話。為什麼？"}, {"type": "subtitle", "time": 2216.55, "timestamp": "00:36:56", "text": "一點點"}, {"type": "subtitle", "time": 2219.51, "timestamp": "00:36:59", "text": "我只在這裡待一會兒。"}]
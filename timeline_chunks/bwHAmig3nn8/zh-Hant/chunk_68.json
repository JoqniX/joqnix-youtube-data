[{"type": "subtitle", "time": 4080.99, "timestamp": "01:08:00", "text": "我到家後，打開了電源。"}, {"type": "subtitle", "time": 4086.069, "timestamp": "01:08:06", "text": "拿著這張紙去便利商店，7-Eleven。"}, {"type": "subtitle", "time": 4089.67, "timestamp": "01:08:09", "text": "我去付錢。就一點點這個"}, {"type": "subtitle", "time": 4093.789, "timestamp": "01:08:13", "text": "我已經忘了這件事了。最終目的都是為了個人利益。"}, {"type": "subtitle", "time": 4097.59, "timestamp": "01:08:17", "text": "。這是不允許的。我把這件事忘了。"}, {"type": "subtitle", "time": 4101.749, "timestamp": "01:08:21", "text": "。對不起。我把這件事忘了。"}, {"type": "subtitle", "time": 4114.149, "timestamp": "01:08:34", "text": "塔。是的。爸爸"}, {"type": "subtitle", "time": 4117.829, "timestamp": "01:08:37", "text": "。每次"}, {"type": "subtitle", "time": 4122.149, "timestamp": "01:08:42", "text": "。是的。我們都自由了。"}, {"type": "subtitle", "time": 4126.91, "timestamp": "01:08:46", "text": "是。啊，我們走吧。是的。"}, {"type": "subtitle", "time": 4130.11, "timestamp": "01:08:50", "text": "好。"}, {"type": "subtitle", "time": 4134.63, "timestamp": "01:08:54", "text": "現在雨下得不大，哦，現在只是下著小雨。"}, {"type": "subtitle", "time": 4137.03, "timestamp": "01:08:57", "text": "正確的？"}]
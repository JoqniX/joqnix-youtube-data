[{"type": "subtitle", "time": 3660.549, "timestamp": "01:01:00", "text": "這是哪裡？"}, {"type": "subtitle", "time": 3663.75, "timestamp": "01:01:03", "text": "它何時開始下降的？我"}, {"type": "subtitle", "time": 3667.029, "timestamp": "01:01:07", "text": "你買過這個嗎？"}, {"type": "subtitle", "time": 3670.47, "timestamp": "01:01:10", "text": "在哪裡？哦，Meta，我看到了，Meta。"}, {"type": "subtitle", "time": 3672.549, "timestamp": "01:01:12", "text": "這，"}, {"type": "subtitle", "time": 3677.15, "timestamp": "01:01:17", "text": "哦，等等，這是來自 Instagram 的內容。這是Instagram"}, {"type": "subtitle", "time": 3679.829, "timestamp": "01:01:19", "text": "我打開了Instagram Stories。"}, {"type": "subtitle", "time": 3683.43, "timestamp": "01:01:23", "text": "這是個短片，但是"}, {"type": "subtitle", "time": 3685.51, "timestamp": "01:01:25", "text": "對不起。"}, {"type": "subtitle", "time": 3687.95, "timestamp": "01:01:27", "text": "是的。"}, {"type": "subtitle", "time": 3693.549, "timestamp": "01:01:33", "text": "這個。這是6月5日出版的《Pamagazine》雜誌。"}, {"type": "subtitle", "time": 3697.029, "timestamp": "01:01:37", "text": "這是來自Valplanet的Luca，哦，什麼"}, {"type": "subtitle", "time": 3700.589, "timestamp": "01:01:40", "text": "是嗎？哦，她的名字是美彌小姐嗎？"}, {"type": "subtitle", "time": 3702.51, "timestamp": "01:01:42", "text": "我不知道。我忘了。對不起"}, {"type": "subtitle", "time": 3706.23, "timestamp": "01:01:46", "text": "去做。對不起。這個，這個"}, {"type": "subtitle", "time": 3709.549, "timestamp": "01:01:49", "text": "這就是陰謀集團的兩名成員。哇，太棒了。"}, {"type": "subtitle", "time": 3712.829, "timestamp": "01:01:52", "text": "我讀過很多遍了。啊，雜誌"}, {"type": "subtitle", "time": 3718.549, "timestamp": "01:01:58", "text": "太棒了。真是太棒了。"}]
[{"type": "subtitle", "time": 7344.35, "timestamp": "02:02:24", "text": "是的，我回來了。不掛。啊，"}, {"type": "subtitle", "time": 7356.589, "timestamp": "02:02:36", "text": "不掛。"}, {"type": "subtitle", "time": 7362.75, "timestamp": "02:02:42", "text": "日文「翻滾」一詞是什麼？"}, {"type": "subtitle", "time": 7366.79, "timestamp": "02:02:46", "text": "我忘了。什麼是交叉滾？"}]
[{"type": "subtitle", "time": 242.309, "timestamp": "00:04:02", "text": "今天清晨。哦，今天輪到眼睛了。今天，"}, {"type": "subtitle", "time": 245.47, "timestamp": "00:04:05", "text": "我直播結束得有點早了。一個，"}, {"type": "subtitle", "time": 248.50900000000001, "timestamp": "00:04:08", "text": "我想我們應該就此結束了。是的，"}, {"type": "subtitle", "time": 250.75, "timestamp": "00:04:10", "text": "哦，是的。"}, {"type": "subtitle", "time": 253.19, "timestamp": "00:04:13", "text": "是的。嗯，我希望我是"}, {"type": "subtitle", "time": 254.50900000000001, "timestamp": "00:04:14", "text": "可聽見的"}, {"type": "subtitle", "time": 257.069, "timestamp": "00:04:17", "text": "就像在下雨一樣"}, {"type": "subtitle", "time": 258.909, "timestamp": "00:04:18", "text": "現在很像"}, {"type": "subtitle", "time": 260.59, "timestamp": "00:04:20", "text": "史普林格斯"}, {"type": "subtitle", "time": 265.749, "timestamp": "00:04:25", "text": "哦，等等。為什麼現在會說英語？"}, {"type": "subtitle", "time": 271.749, "timestamp": "00:04:31", "text": "。哦，雨下得很大。"}, {"type": "subtitle", "time": 275.99, "timestamp": "00:04:35", "text": "但現在，嗯，"}, {"type": "subtitle", "time": 279.43, "timestamp": "00:04:39", "text": "就一點點，哦，是什麼來著？"}, {"type": "subtitle", "time": 282.59000000000003, "timestamp": "00:04:42", "text": "水滴彈簧啊，日本"}, {"type": "subtitle", "time": 286.029, "timestamp": "00:04:46", "text": "那是什麼來著？我忘了。我已經忘了"}, {"type": "subtitle", "time": 289.59000000000003, "timestamp": "00:04:49", "text": "我做到了。大家幫幫我。"}, {"type": "subtitle", "time": 292.39, "timestamp": "00:04:52", "text": "我什麼都忘了。"}, {"type": "subtitle", "time": 299.189, "timestamp": "00:04:59", "text": "夠了。但是，今天，啊，"}]
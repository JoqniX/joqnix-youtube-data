[{"type": "subtitle", "time": 4141.309, "timestamp": "01:09:01", "text": "啊，倒也未必。"}, {"type": "subtitle", "time": 4144.59, "timestamp": "01:09:04", "text": "因為沒有點擊量。"}, {"type": "subtitle", "time": 4150.309, "timestamp": "01:09:10", "text": "我，哦，這聲音，哦，觸摸，哦，本吉"}, {"type": "subtitle", "time": 4154.709, "timestamp": "01:09:14", "text": "我的腳現在很痛，因為我摸得太多了。"}, {"type": "subtitle", "time": 4156.59, "timestamp": "01:09:16", "text": "喲。"}, {"type": "subtitle", "time": 4158.709, "timestamp": "01:09:18", "text": "哇，"}, {"type": "subtitle", "time": 4161.59, "timestamp": "01:09:21", "text": "奇怪的。"}, {"type": "subtitle", "time": 4169.47, "timestamp": "01:09:29", "text": "哦，完全不是。"}, {"type": "subtitle", "time": 4171.59, "timestamp": "01:09:31", "text": "牙齒"}, {"type": "subtitle", "time": 4177.47, "timestamp": "01:09:37", "text": "我的腳開始痛了。嘿，為什麼？"}, {"type": "subtitle", "time": 4190.229, "timestamp": "01:09:50", "text": "。"}, {"type": "subtitle", "time": 4199.07, "timestamp": "01:09:59", "text": "電劍。是的。第八。今天，今天，"}]
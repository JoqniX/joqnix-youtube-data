[{"type": "subtitle", "time": 841.189, "timestamp": "00:14:01", "text": "功勞歸於……喔不，不是那個，大衛"}, {"type": "subtitle", "time": 845.79, "timestamp": "00:14:05", "text": "這些卡片都不一樣，哦，銀行的卡爾"}, {"type": "subtitle", "time": 850.11, "timestamp": "00:14:10", "text": "是的，我常用這張卡。"}, {"type": "subtitle", "time": 852.829, "timestamp": "00:14:12", "text": "線上訂閱和支付"}, {"type": "subtitle", "time": 857.23, "timestamp": "00:14:17", "text": "使用PayPal付款，或將其存入PayPal帳戶。"}, {"type": "subtitle", "time": 861.509, "timestamp": "00:14:21", "text": "啊，虛擬主播"}, {"type": "subtitle", "time": 865.79, "timestamp": "00:14:25", "text": "購買燒焦的或乾燥的"}, {"type": "subtitle", "time": 867.11, "timestamp": "00:14:27", "text": "我還沒買伊斯特拉斯。"}, {"type": "subtitle", "time": 873.31, "timestamp": "00:14:33", "text": "它叫做疊加層嗎？或是疊加之類的。"}, {"type": "subtitle", "time": 880.55, "timestamp": "00:14:40", "text": "嘿，連我都去過日本了，現在我…"}, {"type": "subtitle", "time": 882.11, "timestamp": "00:14:42", "text": "滿的"}, {"type": "subtitle", "time": 887.87, "timestamp": "00:14:47", "text": "努力工作就能賺錢。這筆錢"}, {"type": "subtitle", "time": 890.629, "timestamp": "00:14:50", "text": "一點點"}, {"type": "subtitle", "time": 894.87, "timestamp": "00:14:54", "text": "你想稍微利用一下這個目的嗎？"}]
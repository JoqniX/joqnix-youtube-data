[{"type": "subtitle", "time": 3481.789, "timestamp": "00:58:01", "text": "我同意。我覺得我永遠聽不懂日文的Lisna。"}, {"type": "subtitle", "time": 3486.95, "timestamp": "00:58:06", "text": "看看這位先生/女士。里斯納斯。"}, {"type": "subtitle", "time": 3490.75, "timestamp": "00:58:10", "text": "那樣做會更好。日語"}, {"type": "subtitle", "time": 3496.27, "timestamp": "00:58:16", "text": "邊講邊教。"}, {"type": "subtitle", "time": 3501.19, "timestamp": "00:58:21", "text": "Terunoa，請告訴我梵法是否有所不同。"}, {"type": "subtitle", "time": 3516.67, "timestamp": "00:58:36", "text": "大津我渡過的半尼菊名"}, {"type": "subtitle", "time": 3520.349, "timestamp": "00:58:40", "text": "我也這麼認為。"}, {"type": "subtitle", "time": 3524.19, "timestamp": "00:58:44", "text": "今天，這"}, {"type": "subtitle", "time": 3527.63, "timestamp": "00:58:47", "text": "我覺得很方便。"}, {"type": "subtitle", "time": 3529.99, "timestamp": "00:58:49", "text": "是的。"}, {"type": "subtitle", "time": 3532.789, "timestamp": "00:58:52", "text": "可能在 X 上"}, {"type": "subtitle", "time": 3535.71, "timestamp": "00:58:55", "text": "哦，什麼是 X 標籤？"}, {"type": "subtitle", "time": 3538.029, "timestamp": "00:58:58", "text": "我不明白"}]
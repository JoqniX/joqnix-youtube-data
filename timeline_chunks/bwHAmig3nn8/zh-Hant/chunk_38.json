[{"type": "subtitle", "time": 2281.91, "timestamp": "00:38:01", "text": "一點點"}, {"type": "subtitle", "time": 2287.95, "timestamp": "00:38:07", "text": "我輕輕碰一下。哦，還有九點鐘"}, {"type": "subtitle", "time": 2289.51, "timestamp": "00:38:09", "text": "到"}, {"type": "subtitle", "time": 2294.99, "timestamp": "00:38:14", "text": "我要回家了。是的。 9點00分，9點30分"}, {"type": "subtitle", "time": 2298.71, "timestamp": "00:38:18", "text": "我現在要回家了。時間不多了。一點點"}, {"type": "subtitle", "time": 2302.71, "timestamp": "00:38:22", "text": "就談談這個吧。今天的直播很短。"}, {"type": "subtitle", "time": 2307.19, "timestamp": "00:38:27", "text": "抱歉。像這樣"}, {"type": "subtitle", "time": 2310.03, "timestamp": "00:38:30", "text": "今天的廣播節目會很短。"}, {"type": "subtitle", "time": 2312.19, "timestamp": "00:38:32", "text": "是。"}, {"type": "subtitle", "time": 2333.47, "timestamp": "00:38:53", "text": "對不起，伊桑"}, {"type": "subtitle", "time": 2335.47, "timestamp": "00:38:55", "text": "一個"}]
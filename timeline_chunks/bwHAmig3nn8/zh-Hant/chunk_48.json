[{"type": "subtitle", "time": 2892.349, "timestamp": "00:48:12", "text": "我的天哪，太瘋狂了，才過了3個小時"}, {"type": "subtitle", "time": 2898.109, "timestamp": "00:48:18", "text": "我現在要睡覺了，這樣不好嗎？"}, {"type": "subtitle", "time": 2908.309, "timestamp": "00:48:28", "text": "這大概是星期一吧。"}, {"type": "subtitle", "time": 2910.589, "timestamp": "00:48:30", "text": "星期二和"}, {"type": "subtitle", "time": 2912.309, "timestamp": "00:48:32", "text": "週四"}, {"type": "subtitle", "time": 2917.95, "timestamp": "00:48:37", "text": "是嗎？我不知道。真的很難。這"}, {"type": "subtitle", "time": 2925.309, "timestamp": "00:48:45", "text": "二月裡沒有二月這種說法。啊，這大概是…"}, {"type": "subtitle", "time": 2928.99, "timestamp": "00:48:48", "text": "啊，這，這，這門課是"}, {"type": "subtitle", "time": 2930.63, "timestamp": "00:48:50", "text": "也許"}, {"type": "subtitle", "time": 2933.95, "timestamp": "00:48:53", "text": "啊，大概是吧。"}, {"type": "subtitle", "time": 2935.789, "timestamp": "00:48:55", "text": "2個月"}, {"type": "subtitle", "time": 2939.47, "timestamp": "00:48:59", "text": "僅有的。僅兩個月。是的，是的，是的。 2"}]
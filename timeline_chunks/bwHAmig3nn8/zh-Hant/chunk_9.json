[{"type": "subtitle", "time": 543.91, "timestamp": "00:09:03", "text": "那是個問題。順便說一下，我的手機號碼目前是"}, {"type": "subtitle", "time": 551.11, "timestamp": "00:09:11", "text": "這個號碼來自樂天，但它是我的贊助商。"}, {"type": "subtitle", "time": 554.67, "timestamp": "00:09:14", "text": "桑先生是印度學院的贊助人。"}, {"type": "subtitle", "time": 561.11, "timestamp": "00:09:21", "text": "有了 Sanasan 的 Critty 卡"}, {"type": "subtitle", "time": 575.35, "timestamp": "00:09:35", "text": "與原作者合作，於四月"}, {"type": "subtitle", "time": 581.19, "timestamp": "00:09:41", "text": "這些並非四月和五月的費用。啊，棉蘭是"}, {"type": "subtitle", "time": 586.509, "timestamp": "00:09:46", "text": "處理付款真是件麻煩事。現在情況非常困難。"}, {"type": "subtitle", "time": 589.87, "timestamp": "00:09:49", "text": "事情確實如此。我不知道了。嘟嘟"}, {"type": "subtitle", "time": 593.87, "timestamp": "00:09:53", "text": "我不知道該怎麼辦。嚴重地"}]
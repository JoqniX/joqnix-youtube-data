[{"type": "subtitle", "time": 3361.87, "timestamp": "00:56:01", "text": "嘿。等一下。那麼那些付費用戶呢？"}, {"type": "subtitle", "time": 3368.349, "timestamp": "00:56:08", "text": "但他們來不了。不是這樣的。唔。"}, {"type": "subtitle", "time": 3377.95, "timestamp": "00:56:17", "text": "這個多少錢來著？哦，6。"}, {"type": "subtitle", "time": 3383.549, "timestamp": "00:56:23", "text": "6日元。等待 6000。"}, {"type": "subtitle", "time": 3396.789, "timestamp": "00:56:36", "text": "這個多少錢來著？"}, {"type": "subtitle", "time": 3403.19, "timestamp": "00:56:43", "text": "6000"}, {"type": "subtitle", "time": 3405.349, "timestamp": "00:56:45", "text": "不，不是那樣。傻子。"}, {"type": "subtitle", "time": 3406.91, "timestamp": "00:56:46", "text": "6000。6000。"}, {"type": "subtitle", "time": 3408.789, "timestamp": "00:56:48", "text": "是的。是的。是的。是的。 6000"}]
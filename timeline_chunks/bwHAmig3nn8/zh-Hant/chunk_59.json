[{"type": "subtitle", "time": 3541.43, "timestamp": "00:59:01", "text": "可能不會。"}, {"type": "subtitle", "time": 3547.75, "timestamp": "00:59:07", "text": "給我一個擁抱，再加一個甜蜜的擁抱。"}, {"type": "subtitle", "time": 3551.309, "timestamp": "00:59:11", "text": "我當時正在這樣做，但是使用話題標籤"}, {"type": "subtitle", "time": 3554.069, "timestamp": "00:59:14", "text": "我不知道該怎麼做。"}, {"type": "subtitle", "time": 3573.19, "timestamp": "00:59:33", "text": "嗯，我在午餐時間說了聲早安。怎麼樣了？"}, {"type": "subtitle", "time": 3576.23, "timestamp": "00:59:36", "text": "我用話題標籤做了一點tt。"}, {"type": "subtitle", "time": 3579.91, "timestamp": "00:59:39", "text": "是的，我會。但，"}, {"type": "subtitle", "time": 3583.75, "timestamp": "00:59:43", "text": "今天是六月，對吧？等等，等等，等等，六月"}, {"type": "subtitle", "time": 3588.67, "timestamp": "00:59:48", "text": "手。我會看的。今天我遇到了安雅"}, {"type": "subtitle", "time": 3590.829, "timestamp": "00:59:50", "text": "我去那裡的時候。"}, {"type": "subtitle", "time": 3593.789, "timestamp": "00:59:53", "text": "我去霍尼亞的時候。我來看看這張照片。"}, {"type": "subtitle", "time": 3598.349, "timestamp": "00:59:58", "text": "。不掛。我來看看這張照片。這。這"}]
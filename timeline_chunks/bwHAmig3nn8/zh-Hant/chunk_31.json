[{"type": "subtitle", "time": 1864.669, "timestamp": "00:31:04", "text": "我老公有點……吵鬧。"}, {"type": "subtitle", "time": 1866.629, "timestamp": "00:31:06", "text": "從"}, {"type": "subtitle", "time": 1869.87, "timestamp": "00:31:09", "text": "媒體噪音"}, {"type": "subtitle", "time": 1873.71, "timestamp": "00:31:13", "text": "我想試試。我想看看。是"}, {"type": "subtitle", "time": 1875.43, "timestamp": "00:31:15", "text": "嘿。"}, {"type": "subtitle", "time": 1877.31, "timestamp": "00:31:17", "text": "現在"}, {"type": "subtitle", "time": 1881.029, "timestamp": "00:31:21", "text": "噪音抑制"}, {"type": "subtitle", "time": 1888.269, "timestamp": "00:31:28", "text": "哈爾東丹。"}, {"type": "subtitle", "time": 1892.629, "timestamp": "00:31:32", "text": "這越來越難了。"}, {"type": "subtitle", "time": 1895.549, "timestamp": "00:31:35", "text": "是的。"}]
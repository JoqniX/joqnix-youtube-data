[{"type": "subtitle", "time": 4804.27, "timestamp": "01:20:04", "text": "我要去那裡。一起"}, {"type": "subtitle", "time": 4810.709, "timestamp": "01:20:10", "text": "我們一起去吧。下起了瓢潑大雨。"}, {"type": "subtitle", "time": 4813.629, "timestamp": "01:20:13", "text": "是的。哦，不。"}, {"type": "subtitle", "time": 4817.31, "timestamp": "01:20:17", "text": "下雨了。"}, {"type": "subtitle", "time": 4825.11, "timestamp": "01:20:25", "text": "十字路口"}, {"type": "subtitle", "time": 4827.07, "timestamp": "01:20:27", "text": "哇"}, {"type": "subtitle", "time": 4831.59, "timestamp": "01:20:31", "text": "一點點"}, {"type": "subtitle", "time": 4834.229, "timestamp": "01:20:34", "text": "但"}, {"type": "subtitle", "time": 4844.189, "timestamp": "01:20:44", "text": "好好乾。運動健將"}, {"type": "subtitle", "time": 4847.229, "timestamp": "01:20:47", "text": "我會堅守我的崗位。"}, {"type": "subtitle", "time": 4851.149, "timestamp": "01:20:51", "text": "為什麼要保護？為了保護。"}]
[{"type": "subtitle", "time": 2128.51, "timestamp": "00:35:28", "text": "夜裡，哦，夜裡，就一會兒，外面下著雨的時候"}, {"type": "subtitle", "time": 2133.43, "timestamp": "00:35:33", "text": "我帶媽媽出去散步，還做了個直播。"}, {"type": "subtitle", "time": 2140.71, "timestamp": "00:35:40", "text": "我想解釋一下我的思考方式以及如何表達它。"}, {"type": "subtitle", "time": 2144.87, "timestamp": "00:35:44", "text": "史塔"}, {"type": "subtitle", "time": 2146.55, "timestamp": "00:35:46", "text": "啊"}, {"type": "subtitle", "time": 2148.15, "timestamp": "00:35:48", "text": "，"}, {"type": "subtitle", "time": 2153.51, "timestamp": "00:35:53", "text": "哦，『遙遠』到底是什麼意思來著？"}, {"type": "subtitle", "time": 2156.63, "timestamp": "00:35:56", "text": "我忘了。"}]
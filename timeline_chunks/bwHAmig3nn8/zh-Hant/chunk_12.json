[{"type": "subtitle", "time": 720.629, "timestamp": "00:12:00", "text": "我剛才說到哪裡了？"}, {"type": "subtitle", "time": 724.069, "timestamp": "00:12:04", "text": "難道不是嗎？現在。是的。剛才，剛才"}, {"type": "subtitle", "time": 729.069, "timestamp": "00:12:09", "text": "我不會忘記這些話。是的。早些時候"}, {"type": "subtitle", "time": 736.509, "timestamp": "00:12:16", "text": "你想聊什麼？我們來談談。我們聊了一下。"}, {"type": "subtitle", "time": 740.87, "timestamp": "00:12:20", "text": "當時在做什麼？"}, {"type": "subtitle", "time": 743.75, "timestamp": "00:12:23", "text": "我去了嗎？唔？我去了嗎？是的。"}, {"type": "subtitle", "time": 748.55, "timestamp": "00:12:28", "text": "是嗎？是的。日語越來越難了。"}, {"type": "subtitle", "time": 753.43, "timestamp": "00:12:33", "text": "已經。是的。那是什麼來著？"}, {"type": "subtitle", "time": 757.35, "timestamp": "00:12:37", "text": "這真是太麻煩了。哦，我自己的，我自己的"}, {"type": "subtitle", "time": 760.55, "timestamp": "00:12:40", "text": "不，它已經不是信用卡了。"}, {"type": "subtitle", "time": 765.43, "timestamp": "00:12:45", "text": "。這個栗子不好。這真的很難。"}, {"type": "subtitle", "time": 770.59, "timestamp": "00:12:50", "text": "事情最終會變成這樣。如果你捲髮過度…"}, {"type": "subtitle", "time": 774.31, "timestamp": "00:12:54", "text": "我認為情況變得非常困難。這"}, {"type": "subtitle", "time": 777.35, "timestamp": "00:12:57", "text": "它太硬。"}]
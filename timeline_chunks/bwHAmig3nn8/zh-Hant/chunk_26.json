[{"type": "chat", "time": 1568.188, "timestamp": "00:26:08", "author": "@MikazukiYure", "avatar": "https://yt4.ggpht.com/uuFSD7qVrZy0JUWrBRfSfEKIQpib7_2xP24Yiu1ND1Mq6uhaYIHDnA5EiGz_o33FUhHYvbCT9g=s64-c-k-c0x00ffffff-no-rj", "message": "btw there's early access for collab quest"}, {"type": "subtitle", "time": 1572.549, "timestamp": "00:26:12", "text": "下週六，下週"}, {"type": "subtitle", "time": 1574.63, "timestamp": "00:26:14", "text": "也許我"}, {"type": "subtitle", "time": 1580.99, "timestamp": "00:26:20", "text": "我要去那裡。"}, {"type": "subtitle", "time": 1584.63, "timestamp": "00:26:24", "text": "我打算去。"}, {"type": "subtitle", "time": 1589.35, "timestamp": "00:26:29", "text": "不掛。哦，等等，等等。週六"}, {"type": "subtitle", "time": 1592.269, "timestamp": "00:26:32", "text": "我不確定今天是不是星期天。"}, {"type": "subtitle", "time": 1595.23, "timestamp": "00:26:35", "text": "稍等。我會關注安多爾。一點點"}, {"type": "subtitle", "time": 1597.149, "timestamp": "00:26:37", "text": "僅有的"}, {"type": "subtitle", "time": 1600.71, "timestamp": "00:26:40", "text": "我把這件事忘了。啊，今天是星期天。"}, {"type": "subtitle", "time": 1606.029, "timestamp": "00:26:46", "text": "喲。本週日。是的。"}, {"type": "subtitle", "time": 1610.83, "timestamp": "00:26:50", "text": "這個星期天我打算坐一小段特快列車出去玩。"}, {"type": "subtitle", "time": 1612.99, "timestamp": "00:26:52", "text": "手"}, {"type": "subtitle", "time": 1614.789, "timestamp": "00:26:54", "text": "也許"}, {"type": "subtitle", "time": 1618.83, "timestamp": "00:26:58", "text": "我覺得這件事大概已經結束了。"}]
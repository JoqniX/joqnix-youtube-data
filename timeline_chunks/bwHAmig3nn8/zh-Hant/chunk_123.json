[{"type": "subtitle", "time": 7388.189, "timestamp": "02:03:08", "text": "我成功越過了無人機。"}, {"type": "subtitle", "time": 7392.149, "timestamp": "02:03:12", "text": "不掛。我是克林"}, {"type": "subtitle", "time": 7395.709, "timestamp": "02:03:15", "text": "在路上"}, {"type": "subtitle", "time": 7399.069, "timestamp": "02:03:19", "text": "我走了這條路"}, {"type": "subtitle", "time": 7403.83, "timestamp": "02:03:23", "text": "他們正在過馬路。他們正在過馬路。我明白。"}, {"type": "subtitle", "time": 7406.31, "timestamp": "02:03:26", "text": "啊。"}, {"type": "subtitle", "time": 7408.83, "timestamp": "02:03:28", "text": "是的。"}, {"type": "subtitle", "time": 7411.31, "timestamp": "02:03:31", "text": "啊，"}, {"type": "subtitle", "time": 7413.189, "timestamp": "02:03:33", "text": "假名"}, {"type": "subtitle", "time": 7414.75, "timestamp": "02:03:34", "text": "。"}, {"type": "subtitle", "time": 7420.83, "timestamp": "02:03:40", "text": "否。 Defon。 Defon。"}, {"type": "subtitle", "time": 7430.87, "timestamp": "02:03:50", "text": "在"}, {"type": "subtitle", "time": 7433.83, "timestamp": "02:03:53", "text": "特克"}, {"type": "subtitle", "time": 7436.189, "timestamp": "02:03:56", "text": "Ta Tekefuumuke"}]
[{"type": "subtitle", "time": 3148.99, "timestamp": "00:52:28", "text": "1130"}, {"type": "subtitle", "time": 3150.51, "timestamp": "00:52:30", "text": "分分鐘"}, {"type": "subtitle", "time": 3154.43, "timestamp": "00:52:34", "text": "嘿。為什麼這麼慢？"}, {"type": "subtitle", "time": 3159.71, "timestamp": "00:52:39", "text": "是的，我會。這很難，不是嗎？"}, {"type": "subtitle", "time": 3165.75, "timestamp": "00:52:45", "text": "那就是我們。啊，我明天要去上班。"}, {"type": "subtitle", "time": 3169.589, "timestamp": "00:52:49", "text": "時區和時區是一樣的。"}, {"type": "subtitle", "time": 3173.67, "timestamp": "00:52:53", "text": "但這不難嗎？這是什麼？"}, {"type": "subtitle", "time": 3176.109, "timestamp": "00:52:56", "text": "。"}]
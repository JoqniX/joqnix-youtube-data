[{"type": "subtitle", "time": 2400.19, "timestamp": "00:40:00", "text": "這也是一種練習。"}, {"type": "subtitle", "time": 2404.51, "timestamp": "00:40:04", "text": "啊，日本"}, {"type": "subtitle", "time": 2407.109, "timestamp": "00:40:07", "text": "啊，我們來聊聊吧。"}, {"type": "subtitle", "time": 2409.87, "timestamp": "00:40:09", "text": "我認為"}, {"type": "subtitle", "time": 2413.67, "timestamp": "00:40:13", "text": "諾亞，該練習了。"}, {"type": "subtitle", "time": 2417.71, "timestamp": "00:40:17", "text": "請這樣想。"}, {"type": "subtitle", "time": 2422.47, "timestamp": "00:40:22", "text": "給我。啊，我在想[清嗓子] 我在想"}, {"type": "subtitle", "time": 2426.19, "timestamp": "00:40:26", "text": "是。是的。"}, {"type": "subtitle", "time": 2429.829, "timestamp": "00:40:29", "text": "我已經做不好了。為什麼？不，"}, {"type": "subtitle", "time": 2435.27, "timestamp": "00:40:35", "text": "最近用英語。我最近不太會看電影了。"}, {"type": "subtitle", "time": 2437.19, "timestamp": "00:40:37", "text": "為什麼"}, {"type": "subtitle", "time": 2442.75, "timestamp": "00:40:42", "text": "她不是媽媽。為什麼？為什麼？出色地，"}, {"type": "subtitle", "time": 2454.303, "timestamp": "00:40:54", "text": "啊，"}, {"type": "subtitle", "time": 2457.23, "timestamp": "00:40:57", "text": "[嗤笑] 等一下。一點謎題"}, {"type": "subtitle", "time": 2458.91, "timestamp": "00:40:58", "text": "到"}]
[{"type": "subtitle", "time": 368.15, "timestamp": "00:06:08", "text": "或者。啊，日元"}, {"type": "subtitle", "time": 373.23, "timestamp": "00:06:13", "text": "我也這麼認為。這是卡薩梅丹。這是正確的。"}, {"type": "subtitle", "time": 378.029, "timestamp": "00:06:18", "text": "嘿。這塊蛋奶凍我沒辦法再用了。"}, {"type": "subtitle", "time": 382.27, "timestamp": "00:06:22", "text": "喲。這是奇怪的奶凍"}, {"type": "subtitle", "time": 384.749, "timestamp": "00:06:24", "text": "但這有點過頭了。"}, {"type": "subtitle", "time": 391.95, "timestamp": "00:06:31", "text": "應該沒問題。是的。是的。今天"}, {"type": "subtitle", "time": 394.749, "timestamp": "00:06:34", "text": "今天。哦，是的，是的，是的。哦，我忘了。"}, {"type": "subtitle", "time": 398.23, "timestamp": "00:06:38", "text": "我正在跟你講這個故事。是的。今天"}, {"type": "subtitle", "time": 410.23, "timestamp": "00:06:50", "text": "我那時才意識到，我的，我的"}, {"type": "subtitle", "time": 413.23, "timestamp": "00:06:53", "text": "我沒有 我有"}, {"type": "subtitle", "time": 416.23, "timestamp": "00:06:56", "text": "嗯？啊，"}]
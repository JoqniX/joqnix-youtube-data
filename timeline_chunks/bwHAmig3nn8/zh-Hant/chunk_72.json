[{"type": "subtitle", "time": 4320.47, "timestamp": "01:12:00", "text": "我是。"}, {"type": "subtitle", "time": 4324.87, "timestamp": "01:12:04", "text": "沒關係。我正在把它翻譯成英文。你還好嗎？"}, {"type": "chat", "time": 4326.478, "timestamp": "01:12:06", "author": "@Dragnozer", "avatar": "https://yt4.ggpht.com/S76Kh7cHFwpQNz9yjhQC88CHN2CaFRgcX6E1lcl7bEXBNP_DPdf1iSETHK2qlrHYkwo6BbPw=s64-c-k-c0x00ffffff-no-rj", "message": "yayyy thankyou"}, {"type": "subtitle", "time": 4328.99, "timestamp": "01:12:08", "text": "。這些話，不知怎的，我"}, {"type": "subtitle", "time": 4336.709, "timestamp": "01:12:16", "text": "這是什麼？我現在說的是日語，請把它翻譯成英語。"}, {"type": "subtitle", "time": 4348.87, "timestamp": "01:12:28", "text": "我現在到家了，電也恢復了。"}, {"type": "subtitle", "time": 4355.189, "timestamp": "01:12:35", "text": "我把價格計數器鏡子帶到了7-11便利商店。"}, {"type": "subtitle", "time": 4362.31, "timestamp": "01:12:42", "text": "哦，我現在就關掉它，然後去交電費。"}, {"type": "chat", "time": 4374.48, "timestamp": "01:12:54", "author": "@Dragnozer", "avatar": "https://yt4.ggpht.com/S76Kh7cHFwpQNz9yjhQC88CHN2CaFRgcX6E1lcl7bEXBNP_DPdf1iSETHK2qlrHYkwo6BbPw=s64-c-k-c0x00ffffff-no-rj", "message": "mhhmmm"}]
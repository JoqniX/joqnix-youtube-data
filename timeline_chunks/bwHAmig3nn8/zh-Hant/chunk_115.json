[{"type": "subtitle", "time": 6908.189, "timestamp": "01:55:08", "text": "我必須穿上SP"}, {"type": "subtitle", "time": 6910.43, "timestamp": "01:55:10", "text": "明天。"}, {"type": "subtitle", "time": 6911.87, "timestamp": "01:55:11", "text": "我必須這麼做，我的天。我有"}, {"type": "subtitle", "time": 6914.589, "timestamp": "01:55:14", "text": "走路要小心。"}, {"type": "subtitle", "time": 6924.03, "timestamp": "01:55:24", "text": "我的腳被卡住了。"}, {"type": "subtitle", "time": 6928.27, "timestamp": "01:55:28", "text": "它被淋濕了。哇。"}, {"type": "subtitle", "time": 6931.03, "timestamp": "01:55:31", "text": "為什麼要做這麼多？"}, {"type": "subtitle", "time": 6932.83, "timestamp": "01:55:32", "text": "我剛進入"}, {"type": "subtitle", "time": 6936.109, "timestamp": "01:55:36", "text": "一點。"}, {"type": "subtitle", "time": 6942.55, "timestamp": "01:55:42", "text": "doyouseeJapan"}, {"type": "subtitle", "time": 6947.669, "timestamp": "01:55:47", "text": "CanyouseeJapanes"}, {"type": "subtitle", "time": 6950.43, "timestamp": "01:55:50", "text": "雨？"}]
[{"type": "subtitle", "time": 4025.19, "timestamp": "01:07:05", "text": "我會在直播中觀看。無論我的狀態如何，"}, {"type": "subtitle", "time": 4035.269, "timestamp": "01:07:15", "text": "艾莉婭是不是很棒？"}, {"type": "subtitle", "time": 4039.75, "timestamp": "01:07:19", "text": "哦真的嗎？驚人的。太棒了。這"}, {"type": "subtitle", "time": 4042.63, "timestamp": "01:07:22", "text": "艾莉婭。"}, {"type": "subtitle", "time": 4050.23, "timestamp": "01:07:30", "text": "是的。"}, {"type": "subtitle", "time": 4054.87, "timestamp": "01:07:34", "text": "太棒了。哦，我忘了。我，我"}, {"type": "subtitle", "time": 4058.99, "timestamp": "01:07:38", "text": "沒有電，啊，電力"}, {"type": "subtitle", "time": 4061.15, "timestamp": "01:07:41", "text": "米亞"}, {"type": "subtitle", "time": 4074.63, "timestamp": "01:07:54", "text": "電"}, {"type": "subtitle", "time": 4078.029, "timestamp": "01:07:58", "text": "現在"}]
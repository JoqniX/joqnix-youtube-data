[{"type": "subtitle", "time": 2580.15, "timestamp": "00:43:00", "text": "我覺得我的聲音不算太大。"}, {"type": "subtitle", "time": 2583.67, "timestamp": "00:43:03", "text": "。對不起。並不真地"}, {"type": "subtitle", "time": 2587.069, "timestamp": "00:43:07", "text": "哦，我不太會說話。"}, {"type": "subtitle", "time": 2589.109, "timestamp": "00:43:09", "text": "雨。"}, {"type": "subtitle", "time": 2592.67, "timestamp": "00:43:12", "text": "是的。我今天回家"}, {"type": "subtitle", "time": 2594.39, "timestamp": "00:43:14", "text": "普羅"}, {"type": "subtitle", "time": 2597.03, "timestamp": "00:43:17", "text": "我來做 Après。"}, {"type": "subtitle", "time": 2601.589, "timestamp": "00:43:21", "text": "今天真是太難熬了。今天我收到了很多"}, {"type": "subtitle", "time": 2605.23, "timestamp": "00:43:25", "text": "今天的早餐"}, {"type": "subtitle", "time": 2611.43, "timestamp": "00:43:31", "text": "我只吃了一點，所以今天感覺很好。"}, {"type": "subtitle", "time": 2616.15, "timestamp": "00:43:36", "text": "我完成了這項工作。去做，去做。"}, {"type": "subtitle", "time": 2621.589, "timestamp": "00:43:41", "text": "我做了。是的。但是，呃，在學校裡"}, {"type": "subtitle", "time": 2627.87, "timestamp": "00:43:47", "text": "我去的時候，正在上課。"}, {"type": "subtitle", "time": 2632.79, "timestamp": "00:43:52", "text": "我當時真的好睏好睏。"}, {"type": "subtitle", "time": 2638.23, "timestamp": "00:43:58", "text": "我睡了很多覺。但這一切都取決於口味。"}]
[{"type": "subtitle", "time": 2522.51, "timestamp": "00:42:02", "text": "這種事不會發生。"}, {"type": "subtitle", "time": 2527.51, "timestamp": "00:42:07", "text": "我不知道為什麼，但我忘記了。"}, {"type": "subtitle", "time": 2534.43, "timestamp": "00:42:14", "text": "有人在看著"}, {"type": "subtitle", "time": 2549.63, "timestamp": "00:42:29", "text": "我的用詞和說話時的聲音有點"}, {"type": "subtitle", "time": 2553.91, "timestamp": "00:42:33", "text": "我想你應該可以聽到。糟糕的。這"}, {"type": "subtitle", "time": 2557.99, "timestamp": "00:42:37", "text": "我感到很尷尬。我為什麼會在這裡？"}, {"type": "subtitle", "time": 2561.91, "timestamp": "00:42:41", "text": "現在。哦真的嗎？"}, {"type": "subtitle", "time": 2575.91, "timestamp": "00:42:55", "text": "嘈雜。"}]
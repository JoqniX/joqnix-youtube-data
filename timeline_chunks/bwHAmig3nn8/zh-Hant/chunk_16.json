[{"type": "subtitle", "time": 963.23, "timestamp": "00:16:03", "text": "但這很奇怪。為什麼，為什麼？"}, {"type": "subtitle", "time": 966.91, "timestamp": "00:16:06", "text": "難道沒有工作人員嗎？為什麼？"}, {"type": "subtitle", "time": 972.79, "timestamp": "00:16:12", "text": "永遠都只是人工智慧聊天，僅此而已。"}, {"type": "subtitle", "time": 975.47, "timestamp": "00:16:15", "text": "然後，昨天"}, {"type": "subtitle", "time": 979.71, "timestamp": "00:16:19", "text": "是昨天嗎？今天是星期一，對吧？在星期天"}, {"type": "subtitle", "time": 981.71, "timestamp": "00:16:21", "text": "我，"}, {"type": "subtitle", "time": 985.11, "timestamp": "00:16:25", "text": "星期天，我"}, {"type": "subtitle", "time": 987.35, "timestamp": "00:16:27", "text": "支付"}, {"type": "subtitle", "time": 995.749, "timestamp": "00:16:35", "text": "找到該電子郵件地址，並透過電子郵件將其發送給我，以便我了解此問題。"}, {"type": "subtitle", "time": 999.389, "timestamp": "00:16:39", "text": "我指的是我名字的間距。"}, {"type": "subtitle", "time": 1002.749, "timestamp": "00:16:42", "text": "啊，"}, {"type": "subtitle", "time": 1007.59, "timestamp": "00:16:47", "text": "那是什麼來著？ KYC是什麼來著？哦，"}, {"type": "subtitle", "time": 1010.67, "timestamp": "00:16:50", "text": "日文有點難，但是"}, {"type": "subtitle", "time": 1013.71, "timestamp": "00:16:53", "text": "我忘了。但我說的是KYC（了解你的客戶）。"}, {"type": "subtitle", "time": 1016.79, "timestamp": "00:16:56", "text": "但請這樣做"}, {"type": "chat", "time": 1019.627, "timestamp": "00:16:59", "author": "@MikazukiYure", "avatar": "https://yt4.ggpht.com/uuFSD7qVrZy0JUWrBRfSfEKIQpib7_2xP24Yiu1ND1Mq6uhaYIHDnA5EiGz_o33FUhHYvbCT9g=s64-c-k-c0x00ffffff-no-rj", "message": "hmmm"}]
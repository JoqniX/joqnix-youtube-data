[{"type": "subtitle", "time": 5703.87, "timestamp": "01:35:03", "text": "孔吉"}, {"type": "subtitle", "time": 5708.99, "timestamp": "01:35:08", "text": "你在吃什麼？我無法判斷那是什麼。"}, {"type": "subtitle", "time": 5713.55, "timestamp": "01:35:13", "text": "環境。哦，哦，在超市切好就好了。"}, {"type": "subtitle", "time": 5717.07, "timestamp": "01:35:17", "text": "我會看影片。哦，讓我看看。"}, {"type": "subtitle", "time": 5721.55, "timestamp": "01:35:21", "text": "益。不掛。日本人。日語，日語，沒有"}, {"type": "subtitle", "time": 5724.629, "timestamp": "01:35:24", "text": "。哈哈。嗯，它是日語的。抱歉，我說的是日文。"}, {"type": "subtitle", "time": 5731.07, "timestamp": "01:35:31", "text": "。但我智慧型手機的後置鏡頭"}, {"type": "subtitle", "time": 5733.31, "timestamp": "01:35:33", "text": "打開它"}, {"type": "subtitle", "time": 5738.109, "timestamp": "01:35:38", "text": "給我展示一下直播內容。"}, {"type": "subtitle", "time": 5743.39, "timestamp": "01:35:43", "text": "他們會給你的。等等，等等。謝謝你送的車。"}, {"type": "subtitle", "time": 5745.79, "timestamp": "01:35:45", "text": "啊，"}, {"type": "subtitle", "time": 5748.35, "timestamp": "01:35:48", "text": "汽車機械。"}, {"type": "subtitle", "time": 5751.35, "timestamp": "01:35:51", "text": "那"}, {"type": "chat", "time": 5754.135, "timestamp": "01:35:54", "author": "@hbvcsa", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mA5iYFWQWr-erQfOrpRSPi7uAL1ykOBKRSbPBDp88Z1xyBT7Je5IKp6_AckwgwsDEc-Q=s64-c-k-c0x00ffffff-no-rj", "message": "Did you passed N4"}]
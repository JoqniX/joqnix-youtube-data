[{"type": "subtitle", "time": 180.43, "timestamp": "00:03:00", "text": "是的。我什麼都忘了。今天，我"}, {"type": "subtitle", "time": 184.91, "timestamp": "00:03:04", "text": "我在這裡。瞧，瞧。"}, {"type": "subtitle", "time": 189.39, "timestamp": "00:03:09", "text": "然後對著鏡頭說話。啊，是的。樸伊瑪"}, {"type": "subtitle", "time": 193.35, "timestamp": "00:03:13", "text": "我在這裡。是的，是的，沒錯。"}, {"type": "subtitle", "time": 196.67000000000002, "timestamp": "00:03:16", "text": "我現在要去公園了。"}, {"type": "subtitle", "time": 202.35, "timestamp": "00:03:22", "text": "我現在正在走路。現在正在下雨。"}, {"type": "subtitle", "time": 208.589, "timestamp": "00:03:28", "text": "我指的是今天的廣播節目。"}, {"type": "subtitle", "time": 214.429, "timestamp": "00:03:34", "text": "僅在1:30。是的。今天，我，"}, {"type": "subtitle", "time": 219.03, "timestamp": "00:03:39", "text": "最近，我的一位網友說，哦，這個"}, {"type": "subtitle", "time": 223.149, "timestamp": "00:03:43", "text": "自從我參加了這門課程以來，今天的線上課程"}, {"type": "subtitle", "time": 227.309, "timestamp": "00:03:47", "text": "我需要上課。這是第一個，哦，太棒了。"}, {"type": "subtitle", "time": 231.91, "timestamp": "00:03:51", "text": "從。哦，今天，哦，"}, {"type": "subtitle", "time": 237.589, "timestamp": "00:03:57", "text": "太晚了，你也做不到。哦，不。一個"}]
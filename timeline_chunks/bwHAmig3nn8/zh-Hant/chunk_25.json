[{"type": "subtitle", "time": 1502.35, "timestamp": "00:25:02", "text": "瞧，瞧。這隻玻璃杯為什麼會出現在這個人家裡？"}, {"type": "subtitle", "time": 1508.669, "timestamp": "00:25:08", "text": "我們需要為此留出一扇窗戶。你在看什麼？"}, {"type": "subtitle", "time": 1512.159, "timestamp": "00:25:12", "text": "你在看什麼？ 上面。對不起。私人的"}, {"type": "subtitle", "time": 1515.52, "timestamp": "00:25:15", "text": "上面。對不起。私人的 這很有意思，因為它是私密的。"}, {"type": "subtitle", "time": 1518.64, "timestamp": "00:25:18", "text": "這很有意思，因為它是私密的。 我只給你展示一點點，因為我已經做過了。展示"}, {"type": "subtitle", "time": 1522.24, "timestamp": "00:25:22", "text": "我只給你展示一點點，因為我已經做過了。展示 我給他們看了。對不起。"}, {"type": "subtitle", "time": 1527.52, "timestamp": "00:25:27", "text": "我給他們看了。對不起。 對不起。"}, {"type": "subtitle", "time": 1537.63, "timestamp": "00:25:37", "text": "這很有意思。現在事情變得有趣起來了。"}, {"type": "subtitle", "time": 1540.159, "timestamp": "00:25:40", "text": "。 是的。"}, {"type": "subtitle", "time": 1542.84, "timestamp": "00:25:42", "text": "是的。 嘆。"}, {"type": "subtitle", "time": 1544.64, "timestamp": "00:25:44", "text": "嘆。 哦，那是什麼來著？今天有什麼節目？"}, {"type": "subtitle", "time": 1549.76, "timestamp": "00:25:49", "text": "哦，那是什麼來著？今天有什麼節目？ 今天是"}, {"type": "subtitle", "time": 1551.64, "timestamp": "00:25:51", "text": "今天是 六月的8:00。現在還沒到八點。第八。"}, {"type": "subtitle", "time": 1559.72, "timestamp": "00:25:59", "text": "六月的8:00。現在還沒到八點。第八。 今天是8號。大概。"}]
[{"type": "subtitle", "time": 900.11, "timestamp": "00:15:00", "text": "但我不會使用它。我不知道。"}, {"type": "subtitle", "time": 904.31, "timestamp": "00:15:04", "text": "我想用「我該怎麼辦？」這句話。但我用不了。"}, {"type": "subtitle", "time": 909.35, "timestamp": "00:15:09", "text": "沒有。現在沒有LeBet女孩了"}, {"type": "subtitle", "time": 912.949, "timestamp": "00:15:12", "text": "我可以用PayPay，但是也不行。這"}, {"type": "subtitle", "time": 918.87, "timestamp": "00:15:18", "text": "你不能使用PayPay。這個愚蠢的我"}, {"type": "subtitle", "time": 923.99, "timestamp": "00:15:23", "text": "名字嘛，真名就是真名。"}, {"type": "subtitle", "time": 929.43, "timestamp": "00:15:29", "text": "這裡有空間，還有磨坊的名字"}, {"type": "subtitle", "time": 932.67, "timestamp": "00:15:32", "text": "尼托尼亞，還有空間，這個"}, {"type": "subtitle", "time": 937.23, "timestamp": "00:15:37", "text": "存在間距問題。"}, {"type": "subtitle", "time": 939.47, "timestamp": "00:15:39", "text": "我吃飽了"}, {"type": "subtitle", "time": 944.67, "timestamp": "00:15:44", "text": "我試過了。去銀行，把它剪下來，"}, {"type": "subtitle", "time": 949.749, "timestamp": "00:15:49", "text": "我把這件事告訴了這裡的老師們。"}, {"type": "subtitle", "time": 954.23, "timestamp": "00:15:54", "text": "沒人知道該怎麼解決這個問題。"}, {"type": "subtitle", "time": 958.55, "timestamp": "00:15:58", "text": "是的，那很好。還有PayPay。"}]
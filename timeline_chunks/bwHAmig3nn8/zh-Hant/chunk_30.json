[{"type": "subtitle", "time": 1803.909, "timestamp": "00:30:03", "text": "我們需要更詳細地討論這個問題。太棒了。"}, {"type": "subtitle", "time": 1806.75, "timestamp": "00:30:06", "text": "是的。"}, {"type": "subtitle", "time": 1809.23, "timestamp": "00:30:09", "text": "略帶毒性"}, {"type": "subtitle", "time": 1814.35, "timestamp": "00:30:14", "text": "啊，我想把它弄壞，可是它現在在哪裡呢？"}, {"type": "subtitle", "time": 1815.99, "timestamp": "00:30:15", "text": "啊"}, {"type": "subtitle", "time": 1822.029, "timestamp": "00:30:22", "text": "他們會來嗎？哦，在哪裡？啊，"}, {"type": "subtitle", "time": 1824.509, "timestamp": "00:30:24", "text": "那是什麼來著？那句適合工作的好短語是什麼來著？"}, {"type": "subtitle", "time": 1831.75, "timestamp": "00:30:31", "text": "你在玩嗎？不。你打算去哪裡散步？"}, {"type": "subtitle", "time": 1835.63, "timestamp": "00:30:35", "text": "我不知道。"}, {"type": "subtitle", "time": 1845.07, "timestamp": "00:30:45", "text": "唔。"}, {"type": "subtitle", "time": 1852.47, "timestamp": "00:30:52", "text": "還有3分鐘"}, {"type": "subtitle", "time": 1858.669, "timestamp": "00:30:58", "text": "好的，直播還剩3分鐘。"}]
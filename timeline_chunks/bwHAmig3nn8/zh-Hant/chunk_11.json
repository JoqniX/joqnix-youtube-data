[{"type": "subtitle", "time": 665.069, "timestamp": "00:11:05", "text": "你累了嗎？為什麼這麼累？現在"}, {"type": "subtitle", "time": 670.11, "timestamp": "00:11:10", "text": "這是。疲勞的。圖片，"}, {"type": "subtitle", "time": 674.55, "timestamp": "00:11:14", "text": "我不常跑步。是的。你在說什麼？"}, {"type": "subtitle", "time": 679.47, "timestamp": "00:11:19", "text": "只有我？哦，哦，之前，啊"}, {"type": "subtitle", "time": 680.91, "timestamp": "00:11:20", "text": "。"}, {"type": "subtitle", "time": 684.55, "timestamp": "00:11:24", "text": "不在前面。 Arri的台詞是什麼來著？"}, {"type": "subtitle", "time": 690.23, "timestamp": "00:11:30", "text": "哦，這也不是很久以前的事了。後面到底是什麼來著？"}, {"type": "subtitle", "time": 692.43, "timestamp": "00:11:32", "text": "是嗎？"}, {"type": "subtitle", "time": 715.389, "timestamp": "00:11:55", "text": "什麼是「後部」？"}]
[{"type": "subtitle", "time": 2763.349, "timestamp": "00:46:03", "text": "現在還不是10點30分。"}, {"type": "subtitle", "time": 2775.91, "timestamp": "00:46:15", "text": "這是印度時間，但這是日本時間。"}, {"type": "subtitle", "time": 2777.43, "timestamp": "00:46:17", "text": "啊"}, {"type": "subtitle", "time": 2779.43, "timestamp": "00:46:19", "text": "一個"}, {"type": "subtitle", "time": 2786.47, "timestamp": "00:46:26", "text": "假設這與時間無關"}, {"type": "subtitle", "time": 2791.79, "timestamp": "00:46:31", "text": "如果你仔細看看，啊，大概是這樣吧。"}, {"type": "subtitle", "time": 2793.71, "timestamp": "00:46:33", "text": "啊"}, {"type": "subtitle", "time": 2801.47, "timestamp": "00:46:41", "text": "大概是照日本時間算吧，啊，大概是吧。"}, {"type": "subtitle", "time": 2803.39, "timestamp": "00:46:43", "text": "10、"}, {"type": "subtitle", "time": 2809.47, "timestamp": "00:46:49", "text": "現在既不是10點鐘也不是11點鐘。上午 10:30"}, {"type": "subtitle", "time": 2816.589, "timestamp": "00:46:56", "text": "一切開始了，夜晚開始了，啊，或許，是清晨吧。"}]
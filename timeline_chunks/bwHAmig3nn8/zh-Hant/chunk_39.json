[{"type": "subtitle", "time": 2345.03, "timestamp": "00:39:05", "text": "是的。我將用它來觸摸它。"}, {"type": "subtitle", "time": 2347.309, "timestamp": "00:39:07", "text": "事情就這樣發生了。"}, {"type": "subtitle", "time": 2362.15, "timestamp": "00:39:22", "text": "我現在有點累了。"}, {"type": "subtitle", "time": 2364.43, "timestamp": "00:39:24", "text": "是的。"}, {"type": "subtitle", "time": 2368.79, "timestamp": "00:39:28", "text": "我喜歡做這樣的直播。一個，"}, {"type": "subtitle", "time": 2372.39, "timestamp": "00:39:32", "text": "你玩得開心嗎？請聽我說一會兒。"}, {"type": "subtitle", "time": 2374.829, "timestamp": "00:39:34", "text": "我想。"}, {"type": "subtitle", "time": 2379.589, "timestamp": "00:39:39", "text": "我還沒做好準備。"}, {"type": "subtitle", "time": 2384.87, "timestamp": "00:39:44", "text": "我還沒準備好，就簡單直播一下吧。"}, {"type": "subtitle", "time": 2391.589, "timestamp": "00:39:51", "text": "我想和大家分享我的一些想法。"}, {"type": "subtitle", "time": 2396.67, "timestamp": "00:39:56", "text": "我做直播是因為我想這麼做。"}]
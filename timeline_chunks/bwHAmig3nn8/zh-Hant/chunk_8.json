[{"type": "subtitle", "time": 480.55, "timestamp": "00:08:00", "text": "例如，Kerukaru，或者哦，Kerkar 或 Devil"}, {"type": "subtitle", "time": 483.23, "timestamp": "00:08:03", "text": "因為卡爾不在"}, {"type": "subtitle", "time": 487.629, "timestamp": "00:08:07", "text": "我不知道該怎麼支付這筆費用了。"}, {"type": "subtitle", "time": 492.43, "timestamp": "00:08:12", "text": "那會很麻煩。這就是我的意思。"}, {"type": "subtitle", "time": 495.909, "timestamp": "00:08:15", "text": "我完全不明白。哦，我的學校。"}, {"type": "subtitle", "time": 497.35, "timestamp": "00:08:17", "text": "我的天啊，擋住我的雨傘"}, {"type": "subtitle", "time": 501.11, "timestamp": "00:08:21", "text": "又來了？這是什麼？我的，啊"}, {"type": "subtitle", "time": 504.07, "timestamp": "00:08:24", "text": "，我的"}, {"type": "subtitle", "time": 509.99, "timestamp": "00:08:29", "text": "這家銀行是由學校創建的。我的銀行帳戶"}, {"type": "subtitle", "time": 512.75, "timestamp": "00:08:32", "text": "銀行總裁"}, {"type": "subtitle", "time": 515.23, "timestamp": "00:08:35", "text": "是嗎？我不知道。他是JP的老闆嗎？"}, {"type": "subtitle", "time": 521.029, "timestamp": "00:08:41", "text": "是的，這是一個故事，但其實很簡單。"}, {"type": "subtitle", "time": 524.35, "timestamp": "00:08:44", "text": "現在那個收銀員拿到錢了。"}, {"type": "subtitle", "time": 528.07, "timestamp": "00:08:48", "text": "但這位現金女孩"}, {"type": "subtitle", "time": 531.829, "timestamp": "00:08:51", "text": "不是卡西女孩，而是大衛柯爾"}, {"type": "subtitle", "time": 533.43, "timestamp": "00:08:53", "text": "但"}, {"type": "subtitle", "time": 535.63, "timestamp": "00:08:55", "text": "須川"}, {"type": "subtitle", "time": 539.63, "timestamp": "00:08:59", "text": "「一切都不會改變，」老師說。"}]
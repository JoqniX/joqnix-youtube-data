[{"type": "subtitle", "time": 2041.08, "timestamp": "00:34:01", "text": "6 真遜。"}, {"type": "subtitle", "time": 2043.039, "timestamp": "00:34:03", "text": "真遜。 嘿，"}, {"type": "subtitle", "time": 2044.12, "timestamp": "00:34:04", "text": "嘿， 接下來怎麼辦？"}, {"type": "subtitle", "time": 2046.639, "timestamp": "00:34:06", "text": "接下來怎麼辦？ 沒什麼好說的。等等，有數學化學課程嗎？不是通識課程？"}, {"type": "subtitle", "time": 2071.069, "timestamp": "00:34:31", "text": "哦，我不懂這種語言。"}, {"type": "subtitle", "time": 2074.19, "timestamp": "00:34:34", "text": "嚴重地"}, {"type": "subtitle", "time": 2079.629, "timestamp": "00:34:39", "text": "那句話是什麼來著？它很難。哦，原來是數學主題的酒！"}, {"type": "subtitle", "time": 2081.71, "timestamp": "00:34:41", "text": "塔。"}, {"type": "subtitle", "time": 2085.589, "timestamp": "00:34:45", "text": "為什麼我會變成一隻早熟禾？嗯，這是"}, {"type": "subtitle", "time": 2088.79, "timestamp": "00:34:48", "text": "為什麼今天價格變便宜了？"}]
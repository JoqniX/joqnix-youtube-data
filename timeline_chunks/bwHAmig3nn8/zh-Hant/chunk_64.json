[{"type": "subtitle", "time": 3882.829, "timestamp": "01:04:42", "text": "是的，我回來了。抱歉，稍等片刻。"}, {"type": "subtitle", "time": 3887.63, "timestamp": "01:04:47", "text": "我會和一位使用這款應用程式的朋友聊聊。"}, {"type": "subtitle", "time": 3891.069, "timestamp": "01:04:51", "text": "我當時正在做這件事。這個想法是"}, {"type": "subtitle", "time": 3893.23, "timestamp": "01:04:53", "text": "好主意。是的，是的，沒錯。"}, {"type": "subtitle", "time": 3895.15, "timestamp": "01:04:55", "text": "停止。哦，等等等等"}, {"type": "subtitle", "time": 3897.71, "timestamp": "01:04:57", "text": "手。它變成了英文。對不起。"}, {"type": "subtitle", "time": 3899.47, "timestamp": "01:04:59", "text": "個人電腦"}]
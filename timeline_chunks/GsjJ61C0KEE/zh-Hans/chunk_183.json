[{"type": "subtitle", "time": 10982.07, "timestamp": "03:03:02", "text": "晚上？ 是的。 晚上没什么事可做"}, {"type": "subtitle", "time": 10988.71, "timestamp": "03:03:08", "text": "你说你会很忙。 我会"}, {"type": "subtitle", "time": 10990.63, "timestamp": "03:03:10", "text": "很忙。"}, {"type": "subtitle", "time": 10993.11, "timestamp": "03:03:13", "text": "我做了。"}, {"type": "subtitle", "time": 10995.269, "timestamp": "03:03:15", "text": "哦，原来你骗了我啊？"}, {"type": "subtitle", "time": 10999.03, "timestamp": "03:03:19", "text": "等等，我真的这么做了吗？ 等待。 不，呃，问题是"}, {"type": "subtitle", "time": 11003.11, "timestamp": "03:03:23", "text": "你忘了。 呃，我住在宿舍，所以"}, {"type": "subtitle", "time": 11004.389, "timestamp": "03:03:24", "text": "还没吃饭。"}, {"type": "subtitle", "time": 11007.59, "timestamp": "03:03:27", "text": "另外，儿子在房间里睡觉。 他需要"}, {"type": "subtitle", "time": 11011.349, "timestamp": "03:03:31", "text": "休息。 所以所有这些事情。 今天"}, {"type": "subtitle", "time": 11015.75, "timestamp": "03:03:35", "text": "没什么特别的。 我大概自由了。"}, {"type": "subtitle", "time": 11018.07, "timestamp": "03:03:38", "text": "等待。 你那边现在几点？ 现在是不是"}, {"type": "subtitle", "time": 11019.349, "timestamp": "03:03:39", "text": "太晚了？"}, {"type": "subtitle", "time": 11021.429, "timestamp": "03:03:41", "text": "现在是3点19分。"}, {"type": "subtitle", "time": 11021.91, "timestamp": "03:03:41", "text": "我的天啊。"}, {"type": "subtitle", "time": 11024.309, "timestamp": "03:03:44", "text": "我跟你说过我睡了很多觉。"}]
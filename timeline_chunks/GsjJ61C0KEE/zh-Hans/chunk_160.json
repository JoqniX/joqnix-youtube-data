[{"type": "subtitle", "time": 9603.349, "timestamp": "02:40:03", "text": "他说：“我们是不是在玩免费球衣那一套？”"}, {"type": "subtitle", "time": 9606.469, "timestamp": "02:40:06", "text": "我们是免费装备包之类的吗？   我"}, {"type": "subtitle", "time": 9608.71, "timestamp": "02:40:08", "text": "很确定。"}, {"type": "subtitle", "time": 9609.83, "timestamp": "02:40:09", "text": "我的意思是，"}, {"type": "subtitle", "time": 9610.71, "timestamp": "02:40:10", "text": "我简直要崩溃了，这他妈到底是"}, {"type": "subtitle", "time": 9652.389, "timestamp": "02:40:52", "text": "不，我其实并没有掉线。   我勒个去"}]
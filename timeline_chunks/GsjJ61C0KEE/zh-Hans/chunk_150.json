[{"type": "subtitle", "time": 9001.27, "timestamp": "02:30:01", "text": "他正在进行他的使命。 他正在进行他的"}, {"type": "subtitle", "time": 9002.15, "timestamp": "02:30:02", "text": "使命。"}, {"type": "subtitle", "time": 9003.03, "timestamp": "02:30:03", "text": "好的。"}, {"type": "subtitle", "time": 9004.95, "timestamp": "02:30:04", "text": "哦，该死。 他妈的。 他妈的。 他妈的。 他妈的。 我来。"}, {"type": "subtitle", "time": 9006.79, "timestamp": "02:30:06", "text": "我来。 啊，"}, {"type": "subtitle", "time": 9007.91, "timestamp": "02:30:07", "text": "我死了。"}, {"type": "subtitle", "time": 9010.95, "timestamp": "02:30:10", "text": "我该如何让你复活？"}, {"type": "subtitle", "time": 9014.469, "timestamp": "02:30:14", "text": "呃，你看到我身上的计时器了吗？"}, {"type": "subtitle", "time": 9016.309, "timestamp": "02:30:16", "text": "呃，应该有个倒计时，显示何时"}, {"type": "subtitle", "time": 9017.67, "timestamp": "02:30:17", "text": "可以复活。   该死的"}, {"type": "subtitle", "time": 9019.91, "timestamp": "02:30:19", "text": "。"}, {"type": "subtitle", "time": 9021.27, "timestamp": "02:30:21", "text": "好像我也得等着才能拿到"}, {"type": "subtitle", "time": 9022.23, "timestamp": "02:30:22", "text": "战利品似的。"}, {"type": "subtitle", "time": 9023.349, "timestamp": "02:30:23", "text": "我得等……是"}, {"type": "subtitle", "time": 9025.59, "timestamp": "02:30:25", "text": "啊，我身上有人，所以要"}, {"type": "subtitle", "time": 9028.55, "timestamp": "02:30:28", "text": "小心。 我的意思是，你可以进入我的身体，在"}, {"type": "subtitle", "time": 9030.95, "timestamp": "02:30:30", "text": "那里安营扎寨，然后射杀他们。"}, {"type": "subtitle", "time": 9032.95, "timestamp": "02:30:32", "text": "等等，我得等等。 我能不能把"}, {"type": "subtitle", "time": 9035.19, "timestamp": "02:30:35", "text": "你重启到附近某个地方？"}, {"type": "subtitle", "time": 9057.91, "timestamp": "02:30:57", "text": "快救救我。 你拿走了我的紫色。   是的"}, {"type": "subtitle", "time": 9058.71, "timestamp": "02:30:58", "text": "。   我"}]
[{"type": "subtitle", "time": 13381.429, "timestamp": "03:43:01", "text": "是的，我大概一个小时后就要上班了。"}, {"type": "subtitle", "time": 13382.469, "timestamp": "03:43:02", "text": "你确定吗？"}, {"type": "subtitle", "time": 13383.75, "timestamp": "03:43:03", "text": "大约30分钟。"}, {"type": "subtitle", "time": 13387.269, "timestamp": "03:43:07", "text": "你确定自己能活下来吗？"}, {"type": "subtitle", "time": 13387.67, "timestamp": "03:43:07", "text": "这是。"}, {"type": "subtitle", "time": 13390.389, "timestamp": "03:43:10", "text": "哦，是的。 我精神抖擞，乔克。 我"}, {"type": "subtitle", "time": 13395.349, "timestamp": "03:43:15", "text": "精神抖擞。 是的。 我的天啊。 对不起。"}, {"type": "subtitle", "time": 13396.469, "timestamp": "03:43:16", "text": "好的，我们可以结束了。"}, {"type": "subtitle", "time": 13397.51, "timestamp": "03:43:17", "text": "你没事。"}, {"type": "subtitle", "time": 13400.389, "timestamp": "03:43:20", "text": "等等，你有……那"}, {"type": "subtitle", "time": 13404.389, "timestamp": "03:43:24", "text": "是什么？ 兄弟，你是怎么搞到那辆"}, {"type": "subtitle", "time": 13406.389, "timestamp": "03:43:26", "text": "豪华卡车的"}, {"type": "subtitle", "time": 13408.55, "timestamp": "03:43:28", "text": "？"}, {"type": "subtitle", "time": 13415.11, "timestamp": "03:43:35", "text": "。 它正在打折。 当时好像有"}, {"type": "subtitle", "time": 13418.07, "timestamp": "03:43:38", "text": "30%的折扣。"}, {"type": "subtitle", "time": 13420.07, "timestamp": "03:43:40", "text": "感觉"}, {"type": "subtitle", "time": 13430.71, "timestamp": "03:43:50", "text": "等我把银行的事情处理好，"}, {"type": "subtitle", "time": 13433.189, "timestamp": "03:43:53", "text": "如果可以的话，我就可以买东西了。 是的"}, {"type": "subtitle", "time": 13434.389, "timestamp": "03:43:54", "text": "。"}, {"type": "subtitle", "time": 13436.229, "timestamp": "03:43:56", "text": "哦，别买太多。"}]
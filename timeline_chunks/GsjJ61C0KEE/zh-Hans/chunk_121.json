[{"type": "subtitle", "time": 7262.39, "timestamp": "02:01:02", "text": "天哪，我现在感觉好尴尬。"}, {"type": "subtitle", "time": 7265.51, "timestamp": "02:01:05", "text": "该死，有狙击手。"}, {"type": "subtitle", "time": 7273.27, "timestamp": "02:01:13", "text": "只有四个。"}, {"type": "subtitle", "time": 7274.149, "timestamp": "02:01:14", "text": "真够糟糕的。"}, {"type": "subtitle", "time": 7276.55, "timestamp": "02:01:16", "text": "黑客工具在哪儿？ 我看不见"}, {"type": "subtitle", "time": 7279.27, "timestamp": "02:01:19", "text": "。"}, {"type": "subtitle", "time": 7281.83, "timestamp": "02:01:21", "text": "让我们来看看。"}, {"type": "subtitle", "time": 7284.709, "timestamp": "02:01:24", "text": "可能在地下室吧。 下去。"}, {"type": "subtitle", "time": 7311.75, "timestamp": "02:01:51", "text": "四处走走。 我觉得它应该就在"}, {"type": "subtitle", "time": 7315.589, "timestamp": "02:01:55", "text": "我现在所在的这个区域"}]
[{"type": "subtitle", "time": 8947.67, "timestamp": "02:29:07", "text": "好的，"}, {"type": "subtitle", "time": 8958.79, "timestamp": "02:29:18", "text": "哦，等等。 医疗包。 我需要，我需要把它"}, {"type": "subtitle", "time": 8961.11, "timestamp": "02:29:21", "text": "放在我的胸罩里。"}, {"type": "subtitle", "time": 8962.71, "timestamp": "02:29:22", "text": "哦，糟糕。 你为什么突然这么大声"}, {"type": "subtitle", "time": 8969.83, "timestamp": "02:29:29", "text": "突然大声喊叫。"}, {"type": "subtitle", "time": 8972.07, "timestamp": "02:29:32", "text": "我竟然"}, {"type": "subtitle", "time": 8973.67, "timestamp": "02:29:33", "text": "忘了我一直在小声说话"}, {"type": "subtitle", "time": 8982.63, "timestamp": "02:29:42", "text": "好了，我把所有东西都搜刮干净了。 是的。 是的。"}, {"type": "subtitle", "time": 8986.23, "timestamp": "02:29:46", "text": "培根在哪儿？ 培根在干什么？"}, {"type": "subtitle", "time": 8990.23, "timestamp": "02:29:50", "text": "我要去那个……那个捡赃物的地方。"}, {"type": "subtitle", "time": 8991.429, "timestamp": "02:29:51", "text": "关键在于……"}, {"type": "subtitle", "time": 8994.79, "timestamp": "02:29:54", "text": "我们都远在天边。"}, {"type": "subtitle", "time": 8995.59, "timestamp": "02:29:55", "text": "所以，他要去……是的"}, {"type": "subtitle", "time": 8998.07, "timestamp": "02:29:58", "text": "，另一个人可能是……"}, {"type": "subtitle", "time": 8998.87, "timestamp": "02:29:58", "text": "我要去见他。"}]
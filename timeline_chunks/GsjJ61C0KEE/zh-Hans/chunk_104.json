[{"type": "subtitle", "time": 6240.149, "timestamp": "01:44:00", "text": "是啊，你"}, {"type": "subtitle", "time": 6241.91, "timestamp": "01:44:01", "text": "看，你不知道为什么偷了我的大厅"}, {"type": "subtitle", "time": 6244.47, "timestamp": "01:44:04", "text": "。"}, {"type": "subtitle", "time": 6247.75, "timestamp": "01:44:07", "text": "恢复默认设置。 是的。"}, {"type": "subtitle", "time": 6249.27, "timestamp": "01:44:09", "text": "所以，请"}, {"type": "subtitle", "time": 6253.83, "timestamp": "01:44:13", "text": "稍等。 是的，我是领导者。 是的。"}, {"type": "subtitle", "time": 6254.79, "timestamp": "01:44:14", "text": "是的，你是领导。"}, {"type": "subtitle", "time": 6262.149, "timestamp": "01:44:22", "text": "标准豪华版。 好的。 总之，"}, {"type": "subtitle", "time": 6267.59, "timestamp": "01:44:27", "text": "呃，哦，你可以改变我。 哦，不错。"}, {"type": "subtitle", "time": 6269.51, "timestamp": "01:44:29", "text": "这个游戏里比较好的近战招式是什么？ 我"}, {"type": "subtitle", "time": 6272.31, "timestamp": "01:44:32", "text": "想这就是妖怪的目的吧？"}, {"type": "subtitle", "time": 6275.51, "timestamp": "01:44:35", "text": "店里目前在售的那款。"}, {"type": "subtitle", "time": 6277.75, "timestamp": "01:44:37", "text": "那些是皮肤。   是的"}, {"type": "subtitle", "time": 6281.35, "timestamp": "01:44:41", "text": "。 昂贵的。"}, {"type": "subtitle", "time": 6284.229, "timestamp": "01:44:44", "text": "呃，我手里的那个只有两款皮肤，"}, {"type": "subtitle", "time": 6286.87, "timestamp": "01:44:46", "text": "两款紫色皮肤，"}, {"type": "subtitle", "time": 6288.87, "timestamp": "01:44:48", "text": "而且都是战斗通行证"}, {"type": "subtitle", "time": 6297.43, "timestamp": "01:44:57", "text": "好的。"}, {"type": "subtitle", "time": 6299.43, "timestamp": "01:44:59", "text": "哦，我们也可以双人合作。"}]
[{"type": "subtitle", "time": 9060.79, "timestamp": "02:31:00", "text": "用狙击枪拉了一泡紫色的屎"}, {"type": "subtitle", "time": 9069.59, "timestamp": "02:31:09", "text": "我有个主意。"}, {"type": "subtitle", "time": 9070.15, "timestamp": "02:31:10", "text": "该搬家了。"}, {"type": "subtitle", "time": 9070.389, "timestamp": "02:31:10", "text": "他妈的。   说实话"}, {"type": "subtitle", "time": 9072.23, "timestamp": "02:31:12", "text": "，就跟着另一个人走就行了"}, {"type": "subtitle", "time": 9072.79, "timestamp": "02:31:12", "text": "。"}, {"type": "subtitle", "time": 9073.91, "timestamp": "02:31:13", "text": "我来画，我来画这个。"}, {"type": "subtitle", "time": 9085.11, "timestamp": "02:31:25", "text": "疯狂地搜刮这家伙的财物。"}, {"type": "subtitle", "time": 9087.03, "timestamp": "02:31:27", "text": "你的无人机实际上可以像这样：哦，"}, {"type": "subtitle", "time": 9090.63, "timestamp": "02:31:30", "text": "他在那里。 它们就在那里。 它们就在那里。"}, {"type": "subtitle", "time": 9092.15, "timestamp": "02:31:32", "text": "你现在就在我身上。"}, {"type": "subtitle", "time": 9094.87, "timestamp": "02:31:34", "text": "不过我可以从侧翼包抄他。"}, {"type": "subtitle", "time": 9097.19, "timestamp": "02:31:37", "text": "我该如何突破这道无形的墙？"}, {"type": "subtitle", "time": 9098.71, "timestamp": "02:31:38", "text": "不，不，你不能。 你不能。"}, {"type": "subtitle", "time": 9099.349, "timestamp": "02:31:39", "text": "不行，"}, {"type": "subtitle", "time": 9101.91, "timestamp": "02:31:41", "text": "兄弟。 你得想办法"}, {"type": "subtitle", "time": 9113.59, "timestamp": "02:31:53", "text": "哦，他们可能已经把所有的屎都拉完了"}, {"type": "subtitle", "time": 9116.23, "timestamp": "02:31:56", "text": "。"}, {"type": "subtitle", "time": 9118.23, "timestamp": "02:31:58", "text": "我的意思是，只有一个人会开枪打"}]
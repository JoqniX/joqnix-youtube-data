[{"type": "subtitle", "time": 12906.55, "timestamp": "03:35:06", "text": "好吧，我们可以……嗯，操。 让我们来看看。"}, {"type": "subtitle", "time": 12910.63, "timestamp": "03:35:10", "text": "我没看到任何愚蠢的高楼大厦。"}, {"type": "subtitle", "time": 12913.67, "timestamp": "03:35:13", "text": "我们必须找到这些信号塔，"}, {"type": "subtitle", "time": 12916.55, "timestamp": "03:35:16", "text": "然后它就会为"}, {"type": "subtitle", "time": 12920.63, "timestamp": "03:35:20", "text": "我们发送 X 填充信号。 真是这样吗？"}, {"type": "subtitle", "time": 12920.79, "timestamp": "03:35:20", "text": "我也"}, {"type": "subtitle", "time": 12928.15, "timestamp": "03:35:28", "text": "每个地点都应该有一座"}, {"type": "subtitle", "time": 12928.79, "timestamp": "03:35:28", "text": "塔。"}, {"type": "subtitle", "time": 12932.15, "timestamp": "03:35:32", "text": "我们要去哪里？"}, {"type": "subtitle", "time": 12933.59, "timestamp": "03:35:33", "text": "好的。 是的，我只是想弄明白，"}, {"type": "subtitle", "time": 12947.99, "timestamp": "03:35:47", "text": "保持。"}, {"type": "subtitle", "time": 12949.11, "timestamp": "03:35:49", "text": "我们该去哪里呢？"}, {"type": "subtitle", "time": 12951.349, "timestamp": "03:35:51", "text": "我的意思是，"}, {"type": "subtitle", "time": 12953.349, "timestamp": "03:35:53", "text": "即使时间到了，还有一"}, {"type": "subtitle", "time": 12955.349, "timestamp": "03:35:55", "text": "分钟的额外时间。"}, {"type": "subtitle", "time": 12956.55, "timestamp": "03:35:56", "text": "最后"}, {"type": "subtitle", "time": 12959.59, "timestamp": "03:35:59", "text": "加时赛。   是的"}]
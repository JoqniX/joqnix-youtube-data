[{"type": "subtitle", "time": 4681.99, "timestamp": "01:18:01", "text": "它连接到哪里？ 哦，就在"}, {"type": "subtitle", "time": 4684.31, "timestamp": "01:18:04", "text": "附近。 它就在附近。   就在"}, {"type": "subtitle", "time": 4686.709, "timestamp": "01:18:06", "text": "那里。"}, {"type": "subtitle", "time": 4690.55, "timestamp": "01:18:10", "text": "嗯，我想2米长的电缆应该就足够了"}, {"type": "subtitle", "time": 4690.87, "timestamp": "01:18:10", "text": "。   是的"}, {"type": "subtitle", "time": 4697.669, "timestamp": "01:18:17", "text": "但我不知道该买哪一个。"}, {"type": "subtitle", "time": 4700.47, "timestamp": "01:18:20", "text": "现在有各种不同类型的电缆了。"}, {"type": "subtitle", "time": 4702.95, "timestamp": "01:18:22", "text": "6号猫，5号猫。随便吧"}, {"type": "subtitle", "time": 4705.669, "timestamp": "01:18:25", "text": "。 说"}, {"type": "subtitle", "time": 4706.63, "timestamp": "01:18:26", "text": "实话，随便吧。"}, {"type": "subtitle", "time": 4709.59, "timestamp": "01:18:29", "text": "让你的事更轻松些。 我得"}, {"type": "subtitle", "time": 4713.03, "timestamp": "01:18:33", "text": "查一下笔记本电脑"}, {"type": "subtitle", "time": 4716.709, "timestamp": "01:18:36", "text": "支持哪些设备，然后买下来。"}, {"type": "subtitle", "time": 4719.91, "timestamp": "01:18:39", "text": "是的，附近有警察，"}, {"type": "subtitle", "time": 4722.07, "timestamp": "01:18:42", "text": "所以要小心。 我不知道他们"}]
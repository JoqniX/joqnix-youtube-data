[{"type": "subtitle", "time": 4202.87, "timestamp": "01:10:02", "text": "旁边来。 到旁边来。"}, {"type": "subtitle", "time": 4210.149, "timestamp": "01:10:10", "text": "他可能会跳下去。 小心。"}, {"type": "subtitle", "time": 4210.79, "timestamp": "01:10:10", "text": "啊，他死了。   是的"}, {"type": "subtitle", "time": 4221.189, "timestamp": "01:10:21", "text": "等等，你走了？"}, {"type": "subtitle", "time": 4223.59, "timestamp": "01:10:23", "text": "哦，我们正在你的服务器上玩游戏。"}, {"type": "subtitle", "time": 4226.95, "timestamp": "01:10:26", "text": "我是。 你是。 我们是。 你在哪里？"}, {"type": "subtitle", "time": 4229.99, "timestamp": "01:10:29", "text": "我不知道。 这些名字听起来就像韩国"}, {"type": "subtitle", "time": 4232.39, "timestamp": "01:10:32", "text": "名字一样。"}, {"type": "subtitle", "time": 4236.07, "timestamp": "01:10:36", "text": "呃，"}, {"type": "subtitle", "time": 4237.27, "timestamp": "01:10:37", "text": "我不知道是怎么回事。 我认为是"}, {"type": "subtitle", "time": 4239.11, "timestamp": "01:10:39", "text": "自动的。 我不知道它是如何"}, {"type": "subtitle", "time": 4240.149, "timestamp": "01:10:40", "text": "运作的。"}, {"type": "subtitle", "time": 4242.47, "timestamp": "01:10:42", "text": "你被彻底干掉了。 你无法复活。"}, {"type": "subtitle", "time": 4246.63, "timestamp": "01:10:46", "text": "没有可以重启的卡之类的东西。"}, {"type": "subtitle", "time": 4248.149, "timestamp": "01:10:48", "text": "呃，"}, {"type": "subtitle", "time": 4250.709, "timestamp": "01:10:50", "text": "重启。 是的，你刚刚重启了我。 你"}, {"type": "subtitle", "time": 4252.55, "timestamp": "01:10:52", "text": "得等等。"}, {"type": "subtitle", "time": 4255.51, "timestamp": "01:10:55", "text": "嗯？ 等等，我回到了大厅。"}, {"type": "subtitle", "time": 4257.27, "timestamp": "01:10:57", "text": "糟糕。   是"}, {"type": "subtitle", "time": 4258.849, "timestamp": "01:10:58", "text": "啊，因为我们死了。 这就是原因。"}, {"type": "subtitle", "time": 4259.51, "timestamp": "01:10:59", "text": "[笑声]"}]
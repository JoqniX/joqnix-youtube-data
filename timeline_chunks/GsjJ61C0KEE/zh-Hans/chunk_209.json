[{"type": "subtitle", "time": 12542.87, "timestamp": "03:29:02", "text": "嗯，这里。 这里没有高跟鞋。"}, {"type": "subtitle", "time": 12544.87, "timestamp": "03:29:04", "text": "我想"}, {"type": "subtitle", "time": 12546.63, "timestamp": "03:29:06", "text": "你听到了那声尖叫。 它就像个"}, {"type": "subtitle", "time": 12567.349, "timestamp": "03:29:27", "text": "所以，你可以从他那里得到狙击手，"}, {"type": "subtitle", "time": 12569.269, "timestamp": "03:29:29", "text": "对吧？"}, {"type": "subtitle", "time": 12571.83, "timestamp": "03:29:31", "text": "呃，有时候会"}, {"type": "subtitle", "time": 12576.389, "timestamp": "03:29:36", "text": "生成，但不是一直都会生成。"}, {"type": "subtitle", "time": 12578.389, "timestamp": "03:29:38", "text": "务必掠夺机器人，尽可能多地获取它们的"}, {"type": "subtitle", "time": 12580.55, "timestamp": "03:29:40", "text": "卡片。"}, {"type": "subtitle", "time": 12584.79, "timestamp": "03:29:44", "text": "你使用了信用额度。 有趣的。 对，就是"}, {"type": "subtitle", "time": 12588.55, "timestamp": "03:29:48", "text": "那东西。 美国信用调查之"}]
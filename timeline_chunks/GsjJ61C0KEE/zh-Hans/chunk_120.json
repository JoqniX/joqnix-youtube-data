[{"type": "subtitle", "time": 7203.43, "timestamp": "02:00:03", "text": "嗯，他说，这"}, {"type": "subtitle", "time": 7206.55, "timestamp": "02:00:06", "text": "取决于你处在什么情况下。"}, {"type": "subtitle", "time": 7208.149, "timestamp": "02:00:08", "text": "他们会给你最好的，"}, {"type": "subtitle", "time": 7214.07, "timestamp": "02:00:14", "text": "最好的，呃，该怎么称呼这个呢？"}, {"type": "subtitle", "time": 7216.629, "timestamp": "02:00:16", "text": "比如治疗或者"}, {"type": "subtitle", "time": 7218.95, "timestamp": "02:00:18", "text": "护盾之类的。"}, {"type": "subtitle", "time": 7220.87, "timestamp": "02:00:20", "text": "是的，这要看具体情况。 比如"}, {"type": "subtitle", "time": 7222.07, "timestamp": "02:00:22", "text": "当你需要治疗时，他们"}, {"type": "subtitle", "time": 7223.589, "timestamp": "02:00:23", "text": "会给你治疗。 当你完成"}, {"type": "subtitle", "time": 7225.589, "timestamp": "02:00:25", "text": "治疗后，他们会自动"}, {"type": "subtitle", "time": 7227.669, "timestamp": "02:00:27", "text": "给你提供护盾。 差不多是这样。"}, {"type": "subtitle", "time": 7230.47, "timestamp": "02:00:30", "text": "所以他们其实是在"}, {"type": "subtitle", "time": 7232.229, "timestamp": "02:00:32", "text": "谈论游戏。"}, {"type": "subtitle", "time": 7233.189, "timestamp": "02:00:33", "text": "什么？"}, {"type": "subtitle", "time": 7234.55, "timestamp": "02:00:34", "text": "这个怎么样？"}, {"type": "subtitle", "time": 7236.39, "timestamp": "02:00:36", "text": "嗯？ 游戏内对话。"}, {"type": "subtitle", "time": 7238.95, "timestamp": "02:00:38", "text": "等等，我还在游戏里说话吗？"}, {"type": "subtitle", "time": 7240.79, "timestamp": "02:00:40", "text": "不，你已经完成了。 是的。 是的。 不，不，"}, {"type": "subtitle", "time": 7242.31, "timestamp": "02:00:42", "text": "你被困住了。"}, {"type": "subtitle", "time": 7244.149, "timestamp": "02:00:44", "text": "我的天啊。 我一直在"}, {"type": "subtitle", "time": 7250.79, "timestamp": "02:00:50", "text": "等等，这支队伍会自己打败自己吗？   是的"}]
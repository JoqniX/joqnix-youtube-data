[{"type": "subtitle", "time": 3420.87, "timestamp": "00:57:00", "text": "不。哦，你是说小偷。"}, {"type": "subtitle", "time": 3422.63, "timestamp": "00:57:02", "text": "如果值得做，就"}, {"type": "subtitle", "time": 3423.99, "timestamp": "00:57:03", "text": "接受（音乐）的代价。"}, {"type": "subtitle", "time": 3427.91, "timestamp": "00:57:07", "text": "你有没有进行升级之类的，比如"}, {"type": "subtitle", "time": 3430.47, "timestamp": "00:57:10", "text": "安装底座之类的？"}, {"type": "subtitle", "time": 3432.95, "timestamp": "00:57:12", "text": "完美的设计。"}, {"type": "subtitle", "time": 3436.95, "timestamp": "00:57:16", "text": "嗯，是的。 是的。 但我才四级。"}, {"type": "subtitle", "time": 3438.47, "timestamp": "00:57:18", "text": "我才刚开始玩不久"}, {"type": "subtitle", "time": 3441.349, "timestamp": "00:57:21", "text": "。   为"}, {"type": "subtitle", "time": 3445.99, "timestamp": "00:57:25", "text": "您的产品进行表面处理。"}, {"type": "subtitle", "time": 3449.03, "timestamp": "00:57:29", "text": "是的，那些背包之类的东西，"}, {"type": "subtitle", "time": 3452.95, "timestamp": "00:57:32", "text": "你需要在阵营"}, {"type": "subtitle", "time": 3455.67, "timestamp": "00:57:35", "text": "升级中打开。"}, {"type": "subtitle", "time": 3459.19, "timestamp": "00:57:39", "text": "是的，你需要找到一些可制作的物品，"}, {"type": "subtitle", "time": 3461.91, "timestamp": "00:57:41", "text": "然后收集所有可回收的"}, {"type": "subtitle", "time": 3463.19, "timestamp": "00:57:43", "text": "资源，"}, {"type": "subtitle", "time": 3465.109, "timestamp": "00:57:45", "text": "才能解锁升级，进而升级你的"}, {"type": "subtitle", "time": 3466.23, "timestamp": "00:57:46", "text": "阵营。"}, {"type": "chat", "time": 3470.557, "timestamp": "00:57:50", "author": "@Ghewar_Ji_ka_No-1FAN", "avatar": "https://yt4.ggpht.com/CqrtcQvHFvr33XJk7uI96qZ5HyIAEb1ifU1jdPzM7vetPMlUZ4oYhF9BjVOj5xYYbkMi18Zfvg=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/E8MfY5u7JPSXkNAP95GAmAEUCkszU2WH9gy1mb0dV-11UJg/E8MfY5u7JPSXkNAP95GAmAEUCkszU2WH9gy1mb0dV-11UJg/E8MfY5u7JPSXkNAP95GAmAE"}, {"type": "subtitle", "time": 3478.23, "timestamp": "00:57:58", "text": "
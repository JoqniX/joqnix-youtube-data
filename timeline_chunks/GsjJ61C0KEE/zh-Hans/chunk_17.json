[{"type": "subtitle", "time": 1020.79, "timestamp": "00:17:00", "text": "团队，否则和"}, {"type": "subtitle", "time": 1022.79, "timestamp": "00:17:02", "text": "陌生人一起玩会感觉很难"}, {"type": "subtitle", "time": 1024.23, "timestamp": "00:17:04", "text": "受。   和"}, {"type": "subtitle", "time": 1025.75, "timestamp": "00:17:05", "text": "陌生人一起玩游戏就像打架一样"}, {"type": "subtitle", "time": 1027.829, "timestamp": "00:17:07", "text": "难。"}, {"type": "subtitle", "time": 1030.23, "timestamp": "00:17:10", "text": "理论上你可以单人游玩。"}, {"type": "subtitle", "time": 1033.11, "timestamp": "00:17:13", "text": "你是单人玩还是……你玩过"}, {"type": "subtitle", "time": 1036.39, "timestamp": "00:17:16", "text": "？我玩的是单人模式。 是的。   是的"}, {"type": "subtitle", "time": 1038.71, "timestamp": "00:17:18", "text": "。 我不太喜欢独处。 所以我"}, {"type": "subtitle", "time": 1041.189, "timestamp": "00:17:21", "text": "大部分时间都玩三人组队。"}, {"type": "subtitle", "time": 1042.949, "timestamp": "00:17:22", "text": "有时候挺酷的，有时候能遇到一些"}, {"type": "subtitle", "time": 1046.47, "timestamp": "00:17:26", "text": "很厉害的玩家，但大多数时候都"}, {"type": "subtitle", "time": 1048.87, "timestamp": "00:17:28", "text": "只是普通人。 感觉"}, {"type": "subtitle", "time": 1050.87, "timestamp": "00:17:30", "text": "糟透了。   是的"}, {"type": "subtitle", "time": 1053.83, "timestamp": "00:17:33", "text": "。"}, {"type": "subtitle", "time": 1062.789, "timestamp": "00:17:42", "text": "为什么会卡住这样？"}]
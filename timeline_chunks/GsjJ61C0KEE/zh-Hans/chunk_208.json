[{"type": "subtitle", "time": 12481.429, "timestamp": "03:28:01", "text": "然后这个人就独自离开了。"}, {"type": "subtitle", "time": 12492.63, "timestamp": "03:28:12", "text": "好的。 零钱保险"}, {"type": "subtitle", "time": 12507.99, "timestamp": "03:28:27", "text": "我不需要这个。"}, {"type": "subtitle", "time": 12509.59, "timestamp": "03:28:29", "text": "小心点，女孩。"}, {"type": "subtitle", "time": 12510.309, "timestamp": "03:28:30", "text": "我死了。"}, {"type": "subtitle", "time": 12531.429, "timestamp": "03:28:51", "text": "哦，对，那是个僵尸。 你听到了。"}, {"type": "subtitle", "time": 12533.99, "timestamp": "03:28:53", "text": "它在哪里？"}, {"type": "subtitle", "time": 12539.03, "timestamp": "03:28:59", "text": "我没有高跟鞋。 帮助。"}]
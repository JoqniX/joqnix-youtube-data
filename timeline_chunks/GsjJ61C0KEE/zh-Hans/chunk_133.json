[{"type": "subtitle", "time": 7981.189, "timestamp": "02:13:01", "text": "没人聊天。 我为什么要"}, {"type": "subtitle", "time": 7994.069, "timestamp": "02:13:14", "text": "他是在聊天还是在做其他什么操作？"}, {"type": "subtitle", "time": 7996.31, "timestamp": "02:13:16", "text": "哦，不。 我想，应该是我一个朋友吧"}, {"type": "subtitle", "time": 8009.189, "timestamp": "02:13:29", "text": "哦，原来是你啊。 哦，"}, {"type": "subtitle", "time": 8013.27, "timestamp": "02:13:33", "text": "我当时吓坏了。"}, {"type": "subtitle", "time": 8029.43, "timestamp": "02:13:49", "text": "这里还有一把蓝色的枪。"}, {"type": "subtitle", "time": 8032.39, "timestamp": "02:13:52", "text": "盾牌、背包、"}, {"type": "subtitle", "time": 8035.83, "timestamp": "02:13:55", "text": "盔甲之类的东西。 全身防护"}, {"type": "subtitle", "time": 8039.109, "timestamp": "02:13:59", "text": "服。 盔甲。 这里有狙击手"}]
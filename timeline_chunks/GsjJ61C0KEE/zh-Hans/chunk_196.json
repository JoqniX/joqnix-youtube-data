[{"type": "subtitle", "time": 11773.19, "timestamp": "03:16:13", "text": "他要用喷气背包吗？   是的"}, {"type": "subtitle", "time": 11775.91, "timestamp": "03:16:15", "text": "。 是的。 它就像……它不是"}, {"type": "subtitle", "time": 11778.87, "timestamp": "03:16:18", "text": "喷气背包。 就像超级冲刺之类的"}, {"type": "subtitle", "time": 11780.07, "timestamp": "03:16:20", "text": "。"}, {"type": "subtitle", "time": 11783.51, "timestamp": "03:16:23", "text": "你可以提升自己的速度，跑得更快，但这样做会"}, {"type": "subtitle", "time": 11785.83, "timestamp": "03:16:25", "text": "产生大量的热量或者消耗大量的"}, {"type": "subtitle", "time": 11790.15, "timestamp": "03:16:30", "text": "体力。"}, {"type": "subtitle", "time": 11819.51, "timestamp": "03:16:59", "text": "你想去开门吗？   当然"}]
[{"type": "subtitle", "time": 10860.63, "timestamp": "03:01:00", "text": "我们没事。 我敢肯定，"}, {"type": "subtitle", "time": 10889.03, "timestamp": "03:01:29", "text": "问题是，另一个人怎么"}, {"type": "subtitle", "time": 10891.59, "timestamp": "03:01:31", "text": "这么快就复活了？"}, {"type": "subtitle", "time": 10893.19, "timestamp": "03:01:33", "text": "这是你的时间。"}, {"type": "subtitle", "time": 10895.19, "timestamp": "03:01:35", "text": "哦，那里有两队人在交战。"}, {"type": "subtitle", "time": 10897.03, "timestamp": "03:01:37", "text": "那大概是其中之一"}, {"type": "subtitle", "time": 10903.75, "timestamp": "03:01:43", "text": "有。   是"}, {"type": "subtitle", "time": 10909.03, "timestamp": "03:01:49", "text": "啊，因为我们杀了三个，对吧？"}, {"type": "subtitle", "time": 10911.51, "timestamp": "03:01:51", "text": "然后我就狙击了第一个。"}]
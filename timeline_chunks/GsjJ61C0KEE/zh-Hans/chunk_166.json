[{"type": "subtitle", "time": 9962.23, "timestamp": "02:46:02", "text": "他妈的。 不过我还挺想去拿那些战利品的"}, {"type": "subtitle", "time": 9965.11, "timestamp": "02:46:05", "text": "。 战利品很丰厚。"}, {"type": "subtitle", "time": 9965.67, "timestamp": "02:46:05", "text": "在哪里？"}, {"type": "subtitle", "time": 9969.11, "timestamp": "02:46:09", "text": "哦，一点也不多汁。 多汁。 就是你打开的那个"}, {"type": "subtitle", "time": 9972.87, "timestamp": "02:46:12", "text": "小盒子。 是的。"}, {"type": "subtitle", "time": 9976.469, "timestamp": "02:46:16", "text": "柱子在哪里？  Oh"}, {"type": "subtitle", "time": 9977.11, "timestamp": "02:46:17", "text": "在地图上的哪个位置？"}, {"type": "subtitle", "time": 9977.59, "timestamp": "02:46:17", "text": "瞧瞧。"}, {"type": "subtitle", "time": 9978.63, "timestamp": "02:46:18", "text": "对，就在那边。"}, {"type": "subtitle", "time": 9979.429, "timestamp": "02:46:19", "text": "列。"}, {"type": "subtitle", "time": 9982.95, "timestamp": "02:46:22", "text": "你可以去那里。 你看到"}, {"type": "subtitle", "time": 9984.79, "timestamp": "02:46:24", "text": "地图上的那个红色标记了吗？"}, {"type": "subtitle", "time": 9985.75, "timestamp": "02:46:25", "text": "红色标记。 没错，"}, {"type": "subtitle", "time": 9988.71, "timestamp": "02:46:28", "text": "那是狱警。 那就像一个金色的"}, {"type": "subtitle", "time": 9996.389, "timestamp": "02:46:36", "text": "是的，"}, {"type": "subtitle", "time": 10001.83, "timestamp": "02:46:41", "text": "如果你不想拿那些灰色"}, {"type": "subtitle", "time": 10007.51, "timestamp": "02:46:47", "text": "我的意思是，如果我有"}, {"type": "subtitle", "time": 10010.23, "timestamp": "02:46:50", "text": "一些备用枪，比如绿色的枪或者其他什么"}, {"type": "subtitle", "time": 10011.51, "timestamp": "02:46:51", "text": "乱七八糟的枪，我想用用，那还是挺好的。 它只是把它"}]
[{"type": "subtitle", "time": 9781.19, "timestamp": "02:43:01", "text": "因为狙击手正在射击。"}, {"type": "subtitle", "time": 9792.23, "timestamp": "02:43:12", "text": "大多数时候，当你"}, {"type": "subtitle", "time": 9794.23, "timestamp": "02:43:14", "text": "生成那个东西的时候，它会生成……我的"}, {"type": "subtitle", "time": 9797.83, "timestamp": "02:43:17", "text": "天哪，生成"}, {"type": "subtitle", "time": 9799.75, "timestamp": "02:43:19", "text": "紫色机器人，那可是非常"}, {"type": "subtitle", "time": 9800.63, "timestamp": "02:43:20", "text": "强大的机器人。"}, {"type": "subtitle", "time": 9802.71, "timestamp": "02:43:22", "text": "啊，我该怎么做？是的"}, {"type": "subtitle", "time": 9803.51, "timestamp": "02:43:23", "text": "。"}, {"type": "subtitle", "time": 9807.349, "timestamp": "02:43:27", "text": "哦，是狙击手。 那个愚蠢的狙击手。"}, {"type": "subtitle", "time": 9807.51, "timestamp": "02:43:27", "text": "哦，"}, {"type": "subtitle", "time": 9810.469, "timestamp": "02:43:30", "text": "我可以……我可以救活他。 我的终极技能"}, {"type": "subtitle", "time": 9814.71, "timestamp": "02:43:34", "text": "是瞬间复活"}, {"type": "subtitle", "time": 9820.87, "timestamp": "02:43:40", "text": "援军。"}, {"type": "subtitle", "time": 9822.15, "timestamp": "02:43:42", "text": "看来有麻烦了。"}, {"type": "subtitle", "time": 9824.55, "timestamp": "02:43:44", "text": "他会开枪打你吗？"}, {"type": "subtitle", "time": 9826.79, "timestamp": "02:43:46", "text": "我让你复活。"}, {"type": "subtitle", "time": 9828.79, "timestamp": "02:43:48", "text": "好吧，"}, {"type": "subtitle", "time": 9838.389, "timestamp": "02:43:58", "text": "。"}]
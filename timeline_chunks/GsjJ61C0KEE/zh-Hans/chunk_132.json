[{"type": "subtitle", "time": 7920.149, "timestamp": "02:12:00", "text": "不，不，不，不。 就像我们的队友"}, {"type": "subtitle", "time": 7922.709, "timestamp": "02:12:02", "text": "和我杀死的那个人一样，嗯，他们也叫"}, {"type": "subtitle", "time": 7924.95, "timestamp": "02:12:04", "text": "日本人。 日文名字有日文"}, {"type": "subtitle", "time": 7927.109, "timestamp": "02:12:07", "text": "名字。"}, {"type": "subtitle", "time": 7931.99, "timestamp": "02:12:11", "text": "能让我花3000元换回我的背叛吗？"}, {"type": "subtitle", "time": 7934.149, "timestamp": "02:12:14", "text": "那样会好一些。"}, {"type": "subtitle", "time": 7937.83, "timestamp": "02:12:17", "text": "现在至少稳定了。"}, {"type": "subtitle", "time": 7939.83, "timestamp": "02:12:19", "text": "是的，我们应该先做一些测试"}, {"type": "subtitle", "time": 7941.51, "timestamp": "02:12:21", "text": "。   是的"}, {"type": "subtitle", "time": 7942.79, "timestamp": "02:12:22", "text": "，但现在我们"}, {"type": "subtitle", "time": 7944.229, "timestamp": "02:12:24", "text": "之前就知道了。"}, {"type": "subtitle", "time": 7945.189, "timestamp": "02:12:25", "text": "现在我们知道了。   是的"}, {"type": "subtitle", "time": 7945.83, "timestamp": "02:12:25", "text": "。"}, {"type": "subtitle", "time": 7948.95, "timestamp": "02:12:28", "text": "哦，有人去世了。 这里有很多"}, {"type": "subtitle", "time": 7950.31, "timestamp": "02:12:30", "text": "急救包。"}, {"type": "subtitle", "time": 7951.99, "timestamp": "02:12:31", "text": "哦，是的。 是的。 是的。 呃，是另一个人把他们都"}, {"type": "subtitle", "time": 7953.589, "timestamp": "02:12:33", "text": "杀了。"}, {"type": "subtitle", "time": 7954.229, "timestamp": "02:12:34", "text": "我的天啊。   是"}, {"type": "subtitle", "time": 7957.99, "timestamp": "02:12:37", "text": "啊，东西太多了。   嗯……"}, {"type": "subtitle", "time": 7963.75, "timestamp": "02:12:43", "text": "你左边其他身体里也有类似护盾的东西。 你可以"}, {"type": "subtitle", "time": 7966.709, "timestamp": "02:12:46", "text": "去拿。 我得和这家伙重新商量一下"}]
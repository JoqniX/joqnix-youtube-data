[{"type": "subtitle", "time": 2047.909, "timestamp": "00:34:07", "text": "你怎么知道单次运行就能"}, {"type": "subtitle", "time": 2051.109, "timestamp": "00:34:11", "text": "从地下室的指挥官A1那里获得一个指挥模块"}, {"type": "subtitle", "time": 2052.79, "timestamp": "00:34:12", "text": "？"}, {"type": "subtitle", "time": 2055.75, "timestamp": "00:34:15", "text": "这就是我的追求。 是的，我们就在这个综合设施里，"}, {"type": "subtitle", "time": 2060.23, "timestamp": "00:34:20", "text": "所以你可以在这里完成你的任务。"}, {"type": "subtitle", "time": 2062.95, "timestamp": "00:34:22", "text": "呃，"}, {"type": "subtitle", "time": 2066.31, "timestamp": "00:34:26", "text": "为什么我动不了？"}, {"type": "subtitle", "time": 2068.389, "timestamp": "00:34:28", "text": "无法移动。 什么？"}, {"type": "subtitle", "time": 2075.51, "timestamp": "00:34:35", "text": "真的吗？   是的"}, {"type": "subtitle", "time": 2080.389, "timestamp": "00:34:40", "text": "，延迟太高了。"}, {"type": "subtitle", "time": 2082.23, "timestamp": "00:34:42", "text": "拉屎。"}, {"type": "subtitle", "time": 2085.27, "timestamp": "00:34:45", "text": "你在哪里？ 我的直播也快结束了"}, {"type": "subtitle", "time": 2093.19, "timestamp": "00:34:53", "text": "今天发生了什么事？"}, {"type": "subtitle", "time": 2097.349, "timestamp": "00:34:57", "text": "马拉松，你真的那么恨我吗？"}, {"type": "subtitle", "time": 2098.55, "timestamp": "00:34:58", "text": "那么多？"}]
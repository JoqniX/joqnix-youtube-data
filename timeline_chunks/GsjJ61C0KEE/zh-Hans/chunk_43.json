[{"type": "subtitle", "time": 2582.71, "timestamp": "00:43:02", "text": "那里，拿到卡片，然后完成我的"}, {"type": "subtitle", "time": 2583.829, "timestamp": "00:43:03", "text": "任务。"}, {"type": "subtitle", "time": 2586.79, "timestamp": "00:43:06", "text": "你的近战攻击快捷键是什么？"}, {"type": "subtitle", "time": 2588.95, "timestamp": "00:43:08", "text": "还剩10分钟。"}, {"type": "subtitle", "time": 2592.309, "timestamp": "00:43:12", "text": "近战。 对，近战。"}, {"type": "subtitle", "time": 2594.71, "timestamp": "00:43:14", "text": "就像一个快速的近战攻击按钮。   是的"}, {"type": "subtitle", "time": 2595.27, "timestamp": "00:43:15", "text": "。   妈的"}, {"type": "subtitle", "time": 2597.75, "timestamp": "00:43:17", "text": "。"}, {"type": "subtitle", "time": 2599.43, "timestamp": "00:43:19", "text": "呃，"}, {"type": "subtitle", "time": 2601.51, "timestamp": "00:43:21", "text": "C。是的，C。C"}, {"type": "subtitle", "time": 2603.51, "timestamp": "00:43:23", "text": "。那你怎么蹲下呢？"}, {"type": "subtitle", "time": 2607.829, "timestamp": "00:43:27", "text": "我只是用了控制键。"}, {"type": "subtitle", "time": 2610.15, "timestamp": "00:43:30", "text": "我只用默认设置。"}, {"type": "subtitle", "time": 2613.19, "timestamp": "00:43:33", "text": "我总是用默认设置。"}, {"type": "subtitle", "time": 2615.829, "timestamp": "00:43:35", "text": "哦，你不能。 哦，还有"}, {"type": "subtitle", "time": 2617.91, "timestamp": "00:43:37", "text": "一种叫做热量之类的东西。"}, {"type": "subtitle", "time": 2618.95, "timestamp": "00:43:38", "text": "如果你没有足够的"}, {"type": "subtitle", "time": 2621.91, "timestamp": "00:43:41", "text": "耐力，你就做不到。 耐力。 啊，是的"}, {"type": "subtitle", "time": 2623.91, "timestamp": "00:43:43", "text": "。 咱们就按《命运》的"}, {"type": "subtitle", "time": 2627.349, "timestamp": "00:43:47", "text": "小心。"}, {"type": "subtitle", "time": 2629.349, "timestamp": "00:43:49", "text": "我收到了吗？我收到了吗？那是"}, {"type": "subtitle", "time": 2630.95, "timestamp": "00:43:50", "text": "接近的感觉吗？"}, {"type": "chat", "time": 2631.345, "timestamp": "00:43:51", "author": "@SAMPAD0xd", "avatar": "https://yt4.ggpht.com/z-o
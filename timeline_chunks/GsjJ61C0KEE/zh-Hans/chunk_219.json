[{"type": "subtitle", "time": 13142.309, "timestamp": "03:39:02", "text": "吗？ 兄弟，我要买根电缆"}, {"type": "subtitle", "time": 13144.63, "timestamp": "03:39:04", "text": "。"}, {"type": "subtitle", "time": 13146.79, "timestamp": "03:39:06", "text": "如果你不去抢劫，我们本来可以成功的"}, {"type": "subtitle", "time": 13148.15, "timestamp": "03:39:08", "text": "。"}, {"type": "subtitle", "time": 13153.269, "timestamp": "03:39:13", "text": "不，我没有抢劫。 我来了。"}, {"type": "subtitle", "time": 13154.469, "timestamp": "03:39:14", "text": "我爱我的，"}, {"type": "subtitle", "time": 13157.269, "timestamp": "03:39:17", "text": "这太奇怪了。 我们已连接到"}, {"type": "subtitle", "time": 13159.429, "timestamp": "03:39:19", "text": "您的服务器。 为什么？为什么你进度慢而"}, {"type": "subtitle", "time": 13162.63, "timestamp": "03:39:22", "text": "我却不慢？ 他为什么没有落后？"}, {"type": "subtitle", "time": 13190.15, "timestamp": "03:39:50", "text": "我得到了什么？ 我可以解锁，哦，还有"}]
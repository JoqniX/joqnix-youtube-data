[{"type": "subtitle", "time": 661.99, "timestamp": "00:11:01", "text": "好的。 这是我第一次玩"}, {"type": "subtitle", "time": 664.069, "timestamp": "00:11:04", "text": "马拉松游戏，所以我非常兴奋"}, {"type": "subtitle", "time": 665.829, "timestamp": "00:11:05", "text": "。"}, {"type": "subtitle", "time": 670.87, "timestamp": "00:11:10", "text": "呃，富士山袭击事件发生后，把"}, {"type": "subtitle", "time": 674.79, "timestamp": "00:11:14", "text": "培根放在这里了。 聊天记录"}, {"type": "subtitle", "time": 678.23, "timestamp": "00:11:18", "text": "太糟糕了。 我知道这。"}, {"type": "subtitle", "time": 705.03, "timestamp": "00:11:45", "text": "哦，对，游戏就卡在这个"}, {"type": "subtitle", "time": 714.47, "timestamp": "00:11:54", "text": "哦，是的，它卡住了。 就这样卡住了。"}, {"type": "subtitle", "time": 718.949, "timestamp": "00:11:58", "text": "Doio，一秒钟。"}]
[{"type": "subtitle", "time": 5281.43, "timestamp": "01:28:01", "text": "但维护工作应该"}, {"type": "subtitle", "time": 5284.229, "timestamp": "01:28:04", "text": "更近一些吧？ 维修工作即将完成。"}, {"type": "subtitle", "time": 5287.03, "timestamp": "01:28:07", "text": "但是等等，生物学是……是的。 是的。 是的。"}, {"type": "subtitle", "time": 5288.79, "timestamp": "01:28:08", "text": "好的。 我们去进行生物研究吧。"}, {"type": "subtitle", "time": 5291.99, "timestamp": "01:28:11", "text": "哦，是的。 生物。"}, {"type": "subtitle", "time": 5298.229, "timestamp": "01:28:18", "text": "我的意思是，那边有人在呼气。"}, {"type": "subtitle", "time": 5300.229, "timestamp": "01:28:20", "text": "有人在那边"}, {"type": "subtitle", "time": 5303.35, "timestamp": "01:28:23", "text": "生物站提取数据。 你看到天空下的那道光了吗？"}, {"type": "subtitle", "time": 5305.189, "timestamp": "01:28:25", "text": "哦，是的。"}, {"type": "subtitle", "time": 5305.51, "timestamp": "01:28:25", "text": "多久？   是"}, {"type": "subtitle", "time": 5307.669, "timestamp": "01:28:27", "text": "啊，那时候人们就会打电话。"}, {"type": "subtitle", "time": 5313.59, "timestamp": "01:28:33", "text": "拔出点可以使用多长时间？"}, {"type": "subtitle", "time": 5315.669, "timestamp": "01:28:35", "text": "你的意思是多久？"}, {"type": "subtitle", "time": 5318.229, "timestamp": "01:28:38", "text": "你还记得方舟吧？ 打开时会有"}, {"type": "subtitle", "time": 5320.87, "timestamp": "01:28:40", "text": "一个计时器"}, {"type": "subtitle", "time": 5322.55, "timestamp": "01:28:42", "text": "。   是的"}, {"type": "subtitle", "time": 5325.27, "timestamp": "01:28:45", "text": "。 我的意思是，它什么时候活跃，什么时候"}, {"type": "subtitle", "time": 5329.35, "timestamp": "01:28:49", "text": "不再活跃？"}, {"type": "subtitle", "time": 5332.229, "timestamp": "01:28:52", "text": "呃，什么时候激活它？我不太清楚，"}, {"type": "subtitle", "time": 5334.87, "timestamp": "01:28:54", "text": "因为我总是在它关闭之前就进入其中或者死了"}, {"type": "subtitle", "time": 5338.629, "timestamp": "01:28:58", "text": "。"}]
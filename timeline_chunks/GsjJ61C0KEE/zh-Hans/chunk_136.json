[{"type": "subtitle", "time": 8160.629, "timestamp": "02:16:00", "text": "是的，这里的机器人非常强大。"}, {"type": "subtitle", "time": 8164.47, "timestamp": "02:16:04", "text": "天哪，他们俩都死了。 等等，"}, {"type": "subtitle", "time": 8168.39, "timestamp": "02:16:08", "text": "你在哪里？ 我要去找你。"}, {"type": "subtitle", "time": 8171.99, "timestamp": "02:16:11", "text": "救救队友。 好吧，无论如何，"}, {"type": "subtitle", "time": 8173.35, "timestamp": "02:16:13", "text": "拯救球队。"}, {"type": "subtitle", "time": 8174.149, "timestamp": "02:16:14", "text": "他"}, {"type": "subtitle", "time": 8187.51, "timestamp": "02:16:27", "text": "你被吸进去了。 他的阴茎被"}, {"type": "subtitle", "time": 8188.87, "timestamp": "02:16:28", "text": "吸吮了。"}, {"type": "subtitle", "time": 8192.23, "timestamp": "02:16:32", "text": "他想拉拢我。"}, {"type": "subtitle", "time": 8194.23, "timestamp": "02:16:34", "text": "等等，等等，等等。 他正在吸我的血。 我"}, {"type": "subtitle", "time": 8197.429, "timestamp": "02:16:37", "text": "死了。 我死了。 我死了。"}, {"type": "subtitle", "time": 8198.469, "timestamp": "02:16:38", "text": "啊，"}, {"type": "subtitle", "time": 8199.429, "timestamp": "02:16:39", "text": "我死了。 我死了。 我死了。"}, {"type": "subtitle", "time": 8201.91, "timestamp": "02:16:41", "text": "起床。"}, {"type": "subtitle", "time": 8203.11, "timestamp": "02:16:43", "text": "不用担心。"}, {"type": "subtitle", "time": 8205.509, "timestamp": "02:16:45", "text": "即便如此，我还是可以救活你。"}, {"type": "subtitle", "time": 8207.75, "timestamp": "02:16:47", "text": "坚持，稍等。 坚持，稍等。 坚持，稍等。"}, {"type": "subtitle", "time": 8209.11, "timestamp": "02:16:49", "text": "我还能救活你。 我还能"}, {"type": "subtitle", "time": 8210.79, "timestamp": "02:16:50", "text": "救活你。"}, {"type": "subtitle", "time": 8214.87, "timestamp": "02:16:54", "text": "好的。 我的天，疯了。"}, {"type": "subtitle", "time": 8216.87, "timestamp": "02:16:56", "text": "该死。 是的，就算你那样死了，我们也"}, {"type": "subtitle", "time": 8219.11, "timestamp": "02:16:59", "text": "能把你救活。"}]
[{"type": "subtitle", "time": 9541.59, "timestamp": "02:39:01", "text": "，就在"}, {"type": "subtitle", "time": 9543.19, "timestamp": "02:39:03", "text": "你旁边。"}, {"type": "subtitle", "time": 9544.55, "timestamp": "02:39:04", "text": "我的房间在一楼"}, {"type": "subtitle", "time": 9547.27, "timestamp": "02:39:07", "text": "。 我无法连接它。"}, {"type": "subtitle", "time": 9549.83, "timestamp": "02:39:09", "text": "我只能通过自己的"}, {"type": "subtitle", "time": 9567.19, "timestamp": "02:39:27", "text": "搞什么鬼？  WHO？"}, {"type": "subtitle", "time": 9569.67, "timestamp": "02:39:29", "text": "我以为我们是在大厅里。 你"}, {"type": "subtitle", "time": 9582.15, "timestamp": "02:39:42", "text": "。 我们现在就在我的大厅里。 跟"}, {"type": "subtitle", "time": 9584.95, "timestamp": "02:39:44", "text": "那个人见一面。"}, {"type": "subtitle", "time": 9591.75, "timestamp": "02:39:51", "text": "好的。 我们在哪里？ 我们到了。 可以"}, {"type": "subtitle", "time": 9594.389, "timestamp": "02:39:54", "text": "过关。 解除他的静音。 解除他的静音。 他在"}, {"type": "subtitle", "time": 9597.03, "timestamp": "02:39:57", "text": "跟我们说话。"}]
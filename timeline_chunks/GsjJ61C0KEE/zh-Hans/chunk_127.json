[{"type": "subtitle", "time": 7621.75, "timestamp": "02:07:01", "text": "来了。   妈的"}, {"type": "subtitle", "time": 7641.43, "timestamp": "02:07:21", "text": "我好奇时间流逝。"}, {"type": "subtitle", "time": 7649.91, "timestamp": "02:07:29", "text": "我的天哪。"}, {"type": "subtitle", "time": 7652.629, "timestamp": "02:07:32", "text": "是哪个炮塔射中了你？"}, {"type": "subtitle", "time": 7663.03, "timestamp": "02:07:43", "text": "炮塔在哪儿？"}, {"type": "subtitle", "time": 7669.03, "timestamp": "02:07:49", "text": "在哪里？ 哦，"}, {"type": "subtitle", "time": 7670.709, "timestamp": "02:07:50", "text": "在哪儿？"}, {"type": "subtitle", "time": 7674.713, "timestamp": "02:07:54", "text": "我的天啊，它竟然在这该死的灌木丛里！"}]
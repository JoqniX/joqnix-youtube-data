[{"type": "subtitle", "time": 11880.95, "timestamp": "03:18:00", "text": "从免费的初始配置开始。"}, {"type": "subtitle", "time": 11881.429, "timestamp": "03:18:01", "text": "哦，"}, {"type": "subtitle", "time": 11883.75, "timestamp": "03:18:03", "text": "就像你看到其他人已经有"}, {"type": "subtitle", "time": 11885.349, "timestamp": "03:18:05", "text": "绿色护盾、蓝色护盾之类的东西了，"}, {"type": "subtitle", "time": 11885.99, "timestamp": "03:18:05", "text": "对吧？"}, {"type": "subtitle", "time": 11888.15, "timestamp": "03:18:08", "text": "嗯。 但是，在这种模式下，每个人都"}, {"type": "subtitle", "time": 11889.91, "timestamp": "03:18:09", "text": "必须从免费的初始"}, {"type": "subtitle", "time": 11891.91, "timestamp": "03:18:11", "text": "装备开始。 所以大家就都处于同一"}, {"type": "subtitle", "time": 11892.95, "timestamp": "03:18:12", "text": "水平线上了。"}, {"type": "subtitle", "time": 11894.15, "timestamp": "03:18:14", "text": "对，所以我才说这有点"}, {"type": "subtitle", "time": 11897.03, "timestamp": "03:18:17", "text": "像大逃杀游戏。"}, {"type": "subtitle", "time": 11899.75, "timestamp": "03:18:19", "text": "从同一水平开始，就会"}, {"type": "subtitle", "time": 11921.429, "timestamp": "03:18:41", "text": "闵"}, {"type": "subtitle", "time": 11938.95, "timestamp": "03:18:58", "text": "哦，夜色依旧深沉。"}]
[{"type": "subtitle", "time": 1803.83, "timestamp": "00:30:03", "text": "我的记忆力就像拥有16GB内存一样。"}, {"type": "subtitle", "time": 1806.549, "timestamp": "00:30:06", "text": "好了，已经满了。 好像"}, {"type": "subtitle", "time": 1808.95, "timestamp": "00:30:08", "text": "只剩下1GB的空间了。"}, {"type": "subtitle", "time": 1809.669, "timestamp": "00:30:09", "text": "我的天啊。"}, {"type": "subtitle", "time": 1812.71, "timestamp": "00:30:12", "text": "我不知道，乔什。 你后台同时运行着大概 10 个"}, {"type": "subtitle", "time": 1814.389, "timestamp": "00:30:14", "text": "程序"}, {"type": "subtitle", "time": 1815.35, "timestamp": "00:30:15", "text": "。"}, {"type": "subtitle", "time": 1817.909, "timestamp": "00:30:17", "text": "不，我没有。"}, {"type": "subtitle", "time": 1820.389, "timestamp": "00:30:20", "text": "我等等，哦，是的。  Epic Games。 让"}, {"type": "subtitle", "time": 1824.185, "timestamp": "00:30:24", "text": "我来结束这个话题。 嗯，"}, {"type": "subtitle", "time": 1827.43, "timestamp": "00:30:27", "text": "（嗤之以鼻）"}, {"type": "subtitle", "time": 1829.11, "timestamp": "00:30:29", "text": "问题是，"}, {"type": "subtitle", "time": 1831.75, "timestamp": "00:30:31", "text": "我用笔记本电脑就像用台式"}, {"type": "subtitle", "time": 1835.909, "timestamp": "00:30:35", "text": "电脑一样。 我如何使用我的电脑？"}, {"type": "subtitle", "time": 1836.789, "timestamp": "00:30:36", "text": "我不应该那样做。"}, {"type": "subtitle", "time": 1839.11, "timestamp": "00:30:39", "text": "你的电脑有多少内存？"}, {"type": "subtitle", "time": 1847.59, "timestamp": "00:30:47", "text": "我不知道。 我觉得笔记本电脑"}, {"type": "subtitle", "time": 1850.07, "timestamp": "00:30:50", "text": "更像是……嗯……"}, {"type": "subtitle", "time": 1851.99, "timestamp": "00:30:51", "text": "在地下运行的，不是地下，而是……"}, {"type": "subtitle", "time": 1853.909, "timestamp": "00:30:53", "text": "该怎么说呢，就像是"}, {"type": "subtitle", "time": 1856.549, "timestamp": "00:30:56", "text": "隐藏在后台运行的软件"}, {"type": "subtitle", "time": 1857.99, "timestamp": "00:30:57", "text": "。   是的"}, {"type": "subtitle", "time": 1858.23, "timestamp": "00:30:58", "text": "。"}]
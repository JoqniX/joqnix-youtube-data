[{"type": "subtitle", "time": 7680.149, "timestamp": "02:08:00", "text": "我们来做点什么吧。 嗯，"}, {"type": "subtitle", "time": 7685.51, "timestamp": "02:08:05", "text": "呃，游戏里要不要把我静音？"}, {"type": "subtitle", "time": 7688.79, "timestamp": "02:08:08", "text": "或者我们应该和旁边这位玩家说话吗"}, {"type": "subtitle", "time": 7690.709, "timestamp": "02:08:10", "text": "？ 他是职业选手吗？"}, {"type": "subtitle", "time": 7691.109, "timestamp": "02:08:11", "text": "我不这么认为。"}, {"type": "subtitle", "time": 7692.87, "timestamp": "02:08:12", "text": "你怎么认为？"}, {"type": "subtitle", "time": 7696.069, "timestamp": "02:08:16", "text": "我觉得他不会回复。"}, {"type": "subtitle", "time": 7697.83, "timestamp": "02:08:17", "text": "是啊，"}, {"type": "subtitle", "time": 7701.75, "timestamp": "02:08:21", "text": "我太需要医疗包了。"}, {"type": "subtitle", "time": 7703.27, "timestamp": "02:08:23", "text": "呃，是的，我在这里杀了很多人"}, {"type": "subtitle", "time": 7705.83, "timestamp": "02:08:25", "text": "。 你可以去看看。"}, {"type": "subtitle", "time": 7706.709, "timestamp": "02:08:26", "text": "在哪里？ 好的，"}, {"type": "subtitle", "time": 7709.99, "timestamp": "02:08:29", "text": "这边好像有三具尸体。"}, {"type": "subtitle", "time": 7712.31, "timestamp": "02:08:32", "text": "我进度落后了。"}, {"type": "subtitle", "time": 7714.31, "timestamp": "02:08:34", "text": "我被困住了。 好吧，我有点慢。 好的，我"}, {"type": "subtitle", "time": 7717.03, "timestamp": "02:08:37", "text": "没事了。 又要被传送走了。"}, {"type": "subtitle", "time": 7719.03, "timestamp": "02:08:39", "text": "快点。"}, {"type": "subtitle", "time": 7720.31, "timestamp": "02:08:40", "text": "做点什么。"}, {"type": "subtitle", "time": 7723.03, "timestamp": "02:08:43", "text": "好东西。 拉屎。"}, {"type": "subtitle", "time": 7724.79, "timestamp": "02:08:44", "text": "是的，我会为你丢掉一些东西。"}, {"type": "subtitle", "time": 7726.709, "timestamp": "02:08:46", "text": "有个家伙有很多"}, {"type": "subtitle", "time": 7728.95, "timestamp": "02:08:48", "text": "好东西。"}, {"type": "subtitle", "time": 7732.95, "timestamp": "02:08:52", "text": "哦，我的直播也快结束了。"}, {"type": "subtitle", "time": 7735.83, "timestamp": "02:08:55", "text": "哦，那可糟了。"}, {"type": "subtitle", "time": 7738.629, "timestamp": "02:08:58", "text": "像个红色的东西。"}]
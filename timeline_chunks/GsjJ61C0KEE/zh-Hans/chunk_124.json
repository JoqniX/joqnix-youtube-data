[{"type": "subtitle", "time": 7452.95, "timestamp": "02:04:12", "text": "呃，终端。 或许就在这儿。 或许。"}, {"type": "subtitle", "time": 7455.75, "timestamp": "02:04:15", "text": "可能就在这儿。"}, {"type": "subtitle", "time": 7456.95, "timestamp": "02:04:16", "text": "我不知道对方在"}, {"type": "subtitle", "time": 7458.95, "timestamp": "02:04:18", "text": "射什么。"}, {"type": "subtitle", "time": 7459.189, "timestamp": "02:04:19", "text": "我"}, {"type": "subtitle", "time": 7465.51, "timestamp": "02:04:25", "text": "还是丢包了？或者"}, {"type": "subtitle", "time": 7467.83, "timestamp": "02:04:27", "text": "我怎么才能知道？"}, {"type": "subtitle", "time": 7475.75, "timestamp": "02:04:35", "text": "FPS 附近好像有个红色的闪烁图标。"}, {"type": "subtitle", "time": 7476.79, "timestamp": "02:04:36", "text": "我觉得它又回来了。   是的"}, {"type": "subtitle", "time": 7478.39, "timestamp": "02:04:38", "text": "，我也有。   是的"}, {"type": "subtitle", "time": 7480.149, "timestamp": "02:04:40", "text": "，又输了。 我被传送"}, {"type": "subtitle", "time": 7482.07, "timestamp": "02:04:42", "text": "回去了。"}, {"type": "subtitle", "time": 7484.31, "timestamp": "02:04:44", "text": "我确实有。（嗤笑） 我抽到了红色和粉色。"}, {"type": "subtitle", "time": 7487.669, "timestamp": "02:04:47", "text": "是的，他们那边正在开枪。"}]
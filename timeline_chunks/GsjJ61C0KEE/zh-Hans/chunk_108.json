[{"type": "subtitle", "time": 6482.87, "timestamp": "01:48:02", "text": "是AB1。 你只需要"}, {"type": "subtitle", "time": 6485.109, "timestamp": "01:48:05", "text": "在 YouTube 上创建一个 A1 编码的视频流即可。"}, {"type": "subtitle", "time": 6486.149, "timestamp": "01:48:06", "text": "但你并没有进行多路流媒体播放。"}, {"type": "subtitle", "time": 6487.99, "timestamp": "01:48:07", "text": "好的。 你没落后吧？"}, {"type": "subtitle", "time": 6488.79, "timestamp": "01:48:08", "text": "是的，我不太明白"}, {"type": "subtitle", "time": 6489.51, "timestamp": "01:48:09", "text": "。"}, {"type": "subtitle", "time": 6491.91, "timestamp": "01:48:11", "text": "你没有落后。"}, {"type": "subtitle", "time": 6493.189, "timestamp": "01:48:13", "text": "啊，你刚才说了“是"}, {"type": "subtitle", "time": 6494.95, "timestamp": "01:48:14", "text": "啊，我的Wi-Fi有点卡顿”。"}, {"type": "subtitle", "time": 6498.319, "timestamp": "01:48:18", "text": "你非说不可。"}, {"type": "subtitle", "time": 6499.83, "timestamp": "01:48:19", "text": "[笑声]"}, {"type": "subtitle", "time": 6501.43, "timestamp": "01:48:21", "text": "现在你的电脑是不是卡顿了？   是的"}, {"type": "subtitle", "time": 6503.91, "timestamp": "01:48:23", "text": "。"}, {"type": "subtitle", "time": 6505.99, "timestamp": "01:48:25", "text": "我的也卡顿了。 哦，糟糕。"}, {"type": "subtitle", "time": 6516.47, "timestamp": "01:48:36", "text": "不，不是那种很严重的卡顿，只是"}, {"type": "subtitle", "time": 6520.95, "timestamp": "01:48:40", "text": "右上角有个红色的符号。 所以，"}, {"type": "subtitle", "time": 6524.229, "timestamp": "01:48:44", "text": "我遇到了丢包问题。 我感觉自己像是在"}, {"type": "subtitle", "time": 6526.39, "timestamp": "01:48:46", "text": "躲避"}]
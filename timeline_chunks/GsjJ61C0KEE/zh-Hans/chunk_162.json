[{"type": "subtitle", "time": 9720.79, "timestamp": "02:42:00", "text": "哇。"}, {"type": "subtitle", "time": 9721.83, "timestamp": "02:42:01", "text": "我浑身都是蓝色的。"}, {"type": "subtitle", "time": 9725.27, "timestamp": "02:42:05", "text": "好的，我先去看看"}, {"type": "subtitle", "time": 9727.91, "timestamp": "02:42:07", "text": "另一个人。 现在是白色的。"}, {"type": "subtitle", "time": 9730.87, "timestamp": "02:42:10", "text": "我流的是白色的血。 布鲁搞砸了。"}, {"type": "subtitle", "time": 9740.15, "timestamp": "02:42:20", "text": "哦，你死了。"}, {"type": "subtitle", "time": 9741.03, "timestamp": "02:42:21", "text": "冷静点，伙计们。 冷静下来。"}, {"type": "subtitle", "time": 9744.309, "timestamp": "02:42:24", "text": "他们发布了新版本。"}, {"type": "subtitle", "time": 9745.59, "timestamp": "02:42:25", "text": "那个机器人会在你死后直接开枪打死你，"}, {"type": "subtitle", "time": 9763.19, "timestamp": "02:42:43", "text": "小心。 注意身后。"}, {"type": "subtitle", "time": 9764.389, "timestamp": "02:42:44", "text": "过来。 跟我来。 跟我来。   我"}, {"type": "subtitle", "time": 9764.95, "timestamp": "02:42:44", "text": "的天哪！"}, {"type": "subtitle", "time": 9767.75, "timestamp": "02:42:47", "text": "我的老天爷！"}, {"type": "subtitle", "time": 9769.11, "timestamp": "02:42:49", "text": "过来。 爬吧，爬吧。 过来。"}, {"type": "subtitle", "time": 9777.59, "timestamp": "02:42:57", "text": "去。 开你的车慢点，"}]
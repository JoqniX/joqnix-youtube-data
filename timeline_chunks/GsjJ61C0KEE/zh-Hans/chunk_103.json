[{"type": "subtitle", "time": 6196.629, "timestamp": "01:43:16", "text": "楼梯上检测到加固设施。   砰砰砰"}, {"type": "subtitle", "time": 6199.03, "timestamp": "01:43:19", "text": "。   这边"}, {"type": "subtitle", "time": 6205.59, "timestamp": "01:43:25", "text": "。 他们三个。 他们抓到了"}, {"type": "subtitle", "time": 6207.59, "timestamp": "01:43:27", "text": "一个人。"}, {"type": "subtitle", "time": 6211.189, "timestamp": "01:43:31", "text": "我根本看不到他们。"}, {"type": "subtitle", "time": 6212.31, "timestamp": "01:43:32", "text": "天哪，我真的这么做了。"}, {"type": "subtitle", "time": 6213.109, "timestamp": "01:43:33", "text": "哦，不错嘛。"}, {"type": "subtitle", "time": 6218.55, "timestamp": "01:43:38", "text": "不要操之过急。 哦，他来了"}, {"type": "subtitle", "time": 6219.669, "timestamp": "01:43:39", "text": "。   很"}, {"type": "subtitle", "time": 6224.629, "timestamp": "01:43:44", "text": "你好，乔克。"}, {"type": "subtitle", "time": 6231.99, "timestamp": "01:43:51", "text": "这家伙害死了我们。"}, {"type": "subtitle", "time": 6236.07, "timestamp": "01:43:56", "text": "该死。"}, {"type": "subtitle", "time": 6239.75, "timestamp": "01:43:59", "text": "奇怪的。 或许可以恢复默认设置。"}]
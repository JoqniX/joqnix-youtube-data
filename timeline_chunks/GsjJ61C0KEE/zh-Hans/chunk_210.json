[{"type": "subtitle", "time": 12606.229, "timestamp": "03:30:06", "text": "他是不是出故障了？"}, {"type": "subtitle", "time": 12619.59, "timestamp": "03:30:19", "text": "他出故障了。"}, {"type": "subtitle", "time": 12622.469, "timestamp": "03:30:22", "text": "我在"}, {"type": "subtitle", "time": 12624.95, "timestamp": "03:30:24", "text": "运输船里揍他。 这是什么？ 等等，粉色部分是什么"}, {"type": "subtitle", "time": 12629.19, "timestamp": "03:30:29", "text": "？"}, {"type": "subtitle", "time": 12631.349, "timestamp": "03:30:31", "text": "我去，是"}, {"type": "subtitle", "time": 12635.03, "timestamp": "03:30:35", "text": "车队。 啊。   妈的"}, {"type": "subtitle", "time": 12636.95, "timestamp": "03:30:36", "text": "。 我死了。 我死了。 我死了。"}, {"type": "subtitle", "time": 12645.91, "timestamp": "03:30:45", "text": "哦，这个东西。   真是"}, {"type": "subtitle", "time": 12646.87, "timestamp": "03:30:46", "text": "愚蠢。就是这样。"}, {"type": "subtitle", "time": 12651.269, "timestamp": "03:30:51", "text": "什么？"}, {"type": "subtitle", "time": 12656.71, "timestamp": "03:30:56", "text": "我想我是摔倒受伤的。 有人从背后开枪打中了我"}, {"type": "subtitle", "time": 12659.19, "timestamp": "03:30:59", "text": "。 我不知道。   是的"}]
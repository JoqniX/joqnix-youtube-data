[{"type": "subtitle", "time": 11701.429, "timestamp": "03:15:01", "text": "等等，你是怎么死"}, {"type": "subtitle", "time": 11704.79, "timestamp": "03:15:04", "text": "在那里的？ 被隔离在那里。"}, {"type": "subtitle", "time": 11706.55, "timestamp": "03:15:06", "text": "里面有一个团队。"}, {"type": "subtitle", "time": 11714.309, "timestamp": "03:15:14", "text": "检测到无人机。"}, {"type": "subtitle", "time": 11717.269, "timestamp": "03:15:17", "text": "另一个人会来。 不，不，"}, {"type": "subtitle", "time": 11727.59, "timestamp": "03:15:27", "text": "哦，操。"}, {"type": "subtitle", "time": 11730.15, "timestamp": "03:15:30", "text": "哦，他们有狙击手。 他们有狙击手。"}, {"type": "subtitle", "time": 11731.99, "timestamp": "03:15:31", "text": "你看到那盏黄灯了吗？ 那"}, {"type": "subtitle", "time": 11734.71, "timestamp": "03:15:34", "text": "意思是说他正在用狙击步枪瞄准。"}, {"type": "subtitle", "time": 11735.83, "timestamp": "03:15:35", "text": "这是正确的。"}, {"type": "subtitle", "time": 11737.19, "timestamp": "03:15:37", "text": "哦，是的"}, {"type": "subtitle", "time": 11738.469, "timestamp": "03:15:38", "text": "。 所以，这件事你得"}, {"type": "subtitle", "time": 11740.63, "timestamp": "03:15:40", "text": "小心点。   是的"}, {"type": "subtitle", "time": 11741.99, "timestamp": "03:15:41", "text": "。 我觉得这个人不会来了"}, {"type": "subtitle", "time": 11744.63, "timestamp": "03:15:44", "text": "。"}]
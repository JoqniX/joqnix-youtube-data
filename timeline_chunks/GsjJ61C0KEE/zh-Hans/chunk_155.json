[{"type": "subtitle", "time": 9304.309, "timestamp": "02:35:04", "text": "为人类提供食物的整个派系，"}, {"type": "subtitle", "time": 9306.71, "timestamp": "02:35:06", "text": "就像打印食物、3D打印"}, {"type": "subtitle", "time": 9308.389, "timestamp": "02:35:08", "text": "食物之类的，"}, {"type": "subtitle", "time": 9310.469, "timestamp": "02:35:10", "text": "就像一个巨型企业。"}, {"type": "subtitle", "time": 9314.55, "timestamp": "02:35:14", "text": "Traxxas就像一家超级富有的"}, {"type": "subtitle", "time": 9316.309, "timestamp": "02:35:16", "text": "公司。 我还没研究过"}, {"type": "subtitle", "time": 9318.87, "timestamp": "02:35:18", "text": "它的背景故事，但这确实是一头非常"}, {"type": "subtitle", "time": 9319.349, "timestamp": "02:35:19", "text": "富有的"}, {"type": "subtitle", "time": 9322.71, "timestamp": "02:35:22", "text": "机械狮子。 没错，"}, {"type": "subtitle", "time": 9325.59, "timestamp": "02:35:25", "text": "德拉克斯可以说是游戏中最富有的"}, {"type": "subtitle", "time": 9327.67, "timestamp": "02:35:27", "text": "公司了。 所以，他们"}, {"type": "subtitle", "time": 9330.71, "timestamp": "02:35:30", "text": "在游戏中拥有相当大的权力。"}, {"type": "subtitle", "time": 9333.83, "timestamp": "02:35:33", "text": "嗯，还有阿拉克涅。  Arachnne就像一个"}, {"type": "subtitle", "time": 9336.63, "timestamp": "02:35:36", "text": "死亡邪教。 这简直就像邪教一样。 他们"}, {"type": "subtitle", "time": 9338.55, "timestamp": "02:35:38", "text": "崇拜死亡之类的东西。"}, {"type": "subtitle", "time": 9340.23, "timestamp": "02:35:40", "text": "哦，那里简直有疯子。"}, {"type": "subtitle", "time": 9341.91, "timestamp": "02:35:41", "text": "这就是为什么"}, {"type": "subtitle", "time": 9344.23, "timestamp": "02:35:44", "text": "在这个游戏中，人们因为"}, {"type": "subtitle", "time": 9348.15, "timestamp": "02:35:48", "text": "阵营问题而互相残杀的原因。 蛛形纲。"}, {"type": "subtitle", "time": 9351.429, "timestamp": "02:35:51", "text": "是的，因为当你杀人时，他们"}, {"type": "subtitle", "time": 9354.07, "timestamp": "02:35:54", "text": "会给你 Arachnne XP，可以用来"}, {"type": "subtitle", "time": 9357.75, "timestamp": "02:35:57", "text": "提升 Arachnne 时尚等级。 所以"}, {"type": "subtitle", "time": 9359.59, "timestamp": "02:35:59", "text": "这就是为什么人们"}]
[{"type": "subtitle", "time": 11040.07, "timestamp": "03:04:00", "text": "あなたが見つけた身分証明書は、新任の"}, {"type": "subtitle", "time": 11042.79, "timestamp": "03:04:02", "text": "カロリーミッション専門家のものでした。"}, {"type": "subtitle", "time": 11053.91, "timestamp": "03:04:13", "text": "新しい契約。 わかった。"}, {"type": "subtitle", "time": 11058.71, "timestamp": "03:04:18", "text": "Arachnneという団体から問い合わせがありました。 彼らはあなたの"}, {"type": "subtitle", "time": 11069.51, "timestamp": "03:04:29", "text": "ああ、ランナーが1人少ないランナーにダメージを与える"}, {"type": "subtitle", "time": 11076.95, "timestamp": "03:04:36", "text": "、違うよ。 もしチームメイトがランナーを倒したプレーでも"}, {"type": "subtitle", "time": 11079.67, "timestamp": "03:04:39", "text": "、それは"}, {"type": "subtitle", "time": 11082.309, "timestamp": "03:04:42", "text": "あなたのプレーとしてカウントされます。"}, {"type": "subtitle", "time": 11084.95, "timestamp": "03:04:44", "text": "うん。 チームメイトがやった場合でも、それは"}, {"type": "subtitle", "time": 11087.75, "timestamp": "03:04:47", "text": "有効です。 だから、それほど"}, {"type": "subtitle", "time": 11092.07, "timestamp": "03:04:52", "text": "難しくはないと言えるでしょう。"}, {"type": "subtitle", "time": 11094.63, "timestamp": "03:04:54", "text": "よし、部屋にある農業関連の装置のロックを解除してくれ"}]
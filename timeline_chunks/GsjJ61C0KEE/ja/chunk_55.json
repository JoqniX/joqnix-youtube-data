[{"type": "subtitle", "time": 3301.829, "timestamp": "00:55:01", "text": "今日のスポンサーが表示されます。 そこで"}, {"type": "subtitle", "time": 3304.309, "timestamp": "00:55:04", "text": "ほとんどの無料アイテムを入手できます。"}, {"type": "subtitle", "time": 3306.79, "timestamp": "00:55:06", "text": "Nucleicは"}, {"type": "subtitle", "time": 3310.47, "timestamp": "00:55:10", "text": "良いスポンサーです。"}, {"type": "subtitle", "time": 3314.87, "timestamp": "00:55:14", "text": "えっと、無料って書いてあるやつ、灰色のやつ、あれは"}, {"type": "subtitle", "time": 3318.87, "timestamp": "00:55:18", "text": "無料です。 うん。"}, {"type": "subtitle", "time": 3322.069, "timestamp": "00:55:22", "text": "スポンサーキットは"}, {"type": "subtitle", "time": 3324.069, "timestamp": "00:55:24", "text": "毎日変わるので、異なる"}, {"type": "subtitle", "time": 3326.87, "timestamp": "00:55:26", "text": "派閥が毎日異なる装備を提供してくれます"}, {"type": "subtitle", "time": 3330.87, "timestamp": "00:55:30", "text": "。 だから彼らはそれを回転させるのが好きなんだ"}, {"type": "subtitle", "time": 3336.309, "timestamp": "00:55:36", "text": "。 えっと、バックはどこで買えますか？ そうそう"}, {"type": "subtitle", "time": 3338.549, "timestamp": "00:55:38", "text": "。 バックパックの"}, {"type": "subtitle", "time": 3345.75, "timestamp": "00:55:45", "text": "ええ、まずは"}, {"type": "subtitle", "time": 3348.95, "timestamp": "00:55:48", "text": "アップグレードの部分を開く必要があります"}, {"type": "subtitle", "time": 3351.349, "timestamp": "00:55:51", "text": "。   どういうわけか"}, {"type": "subtitle", "time": 3353.43, "timestamp": "00:55:53", "text": "、私たちはなんとか脱出できた"}, {"type": "subtitle", "time": 3355.75, "timestamp": "00:55:55", "text": "。"}, {"type": "subtitle", "time": 3359.829, "timestamp": "00:55:59", "text": "近くの船のコンテナをスキャンしてください。 よし、もう一度きちんとやってみよう"}]
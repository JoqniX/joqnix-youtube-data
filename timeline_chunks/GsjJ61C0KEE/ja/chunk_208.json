[{"type": "subtitle", "time": 12481.429, "timestamp": "03:28:01", "text": "そしてこの男は一人で立ち去った。"}, {"type": "subtitle", "time": 12492.63, "timestamp": "03:28:12", "text": "。 ごくわずかな金額で加入できる保険"}, {"type": "subtitle", "time": 12507.99, "timestamp": "03:28:27", "text": "これは必要ない。"}, {"type": "subtitle", "time": 12509.59, "timestamp": "03:28:29", "text": "気をつけなさい、お嬢さん。"}, {"type": "subtitle", "time": 12510.309, "timestamp": "03:28:30", "text": "私は死んだ。"}, {"type": "subtitle", "time": 12531.429, "timestamp": "03:28:51", "text": "、あれはゾンビだ。 聞きましたよね。"}, {"type": "subtitle", "time": 12533.99, "timestamp": "03:28:53", "text": "どこですか？"}, {"type": "subtitle", "time": 12539.03, "timestamp": "03:28:59", "text": "私は回復魔法を持っていません。 ヘルプ。"}]
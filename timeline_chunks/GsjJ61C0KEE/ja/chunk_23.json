[{"type": "subtitle", "time": 1395.27, "timestamp": "00:23:15", "text": "はい、そろそろ戻ります。 こんにちは。 お元気ですか？また"}, {"type": "subtitle", "time": 1397.19, "timestamp": "00:23:17", "text": "連絡させてください。"}, {"type": "subtitle", "time": 1412.549, "timestamp": "00:23:32", "text": "こんにちは。 こんにちは。 私の声が聞こえますか？"}, {"type": "subtitle", "time": 1415.11, "timestamp": "00:23:35", "text": "こんにちは。 はい。   わかった"}, {"type": "subtitle", "time": 1418.789, "timestamp": "00:23:38", "text": "。 ええと、再接続されて元に戻ったと"}, {"type": "subtitle", "time": 1420.95, "timestamp": "00:23:40", "text": "思います。 うん。"}, {"type": "subtitle", "time": 1421.59, "timestamp": "00:23:41", "text": "うまくいけば。"}, {"type": "subtitle", "time": 1424.07, "timestamp": "00:23:44", "text": "ああ、それはクソだ"}, {"type": "subtitle", "time": 1426.31, "timestamp": "00:23:46", "text": "。   わかった"}, {"type": "subtitle", "time": 1428.87, "timestamp": "00:23:48", "text": "。 チャットも含め、すべて元に戻るはずです"}, {"type": "subtitle", "time": 1431.59, "timestamp": "00:23:51", "text": "。"}]
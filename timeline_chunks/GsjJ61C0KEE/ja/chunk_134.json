[{"type": "subtitle", "time": 8040.709, "timestamp": "02:14:00", "text": "。"}, {"type": "subtitle", "time": 8043.189, "timestamp": "02:14:03", "text": "弾薬バックパックがある。"}, {"type": "subtitle", "time": 8044.55, "timestamp": "02:14:04", "text": "ああ、君たちもここにいたんだね。"}, {"type": "subtitle", "time": 8046.87, "timestamp": "02:14:06", "text": "もの。   ああ"}, {"type": "subtitle", "time": 8049.91, "timestamp": "02:14:09", "text": "、この戦利品だ。"}, {"type": "subtitle", "time": 8052.39, "timestamp": "02:14:12", "text": "物がたくさんありすぎる。"}, {"type": "subtitle", "time": 8055.35, "timestamp": "02:14:15", "text": "私はただ自分のクエストをクリアしたいだけなのに、それができない"}, {"type": "subtitle", "time": 8058.55, "timestamp": "02:14:18", "text": "。 おお。"}, {"type": "subtitle", "time": 8061.109, "timestamp": "02:14:21", "text": "ああ、それはあったんですね。  [笑い]"}, {"type": "subtitle", "time": 8063.589, "timestamp": "02:14:23", "text": "時々、良い"}, {"type": "subtitle", "time": 8066.47, "timestamp": "02:14:26", "text": "戦利品が多すぎて、"}, {"type": "subtitle", "time": 8068.79, "timestamp": "02:14:28", "text": "クエストをすることを忘れてしまうことがあります。 正直言って、それはゲームの一部だ"}, {"type": "subtitle", "time": 8070.149, "timestamp": "02:14:30", "text": "。"}, {"type": "subtitle", "time": 8081.03, "timestamp": "02:14:41", "text": "最高級ダニミルク。 何だって？   ロビーにいた"}, {"type": "subtitle", "time": 8084.87, "timestamp": "02:14:44", "text": "全員を殺したと思う。"}, {"type": "subtitle", "time": 8087.109, "timestamp": "02:14:47", "text": "私たちは本当に"}, {"type": "subtitle", "time": 8087.589, "timestamp": "02:14:47", "text": "狂っていたのだろうか？"}, {"type": "subtitle", "time": 8091.75, "timestamp": "02:14:51", "text": "。"}, {"type": "subtitle", "time": 8096.47, "timestamp": "02:14:56", "text": "つまり、私たちは3チームくらいを倒したんです。 いいえ。"}, {"type": "subtitle", "time": 8099.27, "timestamp": "02:14:59", "text": "ええ、3チームです。"}]
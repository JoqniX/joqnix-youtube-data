[{"type": "subtitle", "time": 6027.03, "timestamp": "01:40:27", "text": "大きな男の子の声が聞こえる。 わかりました。では、"}, {"type": "subtitle", "time": 6030.629, "timestamp": "01:40:30", "text": "契約書はどこにあるのでしょうか？ ええと、"}, {"type": "subtitle", "time": 6031.59, "timestamp": "01:40:31", "text": "メンテナンスです。"}, {"type": "subtitle", "time": 6033.91, "timestamp": "01:40:33", "text": "ああ、ああだと思います。 ああ、それは"}, {"type": "subtitle", "time": 6035.189, "timestamp": "01:40:35", "text": "この地図には載っていません。"}, {"type": "subtitle", "time": 6037.109, "timestamp": "01:40:37", "text": "それほど悪くはない。"}, {"type": "subtitle", "time": 6039.59, "timestamp": "01:40:39", "text": "待って、私は受け取らなかったの？"}, {"type": "subtitle", "time": 6041.83, "timestamp": "01:40:41", "text": "うん、君はTraxxasのものを選ぶと思うよ"}, {"type": "subtitle", "time": 6044.79, "timestamp": "01:40:44", "text": "。"}, {"type": "subtitle", "time": 6047.51, "timestamp": "01:40:47", "text": "つまり、これは地図ではありません。"}, {"type": "subtitle", "time": 6050.39, "timestamp": "01:40:50", "text": "はい、これが"}, {"type": "subtitle", "time": 6056.07, "timestamp": "01:40:56", "text": "Traxxasのやつは、"}, {"type": "subtitle", "time": 6058.55, "timestamp": "01:40:58", "text": "以前あなたのために試してみたやつで、"}]
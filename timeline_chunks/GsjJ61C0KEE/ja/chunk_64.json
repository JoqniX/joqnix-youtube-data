[{"type": "subtitle", "time": 3842.15, "timestamp": "01:04:02", "text": "物を落とさないように気をつけなきゃいけないってことだね。   そうそう"}, {"type": "subtitle", "time": 3844.39, "timestamp": "01:04:04", "text": "。"}, {"type": "subtitle", "time": 3845.99, "timestamp": "01:04:05", "text": "ああ、彼らは新しい銃を手に入れたんだ。"}, {"type": "subtitle", "time": 3848.15, "timestamp": "01:04:08", "text": "なかなかいい感じだね。"}, {"type": "subtitle", "time": 3850.47, "timestamp": "01:04:10", "text": "それはまるで短機関銃のようだ。 いいえ、"}, {"type": "subtitle", "time": 3853.19, "timestamp": "01:04:13", "text": "短機関銃ではありません。 それはなかなかクールだね。   ここに"}, {"type": "subtitle", "time": 3855.43, "timestamp": "01:04:15", "text": "来て。 こちらです。 ここだ。 ここだ。"}, {"type": "subtitle", "time": 3856.309, "timestamp": "01:04:16", "text": "ああ、持って行ける"}, {"type": "subtitle", "time": 3859.829, "timestamp": "01:04:19", "text": "良い銃が2丁あるよ。   しかし、"}, {"type": "subtitle", "time": 3861.75, "timestamp": "01:04:21", "text": "その小さな部品こそが新しい"}, {"type": "subtitle", "time": 3864.309, "timestamp": "01:04:24", "text": "銃なのだ。"}, {"type": "subtitle", "time": 3866.549, "timestamp": "01:04:26", "text": "使ってみるとなかなか面白いと思う。"}, {"type": "subtitle", "time": 3868.549, "timestamp": "01:04:28", "text": "うん。"}, {"type": "subtitle", "time": 3872.47, "timestamp": "01:04:32", "text": "こちらがボディシールドです。いいね！を押してください"}, {"type": "subtitle", "time": 3875.67, "timestamp": "01:04:35", "text": "。"}, {"type": "subtitle", "time": 3882.39, "timestamp": "01:04:42", "text": "銃を見れば、"}, {"type": "subtitle", "time": 3884.95, "timestamp": "01:04:44", "text": "彼らがどんな弾薬を使っているか分かるよ。"}, {"type": "subtitle", "time": 3891.349, "timestamp": "01:04:51", "text": "これを受け取って。"}]
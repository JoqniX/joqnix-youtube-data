[{"type": "subtitle", "time": 4025.19, "timestamp": "01:07:05", "text": "法律がなくてもやっていけると思う。"}, {"type": "subtitle", "time": 4027.109, "timestamp": "01:07:07", "text": "うん。 うん。"}, {"type": "subtitle", "time": 4029.67, "timestamp": "01:07:09", "text": "ああ、どうぞ。 ここ。"}, {"type": "subtitle", "time": 4031.99, "timestamp": "01:07:11", "text": "こちらです。 どこ？"}, {"type": "subtitle", "time": 4033.349, "timestamp": "01:07:13", "text": "ああ、彼はもうノックしたよ。 彼のチーム"}, {"type": "subtitle", "time": 4044.309, "timestamp": "01:07:24", "text": "どうやって食べればいいんですか？"}, {"type": "subtitle", "time": 4045.43, "timestamp": "01:07:25", "text": "あのね？ 私は行くつもりです。あなたは"}, {"type": "subtitle", "time": 4047.91, "timestamp": "01:07:27", "text": "何ですか？ えっと、あぁ、"}, {"type": "subtitle", "time": 4059.19, "timestamp": "01:07:39", "text": "弾薬を手に入れた。 シールドを手に入れた。 ああ、彼は"}]
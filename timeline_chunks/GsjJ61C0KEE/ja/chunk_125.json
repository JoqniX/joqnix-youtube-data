[{"type": "subtitle", "time": 7504.229, "timestamp": "02:05:04", "text": "思う。"}, {"type": "subtitle", "time": 7506.31, "timestamp": "02:05:06", "text": "私たちはメンテナンスを担当しています。"}, {"type": "subtitle", "time": 7507.109, "timestamp": "02:05:07", "text": "ええ、でも"}, {"type": "subtitle", "time": 7509.43, "timestamp": "02:05:09", "text": "周りに人がいるので気をつけてください。"}, {"type": "subtitle", "time": 7511.43, "timestamp": "02:05:11", "text": "人々は"}, {"type": "subtitle", "time": 7515.83, "timestamp": "02:05:15", "text": "北西に住んでいます。 くそっ。"}, {"type": "subtitle", "time": 7549.109, "timestamp": "02:05:49", "text": "何だって？"}, {"type": "subtitle", "time": 7552.149, "timestamp": "02:05:52", "text": "私は今、人を殺した。"}, {"type": "subtitle", "time": 7554.55, "timestamp": "02:05:54", "text": "おお、いいね。   私は"}, {"type": "subtitle", "time": 7559.189, "timestamp": "02:05:59", "text": "何？"}]
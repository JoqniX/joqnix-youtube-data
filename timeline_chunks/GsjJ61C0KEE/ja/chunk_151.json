[{"type": "subtitle", "time": 9060.79, "timestamp": "02:31:00", "text": "俺の紫色のウンコをスナイパーライフルにぶち込んだ"}, {"type": "subtitle", "time": 9069.59, "timestamp": "02:31:09", "text": "考えがある。   そろそろ"}, {"type": "subtitle", "time": 9070.15, "timestamp": "02:31:10", "text": "行動を起こす時だ。"}, {"type": "subtitle", "time": 9070.389, "timestamp": "02:31:10", "text": "くそ。"}, {"type": "subtitle", "time": 9072.23, "timestamp": "02:31:12", "text": "うん、正直に言うと、他の人について行けばいいよ"}, {"type": "subtitle", "time": 9072.79, "timestamp": "02:31:12", "text": "。   私は"}, {"type": "subtitle", "time": 9073.91, "timestamp": "02:31:13", "text": "これを描きます。"}, {"type": "subtitle", "time": 9085.11, "timestamp": "02:31:25", "text": "この男からかなりひどい略奪行為をしている。"}, {"type": "subtitle", "time": 9087.03, "timestamp": "02:31:27", "text": "あなたのドローンは実際に「あ、あそこにいる」と思うことができます"}, {"type": "subtitle", "time": 9090.63, "timestamp": "02:31:30", "text": "。 あれだ。 あれだ。"}, {"type": "subtitle", "time": 9092.15, "timestamp": "02:31:32", "text": "あなたは今、私の体の上にいます。"}, {"type": "subtitle", "time": 9094.87, "timestamp": "02:31:34", "text": "しかし、側面から攻撃することは可能だ。"}, {"type": "subtitle", "time": 9097.19, "timestamp": "02:31:37", "text": "この見えない壁をどうやって乗り越えればいいのでしょうか？"}, {"type": "subtitle", "time": 9098.71, "timestamp": "02:31:38", "text": "いいえ、いいえ、できません。 あなたはできません。"}, {"type": "subtitle", "time": 9099.349, "timestamp": "02:31:39", "text": "無理だよ、"}, {"type": "subtitle", "time": 9101.91, "timestamp": "02:31:41", "text": "兄弟。 それを回避するには、うまく立ち回る必要がある"}, {"type": "subtitle", "time": 9113.59, "timestamp": "02:31:53", "text": "ああ、彼らはもう"}, {"type": "subtitle", "time": 9116.23, "timestamp": "02:31:56", "text": "この時点でうんちを全部済ませてしまったんだろうな。"}, {"type": "subtitle", "time": 9118.23, "timestamp": "02:31:58", "text": "つまり、私を撃ったのはたった一人だけなんです"}]
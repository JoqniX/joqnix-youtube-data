[{"type": "subtitle", "time": 9001.27, "timestamp": "02:30:01", "text": "彼は自分の使命を遂行している。 彼は自分の"}, {"type": "subtitle", "time": 9002.15, "timestamp": "02:30:02", "text": "使命を遂行している。   わかった"}, {"type": "subtitle", "time": 9003.03, "timestamp": "02:30:03", "text": "。"}, {"type": "subtitle", "time": 9004.95, "timestamp": "02:30:04", "text": "ああ、くそ。 くそ。 くそ。 くそ。 くそ。 私です。"}, {"type": "subtitle", "time": 9006.79, "timestamp": "02:30:06", "text": "私です。 ああ、"}, {"type": "subtitle", "time": 9007.91, "timestamp": "02:30:07", "text": "私は死んだ。"}, {"type": "subtitle", "time": 9010.95, "timestamp": "02:30:10", "text": "ここであなたを蘇生させるにはどうすればいいですか？"}, {"type": "subtitle", "time": 9014.469, "timestamp": "02:30:14", "text": "えっと、私の体に付いているタイマーが見えますか？"}, {"type": "subtitle", "time": 9016.309, "timestamp": "02:30:16", "text": "えっと、"}, {"type": "subtitle", "time": 9017.67, "timestamp": "02:30:17", "text": "復活できるまでのカウントダウンがあるべきだと思う。   ちくしょう"}, {"type": "subtitle", "time": 9019.91, "timestamp": "02:30:19", "text": "。"}, {"type": "subtitle", "time": 9021.27, "timestamp": "02:30:21", "text": "私も"}, {"type": "subtitle", "time": 9022.23, "timestamp": "02:30:22", "text": "戦利品を待たなければならない。"}, {"type": "subtitle", "time": 9023.349, "timestamp": "02:30:23", "text": "待っていないといけない。"}, {"type": "subtitle", "time": 9025.59, "timestamp": "02:30:25", "text": "ああ、私の体の上に人がいるから、"}, {"type": "subtitle", "time": 9028.55, "timestamp": "02:30:28", "text": "気をつけて。 つまり、私の体の中に入り込んで、"}, {"type": "subtitle", "time": 9030.95, "timestamp": "02:30:30", "text": "そこでキャンプして奴らを撃つこともできるってことだ。"}, {"type": "subtitle", "time": 9032.95, "timestamp": "02:30:32", "text": "待って、待たなきゃ。"}, {"type": "subtitle", "time": 9035.19, "timestamp": "02:30:35", "text": "近くのどこかで再起動させてあげられないかな？"}, {"type": "subtitle", "time": 9057.91, "timestamp": "02:30:57", "text": "早く助けて。 あなたは私の紫を奪った。"}, {"type": "subtitle", "time": 9058.71, "timestamp": "02:30:58", "text": "うん。"}]
[{"type": "subtitle", "time": 9858.16, "timestamp": "02:44:18", "text": "。 何？  [咳]"}, {"type": "subtitle", "time": 9859.76, "timestamp": "02:44:19", "text": "何？  [咳] 何が起こったのですか？"}, {"type": "subtitle", "time": 9860.399, "timestamp": "02:44:20", "text": "何が起こったのですか？ 彼は治癒術を使ったのか？ クレイジー。"}, {"type": "subtitle", "time": 9863.12, "timestamp": "02:44:23", "text": "彼は治癒術を使ったのか？ クレイジー。 ここ。 これを捨ててください。"}, {"type": "subtitle", "time": 9877.83, "timestamp": "02:44:37", "text": "ジョック、何があったんだ？"}, {"type": "subtitle", "time": 9889.349, "timestamp": "02:44:49", "text": "ドローンを投げてあげるよ。"}, {"type": "subtitle", "time": 9891.11, "timestamp": "02:44:51", "text": "あのドローンは、治療のようなものに使われる。 そうすれば"}, {"type": "subtitle", "time": 9894.55, "timestamp": "02:44:54", "text": "あなたは癒されるでしょう。   注意してください"}]
[{"type": "subtitle", "time": 2047.909, "timestamp": "00:34:07", "text": "どうやって"}, {"type": "subtitle", "time": 2051.109, "timestamp": "00:34:11", "text": "司令官A1から地下室のコマンドモジュールを単一の実行で取得できるとわかるのですか"}, {"type": "subtitle", "time": 2052.79, "timestamp": "00:34:12", "text": "？"}, {"type": "subtitle", "time": 2055.75, "timestamp": "00:34:15", "text": "それが私の使命だ。 ええ、私たちはこの複合施設にいます"}, {"type": "subtitle", "time": 2060.23, "timestamp": "00:34:20", "text": "ので、ここでクエストを完了できますよ。"}, {"type": "subtitle", "time": 2062.95, "timestamp": "00:34:22", "text": "えっと、"}, {"type": "subtitle", "time": 2066.31, "timestamp": "00:34:26", "text": "どうして動けないの？"}, {"type": "subtitle", "time": 2068.389, "timestamp": "00:34:28", "text": "動けません。 何？"}, {"type": "subtitle", "time": 2075.51, "timestamp": "00:34:35", "text": "本当に？"}, {"type": "subtitle", "time": 2080.389, "timestamp": "00:34:40", "text": "うん、ピングが高すぎるね。"}, {"type": "subtitle", "time": 2082.23, "timestamp": "00:34:42", "text": "くそっ。"}, {"type": "subtitle", "time": 2085.27, "timestamp": "00:34:45", "text": "どこにいるの？ 私の配信も衰退しつつあります"}, {"type": "subtitle", "time": 2093.19, "timestamp": "00:34:53", "text": "今日は何が起こっているのですか？"}, {"type": "subtitle", "time": 2097.349, "timestamp": "00:34:57", "text": "マラソン、そんなに私のことが嫌いなの？"}, {"type": "subtitle", "time": 2098.55, "timestamp": "00:34:58", "text": "そんなに？"}]
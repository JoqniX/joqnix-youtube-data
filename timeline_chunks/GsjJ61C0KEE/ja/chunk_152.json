[{"type": "subtitle", "time": 9120.87, "timestamp": "02:32:00", "text": "。"}, {"type": "subtitle", "time": 9122.87, "timestamp": "02:32:02", "text": "ニース。 彼は1つノックした。"}, {"type": "subtitle", "time": 9130.23, "timestamp": "02:32:10", "text": "。 私は見えない"}, {"type": "subtitle", "time": 9143.99, "timestamp": "02:32:23", "text": "ああ、あれは紫色のいじめっ子だった。   ちくしょう"}, {"type": "subtitle", "time": 9146.95, "timestamp": "02:32:26", "text": "。 しかたがない。"}, {"type": "subtitle", "time": 9157.03, "timestamp": "02:32:37", "text": "くそ。   下がった"}, {"type": "subtitle", "time": 9159.59, "timestamp": "02:32:39", "text": "。 評判を高める。"}, {"type": "subtitle", "time": 9161.59, "timestamp": "02:32:41", "text": "やれやれやれやれ。 なぜ彼らは"}, {"type": "subtitle", "time": 9164.15, "timestamp": "02:32:44", "text": "紫色の銃と緑色の盾を持ってくるのだろうか？"}, {"type": "subtitle", "time": 9168.785, "timestamp": "02:32:48", "text": "それは全く意味が分からない。  M"}, {"type": "subtitle", "time": 9169.59, "timestamp": "02:32:49", "text": "[咳]"}, {"type": "subtitle", "time": 9173.51, "timestamp": "02:32:53", "text": "このサーバーの人たちはあまり"}, {"type": "subtitle", "time": 9175.83, "timestamp": "02:32:55", "text": "汗をかいていないように感じます。なぜなら、"}, {"type": "subtitle", "time": 9177.83, "timestamp": "02:32:57", "text": "自分の場所で自分の人とプレイすると、みんなすごく"}, {"type": "subtitle", "time": 9179.429, "timestamp": "02:32:59", "text": "汗をかいていて、"}]
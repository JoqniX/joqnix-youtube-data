[{"type": "subtitle", "time": 8284.07, "timestamp": "02:18:04", "text": "さあ、さあ、さあ。"}, {"type": "subtitle", "time": 8296.23, "timestamp": "02:18:16", "text": "番組ですか？ 彼は私たちに腹を立てていた。 クソみたいなことすらできない。"}, {"type": "subtitle", "time": 8299.03, "timestamp": "02:18:19", "text": "彼はまるで左右に1V3を放っているようなものだ。"}, {"type": "subtitle", "time": 8307.83, "timestamp": "02:18:27", "text": "ええ、たくさん戦利品を手に入れました。"}, {"type": "subtitle", "time": 8309.429, "timestamp": "02:18:29", "text": "ああ、私を見て"}, {"type": "subtitle", "time": 8310.87, "timestamp": "02:18:30", "text": "。"}, {"type": "subtitle", "time": 8313.75, "timestamp": "02:18:33", "text": "彼はプレイステーションで遊んでいた。 くそ。   ちくしょう"}, {"type": "subtitle", "time": 8315.83, "timestamp": "02:18:35", "text": "。"}, {"type": "subtitle", "time": 8318.23, "timestamp": "02:18:38", "text": "クレイジー。"}, {"type": "subtitle", "time": 8321.19, "timestamp": "02:18:41", "text": "彼はレベル11です。ああ、彼は始めたところです。 彼は"}, {"type": "subtitle", "time": 8324.95, "timestamp": "02:18:44", "text": "先発メンバーだ。 新規プレイヤー。"}, {"type": "subtitle", "time": 8327.669, "timestamp": "02:18:47", "text": "ああ、リセットされるんだよ。 覚えて？"}, {"type": "subtitle", "time": 8330.15, "timestamp": "02:18:50", "text": "ああ、新しい季節が始まった。 だからおそらく、"}, {"type": "subtitle", "time": 8333.669, "timestamp": "02:18:53", "text": "シーズン1からのベテランなんだろう。"}, {"type": "subtitle", "time": 8336.23, "timestamp": "02:18:56", "text": "おそらく1万ドルくらいあるだろう。"}, {"type": "subtitle", "time": 8338.389, "timestamp": "02:18:58", "text": "あなたは7kです。"}]
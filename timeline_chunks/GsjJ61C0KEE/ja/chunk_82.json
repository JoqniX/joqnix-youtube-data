[{"type": "subtitle", "time": 4920.07, "timestamp": "01:22:00", "text": "どこにいるの？ ここに来て。"}, {"type": "subtitle", "time": 4921.35, "timestamp": "01:22:01", "text": "ええ、まずは地図に慣れるのに少し時間がかかりますね"}, {"type": "subtitle", "time": 4924.55, "timestamp": "01:22:04", "text": "。"}, {"type": "subtitle", "time": 4927.03, "timestamp": "01:22:07", "text": "ですから、まずは、緑色のAIのようなもの、つまり"}, {"type": "subtitle", "time": 4930.629, "timestamp": "01:22:10", "text": "サイバーアクネの契約を"}, {"type": "subtitle", "time": 4934.229, "timestamp": "01:22:14", "text": "最初に行うことをお勧めします。"}, {"type": "subtitle", "time": 4936.629, "timestamp": "01:22:16", "text": "ええと、最初のやつです。 わかった。"}, {"type": "subtitle", "time": 4938.39, "timestamp": "01:22:18", "text": "うん、最初のやつ。"}, {"type": "subtitle", "time": 4941.189, "timestamp": "01:22:21", "text": "初心者向けのフレンドリーなやつが好きだからね。 そして、まずは"}, {"type": "subtitle", "time": 4943.11, "timestamp": "01:22:23", "text": "初心者マップでプレイできます。"}, {"type": "subtitle", "time": 4945.669, "timestamp": "01:22:25", "text": "これはパラメーターです。"}, {"type": "subtitle", "time": 4950.07, "timestamp": "01:22:30", "text": "つまり、そうでないと、"}, {"type": "subtitle", "time": 4952.95, "timestamp": "01:22:32", "text": "ゲームを理解するのがもう少し簡単になるということです。 そう、"}, {"type": "subtitle", "time": 4955.99, "timestamp": "01:22:35", "text": "このマップは"}, {"type": "subtitle", "time": 4958.39, "timestamp": "01:22:38", "text": "ベテラン向けというよりは、"}, {"type": "subtitle", "time": 4961.51, "timestamp": "01:22:41", "text": "ゲームのコツを掴んだ人が"}, {"type": "subtitle", "time": 4963.27, "timestamp": "01:22:43", "text": "プレイし始めるマップみたいな感じなんだ。   何てことだ"}, {"type": "subtitle", "time": 4964.07, "timestamp": "01:22:44", "text": "。"}, {"type": "subtitle", "time": 4970.87, "timestamp": "01:22:50", "text": "イエス。"}, {"type": "subtitle", "time": 4971.669, "timestamp": "01:22:51", "text": "くそっ。   今の"}, {"type": "subtitle", "time": 4973.75, "timestamp": "01:22:53", "text": "見た？"}, {"type": "subtitle", "time": 4977.83, "timestamp": "01:22:57", "text": "彼はどこからともなく現れた。"}]
[{"type": "subtitle", "time": 11880.95, "timestamp": "03:18:00", "text": "無料の装備からスタートしなければならないということです。"}, {"type": "subtitle", "time": 11881.429, "timestamp": "03:18:01", "text": "ああ、ほら、"}, {"type": "subtitle", "time": 11883.75, "timestamp": "03:18:03", "text": "他の人はもう"}, {"type": "subtitle", "time": 11885.349, "timestamp": "03:18:05", "text": "緑のシールドとか青のシールドを持ってるでしょ"}, {"type": "subtitle", "time": 11885.99, "timestamp": "03:18:05", "text": "？"}, {"type": "subtitle", "time": 11888.15, "timestamp": "03:18:08", "text": "うん。 しかし、このモードでは、"}, {"type": "subtitle", "time": 11889.91, "timestamp": "03:18:09", "text": "全員がフリー"}, {"type": "subtitle", "time": 11891.91, "timestamp": "03:18:11", "text": "ロードアウトから始めなければなりません。 だから、みんな同じ"}, {"type": "subtitle", "time": 11892.95, "timestamp": "03:18:12", "text": "レベルにいるような感じなんです。"}, {"type": "subtitle", "time": 11894.15, "timestamp": "03:18:14", "text": "そう、だから"}, {"type": "subtitle", "time": 11897.03, "timestamp": "03:18:17", "text": "バトルロワイヤルみたいなものだって言ったんだよ。"}, {"type": "subtitle", "time": 11899.75, "timestamp": "03:18:19", "text": "同じレベルから始めれば、"}, {"type": "subtitle", "time": 11921.429, "timestamp": "03:18:41", "text": "ミンマン"}, {"type": "subtitle", "time": 11938.95, "timestamp": "03:18:58", "text": "ああ、静かな夜の沼地よ。   わかった"}]
[{"type": "subtitle", "time": 13440.229, "timestamp": "03:44:00", "text": "うん、買うべきじゃないな。 ええ、というのも、"}, {"type": "subtitle", "time": 13442.15, "timestamp": "03:44:02", "text": "私はあまり優れた"}, {"type": "subtitle", "time": 13445.11, "timestamp": "03:44:05", "text": "財務管理能力を持っていないからです。   全く同じです"}, {"type": "subtitle", "time": 13448.15, "timestamp": "03:44:08", "text": "。 私のお金はめちゃくちゃだ。"}, {"type": "subtitle", "time": 13452.229, "timestamp": "03:44:12", "text": "私も。 失敗。   まあ"}, {"type": "subtitle", "time": 13456.79, "timestamp": "03:44:16", "text": "、これで終わりにしてもいいかな。"}, {"type": "subtitle", "time": 13459.67, "timestamp": "03:44:19", "text": "みんな、あれは君たちのルームメイト？"}, {"type": "subtitle", "time": 13466.87, "timestamp": "03:44:26", "text": "とても良い。 よし。"}, {"type": "subtitle", "time": 13469.11, "timestamp": "03:44:29", "text": "さようなら、チャット。 皆さん、さようなら。"}, {"type": "subtitle", "time": 13470.07, "timestamp": "03:44:30", "text": "本日は"}, {"type": "subtitle", "time": 13475.99, "timestamp": "03:44:35", "text": "ありがとう。 連絡してね。 ケーブルテレビに加入していれば、それでも"}, {"type": "subtitle", "time": 13481.51, "timestamp": "03:44:41", "text": "ゲームを楽しみたいですよね。   よし"}, {"type": "subtitle", "time": 13482.95, "timestamp": "03:44:42", "text": "。 またね。"}, {"type": "subtitle", "time": 13486.469, "timestamp": "03:44:46", "text": "こんにちは。 どうしたの？ バイバイ。"}]
[{"type": "subtitle", "time": 9720.79, "timestamp": "02:42:00", "text": "おお。"}, {"type": "subtitle", "time": 9721.83, "timestamp": "02:42:01", "text": "青い血が流れている。"}, {"type": "subtitle", "time": 9725.27, "timestamp": "02:42:05", "text": "よし、じゃあまずはもう一人の方から話そう"}, {"type": "subtitle", "time": 9727.91, "timestamp": "02:42:07", "text": "。 今は白くなっている。"}, {"type": "subtitle", "time": 9730.87, "timestamp": "02:42:10", "text": "白い血が流れている。 ブルーは失敗した。   一体"}, {"type": "subtitle", "time": 9740.15, "timestamp": "02:42:20", "text": "ああ、君は死んでしまったんだね。   落ち着いてください"}, {"type": "subtitle", "time": 9741.03, "timestamp": "02:42:21", "text": "、皆さん。 落ち着け。"}, {"type": "subtitle", "time": 9744.309, "timestamp": "02:42:24", "text": "新しいアップデートがリリースされたという事実。   あの"}, {"type": "subtitle", "time": 9745.59, "timestamp": "02:42:25", "text": "ロボットは、お前が"}, {"type": "subtitle", "time": 9748.07, "timestamp": "02:42:28", "text": "死んだら、"}, {"type": "subtitle", "time": 9763.19, "timestamp": "02:42:43", "text": "注意深い。 後ろに気を付けて。   ここに"}, {"type": "subtitle", "time": 9764.389, "timestamp": "02:42:44", "text": "来て。 私と来て。 私と来て。   ああ、なんてことだ"}, {"type": "subtitle", "time": 9767.75, "timestamp": "02:42:47", "text": "。   ここに"}, {"type": "subtitle", "time": 9769.11, "timestamp": "02:42:49", "text": "来て。 這って、這って。 ここに来て。"}, {"type": "subtitle", "time": 9777.59, "timestamp": "02:42:57", "text": "行く。"}]
[{"type": "subtitle", "time": 5580.07, "timestamp": "01:33:00", "text": "マップ上の位置が変わることもあるんです。"}, {"type": "subtitle", "time": 5580.95, "timestamp": "01:33:00", "text": "私は何を感じているのだろうか？"}, {"type": "subtitle", "time": 5582.31, "timestamp": "01:33:02", "text": "この場合、私の"}, {"type": "subtitle", "time": 5583.669, "timestamp": "01:33:03", "text": "人生は最悪だ。"}, {"type": "subtitle", "time": 5584.07, "timestamp": "01:33:04", "text": "うん。"}, {"type": "subtitle", "time": 5585.27, "timestamp": "01:33:05", "text": "おお。"}, {"type": "subtitle", "time": 5595.35, "timestamp": "01:33:15", "text": "、あれは地雷だったんだ。"}, {"type": "subtitle", "time": 5599.51, "timestamp": "01:33:19", "text": "ああ、そこは鉱山だったんだ。 何てことだ。"}, {"type": "subtitle", "time": 5603.03, "timestamp": "01:33:23", "text": "ええ、クエストによっては"}, {"type": "subtitle", "time": 5604.79, "timestamp": "01:33:24", "text": "マップの位置が少し変わったり、"}, {"type": "subtitle", "time": 5606.55, "timestamp": "01:33:26", "text": "地雷や"}, {"type": "subtitle", "time": 5612.87, "timestamp": "01:33:32", "text": "それはおかしい。"}, {"type": "subtitle", "time": 5615.27, "timestamp": "01:33:35", "text": "よし、"}, {"type": "subtitle", "time": 5618.31, "timestamp": "01:33:38", "text": "ロボットは吸い込む。"}]
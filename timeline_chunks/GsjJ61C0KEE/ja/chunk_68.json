[{"type": "subtitle", "time": 4086.309, "timestamp": "01:08:06", "text": "行動を起こす時だ。"}, {"type": "subtitle", "time": 4088.309, "timestamp": "01:08:08", "text": "この野郎。   よし、これでいい"}, {"type": "subtitle", "time": 4091.349, "timestamp": "01:08:11", "text": "。"}, {"type": "subtitle", "time": 4092.39, "timestamp": "01:08:12", "text": "ここはどこ？   わからない"}, {"type": "subtitle", "time": 4095.75, "timestamp": "01:08:15", "text": "。 わかった。"}, {"type": "subtitle", "time": 4099.43, "timestamp": "01:08:19", "text": "おお。 あの、あれ見えますか？ ええと、わかりました"}, {"type": "subtitle", "time": 4101.91, "timestamp": "01:08:21", "text": "。 地図を開いてください。 分かりますか？ ああ、それは"}, {"type": "subtitle", "time": 4103.51, "timestamp": "01:08:23", "text": "できません。 くそ。"}, {"type": "subtitle", "time": 4104.55, "timestamp": "01:08:24", "text": "待って。 何？"}, {"type": "subtitle", "time": 4106.709, "timestamp": "01:08:26", "text": "どこにいるの？ あそこにあるもの、見えるかい"}, {"type": "subtitle", "time": 4121.189, "timestamp": "01:08:41", "text": "。 これ、見えますか？ あの、ブーブーって音を"}, {"type": "subtitle", "time": 4124.87, "timestamp": "01:08:44", "text": "立ててるやつ？   あれ"}, {"type": "subtitle", "time": 4126.39, "timestamp": "01:08:46", "text": "？ だから、私たちは"}, {"type": "subtitle", "time": 4128.789, "timestamp": "01:08:48", "text": "それらに登ることができる。   いや"}, {"type": "subtitle", "time": 4131.11, "timestamp": "01:08:51", "text": "、違うよ。 もう済んでいます。 でも、えっと、もう"}, {"type": "subtitle", "time": 4133.11, "timestamp": "01:08:53", "text": "一人の男はロボットからもらったゴールデンカードみたいなものを使ったんだ"}, {"type": "subtitle", "time": 4135.59, "timestamp": "01:08:55", "text": "。"}, {"type": "subtitle", "time": 4138.07, "timestamp": "01:08:58", "text": "うん。 そしてそれを使って、あちらへ続く留め金を開けるのです"}]
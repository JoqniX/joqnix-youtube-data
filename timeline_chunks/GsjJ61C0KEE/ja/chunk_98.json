[{"type": "subtitle", "time": 5885.99, "timestamp": "01:38:05", "text": "ええ、あまりアクションはなかったですよ。"}, {"type": "subtitle", "time": 5888.07, "timestamp": "01:38:08", "text": "ただあちこち回って"}, {"type": "subtitle", "time": 5891.43, "timestamp": "01:38:11", "text": "略奪して、それから女"}, {"type": "subtitle", "time": 5905.669, "timestamp": "01:38:25", "text": "ああ、選択肢は2つありますよ。 ジョック。"}, {"type": "subtitle", "time": 5907.99, "timestamp": "01:38:27", "text": "やあ、君。  1人は2人を待つ。"}, {"type": "subtitle", "time": 5909.35, "timestamp": "01:38:29", "text": "こんにちは。 コマンドを強制終了することはできますか？"}, {"type": "subtitle", "time": 5911.43, "timestamp": "01:38:31", "text": "1つ目は、"}, {"type": "subtitle", "time": 5916.47, "timestamp": "01:38:36", "text": "携帯電話が完成したということです。"}, {"type": "subtitle", "time": 5918.79, "timestamp": "01:38:38", "text": "一つ目は、２ヶ月待っていただければ、"}, {"type": "subtitle", "time": 5921.03, "timestamp": "01:38:41", "text": "Steamファミリーに追加できます。"}, {"type": "subtitle", "time": 5923.189, "timestamp": "01:38:43", "text": "二。 今、私が追加されました。"}, {"type": "subtitle", "time": 5932.79, "timestamp": "01:38:52", "text": "Steamウォレットにお金を追加した場合、"}, {"type": "subtitle", "time": 5937.03, "timestamp": "01:38:57", "text": "Ianに交換できますか？"}, {"type": "subtitle", "time": 5937.91, "timestamp": "01:38:57", "text": "はい、日本人です。"}, {"type": "subtitle", "time": 5939.669, "timestamp": "01:38:59", "text": "はい、可能だと思います。"}]
[{"type": "subtitle", "time": 1020.79, "timestamp": "00:17:00", "text": "チームを組まないと、見知らぬ"}, {"type": "subtitle", "time": 1022.79, "timestamp": "00:17:02", "text": "人たちと一緒にいるのはとても"}, {"type": "subtitle", "time": 1024.23, "timestamp": "00:17:04", "text": "難しい。"}, {"type": "subtitle", "time": 1025.75, "timestamp": "00:17:05", "text": "見知らぬ人と遊ぶように戦うのは"}, {"type": "subtitle", "time": 1027.829, "timestamp": "00:17:07", "text": "とても難しい。"}, {"type": "subtitle", "time": 1030.23, "timestamp": "00:17:10", "text": "技術的にはソロプレイも可能です。"}, {"type": "subtitle", "time": 1033.11, "timestamp": "00:17:13", "text": "ソロでプレイしましたか、それとも"}, {"type": "subtitle", "time": 1036.39, "timestamp": "00:17:16", "text": "ソロでプレイしましたか？ うん。"}, {"type": "subtitle", "time": 1038.71, "timestamp": "00:17:18", "text": "うん。 私はソロ活動はあまり好きではありません。 だから、私は"}, {"type": "subtitle", "time": 1041.189, "timestamp": "00:17:21", "text": "ほとんどの場合トリオで演奏しています。"}, {"type": "subtitle", "time": 1042.949, "timestamp": "00:17:22", "text": "時には素晴らしいこともあるし、"}, {"type": "subtitle", "time": 1046.47, "timestamp": "00:17:26", "text": "本当に上手なプレイヤーに出会うこともあるけれど、ほとんどの場合はただの"}, {"type": "subtitle", "time": 1048.87, "timestamp": "00:17:28", "text": "人との出会いだ。 最悪って感じだね"}, {"type": "subtitle", "time": 1050.87, "timestamp": "00:17:30", "text": "。"}, {"type": "subtitle", "time": 1053.83, "timestamp": "00:17:33", "text": "うん。"}, {"type": "subtitle", "time": 1062.789, "timestamp": "00:17:42", "text": "なぜこの状態のまま動かないのですか？"}]
[{"type": "subtitle", "time": 3600.47, "timestamp": "01:00:00", "text": "。"}, {"type": "subtitle", "time": 3605.109, "timestamp": "01:00:05", "text": "750円で500マラソンラックス、1,500円"}, {"type": "subtitle", "time": 3606.95, "timestamp": "01:00:06", "text": "で0,000。   わかった"}, {"type": "subtitle", "time": 3611.99, "timestamp": "01:00:11", "text": "。  3,000を2,000で。  5,250ドルが3,500ドルに。   ああ"}, {"type": "subtitle", "time": 3621.19, "timestamp": "01:00:21", "text": "よし、行こう。"}, {"type": "subtitle", "time": 3623.349, "timestamp": "01:00:23", "text": "ああ、ちなみに、"}, {"type": "subtitle", "time": 3627.27, "timestamp": "01:00:27", "text": "トリオもあるよ。 だから、"}, {"type": "subtitle", "time": 3629.109, "timestamp": "01:00:29", "text": "ちょっと変わった人たちとチームを組まなければならないかもしれない"}, {"type": "chat", "time": 3632.45, "timestamp": "01:00:32", "author": "@Ghewar_Ji_ka_No-1FAN", "avatar": "https://yt4.ggpht.com/CqrtcQvHFvr33XJk7uI96qZ5HyIAEb1ifU1jdPzM7vetPMlUZ4oYhF9BjVOj5xYYbkMi18Zfvg=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/HvgfY93GEYmqvwLUuYDwAQUCkszU2WH9gy1mb0dV-11UJg/HvgfY93GEYmqvwLUuYDwAQ"}, {"type": "subtitle", "time": 3642.39, "timestamp": "01:00:42", "text": "始まり。"}, {"type": "subtitle", "time": 3647.109, "timestamp": "01:00:47", "text": "最初のシーズンでは肌の見た目が"}, {"type": "subtitle", "time": 3649.67, "timestamp": "01:00:49", "text": "ひどいと多くの反発があったが、今は"}, {"type": "subtitle", "time": 3652.47, "timestamp": "01:00:52", "text": "肌の見た目にかなり力を入れているようだ。"}, {"type": "subtitle", "time": 3654.309, "timestamp": "01:00:54", "text": "今の彼女、ちょっとカッコよく見えるね。"}]
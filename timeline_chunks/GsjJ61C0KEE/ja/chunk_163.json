[{"type": "subtitle", "time": 9781.19, "timestamp": "02:43:01", "text": "狙撃手が撃っているから、車をゆっくり走らせろ。"}, {"type": "subtitle", "time": 9799.75, "timestamp": "02:43:19", "text": "紫色のボットがスポーンするんだけど、それはかなり"}, {"type": "subtitle", "time": 9800.63, "timestamp": "02:43:20", "text": "強力なやつなんだ。"}, {"type": "subtitle", "time": 9802.71, "timestamp": "02:43:22", "text": "ああ、どうすればいいの？"}, {"type": "subtitle", "time": 9807.349, "timestamp": "02:43:27", "text": "ああ、狙撃手か。 愚かな狙撃手。"}, {"type": "subtitle", "time": 9807.51, "timestamp": "02:43:27", "text": "ああ、"}, {"type": "subtitle", "time": 9810.469, "timestamp": "02:43:30", "text": "私は彼を蘇生させることができます。 私の究極の技は、"}, {"type": "subtitle", "time": 9814.71, "timestamp": "02:43:34", "text": "即座に人々を蘇生させる"}, {"type": "subtitle", "time": 9820.87, "timestamp": "02:43:40", "text": "増援部隊です。"}, {"type": "subtitle", "time": 9822.15, "timestamp": "02:43:42", "text": "厄介なことになりそうだ。"}, {"type": "subtitle", "time": 9824.55, "timestamp": "02:43:44", "text": "彼はあなたを撃つでしょうか？   あなたを"}, {"type": "subtitle", "time": 9826.79, "timestamp": "02:43:46", "text": "蘇らせる。"}, {"type": "subtitle", "time": 9828.79, "timestamp": "02:43:48", "text": "よし、"}, {"type": "subtitle", "time": 9838.389, "timestamp": "02:43:58", "text": "ああ、くそ。"}]
[{"type": "subtitle", "time": 5471.59, "timestamp": "01:31:11", "text": "下には何があるのか​​？ 何？"}, {"type": "subtitle", "time": 5473.03, "timestamp": "01:31:13", "text": "うん。 うん。"}, {"type": "subtitle", "time": 5485.59, "timestamp": "01:31:25", "text": "ああ、くそ。"}, {"type": "subtitle", "time": 5501.11, "timestamp": "01:31:41", "text": "これは一体何ですか？"}, {"type": "subtitle", "time": 5503.669, "timestamp": "01:31:43", "text": "それは、えっと、よくわからないんです。 何らかの"}, {"type": "subtitle", "time": 5507.11, "timestamp": "01:31:47", "text": "レーザー。 そこへ歩いて行ってみてください。"}, {"type": "subtitle", "time": 5509.99, "timestamp": "01:31:49", "text": "いや、いや、いや。 何が起こるか分かっている。"}, {"type": "subtitle", "time": 5510.629, "timestamp": "01:31:50", "text": "何をするか？"}, {"type": "subtitle", "time": 5513.99, "timestamp": "01:31:53", "text": "いいえ、そうしたらハッキングされるだけです。"}, {"type": "subtitle", "time": 5517.43, "timestamp": "01:31:57", "text": "ああ、わかった。 ちょっと「マジかよ」って撃ってみろよ"}]
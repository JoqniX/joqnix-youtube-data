[{"type": "subtitle", "time": 12661.429, "timestamp": "03:31:01", "text": "うん。 うん。 うん。 彼はもう一人の男を殺した"}, {"type": "subtitle", "time": 12663.59, "timestamp": "03:31:03", "text": "。 私の他のチームメイトたち。   なんてこった。   わかった"}, {"type": "subtitle", "time": 12670.63, "timestamp": "03:31:10", "text": "。 それを避けて通るようにしてください"}, {"type": "subtitle", "time": 12673.349, "timestamp": "03:31:13", "text": "。   まるで"}, {"type": "subtitle", "time": 12682.389, "timestamp": "03:31:22", "text": "危険な場所へ行く。"}, {"type": "subtitle", "time": 12687.91, "timestamp": "03:31:27", "text": "ええ、あれはただのボットが撃ったんです。"}, {"type": "subtitle", "time": 12699.03, "timestamp": "03:31:39", "text": "このゲームにはゾンビは登場しますか？"}, {"type": "subtitle", "time": 12701.91, "timestamp": "03:31:41", "text": "えっと、このゲームモードで？ ええ、この"}, {"type": "subtitle", "time": 12715.11, "timestamp": "03:31:55", "text": "ああ、なんてことだ、今、気味の悪い男を見た。"}]
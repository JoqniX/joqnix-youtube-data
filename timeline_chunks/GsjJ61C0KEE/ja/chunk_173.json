[{"type": "subtitle", "time": 10396.95, "timestamp": "02:53:16", "text": "はい、可能です。   そのすぐ隣を"}, {"type": "subtitle", "time": 10399.51, "timestamp": "02:53:19", "text": "警備せよ。"}, {"type": "subtitle", "time": 10406.309, "timestamp": "02:53:26", "text": "援軍が到着した。"}, {"type": "subtitle", "time": 10408.23, "timestamp": "02:53:28", "text": "うん、私も無視するつもりだよ。 つまり、"}, {"type": "subtitle", "time": 10409.99, "timestamp": "02:53:29", "text": "私はスナイパーライフルを持っているんです。 うん。 ああ、誰かが"}, {"type": "subtitle", "time": 10423.349, "timestamp": "02:53:43", "text": "ええと、北西、北西。"}, {"type": "subtitle", "time": 10425.269, "timestamp": "02:53:45", "text": "誰かがドローンか何かに襲われたらしい"}]
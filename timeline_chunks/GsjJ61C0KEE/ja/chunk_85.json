[{"type": "subtitle", "time": 5100.87, "timestamp": "01:25:00", "text": "移動しているような感覚ですか？"}, {"type": "subtitle", "time": 5103.51, "timestamp": "01:25:03", "text": "はい。"}, {"type": "subtitle", "time": 5106.31, "timestamp": "01:25:06", "text": "問題は、私が動けないことです。 私は"}, {"type": "subtitle", "time": 5109.35, "timestamp": "01:25:09", "text": "凍りついた状態になり、しばらくすると"}, {"type": "subtitle", "time": 5109.669, "timestamp": "01:25:09", "text": "テレポートするでしょう。"}, {"type": "subtitle", "time": 5111.43, "timestamp": "01:25:11", "text": "まるでクレーターみたいだ。 うん。 うん。 右。"}, {"type": "subtitle", "time": 5118.31, "timestamp": "01:25:18", "text": "おお。 えっと、"}, {"type": "subtitle", "time": 5121.59, "timestamp": "01:25:21", "text": "これって大きな壁か何かですか？"}, {"type": "subtitle", "time": 5122.95, "timestamp": "01:25:22", "text": "うん。 うん。 うん。 うん。 そこを通り過ぎることはできない"}, {"type": "subtitle", "time": 5126.149, "timestamp": "01:25:26", "text": "。 ここまで歩いて行かなければならない。"}, {"type": "subtitle", "time": 5129.27, "timestamp": "01:25:29", "text": "こっちへ来いよ、スポーツマン。   すぐに"}, {"type": "subtitle", "time": 5131.189, "timestamp": "01:25:31", "text": "あなたの荷物を取りに行きます。"}, {"type": "subtitle", "time": 5136.229, "timestamp": "01:25:36", "text": "略奪しなきゃ。 くそ。 死ぬかもしれない。"}, {"type": "subtitle", "time": 5154.39, "timestamp": "01:25:54", "text": "私の探求の道はあの家にあると思う"}, {"type": "subtitle", "time": 5156.149, "timestamp": "01:25:56", "text": "。"}]
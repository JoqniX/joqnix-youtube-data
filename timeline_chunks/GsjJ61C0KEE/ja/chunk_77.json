[{"type": "subtitle", "time": 4639.51, "timestamp": "01:17:19", "text": "ええ、こちらに来ていただいても構いませんよ。 ここには"}, {"type": "subtitle", "time": 4645.75, "timestamp": "01:17:25", "text": "もちろん。"}, {"type": "subtitle", "time": 4648.149, "timestamp": "01:17:28", "text": "注意深い。"}, {"type": "subtitle", "time": 4651.99, "timestamp": "01:17:31", "text": "ええ、このゲームには落下ダメージがありますよ。"}, {"type": "subtitle", "time": 4653.51, "timestamp": "01:17:33", "text": "知っている。 私はここにもここにもいない"}, {"type": "subtitle", "time": 4665.43, "timestamp": "01:17:45", "text": "次回は君をゲーム"}, {"type": "subtitle", "time": 4667.189, "timestamp": "01:17:47", "text": "リーダーにするよ。"}, {"type": "subtitle", "time": 4673.59, "timestamp": "01:17:53", "text": "Wi-Fiの方があなたにとって快適かどうか試してみてください。"}, {"type": "subtitle", "time": 4675.43, "timestamp": "01:17:55", "text": "陸上ケーブルを買うべきだと思う"}, {"type": "subtitle", "time": 4679.83, "timestamp": "01:17:59", "text": "つまり、どこに"}]
[{"type": "subtitle", "time": 6541.51, "timestamp": "01:49:01", "text": "。 複合施設はここを通過できます。"}, {"type": "subtitle", "time": 6543.35, "timestamp": "01:49:03", "text": "そこにチームのスポーン地点が設けられます。 だから、気をつけてください"}, {"type": "subtitle", "time": 6544.87, "timestamp": "01:49:04", "text": "。   あちらの"}, {"type": "subtitle", "time": 6548.629, "timestamp": "01:49:08", "text": "複合施設はどこにあるんですか？   わかった"}, {"type": "subtitle", "time": 6550.95, "timestamp": "01:49:10", "text": "。 待って。 私たちはアボランゴの近くにいるんですよね？"}, {"type": "subtitle", "time": 6552.55, "timestamp": "01:49:12", "text": "さあ、"}, {"type": "subtitle", "time": 6555.83, "timestamp": "01:49:15", "text": "何かを探しに行きましょう。"}, {"type": "subtitle", "time": 6557.27, "timestamp": "01:49:17", "text": "メンテナンス。 本気ですか？"}, {"type": "subtitle", "time": 6558.229, "timestamp": "01:49:18", "text": "うん。"}, {"type": "subtitle", "time": 6561.91, "timestamp": "01:49:21", "text": "ああ、クエストは受けてたよね？"}, {"type": "subtitle", "time": 6563.91, "timestamp": "01:49:23", "text": "ええ、そうですね。 それはメンテナンス"}, {"type": "subtitle", "time": 6566.39, "timestamp": "01:49:26", "text": "施設か生物研究施設のどちらかにある。 つまり、"}, {"type": "subtitle", "time": 6569.03, "timestamp": "01:49:29", "text": "選択肢は3つあります。   ああ"}, {"type": "subtitle", "time": 6572.629, "timestamp": "01:49:32", "text": "、わかった！"}, {"type": "subtitle", "time": 6575.43, "timestamp": "01:49:35", "text": "うん。 だから、ああ、しまった、あれは"}, {"type": "subtitle", "time": 6578.47, "timestamp": "01:49:38", "text": "私のものだ。 そう、とにかく撃つしかないんだ。"}, {"type": "subtitle", "time": 6580.55, "timestamp": "01:49:40", "text": "あなたは彼らを見た。 時々、ちょっとイライラする"}, {"type": "subtitle", "time": 6582.87, "timestamp": "01:49:42", "text": "。"}, {"type": "subtitle", "time": 6585.91, "timestamp": "01:49:45", "text": "また行き詰まってしまった。"}, {"type": "subtitle", "time": 6596.629, "timestamp": "01:49:56", "text": "Apex Legendsのパスファインダーのようにグラップルを使うことすらできない。 カメラを反対側に移動させて、"}]
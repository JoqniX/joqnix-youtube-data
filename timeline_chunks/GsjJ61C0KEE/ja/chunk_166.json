[{"type": "subtitle", "time": 9962.23, "timestamp": "02:46:02", "text": "くそ。 でも、あの戦利品を見に行きたい気もする"}, {"type": "subtitle", "time": 9965.11, "timestamp": "02:46:05", "text": "。 戦利品は魅力的だ。"}, {"type": "subtitle", "time": 9965.67, "timestamp": "02:46:05", "text": "どこ？"}, {"type": "subtitle", "time": 9969.11, "timestamp": "02:46:09", "text": "ああ、ジューシーじゃないね。 ジューシー。"}, {"type": "subtitle", "time": 9972.87, "timestamp": "02:46:12", "text": "小さな箱を開けるやつです。 うん。"}, {"type": "subtitle", "time": 9976.469, "timestamp": "02:46:16", "text": "柱はどこにありますか？"}, {"type": "subtitle", "time": 9977.11, "timestamp": "02:46:17", "text": "地図上で、オーはどこにあるのでしょうか。   あれを見てください"}, {"type": "subtitle", "time": 9977.59, "timestamp": "02:46:17", "text": "。"}, {"type": "subtitle", "time": 9978.63, "timestamp": "02:46:18", "text": "ああ、あそこだよ。"}, {"type": "subtitle", "time": 9979.429, "timestamp": "02:46:19", "text": "列。"}, {"type": "subtitle", "time": 9982.95, "timestamp": "02:46:22", "text": "そこへ行ってもいいですよ。"}, {"type": "subtitle", "time": 9984.79, "timestamp": "02:46:24", "text": "地図上の赤い印が見えますか？"}, {"type": "subtitle", "time": 9985.75, "timestamp": "02:46:25", "text": "赤い印。 ああ、"}, {"type": "subtitle", "time": 9988.71, "timestamp": "02:46:28", "text": "あれは刑務所長だ。 それはまるで黄金の"}, {"type": "subtitle", "time": 9996.389, "timestamp": "02:46:36", "text": "ええ、"}, {"type": "subtitle", "time": 10001.83, "timestamp": "02:46:41", "text": "灰色の"}, {"type": "subtitle", "time": 10007.51, "timestamp": "02:46:47", "text": "つまり、"}, {"type": "subtitle", "time": 10010.23, "timestamp": "02:46:50", "text": "予備の銃、例えば緑色の銃とか、"}, {"type": "subtitle", "time": 10011.51, "timestamp": "02:46:51", "text": "使いたい銃がいくつかあるのは良いことだ。 それはただ"}]
[{"type": "subtitle", "time": 1742.47, "timestamp": "00:29:02", "text": "ただ、発売されてから3回くらいしかプレイしていないんです"}, {"type": "subtitle", "time": 1745.51, "timestamp": "00:29:05", "text": "。  H."}, {"type": "subtitle", "time": 1747.669, "timestamp": "00:29:07", "text": "では、"}, {"type": "subtitle", "time": 1750.389, "timestamp": "00:29:10", "text": "まず初心者向けのものにするか、それとも"}, {"type": "subtitle", "time": 1752.31, "timestamp": "00:29:12", "text": "上級者向けのものにするか、どちらを選びますか？"}, {"type": "subtitle", "time": 1754.389, "timestamp": "00:29:14", "text": "まずは初心者向けに"}, {"type": "subtitle", "time": 1757.269, "timestamp": "00:29:17", "text": "ゲームを進めて、それから本格的な内容に進むこともできます。"}, {"type": "subtitle", "time": 1761.279, "timestamp": "00:29:21", "text": "。 うん、デュオならできるよ。 今すぐやってください。"}, {"type": "subtitle", "time": 1764.64, "timestamp": "00:29:24", "text": "うん、デュオならできるよ。 今すぐやってください。 はい。   もう中に入ってるよ"}, {"type": "subtitle", "time": 1771.99, "timestamp": "00:29:31", "text": "。 おお。"}, {"type": "subtitle", "time": 1783.269, "timestamp": "00:29:43", "text": "それはとても素晴らしいですね。"}, {"type": "subtitle", "time": 1786.63, "timestamp": "00:29:46", "text": "知っている。 ああ、このゲームが大好きだ。"}, {"type": "subtitle", "time": 1789.99, "timestamp": "00:29:49", "text": "このゲームがこんなにも"}]
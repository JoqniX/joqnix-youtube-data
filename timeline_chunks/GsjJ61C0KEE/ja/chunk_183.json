[{"type": "subtitle", "time": 10982.07, "timestamp": "03:03:02", "text": "夕方？ うん。"}, {"type": "subtitle", "time": 10988.71, "timestamp": "03:03:08", "text": "あなたは忙しくなると言っていましたよね。"}, {"type": "subtitle", "time": 10990.63, "timestamp": "03:03:10", "text": "忙しくなりそうです。   はい、そうしました"}, {"type": "subtitle", "time": 10993.11, "timestamp": "03:03:13", "text": "。"}, {"type": "subtitle", "time": 10995.269, "timestamp": "03:03:15", "text": "ああ、つまりあなたは私に嘘をついていたんですね？"}, {"type": "subtitle", "time": 10999.03, "timestamp": "03:03:19", "text": "え、私がやったの？ 待って。 いいえ。ええと、問題は"}, {"type": "subtitle", "time": 11003.11, "timestamp": "03:03:23", "text": "あなたが忘れたことです。 えっと、寮にいるのでまだ何も"}, {"type": "subtitle", "time": 11004.389, "timestamp": "03:03:24", "text": "食べていません。"}, {"type": "subtitle", "time": 11007.59, "timestamp": "03:03:27", "text": "プラス部屋では息子が寝ています。 彼は"}, {"type": "subtitle", "time": 11011.349, "timestamp": "03:03:31", "text": "休息が必要だ。 つまり、そういうこと全部です。 今日は特に何もないよ"}, {"type": "subtitle", "time": 11015.75, "timestamp": "03:03:35", "text": "。 まあ、自由になったってことかな。"}, {"type": "subtitle", "time": 11018.07, "timestamp": "03:03:38", "text": "待って。 そちらでは今何時ですか？ もう"}, {"type": "subtitle", "time": 11019.349, "timestamp": "03:03:39", "text": "遅い時間じゃないですか？   時刻は3時"}, {"type": "subtitle", "time": 11021.429, "timestamp": "03:03:41", "text": "19分です。   何てことだ"}, {"type": "subtitle", "time": 11021.91, "timestamp": "03:03:41", "text": "。   たくさん"}, {"type": "subtitle", "time": 11024.309, "timestamp": "03:03:44", "text": "寝たって言ったでしょ。 もうめちゃくちゃ寝たよ"}]
[{"type": "subtitle", "time": 11941.67, "timestamp": "03:19:01", "text": "。 ええ、あなたのサーバーにいますよ。"}, {"type": "subtitle", "time": 11965.349, "timestamp": "03:19:25", "text": "ちょっと待って、"}, {"type": "subtitle", "time": 11966.309, "timestamp": "03:19:26", "text": "ああ、くそ。   私はよく"}, {"type": "subtitle", "time": 11967.91, "timestamp": "03:19:27", "text": "忘れてしまう。 ポテト"}, {"type": "subtitle", "time": 11972.95, "timestamp": "03:19:32", "text": "チップスを食べる時は箸を使うべきだった。"}, {"type": "subtitle", "time": 11976.15, "timestamp": "03:19:36", "text": "あなたは箸の使い方がわからない。"}, {"type": "subtitle", "time": 11983.83, "timestamp": "03:19:43", "text": "あなたは日本語が好きで、できない。 あなたは"}, {"type": "subtitle", "time": 11985.972, "timestamp": "03:19:45", "text": "箸の使い方がわからない。"}, {"type": "subtitle", "time": 11992.389, "timestamp": "03:19:52", "text": "なんという偽ファンだ。   そうそう"}, {"type": "subtitle", "time": 11999.51, "timestamp": "03:19:59", "text": "私はただ冗談を言っているだけです。"}]
[{"type": "subtitle", "time": 6196.629, "timestamp": "01:43:16", "text": "階段に増援部隊が発見された。"}, {"type": "subtitle", "time": 6199.03, "timestamp": "01:43:19", "text": "バンバン。"}, {"type": "subtitle", "time": 6205.59, "timestamp": "01:43:25", "text": "。  ３人全員。 彼らは"}, {"type": "subtitle", "time": 6207.59, "timestamp": "01:43:27", "text": "一人の男を騙した。"}, {"type": "subtitle", "time": 6211.189, "timestamp": "01:43:31", "text": "私は彼らの姿すら見ていない。   ああ"}, {"type": "subtitle", "time": 6212.31, "timestamp": "01:43:32", "text": "、そうだった。"}, {"type": "subtitle", "time": 6213.109, "timestamp": "01:43:33", "text": "お、惜しかったね。   ちくしょう"}, {"type": "subtitle", "time": 6218.55, "timestamp": "01:43:38", "text": "焦ってはいけませんよ。 ああ、彼が"}, {"type": "subtitle", "time": 6219.669, "timestamp": "01:43:39", "text": "ここにいる。"}, {"type": "subtitle", "time": 6224.629, "timestamp": "01:43:44", "text": "こんにちは、ジョック。"}, {"type": "subtitle", "time": 6231.99, "timestamp": "01:43:51", "text": "こいつが俺たちを殺したんだ。"}, {"type": "subtitle", "time": 6236.08, "timestamp": "01:43:56", "text": "。 奇妙な。 初期設定に戻した方がいいかもしれません。"}, {"type": "subtitle", "time": 6239.76, "timestamp": "01:43:59", "text": "奇妙な。 初期設定に戻した方がいいかもしれません。 ああ、いいか"}]
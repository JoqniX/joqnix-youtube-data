[{"type": "subtitle", "time": 1803.83, "timestamp": "00:30:03", "text": "私のメモリはまるで16GBのRAMを搭載しているかのようだ。"}, {"type": "subtitle", "time": 1806.549, "timestamp": "00:30:06", "text": "はい、もう満席です。"}, {"type": "subtitle", "time": 1808.95, "timestamp": "00:30:08", "text": "残り容量はわずか1GBです。   何てことだ"}, {"type": "subtitle", "time": 1809.669, "timestamp": "00:30:09", "text": "。   わからないよ"}, {"type": "subtitle", "time": 1812.71, "timestamp": "00:30:12", "text": "、ジョシュ。"}, {"type": "subtitle", "time": 1814.389, "timestamp": "00:30:14", "text": "バックグラウンドで10個ものプログラムが動作している"}, {"type": "subtitle", "time": 1815.35, "timestamp": "00:30:15", "text": "。"}, {"type": "subtitle", "time": 1817.909, "timestamp": "00:30:17", "text": "いいえ、私はしません。"}, {"type": "subtitle", "time": 1820.389, "timestamp": "00:30:20", "text": "待って、そうするの？ ああ、そうだ。 エピックゲームズ。 これで終わりにします"}, {"type": "subtitle", "time": 1824.185, "timestamp": "00:30:24", "text": "。 えーと、"}, {"type": "subtitle", "time": 1827.43, "timestamp": "00:30:27", "text": "[鼻を鳴らす]"}, {"type": "subtitle", "time": 1829.11, "timestamp": "00:30:29", "text": "実は、"}, {"type": "subtitle", "time": 1831.75, "timestamp": "00:30:31", "text": "私はノートパソコンをまるで"}, {"type": "subtitle", "time": 1835.909, "timestamp": "00:30:35", "text": "自分のPCを使っているかのように使っているんです。 私はどのようにパソコンを使っていますか？"}, {"type": "subtitle", "time": 1836.789, "timestamp": "00:30:36", "text": "そんなことはするべきではない。"}, {"type": "subtitle", "time": 1839.11, "timestamp": "00:30:39", "text": "お使いのPCにはRAMが何台搭載されていますか？"}, {"type": "subtitle", "time": 1847.59, "timestamp": "00:30:47", "text": "。 ノートパソコンには、えーと、"}, {"type": "subtitle", "time": 1851.99, "timestamp": "00:30:51", "text": "地下ではなく、何て言うんだっけ、隠れてバックグラウンドで動いている"}, {"type": "subtitle", "time": 1853.909, "timestamp": "00:30:53", "text": "ソフトウェアがあるような気がする"}, {"type": "subtitle", "time": 1857.99, "timestamp": "00:30:57", "text": "。"}, {"type": "subtitle", "time": 1858.23, "timestamp": "00:30:58", "text": "うん。"}]
[{"type": "subtitle", "time": 11821.67, "timestamp": "03:17:01", "text": "ええ、もちろんです。   続けて。   さあ行こう"}, {"type": "subtitle", "time": 11849.59, "timestamp": "03:17:29", "text": "か、"}, {"type": "subtitle", "time": 11852.15, "timestamp": "03:17:32", "text": "スポンサーのサバイバルのものを試してみてください。 そういう意味では、"}, {"type": "subtitle", "time": 11855.19, "timestamp": "03:17:35", "text": "みんなある意味平等な"}, {"type": "subtitle", "time": 11855.83, "timestamp": "03:17:35", "text": "レベルにいると言えるでしょう。"}, {"type": "subtitle", "time": 11858.55, "timestamp": "03:17:38", "text": "生き残るにはどちらが良いか？"}, {"type": "subtitle", "time": 11860.389, "timestamp": "03:17:40", "text": "うん。 スポンサーの生存。"}, {"type": "subtitle", "time": 11860.87, "timestamp": "03:17:40", "text": "どこ？"}, {"type": "subtitle", "time": 11865.99, "timestamp": "03:17:45", "text": "D・マーシュにて。  D・マーシュにて。"}, {"type": "subtitle", "time": 11878.229, "timestamp": "03:17:58", "text": "うん。 つまり、基本的には全員が"}]
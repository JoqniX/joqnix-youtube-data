[{"type": "subtitle", "time": 7087.27, "timestamp": "01:58:07", "text": "ブロックされました。"}, {"type": "subtitle", "time": 7089.589, "timestamp": "01:58:09", "text": "待って。 戦線。 ブロッキング。"}, {"type": "subtitle", "time": 7093.43, "timestamp": "01:58:13", "text": "ブラウザでファイルの読み込みがブロックされました。"}, {"type": "subtitle", "time": 7095.189, "timestamp": "01:58:15", "text": "ファイルブロックは、"}, {"type": "subtitle", "time": 7098.229, "timestamp": "01:58:18", "text": "ゲームに問題を引き起こさない限り無視しても構いません。"}, {"type": "subtitle", "time": 7100.95, "timestamp": "01:58:20", "text": "おお。"}, {"type": "subtitle", "time": 7136.87, "timestamp": "01:58:56", "text": "ああ、そうだった。 そのメンテナンス。"}, {"type": "subtitle", "time": 7138.629, "timestamp": "01:58:58", "text": "ここであなたのクエストを遂行してください。"}]
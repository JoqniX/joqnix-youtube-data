[{"type": "subtitle", "time": 1440.07, "timestamp": "00:24:00", "text": "ああ、ソロね。 いや、違う。 一体どういうことだ？"}, {"type": "subtitle", "time": 1443.83, "timestamp": "00:24:03", "text": "プレイすらできない。 見て。"}, {"type": "subtitle", "time": 1452.796, "timestamp": "00:24:12", "text": "再びライブ配信されているかどうか確認しなければならない。"}, {"type": "subtitle", "time": 1454.39, "timestamp": "00:24:14", "text": "[笑い声]"}, {"type": "subtitle", "time": 1457.909, "timestamp": "00:24:17", "text": "ランブル、どこにいるんだ？   なんだって"}, {"type": "subtitle", "time": 1467.909, "timestamp": "00:24:27", "text": "はい、ライブ配信中です。"}, {"type": "subtitle", "time": 1477.19, "timestamp": "00:24:37", "text": "よし、私も参加しなくちゃね？ 接続を追加します"}, {"type": "subtitle", "time": 1479.43, "timestamp": "00:24:39", "text": "。 これは何ですか？"}, {"type": "subtitle", "time": 1481.83, "timestamp": "00:24:41", "text": "友達リクエスト。 ああ、わかりました。 招待する。 いいえ、私は"}, {"type": "subtitle", "time": 1484.892, "timestamp": "00:24:44", "text": "参加できません。"}, {"type": "subtitle", "time": 1487.269, "timestamp": "00:24:47", "text": "[ため息] えーと、友達リクエストで参加してください。 おお、"}, {"type": "subtitle", "time": 1489.59, "timestamp": "00:24:49", "text": "いいね。 わかった。"}, {"type": "subtitle", "time": 1491.75, "timestamp": "00:24:51", "text": "このゲームのサーバーとかはどうですか"}, {"type": "subtitle", "time": 1493.909, "timestamp": "00:24:53", "text": "？"}, {"type": "subtitle", "time": 1495.83, "timestamp": "00:24:55", "text": "えっと、実はどういう仕組みなのかよく分からないんです"}, {"type": "subtitle", "time": 1499.11, "timestamp": "00:24:59", "text": "。 では、"}]
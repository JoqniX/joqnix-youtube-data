[{"type": "subtitle", "time": 7981.189, "timestamp": "02:13:01", "text": "誰もチャットしてくれない。 なぜ私が"}, {"type": "subtitle", "time": 7994.069, "timestamp": "02:13:14", "text": "彼はチャットか何かを入力しているのだろうか？   なんてこった。 私の"}, {"type": "subtitle", "time": 7996.31, "timestamp": "02:13:16", "text": "友達の一人だと"}, {"type": "subtitle", "time": 8009.189, "timestamp": "02:13:29", "text": "ああ、それはあなただったんですね。 ああ、怖かったよ"}, {"type": "subtitle", "time": 8013.27, "timestamp": "02:13:33", "text": "。"}, {"type": "subtitle", "time": 8029.43, "timestamp": "02:13:49", "text": "ここには青い銃も入っています。"}, {"type": "subtitle", "time": 8032.39, "timestamp": "02:13:52", "text": "シールド、バックパック、"}, {"type": "subtitle", "time": 8035.83, "timestamp": "02:13:55", "text": "ボディアーマーなど。 全身"}, {"type": "subtitle", "time": 8039.109, "timestamp": "02:13:59", "text": "スーツ。 装甲服。 ここに狙撃手がいる"}]
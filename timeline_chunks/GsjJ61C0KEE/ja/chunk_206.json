[{"type": "subtitle", "time": 12374.389, "timestamp": "03:26:14", "text": "それで、それは一体何をもたらしたんだっけ？"}, {"type": "subtitle", "time": 12376.309, "timestamp": "03:26:16", "text": "ええと、地図上にその場所を描きます"}, {"type": "subtitle", "time": 12378.63, "timestamp": "03:26:18", "text": "。 見えますか？"}, {"type": "subtitle", "time": 12379.349, "timestamp": "03:26:19", "text": "ああ、"}, {"type": "subtitle", "time": 12381.91, "timestamp": "03:26:21", "text": "そこなら私たちが来られる場所ですね。"}, {"type": "subtitle", "time": 12411.75, "timestamp": "03:26:51", "text": "君には10分ある。"}]
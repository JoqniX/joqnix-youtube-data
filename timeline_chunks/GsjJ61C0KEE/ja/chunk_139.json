[{"type": "subtitle", "time": 8342.07, "timestamp": "02:19:02", "text": "私は"}, {"type": "subtitle", "time": 8352.15, "timestamp": "02:19:12", "text": "バッグをもらったので嬉しいです。   たくさんの"}, {"type": "subtitle", "time": 8354.389, "timestamp": "02:19:14", "text": "物。"}, {"type": "subtitle", "time": 8359.11, "timestamp": "02:19:19", "text": "青い銃を2丁手に入れた。 斉射狙撃手。   もう"}, {"type": "subtitle", "time": 8361.349, "timestamp": "02:19:21", "text": "十分だ。"}, {"type": "subtitle", "time": 8364.309, "timestamp": "02:19:24", "text": "おばあさんです。"}, {"type": "subtitle", "time": 8366.95, "timestamp": "02:19:26", "text": "ああ、私たちはずっと一緒にいるよ。   それでも"}, {"type": "subtitle", "time": 8368.23, "timestamp": "02:19:28", "text": "この男と遊ぶつもりだ。 この"}, {"type": "subtitle", "time": 8370.87, "timestamp": "02:19:30", "text": "男はプロのようだった。"}, {"type": "subtitle", "time": 8372.469, "timestamp": "02:19:32", "text": "待って、彼は招待したんだ。   いや"}, {"type": "subtitle", "time": 8376.549, "timestamp": "02:19:36", "text": "、試合後には、"}, {"type": "subtitle", "time": 8379.03, "timestamp": "02:19:39", "text": "自動的に"}, {"type": "subtitle", "time": 8382.15, "timestamp": "02:19:42", "text": "クルー招待のようなものがあるんです"}, {"type": "subtitle", "time": 8385.75, "timestamp": "02:19:45", "text": "。 だから、試合が終わった後、"}, {"type": "subtitle", "time": 8387.27, "timestamp": "02:19:47", "text": "どういう仕組みかはよくわからないけど、試合が終わった後に"}, {"type": "subtitle", "time": 8389.27, "timestamp": "02:19:49", "text": "自動的に"}, {"type": "subtitle", "time": 8391.83, "timestamp": "02:19:51", "text": "チームが編成されるんだ。   ええ、そうですね"}, {"type": "subtitle", "time": 8393.27, "timestamp": "02:19:53", "text": "。"}, {"type": "subtitle", "time": 8393.75, "timestamp": "02:19:53", "text": "おお。"}, {"type": "subtitle", "time": 8397.27, "timestamp": "02:19:57", "text": "うん。"}, {"type": "subtitle", "time": 8398.79, "timestamp": "02:19:58", "text": "同じ人物の場合、どういう仕組みになっているのか、私にはよく分かりません。 うん。 私たちがそれで"}]
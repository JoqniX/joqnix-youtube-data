[{"type": "subtitle", "time": 5942.79, "timestamp": "01:39:02", "text": "ああ、わかりました。 そして、もしかしたらお金を出すかもしれないので、"}, {"type": "subtitle", "time": 5945.51, "timestamp": "01:39:05", "text": "あなたはゲーム、"}, {"type": "subtitle", "time": 5946.79, "timestamp": "01:39:06", "text": "ランニングゲームなどを購入できるでしょう。"}, {"type": "subtitle", "time": 5948.79, "timestamp": "01:39:08", "text": "大丈夫です。"}, {"type": "subtitle", "time": 5951.75, "timestamp": "01:39:11", "text": "私の口座を経由する必要はありません。 おい、"}, {"type": "subtitle", "time": 5954.149, "timestamp": "01:39:14", "text": "マラソンをプレイしたいか？ ええ、そうなんです。"}, {"type": "subtitle", "time": 5956.229, "timestamp": "01:39:16", "text": "でも、ゲームをやり込みすぎるのは嫌なんです"}, {"type": "subtitle", "time": 5961.27, "timestamp": "01:39:21", "text": "大丈夫です。"}, {"type": "subtitle", "time": 5961.99, "timestamp": "01:39:21", "text": "毎週プレイしている"}, {"type": "subtitle", "time": 5964.55, "timestamp": "01:39:24", "text": "時は、このゲームをやり込んでいます。"}, {"type": "subtitle", "time": 5966.87, "timestamp": "01:39:26", "text": "うん、毎週プレイするのはいいよ。 土曜日と、"}, {"type": "subtitle", "time": 5969.83, "timestamp": "01:39:29", "text": "日曜日は少しの間。 うん。"}, {"type": "subtitle", "time": 5973.03, "timestamp": "01:39:33", "text": "うん。 週末とか。"}, {"type": "subtitle", "time": 5975.109, "timestamp": "01:39:35", "text": "週末にプレイすればいいんです。 ジョー、私、"}, {"type": "subtitle", "time": 5990.39, "timestamp": "01:39:50", "text": "このクレジットは"}, {"type": "subtitle", "time": 5992.149, "timestamp": "01:39:52", "text": "標準的と言えるのでしょうか？ つまり、私は"}, {"type": "subtitle", "time": 5994.95, "timestamp": "01:39:54", "text": "回収品を受け取るべきなんですよね？   ええ"}, {"type": "subtitle", "time": 5997.75, "timestamp": "01:39:57", "text": "、場合によりますね。 でも、まあ、ほとんどの場合は"}]
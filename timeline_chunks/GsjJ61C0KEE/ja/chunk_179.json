[{"type": "subtitle", "time": 10741.03, "timestamp": "02:59:01", "text": "4チーム制にするべきだ。 パラメーターに基づいてマップ上に4つのチームが存在する"}, {"type": "subtitle", "time": 10744.389, "timestamp": "02:59:04", "text": "。 それで、私たちはどんな風に殺したの"}, {"type": "subtitle", "time": 10747.03, "timestamp": "02:59:07", "text": "？ 二。 いや、違う。ああ、彼らはそれをやめたんだ"}, {"type": "subtitle", "time": 10749.83, "timestamp": "02:59:09", "text": "。 そのうち5人は湿地帯に、"}, {"type": "subtitle", "time": 10764.389, "timestamp": "02:59:24", "text": "一匹殺したんだよね？ あれはたった"}, {"type": "subtitle", "time": 10774.95, "timestamp": "02:59:34", "text": "ああ、あのリコールね。   そうそう"}]
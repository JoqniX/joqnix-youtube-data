[{"type": "subtitle", "time": 12120.63, "timestamp": "03:22:00", "text": "ああ、いやだ。 えっと、相手が投げたんです。"}, {"type": "subtitle", "time": 12123.03, "timestamp": "03:22:03", "text": "うん。 うん。 それは、"}, {"type": "subtitle", "time": 12135.51, "timestamp": "03:22:15", "text": "どんな銃？ どんな銃？ やあ、君。   それでは。"}, {"type": "subtitle", "time": 12143.429, "timestamp": "03:22:23", "text": "。 ほら、虫を必ず回収しておけよ"}, {"type": "subtitle", "time": 12168.309, "timestamp": "03:22:48", "text": "ああ、この人はいい人だ。 彼は"}, {"type": "subtitle", "time": 12171.59, "timestamp": "03:22:51", "text": "私たちに弾薬箱をくれている。"}, {"type": "subtitle", "time": 12173.429, "timestamp": "03:22:53", "text": "それは私のものです。"}]
[{"type": "subtitle", "time": 4561.75, "timestamp": "01:16:01", "text": "歩いていた場所にテレポートで戻されてしまいました。"}, {"type": "subtitle", "time": 4565.83, "timestamp": "01:16:05", "text": "よし、戻ってきたぞ。 ああ、"}, {"type": "subtitle", "time": 4568.31, "timestamp": "01:16:08", "text": "俺は毒を盛られたんだ、"}, {"type": "subtitle", "time": 4583.99, "timestamp": "01:16:23", "text": "死ぬと思う。 あなたは私を蘇らせることができる"}, {"type": "subtitle", "time": 4589.91, "timestamp": "01:16:29", "text": "あなたは？"}, {"type": "subtitle", "time": 4591.91, "timestamp": "01:16:31", "text": "ああ、私は死にかけている。"}, {"type": "subtitle", "time": 4593.99, "timestamp": "01:16:33", "text": "毒棒ならそんなに"}, {"type": "subtitle", "time": 4601.51, "timestamp": "01:16:41", "text": "。 上の階に人がいます。 走る。"}, {"type": "subtitle", "time": 4610.149, "timestamp": "01:16:50", "text": "落下による損傷があります。 私はここにいます。 私はここにいます"}, {"type": "subtitle", "time": 4612.87, "timestamp": "01:16:52", "text": "。 私は安全な場所にいます。 来てもいいですよ"}, {"type": "subtitle", "time": 4615.75, "timestamp": "01:16:55", "text": "。"}, {"type": "subtitle", "time": 4617.99, "timestamp": "01:16:57", "text": "ああ、あそこに男がいる。"}]
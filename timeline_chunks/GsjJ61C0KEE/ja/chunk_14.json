[{"type": "subtitle", "time": 842.15, "timestamp": "00:14:02", "text": "それとも英語、日本語、または両方に切り替える予定ですか？"}, {"type": "subtitle", "time": 857.509, "timestamp": "00:14:17", "text": "こんにちは。"}, {"type": "subtitle", "time": 859.75, "timestamp": "00:14:19", "text": "あ、待って、待って。 ええ、私のPCはフリーズから回復したと"}, {"type": "subtitle", "time": 862.069, "timestamp": "00:14:22", "text": "思います。 ああ、神様。 あれ見ましたか"}, {"type": "subtitle", "time": 864.949, "timestamp": "00:14:24", "text": "？ まるで凍りついたようだった。   ええ"}, {"type": "subtitle", "time": 867.43, "timestamp": "00:14:27", "text": "、配信を見ていました。 ほんの少しだけ"}, {"type": "subtitle", "time": 870.55, "timestamp": "00:14:30", "text": "。"}, {"type": "subtitle", "time": 873.99, "timestamp": "00:14:33", "text": "それで、えっと、"}, {"type": "subtitle", "time": 876.71, "timestamp": "00:14:36", "text": "どうして？"}, {"type": "subtitle", "time": 892.87, "timestamp": "00:14:52", "text": "ストリームクラのような気分になる必要がある 何？ ああ、なんてことだ。 何が"}, {"type": "subtitle", "time": 895.189, "timestamp": "00:14:55", "text": "起こっていますか？ はい、戻ってきました。 戻ってきました。   わかった"}, {"type": "subtitle", "time": 897.59, "timestamp": "00:14:57", "text": "。 わかった。 わかった。  [ため息をつき、息を呑む] 信じ"}, {"type": "subtitle", "time": 899.75, "timestamp": "00:14:59", "text": "られない"}]
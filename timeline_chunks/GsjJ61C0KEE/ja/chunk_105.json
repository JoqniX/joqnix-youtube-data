[{"type": "subtitle", "time": 6307.109, "timestamp": "01:45:07", "text": "トランスジェンダーであるべきなのか？"}, {"type": "subtitle", "time": 6313.99, "timestamp": "01:45:13", "text": "。   うまくいくかどうか見てみましょう"}, {"type": "subtitle", "time": 6318.07, "timestamp": "01:45:18", "text": "。"}, {"type": "subtitle", "time": 6328.629, "timestamp": "01:45:28", "text": "ちなみに、デフォルト設定にしておきました。   わかった"}, {"type": "subtitle", "time": 6334.55, "timestamp": "01:45:34", "text": "ニース。 では、"}, {"type": "subtitle", "time": 6336.95, "timestamp": "01:45:36", "text": "待ってください。 いつ配信を開始したか？ 私が"}, {"type": "subtitle", "time": 6338.87, "timestamp": "01:45:38", "text": "始めたんですよね"}, {"type": "subtitle", "time": 6339.75, "timestamp": "01:45:39", "text": "？"}, {"type": "subtitle", "time": 6343.43, "timestamp": "01:45:43", "text": "ああ、そうだったね"}, {"type": "subtitle", "time": 6345.91, "timestamp": "01:45:45", "text": "。"}, {"type": "subtitle", "time": 6352.31, "timestamp": "01:45:52", "text": "ストリームの見た目はすごく滑らかですね。"}, {"type": "subtitle", "time": 6357.493, "timestamp": "01:45:57", "text": "ストリームがとてもスムーズだと思う。"}]
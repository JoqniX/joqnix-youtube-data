[{"type": "subtitle", "time": 4800.149, "timestamp": "01:20:00", "text": "。"}, {"type": "subtitle", "time": 4802.63, "timestamp": "01:20:02", "text": "地下。 地下。"}, {"type": "subtitle", "time": 4806.149, "timestamp": "01:20:06", "text": "そんなのクソくらえだ。 皆さん、あそこには何があるんですか"}, {"type": "subtitle", "time": 4810.31, "timestamp": "01:20:10", "text": "？ ああ、それはあなただったんですね。"}, {"type": "subtitle", "time": 4810.63, "timestamp": "01:20:10", "text": "怖かった。"}, {"type": "subtitle", "time": 4811.99, "timestamp": "01:20:11", "text": "怖くなった。"}, {"type": "subtitle", "time": 4820.47, "timestamp": "01:20:20", "text": "よし、地下室はこっちのはずだ。"}, {"type": "subtitle", "time": 4823.189, "timestamp": "01:20:23", "text": "もしよければ、あそこで略奪してもいいですよ。"}, {"type": "subtitle", "time": 4829.59, "timestamp": "01:20:29", "text": "うん、ここにはあまり"}, {"type": "subtitle", "time": 4832.55, "timestamp": "01:20:32", "text": "物が入ってないみたいだね。"}, {"type": "subtitle", "time": 4835.11, "timestamp": "01:20:35", "text": "ただ、"}, {"type": "subtitle", "time": 4842.63, "timestamp": "01:20:42", "text": "、彼らはそれを簡単にはしてくれないんですよね。"}, {"type": "subtitle", "time": 4845.27, "timestamp": "01:20:45", "text": "例えば、チーム"}, {"type": "subtitle", "time": 4848.07, "timestamp": "01:20:48", "text": "メイトが近くにいる場合など"}, {"type": "subtitle", "time": 4850.149, "timestamp": "01:20:50", "text": "。"}, {"type": "subtitle", "time": 4852.95, "timestamp": "01:20:52", "text": "ええ、ある意味ではそうですね。 でも、"}, {"type": "subtitle", "time": 4858.149, "timestamp": "01:20:58", "text": "少し違うという意味です。ちょっと"}]
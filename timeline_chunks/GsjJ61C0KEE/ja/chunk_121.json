[{"type": "subtitle", "time": 7262.39, "timestamp": "02:01:02", "text": "、今すごく恥ずかしい。"}, {"type": "subtitle", "time": 7265.51, "timestamp": "02:01:05", "text": "くそっ、狙撃手がいるぞ。   それは分かりません"}, {"type": "subtitle", "time": 7273.27, "timestamp": "02:01:13", "text": "4つしかない。"}, {"type": "subtitle", "time": 7274.149, "timestamp": "02:01:14", "text": "ちょっと残念だね。"}, {"type": "subtitle", "time": 7276.55, "timestamp": "02:01:16", "text": "ハッキングツールはどこにあるの？ 私には見えません"}, {"type": "subtitle", "time": 7279.27, "timestamp": "02:01:19", "text": "。   見てみましょう"}, {"type": "subtitle", "time": 7281.83, "timestamp": "02:01:21", "text": "。   たぶん"}, {"type": "subtitle", "time": 7284.709, "timestamp": "02:01:24", "text": "地下室にあるんじゃないかな。 下へ降りてください。"}, {"type": "subtitle", "time": 7311.75, "timestamp": "02:01:51", "text": "。 私が今"}, {"type": "subtitle", "time": 7315.589, "timestamp": "02:01:55", "text": "いる場所のような、この辺りにあるべきだと思う"}]
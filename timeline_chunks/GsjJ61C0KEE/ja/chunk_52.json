[{"type": "subtitle", "time": 3122.23, "timestamp": "00:52:02", "text": "誰かがここにいるみたいだ。"}, {"type": "subtitle", "time": 3122.95, "timestamp": "00:52:02", "text": "残り1分。"}, {"type": "subtitle", "time": 3129.829, "timestamp": "00:52:09", "text": "砲塔、砲塔、砲塔、砲塔という感じがします"}, {"type": "subtitle", "time": 3144.23, "timestamp": "00:52:24", "text": "私の顎の傷は"}, {"type": "subtitle", "time": 3153.196, "timestamp": "00:52:33", "text": "ああ、私は死んだ。"}, {"type": "subtitle", "time": 3153.589, "timestamp": "00:52:33", "text": "[笑い] ちょっと待って"}, {"type": "subtitle", "time": 3155.67, "timestamp": "00:52:35", "text": "。 持続する。 持続する。"}, {"type": "subtitle", "time": 3157.43, "timestamp": "00:52:37", "text": "うん。"}, {"type": "subtitle", "time": 3159.19, "timestamp": "00:52:39", "text": "ここのロボットたちを侮ってはいけません。"}, {"type": "subtitle", "time": 3169.109, "timestamp": "00:52:49", "text": "シールドがクラッシュした。   何だって"}, {"type": "subtitle", "time": 3170.23, "timestamp": "00:52:50", "text": "？"}, {"type": "subtitle", "time": 3173.589, "timestamp": "00:52:53", "text": "密かに婚約した。"}]
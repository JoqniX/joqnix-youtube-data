[{"type": "subtitle", "time": 9187.83, "timestamp": "02:33:07", "text": "文字通り、ものすごく遅くなった。"}, {"type": "subtitle", "time": 9192.389, "timestamp": "02:33:12", "text": "マルチオン。 わかりました、では有効化します。"}, {"type": "subtitle", "time": 9197.605, "timestamp": "02:33:17", "text": "ああ、もちろん彼は去ったよ。 もちろん。"}, {"type": "subtitle", "time": 9213.19, "timestamp": "02:33:33", "text": "高いの？"}, {"type": "subtitle", "time": 9216.309, "timestamp": "02:33:36", "text": "陸上ケーブルとか、そういう類のもの。"}, {"type": "subtitle", "time": 9216.63, "timestamp": "02:33:36", "text": "ああ、"}, {"type": "subtitle", "time": 9218.63, "timestamp": "02:33:38", "text": "それらは高価ですね。 どういう意味ですか？"}, {"type": "subtitle", "time": 9221.83, "timestamp": "02:33:41", "text": "それらは安い。"}, {"type": "subtitle", "time": 9230.469, "timestamp": "02:33:50", "text": "面白い。 この新しいリンクは何ですか？"}, {"type": "subtitle", "time": 9232.389, "timestamp": "02:33:52", "text": "トラクサス。"}, {"type": "subtitle", "time": 9235.349, "timestamp": "02:33:55", "text": "私はバルカン人だ。 私は正式に"}, {"type": "subtitle", "time": 9238.71, "timestamp": "02:33:58", "text": "あなたの"}]
[{"type": "subtitle", "time": 8947.67, "timestamp": "02:29:07", "text": "よし、"}, {"type": "subtitle", "time": 8958.79, "timestamp": "02:29:18", "text": "あ、待って。 医療キット。"}, {"type": "subtitle", "time": 8961.11, "timestamp": "02:29:21", "text": "ブラジャーの中にそれが必要なの。"}, {"type": "subtitle", "time": 8962.71, "timestamp": "02:29:22", "text": "ああ、しまった。 なんで急にそんなにうるさくなったの"}, {"type": "subtitle", "time": 8969.83, "timestamp": "02:29:29", "text": "突然大きな音がする。"}, {"type": "subtitle", "time": 8972.07, "timestamp": "02:29:32", "text": "私はずっと"}, {"type": "subtitle", "time": 8973.67, "timestamp": "02:29:33", "text": "ささやいていたことを忘れていました"}, {"type": "subtitle", "time": 8982.63, "timestamp": "02:29:42", "text": "よし、全部略奪したぞ。 うん。 うん。"}, {"type": "subtitle", "time": 8986.23, "timestamp": "02:29:46", "text": "ベーコンはどこ？ ベーコンは何をしているの？"}, {"type": "subtitle", "time": 8990.23, "timestamp": "02:29:50", "text": "私は、えーと、この戦利品の場所に行くところです。"}, {"type": "subtitle", "time": 8991.429, "timestamp": "02:29:51", "text": "落とし穴がある。"}, {"type": "subtitle", "time": 8994.79, "timestamp": "02:29:54", "text": "私たちは皆、遠く離れている。"}, {"type": "subtitle", "time": 8995.59, "timestamp": "02:29:55", "text": "だから、彼は行くつもりだ。ああ、もう一人の"}, {"type": "subtitle", "time": 8998.07, "timestamp": "02:29:58", "text": "男はおそらく、"}, {"type": "subtitle", "time": 8998.87, "timestamp": "02:29:58", "text": "私は彼に行くつもりだ。"}]
[{"type": "subtitle", "time": 11107.75, "timestamp": "03:05:07", "text": "このアニメーションやグラフィックを作るのに相当な費用がかかったんだろうね？"}, {"type": "subtitle", "time": 11108.87, "timestamp": "03:05:08", "text": "アニメーション。"}, {"type": "subtitle", "time": 11110.07, "timestamp": "03:05:10", "text": "これは"}, {"type": "subtitle", "time": 11115.03, "timestamp": "03:05:15", "text": "ゲームのイントロやモーション"}, {"type": "subtitle", "time": 11117.59, "timestamp": "03:05:17", "text": "グラフィックスなど、ゲームのグラフィック全般です。"}, {"type": "subtitle", "time": 11120.63, "timestamp": "03:05:20", "text": "ああ、本当に大好きです。"}, {"type": "subtitle", "time": 11130.79, "timestamp": "03:05:30", "text": "あなたが"}, {"type": "subtitle", "time": 11133.91, "timestamp": "03:05:33", "text": "船を片付ける時、私はガスを吸います。"}, {"type": "subtitle", "time": 11139.269, "timestamp": "03:05:39", "text": "最悪の銃を装着した。"}, {"type": "subtitle", "time": 11142.95, "timestamp": "03:05:42", "text": "この銃を装着してください。"}, {"type": "subtitle", "time": 11145.429, "timestamp": "03:05:45", "text": "この銃。"}, {"type": "subtitle", "time": 11147.269, "timestamp": "03:05:47", "text": "では、最高ランクはいくつですか？"}, {"type": "subtitle", "time": 11151.11, "timestamp": "03:05:51", "text": "派閥を選ぶこともできます。"}, {"type": "subtitle", "time": 11152.87, "timestamp": "03:05:52", "text": "ええと、"}, {"type": "subtitle", "time": 11155.429, "timestamp": "03:05:55", "text": "レベル"}, {"type": "subtitle", "time": 11158.309, "timestamp": "03:05:58", "text": "30に到達して合格すると、"}]
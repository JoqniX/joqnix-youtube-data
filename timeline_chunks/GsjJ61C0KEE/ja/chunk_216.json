[{"type": "subtitle", "time": 12962.229, "timestamp": "03:36:02", "text": "うん。"}, {"type": "subtitle", "time": 12965.11, "timestamp": "03:36:05", "text": "最後のX失敗に対して、1分間の延長が与えられます"}, {"type": "subtitle", "time": 12967.03, "timestamp": "03:36:07", "text": "。   何だって"}, {"type": "subtitle", "time": 12973.99, "timestamp": "03:36:13", "text": "どういうことだ？"}, {"type": "subtitle", "time": 12974.95, "timestamp": "03:36:14", "text": "どうしたの？   ちなみに、"}, {"type": "subtitle", "time": 12976.95, "timestamp": "03:36:16", "text": "ここは今もチームとして活動していますよ。 そして彼女の"}, {"type": "subtitle", "time": 12978.309, "timestamp": "03:36:18", "text": "射撃、すごいよ"}, {"type": "subtitle", "time": 12984.71, "timestamp": "03:36:24", "text": "よし、タイマーが鳴るまで待とう。"}, {"type": "subtitle", "time": 12989.03, "timestamp": "03:36:29", "text": "最終追放者の場合、マップの中央付近に出現するはずです。"}, {"type": "subtitle", "time": 12990.63, "timestamp": "03:36:30", "text": "地図を開くと、そこにカウントダウンが表示されます"}, {"type": "subtitle", "time": 12993.269, "timestamp": "03:36:33", "text": "。"}, {"type": "subtitle", "time": 13011.03, "timestamp": "03:36:51", "text": "2分間ください。 ああ、あの時はその"}, {"type": "subtitle", "time": 13013.349, "timestamp": "03:36:53", "text": "時じゃなかったんだ。 そうそう。 うん。 うん。 彼らは"}, {"type": "subtitle", "time": 13013.67, "timestamp": "03:36:53", "text": "時間を無駄にした。"}, {"type": "subtitle", "time": 13015.349, "timestamp": "03:36:55", "text": "ああ、昨シーズンは"}, {"type": "subtitle", "time": 13018.15, "timestamp": "03:36:58", "text": "私だけを狙っていた人もいました。 私です。 私です。 どこ？ くそ。 私は"}, {"type": "subtitle", "time": 13018.95, "timestamp": "03:36:58", "text": "死にかけている。 私は死にかけている。"}]
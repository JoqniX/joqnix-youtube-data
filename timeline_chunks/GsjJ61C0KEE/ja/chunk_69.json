[{"type": "subtitle", "time": 4141.11, "timestamp": "01:09:01", "text": "。 それは"}, {"type": "subtitle", "time": 4143.349, "timestamp": "01:09:03", "text": "ゲーム内で新しいことが起こったようなもので、"}, {"type": "subtitle", "time": 4145.749, "timestamp": "01:09:05", "text": "ちょっとクールですね。   わかった"}, {"type": "subtitle", "time": 4146.07, "timestamp": "01:09:06", "text": "。"}, {"type": "subtitle", "time": 4148.709, "timestamp": "01:09:08", "text": "つまり、基本的には"}, {"type": "subtitle", "time": 4150.87, "timestamp": "01:09:10", "text": "前回のゲームでやったカードを集めるのと似ています"}, {"type": "subtitle", "time": 4155.349, "timestamp": "01:09:15", "text": "が、2枚のカードを集める代わりに、"}, {"type": "subtitle", "time": 4161.749, "timestamp": "01:09:21", "text": "タワーを使用するのに十分なカードが必要になり、その後キャッチを開けます"}, {"type": "subtitle", "time": 4163.99, "timestamp": "01:09:23", "text": "。"}, {"type": "subtitle", "time": 4165.829, "timestamp": "01:09:25", "text": "ああ、"}, {"type": "subtitle", "time": 4166.87, "timestamp": "01:09:26", "text": "何かがそこにいる。"}, {"type": "subtitle", "time": 4168.149, "timestamp": "01:09:28", "text": "つまり、さまざまな種類の"}, {"type": "subtitle", "time": 4172.229, "timestamp": "01:09:32", "text": "タワーが存在するということだ。 彼が使った塔は、ええと、"}, {"type": "subtitle", "time": 4174.149, "timestamp": "01:09:34", "text": "武器の塔でした。"}, {"type": "subtitle", "time": 4178.63, "timestamp": "01:09:38", "text": "防具とかアイテムとか、いろいろあるだろうね。 そうですね、"}, {"type": "subtitle", "time": 4181.91, "timestamp": "01:09:41", "text": "タワー"}, {"type": "subtitle", "time": 4183.59, "timestamp": "01:09:43", "text": "シールドが壊れる種類がいくつかあるでしょう。"}, {"type": "subtitle", "time": 4193.59, "timestamp": "01:09:53", "text": "上に男が一人いる。"}, {"type": "subtitle", "time": 4195.59, "timestamp": "01:09:55", "text": "上の階に男が一人いる。   来て"}, {"type": "subtitle", "time": 4196.63, "timestamp": "01:09:56", "text": "。 ヒーラー。 来る。 来る。"}, {"type": "subtitle", "time": 4199.189, "timestamp": "01:09:59", "text": "上の階に男が一人いる。"}]
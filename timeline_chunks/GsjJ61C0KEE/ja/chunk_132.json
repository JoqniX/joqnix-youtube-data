[{"type": "subtitle", "time": 7920.149, "timestamp": "02:12:00", "text": "いや、いや、いや、いや。 私たちのチームメイト"}, {"type": "subtitle", "time": 7922.709, "timestamp": "02:12:02", "text": "や私が殺した相手も、"}, {"type": "subtitle", "time": 7924.95, "timestamp": "02:12:04", "text": "日本人という名前でした。 日本語名には日本語"}, {"type": "subtitle", "time": 7927.109, "timestamp": "02:12:07", "text": "名があります。"}, {"type": "subtitle", "time": 7931.99, "timestamp": "02:12:11", "text": "3,000で私の裏金を変更させていただけますか。   そっちの方が"}, {"type": "subtitle", "time": 7934.149, "timestamp": "02:12:14", "text": "いいでしょう。"}, {"type": "subtitle", "time": 7937.83, "timestamp": "02:12:17", "text": "少なくとも今は安定している。"}, {"type": "subtitle", "time": 7939.83, "timestamp": "02:12:19", "text": "ああ、"}, {"type": "subtitle", "time": 7941.51, "timestamp": "02:12:21", "text": "先にテストしておくべきだったな。"}, {"type": "subtitle", "time": 7942.79, "timestamp": "02:12:22", "text": "ええ、でも今は"}, {"type": "subtitle", "time": 7944.229, "timestamp": "02:12:24", "text": "以前から知っていました。"}, {"type": "subtitle", "time": 7945.189, "timestamp": "02:12:25", "text": "これで分かった。"}, {"type": "subtitle", "time": 7945.83, "timestamp": "02:12:25", "text": "うん。"}, {"type": "subtitle", "time": 7948.95, "timestamp": "02:12:28", "text": "ああ、誰かが亡くなった。"}, {"type": "subtitle", "time": 7950.31, "timestamp": "02:12:30", "text": "医療キットがたくさんあります。   そうそう"}, {"type": "subtitle", "time": 7951.99, "timestamp": "02:12:31", "text": "。 うん。 うん。 ええと、もう一人の男が"}, {"type": "subtitle", "time": 7953.589, "timestamp": "02:12:33", "text": "全員殺しました。   何てことだ"}, {"type": "subtitle", "time": 7954.229, "timestamp": "02:12:34", "text": "。"}, {"type": "subtitle", "time": 7957.99, "timestamp": "02:12:37", "text": "うん、本当にたくさんあるよ。"}, {"type": "subtitle", "time": 7963.75, "timestamp": "02:12:43", "text": "左側にも他の体のシールドのようなものがあります。"}, {"type": "subtitle", "time": 7966.709, "timestamp": "02:12:46", "text": "それらを手に取ってもいいですよ。 彼と再会できた"}]
[{"type": "subtitle", "time": 8703.19, "timestamp": "02:25:03", "text": "。"}, {"type": "subtitle", "time": 8706.15, "timestamp": "02:25:06", "text": "あ、すみません。 分かりますよ。 分かりますよ。"}, {"type": "subtitle", "time": 8709.11, "timestamp": "02:25:09", "text": "5人。 ああ、たった一つだけ。   何てことだ"}, {"type": "subtitle", "time": 8719.429, "timestamp": "02:25:19", "text": "行け、行け、行け、行け、行け、行け。"}, {"type": "subtitle", "time": 8728.469, "timestamp": "02:25:28", "text": "よし、やっとスキャンを開始"}, {"type": "subtitle", "time": 8735.11, "timestamp": "02:25:35", "text": "。 私は自分の使命を果たした。"}, {"type": "subtitle", "time": 8739.11, "timestamp": "02:25:39", "text": "バイオを破壊する。 まだ終わってないの"}, {"type": "subtitle", "time": 8741.59, "timestamp": "02:25:41", "text": "？ いいえ。"}, {"type": "subtitle", "time": 8744.55, "timestamp": "02:25:44", "text": "それは、えーと、コイムーンです。"}, {"type": "subtitle", "time": 8746.23, "timestamp": "02:25:46", "text": "ええ、"}, {"type": "subtitle", "time": 8747.349, "timestamp": "02:25:47", "text": "それが彼の使命です。"}, {"type": "subtitle", "time": 8749.59, "timestamp": "02:25:49", "text": "ああ、わかりました。 今、それが明らかになった。 よし、"}, {"type": "subtitle", "time": 8757.67, "timestamp": "02:25:57", "text": "カードはここにあります。"}]
[{"type": "subtitle", "time": 12606.229, "timestamp": "03:30:06", "text": "彼はバグを起こしているのだろうか？"}, {"type": "subtitle", "time": 12619.59, "timestamp": "03:30:19", "text": "彼は不具合を起こしている。"}, {"type": "subtitle", "time": 12624.95, "timestamp": "03:30:24", "text": "ドロップシップの中で彼を殴る。 これは何ですか？ 待って、"}, {"type": "subtitle", "time": 12629.19, "timestamp": "03:30:29", "text": "ピンク色の部分についているのは何？   やばい"}, {"type": "subtitle", "time": 12631.349, "timestamp": "03:30:31", "text": "、"}, {"type": "subtitle", "time": 12635.03, "timestamp": "03:30:35", "text": "護送隊だ。 ああ。"}, {"type": "subtitle", "time": 12636.95, "timestamp": "03:30:36", "text": "ああ、くそ。 私は死んだ。 私は死んだ。 私は死んだ。"}, {"type": "subtitle", "time": 12645.91, "timestamp": "03:30:45", "text": "ああ、これね。"}, {"type": "subtitle", "time": 12646.87, "timestamp": "03:30:46", "text": "バカな。ほら、どうぞ"}, {"type": "subtitle", "time": 12649.429, "timestamp": "03:30:49", "text": "。"}, {"type": "subtitle", "time": 12651.269, "timestamp": "03:30:51", "text": "何？"}, {"type": "subtitle", "time": 12656.71, "timestamp": "03:30:56", "text": "転倒によるダメージで倒れたのだと思います。 誰かに背後から撃たれた"}, {"type": "subtitle", "time": 12659.19, "timestamp": "03:30:59", "text": "か何かだ。 わからない。"}]
[{"type": "subtitle", "time": 10860.63, "timestamp": "03:01:00", "text": "私たちは大丈夫です。 おそらく、"}, {"type": "subtitle", "time": 10889.03, "timestamp": "03:01:29", "text": "問題は、もう一人の男はなぜあんなに"}, {"type": "subtitle", "time": 10891.59, "timestamp": "03:01:31", "text": "早く蘇生できたのかということだ。"}, {"type": "subtitle", "time": 10893.19, "timestamp": "03:01:33", "text": "これはあなたのチャンスです。"}, {"type": "subtitle", "time": 10895.19, "timestamp": "03:01:35", "text": "ああ、そこには2つのチームが戦っていたんだ。   おそらく"}, {"type": "subtitle", "time": 10897.03, "timestamp": "03:01:37", "text": "その一つでしょう"}, {"type": "subtitle", "time": 10903.75, "timestamp": "03:01:43", "text": "。"}, {"type": "subtitle", "time": 10909.03, "timestamp": "03:01:49", "text": "そうだよ、だって俺たちが３人殺したんだからな。"}, {"type": "subtitle", "time": 10911.51, "timestamp": "03:01:51", "text": "そして私は最初の獲物を狙撃した。"}]
[{"type": "subtitle", "time": 7810.55, "timestamp": "02:10:10", "text": "ああ、私たちのチームメイトだ。"}, {"type": "subtitle", "time": 7815.35, "timestamp": "02:10:15", "text": "ああ、もう一人の人だよ。 聖なる。"}, {"type": "subtitle", "time": 7818.069, "timestamp": "02:10:18", "text": "よし、あちらで略奪を終わらせよう。 ええと、"}, {"type": "subtitle", "time": 7820.95, "timestamp": "02:10:20", "text": "この男を再編成します。 あなたはもうすぐ"}, {"type": "subtitle", "time": 7823.83, "timestamp": "02:10:23", "text": "死ぬ。"}, {"type": "subtitle", "time": 7828.149, "timestamp": "02:10:28", "text": "ああ、何も見つからない。   まるで、もう"}, {"type": "subtitle", "time": 7845.27, "timestamp": "02:10:45", "text": "うん。 特にアジアでは、"}, {"type": "subtitle", "time": 7847.51, "timestamp": "02:10:47", "text": "ゲーム内であまり会話をしない人が多いように感じます。 彼らは言葉を交わさずに"}, {"type": "subtitle", "time": 7849.35, "timestamp": "02:10:49", "text": "ゲームを進める方法を知っている"}, {"type": "subtitle", "time": 7850.79, "timestamp": "02:10:50", "text": "。"}, {"type": "subtitle", "time": 7855.589, "timestamp": "02:10:55", "text": "正直に言うと、それが私の得ているものなんです。"}, {"type": "subtitle", "time": 7858.55, "timestamp": "02:10:58", "text": "ああ、ここに青い銃がある。"}]
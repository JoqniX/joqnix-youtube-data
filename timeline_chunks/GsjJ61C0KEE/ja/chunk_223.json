[{"type": "subtitle", "time": 13381.429, "timestamp": "03:43:01", "text": "うん、あと1時間くらいで仕事が始まるんだ。"}, {"type": "subtitle", "time": 13382.469, "timestamp": "03:43:02", "text": "本気ですか？"}, {"type": "subtitle", "time": 13383.75, "timestamp": "03:43:03", "text": "約30分。   本当に"}, {"type": "subtitle", "time": 13387.269, "timestamp": "03:43:07", "text": "生き残れる自信はありますか？"}, {"type": "subtitle", "time": 13387.67, "timestamp": "03:43:07", "text": "そうです。   そうそう"}, {"type": "subtitle", "time": 13390.389, "timestamp": "03:43:10", "text": "。 ジョック、目が覚めたよ。 目が"}, {"type": "subtitle", "time": 13395.349, "timestamp": "03:43:15", "text": "覚めました。 うん。 何てことだ。 ごめんなさい。"}, {"type": "subtitle", "time": 13396.469, "timestamp": "03:43:16", "text": "はい、これで終わりにしましょう。"}, {"type": "subtitle", "time": 13397.51, "timestamp": "03:43:17", "text": "大丈夫ですよ。"}, {"type": "subtitle", "time": 13400.389, "timestamp": "03:43:20", "text": "待って、あなたはそれを持っています。それは"}, {"type": "subtitle", "time": 13404.389, "timestamp": "03:43:24", "text": "何ですか？ どうやってあの"}, {"type": "subtitle", "time": 13406.389, "timestamp": "03:43:26", "text": "デラックストラックを手に入れたんだ"}, {"type": "subtitle", "time": 13408.55, "timestamp": "03:43:28", "text": "？"}, {"type": "subtitle", "time": 13415.11, "timestamp": "03:43:35", "text": "支払いました。 セール中だった。"}, {"type": "subtitle", "time": 13418.07, "timestamp": "03:43:38", "text": "30%オフセールだった。"}, {"type": "subtitle", "time": 13430.71, "timestamp": "03:43:50", "text": "銀行口座の手続きが済んだら、"}, {"type": "subtitle", "time": 13433.189, "timestamp": "03:43:53", "text": "可能であれば買い物をしたいと思っています。 まあ、そうですね。"}, {"type": "subtitle", "time": 13436.229, "timestamp": "03:43:56", "text": "ああ、買いすぎないでくださいね。"}]
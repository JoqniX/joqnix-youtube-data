[{"type": "subtitle", "time": 11304.469, "timestamp": "03:08:24", "text": "我々の作ったクレーターの光景がフラッシュバックしてくる。"}, {"type": "subtitle", "time": 11306.389, "timestamp": "03:08:26", "text": "でも、マトリックスのために"}, {"type": "subtitle", "time": 11310.55, "timestamp": "03:08:30", "text": "弾薬とか色々買わなきゃいけなかった場面、覚えてる"}, {"type": "subtitle", "time": 11317.19, "timestamp": "03:08:37", "text": "それは確かに何かだった。"}, {"type": "subtitle", "time": 11319.91, "timestamp": "03:08:39", "text": "えっと、ここで女族長と戦うために協力しても、結局"}, {"type": "subtitle", "time": 11323.429, "timestamp": "03:08:43", "text": "お互いに殺し合うだけなので無理です"}, {"type": "subtitle", "time": 11325.03, "timestamp": "03:08:45", "text": "。 つまり、ゲーム内にはたくさんの"}, {"type": "subtitle", "time": 11326.23, "timestamp": "03:08:46", "text": "イベントがあるということです。"}, {"type": "subtitle", "time": 11326.55, "timestamp": "03:08:46", "text": "ああ、"}, {"type": "subtitle", "time": 11328.79, "timestamp": "03:08:48", "text": "それはいいですね。"}, {"type": "subtitle", "time": 11330.63, "timestamp": "03:08:50", "text": "うん。 つい最近"}]
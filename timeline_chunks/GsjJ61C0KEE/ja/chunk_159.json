[{"type": "subtitle", "time": 9541.59, "timestamp": "02:39:01", "text": "ええ、すぐ隣にありますよ"}, {"type": "subtitle", "time": 9543.19, "timestamp": "02:39:03", "text": "。"}, {"type": "subtitle", "time": 9544.55, "timestamp": "02:39:04", "text": "私の部屋は1"}, {"type": "subtitle", "time": 9547.27, "timestamp": "02:39:07", "text": "階の一番奥にあるんです。 接続する方法がありません。"}, {"type": "subtitle", "time": 9549.83, "timestamp": "02:39:09", "text": "私がそれに接続する唯一の方法は、私"}, {"type": "subtitle", "time": 9567.19, "timestamp": "02:39:27", "text": "どういうことだ？ 誰が？"}, {"type": "subtitle", "time": 9569.67, "timestamp": "02:39:29", "text": "私は自分が自分のオフィスのロビーにいると思っていた。"}, {"type": "subtitle", "time": 9582.15, "timestamp": "02:39:42", "text": "はい。 ここは俺のロビーだ。"}, {"type": "subtitle", "time": 9584.95, "timestamp": "02:39:44", "text": "その男に会ってみろ。"}, {"type": "subtitle", "time": 9591.75, "timestamp": "02:39:51", "text": "。 ここはどこ？ 私たちはここにいます。 合格"}, {"type": "subtitle", "time": 9594.389, "timestamp": "02:39:54", "text": "。 彼のミュートを解除してください。 彼のミュートを解除してください。 彼は"}, {"type": "subtitle", "time": 9597.03, "timestamp": "02:39:57", "text": "私たちに話しかけている。"}]
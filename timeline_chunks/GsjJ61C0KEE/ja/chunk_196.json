[{"type": "subtitle", "time": 11773.19, "timestamp": "03:16:13", "text": "彼はジェットパックでも使うつもりなのか？"}, {"type": "subtitle", "time": 11775.91, "timestamp": "03:16:15", "text": "うん。 うん。 それは"}, {"type": "subtitle", "time": 11778.87, "timestamp": "03:16:18", "text": "ジェットパックのようなものです。 まるでスーパーダッシュみたいな​​感じだ"}, {"type": "subtitle", "time": 11780.07, "timestamp": "03:16:20", "text": "。"}, {"type": "subtitle", "time": 11783.51, "timestamp": "03:16:23", "text": "加速して速く走ることはできるが、そうすると"}, {"type": "subtitle", "time": 11785.83, "timestamp": "03:16:25", "text": "かなりの熱が発生したり、"}, {"type": "subtitle", "time": 11790.15, "timestamp": "03:16:30", "text": "スタミナを消耗したりする。"}, {"type": "subtitle", "time": 11819.51, "timestamp": "03:16:59", "text": "ドアを開けて行きたいですか？"}]
[{"type": "subtitle", "time": 1861.35, "timestamp": "00:31:01", "text": "だから、ノートパソコンだと時々ちょっと面倒だし、"}, {"type": "subtitle", "time": 1864.389, "timestamp": "00:31:04", "text": "イライラすることもある。"}, {"type": "subtitle", "time": 1873.35, "timestamp": "00:31:13", "text": "なぜ私のストリーミング配信はバッファリングされるのですか？ 何てことだ。"}, {"type": "subtitle", "time": 1891.19, "timestamp": "00:31:31", "text": "何が起こっているのかは神のみぞ知る。"}]
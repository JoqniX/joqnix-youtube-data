[{"type": "subtitle", "time": 7860.149, "timestamp": "02:11:00", "text": "ああ、素敵なものがたくさんありますね。   皆さんのところに戻ってきます"}, {"type": "subtitle", "time": 7862.709, "timestamp": "02:11:02", "text": "。"}, {"type": "subtitle", "time": 7864.629, "timestamp": "02:11:04", "text": "うん、うん、うん、うん。 緑色の"}, {"type": "subtitle", "time": 7881.669, "timestamp": "02:11:21", "text": "これを処分してください。   それを"}, {"type": "subtitle", "time": 7898.709, "timestamp": "02:11:38", "text": "Ko」は、日本人が自分自身につけるような名前だ"}, {"type": "subtitle", "time": 7901.27, "timestamp": "02:11:41", "text": "。"}, {"type": "subtitle", "time": 7903.35, "timestamp": "02:11:43", "text": "キムク。 ここはあなたの"}, {"type": "subtitle", "time": 7905.99, "timestamp": "02:11:45", "text": "サーバーだと思います。なぜなら、"}, {"type": "subtitle", "time": 7908.31, "timestamp": "02:11:48", "text": "日本のサーバーがたくさんあるからです。 ええ、つまり、"}, {"type": "subtitle", "time": 7912.79, "timestamp": "02:11:52", "text": "さっき見た日本人プレイヤーが殺されたってことですよね。 まるで日本の"}, {"type": "subtitle", "time": 7917.669, "timestamp": "02:11:57", "text": "名前みたいだ。 だから、あなたのサーバーはほぼ間違いないと思います。"}]
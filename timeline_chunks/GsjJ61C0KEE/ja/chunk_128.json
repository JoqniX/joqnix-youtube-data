[{"type": "subtitle", "time": 7680.149, "timestamp": "02:08:00", "text": "。 えっと、"}, {"type": "subtitle", "time": 7685.51, "timestamp": "02:08:05", "text": "ゲーム内で私をミュートするか、"}, {"type": "subtitle", "time": 7688.79, "timestamp": "02:08:08", "text": "あるいは、ここに一緒にいるプレイヤーと話した方がいいでしょうか"}, {"type": "subtitle", "time": 7690.709, "timestamp": "02:08:10", "text": "？ 彼はプロの選手ですか？"}, {"type": "subtitle", "time": 7691.109, "timestamp": "02:08:11", "text": "私はそうは思わない。"}, {"type": "subtitle", "time": 7692.87, "timestamp": "02:08:12", "text": "どう思いますか？"}, {"type": "subtitle", "time": 7696.069, "timestamp": "02:08:16", "text": "彼は返信しないと思う。"}, {"type": "subtitle", "time": 7697.83, "timestamp": "02:08:17", "text": "ああ、"}, {"type": "subtitle", "time": 7701.75, "timestamp": "02:08:21", "text": "医療パックが本当に必要なんだ。   ええ"}, {"type": "subtitle", "time": 7703.27, "timestamp": "02:08:23", "text": "、ここでたくさんの人を殺しました"}, {"type": "subtitle", "time": 7705.83, "timestamp": "02:08:25", "text": "。 行ってみて確認してみてください。"}, {"type": "subtitle", "time": 7706.709, "timestamp": "02:08:26", "text": "どこ？ はい、ここに"}, {"type": "subtitle", "time": 7709.99, "timestamp": "02:08:29", "text": "３体ほどの遺体があります。"}, {"type": "subtitle", "time": 7712.31, "timestamp": "02:08:32", "text": "遅れています。   行き詰まってしまった"}, {"type": "subtitle", "time": 7714.31, "timestamp": "02:08:34", "text": "。 はい、ちょっと遅れています。 はい、"}, {"type": "subtitle", "time": 7717.03, "timestamp": "02:08:37", "text": "大丈夫です。 またテレポートされるだけだ。   来て"}, {"type": "subtitle", "time": 7719.03, "timestamp": "02:08:39", "text": "。"}, {"type": "subtitle", "time": 7720.31, "timestamp": "02:08:40", "text": "何か行動を起こしてください。"}, {"type": "subtitle", "time": 7723.03, "timestamp": "02:08:43", "text": "良い戦利品だ。 くそっ。"}, {"type": "subtitle", "time": 7724.79, "timestamp": "02:08:44", "text": "ああ、君のためなら多少のことは気にしないよ。"}, {"type": "subtitle", "time": 7726.709, "timestamp": "02:08:46", "text": "かなり良い"}, {"type": "subtitle", "time": 7728.95, "timestamp": "02:08:48", "text": "戦利品をたくさん持っている男がいる。"}, {"type": "subtitle", "time": 7732.95, "timestamp": "02:08:52", "text": "ああ、私の配信も衰退している。"}, {"type": "subtitle", "time": 7735.83, "timestamp": "02:08:55", "text": "ああ、それはまずいですね。"}, {"type": "subtitle", "time": 7738.629, "timestamp": "02:08:58", "text": "赤いものみたい。"}]
[{"type": "subtitle", "time": 6365.03, "timestamp": "01:46:05", "text": "OBS の画質は低いと聞いています。   それは何て"}, {"type": "subtitle", "time": 6369.59, "timestamp": "01:46:09", "text": "言うんだっけ？"}, {"type": "subtitle", "time": 6370.55, "timestamp": "01:46:10", "text": "チューニングプリセット。"}, {"type": "subtitle", "time": 6373.03, "timestamp": "01:46:13", "text": "私のはひどい出来だ。"}, {"type": "subtitle", "time": 6373.669, "timestamp": "01:46:13", "text": "ああ、"}, {"type": "subtitle", "time": 6379.99, "timestamp": "01:46:19", "text": "ストリームとか、"}, {"type": "subtitle", "time": 6382.31, "timestamp": "01:46:22", "text": "オーケーとか、全部高いところに置いたよ。 ストリーム。 ストリーム。"}, {"type": "subtitle", "time": 6385.669, "timestamp": "01:46:25", "text": "ビットレートはどれくらいですか？"}, {"type": "subtitle", "time": 6388.87, "timestamp": "01:46:28", "text": "えっと、8Kだと思います。"}, {"type": "subtitle", "time": 6392.47, "timestamp": "01:46:32", "text": "次に設定です。"}, {"type": "subtitle", "time": 6393.27, "timestamp": "01:46:33", "text": "えっと、ちょっと待ってください。"}, {"type": "subtitle", "time": 6394.149, "timestamp": "01:46:34", "text": "何を入れたの？"}, {"type": "subtitle", "time": 6399.189, "timestamp": "01:46:39", "text": "ビットレートを8K"}, {"type": "subtitle", "time": 6402.39, "timestamp": "01:46:42", "text": "プリセットに設定します。 ええと、P5、品質は良いですね。 チューニングは、"}, {"type": "subtitle", "time": 6405.75, "timestamp": "01:46:45", "text": "高品質、マルチパスモード、2"}, {"type": "subtitle", "time": 6407.43, "timestamp": "01:46:47", "text": "パス、"}, {"type": "subtitle", "time": 6410.709, "timestamp": "01:46:50", "text": "プロファイル、高、ルックアヘッド。   わかった"}, {"type": "subtitle", "time": 6414.31, "timestamp": "01:46:54", "text": "。 うん。 うん、きっと良いよ。 しかし、"}, {"type": "subtitle", "time": 6415.35, "timestamp": "01:46:55", "text": "なぜ？"}, {"type": "subtitle", "time": 6418.87, "timestamp": "01:46:58", "text": "私はいつも見た目がひどいんです。"}]
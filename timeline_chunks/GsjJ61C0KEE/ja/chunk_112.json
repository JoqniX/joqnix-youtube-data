[{"type": "subtitle", "time": 6721.189, "timestamp": "01:52:01", "text": "メンテナンス施設か生物研究施設にある。"}, {"type": "subtitle", "time": 6724.55, "timestamp": "01:52:04", "text": "ああ、複雑だ。 わかった。 わかった。"}, {"type": "subtitle", "time": 6727.43, "timestamp": "01:52:07", "text": "でも、この中には中間的な立場の人たちもいるんです"}, {"type": "subtitle", "time": 6729.99, "timestamp": "01:52:09", "text": "。 彼らはただ"}, {"type": "subtitle", "time": 6732.47, "timestamp": "01:52:12", "text": "ロボットを撃っているだけだ。 彼らがどこにいるかは知らないが、"}, {"type": "subtitle", "time": 6736.87, "timestamp": "01:52:16", "text": "近くにいるなら私に電話して、"}, {"type": "subtitle", "time": 6745.75, "timestamp": "01:52:25", "text": "私はこの壁の前をもう7回通り過ぎた"}, {"type": "subtitle", "time": 6747.99, "timestamp": "01:52:27", "text": "。 ああ、私の車。"}, {"type": "subtitle", "time": 6754.47, "timestamp": "01:52:34", "text": "あ、こっちだよ。"}, {"type": "subtitle", "time": 6756.55, "timestamp": "01:52:36", "text": "待って、待って。 どう言えばいいですか？"}, {"type": "subtitle", "time": 6758.55, "timestamp": "01:52:38", "text": "撃たないでください。 私たちはただここにいるだけです。"}, {"type": "subtitle", "time": 6764.31, "timestamp": "01:52:44", "text": "この試合に友好的な要素はないんだ、ジョン。"}, {"type": "subtitle", "time": 6768.229, "timestamp": "01:52:48", "text": "おい、一体どういうことだ？ 来て。 どうか"}, {"type": "subtitle", "time": 6770.709, "timestamp": "01:52:50", "text": "私たちを撃たないでください。 私たちはただ、自分たちの"}]
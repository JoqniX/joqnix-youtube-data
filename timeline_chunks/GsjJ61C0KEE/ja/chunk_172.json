[{"type": "subtitle", "time": 10323.59, "timestamp": "02:52:03", "text": "溢れかえっている場所では、人々が争っている。"}, {"type": "subtitle", "time": 10325.67, "timestamp": "02:52:05", "text": "見てみて。"}, {"type": "subtitle", "time": 10328.149, "timestamp": "02:52:08", "text": "待って、待って、待って。"}, {"type": "subtitle", "time": 10343.429, "timestamp": "02:52:23", "text": "ボットだと"}, {"type": "subtitle", "time": 10346.55, "timestamp": "02:52:26", "text": "思う。 つまり、"}, {"type": "subtitle", "time": 10355.03, "timestamp": "02:52:35", "text": "ええ、彼らは誰かを撃っていました。"}, {"type": "subtitle", "time": 10356.87, "timestamp": "02:52:36", "text": "ルークである可能性もある。"}, {"type": "subtitle", "time": 10363.51, "timestamp": "02:52:43", "text": "どういうことだ？ 私はそれを拾わなければならなかった"}, {"type": "subtitle", "time": 10375.91, "timestamp": "02:52:55", "text": "どこですか？ うん。 ああ、ここにある。 ここにあります"}, {"type": "subtitle", "time": 10378.15, "timestamp": "02:52:58", "text": "。 これだよ。"}, {"type": "subtitle", "time": 10379.91, "timestamp": "02:52:59", "text": "次に、"}]
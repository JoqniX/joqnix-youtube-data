[{"type": "subtitle", "time": 3971.029, "timestamp": "01:06:11", "text": "。  tpingを停止してください。 くそったれ、これ。"}, {"type": "subtitle", "time": 3972.069, "timestamp": "01:06:12", "text": "ああ、神様。 ここ。"}, {"type": "subtitle", "time": 3975.67, "timestamp": "01:06:15", "text": "ああ、彼らはダッツだ。 わかった。"}, {"type": "subtitle", "time": 3977.27, "timestamp": "01:06:17", "text": "ここはどこですか"}, {"type": "subtitle", "time": 3977.99, "timestamp": "01:06:17", "text": "？"}, {"type": "subtitle", "time": 3984.95, "timestamp": "01:06:24", "text": "たくさんの良い戦利品を手に入れた。   忘れずに手に入れてください。"}, {"type": "subtitle", "time": 3986.87, "timestamp": "01:06:26", "text": "あ、ここに"}, {"type": "subtitle", "time": 3989.829, "timestamp": "01:06:29", "text": "あなたにとって重要なものがありますよ。"}, {"type": "subtitle", "time": 3996.069, "timestamp": "01:06:36", "text": "異常標本。 異常箇所から直接採取された標本"}, {"type": "subtitle", "time": 4000.39, "timestamp": "01:06:40", "text": "。 今、彼らは"}, {"type": "subtitle", "time": 4002.15, "timestamp": "01:06:42", "text": "慎重に、慎重に行動するかもしれない。 何かがあなたに向かって発砲している"}, {"type": "subtitle", "time": 4009.029, "timestamp": "01:06:49", "text": "1回ノックする。"}, {"type": "subtitle", "time": 4009.829, "timestamp": "01:06:49", "text": "おい、あそこに選手がいるぞ"}, {"type": "subtitle", "time": 4011.029, "timestamp": "01:06:51", "text": "。 ここだ。"}, {"type": "subtitle", "time": 4011.99, "timestamp": "01:06:51", "text": "うん。 うん。 うん。"}, {"type": "subtitle", "time": 4012.71, "timestamp": "01:06:52", "text": "ウィンドウ。"}, {"type": "subtitle", "time": 4015.829, "timestamp": "01:06:55", "text": "注意深い。 チームメイトが"}]
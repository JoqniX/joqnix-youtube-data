[{"type": "subtitle", "time": 13565.03, "timestamp": "03:46:05", "text": "待って、"}, {"type": "subtitle", "time": 13567.189, "timestamp": "03:46:07", "text": "ルームメイトが電話中だから、"}, {"type": "subtitle", "time": 13569.67, "timestamp": "03:46:09", "text": "ここで終わりにしないと。 ああ、でももう"}, {"type": "subtitle", "time": 13571.03, "timestamp": "03:46:11", "text": "配信は終わりました。"}, {"type": "subtitle", "time": 13573.11, "timestamp": "03:46:13", "text": "今日は来てくださった皆さん、ありがとうございました。それでは、"}, {"type": "subtitle", "time": 13575.91, "timestamp": "03:46:15", "text": "良い一日をお過ごしください。"}, {"type": "subtitle", "time": 13577.99, "timestamp": "03:46:17", "text": "次の配信でお会いしましょう。 わかった。 たぶん"}, {"type": "subtitle", "time": 13580.87, "timestamp": "03:46:20", "text": "4時間くらい配信したと思う。 これで"}, {"type": "subtitle", "time": 13605.03, "timestamp": "03:46:45", "text": "配信が終了します。"}, {"type": "subtitle", "time": 13607.03, "timestamp": "03:46:47", "text": "本日はありがとうございました。 バイバイ。"}]
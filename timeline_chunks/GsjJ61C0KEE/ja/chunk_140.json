[{"type": "subtitle", "time": 8406.79, "timestamp": "02:20:06", "text": "ああ、そうだったらいいのに"}, {"type": "subtitle", "time": 8412.63, "timestamp": "02:20:12", "text": "彼は宇宙ステーションにいる。"}, {"type": "subtitle", "time": 8413.51, "timestamp": "02:20:13", "text": "うん。  [笑い]"}, {"type": "subtitle", "time": 8419.67, "timestamp": "02:20:19", "text": "私たちはあなたの依頼を遂行できます。 準備はいいですか？"}, {"type": "subtitle", "time": 8423.03, "timestamp": "02:20:23", "text": "うん、準備はできてるよ。 君たちは"}, {"type": "subtitle", "time": 8425.11, "timestamp": "02:20:25", "text": "データ"}, {"type": "subtitle", "time": 8433.27, "timestamp": "02:20:33", "text": "単一の実行です。"}, {"type": "subtitle", "time": 8458.71, "timestamp": "02:20:58", "text": "えっと、じゃあ、もう一人の人を待ってください。"}, {"type": "subtitle", "time": 8458.87, "timestamp": "02:20:58", "text": "ああ、"}]
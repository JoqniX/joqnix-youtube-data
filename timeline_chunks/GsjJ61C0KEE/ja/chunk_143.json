[{"type": "subtitle", "time": 8580.07, "timestamp": "02:23:00", "text": "どのクエストですか？ あなたの目的が分かりません。   そうそう"}, {"type": "subtitle", "time": 8580.87, "timestamp": "02:23:00", "text": "。"}, {"type": "subtitle", "time": 8589.91, "timestamp": "02:23:09", "text": "このオレンジ色または黄色のアイコンは何ですか"}, {"type": "subtitle", "time": 8592.07, "timestamp": "02:23:12", "text": "？  K."}, {"type": "subtitle", "time": 8595.59, "timestamp": "02:23:15", "text": "そこがあなたの探求の場所です。"}, {"type": "subtitle", "time": 8600.71, "timestamp": "02:23:20", "text": "長方形のピンのようなものです。 黄色いピンですよね？"}, {"type": "subtitle", "time": 8603.91, "timestamp": "02:23:23", "text": "ええ、そこがあなたのクエストの舞台です。"}, {"type": "subtitle", "time": 8606.23, "timestamp": "02:23:26", "text": "あなたが操作する必要のあるもの。"}, {"type": "subtitle", "time": 8609.19, "timestamp": "02:23:29", "text": "ああ、またこれか。"}, {"type": "subtitle", "time": 8613.91, "timestamp": "02:23:33", "text": "ちょっと待ってください。 新鮮な。 私はただジャンプすればいいだけです。"}, {"type": "subtitle", "time": 8616.309, "timestamp": "02:23:36", "text": "私はただ登ればいいだけです。   わかった"}, {"type": "subtitle", "time": 8629.03, "timestamp": "02:23:49", "text": "では、下り坂はどこにあるのでしょうか？"}, {"type": "subtitle", "time": 8631.67, "timestamp": "02:23:51", "text": "ああ、これだ。 ああ、これのことか。"}, {"type": "subtitle", "time": 8634.07, "timestamp": "02:23:54", "text": "うん。 注意深い。 うん。 うん。 なぜなら、"}, {"type": "subtitle", "time": 8637.19, "timestamp": "02:23:57", "text": "あなたの探求のせいだ。 うん。 わかった。 入れるよ。あぁ、痛い"}]
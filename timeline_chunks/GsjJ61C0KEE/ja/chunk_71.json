[{"type": "subtitle", "time": 4265.75, "timestamp": "01:11:05", "text": "うん。 良い点は、自分が"}, {"type": "subtitle", "time": 4268.55, "timestamp": "01:11:08", "text": "倒されて完全に死んでしまった場合でも、チーム"}, {"type": "subtitle", "time": 4270.07, "timestamp": "01:11:10", "text": "メイトがまだ"}, {"type": "subtitle", "time": 4272.31, "timestamp": "01:11:12", "text": "生きていれば、彼らが"}, {"type": "subtitle", "time": 4273.59, "timestamp": "01:11:13", "text": "自分を蘇生してくれるということです。"}, {"type": "subtitle", "time": 4274.07, "timestamp": "01:11:14", "text": "ああ、"}, {"type": "subtitle", "time": 4277.99, "timestamp": "01:11:17", "text": "それは素晴らしいことだね。 うん。"}, {"type": "subtitle", "time": 4279.59, "timestamp": "01:11:19", "text": "面白い。"}, {"type": "subtitle", "time": 4281.51, "timestamp": "01:11:21", "text": "でも、もし全員が死んだら、"}, {"type": "subtitle", "time": 4302.87, "timestamp": "01:11:42", "text": "夜のものは今のところ少し"}, {"type": "subtitle", "time": 4304.87, "timestamp": "01:11:44", "text": "複雑なので、朝のものを試してみてください"}, {"type": "subtitle", "time": 4310.79, "timestamp": "01:11:50", "text": "多くのことがあって、"}, {"type": "subtitle", "time": 4317.189, "timestamp": "01:11:57", "text": "何？ どれ？ 最初のやつはどこ？"}, {"type": "subtitle", "time": 4319.43, "timestamp": "01:11:59", "text": "今のアイテムとか、そういうのが好きなんです。 何を"}]
[{"type": "subtitle", "time": 7410.56, "timestamp": "02:03:30", "text": "。 理由はわからないけど、ゲームがめちゃくちゃカクカクする"}, {"type": "subtitle", "time": 7412.48, "timestamp": "02:03:32", "text": "理由はわからないけど、ゲームがめちゃくちゃカクカクする 。"}, {"type": "subtitle", "time": 7419.109, "timestamp": "02:03:39", "text": "北に向かって銃撃が続いている。 おそらく、私が"}, {"type": "subtitle", "time": 7420.629, "timestamp": "02:03:40", "text": "配信しているからでしょう。"}, {"type": "subtitle", "time": 7428.79, "timestamp": "02:03:48", "text": "どこですか？ 下に行かせてください。"}, {"type": "subtitle", "time": 7432.31, "timestamp": "02:03:52", "text": "私は「オーマイゴッド」と言っています。"}, {"type": "subtitle", "time": 7433.109, "timestamp": "02:03:53", "text": "もちろん。"}, {"type": "subtitle", "time": 7434.39, "timestamp": "02:03:54", "text": "うん、行くよ。 今行ってる。"}, {"type": "subtitle", "time": 7437.83, "timestamp": "02:03:57", "text": "もちろん。 もちろん。 はぁ？ いつ入店されましたか"}]
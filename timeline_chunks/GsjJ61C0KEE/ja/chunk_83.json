[{"type": "subtitle", "time": 4981.03, "timestamp": "01:23:01", "text": "よし、じゃあ私のpingを見てみよう。 青いピング音。   とにかく"}, {"type": "subtitle", "time": 4983.11, "timestamp": "01:23:03", "text": "走ろう。"}, {"type": "subtitle", "time": 4996.39, "timestamp": "01:23:16", "text": "注意深い。 ああ、シールドを手に入れた。"}, {"type": "subtitle", "time": 4999.43, "timestamp": "01:23:19", "text": "お前は一体何のために"}, {"type": "subtitle", "time": 5001.91, "timestamp": "01:23:21", "text": "ゴツゴツした瓦礫をこっそり忍び寄るつもりなんだ？ 知っている。"}, {"type": "subtitle", "time": 5003.11, "timestamp": "01:23:23", "text": "ああ、シールドが尽きた。"}, {"type": "subtitle", "time": 5006.31, "timestamp": "01:23:26", "text": "それが俺の人生さ。"}, {"type": "subtitle", "time": 5008.229, "timestamp": "01:23:28", "text": "シールドが枯渇しました。 えっと、シールドはここにありますよ"}, {"type": "subtitle", "time": 5008.55, "timestamp": "01:23:28", "text": "。   ああ"}, {"type": "subtitle", "time": 5018.709, "timestamp": "01:23:38", "text": "どこにいるの？"}, {"type": "subtitle", "time": 5022.229, "timestamp": "01:23:42", "text": "私はまだここに閉じ込められています。   走ろう"}, {"type": "subtitle", "time": 5024.47, "timestamp": "01:23:44", "text": "。 覚えておいてください、"}, {"type": "subtitle", "time": 5026.79, "timestamp": "01:23:46", "text": "あなたはダッシュできます。 わかった。 つまり、ダッシュボードの"}, {"type": "subtitle", "time": 5036.79, "timestamp": "01:23:56", "text": "私が彼らの注意をそらします。 走ってもいいよ。"}]
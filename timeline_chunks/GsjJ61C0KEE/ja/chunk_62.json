[{"type": "subtitle", "time": 3723.43, "timestamp": "01:02:03", "text": "。 クレイジー。"}, {"type": "subtitle", "time": 3725.99, "timestamp": "01:02:05", "text": "知っている。 めちゃくちゃ怖い。"}, {"type": "subtitle", "time": 3733.109, "timestamp": "01:02:13", "text": "。 ここはどこ？ こちらへどうぞ。"}, {"type": "chat", "time": 3736.69, "timestamp": "01:02:16", "author": "@Rimuru_Is_back", "avatar": "https://yt4.ggpht.com/Ov-xx_7BHAX3v1nd3tVds0ubrKCgFfO1-m8NnRkGn7N22EZKy3pjflDuSanp5yuWT63ErzhmDE8=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/DfgfY9LaNdmMq7IPuI2AaAUCkszU2WH9gy1mb0dV-11UJg/DfgfY9LaNdmMq7IPuI2AaA"}, {"type": "subtitle", "time": 3739.67, "timestamp": "01:02:19", "text": "あのね？ あの男の後を追ってみよう。"}, {"type": "subtitle", "time": 3742.789, "timestamp": "01:02:22", "text": "あの男はあちこち飛び回っている。   ええ"}, {"type": "subtitle", "time": 3751.67, "timestamp": "01:02:31", "text": "もっと手に入れよう。"}, {"type": "subtitle", "time": 3755.75, "timestamp": "01:02:35", "text": "ああ、彼だ。 私はフォローしています。"}, {"type": "subtitle", "time": 3758.71, "timestamp": "01:02:38", "text": "ああ、ついてきてください。"}, {"type": "subtitle", "time": 3759.75, "timestamp": "01:02:39", "text": "ジャック、君は私について来ないつもりなのか？   そうそう"}, {"type": "subtitle", "time": 3760.549, "timestamp": "01:02:40", "text": "。 うん。"}, {"type": "subtitle", "time": 3761.99, "timestamp": "01:02:41", "text": "見知らぬ人を信用する。"}, {"type": "subtitle", "time": 3764.15, "timestamp": "01:02:44", "text": "ジャック、見知らぬ人を信用するのか？   よし"}, {"type": "subtitle", "time": 3764.549, "timestamp": "01:02:44", "text": "。"}, {"type": "subtitle", "time": 3767.829, "timestamp": "01:02:47", "text": "待って、なぜこれが良い戦利品なの"}, {"type": "subtitle", "time": 3770.47, "timestamp": "01:02:50", "text": "？ 時々そうなるけど、それでもやっぱり「一体何なんだ」って感じ"}, {"type": "subtitle", "time": 3775.91, "timestamp": "01:02:55", "text": "。"}, {"type": "subtitle", "time": 3777.51, "timestamp": "01:02:57", "text": "この地図はもう少し"}]
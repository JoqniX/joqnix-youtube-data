[{"type": "subtitle", "time": 3781.75, "timestamp": "01:03:01", "text": "詳細です。"}, {"type": "subtitle", "time": 3783.589, "timestamp": "01:03:03", "text": "倒したロボットごとに、"}, {"type": "subtitle", "time": 3786.069, "timestamp": "01:03:06", "text": "小さなミニカードがもらえます。"}, {"type": "subtitle", "time": 3788.63, "timestamp": "01:03:08", "text": "抽出作業やその他多くの作業に必要になります"}, {"type": "subtitle", "time": 3793.109, "timestamp": "01:03:13", "text": "。 だから、できるだけたくさん集めておいて。後で"}, {"type": "subtitle", "time": 3795.109, "timestamp": "01:03:15", "text": "必要になるから。"}, {"type": "subtitle", "time": 3797.029, "timestamp": "01:03:17", "text": "必要になるだろう。"}, {"type": "subtitle", "time": 3811.99, "timestamp": "01:03:31", "text": "？"}, {"type": "subtitle", "time": 3815.829, "timestamp": "01:03:35", "text": "ロボットの中には物を落とさないものもあるんですね。"}, {"type": "subtitle", "time": 3825.43, "timestamp": "01:03:45", "text": "彼らはどこにいますか？"}, {"type": "subtitle", "time": 3827.589, "timestamp": "01:03:47", "text": "消え去ったよりも。"}, {"type": "subtitle", "time": 3830.309, "timestamp": "01:03:50", "text": "よし、俺はあいつの首を殴った。"}]
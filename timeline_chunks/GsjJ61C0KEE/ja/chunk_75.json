[{"type": "subtitle", "time": 4517.27, "timestamp": "01:15:17", "text": "来る。 よし、これで何ができる？"}, {"type": "subtitle", "time": 4527.83, "timestamp": "01:15:27", "text": "あそこに人がいた。"}, {"type": "subtitle", "time": 4534.47, "timestamp": "01:15:34", "text": "よし、リロードしたいから、必要がないときは戦わないようにしよう"}, {"type": "subtitle", "time": 4540.39, "timestamp": "01:15:40", "text": "。 つまり、私の銃は"}, {"type": "subtitle", "time": 4548.87, "timestamp": "01:15:48", "text": "動けますか？"}, {"type": "subtitle", "time": 4552.229, "timestamp": "01:15:52", "text": "私は私です。前に進むこともできますが、"}, {"type": "subtitle", "time": 4556.31, "timestamp": "01:15:56", "text": "前に進むことはできません。しかし、私は前に飛び出しています。"}, {"type": "subtitle", "time": 4557.27, "timestamp": "01:15:57", "text": "くそっ。   私は"}]
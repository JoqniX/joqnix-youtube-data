[{"type": "subtitle", "time": 8641.27, "timestamp": "02:24:01", "text": "。 ああ、"}, {"type": "subtitle", "time": 8643.11, "timestamp": "02:24:03", "text": "あなたは死んでいなかったんですね。"}, {"type": "subtitle", "time": 8644.95, "timestamp": "02:24:04", "text": "うん。 私のものには気を付けて。 私のものには気を付けてね。"}, {"type": "subtitle", "time": 8650.79, "timestamp": "02:24:10", "text": "ええ、そこが座標です。 ここ。"}, {"type": "subtitle", "time": 8652.87, "timestamp": "02:24:12", "text": "これが、我々が命を捧げた理由だ。 注意深い。"}, {"type": "subtitle", "time": 8654.71, "timestamp": "02:24:14", "text": "注意深い。 ここ。 これだよ。"}, {"type": "subtitle", "time": 8658.55, "timestamp": "02:24:18", "text": "ああ、これだ。 うん。 うん。 うん。 うん。   本当にイライラする"}, {"type": "subtitle", "time": 8660.63, "timestamp": "02:24:20", "text": "。   わかった"}, {"type": "subtitle", "time": 8665.59, "timestamp": "02:24:25", "text": "。 あなたの探求の旅はどこにあるのですか？ さあ、行こう"}, {"type": "subtitle", "time": 8675.99, "timestamp": "02:24:35", "text": "ええと、その物、"}, {"type": "subtitle", "time": 8679.349, "timestamp": "02:24:39", "text": "貨物か何か、とにかく、目を離さないようにしてください。"}, {"type": "subtitle", "time": 8681.349, "timestamp": "02:24:41", "text": "うん。 えっと、こっちにあるはずです。 近くのコンテナをスキャンしてください"}, {"type": "subtitle", "time": 8683.75, "timestamp": "02:24:43", "text": "。 この辺りのどこか"}, {"type": "subtitle", "time": 8684.469, "timestamp": "02:24:44", "text": "。"}, {"type": "subtitle", "time": 8694.87, "timestamp": "02:24:54", "text": "近くのコンテナをスキャンしてください。 どうやって？   えっと"}, {"type": "subtitle", "time": 8697.51, "timestamp": "02:24:57", "text": "、ピンク色を探してください。"}, {"type": "subtitle", "time": 8699.83, "timestamp": "02:24:59", "text": "あなたが見た黄色のピン。 確かこの辺りだったと思う"}]
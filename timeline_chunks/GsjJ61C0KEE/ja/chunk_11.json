[{"type": "subtitle", "time": 661.99, "timestamp": "00:11:01", "text": "。 今回初めて"}, {"type": "subtitle", "time": 664.069, "timestamp": "00:11:04", "text": "マラソンをプレイするので、とても楽しみです"}, {"type": "subtitle", "time": 665.829, "timestamp": "00:11:05", "text": "。"}, {"type": "subtitle", "time": 670.87, "timestamp": "00:11:10", "text": "そして、えーと、ちょうどfujの攻撃が"}, {"type": "subtitle", "time": 674.79, "timestamp": "00:11:14", "text": "ベーコンをここに置いた。 チャット"}, {"type": "subtitle", "time": 678.23, "timestamp": "00:11:18", "text": "全体がひどく粗雑だ。 私はそれを知っている。 何てことだ"}, {"type": "subtitle", "time": 705.03, "timestamp": "00:11:45", "text": "ああ、そうそう、ゲームはこの段階で止まっていたんだ"}, {"type": "subtitle", "time": 714.47, "timestamp": "00:11:54", "text": "、確かに動かなくなってたよ。 このまま身動きが取れない。"}, {"type": "subtitle", "time": 718.949, "timestamp": "00:11:58", "text": "土尾、1秒。"}]
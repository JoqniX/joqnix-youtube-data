[{"type": "subtitle", "time": 5764.149, "timestamp": "01:36:04", "text": "無料キットを使っている自分がいる。 それはいいですね。"}, {"type": "subtitle", "time": 5768.39, "timestamp": "01:36:08", "text": "ええ、無制限のロードアウトです。"}, {"type": "subtitle", "time": 5773.35, "timestamp": "01:36:13", "text": "3人組ではない。 待って、"}, {"type": "subtitle", "time": 5774.87, "timestamp": "01:36:14", "text": "オーケーはない。"}, {"type": "subtitle", "time": 5777.43, "timestamp": "01:36:17", "text": "トリオ編成ですね。"}, {"type": "subtitle", "time": 5779.669, "timestamp": "01:36:19", "text": "そう、そのデュオは"}, {"type": "subtitle", "time": 5781.189, "timestamp": "01:36:21", "text": "期間限定みたいなものだ。  H."}, {"type": "subtitle", "time": 5783.27, "timestamp": "01:36:23", "text": "通常は、接続"}, {"type": "subtitle", "time": 5784.95, "timestamp": "01:36:24", "text": "に"}, {"type": "subtitle", "time": 5793.03, "timestamp": "01:36:33", "text": "なんてこった？   はい"}, {"type": "subtitle", "time": 5794.87, "timestamp": "01:36:34", "text": "、もう一度試してください。"}, {"type": "subtitle", "time": 5797.43, "timestamp": "01:36:37", "text": "はい。"}, {"type": "subtitle", "time": 5801.75, "timestamp": "01:36:41", "text": "そうでない場合は、"}, {"type": "subtitle", "time": 5804.149, "timestamp": "01:36:44", "text": "接続設定をもう少し早い段階で行ってください。 ああ"}, {"type": "subtitle", "time": 5812.149, "timestamp": "01:36:52", "text": "それは良くない。 私は、トキは日本のような"}, {"type": "subtitle", "time": 5814.709, "timestamp": "01:36:54", "text": "先進国で、"}, {"type": "subtitle", "time": 5817.35, "timestamp": "01:36:57", "text": "サービスなども充実していると思っていましたが、"}, {"type": "subtitle", "time": 5819.83, "timestamp": "01:36:59", "text": "これは一体何なのでしょうか？"}]
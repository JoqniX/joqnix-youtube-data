[{"type": "subtitle", "time": 2522.95, "timestamp": "00:42:02", "text": "メルを閉じます。 メルは正しいやり方ではない。"}, {"type": "subtitle", "time": 2526.55, "timestamp": "00:42:06", "text": "道は明白だ。"}, {"type": "subtitle", "time": 2528.87, "timestamp": "00:42:08", "text": "よし、行こう。 私はどこまで話したっけ？ ああ、今ははるかに"}, {"type": "subtitle", "time": 2531.67, "timestamp": "00:42:11", "text": "良くなった。 何？"}, {"type": "subtitle", "time": 2535.03, "timestamp": "00:42:15", "text": "目標達成失敗。"}, {"type": "subtitle", "time": 2537.109, "timestamp": "00:42:17", "text": "何？"}, {"type": "subtitle", "time": 2538.79, "timestamp": "00:42:18", "text": "これを私のために落としてくれたの？ はい、ありがとうございます"}, {"type": "subtitle", "time": 2540.63, "timestamp": "00:42:20", "text": "。"}, {"type": "subtitle", "time": 2542.87, "timestamp": "00:42:22", "text": "それは良い盾だ。"}, {"type": "subtitle", "time": 2545.589, "timestamp": "00:42:25", "text": "はい、どうやらあなたのクエストは"}, {"type": "subtitle", "time": 2548.47, "timestamp": "00:42:28", "text": "期限切れのようです。 私たちはまだ"}, {"type": "subtitle", "time": 2551.75, "timestamp": "00:42:31", "text": "任務を遂行しに行くことができる。 私の探求は実はここです。"}, {"type": "subtitle", "time": 2553.03, "timestamp": "00:42:33", "text": "警戒を怠らないように。"}, {"type": "subtitle", "time": 2556.79, "timestamp": "00:42:36", "text": "うん。 そうそう。 それから、この"}, {"type": "subtitle", "time": 2562.39, "timestamp": "00:42:42", "text": "座標データパッドと呼ばれるものも持っています。 それを拾ってください。   わかった"}, {"type": "subtitle", "time": 2563.03, "timestamp": "00:42:43", "text": "。"}, {"type": "subtitle", "time": 2564.79, "timestamp": "00:42:44", "text": "つまり、これが2つ必要なんです。 次はあちらです"}, {"type": "subtitle", "time": 2566.79, "timestamp": "00:42:46", "text": "。   私の"}, {"type": "subtitle", "time": 2572.39, "timestamp": "00:42:52", "text": "目的の場所からすぐ近くだ。 えっと、そのカードが2枚必要で、"}, {"type": "subtitle", "time": 2574.63, "timestamp": "00:42:54", "text": "そうすると"}, {"type": "subtitle", "time": 2576.47, "timestamp": "00:42:56", "text": "たくさんの"}, {"type": "subtitle", "time": 2579.99, "timestamp": "00:42:59", "text": "戦利品がある場所が出現します。 略奪できる。 だから"}]
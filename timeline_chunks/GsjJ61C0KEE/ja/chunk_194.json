[{"type": "subtitle", "time": 11642.87, "timestamp": "03:14:02", "text": "彼らが持っている事前準備のようなものだ。"}, {"type": "subtitle", "time": 11644.63, "timestamp": "03:14:04", "text": "つまり、各"}, {"type": "subtitle", "time": 11647.99, "timestamp": "03:14:07", "text": "派閥にはそれぞれ独自の"}, {"type": "subtitle", "time": 11650.87, "timestamp": "03:14:10", "text": "スポーン回路があります。"}, {"type": "subtitle", "time": 11651.67, "timestamp": "03:14:11", "text": "ああ、誰かね。"}, {"type": "subtitle", "time": 11659.349, "timestamp": "03:14:19", "text": "ああ、神様、私は死にそうです。   一体"}, {"type": "subtitle", "time": 11670.469, "timestamp": "03:14:30", "text": "ああ、やばい、ここにチームがいる。"}, {"type": "subtitle", "time": 11671.99, "timestamp": "03:14:31", "text": "君たちが撮影しているのかと思ったよ。"}, {"type": "subtitle", "time": 11673.19, "timestamp": "03:14:33", "text": "チームがある。   あった。"}, {"type": "subtitle", "time": 11676.15, "timestamp": "03:14:36", "text": "うん。 うん。 この"}, {"type": "subtitle", "time": 11677.11, "timestamp": "03:14:37", "text": "チームの一人として"}, {"type": "subtitle", "time": 11679.91, "timestamp": "03:14:39", "text": "。"}, {"type": "subtitle", "time": 11694.469, "timestamp": "03:14:54", "text": "あぁ、パソコンが動かなくなってしまった。"}, {"type": "subtitle", "time": 11697.83, "timestamp": "03:14:57", "text": "私は凍っているの？"}]
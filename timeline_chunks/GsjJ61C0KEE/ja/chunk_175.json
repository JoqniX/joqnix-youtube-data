[{"type": "subtitle", "time": 10517.83, "timestamp": "02:55:17", "text": "ああ、くそ。 黄金のボットがここにいる。"}, {"type": "subtitle", "time": 10526.87, "timestamp": "02:55:26", "text": "えっと、死体から物資を漁ればいいんです。"}, {"type": "subtitle", "time": 10551.91, "timestamp": "02:55:51", "text": "ここですね。"}, {"type": "subtitle", "time": 10558.389, "timestamp": "02:55:58", "text": "遺体の中に、あの、煙幕"}]
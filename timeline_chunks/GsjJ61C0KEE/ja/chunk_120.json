[{"type": "subtitle", "time": 7206.55, "timestamp": "02:00:06", "text": "。そう、状況によるんだ。"}, {"type": "subtitle", "time": 7208.149, "timestamp": "02:00:08", "text": "彼らは最高の、えっと、"}, {"type": "subtitle", "time": 7214.07, "timestamp": "02:00:14", "text": "これを何て言うんだっけ？"}, {"type": "subtitle", "time": 7216.629, "timestamp": "02:00:16", "text": "回復とか、シールドみたいな感じですね"}, {"type": "subtitle", "time": 7218.95, "timestamp": "02:00:18", "text": "。"}, {"type": "subtitle", "time": 7220.87, "timestamp": "02:00:20", "text": "ええ、状況によりますね。 例えば、"}, {"type": "subtitle", "time": 7222.07, "timestamp": "02:00:22", "text": "回復が必要な時は、"}, {"type": "subtitle", "time": 7223.589, "timestamp": "02:00:23", "text": "回復させてくれるでしょう。"}, {"type": "subtitle", "time": 7225.589, "timestamp": "02:00:25", "text": "回復が終わると、自動的に"}, {"type": "subtitle", "time": 7227.669, "timestamp": "02:00:27", "text": "シールドが付与されます。 そんな感じですね。"}, {"type": "subtitle", "time": 7230.47, "timestamp": "02:00:30", "text": "ちなみに、彼らは"}, {"type": "subtitle", "time": 7232.229, "timestamp": "02:00:32", "text": "ゲームについて話しているんです。"}, {"type": "subtitle", "time": 7233.189, "timestamp": "02:00:33", "text": "何？"}, {"type": "subtitle", "time": 7234.55, "timestamp": "02:00:34", "text": "これはどうでしょう？"}, {"type": "subtitle", "time": 7236.39, "timestamp": "02:00:36", "text": "はぁ？ ゲーム内で会話する。"}, {"type": "subtitle", "time": 7238.95, "timestamp": "02:00:38", "text": "あれ、私まだゲーム内で話してるの？"}, {"type": "subtitle", "time": 7240.79, "timestamp": "02:00:40", "text": "いいえ、あなたはもう終わりです。 うん。 うん。 いやいや、"}, {"type": "subtitle", "time": 7242.31, "timestamp": "02:00:42", "text": "君は行き詰まっているんだ。   何てことだ"}, {"type": "subtitle", "time": 7244.149, "timestamp": "02:00:44", "text": "。 私はずっと"}, {"type": "subtitle", "time": 7250.79, "timestamp": "02:00:50", "text": "待って、チームはあなた自身に勝つつもりなの？"}]
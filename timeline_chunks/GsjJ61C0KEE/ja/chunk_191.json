[{"type": "subtitle", "time": 11473.429, "timestamp": "03:11:13", "text": "うん、正直言って、高価なものは買わない方がいいと思う"}, {"type": "subtitle", "time": 11476.79, "timestamp": "03:11:16", "text": "。"}, {"type": "subtitle", "time": 11484.23, "timestamp": "03:11:24", "text": "めちゃくちゃ近いよ。 その距離からだと、3メートルにも満たない"}, {"type": "subtitle", "time": 11488.469, "timestamp": "03:11:28", "text": "。"}, {"type": "subtitle", "time": 11491.83, "timestamp": "03:11:31", "text": "それから2メートル。"}, {"type": "subtitle", "time": 11493.75, "timestamp": "03:11:33", "text": "うん。  2メートル。 うん。  2メートル。"}, {"type": "subtitle", "time": 11505.99, "timestamp": "03:11:45", "text": "なぜ"}, {"type": "subtitle", "time": 11506.79, "timestamp": "03:11:46", "text": "あの部屋の値段はあんなに安いんだろう？"}, {"type": "subtitle", "time": 11508.87, "timestamp": "03:11:48", "text": "寮の各部屋には、それぞれ"}, {"type": "subtitle", "time": 11511.91, "timestamp": "03:11:51", "text": "別のアルファベットが割り当てられています。"}, {"type": "subtitle", "time": 11512.55, "timestamp": "03:11:52", "text": "はい。"}, {"type": "subtitle", "time": 11514.309, "timestamp": "03:11:54", "text": "くそ。   わかった"}]
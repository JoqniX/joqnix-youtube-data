[{"type": "subtitle", "time": 615.43, "timestamp": "00:10:15", "text": "そうだね。"}, {"type": "subtitle", "time": 619.829, "timestamp": "00:10:19", "text": "こんにちは、みんな。 こんにちは。 こんにちは。"}, {"type": "subtitle", "time": 621.99, "timestamp": "00:10:21", "text": "こんにちは、みんな。 はい、私はここにいません。"}, {"type": "subtitle", "time": 624.47, "timestamp": "00:10:24", "text": "何？ なぜ？ こんにちは、みんな。 今日は"}, {"type": "subtitle", "time": 627.19, "timestamp": "00:10:27", "text": "Baconさんとコラボ配信をして、"}, {"type": "subtitle", "time": 630.23, "timestamp": "00:10:30", "text": "一緒にマラソンゲームをプレイします。 ええ、どうぞお"}, {"type": "subtitle", "time": 632.949, "timestamp": "00:10:32", "text": "楽しみください。 今日は"}, {"type": "subtitle", "time": 635.829, "timestamp": "00:10:35", "text": "ベーコンと一緒に過ごしましょう。 うん。 こんにちは。 傷だらけで申し訳ない"}, {"type": "subtitle", "time": 650.79, "timestamp": "00:10:50", "text": "また、ベーコンも"}, {"type": "subtitle", "time": 654.87, "timestamp": "00:10:54", "text": "自分の側から配信しています。 ですから、彼の最期もぜひご覧ください"}]
[{"type": "subtitle", "time": 12906.55, "timestamp": "03:35:06", "text": "、えっと、ああ、くそ。 見てみましょう。   馬鹿げた"}, {"type": "subtitle", "time": 12910.63, "timestamp": "03:35:10", "text": "塔なんてどこにも見当たらないよ。"}, {"type": "subtitle", "time": 12913.67, "timestamp": "03:35:13", "text": "タワーを見つけなければ、"}, {"type": "subtitle", "time": 12916.55, "timestamp": "03:35:16", "text": "Xを"}, {"type": "subtitle", "time": 12920.63, "timestamp": "03:35:20", "text": "埋める場所を自動的に特定してくれません。 そういう仕組みなんですか？   そう思います。"}, {"type": "subtitle", "time": 12928.15, "timestamp": "03:35:28", "text": "各場所にはタワーが1つずつ設置されるべきです"}, {"type": "subtitle", "time": 12928.79, "timestamp": "03:35:28", "text": "。"}, {"type": "subtitle", "time": 12932.15, "timestamp": "03:35:32", "text": "私たちはどこへ行けばいいのでしょうか？   わかった"}, {"type": "subtitle", "time": 12933.59, "timestamp": "03:35:33", "text": "。 ええ、実は"}, {"type": "subtitle", "time": 12947.99, "timestamp": "03:35:47", "text": "残る。   では、"}, {"type": "subtitle", "time": 12949.11, "timestamp": "03:35:49", "text": "私たちはどこへ行けばいいのでしょうか？"}, {"type": "subtitle", "time": 12951.349, "timestamp": "03:35:51", "text": "つまり、"}, {"type": "subtitle", "time": 12953.349, "timestamp": "03:35:53", "text": "時間がなくなっても、まだ1分"}, {"type": "subtitle", "time": 12955.349, "timestamp": "03:35:55", "text": "余分にあるということだ。"}, {"type": "subtitle", "time": 12956.55, "timestamp": "03:35:56", "text": "最後の"}, {"type": "subtitle", "time": 12959.59, "timestamp": "03:35:59", "text": "延長戦。"}]
[{"type": "subtitle", "time": 8821.349, "timestamp": "02:27:01", "text": "待って、私死にそう。 おいで、おいで、おいで、おいで、"}, {"type": "subtitle", "time": 8822.95, "timestamp": "02:27:02", "text": "私のところへおいで。 私は死にかけている。 私は死にかけている。 死ぬ、"}, {"type": "subtitle", "time": 8825.03, "timestamp": "02:27:05", "text": "死ぬ、死ぬ、死ぬ。"}, {"type": "subtitle", "time": 8826.07, "timestamp": "02:27:06", "text": "ジャンプ、ジャンプ、ジャンプ、おいで、おいで。"}, {"type": "subtitle", "time": 8831.51, "timestamp": "02:27:11", "text": "その地域に異常なエネルギーの亀裂が生じた。"}, {"type": "subtitle", "time": 8833.11, "timestamp": "02:27:13", "text": "ああ、"}, {"type": "subtitle", "time": 8835.349, "timestamp": "02:27:15", "text": "それらはまるで新品のようだ。 彼らは"}, {"type": "subtitle", "time": 8838.15, "timestamp": "02:27:18", "text": "私が撮影するのを待っているかのように、こっそり顔を出しているんだと思う。"}, {"type": "subtitle", "time": 8839.51, "timestamp": "02:27:19", "text": "彼らはまるで新しい"}, {"type": "subtitle", "time": 8841.11, "timestamp": "02:27:21", "text": "人たちみたいだと思うよ。"}, {"type": "subtitle", "time": 8842.79, "timestamp": "02:27:22", "text": "ああ、見て。 青い盾を持った男が一人いるんだけど"}, {"type": "subtitle", "time": 8852.71, "timestamp": "02:27:32", "text": "おお、ツインタップ。   それを"}, {"type": "subtitle", "time": 8857.59, "timestamp": "02:27:37", "text": "掴みます。 それを掴みます。"}, {"type": "subtitle", "time": 8858.469, "timestamp": "02:27:38", "text": "ああ、くそ。   何てことだ"}, {"type": "subtitle", "time": 8867.59, "timestamp": "02:27:47", "text": "おい、この野郎。 くそったれ。   なんてこった"}, {"type": "subtitle", "time": 8868.469, "timestamp": "02:27:48", "text": "。"}, {"type": "subtitle", "time": 8870.87, "timestamp": "02:27:50", "text": "紫色の銃。"}, {"type": "subtitle", "time": 8872.389, "timestamp": "02:27:52", "text": "残り20分。"}, {"type": "subtitle", "time": 8874.469, "timestamp": "02:27:54", "text": "私は紫色の銃を手に入れた。"}, {"type": "subtitle", "time": 8876.63, "timestamp": "02:27:56", "text": "うん、私も。"}, {"type": "subtitle", "time": 8876.95, "timestamp": "02:27:56", "text": "クレイジー。"}, {"type": "subtitle", "time": 8878.95, "timestamp": "02:27:58", "text": "あなたの銃はどれですか？"}]
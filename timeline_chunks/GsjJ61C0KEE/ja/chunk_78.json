[{"type": "subtitle", "time": 4681.99, "timestamp": "01:18:01", "text": "接続するつもりですか？ ああ、すぐ近くですね"}, {"type": "subtitle", "time": 4684.31, "timestamp": "01:18:04", "text": "。 文字通りすぐ近くです。   すぐそこにあるよ"}, {"type": "subtitle", "time": 4686.709, "timestamp": "01:18:06", "text": "。"}, {"type": "subtitle", "time": 4690.55, "timestamp": "01:18:10", "text": "ええと、2メートルのケーブルで十分だと思います"}, {"type": "subtitle", "time": 4690.87, "timestamp": "01:18:10", "text": "。"}, {"type": "subtitle", "time": 4697.669, "timestamp": "01:18:17", "text": "でも、どれを買えばいいのか迷っています。"}, {"type": "subtitle", "time": 4700.47, "timestamp": "01:18:20", "text": "今ではケーブルにもいろいろな種類がある。"}, {"type": "subtitle", "time": 4702.95, "timestamp": "01:18:22", "text": "カテゴリー6、カテゴリー5。どっちでもいいよ"}, {"type": "subtitle", "time": 4705.669, "timestamp": "01:18:25", "text": "。"}, {"type": "subtitle", "time": 4706.63, "timestamp": "01:18:26", "text": "正直言って、何でもいいんです。"}, {"type": "subtitle", "time": 4709.59, "timestamp": "01:18:29", "text": "あなたにとって物事をより簡単にします。 ノート"}, {"type": "subtitle", "time": 4713.03, "timestamp": "01:18:33", "text": "パソコンの"}, {"type": "subtitle", "time": 4716.709, "timestamp": "01:18:36", "text": "対応機種を確認してから購入します。"}, {"type": "subtitle", "time": 4719.91, "timestamp": "01:18:39", "text": "ええ、周囲にチームがいたので"}, {"type": "subtitle", "time": 4722.07, "timestamp": "01:18:42", "text": "気を付けてください。 彼らがどこへ行ったのか、私には分かりません"}]
[{"type": "subtitle", "time": 7818.069, "timestamp": "02:10:18", "text": "好的，我到了。  砲塔在哪裡？  就在灌木叢裡。  在哪裡？哦，在哪裡？  我的天啊，它竟然在這該死的灌木叢裡！  [笑聲] 我們"}, {"type": "subtitle", "time": 7820.95, "timestamp": "02:10:20", "text": "來做些"}, {"type": "subtitle", "time": 7828.149, "timestamp": "02:10:28", "text": "什麼吧。嗯，呃，"}, {"type": "subtitle", "time": 7847.51, "timestamp": "02:10:47", "text": "遊戲裡要不要把我"}, {"type": "subtitle", "time": 7855.589, "timestamp": "02:10:55", "text": "靜音？或者我們應該和旁邊這位玩家說話嗎？他是職業選手嗎？  我不這麼認為。  你怎麼認為？"}]
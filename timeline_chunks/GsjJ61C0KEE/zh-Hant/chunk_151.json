[{"type": "subtitle", "time": 9060.79, "timestamp": "02:31:00", "text": "異常能量裂縫。"}, {"type": "subtitle", "time": 9072.23, "timestamp": "02:31:12", "text": "哦，這些東西跟新的一樣。我覺得它們只是故意探出頭來讓我"}, {"type": "subtitle", "time": 9073.91, "timestamp": "02:31:13", "text": "拍攝。  我非常確定他們就像新來的"}, {"type": "subtitle", "time": 9085.11, "timestamp": "02:31:25", "text": "人一樣。"}, {"type": "subtitle", "time": 9087.03, "timestamp": "02:31:27", "text": "哦，瞧。有一個人拿著藍色盾牌，所以我不知道"}, {"type": "subtitle", "time": 9090.63, "timestamp": "02:31:30", "text": "他在哪裡。  哦，雙擊。  我把它拿走了"}, {"type": "subtitle", "time": 9094.87, "timestamp": "02:31:34", "text": "。我把它拿走了。  媽的。  我的天啊。愚蠢的。"}, {"type": "subtitle", "time": 9098.71, "timestamp": "02:31:38", "text": "嘿，你這混蛋。把"}, {"type": "subtitle", "time": 9113.59, "timestamp": "02:31:53", "text": "我的東西丟掉。  我的天哪。  一把紫色的槍。  還剩20分鐘。  我得到了一把紫色的槍"}]
[{"type": "subtitle", "time": 661.99, "timestamp": "00:11:01", "text": "好的。這是我第一次玩"}, {"type": "subtitle", "time": 664.069, "timestamp": "00:11:04", "text": "馬拉松遊戲，所以我非常興奮"}, {"type": "subtitle", "time": 665.829, "timestamp": "00:11:05", "text": "。"}, {"type": "subtitle", "time": 670.87, "timestamp": "00:11:10", "text": "呃，富士山攻擊事件發生後，把"}, {"type": "subtitle", "time": 674.79, "timestamp": "00:11:14", "text": "培根放在這裡了。聊天記錄"}, {"type": "subtitle", "time": 678.23, "timestamp": "00:11:18", "text": "太糟糕了。我知道這。"}, {"type": "subtitle", "time": 705.03, "timestamp": "00:11:45", "text": "哦，對，遊戲就卡在這個"}, {"type": "subtitle", "time": 714.47, "timestamp": "00:11:54", "text": "哦，是的，它卡住了。就這樣卡住了。"}, {"type": "subtitle", "time": 718.949, "timestamp": "00:11:58", "text": "Doio，一秒鐘。"}]
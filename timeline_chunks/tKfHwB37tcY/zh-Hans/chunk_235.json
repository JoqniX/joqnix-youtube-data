[{"type": "subtitle", "time": 14101.349, "timestamp": "03:55:01", "text": "敌方队伍里的另一个月夜，他们输掉比赛就是因为"}, {"type": "subtitle", "time": 14105.15, "timestamp": "03:55:05", "text": "敌方队伍里有他。   我的"}, {"type": "subtitle", "time": 14119.51, "timestamp": "03:55:19", "text": "？ 我向上帝发誓，这家伙又"}, {"type": "subtitle", "time": 14123.389, "timestamp": "03:55:23", "text": "搞砸了。 我的"}, {"type": "subtitle", "time": 14125.63, "timestamp": "03:55:25", "text": "天哪。 我"}, {"type": "subtitle", "time": 14131.269, "timestamp": "03:55:31", "text": "的天哪，我的天哪！"}, {"type": "subtitle", "time": 14132.75, "timestamp": "03:55:32", "text": "看到这样的事情真令人难过"}, {"type": "subtitle", "time": 14136.07, "timestamp": "03:55:36", "text": "。 那可真让人难过，跟我的情况完全不一样，伙计们。"}, {"type": "subtitle", "time": 14138.87, "timestamp": "03:55:38", "text": "哦，我现在可以给你看了。 我们可以看到，"}, {"type": "subtitle", "time": 14144.429, "timestamp": "03:55:44", "text": "那张照片里我也输了两三局"}, {"type": "subtitle", "time": 14147.189, "timestamp": "03:55:47", "text": "。 好的。 好的。 他们有一颗"}, {"type": "subtitle", "time": 14149.309, "timestamp": "03:55:49", "text": "钻石，我们也有一颗"}, {"type": "subtitle", "time": 14154.349, "timestamp": "03:55:54", "text": "钻石。 那真是太好了"}, {"type": "subtitle", "time": 14156.79, "timestamp": "03:55:56", "text": "。 我们队里有个奇怪的球员。 我们队里"}, {"type": "subtitle", "time": 14159.63, "timestamp": "03:55:59", "text": "也有一位蜘蛛侠玩家"}]
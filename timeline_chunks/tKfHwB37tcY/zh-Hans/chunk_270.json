[{"type": "subtitle", "time": 16200.389, "timestamp": "04:30:00", "text": "老兄，太搞笑了。 我觉得钢铁侠正在"}, {"type": "subtitle", "time": 16201.83, "timestamp": "04:30:01", "text": "等着我出击。 我要"}, {"type": "subtitle", "time": 16207.11, "timestamp": "04:30:07", "text": "保留我的跳跃机会。 钢铁侠。 我是冰箱男。"}, {"type": "subtitle", "time": 16209.389, "timestamp": "04:30:09", "text": "哦，她把"}, {"type": "subtitle", "time": 16213.99, "timestamp": "04:30:13", "text": "磁力士酒吧给毁了。 我的天哪。 我们有赢家了。"}, {"type": "subtitle", "time": 16217.269, "timestamp": "04:30:17", "text": "拽他屁股。 好的。"}, {"type": "subtitle", "time": 16220.149, "timestamp": "04:30:20", "text": "万磁王。 万磁王"}, {"type": "subtitle", "time": 16221.91, "timestamp": "04:30:21", "text": "死了。"}, {"type": "subtitle", "time": 16224.469, "timestamp": "04:30:24", "text": "嘿，我也不知道为什么。 好的。 我也"}, {"type": "subtitle", "time": 16227.349, "timestamp": "04:30:27", "text": "认为万磁王是一个塑造得很好的"}, {"type": "subtitle", "time": 16229.91, "timestamp": "04:30:29", "text": "角色。 他真是个很沉稳的人。"}, {"type": "subtitle", "time": 16231.67, "timestamp": "04:30:31", "text": "胜利。 是的，他很厉害。 他挺"}, {"type": "subtitle", "time": 16234.79, "timestamp": "04:30:34", "text": "不错的。 那些向"}, {"type": "subtitle", "time": 16239.269, "timestamp": "04:30:39", "text": "你扔球的人就像是平衡体，"}, {"type": "subtitle", "time": 16241.91, "timestamp": "04:30:41", "text": "好吧，伙计。"}, {"type": "subtitle", "time": 16244.229, "timestamp": "04:30:44", "text": "西格玛会向你扔小球。 马格南会向"}, {"type": "subtitle", "time": 16247.03, "timestamp": "04:30:47", "text": "你扔大球。 是的，"}, {"type": "subtitle", "time": 16249.83, "timestamp": "04:30:49", "text": "差不多。 嗯。 差不多就是这样"}, {"type": "subtitle", "time": 16252.149, "timestamp": "04:30:52", "text": "。   我的"}, {"type": "subtitle", "time": 16255.87, "timestamp": "04:30:55", "text": "天哪。 哦，我不知道。如果我得了"}, {"type": "subtitle", "time": 16257.55, "timestamp": "04:30:57", "text": "29分，"}]
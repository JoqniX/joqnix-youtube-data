[{"type": "subtitle", "time": 15421.189, "timestamp": "04:17:01", "text": "不。所以，现在的情况基本上"}, {"type": "subtitle", "time": 15423.11, "timestamp": "04:17:03", "text": "是所有治疗者都不玩"}, {"type": "subtitle", "time": 15424.71, "timestamp": "04:17:04", "text": "治疗职业了。 所有主玩治疗的玩家都不"}, {"type": "subtitle", "time": 15426.389, "timestamp": "04:17:06", "text": "玩治疗，他们就像是"}, {"type": "subtitle", "time": 15429.03, "timestamp": "04:17:09", "text": "切换到蜘蛛侠、鹰眼之类的角色，"}, {"type": "subtitle", "time": 15432.149, "timestamp": "04:17:12", "text": "让输出职业去玩治疗。 嗯？"}, {"type": "subtitle", "time": 15435.51, "timestamp": "04:17:15", "text": "事情就是这样。 什么？"}, {"type": "subtitle", "time": 15437.11, "timestamp": "04:17:17", "text": "这就是为什么我现在不在欧盟服务器的原因"}, {"type": "subtitle", "time": 15438.469, "timestamp": "04:17:18", "text": "，因为我不想处理那些破事"}, {"type": "subtitle", "time": 15441.269, "timestamp": "04:17:21", "text": "。 我负责处理这件事。 好吧，"}, {"type": "subtitle", "time": 15445.51, "timestamp": "04:17:25", "text": "有道理。 我的天哪……你"}, {"type": "subtitle", "time": 15447.75, "timestamp": "04:17:27", "text": "又是什么意思？"}, {"type": "subtitle", "time": 15449.99, "timestamp": "04:17:29", "text": "我玩万磁王，但现在所有治疗角色我都玩"}, {"type": "subtitle", "time": 15457.03, "timestamp": "04:17:37", "text": "啊，主要是万磁王。 我感觉我"}, {"type": "subtitle", "time": 15459.59, "timestamp": "04:17:39", "text": "基本上就是……为什么我们……呃……我忘了"}, {"type": "subtitle", "time": 15467.189, "timestamp": "04:17:47", "text": "艾玛·弗罗斯特。"}, {"type": "subtitle", "time": 15473.349, "timestamp": "04:17:53", "text": "本人。 她甚至算不上一个好"}, {"type": "subtitle", "time": 15475.03, "timestamp": "04:17:55", "text": "角色，但每个人都"}, {"type": "subtitle", "time": 15478.389, "timestamp": "04:17:58", "text": "因为她那该死的皮肤而选择扮演她。"}]
[{"type": "subtitle", "time": 16142.229, "timestamp": "04:29:02", "text": "传送器是从哪里来的。 哦，找到了"}, {"type": "subtitle", "time": 16144.469, "timestamp": "04:29:04", "text": "。"}, {"type": "subtitle", "time": 16146.95, "timestamp": "04:29:06", "text": "杀戮即将到来。 杀了他。 杀了"}, {"type": "subtitle", "time": 16148.07, "timestamp": "04:29:08", "text": "他。 杀了他。 杀了他。"}, {"type": "subtitle", "time": 16151.59, "timestamp": "04:29:11", "text": "杀了他。 哦，不。 没关系。"}, {"type": "subtitle", "time": 16153.269, "timestamp": "04:29:13", "text": "所有人。 他们还应该增加哪些人？"}, {"type": "subtitle", "time": 16156.309, "timestamp": "04:29:16", "text": "老兄，他们应该把死侍加进来。"}, {"type": "subtitle", "time": 16157.99, "timestamp": "04:29:17", "text": "死池。 你知道我想要什么吗？ 如果"}, {"type": "subtitle", "time": 16161.59, "timestamp": "04:29:21", "text": "他们真的加入了死侍。 嗯。"}, {"type": "subtitle", "time": 16163.83, "timestamp": "04:29:23", "text": "他是一名治疗师。"}, {"type": "subtitle", "time": 16167.51, "timestamp": "04:29:27", "text": "死侍治疗师。 是的。 我的天啊。 就像"}, {"type": "subtitle", "time": 16169.189, "timestamp": "04:29:29", "text": "火箭一样。 他就像扔球一样，把球扔"}, {"type": "subtitle", "time": 16171.99, "timestamp": "04:29:31", "text": "出去，然后像弹球一样反弹回来。 他直接朝"}, {"type": "subtitle", "time": 16174.71, "timestamp": "04:29:34", "text": "你扔奇姆·琼加斯。"}, {"type": "subtitle", "time": 16176.55, "timestamp": "04:29:36", "text": "他就像在说：“喏，兄弟。吃我一坨"}, {"type": "subtitle", "time": 16181.59, "timestamp": "04:29:41", "text": "我们有时间。 我正在等我的"}, {"type": "subtitle", "time": 16184.91, "timestamp": "04:29:44", "text": "队友。 哟，他的终极技能就是《"}, {"type": "subtitle", "time": 16189.91, "timestamp": "04:29:49", "text": "漫威VS卡普空》里的HyperX连招，"}, {"type": "subtitle", "time": 16192.07, "timestamp": "04:29:52", "text": "他会掏出血条，然后用"}]
[{"type": "subtitle", "time": 3780.95, "timestamp": "01:03:00", "text": "你打开互联网，"}, {"type": "subtitle", "time": 3783.75, "timestamp": "01:03:03", "text": "看看推特，看到人们是如何"}, {"type": "subtitle", "time": 3786.069, "timestamp": "01:03:06", "text": "欣赏你的作品、欣赏"}, {"type": "subtitle", "time": 3788.95, "timestamp": "01:03:08", "text": "你的存在等等，这些都会让你感到"}, {"type": "subtitle", "time": 3791.75, "timestamp": "01:03:11", "text": "无比温暖，从而让你继续努力做到"}, {"type": "subtitle", "time": 3793.47, "timestamp": "01:03:13", "text": "最好。"}, {"type": "subtitle", "time": 3796.39, "timestamp": "01:03:16", "text": "不，但我意识到现实世界并非"}, {"type": "subtitle", "time": 3798.91, "timestamp": "01:03:18", "text": "如此。 情况比较复杂。"}, {"type": "subtitle", "time": 3801.87, "timestamp": "01:03:21", "text": "音乐圈里既有"}, {"type": "subtitle", "time": 3805.349, "timestamp": "01:03:25", "text": "支持你的人，"}, {"type": "subtitle", "time": 3808.95, "timestamp": "01:03:28", "text": "也有"}, {"type": "subtitle", "time": 3815.47, "timestamp": "01:03:35", "text": "。"}, {"type": "subtitle", "time": 3818.789, "timestamp": "01:03:38", "text": "那么，为什么会有人"}, {"type": "subtitle", "time": 3824.63, "timestamp": "01:03:44", "text": "嫉妒呢？ 每个人都从零开始。 你"}, {"type": "subtitle", "time": 3827.109, "timestamp": "01:03:47", "text": "只需要尽最大努力就能达到"}, {"type": "subtitle", "time": 3835.63, "timestamp": "01:03:55", "text": "[音乐]"}, {"type": "subtitle", "time": 3838.39, "timestamp": "01:03:58", "text": "没错。 但我发现这种嫉妒"}]
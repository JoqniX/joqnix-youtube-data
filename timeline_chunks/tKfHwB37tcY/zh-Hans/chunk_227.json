[{"type": "subtitle", "time": 13636.07, "timestamp": "03:47:16", "text": "顺便说一句，我的治疗师们都非常厉害。 他们"}, {"type": "subtitle", "time": 13657.59, "timestamp": "03:47:37", "text": "我的天哪，他玩这个游戏太厉害了。"}, {"type": "subtitle", "time": 13668.229, "timestamp": "03:47:48", "text": "不会强求。 我不会"}, {"type": "subtitle", "time": 13669.51, "timestamp": "03:47:49", "text": "强求。 回来吧，伙计们。 回来。 回来"}]
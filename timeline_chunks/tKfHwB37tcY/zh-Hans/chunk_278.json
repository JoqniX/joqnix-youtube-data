[{"type": "subtitle", "time": 16680.709, "timestamp": "04:38:00", "text": "的Y也在播放。 不，不是这个。"}, {"type": "subtitle", "time": 16683.109, "timestamp": "04:38:03", "text": "走吧，兄弟。"}, {"type": "subtitle", "time": 16685.189, "timestamp": "04:38:05", "text": "她还在玩"}, {"type": "subtitle", "time": 16689.189, "timestamp": "04:38:09", "text": "火箭。 真好。 我看到你们了吗？ 这"}, {"type": "subtitle", "time": 16690.949, "timestamp": "04:38:10", "text": "就是我们被带走的方式。 我们差点就成功了"}, {"type": "subtitle", "time": 16692.709, "timestamp": "04:38:12", "text": "。"}, {"type": "subtitle", "time": 16694.789, "timestamp": "04:38:14", "text": "我们家的人都喜欢被人抬着走。"}, {"type": "subtitle", "time": 16697.349, "timestamp": "04:38:17", "text": "我们喜欢被人抱着。   当然"}, {"type": "subtitle", "time": 16699.91, "timestamp": "04:38:19", "text": "，兄弟。 这就是为什么"}, {"type": "subtitle", "time": 16702.31, "timestamp": "04:38:22", "text": "所有DPS"}, {"type": "subtitle", "time": 16707.029, "timestamp": "04:38:27", "text": "玩家都说治疗没有技巧的原因。"}, {"type": "subtitle", "time": 16717.99, "timestamp": "04:38:37", "text": "我罩着你，夏洛克。 我接到你了。"}, {"type": "subtitle", "time": 16737.189, "timestamp": "04:38:57", "text": "的天哪，这些人想要我。 他们很"}]
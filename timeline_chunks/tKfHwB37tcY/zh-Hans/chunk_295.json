[{"type": "subtitle", "time": 17727.51, "timestamp": "04:55:27", "text": "先发制人。 请赐予我们荣耀，我已经准备好为大家带来"}, {"type": "subtitle", "time": 17749.75, "timestamp": "04:55:49", "text": "这一切都是因为，嗯，这一切都是"}, {"type": "subtitle", "time": 17752.55, "timestamp": "04:55:52", "text": "因为我的兄弟索尔是个"}, {"type": "subtitle", "time": 17755.11, "timestamp": "04:55:55", "text": "彻头彻尾的白痴，我们才输掉了那场团队"}, {"type": "subtitle", "time": 17756.868, "timestamp": "04:55:56", "text": "战斗。 我们本来可以赢的，"}]
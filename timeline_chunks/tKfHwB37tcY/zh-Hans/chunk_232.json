[{"type": "subtitle", "time": 13922.63, "timestamp": "03:52:02", "text": "两个治疗者都找到了。 这就是我们获胜的原因。 我"}, {"type": "subtitle", "time": 13925.349, "timestamp": "03:52:05", "text": "认为她身上那种隐形女性的气质，"}, {"type": "subtitle", "time": 13928.09, "timestamp": "03:52:08", "text": "我认为她"}, {"type": "subtitle", "time": 13930.91, "timestamp": "03:52:10", "text": "（音乐）"}, {"type": "subtitle", "time": 13933.91, "timestamp": "03:52:13", "text": "做到了。 好吧，那个奇怪的人什么都有。 我得"}, {"type": "subtitle", "time": 13944.71, "timestamp": "03:52:24", "text": "属于我的东西。"}, {"type": "subtitle", "time": 13961.91, "timestamp": "03:52:41", "text": "哦，是那只浣熊。 我要去拿。"}, {"type": "subtitle", "time": 13965.189, "timestamp": "03:52:45", "text": "不错，伙计。 好的。 你也会遇到"}, {"type": "subtitle", "time": 13967.269, "timestamp": "03:52:47", "text": "奇怪的事情。 我们也遇到了奇怪的情况。"}, {"type": "subtitle", "time": 13975.429, "timestamp": "03:52:55", "text": "圣洁的神。 我们很好。 这个团队有"}, {"type": "subtitle", "time": 13978.229, "timestamp": "03:52:58", "text": "这样的团队差异。 这是一支极限"}]
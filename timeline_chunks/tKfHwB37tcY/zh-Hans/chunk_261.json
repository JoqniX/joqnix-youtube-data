[{"type": "subtitle", "time": 15663.75, "timestamp": "04:21:03", "text": "太阳出来了。 我要走了。 我"}, {"type": "subtitle", "time": 15667.11, "timestamp": "04:21:07", "text": "要走了。 我没事。"}, {"type": "subtitle", "time": 15669.83, "timestamp": "04:21:09", "text": "我被彻底击败了。   我的"}, {"type": "subtitle", "time": 15672.95, "timestamp": "04:21:12", "text": "天哪。 你喜欢被彻底击败，是吗？"}, {"type": "subtitle", "time": 15677.429, "timestamp": "04:21:17", "text": "我不这么认为。 嗯。 我不这么认为。"}, {"type": "subtitle", "time": 15679.07, "timestamp": "04:21:19", "text": "不。好吧，"}, {"type": "subtitle", "time": 15689.03, "timestamp": "04:21:29", "text": "哟，我好像瞄准不了。   难道"}, {"type": "subtitle", "time": 15692.87, "timestamp": "04:21:32", "text": "你不能吗？ 好的。 不，我可以瞄准。"}, {"type": "subtitle", "time": 15694.71, "timestamp": "04:21:34", "text": "你知道，我不是那种单枪匹马的治疗师"}, {"type": "subtitle", "time": 15699.75, "timestamp": "04:21:39", "text": "。 哦好的。 这很有道理。"}, {"type": "subtitle", "time": 15703.189, "timestamp": "04:21:43", "text": "你一定可以的。 快点。 没关系。"}, {"type": "subtitle", "time": 15704.95, "timestamp": "04:21:44", "text": "我们可以失去一些东西，你知道，这没什么"}, {"type": "subtitle", "time": 15707.269, "timestamp": "04:21:47", "text": "大不了的。 我的意思是，是的。 有赢有"}, {"type": "subtitle", "time": 15710.389, "timestamp": "04:21:50", "text": "输。 仅此而已。"}, {"type": "subtitle", "time": 15712.71, "timestamp": "04:21:52", "text": "有时候你会玩得很烂。 有时你会"}, {"type": "subtitle", "time": 15715.51, "timestamp": "04:21:55", "text": "抓住他。 抓住他，霜冻。 抓住那家伙"}, {"type": "subtitle", "time": 15717.51, "timestamp": "04:21:57", "text": "。"}]
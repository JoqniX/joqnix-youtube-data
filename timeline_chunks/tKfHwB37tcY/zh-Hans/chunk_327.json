[{"type": "subtitle", "time": 19620.91, "timestamp": "05:27:00", "text": "搞什么鬼？ 我们为什么现在要走这条路？"}, {"type": "subtitle", "time": 19625.83, "timestamp": "05:27:05", "text": "我的恶搞玩具。"}, {"type": "subtitle", "time": 19633.04, "timestamp": "05:27:13", "text": "这他妈是什么玩意儿？"}, {"type": "subtitle", "time": 19661.03, "timestamp": "05:27:41", "text": "我们的敌人是"}, {"type": "subtitle", "time": 19663.99, "timestamp": "05:27:43", "text": "最后的10秒钟。"}, {"type": "subtitle", "time": 19667.51, "timestamp": "05:27:47", "text": "你们他妈的在干什么？"}, {"type": "subtitle", "time": 19675.27, "timestamp": "05:27:55", "text": "我要把这些人静音。"}, {"type": "subtitle", "time": 19678.788, "timestamp": "05:27:58", "text": "得分是 1。"}]
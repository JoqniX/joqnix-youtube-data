[{"type": "subtitle", "time": 23050.07, "timestamp": "06:24:10", "text": "忘了。 我稍后会做。 好的，"}, {"type": "subtitle", "time": 23050.99, "timestamp": "06:24:10", "text": "这是"}, {"type": "subtitle", "time": 23054.75, "timestamp": "06:24:14", "text": "我的。 所以，我们完成了三个人的培训"}, {"type": "subtitle", "time": 23057.628, "timestamp": "06:24:17", "text": "。 呃，那还有谁"}, {"type": "subtitle", "time": 23080.548, "timestamp": "06:24:40", "text": "Nexus。 为什么会有这么多其他的领主"}, {"type": "subtitle", "time": 23086.67, "timestamp": "06:24:46", "text": "刺客？ 好吧，主啊，这条"}, {"type": "subtitle", "time": 23095.27, "timestamp": "06:24:55", "text": "我觉得我是唯一一个格格不入的人，因为"}, {"type": "subtitle", "time": 23096.59, "timestamp": "06:24:56", "text": "我在"}]
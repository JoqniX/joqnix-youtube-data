[{"type": "subtitle", "time": 20640.23, "timestamp": "05:44:00", "text": "徒劳的尝试。"}, {"type": "subtitle", "time": 20652.788, "timestamp": "05:44:12", "text": "见鬼了，我好不容易把九个人从"}, {"type": "subtitle", "time": 20654.948, "timestamp": "05:44:14", "text": "前线拉了下来，结果我的治疗者们好像都"}, {"type": "subtitle", "time": 20656.948, "timestamp": "05:44:16", "text": "走了。 兄弟，还有更多的工作"}, {"type": "subtitle", "time": 20660.31, "timestamp": "05:44:20", "text": "要做。 我快要输了。"}, {"type": "subtitle", "time": 20661.91, "timestamp": "05:44:21", "text": "我感觉要输给这些人了。 我目前遭遇"}, {"type": "subtitle", "time": 20663.99, "timestamp": "05:44:23", "text": "四连败，之前曾取得过"}, {"type": "subtitle", "time": 20667.75, "timestamp": "05:44:27", "text": "七连胜。 我的天啊。"}, {"type": "chat", "time": 20670.244, "timestamp": "05:44:30", "author": "@RyzexCh", "avatar": "https://yt4.ggpht.com/amK2Y62apvFDa_Drvh1DcQn8KTERvc2-tn67_8Tfb4CDDptav6v-n5VMsBR3U5XQAh1NLxsr1Q=s64-c-k-c0x00ffffff-no-rj", "message": "skill issue!"}, {"type": "subtitle", "time": 20671.99, "timestamp": "05:44:31", "text": "等等，你一共玩了多少局游戏？"}, {"type": "subtitle", "time": 20673.91, "timestamp": "05:44:33", "text": "非常喜欢。 我一直在等你"}, {"type": "subtitle", "time": 20676.39, "timestamp": "05:44:36", "text": "回来，然后我就想，他回来了。 我"}, {"type": "subtitle", "time": 20678.708, "timestamp": "05:44:38", "text": "觉得我应该继续前进。 你知道这一切是从"}, {"type": "subtitle", "time": 20681.67, "timestamp": "05:44:41", "text": "D加入，也就是Haras"}, {"type": "subtitle", "time": 20684.31, "timestamp": "05:44:44", "text": "加入的时候开始的，当时我们一直在赢，然后他"}, {"type": "subtitle", "time": 20685.91, "timestamp": "05:44:45", "text": "离开了，"}, {"type": "subtitle", "time": 20687.47, "timestamp": "05:44:47", "text": "然后他又离开了，然后我就开始"}, {"type": "subtitle", "time": 20691.11, "timestamp": "05:44:51", "text": "输球，我连输了三局。"}, {"type": "subtitle", "time": 20694.91, "timestamp": "05:44:54", "text": "哦，该死。  D 是 D，D 是必需的。"}]
[{"type": "subtitle", "time": 18000.03, "timestamp": "05:00:00", "text": "糟糕。 真是太"}, {"type": "subtitle", "time": 18002.788, "timestamp": "05:00:02", "text": "酷了。 你们看过"}, {"type": "subtitle", "time": 18007.15, "timestamp": "05:00:07", "text": "这个吗？ 让我来给你演示一下。 这个洛基皮肤"}, {"type": "subtitle", "time": 18010.868, "timestamp": "05:00:10", "text": "不错，但我不知道它是不是好到可以称得上"}, {"type": "subtitle", "time": 18017.628, "timestamp": "05:00:17", "text": "你懂我的意思吧"}, {"type": "subtitle", "time": 18019.91, "timestamp": "05:00:19", "text": "。 他们是两位魔术师选手。   真令人"}, {"type": "subtitle", "time": 18022.15, "timestamp": "05:00:22", "text": "难过。 真是太令人沮丧了。"}, {"type": "subtitle", "time": 18023.91, "timestamp": "05:00:23", "text": "魔法。 你今天想成为哪位英雄"}, {"type": "subtitle", "time": 18033.03, "timestamp": "05:00:33", "text": "总之，我可以走了。"}, {"type": "subtitle", "time": 18038.708, "timestamp": "05:00:38", "text": "我可以。"}, {"type": "subtitle", "time": 18040.39, "timestamp": "05:00:40", "text": "不，如果你想玩，"}, {"type": "subtitle", "time": 18052.19, "timestamp": "05:00:52", "text": "我想在这张地图上……"}, {"type": "subtitle", "time": 18054.51, "timestamp": "05:00:54", "text": "哦，很"}, {"type": "subtitle", "time": 18058.43, "timestamp": "05:00:58", "text": "简单。 和平的秘诀很简单，就是"}]
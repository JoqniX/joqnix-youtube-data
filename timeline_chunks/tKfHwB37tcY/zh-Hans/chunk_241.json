[{"type": "subtitle", "time": 14461.429, "timestamp": "04:01:01", "text": "。 他们有两辆突击坦克。"}, {"type": "subtitle", "time": 14464.15, "timestamp": "04:01:04", "text": "之后可能会转而扮演金刚狼。 他们"}, {"type": "subtitle", "time": 14465.63, "timestamp": "04:01:05", "text": "有突击型"}, {"type": "subtitle", "time": 14469.269, "timestamp": "04:01:09", "text": "坦克。 我们可以给这些人。"}, {"type": "subtitle", "time": 14471.59, "timestamp": "04:01:11", "text": "现在或许是阻止他们的好时机。"}, {"type": "subtitle", "time": 14474.63, "timestamp": "04:01:14", "text": "哦，真是漂亮的招数，对吧？"}, {"type": "subtitle", "time": 14489.349, "timestamp": "04:01:29", "text": "还在追我。 这帮混蛋"}, {"type": "subtitle", "time": 14491.51, "timestamp": "04:01:31", "text": "还在追。 我打算买这个。"}, {"type": "subtitle", "time": 14496.95, "timestamp": "04:01:36", "text": "它们正朝你袭来。"}, {"type": "subtitle", "time": 14498.269, "timestamp": "04:01:38", "text": "早就跟"}, {"type": "subtitle", "time": 14508.63, "timestamp": "04:01:48", "text": "哦，漂亮的招式，对吧？"}]
[{"type": "subtitle", "time": 5947.83, "timestamp": "01:39:07", "text": "呃，稍等一下。 让我加入聊天。"}, {"type": "subtitle", "time": 5949.149, "timestamp": "01:39:09", "text": "好的。"}, {"type": "subtitle", "time": 5952.189, "timestamp": "01:39:12", "text": "嗯，您三点能过来吗？"}, {"type": "subtitle", "time": 5956.59, "timestamp": "01:39:16", "text": "或者您想待"}, {"type": "subtitle", "time": 5968.59, "timestamp": "01:39:28", "text": "小时？ 呃，我先来"}, {"type": "subtitle", "time": 5993.35, "timestamp": "01:39:53", "text": "呃，为什么是三个？ 为什么是三个？"}, {"type": "subtitle", "time": 5998.189, "timestamp": "01:39:58", "text": "我先吃了砖头，而不是"}]
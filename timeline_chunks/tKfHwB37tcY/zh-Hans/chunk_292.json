[{"type": "subtitle", "time": 17520.31, "timestamp": "04:52:00", "text": "我回来了。 现在，他将承受地狱之火的"}, {"type": "subtitle", "time": 17552.15, "timestamp": "04:52:32", "text": "天哪，我们的医护人员都快死了。 她"}, {"type": "subtitle", "time": 17553.75, "timestamp": "04:52:33", "text": "应该在治好她之后就立刻送她去医院"}, {"type": "subtitle", "time": 17556.15, "timestamp": "04:52:36", "text": "。"}, {"type": "subtitle", "time": 17558.868, "timestamp": "04:52:38", "text": "比鸡肉好吃。"}, {"type": "subtitle", "time": 17561.67, "timestamp": "04:52:41", "text": "我现在状态也很差。 拉屎。"}, {"type": "subtitle", "time": 17573.43, "timestamp": "04:52:53", "text": "你的力量就是我的力量。 我已经准备好了。 你看，"}]
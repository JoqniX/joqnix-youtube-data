[{"type": "subtitle", "time": 18126.39, "timestamp": "05:02:06", "text": "东西。 哦好的。 我理解他。 我不是那种"}, {"type": "subtitle", "time": 18127.99, "timestamp": "05:02:07", "text": "默默无闻、甘于"}, {"type": "subtitle", "time": 18129.788, "timestamp": "05:02:09", "text": "幕后的人。 我理解"}, {"type": "subtitle", "time": 18132.39, "timestamp": "05:02:12", "text": "他。 当时在问妈妈，他本来可以简单地"}, {"type": "subtitle", "time": 18135.75, "timestamp": "05:02:15", "text": "回复，他本来可以"}, {"type": "subtitle", "time": 18138.47, "timestamp": "05:02:18", "text": "画出他"}, {"type": "subtitle", "time": 18142.868, "timestamp": "05:02:22", "text": "想要的样子，就像隐形女人一样。"}, {"type": "subtitle", "time": 18145.03, "timestamp": "05:02:25", "text": "他们还有30秒就到。"}, {"type": "subtitle", "time": 18160.15, "timestamp": "05:02:40", "text": "啤酒花。 而且，用我的话说，你确实拥有“非常棒的"}, {"type": "subtitle", "time": 18173.11, "timestamp": "05:02:53", "text": "不，"}, {"type": "subtitle", "time": 18174.868, "timestamp": "05:02:54", "text": "你必须阻止他们占领"}]
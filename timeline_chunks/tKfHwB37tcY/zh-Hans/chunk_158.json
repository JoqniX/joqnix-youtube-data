[{"type": "subtitle", "time": 9514.03, "timestamp": "02:38:34", "text": "够了。 弄些"}, {"type": "subtitle", "time": 9530.99, "timestamp": "02:38:50", "text": "啊，我还以为我有一个小时呢。"}, {"type": "subtitle", "time": 9534.15, "timestamp": "02:38:54", "text": "发生了什么？"}, {"type": "subtitle", "time": 9536.95, "timestamp": "02:38:56", "text": "拆卸一把椅子花了我很长时间，竟然花了一个"}]
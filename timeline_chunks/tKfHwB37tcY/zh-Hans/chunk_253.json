[{"type": "subtitle", "time": 15180.229, "timestamp": "04:13:00", "text": "如果你想接管一切，就会过来。   是的"}, {"type": "subtitle", "time": 15184.55, "timestamp": "04:13:04", "text": "。 我的天啊。 凉爽的。 太酷了。"}, {"type": "subtitle", "time": 15189.03, "timestamp": "04:13:09", "text": "哇，老兄。 是的，我做了。 哇。 太"}, {"type": "subtitle", "time": 15191.83, "timestamp": "04:13:11", "text": "疯狂了。 所以，你在忙什么呢？ 正如"}, {"type": "subtitle", "time": 15193.67, "timestamp": "04:13:13", "text": "你在直播中看到的那样，我本人就是这样。 我正在"}, {"type": "subtitle", "time": 15196.309, "timestamp": "04:13:16", "text": "玩《Rivals》。 嗯，你知道，稍微提升一下排名"}, {"type": "subtitle", "time": 15197.91, "timestamp": "04:13:17", "text": "，你知道，努力冲分"}, {"type": "subtitle", "time": 15201.11, "timestamp": "04:13:21", "text": "，争取上钻石什么的"}, {"type": "subtitle", "time": 15203.75, "timestamp": "04:13:23", "text": "。 咱们走吧，兄弟。 我的天啊。   是的"}, {"type": "subtitle", "time": 15206.71, "timestamp": "04:13:26", "text": "。 我的天啊。"}, {"type": "subtitle", "time": 15208.87, "timestamp": "04:13:28", "text": "目前刚取得两连胜。 没什么大不了的"}, {"type": "subtitle", "time": 15212.07, "timestamp": "04:13:32", "text": "。 我的天，这简直太巅峰了。 当然啦，"}, {"type": "subtitle", "time": 15214.469, "timestamp": "04:13:34", "text": "兄弟。 是的，我已经两个月没玩这个游戏了"}, {"type": "subtitle", "time": 15216.87, "timestamp": "04:13:36", "text": "。 我连这个都没有。 我们"}, {"type": "subtitle", "time": 15219.83, "timestamp": "04:13:39", "text": "走吧。 我们走吧。"}, {"type": "subtitle", "time": 15221.59, "timestamp": "04:13:41", "text": "哟，谁玩这个游戏啊？ 谁"}, {"type": "subtitle", "time": 15223.429, "timestamp": "04:13:43", "text": "在玩这个游戏？ 我知道，对吧？ 我在"}, {"type": "subtitle", "time": 15228.79, "timestamp": "04:13:48", "text": "玩这个游戏吗？ 天哪，你真是太"}, {"type": "subtitle", "time": 15230.71, "timestamp": "04:13:50", "text": "该死。 哥们儿，你好吗？"}, {"type": "subtitle", "time": 15232.95, "timestamp": "04:13:52", "text": "你好吗？ 你知道，就是放松放松而已"}, {"type": "subtitle", "time": 15236.87, "timestamp": "04:13:56", "text": "。 嗯，我刚吃了点面条。 所以，"}]
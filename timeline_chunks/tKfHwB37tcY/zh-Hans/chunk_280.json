[{"type": "subtitle", "time": 16805.47, "timestamp": "04:40:05", "text": "伙计们，我觉得"}, {"type": "subtitle", "time": 16809.31, "timestamp": "04:40:09", "text": "今天我们只要签下"}, {"type": "subtitle", "time": 16832.15, "timestamp": "04:40:32", "text": "小兵们展现了一些引人入胜的游戏技巧。 铆。"}, {"type": "subtitle", "time": 16835.35, "timestamp": "04:40:35", "text": "第二轮。 除非做错事"}, {"type": "subtitle", "time": 16843.43, "timestamp": "04:40:43", "text": "该死。 我们的人都很棒。 我的队员们都"}, {"type": "subtitle", "time": 16847.708, "timestamp": "04:40:47", "text": "30"}, {"type": "subtitle", "time": 16849.47, "timestamp": "04:40:49", "text": "秒。 准备好"}, {"type": "subtitle", "time": 16851.59, "timestamp": "04:40:51", "text": "。 说实话"}, {"type": "subtitle", "time": 16852.948, "timestamp": "04:40:52", "text": "，我觉得我不应该"}, {"type": "subtitle", "time": 16854.948, "timestamp": "04:40:54", "text": "再次达到这个排名。 我越想越觉得是这样"}]
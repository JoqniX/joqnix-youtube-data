[{"type": "subtitle", "time": 21661.19, "timestamp": "06:01:01", "text": "我的治疗师们要先于我行动？ 这就是"}, {"type": "subtitle", "time": 21668.47, "timestamp": "06:01:08", "text": "兄弟，我的治疗老是死，所以我没法玩小号"}, {"type": "subtitle", "time": 21671.07, "timestamp": "06:01:11", "text": "。"}, {"type": "subtitle", "time": 21678.07, "timestamp": "06:01:18", "text": "乔，你今天过得怎么样？"}, {"type": "subtitle", "time": 21700.788, "timestamp": "06:01:40", "text": "我不确定空调公司的人"}, {"type": "subtitle", "time": 21703.27, "timestamp": "06:01:43", "text": "今天会不会来做。 你的力量或许就在"}, {"type": "subtitle", "time": 21706.948, "timestamp": "06:01:46", "text": "明天。 我不知道。 这是真正的"}]
[{"type": "subtitle", "time": 19023.03, "timestamp": "05:17:03", "text": "我有一个盾牌，但没什么可抱怨的。 好像"}, {"type": "subtitle", "time": 19026.07, "timestamp": "05:17:06", "text": "没人愿意改变主意。 最后10"}, {"type": "subtitle", "time": 19038.15, "timestamp": "05:17:18", "text": "极好的。"}, {"type": "subtitle", "time": 19059.66, "timestamp": "05:17:39", "text": "呃，我不想谈论"}, {"type": "subtitle", "time": 19066.99, "timestamp": "05:17:46", "text": "事。 耶稣24岁。"}, {"type": "subtitle", "time": 19069.43, "timestamp": "05:17:49", "text": "哇。 当我的球队一团糟时，你希望我怎么做"}, {"type": "subtitle", "time": 19072.11, "timestamp": "05:17:52", "text": "？"}, {"type": "subtitle", "time": 19074.948, "timestamp": "05:17:54", "text": "该死。 伙计们，我们最近连败好几次"}, {"type": "subtitle", "time": 19079.51, "timestamp": "05:17:59", "text": "。 这很糟糕。 乔回来了吗？"}]
[{"type": "subtitle", "time": 15008.389, "timestamp": "04:10:08", "text": "哦，我们赢了。 我们都发挥得很好。"}, {"type": "subtitle", "time": 15010.229, "timestamp": "04:10:10", "text": "我认为我们所有人都是如此。 我们都发挥得"}, {"type": "subtitle", "time": 15011.83, "timestamp": "04:10:11", "text": "很好。"}, {"type": "subtitle", "time": 15013.51, "timestamp": "04:10:13", "text": "看看阻挡了多少伤害。 我连"}, {"type": "subtitle", "time": 15015.189, "timestamp": "04:10:15", "text": "坦克都算不上。 看看损伤图。"}, {"type": "subtitle", "time": 15025.189, "timestamp": "04:10:25", "text": "该死。 我感觉我的脚后跟状态非常好。"}, {"type": "subtitle", "time": 15027.63, "timestamp": "04:10:27", "text": "我当时就像一辆半挂"}, {"type": "subtitle", "time": 15029.389, "timestamp": "04:10:29", "text": "坦克。"}, {"type": "subtitle", "time": 15032.67, "timestamp": "04:10:32", "text": "耶稣。 我拿到了三"}, {"type": "subtitle", "time": 15035.429, "timestamp": "04:10:35", "text": "件。 住手。 我的英雄们都很棒。 我的"}, {"type": "subtitle", "time": 15037.95, "timestamp": "04:10:37", "text": "英雄们都是疯子。 我的坦克也是"}, {"type": "subtitle", "time": 15040.389, "timestamp": "04:10:40", "text": "。 你必须全力以赴，你知道吗？"}, {"type": "subtitle", "time": 15042.469, "timestamp": "04:10:42", "text": "他们都发挥得很好。 给它们都点个"}, {"type": "subtitle", "time": 15045.55, "timestamp": "04:10:45", "text": "赞。 他们就是这么厉害。"}, {"type": "subtitle", "time": 15048.63, "timestamp": "04:10:48", "text": "哇。 你们知道吗，伙计们？ 我现在应该直接"}, {"type": "subtitle", "time": 15051.75, "timestamp": "04:10:51", "text": "走输出路线吗？ 因为我就是这么厉害。"}, {"type": "subtitle", "time": 15053.349, "timestamp": "04:10:53", "text": "我玩这个游戏这么厉害，应该"}, {"type": "subtitle", "time": 15056.309, "timestamp": "04:10:56", "text": "去玩输出位。 就是这样。你知道吗"}, {"type": "subtitle", "time": 15058.63, "timestamp": "04:10:58", "text": "？ 因为我是个……你知道的，让我给"}]
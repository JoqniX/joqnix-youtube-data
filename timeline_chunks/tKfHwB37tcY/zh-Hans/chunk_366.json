[{"type": "subtitle", "time": 21962.788, "timestamp": "06:06:02", "text": "现在提供颜色定制功能了。"}, {"type": "subtitle", "time": 21964.868, "timestamp": "06:06:04", "text": "啊，是的"}, {"type": "subtitle", "time": 21967.67, "timestamp": "06:06:07", "text": "。 唯一好看的就是"}, {"type": "subtitle", "time": 21970.31, "timestamp": "06:06:10", "text": "初音未来的帽子。 我给她打电话。"}, {"type": "subtitle", "time": 21973.07, "timestamp": "06:06:13", "text": "你知道什么帽子吗？ 等等，还有个"}, {"type": "subtitle", "time": 21975.99, "timestamp": "06:06:15", "text": "哈提库版本。 哇。 好的。 不，不，不，"}, {"type": "subtitle", "time": 21977.67, "timestamp": "06:06:17", "text": "不，不，不，不，不。 我只是说，这个"}, {"type": "subtitle", "time": 21979.75, "timestamp": "06:06:19", "text": "配色方案看起来很像初音未来。   是的"}, {"type": "subtitle", "time": 21983.43, "timestamp": "06:06:23", "text": "。 是的。 是的。 确实如此。"}, {"type": "subtitle", "time": 21985.59, "timestamp": "06:06:25", "text": "朋克小孩。 这就是绿色"}, {"type": "subtitle", "time": 21990.43, "timestamp": "06:06:30", "text": "版本，那个黑暗的孩子。 嗯。   是的"}, {"type": "subtitle", "time": 21993.59, "timestamp": "06:06:33", "text": "。 而且我还想，哦，我怎么没"}, {"type": "subtitle", "time": 21995.11, "timestamp": "06:06:35", "text": "想到你会像灵蝶那样玩游戏呢"}, {"type": "subtitle", "time": 22002.67, "timestamp": "06:06:42", "text": "蝴蝶女士，因为你"}, {"type": "subtitle", "time": 22005.91, "timestamp": "06:06:45", "text": "喜欢她是因为她有武士刀，而且"}, {"type": "subtitle", "time": 22009.27, "timestamp": "06:06:49", "text": "她擅长拳击。"}, {"type": "subtitle", "time": 22012.47, "timestamp": "06:06:52", "text": "是的，与其说是拳头，不如说是几支"}, {"type": "subtitle", "time": 22015.99, "timestamp": "06:06:55", "text": "小箭。 这是"}, {"type": "subtitle", "time": 22018.548, "timestamp": "06:06:58", "text": "另一种定制颜色。"}]
[{"type": "subtitle", "time": 14708.389, "timestamp": "04:05:08", "text": "当前比分是聊天。 我发挥得"}, {"type": "subtitle", "time": 14710.07, "timestamp": "04:05:10", "text": "好吗？ 因为我没意识到，我当时太"}, {"type": "subtitle", "time": 14711.99, "timestamp": "04:05:11", "text": "专注于TPS了。 是的。"}, {"type": "subtitle", "time": 14713.83, "timestamp": "04:05:13", "text": "查德，我做得好吗？ 我觉得我表现得还"}, {"type": "subtitle", "time": 14717.03, "timestamp": "04:05:17", "text": "不错，包括你站在哪一边。"}, {"type": "subtitle", "time": 14720.229, "timestamp": "04:05:20", "text": "我只是随便聊聊。 我有个"}, {"type": "subtitle", "time": 14723.11, "timestamp": "04:05:23", "text": "朋友叫……你知道"}, {"type": "subtitle", "time": 14726.87, "timestamp": "04:05:26", "text": "吗？ 不，我不会说出他的名字。 我的"}, {"type": "subtitle", "time": 14729.03, "timestamp": "04:05:29", "text": "地位。 我要变成狼人，因为我"}, {"type": "subtitle", "time": 14731.269, "timestamp": "04:05:31", "text": "知道如果他们再玩同样的把戏"}, {"type": "subtitle", "time": 14739.51, "timestamp": "04:05:39", "text": "，我的输出不算"}, {"type": "subtitle", "time": 14741.51, "timestamp": "04:05:41", "text": "很高，但我现在玩得还"}, {"type": "subtitle", "time": 14743.03, "timestamp": "04:05:43", "text": "不错。 你知道，我这是在耍聪明。 我打算去"}, {"type": "subtitle", "time": 14745.83, "timestamp": "04:05:45", "text": "看看坦克。 我用"}, {"type": "subtitle", "time": 14747.83, "timestamp": "04:05:47", "text": "小号练级练得很快，这感觉"}, {"type": "subtitle", "time": 14750.469, "timestamp": "04:05:50", "text": "真不错。"}, {"type": "subtitle", "time": 14752.11, "timestamp": "04:05:52", "text": "我"}, {"type": "subtitle", "time": 14755.99, "timestamp": "04:05:55", "text": "做的事不太好。"}, {"type": "subtitle", "time": 14758.91, "timestamp": "04:05:58", "text": "拜托，老兄。"}]
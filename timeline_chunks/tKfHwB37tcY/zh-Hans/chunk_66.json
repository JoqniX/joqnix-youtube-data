[{"type": "subtitle", "time": 3960.63, "timestamp": "01:06:00", "text": "你自己连接起来。 与其将"}, {"type": "subtitle", "time": 3968.829, "timestamp": "01:06:08", "text": "他人视为"}, {"type": "subtitle", "time": 3971.39, "timestamp": "01:06:11", "text": "竞争对手、"}, {"type": "subtitle", "time": 3975.87, "timestamp": "01:06:15", "text": "敌对者或"}, {"type": "subtitle", "time": 3978.67, "timestamp": "01:06:18", "text": "嫉妒对象，不如与过去的自己进行比较，从自己的错误中吸取教训，不断进步。"}, {"type": "subtitle", "time": 3981.19, "timestamp": "01:06:21", "text": "因为你认为你"}, {"type": "subtitle", "time": 3983.51, "timestamp": "01:06:23", "text": "嫉妒或与你竞争的人，他们"}, {"type": "subtitle", "time": 3986.589, "timestamp": "01:06:26", "text": "也有自己的难处。"}, {"type": "subtitle", "time": 3990.23, "timestamp": "01:06:30", "text": "不，他们和你一样，只是普通人，"}, {"type": "subtitle", "time": 3991.95, "timestamp": "01:06:31", "text": "有感情"}, {"type": "subtitle", "time": 3993.789, "timestamp": "01:06:33", "text": "、"}, {"type": "subtitle", "time": 3997.27, "timestamp": "01:06:37", "text": "有心、有激情，还有一颗充满激情的"}, {"type": "subtitle", "time": 4003.589, "timestamp": "01:06:43", "text": "不。所以达娜，"}, {"type": "subtitle", "time": 4011.029, "timestamp": "01:06:51", "text": "无论你是芭蕾舞演员、"}, {"type": "subtitle", "time": 4013.63, "timestamp": "01:06:53", "text": "板球运动员、网球运动员、射箭运动员"}, {"type": "chat", "time": 4017.315, "timestamp": "01:06:57", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "me personally i like me a good rivalry between peers"}, {"type": "chat", "time": 4019.749, "timestamp": "01:06:59", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "i like how joq finds a bad thing, then goes on a whole ahh tangent of making them see the good in the world"}]
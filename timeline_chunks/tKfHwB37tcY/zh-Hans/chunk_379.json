[{"type": "subtitle", "time": 22746.708, "timestamp": "06:19:06", "text": "去。 哦，原来是我想修的空调"}, {"type": "subtitle", "time": 22750.628, "timestamp": "06:19:10", "text": "送来了。 我当时正在处理这件事。"}, {"type": "subtitle", "time": 22754.27, "timestamp": "06:19:14", "text": "也许我的空调要来修了。 好的。"}, {"type": "subtitle", "time": 22759.91, "timestamp": "06:19:19", "text": "嗯，是的，你可以看到我这里有一个"}, {"type": "subtitle", "time": 22761.43, "timestamp": "06:19:21", "text": "验证符号，那是"}, {"type": "subtitle", "time": 22764.47, "timestamp": "06:19:24", "text": "广播器符号，而且有 123 条"}, {"type": "subtitle", "time": 22767.99, "timestamp": "06:19:27", "text": "消息即将到来。 是的，那很好。"}, {"type": "subtitle", "time": 22769.788, "timestamp": "06:19:29", "text": "现在，我要刷新一下"}, {"type": "subtitle", "time": 22772.628, "timestamp": "06:19:32", "text": "页面。 它会显示一个身份验证"}, {"type": "subtitle", "time": 22774.99, "timestamp": "06:19:34", "text": "错误，这正是我想要的"}, {"type": "subtitle", "time": 22777.548, "timestamp": "06:19:37", "text": "。 我会"}, {"type": "subtitle", "time": 22781.91, "timestamp": "06:19:41", "text": "这么做。 我要复制这个。"}, {"type": "subtitle", "time": 22782.91, "timestamp": "06:19:42", "text": "我打算"}]
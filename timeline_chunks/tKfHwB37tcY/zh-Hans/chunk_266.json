[{"type": "subtitle", "time": 15962.469, "timestamp": "04:26:02", "text": "谢谢。 谢谢你杀死了蜘蛛侠。"}, {"type": "subtitle", "time": 15964.95, "timestamp": "04:26:04", "text": "嘿，"}, {"type": "subtitle", "time": 15968.309, "timestamp": "04:26:08", "text": "吃点坚果吧。 大杀四方。"}, {"type": "subtitle", "time": 15970.469, "timestamp": "04:26:10", "text": "哦，她也很棒。 我不知道"}, {"type": "subtitle", "time": 15972.149, "timestamp": "04:26:12", "text": "她为什么没有分泌内啡肽"}, {"type": "subtitle", "time": 15973.67, "timestamp": "04:26:13", "text": "。"}, {"type": "subtitle", "time": 15975.83, "timestamp": "04:26:15", "text": "我的意思是，我不知道。 我觉得她是"}, {"type": "subtitle", "time": 15979.03, "timestamp": "04:26:19", "text": "个很普通的角色，你知道吗？"}, {"type": "subtitle", "time": 15981.03, "timestamp": "04:26:21", "text": "混蛋。 我认为，作为"}, {"type": "subtitle", "time": 15982.63, "timestamp": "04:26:22", "text": "基础角色，你的优点在于你的整体"}, {"type": "subtitle", "time": 15984.309, "timestamp": "04:26:24", "text": "平衡性相当好。 你真的"}, {"type": "subtitle", "time": 15986.79, "timestamp": "04:26:26", "text": "不需要任何增益效果或"}, {"type": "subtitle", "time": 15988.79, "timestamp": "04:26:28", "text": "紧张感，在我眼前我刚才是不是看到了蜘蛛侠？"}, {"type": "subtitle", "time": 15992.55, "timestamp": "04:26:32", "text": "我刚才看到蜘蛛侠有点像"}, {"type": "subtitle", "time": 15994.95, "timestamp": "04:26:34", "text": "守望先锋里的西格玛。 你"}, {"type": "subtitle", "time": 15996.79, "timestamp": "04:26:36", "text": "知道他其实是一个非常基础的"}, {"type": "subtitle", "time": 15998.71, "timestamp": "04:26:38", "text": "角色，但是就像他"}, {"type": "subtitle", "time": 16001.269, "timestamp": "04:26:41", "text": "在"}, {"type": "subtitle", "time": 16003.189, "timestamp": "04:26:43", "text": "游戏中从未受到过任何减益效果一样，他从未受到过任何"}, {"type": "subtitle", "time": 16006.229, "timestamp": "04:26:46", "text": "减益效果。 抱歉，要么加强要么削弱。 削弱"}, {"type": "subtitle", "time": 16009.11, "timestamp": "04:26:49", "text": "他，因为他就是这么强。"}, {"type": "subtitle", "time": 16012.07, "timestamp": "04:26:52", "text": "他完美地平衡了各种事情，做得无可挑剔。   是的"}, {"type": "subtitle", "time": 16014.79, "timestamp": "04:26:54", "text": "。 是的。 他只是抛出他的球，"}, {"type": "subtitle", "time": 16017.51, "timestamp": "04:26:57", "text": "竖起他的护盾，然后说"}]
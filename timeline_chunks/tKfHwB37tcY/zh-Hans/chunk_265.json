[{"type": "subtitle", "time": 15900.389, "timestamp": "04:25:00", "text": "伙计。 我喜欢这款游戏。你有没有看过"}, {"type": "subtitle", "time": 15902.469, "timestamp": "04:25:02", "text": "配音演员们玩"}, {"type": "subtitle", "time": 15905.91, "timestamp": "04:25:05", "text": "这款游戏的直播？ 是的。 我的天哪，太"}, {"type": "subtitle", "time": 15908.469, "timestamp": "04:25:08", "text": "好吃了。 太棒了。 疯狂的。 疯狂的。"}, {"type": "subtitle", "time": 15910.71, "timestamp": "04:25:10", "text": "我觉得我最喜欢"}, {"type": "subtitle", "time": 15912.87, "timestamp": "04:25:12", "text": "配音演员的时候，我的天哪，他的"}, {"type": "subtitle", "time": 15917.67, "timestamp": "04:25:17", "text": "直播太棒了。 是的，兄弟。 当然。"}, {"type": "subtitle", "time": 15925.03, "timestamp": "04:25:25", "text": "我希望，我希望，我希望艾玛·"}, {"type": "subtitle", "time": 15929.189, "timestamp": "04:25:29", "text": "弗罗斯特能成功，但我不应该这么说。"}, {"type": "subtitle", "time": 15931.99, "timestamp": "04:25:31", "text": "我应该这么说。 蜘蛛侠优先对付钢铁侠"}, {"type": "subtitle", "time": 15934.149, "timestamp": "04:25:34", "text": "。"}, {"type": "subtitle", "time": 15939.83, "timestamp": "04:25:39", "text": "嗯，我们觉得这个角色塑造得太好了。"}, {"type": "subtitle", "time": 15943.83, "timestamp": "04:25:43", "text": "霹雳火，他16岁零4个月，"}, {"type": "subtitle", "time": 15945.59, "timestamp": "04:25:45", "text": "蜘蛛侠是他最大的克星，蜘蛛侠"}, {"type": "subtitle", "time": 15959.59, "timestamp": "04:25:59", "text": "我的天啊。 谢谢。 谢谢。"}]
[{"type": "subtitle", "time": 21780.868, "timestamp": "06:03:00", "text": "糟糕，情况不妙。 这是真正的"}, {"type": "subtitle", "time": 21783.67, "timestamp": "06:03:03", "text": "火力。"}, {"type": "subtitle", "time": 21805.51, "timestamp": "06:03:25", "text": "你的力量就是我的力量。"}, {"type": "subtitle", "time": 21806.868, "timestamp": "06:03:26", "text": "如果你知道我为什么会"}, {"type": "subtitle", "time": 21812.788, "timestamp": "06:03:32", "text": "漂浮在水面上，就别问了。 开枪打死我们。 我的眼睛。"}, {"type": "subtitle", "time": 21823.43, "timestamp": "06:03:43", "text": "我只剩下60秒了。"}, {"type": "subtitle", "time": 21834.23, "timestamp": "06:03:54", "text": "也可能去一趟。 这就是我想要的。"}]
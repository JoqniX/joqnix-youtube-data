[{"type": "subtitle", "time": 13862.95, "timestamp": "03:51:02", "text": "抬头。 太令人难过了。 真令人沮丧。"}, {"type": "subtitle", "time": 13886.07, "timestamp": "03:51:26", "text": "我需要集中他的注意力吗？ 无需借助"}, {"type": "subtitle", "time": 13899.01, "timestamp": "03:51:39", "text": "阿伽莫托之眼来求婚。"}, {"type": "subtitle", "time": 13915.67, "timestamp": "03:51:55", "text": "这个地方有种特别的魅力。"}, {"type": "subtitle", "time": 13917.91, "timestamp": "03:51:57", "text": "月亮。"}, {"type": "subtitle", "time": 13919.349, "timestamp": "03:51:59", "text": "好吧，我这张专辑还不错。"}]
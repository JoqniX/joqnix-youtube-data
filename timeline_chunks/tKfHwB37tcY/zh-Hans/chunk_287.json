[{"type": "subtitle", "time": 17220.51, "timestamp": "04:47:00", "text": "天界队伍。 他们上"}, {"type": "subtitle", "time": 17222.59, "timestamp": "04:47:02", "text": "赛季的表现堪称天籁。"}, {"type": "subtitle", "time": 17226.59, "timestamp": "04:47:06", "text": "搞什么鬼？ 我肯定要输了。"}, {"type": "subtitle", "time": 17229.43, "timestamp": "04:47:09", "text": "现在，我要把谁逐出这场"}, {"type": "subtitle", "time": 17234.19, "timestamp": "04:47:14", "text": "比赛呢？ 我将立即"}, {"type": "subtitle", "time": 17237.628, "timestamp": "04:47:17", "text": "驱逐。 是啊，你知道吗？ 尊重。"}, {"type": "subtitle", "time": 17246.868, "timestamp": "04:47:26", "text": "。 我认为敌方全队都要"}, {"type": "subtitle", "time": 17251.23, "timestamp": "04:47:31", "text": "完蛋了。 我认为他们"}, {"type": "subtitle", "time": 17279.51, "timestamp": "04:47:59", "text": "我向上帝发誓，如果我的 Pinfest 被禁赛。"}]
[{"type": "subtitle", "time": 3660.71, "timestamp": "01:01:00", "text": "噱头。 你永远无法真正了解"}, {"type": "subtitle", "time": 3663.51, "timestamp": "01:01:03", "text": "现实生活中正在发生的事情"}, {"type": "subtitle", "time": 3666.789, "timestamp": "01:01:06", "text": "。 可能只是为了博取"}, {"type": "subtitle", "time": 3677.549, "timestamp": "01:01:17", "text": "啊，"}, {"type": "subtitle", "time": 3680.71, "timestamp": "01:01:20", "text": "现在的情况太疯狂了。 我的意思是，这就是互联网。 我们都是"}, {"type": "subtitle", "time": 3683.23, "timestamp": "01:01:23", "text": "主播。 所以从"}, {"type": "subtitle", "time": 3686.87, "timestamp": "01:01:26", "text": "某种程度上来说，剧情片似乎更容易获得点击量之类的关注"}, {"type": "subtitle", "time": 3688.549, "timestamp": "01:01:28", "text": "。 我不明白。 我不"}, {"type": "subtitle", "time": 3690.99, "timestamp": "01:01:30", "text": "明白"}, {"type": "subtitle", "time": 3693.789, "timestamp": "01:01:33", "text": "。"}, {"type": "subtitle", "time": 3696.87, "timestamp": "01:01:36", "text": "所以我一直在想，"}, {"type": "subtitle", "time": 3701.51, "timestamp": "01:01:41", "text": "如果双鱼座的人总是制造各种麻烦和戏剧性"}, {"type": "subtitle", "time": 3703.91, "timestamp": "01:01:43", "text": "事件，那他们晚上怎么能睡得"}, {"type": "subtitle", "time": 3705.87, "timestamp": "01:01:45", "text": "安稳呢？"}, {"type": "subtitle", "time": 3709.67, "timestamp": "01:01:49", "text": "你知道，他们制造了很多"}, {"type": "subtitle", "time": 3711.349, "timestamp": "01:01:51", "text": "麻烦和戏剧性事件等等。"}, {"type": "subtitle", "time": 3713.589, "timestamp": "01:01:53", "text": "他们晚上怎么睡觉？ 怎么可能还有什么"}, {"type": "subtitle", "time": 3716.39, "timestamp": "01:01:56", "text": "和平可言？"}]
[{"type": "subtitle", "time": 16627.59, "timestamp": "04:37:07", "text": "母亲的儿子。"}, {"type": "subtitle", "time": 16630.07, "timestamp": "04:37:10", "text": "我什么？"}, {"type": "subtitle", "time": 16632.47, "timestamp": "04:37:12", "text": "哇。 朋友，冷静点。 你不可能这么"}, {"type": "subtitle", "time": 16634.709, "timestamp": "04:37:14", "text": "说。 我刚秃了个头。 我的头发像"}, {"type": "subtitle", "time": 16643.75, "timestamp": "04:37:23", "text": "磁铁一样，一下子全秃了。"}, {"type": "subtitle", "time": 16647.949, "timestamp": "04:37:27", "text": "该死。 是啊，我在这边"}, {"type": "subtitle", "time": 16650.39, "timestamp": "04:37:30", "text": "表现太差劲了，都快秃顶了"}, {"type": "subtitle", "time": 16653.59, "timestamp": "04:37:33", "text": "。   是"}, {"type": "subtitle", "time": 16658.15, "timestamp": "04:37:38", "text": "啊，有时候就是这样，你知道的。"}, {"type": "subtitle", "time": 16662.629, "timestamp": "04:37:42", "text": "我有什么？ 我认为他们还没有。"}, {"type": "subtitle", "time": 16665.189, "timestamp": "04:37:45", "text": "我"}, {"type": "subtitle", "time": 16676.869, "timestamp": "04:37:56", "text": "走吧。   我"}]
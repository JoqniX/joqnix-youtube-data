[{"type": "subtitle", "time": 18316.23, "timestamp": "05:05:16", "text": "我对此无能为力。"}, {"type": "subtitle", "time": 18322.788, "timestamp": "05:05:22", "text": "天啊。 我的天哪。 我不会"}, {"type": "subtitle", "time": 18324.948, "timestamp": "05:05:24", "text": "轻易消失。"}, {"type": "subtitle", "time": 18343.27, "timestamp": "05:05:43", "text": "我隐形了吗？"}, {"type": "subtitle", "time": 18346.55, "timestamp": "05:05:46", "text": "感觉棒极了。"}, {"type": "subtitle", "time": 18348.708, "timestamp": "05:05:48", "text": "不用担心。 摸一下。 摸一下。 你"}, {"type": "subtitle", "time": 18351.51, "timestamp": "05:05:51", "text": "属于我。"}]
[{"type": "subtitle", "time": 16084.269, "timestamp": "04:28:04", "text": "好的。"}, {"type": "subtitle", "time": 16087.87, "timestamp": "04:28:07", "text": "什么？ 所以他们已经有了艾玛·弗罗斯特"}, {"type": "subtitle", "time": 16091.269, "timestamp": "04:28:11", "text": "。 他们打算加入奥创。"}, {"type": "subtitle", "time": 16093.75, "timestamp": "04:28:13", "text": "奥创。 是的。  4天后，我们将迎来"}, {"type": "subtitle", "time": 16099.03, "timestamp": "04:28:19", "text": "Oo，真好。 再次。 我不再受任何束缚"}, {"type": "subtitle", "time": 16103.349, "timestamp": "04:28:23", "text": "。 哦是的。 当然。 不再。 他说"}, {"type": "subtitle", "time": 16112.95, "timestamp": "04:28:32", "text": "还有谁应该参加？ 我觉得《刀锋战士》要"}, {"type": "subtitle", "time": 16117.11, "timestamp": "04:28:37", "text": "来了。 刀锋应该会到来。 是的，因为"}, {"type": "subtitle", "time": 16119.189, "timestamp": "04:28:39", "text": "他已经在地图之类的"}, {"type": "subtitle", "time": 16121.99, "timestamp": "04:28:41", "text": "东西里了。 是的，他在……如果你不"}, {"type": "subtitle", "time": 16124.229, "timestamp": "04:28:44", "text": "知道的话，他现在就像睡在瓦坎达一样。"}, {"type": "subtitle", "time": 16126.63, "timestamp": "04:28:46", "text": "瓦坎达。 对，他就在那里。"}, {"type": "subtitle", "time": 16128.71, "timestamp": "04:28:48", "text": "所以，睡个"}, {"type": "subtitle", "time": 16131.75, "timestamp": "04:28:51", "text": "午觉吧。 他打算在"}, {"type": "subtitle", "time": 16134.63, "timestamp": "04:28:54", "text": "下次更新前睡觉。 你为什么还在睡觉？ 他在"}, {"type": "subtitle", "time": 16137.99, "timestamp": "04:28:57", "text": "睡觉，兄弟。 他让自己睡着了。"}, {"type": "subtitle", "time": 16139.59, "timestamp": "04:28:59", "text": "哦，对了，传送。 我不知道"}]
[{"type": "subtitle", "time": 13748.469, "timestamp": "03:49:08", "text": "让他们消失吧。 我的天啊。"}, {"type": "subtitle", "time": 13750.229, "timestamp": "03:49:10", "text": "我们希望他们能成为其中一员。那意义重大。"}, {"type": "subtitle", "time": 13752.309, "timestamp": "03:49:12", "text": "这意义重大。 我的团队太棒了。"}, {"type": "subtitle", "time": 13754.55, "timestamp": "03:49:14", "text": "我的天哪，我的团队简直疯了。 我爱我的"}, {"type": "subtitle", "time": 13756.71, "timestamp": "03:49:16", "text": "团队。 我以前和人聊过天吗？ 我有没有告诉过你，"}, {"type": "subtitle", "time": 13758.79, "timestamp": "03:49:18", "text": "我现在非常爱我的球队？ 我的"}, {"type": "subtitle", "time": 13760.11, "timestamp": "03:49:20", "text": "天哪，它们太"}, {"type": "subtitle", "time": 13762.95, "timestamp": "03:49:22", "text": "好吃了。 还有，抱歉我有时会"}, {"type": "subtitle", "time": 13766.87, "timestamp": "03:49:26", "text": "安静下来，因为我需要集中注意力。我必须集中"}, {"type": "subtitle", "time": 13773.03, "timestamp": "03:49:33", "text": "你知道为什么主播"}, {"type": "subtitle", "time": 13775.67, "timestamp": "03:49:35", "text": "在游戏中经常输吗？ 那是因为"}, {"type": "subtitle", "time": 13777.91, "timestamp": "03:49:37", "text": "他们没有集中注意力。"}, {"type": "subtitle", "time": 13781.99, "timestamp": "03:49:41", "text": "我，我不会那样做。 我非常专注。"}, {"type": "subtitle", "time": 13784.389, "timestamp": "03:49:44", "text": "我努力做正确的事。"}, {"type": "subtitle", "time": 13787.429, "timestamp": "03:49:47", "text": "仔细想想，这也会让我显得像个书呆子。"}, {"type": "subtitle", "time": 13790.95, "timestamp": "03:49:50", "text": "我完全理解你的感受。 我的意思是，"}, {"type": "subtitle", "time": 13793.189, "timestamp": "03:49:53", "text": "埃及神明"}, {"type": "subtitle", "time": 13797.51, "timestamp": "03:49:57", "text": "在我脑海里低语，让我"}]
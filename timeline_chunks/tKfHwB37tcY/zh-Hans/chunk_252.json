[{"type": "subtitle", "time": 15138.55, "timestamp": "04:12:18", "text": "啊。 是的。  D 我们可以邀请你"}, {"type": "subtitle", "time": 15142.389, "timestamp": "04:12:22", "text": "加入我们。 他正在为你铺路。 是的。"}, {"type": "subtitle", "time": 15166.15, "timestamp": "04:12:46", "text": "嘿，哥们儿，最近怎么样？ 你好吗？"}, {"type": "subtitle", "time": 15168.95, "timestamp": "04:12:48", "text": "嘿，哥们儿！ 我一切都很好。 你好吗"}, {"type": "subtitle", "time": 15171.51, "timestamp": "04:12:51", "text": "？ 我只是在放松休息，你知道吗？ 我只是玩得很"}, {"type": "subtitle", "time": 15175.11, "timestamp": "04:12:55", "text": "开心。 该死。 我拥抱了"}, {"type": "subtitle", "time": 15177.99, "timestamp": "04:12:57", "text": "乔克，并告诉他，像你这样的人，"}]
[{"type": "subtitle", "time": 19873.75, "timestamp": "05:31:13", "text": "而且她也很生气。 对，就是这些"}, {"type": "subtitle", "time": 19889.67, "timestamp": "05:31:29", "text": "没人朝那个方向开枪。 有人"}, {"type": "subtitle", "time": 19900.23, "timestamp": "05:31:40", "text": "这是真火。"}, {"type": "subtitle", "time": 19915.51, "timestamp": "05:31:55", "text": "别介意摸一下。 我没碰它。"}]
[{"type": "subtitle", "time": 17487.51, "timestamp": "04:51:27", "text": "你的力量是……我已经准备好"}, {"type": "subtitle", "time": 17491.83, "timestamp": "04:51:31", "text": "表演了。 先颤抖，后禁食。"}, {"type": "subtitle", "time": 17512.15, "timestamp": "04:51:52", "text": "伙计。 我的治疗师们。 嗯，没关系。"}, {"type": "subtitle", "time": 17514.47, "timestamp": "04:51:54", "text": "对你来说太粘了。"}, {"type": "subtitle", "time": 17517.35, "timestamp": "04:51:57", "text": "好的。"}]
[{"type": "subtitle", "time": 16560.39, "timestamp": "04:36:00", "text": "食用。 现在他们确实这么做了。 这有点"}, {"type": "subtitle", "time": 16571.429, "timestamp": "04:36:11", "text": "她回来了吗？她真的回来了吗？ 我喜欢这个。"}, {"type": "subtitle", "time": 16575.269, "timestamp": "04:36:15", "text": "你们有合作时间吗？ 你喜欢这个吗，"}, {"type": "subtitle", "time": 16579.429, "timestamp": "04:36:19", "text": "哥们？ 我就是阿斯加德的威能。"}, {"type": "subtitle", "time": 16581.99, "timestamp": "04:36:21", "text": "我的天哪，他杀了两个人。 我的天哪。 我的"}, {"type": "subtitle", "time": 16587.83, "timestamp": "04:36:27", "text": "哦，那场踩踏事件。"}, {"type": "subtitle", "time": 16590.15, "timestamp": "04:36:30", "text": "印章。"}, {"type": "subtitle", "time": 16595.83, "timestamp": "04:36:35", "text": "哦，我们走吧，灵蝶。 我们可以做点什么。"}, {"type": "subtitle", "time": 16599.51, "timestamp": "04:36:39", "text": "来吧，灵蝶。 她死了。"}, {"type": "subtitle", "time": 16601.91, "timestamp": "04:36:41", "text": "她死了。 我们走吧。"}, {"type": "subtitle", "time": 16604.47, "timestamp": "04:36:44", "text": "她死了。 我可以拿着它。 我应该这么做的"}, {"type": "subtitle", "time": 16607.91, "timestamp": "04:36:47", "text": "。 妈的。"}, {"type": "subtitle", "time": 16609.949, "timestamp": "04:36:49", "text": "她像"}, {"type": "subtitle", "time": 16619.83, "timestamp": "04:36:59", "text": "什么鬼东西？ 他们拿到你的电话"}]
[{"type": "subtitle", "time": 15783.429, "timestamp": "04:23:03", "text": "。 我的天哪，那是蜘蛛侠！"}, {"type": "subtitle", "time": 15787.51, "timestamp": "04:23:07", "text": "我知道。 卧槽，那是"}, {"type": "subtitle", "time": 15796.229, "timestamp": "04:23:16", "text": "朋克独奏，我的菜。 我的天哪。"}, {"type": "subtitle", "time": 15800.07, "timestamp": "04:23:20", "text": "真是个混蛋。 真是个贱人。 他是"}, {"type": "subtitle", "time": 15802.309, "timestamp": "04:23:22", "text": "你友好的邻居蜘蛛侠。"}, {"type": "subtitle", "time": 15805.71, "timestamp": "04:23:25", "text": "它必须变得粘稠。 我希望……"}, {"type": "subtitle", "time": 15808.469, "timestamp": "04:23:28", "text": "我的天哪。 我本来可以变得"}, {"type": "subtitle", "time": 15810.63, "timestamp": "04:23:30", "text": "种族歧视，但我不会。 不。哇。 哇。"}, {"type": "subtitle", "time": 15813.349, "timestamp": "04:23:33", "text": "哇。 哇。 冷静下来。 耶稣。 所以，蜘蛛"}, {"type": "subtitle", "time": 15815.03, "timestamp": "04:23:35", "text": "种族歧视者，伙计。 什么？ 你觉得我刚才在"}, {"type": "subtitle", "time": 15818.309, "timestamp": "04:23:38", "text": "说什么？ 为什么说是种族歧视？ 嗯哼。 有人"}, {"type": "subtitle", "time": 15822.469, "timestamp": "04:23:42", "text": "愿意帮你吗？ 该死的狼蛛。"}, {"type": "subtitle", "time": 15823.83, "timestamp": "04:23:43", "text": "我的天啊。 我快要崩溃了。 我"}, {"type": "subtitle", "time": 15825.67, "timestamp": "04:23:45", "text": "快要崩溃了。 我快要崩溃了。"}, {"type": "subtitle", "time": 15827.269, "timestamp": "04:23:47", "text": "我恐怕要输了。 不要"}, {"type": "subtitle", "time": 15834.309, "timestamp": "04:23:54", "text": "一刻。 别那样做。 我真是那个"}, {"type": "subtitle", "time": 15837.75, "timestamp": "04:23:57", "text": "混蛋的绝佳目标。 是啊，我就是"}, {"type": "subtitle", "time": 15839.67, "timestamp": "04:23:59", "text": "这样。 有时就是这样。"}]
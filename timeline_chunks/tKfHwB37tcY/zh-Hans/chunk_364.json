[{"type": "subtitle", "time": 21850.23, "timestamp": "06:04:10", "text": "哦，那是熊猫捕猎吗？"}, {"type": "subtitle", "time": 21852.15, "timestamp": "06:04:12", "text": "不。等等，等等，但我以为我"}, {"type": "subtitle", "time": 21855.99, "timestamp": "06:04:15", "text": "身后有治疗师。 搞什么鬼？"}, {"type": "subtitle", "time": 21858.548, "timestamp": "06:04:18", "text": "这是真的。 不，那不是一次五角大楼"}, {"type": "subtitle", "time": 21860.31, "timestamp": "06:04:20", "text": "击杀。 呃，我一直在等它"}, {"type": "subtitle", "time": 21863.27, "timestamp": "06:04:23", "text": "和巴基组合起来。 他得了"}, {"type": "subtitle", "time": 21865.03, "timestamp": "06:04:25", "text": "三个。"}, {"type": "subtitle", "time": 21881.99, "timestamp": "06:04:41", "text": "你们必须坚持战斗，直到决出"}]
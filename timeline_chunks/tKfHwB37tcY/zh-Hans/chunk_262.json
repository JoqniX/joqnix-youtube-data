[{"type": "subtitle", "time": 15720.309, "timestamp": "04:22:00", "text": "哦，"}, {"type": "subtitle", "time": 15723.59, "timestamp": "04:22:03", "text": "对了，他所有的火箭队技能"}, {"type": "subtitle", "time": 15726.79, "timestamp": "04:22:06", "text": "现在都能治疗和伤害提升了，"}, {"type": "subtitle", "time": 15731.11, "timestamp": "04:22:11", "text": "哦，该死。 是的，你知道，伤害方面，"}, {"type": "subtitle", "time": 15734.99, "timestamp": "04:22:14", "text": "他们减少了大约"}, {"type": "subtitle", "time": 15738.07, "timestamp": "04:22:18", "text": "20% 的伤害。 但是，它造成的"}, {"type": "subtitle", "time": 15740.71, "timestamp": "04:22:20", "text": "破坏实在太大了。 我的意思是，你可以和"}, {"type": "subtitle", "time": 15742.79, "timestamp": "04:22:22", "text": "其他人一起堆叠起来，对吧？ 呃，露娜·斯诺"}, {"type": "subtitle", "time": 15746.63, "timestamp": "04:22:26", "text": "之类的。 那可就糟了。"}, {"type": "subtitle", "time": 15749.63, "timestamp": "04:22:29", "text": "大概。 我的天哪，我们的毒液"}, {"type": "subtitle", "time": 15753.51, "timestamp": "04:22:33", "text": "太棒了。 毒液，"}, {"type": "subtitle", "time": 15755.389, "timestamp": "04:22:35", "text": "我们正试图把"}, {"type": "subtitle", "time": 15758.309, "timestamp": "04:22:38", "text": "强尼装进口袋。 他的体能也得到了大幅"}, {"type": "subtitle", "time": 15765.67, "timestamp": "04:22:45", "text": "所以，哟，人类。"}, {"type": "subtitle", "time": 15767.59, "timestamp": "04:22:47", "text": "所以基本上发生的事情"}, {"type": "subtitle", "time": 15771.91, "timestamp": "04:22:51", "text": "是，我认为约翰尼可以两"}, {"type": "subtitle", "time": 15776.469, "timestamp": "04:22:56", "text": "下或一下击杀任何角色，比如"}, {"type": "subtitle", "time": 15779.83, "timestamp": "04:22:59", "text": "任何辅助输出角色"}]
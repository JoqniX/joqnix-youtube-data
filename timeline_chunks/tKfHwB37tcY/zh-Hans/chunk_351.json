[{"type": "subtitle", "time": 21068.548, "timestamp": "05:51:08", "text": "无处可藏。 你的力量就是我的力量。"}, {"type": "subtitle", "time": 21072.15, "timestamp": "05:51:12", "text": "这是回旋镖箭的真正火力"}, {"type": "subtitle", "time": 21097.628, "timestamp": "05:51:37", "text": "。 我竟然不知道自己被"}, {"type": "subtitle", "time": 21100.39, "timestamp": "05:51:40", "text": "静音了。 妈的。 我的错，各位。 我当时好像"}, {"type": "subtitle", "time": 21103.43, "timestamp": "05:51:43", "text": "愣住了。 我不知道。"}, {"type": "subtitle", "time": 21105.67, "timestamp": "05:51:45", "text": "我回来了。"}, {"type": "subtitle", "time": 21108.07, "timestamp": "05:51:48", "text": "欢迎回来。 我做了很多事。 我是一号"}, {"type": "subtitle", "time": 21109.27, "timestamp": "05:51:49", "text": "和二号。 我没意识到。 我以为我吓到"}, {"type": "subtitle", "time": 21116.23, "timestamp": "05:51:56", "text": "我马上就换，因为我不想"}, {"type": "subtitle", "time": 21117.91, "timestamp": "05:51:57", "text": "失去它。 还有，欢迎回来，"}]
[{"type": "subtitle", "time": 16381.269, "timestamp": "04:33:01", "text": "我这边会选金刚狼。"}, {"type": "subtitle", "time": 16382.79, "timestamp": "04:33:02", "text": "我以为你在故意"}, {"type": "subtitle", "time": 16385.269, "timestamp": "04:33:05", "text": "输，兄弟。 哇。 哇。 不。禁止，禁止，必须"}, {"type": "subtitle", "time": 16388.15, "timestamp": "04:33:08", "text": "禁止。 禁令。   是的"}, {"type": "subtitle", "time": 16391.349, "timestamp": "04:33:11", "text": "。 是的。 禁止使用金刚狼。"}, {"type": "subtitle", "time": 16392.83, "timestamp": "04:33:12", "text": "禁止使用"}, {"type": "subtitle", "time": 16396.15, "timestamp": "04:33:16", "text": "金刚狼。 好的。 有人害怕一只"}, {"type": "subtitle", "time": 16400.15, "timestamp": "04:33:20", "text": "毛茸茸的小家伙。"}, {"type": "subtitle", "time": 16402.07, "timestamp": "04:33:22", "text": "我的天啊。 你在看那玩意儿吗？"}, {"type": "subtitle", "time": 16403.91, "timestamp": "04:33:23", "text": "你在看那玩意儿吗？ 哦，糟糕。"}, {"type": "subtitle", "time": 16406.39, "timestamp": "04:33:26", "text": "他们除掉了蜘蛛侠。 真糟糕。"}, {"type": "subtitle", "time": 16407.99, "timestamp": "04:33:27", "text": "不。哦，你马上就会看到了"}, {"type": "subtitle", "time": 16411.99, "timestamp": "04:33:31", "text": "。 我认为第二个"}, {"type": "subtitle", "time": 16414.709, "timestamp": "04:33:34", "text": "是冰霜之王。 蜘蛛侠。"}, {"type": "subtitle", "time": 16417.15, "timestamp": "04:33:37", "text": "哦，她酒吧。 好吧"}, {"type": "subtitle", "time": 16420.15, "timestamp": "04:33:40", "text": "，妈妈等着我秀一下肌肉。"}, {"type": "subtitle", "time": 16421.91, "timestamp": "04:33:41", "text": "你知道吗？ 我还是给他看看吧，以防"}, {"type": "subtitle", "time": 16424.31, "timestamp": "04:33:44", "text": "万一。 以防万一他"}, {"type": "subtitle", "time": 16427.91, "timestamp": "04:33:47", "text": "感觉太奇怪了。 好的。"}, {"type": "subtitle", "time": 16431.109, "timestamp": "04:33:51", "text": "给他看看。 是的，我给他看了。 是的。   是的"}, {"type": "subtitle", "time": 16433.109, "timestamp": "04:33:53", "text": "，兄弟。 是的。 给他看看你的"}, {"type": "subtitle", "time": 16435.31, "timestamp": "04:33:55", "text": "万磁王。   是的"}, {"type": "subtitle", "time": 16438.51, "timestamp": "04:33:58", "text": "。 嘿，看看我。 我也有主人"}]
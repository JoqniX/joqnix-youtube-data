[{"type": "subtitle", "time": 15604.95, "timestamp": "04:20:04", "text": "我的天啊，我被"}, {"type": "subtitle", "time": 15607.91, "timestamp": "04:20:07", "text": "蜘蛛侠彻底打败了。 哦"}, {"type": "subtitle", "time": 15610.71, "timestamp": "04:20:10", "text": "不，那可不好。 我讨厌那个"}, {"type": "subtitle", "time": 15612.55, "timestamp": "04:20:12", "text": "蜘蛛侠。 哦，我回来了。 任务区域"}, {"type": "subtitle", "time": 15615.91, "timestamp": "04:20:15", "text": "是哦，我们走吧。 火箭信标。 是的，"}, {"type": "subtitle", "time": 15617.67, "timestamp": "04:20:17", "text": "我的山羊。"}, {"type": "subtitle", "time": 15620.229, "timestamp": "04:20:20", "text": "火箭，出发！ 我爱你，火箭。"}, {"type": "subtitle", "time": 15622.229, "timestamp": "04:20:22", "text": "顺便说一句，我超爱玩火箭队。 我的"}, {"type": "subtitle", "time": 15623.67, "timestamp": "04:20:23", "text": "天哪，顺便说一句，他这赛季表现太棒了"}, {"type": "subtitle", "time": 15625.75, "timestamp": "04:20:25", "text": "。 他太棒了。 是吗？ 该死。"}, {"type": "subtitle", "time": 15627.429, "timestamp": "04:20:27", "text": "好吧，我可能得回来了，兄弟。"}, {"type": "subtitle", "time": 15629.429, "timestamp": "04:20:29", "text": "圣杯！前两名治疗者，兄弟。 排名"}, {"type": "subtitle", "time": 15633.11, "timestamp": "04:20:33", "text": "前两位的治疗师简直太容易了。"}, {"type": "subtitle", "time": 15640.71, "timestamp": "04:20:40", "text": "明白了"}, {"type": "subtitle", "time": 15642.55, "timestamp": "04:20:42", "text": "。"}, {"type": "subtitle", "time": 15644.229, "timestamp": "04:20:44", "text": "哇哦。 这些治疗师没有尽到他们的"}, {"type": "subtitle", "time": 15645.99, "timestamp": "04:20:45", "text": "职责。 呃，"}, {"type": "subtitle", "time": 15648.87, "timestamp": "04:20:48", "text": "不。 他们用力过猛了。"}, {"type": "subtitle", "time": 15655.67, "timestamp": "04:20:55", "text": "确切地。  19号来了！哟，"}, {"type": "subtitle", "time": 15659.67, "timestamp": "04:20:59", "text": "太阳出来了！"}]
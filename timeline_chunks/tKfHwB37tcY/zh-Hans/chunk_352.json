[{"type": "subtitle", "time": 21121.43, "timestamp": "05:52:01", "text": "狗狗。 我们做得怎么样？ 你好。 别招惹"}, {"type": "subtitle", "time": 21124.948, "timestamp": "05:52:04", "text": "神奇蜘蛛侠。"}, {"type": "subtitle", "time": 21134.23, "timestamp": "05:52:14", "text": "这是真正的火力。"}, {"type": "subtitle", "time": 21137.31, "timestamp": "05:52:17", "text": "哦，对，我主玩鹰眼"}, {"type": "subtitle", "time": 21139.19, "timestamp": "05:52:19", "text": "。 你没玩过这款游戏。"}, {"type": "subtitle", "time": 21142.07, "timestamp": "05:52:22", "text": "你说你主玩鹰眼是什么意思？ 我以前"}, {"type": "subtitle", "time": 21151.51, "timestamp": "05:52:31", "text": "哦，是的。 嗯，如果你明白我的意思，"}, {"type": "subtitle", "time": 21165.59, "timestamp": "05:52:45", "text": "明白了。 哦，切换"}, {"type": "subtitle", "time": 21167.43, "timestamp": "05:52:47", "text": "角色完全没问题。   是的"}]
[{"type": "subtitle", "time": 18875.59, "timestamp": "05:14:35", "text": "击落。 因为我被人盯着，所以赶紧把枪打下来"}, {"type": "subtitle", "time": 18882.43, "timestamp": "05:14:42", "text": "你以为再也见不到我了"}, {"type": "subtitle", "time": 18890.948, "timestamp": "05:14:50", "text": "你知道为什么吗？ 因为没有人能亲眼"}, {"type": "subtitle", "time": 18895.19, "timestamp": "05:14:55", "text": "目睹雷神。"}, {"type": "subtitle", "time": 18897.03, "timestamp": "05:14:57", "text": "你不能用洛基吗？ 我一点"}]
[{"type": "subtitle", "time": 18780.47, "timestamp": "05:13:00", "text": "但仔细想想，还有什么比"}, {"type": "subtitle", "time": 18784.708, "timestamp": "05:13:04", "text": "并肩拯救宇宙更浪漫的呢？ 为什么"}, {"type": "subtitle", "time": 18795.868, "timestamp": "05:13:15", "text": "5 4 3 2"}, {"type": "subtitle", "time": 18798.31, "timestamp": "05:13:18", "text": "1. 你只需要占领"}, {"type": "subtitle", "time": 18801.19, "timestamp": "05:13:21", "text": "任务区域即可。 我期待的是一位钢铁"}, {"type": "subtitle", "time": 18805.83, "timestamp": "05:13:25", "text": "侠。 兄弟，我没这个能力。"}, {"type": "subtitle", "time": 18808.31, "timestamp": "05:13:28", "text": "好的，小伙子。 好的。 敌军"}, {"type": "subtitle", "time": 18836.31, "timestamp": "05:13:56", "text": "他们手里拿着传单，但我们却没东西"}, {"type": "subtitle", "time": 18838.788, "timestamp": "05:13:58", "text": "可拍。 请不要玩"}]
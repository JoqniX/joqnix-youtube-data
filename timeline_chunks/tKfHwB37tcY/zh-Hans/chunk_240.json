[{"type": "subtitle", "time": 14400.389, "timestamp": "04:00:00", "text": "打开传送门。 我几乎耗尽了所有力气。"}, {"type": "subtitle", "time": 14402.229, "timestamp": "04:00:02", "text": "他们动用了所有支援力量。 让我"}, {"type": "subtitle", "time": 14405.51, "timestamp": "04:00:05", "text": "久等吧。"}, {"type": "subtitle", "time": 14414.63, "timestamp": "04:00:14", "text": "现在别放弃我。 好多了。"}, {"type": "subtitle", "time": 14420.62, "timestamp": "04:00:20", "text": "抓到你了。"}, {"type": "subtitle", "time": 14429.67, "timestamp": "04:00:29", "text": "我的天哪。 哦。 我的天啊。"}, {"type": "subtitle", "time": 14433.59, "timestamp": "04:00:33", "text": "哦，真是漂亮的招数，对吧？"}, {"type": "subtitle", "time": 14450.229, "timestamp": "04:00:50", "text": "我的天啊。 为什么每个人都他妈的这么糟糕？"}, {"type": "subtitle", "time": 14452.309, "timestamp": "04:00:52", "text": "NR"}, {"type": "subtitle", "time": 14459.15, "timestamp": "04:00:59", "text": "我想她应该不会去"}]
[{"type": "subtitle", "time": 18551.27, "timestamp": "05:09:11", "text": "世界走向胜利。 得看看身后"}, {"type": "subtitle", "time": 18561.11, "timestamp": "05:09:21", "text": "啊，我什么都做不了，妈妈。"}, {"type": "subtitle", "time": 18563.99, "timestamp": "05:09:23", "text": "如果他们飞得"}, {"type": "subtitle", "time": 18584.47, "timestamp": "05:09:44", "text": "最大脉冲。"}, {"type": "subtitle", "time": 18587.43, "timestamp": "05:09:47", "text": "我的天啊。 我每次都是这样。 每次都是这样"}, {"type": "subtitle", "time": 18596.47, "timestamp": "05:09:56", "text": "现在或许是阻止他们的好时机了，"}, {"type": "subtitle", "time": 18599.51, "timestamp": "05:09:59", "text": "伙计们。 我对此无能为力"}]
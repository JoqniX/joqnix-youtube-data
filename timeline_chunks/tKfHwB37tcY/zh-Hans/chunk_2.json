[{"type": "subtitle", "time": 125.35, "timestamp": "00:02:05", "text": "我觉得时间"}, {"type": "subtitle", "time": 131.55, "timestamp": "00:02:11", "text": "太晚了，这很糟糕。"}, {"type": "subtitle", "time": 134.589, "timestamp": "00:02:14", "text": "你知道吗"}, {"type": "subtitle", "time": 138.71, "timestamp": "00:02:18", "text": "？ 你知道吗？ 我打算"}, {"type": "subtitle", "time": 144.39, "timestamp": "00:02:24", "text": "对时间安排做一些调整。"}, {"type": "subtitle", "time": 148.19, "timestamp": "00:02:28", "text": "例如，我们会在早上"}, {"type": "subtitle", "time": 152.39, "timestamp": "00:02:32", "text": "6 点左右开始直播。我们会在早上 6 点开始第一部分"}, {"type": "subtitle", "time": 155.22899999999998, "timestamp": "00:02:35", "text": "直播。"}, {"type": "subtitle", "time": 158.949, "timestamp": "00:02:38", "text": "然后，"}, {"type": "subtitle", "time": 165.35, "timestamp": "00:02:45", "text": "我们会在晚上 6 点开始第二部分直播。"}, {"type": "subtitle", "time": 170.47, "timestamp": "00:02:50", "text": "你们对此有何看法？"}, {"type": "subtitle", "time": 172.39, "timestamp": "00:02:52", "text": "我"}, {"type": "subtitle", "time": 176.07, "timestamp": "00:02:56", "text": "做的也是同样的事情。 上午9点，对吧？ 上午9:00"}]
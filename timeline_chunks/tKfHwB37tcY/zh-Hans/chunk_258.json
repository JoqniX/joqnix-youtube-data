[{"type": "subtitle", "time": 15481.75, "timestamp": "04:18:01", "text": "皮肤和锁喉抓握。 锁喉式"}, {"type": "subtitle", "time": 15484.469, "timestamp": "04:18:04", "text": "抓握。 我的天哪。 当你……当你抓住那个该死的……叫"}, {"type": "subtitle", "time": 15487.269, "timestamp": "04:18:07", "text": "什么"}, {"type": "subtitle", "time": 15489.59, "timestamp": "04:18:09", "text": "名字的？ 绯红女巫那玩意儿。 这就是"}, {"type": "subtitle", "time": 15492.95, "timestamp": "04:18:12", "text": "电影的巅峰之作。 我的天哪。 这才是"}, {"type": "subtitle", "time": 15495.429, "timestamp": "04:18:15", "text": "电影的巅峰之作。 我的天啊。 有一次我玩游戏的时候，"}, {"type": "subtitle", "time": 15499.59, "timestamp": "04:18:19", "text": "我觉得我们其中一个扮演艾玛·弗罗斯特的人"}, {"type": "subtitle", "time": 15502.79, "timestamp": "04:18:22", "text": "抓住了星爵的所有东西。"}, {"type": "subtitle", "time": 15506.87, "timestamp": "04:18:26", "text": "她突然抓住了“我的天哪”。   我"}, {"type": "subtitle", "time": 15512.229, "timestamp": "04:18:32", "text": "做不到那种事。 我做不到那种事。   一把"}, {"type": "subtitle", "time": 15513.99, "timestamp": "04:18:33", "text": "把你从你那该死的权力"}, {"type": "subtitle", "time": 15517.349, "timestamp": "04:18:37", "text": "靴里拽出来，呃，小白脸，你"}, {"type": "subtitle", "time": 15520.469, "timestamp": "04:18:40", "text": "今晚别想再干那种事了。"}, {"type": "subtitle", "time": 15522.95, "timestamp": "04:18:42", "text": "没什么了不起的，小子。 那"}, {"type": "subtitle", "time": 15525.67, "timestamp": "04:18:45", "text": "是什么？"}, {"type": "subtitle", "time": 15528.63, "timestamp": "04:18:48", "text": "你不可能成为传奇人物。"}, {"type": "subtitle", "time": 15532.71, "timestamp": "04:18:52", "text": "哦，是的。 另外，我认为这次罢工是"}, {"type": "subtitle", "time": 15534.87, "timestamp": "04:18:54", "text": "因为……我想你认识Necros吧"}, {"type": "subtitle", "time": 15537.99, "timestamp": "04:18:57", "text": "？ 死灵法师。 是的，我认识他。   是的"}]
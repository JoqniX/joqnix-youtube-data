[{"type": "subtitle", "time": 17283.948, "timestamp": "04:48:03", "text": "我向上帝发誓，伙计们。 哦，感谢上帝。 没有"}, {"type": "subtitle", "time": 17285.868, "timestamp": "04:48:05", "text": "火箭。"}, {"type": "subtitle", "time": 17288.47, "timestamp": "04:48:08", "text": "什么？ 但他们心知肚明。 我猜也是。"}, {"type": "subtitle", "time": 17290.47, "timestamp": "04:48:10", "text": "他们知道。"}, {"type": "subtitle", "time": 17302.07, "timestamp": "04:48:22", "text": "服务器大概两秒钟。 给"}]
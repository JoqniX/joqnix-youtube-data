[{"type": "subtitle", "time": 15541.03, "timestamp": "04:19:01", "text": "。 是的。 我觉得这就像"}, {"type": "subtitle", "time": 15543.269, "timestamp": "04:19:03", "text": "第一季里的一个很老的片段。 他的意思是说，治疗"}, {"type": "subtitle", "time": 15546.07, "timestamp": "04:19:06", "text": "师"}, {"type": "subtitle", "time": 15548.309, "timestamp": "04:19:08", "text": "没有技能。 你知道，这是"}, {"type": "subtitle", "time": 15551.349, "timestamp": "04:19:11", "text": "你能扮演的最简单的角色。 他们中了"}, {"type": "subtitle", "time": 15553.99, "timestamp": "04:19:13", "text": "愤怒的圈套。 不。是的。 不，不，他"}, {"type": "subtitle", "time": 15555.269, "timestamp": "04:19:15", "text": "没有理会那些煽动愤怒的言论。 你知道，"}, {"type": "subtitle", "time": 15557.429, "timestamp": "04:19:17", "text": "就是第一季。 不，不。他是在激怒"}, {"type": "subtitle", "time": 15560.149, "timestamp": "04:19:20", "text": "其他人。"}, {"type": "subtitle", "time": 15562.87, "timestamp": "04:19:22", "text": "不，他只是生气了，"}, {"type": "subtitle", "time": 15565.429, "timestamp": "04:19:25", "text": "因为第一赛季好像是"}, {"type": "subtitle", "time": 15567.03, "timestamp": "04:19:27", "text": "三个治疗者的版本，"}, {"type": "subtitle", "time": 15569.99, "timestamp": "04:19:29", "text": "对吧？ 没有人死亡。 所以这就是"}, {"type": "subtitle", "time": 15572.229, "timestamp": "04:19:32", "text": "他生气的原因，有人断章取义，把事情搞得"}, {"type": "subtitle", "time": 15578.79, "timestamp": "04:19:38", "text": "一团糟。 哦好的。"}, {"type": "subtitle", "time": 15582.309, "timestamp": "04:19:42", "text": "这就是他们说“是”的原因。"}, {"type": "subtitle", "time": 15584.87, "timestamp": "04:19:44", "text": "完成任务。 这就是为什么"}, {"type": "subtitle", "time": 15589.269, "timestamp": "04:19:49", "text": "所有这些治疗师都他妈的"}, {"type": "subtitle", "time": 15592.149, "timestamp": "04:19:52", "text": "罢工了。 这是最令人难过的话"}, {"type": "subtitle", "time": 15593.83, "timestamp": "04:19:53", "text": "。 医护人员"}, {"type": "subtitle", "time": 15595.349, "timestamp": "04:19:55", "text": "罢工。 这到底是什么？是"}, {"type": "subtitle", "time": 15598.07, "timestamp": "04:19:58", "text": "啊，这简直就是《守望先锋》的翻版"}]
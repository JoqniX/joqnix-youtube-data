[{"type": "subtitle", "time": 16862.83, "timestamp": "04:41:02", "text": "你竟敢侮辱国王？"}, {"type": "subtitle", "time": 16866.23, "timestamp": "04:41:06", "text": "所以，你知道吗？ 不，我应该感到自豪，因为我"}, {"type": "subtitle", "time": 16868.47, "timestamp": "04:41:08", "text": "已经走到这一步了，而且在上一局比赛中我还"}, {"type": "subtitle", "time": 16871.99, "timestamp": "04:41:11", "text": "打了输出位。"}, {"type": "subtitle", "time": 16888.23, "timestamp": "04:41:28", "text": "我们与你同行。 我们与你同行。 我会帮"}, {"type": "subtitle", "time": 16891.67, "timestamp": "04:41:31", "text": "你包扎好。 谢谢。 谁来帮"}]
[{"type": "subtitle", "time": 3660.71, "timestamp": "01:01:00", "text": "策略とも言えるでしょう。 現実世界で何が起こっているのか、あなたは決して知ることはできません"}, {"type": "subtitle", "time": 3666.789, "timestamp": "01:01:06", "text": "。 単に"}, {"type": "subtitle", "time": 3677.549, "timestamp": "01:01:17", "text": "、"}, {"type": "subtitle", "time": 3680.71, "timestamp": "01:01:20", "text": "今は確かに大変な状況だよ。 だって、インターネットなんだから。 私たちは皆、"}, {"type": "subtitle", "time": 3683.23, "timestamp": "01:01:23", "text": "配信者です。 つまり、ある"}, {"type": "subtitle", "time": 3686.87, "timestamp": "01:01:26", "text": "意味では、ドラマの方が視聴回数などが伸びるみたいですね"}, {"type": "subtitle", "time": 3688.549, "timestamp": "01:01:28", "text": "。 理解できません。 私には"}, {"type": "subtitle", "time": 3690.99, "timestamp": "01:01:30", "text": "理解できません"}, {"type": "subtitle", "time": 3693.789, "timestamp": "01:01:33", "text": "。"}, {"type": "subtitle", "time": 3696.87, "timestamp": "01:01:36", "text": "だから私が思うのは、"}, {"type": "subtitle", "time": 3701.51, "timestamp": "01:01:41", "text": "魚座の人たちがドラマや"}, {"type": "subtitle", "time": 3703.91, "timestamp": "01:01:43", "text": "トラブルを起こしている時、どうやって夜は安らかに眠れるのかということだけです"}, {"type": "subtitle", "time": 3711.349, "timestamp": "01:01:51", "text": "。だって、あんなにたくさんの騒動やドラマを引き起こしているのに。"}, {"type": "subtitle", "time": 3713.589, "timestamp": "01:01:53", "text": "彼らは夜、どのように眠るのでしょうか？ インターネット上には"}, {"type": "subtitle", "time": 3716.39, "timestamp": "01:01:56", "text": "文字通り"}, {"type": "subtitle", "time": 3718.789, "timestamp": "01:01:58", "text": "何千もの殺害予告があり、"}]
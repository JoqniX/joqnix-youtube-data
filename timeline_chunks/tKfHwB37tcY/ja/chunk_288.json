[{"type": "subtitle", "time": 17283.948, "timestamp": "04:48:03", "text": "神に誓って、みんな。 ああ、よかった。"}, {"type": "subtitle", "time": 17285.868, "timestamp": "04:48:05", "text": "ロケットはなし。"}, {"type": "subtitle", "time": 17288.47, "timestamp": "04:48:08", "text": "何？ しかし、彼らは知っている。 私は推測する。"}, {"type": "subtitle", "time": 17290.47, "timestamp": "04:48:10", "text": "彼らは知っている。"}, {"type": "subtitle", "time": 17302.07, "timestamp": "04:48:22", "text": "2秒くらい席を外します。 ちょっと待って"}]
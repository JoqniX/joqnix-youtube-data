[{"type": "subtitle", "time": 16142.229, "timestamp": "04:29:02", "text": "テレポート装置がどこから来たのかは分からない。 ああ、あった"}, {"type": "subtitle", "time": 16144.469, "timestamp": "04:29:04", "text": "。   キル・ディスが"}, {"type": "subtitle", "time": 16146.95, "timestamp": "04:29:06", "text": "来る。 こいつを殺せ。"}, {"type": "subtitle", "time": 16148.07, "timestamp": "04:29:08", "text": "こいつを殺せ。 こいつを殺せ。 こいつを殺せ。"}, {"type": "subtitle", "time": 16151.59, "timestamp": "04:29:11", "text": "こいつを殺せ。 なんてこった。 どうでも。"}, {"type": "subtitle", "time": 16153.269, "timestamp": "04:29:13", "text": "全員。 他に誰を追加すべきだろうか？"}, {"type": "subtitle", "time": 16156.309, "timestamp": "04:29:16", "text": "おい、デッドプールも追加すべきだろ。"}, {"type": "subtitle", "time": 16157.99, "timestamp": "04:29:17", "text": "デッドプール。 私が何を望んでいるか、わかりますか？ もし"}, {"type": "subtitle", "time": 16161.59, "timestamp": "04:29:21", "text": "デッドプールが追加されるとしたら。 うん。"}, {"type": "subtitle", "time": 16163.83, "timestamp": "04:29:23", "text": "彼がヒーラーであること。"}, {"type": "subtitle", "time": 16167.51, "timestamp": "04:29:27", "text": "デッドプールのヒーラー。 うん。 何てことだ。"}, {"type": "subtitle", "time": 16169.189, "timestamp": "04:29:29", "text": "ロケットと同じだ。 彼はまるで"}, {"type": "subtitle", "time": 16171.99, "timestamp": "04:29:31", "text": "跳ね返るようにヒールを投げ出す。 彼はただ"}, {"type": "subtitle", "time": 16174.71, "timestamp": "04:29:34", "text": "チンチョンガスを投げつけてくるだけだ。"}, {"type": "subtitle", "time": 16176.55, "timestamp": "04:29:36", "text": "彼は「ほら、兄弟。それを食え"}, {"type": "subtitle", "time": 16181.59, "timestamp": "04:29:41", "text": "時間はある。 私はただ"}, {"type": "subtitle", "time": 16184.91, "timestamp": "04:29:44", "text": "チームを待っているだけです。 おい、彼の究極技は、"}, {"type": "subtitle", "time": 16189.91, "timestamp": "04:29:49", "text": "マーベルVSカプコンのハイパーXコンボと同じで、"}, {"type": "subtitle", "time": 16192.07, "timestamp": "04:29:52", "text": "体力ゲージを取り出して、その"}]
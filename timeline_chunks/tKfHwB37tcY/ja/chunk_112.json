[{"type": "subtitle", "time": 6720.96, "timestamp": "01:52:00", "text": "山火事の生存計画があります。"}, {"type": "subtitle", "time": 6723.95, "timestamp": "01:52:03", "text": "[音楽]"}, {"type": "subtitle", "time": 6732.229, "timestamp": "01:52:12", "text": "もちろん、ゲームプレイ設定を選択しても"}, {"type": "subtitle", "time": 6735.229, "timestamp": "01:52:15", "text": "前進できません。ここでどれくらいあるか見てください。"}, {"type": "subtitle", "time": 6738.99, "timestamp": "01:52:18", "text": "つまり、"}, {"type": "subtitle", "time": 6741.79, "timestamp": "01:52:21", "text": "ビタミン"}, {"type": "subtitle", "time": 6744.709, "timestamp": "01:52:24", "text": "Cを抑制したくないのであれば、答えは遅いですが、選択は"}, {"type": "subtitle", "time": 6752.229, "timestamp": "01:52:32", "text": "あなた次第です。 ああ、こんにちは、本物。 ああ、それは"}, {"type": "subtitle", "time": 6754.14, "timestamp": "01:52:34", "text": "あなたですか？"}, {"type": "subtitle", "time": 6757.47, "timestamp": "01:52:37", "text": "【音楽】"}, {"type": "subtitle", "time": 6762.709, "timestamp": "01:52:42", "text": "こんにちは。 バズを食べなかったら、後悔することになるよ。"}, {"type": "subtitle", "time": 6764.79, "timestamp": "01:52:44", "text": "まあ、発症はゆっくりだ。 この概念は"}, {"type": "subtitle", "time": 6767.95, "timestamp": "01:52:47", "text": "健康分野にも応用できる。 選択は"}, {"type": "subtitle", "time": 6770.03, "timestamp": "01:52:50", "text": "あなた次第です。 ビタミン"}, {"type": "subtitle", "time": 6773.189, "timestamp": "01:52:53", "text": "C。無効にしようと思います。 いいえ、私たちは"}, {"type": "subtitle", "time": 6778.03, "timestamp": "01:52:58", "text": "生き残ることを経験するのです。 それでは、有効にします"}]
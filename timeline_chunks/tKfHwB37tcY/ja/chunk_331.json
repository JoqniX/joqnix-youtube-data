[{"type": "subtitle", "time": 19873.75, "timestamp": "05:31:13", "text": "彼女はただ怒っているだけでもある。 そう、こいつらだよ"}, {"type": "subtitle", "time": 19889.67, "timestamp": "05:31:29", "text": "誰もそっちを撃ってないよ。 誰か"}, {"type": "subtitle", "time": 19900.23, "timestamp": "05:31:40", "text": "これは本物の炎だ。"}, {"type": "subtitle", "time": 19915.51, "timestamp": "05:31:55", "text": "触ってみるだけだよ。 私はそれには触らない。   もうどうでもいい"}]
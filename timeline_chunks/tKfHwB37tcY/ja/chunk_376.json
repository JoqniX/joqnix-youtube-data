[{"type": "subtitle", "time": 22561.788, "timestamp": "06:16:01", "text": "ええ、"}, {"type": "subtitle", "time": 22568.548, "timestamp": "06:16:08", "text": "ブラッドがチャットを見ることができなかった理由を調べているときに、"}, {"type": "subtitle", "time": 22571.67, "timestamp": "06:16:11", "text": "認証をリセットしました。"}, {"type": "subtitle", "time": 22575.27, "timestamp": "06:16:15", "text": "オープン プラットフォーム コード、Buildably オープン"}, {"type": "subtitle", "time": 22577.23, "timestamp": "06:16:17", "text": "プラットフォーム コード。 鍵を変えました"}, {"type": "subtitle", "time": 22587.43, "timestamp": "06:16:27", "text": "起こったように感じるんです。 念のため確認させてください。 今、"}, {"type": "subtitle", "time": 22589.19, "timestamp": "06:16:29", "text": "生放送中です。"}, {"type": "subtitle", "time": 22592.07, "timestamp": "06:16:32", "text": "これは"}, {"type": "subtitle", "time": 22595.15, "timestamp": "06:16:35", "text": "認証コードが"}, {"type": "subtitle", "time": 22599.39, "timestamp": "06:16:39", "text": "存在する、通常の匿名接続です。 私が「test one, two,"}, {"type": "subtitle", "time": 22602.31, "timestamp": "06:16:42", "text": "three」と入力すると、私がストリーマーであることが示され、"}, {"type": "subtitle", "time": 22617.39, "timestamp": "06:16:57", "text": "えっと、これの最新のアップデート内容は"}]
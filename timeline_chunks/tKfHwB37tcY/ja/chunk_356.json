[{"type": "subtitle", "time": 21372.948, "timestamp": "05:56:12", "text": "ああ、神様。 火力。"}, {"type": "subtitle", "time": 21387.11, "timestamp": "05:56:27", "text": "お前の力は私のものだ、お前は殺す。 何てことだ"}, {"type": "subtitle", "time": 21389.11, "timestamp": "05:56:29", "text": "。"}, {"type": "subtitle", "time": 21390.708, "timestamp": "05:56:30", "text": "あなたはそうしたくないでしょう。 ええ、私は"}, {"type": "subtitle", "time": 21405.67, "timestamp": "05:56:45", "text": "おお。 俺がヒーラーだと思ってんのか？ 私は"}, {"type": "subtitle", "time": 21413.31, "timestamp": "05:56:53", "text": "俺はそれを[ __ ]してプレイする"}, {"type": "subtitle", "time": 21416.628, "timestamp": "05:56:56", "text": "、奴らはそうするのか？"}, {"type": "subtitle", "time": 21418.628, "timestamp": "05:56:58", "text": "私はヒーラーはプレイしません。"}]
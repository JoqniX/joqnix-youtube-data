[{"type": "subtitle", "time": 22623.11, "timestamp": "06:17:03", "text": "？ あ、直しました。"}, {"type": "subtitle", "time": 22630.788, "timestamp": "06:17:10", "text": "明らかに、アクセスして見ていることはわかっています。あなたが参加している場合は、"}, {"type": "subtitle", "time": 22634.07, "timestamp": "06:17:14", "text": "聞きたくないアカウントを変更します。待ってください。"}, {"type": "subtitle", "time": 22639.31, "timestamp": "06:17:19", "text": "大観衆の地域では、この"}, {"type": "subtitle", "time": 22642.07, "timestamp": "06:17:22", "text": "明らかなキーを知っています。これは、"}, {"type": "subtitle", "time": 22645.91, "timestamp": "06:17:25", "text": "高エネルギー リストに使用されるアカウントを他のユーザーが見ることになります。つまり、同期的に"}, {"type": "subtitle", "time": 22651.75, "timestamp": "06:17:31", "text": "ログインするコンソールへのアクセスを理解している場合は、"}, {"type": "subtitle", "time": 22657.03, "timestamp": "06:17:37", "text": "本当に参加していると見なされる可能性があります。"}, {"type": "subtitle", "time": 22658.788, "timestamp": "06:17:38", "text": "小さなアカウントを使用していて、"}, {"type": "subtitle", "time": 22662.23, "timestamp": "06:17:42", "text": "アカウントが不要な場合は、わかりません。"}, {"type": "subtitle", "time": 22673.708, "timestamp": "06:17:53", "text": "[音楽] わかりました。どうやら、"}]
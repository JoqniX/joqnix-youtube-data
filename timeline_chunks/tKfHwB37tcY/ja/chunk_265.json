[{"type": "subtitle", "time": 15900.389, "timestamp": "04:25:00", "text": "人よ。"}, {"type": "subtitle", "time": 15902.469, "timestamp": "04:25:02", "text": "声優たちが"}, {"type": "subtitle", "time": 15905.91, "timestamp": "04:25:05", "text": "このゲームをプレイしている配信を見たことがありますか？ はい。 ああ、本当に"}, {"type": "subtitle", "time": 15908.469, "timestamp": "04:25:08", "text": "美味しい。 とても美味しいです。 非常識な。 非常識な。"}, {"type": "subtitle", "time": 15910.71, "timestamp": "04:25:10", "text": "彼らは主に、私が好きなのは、"}, {"type": "subtitle", "time": 15912.87, "timestamp": "04:25:12", "text": "声優のほうがもっと好きだと思う。ああ、彼の"}, {"type": "subtitle", "time": 15917.67, "timestamp": "04:25:17", "text": "配信は良い。 そうだよ、相棒。 もちろんさ。"}, {"type": "subtitle", "time": 15925.03, "timestamp": "04:25:25", "text": "これがうまくいくことを、これがうまくいくことを、これがうまくいくことを願っているが、"}, {"type": "subtitle", "time": 15929.189, "timestamp": "04:25:29", "text": "そう言うべきではない。"}, {"type": "subtitle", "time": 15931.99, "timestamp": "04:25:31", "text": "そう言っておくべきだった。 スパイダーマンはまずアイアンマンに集中する"}, {"type": "subtitle", "time": 15934.149, "timestamp": "04:25:34", "text": "。"}, {"type": "subtitle", "time": 15939.83, "timestamp": "04:25:39", "text": "ええ、このキャラクターは本当に素晴らしいですね。"}, {"type": "subtitle", "time": 15943.83, "timestamp": "04:25:43", "text": "ヒューマン・トーチは16歳で4歳。"}, {"type": "subtitle", "time": 15945.59, "timestamp": "04:25:45", "text": "スパイダーマンは彼にとって最大の対抗馬であり、スパイダーマンは"}, {"type": "subtitle", "time": 15959.59, "timestamp": "04:25:59", "text": "。 ありがとう。 ありがとう。"}]
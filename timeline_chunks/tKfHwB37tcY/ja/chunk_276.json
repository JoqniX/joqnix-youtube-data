[{"type": "subtitle", "time": 16560.39, "timestamp": "04:36:00", "text": "それをどう組み合わせたらいいのか分からなかった。 今ではそうなっています。 そしてそれは、ちょっと"}, {"type": "subtitle", "time": 16571.429, "timestamp": "04:36:11", "text": "彼女は戻ってきたのか、それとも戻ってきたのか？ これ大好き。"}, {"type": "subtitle", "time": 16575.269, "timestamp": "04:36:15", "text": "共同作業の時間はありますか？ これ、気に入ったかい"}, {"type": "subtitle", "time": 16579.429, "timestamp": "04:36:19", "text": "？ 私はアスガルドの力そのものだ。   なんて"}, {"type": "subtitle", "time": 16581.99, "timestamp": "04:36:21", "text": "ことだ、彼は2人も殺したんだ。 なんてこった。 ああ、"}, {"type": "subtitle", "time": 16587.83, "timestamp": "04:36:27", "text": "ああ、群衆の殺到だ。"}, {"type": "subtitle", "time": 16590.15, "timestamp": "04:36:30", "text": "スタンピー。   いや"}, {"type": "subtitle", "time": 16595.83, "timestamp": "04:36:35", "text": "さあ、サイロック、行こう！ 私たちにも"}, {"type": "subtitle", "time": 16599.51, "timestamp": "04:36:39", "text": "何かできることがある。 さあ、サイロック。 彼女は死んだ。"}, {"type": "subtitle", "time": 16601.91, "timestamp": "04:36:41", "text": "彼女は死んだ。 さあ行こう。"}, {"type": "subtitle", "time": 16604.47, "timestamp": "04:36:44", "text": "彼女は死んだ。 これは私が持てる。 私はそうすべきだった"}, {"type": "subtitle", "time": 16607.91, "timestamp": "04:36:47", "text": "。 ああ、くそ。"}, {"type": "subtitle", "time": 16609.949, "timestamp": "04:36:49", "text": "彼女は"}, {"type": "subtitle", "time": 16619.83, "timestamp": "04:36:59", "text": "何だったんだ？ 彼らはあなたの電話"}]
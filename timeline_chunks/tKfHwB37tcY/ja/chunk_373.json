[{"type": "subtitle", "time": 22383.23, "timestamp": "06:13:03", "text": "。"}, {"type": "subtitle", "time": 22388.07, "timestamp": "06:13:08", "text": "卒業。 くそ。  3,0031万7千人が"}, {"type": "subtitle", "time": 22396.67, "timestamp": "06:13:16", "text": "人数だ。"}, {"type": "subtitle", "time": 22400.39, "timestamp": "06:13:20", "text": "大丈夫。 アクアの卒業式には欠席しませんでした。"}, {"type": "subtitle", "time": 22407.59, "timestamp": "06:13:27", "text": "私にとってとても大切な場所だったからです。 持続する。 とにかく、"}, {"type": "subtitle", "time": 22424.99, "timestamp": "06:13:44", "text": "安全のために、配達時の設定を変更させてください。 ああ、プラットフォームに何か不具合があったのですか？ ああ"}, {"type": "subtitle", "time": 22428.15, "timestamp": "06:13:48", "text": "、そうだ。 チャットボックスの設定を変えたのを忘れてたんだけど"}, {"type": "subtitle", "time": 22430.19, "timestamp": "06:13:50", "text": "、"}, {"type": "subtitle", "time": 22431.55, "timestamp": "06:13:51", "text": "そうだよね？"}, {"type": "subtitle", "time": 22433.47, "timestamp": "06:13:53", "text": "[音楽]"}]
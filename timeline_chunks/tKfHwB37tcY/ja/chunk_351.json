[{"type": "subtitle", "time": 21068.548, "timestamp": "05:51:08", "text": "隠れる場所はない。 君の力は私のものだ。"}, {"type": "subtitle", "time": 21072.15, "timestamp": "05:51:12", "text": "これはブーメラン矢の真の火力だ"}, {"type": "subtitle", "time": 21097.628, "timestamp": "05:51:37", "text": "ああ、くそ。 自分がミュートされていたなんて知らなかった"}, {"type": "subtitle", "time": 21100.39, "timestamp": "05:51:40", "text": "。 ああ、くそ。 ごめん、みんな。"}, {"type": "subtitle", "time": 21103.43, "timestamp": "05:51:43", "text": "一瞬ミュート状態になった。 知りませんでした。   戻ってきました"}, {"type": "subtitle", "time": 21105.67, "timestamp": "05:51:45", "text": "。   おかえり"}, {"type": "subtitle", "time": 21108.07, "timestamp": "05:51:48", "text": "。 私は本当にたくさんのことをやっています。 私は1と"}, {"type": "subtitle", "time": 21109.27, "timestamp": "05:51:49", "text": "2です。 気づきませんでした。 私は自分が"}, {"type": "subtitle", "time": 21116.23, "timestamp": "05:51:56", "text": "切り替えます。"}, {"type": "subtitle", "time": 21117.91, "timestamp": "05:51:57", "text": "失くしたくないので。 それから、犬よ、おかえりなさい"}]
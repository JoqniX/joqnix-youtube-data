[{"type": "subtitle", "time": 1510.029, "timestamp": "00:25:10", "text": "日曜日から日曜日に変更しようかと考えました。 それは"}, {"type": "subtitle", "time": 1513.23, "timestamp": "00:25:13", "text": "5月3日です。 いいえ、5月4日です。"}, {"type": "subtitle", "time": 1518.43, "timestamp": "00:25:18", "text": "5月の計画については、まだ"}, {"type": "subtitle", "time": 1522.07, "timestamp": "00:25:22", "text": "検討中だと"}, {"type": "subtitle", "time": 1523.71, "timestamp": "00:25:23", "text": "思います。"}, {"type": "chat", "time": 1524.664, "timestamp": "00:25:24", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "have a watchalong ig, chill time"}, {"type": "subtitle", "time": 1526.71, "timestamp": "00:25:26", "text": "えっと、"}, {"type": "subtitle", "time": 1529.99, "timestamp": "00:25:29", "text": "5月に大規模な崩壊が起こっているんですが、それでも私は"}, {"type": "subtitle", "time": 1533.51, "timestamp": "00:25:33", "text": "3日間の休暇を取る予定です。 だから、"}, {"type": "subtitle", "time": 1536.83, "timestamp": "00:25:36", "text": "3日間はドーピングマラソンを中断するか、規模を縮小しなければならない"}, {"type": "subtitle", "time": 1540.909, "timestamp": "00:25:40", "text": "。"}, {"type": "subtitle", "time": 1544.23, "timestamp": "00:25:44", "text": "一緒に見てみましょう。 昨晩「"}, {"type": "subtitle", "time": 1552.549, "timestamp": "00:25:52", "text": "英雄X」を観た後、昨晩の午前5時にそのことを考えていました"}, {"type": "subtitle", "time": 1556.149, "timestamp": "00:25:56", "text": "。 えっと、暇な時は一緒に見てみようかな"}, {"type": "chat", "time": 1557.059, "timestamp": "00:25:57", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "5am is not night"}]
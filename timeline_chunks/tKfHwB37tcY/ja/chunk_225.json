[{"type": "subtitle", "time": 13502.63, "timestamp": "03:45:02", "text": "ええ、分かりません。 彼は混雑した中で、たった"}, {"type": "subtitle", "time": 13504.79, "timestamp": "03:45:04", "text": "5人くらいに配信しているだけだと知っています"}, {"type": "subtitle", "time": 13513.11, "timestamp": "03:45:13", "text": "。 心配ない。 それはまさに"}, {"type": "subtitle", "time": 13544.269, "timestamp": "03:45:44", "text": "食事に行くよ。"}]
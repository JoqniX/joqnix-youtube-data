[{"type": "subtitle", "time": 18551.27, "timestamp": "05:09:11", "text": "世界を勝利へ。 後ろを振り返ってみないと"}, {"type": "subtitle", "time": 18561.11, "timestamp": "05:09:21", "text": "ああ、私には何もできないよ、お母さん。 あんなに"}, {"type": "subtitle", "time": 18584.47, "timestamp": "05:09:44", "text": "最大脈拍数です。   何てことだ"}, {"type": "subtitle", "time": 18587.43, "timestamp": "05:09:47", "text": "。 私は毎回そうなんです。 毎回そうなるんです"}, {"type": "subtitle", "time": 18596.47, "timestamp": "05:09:56", "text": "今こそ彼らを止めるべき時かもしれないよ、"}, {"type": "subtitle", "time": 18599.51, "timestamp": "05:09:59", "text": "みんな。 私には"}]
[{"type": "subtitle", "time": 15421.189, "timestamp": "04:17:01", "text": "いいえ。つまり、"}, {"type": "subtitle", "time": 15423.11, "timestamp": "04:17:03", "text": "今起きていることは、ヒーラーが"}, {"type": "subtitle", "time": 15424.71, "timestamp": "04:17:04", "text": "ヒーラーとしての役割を果たしていないということです。 ヒーラーメインのプレイヤーは誰もヒーラーをプレイせず、"}, {"type": "subtitle", "time": 15429.03, "timestamp": "04:17:09", "text": "スパイダーマンやホークアイなどに切り替えて、"}, {"type": "subtitle", "time": 15432.149, "timestamp": "04:17:12", "text": "DPSにヒーラーをプレイさせている。 はぁ？"}, {"type": "subtitle", "time": 15435.51, "timestamp": "04:17:15", "text": "それが今起きていることです。 何？   だから今は"}, {"type": "subtitle", "time": 15437.11, "timestamp": "04:17:17", "text": "EUサーバーには接続していないんだ。あんな面倒なことに巻き込まれたくないからね"}, {"type": "subtitle", "time": 15441.269, "timestamp": "04:17:21", "text": "。 それは私が対処します。 なるほど、納得です"}, {"type": "subtitle", "time": 15445.51, "timestamp": "04:17:25", "text": "。 私の素晴らしいえーと、"}, {"type": "subtitle", "time": 15447.75, "timestamp": "04:17:27", "text": "もう一度どういう意味ですか？"}, {"type": "subtitle", "time": 15449.99, "timestamp": "04:17:29", "text": "私はマグニートーをプレイしますが、"}, {"type": "subtitle", "time": 15457.03, "timestamp": "04:17:37", "text": "ああ、主にマグニートーですね。 私は"}, {"type": "subtitle", "time": 15459.59, "timestamp": "04:17:39", "text": "基本的に、なぜ私たちは"}, {"type": "subtitle", "time": 15467.189, "timestamp": "04:17:47", "text": "エマ・フロスト。"}, {"type": "subtitle", "time": 15473.349, "timestamp": "04:17:53", "text": "本人だ。 彼女は良い"}, {"type": "subtitle", "time": 15475.03, "timestamp": "04:17:55", "text": "キャラクターですらないのに、みんなあのスキン目当てで彼女を使うんだ"}, {"type": "subtitle", "time": 15478.389, "timestamp": "04:17:58", "text": "。"}]
[{"type": "subtitle", "time": 18000.03, "timestamp": "05:00:00", "text": "しまった。 それはとても"}, {"type": "subtitle", "time": 18002.788, "timestamp": "05:00:02", "text": "クールです。 これ、皆さんご覧になりましたか"}, {"type": "subtitle", "time": 18007.15, "timestamp": "05:00:07", "text": "？ お見せしましょう。 このロキのスキンは"}, {"type": "subtitle", "time": 18010.868, "timestamp": "05:00:10", "text": "良いんだけど、伝説級にふさわしいほど良いかどうかは分からないんだよね"}, {"type": "subtitle", "time": 18019.91, "timestamp": "05:00:19", "text": "。 彼らは2人の魔法使いだ。"}, {"type": "subtitle", "time": 18022.15, "timestamp": "05:00:22", "text": "それは悲しいですね。 それはとても悲しいことだ。"}, {"type": "subtitle", "time": 18023.91, "timestamp": "05:00:23", "text": "魔法。 あなたは今日、どのヒーローになりたいですか"}, {"type": "subtitle", "time": 18033.03, "timestamp": "05:00:33", "text": "とにかく、私は行けます。"}, {"type": "subtitle", "time": 18038.708, "timestamp": "05:00:38", "text": "できます。"}, {"type": "subtitle", "time": 18040.39, "timestamp": "05:00:40", "text": "いいえ、もしあなたが遊びたいなら、構いませんよ"}, {"type": "subtitle", "time": 18052.19, "timestamp": "05:00:52", "text": "この地図上で、私は、ええと、そうしたいんです。"}, {"type": "subtitle", "time": 18054.51, "timestamp": "05:00:54", "text": "ああ、"}, {"type": "subtitle", "time": 18058.43, "timestamp": "05:00:58", "text": "簡単だよ。 平和と同じくらい単純なことは、"}]
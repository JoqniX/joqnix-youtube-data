[{"type": "subtitle", "time": 22861.11, "timestamp": "06:21:01", "text": "秒。 中空デッキはどこにありますか？ だから、"}, {"type": "subtitle", "time": 22863.59, "timestamp": "06:21:03", "text": "私の"}, {"type": "subtitle", "time": 22867.07, "timestamp": "06:21:07", "text": "コラボレーションをすべて追加する必要があります。 つまり、私たちは合計"}, {"type": "subtitle", "time": 22886.57, "timestamp": "06:21:26", "text": "アイデアがあるんです。 ええと、音楽関係の8人なら"}, {"type": "subtitle", "time": 22891.31, "timestamp": "06:21:31", "text": "、おそらくこんな感じのことができるでしょう"}, {"type": "subtitle", "time": 22900.19, "timestamp": "06:21:40", "text": "。 ということで、コラボのホストはロイ・"}, {"type": "subtitle", "time": 22909.83, "timestamp": "06:21:49", "text": "こちらでご覧いただけます。 だから、もし本物の配信が見つかれば、リオの配信を載せるつもりだ"}, {"type": "subtitle", "time": 22917.35, "timestamp": "06:21:57", "text": "。 うーん、すごくクールなチャンネルですね。 あ、待って。"}]
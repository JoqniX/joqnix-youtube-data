[{"type": "subtitle", "time": 18187.99, "timestamp": "05:03:07", "text": "ああ、ちょっと後ろにもたれかかってる。"}, {"type": "subtitle", "time": 18190.708, "timestamp": "05:03:10", "text": "少しだけストレートに言わせてください。 それは"}, {"type": "subtitle", "time": 18193.03, "timestamp": "05:03:13", "text": "役に立つと思う。"}, {"type": "subtitle", "time": 18195.51, "timestamp": "05:03:15", "text": "見えない。"}, {"type": "subtitle", "time": 18197.19, "timestamp": "05:03:17", "text": "スパイダーマンがいる。 スパイダーマンを見たばかりだ"}, {"type": "subtitle", "time": 18227.23, "timestamp": "05:03:47", "text": "何？ 私は"}, {"type": "subtitle", "time": 18229.43, "timestamp": "05:03:49", "text": "遅れているのでしょうか？ 私は死んだのか？ 私はそのことさえ知らなかった"}]
[{"type": "subtitle", "time": 14359.229, "timestamp": "03:59:19", "text": "ずっと"}, {"type": "subtitle", "time": 14363.91, "timestamp": "03:59:23", "text": "良くなった。 まっすぐこちらに向かってきます。"}, {"type": "subtitle", "time": 14366.07, "timestamp": "03:59:26", "text": "敵を追え。"}, {"type": "subtitle", "time": 14367.91, "timestamp": "03:59:27", "text": "おお、素敵な動きですね？"}, {"type": "subtitle", "time": 14380.71, "timestamp": "03:59:40", "text": "これは本物の炎だ。 最大限。"}, {"type": "subtitle", "time": 14394.07, "timestamp": "03:59:54", "text": "よし、全員私の方を選んだ。 はい、"}]
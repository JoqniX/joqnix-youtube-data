[{"type": "subtitle", "time": 3780.95, "timestamp": "01:03:00", "text": "インターネットを開いて"}, {"type": "subtitle", "time": 3783.75, "timestamp": "01:03:03", "text": "Twitterを見ると、人々が"}, {"type": "subtitle", "time": 3786.069, "timestamp": "01:03:06", "text": "自分の仕事"}, {"type": "subtitle", "time": 3788.95, "timestamp": "01:03:08", "text": "や存在をどれだけ評価してくれているかが分かり、"}, {"type": "subtitle", "time": 3791.75, "timestamp": "01:03:11", "text": "心が温かくなって、"}, {"type": "subtitle", "time": 3793.47, "timestamp": "01:03:13", "text": "ベストを尽くし続けようという気持ちになります。"}, {"type": "subtitle", "time": 3796.39, "timestamp": "01:03:16", "text": "いいえ、でも現実世界はそうではないと分かっています"}, {"type": "subtitle", "time": 3798.91, "timestamp": "01:03:18", "text": "。 賛否両論です。"}, {"type": "subtitle", "time": 3801.87, "timestamp": "01:03:21", "text": "音楽には、"}, {"type": "subtitle", "time": 3805.349, "timestamp": "01:03:25", "text": "良い面、つまり応援してくれる人たちがいる一方で、"}, {"type": "subtitle", "time": 3815.47, "timestamp": "01:03:35", "text": "。   では、なぜ"}, {"type": "subtitle", "time": 3824.63, "timestamp": "01:03:44", "text": "嫉妬する必要があるのでしょうか？ 誰もがゼロからスタートする。"}, {"type": "subtitle", "time": 3835.63, "timestamp": "01:03:55", "text": "【音楽】"}, {"type": "subtitle", "time": 3838.39, "timestamp": "01:03:58", "text": "そうですね。 しかし、この嫉妬心というものは"}]
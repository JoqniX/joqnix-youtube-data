[{"type": "subtitle", "time": 23307.19, "timestamp": "06:28:27", "text": "神よ、私は一体何を見ているのですか？   ああ、なんてことだ、なんてことだってたくさん"}, {"type": "subtitle", "time": 23329.75, "timestamp": "06:28:49", "text": "。 何てことだ。 なぜ？ なぜ私の短い"}, {"type": "subtitle", "time": 23333.51, "timestamp": "06:28:53", "text": "矢印が削除されないのですか？ え、何？ それ"}, {"type": "subtitle", "time": 23336.23, "timestamp": "06:28:56", "text": "はまずい。"}, {"type": "subtitle", "time": 23338.708, "timestamp": "06:28:58", "text": "それはまずい。 それはまずい。 これはまずい。"}, {"type": "subtitle", "time": 23339.788, "timestamp": "06:28:59", "text": "これは"}]
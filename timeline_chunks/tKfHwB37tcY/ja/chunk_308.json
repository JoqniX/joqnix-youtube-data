[{"type": "subtitle", "time": 18482.47, "timestamp": "05:08:02", "text": "地獄が解き放たれた。"}, {"type": "subtitle", "time": 18502.15, "timestamp": "05:08:22", "text": "ああ、なんてことだ、タール。 私のミスです。 私は"}, {"type": "subtitle", "time": 18511.27, "timestamp": "05:08:31", "text": "ええ、それは良い選択ですね。"}, {"type": "subtitle", "time": 18514.35, "timestamp": "05:08:34", "text": "アイアンマン。 ミッティングのこの選択は良いね。"}, {"type": "subtitle", "time": 18517.628, "timestamp": "05:08:37", "text": "このチームはすごく攻撃的だから"}, {"type": "subtitle", "time": 18521.11, "timestamp": "05:08:41", "text": "。"}, {"type": "subtitle", "time": 18530.708, "timestamp": "05:08:50", "text": "でも、彼を倒したいんです。   どういたしまして"}, {"type": "subtitle", "time": 18533.03, "timestamp": "05:08:53", "text": "。 最高の気分だ。 残り"}, {"type": "subtitle", "time": 18536.15, "timestamp": "05:08:56", "text": "30秒。"}, {"type": "subtitle", "time": 18538.15, "timestamp": "05:08:58", "text": "私は船に乗ります。"}]
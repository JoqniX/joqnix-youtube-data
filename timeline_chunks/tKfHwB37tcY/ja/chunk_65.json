[{"type": "subtitle", "time": 3906.789, "timestamp": "01:05:06", "text": "なぜ自分がこんな気持ちになるのか理解できた。 なぜ"}, {"type": "subtitle", "time": 3910.109, "timestamp": "01:05:10", "text": "私は親友に対してこんな気持ちになったのだろう"}, {"type": "subtitle", "time": 3913.109, "timestamp": "01:05:13", "text": "？ 単に彼らのほうが私より視聴者数が多いからというだけです"}, {"type": "subtitle", "time": 3915.309, "timestamp": "01:05:15", "text": "。 彼らの方が"}, {"type": "chat", "time": 3916.046, "timestamp": "01:05:16", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "wut is blud yapping about"}, {"type": "subtitle", "time": 3917.829, "timestamp": "01:05:17", "text": "私よりも忠実なコミュニティを持っているから。 単に、彼らは"}, {"type": "subtitle", "time": 3920.63, "timestamp": "01:05:20", "text": "私よりもコンテンツ制作が上手だから。"}, {"type": "subtitle", "time": 3922.71, "timestamp": "01:05:22", "text": "彼らの方が私より優れたモデルを持っているからというだけの理由で"}, {"type": "chat", "time": 3924.167, "timestamp": "01:05:24", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "why is blud thinking too deep"}, {"type": "subtitle", "time": 3924.99, "timestamp": "01:05:24", "text": "。 などなど。"}, {"type": "subtitle", "time": 3929.27, "timestamp": "01:05:29", "text": "なぜこのような感覚になるのでしょうか？ これが"}, {"type": "subtitle", "time": 3932.23, "timestamp": "01:05:32", "text": "私がこんな気持ちになる理由なのか、とか。私は"}, {"type": "subtitle", "time": 3935.91, "timestamp": "01:05:35", "text": "変なのか、とか。ずいぶん昔にそう思っていました"}, {"type": "subtitle", "time": 3943.349, "timestamp": "01:05:43", "text": "。 そして、ある意味でこれは"}, {"type": "subtitle", "time": 3949.109, "timestamp": "01:05:49", "text": "普通のことだと気づいた。 それはごく自然な感情です。 しかし、一つ"}, {"type": "subtitle", "time": 3951.349, "timestamp": "01:05:51", "text": "確かなことは、"}, {"type": "subtitle", "time": 3953.67, "timestamp": "01:05:53", "text": "この感情をコントロールし"}, {"type": "subtitle", "time": 3957.309, "timestamp": "01:05:57", "text": "、方向転換させ、再構築し、自分自身に結びつける必要があるということです"}]
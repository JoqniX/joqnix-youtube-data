[{"type": "subtitle", "time": 21600.948, "timestamp": "06:00:00", "text": "マグニートーを持っていて、すべてが"}, {"type": "subtitle", "time": 21604.708, "timestamp": "06:00:04", "text": "マーベルのようでした。  DCキャラクターはどうでしょうか？"}, {"type": "subtitle", "time": 21607.51, "timestamp": "06:00:07", "text": "彼らには一体何が起こるのか？"}, {"type": "subtitle", "time": 21612.948, "timestamp": "06:00:12", "text": "スーパーマンとかそういうDCキャラクターが何なのか知りたいですか？"}, {"type": "subtitle", "time": 21616.868, "timestamp": "06:00:16", "text": "バットマン、スーパーマン。 ああ、なんてことだ、"}, {"type": "subtitle", "time": 21622.07, "timestamp": "06:00:22", "text": "私はF評価だ。失礼しました。 いいえ、私は治ってきていると"}, {"type": "subtitle", "time": 21624.31, "timestamp": "06:00:24", "text": "思っていました。 ああ、そうしないといけないかもしれない。DCは"}, {"type": "subtitle", "time": 21632.948, "timestamp": "06:00:32", "text": "独自のM DCライバルを作るだろう。"}, {"type": "subtitle", "time": 21635.83, "timestamp": "06:00:35", "text": "私はそうは思いません。 彼らは"}, {"type": "subtitle", "time": 21638.31, "timestamp": "06:00:38", "text": "今、マーベルのライバルと協力して、それをここに置けばいいだけだ"}, {"type": "subtitle", "time": 21640.91, "timestamp": "06:00:40", "text": "。 登場"}, {"type": "subtitle", "time": 21643.31, "timestamp": "06:00:43", "text": "人物全員。 なんてこった。"}, {"type": "subtitle", "time": 21649.43, "timestamp": "06:00:49", "text": "人々は、マーベル対DCのチーム"}, {"type": "subtitle", "time": 21659.35, "timestamp": "06:00:59", "text": "ああ、いやいやいやいや、彼はただ、なぜ"}]
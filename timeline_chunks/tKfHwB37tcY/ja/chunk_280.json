[{"type": "subtitle", "time": 16805.47, "timestamp": "04:40:05", "text": "皆さん、"}, {"type": "subtitle", "time": 16809.31, "timestamp": "04:40:09", "text": "今日はケビンを獲得してダイヤモンドに到達できると思います"}, {"type": "subtitle", "time": 16832.15, "timestamp": "04:40:32", "text": "ミニオンたちによる、実に魅力的なゲームプレイ。 魅力的だ。   第"}, {"type": "subtitle", "time": 16835.35, "timestamp": "04:40:35", "text": "2ラウンド。 間違ったことの方が"}, {"type": "subtitle", "time": 16843.43, "timestamp": "04:40:43", "text": "くそ。 うちの選手たちは優秀だ。 私の部下たちは"}, {"type": "subtitle", "time": 16847.708, "timestamp": "04:40:47", "text": "30"}, {"type": "subtitle", "time": 16849.47, "timestamp": "04:40:49", "text": "秒。"}, {"type": "subtitle", "time": 16851.59, "timestamp": "04:40:51", "text": "準備してください。 正直に言うと"}, {"type": "subtitle", "time": 16852.948, "timestamp": "04:40:52", "text": "、またこの順位にいるべきではないと思っています"}, {"type": "subtitle", "time": 16854.948, "timestamp": "04:40:54", "text": "。 考えれば考えるほど"}]
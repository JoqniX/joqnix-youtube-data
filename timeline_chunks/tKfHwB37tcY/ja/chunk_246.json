[{"type": "subtitle", "time": 14762.229, "timestamp": "04:06:02", "text": "やったー。 私は抱きしめられるのが好きです。 私は"}, {"type": "subtitle", "time": 14765.03, "timestamp": "04:06:05", "text": "抱っこされるのが好きです。 何してるの？"}, {"type": "subtitle", "time": 14780.63, "timestamp": "04:06:20", "text": "この人、面白い。 来て。 もう一度。"}, {"type": "subtitle", "time": 14781.59, "timestamp": "04:06:21", "text": "もう一度。 来て。 来て。 来て"}, {"type": "subtitle", "time": 14783.91, "timestamp": "04:06:23", "text": "。 行く。 行く。"}, {"type": "subtitle", "time": 14785.99, "timestamp": "04:06:25", "text": "うん。"}, {"type": "subtitle", "time": 14790.15, "timestamp": "04:06:30", "text": "ああ、彼らは"}, {"type": "subtitle", "time": 14791.429, "timestamp": "04:06:31", "text": "同じ曲を演奏している。 ああ、彼らはペンディを持っている。"}, {"type": "subtitle", "time": 14800.229, "timestamp": "04:06:40", "text": "。 わかった。 わかった。 わかった。 わかった。 わかった。   わかった"}, {"type": "subtitle", "time": 14801.99, "timestamp": "04:06:41", "text": "。 わかった。 わかった。 うん。 待っています"}, {"type": "subtitle", "time": 14803.269, "timestamp": "04:06:43", "text": "。 待っています。 待ってるよ"}, {"type": "subtitle", "time": 14805.03, "timestamp": "04:06:45", "text": "、君。 私は"}, {"type": "subtitle", "time": 14813.03, "timestamp": "04:06:53", "text": "ちなみに、私はそれを捕まえました。 誰も"}]
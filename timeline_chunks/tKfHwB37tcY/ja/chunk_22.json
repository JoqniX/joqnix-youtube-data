[{"type": "subtitle", "time": 1323.27, "timestamp": "00:22:03", "text": "優れていると思いませんか？  M いや、だから"}, {"type": "subtitle", "time": 1325.63, "timestamp": "00:22:05", "text": "私は Roku に尋ねたんだ。Roku は"}, {"type": "subtitle", "time": 1332.87, "timestamp": "00:22:12", "text": "このコラボレーションのホストなんだ。 だから、例えば"}, {"type": "subtitle", "time": 1336.63, "timestamp": "00:22:16", "text": "3時間なら大丈夫だけど、7時間、8時間、9時間、いや、"}, {"type": "subtitle", "time": 1341.31, "timestamp": "00:22:21", "text": "7時間から8時間、8時間から9時間なら大丈夫。つまり2時間。"}, {"type": "subtitle", "time": 1344.47, "timestamp": "00:22:24", "text": "えっと、2、3時間で終わりです。3"}, {"type": "subtitle", "time": 1347.19, "timestamp": "00:22:27", "text": "時間以上かかる場合は、2つ"}, {"type": "subtitle", "time": 1355.19, "timestamp": "00:22:35", "text": "ストリームを作成した方が良いでしょう。 うん、"}, {"type": "subtitle", "time": 1357.99, "timestamp": "00:22:37", "text": "2つ目の配信をした方がずっといいよ。だって、今は中断されちゃうから、中断しないといけないんだ。中断するんじゃなくて、"}, {"type": "subtitle", "time": 1363.43, "timestamp": "00:22:43", "text": "ミュートされるけど、"}, {"type": "subtitle", "time": 1365.909, "timestamp": "00:22:45", "text": "コラボが行われている間は自分で中断しないといけないんだ"}, {"type": "subtitle", "time": 1367.87, "timestamp": "00:22:47", "text": "。 本当に頭痛の種だ。"}, {"type": "subtitle", "time": 1370.71, "timestamp": "00:22:50", "text": "はぁ？ 右。 それに、"}, {"type": "subtitle", "time": 1373.63, "timestamp": "00:22:53", "text": "頭痛もしたくないんです。"}, {"type": "subtitle", "time": 1377.029, "timestamp": "00:22:57", "text": "右。 私の記憶が正しければ、えーと、愛沙結衣さんとの"}]
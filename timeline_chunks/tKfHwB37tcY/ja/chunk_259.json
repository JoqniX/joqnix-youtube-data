[{"type": "subtitle", "time": 15541.03, "timestamp": "04:19:01", "text": "うん。 うん。 彼はただ、それは"}, {"type": "subtitle", "time": 15543.269, "timestamp": "04:19:03", "text": "シーズン1のような非常に古いクリップだと思う。 彼は、ヒーラーには"}, {"type": "subtitle", "time": 15548.309, "timestamp": "04:19:08", "text": "スキルがないと言っている。 ほら、それは"}, {"type": "subtitle", "time": 15551.349, "timestamp": "04:19:11", "text": "君が演じられる役の中で一番簡単な役だよ。 彼らは"}, {"type": "subtitle", "time": 15553.99, "timestamp": "04:19:13", "text": "怒りを煽る罠にまんまと引っかかった。 いいえ。ええ。 いや、違う。彼は"}, {"type": "subtitle", "time": 15555.269, "timestamp": "04:19:15", "text": "怒りを煽るような真似はしなかった。"}, {"type": "subtitle", "time": 15557.429, "timestamp": "04:19:17", "text": "シーズン1のことです。 いや、違う。彼は"}, {"type": "subtitle", "time": 15560.149, "timestamp": "04:19:20", "text": "他の人たちを挑発したんだ。"}, {"type": "subtitle", "time": 15562.87, "timestamp": "04:19:22", "text": "いや、彼はただ怒っていただけだよ。"}, {"type": "subtitle", "time": 15565.429, "timestamp": "04:19:25", "text": "シーズン1では、"}, {"type": "subtitle", "time": 15567.03, "timestamp": "04:19:27", "text": "3人のヒーラーが主流だったんだよね"}, {"type": "subtitle", "time": 15569.99, "timestamp": "04:19:29", "text": "？ 誰も死んでいなかった。 だから"}, {"type": "subtitle", "time": 15572.229, "timestamp": "04:19:32", "text": "彼は怒っていたのに、誰かがそれを"}, {"type": "subtitle", "time": 15574.87, "timestamp": "04:19:34", "text": "文脈から切り離して、とんでもない"}, {"type": "subtitle", "time": 15578.79, "timestamp": "04:19:38", "text": "大騒ぎにしてしまったんだ。 ああ、わかりました。"}, {"type": "subtitle", "time": 15582.309, "timestamp": "04:19:42", "text": "それが彼らがそうする理由です。"}, {"type": "subtitle", "time": 15584.87, "timestamp": "04:19:44", "text": "任務を遂行する。 だから"}, {"type": "subtitle", "time": 15589.269, "timestamp": "04:19:49", "text": "ヒーラーたちはみんな"}, {"type": "subtitle", "time": 15592.149, "timestamp": "04:19:52", "text": "ストライキを起こしてるんだよ。 それは"}, {"type": "subtitle", "time": 15593.83, "timestamp": "04:19:53", "text": "人が言う言葉の中で最も悲しい言葉だ。 治療師たちが"}, {"type": "subtitle", "time": 15595.349, "timestamp": "04:19:55", "text": "ストライキ中。 これは一体何なんだろう？ああ"}, {"type": "subtitle", "time": 15598.07, "timestamp": "04:19:58", "text": "、まるでオーバーウォッチ1の再来みたいだね"}]
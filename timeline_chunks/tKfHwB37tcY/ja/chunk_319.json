[{"type": "subtitle", "time": 19140.43, "timestamp": "05:19:00", "text": "私は"}, {"type": "subtitle", "time": 19150.67, "timestamp": "05:19:10", "text": "さて、誰を追放しようか？ そうそう。"}, {"type": "subtitle", "time": 19153.75, "timestamp": "05:19:13", "text": "女の子、毎日の女の子、仲間、"}, {"type": "subtitle", "time": 19166.59, "timestamp": "05:19:26", "text": "なぜ彼らはキャプテンを禁止するのですか"}, {"type": "subtitle", "time": 19168.948, "timestamp": "05:19:28", "text": "？"}, {"type": "subtitle", "time": 19171.19, "timestamp": "05:19:31", "text": "何か見落としているのかな？ 敵チームにはとんでもなく"}, {"type": "subtitle", "time": 19180.91, "timestamp": "05:19:40", "text": "キャプテンがいるの？ なぜキャップをするのか？ つまり、ターゲット"}, {"type": "subtitle", "time": 19183.19, "timestamp": "05:19:43", "text": "禁止とか、こういう人たちは"}, {"type": "subtitle", "time": 19187.15, "timestamp": "05:19:47", "text": "トラウマとか何かを抱えているとか。 このキャップはとても"}]
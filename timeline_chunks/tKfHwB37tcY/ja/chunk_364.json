[{"type": "subtitle", "time": 21850.23, "timestamp": "06:04:10", "text": "ああ、あれはパンダを仕留めた事件だったのか？"}, {"type": "subtitle", "time": 21852.15, "timestamp": "06:04:12", "text": "いや、待って、でも私の"}, {"type": "subtitle", "time": 21855.99, "timestamp": "06:04:15", "text": "後ろにヒーラーがいると思ったんだけど。 一体どういうことだ？"}, {"type": "subtitle", "time": 21858.548, "timestamp": "06:04:18", "text": "これは現実です。 いいえ、あれはペントキルではありませんでした"}, {"type": "subtitle", "time": 21860.31, "timestamp": "06:04:20", "text": "。 えっと、"}, {"type": "subtitle", "time": 21863.27, "timestamp": "06:04:23", "text": "バッキーとコンボするのを待っていたんです。 彼は"}, {"type": "subtitle", "time": 21865.03, "timestamp": "06:04:25", "text": "３つくらい手に入れたよ。"}]
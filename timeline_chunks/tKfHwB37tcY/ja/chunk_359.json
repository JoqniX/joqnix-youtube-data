[{"type": "subtitle", "time": 21559.91, "timestamp": "05:59:19", "text": "うん。 だから壁がこんなに"}, {"type": "subtitle", "time": 21567.83, "timestamp": "05:59:27", "text": "あなたは誘拐される。"}, {"type": "subtitle", "time": 21575.35, "timestamp": "05:59:35", "text": "グルートはほぼ毎回のゲームで禁止されるんだ。"}, {"type": "subtitle", "time": 21577.83, "timestamp": "05:59:37", "text": "なぜなら、"}, {"type": "subtitle", "time": 21581.03, "timestamp": "05:59:41", "text": "自分のグループがないと、敵グループにほぼ確実にやられてしまうから"}, {"type": "subtitle", "time": 21585.19, "timestamp": "05:59:45", "text": "。 実に単純な話だ。   実に"}]
[{"type": "subtitle", "time": 17220.51, "timestamp": "04:47:00", "text": "天界の存在であることを意味する。 彼らは昨"}, {"type": "subtitle", "time": 17222.59, "timestamp": "04:47:02", "text": "シーズン、まさに天上の存在だった。 一体どういうことだ"}, {"type": "subtitle", "time": 17226.59, "timestamp": "04:47:06", "text": "？ 私はこれに負けるだろう。"}, {"type": "subtitle", "time": 17229.43, "timestamp": "04:47:09", "text": "さて、この試合から誰を追放しようか"}, {"type": "subtitle", "time": 17234.19, "timestamp": "04:47:14", "text": "？ 最も速やかに、私は"}, {"type": "subtitle", "time": 17237.628, "timestamp": "04:47:17", "text": "追放するつもりです。 うん、そうだね。 尊敬。"}, {"type": "subtitle", "time": 17246.868, "timestamp": "04:47:26", "text": "。 敵チームは全員"}, {"type": "subtitle", "time": 17251.23, "timestamp": "04:47:31", "text": "berに行くと思う。 そうだと思います"}, {"type": "subtitle", "time": 17279.51, "timestamp": "04:47:59", "text": "もし私がピンフェストを禁止されたら、神に誓って。"}]
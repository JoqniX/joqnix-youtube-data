[{"type": "subtitle", "time": 18063.51, "timestamp": "05:01:03", "text": "Bを禁止することだ。なぜなら、もし相手に優秀なプレイヤーがいたら、"}, {"type": "subtitle", "time": 18065.91, "timestamp": "05:01:05", "text": "我々はボコボコにされるからだ。"}, {"type": "subtitle", "time": 18067.51, "timestamp": "05:01:07", "text": "我々は完全にやられるだろう。"}, {"type": "subtitle", "time": 18069.31, "timestamp": "05:01:09", "text": "なぜなら彼は"}, {"type": "subtitle", "time": 18071.99, "timestamp": "05:01:11", "text": "皆と同じように戦車を壁で囲んで、そしてドーンと"}, {"type": "subtitle", "time": 18098.788, "timestamp": "05:01:38", "text": "[音楽]を演奏できるでしょうか？"}, {"type": "subtitle", "time": 18100.55, "timestamp": "05:01:40", "text": "正しいヒーローがいれば、すべてが"}, {"type": "subtitle", "time": 18102.47, "timestamp": "05:01:42", "text": "変わるかもしれません。 私はひっそりと目立たないようにするタイプではない"}, {"type": "subtitle", "time": 18111.27, "timestamp": "05:01:51", "text": "えっと、今回はロキで行くべきかな？"}]
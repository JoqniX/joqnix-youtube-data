[{"type": "subtitle", "time": 14708.389, "timestamp": "04:05:08", "text": "現在のスコアはチャットです。 私は"}, {"type": "subtitle", "time": 14710.07, "timestamp": "04:05:10", "text": "良いプレーをしているだろうか？ だって、自分が"}, {"type": "subtitle", "time": 14711.99, "timestamp": "04:05:11", "text": "TPSに集中しすぎていることに気づかなかったんだ。 うん。"}, {"type": "subtitle", "time": 14713.83, "timestamp": "04:05:13", "text": "チャド、私はうまくやっているだろうか？"}, {"type": "subtitle", "time": 14717.03, "timestamp": "04:05:17", "text": "あなたがどちらの側に立っているかも含めて、私はまあまあうまくやっていると思います。"}, {"type": "subtitle", "time": 14720.229, "timestamp": "04:05:20", "text": "ただチャットしているだけです。"}, {"type": "subtitle", "time": 14723.11, "timestamp": "04:05:23", "text": "私の友達の一人に、あの男がいるんだけど、知ってる"}, {"type": "subtitle", "time": 14726.87, "timestamp": "04:05:26", "text": "？ いいえ、彼の名前は明かしません。 私の"}, {"type": "subtitle", "time": 14729.03, "timestamp": "04:05:29", "text": "立場。 私は狼のように振る舞うつもりです。なぜなら、"}, {"type": "subtitle", "time": 14731.269, "timestamp": "04:05:31", "text": "もし彼らがまた同じことをしてきたら"}, {"type": "subtitle", "time": 14739.51, "timestamp": "04:05:39", "text": "それと、確かに私はそれほどDPSは高くない"}, {"type": "subtitle", "time": 14741.51, "timestamp": "04:05:41", "text": "けど、今はかなり"}, {"type": "subtitle", "time": 14743.03, "timestamp": "04:05:43", "text": "いい感じでプレイできてるよ。 ほら、私は賢く立ち回ってるんだよ。 私は"}, {"type": "subtitle", "time": 14745.83, "timestamp": "04:05:45", "text": "戦車のようなものを目指しています。 サブキャラで結構サクサクレベル上げできてて"}, {"type": "subtitle", "time": 14747.83, "timestamp": "04:05:47", "text": "、すごく"}, {"type": "subtitle", "time": 14750.469, "timestamp": "04:05:50", "text": "いい感じ。"}, {"type": "subtitle", "time": 14752.11, "timestamp": "04:05:52", "text": "私がやっていることは、あまり"}, {"type": "subtitle", "time": 14755.99, "timestamp": "04:05:55", "text": "良いことではありません。   おいおい"}, {"type": "subtitle", "time": 14758.91, "timestamp": "04:05:58", "text": "、頼むよ。"}]
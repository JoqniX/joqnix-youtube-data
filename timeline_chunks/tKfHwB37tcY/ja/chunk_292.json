[{"type": "subtitle", "time": 17520.31, "timestamp": "04:52:00", "text": "。 そして今、地獄の業火を"}, {"type": "subtitle", "time": 17552.15, "timestamp": "04:52:32", "text": "ああ、うちの治療師たちが次々と死んでいく。 彼女は"}, {"type": "subtitle", "time": 17556.15, "timestamp": "04:52:36", "text": "彼女を癒したらすぐに逃げるべきだった。"}, {"type": "subtitle", "time": 17558.868, "timestamp": "04:52:38", "text": "鶏肉より美味しい。"}, {"type": "subtitle", "time": 17561.67, "timestamp": "04:52:41", "text": "私も今は調子が悪いです。 くそっ。"}, {"type": "subtitle", "time": 17573.43, "timestamp": "04:52:53", "text": "君の力は私のものだ。 私は準備ができています。 ほら、"}]
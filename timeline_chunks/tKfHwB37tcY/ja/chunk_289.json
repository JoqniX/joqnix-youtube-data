[{"type": "subtitle", "time": 17342.948, "timestamp": "04:49:02", "text": "こんにちは。"}, {"type": "subtitle", "time": 17348.55, "timestamp": "04:49:08", "text": "なぜ私たちが"}, {"type": "subtitle", "time": 17350.948, "timestamp": "04:49:10", "text": "その試合に負けたのか、あなたは分かっていると思います。 みんな、"}, {"type": "subtitle", "time": 17353.75, "timestamp": "04:49:13", "text": "Dが去ったからだってことはわかってるよね。 ホットロードヘッドの尻が左に出て、"}, {"type": "subtitle", "time": 17356.23, "timestamp": "04:49:16", "text": "私たちはゲームに負けました。 戦いは"}, {"type": "subtitle", "time": 17359.75, "timestamp": "04:49:19", "text": "5分後に始まる。 くそ。 くそ。"}, {"type": "subtitle", "time": 17362.31, "timestamp": "04:49:22", "text": "それは私たちにとってそれほど大きな損害だった。 あなたがすべきことは、"}, {"type": "subtitle", "time": 17364.39, "timestamp": "04:49:24", "text": "任務エリアを占領することだけです。"}, {"type": "subtitle", "time": 17371.03, "timestamp": "04:49:31", "text": "ここに透明人間がいたらいいのに。"}, {"type": "subtitle", "time": 17373.43, "timestamp": "04:49:33", "text": "でも、ここのチームなら"}, {"type": "subtitle", "time": 17375.03, "timestamp": "04:49:35", "text": "君を治せるよ。"}]
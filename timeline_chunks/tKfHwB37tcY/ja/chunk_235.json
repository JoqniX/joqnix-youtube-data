[{"type": "subtitle", "time": 14101.349, "timestamp": "03:55:01", "text": "敵チームのもう一人のムーンナイトについて話していました。彼らは、"}, {"type": "subtitle", "time": 14105.15, "timestamp": "03:55:05", "text": "敵チームに彼がいたために負けたのです。"}, {"type": "subtitle", "time": 14119.51, "timestamp": "03:55:19", "text": "？ 誓って言うけど、こいつは"}, {"type": "subtitle", "time": 14123.389, "timestamp": "03:55:23", "text": "強化版パート2だ。 ああ、なんてことだ"}, {"type": "subtitle", "time": 14125.63, "timestamp": "03:55:25", "text": "。 ああ、"}, {"type": "subtitle", "time": 14131.269, "timestamp": "03:55:31", "text": "それは"}, {"type": "subtitle", "time": 14136.07, "timestamp": "03:55:36", "text": "見ていて悲しいことだ。 それは悲しいことだね、僕とは違って。"}, {"type": "subtitle", "time": 14138.87, "timestamp": "03:55:38", "text": "ああ、今ならお見せできますよ。"}, {"type": "subtitle", "time": 14144.429, "timestamp": "03:55:44", "text": "その画像を見ると、私も2、3試合負けたことがわかります"}, {"type": "subtitle", "time": 14147.189, "timestamp": "03:55:47", "text": "。 わかった。 わかった。 彼らは"}, {"type": "subtitle", "time": 14149.309, "timestamp": "03:55:49", "text": "ダイヤモンドを持っているし、私たちも"}, {"type": "subtitle", "time": 14154.349, "timestamp": "03:55:54", "text": "ダイヤモンドを持っている。 それはとても、とても"}, {"type": "subtitle", "time": 14156.79, "timestamp": "03:55:56", "text": "素晴らしいです。 奇妙な選手がいます。"}, {"type": "subtitle", "time": 14159.63, "timestamp": "03:55:59", "text": "スパイダーマンのプレイヤーもいますよ"}]
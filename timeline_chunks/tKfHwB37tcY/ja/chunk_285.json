[{"type": "subtitle", "time": 17100.15, "timestamp": "04:45:00", "text": "いいえ、私は気づいています。"}, {"type": "subtitle", "time": 17104.31, "timestamp": "04:45:04", "text": "これは本物の火力だ。 これは本物の"}, {"type": "subtitle", "time": 17106.948, "timestamp": "04:45:06", "text": "火力だ。"}, {"type": "subtitle", "time": 17109.43, "timestamp": "04:45:09", "text": "最後の10秒。   何てことだ"}, {"type": "subtitle", "time": 17111.19, "timestamp": "04:45:11", "text": "。 何てことだ。 何てことだ。 何てことだ"}, {"type": "subtitle", "time": 17114.15, "timestamp": "04:45:14", "text": "。   ああ、なんてことだ"}, {"type": "subtitle", "time": 17117.27, "timestamp": "04:45:17", "text": "。 何？ これは"}, {"type": "subtitle", "time": 17119.83, "timestamp": "04:45:19", "text": "ホークアイですか？ 彼はとにかく何でも打ち返している。"}, {"type": "subtitle", "time": 17121.51, "timestamp": "04:45:21", "text": "彼は前回の試合では全く打てなかった。"}, {"type": "subtitle", "time": 17122.948, "timestamp": "04:45:22", "text": "今や彼はあらゆるボールを打ち返している。 一体どういうことだ"}, {"type": "subtitle", "time": 17124.51, "timestamp": "04:45:24", "text": "？"}, {"type": "subtitle", "time": 17135.948, "timestamp": "04:45:35", "text": "一体何が起こっているんだ？ 私たちは"}, {"type": "subtitle", "time": 17144.91, "timestamp": "04:45:44", "text": "何だって"}, {"type": "subtitle", "time": 17148.708, "timestamp": "04:45:48", "text": "？ えっと、どうしてそうしないの？ まあ、"}, {"type": "subtitle", "time": 17152.07, "timestamp": "04:45:52", "text": "全部勝つことはできないよ。   あれは一体"}]
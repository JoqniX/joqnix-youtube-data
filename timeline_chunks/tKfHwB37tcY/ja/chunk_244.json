[{"type": "subtitle", "time": 14646.63, "timestamp": "04:04:06", "text": "これは本物の火力だ。"}, {"type": "subtitle", "time": 14649.83, "timestamp": "04:04:09", "text": "おお、素敵な動きですね？"}, {"type": "subtitle", "time": 14651.99, "timestamp": "04:04:11", "text": "私のお気に入り。"}, {"type": "subtitle", "time": 14664.55, "timestamp": "04:04:24", "text": "実に激しい戦いだった。 実に"}, {"type": "subtitle", "time": 14679.75, "timestamp": "04:04:39", "text": "ダブルKO。   そのまま伏せていろ"}, {"type": "subtitle", "time": 14681.75, "timestamp": "04:04:41", "text": "。"}, {"type": "subtitle", "time": 14683.67, "timestamp": "04:04:43", "text": "ああ、なんてことだ。 私はあのアイアンマンを殺した。 彼が"}, {"type": "subtitle", "time": 14685.429, "timestamp": "04:04:45", "text": "戻ってきた。"}, {"type": "subtitle", "time": 14688.389, "timestamp": "04:04:48", "text": "最後の10秒。 ああ、今の見た"}, {"type": "subtitle", "time": 14691.189, "timestamp": "04:04:51", "text": "？   あいつは一体どこへ行ったんだ"}, {"type": "subtitle", "time": 14699.83, "timestamp": "04:04:59", "text": "勝者に触れたのは誰？"}]
[{"type": "subtitle", "time": 13748.469, "timestamp": "03:49:08", "text": "彼らをクウに任せて消えさせよう。 何てことだ。   彼らがそれを実現してくれることを願っています。それはすごいことです。"}, {"type": "subtitle", "time": 13752.309, "timestamp": "03:49:12", "text": "これは大変なことだ。 私のチームは本当に優秀だ。 ああ"}, {"type": "subtitle", "time": 13754.55, "timestamp": "03:49:14", "text": "、私のチームはすごい。 私は自分の"}, {"type": "subtitle", "time": 13756.71, "timestamp": "03:49:16", "text": "チームが大好きです。 私はこれまでチャットをしたことがあるだろうか？"}, {"type": "subtitle", "time": 13758.79, "timestamp": "03:49:18", "text": "今、私が自分のチームをどれほど愛しているか、お伝えしましたっけ？ ああ"}, {"type": "subtitle", "time": 13760.11, "timestamp": "03:49:20", "text": "、なんて"}, {"type": "subtitle", "time": 13762.95, "timestamp": "03:49:22", "text": "美味しいんだ。 それと、集中しないといけないので、時々"}, {"type": "subtitle", "time": 13766.87, "timestamp": "03:49:26", "text": "黙ってしまうことがあります。ごめんなさい。"}, {"type": "subtitle", "time": 13773.03, "timestamp": "03:49:33", "text": "ストリーマーがゲームで負けることが多い理由を知っていますか"}, {"type": "subtitle", "time": 13775.67, "timestamp": "03:49:35", "text": "？ それは、"}, {"type": "subtitle", "time": 13777.91, "timestamp": "03:49:37", "text": "彼らが集中していないからだ。"}, {"type": "subtitle", "time": 13781.99, "timestamp": "03:49:41", "text": "私は、そういうことはしません。 私は集中力が高い。"}, {"type": "subtitle", "time": 13784.389, "timestamp": "03:49:44", "text": "私は正しいことをしようと努めています。"}, {"type": "subtitle", "time": 13787.429, "timestamp": "03:49:47", "text": "よく考えてみると、私もオタクってことになるよね。"}, {"type": "subtitle", "time": 13790.95, "timestamp": "03:49:50", "text": "あなたの気持ち、よく分かります。 つまり、"}, {"type": "subtitle", "time": 13793.189, "timestamp": "03:49:53", "text": "エジプトの神が"}, {"type": "subtitle", "time": 13797.51, "timestamp": "03:49:57", "text": "私の脳内でささやいて「"}]
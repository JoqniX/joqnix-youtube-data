[{"type": "subtitle", "time": 14893.349, "timestamp": "04:08:13", "text": "よぉ、ベイビー、今夜は核兵器をプレイするぜ。"}, {"type": "subtitle", "time": 14903.03, "timestamp": "04:08:23", "text": "アイアンマンはどこ？ 私は"}, {"type": "subtitle", "time": 14904.309, "timestamp": "04:08:24", "text": "アイアンマンを捕まえるつもりです。"}, {"type": "subtitle", "time": 14907.75, "timestamp": "04:08:27", "text": "みんな、僕がアイアンマンを捕まえるところを見ててくれよ。 みんな、さあ行こう"}]
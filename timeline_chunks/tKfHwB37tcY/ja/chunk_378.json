[{"type": "subtitle", "time": 22682.39, "timestamp": "06:18:02", "text": "ログイン"}, {"type": "subtitle", "time": 22685.39, "timestamp": "06:18:05", "text": "同期コードがここにあるようです"}, {"type": "subtitle", "time": 22688.47, "timestamp": "06:18:08", "text": "。 だから、同期コードを使うと、"}, {"type": "subtitle", "time": 22690.548, "timestamp": "06:18:10", "text": "どのアカウントを使っていても、そのアカウントの同期"}, {"type": "subtitle", "time": 22693.27, "timestamp": "06:18:13", "text": "コード、ログイントークンコード、"}, {"type": "subtitle", "time": 22695.75, "timestamp": "06:18:15", "text": "同期コードが"}, {"type": "subtitle", "time": 22701.03, "timestamp": "06:18:21", "text": "ここにあるバラージリストに表示されます。つまり、vワールドリスト、または"}, {"type": "subtitle", "time": 22703.75, "timestamp": "06:18:23", "text": "参加した人のリストがここに表示されます"}]
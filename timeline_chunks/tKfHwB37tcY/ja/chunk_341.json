[{"type": "subtitle", "time": 20466.31, "timestamp": "05:41:06", "text": "断食の前には震えよ。"}, {"type": "subtitle", "time": 20490.628, "timestamp": "05:41:30", "text": "これは本物の火炎放射器です。 君の現在の"}, {"type": "subtitle", "time": 20494.23, "timestamp": "05:41:34", "text": "スコアはゼロだよ"}, {"type": "subtitle", "time": 20506.868, "timestamp": "05:41:46", "text": "どういうことだ？"}, {"type": "subtitle", "time": 20512.31, "timestamp": "05:41:52", "text": "素晴らしい。 それを目にする人間はごくわずかだろう。"}, {"type": "subtitle", "time": 20515.91, "timestamp": "05:41:55", "text": "彼は映画の中で髭を生やしていましたか？ いいえ。そうですね。"}]
[{"type": "subtitle", "time": 20701.75, "timestamp": "05:45:01", "text": "これを見てください。 くそ。   何てことだ"}, {"type": "subtitle", "time": 20703.07, "timestamp": "05:45:03", "text": "。"}, {"type": "subtitle", "time": 20705.83, "timestamp": "05:45:05", "text": "くそ。 そして、これを見てください。 これは同じ"}, {"type": "subtitle", "time": 20708.23, "timestamp": "05:45:08", "text": "ものですか？ 私は"}, {"type": "subtitle", "time": 20711.67, "timestamp": "05:45:11", "text": "得たものと同じものを失ってしまった。 何だって？"}, {"type": "subtitle", "time": 20713.75, "timestamp": "05:45:13", "text": "くそ。 なんてこった。 では、あなたは現在何位ですか"}, {"type": "subtitle", "time": 20715.548, "timestamp": "05:45:15", "text": "？ それは"}, {"type": "subtitle", "time": 20718.628, "timestamp": "05:45:18", "text": "何位だった？ 私はプラチナ2です。 私はプラチナ"}, {"type": "subtitle", "time": 20722.47, "timestamp": "05:45:22", "text": "1だったのですが、ご覧の通り、その後"}, {"type": "subtitle", "time": 20726.788, "timestamp": "05:45:26", "text": "5試合連続で負けてしまいました。 何てことだ。"}, {"type": "subtitle", "time": 20730.31, "timestamp": "05:45:30", "text": "それは見ていて気が滅入る光景だ。 くそ。   さっさと黙れ"}, {"type": "subtitle", "time": 20731.91, "timestamp": "05:45:31", "text": "。 お前は"}, {"type": "subtitle", "time": 20735.91, "timestamp": "05:45:35", "text": "ゴールド3だ。 わかった、黙れ。"}, {"type": "subtitle", "time": 20738.628, "timestamp": "05:45:38", "text": "我が神よ。"}, {"type": "subtitle", "time": 20740.31, "timestamp": "05:45:40", "text": "この男を見てください。 この男を見てください。"}, {"type": "subtitle", "time": 20742.47, "timestamp": "05:45:42", "text": "このスパイダーマンの選手を見てください。 このスパイダーマンを見てください"}, {"type": "subtitle", "time": 20744.03, "timestamp": "05:45:44", "text": "。 あなたはどんなゲームをプレイしますか？"}, {"type": "subtitle", "time": 20747.43, "timestamp": "05:45:47", "text": "スパイダーマン。 彼のプロフィールが見られません。   私を見て。"}, {"type": "subtitle", "time": 20749.59, "timestamp": "05:45:49", "text": "私がプレイするゲームは？ 私はたくさんプレイします。"}, {"type": "subtitle", "time": 20750.91, "timestamp": "05:45:50", "text": "あなたはどんなゲームをプレイしますか？"}, {"type": "subtitle", "time": 20752.59, "timestamp": "05:45:52", "text": "スパイダーマン。"}, {"type": "subtitle", "time": 20755.75, "timestamp": "05:45:55", "text": "はぁ？ もう1ゲームしてもいいですか？ だって、もし"}, {"type": "subtitle", "time": 20757.43, "timestamp": "05:45:57", "text": "私が気に入ったら、ストリームのために1つ勝たないといけないんだ"}, {"type": "subtitle", "time": 20759.19, "timestamp": "05:45:59", "text": "。 絶対に"}]
[{"type": "subtitle", "time": 5654.75, "timestamp": "01:34:14", "text": "ご覧のとおり、その"}, {"type": "subtitle", "time": 5657.51, "timestamp": "01:34:17", "text": "プレイリストは見つかりません。 何が起こったのか、私は知っています。"}, {"type": "subtitle", "time": 5659.59, "timestamp": "01:34:19", "text": "私のプレイリストには入ってないんです。 はい。 あ、"}, {"type": "subtitle", "time": 5661.95, "timestamp": "01:34:21", "text": "待って。 ついに登場です。 一体どういうことだ"}, {"type": "subtitle", "time": 5664.669, "timestamp": "01:34:24", "text": "？"}, {"type": "subtitle", "time": 5667.11, "timestamp": "01:34:27", "text": "はぁ？ はぁ？"}, {"type": "subtitle", "time": 5669.27, "timestamp": "01:34:29", "text": "どうやって？どうやって来たの？ 何"}, {"type": "subtitle", "time": 5671.83, "timestamp": "01:34:31", "text": "日も探していたのに、やっとここにあった"}, {"type": "subtitle", "time": 5674.189, "timestamp": "01:34:34", "text": "。 わかった、"}, {"type": "subtitle", "time": 5682.39, "timestamp": "01:34:42", "text": "こんにちは。"}, {"type": "subtitle", "time": 5687.31, "timestamp": "01:34:47", "text": "幻覚を見ているのではないですか？ いや、そうかもしれない。 わからない"}, {"type": "subtitle", "time": 5691.75, "timestamp": "01:34:51", "text": "。 ありがとう。 復活した。 良い。"}, {"type": "subtitle", "time": 5694.75, "timestamp": "01:34:54", "text": "実行時バグか何か。"}]
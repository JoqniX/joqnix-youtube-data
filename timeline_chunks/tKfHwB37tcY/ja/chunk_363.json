[{"type": "subtitle", "time": 21780.868, "timestamp": "06:03:00", "text": "これはまずい。 これは本物の"}, {"type": "subtitle", "time": 21783.67, "timestamp": "06:03:03", "text": "火力だ。"}, {"type": "subtitle", "time": 21805.51, "timestamp": "06:03:25", "text": "君の力は私のものだ。   私が"}, {"type": "subtitle", "time": 21806.868, "timestamp": "06:03:26", "text": "なぜ浮いているのか知りたいなら"}, {"type": "subtitle", "time": 21812.788, "timestamp": "06:03:32", "text": "、聞かないでください。 撃ってみろ。 私の目。"}, {"type": "subtitle", "time": 21823.43, "timestamp": "06:03:43", "text": "残り時間はあと60秒です。"}, {"type": "subtitle", "time": 21834.23, "timestamp": "06:03:54", "text": "も行くかもしれません。 それが私の望みだった。"}]
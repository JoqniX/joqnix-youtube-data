[{"type": "subtitle", "time": 20640.23, "timestamp": "05:44:00", "text": "無駄な試みだった。"}, {"type": "subtitle", "time": 20652.788, "timestamp": "05:44:12", "text": "俺は9人くらいの仲間を"}, {"type": "subtitle", "time": 20654.948, "timestamp": "05:44:14", "text": "拠点から連れ出したのに、ヒーラーがみんないなくなっちゃったんだ"}, {"type": "subtitle", "time": 20656.948, "timestamp": "05:44:16", "text": "。 まだやるべきことはたくさんあるよ"}, {"type": "subtitle", "time": 20660.31, "timestamp": "05:44:20", "text": "、兄弟。 私は負けそうだ。"}, {"type": "subtitle", "time": 20661.91, "timestamp": "05:44:21", "text": "こいつらと対戦したら負けそうだ。 私は"}, {"type": "subtitle", "time": 20663.99, "timestamp": "05:44:23", "text": "4連敗中で、以前は"}, {"type": "subtitle", "time": 20667.75, "timestamp": "05:44:27", "text": "7連勝していたんです。 何てことだ。"}, {"type": "chat", "time": 20670.244, "timestamp": "05:44:30", "author": "@RyzexCh", "avatar": "https://yt4.ggpht.com/amK2Y62apvFDa_Drvh1DcQn8KTERvc2-tn67_8Tfb4CDDptav6v-n5VMsBR3U5XQAh1NLxsr1Q=s64-c-k-c0x00ffffff-no-rj", "message": "skill issue!"}, {"type": "subtitle", "time": 20671.99, "timestamp": "05:44:31", "text": "待って、君は何試合プレイしたの？"}, {"type": "subtitle", "time": 20673.91, "timestamp": "05:44:33", "text": "すごく好き。 君が戻ってくるのを待っていたんだ。"}, {"type": "subtitle", "time": 20676.39, "timestamp": "05:44:36", "text": "そして「彼が戻ってきた！」って思ったよ。 私は続けるべきだと"}, {"type": "subtitle", "time": 20678.708, "timestamp": "05:44:38", "text": "思う。"}, {"type": "subtitle", "time": 20681.67, "timestamp": "05:44:41", "text": "Dが加入した時、Harasが加入した時、"}, {"type": "subtitle", "time": 20684.31, "timestamp": "05:44:44", "text": "私たちは勝っていたのに、"}, {"type": "subtitle", "time": 20687.47, "timestamp": "05:44:47", "text": "彼が去ってから"}, {"type": "subtitle", "time": 20691.11, "timestamp": "05:44:51", "text": "負け始め、3試合連続で負けたんです。"}, {"type": "subtitle", "time": 20694.91, "timestamp": "05:44:54", "text": "ああ、くそ。  DはDが必要だった。"}]
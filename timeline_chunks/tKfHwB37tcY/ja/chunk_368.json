[{"type": "subtitle", "time": 22083.91, "timestamp": "06:08:03", "text": "私はこのクソみたいなものに接続している。"}, {"type": "subtitle", "time": 22086.15, "timestamp": "06:08:06", "text": "よし、"}, {"type": "subtitle", "time": 22090.91, "timestamp": "06:08:10", "text": "ビリー・ビリーが君を見つける前にカテゴリーを切り替えなきゃ。"}, {"type": "subtitle", "time": 22095.59, "timestamp": "06:08:15", "text": "うん。 ともあれ、ありがとうございました。 気をつけて。"}, {"type": "subtitle", "time": 22098.91, "timestamp": "06:08:18", "text": "ありがとう。 ありがとう。 ありがとう。"}, {"type": "subtitle", "time": 22101.19, "timestamp": "06:08:21", "text": "バイバイ。 コラボレーション、頑張ってね！"}, {"type": "subtitle", "time": 22104.23, "timestamp": "06:08:24", "text": "こんにちは。 ありがとう。 バイバイ。"}, {"type": "subtitle", "time": 22106.948, "timestamp": "06:08:26", "text": "良い一日を。"}, {"type": "subtitle", "time": 22115.788, "timestamp": "06:08:35", "text": "。 こんにちは、みんな。 私はここにいます"}, {"type": "subtitle", "time": 22119.628, "timestamp": "06:08:39", "text": "。 皆さんがパン"}, {"type": "subtitle", "time": 22122.868, "timestamp": "06:08:42", "text": "会社を楽しんでくれることを願っています。 皆さん、楽しんでいただけましたか？ 皆さん、"}, {"type": "subtitle", "time": 22135.19, "timestamp": "06:08:55", "text": "ヨク』を楽しんでいただけましたか？ いやいや"}, {"type": "subtitle", "time": 22137.43, "timestamp": "06:08:57", "text": "、彼がプレイするのを見れば見るほど、自分も"}]
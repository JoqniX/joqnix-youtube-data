[{"type": "subtitle", "time": 16020.63, "timestamp": "04:27:00", "text": "宇宙が自分に歌を歌っているとか何とか言うんだ。   あの"}, {"type": "subtitle", "time": 16022.95, "timestamp": "04:27:02", "text": "メロディーが聞こえますか？ 何てことだ。 そこまで下げる"}, {"type": "subtitle", "time": 16030.87, "timestamp": "04:27:10", "text": "彼らは3人でプレーしているのですか？ 彼らは"}, {"type": "subtitle", "time": 16032.469, "timestamp": "04:27:12", "text": "3人でプレーしている。"}, {"type": "subtitle", "time": 16038.149, "timestamp": "04:27:18", "text": "宇宙が私に歌いかけている。"}, {"type": "subtitle", "time": 16041.75, "timestamp": "04:27:21", "text": "アメイジング・スパイダーマン。   何てことだ"}, {"type": "subtitle", "time": 16044.07, "timestamp": "04:27:24", "text": "。 何てことだ。"}, {"type": "subtitle", "time": 16046.79, "timestamp": "04:27:26", "text": "ロキを手に入れなきゃ。 ロキを手に入れる必要がある。 ああ、大変だ。"}, {"type": "subtitle", "time": 16063.349, "timestamp": "04:27:43", "text": "スパイダーマン。"}, {"type": "subtitle", "time": 16071.59, "timestamp": "04:27:51", "text": "スパイダー。 もう一つピアス。   よし、これでいい"}, {"type": "subtitle", "time": 16073.51, "timestamp": "04:27:53", "text": "。   何てことだ"}, {"type": "subtitle", "time": 16077.189, "timestamp": "04:27:57", "text": "。 え、私？ああ"}]
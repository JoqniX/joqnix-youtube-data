[{"type": "subtitle", "time": 22020.07, "timestamp": "06:07:00", "text": "私の意見では、これはこれよりもずっと良い"}, {"type": "subtitle", "time": 22022.548, "timestamp": "06:07:02", "text": "。 これは良いんだけど、ああ、"}, {"type": "subtitle", "time": 22026.47, "timestamp": "06:07:06", "text": "これはこれで良いんだ。 それは私の新しい"}, {"type": "subtitle", "time": 22029.35, "timestamp": "06:07:09", "text": "カラースキームに合っています。"}, {"type": "subtitle", "time": 22032.31, "timestamp": "06:07:12", "text": "ああ、そうだね。 私が言いたいのはそういうことです。 ああ、"}, {"type": "subtitle", "time": 22034.548, "timestamp": "06:07:14", "text": "残念だ。"}, {"type": "subtitle", "time": 22036.47, "timestamp": "06:07:16", "text": "彼女から学ぶべきだよ。 彼女から学ぶべきだ"}, {"type": "subtitle", "time": 22038.23, "timestamp": "06:07:18", "text": "。 遊びたい。 そしてこちらは"}, {"type": "subtitle", "time": 22040.47, "timestamp": "06:07:20", "text": "ホークアイ版です。"}, {"type": "subtitle", "time": 22045.99, "timestamp": "06:07:25", "text": "まあ、そうでしょうね。 さて、"}, {"type": "subtitle", "time": 22049.03, "timestamp": "06:07:29", "text": "これからはあなたが引き継ぐ番です。 これはあなたの配信です。"}, {"type": "subtitle", "time": 22052.788, "timestamp": "06:07:32", "text": "はい。 ジョー、招待してくれてありがとう。"}, {"type": "subtitle", "time": 22056.07, "timestamp": "06:07:36", "text": "ありがとう。 ありがとう。"}, {"type": "subtitle", "time": 22058.59, "timestamp": "06:07:38", "text": "引き継いでいただきありがとうございます。"}, {"type": "subtitle", "time": 22061.03, "timestamp": "06:07:41", "text": "うん。 配信頑張ってください。 じゃあ、そろそろスイッチを入れて、ここから出よう"}, {"type": "subtitle", "time": 22066.868, "timestamp": "06:07:46", "text": "。 もちろん。 もちろん。"}, {"type": "subtitle", "time": 22068.628, "timestamp": "06:07:48", "text": "うん。"}, {"type": "subtitle", "time": 22072.788, "timestamp": "06:07:52", "text": "えっと、あなたの持ち物。"}, {"type": "subtitle", "time": 22075.43, "timestamp": "06:07:55", "text": "くそ、俺はジョーの上にいる。 私を見て。 そして"}]
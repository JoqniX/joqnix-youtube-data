[{"type": "subtitle", "time": 8051.189, "timestamp": "02:14:11", "text": "オーケー。 お疲れ様です、奥様。 ああ、"}, {"type": "subtitle", "time": 8054.37, "timestamp": "02:14:14", "text": "水が欲しい。 なんてこった。 水が必要だ。"}, {"type": "subtitle", "time": 8062.189, "timestamp": "02:14:22", "text": "[音楽]"}, {"type": "subtitle", "time": 8064.8, "timestamp": "02:14:24", "text": "いや、違う。"}, {"type": "subtitle", "time": 8093.109, "timestamp": "02:14:53", "text": "野生で生き残るのは大変だ。"}]
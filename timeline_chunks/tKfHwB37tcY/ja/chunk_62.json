[{"type": "subtitle", "time": 3726.47, "timestamp": "01:02:06", "text": "消え失せろなどと言っているのに、どうしてこんな平和が保てるのでしょうか。だから、私は"}, {"type": "chat", "time": 3735.54, "timestamp": "01:02:15", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "the art of not caring is really helpful"}, {"type": "chat", "time": 3742.753, "timestamp": "01:02:22", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "the unbothered mind is the strongest"}, {"type": "subtitle", "time": 3746.99, "timestamp": "01:02:26", "text": "物事を深く考える繊細なタイプの人間だからかもしれません。 ええと、殺さない技術は本当に"}, {"type": "subtitle", "time": 3748.91, "timestamp": "01:02:28", "text": "役に立ちます。   ええ、"}, {"type": "subtitle", "time": 3757.309, "timestamp": "01:02:37", "text": "動揺しない心こそが"}, {"type": "subtitle", "time": 3759.99, "timestamp": "01:02:39", "text": "最も強い。 いや、こう考えてみてください"}, {"type": "subtitle", "time": 3762.309, "timestamp": "01:02:42", "text": "。 まるで全力を尽くしたかのように。"}, {"type": "subtitle", "time": 3765.109, "timestamp": "01:02:45", "text": "人々はあなたの努力を認め、あなたのありのままの姿"}, {"type": "subtitle", "time": 3770.03, "timestamp": "01:02:50", "text": "や"}, {"type": "subtitle", "time": 3773.069, "timestamp": "01:02:53", "text": "全てを認めてくれる、そうでしょう？ そして、"}, {"type": "subtitle", "time": 3775.99, "timestamp": "01:02:55", "text": "辛い時期に"}, {"type": "subtitle", "time": 3778.549, "timestamp": "01:02:58", "text": "自分のことを考えて諦めたくなった時、"}]
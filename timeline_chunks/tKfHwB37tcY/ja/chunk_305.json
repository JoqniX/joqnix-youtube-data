[{"type": "subtitle", "time": 18316.23, "timestamp": "05:05:16", "text": "私には彼らに対して何もできない。   何てことだ"}, {"type": "subtitle", "time": 18322.788, "timestamp": "05:05:22", "text": "。 ああ、なんてこった。 私は"}, {"type": "subtitle", "time": 18324.948, "timestamp": "05:05:24", "text": "そう簡単には消えない。"}, {"type": "subtitle", "time": 18343.27, "timestamp": "05:05:43", "text": "私は透明人間なの？"}, {"type": "subtitle", "time": 18346.55, "timestamp": "05:05:46", "text": "最高の気分だ。"}, {"type": "subtitle", "time": 18348.708, "timestamp": "05:05:48", "text": "心配ない。 触ってみて。 触ってみて。 君は"}, {"type": "subtitle", "time": 18351.51, "timestamp": "05:05:51", "text": "私のものだ。"}]
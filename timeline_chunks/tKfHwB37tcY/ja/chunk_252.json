[{"type": "subtitle", "time": 15138.55, "timestamp": "04:12:18", "text": "うん。 うん。  D、あなたも参加できますよ"}, {"type": "subtitle", "time": 15142.389, "timestamp": "04:12:22", "text": "。 彼はあなたに道を与えている。 はい。"}, {"type": "subtitle", "time": 15166.15, "timestamp": "04:12:46", "text": "やあ、元気かい？ 元気かい？ どうし"}, {"type": "subtitle", "time": 15168.95, "timestamp": "04:12:48", "text": "たんだい、相棒？ 元気です。 元気かい"}, {"type": "subtitle", "time": 15171.51, "timestamp": "04:12:51", "text": "？ ただのんびりしてるだけだよ。 ただ"}, {"type": "subtitle", "time": 15175.11, "timestamp": "04:12:55", "text": "楽しんでいるだけです。 くそ。 私はハグをして、"}, {"type": "subtitle", "time": 15177.99, "timestamp": "04:12:57", "text": "ジョックに、"}]
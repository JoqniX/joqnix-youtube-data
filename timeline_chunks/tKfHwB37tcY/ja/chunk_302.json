[{"type": "subtitle", "time": 18126.39, "timestamp": "05:02:06", "text": "物。 ああ、わかりました。 彼の気持ちはわかる。 私はひっそりと目立たないようにするタイプではない"}, {"type": "subtitle", "time": 18129.788, "timestamp": "05:02:09", "text": "。 彼の気持ちはわかる。"}, {"type": "subtitle", "time": 18132.39, "timestamp": "05:02:12", "text": "ママに聞いていたのは、"}, {"type": "subtitle", "time": 18138.47, "timestamp": "05:02:18", "text": "彼が"}, {"type": "subtitle", "time": 18142.868, "timestamp": "05:02:22", "text": "欲しいものをピンで留めることだったのに、まるで透明女のように描いていたのかもしれない。"}, {"type": "subtitle", "time": 18145.03, "timestamp": "05:02:25", "text": "30秒後に来るよ。"}, {"type": "subtitle", "time": 18160.15, "timestamp": "05:02:40", "text": "ホップだよ。 そしてあなたは、まさに素晴らしい"}, {"type": "subtitle", "time": 18173.11, "timestamp": "05:02:53", "text": "いいえ。"}, {"type": "subtitle", "time": 18174.868, "timestamp": "05:02:54", "text": "彼らが任務区域を確保するのを阻止しなければなりません"}]
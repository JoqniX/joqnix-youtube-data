[{"type": "subtitle", "time": 962.23, "timestamp": "00:16:02", "text": "私の腸は本当に小さいんです。 だから、えっと、"}, {"type": "subtitle", "time": 967.99, "timestamp": "00:16:07", "text": "小さなビスケットでも何か食べれば、"}, {"type": "subtitle", "time": 970.629, "timestamp": "00:16:10", "text": "1時間は空腹を感じないと思うんです。"}, {"type": "subtitle", "time": 1018.31, "timestamp": "00:16:58", "text": "ストリームへようこそ、そしてあなたにも良い一日を。"}]
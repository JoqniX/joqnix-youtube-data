[{"type": "subtitle", "time": 7141.43, "timestamp": "01:59:01", "text": "手斧を作るにはどうすればいいですか？ 寝袋。 リサイクル"}, {"type": "subtitle", "time": 7143.31, "timestamp": "01:59:03", "text": "缶、リング"}, {"type": "subtitle", "time": 7146.27, "timestamp": "01:59:06", "text": "キット、布地"}, {"type": "subtitle", "time": 7148.109, "timestamp": "01:59:08", "text": "、設計"}, {"type": "subtitle", "time": 7151.03, "timestamp": "01:59:11", "text": "図、矢の軸、工具の選択、"}, {"type": "subtitle", "time": 7152.109, "timestamp": "01:59:12", "text": "狩猟"}, {"type": "subtitle", "time": 7154.95, "timestamp": "01:59:14", "text": "ナイフ。 私は手斧とか"}, {"type": "subtitle", "time": 7156.95, "timestamp": "01:59:16", "text": "何も持っていません。"}, {"type": "subtitle", "time": 7172.27, "timestamp": "01:59:32", "text": "電灯。"}]
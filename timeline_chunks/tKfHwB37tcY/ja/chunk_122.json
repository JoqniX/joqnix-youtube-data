[{"type": "subtitle", "time": 7338.07, "timestamp": "02:02:18", "text": "なぜ私は焚き火をこんな場所に置いたのだろう？"}, {"type": "subtitle", "time": 7362.87, "timestamp": "02:02:42", "text": "なぜ私はこれをここに置いたのだろう？"}, {"type": "subtitle", "time": 7364.99, "timestamp": "02:02:44", "text": "低体温症になりそうです。 私は"}, {"type": "subtitle", "time": 7374.87, "timestamp": "02:02:54", "text": "待って、すごく寒いよ。 少しずつ調子が出てきた"}, {"type": "subtitle", "time": 7376.95, "timestamp": "02:02:56", "text": "。"}]
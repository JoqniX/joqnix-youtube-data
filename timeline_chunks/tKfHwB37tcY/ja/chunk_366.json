[{"type": "subtitle", "time": 21962.788, "timestamp": "06:06:02", "text": "今は色のカスタマイズ機能も備えている。"}, {"type": "subtitle", "time": 21964.868, "timestamp": "06:06:04", "text": "ああ、そうだね"}, {"type": "subtitle", "time": 21967.67, "timestamp": "06:06:07", "text": "。 唯一良いのは"}, {"type": "subtitle", "time": 21970.31, "timestamp": "06:06:10", "text": "ミクの帽子です。 私は彼女に電話する。"}, {"type": "subtitle", "time": 21973.07, "timestamp": "06:06:13", "text": "帽子って知ってる？ 待って、"}, {"type": "subtitle", "time": 21975.99, "timestamp": "06:06:15", "text": "ハティクバージョンもあるよ。 おお。 ニース。 いいえ、いいえ、いいえ、いいえ、いいえ、いいえ、いいえ、"}, {"type": "subtitle", "time": 21977.67, "timestamp": "06:06:17", "text": "いいえ。"}, {"type": "subtitle", "time": 21979.75, "timestamp": "06:06:19", "text": "色使いが初ミクに似ていると言っているだけです。"}, {"type": "subtitle", "time": 21983.43, "timestamp": "06:06:23", "text": "うん。 うん。 うん。 そうです。"}, {"type": "subtitle", "time": 21985.59, "timestamp": "06:06:25", "text": "パンクな子供。 そして、これが緑色の"}, {"type": "subtitle", "time": 21990.43, "timestamp": "06:06:30", "text": "バージョン、つまり黒い子供です。 うん。"}, {"type": "subtitle", "time": 21993.59, "timestamp": "06:06:33", "text": "うん。 それから、「ああ、どうして"}, {"type": "subtitle", "time": 21995.11, "timestamp": "06:06:35", "text": "君がサイロックみたいなプレイをするなんて思わなかったんだろう"}, {"type": "subtitle", "time": 22002.67, "timestamp": "06:06:42", "text": "蝶の女、だって"}, {"type": "subtitle", "time": 22005.91, "timestamp": "06:06:45", "text": "彼女は刀を持っていて、"}, {"type": "subtitle", "time": 22009.27, "timestamp": "06:06:49", "text": "拳を使うから。"}, {"type": "subtitle", "time": 22012.47, "timestamp": "06:06:52", "text": "ええ、拳というよりは、"}, {"type": "subtitle", "time": 22015.99, "timestamp": "06:06:55", "text": "小さな矢のような感じです。 そして、それがもう一つの"}, {"type": "subtitle", "time": 22018.548, "timestamp": "06:06:58", "text": "カスタマイズカラーです。"}]
[{"type": "subtitle", "time": 615.91, "timestamp": "00:10:15", "text": "今日は出遅れてしまったことは承知しています。"}, {"type": "subtitle", "time": 619.03, "timestamp": "00:10:19", "text": "新しいタイミングを試してみたい。"}, {"type": "subtitle", "time": 621.15, "timestamp": "00:10:21", "text": "それでは、午後6時に開始します。"}, {"type": "subtitle", "time": 624.75, "timestamp": "00:10:24", "text": "2番目のストリーム。 わかった。"}, {"type": "subtitle", "time": 628.15, "timestamp": "00:10:28", "text": "早い。 なぜ私はこんなことをしているのだろう？ 早起きして"}, {"type": "subtitle", "time": 634.55, "timestamp": "00:10:34", "text": "時間通りに起きられることを願い、信じるしかない。 朝早く起きられるように、無理やり体を起こさせてください。そうすれば、"}, {"type": "subtitle", "time": 653.71, "timestamp": "00:10:53", "text": "だから、うまくいくことを願って祈っています"}, {"type": "subtitle", "time": 659.91, "timestamp": "00:10:59", "text": "。 今日はいくつか"}]
[{"type": "subtitle", "time": 22262.35, "timestamp": "06:11:02", "text": "うーん、わからない。  Discordに確認したいです"}, {"type": "subtitle", "time": 22264.628, "timestamp": "06:11:04", "text": "。"}, {"type": "subtitle", "time": 22271.75, "timestamp": "06:11:11", "text": "配信開始前にプレイテストを行うのかどうかも、"}, {"type": "subtitle", "time": 22274.15, "timestamp": "06:11:14", "text": "VC（ボイスチャット）がどこで行われるのかも分かりません。 私に"}, {"type": "subtitle", "time": 22280.75, "timestamp": "06:11:20", "text": "、では、ちょっと"}, {"type": "subtitle", "time": 22288.27, "timestamp": "06:11:28", "text": "音楽のことを"}, {"type": "subtitle", "time": 22294.07, "timestamp": "06:11:34", "text": "手短にやってみましょう。 配信が途切れるでしょう。 私の方で"}, {"type": "subtitle", "time": 22298.11, "timestamp": "06:11:38", "text": "プレイテストを行い、現状が"}, {"type": "subtitle", "time": 22302.31, "timestamp": "06:11:42", "text": "どうなっているか確認してみます"}, {"type": "subtitle", "time": 22304.788, "timestamp": "06:11:44", "text": "。"}]
[{"type": "subtitle", "time": 5322.35, "timestamp": "01:28:42", "text": "うん。 我が"}, {"type": "subtitle", "time": 5325.43, "timestamp": "01:28:45", "text": "神よ。 ブレットに引き継いでもらうはずだったんだ"}, {"type": "subtitle", "time": 5329.189, "timestamp": "01:28:49", "text": "けど、彼は仕事に行ってしまった。 だから、"}, {"type": "subtitle", "time": 5330.629, "timestamp": "01:28:50", "text": "彼にいつ引き継ぐべきかを知らせてはいけないことになっている"}, {"type": "subtitle", "time": 5333.669, "timestamp": "01:28:53", "text": "。 それで、私にはアイデアがあるんです。 今すぐ手を"}, {"type": "subtitle", "time": 5336.629, "timestamp": "01:28:56", "text": "洗ってきます。 戻ってきたら、サバイバル"}, {"type": "subtitle", "time": 5339.43, "timestamp": "01:28:59", "text": "ゲーム「ザ・ロング・"}]
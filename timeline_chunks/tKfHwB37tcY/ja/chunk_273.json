[{"type": "subtitle", "time": 16381.269, "timestamp": "04:33:01", "text": "私ならウルヴァリンを選ぶね。   てっきり、お前は"}, {"type": "subtitle", "time": 16385.269, "timestamp": "04:33:05", "text": "負けてると思ってたよ、兄弟。 うわぁ。 うわぁ。 いいえ。禁止、禁止、"}, {"type": "subtitle", "time": 16388.15, "timestamp": "04:33:08", "text": "禁止です。 禁止。"}, {"type": "subtitle", "time": 16391.349, "timestamp": "04:33:11", "text": "うん。 うん。 ウルヴァリンの禁止。"}, {"type": "subtitle", "time": 16396.15, "timestamp": "04:33:16", "text": "ウルヴァリンを禁止する。 わかった。 誰かが小さな毛むくじゃらの生き物を怖がっている"}, {"type": "subtitle", "time": 16400.15, "timestamp": "04:33:20", "text": "。   何てことだ"}, {"type": "subtitle", "time": 16402.07, "timestamp": "04:33:22", "text": "。 あんなもの見てるのか？"}, {"type": "subtitle", "time": 16403.91, "timestamp": "04:33:23", "text": "あんなもの見てるのか？ ああ、しまった。"}, {"type": "subtitle", "time": 16406.39, "timestamp": "04:33:26", "text": "彼らはスパイダーマンを排除した。 それは残念だ。"}, {"type": "subtitle", "time": 16407.99, "timestamp": "04:33:27", "text": "いいえ。ああ、すぐにお見せしますよ"}, {"type": "subtitle", "time": 16411.99, "timestamp": "04:33:31", "text": "。  2番目だと思う。あれは"}, {"type": "subtitle", "time": 16414.709, "timestamp": "04:33:34", "text": "霜の王だ。 スパイダーマン。"}, {"type": "subtitle", "time": 16417.15, "timestamp": "04:33:37", "text": "ああ、彼女はバーにいる。 オーケー、そう"}, {"type": "subtitle", "time": 16420.15, "timestamp": "04:33:40", "text": "、ママは私が筋肉を見せつけるのを待っていた。"}, {"type": "subtitle", "time": 16421.91, "timestamp": "04:33:41", "text": "あのね？ 念のため、彼に見せておこう"}, {"type": "subtitle", "time": 16424.31, "timestamp": "04:33:44", "text": "。 彼が"}, {"type": "subtitle", "time": 16427.91, "timestamp": "04:33:47", "text": "妙な気分になっている場合に備えて。 わかった。"}, {"type": "subtitle", "time": 16431.109, "timestamp": "04:33:51", "text": "彼に見せてあげて。 ええ、彼に見せましたよ。 うん。"}, {"type": "subtitle", "time": 16433.109, "timestamp": "04:33:53", "text": "ああ、そうだね。 うん。"}, {"type": "subtitle", "time": 16435.31, "timestamp": "04:33:55", "text": "マグニートーを見せてやれ。"}, {"type": "subtitle", "time": 16438.51, "timestamp": "04:33:58", "text": "うん。 ねえ、私を見て。 私にも主がいる"}]
[{"type": "subtitle", "time": 21182.31, "timestamp": "05:53:02", "text": "隠れる場所はない。"}, {"type": "subtitle", "time": 21189.27, "timestamp": "05:53:09", "text": "後押しが必要だった。   選考を"}, {"type": "subtitle", "time": 21199.51, "timestamp": "05:53:19", "text": "あなたは手助けが必要そうに見えます。"}, {"type": "subtitle", "time": 21203.27, "timestamp": "05:53:23", "text": "ニース。 ああ、スパイダーマン。 どういたしまして。 私は"}, {"type": "subtitle", "time": 21204.868, "timestamp": "05:53:24", "text": "スパイダーマンが大嫌いだ。 私が"}, {"type": "subtitle", "time": 21208.07, "timestamp": "05:53:28", "text": "スパイダーマンを嫌っているって、言ったっけ？ うん。"}, {"type": "subtitle", "time": 21210.948, "timestamp": "05:53:30", "text": "何回ですか？ 何度も。 だから"}, {"type": "subtitle", "time": 21219.27, "timestamp": "05:53:39", "text": "。 私はあのキャラクターたちが大嫌いなんです。 こんにちは。 こんにちは。"}, {"type": "subtitle", "time": 21220.788, "timestamp": "05:53:40", "text": "こんにちは。   それは"}, {"type": "subtitle", "time": 21223.35, "timestamp": "05:53:43", "text": "このゲームのせいだ。 わかった。"}, {"type": "subtitle", "time": 21225.67, "timestamp": "05:53:45", "text": "一般的にはそうではない。"}, {"type": "subtitle", "time": 21227.51, "timestamp": "05:53:47", "text": "いいえ、そうです。 あのね？ もしあの"}, {"type": "subtitle", "time": 21236.548, "timestamp": "05:53:56", "text": "ベニおじさん、でも今でも"}]
[{"type": "subtitle", "time": 21661.19, "timestamp": "06:01:01", "text": "私のヒーラーが私の前に押し出したのですか? それが"}, {"type": "subtitle", "time": 21668.47, "timestamp": "06:01:08", "text": "なあ、"}, {"type": "subtitle", "time": 21671.07, "timestamp": "06:01:11", "text": "ヒーラーが死にまくるから、サブキャラをうまく使えないんだよ。"}, {"type": "subtitle", "time": 21678.07, "timestamp": "06:01:18", "text": "ところで、ジョー、今日はどんな一日だった？"}, {"type": "subtitle", "time": 21700.788, "timestamp": "06:01:40", "text": "エアコンの業者が"}, {"type": "subtitle", "time": 21703.27, "timestamp": "06:01:43", "text": "今日やってくれるかどうかは分かりません。 あなたの力は、もしかしたら"}, {"type": "subtitle", "time": 21706.948, "timestamp": "06:01:46", "text": "明日かもしれない。 わからない。 これは本物の"}]
[{"type": "subtitle", "time": 20195.59, "timestamp": "05:36:35", "text": "ああ、今の見た？  BPがあります。 いや、"}, {"type": "subtitle", "time": 20197.83, "timestamp": "05:36:37", "text": "異常に暑いという意味ではない。"}, {"type": "subtitle", "time": 20199.91, "timestamp": "05:36:39", "text": "切り替えるつもりです。"}, {"type": "subtitle", "time": 20203.11, "timestamp": "05:36:43", "text": "私にはまだあなたが必要なの。"}, {"type": "subtitle", "time": 20207.27, "timestamp": "05:36:47", "text": "BPには、たった一つの意味しかないものがある。"}, {"type": "subtitle", "time": 20209.67, "timestamp": "05:36:49", "text": "私の究極の目標は単純だ。 全てを解決する"}, {"type": "subtitle", "time": 20211.99, "timestamp": "05:36:51", "text": "。   さあ、"}]
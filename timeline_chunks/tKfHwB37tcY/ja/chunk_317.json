[{"type": "subtitle", "time": 19023.03, "timestamp": "05:17:03", "text": "シールドは持っているけど、特に不満はないよ。"}, {"type": "subtitle", "time": 19026.07, "timestamp": "05:17:06", "text": "誰も乗り換えたがらないみたいだ。 最後の10"}, {"type": "subtitle", "time": 19038.15, "timestamp": "05:17:18", "text": "素晴らしい。"}, {"type": "subtitle", "time": 19059.66, "timestamp": "05:17:39", "text": "えっと、音楽については何も言いたくないです"}, {"type": "subtitle", "time": 19066.99, "timestamp": "05:17:46", "text": "。  24歳のイエス。"}, {"type": "subtitle", "time": 19069.43, "timestamp": "05:17:49", "text": "すごい。 チームがひどい状態だった時、私にどうしろと言うんですか"}, {"type": "subtitle", "time": 19072.11, "timestamp": "05:17:52", "text": "？ ちくしょう"}, {"type": "subtitle", "time": 19074.948, "timestamp": "05:17:54", "text": "。 みんな、ひどい連敗中だよ"}, {"type": "subtitle", "time": 19079.51, "timestamp": "05:17:59", "text": "。 これはまずい。 ジョーはどこに戻ってきたの？"}]
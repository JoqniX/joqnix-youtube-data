[{"type": "subtitle", "time": 14400.389, "timestamp": "04:00:00", "text": "ポータルを開く。 もうほとんど限界だ。"}, {"type": "subtitle", "time": 14402.229, "timestamp": "04:00:02", "text": "彼らはあらゆる支援手段を活用する。 私を"}, {"type": "subtitle", "time": 14405.51, "timestamp": "04:00:05", "text": "長い間落ち込ませないでください。"}, {"type": "subtitle", "time": 14414.63, "timestamp": "04:00:14", "text": "今ここで私を見捨てないで。 ずっと良くなった。"}, {"type": "subtitle", "time": 14420.62, "timestamp": "04:00:20", "text": "了解。"}, {"type": "subtitle", "time": 14429.67, "timestamp": "04:00:29", "text": "ああ、なんてことだ。 おお。 何てことだ。"}, {"type": "subtitle", "time": 14433.59, "timestamp": "04:00:33", "text": "おお、素敵な動きですね？   まっすぐこちらに向かってきます"}, {"type": "subtitle", "time": 14450.229, "timestamp": "04:00:50", "text": "。 なぜみんな地獄にいるの？"}, {"type": "subtitle", "time": 14452.309, "timestamp": "04:00:52", "text": "NR"}, {"type": "subtitle", "time": 14459.15, "timestamp": "04:00:59", "text": "彼女はそうしないと思う"}]
[{"type": "subtitle", "time": 15720.309, "timestamp": "04:22:00", "text": "あ、そういえば"}, {"type": "subtitle", "time": 15723.59, "timestamp": "04:22:03", "text": "、彼のロケットのオルタネートは"}, {"type": "subtitle", "time": 15726.79, "timestamp": "04:22:06", "text": "今や回復とダメージブーストをするようになったんだ。"}, {"type": "subtitle", "time": 15731.11, "timestamp": "04:22:11", "text": "あぁ、やべえ。 ええ、ダメージは、ええと、確か"}, {"type": "subtitle", "time": 15738.07, "timestamp": "04:22:18", "text": "20%くらい軽減されます。 しかし、それでも、とてつもない"}, {"type": "subtitle", "time": 15740.71, "timestamp": "04:22:20", "text": "ダメージを与える。 つまり、"}, {"type": "subtitle", "time": 15742.79, "timestamp": "04:22:22", "text": "他の人と一緒に積み重ねることもできるってことですよね？ ルナ・スノーとか、"}, {"type": "subtitle", "time": 15746.63, "timestamp": "04:22:26", "text": "そういうやつ。 それは大変だろう。"}, {"type": "subtitle", "time": 15749.63, "timestamp": "04:22:29", "text": "おそらく。 ああ、なんてことだ、私たちの毒は"}, {"type": "subtitle", "time": 15753.51, "timestamp": "04:22:33", "text": "素晴らしい。 ヴェノム、"}, {"type": "subtitle", "time": 15755.389, "timestamp": "04:22:35", "text": "俺たちは"}, {"type": "subtitle", "time": 15758.309, "timestamp": "04:22:38", "text": "ジョニーをポケットに入れようとしているんだ。 彼も大幅に"}, {"type": "subtitle", "time": 15765.67, "timestamp": "04:22:45", "text": "それで、人間だよ。"}, {"type": "subtitle", "time": 15767.59, "timestamp": "04:22:47", "text": "つまり、基本的に何が起こっているかというと、"}, {"type": "subtitle", "time": 15771.91, "timestamp": "04:22:51", "text": "ジョニーは、サポートDPSのようなあらゆる"}, {"type": "subtitle", "time": 15776.469, "timestamp": "04:22:56", "text": "キャラクターを2回タップするか1回タップすることができると思います"}]
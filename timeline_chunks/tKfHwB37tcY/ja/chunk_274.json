[{"type": "subtitle", "time": 16443.51, "timestamp": "04:34:03", "text": "。 クソ野郎。 くそ。"}, {"type": "subtitle", "time": 16446.07, "timestamp": "04:34:06", "text": "30秒後に来るよ。"}, {"type": "subtitle", "time": 16448.47, "timestamp": "04:34:08", "text": "実際に良い点をお見せしましょう。 これは"}, {"type": "subtitle", "time": 16452.869, "timestamp": "04:34:12", "text": "すごく退屈になりそうだ。"}, {"type": "subtitle", "time": 16455.269, "timestamp": "04:34:15", "text": "何？ どういう意味ですか？ ロケットを"}, {"type": "subtitle", "time": 16457.429, "timestamp": "04:34:17", "text": "プレイするには、高度なスキルと忍耐力が必要だ"}, {"type": "subtitle", "time": 16459.429, "timestamp": "04:34:19", "text": "。 私が右"}, {"type": "subtitle", "time": 16461.75, "timestamp": "04:34:21", "text": "クリックして自分のクソみたいなものを見るのが何なの？ 私が右クリックするのを見てください。"}, {"type": "subtitle", "time": 16463.51, "timestamp": "04:34:23", "text": "隅っこに立って、あちこち右クリックしまくってください"}, {"type": "subtitle", "time": 16465.429, "timestamp": "04:34:25", "text": "。 ねえ、私が何をしようとしているか知ってる"}, {"type": "subtitle", "time": 16466.869, "timestamp": "04:34:26", "text": "？ 私は"}, {"type": "subtitle", "time": 16480.869, "timestamp": "04:34:40", "text": "アンプチームを楽しんで、"}, {"type": "subtitle", "time": 16483.91, "timestamp": "04:34:43", "text": "ああキャプテンアメリカ、それが何を意味するか分かるでしょう、"}, {"type": "subtitle", "time": 16487.189, "timestamp": "04:34:47", "text": "そして彼は死んだ。"}, {"type": "subtitle", "time": 16489.51, "timestamp": "04:34:49", "text": "うん。"}, {"type": "subtitle", "time": 16495.67, "timestamp": "04:34:55", "text": "何だって？ 私はクロゴケグモを見たことがない。"}, {"type": "subtitle", "time": 16498.869, "timestamp": "04:34:58", "text": "彼は私を投げているのですか？ 彼は妻を亡くした"}]
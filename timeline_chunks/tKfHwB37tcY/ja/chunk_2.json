[{"type": "subtitle", "time": 121.51, "timestamp": "00:02:01", "text": "今のタイミングにすごく不満です。"}, {"type": "subtitle", "time": 127.07, "timestamp": "00:02:07", "text": "すごく"}, {"type": "subtitle", "time": 131.55, "timestamp": "00:02:11", "text": "遅れているように感じていて、それは良くないです。"}, {"type": "subtitle", "time": 134.589, "timestamp": "00:02:14", "text": "それでね、知ってる"}, {"type": "subtitle", "time": 138.71, "timestamp": "00:02:18", "text": "？ それでね、知ってる？"}, {"type": "subtitle", "time": 144.39, "timestamp": "00:02:24", "text": "タイミングを実際に変更するつもりです。"}, {"type": "subtitle", "time": 148.19, "timestamp": "00:02:28", "text": "ええと、例えば、午前 6 時頃から配信を開始します。"}, {"type": "subtitle", "time": 155.22899999999998, "timestamp": "00:02:35", "text": "午前 6 時からパート 1 の配信を開始し、午後 6 時から"}, {"type": "subtitle", "time": 165.35, "timestamp": "00:02:45", "text": "夜の配信、パート"}, {"type": "subtitle", "time": 167.869, "timestamp": "00:02:47", "text": "2 の配信を開始します。"}, {"type": "subtitle", "time": 170.47, "timestamp": "00:02:50", "text": "皆さんはどう思いますか？"}, {"type": "subtitle", "time": 172.39, "timestamp": "00:02:52", "text": "それは私がこれまでやってきたことと同じです"}, {"type": "subtitle", "time": 176.07, "timestamp": "00:02:56", "text": "。 午前9時ですよね？ 午前9時"}]
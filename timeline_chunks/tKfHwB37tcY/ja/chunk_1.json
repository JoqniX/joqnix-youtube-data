[{"type": "subtitle", "time": 67.789, "timestamp": "00:01:07", "text": "。 私たちは"}, {"type": "subtitle", "time": 71.91, "timestamp": "00:01:11", "text": "元気です。 えっと、では"}, {"type": "subtitle", "time": 85.27, "timestamp": "00:01:25", "text": "そこにはありません。それは主に、"}, {"type": "subtitle", "time": 91.23, "timestamp": "00:01:31", "text": "今夜コラボレーションを行います。"}, {"type": "subtitle", "time": 95.35, "timestamp": "00:01:35", "text": "今夜7時からコラボ配信を行う予定なので、配信時間を変更したいと思います"}, {"type": "subtitle", "time": 102.35, "timestamp": "00:01:42", "text": "。 えっと、それは"}, {"type": "subtitle", "time": 103.87, "timestamp": "00:01:43", "text": "[音楽]です。"}, {"type": "subtitle", "time": 106.38900000000001, "timestamp": "00:01:46", "text": "えっと、なんて呼ぶんでしょう？"}, {"type": "subtitle", "time": 109.469, "timestamp": "00:01:49", "text": "配信のタイミングを変更したいと思います。"}, {"type": "subtitle", "time": 112.55, "timestamp": "00:01:52", "text": "えっと、ジョアソンの件に関しては、"}, {"type": "subtitle", "time": 114.149, "timestamp": "00:01:54", "text": "タイミングについて色々試してみたかったんです。"}]
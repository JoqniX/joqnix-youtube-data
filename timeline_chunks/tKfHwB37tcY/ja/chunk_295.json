[{"type": "subtitle", "time": 17727.51, "timestamp": "04:55:27", "text": "先に押さない方がいいんです。  「ショーを披露する準備はできています」と私たちに祝福を与えてください"}, {"type": "subtitle", "time": 17752.55, "timestamp": "04:55:52", "text": "俺の仲間のソーがただの"}, {"type": "subtitle", "time": 17755.11, "timestamp": "04:55:55", "text": "バカだったせいで、あのチーム"}, {"type": "subtitle", "time": 17756.868, "timestamp": "04:55:56", "text": "ファイトに負けたんだ。 勝てたはずだ。"}]
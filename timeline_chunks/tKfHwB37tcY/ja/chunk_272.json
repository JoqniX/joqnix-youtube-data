[{"type": "subtitle", "time": 16328.79, "timestamp": "04:32:08", "text": "YouTube。 それは知りませんでした。"}, {"type": "subtitle", "time": 16331.59, "timestamp": "04:32:11", "text": "そして彼女は「Mo Rivals」をプレイしている。 神。 うん。"}, {"type": "subtitle", "time": 16335.03, "timestamp": "04:32:15", "text": "なんてこった？"}, {"type": "subtitle", "time": 16336.63, "timestamp": "04:32:16", "text": "彼女がそんなにタイトな人だとは知らなかったよ、"}, {"type": "subtitle", "time": 16338.79, "timestamp": "04:32:18", "text": "兄弟。 うん。 くそ。 エマ・"}, {"type": "subtitle", "time": 16341.269, "timestamp": "04:32:21", "text": "フロストの出番かな。"}, {"type": "subtitle", "time": 16344.07, "timestamp": "04:32:24", "text": "エマ・フロストがあちこちにいる。"}, {"type": "subtitle", "time": 16347.03, "timestamp": "04:32:27", "text": "彼女はこの地図に関しては得意だ。"}, {"type": "subtitle", "time": 16349.349, "timestamp": "04:32:29", "text": "B グルートが何なのかは分かってるよ、だってクソ、ああ、"}, {"type": "subtitle", "time": 16352.75, "timestamp": "04:32:32", "text": "アスカード。 わかった。 グルートなんてクソくらえ"}, {"type": "subtitle", "time": 16356.309, "timestamp": "04:32:36", "text": "。 やあ。 わかった。"}, {"type": "subtitle", "time": 16359.59, "timestamp": "04:32:39", "text": "うわぁ。 落ち着け。 私は森林伐採賛成派です。   さあ行こう"}, {"type": "subtitle", "time": 16361.83, "timestamp": "04:32:41", "text": "。 やりましょう。 彼の木材は"}, {"type": "subtitle", "time": 16365.189, "timestamp": "04:32:45", "text": "君に何をしたんだ、兄弟？ なんてこった？"}, {"type": "subtitle", "time": 16368.07, "timestamp": "04:32:48", "text": "わかりました、その質問には答えないでください。"}, {"type": "subtitle", "time": 16369.59, "timestamp": "04:32:49", "text": "いいえ、敵チームが禁止グループを編成しました。 それは"}, {"type": "subtitle", "time": 16373.349, "timestamp": "04:32:53", "text": "いいことだね。 ああ、それはうまくいく。"}, {"type": "subtitle", "time": 16377.67, "timestamp": "04:32:57", "text": "見えない。 私はグルートです。"}]
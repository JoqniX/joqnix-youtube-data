[{"type": "subtitle", "time": 22200.51, "timestamp": "06:10:00", "text": "ああ、みんな、あれを持ってるよ"}, {"type": "subtitle", "time": 22209.43, "timestamp": "06:10:09", "text": "私のGPU、"}, {"type": "subtitle", "time": 22231.15, "timestamp": "06:10:31", "text": "今日は"}, {"type": "subtitle", "time": 22233.83, "timestamp": "06:10:33", "text": "コラボ企画がありますよね？"}, {"type": "subtitle", "time": 22236.868, "timestamp": "06:10:36", "text": "私たちはコラボレーションをしています。 番組をリセットさせてください。"}, {"type": "subtitle", "time": 22247.99, "timestamp": "06:10:47", "text": "再始動。 今日はコラボレーションします。 それで、"}, {"type": "subtitle", "time": 22252.31, "timestamp": "06:10:52", "text": "友達のコラボレーションを手伝うために、いくつかやってみようと思います"}]
[{"type": "subtitle", "time": 17487.51, "timestamp": "04:51:27", "text": "あなたの力は素晴らしい。私はショーを披露する準備ができています"}, {"type": "subtitle", "time": 17491.83, "timestamp": "04:51:31", "text": "。 断食の前には震えよ。"}, {"type": "subtitle", "time": 17512.15, "timestamp": "04:51:52", "text": "男。 私のヒーラーたち。 ええと、大丈夫です。"}, {"type": "subtitle", "time": 17514.47, "timestamp": "04:51:54", "text": "あなたにはベタベタしすぎます。"}, {"type": "subtitle", "time": 17517.35, "timestamp": "04:51:57", "text": "ニース。   戻ってきました"}]
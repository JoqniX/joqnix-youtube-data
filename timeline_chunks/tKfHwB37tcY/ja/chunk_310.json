[{"type": "subtitle", "time": 18603.43, "timestamp": "05:10:03", "text": "それに関して何の権限もありません。 最善を尽くして続けていきます。"}, {"type": "subtitle", "time": 18612.91, "timestamp": "05:10:12", "text": "それは素晴らしいですね。 まるで"}, {"type": "subtitle", "time": 18615.19, "timestamp": "05:10:15", "text": "鬱状態みたいだ。 私は身体的に"}, {"type": "subtitle", "time": 18623.43, "timestamp": "05:10:23", "text": "残り数秒。"}, {"type": "subtitle", "time": 18627.19, "timestamp": "05:10:27", "text": "何？ 彼はどのようにして死んだのですか？"}]
[{"type": "subtitle", "time": 180.869, "timestamp": "00:03:00", "text": "パート1 パート2は午後9時に配信されます。"}, {"type": "subtitle", "time": 183.41, "timestamp": "00:03:03", "text": "同じことだ。"}, {"type": "subtitle", "time": 185.149, "timestamp": "00:03:05", "text": "音楽は"}, {"type": "subtitle", "time": 187.67, "timestamp": "00:03:07", "text": "同じです。 えっと、これは単に"}, {"type": "subtitle", "time": 189.67, "timestamp": "00:03:09", "text": "タイミングを変えたかっただけなんです"}, {"type": "subtitle", "time": 194.869, "timestamp": "00:03:14", "text": "。"}, {"type": "subtitle", "time": 197.82999999999998, "timestamp": "00:03:17", "text": "睡眠スケジュールをきちんと整えるために、自分に無理強いしなければなりませんでした。 実際、私は"}, {"type": "subtitle", "time": 200.309, "timestamp": "00:03:20", "text": "自分の時間や"}, {"type": "subtitle", "time": 203.19, "timestamp": "00:03:23", "text": "何かを見たり、"}, {"type": "subtitle", "time": 207.47, "timestamp": "00:03:27", "text": "少し休んだりする時間が全くないことは分かっています。"}, {"type": "subtitle", "time": 209.71, "timestamp": "00:03:29", "text": "えっと、それは"}, {"type": "subtitle", "time": 213.27, "timestamp": "00:03:33", "text": "私がストリーミング配信していたからです。 夜しかできないのですが、"}, {"type": "subtitle", "time": 226.789, "timestamp": "00:03:46", "text": "。 これをきちんとスケジュールに組み込んでください。"}, {"type": "subtitle", "time": 230.19, "timestamp": "00:03:50", "text": "休憩時間などを"}, {"type": "subtitle", "time": 235.27, "timestamp": "00:03:55", "text": "適切に計画し、それに基づいて行動して、うまくいくかどうかを"}, {"type": "subtitle", "time": 237.82999999999998, "timestamp": "00:03:57", "text": "確認します"}]
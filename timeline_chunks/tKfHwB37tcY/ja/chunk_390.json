[{"type": "subtitle", "time": 23410.948, "timestamp": "06:30:10", "text": "実施します。 私と一緒に過ごすこの配信のタイトルを変更させてください"}, {"type": "subtitle", "time": 23417.27, "timestamp": "06:30:17", "text": "。 それから、"}, {"type": "subtitle", "time": 23426.868, "timestamp": "06:30:26", "text": "友達とリポジトリの共同作業をするつもりです。 あ、待って。  Rapoが友達とコラボ"}, {"type": "subtitle", "time": 23432.91, "timestamp": "06:30:32", "text": "そして毎晩一緒に過ごす"}, {"type": "subtitle", "time": 23455.19, "timestamp": "06:30:55", "text": "後になるだろう。 いい感じにカットしてもらえた。 それでうまくいくはずだ"}, {"type": "subtitle", "time": 23459.03, "timestamp": "06:30:59", "text": "。 そして、47日目と"}]
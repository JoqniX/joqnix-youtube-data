[{"type": "subtitle", "time": 18438.23, "timestamp": "05:07:18", "text": "一つビーコンを作らなければならない。"}, {"type": "subtitle", "time": 18442.07, "timestamp": "05:07:22", "text": "心配ない。 私が君の味方だ。   すぐにでも"}, {"type": "subtitle", "time": 18445.35, "timestamp": "05:07:25", "text": "船の整備に取り掛かるつもりだ。"}, {"type": "subtitle", "time": 18447.75, "timestamp": "05:07:27", "text": "雷神を見よ。"}]
[{"type": "subtitle", "time": 9514.03, "timestamp": "02:38:34", "text": "十分です。 木材を用意してください"}, {"type": "subtitle", "time": 9530.99, "timestamp": "02:38:50", "text": "ああ、1時間あると思っていたのに。 どう"}, {"type": "subtitle", "time": 9534.15, "timestamp": "02:38:54", "text": "したの？"}, {"type": "subtitle", "time": 9536.95, "timestamp": "02:38:56", "text": "椅子を分解するのに時間がかかりすぎて、1"}]
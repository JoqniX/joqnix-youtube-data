[{"type": "subtitle", "time": 15302.149, "timestamp": "04:15:02", "text": "面白いだろうね。 信頼。 やってみろ。 それは「"}, {"type": "subtitle", "time": 15305.11, "timestamp": "04:15:05", "text": "誰が私がそのクソを食べるのを見ているのか？」ということだろう。"}, {"type": "subtitle", "time": 15307.189, "timestamp": "04:15:07", "text": "誰でもない。"}, {"type": "subtitle", "time": 15309.91, "timestamp": "04:15:09", "text": "まあ、つまり、もし"}, {"type": "subtitle", "time": 15318.95, "timestamp": "04:15:18", "text": "ダイエットを破ってこのクリームロールを食べているところを、きっとみんなが見ているでしょうね。 ああ、そうだよ。   もちろんさ"}, {"type": "subtitle", "time": 15322.309, "timestamp": "04:15:22", "text": "。 さあ行こう。 それが一番悲しい"}, {"type": "subtitle", "time": 15324.469, "timestamp": "04:15:24", "text": "ことだ。 それが一番悲しいことだ。 ちくしょう"}, {"type": "subtitle", "time": 15327.51, "timestamp": "04:15:27", "text": "。 うん。  E1クリーム"}, {"type": "subtitle", "time": 15331.99, "timestamp": "04:15:31", "text": "ロールがお好きなら。 いや、絶対に嫌だ。 いや、絶対に嫌だ。"}, {"type": "subtitle", "time": 15335.75, "timestamp": "04:15:35", "text": "どれくらい大きいか、ご存知でしょう。"}, {"type": "subtitle", "time": 15339.309, "timestamp": "04:15:39", "text": "私がどれくらいの大きさで作るか、あなたはよく知っていますよね。 くそ。 ああ、"}, {"type": "subtitle", "time": 15344.149, "timestamp": "04:15:44", "text": "大変だ。 大丈夫ですか。 だめだ。静かに。 静かに。 これは"}, {"type": "subtitle", "time": 15346.79, "timestamp": "04:15:46", "text": "私の配信ではありません。 それはあなたのストリームではありません。"}, {"type": "subtitle", "time": 15351.03, "timestamp": "04:15:51", "text": "ああ、こんなこと言ってはいけないんだ。"}, {"type": "subtitle", "time": 15352.349, "timestamp": "04:15:52", "text": "ああ、大変だ"}, {"type": "subtitle", "time": 15355.269, "timestamp": "04:15:55", "text": "。 もう少しですごく面白いことを言いそうだった。"}, {"type": "subtitle", "time": 15357.269, "timestamp": "04:15:57", "text": "本当に？ それは"}]
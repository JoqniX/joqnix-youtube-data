[{"type": "subtitle", "time": 17776.708, "timestamp": "04:56:16", "text": "君の力は私のものだ。 私はショーを披露する準備ができています"}, {"type": "subtitle", "time": 17778.87, "timestamp": "04:56:18", "text": "。"}, {"type": "subtitle", "time": 17804.07, "timestamp": "04:56:44", "text": "何て言ったの？ 何？"}, {"type": "subtitle", "time": 17806.948, "timestamp": "04:56:46", "text": "ウルヴァリンをプレイしたいなら、どうぞ。 クソみたいな苦しみに対処するために、ミスターFをプレイしてください"}]
[{"type": "subtitle", "time": 19440.07, "timestamp": "05:24:00", "text": "到達しました。 おお。 私の傷は治らなかったのに、彼女の傷は治った"}, {"type": "subtitle", "time": 19441.67, "timestamp": "05:24:01", "text": "。"}, {"type": "subtitle", "time": 19448.868, "timestamp": "05:24:08", "text": "ああ、言いたいことは分かったよ。 ああ、ありがとうございます。"}, {"type": "subtitle", "time": 19454.23, "timestamp": "05:24:14", "text": "そちらに切り替えられますか？  ３アウト。 だからあなたは"}, {"type": "subtitle", "time": 19488.15, "timestamp": "05:24:48", "text": "哀れな。"}, {"type": "subtitle", "time": 19491.83, "timestamp": "05:24:51", "text": "君の力は、君にとって私のものだ。 君の心は"}]
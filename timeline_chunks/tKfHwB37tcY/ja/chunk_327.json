[{"type": "subtitle", "time": 19620.91, "timestamp": "05:27:00", "text": "どういうことだ？ なぜ今、私たちは進むのでしょうか？"}, {"type": "subtitle", "time": 19625.83, "timestamp": "05:27:05", "text": "私のいたずら道具。"}, {"type": "subtitle", "time": 19633.04, "timestamp": "05:27:13", "text": "これは一体何だ？"}, {"type": "subtitle", "time": 19661.03, "timestamp": "05:27:41", "text": "我々の敵は"}, {"type": "subtitle", "time": 19663.99, "timestamp": "05:27:43", "text": "最後の10秒だ。"}, {"type": "subtitle", "time": 19667.51, "timestamp": "05:27:47", "text": "お前ら一体何やってんだよ？"}, {"type": "subtitle", "time": 19675.27, "timestamp": "05:27:55", "text": "こいつらをミュートするよ。"}, {"type": "subtitle", "time": 19678.788, "timestamp": "05:27:58", "text": "スコアは1です。"}]
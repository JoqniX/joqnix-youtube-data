[{"type": "subtitle", "time": 20881.35, "timestamp": "05:48:01", "text": "この試合に勝つには、一流のチームが必要だ"}, {"type": "subtitle", "time": 20883.59, "timestamp": "05:48:03", "text": "。 もちろん、それを確認させてください。"}, {"type": "subtitle", "time": 20912.548, "timestamp": "05:48:32", "text": "とにかく。 ああ、デシュがやって来て、そして"}, {"type": "subtitle", "time": 20916.15, "timestamp": "05:48:36", "text": "去った後、彼は本当に"}, {"type": "subtitle", "time": 20924.15, "timestamp": "05:48:44", "text": "これは攻撃前の30秒間として最適です"}, {"type": "subtitle", "time": 20931.99, "timestamp": "05:48:51", "text": "あなたのそのダイヤモンドのような肌は、本当に貫通"}, {"type": "subtitle", "time": 20938.628, "timestamp": "05:48:58", "text": "私は撃っていません。 持っている間はいつでも使ってください。"}]
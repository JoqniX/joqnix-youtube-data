[{"type": "subtitle", "time": 14287.79, "timestamp": "03:58:07", "text": "みんな、それを止められないかな？ みんな、もうやめようよ。"}, {"type": "subtitle", "time": 14299.91, "timestamp": "03:58:19", "text": "何でも演奏しますよ、坊や。"}, {"type": "subtitle", "time": 14301.429, "timestamp": "03:58:21", "text": "本物の認定"}, {"type": "subtitle", "time": 14317.59, "timestamp": "03:58:37", "text": "何だったんだ？ ああ、それこそが求めていたものだ"}, {"type": "subtitle", "time": 14319.75, "timestamp": "03:58:39", "text": "。"}, {"type": "subtitle", "time": 14334.07, "timestamp": "03:58:54", "text": "いいもの。"}, {"type": "subtitle", "time": 14336.07, "timestamp": "03:58:56", "text": "ああ、素敵。 すぐにアイロンを取ってきます"}]
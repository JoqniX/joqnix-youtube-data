[{"type": "subtitle", "time": 13748.469, "timestamp": "03:49:08", "text": "讓他們消失吧。我的天啊。"}, {"type": "subtitle", "time": 13750.229, "timestamp": "03:49:10", "text": "我們希望他們能成為其中一員。那意義重大"}, {"type": "subtitle", "time": 13752.309, "timestamp": "03:49:12", "text": "。  這意義重大。"}, {"type": "subtitle", "time": 13754.55, "timestamp": "03:49:14", "text": "我的團隊太棒了。我的天哪，我的團隊簡直瘋了。我"}, {"type": "subtitle", "time": 13758.79, "timestamp": "03:49:18", "text": "愛我的團隊。我以前和人聊過天嗎？我有沒有告訴過你，我現在很愛我的球隊？我的"}, {"type": "subtitle", "time": 13760.11, "timestamp": "03:49:20", "text": "天哪，它們太"}, {"type": "subtitle", "time": 13762.95, "timestamp": "03:49:22", "text": "好吃了。還有，抱歉我有時會"}, {"type": "subtitle", "time": 13766.87, "timestamp": "03:49:26", "text": "安靜下來，因為我需要集中註意力。我必須集中"}, {"type": "subtitle", "time": 13773.03, "timestamp": "03:49:33", "text": "你知道為什麼主播"}, {"type": "subtitle", "time": 13775.67, "timestamp": "03:49:35", "text": "在遊戲中常常輸嗎？那是"}, {"type": "subtitle", "time": 13777.91, "timestamp": "03:49:37", "text": "因為他們沒有集中註意力。"}, {"type": "subtitle", "time": 13781.99, "timestamp": "03:49:41", "text": "我，我不會那樣做。我非常專注。"}, {"type": "subtitle", "time": 13784.389, "timestamp": "03:49:44", "text": "我努力做正確的事。仔細"}, {"type": "subtitle", "time": 13787.429, "timestamp": "03:49:47", "text": "想想，這也會讓我顯得像個書呆子。"}, {"type": "subtitle", "time": 13790.95, "timestamp": "03:49:50", "text": "我完全理解你的感受。我的意思是，"}, {"type": "subtitle", "time": 13793.189, "timestamp": "03:49:53", "text": "埃及神明"}, {"type": "subtitle", "time": 13797.51, "timestamp": "03:49:57", "text": "在我腦海裡低語，讓我"}]
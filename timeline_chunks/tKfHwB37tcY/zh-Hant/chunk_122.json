[{"type": "subtitle", "time": 7338.07, "timestamp": "02:02:18", "text": "我為什麼要把篝火放在這裡？"}, {"type": "subtitle", "time": 7362.87, "timestamp": "02:02:42", "text": "它放在這裡？我覺得體溫過低。"}, {"type": "subtitle", "time": 7364.99, "timestamp": "02:02:44", "text": "我要死了"}, {"type": "subtitle", "time": 7374.87, "timestamp": "02:02:54", "text": "等等，你好冷。我覺得稍微暖和了一些"}, {"type": "subtitle", "time": 7376.95, "timestamp": "02:02:56", "text": "。  稍等片刻。"}]
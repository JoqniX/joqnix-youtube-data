[{"type": "subtitle", "time": 19620.91, "timestamp": "05:27:00", "text": "回來了。我當時就像在看什麼東西。稍等片刻。呃，"}, {"type": "subtitle", "time": 19663.99, "timestamp": "05:27:43", "text": "為什麼這些機械設備又都配備了武器，變得如此危險"}, {"type": "subtitle", "time": 19667.51, "timestamp": "05:27:47", "text": "？這又來了。  讓他們"}, {"type": "subtitle", "time": 19675.27, "timestamp": "05:27:55", "text": "沐浴在陽光下。  法官和陪審團的時間。  該死的。  我的天哪。我的天哪。"}]
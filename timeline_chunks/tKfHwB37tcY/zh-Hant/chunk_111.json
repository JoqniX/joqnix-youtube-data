[{"type": "subtitle", "time": 6664.669, "timestamp": "01:51:04", "text": "看看山城神秘湖加上山谷延遲延遲延遲，它卡頓嗎？"}, {"type": "subtitle", "time": 6688.109, "timestamp": "01:51:28", "text": "？我來結束今天的工作。"}, {"type": "subtitle", "time": 6692.47, "timestamp": "01:51:32", "text": "我來結束對沃爾夫的採訪。我不想那樣。  我將關閉"}, {"type": "subtitle", "time": 6706.91, "timestamp": "01:51:46", "text": "嗯，"}, {"type": "subtitle", "time": 6710.87, "timestamp": "01:51:50", "text": "好的，那我們走吧，我們去那個"}, {"type": "subtitle", "time": 6714.83, "timestamp": "01:51:54", "text": "山城，當你祝福所有"}, {"type": "subtitle", "time": 6717.589, "timestamp": "01:51:57", "text": "衰敗的深處，仍然提供許多避難所和"}]
[{"type": "subtitle", "time": 13636.07, "timestamp": "03:47:16", "text": "順便說一句，我的治療師們都非常"}, {"type": "subtitle", "time": 13657.59, "timestamp": "03:47:37", "text": "我的天哪，他玩這個遊戲太厲害了。"}, {"type": "subtitle", "time": 13668.229, "timestamp": "03:47:48", "text": "強求。我不會"}, {"type": "subtitle", "time": 13669.51, "timestamp": "03:47:49", "text": "強求。回來吧，夥計們。回來。回來。回來"}]
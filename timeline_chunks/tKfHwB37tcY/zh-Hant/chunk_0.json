[{"type": "subtitle", "time": 14.509, "timestamp": "00:00:14", "text": "我希望直播正在進行中。歡迎"}, {"type": "subtitle", "time": 18.79, "timestamp": "00:00:18", "text": "大家來到 Jockathon 的第 46 天。我"}, {"type": "subtitle", "time": 23.07, "timestamp": "00:00:23", "text": "剛睡醒。我今天遲到了。我"}, {"type": "subtitle", "time": 27.509, "timestamp": "00:00:27", "text": "知道。不過，歡迎大家。"}, {"type": "subtitle", "time": 30.669, "timestamp": "00:00:30", "text": "現在是中午12點。"}, {"type": "subtitle", "time": 33.03, "timestamp": "00:00:33", "text": "我很喜歡"}, {"type": "subtitle", "time": 35.11, "timestamp": "00:00:35", "text": "我的晨間直播時間是中午 12 點。我"}, {"type": "subtitle", "time": 37.549, "timestamp": "00:00:37", "text": "睡得像"}, {"type": "subtitle", "time": 41.99, "timestamp": "00:00:41", "text": "死豬一樣。哇。我睡得像死豬一樣。  太"}, {"type": "subtitle", "time": 55.83, "timestamp": "00:00:55", "text": "歡迎。歡迎，兄弟。讓我更新一下"}]
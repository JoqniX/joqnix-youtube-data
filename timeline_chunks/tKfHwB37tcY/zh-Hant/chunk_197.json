[{"type": "subtitle", "time": 11822.07, "timestamp": "03:17:02", "text": "[掌聲]"}, {"type": "subtitle", "time": 11823.99, "timestamp": "03:17:03", "text": "我在想一件事。我在"}, {"type": "subtitle", "time": 11824.72, "timestamp": "03:17:04", "text": "考慮"}, {"type": "subtitle", "time": 11855.19, "timestamp": "03:17:35", "text": "那個黃色的東西是什麼意思？"}, {"type": "subtitle", "time": 11857.91, "timestamp": "03:17:37", "text": "我怎麼知道自己穿了什麼？這太令人"}]
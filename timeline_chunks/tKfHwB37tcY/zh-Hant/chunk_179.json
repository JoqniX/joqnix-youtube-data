[{"type": "subtitle", "time": 10745.53, "timestamp": "02:59:05", "text": "快點。沒有什麼。"}, {"type": "subtitle", "time": 10753.67, "timestamp": "02:59:13", "text": "是的，我們得走了。我們必須"}, {"type": "subtitle", "time": 10765.19, "timestamp": "02:59:25", "text": "什麼嗎？好了，天黑了。"}, {"type": "subtitle", "time": 10770.389, "timestamp": "02:59:30", "text": "可怕了。這個背包有點"}]
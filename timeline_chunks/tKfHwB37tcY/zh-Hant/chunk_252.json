[{"type": "subtitle", "time": 15138.55, "timestamp": "04:12:18", "text": "進去。我的天哪。 D 我以為你永遠不會問。我以為你永遠不會問我。"}, {"type": "subtitle", "time": 15166.15, "timestamp": "04:12:46", "text": "你知道嗎？我們會盡快為您安排配對。快點。快點。快點。"}, {"type": "subtitle", "time": 15168.95, "timestamp": "04:12:48", "text": "我覺得你需要問……"}, {"type": "subtitle", "time": 15175.11, "timestamp": "04:12:55", "text": "嗯……我不知道喬克在哪裡。我覺得"}, {"type": "subtitle", "time": 15177.99, "timestamp": "04:12:57", "text": "Jock可以給你參加直播所需的表格"}]
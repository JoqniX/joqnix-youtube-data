[{"type": "subtitle", "time": 16022.95, "timestamp": "04:27:02", "text": "你知道嗎？  混蛋。我認為，作為基礎角色，你的優點在於你的整體平衡性相當好。你真的不需要任何增益效果或"}, {"type": "subtitle", "time": 16030.87, "timestamp": "04:27:10", "text": "？  我剛才看到"}, {"type": "subtitle", "time": 16041.75, "timestamp": "04:27:21", "text": "蜘蛛人有點像《鬥陣特攻》裡的西格瑪。你知道他其實是一個非常基礎的角色，但就像他在遊戲中從未受到任何減益效果一樣，他從未受到任何減益效果。"}, {"type": "subtitle", "time": 16044.07, "timestamp": "04:27:24", "text": "抱歉，要么加強要么削弱"}, {"type": "subtitle", "time": 16046.79, "timestamp": "04:27:26", "text": "。削弱他，因為"}]
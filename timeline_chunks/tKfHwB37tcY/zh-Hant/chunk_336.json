[{"type": "subtitle", "time": 20195.59, "timestamp": "05:36:35", "text": "你現在想要嗎？"}, {"type": "subtitle", "time": 20197.83, "timestamp": "05:36:37", "text": "我要把誰逐出這場比賽？  [音樂] 好了，我回來了"}, {"type": "subtitle", "time": 20199.91, "timestamp": "05:36:39", "text": "。哦，是的。該死。"}, {"type": "subtitle", "time": 20207.27, "timestamp": "05:36:47", "text": "Jockey把我所有的事都洩漏出去了"}, {"type": "subtitle", "time": 20211.99, "timestamp": "05:36:51", "text": "。  耶穌。我的天。而且，"}]
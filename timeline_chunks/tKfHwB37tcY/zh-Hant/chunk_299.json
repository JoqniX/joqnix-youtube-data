[{"type": "subtitle", "time": 17962.708, "timestamp": "04:59:22", "text": "。  他就像個煩人精，很難"}, {"type": "subtitle", "time": 17968.67, "timestamp": "04:59:28", "text": "對付佔領"}, {"type": "subtitle", "time": 17971.07, "timestamp": "04:59:31", "text": "任務區的人。知道了。  米爾，讓"}, {"type": "subtitle", "time": 17982.47, "timestamp": "04:59:42", "text": "肯定他們是壞人。  我之前發現過我們其中一次顫抖。  我的天啊。光榮的。  傳教士是你的了。  我就是阿斯嘉特的威能。"}, {"type": "subtitle", "time": 17997.55, "timestamp": "04:59:57", "text": "沒錯，"}]
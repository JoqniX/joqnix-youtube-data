[{"type": "subtitle", "time": 13802.79, "timestamp": "03:50:02", "text": "閉嘴，這不是我的錯。好的。戰鬥將於 5、4、3、2、1 時開始。"}, {"type": "subtitle", "time": 13807.75, "timestamp": "03:50:07", "text": "你只需要佔領"}, {"type": "subtitle", "time": 13810.87, "timestamp": "03:50:10", "text": "任務區域。知道了。"}, {"type": "subtitle", "time": 13834.63, "timestamp": "03:50:34", "text": "月亮縈繞著你。"}, {"type": "subtitle", "time": 13836.67, "timestamp": "03:50:36", "text": "哇。好了，我的"}, {"type": "subtitle", "time": 13840.389, "timestamp": "03:50:40", "text": "飛行器現在不在你手裡了，你可以把它拿來抓走了。"}]
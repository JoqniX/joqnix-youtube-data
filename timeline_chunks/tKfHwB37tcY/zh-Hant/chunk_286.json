[{"type": "subtitle", "time": 17161.59, "timestamp": "04:46:01", "text": "兄弟會在我們需要的時候離開"}, {"type": "subtitle", "time": 17168.15, "timestamp": "04:46:08", "text": "。我的天哪，這些人死得這麼快？  以"}, {"type": "subtitle", "time": 17171.23, "timestamp": "04:46:11", "text": "權力之眼。  你的力量就是我的力量。  我不能"}, {"type": "subtitle", "time": 17174.15, "timestamp": "04:46:14", "text": "，我不能，這到底是怎麼回事？"}, {"type": "subtitle", "time": 17176.31, "timestamp": "04:46:16", "text": "我們會不會被耽擱？"}, {"type": "subtitle", "time": 17187.67, "timestamp": "04:46:27", "text": "這是真的嗎？這真的發生了嗎？  我剛才是不是為自己帶來了黴運？  只剩60秒了。  她又抓到她了。  混亂來吧。  我會幫你包紮好。  我的"}, {"type": "subtitle", "time": 17205.99, "timestamp": "04:46:45", "text": "上帝。我的天啊。  不，我已經發現了。  這是真正的火力。這是真正的火力。"}]
[{"type": "subtitle", "time": 19090.83, "timestamp": "05:18:10", "text": "請不要玩到最後。是的。  他在做什麼？  想殺她就殺她吧。  擊落。因為我被盯著，所以趕緊把"}, {"type": "subtitle", "time": 19094.91, "timestamp": "05:18:14", "text": "槍打下來。"}, {"type": "subtitle", "time": 19107.27, "timestamp": "05:18:27", "text": "你知道為什麼嗎？"}, {"type": "subtitle", "time": 19135.82, "timestamp": "05:18:55", "text": "你不能用洛基嗎？我一點用處都沒有，老兄。  消失。"}]
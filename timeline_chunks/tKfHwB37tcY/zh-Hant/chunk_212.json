[{"type": "subtitle", "time": 12731.51, "timestamp": "03:32:11", "text": "。但這個連結你"}, {"type": "subtitle", "time": 12734.67, "timestamp": "03:32:14", "text": "什麼也看不到，因為它太明顯了"}, {"type": "subtitle", "time": 12736.75, "timestamp": "03:32:16", "text": "。"}, {"type": "subtitle", "time": 12743.11, "timestamp": "03:32:23", "text": "給你一個顯而易見的鏈接，要么我就給你儀錶板"}, {"type": "subtitle", "time": 12764.87, "timestamp": "03:32:44", "text": "啊。好的，我已經更新了連結。"}]
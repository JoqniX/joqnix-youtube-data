[{"type": "subtitle", "time": 17220.51, "timestamp": "04:47:00", "text": "最後10秒。  我的天啊。我的天啊。我的天啊。我的天啊。  我的天哪！"}, {"type": "subtitle", "time": 17226.59, "timestamp": "04:47:06", "text": "我的老天爺！什麼？這是鷹眼嗎"}, {"type": "subtitle", "time": 17234.19, "timestamp": "04:47:14", "text": "？他簡直"}, {"type": "subtitle", "time": 17237.628, "timestamp": "04:47:17", "text": "百髮百中。  他上一場比賽狀態很差。  現在他百發百中。搞什麼鬼？  看哪，雷神降臨。  到底發生了什麼事？我們輸了。那他媽"}]
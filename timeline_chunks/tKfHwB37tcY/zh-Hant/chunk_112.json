[{"type": "subtitle", "time": 6720.96, "timestamp": "01:52:00", "text": "野火生存計劃"}, {"type": "subtitle", "time": 6723.95, "timestamp": "01:52:03", "text": "[音樂]"}, {"type": "subtitle", "time": 6732.229, "timestamp": "01:52:12", "text": "當然選擇遊戲玩法設置失敗"}, {"type": "subtitle", "time": 6735.229, "timestamp": "01:52:15", "text": "推進看看"}, {"type": "subtitle", "time": 6738.99, "timestamp": "01:52:18", "text": "這裡有多少？所以，如果你不想"}, {"type": "subtitle", "time": 6741.79, "timestamp": "01:52:21", "text": "抑制維生素"}, {"type": "subtitle", "time": 6744.709, "timestamp": "01:52:24", "text": "C 的吸收，而答案是緩慢的，那麼選擇權在"}, {"type": "subtitle", "time": 6752.229, "timestamp": "01:52:32", "text": "你手中。哦，你好，真實。哦，那是"}, {"type": "subtitle", "time": 6754.14, "timestamp": "01:52:34", "text": "你嗎？"}, {"type": "subtitle", "time": 6757.47, "timestamp": "01:52:37", "text": "[音樂]"}, {"type": "subtitle", "time": 6762.709, "timestamp": "01:52:42", "text": "你好。沒吃到鱸魚會讓你後悔的。"}, {"type": "subtitle", "time": 6764.79, "timestamp": "01:52:44", "text": "嗯，起病比較緩慢。這個概念可以"}, {"type": "subtitle", "time": 6767.95, "timestamp": "01:52:47", "text": "延伸到健康領域。選擇權在"}, {"type": "subtitle", "time": 6770.03, "timestamp": "01:52:50", "text": "你。維生素"}, {"type": "subtitle", "time": 6773.189, "timestamp": "01:52:53", "text": "C。我想我會把它禁用。不，我們要"}, {"type": "subtitle", "time": 6778.03, "timestamp": "01:52:58", "text": "體驗的是生存。所以，我會啟用"}]
[{"type": "subtitle", "time": 15663.75, "timestamp": "04:21:03", "text": "我們走吧。火箭信標。是的，我的山羊。  火箭，"}, {"type": "subtitle", "time": 15667.11, "timestamp": "04:21:07", "text": "出發！我"}, {"type": "subtitle", "time": 15672.95, "timestamp": "04:21:12", "text": "愛你，火箭。順便說一句，我超愛玩火箭隊。"}, {"type": "subtitle", "time": 15677.429, "timestamp": "04:21:17", "text": "我的天哪，順便說一句，他這季表現太棒了。他"}, {"type": "subtitle", "time": 15689.03, "timestamp": "04:21:29", "text": "太棒了。是"}, {"type": "subtitle", "time": 15692.87, "timestamp": "04:21:32", "text": "嗎？該死。好吧，我可能得回來了，兄弟。  聖杯！"}, {"type": "subtitle", "time": 15694.71, "timestamp": "04:21:34", "text": "前兩名治療者，兄弟。排名前兩位的治療師簡直太容易了。  毒液為什麼死了？  明白了。"}, {"type": "subtitle", "time": 15699.75, "timestamp": "04:21:39", "text": "哇哦。這些治療師沒有盡到他們的職責。呃，不。他們用力過猛了。"}, {"type": "subtitle", "time": 15703.189, "timestamp": "04:21:43", "text": "確切地。 19號來了！喲，太陽出來了！  太陽出來了。我要走了。我要走了。我沒事。  我被徹底"}, {"type": "subtitle", "time": 15710.389, "timestamp": "04:21:50", "text": "擊敗了。  我的"}, {"type": "subtitle", "time": 15715.51, "timestamp": "04:21:55", "text": "天哪。你喜歡被徹底擊敗，是嗎？"}]
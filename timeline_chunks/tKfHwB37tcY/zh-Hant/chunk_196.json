[{"type": "subtitle", "time": 11771.98, "timestamp": "03:16:11", "text": "這裡。需要一疊"}, {"type": "subtitle", "time": 11772.8, "timestamp": "03:16:12", "text": "[音樂]"}, {"type": "subtitle", "time": 11798.55, "timestamp": "03:16:38", "text": "這些不就是我現在有的衣服嗎？"}, {"type": "subtitle", "time": 11814.389, "timestamp": "03:16:54", "text": "我再也無法承受這樣的"}, {"type": "subtitle", "time": 11816.71, "timestamp": "03:16:56", "text": "重擔太久了。"}, {"type": "subtitle", "time": 11819.76, "timestamp": "03:16:59", "text": "我知道。我知道。我知道。"}]
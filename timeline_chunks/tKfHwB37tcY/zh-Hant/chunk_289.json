[{"type": "subtitle", "time": 17342.948, "timestamp": "04:49:02", "text": "哇，那真是一場酣暢淋漓的勝利！  我勒個去？我的天哪。"}, {"type": "subtitle", "time": 17359.75, "timestamp": "04:49:19", "text": "天哪，太令人難過了。那真是個令人"}, {"type": "subtitle", "time": 17362.31, "timestamp": "04:49:22", "text": "痛心的損失。  為什麼我遇到的對手竟然是天界高手？你今天"}, {"type": "subtitle", "time": 17364.39, "timestamp": "04:49:24", "text": "想成為哪位英雄？那個金色徽章表示敵方隊伍是天界隊伍。他們上賽季的表現堪稱天籟。"}, {"type": "subtitle", "time": 17371.03, "timestamp": "04:49:31", "text": "我肯定要輸了。  現在，我要把誰逐出這場比賽呢？"}, {"type": "subtitle", "time": 17373.43, "timestamp": "04:49:33", "text": "我將立即"}]
[{"type": "subtitle", "time": 1322.31, "timestamp": "00:22:02", "text": "蜘蛛、大きな蜘蛛がここに来ないでほしい"}, {"type": "subtitle", "time": 1325.029, "timestamp": "00:22:05", "text": "。 ロックされます。"}, {"type": "subtitle", "time": 1328.149, "timestamp": "00:22:08", "text": "閉ざされた空間ではジャンプできなかった。 右。 それから"}, {"type": "subtitle", "time": 1332.71, "timestamp": "00:22:12", "text": "ガス トレイルブレイザー グレネードを投げます。"}, {"type": "subtitle", "time": 1335.669, "timestamp": "00:22:15", "text": "一気に倒します。 再出現するまで 8 分間待って、"}, {"type": "subtitle", "time": 1339.909, "timestamp": "00:22:19", "text": "これをもう一度行うと、私の試練は"}, {"type": "subtitle", "time": 1342.47, "timestamp": "00:22:22", "text": "終了します。"}, {"type": "subtitle", "time": 1346.47, "timestamp": "00:22:26", "text": "それは良い考えだと思います。"}, {"type": "subtitle", "time": 1348.63, "timestamp": "00:22:28", "text": "そうだ、紫色の報酬を獲得する必要がある"}, {"type": "subtitle", "time": 1351.11, "timestamp": "00:22:31", "text": "。"}, {"type": "subtitle", "time": 1353.27, "timestamp": "00:22:33", "text": "2回殺せば"}, {"type": "subtitle", "time": 1356.07, "timestamp": "00:22:36", "text": "大丈夫です。 そうだね、2回倒せば"}, {"type": "subtitle", "time": 1359.43, "timestamp": "00:22:39", "text": "大丈夫だよ。 良い。"}, {"type": "subtitle", "time": 1362.39, "timestamp": "00:22:42", "text": "うん。 つまり、手榴弾がたくさん必要になるんです"}, {"type": "subtitle", "time": 1368.87, "timestamp": "00:22:48", "text": "手榴弾。 これらを使いたくありません。"}, {"type": "subtitle", "time": 1371.35, "timestamp": "00:22:51", "text": "これらは、大男たち、女王"}, {"type": "subtitle", "time": 1373.43, "timestamp": "00:22:53", "text": "、女家長のためのものです。"}, {"type": "subtitle", "time": 1376.71, "timestamp": "00:22:56", "text": "ああ、はい、これを持って行けますよ。"}, {"type": "subtitle", "time": 1379.27, "timestamp": "00:22:59", "text": "死なないことを祈ります。"}]
[{"type": "subtitle", "time": 2701.43, "timestamp": "00:45:01", "text": "ああ、見て。 もう一匹のネズミ。"}, {"type": "subtitle", "time": 2705.109, "timestamp": "00:45:05", "text": "あなたがクリエイターになろうと思ったきっかけは何ですか?"}, {"type": "subtitle", "time": 2720.47, "timestamp": "00:45:20", "text": "はぁ？ 私は、まず"}, {"type": "subtitle", "time": 2722.23, "timestamp": "00:45:22", "text": "ミュージシャン"}, {"type": "subtitle", "time": 2736.069, "timestamp": "00:45:36", "text": "他のクリエイターが何かを作っているのを見てインスピレーションを得たと思います"}, {"type": "subtitle", "time": 2737.67, "timestamp": "00:45:37", "text": "。   私"}, {"type": "subtitle", "time": 2740.069, "timestamp": "00:45:40", "text": "もこんなことをして"}, {"type": "subtitle", "time": 2742.23, "timestamp": "00:45:42", "text": "、"}]
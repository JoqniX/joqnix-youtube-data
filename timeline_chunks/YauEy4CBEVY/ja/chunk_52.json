[{"type": "subtitle", "time": 3122.23, "timestamp": "00:52:02", "text": "ああ、お母さんが電話してきた。 はぁ？"}, {"type": "subtitle", "time": 3144.309, "timestamp": "00:52:24", "text": "ええ、分かりません。"}, {"type": "subtitle", "time": 3165.91, "timestamp": "00:52:45", "text": "起こっていることを伝えています。"}, {"type": "subtitle", "time": 3168.549, "timestamp": "00:52:48", "text": "最初から始めます。 わかった。 しかし、"}, {"type": "subtitle", "time": 3170.87, "timestamp": "00:52:50", "text": "個人的な事柄などを共有する場合は、"}, {"type": "subtitle", "time": 3176.71, "timestamp": "00:52:56", "text": "公共の場で話していることを忘れないでくださいね。 だからアディッシュもそれを"}, {"type": "subtitle", "time": 3179.349, "timestamp": "00:52:59", "text": "すべて見ることができるのです。 だから、何を大げさに宣伝しているか、あれこれと注意してください"}]
[{"type": "subtitle", "time": 1201.35, "timestamp": "00:20:01", "text": "これは何ですか？"}, {"type": "subtitle", "time": 1204.71, "timestamp": "00:20:04", "text": "ああ、これ。 リジー。"}, {"type": "subtitle", "time": 1207.99, "timestamp": "00:20:07", "text": "ああ、いいですね。 ニース。 雪が降りました。"}, {"type": "subtitle", "time": 1219.75, "timestamp": "00:20:19", "text": "、ちょっと待ってください"}, {"type": "subtitle", "time": 1229.43, "timestamp": "00:20:29", "text": "私の7はすべてスペースマリーンに行きました。"}, {"type": "subtitle", "time": 1232.39, "timestamp": "00:20:32", "text": "待ってください、そのゲームについて聞いたことがあります。"}, {"type": "subtitle", "time": 1236.39, "timestamp": "00:20:36", "text": "スペースマリーンも。 私はこれについて聞いた。 ああ、"}, {"type": "subtitle", "time": 1257.35, "timestamp": "00:20:57", "text": "メールを確認して、"}, {"type": "subtitle", "time": 1259.75, "timestamp": "00:20:59", "text": "数日ほど待つだけで済みます"}]
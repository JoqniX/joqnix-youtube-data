[{"type": "subtitle", "time": 2465.27, "timestamp": "00:41:05", "text": "ああ、待って、待って、待って。 広告ドリルが必要です"}, {"type": "subtitle", "time": 2483.67, "timestamp": "00:41:23", "text": "何か忘れました。"}, {"type": "subtitle", "time": 2485.99, "timestamp": "00:41:25", "text": "一杯のコーヒーよりも美味しい。 私が"}, {"type": "subtitle", "time": 2495.67, "timestamp": "00:41:35", "text": "装備、つまり武器や手榴弾などを手に入れるのに 80,000 円を費やしました"}, {"type": "subtitle", "time": 2497.533, "timestamp": "00:41:37", "text": "。 ああ、"}, {"type": "subtitle", "time": 2498.15, "timestamp": "00:41:38", "text": "（笑い）"}, {"type": "subtitle", "time": 2502.309, "timestamp": "00:41:42", "text": "簡単に死なないでください。 ジョー、"}, {"type": "subtitle", "time": 2507.589, "timestamp": "00:41:47", "text": "頼むよ。 私は今泣きます。"}, {"type": "subtitle", "time": 2511.75, "timestamp": "00:41:51", "text": "すべて低設定です。"}]
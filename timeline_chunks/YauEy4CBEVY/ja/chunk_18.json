[{"type": "subtitle", "time": 1081.99, "timestamp": "00:18:01", "text": "シールドを修復します。"}, {"type": "subtitle", "time": 1089.83, "timestamp": "00:18:09", "text": "この略奪の議論を受け入れます。"}, {"type": "subtitle", "time": 1098.95, "timestamp": "00:18:18", "text": "よりクイックなスロット使用。 いやいや、そんなわけないよ。"}, {"type": "subtitle", "time": 1102.71, "timestamp": "00:18:22", "text": "戦術的。 このほうがいいです。 いいえ、"}, {"type": "subtitle", "time": 1104.63, "timestamp": "00:18:24", "text": "略奪は少し減りました。 うん。 うん、このほうが"}, {"type": "subtitle", "time": 1107.83, "timestamp": "00:18:27", "text": "いいですね。 戦術的なもの。"}, {"type": "subtitle", "time": 1111.35, "timestamp": "00:18:31", "text": "そこで、アルペジオを取り上げます。"}, {"type": "subtitle", "time": 1115.27, "timestamp": "00:18:35", "text": "アルペジオが沢山あり、強力な"}, {"type": "subtitle", "time": 1117.51, "timestamp": "00:18:37", "text": "武器もあります。"}, {"type": "subtitle", "time": 1122.87, "timestamp": "00:18:42", "text": "つまり、中弾と重弾です。 重い。"}, {"type": "subtitle", "time": 1130.15, "timestamp": "00:18:50", "text": "でもショットガンを持っていくべきでしょうか？"}, {"type": "subtitle", "time": 1138.23, "timestamp": "00:18:58", "text": "弱いです。 わかりました。"}]
[{"type": "subtitle", "time": 8891.11, "timestamp": "02:28:11", "text": "プラットフォーム上で。 ドアを開ける"}, {"type": "subtitle", "time": 8908.95, "timestamp": "02:28:28", "text": "はい、良い抜粋でした。 聖なる"}, {"type": "subtitle", "time": 8916.23, "timestamp": "02:28:36", "text": "ニース。 ああ、よかった。 何てことだ"}, {"type": "subtitle", "time": 8932.63, "timestamp": "02:28:52", "text": "ところで、私はバンを盗んだんだ"}, {"type": "subtitle", "time": 8935.11, "timestamp": "02:28:55", "text": "。"}, {"type": "subtitle", "time": 8937.83, "timestamp": "02:28:57", "text": "それを盗んだんです。"}]
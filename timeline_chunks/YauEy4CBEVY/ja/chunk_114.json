[{"type": "subtitle", "time": 6842.47, "timestamp": "01:54:02", "text": "[笑い] いいえ、"}, {"type": "subtitle", "time": 6853.99, "timestamp": "01:54:13", "text": "10 万"}, {"type": "subtitle", "time": 6858.31, "timestamp": "01:54:18", "text": "ドルを返済しなければなりません。 まあ、もう"}, {"type": "subtitle", "time": 6859.99, "timestamp": "01:54:19", "text": "これをやめることにします。"}, {"type": "subtitle", "time": 6862.07, "timestamp": "01:54:22", "text": "そして、多分"}, {"type": "subtitle", "time": 6864.95, "timestamp": "01:54:24", "text": "私は知らない。 あるいは、"}, {"type": "subtitle", "time": 6868.47, "timestamp": "01:54:28", "text": "他のボス、他のガキっぽいボスをやることもできます。 ビッグ・"}, {"type": "subtitle", "time": 6870.87, "timestamp": "01:54:30", "text": "クランキッシュ。"}, {"type": "subtitle", "time": 6874.47, "timestamp": "01:54:34", "text": "私は彼を「ああ、狼の群れへ」手榴弾で撃ち殺すことができる"}, {"type": "subtitle", "time": 6877.43, "timestamp": "01:54:37", "text": "。"}, {"type": "subtitle", "time": 6895.43, "timestamp": "01:54:55", "text": "つまり、ああ、私の"}, {"type": "subtitle", "time": 6897.91, "timestamp": "01:54:57", "text": "種族のものが苦戦しているというように、ただ殺すことができるのです。 どうか"}]
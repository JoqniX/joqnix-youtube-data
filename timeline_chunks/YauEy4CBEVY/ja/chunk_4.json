[{"type": "subtitle", "time": 245.50900000000001, "timestamp": "00:04:05", "text": "、ちょっと疲れたな。 本当は"}, {"type": "subtitle", "time": 251.19, "timestamp": "00:04:11", "text": "朝早くから配信を始める予定だったのですが、"}, {"type": "subtitle", "time": 256.39, "timestamp": "00:04:16", "text": "夕方4時から配信することにしました。"}, {"type": "subtitle", "time": 260.31, "timestamp": "00:04:20", "text": "私はバックエンドのようなものでストリーム関連の作業をいくつかしていました"}, {"type": "subtitle", "time": 263.83, "timestamp": "00:04:23", "text": "。 すると、"}, {"type": "subtitle", "time": 268.629, "timestamp": "00:04:28", "text": "とても疲れを感じました。 寝たかったけどお"}, {"type": "subtitle", "time": 271.67, "timestamp": "00:04:31", "text": "昼寝して深夜の"}, {"type": "subtitle", "time": 273.51, "timestamp": "00:04:33", "text": "配信も好き。"}, {"type": "subtitle", "time": 282.31, "timestamp": "00:04:42", "text": "4時36分。ああ、だめだ。"}, {"type": "subtitle", "time": 286.39, "timestamp": "00:04:46", "text": "そうだね、君にとっては本当に遅い時間だよ。"}, {"type": "subtitle", "time": 289.59000000000003, "timestamp": "00:04:49", "text": "おお。 くそ。"}, {"type": "subtitle", "time": 293.83, "timestamp": "00:04:53", "text": "君は本当に遅すぎるよ。"}]
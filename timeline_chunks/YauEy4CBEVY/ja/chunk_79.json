[{"type": "subtitle", "time": 4755.11, "timestamp": "01:19:15", "text": "。"}, {"type": "subtitle", "time": 4768.31, "timestamp": "01:19:28", "text": "すぐに買い物に行く人もいれば、そのまま居座る人もいます。   どちらでも"}, {"type": "subtitle", "time": 4781.43, "timestamp": "01:19:41", "text": "これはただの愚かなことだ。"}, {"type": "subtitle", "time": 4793.59, "timestamp": "01:19:53", "text": "私たちは常に園芸の達人を必要としています"}]
[{"type": "subtitle", "time": 8282.79, "timestamp": "02:18:02", "text": "私が良いものを持っていたり、私自身がそうであった場合に限ります"}, {"type": "subtitle", "time": 8284.469, "timestamp": "02:18:04", "text": "。 今すぐに"}, {"type": "subtitle", "time": 8286.15, "timestamp": "02:18:06", "text": "要塞"}, {"type": "subtitle", "time": 8307.83, "timestamp": "02:18:27", "text": "運が良ければ手榴弾のようなものが手に入ったら、"}, {"type": "subtitle", "time": 8311.83, "timestamp": "02:18:31", "text": "とても嬉しいだろう。"}]
[{"type": "subtitle", "time": 2644.39, "timestamp": "00:44:04", "text": "これらの場所はまだ略奪されていないようです。"}, {"type": "subtitle", "time": 2649.349, "timestamp": "00:44:09", "text": "それは良いことです。 それは私たちにとって良いことだ。"}, {"type": "subtitle", "time": 2657.03, "timestamp": "00:44:17", "text": "ああ、いいですね。 ニース。"}, {"type": "subtitle", "time": 2658.63, "timestamp": "00:44:18", "text": "待って、"}, {"type": "subtitle", "time": 2682.069, "timestamp": "00:44:42", "text": "おい、撃たないで。"}, {"type": "subtitle", "time": 2686.95, "timestamp": "00:44:46", "text": "怖くなったよ、兄貴。 それはネズミですか？"}, {"type": "subtitle", "time": 2689.19, "timestamp": "00:44:49", "text": "ただ中に入っただけです。"}, {"type": "subtitle", "time": 2691.19, "timestamp": "00:44:51", "text": "質問があります。 こんにちは。"}, {"type": "subtitle", "time": 2692.63, "timestamp": "00:44:52", "text": "おい、レイダー。"}]
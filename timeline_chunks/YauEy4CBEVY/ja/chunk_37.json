[{"type": "subtitle", "time": 2237.99, "timestamp": "00:37:17", "text": "2度目の出来事です。 これは"}, {"type": "subtitle", "time": 2241.19, "timestamp": "00:37:21", "text": "二度目の出来事です。"}, {"type": "subtitle", "time": 2254.23, "timestamp": "00:37:34", "text": "私は今このゲームが嫌いになり始めています。"}, {"type": "subtitle", "time": 2256.95, "timestamp": "00:37:36", "text": "その時チームメイトがいたら、私は"}, {"type": "subtitle", "time": 2260.15, "timestamp": "00:37:40", "text": "助かったでしょう。 しかし、"}, {"type": "subtitle", "time": 2262.55, "timestamp": "00:37:42", "text": "トレイルブレイザーはもう買えません。"}, {"type": "subtitle", "time": 2263.75, "timestamp": "00:37:43", "text": "ここが"}, {"type": "subtitle", "time": 2270.31, "timestamp": "00:37:50", "text": "あなたのバックパックにそのためのスペースがあることを祈ります"}]
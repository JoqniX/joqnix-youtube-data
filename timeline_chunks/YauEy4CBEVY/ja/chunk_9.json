[{"type": "subtitle", "time": 541.99, "timestamp": "00:09:01", "text": "。"}, {"type": "subtitle", "time": 545.19, "timestamp": "00:09:05", "text": "特定の数のフォロワーとか、"}, {"type": "subtitle", "time": 547.75, "timestamp": "00:09:07", "text": "例えば"}, {"type": "subtitle", "time": 550.79, "timestamp": "00:09:10", "text": "YouTube じゃなくて"}, {"type": "subtitle", "time": 554.389, "timestamp": "00:09:14", "text": "Twitch とか、たぶん Twitch で 1000 人のフォロワーとか、そういう"}, {"type": "subtitle", "time": 557.67, "timestamp": "00:09:17", "text": "目標で、少なくとも 1000 人のフォロワーに達する"}, {"type": "subtitle", "time": 559.829, "timestamp": "00:09:19", "text": "までエンドツーエンドのストリームをやって、それがうまくいくようにしたい"}, {"type": "subtitle", "time": 564.47, "timestamp": "00:09:24", "text": "[笑い]"}, {"type": "subtitle", "time": 567.11, "timestamp": "00:09:27", "text": "ええ、私たちはすでに"}, {"type": "subtitle", "time": 569.67, "timestamp": "00:09:29", "text": "YouTube で 1,000 人のフォロー登録者を獲得しています。Twitch ではどれだけの数か"}, {"type": "subtitle", "time": 573.35, "timestamp": "00:09:33", "text": "忘れました。"}, {"type": "subtitle", "time": 579.269, "timestamp": "00:09:39", "text": "Twitch は 800 から 700 くらいだと思います。いや、"}, {"type": "subtitle", "time": 583.03, "timestamp": "00:09:43", "text": "頑張って"}, {"type": "subtitle", "time": 585.91, "timestamp": "00:09:45", "text": "1,000 まで上げられるようになるかもしれません。 それは良い"}, {"type": "subtitle", "time": 588.47, "timestamp": "00:09:48", "text": "目標だと思います。   そうしても構いません"}, {"type": "subtitle", "time": 591.75, "timestamp": "00:09:51", "text": "。"}, {"type": "subtitle", "time": 596.31, "timestamp": "00:09:56", "text": "良い目標のようですね。 でもVビューは獲得しましたか？ ええ、そうしたと"}]
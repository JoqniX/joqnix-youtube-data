[{"type": "subtitle", "time": 6492.87, "timestamp": "01:48:12", "text": "。"}, {"type": "subtitle", "time": 6507.91, "timestamp": "01:48:27", "text": "彼は私がなぜ死んだのか知らない"}, {"type": "subtitle", "time": 6511.75, "timestamp": "01:48:31", "text": "。"}, {"type": "subtitle", "time": 6515.91, "timestamp": "01:48:35", "text": "敵が侵入してきたときに、PC がほとんど遅延しました。どうすればいいですか?"}, {"type": "subtitle", "time": 6519.935, "timestamp": "01:48:39", "text": "何を見せましょうか？"}, {"type": "subtitle", "time": 6520.59, "timestamp": "01:48:40", "text": "[泣きながら]"}, {"type": "subtitle", "time": 6521.75, "timestamp": "01:48:41", "text": "[うめき声]"}, {"type": "subtitle", "time": 6532.47, "timestamp": "01:48:52", "text": "私はすべてを失いました。"}]
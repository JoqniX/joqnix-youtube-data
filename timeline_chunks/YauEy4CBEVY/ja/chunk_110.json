[{"type": "subtitle", "time": 6600.229, "timestamp": "01:50:00", "text": "弾薬はありません。"}, {"type": "subtitle", "time": 6606.95, "timestamp": "01:50:06", "text": "銃に使用されるもので、ちゃんとしたジッパーが付いているものに注目してください"}, {"type": "subtitle", "time": 6610.79, "timestamp": "01:50:10", "text": "。 鎧には最適のはずです。"}, {"type": "subtitle", "time": 6613.109, "timestamp": "01:50:13", "text": "人生が厳しいときは、自分も"}, {"type": "subtitle", "time": 6615.669, "timestamp": "01:50:15", "text": "厳しくならなければなりません。  [笑い]"}, {"type": "subtitle", "time": 6616.39, "timestamp": "01:50:16", "text": "それはあなたのものです。   私が"}, {"type": "subtitle", "time": 6618.95, "timestamp": "01:50:18", "text": "試してみます。   私が"}, {"type": "subtitle", "time": 6632.47, "timestamp": "01:50:32", "text": "私にはたくさんのチャンスがありました、そして私は"}, {"type": "subtitle", "time": 6637.189, "timestamp": "01:50:37", "text": "それらすべてをサポートします。"}, {"type": "subtitle", "time": 6649.03, "timestamp": "01:50:49", "text": "これらの大きなものを使いたくありません。"}, {"type": "subtitle", "time": 6656.87, "timestamp": "01:50:56", "text": "他の大きな男の子たちのために、これをもう一つに使わなければなりません。 一番"}]
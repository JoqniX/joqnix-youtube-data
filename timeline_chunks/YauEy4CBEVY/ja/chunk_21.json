[{"type": "subtitle", "time": 1262.63, "timestamp": "00:21:02", "text": "。  Twitchの認証を忘れてしまいました"}, {"type": "subtitle", "time": 1265.51, "timestamp": "00:21:05", "text": "。 ただし、"}, {"type": "subtitle", "time": 1270.31, "timestamp": "00:21:10", "text": "電話番号を確認する必要はありません。 だからあまり心配しないでください"}, {"type": "subtitle", "time": 1273.83, "timestamp": "00:21:13", "text": "。"}, {"type": "subtitle", "time": 1276.95, "timestamp": "00:21:16", "text": "ああ、わかりました。 インタラクティブマップを確認する必要があります"}, {"type": "subtitle", "time": 1280.39, "timestamp": "00:21:20", "text": "。 ダーク レイダーは、ジャンパー ("}, {"type": "subtitle", "time": 1290.07, "timestamp": "00:21:30", "text": "飛び跳ねる男) が出現する場所を彼に指示します。 そこで私たちは、"}, {"type": "subtitle", "time": 1293.59, "timestamp": "00:21:33", "text": "リーパーを2度殺そうとすることにしました。"}, {"type": "subtitle", "time": 1296.789, "timestamp": "00:21:36", "text": "はい、ここにあります。"}, {"type": "subtitle", "time": 1300.31, "timestamp": "00:21:40", "text": "すると、リーパーはあちこちに出現します"}, {"type": "subtitle", "time": 1303.11, "timestamp": "00:21:43", "text": "。"}, {"type": "subtitle", "time": 1307.19, "timestamp": "00:21:47", "text": "これとこれ。 これとこれ。 さて、"}, {"type": "subtitle", "time": 1310.47, "timestamp": "00:21:50", "text": "発射塔に来ました。 いいえ、到着"}, {"type": "subtitle", "time": 1313.27, "timestamp": "00:21:53", "text": "ビルかここです。"}, {"type": "subtitle", "time": 1315.51, "timestamp": "00:21:55", "text": "到着ビルに行くのが一番いいと思います"}, {"type": "subtitle", "time": 1319.11, "timestamp": "00:21:59", "text": "。 ここに隠れてください。"}]
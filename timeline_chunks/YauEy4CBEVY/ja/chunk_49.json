[{"type": "subtitle", "time": 2951.99, "timestamp": "00:49:11", "text": "エンターテインメントという点では、私はクリエイターとして優れていない、という意味です。 それが"}, {"type": "subtitle", "time": 2953.91, "timestamp": "00:49:13", "text": "私が言いたかったことです。"}, {"type": "subtitle", "time": 2956.63, "timestamp": "00:49:16", "text": "そして、"}, {"type": "subtitle", "time": 2968.47, "timestamp": "00:49:28", "text": "今から見に来る人たちにとって、私の配信が思い出に残るものであってほしいと感じています。 まるで彼らが"}, {"type": "subtitle", "time": 2970.95, "timestamp": "00:49:30", "text": "その瞬間にそこにいたことを決して忘れないかのように。 そんな感じ"}, {"type": "subtitle", "time": 2973.67, "timestamp": "00:49:33", "text": "。   ああ、それが"}, {"type": "subtitle", "time": 2977.43, "timestamp": "00:49:37", "text": "好きです。 うん。 うん。 だって、"}, {"type": "subtitle", "time": 2980.71, "timestamp": "00:49:40", "text": "正直に言って、ただストリーミングして、"}, {"type": "subtitle", "time": 2984.069, "timestamp": "00:49:44", "text": "ただ話して、ただしゃべりたいだけなんだから、"}, {"type": "subtitle", "time": 2988.549, "timestamp": "00:49:48", "text": "大したことないと思うから。 いろんな"}, {"type": "subtitle", "time": 2991.19, "timestamp": "00:49:51", "text": "クレイジーなことをやりたいのですが、"}, {"type": "subtitle", "time": 2994.47, "timestamp": "00:49:54", "text": "装備やその他すべての面で制限があります。 それで、私はこう思いました"}]
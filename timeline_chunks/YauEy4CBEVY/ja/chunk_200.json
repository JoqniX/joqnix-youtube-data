[{"type": "subtitle", "time": 12006.469, "timestamp": "03:20:06", "text": "私はクリスマスを祝いません。"}, {"type": "subtitle", "time": 12016.229, "timestamp": "03:20:16", "text": "例えば、"}, {"type": "subtitle", "time": 12019.03, "timestamp": "03:20:19", "text": "他の人がクリスマスをどう祝うかを見るためにショッピングモールなどに行きましたか"}, {"type": "subtitle", "time": 12025.429, "timestamp": "03:20:25", "text": "寝て、食べる。"}]
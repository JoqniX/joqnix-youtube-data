[{"type": "subtitle", "time": 6660.229, "timestamp": "01:51:00", "text": "簡単なことで苦しんでいます。 つまり、最も"}, {"type": "subtitle", "time": 6662.39, "timestamp": "01:51:02", "text": "簡単なことではないのですが、"}, {"type": "subtitle", "time": 6674.229, "timestamp": "01:51:14", "text": "スキルとは否定することです。 ああ、それはポンコツだ。"}, {"type": "subtitle", "time": 6677.03, "timestamp": "01:51:17", "text": "その言葉を使っても大丈夫でしょうか？ 私が"}, {"type": "subtitle", "time": 6679.03, "timestamp": "01:51:19", "text": "観るすべてのストリーマー、つまり私たちのクリエイターの"}, {"type": "subtitle", "time": 6681.669, "timestamp": "01:51:21", "text": "ストリームでは、彼らは「clanker」という言葉を使います。"}, {"type": "subtitle", "time": 6684.629, "timestamp": "01:51:24", "text": "金属製のロボット。   あの"}, {"type": "subtitle", "time": 6688.55, "timestamp": "01:51:28", "text": "愚かなポンコツどもめ。 なぜ"}, {"type": "subtitle", "time": 6693.109, "timestamp": "01:51:33", "text": "こんな呪いがかけられているのか想像してみてください。私はPVEで苦しんでいます。"}, {"type": "subtitle", "time": 6696.229, "timestamp": "01:51:36", "text": "このゲームでは誰もがPVEをしていて、"}, {"type": "subtitle", "time": 6698.39, "timestamp": "01:51:38", "text": "フレンドリーな"}, {"type": "subtitle", "time": 6701.91, "timestamp": "01:51:41", "text": "ロビーをもらえてうれしいですが、私が"}, {"type": "subtitle", "time": 6704.95, "timestamp": "01:51:44", "text": "こんな風だったら私は苦しんでいます。PVP"}, {"type": "subtitle", "time": 6707.922, "timestamp": "01:51:47", "text": "では超苦しむことになります"}, {"type": "subtitle", "time": 6713.109, "timestamp": "01:51:53", "text": "[ため息]"}]
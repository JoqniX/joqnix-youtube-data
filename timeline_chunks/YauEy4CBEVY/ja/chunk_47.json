[{"type": "subtitle", "time": 2824.71, "timestamp": "00:47:04", "text": "登録者数などに注目するなら"}, {"type": "subtitle", "time": 2827.349, "timestamp": "00:47:07", "text": "、それはあまり重要ではありません"}, {"type": "subtitle", "time": 2829.27, "timestamp": "00:47:09", "text": "。"}, {"type": "subtitle", "time": 2832.79, "timestamp": "00:47:12", "text": "重要なのは、ストリームに来る人の数など、そういった"}, {"type": "subtitle", "time": 2839.589, "timestamp": "00:47:19", "text": "ことです。 数字はあまり重要ではありません。"}, {"type": "subtitle", "time": 2841.349, "timestamp": "00:47:21", "text": "数字をあまり見たくないんです"}, {"type": "subtitle", "time": 2843.99, "timestamp": "00:47:23", "text": "。   だから"}, {"type": "subtitle", "time": 2857.349, "timestamp": "00:47:37", "text": "私はまだ自分が何者でもないと感じているんです。"}, {"type": "subtitle", "time": 2860.55, "timestamp": "00:47:40", "text": "私はただ自分の空間に存在しているだけです。 ただ"}, {"type": "subtitle", "time": 2875.67, "timestamp": "00:47:55", "text": "でも、クリエイターとしては、あまり"}, {"type": "subtitle", "time": 2877.91, "timestamp": "00:47:57", "text": "クリエイターとして活躍できていない気がします。 まだ"}]
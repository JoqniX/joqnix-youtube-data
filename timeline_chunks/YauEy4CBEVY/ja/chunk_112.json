[{"type": "subtitle", "time": 6739.189, "timestamp": "01:52:19", "text": "私ができるのはそれだけです。"}, {"type": "subtitle", "time": 6741.51, "timestamp": "01:52:21", "text": "やあ、フレンドリーな顔を見るといつもうれしくなるよ。"}, {"type": "subtitle", "time": 6744.55, "timestamp": "01:52:24", "text": "あなたは何が必要ですか？"}, {"type": "subtitle", "time": 6757.43, "timestamp": "01:52:37", "text": "あれは買えない。"}, {"type": "subtitle", "time": 6759.43, "timestamp": "01:52:39", "text": "ガジェットに関して面白いのは、"}, {"type": "subtitle", "time": 6760.87, "timestamp": "01:52:40", "text": "資金の半分はそれが実際に何を"}, {"type": "subtitle", "time": 6763.589, "timestamp": "01:52:43", "text": "するのかを理解していることだ。"}, {"type": "subtitle", "time": 6766.07, "timestamp": "01:52:46", "text": "ああ、私のお金。"}, {"type": "subtitle", "time": 6769.83, "timestamp": "01:52:49", "text": "お金がちょっと減ってきています。   わかった"}, {"type": "subtitle", "time": 6772.229, "timestamp": "01:52:52", "text": "。"}, {"type": "subtitle", "time": 6775.589, "timestamp": "01:52:55", "text": "スナップを呼び出します。  H やりたくないよ、マジで"}, {"type": "subtitle", "time": 6778.31, "timestamp": "01:52:58", "text": "。 くそ、もっと"}]
[{"type": "subtitle", "time": 1658.39, "timestamp": "00:27:38", "text": "東の頂上に私を出現させてください。 東上を"}, {"type": "subtitle", "time": 1660.71, "timestamp": "00:27:40", "text": "お願いします。"}, {"type": "subtitle", "time": 1663.909, "timestamp": "00:27:43", "text": "東が上ですか、西が上ですか? 私はただ"}, {"type": "subtitle", "time": 1666.39, "timestamp": "00:27:46", "text": "跳躍者を見つけて、殺して、その"}, {"type": "subtitle", "time": 1668.789, "timestamp": "00:27:48", "text": "日は終わりにして、出て行きます。 放っておいて。"}, {"type": "subtitle", "time": 1671.43, "timestamp": "00:27:51", "text": "離れる。"}]
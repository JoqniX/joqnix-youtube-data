[{"type": "subtitle", "time": 6791.35, "timestamp": "01:53:11", "text": "被害はどうですか？"}, {"type": "subtitle", "time": 6793.43, "timestamp": "01:53:13", "text": "受け取ってください。 使ってください。 そして、血を流さないようにしてください"}, {"type": "subtitle", "time": 6795.43, "timestamp": "01:53:15", "text": "。"}, {"type": "subtitle", "time": 6797.27, "timestamp": "01:53:17", "text": "うん。"}, {"type": "subtitle", "time": 6799.109, "timestamp": "01:53:19", "text": "それは金庫に入ります。"}, {"type": "subtitle", "time": 6811.75, "timestamp": "01:53:31", "text": "すでに B トークンのシールドを持っているのに、なぜ追加のシールドを購入したのですか? ああ、"}, {"type": "subtitle", "time": 6826.149, "timestamp": "01:53:46", "text": "受け取らないで。 ああ、大丈夫。 念のため、期限までに 1 つ受け取ります"}, {"type": "subtitle", "time": 6830.47, "timestamp": "01:53:50", "text": "。"}, {"type": "subtitle", "time": 6834.31, "timestamp": "01:53:54", "text": "何が起こるかは分からない。 わかった、入るよ。"}, {"type": "subtitle", "time": 6836.79, "timestamp": "01:53:56", "text": "これで死んだら"}]
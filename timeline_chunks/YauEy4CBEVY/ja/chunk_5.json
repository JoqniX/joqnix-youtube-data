[{"type": "subtitle", "time": 312.79, "timestamp": "00:05:12", "text": "。 えっと、そうですね、今日はいつも通り"}, {"type": "subtitle", "time": 317.27, "timestamp": "00:05:17", "text": "アークをやります。"}, {"type": "subtitle", "time": 327.35, "timestamp": "00:05:27", "text": "正直言ってこのゲームは楽しいので、私はアーク レイダーのストリーム配信をたくさん行う予定です。 うん。"}, {"type": "subtitle", "time": 341.27, "timestamp": "00:05:41", "text": "待ってください、私の持ち物の一部が壊れています。 何てことだ"}, {"type": "subtitle", "time": 345.27, "timestamp": "00:05:45", "text": "。 クレイジー。"}, {"type": "subtitle", "time": 348.71, "timestamp": "00:05:48", "text": "はい、これで終わりにします"}]
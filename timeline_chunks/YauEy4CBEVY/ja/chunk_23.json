[{"type": "subtitle", "time": 1383.83, "timestamp": "00:23:03", "text": "包帯をたくさん持って行ってください。 今回は僕たちは死なないはずだ。"}, {"type": "subtitle", "time": 1388.789, "timestamp": "00:23:08", "text": "たくさん回復します。 包帯がたくさん。"}, {"type": "subtitle", "time": 1398.71, "timestamp": "00:23:18", "text": "できる限り包帯を巻きます。"}, {"type": "subtitle", "time": 1401.75, "timestamp": "00:23:21", "text": "えっと、シールドリチャージャー。 持ってないとか"}, {"type": "subtitle", "time": 1415.35, "timestamp": "00:23:35", "text": "えっと、どこですか？"}, {"type": "subtitle", "time": 1422.011, "timestamp": "00:23:42", "text": "母はこれらすべてを失っていました。"}, {"type": "subtitle", "time": 1422.789, "timestamp": "00:23:42", "text": "[笑い]"}, {"type": "subtitle", "time": 1425.59, "timestamp": "00:23:45", "text": "ねえ、あまり人を"}, {"type": "subtitle", "time": 1428.23, "timestamp": "00:23:48", "text": "殺す必要はないわ。"}, {"type": "subtitle", "time": 1434.47, "timestamp": "00:23:54", "text": "私はシールドします。"}, {"type": "subtitle", "time": 1436.87, "timestamp": "00:23:56", "text": "お金を使うことはできます。 でもそうすべきでしょうか"}]
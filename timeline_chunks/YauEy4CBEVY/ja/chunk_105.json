[{"type": "subtitle", "time": 6305.43, "timestamp": "01:45:05", "text": "ゲームが嫌いです。 このゲームが嫌いです。 この"}, {"type": "subtitle", "time": 6321.35, "timestamp": "01:45:21", "text": "まったく地獄だ。 なんてこった？ なんてこった"}, {"type": "subtitle", "time": 6333.43, "timestamp": "01:45:33", "text": "誰か、誰でもいいから"}, {"type": "subtitle", "time": 6334.79, "timestamp": "01:45:34", "text": "助けてください。"}, {"type": "subtitle", "time": 6336.229, "timestamp": "01:45:36", "text": "そこから出るまで10分。"}, {"type": "subtitle", "time": 6344.149, "timestamp": "01:45:44", "text": "私が聞いたのはそれですか？ それはすごい"}, {"type": "subtitle", "time": 6346.709, "timestamp": "01:45:46", "text": "跳躍者だ。"}, {"type": "subtitle", "time": 6357.75, "timestamp": "01:45:57", "text": "この神、このゲームは私を憎んでいると誓います。"}]
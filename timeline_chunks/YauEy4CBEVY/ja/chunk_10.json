[{"type": "subtitle", "time": 600.07, "timestamp": "00:10:00", "text": "思います。 でも、"}, {"type": "subtitle", "time": 605.75, "timestamp": "00:10:05", "text": "8月に起きた事件のせいで、全員の半分を失ったんですよね"}, {"type": "subtitle", "time": 608.63, "timestamp": "00:10:08", "text": "？ つまり、それはプロであり"}, {"type": "subtitle", "time": 610.87, "timestamp": "00:10:10", "text": "、むしろ再起動なのですよね?"}, {"type": "subtitle", "time": 613.59, "timestamp": "00:10:13", "text": "それはむしろ再起動ですよね？ 今まで見ていた"}, {"type": "subtitle", "time": 616.87, "timestamp": "00:10:16", "text": "視聴者が全員去ってしまいました。 これからは、"}, {"type": "subtitle", "time": 620.15, "timestamp": "00:10:20", "text": "視聴者をゼロから構築しなければならないようなものですよね"}, {"type": "subtitle", "time": 622.71, "timestamp": "00:10:22", "text": "？ その後どんなドラマが"}, {"type": "subtitle", "time": 625.509, "timestamp": "00:10:25", "text": "起こったのかなど。"}, {"type": "subtitle", "time": 627.99, "timestamp": "00:10:27", "text": "ああ、そうだね"}, {"type": "subtitle", "time": 631.67, "timestamp": "00:10:31", "text": "。 ああ、それもありますね。 はい、"}, {"type": "subtitle", "time": 636.55, "timestamp": "00:10:36", "text": "フォロワーは745人です。  Twitch的にはダメ。"}, {"type": "subtitle", "time": 644.87, "timestamp": "00:10:44", "text": "1月以降はTwitchでフォロワー1,000人向けの配信が出来ると思っています。"}, {"type": "subtitle", "time": 646.63, "timestamp": "00:10:46", "text": "うーん、"}, {"type": "subtitle", "time": 650.31, "timestamp": "00:10:50", "text": "1月以降は良くなります。"}, {"type": "subtitle", "time": 655.91, "timestamp": "00:10:55", "text": "今はずっと平等にしたかった気がします。 それはいい"}]
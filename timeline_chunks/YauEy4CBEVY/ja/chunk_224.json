[{"type": "subtitle", "time": 13442.95, "timestamp": "03:44:02", "text": "ああ、神様。"}, {"type": "subtitle", "time": 13446.55, "timestamp": "03:44:06", "text": "一瞬、"}, {"type": "subtitle", "time": 13454.229, "timestamp": "03:44:14", "text": "抜粋を開けていないのではないかと心配しました。 抜粋をお願いします。"}, {"type": "subtitle", "time": 13466.309, "timestamp": "03:44:26", "text": "たとえば、このゲームでは PvP をやっていないからです"}, {"type": "subtitle", "time": 13470.309, "timestamp": "03:44:30", "text": "。 いいえ。怖いように演奏しているように、"}, {"type": "subtitle", "time": 13474.55, "timestamp": "03:44:34", "text": "ゆっくり演奏しているように、そして"}, {"type": "subtitle", "time": 13477.03, "timestamp": "03:44:37", "text": "怖がっているように演奏しているように。"}, {"type": "subtitle", "time": 13480.07, "timestamp": "03:44:40", "text": "うん。"}, {"type": "subtitle", "time": 13483.189, "timestamp": "03:44:43", "text": "ただし、このゲームをプレイしている他のストリーマーを見ると、彼らは"}, {"type": "subtitle", "time": 13485.59, "timestamp": "03:44:45", "text": "クランカーのことを心配していないようです。 彼らは"}, {"type": "subtitle", "time": 13488.469, "timestamp": "03:44:48", "text": "PVプレイヤーを心配しています。"}]
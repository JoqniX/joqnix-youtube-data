[{"type": "subtitle", "time": 7174.709, "timestamp": "01:59:34", "text": "等等，"}, {"type": "subtitle", "time": 7182.47, "timestamp": "01:59:42", "text": "我的天哪，有人過世了。  我的天啊。"}, {"type": "subtitle", "time": 7184.79, "timestamp": "01:59:44", "text": "我從來都不想以這種方式行事"}, {"type": "subtitle", "time": 7187.51, "timestamp": "01:59:47", "text": "。  去他媽的這遊戲。去他媽的這遊戲。去他媽的這遊戲。  去他媽的這遊戲。"}]
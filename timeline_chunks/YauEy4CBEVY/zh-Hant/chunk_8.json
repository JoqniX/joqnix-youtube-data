[{"type": "subtitle", "time": 482.629, "timestamp": "00:08:02", "text": "因為我必須平衡現實生活、"}, {"type": "subtitle", "time": 485.67, "timestamp": "00:08:05", "text": "兼職、這那兩件事，以及生活中的其他"}, {"type": "subtitle", "time": 498.15, "timestamp": "00:08:18", "text": "事情。呃，這取決於我是否能夠進行直播。當然我可以再參加一次跑步馬拉松，但"}, {"type": "subtitle", "time": 501.189, "timestamp": "00:08:21", "text": "如果"}, {"type": "subtitle", "time": 505.27, "timestamp": "00:08:25", "text": "沒有具體目標，那參加跑步馬拉鬆的意義何在呢？不，換個角度"}, {"type": "subtitle", "time": 508.869, "timestamp": "00:08:28", "text": "想。"}, {"type": "subtitle", "time": 510.869, "timestamp": "00:08:30", "text": "上次我參加 Joathon 活動只是為了那個"}, {"type": "subtitle", "time": 513.269, "timestamp": "00:08:33", "text": "模特兒。那是為了錢，一切都是為了錢。"}, {"type": "subtitle", "time": 516.23, "timestamp": "00:08:36", "text": "結果不太理想。我什麼"}, {"type": "subtitle", "time": 519.99, "timestamp": "00:08:39", "text": "新東西都沒有。"}, {"type": "subtitle", "time": 523.35, "timestamp": "00:08:43", "text": "我當時就是憑感覺做的，大概就是這樣吧"}, {"type": "subtitle", "time": 531.67, "timestamp": "00:08:51", "text": "嗯，是的，或者當然我也可以用"}, {"type": "subtitle", "time": 534.389, "timestamp": "00:08:54", "text": "另一種方​​式，"}, {"type": "chat", "time": 538.473, "timestamp": "00:08:58", "author": "@Solaralt-k8h", "avatar": "https://yt4.ggpht.com/ytc/AIdro_lA7jr0LZvBQFLmBc7jijnVjyoazsJEdCveoYk4bFvSLqy3mJRIVzhAwp7IKIkTOUTl9A=s64-c-k-c0x00ffffff-no-rj", "message": "you got viewers though?"}, {"type": "subtitle", "time": 538.71, "timestamp": "00:08:58", "text": "像是設定一個粉絲數量目標之類的"}]
[{"type": "subtitle", "time": 1443.19, "timestamp": "00:24:03", "text": "，它在哪裡？  什麼？我沒有。什麼？  我媽媽一直都很想念這些事。  [笑聲] 嘿，"}, {"type": "subtitle", "time": 1455.59, "timestamp": "00:24:15", "text": "我不需要殺太多人"}, {"type": "subtitle", "time": 1457.83, "timestamp": "00:24:17", "text": "。  我的天哪。  我擋住。  不過"}, {"type": "subtitle", "time": 1471.99, "timestamp": "00:24:31", "text": "我需要"}, {"type": "subtitle", "time": 1491.35, "timestamp": "00:24:51", "text": "搜刮一些東西，把錢要回來。"}]
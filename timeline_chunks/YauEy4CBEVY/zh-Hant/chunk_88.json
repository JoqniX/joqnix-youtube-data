[{"type": "subtitle", "time": 5319.35, "timestamp": "01:28:39", "text": "我的天哪，他差點殺了我。"}, {"type": "subtitle", "time": 5325.03, "timestamp": "01:28:45", "text": "不錯。好，好，好，好，好。"}, {"type": "subtitle", "time": 5329.669, "timestamp": "01:28:49", "text": "我的天啊，祝你"}, {"type": "subtitle", "time": 5332.87, "timestamp": "01:28:52", "text": "好運。"}]
[{"type": "subtitle", "time": 425.99, "timestamp": "00:07:05", "text": "我很想那樣做，但我認為我的"}, {"type": "subtitle", "time": 429.019, "timestamp": "00:07:09", "text": "身體條件不允許我經常這樣做。"}, {"type": "subtitle", "time": 452.87, "timestamp": "00:07:32", "text": "，說實話，我不知道我能不能做到，"}, {"type": "chat", "time": 455.754, "timestamp": "00:07:35", "author": "@Solaralt-k8h", "avatar": "https://yt4.ggpht.com/ytc/AIdro_lA7jr0LZvBQFLmBc7jijnVjyoazsJEdCveoYk4bFvSLqy3mJRIVzhAwp7IKIkTOUTl9A=s64-c-k-c0x00ffffff-no-rj", "message": "makes sense"}, {"type": "subtitle", "time": 457.909, "timestamp": "00:07:37", "text": "因為明年，下個月，也就是"}, {"type": "subtitle", "time": 461.43, "timestamp": "00:07:41", "text": "明年四月開始，我就要去日本了"}, {"type": "subtitle", "time": 464.07, "timestamp": "00:07:44", "text": "。所以，在我安頓下來之前，我暫時沒辦法進行直播"}, {"type": "subtitle", "time": 466.629, "timestamp": "00:07:46", "text": "和其他各種活動"}, {"type": "subtitle", "time": 471.43, "timestamp": "00:07:51", "text": "。如果我在那裡待上一"}, {"type": "subtitle", "time": 474.23, "timestamp": "00:07:54", "text": "兩年，或兩三年，"}, {"type": "subtitle", "time": 476.869, "timestamp": "00:07:56", "text": "我可能就沒辦法進行超過"}, {"type": "subtitle", "time": 479.029, "timestamp": "00:07:59", "text": "兩小時的直播了，"}]
[{"type": "subtitle", "time": 245.50900000000001, "timestamp": "00:04:05", "text": "哎呀，我覺得有點累了。我原本應該"}, {"type": "subtitle", "time": 251.19, "timestamp": "00:04:11", "text": "早上更早開始直播，"}, {"type": "subtitle", "time": 253.50900000000001, "timestamp": "00:04:13", "text": "但我決定"}, {"type": "subtitle", "time": 256.39, "timestamp": "00:04:16", "text": "晚上4點開始直播。"}, {"type": "subtitle", "time": 260.31, "timestamp": "00:04:20", "text": "我當時在做一些直播方面的事情，"}, {"type": "subtitle", "time": 263.83, "timestamp": "00:04:23", "text": "像是後端方面的事情。然後我就"}, {"type": "subtitle", "time": 268.629, "timestamp": "00:04:28", "text": "覺得好累。我想睡覺，但我"}, {"type": "subtitle", "time": 271.67, "timestamp": "00:04:31", "text": "喜歡打個盹兒，然後熬夜"}, {"type": "subtitle", "time": 273.51, "timestamp": "00:04:33", "text": "直播。"}, {"type": "subtitle", "time": 282.31, "timestamp": "00:04:42", "text": "4 點 36 分，哦，不。  是的，"}, {"type": "subtitle", "time": 286.39, "timestamp": "00:04:46", "text": "對你來說已經很晚了。  哇。該死。"}, {"type": "subtitle", "time": 293.83, "timestamp": "00:04:53", "text": "對你來說已經很晚了。"}]
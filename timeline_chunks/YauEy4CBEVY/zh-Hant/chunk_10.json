[{"type": "subtitle", "time": 600.07, "timestamp": "00:10:00", "text": "我想我做到了。但是因為"}, {"type": "subtitle", "time": 605.75, "timestamp": "00:10:05", "text": "八月發生的那起事件，我失去了一半的人，"}, {"type": "subtitle", "time": 608.63, "timestamp": "00:10:08", "text": "對吧？所以從正面的角度來看，這更像是一次"}, {"type": "subtitle", "time": 610.87, "timestamp": "00:10:10", "text": "重新開始，"}, {"type": "subtitle", "time": 613.59, "timestamp": "00:10:13", "text": "對吧？  這更像是一次重新開始，對吧？"}, {"type": "subtitle", "time": 616.87, "timestamp": "00:10:16", "text": "我所有的觀眾都離開了。現在"}, {"type": "subtitle", "time": 639.67, "timestamp": "00:10:39", "text": "看來，我更像是要從零開始建立我的受眾群體，對吧？經歷了那場風波"}, {"type": "subtitle", "time": 644.87, "timestamp": "00:10:44", "text": "之後的一切。"}, {"type": "subtitle", "time": 646.63, "timestamp": "00:10:46", "text": "嗯，是的。哦"}, {"type": "subtitle", "time": 650.31, "timestamp": "00:10:50", "text": "，還有那個。是的，我有745個粉絲。不是Twitch那種。我在想，我們可以在一月份之後在 Twitch 上進行慶祝粉絲突破 1000 人的直播。  嗯，一月之後就好多了。我覺得"}, {"type": "subtitle", "time": 652.71, "timestamp": "00:10:52", "text": "我一直想達到的平衡狀態"}, {"type": "subtitle", "time": 655.91, "timestamp": "00:10:55", "text": "現在終於實現了。"}]
[{"type": "subtitle", "time": 3008.439, "timestamp": "00:50:08", "text": "良好的品格。謝謝。"}, {"type": "subtitle", "time": 3009.19, "timestamp": "00:50:09", "text": "[笑聲]"}, {"type": "subtitle", "time": 3011.99, "timestamp": "00:50:11", "text": "我不知道。"}, {"type": "subtitle", "time": 3013.91, "timestamp": "00:50:13", "text": "我覺得自己還有很大的"}, {"type": "subtitle", "time": 3034.549, "timestamp": "00:50:34", "text": "而問題是，我已經做"}, {"type": "subtitle", "time": 3036.79, "timestamp": "00:50:36", "text": "這件事多少年了？"}, {"type": "subtitle", "time": 3038.63, "timestamp": "00:50:38", "text": "已經六年了。  我"}, {"type": "subtitle", "time": 3044.71, "timestamp": "00:50:44", "text": "覺得，我覺得，我已經"}, {"type": "subtitle", "time": 3047.51, "timestamp": "00:50:47", "text": "過了能把"}, {"type": "subtitle", "time": 3050.63, "timestamp": "00:50:50", "text": "這當成嗜好的階段了。我一直把它當作"}, {"type": "subtitle", "time": 3054.15, "timestamp": "00:50:54", "text": "嗜好來做。我想認真對待這件事"}, {"type": "subtitle", "time": 3058.47, "timestamp": "00:50:58", "text": "，但我對此並不確定"}]
[{"type": "subtitle", "time": 5107.75, "timestamp": "01:25:07", "text": "你好，兇猛。  歡迎"}, {"type": "subtitle", "time": 5135.27, "timestamp": "01:25:35", "text": "我只是順道過來看看。啊，"}, {"type": "subtitle", "time": 5137.51, "timestamp": "01:25:37", "text": "你今天過得怎麼樣？"}, {"type": "subtitle", "time": 5140.149, "timestamp": "01:25:40", "text": "你的寒假過得怎麼樣，"}, {"type": "subtitle", "time": 5146.149, "timestamp": "01:25:46", "text": "謝謝光臨。這對我"}]
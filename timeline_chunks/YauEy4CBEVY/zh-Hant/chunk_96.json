[{"type": "subtitle", "time": 5762.31, "timestamp": "01:36:02", "text": "所以，你得事先用它偵察一下"}, {"type": "subtitle", "time": 5763.91, "timestamp": "01:36:03", "text": "。"}, {"type": "subtitle", "time": 5766.229, "timestamp": "01:36:06", "text": "火箭隊也在那裡。那又是"}, {"type": "subtitle", "time": 5769.11, "timestamp": "01:36:09", "text": "一件令人頭痛的事。"}, {"type": "subtitle", "time": 5771.75, "timestamp": "01:36:11", "text": "我也需要弄到那個火箭發射器"}, {"type": "subtitle", "time": 5775.91, "timestamp": "01:36:15", "text": "。所以，我應該嘗試一下，但我不會"}, {"type": "subtitle", "time": 5786.55, "timestamp": "01:36:26", "text": "呃，18歲，對吧？好的。已經18歲了。好吧，正式是18歲了。"}]
[{"type": "subtitle", "time": 5166.87, "timestamp": "01:26:06", "text": "希望你離賽季結束還有一段距離，"}, {"type": "subtitle", "time": 5168.709, "timestamp": "01:26:08", "text": "突襲者隊。今天是個採摘"}, {"type": "subtitle", "time": 5170.39, "timestamp": "01:26:10", "text": "燭莓的好日子，但要注意"}, {"type": "subtitle", "time": 5171.189, "timestamp": "01:26:11", "text": "防凍傷。"}, {"type": "subtitle", "time": 5197.669, "timestamp": "01:26:37", "text": "考試順利。  祝你好運。祝你好運。  好的。嗯"}]
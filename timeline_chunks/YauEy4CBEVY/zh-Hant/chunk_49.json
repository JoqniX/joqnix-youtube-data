[{"type": "subtitle", "time": 2949.109, "timestamp": "00:49:09", "text": "我的意思是，就娛樂性而言，我不太擅長創作"}, {"type": "subtitle", "time": 2951.99, "timestamp": "00:49:11", "text": "。我的意思就是這樣"}, {"type": "subtitle", "time": 2953.91, "timestamp": "00:49:13", "text": "。"}, {"type": "subtitle", "time": 2956.63, "timestamp": "00:49:16", "text": "我希望"}, {"type": "subtitle", "time": 2959.91, "timestamp": "00:49:19", "text": "我的"}, {"type": "subtitle", "time": 2962.309, "timestamp": "00:49:22", "text": "直播能給"}, {"type": "subtitle", "time": 2964.95, "timestamp": "00:49:24", "text": "那些經常來看"}, {"type": "subtitle", "time": 2968.47, "timestamp": "00:49:28", "text": "直播的人留下深刻的印象。彷彿他們永遠不會忘記"}, {"type": "subtitle", "time": 2970.95, "timestamp": "00:49:30", "text": "自己曾親歷那一刻。差不多就是"}, {"type": "subtitle", "time": 2973.67, "timestamp": "00:49:33", "text": "這樣。"}, {"type": "subtitle", "time": 2977.43, "timestamp": "00:49:37", "text": "嗯，我喜歡這個。是的。是的。因為我覺得，"}, {"type": "subtitle", "time": 2980.71, "timestamp": "00:49:40", "text": "老實說，直播"}, {"type": "subtitle", "time": 2984.069, "timestamp": "00:49:44", "text": "、聊天、閒聊之類的，其實沒什麼意義"}, {"type": "subtitle", "time": 2988.549, "timestamp": "00:49:48", "text": "。我想做很多"}, {"type": "subtitle", "time": 2991.19, "timestamp": "00:49:51", "text": "瘋狂的事情，但我的"}, {"type": "subtitle", "time": 2994.47, "timestamp": "00:49:54", "text": "設備和其他方面都有限。所以，我"}]
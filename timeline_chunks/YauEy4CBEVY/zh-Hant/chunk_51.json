[{"type": "subtitle", "time": 3062.63, "timestamp": "00:51:02", "text": "。我必須非常非常"}, {"type": "subtitle", "time": 3063.99, "timestamp": "00:51:03", "text": "喜歡（笑）"}, {"type": "subtitle", "time": 3066.63, "timestamp": "00:51:06", "text": "集思廣益，並且聰明地思考如何"}, {"type": "subtitle", "time": 3068.87, "timestamp": "00:51:08", "text": "做事等等。  認真點，認真點。雖然"}, {"type": "subtitle", "time": 3071.109, "timestamp": "00:51:11", "text": "我希望有一天能"}, {"type": "subtitle", "time": 3073.19, "timestamp": "00:51:13", "text": "做到這一點。我想現在還不行，"}, {"type": "subtitle", "time": 3078.39, "timestamp": "00:51:18", "text": "因為明年開始對"}, {"type": "subtitle", "time": 3083.43, "timestamp": "00:51:23", "text": "我來說將是人生的轉捩點，對吧？所以，這將是次要的。"}, {"type": "subtitle", "time": 3089.27, "timestamp": "00:51:29", "text": "不過沒關係。只要我樂在其中，"}, {"type": "subtitle", "time": 3108.79, "timestamp": "00:51:48", "text": "39K。  做對"}, {"type": "subtitle", "time": 3111.19, "timestamp": "00:51:51", "text": "你有效的事。是的。我打算這麼做。  是的。是的。是的。  啊，是"}]
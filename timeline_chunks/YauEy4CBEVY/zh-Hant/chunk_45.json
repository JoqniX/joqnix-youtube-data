[{"type": "subtitle", "time": 2701.43, "timestamp": "00:45:01", "text": "別開槍。  兄弟，我嚇壞了。那是隻老鼠嗎"}, {"type": "subtitle", "time": 2705.109, "timestamp": "00:45:05", "text": "？它就這樣進去了。  我有個"}, {"type": "subtitle", "time": 2720.47, "timestamp": "00:45:20", "text": "哦，瞧。又一隻老鼠。  是什麼激勵你成為"}, {"type": "subtitle", "time": 2736.069, "timestamp": "00:45:36", "text": "創作者？"}]
[{"type": "subtitle", "time": 3966.47, "timestamp": "01:06:06", "text": "呃，15歲，對吧？ 15"}, {"type": "subtitle", "time": 3974.95, "timestamp": "01:06:14", "text": "15 - 8 7分鐘。哦，我們必須"}, {"type": "subtitle", "time": 3978.789, "timestamp": "01:06:18", "text": "在七分鐘內幹掉它。該死。  我的天哪。"}, {"type": "subtitle", "time": 3997.589, "timestamp": "01:06:37", "text": "我身上也沒帶多少東西"}]
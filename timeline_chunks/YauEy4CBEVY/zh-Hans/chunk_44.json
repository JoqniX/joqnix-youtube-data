[{"type": "subtitle", "time": 2644.39, "timestamp": "00:44:04", "text": "看起来这些地方都还没有被洗劫一空"}, {"type": "subtitle", "time": 2649.349, "timestamp": "00:44:09", "text": "，这真是太好了。 这对我们来说是好事。"}, {"type": "subtitle", "time": 2657.03, "timestamp": "00:44:17", "text": "哦，不错。 好的。"}, {"type": "subtitle", "time": 2658.63, "timestamp": "00:44:18", "text": "等等，"}, {"type": "subtitle", "time": 2682.069, "timestamp": "00:44:42", "text": "嘿，别开枪。"}, {"type": "subtitle", "time": 2686.95, "timestamp": "00:44:46", "text": "兄弟，我吓坏了。 那是只老鼠吗？ 它就这么进去了"}, {"type": "subtitle", "time": 2689.19, "timestamp": "00:44:49", "text": "。"}, {"type": "subtitle", "time": 2691.19, "timestamp": "00:44:51", "text": "我有个问题。 你好。"}, {"type": "subtitle", "time": 2692.63, "timestamp": "00:44:52", "text": "嘿，突袭者。   是的"}]
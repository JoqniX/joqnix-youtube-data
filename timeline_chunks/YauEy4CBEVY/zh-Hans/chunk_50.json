[{"type": "subtitle", "time": 3008.439, "timestamp": "00:50:08", "text": "良好的品格。 谢谢。"}, {"type": "subtitle", "time": 3009.19, "timestamp": "00:50:09", "text": "[笑声]"}, {"type": "subtitle", "time": 3011.99, "timestamp": "00:50:11", "text": "我不知道。"}, {"type": "subtitle", "time": 3013.91, "timestamp": "00:50:13", "text": "我觉得自己还有很大的"}, {"type": "subtitle", "time": 3034.549, "timestamp": "00:50:34", "text": "而问题是，我已经做"}, {"type": "subtitle", "time": 3036.79, "timestamp": "00:50:36", "text": "这件事多少年了？"}, {"type": "subtitle", "time": 3038.63, "timestamp": "00:50:38", "text": "已经六年了。"}, {"type": "subtitle", "time": 3044.71, "timestamp": "00:50:44", "text": "我觉得，我觉得，我已经过了能把"}, {"type": "subtitle", "time": 3050.63, "timestamp": "00:50:50", "text": "这当作爱好的阶段了。 我一直把它当作"}, {"type": "subtitle", "time": 3054.15, "timestamp": "00:50:54", "text": "爱好来做。 我想"}, {"type": "subtitle", "time": 3058.47, "timestamp": "00:50:58", "text": "认真对待这件事，但我对此并不确定"}]
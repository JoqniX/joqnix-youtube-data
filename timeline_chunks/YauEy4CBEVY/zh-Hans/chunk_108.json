[{"type": "subtitle", "time": 6492.87, "timestamp": "01:48:12", "text": "我不知道，伙计。"}, {"type": "subtitle", "time": 6507.91, "timestamp": "01:48:27", "text": "他不知道"}, {"type": "subtitle", "time": 6511.75, "timestamp": "01:48:31", "text": "我是怎么死的。 几乎可以肯定，是电脑在"}, {"type": "subtitle", "time": 6515.91, "timestamp": "01:48:35", "text": "敌人出现时卡顿了。我该怎么办？"}, {"type": "subtitle", "time": 6519.935, "timestamp": "01:48:39", "text": "我可以给你看什么？"}, {"type": "subtitle", "time": 6520.59, "timestamp": "01:48:40", "text": "[哭泣]"}, {"type": "subtitle", "time": 6521.75, "timestamp": "01:48:41", "text": "[呻吟]"}, {"type": "subtitle", "time": 6532.47, "timestamp": "01:48:52", "text": "我失去了一切。"}]
[{"type": "subtitle", "time": 2465.27, "timestamp": "00:41:05", "text": "哦，等等，等等，等等。 我需要广告"}, {"type": "subtitle", "time": 2483.67, "timestamp": "00:41:23", "text": "忘了什么东西。"}, {"type": "subtitle", "time": 2485.99, "timestamp": "00:41:25", "text": "比一杯咖啡还好。 我当然不"}, {"type": "subtitle", "time": 2492.15, "timestamp": "00:41:32", "text": "我花了 8 万块钱买"}, {"type": "subtitle", "time": 2495.67, "timestamp": "00:41:35", "text": "了装备、武器、手榴弹之"}, {"type": "subtitle", "time": 2497.533, "timestamp": "00:41:37", "text": "类的东西。 哦，"}, {"type": "subtitle", "time": 2498.15, "timestamp": "00:41:38", "text": "（笑声）"}, {"type": "subtitle", "time": 2502.309, "timestamp": "00:41:42", "text": "请不要轻易死去。 乔，"}, {"type": "subtitle", "time": 2507.589, "timestamp": "00:41:47", "text": "求你了。 我现在哭了。"}, {"type": "subtitle", "time": 2511.75, "timestamp": "00:41:51", "text": "所有设置都调到了最低。"}]
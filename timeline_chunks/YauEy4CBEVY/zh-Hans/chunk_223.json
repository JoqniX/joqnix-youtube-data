[{"type": "subtitle", "time": 13393.429, "timestamp": "03:43:13", "text": "该死？"}, {"type": "subtitle", "time": 13394.87, "timestamp": "03:43:14", "text": "十分钟之内逃出去。 我"}, {"type": "subtitle", "time": 13434.55, "timestamp": "03:43:54", "text": "前进。 电梯已准备就绪。"}, {"type": "subtitle", "time": 13436.55, "timestamp": "03:43:56", "text": "好的。 走，走，走，走，走，走，走，走，走"}]
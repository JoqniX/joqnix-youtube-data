[{"type": "subtitle", "time": 3484.87, "timestamp": "00:58:04", "text": "我听到了。 你在那里。"}, {"type": "subtitle", "time": 3486.789, "timestamp": "00:58:06", "text": "好的，这个"}, {"type": "subtitle", "time": 3512.71, "timestamp": "00:58:32", "text": "它飞进来怎么办？"}, {"type": "subtitle", "time": 3515.03, "timestamp": "00:58:35", "text": "如果我引诱它。"}, {"type": "subtitle", "time": 3517.75, "timestamp": "00:58:37", "text": "我觉得这是一个冒险的举动。 不要伤害"}, {"type": "subtitle", "time": 3527.43, "timestamp": "00:58:47", "text": "不，不，不。 我在想，如果我"}, {"type": "subtitle", "time": 3531.19, "timestamp": "00:58:51", "text": "从这里开始呢？ 它不会跳起来，对吧？"}]
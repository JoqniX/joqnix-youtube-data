[{"type": "subtitle", "time": 6739.189, "timestamp": "01:52:19", "text": "我只能做到这些了。"}, {"type": "subtitle", "time": 6741.51, "timestamp": "01:52:21", "text": "嘿，很高兴见到友善的面孔。"}, {"type": "subtitle", "time": 6744.55, "timestamp": "01:52:24", "text": "你需要什么？"}, {"type": "subtitle", "time": 6757.43, "timestamp": "01:52:37", "text": "买不到那些。"}, {"type": "subtitle", "time": 6759.43, "timestamp": "01:52:39", "text": "电子产品有个很有趣的地方，一半的"}, {"type": "subtitle", "time": 6760.87, "timestamp": "01:52:40", "text": "钱都花在弄清楚它们到底有什么用上了"}, {"type": "subtitle", "time": 6763.589, "timestamp": "01:52:43", "text": "。"}, {"type": "subtitle", "time": 6766.07, "timestamp": "01:52:46", "text": "啊，我的钱。"}, {"type": "subtitle", "time": 6769.83, "timestamp": "01:52:49", "text": "我的钱花得有点多了。"}, {"type": "subtitle", "time": 6772.229, "timestamp": "01:52:52", "text": "好的。"}, {"type": "subtitle", "time": 6775.589, "timestamp": "01:52:55", "text": "拨打快照电话。 我不想做那种事"}, {"type": "subtitle", "time": 6778.31, "timestamp": "01:52:58", "text": "。 该死，这更让人"}]
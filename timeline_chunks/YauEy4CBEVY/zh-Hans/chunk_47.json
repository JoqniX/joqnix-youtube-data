[{"type": "subtitle", "time": 2824.71, "timestamp": "00:47:04", "text": "如果你只看订阅者"}, {"type": "subtitle", "time": 2827.349, "timestamp": "00:47:07", "text": "数量之类的东西，那其实不太重要"}, {"type": "subtitle", "time": 2829.27, "timestamp": "00:47:09", "text": "。"}, {"type": "subtitle", "time": 2832.79, "timestamp": "00:47:12", "text": "重要的是有多少人"}, {"type": "subtitle", "time": 2836.39, "timestamp": "00:47:16", "text": "来看直播，所有这些因素都很重要"}, {"type": "subtitle", "time": 2839.589, "timestamp": "00:47:19", "text": "。 数字并不重要。 我"}, {"type": "subtitle", "time": 2841.349, "timestamp": "00:47:21", "text": "不想过多关注这些数字"}, {"type": "subtitle", "time": 2843.99, "timestamp": "00:47:23", "text": "。"}, {"type": "subtitle", "time": 2857.349, "timestamp": "00:47:37", "text": "我仍然觉得自己微不足道。"}, {"type": "subtitle", "time": 2860.55, "timestamp": "00:47:40", "text": "我只是存在于我自己的空间里。 做"}, {"type": "subtitle", "time": 2875.67, "timestamp": "00:47:55", "text": "但作为一名创作者，我觉得自己并没有"}, {"type": "subtitle", "time": 2877.91, "timestamp": "00:47:57", "text": "做出多少贡献。 我觉得自己"}]
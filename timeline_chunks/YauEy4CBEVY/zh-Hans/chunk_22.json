[{"type": "subtitle", "time": 1322.31, "timestamp": "00:22:02", "text": "蜘蛛，尤其是大蜘蛛来"}, {"type": "subtitle", "time": 1325.029, "timestamp": "00:22:05", "text": "这里。 它将被锁定。 它无法"}, {"type": "subtitle", "time": 1328.149, "timestamp": "00:22:08", "text": "在封闭空间内跳跃。 正确的。 然后我扔出了"}, {"type": "subtitle", "time": 1332.71, "timestamp": "00:22:12", "text": "汽油弹，呃，开拓者手榴弹。"}, {"type": "subtitle", "time": 1335.669, "timestamp": "00:22:15", "text": "一击毙命。 等待 8 分钟使其"}, {"type": "subtitle", "time": 1339.909, "timestamp": "00:22:19", "text": "重新出现，然后再次执行此操作，我的试炼"}, {"type": "subtitle", "time": 1342.47, "timestamp": "00:22:22", "text": "就结束了。"}, {"type": "subtitle", "time": 1346.47, "timestamp": "00:22:26", "text": "我觉得这是个好主意。"}, {"type": "subtitle", "time": 1348.63, "timestamp": "00:22:28", "text": "是的，我们需要拿到紫色"}, {"type": "subtitle", "time": 1351.11, "timestamp": "00:22:31", "text": "奖励。"}, {"type": "subtitle", "time": 1353.27, "timestamp": "00:22:33", "text": "我只需要杀它两次就搞定了"}, {"type": "subtitle", "time": 1356.07, "timestamp": "00:22:36", "text": "。 是的，只要杀它两次就行了"}, {"type": "subtitle", "time": 1359.43, "timestamp": "00:22:39", "text": "。 好的。   是的"}, {"type": "subtitle", "time": 1362.39, "timestamp": "00:22:42", "text": "。 所以，呃，我们需要很多"}, {"type": "subtitle", "time": 1368.87, "timestamp": "00:22:48", "text": "手榴弹。 我不想用这些。"}, {"type": "subtitle", "time": 1371.35, "timestamp": "00:22:51", "text": "这些是给大人物、女王"}, {"type": "subtitle", "time": 1373.43, "timestamp": "00:22:53", "text": "和女族长的。"}, {"type": "subtitle", "time": 1376.71, "timestamp": "00:22:56", "text": "嗯，是的，我们可以收下这些。"}, {"type": "subtitle", "time": 1379.27, "timestamp": "00:22:59", "text": "但愿我不会死。 多带些"}]
[{"type": "subtitle", "time": 11791.349, "timestamp": "03:16:31", "text": "我觉得自己穷得叮当响。 我"}, {"type": "subtitle", "time": 11808.55, "timestamp": "03:16:48", "text": "比如，如果我现在找到了弹药之类的东西，"}, {"type": "subtitle", "time": 11812.389, "timestamp": "03:16:52", "text": "我就得把它带回家。"}, {"type": "subtitle", "time": 11815.11, "timestamp": "03:16:55", "text": "我觉得是因为"}, {"type": "subtitle", "time": 11819.19, "timestamp": "03:16:59", "text": "我快用完了。"}]
[{"type": "subtitle", "time": 4202.95, "timestamp": "01:10:02", "text": "找到跳跃者，然后我们干掉它。 好的。"}, {"type": "subtitle", "time": 4206.79, "timestamp": "01:10:06", "text": "好的。 时间快到了。"}, {"type": "subtitle", "time": 4209.11, "timestamp": "01:10:09", "text": "呃，是8分钟，对吧？ 我再等"}, {"type": "subtitle", "time": 4211.83, "timestamp": "01:10:11", "text": "6分钟。 或许有点反应"}, {"type": "subtitle", "time": 4215.83, "timestamp": "01:10:15", "text": "过度了。 我不太确定。"}, {"type": "subtitle", "time": 4217.75, "timestamp": "01:10:17", "text": "只要我能带走点什么，"}, {"type": "subtitle", "time": 4221.43, "timestamp": "01:10:21", "text": "我就没意见。 就算失去一切，我也没关系。"}]
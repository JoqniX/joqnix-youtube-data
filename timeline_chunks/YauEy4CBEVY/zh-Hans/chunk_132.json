[{"type": "subtitle", "time": 7925.589, "timestamp": "02:12:05", "text": "我恨它。"}, {"type": "subtitle", "time": 7927.589, "timestamp": "02:12:07", "text": "嗨，我是阿波罗。"}, {"type": "subtitle", "time": 7929.51, "timestamp": "02:12:09", "text": "突袭者，你带手榴弹了吗？ 我的新设计"}, {"type": "subtitle", "time": 7931.35, "timestamp": "02:12:11", "text": "在纸上看起来很棒，但我需要找人把"}, {"type": "subtitle", "time": 7932.55, "timestamp": "02:12:12", "text": "它们放到机器上测试一下才能确定效果"}, {"type": "subtitle", "time": 7978.87, "timestamp": "02:12:58", "text": "我在这里。"}]
[{"type": "subtitle", "time": 1658.39, "timestamp": "00:27:38", "text": "请把我生成在东边上方。"}, {"type": "subtitle", "time": 1660.71, "timestamp": "00:27:40", "text": "请往东上方走。"}, {"type": "subtitle", "time": 1663.909, "timestamp": "00:27:43", "text": "顶部在东边还是西边？ 我只要找到那个"}, {"type": "subtitle", "time": 1666.39, "timestamp": "00:27:46", "text": "跳跃者，干掉它，然后收工离开就行了"}, {"type": "subtitle", "time": 1668.789, "timestamp": "00:27:48", "text": "。 算了。"}, {"type": "subtitle", "time": 1671.43, "timestamp": "00:27:51", "text": "离开。"}]
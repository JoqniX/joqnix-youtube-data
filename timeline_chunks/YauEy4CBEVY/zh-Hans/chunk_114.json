[{"type": "subtitle", "time": 6842.47, "timestamp": "01:54:02", "text": "[笑声] 不，我不会结束"}, {"type": "subtitle", "time": 6853.99, "timestamp": "01:54:13", "text": "呃，我们必须……呃，我们现在必须把10万"}, {"type": "subtitle", "time": 6858.31, "timestamp": "01:54:18", "text": "美元赚回来。 我决定不再这么做了"}, {"type": "subtitle", "time": 6859.99, "timestamp": "01:54:19", "text": "。"}, {"type": "subtitle", "time": 6862.07, "timestamp": "01:54:22", "text": "或许"}, {"type": "subtitle", "time": 6864.95, "timestamp": "01:54:24", "text": "我真的不知道。 或者我可以去打"}, {"type": "subtitle", "time": 6868.47, "timestamp": "01:54:28", "text": "其他boss，其他那些笨重的家伙。 大"}, {"type": "subtitle", "time": 6870.87, "timestamp": "01:54:30", "text": "叮当声。"}, {"type": "subtitle", "time": 6874.47, "timestamp": "01:54:34", "text": "我可以用“哦，狼群手榴弹”来对付他"}, {"type": "subtitle", "time": 6877.43, "timestamp": "01:54:37", "text": "。   是的"}, {"type": "subtitle", "time": 6895.43, "timestamp": "01:54:55", "text": "我的意思是，我可以像这样杀戮：啊，我的"}, {"type": "subtitle", "time": 6897.91, "timestamp": "01:54:57", "text": "物种正在挣扎。 请"}]
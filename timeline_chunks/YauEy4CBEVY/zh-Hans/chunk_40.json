[{"type": "subtitle", "time": 2400.71, "timestamp": "00:40:00", "text": "哦，我把一切都拿走了。哦，不。 我把所有的"}, {"type": "subtitle", "time": 2408.87, "timestamp": "00:40:08", "text": "和草药绷带都带走了。"}, {"type": "subtitle", "time": 2413.349, "timestamp": "00:40:13", "text": "兄弟，我穷死了。"}, {"type": "subtitle", "time": 2415.27, "timestamp": "00:40:15", "text": "我真的没事，你知道吗？ 我会"}, {"type": "subtitle", "time": 2419.67, "timestamp": "00:40:19", "text": "花钱。 没关系。 好的，我会说不，不，"}, {"type": "subtitle", "time": 2422.95, "timestamp": "00:40:22", "text": "不。 绷带很贵。 我大概会收到"}, {"type": "subtitle", "time": 2424.47, "timestamp": "00:40:24", "text": "这个"}, {"type": "subtitle", "time": 2432.15, "timestamp": "00:40:32", "text": "我感觉自己快要累垮了，这肯定很适合"}, {"type": "subtitle", "time": 2434.87, "timestamp": "00:40:34", "text": "你。"}, {"type": "subtitle", "time": 2435.19, "timestamp": "00:40:35", "text": "啊，"}, {"type": "subtitle", "time": 2438.23, "timestamp": "00:40:38", "text": "这下糟了。 这是个愚蠢的举动。 啊，"}, {"type": "subtitle", "time": 2441.829, "timestamp": "00:40:41", "text": "没关系。 没关系。 没关系。"}, {"type": "subtitle", "time": 2446.87, "timestamp": "00:40:46", "text": "这一次我肯定不会失败。   但愿如此"}, {"type": "subtitle", "time": 2448.23, "timestamp": "00:40:48", "text": "。"}, {"type": "subtitle", "time": 2458.55, "timestamp": "00:40:58", "text": "哦，哪里有地方吃午饭？  M."}]
[{"type": "subtitle", "time": 10688.23, "timestamp": "02:58:08", "text": "阵地。"}, {"type": "subtitle", "time": 10704.309, "timestamp": "02:58:24", "text": "谢谢。"}, {"type": "subtitle", "time": 10710.71, "timestamp": "02:58:30", "text": "我们"}, {"type": "subtitle", "time": 10713.269, "timestamp": "02:58:33", "text": "去杀了他们。 不，我不会PVP。 我将被"}, {"type": "subtitle", "time": 10715.83, "timestamp": "02:58:35", "text": "放入PvP大厅。 我不想参与玩家对战（PvP）。"}, {"type": "subtitle", "time": 10719.349, "timestamp": "02:58:39", "text": "但我终究会死。 我已经对"}, {"type": "subtitle", "time": 10724.428, "timestamp": "02:58:44", "text": "Arc感到非常厌倦了，今天差点就因为玩不下去而放弃了。"}, {"type": "subtitle", "time": 10726.07, "timestamp": "02:58:46", "text": "[笑声]"}, {"type": "subtitle", "time": 10729.51, "timestamp": "02:58:49", "text": "我今天差点就气得退游了。 真是太"}, {"type": "subtitle", "time": 10732.23, "timestamp": "02:58:52", "text": "疯狂了。"}, {"type": "subtitle", "time": 10735.67, "timestamp": "02:58:55", "text": "就像……两个小时前，一个小时前。 两小时"}, {"type": "subtitle", "time": 10738.469, "timestamp": "02:58:58", "text": "前。 是的。  1小时前。 我当时都准备"}]
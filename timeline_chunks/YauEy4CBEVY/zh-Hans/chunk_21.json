[{"type": "subtitle", "time": 1262.63, "timestamp": "00:21:02", "text": "。 我忘了给我的Twitch账号"}, {"type": "subtitle", "time": 1265.51, "timestamp": "00:21:05", "text": "做验证。 但"}, {"type": "subtitle", "time": 1267.51, "timestamp": "00:21:07", "text": "您无需"}, {"type": "subtitle", "time": 1270.31, "timestamp": "00:21:10", "text": "验证您的手机号码。 所以别太担心"}, {"type": "subtitle", "time": 1273.83, "timestamp": "00:21:13", "text": "。"}, {"type": "subtitle", "time": 1276.95, "timestamp": "00:21:16", "text": "嗯，好的。 我需要查看一下交互式"}, {"type": "subtitle", "time": 1280.39, "timestamp": "00:21:20", "text": "地图。 黑暗掠夺者"}, {"type": "subtitle", "time": 1283.27, "timestamp": "00:21:23", "text": "指引他前往跳跃者（那个爱"}, {"type": "subtitle", "time": 1290.07, "timestamp": "00:21:30", "text": "跳的家伙）的刷新点。 所以我们会"}, {"type": "subtitle", "time": 1293.59, "timestamp": "00:21:33", "text": "尝试两次杀死跳跃者。"}, {"type": "subtitle", "time": 1296.789, "timestamp": "00:21:36", "text": "好的，它会放在这里。"}, {"type": "subtitle", "time": 1300.31, "timestamp": "00:21:40", "text": "所以跳跃者在这里和"}, {"type": "subtitle", "time": 1303.11, "timestamp": "00:21:43", "text": "那里都有出现。"}, {"type": "subtitle", "time": 1307.19, "timestamp": "00:21:47", "text": "这个和这个。 这个和这个。 所以，我们"}, {"type": "subtitle", "time": 1310.47, "timestamp": "00:21:50", "text": "来到了发射塔。 不，不是到达"}, {"type": "subtitle", "time": 1313.27, "timestamp": "00:21:53", "text": "大楼，也不是这里。"}, {"type": "subtitle", "time": 1315.51, "timestamp": "00:21:55", "text": "我觉得我最好还是去到达"}, {"type": "subtitle", "time": 1319.11, "timestamp": "00:21:59", "text": "大楼。 快到这边躲起来。 不想让"}]
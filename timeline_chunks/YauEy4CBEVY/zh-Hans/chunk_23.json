[{"type": "subtitle", "time": 1383.83, "timestamp": "00:23:03", "text": "绷带。 我这次不应该死。"}, {"type": "subtitle", "time": 1388.789, "timestamp": "00:23:08", "text": "很多治愈系疗法。 很多绷带。"}, {"type": "subtitle", "time": 1398.71, "timestamp": "00:23:18", "text": "我尽可能多地拿绷带。"}, {"type": "subtitle", "time": 1401.75, "timestamp": "00:23:21", "text": "呃，护盾充能器。 我没有那个东西"}, {"type": "subtitle", "time": 1415.35, "timestamp": "00:23:35", "text": "呃，它在哪儿？"}, {"type": "subtitle", "time": 1422.011, "timestamp": "00:23:42", "text": "我妈妈一直都很想念这些东西。"}, {"type": "subtitle", "time": 1422.789, "timestamp": "00:23:42", "text": "[笑声]"}, {"type": "subtitle", "time": 1425.59, "timestamp": "00:23:45", "text": "嘿，"}, {"type": "subtitle", "time": 1428.23, "timestamp": "00:23:48", "text": "我不需要杀太多人。   我的"}, {"type": "subtitle", "time": 1434.47, "timestamp": "00:23:54", "text": "我挡住。"}, {"type": "subtitle", "time": 1436.87, "timestamp": "00:23:56", "text": "不过我倒是可以花钱。 但"}]
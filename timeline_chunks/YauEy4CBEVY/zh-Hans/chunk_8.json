[{"type": "subtitle", "time": 482.629, "timestamp": "00:08:02", "text": "因为我必须平衡现实生活、"}, {"type": "subtitle", "time": 485.67, "timestamp": "00:08:05", "text": "兼职、这那两件事，以及生活中的其他事情"}, {"type": "subtitle", "time": 491.43, "timestamp": "00:08:11", "text": "。 呃，这取决于我是否能够进行"}, {"type": "subtitle", "time": 494.309, "timestamp": "00:08:14", "text": "直播。 当然我可以再参加"}, {"type": "subtitle", "time": 498.15, "timestamp": "00:08:18", "text": "一次跑步马拉松，但"}, {"type": "subtitle", "time": 501.189, "timestamp": "00:08:21", "text": "如果"}, {"type": "subtitle", "time": 505.27, "timestamp": "00:08:25", "text": "没有具体目标，那参加跑步马拉松的意义何在呢？ 不，换个角度"}, {"type": "subtitle", "time": 508.869, "timestamp": "00:08:28", "text": "想。"}, {"type": "subtitle", "time": 510.869, "timestamp": "00:08:30", "text": "上次我参加 Joathon 活动只是为了那个"}, {"type": "subtitle", "time": 513.269, "timestamp": "00:08:33", "text": "模特。 那是为了钱，一切都是为了钱。"}, {"type": "subtitle", "time": 516.23, "timestamp": "00:08:36", "text": "结果不太理想。 我"}, {"type": "subtitle", "time": 519.99, "timestamp": "00:08:39", "text": "什么新东西都没有。"}, {"type": "subtitle", "time": 523.35, "timestamp": "00:08:43", "text": "我当时就是凭感觉做的，大概就是这样吧"}, {"type": "subtitle", "time": 531.67, "timestamp": "00:08:51", "text": "嗯，是的，或者当然我也可以用"}, {"type": "subtitle", "time": 534.389, "timestamp": "00:08:54", "text": "另一种方式，比如设定"}, {"type": "subtitle", "time": 538.71, "timestamp": "00:08:58", "text": "一个粉丝数量目标之类的"}]
[{"type": "subtitle", "time": 4744.864, "timestamp": "01:19:04", "text": "我连"}, {"type": "subtitle", "time": 4755.11, "timestamp": "01:19:15", "text": "。"}, {"type": "subtitle", "time": 4768.31, "timestamp": "01:19:28", "text": "有些人购物很快，有些人则喜欢久留。"}, {"type": "subtitle", "time": 4781.43, "timestamp": "01:19:41", "text": "这简直太愚蠢了。"}, {"type": "subtitle", "time": 4793.59, "timestamp": "01:19:53", "text": "我们这里一直需要更多园艺爱好者"}]
[{"type": "subtitle", "time": 9325.91, "timestamp": "02:35:25", "text": "。"}, {"type": "subtitle", "time": 9331.51, "timestamp": "02:35:31", "text": "71に戻る予定なので、彼らが何も言わないことを願っていますが、"}, {"type": "subtitle", "time": 9334.23, "timestamp": "02:35:34", "text": "別の店で買い物をしただけです"}, {"type": "subtitle", "time": 9336.389, "timestamp": "02:35:36", "text": "。"}, {"type": "subtitle", "time": 9339.27, "timestamp": "02:35:39", "text": "その何か。 ポテトチップスとか色々買ったよ"}, {"type": "subtitle", "time": 9342.389, "timestamp": "02:35:42", "text": "。 わかった、たぶん彼に船を譲るよ"}, {"type": "subtitle", "time": 9343.99, "timestamp": "02:35:43", "text": "。"}, {"type": "subtitle", "time": 9346.389, "timestamp": "02:35:46", "text": "とりあえずカップ"}, {"type": "subtitle", "time": 9349.349, "timestamp": "02:35:49", "text": "麺を開けてみます。 うん。"}, {"type": "subtitle", "time": 9357.75, "timestamp": "02:35:57", "text": "写真を撮るべきでしょうか？"}]
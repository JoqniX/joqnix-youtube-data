[{"type": "subtitle", "time": 12421.67, "timestamp": "03:27:01", "text": "ババババのような主要都市は、インフラが整った"}, {"type": "subtitle", "time": 12423.75, "timestamp": "03:27:03", "text": "工業ハブとして発展している。"}, {"type": "subtitle", "time": 12425.99, "timestamp": "03:27:05", "text": "そして"}, {"type": "subtitle", "time": 12443.91, "timestamp": "03:27:23", "text": "。福岡とかそういう感じですよね"}, {"type": "subtitle", "time": 12445.99, "timestamp": "03:27:25", "text": "？"}, {"type": "subtitle", "time": 12452.469, "timestamp": "03:27:32", "text": "どこにお住まいですか？"}, {"type": "subtitle", "time": 12460.95, "timestamp": "03:27:40", "text": "でも東京ではありません。大阪でもありません。"}, {"type": "subtitle", "time": 12464.229, "timestamp": "03:27:44", "text": "京都でもありません。"}, {"type": "subtitle", "time": 12466.87, "timestamp": "03:27:46", "text": "東京からは遠いです。"}, {"type": "subtitle", "time": 12471.19, "timestamp": "03:27:51", "text": "でもKTOエリア内、"}, {"type": "subtitle", "time": 12473.76, "timestamp": "03:27:53", "text": "KTOエリア内、 渋谷とか、"}, {"type": "subtitle", "time": 12476.64, "timestamp": "03:27:56", "text": "渋谷とか、 渋谷に行くには"}]
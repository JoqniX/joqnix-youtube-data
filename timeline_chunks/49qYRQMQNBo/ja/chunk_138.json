[{"type": "subtitle", "time": 8284.709, "timestamp": "02:18:04", "text": "ダンと話してるのが聞こえた？えっと、"}, {"type": "subtitle", "time": 8287.429, "timestamp": "02:18:07", "text": "みんな、聞こえた？"}, {"type": "subtitle", "time": 8290.15, "timestamp": "02:18:10", "text": "私は、えっと、彼女と話してたんだ。 彼女は"}, {"type": "subtitle", "time": 8293.349, "timestamp": "02:18:13", "text": "私によく会ってくれていて、案内してくれたり、いろいろ教えてくれたりして、本当に親切にしてくれています。本当に素敵な"}, {"type": "subtitle", "time": 8305.669, "timestamp": "02:18:25", "text": "女性です。本当に素敵な女性です。"}, {"type": "subtitle", "time": 8331.19, "timestamp": "02:18:51", "text": "待って、彼女は待ってるの？"}, {"type": "subtitle", "time": 8334.709, "timestamp": "02:18:54", "text": "もし私がストリーミングしていなかったら、"}]
[{"type": "subtitle", "time": 13563.67, "timestamp": "03:46:03", "text": "日本語を話して"}, {"type": "subtitle", "time": 13566.15, "timestamp": "03:46:06", "text": "語彙と会話スキルを向上させるための配信であるはずでした"}, {"type": "subtitle", "time": 13570.15, "timestamp": "03:46:10", "text": "。でも、今日は英語をたくさん話しました"}, {"type": "subtitle", "time": 13571.83, "timestamp": "03:46:11", "text": "。"}, {"type": "subtitle", "time": 13576.309, "timestamp": "03:46:16", "text": "でも大丈夫です。楽しい時間を過ごせました。だから、"}, {"type": "subtitle", "time": 13580.55, "timestamp": "03:46:20", "text": "ありがとう。 ついてきてください。ありがとうございます。"}, {"type": "subtitle", "time": 13583.11, "timestamp": "03:46:23", "text": "ええと、とにかく、今日はありがとうございました。"}, {"type": "subtitle", "time": 13585.59, "timestamp": "03:46:25", "text": "ここで締めくくります。"}, {"type": "subtitle", "time": 13602.309, "timestamp": "03:46:42", "text": "はい、インターネットが切れました。すみません。すみません。"}, {"type": "subtitle", "time": 13604.309, "timestamp": "03:46:44", "text": "明日、"}, {"type": "subtitle", "time": 13607.429, "timestamp": "03:46:47", "text": "Valerance ストリームがあると言っていましたが、デスクトップ デスクトップ"}, {"type": "subtitle", "time": 13610.15, "timestamp": "03:46:50", "text": "ストリームで、このような IRL ストリームではありません。それは、"}, {"type": "subtitle", "time": 13615.03, "timestamp": "03:46:55", "text": "IST の午後 2 時、つまり午後 5 時 30 分です。"}]
[{"type": "subtitle", "time": 12720.309, "timestamp": "03:32:00", "text": "10時だったかな？1時間。いや、1時間。うん"}, {"type": "subtitle", "time": 12722.95, "timestamp": "03:32:02", "text": "、1時間くらいかな。"}, {"type": "subtitle", "time": 12725.349, "timestamp": "03:32:05", "text": "学べば学ぶほど、"}, {"type": "subtitle", "time": 12730.309, "timestamp": "03:32:10", "text": "無駄にする時間がたくさんあることに気づくよ。そうだといいな。"}, {"type": "subtitle", "time": 12735.19, "timestamp": "03:32:15", "text": "どの国でも真実だよね。そうだよ。"}, {"type": "subtitle", "time": 12736.79, "timestamp": "03:32:16", "text": "この状況は続くわけじゃない。"}, {"type": "subtitle", "time": 12740.15, "timestamp": "03:32:20", "text": "つまり、誰が聞いてるの？"}, {"type": "subtitle", "time": 12743.03, "timestamp": "03:32:23", "text": "いい仕事に就いて、"}, {"type": "subtitle", "time": 12746.55, "timestamp": "03:32:26", "text": "ここで幸せに暮らせることを願ってる。それは"}, {"type": "subtitle", "time": 12755.75, "timestamp": "03:32:35", "text": "日本にいる外国人全員の期待であり夢みたいなものだよね。"}, {"type": "subtitle", "time": 12761.11, "timestamp": "03:32:41", "text": "ずっとここに住み続けられるし、"}, {"type": "subtitle", "time": 12766.71, "timestamp": "03:32:46", "text": "楽しいし、いいし、ある意味"}, {"type": "subtitle", "time": 12769.429, "timestamp": "03:32:49", "text": "インドよりずっといい。でも"}, {"type": "subtitle", "time": 12771.67, "timestamp": "03:32:51", "text": "インドも恋しい。インドも恋しくない"}, {"type": "subtitle", "time": 12775.11, "timestamp": "03:32:55", "text": "けど、それに対する反応が遅れてるというか、"}]
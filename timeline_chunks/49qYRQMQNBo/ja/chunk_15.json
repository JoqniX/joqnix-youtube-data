[{"type": "subtitle", "time": 923.99, "timestamp": "00:15:23", "text": "イヤホンが見つからないんだよ。 イヤホンを忘れてしまった"}, {"type": "subtitle", "time": 929.11, "timestamp": "00:15:29", "text": "。 それで、実は行けなかったんです"}, {"type": "subtitle", "time": 932.47, "timestamp": "00:15:32", "text": "。 一日中雨だったので、"}, {"type": "subtitle", "time": 955.43, "timestamp": "00:15:55", "text": "午前中はほとんど治療に行けず、仕事が増えました。   気をつけて"}]
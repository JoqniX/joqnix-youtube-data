[{"type": "subtitle", "time": 6963.109, "timestamp": "01:56:03", "text": "。"}, {"type": "subtitle", "time": 6971.83, "timestamp": "01:56:11", "text": "とか、"}, {"type": "subtitle", "time": 6974.709, "timestamp": "01:56:14", "text": "セブンイレブン、"}, {"type": "subtitle", "time": 6976.39, "timestamp": "01:56:16", "text": "ファミリーマート、"}, {"type": "subtitle", "time": 6979.27, "timestamp": "01:56:19", "text": "ミニストップなどのコンビニの外で食べ物を食べてはいけないんです。"}, {"type": "subtitle", "time": 6981.669, "timestamp": "01:56:21", "text": "そして、雨が"}, {"type": "subtitle", "time": 6984.629, "timestamp": "01:56:24", "text": "降っているときはレインコートを着てはいけないんです。"}, {"type": "subtitle", "time": 6988.709, "timestamp": "01:56:28", "text": "レインコートを着て店の中に入ってはいけません。"}, {"type": "subtitle", "time": 6993.83, "timestamp": "01:56:33", "text": "危険だからです。危険というのは、"}, {"type": "subtitle", "time": 6997.03, "timestamp": "01:56:37", "text": "床を濡らしてしまうからです。"}, {"type": "subtitle", "time": 6999.27, "timestamp": "01:56:39", "text": "ええ。67"}, {"type": "subtitle", "time": 7007.99, "timestamp": "01:56:47", "text": "わかりません。67ってどういう意味でしたっけ？忘れました。"}, {"type": "subtitle", "time": 7016.149, "timestamp": "01:56:56", "text": "えっと、何？ またあのミームだったっけ？"}]
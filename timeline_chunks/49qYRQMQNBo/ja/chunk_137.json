[{"type": "subtitle", "time": 8223.429, "timestamp": "02:17:03", "text": "店、スーパーに行って、何が"}, {"type": "subtitle", "time": 8226.23, "timestamp": "02:17:06", "text": "あるか見てみるよ。"}, {"type": "subtitle", "time": 8230.07, "timestamp": "02:17:10", "text": "問題は、買ったばかりの71の袋を持たなきゃいけないこと"}, {"type": "subtitle", "time": 8234.309, "timestamp": "02:17:14", "text": "。でも、それも大丈夫。"}, {"type": "subtitle", "time": 8238.309, "timestamp": "02:17:18", "text": "つまり"}, {"type": "subtitle", "time": 8241.83, "timestamp": "02:17:21", "text": "、そこに行って、何があるか見て、もしかしたら"}, {"type": "subtitle", "time": 8243.349, "timestamp": "02:17:23", "text": "買って、"}, {"type": "subtitle", "time": 8246.07, "timestamp": "02:17:26", "text": "セブンイレブンに戻って、"}, {"type": "subtitle", "time": 8249.91, "timestamp": "02:17:29", "text": "ラーメンを開けて、お湯を入れて、"}, {"type": "subtitle", "time": 8252.95, "timestamp": "02:17:32", "text": "公園に行くってこと。だから"}, {"type": "subtitle", "time": 8255.83, "timestamp": "02:17:35", "text": "、カプラを持たなきゃいけない。つまり、"}, {"type": "subtitle", "time": 8261.589, "timestamp": "02:17:41", "text": "カプラを手に持たなきゃいけないってこと。"}, {"type": "subtitle", "time": 8264.07, "timestamp": "02:17:44", "text": "こんにちは。フォローしてくれてありがとう、"}, {"type": "subtitle", "time": 8275.429, "timestamp": "02:17:55", "text": "フォローしてくれてありがとう。ちょっと"}, {"type": "subtitle", "time": 8278.469, "timestamp": "02:17:58", "text": "待って、みんな、私が"}]
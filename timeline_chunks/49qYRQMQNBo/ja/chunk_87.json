[{"type": "subtitle", "time": 5220.95, "timestamp": "01:27:00", "text": "言いたかったんだけど。 えーっと、何か"}, {"type": "subtitle", "time": 5224.629, "timestamp": "01:27:04", "text": "短い話をするつもりだったんだけど、結局話しすぎて、"}, {"type": "subtitle", "time": 5231.83, "timestamp": "01:27:11", "text": "大きな会話みたいになっちゃった"}, {"type": "subtitle", "time": 5234.31, "timestamp": "01:27:14", "text": "。"}, {"type": "subtitle", "time": 5243.59, "timestamp": "01:27:23", "text": "ルームメイトが"}, {"type": "subtitle", "time": 5248.07, "timestamp": "01:27:28", "text": "楽しんでいるのが羨ましい。えーっと、私も勉強とか色々"}, {"type": "subtitle", "time": 5251.75, "timestamp": "01:27:31", "text": "ストレスや不安を抱えながら楽しんでいる。だって、私は"}, {"type": "subtitle", "time": 5259.99, "timestamp": "01:27:39", "text": "今、不安症だから。だから、"}, {"type": "subtitle", "time": 5263.59, "timestamp": "01:27:43", "text": "違うはずだったのに、つまり、"}]
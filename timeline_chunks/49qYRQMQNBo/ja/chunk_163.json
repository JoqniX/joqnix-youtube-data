[{"type": "subtitle", "time": 9783.19, "timestamp": "02:43:03", "text": "だから、私はここに携帯電話を置いておける。"}, {"type": "subtitle", "time": 9785.11, "timestamp": "02:43:05", "text": "切った麺をここに置いてください。"}, {"type": "subtitle", "time": 9793.429, "timestamp": "02:43:13", "text": "箸を取ってください。 はい、"}, {"type": "subtitle", "time": 9805.11, "timestamp": "02:43:25", "text": "私のデザートをあそこに置いてください。 お箸は"}, {"type": "subtitle", "time": 9806.63, "timestamp": "02:43:26", "text": "こちらです。 写真を撮ってみようと思います"}, {"type": "subtitle", "time": 9808.87, "timestamp": "02:43:28", "text": "。"}, {"type": "subtitle", "time": 9812.309, "timestamp": "02:43:32", "text": "私はこの牛を持っていて、"}, {"type": "subtitle", "time": 9815.19, "timestamp": "02:43:35", "text": "ナナチキンのようなものを買いました。 これは"}, {"type": "subtitle", "time": 9817.75, "timestamp": "02:43:37", "text": "ナナチキンではありません。 醤油味の"}, {"type": "subtitle", "time": 9831.429, "timestamp": "02:43:51", "text": "これも。"}]
[{"type": "subtitle", "time": 3721.99, "timestamp": "01:02:01", "text": "。 あなたは"}, {"type": "subtitle", "time": 3724.71, "timestamp": "01:02:04", "text": "Twitchをやっていると思います。"}, {"type": "subtitle", "time": 3728.23, "timestamp": "01:02:08", "text": "Twitchに来てくれてありがとう。 問題は、今、私は"}, {"type": "subtitle", "time": 3730.39, "timestamp": "01:02:10", "text": "こういうインタラクティブなことをやりたいということです。   以前"}, {"type": "subtitle", "time": 3734.069, "timestamp": "01:02:14", "text": "Sammyなどでやっていたことは、あらゆる"}, {"type": "subtitle", "time": 3737.349, "timestamp": "01:02:17", "text": "面で余計な"}, {"type": "subtitle", "time": 3740.63, "timestamp": "01:02:20", "text": "ことをやっていて、"}, {"type": "subtitle", "time": 3745.91, "timestamp": "01:02:25", "text": "時間が経つにつれて頭痛の種になってきます。「あ、"}, {"type": "subtitle", "time": 3748.47, "timestamp": "01:02:28", "text": "これはうまくいかない」「あ、これは"}, {"type": "subtitle", "time": 3751.75, "timestamp": "01:02:31", "text": "忘れた」「これは壊れている」「あれもこれも」といった"}, {"type": "subtitle", "time": 3756.23, "timestamp": "01:02:36", "text": "技術的な問題や精神的な問題、私の考え方の問題などです。"}, {"type": "subtitle", "time": 3761.829, "timestamp": "01:02:41", "text": "例えば、"}, {"type": "subtitle", "time": 3764.95, "timestamp": "01:02:44", "text": "友達がコーディングしたアプリでモバイルストリームをやっているとします。 見た目は"}, {"type": "subtitle", "time": 3768.87, "timestamp": "01:02:48", "text": "デスクトップ版のストリームとそっくりだが、実際はモバイル版の"}, {"type": "subtitle", "time": 3771.43, "timestamp": "01:02:51", "text": "ストリームだ。 私は文字通り"}, {"type": "subtitle", "time": 3775.19, "timestamp": "01:02:55", "text": "携帯電話で操作していて、PCは一切使っていませんよね？"}, {"type": "subtitle", "time": 3777.67, "timestamp": "01:02:57", "text": "以前の配信とは違って、"}]
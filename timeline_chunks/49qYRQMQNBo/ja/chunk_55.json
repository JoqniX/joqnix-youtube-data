[{"type": "subtitle", "time": 3300.71, "timestamp": "00:55:00", "text": "ストリーミングをして、何かをして、時間を無駄にしていました。"}, {"type": "subtitle", "time": 3303.829, "timestamp": "00:55:03", "text": "そして今、私は"}, {"type": "subtitle", "time": 3306.79, "timestamp": "00:55:06", "text": "時間の価値と、"}, {"type": "subtitle", "time": 3310.23, "timestamp": "00:55:10", "text": "時間がどれほど貴重であるかを理解しています。   よし"}, {"type": "subtitle", "time": 3316.71, "timestamp": "00:55:16", "text": "だから、"}, {"type": "subtitle", "time": 3324.23, "timestamp": "00:55:24", "text": "インドにいた頃の自分の行動やライフスタイルなどについて、後悔していることがたくさんあるんです。でも、"}, {"type": "subtitle", "time": 3330.71, "timestamp": "00:55:30", "text": "今週は、できる限り"}, {"type": "subtitle", "time": 3335.589, "timestamp": "00:55:35", "text": "毎日配信を続けていこうと思っています"}, {"type": "subtitle", "time": 3338.39, "timestamp": "00:55:38", "text": "。 でも、こんな風に完全に英語だけで話すべきではない"}, {"type": "subtitle", "time": 3341.03, "timestamp": "00:55:41", "text": "。 それは"}, {"type": "subtitle", "time": 3343.349, "timestamp": "00:55:43", "text": "配信の趣旨ではない。 さて、"}]
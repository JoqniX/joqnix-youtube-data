[{"type": "subtitle", "time": 4743.669, "timestamp": "01:19:03", "text": "けど、ルームメイトが僕の"}, {"type": "subtitle", "time": 4746.149, "timestamp": "01:19:06", "text": "ファッションを少し変えてくれて、"}, {"type": "subtitle", "time": 4748.79, "timestamp": "01:19:08", "text": "本当に感謝してる。"}, {"type": "subtitle", "time": 4751.59, "timestamp": "01:19:11", "text": "でも、人間として変わらなきゃいけないことがたくさんあるから、"}, {"type": "subtitle", "time": 4760.229, "timestamp": "01:19:20", "text": "この2年間、もしくは"}, {"type": "subtitle", "time": 4764.79, "timestamp": "01:19:24", "text": "日本にいる間にその変化を楽しみにしているんだ。うん。"}, {"type": "subtitle", "time": 4798.63, "timestamp": "01:19:58", "text": "あ、ごめん。ごめん。アプリがクラッシュした。ローマン、"}]
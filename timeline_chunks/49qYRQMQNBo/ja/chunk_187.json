[{"type": "subtitle", "time": 11221.429, "timestamp": "03:07:01", "text": "2ヶ月しか経っていない。 あなたは"}, {"type": "subtitle", "time": 11223.269, "timestamp": "03:07:03", "text": "特定の学位を持っていません。 私は"}, {"type": "subtitle", "time": 11225.349, "timestamp": "03:07:05", "text": "語学の学位を取得する予定です。"}, {"type": "subtitle", "time": 11228.55, "timestamp": "03:07:08", "text": "語学の学位は持っていません。 ええと、語学"}, {"type": "subtitle", "time": 11231.349, "timestamp": "03:07:11", "text": "資格ですね。 それが"}, {"type": "subtitle", "time": 11234.07, "timestamp": "03:07:14", "text": "ここで重要な点だ。"}, {"type": "subtitle", "time": 11235.59, "timestamp": "03:07:15", "text": "うん。"}, {"type": "subtitle", "time": 11237.75, "timestamp": "03:07:17", "text": "学位は関係ありません。"}, {"type": "subtitle", "time": 11240.95, "timestamp": "03:07:20", "text": "ここには学位を持たない人もいる。"}, {"type": "subtitle", "time": 11244.15, "timestamp": "03:07:24", "text": "あなたの経験は重要です。"}, {"type": "subtitle", "time": 11245.67, "timestamp": "03:07:25", "text": "ええ、"}, {"type": "subtitle", "time": 11253.11, "timestamp": "03:07:33", "text": "つまり、経験の面で何かを見せれば、簡単に何らかのエージェンシーに入ったり、"}, {"type": "subtitle", "time": 11257.11, "timestamp": "03:07:37", "text": "マネージャーやスタッフとして働いたりできると思うんです"}, {"type": "subtitle", "time": 11265.51, "timestamp": "03:07:45", "text": "。"}, {"type": "subtitle", "time": 11267.91, "timestamp": "03:07:47", "text": "でも、今はまだそうしたくありません。 それは"}, {"type": "subtitle", "time": 11271.03, "timestamp": "03:07:51", "text": "予備策だ。 私には目標がある。 私は"}, {"type": "subtitle", "time": 11274.23, "timestamp": "03:07:54", "text": "その目標に向かって努力し、最善を尽くします。"}, {"type": "subtitle", "time": 11277.59, "timestamp": "03:07:57", "text": "しかし、私はいくつかのアイデアについて調査を行いました"}]
[{"type": "subtitle", "time": 12900.15, "timestamp": "03:35:00", "text": "学校とか、美術学校とか、マンガ学校とか、いろんな学校を回ってみたんだ。 学校とか、"}, {"type": "subtitle", "time": 12904.71, "timestamp": "03:35:04", "text": "クリエイティブな芸術分野が全部揃った学校とか"}, {"type": "subtitle", "time": 12907.19, "timestamp": "03:35:07", "text": "。"}, {"type": "subtitle", "time": 12914.229, "timestamp": "03:35:14", "text": "ああ、"}, {"type": "subtitle", "time": 12916.55, "timestamp": "03:35:16", "text": "体験授業とかに参加して楽しかったよ、特に"}, {"type": "subtitle", "time": 12919.03, "timestamp": "03:35:19", "text": "音楽の授業はね。"}, {"type": "subtitle", "time": 12923.349, "timestamp": "03:35:23", "text": "すごく良かった。入学できたらいいのに。"}, {"type": "subtitle", "time": 12925.67, "timestamp": "03:35:25", "text": "でも、現実を突きつけられるんだよね"}, {"type": "subtitle", "time": 12929.83, "timestamp": "03:35:29", "text": "。いや、ほら、こういうスキルは"}, {"type": "subtitle", "time": 12932.55, "timestamp": "03:35:32", "text": "誰でも"}, {"type": "subtitle", "time": 12937.51, "timestamp": "03:35:37", "text": "インターネットで学べるんだよ。例えば、"}, {"type": "subtitle", "time": 12939.349, "timestamp": "03:35:39", "text": "GPスピーキングレベルは？"}, {"type": "subtitle", "time": 12942.229, "timestamp": "03:35:42", "text": "今はN3を勉強してる。入学クラスは"}, {"type": "subtitle", "time": 12946.229, "timestamp": "03:35:46", "text": "明後日の金曜日から始まる。"}, {"type": "subtitle", "time": 12949.59, "timestamp": "03:35:49", "text": "でも今はN4レベルなんだ。"}, {"type": "subtitle", "time": 12951.83, "timestamp": "03:35:51", "text": "インド人が"}, {"type": "subtitle", "time": 12954.79, "timestamp": "03:35:54", "text": "ゼロから日本で有名人になるなんて、無理だよ。"}]
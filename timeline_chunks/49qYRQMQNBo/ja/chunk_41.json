[{"type": "subtitle", "time": 2474.55, "timestamp": "00:41:14", "text": "そして、ええ、"}, {"type": "subtitle", "time": 2478.55, "timestamp": "00:41:18", "text": "最初の配信で言ったように、"}, {"type": "subtitle", "time": 2485.75, "timestamp": "00:41:25", "text": "週に 2 回だけ配信すると言ったのですが、"}, {"type": "subtitle", "time": 2488.55, "timestamp": "00:41:28", "text": "今は毎日配信しています。   まるで自分が"}, {"type": "subtitle", "time": 2490.63, "timestamp": "00:41:30", "text": "言ったことを変えたみたいだ。 これは"}, {"type": "subtitle", "time": 2493.67, "timestamp": "00:41:33", "text": "まずい。 次に"}, {"type": "subtitle", "time": 2496.069, "timestamp": "00:41:36", "text": "配信で何かを言うときは、"}, {"type": "subtitle", "time": 2498.47, "timestamp": "00:41:38", "text": "目標や約束などを守らないようにしようと思う。なぜなら、私の場合"}, {"type": "subtitle", "time": 2505.43, "timestamp": "00:41:45", "text": "、いつもあちこちで目標を変えてしまう傾向があって、それはあまり"}, {"type": "subtitle", "time": 2510.71, "timestamp": "00:41:50", "text": "良いことではないと思うからだ。"}]
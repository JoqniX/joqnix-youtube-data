[{"type": "subtitle", "time": 7260.55, "timestamp": "02:01:00", "text": "僕の周りは影響を受けていないから、僕は"}, {"type": "subtitle", "time": 7265.75, "timestamp": "02:01:05", "text": "無事だ。だから、"}, {"type": "subtitle", "time": 7268.149, "timestamp": "02:01:08", "text": "tuvingの難点は"}, {"type": "subtitle", "time": 7272.229, "timestamp": "02:01:12", "text": "アーティストが必要なことなんだ。いろいろやらなきゃいけないし、お金もたくさんかかるしね。"}, {"type": "subtitle", "time": 7277.75, "timestamp": "02:01:17", "text": "あと、ああ、そうだね"}, {"type": "subtitle", "time": 7283.99, "timestamp": "02:01:23", "text": "。もう一つ言いたいことがあるんだけど、"}, {"type": "subtitle", "time": 7287.43, "timestamp": "02:01:27", "text": "日本人はここでAIとかを使っている"}, {"type": "subtitle", "time": 7290.95, "timestamp": "02:01:30", "text": "けど、"}, {"type": "subtitle", "time": 7296.39, "timestamp": "02:01:36", "text": "アプリとかで効率化のために使っていて、"}, {"type": "subtitle", "time": 7300.149, "timestamp": "02:01:40", "text": "分析やデータ、データモニタリングなど、そういうことに使っているんだ。そういうのは"}, {"type": "subtitle", "time": 7305.189, "timestamp": "02:01:45", "text": "本当に優れていて、"}, {"type": "subtitle", "time": 7307.43, "timestamp": "02:01:47", "text": "最近では日本の"}, {"type": "subtitle", "time": 7309.589, "timestamp": "02:01:49", "text": "ストリーマーコミュニティやtuvingでも使われているんだ。"}, {"type": "subtitle", "time": 7312.07, "timestamp": "02:01:52", "text": "コミュニティでは、多くのクリエイターが"}, {"type": "subtitle", "time": 7315.75, "timestamp": "02:01:55", "text": "AIを使って"}, {"type": "subtitle", "time": 7318.87, "timestamp": "02:01:58", "text": "OBS用のストリーミングツールやプラグイン、ウィジェットなどを開発していて、"}]
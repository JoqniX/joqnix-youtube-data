[{"type": "subtitle", "time": 5344.79, "timestamp": "01:29:04", "text": "ええ、私が今ここでそれを言った理由は、今後の"}, {"type": "subtitle", "time": 5362.07, "timestamp": "01:29:22", "text": "配信ではこれについて言ったり話したりしないようにしたいからです。"}, {"type": "subtitle", "time": 5364.709, "timestamp": "01:29:24", "text": "ええ、私はおしゃべりして愚痴をこぼすタイプだと分かっています"}, {"type": "subtitle", "time": 5369.11, "timestamp": "01:29:29", "text": "。皆さんもご存知でしょう。ええと、"}, {"type": "subtitle", "time": 5371.43, "timestamp": "01:29:31", "text": "時々、"}, {"type": "subtitle", "time": 5378.149, "timestamp": "01:29:38", "text": "簡単に言うべきではないことを言ってしまうことがあります。私はとても世間知らずで、まあ、などなど。"}, {"type": "subtitle", "time": 5397.27, "timestamp": "01:29:57", "text": "正直なところ、ええと、落ち着いて過ごすことを"}, {"type": "subtitle", "time": 5399.59, "timestamp": "01:29:59", "text": "覚えているでしょうか？ええ、そうしないといけないんです"}]
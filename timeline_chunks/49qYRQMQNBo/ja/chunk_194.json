[{"type": "subtitle", "time": 11641.51, "timestamp": "03:14:01", "text": "期待していたこととか、すべてが"}, {"type": "subtitle", "time": 11643.83, "timestamp": "03:14:03", "text": "違っていたんだ。それで、騙されたような気がする。"}, {"type": "subtitle", "time": 11646.469, "timestamp": "03:14:06", "text": "いや、 罠にはめられたと言っているわけではありません"}, {"type": "subtitle", "time": 11650.389, "timestamp": "03:14:10", "text": "。どちらかというと、"}, {"type": "subtitle", "time": 11658.469, "timestamp": "03:14:18", "text": "お金は水のように消えていき、"}, {"type": "subtitle", "time": 11662.309, "timestamp": "03:14:22", "text": "アルバイトなどではあまり稼げません。"}, {"type": "subtitle", "time": 11666.309, "timestamp": "03:14:26", "text": "現実が身に染みてきています。"}, {"type": "subtitle", "time": 11672.71, "timestamp": "03:14:32", "text": "配信で言うべきかどうかわかりませんが、ここの学生や"}, {"type": "subtitle", "time": 11676.229, "timestamp": "03:14:36", "text": "先輩たちは"}, {"type": "subtitle", "time": 11679.83, "timestamp": "03:14:39", "text": "複数のアルバイトをしていて、中には現金で支払われる"}, {"type": "subtitle", "time": 11681.99, "timestamp": "03:14:41", "text": "違法なアルバイトもあります。"}, {"type": "subtitle", "time": 11685.269, "timestamp": "03:14:45", "text": "彼らは"}, {"type": "subtitle", "time": 11687.91, "timestamp": "03:14:47", "text": "現金で支払われるタイプの仕事で生活しているんです。なぜなら、"}, {"type": "subtitle", "time": 11692.469, "timestamp": "03:14:52", "text": "ここでは貯金なんて考えられないからです。仮にアルバイトで"}, {"type": "subtitle", "time": 11698.71, "timestamp": "03:14:58", "text": "月に10万ルピーか20万ルピー稼いだとしても、"}, {"type": "chat", "time": 11698.921, "timestamp": "03:14:58", "author": "@ToroVod", "avatar": "https://yt4.ggpht.com/SJVsdKS05CPy8l97LV3ie7k3gfgzahZeoOVACjLZffjopksGckYlL3zN0Xu_2rRLA9xTaTpW2oo=s64-c-k-c0x00ffffff-no-rj", "message": "hlooo"}]
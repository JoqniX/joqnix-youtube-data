[{"type": "subtitle", "time": 3422.069, "timestamp": "00:57:02", "text": "頭の中にあること、私の"}, {"type": "chat", "time": 3425.385, "timestamp": "00:57:05", "author": "@ProjectAizen", "avatar": "https://yt4.ggpht.com/J4g8YNWAMR7duRA_MC0DvcSZYNpONwi8eZHcWl3kui9q7oBp930GwOoPZ17Ct3rJcBQWDIsOKA=s64-c-k-c0x00ffffff-no-rj", "message": "You know... regardless of the time... I am always awake. Just checking in... wise tip from a person (me) who's currently in Shinagawa for an investor meet... Keep 2 seperate clocks for India & Japan"}, {"type": "subtitle", "time": 3430.23, "timestamp": "00:57:10", "text": "頭の中にあることをストリームで声に出して話すときは"}, {"type": "subtitle", "time": 3433.589, "timestamp": "00:57:13", "text": "、それは"}, {"type": "subtitle", "time": 3436.15, "timestamp": "00:57:16", "text": "日本語でなければなりません。 私は今、英語での自分の思考"}, {"type": "subtitle", "time": 3439.03, "timestamp": "00:57:19", "text": "プロセスを理解しています。"}, {"type": "subtitle", "time": 3442.39, "timestamp": "00:57:22", "text": "うん、自分の"}, {"type": "subtitle", "time": 3446.309, "timestamp": "00:57:26", "text": "考えを英語から日本語に翻訳して声に出して言う方法を学ぶべきだね"}, {"type": "subtitle", "time": 3449.03, "timestamp": "00:57:29", "text": "。"}, {"type": "subtitle", "time": 3453.75, "timestamp": "00:57:33", "text": "インド用と日本用で、それぞれ別の服を用意しておきましょう"}, {"type": "subtitle", "time": 3456.069, "timestamp": "00:57:36", "text": "。 こんにちは、"}]
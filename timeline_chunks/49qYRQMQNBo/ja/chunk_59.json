[{"type": "subtitle", "time": 3569.43, "timestamp": "00:59:29", "text": "私は読み書きができません。 話すことはできる"}, {"type": "subtitle", "time": 3571.03, "timestamp": "00:59:31", "text": "けど、"}, {"type": "subtitle", "time": 3575.27, "timestamp": "00:59:35", "text": "えーと、書くことと読むことは難しいし、"}, {"type": "subtitle", "time": 3577.75, "timestamp": "00:59:37", "text": "３年生になるともっと難しくなるだろうね"}]
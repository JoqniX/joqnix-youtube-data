[{"type": "subtitle", "time": 7741.43, "timestamp": "02:09:01", "text": "えっと、一番"}, {"type": "subtitle", "time": 7743.91, "timestamp": "02:09:03", "text": "いい方法は？今、"}, {"type": "subtitle", "time": 7746.709, "timestamp": "02:09:06", "text": "オファーがあるから、何か"}, {"type": "subtitle", "time": 7751.109, "timestamp": "02:09:11", "text": "安く買える。ここで麺を買って、"}, {"type": "subtitle", "time": 7754.709, "timestamp": "02:09:14", "text": "公園に行って食べて、"}, {"type": "subtitle", "time": 7756.39, "timestamp": "02:09:16", "text": "それから"}, {"type": "subtitle", "time": 7759.27, "timestamp": "02:09:19", "text": "ゴミをこっそり"}, {"type": "subtitle", "time": 7761.91, "timestamp": "02:09:21", "text": "セブンイレブンに持って帰る"}, {"type": "subtitle", "time": 7764.47, "timestamp": "02:09:24", "text": "。"}, {"type": "subtitle", "time": 7767.27, "timestamp": "02:09:27", "text": "うん、できると思う。うん。"}, {"type": "subtitle", "time": 7771.669, "timestamp": "02:09:31", "text": "待って、ここで買えば"}, {"type": "subtitle", "time": 7775.43, "timestamp": "02:09:35", "text": "絶対にできる。誰だっけ？ああ、ああ、"}, {"type": "subtitle", "time": 7777.109, "timestamp": "02:09:37", "text": "彼女だ。よし、よし、よし。"}, {"type": "subtitle", "time": 7780.069, "timestamp": "02:09:40", "text": "彼女から買えると思う。ああ、そうだ。うん。"}, {"type": "subtitle", "time": 7782.55, "timestamp": "02:09:42", "text": "これだ。あのオジャンじゃない。"}, {"type": "subtitle", "time": 7785.189, "timestamp": "02:09:45", "text": "オジちゃんはちょっと怖い。"}, {"type": "subtitle", "time": 7794.229, "timestamp": "02:09:54", "text": "わかりました。"}, {"type": "subtitle", "time": 7795.91, "timestamp": "02:09:55", "text": "えっと、"}]
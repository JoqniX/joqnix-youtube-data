[{"type": "subtitle", "time": 2785.03, "timestamp": "00:46:25", "text": "こんにちは、ようこそ。 日本はどうですか？ 日本は"}, {"type": "subtitle", "time": 2789.19, "timestamp": "00:46:29", "text": "楽しい国で、良い面も悪い面もある。 つまり、"}, {"type": "subtitle", "time": 2791.75, "timestamp": "00:46:31", "text": "留学生であれば、確かに"}, {"type": "subtitle", "time": 2796.63, "timestamp": "00:46:36", "text": "大変なこともありますが、"}, {"type": "subtitle", "time": 2798.95, "timestamp": "00:46:38", "text": "良いところもあります。"}, {"type": "subtitle", "time": 2801.27, "timestamp": "00:46:41", "text": "それは良いことです。"}, {"type": "subtitle", "time": 2804.71, "timestamp": "00:46:44", "text": "つまり、私はたった2ヶ月前にここに来たばかりなんです。"}, {"type": "subtitle", "time": 2807.349, "timestamp": "00:46:47", "text": "日本に到着してから2ヶ月が経ち、ようやく色々なことに慣れてきたところです"}, {"type": "subtitle", "time": 2814.95, "timestamp": "00:46:54", "text": "。"}, {"type": "subtitle", "time": 2818.55, "timestamp": "00:46:58", "text": "うん。 うん。 世界情勢はどうですか？ お元気でお過ごしでしょうか"}]
[{"type": "subtitle", "time": 7324.31, "timestamp": "02:02:04", "text": "彼らが革新的で迅速な"}, {"type": "subtitle", "time": 7326.629, "timestamp": "02:02:06", "text": "エンジニアリングを行っている様子は本当に素晴らしいです。クレイジーですよね"}, {"type": "subtitle", "time": 7328.709, "timestamp": "02:02:08", "text": "。"}, {"type": "subtitle", "time": 7332.47, "timestamp": "02:02:12", "text": "ええ。私は無理です"}, {"type": "subtitle", "time": 7335.189, "timestamp": "02:02:15", "text": "。お金がないんです。すでにモデルを持っています。"}, {"type": "subtitle", "time": 7339.27, "timestamp": "02:02:19", "text": "それらの費用を支払わなければなりません。私の倫理的な"}, {"type": "subtitle", "time": 7341.27, "timestamp": "02:02:21", "text": "状況については、"}, {"type": "subtitle", "time": 7344.149, "timestamp": "02:02:24", "text": "チャンネルで何度か言及したと思います。"}, {"type": "subtitle", "time": 7349.589, "timestamp": "02:02:29", "text": "その日の午前3時に、"}, {"type": "subtitle", "time": 7355.91, "timestamp": "02:02:35", "text": "それについて話す馬鹿げたビデオまで作りました。そして、"}, {"type": "subtitle", "time": 7363.91, "timestamp": "02:02:43", "text": "新しいモデルをデビューさせたいと思っています"}, {"type": "subtitle", "time": 7366.79, "timestamp": "02:02:46", "text": "。私は日本にいます。"}, {"type": "subtitle", "time": 7369.669, "timestamp": "02:02:49", "text": "新しいアークですよね？"}, {"type": "subtitle", "time": 7373.189, "timestamp": "02:02:53", "text": "日本語を話す"}, {"type": "subtitle", "time": 7377.43, "timestamp": "02:02:57", "text": "、日本語を第一言語とする"}, {"type": "chat", "time": 7379.658, "timestamp": "02:02:59", "author": "@chip-t9e", "avatar": "https://yt4.ggpht.com/kUzmSV9fTGltRRlDD_tgqi-V_k94_VoN8nvcWwlH6d8BXCWlBr6zHqdh8PwYTD3pJNJl3mCMeVM=s64-c-k-c0x00ffffff-no-rj", "message": "hello (I came back lol)"}]
[{"type": "subtitle", "time": 301.83, "timestamp": "00:05:01", "text": "私が昨日日本語のみの"}, {"type": "subtitle", "time": 304.469, "timestamp": "00:05:04", "text": "配信をしたことを知ってるのかな？"}, {"type": "subtitle", "time": 306.79, "timestamp": "00:05:06", "text": "そう、昨日は日本語のみの"}, {"type": "subtitle", "time": 311.029, "timestamp": "00:05:11", "text": "チャレンジで、少しだけ英語を使ったんだけど"}, {"type": "subtitle", "time": 348.95, "timestamp": "00:05:48", "text": "コラボレーションですね。"}, {"type": "subtitle", "time": 351.83, "timestamp": "00:05:51", "text": "これ。 うん、金曜日は日本語のみの"}, {"type": "subtitle", "time": 355.83, "timestamp": "00:05:55", "text": "配信をやって、土曜日は"}, {"type": "subtitle", "time": 358.87, "timestamp": "00:05:58", "text": "音楽だけの配信にするつもりだよ。 その日に何も予定がなければ、"}]
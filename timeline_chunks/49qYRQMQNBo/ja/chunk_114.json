[{"type": "subtitle", "time": 6840.47, "timestamp": "01:54:00", "text": "私たちは"}, {"type": "subtitle", "time": 6844.55, "timestamp": "01:54:04", "text": "子供の頃から学校で英語は世界"}, {"type": "subtitle", "time": 6846.629, "timestamp": "01:54:06", "text": "共通語で、どの国でも"}, {"type": "subtitle", "time": 6848.709, "timestamp": "01:54:08", "text": "みんな英語を使っている、"}, {"type": "subtitle", "time": 6850.39, "timestamp": "01:54:10", "text": "英語は重要だと教えられてきた。小学校1年生、2年生、中学校、高校"}, {"type": "subtitle", "time": 6859.03, "timestamp": "01:54:19", "text": "などでそう教えられた。"}, {"type": "subtitle", "time": 6861.91, "timestamp": "01:54:21", "text": "でも、ここに来てみたら、みんなが"}, {"type": "subtitle", "time": 6863.99, "timestamp": "01:54:23", "text": "英語を知っているわけじゃない"}, {"type": "subtitle", "time": 6865.91, "timestamp": "01:54:25", "text": "。中国からの学生は英語を知らない。"}, {"type": "subtitle", "time": 6867.35, "timestamp": "01:54:27", "text": "スリランカからの学生は英語を知らない"}, {"type": "subtitle", "time": 6869.109, "timestamp": "01:54:29", "text": "。モンゴルからの学生は"}, {"type": "subtitle", "time": 6871.35, "timestamp": "01:54:31", "text": "英語を知らない。ミャンマー、"}, {"type": "subtitle", "time": 6876.87, "timestamp": "01:54:36", "text": "ネパール、"}, {"type": "subtitle", "time": 6880.55, "timestamp": "01:54:40", "text": "バングラデシュ、パキスタンからの学生も英語をよく知らない。"}, {"type": "subtitle", "time": 6887.35, "timestamp": "01:54:47", "text": "だから、彼らは生き残るために基本的な英語をかろうじて知っているだけで、"}, {"type": "subtitle", "time": 6891.99, "timestamp": "01:54:51", "text": "エゴや"}, {"type": "subtitle", "time": 6895.35, "timestamp": "01:54:55", "text": "彼らはどういうわけか日本語を話せるんです"}, {"type": "subtitle", "time": 6897.83, "timestamp": "01:54:57", "text": "。だから、おそらく"}, {"type": "subtitle", "time": 6899.669, "timestamp": "01:54:59", "text": "自国でコースに通っていて、"}]
[{"type": "subtitle", "time": 12303.51, "timestamp": "03:25:03", "text": "インドにいた頃、父が家で食べられるように"}, {"type": "subtitle", "time": 12305.51, "timestamp": "03:25:05", "text": "これを買ってきてくれたんです"}, {"type": "subtitle", "time": 12308.07, "timestamp": "03:25:08", "text": "。ええ。父は"}, {"type": "subtitle", "time": 12311.59, "timestamp": "03:25:11", "text": "家でカップか"}, {"type": "subtitle", "time": 12314.469, "timestamp": "03:25:14", "text": "段ボールか何かで食べていました。それで、父は"}, {"type": "subtitle", "time": 12317.349, "timestamp": "03:25:17", "text": "パックか何かで買ってきていました。私も"}, {"type": "subtitle", "time": 12320.469, "timestamp": "03:25:20", "text": "3つくらい食べたと思います。 それらを。それから"}, {"type": "subtitle", "time": 12322.229, "timestamp": "03:25:22", "text": "4つ目が欲しくなった。4つ目を"}, {"type": "subtitle", "time": 12324.95, "timestamp": "03:25:24", "text": "うっかり開けてしまって、「"}, {"type": "subtitle", "time": 12327.67, "timestamp": "03:25:27", "text": "あぁ、"}, {"type": "subtitle", "time": 12330.389, "timestamp": "03:25:30", "text": "もう食べたくない」って思った。"}, {"type": "subtitle", "time": 12333.349, "timestamp": "03:25:33", "text": "それで口に詰め込まなきゃいけなかった。それから「あぁ、もう"}, {"type": "subtitle", "time": 12336.15, "timestamp": "03:25:36", "text": "食べたくない」って思った"}, {"type": "subtitle", "time": 12338.309, "timestamp": "03:25:38", "text": "。"}, {"type": "subtitle", "time": 12349.59, "timestamp": "03:25:49", "text": "何か"}, {"type": "subtitle", "time": 12351.349, "timestamp": "03:25:51", "text": "費用とか奨学金とかで一人で行ったの？"}, {"type": "subtitle", "time": 12353.03, "timestamp": "03:25:53", "text": "いや、奨学金じゃない。最高額の奨学金"}, {"type": "subtitle", "time": 12356.55, "timestamp": "03:25:56", "text": "。それじゃない。それじゃない。"}]
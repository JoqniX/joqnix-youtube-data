[{"type": "subtitle", "time": 10800.95, "timestamp": "03:00:00", "text": "あなたには心の余裕がある。 あなたは"}, {"type": "subtitle", "time": 10802.87, "timestamp": "03:00:02", "text": "心の平安を得ている。 どこもかしこも山だらけだ"}, {"type": "subtitle", "time": 10806.63, "timestamp": "03:00:06", "text": "。"}, {"type": "subtitle", "time": 10809.429, "timestamp": "03:00:09", "text": "自然は至る所にあります。 一方、"}, {"type": "subtitle", "time": 10815.349, "timestamp": "03:00:15", "text": "東京は、"}, {"type": "subtitle", "time": 10818.23, "timestamp": "03:00:18", "text": "建物が密集しすぎていて、一つの建物全体が"}, {"type": "subtitle", "time": 10821.83, "timestamp": "03:00:21", "text": "密集しているような感じです。 セブンイレブンやファミリーマートなどは、小さな"}, {"type": "subtitle", "time": 10829.99, "timestamp": "03:00:29", "text": "個室のような場所だ。 一方、ここは"}, {"type": "subtitle", "time": 10832.07, "timestamp": "03:00:32", "text": "大きな、"}, {"type": "subtitle", "time": 10835.19, "timestamp": "03:00:35", "text": "そう、サッカー場全体みたいな広さなのに、"}, {"type": "subtitle", "time": 10837.91, "timestamp": "03:00:37", "text": "店が1軒だけ建っているんです。 そういうわけで、"}, {"type": "subtitle", "time": 10840.469, "timestamp": "03:00:40", "text": "セブンイレブンとファミリーマラは"}, {"type": "subtitle", "time": 10841.99, "timestamp": "03:00:41", "text": "ここにあるんです。"}, {"type": "subtitle", "time": 10843.91, "timestamp": "03:00:43", "text": "すごく広々としている。"}, {"type": "subtitle", "time": 10852.55, "timestamp": "03:00:52", "text": "そして東京に行くと、"}, {"type": "subtitle", "time": 10855.99, "timestamp": "03:00:55", "text": "心の平穏が全く感じられない。 まるで、たくさんの"}]
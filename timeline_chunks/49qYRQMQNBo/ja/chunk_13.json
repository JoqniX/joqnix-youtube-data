[{"type": "subtitle", "time": 782.23, "timestamp": "00:13:02", "text": "チャネルチャネルがあります。 それで、えっと"}, {"type": "subtitle", "time": 785.99, "timestamp": "00:13:05", "text": "、どちらを使えばいいんだろう？ とても"}, {"type": "subtitle", "time": 788.79, "timestamp": "00:13:08", "text": "紛らわしい。"}, {"type": "subtitle", "time": 791.91, "timestamp": "00:13:11", "text": "うーん、ゴロゴロ。 うん。 うん。 なぜなら、ビーム"}, {"type": "subtitle", "time": 796.389, "timestamp": "00:13:16", "text": "ストリームはエマを午後"}, {"type": "subtitle", "time": 800.71, "timestamp": "00:13:20", "text": "8時に作ったからです。 はい。 ランブル"}, {"type": "subtitle", "time": 826.15, "timestamp": "00:13:46", "text": "8。はい。 今、私は日本にいます。 午後"}]
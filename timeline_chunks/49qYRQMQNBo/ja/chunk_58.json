[{"type": "subtitle", "time": 3484.87, "timestamp": "00:58:04", "text": "私は時計を2つ持っています。 うん。 うん。 うん。   えっと、"}, {"type": "subtitle", "time": 3489.75, "timestamp": "00:58:09", "text": "私のスマホでの話です。 こんにちは。   だから、"}, {"type": "chat", "time": 3496.426, "timestamp": "00:58:16", "author": "@ProjectAizen", "avatar": "https://yt4.ggpht.com/J4g8YNWAMR7duRA_MC0DvcSZYNpONwi8eZHcWl3kui9q7oBp930GwOoPZ17Ct3rJcBQWDIsOKA=s64-c-k-c0x00ffffff-no-rj", "message": "I have to go to Taito next"}, {"type": "subtitle", "time": 3498.47, "timestamp": "00:58:18", "text": "言いたいことはあるんだけど、問題は、"}, {"type": "subtitle", "time": 3500.23, "timestamp": "00:58:20", "text": "これらのことの中には"}, {"type": "chat", "time": 3501.399, "timestamp": "00:58:21", "author": "@ProjectAizen", "avatar": "https://yt4.ggpht.com/J4g8YNWAMR7duRA_MC0DvcSZYNpONwi8eZHcWl3kui9q7oBp930GwOoPZ17Ct3rJcBQWDIsOKA=s64-c-k-c0x00ffffff-no-rj", "message": "Then back to Mumbai it is"}, {"type": "subtitle", "time": 3502.95, "timestamp": "00:58:22", "text": "個人的でプライベートなことがあるってことなんだ。"}, {"type": "subtitle", "time": 3505.589, "timestamp": "00:58:25", "text": "ストリームで販売を始めるべきではない、それが私が"}, {"type": "subtitle", "time": 3509.349, "timestamp": "00:58:29", "text": "気づいたことだ、私のことはノーだ、そして"}, {"type": "subtitle", "time": 3511.109, "timestamp": "00:58:31", "text": "次にティトに行かなければならない、そして"}, {"type": "subtitle", "time": 3515.19, "timestamp": "00:58:35", "text": "私のハイカチャに戻る、ドギーという用語は手"}, {"type": "subtitle", "time": 3517.19, "timestamp": "00:58:37", "text": "と膝をつくことを意味することを覚えておいてください、もし"}, {"type": "subtitle", "time": 3518.789, "timestamp": "00:58:38", "text": "それを見たら、また、漢字の"}, {"type": "subtitle", "time": 3530.309, "timestamp": "00:58:50", "text": "私は今でも漢字ができません、レベルオーケー"}, {"type": "subtitle", "time": 3533.43, "timestamp": "00:58:53", "text": "レベル。 苦戦しています。 全てを忘れてしまった"}, {"type": "subtitle", "time": 3536.63, "timestamp": "00:58:56", "text": "。 そしてN3の授業が始まります。"}]
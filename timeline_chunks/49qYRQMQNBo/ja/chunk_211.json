[{"type": "subtitle", "time": 12660.15, "timestamp": "03:31:00", "text": "6月だし、"}, {"type": "subtitle", "time": 12664.95, "timestamp": "03:31:04", "text": "試験はもう始まってるはずなのに。"}, {"type": "subtitle", "time": 12667.03, "timestamp": "03:31:07", "text": "12月にやろうと思う。"}, {"type": "subtitle", "time": 12669.19, "timestamp": "03:31:09", "text": "メールを送るだけ。"}, {"type": "subtitle", "time": 12672.229, "timestamp": "03:31:12", "text": "でも時間がないんだ。時間がない。"}, {"type": "subtitle", "time": 12674.79, "timestamp": "03:31:14", "text": "日本語の勉強で忙しいし"}, {"type": "subtitle", "time": 12676.95, "timestamp": "03:31:16", "text": "、配信もできないし"}, {"type": "subtitle", "time": 12681.03, "timestamp": "03:31:21", "text": "。配信もできないんだよ"}, {"type": "subtitle", "time": 12698.71, "timestamp": "03:31:38", "text": "よし、ルームメイトが家に帰ってこいって言ってる"}, {"type": "subtitle", "time": 12700.87, "timestamp": "03:31:40", "text": "。"}, {"type": "subtitle", "time": 12703.59, "timestamp": "03:31:43", "text": "兄弟、2時間も待たせたじゃないか。えっと、"}, {"type": "subtitle", "time": 12705.91, "timestamp": "03:31:45", "text": "何時間待たせたんだっけ？待たせたと思う"}]
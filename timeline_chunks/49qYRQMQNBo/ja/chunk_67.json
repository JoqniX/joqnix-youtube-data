[{"type": "subtitle", "time": 4030.15, "timestamp": "01:07:10", "text": "夢の国への入り口みたいなもの。"}, {"type": "subtitle", "time": 4031.91, "timestamp": "01:07:11", "text": "彼らは現実から目を背けているようなものですよね"}, {"type": "subtitle", "time": 4035.51, "timestamp": "01:07:15", "text": "？"}, {"type": "subtitle", "time": 4042.309, "timestamp": "01:07:22", "text": "正直に言うと、"}, {"type": "subtitle", "time": 4045.349, "timestamp": "01:07:25", "text": "私の場合、まさにそういう気持ちなんです"}, {"type": "subtitle", "time": 4050.39, "timestamp": "01:07:30", "text": "。"}, {"type": "subtitle", "time": 4053.349, "timestamp": "01:07:33", "text": "恥ずかしい思いをしながらも、私は「ああ、自分のことは"}, {"type": "subtitle", "time": 4056.39, "timestamp": "01:07:36", "text": "自分が一番よく分かっている。"}, {"type": "subtitle", "time": 4061.51, "timestamp": "01:07:41", "text": "何かについてしゃべり始めると、そのしゃべりは"}, {"type": "subtitle", "time": 4065.109, "timestamp": "01:07:45", "text": "良いことから悲しいこと、そして"}, {"type": "subtitle", "time": 4068.71, "timestamp": "01:07:48", "text": "時間が経つにつれて何かの出来事へと変わっていく。"}, {"type": "subtitle", "time": 4071.67, "timestamp": "01:07:51", "text": "それは良くない」と思っていました。でも"}]
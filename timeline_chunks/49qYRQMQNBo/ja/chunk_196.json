[{"type": "subtitle", "time": 11761.269, "timestamp": "03:16:01", "text": "7か月目、"}, {"type": "subtitle", "time": 11764.55, "timestamp": "03:16:04", "text": "8か月目、9か月目、つまり来月も支払わなければならないことに気づいた。"}, {"type": "subtitle", "time": 11769.99, "timestamp": "03:16:09", "text": "日本の前払いって何なの？信じられない。"}, {"type": "subtitle", "time": 11777.83, "timestamp": "03:16:17", "text": "過去3"}, {"type": "subtitle", "time": 11780.469, "timestamp": "03:16:20", "text": "年間、私も同じ経験をしてきました。"}, {"type": "subtitle", "time": 11783.11, "timestamp": "03:16:23", "text": "ええ。つまり、今、私も直面している問題です。あなたは"}, {"type": "subtitle", "time": 11789.75, "timestamp": "03:16:29", "text": "3年間経験していて、私は3年以上経験していて、"}, {"type": "subtitle", "time": 11792.229, "timestamp": "03:16:32", "text": "ここでたった"}, {"type": "subtitle", "time": 11796.55, "timestamp": "03:16:36", "text": "2か月経験しています。"}, {"type": "subtitle", "time": 11799.19, "timestamp": "03:16:39", "text": "ええ。ええと、1"}, {"type": "subtitle", "time": 11802.469, "timestamp": "03:16:42", "text": "リットルの牛乳。まだ牛乳を買っていません。"}, {"type": "subtitle", "time": 11804.79, "timestamp": "03:16:44", "text": "牛乳を買ったのですが、"}]
[{"type": "subtitle", "time": 3182.71, "timestamp": "00:53:02", "text": "とか勉強とか、ノート"}, {"type": "subtitle", "time": 3185.349, "timestamp": "00:53:05", "text": "パソコンで音楽制作とか作業をする時間なんです"}, {"type": "subtitle", "time": 3189.75, "timestamp": "00:53:09", "text": "。 私は、"}, {"type": "subtitle", "time": 3192.39, "timestamp": "00:53:12", "text": "プレイしたくないゲームを完全にアンインストールしました。"}, {"type": "subtitle", "time": 3197.19, "timestamp": "00:53:17", "text": "スケジュールに従おうと努力してきました。"}, {"type": "subtitle", "time": 3201.91, "timestamp": "00:53:21", "text": "ええ、それがまさに最近の私です。そして、"}, {"type": "subtitle", "time": 3207.51, "timestamp": "00:53:27", "text": "その時間帯、つまり"}, {"type": "subtitle", "time": 3211.109, "timestamp": "00:53:31", "text": "6時間か7時間くらい、"}, {"type": "subtitle", "time": 3216.549, "timestamp": "00:53:36", "text": "家に帰ってきてから7時間か8時間くらいあるので、"}, {"type": "subtitle", "time": 3218.309, "timestamp": "00:53:38", "text": "こういうストリームや"}, {"type": "subtitle", "time": 3230.47, "timestamp": "00:53:50", "text": "でも、旅行などは"}, {"type": "subtitle", "time": 3233.829, "timestamp": "00:53:53", "text": "不可能に感じます。 土曜日"}]
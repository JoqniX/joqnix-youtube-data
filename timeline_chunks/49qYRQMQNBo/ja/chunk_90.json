[{"type": "subtitle", "time": 5403.189, "timestamp": "01:30:03", "text": "。"}, {"type": "subtitle", "time": 5405.75, "timestamp": "01:30:05", "text": "例えば、今日は宿題を書いて、"}, {"type": "subtitle", "time": 5413.11, "timestamp": "01:30:13", "text": "寝る前に先生に写真を送って、"}, {"type": "subtitle", "time": 5420.79, "timestamp": "01:30:20", "text": "カップ麺を作って一人で食べるんです。"}, {"type": "subtitle", "time": 5424.07, "timestamp": "01:30:24", "text": "ルームメイトはクラスメイトの友達と"}, {"type": "subtitle", "time": 5429.669, "timestamp": "01:30:29", "text": "夕食に出かけたりしています。だから、私たちは以前は"}, {"type": "chat", "time": 5431.722, "timestamp": "01:30:31", "author": "@ObnoxiousAgnostic", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kVrH3KET_eX7LDEi_ka-c3eoI3J-Vcy4GX19VQNPnWwZQ=s64-c-k-c0x00ffffff-no-rj", "message": "Jai Jinendra"}, {"type": "subtitle", "time": 5432.31, "timestamp": "01:30:32", "text": "一緒に行っていました。わかりました。もしかしたら、"}, {"type": "subtitle", "time": 5435.11, "timestamp": "01:30:35", "text": "寂しさを感じ始めているのかもしれません。わかりません"}, {"type": "subtitle", "time": 5438.47, "timestamp": "01:30:38", "text": "。私たちは以前は 一緒に食事に行ったり。"}, {"type": "subtitle", "time": 5440.95, "timestamp": "01:30:40", "text": "私たちはよく一緒に遊んだりしていました。"}, {"type": "subtitle", "time": 5445.59, "timestamp": "01:30:45", "text": "そして"}, {"type": "subtitle", "time": 5448.149, "timestamp": "01:30:48", "text": "今、彼がここにいないと、私は"}, {"type": "subtitle", "time": 5451.59, "timestamp": "01:30:51", "text": "その空虚さを感じ始めました。"}, {"type": "subtitle", "time": 5454.55, "timestamp": "01:30:54", "text": "そして私はそれを配信で発散しています。"}, {"type": "subtitle", "time": 5457.91, "timestamp": "01:30:57", "text": "それは良くないことです。私はこれが好きではありません。私が"}]
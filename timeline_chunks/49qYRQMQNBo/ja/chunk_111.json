[{"type": "subtitle", "time": 6660.629, "timestamp": "01:51:00", "text": "ええ。今のところ、人種"}, {"type": "subtitle", "time": 6663.189, "timestamp": "01:51:03", "text": "差別やそれに類するものに遭遇したことはありません。でも、"}, {"type": "subtitle", "time": 6667.99, "timestamp": "01:51:07", "text": "学校にはもっと人種"}, {"type": "subtitle", "time": 6671.189, "timestamp": "01:51:11", "text": "差別や人種差別的な偏見があるような気がします。なぜなら、"}, {"type": "subtitle", "time": 6672.55, "timestamp": "01:51:12", "text": "様々な国からの言語交換留学生がいるからです。"}, {"type": "subtitle", "time": 6676.629, "timestamp": "01:51:16", "text": "ええ、実際に遭遇しました。"}, {"type": "subtitle", "time": 6682.39, "timestamp": "01:51:22", "text": "モンゴル出身のクラスメートに「J、"}, {"type": "subtitle", "time": 6684.47, "timestamp": "01:51:24", "text": "詐欺師なの？」と聞かれました。"}, {"type": "subtitle", "time": 6687.51, "timestamp": "01:51:27", "text": "それで、「インド人は軽蔑されているのは知っています。"}, {"type": "subtitle", "time": 6692.95, "timestamp": "01:51:32", "text": "オンラインの詐欺の件で、北"}, {"type": "subtitle", "time": 6696.709, "timestamp": "01:51:36", "text": "インド人が他の地域の"}, {"type": "subtitle", "time": 6699.43, "timestamp": "01:51:39", "text": "インド人、つまり"}, {"type": "subtitle", "time": 6704.87, "timestamp": "01:51:44", "text": "インド各地のインド人にとって状況をさらに悪化させているんです。難しいですよね。"}, {"type": "subtitle", "time": 6708.31, "timestamp": "01:51:48", "text": "ステレオタイプな"}, {"type": "subtitle", "time": 6715.189, "timestamp": "01:51:55", "text": "、何て言うんでしょう"}, {"type": "subtitle", "time": 6718.39, "timestamp": "01:51:58", "text": "？ステレオタイプな判断を受けるんです"}]
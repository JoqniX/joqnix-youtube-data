[{"type": "subtitle", "time": 5641.03, "timestamp": "01:34:01", "text": "例えば、僕が作ったら彼は"}, {"type": "subtitle", "time": 5645.189, "timestamp": "01:34:05", "text": "「もし君がビリヤニとか"}, {"type": "subtitle", "time": 5647.189, "timestamp": "01:34:07", "text": "焼き物とかを作ったら、僕は"}, {"type": "subtitle", "time": 5649.669, "timestamp": "01:34:09", "text": "驚くよ」って言ったんだ。  「これは何でもないよ。」うん。"}, {"type": "subtitle", "time": 5652.07, "timestamp": "01:34:12", "text": "卵は使わないでください。教えてください"}, {"type": "subtitle", "time": 5655.91, "timestamp": "01:34:15", "text": "。"}, {"type": "subtitle", "time": 5659.35, "timestamp": "01:34:19", "text": "今日はこれとカレーを作る予定だったのに、使いたかった"}, {"type": "subtitle", "time": 5662.149, "timestamp": "01:34:22", "text": "卵をあなたが使ってしまったんです"}, {"type": "subtitle", "time": 5663.75, "timestamp": "01:34:23", "text": "。だから、ちょっと"}, {"type": "subtitle", "time": 5667.83, "timestamp": "01:34:27", "text": "痛いです"}, {"type": "subtitle", "time": 5672.229, "timestamp": "01:34:32", "text": "。でも、"}, {"type": "subtitle", "time": 5675.35, "timestamp": "01:34:35", "text": "キノコ料理でこんにちは。"}, {"type": "subtitle", "time": 5680.629, "timestamp": "01:34:40", "text": "できるかどうかわかりませんが、やってみましょう。"}, {"type": "subtitle", "time": 5687.51, "timestamp": "01:34:47", "text": "2年後には私たちは"}, {"type": "subtitle", "time": 5689.99, "timestamp": "01:34:49", "text": "別々の道を歩むことになるでしょう？私が"}, {"type": "subtitle", "time": 5694.47, "timestamp": "01:34:54", "text": "日本でどこに行き着くかは神のみぞ知るし、"}, {"type": "subtitle", "time": 5696.95, "timestamp": "01:34:56", "text": "ルームメイトも"}]
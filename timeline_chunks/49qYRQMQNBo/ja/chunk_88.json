[{"type": "subtitle", "time": 5289.99, "timestamp": "01:28:09", "text": "よし、また公園に来た。"}, {"type": "subtitle", "time": 5292.47, "timestamp": "01:28:12", "text": "座って話そう。うん、"}, {"type": "subtitle", "time": 5294.31, "timestamp": "01:28:14", "text": "入れ替わるはずだったのに、そう、"}, {"type": "subtitle", "time": 5300.87, "timestamp": "01:28:20", "text": "私みたいな不安症の人は、"}, {"type": "subtitle", "time": 5303.03, "timestamp": "01:28:23", "text": "物事を心配しすぎるから、"}, {"type": "subtitle", "time": 5307.51, "timestamp": "01:28:27", "text": "そういう人が必要なの。"}, {"type": "subtitle", "time": 5313.91, "timestamp": "01:28:33", "text": "友情とかそういうのは"}, {"type": "subtitle", "time": 5318.47, "timestamp": "01:28:38", "text": "いいことで、成長につながるし、"}, {"type": "subtitle", "time": 5322.31, "timestamp": "01:28:42", "text": "人格の成長とか、向上につながる。"}, {"type": "subtitle", "time": 5327.03, "timestamp": "01:28:47", "text": "考えてみると、"}, {"type": "subtitle", "time": 5333.669, "timestamp": "01:28:53", "text": "ええ、"}, {"type": "subtitle", "time": 5335.43, "timestamp": "01:28:55", "text": "今のところ、少し"}]
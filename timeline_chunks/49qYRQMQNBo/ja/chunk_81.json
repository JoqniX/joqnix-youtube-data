[{"type": "subtitle", "time": 4863.91, "timestamp": "01:21:03", "text": "うん。うん。"}, {"type": "subtitle", "time": 4870.39, "timestamp": "01:21:10", "text": "この感情を今になってようやく理解し始めたんだ。だって、"}, {"type": "subtitle", "time": 4877.35, "timestamp": "01:21:17", "text": "学校の用事で東京に行った時、"}, {"type": "subtitle", "time": 4881.91, "timestamp": "01:21:21", "text": "ルームメイトがこういう状況に直面していたように感じたし、今まさに自分も"}, {"type": "subtitle", "time": 4884.709, "timestamp": "01:21:24", "text": "同じ状況に直面している。一人ぼっちだと"}, {"type": "subtitle", "time": 4888.87, "timestamp": "01:21:28", "text": "孤独感とかを感じるよね。"}, {"type": "subtitle", "time": 4894.55, "timestamp": "01:21:34", "text": "うん。そして一番"}, {"type": "subtitle", "time": 4897.75, "timestamp": "01:21:37", "text": "大切なことは、他人に頼りすぎることはできないってこと"}, {"type": "subtitle", "time": 4900.149, "timestamp": "01:21:40", "text": "。"}, {"type": "subtitle", "time": 4903.91, "timestamp": "01:21:43", "text": "みんな自分のこと"}, {"type": "subtitle", "time": 4905.51, "timestamp": "01:21:45", "text": "しか考えていないし、自分の"}, {"type": "subtitle", "time": 4909.27, "timestamp": "01:21:49", "text": "ことしか考えていない。そうだよね。それに、"}, {"type": "subtitle", "time": 4912.87, "timestamp": "01:21:52", "text": "助けてくれる人は誰もいない。いるよ。"}, {"type": "subtitle", "time": 4914.87, "timestamp": "01:21:54", "text": "うん。助けてくれる人がいたとしても、結局は"}]
[{"type": "subtitle", "time": 11345.349, "timestamp": "03:09:05", "text": "リサーチをして、"}, {"type": "subtitle", "time": 11351.83, "timestamp": "03:09:11", "text": "たくさんの学校に行って、たくさんの"}, {"type": "subtitle", "time": 11353.83, "timestamp": "03:09:13", "text": "キャンパスを見学して、"}, {"type": "subtitle", "time": 11360.389, "timestamp": "03:09:20", "text": "卒業後に何をしたいかもう決めているなんて、素晴らしいね。"}, {"type": "subtitle", "time": 11361.75, "timestamp": "03:09:21", "text": "他の学生も君を見習うべきだ」って言ってくれた。"}, {"type": "subtitle", "time": 11369.11, "timestamp": "03:09:29", "text": "中国出身のサポートティーチャーとカジャスタン出身のティーチャー、それに担任の先生もそう言ってくれた。まあ、それは"}, {"type": "subtitle", "time": 11377.83, "timestamp": "03:09:37", "text": "いいことだけど、"}, {"type": "subtitle", "time": 11382.63, "timestamp": "03:09:42", "text": "日本に来たばかりの1年生はひらがなと"}, {"type": "subtitle", "time": 11385.429, "timestamp": "03:09:45", "text": "カタカナを習って"}, {"type": "subtitle", "time": 11389.51, "timestamp": "03:09:49", "text": "授業を楽しんでいるのに、私はもう"}, {"type": "subtitle", "time": 11392.87, "timestamp": "03:09:52", "text": "将来のことを考えて、"}, {"type": "subtitle", "time": 11397.269, "timestamp": "03:09:57", "text": "違う道も考えている。もうやり"}]
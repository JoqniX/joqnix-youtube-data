[{"type": "subtitle", "time": 1320.87, "timestamp": "00:22:00", "text": "インド出身で、私と同じアカデミー出身なんです。"}, {"type": "subtitle", "time": 1328.39, "timestamp": "00:22:08", "text": "それが私と同じアカデミーだったのか、それとも、"}, {"type": "subtitle", "time": 1332.07, "timestamp": "00:22:12", "text": "私が法的に盲目なのか、どこにも見当たらないんです"}, {"type": "subtitle", "time": 1355.75, "timestamp": "00:22:35", "text": "。 ここにはない。ここには"}, {"type": "subtitle", "time": 1357.75, "timestamp": "00:22:37", "text": "ない。"}, {"type": "subtitle", "time": 1364.87, "timestamp": "00:22:44", "text": "大丈夫。 ストリーミング中は音楽を聴きません"}, {"type": "subtitle", "time": 1366.47, "timestamp": "00:22:46", "text": "。"}, {"type": "subtitle", "time": 1368.31, "timestamp": "00:22:48", "text": "いや、本当に"}]
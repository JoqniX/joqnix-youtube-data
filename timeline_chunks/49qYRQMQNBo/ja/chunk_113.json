[{"type": "subtitle", "time": 6784.629, "timestamp": "01:53:04", "text": "Discordでも彼を追加したら、彼はそういうリールを何度も"}, {"type": "subtitle", "time": 6787.669, "timestamp": "01:53:07", "text": "送ってきた。「"}, {"type": "subtitle", "time": 6796.47, "timestamp": "01:53:16", "text": "君たちは一体何人種なの？僕たちがインド"}, {"type": "subtitle", "time": 6798.07, "timestamp": "01:53:18", "text": "出身だからって」って思ったよ。"}, {"type": "subtitle", "time": 6801.669, "timestamp": "01:53:21", "text": "国によって違う。"}, {"type": "subtitle", "time": 6805.43, "timestamp": "01:53:25", "text": "モンゴル人の人種差別的な発言に反論したかったんだ"}, {"type": "subtitle", "time": 6808.31, "timestamp": "01:53:28", "text": "けど、やめた方がいい。そういう"}, {"type": "subtitle", "time": 6811.51, "timestamp": "01:53:31", "text": "タイプじゃないし。でも実際、やろうかと思ったんだ"}, {"type": "subtitle", "time": 6821.91, "timestamp": "01:53:41", "text": "中国からの学生は"}, {"type": "subtitle", "time": 6824.709, "timestamp": "01:53:44", "text": "親切だった。インドについてたくさん質問してきたし"}, {"type": "subtitle", "time": 6827.35, "timestamp": "01:53:47", "text": "、"}, {"type": "subtitle", "time": 6830.31, "timestamp": "01:53:50", "text": "インドについて話したりもした。"}, {"type": "subtitle", "time": 6832.55, "timestamp": "01:53:52", "text": "ほとんどの人は"}, {"type": "subtitle", "time": 6834.709, "timestamp": "01:53:54", "text": "違う国から来ている。実際のところ、"}]
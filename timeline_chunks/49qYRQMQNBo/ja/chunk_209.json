[{"type": "subtitle", "time": 12540.79, "timestamp": "03:29:00", "text": "かKickで配信を見てください"}, {"type": "subtitle", "time": 12545.51, "timestamp": "03:29:05", "text": "。広告はありません。ええと、"}, {"type": "subtitle", "time": 12548.15, "timestamp": "03:29:08", "text": "SUAカード、つまり空白のSUAカードを作ることができます。1,000"}, {"type": "subtitle", "time": 12550.95, "timestamp": "03:29:10", "text": "円入れるだけで、"}, {"type": "subtitle", "time": 12554.87, "timestamp": "03:29:14", "text": "何ですか？500円使って"}, {"type": "subtitle", "time": 12558.389, "timestamp": "03:29:18", "text": "、残高は400円か"}, {"type": "subtitle", "time": 12560.229, "timestamp": "03:29:20", "text": "何かになります。レートがいくらだったか忘れたと思います"}, {"type": "subtitle", "time": 12563.349, "timestamp": "03:29:23", "text": "。"}, {"type": "subtitle", "time": 12566.309, "timestamp": "03:29:26", "text": "そして、"}, {"type": "subtitle", "time": 12569.03, "timestamp": "03:29:29", "text": "今は何度もチャージする必要があります。東京に行くたびに"}, {"type": "subtitle", "time": 12572.469, "timestamp": "03:29:32", "text": "、"}, {"type": "subtitle", "time": 12581.59, "timestamp": "03:29:41", "text": "円です。つまり、"}, {"type": "subtitle", "time": 12584.95, "timestamp": "03:29:44", "text": "往復で"}, {"type": "subtitle", "time": 12593.59, "timestamp": "03:29:53", "text": "帰りも同じくらいです"}, {"type": "subtitle", "time": 12597.19, "timestamp": "03:29:57", "text": "。"}]
[{"type": "subtitle", "time": 4085.99, "timestamp": "01:08:05", "text": "正直なところ、"}, {"type": "subtitle", "time": 4108.63, "timestamp": "01:08:28", "text": "学生として日本に来た人々の苦労や現実について話したいと思っています。"}, {"type": "subtitle", "time": 4110.709, "timestamp": "01:08:30", "text": "そのためには動画形式が最適だと思います。誰も"}, {"type": "subtitle", "time": 4112.47, "timestamp": "01:08:32", "text": "2"}, {"type": "subtitle", "time": 4115.59, "timestamp": "01:08:35", "text": "時間も1時間も配信を最後まで見て、"}, {"type": "subtitle", "time": 4120.789, "timestamp": "01:08:40", "text": "これらの話題を理解しようとはしないでしょう。でも"}, {"type": "subtitle", "time": 4126.95, "timestamp": "01:08:46", "text": "正直なところ、"}, {"type": "subtitle", "time": 4133.749, "timestamp": "01:08:53", "text": "後で動画をいくつか投稿しようと思っています。今は時期尚早です。"}]
[{"type": "subtitle", "time": 7381.03, "timestamp": "02:03:01", "text": "ストリーマー、英語を第二言語とするバイリンガルに完全に移行したときにのみ、それが可能になります。"}, {"type": "subtitle", "time": 7383.43, "timestamp": "02:03:03", "text": "そのためには、"}, {"type": "subtitle", "time": 7385.51, "timestamp": "02:03:05", "text": "多くの日本人ストリーマーと話したり、友達になったり、"}, {"type": "subtitle", "time": 7388.229, "timestamp": "02:03:08", "text": "彼らとクンダンをしたり、"}, {"type": "subtitle", "time": 7395.75, "timestamp": "02:03:15", "text": "完全に日本語でコンダンを行う方法のパターンや手順などを理解したりする必要があります。ええ、本当にたくさんの"}, {"type": "subtitle", "time": 7403.109, "timestamp": "02:03:23", "text": "ことが必要です。 そんな感じです。"}, {"type": "subtitle", "time": 7409.189, "timestamp": "02:03:29", "text": "いつか日本のストリーマーともっとコラボしたいと思っています。"}, {"type": "subtitle", "time": 7412.229, "timestamp": "02:03:32", "text": "今の語彙力や会話"}, {"type": "subtitle", "time": 7415.109, "timestamp": "02:03:35", "text": "力では足りない気がします。"}, {"type": "subtitle", "time": 7425.189, "timestamp": "02:03:45", "text": "ネイティブの日本人ではなく、基本的な"}, {"type": "subtitle", "time": 7429.99, "timestamp": "02:03:49", "text": "日本語を使う外国人である私と気兼ねなく話せる人を見つける必要があります。だから難しいんです。"}, {"type": "subtitle", "time": 7436.87, "timestamp": "02:03:56", "text": "ああ、頑張ってください。頑張ってください。頑張ってください。頑張ってください。"}]
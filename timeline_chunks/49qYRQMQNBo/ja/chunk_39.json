[{"type": "subtitle", "time": 2342.39, "timestamp": "00:39:02", "text": "正直言って、これは"}, {"type": "subtitle", "time": 2345.03, "timestamp": "00:39:05", "text": "屋外の小川で、私が"}, {"type": "subtitle", "time": 2349.27, "timestamp": "00:39:09", "text": "歩きながら屋外の"}, {"type": "subtitle", "time": 2353.51, "timestamp": "00:39:13", "text": "音を聞かせたり、私が話したりしているような感じがします。"}, {"type": "subtitle", "time": 2357.109, "timestamp": "00:39:17", "text": "午後 8 時 30 分頃です。   えーと、"}, {"type": "subtitle", "time": 2359.91, "timestamp": "00:39:19", "text": "今回私がこうやってここに来るのは、ただ"}, {"type": "subtitle", "time": 2365.43, "timestamp": "00:39:25", "text": "公園に来て一人になったり、"}, {"type": "subtitle", "time": 2368.79, "timestamp": "00:39:28", "text": "散歩したり、"}, {"type": "subtitle", "time": 2372.87, "timestamp": "00:39:32", "text": "自分だけの空間を作ったりするためなんです"}, {"type": "subtitle", "time": 2379.109, "timestamp": "00:39:39", "text": "。   まあ、ストリーム配信の"}, {"type": "subtitle", "time": 2385.349, "timestamp": "00:39:45", "text": "コンテンツとして使っているだけかな。"}]
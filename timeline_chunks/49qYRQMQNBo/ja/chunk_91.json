[{"type": "subtitle", "time": 5464.229, "timestamp": "01:31:04", "text": "来て、配信したりすることさえ、"}, {"type": "subtitle", "time": 5469.03, "timestamp": "01:31:09", "text": "虚無感や"}, {"type": "subtitle", "time": 5471.669, "timestamp": "01:31:11", "text": "孤独感のようなものを感じます。つまり、"}, {"type": "subtitle", "time": 5473.99, "timestamp": "01:31:13", "text": "誰かとコラボしているときは、"}, {"type": "subtitle", "time": 5476.629, "timestamp": "01:31:16", "text": "話す相手などがいます。それは良いことです。しかし、"}, {"type": "subtitle", "time": 5481.27, "timestamp": "01:31:21", "text": "今はソロ配信をしたり、"}, {"type": "subtitle", "time": 5483.59, "timestamp": "01:31:23", "text": "虚無に向かって配信していると、"}, {"type": "subtitle", "time": 5486.629, "timestamp": "01:31:26", "text": "とても孤独を感じます。だから"}, {"type": "subtitle", "time": 5489.59, "timestamp": "01:31:29", "text": "、でも、"}, {"type": "subtitle", "time": 5493.189, "timestamp": "01:31:33", "text": "正直に言うと、"}, {"type": "subtitle", "time": 5498.79, "timestamp": "01:31:38", "text": "プライベートなことを持ち出すべきではないことは分かっていますが、彼がいてくれて本当に感謝しています"}, {"type": "subtitle", "time": 5504.229, "timestamp": "01:31:44", "text": "。私は料理の仕方がわからないので、"}, {"type": "subtitle", "time": 5509.83, "timestamp": "01:31:49", "text": "彼は私のために料理をしてくれて、"}, {"type": "subtitle", "time": 5513.11, "timestamp": "01:31:53", "text": "お腹が空かないようにしてくれます。彼は"}, {"type": "subtitle", "time": 5516.629, "timestamp": "01:31:56", "text": "私にたくさんのことをしてくれました。私はとても"}, {"type": "subtitle", "time": 5518.79, "timestamp": "01:31:58", "text": "感謝していますし、彼は今、自分の瞬間を迎えています"}]
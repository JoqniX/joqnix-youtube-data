[{"type": "subtitle", "time": 1980.63, "timestamp": "00:33:00", "text": "えっと、"}, {"type": "subtitle", "time": 1983.11, "timestamp": "00:33:03", "text": "明日のコラボ配信の準備のために"}, {"type": "subtitle", "time": 1984.63, "timestamp": "00:33:04", "text": "、"}, {"type": "subtitle", "time": 1989.11, "timestamp": "00:33:09", "text": "コラボの主催者に"}, {"type": "subtitle", "time": 1994.71, "timestamp": "00:33:14", "text": "今日ミーティングをお願いしました。 えっと、配信の時間頃に、今"}, {"type": "subtitle", "time": 2004.31, "timestamp": "00:33:24", "text": "まで見たことのない新しい顔ぶれがいたんです。"}, {"type": "subtitle", "time": 2007.75, "timestamp": "00:33:27", "text": "ええと、"}, {"type": "subtitle", "time": 2010.789, "timestamp": "00:33:30", "text": "過去に会ったり、話したり、コラボレーションしたりしたことのある年配の方々もいます。"}, {"type": "subtitle", "time": 2017.509, "timestamp": "00:33:37", "text": "みんなと近況を報告し合ったり、話したりしたかったんです。それで"}, {"type": "subtitle", "time": 2021.11, "timestamp": "00:33:41", "text": "コラボの主催者に、"}, {"type": "subtitle", "time": 2025.43, "timestamp": "00:33:45", "text": "コラボミーティングをやってもいいか聞いて、"}, {"type": "subtitle", "time": 2037.99, "timestamp": "00:33:57", "text": "新しい顔ぶれもいるから、全部設定しなくても話したり、お互いを理解したりできるから、って言ったんです。"}]
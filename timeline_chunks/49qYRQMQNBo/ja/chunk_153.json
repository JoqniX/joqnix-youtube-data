[{"type": "subtitle", "time": 9183.51, "timestamp": "02:33:03", "text": "自分のために薪を買っている。自分のために薪を"}, {"type": "subtitle", "time": 9188.469, "timestamp": "02:33:08", "text": "外から出す、特にコンビニで買うのは絶対にダメな出費だ。"}, {"type": "subtitle", "time": 9195.67, "timestamp": "02:33:15", "text": "出費は大変で、狂ってる。"}, {"type": "subtitle", "time": 9197.51, "timestamp": "02:33:17", "text": "そして私を見て、 今まさにそれをやっていて、こんなことが"}, {"type": "subtitle", "time": 9210.87, "timestamp": "02:33:30", "text": "起こっている"}, {"type": "subtitle", "time": 9217.19, "timestamp": "02:33:37", "text": "。これ以上何ができるだろうか。"}, {"type": "subtitle", "time": 9219.91, "timestamp": "02:33:39", "text": "でも、私が食べているものをあなたに見せられたらいいのにと思う"}, {"type": "subtitle", "time": 9222.71, "timestamp": "02:33:42", "text": "。たぶん写真を撮って、"}, {"type": "subtitle", "time": 9229.83, "timestamp": "02:33:49", "text": "後でDiscordかTwitterか"}, {"type": "subtitle", "time": 9233.75, "timestamp": "02:33:53", "text": "何かで見せるつもりだ。ええ、いくつか物を買った。それを"}]
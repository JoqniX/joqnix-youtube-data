[{"type": "subtitle", "time": 8656.469, "timestamp": "02:24:16", "text": "物。おい、この辺りは完全に片付いたぞ。"}, {"type": "subtitle", "time": 8659.27, "timestamp": "02:24:19", "text": "みんな全部買い占めたんだ。"}, {"type": "subtitle", "time": 8662.07, "timestamp": "02:24:22", "text": "でも麺が少し残ってる。"}, {"type": "subtitle", "time": 8664.15, "timestamp": "02:24:24", "text": "あぁ、電子レンジで温めなきゃ。ああ、"}, {"type": "subtitle", "time": 8666.63, "timestamp": "02:24:26", "text": "寿司はまだ終わってない。"}, {"type": "subtitle", "time": 8669.91, "timestamp": "02:24:29", "text": "待って、ここには何もない。"}, {"type": "subtitle", "time": 8673.84, "timestamp": "02:24:33", "text": "ここには何もない。 サラダがいくつか。キムチ。"}, {"type": "subtitle", "time": 8677.12, "timestamp": "02:24:37", "text": "サラダがいくつか。キムチ。 日本のキムチは変な味がする。"}, {"type": "subtitle", "time": 8680.24, "timestamp": "02:24:40", "text": "日本のキムチは変な味がする。 韓国のキムチの方が美味しいと思う。"}, {"type": "subtitle", "time": 8689.19, "timestamp": "02:24:49", "text": "ああ、ここには何もない。"}, {"type": "subtitle", "time": 8692.23, "timestamp": "02:24:52", "text": "でもデザートは買える。"}]
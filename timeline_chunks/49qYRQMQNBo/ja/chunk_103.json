[{"type": "subtitle", "time": 6182.87, "timestamp": "01:43:02", "text": "このドラムみたいなやつ。"}, {"type": "subtitle", "time": 6196.07, "timestamp": "01:43:16", "text": "センターとかで見たことある。"}, {"type": "subtitle", "time": 6199.03, "timestamp": "01:43:19", "text": "ああ、そうだ。学校の用事で東京に行ったとき、ずっと"}, {"type": "subtitle", "time": 6206.79, "timestamp": "01:43:26", "text": "東京まで行ったんだけど、"}, {"type": "subtitle", "time": 6211.75, "timestamp": "01:43:31", "text": "このゲームセンターに行ったんだ。"}, {"type": "subtitle", "time": 6215.83, "timestamp": "01:43:35", "text": "ガチャみたいなやつ、ガチャみたいなやつ、えーと、"}, {"type": "subtitle", "time": 6218.47, "timestamp": "01:43:38", "text": "クレーンゲームとか"}, {"type": "subtitle", "time": 6224.229, "timestamp": "01:43:44", "text": "アーケードゲームとかがいっぱいあるお店みたいなやつ。そこで、"}, {"type": "subtitle", "time": 6228.629, "timestamp": "01:43:48", "text": "アーケードゲームらしきものを見つけたんだけど、たぶん10代の男の子が、"}, {"type": "subtitle", "time": 6235.75, "timestamp": "01:43:55", "text": "osu! みたいなドラムゲームをやってたんだ。osu! みたいなやつだよね？"}, {"type": "subtitle", "time": 6238.87, "timestamp": "01:43:58", "text": "タオ。確かそんな名前だったと思う。うん、みんな"}]
[{"type": "subtitle", "time": 7864.55, "timestamp": "02:11:04", "text": "ママにこんにちは。こんにちは。こんにちは。ようこそ。"}, {"type": "subtitle", "time": 7872.229, "timestamp": "02:11:12", "text": "お金を無駄にしてはいけません。請求"}, {"type": "subtitle", "time": 7882.069, "timestamp": "02:11:22", "text": "マイルドなものか、"}, {"type": "subtitle", "time": 7889.43, "timestamp": "02:11:29", "text": "ゴマラーメン。よし、これにしよう。"}, {"type": "subtitle", "time": 7893.91, "timestamp": "02:11:33", "text": "セブンイレブンに来たし、お腹が空いた。飲み物。見てみましょう"}, {"type": "subtitle", "time": 7914.87, "timestamp": "02:11:54", "text": "よし、これを買おう。それから"}, {"type": "subtitle", "time": 7918.149, "timestamp": "02:11:58", "text": "パンか何か買おう。"}]
[{"type": "subtitle", "time": 4266.149, "timestamp": "01:11:06", "text": "英語で話さないはずだったのですが、今は"}, {"type": "subtitle", "time": 4268.709, "timestamp": "01:11:08", "text": "英語だけで話しています。"}, {"type": "subtitle", "time": 4277.11, "timestamp": "01:11:17", "text": "とにかく、9時です。もう"}, {"type": "subtitle", "time": 4279.43, "timestamp": "01:11:19", "text": "1時です。わかりました。わかりました。では、"}, {"type": "subtitle", "time": 4282.31, "timestamp": "01:11:22", "text": "今日はこれで終わりにしましょう。"}, {"type": "subtitle", "time": 4285.51, "timestamp": "01:11:25", "text": "短いストリームで申し訳ありませんが、ええ、"}, {"type": "subtitle", "time": 4287.669, "timestamp": "01:11:27", "text": "開始が遅れました。もっと"}, {"type": "subtitle", "time": 4292.63, "timestamp": "01:11:32", "text": "早く外に出る予定でしたが、ええと、もう少し"}, {"type": "subtitle", "time": 4296.63, "timestamp": "01:11:36", "text": "早く、 やらなきゃいけないことがいくつかあったんです"}, {"type": "subtitle", "time": 4302.07, "timestamp": "01:11:42", "text": "。"}, {"type": "subtitle", "time": 4305.03, "timestamp": "01:11:45", "text": "全部"}, {"type": "subtitle", "time": 4309.43, "timestamp": "01:11:49", "text": "終わらせずに出かけたり、出かけたりするわけにはいきません。いや、自分の"}, {"type": "subtitle", "time": 4312.07, "timestamp": "01:11:52", "text": "責任を果たさなきゃいけないんです"}, {"type": "subtitle", "time": 4315.75, "timestamp": "01:11:55", "text": "。そういうことです。"}, {"type": "subtitle", "time": 4318.87, "timestamp": "01:11:58", "text": "でも、たぶん"}]
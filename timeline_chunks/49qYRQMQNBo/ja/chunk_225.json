[{"type": "subtitle", "time": 13508.469, "timestamp": "03:45:08", "text": "服の達人を信じてください。"}, {"type": "subtitle", "time": 13511.189, "timestamp": "03:45:11", "text": "想像以上に愛しています。ええ。"}, {"type": "subtitle", "time": 13512.95, "timestamp": "03:45:12", "text": "そして、"}, {"type": "subtitle", "time": 13522.55, "timestamp": "03:45:22", "text": "でも、ええ。わかりました。とにかく、皆さん、私たちは"}, {"type": "subtitle", "time": 13527.83, "timestamp": "03:45:27", "text": "初めてストリーミング配信をしました。3"}, {"type": "subtitle", "time": 13531.269, "timestamp": "03:45:31", "text": "時間48分のモバイル配信をしました。"}, {"type": "subtitle", "time": 13533.59, "timestamp": "03:45:33", "text": "つまり、過去に"}, {"type": "subtitle", "time": 13536.309, "timestamp": "03:45:36", "text": "インドでやったことはありますが、日本ではこれが"}, {"type": "subtitle", "time": 13540.63, "timestamp": "03:45:40", "text": "初めてだと思います。"}, {"type": "subtitle", "time": 13544.389, "timestamp": "03:45:44", "text": "公園で一緒に夕食を食べました。今、文字通り凍えるほど寒いです"}, {"type": "subtitle", "time": 13547.349, "timestamp": "03:45:47", "text": "。"}, {"type": "subtitle", "time": 13551.11, "timestamp": "03:45:51", "text": "ええ、今日は楽しかったです。"}, {"type": "subtitle", "time": 13553.99, "timestamp": "03:45:53", "text": "聞いてくれてありがとう。"}, {"type": "subtitle", "time": 13556.63, "timestamp": "03:45:56", "text": "あまり英語を話すべきではないことはわかっています。"}, {"type": "subtitle", "time": 13559.91, "timestamp": "03:45:59", "text": "これらの配信は、"}]
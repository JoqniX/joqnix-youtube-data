[{"type": "subtitle", "time": 4921.91, "timestamp": "01:22:01", "text": "自分の足で立たなきゃいけない。両足でね。そう。"}, {"type": "subtitle", "time": 4926.39, "timestamp": "01:22:06", "text": "自分の夢や目標に向かって努力して、"}, {"type": "subtitle", "time": 4932.95, "timestamp": "01:22:12", "text": "お金を稼がなきゃいけない。だから、私みたいな世間知らずな"}, {"type": "subtitle", "time": 4938.31, "timestamp": "01:22:18", "text": "人間は、慣れるのに"}, {"type": "subtitle", "time": 4942.55, "timestamp": "01:22:22", "text": "時間がかかるんだと思う。"}, {"type": "subtitle", "time": 4951.27, "timestamp": "01:22:31", "text": "オンラインで仲の良い友達の話もする"}, {"type": "subtitle", "time": 4957.59, "timestamp": "01:22:37", "text": "けど、"}, {"type": "subtitle", "time": 4959.75, "timestamp": "01:22:39", "text": "オンラインの友達と話すのもいいけど、日本みたいな現実世界にも"}, {"type": "subtitle", "time": 4963.43, "timestamp": "01:22:43", "text": "もっと友達を作るべきだって気づいたんだ。 そうですよね、"}, {"type": "subtitle", "time": 4973.35, "timestamp": "01:22:53", "text": "そしてそれは大変でした。"}, {"type": "subtitle", "time": 4976.87, "timestamp": "01:22:56", "text": "日本人と友達になるのも大変だと思います。"}]
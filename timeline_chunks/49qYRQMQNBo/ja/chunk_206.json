[{"type": "subtitle", "time": 12364.07, "timestamp": "03:26:04", "text": "最高額の奨学金をもらって"}, {"type": "subtitle", "time": 12367.349, "timestamp": "03:26:07", "text": "日本に無料で来て、好きな"}, {"type": "subtitle", "time": 12370.229, "timestamp": "03:26:10", "text": "仕事や大学に"}, {"type": "subtitle", "time": 12372.389, "timestamp": "03:26:12", "text": "無料で入れるなんて、ものすごくラッキーじゃないとできない。誰か一人いれば"}, {"type": "subtitle", "time": 12381.03, "timestamp": "03:26:21", "text": "日本の田舎に行ったことある？"}, {"type": "subtitle", "time": 12411.349, "timestamp": "03:26:51", "text": "田舎と地方郊外が混在していると広く考えられている"}, {"type": "subtitle", "time": 12417.51, "timestamp": "03:26:57", "text": "県の約60％は"}, {"type": "subtitle", "time": 12419.11, "timestamp": "03:26:59", "text": "山と森林に覆われているが、"}]
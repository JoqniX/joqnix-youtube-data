[{"type": "subtitle", "time": 12960.79, "timestamp": "03:36:00", "text": "不可能だって分かってるけど。うん。スタッフ"}, {"type": "subtitle", "time": 12968.15, "timestamp": "03:36:08", "text": "とか"}, {"type": "subtitle", "time": 12976.07, "timestamp": "03:36:16", "text": "コンサートスタッフとか、スタッフとか"}, {"type": "subtitle", "time": 12979.67, "timestamp": "03:36:19", "text": "技術者とか、そういう仕事はできるかもしれない。"}, {"type": "subtitle", "time": 12984.309, "timestamp": "03:36:24", "text": "コンサートとかそういう"}, {"type": "subtitle", "time": 12986.87, "timestamp": "03:36:26", "text": "エンターテイメントショーに行くなら、それも"}, {"type": "subtitle", "time": 12990.389, "timestamp": "03:36:30", "text": "バックアッププランの一つなんだ。"}, {"type": "subtitle", "time": 12994.469, "timestamp": "03:36:34", "text": "タレントとかになれなかったら、"}, {"type": "subtitle", "time": 12999.11, "timestamp": "03:36:39", "text": "機会と、私がやりたいこと、"}, {"type": "subtitle", "time": 13003.75, "timestamp": "03:36:43", "text": "見たいもの、やりたくないこと、やりたくないこと、私はまだ"}, {"type": "subtitle", "time": 13007.19, "timestamp": "03:36:47", "text": "若いと感じています。"}, {"type": "subtitle", "time": 13016.15, "timestamp": "03:36:56", "text": "声と見た目から、日本人でさえ私が16歳くらいだと思っていました。"}]
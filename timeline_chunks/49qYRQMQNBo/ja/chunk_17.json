[{"type": "subtitle", "time": 1022.069, "timestamp": "00:17:02", "text": "届いた。 支払わなければならないのに、お金がないんです。"}, {"type": "subtitle", "time": 1026.15, "timestamp": "00:17:06", "text": "えっと、働き始めたばかりなので給料の半分しかもらえませんでした。"}, {"type": "subtitle", "time": 1030.23, "timestamp": "00:17:10", "text": "ここの支払いシステムは"}, {"type": "subtitle", "time": 1034.15, "timestamp": "00:17:14", "text": "ちょっと変なんです。 だから、ちょっと変な感じがする。 つまり、"}, {"type": "subtitle", "time": 1040.63, "timestamp": "00:17:20", "text": "月の半ばから働き始めたり、"}, {"type": "subtitle", "time": 1043.429, "timestamp": "00:17:23", "text": "5日間や10日間働いたりした場合、その分の"}, {"type": "subtitle", "time": 1047.029, "timestamp": "00:17:27", "text": "給料は翌月の給料日に支払われます。"}, {"type": "subtitle", "time": 1049.51, "timestamp": "00:17:29", "text": "そして、翌月の給料を受け取るためには、"}, {"type": "subtitle", "time": 1057.11, "timestamp": "00:17:37", "text": "翌月まで待たなければなりません。 だから6月は、5月分の"}, {"type": "subtitle", "time": 1059.75, "timestamp": "00:17:39", "text": "給料を受け取るために、6月の給料日まで待たなければならない"}, {"type": "subtitle", "time": 1061.75, "timestamp": "00:17:41", "text": "。"}, {"type": "subtitle", "time": 1064.15, "timestamp": "00:17:44", "text": "ランブル・ジョーの次回の出演者は誰ですか？ えっと、"}, {"type": "subtitle", "time": 1067.19, "timestamp": "00:17:47", "text": "チャンネル名がちょっと変ですね。"}, {"type": "subtitle", "time": 1069.19, "timestamp": "00:17:49", "text": "カスタムチャンネル"}, {"type": "subtitle", "time": 1072.31, "timestamp": "00:17:52", "text": "名がないので、そうせざるを得ません。 一定数のフォロワーが必要だったりすると思う"}]
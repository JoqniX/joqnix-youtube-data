[{"type": "subtitle", "time": 6068.149, "timestamp": "01:41:08", "text": "にいた人、私のゲームやってる"}, {"type": "subtitle", "time": 6070.709, "timestamp": "01:41:10", "text": "？私は私のゲームはやってない。それって"}, {"type": "subtitle", "time": 6073.99, "timestamp": "01:41:13", "text": "何？どんなゲーム？ あれは？ゲームはできない"}, {"type": "subtitle", "time": 6080.87, "timestamp": "01:41:20", "text": "汚い言葉も覚えないようにしよう"}, {"type": "subtitle", "time": 6084.47, "timestamp": "01:41:24", "text": "。うん、覚えないよ。"}, {"type": "subtitle", "time": 6089.03, "timestamp": "01:41:29", "text": "汚い言葉は知ってるけど、使わない。"}, {"type": "subtitle", "time": 6091.75, "timestamp": "01:41:31", "text": "使うべきじゃない。あ、待って。"}, {"type": "subtitle", "time": 6095.109, "timestamp": "01:41:35", "text": "星が見える。"}, {"type": "subtitle", "time": 6099.109, "timestamp": "01:41:39", "text": "空に星がいくつか見えてる。やったー。あと"}]
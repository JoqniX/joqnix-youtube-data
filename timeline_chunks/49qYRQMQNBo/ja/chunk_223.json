[{"type": "subtitle", "time": 13383.51, "timestamp": "03:43:03", "text": "私の学校でも、みんなとても"}, {"type": "subtitle", "time": 13388.87, "timestamp": "03:43:08", "text": "おしゃれです。みんな、オーバーコートとか、"}, {"type": "subtitle", "time": 13398.309, "timestamp": "03:43:18", "text": "探偵みたいなオーバーコーデとか、ロングコートとか"}, {"type": "subtitle", "time": 13405.429, "timestamp": "03:43:25", "text": "ショートコートとか、そういうのが一般的で、いろいろな"}, {"type": "subtitle", "time": 13409.83, "timestamp": "03:43:29", "text": "服装があります。"}, {"type": "subtitle", "time": 13411.91, "timestamp": "03:43:31", "text": "ええ、"}, {"type": "subtitle", "time": 13414.71, "timestamp": "03:43:34", "text": "私はファッションの変化に適応していません。"}, {"type": "subtitle", "time": 13418.79, "timestamp": "03:43:38", "text": "私はどちらかというとシンプルな人間なので、徐々に適応し始めています。私はファッションには興味がありません"}, {"type": "subtitle", "time": 13421.83, "timestamp": "03:43:41", "text": "。"}, {"type": "subtitle", "time": 13427.91, "timestamp": "03:43:47", "text": "見つけたものを着て行くだけです。"}, {"type": "subtitle", "time": 13435.83, "timestamp": "03:43:55", "text": "。あと"}, {"type": "subtitle", "time": 13438.95, "timestamp": "03:43:58", "text": "3分で"}]
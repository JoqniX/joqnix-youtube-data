[{"type": "subtitle", "time": 10685.51, "timestamp": "02:58:05", "text": "まだクラスメートとうまくやっていけていない、この2年生はみんな"}, {"type": "subtitle", "time": 10689.99, "timestamp": "02:58:09", "text": "去年の1年生の時に出会った人で、今は"}, {"type": "subtitle", "time": 10691.67, "timestamp": "02:58:11", "text": "2年生で"}, {"type": "subtitle", "time": 10706.63, "timestamp": "02:58:26", "text": "私は"}, {"type": "subtitle", "time": 10710.389, "timestamp": "02:58:30", "text": "インドから来た日本人の教えに慣れているんだけど、"}, {"type": "subtitle", "time": 10713.51, "timestamp": "02:58:33", "text": "その教え方は、"}, {"type": "subtitle", "time": 10715.59, "timestamp": "02:58:35", "text": "私は"}, {"type": "subtitle", "time": 10727.75, "timestamp": "02:58:47", "text": "真剣に受け止めないで、バカ、言わないで、あのタイプの人は"}, {"type": "subtitle", "time": 10731.269, "timestamp": "02:58:51", "text": "冗談とかがわからないから、"}, {"type": "subtitle", "time": 10736.309, "timestamp": "02:58:56", "text": "本当のことを言わないで。"}, {"type": "subtitle", "time": 10738.55, "timestamp": "02:58:58", "text": "でも、そうですね、私のクラスメート、2年生の"}]
[{"type": "subtitle", "time": 4440.229, "timestamp": "01:14:00", "text": "今までで最悪のルートを辿ったような気がする。"}, {"type": "subtitle", "time": 4445.03, "timestamp": "01:14:05", "text": "もし"}, {"type": "subtitle", "time": 4450.149, "timestamp": "01:14:10", "text": "ルームメイトと一緒に1年生のクラスに入れられていたら、"}, {"type": "subtitle", "time": 4455.669, "timestamp": "01:14:15", "text": "学校生活を楽しんでいただろう。"}, {"type": "subtitle", "time": 4458.229, "timestamp": "01:14:18", "text": "楽しんでいたはずだ。楽しんでいたんだ"}, {"type": "subtitle", "time": 4461.59, "timestamp": "01:14:21", "text": "。楽しんでいた。"}, {"type": "subtitle", "time": 4465.59, "timestamp": "01:14:25", "text": "彼は楽しんでいる。僕は"}, {"type": "subtitle", "time": 4469.03, "timestamp": "01:14:29", "text": "中級クラスだからストレスが溜まっている。僕はここに賃貸で来たわけじゃない。もしかしたら"}, {"type": "subtitle", "time": 4474.149, "timestamp": "01:14:34", "text": "修繕中なのかもしれない。でも、まるでみんな仲の良い"}, {"type": "subtitle", "time": 4481.03, "timestamp": "01:14:41", "text": "クラスに転校してきた生徒で、自分だけが"}, {"type": "subtitle", "time": 4484.63, "timestamp": "01:14:44", "text": "新入生で、"}, {"type": "subtitle", "time": 4487.51, "timestamp": "01:14:47", "text": "まだ誰も話しかけてくれないような感じ。"}, {"type": "subtitle", "time": 4489.99, "timestamp": "01:14:49", "text": "友達を作るのもまだ難しいし、そういう"}, {"type": "subtitle", "time": 4497.99, "timestamp": "01:14:57", "text": "感情とかそういう感じ"}]
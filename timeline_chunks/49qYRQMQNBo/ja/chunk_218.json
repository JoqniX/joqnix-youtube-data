[{"type": "subtitle", "time": 13085.269, "timestamp": "03:38:05", "text": "よし。家に帰るのに10分くらいかかると"}, {"type": "subtitle", "time": 13088.79, "timestamp": "03:38:08", "text": "思う。だから、"}, {"type": "subtitle", "time": 13091.67, "timestamp": "03:38:11", "text": "ゆっくり家に帰ろう。"}, {"type": "subtitle", "time": 13094.07, "timestamp": "03:38:14", "text": "手を取った。"}, {"type": "subtitle", "time": 13096.229, "timestamp": "03:38:16", "text": "よし、"}, {"type": "subtitle", "time": 13100.63, "timestamp": "03:38:20", "text": "午前4時に起きなきゃいけないのに、今は"}, {"type": "subtitle", "time": 13103.19, "timestamp": "03:38:23", "text": "11時半だ。"}, {"type": "subtitle", "time": 13106.229, "timestamp": "03:38:26", "text": "待って、11時。12時から数えよう。つまり"}, {"type": "subtitle", "time": 13118.229, "timestamp": "03:38:38", "text": "時間"}, {"type": "subtitle", "time": 13120.389, "timestamp": "03:38:40", "text": "寝る。"}, {"type": "subtitle", "time": 13123.429, "timestamp": "03:38:43", "text": "うん。でも"}, {"type": "subtitle", "time": 13125.83, "timestamp": "03:38:45", "text": "正直、あそこの人たちはうるさい？"}, {"type": "subtitle", "time": 13129.91, "timestamp": "03:38:49", "text": "いや、そんなにうるさくない。実際、"}, {"type": "subtitle", "time": 13136.389, "timestamp": "03:38:56", "text": "人はそんなにうるさくない。うるさい"}, {"type": "subtitle", "time": 13139.83, "timestamp": "03:38:59", "text": "人もいるけど、大抵は"}]
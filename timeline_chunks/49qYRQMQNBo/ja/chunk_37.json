[{"type": "subtitle", "time": 2224.15, "timestamp": "00:37:04", "text": "もし私が正しければ、シンガポールのサーバーで配信する予定です。   ああ"}, {"type": "subtitle", "time": 2227.51, "timestamp": "00:37:07", "text": "、今日は雨が降ったのを忘れてた。"}, {"type": "subtitle", "time": 2229.91, "timestamp": "00:37:09", "text": "地面が濡れているので、今日は星空観察はできません"}, {"type": "subtitle", "time": 2248.47, "timestamp": "00:37:28", "text": "空にたくさんの雲が浮かんでいるみたいだ。"}, {"type": "subtitle", "time": 2251.27, "timestamp": "00:37:31", "text": "だから、スター選手がそこに行くとは考えにくい"}]
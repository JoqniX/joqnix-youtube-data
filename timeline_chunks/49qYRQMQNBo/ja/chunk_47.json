[{"type": "subtitle", "time": 2821.349, "timestamp": "00:47:01", "text": "。"}, {"type": "subtitle", "time": 2823.75, "timestamp": "00:47:03", "text": "お元気でお過ごしでしょうか。"}, {"type": "subtitle", "time": 2826.55, "timestamp": "00:47:06", "text": "最近新しいノートパソコンにSammyをインストールしたんだけど、"}, {"type": "subtitle", "time": 2836.309, "timestamp": "00:47:16", "text": "昔の自分のやり方を振り返ると、"}, {"type": "subtitle", "time": 2838.15, "timestamp": "00:47:18", "text": "複雑な設定とか、今までやってきたこと"}, {"type": "subtitle", "time": 2840.55, "timestamp": "00:47:20", "text": "全部、今は"}, {"type": "subtitle", "time": 2843.349, "timestamp": "00:47:23", "text": "もっと"}, {"type": "subtitle", "time": 2846.47, "timestamp": "00:47:26", "text": "のんびりしたい気分なんだ。 こんにちは、ゲートさん。 うん。 楽しむ。   昔の自分の"}, {"type": "subtitle", "time": 2849.67, "timestamp": "00:47:29", "text": "作品を見ると、"}, {"type": "subtitle", "time": 2852.55, "timestamp": "00:47:32", "text": "クラウドフェアワーカーとかウェブサイトとか色々あって、本当に"}, {"type": "subtitle", "time": 2863.829, "timestamp": "00:47:43", "text": "頭痛がする。頭痛でいっぱいになる。何て言えば"}, {"type": "subtitle", "time": 2865.43, "timestamp": "00:47:45", "text": "いいのか分からないけど、それを"}, {"type": "subtitle", "time": 2867.91, "timestamp": "00:47:47", "text": "見ると「"}, {"type": "subtitle", "time": 2871.349, "timestamp": "00:47:51", "text": "ああ、なんでこんなことしたんだろう」って思う。ああ、だって"}]
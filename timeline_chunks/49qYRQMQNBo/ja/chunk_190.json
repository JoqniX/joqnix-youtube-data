[{"type": "subtitle", "time": 11402.63, "timestamp": "03:10:02", "text": "たいことは決めているし、道筋も決まっている。だから、たとえ自分のことを"}, {"type": "subtitle", "time": 11412.87, "timestamp": "03:10:12", "text": "具体的に言っていなくても、"}, {"type": "subtitle", "time": 11419.99, "timestamp": "03:10:19", "text": "それを公言する必要はなかったけど、もう"}, {"type": "subtitle", "time": 11423.59, "timestamp": "03:10:23", "text": "決めているし、何をしたいかマインド"}, {"type": "subtitle", "time": 11429.19, "timestamp": "03:10:29", "text": "マップも作って、バックアッププランも立てているし、リサーチも済ませている。"}, {"type": "subtitle", "time": 11436.469, "timestamp": "03:10:36", "text": "今月は"}, {"type": "subtitle", "time": 11440.87, "timestamp": "03:10:40", "text": "新宿に行かなきゃいけないんだ。新宿は"}, {"type": "subtitle", "time": 11447.03, "timestamp": "03:10:47", "text": "関東地方で、"}, {"type": "subtitle", "time": 11449.67, "timestamp": "03:10:49", "text": "東京からちょっと遠いところにあるんだけど、"}, {"type": "subtitle", "time": 11456.469, "timestamp": "03:10:56", "text": "クリエイティブ系の大学をいくつか調べてるんだ。クリエイティブ系の大学とか、そういうところだよ。よく分から"}]
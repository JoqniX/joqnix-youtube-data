[{"type": "subtitle", "time": 11006.309, "timestamp": "03:03:26", "text": "この場所にはインド人はあまりいません。"}, {"type": "subtitle", "time": 11011.51, "timestamp": "03:03:31", "text": "私の学校でもそうらしい。"}, {"type": "subtitle", "time": 11013.67, "timestamp": "03:03:33", "text": "インド人はたった2人だけ。   これは"}, {"type": "subtitle", "time": 11015.91, "timestamp": "03:03:35", "text": "私とルームメイトです。 東京には、本当にたくさんの"}, {"type": "subtitle", "time": 11019.03, "timestamp": "03:03:39", "text": "インド人がいる。"}, {"type": "subtitle", "time": 11021.51, "timestamp": "03:03:41", "text": "私は江戸川西安錦"}, {"type": "subtitle", "time": 11023.67, "timestamp": "03:03:43", "text": "笠井地区に行きました。   それはまるで小さな"}, {"type": "subtitle", "time": 11026.79, "timestamp": "03:03:46", "text": "インドのようだ。   つまり、そこは"}, {"type": "subtitle", "time": 11032.469, "timestamp": "03:03:52", "text": "北インド出身の人がたくさん住んでいる場所なんです。   ああ"}, {"type": "subtitle", "time": 11035.75, "timestamp": "03:03:55", "text": "、そこに行った時、一瞬インドにいるような気分になったよ"}]
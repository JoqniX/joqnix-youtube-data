[{"type": "subtitle", "time": 12601.91, "timestamp": "03:30:01", "text": "東京に行くたびに100円チャージしなければならず、"}, {"type": "subtitle", "time": 12606.389, "timestamp": "03:30:06", "text": "私は東京に9回行きました。9回"}, {"type": "subtitle", "time": 12609.59, "timestamp": "03:30:09", "text": "か10回。Kickでも配信していますか？"}, {"type": "subtitle", "time": 12612.309, "timestamp": "03:30:12", "text": "はい、私も配信しています。  Rumble"}, {"type": "subtitle", "time": 12615.91, "timestamp": "03:30:15", "text": "Rumbleでも。Rumbleの"}, {"type": "subtitle", "time": 12625.19, "timestamp": "03:30:25", "text": "うん、そうだね"}, {"type": "subtitle", "time": 12634.309, "timestamp": "03:30:34", "text": "先月無駄にした金額は尋常じゃなかったよ。東京のインド大使館"}, {"type": "subtitle", "time": 12637.59, "timestamp": "03:30:37", "text": "。まだ行ったことないんだ。"}, {"type": "subtitle", "time": 12640.469, "timestamp": "03:30:40", "text": "今行かなきゃ。IGNOの"}, {"type": "subtitle", "time": 12647.59, "timestamp": "03:30:47", "text": "人たちに、"}, {"type": "subtitle", "time": 12653.59, "timestamp": "03:30:53", "text": "日本からインド大使館で試験を受けられるかどうかメールすら送ってないと思う"}, {"type": "subtitle", "time": 12655.269, "timestamp": "03:30:55", "text": "。"}, {"type": "subtitle", "time": 12657.91, "timestamp": "03:30:57", "text": "後でやらなきゃ。もう"}]
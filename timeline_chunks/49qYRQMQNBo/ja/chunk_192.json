[{"type": "subtitle", "time": 11525.03, "timestamp": "03:12:05", "text": "それはプライベートなことだよ、カキ。"}, {"type": "subtitle", "time": 11527.429, "timestamp": "03:12:07", "text": "それを話す必要はない。"}, {"type": "subtitle", "time": 11529.99, "timestamp": "03:12:09", "text": "それは良くない。そうだね。"}, {"type": "subtitle", "time": 11538.79, "timestamp": "03:12:18", "text": "僕は知っているよ。 費用。だから、だから、"}, {"type": "subtitle", "time": 11547.91, "timestamp": "03:12:27", "text": "日本は物価が高いから、調査に行ったんです。"}, {"type": "subtitle", "time": 11551.03, "timestamp": "03:12:31", "text": "東京は高い。"}, {"type": "subtitle", "time": 11554.23, "timestamp": "03:12:34", "text": "大学も高い。"}, {"type": "subtitle", "time": 11558.309, "timestamp": "03:12:38", "text": "大学だと年間200万円くらいかかる。"}, {"type": "subtitle", "time": 11564.71, "timestamp": "03:12:44", "text": "授業料とか基本額だけでそれくらい。高い。"}, {"type": "subtitle", "time": 11572.15, "timestamp": "03:12:52", "text": "大学で"}, {"type": "subtitle", "time": 11575.59, "timestamp": "03:12:55", "text": "4年間か3年間のコースを受講して学びたいなら、"}]
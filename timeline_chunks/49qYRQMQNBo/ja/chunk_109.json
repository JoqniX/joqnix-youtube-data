[{"type": "subtitle", "time": 6543.189, "timestamp": "01:49:03", "text": "。面と向かっては言わ"}, {"type": "subtitle", "time": 6545.669, "timestamp": "01:49:05", "text": "ない。それが重要な点だ。"}, {"type": "subtitle", "time": 6550.149, "timestamp": "01:49:10", "text": "そして彼らは"}, {"type": "subtitle", "time": 6553.109, "timestamp": "01:49:13", "text": "あなたを監視し、観察し続け、"}, {"type": "subtitle", "time": 6556.149, "timestamp": "01:49:16", "text": "あなたのミス、やり方の"}, {"type": "subtitle", "time": 6559.669, "timestamp": "01:49:19", "text": "間違いなどなど。"}, {"type": "subtitle", "time": 6563.43, "timestamp": "01:49:23", "text": "そうだ。コミュニケーションは"}, {"type": "subtitle", "time": 6565.59, "timestamp": "01:49:25", "text": "時々制限される。"}, {"type": "subtitle", "time": 6568.47, "timestamp": "01:49:28", "text": "だから、そういうこと全部。 ええ。それが1つ目の"}, {"type": "subtitle", "time": 6573.189, "timestamp": "01:49:33", "text": "ポイントです。2つ目は、何と"}, {"type": "subtitle", "time": 6576.55, "timestamp": "01:49:36", "text": "言えばいいでしょうか？ステレオタイプです。つまり、まだ人種"}, {"type": "subtitle", "time": 6579.75, "timestamp": "01:49:39", "text": "差別とかそういうのを感じたことはありません。人種"}, {"type": "subtitle", "time": 6583.35, "timestamp": "01:49:43", "text": "差別とかそういうのを感じたのは、"}, {"type": "subtitle", "time": 6588.07, "timestamp": "01:49:48", "text": "東京に行ったときだけです。"}, {"type": "subtitle", "time": 6591.59, "timestamp": "01:49:51", "text": "学校の用事で、ある"}, {"type": "subtitle", "time": 6595.35, "timestamp": "01:49:55", "text": "職業訓練校に行ったときです。"}, {"type": "subtitle", "time": 6598.229, "timestamp": "01:49:58", "text": "駅にいました。降りたら、確か営業"}]
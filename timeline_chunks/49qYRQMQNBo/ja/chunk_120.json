[{"type": "subtitle", "time": 7201.43, "timestamp": "02:00:01", "text": "ほとんどの人が仕事があったり、"}, {"type": "subtitle", "time": 7204.07, "timestamp": "02:00:04", "text": "忙しかったり、"}, {"type": "subtitle", "time": 7206.709, "timestamp": "02:00:06", "text": "寝なければならなかったりするからです。私は日本にいるので、"}, {"type": "subtitle", "time": 7211.27, "timestamp": "02:00:11", "text": "外国人として"}, {"type": "subtitle", "time": 7214.229, "timestamp": "02:00:14", "text": "日本人はとても几帳面で"}, {"type": "subtitle", "time": 7217.51, "timestamp": "02:00:17", "text": "早く寝たり、早くから仕事に行ったり、"}, {"type": "subtitle", "time": 7221.03, "timestamp": "02:00:21", "text": "食事も少なかったりするのは分かります"}, {"type": "subtitle", "time": 7222.87, "timestamp": "02:00:22", "text": "。"}, {"type": "subtitle", "time": 7225.35, "timestamp": "02:00:25", "text": "でも、"}, {"type": "subtitle", "time": 7226.79, "timestamp": "02:00:26", "text": "チャンネルの"}, {"type": "subtitle", "time": 7228.55, "timestamp": "02:00:28", "text": "絵文字を 日本語版をもっと。"}, {"type": "subtitle", "time": 7230.79, "timestamp": "02:00:30", "text": "うん、できるよ。"}, {"type": "subtitle", "time": 7232.47, "timestamp": "02:00:32", "text": "問題は、今"}, {"type": "subtitle", "time": 7236.149, "timestamp": "02:00:36", "text": "vtubingとなると、たくさんのアートアセットが必要になることだよ"}, {"type": "subtitle", "time": 7239.109, "timestamp": "02:00:39", "text": "ね？そしてそれは難しい。"}, {"type": "subtitle", "time": 7241.03, "timestamp": "02:00:41", "text": "福島で4人が負傷したと聞いたけど、"}, {"type": "subtitle", "time": 7242.629, "timestamp": "02:00:42", "text": "本当？知らない。"}, {"type": "subtitle", "time": 7245.91, "timestamp": "02:00:45", "text": "まだニュースを見てないんだ。僕は"}, {"type": "subtitle", "time": 7248.709, "timestamp": "02:00:48", "text": "2ヶ月前、4月に日本に来た学生なんだ。"}, {"type": "subtitle", "time": 7250.87, "timestamp": "02:00:50", "text": "だからまだニュースを読まないといけない。台風みたいなのが起こっているのは知っているけど、"}, {"type": "subtitle", "time": 7257.83, "timestamp": "02:00:57", "text": "完全には把握していない。"}]
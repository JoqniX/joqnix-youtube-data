[{"type": "subtitle", "time": 7680.149, "timestamp": "02:08:00", "text": "近くのファミリーマートに行ったと思う"}, {"type": "subtitle", "time": 7684.629, "timestamp": "02:08:04", "text": "。問題は、すごく遠いこと。"}, {"type": "subtitle", "time": 7686.629, "timestamp": "02:08:06", "text": "すごく遠いんだ。どこを見ても"}, {"type": "subtitle", "time": 7688.709, "timestamp": "02:08:08", "text": "セブンイレブンばかりで、"}, {"type": "subtitle", "time": 7692.31, "timestamp": "02:08:12", "text": "たまに、ごくまれに、"}, {"type": "subtitle", "time": 7697.51, "timestamp": "02:08:17", "text": "ファミリーマートを見かけることがある。 マート。"}, {"type": "subtitle", "time": 7704.47, "timestamp": "02:08:24", "text": "珍しい角にある。"}, {"type": "subtitle", "time": 7714.39, "timestamp": "02:08:34", "text": "だから、"}, {"type": "subtitle", "time": 7718.069, "timestamp": "02:08:38", "text": "セブンイレブンに行く。"}, {"type": "subtitle", "time": 7722.47, "timestamp": "02:08:42", "text": "ああ、すごく変な感じになりそう。"}, {"type": "subtitle", "time": 7724.79, "timestamp": "02:08:44", "text": "でも、待って、ノイズキャンセリングをオンにした方がいいかな"}, {"type": "subtitle", "time": 7726.629, "timestamp": "02:08:46", "text": "？"}, {"type": "subtitle", "time": 7728.629, "timestamp": "02:08:48", "text": "よし、道路の音とか、私が"}, {"type": "subtitle", "time": 7732.39, "timestamp": "02:08:52", "text": "横断する音とかが聞こえる。だから、これでいい。"}]
[{"type": "subtitle", "time": 5581.189, "timestamp": "01:33:01", "text": "？だって彼は全部計算して、「"}, {"type": "subtitle", "time": 5583.83, "timestamp": "01:33:03", "text": "この卵は"}, {"type": "subtitle", "time": 5587.11, "timestamp": "01:33:07", "text": "今日と明日に使う」とか、"}, {"type": "subtitle", "time": 5588.95, "timestamp": "01:33:08", "text": "あれこれ作るとか、そうだろ"}, {"type": "subtitle", "time": 5591.83, "timestamp": "01:33:11", "text": "？何を作るかアイデアや計画があって、使える"}, {"type": "subtitle", "time": 5594.31, "timestamp": "01:33:14", "text": "食材や、一"}, {"type": "subtitle", "time": 5599.75, "timestamp": "01:33:19", "text": "週間分買った食材を使って、俺が"}, {"type": "subtitle", "time": 5603.27, "timestamp": "01:33:23", "text": "それらの食材を使って、失敗したり、失敗したりしたら、狂っちゃうだろ？うん、"}, {"type": "subtitle", "time": 5615.59, "timestamp": "01:33:35", "text": "想像してみてよ、"}, {"type": "subtitle", "time": 5618.47, "timestamp": "01:33:38", "text": "ルームメイトが料理をしてくれて、"}, {"type": "subtitle", "time": 5620.47, "timestamp": "01:33:40", "text": "全部やってくれるんだ。 料理"}, {"type": "subtitle", "time": 5623.35, "timestamp": "01:33:43", "text": "とか色々あるけど、君は料理の仕方がわからないから、"}, {"type": "subtitle", "time": 5625.91, "timestamp": "01:33:45", "text": "早起きして"}, {"type": "subtitle", "time": 5629.27, "timestamp": "01:33:49", "text": "オムレツを作ってサプライズって言うんだ。そしたら"}, {"type": "subtitle", "time": 5632.07, "timestamp": "01:33:52", "text": "君は何て言う？それで、君は何て言うんだ"}, {"type": "subtitle", "time": 5634.39, "timestamp": "01:33:54", "text": "？彼は「ああ、これが君への"}, {"type": "subtitle", "time": 5638.95, "timestamp": "01:33:58", "text": "サプライズだよ」って言ったんだ。オムレツだよ、兄弟。"}]
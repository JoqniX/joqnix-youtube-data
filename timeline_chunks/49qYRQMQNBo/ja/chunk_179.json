[{"type": "subtitle", "time": 10741.99, "timestamp": "02:59:01", "text": "クラスメートの中には、"}, {"type": "subtitle", "time": 10744.87, "timestamp": "02:59:04", "text": "Vlogをやれる人もいます。  YouTubeにVlogをアップロードしました"}, {"type": "subtitle", "time": 10749.429, "timestamp": "02:59:09", "text": "。 プランを確認してください。"}, {"type": "subtitle", "time": 10751.91, "timestamp": "02:59:11", "text": "Vlogを撮る時間がない。"}, {"type": "subtitle", "time": 10754.15, "timestamp": "02:59:14", "text": "東京や須崎などに行った時の映像がいくつかあるんだ"}, {"type": "subtitle", "time": 10773.269, "timestamp": "02:59:33", "text": "もう東京に行ったの？ ええ、"}, {"type": "subtitle", "time": 10778.309, "timestamp": "02:59:38", "text": "東京には7回9回行ったことがあります。"}, {"type": "subtitle", "time": 10780.15, "timestamp": "02:59:40", "text": "私は出発するはずだった。 彼は"}, {"type": "subtitle", "time": 10784.309, "timestamp": "02:59:44", "text": "負けたと思う。 そちらの状況はどうですか？"}, {"type": "subtitle", "time": 10787.83, "timestamp": "02:59:47", "text": "俺は絶対に東京には住みたくないんだよ"}, {"type": "subtitle", "time": 10791.67, "timestamp": "02:59:51", "text": "。 それは良くない。   私は今"}, {"type": "subtitle", "time": 10793.83, "timestamp": "02:59:53", "text": "いる場所が好きです。"}, {"type": "subtitle", "time": 10797.11, "timestamp": "02:59:57", "text": "とても平和な場所です。 とても広々としている。 公園は"}, {"type": "subtitle", "time": 10799.03, "timestamp": "02:59:59", "text": "とても広い。"}]
[{"type": "subtitle", "time": 4981.59, "timestamp": "01:23:01", "text": "人と話す機会は何度かありましたが、彼らは"}, {"type": "subtitle", "time": 4983.83, "timestamp": "01:23:03", "text": "私を友達として見てくれるとは思えませんでした。だって、"}, {"type": "subtitle", "time": 4988.55, "timestamp": "01:23:08", "text": "アメリカ"}, {"type": "subtitle", "time": 4992.07, "timestamp": "01:23:12", "text": "やインドでは、"}, {"type": "subtitle", "time": 4994.149, "timestamp": "01:23:14", "text": "誰かと出会って気が合えば、友達になって"}, {"type": "subtitle", "time": 4997.59, "timestamp": "01:23:17", "text": "親友になるじゃないですか。"}, {"type": "subtitle", "time": 4998.87, "timestamp": "01:23:18", "text": "日本人はそうではありません"}, {"type": "subtitle", "time": 5001.27, "timestamp": "01:23:21", "text": "。"}, {"type": "subtitle", "time": 5003.35, "timestamp": "01:23:23", "text": "それに慣れる必要があります。彼らが"}, {"type": "subtitle", "time": 5005.51, "timestamp": "01:23:25", "text": "あなたに慣れる必要があるんです。何"}, {"type": "subtitle", "time": 5010.95, "timestamp": "01:23:30", "text": "ヶ月もかかるような長い時間がかかって、それからようやく、そしてようやく、そしてようやく、"}, {"type": "subtitle", "time": 5018.47, "timestamp": "01:23:38", "text": "彼らはあなたを友達として受け入れてくれるでしょう。"}, {"type": "subtitle", "time": 5024.07, "timestamp": "01:23:44", "text": "でも、私は実際にそれを見てきました。つまり、良い面もあるけれど、悪い面もあるということです"}, {"type": "subtitle", "time": 5031.669, "timestamp": "01:23:51", "text": "。ええ。"}, {"type": "subtitle", "time": 5035.11, "timestamp": "01:23:55", "text": "一方、友達を作って孤独にならないための最良の方法は、"}]
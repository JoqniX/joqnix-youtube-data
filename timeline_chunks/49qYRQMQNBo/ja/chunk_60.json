[{"type": "subtitle", "time": 3605.589, "timestamp": "01:00:05", "text": "死ぬだろう。   でも"}, {"type": "subtitle", "time": 3608.23, "timestamp": "01:00:08", "text": "、さっきも言ったように、"}, {"type": "subtitle", "time": 3610.63, "timestamp": "01:00:10", "text": "今は色々なことに立ち向かいたいんだけど、"}, {"type": "subtitle", "time": 3613.43, "timestamp": "01:00:13", "text": "僕の問題がストリーミングを妨げている理由でもあるんだ。"}, {"type": "subtitle", "time": 3622.789, "timestamp": "01:00:22", "text": "えーと、"}, {"type": "subtitle", "time": 3625.589, "timestamp": "01:00:25", "text": "時々人がくれる緑茶は美味しかった？"}, {"type": "subtitle", "time": 3629.03, "timestamp": "01:00:29", "text": "ここでは誰も私に緑茶を勧めてくれない。 緑茶を買ったのですが、美味しくありませんでした"}, {"type": "subtitle", "time": 3634.47, "timestamp": "01:00:34", "text": "。"}, {"type": "subtitle", "time": 3636.789, "timestamp": "01:00:36", "text": "私はその味が苦手です。"}, {"type": "subtitle", "time": 3652.87, "timestamp": "01:00:52", "text": "うん。 うん。 私はそれに慣れていない。"}, {"type": "subtitle", "time": 3655.43, "timestamp": "01:00:55", "text": "えっと、"}, {"type": "subtitle", "time": 3657.829, "timestamp": "01:00:57", "text": "Twitch"}, {"type": "subtitle", "time": 3659.349, "timestamp": "01:00:59", "text": "ポイントの交換も修正する必要があります。 本来は"}]
[{"type": "subtitle", "time": 6001.83, "timestamp": "01:40:01", "text": "日本語のリスニングは得意だからいいんだけど、そう、"}, {"type": "subtitle", "time": 6004.87, "timestamp": "01:40:04", "text": "アニメは"}, {"type": "subtitle", "time": 6008.39, "timestamp": "01:40:08", "text": "新しい語彙を覚えるのに役立つと思う。"}, {"type": "subtitle", "time": 6012.07, "timestamp": "01:40:12", "text": "でもアニメの語彙と実際の"}, {"type": "subtitle", "time": 6015.109, "timestamp": "01:40:15", "text": "日本語の語彙は違うから、"}, {"type": "subtitle", "time": 6018.07, "timestamp": "01:40:18", "text": "実際に経験するのは"}, {"type": "subtitle", "time": 6021.59, "timestamp": "01:40:21", "text": "近くのコンビニに行ったり、"}, {"type": "subtitle", "time": 6025.669, "timestamp": "01:40:25", "text": "日本語のネイティブスピーカーと話したりして"}, {"type": "subtitle", "time": 6028.229, "timestamp": "01:40:28", "text": "語彙を学び、"}, {"type": "subtitle", "time": 6031.109, "timestamp": "01:40:31", "text": "その単語の意味を聞いたり、"}, {"type": "subtitle", "time": 6034.07, "timestamp": "01:40:34", "text": "使い方や"}, {"type": "subtitle", "time": 6037.35, "timestamp": "01:40:37", "text": "文型などを理解することなんだ。"}, {"type": "subtitle", "time": 6057.189, "timestamp": "01:40:57", "text": "あ、Discordでライブ配信中って書いてない"}]
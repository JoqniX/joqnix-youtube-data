[{"type": "subtitle", "time": 4560.229, "timestamp": "01:16:00", "text": "曲げるのはすごく気が楽になるから。うん、"}, {"type": "subtitle", "time": 4561.83, "timestamp": "01:16:01", "text": "わかってる。"}, {"type": "subtitle", "time": 4565.11, "timestamp": "01:16:05", "text": "時々"}, {"type": "subtitle", "time": 4567.27, "timestamp": "01:16:07", "text": "N5クラスに入りたいと思うんだ。クラスは変えられない。もう"}, {"type": "subtitle", "time": 4581.43, "timestamp": "01:16:21", "text": "うん、ゼリーみたいに感じる。"}, {"type": "subtitle", "time": 4587.03, "timestamp": "01:16:27", "text": "色々なものを比べてる感じ。"}, {"type": "subtitle", "time": 4590.63, "timestamp": "01:16:30", "text": "それは悪い兆候だよね？"}, {"type": "subtitle", "time": 4592.63, "timestamp": "01:16:32", "text": "目標は"}, {"type": "subtitle", "time": 4596.31, "timestamp": "01:16:36", "text": "ここに来ること。目標は"}, {"type": "subtitle", "time": 4599.03, "timestamp": "01:16:39", "text": "日本語を勉強すること、とか。そう。ここは"}, {"type": "subtitle", "time": 4601.51, "timestamp": "01:16:41", "text": "私の夢の国。"}, {"type": "subtitle", "time": 4604.79, "timestamp": "01:16:44", "text": "一生懸命勉強しなきゃいけない、とか。うん。"}, {"type": "subtitle", "time": 4606.709, "timestamp": "01:16:46", "text": "でも心の"}, {"type": "subtitle", "time": 4610.87, "timestamp": "01:16:50", "text": "奥底では、新しい経験を求めてここに来たんだ。"}, {"type": "subtitle", "time": 4618.149, "timestamp": "01:16:58", "text": "インドでは経験したことのないような経験、"}]
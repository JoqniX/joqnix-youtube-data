[{"type": "subtitle", "time": 12788.95, "timestamp": "03:33:08", "text": "ビザが届いたからすぐに飛行機に乗らなきゃいけなくて、みんなにちゃんとさよならを言えなかったから、"}, {"type": "subtitle", "time": 12803.59, "timestamp": "03:33:23", "text": "えっと、幸せに暮らすなんて選択肢はないよ"}, {"type": "subtitle", "time": 12806.71, "timestamp": "03:33:26", "text": "。それが真実。"}, {"type": "subtitle", "time": 12809.83, "timestamp": "03:33:29", "text": "ここの労働文化が悪いのは知ってる。今やってる"}, {"type": "subtitle", "time": 12816.15, "timestamp": "03:33:36", "text": "アルバイトからもう感じてる。"}, {"type": "subtitle", "time": 12818.95, "timestamp": "03:33:38", "text": "どんな仕事がしたいの？"}, {"type": "subtitle", "time": 12821.429, "timestamp": "03:33:41", "text": "正直言うと、"}, {"type": "subtitle", "time": 12824.309, "timestamp": "03:33:44", "text": "今やってる音楽の分野で仕事がしたいんだ。"}, {"type": "subtitle", "time": 12830.07, "timestamp": "03:33:50", "text": "音楽業界の仕事か、"}, {"type": "subtitle", "time": 12833.349, "timestamp": "03:33:53", "text": "リチュービングの仕事。でも、"}, {"type": "subtitle", "time": 12836.63, "timestamp": "03:33:56", "text": "外国人だから、"}]
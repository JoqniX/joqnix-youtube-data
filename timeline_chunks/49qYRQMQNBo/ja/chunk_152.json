[{"type": "subtitle", "time": 9124.55, "timestamp": "02:32:04", "text": "よし、夕食を食べる前にザマンに行こう"}, {"type": "subtitle", "time": 9135.67, "timestamp": "02:32:15", "text": "夕食を食べる前に。ちょっと待って"}, {"type": "subtitle", "time": 9137.75, "timestamp": "02:32:17", "text": "。"}, {"type": "subtitle", "time": 9142.309, "timestamp": "02:32:22", "text": "つまり、一度だけ許可するわけじゃない。"}, {"type": "subtitle", "time": 9145.349, "timestamp": "02:32:25", "text": "大きなこととして、あるいはいつもやるべきこととして許可するわけじゃない"}, {"type": "subtitle", "time": 9149.11, "timestamp": "02:32:29", "text": "。正直に言うと、"}, {"type": "subtitle", "time": 9151.27, "timestamp": "02:32:31", "text": "ルームメイトのクインにスペースを与えて、彼の"}, {"type": "subtitle", "time": 9154.309, "timestamp": "02:32:34", "text": "時間も持てるようにしているんだけど、"}, {"type": "subtitle", "time": 9157.03, "timestamp": "02:32:37", "text": "いいことだよ。彼に"}, {"type": "subtitle", "time": 9160.23, "timestamp": "02:32:40", "text": "スペースとプライバシーを与えてあげよう。"}, {"type": "subtitle", "time": 9162.71, "timestamp": "02:32:42", "text": "私はそれを尊重し、"}, {"type": "subtitle", "time": 9166.87, "timestamp": "02:32:46", "text": "与える人間だ。そう？いや、"}, {"type": "subtitle", "time": 9172.309, "timestamp": "02:32:52", "text": "私は今、光熱費を払うはずだったお金を使って、"}]
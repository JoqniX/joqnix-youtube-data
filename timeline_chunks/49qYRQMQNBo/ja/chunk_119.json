[{"type": "subtitle", "time": 7141.109, "timestamp": "01:59:01", "text": "。うん。えっと、"}, {"type": "subtitle", "time": 7150.87, "timestamp": "01:59:10", "text": "2時間経過しました。"}, {"type": "subtitle", "time": 7153.43, "timestamp": "01:59:13", "text": "はい、正式に2時間経過しました"}, {"type": "subtitle", "time": 7156.31, "timestamp": "01:59:16", "text": "。ということで、そろそろ"}, {"type": "subtitle", "time": 7158.709, "timestamp": "01:59:18", "text": "家に帰って、"}, {"type": "subtitle", "time": 7161.35, "timestamp": "01:59:21", "text": "配信を終了したいと思います。"}, {"type": "subtitle", "time": 7165.43, "timestamp": "01:59:25", "text": "今日は色々な話題について話しました。"}, {"type": "subtitle", "time": 7169.43, "timestamp": "01:59:29", "text": "アンナ、聞いてくれてありがとう。"}, {"type": "chat", "time": 7170.821, "timestamp": "01:59:30", "author": "@chip-t9e", "avatar": "https://yt4.ggpht.com/kUzmSV9fTGltRRlDD_tgqi-V_k94_VoN8nvcWwlH6d8BXCWlBr6zHqdh8PwYTD3pJNJl3mCMeVM=s64-c-k-c0x00ffffff-no-rj", "message": "uh I heard in Fukushima 4 people got injured.. is that true?"}, {"type": "subtitle", "time": 7172.709, "timestamp": "01:59:32", "text": "そして、この配信は"}, {"type": "subtitle", "time": 7175.109, "timestamp": "01:59:35", "text": "日本語が先で"}, {"type": "subtitle", "time": 7177.27, "timestamp": "01:59:37", "text": "英語が後になる予定だったのに、"}, {"type": "subtitle", "time": 7183.43, "timestamp": "01:59:43", "text": "今日は"}, {"type": "subtitle", "time": 7186.229, "timestamp": "01:59:46", "text": "英語だけの配信になってしまってごめんなさい。本当に"}, {"type": "subtitle", "time": 7189.109, "timestamp": "01:59:49", "text": "ごめんなさい。次の配信ではそうしないようにします"}, {"type": "subtitle", "time": 7191.83, "timestamp": "01:59:51", "text": "。"}, {"type": "subtitle", "time": 7195.51, "timestamp": "01:59:55", "text": "日本の視聴者はあまり悪くないのは分かっています。"}, {"type": "subtitle", "time": 7198.629, "timestamp": "01:59:58", "text": "配信時間などは、"}]
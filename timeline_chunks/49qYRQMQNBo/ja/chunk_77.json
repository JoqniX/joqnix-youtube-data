[{"type": "subtitle", "time": 4621.75, "timestamp": "01:17:01", "text": "新しい人に会って、"}, {"type": "subtitle", "time": 4625.35, "timestamp": "01:17:05", "text": "もっともっと出かけること。"}, {"type": "subtitle", "time": 4628.149, "timestamp": "01:17:08", "text": "友達が寮から私を連れ出して、"}, {"type": "subtitle", "time": 4635.91, "timestamp": "01:17:15", "text": "買い物や食事などに出かける。"}, {"type": "subtitle", "time": 4638.87, "timestamp": "01:17:18", "text": "あなたは私を無視する。どういう意味？私はあなたが"}, {"type": "subtitle", "time": 4644.95, "timestamp": "01:17:24", "text": "提供しているすべてのメディアアプリであなたをフォローしている。あなたのメッセージを読んでいる。"}, {"type": "subtitle", "time": 4652.07, "timestamp": "01:17:32", "text": "あなたのコメントも読んでいる。でも、ええ、"}, {"type": "subtitle", "time": 4655.189, "timestamp": "01:17:35", "text": "そう。だから、そう、"}, {"type": "subtitle", "time": 4658.87, "timestamp": "01:17:38", "text": "難しい。そして、あなたは"}, {"type": "subtitle", "time": 4663.03, "timestamp": "01:17:43", "text": "私が2年間も言っていることを覚えておいてください"}, {"type": "subtitle", "time": 4664.07, "timestamp": "01:17:44", "text": "。"}, {"type": "subtitle", "time": 4668.07, "timestamp": "01:17:48", "text": "おそらく来年、クラスメートが"}, {"type": "subtitle", "time": 4670.31, "timestamp": "01:17:50", "text": "すでに卒業しているとき、彼らはすでに"}, {"type": "subtitle", "time": 4671.83, "timestamp": "01:17:51", "text": "2年生です。私は唯一の1"}, {"type": "subtitle", "time": 4673.75, "timestamp": "01:17:53", "text": "年生です。"}, {"type": "subtitle", "time": 4679.83, "timestamp": "01:17:59", "text": "2年生でも同じことが繰り返されるでしょう。来年、私と"}]
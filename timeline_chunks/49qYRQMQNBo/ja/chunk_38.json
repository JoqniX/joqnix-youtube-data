[{"type": "subtitle", "time": 2306.63, "timestamp": "00:38:26", "text": "こういう風にもっとトーク配信とかをしたいんだ"}, {"type": "subtitle", "time": 2309.99, "timestamp": "00:38:29", "text": "けど、"}, {"type": "subtitle", "time": 2311.829, "timestamp": "00:38:31", "text": "問題は"}, {"type": "subtitle", "time": 2315.349, "timestamp": "00:38:35", "text": "話題が尽きてきたってことなんだ。だから、"}, {"type": "subtitle", "time": 2319.349, "timestamp": "00:38:39", "text": "チャットにいる人、チャットに参加している人、"}, {"type": "subtitle", "time": 2321.75, "timestamp": "00:38:41", "text": "配信を聞いている人は、気軽に"}, {"type": "subtitle", "time": 2324.87, "timestamp": "00:38:44", "text": "質問したり、私と話したりしてね"}, {"type": "subtitle", "time": 2326.71, "timestamp": "00:38:46", "text": "。"}, {"type": "subtitle", "time": 2329.67, "timestamp": "00:38:49", "text": "でも、こういうのに話題を集めるのは難しいんだよね"}, {"type": "subtitle", "time": 2333.109, "timestamp": "00:38:53", "text": "。 私はこういう"}, {"type": "subtitle", "time": 2335.51, "timestamp": "00:38:55", "text": "配信をするのが大好きなんです。"}, {"type": "subtitle", "time": 2339.67, "timestamp": "00:38:59", "text": "これらは良い習慣のようなものだ。"}]
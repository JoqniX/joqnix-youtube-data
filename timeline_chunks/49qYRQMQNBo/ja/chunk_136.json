[{"type": "subtitle", "time": 8203.91, "timestamp": "02:16:43", "text": "オーケー。それで、"}, {"type": "subtitle", "time": 8208.309, "timestamp": "02:16:48", "text": "別の店に行って安いものを買うんだ。えっと、"}, {"type": "subtitle", "time": 8212.23, "timestamp": "02:16:52", "text": "何を買う？"}, {"type": "subtitle", "time": 8218.07, "timestamp": "02:16:58", "text": "400円とか200円くらいのものを買えると思う。"}, {"type": "subtitle", "time": 8219.669, "timestamp": "02:16:59", "text": "今ならセールがあるだろうし。今すぐその"}]
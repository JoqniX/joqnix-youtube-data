[{"type": "subtitle", "time": 11943.83, "timestamp": "03:19:03", "text": "ビスケットの平均的なパックだよ。ああ、うん"}, {"type": "subtitle", "time": 11945.75, "timestamp": "03:19:05", "text": "。"}, {"type": "subtitle", "time": 11949.83, "timestamp": "03:19:09", "text": "ビスケットを買うのにセブンイレブンに行かない方がいいよ。200円、198円、"}, {"type": "subtitle", "time": 11955.11, "timestamp": "03:19:15", "text": "132円もするんだ。1枚"}, {"type": "subtitle", "time": 11959.19, "timestamp": "03:19:19", "text": "168円くらいだよ。信じられる"}, {"type": "subtitle", "time": 11963.19, "timestamp": "03:19:23", "text": "？そんなに高くないよね。うん。ただ、"}, {"type": "subtitle", "time": 11966.55, "timestamp": "03:19:26", "text": "最近、"}, {"type": "subtitle", "time": 11969.429, "timestamp": "03:19:29", "text": "日本人は"}, {"type": "subtitle", "time": 11972.389, "timestamp": "03:19:32", "text": "1000円なんて大したことないと思ってるんだ。"}, {"type": "subtitle", "time": 11974.229, "timestamp": "03:19:34", "text": "東京に行ってそれを理解したよ。1回の"}, {"type": "subtitle", "time": 11978.229, "timestamp": "03:19:38", "text": "食事に1000円も使うんだ。  100"}, {"type": "subtitle", "time": 11981.429, "timestamp": "03:19:41", "text": "円。いや、ラーメン"}, {"type": "subtitle", "time": 11984.15, "timestamp": "03:19:44", "text": "屋とかラーメン屋とかうどん屋とか"}, {"type": "subtitle", "time": 11986.79, "timestamp": "03:19:46", "text": "ヤカバ屋とかで100円もするなんて、平均的な"}, {"type": "subtitle", "time": 11989.59, "timestamp": "03:19:49", "text": "日雇い労働者の100円だよ。でも、"}, {"type": "subtitle", "time": 11993.19, "timestamp": "03:19:53", "text": "インド人"}, {"type": "subtitle", "time": 11996.389, "timestamp": "03:19:56", "text": "学生の僕にとっては、1000円あれば色々なことができる"}, {"type": "subtitle", "time": 11998.55, "timestamp": "03:19:58", "text": "。"}]
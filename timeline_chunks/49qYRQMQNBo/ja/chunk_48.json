[{"type": "subtitle", "time": 2881.67, "timestamp": "00:48:01", "text": "。 ああ、大変だ。"}, {"type": "subtitle", "time": 2883.51, "timestamp": "00:48:03", "text": "Sammyを開くと、"}, {"type": "subtitle", "time": 2885.99, "timestamp": "00:48:05", "text": "昨日インストールしたばかりで、"}, {"type": "subtitle", "time": 2893.349, "timestamp": "00:48:13", "text": "デスクトップストリームをやりたかったからインストールしたんです。   ああ"}, {"type": "subtitle", "time": 2903.27, "timestamp": "00:48:23", "text": "。"}, {"type": "subtitle", "time": 2905.589, "timestamp": "00:48:25", "text": "サミーの話題を持ち出そうと思います。"}, {"type": "subtitle", "time": 2913.51, "timestamp": "00:48:33", "text": "それで、私は友人が作ったアプリを使ってストリーミング配信しているのですが、"}, {"type": "subtitle", "time": 2916.069, "timestamp": "00:48:36", "text": "この"}, {"type": "subtitle", "time": 2919.43, "timestamp": "00:48:39", "text": "アプリはシーンやソースなどの点でOBSに似ています。"}, {"type": "subtitle", "time": 2924.309, "timestamp": "00:48:44", "text": "彼は現在燃え尽き症候群で体調を崩していて、"}, {"type": "subtitle", "time": 2928.15, "timestamp": "00:48:48", "text": "他の"}, {"type": "subtitle", "time": 2931.43, "timestamp": "00:48:51", "text": "アプリケーションの開発に取り組まなければならないんです。 彼はまた、"}, {"type": "subtitle", "time": 2933.91, "timestamp": "00:48:53", "text": "ストリーム要素"}, {"type": "subtitle", "time": 2937.99, "timestamp": "00:48:57", "text": "タイプのウィジェットソフトアプリや"}]
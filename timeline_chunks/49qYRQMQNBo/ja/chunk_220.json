[{"type": "subtitle", "time": 13203.83, "timestamp": "03:40:03", "text": "ホットリングってやつにいたんです。いやいや、そうなんです。"}, {"type": "subtitle", "time": 13213.91, "timestamp": "03:40:13", "text": "先輩たちとホットリング旅行に行った時、うるさい集団をたくさん見かけました。それで、私が"}, {"type": "subtitle", "time": 13215.75, "timestamp": "03:40:15", "text": "話そうとしたら、"}, {"type": "subtitle", "time": 13217.83, "timestamp": "03:40:17", "text": "すごくうるさくて、みんながうるさい"}, {"type": "subtitle", "time": 13224.15, "timestamp": "03:40:24", "text": "音のする方を見てたんです。私は寝てたのに、彼女たちが"}, {"type": "subtitle", "time": 13226.309, "timestamp": "03:40:26", "text": "叫んだりするのを聞いて、"}, {"type": "subtitle", "time": 13228.79, "timestamp": "03:40:28", "text": "「え、誰？」って感じでした。"}, {"type": "subtitle", "time": 13232.15, "timestamp": "03:40:32", "text": "言い訳しようとしてる。いや、なんで？よし、"}, {"type": "subtitle", "time": 13256.87, "timestamp": "03:40:56", "text": "彼らのファッションセンスはどうでしょう。ああ、そうですね。"}, {"type": "subtitle", "time": 13259.83, "timestamp": "03:40:59", "text": "都道府県ごとに"}]
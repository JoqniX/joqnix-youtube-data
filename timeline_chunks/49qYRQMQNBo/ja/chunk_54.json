[{"type": "subtitle", "time": 3240.71, "timestamp": "00:54:00", "text": "うん。 うん。 うん。 土曜日と"}, {"type": "subtitle", "time": 3242.87, "timestamp": "00:54:02", "text": "日曜日なら可能です。 うん。   だから、"}, {"type": "subtitle", "time": 3257.03, "timestamp": "00:54:17", "text": "そして"}, {"type": "subtitle", "time": 3263.27, "timestamp": "00:54:23", "text": "私が知らないことの一つ。"}, {"type": "subtitle", "time": 3265.99, "timestamp": "00:54:25", "text": "言うべきかどうかわからない。 私は"}, {"type": "subtitle", "time": 3269.349, "timestamp": "00:54:29", "text": "発言に気をつけなければならない。なぜなら、私は不満をぶちまけて"}, {"type": "subtitle", "time": 3272.549, "timestamp": "00:54:32", "text": "後で自分で問題を起こしてしまうタイプだからだ"}, {"type": "subtitle", "time": 3282.549, "timestamp": "00:54:42", "text": "もっと、私はただそうしたいだけです。ええ、そうすべきですね。"}, {"type": "subtitle", "time": 3286.39, "timestamp": "00:54:46", "text": "問題は、時間が"}, {"type": "subtitle", "time": 3293.67, "timestamp": "00:54:53", "text": "最近難しいということです。インド出身の頃は、時間のことを気にしていませんでした。"}, {"type": "subtitle", "time": 3297.51, "timestamp": "00:54:57", "text": "今は、寝て、起きて、"}]
[{"type": "subtitle", "time": 12845.11, "timestamp": "03:34:05", "text": "そのためには500%も余計な努力が必要なんだ。もし僕がネイティブだったら、例えば"}, {"type": "subtitle", "time": 12848.55, "timestamp": "03:34:08", "text": "日本人だったら、"}, {"type": "subtitle", "time": 12852.55, "timestamp": "03:34:12", "text": "日本で生まれ育った日本人だったら、もっと簡単だよ。"}, {"type": "subtitle", "time": 12856.15, "timestamp": "03:34:16", "text": "経験とか"}, {"type": "subtitle", "time": 12858.55, "timestamp": "03:34:18", "text": "資格とか、試験に合格するだけでいいんだ"}, {"type": "subtitle", "time": 12896.389, "timestamp": "03:34:56", "text": "音楽学校とか、エンターテイメント"}]
[{"type": "subtitle", "time": 2584.47, "timestamp": "00:43:04", "text": "少なくとも2周はするようにしているんです。"}, {"type": "subtitle", "time": 2607.27, "timestamp": "00:43:27", "text": "、ごめん。 まるで"}, {"type": "subtitle", "time": 2609.829, "timestamp": "00:43:29", "text": "ルームメイトに何を"}, {"type": "subtitle", "time": 2612.23, "timestamp": "00:43:32", "text": "食べようかとメールを送っているみたいだった。 まるで彼が「"}, {"type": "subtitle", "time": 2615.19, "timestamp": "00:43:35", "text": "何を食べようか」と聞いてきたみたいで、うん、"}]
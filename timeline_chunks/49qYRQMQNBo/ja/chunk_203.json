[{"type": "subtitle", "time": 12181.51, "timestamp": "03:23:01", "text": "。ありがとう。"}, {"type": "subtitle", "time": 12185.269, "timestamp": "03:23:05", "text": "よし、このストロベリー"}, {"type": "subtitle", "time": 12189.59, "timestamp": "03:23:09", "text": "ミルク・ラテを食べよう。待って、ラテだ。待って、"}, {"type": "subtitle", "time": 12191.83, "timestamp": "03:23:11", "text": "ストロベリー"}, {"type": "subtitle", "time": 12198.15, "timestamp": "03:23:18", "text": "ロカ。"}, {"type": "subtitle", "time": 12202.63, "timestamp": "03:23:22", "text": "ああ、 日本でも人気があります。"}, {"type": "subtitle", "time": 12206.63, "timestamp": "03:23:26", "text": "インドではこれが大好きなんです。"}, {"type": "subtitle", "time": 12210.07, "timestamp": "03:23:30", "text": "いつも食べています。"}, {"type": "subtitle", "time": 12213.75, "timestamp": "03:23:33", "text": "オレンジ味を食べていました"}, {"type": "subtitle", "time": 12215.429, "timestamp": "03:23:35", "text": "。"}, {"type": "subtitle", "time": 12218.389, "timestamp": "03:23:38", "text": "オレンジ味。オレンジチョコパイみたいなやつ"}, {"type": "subtitle", "time": 12221.67, "timestamp": "03:23:41", "text": "。チョコレート味。それから特大"}, {"type": "subtitle", "time": 12223.67, "timestamp": "03:23:43", "text": "チョコレート味。"}, {"type": "subtitle", "time": 12226.07, "timestamp": "03:23:46", "text": "それから"}, {"type": "subtitle", "time": 12229.67, "timestamp": "03:23:49", "text": "ピスタチオ味。"}, {"type": "subtitle", "time": 12231.75, "timestamp": "03:23:51", "text": "イチゴ味があるなんて知りませんでした"}]
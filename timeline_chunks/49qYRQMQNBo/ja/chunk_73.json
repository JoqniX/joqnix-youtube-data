[{"type": "subtitle", "time": 4380.31, "timestamp": "01:13:00", "text": "またストリームで愚痴を言ったり、自分のことばかり話したりする"}, {"type": "subtitle", "time": 4383.189, "timestamp": "01:13:03", "text": "考え方を変えるべきだと思ってるんです。だって、"}, {"type": "subtitle", "time": 4390.07, "timestamp": "01:13:10", "text": "これは練習配信だし、楽しませるためにここにいるんですから。"}, {"type": "subtitle", "time": 4392.79, "timestamp": "01:13:12", "text": "話すのが恋しいです。"}, {"type": "subtitle", "time": 4395.11, "timestamp": "01:13:15", "text": "話して楽しむためにここにいるんですよね？だから、"}, {"type": "subtitle", "time": 4397.83, "timestamp": "01:13:17", "text": "何か状況を持ってきましょうか？それは私が"}, {"type": "subtitle", "time": 4400.79, "timestamp": "01:13:20", "text": "取り組むべきことです。"}, {"type": "subtitle", "time": 4413.03, "timestamp": "01:13:33", "text": "えーと、一人で"}, {"type": "subtitle", "time": 4415.99, "timestamp": "01:13:35", "text": "知るべきことがたくさんあるんです。こんなに"}, {"type": "subtitle", "time": 4419.83, "timestamp": "01:13:39", "text": "長い間配信していても、"}, {"type": "subtitle", "time": 4423.91, "timestamp": "01:13:43", "text": "勉強のことでストレスを感じます。"}, {"type": "subtitle", "time": 4426.07, "timestamp": "01:13:46", "text": "正直に言うと、ああ、わかった。"}, {"type": "subtitle", "time": 4433.669, "timestamp": "01:13:53", "text": "いいよ。ちょっと愚痴って、これで終わりにするよ。わかった。正直に言うと、"}, {"type": "subtitle", "time": 4436.55, "timestamp": "01:13:56", "text": "最悪だと思う。"}]
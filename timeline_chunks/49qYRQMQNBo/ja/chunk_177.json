[{"type": "subtitle", "time": 10622.15, "timestamp": "02:57:02", "text": "こんにちは、カキ。 オフラインにしなかったのは、"}, {"type": "subtitle", "time": 10625.83, "timestamp": "02:57:05", "text": "ルームメイトが"}, {"type": "subtitle", "time": 10628.07, "timestamp": "02:57:08", "text": "クラスメートの女の子と一緒に"}, {"type": "subtitle", "time": 10631.51, "timestamp": "02:57:11", "text": "映画を見ていて、「2時間後にできますか"}, {"type": "subtitle", "time": 10634.309, "timestamp": "02:57:14", "text": "？」と聞いてきたからです。 それで私は「うん、"}, {"type": "subtitle", "time": 10637.83, "timestamp": "02:57:17", "text": "プライバシーは守ってあげるよ。彼の幸せは嬉しい"}, {"type": "subtitle", "time": 10647.51, "timestamp": "02:57:27", "text": "私、公園に一人ぼっちなんだ」って言ったんだ。"}, {"type": "subtitle", "time": 10650.389, "timestamp": "02:57:30", "text": "ええ、彼は私と一緒に"}, {"type": "subtitle", "time": 10654.15, "timestamp": "02:57:34", "text": "インドから、私と同じ州からここに来ました。 彼は1"}, {"type": "subtitle", "time": 10657.51, "timestamp": "02:57:37", "text": "年生です。 だから"}, {"type": "subtitle", "time": 10660.95, "timestamp": "02:57:40", "text": "彼の授業はすごく楽しいんです。"}, {"type": "subtitle", "time": 10663.11, "timestamp": "02:57:43", "text": "一方、私は1年生なのに"}, {"type": "subtitle", "time": 10664.95, "timestamp": "02:57:44", "text": "2年生のクラスに入れられてしまいました"}, {"type": "subtitle", "time": 10666.95, "timestamp": "02:57:46", "text": "。 本来は"}, {"type": "subtitle", "time": 10668.63, "timestamp": "02:57:48", "text": "1年生を2年生のクラスに入れるべきではなかったのです"}, {"type": "subtitle", "time": 10671.349, "timestamp": "02:57:51", "text": "が、私は"}, {"type": "subtitle", "time": 10674.23, "timestamp": "02:57:54", "text": "日本語が得意か"}, {"type": "subtitle", "time": 10678.23, "timestamp": "02:57:58", "text": "何かで、特別な例外扱いだったんです。 彼らはそう言ったので、私は"}]
[{"type": "subtitle", "time": 6600.79, "timestamp": "01:50:00", "text": "担当者だったと"}, {"type": "subtitle", "time": 6603.91, "timestamp": "01:50:03", "text": "思いますが、"}, {"type": "subtitle", "time": 6611.83, "timestamp": "01:50:11", "text": "医療パンフレットを配っていました。「うちの"}, {"type": "subtitle", "time": 6614.87, "timestamp": "01:50:14", "text": "病院に来てください」とか「この場所でこの検査を受けてください」とか。でも、私にはくれなかったんです。"}, {"type": "subtitle", "time": 6623.51, "timestamp": "01:50:23", "text": "気づいたんですが、日本人にしか配ってないんです。"}, {"type": "subtitle", "time": 6632.709, "timestamp": "01:50:32", "text": "外国人には配ってないんです。それで、日本に来てから初めて、"}, {"type": "subtitle", "time": 6636.79, "timestamp": "01:50:36", "text": "実際に外国人"}, {"type": "subtitle", "time": 6640.31, "timestamp": "01:50:40", "text": "嫌悪とか人種差別みたいなものを見たんだなと思いました"}, {"type": "subtitle", "time": 6642.87, "timestamp": "01:50:42", "text": "。"}, {"type": "subtitle", "time": 6646.95, "timestamp": "01:50:46", "text": "東京で、その"}, {"type": "subtitle", "time": 6649.27, "timestamp": "01:50:49", "text": "場所ではなく、 私が"}, {"type": "subtitle", "time": 6652.629, "timestamp": "01:50:52", "text": "いる都道府県、あるいは私が滞在している場所など、"}, {"type": "subtitle", "time": 6656.07, "timestamp": "01:50:56", "text": "今のところは大丈夫です。"}]
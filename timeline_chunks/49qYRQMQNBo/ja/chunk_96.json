[{"type": "subtitle", "time": 5765.51, "timestamp": "01:36:05", "text": "ルームメイトについて話したいんだけど、それはプライバシーの"}, {"type": "subtitle", "time": 5767.99, "timestamp": "01:36:07", "text": "侵害だとわかっているから、言わないよ"}, {"type": "subtitle", "time": 5771.59, "timestamp": "01:36:11", "text": "。いや、君は彼を知らないし、彼の個人情報を晒したりはし"}, {"type": "subtitle", "time": 5774.79, "timestamp": "01:36:14", "text": "ない。"}, {"type": "subtitle", "time": 5776.709, "timestamp": "01:36:16", "text": "この会話について話すのは"}, {"type": "subtitle", "time": 5779.27, "timestamp": "01:36:19", "text": "プライバシーの侵害みたいなものだから、話す"}, {"type": "subtitle", "time": 5789.35, "timestamp": "01:36:29", "text": "兄弟。"}, {"type": "subtitle", "time": 5797.11, "timestamp": "01:36:37", "text": "正直言って、こういう夢とかそういうの"}, {"type": "subtitle", "time": 5800.31, "timestamp": "01:36:40", "text": "。こういうチャット配信は"}, {"type": "subtitle", "time": 5803.83, "timestamp": "01:36:43", "text": "難しいよ。だって、今は話題が変わって、"}, {"type": "subtitle", "time": 5806.39, "timestamp": "01:36:46", "text": "1時間"}, {"type": "subtitle", "time": 5809.27, "timestamp": "01:36:49", "text": "37分も何を喋っていたのかさえわからない。"}, {"type": "subtitle", "time": 5812.79, "timestamp": "01:36:52", "text": "おかしいよ。配信中ずっと何を喋っていたんだろう"}, {"type": "subtitle", "time": 5814.39, "timestamp": "01:36:54", "text": "？"}, {"type": "subtitle", "time": 5816.87, "timestamp": "01:36:56", "text": "そして今、英語の配信に入った。"}]
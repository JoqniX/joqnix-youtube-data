[{"type": "subtitle", "time": 11173.59, "timestamp": "03:06:13", "text": "語学学校を卒業後にやらなければならないこと、あるいは"}, {"type": "subtitle", "time": 11177.19, "timestamp": "03:06:17", "text": "大学や専門学校に進学することもできます"}, {"type": "subtitle", "time": 11206.23, "timestamp": "03:06:46", "text": "フルタイムの仕事には含まれていない。 それは"}, {"type": "subtitle", "time": 11208.87, "timestamp": "03:06:48", "text": "別のビザのようなものだけど、あなたはそれが必要です。"}, {"type": "subtitle", "time": 11210.71, "timestamp": "03:06:50", "text": "その時、あなたの自由時間はどうなりますか？"}, {"type": "subtitle", "time": 11212.71, "timestamp": "03:06:52", "text": "知るか？"}, {"type": "subtitle", "time": 11215.269, "timestamp": "03:06:55", "text": "私はまだ何をしたいのか決めていません。 私は"}, {"type": "subtitle", "time": 11218.15, "timestamp": "03:06:58", "text": "ここに2ヶ月前に来たばかりです。 まだたった"}]
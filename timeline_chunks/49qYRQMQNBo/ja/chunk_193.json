[{"type": "subtitle", "time": 11583.429, "timestamp": "03:13:03", "text": "東京も高いし"}, {"type": "subtitle", "time": 11585.59, "timestamp": "03:13:05", "text": "、広島も福岡も高い。それぞれに"}, {"type": "subtitle", "time": 11590.63, "timestamp": "03:13:10", "text": "値段があるよ"}, {"type": "subtitle", "time": 11593.75, "timestamp": "03:13:13", "text": "ね？"}, {"type": "subtitle", "time": 11601.51, "timestamp": "03:13:21", "text": "何もかもが無料というわけじゃない。"}, {"type": "subtitle", "time": 11605.03, "timestamp": "03:13:25", "text": "ほとんどの人は勉強や高等教育"}, {"type": "subtitle", "time": 11607.83, "timestamp": "03:13:27", "text": "よりも仕事を選びたいよね"}, {"type": "subtitle", "time": 11614.389, "timestamp": "03:13:34", "text": "？"}, {"type": "subtitle", "time": 11623.11, "timestamp": "03:13:43", "text": "人生に時間がある人は、"}, {"type": "subtitle", "time": 11624.79, "timestamp": "03:13:44", "text": "そう。うん。わかるよ。心配しないで"}, {"type": "subtitle", "time": 11628.07, "timestamp": "03:13:48", "text": "。わかるよ。重要だよ。"}, {"type": "subtitle", "time": 11632.309, "timestamp": "03:13:52", "text": "まだ選択肢を検討中なんだ。ただ、"}, {"type": "subtitle", "time": 11636.63, "timestamp": "03:13:56", "text": "日本に来るにあたって、"}, {"type": "subtitle", "time": 11639.83, "timestamp": "03:13:59", "text": "言われたこととか、"}]
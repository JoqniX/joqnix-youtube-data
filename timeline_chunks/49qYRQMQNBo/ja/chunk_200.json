[{"type": "subtitle", "time": 12008.63, "timestamp": "03:20:08", "text": "ネパールの店で鶏肉を450円で買って"}, {"type": "subtitle", "time": 12012.309, "timestamp": "03:20:12", "text": "調理して、"}, {"type": "subtitle", "time": 12019.67, "timestamp": "03:20:19", "text": "90円くらいのパック入りのサラダとか買って、卵を買って、"}, {"type": "subtitle", "time": 12022.229, "timestamp": "03:20:22", "text": "チャパティとかを"}, {"type": "subtitle", "time": 12026.229, "timestamp": "03:20:26", "text": "300円くらいで買えば、3日分のお腹を満たすことができる。つまり、"}, {"type": "subtitle", "time": 12028.229, "timestamp": "03:20:28", "text": "全部計算すれば"}, {"type": "subtitle", "time": 12034.309, "timestamp": "03:20:34", "text": "1000円以下で色々なものが買える。"}, {"type": "subtitle", "time": 12037.19, "timestamp": "03:20:37", "text": "そう、色々なものが買えるし、"}, {"type": "subtitle", "time": 12042.79, "timestamp": "03:20:42", "text": "実際僕たちはそうやって生活しているんだ。よし、人が"}, {"type": "subtitle", "time": 12046.07, "timestamp": "03:20:46", "text": "来た。この散らかったものを片付けなきゃ。この"}, {"type": "subtitle", "time": 12050.07, "timestamp": "03:20:50", "text": "カップに入ったものを全部食べなきゃ"}]
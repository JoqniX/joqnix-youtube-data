[{"type": "subtitle", "time": 11467.19, "timestamp": "03:11:07", "text": "ないんだけど、君は"}, {"type": "subtitle", "time": 11468.87, "timestamp": "03:11:08", "text": "特定の言語が得意だって自慢してるけど、"}, {"type": "subtitle", "time": 11470.15, "timestamp": "03:11:10", "text": "大局的に見ればそんなことはどうでもいい。"}, {"type": "subtitle", "time": 11471.75, "timestamp": "03:11:11", "text": "君は"}, {"type": "subtitle", "time": 11473.91, "timestamp": "03:11:13", "text": "日本の幼稚園児がやってることと同じことをしてるだけだよ。もっと詳しく"}, {"type": "subtitle", "time": 11482.469, "timestamp": "03:11:22", "text": "もし別の国に行くなら、その国の"}, {"type": "subtitle", "time": 11486.71, "timestamp": "03:11:26", "text": "言語を学ぶべきなんだ。言語を勉強するためにその"}, {"type": "subtitle", "time": 11488.95, "timestamp": "03:11:28", "text": "国に行って、"}, {"type": "subtitle", "time": 11491.75, "timestamp": "03:11:31", "text": "それから仕事に応募したり、"}, {"type": "subtitle", "time": 11493.51, "timestamp": "03:11:33", "text": "大学院に進学したり、"}, {"type": "subtitle", "time": 11495.99, "timestamp": "03:11:35", "text": "将来やりたいことをするんだ。"}, {"type": "subtitle", "time": 11498.309, "timestamp": "03:11:38", "text": "そうだろ？"}, {"type": "subtitle", "time": 11500.79, "timestamp": "03:11:40", "text": "それだけだよ。"}, {"type": "subtitle", "time": 11508.469, "timestamp": "03:11:48", "text": "いい計画を立てる必要があるよ。"}, {"type": "subtitle", "time": 11511.99, "timestamp": "03:11:51", "text": "語学学校の後はどうするの？僕はそれをやったんだ。"}, {"type": "subtitle", "time": 11514.389, "timestamp": "03:11:54", "text": "自分の計画を公に言う必要はない"}]
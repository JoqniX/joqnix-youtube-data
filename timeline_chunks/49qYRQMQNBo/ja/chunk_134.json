[{"type": "subtitle", "time": 8040.95, "timestamp": "02:14:00", "text": "じゃあ、代わりにグレープジュースを買うよ"}, {"type": "subtitle", "time": 8047.43, "timestamp": "02:14:07", "text": "。1、2、1、2"}, {"type": "subtitle", "time": 8057.99, "timestamp": "02:14:17", "text": "それから"}, {"type": "subtitle", "time": 8062.47, "timestamp": "02:14:22", "text": "チップス。チップス買おうかな？"}, {"type": "subtitle", "time": 8064.709, "timestamp": "02:14:24", "text": "あそこで買えるよ。それからオーケー。"}, {"type": "subtitle", "time": 8068.149, "timestamp": "02:14:28", "text": "チップス。あ、いや。オーケー。ねえ、知ってる？"}, {"type": "subtitle", "time": 8071.27, "timestamp": "02:14:31", "text": "ポッキーチップス。ポッキースティックス。"}, {"type": "subtitle", "time": 8074.229, "timestamp": "02:14:34", "text": "ポッキースティックス。ポッキースティックス。どっちにしようかな"}, {"type": "subtitle", "time": 8076.629, "timestamp": "02:14:36", "text": "？"}, {"type": "subtitle", "time": 8097.75, "timestamp": "02:14:57", "text": "あ、洞窟がある。"}]
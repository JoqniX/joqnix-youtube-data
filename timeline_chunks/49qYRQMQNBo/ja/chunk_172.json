[{"type": "subtitle", "time": 10320.55, "timestamp": "02:52:00", "text": "日本でカップ麺を買ったんだけど、"}, {"type": "subtitle", "time": 10323.51, "timestamp": "02:52:03", "text": "麺がすごく"}, {"type": "subtitle", "time": 10326.63, "timestamp": "02:52:06", "text": "小さくて、"}, {"type": "subtitle", "time": 10329.269, "timestamp": "02:52:09", "text": "お腹いっぱいにならないんだよね。 正直言って、"}, {"type": "subtitle", "time": 10331.19, "timestamp": "02:52:11", "text": "これは今まで手に入れた中で一番小さいカップだった"}, {"type": "subtitle", "time": 10333.67, "timestamp": "02:52:13", "text": "。"}, {"type": "subtitle", "time": 10338.07, "timestamp": "02:52:18", "text": "これで今の私のお腹は十分満たされた"}, {"type": "subtitle", "time": 10340.07, "timestamp": "02:52:20", "text": "。   一体どういうこと"}, {"type": "subtitle", "time": 10343.429, "timestamp": "02:52:23", "text": "？"}, {"type": "subtitle", "time": 10346.389, "timestamp": "02:52:26", "text": "それが日本の特徴なんです。"}, {"type": "subtitle", "time": 10348.55, "timestamp": "02:52:28", "text": "食べ物も"}, {"type": "subtitle", "time": 10350.63, "timestamp": "02:52:30", "text": "値段も何もかも日本並みで好きです。"}, {"type": "subtitle", "time": 10357.349, "timestamp": "02:52:37", "text": "ビリヤニやバスマティライスなどと比べると量が少ないように見えるが、"}, {"type": "subtitle", "time": 10362.95, "timestamp": "02:52:42", "text": "食べると"}, {"type": "subtitle", "time": 10373.99, "timestamp": "02:52:53", "text": "日も飢えていても、"}, {"type": "subtitle", "time": 10379.75, "timestamp": "02:52:59", "text": "ここではカップ麺とか軽いものを食べるだけで"}]
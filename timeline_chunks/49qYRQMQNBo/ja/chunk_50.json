[{"type": "subtitle", "time": 3004.95, "timestamp": "00:50:04", "text": "機能をお願いしたのですが、彼には私がお願いしたことをあまりたくさん詰め込んで、アプリが肥大化しすぎるのは嫌なんです。"}, {"type": "subtitle", "time": 3020.549, "timestamp": "00:50:20", "text": "ストリーム要素や他のソフトウェアアプリ、"}, {"type": "subtitle", "time": 3023.19, "timestamp": "00:50:23", "text": "ライブストリーミングアプリのように、アプリが肥大化するのは避けたいんです。ですから、この"}, {"type": "subtitle", "time": 3025.109, "timestamp": "00:50:25", "text": "ゲームは今のところシンプルにしていて、"}, {"type": "subtitle", "time": 3028.23, "timestamp": "00:50:28", "text": "バッテリー消費もそれほど多くないので、"}, {"type": "subtitle", "time": 3031.03, "timestamp": "00:50:31", "text": "良いですね。 だから、"}, {"type": "subtitle", "time": 3033.75, "timestamp": "00:50:33", "text": "彼女がその機能を追加したとき、私は"}, {"type": "subtitle", "time": 3036.549, "timestamp": "00:50:36", "text": "カメラ、つまり背面カメラを表示しようと計画しています。私は"}, {"type": "subtitle", "time": 3039.03, "timestamp": "00:50:39", "text": "日本にいるので、景色などを表示できます。これを見て、あれを見て、これを見て、あれを見て、そう、それだけです。"}, {"type": "subtitle", "time": 3049.75, "timestamp": "00:50:49", "text": "シーンソース、つまり"}, {"type": "subtitle", "time": 3052.39, "timestamp": "00:50:52", "text": "ソースの表示を非表示にすることができます。そう、"}, {"type": "subtitle", "time": 3056.87, "timestamp": "00:50:56", "text": "私が計画しているのはそれです。"}, {"type": "subtitle", "time": 3059.43, "timestamp": "00:50:59", "text": "でも、電話を常に表示して、"}]
[{"type": "subtitle", "time": 13262.79, "timestamp": "03:41:02", "text": "違います。人々のファッションセンスは"}, {"type": "subtitle", "time": 13266.63, "timestamp": "03:41:06", "text": "様々です。東京に行くと、"}, {"type": "subtitle", "time": 13270.79, "timestamp": "03:41:10", "text": "人々はとてもファッショナブルで、"}, {"type": "subtitle", "time": 13273.67, "timestamp": "03:41:13", "text": "クレイジーなファッションです。"}, {"type": "subtitle", "time": 13275.59, "timestamp": "03:41:15", "text": "インターネットのYouTubeショート動画などで見かけるような、あの"}, {"type": "subtitle", "time": 13279.349, "timestamp": "03:41:19", "text": "奇妙なファッションとクールで"}, {"type": "subtitle", "time": 13283.59, "timestamp": "03:41:23", "text": "スタイリッシュなファッションです。"}, {"type": "subtitle", "time": 13285.19, "timestamp": "03:41:25", "text": "東京ではそういうファッションが見られます。"}, {"type": "subtitle", "time": 13289.83, "timestamp": "03:41:29", "text": "一方、"}, {"type": "subtitle", "time": 13292.469, "timestamp": "03:41:32", "text": "田舎などに行くと、みんな、"}, {"type": "subtitle", "time": 13299.11, "timestamp": "03:41:39", "text": "何て言うんでしょう？"}, {"type": "subtitle", "time": 13303.19, "timestamp": "03:41:43", "text": "スタイリッシュで、とても"}, {"type": "subtitle", "time": 13306.07, "timestamp": "03:41:46", "text": "見栄えの良いスタイリッシュさです。"}, {"type": "subtitle", "time": 13312.55, "timestamp": "03:41:52", "text": "東京のような露出過多なタイプのファッションではなく、"}, {"type": "subtitle", "time": 13316.15, "timestamp": "03:41:56", "text": "もっとファッショナブルな感じです。"}, {"type": "subtitle", "time": 13317.83, "timestamp": "03:41:57", "text": "ええ。クラシックなヨーロッパ風です。ええ。ええ。ええ。"}]
[{"type": "subtitle", "time": 6437.75, "timestamp": "01:47:17", "text": "、何と言えばいいでしょうか？人々は親切です。現実を教えてください。私は今、1時間ほど現実について話しています。語学学習者の現実、私たちが知っているような生活がどれほど大変かなど。でも、そうですね"}, {"type": "subtitle", "time": 6440.39, "timestamp": "01:47:20", "text": "。日本人は、"}, {"type": "subtitle", "time": 6443.99, "timestamp": "01:47:23", "text": "面と向かって「いいえ」とか言ったりしません。"}, {"type": "subtitle", "time": 6448.55, "timestamp": "01:47:28", "text": "例えば、実際に経験した友人の話を聞いてみましょう"}, {"type": "subtitle", "time": 6459.43, "timestamp": "01:47:39", "text": "。彼は"}, {"type": "subtitle", "time": 6466.95, "timestamp": "01:47:46", "text": "私とほぼ同時期にアルバイトを始めましたが、"}, {"type": "subtitle", "time": 6470.39, "timestamp": "01:47:50", "text": "トイレに行くと"}, {"type": "subtitle", "time": 6476.47, "timestamp": "01:47:56", "text": "頻繁にトイレに行くことで叱られ、"}, {"type": "subtitle", "time": 6479.35, "timestamp": "01:47:59", "text": "謝罪文を書かなければなりませんでした。 手紙。それは大きな"}]
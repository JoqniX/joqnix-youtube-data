[{"type": "subtitle", "time": 12244.15, "timestamp": "03:24:04", "text": "ああ、すごい。すごく美味しい。"}, {"type": "subtitle", "time": 12275.19, "timestamp": "03:24:35", "text": "ある日、一箱全部食べてしまって、それ以来"}, {"type": "subtitle", "time": 12278.87, "timestamp": "03:24:38", "text": "味が嫌いになりました。ああ、ダメ。一箱全部食べちゃダメですよ"}, {"type": "subtitle", "time": 12282.389, "timestamp": "03:24:42", "text": "。"}, {"type": "subtitle", "time": 12286.15, "timestamp": "03:24:46", "text": "カロリーや糖分の多いものを摂りすぎると、もう飽きてしまうことがありますよね。ええ。"}]
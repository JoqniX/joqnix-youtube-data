[{"type": "subtitle", "time": 13144.389, "timestamp": "03:39:04", "text": "みんな静かで、今この瞬間、路上でストリーム配信をしていると、"}, {"type": "subtitle", "time": 13150.79, "timestamp": "03:39:10", "text": "私はちょっと"}, {"type": "subtitle", "time": 13152.87, "timestamp": "03:39:12", "text": "うるさいんです。"}, {"type": "subtitle", "time": 13158.63, "timestamp": "03:39:18", "text": "電車の中も地下鉄の中も。"}, {"type": "subtitle", "time": 13164.389, "timestamp": "03:39:24", "text": "誰もあまり話さないし、"}, {"type": "subtitle", "time": 13167.83, "timestamp": "03:39:27", "text": "AKガールズとか、高校生か"}, {"type": "subtitle", "time": 13169.429, "timestamp": "03:39:29", "text": "何かの女の子もいるし。東京に行った時"}, {"type": "subtitle", "time": 13172.87, "timestamp": "03:39:32", "text": "、彼女たちを見たんです。"}, {"type": "subtitle", "time": 13174.55, "timestamp": "03:39:34", "text": "本当にいるんですよ。本当に"}, {"type": "subtitle", "time": 13178.07, "timestamp": "03:39:38", "text": "。"}, {"type": "subtitle", "time": 13180.229, "timestamp": "03:39:40", "text": "大声で話したりしてました"}, {"type": "subtitle", "time": 13184.309, "timestamp": "03:39:44", "text": "。そういうのがあるんです。でも"}, {"type": "subtitle", "time": 13190.95, "timestamp": "03:39:50", "text": "全体的に"}, {"type": "subtitle", "time": 13194.15, "timestamp": "03:39:54", "text": "見て、高校時代はハイになってたみたいですね。いや、ホットリングみたいなのに、"}]
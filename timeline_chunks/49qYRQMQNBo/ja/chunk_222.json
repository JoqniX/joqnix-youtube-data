[{"type": "subtitle", "time": 13321.19, "timestamp": "03:42:01", "text": "ええ。そういうスタイルの感じです"}, {"type": "subtitle", "time": 13323.03, "timestamp": "03:42:03", "text": "。ええ。ええ。ええ。"}, {"type": "subtitle", "time": 13326.15, "timestamp": "03:42:06", "text": "今の日本では、人々は"}, {"type": "subtitle", "time": 13328.309, "timestamp": "03:42:08", "text": "好きなものを何でも着ることができます。"}, {"type": "subtitle", "time": 13335.99, "timestamp": "03:42:15", "text": "ええ。ええ。あなたは自由です。"}, {"type": "subtitle", "time": 13345.03, "timestamp": "03:42:25", "text": "髪を染めるなど、さまざまな方法で自由に表現できます。つまり、"}, {"type": "subtitle", "time": 13351.269, "timestamp": "03:42:31", "text": "あなたが"}, {"type": "subtitle", "time": 13355.99, "timestamp": "03:42:35", "text": "面接や重要な仕事の用事があるなら、"}, {"type": "subtitle", "time": 13361.19, "timestamp": "03:42:41", "text": "髪を染めてはいけません。フォーマル"}, {"type": "subtitle", "time": 13367.99, "timestamp": "03:42:47", "text": "。フォーマルですが、"}, {"type": "subtitle", "time": 13370.87, "timestamp": "03:42:50", "text": "それ以外は、"}, {"type": "subtitle", "time": 13375.11, "timestamp": "03:42:55", "text": "ええ、それ以外は、"}]
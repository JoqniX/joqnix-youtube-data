[{"type": "subtitle", "time": 12133.11, "timestamp": "03:22:13", "text": "ドルで持ってるの。外貨カードが2枚あるの"}, {"type": "subtitle", "time": 12136.71, "timestamp": "03:22:16", "text": "。1枚はINRのカードで、もう"}, {"type": "subtitle", "time": 12139.11, "timestamp": "03:22:19", "text": "1枚は外貨の"}, {"type": "subtitle", "time": 12141.91, "timestamp": "03:22:21", "text": "USD。だから、えっと、つまり、"}, {"type": "subtitle", "time": 12148.55, "timestamp": "03:22:28", "text": "家族がそれでお金を送ってきて、"}, {"type": "subtitle", "time": 12154.07, "timestamp": "03:22:34", "text": "ドルに両替してくれるの。"}, {"type": "subtitle", "time": 12156.309, "timestamp": "03:22:36", "text": "そうでしょ？"}, {"type": "subtitle", "time": 12160.71, "timestamp": "03:22:40", "text": "ATMで使って"}, {"type": "subtitle", "time": 12163.83, "timestamp": "03:22:43", "text": "現金を引き出すときは、ドルで出てくるの。そう"}, {"type": "subtitle", "time": 12167.19, "timestamp": "03:22:47", "text": "。あなたのコメントも見たわ。"}, {"type": "subtitle", "time": 12170.07, "timestamp": "03:22:50", "text": "みんなが配信してるのを見たわ。面白い。うん、"}, {"type": "subtitle", "time": 12172.07, "timestamp": "03:22:52", "text": "行く。その時食べてたから"}, {"type": "subtitle", "time": 12178.389, "timestamp": "03:22:58", "text": "に来てフォローしてくれてありがとう"}]
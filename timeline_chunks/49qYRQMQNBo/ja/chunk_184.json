[{"type": "subtitle", "time": 11041.59, "timestamp": "03:04:01", "text": "。一体何なんだ、インド人がそこら中にいるじゃないかって思ったよ。"}, {"type": "subtitle", "time": 11044.63, "timestamp": "03:04:04", "text": "これは何ですか？ ここは本当に日本なのか、それとも"}, {"type": "subtitle", "time": 11053.67, "timestamp": "03:04:13", "text": "でも、私の住んでいる地域には"}, {"type": "subtitle", "time": 11058.469, "timestamp": "03:04:18", "text": "ミャンマー、タイ、"}, {"type": "subtitle", "time": 11060.95, "timestamp": "03:04:20", "text": "バングラデシュ、パキスタン、"}, {"type": "subtitle", "time": 11065.03, "timestamp": "03:04:25", "text": "スリランカ出身の人がたくさんいます。   ここには"}, {"type": "subtitle", "time": 11073.59, "timestamp": "03:04:33", "text": "中国人も少しいます"}, {"type": "subtitle", "time": 11081.51, "timestamp": "03:04:41", "text": "ミャンマー、"}, {"type": "subtitle", "time": 11084.309, "timestamp": "03:04:44", "text": "モンゴルなど。"}, {"type": "subtitle", "time": 11086.55, "timestamp": "03:04:46", "text": "一体何をしているんだっけ？ 今、"}, {"type": "subtitle", "time": 11090.07, "timestamp": "03:04:50", "text": "公園で63円で買った変なカスタードか何かのデザートを食べてるんだ"}, {"type": "subtitle", "time": 11096.23, "timestamp": "03:04:56", "text": "。"}, {"type": "subtitle", "time": 11098.389, "timestamp": "03:04:58", "text": "私は「ああ、これはデザートだ。"}]
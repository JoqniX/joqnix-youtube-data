[{"type": "subtitle", "time": 11280.79, "timestamp": "03:08:00", "text": "。 将来的な計画がない場合、どのような範囲が"}, {"type": "subtitle", "time": 11287.349, "timestamp": "03:08:07", "text": "？ 兄弟よ、"}, {"type": "subtitle", "time": 11290.55, "timestamp": "03:08:10", "text": "聞いてくれ。 私は、"}, {"type": "subtitle", "time": 11294.95, "timestamp": "03:08:14", "text": "1年生で"}, {"type": "subtitle", "time": 11299.83, "timestamp": "03:08:19", "text": "19もの異なる大学"}, {"type": "subtitle", "time": 11301.429, "timestamp": "03:08:21", "text": "や大学、大学、"}, {"type": "subtitle", "time": 11304.07, "timestamp": "03:08:24", "text": "そして"}, {"type": "subtitle", "time": 11307.349, "timestamp": "03:08:27", "text": "サモンガに行った唯一の生徒です。それは、"}, {"type": "subtitle", "time": 11310.71, "timestamp": "03:08:30", "text": "私が2年生のクラスに入れられたからです。これは、"}, {"type": "subtitle", "time": 11318.07, "timestamp": "03:08:38", "text": "すべての生徒が"}, {"type": "subtitle", "time": 11321.19, "timestamp": "03:08:41", "text": "読んでいるように、"}, {"type": "subtitle", "time": 11325.51, "timestamp": "03:08:45", "text": "2年生または最終学年に必ず行わなければならないことです。"}, {"type": "subtitle", "time": 11330.07, "timestamp": "03:08:50", "text": "日本に来た"}, {"type": "subtitle", "time": 11335.349, "timestamp": "03:08:55", "text": "最初の月、4月にそれを始めたら、"}]
[{"type": "subtitle", "time": 6721.189, "timestamp": "01:52:01", "text": "。「インド人だから、"}, {"type": "subtitle", "time": 6723.27, "timestamp": "01:52:03", "text": "詐欺師だ」とか。 君はそれが得意で、いろいろやってるよね"}, {"type": "subtitle", "time": 6725.99, "timestamp": "01:52:05", "text": "。僕は「いや、"}, {"type": "subtitle", "time": 6728.87, "timestamp": "01:52:08", "text": "詐欺なんかやってないよ。何も知らないし、"}, {"type": "subtitle", "time": 6732.39, "timestamp": "01:52:12", "text": "コーディングも知らない。自分のやりたい"}, {"type": "subtitle", "time": 6735.03, "timestamp": "01:52:15", "text": "ことをやってる。音楽が好きだし、音楽も作ってる。"}, {"type": "subtitle", "time": 6738.709, "timestamp": "01:52:18", "text": "いろいろやるのが好きだし、配信"}, {"type": "subtitle", "time": 6741.03, "timestamp": "01:52:21", "text": "とかも好き。それだけだよ」って言った。すると"}, {"type": "subtitle", "time": 6744.07, "timestamp": "01:52:24", "text": "別のクラスメートが「"}, {"type": "subtitle", "time": 6746.149, "timestamp": "01:52:26", "text": "歌とか好きだから、"}, {"type": "subtitle", "time": 6749.51, "timestamp": "01:52:29", "text": "音楽とか好きだから」って言って、"}, {"type": "subtitle", "time": 6756.629, "timestamp": "01:52:36", "text": "顔と声のインスタグラムのリールみたいなのを送ってきたんだ。"}, {"type": "subtitle", "time": 6759.109, "timestamp": "01:52:39", "text": "顔はインド人で、声は"}, {"type": "subtitle", "time": 6762.07, "timestamp": "01:52:42", "text": "典型的なインド訛りだった。"}, {"type": "subtitle", "time": 6765.189, "timestamp": "01:52:45", "text": "僕は「"}, {"type": "subtitle", "time": 6767.99, "timestamp": "01:52:47", "text": "いや、インド訛りなんてできないよ」って言った。"}, {"type": "subtitle", "time": 6769.83, "timestamp": "01:52:49", "text": "インド訛りなんてできないし、"}]
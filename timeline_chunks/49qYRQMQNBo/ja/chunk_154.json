[{"type": "subtitle", "time": 9242.87, "timestamp": "02:34:02", "text": "写真か何かに載せるだけだ。よし。"}, {"type": "subtitle", "time": 9247.27, "timestamp": "02:34:07", "text": "待って、"}, {"type": "subtitle", "time": 9252.79, "timestamp": "02:34:12", "text": "罰金を過ぎてしまった。カップヌードルが開いていても構わない"}, {"type": "subtitle", "time": 9270.87, "timestamp": "02:34:30", "text": "ルームメイトが頼んだら、祈りを少し分けてあげる。頼まれるわけじゃ"}, {"type": "subtitle", "time": 9273.91, "timestamp": "02:34:33", "text": "ないけど。彼はプラズママンと一緒に"}, {"type": "subtitle", "time": 9278.309, "timestamp": "02:34:38", "text": "レストランで美味しい食事をしたばかりだ"}, {"type": "subtitle", "time": 9282.23, "timestamp": "02:34:42", "text": "。その間、彼は"}, {"type": "subtitle", "time": 9284.469, "timestamp": "02:34:44", "text": "私に"}, {"type": "subtitle", "time": 9288.389, "timestamp": "02:34:48", "text": "炭を食べろと言った。そして私が"}, {"type": "subtitle", "time": 9292.23, "timestamp": "02:34:52", "text": "電車に戻ったとき、彼は「ああ、"}]
[{"type": "subtitle", "time": 5522.55, "timestamp": "01:32:02", "text": "。だから私は心の底から幸せです"}, {"type": "subtitle", "time": 5526.149, "timestamp": "01:32:06", "text": "。 彼にとっては嬉しいことだ"}, {"type": "subtitle", "time": 5528.709, "timestamp": "01:32:08", "text": "けど、心の奥底では「ああ、"}, {"type": "subtitle", "time": 5531.35, "timestamp": "01:32:11", "text": "俺の"}, {"type": "subtitle", "time": 5534.39, "timestamp": "01:32:14", "text": "出番はいつ来るんだ？いつ"}, {"type": "subtitle", "time": 5537.43, "timestamp": "01:32:17", "text": "俺の出番が来るんだ？"}, {"type": "subtitle", "time": 5552.31, "timestamp": "01:32:32", "text": "」って思ってる。あ、俺たちには炊飯器とケトルとオーブンがある。うん。えっと、"}, {"type": "subtitle", "time": 5556.229, "timestamp": "01:32:36", "text": "問題は、"}, {"type": "subtitle", "time": 5559.11, "timestamp": "01:32:39", "text": "彼が料理をするから、ちゃんと"}, {"type": "subtitle", "time": 5563.189, "timestamp": "01:32:43", "text": "計量もするし、そうだろ？だから、"}, {"type": "subtitle", "time": 5565.91, "timestamp": "01:32:45", "text": "俺が"}, {"type": "subtitle", "time": 5569.189, "timestamp": "01:32:49", "text": "彼に知らせずに何か取ったり、"}, {"type": "subtitle", "time": 5570.79, "timestamp": "01:32:50", "text": "卵を取ったり、"}, {"type": "subtitle", "time": 5573.51, "timestamp": "01:32:53", "text": "ご飯を少し取ったりしたら"}, {"type": "subtitle", "time": 5575.83, "timestamp": "01:32:55", "text": "、そうだろ？知らせずに取ったら、"}, {"type": "subtitle", "time": 5578.87, "timestamp": "01:32:58", "text": "彼の計算が狂っちゃうだろ"}]
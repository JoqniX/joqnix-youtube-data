[{"type": "subtitle", "time": 7980.95, "timestamp": "02:13:00", "text": "それってどこ？"}, {"type": "subtitle", "time": 8007.83, "timestamp": "02:13:27", "text": "眠れそうにない。"}, {"type": "subtitle", "time": 8011.75, "timestamp": "02:13:31", "text": "今日は寝なきゃ。起きろよ、オリー。"}, {"type": "subtitle", "time": 8013.91, "timestamp": "02:13:33", "text": "でもルームメイトが一緒に映画を見てるんだ"}, {"type": "subtitle", "time": 8021.27, "timestamp": "02:13:41", "text": "だから、行かなきゃいけないんだ"}, {"type": "subtitle", "time": 8031.27, "timestamp": "02:13:51", "text": "ビール売り場はどこ？オーケー。えっと、ピンク"}]
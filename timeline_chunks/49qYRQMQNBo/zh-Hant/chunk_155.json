[{"type": "subtitle", "time": 9325.91, "timestamp": "02:35:25", "text": "。我說過，我上次去東京的時候，為了學校的事情，一路去了"}, {"type": "subtitle", "time": 9331.51, "timestamp": "02:35:31", "text": "東京，我去了一個遊戲"}, {"type": "subtitle", "time": 9336.389, "timestamp": "02:35:36", "text": "廳，就像那種扭蛋機，扭蛋機，就像一個擺滿了抓娃娃機和街機遊戲的商店。"}, {"type": "subtitle", "time": 9349.349, "timestamp": "02:35:49", "text": "等等。我看到那個街機遊戲機"}]
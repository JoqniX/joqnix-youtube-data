[{"type": "subtitle", "time": 6430.95, "timestamp": "01:47:10", "text": "明年大二也會一樣，和我一起來"}, {"type": "subtitle", "time": 6440.39, "timestamp": "01:47:20", "text": "日本的大一新生也會升上大二，跟我一樣。但是，嗯，我"}, {"type": "subtitle", "time": 6443.99, "timestamp": "01:47:23", "text": "沒辦法和他們成為朋友，"}, {"type": "subtitle", "time": 6446.39, "timestamp": "01:47:26", "text": "或者和他們很親近，嗯，因為在他們眼裡，我只是個新來的"}]
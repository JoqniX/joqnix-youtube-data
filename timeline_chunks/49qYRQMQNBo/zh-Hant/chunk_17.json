[{"type": "subtitle", "time": 1022.069, "timestamp": "00:17:02", "text": "。我的新"}, {"type": "subtitle", "time": 1030.23, "timestamp": "00:17:10", "text": "平台。  隆隆幣。我在"}, {"type": "subtitle", "time": 1047.029, "timestamp": "00:17:27", "text": "Rumble 上直播嗎？讓我查一下。我確實上傳了縮圖之類的東西。你們想看我的"}, {"type": "subtitle", "time": 1064.15, "timestamp": "00:17:44", "text": "Rumble頻道嗎？  什麼？"}, {"type": "subtitle", "time": 1069.19, "timestamp": "00:17:49", "text": "讓我把我的Rumble裝置拿給你。我不知道我做得對不對。真是太奇怪了。隆隆。真是太奇怪了。有一個用戶頻道，還有一個呃頻道頻道"}, {"type": "subtitle", "time": 1072.31, "timestamp": "00:17:52", "text": "。所以，我就想，呃，我該用哪一個呢？太令人困惑了。"}]
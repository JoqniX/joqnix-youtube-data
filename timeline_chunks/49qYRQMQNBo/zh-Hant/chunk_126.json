[{"type": "subtitle", "time": 7569.589, "timestamp": "02:06:09", "text": "為他感到高興"}, {"type": "subtitle", "time": 7572.229, "timestamp": "02:06:12", "text": "。"}, {"type": "subtitle", "time": 7577.27, "timestamp": "02:06:17", "text": "但是，在內心深處，我也會想，"}, {"type": "subtitle", "time": 7602.229, "timestamp": "02:06:42", "text": "我的巔峰時刻什麼時候會到來？我的巔峰時刻什麼時候才會到來"}]
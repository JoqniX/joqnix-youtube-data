[{"type": "subtitle", "time": 3721.99, "timestamp": "01:02:01", "text": "知道，我昨天才安裝它，因為我可以，因為"}, {"type": "subtitle", "time": 3728.23, "timestamp": "01:02:08", "text": "我可以"}, {"type": "subtitle", "time": 3730.39, "timestamp": "01:02:10", "text": "做我的，因為我想做我的桌面直播。  哦，春天來了。  我不知道。"}, {"type": "subtitle", "time": 3734.069, "timestamp": "01:02:14", "text": "我想聊聊薩米的話題。  永遠不要做第一人稱視角直播。"}, {"type": "subtitle", "time": 3761.829, "timestamp": "01:02:41", "text": "我現在用"}, {"type": "subtitle", "time": 3764.95, "timestamp": "01:02:44", "text": "朋友開發的直播應用，這個應用程式有點"}, {"type": "subtitle", "time": 3767.03, "timestamp": "01:02:47", "text": "像 OBS，有場景和來源之類的功能"}, {"type": "subtitle", "time": 3771.43, "timestamp": "01:02:51", "text": "。呃，他現在身心俱疲，還生病了，他得去開發其他應用程式了。他還製作了類似 Stream Elements 的小部件軟體，就像應用程式一樣。我們可以製作"}]
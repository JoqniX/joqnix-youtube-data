[{"type": "subtitle", "time": 12003.83, "timestamp": "03:20:03", "text": "杯麵。所以，我們現在要去"}, {"type": "subtitle", "time": 12008.63, "timestamp": "03:20:08", "text": "公園了。  哦，什麼？不！我的天哪！"}, {"type": "subtitle", "time": 12026.229, "timestamp": "03:20:26", "text": "如果我把這事搞砸了，我今天的晚餐就得埋進土裡了。  所以，我最好別把這事說出去"}, {"type": "subtitle", "time": 12034.309, "timestamp": "03:20:34", "text": "。"}, {"type": "subtitle", "time": 12046.07, "timestamp": "03:20:46", "text": "這個公園裡沒有桌子。去那個公園不是更好嗎？是的"}]
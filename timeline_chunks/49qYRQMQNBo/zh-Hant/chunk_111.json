[{"type": "subtitle", "time": 6660.629, "timestamp": "01:51:00", "text": "是的。我……我……我有點……我開始意識到這種情緒，嗯，"}, {"type": "subtitle", "time": 6671.189, "timestamp": "01:51:11", "text": "因為每次我去東京"}, {"type": "subtitle", "time": 6672.55, "timestamp": "01:51:12", "text": "處理一些學校的事情時，我都感覺我的"}, {"type": "subtitle", "time": 6678.629, "timestamp": "01:51:18", "text": "室友也經歷過這種感覺，"}, {"type": "subtitle", "time": 6687.51, "timestamp": "01:51:27", "text": "而我現在也面臨著同樣的情況，當你獨自一人時，你會感受到那種孤獨等等。是的"}]
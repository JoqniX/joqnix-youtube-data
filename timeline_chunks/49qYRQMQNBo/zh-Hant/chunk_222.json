[{"type": "subtitle", "time": 13321.19, "timestamp": "03:42:01", "text": "那種轉播之類的"}, {"type": "subtitle", "time": 13323.03, "timestamp": "03:42:03", "text": "。上經驗等等。你看，這些技能任何"}, {"type": "subtitle", "time": 13326.15, "timestamp": "03:42:06", "text": "人都能從網上學到"}, {"type": "subtitle", "time": 13328.309, "timestamp": "03:42:08", "text": "。以找到一份不錯的工作，比如做工作人員，或者音樂會工作人員，"}, {"type": "subtitle", "time": 13370.87, "timestamp": "03:42:50", "text": "或者其他什麼工作人員，"}, {"type": "subtitle", "time": 13375.11, "timestamp": "03:42:55", "text": "比如技術人員之類的。我不想"}]
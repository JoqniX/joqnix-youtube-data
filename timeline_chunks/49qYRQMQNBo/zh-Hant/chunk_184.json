[{"type": "subtitle", "time": 11058.469, "timestamp": "03:04:18", "text": "緬甸的學生、尼泊爾的學生、"}, {"type": "subtitle", "time": 11060.95, "timestamp": "03:04:20", "text": "孟加拉的學生和"}, {"type": "subtitle", "time": 11065.03, "timestamp": "03:04:25", "text": "巴基斯坦的學生也一樣。他們的英語都不太好。他們只會一些基本的英語，只是為了生存，而不是為了炫耀。不過他們好像會說日語。所以他們可能"}, {"type": "subtitle", "time": 11090.07, "timestamp": "03:04:50", "text": "在自己的國家上過一些課程，來這裡是"}]
[{"type": "subtitle", "time": 5834.629, "timestamp": "01:37:14", "text": "我們開始得有點晚了"}, {"type": "subtitle", "time": 5840.79, "timestamp": "01:37:20", "text": "。我"}, {"type": "subtitle", "time": 5869.59, "timestamp": "01:37:49", "text": "不能把所有事情都擱置一邊就來或出去。不行，我得履行我的責任，所有的事情都要做。所以，就是這樣。"}, {"type": "subtitle", "time": 5874.39, "timestamp": "01:37:54", "text": "不過，我可能就做完作業什麼的，然後就收拾好睡覺。我得早起。"}, {"type": "subtitle", "time": 5877.91, "timestamp": "01:37:57", "text": "呃，私人話題。"}]
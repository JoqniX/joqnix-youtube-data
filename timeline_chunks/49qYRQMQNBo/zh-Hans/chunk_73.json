[{"type": "subtitle", "time": 4380.31, "timestamp": "01:13:00", "text": "呃，因为我觉得我应该"}, {"type": "subtitle", "time": 4383.189, "timestamp": "01:13:03", "text": "改变那种在直播里发泄情绪"}, {"type": "subtitle", "time": 4387.43, "timestamp": "01:13:07", "text": "或者只是谈论自己事情的心态，因为我在"}, {"type": "subtitle", "time": 4390.07, "timestamp": "01:13:10", "text": "这里，这是个练习直播。我来"}, {"type": "subtitle", "time": 4392.79, "timestamp": "01:13:12", "text": "这里是为了娱乐大家。我想聊天。我来"}, {"type": "subtitle", "time": 4395.11, "timestamp": "01:13:15", "text": "这里是为了聊天和开心，对吧？所以，"}, {"type": "subtitle", "time": 4397.83, "timestamp": "01:13:17", "text": "我应该说点什么吗？这是"}, {"type": "subtitle", "time": 4400.79, "timestamp": "01:13:20", "text": "我需要努力的地方。"}, {"type": "subtitle", "time": 4405.27, "timestamp": "01:13:25", "text": "谢谢你之前帮我换了"}, {"type": "subtitle", "time": 4413.03, "timestamp": "01:13:33", "text": "嗯，"}, {"type": "subtitle", "time": 4415.99, "timestamp": "01:13:35", "text": "我还有很多东西要学。即使"}, {"type": "subtitle", "time": 4419.83, "timestamp": "01:13:39", "text": "我直播这么长时间，"}, {"type": "subtitle", "time": 4423.91, "timestamp": "01:13:43", "text": "我还是会因为学习而感到压力。"}, {"type": "subtitle", "time": 4426.07, "timestamp": "01:13:46", "text": "问题是现在， 说实话，哦，"}, {"type": "subtitle", "time": 4429.51, "timestamp": "01:13:49", "text": "好吧。行了。我就发泄一下，然后就"}, {"type": "subtitle", "time": 4433.669, "timestamp": "01:13:53", "text": "结束了。好吧。说实话，"}, {"type": "subtitle", "time": 4436.55, "timestamp": "01:13:56", "text": "我觉得我运气最差了，"}, {"type": "subtitle", "time": 4438.63, "timestamp": "01:13:58", "text": "感觉自己走了最糟糕的路"}]
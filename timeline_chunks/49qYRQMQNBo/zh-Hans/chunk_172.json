[{"type": "subtitle", "time": 10320.55, "timestamp": "02:52:00", "text": "在日本买了很多杯面，"}, {"type": "subtitle", "time": 10323.51, "timestamp": "02:52:03", "text": "虽然你看这些面条又"}, {"type": "subtitle", "time": 10326.63, "timestamp": "02:52:06", "text": "小又细，根本吃不饱"}, {"type": "subtitle", "time": 10329.269, "timestamp": "02:52:09", "text": "。 说实话，"}, {"type": "subtitle", "time": 10331.19, "timestamp": "02:52:11", "text": "这大概是你能买到的最小的杯子了"}, {"type": "subtitle", "time": 10333.67, "timestamp": "02:52:13", "text": "。"}, {"type": "subtitle", "time": 10338.07, "timestamp": "02:52:18", "text": "这些就足够我填饱肚子了"}, {"type": "subtitle", "time": 10340.07, "timestamp": "02:52:20", "text": "。   这到底是"}, {"type": "subtitle", "time": 10343.429, "timestamp": "02:52:23", "text": "怎么回事？"}, {"type": "subtitle", "time": 10346.389, "timestamp": "02:52:26", "text": "这就是日本的特点。"}, {"type": "subtitle", "time": 10348.55, "timestamp": "02:52:28", "text": "他们的食物像"}, {"type": "subtitle", "time": 10350.63, "timestamp": "02:52:30", "text": "日本的食物一样，价格也像日本人一样。 虽然"}, {"type": "subtitle", "time": 10354.95, "timestamp": "02:52:34", "text": "看起来比不上"}, {"type": "subtitle", "time": 10357.349, "timestamp": "02:52:37", "text": "印度香饭、巴斯马蒂米饭和"}, {"type": "subtitle", "time": 10359.59, "timestamp": "02:52:39", "text": "其他食物，"}, {"type": "subtitle", "time": 10362.95, "timestamp": "02:52:42", "text": "但吃起来却很饱"}, {"type": "subtitle", "time": 10373.99, "timestamp": "02:52:53", "text": "即使你饿了好几天，在"}, {"type": "subtitle", "time": 10379.75, "timestamp": "02:52:59", "text": "这里吃点方便面之类的清淡食物也足以"}]
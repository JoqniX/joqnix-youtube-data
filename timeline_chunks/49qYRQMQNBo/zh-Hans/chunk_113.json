[{"type": "subtitle", "time": 6782.229, "timestamp": "01:53:02", "text": "我就说了好多，后来我"}, {"type": "subtitle", "time": 6784.629, "timestamp": "01:53:04", "text": "还加了他Discord，你一直"}, {"type": "subtitle", "time": 6787.669, "timestamp": "01:53:07", "text": "给我发各种各样的视频，"}, {"type": "subtitle", "time": 6796.47, "timestamp": "01:53:16", "text": "你们到底有多少种族啊，就"}, {"type": "subtitle", "time": 6798.07, "timestamp": "01:53:18", "text": "因为我们来自不同的"}, {"type": "subtitle", "time": 6801.669, "timestamp": "01:53:21", "text": "国家？我当时真想"}, {"type": "subtitle", "time": 6805.43, "timestamp": "01:53:25", "text": "回怼他，说些蒙古种族歧视的话，"}, {"type": "subtitle", "time": 6808.31, "timestamp": "01:53:28", "text": "兄弟。但我不应该。我不是那种人。"}, {"type": "subtitle", "time": 6811.51, "timestamp": "01:53:31", "text": "但我当时真的差点就"}, {"type": "subtitle", "time": 6819.189, "timestamp": "01:53:39", "text": "但是，唉，就像……"}, {"type": "subtitle", "time": 6821.91, "timestamp": "01:53:41", "text": "来自中国的学生"}, {"type": "subtitle", "time": 6824.709, "timestamp": "01:53:44", "text": "对我很好。他们问了我很多"}, {"type": "subtitle", "time": 6827.35, "timestamp": "01:53:47", "text": "关于印度的问题，我就跟他们讲了"}, {"type": "subtitle", "time": 6830.31, "timestamp": "01:53:50", "text": "印度的一些事情。"}, {"type": "subtitle", "time": 6832.55, "timestamp": "01:53:52", "text": "总之，大多数人来自"}, {"type": "subtitle", "time": 6834.709, "timestamp": "01:53:54", "text": "不同的国家。但"}, {"type": "subtitle", "time": 6837.51, "timestamp": "01:53:57", "text": "现实是，"}]
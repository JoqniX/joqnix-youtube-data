[{"type": "subtitle", "time": 4440.229, "timestamp": "01:14:00", "text": "。"}, {"type": "subtitle", "time": 4445.03, "timestamp": "01:14:05", "text": "如果"}, {"type": "subtitle", "time": 4447.99, "timestamp": "01:14:07", "text": "我和室友一起被分到一年级"}, {"type": "subtitle", "time": 4450.149, "timestamp": "01:14:10", "text": "，"}, {"type": "subtitle", "time": 4455.669, "timestamp": "01:14:15", "text": "我肯定会很享受我的大学生活。我"}, {"type": "subtitle", "time": 4458.229, "timestamp": "01:14:18", "text": "会很享受的，真的。享受，就是那种享受"}, {"type": "subtitle", "time": 4461.59, "timestamp": "01:14:21", "text": "。享受。"}, {"type": "subtitle", "time": 4465.59, "timestamp": "01:14:25", "text": "他很享受。我压力很大，因为我在"}, {"type": "subtitle", "time": 4469.03, "timestamp": "01:14:29", "text": "二年级。我不是租房住的。"}, {"type": "subtitle", "time": 4474.149, "timestamp": "01:14:34", "text": "也许我正在慢慢适应。但是，"}, {"type": "subtitle", "time": 4477.59, "timestamp": "01:14:37", "text": "感觉就像你是一个转学生，"}, {"type": "subtitle", "time": 4481.03, "timestamp": "01:14:41", "text": "在一个大家都相处融洽的班级里，"}, {"type": "subtitle", "time": 4484.63, "timestamp": "01:14:44", "text": "你是唯一一个新生，而且"}, {"type": "subtitle", "time": 4487.51, "timestamp": "01:14:47", "text": "还没人跟你说话。"}, {"type": "subtitle", "time": 4489.99, "timestamp": "01:14:49", "text": "交朋友还是很难，"}, {"type": "subtitle", "time": 4492.229, "timestamp": "01:14:52", "text": "等等等等，"}, {"type": "subtitle", "time": 4497.99, "timestamp": "01:14:57", "text": "就是那种感觉"}]
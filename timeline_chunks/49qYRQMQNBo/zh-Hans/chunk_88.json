[{"type": "subtitle", "time": 5289.99, "timestamp": "01:28:09", "text": "好吧，我又到公园了。我就坐"}, {"type": "subtitle", "time": 5292.47, "timestamp": "01:28:12", "text": "下来聊聊。是的"}, {"type": "subtitle", "time": 5294.31, "timestamp": "01:28:14", "text": "，我们本来应该互换一下"}, {"type": "subtitle", "time": 5299.189, "timestamp": "01:28:19", "text": "，就像像我这样焦虑的人，总是过度"}, {"type": "subtitle", "time": 5303.03, "timestamp": "01:28:23", "text": "担心各种事情，"}, {"type": "subtitle", "time": 5307.51, "timestamp": "01:28:27", "text": "需要那种"}, {"type": "subtitle", "time": 5310.629, "timestamp": "01:28:30", "text": "人等等等等，对吧，"}, {"type": "subtitle", "time": 5313.91, "timestamp": "01:28:33", "text": "比如友谊之类的，这"}, {"type": "subtitle", "time": 5318.47, "timestamp": "01:28:38", "text": "很好，可以让人成长，比如"}, {"type": "subtitle", "time": 5322.31, "timestamp": "01:28:42", "text": "性格的成长和"}, {"type": "subtitle", "time": 5327.03, "timestamp": "01:28:47", "text": "提升等等。我是这么想的，"}, {"type": "subtitle", "time": 5333.669, "timestamp": "01:28:53", "text": "而且"}, {"type": "subtitle", "time": 5335.43, "timestamp": "01:28:55", "text": "目前我觉得这需要一些"}]
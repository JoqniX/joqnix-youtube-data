[{"type": "subtitle", "time": 7324.31, "timestamp": "02:02:04", "text": "他们创新和推动"}, {"type": "subtitle", "time": 7326.629, "timestamp": "02:02:06", "text": "这些东西发展的方式真是太酷了。简直疯狂，你"}, {"type": "subtitle", "time": 7328.709, "timestamp": "02:02:08", "text": "知道吗？"}, {"type": "subtitle", "time": 7332.47, "timestamp": "02:02:12", "text": "是啊。我没钱，我做不到"}, {"type": "subtitle", "time": 7335.189, "timestamp": "02:02:15", "text": "。我已经有自己的模型了。我得"}, {"type": "subtitle", "time": 7339.27, "timestamp": "02:02:19", "text": "为所有这些东西付费。我的道德"}, {"type": "subtitle", "time": 7341.27, "timestamp": "02:02:21", "text": "困境，我想我"}, {"type": "subtitle", "time": 7344.149, "timestamp": "02:02:24", "text": "在我的频道里提过好几次了。"}, {"type": "subtitle", "time": 7349.589, "timestamp": "02:02:29", "text": "那天凌晨三点，我甚至还做了个傻视频来"}, {"type": "subtitle", "time": 7355.91, "timestamp": "02:02:35", "text": "谈论这件事。是的"}, {"type": "subtitle", "time": 7363.91, "timestamp": "02:02:43", "text": "我确实希望"}, {"type": "subtitle", "time": 7366.79, "timestamp": "02:02:46", "text": "今年某个时候能推出我的新模型。我在日本。这是一个"}, {"type": "subtitle", "time": 7369.669, "timestamp": "02:02:49", "text": "新的篇章，对吧？我只有"}, {"type": "subtitle", "time": 7373.189, "timestamp": "02:02:53", "text": "完全转型成为一个以日语为主的"}, {"type": "chat", "time": 7379.658, "timestamp": "02:02:59", "author": "@chip-t9e", "avatar": "https://yt4.ggpht.com/kUzmSV9fTGltRRlDD_tgqi-V_k94_VoN8nvcWwlH6d8BXCWlBr6zHqdh8PwYTD3pJNJl3mCMeVM=s64-c-k-c0x00ffffff-no-rj", "message": "hello (I came back lol)"}]
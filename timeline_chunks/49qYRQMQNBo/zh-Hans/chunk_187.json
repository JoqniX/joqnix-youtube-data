[{"type": "subtitle", "time": 11221.429, "timestamp": "03:07:01", "text": "两个月而已。 我只是……你"}, {"type": "subtitle", "time": 11223.269, "timestamp": "03:07:03", "text": "没有特定的学位。 我将获得"}, {"type": "subtitle", "time": 11225.349, "timestamp": "03:07:05", "text": "语言学学位。"}, {"type": "subtitle", "time": 11228.55, "timestamp": "03:07:08", "text": "没有语言学位。 语言"}, {"type": "subtitle", "time": 11231.349, "timestamp": "03:07:11", "text": "证书。 这才是重点"}, {"type": "subtitle", "time": 11234.07, "timestamp": "03:07:14", "text": "。   是的"}, {"type": "subtitle", "time": 11235.59, "timestamp": "03:07:15", "text": "。"}, {"type": "subtitle", "time": 11237.75, "timestamp": "03:07:17", "text": "学历并不重要。"}, {"type": "subtitle", "time": 11240.95, "timestamp": "03:07:20", "text": "这里也有没有学位的人。"}, {"type": "subtitle", "time": 11244.15, "timestamp": "03:07:24", "text": "你的经验很重要。   是的"}, {"type": "subtitle", "time": 11245.67, "timestamp": "03:07:25", "text": "，"}, {"type": "subtitle", "time": 11253.11, "timestamp": "03:07:33", "text": "我的意思是，如果我能展现出相关的经验，我很容易就能进入一家经纪"}, {"type": "subtitle", "time": 11257.11, "timestamp": "03:07:37", "text": "公司，或者担任经理、员工之"}, {"type": "subtitle", "time": 11258.79, "timestamp": "03:07:38", "text": "类的职位"}, {"type": "subtitle", "time": 11265.51, "timestamp": "03:07:45", "text": "。"}, {"type": "subtitle", "time": 11267.91, "timestamp": "03:07:47", "text": "但我现在还不想那样做。 那是"}, {"type": "subtitle", "time": 11271.03, "timestamp": "03:07:51", "text": "备用方案。 我心中有一个目标。 我"}, {"type": "subtitle", "time": 11274.23, "timestamp": "03:07:54", "text": "会朝着这个目标努力，尽我所能。"}, {"type": "subtitle", "time": 11277.59, "timestamp": "03:07:57", "text": "但我确实对某些观点做过研究"}]
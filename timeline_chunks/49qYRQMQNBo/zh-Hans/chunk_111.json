[{"type": "subtitle", "time": 6660.629, "timestamp": "01:51:00", "text": "到目前为止，我还没有遇到过任何"}, {"type": "subtitle", "time": 6663.189, "timestamp": "01:51:03", "text": "种族歧视之类的事情。 还没呢。我"}, {"type": "subtitle", "time": 6664.87, "timestamp": "01:51:04", "text": "觉得，"}, {"type": "subtitle", "time": 6667.99, "timestamp": "01:51:07", "text": "嗯，我的学校可能会有更多"}, {"type": "subtitle", "time": 6671.189, "timestamp": "01:51:11", "text": "种族歧视或恐同现象，因为有"}, {"type": "subtitle", "time": 6672.55, "timestamp": "01:51:12", "text": "来自不同国家的语言交换生"}, {"type": "subtitle", "time": 6676.629, "timestamp": "01:51:16", "text": "，对吧？是的，我确实遇到过这种情况。"}, {"type": "subtitle", "time": 6678.629, "timestamp": "01:51:18", "text": "我的"}, {"type": "subtitle", "time": 6682.39, "timestamp": "01:51:22", "text": "蒙古同学问我：“J，"}, {"type": "subtitle", "time": 6684.47, "timestamp": "01:51:24", "text": "你会诈骗吗？”"}, {"type": "subtitle", "time": 6687.51, "timestamp": "01:51:27", "text": "我心想，兄弟，我知道印度人会被人"}, {"type": "subtitle", "time": 6690.149, "timestamp": "01:51:30", "text": "瞧不起，而且"}, {"type": "subtitle", "time": 6692.95, "timestamp": "01:51:32", "text": "网上那些诈骗，尤其是北"}, {"type": "subtitle", "time": 6696.709, "timestamp": "01:51:36", "text": "印度人，让"}, {"type": "subtitle", "time": 6699.43, "timestamp": "01:51:39", "text": "其他地区的印度人处境更糟，比如来自"}, {"type": "subtitle", "time": 6701.83, "timestamp": "01:51:41", "text": "印度其他地区的印度人，或者说印度其他一些地方的人。"}, {"type": "subtitle", "time": 6708.31, "timestamp": "01:51:48", "text": "我经常会听到那种刻板印象，那种……怎么"}, {"type": "subtitle", "time": 6715.189, "timestamp": "01:51:55", "text": "说呢，兄弟，怎么说呢"}, {"type": "subtitle", "time": 6718.39, "timestamp": "01:51:58", "text": "？那种刻板印象的评判，就是“是"}]
[{"type": "subtitle", "time": 12900.15, "timestamp": "03:35:00", "text": "学校、艺术学校、漫画学校等等，就是那种涵盖"}, {"type": "subtitle", "time": 12902.469, "timestamp": "03:35:02", "text": "所有"}, {"type": "subtitle", "time": 12904.71, "timestamp": "03:35:04", "text": "创意艺术领域的学校"}, {"type": "subtitle", "time": 12907.19, "timestamp": "03:35:07", "text": "。"}, {"type": "subtitle", "time": 12914.229, "timestamp": "03:35:14", "text": "哦，参加这些"}, {"type": "subtitle", "time": 12916.55, "timestamp": "03:35:16", "text": "试听课什么的真的很有趣。 尤其是"}, {"type": "subtitle", "time": 12919.03, "timestamp": "03:35:19", "text": "音乐方面的，真的"}, {"type": "subtitle", "time": 12923.349, "timestamp": "03:35:23", "text": "太棒了。真希望我能加入。"}, {"type": "subtitle", "time": 12925.67, "timestamp": "03:35:25", "text": "但现实总是残酷的"}, {"type": "subtitle", "time": 12929.83, "timestamp": "03:35:29", "text": "。你看，这些技能"}, {"type": "subtitle", "time": 12932.55, "timestamp": "03:35:32", "text": "任何人都能"}, {"type": "subtitle", "time": 12937.51, "timestamp": "03:35:37", "text": "从网上学到。比如说，"}, {"type": "subtitle", "time": 12939.349, "timestamp": "03:35:39", "text": "GP（通用英语口语）水平是多少？我"}, {"type": "subtitle", "time": 12942.229, "timestamp": "03:35:42", "text": "现在正在学N3。我的入门课程"}, {"type": "subtitle", "time": 12946.229, "timestamp": "03:35:46", "text": "下周五就开始了。"}, {"type": "subtitle", "time": 12949.59, "timestamp": "03:35:49", "text": "但我现在是N4水平。"}, {"type": "subtitle", "time": 12951.83, "timestamp": "03:35:51", "text": "作为一个印度人，想从零开始在日本成为公众人物？"}, {"type": "subtitle", "time": 12954.79, "timestamp": "03:35:54", "text": "兄弟，别想了。我"}]
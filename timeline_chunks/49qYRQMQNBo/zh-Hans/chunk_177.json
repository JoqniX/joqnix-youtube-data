[{"type": "subtitle", "time": 10622.15, "timestamp": "02:57:02", "text": "你好，Kaki。 我没下线是"}, {"type": "subtitle", "time": 10625.83, "timestamp": "02:57:05", "text": "因为我那该死的室友正和一个"}, {"type": "subtitle", "time": 10628.07, "timestamp": "02:57:08", "text": "女同学一起看"}, {"type": "subtitle", "time": 10631.51, "timestamp": "02:57:11", "text": "电影，他问我：“两个小时后可以吗"}, {"type": "subtitle", "time": 10634.309, "timestamp": "02:57:14", "text": "？” 我当时就想，“好的，我会给"}, {"type": "subtitle", "time": 10637.83, "timestamp": "02:57:17", "text": "你留点私人空间，兄弟。我为他感到高兴，"}, {"type": "subtitle", "time": 10647.51, "timestamp": "02:57:27", "text": "我真的一个人待在公园里。”"}, {"type": "subtitle", "time": 10650.389, "timestamp": "02:57:30", "text": "是的，他和我一起从"}, {"type": "subtitle", "time": 10654.15, "timestamp": "02:57:34", "text": "印度，来自我的同一个邦，一起来的。 他是大一新生"}, {"type": "subtitle", "time": 10657.51, "timestamp": "02:57:37", "text": "。"}, {"type": "subtitle", "time": 10660.95, "timestamp": "02:57:40", "text": "他的课太有趣了。"}, {"type": "subtitle", "time": 10663.11, "timestamp": "02:57:43", "text": "与此同时，我明明是大一新生，却被分到了大"}, {"type": "subtitle", "time": 10664.95, "timestamp": "02:57:44", "text": "二班"}, {"type": "subtitle", "time": 10666.95, "timestamp": "02:57:46", "text": "。 他们原本不应该"}, {"type": "subtitle", "time": 10668.63, "timestamp": "02:57:48", "text": "把一年级新生安排到二年级的"}, {"type": "subtitle", "time": 10671.349, "timestamp": "02:57:51", "text": "班级里，但我"}, {"type": "subtitle", "time": 10674.23, "timestamp": "02:57:54", "text": "因为日语好之类的原因，被破例了"}, {"type": "subtitle", "time": 10678.23, "timestamp": "02:57:58", "text": "。 他们说，我就想，我"}]
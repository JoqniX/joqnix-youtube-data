[{"type": "subtitle", "time": 12841.67, "timestamp": "03:34:01", "text": "必须付出五倍的努力才能做到"}, {"type": "subtitle", "time": 12845.11, "timestamp": "03:34:05", "text": "。如果我是本地人，"}, {"type": "subtitle", "time": 12848.55, "timestamp": "03:34:08", "text": "比如日本人，"}, {"type": "subtitle", "time": 12850.63, "timestamp": "03:34:10", "text": "在"}, {"type": "subtitle", "time": 12852.55, "timestamp": "03:34:12", "text": "日本出生长大，那就容易多了，"}, {"type": "subtitle", "time": 12856.15, "timestamp": "03:34:16", "text": "我只需要有经验、"}, {"type": "subtitle", "time": 12858.55, "timestamp": "03:34:18", "text": "证书或者通过"}, {"type": "subtitle", "time": 12860.229, "timestamp": "03:34:20", "text": "考试就行了。"}, {"type": "subtitle", "time": 12863.59, "timestamp": "03:34:23", "text": "但作为外国人，"}, {"type": "subtitle", "time": 12867.51, "timestamp": "03:34:27", "text": "我不仅需要经验，还"}, {"type": "subtitle", "time": 12871.429, "timestamp": "03:34:31", "text": "需要语言"}, {"type": "subtitle", "time": 12876.07, "timestamp": "03:34:36", "text": "能力，至少要达到母语水平，"}, {"type": "subtitle", "time": 12879.51, "timestamp": "03:34:39", "text": "再加上经验"}, {"type": "subtitle", "time": 12888.55, "timestamp": "03:34:48", "text": "我到处参观各种"}, {"type": "subtitle", "time": 12893.83, "timestamp": "03:34:53", "text": "学校，比如"}, {"type": "subtitle", "time": 12896.389, "timestamp": "03:34:56", "text": "音乐学校、娱乐"}]
[{"type": "subtitle", "time": 11100.79, "timestamp": "03:05:00", "text": "很甜。尝起来像"}, {"type": "subtitle", "time": 11104.309, "timestamp": "03:05:04", "text": "咖啡，而且是果冻状的。” 他们说"}, {"type": "subtitle", "time": 11109.03, "timestamp": "03:05:09", "text": "我好像在学习日语。 我"}, {"type": "subtitle", "time": 11111.429, "timestamp": "03:05:11", "text": "在一所语言学校学习。 我是一名语言"}, {"type": "subtitle", "time": 11138.23, "timestamp": "03:05:38", "text": "难道你不知道，"}, {"type": "subtitle", "time": 11141.11, "timestamp": "03:05:41", "text": "如果你想在日本从事技术工作，"}, {"type": "subtitle", "time": 11143.269, "timestamp": "03:05:43", "text": "你必须"}, {"type": "subtitle", "time": 11147.269, "timestamp": "03:05:47", "text": "去语言学校，从"}, {"type": "subtitle", "time": 11155.429, "timestamp": "03:05:55", "text": "申请"}, {"type": "subtitle", "time": 11158.07, "timestamp": "03:05:58", "text": "任何领域的工作，或者像在"}]
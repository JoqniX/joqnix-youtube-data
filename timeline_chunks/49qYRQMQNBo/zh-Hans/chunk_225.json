[{"type": "subtitle", "time": 13508.469, "timestamp": "03:45:08", "text": "相信我，服装大师比你想象的更爱你"}, {"type": "subtitle", "time": 13511.189, "timestamp": "03:45:11", "text": "。是的。"}, {"type": "subtitle", "time": 13512.95, "timestamp": "03:45:12", "text": "还有"}, {"type": "subtitle", "time": 13522.55, "timestamp": "03:45:22", "text": "不过，好吧"}, {"type": "subtitle", "time": 13525.189, "timestamp": "03:45:25", "text": "。总之，各位，"}, {"type": "subtitle", "time": 13527.83, "timestamp": "03:45:27", "text": "我们第一次直播了。我用"}, {"type": "subtitle", "time": 13531.269, "timestamp": "03:45:31", "text": "手机直播了3小时48分钟。我的"}, {"type": "subtitle", "time": 13533.59, "timestamp": "03:45:33", "text": "意思是，我以前在"}, {"type": "subtitle", "time": 13536.309, "timestamp": "03:45:36", "text": "印度也直播过，但在日本，我想这是"}, {"type": "subtitle", "time": 13540.63, "timestamp": "03:45:40", "text": "我们第一次一起在公园里吃晚饭，"}, {"type": "subtitle", "time": 13547.349, "timestamp": "03:45:47", "text": "现在公园里真的很冷。是的"}, {"type": "subtitle", "time": 13551.11, "timestamp": "03:45:51", "text": "，今天很开心。谢谢你们"}, {"type": "subtitle", "time": 13553.99, "timestamp": "03:45:53", "text": "听我说完。我知道我不应该"}, {"type": "subtitle", "time": 13556.63, "timestamp": "03:45:56", "text": "说太多英语。"}, {"type": "subtitle", "time": 13559.91, "timestamp": "03:45:59", "text": "我本来应该少说英语的，这些直播只是让"}]
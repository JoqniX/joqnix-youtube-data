[{"type": "subtitle", "time": 6600.79, "timestamp": "01:50:00", "text": "一个工作人员，我"}, {"type": "subtitle", "time": 6603.91, "timestamp": "01:50:03", "text": "猜应该是销售"}, {"type": "subtitle", "time": 6607.669, "timestamp": "01:50:07", "text": "人员，在发一些"}, {"type": "subtitle", "time": 6611.83, "timestamp": "01:50:11", "text": "宣传册，比如医疗宣传册之类的，邀请我们去"}, {"type": "subtitle", "time": 6614.87, "timestamp": "01:50:14", "text": "医院或者做个检查什么的。"}, {"type": "subtitle", "time": 6621.51, "timestamp": "01:50:21", "text": "他们没有给我，"}, {"type": "subtitle", "time": 6623.51, "timestamp": "01:50:23", "text": "我注意到他们只"}, {"type": "subtitle", "time": 6627.109, "timestamp": "01:50:27", "text": "给日本人发，"}, {"type": "subtitle", "time": 6629.59, "timestamp": "01:50:29", "text": "不给"}, {"type": "subtitle", "time": 6632.709, "timestamp": "01:50:32", "text": "外国人。我当时就想，哇，这是"}, {"type": "subtitle", "time": 6636.79, "timestamp": "01:50:36", "text": "我来到日本之后第一次真正感受到"}, {"type": "subtitle", "time": 6640.31, "timestamp": "01:50:40", "text": "种族歧视或仇外心理"}, {"type": "subtitle", "time": 6642.87, "timestamp": "01:50:42", "text": "。而且我是"}, {"type": "subtitle", "time": 6646.95, "timestamp": "01:50:46", "text": "在东京遇到的，而"}, {"type": "subtitle", "time": 6649.27, "timestamp": "01:50:49", "text": "不是在我"}, {"type": "subtitle", "time": 6652.629, "timestamp": "01:50:52", "text": "所在的县或者我住的地方"}, {"type": "subtitle", "time": 6656.07, "timestamp": "01:50:56", "text": "。"}]
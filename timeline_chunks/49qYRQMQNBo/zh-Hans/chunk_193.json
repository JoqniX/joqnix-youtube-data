[{"type": "subtitle", "time": 11583.429, "timestamp": "03:13:03", "text": "东京很贵，"}, {"type": "subtitle", "time": 11585.59, "timestamp": "03:13:05", "text": "广岛、"}, {"type": "subtitle", "time": 11587.83, "timestamp": "03:13:07", "text": "福冈"}, {"type": "subtitle", "time": 11590.63, "timestamp": "03:13:10", "text": "等等。它们也有自己的价格"}, {"type": "subtitle", "time": 11593.75, "timestamp": "03:13:13", "text": "，对吧？"}, {"type": "subtitle", "time": 11601.51, "timestamp": "03:13:21", "text": "是的，这里不是所有东西都是免费的。你"}, {"type": "subtitle", "time": 11603.11, "timestamp": "03:13:23", "text": "知道，"}, {"type": "subtitle", "time": 11605.03, "timestamp": "03:13:25", "text": "大多数人"}, {"type": "subtitle", "time": 11607.83, "timestamp": "03:13:27", "text": "会选择去工作而不是"}, {"type": "subtitle", "time": 11611.91, "timestamp": "03:13:31", "text": "学习或接受高等教育，"}, {"type": "subtitle", "time": 11614.389, "timestamp": "03:13:34", "text": "对吧？"}, {"type": "subtitle", "time": 11616.63, "timestamp": "03:13:36", "text": "有些人"}, {"type": "subtitle", "time": 11623.11, "timestamp": "03:13:43", "text": "人生中还有时间，他们会去。是的"}, {"type": "subtitle", "time": 11624.79, "timestamp": "03:13:44", "text": "。是的。我明白。别担心。"}, {"type": "subtitle", "time": 11628.07, "timestamp": "03:13:48", "text": "我明白。这很重要。"}, {"type": "subtitle", "time": 11632.309, "timestamp": "03:13:52", "text": "我还在考虑我的选择。只是"}, {"type": "subtitle", "time": 11636.63, "timestamp": "03:13:56", "text": "来到日本之后，"}, {"type": "subtitle", "time": 11639.83, "timestamp": "03:13:59", "text": "我听到的一切都和我的"}]
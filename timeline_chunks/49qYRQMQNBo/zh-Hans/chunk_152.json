[{"type": "subtitle", "time": 9124.55, "timestamp": "02:32:04", "text": "好了，现在我们去Zaman，然后……"}, {"type": "subtitle", "time": 9135.67, "timestamp": "02:32:15", "text": "我开始吃晚饭之前。"}, {"type": "subtitle", "time": 9137.75, "timestamp": "02:32:17", "text": "等等。"}, {"type": "subtitle", "time": 9142.309, "timestamp": "02:32:22", "text": "我的意思是，"}, {"type": "subtitle", "time": 9145.349, "timestamp": "02:32:25", "text": "我不会允许，但不会允许它成为一种常态"}, {"type": "subtitle", "time": 9149.11, "timestamp": "02:32:29", "text": "。说实话，"}, {"type": "subtitle", "time": 9151.27, "timestamp": "02:32:31", "text": "我是在给我的室友"}, {"type": "subtitle", "time": 9154.309, "timestamp": "02:32:34", "text": "Quinn留出空间，让他有自己的时间，你"}, {"type": "subtitle", "time": 9157.03, "timestamp": "02:32:37", "text": "知道，但这很好。让他"}, {"type": "subtitle", "time": 9160.23, "timestamp": "02:32:40", "text": "拥有自己的空间和隐私吧。"}, {"type": "subtitle", "time": 9162.71, "timestamp": "02:32:42", "text": "嗯，我会尊重并"}, {"type": "subtitle", "time": 9166.87, "timestamp": "02:32:46", "text": "给予他这些。就这样吗？不，"}, {"type": "subtitle", "time": 9172.309, "timestamp": "02:32:52", "text": "我现在用的是我们的钱，本来"}, {"type": "subtitle", "time": 9174.63, "timestamp": "02:32:54", "text": "应该用来支付"}, {"type": "subtitle", "time": 9178.389, "timestamp": "02:32:58", "text": "水电费的，现在却用来给自己买"}]
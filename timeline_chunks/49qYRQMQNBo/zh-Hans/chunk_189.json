[{"type": "subtitle", "time": 11345.349, "timestamp": "03:09:05", "text": "你做了那么多调查，去了"}, {"type": "subtitle", "time": 11351.83, "timestamp": "03:09:11", "text": "那么多学校，"}, {"type": "subtitle", "time": 11353.83, "timestamp": "03:09:13", "text": "参观了那么多校园什么的，你都开始"}, {"type": "subtitle", "time": 11358.389, "timestamp": "03:09:18", "text": "考虑毕业后要做什么了，"}, {"type": "subtitle", "time": 11360.389, "timestamp": "03:09:20", "text": "这太棒了，"}, {"type": "subtitle", "time": 11361.75, "timestamp": "03:09:21", "text": "其他学生都应该以你为"}, {"type": "subtitle", "time": 11365.349, "timestamp": "03:09:25", "text": "榜样。” 真的有"}, {"type": "subtitle", "time": 11367.349, "timestamp": "03:09:27", "text": "两位老师这么说，一位是"}, {"type": "subtitle", "time": 11369.11, "timestamp": "03:09:29", "text": "来自中国的辅导老师，一位是来自"}, {"type": "subtitle", "time": 11371.67, "timestamp": "03:09:31", "text": "卡纳塔克邦的老师，还有我的班主任也这么说。是"}, {"type": "subtitle", "time": 11377.83, "timestamp": "03:09:37", "text": "啊，这当然是好事。"}, {"type": "subtitle", "time": 11380.55, "timestamp": "03:09:40", "text": "与此同时，其他刚到日本的大一新生还在"}, {"type": "subtitle", "time": 11385.429, "timestamp": "03:09:45", "text": "学习平假名和片假名，"}, {"type": "subtitle", "time": 11389.51, "timestamp": "03:09:49", "text": "在课堂上玩得很开心，而我已经开始"}, {"type": "subtitle", "time": 11392.87, "timestamp": "03:09:52", "text": "思考未来，"}, {"type": "subtitle", "time": 11397.269, "timestamp": "03:09:57", "text": "考虑不同的发展方向了。是的，"}]
[{"type": "subtitle", "time": 7260.55, "timestamp": "02:01:00", "text": "我住的地方没受影响，所以我很"}, {"type": "subtitle", "time": 7265.75, "timestamp": "02:01:05", "text": "安全。所以，做"}, {"type": "subtitle", "time": 7268.149, "timestamp": "02:01:08", "text": "虚拟主播需要"}, {"type": "subtitle", "time": 7272.229, "timestamp": "02:01:12", "text": "美术，需要投入很多时间和"}, {"type": "subtitle", "time": 7276.149, "timestamp": "02:01:16", "text": "金钱等等。嗯，"}, {"type": "subtitle", "time": 7281.51, "timestamp": "02:01:21", "text": "我喜欢……"}, {"type": "subtitle", "time": 7283.99, "timestamp": "02:01:23", "text": "哦，对了。还有一点我想说，"}, {"type": "subtitle", "time": 7287.43, "timestamp": "02:01:27", "text": "日本人确实会用人工智能之类的东西"}, {"type": "subtitle", "time": 7290.95, "timestamp": "02:01:30", "text": "，但主要是为了提高"}, {"type": "subtitle", "time": 7293.109, "timestamp": "02:01:33", "text": "效率，"}, {"type": "subtitle", "time": 7296.39, "timestamp": "02:01:36", "text": "比如在应用程序里，或者用来"}, {"type": "subtitle", "time": 7300.149, "timestamp": "02:01:40", "text": "分析数据、监控数据等等。"}, {"type": "subtitle", "time": 7302.55, "timestamp": "02:01:42", "text": "这些东西"}, {"type": "subtitle", "time": 7305.189, "timestamp": "02:01:45", "text": "真的很好用。"}, {"type": "subtitle", "time": 7307.43, "timestamp": "02:01:47", "text": "最近，在日本的"}, {"type": "subtitle", "time": 7309.589, "timestamp": "02:01:49", "text": "主播圈和虚拟主播"}, {"type": "subtitle", "time": 7312.07, "timestamp": "02:01:52", "text": "圈里，很多创作者都在用人工智能。 比如"}, {"type": "subtitle", "time": 7315.75, "timestamp": "02:01:55", "text": "用人工智能来开发 OBS 的直播工具、"}, {"type": "subtitle", "time": 7318.87, "timestamp": "02:01:58", "text": "插件、小部件之类的，"}]
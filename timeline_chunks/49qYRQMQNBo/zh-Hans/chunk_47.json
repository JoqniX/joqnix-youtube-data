[{"type": "subtitle", "time": 2821.349, "timestamp": "00:47:01", "text": "你一切都好。"}, {"type": "subtitle", "time": 2823.75, "timestamp": "00:47:03", "text": "希望你一切都好。"}, {"type": "subtitle", "time": 2826.55, "timestamp": "00:47:06", "text": "我最近在新笔记本电脑上安装了Sammy系统，"}, {"type": "subtitle", "time": 2836.309, "timestamp": "00:47:16", "text": "现在回头看看我以前的东西，"}, {"type": "subtitle", "time": 2838.15, "timestamp": "00:47:18", "text": "比如这套复杂的系统以及"}, {"type": "subtitle", "time": 2840.55, "timestamp": "00:47:20", "text": "我以前做的一切，"}, {"type": "subtitle", "time": 2843.349, "timestamp": "00:47:23", "text": "感觉"}, {"type": "subtitle", "time": 2846.47, "timestamp": "00:47:26", "text": "现在更轻松自在一些。 您好，Gate。 是的。 享受。"}, {"type": "subtitle", "time": 2849.67, "timestamp": "00:47:29", "text": "看着我以前做的东西，"}, {"type": "subtitle", "time": 2852.55, "timestamp": "00:47:32", "text": "比如云工厂、"}, {"type": "subtitle", "time": 2857.43, "timestamp": "00:47:37", "text": "网站之类的，真是"}, {"type": "subtitle", "time": 2863.829, "timestamp": "00:47:43", "text": "头疼，感觉头都疼了。"}, {"type": "subtitle", "time": 2865.43, "timestamp": "00:47:45", "text": "我不知道该怎么形容这种感觉，是"}, {"type": "subtitle", "time": 2867.91, "timestamp": "00:47:47", "text": "啊，我看着它们，"}, {"type": "subtitle", "time": 2871.349, "timestamp": "00:47:51", "text": "感觉就像“我的天哪，我当时为什么要做这些”"}, {"type": "subtitle", "time": 2878.71, "timestamp": "00:47:58", "text": "因为……"}]
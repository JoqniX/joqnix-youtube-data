[{"type": "subtitle", "time": 8507.59, "timestamp": "02:21:47", "text": "我的天哪。Awoki Kusuri 关门了。"}, {"type": "subtitle", "time": 8509.83, "timestamp": "02:21:49", "text": "好吧，"}, {"type": "subtitle", "time": 8513.19, "timestamp": "02:21:53", "text": "我刚才看到它关门了，去"}, {"type": "subtitle", "time": 8516.55, "timestamp": "02:21:56", "text": "关灯了。如果真是这样，那倒是能"}]
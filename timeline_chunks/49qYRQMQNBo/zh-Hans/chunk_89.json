[{"type": "subtitle", "time": 5344.79, "timestamp": "01:29:04", "text": "是的，我之所以在聊天时说出来，是因为……"}, {"type": "subtitle", "time": 5362.07, "timestamp": "01:29:22", "text": "以后的直播里都不要再提了。"}, {"type": "subtitle", "time": 5364.709, "timestamp": "01:29:24", "text": "我知道我这人爱唠叨、爱"}, {"type": "subtitle", "time": 5369.11, "timestamp": "01:29:29", "text": "发泄，你们也都知道。"}, {"type": "subtitle", "time": 5371.43, "timestamp": "01:29:31", "text": "有时候我会"}, {"type": "subtitle", "time": 5373.99, "timestamp": "01:29:33", "text": "说一些平时不该说的话，比如"}, {"type": "subtitle", "time": 5378.149, "timestamp": "01:29:38", "text": "我太天真了，天哪等等。"}, {"type": "subtitle", "time": 5384.629, "timestamp": "01:29:44", "text": "我会尽量少聊"}, {"type": "subtitle", "time": 5397.27, "timestamp": "01:29:57", "text": "实话，感觉就像……"}, {"type": "subtitle", "time": 5399.59, "timestamp": "01:29:59", "text": "你记得放松一下吗？嗯，"}]
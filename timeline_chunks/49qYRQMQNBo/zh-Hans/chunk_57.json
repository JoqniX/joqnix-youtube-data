[{"type": "subtitle", "time": 3422.069, "timestamp": "00:57:02", "text": "无论我脑子里想的是什么，无论我"}, {"type": "chat", "time": 3425.385, "timestamp": "00:57:05", "author": "@ProjectAizen", "avatar": "https://yt4.ggpht.com/J4g8YNWAMR7duRA_MC0DvcSZYNpONwi8eZHcWl3kui9q7oBp930GwOoPZ17Ct3rJcBQWDIsOKA=s64-c-k-c0x00ffffff-no-rj", "message": "You know... regardless of the time... I am always awake. Just checking in... wise tip from a person (me) who's currently in Shinagawa for an investor meet... Keep 2 seperate clocks for India & Japan"}, {"type": "subtitle", "time": 3430.23, "timestamp": "00:57:10", "text": "脑子里想的是什么，如果我把它大声地通过直播表达出来"}, {"type": "subtitle", "time": 3433.589, "timestamp": "00:57:13", "text": "，那东西都必须用"}, {"type": "subtitle", "time": 3436.15, "timestamp": "00:57:16", "text": "日语说出来。 我现在很清楚我用"}, {"type": "subtitle", "time": 3439.03, "timestamp": "00:57:19", "text": "英语进行的思考过程。"}, {"type": "subtitle", "time": 3442.39, "timestamp": "00:57:22", "text": "是的，我应该学习如何将我的"}, {"type": "subtitle", "time": 3446.309, "timestamp": "00:57:26", "text": "想法从英语翻译成日语，然后"}, {"type": "subtitle", "time": 3449.03, "timestamp": "00:57:29", "text": "大声说出来。"}, {"type": "subtitle", "time": 3453.75, "timestamp": "00:57:33", "text": "准备两套不同的衣服，一套去印度，一套去"}, {"type": "subtitle", "time": 3456.069, "timestamp": "00:57:36", "text": "日本。 你好"}, {"type": "subtitle", "time": 3465.829, "timestamp": "00:57:45", "text": "想了解一下"}]
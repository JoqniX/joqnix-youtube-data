[{"type": "subtitle", "time": 6840.47, "timestamp": "01:54:00", "text": "我们"}, {"type": "subtitle", "time": 6844.55, "timestamp": "01:54:04", "text": "从小在学校就被教育说英语是"}, {"type": "subtitle", "time": 6846.629, "timestamp": "01:54:06", "text": "世界通用语言，每个国家的"}, {"type": "subtitle", "time": 6848.709, "timestamp": "01:54:08", "text": "人都在用英语，对"}, {"type": "subtitle", "time": 6850.39, "timestamp": "01:54:10", "text": "吧？英语很重要，对吧？"}, {"type": "subtitle", "time": 6852.79, "timestamp": "01:54:12", "text": "我从小学"}, {"type": "subtitle", "time": 6855.83, "timestamp": "01:54:15", "text": "一年级、二年级、"}, {"type": "subtitle", "time": 6859.03, "timestamp": "01:54:19", "text": "初中、高中等等都是这么学的。"}, {"type": "subtitle", "time": 6861.91, "timestamp": "01:54:21", "text": "但是我来到这里之后，并不是每个人都会"}, {"type": "subtitle", "time": 6863.99, "timestamp": "01:54:23", "text": "说英语。"}, {"type": "subtitle", "time": 6865.91, "timestamp": "01:54:25", "text": "中国的学生不会说英语。"}, {"type": "subtitle", "time": 6867.35, "timestamp": "01:54:27", "text": "斯里兰卡的学生不会说"}, {"type": "subtitle", "time": 6869.109, "timestamp": "01:54:29", "text": "英语。蒙古的学生不会"}, {"type": "subtitle", "time": 6871.35, "timestamp": "01:54:31", "text": "说英语。缅甸的学生、"}, {"type": "subtitle", "time": 6876.87, "timestamp": "01:54:36", "text": "尼泊尔的学生、"}, {"type": "subtitle", "time": 6880.55, "timestamp": "01:54:40", "text": "孟加拉国的学生和巴基斯坦的学生也一样。他们的"}, {"type": "subtitle", "time": 6883.669, "timestamp": "01:54:43", "text": "英语都不太好。"}, {"type": "subtitle", "time": 6887.35, "timestamp": "01:54:47", "text": "他们只会一些基本的英语，只是"}, {"type": "subtitle", "time": 6891.99, "timestamp": "01:54:51", "text": "为了生存，而不是为了炫耀。"}, {"type": "subtitle", "time": 6897.83, "timestamp": "01:54:57", "text": "不过他们好像会说日语。所以他们可能"}, {"type": "subtitle", "time": 6899.669, "timestamp": "01:54:59", "text": "在自己的国家上过一些课程，"}]
[{"type": "subtitle", "time": 11041.59, "timestamp": "03:04:01", "text": "这到底是怎么回事，到处都是印度人。"}, {"type": "subtitle", "time": 11044.63, "timestamp": "03:04:04", "text": "这是什么？ 我真的在日本吗？还是"}, {"type": "subtitle", "time": 11053.67, "timestamp": "03:04:13", "text": "，在我住的地方有很多"}, {"type": "subtitle", "time": 11058.469, "timestamp": "03:04:18", "text": "来自缅甸、泰国、"}, {"type": "subtitle", "time": 11060.95, "timestamp": "03:04:20", "text": "孟加拉国、巴基斯坦、"}, {"type": "subtitle", "time": 11065.03, "timestamp": "03:04:25", "text": "斯里兰卡的人，这里的人比较多。"}, {"type": "subtitle", "time": 11073.59, "timestamp": "03:04:33", "text": "一些中国"}, {"type": "subtitle", "time": 11081.51, "timestamp": "03:04:41", "text": "缅甸、"}, {"type": "subtitle", "time": 11084.309, "timestamp": "03:04:44", "text": "蒙古等等，"}, {"type": "subtitle", "time": 11086.55, "timestamp": "03:04:46", "text": "你们又在搞什么鬼？ 我现在正"}, {"type": "subtitle", "time": 11090.07, "timestamp": "03:04:50", "text": "坐在公园里吃着这道奇怪的甜点，或者"}, {"type": "subtitle", "time": 11093.99, "timestamp": "03:04:53", "text": "不管它是什么，反正我花了"}, {"type": "subtitle", "time": 11096.23, "timestamp": "03:04:56", "text": "63日元买的。"}, {"type": "subtitle", "time": 11098.389, "timestamp": "03:04:58", "text": "我当时想，“哦，原来是甜点。它"}]
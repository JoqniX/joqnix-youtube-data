[{"type": "subtitle", "time": 12782.07, "timestamp": "03:33:02", "text": "我当时没多少时间"}, {"type": "subtitle", "time": 12785.51, "timestamp": "03:33:05", "text": "跟人道别，也没时间尽快"}, {"type": "subtitle", "time": 12788.95, "timestamp": "03:33:08", "text": "赶飞机，因为签证马上就到了"}, {"type": "subtitle", "time": 12791.269, "timestamp": "03:33:11", "text": "等等。所以我没能"}, {"type": "subtitle", "time": 12803.59, "timestamp": "03:33:23", "text": "嗯，快乐地生活对你来说可能不是一个选项"}, {"type": "subtitle", "time": 12806.71, "timestamp": "03:33:26", "text": "。这就是事实。我知道"}, {"type": "subtitle", "time": 12809.83, "timestamp": "03:33:29", "text": "这里的工作文化很糟糕。"}, {"type": "subtitle", "time": 12812.389, "timestamp": "03:33:32", "text": "我已经能感受到了。"}, {"type": "subtitle", "time": 12816.15, "timestamp": "03:33:36", "text": "我现在做的是兼职。"}, {"type": "subtitle", "time": 12818.95, "timestamp": "03:33:38", "text": "你心里想找什么样的工作？"}, {"type": "subtitle", "time": 12821.429, "timestamp": "03:33:41", "text": "说实话，我想找一份跟"}, {"type": "subtitle", "time": 12824.309, "timestamp": "03:33:44", "text": "我现在从事的领域相关的工作，"}, {"type": "subtitle", "time": 12826.87, "timestamp": "03:33:46", "text": "要么是音乐方面的，要么是"}, {"type": "subtitle", "time": 12830.07, "timestamp": "03:33:50", "text": "音乐行业的工作，要么就是那种"}, {"type": "subtitle", "time": 12833.349, "timestamp": "03:33:53", "text": "转播之类的。"}, {"type": "subtitle", "time": 12836.63, "timestamp": "03:33:56", "text": "问题是，现在作为外国人，我"}]
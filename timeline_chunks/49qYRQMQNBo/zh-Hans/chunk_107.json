[{"type": "subtitle", "time": 6423.669, "timestamp": "01:47:03", "text": "我说说现实吧。我已经说了差不多"}, {"type": "subtitle", "time": 6427.27, "timestamp": "01:47:07", "text": "一个"}, {"type": "subtitle", "time": 6430.95, "timestamp": "01:47:10", "text": "小时的现实了。比如"}, {"type": "subtitle", "time": 6432.95, "timestamp": "01:47:12", "text": "语言学习的现实，以及"}, {"type": "subtitle", "time": 6437.75, "timestamp": "01:47:17", "text": "我们所知道的生活有多艰难等等。好吧"}, {"type": "subtitle", "time": 6440.39, "timestamp": "01:47:20", "text": "。日本人"}, {"type": "subtitle", "time": 6443.99, "timestamp": "01:47:23", "text": "不会当面说“不行”之类的，举个"}, {"type": "subtitle", "time": 6448.55, "timestamp": "01:47:28", "text": "例子，我来分享一下我朋友的亲身"}, {"type": "subtitle", "time": 6451.03, "timestamp": "01:47:31", "text": "经历"}, {"type": "subtitle", "time": 6459.43, "timestamp": "01:47:39", "text": "。他和我差不多同时找到了一份"}, {"type": "subtitle", "time": 6463.43, "timestamp": "01:47:43", "text": "兼职，"}, {"type": "subtitle", "time": 6470.39, "timestamp": "01:47:50", "text": "他做的一件事就是上厕所，结果因为"}, {"type": "subtitle", "time": 6476.47, "timestamp": "01:47:56", "text": "频繁上厕所被训斥了，还得写"}, {"type": "subtitle", "time": 6479.35, "timestamp": "01:47:59", "text": "道歉信。事情闹得挺大的，"}]
[{"type": "subtitle", "time": 3300.71, "timestamp": "00:55:00", "text": "起床、直播、做各种事情、浪费时间"}, {"type": "subtitle", "time": 3303.829, "timestamp": "00:55:03", "text": "等等等等。而现在我开始"}, {"type": "subtitle", "time": 3306.79, "timestamp": "00:55:06", "text": "理解时间的价值，以及"}, {"type": "subtitle", "time": 3310.23, "timestamp": "00:55:10", "text": "时间是多么宝贵。"}, {"type": "subtitle", "time": 3316.71, "timestamp": "00:55:16", "text": "所以，我确实有很多后悔的"}, {"type": "subtitle", "time": 3320.309, "timestamp": "00:55:20", "text": "事情，比如我以前在"}, {"type": "subtitle", "time": 3324.23, "timestamp": "00:55:24", "text": "印度做的事情，或者我的生活方式等等。但是，"}, {"type": "subtitle", "time": 3330.71, "timestamp": "00:55:30", "text": "嗯，我觉得这周"}, {"type": "subtitle", "time": 3332.79, "timestamp": "00:55:32", "text": "我可能会继续做这种"}, {"type": "subtitle", "time": 3335.589, "timestamp": "00:55:35", "text": "日常直播之类的，只要有时间就去做"}, {"type": "subtitle", "time": 3338.39, "timestamp": "00:55:38", "text": "。 但我不该像这样完全用"}, {"type": "subtitle", "time": 3341.03, "timestamp": "00:55:41", "text": "英语说话。 这不是"}, {"type": "subtitle", "time": 3343.349, "timestamp": "00:55:43", "text": "直播的重点。 现在"}]
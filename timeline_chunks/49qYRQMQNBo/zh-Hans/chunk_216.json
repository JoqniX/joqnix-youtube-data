[{"type": "subtitle", "time": 12960.79, "timestamp": "03:36:00", "text": "知道这不可能。是啊。"}, {"type": "subtitle", "time": 12963.75, "timestamp": "03:36:03", "text": "我的意思是，你仍然可以找到一份不错的"}, {"type": "subtitle", "time": 12968.15, "timestamp": "03:36:08", "text": "工作，比如做工作人员，或者"}, {"type": "subtitle", "time": 12976.07, "timestamp": "03:36:16", "text": "音乐会工作人员，或者其他什么工作人员，比如"}, {"type": "subtitle", "time": 12979.67, "timestamp": "03:36:19", "text": "技术人员之类的。如果"}, {"type": "subtitle", "time": 12982.15, "timestamp": "03:36:22", "text": "我要去参加"}, {"type": "subtitle", "time": 12984.309, "timestamp": "03:36:24", "text": "音乐会或者那种"}, {"type": "subtitle", "time": 12986.87, "timestamp": "03:36:26", "text": "娱乐节目，那也是"}, {"type": "subtitle", "time": 12990.389, "timestamp": "03:36:30", "text": "我的备选方案之一。"}, {"type": "subtitle", "time": 12994.469, "timestamp": "03:36:34", "text": "如果我不能成为艺人什么的，"}, {"type": "subtitle", "time": 12996.71, "timestamp": "03:36:36", "text": "那就取决于"}, {"type": "subtitle", "time": 12999.11, "timestamp": "03:36:39", "text": "机会，以及我想做什么，我"}, {"type": "subtitle", "time": 13003.75, "timestamp": "03:36:43", "text": "想看什么，我想做什么，我不想"}, {"type": "subtitle", "time": 13007.19, "timestamp": "03:36:47", "text": "做什么。我觉得自己还很年轻，"}, {"type": "subtitle", "time": 13009.59, "timestamp": "03:36:49", "text": "甚至日本人都以为我只有"}, {"type": "subtitle", "time": 13016.15, "timestamp": "03:36:56", "text": "我的声音和外貌，"}]
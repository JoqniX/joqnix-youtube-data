[{"type": "subtitle", "time": 5762.629, "timestamp": "01:36:02", "text": "，但是，呃，我想聊聊"}, {"type": "subtitle", "time": 5765.51, "timestamp": "01:36:05", "text": "室友的事，但我知道这"}, {"type": "subtitle", "time": 5767.99, "timestamp": "01:36:07", "text": "侵犯隐私，所以我不会说"}, {"type": "subtitle", "time": 5771.59, "timestamp": "01:36:11", "text": "。就像，你不认识他，"}, {"type": "subtitle", "time": 5774.79, "timestamp": "01:36:14", "text": "我不会人肉搜索他什么的。我"}, {"type": "subtitle", "time": 5776.709, "timestamp": "01:36:16", "text": "谈论这段对话就像"}, {"type": "subtitle", "time": 5779.27, "timestamp": "01:36:19", "text": "侵犯隐私，所以我还是说"}, {"type": "subtitle", "time": 5803.83, "timestamp": "01:36:43", "text": "兄弟。我不能，但说实话，这些梦境之类的。像这样聊天直播真的很难，伙计。因为现在的话题，我甚"}, {"type": "subtitle", "time": 5806.39, "timestamp": "01:36:46", "text": "至不知道我刚才在胡扯了1小时"}, {"type": "subtitle", "time": 5809.27, "timestamp": "01:36:49", "text": "37分钟。太"}, {"type": "subtitle", "time": 5812.79, "timestamp": "01:36:52", "text": "疯狂了。我整个"}, {"type": "subtitle", "time": 5814.39, "timestamp": "01:36:54", "text": "直播都在说什么？"}, {"type": "subtitle", "time": 5816.87, "timestamp": "01:36:56", "text": "然后我切换到英语直播了。我"}]
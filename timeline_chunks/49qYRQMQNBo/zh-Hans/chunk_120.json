[{"type": "subtitle", "time": 7201.43, "timestamp": "02:00:01", "text": "呃，大多数人都要工作或者"}, {"type": "subtitle", "time": 7204.07, "timestamp": "02:00:04", "text": "忙，或者他们要"}, {"type": "subtitle", "time": 7206.709, "timestamp": "02:00:06", "text": "睡觉等等。我在日本，所以我知道，对吧？"}, {"type": "subtitle", "time": 7211.27, "timestamp": "02:00:11", "text": "作为外国人，我理解"}, {"type": "subtitle", "time": 7214.229, "timestamp": "02:00:14", "text": "日本人非常守时，他们"}, {"type": "subtitle", "time": 7217.51, "timestamp": "02:00:17", "text": "早睡早起等等。他们必须早起工作"}, {"type": "subtitle", "time": 7221.03, "timestamp": "02:00:21", "text": "等等。他们吃得少"}, {"type": "subtitle", "time": 7222.87, "timestamp": "02:00:22", "text": "等等。"}, {"type": "subtitle", "time": 7225.35, "timestamp": "02:00:25", "text": "但是，"}, {"type": "subtitle", "time": 7226.79, "timestamp": "02:00:26", "text": "呃，也许你可以把你的频道"}, {"type": "subtitle", "time": 7228.55, "timestamp": "02:00:28", "text": "表情换成更多日语版本。"}, {"type": "subtitle", "time": 7230.79, "timestamp": "02:00:30", "text": "是的，我可以。"}, {"type": "subtitle", "time": 7232.47, "timestamp": "02:00:32", "text": "现在说到"}, {"type": "subtitle", "time": 7236.149, "timestamp": "02:00:36", "text": "虚拟主播，你需要很多美术素材，"}, {"type": "subtitle", "time": 7239.109, "timestamp": "02:00:39", "text": "对吧？这很难。我听说"}, {"type": "subtitle", "time": 7241.03, "timestamp": "02:00:41", "text": "福岛有四个人受伤了。是"}, {"type": "subtitle", "time": 7242.629, "timestamp": "02:00:42", "text": "真的吗？我不知道。我还没看到"}, {"type": "subtitle", "time": 7245.91, "timestamp": "02:00:45", "text": "新闻。我是个学生，"}, {"type": "subtitle", "time": 7248.709, "timestamp": "02:00:48", "text": "大概两个月前，也就是四月份到日本的。"}, {"type": "subtitle", "time": 7250.87, "timestamp": "02:00:50", "text": "所以我还得看看新闻。我知道好像有"}, {"type": "subtitle", "time": 7252.709, "timestamp": "02:00:52", "text": "台风什么的"}, {"type": "subtitle", "time": 7257.83, "timestamp": "02:00:57", "text": "。我不太清楚。"}]
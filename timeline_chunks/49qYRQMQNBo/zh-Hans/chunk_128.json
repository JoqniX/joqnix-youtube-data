[{"type": "subtitle", "time": 7680.149, "timestamp": "02:08:00", "text": "去过"}, {"type": "subtitle", "time": 7684.629, "timestamp": "02:08:04", "text": "我家附近的全家。问题是它太远了。"}, {"type": "subtitle", "time": 7686.629, "timestamp": "02:08:06", "text": "太远了。我看到的都是"}, {"type": "subtitle", "time": 7688.709, "timestamp": "02:08:08", "text": "7-Eleven。"}, {"type": "subtitle", "time": 7692.31, "timestamp": "02:08:12", "text": "只有在非常非常非常"}, {"type": "subtitle", "time": 7697.51, "timestamp": "02:08:17", "text": "小的角落里才能看到全家。"}, {"type": "subtitle", "time": 7704.47, "timestamp": "02:08:24", "text": "在一个非常小的角落里。"}, {"type": "subtitle", "time": 7714.39, "timestamp": "02:08:34", "text": "所以，"}, {"type": "subtitle", "time": 7718.069, "timestamp": "02:08:38", "text": "我要去7-11便利店。"}, {"type": "subtitle", "time": 7722.47, "timestamp": "02:08:42", "text": "哦，天哪，感觉好奇怪。"}, {"type": "subtitle", "time": 7724.79, "timestamp": "02:08:44", "text": "等等，我应该打开"}, {"type": "subtitle", "time": 7726.629, "timestamp": "02:08:46", "text": "降噪功能吗？"}, {"type": "subtitle", "time": 7728.629, "timestamp": "02:08:48", "text": "好吧，你能听到马路的声音和我过马路的"}, {"type": "subtitle", "time": 7732.39, "timestamp": "02:08:52", "text": "声音。这样没关系。"}]
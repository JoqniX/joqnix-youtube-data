[{"type": "subtitle", "time": 7864.55, "timestamp": "02:11:04", "text": "？你好。你好。欢迎光临。我"}, {"type": "subtitle", "time": 7872.229, "timestamp": "02:11:12", "text": "我不能浪费钱。我得"}, {"type": "subtitle", "time": 7882.069, "timestamp": "02:11:22", "text": "清淡的，或者像"}, {"type": "subtitle", "time": 7889.43, "timestamp": "02:11:29", "text": "芝麻拉面。好吧，就买这个吧。我"}, {"type": "subtitle", "time": 7893.91, "timestamp": "02:11:33", "text": "在7-11，我饿了。饮料。让我"}, {"type": "subtitle", "time": 7914.87, "timestamp": "02:11:54", "text": "好吧，就买这个。然后我再买点"}, {"type": "subtitle", "time": 7918.149, "timestamp": "02:11:58", "text": "面包什么的。"}]
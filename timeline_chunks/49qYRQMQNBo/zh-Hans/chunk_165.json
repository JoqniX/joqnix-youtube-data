[{"type": "subtitle", "time": 9916.389, "timestamp": "02:45:16", "text": "对很多人来说，在"}, {"type": "subtitle", "time": 9918.469, "timestamp": "02:45:18", "text": "昆虫或其他东西出现之前"}, {"type": "subtitle", "time": 9921.269, "timestamp": "02:45:21", "text": "。 这就是我正在吃的东西。"}, {"type": "subtitle", "time": 9929.59, "timestamp": "02:45:29", "text": "当你"}, {"type": "subtitle", "time": 9932.63, "timestamp": "02:45:32", "text": "独自一人在空无一人的公园里，"}, {"type": "subtitle", "time": 9936.15, "timestamp": "02:45:36", "text": "听到奇怪的声音从"}, {"type": "subtitle", "time": 9944.63, "timestamp": "02:45:44", "text": "远处传来，感觉有点可怕，就像近在咫尺一样。"}, {"type": "subtitle", "time": 9946.389, "timestamp": "02:45:46", "text": "我现在说的都是恐怖题材的东西了"}]
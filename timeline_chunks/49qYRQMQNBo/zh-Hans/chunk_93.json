[{"type": "subtitle", "time": 5581.189, "timestamp": "01:33:01", "text": "对吧？因为他什么都算好了，"}, {"type": "subtitle", "time": 5583.83, "timestamp": "01:33:03", "text": "比如，这个鸡蛋"}, {"type": "subtitle", "time": 5587.11, "timestamp": "01:33:07", "text": "今天和明天都要用，呃，"}, {"type": "subtitle", "time": 5588.95, "timestamp": "01:33:08", "text": "他会做这个那个"}, {"type": "subtitle", "time": 5591.83, "timestamp": "01:33:11", "text": "，对吧？他会"}, {"type": "subtitle", "time": 5594.31, "timestamp": "01:33:14", "text": "根据"}, {"type": "subtitle", "time": 5596.47, "timestamp": "01:33:16", "text": "现有的食材和我们这"}, {"type": "subtitle", "time": 5599.75, "timestamp": "01:33:19", "text": "周买的食材，计划好做什么菜等等。如果我用了"}, {"type": "subtitle", "time": 5603.27, "timestamp": "01:33:23", "text": "那些食材，呃，搞砸了，搞砸了，那就会"}, {"type": "subtitle", "time": 5606.709, "timestamp": "01:33:26", "text": "出错，对吧？是"}, {"type": "subtitle", "time": 5613.83, "timestamp": "01:33:33", "text": "兄弟。"}, {"type": "subtitle", "time": 5615.59, "timestamp": "01:33:35", "text": "想象一下，"}, {"type": "subtitle", "time": 5618.47, "timestamp": "01:33:38", "text": "呃，你的室友给你做饭，什么都做，"}, {"type": "subtitle", "time": 5620.47, "timestamp": "01:33:40", "text": "做饭什么的，"}, {"type": "subtitle", "time": 5623.35, "timestamp": "01:33:43", "text": "而你不会做饭，"}, {"type": "subtitle", "time": 5625.91, "timestamp": "01:33:45", "text": "你一大早就做了个"}, {"type": "subtitle", "time": 5629.27, "timestamp": "01:33:49", "text": "煎蛋卷，然后说“惊喜”，"}, {"type": "subtitle", "time": 5632.07, "timestamp": "01:33:52", "text": "你会怎么说？你会怎么说，"}, {"type": "subtitle", "time": 5634.39, "timestamp": "01:33:54", "text": "兄弟？他当时说，  “是啊，这就是你的"}, {"type": "subtitle", "time": 5638.95, "timestamp": "01:33:58", "text": "惊喜。” 煎蛋卷，兄弟。就"}]
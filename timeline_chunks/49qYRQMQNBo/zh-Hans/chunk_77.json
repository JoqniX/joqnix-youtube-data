[{"type": "subtitle", "time": 4621.75, "timestamp": "01:17:01", "text": "结识新朋友，和"}, {"type": "subtitle", "time": 4625.35, "timestamp": "01:17:05", "text": "他们一起出去玩，让"}, {"type": "subtitle", "time": 4628.149, "timestamp": "01:17:08", "text": "朋友们把我从"}, {"type": "subtitle", "time": 4631.91, "timestamp": "01:17:11", "text": "宿舍里拉出来一起玩。 他们去"}, {"type": "subtitle", "time": 4635.91, "timestamp": "01:17:15", "text": "购物、吃饭等等。"}, {"type": "subtitle", "time": 4638.87, "timestamp": "01:17:18", "text": "你却无视我。什么意思？"}, {"type": "subtitle", "time": 4640.79, "timestamp": "01:17:20", "text": "我关注了你提供的所有社交媒体应用"}, {"type": "subtitle", "time": 4644.95, "timestamp": "01:17:24", "text": "。我看了你的消息，"}, {"type": "subtitle", "time": 4652.07, "timestamp": "01:17:32", "text": "也看了你的评论。但是，嗯，是"}, {"type": "subtitle", "time": 4655.189, "timestamp": "01:17:35", "text": "的。所以，是的"}, {"type": "subtitle", "time": 4658.87, "timestamp": "01:17:38", "text": "，这确实很难。而且，你要知道，我已经这样说了"}, {"type": "subtitle", "time": 4663.03, "timestamp": "01:17:43", "text": "两年了。"}, {"type": "subtitle", "time": 4668.07, "timestamp": "01:17:48", "text": "可能明年，嗯，等我的同学们都"}, {"type": "subtitle", "time": 4670.31, "timestamp": "01:17:50", "text": "毕业了，因为他们都"}, {"type": "subtitle", "time": 4671.83, "timestamp": "01:17:51", "text": "大二了。我是唯一一个"}, {"type": "subtitle", "time": 4673.75, "timestamp": "01:17:53", "text": "大一的，对吧？"}, {"type": "subtitle", "time": 4679.83, "timestamp": "01:17:59", "text": "明年大二也会一样，"}]
[{"type": "subtitle", "time": 12660.15, "timestamp": "03:31:00", "text": "我的意思是，都六月了，"}, {"type": "subtitle", "time": 12664.95, "timestamp": "03:31:04", "text": "考试应该早就开始了。"}, {"type": "subtitle", "time": 12667.03, "timestamp": "03:31:07", "text": "我想我还是等到十二月吧。我到时候给"}, {"type": "subtitle", "time": 12669.19, "timestamp": "03:31:09", "text": "他们发邮件问问。问题是"}, {"type": "subtitle", "time": 12672.229, "timestamp": "03:31:12", "text": "没时间。真的没时间。"}, {"type": "subtitle", "time": 12674.79, "timestamp": "03:31:14", "text": "我已经忙着日语"}, {"type": "subtitle", "time": 12676.95, "timestamp": "03:31:16", "text": "学习了，而且"}, {"type": "subtitle", "time": 12681.03, "timestamp": "03:31:21", "text": "我本来就不应该直播。"}, {"type": "subtitle", "time": 12698.71, "timestamp": "03:31:38", "text": "好吧，我室友说让我"}, {"type": "subtitle", "time": 12700.87, "timestamp": "03:31:40", "text": "回家。"}, {"type": "subtitle", "time": 12703.59, "timestamp": "03:31:43", "text": "兄弟，你让我等了两个小时。等等，"}, {"type": "subtitle", "time": 12705.91, "timestamp": "03:31:45", "text": "他让我等了几个小时？我觉得"}, {"type": "subtitle", "time": 12712.229, "timestamp": "03:31:52", "text": "我说"}]
[{"type": "subtitle", "time": 11761.269, "timestamp": "03:16:01", "text": "哇，我得付第七个月、第"}, {"type": "subtitle", "time": 11764.55, "timestamp": "03:16:04", "text": "八个月、第九个月，还有下个月的钱。日本"}, {"type": "subtitle", "time": 11767.349, "timestamp": "03:16:07", "text": "的预付款是怎么回事"}, {"type": "subtitle", "time": 11769.99, "timestamp": "03:16:09", "text": "？简直疯了。还有，欢迎"}, {"type": "subtitle", "time": 11777.83, "timestamp": "03:16:17", "text": "嗯，我对此很感兴趣，过去三年"}, {"type": "subtitle", "time": 11780.469, "timestamp": "03:16:20", "text": "我一直经历着同样的事情。"}, {"type": "subtitle", "time": 11783.11, "timestamp": "03:16:23", "text": "是的。所以你知道，现在我也面临着同样的问题，"}, {"type": "subtitle", "time": 11787.03, "timestamp": "03:16:27", "text": "你已经经历了"}, {"type": "subtitle", "time": 11789.75, "timestamp": "03:16:29", "text": "三年，而我经历了三年多，但我才"}, {"type": "subtitle", "time": 11792.229, "timestamp": "03:16:32", "text": "经历了"}, {"type": "subtitle", "time": 11796.55, "timestamp": "03:16:36", "text": "两个月。"}, {"type": "subtitle", "time": 11799.19, "timestamp": "03:16:39", "text": "是的。"}, {"type": "subtitle", "time": 11802.469, "timestamp": "03:16:42", "text": "嗯，一升牛奶。我们还没买牛奶。"}, {"type": "subtitle", "time": 11804.79, "timestamp": "03:16:44", "text": "我们买了牛奶，但是过期了，因为"}, {"type": "subtitle", "time": 11808.15, "timestamp": "03:16:48", "text": "我们忘了用，因为我们没有烧"}, {"type": "subtitle", "time": 11818.229, "timestamp": "03:16:58", "text": "，"}]
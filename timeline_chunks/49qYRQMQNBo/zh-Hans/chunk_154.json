[{"type": "subtitle", "time": 9242.87, "timestamp": "02:34:02", "text": "照片发上去什么的。好的。"}, {"type": "subtitle", "time": 9245.19, "timestamp": "02:34:05", "text": "所以，"}, {"type": "subtitle", "time": 9247.27, "timestamp": "02:34:07", "text": "等等，我应该……"}, {"type": "subtitle", "time": 9250.309, "timestamp": "02:34:10", "text": "我过了"}, {"type": "subtitle", "time": 9252.79, "timestamp": "02:34:12", "text": "罚款的期限，就算方便面店"}, {"type": "subtitle", "time": 9270.87, "timestamp": "02:34:30", "text": "如果我室友要的话，我会给他一些。不过"}, {"type": "subtitle", "time": 9273.91, "timestamp": "02:34:33", "text": "他应该不会要。他"}, {"type": "subtitle", "time": 9278.309, "timestamp": "02:34:38", "text": "刚和那个等离子男在一家餐厅吃了一顿丰盛的晚餐"}, {"type": "subtitle", "time": 9282.23, "timestamp": "02:34:42", "text": "。与此同时，他还"}, {"type": "subtitle", "time": 9284.469, "timestamp": "02:34:44", "text": "让我吃点东西，吃点"}, {"type": "subtitle", "time": 9288.389, "timestamp": "02:34:48", "text": "煤炭。当我回到"}, {"type": "subtitle", "time": 9292.23, "timestamp": "02:34:52", "text": "火车上时，他说：“嗯，"}]
[{"type": "subtitle", "time": 4684.229, "timestamp": "01:18:04", "text": "和我一起来日本的大一新生也会升入大二，和"}, {"type": "subtitle", "time": 4688.709, "timestamp": "01:18:08", "text": "我一样。但是，"}, {"type": "subtitle", "time": 4690.79, "timestamp": "01:18:10", "text": "嗯，"}, {"type": "subtitle", "time": 4693.27, "timestamp": "01:18:13", "text": "我没办法和"}, {"type": "subtitle", "time": 4696.39, "timestamp": "01:18:16", "text": "他们成为朋友，或者和他们很亲近，"}, {"type": "subtitle", "time": 4703.669, "timestamp": "01:18:23", "text": "嗯，因为在他们眼里，我只是个新来的"}, {"type": "subtitle", "time": 4707.91, "timestamp": "01:18:27", "text": "男生，一个新生什么的，对吧，"}, {"type": "subtitle", "time": 4710.39, "timestamp": "01:18:30", "text": "或者他们看到的是，而且，"}, {"type": "subtitle", "time": 4714.95, "timestamp": "01:18:34", "text": "嗯，你还得主动一点，"}, {"type": "subtitle", "time": 4722.149, "timestamp": "01:18:42", "text": "努力去交"}, {"type": "subtitle", "time": 4732.95, "timestamp": "01:18:52", "text": "而且，我真的开始意识到"}, {"type": "subtitle", "time": 4736.149, "timestamp": "01:18:56", "text": "时尚有多么重要。 现在在日本，"}, {"type": "subtitle", "time": 4738.31, "timestamp": "01:18:58", "text": "每个人都那么时尚，真是的。"}]
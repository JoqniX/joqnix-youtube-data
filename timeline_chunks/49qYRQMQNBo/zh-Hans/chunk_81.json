[{"type": "subtitle", "time": 4863.91, "timestamp": "01:21:03", "text": "是的。是的。"}, {"type": "subtitle", "time": 4866.31, "timestamp": "01:21:06", "text": "我……我……我"}, {"type": "subtitle", "time": 4870.39, "timestamp": "01:21:10", "text": "有点…… 我开始意识到这种情绪，嗯，"}, {"type": "subtitle", "time": 4875.27, "timestamp": "01:21:15", "text": "因为每次我去东京处理一些"}, {"type": "subtitle", "time": 4877.35, "timestamp": "01:21:17", "text": "学校的事情时，"}, {"type": "subtitle", "time": 4881.91, "timestamp": "01:21:21", "text": "我都感觉我的室友也经历过这种感觉，"}, {"type": "subtitle", "time": 4884.709, "timestamp": "01:21:24", "text": "而我现在也面临着同样的情况，"}, {"type": "subtitle", "time": 4887.11, "timestamp": "01:21:27", "text": "当你独自一人时，你会感受到那种"}, {"type": "subtitle", "time": 4888.87, "timestamp": "01:21:28", "text": "孤独"}, {"type": "subtitle", "time": 4890.87, "timestamp": "01:21:30", "text": "等等。"}, {"type": "subtitle", "time": 4894.55, "timestamp": "01:21:34", "text": "是的。最重要的"}, {"type": "subtitle", "time": 4897.75, "timestamp": "01:21:37", "text": "是，你不能"}, {"type": "subtitle", "time": 4900.149, "timestamp": "01:21:40", "text": "太依赖别人。"}, {"type": "subtitle", "time": 4903.91, "timestamp": "01:21:43", "text": "每个人都只关心自己"}, {"type": "subtitle", "time": 4909.27, "timestamp": "01:21:49", "text": "和自己的事情等等。对。是的，"}, {"type": "subtitle", "time": 4912.87, "timestamp": "01:21:52", "text": "没有人会帮你。是的，以后会有的。"}, {"type": "subtitle", "time": 4914.87, "timestamp": "01:21:54", "text": "是的。即使"}, {"type": "subtitle", "time": 4918.39, "timestamp": "01:21:58", "text": "有人帮助你，你仍然要靠自己"}]
[{"type": "subtitle", "time": 11525.03, "timestamp": "03:12:05", "text": "那是我的私事，Kaki。"}, {"type": "subtitle", "time": 11527.429, "timestamp": "03:12:07", "text": "我没必要公开谈论这些。"}, {"type": "subtitle", "time": 11529.99, "timestamp": "03:12:09", "text": "糟糕。对"}, {"type": "subtitle", "time": 11538.79, "timestamp": "03:12:18", "text": "我知道开销很大。所以你看，所以"}, {"type": "subtitle", "time": 11544.23, "timestamp": "03:12:24", "text": "我才去做调查，"}, {"type": "subtitle", "time": 11547.91, "timestamp": "03:12:27", "text": "因为日本消费很高。"}, {"type": "subtitle", "time": 11551.03, "timestamp": "03:12:31", "text": "东京消费很高。"}, {"type": "subtitle", "time": 11554.23, "timestamp": "03:12:34", "text": "大学也很贵。"}, {"type": "subtitle", "time": 11558.309, "timestamp": "03:12:38", "text": "一所大学一年大概要200万卢比，光是"}, {"type": "subtitle", "time": 11562.63, "timestamp": "03:12:42", "text": "基本学费、"}, {"type": "subtitle", "time": 11564.71, "timestamp": "03:12:44", "text": "学费等等就差不多这么多了。"}, {"type": "subtitle", "time": 11566.95, "timestamp": "03:12:46", "text": "太贵了。"}, {"type": "subtitle", "time": 11569.99, "timestamp": "03:12:49", "text": "如果你想学习，比如"}, {"type": "subtitle", "time": 11572.15, "timestamp": "03:12:52", "text": "在大学里读"}, {"type": "subtitle", "time": 11575.59, "timestamp": "03:12:55", "text": "四年或三年的课程，"}]
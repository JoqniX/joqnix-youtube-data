[{"type": "subtitle", "time": 11940.469, "timestamp": "03:19:00", "text": "那一"}, {"type": "subtitle", "time": 11943.83, "timestamp": "03:19:03", "text": "包普通的饼干，呃，哦，是的"}, {"type": "subtitle", "time": 11945.75, "timestamp": "03:19:05", "text": "。别去太方便的地方。7-11"}, {"type": "subtitle", "time": 11949.83, "timestamp": "03:19:09", "text": "买饼干，伙计。一小块就要200日元。"}, {"type": "subtitle", "time": 11955.11, "timestamp": "03:19:15", "text": "198日元，132日元。一块"}, {"type": "subtitle", "time": 11959.19, "timestamp": "03:19:19", "text": "饼干就要168日元。你相信吗"}, {"type": "subtitle", "time": 11963.19, "timestamp": "03:19:23", "text": "？其实没那么贵。是的。"}, {"type": "subtitle", "time": 11966.55, "timestamp": "03:19:26", "text": "只是我现在开始觉得，"}, {"type": "subtitle", "time": 11969.429, "timestamp": "03:19:29", "text": "在日本，他们觉得"}, {"type": "subtitle", "time": 11972.389, "timestamp": "03:19:32", "text": "一千日元不算什么。我"}, {"type": "subtitle", "time": 11974.229, "timestamp": "03:19:34", "text": "去东京的时候就明白了。"}, {"type": "subtitle", "time": 11978.229, "timestamp": "03:19:38", "text": "好吧。他们吃一顿饭就要花100"}, {"type": "subtitle", "time": 11981.429, "timestamp": "03:19:41", "text": "日元。哦不，1000日元。 就像在拉面"}, {"type": "subtitle", "time": 11984.15, "timestamp": "03:19:44", "text": "店、乌冬面店或者日式"}, {"type": "subtitle", "time": 11986.79, "timestamp": "03:19:46", "text": "烤炉店之类的，像"}, {"type": "subtitle", "time": 11989.59, "timestamp": "03:19:49", "text": "普通上班族一样。"}, {"type": "subtitle", "time": 11993.19, "timestamp": "03:19:53", "text": "而我，作为一个印度"}, {"type": "subtitle", "time": 11996.389, "timestamp": "03:19:56", "text": "学生，1000日元能做的事情可"}, {"type": "subtitle", "time": 11998.55, "timestamp": "03:19:58", "text": "多了。比如，"}]
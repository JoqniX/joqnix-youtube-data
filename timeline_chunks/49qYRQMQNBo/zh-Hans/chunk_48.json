[{"type": "subtitle", "time": 2881.67, "timestamp": "00:48:01", "text": "哎。 我的天哪。"}, {"type": "subtitle", "time": 2883.51, "timestamp": "00:48:03", "text": "当我打开 Sammy 时，你知道，我"}, {"type": "subtitle", "time": 2885.99, "timestamp": "00:48:05", "text": "昨天才安装它，因为我可以，"}, {"type": "subtitle", "time": 2888.95, "timestamp": "00:48:08", "text": "因为我可以做我的，因为我想做"}, {"type": "subtitle", "time": 2890.95, "timestamp": "00:48:10", "text": "我的"}, {"type": "subtitle", "time": 2893.349, "timestamp": "00:48:13", "text": "桌面直播。"}, {"type": "subtitle", "time": 2903.27, "timestamp": "00:48:23", "text": "我不知道。 我想聊聊"}, {"type": "subtitle", "time": 2905.589, "timestamp": "00:48:25", "text": "萨米的话题。"}, {"type": "subtitle", "time": 2913.51, "timestamp": "00:48:33", "text": "我现在用"}, {"type": "subtitle", "time": 2916.069, "timestamp": "00:48:36", "text": "一个朋友开发的直播应用，这个"}, {"type": "subtitle", "time": 2919.43, "timestamp": "00:48:39", "text": "应用有点像 OBS，有"}, {"type": "subtitle", "time": 2921.91, "timestamp": "00:48:41", "text": "场景和源之类的功能。"}, {"type": "subtitle", "time": 2924.309, "timestamp": "00:48:44", "text": "呃，他现在身心俱疲，还生病了，"}, {"type": "subtitle", "time": 2928.15, "timestamp": "00:48:48", "text": "他得去开发其他"}, {"type": "subtitle", "time": 2931.43, "timestamp": "00:48:51", "text": "应用了。 他"}, {"type": "subtitle", "time": 2933.91, "timestamp": "00:48:53", "text": "还制作了类似 Stream Elements 的小"}, {"type": "subtitle", "time": 2937.99, "timestamp": "00:48:57", "text": "部件"}]
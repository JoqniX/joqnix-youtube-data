[{"type": "subtitle", "time": 13200.55, "timestamp": "03:40:00", "text": "一个"}, {"type": "subtitle", "time": 13203.83, "timestamp": "03:40:03", "text": "旅行团之类的。不，不，不。是的，我"}, {"type": "subtitle", "time": 13211.349, "timestamp": "03:40:11", "text": "和"}, {"type": "subtitle", "time": 13213.91, "timestamp": "03:40:13", "text": "学长学姐们一起去旅行的时候，确实看到过一群很吵闹的人。然后我"}, {"type": "subtitle", "time": 13215.75, "timestamp": "03:40:15", "text": "去和他们说话的时候，他们"}, {"type": "subtitle", "time": 13217.83, "timestamp": "03:40:17", "text": "真的很吵，大家都看着"}, {"type": "subtitle", "time": 13224.15, "timestamp": "03:40:24", "text": "声音传来的方向，我当时正在睡觉，"}, {"type": "subtitle", "time": 13226.309, "timestamp": "03:40:26", "text": "听到他们在喊叫什么的。我"}, {"type": "subtitle", "time": 13228.79, "timestamp": "03:40:28", "text": "就想，“咦，那是谁？”"}, {"type": "subtitle", "time": 13232.15, "timestamp": "03:40:32", "text": "试图找借口。不，为什么？好吧，"}, {"type": "subtitle", "time": 13256.87, "timestamp": "03:40:56", "text": "。哦 是啊。"}, {"type": "subtitle", "time": 13259.83, "timestamp": "03:40:59", "text": "每个县"}]
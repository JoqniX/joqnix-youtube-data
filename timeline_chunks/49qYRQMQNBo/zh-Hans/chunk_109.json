[{"type": "subtitle", "time": 6543.189, "timestamp": "01:49:03", "text": "。"}, {"type": "subtitle", "time": 6545.669, "timestamp": "01:49:05", "text": "他们不会当面说。这很"}, {"type": "subtitle", "time": 6550.149, "timestamp": "01:49:10", "text": "重要。他们会一直"}, {"type": "subtitle", "time": 6553.109, "timestamp": "01:49:13", "text": "监视你，观察你，"}, {"type": "subtitle", "time": 6556.149, "timestamp": "01:49:16", "text": "你的错误，你"}, {"type": "subtitle", "time": 6559.669, "timestamp": "01:49:19", "text": "做错的地方"}, {"type": "subtitle", "time": 6563.43, "timestamp": "01:49:23", "text": "等等。是啊。有时候沟通很困难"}, {"type": "subtitle", "time": 6565.59, "timestamp": "01:49:25", "text": "。"}, {"type": "subtitle", "time": 6568.47, "timestamp": "01:49:28", "text": "所以，就是这些。是啊。这是一点"}, {"type": "subtitle", "time": 6573.189, "timestamp": "01:49:33", "text": "。第二点，我还能"}, {"type": "subtitle", "time": 6576.55, "timestamp": "01:49:36", "text": "说什么呢？刻板印象。我的意思是，我还没感觉到"}, {"type": "subtitle", "time": 6579.75, "timestamp": "01:49:39", "text": "任何种族歧视之类的。唯一"}, {"type": "subtitle", "time": 6583.35, "timestamp": "01:49:43", "text": "一次 我"}, {"type": "subtitle", "time": 6588.07, "timestamp": "01:49:48", "text": "在东京的时候感觉到了种族歧视，当时我去东京是"}, {"type": "subtitle", "time": 6591.59, "timestamp": "01:49:51", "text": "为了参加一个"}, {"type": "subtitle", "time": 6595.35, "timestamp": "01:49:55", "text": "职业学校的活动"}, {"type": "subtitle", "time": 6598.229, "timestamp": "01:49:58", "text": "。我在火车站下车，看到"}]
[{"type": "subtitle", "time": 11280.79, "timestamp": "03:08:00", "text": "。 在"}, {"type": "subtitle", "time": 11287.349, "timestamp": "03:08:07", "text": "没有未来计划的情况下，有哪些可用的范围？ 兄弟，"}, {"type": "subtitle", "time": 11290.55, "timestamp": "03:08:10", "text": "听我说。 我是"}, {"type": "subtitle", "time": 11294.95, "timestamp": "03:08:14", "text": "全校唯一一个一年级就去"}, {"type": "subtitle", "time": 11299.83, "timestamp": "03:08:19", "text": "19 所不同的大学"}, {"type": "subtitle", "time": 11301.429, "timestamp": "03:08:21", "text": "和大学以及"}, {"type": "subtitle", "time": 11307.349, "timestamp": "03:08:27", "text": "萨蒙加大学就读的学生，就因为"}, {"type": "subtitle", "time": 11310.71, "timestamp": "03:08:30", "text": "我被安排到了一个二年级的班级，就像"}, {"type": "subtitle", "time": 11318.07, "timestamp": "03:08:38", "text": "每个学生"}, {"type": "subtitle", "time": 11325.51, "timestamp": "03:08:45", "text": "在二年级或最后一年都必须做的那样。 我一"}, {"type": "subtitle", "time": 11330.07, "timestamp": "03:08:50", "text": "到日本就这么做了，就在"}, {"type": "subtitle", "time": 11335.349, "timestamp": "03:08:55", "text": "第一个月，四月份。"}]
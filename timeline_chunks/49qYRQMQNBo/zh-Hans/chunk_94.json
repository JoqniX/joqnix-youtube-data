[{"type": "subtitle", "time": 5641.03, "timestamp": "01:34:01", "text": "好像如果我做煎蛋卷……他当时说：“"}, {"type": "subtitle", "time": 5645.189, "timestamp": "01:34:05", "text": "如果你做印度香饭或者"}, {"type": "subtitle", "time": 5647.189, "timestamp": "01:34:07", "text": "烤菜之类的，那我才会"}, {"type": "subtitle", "time": 5649.669, "timestamp": "01:34:09", "text": "惊喜。”  “没什么。” 是啊。别"}, {"type": "subtitle", "time": 5652.07, "timestamp": "01:34:12", "text": "用鸡蛋做这个，拜托。"}, {"type": "subtitle", "time": 5655.91, "timestamp": "01:34:15", "text": "告诉我一声就行。我本来打算"}, {"type": "subtitle", "time": 5659.35, "timestamp": "01:34:19", "text": "今天做这个咖喱的，结果你把"}, {"type": "subtitle", "time": 5662.149, "timestamp": "01:34:22", "text": "我想用的鸡蛋都用光了"}, {"type": "subtitle", "time": 5663.75, "timestamp": "01:34:23", "text": "。"}, {"type": "subtitle", "time": 5667.83, "timestamp": "01:34:27", "text": "是啊，因为这个，我感觉好痛苦"}, {"type": "subtitle", "time": 5672.229, "timestamp": "01:34:32", "text": "。不过，你好，欢迎"}, {"type": "subtitle", "time": 5675.35, "timestamp": "01:34:35", "text": "尝试用蘑菇做菜。"}, {"type": "subtitle", "time": 5680.629, "timestamp": "01:34:40", "text": "我不知道能不能行，但试试看吧。"}, {"type": "subtitle", "time": 5687.51, "timestamp": "01:34:47", "text": "两年后我们就要"}, {"type": "subtitle", "time": 5689.99, "timestamp": "01:34:49", "text": "各奔东西了，对吧？"}, {"type": "subtitle", "time": 5694.47, "timestamp": "01:34:54", "text": "天知道我最终会在日本的哪个地方，"}, {"type": "subtitle", "time": 5696.95, "timestamp": "01:34:56", "text": "我的室友也会去"}]
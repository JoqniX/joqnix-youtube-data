[{"type": "subtitle", "time": 9741.51, "timestamp": "02:42:21", "text": "好的。 我想这里应该有张桌子吧。"}, {"type": "subtitle", "time": 9743.51, "timestamp": "02:42:23", "text": "等等，刚才是不是说“好的，他们有张桌子了”？"}, {"type": "subtitle", "time": 9746.07, "timestamp": "02:42:26", "text": "等等，那不是桌子，你个笨蛋。"}, {"type": "subtitle", "time": 9748.469, "timestamp": "02:42:28", "text": "他们没有桌子。 我的天啊。"}, {"type": "subtitle", "time": 9752.07, "timestamp": "02:42:32", "text": "我为什么又来这里了？"}, {"type": "subtitle", "time": 9764.15, "timestamp": "02:42:44", "text": "好吧，他们没有桌子，"}, {"type": "subtitle", "time": 9775.51, "timestamp": "02:42:55", "text": "让你……"}, {"type": "subtitle", "time": 9778.79, "timestamp": "02:42:58", "text": "他们有一个支撑长凳。"}]
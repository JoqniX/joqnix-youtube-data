[{"type": "subtitle", "time": 5220.95, "timestamp": "01:27:00", "text": "我想，呃，我本来想说一些"}, {"type": "subtitle", "time": 5224.629, "timestamp": "01:27:04", "text": "简短的话，但是我最后说了"}, {"type": "subtitle", "time": 5228.07, "timestamp": "01:27:08", "text": "太多，以至于变成了一场很"}, {"type": "subtitle", "time": 5231.83, "timestamp": "01:27:11", "text": "长的对话"}, {"type": "subtitle", "time": 5234.31, "timestamp": "01:27:14", "text": "。"}, {"type": "subtitle", "time": 5243.59, "timestamp": "01:27:23", "text": "我嫉妒我的室友，他"}, {"type": "subtitle", "time": 5248.07, "timestamp": "01:27:28", "text": "玩得很开心。嗯，是的，我虽然玩得很开心，但"}, {"type": "subtitle", "time": 5251.75, "timestamp": "01:27:31", "text": "我却"}, {"type": "subtitle", "time": 5254.07, "timestamp": "01:27:34", "text": "因为学习"}, {"type": "subtitle", "time": 5256.229, "timestamp": "01:27:36", "text": "和其他事情而感到压力和焦虑，因为我现在就是个焦虑"}, {"type": "subtitle", "time": 5259.99, "timestamp": "01:27:39", "text": "型的人。所以，情况应该不"}, {"type": "subtitle", "time": 5263.59, "timestamp": "01:27:43", "text": "一样，就像我们本来应该"}, {"type": "subtitle", "time": 5266.709, "timestamp": "01:27:46", "text": "互换一下，我的意思是，互换一下，"}]
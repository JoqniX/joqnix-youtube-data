[{"type": "subtitle", "time": 11467.19, "timestamp": "03:11:07", "text": "我不明白，你是在吹嘘自己"}, {"type": "subtitle", "time": 11468.87, "timestamp": "03:11:08", "text": "精通一门语言吗？从长远来看，这根本"}, {"type": "subtitle", "time": 11470.15, "timestamp": "03:11:10", "text": "不重要，"}, {"type": "subtitle", "time": 11471.75, "timestamp": "03:11:11", "text": "你做的其实就是"}, {"type": "subtitle", "time": 11473.91, "timestamp": "03:11:13", "text": "日本幼儿园小朋友都在做的事。详细说说你的"}, {"type": "subtitle", "time": 11482.469, "timestamp": "03:11:22", "text": "如果你要去另一个国家，就"}, {"type": "subtitle", "time": 11486.71, "timestamp": "03:11:26", "text": "应该学习当地语言。"}, {"type": "subtitle", "time": 11488.95, "timestamp": "03:11:28", "text": "你去一个国家学习"}, {"type": "subtitle", "time": 11491.75, "timestamp": "03:11:31", "text": "语言，然后找工作、继续深造，"}, {"type": "subtitle", "time": 11493.51, "timestamp": "03:11:33", "text": "或者做任何你"}, {"type": "subtitle", "time": 11495.99, "timestamp": "03:11:35", "text": "未来想做的事情。"}, {"type": "subtitle", "time": 11498.309, "timestamp": "03:11:38", "text": "对吧？就是这样"}, {"type": "subtitle", "time": 11500.79, "timestamp": "03:11:40", "text": "。而这正是我现在正在"}, {"type": "subtitle", "time": 11508.469, "timestamp": "03:11:48", "text": "你需要更好的计划。"}, {"type": "subtitle", "time": 11511.99, "timestamp": "03:11:51", "text": "语言学校毕业之后呢？我已经毕业了。"}, {"type": "subtitle", "time": 11514.389, "timestamp": "03:11:54", "text": "我没必要公开我的"}]
[{"type": "subtitle", "time": 4981.59, "timestamp": "01:23:01", "text": "别人聊天，但我 我觉得"}, {"type": "subtitle", "time": 4983.83, "timestamp": "01:23:03", "text": "他们不会把我当"}, {"type": "subtitle", "time": 4988.55, "timestamp": "01:23:08", "text": "朋友，对吧？因为就像在美国"}, {"type": "subtitle", "time": 4992.07, "timestamp": "01:23:12", "text": "或者印度那样，你遇到"}, {"type": "subtitle", "time": 4994.149, "timestamp": "01:23:14", "text": "一个人，相处融洽，就会"}, {"type": "subtitle", "time": 4997.59, "timestamp": "01:23:17", "text": "成为朋友，甚至是最好的朋友，对吧？"}, {"type": "subtitle", "time": 4998.87, "timestamp": "01:23:18", "text": "日本人不是这样的"}, {"type": "subtitle", "time": 5001.27, "timestamp": "01:23:21", "text": "。"}, {"type": "subtitle", "time": 5003.35, "timestamp": "01:23:23", "text": "你需要适应这一点。他们也"}, {"type": "subtitle", "time": 5005.51, "timestamp": "01:23:25", "text": "需要时间来适应你。这需要好"}, {"type": "subtitle", "time": 5010.95, "timestamp": "01:23:30", "text": "几个月的时间，"}, {"type": "subtitle", "time": 5018.47, "timestamp": "01:23:38", "text": "然后他们才会慢慢接受你"}, {"type": "subtitle", "time": 5020.39, "timestamp": "01:23:40", "text": "做朋友等等。"}, {"type": "subtitle", "time": 5024.07, "timestamp": "01:23:44", "text": "但我确实见过这种情况，"}, {"type": "subtitle", "time": 5025.83, "timestamp": "01:23:45", "text": "所以"}, {"type": "subtitle", "time": 5028.39, "timestamp": "01:23:48", "text": "我的意思是，这既是好事，也"}, {"type": "subtitle", "time": 5031.669, "timestamp": "01:23:51", "text": "有坏处。是的。"}, {"type": "subtitle", "time": 5035.11, "timestamp": "01:23:55", "text": "而结交朋友、摆脱孤独的最佳途径是去"}]
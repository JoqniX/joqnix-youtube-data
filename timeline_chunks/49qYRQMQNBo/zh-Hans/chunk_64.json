[{"type": "subtitle", "time": 3841.27, "timestamp": "01:04:01", "text": "付费才能使用。 所以我不得不放弃光束"}, {"type": "subtitle", "time": 3845.109, "timestamp": "01:04:05", "text": "流，改用隆隆流了。"}, {"type": "subtitle", "time": 3847.109, "timestamp": "01:04:07", "text": "回来的时候好好休息一下。"}, {"type": "subtitle", "time": 3848.71, "timestamp": "01:04:08", "text": "离开。 给自己放12天假。"}, {"type": "subtitle", "time": 3850.95, "timestamp": "01:04:10", "text": "不支持流媒体播放。 无法工作。"}, {"type": "subtitle", "time": 3853.19, "timestamp": "01:04:13", "text": "不，我做不到。 你忘了？ 我是"}, {"type": "subtitle", "time": 3856.87, "timestamp": "01:04:16", "text": "一块地毯。 我是一名国际学生。 我"}, {"type": "subtitle", "time": 3875.029, "timestamp": "01:04:35", "text": "仅限周六、周日。   是的"}, {"type": "subtitle", "time": 3876.789, "timestamp": "01:04:36", "text": "。"}, {"type": "subtitle", "time": 3880.549, "timestamp": "01:04:40", "text": "如何每周工作28小时。"}, {"type": "subtitle", "time": 3884.549, "timestamp": "01:04:44", "text": "即使我生病了，即使我……嗯，"}, {"type": "subtitle", "time": 3887.27, "timestamp": "01:04:47", "text": "即使我生病了，"}, {"type": "subtitle", "time": 3889.589, "timestamp": "01:04:49", "text": "我也得去医院，"}, {"type": "subtitle", "time": 3892.63, "timestamp": "01:04:52", "text": "拿到账单，证明我生病了，"}, {"type": "subtitle", "time": 3894.95, "timestamp": "01:04:54", "text": "然后出示它。 只有他们才会相信。"}, {"type": "subtitle", "time": 3899.589, "timestamp": "01:04:59", "text": "我不能随便找借口就"}]
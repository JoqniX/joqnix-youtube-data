[{"type": "subtitle", "time": 5700.55, "timestamp": "01:35:00", "text": "别的地方，对吧？"}, {"type": "subtitle", "time": 5703.11, "timestamp": "01:35:03", "text": "我们会认识新朋友，经历新"}, {"type": "subtitle", "time": 5705.99, "timestamp": "01:35:05", "text": "事物等等。"}, {"type": "subtitle", "time": 5709.27, "timestamp": "01:35:09", "text": "生活会继续。是"}, {"type": "subtitle", "time": 5710.79, "timestamp": "01:35:10", "text": "啊。"}, {"type": "subtitle", "time": 5713.83, "timestamp": "01:35:13", "text": "但我感觉我需要……我感觉我需要做回"}, {"type": "subtitle", "time": 5716.629, "timestamp": "01:35:16", "text": "我自己。就像"}, {"type": "subtitle", "time": 5720.47, "timestamp": "01:35:20", "text": "你很久以前认识的那个运动健将。所以"}, {"type": "subtitle", "time": 5725.669, "timestamp": "01:35:25", "text": "我还是那样，我还在……嗯……"}, {"type": "subtitle", "time": 5728.149, "timestamp": "01:35:28", "text": "该怎么说呢？"}, {"type": "subtitle", "time": 5731.03, "timestamp": "01:35:31", "text": "重现过去，或者说还"}, {"type": "subtitle", "time": 5732.87, "timestamp": "01:35:32", "text": "停留"}, {"type": "subtitle", "time": 5736.07, "timestamp": "01:35:36", "text": "在那个状态。也许"}, {"type": "subtitle", "time": 5740.709, "timestamp": "01:35:40", "text": "到时候狗狗会有女朋友了。我希望如此。"}, {"type": "subtitle", "time": 5743.36, "timestamp": "01:35:43", "text": "我希望如此。 或者别的什么。"}, {"type": "subtitle", "time": 5745.84, "timestamp": "01:35:45", "text": "或者别的什么。 谁？ 知道？"}, {"type": "subtitle", "time": 5748.96, "timestamp": "01:35:48", "text": "谁？ 知道？ 谁知道？"}, {"type": "subtitle", "time": 5756.07, "timestamp": "01:35:56", "text": "操。"}, {"type": "subtitle", "time": 5759.75, "timestamp": "01:35:59", "text": "我不应该说太多"}]
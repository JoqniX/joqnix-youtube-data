[{"type": "subtitle", "time": 12303.51, "timestamp": "03:25:03", "text": "所以，我想在印度的时候，我爸爸"}, {"type": "subtitle", "time": 12305.51, "timestamp": "03:25:05", "text": "经常买这个，"}, {"type": "subtitle", "time": 12308.07, "timestamp": "03:25:08", "text": "这样我们就可以在家里吃了。嗯，吃。是"}, {"type": "subtitle", "time": 12311.59, "timestamp": "03:25:11", "text": "啊。他会在家里用"}, {"type": "subtitle", "time": 12314.469, "timestamp": "03:25:14", "text": "纸杯之类的东西吃。所以他以前都是成"}, {"type": "subtitle", "time": 12317.349, "timestamp": "03:25:17", "text": "包地买。"}, {"type": "subtitle", "time": 12320.469, "timestamp": "03:25:20", "text": "我想我也吃过三个。然后"}, {"type": "subtitle", "time": 12322.229, "timestamp": "03:25:22", "text": "我想再买一个。我"}, {"type": "subtitle", "time": 12324.95, "timestamp": "03:25:24", "text": "不小心打开了第四个，然后"}, {"type": "subtitle", "time": 12327.67, "timestamp": "03:25:27", "text": "我就想，啊，我 我不想再吃这个了"}, {"type": "subtitle", "time": 12330.389, "timestamp": "03:25:30", "text": "。"}, {"type": "subtitle", "time": 12333.349, "timestamp": "03:25:33", "text": "我不得不硬塞进嘴里。"}, {"type": "subtitle", "time": 12336.15, "timestamp": "03:25:36", "text": "然后我就想，啊，我不想吃"}, {"type": "subtitle", "time": 12338.309, "timestamp": "03:25:38", "text": "这个了。"}, {"type": "subtitle", "time": 12349.59, "timestamp": "03:25:49", "text": "你是自己去的吗？有没有什么"}, {"type": "subtitle", "time": 12351.349, "timestamp": "03:25:51", "text": "费用、奖学金之类的？"}, {"type": "subtitle", "time": 12353.03, "timestamp": "03:25:53", "text": "不，不是奖学金。是最高额度的"}, {"type": "subtitle", "time": 12356.55, "timestamp": "03:25:56", "text": "奖学金。不是那个。不是那个。"}]
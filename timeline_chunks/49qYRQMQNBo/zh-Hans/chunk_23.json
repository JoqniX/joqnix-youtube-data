[{"type": "subtitle", "time": 1385.59, "timestamp": "00:23:05", "text": "天哪，她"}, {"type": "subtitle", "time": 1387.43, "timestamp": "00:23:07", "text": "醒了。"}, {"type": "subtitle", "time": 1389.43, "timestamp": "00:23:09", "text": "总之，就让它"}, {"type": "subtitle", "time": 1391.83, "timestamp": "00:23:11", "text": "留在那里吧。"}, {"type": "subtitle", "time": 1394.95, "timestamp": "00:23:14", "text": "让我把麦克风静音。   我们"}, {"type": "subtitle", "time": 1398.549, "timestamp": "00:23:18", "text": "走吧。 我已经通知了我的室友。"}, {"type": "subtitle", "time": 1401.27, "timestamp": "00:23:21", "text": "我应该带伞吗？ 让我打个"}, {"type": "subtitle", "time": 1413.11, "timestamp": "00:23:33", "text": "招呼。 欢迎来到我的直播间。"}, {"type": "subtitle", "time": 1415.27, "timestamp": "00:23:35", "text": "欢迎光临。"}, {"type": "subtitle", "time": 1418.63, "timestamp": "00:23:38", "text": "我先告辞，并更新我的NTE（预计到达时间）。 哦，是的"}, {"type": "subtitle", "time": 1420.23, "timestamp": "00:23:40", "text": "。 小心。 小心。 祝你好运。   祝你"}, {"type": "subtitle", "time": 1421.909, "timestamp": "00:23:41", "text": "好运。"}, {"type": "subtitle", "time": 1428.31, "timestamp": "00:23:48", "text": "谢谢光临。 真是愚蠢啊！"}, {"type": "subtitle", "time": 1434.47, "timestamp": "00:23:54", "text": "我得出门，可是我找不到那"}, {"type": "subtitle", "time": 1436.31, "timestamp": "00:23:56", "text": "该死的"}, {"type": "subtitle", "time": 1438.23, "timestamp": "00:23:58", "text": "耳机了。"}]
[{"type": "subtitle", "time": 13262.79, "timestamp": "03:41:02", "text": "都不一样。人们的时尚品味也各不"}, {"type": "subtitle", "time": 13266.63, "timestamp": "03:41:06", "text": "相同。如果你去东京，你会发现那里的"}, {"type": "subtitle", "time": 13270.79, "timestamp": "03:41:10", "text": "人都非常时尚，那种"}, {"type": "subtitle", "time": 13273.67, "timestamp": "03:41:13", "text": "疯狂的时尚。就是你在"}, {"type": "subtitle", "time": 13275.59, "timestamp": "03:41:15", "text": "YouTube短视频里看到的那种。"}, {"type": "subtitle", "time": 13279.349, "timestamp": "03:41:19", "text": "不，我说的是那种奇特又酷炫的"}, {"type": "subtitle", "time": 13283.59, "timestamp": "03:41:23", "text": "时尚。那种时尚在"}, {"type": "subtitle", "time": 13285.19, "timestamp": "03:41:25", "text": "东京很常见。"}, {"type": "subtitle", "time": 13289.83, "timestamp": "03:41:29", "text": "而当你去"}, {"type": "subtitle", "time": 13292.469, "timestamp": "03:41:32", "text": "乡村之类的地方，你会发现每个人都有"}, {"type": "subtitle", "time": 13299.11, "timestamp": "03:41:39", "text": "他们自己的风格，怎么说呢？"}, {"type": "subtitle", "time": 13303.19, "timestamp": "03:41:43", "text": "就是那种很有型、很好"}, {"type": "subtitle", "time": 13306.07, "timestamp": "03:41:46", "text": "看的时尚。"}, {"type": "subtitle", "time": 13308.63, "timestamp": "03:41:48", "text": "不是东京那种过度曝光的"}, {"type": "subtitle", "time": 13312.55, "timestamp": "03:41:52", "text": "时尚，而是"}, {"type": "subtitle", "time": 13316.15, "timestamp": "03:41:56", "text": "更偏向于一种……嗯，"}, {"type": "subtitle", "time": 13317.83, "timestamp": "03:41:57", "text": "经典的欧式风格。对，对，对，对"}]
[{"type": "subtitle", "time": 1320.87, "timestamp": "00:22:00", "text": "我来自同一所学院，来自印度，"}, {"type": "subtitle", "time": 1328.39, "timestamp": "00:22:08", "text": "我不知道是不是拿走了，拿走了，或者哦，"}, {"type": "subtitle", "time": 1332.07, "timestamp": "00:22:12", "text": "我是不是法定盲人，我到处都看不到它，它在哪里，"}, {"type": "subtitle", "time": 1355.75, "timestamp": "00:22:35", "text": "它不在那里。 不，不，"}, {"type": "subtitle", "time": 1357.75, "timestamp": "00:22:37", "text": "不在这里。"}, {"type": "subtitle", "time": 1364.87, "timestamp": "00:22:44", "text": "美好的。 我直播的时候不会听音乐"}, {"type": "subtitle", "time": 1366.47, "timestamp": "00:22:46", "text": "。"}, {"type": "subtitle", "time": 1368.31, "timestamp": "00:22:48", "text": "哎，真是"}]
[{"type": "subtitle", "time": 12244.15, "timestamp": "03:24:04", "text": "我的天哪。味道太棒了。哇。"}, {"type": "subtitle", "time": 12275.19, "timestamp": "03:24:35", "text": "有一天我吃了一整盒，从那以后"}, {"type": "subtitle", "time": 12278.87, "timestamp": "03:24:38", "text": "我就讨厌它们的味道了。哦不。是"}, {"type": "subtitle", "time": 12282.389, "timestamp": "03:24:42", "text": "啊。你不应该吃一整盒。是"}, {"type": "subtitle", "time": 12286.15, "timestamp": "03:24:46", "text": "啊。你会不会摄入太多这种高热量或含糖"}, {"type": "subtitle", "time": 12290.15, "timestamp": "03:24:50", "text": "食品，然后"}, {"type": "subtitle", "time": 12291.67, "timestamp": "03:24:51", "text": "感觉"}, {"type": "subtitle", "time": 12294.79, "timestamp": "03:24:54", "text": "吃不下了？是"}]
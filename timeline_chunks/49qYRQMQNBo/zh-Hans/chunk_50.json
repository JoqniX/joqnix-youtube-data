[{"type": "subtitle", "time": 3000.87, "timestamp": "00:50:00", "text": "所以"}, {"type": "subtitle", "time": 3004.95, "timestamp": "00:50:04", "text": "，嗯，我要求添加很多功能，"}, {"type": "subtitle", "time": 3007.19, "timestamp": "00:50:07", "text": "而且我不想，我不想让他像"}, {"type": "subtitle", "time": 3010.39, "timestamp": "00:50:10", "text": "我要求的那样添加太多东西，"}, {"type": "subtitle", "time": 3013.51, "timestamp": "00:50:13", "text": "让它变得太"}, {"type": "subtitle", "time": 3015.349, "timestamp": "00:50:15", "text": "臃肿，对吧？我们不想让游戏变得"}, {"type": "subtitle", "time": 3017.589, "timestamp": "00:50:17", "text": "臃肿，就像"}, {"type": "subtitle", "time": 3020.549, "timestamp": "00:50:20", "text": "流媒体元素和其他软件、应用程序、"}, {"type": "subtitle", "time": 3023.19, "timestamp": "00:50:23", "text": "直播应用程序那样，所以，是的，"}, {"type": "subtitle", "time": 3025.109, "timestamp": "00:50:25", "text": "游戏目前我们保持简单，而且"}, {"type": "subtitle", "time": 3028.23, "timestamp": "00:50:28", "text": "耗电量也不大，"}, {"type": "subtitle", "time": 3031.03, "timestamp": "00:50:31", "text": "这很好。 所以，我计划在"}, {"type": "subtitle", "time": 3033.75, "timestamp": "00:50:33", "text": "她添加那个功能后，"}, {"type": "subtitle", "time": 3036.549, "timestamp": "00:50:36", "text": "展示一下后置摄像头，"}, {"type": "subtitle", "time": 3039.03, "timestamp": "00:50:39", "text": "比如我现在在日本，这样我就可以展示一些"}, {"type": "subtitle", "time": 3041.99, "timestamp": "00:50:41", "text": "景色之类的，比如看看"}, {"type": "subtitle", "time": 3044.549, "timestamp": "00:50:44", "text": "这个，看看那个，对吧，就是这样。"}, {"type": "subtitle", "time": 3047.27, "timestamp": "00:50:47", "text": "我可以隐藏"}, {"type": "subtitle", "time": 3049.75, "timestamp": "00:50:49", "text": "场景，比如隐藏来源，隐藏"}, {"type": "subtitle", "time": 3052.39, "timestamp": "00:50:52", "text": "来源的可见性，对吧，这就是"}, {"type": "subtitle", "time": 3056.87, "timestamp": "00:50:56", "text": "我计划做的，对吧？"}, {"type": "subtitle", "time": 3059.43, "timestamp": "00:50:59", "text": "但我不能一直让手机"}]
[{"type": "subtitle", "time": 6182.87, "timestamp": "01:43:02", "text": "哦，这个鼓。"}, {"type": "subtitle", "time": 6196.07, "timestamp": "01:43:16", "text": "在游戏厅之类的地方见过。"}, {"type": "subtitle", "time": 6199.03, "timestamp": "01:43:19", "text": "哦，对。我说过，我上次去东京的时候，为了"}, {"type": "subtitle", "time": 6204.31, "timestamp": "01:43:24", "text": "学校的事情，"}, {"type": "subtitle", "time": 6206.79, "timestamp": "01:43:26", "text": "一路去了东京，"}, {"type": "subtitle", "time": 6211.75, "timestamp": "01:43:31", "text": "我去了一个游戏厅，就像那种"}, {"type": "subtitle", "time": 6215.83, "timestamp": "01:43:35", "text": "扭蛋机，扭蛋机，就像一个"}, {"type": "subtitle", "time": 6218.47, "timestamp": "01:43:38", "text": "摆满了抓娃娃机和"}, {"type": "subtitle", "time": 6224.229, "timestamp": "01:43:44", "text": "街机游戏的商店。 等等。我看到那个"}, {"type": "subtitle", "time": 6228.629, "timestamp": "01:43:48", "text": "街机游戏机，那个人"}, {"type": "subtitle", "time": 6232.55, "timestamp": "01:43:52", "text": "好像是个十几岁的少年。他在玩那种像"}, {"type": "subtitle", "time": 6235.75, "timestamp": "01:43:55", "text": "osu Tao一样的鼓机，对吧？"}, {"type": "subtitle", "time": 6238.87, "timestamp": "01:43:58", "text": "Tao。我想它就叫这个名字。对，"}]
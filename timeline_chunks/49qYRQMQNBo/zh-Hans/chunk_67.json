[{"type": "subtitle", "time": 4023.109, "timestamp": "01:07:03", "text": "通往……呃……通往……通往……通往……通往……"}, {"type": "subtitle", "time": 4030.15, "timestamp": "01:07:10", "text": "梦境之类的入口。"}, {"type": "subtitle", "time": 4031.91, "timestamp": "01:07:11", "text": "他们这是在逃避现实"}, {"type": "subtitle", "time": 4033.589, "timestamp": "01:07:13", "text": "，"}, {"type": "subtitle", "time": 4035.51, "timestamp": "01:07:15", "text": "对吧？"}, {"type": "subtitle", "time": 4042.309, "timestamp": "01:07:22", "text": "实话"}, {"type": "subtitle", "time": 4045.349, "timestamp": "01:07:25", "text": "，我就是这种"}, {"type": "subtitle", "time": 4050.39, "timestamp": "01:07:30", "text": "感觉。 即使我当时想着要"}, {"type": "subtitle", "time": 4053.349, "timestamp": "01:07:33", "text": "不要回来，我也会想：“是啊，我"}, {"type": "subtitle", "time": 4056.39, "timestamp": "01:07:36", "text": "最了解我自己。我会开始"}, {"type": "subtitle", "time": 4058.23, "timestamp": "01:07:38", "text": "喋喋不休地"}, {"type": "subtitle", "time": 4061.51, "timestamp": "01:07:41", "text": "谈论一些事情，而这些喋喋不休的内容会"}, {"type": "subtitle", "time": 4068.71, "timestamp": "01:07:48", "text": "随着时间的推移从好的内容变成坏的内容，甚至变成一些不好的事情"}, {"type": "subtitle", "time": 4071.67, "timestamp": "01:07:51", "text": "。"}]
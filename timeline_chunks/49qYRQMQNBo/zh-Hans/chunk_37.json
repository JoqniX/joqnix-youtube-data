[{"type": "subtitle", "time": 2224.15, "timestamp": "00:37:04", "text": "如果我没记错的话，我们会在新加坡服务器上直播。"}, {"type": "subtitle", "time": 2227.51, "timestamp": "00:37:07", "text": "我的天哪，我忘了今天下雨了。 现在"}, {"type": "subtitle", "time": 2229.91, "timestamp": "00:37:09", "text": "地面潮湿，所以我们今天不能观星了"}, {"type": "subtitle", "time": 2246.79, "timestamp": "00:37:26", "text": "就像天上有很多云一样"}, {"type": "subtitle", "time": 2248.47, "timestamp": "00:37:28", "text": "。"}, {"type": "subtitle", "time": 2251.27, "timestamp": "00:37:31", "text": "所以很难看到星星飞向"}]
[{"type": "subtitle", "time": 10681.83, "timestamp": "02:58:01", "text": "还没跟我的同学们相处好呢。"}, {"type": "subtitle", "time": 10685.51, "timestamp": "02:58:05", "text": "这些二年级的学生都是"}, {"type": "subtitle", "time": 10687.51, "timestamp": "02:58:07", "text": "从一年级认识的，"}, {"type": "subtitle", "time": 10689.99, "timestamp": "02:58:09", "text": "去年他们一年级的时候就认识了，现在都二"}, {"type": "subtitle", "time": 10691.67, "timestamp": "02:58:11", "text": "年级了，"}, {"type": "subtitle", "time": 10706.63, "timestamp": "02:58:26", "text": "我不知道。你看，我习惯了"}, {"type": "subtitle", "time": 10710.389, "timestamp": "02:58:30", "text": "日本的教学方式，呃，我是在印度学的，"}, {"type": "subtitle", "time": 10713.51, "timestamp": "02:58:33", "text": "那种教学方式跟现在的教学不一样。"}, {"type": "subtitle", "time": 10715.59, "timestamp": "02:58:35", "text": "我跟不上"}, {"type": "subtitle", "time": 10727.75, "timestamp": "02:58:47", "text": "那就别说“"}, {"type": "subtitle", "time": 10731.269, "timestamp": "02:58:51", "text": "笨蛋”，你知道，那种人不懂玩笑，"}, {"type": "subtitle", "time": 10736.309, "timestamp": "02:58:56", "text": "别说真话。   是的"}, {"type": "subtitle", "time": 10738.55, "timestamp": "02:58:58", "text": "，我的同学，二年级的"}]
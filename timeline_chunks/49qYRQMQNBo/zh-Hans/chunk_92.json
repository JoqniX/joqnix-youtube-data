[{"type": "subtitle", "time": 5522.55, "timestamp": "01:32:02", "text": "。所以我发自内心地为他感到高兴。"}, {"type": "subtitle", "time": 5526.149, "timestamp": "01:32:06", "text": "我为他感到高兴。"}, {"type": "subtitle", "time": 5528.709, "timestamp": "01:32:08", "text": "但是，在内心"}, {"type": "subtitle", "time": 5531.35, "timestamp": "01:32:11", "text": "深处，我也会想，我的巅峰时刻什么时候到来"}, {"type": "subtitle", "time": 5534.39, "timestamp": "01:32:14", "text": "？我的巅峰"}, {"type": "subtitle", "time": 5537.43, "timestamp": "01:32:17", "text": "时刻什么时候才能到来？"}, {"type": "subtitle", "time": 5548.149, "timestamp": "01:32:28", "text": "我们有电饭煲、水壶和"}, {"type": "subtitle", "time": 5550.39, "timestamp": "01:32:30", "text": "烤箱。 是"}, {"type": "subtitle", "time": 5552.31, "timestamp": "01:32:32", "text": "啊。"}, {"type": "subtitle", "time": 5556.229, "timestamp": "01:32:36", "text": "呃，现在的问题是，因为"}, {"type": "subtitle", "time": 5559.11, "timestamp": "01:32:39", "text": "他做饭什么的，呃，他什么都用"}, {"type": "subtitle", "time": 5563.189, "timestamp": "01:32:43", "text": "精确的计量，对吧？"}, {"type": "subtitle", "time": 5565.91, "timestamp": "01:32:45", "text": "如果我"}, {"type": "subtitle", "time": 5569.189, "timestamp": "01:32:49", "text": "不告诉他就拿东西，比如拿个"}, {"type": "subtitle", "time": 5570.79, "timestamp": "01:32:50", "text": "鸡蛋"}, {"type": "subtitle", "time": 5573.51, "timestamp": "01:32:53", "text": "或者拿点米饭"}, {"type": "subtitle", "time": 5575.83, "timestamp": "01:32:55", "text": "什么的，对吧？不告诉他，"}, {"type": "subtitle", "time": 5578.87, "timestamp": "01:32:58", "text": "他的计算就会出错，"}]
[{"type": "subtitle", "time": 3484.87, "timestamp": "00:58:04", "text": "我的确放了两块钟。 是的。 是的。 是的。"}, {"type": "subtitle", "time": 3489.75, "timestamp": "00:58:09", "text": "呃，我是说在我的手机上。 你好。"}, {"type": "subtitle", "time": 3492.39, "timestamp": "00:58:12", "text": "所以，"}, {"type": "chat", "time": 3496.426, "timestamp": "00:58:16", "author": "@ProjectAizen", "avatar": "https://yt4.ggpht.com/J4g8YNWAMR7duRA_MC0DvcSZYNpONwi8eZHcWl3kui9q7oBp930GwOoPZ17Ct3rJcBQWDIsOKA=s64-c-k-c0x00ffffff-no-rj", "message": "I have to go to Taito next"}, {"type": "subtitle", "time": 3498.47, "timestamp": "00:58:18", "text": "我有很多话想说，但是"}, {"type": "subtitle", "time": 3500.23, "timestamp": "00:58:20", "text": "有些事情属于"}, {"type": "chat", "time": 3501.399, "timestamp": "00:58:21", "author": "@ProjectAizen", "avatar": "https://yt4.ggpht.com/J4g8YNWAMR7duRA_MC0DvcSZYNpONwi8eZHcWl3kui9q7oBp930GwOoPZ17Ct3rJcBQWDIsOKA=s64-c-k-c0x00ffffff-no-rj", "message": "Then back to Mumbai it is"}, {"type": "subtitle", "time": 3502.95, "timestamp": "00:58:22", "text": "个人隐私。 我不应该"}, {"type": "subtitle", "time": 3505.589, "timestamp": "00:58:25", "text": "在直播中开始卖东西，就像我"}, {"type": "subtitle", "time": 3509.349, "timestamp": "00:58:29", "text": "意识到的那样，我的问题是“不”，然后"}, {"type": "subtitle", "time": 3511.109, "timestamp": "00:58:31", "text": "我又得去Titto了，然后又回到"}, {"type": "subtitle", "time": 3515.19, "timestamp": "00:58:35", "text": "我的Hi Kacha，记住“狗式”这个词的"}, {"type": "subtitle", "time": 3517.19, "timestamp": "00:58:37", "text": "意思是跪着，如果"}, {"type": "subtitle", "time": 3518.789, "timestamp": "00:58:38", "text": "你看到了的话。还有，你的汉字读和写怎么样？"}, {"type": "subtitle", "time": 3530.309, "timestamp": "00:58:50", "text": "我现在还不会汉字，"}, {"type": "subtitle", "time": 3533.43, "timestamp": "00:58:53", "text": "水平还可以。 我感觉很吃力。 什么都忘了"}, {"type": "subtitle", "time": 3536.63, "timestamp": "00:58:56", "text": "。  N3课程开始。 我"}]
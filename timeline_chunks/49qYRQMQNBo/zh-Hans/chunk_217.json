[{"type": "subtitle", "time": 13033.19, "timestamp": "03:37:13", "text": "七个人说，"}, {"type": "subtitle", "time": 13035.429, "timestamp": "03:37:15", "text": "到目前为止，"}, {"type": "subtitle", "time": 13039.11, "timestamp": "03:37:19", "text": "甚至我的老师的老师，来自"}, {"type": "subtitle", "time": 13041.83, "timestamp": "03:37:21", "text": "卡贾坎的老师，来自"}, {"type": "subtitle", "time": 13044.309, "timestamp": "03:37:24", "text": "蒙古的老师，来自斯里兰卡"}, {"type": "subtitle", "time": 13046.389, "timestamp": "03:37:26", "text": "和孟加拉国的老师，"}, {"type": "subtitle", "time": 13048.95, "timestamp": "03:37:28", "text": "还有我的班主任，"}, {"type": "subtitle", "time": 13052.79, "timestamp": "03:37:32", "text": "我们都说：“什么？"}, {"type": "subtitle", "time": 13055.349, "timestamp": "03:37:35", "text": "“不行。”"}, {"type": "subtitle", "time": 13056.79, "timestamp": "03:37:36", "text": "好吧，我得去"}, {"type": "subtitle", "time": 13058.55, "timestamp": "03:37:38", "text": "7-11便利店把这些垃圾扔掉。"}, {"type": "subtitle", "time": 13062.07, "timestamp": "03:37:42", "text": "好了，我们回家吧。对了，"}, {"type": "subtitle", "time": 13071.75, "timestamp": "03:37:51", "text": "我都带了吗？我没"}, {"type": "subtitle", "time": 13074.469, "timestamp": "03:37:54", "text": "洒出来吧？好了，可以"}]
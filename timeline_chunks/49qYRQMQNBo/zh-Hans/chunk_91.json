[{"type": "subtitle", "time": 5464.229, "timestamp": "01:31:04", "text": "感觉就像，我直播什么的，都"}, {"type": "subtitle", "time": 5469.03, "timestamp": "01:31:09", "text": "感觉像是在做梦，感觉空虚，感觉"}, {"type": "subtitle", "time": 5471.669, "timestamp": "01:31:11", "text": "孤独什么的。我的意思是，如果"}, {"type": "subtitle", "time": 5473.99, "timestamp": "01:31:13", "text": "我和别人合作，就有人"}, {"type": "subtitle", "time": 5476.629, "timestamp": "01:31:16", "text": "可以聊天什么的，那很好。但是"}, {"type": "subtitle", "time": 5481.27, "timestamp": "01:31:21", "text": "现在如果你一个人直播，或者对着"}, {"type": "subtitle", "time": 5483.59, "timestamp": "01:31:23", "text": "空荡荡的屏幕直播，真的会"}, {"type": "subtitle", "time": 5486.629, "timestamp": "01:31:26", "text": "感觉很孤独。"}, {"type": "subtitle", "time": 5489.59, "timestamp": "01:31:29", "text": "所以，但是，"}, {"type": "subtitle", "time": 5493.189, "timestamp": "01:31:33", "text": "说实话，"}, {"type": "subtitle", "time": 5495.03, "timestamp": "01:31:35", "text": "我知道我不应该提"}, {"type": "subtitle", "time": 5498.79, "timestamp": "01:31:38", "text": "私事，但是，我真的非常感谢有"}, {"type": "subtitle", "time": 5501.91, "timestamp": "01:31:41", "text": "他，"}, {"type": "subtitle", "time": 5504.229, "timestamp": "01:31:44", "text": "因为我不会做饭。"}, {"type": "subtitle", "time": 5509.83, "timestamp": "01:31:49", "text": "他一直给我做饭，"}, {"type": "subtitle", "time": 5513.11, "timestamp": "01:31:53", "text": "确保我不会饿肚子，"}, {"type": "subtitle", "time": 5516.629, "timestamp": "01:31:56", "text": "对吧？他为我做了很多。我真的很"}, {"type": "subtitle", "time": 5518.79, "timestamp": "01:31:58", "text": "感激，他现在正处于事业的巅峰时期"}]
[{"type": "subtitle", "time": 11882.63, "timestamp": "03:18:02", "text": "嗯，大概132日元左右。鸡蛋。"}, {"type": "subtitle", "time": 11887.11, "timestamp": "03:18:07", "text": "你可以买到很便宜的。"}, {"type": "subtitle", "time": 11891.99, "timestamp": "03:18:11", "text": "比如，有时候能买到200日元或者"}, {"type": "subtitle", "time": 11894.79, "timestamp": "03:18:14", "text": "156日元的，"}, {"type": "subtitle", "time": 11897.59, "timestamp": "03:18:17", "text": "如果你运气好，"}, {"type": "subtitle", "time": 11900.309, "timestamp": "03:18:20", "text": "还能"}, {"type": "subtitle", "time": 11903.19, "timestamp": "03:18:23", "text": "在货架顶层买到快过期的鸡蛋之类的。"}, {"type": "subtitle", "time": 11908.229, "timestamp": "03:18:28", "text": "那大概是26日元，呃，126日元。"}, {"type": "subtitle", "time": 11910.07, "timestamp": "03:18:30", "text": "是的。"}, {"type": "subtitle", "time": 11912.63, "timestamp": "03:18:32", "text": "所以我们从Joy Foots买，呃，"}, {"type": "subtitle", "time": 11914.95, "timestamp": "03:18:34", "text": "第二个货架。这样可以再吃一个"}, {"type": "subtitle", "time": 11918.15, "timestamp": "03:18:38", "text": "星期。所以那一个大概是"}, {"type": "subtitle", "time": 11921.269, "timestamp": "03:18:41", "text": "156日元左右，差不多是这个价位，"}, {"type": "subtitle", "time": 11923.99, "timestamp": "03:18:43", "text": "加上税。我忘了税率了。所以如果"}, {"type": "subtitle", "time": 11925.91, "timestamp": "03:18:45", "text": "你的父母支付所有费用，"}, {"type": "subtitle", "time": 11931.59, "timestamp": "03:18:51", "text": "呃，第一个月。是的。第二个月。第"}, {"type": "subtitle", "time": 11938.389, "timestamp": "03:18:58", "text": "。就"}]
[{"type": "subtitle", "time": 1381.953, "timestamp": "00:23:01", "text": "后屋。哦是的， 我们要去那里"}, {"type": "subtitle", "time": 1382.834, "timestamp": "00:23:02", "text": "我们要去那里 随机任务"}, {"type": "subtitle", "time": 1384.019, "timestamp": "00:23:04", "text": "随机任务 那里。这是为什么呢？"}, {"type": "subtitle", "time": 1385.17, "timestamp": "00:23:05", "text": "那里。这是为什么呢？ 感觉像是"}, {"type": "subtitle", "time": 1386.197, "timestamp": "00:23:06", "text": "感觉像是 兄弟，气氛恐怖吗？"}, {"type": "subtitle", "time": 1387.597, "timestamp": "00:23:07", "text": "兄弟，气氛恐怖吗？ 为什么？这是因为"}, {"type": "subtitle", "time": 1388.767, "timestamp": "00:23:08", "text": "为什么？这是因为 我的夜间模式"}, {"type": "subtitle", "time": 1389.904, "timestamp": "00:23:09", "text": "我的夜间模式 摄像头？我勒个去？"}, {"type": "subtitle", "time": 1398.498, "timestamp": "00:23:18", "text": "我勒个去？等待，"}, {"type": "subtitle", "time": 1400.394, "timestamp": "00:23:20", "text": "等待。他们把现场清理干净了。"}, {"type": "subtitle", "time": 1403.667, "timestamp": "00:23:23", "text": "可口可乐。不，他们是……什么？"}, {"type": "subtitle", "time": 1406.273, "timestamp": "00:23:26", "text": "该死？不，他们是"}, {"type": "subtitle", "time": 1410.026, "timestamp": "00:23:30", "text": "可口可乐被移除。是的。"}, {"type": "subtitle", "time": 1411.886, "timestamp": "00:23:31", "text": "不，他们把它移除了。"}, {"type": "subtitle", "time": 1416.497, "timestamp": "00:23:36", "text": "可口可乐。不，他们是"}, {"type": "subtitle", "time": 1417.973, "timestamp": "00:23:37", "text": "他们真的把它移除了。"}, {"type": "subtitle", "time": 1421.474, "timestamp": "00:23:41", "text": "兄弟。它们确实是她的。"}, {"type": "subtitle", "time": 1423.622, "timestamp": "00:23:43", "text": "已清洗干净。但这个"}, {"type": "subtitle", "time": 1424.525, "timestamp": "00:23:44", "text": "番茄汁。"}, {"type": "subtitle", "time": 1427.068, "timestamp": "00:23:47", "text": "柠檬汁。"}, {"type": "subtitle", "time": 1429.334, "timestamp": "00:23:49", "text": "我很好奇他是什么样的人。"}]
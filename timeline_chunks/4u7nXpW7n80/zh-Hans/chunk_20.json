[{"type": "subtitle", "time": 1205.713, "timestamp": "00:20:05", "text": "正往回走。今天"}, {"type": "subtitle", "time": 1206.907, "timestamp": "00:20:06", "text": "我去报警了，"}, {"type": "subtitle", "time": 1208.198, "timestamp": "00:20:08", "text": "已报告盗窃案—— 几个小时前，"}, {"type": "subtitle", "time": 1209.295, "timestamp": "00:20:09", "text": "几个小时前， 大约两三"}, {"type": "subtitle", "time": 1210.198, "timestamp": "00:20:10", "text": "大约两三 几个小时前，晚上，因为"}, {"type": "subtitle", "time": 1211.457, "timestamp": "00:20:11", "text": "几个小时前，晚上，因为 我当时非常累。"}, {"type": "subtitle", "time": 1212.715, "timestamp": "00:20:12", "text": "我当时非常累。 今天已过"}, {"type": "subtitle", "time": 1213.942, "timestamp": "00:20:13", "text": "今天已过 大约七公里"}, {"type": "subtitle", "time": 1215.007, "timestamp": "00:20:15", "text": "大约七公里 八。我以前也是那样。"}, {"type": "subtitle", "time": 1220.799, "timestamp": "00:20:20", "text": "八。我以前也是那样。 筋疲力尽的。然后我"}, {"type": "subtitle", "time": 1222.527, "timestamp": "00:20:22", "text": "筋疲力尽的。然后我 心想：“好吧，"}, {"type": "subtitle", "time": 1223.551, "timestamp": "00:20:23", "text": "心想：“好吧， “气氛太棒了。”"}, {"type": "subtitle", "time": 1225.72, "timestamp": "00:20:25", "text": "“气氛太棒了。” 夜晚的外面"}, {"type": "subtitle", "time": 1226.683, "timestamp": "00:20:26", "text": "夜晚的外面 冷冷地。我眼前出现了星星。"}, {"type": "subtitle", "time": 1229.479, "timestamp": "00:20:29", "text": "冷冷地。我眼前出现了星星。 等等等等。我不是"}, {"type": "subtitle", "time": 1231.465, "timestamp": "00:20:31", "text": "等等等等。我不是 我每天都禁欲，对吧？我"}, {"type": "subtitle", "time": 1236.22, "timestamp": "00:20:36", "text": "我每天都禁欲，对吧？我 我知道我没有有所保留。"}, {"type": "subtitle", "time": 1237.462, "timestamp": "00:20:37", "text": "我知道我没有有所保留。 已经过去一周零三天了。"}, {"type": "subtitle", "time": 1243.468, "timestamp": "00:20:43", "text": "说实话，我每天都这样"}, {"type": "subtitle", "time": 1244.732, "timestamp": "00:20:44", "text": "在我灵魂深处"}, {"type": "subtitle", "time": 1245.645, "timestamp": "00:20:45", "text": "我以为我想要"}, {"type": "subtitle", "time": 1247.462, "timestamp": "00:20:47", "text": "直播我"}, {"type": "subtitle", "time": 1248.919, "timestamp": "00:20:48", "text": "我想念大家。我"}, {"type": "subtitle", "time": 1250.037, "timestamp": "00:20:50", "text": "我想念我的家人。"}, {"type": "subtitle", "time": 1251.555, "timestamp": "00:20:51", "text": "观众。我想你。"}, {"type": "subtitle", "time": 1252.958, "timestamp": "00:20:52", "text": "及其订阅者。"}, {"type": "subtitle", "time": 1254.75, "timestamp": "00:20:54", "text": "我想念大家。我"}, {"type": "subtitle", "time": 1256.062, "timestamp": "00:20:56", "text": "我想念那些人"}, {"type": "subtitle", "time": 1256.771, "timestamp": "00:20:56", "text": "进来吧"}, {"type": "subtitle", "time": 1258.118, "timestamp": "00:20:58", "text": "请与我联系。"}]
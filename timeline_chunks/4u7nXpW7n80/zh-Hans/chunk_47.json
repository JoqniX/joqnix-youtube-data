[{"type": "subtitle", "time": 2824.059, "timestamp": "00:47:04", "text": "他们开车去了。但是，但是，但是，"}, {"type": "subtitle", "time": 2825.657, "timestamp": "00:47:05", "text": "说实话，我应该吗？"}, {"type": "subtitle", "time": 2832.546, "timestamp": "00:47:12", "text": "这个时候你会在这里吗？有，"}, {"type": "subtitle", "time": 2834.071, "timestamp": "00:47:14", "text": "这种情况发生在流媒体中"}, {"type": "subtitle", "time": 2835.322, "timestamp": "00:47:15", "text": "“闲聊”形式"}, {"type": "subtitle", "time": 2836.769, "timestamp": "00:47:16", "text": "如果我没记错的话。"}, {"type": "subtitle", "time": 2840.573, "timestamp": "00:47:20", "text": "有时像这样"}, {"type": "subtitle", "time": 2841.954, "timestamp": "00:47:21", "text": "发生在“闲聊”中"}, {"type": "subtitle", "time": 2849.907, "timestamp": "00:47:29", "text": "可能在溪流里。但"}, {"type": "subtitle", "time": 2850.927, "timestamp": "00:47:30", "text": "气氛就是这样。"}, {"type": "subtitle", "time": 2857.855, "timestamp": "00:47:37", "text": "寒冷的。现在正在工作"}, {"type": "subtitle", "time": 2858.929, "timestamp": "00:47:38", "text": "同时做两份工作。"}, {"type": "subtitle", "time": 2860.041, "timestamp": "00:47:40", "text": "相当平静。"}, {"type": "subtitle", "time": 2861.327, "timestamp": "00:47:41", "text": "等等，你在工作。"}, {"type": "subtitle", "time": 2868.868, "timestamp": "00:47:48", "text": "同时做两份工作？或者"}, {"type": "subtitle", "time": 2869.992, "timestamp": "00:47:49", "text": "对我来说，这值得吗？"}, {"type": "subtitle", "time": 2871.747, "timestamp": "00:47:51", "text": "去那里吗？太可怕了。 哥们儿。啊，今晚。"}]
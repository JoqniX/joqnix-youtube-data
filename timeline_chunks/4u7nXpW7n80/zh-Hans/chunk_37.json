[{"type": "subtitle", "time": 2221.057, "timestamp": "00:37:01", "text": "与互联网有关的事情"}, {"type": "subtitle", "time": 2222.167, "timestamp": "00:37:02", "text": "你什么时候在外面？"}, {"type": "subtitle", "time": 2227.192, "timestamp": "00:37:07", "text": "什么手机"}, {"type": "subtitle", "time": 2228.037, "timestamp": "00:37:08", "text": "你是操作员"}, {"type": "subtitle", "time": 2231.051, "timestamp": "00:37:11", "text": "你用它吗？我不是"}, {"type": "subtitle", "time": 2232.243, "timestamp": "00:37:12", "text": "我问这个问题是因为……"}, {"type": "chat", "time": 2232.533, "timestamp": "00:37:12", "author": "@MikazukiYure", "avatar": "https://yt4.ggpht.com/uuFSD7qVrZy0JUWrBRfSfEKIQpib7_2xP24Yiu1ND1Mq6uhaYIHDnA5EiGz_o33FUhHYvbCT9g=s64-c-k-c0x00ffffff-no-rj", "message": "sou danee"}, {"type": "subtitle", "time": 2235.396, "timestamp": "00:37:15", "text": "某些地区为什么"}, {"type": "subtitle", "time": 2236.626, "timestamp": "00:37:16", "text": "你不喝咖啡吗？"}, {"type": "subtitle", "time": 2240.399, "timestamp": "00:37:20", "text": "类似那样？哦，你"}, {"type": "subtitle", "time": 2242.332, "timestamp": "00:37:22", "text": "正确的。不，不，不。我"}, {"type": "subtitle", "time": 2243.561, "timestamp": "00:37:23", "text": "我得去睡觉了。"}, {"type": "subtitle", "time": 2246.35, "timestamp": "00:37:26", "text": "很快。我得走了。"}, {"type": "subtitle", "time": 2247.564, "timestamp": "00:37:27", "text": "睡觉。我需要"}, {"type": "subtitle", "time": 2248.646, "timestamp": "00:37:28", "text": "早上6点起床"}, {"type": "subtitle", "time": 2251.332, "timestamp": "00:37:31", "text": "小时。 5 或 6 小时。"}, {"type": "subtitle", "time": 2254.7, "timestamp": "00:37:34", "text": "我需要去"}, {"type": "subtitle", "time": 2256.18, "timestamp": "00:37:36", "text": "兼职工作。我有"}, {"type": "subtitle", "time": 2257.389, "timestamp": "00:37:37", "text": "不，我没有。"}, {"type": "subtitle", "time": 2258.437, "timestamp": "00:37:38", "text": "自行车。所以"}, {"type": "subtitle", "time": 2259.597, "timestamp": "00:37:39", "text": "我今天就需要。"}, {"type": "subtitle", "time": 2260.758, "timestamp": "00:37:40", "text": "步行上班。"}, {"type": "subtitle", "time": 2264.079, "timestamp": "00:37:44", "text": "我会回来，我会休息。"}, {"type": "subtitle", "time": 2265.456, "timestamp": "00:37:45", "text": "我会再找一份工作。"}, {"type": "subtitle", "time": 2269.538, "timestamp": "00:37:49", "text": "我会上火车。"}, {"type": "subtitle", "time": 2274.525, "timestamp": "00:37:54", "text": "我会回来的。在家里的某个地方"}, {"type": "subtitle", "time": 2276.49, "timestamp": "00:37:56", "text": "那么，在晚上10点或9点半，"}, {"type": "subtitle", "time": 2278.509, "timestamp": "00:37:58", "text": "或许我有机会"}]
[{"type": "subtitle", "time": 721.808, "timestamp": "00:12:01", "text": "所以，丹尼，你可以"}, {"type": "subtitle", "time": 722.922, "timestamp": "00:12:02", "text": "注意到我没有"}, {"type": "subtitle", "time": 726.867, "timestamp": "00:12:06", "text": "禁欲一周零三个月"}, {"type": "subtitle", "time": 728.429, "timestamp": "00:12:08", "text": "或者四天。显然，"}, {"type": "subtitle", "time": 731.709, "timestamp": "00:12:11", "text": "我数不清了。我"}, {"type": "subtitle", "time": 734.328, "timestamp": "00:12:14", "text": "我已经很久没有有所保留了。展示"}, {"type": "subtitle", "time": 741.652, "timestamp": "00:12:21", "text": "开始于我有"}, {"type": "subtitle", "time": 746.546, "timestamp": "00:12:26", "text": "有很多事情要做，"}, {"type": "subtitle", "time": 750.254, "timestamp": "00:12:30", "text": "这一切是因为"}, {"type": "subtitle", "time": 754.528, "timestamp": "00:12:34", "text": "我其实做不到，嗯。"}, {"type": "subtitle", "time": 760.905, "timestamp": "00:12:40", "text": "把每件事都做好，"}, {"type": "subtitle", "time": 765.015, "timestamp": "00:12:45", "text": "或者你可以说"}, {"type": "subtitle", "time": 768.011, "timestamp": "00:12:48", "text": "正因为如此，我才无法"}, {"type": "subtitle", "time": 772.78, "timestamp": "00:12:52", "text": "为了做事，所以我"}, {"type": "subtitle", "time": 774.104, "timestamp": "00:12:54", "text": "优先考虑"}, {"type": "subtitle", "time": 775.33, "timestamp": "00:12:55", "text": "支线任务，"}, {"type": "subtitle", "time": 776.655, "timestamp": "00:12:56", "text": "实际上并非如此。"}, {"type": "subtitle", "time": 777.847, "timestamp": "00:12:57", "text": "已经很重要了，但是我"}, {"type": "subtitle", "time": 778.907, "timestamp": "00:12:58", "text": "还是得拥有它们"}]
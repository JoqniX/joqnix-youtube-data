[{"type": "subtitle", "time": 3182.5, "timestamp": "00:53:02", "text": "所有这些。是的，这些"}, {"type": "subtitle", "time": 3183.736, "timestamp": "00:53:03", "text": "紧身裤"}, {"type": "subtitle", "time": 3184.937, "timestamp": "00:53:04", "text": "我跟你说了那条新闻，"}, {"type": "subtitle", "time": 3188.996, "timestamp": "00:53:08", "text": "我很久以前领导的那个组织—— 长的。太好了。"}, {"type": "subtitle", "time": 3203.669, "timestamp": "00:53:23", "text": "天空中的摇滚乐手。 90"}, {"type": "subtitle", "time": 3220.174, "timestamp": "00:53:40", "text": "记录。我会活下去。"}, {"type": "subtitle", "time": 3221.384, "timestamp": "00:53:41", "text": "最美好的生活，"}, {"type": "subtitle", "time": 3224.223, "timestamp": "00:53:44", "text": "如果我在场的话。这是其中之一"}, {"type": "subtitle", "time": 3225.648, "timestamp": "00:53:45", "text": "死法之五种。"}]
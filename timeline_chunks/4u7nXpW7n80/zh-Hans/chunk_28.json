[{"type": "subtitle", "time": 1680.0, "timestamp": "00:28:00", "text": "以某种方式稳定下来"}, {"type": "subtitle", "time": 1683.022, "timestamp": "00:28:03", "text": "电话，你知道，当"}, {"type": "subtitle", "time": 1684.299, "timestamp": "00:28:04", "text": "我收集了足够的"}, {"type": "subtitle", "time": 1685.943, "timestamp": "00:28:05", "text": "钱。我现在"}, {"type": "subtitle", "time": 1686.893, "timestamp": "00:28:06", "text": "我推迟了，以便"}, {"type": "subtitle", "time": 1688.124, "timestamp": "00:28:08", "text": "组装一台游戏电脑"}, {"type": "subtitle", "time": 1689.425, "timestamp": "00:28:09", "text": "对于溪流而言，这样它"}, {"type": "subtitle", "time": 1690.199, "timestamp": "00:28:10", "text": "可以拉"}, {"type": "subtitle", "time": 1691.36, "timestamp": "00:28:11", "text": "广播和一切"}, {"type": "subtitle", "time": 1694.338, "timestamp": "00:28:14", "text": "其他。尤其是游戏"}, {"type": "subtitle", "time": 1698.008, "timestamp": "00:28:18", "text": "直播等等。我想"}, {"type": "subtitle", "time": 1699.659, "timestamp": "00:28:19", "text": "优质设备，因为 我想，我似乎会这么做。"}, {"type": "subtitle", "time": 1707.301, "timestamp": "00:28:27", "text": "我想，我似乎会这么做。 呃，在那之后"}, {"type": "subtitle", "time": 1708.299, "timestamp": "00:28:28", "text": "呃，在那之后 试图推迟"}, {"type": "subtitle", "time": 1709.607, "timestamp": "00:28:29", "text": "试图推迟 在稳定器上或"}, {"type": "subtitle", "time": 1710.811, "timestamp": "00:28:30", "text": "在稳定器上或 差不多就是这样。这"}, {"type": "subtitle", "time": 1716.809, "timestamp": "00:28:36", "text": "差不多就是这样。这 冷饮"}, {"type": "subtitle", "time": 1717.997, "timestamp": "00:28:37", "text": "冷饮 味道和气味都像药，"}, {"type": "subtitle", "time": 1719.365, "timestamp": "00:28:39", "text": "味道和气味都像药， 老兄。什么？这闻起来像"}, {"type": "subtitle", "time": 1727.729, "timestamp": "00:28:47", "text": "老兄。什么？这闻起来像 药品。什么是甜瓜？"}, {"type": "subtitle", "time": 1729.673, "timestamp": "00:28:49", "text": "药品。什么是甜瓜？ 壁球？这都什么鬼话？在"}, {"type": "subtitle", "time": 1736.451, "timestamp": "00:28:56", "text": "壁球？这都什么鬼话？在 我的天哪，这是药。我的天啊，"}, {"type": "subtitle", "time": 1738.337, "timestamp": "00:28:58", "text": "我的天哪，这是药。我的天啊， 这就是医学。我的天啊，这"}, {"type": "subtitle", "time": 1739.879, "timestamp": "00:28:59", "text": "这就是医学。我的天啊，这 药品。我的天哪，这是药。"}]
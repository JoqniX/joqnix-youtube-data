[{"type": "subtitle", "time": 3480.55, "timestamp": "00:58:00", "text": "愉悦。这样更好。"}, {"type": "subtitle", "time": 3482.128, "timestamp": "00:58:02", "text": "比他们拥有的更多。"}, {"type": "subtitle", "time": 3483.53, "timestamp": "00:58:03", "text": "这个柠檬"}, {"type": "subtitle", "time": 3485.821, "timestamp": "00:58:05", "text": "与水。这里很干净。"}, {"type": "subtitle", "time": 3489.215, "timestamp": "00:58:09", "text": "柠檬提取物。我的"}, {"type": "subtitle", "time": 3490.274, "timestamp": "00:58:10", "text": "室友"}, {"type": "subtitle", "time": 3491.264, "timestamp": "00:58:11", "text": "买了这件东西"}, {"type": "subtitle", "time": 3495.896, "timestamp": "00:58:15", "text": "非常好。它"}, {"type": "subtitle", "time": 3497.197, "timestamp": "00:58:17", "text": "这赋予了以下动力："}, {"type": "subtitle", "time": 3498.532, "timestamp": "00:58:18", "text": "即使需要，"}, {"type": "subtitle", "time": 3499.633, "timestamp": "00:58:19", "text": "你困了，要不要？"}, {"type": "subtitle", "time": 3500.7, "timestamp": "00:58:20", "text": "更快到达目的地"}, {"type": "subtitle", "time": 3504.338, "timestamp": "00:58:24", "text": "家。去做就对了。"}, {"type": "subtitle", "time": 3505.309, "timestamp": "00:58:25", "text": "几口。"}, {"type": "subtitle", "time": 3507.09, "timestamp": "00:58:27", "text": "你会得到一点"}, {"type": "subtitle", "time": 3513.797, "timestamp": "00:58:33", "text": "活力。是的。他们都是 我想我还是稍等片刻吧。"}, {"type": "subtitle", "time": 3519.77, "timestamp": "00:58:39", "text": "我想我还是稍等片刻吧。 关闭我们的摄像头。"}, {"type": "subtitle", "time": 3526.855, "timestamp": "00:58:46", "text": "我们切换到"}, {"type": "subtitle", "time": 3534.107, "timestamp": "00:58:54", "text": "歌手。快点。是的。"}, {"type": "subtitle", "time": 3537.638, "timestamp": "00:58:57", "text": "我的意思是，摄像机就在这里，所以"}, {"type": "subtitle", "time": 3539.075, "timestamp": "00:58:59", "text": "不用担心。它着火了。"}]
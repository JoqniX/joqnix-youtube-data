[{"type": "subtitle", "time": 2283.582, "timestamp": "00:38:03", "text": "我会留着它。或者还有……"}, {"type": "subtitle", "time": 2284.331, "timestamp": "00:38:04", "text": "可能性不"}, {"type": "subtitle", "time": 2286.193, "timestamp": "00:38:06", "text": "我会留着它。谁知道呢？"}, {"type": "subtitle", "time": 2298.593, "timestamp": "00:38:18", "text": "是的。好了，就是这样。"}, {"type": "subtitle", "time": 2299.469, "timestamp": "00:38:19", "text": "这位佛教徒"}, {"type": "subtitle", "time": 2305.111, "timestamp": "00:38:25", "text": "事物。这很有意思。"}, {"type": "subtitle", "time": 2314.494, "timestamp": "00:38:34", "text": "快点，快点。"}, {"type": "subtitle", "time": 2315.973, "timestamp": "00:38:35", "text": "我们一起过桥吧。"}, {"type": "subtitle", "time": 2318.845, "timestamp": "00:38:38", "text": "好的。我想展示"}, {"type": "subtitle", "time": 2328.937, "timestamp": "00:38:48", "text": "你有一座桥。我"}, {"type": "subtitle", "time": 2330.083, "timestamp": "00:38:50", "text": "已经习惯了"}, {"type": "subtitle", "time": 2331.368, "timestamp": "00:38:51", "text": "喝了一杯我感觉不到的咖啡"}, {"type": "subtitle", "time": 2332.411, "timestamp": "00:38:52", "text": "睡眠差异。"}, {"type": "subtitle", "time": 2334.611, "timestamp": "00:38:54", "text": "事实是……"}, {"type": "subtitle", "time": 2335.708, "timestamp": "00:38:55", "text": "现在如果我喝酒"}, {"type": "subtitle", "time": 2336.77, "timestamp": "00:38:56", "text": "咖啡或茶，它们"}, {"type": "subtitle", "time": 2338.14, "timestamp": "00:38:58", "text": "只是让我倾斜"}]
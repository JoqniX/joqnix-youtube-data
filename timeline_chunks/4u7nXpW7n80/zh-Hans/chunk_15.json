[{"type": "subtitle", "time": 902.16, "timestamp": "00:15:02", "text": "延迟。还。但"}, {"type": "subtitle", "time": 904.506, "timestamp": "00:15:04", "text": "请告诉我。好的。"}, {"type": "subtitle", "time": 909.582, "timestamp": "00:15:09", "text": "问候。我这是在干嘛？"}, {"type": "subtitle", "time": 911.26, "timestamp": "00:15:11", "text": "停止了吗？在哪里？这是哪里？"}, {"type": "subtitle", "time": 915.711, "timestamp": "00:15:15", "text": "曾是？是的。最后一个"}, {"type": "subtitle", "time": 917.181, "timestamp": "00:15:17", "text": "有时我们会玩《战魔》（Warog）。"}, {"type": "subtitle", "time": 920.147, "timestamp": "00:15:20", "text": "开玩笑。战犬"}, {"type": "subtitle", "time": 921.761, "timestamp": "00:15:21", "text": "真有意思。它"}, {"type": "subtitle", "time": 924.948, "timestamp": "00:15:24", "text": "非常好。我"}, {"type": "subtitle", "time": 925.867, "timestamp": "00:15:25", "text": "我想要，我希望"}, {"type": "subtitle", "time": 927.283, "timestamp": "00:15:27", "text": "返回此处"}, {"type": "subtitle", "time": 930.107, "timestamp": "00:15:30", "text": "游戏。她很有趣。是的。"}, {"type": "subtitle", "time": 936.039, "timestamp": "00:15:36", "text": "然后，是的，毫无征兆地，"}, {"type": "subtitle", "time": 937.076, "timestamp": "00:15:37", "text": "我下载了"}, {"type": "subtitle", "time": 938.558, "timestamp": "00:15:38", "text": "工作，兼职，"}, {"type": "subtitle", "time": 941.418, "timestamp": "00:15:41", "text": "每个人。虽然"}, {"type": "subtitle", "time": 942.6659999999999, "timestamp": "00:15:42", "text": "度假，我应该"}, {"type": "subtitle", "time": 943.878, "timestamp": "00:15:43", "text": "尽情享受吧！"}]
[{"type": "subtitle", "time": 1621.265, "timestamp": "00:27:01", "text": "没什么，我只是"}, {"type": "subtitle", "time": 1622.753, "timestamp": "00:27:02", "text": "我只会停留一个小时。"}, {"type": "subtitle", "time": 1624.169, "timestamp": "00:27:04", "text": "今天。我只是"}, {"type": "subtitle", "time": 1625.482, "timestamp": "00:27:05", "text": "我要去睡觉了。"}, {"type": "subtitle", "time": 1627.656, "timestamp": "00:27:07", "text": "现在12岁了。尽管"}, {"type": "subtitle", "time": 1629.164, "timestamp": "00:27:09", "text": "我起步晚了。我"}, {"type": "subtitle", "time": 1630.732, "timestamp": "00:27:10", "text": "我得去睡觉了。我有"}, {"type": "subtitle", "time": 1631.393, "timestamp": "00:27:11", "text": "没有矿井"}, {"type": "subtitle", "time": 1632.598, "timestamp": "00:27:12", "text": "自行车。我有"}, {"type": "subtitle", "time": 1633.693, "timestamp": "00:27:13", "text": "最近被盗"}, {"type": "subtitle", "time": 1638.894, "timestamp": "00:27:18", "text": "自行车。一些"}, {"type": "subtitle", "time": 1640.149, "timestamp": "00:27:20", "text": "必须步行"}, {"type": "subtitle", "time": 1641.403, "timestamp": "00:27:21", "text": "步行，呃，不，我"}, {"type": "subtitle", "time": 1642.621, "timestamp": "00:27:22", "text": "步行需要2个小时。"}, {"type": "subtitle", "time": 1643.876, "timestamp": "00:27:23", "text": "早上，大约在7点到"}, {"type": "subtitle", "time": 1645.315, "timestamp": "00:27:25", "text": "是的，如果我7点离开的话。"}, {"type": "subtitle", "time": 1646.717, "timestamp": "00:27:26", "text": "我将于9点到达。"}, {"type": "subtitle", "time": 1648.119, "timestamp": "00:27:28", "text": "准时上班"}, {"type": "subtitle", "time": 1649.485, "timestamp": "00:27:29", "text": "因为明天我有两个"}, {"type": "subtitle", "time": 1657.463, "timestamp": "00:27:37", "text": "兼职工作。呃，所以……"}, {"type": "subtitle", "time": 1658.35, "timestamp": "00:27:38", "text": "我会表现得很糟糕。"}, {"type": "subtitle", "time": 1659.205, "timestamp": "00:27:39", "text": "疲惫，但是"}, {"type": "subtitle", "time": 1660.377, "timestamp": "00:27:40", "text": "我会尽力做到一切。"}, {"type": "subtitle", "time": 1661.548, "timestamp": "00:2
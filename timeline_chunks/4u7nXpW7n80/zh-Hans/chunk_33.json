[{"type": "subtitle", "time": 1980.246, "timestamp": "00:33:00", "text": "我的天哪，别是在大街上。"}, {"type": "subtitle", "time": 1981.985, "timestamp": "00:33:01", "text": "灵魂。我感觉自己"}, {"type": "subtitle", "time": 1985.587, "timestamp": "00:33:05", "text": "令人惊叹。是的，孩子。它"}, {"type": "subtitle", "time": 1991.275, "timestamp": "00:33:11", "text": "太可爱了。你是鬼魂吗？"}, {"type": "subtitle", "time": 2012.151, "timestamp": "00:33:32", "text": "谁知道呢。谁知道呢。我"}, {"type": "subtitle", "time": 2013.613, "timestamp": "00:33:33", "text": "我喜欢空旷的街道。"}, {"type": "subtitle", "time": 2014.868, "timestamp": "00:33:34", "text": "是的，这就是我想要的原因。"}, {"type": "subtitle", "time": 2016.044, "timestamp": "00:33:36", "text": "直播。没错。"}, {"type": "subtitle", "time": 2021.323, "timestamp": "00:33:41", "text": "愉快。真好"}, {"type": "subtitle", "time": 2022.609, "timestamp": "00:33:42", "text": "放松点。"}, {"type": "subtitle", "time": 2023.665, "timestamp": "00:33:43", "text": "公园和"}, {"type": "subtitle", "time": 2024.951, "timestamp": "00:33:44", "text": "带你看看景色"}, {"type": "subtitle", "time": 2028.601, "timestamp": "00:33:48", "text": "空荡荡的街道"}, {"type": "subtitle", "time": 2034.746, "timestamp": "00:33:54", "text": "否则。这是什么东西？"}, {"type": "subtitle", "time": 2037.682, "timestamp": "00:33:57", "text": "这是什么？一张纸吗？"}]
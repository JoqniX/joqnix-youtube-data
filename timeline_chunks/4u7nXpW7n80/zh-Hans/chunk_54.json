[{"type": "subtitle", "time": 3241.465, "timestamp": "00:54:01", "text": "好的。哦，苏琪亚来了。"}, {"type": "subtitle", "time": 3245.966, "timestamp": "00:54:05", "text": "普通的苏基亚。作为"}, {"type": "subtitle", "time": 3247.47, "timestamp": "00:54:07", "text": "你看，那不是月亮。"}, {"type": "subtitle", "time": 3256.922, "timestamp": "00:54:16", "text": "所以，因此他们"}, {"type": "subtitle", "time": 3258.141, "timestamp": "00:54:18", "text": "派人"}, {"type": "subtitle", "time": 3259.427, "timestamp": "00:54:19", "text": "前往空间站。"}, {"type": "subtitle", "time": 3275.954, "timestamp": "00:54:35", "text": "哦，成功了。为什么"}, {"type": "subtitle", "time": 3277.018, "timestamp": "00:54:37", "text": "人们正在观看"}, {"type": "subtitle", "time": 3281.236, "timestamp": "00:54:41", "text": "我？很奇怪"}, {"type": "subtitle", "time": 3282.337, "timestamp": "00:54:42", "text": "外国人"}, {"type": "subtitle", "time": 3283.469, "timestamp": "00:54:43", "text": "真的就这么走过"}, {"type": "subtitle", "time": 3292.1, "timestamp": "00:54:52", "text": "晚上12:30的桥"}, {"type": "subtitle", "time": 3293.353, "timestamp": "00:54:53", "text": "周四？不，这是"}, {"type": "subtitle", "time": 3294.737, "timestamp": "00:54:54", "text": "星期五。今天"}, {"type": "subtitle", "time": 3296.973, "timestamp": "00:54:56", "text": "星期五，各位。我"}, {"type": "subtitle", "time": 3298.106, "timestamp": "00:54:58", "text": "我今天忘了这件事。"}, {"type": "subtitle", "time": 3299.379, "timestamp": "00:54:59", "text": "星期五。为我。"}]
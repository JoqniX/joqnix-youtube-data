[{"type": "subtitle", "time": 1276.118, "timestamp": "00:21:16", "text": "我当时就想：我不知道，"}, {"type": "subtitle", "time": 1277.603, "timestamp": "00:21:17", "text": "该怎么办？我不能"}, {"type": "subtitle", "time": 1279.067, "timestamp": "00:21:19", "text": "去做这件事。但我想要"}, {"type": "subtitle", "time": 1280.219, "timestamp": "00:21:20", "text": "以某种方式去做。"}, {"type": "subtitle", "time": 1284.846, "timestamp": "00:21:24", "text": "片刻。而且大多数情况下"}, {"type": "subtitle", "time": 1286.071, "timestamp": "00:21:26", "text": "我意识到我并不想那样做。"}, {"type": "subtitle", "time": 1287.168, "timestamp": "00:21:27", "text": "因……而加以限制"}, {"type": "subtitle", "time": 1287.877, "timestamp": "00:21:27", "text": "就我而言"}, {"type": "subtitle", "time": 1289.135, "timestamp": "00:21:29", "text": "累了，不想……"}, {"type": "subtitle", "time": 1290.038, "timestamp": "00:21:30", "text": "给你看"}, {"type": "subtitle", "time": 1291.102, "timestamp": "00:21:31", "text": "一只疲惫的“狗”，"}, {"type": "subtitle", "time": 1297.909, "timestamp": "00:21:37", "text": "你来的时候。你"}, {"type": "subtitle", "time": 1299.273, "timestamp": "00:21:39", "text": "想玩得开心，"}, {"type": "subtitle", "time": 1300.453, "timestamp": "00:21:40", "text": "微笑，然后我"}, {"type": "subtitle", "time": 1309.028, "timestamp": "00:21:49", "text": "我想把这个送给你。所以"}, {"type": "subtitle", "time": 1311.48, "timestamp": "00:21:51", "text": "我的理由如下。所以。"}, {"type": "subtitle", "time": 1314.013, "timestamp": "00:21:54", "text": "今天我只是"}, {"type": "subtitle", "time": 1315.212, "timestamp": "00:21:55", "text": "想聊聊"}, {"type": "subtitle", "time": 1318.119, "timestamp": "00:21:58", "text": "关于生活等等。"}]
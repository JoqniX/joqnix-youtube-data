[{"type": "subtitle", "time": 4025.682, "timestamp": "01:07:05", "text": "是的，第六场战斗。战地6"}, {"type": "subtitle", "time": 4030.409, "timestamp": "01:07:10", "text": "三天前很便宜"}, {"type": "subtitle", "time": 4033.127, "timestamp": "01:07:13", "text": "战魔出现了。我想要"}, {"type": "subtitle", "time": 4034.847, "timestamp": "01:07:14", "text": "去买它。然后我"}, {"type": "subtitle", "time": 4036.199, "timestamp": "01:07:16", "text": "我犹豫着是否要"}, {"type": "subtitle", "time": 4037.388, "timestamp": "01:07:17", "text": "全部"}, {"type": "subtitle", "time": 4040.544, "timestamp": "01:07:20", "text": "《战地6》？所以我决定"}, {"type": "subtitle", "time": 4044.012, "timestamp": "01:07:24", "text": "我并没有决定不去。"}, {"type": "subtitle", "time": 4047.253, "timestamp": "01:07:27", "text": "买。现在我"}, {"type": "subtitle", "time": 4050.656, "timestamp": "01:07:30", "text": "我对此感到有点抱歉。"}, {"type": "subtitle", "time": 4052.795, "timestamp": "01:07:32", "text": "选择。现在我们需要"}, {"type": "subtitle", "time": 4053.752, "timestamp": "01:07:33", "text": "等他"}, {"type": "subtitle", "time": 4054.869, "timestamp": "01:07:34", "text": "价格会再次变得便宜"}, {"type": "subtitle", "time": 4055.955, "timestamp": "01:07:35", "text": "或者正在促销。"}, {"type": "subtitle", "time": 4064.446, "timestamp": "01:07:44", "text": "谢谢。谢谢你，培根。"}, {"type": "subtitle", "time": 4065.728, "timestamp": "01:07:45", "text": "进入星界"}, {"type": "subtitle", "time": 4070.775, "timestamp": "01:07:50", "text": "星座。谢谢。"}, {"type": "subtitle", "time": 4072.422, "timestamp": "01:07:52", "text": "于17日成为参与者"}, {"type": "subtitle", "time": 4076.049, "timestamp": "01:07:56", "text": "几个月。哇。谢谢。"}]
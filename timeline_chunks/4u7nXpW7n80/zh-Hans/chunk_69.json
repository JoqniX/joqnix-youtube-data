[{"type": "subtitle", "time": 4140.94, "timestamp": "01:09:00", "text": "。我的印度老师 我爸爸会带他们来。"}, {"type": "subtitle", "time": 4142.239, "timestamp": "01:09:02", "text": "我爸爸会带他们来。 我会把它们打包好。"}, {"type": "subtitle", "time": 4143.047, "timestamp": "01:09:03", "text": "我会把它们打包好。 我会把它转交给我"}, {"type": "subtitle", "time": 4144.1, "timestamp": "01:09:04", "text": "我会把它转交给我 老师，老师"}, {"type": "subtitle", "time": 4145.154, "timestamp": "01:09:05", "text": "老师，老师 把他们带给我。所以"}, {"type": "subtitle", "time": 4149.58, "timestamp": "01:09:09", "text": "把他们带给我。所以 我只需要"}, {"type": "subtitle", "time": 4150.714, "timestamp": "01:09:10", "text": "我只需要 会带走他们"}, {"type": "subtitle", "time": 4151.813, "timestamp": "01:09:11", "text": "会带走他们 组装一台电脑。我发现"}, {"type": "subtitle", "time": 4156.014, "timestamp": "01:09:16", "text": "组装一台电脑。我发现 电脑机箱，还有我"}, {"type": "subtitle", "time": 4157.328, "timestamp": "01:09:17", "text": "电脑机箱，还有我 剩下的买"}, {"type": "subtitle", "time": 4158.504, "timestamp": "01:09:18", "text": "剩下的买 只有主体，块体"}, {"type": "subtitle", "time": 4159.61, "timestamp": "01:09:19", "text": "只有主体，块体 电源和"}, {"type": "subtitle", "time": 4160.371, "timestamp": "01:09:20", "text": "电源和 冷却。是的。"}, {"type": "subtitle", "time": 4165.54, "timestamp": "01:09:25", "text": "冷却。是的。 全部。还有一些电缆"}, {"type": "subtitle", "time": 4167.583, "timestamp": "01:09:27", "text": "全部。还有一些电缆 。嗯，HDMI线，然后"}, {"type": "subtitle", "time": 4180.697, "timestamp": "01:09:40", "text": "DisplayPort 转 USB-C 或其他类似接口"}, {"type": "subtitle", "time": 4182.744, "timestamp": "01:09:42", "text": "像这样。但是，是从哪里来的呢？"}, {"type": "subtitle", "time": 4185.554, "timestamp": "01:09:45", "text": "哦，是的，它将来自"}, {"type": "subtitle", "time": 4189.658, "timestamp": "01:09:49", "text": "印度。我的老师"}, {"type": "subtitle", "time": 4190.851, "timestamp": "01:09:50", "text": "印度，他教导"}, {"type": "subtitle", "time": 4192.255, "timestamp": "01:09:52", "text": "我现在是日本人了"}, {"type": "subtitle", "time": 4195.282, "timestamp": "01:09:55", "text": "在印度。他现在就在那里。 在印度。他"}, {"type": "subtitle", "time": 4196.966, "timestamp": "01:09:56", "text": "在印度。他 将返回"}, {"type": "subtitle", "time": 4198.04, "timestamp": "01:09:58", "text": "将返回 日本下一个"}]
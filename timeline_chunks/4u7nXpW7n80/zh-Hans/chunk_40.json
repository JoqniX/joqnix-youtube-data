[{"type": "subtitle", "time": 2401.406, "timestamp": "00:40:01", "text": "加糖的红茶"}, {"type": "subtitle", "time": 2402.891, "timestamp": "00:40:02", "text": "喝了三杯，"}, {"type": "subtitle", "time": 2408.837, "timestamp": "00:40:08", "text": "上床睡觉了。而这"}, {"type": "subtitle", "time": 2409.879, "timestamp": "00:40:09", "text": "成为日常"}, {"type": "subtitle", "time": 2411.181, "timestamp": "00:40:11", "text": "例行公事到这种程度"}, {"type": "subtitle", "time": 2417.346, "timestamp": "00:40:17", "text": "每次每次我"}, {"type": "subtitle", "time": 2418.771, "timestamp": "00:40:18", "text": "我喝茶或咖啡，我"}, {"type": "subtitle", "time": 2425.165, "timestamp": "00:40:25", "text": "我想睡觉了。有没有"}, {"type": "subtitle", "time": 2426.445, "timestamp": "00:40:26", "text": "一些针对种族主义者的歧视"}, {"type": "subtitle", "time": 2428.384, "timestamp": "00:40:28", "text": "印第安人？视情况而定"}, {"type": "subtitle", "time": 2429.382, "timestamp": "00:40:29", "text": "从那一个"}, {"type": "subtitle", "time": 2430.477, "timestamp": "00:40:30", "text": "您所在的区域或地点"}, {"type": "subtitle", "time": 2436.977, "timestamp": "00:40:36", "text": "你是。呃，如果"}, {"type": "subtitle", "time": 2440.956, "timestamp": "00:40:40", "text": "我想，你现在应该在东京吧。"}, {"type": "subtitle", "time": 2443.633, "timestamp": "00:40:43", "text": "不多。没有把握。"}, {"type": "subtitle", "time": 2446.462, "timestamp": "00:40:46", "text": "我不知道。但并非如此。"}, {"type": "subtitle", "time": 2447.25, "timestamp": "00:40:47", "text": "很多人"}, {"type": "subtitle", "time": 2448.333, "timestamp": "00:40:48", "text": "给我看的"}, {"type": "subtitle", "time": 2449.646, "timestamp": "00:40:49", "text": "种族主义或仇外心理。"}, {"type": "subtitle", "time": 2458.251, "timestamp": "00:40:58", "text": "如果你去"}, {"type": "subtitle", "time": 2459.488, "timestamp": "00:40:59", "text": "荒川西区 触摸许多地方"}]
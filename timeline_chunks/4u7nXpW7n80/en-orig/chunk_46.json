[{"type": "subtitle", "time": 2767.75, "timestamp": "00:46:07", "text": "The issue is not I'm literally alone"}, {"type": "subtitle", "time": 2771.19, "timestamp": "00:46:11", "text": "and there's no one here. I'm literally"}, {"type": "subtitle", "time": 2773.43, "timestamp": "00:46:13", "text": "in the dark."}, {"type": "subtitle", "time": 2777.27, "timestamp": "00:46:17", "text": "God knows if a boogeyman comes."}, {"type": "subtitle", "time": 2780.71, "timestamp": "00:46:20", "text": "There's so many things, right? Why am I"}, {"type": "subtitle", "time": 2784.39, "timestamp": "00:46:24", "text": "night exploring like this?"}, {"type": "subtitle", "time": 2800.95, "timestamp": "00:46:40", "text": "If I'm watching your stream,"}, {"type": "subtitle", "time": 2804.23, "timestamp": "00:46:44", "text": "wait, really? Let's go,"}]
[{"type": "subtitle", "time": 2764.661, "timestamp": "00:46:04", "text": "問題不在於此。"}, {"type": "subtitle", "time": 2768.047, "timestamp": "00:46:08", "text": "我真的孤身一人，"}, {"type": "subtitle", "time": 2770.696, "timestamp": "00:46:10", "text": "這裡一個人也沒有。我"}, {"type": "subtitle", "time": 2772.013, "timestamp": "00:46:12", "text": "完全身處黑暗之中。"}, {"type": "subtitle", "time": 2774.758, "timestamp": "00:46:14", "text": "天知道它是否會到來"}, {"type": "subtitle", "time": 2778.378, "timestamp": "00:46:18", "text": "某種山毛櫸。太多了"}, {"type": "subtitle", "time": 2780.619, "timestamp": "00:46:20", "text": "一切都對吧？為什麼是我？"}, {"type": "subtitle", "time": 2781.956, "timestamp": "00:46:21", "text": "我通常晚上散步。"}, {"type": "subtitle", "time": 2785.153, "timestamp": "00:46:25", "text": "是這樣嗎？誰知道呢？"}, {"type": "subtitle", "time": 2800.029, "timestamp": "00:46:40", "text": "如果我看一下你的"}, {"type": "subtitle", "time": 2801.102, "timestamp": "00:46:41", "text": "流，等等，"}, {"type": "subtitle", "time": 2804.596, "timestamp": "00:46:44", "text": "嚴重地？走吧，V。"}]
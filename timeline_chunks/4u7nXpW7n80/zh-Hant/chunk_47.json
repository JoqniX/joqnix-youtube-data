[{"type": "subtitle", "time": 2824.059, "timestamp": "00:47:04", "text": "他們開車去了。但是，但是，但是，"}, {"type": "subtitle", "time": 2825.657, "timestamp": "00:47:05", "text": "說實話，我應該嗎？"}, {"type": "subtitle", "time": 2832.546, "timestamp": "00:47:12", "text": "這個時候你會在這裡嗎？有，"}, {"type": "subtitle", "time": 2834.071, "timestamp": "00:47:14", "text": "這種情況發生在串流媒體中"}, {"type": "subtitle", "time": 2835.322, "timestamp": "00:47:15", "text": "「閒聊」形式"}, {"type": "subtitle", "time": 2836.769, "timestamp": "00:47:16", "text": "如果我沒記錯的話。"}, {"type": "subtitle", "time": 2840.573, "timestamp": "00:47:20", "text": "有時像這樣"}, {"type": "subtitle", "time": 2841.954, "timestamp": "00:47:21", "text": "發生在「閒聊」中"}, {"type": "subtitle", "time": 2849.907, "timestamp": "00:47:29", "text": "可能在溪流裡。但"}, {"type": "subtitle", "time": 2850.927, "timestamp": "00:47:30", "text": "氣氛就是這樣。"}, {"type": "subtitle", "time": 2857.855, "timestamp": "00:47:37", "text": "寒冷的。現在正在工作"}, {"type": "subtitle", "time": 2858.929, "timestamp": "00:47:38", "text": "同時做兩份工作。"}, {"type": "subtitle", "time": 2860.041, "timestamp": "00:47:40", "text": "相當平靜。"}, {"type": "subtitle", "time": 2861.327, "timestamp": "00:47:41", "text": "等等，你在工作。"}, {"type": "subtitle", "time": 2868.868, "timestamp": "00:47:48", "text": "同時做兩份工作？或者"}, {"type": "subtitle", "time": 2869.992, "timestamp": "00:47:49", "text": "對我來說，這值得嗎？"}, {"type": "subtitle", "time": 2871.747, "timestamp": "00:47:51", "text": "去那裡嗎？太可怕了。 哥們兒。啊，今晚。"}]
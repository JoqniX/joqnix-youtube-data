[{"type": "subtitle", "time": 1865.674, "timestamp": "00:31:05", "text": "學位。是的，但是那個，"}, {"type": "subtitle", "time": 1868.421, "timestamp": "00:31:08", "text": "沒關係。神秘"}, {"type": "subtitle", "time": 1869.895, "timestamp": "00:31:09", "text": "仍然是個謎 。我一直都是這樣，一直都是這樣"}, {"type": "subtitle", "time": 1873.636, "timestamp": "00:31:13", "text": "。我一直都是這樣，一直都是這樣 我很困惑。我"}, {"type": "subtitle", "time": 1876.072, "timestamp": "00:31:16", "text": "我很困惑。我 我總是忘記這一點。"}, {"type": "subtitle", "time": 1877.505, "timestamp": "00:31:17", "text": "我總是忘記這一點。 Jock是個垃圾。我就是這個"}, {"type": "subtitle", "time": 1879.701, "timestamp": "00:31:19", "text": "Jock是個垃圾。我就是這個 所以，兩個都是我。"}, {"type": "subtitle", "time": 1882.524, "timestamp": "00:31:22", "text": "所以，兩個都是我。 是的。我的天哪，就是這樣了。"}, {"type": "subtitle", "time": 1884.612, "timestamp": "00:31:24", "text": "是的。我的天哪，就是這樣了。 感覺就像我"}, {"type": "subtitle", "time": 1885.723, "timestamp": "00:31:25", "text": "感覺就像我 我稱之為“是的”，"}, {"type": "subtitle", "time": 1887.96, "timestamp": "00:31:27", "text": "我稱之為“是的”， 男生。我看到了你的。"}, {"type": "subtitle", "time": 1897.571, "timestamp": "00:31:37", "text": "男生。我看到了你的。 陰影。是的，但是我的"}, {"type": "subtitle", "time": 1902.785, "timestamp": "00:31:42", "text": "陰影。是的，但是我的 影子看起來像…哦"}, {"type": "subtitle", "time": 1904.115, "timestamp": "00:31:44", "text": "影子看起來像…哦 該死，還有一些"}, {"type": "subtitle", "time": 1905.297, "timestamp": "00:31:45", "text": "該死，還有一些 一個玻璃製品。我的天啊，"}, {"type": "subtitle", "time": 1910.384, "timestamp": "00:31:50", "text": "一個玻璃製品。我的天啊， 我正要離開。兄弟，兄弟，"}, {"type": "subtitle", "time": 1914.206, "timestamp": "00:31:54", "text": "我正要離開。兄弟，兄弟， 你看到了嗎？你有沒有看到？"}, {"type": "subtitle", "time": 1917.421, "timestamp": "00:31:57", "text": "你看到了嗎？你有沒有看到？ 我幾乎……如果他"}, {"type": "subtitle", "time": 1918.655, "timestamp": "00:31:58", "text": "我幾乎……如果他 沒看見我。哦，兄弟，"}]
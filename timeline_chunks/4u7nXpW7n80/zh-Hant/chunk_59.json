[{"type": "subtitle", "time": 3540.3, "timestamp": "00:59:00", "text": "紅色指示燈。"}, {"type": "subtitle", "time": 3544.047, "timestamp": "00:59:04", "text": "是的，我已經很久沒有去過了。"}, {"type": "subtitle", "time": 3545.047, "timestamp": "00:59:05", "text": "用了這個"}, {"type": "subtitle", "time": 3545.798, "timestamp": "00:59:05", "text": "申請"}, {"type": "subtitle", "time": 3549.659, "timestamp": "00:59:09", "text": "串流媒體。是的，的確如此。"}, {"type": "subtitle", "time": 3554.374, "timestamp": "00:59:14", "text": "樂趣。所以，就像"}, {"type": "subtitle", "time": 3555.808, "timestamp": "00:59:15", "text": "萬物終將消逝"}, {"type": "subtitle", "time": 3559.687, "timestamp": "00:59:19", "text": "有時？和其他人一樣"}, {"type": "subtitle", "time": 3560.777, "timestamp": "00:59:20", "text": "最後一件事"}, {"type": "subtitle", "time": 3567.27, "timestamp": "00:59:27", "text": "有時？我想做"}, {"type": "subtitle", "time": 3568.571, "timestamp": "00:59:28", "text": "很多事，但沒有"}, {"type": "subtitle", "time": 3577.46, "timestamp": "00:59:37", "text": "我可以。天哪，我幾乎"}, {"type": "subtitle", "time": 3578.45, "timestamp": "00:59:38", "text": "展示了他的…"}, {"type": "subtitle", "time": 3582.206, "timestamp": "00:59:42", "text": "把手機伸進鏡子裡。"}, {"type": "subtitle", "time": 3584.221, "timestamp": "00:59:44", "text": "那裡有一面鏡子"}, {"type": "subtitle", "time": 3585.531, "timestamp": "00:59:45", "text": "表面。我的天啊。"}, {"type": "subtitle", "time": 3587.119, "timestamp": "00:59:47", "text": "謝天謝地我把它關掉了。"}, {"type": "subtitle", "time": 3588.83, "timestamp": "00:59:48", "text": "相機。啊，我當時"}, {"type": "subtitle", "time": 3590.077, "timestamp": "00:59:50", "text": "如此粗心大意"}, {"type": "subtitle", "time": 3593.033, "timestamp": "00:59:53", "text": "現在。你吃晚餐了嗎？是的 吃過晚餐了。哦，是的。"}]
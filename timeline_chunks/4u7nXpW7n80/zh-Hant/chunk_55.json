[{"type": "subtitle", "time": 3301.452, "timestamp": "00:55:01", "text": "對我來說，今天是星期五。"}, {"type": "subtitle", "time": 3311.099, "timestamp": "00:55:11", "text": "哦，等等。你可以"}, {"type": "subtitle", "time": 3313.265, "timestamp": "00:55:13", "text": "看看這個，呃，"}, {"type": "subtitle", "time": 3316.515, "timestamp": "00:55:16", "text": "拖車。哦，還有那個。"}, {"type": "subtitle", "time": 3320.631, "timestamp": "00:55:20", "text": "太酷了。是的，他們是"}, {"type": "subtitle", "time": 3321.879, "timestamp": "00:55:21", "text": "將貨物運送到"}, {"type": "subtitle", "time": 3323.128, "timestamp": "00:55:23", "text": "餐廳等等"}, {"type": "subtitle", "time": 3329.335, "timestamp": "00:55:29", "text": "這裡。我看到那裡"}, {"type": "subtitle", "time": 3330.234, "timestamp": "00:55:30", "text": "停車"}, {"type": "subtitle", "time": 3333.88, "timestamp": "00:55:33", "text": "自行車。謝謝你，"}, {"type": "subtitle", "time": 3335.232, "timestamp": "00:55:35", "text": "謝謝你送的小寶貝"}, {"type": "subtitle", "time": 3336.994, "timestamp": "00:55:36", "text": "直播，回頭見。"}, {"type": "subtitle", "time": 3338.193, "timestamp": "00:55:38", "text": "之後。問候。"}, {"type": "subtitle", "time": 3339.313, "timestamp": "00:55:39", "text": "感謝所有…"}, {"type": "subtitle", "time": 3342.515, "timestamp": "00:55:42", "text": "來了。謝謝。"}, {"type": "subtitle", "time": 3348.449, "timestamp": "00:55:48", "text": "來了。祝你好運"}, {"type": "subtitle", "time": 3357.599, "timestamp": "00:55:57", "text": "天。哇。哦，天哪。它"}, {"type": "subtitle", "time": 3358.767, "timestamp": "00:55:58", "text": "恐怖的一個月。作為"}, {"type": "subtitle", "time": 3359.923, "timestamp": "00:55:59", "text": "你的第一個考試通過了"}]
[{"type": "subtitle", "time": 3603.684, "timestamp": "01:00:03", "text": "我忘了說，我收下了。"}, {"type": "subtitle", "time": 3605.169, "timestamp": "01:00:05", "text": "參加錦標賽"}, {"type": "subtitle", "time": 3606.575, "timestamp": "01:00:06", "text": "被稱為純冠軍賽或"}, {"type": "subtitle", "time": 3613.109, "timestamp": "01:00:13", "text": "差不多就是這樣。呃……所以"}, {"type": "subtitle", "time": 3614.206, "timestamp": "01:00:14", "text": "不太確定"}, {"type": "subtitle", "time": 3615.403, "timestamp": "01:00:15", "text": "團隊組成、主題"}, {"type": "subtitle", "time": 3616.468, "timestamp": "01:00:16", "text": "以及其他一切。"}, {"type": "chat", "time": 3617.314, "timestamp": "01:00:17", "author": "@bakononcopiumm", "avatar": "https://yt4.ggpht.com/hb5sPAHLUD7fBrZZsmfkzISQWwRqI8BY1n8lceyhZz0sNISomD05pCwUe-GL2amD5y-voH_uYw=s64-c-k-c0x00ffffff-no-rj", "message": "whats that"}, {"type": "subtitle", "time": 3618.305, "timestamp": "01:00:18", "text": "我需要"}, {"type": "subtitle", "time": 3619.547, "timestamp": "01:00:19", "text": "了解遊戲規則。"}, {"type": "subtitle", "time": 3627.206, "timestamp": "01:00:27", "text": "是的。一位朋友"}, {"type": "subtitle", "time": 3628.611, "timestamp": "01:00:28", "text": "跟我說過這件事，"}, {"type": "subtitle", "time": 3630.015, "timestamp": "01:00:30", "text": "我心想：“嗯，有意思。” 我會盡力而為。"}, {"type": "subtitle", "time": 3637.179, "timestamp": "01:00:37", "text": "我會盡力而為。 我看看。獎"}, {"type": "subtitle", "time": 3641.218, "timestamp": "01:00:41", "text": "我看看。獎 大約50,000"}, {"type": "subtitle", "time": 3643.238, "timestamp": "01:00:43", "text": "大約50,000 日元 這基本上就是如果我"}, {"type": "subtitle", "time": 3648.824, "timestamp": "01:00:48", "text": "日元 這基本上就是如果我 我沒弄錯吧，呃，"}, {"type": "subtitle", "time": 3654.752, "timestamp": "01:00:54", "text": "大約4萬盧比"}, {"type": "subtitle", "time": 3658.389, "timestamp": "01:00:58", "text": "顯然。我覺得不是。"}]
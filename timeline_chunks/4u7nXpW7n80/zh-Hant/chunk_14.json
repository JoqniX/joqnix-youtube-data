[{"type": "subtitle", "time": 842.602, "timestamp": "00:14:02", "text": "我沒有選擇串流媒體播放，而是…"}, {"type": "subtitle", "time": 847.326, "timestamp": "00:14:07", "text": "參與了這些工作"}, {"type": "subtitle", "time": 848.615, "timestamp": "00:14:08", "text": "支線任務，"}, {"type": "subtitle", "time": 849.764, "timestamp": "00:14:09", "text": "這些都是必要的"}, {"type": "subtitle", "time": 850.844, "timestamp": "00:14:10", "text": "直播，這樣我就可以"}, {"type": "subtitle", "time": 851.819, "timestamp": "00:14:11", "text": "進行此類"}, {"type": "subtitle", "time": 853.177, "timestamp": "00:14:13", "text": "像現在這樣的廣播"}, {"type": "subtitle", "time": 855.827, "timestamp": "00:14:15", "text": "諸如此類，對吧？這些"}, {"type": "subtitle", "time": 857.092, "timestamp": "00:14:17", "text": "街道水流等等"}, {"type": "subtitle", "time": 858.072, "timestamp": "00:14:18", "text": "除此之外，我沒有別的了。"}, {"type": "subtitle", "time": 859.241, "timestamp": "00:14:19", "text": "太多了"}, {"type": "subtitle", "time": 860.506, "timestamp": "00:14:20", "text": "擔心一些事情 。一切都是自動化的。"}, {"type": "subtitle", "time": 863.753, "timestamp": "00:14:23", "text": "。一切都是自動化的。 雖然我"}, {"type": "subtitle", "time": 864.403, "timestamp": "00:14:24", "text": "雖然我 花了15分鐘。"}, {"type": "subtitle", "time": 865.846, "timestamp": "00:14:25", "text": "花了15分鐘。 配置"}, {"type": "subtitle", "time": 866.929, "timestamp": "00:14:26", "text": "配置 直播，因為我直播"}, {"type": "subtitle", "time": 868.265, "timestamp": "00:14:28", "text": "直播，因為我直播 在五個平台上運行。但"}, {"type": "subtitle", "time": 871.212, "timestamp": "00:14:31", "text": "在五個平台上運行。但 大概就是這樣。這將是必要的"}, {"type": "subtitle", "time": 872.697, "timestamp": "00:14:32", "text": "大概就是這樣。這將是必要的 採取行動。"}, {"type": "subtitle", "time": 877.856, "timestamp": "00:14:37", "text": "是的，嗯，是的。所以"}, {"type": "subtitle", "time": 883.058, "timestamp": "00:14:43", "text": "呃，我希望我還在。"}, {"type": "subtitle", "time": 885.8340000000001, "timestamp": "00:14:45", "text": "正在播出。請告訴我。"}, {"type": "subtitle", "time": 888.067, "timestamp": "00:14:48", "text": "好的？如果我的直播"}, {"type": "subtitle", "time": 889.164, "timestamp": "00:14:49", "text": "如果斷裂"}, {"type": "subtitle", "time": 890.579, "timestamp": "00:14:50", "text": "如果…網路將會消失"}, {"type": "subtitle", "time": 891.675, "timestamp": "00:14:51", "text": "寫道“期望”"}, {"type": "subtitle", "time": 892.595, "timestamp": "00:14:52", "text": "「影片」之類的"}, {"type": "subtitle", "time": 893.904, "timestamp": "00:14:53", "text": "請類似。"}, {"type": "subtitle", "time": 896.722, "timestamp": "00:14:56", "text": "請告訴我。或許"}, {"type": "subtitle", "time": 897.647, "timestamp": "00:14:57", "text": "成為一個問題"}, {"type": "subtitle", "time": 898.412, "timestamp": "00:14:58", "text": "比特率或"}]
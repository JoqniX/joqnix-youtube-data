[{"type": "subtitle", "time": 1565.872, "timestamp": "00:26:05", "text": "一秒鐘。好了，他在那裡。"}, {"type": "subtitle", "time": 1576.295, "timestamp": "00:26:16", "text": "這裡有一台攝影機。問候。好的 。是的，是檸檬。"}, {"type": "subtitle", "time": 1579.693, "timestamp": "00:26:19", "text": "。是的，是檸檬。 所以，檸檬汁"}, {"type": "subtitle", "time": 1581.071, "timestamp": "00:26:21", "text": "所以，檸檬汁 或類似的事情。這就是"}, {"type": "subtitle", "time": 1584.267, "timestamp": "00:26:24", "text": "或類似的事情。這就是 寫於此處。"}, {"type": "subtitle", "time": 1585.657, "timestamp": "00:26:25", "text": "寫於此處。 你知道，我不知道是哪一個。"}, {"type": "subtitle", "time": 1587.192, "timestamp": "00:26:27", "text": "你知道，我不知道是哪一個。 味道不錯。他"}, {"type": "subtitle", "time": 1589.105, "timestamp": "00:26:29", "text": "味道不錯。他 售價100日圓。所以，"}, {"type": "subtitle", "time": 1592.655, "timestamp": "00:26:32", "text": "售價100日圓。所以， 咱們喝吧。"}, {"type": "subtitle", "time": 1594.044, "timestamp": "00:26:34", "text": "咱們喝吧。 顯然。我仍然"}, {"type": "subtitle", "time": 1596.307, "timestamp": "00:26:36", "text": "顯然。我仍然 我關掉了攝影機。嗯，"}, {"type": "subtitle", "time": 1603.417, "timestamp": "00:26:43", "text": "我的手好冷。 ， 兄弟。這裡風好大。"}, {"type": "subtitle", "time": 1607.026, "timestamp": "00:26:47", "text": "， 兄弟。這裡風好大。 天氣好冷。在"}, {"type": "subtitle", "time": 1615.385, "timestamp": "00:26:55", "text": "經過這麼長時間"}, {"type": "subtitle", "time": 1616.787, "timestamp": "00:26:56", "text": "時間。是的，很遺憾，我"}, {"type": "subtitle", "time": 1618.029, "timestamp": "00:26:58", "text": "我不能留下來。"}, {"type": "subtitle", "time": 1619.058, "timestamp": "00:26:59", "text": "今天時間更長了。"}]
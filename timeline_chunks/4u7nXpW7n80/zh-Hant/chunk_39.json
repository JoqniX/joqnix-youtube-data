[{"type": "subtitle", "time": 2344.716, "timestamp": "00:39:04", "text": "睡覺。我的情況正好相反。在"}, {"type": "subtitle", "time": 2346.153, "timestamp": "00:39:06", "text": "我的效果恰恰相反。"}, {"type": "subtitle", "time": 2350.865, "timestamp": "00:39:10", "text": "這是因為我"}, {"type": "subtitle", "time": 2351.786, "timestamp": "00:39:11", "text": "身體已經習慣了。"}, {"type": "subtitle", "time": 2353.097, "timestamp": "00:39:13", "text": "將咖啡因視為"}, {"type": "subtitle", "time": 2360.721, "timestamp": "00:39:20", "text": "安眠藥。這部分原因在於…"}, {"type": "subtitle", "time": 2365.217, "timestamp": "00:39:25", "text": "我的錯。它"}, {"type": "subtitle", "time": 2366.66, "timestamp": "00:39:26", "text": "部分原因在我，"}, {"type": "subtitle", "time": 2372.264, "timestamp": "00:39:32", "text": "因為它還在印度境內。"}, {"type": "subtitle", "time": 2377.353, "timestamp": "00:39:37", "text": "在家的時候，嗯，晚上的時候"}, {"type": "subtitle", "time": 2378.552, "timestamp": "00:39:38", "text": "房子裡什麼也沒有。"}, {"type": "subtitle", "time": 2381.106, "timestamp": "00:39:41", "text": "吃。我的家人"}, {"type": "subtitle", "time": 2382.958, "timestamp": "00:39:42", "text": "大約在12點或1點左右睡著了"}, {"type": "subtitle", "time": 2384.811, "timestamp": "00:39:44", "text": "晚上，或者凌晨3點。"}, {"type": "subtitle", "time": 2389.501, "timestamp": "00:39:49", "text": "還沒睡。我"}, {"type": "subtitle", "time": 2390.631, "timestamp": "00:39:50", "text": "通常去"}, {"type": "subtitle", "time": 2391.761, "timestamp": "00:39:51", "text": "廚房，釀造"}]
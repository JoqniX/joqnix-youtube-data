[{"type": "subtitle", "time": 4202.39, "timestamp": "01:10:02", "text": "日本下一個 月。那是"}, {"type": "subtitle", "time": 4203.781, "timestamp": "01:10:03", "text": "月。那是 最後"}, {"type": "subtitle", "time": 4204.869, "timestamp": "01:10:04", "text": "最後 月。所以我問"}, {"type": "subtitle", "time": 4207.375, "timestamp": "01:10:07", "text": "月。所以我問 他能做到嗎？"}, {"type": "subtitle", "time": 4208.508, "timestamp": "01:10:08", "text": "他能做到嗎？ 幫我帶東西來？和"}, {"type": "subtitle", "time": 4211.94, "timestamp": "01:10:11", "text": "幫我帶東西來？和 他回答說：「是的，"}, {"type": "subtitle", "time": 4213.237, "timestamp": "01:10:13", "text": "他回答說：「是的， 「當然。」所以我非常"}, {"type": "subtitle", "time": 4216.055, "timestamp": "01:10:16", "text": "「當然。」所以我非常 興奮的。我"}, {"type": "subtitle", "time": 4218.889, "timestamp": "01:10:18", "text": "興奮的。我 需要一點"}, {"type": "subtitle", "time": 4219.612, "timestamp": "01:10:19", "text": "需要一點 為了省錢，"}, {"type": "subtitle", "time": 4220.698, "timestamp": "01:10:20", "text": "為了省錢， 雖然我現在"}, {"type": "subtitle", "time": 4221.619, "timestamp": "01:10:21", "text": "雖然我現在 擱淺。嗯，是的。我"}, {"type": "subtitle", "time": 4227.059, "timestamp": "01:10:27", "text": "擱淺。嗯，是的。我 需要收集"}, {"type": "subtitle", "time": 4228.091, "timestamp": "01:10:28", "text": "需要收集 收錢"}, {"type": "subtitle", "time": 4230.984, "timestamp": "01:10:30", "text": "收錢 全部。終於我可以"}, {"type": "subtitle", "time": 4234.511, "timestamp": "01:10:34", "text": "全部。終於我可以 玩遊戲無需"}, {"type": "subtitle", "time": 4235.514, "timestamp": "01:10:35", "text": "玩遊戲無需 筆記型電腦運作緩慢。嗯，"}, {"type": "subtitle", "time": 4245.574, "timestamp": "01:10:45", "text": "我終於可以玩遊戲了。"}, {"type": "subtitle", "time": 4246.908, "timestamp": "01:10:46", "text": "兄弟，在Warog上玩一點都不卡頓。"}, {"type": "subtitle", "time": 4249.201, "timestamp": "01:10:49", "text": "我不需要這麼做。"}, {"type": "subtitle", "time": 4250.25, "timestamp": "01:10:50", "text": "需要擔心"}, {"type": "subtitle", "time": 4256.623, "timestamp": "01:10:56", "text": "瑣事。而這"}, {"type": "subtitle", "time": 4257.703, "timestamp": "01:10:57", "text": "看起來會像"}, {"type": "subtitle", "time": 4259.245, "timestamp": "01:10:59", "text": "高幀率遊戲體驗。"}]
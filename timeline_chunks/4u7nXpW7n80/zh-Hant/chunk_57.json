[{"type": "subtitle", "time": 3446.679, "timestamp": "00:57:26", "text": "巴卡西，你。是的。什麼"}, {"type": "subtitle", "time": 3448.09, "timestamp": "00:57:28", "text": "發生了嗎？沒有什麼"}, {"type": "subtitle", "time": 3452.051, "timestamp": "00:57:32", "text": "像這樣。我當時在談論…"}, {"type": "subtitle", "time": 3453.279, "timestamp": "00:57:33", "text": "現在已經是十月了，"}, {"type": "subtitle", "time": 3457.213, "timestamp": "00:57:37", "text": "現在是十月。它"}, {"type": "subtitle", "time": 3459.516, "timestamp": "00:57:39", "text": "月……哦，是的。它"}, {"type": "subtitle", "time": 3460.777, "timestamp": "00:57:40", "text": "這個月怎麼樣？"}, {"type": "subtitle", "time": 3464.906, "timestamp": "00:57:44", "text": "命名？我們必須上場比賽。"}, {"type": "subtitle", "time": 3466.366, "timestamp": "00:57:46", "text": "玩遊戲，看恐怖電影，"}, {"type": "subtitle", "time": 3473.042, "timestamp": "00:57:53", "text": "是的？哦是的。"}, {"type": "subtitle", "time": 3474.146, "timestamp": "00:57:54", "text": "事實證明，這"}, {"type": "subtitle", "time": 3475.079, "timestamp": "00:57:55", "text": "檸檬"}, {"type": "subtitle", "time": 3477.001, "timestamp": "00:57:57", "text": "真酷。給予"}, {"type": "subtitle", "time": 3478.158, "timestamp": "00:57:58", "text": "某種費用"}]
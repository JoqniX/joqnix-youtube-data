[{"type": "subtitle", "time": 902.16, "timestamp": "00:15:02", "text": "延遲。還。但"}, {"type": "subtitle", "time": 904.506, "timestamp": "00:15:04", "text": "請告訴我。好的。"}, {"type": "subtitle", "time": 909.582, "timestamp": "00:15:09", "text": "問候。我這是在幹嘛？"}, {"type": "subtitle", "time": 911.26, "timestamp": "00:15:11", "text": "停止了嗎？在哪裡？這是哪裡？"}, {"type": "subtitle", "time": 915.711, "timestamp": "00:15:15", "text": "曾是？是的。最後一個"}, {"type": "subtitle", "time": 917.181, "timestamp": "00:15:17", "text": "有時我們會玩《戰魔》（Warog）。"}, {"type": "subtitle", "time": 920.147, "timestamp": "00:15:20", "text": "開玩笑。戰犬"}, {"type": "subtitle", "time": 921.761, "timestamp": "00:15:21", "text": "真有意思。它"}, {"type": "subtitle", "time": 924.948, "timestamp": "00:15:24", "text": "非常好。我"}, {"type": "subtitle", "time": 925.867, "timestamp": "00:15:25", "text": "我想要，我希望"}, {"type": "subtitle", "time": 927.283, "timestamp": "00:15:27", "text": "返回此處"}, {"type": "subtitle", "time": 930.107, "timestamp": "00:15:30", "text": "遊戲。她很有趣。是的。"}, {"type": "subtitle", "time": 936.039, "timestamp": "00:15:36", "text": "然後，是的，毫無徵兆地，"}, {"type": "subtitle", "time": 937.076, "timestamp": "00:15:37", "text": "我下載了"}, {"type": "subtitle", "time": 938.558, "timestamp": "00:15:38", "text": "工作，兼職，"}, {"type": "subtitle", "time": 941.418, "timestamp": "00:15:41", "text": "每個人。雖然"}, {"type": "subtitle", "time": 942.6659999999999, "timestamp": "00:15:42", "text": "度假，我應該"}, {"type": "subtitle", "time": 943.878, "timestamp": "00:15:43", "text": "盡情享受吧！"}]
[{"type": "subtitle", "time": 3182.5, "timestamp": "00:53:02", "text": "所有這些。是的，這些"}, {"type": "subtitle", "time": 3183.736, "timestamp": "00:53:03", "text": "緊身褲"}, {"type": "subtitle", "time": 3184.937, "timestamp": "00:53:04", "text": "我跟你說了那條新聞，"}, {"type": "subtitle", "time": 3188.996, "timestamp": "00:53:08", "text": "我很久以前領導的那個組織—— 長的。太好了。"}, {"type": "subtitle", "time": 3203.669, "timestamp": "00:53:23", "text": "天空中的搖滾樂手。 90"}, {"type": "subtitle", "time": 3220.174, "timestamp": "00:53:40", "text": "記錄。我會活下去。"}, {"type": "subtitle", "time": 3221.384, "timestamp": "00:53:41", "text": "最美好的生活，"}, {"type": "subtitle", "time": 3224.223, "timestamp": "00:53:44", "text": "如果我在場的話。這是其中之一"}, {"type": "subtitle", "time": 3225.648, "timestamp": "00:53:45", "text": "死法之五種。"}]
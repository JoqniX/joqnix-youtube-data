[{"type": "subtitle", "time": 1800.777, "timestamp": "00:30:00", "text": "對我來說是真的"}, {"type": "subtitle", "time": 1802.154, "timestamp": "00:30:02", "text": "說實話，這真是個謎。 。是的，好好想想。"}, {"type": "subtitle", "time": 1803.887, "timestamp": "00:30:03", "text": "。是的，好好想想。 像這樣。呃，利姆路"}, {"type": "subtitle", "time": 1805.792, "timestamp": "00:30:05", "text": "像這樣。呃，利姆路 暴風雨。從這個角度來看"}, {"type": "subtitle", "time": 1809.253, "timestamp": "00:30:09", "text": "暴風雨。從這個角度來看 角色，在"}, {"type": "subtitle", "time": 1810.089, "timestamp": "00:30:10", "text": "角色，在 黑暗並不存在。"}, {"type": "subtitle", "time": 1811.18, "timestamp": "00:30:11", "text": "黑暗並不存在。 性別。更像是，呃，"}, {"type": "subtitle", "time": 1815.006, "timestamp": "00:30:15", "text": "性別。更像是，呃， 性別中立"}, {"type": "subtitle", "time": 1816.41, "timestamp": "00:30:16", "text": "性別中立 雌雄同體性格"}, {"type": "subtitle", "time": 1817.779, "timestamp": "00:30:17", "text": "雌雄同體性格 。更像是，是，"}, {"type": "subtitle", "time": 1821.729, "timestamp": "00:30:21", "text": "。更像是，是， 他們給了他一個容器，"}, {"type": "subtitle", "time": 1823.019, "timestamp": "00:30:23", "text": "他們給了他一個容器， 或貝殼，"}, {"type": "subtitle", "time": 1823.915, "timestamp": "00:30:23", "text": "或貝殼， 人形外殼，"}, {"type": "subtitle", "time": 1825.313, "timestamp": "00:30:25", "text": "人形外殼， 她變成了人類"}, {"type": "subtitle", "time": 1826.747, "timestamp": "00:30:26", "text": "她變成了人類 你看到的版本。"}, {"type": "subtitle", "time": 1834.276, "timestamp": "00:30:34", "text": "但我……我是個男的。"}, {"type": "subtitle", "time": 1836.882, "timestamp": "00:30:36", "text": "有點困惑"}, {"type": "subtitle", "time": 1839.154, "timestamp": "00:30:39", "text": "可能是聲音。我是從"}, {"type": "subtitle", "time": 1840.701, "timestamp": "00:30:40", "text": "天生如此。是的"}, {"type": "subtitle", "time": 1842.136, "timestamp": "00:30:42", "text": "好，是的，是的，是的"}, {"type": "subtitle", "time": 1842.981, "timestamp": "00:30:42", "text": "不錯，嗯，"}, {"type": "subtitle", "time": 1844.416, "timestamp": "00:30:44", "text": "觀看此視頻"}, {"type": "subtitle", "time": 1845.777, "timestamp": "00:30:45", "text": "現在變得神秘莫測。"}, {"type": "subtitle", "time": 1847.498, "timestamp": "00:30:47", "text": "等等，我這是怎麼了，我只是…"}, {"type": "subtitle", "time": 1849.98, "timestamp": "00:30:49", "text": "這是否影響了印象？在"}, {"type": "subtitle", "time": 1851.165, "timestamp": "00:30:51", "text": "我的天哪，我剛剛把所有事情都做完了。"}, {"type": "subtitle", "time": 1852.89, "timestamp": "00:30:52", "text": "毀了。魔鬼。什麼"}, {"type": "subtitle", "time": 1857.132, "timestamp": "00:30:57", "text": "胡說八道什麼？這裡晚上溫度是60度。"}]
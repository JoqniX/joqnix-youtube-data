[{"type": "subtitle", "time": 3132.006, "timestamp": "00:52:12", "text": "下面是石頭。再見，"}, {"type": "subtitle", "time": 3135.992, "timestamp": "00:52:15", "text": "男子氣概。哦，這條河。"}, {"type": "subtitle", "time": 3141.216, "timestamp": "00:52:21", "text": "等等，誰還記得？"}, {"type": "subtitle", "time": 3143.394, "timestamp": "00:52:23", "text": "等等，你"}, {"type": "subtitle", "time": 3145.209, "timestamp": "00:52:25", "text": "你是否記得？我不知道。"}, {"type": "subtitle", "time": 3146.627, "timestamp": "00:52:26", "text": "你們大多數人都是新來的。 ， 正確的？從前，有一個"}, {"type": "subtitle", "time": 3149.49, "timestamp": "00:52:29", "text": "， 正確的？從前，有一個 當時，我正在直播"}, {"type": "subtitle", "time": 3150.919, "timestamp": "00:52:30", "text": "當時，我正在直播 印度沿海地區。有"}, {"type": "subtitle", "time": 3159.055, "timestamp": "00:52:39", "text": "是的，那時我有"}, {"type": "subtitle", "time": 3160.251, "timestamp": "00:52:40", "text": "僅音頻流。"}, {"type": "subtitle", "time": 3165.415, "timestamp": "00:52:45", "text": "沒有視覺上的"}, {"type": "subtitle", "time": 3166.748, "timestamp": "00:52:46", "text": "但有時我"}, {"type": "subtitle", "time": 3174.528, "timestamp": "00:52:54", "text": "播放了一段和我一樣的視頻"}, {"type": "subtitle", "time": 3175.897, "timestamp": "00:52:55", "text": "我去海邊，畫畫。"}, {"type": "subtitle", "time": 3177.34, "timestamp": "00:52:57", "text": "沙灘上寫著每個人的名字"}]
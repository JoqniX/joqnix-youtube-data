[{"type": "subtitle", "time": 3480.55, "timestamp": "00:58:00", "text": "愉悅。這樣更好。"}, {"type": "subtitle", "time": 3482.128, "timestamp": "00:58:02", "text": "比他們擁有的更多。"}, {"type": "subtitle", "time": 3483.53, "timestamp": "00:58:03", "text": "這個檸檬"}, {"type": "subtitle", "time": 3485.821, "timestamp": "00:58:05", "text": "與水。這裡很乾淨。"}, {"type": "subtitle", "time": 3489.215, "timestamp": "00:58:09", "text": "檸檬萃取物。我的"}, {"type": "subtitle", "time": 3490.274, "timestamp": "00:58:10", "text": "室友"}, {"type": "subtitle", "time": 3491.264, "timestamp": "00:58:11", "text": "買了這件東西"}, {"type": "subtitle", "time": 3495.896, "timestamp": "00:58:15", "text": "非常好。它"}, {"type": "subtitle", "time": 3497.197, "timestamp": "00:58:17", "text": "這賦予了以下動力："}, {"type": "subtitle", "time": 3498.532, "timestamp": "00:58:18", "text": "即使需要，"}, {"type": "subtitle", "time": 3499.633, "timestamp": "00:58:19", "text": "你困了，要不要？"}, {"type": "subtitle", "time": 3500.7, "timestamp": "00:58:20", "text": "更快到達目的地"}, {"type": "subtitle", "time": 3504.338, "timestamp": "00:58:24", "text": "家。去做就對了。"}, {"type": "subtitle", "time": 3505.309, "timestamp": "00:58:25", "text": "幾口。"}, {"type": "subtitle", "time": 3507.09, "timestamp": "00:58:27", "text": "你會得到一點"}, {"type": "subtitle", "time": 3513.797, "timestamp": "00:58:33", "text": "活力。是的。他們都是 我想我還是稍等片刻吧。"}, {"type": "subtitle", "time": 3519.77, "timestamp": "00:58:39", "text": "我想我還是稍等片刻吧。 關閉我們的攝影機。"}, {"type": "subtitle", "time": 3526.855, "timestamp": "00:58:46", "text": "我們切換到"}, {"type": "subtitle", "time": 3534.107, "timestamp": "00:58:54", "text": "歌手。快點。是的。"}, {"type": "subtitle", "time": 3537.638, "timestamp": "00:58:57", "text": "我的意思是，攝影機就在這裡，所以"}, {"type": "subtitle", "time": 3539.075, "timestamp": "00:58:59", "text": "不用擔心。它著火了。"}]
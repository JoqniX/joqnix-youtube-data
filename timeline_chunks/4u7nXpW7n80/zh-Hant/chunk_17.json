[{"type": "subtitle", "time": 1020.138, "timestamp": "00:17:00", "text": "你好。我正在直播嗎？好的，"}, {"type": "subtitle", "time": 1021.672, "timestamp": "00:17:01", "text": "兄弟，我又開始直播了。"}, {"type": "subtitle", "time": 1027.683, "timestamp": "00:17:07", "text": "正當我準備…"}, {"type": "subtitle", "time": 1028.854, "timestamp": "00:17:08", "text": "講述某事"}, {"type": "subtitle", "time": 1029.582, "timestamp": "00:17:09", "text": "重要，我的"}, {"type": "subtitle", "time": 1030.721, "timestamp": "00:17:10", "text": "應用程式崩潰了。"}, {"type": "subtitle", "time": 1031.639, "timestamp": "00:17:11", "text": "或沒有發送"}, {"type": "subtitle", "time": 1036.987, "timestamp": "00:17:16", "text": "向串流媒體發送訊號。是的。"}, {"type": "subtitle", "time": 1048.393, "timestamp": "00:17:28", "text": "那麼，我需要什麼呢？"}, {"type": "subtitle", "time": 1051.037, "timestamp": "00:17:31", "text": "開始？是的，我輸了。"}, {"type": "subtitle", "time": 1053.485, "timestamp": "00:17:33", "text": "你的意見。我是誰？"}, {"type": "subtitle", "time": 1054.67, "timestamp": "00:17:34", "text": "在學校買的"}, {"type": "subtitle", "time": 1058.7, "timestamp": "00:17:38", "text": "店鋪。我買了那件。"}, {"type": "subtitle", "time": 1059.89, "timestamp": "00:17:39", "text": "第二輛自行車"}, {"type": "subtitle", "time": 1061.112, "timestamp": "00:17:41", "text": "第二天… 不，不是第二次。"}, {"type": "subtitle", "time": 1062.076, "timestamp": "00:17:42", "text": "不，不是第二次。 實際上在第二點"}, {"type": "subtitle", "time": 1063.266, "timestamp": "00:17:43", "text": "實際上在第二點 學習日。在"}, {"type": "subtitle", "time": 1066.518, "timestamp": "00:17:46", "text": "學習日。在 第二天或第三天"}, {"type": "subtitle", "time": 1067.83, "timestamp": "00:17:47", "text": "第二天或第三天 了解我是否"}, {"type": "subtitle", "time": 1068.815, "timestamp": "00:17:48", "text": "了解我是否 我記得沒錯的話。在"}, {"type": "subtitle", "time": 1071.957, "timestamp": "00:17:51", "text": "我記得沒錯的話。在 週二。你知道嗎？"}, {"type": "subtitle", "time": 1077.708, "timestamp": "00:17:57", "text": "那是星期二，我"}]
[{"type": "subtitle", "time": 1381.953, "timestamp": "00:23:01", "text": "後屋。哦是的， 我們要去那裡"}, {"type": "subtitle", "time": 1382.834, "timestamp": "00:23:02", "text": "我們要去那裡 隨機任務"}, {"type": "subtitle", "time": 1384.019, "timestamp": "00:23:04", "text": "隨機任務 那裡。這是為什麼呢？"}, {"type": "subtitle", "time": 1385.17, "timestamp": "00:23:05", "text": "那裡。這是為什麼呢？ 感覺像是"}, {"type": "subtitle", "time": 1386.197, "timestamp": "00:23:06", "text": "感覺像是 兄弟，氣氛恐怖嗎？"}, {"type": "subtitle", "time": 1387.597, "timestamp": "00:23:07", "text": "兄弟，氣氛恐怖嗎？ 為什麼？這是因為"}, {"type": "subtitle", "time": 1388.767, "timestamp": "00:23:08", "text": "為什麼？這是因為 我的夜間模式"}, {"type": "subtitle", "time": 1389.904, "timestamp": "00:23:09", "text": "我的夜間模式 網路攝影機?我勒個去？"}, {"type": "subtitle", "time": 1398.498, "timestamp": "00:23:18", "text": "我勒個去？等待，"}, {"type": "subtitle", "time": 1400.394, "timestamp": "00:23:20", "text": "等待。他們把現場清理乾淨了。"}, {"type": "subtitle", "time": 1403.667, "timestamp": "00:23:23", "text": "可口可樂。不，他們是……什麼？"}, {"type": "subtitle", "time": 1406.273, "timestamp": "00:23:26", "text": "該死？不，他們是"}, {"type": "subtitle", "time": 1410.026, "timestamp": "00:23:30", "text": "可口可樂被移除。是的。"}, {"type": "subtitle", "time": 1411.886, "timestamp": "00:23:31", "text": "不，他們把它移除了。"}, {"type": "subtitle", "time": 1416.497, "timestamp": "00:23:36", "text": "可口可樂。不，他們是"}, {"type": "subtitle", "time": 1417.973, "timestamp": "00:23:37", "text": "他們真的把它移除了。"}, {"type": "subtitle", "time": 1421.474, "timestamp": "00:23:41", "text": "兄弟。它們確實是她的。"}, {"type": "subtitle", "time": 1423.622, "timestamp": "00:23:43", "text": "已清洗乾淨。但這個"}, {"type": "subtitle", "time": 1424.525, "timestamp": "00:23:44", "text": "番茄汁。"}, {"type": "subtitle", "time": 1427.068, "timestamp": "00:23:47", "text": "檸檬汁。"}, {"type": "subtitle", "time": 1429.334, "timestamp": "00:23:49", "text": "我很好奇他是什麼樣的人。"}]
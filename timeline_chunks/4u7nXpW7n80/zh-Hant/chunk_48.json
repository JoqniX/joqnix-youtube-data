[{"type": "subtitle", "time": 2884.425, "timestamp": "00:48:04", "text": "想像一下如果…"}, {"type": "subtitle", "time": 2885.593, "timestamp": "00:48:05", "text": "某種守衛或"}, {"type": "subtitle", "time": 2887.095, "timestamp": "00:48:07", "text": "他人。他們"}, {"type": "subtitle", "time": 2888.119, "timestamp": "00:48:08", "text": "他們會打電話"}, {"type": "subtitle", "time": 2900.357, "timestamp": "00:48:20", "text": "我。為什麼要有樓梯？"}, {"type": "subtitle", "time": 2921.605, "timestamp": "00:48:41", "text": "蒂諾。好的。哦，你沒有。"}, {"type": "subtitle", "time": 2924.963, "timestamp": "00:48:44", "text": "你可以坐在這裡。有，"}, {"type": "subtitle", "time": 2930.228, "timestamp": "00:48:50", "text": "問題在於，在"}, {"type": "subtitle", "time": 2931.574, "timestamp": "00:48:51", "text": "那樣的地方很可怕。"}, {"type": "subtitle", "time": 2932.919, "timestamp": "00:48:52", "text": "因為你永遠不知道會發生什麼"}, {"type": "subtitle", "time": 2937.577, "timestamp": "00:48:57", "text": "這種情況有可能發生。它就在那裡。"}, {"type": "subtitle", "time": 2939.112, "timestamp": "00:48:59", "text": "自行車？兄弟，我有"}]
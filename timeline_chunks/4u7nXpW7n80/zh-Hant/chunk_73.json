[{"type": "subtitle", "time": 4389.923, "timestamp": "01:13:09", "text": "是的。再見。是的。再見。"}, {"type": "subtitle", "time": 4397.877, "timestamp": "01:13:17", "text": "我知道，下巴。我的天啊。"}, {"type": "subtitle", "time": 4416.468, "timestamp": "01:13:36", "text": "我明白了"}, {"type": "subtitle", "time": 4417.761, "timestamp": "01:13:37", "text": "開闊的綠色 灰色球。這"}, {"type": "subtitle", "time": 4421.452, "timestamp": "01:13:41", "text": "灰色球。這 寶可夢相關的東西"}, {"type": "subtitle", "time": 4422.645, "timestamp": "01:13:42", "text": "寶可夢相關的東西 類別“只是”"}, {"type": "subtitle", "time": 4423.742, "timestamp": "01:13:43", "text": "類別“只是” 聖餐」。從不"}, {"type": "subtitle", "time": 4425.557, "timestamp": "01:13:45", "text": "聖餐」。從不 我沒想到會這樣。"}, {"type": "subtitle", "time": 4431.067, "timestamp": "01:13:51", "text": "這很有意思。公平的"}, {"type": "subtitle", "time": 4439.824, "timestamp": "01:13:59", "text": "因此，它將會過去。"}]
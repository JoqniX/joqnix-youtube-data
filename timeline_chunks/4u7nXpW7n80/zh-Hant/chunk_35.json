[{"type": "subtitle", "time": 2100.493, "timestamp": "00:35:00", "text": "機槍，等等，這 就像塗鴉一樣"}, {"type": "subtitle", "time": 2101.476, "timestamp": "00:35:01", "text": "就像塗鴉一樣 電視節目。那裡什麼也沒有。"}, {"type": "subtitle", "time": 2104.619, "timestamp": "00:35:04", "text": "電視節目。那裡什麼也沒有。 不。是的。是的。再見。"}, {"type": "subtitle", "time": 2113.461, "timestamp": "00:35:13", "text": "我該去哪裡？快點。"}, {"type": "subtitle", "time": 2116.728, "timestamp": "00:35:16", "text": "然後就直接走。我"}, {"type": "subtitle", "time": 2118.074, "timestamp": "00:35:18", "text": "我可以……我可以就……"}, {"type": "subtitle", "time": 2120.863, "timestamp": "00:35:20", "text": "直行。是的。它"}, {"type": "subtitle", "time": 2121.893, "timestamp": "00:35:21", "text": "如此美麗"}, {"type": "subtitle", "time": 2123.396, "timestamp": "00:35:23", "text": "國家。我很高興我"}, {"type": "subtitle", "time": 2125.894, "timestamp": "00:35:25", "text": "不在東京。東京"}, {"type": "subtitle", "time": 2127.141, "timestamp": "00:35:27", "text": "這次應該是，呃，"}, {"type": "subtitle", "time": 2128.535, "timestamp": "00:35:28", "text": "太擁擠之類的"}, {"type": "subtitle", "time": 2130.969, "timestamp": "00:35:30", "text": "像這樣。那裡一定會爆滿。"}, {"type": "subtitle", "time": 2133.046, "timestamp": "00:35:33", "text": "人們。我是說，"}, {"type": "subtitle", "time": 2134.444, "timestamp": "00:35:34", "text": "東京更多的是關於"}, {"type": "subtitle", "time": 2135.621, "timestamp": "00:35:35", "text": "夜生活等等"}, {"type": "subtitle", "time": 2139.376, "timestamp": "00:35:39", "text": "像這樣。看看那個。"}, {"type": "subtitle", "time": 2140.985, "timestamp": "00:35:40", "text": "領土。這些地區。"}, {"type": "subtitle", "time": 2146.269, "timestamp": "00:35:46", "text": "我的天哪，那裡現在有飛蛾了。"}, {"type": "subtitle", "time": 2149.215, "timestamp": "00:35:49", "text": "有一點"}, {"type": "subtitle", "time": 2150.523, "timestamp": "00:35:50", "text": "那隻嘗試過"}, {"type": "subtitle", "time": 2154.256, "timestamp": "00:35:54", "text": "試圖觸摸"}, {"type": "subtitle", "time": 2155.456, "timestamp": "00:35:55", "text": "手機，我只是"}, {"type": "subtitle", "time": 2158.677, "timestamp": "00:35:58", "text": "把他推開了。是的 。多麼美麗。我"}]
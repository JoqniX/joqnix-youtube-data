[{"type": "subtitle", "time": 784.712, "timestamp": "00:13:04", "text": "製作。我當時在健身。"}, {"type": "subtitle", "time": 785.819, "timestamp": "00:13:05", "text": "這種情況持續了一段時間，"}, {"type": "subtitle", "time": 787.175, "timestamp": "00:13:07", "text": "今天他們可以"}, {"type": "subtitle", "time": 788.604, "timestamp": "00:13:08", "text": "也就是說，結束了。"}, {"type": "subtitle", "time": 794.942, "timestamp": "00:13:14", "text": "所以我非常非常高興。 這些事，這些"}, {"type": "subtitle", "time": 795.935, "timestamp": "00:13:15", "text": "這些事，這些 支線任務，"}, {"type": "subtitle", "time": 797.001, "timestamp": "00:13:17", "text": "支線任務， 終於完成了。"}, {"type": "subtitle", "time": 806.591, "timestamp": "00:13:26", "text": "但是，你知道，可能"}, {"type": "subtitle", "time": 807.706, "timestamp": "00:13:27", "text": "這兩週，這周和"}, {"type": "subtitle", "time": 808.854, "timestamp": "00:13:28", "text": "過去，實際上"}, {"type": "subtitle", "time": 809.674, "timestamp": "00:13:29", "text": "對我來說"}, {"type": "subtitle", "time": 810.92, "timestamp": "00:13:30", "text": "長假"}, {"type": "subtitle", "time": 813.885, "timestamp": "00:13:33", "text": "整個秋季。現在"}, {"type": "subtitle", "time": 815.229, "timestamp": "00:13:35", "text": "現在是秋天。"}, {"type": "subtitle", "time": 816.793, "timestamp": "00:13:36", "text": "我也拿到了。"}, {"type": "subtitle", "time": 817.869, "timestamp": "00:13:37", "text": "秋季假期"}, {"type": "subtitle", "time": 824.857, "timestamp": "00:13:44", "text": "實際上，你知道，我"}, {"type": "subtitle", "time": 829.438, "timestamp": "00:13:49", "text": "我可以說，在"}, {"type": "subtitle", "time": 830.634, "timestamp": "00:13:50", "text": "休息期間我"}, {"type": "subtitle", "time": 831.514, "timestamp": "00:13:51", "text": "會有很多"}, {"type": "subtitle", "time": 834.164, "timestamp": "00:13:54", "text": "我曾經要直播"}, {"type": "subtitle", "time": 835.575, "timestamp": "00:13:55", "text": "做很多事情，"}, {"type": "subtitle", "time": 836.845, "timestamp": "00:13:56", "text": "是的，在我看來是這樣。"}, {"type": "subtitle", "time": 838.151, "timestamp": "00:13:58", "text": "實際上休息過了。"}]
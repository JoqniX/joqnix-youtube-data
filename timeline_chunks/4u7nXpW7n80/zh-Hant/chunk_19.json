[{"type": "subtitle", "time": 1140.244, "timestamp": "00:19:00", "text": "我很驚訝，因為 站得非常陡峭，"}, {"type": "subtitle", "time": 1141.521, "timestamp": "00:19:01", "text": "站得非常陡峭， 昂貴的自行車。在"}, {"type": "subtitle", "time": 1147.713, "timestamp": "00:19:07", "text": "昂貴的自行車。在 所有其他學生"}, {"type": "subtitle", "time": 1148.992, "timestamp": "00:19:08", "text": "所有其他學生 太不可思議了"}, {"type": "subtitle", "time": 1149.975, "timestamp": "00:19:09", "text": "太不可思議了 很酷的自行車。"}, {"type": "subtitle", "time": 1155.169, "timestamp": "00:19:15", "text": "Janchi 和所有那些事。"}, {"type": "subtitle", "time": 1156.916, "timestamp": "00:19:16", "text": "為什麼要上學？"}, {"type": "subtitle", "time": 1158.145, "timestamp": "00:19:18", "text": "騎自行車的兄弟？"}, {"type": "subtitle", "time": 1160.664, "timestamp": "00:19:20", "text": "為什麼是一輛自行車？"}, {"type": "subtitle", "time": 1161.424, "timestamp": "00:19:21", "text": "看起來像"}, {"type": "subtitle", "time": 1162.773, "timestamp": "00:19:22", "text": "普通的自行車？"}, {"type": "subtitle", "time": 1168.376, "timestamp": "00:19:28", "text": "我有一個黃色的。"}, {"type": "subtitle", "time": 1169.577, "timestamp": "00:19:29", "text": "有哪些類型的自行車？"}, {"type": "subtitle", "time": 1170.877, "timestamp": "00:19:30", "text": "還有七件——同樣"}, {"type": "subtitle", "time": 1172.044, "timestamp": "00:19:32", "text": "顏色相同"}, {"type": "subtitle", "time": 1173.1779999999999, "timestamp": "00:19:33", "text": "電機，為什麼？"}, {"type": "subtitle", "time": 1180.344, "timestamp": "00:19:40", "text": "我的天，兄弟？正因如此"}, {"type": "subtitle", "time": 1181.271, "timestamp": "00:19:41", "text": "今天對我來說"}, {"type": "subtitle", "time": 1182.696, "timestamp": "00:19:42", "text": "只好從8號走過去。"}, {"type": "subtitle", "time": 1190.041, "timestamp": "00:19:50", "text": "早上直到上午10點"}, {"type": "subtitle", "time": 1194.374, "timestamp": "00:19:54", "text": "你的工作場所。我"}, {"type": "subtitle", "time": 1195.733, "timestamp": "00:19:55", "text": "遲到了一小時。"}, {"type": "subtitle", "time": 1197.057, "timestamp": "00:19:57", "text": "然後又過了兩個小時"}]
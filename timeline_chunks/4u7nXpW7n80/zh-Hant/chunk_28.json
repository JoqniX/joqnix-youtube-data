[{"type": "subtitle", "time": 1680.0, "timestamp": "00:28:00", "text": "以某種方式穩定下來"}, {"type": "subtitle", "time": 1683.022, "timestamp": "00:28:03", "text": "電話，你知道，當"}, {"type": "subtitle", "time": 1684.299, "timestamp": "00:28:04", "text": "我收集了足夠的"}, {"type": "subtitle", "time": 1685.943, "timestamp": "00:28:05", "text": "錢。我現在"}, {"type": "subtitle", "time": 1686.893, "timestamp": "00:28:06", "text": "我推遲了，以便"}, {"type": "subtitle", "time": 1688.124, "timestamp": "00:28:08", "text": "組裝一台遊戲電腦"}, {"type": "subtitle", "time": 1689.425, "timestamp": "00:28:09", "text": "對於溪流而言，這樣它"}, {"type": "subtitle", "time": 1690.199, "timestamp": "00:28:10", "text": "可以拉"}, {"type": "subtitle", "time": 1691.36, "timestamp": "00:28:11", "text": "廣播和一切"}, {"type": "subtitle", "time": 1694.338, "timestamp": "00:28:14", "text": "其他。尤其是遊戲"}, {"type": "subtitle", "time": 1698.008, "timestamp": "00:28:18", "text": "直播等等。我想"}, {"type": "subtitle", "time": 1699.659, "timestamp": "00:28:19", "text": "優質設備，因為 我想，我似乎會這麼做。"}, {"type": "subtitle", "time": 1707.301, "timestamp": "00:28:27", "text": "我想，我似乎會這麼做。 呃，在那之後"}, {"type": "subtitle", "time": 1708.299, "timestamp": "00:28:28", "text": "呃，在那之後 試圖推遲"}, {"type": "subtitle", "time": 1709.607, "timestamp": "00:28:29", "text": "試圖推遲 在穩定器上或"}, {"type": "subtitle", "time": 1710.811, "timestamp": "00:28:30", "text": "在穩定器上或 差不多就是這樣。這"}, {"type": "subtitle", "time": 1716.809, "timestamp": "00:28:36", "text": "差不多就是這樣。這 冷飲"}, {"type": "subtitle", "time": 1717.997, "timestamp": "00:28:37", "text": "冷飲 味道和氣味都像藥，"}, {"type": "subtitle", "time": 1719.365, "timestamp": "00:28:39", "text": "味道和氣味都像藥， 老兄。什麼？這聞起來像"}, {"type": "subtitle", "time": 1727.729, "timestamp": "00:28:47", "text": "老兄。什麼？這聞起來像 藥品。什麼是甜瓜？"}, {"type": "subtitle", "time": 1729.673, "timestamp": "00:28:49", "text": "藥品。什麼是甜瓜？ 壁球？這都什麼鬼話？在"}, {"type": "subtitle", "time": 1736.451, "timestamp": "00:28:56", "text": "壁球？這都什麼鬼話？在 我的天哪，這是藥。我的天啊，"}, {"type": "subtitle", "time": 1738.337, "timestamp": "00:28:58", "text": "我的天哪，這是藥。我的天啊， 這就是醫學。我的天啊，這"}, {"type": "subtitle", "time": 1739.879, "timestamp": "00:28:59", "text": "這就是醫學。我的天啊，這 藥品。我的天哪，這是藥。"}]
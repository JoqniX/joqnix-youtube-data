[{"type": "subtitle", "time": 4025.682, "timestamp": "01:07:05", "text": "是的，第六場戰鬥。戰地6"}, {"type": "subtitle", "time": 4030.409, "timestamp": "01:07:10", "text": "三天前很便宜"}, {"type": "subtitle", "time": 4033.127, "timestamp": "01:07:13", "text": "戰魔出現了。我想要"}, {"type": "subtitle", "time": 4034.847, "timestamp": "01:07:14", "text": "去買它。然後我"}, {"type": "subtitle", "time": 4036.199, "timestamp": "01:07:16", "text": "我猶豫是否要"}, {"type": "subtitle", "time": 4037.388, "timestamp": "01:07:17", "text": "全部"}, {"type": "subtitle", "time": 4040.544, "timestamp": "01:07:20", "text": "《戰地6》？所以我決定"}, {"type": "subtitle", "time": 4044.012, "timestamp": "01:07:24", "text": "我並沒有決定不去。"}, {"type": "subtitle", "time": 4047.253, "timestamp": "01:07:27", "text": "買。現在我"}, {"type": "subtitle", "time": 4050.656, "timestamp": "01:07:30", "text": "我對此感到有點抱歉。"}, {"type": "subtitle", "time": 4052.795, "timestamp": "01:07:32", "text": "選擇。現在我們需要"}, {"type": "subtitle", "time": 4053.752, "timestamp": "01:07:33", "text": "等他"}, {"type": "subtitle", "time": 4054.869, "timestamp": "01:07:34", "text": "價格會再次變得便宜"}, {"type": "subtitle", "time": 4055.955, "timestamp": "01:07:35", "text": "或正在促銷。"}, {"type": "subtitle", "time": 4064.446, "timestamp": "01:07:44", "text": "謝謝。謝謝你，培根。"}, {"type": "subtitle", "time": 4065.728, "timestamp": "01:07:45", "text": "進入星界"}, {"type": "subtitle", "time": 4070.775, "timestamp": "01:07:50", "text": "星座。謝謝。"}, {"type": "subtitle", "time": 4072.422, "timestamp": "01:07:52", "text": "於17日成為參與者"}, {"type": "subtitle", "time": 4076.049, "timestamp": "01:07:56", "text": "幾個月。哇。謝謝。"}]
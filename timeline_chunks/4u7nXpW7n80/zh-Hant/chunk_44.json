[{"type": "subtitle", "time": 2642.148, "timestamp": "00:44:02", "text": "我只是想讓你"}, {"type": "subtitle", "time": 2643.174, "timestamp": "00:44:03", "text": "看到了海"}, {"type": "subtitle", "time": 2644.302, "timestamp": "00:44:04", "text": "波浪等等。"}, {"type": "subtitle", "time": 2646.799, "timestamp": "00:44:06", "text": "看看這些波浪。"}, {"type": "subtitle", "time": 2648.269, "timestamp": "00:44:08", "text": "真好"}, {"type": "subtitle", "time": 2649.801, "timestamp": "00:44:09", "text": "值得關注。但並非如此"}, {"type": "subtitle", "time": 2651.08, "timestamp": "00:44:11", "text": "你可以這樣站著"}, {"type": "subtitle", "time": 2652.013, "timestamp": "00:44:12", "text": "當場。人們"}, {"type": "subtitle", "time": 2652.762, "timestamp": "00:44:12", "text": "錯誤的"}, {"type": "subtitle", "time": 2654.671, "timestamp": "00:44:14", "text": "我會理解的。因此我們"}, {"type": "subtitle", "time": 2655.861, "timestamp": "00:44:15", "text": "咱們去那裡坐坐吧。"}, {"type": "subtitle", "time": 2656.949, "timestamp": "00:44:16", "text": "在那裡，在光中"}, {"type": "subtitle", "time": 2663.706, "timestamp": "00:44:23", "text": "區。是的。培根.不是"}, {"type": "subtitle", "time": 2669.992, "timestamp": "00:44:29", "text": "害怕。你好，培根。"}, {"type": "subtitle", "time": 2671.363, "timestamp": "00:44:31", "text": "大家好"}, {"type": "subtitle", "time": 2680.729, "timestamp": "00:44:40", "text": "通常情況下。我不這麼認為。"}, {"type": "subtitle", "time": 2682.019, "timestamp": "00:44:42", "text": "我可以看到這一點"}, {"type": "subtitle", "time": 2684.488, "timestamp": "00:44:44", "text": "通常情況下。需要"}, {"type": "subtitle", "time": 2685.681, "timestamp": "00:44:45", "text": "另想辦法，"}, {"type": "chat", "time": 2686.638, "timestamp": "00:44:46", "author": "@bakononcopiumm", "avatar": "https://yt4.ggpht.com/hb5sPAHLUD7fBrZZsmfkzISQWwRqI8BY1n8lceyhZz0sNISomD05pCwUe-GL2amD5y-voH_uYw=s64-c-k-c0x00ffffff-no-rj", "message": "hows wardog"}, {"type": "subtitle", "time": 2687.083, "timestamp": "00:44:47", "text": "為了更接近"}, {"type": "subtitle", "time": 2690.958, "timestamp": "00:44:50", "text": 
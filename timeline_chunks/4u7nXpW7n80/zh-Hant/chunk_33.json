[{"type": "subtitle", "time": 1980.246, "timestamp": "00:33:00", "text": "我的天哪，別是在大街上。"}, {"type": "subtitle", "time": 1981.985, "timestamp": "00:33:01", "text": "靈魂。我感覺自己"}, {"type": "subtitle", "time": 1985.587, "timestamp": "00:33:05", "text": "令人驚嘆。是的，孩子。它"}, {"type": "subtitle", "time": 1991.275, "timestamp": "00:33:11", "text": "太可愛了。你是鬼魂嗎？"}, {"type": "subtitle", "time": 2012.151, "timestamp": "00:33:32", "text": "誰知道呢。誰知道呢。我"}, {"type": "subtitle", "time": 2013.613, "timestamp": "00:33:33", "text": "我喜歡空曠的街道。"}, {"type": "subtitle", "time": 2014.868, "timestamp": "00:33:34", "text": "是的，這就是我想要的原因。"}, {"type": "subtitle", "time": 2016.044, "timestamp": "00:33:36", "text": "直播。沒錯。"}, {"type": "subtitle", "time": 2021.323, "timestamp": "00:33:41", "text": "愉快。真好"}, {"type": "subtitle", "time": 2022.609, "timestamp": "00:33:42", "text": "放鬆點。"}, {"type": "subtitle", "time": 2023.665, "timestamp": "00:33:43", "text": "公園和"}, {"type": "subtitle", "time": 2024.951, "timestamp": "00:33:44", "text": "帶你看看景色"}, {"type": "subtitle", "time": 2028.601, "timestamp": "00:33:48", "text": "空蕩蕩的街道"}, {"type": "subtitle", "time": 2034.746, "timestamp": "00:33:54", "text": "否則。這是什麼東西？"}, {"type": "subtitle", "time": 2037.682, "timestamp": "00:33:57", "text": "這是什麼？一張紙嗎？"}]
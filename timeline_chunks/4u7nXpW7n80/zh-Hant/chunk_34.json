[{"type": "subtitle", "time": 2042.615, "timestamp": "00:34:02", "text": "是的？我……有一瞬間"}, {"type": "subtitle", "time": 2043.52, "timestamp": "00:34:03", "text": "我心想，也許不是。"}, {"type": "subtitle", "time": 2044.843, "timestamp": "00:34:04", "text": "外星人是黏液，"}, {"type": "subtitle", "time": 2046.235, "timestamp": "00:34:06", "text": "他非常聰明，"}, {"type": "subtitle", "time": 2052.473, "timestamp": "00:34:12", "text": "那裡似乎發生了什麼事。什麼"}, {"type": "subtitle", "time": 2057.723, "timestamp": "00:34:17", "text": "我是在開玩笑嗎？是的，"}, {"type": "subtitle", "time": 2060.68, "timestamp": "00:34:20", "text": "就是……是的，就是這樣。"}, {"type": "subtitle", "time": 2063.867, "timestamp": "00:34:23", "text": "就是……塑料"}, {"type": "subtitle", "time": 2067.376, "timestamp": "00:34:27", "text": "電影。是的，沒錯。"}, {"type": "subtitle", "time": 2069.723, "timestamp": "00:34:29", "text": "不錯，戴安娜。如果你"}, {"type": "subtitle", "time": 2070.857, "timestamp": "00:34:30", "text": "能感覺到這一點"}, {"type": "subtitle", "time": 2075.216, "timestamp": "00:34:35", "text": "天氣冷什麼的。你"}, {"type": "subtitle", "time": 2076.32, "timestamp": "00:34:36", "text": "你透過我的耳朵聽到"}, {"type": "subtitle", "time": 2077.652, "timestamp": "00:34:37", "text": "昆蟲麥克風或"}, {"type": "subtitle", "time": 2082.543, "timestamp": "00:34:42", "text": "蟬，呃，"}, {"type": "subtitle", "time": 2085.655, "timestamp": "00:34:45", "text": "大聲喊叫，或者，"}, {"type": "subtitle", "time": 2087.552, "timestamp": "00:34:47", "text": "他們會唱歌嗎？或許"}, {"type": "subtitle", "time": 2088.685, "timestamp": "00:34:48", "text": "他們不會尖叫，但是"}, {"type": "subtitle", "time": 2089.371, "timestamp": "00:34:49", "text": "唱歌- 啁啾，你可以"}, {"type": "subtitle", "time": 2090.641, "timestamp": "00:34:50", "text": "啁啾，你可以 說。有時。然而"}, {"type": "subtitle", "time": 2098.237, "timestamp": "00:34:58", "text": "說。有時。然而 一筆交易"}, {"type": "subtitle", "time": 2099.183, "timestamp": "00:34:59", "text": "一筆交易 機槍，等等，這"}]
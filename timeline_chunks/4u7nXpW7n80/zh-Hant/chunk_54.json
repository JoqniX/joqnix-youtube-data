[{"type": "subtitle", "time": 3241.465, "timestamp": "00:54:01", "text": "好的。哦，蘇琪亞來了。"}, {"type": "subtitle", "time": 3245.966, "timestamp": "00:54:05", "text": "普通的蘇基亞。作為"}, {"type": "subtitle", "time": 3247.47, "timestamp": "00:54:07", "text": "你看，那不是月亮。"}, {"type": "subtitle", "time": 3256.922, "timestamp": "00:54:16", "text": "所以，因此他們"}, {"type": "subtitle", "time": 3258.141, "timestamp": "00:54:18", "text": "派人"}, {"type": "subtitle", "time": 3259.427, "timestamp": "00:54:19", "text": "前往太空站。"}, {"type": "subtitle", "time": 3275.954, "timestamp": "00:54:35", "text": "哦，成功了。為什麼"}, {"type": "subtitle", "time": 3277.018, "timestamp": "00:54:37", "text": "人們正在觀看"}, {"type": "subtitle", "time": 3281.236, "timestamp": "00:54:41", "text": "我？很奇怪"}, {"type": "subtitle", "time": 3282.337, "timestamp": "00:54:42", "text": "外國人"}, {"type": "subtitle", "time": 3283.469, "timestamp": "00:54:43", "text": "真的就這麼走過"}, {"type": "subtitle", "time": 3292.1, "timestamp": "00:54:52", "text": "晚上12:30的橋"}, {"type": "subtitle", "time": 3293.353, "timestamp": "00:54:53", "text": "週四？不，這是"}, {"type": "subtitle", "time": 3294.737, "timestamp": "00:54:54", "text": "星期五。今天"}, {"type": "subtitle", "time": 3296.973, "timestamp": "00:54:56", "text": "星期五，各位。我"}, {"type": "subtitle", "time": 3298.106, "timestamp": "00:54:58", "text": "我今天忘了這件事。"}, {"type": "subtitle", "time": 3299.379, "timestamp": "00:54:59", "text": "星期五。為我。"}]
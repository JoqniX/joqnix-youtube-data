[{"type": "subtitle", "time": 600.718, "timestamp": "00:10:00", "text": "我覺得我不會接受。"}, {"type": "subtitle", "time": 601.922, "timestamp": "00:10:01", "text": "他的守衛"}, {"type": "subtitle", "time": 603.39, "timestamp": "00:10:03", "text": "獨自一人。我應該嗎？"}, {"type": "subtitle", "time": 604.679, "timestamp": "00:10:04", "text": "拿著這個包就行了 ？為什麼不呢？我可以，"}, {"type": "subtitle", "time": 609.38, "timestamp": "00:10:09", "text": "但我不知道。我是我"}, {"type": "subtitle", "time": 610.89, "timestamp": "00:10:10", "text": "我收下了。到"}, {"type": "subtitle", "time": 614.662, "timestamp": "00:10:14", "text": "該死。是的，他是"}, {"type": "subtitle", "time": 615.48, "timestamp": "00:10:15", "text": "已返回。"}, {"type": "subtitle", "time": 628.561, "timestamp": "00:10:28", "text": "看著我。"}, {"type": "subtitle", "time": 630.916, "timestamp": "00:10:30", "text": "現在。做什麼的？給"}, {"type": "subtitle", "time": 632.229, "timestamp": "00:10:32", "text": "我這就把門關上。"}, {"type": "subtitle", "time": 642.5889999999999, "timestamp": "00:10:42", "text": "好的。所以，我們"}, {"type": "subtitle", "time": 643.962, "timestamp": "00:10:43", "text": "我們去冒險吧！"}, {"type": "subtitle", "time": 647.08, "timestamp": "00:10:47", "text": "D. 外面是的"}, {"type": "subtitle", "time": 648.042, "timestamp": "00:10:48", "text": "冷冷地。這裡"}, {"type": "subtitle", "time": 649.782, "timestamp": "00:10:49", "text": "實際溫度只有21度。"}, {"type": "subtitle", "time": 652.511, "timestamp": "00:10:52", "text": "現在的情況很可怕。"}, {"type": "subtitle", "time": 658.255, "timestamp": "00:10:58", "text": "冷冷地。我就在這裡"}, {"type": "subtitle", "time": 659.4590000000001, "timestamp": "00:10:59", "text": "穿著連帽衫和牛仔褲，"}]
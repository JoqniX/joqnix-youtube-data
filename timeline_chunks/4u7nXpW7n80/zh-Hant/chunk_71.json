[{"type": "subtitle", "time": 4265.02, "timestamp": "01:11:05", "text": "天哪，我有很多"}, {"type": "subtitle", "time": 4266.47, "timestamp": "01:11:06", "text": "我正在考慮，我已經做過了。"}, {"type": "subtitle", "time": 4272.416, "timestamp": "01:11:12", "text": "我進行視覺想像。那些"}, {"type": "subtitle", "time": 4273.727, "timestamp": "01:11:13", "text": "有人看了我的直播。"}, {"type": "subtitle", "time": 4275.144, "timestamp": "01:11:15", "text": "兩年前，執法記錄器拍下了這段影片。"}, {"type": "subtitle", "time": 4276.455, "timestamp": "01:11:16", "text": "我知道我的那邊是什麼樣的。"}, {"type": "subtitle", "time": 4277.767, "timestamp": "01:11:17", "text": "遊戲玩法以及其他一切。"}, {"type": "subtitle", "time": 4287.283, "timestamp": "01:11:27", "text": "因為我用"}, {"type": "subtitle", "time": 4288.595, "timestamp": "01:11:28", "text": "捕捉地圖"}, {"type": "subtitle", "time": 4289.839, "timestamp": "01:11:29", "text": "兩台電腦已經在大約兩個附近了"}, {"type": "subtitle", "time": 4291.016, "timestamp": "01:11:31", "text": "或者三年，嗯，或者"}, {"type": "subtitle", "time": 4295.792, "timestamp": "01:11:35", "text": "二。自從我得到她"}, {"type": "subtitle", "time": 4298.106, "timestamp": "01:11:38", "text": "已收到，已購買。我知道 誰更新的？我就是一切"}, {"type": "subtitle", "time": 4301.412, "timestamp": "01:11:41", "text": "誰更新的？我就是一切 又來了。是的。在，"}, {"type": "subtitle", "time": 4305.89, "timestamp": "01:11:45", "text": "又來了。是的。在， 順便一提，重製版“"}, {"type": "subtitle", "time": 4307.276, "timestamp": "01:11:47", "text": "順便一提，重製版“ 《巫師3》即將發售。"}, {"type": "subtitle", "time": 4308.926, "timestamp": "01:11:48", "text": "《巫師3》即將發售。 不，我想玩“"}, {"type": "subtitle", "time": 4310.362, "timestamp": "01:11:50", "text": "不，我想玩“ 獵魔人。但遺憾的是"}, {"type": "subtitle", "time": 4312.95, "timestamp": "01:11:52", "text": "獵魔人。但遺憾的是 我從未"}, {"type": "subtitle", "time": 4314.038, "timestamp": "01:11:54", "text": "我從未 買了《獵魔人》。"}, {"type": "subtitle", "time": 4317.603, "timestamp": "01:11:57", "text": "所以我不得不"}, {"type": "subtitle", "time": 4318.484, "timestamp": "01:11:58", "text": "付出很多"}, {"type": "subtitle", "time": 4319.712, "timestamp": "01:11:59", "text": "玩遊戲的錢"}]
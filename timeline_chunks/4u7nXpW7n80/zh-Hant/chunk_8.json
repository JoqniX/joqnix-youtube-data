[{"type": "subtitle", "time": 480.907, "timestamp": "00:08:00", "text": "很有可能。是的。"}, {"type": "subtitle", "time": 487.571, "timestamp": "00:08:07", "text": "問候。好吧，那就給他吧。"}, {"type": "subtitle", "time": 491.079, "timestamp": "00:08:11", "text": "我看看。好了，就是這樣。"}, {"type": "subtitle", "time": 506.752, "timestamp": "00:08:26", "text": "作品。對不起，各位。"}, {"type": "subtitle", "time": 509.639, "timestamp": "00:08:29", "text": "生活如何？和其他人一樣"}, {"type": "subtitle", "time": 510.73199999999997, "timestamp": "00:08:30", "text": "最後一件事"}, {"type": "subtitle", "time": 513.118, "timestamp": "00:08:33", "text": "有時？我現在"}, {"type": "subtitle", "time": 515.575, "timestamp": "00:08:35", "text": "我要出門了。我當時"}, {"type": "subtitle", "time": 516.785, "timestamp": "00:08:36", "text": "在你的房間裡。"}, {"type": "subtitle", "time": 521.197, "timestamp": "00:08:41", "text": "實際上，我只是"}, {"type": "subtitle", "time": 522.491, "timestamp": "00:08:42", "text": "進來待了幾分鐘"}, {"type": "subtitle", "time": 525.562, "timestamp": "00:08:45", "text": "前。嗯，還有，就"}, {"type": "subtitle", "time": 530.647, "timestamp": "00:08:50", "text": "考慮過花錢"}, {"type": "subtitle", "time": 531.754, "timestamp": "00:08:51", "text": "今天直播，因為"}, {"type": "subtitle", "time": 532.992, "timestamp": "00:08:52", "text": "外面好冷。"}]
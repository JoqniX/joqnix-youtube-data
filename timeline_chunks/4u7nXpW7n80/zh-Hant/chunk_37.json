[{"type": "subtitle", "time": 2221.057, "timestamp": "00:37:01", "text": "與網路有關的事情"}, {"type": "subtitle", "time": 2222.167, "timestamp": "00:37:02", "text": "你什麼時候在外面？"}, {"type": "subtitle", "time": 2227.192, "timestamp": "00:37:07", "text": "什麼手機"}, {"type": "subtitle", "time": 2228.037, "timestamp": "00:37:08", "text": "你是操作員"}, {"type": "subtitle", "time": 2231.051, "timestamp": "00:37:11", "text": "你用它嗎？我不是"}, {"type": "subtitle", "time": 2232.243, "timestamp": "00:37:12", "text": "我問這個問題是因為…"}, {"type": "chat", "time": 2232.533, "timestamp": "00:37:12", "author": "@MikazukiYure", "avatar": "https://yt4.ggpht.com/uuFSD7qVrZy0JUWrBRfSfEKIQpib7_2xP24Yiu1ND1Mq6uhaYIHDnA5EiGz_o33FUhHYvbCT9g=s64-c-k-c0x00ffffff-no-rj", "message": "sou danee"}, {"type": "subtitle", "time": 2235.396, "timestamp": "00:37:15", "text": "某些地區為什麼"}, {"type": "subtitle", "time": 2236.626, "timestamp": "00:37:16", "text": "你不喝咖啡嗎？"}, {"type": "subtitle", "time": 2240.399, "timestamp": "00:37:20", "text": "類似那樣？哦，你"}, {"type": "subtitle", "time": 2242.332, "timestamp": "00:37:22", "text": "正確的。不，不，不。我"}, {"type": "subtitle", "time": 2243.561, "timestamp": "00:37:23", "text": "我得去睡覺了。"}, {"type": "subtitle", "time": 2246.35, "timestamp": "00:37:26", "text": "很快。我得走了。"}, {"type": "subtitle", "time": 2247.564, "timestamp": "00:37:27", "text": "睡覺。我需要"}, {"type": "subtitle", "time": 2248.646, "timestamp": "00:37:28", "text": "早上6點起床"}, {"type": "subtitle", "time": 2251.332, "timestamp": "00:37:31", "text": "小時。 5 或 6 小時。"}, {"type": "subtitle", "time": 2254.7, "timestamp": "00:37:34", "text": "我需要去"}, {"type": "subtitle", "time": 2256.18, "timestamp": "00:37:36", "text": "兼職工作。我有"}, {"type": "subtitle", "time": 2257.389, "timestamp": "00:37:37", "text": "不，我沒有。"}, {"type": "subtitle", "time": 2258.437, "timestamp": "00:37:38", "text": "自行車。所以"}, {"type": "subtitle", "time": 2259.597, "timestamp": "00:37:39", "text": "我今天就需要。"}, {"type": "subtitle", "time": 2260.758, "timestamp": "00:37:40", "text": "步行上班。"}, {"type": "subtitle", "time": 2264.079, "timestamp": "00:37:44", "text": "我會回來，我會休息。"}, {"type": "subtitle", "time": 2265.456, "timestamp": "00:37:45", "text": "我會再找一份工作。"}, {"type": "subtitle", "time": 2269.538, "timestamp": "00:37:49", "text": "我會上火車。"}, {"type": "subtitle", "time": 2274.525, "timestamp": "00:37:54", "text": "我會回來的。在家裡的某個地方"}, {"type": "subtitle", "time": 2276.49, "timestamp": "00:37:56", "text": "那麼，在晚上10點或9點半，"}, {"type": "subtitle", "time": 2278.509, "timestamp": "00:37:58", "text": "或許我有機會"}]
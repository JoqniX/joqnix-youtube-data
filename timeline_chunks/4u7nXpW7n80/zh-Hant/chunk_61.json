[{"type": "subtitle", "time": 3660.534, "timestamp": "01:01:00", "text": "當然，但如果15 ……15……千盧比——也就是20"}, {"type": "subtitle", "time": 3665.468, "timestamp": "01:01:05", "text": "……15……千盧比——也就是20 我想應該是25000日元。"}, {"type": "subtitle", "time": 3675.754, "timestamp": "01:01:15", "text": "我想應該是25000日元。 獎金總額約20,000美元。"}, {"type": "subtitle", "time": 3678.005, "timestamp": "01:01:18", "text": "獎金總額約20,000美元。 25000 或 30000 盧比。但，"}, {"type": "subtitle", "time": 3684.551, "timestamp": "01:01:24", "text": "25000 或 30000 盧比。但， 這似乎是一條命令"}, {"type": "subtitle", "time": 3686.066, "timestamp": "01:01:26", "text": "這似乎是一條命令 遊戲嘛……嗯，大概吧。"}, {"type": "subtitle", "time": 3690.997, "timestamp": "01:01:30", "text": "遊戲嘛……嗯，大概吧。 必須分享"}, {"type": "subtitle", "time": 3694.31, "timestamp": "01:01:34", "text": "必須分享 與其他獎項一起"}, {"type": "subtitle", "time": 3695.254, "timestamp": "01:01:35", "text": "與其他獎項一起 球員們等等，"}, {"type": "subtitle", "time": 3705.959, "timestamp": "01:01:45", "text": "像這樣。我愣了一下"}, {"type": "subtitle", "time": 3709.591, "timestamp": "01:01:49", "text": "兄弟，我好害怕。所以，"}, {"type": "subtitle", "time": 3712.351, "timestamp": "01:01:52", "text": "大概就是這樣。那是什麼？"}, {"type": "subtitle", "time": 3714.128, "timestamp": "01:01:54", "text": "某種「咻咻」的聲音。"}, {"type": "subtitle", "time": 3715.986, "timestamp": "01:01:55", "text": "嗯，我倒不完全是。"}, {"type": "subtitle", "time": 3717.235, "timestamp": "01:01:57", "text": "我記得這個名字，但是"}, {"type": "subtitle", "time": 3718.553, "timestamp": "01:01:58", "text": "這被稱為“教堂長椅-” 我喝酒。嗯。 30,554, 59。"}]
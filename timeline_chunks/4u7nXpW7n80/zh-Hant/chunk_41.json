[{"type": "subtitle", "time": 2460.518, "timestamp": "00:41:00", "text": "觸摸許多地方 或許是印度人。"}, {"type": "subtitle", "time": 2461.686, "timestamp": "00:41:01", "text": "或許是印度人。 他們會更多"}, {"type": "subtitle", "time": 2462.819, "timestamp": "00:41:02", "text": "他們會更多 理解，因為"}, {"type": "subtitle", "time": 2463.815, "timestamp": "00:41:03", "text": "理解，因為 經常見到他們。"}, {"type": "subtitle", "time": 2471.073, "timestamp": "00:41:11", "text": "我覺得他們知道。"}, {"type": "subtitle", "time": 2471.769, "timestamp": "00:41:11", "text": "印度"}, {"type": "subtitle", "time": 2475.973, "timestamp": "00:41:15", "text": "心理。但有些 可能不喜歡"}, {"type": "subtitle", "time": 2477.296, "timestamp": "00:41:17", "text": "可能不喜歡 那裡有印度人。所以，"}, {"type": "subtitle", "time": 2482.461, "timestamp": "00:41:22", "text": "那裡有印度人。所以， 對……的偏見"}, {"type": "subtitle", "time": 2483.383, "timestamp": "00:41:23", "text": "對……的偏見 膚色也"}, {"type": "subtitle", "time": 2484.535, "timestamp": "00:41:24", "text": "膚色也 可以。"}, {"type": "subtitle", "time": 2489.753, "timestamp": "00:41:29", "text": "大多數情況下，如果是"}, {"type": "subtitle", "time": 2490.955, "timestamp": "00:41:30", "text": "因為膚色，"}, {"type": "subtitle", "time": 2492.369, "timestamp": "00:41:32", "text": "人們認為你是來自"}, {"type": "subtitle", "time": 2493.677, "timestamp": "00:41:33", "text": "斯里蘭卡、尼泊爾或"}, {"type": "subtitle", "time": 2500.011, "timestamp": "00:41:40", "text": "差不多就是這樣。或者"}, {"type": "subtitle", "time": 2501.343, "timestamp": "00:41:41", "text": "有時他們會問：“你來自哪裡？”"}, {"type": "subtitle", "time": 2504.61, "timestamp": "00:41:44", "text": "「是阿薩姆邦還是印度？」或者"}, {"type": "subtitle", "time": 2517.021, "timestamp": "00:41:57", "text": "差不多就是這樣。正因如此，"}]
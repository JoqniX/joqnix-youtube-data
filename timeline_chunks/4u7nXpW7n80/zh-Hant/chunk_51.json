[{"type": "subtitle", "time": 3062.418, "timestamp": "00:51:02", "text": "某人的臉。好的。在"}, {"type": "subtitle", "time": 3070.55, "timestamp": "00:51:10", "text": "我的上帝。我的天啊。"}, {"type": "subtitle", "time": 3084.079, "timestamp": "00:51:24", "text": "是的，這些波浪"}, {"type": "subtitle", "time": 3085.365, "timestamp": "00:51:25", "text": "很好展示。"}, {"type": "subtitle", "time": 3094.489, "timestamp": "00:51:34", "text": "問候。問候。為什麼"}, {"type": "subtitle", "time": 3100.46, "timestamp": "00:51:40", "text": "你真可愛！這"}, {"type": "subtitle", "time": 3103.857, "timestamp": "00:51:43", "text": "該男子未屈服"}, {"type": "subtitle", "time": 3109.208, "timestamp": "00:51:49", "text": "訊號.哦，是的，雖然你"}, {"type": "subtitle", "time": 3110.32, "timestamp": "00:51:50", "text": "你看不見。"}, {"type": "subtitle", "time": 3114.067, "timestamp": "00:51:54", "text": "你看，那有多遠？"}, {"type": "subtitle", "time": 3117.575, "timestamp": "00:51:57", "text": "它已經跌得好低了。"}]
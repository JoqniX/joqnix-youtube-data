[{"type": "subtitle", "time": 4140.94, "timestamp": "01:09:00", "text": "。インド出身の私の先生 父が持ってきてくれます。"}, {"type": "subtitle", "time": 4142.239, "timestamp": "01:09:02", "text": "父が持ってきてくれます。 それらを梱包し、"}, {"type": "subtitle", "time": 4143.047, "timestamp": "01:09:03", "text": "それらを梱包し、 それを私の"}, {"type": "subtitle", "time": 4144.1, "timestamp": "01:09:04", "text": "それを私の 先生、そして先生"}, {"type": "subtitle", "time": 4145.154, "timestamp": "01:09:05", "text": "先生、そして先生 それらを私に持ってきてください。それで"}, {"type": "subtitle", "time": 4149.58, "timestamp": "01:09:09", "text": "それらを私に持ってきてください。それで 私はただ必要としている"}, {"type": "subtitle", "time": 4150.714, "timestamp": "01:09:10", "text": "私はただ必要としている それらを受け取り、"}, {"type": "subtitle", "time": 4151.813, "timestamp": "01:09:11", "text": "それらを受け取り、 パソコンを組み立てる。私は見つけた"}, {"type": "subtitle", "time": 4156.014, "timestamp": "01:09:16", "text": "パソコンを組み立てる。私は見つけた PCケース、そして私は"}, {"type": "subtitle", "time": 4157.328, "timestamp": "01:09:17", "text": "PCケース、そして私は 購入予定"}, {"type": "subtitle", "time": 4158.504, "timestamp": "01:09:18", "text": "購入予定 本体のみ、ブロック"}, {"type": "subtitle", "time": 4159.61, "timestamp": "01:09:19", "text": "本体のみ、ブロック 電源と"}, {"type": "subtitle", "time": 4160.371, "timestamp": "01:09:20", "text": "電源と 冷却。はい、そうです。"}, {"type": "subtitle", "time": 4165.54, "timestamp": "01:09:25", "text": "冷却。はい、そうです。 全て。さらにケーブルもいくつか"}, {"type": "subtitle", "time": 4167.583, "timestamp": "01:09:27", "text": "全て。さらにケーブルもいくつか 。えっと、HDMIケーブル、それから"}, {"type": "subtitle", "time": 4180.697, "timestamp": "01:09:40", "text": "DisplayPortからUSB-Cへの変換ケーブルか何か"}, {"type": "subtitle", "time": 4182.744, "timestamp": "01:09:42", "text": "このような。ええ、でもどこからですか？"}, {"type": "subtitle", "time": 4185.554, "timestamp": "01:09:45", "text": "ああ、それは"}, {"type": "subtitle", "time": 4189.658, "timestamp": "01:09:49", "text": "インド。私の先生は"}, {"type": "subtitle", "time": 4190.851, "timestamp": "01:09:50", "text": "インドで教えた"}, {"type": "subtitle", "time": 4192.255, "timestamp": "01:09:52", "text": "私は日本人です、今"}, {"type": "subtitle", "time": 4195.282, "timestamp": "01:09:55", "text": "インドで。彼は今そこにいる。 インドで。彼"}, {"type": "subtitle", "time": 4196.966, "timestamp": "01:09:56", "text": "インドで。彼 戻る"}, {"type": "subtitle", "time": 4198.04, "timestamp": "01:09:58", "text": "戻る 次は日本"}]
[{"type": "subtitle", "time": 3660.534, "timestamp": "01:01:00", "text": "もちろん、でも15 …15…千ルピー、つまり20"}, {"type": "subtitle", "time": 3665.468, "timestamp": "01:01:05", "text": "…15…千ルピー、つまり20 確か25,000円だったと思います。"}, {"type": "subtitle", "time": 3675.754, "timestamp": "01:01:15", "text": "確か25,000円だったと思います。 賞金総額は約20,"}, {"type": "subtitle", "time": 3678.005, "timestamp": "01:01:18", "text": "賞金総額は約20, 2万5千ルピーまたは3万ルピー。しかし、"}, {"type": "subtitle", "time": 3684.551, "timestamp": "01:01:24", "text": "2万5千ルピーまたは3万ルピー。しかし、 これはコマンドのようです"}, {"type": "subtitle", "time": 3686.066, "timestamp": "01:01:26", "text": "これはコマンドのようです ゲーム、だから…だから、"}, {"type": "subtitle", "time": 3690.997, "timestamp": "01:01:30", "text": "ゲーム、だから…だから、 共有しなければならない"}, {"type": "subtitle", "time": 3694.31, "timestamp": "01:01:34", "text": "共有しなければならない 他の賞品と一緒"}, {"type": "subtitle", "time": 3695.254, "timestamp": "01:01:35", "text": "他の賞品と一緒 選手たちなど、"}, {"type": "subtitle", "time": 3705.959, "timestamp": "01:01:45", "text": "このような。一瞬の私"}, {"type": "subtitle", "time": 3709.591, "timestamp": "01:01:49", "text": "怖いよ、兄弟。それで、"}, {"type": "subtitle", "time": 3712.351, "timestamp": "01:01:52", "text": "なんとなくそんな感じ。それは何ですか？"}, {"type": "subtitle", "time": 3714.128, "timestamp": "01:01:54", "text": "何らかの「ピューピュー」という音。"}, {"type": "subtitle", "time": 3715.986, "timestamp": "01:01:55", "text": "うーん、私は正確にはそうではない"}, {"type": "subtitle", "time": 3717.235, "timestamp": "01:01:57", "text": "名前は覚えているが、"}, {"type": "subtitle", "time": 3718.553, "timestamp": "01:01:58", "text": "これは「ピュー」と呼ばれます \"私は飲む。\"ええと。 30,554、59。"}]
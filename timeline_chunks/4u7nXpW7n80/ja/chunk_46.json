[{"type": "subtitle", "time": 2764.661, "timestamp": "00:46:04", "text": "問題は"}, {"type": "subtitle", "time": 2768.047, "timestamp": "00:46:08", "text": "私は文字通り一人ぼっちで"}, {"type": "subtitle", "time": 2770.696, "timestamp": "00:46:10", "text": "ここには誰もいない。私"}, {"type": "subtitle", "time": 2772.013, "timestamp": "00:46:12", "text": "文字通り暗闇の中。"}, {"type": "subtitle", "time": 2774.758, "timestamp": "00:46:14", "text": "それが実現するかどうかは神のみぞ知る"}, {"type": "subtitle", "time": 2778.378, "timestamp": "00:46:18", "text": "何らかの種類のブナ。そんなに"}, {"type": "subtitle", "time": 2780.619, "timestamp": "00:46:20", "text": "すべて、ですよね？なぜ私なの？"}, {"type": "subtitle", "time": 2781.956, "timestamp": "00:46:21", "text": "私は普段、夜に散歩をします。"}, {"type": "subtitle", "time": 2785.153, "timestamp": "00:46:25", "text": "そうですか？知るか？"}, {"type": "subtitle", "time": 2800.029, "timestamp": "00:46:40", "text": "あなたのものを見てみると"}, {"type": "subtitle", "time": 2801.102, "timestamp": "00:46:41", "text": "ストリーム、待機、"}, {"type": "subtitle", "time": 2804.596, "timestamp": "00:46:44", "text": "真剣に？さあ行こう、V。"}]
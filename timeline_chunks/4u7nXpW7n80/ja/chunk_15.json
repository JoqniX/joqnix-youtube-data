[{"type": "subtitle", "time": 902.16, "timestamp": "00:15:02", "text": "遅れ。また。しかし"}, {"type": "subtitle", "time": 904.506, "timestamp": "00:15:04", "text": "お知らせ下さい。わかった。"}, {"type": "subtitle", "time": 909.582, "timestamp": "00:15:09", "text": "ご挨拶申し上げます。私は何を服用しているのでしょうか？"}, {"type": "subtitle", "time": 911.26, "timestamp": "00:15:11", "text": "停止した？どこ？ここはどこ？"}, {"type": "subtitle", "time": 915.711, "timestamp": "00:15:15", "text": "だった？はい。最後の一つ"}, {"type": "subtitle", "time": 917.181, "timestamp": "00:15:17", "text": "時々、私たちはワログというゲームをした。"}, {"type": "subtitle", "time": 920.147, "timestamp": "00:15:20", "text": "ジョーク。軍用犬は"}, {"type": "subtitle", "time": 921.761, "timestamp": "00:15:21", "text": "本当に興味深い。それ"}, {"type": "subtitle", "time": 924.948, "timestamp": "00:15:24", "text": "とても良かった。そして私は"}, {"type": "subtitle", "time": 925.867, "timestamp": "00:15:25", "text": "私は欲しい、私は願う"}, {"type": "subtitle", "time": 927.283, "timestamp": "00:15:27", "text": "こちらに戻る"}, {"type": "subtitle", "time": 930.107, "timestamp": "00:15:30", "text": "ゲーム。彼女は興味深い人物だ。はい。"}, {"type": "subtitle", "time": 936.039, "timestamp": "00:15:36", "text": "そして、そう、突然、"}, {"type": "subtitle", "time": 937.076, "timestamp": "00:15:37", "text": "ダウンロードしました"}, {"type": "subtitle", "time": 938.558, "timestamp": "00:15:38", "text": "仕事、パートタイムの仕事、"}, {"type": "subtitle", "time": 941.418, "timestamp": "00:15:41", "text": "みんな。それは"}, {"type": "subtitle", "time": 942.6659999999999, "timestamp": "00:15:42", "text": "休暇中、私は"}, {"type": "subtitle", "time": 943.878, "timestamp": "00:15:43", "text": "楽しんで、"}]
[{"type": "subtitle", "time": 1980.246, "timestamp": "00:33:00", "text": "ああ、なんてことだ、路上では。"}, {"type": "subtitle", "time": 1981.985, "timestamp": "00:33:01", "text": "魂。私は自分自身を感じる"}, {"type": "subtitle", "time": 1985.587, "timestamp": "00:33:05", "text": "驚くべきことに。はい、そうです。それ"}, {"type": "subtitle", "time": 1991.275, "timestamp": "00:33:11", "text": "とてもかわいい。あなたは幽霊ですか？"}, {"type": "subtitle", "time": 2012.151, "timestamp": "00:33:32", "text": "知るか。知るか。私"}, {"type": "subtitle", "time": 2013.613, "timestamp": "00:33:33", "text": "私は人通りのない通りが好きだ。"}, {"type": "subtitle", "time": 2014.868, "timestamp": "00:33:34", "text": "はい、それが私がそうしたかった理由です"}, {"type": "subtitle", "time": 2016.044, "timestamp": "00:33:36", "text": "ストリーミング配信する。その通りです。"}, {"type": "subtitle", "time": 2021.323, "timestamp": "00:33:41", "text": "心地よく。とても素敵"}, {"type": "subtitle", "time": 2022.609, "timestamp": "00:33:42", "text": "リラックスして、"}, {"type": "subtitle", "time": 2023.665, "timestamp": "00:33:43", "text": "公園と"}, {"type": "subtitle", "time": 2024.951, "timestamp": "00:33:44", "text": "景色をお見せします"}, {"type": "subtitle", "time": 2028.601, "timestamp": "00:33:48", "text": "空っぽの通り"}, {"type": "subtitle", "time": 2034.746, "timestamp": "00:33:54", "text": "さもないと。これは一体何だ？"}, {"type": "subtitle", "time": 2037.682, "timestamp": "00:33:57", "text": "これは何だ、シートか、"}]
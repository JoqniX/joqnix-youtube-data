[{"type": "subtitle", "time": 2460.518, "timestamp": "00:41:00", "text": "たくさん触れる インド人、おそらく"}, {"type": "subtitle", "time": 2461.686, "timestamp": "00:41:01", "text": "インド人、おそらく 彼らはもっと"}, {"type": "subtitle", "time": 2462.819, "timestamp": "00:41:02", "text": "彼らはもっと 理解しているから"}, {"type": "subtitle", "time": 2463.815, "timestamp": "00:41:03", "text": "理解しているから 彼らにはよく会う。"}, {"type": "subtitle", "time": 2471.073, "timestamp": "00:41:11", "text": "彼らは知っていると思う。"}, {"type": "subtitle", "time": 2471.769, "timestamp": "00:41:11", "text": "インド人"}, {"type": "subtitle", "time": 2475.973, "timestamp": "00:41:15", "text": "メンタリティ。しかし、 おそらく好きではない"}, {"type": "subtitle", "time": 2477.296, "timestamp": "00:41:17", "text": "おそらく好きではない そこにはインド人がいる。など、"}, {"type": "subtitle", "time": 2482.461, "timestamp": "00:41:22", "text": "そこにはインド人がいる。など、 偏見"}, {"type": "subtitle", "time": 2483.383, "timestamp": "00:41:23", "text": "偏見 肌の色も"}, {"type": "subtitle", "time": 2484.535, "timestamp": "00:41:24", "text": "肌の色も そうかもしれない。"}, {"type": "subtitle", "time": 2489.753, "timestamp": "00:41:29", "text": "ほとんどの場合、"}, {"type": "subtitle", "time": 2490.955, "timestamp": "00:41:30", "text": "肌の色が原因で、"}, {"type": "subtitle", "time": 2492.369, "timestamp": "00:41:32", "text": "人々はあなたが"}, {"type": "subtitle", "time": 2493.677, "timestamp": "00:41:33", "text": "スリランカ、ネパール、または"}, {"type": "subtitle", "time": 2500.011, "timestamp": "00:41:40", "text": "そんな感じ。または"}, {"type": "subtitle", "time": 2501.343, "timestamp": "00:41:41", "text": "時々彼らはこう尋ねる。「あなたは出身ですか？」"}, {"type": "subtitle", "time": 2504.61, "timestamp": "00:41:44", "text": "「アッサム州ですか、それともインドですか？」または"}, {"type": "subtitle", "time": 2517.021, "timestamp": "00:41:57", "text": "そんな感じ。このため、"}]
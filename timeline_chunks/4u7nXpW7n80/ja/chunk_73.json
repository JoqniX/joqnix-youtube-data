[{"type": "subtitle", "time": 4389.923, "timestamp": "01:13:09", "text": "はい。さようなら。はい。さようなら。"}, {"type": "subtitle", "time": 4397.877, "timestamp": "01:13:17", "text": "わかってるよ、あご。何てことだ。"}, {"type": "subtitle", "time": 4416.468, "timestamp": "01:13:36", "text": "なるほど"}, {"type": "subtitle", "time": 4417.761, "timestamp": "01:13:37", "text": "オープングリーン- 灰色の球体。これ"}, {"type": "subtitle", "time": 4421.452, "timestamp": "01:13:41", "text": "灰色の球体。これ ポケモンのやつ"}, {"type": "subtitle", "time": 4422.645, "timestamp": "01:13:42", "text": "ポケモンのやつ 「ただの」カテゴリー"}, {"type": "subtitle", "time": 4423.742, "timestamp": "01:13:43", "text": "「ただの」カテゴリー 聖餐」。決して"}, {"type": "subtitle", "time": 4425.557, "timestamp": "01:13:45", "text": "聖餐」。決して これは予想外だった。"}, {"type": "subtitle", "time": 4431.067, "timestamp": "01:13:51", "text": "これは興味深い。公平"}, {"type": "subtitle", "time": 4439.824, "timestamp": "01:13:59", "text": "したがって、それは過ぎ去るだろう"}]
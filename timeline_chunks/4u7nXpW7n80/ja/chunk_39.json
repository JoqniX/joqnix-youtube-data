[{"type": "subtitle", "time": 2344.716, "timestamp": "00:39:04", "text": "寝る。私は正反対です。で"}, {"type": "subtitle", "time": 2346.153, "timestamp": "00:39:06", "text": "私の場合、逆の効果が出ます。"}, {"type": "subtitle", "time": 2350.865, "timestamp": "00:39:10", "text": "これは私の"}, {"type": "subtitle", "time": 2351.786, "timestamp": "00:39:11", "text": "体はそれに慣れている"}, {"type": "subtitle", "time": 2353.097, "timestamp": "00:39:13", "text": "カフェインを"}, {"type": "subtitle", "time": 2360.721, "timestamp": "00:39:20", "text": "睡眠薬。これは部分的に"}, {"type": "subtitle", "time": 2365.217, "timestamp": "00:39:25", "text": "私のせいだ。それ"}, {"type": "subtitle", "time": 2366.66, "timestamp": "00:39:26", "text": "一部は私のせいだ。"}, {"type": "subtitle", "time": 2372.264, "timestamp": "00:39:32", "text": "まだインドにあるので、"}, {"type": "subtitle", "time": 2377.353, "timestamp": "00:39:37", "text": "家で、えっと、夜に"}, {"type": "subtitle", "time": 2378.552, "timestamp": "00:39:38", "text": "家の中には何もなかった。"}, {"type": "subtitle", "time": 2381.106, "timestamp": "00:39:41", "text": "食べる。私の家族"}, {"type": "subtitle", "time": 2382.958, "timestamp": "00:39:42", "text": "12時か1時頃に寝た"}, {"type": "subtitle", "time": 2384.811, "timestamp": "00:39:44", "text": "夜、または午前3時に私は"}, {"type": "subtitle", "time": 2389.501, "timestamp": "00:39:49", "text": "まだ起きている。私"}, {"type": "subtitle", "time": 2390.631, "timestamp": "00:39:50", "text": "普段は"}, {"type": "subtitle", "time": 2391.761, "timestamp": "00:39:51", "text": "キッチン、醸造"}]
[{"type": "subtitle", "time": 1621.265, "timestamp": "00:27:01", "text": "何もない、ただ"}, {"type": "subtitle", "time": 1622.753, "timestamp": "00:27:02", "text": "私は1時間だけ滞在します。"}, {"type": "subtitle", "time": 1624.169, "timestamp": "00:27:04", "text": "今日。私はただ"}, {"type": "subtitle", "time": 1625.482, "timestamp": "00:27:05", "text": "もう寝ます。"}, {"type": "subtitle", "time": 1627.656, "timestamp": "00:27:07", "text": "今は12歳。"}, {"type": "subtitle", "time": 1629.164, "timestamp": "00:27:09", "text": "私が始めるのが遅かったということです。私"}, {"type": "subtitle", "time": 1630.732, "timestamp": "00:27:10", "text": "もう寝なければならない。私は持っている"}, {"type": "subtitle", "time": 1631.393, "timestamp": "00:27:11", "text": "鉱山はありません"}, {"type": "subtitle", "time": 1632.598, "timestamp": "00:27:12", "text": "自転車。私は持っている"}, {"type": "subtitle", "time": 1633.693, "timestamp": "00:27:13", "text": "最近盗まれた"}, {"type": "subtitle", "time": 1638.894, "timestamp": "00:27:18", "text": "自転車。いくつかの"}, {"type": "subtitle", "time": 1640.149, "timestamp": "00:27:20", "text": "歩かなければならない"}, {"type": "subtitle", "time": 1641.403, "timestamp": "00:27:21", "text": "徒歩で、いや、私は"}, {"type": "subtitle", "time": 1642.621, "timestamp": "00:27:22", "text": "歩くと2時間かかります"}, {"type": "subtitle", "time": 1643.876, "timestamp": "00:27:23", "text": "朝の7時から"}, {"type": "subtitle", "time": 1645.315, "timestamp": "00:27:25", "text": "はい、もし私が7時に出発するなら、"}, {"type": "subtitle", "time": 1646.717, "timestamp": "00:27:26", "text": "私は9時にそこに行きます"}, {"type": "subtitle", "time": 1648.119, "timestamp": "00:27:28", "text": "仕事に時間通りに行く、"}, {"type": "subtitle", "time": 1649.485, "timestamp": "00:27:29", "text": "明日は2つあるから"}, {"type": "subtitle", "time": 1657.463, "timestamp": "00:27:37", "text": "パートタイムの仕事。えっと、それで私は"}, {"type": "subtitle", "time": 1658.35, "timestamp": "00:27:38", "text": "私はひどいことになるでしょう。"}, {"type": "subtitle", "time": 1659.205, "timestamp": "00:27:39", "text": "疲れているが、"}, {"type": "subtitle", "time": 1660.377, "timestamp": "00:27:40", "text": "私はできる限りのことをします。"}, {"type": "subtitle", "time": 1661.548, "timestamp": "00:27:41", "text": "外に出られる"}, {"type": "subtitle", "time": 1672.173, "timestamp": "00:27:52", "text": "ストリームOK。はい"}, {"type": "subtitle", "time": 1673.209, "timestamp": "00:27:53", "text": "シンプルで良い"}, {"type": "subtitle", "time": 1678.667, "timestamp": "00:27:58", "text": "歩いてるんだよね？難しい"}]
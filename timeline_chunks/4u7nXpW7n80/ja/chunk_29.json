[{"type": "subtitle", "time": 1743.672, "timestamp": "00:29:03", "text": "薬。ああ、これは薬だ。 ああ、なんてことだ、これは、これは…"}, {"type": "subtitle", "time": 1749.408, "timestamp": "00:29:09", "text": "ああ、なんてことだ、これは、これは… イギリスのものと同じような味がする"}, {"type": "subtitle", "time": 1750.981, "timestamp": "00:29:10", "text": "イギリスのものと同じような味がする 薬。私は、あなたに言います、"}, {"type": "subtitle", "time": 1756.545, "timestamp": "00:29:16", "text": "薬。私は、あなたに言います、 それは、ほら、そういう人たち"}, {"type": "subtitle", "time": 1757.727, "timestamp": "00:29:17", "text": "それは、ほら、そういう人たち 風邪薬として服用する"}, {"type": "subtitle", "time": 1759.083, "timestamp": "00:29:19", "text": "風邪薬として服用する もしくは、それみたいなやつ"}, {"type": "subtitle", "time": 1760.438, "timestamp": "00:29:20", "text": "もしくは、それみたいなやつ 赤い液体"}, {"type": "subtitle", "time": 1761.481, "timestamp": "00:29:21", "text": "赤い液体 薬物"}, {"type": "subtitle", "time": 1762.594, "timestamp": "00:29:22", "text": "薬物 奇妙な味と"}, {"type": "subtitle", "time": 1763.845, "timestamp": "00:29:23", "text": "奇妙な味と 後味。はい、まさにその通りです。"}, {"type": "subtitle", "time": 1768.45, "timestamp": "00:29:28", "text": "後味。はい、まさにその通りです。 それ。同じ。どうやら"}, {"type": "subtitle", "time": 1777.99, "timestamp": "00:29:37", "text": "それ。同じ。どうやら 住むのに良い場所です"}, {"type": "subtitle", "time": 1778.988, "timestamp": "00:29:38", "text": "住むのに良い場所です 寒い国。それでも"}, {"type": "subtitle", "time": 1781.285, "timestamp": "00:29:41", "text": "寒い国。それでも 簡単ではない。私は決して"}, {"type": "subtitle", "time": 1783.963, "timestamp": "00:29:43", "text": "簡単ではない。私は決して 雪は降らなかったし"}, {"type": "subtitle", "time": 1785.283, "timestamp": "00:29:45", "text": "雪は降らなかったし 雪には触れなかった。"}, {"type": "subtitle", "time": 1790.021, "timestamp": "00:29:50", "text": "だから私は待っている"}, {"type": "subtitle", "time": 1791.0, "timestamp": "00:29:51", "text": "12月ですが、こちら"}, {"type": "subtitle", "time": 1792.109, "timestamp": "00:29:52", "text": "気温が下がる"}, {"type": "subtitle", "time": 1795.327, "timestamp": "00:29:55", "text": "氷点下。したがって、私にとって、"}, {"type": "subtitle", "time": 1796.549, "timestamp": "00:29:56", "text": "怖いです。これはどういうことですか？"}, {"type": "subtitle", "time": 1799.64, "timestamp": "00:29:59", "text": "そうなるだろう。あなたの性別"}]
[{"type": "subtitle", "time": 480.907, "timestamp": "00:08:00", "text": "おそらくそうでしょう。はい。"}, {"type": "subtitle", "time": 487.571, "timestamp": "00:08:07", "text": "ご挨拶申し上げます。よし、くれ。"}, {"type": "subtitle", "time": 491.079, "timestamp": "00:08:11", "text": "確認してみます。よし、これで終わりだ。"}, {"type": "subtitle", "time": 506.752, "timestamp": "00:08:26", "text": "作品。皆さん、申し訳ありません。"}, {"type": "subtitle", "time": 509.639, "timestamp": "00:08:29", "text": "生活はどうですか？他の皆と同じように"}, {"type": "subtitle", "time": 510.73199999999997, "timestamp": "00:08:30", "text": "最後に"}, {"type": "subtitle", "time": 513.118, "timestamp": "00:08:33", "text": "時々？私は今"}, {"type": "subtitle", "time": 515.575, "timestamp": "00:08:35", "text": "出かけます。私は"}, {"type": "subtitle", "time": 516.785, "timestamp": "00:08:36", "text": "あなたの部屋で。"}, {"type": "subtitle", "time": 521.197, "timestamp": "00:08:41", "text": "実際、私はただ"}, {"type": "subtitle", "time": 522.491, "timestamp": "00:08:42", "text": "数分間だけ入ってきた"}, {"type": "subtitle", "time": 525.562, "timestamp": "00:08:45", "text": "前。えっと、そして"}, {"type": "subtitle", "time": 530.647, "timestamp": "00:08:50", "text": "支出について考えた"}, {"type": "subtitle", "time": 531.754, "timestamp": "00:08:51", "text": "今日ストリーミング配信するのは、"}, {"type": "subtitle", "time": 532.992, "timestamp": "00:08:52", "text": "外はとても寒い。"}]
[{"type": "subtitle", "time": 2884.425, "timestamp": "00:48:04", "text": "もし"}, {"type": "subtitle", "time": 2885.593, "timestamp": "00:48:05", "text": "何らかの警備員または"}, {"type": "subtitle", "time": 2887.095, "timestamp": "00:48:07", "text": "他の誰か。彼らは"}, {"type": "subtitle", "time": 2888.119, "timestamp": "00:48:08", "text": "彼らはただ電話するだけです"}, {"type": "subtitle", "time": 2900.357, "timestamp": "00:48:20", "text": "自分。なぜ階段があるのですか？"}, {"type": "subtitle", "time": 2921.605, "timestamp": "00:48:41", "text": "ティノ。わかった。ああ、そうじゃないんですね。"}, {"type": "subtitle", "time": 2924.963, "timestamp": "00:48:44", "text": "ここに座っても構いません。がある、"}, {"type": "subtitle", "time": 2930.228, "timestamp": "00:48:50", "text": "問題は、"}, {"type": "subtitle", "time": 2931.574, "timestamp": "00:48:51", "text": "そのような場所は怖い、"}, {"type": "subtitle", "time": 2932.919, "timestamp": "00:48:52", "text": "何が起こるかわからないから"}, {"type": "subtitle", "time": 2937.577, "timestamp": "00:48:57", "text": "そういうことも起こり得る。そこにある。"}, {"type": "subtitle", "time": 2939.112, "timestamp": "00:48:59", "text": "自転車？兄弟、私は"}]
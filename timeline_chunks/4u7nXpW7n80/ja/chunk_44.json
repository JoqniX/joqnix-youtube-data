[{"type": "subtitle", "time": 2642.148, "timestamp": "00:44:02", "text": "私はただあなたに"}, {"type": "subtitle", "time": 2643.174, "timestamp": "00:44:03", "text": "海を見た"}, {"type": "subtitle", "time": 2644.302, "timestamp": "00:44:04", "text": "波など。"}, {"type": "subtitle", "time": 2646.799, "timestamp": "00:44:06", "text": "波を見てごらん。"}, {"type": "subtitle", "time": 2648.269, "timestamp": "00:44:08", "text": "ただ"}, {"type": "subtitle", "time": 2649.801, "timestamp": "00:44:09", "text": "これは見ておくべきことだ。しかしそうではない"}, {"type": "subtitle", "time": 2651.08, "timestamp": "00:44:11", "text": "こうして立っても構いません"}, {"type": "subtitle", "time": 2652.013, "timestamp": "00:44:12", "text": "その場で。人々"}, {"type": "subtitle", "time": 2652.762, "timestamp": "00:44:12", "text": "間違っている"}, {"type": "subtitle", "time": 2654.671, "timestamp": "00:44:14", "text": "理解してくれるでしょう。したがって私たちは"}, {"type": "subtitle", "time": 2655.861, "timestamp": "00:44:15", "text": "そこに座りに行きましょう。"}, {"type": "subtitle", "time": 2656.949, "timestamp": "00:44:16", "text": "そこに、光の中で"}, {"type": "subtitle", "time": 2663.706, "timestamp": "00:44:23", "text": "ゾーン。はい。ベーコン。ない"}, {"type": "subtitle", "time": 2669.992, "timestamp": "00:44:29", "text": "恐れよ。こんにちは、ベーコン。"}, {"type": "subtitle", "time": 2671.363, "timestamp": "00:44:31", "text": "こんにちは、みんな"}, {"type": "subtitle", "time": 2680.729, "timestamp": "00:44:40", "text": "通常。私はそうは思わない。"}, {"type": "subtitle", "time": 2682.019, "timestamp": "00:44:42", "text": "私がこれを見ることができる"}, {"type": "subtitle", "time": 2684.488, "timestamp": "00:44:44", "text": "通常。必要"}, {"type": "subtitle", "time": 2685.681, "timestamp": "00:44:45", "text": "別の方法を見つける、"}, {"type": "chat", "time": 2686.638, "timestamp": "00:44:46", "author": "@bakononcopiumm", "avatar": "https://yt4.ggpht.com/hb5sPAHLUD7fBrZZsmfkzISQWwRqI8BY1n8lceyhZz0sNISomD05pCwUe-GL2amD5y-voH_uYw=s64-c-k-c0x00ffffff-no-rj", "message": "hows wardog"}, {"type": "subtitle", "time": 2687.083, "timestamp": "00:44:47", "text": "近づくために"}, {"type"
[{"type": "subtitle", "time": 4025.682, "timestamp": "01:07:05", "text": "はい、第六戦です。バトルフィールド6"}, {"type": "subtitle", "time": 4030.409, "timestamp": "01:07:10", "text": "3日前は安かった"}, {"type": "subtitle", "time": 4033.127, "timestamp": "01:07:13", "text": "ワログスが現れた。私は"}, {"type": "subtitle", "time": 4034.847, "timestamp": "01:07:14", "text": "それを買うために。それから私は"}, {"type": "subtitle", "time": 4036.199, "timestamp": "01:07:16", "text": "私は迷っていた"}, {"type": "subtitle", "time": 4037.388, "timestamp": "01:07:17", "text": "全くプレイしない"}, {"type": "subtitle", "time": 4040.544, "timestamp": "01:07:20", "text": "バトルフィールド6？そこで私は決心しました"}, {"type": "subtitle", "time": 4044.012, "timestamp": "01:07:24", "text": "私はそうしないと決めたわけではない。"}, {"type": "subtitle", "time": 4047.253, "timestamp": "01:07:27", "text": "買う。今私は"}, {"type": "subtitle", "time": 4050.656, "timestamp": "01:07:30", "text": "この件については少し申し訳なく思っています。"}, {"type": "subtitle", "time": 4052.795, "timestamp": "01:07:32", "text": "選択。今、私たちは"}, {"type": "subtitle", "time": 4053.752, "timestamp": "01:07:33", "text": "彼を待つ"}, {"type": "subtitle", "time": 4054.869, "timestamp": "01:07:34", "text": "また安くなるだろう"}, {"type": "subtitle", "time": 4055.955, "timestamp": "01:07:35", "text": "またはセール品。"}, {"type": "subtitle", "time": 4064.446, "timestamp": "01:07:44", "text": "ありがとう。ベーコンさん、ありがとう。"}, {"type": "subtitle", "time": 4065.728, "timestamp": "01:07:45", "text": "星界になった"}, {"type": "subtitle", "time": 4070.775, "timestamp": "01:07:50", "text": "星座。ありがとうございます。"}, {"type": "subtitle", "time": 4072.422, "timestamp": "01:07:52", "text": "17日に参加者になった"}, {"type": "subtitle", "time": 4076.049, "timestamp": "01:07:56", "text": "数ヶ月。おお。ありがとう。"}]
[{"type": "subtitle", "time": 3301.452, "timestamp": "00:55:01", "text": "私にとっては金曜日です。"}, {"type": "subtitle", "time": 3311.099, "timestamp": "00:55:11", "text": "あ、待って。あなたはできる"}, {"type": "subtitle", "time": 3313.265, "timestamp": "00:55:13", "text": "ほら、"}, {"type": "subtitle", "time": 3316.515, "timestamp": "00:55:16", "text": "レッカー車。ああ、それもね"}, {"type": "subtitle", "time": 3320.631, "timestamp": "00:55:20", "text": "すごくかっこいい。はい、そうです"}, {"type": "subtitle", "time": 3321.879, "timestamp": "00:55:21", "text": "商品を輸送する"}, {"type": "subtitle", "time": 3323.128, "timestamp": "00:55:23", "text": "レストランなど"}, {"type": "subtitle", "time": 3329.335, "timestamp": "00:55:29", "text": "ここ。そこに見える"}, {"type": "subtitle", "time": 3330.234, "timestamp": "00:55:30", "text": "駐車"}, {"type": "subtitle", "time": 3333.88, "timestamp": "00:55:33", "text": "自転車。ありがとうございます。"}, {"type": "subtitle", "time": 3335.232, "timestamp": "00:55:35", "text": "小さな子をありがとう"}, {"type": "subtitle", "time": 3336.994, "timestamp": "00:55:36", "text": "また後で。"}, {"type": "subtitle", "time": 3338.193, "timestamp": "00:55:38", "text": "後で。ご挨拶申し上げます。"}, {"type": "subtitle", "time": 3339.313, "timestamp": "00:55:39", "text": "皆さんに感謝します"}, {"type": "subtitle", "time": 3342.515, "timestamp": "00:55:42", "text": "来た。ありがとうございます。"}, {"type": "subtitle", "time": 3348.449, "timestamp": "00:55:48", "text": "来た。幸運を祈ります"}, {"type": "subtitle", "time": 3357.599, "timestamp": "00:55:57", "text": "日。おお。ああ、犬め。それ"}, {"type": "subtitle", "time": 3358.767, "timestamp": "00:55:58", "text": "恐怖の月。として"}, {"type": "subtitle", "time": 3359.923, "timestamp": "00:55:59", "text": "最初の試験に合格しました"}]
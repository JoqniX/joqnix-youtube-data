[{"type": "subtitle", "time": 4502.647, "timestamp": "01:15:02", "text": "コンテンツサイクル。それは"}, {"type": "subtitle", "time": 4503.923, "timestamp": "01:15:03", "text": "2週間ごとに"}, {"type": "subtitle", "time": 4505.032, "timestamp": "01:15:05", "text": "新しいプレイリスト"}, {"type": "subtitle", "time": 4506.14, "timestamp": "01:15:06", "text": "コンテンツ、古い"}, {"type": "subtitle", "time": 4509.647, "timestamp": "01:15:09", "text": "Jotnikのコンテンツ。それ"}, {"type": "subtitle", "time": 4510.627, "timestamp": "01:15:10", "text": "新しいかもしれません、"}, {"type": "subtitle", "time": 4511.28, "timestamp": "01:15:11", "text": "古いまたは"}, {"type": "subtitle", "time": 4512.489, "timestamp": "01:15:12", "text": "ランダムなコンテンツ、"}, {"type": "subtitle", "time": 4513.077, "timestamp": "01:15:13", "text": "どちらになるか"}, {"type": "subtitle", "time": 4513.894, "timestamp": "01:15:13", "text": "負ける"}, {"type": "subtitle", "time": 4519.399, "timestamp": "01:15:19", "text": "常に。はい、いいえ"}, {"type": "subtitle", "time": 4520.726, "timestamp": "01:15:20", "text": "お気軽にご覧ください"}, {"type": "subtitle", "time": 4522.123, "timestamp": "01:15:22", "text": "利用可能な場合は別のチャンネルへ"}, {"type": "subtitle", "time": 4523.171, "timestamp": "01:15:23", "text": "時間があれば"}, {"type": "subtitle", "time": 4524.358, "timestamp": "01:15:24", "text": "老けて見える"}, {"type": "subtitle", "time": 4529.434, "timestamp": "01:15:29", "text": "コンテンツとか、そういう類のもの。それ"}, {"type": "subtitle", "time": 4530.359, "timestamp": "01:15:30", "text": "常に"}, {"type": "subtitle", "time": 4531.782, "timestamp": "01:15:31", "text": "テレビ番組のように機能する"}, {"type": "subtitle", "time": 4534.443, "timestamp": "01:15:34", "text": "またはラジオ。だから大胆に"}, {"type": "subtitle", "time": 4536.452, "timestamp": "01:15:36", "text": "チェック。私"}, {"type": "subtitle", "time": 4537.599, "timestamp": "01:15:37", "text": "ついに全てをやり遂げた"}, {"type": "subtitle", "time": 4540.766, "timestamp": "01:15:40", "text": "移動する。私は"}, {"type": "subtitle", "time": 4541.803, "timestamp": "01:15:41", "text": "する必要がある"}, {"type": "subtitle", "time": 4542.905, "timestamp": "01:15:42", "text": "いくつかの最適化"}, {"type": "subtitle", "time": 4543.942, "timestamp": "01:15:43", "text": "このイベントのために。"}, {"type": "subtitle", "time": 4547.445, "timestamp": "01:15:47", "text": "それ以外は全て順調です。"}, {"type": "subtitle", "time": 4552.478, "timestamp": "01:15:52", "text": "はい。それに、すべて"}, {"type": "subtitle", "time": 4556.063, "timestamp": "01:15:56", "text": "良い。これも違う"}, {"type": "subtitle", "time": 4557.373, "timestamp": "01:15:57", "text": "しなければならなかった"}, {"type": "subtitle", "time": 4558.55, "timestamp": "01:15:58", "text": "いくつかの最適化。"}]
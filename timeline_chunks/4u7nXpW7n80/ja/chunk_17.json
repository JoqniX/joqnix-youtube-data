[{"type": "subtitle", "time": 1020.138, "timestamp": "00:17:00", "text": "こんにちは。私は放送中ですか？わかった、"}, {"type": "subtitle", "time": 1021.672, "timestamp": "00:17:01", "text": "ラジオに復帰したぜ、兄弟。"}, {"type": "subtitle", "time": 1027.683, "timestamp": "00:17:07", "text": "ちょうど私が"}, {"type": "subtitle", "time": 1028.854, "timestamp": "00:17:08", "text": "何かについて話す"}, {"type": "subtitle", "time": 1029.582, "timestamp": "00:17:09", "text": "重要、私の"}, {"type": "subtitle", "time": 1030.721, "timestamp": "00:17:10", "text": "アプリケーションがクラッシュしました。"}, {"type": "subtitle", "time": 1031.639, "timestamp": "00:17:11", "text": "または送信しなかった"}, {"type": "subtitle", "time": 1036.987, "timestamp": "00:17:16", "text": "信号をストリーミングする。はい。"}, {"type": "subtitle", "time": 1048.393, "timestamp": "00:17:28", "text": "では、私に必要なものは何でしょうか？"}, {"type": "subtitle", "time": 1051.037, "timestamp": "00:17:31", "text": "始める？はい、負けました。"}, {"type": "subtitle", "time": 1053.485, "timestamp": "00:17:33", "text": "あなたの意見。私はどれ？"}, {"type": "subtitle", "time": 1054.67, "timestamp": "00:17:34", "text": "学校で購入"}, {"type": "subtitle", "time": 1058.7, "timestamp": "00:17:38", "text": "店。私はそれを買いました。"}, {"type": "subtitle", "time": 1059.89, "timestamp": "00:17:39", "text": "2番目の自転車"}, {"type": "subtitle", "time": 1061.112, "timestamp": "00:17:41", "text": "その翌日… いいえ、2番目ではありません。"}, {"type": "subtitle", "time": 1062.076, "timestamp": "00:17:42", "text": "いいえ、2番目ではありません。 実際には2番目に"}, {"type": "subtitle", "time": 1063.266, "timestamp": "00:17:43", "text": "実際には2番目に 勉強の日。の上"}, {"type": "subtitle", "time": 1066.518, "timestamp": "00:17:46", "text": "勉強の日。の上 2日目または3日目"}, {"type": "subtitle", "time": 1067.83, "timestamp": "00:17:47", "text": "2日目または3日目 もし私が学んでいるなら"}, {"type": "subtitle", "time": 1068.815, "timestamp": "00:17:48", "text": "もし私が学んでいるなら 私の記憶は正しい。で"}, {"type": "subtitle", "time": 1071.957, "timestamp": "00:17:51", "text": "私の記憶は正しい。で 火曜日。そして、知ってる？"}, {"type": "subtitle", "time": 1077.708, "timestamp": "00:17:57", "text": "火曜日に私は"}]
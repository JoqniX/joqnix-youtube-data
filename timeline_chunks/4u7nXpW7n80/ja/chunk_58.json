[{"type": "subtitle", "time": 3480.55, "timestamp": "00:58:00", "text": "陽気さ。これは良いですね、"}, {"type": "subtitle", "time": 3482.128, "timestamp": "00:58:02", "text": "彼らが持っているものよりも。"}, {"type": "subtitle", "time": 3483.53, "timestamp": "00:58:03", "text": "レモンを使ったこの"}, {"type": "subtitle", "time": 3485.821, "timestamp": "00:58:05", "text": "水で。これは清潔だ。"}, {"type": "subtitle", "time": 3489.215, "timestamp": "00:58:09", "text": "レモンエキス。私の"}, {"type": "subtitle", "time": 3490.274, "timestamp": "00:58:10", "text": "ルームメイト"}, {"type": "subtitle", "time": 3491.264, "timestamp": "00:58:11", "text": "これを買って、"}, {"type": "subtitle", "time": 3495.896, "timestamp": "00:58:15", "text": "本当に良い。それ"}, {"type": "subtitle", "time": 3497.197, "timestamp": "00:58:17", "text": "推進力を与える"}, {"type": "subtitle", "time": 3498.532, "timestamp": "00:58:18", "text": "必要であっても、"}, {"type": "subtitle", "time": 3499.633, "timestamp": "00:58:19", "text": "眠いんですね、どうですか？"}, {"type": "subtitle", "time": 3500.7, "timestamp": "00:58:20", "text": "より早く到着する"}, {"type": "subtitle", "time": 3504.338, "timestamp": "00:58:24", "text": "家。やるだけ。"}, {"type": "subtitle", "time": 3505.309, "timestamp": "00:58:25", "text": "数口。"}, {"type": "subtitle", "time": 3507.09, "timestamp": "00:58:27", "text": "少し"}, {"type": "subtitle", "time": 3513.797, "timestamp": "00:58:33", "text": "エネルギー。はい。彼ら全員 …ちょっと待ってみようと思います。"}, {"type": "subtitle", "time": 3519.77, "timestamp": "00:58:39", "text": "…ちょっと待ってみようと思います。 カメラをオフにしてください。"}, {"type": "subtitle", "time": 3526.855, "timestamp": "00:58:46", "text": "切り替えましょう"}, {"type": "subtitle", "time": 3534.107, "timestamp": "00:58:54", "text": "歌手。来て。はい。"}, {"type": "subtitle", "time": 3537.638, "timestamp": "00:58:57", "text": "つまり、カメラはここにあるので、"}, {"type": "subtitle", "time": 3539.075, "timestamp": "00:58:59", "text": "心配しないで。燃えている。"}]
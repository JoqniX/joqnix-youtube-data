[{"type": "subtitle", "time": 2100.493, "timestamp": "00:35:00", "text": "機関銃、そして待って、これ 落書きのように"}, {"type": "subtitle", "time": 2101.476, "timestamp": "00:35:01", "text": "落書きのように テレビ番組。そこには何もない。"}, {"type": "subtitle", "time": 2104.619, "timestamp": "00:35:04", "text": "テレビ番組。そこには何もない。 いいえ。はい。はい。さようなら。"}, {"type": "subtitle", "time": 2113.461, "timestamp": "00:35:13", "text": "どこに行けばいいですか？来て。"}, {"type": "subtitle", "time": 2116.728, "timestamp": "00:35:16", "text": "それからまっすぐ進む。私"}, {"type": "subtitle", "time": 2118.074, "timestamp": "00:35:18", "text": "私はできる…私はただ"}, {"type": "subtitle", "time": 2120.863, "timestamp": "00:35:20", "text": "真っ直ぐ進んで下さい。はい。それ"}, {"type": "subtitle", "time": 2121.893, "timestamp": "00:35:21", "text": "とても美しい"}, {"type": "subtitle", "time": 2123.396, "timestamp": "00:35:23", "text": "国。私は"}, {"type": "subtitle", "time": 2125.894, "timestamp": "00:35:25", "text": "東京ではない。東京"}, {"type": "subtitle", "time": 2127.141, "timestamp": "00:35:27", "text": "今回は、えーと、"}, {"type": "subtitle", "time": 2128.535, "timestamp": "00:35:28", "text": "混雑しすぎとか何か"}, {"type": "subtitle", "time": 2130.969, "timestamp": "00:35:30", "text": "このような。そこは満員だろう。"}, {"type": "subtitle", "time": 2133.046, "timestamp": "00:35:33", "text": "人々。つまり、"}, {"type": "subtitle", "time": 2134.444, "timestamp": "00:35:34", "text": "東京は"}, {"type": "subtitle", "time": 2135.621, "timestamp": "00:35:35", "text": "ナイトライフとその他すべて"}, {"type": "subtitle", "time": 2139.376, "timestamp": "00:35:39", "text": "このような。あれを見てください。"}, {"type": "subtitle", "time": 2140.985, "timestamp": "00:35:40", "text": "地域。それらの地域。"}, {"type": "subtitle", "time": 2146.269, "timestamp": "00:35:46", "text": "ああ、なんてことだ、そこに蛾がいる。"}, {"type": "subtitle", "time": 2149.215, "timestamp": "00:35:49", "text": "少し"}, {"type": "subtitle", "time": 2150.523, "timestamp": "00:35:50", "text": "試した蛾"}, {"type": "subtitle", "time": 2154.256, "timestamp": "00:35:54", "text": "触ろうとした"}, {"type": "subtitle", "time": 2155.456, "timestamp": "00:35:55", "text": "電話、そして私はただ"}, {"type": "subtitle", "time": 2158.677, "timestamp": "00:35:58", "text": "彼を突き放した。はい 。でも、なんて美しいのでしょう。私"}]
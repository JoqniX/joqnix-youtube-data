[{"type": "subtitle", "time": 4202.39, "timestamp": "01:10:02", "text": "次は日本 月。それは"}, {"type": "subtitle", "time": 4203.781, "timestamp": "01:10:03", "text": "月。それは この終わりに"}, {"type": "subtitle", "time": 4204.869, "timestamp": "01:10:04", "text": "この終わりに 月。そこで私は尋ねた"}, {"type": "subtitle", "time": 4207.375, "timestamp": "01:10:07", "text": "月。そこで私は尋ねた 彼、彼はできるだろうか"}, {"type": "subtitle", "time": 4208.508, "timestamp": "01:10:08", "text": "彼、彼はできるだろうか 私の荷物を持ってきてくれる？そして"}, {"type": "subtitle", "time": 4211.94, "timestamp": "01:10:11", "text": "私の荷物を持ってきてくれる？そして 彼は「はい、"}, {"type": "subtitle", "time": 4213.237, "timestamp": "01:10:13", "text": "彼は「はい、 \"もちろん。\"だから私はとても"}, {"type": "subtitle", "time": 4216.055, "timestamp": "01:10:16", "text": "\"もちろん。\"だから私はとても 興奮した。自分"}, {"type": "subtitle", "time": 4218.889, "timestamp": "01:10:18", "text": "興奮した。自分 少し必要"}, {"type": "subtitle", "time": 4219.612, "timestamp": "01:10:19", "text": "少し必要 お金を節約するために、"}, {"type": "subtitle", "time": 4220.698, "timestamp": "01:10:20", "text": "お金を節約するために、 私は今"}, {"type": "subtitle", "time": 4221.619, "timestamp": "01:10:21", "text": "私は今 座礁する。ええ、そうです。自分"}, {"type": "subtitle", "time": 4227.059, "timestamp": "01:10:27", "text": "座礁する。ええ、そうです。自分 収集する必要がある"}, {"type": "subtitle", "time": 4228.091, "timestamp": "01:10:28", "text": "収集する必要がある お金を集めて"}, {"type": "subtitle", "time": 4230.984, "timestamp": "01:10:30", "text": "お金を集めて 全て。ついに私は"}, {"type": "subtitle", "time": 4234.511, "timestamp": "01:10:34", "text": "全て。ついに私は ゲームをプレイせずに"}, {"type": "subtitle", "time": 4235.514, "timestamp": "01:10:35", "text": "ゲームをプレイせずに ノートパソコンでは動作が遅い。えー、"}, {"type": "subtitle", "time": 4245.574, "timestamp": "01:10:45", "text": "やっとプレイできる。"}, {"type": "subtitle", "time": 4246.908, "timestamp": "01:10:46", "text": "ラグなしでWarogでプレイできるよ、兄弟。"}, {"type": "subtitle", "time": 4249.201, "timestamp": "01:10:49", "text": "私はそうする必要はない。"}, {"type": "subtitle", "time": 4250.25, "timestamp": "01:10:50", "text": "心配する"}, {"type": "subtitle", "time": 4256.623, "timestamp": "01:10:56", "text": "トリビア。そしてこれ"}, {"type": "subtitle", "time": 4257.703, "timestamp": "01:10:57", "text": "見た目はこうなります"}, {"type": "subtitle", "time": 4259.245, "timestamp": "01:10:59", "text": "高フレームレートでのゲームプレイ。"}]
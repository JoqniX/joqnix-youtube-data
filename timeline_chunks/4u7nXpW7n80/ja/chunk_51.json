[{"type": "subtitle", "time": 3062.418, "timestamp": "00:51:02", "text": "誰かの顔。わかった。で"}, {"type": "subtitle", "time": 3070.55, "timestamp": "00:51:10", "text": "我が神よ。何てことだ。"}, {"type": "subtitle", "time": 3084.079, "timestamp": "00:51:24", "text": "しかし、これらの波は"}, {"type": "subtitle", "time": 3085.365, "timestamp": "00:51:25", "text": "見せてくれてありがとう。"}, {"type": "subtitle", "time": 3094.489, "timestamp": "00:51:34", "text": "ご挨拶申し上げます。ご挨拶申し上げます。なぜ"}, {"type": "subtitle", "time": 3100.46, "timestamp": "00:51:40", "text": "君ってすごく可愛いね？これ"}, {"type": "subtitle", "time": 3103.857, "timestamp": "00:51:43", "text": "男は服従しなかった"}, {"type": "subtitle", "time": 3109.208, "timestamp": "00:51:49", "text": "信号。ああ、そうだね、でも君は"}, {"type": "subtitle", "time": 3110.32, "timestamp": "00:51:50", "text": "見えないよ。"}, {"type": "subtitle", "time": 3114.067, "timestamp": "00:51:54", "text": "あれがどれくらい遠いか分かりますか？"}, {"type": "subtitle", "time": 3117.575, "timestamp": "00:51:57", "text": "かなり下の方にある。"}]
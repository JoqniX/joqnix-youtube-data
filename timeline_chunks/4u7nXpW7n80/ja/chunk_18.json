[{"type": "subtitle", "time": 1081.348, "timestamp": "00:18:01", "text": "失くした。それは"}, {"type": "subtitle", "time": 1082.323, "timestamp": "00:18:02", "text": "火曜日に私は彼に"}, {"type": "subtitle", "time": 1083.5, "timestamp": "00:18:03", "text": "実際、負けた。"}, {"type": "subtitle", "time": 1088.103, "timestamp": "00:18:08", "text": "つまり、誰かが盗んだということだ。"}, {"type": "subtitle", "time": 1089.267, "timestamp": "00:18:09", "text": "私の自転車は近くにあります"}, {"type": "subtitle", "time": 1091.205, "timestamp": "00:18:11", "text": "私の家。我々は持っています"}, {"type": "subtitle", "time": 1092.412, "timestamp": "00:18:12", "text": "特別な場所"}, {"type": "subtitle", "time": 1093.062, "timestamp": "00:18:13", "text": "駐車場"}, {"type": "subtitle", "time": 1094.959, "timestamp": "00:18:14", "text": "自転車。誰か"}, {"type": "subtitle", "time": 1095.729, "timestamp": "00:18:15", "text": "私のを盗んだ"}, {"type": "subtitle", "time": 1099.626, "timestamp": "00:18:19", "text": "自転車。持ち帰り"}, {"type": "subtitle", "time": 1100.504, "timestamp": "00:18:20", "text": "火曜日は"}, {"type": "subtitle", "time": 1101.738, "timestamp": "00:18:21", "text": "ひどく疲れている"}, {"type": "subtitle", "time": 1104.72, "timestamp": "00:18:24", "text": "仕事の後。行った"}, {"type": "subtitle", "time": 1110.809, "timestamp": "00:18:30", "text": "雨。まるでバケツで土砂降りだった。そして"}, {"type": "subtitle", "time": 1114.457, "timestamp": "00:18:34", "text": "本当に土砂降りだった。"}, {"type": "subtitle", "time": 1125.76, "timestamp": "00:18:45", "text": "バケツ。そして土砂降りだった"}, {"type": "subtitle", "time": 1126.952, "timestamp": "00:18:46", "text": "バケツ、そして私はこう思った"}, {"type": "subtitle", "time": 1128.209, "timestamp": "00:18:48", "text": "疲れた"}, {"type": "subtitle", "time": 1129.533, "timestamp": "00:18:49", "text": "ロックしなかった 。これは完全に私のものです。"}, {"type": "subtitle", "time": 1133.511, "timestamp": "00:18:53", "text": "。これは完全に私のものです。 故障。まあ、とにかく"}, {"type": "subtitle", "time": 1139.067, "timestamp": "00:18:59", "text": "故障。まあ、とにかく 驚いたよ、だって"}]
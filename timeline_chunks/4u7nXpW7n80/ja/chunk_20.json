[{"type": "subtitle", "time": 1205.713, "timestamp": "00:20:05", "text": "歩いて戻っていた。今日"}, {"type": "subtitle", "time": 1206.907, "timestamp": "00:20:06", "text": "私は警察に行き、"}, {"type": "subtitle", "time": 1208.198, "timestamp": "00:20:08", "text": "盗難を報告した。 数時間前、"}, {"type": "subtitle", "time": 1209.295, "timestamp": "00:20:09", "text": "数時間前、 2、3個くらい"}, {"type": "subtitle", "time": 1210.198, "timestamp": "00:20:10", "text": "2、3個くらい 数時間前の夜、なぜなら"}, {"type": "subtitle", "time": 1211.457, "timestamp": "00:20:11", "text": "数時間前の夜、なぜなら とても疲れていた。"}, {"type": "subtitle", "time": 1212.715, "timestamp": "00:20:12", "text": "とても疲れていた。 本日通過"}, {"type": "subtitle", "time": 1213.942, "timestamp": "00:20:13", "text": "本日通過 約7キロメートル"}, {"type": "subtitle", "time": 1215.007, "timestamp": "00:20:15", "text": "約7キロメートル 八。私もそうだった。"}, {"type": "subtitle", "time": 1220.799, "timestamp": "00:20:20", "text": "八。私もそうだった。 疲れ果てた。それから私は"}, {"type": "subtitle", "time": 1222.527, "timestamp": "00:20:22", "text": "疲れ果てた。それから私は 考えた：「よし、"}, {"type": "subtitle", "time": 1223.551, "timestamp": "00:20:23", "text": "考えた：「よし、 「雰囲気が素晴らしい。」"}, {"type": "subtitle", "time": 1225.72, "timestamp": "00:20:25", "text": "「雰囲気が素晴らしい。」 夜の屋外"}, {"type": "subtitle", "time": 1226.683, "timestamp": "00:20:26", "text": "夜の屋外 冷たく。星が見える。"}, {"type": "subtitle", "time": 1229.479, "timestamp": "00:20:29", "text": "冷たく。星が見える。 などなど。私はそうではない"}, {"type": "subtitle", "time": 1231.465, "timestamp": "00:20:31", "text": "などなど。私はそうではない 私は毎日禁欲していたよね？私"}, {"type": "subtitle", "time": 1236.22, "timestamp": "00:20:36", "text": "私は毎日禁欲していたよね？私 私は遠慮しなかった。"}, {"type": "subtitle", "time": 1237.462, "timestamp": "00:20:37", "text": "私は遠慮しなかった。 あれから1週間と3日が経ちました。"}, {"type": "subtitle", "time": 1243.468, "timestamp": "00:20:43", "text": "正直に言うと、毎日私は"}, {"type": "subtitle", "time": 1244.732, "timestamp": "00:20:44", "text": "私の魂の奥底に"}, {"type": "subtitle", "time": 1245.645, "timestamp": "00:20:45", "text": "私は"}, {"type": "subtitle", "time": 1247.462, "timestamp": "00:20:47", "text": "ストリーミングするために"}, {"type": "subtitle", "time": 1248.919, "timestamp": "00:20:48", "text": "みんなに会いたい。私"}, {"type": "subtitle", "time": 1250.037, "timestamp": "00:20:50", "text": "家族が恋しい。"}, {"type": "subtitle", "time": 1251.555, "timestamp": "00:20:51", "text": "観客。私はあなたがいなくて寂しいです。"}, {"type": "subtitle", "time": 1252.958, "timestamp": "00:20:52", "text": "加入者とともに。"}, {"type": "subtitle", "time": 1254.75, "timestamp": "00:20:54", "text": "みんなに会いたい。私"}, {"type": "subtitle", "time": 1256.062, "timestamp": "00:20:56", "text": "私は、"}, {"type": "subtitle", "time": 1256.771, "timestamp": "00:20:56", "text": "入ってきて"}, {"type": "subtitle", "time": 1258.118, "timestamp": "00:20:58", "text": "私と連絡を取ってください。"}]
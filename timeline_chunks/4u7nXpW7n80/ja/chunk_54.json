[{"type": "subtitle", "time": 3241.465, "timestamp": "00:54:01", "text": "わかった。ああ、そうそう、スキアはここにいるよ。"}, {"type": "subtitle", "time": 3245.966, "timestamp": "00:54:05", "text": "普通のスキア。として"}, {"type": "subtitle", "time": 3247.47, "timestamp": "00:54:07", "text": "ほら、月じゃないんだよ。"}, {"type": "subtitle", "time": 3256.922, "timestamp": "00:54:16", "text": "したがって、彼らは"}, {"type": "subtitle", "time": 3258.141, "timestamp": "00:54:18", "text": "人々を送る"}, {"type": "subtitle", "time": 3259.427, "timestamp": "00:54:19", "text": "宇宙ステーションへ。"}, {"type": "subtitle", "time": 3275.954, "timestamp": "00:54:35", "text": "ああ、うまくいった。なぜ"}, {"type": "subtitle", "time": 3277.018, "timestamp": "00:54:37", "text": "人々は見ている"}, {"type": "subtitle", "time": 3281.236, "timestamp": "00:54:41", "text": "自分？奇妙なことに"}, {"type": "subtitle", "time": 3282.337, "timestamp": "00:54:42", "text": "外国人男性"}, {"type": "subtitle", "time": 3283.469, "timestamp": "00:54:43", "text": "文字通り通り過ぎていく"}, {"type": "subtitle", "time": 3292.1, "timestamp": "00:54:52", "text": "夜12時30分の橋"}, {"type": "subtitle", "time": 3293.353, "timestamp": "00:54:53", "text": "木曜日？いいえ、これは"}, {"type": "subtitle", "time": 3294.737, "timestamp": "00:54:54", "text": "金曜日。今日"}, {"type": "subtitle", "time": 3296.973, "timestamp": "00:54:56", "text": "金曜日ですよ、皆さん。私"}, {"type": "subtitle", "time": 3298.106, "timestamp": "00:54:58", "text": "今日それを忘れていた"}, {"type": "subtitle", "time": 3299.379, "timestamp": "00:54:59", "text": "金曜日。私にとって。"}]
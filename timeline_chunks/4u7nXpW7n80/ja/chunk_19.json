[{"type": "subtitle", "time": 1140.244, "timestamp": "00:19:00", "text": "驚いたよ、だって 非常に急な斜面に立っていて、"}, {"type": "subtitle", "time": 1141.521, "timestamp": "00:19:01", "text": "非常に急な斜面に立っていて、 高価な自転車。で"}, {"type": "subtitle", "time": 1147.713, "timestamp": "00:19:07", "text": "高価な自転車。で 他のすべての生徒"}, {"type": "subtitle", "time": 1148.992, "timestamp": "00:19:08", "text": "他のすべての生徒 信じられないほど"}, {"type": "subtitle", "time": 1149.975, "timestamp": "00:19:09", "text": "信じられないほど かっこいいバイク。"}, {"type": "subtitle", "time": 1155.169, "timestamp": "00:19:15", "text": "ジャンチとか、そういう類のこと。"}, {"type": "subtitle", "time": 1156.916, "timestamp": "00:19:16", "text": "なぜ学校に行くのか？"}, {"type": "subtitle", "time": 1158.145, "timestamp": "00:19:18", "text": "バイク仲間？"}, {"type": "subtitle", "time": 1160.664, "timestamp": "00:19:20", "text": "なぜ自転車が"}, {"type": "subtitle", "time": 1161.424, "timestamp": "00:19:21", "text": "のように見える"}, {"type": "subtitle", "time": 1162.773, "timestamp": "00:19:22", "text": "普通の自転車？"}, {"type": "subtitle", "time": 1168.376, "timestamp": "00:19:28", "text": "私は黄色いものを持っていました。"}, {"type": "subtitle", "time": 1169.577, "timestamp": "00:19:29", "text": "どんな種類の自転車がありますか？"}, {"type": "subtitle", "time": 1170.877, "timestamp": "00:19:30", "text": "さらに7つのピース――同じ"}, {"type": "subtitle", "time": 1172.044, "timestamp": "00:19:32", "text": "同じ色で"}, {"type": "subtitle", "time": 1173.1779999999999, "timestamp": "00:19:33", "text": "モーター、なぜ正確には"}, {"type": "subtitle", "time": 1180.344, "timestamp": "00:19:40", "text": "おい、兄弟？そしてこのため"}, {"type": "subtitle", "time": 1181.271, "timestamp": "00:19:41", "text": "今日は私にとって"}, {"type": "subtitle", "time": 1182.696, "timestamp": "00:19:42", "text": "8時から歩かなければならなかった"}, {"type": "subtitle", "time": 1190.041, "timestamp": "00:19:50", "text": "午前10時まで"}, {"type": "subtitle", "time": 1194.374, "timestamp": "00:19:54", "text": "あなたの職場。私"}, {"type": "subtitle", "time": 1195.733, "timestamp": "00:19:55", "text": "1時間遅れた、"}, {"type": "subtitle", "time": 1197.057, "timestamp": "00:19:57", "text": "そしてさらに2時間"}]
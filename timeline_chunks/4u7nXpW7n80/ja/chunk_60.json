[{"type": "subtitle", "time": 3603.684, "timestamp": "01:00:03", "text": "言い忘れていましたが、いただきます。"}, {"type": "subtitle", "time": 3605.169, "timestamp": "01:00:05", "text": "トーナメントへの参加"}, {"type": "subtitle", "time": 3606.575, "timestamp": "01:00:06", "text": "ピュアチャンピオンシップまたは"}, {"type": "subtitle", "time": 3613.109, "timestamp": "01:00:13", "text": "そんな感じ。えっと…それで私は"}, {"type": "subtitle", "time": 3614.206, "timestamp": "01:00:14", "text": "よくわからない"}, {"type": "subtitle", "time": 3615.403, "timestamp": "01:00:15", "text": "チーム構成、トピック"}, {"type": "subtitle", "time": 3616.468, "timestamp": "01:00:16", "text": "そしてその他すべて。"}, {"type": "chat", "time": 3617.314, "timestamp": "01:00:17", "author": "@bakononcopiumm", "avatar": "https://yt4.ggpht.com/hb5sPAHLUD7fBrZZsmfkzISQWwRqI8BY1n8lceyhZz0sNISomD05pCwUe-GL2amD5y-voH_uYw=s64-c-k-c0x00ffffff-no-rj", "message": "whats that"}, {"type": "subtitle", "time": 3618.305, "timestamp": "01:00:18", "text": "私は必要としている"}, {"type": "subtitle", "time": 3619.547, "timestamp": "01:00:19", "text": "ゲームを理解するため。"}, {"type": "subtitle", "time": 3627.206, "timestamp": "01:00:27", "text": "はい。友人の一人"}, {"type": "subtitle", "time": 3628.611, "timestamp": "01:00:28", "text": "それについて教えてくれた、"}, {"type": "subtitle", "time": 3630.015, "timestamp": "01:00:30", "text": "そして私は「ふむ、面白い」と思った。 「. 私は...試してみます"}, {"type": "subtitle", "time": 3637.179, "timestamp": "01:00:37", "text": "「. 私は...試してみます 確認してみます。賞"}, {"type": "subtitle", "time": 3641.218, "timestamp": "01:00:41", "text": "確認してみます。賞 約50,000"}, {"type": "subtitle", "time": 3643.238, "timestamp": "01:00:43", "text": "約50,000 円 これは基本的に私が"}, {"type": "subtitle", "time": 3648.824, "timestamp": "01:00:48", "text": "円 これは基本的に私が 間違ってないよ、えーと、"}, {"type": "subtitle", "time": 3654.752, "timestamp": "01:00:54", "text": "約40,000ルピー、"}, {"type": "subtitle", "time": 3658.389, "timestamp": "01:00:58", "text": "どうやら。そうは思わない。"}]
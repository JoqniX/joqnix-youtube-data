[{"type": "subtitle", "time": 600.718, "timestamp": "00:10:00", "text": "服用するつもりはありません。"}, {"type": "subtitle", "time": 601.922, "timestamp": "00:10:01", "text": "彼の護衛は"}, {"type": "subtitle", "time": 603.39, "timestamp": "00:10:03", "text": "一人で。私はすべきでしょうか"}, {"type": "subtitle", "time": 604.679, "timestamp": "00:10:04", "text": "このバッグを持って行ってください ？なぜだめですか？できました、"}, {"type": "subtitle", "time": 609.38, "timestamp": "00:10:09", "text": "でも、私にはわからない。私は私です"}, {"type": "subtitle", "time": 610.89, "timestamp": "00:10:10", "text": "それで結構です。に"}, {"type": "subtitle", "time": 614.662, "timestamp": "00:10:14", "text": "くそ。はい、そうです"}, {"type": "subtitle", "time": 615.48, "timestamp": "00:10:15", "text": "戻ってきた。"}, {"type": "subtitle", "time": 628.561, "timestamp": "00:10:28", "text": "私を見て。"}, {"type": "subtitle", "time": 630.916, "timestamp": "00:10:30", "text": "今。何のために？与える"}, {"type": "subtitle", "time": 632.229, "timestamp": "00:10:32", "text": "ドアを閉めますね。"}, {"type": "subtitle", "time": 642.5889999999999, "timestamp": "00:10:42", "text": "わかった。だから私たちは"}, {"type": "subtitle", "time": 643.962, "timestamp": "00:10:43", "text": "冒険に出かけよう。"}, {"type": "subtitle", "time": 647.08, "timestamp": "00:10:47", "text": "D. 屋外 はい"}, {"type": "subtitle", "time": 648.042, "timestamp": "00:10:48", "text": "冷たく。ここ"}, {"type": "subtitle", "time": 649.782, "timestamp": "00:10:49", "text": "文字通り21度。"}, {"type": "subtitle", "time": 652.511, "timestamp": "00:10:52", "text": "今は怖い。"}, {"type": "subtitle", "time": 658.255, "timestamp": "00:10:58", "text": "冷たく。そして私はただここにいる"}, {"type": "subtitle", "time": 659.4590000000001, "timestamp": "00:10:59", "text": "パーカーとジーンズを着て、"}]
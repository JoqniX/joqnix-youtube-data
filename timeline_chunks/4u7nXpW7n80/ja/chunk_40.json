[{"type": "subtitle", "time": 2401.406, "timestamp": "00:40:01", "text": "砂糖入りの紅茶"}, {"type": "subtitle", "time": 2402.891, "timestamp": "00:40:02", "text": "グラス3杯飲んで"}, {"type": "subtitle", "time": 2408.837, "timestamp": "00:40:08", "text": "寝た。そしてこれ"}, {"type": "subtitle", "time": 2409.879, "timestamp": "00:40:09", "text": "日常的になった"}, {"type": "subtitle", "time": 2411.181, "timestamp": "00:40:11", "text": "日常的になり、"}, {"type": "subtitle", "time": 2417.346, "timestamp": "00:40:17", "text": "毎回毎回"}, {"type": "subtitle", "time": 2418.771, "timestamp": "00:40:18", "text": "私は紅茶かコーヒーを飲みます。"}, {"type": "subtitle", "time": 2425.165, "timestamp": "00:40:25", "text": "寝たい。ありますか"}, {"type": "subtitle", "time": 2426.445, "timestamp": "00:40:26", "text": "人種差別に対して"}, {"type": "subtitle", "time": 2428.384, "timestamp": "00:40:28", "text": "インド人？場合による"}, {"type": "subtitle", "time": 2429.382, "timestamp": "00:40:29", "text": "そのうちの1つは"}, {"type": "subtitle", "time": 2430.477, "timestamp": "00:40:30", "text": "あなたがいるエリアまたは場所"}, {"type": "subtitle", "time": 2436.977, "timestamp": "00:40:36", "text": "あなたは。えっと、もし"}, {"type": "subtitle", "time": 2440.956, "timestamp": "00:40:40", "text": "あなたは東京にいると思います、ええと、"}, {"type": "subtitle", "time": 2443.633, "timestamp": "00:40:43", "text": "あまり多くはない。わからない。"}, {"type": "subtitle", "time": 2446.462, "timestamp": "00:40:46", "text": "わからない。しかしそうではない"}, {"type": "subtitle", "time": 2447.25, "timestamp": "00:40:47", "text": "多くの人々"}, {"type": "subtitle", "time": 2448.333, "timestamp": "00:40:48", "text": "私に見せてくれた"}, {"type": "subtitle", "time": 2449.646, "timestamp": "00:40:49", "text": "人種差別または外国人嫌悪。"}, {"type": "subtitle", "time": 2458.251, "timestamp": "00:40:58", "text": "もしあなたが"}, {"type": "subtitle", "time": 2459.488, "timestamp": "00:40:59", "text": "荒川西地区 たくさん触れる"}]
[{"type": "subtitle", "time": 3540.3, "timestamp": "00:59:00", "text": "赤色表示。"}, {"type": "subtitle", "time": 3544.047, "timestamp": "00:59:04", "text": "ええ、もう長い間やっていません。"}, {"type": "subtitle", "time": 3545.047, "timestamp": "00:59:05", "text": "これを使った"}, {"type": "subtitle", "time": 3545.798, "timestamp": "00:59:05", "text": "申請"}, {"type": "subtitle", "time": 3549.659, "timestamp": "00:59:09", "text": "ストリーミング配信。しかし、そうです。"}, {"type": "subtitle", "time": 3554.374, "timestamp": "00:59:14", "text": "楽しい。つまり、"}, {"type": "subtitle", "time": 3555.808, "timestamp": "00:59:15", "text": "すべてのものは永遠に続く"}, {"type": "subtitle", "time": 3559.687, "timestamp": "00:59:19", "text": "時々？他の皆と同じように"}, {"type": "subtitle", "time": 3560.777, "timestamp": "00:59:20", "text": "最後に"}, {"type": "subtitle", "time": 3567.27, "timestamp": "00:59:27", "text": "時々？私はしたい"}, {"type": "subtitle", "time": 3568.571, "timestamp": "00:59:28", "text": "多くのこと、しかし"}, {"type": "subtitle", "time": 3577.46, "timestamp": "00:59:37", "text": "できます。ああ、私はほとんど"}, {"type": "subtitle", "time": 3578.45, "timestamp": "00:59:38", "text": "彼の…を見せた。"}, {"type": "subtitle", "time": 3582.206, "timestamp": "00:59:42", "text": "鏡の中の携帯電話。"}, {"type": "subtitle", "time": 3584.221, "timestamp": "00:59:44", "text": "鏡があった"}, {"type": "subtitle", "time": 3585.531, "timestamp": "00:59:45", "text": "表面。何てことだ。"}, {"type": "subtitle", "time": 3587.119, "timestamp": "00:59:47", "text": "電源を切っておいて本当に良かった。"}, {"type": "subtitle", "time": 3588.83, "timestamp": "00:59:48", "text": "カメラ。ああ、私は"}, {"type": "subtitle", "time": 3590.077, "timestamp": "00:59:50", "text": "とても不注意"}, {"type": "subtitle", "time": 3593.033, "timestamp": "00:59:53", "text": "今。夕食は食べましたか？はい 夕食をとった。ああ、そうだね。"}]
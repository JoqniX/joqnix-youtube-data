[{"type": "subtitle", "time": 1276.118, "timestamp": "00:21:16", "text": "そして私はこう言った。「わからない」"}, {"type": "subtitle", "time": 1277.603, "timestamp": "00:21:17", "text": "何をするか？私はできません"}, {"type": "subtitle", "time": 1279.067, "timestamp": "00:21:19", "text": "それを実行する。でも私は"}, {"type": "subtitle", "time": 1280.219, "timestamp": "00:21:20", "text": "何らかの方法でそれを行う"}, {"type": "subtitle", "time": 1284.846, "timestamp": "00:21:24", "text": "一瞬。そしてほとんどの場合"}, {"type": "subtitle", "time": 1286.071, "timestamp": "00:21:26", "text": "私は、そうしたくないと気づいた。"}, {"type": "subtitle", "time": 1287.168, "timestamp": "00:21:27", "text": "抑制するために"}, {"type": "subtitle", "time": 1287.877, "timestamp": "00:21:27", "text": "私が"}, {"type": "subtitle", "time": 1289.135, "timestamp": "00:21:29", "text": "疲れていて、"}, {"type": "subtitle", "time": 1290.038, "timestamp": "00:21:30", "text": "お見せするために"}, {"type": "subtitle", "time": 1291.102, "timestamp": "00:21:31", "text": "疲れた「犬」"}, {"type": "subtitle", "time": 1297.909, "timestamp": "00:21:37", "text": "あなたが来た時。あなた"}, {"type": "subtitle", "time": 1299.273, "timestamp": "00:21:39", "text": "楽しみたい、"}, {"type": "subtitle", "time": 1300.453, "timestamp": "00:21:40", "text": "微笑んで、そして私は"}, {"type": "subtitle", "time": 1309.028, "timestamp": "00:21:49", "text": "これをあなたにあげたい。それで"}, {"type": "subtitle", "time": 1311.48, "timestamp": "00:21:51", "text": "これが私の理由です。したがって。"}, {"type": "subtitle", "time": 1314.013, "timestamp": "00:21:54", "text": "今日はちょうど"}, {"type": "subtitle", "time": 1315.212, "timestamp": "00:21:55", "text": "チャットしたかった"}, {"type": "subtitle", "time": 1318.119, "timestamp": "00:21:58", "text": "人生とか、そういうことについて。"}]
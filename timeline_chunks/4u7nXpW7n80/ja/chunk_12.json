[{"type": "subtitle", "time": 721.808, "timestamp": "00:12:01", "text": "だからダニー、君は"}, {"type": "subtitle", "time": 722.922, "timestamp": "00:12:02", "text": "私が気づかないこと"}, {"type": "subtitle", "time": 726.867, "timestamp": "00:12:06", "text": "1週間と3週間禁欲した"}, {"type": "subtitle", "time": 728.429, "timestamp": "00:12:08", "text": "または4日間。どうやら、"}, {"type": "subtitle", "time": 731.709, "timestamp": "00:12:11", "text": "数えきれなくなった。私"}, {"type": "subtitle", "time": 734.328, "timestamp": "00:12:14", "text": "私は長い間、遠慮せずに発言してきた。見せる"}, {"type": "subtitle", "time": 741.652, "timestamp": "00:12:21", "text": "始まります 私は持っています"}, {"type": "subtitle", "time": 746.546, "timestamp": "00:12:26", "text": "やるべきことはたくさんあり、"}, {"type": "subtitle", "time": 750.254, "timestamp": "00:12:30", "text": "すべては"}, {"type": "subtitle", "time": 754.528, "timestamp": "00:12:34", "text": "実際にはそれはできなかったのですが、"}, {"type": "subtitle", "time": 760.905, "timestamp": "00:12:40", "text": "すべてを正しく行うために、"}, {"type": "subtitle", "time": 765.015, "timestamp": "00:12:45", "text": "あるいはこう言うこともできます"}, {"type": "subtitle", "time": 768.011, "timestamp": "00:12:48", "text": "そのため私は"}, {"type": "subtitle", "time": 772.78, "timestamp": "00:12:52", "text": "物事を行うために私は"}, {"type": "subtitle", "time": 774.104, "timestamp": "00:12:54", "text": "優先"}, {"type": "subtitle", "time": 775.33, "timestamp": "00:12:55", "text": "サイドクエスト、"}, {"type": "subtitle", "time": 776.655, "timestamp": "00:12:56", "text": "実際はそうではない"}, {"type": "subtitle", "time": 777.847, "timestamp": "00:12:57", "text": "すでに重要ですが、"}, {"type": "subtitle", "time": 778.907, "timestamp": "00:12:58", "text": "それでもそれらは必要だった"}]
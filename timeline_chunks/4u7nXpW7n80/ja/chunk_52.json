[{"type": "subtitle", "time": 3132.006, "timestamp": "00:52:12", "text": "下の石。さようなら、"}, {"type": "subtitle", "time": 3135.992, "timestamp": "00:52:15", "text": "男らしい。ああ、あの川。"}, {"type": "subtitle", "time": 3141.216, "timestamp": "00:52:21", "text": "待って、覚えている人いる？"}, {"type": "subtitle", "time": 3143.394, "timestamp": "00:52:23", "text": "待って、君"}, {"type": "subtitle", "time": 3145.209, "timestamp": "00:52:25", "text": "覚えていますか？わからない。"}, {"type": "subtitle", "time": 3146.627, "timestamp": "00:52:26", "text": "皆さんのほとんどは新規参加者ですね。 、 右？昔々、"}, {"type": "subtitle", "time": 3149.49, "timestamp": "00:52:29", "text": "、 右？昔々、 当時、私はストリーミング配信をしていました"}, {"type": "subtitle", "time": 3150.919, "timestamp": "00:52:30", "text": "当時、私はストリーミング配信をしていました インドの海に近い場所。がある"}, {"type": "subtitle", "time": 3159.055, "timestamp": "00:52:39", "text": "はい、それから私は"}, {"type": "subtitle", "time": 3160.251, "timestamp": "00:52:40", "text": "音声ストリームのみ。"}, {"type": "subtitle", "time": 3165.415, "timestamp": "00:52:45", "text": "視覚的な情報はなく、"}, {"type": "subtitle", "time": 3166.748, "timestamp": "00:52:46", "text": "しかし、私が"}, {"type": "subtitle", "time": 3174.528, "timestamp": "00:52:54", "text": "私のようなビデオを見せた"}, {"type": "subtitle", "time": 3175.897, "timestamp": "00:52:55", "text": "私はビーチに行って、絵を描く。"}, {"type": "subtitle", "time": 3177.34, "timestamp": "00:52:57", "text": "砂浜に書かれた全員の名前と"}]
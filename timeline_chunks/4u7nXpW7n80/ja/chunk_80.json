[{"type": "subtitle", "time": 4800.746, "timestamp": "01:20:00", "text": "わかりました。ご挨拶申し上げます。私"}, {"type": "chat", "time": 4801.447, "timestamp": "01:20:01", "author": "@MikazukiYure", "avatar": "https://yt4.ggpht.com/uuFSD7qVrZy0JUWrBRfSfEKIQpib7_2xP24Yiu1ND1Mq6uhaYIHDnA5EiGz_o33FUhHYvbCT9g=s64-c-k-c0x00ffffff-no-rj", "message": "otsu~"}, {"type": "subtitle", "time": 4804.477, "timestamp": "01:20:04", "text": "約束します、私は"}, {"type": "subtitle", "time": 4805.799, "timestamp": "01:20:05", "text": "最善を尽くします。"}, {"type": "subtitle", "time": 4807.268, "timestamp": "01:20:07", "text": "もっと頻繁にストリーミングするために、"}, {"type": "subtitle", "time": 4811.239, "timestamp": "01:20:11", "text": "良い？だってほら、"}, {"type": "subtitle", "time": 4812.575, "timestamp": "01:20:12", "text": "何よりも、私は"}, {"type": "subtitle", "time": 4816.185, "timestamp": "01:20:16", "text": "これが私です"}, {"type": "subtitle", "time": 4818.264, "timestamp": "01:20:18", "text": "私は生きている。だから私は"}, {"type": "subtitle", "time": 4819.263, "timestamp": "01:20:19", "text": "私は続ける。"}, {"type": "subtitle", "time": 4854.163, "timestamp": "01:20:54", "text": "ストリーミングを許可する"}, {"type": "subtitle", "time": 4858.044, "timestamp": "01:20:58", "text": "これをお見せします"}, {"type": "subtitle", "time": 4859.544, "timestamp": "01:20:59", "text": "星は見えますか？"}]
[{"type": "subtitle", "time": 2221.057, "timestamp": "00:37:01", "text": "インターネットでやること、"}, {"type": "subtitle", "time": 2222.167, "timestamp": "00:37:02", "text": "あなたはいつ外出しますか？"}, {"type": "subtitle", "time": 2227.192, "timestamp": "00:37:07", "text": "モバイル"}, {"type": "subtitle", "time": 2228.037, "timestamp": "00:37:08", "text": "あなたはオペレーターです"}, {"type": "subtitle", "time": 2231.051, "timestamp": "00:37:11", "text": "あなたはそれを使っていますか？私はそうではない"}, {"type": "subtitle", "time": 2232.243, "timestamp": "00:37:12", "text": "私がこれについて尋ねるのは、"}, {"type": "chat", "time": 2232.533, "timestamp": "00:37:12", "author": "@MikazukiYure", "avatar": "https://yt4.ggpht.com/uuFSD7qVrZy0JUWrBRfSfEKIQpib7_2xP24Yiu1ND1Mq6uhaYIHDnA5EiGz_o33FUhHYvbCT9g=s64-c-k-c0x00ffffff-no-rj", "message": "sou danee"}, {"type": "subtitle", "time": 2235.396, "timestamp": "00:37:15", "text": "一部の地域ではなぜ"}, {"type": "subtitle", "time": 2236.626, "timestamp": "00:37:16", "text": "コーヒーを飲まないのですか、それとも"}, {"type": "subtitle", "time": 2240.399, "timestamp": "00:37:20", "text": "そんな感じ？ああ、君"}, {"type": "subtitle", "time": 2242.332, "timestamp": "00:37:22", "text": "右。いや、いや、いや。私"}, {"type": "subtitle", "time": 2243.561, "timestamp": "00:37:23", "text": "もう寝なければならない。"}, {"type": "subtitle", "time": 2246.35, "timestamp": "00:37:26", "text": "すぐ。私は行かなければならない。"}, {"type": "subtitle", "time": 2247.564, "timestamp": "00:37:27", "text": "寝る。私は必要としている"}, {"type": "subtitle", "time": 2248.646, "timestamp": "00:37:28", "text": "6時に起床"}, {"type": "subtitle", "time": 2251.332, "timestamp": "00:37:31", "text": "時間。 6時間または5時間。"}, {"type": "subtitle", "time": 2254.7, "timestamp": "00:37:34", "text": "私は行かなければならない"}, {"type": "subtitle", "time": 2256.18, "timestamp": "00:37:36", "text": "パートタイムの仕事。私は持っている"}, {"type": "subtitle", "time": 2257.389, "timestamp": "00:37:37", "text": "いいえ、持っていません"}, {"type": "subtitle", "time": 2258.437, "timestamp": "00:37:38", "text": "自転車。それで"}, {"type": "subtitle", "time": 2259.597, "timestamp": "00:37:39", "text": "今日中に必要です。"}, {"type": "subtitle", "time": 2260.758, "timestamp": "00:37:40", "text": "徒歩で通勤する。"}, {"type": "subtitle", "time": 2264.079, "timestamp": "00:37:44", "text": "私は戻ってきます、私は休みます、"}, {"type": "subtitle", "time": 2265.456, "timestamp": "00:37:45", "text": "私は2つ目の仕事に行きます。"}, {"type": "subtitle", "time": 2269.538, "timestamp": "00:37:49", "text": "私は電車に乗ります。"}, {"type": "subtitle", "time": 2274.525, "timestamp": "00:37:54", "text": "戻ります。自宅のどこかで"}, {"type": "subtitle", "time": 2276.49, "timestamp": "00:37:56", "text": "午後10時または午後9時30分に、"}, {"type": "subtitle", "time": 2278.509, "timestamp": "00:37:58", "text": "もしかしたら私にはチャンスがあるかもしれない"}]
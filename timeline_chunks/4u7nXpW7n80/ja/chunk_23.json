[{"type": "subtitle", "time": 1381.953, "timestamp": "00:23:01", "text": "奥の部屋。ああ、そうだね。 私たちはそこへ行く"}, {"type": "subtitle", "time": 1382.834, "timestamp": "00:23:02", "text": "私たちはそこへ行く ランダムミッション"}, {"type": "subtitle", "time": 1384.019, "timestamp": "00:23:04", "text": "ランダムミッション そこには。なぜこうなるのでしょうか？"}, {"type": "subtitle", "time": 1385.17, "timestamp": "00:23:05", "text": "そこには。なぜこうなるのでしょうか？ 感じ"}, {"type": "subtitle", "time": 1386.197, "timestamp": "00:23:06", "text": "感じ ホラーな雰囲気だね？"}, {"type": "subtitle", "time": 1387.597, "timestamp": "00:23:07", "text": "ホラーな雰囲気だね？ なぜ、なぜこれは"}, {"type": "subtitle", "time": 1388.767, "timestamp": "00:23:08", "text": "なぜ、なぜこれは 私のナイトモード"}, {"type": "subtitle", "time": 1389.904, "timestamp": "00:23:09", "text": "私のナイトモード カメラ？なんてこった？"}, {"type": "subtitle", "time": 1398.498, "timestamp": "00:23:18", "text": "なんてこった？待って、"}, {"type": "subtitle", "time": 1400.394, "timestamp": "00:23:20", "text": "待って。彼らは片付けた。"}, {"type": "subtitle", "time": 1403.667, "timestamp": "00:23:23", "text": "コカコーラ。いいえ、彼らは何ですか?"}, {"type": "subtitle", "time": 1406.273, "timestamp": "00:23:26", "text": "くそ？いいえ、彼らは"}, {"type": "subtitle", "time": 1410.026, "timestamp": "00:23:30", "text": "コカ・コーラは撤去された。はい。"}, {"type": "subtitle", "time": 1411.886, "timestamp": "00:23:31", "text": "いいえ、削除されました。"}, {"type": "subtitle", "time": 1416.497, "timestamp": "00:23:36", "text": "コカコーラ。いいえ、彼らは"}, {"type": "subtitle", "time": 1417.973, "timestamp": "00:23:37", "text": "彼らは本当にそれを削除した。"}, {"type": "subtitle", "time": 1421.474, "timestamp": "00:23:41", "text": "兄弟。それらは本当に彼女のものだ。"}, {"type": "subtitle", "time": 1423.622, "timestamp": "00:23:43", "text": "清掃済み。しかしこれは"}, {"type": "subtitle", "time": 1424.525, "timestamp": "00:23:44", "text": "トマトジュース。"}, {"type": "subtitle", "time": 1427.068, "timestamp": "00:23:47", "text": "レモンスカッシュ。"}, {"type": "subtitle", "time": 1429.334, "timestamp": "00:23:49", "text": "彼はどんな人なんだろう。"}]
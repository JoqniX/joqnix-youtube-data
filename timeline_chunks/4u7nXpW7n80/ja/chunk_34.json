[{"type": "subtitle", "time": 2042.615, "timestamp": "00:34:02", "text": "はい？私は…一瞬"}, {"type": "subtitle", "time": 2043.52, "timestamp": "00:34:03", "text": "いや、そうでもないかもしれないと思った。"}, {"type": "subtitle", "time": 2044.843, "timestamp": "00:34:04", "text": "エイリアンはスライムです、"}, {"type": "subtitle", "time": 2046.235, "timestamp": "00:34:06", "text": "彼はとても優秀で"}, {"type": "subtitle", "time": 2052.473, "timestamp": "00:34:12", "text": "そこで何かが起こっている。何"}, {"type": "subtitle", "time": 2057.723, "timestamp": "00:34:17", "text": "冗談じゃないよ？はい、"}, {"type": "subtitle", "time": 2060.68, "timestamp": "00:34:20", "text": "それはただ…そうなんです"}, {"type": "subtitle", "time": 2063.867, "timestamp": "00:34:23", "text": "ただの…プラスチック"}, {"type": "subtitle", "time": 2067.376, "timestamp": "00:34:27", "text": "膜。はい、その通りです。"}, {"type": "subtitle", "time": 2069.723, "timestamp": "00:34:29", "text": "いいね、ダイアナ。もしあなたが"}, {"type": "subtitle", "time": 2070.857, "timestamp": "00:34:30", "text": "感じることができる"}, {"type": "subtitle", "time": 2075.216, "timestamp": "00:34:35", "text": "寒さとか、そういうこと全部。あなた"}, {"type": "subtitle", "time": 2076.32, "timestamp": "00:34:36", "text": "私の"}, {"type": "subtitle", "time": 2077.652, "timestamp": "00:34:37", "text": "昆虫用マイクまたは"}, {"type": "subtitle", "time": 2082.543, "timestamp": "00:34:42", "text": "セミ、えーと、"}, {"type": "subtitle", "time": 2085.655, "timestamp": "00:34:45", "text": "大声で叫ぶ、または、"}, {"type": "subtitle", "time": 2087.552, "timestamp": "00:34:47", "text": "彼らは歌うのかもしれない？多分"}, {"type": "subtitle", "time": 2088.685, "timestamp": "00:34:48", "text": "彼らは叫ばないが、"}, {"type": "subtitle", "time": 2089.371, "timestamp": "00:34:49", "text": "歌う- さえずりながら、"}, {"type": "subtitle", "time": 2090.641, "timestamp": "00:34:50", "text": "さえずりながら、 言う。時々。まだ"}, {"type": "subtitle", "time": 2098.237, "timestamp": "00:34:58", "text": "言う。時々。まだ 1回の取引"}, {"type": "subtitle", "time": 2099.183, "timestamp": "00:34:59", "text": "1回の取引 機関銃、そして待って、これ"}]
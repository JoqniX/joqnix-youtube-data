[{"type": "subtitle", "time": 2824.059, "timestamp": "00:47:04", "text": "彼らは運転した。でもでもでも、"}, {"type": "subtitle", "time": 2825.657, "timestamp": "00:47:05", "text": "正直、そうすべきでしょうか？"}, {"type": "subtitle", "time": 2832.546, "timestamp": "00:47:12", "text": "この時間にここにいるのですか？がある、"}, {"type": "subtitle", "time": 2834.071, "timestamp": "00:47:14", "text": "これはストリームで発生します"}, {"type": "subtitle", "time": 2835.322, "timestamp": "00:47:15", "text": "「ただおしゃべりする」形式、"}, {"type": "subtitle", "time": 2836.769, "timestamp": "00:47:16", "text": "私の記憶が正しければ。"}, {"type": "subtitle", "time": 2840.573, "timestamp": "00:47:20", "text": "時々、時々、こんな風に"}, {"type": "subtitle", "time": 2841.954, "timestamp": "00:47:21", "text": "「ただの雑談」で起こる"}, {"type": "subtitle", "time": 2849.907, "timestamp": "00:47:29", "text": "おそらく、小川の中だろう。しかし"}, {"type": "subtitle", "time": 2850.927, "timestamp": "00:47:30", "text": "雰囲気はこんな感じ"}, {"type": "subtitle", "time": 2857.855, "timestamp": "00:47:37", "text": "寒い。現在作業中です"}, {"type": "subtitle", "time": 2858.929, "timestamp": "00:47:38", "text": "2つの仕事を掛け持ちしている。"}, {"type": "subtitle", "time": 2860.041, "timestamp": "00:47:40", "text": "とても穏やかだ。"}, {"type": "subtitle", "time": 2861.327, "timestamp": "00:47:41", "text": "待って、あなたは仕事中ですよね。"}, {"type": "subtitle", "time": 2868.868, "timestamp": "00:47:48", "text": "二つの仕事を掛け持ちしている？または"}, {"type": "subtitle", "time": 2869.992, "timestamp": "00:47:49", "text": "私にとって、それは本当に価値があるのだろうか？"}, {"type": "subtitle", "time": 2871.747, "timestamp": "00:47:51", "text": "そこへ行くために？これは本当に怖い。 、 お前。ああ、今夜。"}]
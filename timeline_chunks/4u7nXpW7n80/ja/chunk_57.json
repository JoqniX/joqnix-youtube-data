[{"type": "subtitle", "time": 3446.679, "timestamp": "00:57:26", "text": "バカシ、君。はい。何"}, {"type": "subtitle", "time": 3448.09, "timestamp": "00:57:28", "text": "何が起こったのか？何もない"}, {"type": "subtitle", "time": 3452.051, "timestamp": "00:57:32", "text": "このような。私が話していたのは"}, {"type": "subtitle", "time": 3453.279, "timestamp": "00:57:33", "text": "もう10月だ、"}, {"type": "subtitle", "time": 3457.213, "timestamp": "00:57:37", "text": "今は10月です。それ"}, {"type": "subtitle", "time": 3459.516, "timestamp": "00:57:39", "text": "月…ああ、そうだ。それ"}, {"type": "subtitle", "time": 3460.777, "timestamp": "00:57:40", "text": "月、さて、どうですか？"}, {"type": "subtitle", "time": 3464.906, "timestamp": "00:57:44", "text": "名前を挙げると？私たちは試合をしなければならない。"}, {"type": "subtitle", "time": 3466.366, "timestamp": "00:57:46", "text": "ゲームをしたり、ホラー映画を見たり、"}, {"type": "subtitle", "time": 3473.042, "timestamp": "00:57:53", "text": "はい？ああ、そうだね。"}, {"type": "subtitle", "time": 3474.146, "timestamp": "00:57:54", "text": "調べてみると、"}, {"type": "subtitle", "time": 3475.079, "timestamp": "00:57:55", "text": "レモン"}, {"type": "subtitle", "time": 3477.001, "timestamp": "00:57:57", "text": "すごくクール。与える"}, {"type": "subtitle", "time": 3478.158, "timestamp": "00:57:58", "text": "何らかの料金"}]
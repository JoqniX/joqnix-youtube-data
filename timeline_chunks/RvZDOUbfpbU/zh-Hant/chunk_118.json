[{"type": "subtitle", "time": 7081.83, "timestamp": "01:58:01", "text": "太瘋狂了。尋路者。說到模擬遊戲，我現在也有這個遊戲了。計劃一。好久沒玩了。也許哪天我們可以一起玩計畫一。我不太喜歡多人遊戲。我想。"}, {"type": "subtitle", "time": 7117.27, "timestamp": "01:58:37", "text": "哦，數碼寶貝。好的，等等。讓我查一下。數碼寶貝"}, {"type": "subtitle", "time": 7131.669, "timestamp": "01:58:51", "text": "。數碼寶貝故事時間：陌生人。"}, {"type": "subtitle", "time": 7134.07, "timestamp": "01:58:54", "text": "這是一個以動漫為基礎的組隊角色扮演遊戲。哦"}]
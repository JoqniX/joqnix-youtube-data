[{"type": "subtitle", "time": 424.87, "timestamp": "00:07:04", "text": "讓我切換一下場景，"}, {"type": "subtitle", "time": 428.71, "timestamp": "00:07:08", "text": "試著設定一下。"}, {"type": "subtitle", "time": 432.309, "timestamp": "00:07:12", "text": "遊戲在哪裡？拍下這一幕。  嗯，就是這樣"}, {"type": "subtitle", "time": 434.95, "timestamp": "00:07:14", "text": "。"}, {"type": "subtitle", "time": 437.189, "timestamp": "00:07:17", "text": "哦，等等。瓦萊林會被抓走嗎？"}, {"type": "subtitle", "time": 440.07, "timestamp": "00:07:20", "text": "是的，它確實被拍到了。"}, {"type": "subtitle", "time": 451.589, "timestamp": "00:07:31", "text": "下雷暴雨"}, {"type": "subtitle", "time": 455.43, "timestamp": "00:07:35", "text": "。今天我的網路會有點"}, {"type": "subtitle", "time": 457.99, "timestamp": "00:07:37", "text": "不穩定。"}, {"type": "subtitle", "time": 459.909, "timestamp": "00:07:39", "text": "所以，可能會有延誤等等。"}, {"type": "subtitle", "time": 463.029, "timestamp": "00:07:43", "text": "好的。等待。"}, {"type": "subtitle", "time": 464.79, "timestamp": "00:07:44", "text": "呃，"}, {"type": "subtitle", "time": 467.11, "timestamp": "00:07:47", "text": "我得在"}, {"type": "subtitle", "time": 475.83, "timestamp": "00:07:55", "text": "我的所有社群帳號都被鎖了。"}, {"type": "subtitle", "time": 478.629, "timestamp": "00:07:58", "text": "真想知道為什麼"}]
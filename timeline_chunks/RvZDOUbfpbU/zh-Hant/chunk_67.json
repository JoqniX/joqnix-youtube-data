[{"type": "subtitle", "time": 4023.99, "timestamp": "01:07:03", "text": "我需要這樣的遊戲。所以我"}, {"type": "subtitle", "time": 4026.71, "timestamp": "01:07:06", "text": "想知道它是什麼時候發布的？ 2023年。所以這是一款老遊戲了，是嗎？  這是一款第三人稱射擊遊戲。什麼？  好的"}, {"type": "subtitle", "time": 4031.91, "timestamp": "01:07:11", "text": "，這是第一人稱敘述。好的。"}, {"type": "subtitle", "time": 4044.95, "timestamp": "01:07:24", "text": "嗯，有點想買《菲爾之戰6》"}, {"type": "subtitle", "time": 4049.75, "timestamp": "01:07:29", "text": "。我是說，我去年玩得很開心。那段時間，該劇一直在播放測試版"}, {"type": "subtitle", "time": 4058.789, "timestamp": "01:07:38", "text": "。  只有《三角洲特種部隊》有類似「戰場模式」之類的東西。  Delta Forest 有氛圍模式嗎？它叫"}]
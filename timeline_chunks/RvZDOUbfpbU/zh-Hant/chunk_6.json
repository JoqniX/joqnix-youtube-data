[{"type": "subtitle", "time": 389.51, "timestamp": "00:06:29", "text": "，今天我們要玩《"}, {"type": "subtitle", "time": 391.51, "timestamp": "00:06:31", "text": "Valerant》。"}, {"type": "subtitle", "time": 393.909, "timestamp": "00:06:33", "text": "呃，因為"}, {"type": "subtitle", "time": 397.43, "timestamp": "00:06:37", "text": "這個週末[音樂]就是《"}, {"type": "subtitle", "time": 401.51, "timestamp": "00:06:41", "text": "決勝時刻》公開測試版發布的時候。"}, {"type": "subtitle", "time": 405.99, "timestamp": "00:06:45", "text": "所以我想，今晚不如玩《"}, {"type": "subtitle", "time": 408.15, "timestamp": "00:06:48", "text": "Valerant》。"}, {"type": "subtitle", "time": 412.23, "timestamp": "00:06:52", "text": "所以，大概要到晚上10點或11點才會結束。"}, {"type": "subtitle", "time": 414.15, "timestamp": "00:06:54", "text": "所以，直播時間會比較短。"}]
[{"type": "subtitle", "time": 389.51, "timestamp": "00:06:29", "text": "嗯，是的，今天我们要玩《"}, {"type": "subtitle", "time": 391.51, "timestamp": "00:06:31", "text": "Valerant》。"}, {"type": "subtitle", "time": 393.909, "timestamp": "00:06:33", "text": "呃，因为"}, {"type": "subtitle", "time": 397.43, "timestamp": "00:06:37", "text": "这个周末[音乐]就是《"}, {"type": "subtitle", "time": 401.51, "timestamp": "00:06:41", "text": "使命召唤》公开测试版发布的时候。"}, {"type": "subtitle", "time": 405.99, "timestamp": "00:06:45", "text": "所以我想，"}, {"type": "subtitle", "time": 408.15, "timestamp": "00:06:48", "text": "今晚不如玩玩《Valerant》吧。"}, {"type": "subtitle", "time": 412.23, "timestamp": "00:06:52", "text": "所以，大概要到晚上10点或11点才会结束。"}, {"type": "subtitle", "time": 414.15, "timestamp": "00:06:54", "text": "所以，直播时间会比较短。"}]
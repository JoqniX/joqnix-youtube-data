[{"type": "subtitle", "time": 3001.109, "timestamp": "00:50:01", "text": "这个人还有这个人一样解锁他们。 这个人，"}, {"type": "subtitle", "time": 3003.51, "timestamp": "00:50:03", "text": "这个人。"}, {"type": "subtitle", "time": 3012.47, "timestamp": "00:50:12", "text": "那么，大家今天过得怎么样？"}, {"type": "subtitle", "time": 3015.27, "timestamp": "00:50:15", "text": "希望大家都好。"}, {"type": "subtitle", "time": 3033.829, "timestamp": "00:50:33", "text": "说实话[笑]"}, {"type": "subtitle", "time": 3035.349, "timestamp": "00:50:35", "text": "我真的觉得"}, {"type": "subtitle", "time": 3042.87, "timestamp": "00:50:42", "text": "天气变化太慢了，不合我的"}, {"type": "subtitle", "time": 3044.63, "timestamp": "00:50:44", "text": "胃口。"}, {"type": "subtitle", "time": 3047.43, "timestamp": "00:50:47", "text": "我当时很困惑，不知道该"}, {"type": "subtitle", "time": 3052.71, "timestamp": "00:50:52", "text": "直播玩《Pickax》还是《Valerant》还是《"}, {"type": "subtitle", "time": 3054.87, "timestamp": "00:50:54", "text": "Fortnite》，"}, {"type": "subtitle", "time": 3057.589, "timestamp": "00:50:57", "text": "然后我就想，好吧，"}, {"type": "subtitle", "time": 3059.91, "timestamp": "00:50:59", "text": "那就《Valerant》吧。"}]
[{"type": "subtitle", "time": 424.87, "timestamp": "00:07:04", "text": "让我切换一下场景，"}, {"type": "subtitle", "time": 428.71, "timestamp": "00:07:08", "text": "尝试设置一下。"}, {"type": "subtitle", "time": 432.309, "timestamp": "00:07:12", "text": "游戏在哪里？ 拍下这一幕。"}, {"type": "subtitle", "time": 434.95, "timestamp": "00:07:14", "text": "嗯，就是这样。"}, {"type": "subtitle", "time": 437.189, "timestamp": "00:07:17", "text": "哦，等等。 瓦莱林会被俘虏吗？"}, {"type": "subtitle", "time": 440.07, "timestamp": "00:07:20", "text": "是的，它确实被拍到了。"}, {"type": "subtitle", "time": 451.589, "timestamp": "00:07:31", "text": "下雷"}, {"type": "subtitle", "time": 455.43, "timestamp": "00:07:35", "text": "暴雨。 今天我的网络会有点"}, {"type": "subtitle", "time": 457.99, "timestamp": "00:07:37", "text": "不稳定。"}, {"type": "subtitle", "time": 459.909, "timestamp": "00:07:39", "text": "所以，可能会有延误等等。"}, {"type": "subtitle", "time": 463.029, "timestamp": "00:07:43", "text": "好的。 等待。"}, {"type": "subtitle", "time": 464.79, "timestamp": "00:07:44", "text": "呃，"}, {"type": "subtitle", "time": 467.11, "timestamp": "00:07:47", "text": "我得在这边做点事"}, {"type": "subtitle", "time": 475.83, "timestamp": "00:07:55", "text": "我的所有社交账号都被锁了。"}, {"type": "subtitle", "time": 478.629, "timestamp": "00:07:58", "text": "真想知道为什么"}]
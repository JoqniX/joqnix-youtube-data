[{"type": "subtitle", "time": 9243.51, "timestamp": "02:34:03", "text": "哦，他们给你看的就像你的杂志一样。"}, {"type": "subtitle", "time": 9248.23, "timestamp": "02:34:08", "text": "还剩多少弹匣？ 为什么我不能跳？"}, {"type": "subtitle", "time": 9249.99, "timestamp": "02:34:09", "text": "别告诉我毫无进展。"}, {"type": "subtitle", "time": 9261.91, "timestamp": "02:34:21", "text": "感觉有点像手机游戏。"}, {"type": "subtitle", "time": 9264.55, "timestamp": "02:34:24", "text": "我不想"}, {"type": "subtitle", "time": 9275.11, "timestamp": "02:34:35", "text": "也许是我太习惯于把《使命召唤》和《"}]
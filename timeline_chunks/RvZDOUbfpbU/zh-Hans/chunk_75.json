[{"type": "subtitle", "time": 4500.63, "timestamp": "01:15:00", "text": "我的天啊。 我这周会直播的"}, {"type": "subtitle", "time": 4502.47, "timestamp": "01:15:02", "text": "。"}, {"type": "subtitle", "time": 4507.35, "timestamp": "01:15:07", "text": "我没用过，我也很想念它。 哇。"}, {"type": "subtitle", "time": 4509.83, "timestamp": "01:15:09", "text": "你为什么总是惹麻烦？"}, {"type": "subtitle", "time": 4518.47, "timestamp": "01:15:18", "text": "他打出了一杆进洞。 哇。"}, {"type": "subtitle", "time": 4520.63, "timestamp": "01:15:20", "text": "你看到他了吗？ 哇。"}, {"type": "subtitle", "time": 4522.55, "timestamp": "01:15:22", "text": "猝死。"}, {"type": "subtitle", "time": 4543.83, "timestamp": "01:15:43", "text": "Spike种下了。"}]
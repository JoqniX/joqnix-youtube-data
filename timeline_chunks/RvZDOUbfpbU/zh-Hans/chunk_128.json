[{"type": "subtitle", "time": 7680.39, "timestamp": "02:08:00", "text": "游戏，不算太多。"}, {"type": "subtitle", "time": 7682.55, "timestamp": "02:08:02", "text": "让我换个地方。哦，对了。为什么"}, {"type": "subtitle", "time": 7697.83, "timestamp": "02:08:17", "text": "我本来应该把它自动化的，但"}, {"type": "subtitle", "time": 7700.87, "timestamp": "02:08:20", "text": "我忘了。"}, {"type": "subtitle", "time": 7702.95, "timestamp": "02:08:22", "text": "问题是我真的真的不想"}, {"type": "subtitle", "time": 7705.03, "timestamp": "02:08:25", "text": "在这台笔记本电脑上运行后台程序"}, {"type": "subtitle", "time": 7709.75, "timestamp": "02:08:29", "text": "。如果是我的台式机，我有 32GB"}, {"type": "subtitle", "time": 7711.83, "timestamp": "02:08:31", "text": "内存，那就没"}, {"type": "subtitle", "time": 7714.79, "timestamp": "02:08:34", "text": "问题。但这台电脑，这台笔记本电脑，"}, {"type": "subtitle", "time": 7718.55, "timestamp": "02:08:38", "text": "现在只有 16GB"}, {"type": "subtitle", "time": 7721.75, "timestamp": "02:08:41", "text": "内存，"}, {"type": "subtitle", "time": 7724.229, "timestamp": "02:08:44", "text": "运行后台程序"}, {"type": "subtitle", "time": 7726.87, "timestamp": "02:08:46", "text": "真的很糟糕。"}, {"type": "subtitle", "time": 7728.95, "timestamp": "02:08:48", "text": "这就是为什么我要把一切都"}, {"type": "subtitle", "time": 7733.109, "timestamp": "02:08:53", "text": "简化到极致，没有自动化功能，没有"}, {"type": "subtitle", "time": 7735.83, "timestamp": "02:08:55", "text": "后端处理功能，所有东西都"}, {"type": "subtitle", "time": 7737.91, "timestamp": "02:08:57", "text": "在…… 云端。"}]
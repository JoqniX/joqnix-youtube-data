[{"type": "subtitle", "time": 7578.79, "timestamp": "02:06:18", "text": "你获得了这么多徽章。"}, {"type": "subtitle", "time": 7583.109, "timestamp": "02:06:23", "text": "是今年六月的事。啊，"}, {"type": "subtitle", "time": 7586.39, "timestamp": "02:06:26", "text": "我还没去过。"}, {"type": "subtitle", "time": 7588.47, "timestamp": "02:06:28", "text": "哦，是的。Discord现在出了点问题"}, {"type": "subtitle", "time": 7591.589, "timestamp": "02:06:31", "text": "。我还没收到更新"}, {"type": "subtitle", "time": 7594.069, "timestamp": "02:06:34", "text": "。"}, {"type": "subtitle", "time": 7597.83, "timestamp": "02:06:37", "text": "感谢周期很长。"}, {"type": "subtitle", "time": 7605.35, "timestamp": "02:06:45", "text": "呃，我得做一个日程表。"}, {"type": "subtitle", "time": 7607.99, "timestamp": "02:06:47", "text": "日程表页面还没出来。新闻页面，"}, {"type": "subtitle", "time": 7611.35, "timestamp": "02:06:51", "text": "关于页面。我有一个关于页面。"}, {"type": "subtitle", "time": 7613.669, "timestamp": "02:06:53", "text": "我现在得重新做一遍。"}, {"type": "subtitle", "time": 7616.229, "timestamp": "02:06:56", "text": "按剧集来。"}, {"type": "subtitle", "time": 7618.069, "timestamp": "02:06:58", "text": "感觉大多数人都不想"}]
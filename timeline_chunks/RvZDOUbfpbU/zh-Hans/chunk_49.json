[{"type": "subtitle", "time": 2942.069, "timestamp": "00:49:02", "text": "我好想念《我》啊，我需要"}, {"type": "subtitle", "time": 2945.43, "timestamp": "00:49:05", "text": "像《战地》或者《"}, {"type": "subtitle", "time": 2948.71, "timestamp": "00:49:08", "text": "上帝》之类的游戏。[笑] 那种小"}, {"type": "subtitle", "time": 2951.109, "timestamp": "00:49:11", "text": "面积地图，或者说"}, {"type": "subtitle", "time": 2953.51, "timestamp": "00:49:13", "text": "战场，还是长地图比较好。 砰砰砰，"}, {"type": "subtitle", "time": 2986.63, "timestamp": "00:49:46", "text": "天哪，"}, {"type": "subtitle", "time": 2988.95, "timestamp": "00:49:48", "text": "我真庆幸解锁了丁香。 有"}, {"type": "subtitle", "time": 2991.67, "timestamp": "00:49:51", "text": "新代理人吗？ 我觉得最近《"}, {"type": "subtitle", "time": 2994.309, "timestamp": "00:49:54", "text": "Valerant》里新增了一些特工"}, {"type": "subtitle", "time": 2995.829, "timestamp": "00:49:55", "text": "。"}, {"type": "subtitle", "time": 2998.47, "timestamp": "00:49:58", "text": "我必须像"}]
[{"type": "subtitle", "time": 6422.229, "timestamp": "01:47:02", "text": "我玩"}, {"type": "subtitle", "time": 6424.95, "timestamp": "01:47:04", "text": "不下去了。我受不了……你说你"}, {"type": "subtitle", "time": 6429.35, "timestamp": "01:47:09", "text": "买了什么？我买了个护臂。"}, {"type": "subtitle", "time": 6439.51, "timestamp": "01:47:19", "text": "我买了个护臂，为了"}, {"type": "subtitle", "time": 6443.43, "timestamp": "01:47:23", "text": "更好地移动鼠标，因为……这"}, {"type": "subtitle", "time": 6448.629, "timestamp": "01:47:28", "text": "周末……会有更多公开测试版，"}, {"type": "subtitle", "time": 6451.03, "timestamp": "01:47:31", "text": "对吧？我们"}, {"type": "subtitle", "time": 6453.35, "timestamp": "01:47:33", "text": "前天和昨天玩了"}, {"type": "subtitle", "time": 6455.35, "timestamp": "01:47:35", "text": "三天，玩的是抢先"}, {"type": "subtitle", "time": 6457.51, "timestamp": "01:47:37", "text": "体验版，对吧？"}, {"type": "subtitle", "time": 6460.39, "timestamp": "01:47:40", "text": "买了游戏或者"}, {"type": "subtitle", "time": 6464.95, "timestamp": "01:47:44", "text": "拿到兑换码的人，他们"}, {"type": "subtitle", "time": 6467.75, "timestamp": "01:47:47", "text": "现在就可以玩了，游戏已经正式上线，"}, {"type": "subtitle", "time": 6474.31, "timestamp": "01:47:54", "text": "所有人都可以试玩"}, {"type": "subtitle", "time": 6477.35, "timestamp": "01:47:57", "text": "三天。"}, {"type": "subtitle", "time": 6479.99, "timestamp": "01:47:59", "text": "所以我就想，好吧，我得做好准备，看看它到底怎么样"}]
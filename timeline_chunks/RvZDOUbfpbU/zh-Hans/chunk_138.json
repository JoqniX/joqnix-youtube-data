[{"type": "subtitle", "time": 8294.95, "timestamp": "02:18:14", "text": "守望先锋2》。我已经两年没玩了，"}, {"type": "subtitle", "time": 8298.23, "timestamp": "02:18:18", "text": "或者一年？嗯，一年。"}, {"type": "subtitle", "time": 8302.469, "timestamp": "02:18:22", "text": "当然，当然。当然。《守望先锋2》。我很想念它，"}, {"type": "subtitle", "time": 8304.709, "timestamp": "02:18:24", "text": "我记得上次玩是"}, {"type": "subtitle", "time": 8313.669, "timestamp": "02:18:33", "text": "啊，12月24日。是的，从那"}, {"type": "subtitle", "time": 8317.429, "timestamp": "02:18:37", "text": "以后我就没玩过了。"}]
[{"type": "subtitle", "time": 7982.149, "timestamp": "02:13:02", "text": "嗯，让我读一下。抱歉，但我"}, {"type": "subtitle", "time": 7989.27, "timestamp": "02:13:09", "text": "各位，我们知道你们中的许多人一直在"}, {"type": "subtitle", "time": 7991.589, "timestamp": "02:13:11", "text": "等待我们关于"}, {"type": "subtitle", "time": 7993.91, "timestamp": "02:13:13", "text": "上周事件的消息。"}, {"type": "subtitle", "time": 7995.51, "timestamp": "02:13:15", "text": "毫不夸张地说，以"}, {"type": "subtitle", "time": 8001.51, "timestamp": "02:13:21", "text": "这种方式泄露《侠盗猎车手6》的游戏视频"}, {"type": "subtitle", "time": 8004.709, "timestamp": "02:13:24", "text": "对我们的团队来说是令人心碎的，"}, {"type": "subtitle", "time": 8006.87, "timestamp": "02:13:26", "text": "这显然不是我们"}, {"type": "subtitle", "time": 8009.83, "timestamp": "02:13:29", "text": "希望你们在经历了这么长时间之后看到这款游戏的方式"}, {"type": "subtitle", "time": 8011.83, "timestamp": "02:13:31", "text": "。我们对此深感"}, {"type": "subtitle", "time": 8014.47, "timestamp": "02:13:34", "text": "抱歉。一切都花费了这么"}, {"type": "subtitle", "time": 8017.99, "timestamp": "02:13:37", "text": "长时间。为什么会有“直到"}, {"type": "subtitle", "time": 8023.03, "timestamp": "02:13:43", "text": "标记”？这是人工智能吗？但是 从"}, {"type": "subtitle", "time": 8025.75, "timestamp": "02:13:45", "text": "游戏接近完成到"}, {"type": "subtitle", "time": 8027.189, "timestamp": "02:13:47", "text": "分享更多细节和官方"}, {"type": "subtitle", "time": 8028.709, "timestamp": "02:13:48", "text": "游戏玩法，再到为社区提供"}, {"type": "subtitle", "time": 8030.79, "timestamp": "02:13:50", "text": "你们想知道的一切，我们"}, {"type": "subtitle", "time": 8032.709, "timestamp": "02:13:52", "text": "非常激动地期待着大家"}, {"type": "subtitle", "time": 8035.51, "timestamp": "02:13:55", "text": "明天看到加长版预览。它的制作时间"}, {"type": "subtitle", "time": 8038.069, "timestamp": "02:13:58", "text": "比我们预期的要长。"}]
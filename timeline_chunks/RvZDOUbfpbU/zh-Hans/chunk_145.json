[{"type": "subtitle", "time": 8703.99, "timestamp": "02:25:03", "text": "PAL World周的时候，"}, {"type": "subtitle", "time": 8705.75, "timestamp": "02:25:05", "text": "我开始直播，我"}, {"type": "subtitle", "time": 8709.51, "timestamp": "02:25:09", "text": "给自己和几个好朋友买了个服务器"}, {"type": "subtitle", "time": 8711.429, "timestamp": "02:25:11", "text": "。"}, {"type": "subtitle", "time": 8714.389, "timestamp": "02:25:14", "text": "我以最快的速度回到家，"}, {"type": "subtitle", "time": 8717.75, "timestamp": "02:25:17", "text": "然后说："}, {"type": "subtitle", "time": 8721.19, "timestamp": "02:25:21", "text": "“是的，我要直播了。”"}, {"type": "subtitle", "time": 8722.95, "timestamp": "02:25:22", "text": "我要去演奏钢鼓。 我要去打"}, {"type": "subtitle", "time": 8724.469, "timestamp": "02:25:24", "text": "这场"}, {"type": "subtitle", "time": 8726.309, "timestamp": "02:25:26", "text": "boss战了。 我打算这么做。 我要努力奋斗"}, {"type": "subtitle", "time": 8728.79, "timestamp": "02:25:28", "text": "。 找些木头"}, {"type": "subtitle", "time": 8746.15, "timestamp": "02:25:46", "text": "我真希望我能在音乐上投入这么多精力"}]
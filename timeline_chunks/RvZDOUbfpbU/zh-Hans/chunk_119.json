[{"type": "subtitle", "time": 7140.39, "timestamp": "01:59:00", "text": "下午2点到3点吧？"}, {"type": "subtitle", "time": 7144.79, "timestamp": "01:59:04", "text": "对。等等，印度现在几点？"}, {"type": "subtitle", "time": 7148.39, "timestamp": "01:59:08", "text": "嗯，6点半。"}, {"type": "subtitle", "time": 7149.669, "timestamp": "01:59:09", "text": "好的。就是6点半"}, {"type": "subtitle", "time": 7154.39, "timestamp": "01:59:14", "text": "。是6点半。哇。对。"}, {"type": "subtitle", "time": 7157.669, "timestamp": "01:59:17", "text": "我刚想起来。嗯，"}, {"type": "subtitle", "time": 7160.87, "timestamp": "01:59:20", "text": "如果是6点半，那对我来说就是日本晚上10点。3"}, {"type": "subtitle", "time": 7182.95, "timestamp": "01:59:42", "text": "但我现在满脑子想的都是《"}, {"type": "subtitle", "time": 7190.07, "timestamp": "01:59:50", "text": "但问题是我会错过一天"}, {"type": "subtitle", "time": 7195.75, "timestamp": "01:59:55", "text": "。呃，等等。呃，《使命召唤：现代战争4》的测试版什么时候"}]
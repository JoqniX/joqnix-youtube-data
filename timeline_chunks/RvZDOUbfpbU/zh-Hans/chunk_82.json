[{"type": "subtitle", "time": 4949.03, "timestamp": "01:22:29", "text": "快跑，快跑，快跑。 哦，该死。"}, {"type": "subtitle", "time": 4957.11, "timestamp": "01:22:37", "text": "是的，当你玩过像"}, {"type": "subtitle", "time": 4961.51, "timestamp": "01:22:41", "text": "《战地》或《使命召唤》之类的游戏后，突然"}, {"type": "subtitle", "time": 4963.91, "timestamp": "01:22:43", "text": "换到像这样节奏较慢的射击游戏时"}, {"type": "subtitle", "time": 4969.83, "timestamp": "01:22:49", "text": "，你很难快速适应。"}, {"type": "subtitle", "time": 4972.31, "timestamp": "01:22:52", "text": "你会想，“我该怎么跑？我该怎么"}]
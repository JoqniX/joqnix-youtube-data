[{"type": "subtitle", "time": 8642.63, "timestamp": "02:24:02", "text": "游戏、刷刷刷，或者随时随地玩游戏享受乐趣吗？"}, {"type": "subtitle", "time": 8648.23, "timestamp": "02:24:08", "text": "如果是我，过去"}, {"type": "subtitle", "time": 8651.83, "timestamp": "02:24:11", "text": "三天我完全"}, {"type": "subtitle", "time": 8653.75, "timestamp": "02:24:13", "text": "沉迷其中，甚至"}, {"type": "subtitle", "time": 8657.59, "timestamp": "02:24:17", "text": "翘班了，这很糟糕，非常"}, {"type": "subtitle", "time": 8659.91, "timestamp": "02:24:19", "text": "糟糕。是的，我"}, {"type": "subtitle", "time": 8662.63, "timestamp": "02:24:22", "text": "今天也翘班了，我"}, {"type": "subtitle", "time": 8667.429, "timestamp": "02:24:27", "text": "会为此付出代价，我"}, {"type": "subtitle", "time": 8670.23, "timestamp": "02:24:30", "text": "必须好好履行我的"}, {"type": "subtitle", "time": 8672.79, "timestamp": "02:24:32", "text": "职责。是的。"}, {"type": "subtitle", "time": 8677.03, "timestamp": "02:24:37", "text": "现在每当遇到这类游戏，我就会"}, {"type": "subtitle", "time": 8679.59, "timestamp": "02:24:39", "text": "逃避现实，沉迷其中，就像"}, {"type": "subtitle", "time": 8684.07, "timestamp": "02:24:44", "text": "掉进"}, {"type": "subtitle", "time": 8686.71, "timestamp": "02:24:46", "text": "兔子洞一样。"}, {"type": "subtitle", "time": 8688.95, "timestamp": "02:24:48", "text": "我会想，放学回家就上线"}, {"type": "subtitle", "time": 8692.309, "timestamp": "02:24:52", "text": "玩《使命召唤》之类的游戏"}, {"type": "subtitle", "time": 8696.15, "timestamp": "02:24:56", "text": "。嗯，之前"}]
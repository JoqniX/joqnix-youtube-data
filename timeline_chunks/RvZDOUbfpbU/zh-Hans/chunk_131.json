[{"type": "subtitle", "time": 7860.31, "timestamp": "02:11:00", "text": "开始也很粗糙，对吧？"}, {"type": "subtitle", "time": 7863.75, "timestamp": "02:11:03", "text": "然后随着时间的推移，我不断改进。没错。"}, {"type": "subtitle", "time": 7866.069, "timestamp": "02:11:06", "text": "就是这样。"}, {"type": "subtitle", "time": 7868.069, "timestamp": "02:11:08", "text": "嗯，我带来的这种新概念"}, {"type": "subtitle", "time": 7871.589, "timestamp": "02:11:11", "text": "或者说新的直播类型"}, {"type": "subtitle", "time": 7874.79, "timestamp": "02:11:14", "text": "也会随着"}, {"type": "subtitle", "time": 7877.189, "timestamp": "02:11:17", "text": "时间的推移而不断改进。"}, {"type": "subtitle", "time": 7879.589, "timestamp": "02:11:19", "text": "嗯，"}, {"type": "subtitle", "time": 7881.99, "timestamp": "02:11:21", "text": "所以，是的，但我不知道我能不能"}, {"type": "subtitle", "time": 7886.55, "timestamp": "02:11:26", "text": "在YouTube上直播，因为版权问题。"}, {"type": "subtitle", "time": 7888.95, "timestamp": "02:11:28", "text": "是的。所以会在Twitch和"}, {"type": "subtitle", "time": 7890.79, "timestamp": "02:11:30", "text": "Kick上直播。"}, {"type": "subtitle", "time": 7893.109, "timestamp": "02:11:33", "text": "我觉得我可以在YouTube上直播，但是你们"}, {"type": "subtitle", "time": 7896.229, "timestamp": "02:11:36", "text": "听不到声音。"}, {"type": "subtitle", "time": 7899.51, "timestamp": "02:11:39", "text": "或者我可以把"}, {"type": "subtitle", "time": 7902.39, "timestamp": "02:11:42", "text": "直播存档。"}, {"type": "subtitle", "time": 7904.629, "timestamp": "02:11:44", "text": "但是你们在Billy Billy频道上是听不到的"}, {"type": "subtitle", "time": 7907.43, "timestamp": "02:11:47", "text": "。这也是为什么我还有"}, {"type": "subtitle", "time": 7912.87, "timestamp": "02:11:52", "text": "其他选择的原因。如果是"}, {"type": "subtitle", "time": 7914.31, "timestamp": "02:11:54", "text": "这样的话，这就是为什么我"}, {"type": "subtitle", "time": 7917.83, "timestamp": "02:11:57", "text": "在Billy Billy上有一个单独的频道。"}]
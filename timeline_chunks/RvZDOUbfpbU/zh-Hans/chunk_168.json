[{"type": "subtitle", "time": 10081.59, "timestamp": "02:48:01", "text": "我需要我的砰砰声"}, {"type": "subtitle", "time": 10083.83, "timestamp": "02:48:03", "text": "。 我的天，这里有个计时器。   我勒个去"}, {"type": "subtitle", "time": 10108.309, "timestamp": "02:48:28", "text": "我情绪低落。 我情绪低落。 我情绪低落。"}, {"type": "subtitle", "time": 10110.15, "timestamp": "02:48:30", "text": "等待。 我该如何疗伤？ 我该如何疗伤？"}, {"type": "subtitle", "time": 10113.429, "timestamp": "02:48:33", "text": "我该如何疗伤？ 我该如何疗伤？ 拉屎。 呃，"}, {"type": "subtitle", "time": 10132.389, "timestamp": "02:48:52", "text": "治愈了我。 治愈我。 治愈我。 治愈我。 治愈"}]
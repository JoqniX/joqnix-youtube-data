[{"type": "subtitle", "time": 8583.03, "timestamp": "02:23:03", "text": "新游戏出来，尤其是FPS射击"}, {"type": "subtitle", "time": 8585.349, "timestamp": "02:23:05", "text": "游戏，然后搞个免费周末之类的活动，就像以前《"}, {"type": "subtitle", "time": 8603.03, "timestamp": "02:23:23", "text": "黑色行动6》和《现代战争》的免费周末，有三天。然后呢？《黑色行动6》和《黑色行动7》，还有"}, {"type": "subtitle", "time": 8606.63, "timestamp": "02:23:26", "text": "很多《现代战争》和《使命召唤》的免费周末，"}, {"type": "subtitle", "time": 8610.63, "timestamp": "02:23:30", "text": "还有《战地》也是一样。"}, {"type": "subtitle", "time": 8613.994, "timestamp": "02:23:33", "text": "我觉得每次这两款游戏"}, {"type": "subtitle", "time": 8614.55, "timestamp": "02:23:34", "text": "[笑]搞"}, {"type": "subtitle", "time": 8617.27, "timestamp": "02:23:37", "text": "免费周末的时候，我都会想，对"}, {"type": "subtitle", "time": 8620.55, "timestamp": "02:23:40", "text": "啊，我得玩玩。挺好玩的。我"}, {"type": "subtitle", "time": 8624.71, "timestamp": "02:23:44", "text": "喜欢那种免费周末。然后我内心"}, {"type": "subtitle", "time": 8628.79, "timestamp": "02:23:48", "text": "深处又会想，我到底要不要玩"}, {"type": "subtitle", "time": 8634.23, "timestamp": "02:23:54", "text": "？要不要玩？ 我觉得我也会这么做"}, {"type": "subtitle", "time": 8639.19, "timestamp": "02:23:59", "text": "？我有时间玩"}]
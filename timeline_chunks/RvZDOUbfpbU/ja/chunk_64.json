[{"type": "subtitle", "time": 3843.109, "timestamp": "01:04:03", "text": "去年観て面白かったから。 その番組は当時、"}, {"type": "subtitle", "time": 3846.47, "timestamp": "01:04:06", "text": "ベータ版をかなり長く放送していた"}, {"type": "subtitle", "time": 3856.47, "timestamp": "01:04:16", "text": "Delta Forceだけが、バトルフィールドモア"}, {"type": "subtitle", "time": 3867.589, "timestamp": "01:04:27", "text": "Delta Forestには、"}, {"type": "subtitle", "time": 3870.549, "timestamp": "01:04:30", "text": "フィールライクモードはありますか？ それは何と呼ばれていますか？ あの"}, {"type": "subtitle", "time": 3884.549, "timestamp": "01:04:44", "text": "ああ、確かに戦争ボードはありますよ。"}]
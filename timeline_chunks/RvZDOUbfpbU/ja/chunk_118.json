[{"type": "subtitle", "time": 7081.83, "timestamp": "01:58:01", "text": "「あぁ、まずいな」って思うんだ"}, {"type": "subtitle", "time": 7085.03, "timestamp": "01:58:05", "text": "。"}, {"type": "subtitle", "time": 7091.35, "timestamp": "01:58:11", "text": "配信中はちゃんと物を見ることもできないんです。」"}, {"type": "subtitle", "time": 7103.189, "timestamp": "01:58:23", "text": "混乱していて、それに"}, {"type": "subtitle", "time": 7108.229, "timestamp": "01:58:28", "text": "今の配信時間も、"}, {"type": "subtitle", "time": 7111.43, "timestamp": "01:58:31", "text": "配信時間を調整しないといけないんです。えっと、"}, {"type": "subtitle", "time": 7117.27, "timestamp": "01:58:37", "text": "番組は夕方しか配信できないんです。えっと、それで、"}, {"type": "subtitle", "time": 7120.79, "timestamp": "01:58:40", "text": "何時だろう？"}, {"type": "subtitle", "time": 7123.43, "timestamp": "01:58:43", "text": "早く寝なきゃいけないし。だから、"}, {"type": "subtitle", "time": 7127.43, "timestamp": "01:58:47", "text": "以前の配信時間に戻そうと思ってるんです。えっと、"}, {"type": "subtitle", "time": 7131.669, "timestamp": "01:58:51", "text": "それは午後6時か午後5時（日本時間）です。"}, {"type": "subtitle", "time": 7134.07, "timestamp": "01:58:54", "text": "インド標準時だと、"}]
[{"type": "subtitle", "time": 8959.429, "timestamp": "02:29:19", "text": "ああ、"}, {"type": "subtitle", "time": 8962.63, "timestamp": "02:29:22", "text": "ゲームの仕組みが分かりました。   わかった"}, {"type": "subtitle", "time": 8964.79, "timestamp": "02:29:24", "text": "。"}, {"type": "subtitle", "time": 8967.03, "timestamp": "02:29:27", "text": "期待していることがあるんです。 わかった。   しばらく様子を見てみましょう"}, {"type": "subtitle", "time": 8979.27, "timestamp": "02:29:39", "text": "私のマウスを押してください。 わかった。 チュートリアル。"}, {"type": "subtitle", "time": 8986.71, "timestamp": "02:29:46", "text": "何？ 世界中に存在するゲーム特殊部隊"}, {"type": "subtitle", "time": 8988.87, "timestamp": "02:29:48", "text": "。 オペレーターは70名、"}, {"type": "subtitle", "time": 8990.79, "timestamp": "02:29:50", "text": "ゲーマーの種類も豊富で、一人称視点と三人称"}, {"type": "subtitle", "time": 8992.63, "timestamp": "02:29:52", "text": "視点の両方に対応しています。 何でも話していいよ。"}, {"type": "subtitle", "time": 8997.75, "timestamp": "02:29:57", "text": "プロのチュートリアルを受けるためのトレーニングミッション。"}]
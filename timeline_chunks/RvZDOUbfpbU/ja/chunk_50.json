[{"type": "subtitle", "time": 3001.109, "timestamp": "00:50:01", "text": "この人やこの人のように、彼らのロックを解除しなければならない。 この男、"}, {"type": "subtitle", "time": 3003.51, "timestamp": "00:50:03", "text": "この男。"}, {"type": "subtitle", "time": 3012.47, "timestamp": "00:50:12", "text": "さて、皆さん、今日はどんな一日でしたか？"}, {"type": "subtitle", "time": 3015.27, "timestamp": "00:50:15", "text": "皆さんお元気でお過ごしでしょうか。"}, {"type": "subtitle", "time": 3033.829, "timestamp": "00:50:33", "text": "正直言って [笑い] 正直言って、"}, {"type": "subtitle", "time": 3042.87, "timestamp": "00:50:42", "text": "天気は私の"}, {"type": "subtitle", "time": 3044.63, "timestamp": "00:50:44", "text": "ものには遅すぎると思います。"}, {"type": "subtitle", "time": 3047.43, "timestamp": "00:50:47", "text": "私は「えっと、"}, {"type": "subtitle", "time": 3052.71, "timestamp": "00:50:52", "text": "ピッケルを配信するべきか、ヴァレンタインを配信するべきか、"}, {"type": "subtitle", "time": 3054.87, "timestamp": "00:50:54", "text": "フォートナイトを配信するべきか」と混乱していて、「"}, {"type": "subtitle", "time": 3057.589, "timestamp": "00:50:57", "text": "よし、ヴァレンタインにしよう」と思いました"}, {"type": "subtitle", "time": 3059.91, "timestamp": "00:50:59", "text": "。"}]
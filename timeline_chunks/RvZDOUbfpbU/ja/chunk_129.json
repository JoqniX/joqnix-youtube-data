[{"type": "subtitle", "time": 7742.629, "timestamp": "02:09:02", "text": "すべてCloudfireに移行しました"}, {"type": "subtitle", "time": 7744.87, "timestamp": "02:09:04", "text": "が、唯一そこにないのは"}, {"type": "subtitle", "time": 7746.709, "timestamp": "02:09:06", "text": "ストリームチャットです。"}, {"type": "subtitle", "time": 7750.39, "timestamp": "02:09:10", "text": "私はDiscordで全員のチャットをログに記録しています。"}, {"type": "subtitle", "time": 7753.189, "timestamp": "02:09:13", "text": "モデレーション"}, {"type": "subtitle", "time": 7756.39, "timestamp": "02:09:16", "text": "目的などですが、"}, {"type": "subtitle", "time": 7768.55, "timestamp": "02:09:28", "text": "ロードされません。すごい。でも待って、"}, {"type": "subtitle", "time": 7771.03, "timestamp": "02:09:31", "text": "おそらく"}, {"type": "subtitle", "time": 7774.31, "timestamp": "02:09:34", "text": "Vispoが取得しているはずです"}, {"type": "subtitle", "time": 7776.709, "timestamp": "02:09:36", "text": "。Vispoが追跡しているはずです。はい、Vispoが"}, {"type": "subtitle", "time": 7778.79, "timestamp": "02:09:38", "text": "中継しています。はい、Vispo [音楽]"}, {"type": "subtitle", "time": 7782.87, "timestamp": "02:09:42", "text": "Vispoは文字通り、"}, {"type": "subtitle", "time": 7785.589, "timestamp": "02:09:45", "text": "画面に表示されるチャット、チャットボックスです"}, {"type": "subtitle", "time": 7790.79, "timestamp": "02:09:50", "text": "。これはカスタムサービスによって実行されています。"}, {"type": "subtitle", "time": 7799.91, "timestamp": "02:09:59", "text": "私はWebフックのために5ドル支払いました"}]
[{"type": "subtitle", "time": 6789.189, "timestamp": "01:53:09", "text": "ああ、人類よ。"}, {"type": "subtitle", "time": 6792.55, "timestamp": "01:53:12", "text": "ああ、急ぎ足。分かってる。急ぎ足。走る。走る。"}, {"type": "subtitle", "time": 6795.109, "timestamp": "01:53:15", "text": "ランニングゲーム。うん。だから"}, {"type": "subtitle", "time": 6828.87, "timestamp": "01:53:48", "text": "シミュレーションゲームといえば、"}, {"type": "subtitle", "time": 6832.87, "timestamp": "01:53:52", "text": "今そのゲームを持っている。スケジュールワン。"}, {"type": "subtitle", "time": 6836.55, "timestamp": "01:53:56", "text": "しばらくプレイしていない"}]
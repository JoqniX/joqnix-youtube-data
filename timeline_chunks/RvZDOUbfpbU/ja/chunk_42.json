[{"type": "subtitle", "time": 2533.27, "timestamp": "00:42:13", "text": "左のおもちゃ、左、左クリック。"}, {"type": "subtitle", "time": 2535.67, "timestamp": "00:42:15", "text": "左、左、左、左。   よし"}, {"type": "subtitle", "time": 2539.27, "timestamp": "00:42:19", "text": "。 盲目的な任務。"}, {"type": "subtitle", "time": 2545.91, "timestamp": "00:42:25", "text": "ファイア。 本当に？"}, {"type": "subtitle", "time": 2564.79, "timestamp": "00:42:44", "text": "側。   わかった"}, {"type": "subtitle", "time": 2566.309, "timestamp": "00:42:46", "text": "。"}, {"type": "subtitle", "time": 2569.03, "timestamp": "00:42:49", "text": "ああ、左だ。"}, {"type": "subtitle", "time": 2574.63, "timestamp": "00:42:54", "text": "ああ、神様。 雷。 ああ。 左上。 ああ。"}, {"type": "subtitle", "time": 2576.47, "timestamp": "00:42:56", "text": "再装填中。"}, {"type": "subtitle", "time": 2577.51, "timestamp": "00:42:57", "text": "究極のオーブ。"}]
[{"type": "subtitle", "time": 6422.229, "timestamp": "01:47:02", "text": "苦戦してる。"}, {"type": "subtitle", "time": 6424.95, "timestamp": "01:47:04", "text": "対処できない。えーと、何を"}, {"type": "subtitle", "time": 6429.35, "timestamp": "01:47:09", "text": "買ったって言った？アームスリーブを買ったんだ。"}, {"type": "subtitle", "time": 6443.43, "timestamp": "01:47:23", "text": "マウスをもっとうまく動かすためにアームスリーブを買ったんだ。だって、えーと、今"}, {"type": "subtitle", "time": 6448.629, "timestamp": "01:47:28", "text": "週末はもっとオープンベータが来るんだよね"}, {"type": "subtitle", "time": 6451.03, "timestamp": "01:47:31", "text": "？一昨日プレイしたんだけど、"}, {"type": "subtitle", "time": 6453.35, "timestamp": "01:47:33", "text": "えっと、昨日"}, {"type": "subtitle", "time": 6455.35, "timestamp": "01:47:35", "text": "と3日間、早期"}, {"type": "subtitle", "time": 6457.51, "timestamp": "01:47:37", "text": "アクセスベータ版をプレイしましたよね？"}, {"type": "subtitle", "time": 6460.39, "timestamp": "01:47:40", "text": "ゲームを買った人、もしくは引き換えコードを手に入れた人だけが"}, {"type": "subtitle", "time": 6467.75, "timestamp": "01:47:47", "text": "早期アクセスコードを使ってプレイできるんです。それが"}, {"type": "subtitle", "time": 6470.79, "timestamp": "01:47:50", "text": "今、"}, {"type": "subtitle", "time": 6474.31, "timestamp": "01:47:54", "text": "一般公開されて、誰でも"}, {"type": "subtitle", "time": 6477.35, "timestamp": "01:47:57", "text": "3日間プレイして試せるようになったんです。それで、えっと、"}, {"type": "subtitle", "time": 6479.99, "timestamp": "01:47:59", "text": "準備しておこうと思って、それが"}]
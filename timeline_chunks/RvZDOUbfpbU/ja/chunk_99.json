[{"type": "subtitle", "time": 5944.149, "timestamp": "01:39:04", "text": "。ええ、今は安定しているはずだ"}, {"type": "subtitle", "time": 5952.79, "timestamp": "01:39:12", "text": "えっと、もう1ゲームプレイした方がいいかな？ごめん"}, {"type": "subtitle", "time": 5954.79, "timestamp": "01:39:14", "text": "。"}, {"type": "subtitle", "time": 5959.99, "timestamp": "01:39:19", "text": "このゲームに飽きたってことは、もうお分かりだと思うよ。"}, {"type": "subtitle", "time": 5963.27, "timestamp": "01:39:23", "text": "ああ、残念。"}, {"type": "subtitle", "time": 5965.51, "timestamp": "01:39:25", "text": "ラグとか色々あって、つまらないんだ。"}, {"type": "subtitle", "time": 5969.27, "timestamp": "01:39:29", "text": "いや。うわぁ。"}, {"type": "subtitle", "time": 5970.87, "timestamp": "01:39:30", "text": "じゃあ、行かなきゃ。 また"}]
[{"type": "subtitle", "time": 6146.149, "timestamp": "01:42:26", "text": "ベッドの後ろで台無しにした。"}, {"type": "subtitle", "time": 6148.55, "timestamp": "01:42:28", "text": "私は外にいた。"}, {"type": "subtitle", "time": 6161.51, "timestamp": "01:42:41", "text": "なんてこった。"}, {"type": "subtitle", "time": 6164.629, "timestamp": "01:42:44", "text": "夕食を追加しましたか？いいえ。"}]
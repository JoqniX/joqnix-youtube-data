[{"type": "subtitle", "time": 2945.43, "timestamp": "00:49:05", "text": "バトルフィールドとか"}, {"type": "subtitle", "time": 2948.71, "timestamp": "00:49:08", "text": "ゴッドとかそういうのが恋しいよ。[笑] そういう小さな"}, {"type": "subtitle", "time": 2951.109, "timestamp": "00:49:11", "text": "エリアのマップや、ピューピューピューピューと撃ち合うような"}, {"type": "subtitle", "time": 2953.51, "timestamp": "00:49:13", "text": "戦場は、長いマップの方が良い。 ピューピューピュー、"}, {"type": "subtitle", "time": 2986.63, "timestamp": "00:49:46", "text": "ああ、"}, {"type": "subtitle", "time": 2988.95, "timestamp": "00:49:48", "text": "クローブをアンロックできてよかった。"}, {"type": "subtitle", "time": 2991.67, "timestamp": "00:49:51", "text": "新しいエージェントはいますか？ 最近、ヴァレラントに新しいエージェントが何人か現れたと思う"}, {"type": "subtitle", "time": 2995.829, "timestamp": "00:49:55", "text": "。"}]
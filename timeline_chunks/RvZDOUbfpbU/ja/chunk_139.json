[{"type": "subtitle", "time": 8355.83, "timestamp": "02:19:15", "text": "ゲームズコムのイベントを見た？みんなは見た？みんなは気にしないけど。"}, {"type": "subtitle", "time": 8358.629, "timestamp": "02:19:18", "text": "少し見た。"}, {"type": "subtitle", "time": 8360.95, "timestamp": "02:19:20", "text": "それで、リリースされる新しいゲームを見た"}, {"type": "subtitle", "time": 8363.669, "timestamp": "02:19:23", "text": "。"}, {"type": "subtitle", "time": 8365.589, "timestamp": "02:19:25", "text": "特に、エルダーリングにそっくりなホヤウォーズが紹介されていて、すごく興奮した。"}, {"type": "subtitle", "time": 8385.11, "timestamp": "02:19:45", "text": "でも、"}, {"type": "subtitle", "time": 8387.349, "timestamp": "02:19:47", "text": "猫みたいな感じで、"}, {"type": "subtitle", "time": 8393.59, "timestamp": "02:19:53", "text": "えっと、"}]
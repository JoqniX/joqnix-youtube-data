[{"type": "subtitle", "time": 9005.67, "timestamp": "02:30:05", "text": "バルク・メディック・シールド・スカウト。"}, {"type": "subtitle", "time": 9008.55, "timestamp": "02:30:08", "text": "この男、気になるな。"}, {"type": "subtitle", "time": 9013.51, "timestamp": "02:30:13", "text": "ああ、神様。  AK40"}, {"type": "subtitle", "time": 9016.309, "timestamp": "02:30:16", "text": "AK-47 銃をくれるなら"}, {"type": "subtitle", "time": 9026.309, "timestamp": "02:30:26", "text": "、これは実際に気に入るかもしれない。"}, {"type": "subtitle", "time": 9031.03, "timestamp": "02:30:31", "text": "ゲーム。 もしかしたら、このゲームは気に入るかもしれない。   もしかしたら、"}, {"type": "subtitle", "time": 9034.55, "timestamp": "02:30:34", "text": "このゲームは好きになるかもしれない（笑）"}, {"type": "subtitle", "time": 9036.309, "timestamp": "02:30:36", "text": "。   ああ、なんてことだ"}, {"type": "subtitle", "time": 9046.309, "timestamp": "02:30:46", "text": "このゲームは気に入るかもしれない。   私はかもしれない。 私はかもしれない。"}, {"type": "subtitle", "time": 9055.19, "timestamp": "02:30:55", "text": "えっと、読み込み中です。  ３、２、１。"}, {"type": "subtitle", "time": 9056.79, "timestamp": "02:30:56", "text": "テロリストたちが"}, {"type": "subtitle", "time": 9058.95, "timestamp": "02:30:58", "text": "病院を占拠し、人質を取っている。"}]
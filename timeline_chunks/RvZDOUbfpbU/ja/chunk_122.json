[{"type": "subtitle", "time": 7320.47, "timestamp": "02:02:00", "text": "例えば、"}, {"type": "subtitle", "time": 7322.629, "timestamp": "02:02:02", "text": "えーと、ウェブサイトとか。"}, {"type": "subtitle", "time": 7327.109, "timestamp": "02:02:07", "text": "新しい仕事モデルに合わせて更新しなきゃいけない。"}, {"type": "subtitle", "time": 7330.229, "timestamp": "02:02:10", "text": "うん。それから、バックエンドの仕事もたくさんある。それも"}, {"type": "subtitle", "time": 7333.27, "timestamp": "02:02:13", "text": "ある。いや。他に何かあるかな"}, {"type": "subtitle", "time": 7339.189, "timestamp": "02:02:19", "text": "音楽関係。うん、音楽"}, {"type": "subtitle", "time": 7341.43, "timestamp": "02:02:21", "text": "関係もやらなきゃいけない。音楽関係をやろうと言い続けてるんだけど、結局やらないんだ。本当に"}, {"type": "subtitle", "time": 7347.589, "timestamp": "02:02:27", "text": "面倒くさい。"}, {"type": "subtitle", "time": 7349.99, "timestamp": "02:02:29", "text": "あと、Wikipediaも更新しなきゃいけない。いや、"}, {"type": "subtitle", "time": 7353.43, "timestamp": "02:02:33", "text": "Wikipediaじゃない。えーと、Pandm wiki。"}, {"type": "subtitle", "time": 7355.669, "timestamp": "02:02:35", "text": "ニューヨークの情報が載ってないんだ"}, {"type": "subtitle", "time": 7356.95, "timestamp": "02:02:36", "text": "。"}, {"type": "subtitle", "time": 7363.43, "timestamp": "02:02:43", "text": "プロフィール写真を更新しただけ。"}, {"type": "subtitle", "time": 7370.07, "timestamp": "02:02:50", "text": "私のことをよく知ってる人が更新してくれたらいいんだけど。"}, {"type": "subtitle", "time": 7372.55, "timestamp": "02:02:52", "text": "将来的にはそうするつもりだけど、今は"}]
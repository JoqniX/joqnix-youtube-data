[{"type": "subtitle", "time": 9184.23, "timestamp": "02:33:04", "text": "ドアを確認してください。 私たちがあなたを守ります。"}, {"type": "subtitle", "time": 9186.71, "timestamp": "02:33:06", "text": "また、また、また、私がやらなければならないことの1つは、"}, {"type": "subtitle", "time": 9189.75, "timestamp": "02:33:09", "text": "ビデオの"}, {"type": "subtitle", "time": 9220.79, "timestamp": "02:33:40", "text": "よし、門を開けろ。   私は"}, {"type": "subtitle", "time": 9236.63, "timestamp": "02:33:56", "text": "。"}, {"type": "subtitle", "time": 9239.99, "timestamp": "02:33:59", "text": "賢くやらなければならない。"}]
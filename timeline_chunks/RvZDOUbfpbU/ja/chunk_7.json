[{"type": "subtitle", "time": 424.87, "timestamp": "00:07:04", "text": "場面転換して、準備を整えてみましょう"}, {"type": "subtitle", "time": 428.71, "timestamp": "00:07:08", "text": "。"}, {"type": "subtitle", "time": 432.309, "timestamp": "00:07:12", "text": "ゲームはどこにあるの？ これを撮っておこう。   はい"}, {"type": "subtitle", "time": 434.95, "timestamp": "00:07:14", "text": "、どうぞ。"}, {"type": "subtitle", "time": 437.189, "timestamp": "00:07:17", "text": "あ、待って。 ヴァレリンは捕まってしまうのか？"}, {"type": "subtitle", "time": 440.07, "timestamp": "00:07:20", "text": "ええ、確かに捉えられますよ。"}, {"type": "subtitle", "time": 451.589, "timestamp": "00:07:31", "text": "雷雨が起きていて、雨も降っています"}, {"type": "subtitle", "time": 455.43, "timestamp": "00:07:35", "text": "。"}, {"type": "subtitle", "time": 457.99, "timestamp": "00:07:37", "text": "今日はインターネットの接続が少し不安定になります。"}, {"type": "subtitle", "time": 459.909, "timestamp": "00:07:39", "text": "そのため、遅延などが発生する可能性があります。   わかった"}, {"type": "subtitle", "time": 463.029, "timestamp": "00:07:43", "text": "。 待って。"}, {"type": "subtitle", "time": 464.79, "timestamp": "00:07:44", "text": "えっと、ここで"}, {"type": "subtitle", "time": 467.11, "timestamp": "00:07:47", "text": "何かしないといけないんです"}, {"type": "subtitle", "time": 475.83, "timestamp": "00:07:55", "text": "私はあらゆるソーシャルメディアから締め出されてしまいました。"}, {"type": "subtitle", "time": 478.629, "timestamp": "00:07:58", "text": "なぜそうし"}]
[{"type": "subtitle", "time": 7441.53, "timestamp": "02:04:01", "text": "待って。うん、このジョックを更新しないといけないんだ。"}, {"type": "subtitle", "time": 7442.39, "timestamp": "02:04:02", "text": "[笑い]"}, {"type": "subtitle", "time": 7444.709, "timestamp": "02:04:04", "text": "これはうまくいかない。それに、"}, {"type": "subtitle", "time": 7447.669, "timestamp": "02:04:07", "text": "ワードはどうなったんだ？"}, {"type": "subtitle", "time": 7450.149, "timestamp": "02:04:10", "text": "ワード・エンバー・プレイヤー。なぜ"}, {"type": "subtitle", "time": 7457.669, "timestamp": "02:04:17", "text": "うん、"}, {"type": "subtitle", "time": 7461.03, "timestamp": "02:04:21", "text": "毎週土曜日の深夜に90WSを再生しないんだ。"}, {"type": "subtitle", "time": 7463.91, "timestamp": "02:04:23", "text": "それを直さなきゃ。"}, {"type": "subtitle", "time": 7471.03, "timestamp": "02:04:31", "text": "サミーやストリーマーBみたいにバックエンドを運営してないから、"}, {"type": "subtitle", "time": 7476.229, "timestamp": "02:04:36", "text": "クラウドフェアみたいなクラウドに全部切り替えようとしてるんだ。"}, {"type": "subtitle", "time": 7480.39, "timestamp": "02:04:40", "text": "そうすると、"}, {"type": "subtitle", "time": 7483.27, "timestamp": "02:04:43", "text": "去年はそんなこと気にしてなかった"}, {"type": "subtitle", "time": 7488.149, "timestamp": "02:04:48", "text": "。"}, {"type": "subtitle", "time": 7491.27, "timestamp": "02:04:51", "text": "去年は、"}, {"type": "subtitle", "time": 7495.669, "timestamp": "02:04:55", "text": "インドの人たちが"}, {"type": "subtitle", "time": 7499.43, "timestamp": "02:04:59", "text": "UPI決済を使って支配するやり方とか、そういうのがあって、"}]
[{"type": "subtitle", "time": 6323.43, "timestamp": "01:45:23", "text": "こんにちは。えーと、"}, {"type": "subtitle", "time": 6325.27, "timestamp": "01:45:25", "text": "残り30秒。"}, {"type": "subtitle", "time": 6328.149, "timestamp": "01:45:28", "text": "ああ、今日はヴァラーか。うん、もう終わりにしよう"}, {"type": "subtitle", "time": 6353.03, "timestamp": "01:45:53", "text": "くそ。今日はどう？調子いいよ"}, {"type": "subtitle", "time": 6357.109, "timestamp": "01:45:57", "text": "。今日はeスポーツのアームスリーブを買ったんだ。エイム練習して、"}]
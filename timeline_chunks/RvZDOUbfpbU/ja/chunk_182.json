[{"type": "subtitle", "time": 10933.99, "timestamp": "03:02:13", "text": "[咳払い]"}, {"type": "subtitle", "time": 10938.95, "timestamp": "03:02:18", "text": "今日はありがとう。"}, {"type": "subtitle", "time": 10941.349, "timestamp": "03:02:21", "text": "本日はこれで終わりにします。 それでは、また明日。   皆さんに最新情報をお伝えします"}, {"type": "subtitle", "time": 10944.07, "timestamp": "03:02:24", "text": "。"}, {"type": "subtitle", "time": 10948.15, "timestamp": "03:02:28", "text": "通知をこまめにチェックして、ぜひ立ち寄って挨拶してください"}, {"type": "subtitle", "time": 10951.03, "timestamp": "03:02:31", "text": "。 それは"}, {"type": "subtitle", "time": 10959.19, "timestamp": "03:02:39", "text": "それでは、さようなら、良い一日を。"}]
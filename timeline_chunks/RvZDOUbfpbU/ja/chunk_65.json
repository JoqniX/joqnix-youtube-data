[{"type": "subtitle", "time": 3902.39, "timestamp": "01:05:02", "text": "我々は"}, {"type": "subtitle", "time": 3904.39, "timestamp": "01:05:04", "text": "デルタフォース以上の規模の破壊を行うだろう。"}, {"type": "subtitle", "time": 3916.39, "timestamp": "01:05:16", "text": "再撮影って何ですか？ これが何なのか見てみたい"}, {"type": "subtitle", "time": 3925.51, "timestamp": "01:05:25", "text": "デルタフォースゲームモード。"}, {"type": "subtitle", "time": 3927.589, "timestamp": "01:05:27", "text": "待って、私、デルタフォースをストリーミング配信したよね"}, {"type": "subtitle", "time": 3929.75, "timestamp": "01:05:29", "text": "？"}, {"type": "subtitle", "time": 3933.43, "timestamp": "01:05:33", "text": "ああ、そうだよ。 しかし、それはいつのことだろうか？"}, {"type": "subtitle", "time": 3937.99, "timestamp": "01:05:37", "text": "おそらくゾカトンか何かの時だろう。"}, {"type": "subtitle", "time": 3942.47, "timestamp": "01:05:42", "text": "だから、一度だけ。 ええ、"}, {"type": "subtitle", "time": 3945.829, "timestamp": "01:05:45", "text": "軍用犬の動画を作っている人をたくさん見かけます"}, {"type": "subtitle", "time": 3947.91, "timestamp": "01:05:47", "text": "。"}]
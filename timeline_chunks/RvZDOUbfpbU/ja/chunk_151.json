[{"type": "subtitle", "time": 9060.389, "timestamp": "02:31:00", "text": "我々は当該地域を封鎖したが、"}, {"type": "subtitle", "time": 9063.51, "timestamp": "02:31:03", "text": "人質が危険にさらされている状況では攻撃を開始できない。 皆様のご"}, {"type": "subtitle", "time": 9065.75, "timestamp": "02:31:05", "text": "協力が必要です。 彼らは"}, {"type": "subtitle", "time": 9068.87, "timestamp": "02:31:08", "text": "90人か80人のオペレーターがいると言っていたが、"}, {"type": "subtitle", "time": 9074.71, "timestamp": "02:31:14", "text": "私たちが見たのは4クラスだけだった。 多分。"}, {"type": "subtitle", "time": 9076.469, "timestamp": "02:31:16", "text": "はぁ？"}, {"type": "subtitle", "time": 9079.429, "timestamp": "02:31:19", "text": "しかし、オペレーターたちは一体どうしたのでしょうか？ 何てことだ"}, {"type": "subtitle", "time": 9085.67, "timestamp": "02:31:25", "text": "くそ。"}, {"type": "subtitle", "time": 9117.67, "timestamp": "02:31:57", "text": "ねえ、これってレインボーシックス"}]
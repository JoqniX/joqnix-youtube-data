[{"type": "subtitle", "time": 4500.63, "timestamp": "01:15:00", "text": "。 今週は配信します"}, {"type": "subtitle", "time": 4502.47, "timestamp": "01:15:02", "text": "。   使っていませんが、懐かしく思います"}, {"type": "subtitle", "time": 4507.35, "timestamp": "01:15:07", "text": "。 おお。"}, {"type": "subtitle", "time": 4509.83, "timestamp": "01:15:09", "text": "なぜあなたはいつもトラブルを起こすのですか？"}, {"type": "subtitle", "time": 4518.47, "timestamp": "01:15:18", "text": "彼はエースを出した。 おお。"}, {"type": "subtitle", "time": 4520.63, "timestamp": "01:15:20", "text": "彼を見かけましたか？ おお。"}, {"type": "subtitle", "time": 4522.55, "timestamp": "01:15:22", "text": "突然死。"}, {"type": "subtitle", "time": 4543.83, "timestamp": "01:15:43", "text": "スパイクが植えられた。"}]
[{"type": "subtitle", "time": 7982.149, "timestamp": "02:13:02", "text": "、これを読ませて。申し訳ないけど、"}, {"type": "subtitle", "time": 7989.27, "timestamp": "02:13:09", "text": "皆さん、先週の出来事に関して、多くの方が"}, {"type": "subtitle", "time": 7991.589, "timestamp": "02:13:11", "text": "私たちからの連絡を待っていたことは承知しています"}, {"type": "subtitle", "time": 7993.91, "timestamp": "02:13:13", "text": "。"}, {"type": "subtitle", "time": 8001.51, "timestamp": "02:13:21", "text": "このように Grand Theft Auto 6 のゲームプレイ動画が流出したことは、"}, {"type": "subtitle", "time": 8004.709, "timestamp": "02:13:24", "text": "私たちのチームにとって非常に悲痛なことであり、これまでの長い時間を経て、皆さんにこのような形で"}, {"type": "subtitle", "time": 8009.83, "timestamp": "02:13:29", "text": "ゲームを見ていただくことは、明らかに私たちの意図したことではありませんでした。ですから、大変申し訳なく思っています"}, {"type": "subtitle", "time": 8014.47, "timestamp": "02:13:34", "text": "。"}, {"type": "subtitle", "time": 8017.99, "timestamp": "02:13:37", "text": "あります。なぜ"}, {"type": "subtitle", "time": 8023.03, "timestamp": "02:13:43", "text": "このAIのマークまであるのか？しかし、"}, {"type": "subtitle", "time": 8025.75, "timestamp": "02:13:45", "text": "ゲームをほぼ完成させ、"}, {"type": "subtitle", "time": 8027.189, "timestamp": "02:13:47", "text": "詳細や公式"}, {"type": "subtitle", "time": 8028.709, "timestamp": "02:13:48", "text": "ゲームプレイを共有し、コミュニティが"}, {"type": "subtitle", "time": 8030.79, "timestamp": "02:13:50", "text": "知りたいことすべてを提供することから、"}, {"type": "subtitle", "time": 8035.51, "timestamp": "02:13:55", "text": "明日拡張ルックを皆さんに見ていただくことを非常に楽しみにしています。"}, {"type": "subtitle", "time": 8038.069, "timestamp": "02:13:58", "text": "準備に予想以上に時間がかかっています。"}]
[{"type": "subtitle", "time": 6912.95, "timestamp": "01:55:12", "text": "人間界とデジタルワールドにまたがる謎を解き明かす。"}, {"type": "subtitle", "time": 6918.55, "timestamp": "01:55:18", "text": "世界を救うために、幅広いデジモンを集めて育てる。"}, {"type": "subtitle", "time": 6920.95, "timestamp": "01:55:20", "text": "ああ、待って。デジモンと ポケモンは"}, {"type": "subtitle", "time": 6924.07, "timestamp": "01:55:24", "text": "今は違うけど、似たようなところもある"}, {"type": "subtitle", "time": 6928.87, "timestamp": "01:55:28", "text": "けど、"}, {"type": "subtitle", "time": 6931.35, "timestamp": "01:55:31", "text": "世界観とかテーマが違うんだよね。"}]
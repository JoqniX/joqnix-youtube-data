[{"type": "subtitle", "time": 7382.55, "timestamp": "02:03:02", "text": "でも、一番大事なのは、ウェブサイトを刷新しないといけないことなんだ"}, {"type": "subtitle", "time": 7403.99, "timestamp": "02:03:23", "text": "。よし、戻ってきた。うん。ウェブ"}, {"type": "subtitle", "time": 7407.75, "timestamp": "02:03:27", "text": "サイトをかなり更新しないといけない。"}, {"type": "subtitle", "time": 7411.589, "timestamp": "02:03:31", "text": "ウェブサイトは今、めちゃくちゃなんだ。"}, {"type": "subtitle", "time": 7415.589, "timestamp": "02:03:35", "text": "でも、それを見せることはできると思う。よし。"}, {"type": "subtitle", "time": 7438.47, "timestamp": "02:03:58", "text": "それから"}]
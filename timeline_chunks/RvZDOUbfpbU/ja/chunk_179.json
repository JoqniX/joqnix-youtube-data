[{"type": "subtitle", "time": 10743.67, "timestamp": "02:59:03", "text": "。  AKをもう一度強化するつもりだ。   よし"}, {"type": "subtitle", "time": 10748.87, "timestamp": "02:59:08", "text": "。 えっと、日曜か金曜に、"}, {"type": "subtitle", "time": 10754.79, "timestamp": "02:59:14", "text": "明日の配信をやってみようと思います。 何のために"}, {"type": "subtitle", "time": 10758.389, "timestamp": "02:59:18", "text": "プレーするかはまだ決めていません。"}, {"type": "subtitle", "time": 10760.95, "timestamp": "02:59:20", "text": "だって、今は銃撃戦の季節だから。"}, {"type": "subtitle", "time": 10795.51, "timestamp": "02:59:55", "text": "ヘルダイバーズですか？"}, {"type": "subtitle", "time": 10797.67, "timestamp": "02:59:57", "text": "実は、彼が私をヘルダイバーズで一緒に遊ぼうと誘ってくれたんです"}]
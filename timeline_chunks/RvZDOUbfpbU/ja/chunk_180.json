[{"type": "subtitle", "time": 10800.15, "timestamp": "03:00:00", "text": "。"}, {"type": "subtitle", "time": 10803.51, "timestamp": "03:00:03", "text": "ああ、地獄のダイバーたちだ。 そのゲームのこと、すっかり忘れてた"}, {"type": "subtitle", "time": 10805.649, "timestamp": "03:00:05", "text": "。"}, {"type": "subtitle", "time": 10805.91, "timestamp": "03:00:05", "text": "[咳払い]"}, {"type": "subtitle", "time": 10834.15, "timestamp": "03:00:34", "text": "、私に何ができるか見てみましょう。"}, {"type": "subtitle", "time": 10836.55, "timestamp": "03:00:36", "text": "えっと、ちょっと待ってください"}, {"type": "subtitle", "time": 10843.67, "timestamp": "03:00:43", "text": "。"}, {"type": "subtitle", "time": 10845.75, "timestamp": "03:00:45", "text": "さて、今日はこれで終わりにしましょう。"}, {"type": "subtitle", "time": 10849.349, "timestamp": "03:00:49", "text": "そして今日来てくださった皆さん、来てくれて"}, {"type": "subtitle", "time": 10858.15, "timestamp": "03:00:58", "text": "ありがとう。"}]
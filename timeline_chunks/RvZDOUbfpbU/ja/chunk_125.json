[{"type": "subtitle", "time": 7510.07, "timestamp": "02:05:10", "text": "Caliberから決済できるように決済プロバイダーを探してたんだ。今まさにダウンロード中なんだけど、"}, {"type": "subtitle", "time": 7517.03, "timestamp": "02:05:17", "text": "うん。"}, {"type": "subtitle", "time": 7519.83, "timestamp": "02:05:19", "text": "それで、"}, {"type": "subtitle", "time": 7523.109, "timestamp": "02:05:23", "text": "去年はこういうの全部作ってたんだけど、"}, {"type": "subtitle", "time": 7527.189, "timestamp": "02:05:27", "text": "決済プロバイダーは"}, {"type": "subtitle", "time": 7529.83, "timestamp": "02:05:29", "text": "決済サービスとか、返金"}, {"type": "subtitle", "time": 7531.669, "timestamp": "02:05:31", "text": "ポリシーとか、"}, {"type": "subtitle", "time": 7534.229, "timestamp": "02:05:34", "text": "価格設定とかサービスとか、そういうの全部だった"}, {"type": "subtitle", "time": 7535.99, "timestamp": "02:05:35", "text": "。"}, {"type": "subtitle", "time": 7541.75, "timestamp": "02:05:41", "text": "テンプレートを作ったんだ。"}, {"type": "subtitle", "time": 7544.47, "timestamp": "02:05:44", "text": "新しいバッジをもらったよ、Jock。どんなバッジ"}, {"type": "subtitle", "time": 7547.189, "timestamp": "02:05:47", "text": "？"}, {"type": "subtitle", "time": 7549.35, "timestamp": "02:05:49", "text": "mod Founder"}, {"type": "subtitle", "time": 7551.99, "timestamp": "02:05:51", "text": "Manは、mod 2026のTwitchモデレータークラブのメンバーになることで獲得できるバッジだよ。"}]
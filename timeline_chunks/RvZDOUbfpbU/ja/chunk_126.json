[{"type": "subtitle", "time": 7578.79, "timestamp": "02:06:18", "text": "バッジがいっぱいあるね。"}, {"type": "subtitle", "time": 7583.109, "timestamp": "02:06:23", "text": "今年の6月だったよ。あぁ、まだ"}, {"type": "subtitle", "time": 7586.39, "timestamp": "02:06:26", "text": "来てない。あ"}, {"type": "subtitle", "time": 7588.47, "timestamp": "02:06:28", "text": "、そうだね。Discordが今まさにバグってる"}, {"type": "subtitle", "time": 7591.589, "timestamp": "02:06:31", "text": "。まだアップデートを受け取ってないんだ"}, {"type": "subtitle", "time": 7594.069, "timestamp": "02:06:34", "text": "。"}, {"type": "subtitle", "time": 7597.83, "timestamp": "02:06:37", "text": "承認サイクルがすごく長かった。"}, {"type": "subtitle", "time": 7605.35, "timestamp": "02:06:45", "text": "スケジュールを作らなきゃ。"}, {"type": "subtitle", "time": 7607.99, "timestamp": "02:06:47", "text": "スケジュールページは来ない。ニュースページ、"}, {"type": "subtitle", "time": 7611.35, "timestamp": "02:06:51", "text": "概要ページ。概要ページはあるんだけど。"}, {"type": "subtitle", "time": 7613.669, "timestamp": "02:06:53", "text": "今、全部作り直さなきゃ。"}, {"type": "subtitle", "time": 7616.229, "timestamp": "02:06:56", "text": "エピソードごとに。"}, {"type": "subtitle", "time": 7618.069, "timestamp": "02:06:58", "text": "ほとんどの人は、"}]
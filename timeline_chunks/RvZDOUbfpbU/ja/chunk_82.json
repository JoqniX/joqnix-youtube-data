[{"type": "subtitle", "time": 4949.03, "timestamp": "01:22:29", "text": "走れ、走れ、走れ。 ああ、くそ。"}, {"type": "subtitle", "time": 4957.11, "timestamp": "01:22:37", "text": "そう、"}, {"type": "subtitle", "time": 4961.51, "timestamp": "01:22:41", "text": "バトルフィールドやコールオブデューティみたいなゲームをプレイしている時に、こういうテンポの"}, {"type": "subtitle", "time": 4963.91, "timestamp": "01:22:43", "text": "遅いシューティングゲームに切り替えると"}, {"type": "subtitle", "time": 4969.83, "timestamp": "01:22:49", "text": "、すぐに適応できないんだよね。"}, {"type": "subtitle", "time": 4972.31, "timestamp": "01:22:52", "text": "「どうやって走ればいいの？どうやって"}]
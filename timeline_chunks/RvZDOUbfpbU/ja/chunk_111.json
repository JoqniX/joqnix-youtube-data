[{"type": "subtitle", "time": 6667.03, "timestamp": "01:51:07", "text": "ああ、ゼルダのゲーム。ゼルダはプレイしたことがない"}, {"type": "subtitle", "time": 6671.51, "timestamp": "01:51:11", "text": "。えっと、オリアナ・オブ・タイムをプレイしたことがある。えっと、"}, {"type": "subtitle", "time": 6677.43, "timestamp": "01:51:17", "text": "後で何かを使って。"}, {"type": "subtitle", "time": 6679.59, "timestamp": "01:51:19", "text": "楽しかった。"}, {"type": "subtitle", "time": 6682.149, "timestamp": "01:51:22", "text": "とても良かった。"}, {"type": "subtitle", "time": 6685.43, "timestamp": "01:51:25", "text": "本当にゼルダの"}, {"type": "subtitle", "time": 6692.55, "timestamp": "01:51:32", "text": "にあると思う。ああ、本当？"}, {"type": "subtitle", "time": 6701.589, "timestamp": "01:51:41", "text": "探してみよう。"}, {"type": "subtitle", "time": 6703.91, "timestamp": "01:51:43", "text": "チェックしてみよう。"}, {"type": "subtitle", "time": 6711.27, "timestamp": "01:51:51", "text": "わかった。ああ、死にそうだ。ねえ、今日はこれで終わりにしよう"}, {"type": "subtitle", "time": 6714.31, "timestamp": "01:51:54", "text": "。えっと、ただ"}, {"type": "subtitle", "time": 6716.79, "timestamp": "01:51:56", "text": "おしゃべりするだけでいいよ。待って、今ただおしゃべりするだけ。"}]
[{"type": "subtitle", "time": 8703.99, "timestamp": "02:25:03", "text": "Worldの週のときもそうでした。"}, {"type": "subtitle", "time": 8705.75, "timestamp": "02:25:05", "text": "ストリーミングを始めたとき、"}, {"type": "subtitle", "time": 8709.51, "timestamp": "02:25:09", "text": "自分と親しい友人のためにサーバーを購入しました"}, {"type": "subtitle", "time": 8711.429, "timestamp": "02:25:11", "text": "。"}, {"type": "subtitle", "time": 8717.75, "timestamp": "02:25:17", "text": "できるだけ早く家に帰ってきて、"}, {"type": "subtitle", "time": 8721.19, "timestamp": "02:25:21", "text": "「うん、 配信します。"}, {"type": "subtitle", "time": 8722.95, "timestamp": "02:25:22", "text": "私はパンを演奏します。 私は"}, {"type": "subtitle", "time": 8724.469, "timestamp": "02:25:24", "text": "この"}, {"type": "subtitle", "time": 8726.309, "timestamp": "02:25:26", "text": "ボス戦に挑戦するつもりだ。 私はこれをやるつもりだ。"}, {"type": "subtitle", "time": 8728.79, "timestamp": "02:25:28", "text": "これを徹底的にやり込むつもりだ。 木や石などを用意して、"}, {"type": "subtitle", "time": 8746.15, "timestamp": "02:25:46", "text": "音楽にこれくらいの努力を注ぎたいよ"}]
[{"type": "subtitle", "time": 8820.95, "timestamp": "02:27:00", "text": "。"}, {"type": "subtitle", "time": 8822.71, "timestamp": "02:27:02", "text": "口径。"}, {"type": "subtitle", "time": 8824.63, "timestamp": "02:27:04", "text": "試してみましょう。 これを試してみましょう。"}, {"type": "subtitle", "time": 8827.03, "timestamp": "02:27:07", "text": "まあ、少しの間だけね。 様子を見てみます"}, {"type": "subtitle", "time": 8830.469, "timestamp": "02:27:10", "text": "。 気に入ったら、ストリーミング配信します。 わかった。"}, {"type": "subtitle", "time": 8833.429, "timestamp": "02:27:13", "text": "皆さんがそれで問題ないことを願っています。   よし"}, {"type": "subtitle", "time": 8835.11, "timestamp": "02:27:15", "text": "。"}, {"type": "subtitle", "time": 8842.15, "timestamp": "02:27:22", "text": "これはLinkからの推薦だったに違いない"}, {"type": "subtitle", "time": 8844.63, "timestamp": "02:27:24", "text": "。 これは何ですか？"}, {"type": "subtitle", "time": 8849.03, "timestamp": "02:27:29", "text": "ストリームIDを使用して新しいゲームを作成します。 うん。 ニックネームは"}, {"type": "subtitle", "time": 8857.429, "timestamp": "02:27:37", "text": "これは、ええと、EKA が推奨するゲームです"}, {"type": "subtitle", "time": 8865.19, "timestamp": "02:27:45", "text": "。 なぜ今、あなたの名前を間違えてしまったのだろう"}]
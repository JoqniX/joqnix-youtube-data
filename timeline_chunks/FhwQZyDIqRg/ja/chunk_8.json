[{"type": "subtitle", "time": 481.909, "timestamp": "00:08:01", "text": "ああ、初日からそこにいたから"}, {"type": "subtitle", "time": 484.39, "timestamp": "00:08:04", "text": "まだ初日ではないけれど"}, {"type": "subtitle", "time": 487.43, "timestamp": "00:08:07", "text": "つまり、初日から視聴している人がたくさんいるということだ。"}, {"type": "subtitle", "time": 490.11, "timestamp": "00:08:10", "text": "視聴者の支持者はまだ"}, {"type": "subtitle", "time": 494.629, "timestamp": "00:08:14", "text": "私と話したり、そういうことをしたり。 M 私は"}, {"type": "subtitle", "time": 497.909, "timestamp": "00:08:17", "text": "皆さんにお会いできて本当に嬉しいです"}, {"type": "subtitle", "time": 515.55, "timestamp": "00:08:35", "text": "皆さん、エンズさん。ヤフー。感謝"}, {"type": "subtitle", "time": 519.11, "timestamp": "00:08:39", "text": "あなた。では、次に進みましょう"}, {"type": "subtitle", "time": 522.469, "timestamp": "00:08:42", "text": "明らかにする。わかりました、それについては後で話します"}, {"type": "subtitle", "time": 523.87, "timestamp": "00:08:43", "text": "の"}, {"type": "subtitle", "time": 526.509, "timestamp": "00:08:46", "text": "暴露的。ねえ、私は"}, {"type": "subtitle", "time": 531.75, "timestamp": "00:08:51", "text": "下から始めましょう。ああ、わかった。そうですね、"}, {"type": "subtitle", "time": 533.87, "timestamp": "00:08:53", "text": "私の手はまだ"}, {"type": "subtitle", "time": 537.67, "timestamp": "00:08:57", "text": "震えている。ああ、まだ手が震えています。"}]
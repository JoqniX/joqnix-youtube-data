[{"type": "subtitle", "time": 4321.669, "timestamp": "01:12:01", "text": "何か。いや、違うよ。"}, {"type": "subtitle", "time": 4323.75, "timestamp": "01:12:03", "text": "はい、どうぞ。私は手に入れるつもりです 私は行くつもりです"}, {"type": "subtitle", "time": 4325.83, "timestamp": "01:12:05", "text": "私のスタミナをアップグレードするため。私は"}, {"type": "subtitle", "time": 4327.669, "timestamp": "01:12:07", "text": "追加の宝石を手に入れるつもりだ。私は思う"}, {"type": "subtitle", "time": 4330.47, "timestamp": "01:12:10", "text": "IPが必要な理由は"}, {"type": "subtitle", "time": 4332.709, "timestamp": "01:12:12", "text": "みんな、スタミナアップグレードは取らないで。"}, {"type": "subtitle", "time": 4335.35, "timestamp": "01:12:15", "text": "大丈夫。実際、私は"}, {"type": "subtitle", "time": 4338.95, "timestamp": "01:12:18", "text": "[ __ ]たちが私についてきているなら、行くぞ。"}, {"type": "subtitle", "time": 4341.79, "timestamp": "01:12:21", "text": "死なない限りは大丈夫だ。"}, {"type": "subtitle", "time": 4345.669, "timestamp": "01:12:25", "text": "行くぞ。待って、"}, {"type": "subtitle", "time": 4349.35, "timestamp": "01:12:29", "text": "屋根裏部屋はどこですか？"}, {"type": "subtitle", "time": 4358.07, "timestamp": "01:12:38", "text": "何かはどこにあるの？しゃがんでもいいですか？おお、"}, {"type": "subtitle", "time": 4360.91, "timestamp": "01:12:40", "text": "あなたは私を二階に押し上げるつもりですか。"}, {"type": "subtitle", "time": 4365.189, "timestamp": "01:12:45", "text": "わかった。わかった。わかった。どこですか？そこには"}, {"type": "subtitle", "time": 4367.669, "timestamp": "01:12:47", "text": "いいえ、こちらです。こちらです。どうすればいいですか"}, {"type": "subtitle", "time": 4368.87, "timestamp": "01:12:48", "text": "それ？どうすればいいですか？どうすればいいですか"}, {"type": "subtitle", "time": 4371.669, "timestamp": "01:12:51", "text": "それ？みんなが"}, {"type": "subtitle", "time": 4374.07, "timestamp": "01:12:54", "text": "興奮した。だから、毎回、だから、"}, {"type": "subtitle", "time": 4375.189, "timestamp": "01:12:55", "text": "基本的に、どこに"}, {"type": "subtitle", "time": 4379.03, "timestamp": "01:12:59", "text": "あれ？しゃがむ姿勢はどこにあるの？それはどこにあるの？"}]
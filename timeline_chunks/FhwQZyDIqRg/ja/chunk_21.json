[{"type": "subtitle", "time": 1266.51, "timestamp": "00:21:06", "text": "デザイン。ねえ、これ"}, {"type": "subtitle", "time": 1268.27, "timestamp": "00:21:08", "text": "は"}, {"type": "subtitle", "time": 1270.71, "timestamp": "00:21:10", "text": "実際にショックの未来になる"}, {"type": "subtitle", "time": 1272.43, "timestamp": "00:21:12", "text": "次"}, {"type": "subtitle", "time": 1276.51, "timestamp": "00:21:16", "text": "の上。でも、緊張しています。震えている"}, {"type": "subtitle", "time": 1281.149, "timestamp": "00:21:21", "text": "今。こんにちは。それで、それで、それで、"}, {"type": "subtitle", "time": 1283.23, "timestamp": "00:21:23", "text": "だから、"}, {"type": "subtitle", "time": 1286.07, "timestamp": "00:21:26", "text": "えーと、それで、えーと、彼女が、えーと、"}, {"type": "subtitle", "time": 1294.11, "timestamp": "00:21:34", "text": "スケッチして、実際"}, {"type": "subtitle", "time": 1298.31, "timestamp": "00:21:38", "text": "夜に泣いた、それは夜だったのか、それとも何かだったのか"}, {"type": "subtitle", "time": 1300.75, "timestamp": "00:21:40", "text": "何か？だから私は実際にそうだった"}, {"type": "subtitle", "time": 1303.669, "timestamp": "00:21:43", "text": "実際に何かをしていた時間"}, {"type": "subtitle", "time": 1305.39, "timestamp": "00:21:45", "text": "の"}, {"type": "subtitle", "time": 1307.95, "timestamp": "00:21:47", "text": "ストリームで、私はとても"}, {"type": "subtitle", "time": 1311.35, "timestamp": "00:21:51", "text": "イライラする。どこにも手が届かなかった"}, {"type": "subtitle", "time": 1313.43, "timestamp": "00:21:53", "text": "全部。それはとても困難でした"}, {"type": "subtitle", "time": 1314.83, "timestamp": "00:21:54", "text": "私も"}, {"type": "subtitle", "time": 1316.87, "timestamp": "00:21:56", "text": "新しいことをすべて理解しています"}, {"type": "subtitle", "time": 1319.11, "timestamp": "00:21:59", "text": "学ぶ"}]
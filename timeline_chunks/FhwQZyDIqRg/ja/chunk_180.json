[{"type": "subtitle", "time": 10800.55, "timestamp": "03:00:00", "text": "わかった。彼が見ているのがわかる。おお、"}, {"type": "subtitle", "time": 10802.63, "timestamp": "03:00:02", "text": "そしてTwitchは普段は"}, {"type": "subtitle", "time": 10806.79, "timestamp": "03:00:06", "text": "チャット。そうそう、その通り。なるほど。兄弟、彼らは"}, {"type": "subtitle", "time": 10810.309, "timestamp": "03:00:10", "text": "それらの場所からログインすることもできます"}, {"type": "subtitle", "time": 10812.79, "timestamp": "03:00:12", "text": "魚、あなたは手に入れました。ええ、ありがとうございます。"}, {"type": "subtitle", "time": 10815.19, "timestamp": "03:00:15", "text": "Warfishさん、本当にありがとうございます。"}, {"type": "subtitle", "time": 10817.11, "timestamp": "03:00:17", "text": "私たちを連れてきてくれた本当に素晴らしい人"}, {"type": "subtitle", "time": 10827.03, "timestamp": "03:00:27", "text": "ええ、本当にありがとうございました、サーフィッシュさん。"}, {"type": "subtitle", "time": 10829.67, "timestamp": "03:00:29", "text": "こんにちは。"}, {"type": "subtitle", "time": 10832.55, "timestamp": "03:00:32", "text": "ええ、そうですよ。君たちは戦う必要がある、"}, {"type": "subtitle", "time": 10834.389, "timestamp": "03:00:34", "text": "ほら、1対1で戦う必要があるんだ"}, {"type": "subtitle", "time": 10843.99, "timestamp": "03:00:43", "text": "うん。"}, {"type": "subtitle", "time": 10847.83, "timestamp": "03:00:47", "text": "皆さん、さようなら。バイバイ。はい。バイバイ。"}, {"type": "subtitle", "time": 10849.67, "timestamp": "03:00:49", "text": "そして私たちは絶対にこれを実行するつもりです"}, {"type": "subtitle", "time": 10852.15, "timestamp": "03:00:52", "text": "また。バイバイ。"}]
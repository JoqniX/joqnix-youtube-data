[{"type": "subtitle", "time": 3481.109, "timestamp": "00:58:01", "text": "私は望む。"}, {"type": "subtitle", "time": 3484.15, "timestamp": "00:58:04", "text": "ああ、そうだったらいいのに。待って、ゼノ。ゼノン。ゼノン。"}, {"type": "subtitle", "time": 3487.109, "timestamp": "00:58:07", "text": "いいか、後ろに来ないでくれ。注意深い。"}, {"type": "subtitle", "time": 3489.829, "timestamp": "00:58:09", "text": "注意深い。うさぎコンボ。"}, {"type": "subtitle", "time": 3494.15, "timestamp": "00:58:14", "text": "私は隅っこにいる。あ、こんにちは。"}, {"type": "subtitle", "time": 3496.309, "timestamp": "00:58:16", "text": "うん。うん、大丈夫だよ。大丈夫です。それは"}, {"type": "subtitle", "time": 3499.349, "timestamp": "00:58:19", "text": "行ってしまった？なくなってしまったのですか？わかった。私は行くのか"}, {"type": "subtitle", "time": 3500.87, "timestamp": "00:58:20", "text": "ドアを通って？見えますか？私は感じる"}, {"type": "subtitle", "time": 3504.15, "timestamp": "00:58:24", "text": "毎回のように"}, {"type": "subtitle", "time": 3505.99, "timestamp": "00:58:25", "text": "頑張ってね、みんな。テレビが映っています。"}, {"type": "subtitle", "time": 3507.829, "timestamp": "00:58:27", "text": "テレビ。テレビ。カートに入れていただけますか？"}, {"type": "subtitle", "time": 3510.789, "timestamp": "00:58:30", "text": "お願いします？うん。わかった。待って、待って、みんな。"}, {"type": "subtitle", "time": 3513.589, "timestamp": "00:58:33", "text": "待って、待って、みんな。待って、待って、みんな。ただ"}, {"type": "subtitle", "time": 3515.67, "timestamp": "00:58:35", "text": "それを捨てろ。もうその話はやめようよ、みんな。私たちの"}, {"type": "subtitle", "time": 3518.789, "timestamp": "00:58:38", "text": "kodは完了しました。私たちのコードは完成しました。私は思う"}, {"type": "subtitle", "time": 3522.63, "timestamp": "00:58:42", "text": "6,000。うん。うん。"}, {"type": "subtitle", "time": 3526.789, "timestamp": "00:58:46", "text": "16,000だと思います。うん。"}, {"type": "subtitle", "time": 3528.39, "timestamp": "00:58:48", "text": "私たちはもっと多くのものを持って行きました"}]
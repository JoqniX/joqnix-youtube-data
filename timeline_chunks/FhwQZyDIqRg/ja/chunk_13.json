[{"type": "subtitle", "time": 789.67, "timestamp": "00:13:09", "text": "知る。キラキラ。こんにちは、スパークル。タイ。おお、"}, {"type": "subtitle", "time": 796.389, "timestamp": "00:13:16", "text": "それ。他の絵文字はちょっとやりすぎかな。"}, {"type": "subtitle", "time": 801.11, "timestamp": "00:13:21", "text": "無効化した方がいいでしょうか？"}, {"type": "subtitle", "time": 803.71, "timestamp": "00:13:23", "text": "[音楽]"}, {"type": "subtitle", "time": 812.03, "timestamp": "00:13:32", "text": "それ。そしてこれが私です"}, {"type": "subtitle", "time": 831.91, "timestamp": "00:13:51", "text": "それ？実は、それには裏話があるんです。"}, {"type": "subtitle", "time": 835.59, "timestamp": "00:13:55", "text": "後で説明します。私はそれらのために"}, {"type": "subtitle", "time": 838.23, "timestamp": "00:13:58", "text": "私の視聴者の皆さん、"}]
[{"type": "subtitle", "time": 8293.669, "timestamp": "02:18:13", "text": "うん。ニース。ニース。"}, {"type": "subtitle", "time": 8296.07, "timestamp": "02:18:16", "text": "私は白人です。私は文化の盗用をしているのだろうか？私は見た"}, {"type": "subtitle", "time": 8299.349, "timestamp": "02:18:19", "text": "本物の文化を体験するには、カを身につけて様々な場所へ行く"}, {"type": "subtitle", "time": 8302.549, "timestamp": "02:18:22", "text": "そして私の体に鉤十字を描いて"}, {"type": "subtitle", "time": 8304.429, "timestamp": "02:18:24", "text": "どうしたの？"}, {"type": "subtitle", "time": 8307.589, "timestamp": "02:18:27", "text": "ウフス、私の父は誰が尋ねたのか、誰が尋ねたのか"}, {"type": "subtitle", "time": 8310.07, "timestamp": "02:18:30", "text": "ベジタリアン。彼は私が白人かどうか尋ねている。私は"}, {"type": "subtitle", "time": 8312.23, "timestamp": "02:18:32", "text": "インド文化を盗用する"}, {"type": "subtitle", "time": 8314.309, "timestamp": "02:18:34", "text": "カの場所を身に着け、スワスを持っている"}, {"type": "subtitle", "time": 8318.87, "timestamp": "02:18:38", "text": "自分自身にペイントした？いいえ。何ですか？"}, {"type": "subtitle", "time": 8321.589, "timestamp": "02:18:41", "text": "誰も気にしないと思う。うん。うん。"}, {"type": "subtitle", "time": 8323.509, "timestamp": "02:18:43", "text": "誰も、誰も"}, {"type": "subtitle", "time": 8326.389, "timestamp": "02:18:46", "text": "うん。誰もそうすべきではない。うん。私はそこにいますか"}, {"type": "subtitle", "time": 8328.629, "timestamp": "02:18:48", "text": "つまり、それは実際には面白いです。"}, {"type": "subtitle", "time": 8331.27, "timestamp": "02:18:51", "text": "人はどんなことでもあなたを判断するだろう。"}, {"type": "subtitle", "time": 8333.75, "timestamp": "02:18:53", "text": "何でも。面白いのは"}, {"type": "subtitle", "time": 8335.589, "timestamp": "02:18:55", "text": "アニメTシャツを着ている人たち"}, {"type": "subtitle", "time": 8339.03, "timestamp": "02:18:59", "text": "そのことであなたを非難するつもりです。知っている。"}]
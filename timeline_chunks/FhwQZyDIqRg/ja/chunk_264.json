[{"type": "subtitle", "time": 15840.469, "timestamp": "04:24:00", "text": "反対です。ありがとう。いえ、結構です。あなた"}, {"type": "subtitle", "time": 15842.55, "timestamp": "04:24:02", "text": "維持するのが難しいと感じる"}, {"type": "subtitle", "time": 15846.03, "timestamp": "04:24:06", "text": "継続的な努力。ええ、まあ、そんな感じです。"}, {"type": "subtitle", "time": 15849.99, "timestamp": "04:24:09", "text": "うん。はい。未完了。はい。でも、"}, {"type": "subtitle", "time": 15853.149, "timestamp": "04:24:13", "text": "えっと、私はまだゲットします"}, {"type": "subtitle", "time": 15855.99, "timestamp": "04:24:15", "text": "平衡。私は"}, {"type": "subtitle", "time": 15857.91, "timestamp": "04:24:17", "text": "禅。私は、"}, {"type": "subtitle", "time": 15860.79, "timestamp": "04:24:20", "text": "まず、流れができれば、"}, {"type": "subtitle", "time": 15863.51, "timestamp": "04:24:23", "text": "ロックされます。だから、私は"}, {"type": "subtitle", "time": 15866.07, "timestamp": "04:24:26", "text": "レベル1で同意してください、"}, {"type": "subtitle", "time": 15870.469, "timestamp": "04:24:30", "text": "レベル3は同意、またはレベル2。うん。"}, {"type": "subtitle", "time": 15873.269, "timestamp": "04:24:33", "text": "あなたは自分の選択をめったに後悔しない"}, {"type": "subtitle", "time": 15875.07, "timestamp": "04:24:35", "text": "持っている"}, {"type": "subtitle", "time": 15877.55, "timestamp": "04:24:37", "text": "作った。おお、"}, {"type": "subtitle", "time": 15881.11, "timestamp": "04:24:41", "text": "めったに。うん、同意。レベル３、同意します。"}, {"type": "subtitle", "time": 15883.59, "timestamp": "04:24:43", "text": "私はめったに疑念を抱かないのは、"}, {"type": "subtitle", "time": 15887.309, "timestamp": "04:24:47", "text": "もし私が終わったのなら、それで終わりだ。私は気にしない"}, {"type": "subtitle", "time": 15889.51, "timestamp": "04:24:49", "text": "もう。あなたの友人はあなたについてこう言うでしょう"}, {"type": "subtitle", "time": 15893.75, "timestamp": "04:24:53", "text": "活発で社交的。いいえ。いいえ。"}, {"type": "subtitle", "time": 15897.07, "timestamp": "04:24:57", "text": "反対です。レベル３。"}, {"type": "subtitle", "time": 15899.91, "timestamp": "04:24:59", "text": "反対です。私の友達はすべてを言う"}]
[{"type": "subtitle", "time": 6900.79, "timestamp": "01:55:00", "text": "あなた。いいえ。誰が始めたのですか？私は彼にそうしないと言った"}, {"type": "subtitle", "time": 6902.55, "timestamp": "01:55:02", "text": "彼女にやり方を教えるまでは"}, {"type": "subtitle", "time": 6906.229, "timestamp": "01:55:06", "text": "それ。ええ、それは彼であって、あなたではありませんでした。さあ"}, {"type": "subtitle", "time": 6910.149, "timestamp": "01:55:10", "text": "HPを共有する。大丈夫。"}, {"type": "subtitle", "time": 6915.03, "timestamp": "01:55:15", "text": "お前みたいなバカは、俺がそうだったんだ。私は自分の"}, {"type": "subtitle", "time": 6916.55, "timestamp": "01:55:16", "text": "延長ケーブル。私はそれを聞いていません。"}, {"type": "subtitle", "time": 6918.07, "timestamp": "01:55:18", "text": "さあ行こう。"}, {"type": "subtitle", "time": 6920.79, "timestamp": "01:55:20", "text": "私はあなたにたくさんのことを伝えました。すべて"}, {"type": "subtitle", "time": 6922.709, "timestamp": "01:55:22", "text": "右。大丈夫。問題ありません。その"}, {"type": "subtitle", "time": 6924.79, "timestamp": "01:55:24", "text": "よし。大丈夫。さあ行こう。さあ"}, {"type": "subtitle", "time": 6928.39, "timestamp": "01:55:28", "text": "行く。あなたには猫の祖先がいる。そうでしょうか？レベル"}, {"type": "subtitle", "time": 6929.91, "timestamp": "01:55:29", "text": "三つ。"}, {"type": "subtitle", "time": 6932.31, "timestamp": "01:55:32", "text": "本当にごめんね、ゼノ。私はそうです。その"}, {"type": "subtitle", "time": 6934.55, "timestamp": "01:55:34", "text": "わかった。大丈夫です。大丈夫です。大丈夫。"}, {"type": "subtitle", "time": 6942.75, "timestamp": "01:55:42", "text": "一体何なんだこれは"}, {"type": "subtitle", "time": 6950.07, "timestamp": "01:55:50", "text": "ああ、あれは危険そうだ。お願いします"}, {"type": "subtitle", "time": 6951.99, "timestamp": "01:55:51", "text": "滞在する"}, {"type": "subtitle", "time": 6957.43, "timestamp": "01:55:57", "text": "その物体は危険に見える。何てことだ。何でも"}, {"type": "subtitle", "time": 6959.27, "timestamp": "01:55:59", "text": "危険そうに見えるし、めちゃくちゃ怖い。"}]
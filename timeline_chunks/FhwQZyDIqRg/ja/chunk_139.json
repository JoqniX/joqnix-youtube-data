[{"type": "subtitle", "time": 8341.75, "timestamp": "02:19:01", "text": "待って、待って、待って。持続する。"}, {"type": "subtitle", "time": 8342.429, "timestamp": "02:19:02", "text": "何"}, {"type": "subtitle", "time": 8345.11, "timestamp": "02:19:05", "text": "多様性がたくさんある場合"}, {"type": "subtitle", "time": 8346.549, "timestamp": "02:19:06", "text": "インド？彼がどこへ行くのか、私は知っている。知っている"}, {"type": "subtitle", "time": 8347.75, "timestamp": "02:19:07", "text": "彼がどこへ行くのか。私は誰かが言った"}, {"type": "subtitle", "time": 8349.509, "timestamp": "02:19:09", "text": "アニメを見ない人は、"}, {"type": "subtitle", "time": 8350.95, "timestamp": "02:19:10", "text": "アニメTシャツを着ている？脱落しました。いいえ、"}, {"type": "subtitle", "time": 8353.27, "timestamp": "02:19:13", "text": "いや、いや、いや。そうじゃない。そうじゃない。わかった。私"}, {"type": "subtitle", "time": 8355.11, "timestamp": "02:19:15", "text": "それについては別の話がある。わかった。私"}, {"type": "subtitle", "time": 8357.03, "timestamp": "02:19:17", "text": "この子を一人見かけた。彼は立っていた"}, {"type": "subtitle", "time": 8360.629, "timestamp": "02:19:20", "text": "学校の外で、"}, {"type": "subtitle", "time": 8362.389, "timestamp": "02:19:22", "text": "あのパーカー。目"}, {"type": "subtitle", "time": 8365.469, "timestamp": "02:19:25", "text": "パーカー。はい。彼の前に"}, {"type": "subtitle", "time": 8368.79, "timestamp": "02:19:28", "text": "学校から学校へ。わかった。あなたはそうすべきですか"}, {"type": "subtitle", "time": 8372.95, "timestamp": "02:19:32", "text": "そんな人に？つまり、"}, {"type": "subtitle", "time": 8375.99, "timestamp": "02:19:35", "text": "それについては何も言えません。"}, {"type": "subtitle", "time": 8377.91, "timestamp": "02:19:37", "text": "私の兄弟のうち2人がそれを所有している。私"}, {"type": "subtitle", "time": 8381.79, "timestamp": "02:19:41", "text": "何も言えません。神。ああ、神様。私"}, {"type": "subtitle", "time": 8385.27, "timestamp": "02:19:45", "text": "つまり、彼らが言っているのは、まさにその通りです。私は思う"}, {"type": "subtitle", "time": 8387.75, "timestamp": "02:19:47", "text": "彼らがそれを所有している。でも、私は"}, {"type": "subtitle", "time": 8390.23, "timestamp": "02:19:50", "text": "文字通りTシャツを着て仕事に行く。私は"}, {"type": "subtitle", "time": 8393.349, "timestamp": "02:19:53", "text": "文字通り私は持っていますそれは私のそれは私の"}, {"type": "subtitle", "time": 8395.349, "timestamp": "02:19:55", "text": "それが私の制服です。私は持っているように"}, {"type": "subtitle", "time": 8397.71, "timestamp": "02:19:57", "text": "私のワードローブには他に何もない"}, {"type": "subtitle", "time": 8399.91, "timestamp": "02:19:59", "text": "私のアニメTシャツ以外に"}]
[{"type": "subtitle", "time": 8401.75, "timestamp": "02:20:01", "text": "ワードローブ。そして私の両親は"}, {"type": "subtitle", "time": 8403.27, "timestamp": "02:20:03", "text": "アシュリーは「ねえ、知ってる？"}, {"type": "subtitle", "time": 8404.95, "timestamp": "02:20:04", "text": "今日は休みを取って、私たちと一緒に来てください。"}, {"type": "subtitle", "time": 8406.389, "timestamp": "02:20:06", "text": "「服を買ってあげるよ。」"}, {"type": "subtitle", "time": 8407.99, "timestamp": "02:20:07", "text": "「服はあるよ」って感じだった。 「あれら」"}, {"type": "subtitle", "time": 8409.67, "timestamp": "02:20:09", "text": "「服ではない」ならば、着ない"}, {"type": "subtitle", "time": 8415.67, "timestamp": "02:20:15", "text": "その服。はい。でも今は私は私は私は欲しい"}, {"type": "subtitle", "time": 8417.349, "timestamp": "02:20:17", "text": "アニメTシャツを買うため。ああ、また"}, {"type": "subtitle", "time": 8421.91, "timestamp": "02:20:21", "text": "ノラミを見た人いますか？はい。"}, {"type": "subtitle", "time": 8424.359, "timestamp": "02:20:24", "text": "はい。 ピーカミは素晴らしい。そこにはあった、そこにはあった"}, {"type": "subtitle", "time": 8427.359, "timestamp": "02:20:27", "text": "ピーカミは素晴らしい。そこにはあった、そこにはあった ある子供が実際に私にこう言った"}, {"type": "subtitle", "time": 8430.08, "timestamp": "02:20:30", "text": "ある子供が実際に私にこう言った そして、私はそのことだけを覚えている。ああ、そうだ、"}, {"type": "subtitle", "time": 8432.0, "timestamp": "02:20:32", "text": "そして、私はそのことだけを覚えている。ああ、そうだ、 長見がいる。"}, {"type": "subtitle", "time": 8438.07, "timestamp": "02:20:38", "text": "その折り紙は、私がわからないような"}, {"type": "subtitle", "time": 8439.99, "timestamp": "02:20:39", "text": "あまり感じない、概念全体が"}, {"type": "subtitle", "time": 8442.79, "timestamp": "02:20:42", "text": "過小評価されている 過大評価されている こんにちはベクター"}, {"type": "subtitle", "time": 8444.309, "timestamp": "02:20:44", "text": "好き嫌いは別として、あなたはただそれが好きだから"}, {"type": "subtitle", "time": 8445.91, "timestamp": "02:20:45", "text": "気に入らないなら、気に入らないで"}, {"type": "subtitle", "time": 8447.83, "timestamp": "02:20:47", "text": "それは意味しない、例えばもし"}, {"type": "subtitle", "time": 8449.19, "timestamp": "02:20:49", "text": "みんなが気に入っているのに、あなたは気に入らない"}, {"type": "subtitle", "time": 8450.469, "timestamp": "02:20:50", "text": "それは、ああ神様"}, {"type": "subtitle", "time": 8452.389, "timestamp": "02:20:52", "text": "過大評価されているとか、過小評価されているとか、とにかく"}, {"type": "subtitle", "time": 8453.75, "timestamp": "02:20:53", "text": "好きか嫌いかは別として、"}, {"type": "subtitle", "time": 8454.95, "timestamp": "02:20:54", "text": "人々はあなたが安物ではないことに気づく"}, {"type": "subtitle", "time": 8457.11, "timestamp": "02:20:57", "text": "羊、あなたは人間で、あなたは"}]
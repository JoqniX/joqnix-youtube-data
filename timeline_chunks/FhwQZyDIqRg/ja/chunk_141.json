[{"type": "subtitle", "time": 8460.389, "timestamp": "02:21:00", "text": "選択肢はまさにあなたが選ぶものです"}, {"type": "subtitle", "time": 8462.389, "timestamp": "02:21:02", "text": "あなたが望むものなら何でも、そして間違いなく"}, {"type": "subtitle", "time": 8464.79, "timestamp": "02:21:04", "text": "選択肢のない人に対して"}, {"type": "subtitle", "time": 8466.71, "timestamp": "02:21:06", "text": "一部の人々。けっこうだ。それは本当だ。"}, {"type": "subtitle", "time": 8468.469, "timestamp": "02:21:08", "text": "いや、つまり、人々はそこにいる、"}, {"type": "subtitle", "time": 8470.87, "timestamp": "02:21:10", "text": "そういう状況にある人は"}, {"type": "subtitle", "time": 8472.63, "timestamp": "02:21:12", "text": "自分の選択ができない場所で、"}, {"type": "subtitle", "time": 8474.63, "timestamp": "02:21:14", "text": "右？うん。だから彼らは"}, {"type": "subtitle", "time": 8476.469, "timestamp": "02:21:16", "text": "人々がただ"}, {"type": "subtitle", "time": 8479.59, "timestamp": "02:21:19", "text": "私が見る限り、そういう悪のような存在になるんだ。おお、"}, {"type": "subtitle", "time": 8481.83, "timestamp": "02:21:21", "text": "トロールのことですか？トロールのことですか？なるほど。"}, {"type": "subtitle", "time": 8485.349, "timestamp": "02:21:25", "text": "うん。時には毒性がある"}, {"type": "subtitle", "time": 8487.349, "timestamp": "02:21:27", "text": "あなたをバラバラにするだけです。しかし私は"}, {"type": "subtitle", "time": 8489.59, "timestamp": "02:21:29", "text": "一般的に、私は人々が"}, {"type": "subtitle", "time": 8491.51, "timestamp": "02:21:31", "text": "彼らは気づいて変わる"}, {"type": "subtitle", "time": 8493.83, "timestamp": "02:21:33", "text": "私がアニメをやってた頃は、アニメはこんなに人気じゃなかったんだよ"}, {"type": "subtitle", "time": 8495.59, "timestamp": "02:21:35", "text": "学校にいたから言えない、言えない"}, {"type": "subtitle", "time": 8498.309, "timestamp": "02:21:38", "text": "アニメを見る人は絶対にありえない"}, {"type": "subtitle", "time": 8500.07, "timestamp": "02:21:40", "text": "私はただ自分の"}, {"type": "subtitle", "time": 8502.87, "timestamp": "02:21:42", "text": "私のクラスでは今、"}, {"type": "subtitle", "time": 8504.63, "timestamp": "02:21:44", "text": "アニメを見ない人たちと"}, {"type": "subtitle", "time": 8508.55, "timestamp": "02:21:48", "text": "彼らは私にも少し似すぎている"}, {"type": "subtitle", "time": 8510.95, "timestamp": "02:21:50", "text": "今では普通とは見なされていない"}, {"type": "subtitle", "time": 8513.83, "timestamp": "02:21:53", "text": "それが普通だ、それが真実だ、見ている"}, {"type": "subtitle", "time": 8517.67, "timestamp": "02:21:57", "text": "アニメは普通だよ、さあ行こう。実際には、"}]
[{"type": "subtitle", "time": 2280.47, "timestamp": "00:38:00", "text": "それ。聞こえました。わかった。こんにちは、みんな。"}, {"type": "subtitle", "time": 2281.99, "timestamp": "00:38:01", "text": "すみません、配信の紹介をしていたところでした。した"}, {"type": "subtitle", "time": 2287.75, "timestamp": "00:38:07", "text": "自己紹介をしています。"}, {"type": "subtitle", "time": 2299.27, "timestamp": "00:38:19", "text": "ああ、それは意地悪だ。ああ、わかった。ごめん。"}, {"type": "subtitle", "time": 2302.15, "timestamp": "00:38:22", "text": "よし。こんにちは、私はZ no Natterです。"}, {"type": "subtitle", "time": 2304.39, "timestamp": "00:38:24", "text": "若音とこれに関するインド人ユーチューバー"}, {"type": "subtitle", "time": 2306.95, "timestamp": "00:38:26", "text": "私はジョーと電話をしたのですが、"}, {"type": "subtitle", "time": 2310.349, "timestamp": "00:38:30", "text": "そして、これが私の最初のコラボです"}, {"type": "subtitle", "time": 2312.87, "timestamp": "00:38:32", "text": "ドジャスイとナツキ。そうですね、"}, {"type": "subtitle", "time": 2316.47, "timestamp": "00:38:36", "text": "どうなるか見てみましょう。私は興奮しています。"}, {"type": "subtitle", "time": 2318.39, "timestamp": "00:38:38", "text": "うん。"}, {"type": "subtitle", "time": 2320.069, "timestamp": "00:38:40", "text": "こんにちは。"}, {"type": "subtitle", "time": 2322.55, "timestamp": "00:38:42", "text": "はい。はい。こんにちは、みんな。私の名前はソーです"}, {"type": "subtitle", "time": 2325.43, "timestamp": "00:38:45", "text": "ジャズ。私はストリーマーで、ゲームをするのが好きです"}, {"type": "subtitle", "time": 2327.99, "timestamp": "00:38:47", "text": "ビデオゲーム、そして、疲れすぎて"}, {"type": "subtitle", "time": 2329.99, "timestamp": "00:38:49", "text": "自己紹介を続けてください。だからもし"}, {"type": "subtitle", "time": 2331.349, "timestamp": "00:38:51", "text": "他の誰かが私を説明できる、"}, {"type": "subtitle", "time": 2334.49, "timestamp": "00:38:54", "text": "とてもいいですね。"}, {"type": "subtitle", "time": 2336.67, "timestamp": "00:38:56", "text": "[音楽]"}, {"type": "subtitle", "time": 2339.19, "timestamp": "00:38:59", "text": "だから、彼を表現する言葉は何もない。さあ"}]
[{"type": "subtitle", "time": 5463.03, "timestamp": "01:31:03", "text": "わかった、殺したければ殺してもいいよ。"}, {"type": "subtitle", "time": 5467.51, "timestamp": "01:31:07", "text": "ああ、神様。何てことだ。彼がそこにいる。"}, {"type": "subtitle", "time": 5469.43, "timestamp": "01:31:09", "text": "敗者たち。"}, {"type": "subtitle", "time": 5477.35, "timestamp": "01:31:17", "text": "いいえ、理解しないでください。それを取りに行って。行く"}, {"type": "subtitle", "time": 5479.81, "timestamp": "01:31:19", "text": "戻る。はい。ああ、神様。"}, {"type": "subtitle", "time": 5482.31, "timestamp": "01:31:22", "text": "[音楽]"}, {"type": "subtitle", "time": 5484.07, "timestamp": "01:31:24", "text": "そうそう。何も起こっていない。これは"}, {"type": "subtitle", "time": 5486.39, "timestamp": "01:31:26", "text": "私に何が起こったのか。あなたは"}, {"type": "subtitle", "time": 5487.83, "timestamp": "01:31:27", "text": "いや、いや、いや、いや。選ぶべき"}, {"type": "subtitle", "time": 5491.11, "timestamp": "01:31:31", "text": "今の私たち。"}, {"type": "subtitle", "time": 5493.189, "timestamp": "01:31:33", "text": "ああ、それはとんでもなく失礼なことだ。"}, {"type": "subtitle", "time": 5495.83, "timestamp": "01:31:35", "text": "なんてこった。何てことだ。"}, {"type": "subtitle", "time": 5500.149, "timestamp": "01:31:40", "text": "おお。わかった。彼は何をしているのですか？"}, {"type": "subtitle", "time": 5501.59, "timestamp": "01:31:41", "text": "彼こそが王冠を手にするべきだ。彼は"}, {"type": "subtitle", "time": 5504.229, "timestamp": "01:31:44", "text": "王冠を勝ち取るのであって、何かを落とすのではない。何"}, {"type": "subtitle", "time": 5507.75, "timestamp": "01:31:47", "text": "彼は何をしているの？どうすれば勝てますか？彼の日。おお、"}, {"type": "subtitle", "time": 5510.87, "timestamp": "01:31:50", "text": "よし、これでいい。おお。よし、これでいい。そこで私たちは"}]
[{"type": "subtitle", "time": 8880.15, "timestamp": "02:28:00", "text": "神。うん。今になって気づいたのですが、"}, {"type": "subtitle", "time": 8882.389, "timestamp": "02:28:02", "text": "アルメンは忘れている"}, {"type": "subtitle", "time": 8884.389, "timestamp": "02:28:04", "text": "アルメンはいつも暗唱しているようだった"}, {"type": "subtitle", "time": 8887.59, "timestamp": "02:28:07", "text": "物語ですよね？アルメンはマサの詩を朗読していた"}, {"type": "subtitle", "time": 8890.79, "timestamp": "02:28:10", "text": "エリンの視点からの物語。"}, {"type": "subtitle", "time": 8894.51, "timestamp": "02:28:14", "text": "つまり、彼は"}, {"type": "subtitle", "time": 8897.349, "timestamp": "02:28:17", "text": "エリンの目の色を忘れてしまった。色を塗る"}, {"type": "subtitle", "time": 8900.63, "timestamp": "02:28:20", "text": "季節。ええ、だから回転していたんです"}, {"type": "subtitle", "time": 8903.03, "timestamp": "02:28:23", "text": "茶色から緑色へ。茶色から緑色へ。おお、"}, {"type": "subtitle", "time": 8907.349, "timestamp": "02:28:27", "text": "くそ、兄弟。おお。うん。私は進撃の巨人オタクです。"}, {"type": "subtitle", "time": 8910.55, "timestamp": "02:28:30", "text": "ごめん。いや、いや、いや。もちろん。見る？いいえ、"}, {"type": "subtitle", "time": 8912.07, "timestamp": "02:28:32", "text": "いいえ。同じ。同じ。なぜならそれは"}, {"type": "subtitle", "time": 8913.67, "timestamp": "02:28:33", "text": "あなたがそう言った理由、私は気づいた"}, {"type": "subtitle", "time": 8916.15, "timestamp": "02:28:36", "text": "それ。まるでフラッシュバックのようだった。"}, {"type": "subtitle", "time": 8919.03, "timestamp": "02:28:39", "text": "それは何だったのか？"}, {"type": "subtitle", "time": 8921.11, "timestamp": "02:28:41", "text": "ああ、アタックは間違いなく間違いなく"}, {"type": "subtitle", "time": 8923.349, "timestamp": "02:28:43", "text": "私にとって子供時代のこと。そしてそれは"}, {"type": "subtitle", "time": 8928.15, "timestamp": "02:28:48", "text": "これは間違いなく私にぴったりです。ああ、なんてこった。"}, {"type": "subtitle", "time": 8931.27, "timestamp": "02:28:51", "text": "アニメに関しては、それはただ壮大で、"}, {"type": "subtitle", "time": 8933.27, "timestamp": "02:28:53", "text": "壮大、壮大。私は話すのが大好きです"}, {"type": "subtitle", "time": 8935.11, "timestamp": "02:28:55", "text": "アニメ。何時間でも話せる"}, {"type": "subtitle", "time": 8937.51, "timestamp": "02:28:57", "text": "アニメ。それはとても多くのことです。私たちはただ"}, {"type": "subtitle", "time": 8939.99, "timestamp": "02:28:59", "text": "アニメ配信。そうすべきだ。私たちは"}]
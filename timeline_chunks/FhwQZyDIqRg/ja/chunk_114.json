[{"type": "subtitle", "time": 6840.55, "timestamp": "01:54:00", "text": "小指が入った"}, {"type": "subtitle", "time": 6843.27, "timestamp": "01:54:03", "text": "延長ソケットか何か。おお。そして"}, {"type": "subtitle", "time": 6851.35, "timestamp": "01:54:11", "text": "以上だった。以上だった。脳みそがない"}, {"type": "subtitle", "time": 6854.07, "timestamp": "01:54:14", "text": "ダメージ。約束します。ええ、もちろんです。うん。私"}, {"type": "subtitle", "time": 6855.91, "timestamp": "01:54:15", "text": "つまり、当然のことながら、あなたはまだ生きているということです。"}, {"type": "subtitle", "time": 6858.229, "timestamp": "01:54:18", "text": "すべて正常に機能しています。これらは何ですか"}, {"type": "subtitle", "time": 6863.91, "timestamp": "01:54:23", "text": "あのね？彼らに"}, {"type": "subtitle", "time": 6866.39, "timestamp": "01:54:26", "text": "もう少し急いでください。私たちは購入していますか？"}, {"type": "subtitle", "time": 6868.06, "timestamp": "01:54:28", "text": "これら？"}, {"type": "subtitle", "time": 6869.35, "timestamp": "01:54:29", "text": "[音楽]"}, {"type": "subtitle", "time": 6871.99, "timestamp": "01:54:31", "text": "これらは私たちが購入した商品ですか？わからない。"}, {"type": "subtitle", "time": 6874.149, "timestamp": "01:54:34", "text": "私たちはそれらを購入しました。"}, {"type": "subtitle", "time": 6886.229, "timestamp": "01:54:46", "text": "みんな、みんな、みんな。えっと、ホールドして"}, {"type": "subtitle", "time": 6887.99, "timestamp": "01:54:47", "text": "衛生兵。"}, {"type": "subtitle", "time": 6891.03, "timestamp": "01:54:51", "text": "はい。待って。スパムを送ってください。ああ、ゼノは"}, {"type": "subtitle", "time": 6892.31, "timestamp": "01:54:52", "text": "準備ができていません。私はやっていません。あなたはそうしなかった"}, {"type": "subtitle", "time": 6894.55, "timestamp": "01:54:54", "text": "教えて。ええ、私は準備ができていませんでした。私は"}, {"type": "subtitle", "time": 6896.07, "timestamp": "01:54:56", "text": "君たちがやってくれるのを待っているよ。そして、"}, {"type": "subtitle", "time": 6898.47, "timestamp": "01:54:58", "text": "君たちは準備万端だった、私はすでにそう聞いていた"}]
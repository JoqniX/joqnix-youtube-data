[{"type": "subtitle", "time": 12000.55, "timestamp": "03:20:00", "text": "私のチャットがめちゃくちゃだ。だから今は"}, {"type": "subtitle", "time": 12003.63, "timestamp": "03:20:03", "text": "まさに私の女王様"}, {"type": "subtitle", "time": 12007.83, "timestamp": "03:20:07", "text": "画面。ええ、そうですね。わかった。えっと、私は"}, {"type": "subtitle", "time": 12012.63, "timestamp": "03:20:12", "text": "今週は休みの日があってもいいくらいだ。だから私は"}, {"type": "subtitle", "time": 12015.91, "timestamp": "03:20:15", "text": "ストリームを設定して"}, {"type": "subtitle", "time": 12022.309, "timestamp": "03:20:22", "text": "これ。ほら、虚無みたいに、"}, {"type": "subtitle", "time": 12025.429, "timestamp": "03:20:25", "text": "文字通りただチャットするだけで、"}, {"type": "subtitle", "time": 12029.59, "timestamp": "03:20:29", "text": "背景、もしくはああ、そうそう。だから、あなたは"}, {"type": "subtitle", "time": 12033.19, "timestamp": "03:20:33", "text": "今すぐあなたの明白な設定をしてください。うん。私 私"}, {"type": "subtitle", "time": 12042.469, "timestamp": "03:20:42", "text": "私はストリームと呼んだ。それはストリームと呼ばれるものですか？"}, {"type": "subtitle", "time": 12044.87, "timestamp": "03:20:44", "text": "ストリーム要素？ええ、どうすればいいのかわかりません"}, {"type": "subtitle", "time": 12047.99, "timestamp": "03:20:47", "text": "設定するには。ええ、教えてください。病気"}, {"type": "subtitle", "time": 12050.95, "timestamp": "03:20:50", "text": "お手伝いします。手伝いますよ。うん。うん。の"}, {"type": "subtitle", "time": 12054.87, "timestamp": "03:20:54", "text": "問題は、私はすべて持っていたが、いくつか"}]
[{"type": "subtitle", "time": 12243.19, "timestamp": "03:24:03", "text": "2ゴールに対する愛はどうですか？"}, {"type": "subtitle", "time": 12244.19, "timestamp": "03:24:04", "text": "のために"}, {"type": "subtitle", "time": 12248.51, "timestamp": "03:24:08", "text": "えっと、36です。"}, {"type": "subtitle", "time": 12253.51, "timestamp": "03:24:13", "text": "うん。何？ 36パーセント。 36. あ、待って。"}, {"type": "subtitle", "time": 12256.469, "timestamp": "03:24:16", "text": "待って。 10時だった。待って。わかった。 10～36歳。"}, {"type": "subtitle", "time": 12259.269, "timestamp": "03:24:19", "text": "うん。はい。うん。うん。大丈夫です。仕事"}, {"type": "subtitle", "time": 12263.229, "timestamp": "03:24:23", "text": "人々。運動選手たち。人々は"}, {"type": "subtitle", "time": 12266.349, "timestamp": "03:24:26", "text": "嫌い"}, {"type": "subtitle", "time": 12269.429, "timestamp": "03:24:29", "text": "甘い。それは素敵ですね。"}, {"type": "subtitle", "time": 12274.309, "timestamp": "03:24:34", "text": "待って、仕事はできる仕事はできる仕事はできない人々はできない"}, {"type": "subtitle", "time": 12281.95, "timestamp": "03:24:41", "text": "そうそう。私は尋ねたかった"}, {"type": "subtitle", "time": 12291.67, "timestamp": "03:24:51", "text": "えっと、あなたが聞こえなかったからここに来たんです"}, {"type": "subtitle", "time": 12293.9, "timestamp": "03:24:53", "text": "ストリーム。待って、"}, {"type": "subtitle", "time": 12296.91, "timestamp": "03:24:56", "text": "[音楽]"}, {"type": "subtitle", "time": 12299.229, "timestamp": "03:24:59", "text": "何？"}]
[{"type": "subtitle", "time": 8160.55, "timestamp": "02:16:00", "text": "アニメのようなものを提案します。それはただ"}, {"type": "subtitle", "time": 8163.589, "timestamp": "02:16:03", "text": "まったく新しい世界。その通り。私は生き延びた。"}, {"type": "subtitle", "time": 8165.43, "timestamp": "02:16:05", "text": "嘘をつくつもりはないが、"}, {"type": "subtitle", "time": 8167.589, "timestamp": "02:16:07", "text": "文字通り、アニメのおかげで生きている。"}, {"type": "subtitle", "time": 8169.43, "timestamp": "02:16:09", "text": "落ち込むことはよくある"}, {"type": "subtitle", "time": 8171.35, "timestamp": "02:16:11", "text": "そして実際、私はやり方がわからない"}, {"type": "subtitle", "time": 8174.069, "timestamp": "02:16:14", "text": "人々を説得して理解させる"}, {"type": "subtitle", "time": 8176.709, "timestamp": "02:16:16", "text": "アニメが本当に"}, {"type": "subtitle", "time": 8180.229, "timestamp": "02:16:20", "text": "私の命を救ってください。それは本当です。つまり"}, {"type": "subtitle", "time": 8182.95, "timestamp": "02:16:22", "text": "私が本当に言えることは"}, {"type": "subtitle", "time": 8184.75, "timestamp": "02:16:24", "text": "それは"}, {"type": "subtitle", "time": 8188.87, "timestamp": "02:16:28", "text": "AOT。うーん、説得するのはちょっと難しいですね。"}, {"type": "subtitle", "time": 8190.79, "timestamp": "02:16:30", "text": "人々に納得させるのは少し難しい"}, {"type": "subtitle", "time": 8193.429, "timestamp": "02:16:33", "text": "メディア作品が影響力を持つのと同じように"}, {"type": "subtitle", "time": 8196.309, "timestamp": "02:16:36", "text": "あなた次第です。"}, {"type": "subtitle", "time": 8198.469, "timestamp": "02:16:38", "text": "それをあなた自身が認識し、他の誰にも認識させないでください"}, {"type": "subtitle", "time": 8201.669, "timestamp": "02:16:41", "text": "それは理解できます。右。その通り。による"}, {"type": "subtitle", "time": 8204.07, "timestamp": "02:16:44", "text": "みんな、私はちょうど食べていたところだった"}, {"type": "subtitle", "time": 8205.99, "timestamp": "02:16:45", "text": "手を洗って、今すぐ行く。"}, {"type": "subtitle", "time": 8208.27, "timestamp": "02:16:48", "text": "いいえ、どうぞ。どうぞ。"}, {"type": "subtitle", "time": 8211.83, "timestamp": "02:16:51", "text": "わかった。わかった。あ、そういえば、私は"}, {"type": "subtitle", "time": 8215.19, "timestamp": "02:16:55", "text": "音楽について話す。はい。はい。はい。私の"}, {"type": "subtitle", "time": 8218.629, "timestamp": "02:16:58", "text": "好きなアニメ音楽は、えっと、"}]
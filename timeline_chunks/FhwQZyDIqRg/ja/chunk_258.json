[{"type": "subtitle", "time": 15484.07, "timestamp": "04:18:04", "text": "ああ、もしそれが優先度の高いタスクなら、"}, {"type": "subtitle", "time": 15485.55, "timestamp": "04:18:05", "text": "やり方でやる"}, {"type": "subtitle", "time": 15488.229, "timestamp": "04:18:08", "text": "予め。もしそれが、もしそれが"}, {"type": "subtitle", "time": 15490.63, "timestamp": "04:18:10", "text": "私の配信みたいなバカげたこと、いや、私は"}, {"type": "subtitle", "time": 15493.51, "timestamp": "04:18:13", "text": "配信でやるのと同じようにやるよ。"}, {"type": "subtitle", "time": 15496.55, "timestamp": "04:18:16", "text": "ましてや最後の瞬間などあり得ない。それで"}, {"type": "subtitle", "time": 15499.67, "timestamp": "04:18:19", "text": "ええ、でも私はこれらの人たちが"}, {"type": "subtitle", "time": 15501.59, "timestamp": "04:18:21", "text": "優先度の高い事柄について話している"}, {"type": "subtitle", "time": 15503.91, "timestamp": "04:18:23", "text": "勉強や試験など"}, {"type": "subtitle", "time": 15505.389, "timestamp": "04:18:25", "text": "何か。"}, {"type": "subtitle", "time": 15508.309, "timestamp": "04:18:28", "text": "だから私の優先順位の高いものは何もない"}, {"type": "subtitle", "time": 15511.99, "timestamp": "04:18:31", "text": "仕事以外の人生。しかし、"}, {"type": "subtitle", "time": 15515.269, "timestamp": "04:18:35", "text": "優先度の高いタスクが私に与えられ、"}, {"type": "subtitle", "time": 15517.67, "timestamp": "04:18:37", "text": "どう対処するつもりか。私は"}, {"type": "subtitle", "time": 15522.07, "timestamp": "04:18:42", "text": "締め切りのはるか前に対応してください。"}, {"type": "subtitle", "time": 15524.469, "timestamp": "04:18:44", "text": "締め切りのはるか前に。うん。だから私は"}, {"type": "subtitle", "time": 15526.189, "timestamp": "04:18:46", "text": "行くことにします"}, {"type": "subtitle", "time": 15529.269, "timestamp": "04:18:49", "text": "古き良きレベル３は反対する"}, {"type": "subtitle", "time": 15531.83, "timestamp": "04:18:51", "text": "なぜなら、そう、私はそれをずっと前にやるからです"}, {"type": "subtitle", "time": 15533.63, "timestamp": "04:18:53", "text": "その前に。あなた"}, {"type": "subtitle", "time": 15536.03, "timestamp": "04:18:56", "text": "楽しんでください、楽しんでください"}, {"type": "subtitle", "time": 15538.349, "timestamp": "04:18:58", "text": "倫理的な議論"}]
[{"type": "subtitle", "time": 3603.349, "timestamp": "01:00:03", "text": "ああ、気味の悪いカタツムリがいる。そこには"}, {"type": "subtitle", "time": 3605.4, "timestamp": "01:00:05", "text": "気味の悪いカタツムリ。"}, {"type": "subtitle", "time": 3607.349, "timestamp": "01:00:07", "text": "[音楽]"}, {"type": "subtitle", "time": 3608.51, "timestamp": "01:00:08", "text": "おお"}, {"type": "subtitle", "time": 3611.71, "timestamp": "01:00:11", "text": "いいえ。私は"}, {"type": "subtitle", "time": 3616.15, "timestamp": "01:00:16", "text": "死んだ。私は死んだのか？誰かが亡くなったのですか？私は"}, {"type": "subtitle", "time": 3618.71, "timestamp": "01:00:18", "text": "死んだ？ああ、なんてことだ、気味が悪い。ああ、"}, {"type": "subtitle", "time": 3622.109, "timestamp": "01:00:22", "text": "細身の男。細身の男。細身の男。"}, {"type": "subtitle", "time": 3645.27, "timestamp": "01:00:45", "text": "ああ、見て。おお、"}, {"type": "subtitle", "time": 3649.03, "timestamp": "01:00:49", "text": "ジョック。おい。はい、ジョー。私は頭が欲しかった、"}, {"type": "subtitle", "time": 3650.789, "timestamp": "01:00:50", "text": "しかし"}, {"type": "subtitle", "time": 3652.39, "timestamp": "01:00:52", "text": "誰かが言ったとき、"}, {"type": "subtitle", "time": 3653.91, "timestamp": "01:00:53", "text": "後ろにあるときは、どこにあるのかわからない"}, {"type": "subtitle", "time": 3655.19, "timestamp": "01:00:55", "text": "走って、ただ行くだけ"}, {"type": "subtitle", "time": 3658.15, "timestamp": "01:00:58", "text": "その場でしゃがみ込む。その代わり。あらら。"}]
[{"type": "subtitle", "time": 6780.79, "timestamp": "01:53:00", "text": "この手榴弾。"}, {"type": "subtitle", "time": 6784.189, "timestamp": "01:53:04", "text": "私の"}, {"type": "subtitle", "time": 6788.39, "timestamp": "01:53:08", "text": "えっと、私のものから、ほら、"}, {"type": "subtitle", "time": 6792.629, "timestamp": "01:53:12", "text": "延長ボックス。なんてこった。良い。"}, {"type": "subtitle", "time": 6797.51, "timestamp": "01:53:17", "text": "延長ボックス。どこにある"}, {"type": "subtitle", "time": 6800.709, "timestamp": "01:53:20", "text": "延長ボックス？私の拡張ボックスは"}, {"type": "subtitle", "time": 6806.31, "timestamp": "01:53:26", "text": "現実の生活。神よ、力強い閃光。プラグを差し込む"}, {"type": "subtitle", "time": 6807.83, "timestamp": "01:53:27", "text": "私のモニター。そういうことなんです、"}, {"type": "subtitle", "time": 6811.75, "timestamp": "01:53:31", "text": "右？私はモニターをまるで私が"}, {"type": "subtitle", "time": 6813.35, "timestamp": "01:53:33", "text": "ケーブル接続を締めて"}, {"type": "subtitle", "time": 6815.43, "timestamp": "01:53:35", "text": "モニターを見ると、火花が出始める。私はしません"}, {"type": "subtitle", "time": 6817.51, "timestamp": "01:53:37", "text": "何が起こっているのかを把握する。なんてこった。あなたは"}, {"type": "subtitle", "time": 6819.189, "timestamp": "01:53:39", "text": "気をつけろよ、相棒。そして特に"}, {"type": "subtitle", "time": 6822.709, "timestamp": "01:53:42", "text": "明かりが消えるので、注意してください。それ"}, {"type": "subtitle", "time": 6824.47, "timestamp": "01:53:44", "text": "それは本当です。以前、感電したことがある"}, {"type": "subtitle", "time": 6827.75, "timestamp": "01:53:47", "text": "Xbox 360を接続するため。"}, {"type": "subtitle", "time": 6830.95, "timestamp": "01:53:50", "text": "何？うん。ああ、兄弟。本当に本当に"}, {"type": "subtitle", "time": 6832.55, "timestamp": "01:53:52", "text": "君には7つの命があると思うか、"}, {"type": "subtitle", "time": 6834.229, "timestamp": "01:53:54", "text": "何か？それが理由だと思う"}, {"type": "subtitle", "time": 6836.229, "timestamp": "01:53:56", "text": "あなたはそういう振る舞いをする。あなたは何を"}, {"type": "subtitle", "time": 6839.189, "timestamp": "01:53:59", "text": "平均？それほど悪くはなかった。それはただ私の"}]
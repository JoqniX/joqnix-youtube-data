[{"type": "subtitle", "time": 6662.87, "timestamp": "01:51:02", "text": "私自身のために。起き上がってEキーを連打するんだよね？"}, {"type": "subtitle", "time": 6665.99, "timestamp": "01:51:05", "text": "うん。はい、すぐに。私たちが立ち去るとすぐに。"}, {"type": "subtitle", "time": 6667.669, "timestamp": "01:51:07", "text": "メッセージを書き終えるとすぐに"}, {"type": "subtitle", "time": 6669.75, "timestamp": "01:51:09", "text": "あれ。"}, {"type": "subtitle", "time": 6671.91, "timestamp": "01:51:11", "text": "ない。私は先手を打つ。例えば"}, {"type": "subtitle", "time": 6674.47, "timestamp": "01:51:14", "text": "私たちはここを去ります、あなたはスパムします"}, {"type": "subtitle", "time": 6679.189, "timestamp": "01:51:19", "text": "そこに着くまで。うん。大丈夫です。"}, {"type": "subtitle", "time": 6682.31, "timestamp": "01:51:22", "text": "私たちもいくつか買ってみようか？でも、気にしないで。私たちは"}, {"type": "subtitle", "time": 6684.709, "timestamp": "01:51:24", "text": "4つあります。"}, {"type": "subtitle", "time": 6686.39, "timestamp": "01:51:26", "text": "28個は買わないでください。それは"}, {"type": "subtitle", "time": 6689.51, "timestamp": "01:51:29", "text": "本当に役に立たない。うん。前回"}, {"type": "subtitle", "time": 6691.35, "timestamp": "01:51:31", "text": "実際には彼を殺さなかったから、まあ"}, {"type": "subtitle", "time": 6694.79, "timestamp": "01:51:34", "text": "無意味だ。つまり、前回は"}, {"type": "subtitle", "time": 6697.669, "timestamp": "01:51:37", "text": "走り抜けて、その部分は本当に"}, {"type": "subtitle", "time": 6700.149, "timestamp": "01:51:40", "text": "動作が遅いので、あまり役に立たない。わかった、私に"}, {"type": "subtitle", "time": 6701.91, "timestamp": "01:51:41", "text": "ちょっと待って、みんな。充電する必要がある"}, {"type": "subtitle", "time": 6704.629, "timestamp": "01:51:44", "text": "電話。"}, {"type": "subtitle", "time": 6708.79, "timestamp": "01:51:48", "text": "諦めろ。電話。もう諦めろ。"}, {"type": "subtitle", "time": 6710.27, "timestamp": "01:51:50", "text": "ああ、あるべきだ"}, {"type": "subtitle", "time": 6719.43, "timestamp": "01:51:59", "text": "ところで、スタミナを買いました。"}]
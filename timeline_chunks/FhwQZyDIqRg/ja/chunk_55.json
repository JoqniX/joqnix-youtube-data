[{"type": "subtitle", "time": 3303.15, "timestamp": "00:55:03", "text": "すごかったよ。"}, {"type": "subtitle", "time": 3307.19, "timestamp": "00:55:07", "text": "ああ、彼は走るよ。"}, {"type": "subtitle", "time": 3308.27, "timestamp": "00:55:08", "text": "良い、"}, {"type": "subtitle", "time": 3313.03, "timestamp": "00:55:13", "text": "こんにちは。元気かい？ゲームオーバー。これは"}, {"type": "subtitle", "time": 3314.79, "timestamp": "00:55:14", "text": "アリーナ。"}, {"type": "subtitle", "time": 3318.309, "timestamp": "00:55:18", "text": "ザンは悲しんでいる。血が私たちを嘲笑っている。おお、"}, {"type": "subtitle", "time": 3320.79, "timestamp": "00:55:20", "text": "これです。ああ、これだ。これは大嫌いだ。"}, {"type": "subtitle", "time": 3322.63, "timestamp": "00:55:22", "text": "これは何ですか？これは何ですか？つまり、あなたは"}, {"type": "subtitle", "time": 3324.47, "timestamp": "00:55:24", "text": "拾って"}, {"type": "subtitle", "time": 3327.589, "timestamp": "00:55:27", "text": "反対して、戦って、始める。私はしません"}, {"type": "subtitle", "time": 3329.99, "timestamp": "00:55:29", "text": "やり方がわからない。本当にごめんなさい。ごめんなさい"}, {"type": "subtitle", "time": 3332.23, "timestamp": "00:55:32", "text": "もし"}, {"type": "subtitle", "time": 3334.549, "timestamp": "00:55:34", "text": "私はこの瞬間が大好きだ。"}, {"type": "subtitle", "time": 3337.829, "timestamp": "00:55:37", "text": "ああ、くそ。"}, {"type": "subtitle", "time": 3340.87, "timestamp": "00:55:40", "text": "くたばれ。もちろんさ。どこにいるの？"}, {"type": "subtitle", "time": 3344.47, "timestamp": "00:55:44", "text": "シュレックを手に入れろ。シュレックを手に入れろ。シュレックを手に入れろ。あなたがやる"}, {"type": "subtitle", "time": 3356.95, "timestamp": "00:55:56", "text": "[音楽]"}, {"type": "subtitle", "time": 3357.71, "timestamp": "00:55:57", "text": "見て"}]
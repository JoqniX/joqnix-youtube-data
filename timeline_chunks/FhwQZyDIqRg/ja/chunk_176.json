[{"type": "subtitle", "time": 10562.55, "timestamp": "02:56:02", "text": "なぜそんな風に歌うの？"}, {"type": "subtitle", "time": 10566.63, "timestamp": "02:56:06", "text": "ライオンキングの合唱団のことですか？"}, {"type": "subtitle", "time": 10575.23, "timestamp": "02:56:15", "text": "おお"}, {"type": "subtitle", "time": 10577.15, "timestamp": "02:56:17", "text": "シュート。"}, {"type": "subtitle", "time": 10589.429, "timestamp": "02:56:29", "text": "ああ、違う、トミーだ。くそ、兄弟。それは"}, {"type": "subtitle", "time": 10591.59, "timestamp": "02:56:31", "text": "それが私たちが行ける最長期間だった。いいね、兄弟。"}, {"type": "subtitle", "time": 10593.95, "timestamp": "02:56:33", "text": "実際、私は自分のことをかなり誇りに思っています。"}, {"type": "subtitle", "time": 10596.71, "timestamp": "02:56:36", "text": "今日。それは、なんてことだ。ちょっと待って、みんな。"}, {"type": "subtitle", "time": 10598.55, "timestamp": "02:56:38", "text": "それはレーザーです。彼らはどうやって"}, {"type": "subtitle", "time": 10600.75, "timestamp": "02:56:40", "text": "彼らと一緒にいて安全ですか？ああ、"}, {"type": "subtitle", "time": 10604.15, "timestamp": "02:56:44", "text": "神。それは彼らを見つけられなかった。ああ、彼女は死んでしまった。"}, {"type": "subtitle", "time": 10605.51, "timestamp": "02:56:45", "text": "彼らは死んだ。彼らは死んだ。彼らは"}, {"type": "subtitle", "time": 10607.91, "timestamp": "02:56:47", "text": "死んだ。彼らは死んだ。やべぇ、兄弟。私たちは皆"}, {"type": "subtitle", "time": 10611.91, "timestamp": "02:56:51", "text": "死んだ。おお。あなたはなぜベッドに入ったのですか？"}, {"type": "subtitle", "time": 10613.83, "timestamp": "02:56:53", "text": "なんてこった？"}, {"type": "subtitle", "time": 10615.91, "timestamp": "02:56:55", "text": "なぜ？"}, {"type": "subtitle", "time": 10617.91, "timestamp": "02:56:57", "text": "私は柱の後ろに隠れていました。私"}, {"type": "subtitle", "time": 10619.91, "timestamp": "02:56:59", "text": "柱の後ろに隠れていて、"}]
[{"type": "subtitle", "time": 6421.43, "timestamp": "01:47:01", "text": "私はヒンディー語を知っているかどうか。私の肩書きには「はい」と書いてあります。"}, {"type": "subtitle", "time": 6425.27, "timestamp": "01:47:05", "text": "つまり、私は文字通りインヴェイナリーが言うように"}, {"type": "subtitle", "time": 6427.669, "timestamp": "01:47:07", "text": "まさにそこです。うん。ああ、やっとだ。だった"}, {"type": "subtitle", "time": 6429.03, "timestamp": "01:47:09", "text": "再び生きる。私たちは生きるために戻ってきた。"}, {"type": "subtitle", "time": 6431.83, "timestamp": "01:47:11", "text": "おかえり。おかえり。わーい。おい、"}, {"type": "subtitle", "time": 6434.31, "timestamp": "01:47:14", "text": "さあ、トラックに行きましょう。行きましょう"}, {"type": "subtitle", "time": 6436.149, "timestamp": "01:47:16", "text": "トラック。罠だ。いいえ、ありません"}, {"type": "subtitle", "time": 6437.91, "timestamp": "01:47:17", "text": "に。持ってこなくていいよ"}, {"type": "subtitle", "time": 6440.229, "timestamp": "01:47:20", "text": "ええ、それを持っていく必要はありません。"}, {"type": "subtitle", "time": 6444.149, "timestamp": "01:47:24", "text": "ああ、終わったよ。ああ、どうぞ。探しに行こう"}, {"type": "subtitle", "time": 6450.189, "timestamp": "01:47:30", "text": "神。生き残る、"}, {"type": "subtitle", "time": 6453.4, "timestamp": "01:47:33", "text": "みんな。私はあなたのことを覚えています。"}]
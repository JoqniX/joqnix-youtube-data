[{"type": "subtitle", "time": 13980.469, "timestamp": "03:53:00", "text": "2日から4日かかるだけです。あなたは"}, {"type": "subtitle", "time": 13982.55, "timestamp": "03:53:02", "text": "週に3日くらいかかる。そうではありません"}, {"type": "subtitle", "time": 13984.55, "timestamp": "03:53:04", "text": "良い。それはあなたの評判にとって良くない。"}, {"type": "subtitle", "time": 13986.79, "timestamp": "03:53:06", "text": "君はそれをものすごい速さで落としているよ。私はしません"}, {"type": "subtitle", "time": 13989.189, "timestamp": "03:53:09", "text": "自分の英語をどう活用すれば良いかを知ること。あなた"}, {"type": "subtitle", "time": 13993.03, "timestamp": "03:53:13", "text": "ジャックさん、私の言いたいことがお分かりいただけましたか？はい。"}, {"type": "subtitle", "time": 13997.11, "timestamp": "03:53:17", "text": "はい。あなたはただ彼らに任せることができます"}, {"type": "subtitle", "time": 13999.269, "timestamp": "03:53:19", "text": "彼らが感じているから"}, {"type": "subtitle", "time": 14001.269, "timestamp": "03:53:21", "text": "悪いからといって、彼らが一日休みを取れるわけではない"}, {"type": "subtitle", "time": 14003.429, "timestamp": "03:53:23", "text": "いつも。彼らは一日休みを取ることができる"}, {"type": "subtitle", "time": 14006.79, "timestamp": "03:53:26", "text": "しかし、やりすぎは禁物だ。だからそれは"}, {"type": "subtitle", "time": 14008.87, "timestamp": "03:53:28", "text": "事実だけではないと感じる人々"}, {"type": "subtitle", "time": 14012.63, "timestamp": "03:53:32", "text": "そして論理的には両方とも"}, {"type": "subtitle", "time": 14015.189, "timestamp": "03:53:35", "text": "分かりますか。これはとても愚かなことです"}, {"type": "subtitle", "time": 14016.87, "timestamp": "03:53:36", "text": "質問。どうすればいいのかわからない"}, {"type": "subtitle", "time": 14020.63, "timestamp": "03:53:40", "text": "それ。真ん中の真ん中の物を置いてもいいですよ。"}, {"type": "subtitle", "time": 14022.63, "timestamp": "03:53:42", "text": "問題は、これは"}, {"type": "subtitle", "time": 14024.55, "timestamp": "03:53:44", "text": "的を絞った質問。私には向いていない"}, {"type": "subtitle", "time": 14027.99, "timestamp": "03:53:47", "text": "なぜなら、私に聞いてください、人々は"}, {"type": "subtitle", "time": 14030.229, "timestamp": "03:53:50", "text": "それはとても奇妙です"}, {"type": "subtitle", "time": 14032.07, "timestamp": "03:53:52", "text": "若者からの質問。これはとても"}, {"type": "subtitle", "time": 14034.63, "timestamp": "03:53:54", "text": "若者からの質問。あなたには"}, {"type": "subtitle", "time": 14036.95, "timestamp": "03:53:56", "text": "事実と論理だけなのか、それとも"}, {"type": "subtitle", "time": 14039.03, "timestamp": "03:53:59", "text": "感情的、これはとても若い"}]
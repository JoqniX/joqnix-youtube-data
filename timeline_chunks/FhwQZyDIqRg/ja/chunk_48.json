[{"type": "subtitle", "time": 2893.47, "timestamp": "00:48:13", "text": "こんにちは。"}, {"type": "subtitle", "time": 2898.87, "timestamp": "00:48:18", "text": "愛 なぜ彼はここにいるの？"}, {"type": "subtitle", "time": 2901.51, "timestamp": "00:48:21", "text": "もう一度彼を殺せ。あなたは行くことができます"}, {"type": "subtitle", "time": 2903.51, "timestamp": "00:48:23", "text": "私のために自分を犠牲にしてくれ。私はあなたを知っています。"}, {"type": "subtitle", "time": 2906.79, "timestamp": "00:48:26", "text": "そうしたい。あなたは本当に素晴らしいヒーローだよ。"}, {"type": "subtitle", "time": 2914.069, "timestamp": "00:48:34", "text": "あいつ、マジで俺をじっと見てる。その"}, {"type": "subtitle", "time": 2919.03, "timestamp": "00:48:39", "text": "私をじっと見つめている。なぜ治らないのか？"}, {"type": "subtitle", "time": 2922.87, "timestamp": "00:48:42", "text": "彼は文字通り私を見つめている、"}, {"type": "subtitle", "time": 2926.23, "timestamp": "00:48:46", "text": "男の子。さっさと戻ってこい。よお、どこに"}, {"type": "subtitle", "time": 2928.15, "timestamp": "00:48:48", "text": "ゾーはどこにいますか？"}, {"type": "subtitle", "time": 2931.15, "timestamp": "00:48:51", "text": "彼は死んだんだよ、兄弟。なぜそうではないのか"}, {"type": "subtitle", "time": 2934.51, "timestamp": "00:48:54", "text": "ヒーリング？それは"}, {"type": "subtitle", "time": 2937.75, "timestamp": "00:48:57", "text": "蘇生する。なぜ治らないのか？なぜ"}]
[{"type": "subtitle", "time": 3197.19, "timestamp": "00:53:17", "text": "彼らはそうではなく、別の方法であなたを殺すでしょう。彼は"}, {"type": "subtitle", "time": 3199.829, "timestamp": "00:53:19", "text": "文字通り私の目の前に。何回"}, {"type": "subtitle", "time": 3202.15, "timestamp": "00:53:22", "text": "私は今、死んだのだろうか？つまり、私はこう思う"}, {"type": "subtitle", "time": 3204.71, "timestamp": "00:53:24", "text": "10分経過して3回。"}, {"type": "subtitle", "time": 3207.91, "timestamp": "00:53:27", "text": "彼をあなたから遠ざけましょうか？"}, {"type": "subtitle", "time": 3210.069, "timestamp": "00:53:30", "text": "いいえ、それはゲームを始めるのに最適な方法です。"}, {"type": "subtitle", "time": 3211.75, "timestamp": "00:53:31", "text": "あなたが知っている。"}, {"type": "subtitle", "time": 3213.99, "timestamp": "00:53:33", "text": "それはまだそこにある。それは消え去らないだろう。おお。"}, {"type": "subtitle", "time": 3217.67, "timestamp": "00:53:37", "text": "おお。おお。何てことだ。"}, {"type": "subtitle", "time": 3220.549, "timestamp": "00:53:40", "text": "私には暗すぎる。うん。それは"}, {"type": "subtitle", "time": 3223.589, "timestamp": "00:53:43", "text": "みんな。どういう意味ですか？"}, {"type": "subtitle", "time": 3227.75, "timestamp": "00:53:47", "text": "ああ、それはもうなくなってしまったと思う。"}, {"type": "subtitle", "time": 3229.109, "timestamp": "00:53:49", "text": "はい、大丈夫です。私たちは大丈夫です。だった"}, {"type": "subtitle", "time": 3231.589, "timestamp": "00:53:51", "text": "良い。ああ、もうなくなってしまった。彼らはもう行っていい。"}, {"type": "subtitle", "time": 3234.549, "timestamp": "00:53:54", "text": "南へ行けよ、兄弟。うん、たぶん"}, {"type": "subtitle", "time": 3238.589, "timestamp": "00:53:58", "text": "冗談みたいだ。ええ、彼はただ"}]
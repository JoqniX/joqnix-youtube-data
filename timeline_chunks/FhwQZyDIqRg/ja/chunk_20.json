[{"type": "subtitle", "time": 1200.59, "timestamp": "00:20:00", "text": "特別な、心温まる贈り物。"}, {"type": "subtitle", "time": 1203.59, "timestamp": "00:20:03", "text": "心温まる本当に難しい"}, {"type": "subtitle", "time": 1208.63, "timestamp": "00:20:08", "text": "言葉で言うと、まるでついに"}, {"type": "subtitle", "time": 1210.669, "timestamp": "00:20:10", "text": "本当に"}, {"type": "subtitle", "time": 1224.73, "timestamp": "00:20:24", "text": "感謝しているが、私は"}, {"type": "subtitle", "time": 1227.31, "timestamp": "00:20:27", "text": "[音楽]"}, {"type": "subtitle", "time": 1243.47, "timestamp": "00:20:43", "text": "特別なハン"}, {"type": "subtitle", "time": 1247.83, "timestamp": "00:20:47", "text": "特別なコンセプトアート神よ私はああ神よ"}, {"type": "subtitle", "time": 1252.71, "timestamp": "00:20:52", "text": "たくさん閉じる、こんにちは、えっと、こんにちは、私が"}, {"type": "subtitle", "time": 1255.59, "timestamp": "00:20:55", "text": "コンセプトアートと呼んでいるのは、実際には"}, {"type": "subtitle", "time": 1258.39, "timestamp": "00:20:58", "text": "正式にこれを男性にする"}]
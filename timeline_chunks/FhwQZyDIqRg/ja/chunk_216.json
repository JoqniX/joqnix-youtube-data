[{"type": "subtitle", "time": 12960.91, "timestamp": "03:36:00", "text": "うん。なぜ私がそうする必要があるのですか？"}, {"type": "subtitle", "time": 12964.79, "timestamp": "03:36:04", "text": "法的には私は"}, {"type": "subtitle", "time": 12968.63, "timestamp": "03:36:08", "text": "ええ、私はとてもええ。あのね？私 私"}, {"type": "subtitle", "time": 12970.229, "timestamp": "03:36:10", "text": "まあ、同意する。"}, {"type": "subtitle", "time": 12971.95, "timestamp": "03:36:11", "text": "最初"}, {"type": "subtitle", "time": 12974.95, "timestamp": "03:36:14", "text": "ドット。最初の点として、私は新しい友達を作ります。"}, {"type": "subtitle", "time": 12978.15, "timestamp": "03:36:18", "text": "私はそうではないし、積極的に行くわけでもない"}, {"type": "subtitle", "time": 12981.75, "timestamp": "03:36:21", "text": "制作を中心に。そう、もし彼らが"}, {"type": "subtitle", "time": 12984.15, "timestamp": "03:36:24", "text": "彼らがその立場を取ったら、私は"}, {"type": "subtitle", "time": 12985.389, "timestamp": "03:36:25", "text": "作る"}, {"type": "subtitle", "time": 12995.83, "timestamp": "03:36:35", "text": "持っていると彼らはイエスと言い、ノーと言う。"}, {"type": "subtitle", "time": 12997.15, "timestamp": "03:36:37", "text": "私は違います"}, {"type": "subtitle", "time": 13001.269, "timestamp": "03:36:41", "text": "興味がある。そうですね、まあそうですね"}, {"type": "subtitle", "time": 13004.309, "timestamp": "03:36:44", "text": "最初の円は緑色で、あなたは"}, {"type": "subtitle", "time": 13007.469, "timestamp": "03:36:47", "text": "定期的に新しい人を作る"}, {"type": "subtitle", "time": 13011.95, "timestamp": "03:36:51", "text": "複雑で斬新なアイデアはワクワクする"}, {"type": "subtitle", "time": 13014.91, "timestamp": "03:36:54", "text": "あなたがすべき"}, {"type": "subtitle", "time": 13018.67, "timestamp": "03:36:58", "text": "同意しません。複雑な仕事は好きではありません。"}]
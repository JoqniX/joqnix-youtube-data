[{"type": "subtitle", "time": 197.67000000000002, "timestamp": "00:03:17", "text": "ああ、わかった。えっと、私は食べに行きます"}, {"type": "subtitle", "time": 199.91, "timestamp": "00:03:19", "text": "夕食。 Vを見てて。すぐ戻ってくるよ。"}, {"type": "subtitle", "time": 202.79, "timestamp": "00:03:22", "text": "３つ数えて、３、２、１。また戻ってきます。"}, {"type": "subtitle", "time": 205.27, "timestamp": "00:03:25", "text": "えっと、10分。わかった。 Vを見てください。私は"}, {"type": "subtitle", "time": 208.19, "timestamp": "00:03:28", "text": "戻る。わかった。楽しむ。バイバイ。"}, {"type": "subtitle", "time": 211.35, "timestamp": "00:03:31", "text": "バイバイ。ああ、走らなきゃ。私は"}, {"type": "subtitle", "time": 216.27, "timestamp": "00:03:36", "text": "走る。なあ、なんで俺はこんなに混乱してるんだ？"}, {"type": "subtitle", "time": 220.309, "timestamp": "00:03:40", "text": "遅い。わーい。ああ、君はそばにいるね。これは"}, {"type": "subtitle", "time": 223.149, "timestamp": "00:03:43", "text": "悪い。これはまずい。これは"}, {"type": "subtitle", "time": 226.03, "timestamp": "00:03:46", "text": "悪い。では、何を楽しむのですか？何を楽しむの？楽しむ"}, {"type": "chat", "time": 233.984, "timestamp": "00:03:53", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Joq is Currently taking a break! and will be back soon! do enjoy this past memories till he is back!"}, {"type": "subtitle", "time": 238.55, "timestamp": "00:03:58", "text": "フレームに入れて、これを楽しんでいると伝える。"}]
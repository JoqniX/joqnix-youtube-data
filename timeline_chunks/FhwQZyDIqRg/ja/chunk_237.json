[{"type": "subtitle", "time": 14221.269, "timestamp": "03:57:01", "text": "あなたはうまくやっていない、あなたの問題は"}, {"type": "subtitle", "time": 14222.63, "timestamp": "03:57:02", "text": "減少している、どうすればいいのかわからない"}, {"type": "subtitle", "time": 14225.59, "timestamp": "03:57:05", "text": "あなたは大丈夫ですか、ご存知のように、それは"}, {"type": "subtitle", "time": 14228.63, "timestamp": "03:57:08", "text": "私が意地悪な時、敏感な時。こんにちは、"}, {"type": "subtitle", "time": 14231.67, "timestamp": "03:57:11", "text": "ジェリー。ストリームへようこそ。"}, {"type": "subtitle", "time": 14234.15, "timestamp": "03:57:14", "text": "嫌な奴モードに切り替えろ。ようこそ。"}, {"type": "subtitle", "time": 14237.67, "timestamp": "03:57:17", "text": "ええ、私も全く同感です。わかった。"}, {"type": "subtitle", "time": 14239.99, "timestamp": "03:57:19", "text": "あなたは実際に新しい経験を求め、"}, {"type": "subtitle", "time": 14243.229, "timestamp": "03:57:23", "text": "探求すべき知識分野。えっと、私は"}, {"type": "subtitle", "time": 14248.51, "timestamp": "03:57:28", "text": "知る。私は自分が"}, {"type": "subtitle", "time": 14252.229, "timestamp": "03:57:32", "text": "完全に覚えているか、または全体を読むのが好きです"}, {"type": "chat", "time": 14252.59, "timestamp": "03:57:32", "author": "@DinyoFoxy", "avatar": "https://yt4.ggpht.com/DGXvUKi0q0ld5Zo5CNG2tmulZfZqg_h6ivQHLtQfKyx-z_EjHr-Bx7limqyg4JtpZ00_XP_BTQ=s64-c-k-c0x00ffffff-no-rj", "message": "how are you doing ?"}, {"type": "subtitle", "time": 14255.349, "timestamp": "03:57:35", "text": "物事、私はもっと手に入れようとはしません"}, {"type": "subtitle", "time": 14258.55, "timestamp": "03:57:38", "text": "再び本を読む。私は普段はしない"}, {"type": "subtitle", "time": 14261.83, "timestamp": "03:57:41", "text": "そういったもの全て。では、私はただ行くだけです"}, {"type": "subtitle", "time": 14264.389, "timestamp": "03:57:44", "text": "同意できない。私はそうではありません。インターネットはどうですか？"}, {"type": "subtitle", "time": 14266.55, "timestamp": "03:57:46", "text": "インターネットの知識はどうでしょうか？"}, {"type": "subtitle", "time": 14269.91, "timestamp": "03:57:49", "text": "インターネット？面白いことに、答えはノーです。まるで私が"}, {"type": "subtitle", "time": 14271.99, "timestamp": "03:57:51", "text": "それらはしないでください。"}, {"type": "subtitle", "time": 14274.229, "timestamp": "03:57:54", "text": "それは、"}, {"type": "subtitle", "time": 14276.79, "timestamp": "03:57:56", "text": "OBSの設定をしていて、まだ"}, {"type": "subtitle", "time": 14278.229, "timestamp": "03:57:58", "text": "ねえ、知ってる？私はしない"}]
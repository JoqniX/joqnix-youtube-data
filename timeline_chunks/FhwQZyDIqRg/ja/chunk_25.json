[{"type": "subtitle", "time": 1549.43, "timestamp": "00:25:49", "text": "そうだよ、兄弟。自分のブランドすらコピーできない"}, {"type": "subtitle", "time": 1551.47, "timestamp": "00:25:51", "text": "リンク。ああ、"}, {"type": "subtitle", "time": 1553.149, "timestamp": "00:25:53", "text": "神。見て"}, {"type": "subtitle", "time": 1556.31, "timestamp": "00:25:56", "text": "一体なぜ私にこんなことをするんだ"}, {"type": "subtitle", "time": 1557.39, "timestamp": "00:25:57", "text": "右"}]
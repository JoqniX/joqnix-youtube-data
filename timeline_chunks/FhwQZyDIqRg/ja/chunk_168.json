[{"type": "subtitle", "time": 10082.03, "timestamp": "02:48:02", "text": "見ることができる"}, {"type": "subtitle", "time": 10085.99, "timestamp": "02:48:05", "text": "みんな。ナズキは死んだ。"}, {"type": "subtitle", "time": 10091.67, "timestamp": "02:48:11", "text": "ナツキは亡くなった。もしくは、赤い印が見える。"}, {"type": "subtitle", "time": 10094.23, "timestamp": "02:48:14", "text": "おい、そこの君。君は戻ってくる"}, {"type": "subtitle", "time": 10097.51, "timestamp": "02:48:17", "text": "これらの部分はよく使われます。私の名前はシャーです。それで"}, {"type": "subtitle", "time": 10100.55, "timestamp": "02:48:20", "text": "6月よ、お前は通さない。あなたはしてはならない"}, {"type": "subtitle", "time": 10102.309, "timestamp": "02:48:22", "text": "私の領土を通行する。ああ、見つけた"}, {"type": "subtitle", "time": 10105.99, "timestamp": "02:48:25", "text": "抽出。おい、君の抽出地点だ。"}, {"type": "subtitle", "time": 10108.55, "timestamp": "02:48:28", "text": "もちろんさ。マイクがオンになっていたら、"}, {"type": "subtitle", "time": 10111.349, "timestamp": "02:48:31", "text": "まさに私が"}, {"type": "subtitle", "time": 10116.03, "timestamp": "02:48:36", "text": "どういう意味ですか？出て行け。わあ、すごい。"}, {"type": "subtitle", "time": 10120.63, "timestamp": "02:48:40", "text": "わーい。うわぁ。よし、逃げるよ。"}, {"type": "subtitle", "time": 10122.63, "timestamp": "02:48:42", "text": "なぜ？そうそう。戻りましょう。それは"}, {"type": "subtitle", "time": 10124.309, "timestamp": "02:48:44", "text": "2つ目。"}, {"type": "subtitle", "time": 10126.63, "timestamp": "02:48:46", "text": "ああ、トラックに戻らなきゃ。"}, {"type": "subtitle", "time": 10132.309, "timestamp": "02:48:52", "text": "はい。うん。うん。うん。うん。わかった。"}, {"type": "subtitle", "time": 10135.349, "timestamp": "02:48:55", "text": "ああ、悪魔が見えなかったよ。"}, {"type": "subtitle", "time": 10136.59, "timestamp": "02:48:56", "text": "なんてこった。"}, {"type": "subtitle", "time": 10139.269, "timestamp": "02:48:59", "text": "なぜ？なぜご覧になりたいのですか？"}]
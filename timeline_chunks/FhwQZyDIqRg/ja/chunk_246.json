[{"type": "subtitle", "time": 14760.469, "timestamp": "04:06:00", "text": "いいえ。私は普段寝ていて、それからランダムに"}, {"type": "subtitle", "time": 14762.79, "timestamp": "04:06:02", "text": "ああ、これ持ってるよ、って感じのやつ覚えてる？"}, {"type": "subtitle", "time": 14764.79, "timestamp": "04:06:04", "text": "仕事はいいよ、じゃあ全部やるよ"}, {"type": "subtitle", "time": 14767.349, "timestamp": "04:06:07", "text": "家事を済ませて戻ってきて、"}, {"type": "subtitle", "time": 14770.63, "timestamp": "04:06:10", "text": "えーと、家事を避けるとか、"}, {"type": "subtitle", "time": 14773.389, "timestamp": "04:06:13", "text": "私はそれらをやりたいと思います"}, {"type": "subtitle", "time": 14775.99, "timestamp": "04:06:15", "text": "重複して、私はランダムに"}, {"type": "subtitle", "time": 14777.429, "timestamp": "04:06:17", "text": "彼らのことを覚えておいてくれれば、私が雑用をします"}, {"type": "subtitle", "time": 14779.75, "timestamp": "04:06:19", "text": "そして、私はレベルを使います"}, {"type": "subtitle", "time": 14786.469, "timestamp": "04:06:26", "text": "ええ、ジャックさん、今は40%です。いかがですか？"}, {"type": "subtitle", "time": 14789.75, "timestamp": "04:06:29", "text": "調子はどうですか？うん、私も同じ。私は"}, {"type": "subtitle", "time": 14793.269, "timestamp": "04:06:33", "text": "あなたと同じ速度"}, {"type": "subtitle", "time": 14796.63, "timestamp": "04:06:36", "text": "ジャム。わかった。意見の相違では、あなたは"}, {"type": "subtitle", "time": 14798.95, "timestamp": "04:06:38", "text": "自分の主張を証明することを優先する"}, {"type": "subtitle", "time": 14802.91, "timestamp": "04:06:42", "text": "他者の感情を尊重すること。えっと"}, {"type": "subtitle", "time": 14806.83, "timestamp": "04:06:46", "text": "また、事実対論理、事実対"}, {"type": "subtitle", "time": 14809.55, "timestamp": "04:06:49", "text": "感情。えっと、"}, {"type": "subtitle", "time": 14812.389, "timestamp": "04:06:52", "text": "意見の相違、これが意見の相違です"}, {"type": "subtitle", "time": 14815.11, "timestamp": "04:06:55", "text": "たくさんの場所に行く。これはとても"}, {"type": "subtitle", "time": 14819.429, "timestamp": "04:06:59", "text": "ちなみに、進路を絞り込みました。"}]
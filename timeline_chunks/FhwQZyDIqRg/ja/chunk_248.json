[{"type": "subtitle", "time": 14882.07, "timestamp": "04:08:02", "text": "あなたが間違っていると言うこと。私は違います 私は"}, {"type": "subtitle", "time": 14884.63, "timestamp": "04:08:04", "text": "それは良いアプローチではないと言っているだけです"}, {"type": "subtitle", "time": 14887.51, "timestamp": "04:08:07", "text": "この場所。おっしゃる通りですが、これは"}, {"type": "subtitle", "time": 14889.75, "timestamp": "04:08:09", "text": "これはあまり良いアプローチではない"}, {"type": "subtitle", "time": 14892.229, "timestamp": "04:08:12", "text": "場所。すると、あなたは次のように落ち着きます。"}, {"type": "subtitle", "time": 14894.79, "timestamp": "04:08:14", "text": "「ああ、彼は私が正しいって言ってるよ。」わかった。"}, {"type": "subtitle", "time": 14897.269, "timestamp": "04:08:17", "text": "わかった。わかった。今、聞いています。あなたは"}, {"type": "subtitle", "time": 14899.429, "timestamp": "04:08:19", "text": "リスニング。"}, {"type": "subtitle", "time": 14901.349, "timestamp": "04:08:21", "text": "私があなたが間違っていると言ったら、あなたは間違っていない"}, {"type": "subtitle", "time": 14903.75, "timestamp": "04:08:23", "text": "リスニング。あなたは決して耳を傾けないでしょう。うん、"}, {"type": "subtitle", "time": 14905.67, "timestamp": "04:08:25", "text": "兄弟。あなたではない。あなたはこう思うでしょう、"}, {"type": "subtitle", "time": 14908.91, "timestamp": "04:08:28", "text": "「君はヴィックじゃない。君は聞いてないよ"}, {"type": "subtitle", "time": 14912.07, "timestamp": "04:08:32", "text": "自分。あなたが「私は長い」と言うなら、"}, {"type": "subtitle", "time": 14915.03, "timestamp": "04:08:35", "text": "長さ。そして面白いのは、"}, {"type": "subtitle", "time": 14917.99, "timestamp": "04:08:37", "text": "我々は長い。誰も聞いていない。私達はします"}, {"type": "subtitle", "time": 14920.07, "timestamp": "04:08:40", "text": "私たちはただお互いに怒鳴り合って"}, {"type": "subtitle", "time": 14922.309, "timestamp": "04:08:42", "text": "それは終わらないだろう。私たちはただ両方とも"}, {"type": "subtitle", "time": 14926.15, "timestamp": "04:08:46", "text": "常に意見が合わない。"}, {"type": "subtitle", "time": 14928.79, "timestamp": "04:08:48", "text": "だから、もちろん、あなたが"}, {"type": "subtitle", "time": 14930.95, "timestamp": "04:08:50", "text": "明らかに正しいと言ったが"}, {"type": "subtitle", "time": 14934.07, "timestamp": "04:08:54", "text": "それは、えーっと、私はただ行くだけです"}, {"type": "subtitle", "time": 14939.03, "timestamp": "04:08:59", "text": "了解です、あなたは、私たちは、私たちは"}]
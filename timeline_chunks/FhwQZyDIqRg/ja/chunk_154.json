[{"type": "subtitle", "time": 9241.83, "timestamp": "02:34:01", "text": "さよならを言う。うん。うん。さあ行こう。"}, {"type": "subtitle", "time": 9244.469, "timestamp": "02:34:04", "text": "素晴らしい。さあ行こう。さあ行こう。大丈夫ですか？"}, {"type": "subtitle", "time": 9246.389, "timestamp": "02:34:06", "text": "ジョン、君と一緒かい？うん。うん。 5分"}, {"type": "subtitle", "time": 9249.11, "timestamp": "02:34:09", "text": "とにかく。さあ行こう。さあ行こう。私は願っています"}, {"type": "subtitle", "time": 9266.95, "timestamp": "02:34:26", "text": "さあ行こう。"}, {"type": "subtitle", "time": 9271.03, "timestamp": "02:34:31", "text": "君が宙返りするの、好きだよ。"}, {"type": "subtitle", "time": 9275.89, "timestamp": "02:34:35", "text": "私はそうだったらよかったのに、つまり私たちは試みた"}, {"type": "subtitle", "time": 9293.03, "timestamp": "02:34:53", "text": "あ、そういえば、誰かデビルを見てる？"}, {"type": "subtitle", "time": 9295.51, "timestamp": "02:34:55", "text": "泣くかもしれない？"}, {"type": "subtitle", "time": 9297.59, "timestamp": "02:34:57", "text": "おお、"}]
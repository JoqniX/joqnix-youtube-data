[{"type": "subtitle", "time": 15121.99, "timestamp": "04:12:01", "text": "明らかにその雰囲気は維持されているが、"}, {"type": "subtitle", "time": 15123.429, "timestamp": "04:12:03", "text": "それに、私はあなたの主張を裏付けているんです。だから私は"}, {"type": "subtitle", "time": 15126.71, "timestamp": "04:12:06", "text": "レベル1を選びます。同意する。"}, {"type": "subtitle", "time": 15128.95, "timestamp": "04:12:08", "text": "ああ、君がすべてを説明してくれるのは嬉しいよ"}, {"type": "subtitle", "time": 15132.99, "timestamp": "04:12:12", "text": "ライン。今はもっとクリアランスを得ています"}, {"type": "subtitle", "time": 15137.429, "timestamp": "04:12:17", "text": "この質問は、"}, {"type": "subtitle", "time": 15140.229, "timestamp": "04:12:20", "text": "明瞭さ。"}, {"type": "subtitle", "time": 15143.63, "timestamp": "04:12:23", "text": "うん。うん。これらの質問は"}, {"type": "subtitle", "time": 15146.15, "timestamp": "04:12:26", "text": "人口統計に関する質問ですが、彼らはとても"}, {"type": "subtitle", "time": 15149.59, "timestamp": "04:12:29", "text": "若者たちは疑問を抱く。これらは非常に"}, {"type": "subtitle", "time": 15152.71, "timestamp": "04:12:32", "text": "赤や青のように選ぶように選ぶように"}, {"type": "subtitle", "time": 15156.309, "timestamp": "04:12:36", "text": "チームを選ぶ、あるいはどんなチームを選ぶか"}, {"type": "subtitle", "time": 15159.51, "timestamp": "04:12:39", "text": "名前。だから、大丈夫だってわかるでしょ。あなた、あなた"}, {"type": "subtitle", "time": 15161.309, "timestamp": "04:12:41", "text": "通常は他の人が紹介するのを待つ"}, {"type": "subtitle", "time": 15165.11, "timestamp": "04:12:45", "text": "彼ら自身。ええ、普段はそうしています"}, {"type": "subtitle", "time": 15167.67, "timestamp": "04:12:47", "text": "それ。うん、私も。通常は待つ"}, {"type": "subtitle", "time": 15169.91, "timestamp": "04:12:49", "text": "他の人はまず話して、それから好きになる"}, {"type": "subtitle", "time": 15171.67, "timestamp": "04:12:51", "text": "彼らがくつろげるようにしてから、"}, {"type": "subtitle", "time": 15173.99, "timestamp": "04:12:53", "text": "行って話しなさい。あなたの気分は大きく変わる可能性があります"}, {"type": "subtitle", "time": 15174.91, "timestamp": "04:12:54", "text": "素早く。"}, {"type": "subtitle", "time": 15178.63, "timestamp": "04:12:58", "text": "いや、いや。あなたは本当に"}]
[{"type": "subtitle", "time": 4200.95, "timestamp": "01:10:00", "text": "彼女。私はただ彼女を連れて行くしかない、"}, {"type": "subtitle", "time": 4203.91, "timestamp": "01:10:03", "text": "ほら、カードを前に持っていってもいいんだよ。"}, {"type": "subtitle", "time": 4206.51, "timestamp": "01:10:06", "text": "私はたくさんのお金を持っています。待って、待って"}, {"type": "subtitle", "time": 4208.79, "timestamp": "01:10:08", "text": "動き。動かないで下さい。動かないで下さい。いいえ、"}, {"type": "subtitle", "time": 4211.189, "timestamp": "01:10:11", "text": "動かないで下さい。動かないで下さい。しかし継続中"}, {"type": "subtitle", "time": 4216.63, "timestamp": "01:10:16", "text": "[音楽]"}, {"type": "subtitle", "time": 4219.39, "timestamp": "01:10:19", "text": "ああ、なんてことだ、怖かったよ。"}, {"type": "subtitle", "time": 4222.709, "timestamp": "01:10:22", "text": "こんにちは。私のミスです。私はただ、私はただ自分の"}]
[{"type": "subtitle", "time": 8702.63, "timestamp": "02:25:02", "text": "そこに一人いた。うん。大人のエリンは"}, {"type": "subtitle", "time": 8704.71, "timestamp": "02:25:04", "text": "実際に式典中に立っている"}, {"type": "subtitle", "time": 8707.51, "timestamp": "02:25:07", "text": "まあ、ティーンエイジャーの頃のエリンが"}, {"type": "subtitle", "time": 8709.91, "timestamp": "02:25:09", "text": "まるで彼が群衆の中にいて、"}, {"type": "subtitle", "time": 8711.19, "timestamp": "02:25:11", "text": "群衆の中にいて、彼らは皆"}, {"type": "subtitle", "time": 8712.71, "timestamp": "02:25:12", "text": "座っている彼らは皆"}, {"type": "subtitle", "time": 8714.63, "timestamp": "02:25:14", "text": "三つ。話していたら、"}, {"type": "subtitle", "time": 8717.11, "timestamp": "02:25:17", "text": "シーンの一番奥に。それは"}, {"type": "subtitle", "time": 8720.55, "timestamp": "02:25:20", "text": "クレイジー。それは本当に信じられない。クレイジー。その後"}, {"type": "subtitle", "time": 8722.63, "timestamp": "02:25:22", "text": "一部があって、それで彼らは見せる"}, {"type": "subtitle", "time": 8725.11, "timestamp": "02:25:25", "text": "おもちゃみたいで、猿みたいに見える"}, {"type": "subtitle", "time": 8727.59, "timestamp": "02:25:27", "text": "そしてそれは、もちろん"}, {"type": "subtitle", "time": 8729.99, "timestamp": "02:25:29", "text": "男、そして兵士全員を見せる"}, {"type": "subtitle", "time": 8731.83, "timestamp": "02:25:31", "text": "猿は"}, {"type": "subtitle", "time": 8733.83, "timestamp": "02:25:33", "text": "ほら、すぐ隣にあるし、"}, {"type": "subtitle", "time": 8735.429, "timestamp": "02:25:35", "text": "兵士たちは全員倒れている"}, {"type": "subtitle", "time": 8737.67, "timestamp": "02:25:37", "text": "馬とすべての"}, {"type": "subtitle", "time": 8740.71, "timestamp": "02:25:40", "text": "建物が大きすぎる。ええ、まさにその通りです。"}, {"type": "subtitle", "time": 8744.79, "timestamp": "02:25:44", "text": "私はそれと共に育ったと思う。おお。"}, {"type": "subtitle", "time": 8746.63, "timestamp": "02:25:46", "text": "つまり、多くの人が不満を言っている"}, {"type": "subtitle", "time": 8747.59, "timestamp": "02:25:47", "text": "結末について。ほら、"}, {"type": "subtitle", "time": 8749.349, "timestamp": "02:25:49", "text": "何？もしそれが作家の仕業なら、"}, {"type": "subtitle", "time": 8752.95, "timestamp": "02:25:52", "text": "受け入れるしかない。そして、私は本当に"}, {"type": "subtitle", "time": 8754.71, "timestamp": "02:25:54", "text": "エンディング。エリンがついに手に入れたように"}, {"type": "subtitle", "time": 8756.15, "timestamp": "02:25:56", "text": "彼は常に自由を求めていた。あなたは"}, {"type": "subtitle", "time": 8757.59, "timestamp": "02:25:57", "text": "最初に覚えておいてください、これがあります"}, {"type": "subtitle", "time": 8759.51, "timestamp": "02:25:59", "text": "マサが見ているシーン"}]
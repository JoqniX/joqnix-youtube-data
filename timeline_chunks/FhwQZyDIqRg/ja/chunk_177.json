[{"type": "subtitle", "time": 10622.79, "timestamp": "02:57:02", "text": "それでも、フーの最後の"}, {"type": "subtitle", "time": 10625.91, "timestamp": "02:57:05", "text": "最後の敗者の王になるつもりか？"}, {"type": "subtitle", "time": 10628.269, "timestamp": "02:57:08", "text": "まあ、つまり、兄弟、"}, {"type": "subtitle", "time": 10629.87, "timestamp": "02:57:09", "text": "私"}, {"type": "subtitle", "time": 10641.11, "timestamp": "02:57:21", "text": "わかった。"}, {"type": "subtitle", "time": 10652.71, "timestamp": "02:57:32", "text": "それは悪い考えだった。殺すのは"}, {"type": "subtitle", "time": 10654.23, "timestamp": "02:57:34", "text": "武器。殺す"}, {"type": "subtitle", "time": 10669.429, "timestamp": "02:57:49", "text": "ええ、衝撃を受けました。私は死んだ。でも私はそうじゃない"}, {"type": "subtitle", "time": 10671.349, "timestamp": "02:57:51", "text": "その一つ。"}, {"type": "subtitle", "time": 10673.349, "timestamp": "02:57:53", "text": "やり方さえわからなかったけど、"}, {"type": "subtitle", "time": 10676.87, "timestamp": "02:57:56", "text": "「ああ、彼がやってるのを見て」"}, {"type": "subtitle", "time": 10679.99, "timestamp": "02:57:59", "text": "戦争だ。」"}]
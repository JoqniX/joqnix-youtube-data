[{"type": "subtitle", "time": 1084.789, "timestamp": "00:18:04", "text": "好きじゃなかった、好きになりたくなかった"}, {"type": "subtitle", "time": 1087.11, "timestamp": "00:18:07", "text": "本当はしたかったんだけど、すごく恥ずかしくて"}, {"type": "subtitle", "time": 1088.909, "timestamp": "00:18:08", "text": "頼む"}, {"type": "subtitle", "time": 1092.11, "timestamp": "00:18:12", "text": "助けて"}, {"type": "subtitle", "time": 1094.59, "timestamp": "00:18:14", "text": "ついに"}, {"type": "subtitle", "time": 1097.39, "timestamp": "00:18:17", "text": "最後に特別な特別な"}, {"type": "subtitle", "time": 1101.39, "timestamp": "00:18:21", "text": "最近デビューした人"}, {"type": "subtitle", "time": 1103.669, "timestamp": "00:18:23", "text": "月。えっと、今月だったかな、それとも先月だったかな？"}, {"type": "subtitle", "time": 1105.75, "timestamp": "00:18:25", "text": "月？"}, {"type": "subtitle", "time": 1109.35, "timestamp": "00:18:29", "text": "彼女はデビューした、彼女は本当に"}, {"type": "subtitle", "time": 1116.99, "timestamp": "00:18:36", "text": "カワイイ。彼女もチャットに参加しています。"}, {"type": "subtitle", "time": 1121.789, "timestamp": "00:18:41", "text": "ねえ、そして皆さんのほとんどは彼女のことを"}, {"type": "subtitle", "time": 1130.95, "timestamp": "00:18:50", "text": "えっと、彼女は私を助​​けてくれた"}, {"type": "subtitle", "time": 1134.47, "timestamp": "00:18:54", "text": "えっと、彼女はデザインを手伝ってくれたんです。彼女は描いた"}, {"type": "subtitle", "time": 1136.669, "timestamp": "00:18:56", "text": "これは私のために描いてくれたものです"}]
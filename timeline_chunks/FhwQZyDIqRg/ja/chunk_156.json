[{"type": "subtitle", "time": 9360.71, "timestamp": "02:36:00", "text": "ごめん。"}, {"type": "subtitle", "time": 9362.03, "timestamp": "02:36:02", "text": "彼は"}, {"type": "subtitle", "time": 9364.15, "timestamp": "02:36:04", "text": "文字通り、彼はそこにいる。彼はそこにいる。彼は"}, {"type": "subtitle", "time": 9367.27, "timestamp": "02:36:07", "text": "そこには。ああ、くそ。"}, {"type": "subtitle", "time": 9370.51, "timestamp": "02:36:10", "text": "これから何が起こるのでしょうか？なんてこった。"}, {"type": "subtitle", "time": 9374.71, "timestamp": "02:36:14", "text": "ああ、わかった。それはなくなってしまった。"}, {"type": "subtitle", "time": 9378.15, "timestamp": "02:36:18", "text": "私は自分の"}, {"type": "subtitle", "time": 9382.55, "timestamp": "02:36:22", "text": "あなた。うわぁ。何だって？ああ、どうですか。"}, {"type": "subtitle", "time": 9387.75, "timestamp": "02:36:27", "text": "[拍手]"}, {"type": "subtitle", "time": 9388.59, "timestamp": "02:36:28", "text": "おお"}, {"type": "subtitle", "time": 9397.03, "timestamp": "02:36:37", "text": "Ch.大丈夫。誰もそれを見ていなかった。うん、"}, {"type": "subtitle", "time": 9410.26, "timestamp": "02:36:50", "text": "ああ、最高だ。私は手に入れた"}]
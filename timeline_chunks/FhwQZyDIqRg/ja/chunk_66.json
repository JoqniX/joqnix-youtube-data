[{"type": "subtitle", "time": 3960.789, "timestamp": "01:06:00", "text": "何か？わからない、だって毎回"}, {"type": "subtitle", "time": 3962.39, "timestamp": "01:06:02", "text": "それは私を見つけるだけだった。だから、あなたは"}, {"type": "subtitle", "time": 3963.829, "timestamp": "01:06:03", "text": "テーブルの下に隠れて"}, {"type": "subtitle", "time": 3965.829, "timestamp": "01:06:05", "text": "もの。あなたも捕まる可能性があります、"}, {"type": "subtitle", "time": 3968.63, "timestamp": "01:06:08", "text": "方法。何？そして、もしあなたが近すぎると"}, {"type": "subtitle", "time": 3970.87, "timestamp": "01:06:10", "text": "テーブルの下などでも、"}, {"type": "subtitle", "time": 3973.589, "timestamp": "01:06:13", "text": "お前も殺してやる。だから、みんな気をつけてね。"}, {"type": "subtitle", "time": 3975.43, "timestamp": "01:06:15", "text": "うん。よし。来て。さあ行こう。全て"}, {"type": "subtitle", "time": 3976.87, "timestamp": "01:06:16", "text": "右。さあ行こう。さあ行こう。さあ行こう。"}, {"type": "subtitle", "time": 3978.47, "timestamp": "01:06:18", "text": "よし、みんな。我々はこれに勝っている。"}, {"type": "subtitle", "time": 3981.029, "timestamp": "01:06:21", "text": "ロックイン。ロック。しっかり準備しようぜ、兄弟。ロック"}, {"type": "subtitle", "time": 3989.829, "timestamp": "01:06:29", "text": "最初の5試合で負けたと想像してみてください。"}, {"type": "subtitle", "time": 3992.789, "timestamp": "01:06:32", "text": "縁起でもないことを言わないで。縁起でもないことを言わないで。私たちと同じように"}, {"type": "subtitle", "time": 3994.87, "timestamp": "01:06:34", "text": "締め切り日のように、それをロックする必要がある。"}, {"type": "subtitle", "time": 3996.71, "timestamp": "01:06:36", "text": "あなたが知っている。みんな、頼むよ。クラッチ。わかった"}, {"type": "subtitle", "time": 3999.27, "timestamp": "01:06:39", "text": "みんな、行こう。ああ、それは違う"}, {"type": "subtitle", "time": 4001.27, "timestamp": "01:06:41", "text": "部屋。私は誰かを殺したくない"}, {"type": "subtitle", "time": 4004.63, "timestamp": "01:06:44", "text": "した。この辺りでは気を付けてください。私は"}, {"type": "subtitle", "time": 4006.71, "timestamp": "01:06:46", "text": "銃を持った盲目の男を見た"}, {"type": "subtitle", "time": 4009.829, "timestamp": "01:06:49", "text": "いつかここにスポーンするよ。そうそう。地獄"}, {"type": "subtitle", "time": 4012.23, "timestamp": "01:06:52", "text": "うん。魔女だと思う"}, {"type": "subtitle", "time": 4014.95, "timestamp": "01:06:54", "text": "魔女がここに来る。魔女のように"}, {"type": "subtitle", "time": 4017.829, "timestamp": "01:06:57", "text": "何てことだ。ああ、神様。痛い。あ、すみません。"}]
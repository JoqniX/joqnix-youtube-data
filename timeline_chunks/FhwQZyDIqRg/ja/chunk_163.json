[{"type": "subtitle", "time": 9781.11, "timestamp": "02:43:01", "text": "そこに1つ入れてくれよ、兄弟。そのうちの1つを置く"}, {"type": "subtitle", "time": 9784.07, "timestamp": "02:43:04", "text": "そこには。 「ああ、あったよ」"}, {"type": "subtitle", "time": 9785.91, "timestamp": "02:43:05", "text": "私には強さとスタミナがあった"}, {"type": "subtitle", "time": 9787.75, "timestamp": "02:43:07", "text": "そこに置いてください。他の人のことは知りません。私"}, {"type": "subtitle", "time": 9789.51, "timestamp": "02:43:09", "text": "まるで私が文字通り1つ掴んだかのように"}, {"type": "subtitle", "time": 9792.15, "timestamp": "02:43:12", "text": "床に置いてください。"}, {"type": "subtitle", "time": 9794.469, "timestamp": "02:43:14", "text": "2つあるのが見えました。一体誰が"}, {"type": "subtitle", "time": 9796.309, "timestamp": "02:43:16", "text": "それを取り除く？"}, {"type": "subtitle", "time": 9798.63, "timestamp": "02:43:18", "text": "ああ、私たちがそれを買わなかったのは、"}, {"type": "subtitle", "time": 9800.63, "timestamp": "02:43:20", "text": "高すぎた。"}, {"type": "subtitle", "time": 9804.309, "timestamp": "02:43:24", "text": "いや、私たちはそれと戦わなければならなかった。いいえ、私は"}, {"type": "subtitle", "time": 9808.389, "timestamp": "02:43:28", "text": "トロフィーだよ、みんな。言わせてください。"}, {"type": "subtitle", "time": 9810.55, "timestamp": "02:43:30", "text": "あなたはまだムースの試合を見ていますか？"}, {"type": "subtitle", "time": 9817.349, "timestamp": "02:43:37", "text": "外側はどうなっているのか？"}, {"type": "subtitle", "time": 9819.91, "timestamp": "02:43:39", "text": "あなたに一体何が起こったのですか？知っている。なぜ"}, {"type": "subtitle", "time": 9823.83, "timestamp": "02:43:43", "text": "私はテレビがジャンプした"}, {"type": "subtitle", "time": 9825.67, "timestamp": "02:43:45", "text": "恐怖。"}, {"type": "subtitle", "time": 9828.71, "timestamp": "02:43:48", "text": "車はどこ？"}, {"type": "subtitle", "time": 9834.71, "timestamp": "02:43:54", "text": "ああ、なぜ私は壊れてしまうのだろう？あなたはただ"}, {"type": "subtitle", "time": 9836.71, "timestamp": "02:43:56", "text": "俺にばったり会うつもりか？私は"}]
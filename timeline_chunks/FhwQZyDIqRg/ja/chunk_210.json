[{"type": "subtitle", "time": 12600.349, "timestamp": "03:30:00", "text": "兄弟？あなたの"}, {"type": "subtitle", "time": 12608.389, "timestamp": "03:30:08", "text": "注射？思い出させてくれてありがとう。私は必要としている"}, {"type": "subtitle", "time": 12626.389, "timestamp": "03:30:26", "text": "発売されなければ、私は"}, {"type": "subtitle", "time": 12629.55, "timestamp": "03:30:29", "text": "私の別のアカウントで、"}, {"type": "subtitle", "time": 12652.71, "timestamp": "03:30:52", "text": "読み込み中です。インド訛り。私はインド人です"}]
[{"type": "subtitle", "time": 15901.229, "timestamp": "04:25:01", "text": "すべてを除いて"}, {"type": "subtitle", "time": 15904.87, "timestamp": "04:25:04", "text": "それらの。まあ、そういうことでしょうね。"}, {"type": "subtitle", "time": 15907.51, "timestamp": "04:25:07", "text": "ジャックさん、調子はどうですか？調子はどうですか？"}, {"type": "subtitle", "time": 15909.91, "timestamp": "04:25:09", "text": "テストを受けていますか？うん。ええ、私も同じです"}, {"type": "subtitle", "time": 15912.07, "timestamp": "04:25:12", "text": "あなたとして場所を決めてください。"}, {"type": "subtitle", "time": 15922.07, "timestamp": "04:25:22", "text": "あなたはさまざまな形の"}, {"type": "subtitle", "time": 15925.07, "timestamp": "04:25:25", "text": "執筆などの創造的な表現。うわぁ。"}, {"type": "subtitle", "time": 15930.269, "timestamp": "04:25:30", "text": "反対です。難しい"}, {"type": "subtitle", "time": 15932.79, "timestamp": "04:25:32", "text": "同意できない。あなたは通常、選択を基準にします"}, {"type": "subtitle", "time": 15934.83, "timestamp": "04:25:34", "text": "客観的事実に基づいて"}, {"type": "subtitle", "time": 15938.309, "timestamp": "04:25:38", "text": "そして、選択は客観的な基準に基づいて行う。"}, {"type": "subtitle", "time": 15940.79, "timestamp": "04:25:40", "text": "感情的な印象ではなく、事実に基づいて判断する。"}, {"type": "subtitle", "time": 15943.349, "timestamp": "04:25:43", "text": "やはり両方です。"}, {"type": "subtitle", "time": 15949.87, "timestamp": "04:25:49", "text": "ええと、私は検討したでしょう"}, {"type": "subtitle", "time": 15954.149, "timestamp": "04:25:54", "text": "事実が感情よりも優先される場合"}, {"type": "subtitle", "time": 15957.149, "timestamp": "04:25:57", "text": "決定の場合"}, {"type": "subtitle", "time": 15959.99, "timestamp": "04:25:59", "text": "作成中。私はむしろ"}]
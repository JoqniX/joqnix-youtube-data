[{"type": "subtitle", "time": 15962.79, "timestamp": "04:26:02", "text": "感情よりも事実の方が重要だ。だから私は行く"}, {"type": "subtitle", "time": 15971.03, "timestamp": "04:26:11", "text": "同意する、難しい同意や難しい"}, {"type": "subtitle", "time": 15972.87, "timestamp": "04:26:12", "text": "同意できない。私は完全に"}, {"type": "subtitle", "time": 15975.31, "timestamp": "04:26:15", "text": "感情的なものか、完全に論理的なものか。"}, {"type": "subtitle", "time": 15984.51, "timestamp": "04:26:24", "text": "彼の名前を忘れてしまった。ベン・ベニポ。ごめん。ああ"}, {"type": "subtitle", "time": 15988.149, "timestamp": "04:26:28", "text": "ベン、私はよく彼のことを見ていたよ。"}]
[{"type": "subtitle", "time": 8761.429, "timestamp": "02:26:01", "text": "バッタ。それはメスのバッタです。"}, {"type": "subtitle", "time": 8762.95, "timestamp": "02:26:02", "text": "そして雌のバッタは切り落とされる"}, {"type": "subtitle", "time": 8764.71, "timestamp": "02:26:04", "text": "男性の頭部。彼女は"}, {"type": "subtitle", "time": 8766.87, "timestamp": "02:26:06", "text": "そうです。それが彼女のすることなんです"}, {"type": "subtitle", "time": 8768.309, "timestamp": "02:26:08", "text": "ゲームの中で。私はその言及を次のように見てきました"}, {"type": "subtitle", "time": 8770.79, "timestamp": "02:26:10", "text": "良い。それはおかしい。それはおかしい。そして"}, {"type": "subtitle", "time": 8773.19, "timestamp": "02:26:13", "text": "それは、そして、半分の人々が"}, {"type": "subtitle", "time": 8775.19, "timestamp": "02:26:15", "text": "半分の人々がマサと戦っている"}, {"type": "subtitle", "time": 8779.51, "timestamp": "02:26:19", "text": "結婚した馬面。うん。しかし彼は"}, {"type": "subtitle", "time": 8782.07, "timestamp": "02:26:22", "text": "決してそうはならなかった。しかし、彼女は実際にはそうしなかった。"}, {"type": "subtitle", "time": 8785.11, "timestamp": "02:26:25", "text": "実際には、彼女の隣にいたのはアルメンでした"}, {"type": "subtitle", "time": 8787.99, "timestamp": "02:26:27", "text": "彼らがそう思った最終回"}, {"type": "subtitle", "time": 8789.67, "timestamp": "02:26:29", "text": "彼らが実際に"}, {"type": "subtitle", "time": 8791.349, "timestamp": "02:26:31", "text": "馬面。わからない。私はできません"}, {"type": "subtitle", "time": 8792.87, "timestamp": "02:26:32", "text": "彼の名前を覚えておいてください。私は彼をただ馬と呼んでいます"}, {"type": "subtitle", "time": 8796.309, "timestamp": "02:26:36", "text": "顔。それはまさにジョン・ジョンそのものだ。しかし"}, {"type": "subtitle", "time": 8798.15, "timestamp": "02:26:38", "text": "それは完全に理論を覆す"}, {"type": "subtitle", "time": 8801.59, "timestamp": "02:26:41", "text": "アルメンとアニー。いや、いや、いや。彼らは"}, {"type": "subtitle", "time": 8803.99, "timestamp": "02:26:43", "text": "彼らは結婚していなかった。それはアルメンと"}, {"type": "subtitle", "time": 8805.99, "timestamp": "02:26:45", "text": "ピカサが墓参りをしている。おお。おお。おお。"}, {"type": "subtitle", "time": 8809.83, "timestamp": "02:26:49", "text": "墓。そうそう。うん。うん。私"}, {"type": "subtitle", "time": 8812.55, "timestamp": "02:26:52", "text": "つまり、それは墓場の光景ではなかったということだ。"}, {"type": "subtitle", "time": 8814.23, "timestamp": "02:26:54", "text": "うん。うん。うん。最後の一つ。人々"}, {"type": "subtitle", "time": 8816.55, "timestamp": "02:26:56", "text": "Gジョンだったと思うけど、ああ、そうだね。"}, {"type": "subtitle", "time": 8819.83, "timestamp": "02:26:59", "text": "人々は彼女がジョンと結婚したと思っていたが、"}]
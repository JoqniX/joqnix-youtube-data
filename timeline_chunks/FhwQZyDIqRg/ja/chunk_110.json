[{"type": "subtitle", "time": 6600.95, "timestamp": "01:50:00", "text": "混ぜずに1つだけ。いいえ、"}, {"type": "subtitle", "time": 6603.109, "timestamp": "01:50:03", "text": "チャックがいなくて寂しかった。"}, {"type": "subtitle", "time": 6605.189, "timestamp": "01:50:05", "text": "外れた。あなたは自分のためだけに"}, {"type": "subtitle", "time": 6607.75, "timestamp": "01:50:07", "text": "Zを選んだんだ。ジョックは手に入らなかったね。ジョック。"}, {"type": "subtitle", "time": 6609.99, "timestamp": "01:50:09", "text": "ジョックは死んだ。ええ、私は死にました。あなたは受け取らなかった"}, {"type": "subtitle", "time": 6612.149, "timestamp": "01:50:12", "text": "彼だよ、兄弟。何？"}, {"type": "subtitle", "time": 6614.149, "timestamp": "01:50:14", "text": "彼はそこにいた。彼はそこにいた。それはとても"}, {"type": "subtitle", "time": 6616.31, "timestamp": "01:50:16", "text": "不公平だ。なぜこれらの幽霊が"}, {"type": "subtitle", "time": 6619.109, "timestamp": "01:50:19", "text": "自分？よくわからなかったよ、兄弟。私は1歳です"}, {"type": "subtitle", "time": 6621.669, "timestamp": "01:50:21", "text": "さらにXPも加算されます。素晴らしい。大丈夫。あなたがすべき"}, {"type": "subtitle", "time": 6624.149, "timestamp": "01:50:24", "text": "それが私に落ちてきたとき、逃げ出した。私"}, {"type": "subtitle", "time": 6625.83, "timestamp": "01:50:25", "text": "言っておくけど、私のXPは"}, {"type": "subtitle", "time": 6627.189, "timestamp": "01:50:27", "text": "減少した。だから、"}, {"type": "subtitle", "time": 6629.51, "timestamp": "01:50:29", "text": "走るスピードが落ちた"}, {"type": "subtitle", "time": 6631.83, "timestamp": "01:50:31", "text": "440から1に減速しなければならなかった"}, {"type": "subtitle", "time": 6633.35, "timestamp": "01:50:33", "text": "1つに減ったので、下がった。私"}, {"type": "subtitle", "time": 6635.109, "timestamp": "01:50:35", "text": "走れなかった。私は走れなかった。それは"}, {"type": "subtitle", "time": 6638.31, "timestamp": "01:50:38", "text": "それで十分ですか？彼女のスタミナを買おう。"}, {"type": "subtitle", "time": 6640.87, "timestamp": "01:50:40", "text": "わかった。基本的に、もしあなたが見れば"}, {"type": "subtitle", "time": 6643.109, "timestamp": "01:50:43", "text": "暴走モンスター ああ、買わない方がいいよ。"}, {"type": "subtitle", "time": 6644.87, "timestamp": "01:50:44", "text": "買わない方がいい。買わない方がいい。えーと"}, {"type": "subtitle", "time": 6647.43, "timestamp": "01:50:47", "text": "それをトラックに積んでください。"}, {"type": "subtitle", "time": 6650.149, "timestamp": "01:50:50", "text": "あらら。 HP製品は買わない方がいい。私たちには"}, {"type": "subtitle", "time": 6652.31, "timestamp": "01:50:52", "text": "HPを全回復させるバグ。そのまま"}, {"type": "subtitle", "time": 6653.91, "timestamp": "01:50:53", "text": "トラックの中に積んでおきます。 HP製品は買わないでください。それは"}, {"type": "subtitle", "time": 6656.229, "timestamp": "01:50:56", "text": "それ。彼女に伝える前に始めないでください"}, {"type": "subtitle", "time": 6659.43, "timestamp": "01:50:59", "text": "ただし、不具合があります。ああ、私はスタミナが1つあります"}]
[{"type": "subtitle", "time": 5221.35, "timestamp": "01:27:01", "text": "あなたは今も彼女の心の中にいる。"}, {"type": "subtitle", "time": 5223.83, "timestamp": "01:27:03", "text": "はい、まさにその通りです。うん、できるよ、できるよ、できるよ"}, {"type": "subtitle", "time": 5226.07, "timestamp": "01:27:06", "text": "今でも彼女を擁護する。彼女ならできる。"}, {"type": "subtitle", "time": 5228.709, "timestamp": "01:27:08", "text": "よし、みんな。"}, {"type": "subtitle", "time": 5232.31, "timestamp": "01:27:12", "text": "はい。はい、できますよ。はい、あなたならできます。"}, {"type": "subtitle", "time": 5236.87, "timestamp": "01:27:16", "text": "君ならできるよ、女の子。頑張れ。"}, {"type": "subtitle", "time": 5237.629, "timestamp": "01:27:17", "text": "おお、"}, {"type": "subtitle", "time": 5240.79, "timestamp": "01:27:20", "text": "いいえ。それは私たち全員を救うはずだった。おお"}, {"type": "subtitle", "time": 5242.48, "timestamp": "01:27:22", "text": "いいえ。"}, {"type": "subtitle", "time": 5249.35, "timestamp": "01:27:29", "text": "それは本当に馬鹿げている、まるで騒音のように"}, {"type": "subtitle", "time": 5251.99, "timestamp": "01:27:31", "text": "ハンツマンがそこにいる。なるほど。うん。うん。"}, {"type": "subtitle", "time": 5253.59, "timestamp": "01:27:33", "text": "彼女は黙っている必要がある。彼の背中"}, {"type": "subtitle", "time": 5256.47, "timestamp": "01:27:36", "text": "チームを背負いすぎたことで苦しんでいる。彼女"}, {"type": "subtitle", "time": 5257.99, "timestamp": "01:27:37", "text": "彼女はチームを引っ張っているのは、"}, {"type": "chat", "time": 5260.191, "timestamp": "01:27:40", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "more like- you're the horror XP"}, {"type": "subtitle", "time": 5261.189, "timestamp": "01:27:41", "text": "敗者の王。少し"}, {"type": "subtitle", "time": 5264.47, "timestamp": "01:27:44", "text": "絶対的な責任を負うことになる。"}, {"type": "subtitle", "time": 5266.629, "timestamp": "01:27:46", "text": "まあ、ただ単に調子が悪いだけなんです。あなたは"}, {"type": "subtitle", "time": 5269.11, "timestamp": "01:27:49", "text": "彼女の輝き。信頼"}, {"type": "subtitle", "time": 5271.59, "timestamp": "01:27:51", "text": "それ。"}, {"type": "subtitle", "time": 5274.07, "timestamp": "01:27:54", "text": "誰か魔法って入力できる？どうすればいいの、ああ、"}, {"type": "subtitle", "time": 5275.669, "timestamp": "01:27:55", "text": "待って。地図を見るにはどうすればいいですか？忘れた。"}, {"type": "subtitle", "time": 5278.79, "timestamp": "01:27:58", "text": "ずっとそうだったのですか？タブキーを押してください。タブ。おお、"}]
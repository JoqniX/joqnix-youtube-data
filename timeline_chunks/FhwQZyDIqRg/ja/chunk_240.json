[{"type": "subtitle", "time": 14401.75, "timestamp": "04:00:01", "text": "これの要点は？ Ving のような人は知らない"}, {"type": "subtitle", "time": 14404.87, "timestamp": "04:00:04", "text": "ある意味、物語を語ることと言えるでしょう？いいえ、"}, {"type": "subtitle", "time": 14407.67, "timestamp": "04:00:07", "text": "いいえ。ライティングライティングのようなライティング"}, {"type": "subtitle", "time": 14409.83, "timestamp": "04:00:09", "text": "物理的に本を書く"}, {"type": "subtitle", "time": 14413.11, "timestamp": "04:00:13", "text": "物語。いいえ、私は同意しません。私はできません。"}, {"type": "subtitle", "time": 14415.51, "timestamp": "04:00:15", "text": "それには賛成します。完全に同意します"}, {"type": "chat", "time": 14419.059, "timestamp": "04:00:19", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "night night jerry san"}, {"type": "subtitle", "time": 14419.11, "timestamp": "04:00:19", "text": "レベル３へ。同意する。"}, {"type": "subtitle", "time": 14421.91, "timestamp": "04:00:21", "text": "私は何もできません。こんにちは。"}, {"type": "subtitle", "time": 14423.71, "timestamp": "04:00:23", "text": "おやすみ。"}, {"type": "subtitle", "time": 14427.11, "timestamp": "04:00:27", "text": "バイバイ。誰が去ろうとも、"}, {"type": "subtitle", "time": 14429.75, "timestamp": "04:00:29", "text": "お越しいただきありがとうございます。"}, {"type": "subtitle", "time": 14431.87, "timestamp": "04:00:31", "text": "本当に感謝しています。"}, {"type": "subtitle", "time": 14434.71, "timestamp": "04:00:34", "text": "男。私の話を聞いてくれてありがとう"}, {"type": "subtitle", "time": 14437.99, "timestamp": "04:00:37", "text": "退屈な声。本当に感謝しています。"}, {"type": "subtitle", "time": 14440.469, "timestamp": "04:00:40", "text": "いいえ、退屈ではありません。あなたは実際には"}, {"type": "subtitle", "time": 14443.03, "timestamp": "04:00:43", "text": "知恵と知識をたくさん与えて"}, {"type": "subtitle", "time": 14444.79, "timestamp": "04:00:44", "text": "洞察力"}, {"type": "subtitle", "time": 14447.07, "timestamp": "04:00:47", "text": "なぜなら私は"}, {"type": "subtitle", "time": 14450.469, "timestamp": "04:00:50", "text": "古い。私はもう年寄りだ。私は千人くらい"}, {"type": "subtitle", "time": 14452.309, "timestamp": "04:00:52", "text": "数歳以上。もちろん、私はこれを持っています"}, {"type": "subtitle", "time": 14455.51, "timestamp": "04:00:55", "text": "知恵。もし私がまだバカだったら、もし私がまだ"}, {"type": "chat", "time": 14455.53, "timestamp": "04:00:55", "author": "@DinyoFoxy", "avatar": "https://yt4.ggpht.com/DGXvUKi0q0ld5Zo5CNG2tmulZfZqg_h6ivQHLtQfKyx-z_EjHr-Bx7limqyg4JtpZ00_XP_BTQ=s64-c-k-c0x00ffffff-no-rj", "message": "nha I like your voice"}, {"type": "subtitle", "time": 14457.59, "timestamp": "04:00:57", "text": "バカ、どうしたらいいかわからない"}, {"type": "subtitle", "time": 14459.48, "timestamp": "04:00:59", "text": "もはや私自身ではない。"}]
[{"type": "subtitle", "time": 10744.469, "timestamp": "02:59:04", "text": "これで全部だと思います。これで終わりだと思います"}, {"type": "subtitle", "time": 10747.349, "timestamp": "02:59:07", "text": "今日。うわー、すごかった。それはまるで"}, {"type": "subtitle", "time": 10751.429, "timestamp": "02:59:11", "text": "それはとても良かった。知っている。ええと、どうやって"}, {"type": "subtitle", "time": 10753.67, "timestamp": "02:59:13", "text": "話をした後が一番楽しかった"}, {"type": "subtitle", "time": 10755.11, "timestamp": "02:59:15", "text": "アニメについて？実際にお金を使うべき"}, {"type": "subtitle", "time": 10756.71, "timestamp": "02:59:16", "text": "アニメについて1時間話して"}, {"type": "subtitle", "time": 10758.87, "timestamp": "02:59:18", "text": "それからゲームをしに行こう、君が"}, {"type": "subtitle", "time": 10761.03, "timestamp": "02:59:21", "text": "何かを経験している。あなたは"}, {"type": "subtitle", "time": 10762.63, "timestamp": "02:59:22", "text": "ラックとタイタンのパワーまたは"}, {"type": "subtitle", "time": 10764.71, "timestamp": "02:59:24", "text": "何か。私たちは力を手に入れた"}, {"type": "subtitle", "time": 10766.429, "timestamp": "02:59:26", "text": "友情。"}, {"type": "subtitle", "time": 10768.79, "timestamp": "02:59:28", "text": "絶対に。絶対に。わあ、それはとても"}, {"type": "subtitle", "time": 10771.59, "timestamp": "02:59:31", "text": "素晴らしいよ。私たちはこれを計画しなければならない"}, {"type": "subtitle", "time": 10773.67, "timestamp": "02:59:33", "text": "また。私たちは、えっと、私は"}, {"type": "subtitle", "time": 10775.67, "timestamp": "02:59:35", "text": "そこで活動し、あなたに"}, {"type": "subtitle", "time": 10776.95, "timestamp": "02:59:36", "text": "グループに関する提案。私は"}, {"type": "subtitle", "time": 10780.19, "timestamp": "02:59:40", "text": "そこに留まりなさい。私のをあげましょう。うん。"}, {"type": "subtitle", "time": 10783.59, "timestamp": "02:59:43", "text": "はい。うん。あれはすごくかっこよかった。それはとても"}, {"type": "subtitle", "time": 10786.63, "timestamp": "02:59:46", "text": "とても素晴らしい。とても楽しかったです。だから、"}, {"type": "subtitle", "time": 10789.469, "timestamp": "02:59:49", "text": "楽しかった。わーい。感謝したい"}, {"type": "subtitle", "time": 10792.309, "timestamp": "02:59:52", "text": "ソードフィッシュがまだ誰かを監視しているなら。"}, {"type": "subtitle", "time": 10793.99, "timestamp": "02:59:53", "text": "ありがとう。彼が"}, {"type": "subtitle", "time": 10796.309, "timestamp": "02:59:56", "text": "見ている。彼が"}, {"type": "subtitle", "time": 10798.55, "timestamp": "02:59:58", "text": "見ている。"}]
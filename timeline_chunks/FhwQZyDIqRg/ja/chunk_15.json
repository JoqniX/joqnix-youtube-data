[{"type": "subtitle", "time": 900.069, "timestamp": "00:15:00", "text": "Twitch？ねえ、"}, {"type": "subtitle", "time": 901.629, "timestamp": "00:15:01", "text": "ビジュアライザー"}, {"type": "subtitle", "time": 904.829, "timestamp": "00:15:04", "text": "実は。ブーム。"}, {"type": "subtitle", "time": 909.629, "timestamp": "00:15:09", "text": "よお。こんにちは。こちらはビジュアライザー・ジョックです。"}, {"type": "subtitle", "time": 911.15, "timestamp": "00:15:11", "text": "最大。"}, {"type": "subtitle", "time": 913.829, "timestamp": "00:15:13", "text": "こんにちは。皆さんはどう思いますか？実は、"}, {"type": "subtitle", "time": 917.949, "timestamp": "00:15:17", "text": "ええ、まだあります"}, {"type": "subtitle", "time": 921.55, "timestamp": "00:15:21", "text": "あれ。私は本当に"}, {"type": "subtitle", "time": 926.269, "timestamp": "00:15:26", "text": "サボテン。電源を入れる。こんにちは。それを回した"}, {"type": "subtitle", "time": 928.91, "timestamp": "00:15:28", "text": "の上。ええ、そうですね。"}, {"type": "subtitle", "time": 933.509, "timestamp": "00:15:33", "text": "えっと、私は「ミナ、どう思う？」って言ったの。"}, {"type": "subtitle", "time": 935.55, "timestamp": "00:15:35", "text": "新しいのはどうですか？"}, {"type": "subtitle", "time": 939.79, "timestamp": "00:15:39", "text": "キャラクター？デザイン、新しい"}, {"type": "subtitle", "time": 946.71, "timestamp": "00:15:46", "text": "こんにちは。私の声は大きすぎますか？それも話している"}, {"type": "subtitle", "time": 949.79, "timestamp": "00:15:49", "text": "多くの。それはマンガの音ですか？"}, {"type": "subtitle", "time": 952.79, "timestamp": "00:15:52", "text": "背景？わからない。わからない。"}]
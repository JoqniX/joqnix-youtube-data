[{"type": "subtitle", "time": 14703.03, "timestamp": "04:05:03", "text": "人生では、時にはそうせざるを得ないこともある。あなた"}, {"type": "subtitle", "time": 14705.67, "timestamp": "04:05:05", "text": "いつかはやらなければならない。 1日または"}, {"type": "subtitle", "time": 14707.51, "timestamp": "04:05:07", "text": "別の。あなたは、あなたは"}, {"type": "subtitle", "time": 14710.63, "timestamp": "04:05:10", "text": "クソ野郎は少なくとも一日で"}, {"type": "subtitle", "time": 14712.15, "timestamp": "04:05:12", "text": "あなたの仕事は完了です。嫌な奴になるな"}, {"type": "subtitle", "time": 14713.67, "timestamp": "04:05:13", "text": "時間。それは良くないだろう"}, {"type": "subtitle", "time": 14717.269, "timestamp": "04:05:17", "text": "あなた。うん。ええ、そうですね。それは良くない"}, {"type": "subtitle", "time": 14719.51, "timestamp": "04:05:19", "text": "あなたの健康。あなた自身、あるいはあなたの健康。あなた"}, {"type": "subtitle", "time": 14721.349, "timestamp": "04:05:21", "text": "許可する前に家事を済ませたい"}, {"type": "subtitle", "time": 14730.95, "timestamp": "04:05:30", "text": "えっと、一番醜い。レベル1の醜さ。私"}, {"type": "subtitle", "time": 14733.51, "timestamp": "04:05:33", "text": "私は重複して行うのが好きではありません"}, {"type": "subtitle", "time": 14736.389, "timestamp": "04:05:36", "text": "寝る前に家事を済ませる。私は普段"}, {"type": "subtitle", "time": 14738.55, "timestamp": "04:05:38", "text": "横になる。"}, {"type": "subtitle", "time": 14741.429, "timestamp": "04:05:41", "text": "どうぞ、Shさん。"}, {"type": "subtitle", "time": 14745.03, "timestamp": "04:05:45", "text": "いいえ、同じことを言っているだけです。私も。私も。"}, {"type": "subtitle", "time": 14750.309, "timestamp": "04:05:50", "text": "ああ、食事をしているんですね。"}, {"type": "subtitle", "time": 14753.349, "timestamp": "04:05:53", "text": "うん。とにかく、そうです。私はそうは思わない"}, {"type": "subtitle", "time": 14755.91, "timestamp": "04:05:55", "text": "繰り返して、私がしなければならないように"}, {"type": "subtitle", "time": 14757.83, "timestamp": "04:05:57", "text": "寝る前に家事をすべて済ませる。いいえ、"}]
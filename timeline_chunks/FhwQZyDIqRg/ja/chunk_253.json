[{"type": "subtitle", "time": 15181.429, "timestamp": "04:13:01", "text": "私を本当にイライラさせるようなことをさせる"}, {"type": "subtitle", "time": 15184.469, "timestamp": "04:13:04", "text": "私を放っておいて。だから、いいえ。私は反対します。のように"}, {"type": "subtitle", "time": 15186.95, "timestamp": "04:13:06", "text": "レベル３は同意しない。あなたは変わることができない"}, {"type": "subtitle", "time": 15189.75, "timestamp": "04:13:09", "text": "私の気分。少なくともそんなに早くは。"}, {"type": "subtitle", "time": 15191.99, "timestamp": "04:13:11", "text": "物理的な打撃が好きなら別ですが"}, {"type": "subtitle", "time": 15196.91, "timestamp": "04:13:16", "text": "物理的に殴られた。うん。それまでは、"}, {"type": "subtitle", "time": 15199.55, "timestamp": "04:13:19", "text": "いいえ。"}, {"type": "subtitle", "time": 15202.55, "timestamp": "04:13:22", "text": "反対です。あのね？私は変わることができる"}, {"type": "subtitle", "time": 15206.59, "timestamp": "04:13:26", "text": "気分がすぐに変わる。特定のH"}, {"type": "subtitle", "time": 15210.469, "timestamp": "04:13:30", "text": "場所。なあ、知ってるか？私は行くつもりです"}, {"type": "subtitle", "time": 15213.189, "timestamp": "04:13:33", "text": "レベル1の醜さで"}, {"type": "subtitle", "time": 15216.63, "timestamp": "04:13:36", "text": "時々。まるであなたが行くような"}, {"type": "subtitle", "time": 15220.87, "timestamp": "04:13:40", "text": "元気いっぱいの状態から、悲しい状態まで、そんな感じ。"}, {"type": "subtitle", "time": 15223.99, "timestamp": "04:13:43", "text": "えっと、まだそこまで達していません。おそらく全て"}, {"type": "subtitle", "time": 15225.75, "timestamp": "04:13:45", "text": "無作為化された。すべてがそうではないというわけではない"}, {"type": "subtitle", "time": 15228.309, "timestamp": "04:13:48", "text": "一枚の紙のようなもの。私たちは"}, {"type": "subtitle", "time": 15233.11, "timestamp": "04:13:53", "text": "質問がごちゃ混ぜになっている。うん。"}, {"type": "subtitle", "time": 15235.269, "timestamp": "04:13:55", "text": "わかった。次の質問は、あなたは"}, {"type": "subtitle", "time": 15237.309, "timestamp": "04:13:57", "text": "感情に左右されやすい"}, {"type": "subtitle", "time": 15239.429, "timestamp": "04:13:59", "text": "議論。あなたは感情に左右されない"}]
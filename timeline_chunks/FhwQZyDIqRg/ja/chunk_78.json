[{"type": "subtitle", "time": 4681.189, "timestamp": "01:18:01", "text": "サメ。"}, {"type": "subtitle", "time": 4683.75, "timestamp": "01:18:03", "text": "彼は好きですか 彼らは私たちが"}, {"type": "subtitle", "time": 4685.99, "timestamp": "01:18:05", "text": "誰かがそれをしたら経験値を失う？ああ、何"}, {"type": "subtitle", "time": 4687.51, "timestamp": "01:18:07", "text": "これですか？いいえ。いいえ、そうは思いません。私たちは"}, {"type": "subtitle", "time": 4689.11, "timestamp": "01:18:09", "text": "ここに座っていてください。私たちはただここに座っているだけです。うん、"}, {"type": "subtitle", "time": 4690.87, "timestamp": "01:18:10", "text": "それは、"}, {"type": "subtitle", "time": 4692.95, "timestamp": "01:18:12", "text": "君は小さいんだね。待って、なぜ"}, {"type": "subtitle", "time": 4695.83, "timestamp": "01:18:15", "text": "彼らに届くのにそんなに時間がかかるの？あなた あなた"}, {"type": "subtitle", "time": 4697.669, "timestamp": "01:18:17", "text": "スタミナをより早く回復できます"}, {"type": "subtitle", "time": 4699.35, "timestamp": "01:18:19", "text": "ここ。あなたがそこにいるなら、私はただ行くだけです"}, {"type": "subtitle", "time": 4702.39, "timestamp": "01:18:22", "text": "ここに座って。うん。うん。見て。見て。"}, {"type": "subtitle", "time": 4704.149, "timestamp": "01:18:24", "text": "さあ、皆さん。パーティーがあります"}, {"type": "subtitle", "time": 4706.55, "timestamp": "01:18:26", "text": "ここ。皆さん、私は何ももらえませんでした。私"}, {"type": "subtitle", "time": 4709.35, "timestamp": "01:18:29", "text": "何も得られなかった。スティーブ、私はそうしなかった。"}, {"type": "subtitle", "time": 4712.229, "timestamp": "01:18:32", "text": "うん。何もありません。君、君、ちっちゃな"}, {"type": "subtitle", "time": 4715.669, "timestamp": "01:18:35", "text": "このクソガキめ。なぜ"}, {"type": "subtitle", "time": 4717.59, "timestamp": "01:18:37", "text": "何をしているの？"}, {"type": "subtitle", "time": 4719.43, "timestamp": "01:18:39", "text": "なぜ長距離旅行を選びたいのですか？"}, {"type": "subtitle", "time": 4721.59, "timestamp": "01:18:41", "text": "ところで？うん。なぜこんなに長いのですか？おお、"}, {"type": "subtitle", "time": 4724.229, "timestamp": "01:18:44", "text": "もう一度やらなければならない。ああ、なんてこった。"}, {"type": "subtitle", "time": 4727.99, "timestamp": "01:18:47", "text": "おお。ああ、私たちはそれをきちんとやらなかった。"}, {"type": "subtitle", "time": 4732.07, "timestamp": "01:18:52", "text": "ああ、みんな。何だって？私は"}, {"type": "subtitle", "time": 4734.63, "timestamp": "01:18:54", "text": "えっと、ちょっと待って、なんでこんなに時間がかかるの？私"}, {"type": "subtitle", "time": 4736.07, "timestamp": "01:18:56", "text": "知る。我々には可能性があった"}, {"type": "subtitle", "time": 4738.55, "timestamp": "01:18:58", "text": "ここに来て1時間くらい経ちました"}]
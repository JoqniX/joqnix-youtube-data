[{"type": "subtitle", "time": 3367.48, "timestamp": "00:56:07", "text": "とんでもない。"}, {"type": "subtitle", "time": 3369.75, "timestamp": "00:56:09", "text": "[音楽]"}, {"type": "subtitle", "time": 3371.27, "timestamp": "00:56:11", "text": "そんな光景を見たのは初めてだ。これ"}, {"type": "subtitle", "time": 3373.19, "timestamp": "00:56:13", "text": "初めてです。一体何をしたんだ？"}, {"type": "subtitle", "time": 3376.549, "timestamp": "00:56:16", "text": "ジョン、君は勝っていたよ。"}, {"type": "subtitle", "time": 3384.23, "timestamp": "00:56:24", "text": "アヒルちゃん？何てことだ。"}, {"type": "subtitle", "time": 3386.47, "timestamp": "00:56:26", "text": "つまり、試合は何回で終わったか"}, {"type": "subtitle", "time": 3388.15, "timestamp": "00:56:28", "text": "私たちが参加してから何分経ちましたか？ 30分。"}, {"type": "subtitle", "time": 3390.87, "timestamp": "00:56:30", "text": "これで終わりですか？おお。うん。くそ。"}, {"type": "subtitle", "time": 3392.549, "timestamp": "00:56:32", "text": "大丈夫です。大丈夫です。おお。終わらせる"}, {"type": "subtitle", "time": 3394.23, "timestamp": "00:56:34", "text": "ストリーム。"}, {"type": "subtitle", "time": 3396.63, "timestamp": "00:56:36", "text": "配信を終了します。"}, {"type": "subtitle", "time": 3401.589, "timestamp": "00:56:41", "text": "すばらしい。ああ、神様。こんにちは。もう一度やってみよう。"}, {"type": "subtitle", "time": 3408.63, "timestamp": "00:56:48", "text": "ああ、おい。みんながどうやって遊ぶのか分からない"}, {"type": "subtitle", "time": 3410.71, "timestamp": "00:56:50", "text": "このソロ。だから、私はこれを見ていた"}, {"type": "subtitle", "time": 3412.47, "timestamp": "00:56:52", "text": "YouTube のこの人がソロを演奏するのが好きです"}, {"type": "subtitle", "time": 3415.589, "timestamp": "00:56:55", "text": "そして彼は約200レベルで"}, {"type": "subtitle", "time": 3418.23, "timestamp": "00:56:58", "text": "彼はただそれを演奏しているだけだ"}]
[{"type": "subtitle", "time": 12782.07, "timestamp": "03:33:02", "text": "一般化。例えば、私の"}, {"type": "subtitle", "time": 12783.91, "timestamp": "03:33:03", "text": "INFP。"}, {"type": "subtitle", "time": 12786.469, "timestamp": "03:33:06", "text": "それは仲介者みたいなものですね。"}, {"type": "subtitle", "time": 12788.91, "timestamp": "03:33:08", "text": "つまり私は68％"}, {"type": "subtitle", "time": 12791.229, "timestamp": "03:33:11", "text": "内向的、74歳"}, {"type": "subtitle", "time": 12795.229, "timestamp": "03:33:15", "text": "直感的で、78％が感覚的で、"}, {"type": "subtitle", "time": 12800.07, "timestamp": "03:33:20", "text": "56%が探査、63%が乱気流"}, {"type": "subtitle", "time": 12802.71, "timestamp": "03:33:22", "text": "あるいは、そんな感じ。つまり、私が読むとき"}, {"type": "subtitle", "time": 12806.229, "timestamp": "03:33:26", "text": "この詳細全体は私の"}, {"type": "subtitle", "time": 12808.87, "timestamp": "03:33:28", "text": "物事の強さと私の弱さ"}, {"type": "subtitle", "time": 12812.389, "timestamp": "03:33:32", "text": "誰かが私のことを知っていて、"}, {"type": "subtitle", "time": 12815.63, "timestamp": "03:33:35", "text": "書いたか何かでしょう。その"}, {"type": "subtitle", "time": 12824.15, "timestamp": "03:33:44", "text": "ここ。うん。あなたの強さ、"}, {"type": "subtitle", "time": 12826.469, "timestamp": "03:33:46", "text": "個人の価値観、どのように"}, {"type": "subtitle", "time": 12829.11, "timestamp": "03:33:49", "text": "人間関係はどうですか？"}, {"type": "subtitle", "time": 12831.63, "timestamp": "03:33:51", "text": "精神的にも、肉体的にも、その他すべて。"}, {"type": "subtitle", "time": 12834.55, "timestamp": "03:33:54", "text": "物事、あなたのキャリアパスがどうなるか"}, {"type": "subtitle", "time": 12838.44, "timestamp": "03:33:58", "text": "などなど。そういうクールな感じが好きです。"}]
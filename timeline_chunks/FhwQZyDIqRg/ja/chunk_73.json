[{"type": "subtitle", "time": 4381.35, "timestamp": "01:13:01", "text": "もの？禅はどこにあるの？ああ、わかりました。"}, {"type": "subtitle", "time": 4383.27, "timestamp": "01:13:03", "text": "ここに来て。どこ？"}, {"type": "subtitle", "time": 4386.39, "timestamp": "01:13:06", "text": "こっちです。ああ、こちらです。開けて"}, {"type": "subtitle", "time": 4389.59, "timestamp": "01:13:09", "text": "このような。開けてみて"}, {"type": "subtitle", "time": 4391.27, "timestamp": "01:13:11", "text": "ああ、それは二階に行くんだ。いや、いや、いや、いや。"}, {"type": "subtitle", "time": 4393.83, "timestamp": "01:13:13", "text": "待って。ここに来てやってみて。うん。全て"}, {"type": "subtitle", "time": 4397.63, "timestamp": "01:13:17", "text": "右。わかった。わかった。わかった。やったよ。うん。"}, {"type": "subtitle", "time": 4400.229, "timestamp": "01:13:20", "text": "誰かが私。"}, {"type": "subtitle", "time": 4402.95, "timestamp": "01:13:22", "text": "よし。迎えに行きますよ。 A. あなた"}, {"type": "subtitle", "time": 4405.91, "timestamp": "01:13:25", "text": "すごく可愛いね。行き詰まってしまった。行き詰まってしまった。私は"}, {"type": "subtitle", "time": 4407.91, "timestamp": "01:13:27", "text": "そこへは行かせないわよ、ベイビーガール。"}, {"type": "subtitle", "time": 4409.99, "timestamp": "01:13:29", "text": "そこへは行かせません。ない"}, {"type": "subtitle", "time": 4413.189, "timestamp": "01:13:33", "text": "あなたを手放す。おいおい、頼むよ。停止"}, {"type": "subtitle", "time": 4418.95, "timestamp": "01:13:38", "text": "私を放っておいて。おい、それを受け取らないで。来る"}, {"type": "subtitle", "time": 4420.229, "timestamp": "01:13:40", "text": "ここ。来る。すぐにやります"}, {"type": "subtitle", "time": 4421.51, "timestamp": "01:13:41", "text": "それ。はい。はい。はい。はい。よし。全て"}, {"type": "subtitle", "time": 4423.27, "timestamp": "01:13:43", "text": "右。私はここにいます。さあ行こう。選ばないで"}, {"type": "subtitle", "time": 4425.229, "timestamp": "01:13:45", "text": "彼を立ち上がらせた。誓います"}, {"type": "subtitle", "time": 4430.42, "timestamp": "01:13:50", "text": "神。そんなことはしないでください。わかった。私たちはただ"}, {"type": "subtitle", "time": 4433.99, "timestamp": "01:13:53", "text": "[笑い]"}, {"type": "subtitle", "time": 4436.31, "timestamp": "01:13:56", "text": "やってみます。私はそれを推し進めます"}, {"type": "subtitle", "time": 4438.51, "timestamp": "01:13:58", "text": "トイレの中で。"}]
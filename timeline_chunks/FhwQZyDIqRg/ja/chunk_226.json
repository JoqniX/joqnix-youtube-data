[{"type": "subtitle", "time": 13561.15, "timestamp": "03:46:01", "text": "私はそんなことはしません"}, {"type": "subtitle", "time": 13563.349, "timestamp": "03:46:03", "text": "あなたが興味を持たないもの"}, {"type": "subtitle", "time": 13565.189, "timestamp": "03:46:05", "text": "議論はどうぞ"}, {"type": "subtitle", "time": 13567.309, "timestamp": "03:46:07", "text": "何か言うつもりですか"}, {"type": "subtitle", "time": 13570.15, "timestamp": "03:46:10", "text": "いや、私もそうしようと思っていたんだ"}, {"type": "subtitle", "time": 13576.95, "timestamp": "03:46:16", "text": "ちょっと待って、開けてみるね"}, {"type": "subtitle", "time": 13580.229, "timestamp": "03:46:20", "text": "わかった。私は、ええ、そうです。うん。"}, {"type": "subtitle", "time": 13581.269, "timestamp": "03:46:21", "text": "お願い、お願い、お願い、お願い、お願い"}, {"type": "subtitle", "time": 13588.63, "timestamp": "03:46:28", "text": "わかった。うん、行こう。ああ、私は"}, {"type": "subtitle", "time": 13590.55, "timestamp": "03:46:30", "text": "最初からやり直すべきでしょうか"}, {"type": "subtitle", "time": 13592.79, "timestamp": "03:46:32", "text": "テスト？いや、いや、いや、いや。続く。続く"}, {"type": "subtitle", "time": 13595.75, "timestamp": "03:46:35", "text": "あなたの。心配ない。よし、やろう"}, {"type": "subtitle", "time": 13600.15, "timestamp": "03:46:40", "text": "では、一緒に。うん。わかった。ああ、わかった。私 私"}, {"type": "subtitle", "time": 13602.71, "timestamp": "03:46:42", "text": "私はただテストを一時停止するだけです"}, {"type": "subtitle", "time": 13605.349, "timestamp": "03:46:45", "text": "この場所に着くまで。どこで"}, {"type": "subtitle", "time": 13607.51, "timestamp": "03:46:47", "text": "あなたは読んだ"}, {"type": "subtitle", "time": 13610.71, "timestamp": "03:46:50", "text": "また好きですか？はい。あなたが感じるあなたみたいに"}, {"type": "subtitle", "time": 13612.07, "timestamp": "03:46:52", "text": "人に近づいていくのが気楽な人"}, {"type": "subtitle", "time": 13613.269, "timestamp": "03:46:53", "text": "興味深いものを見つけて、"}, {"type": "subtitle", "time": 13614.95, "timestamp": "03:46:54", "text": "会話。それが私の疑問です。それは"}, {"type": "subtitle", "time": 13617.75, "timestamp": "03:46:57", "text": "私はそこにいます。待っていればいい"}]
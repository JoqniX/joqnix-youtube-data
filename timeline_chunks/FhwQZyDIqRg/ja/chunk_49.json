[{"type": "subtitle", "time": 2944.15, "timestamp": "00:49:04", "text": "待って、なぜ彼は蘇生しないの？"}, {"type": "subtitle", "time": 2947.43, "timestamp": "00:49:07", "text": "ああ、あなたが呪文を唱えれば彼は蘇るでしょう。"}, {"type": "subtitle", "time": 2950.47, "timestamp": "00:49:10", "text": "だから、彼をここに留めておく必要があるんだ。いいえ、私たちは"}, {"type": "subtitle", "time": 2952.79, "timestamp": "00:49:12", "text": "別の脱出地点へ行かなければならない。"}, {"type": "subtitle", "time": 2956.79, "timestamp": "00:49:16", "text": "この抽出地点は閉鎖されています。ああ、私たちは"}, {"type": "subtitle", "time": 2958.63, "timestamp": "00:49:18", "text": "何かを探さなきゃ。ちなみに、私は"}, {"type": "subtitle", "time": 2961.91, "timestamp": "00:49:21", "text": "26馬力だから、もうお手上げ状態だ。同じ。"}, {"type": "subtitle", "time": 2965.349, "timestamp": "00:49:25", "text": "私のHPを教えてもいいですか？"}, {"type": "subtitle", "time": 2973.99, "timestamp": "00:49:33", "text": "ええと、今は渡せないと思います。"}, {"type": "subtitle", "time": 2976.15, "timestamp": "00:49:36", "text": "うん、君はやり遂げたね。そうそう。"}, {"type": "subtitle", "time": 2981.19, "timestamp": "00:49:41", "text": "どうやってやったんですか？動作が遅いと思う。"}, {"type": "subtitle", "time": 2982.71, "timestamp": "00:49:42", "text": "見ないで。見ないで。"}, {"type": "subtitle", "time": 2984.95, "timestamp": "00:49:44", "text": "見ないで。見ちゃダメだよ、ジョー。"}, {"type": "subtitle", "time": 2986.47, "timestamp": "00:49:46", "text": "見ないで。目をそらしてください。目をそらしてください。"}, {"type": "subtitle", "time": 2987.75, "timestamp": "00:49:47", "text": "目をそらしてください。ねえ、それを見てみたいんだけど。"}, {"type": "subtitle", "time": 2990.27, "timestamp": "00:49:50", "text": "あれはすごくかっこよかった。もう一度やってみて。"}, {"type": "subtitle", "time": 2994.15, "timestamp": "00:49:54", "text": "何？兄弟、"}, {"type": "subtitle", "time": 2997.51, "timestamp": "00:49:57", "text": "何てことだ。"}, {"type": "subtitle", "time": 2998.87, "timestamp": "00:49:58", "text": "よし、彼が来るぞ。彼が来る。走る。"}]
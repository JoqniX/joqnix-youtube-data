[{"type": "subtitle", "time": 5700.47, "timestamp": "01:35:00", "text": "彼女はここにいる。彼女はここにいる。え？さあ"}, {"type": "subtitle", "time": 5702.95, "timestamp": "01:35:02", "text": "行く。さあ行こう。トラックの中に入ってください。"}, {"type": "subtitle", "time": 5705.27, "timestamp": "01:35:05", "text": "私がひそかに始めたと想像してみてください。"}, {"type": "subtitle", "time": 5706.95, "timestamp": "01:35:06", "text": "みんな、ここにアヒルがいるよ。私はしません"}, {"type": "subtitle", "time": 5711.189, "timestamp": "01:35:11", "text": "知る。触らないでください。触らないでください。おお"}, {"type": "subtitle", "time": 5715.59, "timestamp": "01:35:15", "text": "我が神よ。何てことだ。私はそれには触らない。"}, {"type": "subtitle", "time": 5719.91, "timestamp": "01:35:19", "text": "ああ、なんてこった。ああ、くそ。何てことだ。の"}, {"type": "subtitle", "time": 5725.59, "timestamp": "01:35:25", "text": "くそ？あなたはタイミングについてそう言いましたね。何てことだ。"}, {"type": "subtitle", "time": 5728.55, "timestamp": "01:35:28", "text": "ベイビー、私が触っている間は触らないでって言ったでしょ"}, {"type": "subtitle", "time": 5731.51, "timestamp": "01:35:31", "text": "それに触れていた。何てことだ。まあ、君は"}, {"type": "subtitle", "time": 5734.149, "timestamp": "01:35:34", "text": "と言えば、"}, {"type": "subtitle", "time": 5738.79, "timestamp": "01:35:38", "text": "ゾンビ。なんてこった。ああ、くそ。そうですね。どうやって"}, {"type": "subtitle", "time": 5741.99, "timestamp": "01:35:41", "text": "私たちはどれだけの資産を持っているのだろうか？ 13,000人います。手に入れます"}, {"type": "subtitle", "time": 5744.55, "timestamp": "01:35:44", "text": "宙返りジャンプをしています。タンブル"}, {"type": "subtitle", "time": 5746.709, "timestamp": "01:35:46", "text": "打ち上げ。私も1つ買います。あなたは"}, {"type": "subtitle", "time": 5751.189, "timestamp": "01:35:51", "text": "何ですって？えーっと、タンブルジャンプ。はい。の"}, {"type": "subtitle", "time": 5752.79, "timestamp": "01:35:52", "text": "ジャーク。今は選ばないでください。"}, {"type": "subtitle", "time": 5755.189, "timestamp": "01:35:55", "text": "1万ドルくらいだよ、兄弟。いや、気にしないで。あなた"}, {"type": "subtitle", "time": 5757.83, "timestamp": "01:35:57", "text": "選ぶことができます。どうでも。 5キロ。ごめん。うん。"}]
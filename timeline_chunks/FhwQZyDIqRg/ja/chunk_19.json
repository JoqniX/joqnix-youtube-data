[{"type": "subtitle", "time": 1140.23, "timestamp": "00:19:00", "text": "実際、そして私はとても"}, {"type": "subtitle", "time": 1142.39, "timestamp": "00:19:02", "text": "私はデザインにとても不満を感じていました"}, {"type": "subtitle", "time": 1146.23, "timestamp": "00:19:06", "text": "私が求めていた具体的なものすべてが必要です"}, {"type": "subtitle", "time": 1149.19, "timestamp": "00:19:09", "text": "などなど。私はとても心配で混乱していました。"}, {"type": "subtitle", "time": 1151.75, "timestamp": "00:19:11", "text": "どうしよう、どうしよう。実際には"}, {"type": "subtitle", "time": 1153.95, "timestamp": "00:19:13", "text": "それについて考えてみたりもした。"}, {"type": "subtitle", "time": 1157.11, "timestamp": "00:19:17", "text": "でも私は自分の時間も彼女の時間も取った"}, {"type": "subtitle", "time": 1158.59, "timestamp": "00:19:18", "text": "私を助けてくれた"}, {"type": "subtitle", "time": 1162.23, "timestamp": "00:19:22", "text": "多く。彼女は私をとても助けてくれた。つまり、彼女は"}, {"type": "subtitle", "time": 1166.31, "timestamp": "00:19:26", "text": "私にとってとても役立ちました"}, {"type": "subtitle", "time": 1168.549, "timestamp": "00:19:28", "text": "えーと、私が"}, {"type": "subtitle", "time": 1172.63, "timestamp": "00:19:32", "text": "気に入ったデザインです。彼女はとても親切だった"}, {"type": "subtitle", "time": 1176.87, "timestamp": "00:19:36", "text": "実に甘くて十分だ。"}, {"type": "subtitle", "time": 1178.669, "timestamp": "00:19:38", "text": "私を助けて"}, {"type": "subtitle", "time": 1182.87, "timestamp": "00:19:42", "text": "デザイン。ごめん。そこで私たちは連絡を取りました"}, {"type": "subtitle", "time": 1187.27, "timestamp": "00:19:47", "text": "お互いに、えーと、私は最終的に"}, {"type": "subtitle", "time": 1189.47, "timestamp": "00:19:49", "text": "最終製品とは"}, {"type": "subtitle", "time": 1195.23, "timestamp": "00:19:55", "text": "これ。ねえ、これは特別な特別な"}]
[{"type": "subtitle", "time": 6548.39, "timestamp": "01:49:08", "text": "最悪だ。彼らは私を置いていったか、"}, {"type": "subtitle", "time": 6552.83, "timestamp": "01:49:12", "text": "この辺りには幽霊がいる。そして私はできる"}, {"type": "subtitle", "time": 6560.55, "timestamp": "01:49:20", "text": "聞こえますよ。そこにいる？はい。これ"}, {"type": "subtitle", "time": 6563.91, "timestamp": "01:49:23", "text": "方法。君の姿が見えない。ここに来てください。"}, {"type": "subtitle", "time": 6565.27, "timestamp": "01:49:25", "text": "私はここにいます。さあ、さあ、さあ。だった"}, {"type": "subtitle", "time": 6568.79, "timestamp": "01:49:28", "text": "出発します。よし、行こう。"}, {"type": "subtitle", "time": 6571.709, "timestamp": "01:49:31", "text": "走る。私は走っています。私は走っています。私たちは発見しました"}, {"type": "subtitle", "time": 6575.109, "timestamp": "01:49:35", "text": "彼女。私たちは彼女を見つけた。なんてこった。彼女は死んだ。"}, {"type": "subtitle", "time": 6578.07, "timestamp": "01:49:38", "text": "彼女は死んだ。彼女は死んだ。いいえ。いいえ。いいえ。いいえ。"}, {"type": "subtitle", "time": 6580.229, "timestamp": "01:49:40", "text": "だめだ。だめだ。だめだ。お願いだから、そんなことはしないで。走る。"}, {"type": "subtitle", "time": 6581.669, "timestamp": "01:49:41", "text": "走る。走る。"}, {"type": "subtitle", "time": 6584.79, "timestamp": "01:49:44", "text": "走れ。"}, {"type": "subtitle", "time": 6588.55, "timestamp": "01:49:48", "text": "私は走れない。私は走れない。私は走れない。"}, {"type": "subtitle", "time": 6593.39, "timestamp": "01:49:53", "text": "くそっ。ああ、走れないよ。何てことだ。ああ、"}, {"type": "subtitle", "time": 6596.83, "timestamp": "01:49:56", "text": "神。私は"}]
[{"type": "subtitle", "time": 420.07, "timestamp": "00:07:00", "text": "すべての努力と同じように"}, {"type": "subtitle", "time": 423.189, "timestamp": "00:07:03", "text": "ああ、私にはできないって分かってるよ"}, {"type": "subtitle", "time": 426.23, "timestamp": "00:07:06", "text": "一人で、私はいつも自分に頼っていた"}, {"type": "subtitle", "time": 429.51, "timestamp": "00:07:09", "text": "全て一人でやりました。"}, {"type": "subtitle", "time": 432.23, "timestamp": "00:07:12", "text": "私はアートからすべてをやりたかった"}, {"type": "subtitle", "time": 433.71, "timestamp": "00:07:13", "text": "デザイン"}, {"type": "subtitle", "time": 437.469, "timestamp": "00:07:17", "text": "3D関連のものまで含めてすべて"}, {"type": "subtitle", "time": 439.909, "timestamp": "00:07:19", "text": "他に計画していたことは"}, {"type": "subtitle", "time": 442.749, "timestamp": "00:07:22", "text": "将来は、私一人ではできない"}, {"type": "subtitle", "time": 447.83, "timestamp": "00:07:27", "text": "自分一人ではできないと分かっていたし、"}, {"type": "subtitle", "time": 450.43, "timestamp": "00:07:30", "text": "私は本当にイライラしていて"}, {"type": "subtitle", "time": 452.189, "timestamp": "00:07:32", "text": "もの"}, {"type": "subtitle", "time": 460.30899999999997, "timestamp": "00:07:40", "text": "でも私はあなたたち全員に会ったから"}, {"type": "subtitle", "time": 462.79, "timestamp": "00:07:42", "text": "今のところ、私のコミュニティに電話してください。わかりません。"}, {"type": "subtitle", "time": 466.15, "timestamp": "00:07:46", "text": "もしそうすべきなら、つまりこれを修正したいのですが"}, {"type": "subtitle", "time": 468.469, "timestamp": "00:07:48", "text": "私たちのための恒久的な名前"}, {"type": "subtitle", "time": 472.43, "timestamp": "00:07:52", "text": "コミュニティ 私のコミュニティ 私 私たち自身 あなた"}]
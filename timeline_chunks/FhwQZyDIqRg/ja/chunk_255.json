[{"type": "subtitle", "time": 15301.75, "timestamp": "04:15:01", "text": "だから私は簡単には動揺しない"}, {"type": "subtitle", "time": 15306.229, "timestamp": "04:15:06", "text": "感情的。私は大丈夫ではないでしょう"}, {"type": "subtitle", "time": 15309.269, "timestamp": "04:15:09", "text": "人々。いやいやいやいやいや。見てみます"}, {"type": "subtitle", "time": 15312.469, "timestamp": "04:15:12", "text": "その理屈はもっともだ。推論が、"}, {"type": "subtitle", "time": 15314.55, "timestamp": "04:15:14", "text": "ああ、この10人の子供を殺さなければならない"}, {"type": "subtitle", "time": 15316.429, "timestamp": "04:15:16", "text": "人々のために。私はこう思う、"}, {"type": "subtitle", "time": 15319.189, "timestamp": "04:15:19", "text": "いいえ、私は何も殺しません"}, {"type": "subtitle", "time": 15321.149, "timestamp": "04:15:21", "text": "人々。どうもありがとうございました"}, {"type": "subtitle", "time": 15323.91, "timestamp": "04:15:23", "text": "多くの。だから、いいえ、私は簡単には"}, {"type": "subtitle", "time": 15326.79, "timestamp": "04:15:26", "text": "感情的な議論に影響される。いいえ。いいえ"}, {"type": "subtitle", "time": 15328.87, "timestamp": "04:15:28", "text": "風船とチーズ。そして私は同意します"}, {"type": "subtitle", "time": 15331.03, "timestamp": "04:15:31", "text": "それ。レベル３：同意する。私はそうしない"}, {"type": "subtitle", "time": 15339.11, "timestamp": "04:15:39", "text": "あなたはよく登録しますね。どうぞ。だから私も"}, {"type": "subtitle", "time": 15342.149, "timestamp": "04:15:42", "text": "一つは、時々感情的になる"}, {"type": "subtitle", "time": 15344.07, "timestamp": "04:15:44", "text": "揺れた。"}, {"type": "subtitle", "time": 15347.91, "timestamp": "04:15:47", "text": "わからない、だってわからないから"}, {"type": "subtitle", "time": 15350.229, "timestamp": "04:15:50", "text": "私が人に好かれようとするタイプだから？私はしません"}, {"type": "subtitle", "time": 15354.149, "timestamp": "04:15:54", "text": "知る。それも良くない。それを使う理由は"}, {"type": "subtitle", "time": 15356.309, "timestamp": "04:15:56", "text": "実際に人に好かれようとする人を見たら"}, {"type": "subtitle", "time": 15359.429, "timestamp": "04:15:59", "text": "「えーと、私はそうじゃない」って言うだろう。あなたはするであろう"}]
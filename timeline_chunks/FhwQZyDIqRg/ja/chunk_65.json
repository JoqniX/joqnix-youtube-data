[{"type": "subtitle", "time": 3902.109, "timestamp": "01:05:02", "text": "そして、私たちは再び戻ってきました。彼はただ彼はただ"}, {"type": "subtitle", "time": 3904.789, "timestamp": "01:05:04", "text": "そう、段階を踏んでいくんだ。ああ、彼女は"}, {"type": "subtitle", "time": 3905.95, "timestamp": "01:05:05", "text": "着用"}, {"type": "subtitle", "time": 3909.91, "timestamp": "01:05:09", "text": "王冠、王冠。おお。"}, {"type": "subtitle", "time": 3913.43, "timestamp": "01:05:13", "text": "うん。何てことだ。ああ、なんてことだ。私たちは"}, {"type": "subtitle", "time": 3915.27, "timestamp": "01:05:15", "text": "今後の戦略のようなものはありますか？なぜなら"}, {"type": "subtitle", "time": 3916.63, "timestamp": "01:05:16", "text": "まるで私たちはそうではないように見える"}, {"type": "subtitle", "time": 3918.069, "timestamp": "01:05:18", "text": "自分たちがどこへ向かっているのかを知る。私たちは"}, {"type": "subtitle", "time": 3919.829, "timestamp": "01:05:19", "text": "すべきことは、私たちが集まることです"}, {"type": "subtitle", "time": 3922.23, "timestamp": "01:05:22", "text": "十分なお金があれば、ただ行って経験すればいい。"}, {"type": "subtitle", "time": 3924.309, "timestamp": "01:05:24", "text": "うん。はい。良いアイデア。良いアイデア。私は"}, {"type": "subtitle", "time": 3925.91, "timestamp": "01:05:25", "text": "君たちに言ったけど、君たちは"}, {"type": "subtitle", "time": 3930.39, "timestamp": "01:05:30", "text": "聞く。はい。はい。お前のせいで俺は死んだんだ。"}, {"type": "subtitle", "time": 3932.87, "timestamp": "01:05:32", "text": "ごめんよ。"}, {"type": "subtitle", "time": 3936.87, "timestamp": "01:05:36", "text": "つまり、私個人としては、"}, {"type": "subtitle", "time": 3938.71, "timestamp": "01:05:38", "text": "彼は文字通り突然現れるだろう。私は知っていた"}, {"type": "subtitle", "time": 3941.349, "timestamp": "01:05:41", "text": "ええ、私はその子孫を知っていました。私は彼が"}, {"type": "subtitle", "time": 3944.63, "timestamp": "01:05:44", "text": "既にそこにあった。そして、私はそれを呼んだ"}, {"type": "subtitle", "time": 3947.23, "timestamp": "01:05:47", "text": "外。私はそれを指摘した、"}, {"type": "subtitle", "time": 3950.43, "timestamp": "01:05:50", "text": "みんな。来て。うん。群衆を覚えている"}, {"type": "subtitle", "time": 3954.069, "timestamp": "01:05:54", "text": "私はどこにいたのか、つまり、どこにいたのかわかりません。"}, {"type": "subtitle", "time": 3955.99, "timestamp": "01:05:55", "text": "だから私はしゃがんで、"}, {"type": "subtitle", "time": 3957.67, "timestamp": "01:05:57", "text": "もしあなたが"}, {"type": "subtitle", "time": 3959.109, "timestamp": "01:05:59", "text": "ソファに座っているときにしゃがむことはできますか、"}]
[{"type": "subtitle", "time": 12301.91, "timestamp": "03:25:01", "text": "はぁ？え、何？どういう意味ですか？待って。"}, {"type": "subtitle", "time": 12310.15, "timestamp": "03:25:10", "text": "心配しないで。待って、待って、待って、"}, {"type": "subtitle", "time": 12312.07, "timestamp": "03:25:12", "text": "待って、待って。自分の曲を聴かせてくれよ。"}, {"type": "subtitle", "time": 12314.51, "timestamp": "03:25:14", "text": "え、何？"}, {"type": "subtitle", "time": 12316.52, "timestamp": "03:25:16", "text": "何？ 不和。あなたは何をしていますか？"}, {"type": "subtitle", "time": 12323.19, "timestamp": "03:25:23", "text": "Discordは何をするのですか？"}, {"type": "subtitle", "time": 12324.309, "timestamp": "03:25:24", "text": "[音楽]"}, {"type": "subtitle", "time": 12328.07, "timestamp": "03:25:28", "text": "あなたはオーディブルです。何？"}, {"type": "subtitle", "time": 12329.63, "timestamp": "03:25:29", "text": "つまり、私はここにいる"}, {"type": "subtitle", "time": 12333.03, "timestamp": "03:25:33", "text": "なぜならストリームだからです。"}, {"type": "subtitle", "time": 12355.59, "timestamp": "03:25:55", "text": "ああ、君の声は聞こえるよ。"}, {"type": "subtitle", "time": 12358.95, "timestamp": "03:25:58", "text": "あなたの声は聞こえます。うん、"}]
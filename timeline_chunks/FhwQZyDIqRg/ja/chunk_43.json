[{"type": "subtitle", "time": 2580.96, "timestamp": "00:43:00", "text": "では、誰が運ぶのか？はい、あなたは それを運ぶつもりです。私は運ぶつもりです"}, {"type": "subtitle", "time": 2583.24, "timestamp": "00:43:03", "text": "それを運ぶつもりです。私は運ぶつもりです それ。運転が下手だ。ああ、だめだ。"}, {"type": "subtitle", "time": 2592.23, "timestamp": "00:43:12", "text": "みんな、みんな、みんな、私は運転免許を持っていません"}, {"type": "subtitle", "time": 2594.309, "timestamp": "00:43:14", "text": "ライセンス。ごめん、チャド。それを私にください。私"}, {"type": "subtitle", "time": 2596.069, "timestamp": "00:43:16", "text": "一つ持っています。私は有効なものを持っています。私は走っています"}, {"type": "subtitle", "time": 2599.109, "timestamp": "00:43:19", "text": "あなたから離れて。どこにいるの？私のミスです。私の"}, {"type": "subtitle", "time": 2601.829, "timestamp": "00:43:21", "text": "悪い。なぜこんなにたくさんのクモがいるのか"}, {"type": "subtitle", "time": 2603.349, "timestamp": "00:43:23", "text": "ウェブ、"}, {"type": "subtitle", "time": 2605.19, "timestamp": "00:43:25", "text": "みんな？私たちは既に物を持っています。私たちは"}, {"type": "subtitle", "time": 2607.27, "timestamp": "00:43:27", "text": "既に持っているもの。拾い続けなさい。"}, {"type": "subtitle", "time": 2609.109, "timestamp": "00:43:29", "text": "拾い続けなさい。そこに置いておきますね。"}, {"type": "subtitle", "time": 2611.109, "timestamp": "00:43:31", "text": "何てことだ。私たちは本当に"}, {"type": "subtitle", "time": 2613.19, "timestamp": "00:43:33", "text": "値段が高いし、ちょっと重そうに見える。"}, {"type": "subtitle", "time": 2617.27, "timestamp": "00:43:37", "text": "ああ、重い。わかりました、"}, {"type": "subtitle", "time": 2620.309, "timestamp": "00:43:40", "text": "逃げる。みんな、私は"}, {"type": "subtitle", "time": 2621.99, "timestamp": "00:43:41", "text": "あなたは引っ越さなければならないでしょう、なぜなら私は"}, {"type": "subtitle", "time": 2625.349, "timestamp": "00:43:45", "text": "何か本当に"}, {"type": "subtitle", "time": 2629.51, "timestamp": "00:43:49", "text": "それであなたを驚かせてやる。私が手伝います。"}, {"type": "subtitle", "time": 2631.99, "timestamp": "00:43:51", "text": "さあ行こう。ただひたすら来続けてください。"}, {"type": "subtitle", "time": 2634.39, "timestamp": "00:43:54", "text": "どんどん来てください。どんどん来てください。ただ"}, {"type": "subtitle", "time": 2636.309, "timestamp": "00:43:56", "text": "続けて来てください。どこかにずっと留まっていればいい。"}, {"type": "subtitle", "time": 2638.47, "timestamp": "00:43:58", "text": "私はどこかで立ち往生している。ああ、君は行き詰まっている"}]
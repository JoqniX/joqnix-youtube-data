[{"type": "subtitle", "time": 3061.03, "timestamp": "00:51:01", "text": "いいえ。なんてこった。"}, {"type": "subtitle", "time": 3065.67, "timestamp": "00:51:05", "text": "走れ、走れ、走れ。どうやって走ればいいですか？シフト。おお、"}, {"type": "subtitle", "time": 3068.309, "timestamp": "00:51:08", "text": "待って。大丈夫です。大丈夫です。おお。ああ、私たちは"}, {"type": "subtitle", "time": 3070.63, "timestamp": "00:51:10", "text": "シフト。おお。何てことだ。私たちは復活させなかった"}, {"type": "subtitle", "time": 3072.39, "timestamp": "00:51:12", "text": "あの男。彼は私の味方だった。私たち二人とも"}, {"type": "subtitle", "time": 3074.23, "timestamp": "00:51:14", "text": "共に亡くなった。彼はどこにいますか？彼は中にいる"}, {"type": "subtitle", "time": 3076.71, "timestamp": "00:51:16", "text": "この物。車の中にあります。"}, {"type": "subtitle", "time": 3080.63, "timestamp": "00:51:20", "text": "うん。ああ、もう。なぜ彼は行かないのだろうか？私たちは"}, {"type": "subtitle", "time": 3081.75, "timestamp": "00:51:21", "text": "まだ2つ目を見つける必要がある"}, {"type": "subtitle", "time": 3084.87, "timestamp": "00:51:24", "text": "抽出。それだけですか？うん。我々には必要だ"}, {"type": "subtitle", "time": 3087.19, "timestamp": "00:51:27", "text": "1"}, {"type": "subtitle", "time": 3088.589, "timestamp": "00:51:28", "text": "おお、"}, {"type": "subtitle", "time": 3097.349, "timestamp": "00:51:37", "text": "それがなくなってしまったかどうかは分からないよ、兄弟。私たちは"}, {"type": "subtitle", "time": 3098.63, "timestamp": "00:51:38", "text": "目的は達成されたのでしょうか？のように、"}, {"type": "subtitle", "time": 3101.27, "timestamp": "00:51:41", "text": "私たちはただ、それらを復活させなければならない。私たちは"}, {"type": "subtitle", "time": 3102.47, "timestamp": "00:51:42", "text": "2つ目の気晴らしを見つける必要がある"}, {"type": "subtitle", "time": 3104.63, "timestamp": "00:51:44", "text": "指し示して、もっと好きなものを見つけて入れる"}, {"type": "subtitle", "time": 3107.589, "timestamp": "00:51:47", "text": "その物。うん。おお。そこは"}, {"type": "subtitle", "time": 3111.109, "timestamp": "00:51:51", "text": "血は？右上のように"}, {"type": "subtitle", "time": 3113.27, "timestamp": "00:51:53", "text": "コーナー。一つずつと書いてあるけど。それで、"}, {"type": "subtitle", "time": 3115.349, "timestamp": "00:51:55", "text": "頂上には1つしかなかった、"}, {"type": "subtitle", "time": 3117.03, "timestamp": "00:51:57", "text": "右？"}, {"type": "subtitle", "time": 3119.43, "timestamp": "00:51:59", "text": "ええ、そうです。抽出ポイント1箇所。行け、行け、"}]
[{"type": "subtitle", "time": 6304.229, "timestamp": "01:45:04", "text": "ああ、もし何かあったら。何"}, {"type": "subtitle", "time": 6305.75, "timestamp": "01:45:05", "text": "何が起こったのか？どうしたの？どうしたの？"}, {"type": "subtitle", "time": 6307.35, "timestamp": "01:45:07", "text": "HPを確認してください。あなた"}, {"type": "subtitle", "time": 6309.27, "timestamp": "01:45:09", "text": "爆発した。それは今も変わっていません。"}, {"type": "subtitle", "time": 6311.83, "timestamp": "01:45:11", "text": "どうでも。"}, {"type": "subtitle", "time": 6314.149, "timestamp": "01:45:14", "text": "これは詐欺です。ナツキの頭を手に入れよう"}, {"type": "subtitle", "time": 6317.149, "timestamp": "01:45:17", "text": "そこから抜け出す。よくもまあ嘘をついたものだ！"}, {"type": "subtitle", "time": 6319.43, "timestamp": "01:45:19", "text": "その通り。彼の頭をその中に突っ込んだ。"}, {"type": "subtitle", "time": 6321.75, "timestamp": "01:45:21", "text": "実は、"}, {"type": "subtitle", "time": 6325.189, "timestamp": "01:45:25", "text": "心配しないで。それは良くない。冗談だよ。"}, {"type": "subtitle", "time": 6328.87, "timestamp": "01:45:28", "text": "私たちがお手伝いします。ああ、アルコールがある"}, {"type": "subtitle", "time": 6340.39, "timestamp": "01:45:40", "text": "おお。"}, {"type": "subtitle", "time": 6356.07, "timestamp": "01:45:56", "text": "周りに誰かいますか？誰か助けてくれませんか"}, {"type": "subtitle", "time": 6359.109, "timestamp": "01:45:59", "text": "と共に"}]
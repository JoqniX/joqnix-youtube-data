[{"type": "subtitle", "time": 4268.669, "timestamp": "01:11:08", "text": "今行くよ、みんな。私は"}, {"type": "subtitle", "time": 4274.07, "timestamp": "01:11:14", "text": "来るよ。そこにいるよ、みんな、こっちに来て。"}, {"type": "subtitle", "time": 4276.55, "timestamp": "01:11:16", "text": "さあ行こう。入れ。入れ。そこへ入れ。"}, {"type": "subtitle", "time": 4279.11, "timestamp": "01:11:19", "text": "まるで私が戻ってくるたびに"}, {"type": "subtitle", "time": 4282.47, "timestamp": "01:11:22", "text": "人生に、これらの男たちは"}, {"type": "subtitle", "time": 4285.83, "timestamp": "01:11:25", "text": "全員参加しましたか？全員参加しましたか？うん。による"}, {"type": "subtitle", "time": 4288.07, "timestamp": "01:11:28", "text": "ところで、皆さん、もしあなたが"}, {"type": "subtitle", "time": 4292.75, "timestamp": "01:11:32", "text": "彼らはなぜここにいるのか？走る。なぜ？なぜ"}, {"type": "subtitle", "time": 4295.39, "timestamp": "01:11:35", "text": "来たい"}, {"type": "subtitle", "time": 4300.79, "timestamp": "01:11:40", "text": "生きている？それは私です。なんてこった。"}, {"type": "subtitle", "time": 4304.79, "timestamp": "01:11:44", "text": "ああ、神様。ああ、一人君をすり抜けたね。ああ、くそ。"}, {"type": "subtitle", "time": 4307.91, "timestamp": "01:11:47", "text": "ああ、助かった。あなただけに感謝します。しかし、なぜ"}, {"type": "subtitle", "time": 4309.99, "timestamp": "01:11:49", "text": "それは私を狙っていたのか？なぜそれが"}, {"type": "subtitle", "time": 4313.43, "timestamp": "01:11:53", "text": "来る？おい、どうしたんだ？思うに"}, {"type": "subtitle", "time": 4317.11, "timestamp": "01:11:57", "text": "あなたを憎んでいる。それはとても奇妙だ。"}, {"type": "subtitle", "time": 4319.59, "timestamp": "01:11:59", "text": "私は幽霊を引き寄せる存在か"}]
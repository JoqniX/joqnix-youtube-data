[{"type": "subtitle", "time": 14281.03, "timestamp": "03:58:01", "text": "調べてみてください、私は"}, {"type": "subtitle", "time": 14282.63, "timestamp": "03:58:02", "text": "多分時間がないと思う。それで、"}, {"type": "subtitle", "time": 14286.309, "timestamp": "03:58:06", "text": "その件については、スポーツマンに聞いてみるよ。"}, {"type": "subtitle", "time": 14288.63, "timestamp": "03:58:08", "text": "はい、ここにいます。"}, {"type": "subtitle", "time": 14290.71, "timestamp": "03:58:10", "text": "はい。だから、それが、"}, {"type": "subtitle", "time": 14292.71, "timestamp": "03:58:12", "text": "何をしているの？元気です。元気ですか？"}, {"type": "subtitle", "time": 14294.87, "timestamp": "03:58:14", "text": "おそらく助けを求めるでしょう。私たちは努力しています"}, {"type": "subtitle", "time": 14296.189, "timestamp": "03:58:16", "text": "する"}, {"type": "subtitle", "time": 14300.15, "timestamp": "03:58:20", "text": "積極的に探し求める、ということですよね？ええ、そうですね。"}, {"type": "subtitle", "time": 14302.87, "timestamp": "03:58:22", "text": "私は積極的に何かを探し求めることはありません。私"}, {"type": "subtitle", "time": 14304.55, "timestamp": "03:58:24", "text": "おそらく受動的に探す"}, {"type": "subtitle", "time": 14310.63, "timestamp": "03:58:30", "text": "あなたは物事が心配になりやすい"}, {"type": "subtitle", "time": 14313.269, "timestamp": "03:58:33", "text": "事態は悪化するかもしれない。それは"}, {"type": "subtitle", "time": 14315.51, "timestamp": "03:58:35", "text": "全部？それは、それは"}, {"type": "chat", "time": 14317.705, "timestamp": "03:58:37", "author": "@DinyoFoxy", "avatar": "https://yt4.ggpht.com/DGXvUKi0q0ld5Zo5CNG2tmulZfZqg_h6ivQHLtQfKyx-z_EjHr-Bx7limqyg4JtpZ00_XP_BTQ=s64-c-k-c0x00ffffff-no-rj", "message": "glad to hear you doing great"}, {"type": "subtitle", "time": 14322.309, "timestamp": "03:58:42", "text": "あなたは心配性なんですね。私はそうではない"}, {"type": "subtitle", "time": 14324.63, "timestamp": "03:58:44", "text": "私はうつ伏せではありません。"}, {"type": "subtitle", "time": 14326.75, "timestamp": "03:58:46", "text": "私は"}, {"type": "subtitle", "time": 14329.349, "timestamp": "03:58:49", "text": "心配性。しかし、うつ伏せになると、"}, {"type": "subtitle", "time": 14332.63, "timestamp": "03:58:52", "text": "その感覚がずっと楽に感じられる。"}, {"type": "subtitle", "time": 14335.51, "timestamp": "03:58:55", "text": "いつものように簡単に手に入れることができます"}, {"type": "subtitle", "time": 14338.63, "timestamp": "03:58:58", "text": "ああ、そういうことを心配するんだ。あなたはいつも"}]
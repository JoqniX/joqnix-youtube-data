[{"type": "subtitle", "time": 9660.55, "timestamp": "02:41:00", "text": "よくやった。私たちはよくやった。私は十分な経験値を持っています。"}, {"type": "subtitle", "time": 9667.27, "timestamp": "02:41:07", "text": "うわぁ。"}, {"type": "subtitle", "time": 9669.27, "timestamp": "02:41:09", "text": "誰かをショットガンで撃ってもいいですか？私はしたいです"}, {"type": "subtitle", "time": 9670.87, "timestamp": "02:41:10", "text": "ショット"}, {"type": "subtitle", "time": 9675.429, "timestamp": "02:41:15", "text": "いいえ。"}, {"type": "subtitle", "time": 9678.389, "timestamp": "02:41:18", "text": "ナツキー、君にプレゼントがあるよ。"}, {"type": "subtitle", "time": 9681.11, "timestamp": "02:41:21", "text": "それは何ですか？手榴弾を吸い込む。欲しい"}, {"type": "subtitle", "time": 9683.91, "timestamp": "02:41:23", "text": "速度は1種類のみです。ちょっと待って。ちょっと待ってください。"}, {"type": "subtitle", "time": 9687.429, "timestamp": "02:41:27", "text": "私たちはもっと多くのことをしているだろうか？これは"}, {"type": "subtitle", "time": 9689.19, "timestamp": "02:41:29", "text": "つまり、私たちは勝ったんです。もし私たちが死んだら、"}, {"type": "subtitle", "time": 9691.67, "timestamp": "02:41:31", "text": "去った。よし、やってみよう。プレイ"}, {"type": "subtitle", "time": 9694.79, "timestamp": "02:41:34", "text": "私たちが死ぬまで。わからない。"}, {"type": "subtitle", "time": 9696.309, "timestamp": "02:41:36", "text": "こんにちは。"}, {"type": "subtitle", "time": 9699.83, "timestamp": "02:41:39", "text": "はい、私のです。私のを見つけましょう。"}, {"type": "subtitle", "time": 9701.67, "timestamp": "02:41:41", "text": "つまり、100 を持っている場合、もっと持つことはできますか？"}, {"type": "subtitle", "time": 9705.51, "timestamp": "02:41:45", "text": "100以上？それも本当ですか？"}, {"type": "subtitle", "time": 9708.07, "timestamp": "02:41:48", "text": "H または、100 に留めておきます。"}, {"type": "subtitle", "time": 9709.99, "timestamp": "02:41:49", "text": "100以上獲得できますか？うん。ええ、必要"}, {"type": "subtitle", "time": 9711.99, "timestamp": "02:41:51", "text": "アップグレードするには。"}, {"type": "subtitle", "time": 9714.389, "timestamp": "02:41:54", "text": "健康状態の向上。アップグレードしてください。わかった。うん。私"}, {"type": "subtitle", "time": 9715.67, "timestamp": "02:41:55", "text": "健康状態が改善したことを知らなかった。私"}, {"type": "subtitle", "time": 9718.469, "timestamp": "02:41:58", "text": "体力と筋力の高さが分かった。うん。"}]
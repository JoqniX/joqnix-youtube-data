[{"type": "subtitle", "time": 13922.229, "timestamp": "03:52:02", "text": "ノーと言ったら、彼はとても悲しむだろう"}, {"type": "subtitle", "time": 13924.309, "timestamp": "03:52:04", "text": "彼には明らかに家族がいるからだ。彼"}, {"type": "subtitle", "time": 13926.79, "timestamp": "03:52:06", "text": "彼らと一緒に行きたい、楽しみたい、"}, {"type": "subtitle", "time": 13931.269, "timestamp": "03:52:11", "text": "楽しい時間だった。だから、あなたも取らなければならない"}, {"type": "subtitle", "time": 13933.67, "timestamp": "03:52:13", "text": "男はその人の気持ちを受け止める"}, {"type": "subtitle", "time": 13937.59, "timestamp": "03:52:17", "text": "その決定を下すためのアカウント。でも手に入れて"}, {"type": "subtitle", "time": 13940.79, "timestamp": "03:52:20", "text": "これを手に入れられると思う。もしあの男がいつも"}, {"type": "subtitle", "time": 13943.51, "timestamp": "03:52:23", "text": "これを少なくとも３回はする"}, {"type": "subtitle", "time": 13946.389, "timestamp": "03:52:26", "text": "1週間、指を置かなければならない、"}, {"type": "subtitle", "time": 13947.91, "timestamp": "03:52:27", "text": "「おい、足を下ろして」"}, {"type": "subtitle", "time": 13950.07, "timestamp": "03:52:30", "text": "おい、よく見て、よく聞いてくれ。もしあなたが"}, {"type": "subtitle", "time": 13952.63, "timestamp": "03:52:32", "text": "これだけの休暇​​を取るなんて、わからない"}, {"type": "subtitle", "time": 13955.429, "timestamp": "03:52:35", "text": "君をどうしたらいいんだろう。それならあなたは"}, {"type": "subtitle", "time": 13958.07, "timestamp": "03:52:38", "text": "事実を優先的に扱う。それからあなたは"}, {"type": "subtitle", "time": 13960.469, "timestamp": "03:52:40", "text": "論理を優先してください。それからあなたは"}, {"type": "subtitle", "time": 13962.15, "timestamp": "03:52:42", "text": "厳格さを優先してください。あなたのような"}, {"type": "subtitle", "time": 13964.469, "timestamp": "03:52:44", "text": "厳密にしなければならない、おい、見てくれ、私は"}, {"type": "subtitle", "time": 13966.229, "timestamp": "03:52:46", "text": "あの時はあなたを行かせてあげたの"}, {"type": "subtitle", "time": 13968.229, "timestamp": "03:52:48", "text": "あなたは楽しみたいのですね。もしあなたが働いているなら"}, {"type": "subtitle", "time": 13970.71, "timestamp": "03:52:50", "text": "よかった、君は優秀な働き手だけど、"}, {"type": "subtitle", "time": 13972.469, "timestamp": "03:52:52", "text": "あなたは優秀な働き手だから、"}, {"type": "subtitle", "time": 13974.229, "timestamp": "03:52:54", "text": "つまり、一日休みを取るか、"}, {"type": "subtitle", "time": 13975.15, "timestamp": "03:52:55", "text": "三つ"}, {"type": "subtitle", "time": 13978.07, "timestamp": "03:52:58", "text": "一度。そんなことはできません。あなただけが"}]
[{"type": "subtitle", "time": 9601.91, "timestamp": "02:40:01", "text": "ゼノはなぜ死なないのか？どうでも。いいえ、"}, {"type": "subtitle", "time": 9614.95, "timestamp": "02:40:14", "text": "あなたの後ろにゾンビがいます。"}, {"type": "subtitle", "time": 9618.55, "timestamp": "02:40:18", "text": "銃を持った男はどこへ行った？あなたは持っていません"}, {"type": "subtitle", "time": 9620.87, "timestamp": "02:40:20", "text": "捕まえたぞ。 25セントを獲得しました。彼の"}, {"type": "subtitle", "time": 9623.91, "timestamp": "02:40:23", "text": "鉛。よし、行こう。さあ行こう。さあ"}, {"type": "subtitle", "time": 9626.23, "timestamp": "02:40:26", "text": "行く。さあ行こう。ああ、彼がそこにいる"}, {"type": "subtitle", "time": 9628.469, "timestamp": "02:40:28", "text": "銃。おい、やめろ"}, {"type": "subtitle", "time": 9630.349, "timestamp": "02:40:30", "text": "兄弟、俺は落ち込んでいる"}, {"type": "subtitle", "time": 9634.63, "timestamp": "02:40:34", "text": "HP。今再読み込みしました、"}, {"type": "subtitle", "time": 9642.349, "timestamp": "02:40:42", "text": "ああ、見て。中は実に馬鹿げている。私たちは"}, {"type": "subtitle", "time": 9645.27, "timestamp": "02:40:45", "text": "生き残った、生き残った。"}, {"type": "subtitle", "time": 9646.95, "timestamp": "02:40:46", "text": "生きてるよね？死者は出ましたか？"}, {"type": "subtitle", "time": 9651.99, "timestamp": "02:40:51", "text": "プロ。ええ、私たちは生きています。取引。"}, {"type": "subtitle", "time": 9655.99, "timestamp": "02:40:55", "text": "死者は出ましたか？いいえ。いいえ。そうです。わーい。私たちは"}]
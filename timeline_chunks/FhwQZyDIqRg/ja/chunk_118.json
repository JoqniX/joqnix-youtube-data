[{"type": "subtitle", "time": 7085.629, "timestamp": "01:58:05", "text": "私たちは"}, {"type": "subtitle", "time": 7088.709, "timestamp": "01:58:08", "text": "会社。ああ、ドワーフたち。"}, {"type": "subtitle", "time": 7091.83, "timestamp": "01:58:11", "text": "私たちは何をしているのでしょうか？ドワーフたち"}, {"type": "subtitle", "time": 7094.229, "timestamp": "01:58:14", "text": "ここにいる。大丈夫。私たちはこっそりと"}, {"type": "subtitle", "time": 7107.03, "timestamp": "01:58:27", "text": "よし、捕まえたぞ。"}, {"type": "subtitle", "time": 7108.55, "timestamp": "01:58:28", "text": "他の品物もいくつか買いましょう。私は見つけた"}, {"type": "subtitle", "time": 7123.83, "timestamp": "01:58:43", "text": "うん。何てことだ。それは それは"}, {"type": "subtitle", "time": 7130.31, "timestamp": "01:58:50", "text": "みんな、消火器を手に入れたよ。"}, {"type": "subtitle", "time": 7132.07, "timestamp": "01:58:52", "text": "良いものを見つけた。良いものを見つけたよ。"}, {"type": "subtitle", "time": 7134.47, "timestamp": "01:58:54", "text": "火炎放射器を手に入れた。"}, {"type": "subtitle", "time": 7136.589, "timestamp": "01:58:56", "text": "やあ、どうぞ。なぜ"}, {"type": "subtitle", "time": 7139.03, "timestamp": "01:58:59", "text": "それ？気をつけて。それは人を殺すかもしれない"}]
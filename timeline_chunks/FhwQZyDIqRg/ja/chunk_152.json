[{"type": "subtitle", "time": 9120.63, "timestamp": "02:32:00", "text": "あなたのような抱き枕を持っています"}, {"type": "subtitle", "time": 9123.27, "timestamp": "02:32:03", "text": "女性アニメキャラクターはああ、"}, {"type": "subtitle", "time": 9124.79, "timestamp": "02:32:04", "text": "彼らが何をしているのかは知らない。ただそれは"}, {"type": "subtitle", "time": 9127.27, "timestamp": "02:32:07", "text": "ある人がそれを伝えることにした"}, {"type": "subtitle", "time": 9130.07, "timestamp": "02:32:10", "text": "ソーシャルメディア、それが"}, {"type": "subtitle", "time": 9131.429, "timestamp": "02:32:11", "text": "起こった。人々が何を考えているか、あなたは全く分かっていません"}, {"type": "subtitle", "time": 9133.27, "timestamp": "02:32:13", "text": "密室でやっていて、"}, {"type": "subtitle", "time": 9135.03, "timestamp": "02:32:15", "text": "私にはやるべきことが何もない。だから私が"}, {"type": "subtitle", "time": 9136.389, "timestamp": "02:32:16", "text": "ソーシャルメディアでそれらすべてをよく見かけた"}, {"type": "subtitle", "time": 9138.71, "timestamp": "02:32:18", "text": "メディアは遮断して、"}, {"type": "subtitle", "time": 9142.07, "timestamp": "02:32:22", "text": "それに注目してください。あなたはできません"}, {"type": "subtitle", "time": 9145.19, "timestamp": "02:32:25", "text": "ああ、あるよ。"}, {"type": "subtitle", "time": 9147.99, "timestamp": "02:32:27", "text": "でも、もし私に聞くなら、私は"}, {"type": "subtitle", "time": 9149.75, "timestamp": "02:32:29", "text": "多分私はこう言うだろうね、"}, {"type": "subtitle", "time": 9151.83, "timestamp": "02:32:31", "text": "みんな？まさに今、それが起こっているのです。黙って"}, {"type": "subtitle", "time": 9153.99, "timestamp": "02:32:33", "text": "オフ。それでおしまい。関わるのをやめてください"}, {"type": "subtitle", "time": 9155.99, "timestamp": "02:32:35", "text": "それはまさに"}, {"type": "subtitle", "time": 9157.349, "timestamp": "02:32:37", "text": "思う存分楽しむ。あなたは、"}, {"type": "subtitle", "time": 9159.349, "timestamp": "02:32:39", "text": "嫌い。何が問題なのですか？つまり、もし"}, {"type": "subtitle", "time": 9161.349, "timestamp": "02:32:41", "text": "それはキャラクターなので、そのままにして"}, {"type": "subtitle", "time": 9163.429, "timestamp": "02:32:43", "text": "それはそのバージョンのキャラクターを"}, {"type": "subtitle", "time": 9165.11, "timestamp": "02:32:45", "text": "彼らと一緒に、あなたが"}, {"type": "subtitle", "time": 9167.51, "timestamp": "02:32:47", "text": "例えば、I のバージョンを取得する"}, {"type": "subtitle", "time": 9169.349, "timestamp": "02:32:49", "text": "彼を尊敬している。私は本当に大好きです"}, {"type": "subtitle", "time": 9171.75, "timestamp": "02:32:51", "text": "あの男は尊敬しているし、"}, {"type": "subtitle", "time": 9173.349, "timestamp": "02:32:53", "text": "それが私の見解です。私はそれを保管しておきたい"}, {"type": "subtitle", "time": 9175.51, "timestamp": "02:32:55", "text": "その方が安全だ。だから、もし他に誰か"}, {"type": "subtitle", "time": 9177.83, "timestamp": "02:32:57", "text": "彼らは中に入って、"}, {"type": "subtitle", "time": 9179.03, "timestamp": "02:32:59", "text": "彼らは好きなようにできる。その"}]
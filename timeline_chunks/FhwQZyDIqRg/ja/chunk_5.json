[{"type": "subtitle", "time": 302.43, "timestamp": "00:05:02", "text": "去年の6年くらいかな"}, {"type": "subtitle", "time": 311.79, "timestamp": "00:05:11", "text": "また、すべての腫瘍。"}, {"type": "subtitle", "time": 316.95, "timestamp": "00:05:16", "text": "シーッ。いや、いや、いや。やめろ、絶対にやめろ"}, {"type": "subtitle", "time": 318.27, "timestamp": "00:05:18", "text": "これを台無しにする"}, {"type": "subtitle", "time": 320.27, "timestamp": "00:05:20", "text": "バカ。ただ"}, {"type": "subtitle", "time": 323.27, "timestamp": "00:05:23", "text": "待って。みなさん、こんにちは。楽しめ。それはとても"}, {"type": "subtitle", "time": 333.029, "timestamp": "00:05:33", "text": "こんにちは。あと、ええ、そうですね。ええと、すべての"}, {"type": "subtitle", "time": 337.15, "timestamp": "00:05:37", "text": "長年の視聴者と新規視聴者"}, {"type": "subtitle", "time": 338.67, "timestamp": "00:05:38", "text": "えっと"}, {"type": "subtitle", "time": 344.79, "timestamp": "00:05:44", "text": "6ヶ月くらい前だったかな、それとも8ヶ月前だったかな"}, {"type": "subtitle", "time": 350.11, "timestamp": "00:05:50", "text": "何か？忘れた。私は最大数を扱うのが苦手です。よお。"}, {"type": "subtitle", "time": 353.629, "timestamp": "00:05:53", "text": "ああ、"}, {"type": "subtitle", "time": 358.95, "timestamp": "00:05:58", "text": "えっと、えっと、いつもそうしたいと思ってたんだけど"}]
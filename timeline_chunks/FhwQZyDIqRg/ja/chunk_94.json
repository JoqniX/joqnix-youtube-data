[{"type": "subtitle", "time": 5640.149, "timestamp": "01:34:00", "text": "ああ、それは信じられない。おお。はい、私たちはすでに"}, {"type": "subtitle", "time": 5641.99, "timestamp": "01:34:01", "text": "到達しました。よし、みんな、行こう。やめよう"}, {"type": "subtitle", "time": 5644.709, "timestamp": "01:34:04", "text": "リスク。リスクは冒さないでおこう。"}, {"type": "subtitle", "time": 5647.35, "timestamp": "01:34:07", "text": "はい。はい。さあ行こう。だって、僕たちは努力したんだから"}, {"type": "subtitle", "time": 5650.79, "timestamp": "01:34:10", "text": "あなたの言うことを聞かなかったら、私たちは死んでしまった。"}, {"type": "subtitle", "time": 5653.75, "timestamp": "01:34:13", "text": "私はとにかく行くつもりだ。"}, {"type": "subtitle", "time": 5666.95, "timestamp": "01:34:26", "text": "くそっ。あなたは彼女の話を聞いていないようですね"}, {"type": "subtitle", "time": 5670.229, "timestamp": "01:34:30", "text": "どちらか。おお。"}, {"type": "subtitle", "time": 5671.87, "timestamp": "01:34:31", "text": "ああ、彼らは"}, {"type": "subtitle", "time": 5685.35, "timestamp": "01:34:45", "text": "[音楽]"}, {"type": "subtitle", "time": 5688.87, "timestamp": "01:34:48", "text": "待って、待って、待って。彼を捕まえろ。戻ってきました。"}, {"type": "subtitle", "time": 5697.11, "timestamp": "01:34:57", "text": "彼女はどこにいますか？大丈夫。大丈夫。"}]
[{"type": "subtitle", "time": 13680.71, "timestamp": "03:48:00", "text": "あなたが知っている。うん。それはあなたからのものだったと思います。"}, {"type": "subtitle", "time": 13683.189, "timestamp": "03:48:03", "text": "私は兄弟を呼ぶウイルスに感染しました"}, {"type": "subtitle", "time": 13689.83, "timestamp": "03:48:09", "text": "多く。うん。何？私はそれをやることになっていた。"}, {"type": "subtitle", "time": 13692.87, "timestamp": "03:48:12", "text": "あなたの弟は私の弟とは違う。あなたのは"}, {"type": "subtitle", "time": 13701.03, "timestamp": "03:48:21", "text": "兄弟。皆さん、神話級を覚えていますか？"}, {"type": "chat", "time": 13702.222, "timestamp": "03:48:22", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "LMAOOO"}, {"type": "subtitle", "time": 13703.03, "timestamp": "03:48:23", "text": "右？私は文字通り彼女を兄と呼んでいます"}, {"type": "subtitle", "time": 13710.87, "timestamp": "03:48:30", "text": "何かあったのか、兄弟？この幽霊は"}, {"type": "subtitle", "time": 13718.269, "timestamp": "03:48:38", "text": "私だよ、兄弟。何とかしてくれよ、兄弟。私"}, {"type": "subtitle", "time": 13721.269, "timestamp": "03:48:41", "text": "なぜなのかわからないけど、彼女は"}, {"type": "subtitle", "time": 13724.15, "timestamp": "03:48:44", "text": "彼女は、でも兄弟に電話するだけで"}, {"type": "subtitle", "time": 13725.79, "timestamp": "03:48:45", "text": "彼女は愛している"}, {"type": "subtitle", "time": 13729.11, "timestamp": "03:48:49", "text": "それ。わからない。変だ。面白い"}, {"type": "subtitle", "time": 13732.63, "timestamp": "03:48:52", "text": "みんなを兄弟と呼ぶように"}, {"type": "subtitle", "time": 13735.07, "timestamp": "03:48:55", "text": "その口調で、"}, {"type": "subtitle", "time": 13739.59, "timestamp": "03:48:59", "text": "あまりにも。それでは、どうぞ続けてください、ジャックさん。"}]
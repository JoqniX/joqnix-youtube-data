[{"type": "subtitle", "time": 361.909, "timestamp": "00:06:01", "text": "主に自分の"}, {"type": "subtitle", "time": 364.43, "timestamp": "00:06:04", "text": "自分の持ち物すべて"}, {"type": "subtitle", "time": 368.15, "timestamp": "00:06:08", "text": "すべてはついに"}, {"type": "subtitle", "time": 371.189, "timestamp": "00:06:11", "text": "えーっと、君は僕のことをよく知ってるよね、僕がこれまでやってきたすべての配信をね"}, {"type": "subtitle", "time": 374.79, "timestamp": "00:06:14", "text": "ずっと苦しいような"}, {"type": "subtitle", "time": 377.99, "timestamp": "00:06:17", "text": "わからない、最善を尽くす、最善を尽くす"}, {"type": "subtitle", "time": 379.95, "timestamp": "00:06:19", "text": "しかし男は"}, {"type": "subtitle", "time": 383.189, "timestamp": "00:06:23", "text": "ストリームを面白くするなど"}, {"type": "subtitle", "time": 385.99, "timestamp": "00:06:25", "text": "できるだけ面白く、また"}, {"type": "subtitle", "time": 387.95, "timestamp": "00:06:27", "text": "主に主に"}, {"type": "subtitle", "time": 392.30899999999997, "timestamp": "00:06:32", "text": "ベストを尽くすように心がけています。皆さんの多くは"}, {"type": "subtitle", "time": 394.67, "timestamp": "00:06:34", "text": "私を叱責した"}, {"type": "subtitle", "time": 397.749, "timestamp": "00:06:37", "text": "働きすぎでよくスケジュールを組まれる"}, {"type": "subtitle", "time": 401.43, "timestamp": "00:06:41", "text": "休憩も取らず、うん。うん。"}, {"type": "subtitle", "time": 404.55, "timestamp": "00:06:44", "text": "そして、それらのすべては、あの長いことを覚えている"}, {"type": "subtitle", "time": 408.11, "timestamp": "00:06:48", "text": "長時間配信とかそういうの。"}, {"type": "subtitle", "time": 414.30899999999997, "timestamp": "00:06:54", "text": "うん。こんにちは。それで、えーと、すべての努力は"}]
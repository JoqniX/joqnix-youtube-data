[{"type": "subtitle", "time": 13862.229, "timestamp": "03:51:02", "text": "ある場所のボスとある人物"}, {"type": "subtitle", "time": 13865.429, "timestamp": "03:51:05", "text": "出てくる。彼は私の部下で働いていて、こう言っています"}, {"type": "subtitle", "time": 13867.87, "timestamp": "03:51:07", "text": "ボス、遅れたのは"}, {"type": "subtitle", "time": 13871.75, "timestamp": "03:51:11", "text": "フェスティバルで、もし私がこうなるなら"}, {"type": "subtitle", "time": 13874.07, "timestamp": "03:51:14", "text": "私は事実と論理のように、"}, {"type": "subtitle", "time": 13876.95, "timestamp": "03:51:16", "text": "あなたの家はたった10メートルしか離れていないと言い、"}, {"type": "subtitle", "time": 13879.83, "timestamp": "03:51:19", "text": "君は、君は、"}, {"type": "subtitle", "time": 13883.189, "timestamp": "03:51:23", "text": "11分遅刻したらクビだ。いいえ、私は"}, {"type": "subtitle", "time": 13885.67, "timestamp": "03:51:25", "text": "それは言えません、なぜならまた"}, {"type": "subtitle", "time": 13888.79, "timestamp": "03:51:28", "text": "フェスティバル。彼はそのことについて非常に明確で、"}, {"type": "subtitle", "time": 13890.79, "timestamp": "03:51:30", "text": "えーと、お祭りもあったので、"}, {"type": "subtitle", "time": 13893.03, "timestamp": "03:51:33", "text": "彼も休みを取っているのは"}, {"type": "subtitle", "time": 13895.75, "timestamp": "03:51:35", "text": "彼はフェスティバルに行きたいと思っていることを知っている。私"}, {"type": "subtitle", "time": 13897.83, "timestamp": "03:51:37", "text": "あなたのようにはなれない、ここで働いて"}, {"type": "subtitle", "time": 13902.67, "timestamp": "03:51:42", "text": "ブーツが脱げる。いいえ、できません。私は"}, {"type": "subtitle", "time": 13906.79, "timestamp": "03:51:46", "text": "ロボット野郎。わかった。私は「わかった」って感じだった。"}, {"type": "subtitle", "time": 13909.51, "timestamp": "03:51:49", "text": "一日休みを取りたいですか？大丈夫。大丈夫。"}, {"type": "subtitle", "time": 13912.07, "timestamp": "03:51:52", "text": "そしてあなたは彼らを解放した。"}, {"type": "subtitle", "time": 13913.71, "timestamp": "03:51:53", "text": "その"}, {"type": "subtitle", "time": 13916.71, "timestamp": "03:51:56", "text": "大丈夫。はい、あなたは人々の"}, {"type": "subtitle", "time": 13919.67, "timestamp": "03:51:59", "text": "そこに感情があるのは、あなたが知っているから"}]
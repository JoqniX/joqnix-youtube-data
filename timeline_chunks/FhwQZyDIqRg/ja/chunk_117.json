[{"type": "subtitle", "time": 7022.149, "timestamp": "01:57:02", "text": "高い。はい。はい。ああ、気をつけて。その"}, {"type": "subtitle", "time": 7023.589, "timestamp": "01:57:03", "text": "ドアに挟まってしまった。ドアに挟まってしまった。"}, {"type": "subtitle", "time": 7025.83, "timestamp": "01:57:05", "text": "わかった。そのままにしておいて。そのままにしておいて。優しく。"}, {"type": "subtitle", "time": 7028.87, "timestamp": "01:57:08", "text": "優しく。そのままにしておいて。私は大丈夫です。私は行きます。"}, {"type": "subtitle", "time": 7032.149, "timestamp": "01:57:12", "text": "いや、違うよ。私は優しく言った。もし私がそれを放置したら、"}, {"type": "subtitle", "time": 7033.99, "timestamp": "01:57:13", "text": "価格は下がるだろう。価格は下がるだろう。"}, {"type": "subtitle", "time": 7035.83, "timestamp": "01:57:15", "text": "ちくしょう。ああ、捕まえたぞ。まだ"}, {"type": "subtitle", "time": 7037.75, "timestamp": "01:57:17", "text": "高いですよ、皆さん。心配しないで。大丈夫です。"}, {"type": "subtitle", "time": 7045.87, "timestamp": "01:57:25", "text": "手に入れるべきだった"}]
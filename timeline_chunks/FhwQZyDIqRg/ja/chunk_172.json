[{"type": "subtitle", "time": 10320.55, "timestamp": "02:52:00", "text": "左クリックを離さないでください。ただ"}, {"type": "subtitle", "time": 10322.389, "timestamp": "02:52:02", "text": "持ち続けてください。わかりました、しません。私は持っています"}, {"type": "subtitle", "time": 10324.55, "timestamp": "02:52:04", "text": "それ。全員参加です。"}, {"type": "subtitle", "time": 10331.59, "timestamp": "02:52:11", "text": "やってますよ。やってますよ。私は"}, {"type": "subtitle", "time": 10334.15, "timestamp": "02:52:14", "text": "それ。やってますよ。私は、私は許さない"}, {"type": "subtitle", "time": 10338.75, "timestamp": "02:52:18", "text": "ちょうど"}, {"type": "subtitle", "time": 10342.79, "timestamp": "02:52:22", "text": "スパム行為を続ける。私は100歳です。もちろんです。"}, {"type": "subtitle", "time": 10344.95, "timestamp": "02:52:24", "text": "見る？えっと、"}, {"type": "subtitle", "time": 10347.83, "timestamp": "02:52:27", "text": "それは私の物ではありません。それは私の物ではありません。それ"}, {"type": "subtitle", "time": 10350.23, "timestamp": "02:52:30", "text": "これは私のものではありません。私はこれをやるのが大好きです。これは"}, {"type": "subtitle", "time": 10359.349, "timestamp": "02:52:39", "text": "ゲームに完全に登場することを意図していた、"}, {"type": "subtitle", "time": 10361.11, "timestamp": "02:52:41", "text": "みんな。どういう意味ですか？みんな、私は"}, {"type": "subtitle", "time": 10364.79, "timestamp": "02:52:44", "text": "スタミナを2つ買って、たぶん1つは"}, {"type": "subtitle", "time": 10367.99, "timestamp": "02:52:47", "text": "それらは私のこのスプリントスピードは"}, {"type": "subtitle", "time": 10371.19, "timestamp": "02:52:51", "text": "うん。うん。ああ、なんてことだ。私を見て。"}, {"type": "subtitle", "time": 10374.59, "timestamp": "02:52:54", "text": "体力があるから"}]
[{"type": "subtitle", "time": 13800.55, "timestamp": "03:50:00", "text": "ええ、その意味は分かります。"}, {"type": "subtitle", "time": 13802.79, "timestamp": "03:50:02", "text": "でも、私は興味がないと言おう"}, {"type": "subtitle", "time": 13804.59, "timestamp": "03:50:04", "text": "議論中"}, {"type": "subtitle", "time": 13807.59, "timestamp": "03:50:07", "text": "様々な。うん、面倒くさくて"}, {"type": "subtitle", "time": 13810.389, "timestamp": "03:50:10", "text": "全て。実際、あなたは事実を優先します"}, {"type": "subtitle", "time": 13812.79, "timestamp": "03:50:12", "text": "人の感情を軽視する。そして、いいえ、"}, {"type": "subtitle", "time": 13815.83, "timestamp": "03:50:15", "text": "いや、いや、いや。要は、見て、聞いて、"}, {"type": "subtitle", "time": 13817.91, "timestamp": "03:50:17", "text": "これは非常に危険な坂道です"}, {"type": "subtitle", "time": 13819.75, "timestamp": "03:50:19", "text": "事実を優先するからこそ疑問に思う"}, {"type": "subtitle", "time": 13821.67, "timestamp": "03:50:21", "text": "そして人々の感情よりも論理が優先されるとき"}, {"type": "subtitle", "time": 13823.67, "timestamp": "03:50:23", "text": "それは行動方針を決定する。の"}, {"type": "subtitle", "time": 13826.71, "timestamp": "03:50:26", "text": "問題は、もし"}, {"type": "subtitle", "time": 13828.71, "timestamp": "03:50:28", "text": "君はただのティーンエイジャーか、誰であろうと関係ない。いいえ"}, {"type": "subtitle", "time": 13831.11, "timestamp": "03:50:31", "text": "誰かがこれを気にしている。わかった。しかしもし"}, {"type": "subtitle", "time": 13833.189, "timestamp": "03:50:33", "text": "あなたは、"}, {"type": "subtitle", "time": 13835.67, "timestamp": "03:50:35", "text": "他の人の仕事を引き受けなければならない"}, {"type": "subtitle", "time": 13839.91, "timestamp": "03:50:39", "text": "人々の感情に影響を与える要因。でもあなたも"}, {"type": "subtitle", "time": 13842.55, "timestamp": "03:50:42", "text": "感情的な側面だけを持つべきではない。あなたがすべき"}, {"type": "subtitle", "time": 13845.91, "timestamp": "03:50:45", "text": "それについてもプロ意識を持って取り組んでください。だからあなたは"}, {"type": "chat", "time": 13848.505, "timestamp": "03:50:48", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "don't second guess! everyone has a different interpretation"}, {"type": "subtitle", "time": 13849.189, "timestamp": "03:50:49", "text": "また、事実と人々の意見も考慮に入れると"}, {"type": "subtitle", "time": 13851.91, "timestamp": "03:50:51", "text": "感情を組み合わせ、"}, {"type": "subtitle", "time": 13855.55, "timestamp": "03:50:55", "text": "それがどこへ行くのか。わかった？これを想像してみてください。"}, {"type": "subtitle", "time": 13859.349, "timestamp": "03:50:59", "text": "えーっと、私は、私は、私は、何らかの"}]
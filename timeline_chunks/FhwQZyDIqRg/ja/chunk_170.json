[{"type": "subtitle", "time": 10204.79, "timestamp": "02:50:04", "text": "逃げるしかない。私はできません"}, {"type": "subtitle", "time": 10208.55, "timestamp": "02:50:08", "text": "走る。来て。おお。"}, {"type": "subtitle", "time": 10211.67, "timestamp": "02:50:11", "text": "よし。さあ行こう。彼らは走っている。"}, {"type": "subtitle", "time": 10214.27, "timestamp": "02:50:14", "text": "はい。全員参加する？うん。"}, {"type": "subtitle", "time": 10215.75, "timestamp": "02:50:15", "text": "[拍手]"}, {"type": "subtitle", "time": 10218.95, "timestamp": "02:50:18", "text": "ニース。ニース。私はこれを楽しんでいます。あなたが知っている"}, {"type": "subtitle", "time": 10220.55, "timestamp": "02:50:20", "text": "今、何が起こっているのですか？私たちは"}, {"type": "subtitle", "time": 10223.83, "timestamp": "02:50:23", "text": "一番長く続いているんですよ。うん。"}, {"type": "subtitle", "time": 10225.75, "timestamp": "02:50:25", "text": "本当に？ちょうど閉店しようとした時"}, {"type": "subtitle", "time": 10226.71, "timestamp": "02:50:26", "text": "この列車では、"}, {"type": "subtitle", "time": 10228.87, "timestamp": "02:50:28", "text": "最長記録。想像するに、それは"}, {"type": "subtitle", "time": 10231.59, "timestamp": "02:50:31", "text": "なぜなら、僕たち男同士の絆はまだ築けていなかったからだ。"}, {"type": "subtitle", "time": 10233.67, "timestamp": "02:50:33", "text": "私たちはアニメで仲良くなり、"}, {"type": "subtitle", "time": 10237.59, "timestamp": "02:50:37", "text": "チーム。私たちにはアニメの力がある。"}, {"type": "subtitle", "time": 10241.11, "timestamp": "02:50:41", "text": "ご存知のように、"}, {"type": "subtitle", "time": 10244.87, "timestamp": "02:50:44", "text": "私たちはその動物を捕まえた。以前は"}, {"type": "subtitle", "time": 10246.71, "timestamp": "02:50:46", "text": "以前ここに座っていた男。私はそれを予言した"}, {"type": "subtitle", "time": 10248.87, "timestamp": "02:50:48", "text": "サムシング氏はブロンクス出身です。わからない"}, {"type": "subtitle", "time": 10250.389, "timestamp": "02:50:50", "text": "この全てがどこへ向かったのか。それはとても"}, {"type": "subtitle", "time": 10252.71, "timestamp": "02:50:52", "text": "でも、いい奴だよ。"}, {"type": "subtitle", "time": 10255.51, "timestamp": "02:50:55", "text": "ああ、これは素晴らしい。おお。ああ、そうすべきだよ"}, {"type": "subtitle", "time": 10257.51, "timestamp": "02:50:57", "text": "Qを押してください。OK。誰か"}]
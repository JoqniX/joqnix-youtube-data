[{"type": "subtitle", "time": 5281.59, "timestamp": "01:28:01", "text": "私はこれまで真剣に考えたことがなかった。うん、"}, {"type": "subtitle", "time": 5285.35, "timestamp": "01:28:05", "text": "私たちはこれをプレイするべきだと思うが、"}, {"type": "subtitle", "time": 5287.91, "timestamp": "01:28:07", "text": "それは本当だ。それはあなたが何も持っていないことを示している"}, {"type": "subtitle", "time": 5298.16, "timestamp": "01:28:18", "text": "いや、あまり良くなかった。間違いではない。"}, {"type": "subtitle", "time": 5299.75, "timestamp": "01:28:19", "text": "[音楽]"}, {"type": "subtitle", "time": 5302.229, "timestamp": "01:28:22", "text": "いや、いや、いや、いや、いや。君のことじゃないよ。"}, {"type": "subtitle", "time": 5304.709, "timestamp": "01:28:24", "text": "ごめん。おお。なぜそんなことを言うのですか？それ"}, {"type": "subtitle", "time": 5305.83, "timestamp": "01:28:25", "text": "は"}, {"type": "subtitle", "time": 5307.75, "timestamp": "01:28:27", "text": "私はそれをSjasuに言っただろうが、"}, {"type": "subtitle", "time": 5309.27, "timestamp": "01:28:29", "text": "そんなことは絶対に言わないよ。私は何をしたのか"}, {"type": "subtitle", "time": 5313.189, "timestamp": "01:28:33", "text": "お前にもそんなことするの？なぜそんなことをするのですか？"}, {"type": "subtitle", "time": 5315.99, "timestamp": "01:28:35", "text": "一体どういうことだ？これはランダムなものです"}, {"type": "subtitle", "time": 5318.47, "timestamp": "01:28:38", "text": "根拠のない憎悪？どうしたの？何が"}, {"type": "subtitle", "time": 5319.87, "timestamp": "01:28:39", "text": "これ"}, {"type": "subtitle", "time": 5323.43, "timestamp": "01:28:43", "text": "中傷？私はあなたの存在を知りません。わかった、"}, {"type": "subtitle", "time": 5326.79, "timestamp": "01:28:46", "text": "男。さあ行こう。君ならできるよ。ああ神様、私は"}, {"type": "subtitle", "time": 5328.87, "timestamp": "01:28:48", "text": "彼女がそれをできたらいいのに、私は"}, {"type": "subtitle", "time": 5331.75, "timestamp": "01:28:51", "text": "生き残るのが私じゃなくてよかった。私"}, {"type": "subtitle", "time": 5334.31, "timestamp": "01:28:54", "text": "ただ、私がそこにいるときはいつでも"}, {"type": "subtitle", "time": 5338.47, "timestamp": "01:28:58", "text": "ああ、彼女はまだ手に入れるには程遠い"}]
[{"type": "subtitle", "time": 15421.67, "timestamp": "04:17:01", "text": "頭を掻きながら「何？」って感じ"}, {"type": "subtitle", "time": 15424.229, "timestamp": "04:17:04", "text": "これから何が起こるのか？ああ、私は"}, {"type": "subtitle", "time": 15426.03, "timestamp": "04:17:06", "text": "サイコパス？いや、あなたは"}, {"type": "subtitle", "time": 15427.99, "timestamp": "04:17:07", "text": "サイコパス。あなたは、あなたは"}, {"type": "subtitle", "time": 15430.149, "timestamp": "04:17:10", "text": "あなたは変質者じゃないよ。あなたは無価値な存在ではない。"}, {"type": "subtitle", "time": 15432.229, "timestamp": "04:17:12", "text": "お前は何者でもない。あなたはただの あなたは"}, {"type": "subtitle", "time": 15435.59, "timestamp": "04:17:15", "text": "ただの不器用で内気な男。大丈夫です。その"}, {"type": "subtitle", "time": 15438.229, "timestamp": "04:17:18", "text": "君はごく普通の、不器用で内気な男だ。"}, {"type": "subtitle", "time": 15440.79, "timestamp": "04:17:20", "text": "大丈夫です。それは普通のことです"}, {"type": "subtitle", "time": 15443.75, "timestamp": "04:17:23", "text": "方法。ああ、"}, {"type": "subtitle", "time": 15446.07, "timestamp": "04:17:26", "text": "慣れるしかないんだよ。"}, {"type": "subtitle", "time": 15448.55, "timestamp": "04:17:28", "text": "ここに何か、ここに何か、そして何か"}, {"type": "subtitle", "time": 15450.469, "timestamp": "04:17:30", "text": "大丈夫だよ。はい、結構です"}, {"type": "subtitle", "time": 15453.269, "timestamp": "04:17:33", "text": "お客様。ええ、あなたは"}, {"type": "subtitle", "time": 15460.389, "timestamp": "04:17:40", "text": "だから、それらのことは何も心配しないでください。ただ"}, {"type": "subtitle", "time": 15461.99, "timestamp": "04:17:41", "text": "自分がうまくやっていることに集中する"}, {"type": "subtitle", "time": 15468.63, "timestamp": "04:17:48", "text": "今。こんにちは。うん。それでは、次の質問です。あなた"}, {"type": "subtitle", "time": 15471.11, "timestamp": "04:17:51", "text": "物事を最後にやってしまうことが多い"}, {"type": "subtitle", "time": 15474.309, "timestamp": "04:17:54", "text": "可能性のある瞬間。はい。えっと、これはこれは"}, {"type": "subtitle", "time": 15477.189, "timestamp": "04:17:57", "text": "大学生の頃の私。今から私は"}, {"type": "subtitle", "time": 15479.51, "timestamp": "04:17:59", "text": "通常は事前にやっておく。"}]
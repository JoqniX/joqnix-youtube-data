[{"type": "subtitle", "time": 14821.67, "timestamp": "04:07:01", "text": "問題は、あなたが証明しなければならないことです"}, {"type": "subtitle", "time": 14824.51, "timestamp": "04:07:04", "text": "傷つけることなくポイント"}, {"type": "subtitle", "time": 14827.91, "timestamp": "04:07:07", "text": "感情。それには方法があります"}, {"type": "subtitle", "time": 14830.469, "timestamp": "04:07:10", "text": "唯一無二の存在になる、とかそういうことですよね？だけでなく"}, {"type": "subtitle", "time": 14833.51, "timestamp": "04:07:13", "text": "論理や事実のようなものだ。うん。そのこと"}, {"type": "subtitle", "time": 14835.59, "timestamp": "04:07:15", "text": "問題は、それが寒さのようなものであってはならないということだ"}, {"type": "subtitle", "time": 14838.79, "timestamp": "04:07:18", "text": "論理。 「ああ、長いね」みたいな感じであってはならない"}, {"type": "subtitle", "time": 14841.99, "timestamp": "04:07:21", "text": "なぜならこれはこれはこれは"}, {"type": "subtitle", "time": 14843.349, "timestamp": "04:07:23", "text": "それらに取り組んでも、"}, {"type": "subtitle", "time": 14846.79, "timestamp": "04:07:26", "text": "それを理解する。もし彼らがそうなら、彼らは"}, {"type": "subtitle", "time": 14849.07, "timestamp": "04:07:29", "text": "決して"}, {"type": "subtitle", "time": 14851.349, "timestamp": "04:07:31", "text": "それに対処する必要があることを理解してください"}, {"type": "subtitle", "time": 14853.349, "timestamp": "04:07:33", "text": "いつかその部署で。でも、もしあなたが"}, {"type": "subtitle", "time": 14855.03, "timestamp": "04:07:35", "text": "個人的なことのように話すと、"}, {"type": "subtitle", "time": 14858.309, "timestamp": "04:07:38", "text": "君と僕が電話で話しているところを想像してみて。"}, {"type": "subtitle", "time": 14861.67, "timestamp": "04:07:41", "text": "あなたは私の発言を誤解し、"}, {"type": "subtitle", "time": 14865.07, "timestamp": "04:07:45", "text": "えっと、どういうわけかあなたの言っていることが理解できました"}, {"type": "subtitle", "time": 14867.51, "timestamp": "04:07:47", "text": "誤解されているようですが、私が何をしているかご存知ですか？"}, {"type": "subtitle", "time": 14869.59, "timestamp": "04:07:49", "text": "「ジャック、君は間違っている」とは言わないよ。"}, {"type": "subtitle", "time": 14872.309, "timestamp": "04:07:52", "text": "あなたはそれをやっていない。あなたは完全に間違っています。"}, {"type": "subtitle", "time": 14875.51, "timestamp": "04:07:55", "text": "いや、違うよ。いいえ。ええと、おそらく"}, {"type": "subtitle", "time": 14879.11, "timestamp": "04:07:59", "text": "「ジャック、ショック、落ち着いて。私は"}]
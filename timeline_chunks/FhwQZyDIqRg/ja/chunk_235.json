[{"type": "subtitle", "time": 14102.189, "timestamp": "03:55:02", "text": "あなたが良い改善を成し遂げるかどうか。"}, {"type": "subtitle", "time": 14105.389, "timestamp": "03:55:05", "text": "いや。あ、待って。あなたはめったに心配しない"}, {"type": "subtitle", "time": 14108.07, "timestamp": "03:55:08", "text": "そうですね。うん。あなたはめったに心配しません"}, {"type": "subtitle", "time": 14110.07, "timestamp": "03:55:10", "text": "人々。うん。めったに。うん。私はしません"}, {"type": "subtitle", "time": 14113.75, "timestamp": "03:55:13", "text": "ケア。めったにない、というのは、時々という意味ですよね？"}, {"type": "subtitle", "time": 14117.83, "timestamp": "03:55:17", "text": "うん。うん。そう思う。"}, {"type": "subtitle", "time": 14119.67, "timestamp": "03:55:19", "text": "あなたはそうする。そうするなら、"}, {"type": "subtitle", "time": 14121.99, "timestamp": "03:55:21", "text": "反対する理由は、実際にはそうではないからです"}, {"type": "subtitle", "time": 14124.15, "timestamp": "03:55:24", "text": "心配する いつも心配するのは"}, {"type": "subtitle", "time": 14125.95, "timestamp": "03:55:25", "text": "必ずしもそうとは限らない 必ずしもそうとは限らない"}, {"type": "subtitle", "time": 14128.63, "timestamp": "03:55:28", "text": "うん、そうだね。"}, {"type": "subtitle", "time": 14132.59, "timestamp": "03:55:32", "text": "ありがとう。ありがとう。ありがとう。"}, {"type": "chat", "time": 14134.263, "timestamp": "03:55:34", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "I'd say ALWAYS"}, {"type": "subtitle", "time": 14134.95, "timestamp": "03:55:34", "text": "つまり、あなたはチームに参加するのが好きなんですね"}, {"type": "subtitle", "time": 14136.9, "timestamp": "03:55:36", "text": "基づいている？いいえ。"}, {"type": "subtitle", "time": 14139.63, "timestamp": "03:55:39", "text": "[音楽]"}, {"type": "subtitle", "time": 14143.229, "timestamp": "03:55:43", "text": "いいえ。私はゲームをするのが好きです。"}, {"type": "chat", "time": 14146.497, "timestamp": "03:55:46", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "even now"}, {"type": "subtitle", "time": 14146.71, "timestamp": "03:55:46", "text": "友達。チームベースの活動。チーム"}, {"type": "subtitle", "time": 14148.87, "timestamp": "03:55:48", "text": "友人関係に基づいています。そうじゃないですか そうじゃないですか"}, {"type": "subtitle", "time": 14151.429, "timestamp": "03:55:51", "text": "それはまさに、それはまさに"}, {"type": "subtitle", "time": 14154.389, "timestamp": "03:55:54", "text": "職場？職場はチームベースである"}, {"type": "subtitle", "time": 14157.51, "timestamp": "03:55:57", "text": "すべて。ええ、そうですね。私はそう思う"}, {"type": "subtitle", "time": 14159.269, "timestamp": "03:55:59", "text": "複数の人と協力する方が"}]
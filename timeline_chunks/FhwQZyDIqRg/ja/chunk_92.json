[{"type": "subtitle", "time": 5532.149, "timestamp": "01:32:12", "text": "えっと、そろそろ始めましょうか。うん、"}, {"type": "subtitle", "time": 5535.03, "timestamp": "01:32:15", "text": "さあ行こう。うん、行こう。うん。そしてこれ"}, {"type": "subtitle", "time": 5536.709, "timestamp": "01:32:16", "text": "さあ、今度は僕たちが勝つ番だ。だった"}, {"type": "subtitle", "time": 5538.07, "timestamp": "01:32:18", "text": "勝つだろう。少なくとも私たちは行くつもりだ"}, {"type": "subtitle", "time": 5541.43, "timestamp": "01:32:21", "text": "第3ラウンドへ。はい。少なくとも。少なくとも"}, {"type": "subtitle", "time": 5543.49, "timestamp": "01:32:23", "text": "私は"}, {"type": "subtitle", "time": 5544.79, "timestamp": "01:32:24", "text": "[音楽]"}, {"type": "subtitle", "time": 5546.31, "timestamp": "01:32:26", "text": "心配しないで。私が最初に行きます"}, {"type": "subtitle", "time": 5547.669, "timestamp": "01:32:27", "text": "幽霊を探して、私が言えるように"}, {"type": "subtitle", "time": 5550.149, "timestamp": "01:32:30", "text": "君たち。はい。はい。電話します"}, {"type": "subtitle", "time": 5552.87, "timestamp": "01:32:32", "text": "あなたはプロのレポプレイヤーです。全て"}, {"type": "subtitle", "time": 5555.03, "timestamp": "01:32:35", "text": "よし、行こう。そうそう。あなたは"}, {"type": "subtitle", "time": 5558.31, "timestamp": "01:32:38", "text": "王冠も同様です。"}, {"type": "subtitle", "time": 5560.149, "timestamp": "01:32:40", "text": "そうそう。うん、うん、うん。彼女は"}, {"type": "subtitle", "time": 5563.59, "timestamp": "01:32:43", "text": "クラウン。うん。ここに置いてください。いや、いや、いや。"}, {"type": "subtitle", "time": 5572.07, "timestamp": "01:32:52", "text": "ここに置いておきます。そして、"}, {"type": "subtitle", "time": 5575.03, "timestamp": "01:32:55", "text": "ああ、中に入ります。"}, {"type": "subtitle", "time": 5579.35, "timestamp": "01:32:59", "text": "なんてこった。なんてこった。あなたは壊した"}]
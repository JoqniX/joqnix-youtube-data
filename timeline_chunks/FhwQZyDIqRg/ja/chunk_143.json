[{"type": "subtitle", "time": 8580.07, "timestamp": "02:23:00", "text": "カウボーイBBOPが今まさに。今すぐ。それは"}, {"type": "subtitle", "time": 8581.51, "timestamp": "02:23:01", "text": "すばらしい。私は上司を説得して見てもらうことにした"}, {"type": "subtitle", "time": 8585.75, "timestamp": "02:23:05", "text": "進撃の巨人。もちろんさ。はい、そうしました。だから私は"}, {"type": "subtitle", "time": 8586.87, "timestamp": "02:23:06", "text": "つまり、それは口論だった。私は"}, {"type": "subtitle", "time": 8588.63, "timestamp": "02:23:08", "text": "口論。知ってるでしょ、私は何者でもなかった"}, {"type": "subtitle", "time": 8590.07, "timestamp": "02:23:10", "text": "そして彼はこう言った。「あのね、知ってる？」"}, {"type": "subtitle", "time": 8592.15, "timestamp": "02:23:12", "text": "つまり、これらは、もちろん、"}, {"type": "subtitle", "time": 8593.83, "timestamp": "02:23:13", "text": "「子供っぽいと思う」と私は思った。「"}, {"type": "subtitle", "time": 8595.51, "timestamp": "02:23:15", "text": "これ以上政治的で"}, {"type": "subtitle", "time": 8598.23, "timestamp": "02:23:18", "text": "これ以上のものを見つけることは決してないでしょう"}, {"type": "subtitle", "time": 8600.389, "timestamp": "02:23:20", "text": "知ってるよ、それは影のようなもの"}, {"type": "subtitle", "time": 8601.99, "timestamp": "02:23:21", "text": "現実の生活。進撃の巨人。もし実際に"}, {"type": "subtitle", "time": 8604.87, "timestamp": "02:23:24", "text": "よく見ると、実際にそうなります。"}, {"type": "subtitle", "time": 8606.79, "timestamp": "02:23:26", "text": "それは、"}, {"type": "subtitle", "time": 8608.309, "timestamp": "02:23:28", "text": "現実の生活。そして私は、ただ見ていればいいと思った。"}, {"type": "subtitle", "time": 8612.87, "timestamp": "02:23:32", "text": "それ。そうしないと、私は、私は、私は、"}, {"type": "subtitle", "time": 8614.95, "timestamp": "02:23:34", "text": "とにかく、あなたは私を納得させるでしょう"}, {"type": "subtitle", "time": 8616.95, "timestamp": "02:23:36", "text": "これは漫画です。そして彼はそれを見ていた。そして彼は"}, {"type": "subtitle", "time": 8619.11, "timestamp": "02:23:39", "text": "それを見て気づいたんだけど、"}, {"type": "subtitle", "time": 8621.83, "timestamp": "02:23:41", "text": "攻撃の世界地図でさえ"}, {"type": "subtitle", "time": 8625.91, "timestamp": "02:23:45", "text": "タイタンは文字通り世界地図の反対です"}, {"type": "subtitle", "time": 8628.71, "timestamp": "02:23:48", "text": "はい。はい。ええ、そうですね。とても"}, {"type": "subtitle", "time": 8630.71, "timestamp": "02:23:50", "text": "進撃の巨人の中には、"}, {"type": "subtitle", "time": 8632.79, "timestamp": "02:23:52", "text": "なあ、まだ見つけてるよ"}, {"type": "subtitle", "time": 8636.07, "timestamp": "02:23:56", "text": "昨日見つけたAOTの引用"}, {"type": "subtitle", "time": 8638.71, "timestamp": "02:23:58", "text": "ゴス・マサが実際には"}]
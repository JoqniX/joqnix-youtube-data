[{"type": "subtitle", "time": 15361.75, "timestamp": "04:16:01", "text": "絶対にそうします、あなたは絶対に"}, {"type": "subtitle", "time": 15364.149, "timestamp": "04:16:04", "text": "うん、私はそういうタイプじゃないよ。私は使用しません"}, {"type": "subtitle", "time": 15366.55, "timestamp": "04:16:06", "text": "またその名前か。その名前は使用しないでください"}, {"type": "subtitle", "time": 15369.11, "timestamp": "04:16:09", "text": "また。日本人ミックスさん。もしあなたが"}, {"type": "subtitle", "time": 15371.11, "timestamp": "04:16:11", "text": "本当の人を喜ばせる人は、"}, {"type": "subtitle", "time": 15374.469, "timestamp": "04:16:14", "text": "またその名前か。わかった。ええ、まだです"}, {"type": "subtitle", "time": 15376.71, "timestamp": "04:16:16", "text": "1つ見たので、だから私は見た"}, {"type": "subtitle", "time": 15379.189, "timestamp": "04:16:19", "text": "見た、見過ぎた。私は見過ぎた。"}, {"type": "subtitle", "time": 15382.469, "timestamp": "04:16:22", "text": "何てことだ。ええ、そうですね。ほら、もうやめて"}, {"type": "subtitle", "time": 15383.83, "timestamp": "04:16:23", "text": "心配。あなたは人に好かれようとするタイプではない。"}, {"type": "subtitle", "time": 15385.91, "timestamp": "04:16:25", "text": "良い。あなたはただ、"}, {"type": "subtitle", "time": 15388.469, "timestamp": "04:16:28", "text": "親切にしているのに、あなたは知らない。あなたは"}, {"type": "subtitle", "time": 15391.429, "timestamp": "04:16:31", "text": "じゃあ、電話するね。もし私が望むなら"}, {"type": "subtitle", "time": 15395.75, "timestamp": "04:16:35", "text": "正直に言うと、私はそうではなく、"}, {"type": "subtitle", "time": 15398.71, "timestamp": "04:16:38", "text": "あなたはとても内気な人だと言えるでしょう"}, {"type": "subtitle", "time": 15402.229, "timestamp": "04:16:42", "text": "とても臆病な人。内気で"}, {"type": "subtitle", "time": 15406.229, "timestamp": "04:16:46", "text": "臆病な人。あなたはそれだけの存在だ。そして"}, {"type": "subtitle", "time": 15408.87, "timestamp": "04:16:48", "text": "内気さと臆病さがすべてを"}, {"type": "subtitle", "time": 15411.189, "timestamp": "04:16:51", "text": "ぎこちなくて、落ち着きのない感じの"}, {"type": "subtitle", "time": 15413.51, "timestamp": "04:16:53", "text": "あなたは今まさにそれを経験しているのです。"}, {"type": "subtitle", "time": 15416.55, "timestamp": "04:16:56", "text": "何度も謝罪するなど"}, {"type": "subtitle", "time": 15419.429, "timestamp": "04:16:59", "text": "友達リクエストをするのと同じように、ただ"}]
[{"type": "subtitle", "time": 5041.83, "timestamp": "01:24:01", "text": "[笑い]"}, {"type": "subtitle", "time": 5043.149, "timestamp": "01:24:03", "text": "ああ、彼女は"}, {"type": "subtitle", "time": 5045.75, "timestamp": "01:24:05", "text": "陽気な。しかし彼女は叫ばせてはいけない"}, {"type": "subtitle", "time": 5047.43, "timestamp": "01:24:07", "text": "銃を持った男が彼女のところに来るから"}, {"type": "subtitle", "time": 5054.629, "timestamp": "01:24:14", "text": "何てことだ。いいえ、それでは不十分です。ない"}, {"type": "subtitle", "time": 5061.27, "timestamp": "01:24:21", "text": "ああ、それだけでは不十分だ。ああ、"}, {"type": "subtitle", "time": 5063.189, "timestamp": "01:24:23", "text": "ノイズ。"}, {"type": "subtitle", "time": 5064.79, "timestamp": "01:24:24", "text": "では、どうすれば"}, {"type": "subtitle", "time": 5066.149, "timestamp": "01:24:26", "text": "幽霊が来るの？聞こえますか？"}, {"type": "subtitle", "time": 5069.189, "timestamp": "01:24:29", "text": "音？そうそう。実際は音声による合図です。"}, {"type": "subtitle", "time": 5071.51, "timestamp": "01:24:31", "text": "ああ、君は死んでしまったんだね。"}, {"type": "subtitle", "time": 5074.39, "timestamp": "01:24:34", "text": "撮影現場へようこそ。"}, {"type": "subtitle", "time": 5077.189, "timestamp": "01:24:37", "text": "こんにちは。気分はどうですか？はい、彼は撃ちました"}, {"type": "subtitle", "time": 5080.07, "timestamp": "01:24:40", "text": "俺だよ、兄弟。彼は文字通り目の前に現れた"}, {"type": "subtitle", "time": 5082.79, "timestamp": "01:24:42", "text": "私の。彼は文字通り私の目の前にいた。私"}, {"type": "subtitle", "time": 5085.59, "timestamp": "01:24:45", "text": "まるでマトリックスのように弾丸を避けていた。ええ、私は"}, {"type": "subtitle", "time": 5087.59, "timestamp": "01:24:47", "text": "その出来事をリアルタイムで目撃した。それは"}, {"type": "subtitle", "time": 5090.31, "timestamp": "01:24:50", "text": "とても悲しい。多くの人が復活を必要としている"}, {"type": "subtitle", "time": 5093.189, "timestamp": "01:24:53", "text": "私たち。"}, {"type": "subtitle", "time": 5095.189, "timestamp": "01:24:55", "text": "多分。つまり、彼女が集めることができれば"}, {"type": "subtitle", "time": 5097.51, "timestamp": "01:24:57", "text": "十分、"}, {"type": "subtitle", "time": 5099.59, "timestamp": "01:24:59", "text": "どうしたの？彼女はなぜ挑発しているのですか？それ"}]
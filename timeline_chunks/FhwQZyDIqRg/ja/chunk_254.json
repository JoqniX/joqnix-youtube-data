[{"type": "subtitle", "time": 15241.149, "timestamp": "04:14:01", "text": "感情的な議論によって。これは何"}, {"type": "subtitle", "time": 15243.87, "timestamp": "04:14:03", "text": "感情的"}, {"type": "subtitle", "time": 15248.79, "timestamp": "04:14:08", "text": "手段？ああ、もしそれがもしもしのようななら"}, {"type": "subtitle", "time": 15250.63, "timestamp": "04:14:10", "text": "他の人が"}, {"type": "subtitle", "time": 15253.59, "timestamp": "04:14:13", "text": "感情的になって、あなたに向かって叫んでいる"}, {"type": "subtitle", "time": 15255.59, "timestamp": "04:14:15", "text": "または、これをしなければならない"}, {"type": "subtitle", "time": 15257.11, "timestamp": "04:14:17", "text": "人々、"}, {"type": "subtitle", "time": 15259.349, "timestamp": "04:14:19", "text": "私は簡単に考えを変えたりはしない。いいね"}, {"type": "subtitle", "time": 15262.07, "timestamp": "04:14:22", "text": "それだけ？"}, {"type": "subtitle", "time": 15264.469, "timestamp": "04:14:24", "text": "あなたは感情的ではない。私"}, {"type": "subtitle", "time": 15267.91, "timestamp": "04:14:27", "text": "同意すべきだ。私は感情的なタイプではない"}, {"type": "subtitle", "time": 15270.55, "timestamp": "04:14:30", "text": "男。もし彼らがその人なら"}, {"type": "subtitle", "time": 15273.349, "timestamp": "04:14:33", "text": "私と議論するのは感情的だから、"}, {"type": "subtitle", "time": 15276.63, "timestamp": "04:14:36", "text": "彼らがいくらでも議論すればいいし、私は待つよ"}, {"type": "subtitle", "time": 15278.309, "timestamp": "04:14:38", "text": "彼らが落ち着くためには、"}, {"type": "subtitle", "time": 15280.79, "timestamp": "04:14:40", "text": "カウンターとしてはあまり良い場所ではない"}, {"type": "subtitle", "time": 15283.349, "timestamp": "04:14:43", "text": "議論または助言。だから明らかに私は"}, {"type": "subtitle", "time": 15286.309, "timestamp": "04:14:46", "text": "彼らを放っておこう、そして私は"}, {"type": "subtitle", "time": 15288.269, "timestamp": "04:14:48", "text": "私がそうするように"}, {"type": "subtitle", "time": 15291.59, "timestamp": "04:14:51", "text": "私は彼らを長い間そのままにしておくつもりです"}, {"type": "subtitle", "time": 15294.429, "timestamp": "04:14:54", "text": "時間。"}, {"type": "subtitle", "time": 15299.269, "timestamp": "04:14:59", "text": "ああ、私もそう考えているよ。おお。"}]
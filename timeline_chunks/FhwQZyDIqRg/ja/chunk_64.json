[{"type": "subtitle", "time": 3841.67, "timestamp": "01:04:01", "text": "君を殴るよ。なんてこった。彼女は怖い。"}, {"type": "subtitle", "time": 3852.39, "timestamp": "01:04:12", "text": "大好きです。あなたの３つを破壊する"}, {"type": "subtitle", "time": 3856.309, "timestamp": "01:04:16", "text": "兵器。なんてこった。 2つ"}, {"type": "subtitle", "time": 3866.63, "timestamp": "01:04:26", "text": "待って。私は負けたのか？しかし、そうではない。いいえ。いいえ。いいえ。"}, {"type": "subtitle", "time": 3869.75, "timestamp": "01:04:29", "text": "ああ、くそ。ああ、くそ。待って。人々はまだ"}, {"type": "subtitle", "time": 3877.75, "timestamp": "01:04:37", "text": "何てことだ。それを手に入れるつもりです。ニース。"}, {"type": "subtitle", "time": 3880.95, "timestamp": "01:04:40", "text": "何てことだ。すごく可愛かった。キング・オブ・ザ"}, {"type": "subtitle", "time": 3882.47, "timestamp": "01:04:42", "text": "敗者たち。"}, {"type": "subtitle", "time": 3885.43, "timestamp": "01:04:45", "text": "イップ。あなたは王の王です"}, {"type": "subtitle", "time": 3888.39, "timestamp": "01:04:48", "text": "敗者たち。さあ行こう。これは"}, {"type": "subtitle", "time": 3890.069, "timestamp": "01:04:50", "text": "このポジションで最も重要な"}]
[{"type": "subtitle", "time": 3121.589, "timestamp": "00:52:01", "text": "行け！行け！行け。"}, {"type": "subtitle", "time": 3125.39, "timestamp": "00:52:05", "text": "まあ、いいと思うけど"}, {"type": "subtitle", "time": 3127.63, "timestamp": "00:52:07", "text": "それで。くそ、"}, {"type": "subtitle", "time": 3131.589, "timestamp": "00:52:11", "text": "兄弟。もし俺がこれを一人でプレイしたら、なあ。私はしません"}, {"type": "subtitle", "time": 3133.75, "timestamp": "00:52:13", "text": "もし私がいつか知ることがあれば、ああ、なんてことだ。彼は文字通り"}, {"type": "subtitle", "time": 3136.87, "timestamp": "00:52:16", "text": "あなたの目の前に。こんにちは、ジョー。ああ、それは"}, {"type": "subtitle", "time": 3143.27, "timestamp": "00:52:23", "text": "まっすぐ右に進まなければならない。ええ、彼は"}, {"type": "subtitle", "time": 3145.03, "timestamp": "00:52:25", "text": "彼は私と一緒にいた。まるで彼の"}, {"type": "subtitle", "time": 3146.75, "timestamp": "00:52:26", "text": "頭を"}, {"type": "subtitle", "time": 3149.589, "timestamp": "00:52:29", "text": "カート。私は自分がどうなのか忘れてしまう"}, {"type": "subtitle", "time": 3150.95, "timestamp": "00:52:30", "text": "好きになるはずなんだよ、ほら。よし、みんな。"}, {"type": "subtitle", "time": 3153.75, "timestamp": "00:52:33", "text": "抽出地点を見つけました。どこ"}, {"type": "subtitle", "time": 3156.71, "timestamp": "00:52:36", "text": "それ？何を見つけたの？えっと、待って。どこ"}, {"type": "subtitle", "time": 3158.47, "timestamp": "00:52:38", "text": "車はどこ？こちらです。以上"}, {"type": "subtitle", "time": 3160.549, "timestamp": "00:52:40", "text": "ここ。私です。車はここにあります。どこに"}, {"type": "subtitle", "time": 3162.15, "timestamp": "00:52:42", "text": "あなた？"}, {"type": "subtitle", "time": 3164.71, "timestamp": "00:52:44", "text": "なぜ奇妙で不気味な"}, {"type": "subtitle", "time": 3168.79, "timestamp": "00:52:48", "text": "ノイズ？ジョー。はい。ジョー。待って。そこには"}, {"type": "subtitle", "time": 3175.109, "timestamp": "00:52:55", "text": "何てことだ。走る。走る。走る。走る。走る。走る。"}, {"type": "subtitle", "time": 3177.119, "timestamp": "00:52:57", "text": "走る。走る。走る。 ああ、なんてことだ、不気味な目がある。"}]
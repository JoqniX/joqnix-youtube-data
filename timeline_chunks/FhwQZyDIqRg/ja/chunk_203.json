[{"type": "subtitle", "time": 12180.71, "timestamp": "03:23:00", "text": "そう、それでも私はこれを"}, {"type": "subtitle", "time": 12182.59, "timestamp": "03:23:02", "text": "7年間、ミスター"}, {"type": "subtitle", "time": 12185.67, "timestamp": "03:23:05", "text": "シング。私の言い方は合っていますか？シング。私"}, {"type": "subtitle", "time": 12190.07, "timestamp": "03:23:10", "text": "希望。 Sh。ごめんよ。"}, {"type": "subtitle", "time": 12196.15, "timestamp": "03:23:16", "text": "あのね？どうでも。私は行かない"}, {"type": "subtitle", "time": 12198.389, "timestamp": "03:23:18", "text": "そう言うために。"}, {"type": "subtitle", "time": 12201.11, "timestamp": "03:23:21", "text": "私だけでしょうか、それともあなたの声が"}, {"type": "subtitle", "time": 12204.469, "timestamp": "03:23:24", "text": "ランダムに分割される？その"}, {"type": "subtitle", "time": 12205.79, "timestamp": "03:23:25", "text": "こんな感じ"}, {"type": "subtitle", "time": 12209.51, "timestamp": "03:23:29", "text": "停止しました。それは奇妙だ。まあ、本当に？私"}, {"type": "subtitle", "time": 12212.99, "timestamp": "03:23:32", "text": "わからない。多分。"}, {"type": "subtitle", "time": 12221.67, "timestamp": "03:23:41", "text": "ブーイングする人もいる。ええ、少なくとも私のOBSは"}, {"type": "subtitle", "time": 12226.229, "timestamp": "03:23:46", "text": "それをキャッチして、私の目に見えるようにします。で"}, {"type": "subtitle", "time": 12233.309, "timestamp": "03:23:53", "text": "自分。"}, {"type": "subtitle", "time": 12238.309, "timestamp": "03:23:58", "text": "ところで、2はどうですか？"}, {"type": "subtitle", "time": 12239.99, "timestamp": "03:23:59", "text": "H"}]
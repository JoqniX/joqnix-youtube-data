[{"type": "subtitle", "time": 3720.309, "timestamp": "01:02:00", "text": "それは私たちの頭で取り上げられている。うん、"}, {"type": "subtitle", "time": 3722.549, "timestamp": "01:02:02", "text": "あの人たち。彼はまさに"}, {"type": "subtitle", "time": 3725.109, "timestamp": "01:02:05", "text": "幽霊はまるで壊れたかのように"}, {"type": "subtitle", "time": 3727.99, "timestamp": "01:02:07", "text": "私たちが持っていたもの全て。ええ、それは"}, {"type": "subtitle", "time": 3729.27, "timestamp": "01:02:09", "text": "あれが何だったか知ってる？私はしませんでした"}, {"type": "subtitle", "time": 3732.39, "timestamp": "01:02:12", "text": "私がどこにいたのかさえ分からない。だから私はこう思う"}, {"type": "subtitle", "time": 3734.15, "timestamp": "01:02:14", "text": "私はしゃがんでいました。これは宝箱です。"}, {"type": "subtitle", "time": 3737.109, "timestamp": "01:02:17", "text": "右？開けてみて、ああ。"}, {"type": "subtitle", "time": 3740.63, "timestamp": "01:02:20", "text": "待って、実は私は逃げ切れたと思ったんだけど"}, {"type": "subtitle", "time": 3744.63, "timestamp": "01:02:24", "text": "そこから。レーザーのみ。ああ、くそ。"}, {"type": "subtitle", "time": 3752.309, "timestamp": "01:02:32", "text": "いい試みだったけど、おかげで殺されちゃったよ。"}, {"type": "subtitle", "time": 3755.589, "timestamp": "01:02:35", "text": "どうやってレーザー照射を受けたのか？前に待って"}, {"type": "subtitle", "time": 3758.87, "timestamp": "01:02:38", "text": "俺だよ、兄弟。彼は私を撃った。ナスキです"}, {"type": "subtitle", "time": 3761.109, "timestamp": "01:02:41", "text": "胸の内側。"}, {"type": "subtitle", "time": 3763.67, "timestamp": "01:02:43", "text": "うん、"}, {"type": "subtitle", "time": 3764.95, "timestamp": "01:02:44", "text": "彼は死んだ。彼は身を隠すべきだ。彼はそうすべきだ"}, {"type": "subtitle", "time": 3767.109, "timestamp": "01:02:47", "text": "隠れる。隠れて死ぬべきだ。あなた"}, {"type": "subtitle", "time": 3770.789, "timestamp": "01:02:50", "text": "隠れるべきだ。バカ。ああ、ちくしょう。ああ、"}, {"type": "subtitle", "time": 3778.47, "timestamp": "01:02:58", "text": "兄弟。私たちは、私は後ろを振り返ると、彼は"}]
[{"type": "subtitle", "time": 15601.95, "timestamp": "04:20:01", "text": "ちなみに、倫理的なジレンマも絡んでいます。だから私は行く"}, {"type": "subtitle", "time": 15605.59, "timestamp": "04:20:05", "text": "難しいかもしれないが、レベル2には同意できない。水平ではない"}, {"type": "subtitle", "time": 15607.75, "timestamp": "04:20:07", "text": "3人は反対している。私には見当もつかない。"}, {"type": "subtitle", "time": 15610.07, "timestamp": "04:20:10", "text": "彼らが話していることは"}, {"type": "subtitle", "time": 15613.389, "timestamp": "04:20:13", "text": "倫理的なジレンマを楽しむ。さあ行こう"}, {"type": "subtitle", "time": 15617.91, "timestamp": "04:20:17", "text": "次のシートへ進んでください。私はミスターに50％賛成です。"}, {"type": "subtitle", "time": 15621.11, "timestamp": "04:20:21", "text": "ショクニクス。うん、私も。"}, {"type": "subtitle", "time": 15623.79, "timestamp": "04:20:23", "text": "わかった。あなたは通常、周りにいることを好む"}, {"type": "subtitle", "time": 15627.269, "timestamp": "04:20:27", "text": "自分一人ではなく、他の人と話す。えっと"}, {"type": "subtitle", "time": 15631.75, "timestamp": "04:20:31", "text": "通常は同意することを好む、つまり私は"}, {"type": "subtitle", "time": 15634.87, "timestamp": "04:20:34", "text": "同意できない。私は普段"}, {"type": "subtitle", "time": 15637.189, "timestamp": "04:20:37", "text": "一人になりたい。"}, {"type": "subtitle", "time": 15639.59, "timestamp": "04:20:39", "text": "同じ。私は、私は、私は、私は、"}, {"type": "subtitle", "time": 15642.55, "timestamp": "04:20:42", "text": "難易度レベル３。おそらくレベル2"}, {"type": "subtitle", "time": 15645.03, "timestamp": "04:20:45", "text": "私は誰かと一緒にいるのは構わないからです。まるで私が"}, {"type": "subtitle", "time": 15647.83, "timestamp": "04:20:47", "text": "友達が一緒にいても構わないけど、"}, {"type": "subtitle", "time": 15649.99, "timestamp": "04:20:49", "text": "私はパーティー好きではないと思う。あなた"}, {"type": "subtitle", "time": 15654.429, "timestamp": "04:20:54", "text": "私の言いたいこと、分かりますか？うん。うん。レベル2"}, {"type": "subtitle", "time": 15656.95, "timestamp": "04:20:56", "text": "同意できない。退屈したり、道に迷ったりする"}]
[{"type": "subtitle", "time": 4741.669, "timestamp": "01:19:01", "text": "思考の旅は長い。"}, {"type": "subtitle", "time": 4744.55, "timestamp": "01:19:04", "text": "家までの道のりは長い。正直に言うと、私は"}, {"type": "subtitle", "time": 4749.11, "timestamp": "01:19:09", "text": "知ってたけど、君たちも知ってると思ってたよ。おお。"}, {"type": "subtitle", "time": 4757.99, "timestamp": "01:19:17", "text": "私はそれを破壊した。ジョック。それを見たよ。私は見た"}, {"type": "subtitle", "time": 4781.99, "timestamp": "01:19:41", "text": "ニッキー、見て。私はあなたを見つけました。ナチ、見て。"}, {"type": "subtitle", "time": 4783.87, "timestamp": "01:19:43", "text": "君だよ。その"}, {"type": "subtitle", "time": 4786.07, "timestamp": "01:19:46", "text": "あなた。わかった。"}]
[{"type": "subtitle", "time": 11580.389, "timestamp": "03:13:00", "text": "ああ、大丈夫だよ。あなたは慣れました"}, {"type": "subtitle", "time": 11584.309, "timestamp": "03:13:04", "text": "それ。もう私に電話しないで。"}, {"type": "subtitle", "time": 11587.99, "timestamp": "03:13:07", "text": "何てことだ。ごめん。"}, {"type": "subtitle", "time": 11590.91, "timestamp": "03:13:10", "text": "大丈夫です。ご心配なく。氏"}, {"type": "subtitle", "time": 11593.59, "timestamp": "03:13:13", "text": "ショクニクスは私の兄の名前です。待って、"}, {"type": "subtitle", "time": 11596.71, "timestamp": "03:13:16", "text": "それはインドの名前です。それはインド人です"}, {"type": "subtitle", "time": 11598.03, "timestamp": "03:13:18", "text": "名前。"}, {"type": "subtitle", "time": 11600.389, "timestamp": "03:13:20", "text": "面白い。私はとても"}, {"type": "subtitle", "time": 11603.03, "timestamp": "03:13:23", "text": "スタイリッシュなShoの別の名前ですが、"}, {"type": "subtitle", "time": 11605.03, "timestamp": "03:13:25", "text": "どうやらインド系の名前らしい。"}, {"type": "subtitle", "time": 11608.469, "timestamp": "03:13:28", "text": "どうやらよくある名前のようだ。私はパニックになった"}, {"type": "subtitle", "time": 11611.349, "timestamp": "03:13:31", "text": "数人出て行ったら、数人出て行ったら、"}, {"type": "subtitle", "time": 11614.309, "timestamp": "03:13:34", "text": "多くの人が、私がその名前を言う間"}, {"type": "subtitle", "time": 11617.75, "timestamp": "03:13:37", "text": "ヴィックみたいに。彼はどうしてこの名前になったのですか？私"}, {"type": "subtitle", "time": 11629.03, "timestamp": "03:13:49", "text": "えっと、それはすごく面白いことなんです。私"}, {"type": "subtitle", "time": 11631.15, "timestamp": "03:13:51", "text": "こんな名前は聞いたことがない"}, {"type": "subtitle", "time": 11633.99, "timestamp": "03:13:53", "text": "これまで、しかし明らかに"}, {"type": "subtitle", "time": 11636.59, "timestamp": "03:13:56", "text": "北は一般的なものの一つ"}, {"type": "subtitle", "time": 11639.91, "timestamp": "03:13:59", "text": "名前ではない、一般的なものの一つだとは思わない"}]
[{"type": "subtitle", "time": 9001.27, "timestamp": "02:30:01", "text": "事件。私は責めません あなたは何を"}, {"type": "subtitle", "time": 9003.349, "timestamp": "02:30:03", "text": "つまり、あなたは彼らを責めていないということですか？あなたは知っていますか"}, {"type": "subtitle", "time": 9005.75, "timestamp": "02:30:05", "text": "彼らは何をしたのか？何でも。知っている。しかし"}, {"type": "subtitle", "time": 9007.75, "timestamp": "02:30:07", "text": "彼らがすべきだったのは"}, {"type": "subtitle", "time": 9009.51, "timestamp": "02:30:09", "text": "もの。彼らがやったことは、それを着ることだった"}, {"type": "subtitle", "time": 9010.87, "timestamp": "02:30:10", "text": "誰もが言うソーシャルメディア、"}, {"type": "subtitle", "time": 9013.11, "timestamp": "02:30:13", "text": "それは間違っていると思います。私はその事実が嫌いです"}, {"type": "subtitle", "time": 9015.11, "timestamp": "02:30:15", "text": "人々が示そうとする。つまり、"}, {"type": "subtitle", "time": 9016.87, "timestamp": "02:30:16", "text": "それは彼女が犯した最も間違った行動だった。そして"}, {"type": "subtitle", "time": 9019.429, "timestamp": "02:30:19", "text": "彼女がしたことについては、ええ、私のせいにしてください。"}, {"type": "subtitle", "time": 9021.59, "timestamp": "02:30:21", "text": "しかし、もっとひどいものも見てきた。私は私は"}, {"type": "subtitle", "time": 9023.349, "timestamp": "02:30:23", "text": "次のような世代で育った"}, {"type": "subtitle", "time": 9024.79, "timestamp": "02:30:24", "text": "Tumblr やその他すべてを知っていて、"}, {"type": "subtitle", "time": 9026.23, "timestamp": "02:30:26", "text": "これらのアニメコンベンションについて、"}, {"type": "subtitle", "time": 9028.469, "timestamp": "02:30:28", "text": "バーチャルアニメコンベンションは"}, {"type": "subtitle", "time": 9031.91, "timestamp": "02:30:31", "text": "日本は、私たちが想像していたよりもはるかに悪い"}, {"type": "subtitle", "time": 9034.55, "timestamp": "02:30:34", "text": "2023年にシーソー。五条にとっては問題ない。"}, {"type": "subtitle", "time": 9037.11, "timestamp": "02:30:37", "text": "彼はそうではなかったが、私は爆豪を見たことがある"}, {"type": "subtitle", "time": 9046.15, "timestamp": "02:30:46", "text": "同じことだ。ああ、同じことだ、五条"}, {"type": "subtitle", "time": 9050.15, "timestamp": "02:30:50", "text": "彼は実際には未成年なので"}, {"type": "subtitle", "time": 9052.23, "timestamp": "02:30:52", "text": "気持ち悪い。なぜ人々がそんなことをするのか分からない。"}, {"type": "subtitle", "time": 9054.309, "timestamp": "02:30:54", "text": "つまり、私はできる、あなたはできる"}, {"type": "subtitle", "time": 9056.95, "timestamp": "02:30:56", "text": "知ってるでしょ、私は好きになろうとすごく努力したけど、そうじゃない"}, {"type": "subtitle", "time": 9058.55, "timestamp": "02:30:58", "text": "私がなぜそれを正当化しようとしたのか、分かってください。そして"}, {"type": "subtitle", "time": 9059.75, "timestamp": "02:30:59", "text": "私はこう思う、ほら、君たちは見ている"}]
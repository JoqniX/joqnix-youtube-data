[{"type": "subtitle", "time": 10501.07, "timestamp": "02:55:01", "text": "はい、行きます。病気"}, {"type": "subtitle", "time": 10504.309, "timestamp": "02:55:04", "text": "行く。走る。ここに何かある。入手する"}, {"type": "subtitle", "time": 10521.99, "timestamp": "02:55:21", "text": "何てことだ。ああ、なんてことだ。一体何なんだ"}, {"type": "subtitle", "time": 10527.51, "timestamp": "02:55:27", "text": "今はどこに隠れたらいいのか分からない。できますか"}, {"type": "subtitle", "time": 10541.269, "timestamp": "02:55:41", "text": "真剣にそれを取ろうとしている"}, {"type": "subtitle", "time": 10543.51, "timestamp": "02:55:43", "text": "お金。"}, {"type": "subtitle", "time": 10546.309, "timestamp": "02:55:46", "text": "何てことだ。あなたは、"}, {"type": "subtitle", "time": 10548.87, "timestamp": "02:55:48", "text": "幽霊の毛だよ、みんな。他に誰かいますか？その"}, {"type": "subtitle", "time": 10550.389, "timestamp": "02:55:50", "text": "まさに私たちの部屋の中に。どうでも。彼"}, {"type": "subtitle", "time": 10553.349, "timestamp": "02:55:53", "text": "逃げ出した。みんな、もっと速く。もっと早く。いいえ"}, {"type": "subtitle", "time": 10554.51, "timestamp": "02:55:54", "text": "ノイズ。"}]
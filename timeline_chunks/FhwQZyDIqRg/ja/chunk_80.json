[{"type": "subtitle", "time": 4807.11, "timestamp": "01:20:07", "text": "何てことだ、"}, {"type": "subtitle", "time": 4810.63, "timestamp": "01:20:10", "text": "兄弟。あなたはそんなことはしないでしょう。あなたはそうしないでしょう"}, {"type": "subtitle", "time": 4811.47, "timestamp": "01:20:11", "text": "する"}, {"type": "subtitle", "time": 4813.149, "timestamp": "01:20:13", "text": "それ"}, {"type": "subtitle", "time": 4817.47, "timestamp": "01:20:17", "text": "だって、つまり、私は"}, {"type": "subtitle", "time": 4821.51, "timestamp": "01:20:21", "text": "人が逃げる。よし、走るよ。"}, {"type": "subtitle", "time": 4824.47, "timestamp": "01:20:24", "text": "何が起こっていますか？男がいて"}, {"type": "subtitle", "time": 4832.709, "timestamp": "01:20:32", "text": "私は皆に逃げるように伝えようとしていた。"}, {"type": "subtitle", "time": 4835.51, "timestamp": "01:20:35", "text": "ああ、あの老人だ。彼は、えっと、何を"}, {"type": "subtitle", "time": 4839.669, "timestamp": "01:20:39", "text": "それって何？彼は声を聞き分けることができる。おお、"}, {"type": "subtitle", "time": 4842.47, "timestamp": "01:20:42", "text": "くそ。はい、忘れていました。忘れていました。ドラックス"}, {"type": "subtitle", "time": 4844.63, "timestamp": "01:20:44", "text": "ああ、なんてこった。なぜなら私は覚えているから"}, {"type": "subtitle", "time": 4847.59, "timestamp": "01:20:47", "text": "起こったことは"}, {"type": "subtitle", "time": 4849.27, "timestamp": "01:20:49", "text": "ああ、こいつらったら。これらの人たちは"}, {"type": "subtitle", "time": 4851.35, "timestamp": "01:20:51", "text": "注意深い。彼らはもう話すのをやめるべきだ。なぜ"}]
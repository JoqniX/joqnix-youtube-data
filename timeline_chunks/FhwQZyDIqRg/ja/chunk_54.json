[{"type": "subtitle", "time": 3241.67, "timestamp": "00:54:01", "text": "彼が私を見かけるたびに。ただ私は"}, {"type": "subtitle", "time": 3245.03, "timestamp": "00:54:05", "text": "質問している。彼らは逃げ出したのだと思う。"}, {"type": "subtitle", "time": 3247.51, "timestamp": "00:54:07", "text": "彼らは逃げ出した。いや、違うよ。私たちは死んだ。おお、"}, {"type": "subtitle", "time": 3250.23, "timestamp": "00:54:10", "text": "逃げたってどういう意味ですか？はい。その"}, {"type": "subtitle", "time": 3252.309, "timestamp": "00:54:12", "text": "自分。彼は逃げようとしたが、"}, {"type": "subtitle", "time": 3254.39, "timestamp": "00:54:14", "text": "死んだ。うん。"}, {"type": "subtitle", "time": 3257.67, "timestamp": "00:54:17", "text": "なんてこった。いや。私から離れてください。逃げる"}, {"type": "subtitle", "time": 3260.39, "timestamp": "00:54:20", "text": "私から。逃げる。ああ、彼の声は"}, {"type": "subtitle", "time": 3263.03, "timestamp": "00:54:23", "text": "実際、変化している。ああ、君はブサイクだね。"}, {"type": "subtitle", "time": 3266.19, "timestamp": "00:54:26", "text": "君は醜い。君は醜い。いいえ、あなたは"}, {"type": "subtitle", "time": 3268.39, "timestamp": "00:54:28", "text": "醜い。大丈夫ですか？なんてこった？いいえ、"}, {"type": "subtitle", "time": 3270.63, "timestamp": "00:54:30", "text": "私は死んだ。私は死んだ。私は死んだ。私はできません"}, {"type": "subtitle", "time": 3273.79, "timestamp": "00:54:33", "text": "見た目がブサイクだよ。兄弟、これは"}, {"type": "subtitle", "time": 3277.75, "timestamp": "00:54:37", "text": "ようこそ。いらっしゃいませ。いや、君は"}, {"type": "subtitle", "time": 3280.87, "timestamp": "00:54:40", "text": "オフ。文字通り爆発したね。あなたの体"}, {"type": "subtitle", "time": 3282.95, "timestamp": "00:54:42", "text": "爆風が吹き、頭が落ちた"}, {"type": "subtitle", "time": 3285.109, "timestamp": "00:54:45", "text": "カート。それはまるで、「あなたはここにいますか？」と聞いているようだった。いいえ、"}, {"type": "subtitle", "time": 3288.95, "timestamp": "00:54:48", "text": "彼は文字通り私の目の前にいる。彼は"}, {"type": "subtitle", "time": 3292.79, "timestamp": "00:54:52", "text": "カート。頭の数を見てください"}, {"type": "subtitle", "time": 3295.109, "timestamp": "00:54:55", "text": "車の中で私に。あなたが彼をそこに置いた"}, {"type": "subtitle", "time": 3299.27, "timestamp": "00:54:59", "text": "いつも。いいえ、彼女は違います。"}]
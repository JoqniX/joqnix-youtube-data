[{"type": "subtitle", "time": 6723.589, "timestamp": "01:52:03", "text": "ああ、わかりました。だから、彼女に使わせてあげましょう。我々は持っています"}, {"type": "subtitle", "time": 6724.95, "timestamp": "01:52:04", "text": "十分なお金。私たちは何かを手に入れたい"}, {"type": "subtitle", "time": 6726.79, "timestamp": "01:52:06", "text": "それ以外。どれが"}, {"type": "subtitle", "time": 6730.39, "timestamp": "01:52:10", "text": "屋根裏。どこですか？とても難しい"}, {"type": "subtitle", "time": 6732.709, "timestamp": "01:52:12", "text": "区別する。"}, {"type": "subtitle", "time": 6734.95, "timestamp": "01:52:14", "text": "わからない。プレイするのは3回目です"}, {"type": "subtitle", "time": 6736.67, "timestamp": "01:52:16", "text": "実は。"}, {"type": "subtitle", "time": 6739.669, "timestamp": "01:52:19", "text": "[音楽]"}, {"type": "subtitle", "time": 6741.39, "timestamp": "01:52:21", "text": "3番目か4番目"}, {"type": "subtitle", "time": 6750.74, "timestamp": "01:52:30", "text": "アイデア。ああ、わかった。"}, {"type": "subtitle", "time": 6753.629, "timestamp": "01:52:33", "text": "[音楽]"}, {"type": "subtitle", "time": 6756.79, "timestamp": "01:52:36", "text": "わーい。上へ行きたいですか、それとも"}, {"type": "subtitle", "time": 6765.51, "timestamp": "01:52:45", "text": "ああ、その穴に飛び込んだ方がいいかもしれないよ。"}, {"type": "subtitle", "time": 6770.07, "timestamp": "01:52:50", "text": "はい、わかりました。さあ行こう。ああ、くそ。"}, {"type": "subtitle", "time": 6772.39, "timestamp": "01:52:52", "text": "わかった。何を盗めばいいの？何がもらえるの？"}]
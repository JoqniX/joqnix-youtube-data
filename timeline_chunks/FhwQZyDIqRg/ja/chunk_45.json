[{"type": "subtitle", "time": 2702.95, "timestamp": "00:45:02", "text": "車？奥の方にあります。"}, {"type": "subtitle", "time": 2705.03, "timestamp": "00:45:05", "text": "何？"}, {"type": "subtitle", "time": 2708.87, "timestamp": "00:45:08", "text": "どうぞお進みください。わかった。"}, {"type": "subtitle", "time": 2719.109, "timestamp": "00:45:19", "text": "何？何だって？"}, {"type": "subtitle", "time": 2723.19, "timestamp": "00:45:23", "text": "何？これは何ですか？何だって？私"}, {"type": "subtitle", "time": 2733.43, "timestamp": "00:45:33", "text": "ああ、私は死んでしまった。"}, {"type": "subtitle", "time": 2735.75, "timestamp": "00:45:35", "text": "彼らに伝えてください。ああ、なんてことだ。私たちはもう死んでしまったも同然だった。"}, {"type": "subtitle", "time": 2737.91, "timestamp": "00:45:37", "text": "私たちはただのイマジンのカップルです。私たち二人とも"}, {"type": "subtitle", "time": 2739.829, "timestamp": "00:45:39", "text": "彼らのうちの。私たちはこれをプレイしました。私たちは遊んだ"}, {"type": "subtitle", "time": 2741.589, "timestamp": "00:45:41", "text": "これと私たちはあなたに最初に"}, {"type": "subtitle", "time": 2750.23, "timestamp": "00:45:50", "text": "うん。ああ、くそ。私たちは彼らを全員殺した。"}, {"type": "subtitle", "time": 2755.109, "timestamp": "00:45:55", "text": "何てことだ。彼が来る。彼は、ああ、いやだ。"}, {"type": "subtitle", "time": 2757.75, "timestamp": "00:45:57", "text": "ああ、なんてことだ、彼女を見て。彼女はとてもかわいい。"}]
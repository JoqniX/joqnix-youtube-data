[{"type": "subtitle", "time": 3660.95, "timestamp": "01:01:00", "text": "こんにちは、のようですね。"}, {"type": "subtitle", "time": 3662.47, "timestamp": "01:01:02", "text": "まるで、どこへ行けばいいのか分からないような感じだ。私"}, {"type": "subtitle", "time": 3664.309, "timestamp": "01:01:04", "text": "ほら、彼女を見てごらん。彼女はとてもかわいい。"}, {"type": "subtitle", "time": 3666.15, "timestamp": "01:01:06", "text": "彼女は大丈夫、彼女はどこに行けばいいのかわからない"}, {"type": "subtitle", "time": 3667.99, "timestamp": "01:01:07", "text": "行く。彼女を助けられたらいいのに。なぜできないのか"}, {"type": "subtitle", "time": 3669.589, "timestamp": "01:01:09", "text": "私たちは幽霊になって、彼らを導くのを手伝う"}, {"type": "subtitle", "time": 3670.95, "timestamp": "01:01:10", "text": "彼らに指示を出すとか？それ"}, {"type": "subtitle", "time": 3672.549, "timestamp": "01:01:12", "text": "こうあるべきだった それはとても"}, {"type": "subtitle", "time": 3674.95, "timestamp": "01:01:14", "text": "かっこいいでしょ？私たちはただ幽霊になって"}, {"type": "subtitle", "time": 3677.589, "timestamp": "01:01:17", "text": "彼らを助けて、彼らはただ"}, {"type": "subtitle", "time": 3679.19, "timestamp": "01:01:19", "text": "もっと難しくする、といった感じ。ただ彼らに伝えればいい"}, {"type": "subtitle", "time": 3681.03, "timestamp": "01:01:21", "text": "まるであなたの声が聞こえるかのようです。"}, {"type": "subtitle", "time": 3683.589, "timestamp": "01:01:23", "text": "ほとんど"}, {"type": "subtitle", "time": 3685.91, "timestamp": "01:01:25", "text": "やり方があるように"}, {"type": "subtitle", "time": 3688.15, "timestamp": "01:01:28", "text": "危険な仲間と一緒にいる私は"}, {"type": "subtitle", "time": 3689.829, "timestamp": "01:01:29", "text": "このゲームならそれができると思うよ。おお"}, {"type": "subtitle", "time": 3692.47, "timestamp": "01:01:32", "text": "くそっ。うん。残念ながら、"}, {"type": "subtitle", "time": 3694.47, "timestamp": "01:01:34", "text": "残念ながら。ボールを取ってください。取っていく"}, {"type": "subtitle", "time": 3697.109, "timestamp": "01:01:37", "text": "ボール。ボールをそこにキープして。うん。わかった。"}, {"type": "subtitle", "time": 3700.069, "timestamp": "01:01:40", "text": "ボール。うん。そこにボールがあるんだけど、私は"}, {"type": "subtitle", "time": 3701.91, "timestamp": "01:01:41", "text": "いくらかは分からない。それはまるで、私は"}, {"type": "subtitle", "time": 3703.349, "timestamp": "01:01:43", "text": "知る。あれが何なのかさえわからない"}, {"type": "subtitle", "time": 3705.39, "timestamp": "01:01:45", "text": "は。"}, {"type": "subtitle", "time": 3708.34, "timestamp": "01:01:48", "text": "ああ、たくさんの小物だ。実は、"}, {"type": "subtitle", "time": 3709.589, "timestamp": "01:01:49", "text": "[音楽]"}, {"type": "subtitle", "time": 3711.03, "timestamp": "01:01:51", "text": "彼らは少なくとも来なければならない。彼らは"}, {"type": "subtitle", "time": 3712.95, "timestamp": "01:01:52", "text": "抽出ポイントに移動したい"}, {"type": "subtitle", "time": 3715.67, "timestamp": "01:01:55", "text": "そうすべきだからだ。うん、"}, {"type": "subtitle", "time": 3717.349, "timestamp": "01:01:57", "text": "1つ足りない。スペースの大部分"}]
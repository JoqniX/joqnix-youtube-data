[{"type": "subtitle", "time": 10683.51, "timestamp": "02:58:03", "text": "おお。ああ、くそ。おお。"}, {"type": "subtitle", "time": 10685.91, "timestamp": "02:58:05", "text": "ああ、もう。音楽がすごいよ、兄弟。の"}, {"type": "subtitle", "time": 10689.03, "timestamp": "02:58:09", "text": "音楽は強烈だ。うん。 1つを見てください"}, {"type": "subtitle", "time": 10693.309, "timestamp": "02:58:13", "text": "v 1。何てことだ。私が何だって？それはまさに"}, {"type": "subtitle", "time": 10695.91, "timestamp": "02:58:15", "text": "頭いい。つまり、夏美は勝者だったということだ。"}, {"type": "subtitle", "time": 10697.99, "timestamp": "02:58:17", "text": "ジョック、君は勝者だ。えーと、スプーン、"}, {"type": "subtitle", "time": 10700.07, "timestamp": "02:58:20", "text": "あなたは勝者です。残っているのは誰？おお、"}, {"type": "subtitle", "time": 10703.269, "timestamp": "02:58:23", "text": "勝ったのは誰？さあ行こう。新たな勝者が誕生しました。"}, {"type": "subtitle", "time": 10707.429, "timestamp": "02:58:27", "text": "新たな勝者が誕生しました。ニース。"}, {"type": "subtitle", "time": 10710.95, "timestamp": "02:58:30", "text": "だから、みんな、ああ、いや。私じゃないよ。私はします"}, {"type": "subtitle", "time": 10714.23, "timestamp": "02:58:34", "text": "何でもいいよ、兄弟。彼は片付けをしているんだよ、兄弟。"}, {"type": "subtitle", "time": 10725.03, "timestamp": "02:58:45", "text": "何てことだ。"}]
[{"type": "subtitle", "time": 4620.229, "timestamp": "01:17:00", "text": "ここ。ああ、いや、いや、いや。彼女は発売に間に合う"}, {"type": "subtitle", "time": 4622.63, "timestamp": "01:17:02", "text": "スピード。何？"}, {"type": "subtitle", "time": 4625.51, "timestamp": "01:17:05", "text": "あなたはそうしなかった。わかったよ、相棒。試してみます。"}, {"type": "subtitle", "time": 4627.55, "timestamp": "01:17:07", "text": "いや、いや。殺そう、君は違う"}, {"type": "subtitle", "time": 4630.55, "timestamp": "01:17:10", "text": "それを試着する それを試着する"}, {"type": "subtitle", "time": 4633.75, "timestamp": "01:17:13", "text": "奇妙な幽霊。本当に、殺して"}, {"type": "subtitle", "time": 4635.669, "timestamp": "01:17:15", "text": "誰か。"}, {"type": "subtitle", "time": 4637.59, "timestamp": "01:17:17", "text": "想像してみてください、誰かが"}, {"type": "subtitle", "time": 4639.27, "timestamp": "01:17:19", "text": "すでに幽霊のそばにいて、私は彼らを殺す"}, {"type": "subtitle", "time": 4641.27, "timestamp": "01:17:21", "text": "同じように。それは素敵だろうね。想像する"}, {"type": "subtitle", "time": 4642.87, "timestamp": "01:17:22", "text": "このトラックの中に何かある。想像してみて"}, {"type": "subtitle", "time": 4644.47, "timestamp": "01:17:24", "text": "このトラックには誰かが乗っている。これは"}, {"type": "subtitle", "time": 4646.229, "timestamp": "01:17:26", "text": "私に与えている これは私に動きを与えている"}, {"type": "subtitle", "time": 4648.189, "timestamp": "01:17:28", "text": "病気。それから"}, {"type": "subtitle", "time": 4651.189, "timestamp": "01:17:31", "text": "やめてください。うん。食べないで、だって私は"}, {"type": "subtitle", "time": 4653.83, "timestamp": "01:17:33", "text": "食べる。"}, {"type": "subtitle", "time": 4657.27, "timestamp": "01:17:37", "text": "待って。 D. 小さくして、このようにしてください。小さく始めよう。"}, {"type": "subtitle", "time": 4661.11, "timestamp": "01:17:41", "text": "いいえ。やってください。やってみろ。来て。来て。得る"}, {"type": "subtitle", "time": 4663.99, "timestamp": "01:17:43", "text": "あなた。さよなら。いや、いや、いや。私を信じて。信頼"}, {"type": "subtitle", "time": 4666.87, "timestamp": "01:17:46", "text": "自分。"}, {"type": "subtitle", "time": 4668.87, "timestamp": "01:17:48", "text": "さて、これからどうする？いいえ。"}, {"type": "subtitle", "time": 4676.55, "timestamp": "01:17:56", "text": "ごめん。なぜそんなことをするのですか？"}, {"type": "subtitle", "time": 4679.03, "timestamp": "01:17:59", "text": "あなたはしない。"}]
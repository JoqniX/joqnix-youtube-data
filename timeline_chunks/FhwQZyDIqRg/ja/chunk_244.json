[{"type": "subtitle", "time": 14641.03, "timestamp": "04:04:01", "text": "管理する、そして彼らはとてもとても"}, {"type": "subtitle", "time": 14644.15, "timestamp": "04:04:04", "text": "美しいソファなので、思わず叫んでしまいます"}, {"type": "subtitle", "time": 14650.03, "timestamp": "04:04:10", "text": "いつもそうなんです。ええ、そうですね。いやいや"}, {"type": "subtitle", "time": 14652.87, "timestamp": "04:04:12", "text": "うん、時々は放っておくよ"}, {"type": "subtitle", "time": 14656.229, "timestamp": "04:04:16", "text": "時々、そう思う時もあるけど、時々そう思う"}, {"type": "subtitle", "time": 14657.99, "timestamp": "04:04:17", "text": "もうどうでもいいと思うだろうけど"}, {"type": "subtitle", "time": 14660.63, "timestamp": "04:04:20", "text": "仕事は時々、与えられたもののように"}, {"type": "subtitle", "time": 14663.51, "timestamp": "04:04:23", "text": "私にそう言って、それから私は「わかった、私は"}, {"type": "subtitle", "time": 14666.309, "timestamp": "04:04:26", "text": "これらのことはすべて今すぐに完了し、"}, {"type": "subtitle", "time": 14668.309, "timestamp": "04:04:28", "text": "彼らは「少なくとも２人だ」と言う"}, {"type": "subtitle", "time": 14670.79, "timestamp": "04:04:30", "text": "予約なんてどうでもいいから終わらせてくれ"}, {"type": "subtitle", "time": 14674.15, "timestamp": "04:04:34", "text": "そして私は彼らのそばにいて彼らを導くでしょう"}, {"type": "subtitle", "time": 14677.03, "timestamp": "04:04:37", "text": "彼らが終わるまで彼らは"}, {"type": "subtitle", "time": 14679.349, "timestamp": "04:04:39", "text": "あの日のことで私を憎んでも構わない。でも、私は気にしない。私"}, {"type": "subtitle", "time": 14681.79, "timestamp": "04:04:41", "text": "その仕事をやり遂げたい。全部欲しい"}, {"type": "subtitle", "time": 14684.389, "timestamp": "04:04:44", "text": "署名済み。それは私のものです。それは私のものです。私はしません"}, {"type": "subtitle", "time": 14686.269, "timestamp": "04:04:46", "text": "ケア。彼らは私を憎んでいる。ほら、私は"}, {"type": "subtitle", "time": 14688.63, "timestamp": "04:04:48", "text": "感情的な側面を無視して"}, {"type": "subtitle", "time": 14690.71, "timestamp": "04:04:50", "text": "効率"}, {"type": "subtitle", "time": 14697.429, "timestamp": "04:04:57", "text": "終わり。あなたは効率性と乾燥を好みます"}, {"type": "subtitle", "time": 14699.83, "timestamp": "04:04:59", "text": "それは「はい」という意味だとしても。同意します。"}]
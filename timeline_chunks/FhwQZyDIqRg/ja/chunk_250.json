[{"type": "subtitle", "time": 15001.79, "timestamp": "04:10:01", "text": "こぼれが少ない、または全くない"}, {"type": "subtitle", "time": 15004.95, "timestamp": "04:10:04", "text": "こぼれ。だから私は自分の漏斗をお勧めします"}, {"type": "subtitle", "time": 15007.67, "timestamp": "04:10:07", "text": "方法。でも、私たちは"}, {"type": "subtitle", "time": 15009.269, "timestamp": "04:10:09", "text": "漏斗は必要ありません。検索しないでください"}, {"type": "subtitle", "time": 15012.07, "timestamp": "04:10:12", "text": "漏斗。大丈夫です。"}, {"type": "subtitle", "time": 15013.349, "timestamp": "04:10:13", "text": "でも私はそうするつもりはない"}, {"type": "subtitle", "time": 15014.71, "timestamp": "04:10:14", "text": "「ジャーク、君は間違っている。"}, {"type": "subtitle", "time": 15016.07, "timestamp": "04:10:16", "text": "こぼれて破壊する"}, {"type": "subtitle", "time": 15018.15, "timestamp": "04:10:18", "text": "すべて。」いいえ、ジャック、私は"}, {"type": "subtitle", "time": 15021.269, "timestamp": "04:10:21", "text": "「ジャック、君の言う通りだ」と言う。しかし私たちは"}, {"type": "subtitle", "time": 15023.59, "timestamp": "04:10:23", "text": "コンピューターを使って仕事をしている。もし"}, {"type": "subtitle", "time": 15027.189, "timestamp": "04:10:27", "text": "その回路でセットのようなドロップをドロップします、"}, {"type": "subtitle", "time": 15029.51, "timestamp": "04:10:29", "text": "全てが消え去るだろう。では、"}, {"type": "subtitle", "time": 15031.51, "timestamp": "04:10:31", "text": "ほんの数秒待つだけです。私にさせて"}, {"type": "subtitle", "time": 15033.91, "timestamp": "04:10:33", "text": "漏斗を用意してください。もうこれで終わりにしよう。"}, {"type": "subtitle", "time": 15035.67, "timestamp": "04:10:35", "text": "そしてあなたはこう思うでしょう。「ああ、彼はそうしたんだ」"}, {"type": "subtitle", "time": 15039.67, "timestamp": "04:10:39", "text": "私が正しいと言ってください。彼は「君ならできる」と言ってくれた。"}, {"type": "subtitle", "time": 15042.469, "timestamp": "04:10:42", "text": "そうそう。彼の言うことは理にかなっている。うん、"}, {"type": "subtitle", "time": 15044.87, "timestamp": "04:10:44", "text": "私たちはコンピューターを使って仕事をしています。もちろん、"}, {"type": "subtitle", "time": 15047.59, "timestamp": "04:10:47", "text": "そうすれば落ち着くでしょう。私が"}, {"type": "subtitle", "time": 15049.59, "timestamp": "04:10:49", "text": "私は、あなたは正しいと言いました。"}, {"type": "subtitle", "time": 15052.229, "timestamp": "04:10:52", "text": "わかった、君ならできるよ、君はこう言ったんだ、"}, {"type": "subtitle", "time": 15056.229, "timestamp": "04:10:56", "text": "「わかった、わかった。うん、できるよ。」おお、"}, {"type": "subtitle", "time": 15058.309, "timestamp": "04:10:58", "text": "うん。彼の言うことは理にかなっている。そうそう。我々は持っています"}]
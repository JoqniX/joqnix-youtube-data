[{"type": "subtitle", "time": 8520.15, "timestamp": "02:22:00", "text": "ほんの数日前と同じように、すみません、"}, {"type": "subtitle", "time": 8522.469, "timestamp": "02:22:02", "text": "数週間前、私は誰かを説得して"}, {"type": "subtitle", "time": 8524.469, "timestamp": "02:22:04", "text": "アニメを見る。彼らは「ああ、いやだ。"}, {"type": "subtitle", "time": 8525.75, "timestamp": "02:22:05", "text": "「アニメは好きじゃない」と言われたので、「なぜ？」と尋ねました。"}, {"type": "subtitle", "time": 8528.63, "timestamp": "02:22:08", "text": "そうじゃないの？」そして彼らはそれがどんな音なのかを説明した。"}, {"type": "subtitle", "time": 8530.389, "timestamp": "02:22:10", "text": "子供っぽいとか、そういう感じ。彼らはそうしない"}, {"type": "subtitle", "time": 8533.59, "timestamp": "02:22:13", "text": "あるいは、あなたを説得したい何か"}, {"type": "subtitle", "time": 8543.67, "timestamp": "02:22:23", "text": "またはメイデンアビス。ああ、彼らは見るべき"}, {"type": "subtitle", "time": 8545.59, "timestamp": "02:22:25", "text": "それ。彼らは「ああ、それは一部だ」と言うだろう"}, {"type": "subtitle", "time": 8548.55, "timestamp": "02:22:28", "text": "二。見てみましょう。"}, {"type": "subtitle", "time": 8551.99, "timestamp": "02:22:31", "text": "ああ、神様。邪魔してごめんよ、兄弟。"}, {"type": "subtitle", "time": 8554.07, "timestamp": "02:22:34", "text": "あ、すみません。来て。来て。言ってみて。"}, {"type": "subtitle", "time": 8556.389, "timestamp": "02:22:36", "text": "何て言ってたの？それで、私は彼らに言った"}, {"type": "subtitle", "time": 8558.23, "timestamp": "02:22:38", "text": "それは、"}, {"type": "subtitle", "time": 8560.63, "timestamp": "02:22:40", "text": "物語。まるでビデオみたい"}, {"type": "subtitle", "time": 8563.429, "timestamp": "02:22:43", "text": "ゲームは物語を語る方法であり、"}, {"type": "subtitle", "time": 8565.51, "timestamp": "02:22:45", "text": "映画や音楽は、"}, {"type": "subtitle", "time": 8567.11, "timestamp": "02:22:47", "text": "物語を語る。それはただの何か"}, {"type": "subtitle", "time": 8570.07, "timestamp": "02:22:50", "text": "そんな感じ。それはどんな人にも向けられたものではありません"}, {"type": "subtitle", "time": 8572.07, "timestamp": "02:22:52", "text": "子供や"}, {"type": "subtitle", "time": 8573.67, "timestamp": "02:22:53", "text": "何かあるよね？そして実際に"}, {"type": "subtitle", "time": 8575.27, "timestamp": "02:22:55", "text": "アニメを見た。信じられますか？"}, {"type": "subtitle", "time": 8577.75, "timestamp": "02:22:57", "text": "彼らが見ている、彼らが見ている"}]
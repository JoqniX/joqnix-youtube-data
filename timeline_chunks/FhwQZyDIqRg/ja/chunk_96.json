[{"type": "subtitle", "time": 5760.47, "timestamp": "01:36:00", "text": "わかった。じゃあ、トラックの中で休むよ"}, {"type": "subtitle", "time": 5764.229, "timestamp": "01:36:04", "text": "君たちも来ていいよ。わかった。バイバイ。"}, {"type": "subtitle", "time": 5766.39, "timestamp": "01:36:06", "text": "きちんとした。バイバイ。うん。私はただ"}, {"type": "subtitle", "time": 5768.709, "timestamp": "01:36:08", "text": "ここに座ってもいいですか？待って。あなたがこれを選んだのですか？"}, {"type": "subtitle", "time": 5773.35, "timestamp": "01:36:13", "text": "痛い。こんにちは。失礼します。"}, {"type": "subtitle", "time": 5775.75, "timestamp": "01:36:15", "text": "どこにある"}, {"type": "subtitle", "time": 5778.31, "timestamp": "01:36:18", "text": "それは既にここにある。あなたはなぜそこにいたのですか？"}, {"type": "subtitle", "time": 5779.91, "timestamp": "01:36:19", "text": "みんな、みんな、みんな。 2つ選びます"}, {"type": "subtitle", "time": 5782.149, "timestamp": "01:36:22", "text": "スタミナプレート。あなたにとってはそれで構いません。"}, {"type": "subtitle", "time": 5784.149, "timestamp": "01:36:24", "text": "これがあなたが私にしようとしたことなのね。おお、"}, {"type": "subtitle", "time": 5785.669, "timestamp": "01:36:25", "text": "それがあなたが私にしようとしたこと、"}, {"type": "subtitle", "time": 5792.709, "timestamp": "01:36:32", "text": "くそ。くそ、このゲーム。大丈夫だよ。私"}, {"type": "subtitle", "time": 5796.149, "timestamp": "01:36:36", "text": "わかったよ。ああ、これ覚えてるよ。"}, {"type": "subtitle", "time": 5797.59, "timestamp": "01:36:37", "text": "子供の頃、私はこれらを持っていた"}, {"type": "subtitle", "time": 5801.99, "timestamp": "01:36:41", "text": "ビデオデッキ用。何てことだ。"}, {"type": "subtitle", "time": 5804.229, "timestamp": "01:36:44", "text": "ああ、大変だ。どうしたの？ただ殺すだけ"}, {"type": "subtitle", "time": 5806.189, "timestamp": "01:36:46", "text": "誰か。できる"}, {"type": "subtitle", "time": 5810.149, "timestamp": "01:36:50", "text": "誰かが誰かをいじめているのに、私は誰かをいじめているのですか？"}, {"type": "subtitle", "time": 5812.39, "timestamp": "01:36:52", "text": "もしかしたら、私はいじめをしているのかもしれない。"}, {"type": "subtitle", "time": 5815.59, "timestamp": "01:36:55", "text": "なんてこった。なんてこった？彼を捕まえろ。彼を捕まえて、"}, {"type": "subtitle", "time": 5819.43, "timestamp": "01:36:59", "text": "男の子。彼を捕まえろ。あいつを捕まえろ、坊主。ああ、神様。"}]
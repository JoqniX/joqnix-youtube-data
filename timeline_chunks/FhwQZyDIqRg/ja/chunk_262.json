[{"type": "subtitle", "time": 15720.149, "timestamp": "04:22:00", "text": "目覚めとモデリングについて話す。おお、"}, {"type": "subtitle", "time": 15722.07, "timestamp": "04:22:02", "text": "私の言っていることが分かるよね？そうそう。うん。"}, {"type": "subtitle", "time": 15725.429, "timestamp": "04:22:05", "text": "ええ、あなたのことをぜひお話したいです"}, {"type": "subtitle", "time": 15727.99, "timestamp": "04:22:07", "text": "超VTuberみたいな感じ"}, {"type": "subtitle", "time": 15730.07, "timestamp": "04:22:10", "text": "フレンドリーでとても親切ですが、"}, {"type": "subtitle", "time": 15731.91, "timestamp": "04:22:11", "text": "リギングについて話す瞬間と"}, {"type": "subtitle", "time": 15734.389, "timestamp": "04:22:14", "text": "ピンポイントとリグポイント、私は行く"}, {"type": "subtitle", "time": 15736.389, "timestamp": "04:22:16", "text": "非常に混乱していて非常に"}, {"type": "subtitle", "time": 15740.309, "timestamp": "04:22:20", "text": "失った。そう、技術的に言えば、私は"}, {"type": "subtitle", "time": 15742.389, "timestamp": "04:22:22", "text": "退屈はしないだろうけど、"}, {"type": "subtitle", "time": 15745.91, "timestamp": "04:22:25", "text": "私はその中で途方に暮れてしまうだろう。私は負けない"}, {"type": "subtitle", "time": 15748.55, "timestamp": "04:22:28", "text": "もちろん興味はあるが、"}, {"type": "subtitle", "time": 15751.71, "timestamp": "04:22:31", "text": "完全に迷子になった。私はとても混乱するでしょう。その"}, {"type": "subtitle", "time": 15754.71, "timestamp": "04:22:34", "text": "「失われた」という言葉は、"}, {"type": "subtitle", "time": 15756.95, "timestamp": "04:22:36", "text": "えっと、質問があるんだけど、"}, {"type": "subtitle", "time": 15759.189, "timestamp": "04:22:39", "text": "疑い。どこに行けばいいのか全く分からないでしょう"}, {"type": "subtitle", "time": 15761.189, "timestamp": "04:22:41", "text": "疑問を抱くか、どこから始めればよいか"}, {"type": "subtitle", "time": 15764.229, "timestamp": "04:22:44", "text": "疑い。だからそれは「道に迷う」と呼ばれるのです。"}, {"type": "subtitle", "time": 15767.429, "timestamp": "04:22:47", "text": "会話の中で。うん。だから私は"}, {"type": "subtitle", "time": 15769.75, "timestamp": "04:22:49", "text": "会話に迷ったけど、私は"}, {"type": "subtitle", "time": 15772.469, "timestamp": "04:22:52", "text": "退屈したり興味を失ったりすると思う"}, {"type": "subtitle", "time": 15774.63, "timestamp": "04:22:54", "text": "この会話の中で。"}, {"type": "subtitle", "time": 15776.11, "timestamp": "04:22:56", "text": "だから私は"}]
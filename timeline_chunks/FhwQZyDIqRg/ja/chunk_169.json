[{"type": "subtitle", "time": 10148.71, "timestamp": "02:49:08", "text": "これはファシズム恐怖症じゃないよ。あなたが知っている、"}, {"type": "subtitle", "time": 10149.99, "timestamp": "02:49:09", "text": "プレイしても面白くない"}, {"type": "subtitle", "time": 10151.11, "timestamp": "02:49:11", "text": "見えないホラーゲーム"}, {"type": "subtitle", "time": 10155.269, "timestamp": "02:49:15", "text": "悪魔。けっこうだ。"}, {"type": "subtitle", "time": 10157.67, "timestamp": "02:49:17", "text": "今、あなたは悪魔の姿を見る。いいえ、私は"}, {"type": "subtitle", "time": 10160.07, "timestamp": "02:49:20", "text": "そう言ってもらえて嬉しいです。静かに、それは"}, {"type": "subtitle", "time": 10163.51, "timestamp": "02:49:23", "text": "それがどこにあるか。いや、近づかない方がいい。その"}, {"type": "subtitle", "time": 10166.389, "timestamp": "02:49:26", "text": "そこには。何てことだ。私はどこに行けばいいですか？えっと、"}, {"type": "subtitle", "time": 10168.87, "timestamp": "02:49:28", "text": "実際、ただ通り過ぎるのを待つだけでいいんです。"}, {"type": "subtitle", "time": 10170.71, "timestamp": "02:49:30", "text": "私たちはただそれが過ぎ去るのを待つだけです"}, {"type": "subtitle", "time": 10173.03, "timestamp": "02:49:33", "text": "戻ってください。それは向きを変えて殺すことはない"}, {"type": "subtitle", "time": 10176.23, "timestamp": "02:49:36", "text": "あなた。ドアの前を通ってもいいですか？"}, {"type": "subtitle", "time": 10179.269, "timestamp": "02:49:39", "text": "うまくいけば。なんてこった。ああ、それが過ぎ去ることを願っています"}, {"type": "subtitle", "time": 10181.19, "timestamp": "02:49:41", "text": "ああ、それはあなたに届くのね。かわいそうに。私"}, {"type": "subtitle", "time": 10184.79, "timestamp": "02:49:44", "text": "この男は好きじゃない。走る。走る。来る。おお、"}, {"type": "subtitle", "time": 10188.389, "timestamp": "02:49:48", "text": "いいえ。いいえ。行きます。走る。走る。走る。ライアンです"}, {"type": "subtitle", "time": 10189.91, "timestamp": "02:49:49", "text": "あなたの後ろに。走る。走る。走る。走る。さあ"}, {"type": "subtitle", "time": 10192.63, "timestamp": "02:49:52", "text": "行く。さあ行こう。さあ、行こう。みんな"}, {"type": "subtitle", "time": 10197.269, "timestamp": "02:49:57", "text": "入ります。ドアを閉めます。私は生きている。"}]
[{"type": "subtitle", "time": 10864.07, "timestamp": "03:01:04", "text": "ここまで来て、やり遂げてくれてありがとう。"}, {"type": "subtitle", "time": 10866.15, "timestamp": "03:01:06", "text": "もちろん。もちろん。"}, {"type": "subtitle", "time": 10867.67, "timestamp": "03:01:07", "text": "バイバイ。"}, {"type": "subtitle", "time": 10877.269, "timestamp": "03:01:17", "text": "ロビーを出ます。それから誰でも"}, {"type": "subtitle", "time": 10878.71, "timestamp": "03:01:18", "text": "全員が外出していたでしょう。しかし"}, {"type": "subtitle", "time": 10897.07, "timestamp": "03:01:37", "text": "それ。なぜ彼らは忙しいのですか？"}, {"type": "subtitle", "time": 10915.63, "timestamp": "03:01:55", "text": "[音楽]"}, {"type": "subtitle", "time": 10918.14, "timestamp": "03:01:58", "text": "よし、参加する必要がある"}]
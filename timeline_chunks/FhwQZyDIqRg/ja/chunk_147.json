[{"type": "subtitle", "time": 8821.429, "timestamp": "02:27:01", "text": "しかし最近は人々は「いや、それは"}, {"type": "subtitle", "time": 8823.429, "timestamp": "02:27:03", "text": "つまり、それはアルメンのことなんです。彼女はそうではない"}, {"type": "subtitle", "time": 8825.51, "timestamp": "02:27:05", "text": "「誰とでも結婚する。」 ええ。"}, {"type": "subtitle", "time": 8827.99, "timestamp": "02:27:07", "text": "著者もそれを認めた。"}, {"type": "subtitle", "time": 8830.15, "timestamp": "02:27:10", "text": "ファンの中には何度も見返す人がいるなんて、すごいですね"}, {"type": "subtitle", "time": 8832.23, "timestamp": "02:27:12", "text": "それを何度も繰り返して、さらに見つける"}, {"type": "subtitle", "time": 8836.15, "timestamp": "02:27:16", "text": "毎日参考文献を参照する。その通り。"}, {"type": "subtitle", "time": 8838.389, "timestamp": "02:27:18", "text": "恋人たちは、彼女が純粋なまま死んだことを意味する"}, {"type": "subtitle", "time": 8840.15, "timestamp": "02:27:20", "text": "日本文化。つまり、そうです。"}, {"type": "subtitle", "time": 8843.11, "timestamp": "02:27:23", "text": "その通り。 Mと、そして私はかなりそれが好きだと思う"}, {"type": "subtitle", "time": 8845.83, "timestamp": "02:27:25", "text": "本当にクールだね、想像してみて"}, {"type": "subtitle", "time": 8847.11, "timestamp": "02:27:27", "text": "ただ、すべての"}, {"type": "subtitle", "time": 8849.75, "timestamp": "02:27:29", "text": "それはミクタサだった"}, {"type": "subtitle", "time": 8851.67, "timestamp": "02:27:31", "text": "ええと、それがどのように発展したかはご存知でしょうし、"}, {"type": "subtitle", "time": 8854.389, "timestamp": "02:27:34", "text": "そして、皆さんが気づいたように、ああ、そうだね"}, {"type": "subtitle", "time": 8856.63, "timestamp": "02:27:36", "text": "続く。ごめん。いやいやいや、それはそれは"}, {"type": "subtitle", "time": 8858.87, "timestamp": "02:27:38", "text": "私が言いたいのはそれだけです。彼は実はあなただった"}, {"type": "subtitle", "time": 8860.79, "timestamp": "02:27:40", "text": "男たちはシーズン中に気づいた"}, {"type": "subtitle", "time": 8862.63, "timestamp": "02:27:42", "text": "エリンの目の色が変わっていたのは"}, {"type": "subtitle", "time": 8865.67, "timestamp": "02:27:45", "text": "アルメンは自分の目の色を忘れていた"}, {"type": "subtitle", "time": 8867.67, "timestamp": "02:27:47", "text": "物語を語っていた。"}, {"type": "subtitle", "time": 8869.91, "timestamp": "02:27:49", "text": "今まで気づきませんでした。だからエリンは"}, {"type": "subtitle", "time": 8872.309, "timestamp": "02:27:52", "text": "目の色は季節ごとに変化した。"}, {"type": "subtitle", "time": 8873.91, "timestamp": "02:27:53", "text": "最初は茶色だった"}, {"type": "subtitle", "time": 8877.59, "timestamp": "02:27:57", "text": "そして最後には緑色になる。うん。右。ああ、"}]
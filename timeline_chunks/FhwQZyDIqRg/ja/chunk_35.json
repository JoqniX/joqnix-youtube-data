[{"type": "subtitle", "time": 2100.55, "timestamp": "00:35:00", "text": "「ソロでプレイしてるんだよ、兄弟。」おい、俺は入ったんだ"}, {"type": "subtitle", "time": 2103.67, "timestamp": "00:35:03", "text": "最初の部屋に入った途端、私は死んだ。"}, {"type": "subtitle", "time": 2105.47, "timestamp": "00:35:05", "text": "おお、"}, {"type": "subtitle", "time": 2109.349, "timestamp": "00:35:09", "text": "そして私は知っています。そして、それはちょっと怖かった。"}, {"type": "subtitle", "time": 2111.19, "timestamp": "00:35:11", "text": "面白いのは、"}, {"type": "subtitle", "time": 2114.31, "timestamp": "00:35:14", "text": "一人でプレイすると怖いですよ。"}, {"type": "subtitle", "time": 2116.71, "timestamp": "00:35:16", "text": "ええ、その通りです。そうだよ、そうだよ。私"}, {"type": "subtitle", "time": 2118.99, "timestamp": "00:35:18", "text": "つまり、わかった。私の顔、どうしちゃったんだろう？"}, {"type": "subtitle", "time": 2121.91, "timestamp": "00:35:21", "text": "うん。でも今は大丈夫。今は"}, {"type": "subtitle", "time": 2124.23, "timestamp": "00:35:24", "text": "全く問題ありません。それは、"}, {"type": "subtitle", "time": 2134.63, "timestamp": "00:35:34", "text": "大丈夫。ええと、薬。わかった。わかった。手に入れた"}, {"type": "subtitle", "time": 2138.31, "timestamp": "00:35:38", "text": "彼。彼はそこにいる。彼はそこにいる。わかった。私"}, {"type": "subtitle", "time": 2141.19, "timestamp": "00:35:41", "text": "彼を招待した。"}, {"type": "subtitle", "time": 2150.95, "timestamp": "00:35:50", "text": "なぜ私のping値は62なのでしょうか？私は"}, {"type": "subtitle", "time": 2154.55, "timestamp": "00:35:54", "text": "インターネット接続が悪い。"}, {"type": "subtitle", "time": 2158.31, "timestamp": "00:35:58", "text": "あなたの何ですか？ゲーム中のpingは"}]
[{"type": "subtitle", "time": 13441.67, "timestamp": "03:44:01", "text": "スケジュールなどの整理ツールを使用し、"}, {"type": "subtitle", "time": 13447.67, "timestamp": "03:44:07", "text": "反対です。私は普段、計画を立てる際に"}, {"type": "subtitle", "time": 13449.79, "timestamp": "03:44:09", "text": "ハエ。だから、いいえ。"}, {"type": "subtitle", "time": 13452.389, "timestamp": "03:44:12", "text": "反対です。小さなミスでも"}, {"type": "chat", "time": 13453.207, "timestamp": "03:44:13", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "I just realised some questions are interpreted really differently by people"}, {"type": "subtitle", "time": 13455.79, "timestamp": "03:44:15", "text": "疑念を抱くか、全体的に見て。いやいやいやいやいや"}, {"type": "subtitle", "time": 13458.79, "timestamp": "03:44:18", "text": "同意できない。もし私がもたつくなら、私は"}, {"type": "subtitle", "time": 13460.95, "timestamp": "03:44:20", "text": "まるで私がただの失敗をしないように"}, {"type": "subtitle", "time": 13463.349, "timestamp": "03:44:23", "text": "以上。たぶん私はもたついて、あー"}, {"type": "subtitle", "time": 13465.15, "timestamp": "03:44:25", "text": "嫌なことが起こるものだ。誰が"}, {"type": "subtitle", "time": 13468.229, "timestamp": "03:44:28", "text": "気にかけている？私はただそれを続けるだけです。のように"}, {"type": "subtitle", "time": 13470.79, "timestamp": "03:44:30", "text": "たぶんこれが私のifならこれは"}, {"type": "subtitle", "time": 13473.59, "timestamp": "03:44:33", "text": "若い頃の私、私が"}, {"type": "subtitle", "time": 13476.71, "timestamp": "03:44:36", "text": "大学時代の私ならこう同意しただろう"}, {"type": "subtitle", "time": 13478.79, "timestamp": "03:44:38", "text": "ちょっとしたミスでも私の"}, {"type": "subtitle", "time": 13482.309, "timestamp": "03:44:42", "text": "一日中、いや一週間も、でも今は"}, {"type": "subtitle", "time": 13484.55, "timestamp": "03:44:44", "text": "いや、誰が気にするんだ、そういうこともあるさ"}, {"type": "subtitle", "time": 13487.83, "timestamp": "03:44:47", "text": "誰が気にするんだ、ただこの仕事を押し進めればいいだけ"}, {"type": "subtitle", "time": 13491.79, "timestamp": "03:44:51", "text": "今日は完了
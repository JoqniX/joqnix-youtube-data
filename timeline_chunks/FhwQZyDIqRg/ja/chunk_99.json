[{"type": "subtitle", "time": 5940.31, "timestamp": "01:39:00", "text": "くそっ。みんな、こっちに来て。あなたは嘘つきだ。私"}, {"type": "subtitle", "time": 5941.99, "timestamp": "01:39:01", "text": "スタミナアップグレードを2つ持っています。"}, {"type": "subtitle", "time": 5946.87, "timestamp": "01:39:06", "text": "方法。おお、いいね。青いのは私のものです。"}, {"type": "subtitle", "time": 5950.87, "timestamp": "01:39:10", "text": "わかった。戻ってくる。戻ってくる。しかたがない、"}, {"type": "subtitle", "time": 5953.43, "timestamp": "01:39:13", "text": "私が受けていた癒しは何だったのか"}, {"type": "subtitle", "time": 5955.109, "timestamp": "01:39:15", "text": "アップグレードします。"}, {"type": "subtitle", "time": 5957.51, "timestamp": "01:39:17", "text": "問題。うん、まずはそこから始めるべき"}, {"type": "subtitle", "time": 5965.59, "timestamp": "01:39:25", "text": "まあ、少なくとも私は回復した。私たちはする必要がある"}, {"type": "subtitle", "time": 5967.109, "timestamp": "01:39:27", "text": "またかよ、みんな。私たちはそれをする必要がある"}, {"type": "subtitle", "time": 5969.43, "timestamp": "01:39:29", "text": "また。"}, {"type": "subtitle", "time": 5973.03, "timestamp": "01:39:33", "text": "私たちは今、道路に向かっています。"}, {"type": "subtitle", "time": 5976.83, "timestamp": "01:39:36", "text": "さあ、みんな。私たちは勝てる。"}, {"type": "subtitle", "time": 5979.97, "timestamp": "01:39:39", "text": "よし、勝とう。"}, {"type": "subtitle", "time": 5982.629, "timestamp": "01:39:42", "text": "[音楽]"}, {"type": "subtitle", "time": 5989.03, "timestamp": "01:39:49", "text": "まるで君たちのベビーシッターをしているみたいだ"}, {"type": "subtitle", "time": 5991.59, "timestamp": "01:39:51", "text": "基本的にはそう。うん。うん。触らないで"}]
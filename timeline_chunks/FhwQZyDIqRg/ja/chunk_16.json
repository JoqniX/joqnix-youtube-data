[{"type": "subtitle", "time": 962.829, "timestamp": "00:16:02", "text": "けれど。私はそれが好きだ。"}, {"type": "subtitle", "time": 966.03, "timestamp": "00:16:06", "text": "ああ、それは本当に"}, {"type": "subtitle", "time": 970.31, "timestamp": "00:16:10", "text": "多く。ええ、そうですね。えっと、続きをさせてください。"}, {"type": "subtitle", "time": 972.509, "timestamp": "00:16:12", "text": "私が前に言っていたことは"}, {"type": "subtitle", "time": 977.79, "timestamp": "00:16:17", "text": "続き"}, {"type": "subtitle", "time": 980.949, "timestamp": "00:16:20", "text": "続く。えっと、こんにちは。"}, {"type": "subtitle", "time": 984.47, "timestamp": "00:16:24", "text": "だから、いつものように、私は"}, {"type": "subtitle", "time": 987.23, "timestamp": "00:16:27", "text": "働きすぎた"}, {"type": "subtitle", "time": 990.55, "timestamp": "00:16:30", "text": "特にストリーム関連のことと"}, {"type": "subtitle", "time": 994.71, "timestamp": "00:16:34", "text": "その後、私は、私は、"}, {"type": "subtitle", "time": 997.55, "timestamp": "00:16:37", "text": "猫に全く注意を払わなかった"}, {"type": "subtitle", "time": 1000.949, "timestamp": "00:16:40", "text": "デザインとか、私が欲しいものは何でも"}, {"type": "subtitle", "time": 1005.59, "timestamp": "00:16:45", "text": "将来、志望する"}, {"type": "subtitle", "time": 1006.749, "timestamp": "00:16:46", "text": "YouTuber"}, {"type": "subtitle", "time": 1010.03, "timestamp": "00:16:50", "text": "実際、何も"}, {"type": "subtitle", "time": 1012.47, "timestamp": "00:16:52", "text": "起こった。実際には何も起こらなかった。私"}, {"type": "subtitle", "time": 1013.55, "timestamp": "00:16:53", "text": "動かなかった"}, {"type": "subtitle", "time": 1018.15, "timestamp": "00:16:58", "text": "フォワード。私はただ自分のやりたいことをやるだけだと思った。"}]
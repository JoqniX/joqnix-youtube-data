[{"type": "subtitle", "time": 7561.43, "timestamp": "02:06:01", "text": "みんな、聞いてくれ。トラックに行きましょう。"}, {"type": "subtitle", "time": 7563.75, "timestamp": "02:06:03", "text": "もう一度トラックのところへ行きましょう。あなたはしない"}, {"type": "subtitle", "time": 7567.35, "timestamp": "02:06:07", "text": "Wキーか何かを連打する必要がある。やめてください"}, {"type": "subtitle", "time": 7569.43, "timestamp": "02:06:09", "text": "スパム。これはTwitchのチャットではありません。あなたが望むなら"}, {"type": "subtitle", "time": 7571.99, "timestamp": "02:06:11", "text": "スパム行為をするなら、Twitchかどこかでやればいい。"}, {"type": "subtitle", "time": 7574.55, "timestamp": "02:06:14", "text": "試してみてください。ああ、私には見えません。何"}, {"type": "subtitle", "time": 7576.149, "timestamp": "02:06:16", "text": "ここは一体地獄なのか？はい、もう一度言いますが、"}, {"type": "subtitle", "time": 7580.39, "timestamp": "02:06:20", "text": "15と16ではなく、1回か2回書く"}, {"type": "subtitle", "time": 7585.99, "timestamp": "02:06:25", "text": "回。動けません。動けません。"}, {"type": "subtitle", "time": 7588.41, "timestamp": "02:06:28", "text": "いいえ、ただいま。"}, {"type": "subtitle", "time": 7591.91, "timestamp": "02:06:31", "text": "[音楽]"}, {"type": "subtitle", "time": 7595.709, "timestamp": "02:06:35", "text": "ああ、くそ。こんにちは、ジョン。"}, {"type": "subtitle", "time": 7597.27, "timestamp": "02:06:37", "text": "こんにちは。"}, {"type": "subtitle", "time": 7599.35, "timestamp": "02:06:39", "text": "まあ、まんまと罠にはまったみたいだ。それは"}, {"type": "subtitle", "time": 7602.79, "timestamp": "02:06:42", "text": "非常識な。えっと、聞いたと思うんだけど"}, {"type": "subtitle", "time": 7604.95, "timestamp": "02:06:44", "text": "私は考えていた"}, {"type": "subtitle", "time": 7606.79, "timestamp": "02:06:46", "text": "理由がわからない。わからない。えっと、私は"}, {"type": "subtitle", "time": 7608.79, "timestamp": "02:06:48", "text": "家宅捜索か何かを受けたみたいだ。あった"}, {"type": "subtitle", "time": 7612.91, "timestamp": "02:06:52", "text": "パックのWを言う人たちのように"}, {"type": "subtitle", "time": 7614.95, "timestamp": "02:06:54", "text": "カイザー。何が起こっているのか分かりません。"}, {"type": "subtitle", "time": 7618.79, "timestamp": "02:06:58", "text": "気味悪かったよ、兄弟。わからない、わからない"}]
[{"type": "subtitle", "time": 15541.429, "timestamp": "04:19:01", "text": "ジレンマ。同意できないレベル３。私"}, {"type": "subtitle", "time": 15548.95, "timestamp": "04:19:08", "text": "倫理的なジレンマ。あ、待って。"}, {"type": "subtitle", "time": 15552.469, "timestamp": "04:19:12", "text": "倫理的ジレンマ。わかった。倫理的なジレンマ。"}, {"type": "subtitle", "time": 15558.309, "timestamp": "04:19:18", "text": "私は一般的に議論が好きではありません。"}, {"type": "subtitle", "time": 15559.229, "timestamp": "04:19:19", "text": "私はしません"}, {"type": "subtitle", "time": 15562.349, "timestamp": "04:19:22", "text": "楽しんで、楽しんで、私は楽しんでいない"}, {"type": "subtitle", "time": 15564.71, "timestamp": "04:19:24", "text": "議論はおろか、何事もだ。私はしません"}, {"type": "subtitle", "time": 15566.309, "timestamp": "04:19:26", "text": "議論する時間を持つ。私は持っていません"}, {"type": "subtitle", "time": 15568.83, "timestamp": "04:19:28", "text": "楽しむ時間だ。私は何を楽しんでいるのだろうか？"}, {"type": "subtitle", "time": 15576.469, "timestamp": "04:19:36", "text": "conf 状況では、"}, {"type": "subtitle", "time": 15578.389, "timestamp": "04:19:38", "text": "2つのうちどちらかを選ぶのは難しい"}, {"type": "subtitle", "time": 15581.269, "timestamp": "04:19:41", "text": "または、その他のオプション。つまり、それは"}, {"type": "subtitle", "time": 15584.149, "timestamp": "04:19:44", "text": "あなたは自分自身と議論している"}, {"type": "subtitle", "time": 15586.71, "timestamp": "04:19:46", "text": "どちらを選べばいいの？"}, {"type": "subtitle", "time": 15588.469, "timestamp": "04:19:48", "text": "そんな感じ？書いてあるとおりです"}, {"type": "subtitle", "time": 15591.91, "timestamp": "04:19:51", "text": "倫理的な議論を楽しむような議論"}, {"type": "subtitle", "time": 15595.429, "timestamp": "04:19:55", "text": "ジレンマ。ああ、わかった。わかった。楽しんでくださいと書いてあります"}, {"type": "subtitle", "time": 15597.429, "timestamp": "04:19:57", "text": "私はどれも楽しめないと思う"}]
[{"type": "subtitle", "time": 9845.429, "timestamp": "02:44:05", "text": "ああ、わかってるよ。それを見たよ。見たよ。私は見た"}, {"type": "subtitle", "time": 9849.03, "timestamp": "02:44:09", "text": "これ。何てことだ。私は不器用すぎるんです。私はしません"}, {"type": "subtitle", "time": 9851.51, "timestamp": "02:44:11", "text": "それが何であるか知っている"}, {"type": "subtitle", "time": 9857.349, "timestamp": "02:44:17", "text": "冷蔵庫を開けてください。"}, {"type": "subtitle", "time": 9860.23, "timestamp": "02:44:20", "text": "FBI、開けろ。"}, {"type": "subtitle", "time": 9863.91, "timestamp": "02:44:23", "text": "ごめんなさい、私はとても"}, {"type": "subtitle", "time": 9866.87, "timestamp": "02:44:26", "text": "コントロールを混同し続けています"}, {"type": "subtitle", "time": 9868.429, "timestamp": "02:44:28", "text": "シフト。私はとても悪い"}, {"type": "subtitle", "time": 9876.389, "timestamp": "02:44:36", "text": "ここにいくらか現金を用意してください。うん、何かあるね。"}, {"type": "subtitle", "time": 9886.15, "timestamp": "02:44:46", "text": "わかった。"}, {"type": "subtitle", "time": 9891.71, "timestamp": "02:44:51", "text": "そこには入らないで。ああ、くそ。そこには"}, {"type": "subtitle", "time": 9893.309, "timestamp": "02:44:53", "text": "悪魔。"}, {"type": "subtitle", "time": 9895.389, "timestamp": "02:44:55", "text": "大きい大きい"}]
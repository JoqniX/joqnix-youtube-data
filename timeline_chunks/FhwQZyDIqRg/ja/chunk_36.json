[{"type": "subtitle", "time": 2161.829, "timestamp": "00:36:01", "text": "低い。"}, {"type": "subtitle", "time": 2165.43, "timestamp": "00:36:05", "text": "みなさん、こんにちは。こんにちは。おい。何てことだ、"}, {"type": "subtitle", "time": 2167.91, "timestamp": "00:36:07", "text": "私たちは皆ここにいます。何てことだ。大好きです"}, {"type": "subtitle", "time": 2170.63, "timestamp": "00:36:10", "text": "頭が動くのが大好き"}, {"type": "subtitle", "time": 2173.51, "timestamp": "00:36:13", "text": "それ。すごく面白い。"}, {"type": "subtitle", "time": 2176.15, "timestamp": "00:36:16", "text": "あ、ところで、ちょっと、あの、"}, {"type": "subtitle", "time": 2178.39, "timestamp": "00:36:18", "text": "みんな、Discordで私をミュートして、"}, {"type": "subtitle", "time": 2180.63, "timestamp": "00:36:20", "text": "Discordのリアクティブメッセージを設定できます。"}, {"type": "subtitle", "time": 2184.55, "timestamp": "00:36:24", "text": "ミュートするのではなく、私を擁護してください。わかった。"}, {"type": "subtitle", "time": 2193.51, "timestamp": "00:36:33", "text": "わかった。わかった。了解です。よし。全て"}, {"type": "subtitle", "time": 2200.71, "timestamp": "00:36:40", "text": "ええと、ゆっくりと、そしてもっと近づいていきます。おお、"}, {"type": "subtitle", "time": 2202.63, "timestamp": "00:36:42", "text": "うん。"}, {"type": "subtitle", "time": 2205.75, "timestamp": "00:36:45", "text": "なぜ私はそれを見るのだろうか？だって君の声が聞こえるから"}, {"type": "subtitle", "time": 2206.829, "timestamp": "00:36:46", "text": "のように"}, {"type": "subtitle", "time": 2208.71, "timestamp": "00:36:48", "text": "反響している。面白い。そうそう。それは"}, {"type": "subtitle", "time": 2210.87, "timestamp": "00:36:50", "text": "2回。ええと、だから私はこう言っていたんです"}, {"type": "subtitle", "time": 2213.91, "timestamp": "00:36:53", "text": "ああ、もちろんできますよ"}, {"type": "subtitle", "time": 2216.069, "timestamp": "00:36:56", "text": "どうすればいいですか？ええと、それは"}, {"type": "subtitle", "time": 2218.069, "timestamp": "00:36:58", "text": "ヘッドホンアイコン。"}]
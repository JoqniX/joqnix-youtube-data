[{"type": "subtitle", "time": 2822.15, "timestamp": "00:47:02", "text": "私たちを蘇らせてください。わかった。わかった。"}, {"type": "subtitle", "time": 2826.47, "timestamp": "00:47:06", "text": "何？ああ、ただいま。"}, {"type": "subtitle", "time": 2830.39, "timestamp": "00:47:10", "text": "戻ってきました。戻ってきました。みんな。はい。"}, {"type": "subtitle", "time": 2832.39, "timestamp": "00:47:12", "text": "全員揃っている。さあ行こう。さあ行こう"}, {"type": "subtitle", "time": 2834.87, "timestamp": "00:47:14", "text": "先に。私の懐中電灯は"}, {"type": "subtitle", "time": 2837.109, "timestamp": "00:47:17", "text": "働く。ああ、それは重要ではない。うん、それ"}, {"type": "subtitle", "time": 2839.349, "timestamp": "00:47:19", "text": "重要ではない。彼はもう死んでいる。つまり、"}, {"type": "subtitle", "time": 2842.15, "timestamp": "00:47:22", "text": "うん、大丈夫だよ。幽霊をからかう"}, {"type": "subtitle", "time": 2845.46, "timestamp": "00:47:25", "text": "そして幽霊が彼を殺した。"}, {"type": "subtitle", "time": 2846.71, "timestamp": "00:47:26", "text": "[音楽]"}, {"type": "subtitle", "time": 2848.39, "timestamp": "00:47:28", "text": "ああ、彼を車に放り込んでやる。私"}, {"type": "subtitle", "time": 2850.87, "timestamp": "00:47:30", "text": "彼の"}, {"type": "subtitle", "time": 2853.79, "timestamp": "00:47:33", "text": "なんてこった。それは投げ込まれた"}, {"type": "subtitle", "time": 2857.75, "timestamp": "00:47:37", "text": "場所。彼の頭はまるで後ろに反り返ったかのようだった。"}, {"type": "subtitle", "time": 2860.15, "timestamp": "00:47:40", "text": "私の。私が先に彼を捕まえた。復活したの？おお、"}, {"type": "subtitle", "time": 2865.109, "timestamp": "00:47:45", "text": "いいえ。復活した。これは私のものです。"}, {"type": "subtitle", "time": 2867.589, "timestamp": "00:47:47", "text": "早く来て。あなたは何処に行きましたか？なんてこった。"}, {"type": "subtitle", "time": 2871.03, "timestamp": "00:47:51", "text": "みんな、それが戻ってきたよ。みんな、みんな、みんな、走れ。"}, {"type": "subtitle", "time": 2874.23, "timestamp": "00:47:54", "text": "復活した。復活した。復活した。なんてこった。"}, {"type": "subtitle", "time": 2877.43, "timestamp": "00:47:57", "text": "ここから出てもいいですか？みんな、もう帰ってもいい？ああ、"}, {"type": "subtitle", "time": 2879.51, "timestamp": "00:47:59", "text": "神。"}]
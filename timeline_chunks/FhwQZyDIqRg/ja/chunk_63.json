[{"type": "subtitle", "time": 3780.87, "timestamp": "01:03:00", "text": "文字通り後ろに隠れている。私はこう思った。"}, {"type": "subtitle", "time": 3783.67, "timestamp": "01:03:03", "text": "\"ああ、くそ。\"はい、閉じます。おお、"}, {"type": "subtitle", "time": 3786.15, "timestamp": "01:03:06", "text": "くそ。私たちは隠れるべきだ。彼は"}, {"type": "subtitle", "time": 3788.39, "timestamp": "01:03:08", "text": "左側と同じ。ほら、それは"}, {"type": "subtitle", "time": 3789.67, "timestamp": "01:03:09", "text": "もの。彼らがどこにいるのか、あなたは知らない"}, {"type": "subtitle", "time": 3792.789, "timestamp": "01:03:12", "text": "は。わかった。おお。またこれか。 1対1"}, {"type": "subtitle", "time": 3794.549, "timestamp": "01:03:14", "text": "時間。"}, {"type": "subtitle", "time": 3828.39, "timestamp": "01:03:48", "text": "[音楽]"}, {"type": "subtitle", "time": 3829.789, "timestamp": "01:03:49", "text": "ああ、私は捕まった"}, {"type": "subtitle", "time": 3832.15, "timestamp": "01:03:52", "text": "何か。なんてこった？来ないで"}, {"type": "subtitle", "time": 3834.069, "timestamp": "01:03:54", "text": "私の近く。もしあなたが"}, {"type": "subtitle", "time": 3837.029, "timestamp": "01:03:57", "text": "私のそばに来て。近づかないで。私は"}]
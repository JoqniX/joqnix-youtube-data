[{"type": "subtitle", "time": 9180.71, "timestamp": "02:33:00", "text": "彼らの選択だが、ただ言わないで"}, {"type": "subtitle", "time": 9183.349, "timestamp": "02:33:03", "text": "みんなにそのことを話した。多分"}, {"type": "subtitle", "time": 9186.71, "timestamp": "02:33:06", "text": "ああ、私はもう年を取りすぎている。私は「うん、ありがとう」と言いました。"}, {"type": "subtitle", "time": 9189.03, "timestamp": "02:33:09", "text": "はい、もちろんです。ええ、そうですね。ありがとう。"}, {"type": "subtitle", "time": 9191.99, "timestamp": "02:33:11", "text": "私のTEDトークを聞いていただき、ありがとうございました。"}, {"type": "subtitle", "time": 9193.75, "timestamp": "02:33:13", "text": "うん。うん。だから今、"}, {"type": "subtitle", "time": 9196.71, "timestamp": "02:33:16", "text": "グループディスカッションの配信は終了しました。"}, {"type": "subtitle", "time": 9199.51, "timestamp": "02:33:19", "text": "うん。うん。何てことだ。私たちは遊ぶことができます"}, {"type": "subtitle", "time": 9202.79, "timestamp": "02:33:22", "text": "ゲーム。レポをプレイできるよね？"}, {"type": "subtitle", "time": 9204.87, "timestamp": "02:33:24", "text": "うん。うん。じゃあ、もう一回やろうか。"}, {"type": "subtitle", "time": 9206.389, "timestamp": "02:33:26", "text": "さあ、行こう。さあ行こう。さあ行こう。おお、"}, {"type": "subtitle", "time": 9208.55, "timestamp": "02:33:28", "text": "あと1つ。わかった。私は、私たちが"}, {"type": "subtitle", "time": 9209.91, "timestamp": "02:33:29", "text": "配信を終了しました。だから私たちは"}, {"type": "subtitle", "time": 9212.79, "timestamp": "02:33:32", "text": "話し合っていた。正直に言うと。"}, {"type": "subtitle", "time": 9214.469, "timestamp": "02:33:34", "text": "なぜ？何？なぜ？だって君は"}, {"type": "subtitle", "time": 9216.55, "timestamp": "02:33:36", "text": "出発します。うん。それが理由です"}, {"type": "subtitle", "time": 9217.83, "timestamp": "02:33:37", "text": "私たちはみんなが"}, {"type": "subtitle", "time": 9219.51, "timestamp": "02:33:39", "text": "まさにその通りです。あなたは10時30分と言いましたね。"}, {"type": "subtitle", "time": 9222.309, "timestamp": "02:33:42", "text": "覚えて？大丈夫です。 11. 彼は"}, {"type": "subtitle", "time": 9224.15, "timestamp": "02:33:44", "text": "離れる。でも、君たちは"}, {"type": "subtitle", "time": 9226.55, "timestamp": "02:33:46", "text": "興味深い会話だった。それは本当だ。"}, {"type": "subtitle", "time": 9229.51, "timestamp": "02:33:49", "text": "それは本当だ。楽しんでいただけて嬉しいです。"}, {"type": "subtitle", "time": 9231.27, "timestamp": "02:33:51", "text": "楽しんでいただけて嬉しいです。と"}, {"type": "subtitle", "time": 9232.79, "timestamp": "02:33:52", "text": "何か本当にうまくいくものができるまで"}, {"type": "subtitle", "time": 9234.87, "timestamp": "02:33:54", "text": "する。楽しい会話だったと思います。"}, {"type": "subtitle", "time": 9237.67, "timestamp": "02:33:57", "text": "そうだったよね？うん。うん。その通り。わーい。それで、"}, {"type": "subtitle", "time": 9239.19, "timestamp": "02:33:59", "text": "ゲームをしに行こう、そうすればみんな"}]
[{"type": "subtitle", "time": 6245.83, "timestamp": "01:44:05", "text": "そこには巨大な札束の入った袋があった。その"}, {"type": "subtitle", "time": 6248.629, "timestamp": "01:44:08", "text": "大丈夫。それらを抽出場所へ連れて行きましょう。"}, {"type": "subtitle", "time": 6251.59, "timestamp": "01:44:11", "text": "私は皆さんの前に立つつもりです。"}, {"type": "subtitle", "time": 6253.109, "timestamp": "01:44:13", "text": "だから、何かあったら、"}, {"type": "subtitle", "time": 6255.75, "timestamp": "01:44:15", "text": "手榴弾を投げろ。君たちは下がってて。私は持っている"}, {"type": "subtitle", "time": 6258.07, "timestamp": "01:44:18", "text": "そのアイテムだよ、兄弟。そんなこと言わないで。"}, {"type": "subtitle", "time": 6259.59, "timestamp": "01:44:19", "text": "ああ、手榴弾を投げるよ。私には見えない"}, {"type": "subtitle", "time": 6261.27, "timestamp": "01:44:21", "text": "道。何故ですか？私は"}, {"type": "subtitle", "time": 6266.39, "timestamp": "01:44:26", "text": "方法。ああ、わかりました。次へ。"}, {"type": "subtitle", "time": 6268.709, "timestamp": "01:44:28", "text": "私たちはただそれを見つけるまで歩き回るだけです、"}, {"type": "subtitle", "time": 6270.55, "timestamp": "01:44:30", "text": "推測。"}, {"type": "subtitle", "time": 6279.03, "timestamp": "01:44:39", "text": "見てみましょう。できますか、できますか"}, {"type": "subtitle", "time": 6281.669, "timestamp": "01:44:41", "text": "この分量の鍋で実験する"}, {"type": "subtitle", "time": 6284.31, "timestamp": "01:44:44", "text": "ここ？それはHPを回復させますか？緑"}, {"type": "subtitle", "time": 6287.03, "timestamp": "01:44:47", "text": "1つ？緑色のやつ？死ぬような気がする"}, {"type": "subtitle", "time": 6289.35, "timestamp": "01:44:49", "text": "あなた。私はそうは思わない。それはあなたを殺す。私"}, {"type": "subtitle", "time": 6291.99, "timestamp": "01:44:51", "text": "そこには入りたくない。えっと、"}, {"type": "subtitle", "time": 6294.87, "timestamp": "01:44:54", "text": "試す。私は98個くらい持っています。"}]
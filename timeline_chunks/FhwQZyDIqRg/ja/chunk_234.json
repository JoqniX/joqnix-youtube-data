[{"type": "subtitle", "time": 14041.99, "timestamp": "03:54:01", "text": "人に関する質問。だから私は、"}, {"type": "subtitle", "time": 14044.389, "timestamp": "03:54:04", "text": "人生に足を踏み入れたら、いつも"}, {"type": "subtitle", "time": 14046.63, "timestamp": "03:54:06", "text": "両方。バランスを取る必要があるだけです"}, {"type": "subtitle", "time": 14049.51, "timestamp": "03:54:09", "text": "そしてその日のどちらが良いかを見て"}, {"type": "chat", "time": 14050.667, "timestamp": "03:54:10", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "🤧"}, {"type": "subtitle", "time": 14052.15, "timestamp": "03:54:12", "text": "それに身を任せてください。私の言っていることが分かるよね？"}, {"type": "subtitle", "time": 14054.63, "timestamp": "03:54:14", "text": "常に正しいとか間違っているとかいうわけではない。すべて"}, {"type": "subtitle", "time": 14056.55, "timestamp": "03:54:16", "text": "両方です。あなたはただ待つだけです"}, {"type": "subtitle", "time": 14058.389, "timestamp": "03:54:18", "text": "右とロング、そしてあなたは"}, {"type": "subtitle", "time": 14061.99, "timestamp": "03:54:21", "text": "それ。それが人生というものだ。"}, {"type": "subtitle", "time": 14064.59, "timestamp": "03:54:24", "text": "しかし、あなたは人々の意見よりも事実を優先します"}, {"type": "subtitle", "time": 14067.99, "timestamp": "03:54:27", "text": "感情。いや、普段は"}, {"type": "subtitle", "time": 14070.79, "timestamp": "03:54:30", "text": "他人の感情。ご存知のように"}, {"type": "subtitle", "time": 14074.55, "timestamp": "03:54:34", "text": "前に言ったように、私は通常その男に任せる"}, {"type": "subtitle", "time": 14077.11, "timestamp": "03:54:37", "text": "ブロックするのではなく、まずは一日休みを取る"}, {"type": "subtitle", "time": 14079.269, "timestamp": "03:54:39", "text": "初日の彼、わかるでしょ？"}, {"type": "subtitle", "time": 14081.67, "timestamp": "03:54:41", "text": "そう、それはよく"}, {"type": "subtitle", "time": 14085.99, "timestamp": "03:54:45", "text": "いつも、あなたはしばしば一日を"}, {"type": "subtitle", "time": 14092.55, "timestamp": "03:54:52", "text": "それが私のスタイル"}, {"type": "subtitle", "time": 14093.83, "timestamp": "03:54:53", "text": "私は気にしない、私は気にしない"}, {"type": "subtitle", "time": 14095.309, "timestamp": "03:54:55", "text": "私がしないスケジュール"}, {"type": "subtitle", "time": 14097.91, "timestamp": "03:54:57", "text": "スケジュールはただ起こるもので、私は"}, {"type": "subtitle", "time": 14099.75, "timestamp": "03:54:59", "text": "流れに身を任せれば、めったに心配することはありません"}]
[{"type": "subtitle", "time": 2042.31, "timestamp": "00:34:02", "text": "全員に見える？わかった、"}, {"type": "subtitle", "time": 2045.549, "timestamp": "00:34:05", "text": "2番。彼らはどこにいるんだ？"}, {"type": "subtitle", "time": 2048.03, "timestamp": "00:34:08", "text": "え、何？"}, {"type": "subtitle", "time": 2050.589, "timestamp": "00:34:10", "text": "なぜ？どこへ行ったの？"}, {"type": "chat", "time": 2053.373, "timestamp": "00:34:13", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "oh a collab"}, {"type": "subtitle", "time": 2054.19, "timestamp": "00:34:14", "text": "どこ？ああ、神様、私は嫌いです"}, {"type": "chat", "time": 2058.247, "timestamp": "00:34:18", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "goodgood"}, {"type": "subtitle", "time": 2064.389, "timestamp": "00:34:24", "text": "えっと、ちょっと待ってください。ちょっと待ってください。"}, {"type": "subtitle", "time": 2069.71, "timestamp": "00:34:29", "text": "私はします。わかった。する必要がある"}, {"type": "subtitle", "time": 2073.909, "timestamp": "00:34:33", "text": "素早く。よし。うん、必要だ。わかった。"}, {"type": "subtitle", "time": 2075.629, "timestamp": "00:34:35", "text": "だから、私たちは待っている"}, {"type": "subtitle", "time": 2078.47, "timestamp": "00:34:38", "text": "あと1人分。いいえ、あと2人"}, {"type": "subtitle", "time": 2080.99, "timestamp": "00:34:40", "text": "参加する。"}, {"type": "subtitle", "time": 2089.349, "timestamp": "00:34:49", "text": "いや、これはすごく変だよ、だって私は"}, {"type": "subtitle", "time": 2091.829, "timestamp": "00:34:51", "text": "実際にこのゲームをプレイしたことがある"}, {"type": "subtitle", "time": 2093.349, "timestamp": "00:34:53", "text": "退屈だったから。私は何が"}, {"type": "subtitle", "time": 2095.19, "timestamp": "00:34:55", "text": "やるべきこと。それで、7時30分にログインして"}, {"type": "subtitle", "time": 2096.99, "timestamp": "00:34:56", "text": "「よし、やってみよう」と思ったんです。"}]
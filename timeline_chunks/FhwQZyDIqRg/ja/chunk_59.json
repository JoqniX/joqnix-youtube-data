[{"type": "subtitle", "time": 3556.87, "timestamp": "00:59:16", "text": "あぁ、ちょっと待って。"}, {"type": "subtitle", "time": 3560.63, "timestamp": "00:59:20", "text": "わかった。ああ、猿め、みんな。私たちはそうしません"}, {"type": "subtitle", "time": 3564.39, "timestamp": "00:59:24", "text": "気をつけろ、気をつけろ、気をつけろ、気をつけろ。"}, {"type": "subtitle", "time": 3567.349, "timestamp": "00:59:27", "text": "その通りです。"}, {"type": "subtitle", "time": 3570.549, "timestamp": "00:59:30", "text": "ここに置いておきます。そのままにしておいてください"}, {"type": "subtitle", "time": 3573.75, "timestamp": "00:59:33", "text": "ここ。ここに巨大な目玉がある。"}, {"type": "subtitle", "time": 3576.15, "timestamp": "00:59:36", "text": "うん。みんな、僕たちはできると思うよ"}, {"type": "subtitle", "time": 3578.789, "timestamp": "00:59:38", "text": "今すぐ立ち去れ。うん。うん。さあ行こう。さあ"}, {"type": "subtitle", "time": 3580.549, "timestamp": "00:59:40", "text": "離れる。"}, {"type": "subtitle", "time": 3589.789, "timestamp": "00:59:49", "text": "みんな、"}, {"type": "subtitle", "time": 3592.42, "timestamp": "00:59:52", "text": "えっと、私たちはここを離れなければなりません。おお"}, {"type": "subtitle", "time": 3594.589, "timestamp": "00:59:54", "text": "[音楽]"}]
[{"type": "subtitle", "time": 5582.91, "timestamp": "01:33:02", "text": "ダイヤモンドだよ、相棒。"}, {"type": "subtitle", "time": 5585.99, "timestamp": "01:33:05", "text": "ここに持ってきてください。今なら誰もが"}, {"type": "subtitle", "time": 5589.83, "timestamp": "01:33:09", "text": "周りを見渡せば何か見つかるはずだ。"}, {"type": "subtitle", "time": 5595.51, "timestamp": "01:33:15", "text": "少なくとも私にはできるものが一つある"}, {"type": "subtitle", "time": 5604.39, "timestamp": "01:33:24", "text": "スクロールホイールを内側に回して引っ張ることができます"}, {"type": "subtitle", "time": 5609.03, "timestamp": "01:33:29", "text": "もっと近くに。スクロールダウンしてもいいですか？"}, {"type": "subtitle", "time": 5612.629, "timestamp": "01:33:32", "text": "わからない。うん、"}, {"type": "subtitle", "time": 5615.55, "timestamp": "01:33:35", "text": "あなたと同じように。いいえ、私は穏やかな歌を歌っています"}, {"type": "subtitle", "time": 5619.189, "timestamp": "01:33:39", "text": "インパラ。私が歌っているのはテーム・インパラです。"}, {"type": "subtitle", "time": 5620.709, "timestamp": "01:33:40", "text": "あまりにも。"}]
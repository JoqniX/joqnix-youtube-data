[{"type": "subtitle", "time": 4020.63, "timestamp": "01:07:00", "text": "ごめん。ああ、なんてことだ。私たちは発見しました"}, {"type": "subtitle", "time": 4021.47, "timestamp": "01:07:01", "text": "私たちは"}, {"type": "subtitle", "time": 4032.95, "timestamp": "01:07:12", "text": "お金を手に入れた。それは私ではありません。私はハゲています。"}, {"type": "subtitle", "time": 4047.91, "timestamp": "01:07:27", "text": "力をください。ああ、また小人か。"}, {"type": "subtitle", "time": 4063.91, "timestamp": "01:07:43", "text": "ああ、見て。これは一体何ですか？いや、いや、いや、"}, {"type": "subtitle", "time": 4066.15, "timestamp": "01:07:46", "text": "いや、いや、いや。君は酔っぱらうだろうね。"}, {"type": "subtitle", "time": 4069.27, "timestamp": "01:07:49", "text": "いいえ、それは胸の中に入れるべきです。待って、"}]
[{"type": "subtitle", "time": 13500.99, "timestamp": "03:45:00", "text": "いいえ。"}, {"type": "subtitle", "time": 13503.51, "timestamp": "03:45:03", "text": "反対です。私は人と話すのが好きではない"}, {"type": "subtitle", "time": 13505.83, "timestamp": "03:45:05", "text": "彼らが"}, {"type": "subtitle", "time": 13509.189, "timestamp": "03:45:09", "text": "えっと、彼らは私の"}, {"type": "subtitle", "time": 13512.63, "timestamp": "03:45:12", "text": "分野。医者のところに行って"}, {"type": "subtitle", "time": 13514.389, "timestamp": "03:45:14", "text": "会話を始めてみよう。でも私にはできない"}, {"type": "subtitle", "time": 13517.03, "timestamp": "03:45:17", "text": "見知らぬ人に話しかけてみて。待って、待って、"}, {"type": "subtitle", "time": 13518.95, "timestamp": "03:45:18", "text": "ちょっと待ってください。それが問題ですか？"}, {"type": "subtitle", "time": 13520.87, "timestamp": "03:45:20", "text": "見つけた？わかった。わかった。私は読んでいません"}, {"type": "subtitle", "time": 13522.95, "timestamp": "03:45:22", "text": "私はバカなので質問します。見つける"}, {"type": "subtitle", "time": 13524.15, "timestamp": "03:45:24", "text": "快適。居心地はいかがですか"}, {"type": "subtitle", "time": 13525.99, "timestamp": "03:45:25", "text": "見つけた人にただ歩いていくだけ"}, {"type": "subtitle", "time": 13527.189, "timestamp": "03:45:27", "text": "興味深いし、"}, {"type": "subtitle", "time": 13534.469, "timestamp": "03:45:34", "text": "いいえ。やはり違います。それでもダメだ。えっと、また、まだ"}, {"type": "subtitle", "time": 13537.349, "timestamp": "03:45:37", "text": "誰かが私に近づいてこない限り、あなたのように"}, {"type": "subtitle", "time": 13539.11, "timestamp": "03:45:39", "text": "会話を始めようとしない"}, {"type": "subtitle", "time": 13542.15, "timestamp": "03:45:42", "text": "そんなに話すのが好きじゃない。誰かのような人を除いて"}, {"type": "subtitle", "time": 13544.95, "timestamp": "03:45:44", "text": "私に彼らと話をするように頼むか何か。"}, {"type": "subtitle", "time": 13547.429, "timestamp": "03:45:47", "text": "彼らと話す用事がない限りは。私"}, {"type": "subtitle", "time": 13549.99, "timestamp": "03:45:49", "text": "ただ単に、ご存知のように、いくつかの"}, {"type": "subtitle", "time": 13551.99, "timestamp": "03:45:51", "text": "変な感じ"}, {"type": "subtitle", "time": 13555.229, "timestamp": "03:45:55", "text": "うーん、奇妙な直感で、ただ行くだけです"}, {"type": "subtitle", "time": 13557.91, "timestamp": "03:45:57", "text": "それらの奇妙な侵入思考と"}, {"type": "subtitle", "time": 13559.51, "timestamp": "03:45:59", "text": "彼らと話をして、私がしないようなことをする"}]
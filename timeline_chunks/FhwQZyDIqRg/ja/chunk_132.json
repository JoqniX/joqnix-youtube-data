[{"type": "subtitle", "time": 7921.99, "timestamp": "02:12:01", "text": "それでは、これを上げましょう。えっと、スピードアップグレードしました"}, {"type": "subtitle", "time": 7923.83, "timestamp": "02:12:03", "text": "そしてそれはどこにも存在しない。誰か私に"}, {"type": "subtitle", "time": 7926.79, "timestamp": "02:12:06", "text": "どなたか助けていただけませんか？私はHPを使っています。私は59人います。"}, {"type": "subtitle", "time": 7929.87, "timestamp": "02:12:09", "text": "ごめんなさい。私はできません。"}, {"type": "subtitle", "time": 7932.39, "timestamp": "02:12:12", "text": "つまり、もしそれがあなたにそう感じさせるなら"}, {"type": "subtitle", "time": 7935.709, "timestamp": "02:12:15", "text": "良いものなら何でも、私は参加します。それで、"}, {"type": "subtitle", "time": 7938.43, "timestamp": "02:12:18", "text": "私"}, {"type": "subtitle", "time": 7941.83, "timestamp": "02:12:21", "text": "男にとって、分かち合うことは思いやりだよ、兄弟。うん、"}, {"type": "subtitle", "time": 7944.55, "timestamp": "02:12:24", "text": "私たちは分かち合わなければならない。"}, {"type": "subtitle", "time": 7946.39, "timestamp": "02:12:26", "text": "分かち合うことは思いやりを示すことだ。彼らはあなたに"}, {"type": "subtitle", "time": 7949.149, "timestamp": "02:12:29", "text": "1年生だよ、みんな。来て。"}, {"type": "subtitle", "time": 7953.91, "timestamp": "02:12:33", "text": "うん。よし、行こう。わかった。"}, {"type": "subtitle", "time": 7955.83, "timestamp": "02:12:35", "text": "よし。行くよ。私はたくさん持っています"}, {"type": "subtitle", "time": 7957.589, "timestamp": "02:12:37", "text": "スタミナの問題なので、先に偵察に行こう"}, {"type": "subtitle", "time": 7961.27, "timestamp": "02:12:41", "text": "そして、そこにいること。私を見ている。えっと、こんにちは。"}, {"type": "subtitle", "time": 7965.27, "timestamp": "02:12:45", "text": "警官だ。こんにちは。 「こんにちは」の裏側。あなた"}, {"type": "subtitle", "time": 7967.83, "timestamp": "02:12:47", "text": "何も見なかったの？わかった。いいえ。できますか？"}, {"type": "subtitle", "time": 7970.229, "timestamp": "02:12:50", "text": "みんな、聞こえる？こんにちは？良い。うん。こんにちは。"}, {"type": "subtitle", "time": 7972.47, "timestamp": "02:12:52", "text": "これは高価だ。直接"}, {"type": "subtitle", "time": 7975.189, "timestamp": "02:12:55", "text": "ええと、まっすぐに、そう、これ"}]
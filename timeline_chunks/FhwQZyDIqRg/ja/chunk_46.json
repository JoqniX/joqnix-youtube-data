[{"type": "subtitle", "time": 2761.03, "timestamp": "00:46:01", "text": "坊や、こっちへおいで。ええ、そうです。うん、"}, {"type": "subtitle", "time": 2763.589, "timestamp": "00:46:03", "text": "男の子。"}, {"type": "subtitle", "time": 2770.55, "timestamp": "00:46:10", "text": "よくやった。こんにちは。"}, {"type": "subtitle", "time": 2780.79, "timestamp": "00:46:20", "text": "ああ、なんて可愛いの。まあ。"}, {"type": "subtitle", "time": 2783.349, "timestamp": "00:46:23", "text": "ああ、兄弟。一生懸命働くことも同様に重要です。彼らはそうしなかった"}, {"type": "subtitle", "time": 2785.109, "timestamp": "00:46:25", "text": "私が悪態をついてもいいかどうか教えてください。何をすればいいですか"}, {"type": "subtitle", "time": 2787.589, "timestamp": "00:46:27", "text": "する？あなたはできる。私は表現を持っています。"}, {"type": "subtitle", "time": 2789.91, "timestamp": "00:46:29", "text": "私はあなたが欲しいです。もちろんできますよ。ところで、"}, {"type": "subtitle", "time": 2791.75, "timestamp": "00:46:31", "text": "彼らにはできない。何てことだ。できるのか、でも君は"}, {"type": "subtitle", "time": 2797.03, "timestamp": "00:46:37", "text": "タイピングできるよね？はい、できますよ。ええ、でも"}, {"type": "subtitle", "time": 2798.95, "timestamp": "00:46:38", "text": "そうは思わない。いや、そうだね。これは"}, {"type": "subtitle", "time": 2801.109, "timestamp": "00:46:41", "text": "のように"}, {"type": "subtitle", "time": 2804.47, "timestamp": "00:46:44", "text": "ああ、しまった。待って、あなたが入力してください。あなたは"}, {"type": "subtitle", "time": 2806.63, "timestamp": "00:46:46", "text": "近い。"}, {"type": "subtitle", "time": 2808.39, "timestamp": "00:46:48", "text": "もうすぐです。"}, {"type": "subtitle", "time": 2810.309, "timestamp": "00:46:50", "text": "そうすべきでしょうか？そうそう。彼の頭が落ちた"}, {"type": "subtitle", "time": 2812.63, "timestamp": "00:46:52", "text": "まるで彼の頭がそこに飛んでいったかのようだった。行った"}, {"type": "subtitle", "time": 2815.19, "timestamp": "00:46:55", "text": "一度だけあなたを救ってあげました。"}, {"type": "subtitle", "time": 2817.51, "timestamp": "00:46:57", "text": "ええ、彼らは聞こえないんです。ああ、抽出"}, {"type": "subtitle", "time": 2818.87, "timestamp": "00:46:58", "text": "完了。彼らは私たちを蘇らせてくれるだろう。彼らは"}]
[{"type": "subtitle", "time": 9960.07, "timestamp": "02:46:00", "text": "ママ、私も一緒に行くよ。"}, {"type": "subtitle", "time": 9962.309, "timestamp": "02:46:02", "text": "ありがとう。"}, {"type": "subtitle", "time": 9965.59, "timestamp": "02:46:05", "text": "だから何？動作が遅いですか？"}, {"type": "subtitle", "time": 9969.429, "timestamp": "02:46:09", "text": "ありがとう。なんて紳士的な方でしょう。"}, {"type": "subtitle", "time": 9972.23, "timestamp": "02:46:12", "text": "私のためにドアを開けてくれた。"}, {"type": "subtitle", "time": 9974.95, "timestamp": "02:46:14", "text": "ええ、ありますよ。ああ、ちくしょう。その"}, {"type": "subtitle", "time": 9986.91, "timestamp": "02:46:26", "text": "え、何？何てことだ。私"}, {"type": "subtitle", "time": 9991.15, "timestamp": "02:46:31", "text": "私の父を知っている。いいえ、価値があります。あ、待って。"}, {"type": "subtitle", "time": 9993.19, "timestamp": "02:46:33", "text": "そこには。ください。ください。与える。与える。あなた"}, {"type": "subtitle", "time": 9994.71, "timestamp": "02:46:34", "text": "待てる。大丈夫。大丈夫。我々はできる"}, {"type": "subtitle", "time": 9996.79, "timestamp": "02:46:36", "text": "待って。やってみろ。やってみろ。これは初めてではない"}, {"type": "subtitle", "time": 9997.83, "timestamp": "02:46:37", "text": "抽出。これは初めてではない"}, {"type": "subtitle", "time": 10007.23, "timestamp": "02:46:47", "text": "すみません。彼女は生きているのか？"}, {"type": "subtitle", "time": 10010.469, "timestamp": "02:46:50", "text": "わーい。さあ行こう。ああ、ここにいる。ああ、あなたは"}, {"type": "subtitle", "time": 10011.91, "timestamp": "02:46:51", "text": "何か良いこと。ええ、何かあります。"}, {"type": "subtitle", "time": 10013.269, "timestamp": "02:46:53", "text": "カードを入れてください。カードを入れてください。入れる"}, {"type": "subtitle", "time": 10015.99, "timestamp": "02:46:55", "text": "彼らはカードを持っていないから。できますか？"}, {"type": "subtitle", "time": 10019.03, "timestamp": "02:46:59", "text": "彼らが運ぶのを手伝う？ああ、わかりました。はい。それは"}]
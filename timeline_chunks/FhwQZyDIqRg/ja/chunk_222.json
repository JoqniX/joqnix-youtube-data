[{"type": "subtitle", "time": 13321.03, "timestamp": "03:42:01", "text": "了解、了解。聞こえますか？はい、そうです"}, {"type": "subtitle", "time": 13323.469, "timestamp": "03:42:03", "text": "現在は完全に動作しています。それは"}, {"type": "subtitle", "time": 13326.229, "timestamp": "03:42:06", "text": "どうやらサーバー側のようです。そうそう。うん。うん。"}, {"type": "subtitle", "time": 13329.51, "timestamp": "03:42:09", "text": "わかった。電話は通じたよね？人々、"}, {"type": "subtitle", "time": 13331.03, "timestamp": "03:42:11", "text": "これはどういう意味ですか？人々の物語と"}, {"type": "subtitle", "time": 13333.19, "timestamp": "03:42:13", "text": "感情は、"}, {"type": "subtitle", "time": 13339.11, "timestamp": "03:42:19", "text": "あなたは几帳面ですか、分析家ですか"}, {"type": "subtitle", "time": 13342.309, "timestamp": "03:42:22", "text": "人間らしい人、それとも感情的な人のような人？"}, {"type": "subtitle", "time": 13345.51, "timestamp": "03:42:25", "text": "ああ、わかりました。わかった。そういうことなんだよね？"}, {"type": "subtitle", "time": 13347.07, "timestamp": "03:42:27", "text": "数字または"}, {"type": "subtitle", "time": 13350.95, "timestamp": "03:42:30", "text": "データ？どちらも当てはまります。ご覧のとおり"}, {"type": "subtitle", "time": 13354.15, "timestamp": "03:42:34", "text": "物語を見て、数字を見て、"}, {"type": "subtitle", "time": 13356.79, "timestamp": "03:42:36", "text": "それらを比較して、もしそれがここにあるなら"}, {"type": "subtitle", "time": 13361.03, "timestamp": "03:42:41", "text": "もしそれが何らかの形で一致するならば。うん、それ"}, {"type": "subtitle", "time": 13363.59, "timestamp": "03:42:43", "text": "なるほど。想像してみて、ある男がやってくる"}, {"type": "subtitle", "time": 13365.91, "timestamp": "03:42:45", "text": "君次第だよ、そしてこう言うんだ、「おい、俺は"}, {"type": "subtitle", "time": 13369.99, "timestamp": "03:42:49", "text": "ある日、白いカラスがあちこちを飛び回っていて"}, {"type": "subtitle", "time": 13374.11, "timestamp": "03:42:54", "text": "数字を取り上げて言う"}, {"type": "subtitle", "time": 13377.51, "timestamp": "03:42:57", "text": "ああ、白いカラスを見なかったか、"}]
[{"type": "subtitle", "time": 1382.149, "timestamp": "00:23:02", "text": "その日、私に送ってきたのは"}, {"type": "subtitle", "time": 1385.19, "timestamp": "00:23:05", "text": "それ自体、あるいはそう、翌日彼女は送ってきた"}, {"type": "subtitle", "time": 1398.43, "timestamp": "00:23:18", "text": "私の彼女は実際に彼女は"}, {"type": "subtitle", "time": 1399.95, "timestamp": "00:23:19", "text": "実は"}, {"type": "subtitle", "time": 1403.029, "timestamp": "00:23:23", "text": "えっと、どう言うんだっけ？"}, {"type": "subtitle", "time": 1405.75, "timestamp": "00:23:25", "text": "きちんと？困ったことがあって"}, {"type": "subtitle", "time": 1407.35, "timestamp": "00:23:27", "text": "適切な言葉を見つける"}, {"type": "subtitle", "time": 1410.59, "timestamp": "00:23:30", "text": "私は衝撃を受けたと言った。"}, {"type": "subtitle", "time": 1418.19, "timestamp": "00:23:38", "text": "おお"}, {"type": "subtitle", "time": 1421.63, "timestamp": "00:23:41", "text": "こんにちは、とても"}, {"type": "subtitle", "time": 1423.909, "timestamp": "00:23:43", "text": "衝撃的だった、本当に本当に本当に"}, {"type": "subtitle", "time": 1438.029, "timestamp": "00:23:58", "text": "えっと、もっと詳しく"}]
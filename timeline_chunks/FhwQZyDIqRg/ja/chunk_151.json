[{"type": "subtitle", "time": 9062.07, "timestamp": "02:31:02", "text": "とても嫌なことだが、"}, {"type": "subtitle", "time": 9063.349, "timestamp": "02:31:03", "text": "あなたが見ているものは気持ち悪いですか？"}, {"type": "subtitle", "time": 9065.429, "timestamp": "02:31:05", "text": "私って結構年取ってるよね？私は本当に成熟している"}, {"type": "subtitle", "time": 9067.51, "timestamp": "02:31:07", "text": "このことについて。現時点では、私は"}, {"type": "subtitle", "time": 9069.51, "timestamp": "02:31:09", "text": "「私は16歳です」とか「私は20歳です」とか言うつもりです"}, {"type": "subtitle", "time": 9071.429, "timestamp": "02:31:11", "text": "もしくは、私は19歳です、まあ、どっちでもいいです。私は行くつもりです"}, {"type": "subtitle", "time": 9073.27, "timestamp": "02:31:13", "text": "反対もすべて。私には誰かがいる"}, {"type": "subtitle", "time": 9075.59, "timestamp": "02:31:15", "text": "ここまで来た人は"}, {"type": "subtitle", "time": 9076.87, "timestamp": "02:31:16", "text": "ほら、ここにはたくさんの人がいる"}, {"type": "subtitle", "time": 9078.55, "timestamp": "02:31:18", "text": "世界は、彼らが何をしているかを知らない。"}, {"type": "subtitle", "time": 9080.07, "timestamp": "02:31:20", "text": "そして、もしあなたが皆を責め始め、"}, {"type": "subtitle", "time": 9082.389, "timestamp": "02:31:22", "text": "みんなをターゲットにするけど、何もない"}, {"type": "subtitle", "time": 9086.07, "timestamp": "02:31:26", "text": "憎しみよりも左翼的。そして、あのね、私が"}, {"type": "subtitle", "time": 9089.11, "timestamp": "02:31:29", "text": "あれを見てよ、えっと、つまり私は"}, {"type": "subtitle", "time": 9090.469, "timestamp": "02:31:30", "text": "奇妙な理論だ。人々がどのように"}, {"type": "subtitle", "time": 9091.83, "timestamp": "02:31:31", "text": "これを受け入れるだろうし、おそらく"}, {"type": "subtitle", "time": 9093.59, "timestamp": "02:31:33", "text": "人々は私を嫌うだろう、なぜなら"}, {"type": "subtitle", "time": 9096.15, "timestamp": "02:31:36", "text": "彼女の意図がわかった。私は"}, {"type": "subtitle", "time": 9099.11, "timestamp": "02:31:39", "text": "知ってるけど、もしあなたがそれを見て"}, {"type": "subtitle", "time": 9101.99, "timestamp": "02:31:41", "text": "汚いものだと思う、うーん、私は"}, {"type": "subtitle", "time": 9104.15, "timestamp": "02:31:44", "text": "そう言うと汚いことになるのは、"}, {"type": "subtitle", "time": 9111.03, "timestamp": "02:31:51", "text": "これもまた素晴らしい作品です。だから私にとっては、つまり私は"}, {"type": "subtitle", "time": 9112.71, "timestamp": "02:31:52", "text": "わからない。私は私は私は私は場所にいます"}, {"type": "subtitle", "time": 9114.55, "timestamp": "02:31:54", "text": "異なると思うところ"}, {"type": "subtitle", "time": 9115.83, "timestamp": "02:31:55", "text": "たくさんの"}, {"type": "subtitle", "time": 9117.99, "timestamp": "02:31:57", "text": "そこで起こっていること。人々は人々を持っている"}]
[{"type": "subtitle", "time": 5407.75, "timestamp": "01:30:07", "text": "ああ、くそ。"}, {"type": "subtitle", "time": 5409.99, "timestamp": "01:30:09", "text": "ああ、神様。自分の身を守れ。君ならできるよ。"}, {"type": "subtitle", "time": 5418.149, "timestamp": "01:30:18", "text": "ああ、彼女は自分自身を手に入れようとしているんだ。いいえ、"}, {"type": "subtitle", "time": 5421.35, "timestamp": "01:30:21", "text": "彼女は戻るべきだ。後ろに下がってください。女の子、"}, {"type": "subtitle", "time": 5426.39, "timestamp": "01:30:26", "text": "なぜ？なぜこんなことをしたのですか？私はしませんでした。私"}, {"type": "subtitle", "time": 5428.79, "timestamp": "01:30:28", "text": "彼がそこで発砲するとは思っていなかった。私"}, {"type": "subtitle", "time": 5431.75, "timestamp": "01:30:31", "text": "彼はあちこち撃ちまくっていると思った。"}, {"type": "subtitle", "time": 5434.709, "timestamp": "01:30:34", "text": "彼はテーブルの上から射撃していた。ああ、"}, {"type": "subtitle", "time": 5438.55, "timestamp": "01:30:38", "text": "神。大丈夫です。木材を貫通する。 1対"}, {"type": "subtitle", "time": 5441.39, "timestamp": "01:30:41", "text": "一度。私は思う"}, {"type": "subtitle", "time": 5444.629, "timestamp": "01:30:44", "text": "私たちは再びこのゲームに戻ってきました。私はこれが嫌いです"}, {"type": "subtitle", "time": 5446.229, "timestamp": "01:30:46", "text": "ゲーム。私は人を殺すのが大嫌いだ。だから私は"}, {"type": "subtitle", "time": 5448.149, "timestamp": "01:30:48", "text": "このまま定着するだろう。"}]
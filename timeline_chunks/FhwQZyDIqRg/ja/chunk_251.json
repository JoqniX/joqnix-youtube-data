[{"type": "subtitle", "time": 15060.229, "timestamp": "04:11:00", "text": "コンピューターの電源を入れてください。わかった。うん。うん。それは"}, {"type": "subtitle", "time": 15063.429, "timestamp": "04:11:03", "text": "センス。なるほど。うん。うん。うん。"}, {"type": "subtitle", "time": 15065.03, "timestamp": "04:11:05", "text": "うん。どうぞ、ヴィックさん。お願いします"}, {"type": "subtitle", "time": 15067.83, "timestamp": "04:11:07", "text": "自分のやり方でやってみてください。大丈夫です。どうぞ。"}, {"type": "subtitle", "time": 15069.59, "timestamp": "04:11:09", "text": "そんな感じ。そういうものなんだ。それは"}, {"type": "subtitle", "time": 15072.15, "timestamp": "04:11:12", "text": "常に聖霊の働きがない。"}, {"type": "subtitle", "time": 15076.469, "timestamp": "04:11:16", "text": "見る？うん。同意できない場合は、"}, {"type": "subtitle", "time": 15079.349, "timestamp": "04:11:19", "text": "自分の主張を証明するために指し示すか、"}, {"type": "subtitle", "time": 15080.95, "timestamp": "04:11:20", "text": "人々の感情を守る。あなたがしなければならない"}, {"type": "subtitle", "time": 15082.87, "timestamp": "04:11:22", "text": "両方ともやってください。自分の主張を証明しなければならない"}, {"type": "subtitle", "time": 15089.99, "timestamp": "04:11:29", "text": "そうですね、私は番号を選びます"}, {"type": "subtitle", "time": 15094.71, "timestamp": "04:11:34", "text": "1つ目、私は両方やっているので同意します"}, {"type": "subtitle", "time": 15097.91, "timestamp": "04:11:37", "text": "なぜなら私は、究極的にはなぜ私は"}, {"type": "subtitle", "time": 15099.91, "timestamp": "04:11:39", "text": "これをやっているの？保存したいから"}, {"type": "subtitle", "time": 15102.469, "timestamp": "04:11:42", "text": "彼らの友情。私たちは二人とも友達です。私"}, {"type": "subtitle", "time": 15105.03, "timestamp": "04:11:45", "text": "したくない、あるいは私たちは絡み合いたくない"}, {"type": "subtitle", "time": 15108.15, "timestamp": "04:11:48", "text": "この小さなもののために。だから明らかに私は"}, {"type": "subtitle", "time": 15110.15, "timestamp": "04:11:50", "text": "傷つけたくないからこうしている"}, {"type": "subtitle", "time": 15113.59, "timestamp": "04:11:53", "text": "あなた。だから私は優先している"}, {"type": "subtitle", "time": 15116.79, "timestamp": "04:11:56", "text": "気持ちはするけど、でも私は自分の"}, {"type": "subtitle", "time": 15119.91, "timestamp": "04:11:59", "text": "ポイント。私は両方やっています。はい、私は"}]
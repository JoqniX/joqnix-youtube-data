[{"type": "subtitle", "time": 1021.15, "timestamp": "00:17:01", "text": "自分のやるべきことをやっている。おい。"}, {"type": "subtitle", "time": 1023.99, "timestamp": "00:17:03", "text": "そして私は本当に前に進まなかったのは、"}, {"type": "subtitle", "time": 1027.669, "timestamp": "00:17:07", "text": "忙しかった。忙しいというより、イライラしている"}, {"type": "subtitle", "time": 1029.309, "timestamp": "00:17:09", "text": "たくさんの"}, {"type": "subtitle", "time": 1034.549, "timestamp": "00:17:14", "text": "もの。しかし、この休憩中に"}, {"type": "subtitle", "time": 1037.35, "timestamp": "00:17:17", "text": "ハヤトゥスって、どう発音するの？うん。"}, {"type": "subtitle", "time": 1041.47, "timestamp": "00:17:21", "text": "この休み、1ヶ月の休み、"}, {"type": "subtitle", "time": 1045.909, "timestamp": "00:17:25", "text": "私は本当に自分のために時間を取って"}, {"type": "subtitle", "time": 1047.069, "timestamp": "00:17:27", "text": "本当に"}, {"type": "subtitle", "time": 1050.95, "timestamp": "00:17:30", "text": "理解して、自分自身を取り戻したような気がする。私"}, {"type": "subtitle", "time": 1053.909, "timestamp": "00:17:33", "text": "愛と温かさを理解する、"}, {"type": "subtitle", "time": 1056.63, "timestamp": "00:17:36", "text": "頭、みんなのハグ"}, {"type": "subtitle", "time": 1059.23, "timestamp": "00:17:39", "text": "くれた。すべての"}, {"type": "subtitle", "time": 1062.23, "timestamp": "00:17:42", "text": "ストリームストリームとDiscordで"}, {"type": "subtitle", "time": 1065.11, "timestamp": "00:17:45", "text": "あらゆる場所、Twitter、YouTube、Twitch、"}, {"type": "subtitle", "time": 1067.75, "timestamp": "00:17:47", "text": "どこにでも。皆さんは私にたくさんの"}, {"type": "subtitle", "time": 1072.029, "timestamp": "00:17:52", "text": "愛は、私に大きなインスピレーションを与えてくれました。"}, {"type": "subtitle", "time": 1074.19, "timestamp": "00:17:54", "text": "こんにちは。"}, {"type": "subtitle", "time": 1076.83, "timestamp": "00:17:56", "text": "そして私は"}]
[{"type": "subtitle", "time": 729.509, "timestamp": "00:12:09", "text": "音楽？おや、これは何でしょう？丸いもの。"}, {"type": "subtitle", "time": 730.829, "timestamp": "00:12:10", "text": "何が"}, {"type": "subtitle", "time": 733.47, "timestamp": "00:12:13", "text": "これ？"}, {"type": "subtitle", "time": 737.389, "timestamp": "00:12:17", "text": "Hがここに何か持ってるよ。何が"}, {"type": "subtitle", "time": 741.03, "timestamp": "00:12:21", "text": "これ？それは目です。私は眼鏡をかけています。おお。"}, {"type": "subtitle", "time": 757.23, "timestamp": "00:12:37", "text": "ああ、これでよし。それが私の顔です。"}, {"type": "subtitle", "time": 759.15, "timestamp": "00:12:39", "text": "おお。"}, {"type": "subtitle", "time": 760.75, "timestamp": "00:12:40", "text": "[音楽]"}, {"type": "subtitle", "time": 762.59, "timestamp": "00:12:42", "text": "おお。"}, {"type": "subtitle", "time": 766.15, "timestamp": "00:12:46", "text": "H. ああ、キラキラしたものが見える。おお、"}, {"type": "subtitle", "time": 768.389, "timestamp": "00:12:48", "text": "それは何ですか？"}, {"type": "subtitle", "time": 770.67, "timestamp": "00:12:50", "text": "何が"}, {"type": "subtitle", "time": 773.389, "timestamp": "00:12:53", "text": "それ？"}, {"type": "subtitle", "time": 777.509, "timestamp": "00:12:57", "text": "H ああ、それは良いことだ、彼は最も幸せだ"}]
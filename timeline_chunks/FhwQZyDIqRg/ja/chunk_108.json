[{"type": "subtitle", "time": 6482.39, "timestamp": "01:48:02", "text": "あ、こんにちは。全員死んでしまったのか？いや、いや、いや。"}, {"type": "subtitle", "time": 6485.27, "timestamp": "01:48:05", "text": "彼らは中に走り込んでいる。"}, {"type": "subtitle", "time": 6487.43, "timestamp": "01:48:07", "text": "おい、あれが俺についてきてるぞ。ところで、私は"}, {"type": "subtitle", "time": 6491.59, "timestamp": "01:48:11", "text": "敵意を抱く。持続する。ゼノはどこにいる？"}, {"type": "subtitle", "time": 6493.35, "timestamp": "01:48:13", "text": "彼女が幽霊の背後にいる。そしてあなたは行く"}, {"type": "subtitle", "time": 6497.189, "timestamp": "01:48:17", "text": "あなたはテーブルの周りをぐるぐる回っているのですか？"}, {"type": "subtitle", "time": 6500.39, "timestamp": "01:48:20", "text": "ああ、神様。それはもうすぐ来る。それはもうすぐ来る。おお"}, {"type": "subtitle", "time": 6507.27, "timestamp": "01:48:27", "text": "しまった。"}, {"type": "subtitle", "time": 6510.55, "timestamp": "01:48:30", "text": "待って、どうすれば君を救えるの？わからない。"}, {"type": "subtitle", "time": 6520.709, "timestamp": "01:48:40", "text": "何てことだ。何てことだ。"}, {"type": "subtitle", "time": 6522.75, "timestamp": "01:48:42", "text": "ああ、神様。私はとても"}, {"type": "subtitle", "time": 6525.03, "timestamp": "01:48:45", "text": "怖がった。私は一人になりたくない。"}, {"type": "subtitle", "time": 6526.87, "timestamp": "01:48:46", "text": "最後に残ったのは、私が"}, {"type": "subtitle", "time": 6531.99, "timestamp": "01:48:51", "text": "無理だろう。おい、俺は叫んだんだ。"}, {"type": "subtitle", "time": 6533.75, "timestamp": "01:48:53", "text": "幽霊はそこに行ったんだよね？幽霊"}, {"type": "subtitle", "time": 6536.79, "timestamp": "01:48:56", "text": "そこへ行った。私は何をしますか？私は良くない"}, {"type": "subtitle", "time": 6539.8, "timestamp": "01:48:59", "text": "ホラーゲームで。これ"}]
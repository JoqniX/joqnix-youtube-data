[{"type": "subtitle", "time": 4141.829, "timestamp": "01:09:01", "text": "何てことだ。"}, {"type": "subtitle", "time": 4146.149, "timestamp": "01:09:06", "text": "見て、ジマの目。"}, {"type": "subtitle", "time": 4154.46, "timestamp": "01:09:14", "text": "わかった。うん。試してみますか？試してみますか？"}, {"type": "subtitle", "time": 4155.749, "timestamp": "01:09:15", "text": "[音楽]"}, {"type": "subtitle", "time": 4162.39, "timestamp": "01:09:22", "text": "試しています。なぜ？なんでそんなに笑ってるの？"}, {"type": "subtitle", "time": 4165.99, "timestamp": "01:09:25", "text": "それ？どうしたの？どうしたの？"}, {"type": "subtitle", "time": 4169.349, "timestamp": "01:09:29", "text": "おい、これは何だ？何？どうしたの？"}, {"type": "subtitle", "time": 4185.269, "timestamp": "01:09:45", "text": "わかった。車。みんなはどこにいるの？"}, {"type": "subtitle", "time": 4187.43, "timestamp": "01:09:47", "text": "こんにちは。わかった。この後、私は"}, {"type": "subtitle", "time": 4191.03, "timestamp": "01:09:51", "text": "カードを捨てる。 H. それで、ゼノンを得られる"}, {"type": "subtitle", "time": 4192.269, "timestamp": "01:09:52", "text": "戻る。"}, {"type": "subtitle", "time": 4195.91, "timestamp": "01:09:55", "text": "はい。あ、待って。私は彼女を引き戻すことができます、"}, {"type": "subtitle", "time": 4198.149, "timestamp": "01:09:58", "text": "あなたが知っている。私は彼女を引き止めて引きずり出すことができる"}]
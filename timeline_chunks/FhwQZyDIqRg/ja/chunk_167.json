[{"type": "subtitle", "time": 10023.269, "timestamp": "02:47:03", "text": "大きい。すごく大きい。後ろに置いてください。置く"}, {"type": "subtitle", "time": 10026.71, "timestamp": "02:47:06", "text": "今すぐやろう。私の面倒を見てください。手に入れないで 手に入れないで"}, {"type": "subtitle", "time": 10030.07, "timestamp": "02:47:10", "text": "風邪をひく。私は弱くない。もちろんさ。"}, {"type": "subtitle", "time": 10033.19, "timestamp": "02:47:13", "text": "わーい。さあ行こう。ああ、ここは寒いですね。"}, {"type": "subtitle", "time": 10035.269, "timestamp": "02:47:15", "text": "涼しい夏を想像してみてよ、兄弟。"}, {"type": "subtitle", "time": 10037.51, "timestamp": "02:47:17", "text": "私じゃない。私はあなたの"}, {"type": "subtitle", "time": 10039.429, "timestamp": "02:47:19", "text": "免疫系。たとえそれが、"}, {"type": "subtitle", "time": 10040.469, "timestamp": "02:47:20", "text": "弱者のように、ということを知っている。私の免疫"}, {"type": "subtitle", "time": 10045.269, "timestamp": "02:47:25", "text": "システムは私のものより優れています"}, {"type": "subtitle", "time": 10047.03, "timestamp": "02:47:27", "text": "あなたの免疫システムは弱者です"}, {"type": "subtitle", "time": 10049.03, "timestamp": "02:47:29", "text": "この戦い。"}, {"type": "subtitle", "time": 10052.23, "timestamp": "02:47:32", "text": "お大事に。お大事に。神のお恵みがありますように。"}, {"type": "subtitle", "time": 10055.91, "timestamp": "02:47:35", "text": "すみません。すぐに祝福がありますように。私は持っている。"}, {"type": "subtitle", "time": 10057.83, "timestamp": "02:47:37", "text": "待って、この人は誰？ゼノさん、ありがとうございます。停止"}, {"type": "subtitle", "time": 10060.389, "timestamp": "02:47:40", "text": "歩く。持続する。私は歩きません。"}, {"type": "subtitle", "time": 10061.91, "timestamp": "02:47:41", "text": "ここに何かある。私にあなたを癒させてください。"}, {"type": "subtitle", "time": 10063.55, "timestamp": "02:47:43", "text": "ただ"}, {"type": "subtitle", "time": 10079.91, "timestamp": "02:47:59", "text": "私はこれが好きです。私はここまで登って、"}]
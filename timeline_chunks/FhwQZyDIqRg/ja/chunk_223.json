[{"type": "subtitle", "time": 13380.469, "timestamp": "03:43:00", "text": "それは別の何かで、ハトのようなものだった"}, {"type": "subtitle", "time": 13382.309, "timestamp": "03:43:02", "text": "そしてあなたはそれが白いカラスだと思うか、それとも"}, {"type": "subtitle", "time": 13385.269, "timestamp": "03:43:05", "text": "白いカラスは全く見かけなかったよ。」だから"}, {"type": "subtitle", "time": 13387.429, "timestamp": "03:43:07", "text": "私の言いたいこと、分かりますか？どちらも当てはまります。あなたのような"}, {"type": "subtitle", "time": 13390.15, "timestamp": "03:43:10", "text": "人々の話を聞いて、それから"}, {"type": "subtitle", "time": 13393.67, "timestamp": "03:43:13", "text": "調べてみて、それが本当かどうか確認してみて。"}, {"type": "subtitle", "time": 13396.389, "timestamp": "03:43:16", "text": "つまり、どちらの側面もあるということだ。これはとても"}, {"type": "subtitle", "time": 13398.309, "timestamp": "03:43:18", "text": "空欄の質問。だから私は行くよ"}, {"type": "subtitle", "time": 13400.71, "timestamp": "03:43:20", "text": "真ん中に。"}, {"type": "subtitle", "time": 13404.15, "timestamp": "03:43:24", "text": "うん。どちらもです。両方とも見たい。"}, {"type": "subtitle", "time": 13405.99, "timestamp": "03:43:25", "text": "うん。私は普段両方行きます。私は行かない"}, {"type": "subtitle", "time": 13408.71, "timestamp": "03:43:28", "text": "明らかに聞こえないだろう"}, {"type": "subtitle", "time": 13410.389, "timestamp": "03:43:30", "text": "人生に足を踏み入れると、当然"}, {"type": "subtitle", "time": 13413.349, "timestamp": "03:43:33", "text": "物語を聞くために。実際、たくさんあります。"}, {"type": "subtitle", "time": 13416.55, "timestamp": "03:43:36", "text": "はい。だから、ただ「私は私は」と言うだけではダメです"}, {"type": "subtitle", "time": 13419.03, "timestamp": "03:43:39", "text": "まるで機械ロボットになるみたいだ"}, {"type": "subtitle", "time": 13421.349, "timestamp": "03:43:41", "text": "それは感情を持たない。いいえ、できません"}, {"type": "subtitle", "time": 13423.91, "timestamp": "03:43:43", "text": "それ。あなたは聞かなければならない"}, {"type": "subtitle", "time": 13427.11, "timestamp": "03:43:47", "text": "物語もありますが、あなたも"}, {"type": "subtitle", "time": 13429.83, "timestamp": "03:43:49", "text": "事実とかそういう類のタブがいくつかある。"}, {"type": "subtitle", "time": 13432.63, "timestamp": "03:43:52", "text": "だから、「ああ、そうだ、君は"}, {"type": "subtitle", "time": 13435.51, "timestamp": "03:43:55", "text": "非常識な。\""}, {"type": "subtitle", "time": 13437.59, "timestamp": "03:43:57", "text": "私の言っていることが分かるよね？保管することができます"}, {"type": "subtitle", "time": 13439.67, "timestamp": "03:43:59", "text": "彼らには注意しておけ。あなたは"}]
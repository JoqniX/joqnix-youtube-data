[{"type": "subtitle", "time": 9449.11, "timestamp": "02:37:29", "text": "私は船長の戦争を思い出した。うん。"}, {"type": "subtitle", "time": 9451.19, "timestamp": "02:37:31", "text": "誰が朗読しているの？ 誰が朗読しているの？"}, {"type": "subtitle", "time": 9455.429, "timestamp": "02:37:35", "text": "聖書？あなたは何をしていますか？"}, {"type": "subtitle", "time": 9460.79, "timestamp": "02:37:40", "text": "わかった。この部屋には何もありません。いいえ。違います。"}, {"type": "subtitle", "time": 9463.19, "timestamp": "02:37:43", "text": "たぶん、あの部屋に入るんだろうね。ああ、そう"}, {"type": "subtitle", "time": 9464.59, "timestamp": "02:37:44", "text": "私たちは"}, {"type": "subtitle", "time": 9467.51, "timestamp": "02:37:47", "text": "実際に行ってみる。"}, {"type": "subtitle", "time": 9471.59, "timestamp": "02:37:51", "text": "何てことだ。ああ、しまった。みんな、試してみてもいい？"}, {"type": "subtitle", "time": 9475.51, "timestamp": "02:37:55", "text": "これ？みなさん、こんにちは。できますか でも私は"}, {"type": "subtitle", "time": 9477.99, "timestamp": "02:37:57", "text": "こんな感じですか？どうすれば誰でも"}]
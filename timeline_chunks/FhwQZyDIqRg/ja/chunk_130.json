[{"type": "subtitle", "time": 7800.47, "timestamp": "02:10:00", "text": "それを買うために。ああ、それで、どうすればいいですか？"}, {"type": "subtitle", "time": 7802.95, "timestamp": "02:10:02", "text": "それ？ここに置いておきました。ああ、健康のことじゃない"}, {"type": "subtitle", "time": 7805.669, "timestamp": "02:10:05", "text": "もの。実際、まず最初に、えっと、"}, {"type": "subtitle", "time": 7807.75, "timestamp": "02:10:07", "text": "やるべきことは、実際には必要ない"}, {"type": "subtitle", "time": 7809.51, "timestamp": "02:10:09", "text": "健康パックを購入するために、"}, {"type": "subtitle", "time": 7811.43, "timestamp": "02:10:11", "text": "不具合のことですよね？そうそう。だから、"}, {"type": "subtitle", "time": 7815.43, "timestamp": "02:10:15", "text": "ここに来て。わかった。"}, {"type": "subtitle", "time": 7838.47, "timestamp": "02:10:38", "text": "奇妙な。なんだか方向感覚を失っているような気がする"}, {"type": "subtitle", "time": 7840.31, "timestamp": "02:10:40", "text": "だって、何が起こっているのか"}, {"type": "subtitle", "time": 7841.99, "timestamp": "02:10:41", "text": "チャット。問題は、私には"}, {"type": "subtitle", "time": 7844.95, "timestamp": "02:10:44", "text": "現在対応可能なモデレーター。それで"}, {"type": "subtitle", "time": 7846.47, "timestamp": "02:10:46", "text": "集中するのが難しい"}]
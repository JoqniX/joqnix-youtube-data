[{"type": "subtitle", "time": 5102.31, "timestamp": "01:25:02", "text": "あいつはお前を殺そうとしている。ええ、"}, {"type": "subtitle", "time": 5106.55, "timestamp": "01:25:06", "text": "彼は叫んでいる。彼女は、あなたのためにいる。"}, {"type": "subtitle", "time": 5108.629, "timestamp": "01:25:08", "text": "お前は死んだ。"}, {"type": "subtitle", "time": 5113.36, "timestamp": "01:25:13", "text": "残念ながら、彼は亡くなってしまった。"}, {"type": "subtitle", "time": 5114.55, "timestamp": "01:25:14", "text": "[音楽]"}, {"type": "subtitle", "time": 5116.79, "timestamp": "01:25:16", "text": "ああ、くそ。"}, {"type": "subtitle", "time": 5119.27, "timestamp": "01:25:19", "text": "彼は彼女があなたの遺体を見たのを見た。なんてこった。なるほど"}, {"type": "subtitle", "time": 5127.149, "timestamp": "01:25:27", "text": "ああ、神様。"}, {"type": "subtitle", "time": 5130.31, "timestamp": "01:25:30", "text": "はい、今行きます。"}, {"type": "subtitle", "time": 5131.229, "timestamp": "01:25:31", "text": "全て"}, {"type": "subtitle", "time": 5135.03, "timestamp": "01:25:35", "text": "右。わかった。拾い上げてください。わかった。ええ、でも"}, {"type": "subtitle", "time": 5136.39, "timestamp": "01:25:36", "text": "私たちを蘇らせることはできない。あなたは持っていません"}, {"type": "subtitle", "time": 5138.31, "timestamp": "01:25:38", "text": "十分なお金。"}, {"type": "subtitle", "time": 5143.03, "timestamp": "01:25:43", "text": "いいえ、私はそう信じています。それで、"}, {"type": "subtitle", "time": 5145.43, "timestamp": "01:25:45", "text": "とにかく続けなさい。とにかく続けなさい。あなた"}, {"type": "subtitle", "time": 5154.79, "timestamp": "01:25:54", "text": "待って。何の価値もない。彼女は"}, {"type": "subtitle", "time": 5157.75, "timestamp": "01:25:57", "text": "入口はすぐ後ろにある"}]
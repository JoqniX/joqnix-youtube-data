[{"type": "subtitle", "time": 8641.349, "timestamp": "02:24:01", "text": "シーズンエピソードでも"}, {"type": "subtitle", "time": 8645.03, "timestamp": "02:24:05", "text": "彼が記憶に戻るとき"}, {"type": "subtitle", "time": 8647.67, "timestamp": "02:24:07", "text": "彼は実際にゴス・マサを一人見ています"}, {"type": "subtitle", "time": 8649.19, "timestamp": "02:24:09", "text": "友達、ああ、私はそれを見るつもりです"}, {"type": "subtitle", "time": 8650.87, "timestamp": "02:24:10", "text": "それを知った今、もう一度見に行くつもりだ"}, {"type": "subtitle", "time": 8653.349, "timestamp": "02:24:13", "text": "13の歌がある"}, {"type": "subtitle", "time": 8657.19, "timestamp": "02:24:17", "text": "ペダルと13体の巨人、それからおもちゃと"}, {"type": "subtitle", "time": 8658.87, "timestamp": "02:24:18", "text": "そして、最初に目にするもの"}, {"type": "subtitle", "time": 8661.429, "timestamp": "02:24:21", "text": "シーンは実際には馬で、"}, {"type": "subtitle", "time": 8662.87, "timestamp": "02:24:22", "text": "殺されるだろう。あれらは兵士だ。"}, {"type": "subtitle", "time": 8665.429, "timestamp": "02:24:25", "text": "待って、開けると猿がいる"}, {"type": "subtitle", "time": 8667.83, "timestamp": "02:24:27", "text": "猿。えっと、それは、えっと、"}, {"type": "subtitle", "time": 8671.59, "timestamp": "02:24:31", "text": "えーと、最後のシーズン。ああ、オープニングですね。"}, {"type": "subtitle", "time": 8673.67, "timestamp": "02:24:33", "text": "わかった。ええ、おそらく最初のか"}, {"type": "subtitle", "time": 8675.429, "timestamp": "02:24:35", "text": "シーズン2。調べてみます。それで、"}, {"type": "subtitle", "time": 8680.389, "timestamp": "02:24:40", "text": "えっと、ゴロゴロ音だったのか、それとも"}, {"type": "subtitle", "time": 8687.83, "timestamp": "02:24:47", "text": "いいえ、ゴロゴロ音ではありません。ローミングはしていません。えっと、そして"}, {"type": "subtitle", "time": 8690.309, "timestamp": "02:24:50", "text": "エリンに関する言及が非常に多かった"}, {"type": "subtitle", "time": 8692.07, "timestamp": "02:24:52", "text": "そしてジークはただ立って"}, {"type": "subtitle", "time": 8695.19, "timestamp": "02:24:55", "text": "背景。はい、そのクリップを見ました"}, {"type": "subtitle", "time": 8699.23, "timestamp": "02:24:59", "text": "エディン、そうだね。そして、そこにあったように"}]
[{"type": "subtitle", "time": 8221.99, "timestamp": "02:17:01", "text": "サムライチャンプルーのエンディングは、あなたが「はい」と答えた場合です。そして"}, {"type": "subtitle", "time": 8225.589, "timestamp": "02:17:05", "text": "私は、私は、あのオープニングが好きです。"}, {"type": "subtitle", "time": 8230.07, "timestamp": "02:17:10", "text": "スコット・ウム・ブボップ。ボップ。はい。オープニング"}, {"type": "subtitle", "time": 8232.549, "timestamp": "02:17:12", "text": "戦車の音楽ですよね？ああ、それは"}, {"type": "subtitle", "time": 8235.79, "timestamp": "02:17:15", "text": "その曲のタイトルは「タンク」です。私は本当に"}, {"type": "subtitle", "time": 8244.389, "timestamp": "02:17:24", "text": "ああ、本当に美味しかった。"}, {"type": "subtitle", "time": 8248.469, "timestamp": "02:17:28", "text": "そしてマーシャル シーズン2も。"}, {"type": "subtitle", "time": 8252.07, "timestamp": "02:17:32", "text": "ああ、本当に過小評価されているアニメだ。それは"}, {"type": "subtitle", "time": 8254.389, "timestamp": "02:17:34", "text": "とても流行っています。ああ、この歌が大好きだし、"}, {"type": "subtitle", "time": 8264.629, "timestamp": "02:17:44", "text": "[音楽]"}, {"type": "subtitle", "time": 8265.91, "timestamp": "02:17:45", "text": "常に"}, {"type": "subtitle", "time": 8268.95, "timestamp": "02:17:48", "text": "懐かしいのは、風から"}, {"type": "subtitle", "time": 8273.07, "timestamp": "02:17:53", "text": "ナルト。いつも。いつも。青。"}]
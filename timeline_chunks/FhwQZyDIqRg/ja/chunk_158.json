[{"type": "subtitle", "time": 9480.309, "timestamp": "02:38:00", "text": "うん、感じの良い人だね。ここだ。しないで"}, {"type": "subtitle", "time": 9482.23, "timestamp": "02:38:02", "text": "入って。うん、君はインセクトみたいだったよ"}, {"type": "subtitle", "time": 9484.52, "timestamp": "02:38:04", "text": "そこには。"}, {"type": "subtitle", "time": 9486.23, "timestamp": "02:38:06", "text": "[音楽]"}, {"type": "subtitle", "time": 9491.91, "timestamp": "02:38:11", "text": "こんにちは、ジョン。こんにちは。"}, {"type": "subtitle", "time": 9503.67, "timestamp": "02:38:23", "text": "[音楽]"}, {"type": "subtitle", "time": 9506.63, "timestamp": "02:38:26", "text": "これはどこにあるのですか？どこでその情報を入手しましたか？"}, {"type": "subtitle", "time": 9508.55, "timestamp": "02:38:28", "text": "これは一体何だ？なぜ私たちは聞いているのか"}, {"type": "subtitle", "time": 9510.71, "timestamp": "02:38:30", "text": "これらすべて？私は何者？ あなたは何者？"}, {"type": "subtitle", "time": 9513.91, "timestamp": "02:38:33", "text": "聴いている？屋根。それは"}, {"type": "subtitle", "time": 9517.11, "timestamp": "02:38:37", "text": "銃声か何か。"}, {"type": "subtitle", "time": 9519.03, "timestamp": "02:38:39", "text": "何てことだ。聞こえましたか？私 私"}, {"type": "subtitle", "time": 9522.15, "timestamp": "02:38:42", "text": "走るべきではなかった。"}, {"type": "subtitle", "time": 9524.469, "timestamp": "02:38:44", "text": "彼らはそれを聞いたのだろうか？あの男は"}, {"type": "subtitle", "time": 9528.389, "timestamp": "02:38:48", "text": "いないいないばあ、ドーン。ピーカオブーム。そして私は"}, {"type": "subtitle", "time": 9530.309, "timestamp": "02:38:50", "text": "あの男は盲目だと思って、"}, {"type": "subtitle", "time": 9533.03, "timestamp": "02:38:53", "text": "音。彼はナツキを完全に無視した"}, {"type": "subtitle", "time": 9535.03, "timestamp": "02:38:55", "text": "しかし、彼もまた身を隠していたのだ。うん、"}, {"type": "subtitle", "time": 9536.95, "timestamp": "02:38:56", "text": "大丈夫。"}]
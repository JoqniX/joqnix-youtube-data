[{"type": "subtitle", "time": 8943.67, "timestamp": "02:29:03", "text": "そうすべきだ。話してみよう"}, {"type": "subtitle", "time": 8945.11, "timestamp": "02:29:05", "text": "うん。誰か見た人いますか？"}, {"type": "subtitle", "time": 8950.07, "timestamp": "02:29:10", "text": "異星人のステージ？はい。はい。そして私は"}, {"type": "subtitle", "time": 8951.75, "timestamp": "02:29:11", "text": "もう少しで鬱になるところだった。とても気に入ったので"}, {"type": "subtitle", "time": 8954.87, "timestamp": "02:29:14", "text": "多くの。最新作は見ていません"}, {"type": "subtitle", "time": 8957.27, "timestamp": "02:29:17", "text": "ビデオなので何が起こっているのかわかりません"}, {"type": "subtitle", "time": 8961.51, "timestamp": "02:29:21", "text": "でも、それについてのクリップを見たんだけど、すごいね"}, {"type": "subtitle", "time": 8963.51, "timestamp": "02:29:23", "text": "私はそうだったと分かっていますが、私はそのクリップを見ました"}, {"type": "subtitle", "time": 8965.11, "timestamp": "02:29:25", "text": "見る前は「やめて」って思ってた"}, {"type": "subtitle", "time": 8968.95, "timestamp": "02:29:28", "text": "熱が全て台無しになった、それが全てだった"}, {"type": "subtitle", "time": 8970.67, "timestamp": "02:29:30", "text": "それを乗り越えて、ほら、"}, {"type": "subtitle", "time": 8975.349, "timestamp": "02:29:35", "text": "2023年のJJKフェーズはどうなるの？"}, {"type": "subtitle", "time": 8977.99, "timestamp": "02:29:37", "text": "ああ、私はとても甘やかされてきた"}, {"type": "subtitle", "time": 8979.79, "timestamp": "02:29:39", "text": "JJK"}, {"type": "subtitle", "time": 8982.309, "timestamp": "02:29:42", "text": "フェーズフェーズとそれらすべて"}, {"type": "subtitle", "time": 8983.75, "timestamp": "02:29:43", "text": "すべての理論で起こる"}, {"type": "subtitle", "time": 8986.71, "timestamp": "02:29:46", "text": "置物。 「ああ、なんてことだ」って感じだった。いいえ、しかし"}, {"type": "subtitle", "time": 8988.55, "timestamp": "02:29:48", "text": "あのね？もし私が何をすべきかわからないなら"}, {"type": "subtitle", "time": 8990.55, "timestamp": "02:29:50", "text": "あなたがそれについて尋ねるときのあなたの視点は"}, {"type": "subtitle", "time": 8994.469, "timestamp": "02:29:54", "text": "自分。えっと、私は彼らを責めるつもりはない"}, {"type": "subtitle", "time": 8997.27, "timestamp": "02:29:57", "text": "女性と、そしてその理由は？なぜなら、私は"}, {"type": "subtitle", "time": 8999.11, "timestamp": "02:29:59", "text": "これら全てを全く違った視点から見てみましょう"}]
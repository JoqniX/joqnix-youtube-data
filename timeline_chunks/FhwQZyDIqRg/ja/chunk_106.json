[{"type": "subtitle", "time": 6360.55, "timestamp": "01:46:00", "text": "これで終わりだと思うよ、みんな。抽出"}, {"type": "subtitle", "time": 6364.709, "timestamp": "01:46:04", "text": "ポイント。ああ、それだ。"}, {"type": "subtitle", "time": 6367.75, "timestamp": "01:46:07", "text": "近日公開。誰か、ああ、"}, {"type": "subtitle", "time": 6370.629, "timestamp": "01:46:10", "text": "注意深い。うん、うん、うん。"}, {"type": "subtitle", "time": 6372.629, "timestamp": "01:46:12", "text": "わからない。また、私は支払っていませんでした"}, {"type": "subtitle", "time": 6374.07, "timestamp": "01:46:14", "text": "注意。罵り言葉を使うことは許されていますか、"}, {"type": "subtitle", "time": 6376.629, "timestamp": "01:46:16", "text": "ない？ああ、そう言ってもいいですよ"}, {"type": "subtitle", "time": 6378.07, "timestamp": "01:46:18", "text": "お母さんが選んだのよ、あなたが望むなら。うん。うん。"}, {"type": "subtitle", "time": 6380.229, "timestamp": "01:46:20", "text": "はい、できますよ。大丈夫です。しかし、"}, {"type": "subtitle", "time": 6390.39, "timestamp": "01:46:30", "text": "ああ、くそ。わかった。わかった。わかった。私"}, {"type": "subtitle", "time": 6392.07, "timestamp": "01:46:32", "text": "わかった。わかった。わかった。わかった。私たちは"}, {"type": "subtitle", "time": 6393.99, "timestamp": "01:46:33", "text": "わかった。ああ、くそ。よし。大丈夫。"}, {"type": "subtitle", "time": 6396.07, "timestamp": "01:46:36", "text": "大丈夫。もう少しだけ。たくさん。"}, {"type": "subtitle", "time": 6398.47, "timestamp": "01:46:38", "text": "それでも、かなりの価値がある。うん。ああ、それは"}, {"type": "subtitle", "time": 6400.39, "timestamp": "01:46:40", "text": "ここです。ここに来て。ここにあります。"}, {"type": "subtitle", "time": 6402.31, "timestamp": "01:46:42", "text": "そのまままっすぐ進んでください。それだけです。"}, {"type": "subtitle", "time": 6405.27, "timestamp": "01:46:45", "text": "それだけです。アヒルを殺すことができます"}, {"type": "subtitle", "time": 6410.149, "timestamp": "01:46:50", "text": "緑色の薬。ああ、なるほど。おお、いいね。"}, {"type": "subtitle", "time": 6412.229, "timestamp": "01:46:52", "text": "私はあの音の模倣が本当に大好きなんです。"}, {"type": "subtitle", "time": 6418.07, "timestamp": "01:46:58", "text": "なぜ人々が私に尋ねるのか理解できません"}]
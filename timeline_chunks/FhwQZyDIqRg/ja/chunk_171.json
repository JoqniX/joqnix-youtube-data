[{"type": "subtitle", "time": 10261.11, "timestamp": "02:51:01", "text": "エクスプレス便を買ってきてくれませんか？いえ、結構です。うん。"}, {"type": "subtitle", "time": 10262.389, "timestamp": "02:51:02", "text": "いえ、結構です。私は実際に"}, {"type": "subtitle", "time": 10264.23, "timestamp": "02:51:04", "text": "やってみて。私は実際にやろうと思っていた"}, {"type": "subtitle", "time": 10266.389, "timestamp": "02:51:06", "text": "それ。体力がついてきた。素晴らしい。私は"}, {"type": "subtitle", "time": 10268.71, "timestamp": "02:51:08", "text": "二度目に言う。これは私のものです。"}, {"type": "subtitle", "time": 10271.269, "timestamp": "02:51:11", "text": "わかった。スタミナ強化。もう一つあります"}, {"type": "subtitle", "time": 10273.269, "timestamp": "02:51:13", "text": "スタミナ。みんな、これって何？これらは"}, {"type": "subtitle", "time": 10275.51, "timestamp": "02:51:15", "text": "キャンドル？スピンスプレーを手に入れました。何てことだ。"}, {"type": "subtitle", "time": 10277.03, "timestamp": "02:51:17", "text": "これらはろうそくです。これらは何ですか"}, {"type": "subtitle", "time": 10284.07, "timestamp": "02:51:24", "text": "右。ナティ。健康のために行動しましょう。"}, {"type": "subtitle", "time": 10285.59, "timestamp": "02:51:25", "text": "低設定。だから、それらはただ"}, {"type": "subtitle", "time": 10287.07, "timestamp": "02:51:27", "text": "私にとって鉛筆。のように"}, {"type": "subtitle", "time": 10289.75, "timestamp": "02:51:29", "text": "圧倒的なリード。つまり、彼らは基本的に"}, {"type": "subtitle", "time": 10290.87, "timestamp": "02:51:30", "text": "まるで彼らが持っているかのように、彼らはまるで"}, {"type": "subtitle", "time": 10293.51, "timestamp": "02:51:33", "text": "ろうそく。やってみます。だから、ただ手に入れるだけ"}, {"type": "subtitle", "time": 10298.07, "timestamp": "02:51:38", "text": "準備ができて。準備してください。準備してください。何のために？"}, {"type": "subtitle", "time": 10301.03, "timestamp": "02:51:41", "text": "生きるために。生きるために。"}, {"type": "subtitle", "time": 10303.91, "timestamp": "02:51:43", "text": "さあ、入って。みんな、入って。 HP。 HPを取ってください。"}, {"type": "subtitle", "time": 10306.55, "timestamp": "02:51:46", "text": "HPを取ってください。必要とする人なら誰でも。どこ"}, {"type": "subtitle", "time": 10309.75, "timestamp": "02:51:49", "text": "それ？必要とする人なら誰でも。わかった。何をすればいいですか"}, {"type": "subtitle", "time": 10312.63, "timestamp": "02:51:52", "text": "する？えっと、必要ですか？ 1つ取ることができます"}, {"type": "subtitle", "time": 10316.15, "timestamp": "02:51:56", "text": "もっと。あなたがそれを持つ。ちょうど"}, {"type": "subtitle", "time": 10317.349, "timestamp": "02:51:57", "text": "そのまま持ち続けてください。必ずそうしないようにしてください"}, {"type": "subtitle", "time": 10318.95, "timestamp": "02:51:58", "text": "左クリックを押して、指を離してください。確認する"}]
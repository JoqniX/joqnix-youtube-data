[{"type": "subtitle", "time": 11701.91, "timestamp": "03:15:01", "text": "良い。"}, {"type": "subtitle", "time": 11706.99, "timestamp": "03:15:06", "text": "20試合で十分です。私は"}, {"type": "subtitle", "time": 11709.59, "timestamp": "03:15:09", "text": "おそらくそうでしょう。唯一のゲームだと思います。"}, {"type": "subtitle", "time": 11711.79, "timestamp": "03:15:11", "text": "私が購入した"}, {"type": "subtitle", "time": 11722.389, "timestamp": "03:15:22", "text": "うんうん。ああ、ファスモはお持ちですか？"}, {"type": "subtitle", "time": 11730.15, "timestamp": "03:15:30", "text": "アンインストールしたと思います。待って。神、"}, {"type": "subtitle", "time": 11732.269, "timestamp": "03:15:32", "text": "ジャック、君"}, {"type": "subtitle", "time": 11734.67, "timestamp": "03:15:34", "text": "持っていた"}, {"type": "subtitle", "time": 11740.11, "timestamp": "03:15:40", "text": "私"}, {"type": "subtitle", "time": 11743.429, "timestamp": "03:15:43", "text": "いつも手を振る。あなたはそれら全てを持っていた"}, {"type": "subtitle", "time": 11745.95, "timestamp": "03:15:45", "text": "ちなみに、何年も前からそうなんです。から"}, {"type": "subtitle", "time": 11748.309, "timestamp": "03:15:48", "text": "始まり。ただ持っているだけではダメです"}, {"type": "subtitle", "time": 11749.309, "timestamp": "03:15:49", "text": "持っている"}, {"type": "subtitle", "time": 11751.55, "timestamp": "03:15:51", "text": "私のファスモ"}, {"type": "subtitle", "time": 11755.11, "timestamp": "03:15:55", "text": "オンも同様です。本当に？私は喘息持ちです。私はただ"}, {"type": "subtitle", "time": 11758.389, "timestamp": "03:15:58", "text": "確認済み。インストールされたようです。"}]
[{"type": "subtitle", "time": 13080.59, "timestamp": "03:38:00", "text": "強迫観念にとらわれている。私は"}, {"type": "subtitle", "time": 13090.95, "timestamp": "03:38:10", "text": "これは一体どこに落ち着くのだろうか？反対ですか？"}, {"type": "subtitle", "time": 13092.469, "timestamp": "03:38:12", "text": "主張か、同意か？私は与えるつもりです"}, {"type": "subtitle", "time": 13095.19, "timestamp": "03:38:15", "text": "それは同意です。当然のことながら私は"}, {"type": "subtitle", "time": 13098.87, "timestamp": "03:38:18", "text": "清潔だが、潔癖症ではない。"}, {"type": "subtitle", "time": 13100.71, "timestamp": "03:38:20", "text": "H"}, {"type": "subtitle", "time": 13105.429, "timestamp": "03:38:25", "text": "ジャック。はい。ジャック。はい。"}, {"type": "subtitle", "time": 13107.19, "timestamp": "03:38:27", "text": "わかった。"}, {"type": "subtitle", "time": 13109.19, "timestamp": "03:38:29", "text": "君は私がディスコを考えていると思っていた"}, {"type": "subtitle", "time": 13111.91, "timestamp": "03:38:31", "text": "また死んだ。それはあなたの声を遮断します"}, {"type": "subtitle", "time": 13114.15, "timestamp": "03:38:34", "text": "たくさん。"}, {"type": "subtitle", "time": 13117.11, "timestamp": "03:38:37", "text": "ああ、そうだよ。ごめんなさい。申し訳ありませんが"}, {"type": "subtitle", "time": 13119.87, "timestamp": "03:38:39", "text": "あなた。あなたは通常滞在します"}, {"type": "subtitle", "time": 13122.03, "timestamp": "03:38:42", "text": "落ち着いた。"}, {"type": "subtitle", "time": 13126.349, "timestamp": "03:38:46", "text": "喜び。わからない。"}, {"type": "subtitle", "time": 13135.03, "timestamp": "03:38:55", "text": "もたつく。私は好きではありません。私は完全が好きではありません。私"}]
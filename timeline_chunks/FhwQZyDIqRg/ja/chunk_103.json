[{"type": "subtitle", "time": 6180.39, "timestamp": "01:43:00", "text": "ポイント。はい、これでいいでしょう。"}, {"type": "subtitle", "time": 6183.03, "timestamp": "01:43:03", "text": "こいつを殺しに行かせてくれ。もうどうでもいい。おお"}, {"type": "subtitle", "time": 6184.47, "timestamp": "01:43:04", "text": "いいえ。助けて。助けて。これは"}, {"type": "subtitle", "time": 6187.109, "timestamp": "01:43:07", "text": "私をじっと見つめている。ああ、くそったれ。ありがとう。"}, {"type": "subtitle", "time": 6189.75, "timestamp": "01:43:09", "text": "ああ、あのクソガキめ。"}, {"type": "subtitle", "time": 6191.669, "timestamp": "01:43:11", "text": "こうやって開けるから"}, {"type": "subtitle", "time": 6202.39, "timestamp": "01:43:22", "text": "トラック復活。復活はしていない。何？"}, {"type": "subtitle", "time": 6205.03, "timestamp": "01:43:25", "text": "ああ、なんてことだ、蘇生しない。はい、私は"}, {"type": "subtitle", "time": 6212.35, "timestamp": "01:43:32", "text": "待って、もし私があなたを"}, {"type": "subtitle", "time": 6218.27, "timestamp": "01:43:38", "text": "HP？"}, {"type": "subtitle", "time": 6227.27, "timestamp": "01:43:47", "text": "そうではない。ああ、もう"}, {"type": "subtitle", "time": 6228.51, "timestamp": "01:43:48", "text": "[音楽]"}, {"type": "subtitle", "time": 6231.99, "timestamp": "01:43:51", "text": "知る。ああ、気にしないで。"}, {"type": "subtitle", "time": 6234.39, "timestamp": "01:43:54", "text": "何をやらかしたんだ？いいえ、違います"}, {"type": "subtitle", "time": 6236.39, "timestamp": "01:43:56", "text": "働く。"}, {"type": "subtitle", "time": 6238.47, "timestamp": "01:43:58", "text": "これは何ですか？ああ、そこには"}]
[{"type": "subtitle", "time": 11314.59, "timestamp": "03:08:34", "text": "とにかく、これはとても"}, {"type": "subtitle", "time": 11320.07, "timestamp": "03:08:40", "text": "なんて馬鹿げた馬鹿げた馬鹿げた。戻ってきました。"}, {"type": "subtitle", "time": 11324.15, "timestamp": "03:08:44", "text": "ああ、大変だ。ようこそ、ジャックさん。"}, {"type": "subtitle", "time": 11326.55, "timestamp": "03:08:46", "text": "驚かせてしまったかな？"}, {"type": "subtitle", "time": 11330.23, "timestamp": "03:08:50", "text": "はい。とても不気味なジャック。"}, {"type": "subtitle", "time": 11339.269, "timestamp": "03:08:59", "text": "ええ、私は"}]
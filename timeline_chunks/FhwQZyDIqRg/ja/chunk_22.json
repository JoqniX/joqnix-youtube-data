[{"type": "subtitle", "time": 1321.27, "timestamp": "00:22:01", "text": "ストリームなどに実装するために"}, {"type": "subtitle", "time": 1323.63, "timestamp": "00:22:03", "text": "とても大変だった。"}, {"type": "subtitle", "time": 1327.43, "timestamp": "00:22:07", "text": "でもでもでもでも"}, {"type": "subtitle", "time": 1330.39, "timestamp": "00:22:10", "text": "えっと、あなたの愛のすべて"}, {"type": "subtitle", "time": 1333.47, "timestamp": "00:22:13", "text": "ディスコードマイナーから"}, {"type": "subtitle", "time": 1336.23, "timestamp": "00:22:16", "text": "ディスコードが私にヘッドパッチをくれ"}, {"type": "subtitle", "time": 1338.71, "timestamp": "00:22:18", "text": "お互いに、みんなに会うのが好き"}, {"type": "subtitle", "time": 1340.83, "timestamp": "00:22:20", "text": "実際に"}, {"type": "subtitle", "time": 1343.47, "timestamp": "00:22:23", "text": "本当に本当に"}, {"type": "subtitle", "time": 1347.51, "timestamp": "00:22:27", "text": "心がとろけそうになった。そしてその日"}, {"type": "subtitle", "time": 1353.27, "timestamp": "00:22:33", "text": "ズチが「えーっと、えーっと」と送ったとき、彼女は送った。"}, {"type": "subtitle", "time": 1357.909, "timestamp": "00:22:37", "text": "デザイン、スケッチ、線画"}, {"type": "subtitle", "time": 1359.87, "timestamp": "00:22:39", "text": "線画。おい"}, {"type": "subtitle", "time": 1362.23, "timestamp": "00:22:42", "text": "実際に椅子から落ちて"}, {"type": "subtitle", "time": 1363.07, "timestamp": "00:22:43", "text": "開始"}, {"type": "subtitle", "time": 1369.909, "timestamp": "00:22:49", "text": "私には耐えられないほどだったから、たくさん。"}, {"type": "subtitle", "time": 1379.909, "timestamp": "00:22:59", "text": "ああ、彼女が実際に好きなとき"}]
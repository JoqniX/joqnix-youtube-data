[{"type": "subtitle", "time": 13020.75, "timestamp": "03:37:00", "text": "許可する"}, {"type": "subtitle", "time": 13023.55, "timestamp": "03:37:03", "text": "一人だから、そうだね"}, {"type": "subtitle", "time": 13027.0, "timestamp": "03:37:07", "text": "同意できない、あなたは通常もっと感じる"}, {"type": "subtitle", "time": 13028.55, "timestamp": "03:37:08", "text": "[音楽]"}, {"type": "subtitle", "time": 13041.79, "timestamp": "03:37:21", "text": "もっと私は"}, {"type": "subtitle", "time": 13048.99, "timestamp": "03:37:28", "text": "あなたへ"}, {"type": "subtitle", "time": 13059.67, "timestamp": "03:37:39", "text": "わかった。問題は、私は私はしないということです"}, {"type": "subtitle", "time": 13061.71, "timestamp": "03:37:41", "text": "掃除するのが好きではない"}, {"type": "subtitle", "time": 13066.51, "timestamp": "03:37:46", "text": "強迫的にでも、ええと、私はそれを保持します"}, {"type": "subtitle", "time": 13071.71, "timestamp": "03:37:51", "text": "きれいだけど、いつか手放すつもりだ。私"}, {"type": "subtitle", "time": 13074.67, "timestamp": "03:37:54", "text": "ウィル・フリーキング"}, {"type": "subtitle", "time": 13078.11, "timestamp": "03:37:58", "text": "汚い。だから私は"}]
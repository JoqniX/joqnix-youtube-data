[{"type": "subtitle", "time": 4500.149, "timestamp": "01:15:00", "text": "なんてこった。うん。ちょっと待って、みんな。私は"}, {"type": "subtitle", "time": 4502.79, "timestamp": "01:15:02", "text": "私が誰かをそこに送り込んだんです。私はそうしました"}, {"type": "subtitle", "time": 4504.47, "timestamp": "01:15:04", "text": "誰かをそこに立たせろ。私でした。そうだった"}, {"type": "subtitle", "time": 4506.31, "timestamp": "01:15:06", "text": "自分。やってみろ。あなただったんですね。見つかりましたか？"}, {"type": "subtitle", "time": 4508.149, "timestamp": "01:15:08", "text": "何でも？あなたはしたい あなたは行き​​たい"}, {"type": "subtitle", "time": 4510.95, "timestamp": "01:15:10", "text": "以上？わかった。"}, {"type": "subtitle", "time": 4517.189, "timestamp": "01:15:17", "text": "さあ、行こう。来て。来て。ここに来て。"}, {"type": "subtitle", "time": 4519.27, "timestamp": "01:15:19", "text": "ここに来てやってみて。私はまたやるよ。"}, {"type": "subtitle", "time": 4521.189, "timestamp": "01:15:21", "text": "私もあなたに同じことをしてやる。ここに来て。おお、"}, {"type": "subtitle", "time": 4523.43, "timestamp": "01:15:23", "text": "わかった。わかった。今はもう何も残っていない。"}, {"type": "subtitle", "time": 4525.99, "timestamp": "01:15:25", "text": "わかった。よし、手榴弾両方手に入れたぞ。いいえ、"}, {"type": "subtitle", "time": 4530.87, "timestamp": "01:15:30", "text": "私はただ「うん」って感じが欲しいだけ。うん。ああ、やったー。"}, {"type": "subtitle", "time": 4533.59, "timestamp": "01:15:33", "text": "もう彼を放っておこうよ、みんな。私は"}, {"type": "subtitle", "time": 4535.35, "timestamp": "01:15:35", "text": "全て売るつもりだ。ああ、神様。みんな、"}, {"type": "subtitle", "time": 4536.55, "timestamp": "01:15:36", "text": "みんな、みんな。私は行くつもりです 私は行くつもりです"}, {"type": "subtitle", "time": 4538.709, "timestamp": "01:15:38", "text": "ここにあるもの全てを持って行けば、"}, {"type": "subtitle", "time": 4541.35, "timestamp": "01:15:41", "text": "次のパッチ。だから、例えば1つある"}, {"type": "subtitle", "time": 4543.99, "timestamp": "01:15:43", "text": "私にとってはスタミナ強化ですね。 1つは私のもの、1つは"}, {"type": "subtitle", "time": 4546.47, "timestamp": "01:15:46", "text": "木箱、ソジャス用のユニット1つ、そして1つ"}, {"type": "chat", "time": 4547.307, "timestamp": "01:15:47", "author": "@Back2005", "avatar": "https://yt4.ggpht.com/TUs_4eRxRjlVzlXUYnX60TXdeAhcF6DoQ2WfJraVpgcKoWcXvMAWUx0pU_9A7UkQz99bCYkx5w=s64-c-k-c0x00ffffff-no-rj", "message": "how a you"}, {"type": "subtitle", "time": 4548.79, "timestamp": "01:15:48", "text": "スジャスのスタミナ強化。そしてそれは"}, {"type": "chat", "time": 4550.311, "timestamp": "01:15:50", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Greetings Konzteller! Back~🌟 Welcome to the Guild! Make sure to read the Guildmate Guidelines in the description below before chatting further. Enjoy your stay!"}, {"type": "chat", "time": 4553.485, "timestamp": "01:15:53", "author": "@Back2005", "avatar": "https://yt4.ggpht.com/TUs_4eRxRjlVzlXUYnX60TXdeAhcF6DoQ2WfJraVpgcKoWcXvMAWUx0pU_9A7UkQz99bCYkx5w=s64-c-k-c0x00ffffff-no-rj", "message": "fine thank you"}, {"type": "subtitle", "time": 4554.95, "timestamp": "01:15:54", "text": "私の余分なものは私のものです。私の私。わかった。わかった。"}, {"type": "subtitle", "time": 4558.149, "timestamp": "01:15:58", "text": "わかった。わかった。さあ行こう。兄は"}]
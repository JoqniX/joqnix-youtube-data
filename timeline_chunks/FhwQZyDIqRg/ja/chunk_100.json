[{"type": "subtitle", "time": 6000.149, "timestamp": "01:40:00", "text": "つまり、よし、これを置こう"}, {"type": "subtitle", "time": 6002.07, "timestamp": "01:40:02", "text": "ここ。みんなでここで全てを分け合った"}, {"type": "subtitle", "time": 6004.47, "timestamp": "01:40:04", "text": "そうすれば私たちが来るのがもっと簡単になる"}, {"type": "subtitle", "time": 6015.99, "timestamp": "01:40:15", "text": "[音楽]"}, {"type": "subtitle", "time": 6018.709, "timestamp": "01:40:18", "text": "あなたはそれを見ていない"}, {"type": "subtitle", "time": 6029.99, "timestamp": "01:40:29", "text": "何かをする。誰か助けてくれませんか？えっと"}, {"type": "subtitle", "time": 6032.229, "timestamp": "01:40:32", "text": "はい。"}, {"type": "subtitle", "time": 6033.79, "timestamp": "01:40:33", "text": "わかった。"}, {"type": "subtitle", "time": 6042.39, "timestamp": "01:40:42", "text": "入っていますか？いいえ、入っていません。見せてください。"}, {"type": "subtitle", "time": 6044.47, "timestamp": "01:40:44", "text": "ズームで私を見てください。うん。待って、待って、待って。私にさせて"}, {"type": "subtitle", "time": 6046.669, "timestamp": "01:40:46", "text": "お手伝いします。"}, {"type": "subtitle", "time": 6049.51, "timestamp": "01:40:49", "text": "わかった。もう少しだけ。うん。うん。"}, {"type": "subtitle", "time": 6051.189, "timestamp": "01:40:51", "text": "そのままにしておいて。そのままにしておいて。そのままにしておいて。わかった。"}, {"type": "subtitle", "time": 6053.83, "timestamp": "01:40:53", "text": "わかった。みんな、みんな、もし君がもし君がもし君が"}, {"type": "subtitle", "time": 6057.189, "timestamp": "01:40:57", "text": "乗れば、追加のHPが手に入ります。あなたは"}]
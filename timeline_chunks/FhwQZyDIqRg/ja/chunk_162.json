[{"type": "subtitle", "time": 9720.07, "timestamp": "02:42:00", "text": "おお。"}, {"type": "subtitle", "time": 9722.309, "timestamp": "02:42:02", "text": "いいえ。いいえ。あなたも、もしあなたの"}, {"type": "subtitle", "time": 9724.27, "timestamp": "02:42:04", "text": "健康は100ではありません。"}, {"type": "subtitle", "time": 9727.429, "timestamp": "02:42:07", "text": "私の健康状態は100です。ああ、それなら"}, {"type": "subtitle", "time": 9729.349, "timestamp": "02:42:09", "text": "大丈夫。大丈夫。それはいいです。ああ、それは"}, {"type": "subtitle", "time": 9732.59, "timestamp": "02:42:12", "text": "いいですよね？うん。うん。"}, {"type": "subtitle", "time": 9735.11, "timestamp": "02:42:15", "text": "わかった。私はこの場所が大好きです。これ大好き"}, {"type": "subtitle", "time": 9737.429, "timestamp": "02:42:17", "text": "場所。"}, {"type": "subtitle", "time": 9739.51, "timestamp": "02:42:19", "text": "わかったよ。"}, {"type": "subtitle", "time": 9743.19, "timestamp": "02:42:23", "text": "待って、これって使えるの？それなら構いません。"}, {"type": "subtitle", "time": 9745.67, "timestamp": "02:42:25", "text": "冗談だよ。城を築く。思うに"}, {"type": "subtitle", "time": 9747.349, "timestamp": "02:42:27", "text": "作品。入って。入って。入って。入って。"}, {"type": "subtitle", "time": 9753.429, "timestamp": "02:42:33", "text": "わかった。これをするべきでしょうか？全員参加？"}, {"type": "subtitle", "time": 9754.95, "timestamp": "02:42:34", "text": "はい。君たちは私にスパムを送ってくるね。参加しました。スパム"}, {"type": "subtitle", "time": 9758.469, "timestamp": "02:42:38", "text": "自分。スパムを送ってください。"}, {"type": "subtitle", "time": 9761.349, "timestamp": "02:42:41", "text": "スパム行為を始めよう。これで終わりです。"}, {"type": "subtitle", "time": 9771.19, "timestamp": "02:42:51", "text": "わーい！フルHP。これはどうでしょう？これですか"}, {"type": "subtitle", "time": 9773.67, "timestamp": "02:42:53", "text": "ああ、そのうちの1つは私のものだ。の 1 つ"}, {"type": "subtitle", "time": 9776.469, "timestamp": "02:42:56", "text": "それらは私のものだ。いや、いや、いや、いや、いや。私"}, {"type": "subtitle", "time": 9779.27, "timestamp": "02:42:59", "text": "買いました。自分で買いました。"}]
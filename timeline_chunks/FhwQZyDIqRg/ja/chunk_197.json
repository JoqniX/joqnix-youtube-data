[{"type": "subtitle", "time": 11820.07, "timestamp": "03:17:00", "text": "呪われよ。あなたは間違ったことを尋ねています 私たちは"}, {"type": "subtitle", "time": 11823.269, "timestamp": "03:17:03", "text": "機会主義者たち。何かアドバイスはありますか？"}, {"type": "subtitle", "time": 11827.75, "timestamp": "03:17:07", "text": "私たちのために？大変ありがたいです。"}, {"type": "subtitle", "time": 11831.349, "timestamp": "03:17:11", "text": "ああ、Vチューブを試してみてはどうでしょう。見る"}, {"type": "chat", "time": 11832.51, "timestamp": "03:17:12", "author": "@XenoMatter_wcp", "avatar": "https://yt4.ggpht.com/1Ck2c6hVCCjwz4NAuHHsqo4rkihiYxNZyilgx1gAZXifcIcHF00zkDB1oc6O8NF2hkWoHbgV=s64-c-k-c0x00ffffff-no-rj", "message": "Heyyy wassss so much fun !!!!!! Thank you and we gotta do this again !!!!! "}, {"type": "subtitle", "time": 11834.71, "timestamp": "03:17:14", "text": "もしそれがあなたのやりたいことなら。試してみる"}, {"type": "chat", "time": 11835.305, "timestamp": "03:17:15", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Greetings Konzteller! Xeno Matter - Waconne Vtuber~🌟 Welcome to the Guild! Make sure to read the Guildmate Guidelines in the description below before chatting further. Enjoy your stay!"}, {"type": "subtitle", "time": 11837.11, "timestamp": "03:17:17", "text": "カスタムモデルをお持ちでない場合は、"}, {"type": "subtitle", "time": 11839.349, "timestamp": "03:17:19", "text": "無料モデルを試してみて、"}, {"type": "subtitle", "time": 11841.67, "timestamp": "03:17:21", "text": "あなたに合った方法を見つけます。あなたは"}, {"type": "subtitle", "time": 11843.63, "timestamp": "03:17:23", "text": "ストリーム？楽しんでいますか"}, {"type": "subtitle", "time": 11847.83, "timestamp": "03:17:27", "text": "チューブ？それらすべてを見てから、"}, {"type": "subtitle", "time": 11851.91, "timestamp": "03:17:31", "text": "それ。ファッションの旅を楽しんでください。しかし、"}, {"type": "subtitle", "time": 11854.15, "timestamp": "03:17:34", "text": "その方法で、お金を使わずに"}, {"type": "subtitle", "time": 11856.87, "timestamp": "03:17:36", "text": "始まり。一切お金を使わないでください。いいえ、"}, {"type": "subtitle", "time": 11859.429, "timestamp": "03:17:39", "text": "ストリーミングに1セントでも費やすか、"}, {"type": "subtitle", "time": 11861.99, "timestamp": "03:17:41", "text": "YouTubeでモデルを検索してみてください。いや、いや。そして"}, {"type": "subtitle", "time": 11863.67, "timestamp": "03:17:43", "text": "装備も同様です。無料でお試しください"}, {"type": "subtitle", "time": 11866.55, "timestamp": "03:17:46", "text": "1つ。無料のものを試してみて、"}, {"type": "subtitle", "time": 11871.59, "timestamp": "03:17:51", "text": "YouTubeが好きなら、投資してみましょう。うん。"}, {"type": "subtitle", "time": 11875.11, "timestamp": "03:17:55", "text": "そして、決して私の過ちを繰り返さないでください。それから行く、それから行く"}, {"type": "subtitle", "time": 11877.349, "timestamp": "03:17:57", "text": "モデリングを用いて。 「ああ」とは言わないで、"}, {"type": "subtitle", "time": 11879.349, "timestamp": "03:17:59", "text": "どうぞ、シャクさん。 H. いいえ、それは"}]
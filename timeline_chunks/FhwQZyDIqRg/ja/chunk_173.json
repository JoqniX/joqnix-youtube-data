[{"type": "subtitle", "time": 10383.19, "timestamp": "02:53:03", "text": "ああ、くそ。私のミスです。ああ、見て。大きな"}, {"type": "subtitle", "time": 10386.469, "timestamp": "02:53:06", "text": "配送ボックス。みんな、手伝ってくれ。"}, {"type": "subtitle", "time": 10388.63, "timestamp": "02:53:08", "text": "はい。"}, {"type": "subtitle", "time": 10392.23, "timestamp": "02:53:12", "text": "さあ行こう。よし、拾って。ゆっくり。"}, {"type": "subtitle", "time": 10394.79, "timestamp": "02:53:14", "text": "さあ行こう。ゆっくり。私にさせてください、私たちができれば"}, {"type": "subtitle", "time": 10397.03, "timestamp": "02:53:17", "text": "仕上げる。このまま終わりたいですね。"}, {"type": "subtitle", "time": 10400.79, "timestamp": "02:53:20", "text": "最初のやつ。もうすぐ終わります。"}, {"type": "subtitle", "time": 10403.63, "timestamp": "02:53:23", "text": "みんな、助けて。調理されるだろう"}, {"type": "subtitle", "time": 10408.71, "timestamp": "02:53:28", "text": "いいえ。ああ、やばい。わかった。戻ってください。戻る。"}, {"type": "subtitle", "time": 10410.389, "timestamp": "02:53:30", "text": "私は戻ります。いや。いや。いや。待って。待って。"}, {"type": "subtitle", "time": 10413.99, "timestamp": "02:53:33", "text": "待って。待って。来る。はい。はい。はい。離れる。"}, {"type": "subtitle", "time": 10417.03, "timestamp": "02:53:37", "text": "私はここを去るべきでしょうか？わかった。おっしゃる通りです。おお、"}, {"type": "subtitle", "time": 10418.95, "timestamp": "02:53:38", "text": "主。やめよう。やめよう。いいえ。いいえ。いいえ。"}, {"type": "subtitle", "time": 10422.07, "timestamp": "02:53:42", "text": "いいえ。やめてください。ゼノン。禅。そのままにしておいて。離れる"}, {"type": "subtitle", "time": 10423.83, "timestamp": "02:53:43", "text": "それ。そのままにしておいて。ゼノン。そのままにしておいて。私はそれをそのままにしておいた。"}, {"type": "subtitle", "time": 10428.95, "timestamp": "02:53:48", "text": "私はそれをそのままにしておいた。ああ、二回言ったよ、兄弟。"}, {"type": "subtitle", "time": 10432.389, "timestamp": "02:53:52", "text": "いや。ふざけんな。わーい。終わりましたか？"}, {"type": "subtitle", "time": 10434.23, "timestamp": "02:53:54", "text": "最初の抽出？ああ、私はどこへ行くのだろう？"}, {"type": "subtitle", "time": 10436.309, "timestamp": "02:53:56", "text": "いいえ。いいえ。最初に終わりました。いいえ、大丈夫です。その"}, {"type": "subtitle", "time": 10439.429, "timestamp": "02:53:59", "text": "大丈夫。大丈夫です。大丈夫です。うん。しかし"}]
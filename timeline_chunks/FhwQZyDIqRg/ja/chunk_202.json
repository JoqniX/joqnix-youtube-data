[{"type": "subtitle", "time": 12121.59, "timestamp": "03:22:01", "text": "ストリーム。"}, {"type": "subtitle", "time": 12124.03, "timestamp": "03:22:04", "text": "最もテストされた、"}, {"type": "subtitle", "time": 12127.87, "timestamp": "03:22:07", "text": "デフォルト、ベストベータ、最新"}, {"type": "subtitle", "time": 12136.51, "timestamp": "03:22:16", "text": "スチーム？ああ、なんてことだ、君はこれをやっているのか"}, {"type": "subtitle", "time": 12144.389, "timestamp": "03:22:24", "text": "人々は決して好きにならないだろう、私はそうしなかった"}, {"type": "subtitle", "time": 12147.15, "timestamp": "03:22:27", "text": "私はいつもそうしているわけではありません。私は"}, {"type": "subtitle", "time": 12150.71, "timestamp": "03:22:30", "text": "仕事だから、私みたいにこんなことはできない"}, {"type": "subtitle", "time": 12154.55, "timestamp": "03:22:34", "text": "仕事のようにいつも"}, {"type": "subtitle", "time": 12156.389, "timestamp": "03:22:36", "text": "私にはこれはできない"}, {"type": "subtitle", "time": 12159.429, "timestamp": "03:22:39", "text": "日本に行った後はもう何も"}, {"type": "subtitle", "time": 12163.269, "timestamp": "03:22:43", "text": "最大1時間。うん。うん。まるであなたが手に入れたように"}, {"type": "subtitle", "time": 12164.11, "timestamp": "03:22:44", "text": "である"}, {"type": "subtitle", "time": 12169.79, "timestamp": "03:22:49", "text": "そう、もしあなたが仕事をしているなら"}, {"type": "subtitle", "time": 12174.389, "timestamp": "03:22:54", "text": "ええ、今日はただ"}, {"type": "subtitle", "time": 12176.429, "timestamp": "03:22:56", "text": "リラックスした感じ"}]
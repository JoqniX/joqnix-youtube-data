[{"type": "subtitle", "time": 8106.79, "timestamp": "02:15:06", "text": "こんにちは。いやいや。"}, {"type": "subtitle", "time": 8108.709, "timestamp": "02:15:08", "text": "ああ神様、これは私が殺すことになる"}, {"type": "subtitle", "time": 8111.189, "timestamp": "02:15:11", "text": "私はこれから離れます。私をからかってるの？"}, {"type": "subtitle", "time": 8114.47, "timestamp": "02:15:14", "text": "私は、私は、私は、私の私の"}, {"type": "subtitle", "time": 8116.47, "timestamp": "02:15:16", "text": "おそらく彼らはそれを切り取って"}, {"type": "subtitle", "time": 8125.03, "timestamp": "02:15:25", "text": "間違いなく可愛い。"}, {"type": "subtitle", "time": 8126.79, "timestamp": "02:15:26", "text": "私をからかってるの？とても可愛かった。"}, {"type": "subtitle", "time": 8138.91, "timestamp": "02:15:38", "text": "それはそれは"}, {"type": "subtitle", "time": 8141.35, "timestamp": "02:15:41", "text": "うん、実際面白いね"}, {"type": "subtitle", "time": 8144.109, "timestamp": "02:15:44", "text": "私はもっ​​と"}, {"type": "subtitle", "time": 8150.149, "timestamp": "02:15:50", "text": "暗くて違うファン。うんうん。ああ、"}, {"type": "subtitle", "time": 8152.47, "timestamp": "02:15:52", "text": "神。でも、それは素晴らしかった"}, {"type": "subtitle", "time": 8153.99, "timestamp": "02:15:53", "text": "会話。アニメに関しては、"}, {"type": "subtitle", "time": 8156.709, "timestamp": "02:15:56", "text": "気分を上げてくれるから、ああ"}, {"type": "subtitle", "time": 8158.629, "timestamp": "02:15:58", "text": "ああ、本当に、あまりにも多すぎて"}]
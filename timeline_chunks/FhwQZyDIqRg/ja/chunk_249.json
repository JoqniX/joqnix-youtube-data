[{"type": "subtitle", "time": 14940.95, "timestamp": "04:09:00", "text": "引っ張ることができる"}, {"type": "subtitle", "time": 14944.229, "timestamp": "04:09:04", "text": "えっと、私たちは"}, {"type": "subtitle", "time": 14945.83, "timestamp": "04:09:05", "text": "ボトル"}, {"type": "subtitle", "time": 14947.71, "timestamp": "04:09:07", "text": "そして私は言う"}, {"type": "subtitle", "time": 14951.75, "timestamp": "04:09:11", "text": "えーっと、もしあなたがそうしたいなら"}, {"type": "subtitle", "time": 14956.229, "timestamp": "04:09:16", "text": "ボトルを引っ張って"}, {"type": "subtitle", "time": 14958.59, "timestamp": "04:09:18", "text": "ガラスからボトルへ、"}, {"type": "subtitle", "time": 14960.95, "timestamp": "04:09:20", "text": "漏斗。でも、私たちは必要ないと言っています"}, {"type": "subtitle", "time": 14963.349, "timestamp": "04:09:23", "text": "漏斗。ただ注ぎ込めばいいんです。"}, {"type": "subtitle", "time": 14966.15, "timestamp": "04:09:26", "text": "ええ、もちろん私たち二人ともアプローチします。"}, {"type": "subtitle", "time": 14971.95, "timestamp": "04:09:31", "text": "よし。でも、私たちは近くで作業しています"}, {"type": "subtitle", "time": 14974.07, "timestamp": "04:09:34", "text": "コンピューター。私たちが近くで働いていると想像してみてください"}, {"type": "subtitle", "time": 14976.07, "timestamp": "04:09:36", "text": "コンピューターと水を注ぐ必要があります"}, {"type": "subtitle", "time": 14978.189, "timestamp": "04:09:38", "text": "それなし"}, {"type": "subtitle", "time": 14981.11, "timestamp": "04:09:41", "text": "こぼれている。だから明らかにあなたの方法は"}, {"type": "subtitle", "time": 14985.51, "timestamp": "04:09:45", "text": "その通りです。できるけど、"}, {"type": "subtitle", "time": 14988.469, "timestamp": "04:09:48", "text": "水をこぼすリスク"}, {"type": "subtitle", "time": 14991.189, "timestamp": "04:09:51", "text": "コンピューターが起動し、"}, {"type": "subtitle", "time": 14994.07, "timestamp": "04:09:54", "text": "タービン全体を停止してください。"}, {"type": "subtitle", "time": 14997.83, "timestamp": "04:09:57", "text": "右。うん。しかし私の漏斗法は"}]
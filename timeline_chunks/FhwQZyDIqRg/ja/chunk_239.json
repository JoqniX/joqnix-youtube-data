[{"type": "subtitle", "time": 14340.63, "timestamp": "03:59:00", "text": "それについて心配してください。私は"}, {"type": "subtitle", "time": 14342.71, "timestamp": "03:59:02", "text": "同意できない。私は反対の立場を取ります。"}, {"type": "subtitle", "time": 14346.07, "timestamp": "03:59:06", "text": "私はそういうことはしません。もし私がそれらを実行すれば、"}, {"type": "subtitle", "time": 14348.95, "timestamp": "03:59:08", "text": "私は決して平和的な態度は取らない。私は楽しんでいます"}, {"type": "subtitle", "time": 14351.59, "timestamp": "03:59:11", "text": "一人で行う趣味や活動"}, {"type": "subtitle", "time": 14355.59, "timestamp": "03:59:15", "text": "グループ1。私は一人でできる趣味が好きです。"}, {"type": "subtitle", "time": 14358.15, "timestamp": "03:59:18", "text": "固体とは何ですか？ソロであることは明らかです。"}, {"type": "subtitle", "time": 14361.429, "timestamp": "03:59:21", "text": "ソロ、ソロ。ソロ"}, {"type": "subtitle", "time": 14364.51, "timestamp": "03:59:24", "text": "ソロ。私は一人で何かをすることはありません。だからあなたは"}, {"type": "subtitle", "time": 14367.59, "timestamp": "03:59:27", "text": "同意できない。ほとんど仕事みたいなものだ。"}, {"type": "subtitle", "time": 14370.07, "timestamp": "03:59:30", "text": "仕事。仕事でも、私は"}, {"type": "subtitle", "time": 14373.51, "timestamp": "03:59:33", "text": "グループ。つまり、一人で楽しむ趣味のようなものですね。私はしません"}, {"type": "subtitle", "time": 14375.429, "timestamp": "03:59:35", "text": "最近は一人で趣味を楽しむ時間が増えた。"}, {"type": "subtitle", "time": 14377.51, "timestamp": "03:59:37", "text": "本を読んだり、遊んだりするのと同じように"}, {"type": "subtitle", "time": 14378.95, "timestamp": "03:59:38", "text": "シングルプレイヤーゲーム。時間がない"}, {"type": "subtitle", "time": 14380.95, "timestamp": "03:59:40", "text": "それらのために。ええ、私は"}, {"type": "chat", "time": 14383.089, "timestamp": "03:59:43", "author": "@DinyoFoxy", "avatar": "https://yt4.ggpht.com/DGXvUKi0q0ld5Zo5CNG2tmulZfZqg_h6ivQHLtQfKyx-z_EjHr-Bx7limqyg4JtpZ00_XP_BTQ=s64-c-k-c0x00ffffff-no-rj", "message": "bye i am going to bed good night"}, {"type": "subtitle", "time": 14383.11, "timestamp": "03:59:43", "text": "残念ながら、これに従うしかありません。あなたはできません"}, {"type": "subtitle", "time": 14384.79, "timestamp": "03:59:44", "text": "架空の小説を書いている自分を想像してみてください"}, {"type": "subtitle", "time": 14386.03, "timestamp": "03:59:46", "text": "ストーリー"}, {"type": "subtitle", "time": 14388.11, "timestamp": "03:59:48", "text": "いいえ、できません"}, {"type": "subtitle", "time": 14390.71, "timestamp": "03:59:50", "text": "自分自身を想像してみてください。想像もできない"}, {"type": "subtitle", "time": 14394.429, "timestamp": "03:59:54", "text": "自分自身を醜くする。私は書けません"}, {"type": "subtitle", "time": 14399.349, "timestamp": "03:59:59", "text": "生きているものなら何でも。いや、いや。どれがそれ？"}]
[{"type": "subtitle", "time": 14522.229, "timestamp": "04:02:02", "text": "月、何でもいいよ。切らなければならないし"}, {"type": "subtitle", "time": 14524.55, "timestamp": "04:02:04", "text": "あなたの仲間たちと正しい関係を築く。時々あなたは"}, {"type": "subtitle", "time": 14526.59, "timestamp": "04:02:06", "text": "そうしなければならない、そうやって作るんだ"}, {"type": "subtitle", "time": 14529.189, "timestamp": "04:02:09", "text": "効率的。彼らを説得しなければならない"}, {"type": "subtitle", "time": 14531.349, "timestamp": "04:02:11", "text": "いつか。彼らに向かって大声で叫ばなければならない。"}, {"type": "subtitle", "time": 14534.07, "timestamp": "04:02:14", "text": "一日、"}, {"type": "subtitle", "time": 14536.469, "timestamp": "04:02:16", "text": "ある日。意地悪にならなければならない"}, {"type": "subtitle", "time": 14539.67, "timestamp": "04:02:19", "text": "あなたがずっと嫌っていた人。あなたが持っている"}, {"type": "subtitle", "time": 14543.83, "timestamp": "04:02:23", "text": "仕事をするためにそこへ行く"}, {"type": "subtitle", "time": 14546.469, "timestamp": "04:02:26", "text": "時々。"}, {"type": "subtitle", "time": 14550.189, "timestamp": "04:02:30", "text": "はい、そうです。だから私は"}, {"type": "subtitle", "time": 14552.87, "timestamp": "04:02:32", "text": "効率。もしこれを想像したら、私は"}, {"type": "subtitle", "time": 14555.99, "timestamp": "04:02:35", "text": "同僚ととても遅くまで一緒にいました"}, {"type": "subtitle", "time": 14558.469, "timestamp": "04:02:38", "text": "ある日、何も進まなくなる。あなたは"}, {"type": "subtitle", "time": 14561.59, "timestamp": "04:02:41", "text": "腹が立って、聞いてくれ、"}, {"type": "subtitle", "time": 14564.95, "timestamp": "04:02:44", "text": "今すぐやらせてほしい。私は気にしない"}, {"type": "subtitle", "time": 14566.87, "timestamp": "04:02:46", "text": "どうやってやるの？あなたが何をしているのか分かりません"}, {"type": "subtitle", "time": 14570.389, "timestamp": "04:02:50", "text": "それ。わかった。魔法って何であれ"}, {"type": "subtitle", "time": 14573.99, "timestamp": "04:02:53", "text": "君なら、これを終わらせるよ。私は気にしない。しかし"}, {"type": "subtitle", "time": 14576.15, "timestamp": "04:02:56", "text": "数ヶ月かかる。私は気にしない。やってみよう"}, {"type": "subtitle", "time": 14579.269, "timestamp": "04:02:59", "text": "それ。数ヶ月の猶予を与えたのに。まだ終わっていない。"}]
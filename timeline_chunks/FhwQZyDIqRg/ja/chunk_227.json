[{"type": "subtitle", "time": 13620.71, "timestamp": "03:47:00", "text": "少しだけ。うん。うん。シャム氏。はい。それは"}, {"type": "subtitle", "time": 13622.71, "timestamp": "03:47:02", "text": "私がジャック氏に言おうとしていたこと。"}, {"type": "subtitle", "time": 13624.79, "timestamp": "03:47:04", "text": "はい。私は一時停止します"}, {"type": "subtitle", "time": 13627.99, "timestamp": "03:47:07", "text": "テスト。ああ、人々はただ虚無を見ているだけだ。"}, {"type": "subtitle", "time": 13629.67, "timestamp": "03:47:09", "text": "ちょっと待ってください。ええ、これは"}, {"type": "subtitle", "time": 13636.55, "timestamp": "03:47:16", "text": "ということで、ちょっと一時停止します"}, {"type": "subtitle", "time": 13640.229, "timestamp": "03:47:20", "text": "Jさん、あなたが1秒間テストするまで、"}, {"type": "subtitle", "time": 13642.63, "timestamp": "03:47:22", "text": "さっきやったように何でもできます"}, {"type": "subtitle", "time": 13644.229, "timestamp": "03:47:24", "text": "質問を読み上げてから"}, {"type": "subtitle", "time": 13646.15, "timestamp": "03:47:26", "text": "説明とか色々。うん。うん。うん。"}, {"type": "subtitle", "time": 13656.51, "timestamp": "03:47:36", "text": "する。"}, {"type": "subtitle", "time": 13661.51, "timestamp": "03:47:41", "text": "はい。ええと、私は違います。ああ、申し訳ありません、ミス"}, {"type": "subtitle", "time": 13663.75, "timestamp": "03:47:43", "text": "シング。あなたに電話するつもりはなかった"}, {"type": "subtitle", "time": 13665.91, "timestamp": "03:47:45", "text": "ミスター。私は普段文字通り"}, {"type": "subtitle", "time": 13668.229, "timestamp": "03:47:48", "text": "皆さん、ミスター。他に何があるか知ってる？"}, {"type": "subtitle", "time": 13670.63, "timestamp": "03:47:50", "text": "全員に電話するつもり？私は明らかに"}, {"type": "subtitle", "time": 13673.189, "timestamp": "03:47:53", "text": "みんなを兄弟と呼んだ。わからない"}, {"type": "subtitle", "time": 13676.229, "timestamp": "03:47:56", "text": "私がそうする理由。兄弟。兄弟。私は"}, {"type": "subtitle", "time": 13678.15, "timestamp": "03:47:58", "text": "ここにピン留めされています。"}]
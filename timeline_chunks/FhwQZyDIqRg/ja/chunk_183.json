[{"type": "subtitle", "time": 10980.469, "timestamp": "03:03:00", "text": "来て。本当に？ H."}, {"type": "subtitle", "time": 10982.99, "timestamp": "03:03:02", "text": "おお。おお。おお。こんにちは。"}, {"type": "subtitle", "time": 10991.429, "timestamp": "03:03:11", "text": "ええと、元気ですよ、ミスター。"}, {"type": "subtitle", "time": 10997.67, "timestamp": "03:03:17", "text": "はい、少々お待ちください。私は行く"}, {"type": "subtitle", "time": 11002.63, "timestamp": "03:03:22", "text": "トイレに行って戻ってきてください。わかりました、もしそれが"}, {"type": "subtitle", "time": 11005.51, "timestamp": "03:03:25", "text": "時間を無駄にしないでください。こんにちは。私は私は"}, {"type": "subtitle", "time": 11008.55, "timestamp": "03:03:28", "text": "苦しみ。私は苦しんでいます。なんてこった。全て"}, {"type": "subtitle", "time": 11011.11, "timestamp": "03:03:31", "text": "はい、また戻ってきます。"}, {"type": "subtitle", "time": 11034.67, "timestamp": "03:03:54", "text": "いいえ。なんてこった、入って。私は"}]
[{"type": "subtitle", "time": 4098.83, "timestamp": "01:08:18", "text": "ああ、私は耐えられる。ええ、耐えられる。"}, {"type": "subtitle", "time": 4100.229, "timestamp": "01:08:20", "text": "[音楽]"}, {"type": "subtitle", "time": 4102.789, "timestamp": "01:08:22", "text": "道に迷ったのでしょうか？もう1つあります。する"}, {"type": "subtitle", "time": 4106.789, "timestamp": "01:08:26", "text": "あなたはこの指輪を受け取りますか？"}, {"type": "subtitle", "time": 4110.99, "timestamp": "01:08:30", "text": "ああ、なんてことだ。壊したの？"}, {"type": "subtitle", "time": 4114.39, "timestamp": "01:08:34", "text": "いや、私が壊すんだ。"}, {"type": "subtitle", "time": 4130.309, "timestamp": "01:08:50", "text": "亡くなった。どうやって"}, {"type": "subtitle", "time": 4132.789, "timestamp": "01:08:52", "text": "全員生存している。待って、これは何？"}, {"type": "subtitle", "time": 4136.95, "timestamp": "01:08:56", "text": "それは何ですか？これを手に入れたのは誰？この遅い"}, {"type": "subtitle", "time": 4139.189, "timestamp": "01:08:59", "text": "モーション。"}]
[{"type": "subtitle", "time": 3420.23, "timestamp": "00:57:00", "text": "バス全体が満員だった"}, {"type": "subtitle", "time": 3421.829, "timestamp": "00:57:01", "text": "パワーアップアイテムとか、そういうもの全部含めてね。私は"}, {"type": "subtitle", "time": 3423.99, "timestamp": "00:57:03", "text": "うわぁ、すごい。"}, {"type": "subtitle", "time": 3426.71, "timestamp": "00:57:06", "text": "くそ。ちなみに、手榴弾は買えますよ。"}, {"type": "subtitle", "time": 3428.069, "timestamp": "00:57:08", "text": "どうやら、手榴弾を買って殺すことができるらしい"}, {"type": "subtitle", "time": 3429.829, "timestamp": "00:57:09", "text": "嘲笑者たち。それでは、そうしましょう。私は望む"}, {"type": "subtitle", "time": 3439.67, "timestamp": "00:57:19", "text": "了解、参加します。"}, {"type": "subtitle", "time": 3442.789, "timestamp": "00:57:22", "text": "例えば、ショットガンを持った男がいると想像してみてください。"}, {"type": "subtitle", "time": 3444.47, "timestamp": "00:57:24", "text": "待って、"}, {"type": "subtitle", "time": 3446.47, "timestamp": "00:57:26", "text": "私が持ちます。了解しました。私"}, {"type": "subtitle", "time": 3448.87, "timestamp": "00:57:28", "text": "わかったよ。"}, {"type": "subtitle", "time": 3456.19, "timestamp": "00:57:36", "text": "遠慮しておきます。来ないで"}, {"type": "subtitle", "time": 3464.069, "timestamp": "00:57:44", "text": "大丈夫。ごめんなさい。ごめん。ごめんなさい。"}, {"type": "subtitle", "time": 3467.75, "timestamp": "00:57:47", "text": "ご心配なく。心配ない。"}, {"type": "subtitle", "time": 3468.829, "timestamp": "00:57:48", "text": "私"}, {"type": "subtitle", "time": 3471.75, "timestamp": "00:57:51", "text": "もう諦めるしかない。あなたはそうする必要はありません"}, {"type": "subtitle", "time": 3474.789, "timestamp": "00:57:54", "text": "車の中では気をつけて。うまくいかないだろう。"}, {"type": "subtitle", "time": 3476.71, "timestamp": "00:57:56", "text": "よし、大きなものをつかんで"}, {"type": "subtitle", "time": 3478.789, "timestamp": "00:57:58", "text": "モンスターも同様です。"}]
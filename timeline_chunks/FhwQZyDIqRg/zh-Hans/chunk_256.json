[{"type": "subtitle", "time": 15361.75, "timestamp": "04:16:01", "text": "绝对会，你肯定会的"}, {"type": "subtitle", "time": 15364.149, "timestamp": "04:16:04", "text": "是的，我不是那样的人。我不会使用"}, {"type": "subtitle", "time": 15366.55, "timestamp": "04:16:06", "text": "又是这个名字。不要使用那个名字"}, {"type": "subtitle", "time": 15369.11, "timestamp": "04:16:09", "text": "再次。日本先生混音。如果你看到一个"}, {"type": "subtitle", "time": 15371.11, "timestamp": "04:16:11", "text": "真正的讨好型人格，你不会使用"}, {"type": "subtitle", "time": 15374.469, "timestamp": "04:16:14", "text": "又是这个名字。好的。是的，我还没有。"}, {"type": "subtitle", "time": 15376.71, "timestamp": "04:16:16", "text": "见过一个，所以才有了“我见过”这个说法。"}, {"type": "subtitle", "time": 15379.189, "timestamp": "04:16:19", "text": "见过太多了。我见过太多了。"}, {"type": "subtitle", "time": 15382.469, "timestamp": "04:16:22", "text": "我的天啊。是的。瞧，现在别这样"}, {"type": "subtitle", "time": 15383.83, "timestamp": "04:16:23", "text": "担心。你不是一个讨好型人格。"}, {"type": "subtitle", "time": 15385.91, "timestamp": "04:16:25", "text": "好的。你太过分了，你只是"}, {"type": "subtitle", "time": 15388.469, "timestamp": "04:16:28", "text": "心存善意，而你却一无所知。你是"}, {"type": "subtitle", "time": 15391.429, "timestamp": "04:16:31", "text": "我这就打电话。如果我想要"}, {"type": "subtitle", "time": 15395.75, "timestamp": "04:16:35", "text": "说实话，我不是。"}, {"type": "subtitle", "time": 15398.71, "timestamp": "04:16:38", "text": "我可以说你就像一个非常害羞的人"}, {"type": "subtitle", "time": 15402.229, "timestamp": "04:16:42", "text": "一个人，一个非常胆小的人。一个害羞的"}, {"type": "subtitle", "time": 15406.229, "timestamp": "04:16:46", "text": "胆小的人。你仅此而已。和"}, {"type": "subtitle", "time": 15408.87, "timestamp": "04:16:48", "text": "那种羞怯和胆怯正在造成一切"}, {"type": "subtitle", "time": 15411.189, "timestamp": "04:16:51", "text": "就像这种尴尬、紧张的东西"}, {"type": "subtitle", "time": 15413.51, "timestamp": "04:16:53", "text": "你现在正在经历的。"}, {"type": "subtitle", "time": 15416.55, "timestamp": "04:16:56", "text": "比如多次道歉"}, {"type": "subtitle", "time": 15419.429, "timestamp": "04:16:59", "text": "就像发送好友请求一样"}]
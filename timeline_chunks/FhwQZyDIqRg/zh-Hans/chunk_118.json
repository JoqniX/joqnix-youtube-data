[{"type": "subtitle", "time": 7085.629, "timestamp": "01:58:05", "text": "我们得到了"}, {"type": "subtitle", "time": 7088.709, "timestamp": "01:58:08", "text": "公司。啊，矮人们。"}, {"type": "subtitle", "time": 7091.83, "timestamp": "01:58:11", "text": "我们在做什么？矮人们"}, {"type": "subtitle", "time": 7094.229, "timestamp": "01:58:14", "text": "就在这里。没关系。我们偷偷摸摸地行动。"}, {"type": "subtitle", "time": 7107.03, "timestamp": "01:58:27", "text": "好了，我们抓到他了。"}, {"type": "subtitle", "time": 7108.55, "timestamp": "01:58:28", "text": "我们再买些其他东西吧。我发现了一个"}, {"type": "subtitle", "time": 7123.83, "timestamp": "01:58:43", "text": "是的。我的天啊。那是一个"}, {"type": "subtitle", "time": 7130.31, "timestamp": "01:58:50", "text": "各位，我弄到了灭火器。"}, {"type": "subtitle", "time": 7132.07, "timestamp": "01:58:52", "text": "找到好东西了。我找到了一些好东西。"}, {"type": "subtitle", "time": 7134.47, "timestamp": "01:58:54", "text": "我弄到了一把火焰喷射器。"}, {"type": "subtitle", "time": 7136.589, "timestamp": "01:58:56", "text": "嘿，给你。为什么是"}, {"type": "subtitle", "time": 7139.03, "timestamp": "01:58:59", "text": "它？当心。那东西可能会致命"}]
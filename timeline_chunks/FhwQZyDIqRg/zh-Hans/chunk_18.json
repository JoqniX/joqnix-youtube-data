[{"type": "subtitle", "time": 1081.11, "timestamp": "00:18:01", "text": "和我开玩笑。我不想任何人的呃"}, {"type": "subtitle", "time": 1084.789, "timestamp": "00:18:04", "text": "不喜欢，就像我不想喜欢我"}, {"type": "subtitle", "time": 1087.11, "timestamp": "00:18:07", "text": "我的意思是，我确实想去，但我太害羞了。"}, {"type": "subtitle", "time": 1088.909, "timestamp": "00:18:08", "text": "询问"}, {"type": "subtitle", "time": 1092.11, "timestamp": "00:18:12", "text": "帮助和"}, {"type": "subtitle", "time": 1094.59, "timestamp": "00:18:14", "text": "最后"}, {"type": "subtitle", "time": 1101.39, "timestamp": "00:18:21", "text": "最近首次亮相的这个人"}, {"type": "subtitle", "time": 1103.669, "timestamp": "00:18:23", "text": "月。等等，是这个月还是上个月？"}, {"type": "subtitle", "time": 1105.76, "timestamp": "00:18:25", "text": "月？ 她出道了，她真的很"}, {"type": "subtitle", "time": 1109.36, "timestamp": "00:18:29", "text": "她出道了，她真的很 卡哇伊"}, {"type": "subtitle", "time": 1116.99, "timestamp": "00:18:36", "text": "卡哇伊。她也在聊天中。"}, {"type": "subtitle", "time": 1121.789, "timestamp": "00:18:41", "text": "嘿，你们大多数人都知道她是一位……"}, {"type": "subtitle", "time": 1130.95, "timestamp": "00:18:50", "text": "嗯，她帮了我。"}, {"type": "subtitle", "time": 1134.47, "timestamp": "00:18:54", "text": "嗯，她帮我设计了一个方案。她画"}, {"type": "subtitle", "time": 1136.669, "timestamp": "00:18:56", "text": "这幅画是为我画的。"}]
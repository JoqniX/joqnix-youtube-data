[{"type": "subtitle", "time": 2822.15, "timestamp": "00:47:02", "text": "使我们复苏。好的。好的。"}, {"type": "subtitle", "time": 2826.47, "timestamp": "00:47:06", "text": "什么？哦，我们回来了。"}, {"type": "subtitle", "time": 2830.39, "timestamp": "00:47:10", "text": "我回来了。我回来了。每个人。是的。"}, {"type": "subtitle", "time": 2832.39, "timestamp": "00:47:12", "text": "大家都到齐了。我们走吧。我们走吧"}, {"type": "subtitle", "time": 2834.87, "timestamp": "00:47:14", "text": "前方。我的手电筒坏了"}, {"type": "subtitle", "time": 2837.109, "timestamp": "00:47:17", "text": "在职的。哦，那不是关键。对，就是那个。"}, {"type": "subtitle", "time": 2839.349, "timestamp": "00:47:19", "text": "并非关键。他已经死了。我是说，"}, {"type": "subtitle", "time": 2842.15, "timestamp": "00:47:22", "text": "是的，没问题。嘲笑鬼魂"}, {"type": "subtitle", "time": 2845.46, "timestamp": "00:47:25", "text": "然后鬼魂杀了他。"}, {"type": "subtitle", "time": 2846.71, "timestamp": "00:47:26", "text": "[音乐]"}, {"type": "subtitle", "time": 2848.39, "timestamp": "00:47:28", "text": "哦，我要把他扔进车里。我"}, {"type": "subtitle", "time": 2850.87, "timestamp": "00:47:30", "text": "看到他"}, {"type": "subtitle", "time": 2853.79, "timestamp": "00:47:33", "text": "哦，不。它被扔进了……"}, {"type": "subtitle", "time": 2857.75, "timestamp": "00:47:37", "text": "地方。他的头好像又缩回去了。"}, {"type": "subtitle", "time": 2860.15, "timestamp": "00:47:40", "text": "矿。我先抓到他了。它回来了吗？哦，"}, {"type": "subtitle", "time": 2865.109, "timestamp": "00:47:45", "text": "不。它回来了。这是我的。"}, {"type": "subtitle", "time": 2867.589, "timestamp": "00:47:47", "text": "快来。你去哪儿？哦，不。"}, {"type": "subtitle", "time": 2871.03, "timestamp": "00:47:51", "text": "它回来了，伙计们。伙计们，伙计们，伙计们，快跑！"}, {"type": "subtitle", "time": 2874.23, "timestamp": "00:47:54", "text": "它回来了。它回来了。它回来了。哦，不。"}, {"type": "subtitle", "time": 2877.43, "timestamp": "00:47:57", "text": "我们可以走了吗？我们能走了吗？哦，我的天"}, {"type": "subtitle", "time": 2879.51, "timestamp": "00:47:59", "text": "上帝。"}]
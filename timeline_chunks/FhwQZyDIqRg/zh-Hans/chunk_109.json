[{"type": "subtitle", "time": 6548.39, "timestamp": "01:49:08", "text": "真糟糕。他们要么就这么离开了我，要么……"}, {"type": "subtitle", "time": 6552.83, "timestamp": "01:49:12", "text": "这附近有鬼。而且我可以"}, {"type": "subtitle", "time": 6560.55, "timestamp": "01:49:20", "text": "我能听到你说话。你在吗？是的。这"}, {"type": "subtitle", "time": 6563.91, "timestamp": "01:49:23", "text": "方式。我没看见你。过来一下。"}, {"type": "subtitle", "time": 6565.27, "timestamp": "01:49:25", "text": "我就在这里。来，来，来。是"}, {"type": "subtitle", "time": 6568.79, "timestamp": "01:49:28", "text": "准备离开。好了，我们走吧。"}, {"type": "subtitle", "time": 6571.709, "timestamp": "01:49:31", "text": "跑步。我在跑步。我在跑步。我们发现"}, {"type": "subtitle", "time": 6575.109, "timestamp": "01:49:35", "text": "她。我们找到她了。哦，不。她死了。"}, {"type": "subtitle", "time": 6578.07, "timestamp": "01:49:38", "text": "她死了。她死了。不，不，不，不。"}, {"type": "subtitle", "time": 6580.229, "timestamp": "01:49:40", "text": "不，不，不，请不要那样做。跑步。"}, {"type": "subtitle", "time": 6581.669, "timestamp": "01:49:41", "text": "跑步。跑步。"}, {"type": "subtitle", "time": 6584.79, "timestamp": "01:49:44", "text": "快跑。"}, {"type": "subtitle", "time": 6588.55, "timestamp": "01:49:48", "text": "我跑不动了。我跑不动了。我跑不动了。"}, {"type": "subtitle", "time": 6593.39, "timestamp": "01:49:53", "text": "拉屎。哦，我跑不动了。我的天啊。哦，我的天"}, {"type": "subtitle", "time": 6596.83, "timestamp": "01:49:56", "text": "上帝。我喜欢"}]
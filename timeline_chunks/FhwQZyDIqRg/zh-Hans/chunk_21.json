[{"type": "subtitle", "time": 1266.51, "timestamp": "00:21:06", "text": "设计。嘿，还有这个"}, {"type": "subtitle", "time": 1268.27, "timestamp": "00:21:08", "text": "是"}, {"type": "subtitle", "time": 1270.71, "timestamp": "00:21:10", "text": "实际上，这将成为未来冲击波的发展方向。"}, {"type": "subtitle", "time": 1272.43, "timestamp": "00:21:12", "text": "接下来"}, {"type": "subtitle", "time": 1276.51, "timestamp": "00:21:16", "text": "在。但我很紧张。我浑身颤抖"}, {"type": "subtitle", "time": 1281.149, "timestamp": "00:21:21", "text": "现在。你好。所以，所以，所以"}, {"type": "subtitle", "time": 1283.23, "timestamp": "00:21:23", "text": "所以你知道，"}, {"type": "subtitle", "time": 1286.07, "timestamp": "00:21:26", "text": "嗯，所以，呃，那天她，呃，"}, {"type": "subtitle", "time": 1294.11, "timestamp": "00:21:34", "text": "画草图，老兄，我其实"}, {"type": "subtitle", "time": 1298.31, "timestamp": "00:21:38", "text": "夜里哭了，是夜里哭的，还是什么东西哭的？"}, {"type": "subtitle", "time": 1300.75, "timestamp": "00:21:40", "text": "某物？所以，我当时确实是那样的人。"}, {"type": "subtitle", "time": 1303.669, "timestamp": "00:21:43", "text": "那段时间我确实在做一些事情"}, {"type": "subtitle", "time": 1305.39, "timestamp": "00:21:45", "text": "这"}, {"type": "subtitle", "time": 1307.95, "timestamp": "00:21:47", "text": "直播的时候我非常投入"}, {"type": "subtitle", "time": 1311.35, "timestamp": "00:21:51", "text": "沮丧的。我哪儿都联系不上。"}, {"type": "subtitle", "time": 1313.43, "timestamp": "00:21:53", "text": "所有东西。这太难了"}, {"type": "subtitle", "time": 1314.83, "timestamp": "00:21:54", "text": "让我"}, {"type": "subtitle", "time": 1316.87, "timestamp": "00:21:56", "text": "了解我所有的新东西"}, {"type": "subtitle", "time": 1319.11, "timestamp": "00:21:59", "text": "学习"}]
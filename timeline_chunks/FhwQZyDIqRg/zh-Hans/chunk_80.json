[{"type": "subtitle", "time": 4807.11, "timestamp": "01:20:07", "text": "我的天啊，"}, {"type": "subtitle", "time": 4810.63, "timestamp": "01:20:10", "text": "兄弟。你不会那样做的。你不会"}, {"type": "subtitle", "time": 4811.47, "timestamp": "01:20:11", "text": "做"}, {"type": "subtitle", "time": 4813.149, "timestamp": "01:20:13", "text": "那"}, {"type": "subtitle", "time": 4817.47, "timestamp": "01:20:17", "text": "因为伙计，我的意思是，我"}, {"type": "subtitle", "time": 4821.51, "timestamp": "01:20:21", "text": "有人逃脱了。好了，我在跑步。"}, {"type": "subtitle", "time": 4824.47, "timestamp": "01:20:24", "text": "发生了什么事？有个家伙带着一个"}, {"type": "subtitle", "time": 4832.709, "timestamp": "01:20:32", "text": "我当时正试图通知所有人快跑。"}, {"type": "subtitle", "time": 4835.51, "timestamp": "01:20:35", "text": "对，就是那个老人。他……呃……你……"}, {"type": "subtitle", "time": 4839.669, "timestamp": "01:20:39", "text": "叫它什么？他能分辨出声音。哦，"}, {"type": "subtitle", "time": 4842.47, "timestamp": "01:20:42", "text": "该死。是的，我忘了。我忘了。德拉克斯"}, {"type": "subtitle", "time": 4844.63, "timestamp": "01:20:44", "text": "哦，该死。因为我记得什么"}, {"type": "subtitle", "time": 4847.59, "timestamp": "01:20:47", "text": "发生的事情是"}, {"type": "subtitle", "time": 4849.27, "timestamp": "01:20:49", "text": "哦，这些人。这些人需要是"}, {"type": "subtitle", "time": 4851.35, "timestamp": "01:20:51", "text": "小心。他们应该停止交谈。为什么"}]
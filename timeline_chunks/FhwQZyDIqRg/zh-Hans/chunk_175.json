[{"type": "subtitle", "time": 10501.07, "timestamp": "02:55:01", "text": "好的，我去。患病的"}, {"type": "subtitle", "time": 10504.309, "timestamp": "02:55:04", "text": "去。跑步。这里面肯定有东西。获取"}, {"type": "subtitle", "time": 10521.99, "timestamp": "02:55:21", "text": "我的天啊。我的天哪。这到底是什么鬼东西"}, {"type": "subtitle", "time": 10527.51, "timestamp": "02:55:27", "text": "我现在不知道该躲到哪里去了。我可以吗？"}, {"type": "subtitle", "time": 10541.269, "timestamp": "02:55:41", "text": "认真地想接受这一点"}, {"type": "subtitle", "time": 10543.51, "timestamp": "02:55:43", "text": "钱。"}, {"type": "subtitle", "time": 10546.309, "timestamp": "02:55:46", "text": "我的天啊。你看起来更像"}, {"type": "subtitle", "time": 10548.87, "timestamp": "02:55:48", "text": "伙计们，这是鬼毛。还有其他人吗？它是"}, {"type": "subtitle", "time": 10550.389, "timestamp": "02:55:50", "text": "就在我们房间里。没关系。他"}, {"type": "subtitle", "time": 10553.349, "timestamp": "02:55:53", "text": "逃跑了。伙计们，快点。快点。不"}, {"type": "subtitle", "time": 10554.51, "timestamp": "02:55:54", "text": "噪音。"}]
[{"type": "subtitle", "time": 9480.309, "timestamp": "02:38:00", "text": "嗯，你听起来很和善。就在这里。不"}, {"type": "subtitle", "time": 9482.23, "timestamp": "02:38:02", "text": "进来。是啊，你听起来像是在说“不合时宜”。"}, {"type": "subtitle", "time": 9484.52, "timestamp": "02:38:04", "text": "那里。"}, {"type": "subtitle", "time": 9486.23, "timestamp": "02:38:06", "text": "[音乐]"}, {"type": "subtitle", "time": 9491.91, "timestamp": "02:38:11", "text": "嗨，约翰。你好。"}, {"type": "subtitle", "time": 9503.67, "timestamp": "02:38:23", "text": "[音乐]"}, {"type": "subtitle", "time": 9506.63, "timestamp": "02:38:26", "text": "这东西在哪儿？你从哪里听说的？"}, {"type": "subtitle", "time": 9508.55, "timestamp": "02:38:28", "text": "这是什么东西？我们为什么会听到这些"}, {"type": "subtitle", "time": 9510.71, "timestamp": "02:38:30", "text": "所有这些东西？我是什么？你是什么？"}, {"type": "subtitle", "time": 9513.91, "timestamp": "02:38:33", "text": "在听什么？屋顶。它就像这样"}, {"type": "subtitle", "time": 9517.11, "timestamp": "02:38:37", "text": "枪声之类的。"}, {"type": "subtitle", "time": 9519.03, "timestamp": "02:38:39", "text": "我的天啊。你听到了吗？我 我"}, {"type": "subtitle", "time": 9522.15, "timestamp": "02:38:42", "text": "不该跑的。"}, {"type": "subtitle", "time": 9524.469, "timestamp": "02:38:44", "text": "他们听到了吗？那家伙就像"}, {"type": "subtitle", "time": 9528.389, "timestamp": "02:38:48", "text": "躲猫猫，砰！躲猫猫，砰！我"}, {"type": "subtitle", "time": 9530.309, "timestamp": "02:38:50", "text": "认为那家伙是盲人，所以他对……有反应"}, {"type": "subtitle", "time": 9533.03, "timestamp": "02:38:53", "text": "声音。他完全无视了夏树"}, {"type": "subtitle", "time": 9535.03, "timestamp": "02:38:55", "text": "但他当时也在躲藏。是的，"}, {"type": "subtitle", "time": 9536.95, "timestamp": "02:38:56", "text": "没关系。"}]
[{"type": "subtitle", "time": 3367.48, "timestamp": "00:56:07", "text": "决不。"}, {"type": "subtitle", "time": 3369.75, "timestamp": "00:56:09", "text": "[音乐]"}, {"type": "subtitle", "time": 3371.27, "timestamp": "00:56:11", "text": "这是我第一次见到这种情况。这"}, {"type": "subtitle", "time": 3373.19, "timestamp": "00:56:13", "text": "这是第一次。你到底做了什么？"}, {"type": "subtitle", "time": 3376.549, "timestamp": "00:56:16", "text": "约翰，你本来赢定了。"}, {"type": "subtitle", "time": 3384.23, "timestamp": "00:56:24", "text": "小鸭子？我的天啊。"}, {"type": "subtitle", "time": 3386.47, "timestamp": "00:56:26", "text": "所以，就像游戏在多少分钟后结束了一样"}, {"type": "subtitle", "time": 3388.15, "timestamp": "00:56:28", "text": "我们加入至今已过去几分钟？ 30分钟。"}, {"type": "subtitle", "time": 3390.87, "timestamp": "00:56:30", "text": "我们结束了吗？哇。是的。该死。"}, {"type": "subtitle", "time": 3392.549, "timestamp": "00:56:32", "text": "没关系。没关系。哇。结束"}, {"type": "subtitle", "time": 3394.23, "timestamp": "00:56:34", "text": "溪流。"}, {"type": "subtitle", "time": 3396.63, "timestamp": "00:56:36", "text": "直播结束。"}, {"type": "subtitle", "time": 3401.589, "timestamp": "00:56:41", "text": "惊人的。我的天哪。你好。我们再来一次。"}, {"type": "subtitle", "time": 3408.63, "timestamp": "00:56:48", "text": "哦，老兄。我不知道人们是怎么玩的。"}, {"type": "subtitle", "time": 3410.71, "timestamp": "00:56:50", "text": "这是独奏。所以，我当时就像在看这个"}, {"type": "subtitle", "time": 3412.47, "timestamp": "00:56:52", "text": "YouTube 上有个哥们儿在玩独奏"}, {"type": "subtitle", "time": 3415.589, "timestamp": "00:56:55", "text": "他精通大约200个级别，"}, {"type": "subtitle", "time": 3418.23, "timestamp": "00:56:58", "text": "我心想，他只是在无伴奏地演奏而已。"}]
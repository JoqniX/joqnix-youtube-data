[{"type": "subtitle", "time": 11314.59, "timestamp": "03:08:34", "text": "总之，这就是如此"}, {"type": "subtitle", "time": 11320.07, "timestamp": "03:08:40", "text": "真是愚蠢至极。我回来了。"}, {"type": "subtitle", "time": 11324.15, "timestamp": "03:08:44", "text": "哦，天哪。欢迎您，杰奎先生。"}, {"type": "subtitle", "time": 11326.55, "timestamp": "03:08:46", "text": "我吓到你了吗？"}, {"type": "subtitle", "time": 11330.23, "timestamp": "03:08:50", "text": "是的。杰克真是个怪人。"}, {"type": "subtitle", "time": 11339.269, "timestamp": "03:08:59", "text": "是的，我正在做"}]
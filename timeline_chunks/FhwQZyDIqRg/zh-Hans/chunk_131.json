[{"type": "subtitle", "time": 7862.47, "timestamp": "02:11:02", "text": "呃，你好。哦，我还以为你不在电脑前呢。"}, {"type": "subtitle", "time": 7864.709, "timestamp": "02:11:04", "text": "兄弟。我所在的区域警笛声此起彼伏。"}, {"type": "subtitle", "time": 7867.03, "timestamp": "02:11:07", "text": "停电。等等，这是真的。它是"}, {"type": "subtitle", "time": 7868.95, "timestamp": "02:11:08", "text": "正在发生。购买这些升级配件。"}, {"type": "subtitle", "time": 7871.43, "timestamp": "02:11:11", "text": "是的，这事正在发生。"}, {"type": "subtitle", "time": 7874.229, "timestamp": "02:11:14", "text": "我可以接受。疯狂的。好的，过来。"}, {"type": "subtitle", "time": 7877.109, "timestamp": "02:11:17", "text": "他把我锁在房间里了。橡胶房。只是"}, {"type": "subtitle", "time": 7879.75, "timestamp": "02:11:19", "text": "继续拿着。我拿着，我拿着"}, {"type": "subtitle", "time": 7882.31, "timestamp": "02:11:22", "text": "它。我拿着它。我们开始吗？"}, {"type": "subtitle", "time": 7884.069, "timestamp": "02:11:24", "text": "伙计们？每个人都遇到了故障之类的问题。"}, {"type": "subtitle", "time": 7885.51, "timestamp": "02:11:25", "text": "等等，等等，等等，等等。让我保留"}, {"type": "subtitle", "time": 7887.27, "timestamp": "02:11:27", "text": "拿着它。好的。我拿着它。"}, {"type": "subtitle", "time": 7888.709, "timestamp": "02:11:28", "text": "我拿着它。然后我做了什么"}, {"type": "subtitle", "time": 7890.229, "timestamp": "02:11:30", "text": "里面"}, {"type": "subtitle", "time": 7892.229, "timestamp": "02:11:32", "text": "只是"}, {"type": "subtitle", "time": 7895.43, "timestamp": "02:11:35", "text": "继续发送垃圾邮件。记住这一点。我是"}, {"type": "subtitle", "time": 7899.03, "timestamp": "02:11:39", "text": "对不起。我撞到人了吗？"}, {"type": "subtitle", "time": 7904.55, "timestamp": "02:11:44", "text": "我做不到。那是我。下一个。快点。"}, {"type": "subtitle", "time": 7907.109, "timestamp": "02:11:47", "text": "哦，我什么都没有。哦，不。你当时并不在场。"}, {"type": "subtitle", "time": 7909.91, "timestamp": "02:11:49", "text": "给我发垃圾邮件。"}, {"type": "subtitle", "time": 7911.669, "timestamp": "02:11:51", "text": "你本应该一直给我发垃圾邮件，直到"}, {"type": "subtitle", "time": 7913.669, "timestamp": "02:11:53", "text": "屏幕。我做了。我做了。我不知道什么时候"}, {"type": "subtitle", "time": 7915.43, "timestamp": "02:11:55", "text": "我们开始了。当装载皮肤到来时，"}, {"type": "subtitle", "time": 7917.99, "timestamp": "02:11:57", "text": "我已开始。好的，我就选一个吧。"}]
[{"type": "subtitle", "time": 12782.07, "timestamp": "03:33:02", "text": "概括。例如，我的"}, {"type": "subtitle", "time": 12783.91, "timestamp": "03:33:03", "text": "INFP。"}, {"type": "subtitle", "time": 12786.469, "timestamp": "03:33:06", "text": "那就像个调解人之类的角色。"}, {"type": "subtitle", "time": 12788.91, "timestamp": "03:33:08", "text": "这意味着我有68%"}, {"type": "subtitle", "time": 12791.229, "timestamp": "03:33:11", "text": "内向，74岁"}, {"type": "subtitle", "time": 12795.229, "timestamp": "03:33:15", "text": "直觉，78%的感觉和"}, {"type": "subtitle", "time": 12800.07, "timestamp": "03:33:20", "text": "56%的勘探和63%的动荡"}, {"type": "subtitle", "time": 12802.71, "timestamp": "03:33:22", "text": "或者别的什么。所以这意味着当我阅读时"}, {"type": "subtitle", "time": 12806.229, "timestamp": "03:33:26", "text": "这整个细节是什么，我的"}, {"type": "subtitle", "time": 12808.87, "timestamp": "03:33:28", "text": "它既是我的优势，也是我的弱点。"}, {"type": "subtitle", "time": 12812.389, "timestamp": "03:33:32", "text": "感觉好像有人了解我，知道我是怎样的人。"}, {"type": "subtitle", "time": 12815.63, "timestamp": "03:33:35", "text": "我写了什么之类的。它是"}, {"type": "subtitle", "time": 12824.15, "timestamp": "03:33:44", "text": "这里。是的。比如你的力量，"}, {"type": "subtitle", "time": 12826.469, "timestamp": "03:33:46", "text": "个人价值观，以及你在这方面的表现"}, {"type": "subtitle", "time": 12829.11, "timestamp": "03:33:49", "text": "人际关系，你最近怎么样？"}, {"type": "subtitle", "time": 12831.63, "timestamp": "03:33:51", "text": "精神上、身体上等等。所有这些"}, {"type": "subtitle", "time": 12834.55, "timestamp": "03:33:54", "text": "诸如你的职业发展道路之类的事情"}, {"type": "subtitle", "time": 12838.44, "timestamp": "03:33:58", "text": "等等。喜欢那种酷的感觉。"}]
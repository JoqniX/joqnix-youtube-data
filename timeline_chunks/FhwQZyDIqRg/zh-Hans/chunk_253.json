[{"type": "subtitle", "time": 15181.429, "timestamp": "04:13:01", "text": "让我真的做点什么来惹恼我"}, {"type": "subtitle", "time": 15184.469, "timestamp": "04:13:04", "text": "让我下台。所以，不。我不同意。喜欢"}, {"type": "subtitle", "time": 15186.95, "timestamp": "04:13:06", "text": "三级人员不同意。你无法改变"}, {"type": "subtitle", "time": 15189.75, "timestamp": "04:13:09", "text": "我的心情。至少不会那么快。"}, {"type": "subtitle", "time": 15191.99, "timestamp": "04:13:11", "text": "除非你喜欢像身体对抗那样的打击。"}, {"type": "subtitle", "time": 15196.91, "timestamp": "04:13:16", "text": "他打了我。嗯。在此之前，"}, {"type": "subtitle", "time": 15199.55, "timestamp": "04:13:19", "text": "不。"}, {"type": "subtitle", "time": 15202.55, "timestamp": "04:13:22", "text": "不同意。你知道吗？我可以改变"}, {"type": "subtitle", "time": 15206.59, "timestamp": "04:13:26", "text": "情绪变化很快。某些情况下的H"}, {"type": "subtitle", "time": 15210.469, "timestamp": "04:13:30", "text": "地点。你知道吗？我要走了"}, {"type": "subtitle", "time": 15213.189, "timestamp": "04:13:33", "text": "一级丑陋"}, {"type": "subtitle", "time": 15216.63, "timestamp": "04:13:36", "text": "有时。更像是你要去"}, {"type": "subtitle", "time": 15220.87, "timestamp": "04:13:40", "text": "情绪波动很大，从精力充沛到悲伤等等。"}, {"type": "subtitle", "time": 15223.99, "timestamp": "04:13:43", "text": "你……呃，我还没到那儿呢。或许这一切都是真的"}, {"type": "subtitle", "time": 15225.75, "timestamp": "04:13:45", "text": "随机化。并非一切都如此，并非如此"}, {"type": "subtitle", "time": 15228.309, "timestamp": "04:13:48", "text": "就像一张薄薄的纸。我认为我们"}, {"type": "subtitle", "time": 15233.11, "timestamp": "04:13:53", "text": "收到的问题杂乱无章。是的。"}, {"type": "subtitle", "time": 15235.269, "timestamp": "04:13:55", "text": "好的。下一个问题是，你不是"}, {"type": "subtitle", "time": 15237.309, "timestamp": "04:13:57", "text": "容易受情绪影响"}, {"type": "subtitle", "time": 15239.429, "timestamp": "04:13:59", "text": "论点。你不会被情绪左右"}]
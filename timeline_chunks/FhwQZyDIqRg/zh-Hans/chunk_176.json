[{"type": "subtitle", "time": 10562.55, "timestamp": "02:56:02", "text": "你为什么唱得这么像？"}, {"type": "subtitle", "time": 10566.63, "timestamp": "02:56:06", "text": "是《狮子王》里的合唱团吗？"}, {"type": "subtitle", "time": 10575.23, "timestamp": "02:56:15", "text": "哦"}, {"type": "subtitle", "time": 10577.15, "timestamp": "02:56:17", "text": "射击。"}, {"type": "subtitle", "time": 10589.429, "timestamp": "02:56:29", "text": "哦不，是汤米。妈的，兄弟。那是"}, {"type": "subtitle", "time": 10591.59, "timestamp": "02:56:31", "text": "我们能坚持的最长时间。不错，兄弟。"}, {"type": "subtitle", "time": 10593.95, "timestamp": "02:56:33", "text": "事实上，我为自己感到非常自豪。"}, {"type": "subtitle", "time": 10596.71, "timestamp": "02:56:36", "text": "今天。我的天哪。等等，各位。"}, {"type": "subtitle", "time": 10598.55, "timestamp": "02:56:38", "text": "这是激光。他们该如何……"}, {"type": "subtitle", "time": 10600.75, "timestamp": "02:56:40", "text": "和他们在一起安全吗？哦，我的天"}, {"type": "subtitle", "time": 10604.15, "timestamp": "02:56:44", "text": "上帝。它没看见它们。哦，她死了。"}, {"type": "subtitle", "time": 10605.51, "timestamp": "02:56:45", "text": "他们死了。他们死了。他们是"}, {"type": "subtitle", "time": 10607.91, "timestamp": "02:56:47", "text": "死的。他们死了。妈的，兄弟。我们都是"}, {"type": "subtitle", "time": 10611.91, "timestamp": "02:56:51", "text": "死的。哇。你应该……你为什么上床？"}, {"type": "subtitle", "time": 10613.83, "timestamp": "02:56:53", "text": "我勒个去？"}, {"type": "subtitle", "time": 10615.91, "timestamp": "02:56:55", "text": "为什么？"}, {"type": "subtitle", "time": 10617.91, "timestamp": "02:56:57", "text": "我当时躲在柱子后面。我"}, {"type": "subtitle", "time": 10619.91, "timestamp": "02:56:59", "text": "它躲在柱子后面，而且"}]
[{"type": "subtitle", "time": 9660.55, "timestamp": "02:41:00", "text": "做得不错。我们做得很好。我的经验值很高。"}, {"type": "subtitle", "time": 9667.27, "timestamp": "02:41:07", "text": "哇。"}, {"type": "subtitle", "time": 9669.27, "timestamp": "02:41:09", "text": "我可以用霰弹枪干掉某人吗？我很乐意"}, {"type": "subtitle", "time": 9670.87, "timestamp": "02:41:10", "text": "射击"}, {"type": "subtitle", "time": 9675.429, "timestamp": "02:41:15", "text": "不。"}, {"type": "subtitle", "time": 9678.389, "timestamp": "02:41:18", "text": "纳茨基，我给你准备了一份礼物。"}, {"type": "subtitle", "time": 9681.11, "timestamp": "02:41:21", "text": "那是什么？像手榴弹一样被吸进去。我想"}, {"type": "subtitle", "time": 9683.91, "timestamp": "02:41:23", "text": "一种速度。好的，等等。好的，稍等。"}, {"type": "subtitle", "time": 9687.429, "timestamp": "02:41:27", "text": "我们是否做得更多了？我以为这是"}, {"type": "subtitle", "time": 9689.19, "timestamp": "02:41:29", "text": "我的意思是，我们赢了。如果我们死了，我们就会……"}, {"type": "subtitle", "time": 9691.67, "timestamp": "02:41:31", "text": "走了。好的，我们去试试。你玩"}, {"type": "subtitle", "time": 9694.79, "timestamp": "02:41:34", "text": "直到我们死去。我不知道。"}, {"type": "subtitle", "time": 9696.309, "timestamp": "02:41:36", "text": "你好。"}, {"type": "subtitle", "time": 9699.83, "timestamp": "02:41:39", "text": "好的，我的。我们去找找我的那一个。"}, {"type": "subtitle", "time": 9701.67, "timestamp": "02:41:41", "text": "所以，如果你有100个，你还能有更多吗？"}, {"type": "subtitle", "time": 9705.51, "timestamp": "02:41:45", "text": "超过100？也是真的吗？"}, {"type": "subtitle", "time": 9708.07, "timestamp": "02:41:48", "text": "或者我们就坚持用100。我们可以这样吗？"}, {"type": "subtitle", "time": 9709.99, "timestamp": "02:41:49", "text": "超过100个？是的。是的，你需要"}, {"type": "subtitle", "time": 9711.99, "timestamp": "02:41:51", "text": "获取升级。"}, {"type": "subtitle", "time": 9714.389, "timestamp": "02:41:54", "text": "健康提升。升级。好的。是的。我"}, {"type": "subtitle", "time": 9715.67, "timestamp": "02:41:55", "text": "不知道有健康升级这回事。我"}, {"type": "subtitle", "time": 9718.469, "timestamp": "02:41:58", "text": "刚才看到了他们的耐力和力量。嗯。"}]
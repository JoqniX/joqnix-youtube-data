[{"type": "subtitle", "time": 8341.75, "timestamp": "02:19:01", "text": "等等，等等，等等。坚持，稍等。"}, {"type": "subtitle", "time": 8342.429, "timestamp": "02:19:02", "text": "什么"}, {"type": "subtitle", "time": 8345.11, "timestamp": "02:19:05", "text": "如果像那样，多样性如此之高"}, {"type": "subtitle", "time": 8346.549, "timestamp": "02:19:06", "text": "印度？我知道他要去哪里。我知道"}, {"type": "subtitle", "time": 8347.75, "timestamp": "02:19:07", "text": "他要去的地方。我说如果有人"}, {"type": "subtitle", "time": 8349.509, "timestamp": "02:19:09", "text": "不看动漫的人是……"}, {"type": "subtitle", "time": 8350.95, "timestamp": "02:19:10", "text": "穿着动漫T恤？已退出。不，"}, {"type": "subtitle", "time": 8353.27, "timestamp": "02:19:13", "text": "不，不，不。不是那样。不是那样。好的。我"}, {"type": "subtitle", "time": 8355.11, "timestamp": "02:19:15", "text": "关于这件事，我还有另一个故事。好的。我"}, {"type": "subtitle", "time": 8357.03, "timestamp": "02:19:17", "text": "我看到过一个小孩。他站着"}, {"type": "subtitle", "time": 8360.629, "timestamp": "02:19:20", "text": "他在学校外面穿着……"}, {"type": "subtitle", "time": 8362.389, "timestamp": "02:19:22", "text": "那些连帽衫。你知道，眼睛"}, {"type": "subtitle", "time": 8365.469, "timestamp": "02:19:25", "text": "连帽衫。是的。在他面前"}, {"type": "subtitle", "time": 8368.79, "timestamp": "02:19:28", "text": "学校到学校。好的。你应该"}, {"type": "subtitle", "time": 8372.95, "timestamp": "02:19:32", "text": "对那样的人？我的意思是说"}, {"type": "subtitle", "time": 8375.99, "timestamp": "02:19:35", "text": "我对此无可奉告。"}, {"type": "subtitle", "time": 8377.91, "timestamp": "02:19:37", "text": "那东西是我两个兄弟的。我"}, {"type": "subtitle", "time": 8381.79, "timestamp": "02:19:41", "text": "我什么都说不出来。上帝。我的天哪。我"}, {"type": "subtitle", "time": 8385.27, "timestamp": "02:19:45", "text": "意思是，他们就是这些人。我认为"}, {"type": "subtitle", "time": 8387.75, "timestamp": "02:19:47", "text": "那是他们的。不，我是一个"}, {"type": "subtitle", "time": 8390.23, "timestamp": "02:19:50", "text": "他真的穿着T恤衫去上班。我是"}, {"type": "subtitle", "time": 8393.349, "timestamp": "02:19:53", "text": "我确实有，那是我的，那是我的"}, {"type": "subtitle", "time": 8395.349, "timestamp": "02:19:55", "text": "那是我的制服。我拥有就像我拥有"}, {"type": "subtitle", "time": 8397.71, "timestamp": "02:19:57", "text": "我的衣柜里没有别的了"}, {"type": "subtitle", "time": 8399.91, "timestamp": "02:19:59", "text": "除了我身上的动漫T恤之外，我"}]
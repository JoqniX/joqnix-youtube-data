[{"type": "subtitle", "time": 13020.75, "timestamp": "03:37:00", "text": "被允许"}, {"type": "subtitle", "time": 13023.55, "timestamp": "03:37:03", "text": "一个人，所以是的"}, {"type": "subtitle", "time": 13027.0, "timestamp": "03:37:07", "text": "不同意你通常感觉更多"}, {"type": "subtitle", "time": 13028.55, "timestamp": "03:37:08", "text": "[音乐]"}, {"type": "subtitle", "time": 13041.79, "timestamp": "03:37:21", "text": "我不这么认为"}, {"type": "subtitle", "time": 13048.99, "timestamp": "03:37:28", "text": "给你"}, {"type": "subtitle", "time": 13059.67, "timestamp": "03:37:39", "text": "好的。问题是我不做"}, {"type": "subtitle", "time": 13061.71, "timestamp": "03:37:41", "text": "不喜欢清理它"}, {"type": "subtitle", "time": 13066.51, "timestamp": "03:37:46", "text": "虽然有点执着，但我会，我会保留它"}, {"type": "subtitle", "time": 13071.71, "timestamp": "03:37:51", "text": "虽然很干净，但我总有一天会把它扔掉的。我"}, {"type": "subtitle", "time": 13074.67, "timestamp": "03:37:54", "text": "真是见鬼了"}, {"type": "subtitle", "time": 13078.11, "timestamp": "03:37:58", "text": "肮脏的。所以我不是那种人"}]
[{"type": "subtitle", "time": 6304.229, "timestamp": "01:45:04", "text": "哦，万一发生什么事的话。什么"}, {"type": "subtitle", "time": 6305.75, "timestamp": "01:45:05", "text": "发生了吗？发生了什么？发生了什么？"}, {"type": "subtitle", "time": 6307.35, "timestamp": "01:45:07", "text": "看看你的HP。你"}, {"type": "subtitle", "time": 6309.27, "timestamp": "01:45:09", "text": "爆炸了。还是一样。"}, {"type": "subtitle", "time": 6311.83, "timestamp": "01:45:11", "text": "没关系。"}, {"type": "subtitle", "time": 6314.149, "timestamp": "01:45:14", "text": "这是个骗局。我们去取夏树的头颅。"}, {"type": "subtitle", "time": 6317.149, "timestamp": "01:45:17", "text": "脱离其中。他怎么敢撒谎？"}, {"type": "subtitle", "time": 6319.43, "timestamp": "01:45:19", "text": "确切地。把他的头伸进那个东西里。"}, {"type": "subtitle", "time": 6321.75, "timestamp": "01:45:21", "text": "实际上，"}, {"type": "subtitle", "time": 6325.189, "timestamp": "01:45:25", "text": "不用担心。不行。我开玩笑的。"}, {"type": "subtitle", "time": 6328.87, "timestamp": "01:45:28", "text": "我们会帮助你。哦，这里有酒精饮料"}, {"type": "subtitle", "time": 6340.39, "timestamp": "01:45:40", "text": "哇。"}, {"type": "subtitle", "time": 6356.07, "timestamp": "01:45:56", "text": "我周围有人吗？有人能帮帮我吗？"}, {"type": "subtitle", "time": 6359.109, "timestamp": "01:45:59", "text": "和"}]
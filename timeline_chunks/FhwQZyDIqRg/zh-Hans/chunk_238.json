[{"type": "subtitle", "time": 14281.03, "timestamp": "03:58:01", "text": "查一下，因为我非常确定我是"}, {"type": "subtitle", "time": 14282.63, "timestamp": "03:58:02", "text": "我几乎可以肯定我没有时间。所以，"}, {"type": "subtitle", "time": 14286.309, "timestamp": "03:58:06", "text": "我打算直接问问那个运动员。"}, {"type": "subtitle", "time": 14288.63, "timestamp": "03:58:08", "text": "是的，我在这里。"}, {"type": "subtitle", "time": 14290.71, "timestamp": "03:58:10", "text": "是的。所以，这就是你如何做到的。"}, {"type": "subtitle", "time": 14292.71, "timestamp": "03:58:12", "text": "正在做？我一切都很好。你好吗？"}, {"type": "subtitle", "time": 14294.87, "timestamp": "03:58:14", "text": "我可能会寻求帮助。我们正在努力"}, {"type": "subtitle", "time": 14296.189, "timestamp": "03:58:16", "text": "要做"}, {"type": "subtitle", "time": 14300.15, "timestamp": "03:58:20", "text": "主动寻找，对吧？是的。"}, {"type": "subtitle", "time": 14302.87, "timestamp": "03:58:22", "text": "我不会主动去寻找任何东西。我"}, {"type": "subtitle", "time": 14304.55, "timestamp": "03:58:24", "text": "可能喜欢被动地寻找"}, {"type": "subtitle", "time": 14310.63, "timestamp": "03:58:30", "text": "你很容易担心各种事情。"}, {"type": "subtitle", "time": 14313.269, "timestamp": "03:58:33", "text": "情况可能会恶化。难道不是吗？"}, {"type": "subtitle", "time": 14315.51, "timestamp": "03:58:35", "text": "全部？那不就是吗？那不就是吗？"}, {"type": "chat", "time": 14317.705, "timestamp": "03:58:37", "author": "@DinyoFoxy", "avatar": "https://yt4.ggpht.com/DGXvUKi0q0ld5Zo5CNG2tmulZfZqg_h6ivQHLtQfKyx-z_EjHr-Bx7limqyg4JtpZ00_XP_BTQ=s64-c-k-c0x00ffffff-no-rj", "message": "glad to hear you doing great"}, {"type": "subtitle", "time": 14322.309, "timestamp": "03:58:42", "text": "就像你很容易焦虑一样。我不是"}, {"type": "subtitle", "time": 14324.63, "timestamp": "03:58:44", "text": "我没有俯卧。"}, {"type": "subtitle", "time": 14326.75, "timestamp": "03:58:46", "text": "我不是那种"}, {"type": "subtitle", "time": 14329.349, "timestamp": "03:58:49", "text": "忧虑者。但俯卧的意思就像你得到"}, {"type": "subtitle", "time": 14332.63, "timestamp": "03:58:52", "text": "感觉轻松多了。"}, {"type": "subtitle", "time": 14335.51, "timestamp": "03:58:55", "text": "你可以像往常一样轻松获得它"}, {"type": "subtitle", "time": 14338.63, "timestamp": "03:58:58", "text": "担心诸如此类的事情。你总是"}]
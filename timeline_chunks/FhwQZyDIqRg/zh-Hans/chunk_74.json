[{"type": "subtitle", "time": 4443.11, "timestamp": "01:14:03", "text": "不，我不同意。哦，他现在很脏。谁想要"}, {"type": "subtitle", "time": 4445.43, "timestamp": "01:14:05", "text": "要上去吗？快点。我想推动"}, {"type": "subtitle", "time": 4453.91, "timestamp": "01:14:13", "text": "等等，等等。请到中心告诉我们。做"}, {"type": "subtitle", "time": 4458.229, "timestamp": "01:14:18", "text": "它。开门。开门。"}, {"type": "subtitle", "time": 4462.31, "timestamp": "01:14:22", "text": "我们走吧。我做不到。你被困住了。"}, {"type": "subtitle", "time": 4467.03, "timestamp": "01:14:27", "text": "呃，跳起来然后松手。不，你不是。我们开始吧"}, {"type": "subtitle", "time": 4468.55, "timestamp": "01:14:28", "text": "去。"}, {"type": "subtitle", "time": 4470.149, "timestamp": "01:14:30", "text": "好的。好的。好的。最后，"}, {"type": "subtitle", "time": 4472.55, "timestamp": "01:14:32", "text": "请把我放上去吧。谢谢。"}, {"type": "subtitle", "time": 4478.709, "timestamp": "01:14:38", "text": "我不能。好的，我已经到了。"}, {"type": "subtitle", "time": 4483.51, "timestamp": "01:14:43", "text": "最后。不，不，不。去。我摔倒了。"}, {"type": "subtitle", "time": 4486.47, "timestamp": "01:14:46", "text": "我的天哪。我把手榴弹扔掉了。"}, {"type": "subtitle", "time": 4490.31, "timestamp": "01:14:50", "text": "等等，放我走。没做爱。哎呀。"}, {"type": "subtitle", "time": 4492.229, "timestamp": "01:14:52", "text": "哦，等等。哎呀。我要去。我要去。"}, {"type": "subtitle", "time": 4495.189, "timestamp": "01:14:55", "text": "我需要像垃圾桶一样倾倒。好的。这真是太"}, {"type": "subtitle", "time": 4498.07, "timestamp": "01:14:58", "text": "难的。是的，这真的非常难。"}]
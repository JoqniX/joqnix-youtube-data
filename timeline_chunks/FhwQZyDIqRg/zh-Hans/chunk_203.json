[{"type": "subtitle", "time": 12180.71, "timestamp": "03:23:00", "text": "是的，即便如此，我还是这么做了。"}, {"type": "subtitle", "time": 12182.59, "timestamp": "03:23:02", "text": "七年先生"}, {"type": "subtitle", "time": 12185.67, "timestamp": "03:23:05", "text": "辛。我这么说对吗？辛。我"}, {"type": "subtitle", "time": 12190.07, "timestamp": "03:23:10", "text": "希望。嘘。对不起，兄弟。"}, {"type": "subtitle", "time": 12196.15, "timestamp": "03:23:16", "text": "你知道吗？没关系。我不去"}, {"type": "subtitle", "time": 12198.389, "timestamp": "03:23:18", "text": "这么说吧。"}, {"type": "subtitle", "time": 12201.11, "timestamp": "03:23:21", "text": "是我听错了吗？还是你的声音越来越大了？"}, {"type": "subtitle", "time": 12204.469, "timestamp": "03:23:24", "text": "每隔一段时间就随机打断一次？它是"}, {"type": "subtitle", "time": 12205.79, "timestamp": "03:23:25", "text": "越来越像"}, {"type": "subtitle", "time": 12209.51, "timestamp": "03:23:29", "text": "停止。真奇怪。哦真的吗？我"}, {"type": "subtitle", "time": 12212.99, "timestamp": "03:23:32", "text": "不知道。或许。"}, {"type": "subtitle", "time": 12221.67, "timestamp": "03:23:41", "text": "嘘声一片。是的，至少我的 OBS 是"}, {"type": "subtitle", "time": 12226.229, "timestamp": "03:23:46", "text": "抓住它，这样我才能看到它。在"}, {"type": "subtitle", "time": 12233.309, "timestamp": "03:23:53", "text": "我。"}, {"type": "subtitle", "time": 12238.309, "timestamp": "03:23:58", "text": "总之，2怎么样？"}, {"type": "subtitle", "time": 12239.99, "timestamp": "03:23:59", "text": "H"}]
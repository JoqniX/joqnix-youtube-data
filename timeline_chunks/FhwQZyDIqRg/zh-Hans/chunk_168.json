[{"type": "subtitle", "time": 10082.03, "timestamp": "02:48:02", "text": "可以看到"}, {"type": "subtitle", "time": 10085.99, "timestamp": "02:48:05", "text": "所有人。好吧，奈月死了。"}, {"type": "subtitle", "time": 10091.67, "timestamp": "02:48:11", "text": "夏树死了。或者我看到一个红色的标记。"}, {"type": "subtitle", "time": 10094.23, "timestamp": "02:48:14", "text": "嘿，那边那位。你来了"}, {"type": "subtitle", "time": 10097.51, "timestamp": "02:48:17", "text": "这些部分经常。我叫雪儿。所以"}, {"type": "subtitle", "time": 10100.55, "timestamp": "02:48:20", "text": "六月，你休想通过。不可"}, {"type": "subtitle", "time": 10102.309, "timestamp": "02:48:22", "text": "穿过我的领地。哦，我发现了"}, {"type": "subtitle", "time": 10105.99, "timestamp": "02:48:25", "text": "萃取。嘿，你们撤离点。"}, {"type": "subtitle", "time": 10108.55, "timestamp": "02:48:28", "text": "当然。如果我的麦克风是开着的，那就是"}, {"type": "subtitle", "time": 10111.349, "timestamp": "02:48:31", "text": "正是如此。"}, {"type": "subtitle", "time": 10116.03, "timestamp": "02:48:36", "text": "你是什​​么意思？出去。哦，哇。"}, {"type": "subtitle", "time": 10120.63, "timestamp": "02:48:40", "text": "耶。哇。好吧，我要逃跑了。"}, {"type": "subtitle", "time": 10122.63, "timestamp": "02:48:42", "text": "为什么？哦，是的。我们回去吧。那就是"}, {"type": "subtitle", "time": 10124.309, "timestamp": "02:48:44", "text": "第二个。"}, {"type": "subtitle", "time": 10126.63, "timestamp": "02:48:46", "text": "哦，我们得回卡车去了。"}, {"type": "subtitle", "time": 10132.309, "timestamp": "02:48:52", "text": "是的。是的。是的。是的。是的。好的。"}, {"type": "subtitle", "time": 10135.349, "timestamp": "02:48:55", "text": "天哪，我竟然看不见恶魔。"}, {"type": "subtitle", "time": 10136.59, "timestamp": "02:48:56", "text": "真他妈的。"}, {"type": "subtitle", "time": 10139.269, "timestamp": "02:48:59", "text": "为什么？你为什么对看这个感兴趣"}]
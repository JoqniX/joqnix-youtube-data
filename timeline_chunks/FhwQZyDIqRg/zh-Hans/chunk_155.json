[{"type": "subtitle", "time": 9301.75, "timestamp": "02:35:01", "text": "是的。就在那部动画里。不。啊，"}, {"type": "subtitle", "time": 9304.87, "timestamp": "02:35:04", "text": "有什么东西。"}, {"type": "subtitle", "time": 9307.51, "timestamp": "02:35:07", "text": "快跑，伙计们。跑步。我勒个去？帮助。"}, {"type": "subtitle", "time": 9311.75, "timestamp": "02:35:11", "text": "帮我。跑步。跑步。我能帮您什么忙？"}, {"type": "subtitle", "time": 9313.349, "timestamp": "02:35:13", "text": "对你一点帮助都没有。让开。"}, {"type": "subtitle", "time": 9315.59, "timestamp": "02:35:15", "text": "等等，我能帮您什么吗？我该如何帮忙？"}, {"type": "subtitle", "time": 9324.87, "timestamp": "02:35:24", "text": "[音乐]"}, {"type": "subtitle", "time": 9327.67, "timestamp": "02:35:27", "text": "是拿霰弹枪的那家伙。"}, {"type": "subtitle", "time": 9331.99, "timestamp": "02:35:31", "text": "是什么？持霰弹枪的家伙。"}, {"type": "subtitle", "time": 9337.75, "timestamp": "02:35:37", "text": "你好。滚开。滚开，你这混蛋。"}, {"type": "subtitle", "time": 9340.95, "timestamp": "02:35:40", "text": "我可以参与这个吗？"}, {"type": "subtitle", "time": 9344.55, "timestamp": "02:35:44", "text": "我们结束了吗？不过我反应比较慢。我不是"}, {"type": "subtitle", "time": 9347.27, "timestamp": "02:35:47", "text": "好了，伙计们，我已经找到女朋友了。所以，他是"}, {"type": "subtitle", "time": 9349.19, "timestamp": "02:35:49", "text": "字面上地"}, {"type": "subtitle", "time": 9352.55, "timestamp": "02:35:52", "text": "我想吐在他身上。"}, {"type": "subtitle", "time": 9355.75, "timestamp": "02:35:55", "text": "别那样做。"}, {"type": "subtitle", "time": 9358.15, "timestamp": "02:35:58", "text": "你好。哦。"}]
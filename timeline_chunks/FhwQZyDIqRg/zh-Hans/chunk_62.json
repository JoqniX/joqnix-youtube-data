[{"type": "subtitle", "time": 3720.309, "timestamp": "01:02:00", "text": "正被我们的头脑所掌控。是的，"}, {"type": "subtitle", "time": 3722.549, "timestamp": "01:02:02", "text": "那些家伙。他就是那种人"}, {"type": "subtitle", "time": 3725.109, "timestamp": "01:02:05", "text": "那鬼魂就像刚刚破碎一样"}, {"type": "subtitle", "time": 3727.99, "timestamp": "01:02:07", "text": "我们拥有的一切。是的，那就是安德。"}, {"type": "subtitle", "time": 3729.27, "timestamp": "01:02:09", "text": "你知道那是什么吗？我没有"}, {"type": "subtitle", "time": 3732.39, "timestamp": "01:02:12", "text": "甚至不知道我当时在哪里。所以，我就想"}, {"type": "subtitle", "time": 3734.15, "timestamp": "01:02:14", "text": "我当时正蹲着。这是一个箱子，"}, {"type": "subtitle", "time": 3737.109, "timestamp": "01:02:17", "text": "正确的？打开它，哦。"}, {"type": "subtitle", "time": 3740.63, "timestamp": "01:02:20", "text": "等等，其实我以为我逃脱了。"}, {"type": "subtitle", "time": 3744.63, "timestamp": "01:02:24", "text": "从中。只需激光即可。妈的。"}, {"type": "subtitle", "time": 3752.309, "timestamp": "01:02:32", "text": "想得美，结果害我送了命。"}, {"type": "subtitle", "time": 3755.589, "timestamp": "01:02:35", "text": "我们是怎么接受激光治疗的？在前面等候"}, {"type": "subtitle", "time": 3758.87, "timestamp": "01:02:38", "text": "我，兄弟。他开枪打了我。是奈须木"}, {"type": "subtitle", "time": 3761.109, "timestamp": "01:02:41", "text": "在箱子里面。"}, {"type": "subtitle", "time": 3763.67, "timestamp": "01:02:43", "text": "是的，"}, {"type": "subtitle", "time": 3764.95, "timestamp": "01:02:44", "text": "他死了。他应该躲起来。他应该"}, {"type": "subtitle", "time": 3767.109, "timestamp": "01:02:47", "text": "隐藏。你应该躲起来等死。你"}, {"type": "subtitle", "time": 3770.789, "timestamp": "01:02:50", "text": "应该躲起来。笨蛋。哦，该死。哦，我的天"}, {"type": "subtitle", "time": 3778.47, "timestamp": "01:02:58", "text": "兄弟。我回头一看，他……"}]
[{"type": "subtitle", "time": 11945.349, "timestamp": "03:19:05", "text": "发生了。哦，天哪，很多人都在做"}, {"type": "subtitle", "time": 11948.67, "timestamp": "03:19:08", "text": "男人。我希望我能拿到我的新钱。"}, {"type": "subtitle", "time": 11952.309, "timestamp": "03:19:12", "text": "向上。这需要很长时间。先生。"}, {"type": "subtitle", "time": 11957.83, "timestamp": "03:19:17", "text": "Jnix先生，我会让你知道我花了多少时间。"}, {"type": "subtitle", "time": 11961.11, "timestamp": "03:19:21", "text": "大概有5000左右。你花的钱"}, {"type": "subtitle", "time": 11963.83, "timestamp": "03:19:23", "text": "大约五点，"}, {"type": "subtitle", "time": 11971.91, "timestamp": "03:19:31", "text": "谢谢你的来电。你就像，"}, {"type": "subtitle", "time": 11974.63, "timestamp": "03:19:34", "text": "你简直是个完美主义者。我是"}, {"type": "subtitle", "time": 11976.87, "timestamp": "03:19:36", "text": "就像你一样。"}, {"type": "subtitle", "time": 11979.83, "timestamp": "03:19:39", "text": "是的。问题不在于我有时讨厌"}, {"type": "subtitle", "time": 11982.389, "timestamp": "03:19:42", "text": "保持专业精神。它会毁了你"}, {"type": "subtitle", "time": 11984.309, "timestamp": "03:19:44", "text": "太多了。而你，当谈到……"}, {"type": "chat", "time": 11986.017, "timestamp": "03:19:46", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "HOW MUCH—?"}, {"type": "subtitle", "time": 11987.11, "timestamp": "03:19:47", "text": "YouTube 和专业精神，就像"}, {"type": "subtitle", "time": 11989.19, "timestamp": "03:19:49", "text": "你需要很多钱才能得到那个"}, {"type": "subtitle", "time": 11993.91, "timestamp": "03:19:53", "text": "地方。太过分了。是的。是的。好的。"}, {"type": "subtitle", "time": 11996.19, "timestamp": "03:19:56", "text": "对了，杰奎先生，我"}]
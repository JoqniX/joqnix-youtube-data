[{"type": "subtitle", "time": 15601.95, "timestamp": "04:20:01", "text": "顺便提一下，这是伦理困境。所以我会去"}, {"type": "subtitle", "time": 15605.59, "timestamp": "04:20:05", "text": "难度可能比较高，第二级可能不同意。未达到水平"}, {"type": "subtitle", "time": 15607.75, "timestamp": "04:20:07", "text": "三个人不同意，因为我一无所知"}, {"type": "subtitle", "time": 15610.07, "timestamp": "04:20:10", "text": "这些人都在说什么？"}, {"type": "subtitle", "time": 15613.389, "timestamp": "04:20:13", "text": "享受道德困境。但我们走吧"}, {"type": "subtitle", "time": 15617.91, "timestamp": "04:20:17", "text": "请翻到下一页。我对先生有50%的信心。"}, {"type": "subtitle", "time": 15621.11, "timestamp": "04:20:21", "text": "Shokunix。是啊，我也是。"}, {"type": "subtitle", "time": 15623.79, "timestamp": "04:20:23", "text": "好的。你通常更喜欢待在……"}, {"type": "subtitle", "time": 15627.269, "timestamp": "04:20:27", "text": "与其他伙伴合作，而不是独自一人。呃"}, {"type": "subtitle", "time": 15631.75, "timestamp": "04:20:31", "text": "通常我更喜欢同意，意​​思是像我一样。"}, {"type": "subtitle", "time": 15634.87, "timestamp": "04:20:34", "text": "好吧，我不同意。我通常"}, {"type": "subtitle", "time": 15637.189, "timestamp": "04:20:37", "text": "想一个人待着。"}, {"type": "subtitle", "time": 15639.59, "timestamp": "04:20:39", "text": "相同的。我不会，我不会，我不会那样做"}, {"type": "subtitle", "time": 15642.55, "timestamp": "04:20:42", "text": "难度为三级。可能是二级"}, {"type": "subtitle", "time": 15645.03, "timestamp": "04:20:45", "text": "因为我不介意有人陪伴。就像我"}, {"type": "subtitle", "time": 15647.83, "timestamp": "04:20:47", "text": "我不介意有朋友陪着我，但是"}, {"type": "subtitle", "time": 15649.99, "timestamp": "04:20:49", "text": "我觉得我应该不是那种爱参加派对的人。你"}, {"type": "subtitle", "time": 15654.429, "timestamp": "04:20:54", "text": "你明白我的意思吗？是的。是的。二级"}, {"type": "subtitle", "time": 15656.95, "timestamp": "04:20:56", "text": "不同意。你感到无聊或迷路了。"}]
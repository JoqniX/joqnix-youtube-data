[{"type": "subtitle", "time": 3902.109, "timestamp": "01:05:02", "text": "我们又回来了。他只是，他只是"}, {"type": "subtitle", "time": 3904.789, "timestamp": "01:05:04", "text": "是的，要一步一步来。哦，她是"}, {"type": "subtitle", "time": 3905.95, "timestamp": "01:05:05", "text": "穿着"}, {"type": "subtitle", "time": 3909.91, "timestamp": "01:05:09", "text": "皇冠 皇冠。哇。"}, {"type": "subtitle", "time": 3913.43, "timestamp": "01:05:13", "text": "是的。我的天啊。我的天哪。我们是否应该"}, {"type": "subtitle", "time": 3915.27, "timestamp": "01:05:15", "text": "有没有前进的策略？库兹"}, {"type": "subtitle", "time": 3916.63, "timestamp": "01:05:16", "text": "就好像我们看起来好像根本不是那样"}, {"type": "subtitle", "time": 3918.069, "timestamp": "01:05:18", "text": "知道我们要去哪里。我认为我们"}, {"type": "subtitle", "time": 3919.829, "timestamp": "01:05:19", "text": "我们应该做的就是聚集在一起"}, {"type": "subtitle", "time": 3922.23, "timestamp": "01:05:22", "text": "带够钱，然后去体验。"}, {"type": "subtitle", "time": 3924.309, "timestamp": "01:05:24", "text": "是的。是的。好主意。好主意。我当时"}, {"type": "subtitle", "time": 3925.91, "timestamp": "01:05:25", "text": "告诉你们，你们没有"}, {"type": "subtitle", "time": 3930.39, "timestamp": "01:05:30", "text": "听。是的。是的。你害死了我。"}, {"type": "subtitle", "time": 3932.87, "timestamp": "01:05:32", "text": "我的错，兄弟。"}, {"type": "subtitle", "time": 3936.87, "timestamp": "01:05:36", "text": "我的意思是，就我个人而言，我并没有这么想。"}, {"type": "subtitle", "time": 3938.71, "timestamp": "01:05:38", "text": "他会直接凭空出现。我知道"}, {"type": "subtitle", "time": 3941.349, "timestamp": "01:05:41", "text": "嗯，我知道它的后代。我以为他"}, {"type": "subtitle", "time": 3944.63, "timestamp": "01:05:44", "text": "已经在那里了。你我都称之为"}, {"type": "subtitle", "time": 3947.23, "timestamp": "01:05:47", "text": "出去。我当面指出来了，"}, {"type": "subtitle", "time": 3950.43, "timestamp": "01:05:50", "text": "伙计们。快点。是的。我记得暴民"}, {"type": "subtitle", "time": 3954.069, "timestamp": "01:05:54", "text": "我当时在哪儿？我是说，我不知道我当时在哪儿。"}, {"type": "subtitle", "time": 3955.99, "timestamp": "01:05:55", "text": "所以我就蹲了下来，我没有"}, {"type": "subtitle", "time": 3957.67, "timestamp": "01:05:57", "text": "要知道，如果你要上……"}, {"type": "subtitle", "time": 3959.109, "timestamp": "01:05:59", "text": "如果你坐在沙发上，你能蹲下吗？"}]
[{"type": "subtitle", "time": 4141.829, "timestamp": "01:09:01", "text": "我的天啊。"}, {"type": "subtitle", "time": 4146.149, "timestamp": "01:09:06", "text": "看，吉玛的眼睛。"}, {"type": "subtitle", "time": 4154.46, "timestamp": "01:09:14", "text": "好的。是的。你试过吗？你试过吗？"}, {"type": "subtitle", "time": 4155.749, "timestamp": "01:09:15", "text": "[音乐]"}, {"type": "subtitle", "time": 4162.39, "timestamp": "01:09:22", "text": "正在尝试。为什么？你为什么笑得这么开心？"}, {"type": "subtitle", "time": 4165.99, "timestamp": "01:09:25", "text": "那？发生了什么？发生了什么？"}, {"type": "subtitle", "time": 4169.349, "timestamp": "01:09:29", "text": "哟，这是什么？什么？发生了什么？"}, {"type": "subtitle", "time": 4185.269, "timestamp": "01:09:45", "text": "好的。那辆车。人都去哪儿了？"}, {"type": "subtitle", "time": 4187.43, "timestamp": "01:09:47", "text": "你好。好的。之后，我将携带"}, {"type": "subtitle", "time": 4191.03, "timestamp": "01:09:51", "text": "把牌拿走。 H. 所以我们可以得到芝诺"}, {"type": "subtitle", "time": 4192.269, "timestamp": "01:09:52", "text": "后退。"}, {"type": "subtitle", "time": 4195.91, "timestamp": "01:09:55", "text": "是的。哦，等等。我可以把她拖回去，"}, {"type": "subtitle", "time": 4198.149, "timestamp": "01:09:58", "text": "你知道。我可以拦住她并拖拽"}]
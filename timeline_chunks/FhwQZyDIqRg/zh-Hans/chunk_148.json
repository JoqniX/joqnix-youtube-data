[{"type": "subtitle", "time": 8880.15, "timestamp": "02:28:00", "text": "上帝。是的。现在我意识到，因为那是"}, {"type": "subtitle", "time": 8882.389, "timestamp": "02:28:02", "text": "阿门忘记了"}, {"type": "subtitle", "time": 8884.389, "timestamp": "02:28:04", "text": "阿门总是像在背诵……"}, {"type": "subtitle", "time": 8887.59, "timestamp": "02:28:07", "text": "故事，对吧？阿门正在背诵玛萨的诗句。"}, {"type": "subtitle", "time": 8890.79, "timestamp": "02:28:10", "text": "以艾琳的视角讲述的故事。"}, {"type": "subtitle", "time": 8894.51, "timestamp": "02:28:14", "text": "所以事情就是这样，基本上他就是这样。"}, {"type": "subtitle", "time": 8897.349, "timestamp": "02:28:17", "text": "忘记了艾琳的眼睛颜色。每种颜色"}, {"type": "subtitle", "time": 8900.63, "timestamp": "02:28:20", "text": "季节。是啊，这就是它转向的原因。"}, {"type": "subtitle", "time": 8903.03, "timestamp": "02:28:23", "text": "由棕色变为绿色。棕色转绿色。哦，"}, {"type": "subtitle", "time": 8907.349, "timestamp": "02:28:27", "text": "妈的，兄弟。哇。是的。我是《进击的巨人》的铁杆粉丝。"}, {"type": "subtitle", "time": 8910.55, "timestamp": "02:28:30", "text": "对不起。不，不，不。当然。看？不，"}, {"type": "subtitle", "time": 8912.07, "timestamp": "02:28:32", "text": "不。相同的。相同的。因为那就是"}, {"type": "subtitle", "time": 8913.67, "timestamp": "02:28:33", "text": "你说这话的时候，我才意识到原因。"}, {"type": "subtitle", "time": 8916.15, "timestamp": "02:28:36", "text": "它。我当时的感觉就像是回到了过去。"}, {"type": "subtitle", "time": 8919.03, "timestamp": "02:28:39", "text": "那是什么？"}, {"type": "subtitle", "time": 8921.11, "timestamp": "02:28:41", "text": "哦，攻击绝对绝对是"}, {"type": "subtitle", "time": 8923.349, "timestamp": "02:28:43", "text": "对我来说，那是童年的一件小事。是它的"}, {"type": "subtitle", "time": 8928.15, "timestamp": "02:28:48", "text": "这绝对适合我。啊，天哪。"}, {"type": "subtitle", "time": 8931.27, "timestamp": "02:28:51", "text": "说到动漫，简直太棒了。"}, {"type": "subtitle", "time": 8933.27, "timestamp": "02:28:53", "text": "史诗级，史诗级。我喜欢谈论……"}, {"type": "subtitle", "time": 8935.11, "timestamp": "02:28:55", "text": "日本动画片。我可以滔滔不绝地谈论几个小时"}, {"type": "subtitle", "time": 8937.51, "timestamp": "02:28:57", "text": "日本动画片。太多了，我们只能做一件事"}, {"type": "subtitle", "time": 8939.99, "timestamp": "02:28:59", "text": "动漫直播。我们应该这样做。我们"}]
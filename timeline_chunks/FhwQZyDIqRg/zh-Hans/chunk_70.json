[{"type": "subtitle", "time": 4200.95, "timestamp": "01:10:00", "text": "她。我只能带她走。"}, {"type": "subtitle", "time": 4203.91, "timestamp": "01:10:03", "text": "你知道，你可以把这张卡带走。"}, {"type": "subtitle", "time": 4206.51, "timestamp": "01:10:06", "text": "我有很多钱。等等，等等"}, {"type": "subtitle", "time": 4208.79, "timestamp": "01:10:08", "text": "搬家。不要动。不要动。不，"}, {"type": "subtitle", "time": 4211.189, "timestamp": "01:10:11", "text": "不要动。不要动。但持续"}, {"type": "subtitle", "time": 4216.63, "timestamp": "01:10:16", "text": "[音乐]"}, {"type": "subtitle", "time": 4219.39, "timestamp": "01:10:19", "text": "我的天哪，吓死我了。"}, {"type": "subtitle", "time": 4222.709, "timestamp": "01:10:22", "text": "你好。我的错。我只是，我只是把我的"}]
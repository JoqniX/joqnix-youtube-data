[{"type": "subtitle", "time": 14221.269, "timestamp": "03:57:01", "text": "你做得并不出色，你的问题是……"}, {"type": "subtitle", "time": 14222.63, "timestamp": "03:57:02", "text": "拒绝，我不知道该怎么办"}, {"type": "subtitle", "time": 14225.59, "timestamp": "03:57:05", "text": "你还好吗？你知道的。"}, {"type": "subtitle", "time": 14228.63, "timestamp": "03:57:08", "text": "当我刻薄、敏感的时候。你好，"}, {"type": "subtitle", "time": 14231.67, "timestamp": "03:57:11", "text": "杰瑞。欢迎来到直播间。"}, {"type": "subtitle", "time": 14234.15, "timestamp": "03:57:14", "text": "进入混蛋模式。欢迎光临。"}, {"type": "subtitle", "time": 14237.67, "timestamp": "03:57:17", "text": "是的，我首先同意。知道了。"}, {"type": "subtitle", "time": 14239.99, "timestamp": "03:57:19", "text": "你实际上是在寻求新的体验，"}, {"type": "subtitle", "time": 14243.229, "timestamp": "03:57:23", "text": "值得探索的知识领域。呃，我没有"}, {"type": "subtitle", "time": 14248.51, "timestamp": "03:57:28", "text": "知道。我不知道我是否"}, {"type": "subtitle", "time": 14252.229, "timestamp": "03:57:32", "text": "完全记住或者像读过整本书一样"}, {"type": "chat", "time": 14252.59, "timestamp": "03:57:32", "author": "@DinyoFoxy", "avatar": "https://yt4.ggpht.com/DGXvUKi0q0ld5Zo5CNG2tmulZfZqg_h6ivQHLtQfKyx-z_EjHr-Bx7limqyg4JtpZ00_XP_BTQ=s64-c-k-c0x00ffffff-no-rj", "message": "how are you doing ?"}, {"type": "subtitle", "time": 14255.349, "timestamp": "03:57:35", "text": "事情，我不会再去弄更多了。"}, {"type": "subtitle", "time": 14258.55, "timestamp": "03:57:38", "text": "又开始看书了。我通常不会这样做"}, {"type": "subtitle", "time": 14261.83, "timestamp": "03:57:41", "text": "那些事根本不存在。所以我就走了"}, {"type": "subtitle", "time": 14264.389, "timestamp": "03:57:44", "text": "不同意。我不是。互联网怎么样？"}, {"type": "subtitle", "time": 14266.55, "timestamp": "03:57:46", "text": "那么，互联网知识又如何呢？"}, {"type": "subtitle", "time": 14269.91, "timestamp": "03:57:49", "text": "互联网？可笑的是，答案是否定的。就像我"}, {"type": "subtitle", "time": 14271.99, "timestamp": "03:57:51", "text": "不要做那些事。"}, {"type": "subtitle", "time": 14274.229, "timestamp": "03:57:54", "text": "就像即使在……中也是如此。"}, {"type": "subtitle", "time": 14276.79, "timestamp": "03:57:56", "text": "设置 OBS 的时候，我还在忙着呢。"}, {"type": "subtitle", "time": 14278.229, "timestamp": "03:57:58", "text": "你知道吗？我不会"}]
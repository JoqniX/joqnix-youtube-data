[{"type": "subtitle", "time": 15060.229, "timestamp": "04:11:00", "text": "电脑已开启。好的。是的。是的。它制造"}, {"type": "subtitle", "time": 15063.429, "timestamp": "04:11:03", "text": "感觉。有道理。是的。是的。是的。"}, {"type": "subtitle", "time": 15065.03, "timestamp": "04:11:05", "text": "是的。请继续，维克先生。请"}, {"type": "subtitle", "time": 15067.83, "timestamp": "04:11:07", "text": "按照你的方法去做。没关系。前进。"}, {"type": "subtitle", "time": 15069.59, "timestamp": "04:11:09", "text": "就是这样。事情就是这样。那是"}, {"type": "subtitle", "time": 15072.15, "timestamp": "04:11:12", "text": "始终没有圣灵。"}, {"type": "subtitle", "time": 15076.469, "timestamp": "04:11:16", "text": "看？是的。如有异议，您提供"}, {"type": "subtitle", "time": 15079.349, "timestamp": "04:11:19", "text": "指着上面来证明你的观点，或者"}, {"type": "subtitle", "time": 15080.95, "timestamp": "04:11:20", "text": "顾及人们的感受。你必须"}, {"type": "subtitle", "time": 15082.87, "timestamp": "04:11:22", "text": "两者都做。你必须证明你的观点。"}, {"type": "subtitle", "time": 15089.99, "timestamp": "04:11:29", "text": "所以，我决定选这个数字。"}, {"type": "subtitle", "time": 15094.71, "timestamp": "04:11:34", "text": "第一，同意，因为我两件事都在做。"}, {"type": "subtitle", "time": 15097.91, "timestamp": "04:11:37", "text": "因为我，因为归根结底，我为什么会在这里？"}, {"type": "subtitle", "time": 15099.91, "timestamp": "04:11:39", "text": "这样做吗？因为我想保留"}, {"type": "subtitle", "time": 15102.469, "timestamp": "04:11:42", "text": "他们的友谊。我们俩是朋友。我"}, {"type": "subtitle", "time": 15105.03, "timestamp": "04:11:45", "text": "不想，或者我不想我们盘绕"}, {"type": "subtitle", "time": 15108.15, "timestamp": "04:11:48", "text": "就为了这件小事。所以很明显我是"}, {"type": "subtitle", "time": 15110.15, "timestamp": "04:11:50", "text": "这样做是因为我不想受伤"}, {"type": "subtitle", "time": 15113.59, "timestamp": "04:11:53", "text": "你。所以，我优先考虑的是"}, {"type": "subtitle", "time": 15116.79, "timestamp": "04:11:56", "text": "感觉，但我也在证明我的"}, {"type": "subtitle", "time": 15119.91, "timestamp": "04:11:59", "text": "观点。我两件事都在做。是的，我是"}]
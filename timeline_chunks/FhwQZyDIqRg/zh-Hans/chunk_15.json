[{"type": "subtitle", "time": 900.069, "timestamp": "00:15:00", "text": "抽搐？嘿，让我们变成一个"}, {"type": "subtitle", "time": 901.629, "timestamp": "00:15:01", "text": "可视化工具"}, {"type": "subtitle", "time": 904.829, "timestamp": "00:15:04", "text": "实际上。繁荣。"}, {"type": "subtitle", "time": 909.629, "timestamp": "00:15:09", "text": "哟。你好。这是可视化工具专家。"}, {"type": "subtitle", "time": 911.15, "timestamp": "00:15:11", "text": "最大限度。"}, {"type": "subtitle", "time": 913.829, "timestamp": "00:15:13", "text": "你好。你们觉得怎么样？实际上，"}, {"type": "subtitle", "time": 917.949, "timestamp": "00:15:17", "text": "是的，我们仍然有"}, {"type": "subtitle", "time": 921.55, "timestamp": "00:15:21", "text": "东西。我真的很喜欢"}, {"type": "subtitle", "time": 926.269, "timestamp": "00:15:26", "text": "仙人掌。你把它打开。你好。把它转过来"}, {"type": "subtitle", "time": 928.91, "timestamp": "00:15:28", "text": "在。是的。"}, {"type": "subtitle", "time": 933.509, "timestamp": "00:15:33", "text": "呃，我说：“米娜，你觉得怎么样？”"}, {"type": "subtitle", "time": 935.55, "timestamp": "00:15:35", "text": "你觉得新的怎么样？"}, {"type": "subtitle", "time": 939.79, "timestamp": "00:15:39", "text": "特点？设计，新的"}, {"type": "subtitle", "time": 946.71, "timestamp": "00:15:46", "text": "你好。我声音太大了吗？它也在说话"}, {"type": "subtitle", "time": 949.79, "timestamp": "00:15:49", "text": "很多。这是漫画音效吗？"}, {"type": "subtitle", "time": 952.79, "timestamp": "00:15:52", "text": "背景？我不知道。我不知道。"}]
[{"type": "subtitle", "time": 5041.83, "timestamp": "01:24:01", "text": "[笑声]"}, {"type": "subtitle", "time": 5043.149, "timestamp": "01:24:03", "text": "我的天，她"}, {"type": "subtitle", "time": 5045.75, "timestamp": "01:24:05", "text": "太搞笑了。但她不应该大喊大叫"}, {"type": "subtitle", "time": 5047.43, "timestamp": "01:24:07", "text": "因为那个持枪男子会来找她。"}, {"type": "subtitle", "time": 5054.629, "timestamp": "01:24:14", "text": "我的天啊。不，这还不够。不是"}, {"type": "subtitle", "time": 5061.27, "timestamp": "01:24:21", "text": "哦，这还不够。哦，还有"}, {"type": "subtitle", "time": 5063.189, "timestamp": "01:24:23", "text": "噪音。"}, {"type": "subtitle", "time": 5064.79, "timestamp": "01:24:24", "text": "好吧，那么我们该如何了解……"}, {"type": "subtitle", "time": 5066.149, "timestamp": "01:24:26", "text": "鬼魂要来了？你听到了吗？"}, {"type": "subtitle", "time": 5069.189, "timestamp": "01:24:29", "text": "噪音？哦，是的。实际上是音频提示。"}, {"type": "subtitle", "time": 5071.51, "timestamp": "01:24:31", "text": "哦，你死了。"}, {"type": "subtitle", "time": 5074.39, "timestamp": "01:24:34", "text": "欢迎来到枪击现场。"}, {"type": "subtitle", "time": 5077.189, "timestamp": "01:24:37", "text": "你好。你感觉如何？是的，他开枪了。"}, {"type": "subtitle", "time": 5080.07, "timestamp": "01:24:40", "text": "我，兄弟。他突然出现在面前。"}, {"type": "subtitle", "time": 5082.79, "timestamp": "01:24:42", "text": "是我。他直接走到我面前。我"}, {"type": "subtitle", "time": 5085.59, "timestamp": "01:24:45", "text": "就像《黑客帝国》里那样躲避子弹。是的，我"}, {"type": "subtitle", "time": 5087.59, "timestamp": "01:24:47", "text": "我亲眼目睹了整个过程。那是"}, {"type": "subtitle", "time": 5090.31, "timestamp": "01:24:50", "text": "非常难过。很多人需要复兴其中之一"}, {"type": "subtitle", "time": 5093.189, "timestamp": "01:24:53", "text": "我们。"}, {"type": "subtitle", "time": 5095.189, "timestamp": "01:24:55", "text": "或许。我的意思是，如果她能够收集"}, {"type": "subtitle", "time": 5097.51, "timestamp": "01:24:57", "text": "足够的，"}, {"type": "subtitle", "time": 5099.59, "timestamp": "01:24:59", "text": "发生了什么？她为什么要嘲讽？那"}]
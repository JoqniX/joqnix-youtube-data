[{"type": "subtitle", "time": 8160.55, "timestamp": "02:16:00", "text": "建议可以参考动漫。它只是一个"}, {"type": "subtitle", "time": 8163.589, "timestamp": "02:16:03", "text": "一个全新的世界。确切地。我活下来了。"}, {"type": "subtitle", "time": 8165.43, "timestamp": "02:16:05", "text": "我不会撒谎说我"}, {"type": "subtitle", "time": 8167.589, "timestamp": "02:16:07", "text": "我简直是因为动漫才活到现在的。"}, {"type": "subtitle", "time": 8169.43, "timestamp": "02:16:09", "text": "你会有很多次感到沮丧。"}, {"type": "subtitle", "time": 8171.35, "timestamp": "02:16:11", "text": "其实我不知道该怎么做。"}, {"type": "subtitle", "time": 8174.069, "timestamp": "02:16:14", "text": "说服人们喜欢并理解"}, {"type": "subtitle", "time": 8176.709, "timestamp": "02:16:16", "text": "你知道动漫这件事确实很重要。"}, {"type": "subtitle", "time": 8180.229, "timestamp": "02:16:20", "text": "救救我的命。这是真的。我是说"}, {"type": "subtitle", "time": 8182.95, "timestamp": "02:16:22", "text": "我唯一能说的就是这个。"}, {"type": "subtitle", "time": 8184.75, "timestamp": "02:16:24", "text": "那大概就是"}, {"type": "subtitle", "time": 8188.87, "timestamp": "02:16:28", "text": "AOT。嗯，这有点难说服。"}, {"type": "subtitle", "time": 8190.79, "timestamp": "02:16:30", "text": "要说服人们如何看待这个问题，有点难。"}, {"type": "subtitle", "time": 8193.429, "timestamp": "02:16:33", "text": "就像媒体作品会产生影响一样"}, {"type": "subtitle", "time": 8196.309, "timestamp": "02:16:36", "text": "这取决于你，因为这取决于你的方式。"}, {"type": "subtitle", "time": 8198.469, "timestamp": "02:16:38", "text": "只有你自己才能感知到它，其他人都无法感知。"}, {"type": "subtitle", "time": 8201.669, "timestamp": "02:16:41", "text": "可以理解。正确的。确切地。经过"}, {"type": "subtitle", "time": 8204.07, "timestamp": "02:16:44", "text": "伙计们，我当时正在吃东西，就这么走了"}, {"type": "subtitle", "time": 8205.99, "timestamp": "02:16:45", "text": "我现在要去洗手。"}, {"type": "subtitle", "time": 8208.27, "timestamp": "02:16:48", "text": "不，你继续。前进。"}, {"type": "subtitle", "time": 8211.83, "timestamp": "02:16:51", "text": "好的。好的。哦，对了，我当时"}, {"type": "subtitle", "time": 8215.19, "timestamp": "02:16:55", "text": "谈论音乐。是的。是的。是的。我的"}, {"type": "subtitle", "time": 8218.629, "timestamp": "02:16:58", "text": "我最喜欢的动漫音乐是……"}]
[{"type": "subtitle", "time": 4620.229, "timestamp": "01:17:00", "text": "这里。哦，不，不，不。她即将启航"}, {"type": "subtitle", "time": 4622.63, "timestamp": "01:17:02", "text": "速度。什么？"}, {"type": "subtitle", "time": 4625.51, "timestamp": "01:17:05", "text": "你没有。好的，兄弟。我可以试试。"}, {"type": "subtitle", "time": 4627.55, "timestamp": "01:17:07", "text": "不，不。让我们消灭你不是"}, {"type": "subtitle", "time": 4630.55, "timestamp": "01:17:10", "text": "试试那个，试试那个"}, {"type": "subtitle", "time": 4633.75, "timestamp": "01:17:13", "text": "怪异的鬼魂。我真希望我们杀了"}, {"type": "subtitle", "time": 4635.669, "timestamp": "01:17:15", "text": "某人。"}, {"type": "subtitle", "time": 4637.59, "timestamp": "01:17:17", "text": "想象一下，如果像某人一样"}, {"type": "subtitle", "time": 4639.27, "timestamp": "01:17:19", "text": "我已经和鬼魂在一起了，我杀了它们"}, {"type": "subtitle", "time": 4641.27, "timestamp": "01:17:21", "text": "也一样。那一定很漂亮。想象"}, {"type": "subtitle", "time": 4642.87, "timestamp": "01:17:22", "text": "这辆卡车里有东西。想象一下"}, {"type": "subtitle", "time": 4644.47, "timestamp": "01:17:24", "text": "卡车里有人。这是"}, {"type": "subtitle", "time": 4646.229, "timestamp": "01:17:26", "text": "这让我感到振奋"}, {"type": "subtitle", "time": 4648.189, "timestamp": "01:17:28", "text": "疾病。然后"}, {"type": "subtitle", "time": 4651.189, "timestamp": "01:17:31", "text": "不。是的。我不吃东西，因为我"}, {"type": "subtitle", "time": 4653.83, "timestamp": "01:17:33", "text": "吃。"}, {"type": "subtitle", "time": 4657.27, "timestamp": "01:17:37", "text": "等待。 D 像这样缩小规模。从小规模做起。"}, {"type": "subtitle", "time": 4661.11, "timestamp": "01:17:41", "text": "不，去做。去做。快点。快点。得到"}, {"type": "subtitle", "time": 4663.99, "timestamp": "01:17:43", "text": "你。再见。不，不，不。相信我。相信"}, {"type": "subtitle", "time": 4666.87, "timestamp": "01:17:46", "text": "我。"}, {"type": "subtitle", "time": 4668.87, "timestamp": "01:17:48", "text": "接下来怎么办？不。"}, {"type": "subtitle", "time": 4676.55, "timestamp": "01:17:56", "text": "对不起。你为什么这样做？"}, {"type": "subtitle", "time": 4679.03, "timestamp": "01:17:59", "text": "你没有。"}]
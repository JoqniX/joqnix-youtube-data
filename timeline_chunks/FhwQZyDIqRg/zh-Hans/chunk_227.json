[{"type": "subtitle", "time": 13620.71, "timestamp": "03:47:00", "text": "一点。是的。是的。沙姆先生。是的。那是"}, {"type": "subtitle", "time": 13622.71, "timestamp": "03:47:02", "text": "我原本想对杰奎先生说的话。"}, {"type": "subtitle", "time": 13624.79, "timestamp": "03:47:04", "text": "是的。我将暂停"}, {"type": "subtitle", "time": 13627.99, "timestamp": "03:47:07", "text": "测试。哦，人们看到的只是一片虚空。"}, {"type": "subtitle", "time": 13629.67, "timestamp": "03:47:09", "text": "稍等片刻。对，就是这儿。"}, {"type": "subtitle", "time": 13636.55, "timestamp": "03:47:16", "text": "所以，是的，我先暂停一下。"}, {"type": "subtitle", "time": 13640.229, "timestamp": "03:47:20", "text": "稍等片刻，直到你，J先生，你"}, {"type": "subtitle", "time": 13642.63, "timestamp": "03:47:22", "text": "我可以像我刚才那样做任何事"}, {"type": "subtitle", "time": 13644.229, "timestamp": "03:47:24", "text": "读出问题，然后"}, {"type": "subtitle", "time": 13646.15, "timestamp": "03:47:26", "text": "解释之类的。是的。是的。是的。"}, {"type": "subtitle", "time": 13656.51, "timestamp": "03:47:36", "text": "做。"}, {"type": "subtitle", "time": 13661.51, "timestamp": "03:47:41", "text": "是的。呃，我不知道。哦，对不起，小姐。"}, {"type": "subtitle", "time": 13663.75, "timestamp": "03:47:43", "text": "辛。我本不该给你打电话。"}, {"type": "subtitle", "time": 13665.91, "timestamp": "03:47:45", "text": "先生。我通常称之为字面意义"}, {"type": "subtitle", "time": 13668.229, "timestamp": "03:47:48", "text": "各位先生。你知道还有什么吗？"}, {"type": "subtitle", "time": 13670.63, "timestamp": "03:47:50", "text": "我要给所有人打电话吗？我显然"}, {"type": "subtitle", "time": 13673.189, "timestamp": "03:47:53", "text": "大家都叫他兄弟。我不知道"}, {"type": "subtitle", "time": 13676.229, "timestamp": "03:47:56", "text": "我为什么会这样做。兄弟。兄弟。我是"}, {"type": "subtitle", "time": 13678.15, "timestamp": "03:47:58", "text": "置顶。"}]
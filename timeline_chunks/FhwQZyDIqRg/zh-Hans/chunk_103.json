[{"type": "subtitle", "time": 6180.39, "timestamp": "01:43:00", "text": "积分。好了，就是这样。"}, {"type": "subtitle", "time": 6183.03, "timestamp": "01:43:03", "text": "让我去干掉它。去他妈的。哦"}, {"type": "subtitle", "time": 6184.47, "timestamp": "01:43:04", "text": "不。帮我。帮我。这东西是"}, {"type": "subtitle", "time": 6187.109, "timestamp": "01:43:07", "text": "盯着我看。去你的。谢谢。"}, {"type": "subtitle", "time": 6189.75, "timestamp": "01:43:09", "text": "哦，那个小混蛋。"}, {"type": "subtitle", "time": 6191.669, "timestamp": "01:43:11", "text": "我会这样打开它，所以它是"}, {"type": "subtitle", "time": 6202.39, "timestamp": "01:43:22", "text": "卡车复活。它没有复苏。什么？"}, {"type": "subtitle", "time": 6205.03, "timestamp": "01:43:25", "text": "我的天哪，它没能复苏。好的，我"}, {"type": "subtitle", "time": 6212.35, "timestamp": "01:43:32", "text": "等等，如果我把你放进去呢？"}, {"type": "subtitle", "time": 6218.27, "timestamp": "01:43:38", "text": "惠普？"}, {"type": "subtitle", "time": 6227.27, "timestamp": "01:43:47", "text": "不。呃，已经"}, {"type": "subtitle", "time": 6228.51, "timestamp": "01:43:48", "text": "[音乐]"}, {"type": "subtitle", "time": 6231.99, "timestamp": "01:43:51", "text": "知道。哦，没事了。"}, {"type": "subtitle", "time": 6234.39, "timestamp": "01:43:54", "text": "别这样！这到底是怎么回事？不，不是这样的。"}, {"type": "subtitle", "time": 6236.39, "timestamp": "01:43:56", "text": "在职的。"}, {"type": "subtitle", "time": 6238.47, "timestamp": "01:43:58", "text": "这是什么？哦，那里曾有过整个"}]
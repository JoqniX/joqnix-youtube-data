[{"type": "subtitle", "time": 5532.149, "timestamp": "01:32:12", "text": "嗯……我想我们应该开始了。是的，"}, {"type": "subtitle", "time": 5535.03, "timestamp": "01:32:15", "text": "我们走吧。好，我们走吧。是的。而这"}, {"type": "subtitle", "time": 5536.709, "timestamp": "01:32:16", "text": "伙计们，我们这次一定要赢。是"}, {"type": "subtitle", "time": 5538.07, "timestamp": "01:32:18", "text": "将会获胜。至少我们还要去。"}, {"type": "subtitle", "time": 5541.43, "timestamp": "01:32:21", "text": "进入第三轮。是的。至少。至少"}, {"type": "subtitle", "time": 5543.49, "timestamp": "01:32:23", "text": "我要"}, {"type": "subtitle", "time": 5544.79, "timestamp": "01:32:24", "text": "[音乐]"}, {"type": "subtitle", "time": 5546.31, "timestamp": "01:32:26", "text": "不用担心。我将第一个出发"}, {"type": "subtitle", "time": 5547.669, "timestamp": "01:32:27", "text": "四处看看有没有鬼魂，这样我才能告诉你"}, {"type": "subtitle", "time": 5550.149, "timestamp": "01:32:30", "text": "你们。是的。是的。我要打电话"}, {"type": "subtitle", "time": 5552.87, "timestamp": "01:32:32", "text": "你作为一名专业的回收玩家。全部"}, {"type": "subtitle", "time": 5555.03, "timestamp": "01:32:35", "text": "好的，我们走吧。哦，是的。你拥有"}, {"type": "subtitle", "time": 5558.31, "timestamp": "01:32:38", "text": "皇冠也一样。"}, {"type": "subtitle", "time": 5560.149, "timestamp": "01:32:40", "text": "哦，是的。是啊，是啊，是啊。她拥有"}, {"type": "subtitle", "time": 5563.59, "timestamp": "01:32:43", "text": "王冠。是的。放在这里。不，不，不。"}, {"type": "subtitle", "time": 5572.07, "timestamp": "01:32:52", "text": "我打算把它放在这里。我们就这样吧"}, {"type": "subtitle", "time": 5575.03, "timestamp": "01:32:55", "text": "哦，我要进去了。"}, {"type": "subtitle", "time": 5579.35, "timestamp": "01:32:59", "text": "哦，不。哦，不。你打破了"}]
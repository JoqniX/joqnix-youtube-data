[{"type": "subtitle", "time": 14760.469, "timestamp": "04:06:00", "text": "不。我通常睡觉，然后随机"}, {"type": "subtitle", "time": 14762.79, "timestamp": "04:06:02", "text": "还记得那些，比如“哦，对，我有这个”吗？"}, {"type": "subtitle", "time": 14764.79, "timestamp": "04:06:04", "text": "工作没问题，我会把所有事情都做完。"}, {"type": "subtitle", "time": 14767.349, "timestamp": "04:06:07", "text": "做完家务再回来，感觉就不一样了。"}, {"type": "subtitle", "time": 14770.63, "timestamp": "04:06:10", "text": "呃，我并不是会逃避家务。"}, {"type": "subtitle", "time": 14773.389, "timestamp": "04:06:13", "text": "我会的，我会喜欢做它们"}, {"type": "subtitle", "time": 14775.99, "timestamp": "04:06:15", "text": "我会重复地随机地"}, {"type": "subtitle", "time": 14777.429, "timestamp": "04:06:17", "text": "记住它们，我会做家务的。"}, {"type": "subtitle", "time": 14779.75, "timestamp": "04:06:19", "text": "所以，我打算用一个水平仪。"}, {"type": "subtitle", "time": 14786.469, "timestamp": "04:06:26", "text": "是的，杰克先生，我目前进度是 40%，怎么样？"}, {"type": "subtitle", "time": 14789.75, "timestamp": "04:06:29", "text": "进展如何？是啊，我也是。我在"}, {"type": "subtitle", "time": 14793.269, "timestamp": "04:06:33", "text": "和你一样的速度"}, {"type": "subtitle", "time": 14796.63, "timestamp": "04:06:36", "text": "果酱。好的。在意见分歧中，你是支持派"}, {"type": "subtitle", "time": 14798.95, "timestamp": "04:06:38", "text": "优先考虑证明你的观点"}, {"type": "subtitle", "time": 14802.91, "timestamp": "04:06:42", "text": "顾及他人感受。呃"}, {"type": "subtitle", "time": 14806.83, "timestamp": "04:06:46", "text": "再次，事实与逻辑，事实与逻辑"}, {"type": "subtitle", "time": 14809.55, "timestamp": "04:06:49", "text": "情怀。呃，还有"}, {"type": "subtitle", "time": 14812.389, "timestamp": "04:06:52", "text": "分歧，这些分歧"}, {"type": "subtitle", "time": 14815.11, "timestamp": "04:06:55", "text": "去了很多地方。这真是太……"}, {"type": "subtitle", "time": 14819.429, "timestamp": "04:06:59", "text": "顺便一提，已经缩小了路径。"}]
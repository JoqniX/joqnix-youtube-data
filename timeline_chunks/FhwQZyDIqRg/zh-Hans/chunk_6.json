[{"type": "subtitle", "time": 361.909, "timestamp": "00:06:01", "text": "成为像 YouTuber 那样的人，主要制作我的"}, {"type": "subtitle", "time": 364.43, "timestamp": "00:06:04", "text": "自己的所有东西"}, {"type": "subtitle", "time": 368.15, "timestamp": "00:06:08", "text": "一切终于结束了"}, {"type": "subtitle", "time": 371.189, "timestamp": "00:06:11", "text": "呃，就像你知道我所有的直播一样……"}, {"type": "subtitle", "time": 374.79, "timestamp": "00:06:14", "text": "一直以来都像受苦一样"}, {"type": "subtitle", "time": 377.99, "timestamp": "00:06:17", "text": "我不知道，我已经尽力了，我已经尽力了。"}, {"type": "subtitle", "time": 379.95, "timestamp": "00:06:19", "text": "虽然人"}, {"type": "subtitle", "time": 383.189, "timestamp": "00:06:23", "text": "比如让直播更有趣"}, {"type": "subtitle", "time": 385.99, "timestamp": "00:06:25", "text": "尽可能地娱乐，而且"}, {"type": "subtitle", "time": 387.95, "timestamp": "00:06:27", "text": "主要 主要"}, {"type": "subtitle", "time": 392.30899999999997, "timestamp": "00:06:32", "text": "尽我所能。你们很多人甚至"}, {"type": "subtitle", "time": 394.67, "timestamp": "00:06:34", "text": "训斥了我"}, {"type": "subtitle", "time": 397.749, "timestamp": "00:06:37", "text": "很多人因为我工作太多而责备我。"}, {"type": "subtitle", "time": 401.43, "timestamp": "00:06:41", "text": "而且不休息，是的。是的。"}, {"type": "subtitle", "time": 404.55, "timestamp": "00:06:44", "text": "所有人都记得那些漫长的时光。"}, {"type": "subtitle", "time": 408.11, "timestamp": "00:06:48", "text": "长时间直播之类的。"}, {"type": "subtitle", "time": 414.30899999999997, "timestamp": "00:06:54", "text": "是的。你好。所以，嗯，所有的努力……"}]
[{"type": "subtitle", "time": 9449.11, "timestamp": "02:37:29", "text": "我想起了那场战争。是的。"}, {"type": "subtitle", "time": 9451.19, "timestamp": "02:37:31", "text": "谁在背诵谁在背诵"}, {"type": "subtitle", "time": 9455.429, "timestamp": "02:37:35", "text": "《圣经》？你在做什么？"}, {"type": "subtitle", "time": 9460.79, "timestamp": "02:37:40", "text": "好的。房间里什么也没有。不，绝对不行。"}, {"type": "subtitle", "time": 9463.19, "timestamp": "02:37:43", "text": "我想我们要进那个房间了。哦，所以"}, {"type": "subtitle", "time": 9464.59, "timestamp": "02:37:44", "text": "我们"}, {"type": "subtitle", "time": 9467.51, "timestamp": "02:37:47", "text": "真的去吧。"}, {"type": "subtitle", "time": 9471.59, "timestamp": "02:37:51", "text": "我的天啊。哦，糟糕。各位，我可以试试吗？"}, {"type": "subtitle", "time": 9475.51, "timestamp": "02:37:55", "text": "这？大家好。你能吗？但我该怎么做？"}, {"type": "subtitle", "time": 9477.99, "timestamp": "02:37:57", "text": "听起来像这样吗？怎么可能有人能做到？"}]
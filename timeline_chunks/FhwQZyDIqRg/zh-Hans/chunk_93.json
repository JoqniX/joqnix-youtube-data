[{"type": "subtitle", "time": 5582.91, "timestamp": "01:33:02", "text": "钻石，老兄。"}, {"type": "subtitle", "time": 5585.99, "timestamp": "01:33:05", "text": "把它带过来。现在，每个人都可以"}, {"type": "subtitle", "time": 5589.83, "timestamp": "01:33:09", "text": "四处看看有没有东西。"}, {"type": "subtitle", "time": 5595.51, "timestamp": "01:33:15", "text": "至少我得到了一件我可以做的事。"}, {"type": "subtitle", "time": 5604.39, "timestamp": "01:33:24", "text": "我可以滚动滚轮把它拉进去。"}, {"type": "subtitle", "time": 5609.03, "timestamp": "01:33:29", "text": "更近了。可以使用向下滚动功能。"}, {"type": "subtitle", "time": 5612.629, "timestamp": "01:33:32", "text": "我不知道。是的，"}, {"type": "subtitle", "time": 5615.55, "timestamp": "01:33:35", "text": "就像你一样。不，我唱得很轻柔。"}, {"type": "subtitle", "time": 5619.189, "timestamp": "01:33:39", "text": "黑斑羚。我唱的是什么？驯服的黑斑羚乐队？"}, {"type": "subtitle", "time": 5620.709, "timestamp": "01:33:40", "text": "也。"}]
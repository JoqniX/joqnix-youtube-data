[{"type": "subtitle", "time": 7022.149, "timestamp": "01:57:02", "text": "昂贵的。是的。是的。哦，小心。它是"}, {"type": "subtitle", "time": 7023.589, "timestamp": "01:57:03", "text": "卡在门里了。被门卡住了。"}, {"type": "subtitle", "time": 7025.83, "timestamp": "01:57:05", "text": "好的。算了。算了。轻轻地。"}, {"type": "subtitle", "time": 7028.87, "timestamp": "01:57:08", "text": "轻轻地。算了。我没事。我要走了。"}, {"type": "subtitle", "time": 7032.149, "timestamp": "01:57:12", "text": "呃，不。我轻声说道。如果我离开，"}, {"type": "subtitle", "time": 7033.99, "timestamp": "01:57:13", "text": "它要下跌了。它要下跌了。"}, {"type": "subtitle", "time": 7035.83, "timestamp": "01:57:15", "text": "该死。啊，我们抓到他了。它仍然是"}, {"type": "subtitle", "time": 7037.75, "timestamp": "01:57:17", "text": "贵啊，伙计们。不用担心。没关系。"}, {"type": "subtitle", "time": 7045.87, "timestamp": "01:57:25", "text": "应该得到"}]
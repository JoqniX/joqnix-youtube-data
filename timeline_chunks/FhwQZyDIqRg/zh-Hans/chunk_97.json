[{"type": "subtitle", "time": 5823.43, "timestamp": "01:37:03", "text": "某人。向上。是的。我做了。我做了。我"}, {"type": "subtitle", "time": 5828.629, "timestamp": "01:37:08", "text": "去做。我做了。是的。好的。"}, {"type": "subtitle", "time": 5832.229, "timestamp": "01:37:12", "text": "抓住他。你在哪里？我在这里。如何"}, {"type": "subtitle", "time": 5834.95, "timestamp": "01:37:14", "text": "我难道不能去接你吗？"}, {"type": "subtitle", "time": 5837.669, "timestamp": "01:37:17", "text": "这是为什么呢？我买的是蓝色的。乔克。"}, {"type": "subtitle", "time": 5840.229, "timestamp": "01:37:20", "text": "你必须按Q键。哦，Q键。哦，好的。"}, {"type": "subtitle", "time": 5844.229, "timestamp": "01:37:24", "text": "好的。好的。是的。什么？为什么我不是"}, {"type": "subtitle", "time": 5848.47, "timestamp": "01:37:28", "text": "有能力的？哦，不。他不是。"}, {"type": "subtitle", "time": 5850.229, "timestamp": "01:37:30", "text": "是的。好的。我会尽力。我会尽力。我不是"}, {"type": "subtitle", "time": 5851.43, "timestamp": "01:37:31", "text": "能够拿起来。我不知道为什么。"}, {"type": "subtitle", "time": 5852.95, "timestamp": "01:37:32", "text": "发生了什么事？我在这里。我在这里。"}, {"type": "subtitle", "time": 5854.39, "timestamp": "01:37:34", "text": "这样可行。我无法选择"}, {"type": "subtitle", "time": 5857.03, "timestamp": "01:37:37", "text": "有什么事吗？好了。哦，是的。现在"}, {"type": "subtitle", "time": 5859.189, "timestamp": "01:37:39", "text": "我可以去接你。不要尝试其他方法"}, {"type": "subtitle", "time": 5861.109, "timestamp": "01:37:41", "text": "一。我需要像我需要的那样"}, {"type": "subtitle", "time": 5864.629, "timestamp": "01:37:44", "text": "就像翻过来一样，然后我把你放上去。"}, {"type": "subtitle", "time": 5867.35, "timestamp": "01:37:47", "text": "放我出去。哦，还有，哎呀。我是"}, {"type": "subtitle", "time": 5871.189, "timestamp": "01:37:51", "text": "对不起。几乎。几乎。"}, {"type": "subtitle", "time": 5874.26, "timestamp": "01:37:54", "text": "是的。是的。"}, {"type": "subtitle", "time": 5877.99, "timestamp": "01:37:57", "text": "[音乐]"}]
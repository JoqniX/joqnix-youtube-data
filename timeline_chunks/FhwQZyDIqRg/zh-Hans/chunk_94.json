[{"type": "subtitle", "time": 5640.149, "timestamp": "01:34:00", "text": "哦，这太疯狂了。哇。好的，我们已经"}, {"type": "subtitle", "time": 5641.99, "timestamp": "01:34:01", "text": "已达到。好了，伙计们，我们走吧。我们不要"}, {"type": "subtitle", "time": 5644.709, "timestamp": "01:34:04", "text": "风险。我们不要冒险。"}, {"type": "subtitle", "time": 5647.35, "timestamp": "01:34:07", "text": "是的。是的。我们走吧。因为我知道我们努力过了。"}, {"type": "subtitle", "time": 5650.79, "timestamp": "01:34:10", "text": "不听你的话，我们就死了。"}, {"type": "subtitle", "time": 5653.75, "timestamp": "01:34:13", "text": "我还是要去。"}, {"type": "subtitle", "time": 5666.95, "timestamp": "01:34:26", "text": "拉屎。我看你根本没在听她说话。"}, {"type": "subtitle", "time": 5670.229, "timestamp": "01:34:30", "text": "任何一个。哦。"}, {"type": "subtitle", "time": 5671.87, "timestamp": "01:34:31", "text": "哦，他们是"}, {"type": "subtitle", "time": 5685.35, "timestamp": "01:34:45", "text": "[音乐]"}, {"type": "subtitle", "time": 5688.87, "timestamp": "01:34:48", "text": "等等，等等，等等。抓住他。我回来了。"}, {"type": "subtitle", "time": 5697.11, "timestamp": "01:34:57", "text": "她在哪里？没关系。没关系。"}]
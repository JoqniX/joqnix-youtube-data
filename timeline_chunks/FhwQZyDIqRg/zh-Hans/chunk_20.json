[{"type": "subtitle", "time": 1200.59, "timestamp": "00:20:00", "text": "一份特别温馨的礼物。"}, {"type": "subtitle", "time": 1203.59, "timestamp": "00:20:03", "text": "真的太暖心了，真的很难……"}, {"type": "subtitle", "time": 1208.63, "timestamp": "00:20:08", "text": "用语言表达出来，但最终感觉就像……"}, {"type": "subtitle", "time": 1210.669, "timestamp": "00:20:10", "text": "真是"}, {"type": "subtitle", "time": 1215.31, "timestamp": "00:20:15", "text": "看到这个我真的哭了好久。"}, {"type": "subtitle", "time": 1224.73, "timestamp": "00:20:24", "text": "感激不尽，但我做了"}, {"type": "subtitle", "time": 1227.31, "timestamp": "00:20:27", "text": "[音乐]"}, {"type": "subtitle", "time": 1243.47, "timestamp": "00:20:43", "text": "特别的猎人"}, {"type": "subtitle", "time": 1247.83, "timestamp": "00:20:47", "text": "特别的概念艺术，天哪，我做了什么？哦，天哪！"}, {"type": "subtitle", "time": 1252.71, "timestamp": "00:20:52", "text": "经常闭嘴，嗨，所以嗯，嗨，我闭嘴的原因是"}, {"type": "subtitle", "time": 1255.59, "timestamp": "00:20:55", "text": "我称之为概念艺术，实际上我是"}, {"type": "subtitle", "time": 1258.39, "timestamp": "00:20:58", "text": "正式使其成为这个呃男性"}]
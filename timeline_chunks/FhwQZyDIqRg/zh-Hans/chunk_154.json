[{"type": "subtitle", "time": 9241.83, "timestamp": "02:34:01", "text": "告别。是的。是的。我们走吧。"}, {"type": "subtitle", "time": 9244.469, "timestamp": "02:34:04", "text": "伟大的。我们走吧。我们走吧。这样可以吗？"}, {"type": "subtitle", "time": 9246.389, "timestamp": "02:34:06", "text": "和你在一起吗，约翰？是的。是的。 5分钟"}, {"type": "subtitle", "time": 9249.11, "timestamp": "02:34:09", "text": "总之。我们走吧。我们走吧。我希望我"}, {"type": "subtitle", "time": 9266.95, "timestamp": "02:34:26", "text": "我们走吧。"}, {"type": "subtitle", "time": 9271.03, "timestamp": "02:34:31", "text": "我喜欢你翻跟头的样子。"}, {"type": "subtitle", "time": 9275.89, "timestamp": "02:34:35", "text": "我希望我的意思是，我们确实尝试过。"}, {"type": "subtitle", "time": 9293.03, "timestamp": "02:34:53", "text": "哦，对了，有人在看《恶魔》吗？"}, {"type": "subtitle", "time": 9295.51, "timestamp": "02:34:55", "text": "五月哭泣？"}, {"type": "subtitle", "time": 9297.59, "timestamp": "02:34:57", "text": "哦，"}]
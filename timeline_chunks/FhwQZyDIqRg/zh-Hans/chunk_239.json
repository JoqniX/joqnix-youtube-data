[{"type": "subtitle", "time": 14340.63, "timestamp": "03:59:00", "text": "别担心。我打算选择"}, {"type": "subtitle", "time": 14342.71, "timestamp": "03:59:02", "text": "不同意。我持不同意见。"}, {"type": "subtitle", "time": 14346.07, "timestamp": "03:59:06", "text": "我不是，我不做那些事。如果我那样做，"}, {"type": "subtitle", "time": 14348.95, "timestamp": "03:59:08", "text": "我绝不会平静下来。我喜欢"}, {"type": "subtitle", "time": 14351.59, "timestamp": "03:59:11", "text": "独自进行的爱好或活动超过"}, {"type": "subtitle", "time": 14355.59, "timestamp": "03:59:15", "text": "第一组。我喜欢独自进行的爱好。"}, {"type": "subtitle", "time": 14358.15, "timestamp": "03:59:18", "text": "什么东西是固体？显然有独奏部分。"}, {"type": "subtitle", "time": 14361.429, "timestamp": "03:59:21", "text": "单人独奏。独奏"}, {"type": "subtitle", "time": 14364.51, "timestamp": "03:59:24", "text": "独奏。我做事从不单打独斗。所以你"}, {"type": "subtitle", "time": 14367.59, "timestamp": "03:59:27", "text": "不同意。感觉大部分时间都在工作。"}, {"type": "subtitle", "time": 14370.07, "timestamp": "03:59:30", "text": "工作。即使在工作中，我也会这样做。"}, {"type": "subtitle", "time": 14373.51, "timestamp": "03:59:33", "text": "团体。比如个人爱好。我不"}, {"type": "subtitle", "time": 14375.429, "timestamp": "03:59:35", "text": "最近有时间做些个人爱好。"}, {"type": "subtitle", "time": 14377.51, "timestamp": "03:59:37", "text": "就像读书或玩游戏一样"}, {"type": "subtitle", "time": 14378.95, "timestamp": "03:59:38", "text": "单人游戏。我没时间"}, {"type": "subtitle", "time": 14380.95, "timestamp": "03:59:40", "text": "对于那些人来说。是的，我要……"}, {"type": "chat", "time": 14383.089, "timestamp": "03:59:43", "author": "@DinyoFoxy", "avatar": "https://yt4.ggpht.com/DGXvUKi0q0ld5Zo5CNG2tmulZfZqg_h6ivQHLtQfKyx-z_EjHr-Bx7limqyg4JtpZ00_XP_BTQ=s64-c-k-c0x00ffffff-no-rj", "message": "bye i am going to bed good night"}, {"type": "subtitle", "time": 14383.11, "timestamp": "03:59:43", "text": "很遗憾，只能这样了。你不能"}, {"type": "subtitle", "time": 14384.79, "timestamp": "03:59:44", "text": "想象一下你在写一部小说。"}, {"type": "subtitle", "time": 14386.03, "timestamp": "03:59:46", "text": "故事"}, {"type": "subtitle", "time": 14388.11, "timestamp": "03:59:48", "text": "不，我不能"}, {"type": "subtitle", "time": 14390.71, "timestamp": "03:59:50", "text": "想象一下你自己。你无法想象"}, {"type": "subtitle", "time": 14394.429, "timestamp": "03:59:54", "text": "你真丑。我不会写字"}, {"type": "subtitle", "time": 14399.349, "timestamp": "03:59:59", "text": "任何有生命的事物。不，不。是哪一个？"}]
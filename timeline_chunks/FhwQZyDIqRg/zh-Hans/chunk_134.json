[{"type": "subtitle", "time": 8042.149, "timestamp": "02:14:02", "text": "好的。我的天啊，又来一个！"}, {"type": "subtitle", "time": 8044.87, "timestamp": "02:14:04", "text": "一首现在很火的歌。人工智能"}, {"type": "subtitle", "time": 8048.709, "timestamp": "02:14:08", "text": "尖叫。还记得吗？哦，冰淇淋。人工智能"}, {"type": "subtitle", "time": 8050.95, "timestamp": "02:14:10", "text": "尖叫。哦，"}, {"type": "subtitle", "time": 8063.51, "timestamp": "02:14:23", "text": "大脑一片空白。哦，不。哦，不。不，不"}, {"type": "subtitle", "time": 8064.47, "timestamp": "02:14:24", "text": "不。我们将要……我们将要听到"}, {"type": "subtitle", "time": 8067.27, "timestamp": "02:14:27", "text": "Suumi 唱这首歌。它真是太可爱了。"}, {"type": "subtitle", "time": 8070.31, "timestamp": "02:14:30", "text": "是的。是的。好的，我们来探讨一下“如何做”。"}, {"type": "subtitle", "time": 8072.069, "timestamp": "02:14:32", "text": "我们开始吗？我会做，我会做"}, {"type": "subtitle", "time": 8074.55, "timestamp": "02:14:34", "text": "那一部分。呃，你的名字是什么？"}, {"type": "subtitle", "time": 8076.47, "timestamp": "02:14:36", "text": "名字是什么？嗯？好的，我是"}, {"type": "subtitle", "time": 8079.189, "timestamp": "02:14:39", "text": "我打算这么做。好的。我完成了。来"}, {"type": "subtitle", "time": 8083.109, "timestamp": "02:14:43", "text": "开始，去做。给我。快点。你真是太"}, {"type": "subtitle", "time": 8086.229, "timestamp": "02:14:46", "text": "甜的。我们很喜欢。听起来真不错。"}, {"type": "subtitle", "time": 8087.91, "timestamp": "02:14:47", "text": "你在开玩笑吧？她听起来确实很像。"}, {"type": "subtitle", "time": 8092.31, "timestamp": "02:14:52", "text": "超好的。为什么？我为什么要起诉？"}, {"type": "subtitle", "time": 8095.03, "timestamp": "02:14:55", "text": "我？听起来确实很不错。我是"}, {"type": "subtitle", "time": 8097.37, "timestamp": "02:14:57", "text": "没开玩笑。我是认真的。"}]
[{"type": "subtitle", "time": 9120.63, "timestamp": "02:32:00", "text": "有像你这样的抱枕"}, {"type": "subtitle", "time": 9123.27, "timestamp": "02:32:03", "text": "知道女性动漫角色有啊我们"}, {"type": "subtitle", "time": 9124.79, "timestamp": "02:32:04", "text": "不知道他们是做什么的。只是……"}, {"type": "subtitle", "time": 9127.27, "timestamp": "02:32:07", "text": "其中一人决定把这件事告诉……"}, {"type": "subtitle", "time": 9130.07, "timestamp": "02:32:10", "text": "社交媒体，就是这样。"}, {"type": "subtitle", "time": 9131.429, "timestamp": "02:32:11", "text": "发生了。你根本不知道人们会怎么做"}, {"type": "subtitle", "time": 9133.27, "timestamp": "02:32:13", "text": "关起门来做，我觉得没问题。"}, {"type": "subtitle", "time": 9135.03, "timestamp": "02:32:15", "text": "我什么事都没有。所以每当我"}, {"type": "subtitle", "time": 9136.389, "timestamp": "02:32:16", "text": "过去常常在社交媒体上看到这些东西"}, {"type": "subtitle", "time": 9138.71, "timestamp": "02:32:18", "text": "我当时对媒体的态度就像是完全屏蔽了它，而且不是"}, {"type": "subtitle", "time": 9142.07, "timestamp": "02:32:22", "text": "注意它。你不能"}, {"type": "subtitle", "time": 9145.19, "timestamp": "02:32:25", "text": "哦，我有。"}, {"type": "subtitle", "time": 9147.99, "timestamp": "02:32:27", "text": "但是，如果你问我的话，我的意思是，我是"}, {"type": "subtitle", "time": 9149.75, "timestamp": "02:32:29", "text": "我可能会说，你知道吗，"}, {"type": "subtitle", "time": 9151.83, "timestamp": "02:32:31", "text": "伙计们？事情正在发生。闭嘴"}, {"type": "subtitle", "time": 9153.99, "timestamp": "02:32:33", "text": "离开。就是这样。不要再插手了。"}, {"type": "subtitle", "time": 9155.99, "timestamp": "02:32:35", "text": "在歌曲中，那将只是那样"}, {"type": "subtitle", "time": 9157.349, "timestamp": "02:32:37", "text": "放纵。你打算沉迷于"}, {"type": "subtitle", "time": 9159.349, "timestamp": "02:32:39", "text": "恨。出了什么问题？我的意思是，如果"}, {"type": "subtitle", "time": 9161.349, "timestamp": "02:32:41", "text": "这只是个角色，就让它这样吧。"}, {"type": "subtitle", "time": 9163.429, "timestamp": "02:32:43", "text": "它让那个版本的角色得以存在。"}, {"type": "subtitle", "time": 9165.11, "timestamp": "02:32:45", "text": "和他们一起用你那个版本"}, {"type": "subtitle", "time": 9167.51, "timestamp": "02:32:47", "text": "例如，版本信息请转到 I"}, {"type": "subtitle", "time": 9169.349, "timestamp": "02:32:49", "text": "请尊重他。我真的非常喜欢"}, {"type": "subtitle", "time": 9171.75, "timestamp": "02:32:51", "text": "那个人，但我确实尊重他。"}, {"type": "subtitle", "time": 9173.349, "timestamp": "02:32:53", "text": "这是我的版本。我想保留它"}, {"type": "subtitle", "time": 9175.51, "timestamp": "02:32:55", "text": "这样比较安全。所以，如果还有其他人有"}, {"type": "subtitle", "time": 9177.83, "timestamp": "02:32:57", "text": "他们可以进去，他们可以拥有"}, {"type": "subtitle", "time": 9179.03, "timestamp": "02:32:59", "text": "他们可以为所欲为。它是"}]
[{"type": "subtitle", "time": 15121.99, "timestamp": "04:12:01", "text": "显然是为了保留这种感觉，但是"}, {"type": "subtitle", "time": 15123.429, "timestamp": "04:12:03", "text": "而且我也正好证明了你的观点。所以我是"}, {"type": "subtitle", "time": 15126.71, "timestamp": "04:12:06", "text": "我打算选择一级。同意。"}, {"type": "subtitle", "time": 15128.95, "timestamp": "04:12:08", "text": "老兄，很高兴你把一切都解释清楚了。"}, {"type": "subtitle", "time": 15132.99, "timestamp": "04:12:12", "text": "线。现在我获得了更多许可"}, {"type": "subtitle", "time": 15137.429, "timestamp": "04:12:17", "text": "这些问题更像是……"}, {"type": "subtitle", "time": 15140.229, "timestamp": "04:12:20", "text": "明晰。"}, {"type": "subtitle", "time": 15143.63, "timestamp": "04:12:23", "text": "是的。是的。这些问题是"}, {"type": "subtitle", "time": 15146.15, "timestamp": "04:12:26", "text": "人口统计问题，比如他们非常"}, {"type": "subtitle", "time": 15149.59, "timestamp": "04:12:29", "text": "年轻人提出疑问。所以这些都是非常"}, {"type": "subtitle", "time": 15152.71, "timestamp": "04:12:32", "text": "就像红色或蓝色一样，随便挑一个。"}, {"type": "subtitle", "time": 15156.309, "timestamp": "04:12:36", "text": "团队选择某种团队或哪种类型的"}, {"type": "subtitle", "time": 15159.51, "timestamp": "04:12:39", "text": "姓名。所以你知道没问题。你你"}, {"type": "subtitle", "time": 15161.309, "timestamp": "04:12:41", "text": "通常等别人介绍"}, {"type": "subtitle", "time": 15165.11, "timestamp": "04:12:45", "text": "他们自己。是的，我通常会这样做。"}, {"type": "subtitle", "time": 15167.67, "timestamp": "04:12:47", "text": "那。是啊，我也是。通常等待"}, {"type": "subtitle", "time": 15169.91, "timestamp": "04:12:49", "text": "有些人喜欢先说话，然后再点赞"}, {"type": "subtitle", "time": 15171.67, "timestamp": "04:12:51", "text": "他们让自己放松下来，然后你"}, {"type": "subtitle", "time": 15173.99, "timestamp": "04:12:53", "text": "去跟他们谈谈。你的情绪变化可能非常大"}, {"type": "subtitle", "time": 15174.91, "timestamp": "04:12:54", "text": "迅速地。"}, {"type": "subtitle", "time": 15178.63, "timestamp": "04:12:58", "text": "不，不。你，你必须真的"}]
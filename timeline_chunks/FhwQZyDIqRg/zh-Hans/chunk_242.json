[{"type": "subtitle", "time": 14522.229, "timestamp": "04:02:02", "text": "月，随便吧。你必须接受切割和"}, {"type": "subtitle", "time": 14524.55, "timestamp": "04:02:04", "text": "与你的人民相处融洽。有时你"}, {"type": "subtitle", "time": 14526.59, "timestamp": "04:02:06", "text": "必须这么做，才能成功。"}, {"type": "subtitle", "time": 14529.189, "timestamp": "04:02:09", "text": "高效的。你得劝他们冷静下来"}, {"type": "subtitle", "time": 14531.349, "timestamp": "04:02:11", "text": "某个时候。你必须对他们大吼。"}, {"type": "subtitle", "time": 14534.07, "timestamp": "04:02:14", "text": "你必须，你必须有一天……"}, {"type": "subtitle", "time": 14536.469, "timestamp": "04:02:16", "text": "一天。你必须变得卑鄙。"}, {"type": "subtitle", "time": 14539.67, "timestamp": "04:02:19", "text": "你一直讨厌的那个人。你有"}, {"type": "subtitle", "time": 14543.83, "timestamp": "04:02:23", "text": "去那里完成你的工作"}, {"type": "subtitle", "time": 14546.469, "timestamp": "04:02:26", "text": "有时。"}, {"type": "subtitle", "time": 14550.189, "timestamp": "04:02:30", "text": "即使是，是的。所以我倾向于这个观点。"}, {"type": "subtitle", "time": 14552.87, "timestamp": "04:02:32", "text": "效率。如果想象一下这个，我已经"}, {"type": "subtitle", "time": 14555.99, "timestamp": "04:02:35", "text": "我和同事们一起工作到很晚。"}, {"type": "subtitle", "time": 14558.469, "timestamp": "04:02:38", "text": "有一天，什么事都做不成。你是"}, {"type": "subtitle", "time": 14561.59, "timestamp": "04:02:41", "text": "生气了，听着，我"}, {"type": "subtitle", "time": 14564.95, "timestamp": "04:02:44", "text": "希望立刻完成这件事。我不在乎"}, {"type": "subtitle", "time": 14566.87, "timestamp": "04:02:46", "text": "你是怎么做到的？我不知道你是做什么的。"}, {"type": "subtitle", "time": 14570.389, "timestamp": "04:02:50", "text": "它。好的。不管是什么魔法"}, {"type": "subtitle", "time": 14573.99, "timestamp": "04:02:53", "text": "你来做，完成它。我不在乎。但"}, {"type": "subtitle", "time": 14576.15, "timestamp": "04:02:56", "text": "这需要几个月的时间。我不在乎。照做就行了"}, {"type": "subtitle", "time": 14579.269, "timestamp": "04:02:59", "text": "它。我给了你几个月的时间。你还没完成。"}]
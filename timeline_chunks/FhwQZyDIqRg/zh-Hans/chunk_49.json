[{"type": "subtitle", "time": 2944.15, "timestamp": "00:49:04", "text": "等等，他为什么还没苏醒？"}, {"type": "subtitle", "time": 2947.43, "timestamp": "00:49:07", "text": "哦，你施法之后他就会复活。"}, {"type": "subtitle", "time": 2950.47, "timestamp": "00:49:10", "text": "所以，我们得把他留在这里。不，我们"}, {"type": "subtitle", "time": 2952.79, "timestamp": "00:49:12", "text": "必须前往另一个撤离点。"}, {"type": "subtitle", "time": 2956.79, "timestamp": "00:49:16", "text": "该提取点已关闭。哦，我们"}, {"type": "subtitle", "time": 2958.63, "timestamp": "00:49:18", "text": "需要找些东西。顺便说一句，我只有"}, {"type": "subtitle", "time": 2961.91, "timestamp": "00:49:21", "text": "我的马力只有26匹，所以基本上完​​蛋了。相同的。"}, {"type": "subtitle", "time": 2965.349, "timestamp": "00:49:25", "text": "我可以把我的HP给你吗？"}, {"type": "subtitle", "time": 2973.99, "timestamp": "00:49:33", "text": "呃，我觉得你现在还不能给。"}, {"type": "subtitle", "time": 2976.15, "timestamp": "00:49:36", "text": "是的，你做到了。哦，是的。"}, {"type": "subtitle", "time": 2981.19, "timestamp": "00:49:41", "text": "你是怎么做到的？我觉得它速度很慢。"}, {"type": "subtitle", "time": 2982.71, "timestamp": "00:49:42", "text": "别看它。别看它。"}, {"type": "subtitle", "time": 2984.95, "timestamp": "00:49:44", "text": "别看它。别看，乔。"}, {"type": "subtitle", "time": 2986.47, "timestamp": "00:49:46", "text": "别看它。别看。别看。"}, {"type": "subtitle", "time": 2987.75, "timestamp": "00:49:47", "text": "别看。嘿，我想看看。"}, {"type": "subtitle", "time": 2990.27, "timestamp": "00:49:50", "text": "太酷了。再来一次。"}, {"type": "subtitle", "time": 2994.15, "timestamp": "00:49:54", "text": "什么？兄弟，"}, {"type": "subtitle", "time": 2997.51, "timestamp": "00:49:57", "text": "我的天啊。"}, {"type": "subtitle", "time": 2998.87, "timestamp": "00:49:58", "text": "好的，他来了。他来了。跑步。"}]
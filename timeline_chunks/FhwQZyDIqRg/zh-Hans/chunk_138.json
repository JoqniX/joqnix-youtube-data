[{"type": "subtitle", "time": 8293.669, "timestamp": "02:18:13", "text": "是的。好的。好的。"}, {"type": "subtitle", "time": 8296.07, "timestamp": "02:18:16", "text": "我是白人。我这是在挪用资源吗？我看到一个"}, {"type": "subtitle", "time": 8299.349, "timestamp": "02:18:19", "text": "真正的文化是通过佩戴卡（ka）去某些地方。"}, {"type": "subtitle", "time": 8302.549, "timestamp": "02:18:22", "text": "并且我的身上被画上了纳粹标志"}, {"type": "subtitle", "time": 8304.429, "timestamp": "02:18:24", "text": "发生了什么？"}, {"type": "subtitle", "time": 8307.589, "timestamp": "02:18:27", "text": "乌胡斯，我爸爸，谁问了谁问了"}, {"type": "subtitle", "time": 8310.07, "timestamp": "02:18:30", "text": "素食者。他问我是不是白人。我是谁？"}, {"type": "subtitle", "time": 8312.23, "timestamp": "02:18:32", "text": "通过挪用印度文化"}, {"type": "subtitle", "time": 8314.309, "timestamp": "02:18:34", "text": "穿着 ka 去某些地方，并且有 swas"}, {"type": "subtitle", "time": 8318.87, "timestamp": "02:18:38", "text": "画在我自己身上？不。什么？"}, {"type": "subtitle", "time": 8321.589, "timestamp": "02:18:41", "text": "我觉得没人会在意。是的。是的。"}, {"type": "subtitle", "time": 8323.509, "timestamp": "02:18:43", "text": "我不认为任何人应该这么想"}, {"type": "subtitle", "time": 8326.389, "timestamp": "02:18:46", "text": "是的。谁都不应该这样做。是的。那里有我吗？"}, {"type": "subtitle", "time": 8328.629, "timestamp": "02:18:48", "text": "我的意思是，这其实挺搞笑的，因为"}, {"type": "subtitle", "time": 8331.27, "timestamp": "02:18:51", "text": "好像人们会因为你做的任何事而评判你。"}, {"type": "subtitle", "time": 8333.75, "timestamp": "02:18:53", "text": "任何事物。这其实挺搞笑的，因为"}, {"type": "subtitle", "time": 8335.589, "timestamp": "02:18:55", "text": "你穿着一件动漫T恤，人们"}, {"type": "subtitle", "time": 8339.03, "timestamp": "02:18:59", "text": "我会因此评判你。我知道。"}]
[{"type": "subtitle", "time": 10320.55, "timestamp": "02:52:00", "text": "不要松开鼠标左键。只是"}, {"type": "subtitle", "time": 10322.389, "timestamp": "02:52:02", "text": "继续坚持。好吧，我不干了。我拿着"}, {"type": "subtitle", "time": 10324.55, "timestamp": "02:52:04", "text": "它。大家都到齐了。我要去……"}, {"type": "subtitle", "time": 10331.59, "timestamp": "02:52:11", "text": "我正在做。我正在做。我正在做"}, {"type": "subtitle", "time": 10334.15, "timestamp": "02:52:14", "text": "它。我正在做。我不会放手"}, {"type": "subtitle", "time": 10338.75, "timestamp": "02:52:18", "text": "只保留"}, {"type": "subtitle", "time": 10342.79, "timestamp": "02:52:22", "text": "持续发送垃圾邮件。我100岁了。太棒了！"}, {"type": "subtitle", "time": 10344.95, "timestamp": "02:52:24", "text": "看？呃，"}, {"type": "subtitle", "time": 10347.83, "timestamp": "02:52:27", "text": "那不是我的。那不是我的。那"}, {"type": "subtitle", "time": 10350.23, "timestamp": "02:52:30", "text": "不是我的。我喜欢做这件事。这是"}, {"type": "subtitle", "time": 10359.349, "timestamp": "02:52:39", "text": "完全是打算加入游戏里的，"}, {"type": "subtitle", "time": 10361.11, "timestamp": "02:52:41", "text": "伙计们。你是什​​么意思？各位，我……"}, {"type": "subtitle", "time": 10364.79, "timestamp": "02:52:44", "text": "买了两个体力包，可能还有一个"}, {"type": "subtitle", "time": 10367.99, "timestamp": "02:52:47", "text": "它们就是我的这个呃冲刺速度是"}, {"type": "subtitle", "time": 10371.19, "timestamp": "02:52:51", "text": "我的，是的。是的。我的天哪。看着我。"}, {"type": "subtitle", "time": 10374.59, "timestamp": "02:52:54", "text": "你的耐力就在那里，"}]
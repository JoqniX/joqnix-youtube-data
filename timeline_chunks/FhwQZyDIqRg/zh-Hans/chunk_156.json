[{"type": "subtitle", "time": 9360.71, "timestamp": "02:36:00", "text": "对不起。"}, {"type": "subtitle", "time": 9362.03, "timestamp": "02:36:02", "text": "他是"}, {"type": "subtitle", "time": 9364.15, "timestamp": "02:36:04", "text": "他真的在那里。他在那里。他是"}, {"type": "subtitle", "time": 9367.27, "timestamp": "02:36:07", "text": "那里。哦，该死。"}, {"type": "subtitle", "time": 9370.51, "timestamp": "02:36:10", "text": "接下来会发生什么？哦，不。"}, {"type": "subtitle", "time": 9374.71, "timestamp": "02:36:14", "text": "哦好的。它不见了。"}, {"type": "subtitle", "time": 9378.15, "timestamp": "02:36:18", "text": "我敲了敲我的……是的，我敲了敲自己的头。"}, {"type": "subtitle", "time": 9382.55, "timestamp": "02:36:22", "text": "你。哇。那是什么？哦，怎么回事？"}, {"type": "subtitle", "time": 9387.75, "timestamp": "02:36:27", "text": "[掌声]"}, {"type": "subtitle", "time": 9388.59, "timestamp": "02:36:28", "text": "哦"}, {"type": "subtitle", "time": 9397.03, "timestamp": "02:36:37", "text": "第没关系。没人看到。是的，"}, {"type": "subtitle", "time": 9410.26, "timestamp": "02:36:50", "text": "哦，太棒了。我得到了"}]
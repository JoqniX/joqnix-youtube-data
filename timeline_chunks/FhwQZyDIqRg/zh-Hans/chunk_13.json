[{"type": "subtitle", "time": 789.67, "timestamp": "00:13:09", "text": "知道。闪闪发光。嗨，Sparkle。谢谢。哦，"}, {"type": "subtitle", "time": 796.389, "timestamp": "00:13:16", "text": "它。其他表情符号有点太多了。"}, {"type": "subtitle", "time": 801.11, "timestamp": "00:13:21", "text": "我应该禁用它们吗？"}, {"type": "subtitle", "time": 803.71, "timestamp": "00:13:23", "text": "[音乐]"}, {"type": "subtitle", "time": 812.03, "timestamp": "00:13:32", "text": "它。这就是我"}, {"type": "subtitle", "time": 831.91, "timestamp": "00:13:51", "text": "它？这背后其实有个故事。"}, {"type": "subtitle", "time": 835.59, "timestamp": "00:13:55", "text": "我稍后告诉你。我为那些"}, {"type": "subtitle", "time": 838.23, "timestamp": "00:13:58", "text": "就像我的观众一样，你们"}]
[{"type": "subtitle", "time": 5700.47, "timestamp": "01:35:00", "text": "她来了。她来了。我们？嗯？我们开始吧"}, {"type": "subtitle", "time": 5702.95, "timestamp": "01:35:02", "text": "去。我们走吧。上车。"}, {"type": "subtitle", "time": 5705.27, "timestamp": "01:35:05", "text": "想象一下，我悄悄地开始了。"}, {"type": "subtitle", "time": 5706.95, "timestamp": "01:35:06", "text": "伙计们，这里有只小鸭子。我不"}, {"type": "subtitle", "time": 5711.189, "timestamp": "01:35:11", "text": "知道。不要碰它。不要碰它。哦"}, {"type": "subtitle", "time": 5715.59, "timestamp": "01:35:15", "text": "我的上帝。我的天啊。我没碰它。"}, {"type": "subtitle", "time": 5719.91, "timestamp": "01:35:19", "text": "我的天哪。妈的。我的天啊。这"}, {"type": "subtitle", "time": 5725.59, "timestamp": "01:35:25", "text": "他妈的？你说过那个时机。我的天啊。"}, {"type": "subtitle", "time": 5728.55, "timestamp": "01:35:28", "text": "宝贝，你说过在我……的时候别碰它"}, {"type": "subtitle", "time": 5731.51, "timestamp": "01:35:31", "text": "正在触摸它。我的天啊。嗯，你"}, {"type": "subtitle", "time": 5734.149, "timestamp": "01:35:34", "text": "它说它会变成一个"}, {"type": "subtitle", "time": 5738.79, "timestamp": "01:35:38", "text": "僵尸。哦，不。妈的。没错。如何"}, {"type": "subtitle", "time": 5741.99, "timestamp": "01:35:41", "text": "我们拥有多少？我们有13000个。我会得到"}, {"type": "subtitle", "time": 5744.55, "timestamp": "01:35:44", "text": "我要来个翻滚跳跃。翻滚"}, {"type": "subtitle", "time": 5746.709, "timestamp": "01:35:46", "text": "发射。我打算买一个。你正在获得"}, {"type": "subtitle", "time": 5751.189, "timestamp": "01:35:51", "text": "什么？嗯……翻滚跳跃。是的。这"}, {"type": "subtitle", "time": 5752.79, "timestamp": "01:35:52", "text": "混蛋。现在别选它，因为"}, {"type": "subtitle", "time": 5755.189, "timestamp": "01:35:55", "text": "大概1万块吧，兄弟。不，没事了。你"}, {"type": "subtitle", "time": 5757.83, "timestamp": "01:35:57", "text": "可以挑选。没关系。 5公里。对不起。是的。"}]
[{"type": "subtitle", "time": 6900.79, "timestamp": "01:55:00", "text": "你。不。是谁先挑起的？我告诉他不要"}, {"type": "subtitle", "time": 6902.55, "timestamp": "01:55:02", "text": "直到你教会她怎么做为止。"}, {"type": "subtitle", "time": 6906.229, "timestamp": "01:55:06", "text": "它。嗯，那个人不是你，而是他。我们开始吧"}, {"type": "subtitle", "time": 6910.149, "timestamp": "01:55:10", "text": "分享惠普。没关系。"}, {"type": "subtitle", "time": 6915.03, "timestamp": "01:55:15", "text": "我当时真是个傻瓜。我当时正在处理我的"}, {"type": "subtitle", "time": 6916.55, "timestamp": "01:55:16", "text": "延长线。我没听到。"}, {"type": "subtitle", "time": 6918.07, "timestamp": "01:55:18", "text": "我们走吧。"}, {"type": "subtitle", "time": 6920.79, "timestamp": "01:55:20", "text": "我跟你分享了很多。这一切都是"}, {"type": "subtitle", "time": 6922.709, "timestamp": "01:55:22", "text": "正确的。没关系。没问题。它是"}, {"type": "subtitle", "time": 6924.79, "timestamp": "01:55:24", "text": "好的。没关系。我们走吧。我们开始吧"}, {"type": "subtitle", "time": 6928.39, "timestamp": "01:55:28", "text": "去。你的祖先是猫。是吗？等级"}, {"type": "subtitle", "time": 6929.91, "timestamp": "01:55:29", "text": "三。"}, {"type": "subtitle", "time": 6932.31, "timestamp": "01:55:32", "text": "真抱歉，泽诺。我就是。它是"}, {"type": "subtitle", "time": 6934.55, "timestamp": "01:55:34", "text": "好的。没关系。没关系。没关系。"}, {"type": "subtitle", "time": 6942.75, "timestamp": "01:55:42", "text": "不管那是什么鬼东西"}, {"type": "subtitle", "time": 6950.07, "timestamp": "01:55:50", "text": "哦，嘿，那看起来很危险。请"}, {"type": "subtitle", "time": 6951.99, "timestamp": "01:55:51", "text": "停留"}, {"type": "subtitle", "time": 6957.43, "timestamp": "01:55:57", "text": "物体看起来很危险。我的天啊。任何事物"}, {"type": "subtitle", "time": 6959.27, "timestamp": "01:55:59", "text": "看起来很危险，简直吓死人了。"}]
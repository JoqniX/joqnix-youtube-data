[{"type": "subtitle", "time": 6360.55, "timestamp": "01:46:00", "text": "我想这就是全部了，伙计们。萃取"}, {"type": "subtitle", "time": 6364.709, "timestamp": "01:46:04", "text": "观点。哦，原来是这样。"}, {"type": "subtitle", "time": 6367.75, "timestamp": "01:46:07", "text": "未来。有人能帮我解决一下“哦”这个问题吗？"}, {"type": "subtitle", "time": 6370.629, "timestamp": "01:46:10", "text": "小心。是啊，是啊，是啊。"}, {"type": "subtitle", "time": 6372.629, "timestamp": "01:46:12", "text": "我不知道。另外，我当时并没有付款。"}, {"type": "subtitle", "time": 6374.07, "timestamp": "01:46:14", "text": "注意力。你可以说脏话吗？"}, {"type": "subtitle", "time": 6376.629, "timestamp": "01:46:16", "text": "不是？哦，是的，你可以这么说。"}, {"type": "subtitle", "time": 6378.07, "timestamp": "01:46:18", "text": "如果你愿意，妈妈会帮你决定。是的。是的。"}, {"type": "subtitle", "time": 6380.229, "timestamp": "01:46:20", "text": "是的，可以。没关系。但要记住"}, {"type": "subtitle", "time": 6390.39, "timestamp": "01:46:30", "text": "妈的。我得到了它。我得到了它。我得到了它。我"}, {"type": "subtitle", "time": 6392.07, "timestamp": "01:46:32", "text": "知道了。我得到了它。我得到了它。我得到了它。我们"}, {"type": "subtitle", "time": 6393.99, "timestamp": "01:46:33", "text": "知道了。妈的。好的。没关系。"}, {"type": "subtitle", "time": 6396.07, "timestamp": "01:46:36", "text": "没关系。再多一点。很多。"}, {"type": "subtitle", "time": 6398.47, "timestamp": "01:46:38", "text": "它仍然很值钱。是的。哦，是的"}, {"type": "subtitle", "time": 6400.39, "timestamp": "01:46:40", "text": "就在这里。过来。就在这里。"}, {"type": "subtitle", "time": 6402.31, "timestamp": "01:46:42", "text": "一直往前走。就这样。"}, {"type": "subtitle", "time": 6405.27, "timestamp": "01:46:45", "text": "就这样。你可以杀死那只鸭子。"}, {"type": "subtitle", "time": 6410.149, "timestamp": "01:46:50", "text": "绿色药水。啊，我明白了。哦，不错。"}, {"type": "subtitle", "time": 6412.229, "timestamp": "01:46:52", "text": "我太喜欢这种声音的模仿了。"}, {"type": "subtitle", "time": 6418.07, "timestamp": "01:46:58", "text": "我不明白为什么人们会问我是否"}]
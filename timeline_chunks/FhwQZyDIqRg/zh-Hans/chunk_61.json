[{"type": "subtitle", "time": 3660.95, "timestamp": "01:01:00", "text": "看起来像“你好”。"}, {"type": "subtitle", "time": 3662.47, "timestamp": "01:01:02", "text": "感觉就像你不知道该去哪里一样。我"}, {"type": "subtitle", "time": 3664.309, "timestamp": "01:01:04", "text": "哦，你看，瞧瞧她。她真可爱。"}, {"type": "subtitle", "time": 3666.15, "timestamp": "01:01:06", "text": "她没事，她不知道该去哪里"}, {"type": "subtitle", "time": 3667.99, "timestamp": "01:01:07", "text": "去。我真希望我能帮到她。为什么不能"}, {"type": "subtitle", "time": 3669.589, "timestamp": "01:01:09", "text": "我们化作幽灵，帮助他们指引方向"}, {"type": "subtitle", "time": 3670.95, "timestamp": "01:01:10", "text": "比如直接指挥他们之类的？那"}, {"type": "subtitle", "time": 3672.549, "timestamp": "01:01:12", "text": "应该像这样：那真是太好了"}, {"type": "subtitle", "time": 3674.95, "timestamp": "01:01:14", "text": "很酷吧？我们最终会变成幽灵，"}, {"type": "subtitle", "time": 3677.589, "timestamp": "01:01:17", "text": "帮助他们，他们就会喜欢"}, {"type": "subtitle", "time": 3679.19, "timestamp": "01:01:19", "text": "比如增加难度。就告诉他们。"}, {"type": "subtitle", "time": 3681.03, "timestamp": "01:01:21", "text": "你能听到你的声音。"}, {"type": "subtitle", "time": 3683.589, "timestamp": "01:01:23", "text": "几乎"}, {"type": "subtitle", "time": 3685.91, "timestamp": "01:01:25", "text": "就像有一种方法可以做到"}, {"type": "subtitle", "time": 3688.15, "timestamp": "01:01:28", "text": "和那些致命的家伙在一起，我不这么认为"}, {"type": "subtitle", "time": 3689.829, "timestamp": "01:01:29", "text": "你觉得你可以在这款游戏中做到这一点。哦"}, {"type": "subtitle", "time": 3692.47, "timestamp": "01:01:32", "text": "拉屎。是的。很遗憾，"}, {"type": "subtitle", "time": 3694.47, "timestamp": "01:01:34", "text": "很遗憾。接球。拿"}, {"type": "subtitle", "time": 3697.109, "timestamp": "01:01:37", "text": "球。把球留在那儿。是的。好的。"}, {"type": "subtitle", "time": 3700.069, "timestamp": "01:01:40", "text": "球。是的。有个球，花了我"}, {"type": "subtitle", "time": 3701.91, "timestamp": "01:01:41", "text": "不知道具体多少。就像我不喜欢"}, {"type": "subtitle", "time": 3703.349, "timestamp": "01:01:43", "text": "知道。我甚至不知道那是什么东西。"}, {"type": "subtitle", "time": 3705.39, "timestamp": "01:01:45", "text": "是。"}, {"type": "subtitle", "time": 3708.34, "timestamp": "01:01:48", "text": "哦，一堆小玩意儿。实际上，"}, {"type": "subtitle", "time": 3709.589, "timestamp": "01:01:49", "text": "[音乐]"}, {"type": "subtitle", "time": 3711.03, "timestamp": "01:01:51", "text": "他们至少应该来。我认为他们"}, {"type": "subtitle", "time": 3712.95, "timestamp": "01:01:52", "text": "应该移至撤离点"}, {"type": "subtitle", "time": 3715.67, "timestamp": "01:01:55", "text": "因为他们应该这样做。是的，"}, {"type": "subtitle", "time": 3717.349, "timestamp": "01:01:57", "text": "他们少了一个。大部分空间"}]
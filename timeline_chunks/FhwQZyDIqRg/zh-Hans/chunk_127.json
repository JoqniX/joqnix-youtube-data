[{"type": "subtitle", "time": 7622.31, "timestamp": "02:07:02", "text": "2025年的人竟然如此不成熟，真是令人难以置信。"}, {"type": "subtitle", "time": 7624.55, "timestamp": "02:07:04", "text": "必须发送垃圾邮件。"}, {"type": "subtitle", "time": 7628.069, "timestamp": "02:07:08", "text": "兄弟，他们是在发垃圾邮件。真是糟了，"}, {"type": "subtitle", "time": 7631.43, "timestamp": "02:07:11", "text": "角落里的甘。搞什么鬼？"}, {"type": "subtitle", "time": 7634.069, "timestamp": "02:07:14", "text": "没关系。小矮人出现了。"}, {"type": "subtitle", "time": 7636.87, "timestamp": "02:07:16", "text": "该死。我应该直接从他们身边跳过去。"}, {"type": "subtitle", "time": 7640.31, "timestamp": "02:07:20", "text": "不。她难道不知道我们都死了吗？"}, {"type": "subtitle", "time": 7642.229, "timestamp": "02:07:22", "text": "可能不会。"}, {"type": "subtitle", "time": 7644.79, "timestamp": "02:07:24", "text": "我的天哪。"}, {"type": "subtitle", "time": 7648.149, "timestamp": "02:07:28", "text": "它去了那里。我们都死了。"}, {"type": "subtitle", "time": 7650.79, "timestamp": "02:07:30", "text": "我们都死了。这不是《大丈》。"}, {"type": "subtitle", "time": 7652.91, "timestamp": "02:07:32", "text": "任何地方。是的，不是这样的。"}, {"type": "subtitle", "time": 7655.669, "timestamp": "02:07:35", "text": "大宇。完全不是。"}, {"type": "subtitle", "time": 7658.629, "timestamp": "02:07:38", "text": "嗯。用炸弹把人炸死。我敢肯定"}, {"type": "subtitle", "time": 7661.27, "timestamp": "02:07:41", "text": "独自的。是的，我们只需要跑到……"}, {"type": "subtitle", "time": 7662.87, "timestamp": "02:07:42", "text": "萃取。"}, {"type": "subtitle", "time": 7666.709, "timestamp": "02:07:46", "text": "是的，我相信"}, {"type": "subtitle", "time": 7669.44, "timestamp": "02:07:49", "text": "我相信 我不相信夏树。至少"}, {"type": "subtitle", "time": 7673.52, "timestamp": "02:07:53", "text": "我不相信夏树。至少 芝诺走错了方向。相信"}, {"type": "subtitle", "time": 7675.84, "timestamp": "02:07:55", "text": "芝诺走错了方向。相信 芝诺。我不相信夏树"}, {"type": "subtitle", "time": 7677.44, "timestamp": "02:07:57", "text": "芝诺。我不相信夏树 因为他是个仇恨者。哦，原来是你啊。我"}]
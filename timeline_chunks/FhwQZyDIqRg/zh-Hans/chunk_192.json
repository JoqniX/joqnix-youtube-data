[{"type": "subtitle", "time": 11520.23, "timestamp": "03:12:00", "text": "等我一下。我真的是吗？我真的是吗？"}, {"type": "subtitle", "time": 11523.11, "timestamp": "03:12:03", "text": "可能是我的网络问题。可能是我的"}, {"type": "subtitle", "time": 11525.269, "timestamp": "03:12:05", "text": "互联网。不知道。那是另一个吗？"}, {"type": "subtitle", "time": 11528.469, "timestamp": "03:12:08", "text": "虚拟主播？是的，这是维克多。梅诺伊。这"}, {"type": "subtitle", "time": 11529.55, "timestamp": "03:12:09", "text": "是"}, {"type": "subtitle", "time": 11533.349, "timestamp": "03:12:13", "text": "维多利亚吸血鬼维。是维诺瓦。先生。"}, {"type": "subtitle", "time": 11534.95, "timestamp": "03:12:14", "text": "雅克。"}, {"type": "subtitle", "time": 11538.389, "timestamp": "03:12:18", "text": "梅诺伊。正确的。维诺伊。"}, {"type": "subtitle", "time": 11541.91, "timestamp": "03:12:21", "text": "不。维诺伊。我的天。维诺伊。什么？不。维诺伊。"}, {"type": "subtitle", "time": 11544.95, "timestamp": "03:12:24", "text": "维诺伊。它是"}, {"type": "subtitle", "time": 11549.83, "timestamp": "03:12:29", "text": "reenoi。这不是备忘录。你说M。"}, {"type": "subtitle", "time": 11553.11, "timestamp": "03:12:33", "text": "哦好的。不，不。你不说M的"}, {"type": "subtitle", "time": 11555.269, "timestamp": "03:12:35", "text": "保持沉默。这两个M都是"}, {"type": "subtitle", "time": 11559.03, "timestamp": "03:12:39", "text": "顺便说一句，他很安静。好的。瓦诺伊。"}, {"type": "subtitle", "time": 11561.51, "timestamp": "03:12:41", "text": "好的。我一直都叫错你的名字"}, {"type": "subtitle", "time": 11564.63, "timestamp": "03:12:44", "text": "这些年。什么？"}, {"type": "subtitle", "time": 11566.19, "timestamp": "03:12:46", "text": "不，你是"}, {"type": "subtitle", "time": 11568.63, "timestamp": "03:12:48", "text": "美好的。你知道吗？你知道吗？只是"}, {"type": "subtitle", "time": 11571.03, "timestamp": "03:12:51", "text": "叫我Muy。"}, {"type": "subtitle", "time": 11574.309, "timestamp": "03:12:54", "text": "没关系。我会稍后给你回电话。是的，"}, {"type": "chat", "time": 11576.277, "timestamp": "03:12:56", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "mrinmoy is my brother's name"}, {"type": "subtitle", "time": 11576.79, "timestamp": "03:12:56", "text": "就像我这些年来一直称呼你的那样。"}]
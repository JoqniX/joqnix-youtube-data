[{"type": "subtitle", "time": 14641.03, "timestamp": "04:04:01", "text": "管理得非常好，他们真是太棒了"}, {"type": "subtitle", "time": 14644.15, "timestamp": "04:04:04", "text": "漂亮的沙发，我忍不住要尖叫"}, {"type": "subtitle", "time": 14650.03, "timestamp": "04:04:10", "text": "一直都是他们。嗯，是的。嗯嗯"}, {"type": "subtitle", "time": 14652.87, "timestamp": "04:04:12", "text": "是啊，有时候我就让他们自生自灭。"}, {"type": "subtitle", "time": 14656.229, "timestamp": "04:04:16", "text": "有时候，嗯，我不，有时候……"}, {"type": "subtitle", "time": 14657.99, "timestamp": "04:04:17", "text": "会表现得好像我不在乎了，但是"}, {"type": "subtitle", "time": 14660.63, "timestamp": "04:04:20", "text": "有时工作会像这样被给予"}, {"type": "subtitle", "time": 14663.51, "timestamp": "04:04:23", "text": "对我来说，然后我就会想，好吧，我想要"}, {"type": "subtitle", "time": 14666.309, "timestamp": "04:04:26", "text": "这些事情现在都已经完成了。"}, {"type": "subtitle", "time": 14668.309, "timestamp": "04:04:28", "text": "他们说，哦，至少有两个。"}, {"type": "subtitle", "time": 14670.79, "timestamp": "04:04:30", "text": "预约什么的我不在乎，赶紧结束吧。"}, {"type": "subtitle", "time": 14674.15, "timestamp": "04:04:34", "text": "我会在他们附近指导他们。"}, {"type": "subtitle", "time": 14677.03, "timestamp": "04:04:37", "text": "直到他们完成为止"}, {"type": "subtitle", "time": 14679.349, "timestamp": "04:04:39", "text": "恨你那天做的事，但我不在乎。我"}, {"type": "subtitle", "time": 14681.79, "timestamp": "04:04:41", "text": "希望这项工作完成。我想要所有这些"}, {"type": "subtitle", "time": 14684.389, "timestamp": "04:04:44", "text": "已签名。那是我的。我不"}, {"type": "subtitle", "time": 14686.269, "timestamp": "04:04:46", "text": "关心。他们恨我。你看，我是"}, {"type": "subtitle", "time": 14688.63, "timestamp": "04:04:48", "text": "忽略情感因素"}, {"type": "subtitle", "time": 14690.71, "timestamp": "04:04:50", "text": "效率"}, {"type": "subtitle", "time": 14697.429, "timestamp": "04:04:57", "text": "完毕。你注重效率和严谨性。"}, {"type": "subtitle", "time": 14699.83, "timestamp": "04:04:59", "text": "即使它的意思是“是”。我同意。"}]
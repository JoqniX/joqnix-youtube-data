[{"type": "subtitle", "time": 3061.03, "timestamp": "00:51:01", "text": "不。哦，不。"}, {"type": "subtitle", "time": 3065.67, "timestamp": "00:51:05", "text": "快跑，快跑，快跑。我该如何跑步？转移。哦，"}, {"type": "subtitle", "time": 3068.309, "timestamp": "00:51:08", "text": "等待。没关系。没关系。哦。哦，我们"}, {"type": "subtitle", "time": 3070.63, "timestamp": "00:51:10", "text": "转移。哦。我的天啊。我们没有复活"}, {"type": "subtitle", "time": 3072.39, "timestamp": "00:51:12", "text": "那个人。他和我的想法是对的。我们俩"}, {"type": "subtitle", "time": 3074.23, "timestamp": "00:51:14", "text": "他们一起死去。他在哪儿？他就在里面"}, {"type": "subtitle", "time": 3076.71, "timestamp": "00:51:16", "text": "就是这个东西。它在车里。"}, {"type": "subtitle", "time": 3080.63, "timestamp": "00:51:20", "text": "是的。我的天哪。他为什么不去？我们"}, {"type": "subtitle", "time": 3081.75, "timestamp": "00:51:21", "text": "还需要找到第二个"}, {"type": "subtitle", "time": 3084.87, "timestamp": "00:51:24", "text": "萃取。就这些吗？是的。我们确实需要"}, {"type": "subtitle", "time": 3087.19, "timestamp": "00:51:27", "text": "一个"}, {"type": "subtitle", "time": 3088.589, "timestamp": "00:51:28", "text": "哦，"}, {"type": "subtitle", "time": 3097.349, "timestamp": "00:51:37", "text": "我不知道它是不是已经没了，兄弟。我们"}, {"type": "subtitle", "time": 3098.63, "timestamp": "00:51:38", "text": "目标完成了吗？喜欢，"}, {"type": "subtitle", "time": 3101.27, "timestamp": "00:51:41", "text": "我们只需要让他们复活。我认为我们"}, {"type": "subtitle", "time": 3102.47, "timestamp": "00:51:42", "text": "需要找到第二个干扰因素"}, {"type": "subtitle", "time": 3104.63, "timestamp": "00:51:44", "text": "指着，然后找更多东西放进去。"}, {"type": "subtitle", "time": 3107.589, "timestamp": "00:51:47", "text": "那个东西。是的。哇。那是哪里？"}, {"type": "subtitle", "time": 3111.109, "timestamp": "00:51:51", "text": "血是什么？就像右上角那个一样"}, {"type": "subtitle", "time": 3113.27, "timestamp": "00:51:53", "text": "角落。上面写的是“一个一个地来”。所以，"}, {"type": "subtitle", "time": 3115.349, "timestamp": "00:51:55", "text": "顶部只有一个，"}, {"type": "subtitle", "time": 3117.03, "timestamp": "00:51:57", "text": "正确的？"}, {"type": "subtitle", "time": 3119.43, "timestamp": "00:51:59", "text": "嗯，是的。一个提取点。走，走，"}]
[{"type": "subtitle", "time": 5940.31, "timestamp": "01:39:00", "text": "拉屎。过来，伙计们。你撒谎了。我"}, {"type": "subtitle", "time": 5941.99, "timestamp": "01:39:01", "text": "我有两个耐力升级道具，通过……"}, {"type": "subtitle", "time": 5946.87, "timestamp": "01:39:06", "text": "方式。哦，不错。蓝色的那只是我的。"}, {"type": "subtitle", "time": 5950.87, "timestamp": "01:39:10", "text": "好的。回来。回来。那好吧，"}, {"type": "subtitle", "time": 5953.43, "timestamp": "01:39:13", "text": "我正在接受治疗"}, {"type": "subtitle", "time": 5955.109, "timestamp": "01:39:15", "text": "升级。"}, {"type": "subtitle", "time": 5957.51, "timestamp": "01:39:17", "text": "问题。是的，应该像第一次启动一样。"}, {"type": "subtitle", "time": 5965.59, "timestamp": "01:39:25", "text": "至少我痊愈了。我们需要这样做"}, {"type": "subtitle", "time": 5967.109, "timestamp": "01:39:27", "text": "你们又来了。我们必须这样做。"}, {"type": "subtitle", "time": 5969.43, "timestamp": "01:39:29", "text": "再次。"}, {"type": "subtitle", "time": 5973.03, "timestamp": "01:39:33", "text": "我们现在正往路上走。"}, {"type": "subtitle", "time": 5976.83, "timestamp": "01:39:36", "text": "拜托，伙计们。我们能赢。"}, {"type": "subtitle", "time": 5979.97, "timestamp": "01:39:39", "text": "是的，我们一定要赢。"}, {"type": "subtitle", "time": 5982.629, "timestamp": "01:39:42", "text": "[音乐]"}, {"type": "subtitle", "time": 5989.03, "timestamp": "01:39:49", "text": "感觉我像是在照顾你们一样"}, {"type": "subtitle", "time": 5991.59, "timestamp": "01:39:51", "text": "基本上是这样。是的。是的。不要碰"}]
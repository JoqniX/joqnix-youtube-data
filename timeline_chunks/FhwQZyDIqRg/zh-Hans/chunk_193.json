[{"type": "subtitle", "time": 11580.389, "timestamp": "03:13:00", "text": "是的，没事的。你已经习惯了"}, {"type": "subtitle", "time": 11584.309, "timestamp": "03:13:04", "text": "它。以后别再给我打电话了。"}, {"type": "subtitle", "time": 11587.99, "timestamp": "03:13:07", "text": "我的天啊。对不起。"}, {"type": "subtitle", "time": 11590.91, "timestamp": "03:13:10", "text": "没关系。别担心。先生。"}, {"type": "subtitle", "time": 11593.59, "timestamp": "03:13:13", "text": "Shokunix是我哥哥的名字。等待，"}, {"type": "subtitle", "time": 11596.71, "timestamp": "03:13:16", "text": "这是一个印度名字。这是印度人"}, {"type": "subtitle", "time": 11598.03, "timestamp": "03:13:18", "text": "姓名。"}, {"type": "subtitle", "time": 11600.389, "timestamp": "03:13:20", "text": "有趣的。我觉得它就像一个非常"}, {"type": "subtitle", "time": 11603.03, "timestamp": "03:13:23", "text": "时尚的Sho的另一个名字，但是"}, {"type": "subtitle", "time": 11605.03, "timestamp": "03:13:25", "text": "显然，这是一个印度名字。"}, {"type": "subtitle", "time": 11608.469, "timestamp": "03:13:28", "text": "显然这也是个常见的名字。我吓坏了"}, {"type": "subtitle", "time": 11611.349, "timestamp": "03:13:31", "text": "我吓坏了一对夫妇"}, {"type": "subtitle", "time": 11614.309, "timestamp": "03:13:34", "text": "很多人，而我，我会叫这个名字"}, {"type": "subtitle", "time": 11617.75, "timestamp": "03:13:37", "text": "就像维克一样。他是怎么得到这个名字的？我"}, {"type": "subtitle", "time": 11629.03, "timestamp": "03:13:49", "text": "嗯，这真是件很有趣的事。我"}, {"type": "subtitle", "time": 11631.15, "timestamp": "03:13:51", "text": "从未听说过这个名字，就像第二个名字一样"}, {"type": "subtitle", "time": 11633.99, "timestamp": "03:13:53", "text": "但就像在表面上一样。"}, {"type": "subtitle", "time": 11636.59, "timestamp": "03:13:56", "text": "北方就像一个常见的"}, {"type": "subtitle", "time": 11639.91, "timestamp": "03:13:59", "text": "名字不是，我不认为这是常见的。"}]
[{"type": "subtitle", "time": 9960.07, "timestamp": "02:46:00", "text": "妈妈，我跟你一起去。"}, {"type": "subtitle", "time": 9962.309, "timestamp": "02:46:02", "text": "谢谢。"}, {"type": "subtitle", "time": 9965.59, "timestamp": "02:46:05", "text": "所以呢？它运行缓慢吗？"}, {"type": "subtitle", "time": 9969.429, "timestamp": "02:46:09", "text": "谢谢。真是位绅士。"}, {"type": "subtitle", "time": 9972.23, "timestamp": "02:46:12", "text": "为我开门。"}, {"type": "subtitle", "time": 9974.95, "timestamp": "02:46:14", "text": "是的，它在那里。哦，该死的。它是"}, {"type": "subtitle", "time": 9986.91, "timestamp": "02:46:26", "text": "哦，什么？我的天啊。我"}, {"type": "subtitle", "time": 9991.15, "timestamp": "02:46:31", "text": "认识我爸爸。不，它有价值。哦，等等。"}, {"type": "subtitle", "time": 9993.19, "timestamp": "02:46:33", "text": "那里。给我。给我。给。给。你"}, {"type": "subtitle", "time": 9994.71, "timestamp": "02:46:34", "text": "可以等。没关系。没关系。我们可以"}, {"type": "subtitle", "time": 9996.79, "timestamp": "02:46:36", "text": "等待。去做。去做。这并非第一次"}, {"type": "subtitle", "time": 9997.83, "timestamp": "02:46:37", "text": "萃取。这并非第一次"}, {"type": "subtitle", "time": 10007.23, "timestamp": "02:46:47", "text": "打扰一下。她还活着吗？"}, {"type": "subtitle", "time": 10010.469, "timestamp": "02:46:50", "text": "耶。我们走吧。到了。哦，你得到了"}, {"type": "subtitle", "time": 10011.91, "timestamp": "02:46:51", "text": "好事。是的，我有点东西。"}, {"type": "subtitle", "time": 10013.269, "timestamp": "02:46:53", "text": "放入卡片。放入卡片。普京"}, {"type": "subtitle", "time": 10015.99, "timestamp": "02:46:55", "text": "因为他们没有这张卡。你可以吗"}, {"type": "subtitle", "time": 10019.03, "timestamp": "02:46:59", "text": "帮他们搬？哦好的。是的。这是一个"}]
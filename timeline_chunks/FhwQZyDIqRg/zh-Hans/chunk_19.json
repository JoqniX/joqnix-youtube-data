[{"type": "subtitle", "time": 1140.23, "timestamp": "00:19:00", "text": "实际上，因为我当时就觉得，呃……"}, {"type": "subtitle", "time": 1142.39, "timestamp": "00:19:02", "text": "我对设计感到非常沮丧"}, {"type": "subtitle", "time": 1146.23, "timestamp": "00:19:06", "text": "我需要的就是我想要的所有具体东西。"}, {"type": "subtitle", "time": 1149.19, "timestamp": "00:19:09", "text": "等等。我当时真是又担心又困惑。"}, {"type": "subtitle", "time": 1151.75, "timestamp": "00:19:11", "text": "怎么办，怎么办。还没真正……"}, {"type": "subtitle", "time": 1153.95, "timestamp": "00:19:13", "text": "想过这件事之类的。"}, {"type": "subtitle", "time": 1157.11, "timestamp": "00:19:17", "text": "但我给自己留了些时间，她也一样。"}, {"type": "subtitle", "time": 1158.59, "timestamp": "00:19:18", "text": "确实帮了我一个忙"}, {"type": "subtitle", "time": 1162.23, "timestamp": "00:19:22", "text": "很多。她确实帮了我很多。我的意思是，她"}, {"type": "subtitle", "time": 1166.31, "timestamp": "00:19:26", "text": "确实帮了我很多，比如"}, {"type": "subtitle", "time": 1168.549, "timestamp": "00:19:28", "text": "呃，比如帮我想出一个"}, {"type": "subtitle", "time": 1172.63, "timestamp": "00:19:32", "text": "我喜欢这个设计。她真是太好了"}, {"type": "subtitle", "time": 1176.87, "timestamp": "00:19:36", "text": "甜到极致。"}, {"type": "subtitle", "time": 1178.669, "timestamp": "00:19:38", "text": "帮我……"}, {"type": "subtitle", "time": 1182.87, "timestamp": "00:19:42", "text": "设计。对不起。所以，我们进行了沟通。"}, {"type": "subtitle", "time": 1187.27, "timestamp": "00:19:47", "text": "彼此之间，嗯，我最终确定了"}, {"type": "subtitle", "time": 1189.47, "timestamp": "00:19:49", "text": "最终产品就是"}, {"type": "subtitle", "time": 1195.23, "timestamp": "00:19:55", "text": "这。嘿，这可是特别特别的。"}]
[{"type": "subtitle", "time": 2702.95, "timestamp": "00:45:02", "text": "车？它就在里面。"}, {"type": "subtitle", "time": 2705.03, "timestamp": "00:45:05", "text": "什么？"}, {"type": "subtitle", "time": 2708.87, "timestamp": "00:45:08", "text": "你可以继续。好的。"}, {"type": "subtitle", "time": 2719.109, "timestamp": "00:45:19", "text": "什么？那是什么？"}, {"type": "subtitle", "time": 2723.19, "timestamp": "00:45:23", "text": "什么？这是什么？那是什么？我"}, {"type": "subtitle", "time": 2733.43, "timestamp": "00:45:33", "text": "哦不，我死定了。"}, {"type": "subtitle", "time": 2735.75, "timestamp": "00:45:35", "text": "告诉他们。我的天哪。我们现在已经死了。"}, {"type": "subtitle", "time": 2737.91, "timestamp": "00:45:37", "text": "我们只是 Imagine 的一对成员。我们俩"}, {"type": "subtitle", "time": 2739.829, "timestamp": "00:45:39", "text": "他们中的。我们玩过这个。我们玩"}, {"type": "subtitle", "time": 2741.589, "timestamp": "00:45:41", "text": "我们是第一批到你那里的人。"}, {"type": "subtitle", "time": 2750.23, "timestamp": "00:45:50", "text": "是的。妈的。我们把他们全杀了。"}, {"type": "subtitle", "time": 2755.109, "timestamp": "00:45:55", "text": "我的天啊。他来了。他：哦，不。"}, {"type": "subtitle", "time": 2757.75, "timestamp": "00:45:57", "text": "我的天哪，看看她。她真可爱。"}]
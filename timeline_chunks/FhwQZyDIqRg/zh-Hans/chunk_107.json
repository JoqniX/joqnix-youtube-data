[{"type": "subtitle", "time": 6421.43, "timestamp": "01:47:01", "text": "我懂不懂印地语。我的头衔表明我愿意。"}, {"type": "subtitle", "time": 6425.27, "timestamp": "01:47:05", "text": "我的意思是，我简直就是个调查员，他说……"}, {"type": "subtitle", "time": 6427.669, "timestamp": "01:47:07", "text": "就在那儿。是的。哦，终于来了。是"}, {"type": "subtitle", "time": 6429.03, "timestamp": "01:47:09", "text": "恢复正常生活。我们又可以直播了。"}, {"type": "subtitle", "time": 6431.83, "timestamp": "01:47:11", "text": "欢迎回来。欢迎回来。耶。嘿，"}, {"type": "subtitle", "time": 6434.31, "timestamp": "01:47:14", "text": "我们现在去卡车那里。我们去"}, {"type": "subtitle", "time": 6436.149, "timestamp": "01:47:16", "text": "卡车。陷阱。不，我们没有"}, {"type": "subtitle", "time": 6437.91, "timestamp": "01:47:17", "text": "到。我们不必带上“不要”"}, {"type": "subtitle", "time": 6440.229, "timestamp": "01:47:20", "text": "是的，我们不必带那个。"}, {"type": "subtitle", "time": 6444.149, "timestamp": "01:47:24", "text": "是的，我们完成了。哦，走吧。我们去找吧"}, {"type": "subtitle", "time": 6450.189, "timestamp": "01:47:30", "text": "上帝。存活，"}, {"type": "subtitle", "time": 6453.4, "timestamp": "01:47:33", "text": "伙计们。我记得你。"}]
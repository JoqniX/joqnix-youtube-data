[{"type": "subtitle", "time": 2893.47, "timestamp": "00:48:13", "text": "你好。"}, {"type": "subtitle", "time": 2898.87, "timestamp": "00:48:18", "text": "爱 他为什么在这里？"}, {"type": "subtitle", "time": 2901.51, "timestamp": "00:48:21", "text": "再杀了他一次。你可以去"}, {"type": "subtitle", "time": 2903.51, "timestamp": "00:48:23", "text": "为了我牺牲自己吧。我知道你"}, {"type": "subtitle", "time": 2906.79, "timestamp": "00:48:26", "text": "想。你知道吗，你真是个伟大的英雄。"}, {"type": "subtitle", "time": 2914.069, "timestamp": "00:48:34", "text": "哥们儿一直盯着我看。它是"}, {"type": "subtitle", "time": 2919.03, "timestamp": "00:48:39", "text": "盯着我看。为什么伤口没有愈合？"}, {"type": "subtitle", "time": 2922.87, "timestamp": "00:48:42", "text": "他真的在盯着我看。"}, {"type": "subtitle", "time": 2926.23, "timestamp": "00:48:46", "text": "男生。滚回来。哟，在哪儿？"}, {"type": "subtitle", "time": 2928.15, "timestamp": "00:48:48", "text": "Zo在哪里？"}, {"type": "subtitle", "time": 2931.15, "timestamp": "00:48:51", "text": "他去世了，兄弟。为什么不是"}, {"type": "subtitle", "time": 2934.51, "timestamp": "00:48:54", "text": "康复？它应该是"}, {"type": "subtitle", "time": 2937.75, "timestamp": "00:48:57", "text": "复活。为什么伤口没有愈合？为什么是"}]
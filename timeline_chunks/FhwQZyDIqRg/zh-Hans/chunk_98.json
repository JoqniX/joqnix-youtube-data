[{"type": "subtitle", "time": 5881.91, "timestamp": "01:38:01", "text": "别碰我，兄弟。哦，原来是手榴弹。"}, {"type": "subtitle", "time": 5884.95, "timestamp": "01:38:04", "text": "离我远点。"}, {"type": "subtitle", "time": 5886.629, "timestamp": "01:38:06", "text": "那是什么？他得到了一些东西"}, {"type": "subtitle", "time": 5888.95, "timestamp": "01:38:08", "text": "楼上。那是什么？那是一只鸭子"}, {"type": "subtitle", "time": 5896.55, "timestamp": "01:38:16", "text": "哦不，你杀了她。你为什么是"}, {"type": "subtitle", "time": 5898.629, "timestamp": "01:38:18", "text": "杀了她？我的天哪。我的天啊。不，我确实这么做了。"}, {"type": "subtitle", "time": 5900.95, "timestamp": "01:38:20", "text": "并非有意要杀她。我本意是……"}, {"type": "subtitle", "time": 5902.87, "timestamp": "01:38:22", "text": "杀了她。我回来了。有一个"}, {"type": "subtitle", "time": 5904.87, "timestamp": "01:38:24", "text": "我内心积压了很多怨恨。我"}, {"type": "subtitle", "time": 5906.55, "timestamp": "01:38:26", "text": "不知道他为什么会这样。让我"}, {"type": "subtitle", "time": 5907.91, "timestamp": "01:38:27", "text": "让我直接把他送过去。不要这样做"}, {"type": "subtitle", "time": 5910.95, "timestamp": "01:38:30", "text": "就是这样，伙计们。芝诺。芝诺。他当时试图"}, {"type": "subtitle", "time": 5913.109, "timestamp": "01:38:33", "text": "马桶冲走了我。是的。哦"}, {"type": "subtitle", "time": 5916.55, "timestamp": "01:38:36", "text": "我的上帝。我先来。你是什​​么意思？哦"}, {"type": "subtitle", "time": 5918.87, "timestamp": "01:38:38", "text": "哇。哇。伙计们，我们买什么？"}, {"type": "subtitle", "time": 5921.51, "timestamp": "01:38:41", "text": "还有别的吗？我们需要手榴弹吗？但"}, {"type": "subtitle", "time": 5924.229, "timestamp": "01:38:44", "text": "我不知道怎么用。"}, {"type": "subtitle", "time": 5926.55, "timestamp": "01:38:46", "text": "那多少钱？这是为了2k。"}, {"type": "subtitle", "time": 5928.95, "timestamp": "01:38:48", "text": "这是2K游戏。是的，我们可以弄到手。"}, {"type": "subtitle", "time": 5929.99, "timestamp": "01:38:49", "text": "是的，这些不错。这些都不错。"}, {"type": "subtitle", "time": 5934.07, "timestamp": "01:38:54", "text": "你可以买到那些。我们走吧。"}, {"type": "subtitle", "time": 5937.59, "timestamp": "01:38:57", "text": "顺便说一句，我有两个。不，不。哦，"}]
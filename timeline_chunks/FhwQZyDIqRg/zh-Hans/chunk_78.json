[{"type": "subtitle", "time": 4681.189, "timestamp": "01:18:01", "text": "一条鲨鱼。"}, {"type": "subtitle", "time": 4683.75, "timestamp": "01:18:03", "text": "他喜欢吗？他们喜欢吗？我们喜欢吗？"}, {"type": "subtitle", "time": 4685.99, "timestamp": "01:18:05", "text": "如果有人这样做会损失经验值吗？哦，什么？"}, {"type": "subtitle", "time": 4687.51, "timestamp": "01:18:07", "text": "这是吗？不，我不这么认为。我们"}, {"type": "subtitle", "time": 4689.11, "timestamp": "01:18:09", "text": "你就坐在这儿。我们只能坐在这里。是的，"}, {"type": "subtitle", "time": 4690.87, "timestamp": "01:18:10", "text": "它就像一个小座位，当……"}, {"type": "subtitle", "time": 4692.95, "timestamp": "01:18:12", "text": "你个子很小吧。等等，为什么会这样？"}, {"type": "subtitle", "time": 4695.83, "timestamp": "01:18:15", "text": "这么久才联系上他们？你 你"}, {"type": "subtitle", "time": 4697.669, "timestamp": "01:18:17", "text": "增强体力，更快恢复耐力"}, {"type": "subtitle", "time": 4699.35, "timestamp": "01:18:19", "text": "这里。如果你待在那儿，我就走了。"}, {"type": "subtitle", "time": 4702.39, "timestamp": "01:18:22", "text": "坐在这里。是的。是的。看。看。"}, {"type": "subtitle", "time": 4704.149, "timestamp": "01:18:24", "text": "就是它，各位。那里正在举行派对"}, {"type": "subtitle", "time": 4706.55, "timestamp": "01:18:26", "text": "这里。各位，我什么都没收到。我"}, {"type": "subtitle", "time": 4709.35, "timestamp": "01:18:29", "text": "什么也没得到。史蒂夫，我没有。"}, {"type": "subtitle", "time": 4712.229, "timestamp": "01:18:32", "text": "是的。什么也没有。你，你这个小家伙"}, {"type": "subtitle", "time": 4715.669, "timestamp": "01:18:35", "text": "你这个小混蛋。让我告诉你为什么"}, {"type": "subtitle", "time": 4717.59, "timestamp": "01:18:37", "text": "正在做？"}, {"type": "subtitle", "time": 4719.43, "timestamp": "01:18:39", "text": "你为什么想选择长途旅行"}, {"type": "subtitle", "time": 4721.59, "timestamp": "01:18:41", "text": "顺便一提？是的。为什么这么长？哦，"}, {"type": "subtitle", "time": 4724.229, "timestamp": "01:18:44", "text": "我们得重来一遍。我的天啊，兄弟。"}, {"type": "subtitle", "time": 4727.99, "timestamp": "01:18:47", "text": "哦。哦，我们没做好。"}, {"type": "subtitle", "time": 4732.07, "timestamp": "01:18:52", "text": "我的天哪，各位。那是什么？我当时"}, {"type": "subtitle", "time": 4734.63, "timestamp": "01:18:54", "text": "等等，为什么这么久？我"}, {"type": "subtitle", "time": 4736.07, "timestamp": "01:18:56", "text": "知道。我们有可能"}, {"type": "subtitle", "time": 4738.55, "timestamp": "01:18:58", "text": "我在这里待了大概一个小时了。"}]
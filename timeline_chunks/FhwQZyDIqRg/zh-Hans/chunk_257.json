[{"type": "subtitle", "time": 15421.67, "timestamp": "04:17:01", "text": "挠头纳闷：这是什么？"}, {"type": "subtitle", "time": 15424.229, "timestamp": "04:17:04", "text": "会发生吗？哦不，我是个"}, {"type": "subtitle", "time": 15426.03, "timestamp": "04:17:06", "text": "精神病患者？不，你不是"}, {"type": "subtitle", "time": 15427.99, "timestamp": "04:17:07", "text": "精神病患者。你不是，你不是"}, {"type": "subtitle", "time": 15430.149, "timestamp": "04:17:10", "text": "你不是变态。你并非一无是处。"}, {"type": "subtitle", "time": 15432.229, "timestamp": "04:17:12", "text": "你什么都不是。你只是个……"}, {"type": "subtitle", "time": 15435.59, "timestamp": "04:17:15", "text": "只是个笨拙害羞的家伙。没关系。它是"}, {"type": "subtitle", "time": 15438.229, "timestamp": "04:17:18", "text": "你是个普通的、笨拙害羞的男生。"}, {"type": "subtitle", "time": 15440.79, "timestamp": "04:17:20", "text": "没关系。这是很正常的事情。"}, {"type": "subtitle", "time": 15443.75, "timestamp": "04:17:23", "text": "方式。啊，"}, {"type": "subtitle", "time": 15446.07, "timestamp": "04:17:26", "text": "你只需要习惯就好。"}, {"type": "subtitle", "time": 15448.55, "timestamp": "04:17:28", "text": "这里有些东西，这里有些东西，还有一些其他的东西"}, {"type": "subtitle", "time": 15450.469, "timestamp": "04:17:30", "text": "你肯定没问题。好的，不错"}, {"type": "subtitle", "time": 15453.269, "timestamp": "04:17:33", "text": "先生。是啊，我以为你说你是"}, {"type": "subtitle", "time": 15460.389, "timestamp": "04:17:40", "text": "所以，不用担心这些。只是"}, {"type": "subtitle", "time": 15461.99, "timestamp": "04:17:41", "text": "专注于你正在做对的事情。"}, {"type": "subtitle", "time": 15468.63, "timestamp": "04:17:48", "text": "现在。你好。是的。那么，下一个问题。你"}, {"type": "subtitle", "time": 15471.11, "timestamp": "04:17:51", "text": "常常最后才去做事情。"}, {"type": "subtitle", "time": 15474.309, "timestamp": "04:17:54", "text": "可能的时刻。是的。呃，这是这个"}, {"type": "subtitle", "time": 15477.189, "timestamp": "04:17:57", "text": "我大学时的样子。现在我将"}, {"type": "subtitle", "time": 15479.51, "timestamp": "04:17:59", "text": "通常会提前做好。"}]
[{"type": "subtitle", "time": 420.07, "timestamp": "00:07:00", "text": "就像所有的辛勤工作一样"}, {"type": "subtitle", "time": 423.189, "timestamp": "00:07:03", "text": "嗯，是啊，我知道我做不到。"}, {"type": "subtitle", "time": 426.23, "timestamp": "00:07:06", "text": "独自一人，因为我一直都依靠自己。"}, {"type": "subtitle", "time": 429.51, "timestamp": "00:07:09", "text": "一切都是我自己做的。"}, {"type": "subtitle", "time": 432.23, "timestamp": "00:07:12", "text": "我想做所有与艺术相关的事情。"}, {"type": "subtitle", "time": 433.71, "timestamp": "00:07:13", "text": "设计"}, {"type": "subtitle", "time": 437.469, "timestamp": "00:07:17", "text": "包括所有的一切，甚至包括3D部分。"}, {"type": "subtitle", "time": 439.909, "timestamp": "00:07:19", "text": "我计划的其他事情"}, {"type": "subtitle", "time": 442.749, "timestamp": "00:07:22", "text": "未来，但我一个人做不到，你"}, {"type": "subtitle", "time": 447.83, "timestamp": "00:07:27", "text": "我知道我一个人做不到这一切，而且"}, {"type": "subtitle", "time": 450.43, "timestamp": "00:07:30", "text": "我当时非常沮丧，"}, {"type": "subtitle", "time": 452.189, "timestamp": "00:07:32", "text": "东西"}, {"type": "subtitle", "time": 460.30899999999997, "timestamp": "00:07:40", "text": "但我认识了你们所有人，所以……"}, {"type": "subtitle", "time": 462.79, "timestamp": "00:07:42", "text": "暂时先联系我的社区吧，我不知道。"}, {"type": "subtitle", "time": 466.15, "timestamp": "00:07:46", "text": "如果我该这么做的话，我的意思是我想解决这个问题。"}, {"type": "subtitle", "time": 468.469, "timestamp": "00:07:48", "text": "我们给自己取一个永久的名字"}, {"type": "subtitle", "time": 472.43, "timestamp": "00:07:52", "text": "我的社区，我的社区，我自己，你"}]
[{"type": "subtitle", "time": 12121.59, "timestamp": "03:22:01", "text": "溪流。"}, {"type": "subtitle", "time": 12124.03, "timestamp": "03:22:04", "text": "经过最多测试，"}, {"type": "subtitle", "time": 12127.87, "timestamp": "03:22:07", "text": "默认、最佳测试版、最新"}, {"type": "subtitle", "time": 12136.51, "timestamp": "03:22:16", "text": "蒸汽？我的天哪，你竟然这么做"}, {"type": "subtitle", "time": 12144.389, "timestamp": "03:22:24", "text": "人们永远不会喜欢“呃，我没有……”"}, {"type": "subtitle", "time": 12147.15, "timestamp": "03:22:27", "text": "我不是一直都这样做。我有一个"}, {"type": "subtitle", "time": 12150.71, "timestamp": "03:22:30", "text": "工作让我无法像我一样做这件事"}, {"type": "subtitle", "time": 12154.55, "timestamp": "03:22:34", "text": "一直像工作一样"}, {"type": "subtitle", "time": 12156.389, "timestamp": "03:22:36", "text": "你知道我做不到这一点"}, {"type": "subtitle", "time": 12159.429, "timestamp": "03:22:39", "text": "自从我去日本一次之后，就再也没有其他事了。"}, {"type": "subtitle", "time": 12163.269, "timestamp": "03:22:43", "text": "最多一小时。是的。是的。就像你得到了"}, {"type": "subtitle", "time": 12164.11, "timestamp": "03:22:44", "text": "是"}, {"type": "subtitle", "time": 12169.79, "timestamp": "03:22:49", "text": "所以，如果你有工作的话。"}, {"type": "subtitle", "time": 12174.389, "timestamp": "03:22:54", "text": "嗯，今天我只想……"}, {"type": "subtitle", "time": 12176.429, "timestamp": "03:22:56", "text": "像放松一样"}]
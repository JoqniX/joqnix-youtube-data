[{"type": "subtitle", "time": 9601.91, "timestamp": "02:40:01", "text": "为什么芝诺不会死？没关系。不，"}, {"type": "subtitle", "time": 9614.95, "timestamp": "02:40:14", "text": "你身后有个僵尸。"}, {"type": "subtitle", "time": 9618.55, "timestamp": "02:40:18", "text": "持枪男子去哪儿了？你没有"}, {"type": "subtitle", "time": 9620.87, "timestamp": "02:40:20", "text": "我们抓到他了。我们拿到了25美分。他的"}, {"type": "subtitle", "time": 9623.91, "timestamp": "02:40:23", "text": "带领。好了，我们走吧。我们走吧。我们开始吧"}, {"type": "subtitle", "time": 9626.23, "timestamp": "02:40:26", "text": "去。我们走吧。哦，他在那儿。"}, {"type": "subtitle", "time": 9628.469, "timestamp": "02:40:28", "text": "枪。伙计，别这样"}, {"type": "subtitle", "time": 9630.349, "timestamp": "02:40:30", "text": "兄弟，我情绪低落"}, {"type": "subtitle", "time": 9634.63, "timestamp": "02:40:34", "text": "惠普。我刚刚重新加载了游戏。"}, {"type": "subtitle", "time": 9642.349, "timestamp": "02:40:42", "text": "哦，瞧。里面真是太荒唐了。我们"}, {"type": "subtitle", "time": 9645.27, "timestamp": "02:40:45", "text": "幸存下来了，幸存下来了。"}, {"type": "subtitle", "time": 9646.95, "timestamp": "02:40:46", "text": "你们还活着，对吧？有人死亡吗？"}, {"type": "subtitle", "time": 9651.99, "timestamp": "02:40:51", "text": "专业的。是的，我们还活着。交易。"}, {"type": "subtitle", "time": 9655.99, "timestamp": "02:40:55", "text": "有人死亡吗？不，不，对。耶。我们"}]
[{"type": "subtitle", "time": 3420.23, "timestamp": "00:57:00", "text": "他感觉整辆巴士都坐满了人。"}, {"type": "subtitle", "time": 3421.829, "timestamp": "00:57:01", "text": "还有各种强化道具之类的。我是"}, {"type": "subtitle", "time": 3423.99, "timestamp": "00:57:03", "text": "哇。"}, {"type": "subtitle", "time": 3426.71, "timestamp": "00:57:06", "text": "该死。对了，我们可以买到手榴弹。"}, {"type": "subtitle", "time": 3428.069, "timestamp": "00:57:08", "text": "显然，我们可以购买手榴弹并杀人。"}, {"type": "subtitle", "time": 3429.829, "timestamp": "00:57:09", "text": "嘲笑者。那么，我们就开始吧。我希望"}, {"type": "subtitle", "time": 3439.67, "timestamp": "00:57:19", "text": "好的，我参加。"}, {"type": "subtitle", "time": 3442.789, "timestamp": "00:57:22", "text": "想象一下，如果有个拿霰弹枪的人。"}, {"type": "subtitle", "time": 3444.47, "timestamp": "00:57:24", "text": "等待，"}, {"type": "subtitle", "time": 3446.47, "timestamp": "00:57:26", "text": "让我来拿。让我拿一下，我明白了。我"}, {"type": "subtitle", "time": 3448.87, "timestamp": "00:57:28", "text": "明白了，兄弟。"}, {"type": "subtitle", "time": 3456.19, "timestamp": "00:57:36", "text": "我决定不参加。别来"}, {"type": "subtitle", "time": 3464.069, "timestamp": "00:57:44", "text": "没关系。对不起。对不起。对不起。"}, {"type": "subtitle", "time": 3467.75, "timestamp": "00:57:47", "text": "别担心。不用担心。"}, {"type": "subtitle", "time": 3468.829, "timestamp": "00:57:48", "text": "我"}, {"type": "subtitle", "time": 3471.75, "timestamp": "00:57:51", "text": "别管它了。你不必如此"}, {"type": "subtitle", "time": 3474.789, "timestamp": "00:57:54", "text": "呃，开车时要小心。行不通。"}, {"type": "subtitle", "time": 3476.71, "timestamp": "00:57:56", "text": "好的，我们可以抓住大东西，然后……"}, {"type": "subtitle", "time": 3478.789, "timestamp": "00:57:58", "text": "也是怪物。"}]
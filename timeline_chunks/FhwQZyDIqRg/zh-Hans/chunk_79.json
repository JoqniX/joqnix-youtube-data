[{"type": "subtitle", "time": 4741.669, "timestamp": "01:19:01", "text": "思考的旅程漫长。"}, {"type": "subtitle", "time": 4744.55, "timestamp": "01:19:04", "text": "回家的路还很长。说实话，我"}, {"type": "subtitle", "time": 4749.11, "timestamp": "01:19:09", "text": "我知道，但我以为你们都知道。哇。"}, {"type": "subtitle", "time": 4757.99, "timestamp": "01:19:17", "text": "我把它毁了。乔克。我看到了。我看见"}, {"type": "subtitle", "time": 4781.99, "timestamp": "01:19:41", "text": "妮基，你看。我找到你。那智，你看。"}, {"type": "subtitle", "time": 4783.87, "timestamp": "01:19:43", "text": "是你。它是"}, {"type": "subtitle", "time": 4786.07, "timestamp": "01:19:46", "text": "你。好的。"}]
[{"type": "subtitle", "time": 197.67000000000002, "timestamp": "00:03:17", "text": "呃，好的。呃，我要去吃我的"}, {"type": "subtitle", "time": 199.91, "timestamp": "00:03:19", "text": "晚餐。注意V字形。我很快回来。"}, {"type": "subtitle", "time": 202.79, "timestamp": "00:03:22", "text": "还有三秒，大概3、2、1。我马上回来。"}, {"type": "subtitle", "time": 205.27, "timestamp": "00:03:25", "text": "呃，10分钟。好的。看V。我会的"}, {"type": "subtitle", "time": 208.19, "timestamp": "00:03:28", "text": "后退。好的。享受。再见。"}, {"type": "subtitle", "time": 211.35, "timestamp": "00:03:31", "text": "再见。天哪，我得跑了。我得去"}, {"type": "subtitle", "time": 216.27, "timestamp": "00:03:36", "text": "跑步。兄弟，我为什么感觉这么迷茫？"}, {"type": "subtitle", "time": 220.309, "timestamp": "00:03:40", "text": "晚的。耶。哦，对，你就在旁边。这是"}, {"type": "subtitle", "time": 223.149, "timestamp": "00:03:43", "text": "坏的。这很糟糕。这是"}, {"type": "subtitle", "time": 226.03, "timestamp": "00:03:46", "text": "坏的。好吧，享受什么？享受什么？享受"}, {"type": "chat", "time": 233.984, "timestamp": "00:03:53", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Joq is Currently taking a break! and will be back soon! do enjoy this past memories till he is back!"}, {"type": "subtitle", "time": 238.55, "timestamp": "00:03:58", "text": "把画面框起来，说你喜欢这样。"}]
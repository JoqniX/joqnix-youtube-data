[{"type": "subtitle", "time": 7921.99, "timestamp": "02:12:01", "text": "那就到此为止吧。呃，我有速度升级"}, {"type": "subtitle", "time": 7923.83, "timestamp": "02:12:03", "text": "它根本不存在。有人能给我吗？"}, {"type": "subtitle", "time": 7926.79, "timestamp": "02:12:06", "text": "能帮帮忙吗？我用的是惠普电脑。我有59个。"}, {"type": "subtitle", "time": 7929.87, "timestamp": "02:12:09", "text": "对不起。我不能。"}, {"type": "subtitle", "time": 7932.39, "timestamp": "02:12:12", "text": "我的意思是，如果这让你感觉"}, {"type": "subtitle", "time": 7935.709, "timestamp": "02:12:15", "text": "任何好事，我都喜欢。所以，"}, {"type": "subtitle", "time": 7938.43, "timestamp": "02:12:18", "text": "我"}, {"type": "subtitle", "time": 7941.83, "timestamp": "02:12:21", "text": "对男人来说，分享就是关爱，兄弟。是的，"}, {"type": "subtitle", "time": 7944.55, "timestamp": "02:12:24", "text": "我们必须分享。"}, {"type": "subtitle", "time": 7946.39, "timestamp": "02:12:26", "text": "分享即关爱。他们教过你"}, {"type": "subtitle", "time": 7949.149, "timestamp": "02:12:29", "text": "一年级，孩子们。快点。"}, {"type": "subtitle", "time": 7953.91, "timestamp": "02:12:33", "text": "是的。好了，我们走吧。好的。"}, {"type": "subtitle", "time": 7955.83, "timestamp": "02:12:35", "text": "好的。我要走了。我有很多"}, {"type": "subtitle", "time": 7957.589, "timestamp": "02:12:37", "text": "体力方面，我先去侦察一下。"}, {"type": "subtitle", "time": 7961.27, "timestamp": "02:12:41", "text": "务必到场。看着我。呃，你好。"}, {"type": "subtitle", "time": 7965.27, "timestamp": "02:12:45", "text": "是个警察。你好。你好背后。你"}, {"type": "subtitle", "time": 7967.83, "timestamp": "02:12:47", "text": "什么都没看到吗？好的。没有。你可以吗"}, {"type": "subtitle", "time": 7970.229, "timestamp": "02:12:50", "text": "你们听见了吗？你好？好的。是的。你好。"}, {"type": "subtitle", "time": 7972.47, "timestamp": "02:12:52", "text": "这很贵。直接带它去"}, {"type": "subtitle", "time": 7975.189, "timestamp": "02:12:55", "text": "呃，直接说“是的，这个”。"}]
[{"type": "subtitle", "time": 10023.269, "timestamp": "02:47:03", "text": "很大，它非常巨大。把它放在后面。放"}, {"type": "subtitle", "time": 10026.71, "timestamp": "02:47:06", "text": "现在就买。请照顾我。别明白 别"}, {"type": "subtitle", "time": 10030.07, "timestamp": "02:47:10", "text": "感冒了。我并不软弱。当然。"}, {"type": "subtitle", "time": 10033.19, "timestamp": "02:47:13", "text": "耶。我们走吧。哦，这里好冷。"}, {"type": "subtitle", "time": 10035.269, "timestamp": "02:47:15", "text": "想象一下夏天会很冷，兄弟。"}, {"type": "subtitle", "time": 10037.51, "timestamp": "02:47:17", "text": "不可能是我。我为你加油"}, {"type": "subtitle", "time": 10039.429, "timestamp": "02:47:19", "text": "免疫系统。即使是呃，你"}, {"type": "subtitle", "time": 10040.469, "timestamp": "02:47:20", "text": "就像弱者一样。我的免疫"}, {"type": "subtitle", "time": 10045.269, "timestamp": "02:47:25", "text": "系统比我的好"}, {"type": "subtitle", "time": 10047.03, "timestamp": "02:47:27", "text": "你的免疫系统处于劣势"}, {"type": "subtitle", "time": 10049.03, "timestamp": "02:47:29", "text": "这场战斗。"}, {"type": "subtitle", "time": 10052.23, "timestamp": "02:47:32", "text": "祝福你。祝福你。上帝保佑你。"}, {"type": "subtitle", "time": 10055.91, "timestamp": "02:47:35", "text": "打扰一下。祝你早日蒙福。我有。"}, {"type": "subtitle", "time": 10057.83, "timestamp": "02:47:37", "text": "等等，这是谁？谢谢你，泽诺。停止"}, {"type": "subtitle", "time": 10060.389, "timestamp": "02:47:40", "text": "步行。坚持，稍等。我不走路。"}, {"type": "subtitle", "time": 10061.91, "timestamp": "02:47:41", "text": "这里面肯定有东西。让我来治愈你。"}, {"type": "subtitle", "time": 10063.55, "timestamp": "02:47:43", "text": "只是"}, {"type": "subtitle", "time": 10079.91, "timestamp": "02:47:59", "text": "我喜欢这个。我可以爬上来，而且"}]
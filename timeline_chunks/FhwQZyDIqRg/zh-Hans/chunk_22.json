[{"type": "subtitle", "time": 1321.27, "timestamp": "00:22:01", "text": "呃，要在流上实现之类的"}, {"type": "subtitle", "time": 1323.63, "timestamp": "00:22:03", "text": "太难了。"}, {"type": "subtitle", "time": 1327.43, "timestamp": "00:22:07", "text": "但是但是 但是"}, {"type": "subtitle", "time": 1330.39, "timestamp": "00:22:10", "text": "呃，你所有的，你所有的爱"}, {"type": "subtitle", "time": 1333.47, "timestamp": "00:22:13", "text": "来自 Discord 矿工的"}, {"type": "subtitle", "time": 1336.23, "timestamp": "00:22:16", "text": "Discord 给了我一个头巾"}, {"type": "subtitle", "time": 1338.71, "timestamp": "00:22:18", "text": "彼此都喜欢看到他们所有人"}, {"type": "subtitle", "time": 1340.83, "timestamp": "00:22:20", "text": "确实如此"}, {"type": "subtitle", "time": 1343.47, "timestamp": "00:22:23", "text": "真的真的"}, {"type": "subtitle", "time": 1347.51, "timestamp": "00:22:27", "text": "简直融化了我的心。而那天"}, {"type": "subtitle", "time": 1353.27, "timestamp": "00:22:33", "text": "当Zuchi发出呃呃呃的声音时，她也发了。"}, {"type": "subtitle", "time": 1357.909, "timestamp": "00:22:37", "text": "设计、草图、线稿"}, {"type": "subtitle", "time": 1359.87, "timestamp": "00:22:39", "text": "线条画。嘿"}, {"type": "subtitle", "time": 1362.23, "timestamp": "00:22:42", "text": "竟然从椅子上摔了下来"}, {"type": "subtitle", "time": 1363.07, "timestamp": "00:22:43", "text": "开始"}, {"type": "subtitle", "time": 1369.909, "timestamp": "00:22:49", "text": "很多，因为我承受不了。"}, {"type": "subtitle", "time": 1379.909, "timestamp": "00:22:59", "text": "啊，当她真的喜欢她的时候"}]
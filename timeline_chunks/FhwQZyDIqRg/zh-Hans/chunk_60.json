[{"type": "subtitle", "time": 3603.349, "timestamp": "01:00:03", "text": "我的天，那里有只可怕的蜗牛。有"}, {"type": "subtitle", "time": 3605.4, "timestamp": "01:00:05", "text": "一只令人毛骨悚然的蜗牛。"}, {"type": "subtitle", "time": 3607.349, "timestamp": "01:00:07", "text": "[音乐]"}, {"type": "subtitle", "time": 3608.51, "timestamp": "01:00:08", "text": "哦"}, {"type": "subtitle", "time": 3611.71, "timestamp": "01:00:11", "text": "不。我觉得我是"}, {"type": "subtitle", "time": 3616.15, "timestamp": "01:00:16", "text": "死的。我死了吗？有人去世了吗？我是谁？"}, {"type": "subtitle", "time": 3618.71, "timestamp": "01:00:18", "text": "死的？我的天哪，太可怕了。哦，我的天"}, {"type": "subtitle", "time": 3622.109, "timestamp": "01:00:22", "text": "修长的人。修长的人。修长的人。"}, {"type": "subtitle", "time": 3645.27, "timestamp": "01:00:45", "text": "哦，瞧。哦，"}, {"type": "subtitle", "time": 3649.03, "timestamp": "01:00:49", "text": "乔克。嘿。是的，乔。我想要的是头，"}, {"type": "subtitle", "time": 3650.789, "timestamp": "01:00:50", "text": "但"}, {"type": "subtitle", "time": 3652.39, "timestamp": "01:00:52", "text": "你知道当有人说“就像”的时候吗？"}, {"type": "subtitle", "time": 3653.91, "timestamp": "01:00:53", "text": "当它在后面时，你不知道它在哪里。"}, {"type": "subtitle", "time": 3655.19, "timestamp": "01:00:55", "text": "想跑，然后你就想，我这就去"}, {"type": "subtitle", "time": 3658.15, "timestamp": "01:00:58", "text": "我现在就蹲着。反而。糟糕。"}]
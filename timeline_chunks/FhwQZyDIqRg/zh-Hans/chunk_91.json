[{"type": "subtitle", "time": 5463.03, "timestamp": "01:31:03", "text": "好吧，你想杀了我也可以。"}, {"type": "subtitle", "time": 5467.51, "timestamp": "01:31:07", "text": "我的天哪。我的天啊。他在那里。"}, {"type": "subtitle", "time": 5469.43, "timestamp": "01:31:09", "text": "失败者。"}, {"type": "subtitle", "time": 5477.35, "timestamp": "01:31:17", "text": "不，我不明白。去把东西拿过来。去"}, {"type": "subtitle", "time": 5479.81, "timestamp": "01:31:19", "text": "后退。是的。我的天哪。"}, {"type": "subtitle", "time": 5482.31, "timestamp": "01:31:22", "text": "[音乐]"}, {"type": "subtitle", "time": 5484.07, "timestamp": "01:31:24", "text": "哦，是的。什么事都没发生。这是"}, {"type": "subtitle", "time": 5486.39, "timestamp": "01:31:26", "text": "我身上发生了什么事？你应该"}, {"type": "subtitle", "time": 5487.83, "timestamp": "01:31:27", "text": "不，不，不，不。你应该选择"}, {"type": "subtitle", "time": 5491.11, "timestamp": "01:31:31", "text": "现在我们。"}, {"type": "subtitle", "time": 5493.189, "timestamp": "01:31:33", "text": "哦，这简直太不尊重人了。"}, {"type": "subtitle", "time": 5495.83, "timestamp": "01:31:35", "text": "我的天哪。我的天啊。"}, {"type": "subtitle", "time": 5500.149, "timestamp": "01:31:40", "text": "哇。好的。他在做什么？"}, {"type": "subtitle", "time": 5501.59, "timestamp": "01:31:41", "text": "他应该加冕。他应该"}, {"type": "subtitle", "time": 5504.229, "timestamp": "01:31:44", "text": "夺取桂冠，而不是丢掉东西。什么"}, {"type": "subtitle", "time": 5507.75, "timestamp": "01:31:47", "text": "他在做什么？我该如何获胜？他的一天。哦，"}, {"type": "subtitle", "time": 5510.87, "timestamp": "01:31:50", "text": "好了。哇。好了。那里我们"}]
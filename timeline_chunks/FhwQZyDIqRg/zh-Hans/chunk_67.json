[{"type": "subtitle", "time": 4020.63, "timestamp": "01:07:00", "text": "对不起。我的天哪。我们发现"}, {"type": "subtitle", "time": 4021.47, "timestamp": "01:07:01", "text": "我们"}, {"type": "subtitle", "time": 4032.95, "timestamp": "01:07:12", "text": "我有钱了。那不是我。我秃顶了。"}, {"type": "subtitle", "time": 4047.91, "timestamp": "01:07:27", "text": "让我积蓄力量。哦，又一个侏儒。"}, {"type": "subtitle", "time": 4063.91, "timestamp": "01:07:43", "text": "哦，瞧。这是什么？不，不，不"}, {"type": "subtitle", "time": 4066.15, "timestamp": "01:07:46", "text": "不，不，不。你会喝醉的。"}, {"type": "subtitle", "time": 4069.27, "timestamp": "01:07:49", "text": "不，我应该把它放在箱子里。等待，"}]
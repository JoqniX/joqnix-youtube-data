[{"type": "subtitle", "time": 4268.669, "timestamp": "01:11:08", "text": "来了，各位。我是"}, {"type": "subtitle", "time": 4274.07, "timestamp": "01:11:14", "text": "未来。伙计们，过来一下。"}, {"type": "subtitle", "time": 4276.55, "timestamp": "01:11:16", "text": "我们走吧。进去！进去！进去！"}, {"type": "subtitle", "time": 4279.11, "timestamp": "01:11:19", "text": "几乎每次我回来都是这样"}, {"type": "subtitle", "time": 4282.47, "timestamp": "01:11:22", "text": "这些人，为了生活，就只是"}, {"type": "subtitle", "time": 4285.83, "timestamp": "01:11:25", "text": "大家都到齐了吗？大家都到齐了吗？是的。经过"}, {"type": "subtitle", "time": 4288.07, "timestamp": "01:11:28", "text": "伙计们，如果你们"}, {"type": "subtitle", "time": 4292.75, "timestamp": "01:11:32", "text": "他们为什么会在这里？跑步。为什么？为什么"}, {"type": "subtitle", "time": 4295.39, "timestamp": "01:11:35", "text": "它想来"}, {"type": "subtitle", "time": 4300.79, "timestamp": "01:11:40", "text": "活？这就是我。哦，不。"}, {"type": "subtitle", "time": 4304.79, "timestamp": "01:11:44", "text": "我的天哪。哦，漏掉了一个。妈的。"}, {"type": "subtitle", "time": 4307.91, "timestamp": "01:11:47", "text": "感谢上帝。感谢上帝，只感谢你。但为什么"}, {"type": "subtitle", "time": 4309.99, "timestamp": "01:11:49", "text": "它是冲着我来的吗？为什么只有"}, {"type": "subtitle", "time": 4313.43, "timestamp": "01:11:53", "text": "未来？兄弟，出什么事了？我觉得是这样。"}, {"type": "subtitle", "time": 4317.11, "timestamp": "01:11:57", "text": "恨你。真是太奇怪了。"}, {"type": "subtitle", "time": 4319.59, "timestamp": "01:11:59", "text": "我就像一个幽灵吸引器，或者说，我就像一个幽灵吸引器。"}]
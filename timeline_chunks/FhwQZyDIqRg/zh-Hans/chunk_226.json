[{"type": "subtitle", "time": 13561.15, "timestamp": "03:46:01", "text": "我不做"}, {"type": "subtitle", "time": 13563.349, "timestamp": "03:46:03", "text": "你不感兴趣的"}, {"type": "subtitle", "time": 13565.189, "timestamp": "03:46:05", "text": "关于“哦，请继续”的讨论"}, {"type": "subtitle", "time": 13567.309, "timestamp": "03:46:07", "text": "你打算说点什么？"}, {"type": "subtitle", "time": 13570.15, "timestamp": "03:46:10", "text": "不，我当时在想我也应该这么做。"}, {"type": "subtitle", "time": 13576.95, "timestamp": "03:46:16", "text": "等等，让我打开"}, {"type": "subtitle", "time": 13580.229, "timestamp": "03:46:20", "text": "好的。我，我在，嗯，是的。是的。"}, {"type": "subtitle", "time": 13581.269, "timestamp": "03:46:21", "text": "求求你，求求你，求求你，求求你"}, {"type": "subtitle", "time": 13588.63, "timestamp": "03:46:28", "text": "好的。好，我们走吧。哦，我应该吗？"}, {"type": "subtitle", "time": 13590.55, "timestamp": "03:46:30", "text": "我应该重新开始吗？"}, {"type": "subtitle", "time": 13592.79, "timestamp": "03:46:32", "text": "测试？不，不，不，不。继续。继续"}, {"type": "subtitle", "time": 13595.75, "timestamp": "03:46:35", "text": "你的。不用担心。嗯，那就开始吧。"}, {"type": "subtitle", "time": 13600.15, "timestamp": "03:46:40", "text": "然后一起。是的。好的。嗯，好的。我 我"}, {"type": "subtitle", "time": 13602.71, "timestamp": "03:46:42", "text": "我这就暂停测试"}, {"type": "subtitle", "time": 13605.349, "timestamp": "03:46:45", "text": "直到你到达这里。哪里"}, {"type": "subtitle", "time": 13607.51, "timestamp": "03:46:47", "text": "你读"}, {"type": "subtitle", "time": 13610.71, "timestamp": "03:46:50", "text": "又来了？是的。就像你感觉到的自己"}, {"type": "subtitle", "time": 13612.07, "timestamp": "03:46:52", "text": "能够轻松地接近某人"}, {"type": "subtitle", "time": 13613.269, "timestamp": "03:46:53", "text": "发现有趣的事情并开始"}, {"type": "subtitle", "time": 13614.95, "timestamp": "03:46:54", "text": "对话。这就是我的问题。那是"}, {"type": "subtitle", "time": 13617.75, "timestamp": "03:46:57", "text": "我就在那里。你可以等等"}]
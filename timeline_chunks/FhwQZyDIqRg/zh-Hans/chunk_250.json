[{"type": "subtitle", "time": 15001.79, "timestamp": "04:10:01", "text": "减少溢出，甚至没有溢出"}, {"type": "subtitle", "time": 15004.95, "timestamp": "04:10:04", "text": "溢出物。所以我推荐我的销售漏斗。"}, {"type": "subtitle", "time": 15007.67, "timestamp": "04:10:07", "text": "方法。但你却像个不不不我们"}, {"type": "subtitle", "time": 15009.269, "timestamp": "04:10:09", "text": "不需要漏斗。不要寻找"}, {"type": "subtitle", "time": 15012.07, "timestamp": "04:10:12", "text": "漏斗。没关系。"}, {"type": "subtitle", "time": 15013.349, "timestamp": "04:10:13", "text": "但我不会……"}, {"type": "subtitle", "time": 15014.71, "timestamp": "04:10:14", "text": "比如，“杰克，你错了。事情会……”"}, {"type": "subtitle", "time": 15016.07, "timestamp": "04:10:16", "text": "泄漏会造成破坏"}, {"type": "subtitle", "time": 15018.15, "timestamp": "04:10:18", "text": "一切。”不，雅克，我要……"}, {"type": "subtitle", "time": 15021.269, "timestamp": "04:10:21", "text": "就像这样：“雅克，你说得对。”但是我们"}, {"type": "subtitle", "time": 15023.59, "timestamp": "04:10:23", "text": "正在使用电脑工作。即使是一个"}, {"type": "subtitle", "time": 15027.189, "timestamp": "04:10:27", "text": "就像电路上的套装一样掉落，"}, {"type": "subtitle", "time": 15029.51, "timestamp": "04:10:29", "text": "一切都将消失。所以，让我们"}, {"type": "subtitle", "time": 15031.51, "timestamp": "04:10:31", "text": "我只需要等几秒钟。让我"}, {"type": "subtitle", "time": 15033.91, "timestamp": "04:10:33", "text": "准备一个漏斗。咱们就此结束吧。"}, {"type": "subtitle", "time": 15035.67, "timestamp": "04:10:35", "text": "然后你就会想，“好吧，他确实这么做了。”"}, {"type": "subtitle", "time": 15039.67, "timestamp": "04:10:39", "text": "就说我是对的。他说他可以做到。"}, {"type": "subtitle", "time": 15042.469, "timestamp": "04:10:42", "text": "哦，是的。他说的有道理。是的，"}, {"type": "subtitle", "time": 15044.87, "timestamp": "04:10:44", "text": "我们使用电脑工作。当然，"}, {"type": "subtitle", "time": 15047.59, "timestamp": "04:10:47", "text": "你会平静下来的。那一刻"}, {"type": "subtitle", "time": 15049.59, "timestamp": "04:10:49", "text": "我说，你是对的，你是……"}, {"type": "subtitle", "time": 15052.229, "timestamp": "04:10:52", "text": "好吧，你可以做到，你当时就像是……"}, {"type": "subtitle", "time": 15056.229, "timestamp": "04:10:56", "text": "“好的，好的。是的，我可以做到。”哦，"}, {"type": "subtitle", "time": 15058.309, "timestamp": "04:10:58", "text": "是的。他说的有道理。哦，是的。我们有"}]
[{"type": "subtitle", "time": 6780.79, "timestamp": "01:53:00", "text": "这枚手榴弹。"}, {"type": "subtitle", "time": 6784.189, "timestamp": "01:53:04", "text": "我听到我的……发出噼啪声"}, {"type": "subtitle", "time": 6788.39, "timestamp": "01:53:08", "text": "呃，从我的东西来看，你知道，"}, {"type": "subtitle", "time": 6792.629, "timestamp": "01:53:12", "text": "扩展盒。哦，不。好的。"}, {"type": "subtitle", "time": 6797.51, "timestamp": "01:53:17", "text": "扩展盒。在哪里？"}, {"type": "subtitle", "time": 6800.709, "timestamp": "01:53:20", "text": "扩展盒？我的扩展盒就像……"}, {"type": "subtitle", "time": 6806.31, "timestamp": "01:53:26", "text": "现实生活。神啊，一股强大的力量。我插上电源"}, {"type": "subtitle", "time": 6807.83, "timestamp": "01:53:27", "text": "我的显示器。就是这样，"}, {"type": "subtitle", "time": 6811.75, "timestamp": "01:53:31", "text": "正确的？我的显示器就像我好像……"}, {"type": "subtitle", "time": 6813.35, "timestamp": "01:53:33", "text": "拧紧电缆与我的连接"}, {"type": "subtitle", "time": 6815.43, "timestamp": "01:53:35", "text": "监视器上，它开始冒火花。我不"}, {"type": "subtitle", "time": 6817.51, "timestamp": "01:53:37", "text": "了解发生了什么。哦，不。你必须"}, {"type": "subtitle", "time": 6819.189, "timestamp": "01:53:39", "text": "小心点，兄弟。尤其是当"}, {"type": "subtitle", "time": 6822.709, "timestamp": "01:53:42", "text": "灯灭了，小心。那"}, {"type": "subtitle", "time": 6824.47, "timestamp": "01:53:44", "text": "属实。我曾经因为触电被电过一次"}, {"type": "subtitle", "time": 6827.75, "timestamp": "01:53:47", "text": "连接我的Xbox 360。"}, {"type": "subtitle", "time": 6830.95, "timestamp": "01:53:50", "text": "什么？是的。哦，兄弟。你真的真的"}, {"type": "subtitle", "time": 6832.55, "timestamp": "01:53:52", "text": "想想你好像有七条命？"}, {"type": "subtitle", "time": 6834.229, "timestamp": "01:53:54", "text": "某物？我想这就是原因"}, {"type": "subtitle", "time": 6836.229, "timestamp": "01:53:56", "text": "你的行为一如既往。你是什​​么"}, {"type": "subtitle", "time": 6839.189, "timestamp": "01:53:59", "text": "意思是？其实没那么糟。只是我的"}]
[{"type": "subtitle", "time": 15301.75, "timestamp": "04:15:01", "text": "所以我不会轻易被……所动摇"}, {"type": "subtitle", "time": 15306.229, "timestamp": "04:15:06", "text": "情绪化的。我不会没事的。"}, {"type": "subtitle", "time": 15309.269, "timestamp": "04:15:09", "text": "人们。不不不不不。我看看是否"}, {"type": "subtitle", "time": 15312.469, "timestamp": "04:15:12", "text": "这个理由是合理的。如果理由成立，"}, {"type": "subtitle", "time": 15314.55, "timestamp": "04:15:14", "text": "哦，你必须杀死这10个孩子。"}, {"type": "subtitle", "time": 15316.429, "timestamp": "04:15:16", "text": "为了人民。我当时就想，"}, {"type": "subtitle", "time": 15319.189, "timestamp": "04:15:19", "text": "不，我不会为了……而杀生。"}, {"type": "subtitle", "time": 15321.149, "timestamp": "04:15:21", "text": "人们。非常感谢"}, {"type": "subtitle", "time": 15323.91, "timestamp": "04:15:23", "text": "很多。所以，不，我不会轻易放弃。"}, {"type": "subtitle", "time": 15326.79, "timestamp": "04:15:26", "text": "受情绪化论点影响。没有。不"}, {"type": "subtitle", "time": 15328.87, "timestamp": "04:15:28", "text": "气球和奶酪。我同意。"}, {"type": "subtitle", "time": 15331.03, "timestamp": "04:15:31", "text": "那。三级同意。我不会"}, {"type": "subtitle", "time": 15339.11, "timestamp": "04:15:39", "text": "你经常注册。前进。所以，我也是"}, {"type": "subtitle", "time": 15342.149, "timestamp": "04:15:42", "text": "有时候我会情绪激动。"}, {"type": "subtitle", "time": 15344.07, "timestamp": "04:15:44", "text": "动摇了。"}, {"type": "subtitle", "time": 15347.91, "timestamp": "04:15:47", "text": "我不知道，因为我真的不知道是不是。"}, {"type": "subtitle", "time": 15350.229, "timestamp": "04:15:50", "text": "因为我是一个讨好型人格？我不"}, {"type": "subtitle", "time": 15354.149, "timestamp": "04:15:54", "text": "知道。那也很糟糕。用那个是因为"}, {"type": "subtitle", "time": 15356.309, "timestamp": "04:15:56", "text": "如果你看到一个真正的讨好型人格，你"}, {"type": "subtitle", "time": 15359.429, "timestamp": "04:15:59", "text": "会说“呃，我不是那样的人”。你会"}]
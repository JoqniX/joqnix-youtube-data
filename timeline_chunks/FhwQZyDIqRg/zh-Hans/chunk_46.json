[{"type": "subtitle", "time": 2761.03, "timestamp": "00:46:01", "text": "小子，过来，小子。是的，我是。是的，"}, {"type": "subtitle", "time": 2763.589, "timestamp": "00:46:03", "text": "男生。"}, {"type": "subtitle", "time": 2770.55, "timestamp": "00:46:10", "text": "好工作。你好。"}, {"type": "subtitle", "time": 2780.79, "timestamp": "00:46:20", "text": "我的天哪，它太可爱了。哦亲爱的。"}, {"type": "subtitle", "time": 2783.349, "timestamp": "00:46:23", "text": "哦，兄弟。努力工作也是如此。他们没有"}, {"type": "subtitle", "time": 2785.109, "timestamp": "00:46:25", "text": "请告诉我我是否可以说脏话。我该怎么办？"}, {"type": "subtitle", "time": 2787.589, "timestamp": "00:46:27", "text": "做？你可以。我有……我有表情。"}, {"type": "subtitle", "time": 2789.91, "timestamp": "00:46:29", "text": "我想要你。完全可以。顺便一提，"}, {"type": "subtitle", "time": 2791.75, "timestamp": "00:46:31", "text": "他们做不到。我的天啊。你能吗？但是你"}, {"type": "subtitle", "time": 2797.03, "timestamp": "00:46:37", "text": "你会打字吧？是的，可以。是的，但是"}, {"type": "subtitle", "time": 2798.95, "timestamp": "00:46:38", "text": "我不这么认为。没错。这看起来"}, {"type": "subtitle", "time": 2801.109, "timestamp": "00:46:41", "text": "喜欢"}, {"type": "subtitle", "time": 2804.47, "timestamp": "00:46:44", "text": "哦，糟糕。等等，你来输入。你是"}, {"type": "subtitle", "time": 2806.63, "timestamp": "00:46:46", "text": "关闭。"}, {"type": "subtitle", "time": 2808.39, "timestamp": "00:46:48", "text": "你已经很接近了。"}, {"type": "subtitle", "time": 2810.309, "timestamp": "00:46:50", "text": "我应该吗？哦，是的。他的头掉了下来"}, {"type": "subtitle", "time": 2812.63, "timestamp": "00:46:52", "text": "他的头好像飞到那里去了。去了"}, {"type": "subtitle", "time": 2815.19, "timestamp": "00:46:55", "text": "省你一次。"}, {"type": "subtitle", "time": 2817.51, "timestamp": "00:46:57", "text": "是的，他们听不见。哦，提取"}, {"type": "subtitle", "time": 2818.87, "timestamp": "00:46:58", "text": "完全的。他们会让我们复活。他们会"}]
[{"type": "subtitle", "time": 3481.109, "timestamp": "00:58:01", "text": "我希望如此。"}, {"type": "subtitle", "time": 3484.15, "timestamp": "00:58:04", "text": "我希望，我希望。等等，芝诺。芝诺。芝诺。"}, {"type": "subtitle", "time": 3487.109, "timestamp": "00:58:07", "text": "听着，别跟在后面。小心。"}, {"type": "subtitle", "time": 3489.829, "timestamp": "00:58:09", "text": "小心。兔子组合。"}, {"type": "subtitle", "time": 3494.15, "timestamp": "00:58:14", "text": "我在角落里。哦，你好。"}, {"type": "subtitle", "time": 3496.309, "timestamp": "00:58:16", "text": "是的。是的，没问题。没关系。是吗？"}, {"type": "subtitle", "time": 3499.349, "timestamp": "00:58:19", "text": "走了吗？它不见了吗？好的。我要去吗？我要去吗？"}, {"type": "subtitle", "time": 3500.87, "timestamp": "00:58:20", "text": "穿过门？你看到了吗？我感觉"}, {"type": "subtitle", "time": 3504.15, "timestamp": "00:58:24", "text": "就像每次那样"}, {"type": "subtitle", "time": 3505.99, "timestamp": "00:58:25", "text": "祝你们好运。电视信号来了。"}, {"type": "subtitle", "time": 3507.829, "timestamp": "00:58:27", "text": "电视。电视。请把它放进购物车里。"}, {"type": "subtitle", "time": 3510.789, "timestamp": "00:58:30", "text": "请？是的。好的。等等，等等，各位。"}, {"type": "subtitle", "time": 3513.589, "timestamp": "00:58:33", "text": "等等，等等，各位。等等，等等，各位。只是"}, {"type": "subtitle", "time": 3515.67, "timestamp": "00:58:35", "text": "放下它。别说了，伙计们。我认为我们的"}, {"type": "subtitle", "time": 3518.789, "timestamp": "00:58:38", "text": "kod 已完成。我们的代码完成了。我认为"}, {"type": "subtitle", "time": 3522.63, "timestamp": "00:58:42", "text": "6,000。是的。是的。"}, {"type": "subtitle", "time": 3526.789, "timestamp": "00:58:46", "text": "我认为是 16,000。是的。"}, {"type": "subtitle", "time": 3528.39, "timestamp": "00:58:48", "text": "我们带了更多东西，这样我们就可以"}]
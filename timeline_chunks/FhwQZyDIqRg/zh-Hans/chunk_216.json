[{"type": "subtitle", "time": 12960.91, "timestamp": "03:36:00", "text": "是的。我为什么需要？好吧，你"}, {"type": "subtitle", "time": 12964.79, "timestamp": "03:36:04", "text": "从法律上讲，我没有。"}, {"type": "subtitle", "time": 12968.63, "timestamp": "03:36:08", "text": "呃，我非常……嗯，是的。你知道吗？我 我"}, {"type": "subtitle", "time": 12970.229, "timestamp": "03:36:10", "text": "有点同意。"}, {"type": "subtitle", "time": 12971.95, "timestamp": "03:36:11", "text": "第一个"}, {"type": "subtitle", "time": 12974.95, "timestamp": "03:36:14", "text": "点。我结交新朋友的第一个点。"}, {"type": "subtitle", "time": 12978.15, "timestamp": "03:36:18", "text": "我不是那种人，我不会主动去。"}, {"type": "subtitle", "time": 12981.75, "timestamp": "03:36:21", "text": "围绕制作。所以，是的，如果他们……我会这么做。"}, {"type": "subtitle", "time": 12984.15, "timestamp": "03:36:24", "text": "如果他们主动提出这个立场，我将"}, {"type": "subtitle", "time": 12985.389, "timestamp": "03:36:25", "text": "制作"}, {"type": "subtitle", "time": 12995.83, "timestamp": "03:36:35", "text": "他们有，他们说是，他们说不，"}, {"type": "subtitle", "time": 12997.15, "timestamp": "03:36:37", "text": "我不是"}, {"type": "subtitle", "time": 13001.269, "timestamp": "03:36:41", "text": "感兴趣的。所以，嗯，差不多是这样。"}, {"type": "subtitle", "time": 13004.309, "timestamp": "03:36:44", "text": "第一个圆圈是绿色的，你呢？"}, {"type": "subtitle", "time": 13007.469, "timestamp": "03:36:47", "text": "经常结交新朋友"}, {"type": "subtitle", "time": 13011.95, "timestamp": "03:36:51", "text": "嗯，复杂而新颖的想法令人兴奋"}, {"type": "subtitle", "time": 13014.91, "timestamp": "03:36:54", "text": "你应该"}, {"type": "subtitle", "time": 13018.67, "timestamp": "03:36:58", "text": "我不同意，我不喜欢复杂的工作"}]
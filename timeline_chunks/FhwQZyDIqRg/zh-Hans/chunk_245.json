[{"type": "subtitle", "time": 14703.03, "timestamp": "04:05:03", "text": "人生中，有时候你必须这么做。你"}, {"type": "subtitle", "time": 14705.67, "timestamp": "04:05:05", "text": "总有一天要做的。有一天或"}, {"type": "subtitle", "time": 14707.51, "timestamp": "04:05:07", "text": "其他。你必须，你必须成为"}, {"type": "subtitle", "time": 14710.63, "timestamp": "04:05:10", "text": "混蛋总有一天会至少得到"}, {"type": "subtitle", "time": 14712.15, "timestamp": "04:05:12", "text": "任务完成。别做个混蛋"}, {"type": "subtitle", "time": 14713.67, "timestamp": "04:05:13", "text": "时间。这对他/她来说并不好。"}, {"type": "subtitle", "time": 14717.269, "timestamp": "04:05:17", "text": "你。是的。是的。这不利于"}, {"type": "subtitle", "time": 14719.51, "timestamp": "04:05:19", "text": "你的健康。你或你的健康。你"}, {"type": "subtitle", "time": 14721.349, "timestamp": "04:05:21", "text": "宁愿先做完家务再允许别人来。"}, {"type": "subtitle", "time": 14730.95, "timestamp": "04:05:30", "text": "嗯，第一丑。丑陋程度一级。我"}, {"type": "subtitle", "time": 14733.51, "timestamp": "04:05:33", "text": "不，我不喜欢重复做这件事"}, {"type": "subtitle", "time": 14736.389, "timestamp": "04:05:36", "text": "睡前做完家务。我通常"}, {"type": "subtitle", "time": 14738.55, "timestamp": "04:05:38", "text": "放下。"}, {"type": "subtitle", "time": 14741.429, "timestamp": "04:05:41", "text": "哦，请继续，Sh先生。"}, {"type": "subtitle", "time": 14745.03, "timestamp": "04:05:45", "text": "不，意思一样。我也是。我也是。"}, {"type": "subtitle", "time": 14750.309, "timestamp": "04:05:50", "text": "哦，原来你在吃东西啊。"}, {"type": "subtitle", "time": 14753.349, "timestamp": "04:05:53", "text": "是的。总之，是的。我觉得我不会"}, {"type": "subtitle", "time": 14755.91, "timestamp": "04:05:55", "text": "就像我不得不做的那样，重复"}, {"type": "subtitle", "time": 14757.83, "timestamp": "04:05:57", "text": "睡前把所有家务都做完。不，"}]
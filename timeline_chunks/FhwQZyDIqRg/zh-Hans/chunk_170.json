[{"type": "subtitle", "time": 10204.79, "timestamp": "02:50:04", "text": "你得赶紧跑。我不能"}, {"type": "subtitle", "time": 10208.55, "timestamp": "02:50:08", "text": "跑步。快点。哦。"}, {"type": "subtitle", "time": 10211.67, "timestamp": "02:50:11", "text": "好的。我们走吧。他们在奔跑。"}, {"type": "subtitle", "time": 10214.27, "timestamp": "02:50:14", "text": "是的。大家都准备好了吗？是的。"}, {"type": "subtitle", "time": 10215.75, "timestamp": "02:50:15", "text": "[掌声]"}, {"type": "subtitle", "time": 10218.95, "timestamp": "02:50:18", "text": "好的。好的。我很喜欢这样。你知道"}, {"type": "subtitle", "time": 10220.55, "timestamp": "02:50:20", "text": "现在发生了什么？我们将要"}, {"type": "subtitle", "time": 10223.83, "timestamp": "02:50:23", "text": "你知道，这是我们最长的一次连胜。是的。"}, {"type": "subtitle", "time": 10225.75, "timestamp": "02:50:25", "text": "真的吗？正当我们准备关门的时候"}, {"type": "subtitle", "time": 10226.71, "timestamp": "02:50:26", "text": "这趟列车，我们将有我们的"}, {"type": "subtitle", "time": 10228.87, "timestamp": "02:50:28", "text": "最长距离。我想应该是这样。"}, {"type": "subtitle", "time": 10231.59, "timestamp": "02:50:31", "text": "因为我们几个男生之间还没有建立起深厚的感情。"}, {"type": "subtitle", "time": 10233.67, "timestamp": "02:50:33", "text": "现在我们因为动漫而结缘，现在我们有了"}, {"type": "subtitle", "time": 10237.59, "timestamp": "02:50:37", "text": "团队。我们拥有动漫的力量。"}, {"type": "subtitle", "time": 10241.11, "timestamp": "02:50:41", "text": "我们有很多你们知道的"}, {"type": "subtitle", "time": 10244.87, "timestamp": "02:50:44", "text": "我们抓到那只动物了。所以过去曾有一个"}, {"type": "subtitle", "time": 10246.71, "timestamp": "02:50:46", "text": "以前坐在这里的那个人。我称之为"}, {"type": "subtitle", "time": 10248.87, "timestamp": "02:50:48", "text": "某某先生来自布朗克斯。我不知道"}, {"type": "subtitle", "time": 10250.389, "timestamp": "02:50:50", "text": "这一切最终都去了哪里？那真是太漂亮了"}, {"type": "subtitle", "time": 10252.71, "timestamp": "02:50:52", "text": "他人挺不错的。"}, {"type": "subtitle", "time": 10255.51, "timestamp": "02:50:55", "text": "哦，这太棒了。哦。哦，你应该"}, {"type": "subtitle", "time": 10257.51, "timestamp": "02:50:57", "text": "按下 Q 键。应该没问题。有人可以吗？"}]
[{"type": "subtitle", "time": 5341.79, "timestamp": "01:29:01", "text": "我们需要多少？我们需要大约8美元。那"}, {"type": "subtitle", "time": 5345.43, "timestamp": "01:29:05", "text": "这意味着我们还需要五个。是的，五个"}, {"type": "subtitle", "time": 5348.07, "timestamp": "01:29:08", "text": "更多的。浪费的金额是7美元。以便"}, {"type": "subtitle", "time": 5351.27, "timestamp": "01:29:11", "text": "本来可以省下7美元。我以为那是"}, {"type": "subtitle", "time": 5353.99, "timestamp": "01:29:13", "text": "7,000。哦，不。先生，我好像看到"}, {"type": "subtitle", "time": 5357.189, "timestamp": "01:29:17", "text": "某物。就是检查，检查一下。"}, {"type": "subtitle", "time": 5359.51, "timestamp": "01:29:19", "text": "仔细检查一下。呃，是七点。哦"}, {"type": "subtitle", "time": 5363.59, "timestamp": "01:29:23", "text": "我的天，这不是逗号。我的天啊。"}, {"type": "subtitle", "time": 5366.39, "timestamp": "01:29:26", "text": "我们竟然为了残羹剩饭而丧命。是"}, {"type": "subtitle", "time": 5369.51, "timestamp": "01:29:29", "text": "为了残羹剩饭而死。我的天哪。你"}, {"type": "subtitle", "time": 5373.91, "timestamp": "01:29:33", "text": "还记得吗？你也是个废物。"}, {"type": "subtitle", "time": 5375.59, "timestamp": "01:29:35", "text": "哦，不。你实际上是在谈论"}, {"type": "subtitle", "time": 5378.629, "timestamp": "01:29:38", "text": "模型。模型。当心。是"}, {"type": "subtitle", "time": 5382.229, "timestamp": "01:29:42", "text": "小心。没弄坏。不，不，不。"}, {"type": "subtitle", "time": 5383.59, "timestamp": "01:29:43", "text": "有鬼。有鬼。那是"}, {"type": "subtitle", "time": 5384.79, "timestamp": "01:29:44", "text": "她参选的原因。有一个"}, {"type": "subtitle", "time": 5387.51, "timestamp": "01:29:47", "text": "鬼。她听到了。"}, {"type": "subtitle", "time": 5388.99, "timestamp": "01:29:48", "text": "是的，确实如此。她听到"}, {"type": "subtitle", "time": 5393.59, "timestamp": "01:29:53", "text": "它。哦，别说话。是，别说话。"}, {"type": "subtitle", "time": 5395.25, "timestamp": "01:29:55", "text": "哦，我们有一枚手榴弹。"}, {"type": "subtitle", "time": 5398.39, "timestamp": "01:29:58", "text": "[音乐]"}]
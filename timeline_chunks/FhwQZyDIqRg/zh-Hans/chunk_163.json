[{"type": "subtitle", "time": 9781.11, "timestamp": "02:43:01", "text": "放一个在那儿，兄弟。放一个"}, {"type": "subtitle", "time": 9784.07, "timestamp": "02:43:04", "text": "那里。我当时就想，“是啊，确实有。”"}, {"type": "subtitle", "time": 9785.91, "timestamp": "02:43:05", "text": "我拥有力量和耐力。"}, {"type": "subtitle", "time": 9787.75, "timestamp": "02:43:07", "text": "放在那里。我不了解其他人的情况。我"}, {"type": "subtitle", "time": 9789.51, "timestamp": "02:43:09", "text": "就好像我真的从……里抓了一个一样"}, {"type": "subtitle", "time": 9792.15, "timestamp": "02:43:12", "text": "把它放在地板上。"}, {"type": "subtitle", "time": 9794.469, "timestamp": "02:43:14", "text": "我看到有两个。到底是谁拿走了"}, {"type": "subtitle", "time": 9796.309, "timestamp": "02:43:16", "text": "把它拿走？"}, {"type": "subtitle", "time": 9798.63, "timestamp": "02:43:18", "text": "哦，我想我们没买它是因为它"}, {"type": "subtitle", "time": 9800.63, "timestamp": "02:43:20", "text": "太贵了。"}, {"type": "subtitle", "time": 9804.309, "timestamp": "02:43:24", "text": "不，我们必须反抗。不，我得到了一个"}, {"type": "subtitle", "time": 9808.389, "timestamp": "02:43:28", "text": "奖杯，伙计们。让我来说说。"}, {"type": "subtitle", "time": 9810.55, "timestamp": "02:43:30", "text": "你还在看 Moose 的比赛吗？"}, {"type": "subtitle", "time": 9817.349, "timestamp": "02:43:37", "text": "外面是什么情况？"}, {"type": "subtitle", "time": 9819.91, "timestamp": "02:43:39", "text": "你刚才发生了什么事？我知道。为什么"}, {"type": "subtitle", "time": 9823.83, "timestamp": "02:43:43", "text": "我当时在……电视跳转"}, {"type": "subtitle", "time": 9825.67, "timestamp": "02:43:45", "text": "吓。"}, {"type": "subtitle", "time": 9828.71, "timestamp": "02:43:48", "text": "车在哪儿？"}, {"type": "subtitle", "time": 9834.71, "timestamp": "02:43:54", "text": "哦，我为什么会崩溃？你只是"}, {"type": "subtitle", "time": 9836.71, "timestamp": "02:43:56", "text": "兄弟，你会碰到我吗？我有一个"}]
[{"type": "subtitle", "time": 2100.55, "timestamp": "00:35:00", "text": "“兄弟，我单挑啊。” 伙计，我进去了"}, {"type": "subtitle", "time": 2103.67, "timestamp": "00:35:03", "text": "第一个房间我就死了。"}, {"type": "subtitle", "time": 2105.47, "timestamp": "00:35:05", "text": "哦，"}, {"type": "subtitle", "time": 2109.349, "timestamp": "00:35:09", "text": "我的，而且我知道。有点吓人。"}, {"type": "subtitle", "time": 2111.19, "timestamp": "00:35:11", "text": "这有点搞笑，因为当你"}, {"type": "subtitle", "time": 2114.31, "timestamp": "00:35:14", "text": "一个人玩的话，挺吓人的。"}, {"type": "subtitle", "time": 2116.71, "timestamp": "00:35:16", "text": "是的，没错。是的，是的。我"}, {"type": "subtitle", "time": 2118.99, "timestamp": "00:35:18", "text": "意思是，好吧。我的脸怎么了？"}, {"type": "subtitle", "time": 2121.91, "timestamp": "00:35:21", "text": "是的。但现在没事了。现在是"}, {"type": "subtitle", "time": 2124.23, "timestamp": "00:35:24", "text": "完全没问题。我觉得它会……"}, {"type": "subtitle", "time": 2134.63, "timestamp": "00:35:34", "text": "美好的。呃，医学。好的。知道了。得到"}, {"type": "subtitle", "time": 2138.31, "timestamp": "00:35:38", "text": "他。他在那里。他在那里。好的。我"}, {"type": "subtitle", "time": 2141.19, "timestamp": "00:35:41", "text": "邀请了他。"}, {"type": "subtitle", "time": 2150.95, "timestamp": "00:35:50", "text": "为什么我的延迟是 62？我应该"}, {"type": "subtitle", "time": 2154.55, "timestamp": "00:35:54", "text": "网络不好。"}, {"type": "subtitle", "time": 2158.31, "timestamp": "00:35:58", "text": "你的什么？我的游戏延迟似乎"}]
[{"type": "subtitle", "time": 15901.229, "timestamp": "04:25:01", "text": "除了所有"}, {"type": "subtitle", "time": 15904.87, "timestamp": "04:25:04", "text": "那些。我想，事情就是这样了。"}, {"type": "subtitle", "time": 15907.51, "timestamp": "04:25:07", "text": "杰克先生，进展如何？你好吗？"}, {"type": "subtitle", "time": 15909.91, "timestamp": "04:25:09", "text": "考试进行中吗？是的。是的，我也是。"}, {"type": "subtitle", "time": 15912.07, "timestamp": "04:25:12", "text": "随你摆放。"}, {"type": "subtitle", "time": 15922.07, "timestamp": "04:25:22", "text": "你被各种形式的……所吸引"}, {"type": "subtitle", "time": 15925.07, "timestamp": "04:25:25", "text": "创意表达，例如写作。呃。"}, {"type": "subtitle", "time": 15930.269, "timestamp": "04:25:30", "text": "不同意。难的"}, {"type": "subtitle", "time": 15932.79, "timestamp": "04:25:32", "text": "不同意。你通常会根据自己的选择做出选择"}, {"type": "subtitle", "time": 15934.83, "timestamp": "04:25:34", "text": "基于客观事实"}, {"type": "subtitle", "time": 15938.309, "timestamp": "04:25:38", "text": "然后根据客观因素做出选择"}, {"type": "subtitle", "time": 15940.79, "timestamp": "04:25:40", "text": "陈述事实而非表达情感。"}, {"type": "subtitle", "time": 15943.349, "timestamp": "04:25:43", "text": "两者兼而有之。"}, {"type": "subtitle", "time": 15949.87, "timestamp": "04:25:49", "text": "呃，我会考虑的。"}, {"type": "subtitle", "time": 15954.149, "timestamp": "04:25:54", "text": "事实比情感更重要"}, {"type": "subtitle", "time": 15957.149, "timestamp": "04:25:57", "text": "如果做出决定"}, {"type": "subtitle", "time": 15959.99, "timestamp": "04:25:59", "text": "制作。我更倾向于……"}]
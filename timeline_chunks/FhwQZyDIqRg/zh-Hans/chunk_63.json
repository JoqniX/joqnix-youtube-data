[{"type": "subtitle", "time": 3780.87, "timestamp": "01:03:00", "text": "实际上是躲在后面。我当时就想，"}, {"type": "subtitle", "time": 3783.67, "timestamp": "01:03:03", "text": "“妈的。”是的，我要把它关掉了。哦，"}, {"type": "subtitle", "time": 3786.15, "timestamp": "01:03:06", "text": "该死。我们应该躲起来。他可能已经"}, {"type": "subtitle", "time": 3788.39, "timestamp": "01:03:08", "text": "就像左边一样。你知道，那就是"}, {"type": "subtitle", "time": 3789.67, "timestamp": "01:03:09", "text": "事物。你根本不知道他们在哪儿"}, {"type": "subtitle", "time": 3792.789, "timestamp": "01:03:12", "text": "是。好的。哇。又来了。一对一"}, {"type": "subtitle", "time": 3794.549, "timestamp": "01:03:14", "text": "时间。"}, {"type": "subtitle", "time": 3828.39, "timestamp": "01:03:48", "text": "[音乐]"}, {"type": "subtitle", "time": 3829.789, "timestamp": "01:03:49", "text": "哦，我抓住了"}, {"type": "subtitle", "time": 3832.15, "timestamp": "01:03:52", "text": "某物。我勒个去？别来"}, {"type": "subtitle", "time": 3834.069, "timestamp": "01:03:54", "text": "在我附近。如果你这样做，我就要打你。"}, {"type": "subtitle", "time": 3837.029, "timestamp": "01:03:57", "text": "靠近我。不要靠近我。我是"}]
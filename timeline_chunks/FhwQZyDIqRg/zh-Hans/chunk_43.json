[{"type": "subtitle", "time": 2580.96, "timestamp": "00:43:00", "text": "那么，谁来扛？好的，你是 我准备把它带走。我要携带"}, {"type": "subtitle", "time": 2583.24, "timestamp": "00:43:03", "text": "我准备把它带走。我要携带 它。糟糕的司机，哦，不。"}, {"type": "subtitle", "time": 2592.23, "timestamp": "00:43:12", "text": "各位，各位，各位，我没有驾照"}, {"type": "subtitle", "time": 2594.309, "timestamp": "00:43:14", "text": "执照。我的错，查德。给我。我"}, {"type": "subtitle", "time": 2596.069, "timestamp": "00:43:16", "text": "有一个。我有一个有效的。我正在跑步"}, {"type": "subtitle", "time": 2599.109, "timestamp": "00:43:19", "text": "远离你。你在哪里？我的错。我的"}, {"type": "subtitle", "time": 2601.829, "timestamp": "00:43:21", "text": "坏的。这就是为什么蜘蛛这么多的原因"}, {"type": "subtitle", "time": 2603.349, "timestamp": "00:43:23", "text": "蛛网，"}, {"type": "subtitle", "time": 2605.19, "timestamp": "00:43:25", "text": "伙计们？我们已经有东西了。我们"}, {"type": "subtitle", "time": 2607.27, "timestamp": "00:43:27", "text": "我已经有东西了。继续捡起来。"}, {"type": "subtitle", "time": 2609.109, "timestamp": "00:43:29", "text": "继续捡起来。我把它放在那里。"}, {"type": "subtitle", "time": 2611.109, "timestamp": "00:43:31", "text": "我的天啊。我们真的得到了一些东西。"}, {"type": "subtitle", "time": 2613.19, "timestamp": "00:43:33", "text": "价格昂贵，而且看起来有点重。"}, {"type": "subtitle", "time": 2617.27, "timestamp": "00:43:37", "text": "哦不，它很重。好的，让我……"}, {"type": "subtitle", "time": 2620.309, "timestamp": "00:43:40", "text": "逃跑。伙计们，我觉得我要……"}, {"type": "subtitle", "time": 2621.99, "timestamp": "00:43:41", "text": "你得搬家，因为我"}, {"type": "subtitle", "time": 2625.349, "timestamp": "00:43:45", "text": "我觉得我身上带着什么东西。"}, {"type": "subtitle", "time": 2629.51, "timestamp": "00:43:49", "text": "用它把你打倒。我会帮助你。"}, {"type": "subtitle", "time": 2631.99, "timestamp": "00:43:51", "text": "我们走吧。就一直来吧。"}, {"type": "subtitle", "time": 2634.39, "timestamp": "00:43:54", "text": "继续来。继续来。只是"}, {"type": "subtitle", "time": 2636.309, "timestamp": "00:43:56", "text": "请继续。就一直待在某个地方吧。"}, {"type": "subtitle", "time": 2638.47, "timestamp": "00:43:58", "text": "我被困在某个地方了。是的，你被困住了。"}]
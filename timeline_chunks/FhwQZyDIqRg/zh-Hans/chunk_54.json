[{"type": "subtitle", "time": 3241.67, "timestamp": "00:54:01", "text": "每当他看到我的时候。我只是"}, {"type": "subtitle", "time": 3245.03, "timestamp": "00:54:05", "text": "问。我觉得他们逃跑了。"}, {"type": "subtitle", "time": 3247.51, "timestamp": "00:54:07", "text": "他们逃跑了。不，兄弟。我们死定了。哦，"}, {"type": "subtitle", "time": 3250.23, "timestamp": "00:54:10", "text": "你说的逃跑是什么意思？是的。它是"}, {"type": "subtitle", "time": 3252.309, "timestamp": "00:54:12", "text": "我。他试图逃跑，但他们……"}, {"type": "subtitle", "time": 3254.39, "timestamp": "00:54:14", "text": "死的。是的。"}, {"type": "subtitle", "time": 3257.67, "timestamp": "00:54:17", "text": "哦，不。不，离我远点。逃离"}, {"type": "subtitle", "time": 3260.39, "timestamp": "00:54:20", "text": "来自我。逃离。哦，他的声音是"}, {"type": "subtitle", "time": 3263.03, "timestamp": "00:54:23", "text": "实际上，情况正在发生变化。哦，你真丑。"}, {"type": "subtitle", "time": 3266.19, "timestamp": "00:54:26", "text": "你长得丑。你长得丑。不，你是"}, {"type": "subtitle", "time": 3268.39, "timestamp": "00:54:28", "text": "丑陋的。你还好吗？我勒个去？不，"}, {"type": "subtitle", "time": 3270.63, "timestamp": "00:54:30", "text": "我死了。我死了。我死了。我不能"}, {"type": "subtitle", "time": 3273.79, "timestamp": "00:54:33", "text": "长得真丑，老兄。兄弟，这是"}, {"type": "subtitle", "time": 3277.75, "timestamp": "00:54:37", "text": "欢迎光临。欢迎。不，你炸毁了"}, {"type": "subtitle", "time": 3280.87, "timestamp": "00:54:40", "text": "离开。你简直炸开了锅。你的身体"}, {"type": "subtitle", "time": 3282.95, "timestamp": "00:54:42", "text": "爆炸声响起，你的头就掉进了……"}, {"type": "subtitle", "time": 3285.109, "timestamp": "00:54:45", "text": "大车。感觉就像在问：你在吗？不，"}, {"type": "subtitle", "time": 3288.95, "timestamp": "00:54:48", "text": "他就在我面前。他进来了"}, {"type": "subtitle", "time": 3292.79, "timestamp": "00:54:52", "text": "购物车。看看有多少个正面朝上。"}, {"type": "subtitle", "time": 3295.109, "timestamp": "00:54:55", "text": "在车里对我说话。你把他放在那里"}, {"type": "subtitle", "time": 3299.27, "timestamp": "00:54:59", "text": "总是。哦不，她不是。"}]
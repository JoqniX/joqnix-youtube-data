[{"type": "subtitle", "time": 6245.83, "timestamp": "01:44:05", "text": "那里有一大袋钱。它是"}, {"type": "subtitle", "time": 6248.629, "timestamp": "01:44:08", "text": "美好的。我们把他们带到提取点去。"}, {"type": "subtitle", "time": 6251.59, "timestamp": "01:44:11", "text": "我会站在你们前面。"}, {"type": "subtitle", "time": 6253.109, "timestamp": "01:44:13", "text": "所以，如果有什么事发生，我会……"}, {"type": "subtitle", "time": 6255.75, "timestamp": "01:44:15", "text": "用手榴弹炸它。你们都退后。我有"}, {"type": "subtitle", "time": 6258.07, "timestamp": "01:44:18", "text": "就是那件东西，兄弟。别这么说。"}, {"type": "subtitle", "time": 6259.59, "timestamp": "01:44:19", "text": "是的，我要扔手榴弹。我没看到"}, {"type": "subtitle", "time": 6261.27, "timestamp": "01:44:21", "text": "道路。这是为什么？我没看到"}, {"type": "subtitle", "time": 6266.39, "timestamp": "01:44:26", "text": "方式。哦好的。下一个。"}, {"type": "subtitle", "time": 6268.709, "timestamp": "01:44:28", "text": "我们就这样四处走走，直到找到为止。"}, {"type": "subtitle", "time": 6270.55, "timestamp": "01:44:30", "text": "猜测。"}, {"type": "subtitle", "time": 6279.03, "timestamp": "01:44:39", "text": "让我们来看看。您能吗？您能吗？"}, {"type": "subtitle", "time": 6281.669, "timestamp": "01:44:41", "text": "用这个分量锅做个实验"}, {"type": "subtitle", "time": 6284.31, "timestamp": "01:44:44", "text": "这里？它能增加生命值吗？绿色"}, {"type": "subtitle", "time": 6287.03, "timestamp": "01:44:47", "text": "一？绿色的那只？我觉得这会要了你的命"}, {"type": "subtitle", "time": 6289.35, "timestamp": "01:44:49", "text": "你。我不这么认为。它会要了你的命。我"}, {"type": "subtitle", "time": 6291.99, "timestamp": "01:44:51", "text": "不想进去。呃，让我"}, {"type": "subtitle", "time": 6294.87, "timestamp": "01:44:54", "text": "尝试。我大概有98个。"}]
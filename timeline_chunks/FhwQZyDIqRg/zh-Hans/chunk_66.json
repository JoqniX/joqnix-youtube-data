[{"type": "subtitle", "time": 3960.789, "timestamp": "01:06:00", "text": "某物？我不知道，因为每次我"}, {"type": "subtitle", "time": 3962.39, "timestamp": "01:06:02", "text": "它就是会发现我。所以你需要"}, {"type": "subtitle", "time": 3963.829, "timestamp": "01:06:03", "text": "比如躲到桌子底下"}, {"type": "subtitle", "time": 3965.829, "timestamp": "01:06:05", "text": "东西。它也能抓住你，通过……"}, {"type": "subtitle", "time": 3968.63, "timestamp": "01:06:08", "text": "方式。什么？如果你离得太近"}, {"type": "subtitle", "time": 3970.87, "timestamp": "01:06:10", "text": "即使像在桌子底下，它们也能"}, {"type": "subtitle", "time": 3973.589, "timestamp": "01:06:13", "text": "也杀了你。所以大家要小心。"}, {"type": "subtitle", "time": 3975.43, "timestamp": "01:06:15", "text": "是的。好的。快点。我们走吧。全部"}, {"type": "subtitle", "time": 3976.87, "timestamp": "01:06:16", "text": "正确的。我们走吧。我们走吧。我们走吧。"}, {"type": "subtitle", "time": 3978.47, "timestamp": "01:06:18", "text": "好了，各位。我们赢定了。"}, {"type": "subtitle", "time": 3981.029, "timestamp": "01:06:21", "text": "锁定。锁定。咱们锁定目标吧，兄弟。锁"}, {"type": "subtitle", "time": 3989.829, "timestamp": "01:06:29", "text": "想象一下，如果我们前五局就输了。"}, {"type": "subtitle", "time": 3992.789, "timestamp": "01:06:32", "text": "别说不吉利的话。别说不吉利的话。就像我们"}, {"type": "subtitle", "time": 3994.87, "timestamp": "01:06:34", "text": "必须像赶最后期限一样把它锁定下来。"}, {"type": "subtitle", "time": 3996.71, "timestamp": "01:06:36", "text": "你知道。伙计们，拜托。离合器。好的"}, {"type": "subtitle", "time": 3999.27, "timestamp": "01:06:39", "text": "伙计们，走吧。哦，那不一样。"}, {"type": "subtitle", "time": 4001.27, "timestamp": "01:06:41", "text": "房间。我不想像我一样杀人。"}, {"type": "subtitle", "time": 4004.63, "timestamp": "01:06:44", "text": "做过。这附近要小心。我想我已经"}, {"type": "subtitle", "time": 4006.71, "timestamp": "01:06:46", "text": "我见过那个拿枪的盲人。"}, {"type": "subtitle", "time": 4009.829, "timestamp": "01:06:49", "text": "有朝一日会在这里生成。哦，是的。地狱"}, {"type": "subtitle", "time": 4012.23, "timestamp": "01:06:52", "text": "是的。我认为女巫我认为"}, {"type": "subtitle", "time": 4014.95, "timestamp": "01:06:54", "text": "女巫来了。就像女巫呃"}, {"type": "subtitle", "time": 4017.829, "timestamp": "01:06:57", "text": "我的天啊。我的天哪。哎哟。哦，对不起。"}]
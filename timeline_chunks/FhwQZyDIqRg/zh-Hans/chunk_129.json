[{"type": "subtitle", "time": 7742.87, "timestamp": "02:09:02", "text": "我是。哦，我真是太抱歉了。没关系。"}, {"type": "subtitle", "time": 7744.55, "timestamp": "02:09:04", "text": "哦，对不起。我不知道该怎么办。"}, {"type": "subtitle", "time": 7746.149, "timestamp": "02:09:06", "text": "我不知道该怎么办。好的，这个"}, {"type": "subtitle", "time": 7748.31, "timestamp": "02:09:08", "text": "时间。是的，我们去抓你。那是"}, {"type": "subtitle", "time": 7750.87, "timestamp": "02:09:10", "text": "真的，我真的觉得关键在于"}, {"type": "subtitle", "time": 7754.149, "timestamp": "02:09:14", "text": "当时没有一个活着的人。没关系。没关系。"}, {"type": "subtitle", "time": 7756.709, "timestamp": "02:09:16", "text": "这种事时有发生。我不会分享我的HP"}, {"type": "subtitle", "time": 7759.109, "timestamp": "02:09:19", "text": "不再是了。"}, {"type": "subtitle", "time": 7760.669, "timestamp": "02:09:20", "text": "我"}, {"type": "subtitle", "time": 7763.35, "timestamp": "02:09:23", "text": "很糟糕。我把它拖到这里来的。嘿，"}, {"type": "subtitle", "time": 7767.109, "timestamp": "02:09:27", "text": "我也可以要一个吗？是的。去"}, {"type": "subtitle", "time": 7768.709, "timestamp": "02:09:28", "text": "前方。"}, {"type": "subtitle", "time": 7770.31, "timestamp": "02:09:30", "text": "伙计们，我们该买那把霰弹枪吗？你"}, {"type": "subtitle", "time": 7772.629, "timestamp": "02:09:32", "text": "想要霰弹枪吗？是的。我想我的意思"}, {"type": "subtitle", "time": 7774.39, "timestamp": "02:09:34", "text": "你肯定得用它。或许"}, {"type": "subtitle", "time": 7778.149, "timestamp": "02:09:38", "text": "我真希望我们能把那个人毙了。"}, {"type": "subtitle", "time": 7779.669, "timestamp": "02:09:39", "text": "现在。"}, {"type": "subtitle", "time": 7782.39, "timestamp": "02:09:42", "text": "你把它留下了，所以现在是我的了。伙计们，是"}, {"type": "subtitle", "time": 7785.189, "timestamp": "02:09:45", "text": "我们也是吗？等等，我们可以只拿XP吗？"}, {"type": "subtitle", "time": 7787.75, "timestamp": "02:09:47", "text": "我们能不能一起拿XP？"}, {"type": "subtitle", "time": 7789.589, "timestamp": "02:09:49", "text": "尽管？那岂不是很酷吗？就像你一样"}, {"type": "subtitle", "time": 7792.55, "timestamp": "02:09:52", "text": "可以尝试，但想象一下如果失败了会怎样。"}, {"type": "subtitle", "time": 7794.95, "timestamp": "02:09:54", "text": "在我们面前。我可以这样做吗？我可以吗？"}, {"type": "subtitle", "time": 7796.95, "timestamp": "02:09:56", "text": "我把它拿走？我觉得跟你一起来吧"}, {"type": "subtitle", "time": 7798.79, "timestamp": "02:09:58", "text": "我应该先买那个。你需要"}]
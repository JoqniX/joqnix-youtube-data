[{"type": "subtitle", "time": 8641.349, "timestamp": "02:24:01", "text": "本季的剧集也如此"}, {"type": "subtitle", "time": 8645.03, "timestamp": "02:24:05", "text": "当他回想起往事时"}, {"type": "subtitle", "time": 8647.67, "timestamp": "02:24:07", "text": "他确实把哥特玛萨当成一个对象。"}, {"type": "subtitle", "time": 8649.19, "timestamp": "02:24:09", "text": "朋友，哦，我要去看看我"}, {"type": "subtitle", "time": 8650.87, "timestamp": "02:24:10", "text": "现在我知道了，我要再去看一遍。"}, {"type": "subtitle", "time": 8653.349, "timestamp": "02:24:13", "text": "那里有首歌，还有13"}, {"type": "subtitle", "time": 8657.19, "timestamp": "02:24:17", "text": "踏板和13个泰坦，然后是玩具和"}, {"type": "subtitle", "time": 8658.87, "timestamp": "02:24:18", "text": "你在开头看到的那个"}, {"type": "subtitle", "time": 8661.429, "timestamp": "02:24:21", "text": "场景实际上是马匹"}, {"type": "subtitle", "time": 8662.87, "timestamp": "02:24:22", "text": "会被杀。那些是士兵。"}, {"type": "subtitle", "time": 8665.429, "timestamp": "02:24:25", "text": "等等，打开那里有一只猴子叫"}, {"type": "subtitle", "time": 8667.83, "timestamp": "02:24:27", "text": "猴。呃，我想是那个……呃，是"}, {"type": "subtitle", "time": 8671.59, "timestamp": "02:24:31", "text": "呃，上个赛季。哦，开幕了。"}, {"type": "subtitle", "time": 8673.67, "timestamp": "02:24:33", "text": "好的。是的，这可能是第一个或"}, {"type": "subtitle", "time": 8675.429, "timestamp": "02:24:35", "text": "第二季。我查一下。所以，"}, {"type": "subtitle", "time": 8680.389, "timestamp": "02:24:40", "text": "就像……是隆隆声还是……"}, {"type": "subtitle", "time": 8687.83, "timestamp": "02:24:47", "text": "不，不是隆隆声。非漫游。嗯，还有"}, {"type": "subtitle", "time": 8690.309, "timestamp": "02:24:50", "text": "提到艾琳的地方太多了。"}, {"type": "subtitle", "time": 8692.07, "timestamp": "02:24:52", "text": "而泽克就站在那里。"}, {"type": "subtitle", "time": 8695.19, "timestamp": "02:24:55", "text": "背景。是的，我们看过那段视频。"}, {"type": "subtitle", "time": 8699.23, "timestamp": "02:24:59", "text": "爱丁：是的。就像那里曾经有过一样"}]
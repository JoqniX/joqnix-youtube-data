[{"type": "subtitle", "time": 10261.11, "timestamp": "02:51:01", "text": "给我买张快递单？不，谢谢。是的。"}, {"type": "subtitle", "time": 10262.389, "timestamp": "02:51:02", "text": "不，谢谢。我本来打算"}, {"type": "subtitle", "time": 10264.23, "timestamp": "02:51:04", "text": "去做。我本来打算这么做的。"}, {"type": "subtitle", "time": 10266.389, "timestamp": "02:51:06", "text": "它。我的耐力正在增强。伟大的。我是"}, {"type": "subtitle", "time": 10268.71, "timestamp": "02:51:08", "text": "再说一遍。这是我的。"}, {"type": "subtitle", "time": 10271.269, "timestamp": "02:51:11", "text": "好的。耐力提升。我还有另一个"}, {"type": "subtitle", "time": 10273.269, "timestamp": "02:51:13", "text": "耐力。各位，这些是什么？这些是吗？"}, {"type": "subtitle", "time": 10275.51, "timestamp": "02:51:15", "text": "蜡烛？我买了旋转喷雾。我的天啊。"}, {"type": "subtitle", "time": 10277.03, "timestamp": "02:51:17", "text": "这些是蜡烛。这些是什么？"}, {"type": "subtitle", "time": 10284.07, "timestamp": "02:51:24", "text": "正确的。纳蒂。注意身体健康。"}, {"type": "subtitle", "time": 10285.59, "timestamp": "02:51:25", "text": "低设置。所以它们看起来就像"}, {"type": "subtitle", "time": 10287.07, "timestamp": "02:51:27", "text": "对我来说是铅笔。喜欢"}, {"type": "subtitle", "time": 10289.75, "timestamp": "02:51:29", "text": "巨大的领先优势。所以他们基本上是"}, {"type": "subtitle", "time": 10290.87, "timestamp": "02:51:30", "text": "就像他们看起来像"}, {"type": "subtitle", "time": 10293.51, "timestamp": "02:51:33", "text": "蜡烛。我打算这么做。所以，赶紧行动吧"}, {"type": "subtitle", "time": 10298.07, "timestamp": "02:51:38", "text": "准备好。准备。准备。为了什么？"}, {"type": "subtitle", "time": 10301.03, "timestamp": "02:51:41", "text": "活着。活着。"}, {"type": "subtitle", "time": 10303.91, "timestamp": "02:51:43", "text": "进来吧，伙计们，进来吧。惠普。拿走惠普。"}, {"type": "subtitle", "time": 10306.55, "timestamp": "02:51:46", "text": "拿走惠普。任何需要的人。在哪里？"}, {"type": "subtitle", "time": 10309.75, "timestamp": "02:51:49", "text": "它？任何需要的人。好的。我该怎么办？"}, {"type": "subtitle", "time": 10312.63, "timestamp": "02:51:52", "text": "做？呃，你需要吗？我们可以拿一个"}, {"type": "subtitle", "time": 10316.15, "timestamp": "02:51:56", "text": "更多的。你拿着它。忍住，直到你……"}, {"type": "subtitle", "time": 10317.349, "timestamp": "02:51:57", "text": "继续拿着。务必不要这样做"}, {"type": "subtitle", "time": 10318.95, "timestamp": "02:51:58", "text": "按下并松开鼠标左键。确保"}]
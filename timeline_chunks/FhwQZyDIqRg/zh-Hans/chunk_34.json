[{"type": "subtitle", "time": 2042.31, "timestamp": "00:34:02", "text": "所有人都能看到吗？好的，给我一个"}, {"type": "subtitle", "time": 2045.549, "timestamp": "00:34:05", "text": "第二。他们现在在哪儿？"}, {"type": "subtitle", "time": 2048.03, "timestamp": "00:34:08", "text": "等等，什么？"}, {"type": "subtitle", "time": 2050.589, "timestamp": "00:34:10", "text": "为什么？它去哪儿了？"}, {"type": "chat", "time": 2053.373, "timestamp": "00:34:13", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "oh a collab"}, {"type": "subtitle", "time": 2054.19, "timestamp": "00:34:14", "text": "在哪里？哦，上帝，我恨"}, {"type": "chat", "time": 2058.247, "timestamp": "00:34:18", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "goodgood"}, {"type": "subtitle", "time": 2064.389, "timestamp": "00:34:24", "text": "呃，请稍等一下。稍等片刻。"}, {"type": "subtitle", "time": 2069.71, "timestamp": "00:34:29", "text": "我会。好的。我需要"}, {"type": "subtitle", "time": 2073.909, "timestamp": "00:34:33", "text": "迅速地。好的。我需要。是的。好的。"}, {"type": "subtitle", "time": 2075.629, "timestamp": "00:34:35", "text": "所以，我们都在等待"}, {"type": "subtitle", "time": 2078.47, "timestamp": "00:34:38", "text": "再加一个人。不，还有两个人"}, {"type": "subtitle", "time": 2080.99, "timestamp": "00:34:40", "text": "加入其中。"}, {"type": "subtitle", "time": 2089.349, "timestamp": "00:34:49", "text": "哎，这太奇怪了，因为我当时"}, {"type": "subtitle", "time": 2091.829, "timestamp": "00:34:51", "text": "其实之前玩过这个游戏"}, {"type": "subtitle", "time": 2093.349, "timestamp": "00:34:53", "text": "因为我无聊。我不知道什么"}, {"type": "subtitle", "time": 2095.19, "timestamp": "00:34:55", "text": "待办事项。所以，7点30分，我登录了系统，"}, {"type": "subtitle", "time": 2096.99, "timestamp": "00:34:56", "text": "我当时想，“好吧，那就试试看吧。”"}]
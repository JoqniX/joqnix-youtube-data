[{"type": "subtitle", "time": 8520.15, "timestamp": "02:22:00", "text": "就像几天前一样，抱歉，"}, {"type": "subtitle", "time": 8522.469, "timestamp": "02:22:02", "text": "几周前，我说服了某人"}, {"type": "subtitle", "time": 8524.469, "timestamp": "02:22:04", "text": "看动漫。他们说：“哦，不。我"}, {"type": "subtitle", "time": 8525.75, "timestamp": "02:22:05", "text": "我不喜欢动漫。” 我当时就想，“为什么？”"}, {"type": "subtitle", "time": 8528.63, "timestamp": "02:22:08", "text": "不是吗？”然后他们解释了这听起来是什么样的。"}, {"type": "subtitle", "time": 8530.389, "timestamp": "02:22:10", "text": "就像幼稚之类的。他们不"}, {"type": "subtitle", "time": 8533.59, "timestamp": "02:22:13", "text": "比如，或者我想说服你的事情"}, {"type": "subtitle", "time": 8543.67, "timestamp": "02:22:23", "text": "或少女深渊。哦，他们应该看看"}, {"type": "subtitle", "time": 8545.59, "timestamp": "02:22:25", "text": "它。他们会说：“哦，那是一部分。”"}, {"type": "subtitle", "time": 8548.55, "timestamp": "02:22:28", "text": "二。我们一起来看吧。"}, {"type": "subtitle", "time": 8551.99, "timestamp": "02:22:31", "text": "我的天哪。不好意思打断一下，兄弟。"}, {"type": "subtitle", "time": 8554.07, "timestamp": "02:22:34", "text": "哦，对不起。快点。快点。说出来。"}, {"type": "subtitle", "time": 8556.389, "timestamp": "02:22:36", "text": "你刚才说什么？于是，我告诉了他们。"}, {"type": "subtitle", "time": 8558.23, "timestamp": "02:22:38", "text": "这就像是讲述故事的一种方式。"}, {"type": "subtitle", "time": 8560.63, "timestamp": "02:22:40", "text": "一个故事。就像视频一样"}, {"type": "subtitle", "time": 8563.429, "timestamp": "02:22:43", "text": "游戏是一种讲述故事的方法，或者"}, {"type": "subtitle", "time": 8565.51, "timestamp": "02:22:45", "text": "电影甚至音乐都是一种方法"}, {"type": "subtitle", "time": 8567.11, "timestamp": "02:22:47", "text": "讲故事。只是一些事而已。"}, {"type": "subtitle", "time": 8570.07, "timestamp": "02:22:50", "text": "就是这样。它并非为任何人准备的"}, {"type": "subtitle", "time": 8572.07, "timestamp": "02:22:52", "text": "非常特定的受众，例如儿童或"}, {"type": "subtitle", "time": 8573.67, "timestamp": "02:22:53", "text": "算是吧？而且他们确实"}, {"type": "subtitle", "time": 8575.27, "timestamp": "02:22:55", "text": "看了一部动漫。你敢相信吗？"}, {"type": "subtitle", "time": 8577.75, "timestamp": "02:22:57", "text": "他们观看了，他们正在观看"}]
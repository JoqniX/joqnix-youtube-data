[{"type": "subtitle", "time": 5407.75, "timestamp": "01:30:07", "text": "妈的。"}, {"type": "subtitle", "time": 5409.99, "timestamp": "01:30:09", "text": "我的天哪。救救自己。你可以做到。"}, {"type": "subtitle", "time": 5418.149, "timestamp": "01:30:18", "text": "哦，她想找回自我。不，"}, {"type": "subtitle", "time": 5421.35, "timestamp": "01:30:21", "text": "她应该搬回去。后退。女孩，"}, {"type": "subtitle", "time": 5426.39, "timestamp": "01:30:26", "text": "为什么？你为什么要这样做？我没有。我"}, {"type": "subtitle", "time": 5428.79, "timestamp": "01:30:28", "text": "没想到他会在那里开枪。我"}, {"type": "subtitle", "time": 5431.75, "timestamp": "01:30:31", "text": "我以为他在到处开枪。"}, {"type": "subtitle", "time": 5434.709, "timestamp": "01:30:34", "text": "他投篮时球飞过了桌子。哦，我的天"}, {"type": "subtitle", "time": 5438.55, "timestamp": "01:30:38", "text": "上帝。没关系。渗透木材。一"}, {"type": "subtitle", "time": 5441.39, "timestamp": "01:30:41", "text": "一度。我认为"}, {"type": "subtitle", "time": 5444.629, "timestamp": "01:30:44", "text": "我们又回到了这个游戏。我讨厌这样"}, {"type": "subtitle", "time": 5446.229, "timestamp": "01:30:46", "text": "游戏。我恨杀人。所以，我是"}, {"type": "subtitle", "time": 5448.149, "timestamp": "01:30:48", "text": "就这么坚持下去。"}]
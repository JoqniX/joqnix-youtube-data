[{"type": "subtitle", "time": 15840.469, "timestamp": "04:24:00", "text": "不同意。谢谢。不，谢谢。你"}, {"type": "subtitle", "time": 15842.55, "timestamp": "04:24:02", "text": "维持一个"}, {"type": "subtitle", "time": 15846.03, "timestamp": "04:24:06", "text": "持续努力。嗯，算是吧。"}, {"type": "subtitle", "time": 15849.99, "timestamp": "04:24:09", "text": "是的。是的。尚未完成。是的。但是就像"}, {"type": "subtitle", "time": 15853.149, "timestamp": "04:24:13", "text": "呃，我仍然能得到一个"}, {"type": "subtitle", "time": 15855.99, "timestamp": "04:24:15", "text": "平衡。我会进入一个"}, {"type": "subtitle", "time": 15857.91, "timestamp": "04:24:17", "text": "禅。我会努力的。"}, {"type": "subtitle", "time": 15860.79, "timestamp": "04:24:20", "text": "首先，但如果我能找到感觉，那将会是……"}, {"type": "subtitle", "time": 15863.51, "timestamp": "04:24:23", "text": "它将被锁定。所以，我要……"}, {"type": "subtitle", "time": 15866.07, "timestamp": "04:24:26", "text": "按照一级同意的原则去做，而不是像……"}, {"type": "subtitle", "time": 15870.469, "timestamp": "04:24:30", "text": "三级同意或二级同意。嗯。"}, {"type": "subtitle", "time": 15873.269, "timestamp": "04:24:33", "text": "你很少会对自己做出的选择产生怀疑。"}, {"type": "subtitle", "time": 15875.07, "timestamp": "04:24:35", "text": "有"}, {"type": "subtitle", "time": 15877.55, "timestamp": "04:24:37", "text": "制成。哦，"}, {"type": "subtitle", "time": 15881.11, "timestamp": "04:24:41", "text": "很少。是的，同意。三级，同意。"}, {"type": "subtitle", "time": 15883.59, "timestamp": "04:24:43", "text": "我很少会进行事后猜测，因为"}, {"type": "subtitle", "time": 15887.309, "timestamp": "04:24:47", "text": "如果我做完了，那就做完了。我不在乎"}, {"type": "subtitle", "time": 15889.51, "timestamp": "04:24:49", "text": "不再是了。你的朋友会这样描述你"}, {"type": "subtitle", "time": 15893.75, "timestamp": "04:24:53", "text": "活泼外向。不。不。"}, {"type": "subtitle", "time": 15897.07, "timestamp": "04:24:57", "text": "不同意。三级。"}, {"type": "subtitle", "time": 15899.91, "timestamp": "04:24:59", "text": "不同意。我的朋友说了所有事"}]
[{"type": "subtitle", "time": 13500.99, "timestamp": "03:45:00", "text": "不。"}, {"type": "subtitle", "time": 13503.51, "timestamp": "03:45:03", "text": "不同意。我不喜欢和人说话"}, {"type": "subtitle", "time": 13505.83, "timestamp": "03:45:05", "text": "除非他们像"}, {"type": "subtitle", "time": 13509.189, "timestamp": "03:45:09", "text": "呃，它们跟我有点关系。"}, {"type": "subtitle", "time": 13512.63, "timestamp": "03:45:12", "text": "场地。比如我可以去看医生，"}, {"type": "subtitle", "time": 13514.389, "timestamp": "03:45:14", "text": "主动与人攀谈。但我不能"}, {"type": "subtitle", "time": 13517.03, "timestamp": "03:45:17", "text": "直接走过去跟陌生人搭讪。等等，等等，"}, {"type": "subtitle", "time": 13518.95, "timestamp": "03:45:18", "text": "稍等片刻。这就是问题所在吗？"}, {"type": "subtitle", "time": 13520.87, "timestamp": "03:45:20", "text": "你找到了吗？好的。好的。我没读过。"}, {"type": "subtitle", "time": 13522.95, "timestamp": "03:45:22", "text": "因为我是个笨蛋，所以才问这个问题。你发现"}, {"type": "subtitle", "time": 13524.15, "timestamp": "03:45:24", "text": "舒服的。你感觉舒服吗"}, {"type": "subtitle", "time": 13525.99, "timestamp": "03:45:25", "text": "只是走近一个你发现的人"}, {"type": "subtitle", "time": 13527.189, "timestamp": "03:45:27", "text": "有趣，并展开了一场对话"}, {"type": "subtitle", "time": 13534.469, "timestamp": "03:45:34", "text": "不，还是不行。仍然没有。呃，还是老样子。"}, {"type": "subtitle", "time": 13537.349, "timestamp": "03:45:37", "text": "除非有人主动和我搭讪，否则我不会喜欢你。"}, {"type": "subtitle", "time": 13539.11, "timestamp": "03:45:39", "text": "我不会主动搭讪。"}, {"type": "subtitle", "time": 13542.15, "timestamp": "03:45:42", "text": "就像话那么多人一样。除非像某人"}, {"type": "subtitle", "time": 13544.95, "timestamp": "03:45:44", "text": "他让我跟他们谈谈什么的。"}, {"type": "subtitle", "time": 13547.429, "timestamp": "03:45:47", "text": "除非我有任务需要和他们交谈。我"}, {"type": "subtitle", "time": 13549.99, "timestamp": "03:45:49", "text": "不会只是你知道一些"}, {"type": "subtitle", "time": 13551.99, "timestamp": "03:45:51", "text": "奇怪的"}, {"type": "subtitle", "time": 13555.229, "timestamp": "03:45:55", "text": "呃，奇怪的直觉，然后就去了"}, {"type": "subtitle", "time": 13557.91, "timestamp": "03:45:57", "text": "那些奇怪的、侵入性的想法，然后……"}, {"type": "subtitle", "time": 13559.51, "timestamp": "03:45:59", "text": "和他们说话，就好像我不会那样做一样。"}]
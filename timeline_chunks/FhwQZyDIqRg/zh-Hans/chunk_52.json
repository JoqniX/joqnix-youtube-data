[{"type": "subtitle", "time": 3121.589, "timestamp": "00:52:01", "text": "去！去！去。"}, {"type": "subtitle", "time": 3125.39, "timestamp": "00:52:05", "text": "好吧，我猜"}, {"type": "subtitle", "time": 3127.63, "timestamp": "00:52:07", "text": "所以。该死，"}, {"type": "subtitle", "time": 3131.589, "timestamp": "00:52:11", "text": "兄弟。如果我一个人玩的话，兄弟。我不"}, {"type": "subtitle", "time": 3133.75, "timestamp": "00:52:13", "text": "我知道我是否曾经……我的天哪。他简直就是"}, {"type": "subtitle", "time": 3136.87, "timestamp": "00:52:16", "text": "在你面前。你好，乔。哦，是的"}, {"type": "subtitle", "time": 3143.27, "timestamp": "00:52:23", "text": "我们需要径直向右走。是的，他"}, {"type": "subtitle", "time": 3145.03, "timestamp": "00:52:25", "text": "他当时和我在一起。就好像我们拥有了他"}, {"type": "subtitle", "time": 3146.75, "timestamp": "00:52:26", "text": "头部朝里"}, {"type": "subtitle", "time": 3149.589, "timestamp": "00:52:29", "text": "大车。我总是忘记我是怎么……"}, {"type": "subtitle", "time": 3150.95, "timestamp": "00:52:30", "text": "应该像，你知道的。好了，各位。"}, {"type": "subtitle", "time": 3153.75, "timestamp": "00:52:33", "text": "我找到了撤离点。在哪里？"}, {"type": "subtitle", "time": 3156.71, "timestamp": "00:52:36", "text": "它？你发现了什么？呃，等等。在哪里？"}, {"type": "subtitle", "time": 3158.47, "timestamp": "00:52:38", "text": "车在哪儿？这边。超过"}, {"type": "subtitle", "time": 3160.549, "timestamp": "00:52:40", "text": "这里。我来。车到了。在哪里？"}, {"type": "subtitle", "time": 3162.15, "timestamp": "00:52:42", "text": "你？"}, {"type": "subtitle", "time": 3164.71, "timestamp": "00:52:44", "text": "为什么会有这种奇怪诡异的气氛？"}, {"type": "subtitle", "time": 3168.79, "timestamp": "00:52:48", "text": "噪音？乔。是的。乔。等待。有一个"}, {"type": "subtitle", "time": 3175.109, "timestamp": "00:52:55", "text": "我的天啊。跑步。跑步。跑步。跑步。跑步。跑步。"}, {"type": "subtitle", "time": 3177.119, "timestamp": "00:52:57", "text": "跑步。跑步。跑步。 我的天哪，那里有一只诡异的眼睛。"}]
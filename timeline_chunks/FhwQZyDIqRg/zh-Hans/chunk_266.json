[{"type": "subtitle", "time": 15962.79, "timestamp": "04:26:02", "text": "事实胜于情感。所以我会去"}, {"type": "subtitle", "time": 15971.03, "timestamp": "04:26:11", "text": "同意，但不是那种硬同意或硬"}, {"type": "subtitle", "time": 15972.87, "timestamp": "04:26:12", "text": "不同意。我不会完全那样"}, {"type": "subtitle", "time": 15975.31, "timestamp": "04:26:15", "text": "感性的还是完全理性的。"}, {"type": "subtitle", "time": 15984.51, "timestamp": "04:26:24", "text": "我忘了他的名字。本·贝尼波。对不起。啊"}, {"type": "subtitle", "time": 15988.149, "timestamp": "04:26:28", "text": "我以前经常看本的节目。"}]
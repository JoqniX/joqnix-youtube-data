[{"type": "subtitle", "time": 15720.149, "timestamp": "04:22:00", "text": "谈谈觉醒和建模。哦，"}, {"type": "subtitle", "time": 15722.07, "timestamp": "04:22:02", "text": "你知道我的意思？哦，是的。是的。"}, {"type": "subtitle", "time": 15725.429, "timestamp": "04:22:05", "text": "是的，我很乐意和你聊聊。"}, {"type": "subtitle", "time": 15727.99, "timestamp": "04:22:07", "text": "就像那些超级VTuber一样"}, {"type": "subtitle", "time": 15730.07, "timestamp": "04:22:10", "text": "友善，超级好，但是喜欢"}, {"type": "subtitle", "time": 15731.91, "timestamp": "04:22:11", "text": "当你谈到索具和"}, {"type": "subtitle", "time": 15734.389, "timestamp": "04:22:14", "text": "精确定位和钻井平台点，我要走了"}, {"type": "subtitle", "time": 15736.389, "timestamp": "04:22:16", "text": "感到非常困惑和极其"}, {"type": "subtitle", "time": 15740.309, "timestamp": "04:22:20", "text": "丢失的。所以，严格来说，是的，我"}, {"type": "subtitle", "time": 15742.389, "timestamp": "04:22:22", "text": "我不会感到无聊，但是"}, {"type": "subtitle", "time": 15745.91, "timestamp": "04:22:25", "text": "我会感到迷失其中。我不会输"}, {"type": "subtitle", "time": 15748.55, "timestamp": "04:22:28", "text": "我当然对此感兴趣，但我会……"}, {"type": "subtitle", "time": 15751.71, "timestamp": "04:22:31", "text": "非常迷路了。我会非常困惑。它是"}, {"type": "subtitle", "time": 15754.71, "timestamp": "04:22:34", "text": "不是“丢失”这个词的意思，它不是"}, {"type": "subtitle", "time": 15756.95, "timestamp": "04:22:36", "text": "呃，我有个问题，我有一个"}, {"type": "subtitle", "time": 15759.189, "timestamp": "04:22:39", "text": "怀疑。你根本不知道该去哪里"}, {"type": "subtitle", "time": 15761.189, "timestamp": "04:22:41", "text": "问清楚疑问或从哪里开始。"}, {"type": "subtitle", "time": 15764.229, "timestamp": "04:22:44", "text": "怀疑。所以才叫迷路。"}, {"type": "subtitle", "time": 15767.429, "timestamp": "04:22:47", "text": "在对话中。是的。所以我会是"}, {"type": "subtitle", "time": 15769.75, "timestamp": "04:22:49", "text": "我沉浸在谈话中，但我没有"}, {"type": "subtitle", "time": 15772.469, "timestamp": "04:22:52", "text": "我觉得我会感到无聊或失去兴趣。"}, {"type": "subtitle", "time": 15774.63, "timestamp": "04:22:54", "text": "在这段对话中。"}, {"type": "subtitle", "time": 15776.11, "timestamp": "04:22:56", "text": "所以我会"}]
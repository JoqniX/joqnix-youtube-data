[{"type": "subtitle", "time": 13680.71, "timestamp": "03:48:00", "text": "你知道。是的。我想应该是你寄的。"}, {"type": "subtitle", "time": 13683.189, "timestamp": "03:48:03", "text": "我中了那个“兄弟”的毒，总是说“兄弟”"}, {"type": "subtitle", "time": 13689.83, "timestamp": "03:48:09", "text": "很多。是的。什么？我本来应该做这件事。"}, {"type": "subtitle", "time": 13692.87, "timestamp": "03:48:12", "text": "先生，您哥哥不如我哥哥。你的"}, {"type": "subtitle", "time": 13701.03, "timestamp": "03:48:21", "text": "兄弟。你们还记得神话级战锤40K吗？"}, {"type": "chat", "time": 13702.222, "timestamp": "03:48:22", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "LMAOOO"}, {"type": "subtitle", "time": 13703.03, "timestamp": "03:48:23", "text": "正确的？我真的叫她哥哥"}, {"type": "subtitle", "time": 13710.87, "timestamp": "03:48:30", "text": "兄弟，怎么了？这个鬼魂是"}, {"type": "subtitle", "time": 13718.269, "timestamp": "03:48:38", "text": "我，兄弟。兄弟，做点什么吧。我"}, {"type": "subtitle", "time": 13721.269, "timestamp": "03:48:41", "text": "我想我不知道为什么她是一个"}, {"type": "subtitle", "time": 13724.15, "timestamp": "03:48:44", "text": "她，但只是像这样称呼你的兄弟们"}, {"type": "subtitle", "time": 13725.79, "timestamp": "03:48:45", "text": "她爱她"}, {"type": "subtitle", "time": 13729.11, "timestamp": "03:48:49", "text": "它。我不知道。真奇怪。真搞笑"}, {"type": "subtitle", "time": 13732.63, "timestamp": "03:48:52", "text": "就像称呼所有人为兄弟一样"}, {"type": "subtitle", "time": 13735.07, "timestamp": "03:48:55", "text": "那种语气，"}, {"type": "subtitle", "time": 13739.59, "timestamp": "03:48:59", "text": "也。总之，请继续，杰克先生。"}]
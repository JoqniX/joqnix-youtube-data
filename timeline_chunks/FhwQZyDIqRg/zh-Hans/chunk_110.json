[{"type": "subtitle", "time": 6600.95, "timestamp": "01:50:00", "text": "一个不混合。不，"}, {"type": "subtitle", "time": 6603.109, "timestamp": "01:50:03", "text": "我们想念查克。"}, {"type": "subtitle", "time": 6605.189, "timestamp": "01:50:05", "text": "我们错过了。你只为自己而活"}, {"type": "subtitle", "time": 6607.75, "timestamp": "01:50:07", "text": "你选了Z，没选到Jock。乔克。"}, {"type": "subtitle", "time": 6609.99, "timestamp": "01:50:09", "text": "乔克去世了。是的，我死了。你没得到"}, {"type": "subtitle", "time": 6612.149, "timestamp": "01:50:12", "text": "是他，兄弟。什么？"}, {"type": "subtitle", "time": 6614.149, "timestamp": "01:50:14", "text": "他当时就在那里。他当时就在那里。真是太……"}, {"type": "subtitle", "time": 6616.31, "timestamp": "01:50:16", "text": "不公平。为什么这些鬼魂会出现在后面"}, {"type": "subtitle", "time": 6619.109, "timestamp": "01:50:19", "text": "我？兄弟，我没听懂。我在一个"}, {"type": "subtitle", "time": 6621.669, "timestamp": "01:50:21", "text": "加 XP。伟大的。没关系。你应该"}, {"type": "subtitle", "time": 6624.149, "timestamp": "01:50:24", "text": "它向我坠落时，我逃走了。我"}, {"type": "subtitle", "time": 6625.83, "timestamp": "01:50:25", "text": "我告诉你，我的XP刚刚"}, {"type": "subtitle", "time": 6627.189, "timestamp": "01:50:27", "text": "减少。所以，那些事情是"}, {"type": "subtitle", "time": 6629.51, "timestamp": "01:50:29", "text": "你运行的那个速度装置，它降低了"}, {"type": "subtitle", "time": 6631.83, "timestamp": "01:50:31", "text": "从440降到1，然后我不得不减速。"}, {"type": "subtitle", "time": 6633.35, "timestamp": "01:50:33", "text": "因为数量减少到只有一个而下降。我"}, {"type": "subtitle", "time": 6635.109, "timestamp": "01:50:35", "text": "无法运行。我跑不动了。是吗？"}, {"type": "subtitle", "time": 6638.31, "timestamp": "01:50:38", "text": "够你用了吗？我们来买她的体力吧。"}, {"type": "subtitle", "time": 6640.87, "timestamp": "01:50:40", "text": "好的。基本上，如果你看看"}, {"type": "subtitle", "time": 6643.109, "timestamp": "01:50:43", "text": "那个流氓怪物？哦，别买。"}, {"type": "subtitle", "time": 6644.87, "timestamp": "01:50:44", "text": "别买。别买。你可以呃"}, {"type": "subtitle", "time": 6647.43, "timestamp": "01:50:47", "text": "把它放进卡车里。"}, {"type": "subtitle", "time": 6650.149, "timestamp": "01:50:50", "text": "糟糕。不要买惠普的产品。我们有一个"}, {"type": "subtitle", "time": 6652.31, "timestamp": "01:50:52", "text": "利用漏洞使你的生命值恢复满值。就这么留着"}, {"type": "subtitle", "time": 6653.91, "timestamp": "01:50:53", "text": "把它放在卡车里。不要买惠普的产品。那是"}, {"type": "subtitle", "time": 6656.229, "timestamp": "01:50:56", "text": "它。在告诉她之前不要开始"}, {"type": "subtitle", "time": 6659.43, "timestamp": "01:50:59", "text": "不过，这算是个小故障。哦，我只有一丝耐力。"}]
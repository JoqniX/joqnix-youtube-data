[{"type": "subtitle", "time": 12243.19, "timestamp": "03:24:03", "text": "对这两个目标的爱如何？"}, {"type": "subtitle", "time": 12244.19, "timestamp": "03:24:04", "text": "为了"}, {"type": "subtitle", "time": 12248.51, "timestamp": "03:24:08", "text": "呃，是36。"}, {"type": "subtitle", "time": 12253.51, "timestamp": "03:24:13", "text": "是的。什么？ 36%。 36. 哦，等等。"}, {"type": "subtitle", "time": 12256.469, "timestamp": "03:24:16", "text": "等待。当时是10点。等等。好的。 10 至 36。"}, {"type": "subtitle", "time": 12259.269, "timestamp": "03:24:19", "text": "是的。是的。是的。是的。没关系。工作"}, {"type": "subtitle", "time": 12263.229, "timestamp": "03:24:23", "text": "人们。运动健将。人们会喜欢"}, {"type": "subtitle", "time": 12266.349, "timestamp": "03:24:26", "text": "讨厌"}, {"type": "subtitle", "time": 12269.429, "timestamp": "03:24:29", "text": "甜的。真好。"}, {"type": "subtitle", "time": 12274.309, "timestamp": "03:24:34", "text": "等等，工作能不能能不能工作人们不能"}, {"type": "subtitle", "time": 12281.95, "timestamp": "03:24:41", "text": "哦，是的。我想问我"}, {"type": "subtitle", "time": 12291.67, "timestamp": "03:24:51", "text": "嗯，我来这里是因为你没能听懂我的话。"}, {"type": "subtitle", "time": 12293.9, "timestamp": "03:24:53", "text": "溪流。等待，"}, {"type": "subtitle", "time": 12296.91, "timestamp": "03:24:56", "text": "[音乐]"}, {"type": "subtitle", "time": 12299.229, "timestamp": "03:24:59", "text": "什么？"}]
[{"type": "subtitle", "time": 5760.47, "timestamp": "01:36:00", "text": "好的。所以，我要去卡车里休息一下了。"}, {"type": "subtitle", "time": 5764.229, "timestamp": "01:36:04", "text": "你们可以来。好的。再见。"}, {"type": "subtitle", "time": 5766.39, "timestamp": "01:36:06", "text": "整洁的。再见。是的。我这就去"}, {"type": "subtitle", "time": 5768.709, "timestamp": "01:36:08", "text": "我可以坐这儿吗？等待。这是你选的吗？"}, {"type": "subtitle", "time": 5773.35, "timestamp": "01:36:13", "text": "哦。你好。失陪了。"}, {"type": "subtitle", "time": 5775.75, "timestamp": "01:36:15", "text": "在哪里？"}, {"type": "subtitle", "time": 5778.31, "timestamp": "01:36:18", "text": "它已经在这里了。你为什么会在那里？"}, {"type": "subtitle", "time": 5779.91, "timestamp": "01:36:19", "text": "各位，各位，各位。我打算选两个。"}, {"type": "subtitle", "time": 5782.149, "timestamp": "01:36:22", "text": "耐力板。你觉得这样可以吗？"}, {"type": "subtitle", "time": 5784.149, "timestamp": "01:36:24", "text": "这就是你试图对我做的事。哦，"}, {"type": "subtitle", "time": 5785.669, "timestamp": "01:36:25", "text": "你就是想那样对我。"}, {"type": "subtitle", "time": 5792.709, "timestamp": "01:36:32", "text": "该死的。该死，这游戏。我明白了。我"}, {"type": "subtitle", "time": 5796.149, "timestamp": "01:36:36", "text": "抓到你了。哦，我记得这些。"}, {"type": "subtitle", "time": 5797.59, "timestamp": "01:36:37", "text": "我小时候，我经常拥有这些"}, {"type": "subtitle", "time": 5801.99, "timestamp": "01:36:41", "text": "用于录像机。我的天啊。"}, {"type": "subtitle", "time": 5804.229, "timestamp": "01:36:44", "text": "我的天哪。发生了什么？杀"}, {"type": "subtitle", "time": 5806.189, "timestamp": "01:36:46", "text": "某人。能"}, {"type": "subtitle", "time": 5810.149, "timestamp": "01:36:50", "text": "如果有人欺负别人，那就是欺凌？"}, {"type": "subtitle", "time": 5812.39, "timestamp": "01:36:52", "text": "也许我是在欺凌别人。"}, {"type": "subtitle", "time": 5815.59, "timestamp": "01:36:55", "text": "哦，不。我勒个去？抓住他。抓住他！"}, {"type": "subtitle", "time": 5819.43, "timestamp": "01:36:59", "text": "男生。抓住他。干掉他，小子。我的天哪。"}]
[{"type": "subtitle", "time": 13080.59, "timestamp": "03:38:00", "text": "强迫症。我会保留"}, {"type": "subtitle", "time": 13090.95, "timestamp": "03:38:10", "text": "它最终会落在哪里？是否不同意"}, {"type": "subtitle", "time": 13092.469, "timestamp": "03:38:12", "text": "观点还是同意观点？我要给"}, {"type": "subtitle", "time": 13095.19, "timestamp": "03:38:15", "text": "可以同意。就像我一样，我显然会保留我的"}, {"type": "subtitle", "time": 13098.87, "timestamp": "03:38:18", "text": "爱干净但不强迫症。"}, {"type": "subtitle", "time": 13100.71, "timestamp": "03:38:20", "text": "H"}, {"type": "subtitle", "time": 13105.429, "timestamp": "03:38:25", "text": "杰克。是的。雅克。是的。"}, {"type": "subtitle", "time": 13107.19, "timestamp": "03:38:27", "text": "好的。"}, {"type": "subtitle", "time": 13109.19, "timestamp": "03:38:29", "text": "我以为你以为我以为迪斯科"}, {"type": "subtitle", "time": 13111.91, "timestamp": "03:38:31", "text": "又死了。它会切断你的声音"}, {"type": "subtitle", "time": 13114.15, "timestamp": "03:38:34", "text": "很多。"}, {"type": "subtitle", "time": 13117.11, "timestamp": "03:38:37", "text": "是啊，兄弟。对不起。我很抱歉"}, {"type": "subtitle", "time": 13119.87, "timestamp": "03:38:39", "text": "你。你通常会待"}, {"type": "subtitle", "time": 13122.03, "timestamp": "03:38:42", "text": "冷静的。"}, {"type": "subtitle", "time": 13126.349, "timestamp": "03:38:46", "text": "乐趣。我不知道。"}, {"type": "subtitle", "time": 13135.03, "timestamp": "03:38:55", "text": "摸索。我不是，我不喜欢完整。我"}]
[{"type": "subtitle", "time": 5102.31, "timestamp": "01:25:02", "text": "那家伙会杀了你。什么？是啊！"}, {"type": "subtitle", "time": 5106.55, "timestamp": "01:25:06", "text": "他在大喊大叫。她属于你。"}, {"type": "subtitle", "time": 5108.629, "timestamp": "01:25:08", "text": "你死定了。"}, {"type": "subtitle", "time": 5113.36, "timestamp": "01:25:13", "text": "太可惜了，他死了。"}, {"type": "subtitle", "time": 5114.55, "timestamp": "01:25:14", "text": "[音乐]"}, {"type": "subtitle", "time": 5116.79, "timestamp": "01:25:16", "text": "妈的。"}, {"type": "subtitle", "time": 5119.27, "timestamp": "01:25:19", "text": "他看到她看到了你的尸体。哦，不。我懂了"}, {"type": "subtitle", "time": 5127.149, "timestamp": "01:25:27", "text": "我的天哪。"}, {"type": "subtitle", "time": 5130.31, "timestamp": "01:25:30", "text": "好的，我来了。"}, {"type": "subtitle", "time": 5131.229, "timestamp": "01:25:31", "text": "全部"}, {"type": "subtitle", "time": 5135.03, "timestamp": "01:25:35", "text": "正确的。好的。把它捡起来。好的。是的，但是"}, {"type": "subtitle", "time": 5136.39, "timestamp": "01:25:36", "text": "你无法让我们复活。你没有"}, {"type": "subtitle", "time": 5138.31, "timestamp": "01:25:38", "text": "钱够了。"}, {"type": "subtitle", "time": 5143.03, "timestamp": "01:25:43", "text": "不，我相信，所以，好吧。"}, {"type": "subtitle", "time": 5145.43, "timestamp": "01:25:45", "text": "继续前进。继续前进。你"}, {"type": "subtitle", "time": 5154.79, "timestamp": "01:25:54", "text": "等待。没有价值。她可以去"}, {"type": "subtitle", "time": 5157.75, "timestamp": "01:25:57", "text": "入口就在那边后面"}]
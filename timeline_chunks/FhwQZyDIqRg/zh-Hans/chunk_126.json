[{"type": "subtitle", "time": 7561.43, "timestamp": "02:06:01", "text": "嘿，伙计们，听我说。我们去卡车那儿。"}, {"type": "subtitle", "time": 7563.75, "timestamp": "02:06:03", "text": "我们再去卡车那边看看。你没有"}, {"type": "subtitle", "time": 7567.35, "timestamp": "02:06:07", "text": "需要狂按W键或其他任何键。千万别这么做"}, {"type": "subtitle", "time": 7569.43, "timestamp": "02:06:09", "text": "垃圾邮件。这不是Twitch聊天室。如果你想"}, {"type": "subtitle", "time": 7571.99, "timestamp": "02:06:11", "text": "想刷屏的话，去Twitch或其他平台刷屏吧。"}, {"type": "subtitle", "time": 7574.55, "timestamp": "02:06:14", "text": "试试看。哦不，我没看到。什么？"}, {"type": "subtitle", "time": 7576.149, "timestamp": "02:06:16", "text": "这是地狱吗？好的，再说一遍，你只需要"}, {"type": "subtitle", "time": 7580.39, "timestamp": "02:06:20", "text": "写一两遍就行，不用写15遍和16遍。"}, {"type": "subtitle", "time": 7585.99, "timestamp": "02:06:25", "text": "次数。我动不了。我动不了。"}, {"type": "subtitle", "time": 7588.41, "timestamp": "02:06:28", "text": "不，我回来了。"}, {"type": "subtitle", "time": 7591.91, "timestamp": "02:06:31", "text": "[音乐]"}, {"type": "subtitle", "time": 7595.709, "timestamp": "02:06:35", "text": "哦，该死。嗨，约翰。"}, {"type": "subtitle", "time": 7597.27, "timestamp": "02:06:37", "text": "你好。"}, {"type": "subtitle", "time": 7599.35, "timestamp": "02:06:39", "text": "看来我上当了。那是"}, {"type": "subtitle", "time": 7602.79, "timestamp": "02:06:42", "text": "疯狂的。呃，我想我听到了"}, {"type": "subtitle", "time": 7604.95, "timestamp": "02:06:44", "text": "我当时在想"}, {"type": "subtitle", "time": 7606.79, "timestamp": "02:06:46", "text": "我不知道为什么。我不知道。呃，我"}, {"type": "subtitle", "time": 7608.79, "timestamp": "02:06:48", "text": "好像被突袭了之类的。有"}, {"type": "subtitle", "time": 7612.91, "timestamp": "02:06:52", "text": "就像人们说W代表pack一样"}, {"type": "subtitle", "time": 7614.95, "timestamp": "02:06:54", "text": "凯撒。我不知道发生了什么事。"}, {"type": "subtitle", "time": 7618.79, "timestamp": "02:06:58", "text": "太诡异了，兄弟。我不明白，我不明白"}]
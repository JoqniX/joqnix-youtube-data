[{"type": "subtitle", "time": 1382.149, "timestamp": "00:23:02", "text": "那天发给我的信息是这样的"}, {"type": "subtitle", "time": 1385.19, "timestamp": "00:23:05", "text": "她自己，或者第二天她发了。"}, {"type": "subtitle", "time": 1398.43, "timestamp": "00:23:18", "text": "我的她，她，她真的她"}, {"type": "subtitle", "time": 1399.95, "timestamp": "00:23:19", "text": "实际上"}, {"type": "subtitle", "time": 1403.029, "timestamp": "00:23:23", "text": "比如，这个怎么说？呃……"}, {"type": "subtitle", "time": 1405.75, "timestamp": "00:23:25", "text": "适当地？我遇到了点麻烦。"}, {"type": "subtitle", "time": 1407.35, "timestamp": "00:23:27", "text": "找到合适的词语来使用它"}, {"type": "subtitle", "time": 1410.59, "timestamp": "00:23:30", "text": "我当时简直震惊了。"}, {"type": "subtitle", "time": 1418.19, "timestamp": "00:23:38", "text": "哇"}, {"type": "subtitle", "time": 1421.63, "timestamp": "00:23:41", "text": "嗨，真是太棒了"}, {"type": "subtitle", "time": 1423.909, "timestamp": "00:23:43", "text": "太震撼了，真是太震撼了"}, {"type": "subtitle", "time": 1438.029, "timestamp": "00:23:58", "text": "呃，关于拘留更多信息"}]
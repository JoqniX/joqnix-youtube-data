[{"type": "subtitle", "time": 6723.589, "timestamp": "01:52:03", "text": "哦好的。所以，就让她用吧。我们有"}, {"type": "subtitle", "time": 6724.95, "timestamp": "01:52:04", "text": "钱够了。我们想要得到一些东西"}, {"type": "subtitle", "time": 6726.79, "timestamp": "01:52:06", "text": "别的。我不知道哪个是……"}, {"type": "subtitle", "time": 6730.39, "timestamp": "01:52:10", "text": "阁楼。它在哪里？这太难了"}, {"type": "subtitle", "time": 6732.709, "timestamp": "01:52:12", "text": "区分。"}, {"type": "subtitle", "time": 6734.95, "timestamp": "01:52:14", "text": "我不知道。这是我第三次玩了。"}, {"type": "subtitle", "time": 6736.67, "timestamp": "01:52:16", "text": "实际上。"}, {"type": "subtitle", "time": 6739.669, "timestamp": "01:52:19", "text": "[音乐]"}, {"type": "subtitle", "time": 6741.39, "timestamp": "01:52:21", "text": "第三或第四"}, {"type": "subtitle", "time": 6750.74, "timestamp": "01:52:30", "text": "主意。啊，我明白了。"}, {"type": "subtitle", "time": 6753.629, "timestamp": "01:52:33", "text": "[音乐]"}, {"type": "subtitle", "time": 6756.79, "timestamp": "01:52:36", "text": "耶。你想……你想上去吗？"}, {"type": "subtitle", "time": 6765.51, "timestamp": "01:52:45", "text": "哦，你可能想跳进那个坑里。"}, {"type": "subtitle", "time": 6770.07, "timestamp": "01:52:50", "text": "是的，我明白了。我们走吧。妈的。"}, {"type": "subtitle", "time": 6772.39, "timestamp": "01:52:52", "text": "好的。我该偷什么？我能得到什么？"}]
[{"type": "subtitle", "time": 14821.67, "timestamp": "04:07:01", "text": "关键是你要证明你的"}, {"type": "subtitle", "time": 14824.51, "timestamp": "04:07:04", "text": "重点不伤害"}, {"type": "subtitle", "time": 14827.91, "timestamp": "04:07:07", "text": "情怀。有一种方法可以做到这一点，"}, {"type": "subtitle", "time": 14830.469, "timestamp": "04:07:10", "text": "就是那个对的人之类的，对吧？但是也"}, {"type": "subtitle", "time": 14833.51, "timestamp": "04:07:13", "text": "例如逻辑和事实。是的。那个东西"}, {"type": "subtitle", "time": 14835.59, "timestamp": "04:07:15", "text": "问题是它不应该像冷一样。"}, {"type": "subtitle", "time": 14838.79, "timestamp": "04:07:18", "text": "逻辑。不应该像这样，哦，你很久了"}, {"type": "subtitle", "time": 14841.99, "timestamp": "04:07:21", "text": "因为这个这个这个它不会"}, {"type": "subtitle", "time": 14843.349, "timestamp": "04:07:23", "text": "努力去做，他们就不会……"}, {"type": "subtitle", "time": 14846.79, "timestamp": "04:07:26", "text": "明白了。如果他们是，他们就是"}, {"type": "subtitle", "time": 14849.07, "timestamp": "04:07:29", "text": "某些类型的人永远不会"}, {"type": "subtitle", "time": 14851.349, "timestamp": "04:07:31", "text": "你要明白你必须照顾好自己。"}, {"type": "subtitle", "time": 14853.349, "timestamp": "04:07:33", "text": "某个部门。但如果你是"}, {"type": "subtitle", "time": 14855.03, "timestamp": "04:07:35", "text": "就像在谈论某个私人人物一样，"}, {"type": "subtitle", "time": 14858.309, "timestamp": "04:07:38", "text": "想象一下你我正在通电话，然后……"}, {"type": "subtitle", "time": 14861.67, "timestamp": "04:07:41", "text": "你误解了我的意思。"}, {"type": "subtitle", "time": 14865.07, "timestamp": "04:07:45", "text": "呃，我不知怎么地听懂了你的意思。"}, {"type": "subtitle", "time": 14867.51, "timestamp": "04:07:47", "text": "被误解了，你知道我是做什么的吗？"}, {"type": "subtitle", "time": 14869.59, "timestamp": "04:07:49", "text": "我不会说：“杰克，你错了。”"}, {"type": "subtitle", "time": 14872.309, "timestamp": "04:07:52", "text": "你没做到。你完全错了。"}, {"type": "subtitle", "time": 14875.51, "timestamp": "04:07:55", "text": "不，绝对不行。不。呃，我大概会是"}, {"type": "subtitle", "time": 14879.11, "timestamp": "04:07:59", "text": "比如，“杰克，别惊讶，冷静点。我不是……”"}]
[{"type": "subtitle", "time": 8702.63, "timestamp": "02:25:02", "text": "当时有一个人在那里。是的。成年后的艾琳"}, {"type": "subtitle", "time": 8704.71, "timestamp": "02:25:04", "text": "仪式期间实际站立"}, {"type": "subtitle", "time": 8707.51, "timestamp": "02:25:07", "text": "就像十几岁的艾琳一样"}, {"type": "subtitle", "time": 8709.91, "timestamp": "02:25:09", "text": "他就像在人群中一样，"}, {"type": "subtitle", "time": 8711.19, "timestamp": "02:25:11", "text": "当时他在人群中，他们都是"}, {"type": "subtitle", "time": 8712.71, "timestamp": "02:25:12", "text": "他们都坐在前面。"}, {"type": "subtitle", "time": 8714.63, "timestamp": "02:25:14", "text": "三。我们在聊天，然后就像"}, {"type": "subtitle", "time": 8717.11, "timestamp": "02:25:17", "text": "就在场景的最后面。那是"}, {"type": "subtitle", "time": 8720.55, "timestamp": "02:25:20", "text": "疯狂的。太疯狂了。疯狂的。进而"}, {"type": "subtitle", "time": 8722.63, "timestamp": "02:25:22", "text": "有一部分，所以他们展示了"}, {"type": "subtitle", "time": 8725.11, "timestamp": "02:25:25", "text": "像玩具一样，它们表现得像猴子"}, {"type": "subtitle", "time": 8727.59, "timestamp": "02:25:27", "text": "当然，这种情况恰好就发生了。"}, {"type": "subtitle", "time": 8729.99, "timestamp": "02:25:29", "text": "然后他们展示了所有士兵。"}, {"type": "subtitle", "time": 8731.83, "timestamp": "02:25:31", "text": "你知道，那只猴子就像……"}, {"type": "subtitle", "time": 8733.83, "timestamp": "02:25:33", "text": "就像你知道的，就在旁边等等"}, {"type": "subtitle", "time": 8735.429, "timestamp": "02:25:35", "text": "士兵们都倒下了"}, {"type": "subtitle", "time": 8737.67, "timestamp": "02:25:37", "text": "马匹和所有"}, {"type": "subtitle", "time": 8740.71, "timestamp": "02:25:40", "text": "这栋楼太大了。对，没错。"}, {"type": "subtitle", "time": 8744.79, "timestamp": "02:25:44", "text": "我觉得我应该是看着它长大的。哇。"}, {"type": "subtitle", "time": 8746.63, "timestamp": "02:25:46", "text": "我的意思是，很多人都在抱怨"}, {"type": "subtitle", "time": 8747.59, "timestamp": "02:25:47", "text": "关于结局。我心想，你知道的"}, {"type": "subtitle", "time": 8749.349, "timestamp": "02:25:49", "text": "什么？如果是作者本人所为，那就……"}, {"type": "subtitle", "time": 8752.95, "timestamp": "02:25:52", "text": "接受现实吧。嗯，我真的很喜欢"}, {"type": "subtitle", "time": 8754.71, "timestamp": "02:25:54", "text": "结束。就像艾琳终于得到了"}, {"type": "subtitle", "time": 8756.15, "timestamp": "02:25:56", "text": "他一直渴望的自由。你"}, {"type": "subtitle", "time": 8757.59, "timestamp": "02:25:57", "text": "记住，首先这里有这个"}, {"type": "subtitle", "time": 8759.51, "timestamp": "02:25:59", "text": "场景中，Masa正在看着"}]
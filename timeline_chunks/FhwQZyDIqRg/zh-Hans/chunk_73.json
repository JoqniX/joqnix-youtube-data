[{"type": "subtitle", "time": 4381.35, "timestamp": "01:13:01", "text": "事物？禅意何在？啊，明白了。"}, {"type": "subtitle", "time": 4383.27, "timestamp": "01:13:03", "text": "过来。在哪里？"}, {"type": "subtitle", "time": 4386.39, "timestamp": "01:13:06", "text": "就在这里。哦，这边走。打开它"}, {"type": "subtitle", "time": 4389.59, "timestamp": "01:13:09", "text": "像这样。就像，打开它"}, {"type": "subtitle", "time": 4391.27, "timestamp": "01:13:11", "text": "哦，它通往楼上。不，不，不，不。"}, {"type": "subtitle", "time": 4393.83, "timestamp": "01:13:13", "text": "等待。过来做。是的。全部"}, {"type": "subtitle", "time": 4397.63, "timestamp": "01:13:17", "text": "正确的。好的。好的。好的。做到了。是的。"}, {"type": "subtitle", "time": 4400.229, "timestamp": "01:13:20", "text": "有人在找我。"}, {"type": "subtitle", "time": 4402.95, "timestamp": "01:13:22", "text": "好的。我来接你吧。 A. 你"}, {"type": "subtitle", "time": 4405.91, "timestamp": "01:13:25", "text": "看起来好可爱。我被困住了。我被困住了。我是"}, {"type": "subtitle", "time": 4407.91, "timestamp": "01:13:27", "text": "不让你去那儿，宝贝女儿。"}, {"type": "subtitle", "time": 4409.99, "timestamp": "01:13:29", "text": "我不会让你去那里的。不是"}, {"type": "subtitle", "time": 4413.189, "timestamp": "01:13:33", "text": "放你走。嘿，快点。停止"}, {"type": "subtitle", "time": 4418.95, "timestamp": "01:13:38", "text": "请别打扰我。嘿，别拿。来"}, {"type": "subtitle", "time": 4420.229, "timestamp": "01:13:40", "text": "这里。来。我要快速地做"}, {"type": "subtitle", "time": 4421.51, "timestamp": "01:13:41", "text": "那。是的。是的。是的。是的。好的。全部"}, {"type": "subtitle", "time": 4423.27, "timestamp": "01:13:43", "text": "正确的。我在这里。我们走吧。不要挑选"}, {"type": "subtitle", "time": 4425.229, "timestamp": "01:13:45", "text": "把他扶起来。我发誓"}, {"type": "subtitle", "time": 4430.42, "timestamp": "01:13:50", "text": "上帝。别那样做。好的。我们只是"}, {"type": "subtitle", "time": 4433.99, "timestamp": "01:13:53", "text": "[笑声]"}, {"type": "subtitle", "time": 4436.31, "timestamp": "01:13:56", "text": "我打算这么做。我打算继续推进这件事。"}, {"type": "subtitle", "time": 4438.51, "timestamp": "01:13:58", "text": "在厕所里。"}]
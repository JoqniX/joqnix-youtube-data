[{"type": "subtitle", "time": 10800.55, "timestamp": "03:00:00", "text": "好的。看得出来他在看着。哦，"}, {"type": "subtitle", "time": 10802.63, "timestamp": "03:00:02", "text": "还有Twitch，因为他通常都在"}, {"type": "subtitle", "time": 10806.79, "timestamp": "03:00:06", "text": "聊天。对，对。我懂了。兄弟，他们"}, {"type": "subtitle", "time": 10810.309, "timestamp": "03:00:10", "text": "即使你正在从那些地方登录"}, {"type": "subtitle", "time": 10812.79, "timestamp": "03:00:12", "text": "鱼，你得到了你的。好吧，谢谢。"}, {"type": "subtitle", "time": 10815.19, "timestamp": "03:00:15", "text": "非常感谢你，Warfish，你真是个好人。"}, {"type": "subtitle", "time": 10817.11, "timestamp": "03:00:17", "text": "真是个了不起的人，给我们带来了这么棒的东西。"}, {"type": "subtitle", "time": 10827.03, "timestamp": "03:00:27", "text": "不过，真的非常感谢你，Sarfish。"}, {"type": "subtitle", "time": 10829.67, "timestamp": "03:00:29", "text": "你好。"}, {"type": "subtitle", "time": 10832.55, "timestamp": "03:00:32", "text": "是的，你就是。你们需要战斗，"}, {"type": "subtitle", "time": 10834.389, "timestamp": "03:00:34", "text": "你知道，你需要一对一地进行比赛。"}, {"type": "subtitle", "time": 10843.99, "timestamp": "03:00:43", "text": "是的。"}, {"type": "subtitle", "time": 10847.83, "timestamp": "03:00:47", "text": "各位再见。再见。是的。再见。"}, {"type": "subtitle", "time": 10849.67, "timestamp": "03:00:49", "text": "我们肯定会这么做。"}, {"type": "subtitle", "time": 10852.15, "timestamp": "03:00:52", "text": "再次。再见。"}]
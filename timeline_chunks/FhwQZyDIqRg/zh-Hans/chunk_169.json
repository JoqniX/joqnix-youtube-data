[{"type": "subtitle", "time": 10148.71, "timestamp": "02:49:08", "text": "这不是恐同症，老兄。你知道，"}, {"type": "subtitle", "time": 10149.99, "timestamp": "02:49:09", "text": "玩的时候就觉得没意思。"}, {"type": "subtitle", "time": 10151.11, "timestamp": "02:49:11", "text": "一款恐怖游戏，你看不到……"}, {"type": "subtitle", "time": 10155.269, "timestamp": "02:49:15", "text": "恶魔。很公平。"}, {"type": "subtitle", "time": 10157.67, "timestamp": "02:49:17", "text": "现在你看到恶魔了。不，我非常乐意"}, {"type": "subtitle", "time": 10160.07, "timestamp": "02:49:20", "text": "听到你这么说，我感到很欣慰。悄悄地，就是这样。"}, {"type": "subtitle", "time": 10163.51, "timestamp": "02:49:23", "text": "它在哪里？不，远离它。它是"}, {"type": "subtitle", "time": 10166.389, "timestamp": "02:49:26", "text": "那里。我的天啊。我该去哪里？呃，"}, {"type": "subtitle", "time": 10168.87, "timestamp": "02:49:28", "text": "其实，就等着它过去吧。"}, {"type": "subtitle", "time": 10170.71, "timestamp": "02:49:30", "text": "我们只需等待它过去，然后我们"}, {"type": "subtitle", "time": 10173.03, "timestamp": "02:49:33", "text": "回去吧。它不会转身杀人"}, {"type": "subtitle", "time": 10176.23, "timestamp": "02:49:36", "text": "你。我们可以直接从门边走过吗？"}, {"type": "subtitle", "time": 10179.269, "timestamp": "02:49:39", "text": "但愿如此。哦，不。我希望它能过去。哦"}, {"type": "subtitle", "time": 10181.19, "timestamp": "02:49:41", "text": "我的天哪，它要给你了。可怜的家伙。我"}, {"type": "subtitle", "time": 10184.79, "timestamp": "02:49:44", "text": "我不喜欢这个人。跑步。跑步。来。哦，"}, {"type": "subtitle", "time": 10188.389, "timestamp": "02:49:48", "text": "不。不。去。跑步。跑步。跑步。我是瑞恩"}, {"type": "subtitle", "time": 10189.91, "timestamp": "02:49:49", "text": "你身后。跑步。跑步。跑步。跑步。我们开始吧"}, {"type": "subtitle", "time": 10192.63, "timestamp": "02:49:52", "text": "去。我们走吧。我们走吧。每个人"}, {"type": "subtitle", "time": 10197.269, "timestamp": "02:49:57", "text": "进去。我正在关门。我还活着。"}]
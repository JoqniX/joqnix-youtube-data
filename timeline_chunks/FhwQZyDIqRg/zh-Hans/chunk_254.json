[{"type": "subtitle", "time": 15241.149, "timestamp": "04:14:01", "text": "通过情绪化的论证。这是什么意思？"}, {"type": "subtitle", "time": 15243.87, "timestamp": "04:14:03", "text": "情绪"}, {"type": "subtitle", "time": 15248.79, "timestamp": "04:14:08", "text": "方法？哦，如果就像……如果……如果"}, {"type": "subtitle", "time": 15250.63, "timestamp": "04:14:10", "text": "就像另一个人一样"}, {"type": "subtitle", "time": 15253.59, "timestamp": "04:14:13", "text": "情绪激动，他们对着你大喊大叫。"}, {"type": "subtitle", "time": 15255.59, "timestamp": "04:14:15", "text": "或者说，你必须这样做才能……"}, {"type": "subtitle", "time": 15257.11, "timestamp": "04:14:17", "text": "人们，"}, {"type": "subtitle", "time": 15259.349, "timestamp": "04:14:19", "text": "我不会轻易动摇。就像是"}, {"type": "subtitle", "time": 15262.07, "timestamp": "04:14:22", "text": "就这些吗？"}, {"type": "subtitle", "time": 15264.469, "timestamp": "04:14:24", "text": "你缺乏情感。我"}, {"type": "subtitle", "time": 15267.91, "timestamp": "04:14:27", "text": "应该同意。我不是个情绪化的人。"}, {"type": "subtitle", "time": 15270.55, "timestamp": "04:14:30", "text": "男。我如果他们如果那个人是"}, {"type": "subtitle", "time": 15273.349, "timestamp": "04:14:33", "text": "跟我争论是情绪化的，我会让你这么做。"}, {"type": "subtitle", "time": 15276.63, "timestamp": "04:14:36", "text": "他们想争论就争论吧，我会等着。"}, {"type": "subtitle", "time": 15278.309, "timestamp": "04:14:38", "text": "让他们冷静下来，因为他们"}, {"type": "subtitle", "time": 15280.79, "timestamp": "04:14:40", "text": "位置不太适合做柜台之类的东西。"}, {"type": "subtitle", "time": 15283.349, "timestamp": "04:14:43", "text": "论点或建议。所以很明显我是"}, {"type": "subtitle", "time": 15286.309, "timestamp": "04:14:46", "text": "先让他们自生自灭，然后我就会……"}, {"type": "subtitle", "time": 15288.269, "timestamp": "04:14:48", "text": "就像我会"}, {"type": "subtitle", "time": 15291.59, "timestamp": "04:14:51", "text": "我会让他们一直这样下去，直到很久以后。"}, {"type": "subtitle", "time": 15294.429, "timestamp": "04:14:54", "text": "时间。"}, {"type": "subtitle", "time": 15299.269, "timestamp": "04:14:59", "text": "哦，我也是这么想的。哇。"}]
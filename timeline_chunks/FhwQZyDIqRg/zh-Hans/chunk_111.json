[{"type": "subtitle", "time": 6662.87, "timestamp": "01:51:02", "text": "为自己。起来狂按E键，对吧？"}, {"type": "subtitle", "time": 6665.99, "timestamp": "01:51:05", "text": "是的。是的，很快就好。我们一离开。"}, {"type": "subtitle", "time": 6667.669, "timestamp": "01:51:07", "text": "我们刚放下信息……"}, {"type": "subtitle", "time": 6669.75, "timestamp": "01:51:09", "text": "东西。"}, {"type": "subtitle", "time": 6671.91, "timestamp": "01:51:11", "text": "丢失的。我要抢占先机。比如当"}, {"type": "subtitle", "time": 6674.47, "timestamp": "01:51:14", "text": "我们要离开这里了，你别再刷屏了。"}, {"type": "subtitle", "time": 6679.189, "timestamp": "01:51:19", "text": "直到你到达那里。嗯。没关系。"}, {"type": "subtitle", "time": 6682.31, "timestamp": "01:51:22", "text": "我们应该买一些吗？不过没关系。我们"}, {"type": "subtitle", "time": 6684.709, "timestamp": "01:51:24", "text": "有四个。"}, {"type": "subtitle", "time": 6686.39, "timestamp": "01:51:26", "text": "不过别买28号。我认为是它的"}, {"type": "subtitle", "time": 6689.51, "timestamp": "01:51:29", "text": "真的没用。是的。上次"}, {"type": "subtitle", "time": 6691.35, "timestamp": "01:51:31", "text": "它并没有真的要了他的命，所以这算是仁慈吧。"}, {"type": "subtitle", "time": 6694.79, "timestamp": "01:51:34", "text": "毫无意义的。我的意思是，上次我们只是"}, {"type": "subtitle", "time": 6697.669, "timestamp": "01:51:37", "text": "我跑过去的时候，那部分真的很"}, {"type": "subtitle", "time": 6700.149, "timestamp": "01:51:40", "text": "速度慢，所以基本没用。好的，给我"}, {"type": "subtitle", "time": 6701.91, "timestamp": "01:51:41", "text": "稍等一下，各位。我需要给我的"}, {"type": "subtitle", "time": 6704.629, "timestamp": "01:51:44", "text": "电话。"}, {"type": "subtitle", "time": 6708.79, "timestamp": "01:51:48", "text": "放弃吧。电话。让它死去吧。"}, {"type": "subtitle", "time": 6710.27, "timestamp": "01:51:50", "text": "哦，应该有"}, {"type": "subtitle", "time": 6719.43, "timestamp": "01:51:59", "text": "各位，顺便说一下，我买了个体力包。"}]
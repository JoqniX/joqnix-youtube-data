[{"type": "subtitle", "time": 3303.15, "timestamp": "00:55:03", "text": "这也太快了吧！"}, {"type": "subtitle", "time": 3307.19, "timestamp": "00:55:07", "text": "是的，他会跑步。"}, {"type": "subtitle", "time": 3308.27, "timestamp": "00:55:08", "text": "出色地，"}, {"type": "subtitle", "time": 3313.03, "timestamp": "00:55:13", "text": "你好。你好吗？游戏结束。这是"}, {"type": "subtitle", "time": 3314.79, "timestamp": "00:55:14", "text": "竞技场。"}, {"type": "subtitle", "time": 3318.309, "timestamp": "00:55:18", "text": "Xan很难过。血液在嘲笑我们。哦，"}, {"type": "subtitle", "time": 3320.79, "timestamp": "00:55:20", "text": "这个。哦，是这个。我讨厌这个。"}, {"type": "subtitle", "time": 3322.63, "timestamp": "00:55:22", "text": "这是什么？这是什么？所以，你是"}, {"type": "subtitle", "time": 3324.47, "timestamp": "00:55:24", "text": "你应该像拿起一个"}, {"type": "subtitle", "time": 3327.589, "timestamp": "00:55:27", "text": "物体和战斗，就像开始一样。我不"}, {"type": "subtitle", "time": 3329.99, "timestamp": "00:55:29", "text": "我知道该怎么做，真的很抱歉。对不起"}, {"type": "subtitle", "time": 3332.23, "timestamp": "00:55:32", "text": "如果"}, {"type": "subtitle", "time": 3334.549, "timestamp": "00:55:34", "text": "我喜欢这一刻。"}, {"type": "subtitle", "time": 3337.829, "timestamp": "00:55:37", "text": "妈的。"}, {"type": "subtitle", "time": 3340.87, "timestamp": "00:55:40", "text": "去死吧。当然。你在哪里？"}, {"type": "subtitle", "time": 3344.47, "timestamp": "00:55:44", "text": "去看史莱克。去看史莱克。去看史莱克。你做"}, {"type": "subtitle", "time": 3356.95, "timestamp": "00:55:56", "text": "[音乐]"}, {"type": "subtitle", "time": 3357.71, "timestamp": "00:55:57", "text": "看"}]
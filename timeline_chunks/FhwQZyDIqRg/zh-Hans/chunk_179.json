[{"type": "subtitle", "time": 10744.469, "timestamp": "02:59:04", "text": "我想就是这样了。我想这就是全部内容了。"}, {"type": "subtitle", "time": 10747.349, "timestamp": "02:59:07", "text": "今天。哇，真是太精彩了。那就像"}, {"type": "subtitle", "time": 10751.429, "timestamp": "02:59:11", "text": "太棒了。我知道。我，嗯，如何"}, {"type": "subtitle", "time": 10753.67, "timestamp": "02:59:13", "text": "我们聊完之后玩得最开心吗？"}, {"type": "subtitle", "time": 10755.11, "timestamp": "02:59:15", "text": "关于动漫？我们应该真正地花掉"}, {"type": "subtitle", "time": 10756.71, "timestamp": "02:59:16", "text": "比如花一个小时聊动漫"}, {"type": "subtitle", "time": 10758.87, "timestamp": "02:59:18", "text": "那就去玩游戏吧，因为我知道你"}, {"type": "subtitle", "time": 10761.03, "timestamp": "02:59:21", "text": "体验某事。你得到了"}, {"type": "subtitle", "time": 10762.63, "timestamp": "02:59:22", "text": "机架和泰坦的力量"}, {"type": "subtitle", "time": 10764.71, "timestamp": "02:59:24", "text": "某物。我们获得了力量"}, {"type": "subtitle", "time": 10766.429, "timestamp": "02:59:26", "text": "友谊。"}, {"type": "subtitle", "time": 10768.79, "timestamp": "02:59:28", "text": "绝对地。绝对地。哇，那真是太"}, {"type": "subtitle", "time": 10771.59, "timestamp": "02:59:31", "text": "太棒了，伙计。我们必须计划这件事"}, {"type": "subtitle", "time": 10773.67, "timestamp": "02:59:33", "text": "再次。我们必须……嗯，我打算……"}, {"type": "subtitle", "time": 10775.67, "timestamp": "02:59:35", "text": "在那里活跃并给你提供"}, {"type": "subtitle", "time": 10776.95, "timestamp": "02:59:36", "text": "对小组的建议。我要"}, {"type": "subtitle", "time": 10780.19, "timestamp": "02:59:40", "text": "待在那儿。我会把我的给你。是的。"}, {"type": "subtitle", "time": 10783.59, "timestamp": "02:59:43", "text": "是的。是的。太酷了。那真是太……"}, {"type": "subtitle", "time": 10786.63, "timestamp": "02:59:46", "text": "太棒了。我玩得太开心了。所以，它"}, {"type": "subtitle", "time": 10789.469, "timestamp": "02:59:49", "text": "很有趣。耶。我想，我想感谢"}, {"type": "subtitle", "time": 10792.309, "timestamp": "02:59:52", "text": "如果他还在关注谁的话，那就是剑鱼。"}, {"type": "subtitle", "time": 10793.99, "timestamp": "02:59:53", "text": "谢谢。让我看看他是不是"}, {"type": "subtitle", "time": 10796.309, "timestamp": "02:59:56", "text": "正在观看。我看看他是不是……"}, {"type": "subtitle", "time": 10798.55, "timestamp": "02:59:58", "text": "正在观看。"}]
[{"type": "subtitle", "time": 10383.19, "timestamp": "02:53:03", "text": "妈的。我的错。哦，瞧。一个大"}, {"type": "subtitle", "time": 10386.469, "timestamp": "02:53:06", "text": "快递箱。伙计们，快来帮忙。"}, {"type": "subtitle", "time": 10388.63, "timestamp": "02:53:08", "text": "是的。"}, {"type": "subtitle", "time": 10392.23, "timestamp": "02:53:12", "text": "我们走吧。好的，把它捡起来。慢慢地。"}, {"type": "subtitle", "time": 10394.79, "timestamp": "02:53:14", "text": "我们走吧。慢慢地。让我，我希望我们能"}, {"type": "subtitle", "time": 10397.03, "timestamp": "02:53:17", "text": "结束。我希望我们能这样结束。"}, {"type": "subtitle", "time": 10400.79, "timestamp": "02:53:20", "text": "第一个。我们快完成了。"}, {"type": "subtitle", "time": 10403.63, "timestamp": "02:53:23", "text": "救命啊，各位。准备下锅了"}, {"type": "subtitle", "time": 10408.71, "timestamp": "02:53:28", "text": "不。哦，糟糕。好的。回去。后退。"}, {"type": "subtitle", "time": 10410.389, "timestamp": "02:53:30", "text": "我要回去。不，不，不，等等。等待。"}, {"type": "subtitle", "time": 10413.99, "timestamp": "02:53:33", "text": "等待。等待。来。是的。是的。是的。离开。"}, {"type": "subtitle", "time": 10417.03, "timestamp": "02:53:37", "text": "我该离开吗？好的。你说得对。哦，"}, {"type": "subtitle", "time": 10418.95, "timestamp": "02:53:38", "text": "主。放手吧，放下它。不，不，不。"}, {"type": "subtitle", "time": 10422.07, "timestamp": "02:53:42", "text": "不，不要。芝诺。禅。算了。离开"}, {"type": "subtitle", "time": 10423.83, "timestamp": "02:53:43", "text": "它。算了。芝诺。算了。我把它留下了。"}, {"type": "subtitle", "time": 10428.95, "timestamp": "02:53:48", "text": "我把它留下了。哦，我说了两遍了，兄弟。"}, {"type": "subtitle", "time": 10432.389, "timestamp": "02:53:52", "text": "不，去你的。耶。我们完成了吗？"}, {"type": "subtitle", "time": 10434.23, "timestamp": "02:53:54", "text": "首次提取？哦，我要去哪里？"}, {"type": "subtitle", "time": 10436.309, "timestamp": "02:53:56", "text": "不，不，先完成了。不，没关系。它是"}, {"type": "subtitle", "time": 10439.429, "timestamp": "02:53:59", "text": "美好的。没关系。没关系。是的。但"}]
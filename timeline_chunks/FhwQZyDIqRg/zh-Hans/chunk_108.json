[{"type": "subtitle", "time": 6482.39, "timestamp": "01:48:02", "text": "哦，你好。所有人都死了吗？不，不，不。"}, {"type": "subtitle", "time": 6485.27, "timestamp": "01:48:05", "text": "他们正在里面跑。"}, {"type": "subtitle", "time": 6487.43, "timestamp": "01:48:07", "text": "哟，它跟着我呢。顺便说一句，我"}, {"type": "subtitle", "time": 6491.59, "timestamp": "01:48:11", "text": "表现出攻击性。坚持，稍等。芝诺在哪里？"}, {"type": "subtitle", "time": 6493.35, "timestamp": "01:48:13", "text": "她就是鬼魂的幕后黑手。你要走了"}, {"type": "subtitle", "time": 6497.189, "timestamp": "01:48:17", "text": "你们是围着桌子转圈圈吗？"}, {"type": "subtitle", "time": 6500.39, "timestamp": "01:48:20", "text": "我的天哪。它要来了。它要来了。哦"}, {"type": "subtitle", "time": 6507.27, "timestamp": "01:48:27", "text": "糟糕。"}, {"type": "subtitle", "time": 6510.55, "timestamp": "01:48:30", "text": "等等，我该怎么救你？我不知道。"}, {"type": "subtitle", "time": 6520.709, "timestamp": "01:48:40", "text": "我的天啊。我的天啊。"}, {"type": "subtitle", "time": 6522.75, "timestamp": "01:48:42", "text": "我的天哪。我太"}, {"type": "subtitle", "time": 6525.03, "timestamp": "01:48:45", "text": "害怕的。我不想孤身一人。"}, {"type": "subtitle", "time": 6526.87, "timestamp": "01:48:46", "text": "我是最后一个站着的人，因为我知道我是"}, {"type": "subtitle", "time": 6531.99, "timestamp": "01:48:51", "text": "做不到。兄弟，我尖叫起来。"}, {"type": "subtitle", "time": 6533.75, "timestamp": "01:48:53", "text": "鬼魂去过那里，对吧？鬼魂"}, {"type": "subtitle", "time": 6536.79, "timestamp": "01:48:56", "text": "去过那里。我该怎么办？我不好"}, {"type": "subtitle", "time": 6539.8, "timestamp": "01:48:59", "text": "在恐怖游戏中。这"}]
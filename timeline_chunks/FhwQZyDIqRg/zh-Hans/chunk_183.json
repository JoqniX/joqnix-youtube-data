[{"type": "subtitle", "time": 10980.469, "timestamp": "03:03:00", "text": "快点。你真的这么做了吗？ H."}, {"type": "subtitle", "time": 10982.99, "timestamp": "03:03:02", "text": "哦。哦。哦。你好。"}, {"type": "subtitle", "time": 10991.429, "timestamp": "03:03:11", "text": "呃，我很好，先生。"}, {"type": "subtitle", "time": 10997.67, "timestamp": "03:03:17", "text": "好的，请稍等片刻。我会去"}, {"type": "subtitle", "time": 11002.63, "timestamp": "03:03:22", "text": "去趟洗手间再回来。好的，如果是这样的话。"}, {"type": "subtitle", "time": 11005.51, "timestamp": "03:03:25", "text": "别耽误时间。你好。我是我"}, {"type": "subtitle", "time": 11008.55, "timestamp": "03:03:28", "text": "痛苦。我很难过。哦，不。全部"}, {"type": "subtitle", "time": 11011.11, "timestamp": "03:03:31", "text": "好的，我会回来的。"}, {"type": "subtitle", "time": 11034.67, "timestamp": "03:03:54", "text": "不。我的天哪，进去吧。我不进去。"}]
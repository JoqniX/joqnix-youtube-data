[{"type": "subtitle", "time": 9906.19, "timestamp": "02:45:06", "text": "伙计们，有恶魔出没。有恶魔出没。"}, {"type": "subtitle", "time": 9909.06, "timestamp": "02:45:09", "text": "驱魔人"}, {"type": "subtitle", "time": 9911.269, "timestamp": "02:45:11", "text": "[音乐]"}, {"type": "subtitle", "time": 9914.15, "timestamp": "02:45:14", "text": "恶魔在哪里？直直"}, {"type": "subtitle", "time": 9919.19, "timestamp": "02:45:19", "text": "前方。不。执行。练习"}, {"type": "subtitle", "time": 9922.15, "timestamp": "02:45:22", "text": "恶魔，兄弟。像他们那样玩"}, {"type": "subtitle", "time": 9925.51, "timestamp": "02:45:25", "text": "你知道，我并不喜欢恶魔。好的，"}, {"type": "subtitle", "time": 9926.79, "timestamp": "02:45:26", "text": "伙计们。我要把卡拿走。"}, {"type": "subtitle", "time": 9928.55, "timestamp": "02:45:28", "text": "显然，它不应该需要"}, {"type": "subtitle", "time": 9932.07, "timestamp": "02:45:32", "text": "优势。就在这里。就在这里。"}, {"type": "subtitle", "time": 9934.23, "timestamp": "02:45:34", "text": "是的，就是那种穿紧身衣的课，你"}, {"type": "subtitle", "time": 9937.83, "timestamp": "02:45:37", "text": "穿上紧身衣，然后你做运动"}, {"type": "subtitle", "time": 9939.63, "timestamp": "02:45:39", "text": "比如深蹲和……"}, {"type": "subtitle", "time": 9942.95, "timestamp": "02:45:42", "text": "跳过卡片，落后一步。天哪，我恨"}, {"type": "subtitle", "time": 9950.55, "timestamp": "02:45:50", "text": "卡片在哪里？就在这里。是"}, {"type": "subtitle", "time": 9951.83, "timestamp": "02:45:51", "text": "应该把它拿回去。所以我需要"}, {"type": "subtitle", "time": 9954.51, "timestamp": "02:45:54", "text": "帮助。我需要"}, {"type": "subtitle", "time": 9956.91, "timestamp": "02:45:56", "text": "仅公司。"}]
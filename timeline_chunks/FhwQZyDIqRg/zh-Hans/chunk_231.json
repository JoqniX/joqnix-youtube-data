[{"type": "subtitle", "time": 13862.229, "timestamp": "03:51:02", "text": "某个地方的老板和某人"}, {"type": "subtitle", "time": 13865.429, "timestamp": "03:51:05", "text": "出现了。他是我的下属，他说"}, {"type": "subtitle", "time": 13867.87, "timestamp": "03:51:07", "text": "老板，我迟到了，因为……"}, {"type": "subtitle", "time": 13871.75, "timestamp": "03:51:11", "text": "节日，呃，如果我要那样做的话"}, {"type": "subtitle", "time": 13874.07, "timestamp": "03:51:14", "text": "我会讲事实和逻辑，"}, {"type": "subtitle", "time": 13876.95, "timestamp": "03:51:16", "text": "你说你家离这里只有10米，"}, {"type": "subtitle", "time": 13879.83, "timestamp": "03:51:19", "text": "你，因为你有，呃，因为你就像"}, {"type": "subtitle", "time": 13883.189, "timestamp": "03:51:23", "text": "迟到11分钟就会被解雇。不，我"}, {"type": "subtitle", "time": 13885.67, "timestamp": "03:51:25", "text": "不能这么说，因为又出现了……"}, {"type": "subtitle", "time": 13888.79, "timestamp": "03:51:28", "text": "节日。他对此表述得非常清楚。"}, {"type": "subtitle", "time": 13890.79, "timestamp": "03:51:30", "text": "呃，因为当时还有一个节日，"}, {"type": "subtitle", "time": 13893.03, "timestamp": "03:51:33", "text": "他也因为你而请了一天假。"}, {"type": "subtitle", "time": 13895.75, "timestamp": "03:51:35", "text": "我知道他想去参加这个节日。我"}, {"type": "subtitle", "time": 13897.83, "timestamp": "03:51:37", "text": "不能像这样，你在这里工作直到你"}, {"type": "subtitle", "time": 13902.67, "timestamp": "03:51:42", "text": "靴子掉了。不，我不能。我不是"}, {"type": "subtitle", "time": 13906.79, "timestamp": "03:51:46", "text": "机器人混蛋。好的。我当时就想，好吧。"}, {"type": "subtitle", "time": 13909.51, "timestamp": "03:51:49", "text": "你想休息一天吗？美好的。美好的。"}, {"type": "subtitle", "time": 13912.07, "timestamp": "03:51:52", "text": "然后你放他们走了。"}, {"type": "subtitle", "time": 13913.71, "timestamp": "03:51:53", "text": "它是"}, {"type": "subtitle", "time": 13916.71, "timestamp": "03:51:56", "text": "美好的。是的，你这是在夺走人们的……"}, {"type": "subtitle", "time": 13919.67, "timestamp": "03:51:59", "text": "那种感觉是因为你知道如果你"}]
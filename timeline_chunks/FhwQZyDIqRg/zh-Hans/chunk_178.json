[{"type": "subtitle", "time": 10683.51, "timestamp": "02:58:03", "text": "哦。妈的。哦。"}, {"type": "subtitle", "time": 10685.91, "timestamp": "02:58:05", "text": "我的天哪。兄弟，这音乐太劲爆了。这"}, {"type": "subtitle", "time": 10689.03, "timestamp": "02:58:09", "text": "音乐很激昂。是的。看看那个"}, {"type": "subtitle", "time": 10693.309, "timestamp": "02:58:13", "text": "v 一。我的天啊。我什么？确实如此。"}, {"type": "subtitle", "time": 10695.91, "timestamp": "02:58:15", "text": "聪明的。所以，夏美是赢家。"}, {"type": "subtitle", "time": 10697.99, "timestamp": "02:58:17", "text": "乔克，你一直是赢家。呃，勺子，"}, {"type": "subtitle", "time": 10700.07, "timestamp": "02:58:20", "text": "你赢了。还有谁？哦，"}, {"type": "subtitle", "time": 10703.269, "timestamp": "02:58:23", "text": "谁赢了？我们走吧。我们有了新的获胜者。"}, {"type": "subtitle", "time": 10707.429, "timestamp": "02:58:27", "text": "我们有了新的获胜者。好的。"}, {"type": "subtitle", "time": 10710.95, "timestamp": "02:58:30", "text": "所以，大家……哦，不。不是我。我愿意"}, {"type": "subtitle", "time": 10714.23, "timestamp": "02:58:34", "text": "什么都行，兄弟。他在收拾残局，兄弟。"}, {"type": "subtitle", "time": 10725.03, "timestamp": "02:58:45", "text": "我的天啊。"}]
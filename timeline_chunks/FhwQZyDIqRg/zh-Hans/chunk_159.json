[{"type": "subtitle", "time": 9540.07, "timestamp": "02:39:00", "text": "我当时发出各种声音。"}, {"type": "subtitle", "time": 9543.11, "timestamp": "02:39:03", "text": "但你却保持沉默。它为什么要杀我？"}, {"type": "subtitle", "time": 9545.99, "timestamp": "02:39:05", "text": "呃，因为我跑步了。但我自救了。"}, {"type": "subtitle", "time": 9582.83, "timestamp": "02:39:42", "text": "哦，我还活着。我"}, {"type": "subtitle", "time": 9585.83, "timestamp": "02:39:45", "text": "居住。我们走吧。在哪里？在哪里？"}, {"type": "subtitle", "time": 9589.349, "timestamp": "02:39:49", "text": "哦，来了。"}, {"type": "subtitle", "time": 9591.75, "timestamp": "02:39:51", "text": "我们准备好了吗？"}, {"type": "subtitle", "time": 9595.11, "timestamp": "02:39:55", "text": "你可以离开了，对吧？是的，我们可以。呃，"}, {"type": "subtitle", "time": 9597.19, "timestamp": "02:39:57", "text": "芝诺在那里。还有，那个拿霰弹枪的人是"}, {"type": "subtitle", "time": 9599.11, "timestamp": "02:39:59", "text": "这里。"}]
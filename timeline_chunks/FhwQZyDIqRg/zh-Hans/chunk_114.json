[{"type": "subtitle", "time": 6840.55, "timestamp": "01:54:00", "text": "小指像……一样伸了进去"}, {"type": "subtitle", "time": 6843.27, "timestamp": "01:54:03", "text": "扩展插座之类的东西。哇。和"}, {"type": "subtitle", "time": 6851.35, "timestamp": "01:54:11", "text": "事情就是这样。事情就是这样。没脑子"}, {"type": "subtitle", "time": 6854.07, "timestamp": "01:54:14", "text": "损害。我保证。当然可以。是的。我"}, {"type": "subtitle", "time": 6855.91, "timestamp": "01:54:15", "text": "当然，这意味着你还活着。"}, {"type": "subtitle", "time": 6858.229, "timestamp": "01:54:18", "text": "一切运转正常。这些是什么？"}, {"type": "subtitle", "time": 6863.91, "timestamp": "01:54:23", "text": "你知道吗？我们让他们……"}, {"type": "subtitle", "time": 6866.39, "timestamp": "01:54:26", "text": "快点儿。我们正在购买吗？"}, {"type": "subtitle", "time": 6868.06, "timestamp": "01:54:28", "text": "这些？"}, {"type": "subtitle", "time": 6869.35, "timestamp": "01:54:29", "text": "[音乐]"}, {"type": "subtitle", "time": 6871.99, "timestamp": "01:54:31", "text": "这些东西是我们买的吗？我不知道。"}, {"type": "subtitle", "time": 6874.149, "timestamp": "01:54:34", "text": "我们买下了它们。"}, {"type": "subtitle", "time": 6886.229, "timestamp": "01:54:46", "text": "各位，各位，各位。呃，做那个保持"}, {"type": "subtitle", "time": 6887.99, "timestamp": "01:54:47", "text": "医护人员。"}, {"type": "subtitle", "time": 6891.03, "timestamp": "01:54:51", "text": "是的。等等。给我发垃圾邮件。哦不，芝诺"}, {"type": "subtitle", "time": 6892.31, "timestamp": "01:54:52", "text": "还没准备好。我没做。你没有"}, {"type": "subtitle", "time": 6894.55, "timestamp": "01:54:54", "text": "告诉我。是的，我还没准备好。我当时"}, {"type": "subtitle", "time": 6896.07, "timestamp": "01:54:56", "text": "等着你们去做呢。而当"}, {"type": "subtitle", "time": 6898.47, "timestamp": "01:54:58", "text": "你们都准备好了，我早就被告知了。"}]
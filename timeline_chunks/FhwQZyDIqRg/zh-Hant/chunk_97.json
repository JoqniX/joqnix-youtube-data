[{"type": "subtitle", "time": 5828.629, "timestamp": "01:37:08", "text": "你好。我的錯。我只是把我的酒放在這裡。  沒人看到。沒人看到。  [音樂] [音樂]"}, {"type": "subtitle", "time": 5837.669, "timestamp": "01:37:17", "text": "我來了，夥計"}, {"type": "subtitle", "time": 5840.229, "timestamp": "01:37:20", "text": "們。我來了。夥計們，過來一下。  我們走吧。進去！進去！進去！  感覺每次我"}, {"type": "subtitle", "time": 5851.43, "timestamp": "01:37:31", "text": "復活的時候，這些人就都來了。大家都到齊了嗎？大家都到齊了嗎"}, {"type": "subtitle", "time": 5852.95, "timestamp": "01:37:32", "text": "？是的。順便問一下，各位，他們為什麼在這裡？"}, {"type": "subtitle", "time": 5857.03, "timestamp": "01:37:37", "text": "跑步。為什麼？為什麼它想要復活？這就是我。哦，不。  我的天哪。哦"}]
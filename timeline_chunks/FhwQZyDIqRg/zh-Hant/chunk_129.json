[{"type": "subtitle", "time": 7744.55, "timestamp": "02:09:04", "text": "哦，天哪。她是如何激活的？  媽的。  我的天哪。救救自己。你可以"}, {"type": "subtitle", "time": 7746.149, "timestamp": "02:09:06", "text": "做到。  你可以做到。你肯定會贏。"}, {"type": "subtitle", "time": 7748.31, "timestamp": "02:09:08", "text": "哦，她想"}, {"type": "subtitle", "time": 7767.109, "timestamp": "02:09:27", "text": "找回自我。不，她應該搬回去。"}, {"type": "subtitle", "time": 7768.709, "timestamp": "02:09:28", "text": "後退。"}, {"type": "subtitle", "time": 7770.31, "timestamp": "02:09:30", "text": "女孩，為什麼？為什麼要這樣做"}, {"type": "subtitle", "time": 7772.629, "timestamp": "02:09:32", "text": "？我沒有。我沒想到他會在那裡開槍。我以為他在到處開槍。  他投籃時球飛過了桌子。我的天啊。"}, {"type": "subtitle", "time": 7774.39, "timestamp": "02:09:34", "text": "沒關係。滲透木材。一對一。"}, {"type": "subtitle", "time": 7778.149, "timestamp": "02:09:38", "text": "我想我們又要回到這個主題了。我討厭這個遊戲。我恨殺人。所以，"}, {"type": "subtitle", "time": 7798.79, "timestamp": "02:09:58", "text": "我就堅持下去。  我的天啊。"}]
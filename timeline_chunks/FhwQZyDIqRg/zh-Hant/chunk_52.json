[{"type": "subtitle", "time": 3131.589, "timestamp": "00:52:11", "text": "自我介紹，老兄。我已經說過我直播只是為了好玩。搞什麼鬼？"}, {"type": "subtitle", "time": 3136.87, "timestamp": "00:52:16", "text": "哦，不。我說過。我的天哪。很"}, {"type": "subtitle", "time": 3149.589, "timestamp": "00:52:29", "text": "抱歉你看不到我。呃"}, {"type": "subtitle", "time": 3150.95, "timestamp": "00:52:30", "text": "，你知道……你"}, {"type": "subtitle", "time": 3156.71, "timestamp": "00:52:36", "text": "知道我的「重頭戲」是什麼嗎？你知道我的「重頭戲」是什麼嗎"}, {"type": "subtitle", "time": 3158.47, "timestamp": "00:52:38", "text": "？在床上玩鯊魚。不知道。我的天哪。我的……哦，不。我其實沒什麼背景"}, {"type": "subtitle", "time": 3168.79, "timestamp": "00:52:48", "text": "故事，但我的朋友決定讓我扮演一個逃離政府的科學家。所以，就是這樣。我知道。就是這樣……"}]
[{"type": "subtitle", "time": 9127.27, "timestamp": "02:32:07", "text": "一個站著的人，因為"}, {"type": "subtitle", "time": 9135.03, "timestamp": "02:32:15", "text": "我知道我肯定不行了。"}, {"type": "subtitle", "time": 9151.83, "timestamp": "02:32:31", "text": "兄弟，我尖叫起來。  鬼魂去過那裡，對吧？鬼魂去了那裡。我該怎麼辦？我不擅長玩恐怖遊戲。這音樂太爛了。他們要不是離開了，就是鬼魂在這附近。我能聽到，我聽得到。  我能聽到你說話。"}, {"type": "subtitle", "time": 9157.349, "timestamp": "02:32:37", "text": "你在嗎"}, {"type": "subtitle", "time": 9159.349, "timestamp": "02:32:39", "text": "？是的。這邊走。我沒看見"}, {"type": "subtitle", "time": 9169.349, "timestamp": "02:32:49", "text": "你。過來一下。  我就在這裡"}, {"type": "subtitle", "time": 9175.51, "timestamp": "02:32:55", "text": "。來，來，來。我們要走了。好了，"}, {"type": "subtitle", "time": 9177.83, "timestamp": "02:32:57", "text": "我們走吧。  跑步。我在跑步。我在跑步。我們找到她了。我們找到她了。哦"}]
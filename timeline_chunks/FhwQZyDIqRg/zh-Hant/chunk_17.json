[{"type": "subtitle", "time": 1021.15, "timestamp": "00:17:01", "text": "狀物。  H 它降低了渲染 n。你好。那個黑色的東西是什麼？那是什麼？那是項圈嗎？太酷了。你沒成功。"}, {"type": "subtitle", "time": 1023.99, "timestamp": "00:17:03", "text": "我完全看清了"}, {"type": "subtitle", "time": 1027.669, "timestamp": "00:17:07", "text": "。好的。  看到火焰表情符號了嗎"}, {"type": "subtitle", "time": 1037.35, "timestamp": "00:17:17", "text": "？  你好。哦，那是"}, {"type": "subtitle", "time": 1041.47, "timestamp": "00:17:21", "text": "第三個購物中心之類的東西。 H. 準備好"}, {"type": "subtitle", "time": 1056.63, "timestamp": "00:17:36", "text": "你的鼓點"}, {"type": "subtitle", "time": 1059.23, "timestamp": "00:17:39", "text": "。目前這只是在"}, {"type": "subtitle", "time": 1062.23, "timestamp": "00:17:42", "text": "開玩笑。"}, {"type": "subtitle", "time": 1076.83, "timestamp": "00:17:56", "text": "我這是在逗你們玩。只是不知道而已。那是我的嘴唇。  那是"}]
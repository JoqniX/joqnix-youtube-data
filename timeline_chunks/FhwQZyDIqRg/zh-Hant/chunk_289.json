[{"type": "subtitle", "time": 17340.83, "timestamp": "04:49:00", "text": "沒關係。這就是你犯錯的"}, {"type": "subtitle", "time": 17344.91, "timestamp": "04:49:04", "text": "階段。你會覺得周圍都是錯誤。但"}, {"type": "subtitle", "time": 17353.11, "timestamp": "04:49:13", "text": "如果你長大了，每一個錯誤都會變成你棺材上的釘子。所以，趁年輕，想犯多少錯就犯多少錯，但是，"}, {"type": "subtitle", "time": 17368.39, "timestamp": "04:49:28", "text": "呃，因為當"}, {"type": "subtitle", "time": 17370.47, "timestamp": "04:49:30", "text": "你成年後，你就不能犯錯了。你是成年人了。你怎麼可能犯錯呢？所以，是啊。所以，請不要再聽"}]
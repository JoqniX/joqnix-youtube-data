[{"type": "subtitle", "time": 8302.549, "timestamp": "02:18:22", "text": "我這麼做，對吧？  該死的。該死，這遊戲。我明白了。我接到你了。哦，我記得這些。"}, {"type": "subtitle", "time": 8310.07, "timestamp": "02:18:30", "text": "我小時候，錄影機上就用過這些東西。我的天啊。  我的天哪。發生了什麼事？隨便殺個人就好了。我可以反擊霸凌"}, {"type": "subtitle", "time": 8312.23, "timestamp": "02:18:32", "text": "他人的行為嗎？  也許"}, {"type": "subtitle", "time": 8323.509, "timestamp": "02:18:43", "text": "我是在霸凌別人。  哦，不"}, {"type": "subtitle", "time": 8326.389, "timestamp": "02:18:46", "text": "。我勒個去？抓住他。幹掉他，"}, {"type": "subtitle", "time": 8335.589, "timestamp": "02:18:55", "text": "小子。抓住他。幹掉他，小子。我的天哪。"}]
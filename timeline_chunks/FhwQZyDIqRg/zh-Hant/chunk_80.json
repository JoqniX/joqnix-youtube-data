[{"type": "subtitle", "time": 4807.11, "timestamp": "01:20:07", "text": "哦，你好。  是的。是的，沒問題。沒關係。它不見了嗎？它不見了嗎"}, {"type": "subtitle", "time": 4824.47, "timestamp": "01:20:24", "text": "？好的。我要穿過這扇門嗎"}, {"type": "subtitle", "time": 4839.669, "timestamp": "01:20:39", "text": "？你看到了嗎？我覺得每次都是這樣，祝你們好運。電視訊號來了。  電視。電視。請把它放進購物車好嗎"}]
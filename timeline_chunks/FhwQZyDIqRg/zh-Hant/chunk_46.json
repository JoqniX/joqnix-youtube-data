[{"type": "subtitle", "time": 2761.03, "timestamp": "00:46:01", "text": "天哪，我們都在這裡。我的天哪。我喜歡我們"}, {"type": "subtitle", "time": 2780.79, "timestamp": "00:46:20", "text": "腦袋這樣晃動的樣子。太搞笑了。哦"}, {"type": "subtitle", "time": 2783.349, "timestamp": "00:46:23", "text": "，對了，你們能不能在Discord上把我靜音，這樣我才能收到你們的Discord"}, {"type": "subtitle", "time": 2787.589, "timestamp": "00:46:27", "text": "回覆訊息？幫我說話，別靜音。好的。好的。好的。好的。好的。好的。"}, {"type": "subtitle", "time": 2797.03, "timestamp": "00:46:37", "text": "呃，我們慢慢地……再靠近一點。哦，對"}, {"type": "subtitle", "time": 2798.95, "timestamp": "00:46:38", "text": "。我為什麼能看到它？因為我聽到你的迴音。有意思。"}, {"type": "subtitle", "time": 2804.47, "timestamp": "00:46:44", "text": "哦，對。這是兩次了。呃，所以我才說……"}, {"type": "subtitle", "time": 2817.51, "timestamp": "00:46:57", "text": "哦，你當然可以……我該怎麼做？呃，那是耳機圖示。對"}]
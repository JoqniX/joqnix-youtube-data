[{"type": "subtitle", "time": 3841.67, "timestamp": "01:04:01", "text": "哦，不。它回來了。是我的。快來。你去哪裡了？"}, {"type": "subtitle", "time": 3856.309, "timestamp": "01:04:16", "text": "哦，不"}, {"type": "subtitle", "time": 3866.63, "timestamp": "01:04:26", "text": "我們可以走了嗎？我們可以走了嗎，"}, {"type": "subtitle", "time": 3869.75, "timestamp": "01:04:29", "text": "夥計們？我的天哪。哦，糟糕。"}, {"type": "subtitle", "time": 3888.39, "timestamp": "01:04:48", "text": "我覺得不太妙。你好。你好。我愛你……他為什麼在這裡？再殺了他一次。你可以，你可以去為我犧牲自己。我知道你想這麼做。你知道，你"}]
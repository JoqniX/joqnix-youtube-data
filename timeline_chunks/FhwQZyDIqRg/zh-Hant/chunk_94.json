[{"type": "subtitle", "time": 5640.149, "timestamp": "01:34:00", "text": "哦，又一個侏儒。  哦，又是一群矮人。  哦，瞧。這是什麼？"}, {"type": "subtitle", "time": 5641.99, "timestamp": "01:34:01", "text": "不，不，不，不，不，不。你會喝醉的"}, {"type": "subtitle", "time": 5650.79, "timestamp": "01:34:10", "text": "。  不，"}, {"type": "subtitle", "time": 5666.95, "timestamp": "01:34:26", "text": "我應該把它放在箱子裡"}, {"type": "subtitle", "time": 5685.35, "timestamp": "01:34:45", "text": "[音樂] 我們迷路了嗎"}]
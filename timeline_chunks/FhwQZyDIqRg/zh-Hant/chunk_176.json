[{"type": "subtitle", "time": 10591.59, "timestamp": "02:56:31", "text": "可能會給自己設定5分鐘的禁閉時間。請不要這樣做。請勿發送垃圾郵件。請勿發送垃圾郵件。只需說一遍。"}, {"type": "subtitle", "time": 10593.95, "timestamp": "02:56:33", "text": "我願意做。無需發送垃圾郵件。哦？什麼？"}, {"type": "subtitle", "time": 10598.55, "timestamp": "02:56:38", "text": "這是怎麼回事"}, {"type": "subtitle", "time": 10600.75, "timestamp": "02:56:40", "text": "？  什麼？"}, {"type": "subtitle", "time": 10604.15, "timestamp": "02:56:44", "text": "夥計們，我們沒必要發垃圾郵件。我相信你們都是第一次來看我的"}, {"type": "subtitle", "time": 10617.91, "timestamp": "02:56:57", "text": "頻道。但是，請務必遵守規則。不需要垃圾郵件。如果你想說“W”，只需說一次。發送垃圾郵件毫無意義"}]
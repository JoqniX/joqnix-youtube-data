[{"type": "subtitle", "time": 4391.27, "timestamp": "01:13:11", "text": "不，我不想看你。我不想面對……哦，他們會殺了你而不是那樣。他就在我面前。有多少人？我死了多少次了？我是說，我才玩了十分鐘，就死了三次了。"}, {"type": "subtitle", "time": 4405.91, "timestamp": "01:13:25", "text": "我該把他從"}, {"type": "subtitle", "time": 4413.189, "timestamp": "01:13:33", "text": "你身邊移開嗎？不，你知道，這可是個很棒的開局。它還在"}, {"type": "subtitle", "time": 4420.229, "timestamp": "01:13:40", "text": "那裡。它不會消失。"}, {"type": "subtitle", "time": 4421.51, "timestamp": "01:13:41", "text": "哦。哦。哦。我的天哪。"}, {"type": "subtitle", "time": 4425.229, "timestamp": "01:13:45", "text": "對"}, {"type": "subtitle", "time": 4436.31, "timestamp": "01:13:56", "text": "我來說太"}]
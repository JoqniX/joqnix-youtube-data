[{"type": "subtitle", "time": 7142.87, "timestamp": "01:59:02", "text": "誰來告訴她。  我的天啊。不，這還不夠。不是那樣。  哦，這還不夠。哦，有噪音。  好吧，那我們怎麼知道鬼魂即將到來呢"}, {"type": "subtitle", "time": 7155.51, "timestamp": "01:59:15", "text": "？你聽到類似的聲音嗎？"}, {"type": "subtitle", "time": 7158.03, "timestamp": "01:59:18", "text": "哦，是的"}, {"type": "subtitle", "time": 7182.149, "timestamp": "01:59:42", "text": "。  哦"}, {"type": "subtitle", "time": 7192.39, "timestamp": "01:59:52", "text": "，你死了。  歡迎來到"}, {"type": "subtitle", "time": 7196.109, "timestamp": "01:59:56", "text": "槍擊現場。"}, {"type": "subtitle", "time": 7198.79, "timestamp": "01:59:58", "text": "你好。"}]
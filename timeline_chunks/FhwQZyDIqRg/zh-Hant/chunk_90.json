[{"type": "subtitle", "time": 5409.99, "timestamp": "01:30:09", "text": "我。  我的錯，兄弟。  我的意思是，就我個人而言，我沒想到他會真的憑空出現"}, {"type": "subtitle", "time": 5428.79, "timestamp": "01:30:28", "text": "我認識那口井，我認識它的後代。我以為他已經到了。你我都指出來了。我已經指出來了，夥計們。快點。是的"}, {"type": "subtitle", "time": 5441.39, "timestamp": "01:30:41", "text": "。我記得當時"}, {"type": "subtitle", "time": 5446.229, "timestamp": "01:30:46", "text": "人山人海，我不知道自己身在何處，所以我就"}, {"type": "subtitle", "time": 5448.149, "timestamp": "01:30:48", "text": "蹲了下來，我不知道"}]
[{"type": "subtitle", "time": 3904.789, "timestamp": "01:05:04", "text": "是個"}, {"type": "subtitle", "time": 3909.91, "timestamp": "01:05:09", "text": "偉大的英雄。"}, {"type": "subtitle", "time": 3913.43, "timestamp": "01:05:13", "text": "不。她在"}, {"type": "subtitle", "time": 3918.069, "timestamp": "01:05:18", "text": "哪裡？兄弟正盯著我看。是他盯著我看"}, {"type": "subtitle", "time": 3930.39, "timestamp": "01:05:30", "text": "。為什麼不回血？他真的在盯著我看，小子。快回來。餵，佐伊在哪裡？他死了，兄弟。為什麼不回血？"}, {"type": "subtitle", "time": 3938.71, "timestamp": "01:05:38", "text": "他應該復活的。為什麼不回血？為什麼？嗯？等等，他為什麼不復活？哦，"}, {"type": "subtitle", "time": 3944.63, "timestamp": "01:05:44", "text": "你施個法術他就會復活。所以，我們得把他留在這裡"}, {"type": "subtitle", "time": 3947.23, "timestamp": "01:05:47", "text": "。不，我們得去另一個撤離點。這個撤離點關閉了。"}]
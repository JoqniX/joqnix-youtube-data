[{"type": "subtitle", "time": 13092.469, "timestamp": "03:38:12", "text": "？我懂了"}, {"type": "subtitle", "time": 13095.19, "timestamp": "03:38:15", "text": "。  是的。有些時候，環境中的毒素會徹底摧毀你。但"}, {"type": "subtitle", "time": 13109.19, "timestamp": "03:38:29", "text": "我認為總的來說，我覺得人們正在"}, {"type": "subtitle", "time": 13111.91, "timestamp": "03:38:31", "text": "改變，因為他們意識到，動漫在我上學的時候並不像現在這麼流行。"}]
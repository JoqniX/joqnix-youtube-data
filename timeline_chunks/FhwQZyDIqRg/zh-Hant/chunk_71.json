[{"type": "subtitle", "time": 4285.83, "timestamp": "01:11:25", "text": "？就像在右上角。不過上面寫著一個一個來。所以，上面只有一個撤離點，對吧？呃，是的。一個"}, {"type": "subtitle", "time": 4292.75, "timestamp": "01:11:32", "text": "撤離點。快，快，快，快，快。我的意思是，好吧，我"}, {"type": "subtitle", "time": 4295.39, "timestamp": "01:11:35", "text": "想是吧。該死，兄弟。如果我一個人玩，"}, {"type": "subtitle", "time": 4319.59, "timestamp": "01:11:59", "text": "夥計"}]
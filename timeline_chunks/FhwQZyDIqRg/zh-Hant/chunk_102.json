[{"type": "subtitle", "time": 6125.75, "timestamp": "01:42:05", "text": "好的。"}, {"type": "subtitle", "time": 6128.47, "timestamp": "01:42:08", "text": "我們就是"}, {"type": "subtitle", "time": 6130.83, "timestamp": "01:42:10", "text": "要這麼做"}, {"type": "subtitle", "time": 6133.83, "timestamp": "01:42:13", "text": "。 （笑聲）我要把它推進馬桶"}, {"type": "subtitle", "time": 6136.07, "timestamp": "01:42:16", "text": "裡。  不，我不"}, {"type": "subtitle", "time": 6159.75, "timestamp": "01:42:39", "text": "等等，等等。請到中心告訴我們。去做。開門。開門。  我們走吧。我做不到。你被困住了。  呃，跳起來然後放手。"}, {"type": "subtitle", "time": 6171.35, "timestamp": "01:42:51", "text": "不，你不是。我們"}]
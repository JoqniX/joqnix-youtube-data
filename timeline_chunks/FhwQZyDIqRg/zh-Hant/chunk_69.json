[{"type": "subtitle", "time": 4141.829, "timestamp": "01:09:01", "text": "哦，等等。沒事了。沒事了。哦。哦，我們Shift鍵。哦。我的天。我們沒救活那傢伙。他當時就在我旁邊。我們倆一起死了。他在哪裡？他在這個東西裡面。在"}, {"type": "subtitle", "time": 4185.269, "timestamp": "01:09:45", "text": "車裡。對。我的天。他為什麼不走？我們還需要"}, {"type": "subtitle", "time": 4191.03, "timestamp": "01:09:51", "text": "找到第二個撤離點。是嗎？對。我們需要一個……"}, {"type": "subtitle", "time": 4195.91, "timestamp": "01:09:55", "text": "哦，老天。所以，它"}]
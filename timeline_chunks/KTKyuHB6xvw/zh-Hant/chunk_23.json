[{"type": "subtitle", "time": 1380.95, "timestamp": "00:23:00", "text": "武器切換彈藥類型。好的。"}, {"type": "subtitle", "time": 1392.31, "timestamp": "00:23:12", "text": "沒參與這項工作。他很懶。"}, {"type": "subtitle", "time": 1395.59, "timestamp": "00:23:15", "text": "哦，他骨折了。哦，我"}, {"type": "subtitle", "time": 1396.23, "timestamp": "00:23:16", "text": "應該……我的"}, {"type": "subtitle", "time": 1406.95, "timestamp": "00:23:26", "text": "看，我沒錢了。好的。當你"}, {"type": "subtitle", "time": 1408.39, "timestamp": "00:23:28", "text": "創業或做其他事情的時候，如果你沒有"}, {"type": "subtitle", "time": 1411.11, "timestamp": "00:23:31", "text": "錢，一切"}, {"type": "subtitle", "time": 1413.029, "timestamp": "00:23:33", "text": "都得調整，例如你的"}, {"type": "subtitle", "time": 1415.43, "timestamp": "00:23:35", "text": "員工等等。"}, {"type": "subtitle", "time": 1417.11, "timestamp": "00:23:37", "text": "是的。"}, {"type": "subtitle", "time": 1419.59, "timestamp": "00:23:39", "text": "一旦我累積了足夠的資源，而且是那種"}, {"type": "subtitle", "time": 1421.11, "timestamp": "00:23:41", "text": "好"}, {"type": "subtitle", "time": 1424.39, "timestamp": "00:23:44", "text": "東西，我就可以"}, {"type": "subtitle", "time": 1429.11, "timestamp": "00:23:49", "text": "讓我的員工過著奢華的生活了。"}, {"type": "subtitle", "time": 1432.47, "timestamp": "00:23:52", "text": "可以為他們泡溫泉，據說"}, {"type": "subtitle", "time": 1436.71, "timestamp": "00:23:56", "text": "可以提升他們的精神狀態。"}]
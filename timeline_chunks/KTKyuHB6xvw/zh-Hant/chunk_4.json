[{"type": "subtitle", "time": 242.149, "timestamp": "00:04:02", "text": "輕鬆地玩一遍。所以，嗯，今天我"}, {"type": "subtitle", "time": 244.789, "timestamp": "00:04:04", "text": "有個朋友。"}, {"type": "subtitle", "time": 246.869, "timestamp": "00:04:06", "text": "所以，"}, {"type": "subtitle", "time": 250.39, "timestamp": "00:04:10", "text": "嗯[音樂] K，今晚有一位朋友會"}, {"type": "subtitle", "time": 273.51, "timestamp": "00:04:33", "text": "我們認識多久了？"}, {"type": "subtitle", "time": 273.99, "timestamp": "00:04:33", "text": "七年。  是的，"}, {"type": "subtitle", "time": 275.67, "timestamp": "00:04:35", "text": "我們彼此認識，[音樂]我們已經認識"}, {"type": "subtitle", "time": 278.71, "timestamp": "00:04:38", "text": "七年了。已經過去很久了。"}, {"type": "subtitle", "time": 282.79, "timestamp": "00:04:42", "text": "哦，就是他。是的。"}]
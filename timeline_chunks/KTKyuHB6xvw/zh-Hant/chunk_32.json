[{"type": "subtitle", "time": 1922.789, "timestamp": "00:32:02", "text": "照片"}, {"type": "subtitle", "time": 1926.31, "timestamp": "00:32:06", "text": "和所有東西都存放在電源箱裡。"}, {"type": "subtitle", "time": 1955.11, "timestamp": "00:32:35", "text": "我已經吃飽了，可以"}, {"type": "subtitle", "time": 1965.669, "timestamp": "00:32:45", "text": "哦，是的。覺得他很有自信，"}, {"type": "subtitle", "time": 1968.63, "timestamp": "00:32:48", "text": "對吧？是的。  令人"}, {"type": "subtitle", "time": 1970.87, "timestamp": "00:32:50", "text": "難以置信的是，"}, {"type": "subtitle", "time": 1974.07, "timestamp": "00:32:54", "text": "當你只是窺探和"}, {"type": "subtitle", "time": 1977.11, "timestamp": "00:32:57", "text": "探索了遊戲的一小部分時，其中竟然包含瞭如此多的東西，"}]
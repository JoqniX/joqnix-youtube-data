[{"type": "subtitle", "time": 1141.99, "timestamp": "00:19:01", "text": "知道該如何把食物給"}, {"type": "subtitle", "time": 1143.83, "timestamp": "00:19:03", "text": "我的朋友。他們就像……"}, {"type": "subtitle", "time": 1147.669, "timestamp": "00:19:07", "text": "你只要靠近他們就行了。你"}, {"type": "subtitle", "time": 1151.11, "timestamp": "00:19:11", "text": "點擊四，然後就可以餵食了。"}, {"type": "subtitle", "time": 1153.59, "timestamp": "00:19:13", "text": "他們都在睡覺。"}, {"type": "subtitle", "time": 1155.11, "timestamp": "00:19:15", "text": "哦，"}, {"type": "subtitle", "time": 1159.11, "timestamp": "00:19:19", "text": "他們又餓又"}, {"type": "subtitle", "time": 1175.75, "timestamp": "00:19:35", "text": "哦，是的，切割時"}, {"type": "subtitle", "time": 1177.909, "timestamp": "00:19:37", "text": "會有一點延遲。不，只有當我和對方互動完成的時候。  例如，當我砍完樹後，會"}, {"type": "subtitle", "time": 1180.87, "timestamp": "00:19:40", "text": "稍微耽擱。"}, {"type": "subtitle", "time": 1184.71, "timestamp": "00:19:44", "text": "所以我覺得這應該是伺服器的"}, {"type": "subtitle", "time": 1191.669, "timestamp": "00:19:51", "text": "伺服器主要"}, {"type": "subtitle", "time": 1194.47, "timestamp": "00:19:54", "text": "是印度伺服器，所以"}, {"type": "subtitle", "time": 1199.99, "timestamp": "00:19:59", "text": "來自印度的玩家會很"}]
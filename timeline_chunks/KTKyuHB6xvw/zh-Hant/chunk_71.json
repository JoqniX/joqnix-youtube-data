[{"type": "subtitle", "time": 4273.75, "timestamp": "01:11:13", "text": "有趣的是，我現在還沒把我的朋友盒子放好。我當時什麼都做。"}, {"type": "subtitle", "time": 4276.709, "timestamp": "01:11:16", "text": "我做這一切的時候都沒放我的垃圾桶。  那它還不是基地。  這裡還不是基地"}, {"type": "subtitle", "time": 4285.75, "timestamp": "01:11:25", "text": "。我打算把那裡當作我的基地。"}, {"type": "subtitle", "time": 4294.874, "timestamp": "01:11:34", "text": "我的朋友就看著我，他甚至都沒在工作。"}]
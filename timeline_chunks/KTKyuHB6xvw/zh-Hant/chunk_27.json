[{"type": "subtitle", "time": 1635.99, "timestamp": "00:27:15", "text": "我的天哪，我連跳都跳不起來。"}, {"type": "subtitle", "time": 1640.789, "timestamp": "00:27:20", "text": "延遲太嚴重了。嗯，對。"}, {"type": "subtitle", "time": 1649.43, "timestamp": "00:27:29", "text": "日本離印度很遠嗎？就像"}, {"type": "subtitle", "time": 1652.39, "timestamp": "00:27:32", "text": "新加坡通常會採取"}, {"type": "subtitle", "time": 1667.19, "timestamp": "00:27:47", "text": "我想以此為基地。"}]
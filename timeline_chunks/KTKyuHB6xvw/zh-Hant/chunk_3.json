[{"type": "subtitle", "time": 197.03, "timestamp": "00:03:17", "text": "大家好。歡迎，歡迎。"}, {"type": "subtitle", "time": 201.50900000000001, "timestamp": "00:03:21", "text": "嗯，是的，今天我們會進行一場 PAL"}, {"type": "subtitle", "time": 203.75, "timestamp": "00:03:23", "text": "世界直播。"}, {"type": "subtitle", "time": 206.79, "timestamp": "00:03:26", "text": "是的，我們會進行PAL制直播。我會在"}, {"type": "subtitle", "time": 210.71, "timestamp": "00:03:30", "text": "我為幾個朋友新建的伺服器上玩遊戲"}, {"type": "subtitle", "time": 213.03, "timestamp": "00:03:33", "text": "。我會在"}, {"type": "subtitle", "time": 217.19, "timestamp": "00:03:37", "text": "那兒扮演一個呃，老兄。所以，呃，它不會像"}, {"type": "subtitle", "time": 220.47, "timestamp": "00:03:40", "text": "你之前"}, {"type": "subtitle", "time": 225.35, "timestamp": "00:03:45", "text": "在我的直播中看到的調色板系列劇集那樣。"}, {"type": "subtitle", "time": 228.07, "timestamp": "00:03:48", "text": "所以一切都要從頭開始。我"}, {"type": "subtitle", "time": 230.47, "timestamp": "00:03:50", "text": "想我確實玩了一會兒。所以我"}, {"type": "subtitle", "time": 232.309, "timestamp": "00:03:52", "text": "不想浪費"}, {"type": "subtitle", "time": 234.55, "timestamp": "00:03:54", "text": "今天的時間。所以我玩了一會兒。"}, {"type": "subtitle", "time": 237.35, "timestamp": "00:03:57", "text": "我們就從這裡開始，"}]
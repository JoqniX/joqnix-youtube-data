[{"type": "subtitle", "time": 5280.79, "timestamp": "01:28:00", "text": "アリーに3人と話し合うように頼んだんだ"}, {"type": "subtitle", "time": 5285.189, "timestamp": "01:28:05", "text": "。 ファルファとウメは"}, {"type": "subtitle", "time": 5287.59, "timestamp": "01:28:07", "text": "新しいツールとして何が欲しいかと尋ねられ、"}, {"type": "subtitle", "time": 5297.27, "timestamp": "01:28:17", "text": "生のメモリを読み取ることができるツールが欲しいと言いました。"}, {"type": "subtitle", "time": 5301.03, "timestamp": "01:28:21", "text": "それで私は、夜に思い出させてくれ、"}, {"type": "subtitle", "time": 5314.07, "timestamp": "01:28:34", "text": "木材がなくなった、と言いました。"}, {"type": "subtitle", "time": 5316.87, "timestamp": "01:28:36", "text": "私もです。   今の私は自分が何をしているのかさえ分かっていません"}, {"type": "subtitle", "time": 5328.47, "timestamp": "01:28:48", "text": "署名ボードも全部自分で作りました。"}, {"type": "subtitle", "time": 5331.51, "timestamp": "01:28:51", "text": "そう、だからまだ"}]
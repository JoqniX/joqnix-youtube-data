[{"type": "subtitle", "time": 6721.589, "timestamp": "01:52:01", "text": "。 えっと、つまり、いつでも変更できます。私は"}, {"type": "subtitle", "time": 6727.43, "timestamp": "01:52:07", "text": "いつも地域を変更しますが、"}, {"type": "subtitle", "time": 6729.589, "timestamp": "01:52:09", "text": "それでも"}, {"type": "subtitle", "time": 6751.589, "timestamp": "01:52:31", "text": "パラジウム。"}, {"type": "subtitle", "time": 6761.83, "timestamp": "01:52:41", "text": "鉄分か静脈も必要です。 うん、これは"}, {"type": "subtitle", "time": 6771.51, "timestamp": "01:52:51", "text": "速い。 私はまだPAL 1を始めていないのに、もう3作目に入っているようですね"}, {"type": "subtitle", "time": 6776.229, "timestamp": "01:52:56", "text": "。"}, {"type": "subtitle", "time": 6778.709, "timestamp": "01:52:58", "text": "ああ、まさに新しい世界だ。 ここから"}]
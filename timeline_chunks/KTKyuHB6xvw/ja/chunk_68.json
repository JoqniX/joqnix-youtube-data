[{"type": "subtitle", "time": 4097.59, "timestamp": "01:08:17", "text": "ああ、そうそう、完全に"}, {"type": "subtitle", "time": 4100.47, "timestamp": "01:08:20", "text": "これを復活させるんだ。   お腹が"}, {"type": "subtitle", "time": 4103.189, "timestamp": "01:08:23", "text": "いっぱいだと走れない。"}, {"type": "subtitle", "time": 4106.789, "timestamp": "01:08:26", "text": "そう、まさにそこなんです。 そして問題は、"}, {"type": "subtitle", "time": 4114.07, "timestamp": "01:08:34", "text": "簡単に降りられるはしごか何かを作らなければならないということです。"}, {"type": "subtitle", "time": 4117.749, "timestamp": "01:08:37", "text": "これは本当に痛い。"}, {"type": "subtitle", "time": 4121.03, "timestamp": "01:08:41", "text": "えっと、今はただ壁にしがみついて、"}, {"type": "subtitle", "time": 4124.55, "timestamp": "01:08:44", "text": "死なないことを祈っているだけです。"}, {"type": "subtitle", "time": 4126.07, "timestamp": "01:08:46", "text": "ええ、わかっています。"}]
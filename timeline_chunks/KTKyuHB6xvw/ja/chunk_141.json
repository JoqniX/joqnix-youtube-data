[{"type": "subtitle", "time": 8462.389, "timestamp": "02:21:02", "text": "彼女を選ぶのか？ ああ、できるよ。 いいえ。Vはどうやって"}, {"type": "subtitle", "time": 8464.23, "timestamp": "02:21:04", "text": "投げるのですか"}, {"type": "subtitle", "time": 8467.349, "timestamp": "02:21:07", "text": "？ わかった。 ごめん。   迎えに行くよ"}, {"type": "subtitle", "time": 8508.71, "timestamp": "02:21:48", "text": "私が探している言葉は何だっけ？"}, {"type": "subtitle", "time": 8513.11, "timestamp": "02:21:53", "text": "転校生のW。他の生徒はみんなそういう感じだ"}]
[{"type": "subtitle", "time": 7990.31, "timestamp": "02:13:10", "text": "こんにちは、どうぞ中へ。 戻ってきました。 待って、"}, {"type": "subtitle", "time": 7992.55, "timestamp": "02:13:12", "text": "ユーリはどこ？ 待って、彼は車から降りたの"}, {"type": "subtitle", "time": 7997.43, "timestamp": "02:13:17", "text": "か、それとも… ああ、停電だ。"}, {"type": "subtitle", "time": 8009.589, "timestamp": "02:13:29", "text": "おお。"}, {"type": "subtitle", "time": 8013.27, "timestamp": "02:13:33", "text": "ああ、戻ってきたんだね。 おかえり。"}, {"type": "subtitle", "time": 8015.589, "timestamp": "02:13:35", "text": "私の電源は突然切れた。"}, {"type": "subtitle", "time": 8030.79, "timestamp": "02:13:50", "text": "ああ、もう終わりに近づいているんですね。"}, {"type": "subtitle", "time": 8034.39, "timestamp": "02:13:54", "text": "あなたはさっきダンジョンにいましたよね"}, {"type": "subtitle", "time": 8036.39, "timestamp": "02:13:56", "text": "。 私は"}, {"type": "subtitle", "time": 8039.43, "timestamp": "02:13:59", "text": "実際に基地を出て、また戻ってきたと思っていました。"}]
[{"type": "subtitle", "time": 373.99, "timestamp": "00:06:13", "text": "。 えーと、ここから始めます。   えっと、"}, {"type": "subtitle", "time": 379.189, "timestamp": "00:06:19", "text": "もし背景の雑音が聞こえたら、私のことは"}, {"type": "subtitle", "time": 381.43, "timestamp": "00:06:21", "text": "無視してください。   ええと、"}, {"type": "subtitle", "time": 384.469, "timestamp": "00:06:24", "text": "ここから始めました。 それは新しい"}, {"type": "subtitle", "time": 386.79, "timestamp": "00:06:26", "text": "世界だ。"}, {"type": "subtitle", "time": 389.27, "timestamp": "00:06:29", "text": "私は全てあそこに置いておいた。 私の仲間たちは"}, {"type": "subtitle", "time": 392.87, "timestamp": "00:06:32", "text": "飢えていて、死にかけていて、もうすぐ"}, {"type": "subtitle", "time": 396.71, "timestamp": "00:06:36", "text": "死にそうです。 すぐ。  [笑い]"}, {"type": "subtitle", "time": 399.59000000000003, "timestamp": "00:06:39", "text": "HPが1しかないのはどういうことですか？"}, {"type": "subtitle", "time": 403.51, "timestamp": "00:06:43", "text": "ああ、だって寒かったし。 何か"}, {"type": "subtitle", "time": 405.749, "timestamp": "00:06:45", "text": "食べなきゃいけないかもしれない。"}, {"type": "subtitle", "time": 409.11, "timestamp": "00:06:49", "text": "私は、私は、私は、私は、私は、私は、"}, {"type": "subtitle", "time": 412.71, "timestamp": "00:06:52", "text": "えーと、"}]
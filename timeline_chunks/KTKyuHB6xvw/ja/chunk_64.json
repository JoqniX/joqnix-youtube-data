[{"type": "subtitle", "time": 3841.029, "timestamp": "01:04:01", "text": "。 遠くから来た者たち。"}, {"type": "subtitle", "time": 3843.99, "timestamp": "01:04:03", "text": "だから奴らは俺より"}, {"type": "subtitle", "time": 3847.43, "timestamp": "01:04:07", "text": "先に仲間を殺したんだ。"}, {"type": "subtitle", "time": 3853.829, "timestamp": "01:04:13", "text": "ああ、彼らは意識を失っている。 わかった。 彼らはまるで"}, {"type": "subtitle", "time": 3855.829, "timestamp": "01:04:15", "text": "死んでいるようには見えない。   死んだ、死んだ"}, {"type": "subtitle", "time": 3857.829, "timestamp": "01:04:17", "text": "。"}, {"type": "subtitle", "time": 3859.349, "timestamp": "01:04:19", "text": "ああ、私は"}]
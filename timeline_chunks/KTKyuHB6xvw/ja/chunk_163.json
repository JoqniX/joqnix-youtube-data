[{"type": "subtitle", "time": 9790.71, "timestamp": "02:43:10", "text": "進歩。 ゆっくりと、ゆっくりと"}, {"type": "subtitle", "time": 9794.79, "timestamp": "02:43:14", "text": "受け入れていく必要がある。 必要なのは、これを10時間続けることだけです"}, {"type": "subtitle", "time": 9810.55, "timestamp": "02:43:30", "text": "あなたのために。 ミマス。"}, {"type": "subtitle", "time": 9814.389, "timestamp": "02:43:34", "text": "わかりました、変更してください。"}, {"type": "subtitle", "time": 9831.11, "timestamp": "02:43:51", "text": "ミマスが、見て、"}, {"type": "subtitle", "time": 9835.269, "timestamp": "02:43:55", "text": "ミマスがどんな感じなのか考え、"}, {"type": "subtitle", "time": 9838.55, "timestamp": "02:43:58", "text": "変な感じがして、"}]
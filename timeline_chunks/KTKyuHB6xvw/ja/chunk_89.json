[{"type": "subtitle", "time": 5345.91, "timestamp": "01:29:05", "text": "急ぐ必要はありません。"}, {"type": "subtitle", "time": 5347.91, "timestamp": "01:29:07", "text": "ええ、急ぐ必要はありませんよ。 うん、"}, {"type": "subtitle", "time": 5350.87, "timestamp": "01:29:10", "text": "気楽に過ごせるよ。"}, {"type": "subtitle", "time": 5353.91, "timestamp": "01:29:13", "text": "暇な時はいつでも"}, {"type": "subtitle", "time": 5372.47, "timestamp": "01:29:32", "text": "正直なところ、以前起こったように、食料などの機能的な拠点を作り、"}, {"type": "subtitle", "time": 5378.229, "timestamp": "01:29:38", "text": "すべてが自動化されるようにしたいのです"}, {"type": "subtitle", "time": 5380.629, "timestamp": "01:29:40", "text": "。 私も"}, {"type": "subtitle", "time": 5383.99, "timestamp": "01:29:43", "text": "参加しました。 友達はみんな"}, {"type": "subtitle", "time": 5386.55, "timestamp": "01:29:46", "text": "弱っていて、骨折もしていて、"}, {"type": "subtitle", "time": 5389.392, "timestamp": "01:29:49", "text": "目が充血している。"}, {"type": "subtitle", "time": 5390.39, "timestamp": "01:29:50", "text": "[笑い]"}, {"type": "subtitle", "time": 5391.99, "timestamp": "01:29:51", "text": "ああ、それは嫌だな"}, {"type": "subtitle", "time": 5394.709, "timestamp": "01:29:54", "text": "。 だから"}]
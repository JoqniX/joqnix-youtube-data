[{"type": "subtitle", "time": 10149.99, "timestamp": "02:49:09", "text": "私が時々仕事で手に入れたこれらのハイレは使えません"}, {"type": "subtitle", "time": 10173.99, "timestamp": "02:49:33", "text": "私の背景音が聞こえていないことを願っています。   そうなんですか"}, {"type": "subtitle", "time": 10177.11, "timestamp": "02:49:37", "text": "？"}, {"type": "subtitle", "time": 10179.03, "timestamp": "02:49:39", "text": "バイバイ。 待って、あなたはまだ"}, {"type": "subtitle", "time": 10182.309, "timestamp": "02:49:42", "text": "ここにいますか？ あなたが去ったことを願っています。 ああ、あなたはここにいたんですね。   はい"}, {"type": "subtitle", "time": 10183.91, "timestamp": "02:49:43", "text": "、では、"}, {"type": "subtitle", "time": 10198.389, "timestamp": "02:49:58", "text": "そして火の文法。 でもそうですね、"}]
[{"type": "subtitle", "time": 3783.349, "timestamp": "01:03:03", "text": "プロゲーマーの技ってあるのかな？"}, {"type": "subtitle", "time": 3786.71, "timestamp": "01:03:06", "text": "私はそのことに気付きましたが、基本的なリソースの確保は"}, {"type": "subtitle", "time": 3813.19, "timestamp": "01:03:33", "text": "難しく、苦痛です。"}, {"type": "subtitle", "time": 3815.91, "timestamp": "01:03:35", "text": "石を手に入れなきゃ [叫び声]"}, {"type": "subtitle", "time": 3826.23, "timestamp": "01:03:46", "text": "ああ神様、私の羊が私の鶏を殺した。"}, {"type": "subtitle", "time": 3834.549, "timestamp": "01:03:54", "text": "、そういうこともあるよね。 私は強力なものを持っています"}]
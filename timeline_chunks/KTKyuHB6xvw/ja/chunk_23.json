[{"type": "subtitle", "time": 1380.95, "timestamp": "00:23:00", "text": "武器が弾薬の種類を切り替える。 わかった。"}, {"type": "subtitle", "time": 1392.31, "timestamp": "00:23:12", "text": "この件に関わっていないに違いない。 彼は怠け者だ。"}, {"type": "subtitle", "time": 1395.59, "timestamp": "00:23:15", "text": "ああ、彼は骨折したんだ。 ああ、それは私がすべきことなのか。ああ、なんてことだ。"}, {"type": "subtitle", "time": 1406.95, "timestamp": "00:23:26", "text": "ほら、私、お金がないの。 わかった。 ビジネスなどを始めるとき"}, {"type": "subtitle", "time": 1408.39, "timestamp": "00:23:28", "text": "、"}, {"type": "subtitle", "time": 1411.11, "timestamp": "00:23:31", "text": "お金やその他諸々が揃っていない場合は、"}, {"type": "subtitle", "time": 1413.029, "timestamp": "00:23:33", "text": "従業"}, {"type": "subtitle", "time": 1415.43, "timestamp": "00:23:35", "text": "員やその他すべてにおいて、調整したり対応したりする必要があります。"}, {"type": "subtitle", "time": 1417.11, "timestamp": "00:23:37", "text": "うん。"}, {"type": "subtitle", "time": 1419.59, "timestamp": "00:23:39", "text": "十分な資源と、まあ、"}, {"type": "subtitle", "time": 1421.11, "timestamp": "00:23:41", "text": "いい"}, {"type": "subtitle", "time": 1424.39, "timestamp": "00:23:44", "text": "もの資源が揃ったら、"}, {"type": "subtitle", "time": 1429.11, "timestamp": "00:23:49", "text": "スタッフに贅沢な生活をさせてあげられるようになる。"}, {"type": "subtitle", "time": 1432.47, "timestamp": "00:23:52", "text": "温泉に入れてあげれば、彼らは"}, {"type": "subtitle", "time": 1436.71, "timestamp": "00:23:56", "text": "そこから正気度を高めることができる。"}]
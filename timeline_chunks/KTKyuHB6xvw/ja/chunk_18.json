[{"type": "subtitle", "time": 1086.15, "timestamp": "00:18:06", "text": "私は逃げ出すつもりだ。   えっと"}, {"type": "subtitle", "time": 1090.789, "timestamp": "00:18:10", "text": "、待って。 あなたは今、どこにいますか？"}, {"type": "subtitle", "time": 1093.19, "timestamp": "00:18:13", "text": "私はとても遠く離れています。"}, {"type": "subtitle", "time": 1094.789, "timestamp": "00:18:14", "text": "ああ、あなたは遠くにいるんですね。 わかった。 わかった。"}, {"type": "subtitle", "time": 1102.39, "timestamp": "00:18:22", "text": "。 心配しないで。 私はただ"}, {"type": "subtitle", "time": 1104.71, "timestamp": "00:18:24", "text": "探検しに来ただけです。"}, {"type": "subtitle", "time": 1106.23, "timestamp": "00:18:26", "text": "ガッチャ。"}, {"type": "subtitle", "time": 1110.71, "timestamp": "00:18:30", "text": "拠点をここから移転する必要がある。"}, {"type": "subtitle", "time": 1115.029, "timestamp": "00:18:35", "text": "もしくは、吊り下げ式の土台のようなものを作ればいい"}, {"type": "subtitle", "time": 1119.669, "timestamp": "00:18:39", "text": "。"}, {"type": "subtitle", "time": 1121.99, "timestamp": "00:18:41", "text": "それも悪くないかもしれないね。"}, {"type": "subtitle", "time": 1124.39, "timestamp": "00:18:44", "text": "それはスポーン地点に近いでしょう。 それが"}, {"type": "subtitle", "time": 1139.43, "timestamp": "00:18:59", "text": "彼らに餌を与えなければならない。 でも、"}]
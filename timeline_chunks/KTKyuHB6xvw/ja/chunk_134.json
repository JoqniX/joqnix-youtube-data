[{"type": "subtitle", "time": 8041.99, "timestamp": "02:14:01", "text": "うん。"}, {"type": "subtitle", "time": 8043.99, "timestamp": "02:14:03", "text": "そして楽園"}, {"type": "subtitle", "time": 8046.31, "timestamp": "02:14:06", "text": "とパラド。"}, {"type": "subtitle", "time": 8048.067, "timestamp": "02:14:08", "text": "しかし、こいつらは腹ペコだ。 私には"}, {"type": "subtitle", "time": 8049.35, "timestamp": "02:14:09", "text": "何もないよ（笑）。 他にもあるんです"}, {"type": "subtitle", "time": 8058.229, "timestamp": "02:14:18", "text": "。 彼らは大丈夫です。 そうすれば、Shiftキーを押しながら"}, {"type": "subtitle", "time": 8064.069, "timestamp": "02:14:24", "text": "右クリックする操作が半分できます。 わかった。  30. ああ、"}, {"type": "subtitle", "time": 8069.109, "timestamp": "02:14:29", "text": "彼らは本当にたくさん食べている。 ああ、そうかい。"}]
[{"type": "subtitle", "time": 424.71, "timestamp": "00:07:04", "text": "。"}, {"type": "subtitle", "time": 427.67, "timestamp": "00:07:07", "text": "うん、今日は君が出場するよ。 仕事を見つけなさい。 どうだった"}, {"type": "subtitle", "time": 430.07, "timestamp": "00:07:10", "text": "？"}, {"type": "subtitle", "time": 433.99, "timestamp": "00:07:13", "text": "どうだった？ 権力はどうだったか？"}, {"type": "subtitle", "time": 437.749, "timestamp": "00:07:17", "text": "うん、Pってすごく楽しいよね。"}, {"type": "subtitle", "time": 440.71, "timestamp": "00:07:20", "text": "以前は気づきませんでした。 でも、そうですね、"}, {"type": "subtitle", "time": 443.83, "timestamp": "00:07:23", "text": "普段は新しいゲームに慣れるのが"}, {"type": "subtitle", "time": 447.909, "timestamp": "00:07:27", "text": "難しいのですが、これは"}, {"type": "subtitle", "time": 451.189, "timestamp": "00:07:31", "text": "以前"}, {"type": "subtitle", "time": 454.469, "timestamp": "00:07:34", "text": "一緒にプレイしたゲームと少し似ています。"}, {"type": "subtitle", "time": 456.07, "timestamp": "00:07:36", "text": "はい。 はい。 はい。"}, {"type": "subtitle", "time": 458.71, "timestamp": "00:07:38", "text": "だからこそ、私はとても楽しんでいるし、"}, {"type": "subtitle", "time": 462.15, "timestamp": "00:07:42", "text": "順応も容易なんです。"}, {"type": "subtitle", "time": 465.67, "timestamp": "00:07:45", "text": "本当に楽しいです。 それは、私が今"}, {"type": "subtitle", "time": 469.029, "timestamp": "00:07:49", "text": "開けたものを思い出させます。"}, {"type": "subtitle", "time": 471.909, "timestamp": "00:07:51", "text": "ああ、あなたはここにいたんですね。 こんにちは。"}, {"type": "subtitle", "time": 475.83, "timestamp": "00:07:55", "text": "こんにちは。 おお。 待って。 どうやって？ ああ、あなたはいつもの"}, {"type": "subtitle", "time": 478.23, "timestamp": "00:07:58", "text": "服装をしているんですね。 わかった。   わかった"}]
[{"type": "subtitle", "time": 1261.11, "timestamp": "00:21:01", "text": "私はデュアルモニターを使っています。"}, {"type": "subtitle", "time": 1264.71, "timestamp": "00:21:04", "text": "ああ、あなたはデュアルモニターを使っているんですね。"}, {"type": "subtitle", "time": 1269.11, "timestamp": "00:21:09", "text": "トリプルモニターの設定を台無しにしてしまった。"}, {"type": "subtitle", "time": 1272.87, "timestamp": "00:21:12", "text": "家族が"}, {"type": "subtitle", "time": 1280.39, "timestamp": "00:21:20", "text": "おそらく、どちらか一方が"}, {"type": "subtitle", "time": 1285.669, "timestamp": "00:21:25", "text": "ひどい状態だったため、うまく機能しなかったのでしょう。"}, {"type": "subtitle", "time": 1300.149, "timestamp": "00:21:40", "text": "、"}, {"type": "subtitle", "time": 1302.549, "timestamp": "00:21:42", "text": "操作できません。 この幽霊の"}, {"type": "subtitle", "time": 1314.39, "timestamp": "00:21:54", "text": "盾のために。"}, {"type": "subtitle", "time": 1316.87, "timestamp": "00:21:56", "text": "私は普通の盾を所持していますが、まだそれを持っていません"}]
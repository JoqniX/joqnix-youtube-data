[{"type": "subtitle", "time": 197.03, "timestamp": "00:03:17", "text": "こんにちは、みんな。 ようこそ、ようこそ。   えーっと、"}, {"type": "subtitle", "time": 201.50900000000001, "timestamp": "00:03:21", "text": "今日はパル"}, {"type": "subtitle", "time": 203.75, "timestamp": "00:03:23", "text": "ワールドの配信をします。"}, {"type": "subtitle", "time": 206.79, "timestamp": "00:03:26", "text": "はい、友達との配信をします。"}, {"type": "subtitle", "time": 213.03, "timestamp": "00:03:33", "text": "数人の友人のために作った新しいサーバーでプレイする予定です。 私は"}, {"type": "subtitle", "time": 217.19, "timestamp": "00:03:37", "text": "そこで、えーと友達と遊んでいるような感じになるでしょう。 ということで、"}, {"type": "subtitle", "time": 225.35, "timestamp": "00:03:45", "text": "私の配信でご覧になったパレットシリーズの以前のエピソードとは似たようなものにはならないと思います。"}, {"type": "subtitle", "time": 228.07, "timestamp": "00:03:48", "text": "つまり、ゼロからのスタートになるということだ。"}, {"type": "subtitle", "time": 230.47, "timestamp": "00:03:50", "text": "少しはプレイしたと思う。 だから、"}, {"type": "subtitle", "time": 234.55, "timestamp": "00:03:54", "text": "今日は時間を無駄にしたくなかったんです。 ちょっと遊んでみました。"}, {"type": "subtitle", "time": 237.35, "timestamp": "00:03:57", "text": "そこから始めて、気楽に"}]
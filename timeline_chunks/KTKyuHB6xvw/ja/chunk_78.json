[{"type": "subtitle", "time": 4680.95, "timestamp": "01:18:00", "text": "ああ、これはフォートナイトじゃないよ。"}, {"type": "subtitle", "time": 4684.31, "timestamp": "01:18:04", "text": "ボタンをクリックするだけで"}, {"type": "subtitle", "time": 4687.11, "timestamp": "01:18:07", "text": "構築が継続されるわけではありません。"}, {"type": "subtitle", "time": 4689.11, "timestamp": "01:18:09", "text": "つまり、そうしたいとは思うのですが、クリック、クリック、クリックではなく、ちょっと"}, {"type": "subtitle", "time": 4733.51, "timestamp": "01:18:53", "text": "何でも。"}]
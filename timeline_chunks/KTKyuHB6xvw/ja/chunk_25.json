[{"type": "subtitle", "time": 1531.029, "timestamp": "00:25:31", "text": "時々、"}, {"type": "subtitle", "time": 1534.63, "timestamp": "00:25:34", "text": "インタラクティブマップを使いたいと思うことがある。"}, {"type": "subtitle", "time": 1537.669, "timestamp": "00:25:37", "text": "でも、もしこれがどこでも見つかれば、"}, {"type": "subtitle", "time": 1553.99, "timestamp": "00:25:53", "text": "歩き回れば回るほど、ランダムに宝"}, {"type": "subtitle", "time": 1559.669, "timestamp": "00:25:59", "text": "箱が見つかるということです。 つまり、それらは良い"}]
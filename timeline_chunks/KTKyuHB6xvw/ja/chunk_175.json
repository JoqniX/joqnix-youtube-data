[{"type": "subtitle", "time": 10511.67, "timestamp": "02:55:11", "text": "ああ、もう。"}, {"type": "subtitle", "time": 10517.51, "timestamp": "02:55:17", "text": "これらのアイテムはどうやってアンロックするのですか？"}, {"type": "subtitle", "time": 10520.63, "timestamp": "02:55:20", "text": "うん。 温泉、これとこれ。 では、"}, {"type": "subtitle", "time": 10538.95, "timestamp": "02:55:38", "text": "待って、"}, {"type": "subtitle", "time": 10543.59, "timestamp": "02:55:43", "text": "もし友達に会ったら、私も会えるよ。"}, {"type": "subtitle", "time": 10557.83, "timestamp": "02:55:57", "text": "だから、君が発見した仲間は"}]
[{"type": "subtitle", "time": 1635.99, "timestamp": "00:27:15", "text": "ああ、なんてことだ、ジャンプすらできない。"}, {"type": "subtitle", "time": 1640.789, "timestamp": "00:27:20", "text": "ラグがひどすぎる。 ええと、そうですね。"}, {"type": "subtitle", "time": 1649.43, "timestamp": "00:27:29", "text": "日本はインドからそんなに遠いのですか？"}, {"type": "subtitle", "time": 1652.39, "timestamp": "00:27:32", "text": "シンガポールは大抵"}, {"type": "subtitle", "time": 1667.19, "timestamp": "00:27:47", "text": "私はこれを拠点として維持したい。"}]
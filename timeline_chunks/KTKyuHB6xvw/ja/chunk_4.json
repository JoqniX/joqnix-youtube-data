[{"type": "subtitle", "time": 242.149, "timestamp": "00:04:02", "text": "プレイしていきましょう。 それで、今日は"}, {"type": "subtitle", "time": 244.789, "timestamp": "00:04:04", "text": "友達がいます。"}, {"type": "subtitle", "time": 250.39, "timestamp": "00:04:10", "text": "えーっと[音楽]"}, {"type": "subtitle", "time": 273.51, "timestamp": "00:04:33", "text": "私たち、知り合ってからどれくらい経つんだろう？"}, {"type": "subtitle", "time": 273.99, "timestamp": "00:04:33", "text": "7年。"}, {"type": "subtitle", "time": 275.67, "timestamp": "00:04:35", "text": "僕たちはお互いを知っています。ええ、[音楽] 僕たちはもう"}, {"type": "subtitle", "time": 278.71, "timestamp": "00:04:38", "text": "7年間お互いを知っています。"}, {"type": "subtitle", "time": 282.79, "timestamp": "00:04:42", "text": "もうずいぶん長い時間が経ちましたね。 ああ、あの"}, {"type": "subtitle", "time": 292.95, "timestamp": "00:04:52", "text": "男だ。 うん。   わかった"}]
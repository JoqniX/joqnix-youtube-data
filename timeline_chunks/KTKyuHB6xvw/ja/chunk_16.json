[{"type": "subtitle", "time": 962.389, "timestamp": "00:16:02", "text": "彼らはこの世界であなたを助けてくれる。 ええと、あなたは"}, {"type": "subtitle", "time": 969.509, "timestamp": "00:16:09", "text": "ただのパートナーです、ある意味では。"}, {"type": "subtitle", "time": 975.99, "timestamp": "00:16:15", "text": "ああ、食料のために仲間を殺すこともできるよ。まあ、言うまでもないことだけどね"}, {"type": "subtitle", "time": 978.23, "timestamp": "00:16:18", "text": "。"}, {"type": "subtitle", "time": 980.389, "timestamp": "00:16:20", "text": "いいえ、していません。   まだですか"}, {"type": "subtitle", "time": 982.47, "timestamp": "00:16:22", "text": "？"}, {"type": "subtitle", "time": 984.31, "timestamp": "00:16:24", "text": "いいえ、していません。"}, {"type": "subtitle", "time": 1001.11, "timestamp": "00:16:41", "text": "配信は面白そうですね"}, {"type": "subtitle", "time": 1005.35, "timestamp": "00:16:45", "text": "。 うん。 それで、私は"}]
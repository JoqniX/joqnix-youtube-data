[{"type": "subtitle", "time": 4899.59, "timestamp": "01:21:39", "text": "私たちはどうすべきでしょうか？ 彼らは引き続き支持"}, {"type": "subtitle", "time": 4901.91, "timestamp": "01:21:41", "text": "基盤の強化に注力するだろう。"}, {"type": "subtitle", "time": 4911.43, "timestamp": "01:21:51", "text": "一緒に探検できたらいいんだけど、えっと、"}, {"type": "subtitle", "time": 4915.189, "timestamp": "01:21:55", "text": "今はレベルアップしないといけないんだ。 私は今はまだ"}, {"type": "subtitle", "time": 4918.47, "timestamp": "01:21:58", "text": "初心者みたいなものです。"}]
[{"type": "subtitle", "time": 9971.67, "timestamp": "02:46:11", "text": "今はスタミナと表示されています。"}, {"type": "subtitle", "time": 9974.55, "timestamp": "02:46:14", "text": "私の頭の中では、"}, {"type": "subtitle", "time": 9981.67, "timestamp": "02:46:21", "text": "私が使っているこのスタミナガーナのようなものでした。 何てことだ。 ねえ、"}, {"type": "subtitle", "time": 9984.63, "timestamp": "02:46:24", "text": "私に何が起こったの？"}, {"type": "subtitle", "time": 9986.55, "timestamp": "02:46:26", "text": "どこからともなくこの不必要な文法を持ち出してきたのでしょうか"}]
[{"type": "subtitle", "time": 9481.27, "timestamp": "02:38:01", "text": "それが今の"}, {"type": "subtitle", "time": 9483.91, "timestamp": "02:38:03", "text": "私に一番足りないものだと思うのは"}, {"type": "subtitle", "time": 9497.99, "timestamp": "02:38:17", "text": "。"}, {"type": "subtitle", "time": 9500.87, "timestamp": "02:38:20", "text": "どうにかして配信する時間を見つけられるんです。"}, {"type": "subtitle", "time": 9513.349, "timestamp": "02:38:33", "text": "これをこの岩のように頑丈なものの間に挟んでもいいですか"}, {"type": "subtitle", "time": 9516.309, "timestamp": "02:38:36", "text": "？"}, {"type": "subtitle", "time": 9518.95, "timestamp": "02:38:38", "text": "いいえ、違います。"}, {"type": "subtitle", "time": 9521.429, "timestamp": "02:38:41", "text": "ここに置いてもいいですよ。 必要なのは、"}, {"type": "subtitle", "time": 9523.27, "timestamp": "02:38:43", "text": "自分を抑え、本来使うべきものを使わないようにする、磨き上げの時間だけです"}]
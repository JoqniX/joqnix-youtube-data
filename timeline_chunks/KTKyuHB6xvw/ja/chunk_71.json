[{"type": "subtitle", "time": 4273.75, "timestamp": "01:11:13", "text": "ああ、それはいいですね。 それだと、"}, {"type": "subtitle", "time": 4276.709, "timestamp": "01:11:16", "text": "これを拾うことができないし、"}, {"type": "subtitle", "time": 4279.51, "timestamp": "01:11:19", "text": "これはとても"}, {"type": "subtitle", "time": 4285.75, "timestamp": "01:11:25", "text": "羊が2匹いる。 それらをいただきます"}, {"type": "subtitle", "time": 4294.874, "timestamp": "01:11:34", "text": "なぜ私の友人は今、戦っているのですか？"}, {"type": "subtitle", "time": 4295.99, "timestamp": "01:11:35", "text": "[叫び声]"}, {"type": "subtitle", "time": 4298.95, "timestamp": "01:11:38", "text": "お前は殺した。"}, {"type": "subtitle", "time": 4301.91, "timestamp": "01:11:41", "text": "殺してはいけない。"}, {"type": "subtitle", "time": 4305.99, "timestamp": "01:11:45", "text": "ラグを解消しないでください。"}]
[{"type": "subtitle", "time": 6420.39, "timestamp": "01:47:00", "text": "、ベッドがない。 あ、待って。 放してくれ"}, {"type": "subtitle", "time": 6445.75, "timestamp": "01:47:25", "text": "。 睡眠中。"}, {"type": "subtitle", "time": 6447.43, "timestamp": "01:47:27", "text": "屋根のないベッドは使えません。 冗談でしょう"}, {"type": "subtitle", "time": 6449.91, "timestamp": "01:47:29", "text": "？ 本当に冗談でしょう"}, {"type": "subtitle", "time": 6466.95, "timestamp": "01:47:46", "text": "ああ、もちろんです。 もちろん。 待って、待って、待って、待って、"}, {"type": "subtitle", "time": 6470.79, "timestamp": "01:47:50", "text": "待って。 私は作物を栽培できます。"}, {"type": "subtitle", "time": 6473.83, "timestamp": "01:47:53", "text": "一"}, {"type": "subtitle", "time": 6475.75, "timestamp": "01:47:55", "text": "人が寝ると全員が寝るような仕組みはありますか"}, {"type": "subtitle", "time": 6477.27, "timestamp": "01:47:57", "text": "？   わからない"}]
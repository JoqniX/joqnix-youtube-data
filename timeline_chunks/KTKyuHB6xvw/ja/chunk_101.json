[{"type": "subtitle", "time": 6062.47, "timestamp": "01:41:02", "text": "どこにいるの？"}, {"type": "subtitle", "time": 6064.47, "timestamp": "01:41:04", "text": "私は文字通り基地の中にいます。"}, {"type": "subtitle", "time": 6066.79, "timestamp": "01:41:06", "text": "テレポート地点に戻ります。 私は戻ります"}, {"type": "subtitle", "time": 6080.07, "timestamp": "01:41:20", "text": "ああ、それもあるんですね。"}, {"type": "subtitle", "time": 6084.55, "timestamp": "01:41:24", "text": "うん。 それはあなたの友達ですか、それとも"}, {"type": "subtitle", "time": 6087.03, "timestamp": "01:41:27", "text": "鹿の友達ですか？ ああ、それはあなただったんですね。 わかった。"}, {"type": "subtitle", "time": 6111.91, "timestamp": "01:41:51", "text": "けど、まあ大丈夫。 パイオンをお持ちですか？"}, {"type": "subtitle", "time": 6115.35, "timestamp": "01:41:55", "text": "ああ、そうだね。 少しはそうします"}]
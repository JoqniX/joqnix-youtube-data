[{"type": "subtitle", "time": 3919.19, "timestamp": "01:05:19", "text": "急いで修理装置を作って、"}, {"type": "subtitle", "time": 3925.829, "timestamp": "01:05:25", "text": "自分の持ち物を修理して、"}, {"type": "subtitle", "time": 3937.75, "timestamp": "01:05:37", "text": "上に上がってきて、もっと多くの"}, {"type": "subtitle", "time": 3942.549, "timestamp": "01:05:42", "text": "ものを私に持ってきてくれるようなものを作る必要がある"}, {"type": "subtitle", "time": 3949.67, "timestamp": "01:05:49", "text": "それは石で、つまり今は石の農場があるんです"}, {"type": "subtitle", "time": 3951.75, "timestamp": "01:05:51", "text": "。 だから、石材採掘ができる仲間を見つける必要があるんだ"}, {"type": "subtitle", "time": 3954.47, "timestamp": "01:05:54", "text": "。"}]
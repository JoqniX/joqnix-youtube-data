[{"type": "subtitle", "time": 614.069, "timestamp": "00:10:14", "text": "ああ、この羊の正気度は"}, {"type": "subtitle", "time": 619.03, "timestamp": "00:10:19", "text": "とても低い。 とても申し訳ない気持ちです。   何てことだ"}, {"type": "subtitle", "time": 626.23, "timestamp": "00:10:26", "text": "とても落ち込んで悲しいので、"}, {"type": "subtitle", "time": 629.269, "timestamp": "00:10:29", "text": "私にとってはそれがうまくいかなければならないんです。   何てことだ"}, {"type": "subtitle", "time": 631.11, "timestamp": "00:10:31", "text": "。"}, {"type": "subtitle", "time": 633.99, "timestamp": "00:10:33", "text": "彼らに食べ物を与えてください。"}, {"type": "subtitle", "time": 653.19, "timestamp": "00:10:53", "text": "ボールが必要だ。 私は全てが必要だ。   懐中"}, {"type": "chat", "time": 653.202, "timestamp": "00:10:53", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/egJ1XufTKYfegwOo57ewAg"}, {"type": "subtitle", "time": 655.67, "timestamp": "00:10:55", "text": "電灯を作らなければならない。 これから"}, {"type": "subtitle", "time": 658.15, "timestamp": "00:10:58", "text": "寒くなるでしょう。"}]
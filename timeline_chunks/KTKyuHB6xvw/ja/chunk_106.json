[{"type": "subtitle", "time": 6361.109, "timestamp": "01:46:01", "text": "私はこれを、まるで"}, {"type": "subtitle", "time": 6364.709, "timestamp": "01:46:04", "text": "ソロソロワールドでプレイしているかのようにプレイしています。"}, {"type": "subtitle", "time": 6366.39, "timestamp": "01:46:06", "text": "うん。"}, {"type": "subtitle", "time": 6368.709, "timestamp": "01:46:08", "text": "少し手伝っていただけますか？"}, {"type": "subtitle", "time": 6373.189, "timestamp": "01:46:13", "text": "もしよろしければ、お手伝いいただけると嬉しいです"}, {"type": "subtitle", "time": 6374.709, "timestamp": "01:46:14", "text": "。   ああ"}, {"type": "subtitle", "time": 6380.39, "timestamp": "01:46:20", "text": "、ラグってる。 一体どういうことだ？"}, {"type": "subtitle", "time": 6383.35, "timestamp": "01:46:23", "text": "見えますか？ ああ、"}, {"type": "subtitle", "time": 6385.27, "timestamp": "01:46:25", "text": "見てるよ、"}, {"type": "subtitle", "time": 6407.03, "timestamp": "01:46:47", "text": "パラジウム"}, {"type": "subtitle", "time": 6416.87, "timestamp": "01:46:56", "text": "ああ、わかりました。 どれくらい寝ていいですか？ ああ"}]
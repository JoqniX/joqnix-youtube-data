[{"type": "subtitle", "time": 3964.069, "timestamp": "01:06:04", "text": "しかし、それが自律的に給餌でき、"}, {"type": "subtitle", "time": 3968.47, "timestamp": "01:06:08", "text": "自動化できることを確認しなければならない。"}, {"type": "subtitle", "time": 3970.15, "timestamp": "01:06:10", "text": "うん。"}, {"type": "subtitle", "time": 3972.63, "timestamp": "01:06:12", "text": "こういうゲームについて考えてみると、ハマって"}, {"type": "subtitle", "time": 3976.15, "timestamp": "01:06:16", "text": "アイデアが浮かんだものの、"}, {"type": "subtitle", "time": 3978.23, "timestamp": "01:06:18", "text": "どうすればいいのか分からない場合、"}, {"type": "subtitle", "time": 3980.71, "timestamp": "01:06:20", "text": "ガイド動画を見始めて、それから"}, {"type": "subtitle", "time": 3983.589, "timestamp": "01:06:23", "text": "そのアイデアを実行に移していくことになるんです。 まるで"}, {"type": "subtitle", "time": 3986.71, "timestamp": "01:06:26", "text": "マインクラフトみたいだ。 そういう感覚ってすごく"}, {"type": "subtitle", "time": 3988.23, "timestamp": "01:06:28", "text": "楽しいよね。"}, {"type": "subtitle", "time": 3997.109, "timestamp": "01:06:37", "text": "マインクラフトのレッドストーンを使った自動化とか、そういうの全部。   「"}]
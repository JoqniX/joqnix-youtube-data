[{"type": "subtitle", "time": 6855.109, "timestamp": "01:54:15", "text": "もし皆さんが他の人よりも高い、つまり低い"}, {"type": "subtitle", "time": 6857.669, "timestamp": "01:54:17", "text": "ビンを持っているなら、それは問題ありません。 私は"}, {"type": "subtitle", "time": 6861.43, "timestamp": "01:54:21", "text": "別の国にいるので、"}, {"type": "subtitle", "time": 6895.03, "timestamp": "01:54:55", "text": "ベイビー、遅れています。 私は"}, {"type": "subtitle", "time": 6897.43, "timestamp": "01:54:57", "text": "溺れています。"}]
[{"type": "subtitle", "time": 6121.669, "timestamp": "01:42:01", "text": "あるいは"}, {"type": "subtitle", "time": 6126.55, "timestamp": "01:42:06", "text": "私に少し分けてくれると思っていた。 わかった。"}, {"type": "subtitle", "time": 6129.189, "timestamp": "01:42:09", "text": "ビルドに必要なものが2つ足りないことは認めます。   わかった"}, {"type": "subtitle", "time": 6131.83, "timestamp": "01:42:11", "text": "。  10点あげよう。ちょっと立ち寄っただけだよ"}, {"type": "subtitle", "time": 6139.189, "timestamp": "01:42:19", "text": "。 どこにいるの？"}, {"type": "subtitle", "time": 6142.47, "timestamp": "01:42:22", "text": "私はテレポート地点にいます。"}, {"type": "subtitle", "time": 6149.109, "timestamp": "01:42:29", "text": "こんにちは。   来て"}]
[{"type": "subtitle", "time": 9122.309, "timestamp": "02:32:02", "text": "待って、私はさまよっていたんだ。 忘れた。 でも、そろそろ"}, {"type": "subtitle", "time": 9124.07, "timestamp": "02:32:04", "text": "何かをしないといけない。"}, {"type": "subtitle", "time": 9135.91, "timestamp": "02:32:15", "text": "毒炎"}, {"type": "subtitle", "time": 9137.83, "timestamp": "02:32:17", "text": "脂肪は"}, {"type": "subtitle", "time": 9171.03, "timestamp": "02:32:51", "text": "。"}, {"type": "subtitle", "time": 9172.55, "timestamp": "02:32:52", "text": "私はあなたの心の中で日本語で考え、話していました"}]
[{"type": "subtitle", "time": 2790.23, "timestamp": "00:46:30", "text": "協力プレイはこれで終わりだ。"}, {"type": "subtitle", "time": 2793.19, "timestamp": "00:46:33", "text": "ああ、私たち二人とも同じコメントを読んだんですね。"}, {"type": "subtitle", "time": 2805.99, "timestamp": "00:46:45", "text": "夜が寒いときは、"}, {"type": "subtitle", "time": 2809.51, "timestamp": "00:46:49", "text": "体力がより早く消耗してしまうでしょう。"}, {"type": "subtitle", "time": 2810.79, "timestamp": "00:46:50", "text": "うん。"}, {"type": "subtitle", "time": 2813.19, "timestamp": "00:46:53", "text": "また、お腹が空いていた時も。"}, {"type": "subtitle", "time": 2814.87, "timestamp": "00:46:54", "text": "ああ、"}]
[{"type": "subtitle", "time": 10201.349, "timestamp": "02:50:01", "text": "今日本語で話すときは、"}, {"type": "subtitle", "time": 10204.15, "timestamp": "02:50:04", "text": "レンチを渡すときは、"}, {"type": "subtitle", "time": 10207.51, "timestamp": "02:50:07", "text": "N5レベルの日本語を使っていることを確認してください。 さて、私も自分の間違いを正そうと努めます"}, {"type": "subtitle", "time": 10219.51, "timestamp": "02:50:19", "text": "そこでは、"}, {"type": "subtitle", "time": 10230.63, "timestamp": "02:50:30", "text": "友人の声が聞こえるが、"}, {"type": "subtitle", "time": 10232.79, "timestamp": "02:50:32", "text": "大きな声ではない。 うん。"}, {"type": "subtitle", "time": 10246.469, "timestamp": "02:50:46", "text": "えっと、"}, {"type": "subtitle", "time": 10249.429, "timestamp": "02:50:49", "text": "マイクのためにショーを。 うん。 私のマイクのために。"}]
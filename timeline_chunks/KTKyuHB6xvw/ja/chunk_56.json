[{"type": "subtitle", "time": 3373.829, "timestamp": "00:56:13", "text": "、戻ってきました。"}, {"type": "subtitle", "time": 3381.75, "timestamp": "00:56:21", "text": "兄弟。 石を手に入れるためだけに、一番上まで登らなければならない"}, {"type": "subtitle", "time": 3390.15, "timestamp": "00:56:30", "text": "なぜ私は起きているのだろう？ なぜ私はあんな場所に自分の建物を建てたのだろうか"}, {"type": "subtitle", "time": 3398.789, "timestamp": "00:56:38", "text": "よし、基本となる部分を構築しよう。"}, {"type": "subtitle", "time": 3400.789, "timestamp": "00:56:40", "text": "石の農場を作らなきゃいけない気がする"}, {"type": "subtitle", "time": 3418.95, "timestamp": "00:56:58", "text": "あなたの基地が見えました。"}]
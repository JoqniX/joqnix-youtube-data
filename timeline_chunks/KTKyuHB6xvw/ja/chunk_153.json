[{"type": "subtitle", "time": 9182.87, "timestamp": "02:33:02", "text": "努力しているつもりです"}, {"type": "subtitle", "time": 9184.95, "timestamp": "02:33:04", "text": "。"}, {"type": "subtitle", "time": 9195.27, "timestamp": "02:33:15", "text": "今日起こったことを話そうとしたら、ちょっと、えーと、私には"}, {"type": "subtitle", "time": 9198.389, "timestamp": "02:33:18", "text": "語彙力が本当に足りないんです。"}, {"type": "subtitle", "time": 9201.83, "timestamp": "02:33:21", "text": "今日のように最近私の自転車の"}, {"type": "subtitle", "time": 9205.59, "timestamp": "02:33:25", "text": "鍵が盗まれ、"}, {"type": "subtitle", "time": 9208.309, "timestamp": "02:33:28", "text": "鍵を切る方法もありませんでした。"}, {"type": "subtitle", "time": 9211.11, "timestamp": "02:33:31", "text": "手ノコを買おうとしたのですが、うまくいきませんでした。"}, {"type": "subtitle", "time": 9213.11, "timestamp": "02:33:33", "text": "自転車を学校までずっと引きずって戻らなきゃならなかった"}, {"type": "subtitle", "time": 9215.91, "timestamp": "02:33:35", "text": "。 幸いにも間に合いました。 私は"}, {"type": "subtitle", "time": 9217.91, "timestamp": "02:33:37", "text": "遅刻したわけではなく、"}, {"type": "subtitle", "time": 9221.11, "timestamp": "02:33:41", "text": "自転車を引きずっていたせいで"}, {"type": "subtitle", "time": 9227.27, "timestamp": "02:33:47", "text": "摩擦でタイヤが摩耗し、チューブが破裂してしまい、"}, {"type": "subtitle", "time": 9234.95, "timestamp": "02:33:54", "text": "修理に5,500円ほど払わなければならなくなりました。"}, {"type": "subtitle", "time": 9239.51, "timestamp": "02:33:59", "text": "そして、学校に着いたとき、息切れして"}]
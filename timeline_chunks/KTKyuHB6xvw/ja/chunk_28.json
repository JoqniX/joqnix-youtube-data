[{"type": "subtitle", "time": 1688.23, "timestamp": "00:28:08", "text": "以上基地を建設することはできません。 一体どういうことだ"}, {"type": "subtitle", "time": 1704.47, "timestamp": "00:28:24", "text": "何か手を打たないといけないな。"}, {"type": "subtitle", "time": 1721.51, "timestamp": "00:28:41", "text": "私は死にかけている。 私は死にかけている。 私は死にかけている。"}, {"type": "subtitle", "time": 1724.549, "timestamp": "00:28:44", "text": "いまだにわからない。"}, {"type": "subtitle", "time": 1727.35, "timestamp": "00:28:47", "text": "私は"}, {"type": "subtitle", "time": 1730.87, "timestamp": "00:28:50", "text": "ゼノベーターと戦っています。 ああ、わかりました"}]
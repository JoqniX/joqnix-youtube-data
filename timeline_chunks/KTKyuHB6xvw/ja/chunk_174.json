[{"type": "subtitle", "time": 10447.429, "timestamp": "02:54:07", "text": "よし、あと5分ある。 わかった、あと"}, {"type": "subtitle", "time": 10450.71, "timestamp": "02:54:10", "text": "5分でできるよ。 よし。   よーよーかい"}, {"type": "subtitle", "time": 10474.95, "timestamp": "02:54:34", "text": "、この番組は仲間たちがやるはずなんです"}, {"type": "subtitle", "time": 10477.99, "timestamp": "02:54:37", "text": "。"}, {"type": "subtitle", "time": 10479.429, "timestamp": "02:54:39", "text": "なぜ私はまだレベルが"}, {"type": "subtitle", "time": 10481.59, "timestamp": "02:54:41", "text": "低いように感じるのでしょうか？"}, {"type": "subtitle", "time": 10494.71, "timestamp": "02:54:54", "text": "アップグレードがここにあります、と書きますか。 はい、私はバカです。"}]
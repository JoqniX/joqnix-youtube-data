[{"type": "subtitle", "time": 1380.95, "timestamp": "00:23:00", "text": "武器切换弹药类型。 好的。"}, {"type": "subtitle", "time": 1392.31, "timestamp": "00:23:12", "text": "没参与这项工作。 他很懒。"}, {"type": "subtitle", "time": 1395.59, "timestamp": "00:23:15", "text": "哦，他骨折了。 哦，我"}, {"type": "subtitle", "time": 1396.23, "timestamp": "00:23:16", "text": "应该……"}, {"type": "subtitle", "time": 1406.95, "timestamp": "00:23:26", "text": "你看，我没钱了。 好的。 当你"}, {"type": "subtitle", "time": 1408.39, "timestamp": "00:23:28", "text": "创业或做其他事情的时候，如果你没有"}, {"type": "subtitle", "time": 1411.11, "timestamp": "00:23:31", "text": "钱，一切"}, {"type": "subtitle", "time": 1413.029, "timestamp": "00:23:33", "text": "都得调整，比如你的"}, {"type": "subtitle", "time": 1415.43, "timestamp": "00:23:35", "text": "员工等等。   是的"}, {"type": "subtitle", "time": 1417.11, "timestamp": "00:23:37", "text": "。"}, {"type": "subtitle", "time": 1419.59, "timestamp": "00:23:39", "text": "一旦我积累了足够的资源，而且是那种"}, {"type": "subtitle", "time": 1421.11, "timestamp": "00:23:41", "text": "好"}, {"type": "subtitle", "time": 1424.39, "timestamp": "00:23:44", "text": "东西，我就可以"}, {"type": "subtitle", "time": 1429.11, "timestamp": "00:23:49", "text": "让我的员工过上奢华的生活了。"}, {"type": "subtitle", "time": 1432.47, "timestamp": "00:23:52", "text": "可以给他们泡温泉，据说这样"}, {"type": "subtitle", "time": 1436.71, "timestamp": "00:23:56", "text": "可以提升他们的精神状态。"}]
[{"type": "subtitle", "time": 3841.029, "timestamp": "01:04:01", "text": "一些强大的东西一样强大的东西，是的。 来自远方的。"}, {"type": "subtitle", "time": 3843.99, "timestamp": "01:04:03", "text": "所以他们在"}, {"type": "subtitle", "time": 3847.43, "timestamp": "01:04:07", "text": "我动手之前杀了我的同伙。"}, {"type": "subtitle", "time": 3853.829, "timestamp": "01:04:13", "text": "哦，他们昏迷不醒。 好的。 他们"}, {"type": "subtitle", "time": 3855.829, "timestamp": "01:04:15", "text": "看起来不像已经死了。"}, {"type": "subtitle", "time": 3857.829, "timestamp": "01:04:17", "text": "死了，死了。"}, {"type": "subtitle", "time": 3859.349, "timestamp": "01:04:19", "text": "哦，"}]
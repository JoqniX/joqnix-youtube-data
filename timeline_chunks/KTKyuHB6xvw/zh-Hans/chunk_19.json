[{"type": "subtitle", "time": 1141.99, "timestamp": "00:19:01", "text": "知道该如何把食物"}, {"type": "subtitle", "time": 1143.83, "timestamp": "00:19:03", "text": "给我的朋友们。 他们就像……"}, {"type": "subtitle", "time": 1147.669, "timestamp": "00:19:07", "text": "你只要靠近他们就行了。 你"}, {"type": "subtitle", "time": 1151.11, "timestamp": "00:19:11", "text": "点击四，然后就可以喂食了。"}, {"type": "subtitle", "time": 1153.59, "timestamp": "00:19:13", "text": "他们都在睡觉。"}, {"type": "subtitle", "time": 1155.11, "timestamp": "00:19:15", "text": "哦，"}, {"type": "subtitle", "time": 1159.11, "timestamp": "00:19:19", "text": "他们又饿又"}, {"type": "subtitle", "time": 1165.51, "timestamp": "00:19:25", "text": "哦，是的，切割时会有一点延迟"}, {"type": "subtitle", "time": 1169.35, "timestamp": "00:19:29", "text": "。 不，只有当我和对方"}, {"type": "subtitle", "time": 1172.63, "timestamp": "00:19:32", "text": "互动完成的时候。"}, {"type": "subtitle", "time": 1175.75, "timestamp": "00:19:35", "text": "例如，当"}, {"type": "subtitle", "time": 1177.909, "timestamp": "00:19:37", "text": "我砍完树后，会"}, {"type": "subtitle", "time": 1180.87, "timestamp": "00:19:40", "text": "稍微耽搁一下。"}, {"type": "subtitle", "time": 1184.71, "timestamp": "00:19:44", "text": "所以我觉得这应该是服务器的"}, {"type": "subtitle", "time": 1191.669, "timestamp": "00:19:51", "text": "服务器主要是"}, {"type": "subtitle", "time": 1194.47, "timestamp": "00:19:54", "text": "印度服务器，所以"}, {"type": "subtitle", "time": 1199.99, "timestamp": "00:19:59", "text": "来自印度的玩家会很"}]
[{"type": "subtitle", "time": 9122.309, "timestamp": "02:32:02", "text": "等等，我一直在四处闲逛。 我忘了。 但"}, {"type": "subtitle", "time": 9124.07, "timestamp": "02:32:04", "text": "我现在应该做点什么了。"}, {"type": "subtitle", "time": 9135.91, "timestamp": "02:32:15", "text": "毒液火焰"}, {"type": "subtitle", "time": 9137.83, "timestamp": "02:32:17", "text": "脂肪"}, {"type": "subtitle", "time": 9140.15, "timestamp": "02:32:20", "text": "可能很难找到一个归宿"}, {"type": "subtitle", "time": 9171.03, "timestamp": "02:32:51", "text": "走吧。"}, {"type": "subtitle", "time": 9172.55, "timestamp": "02:32:52", "text": "我用日语在你的脑海里思考和说话"}]
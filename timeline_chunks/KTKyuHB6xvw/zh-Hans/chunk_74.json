[{"type": "subtitle", "time": 4440.87, "timestamp": "01:14:00", "text": "加入别人的世界，而他们已经有了"}, {"type": "subtitle", "time": 4443.51, "timestamp": "01:14:03", "text": "基地、公会等等，就像"}, {"type": "subtitle", "time": 4445.91, "timestamp": "01:14:05", "text": "我昨天"}, {"type": "subtitle", "time": 4447.75, "timestamp": "01:14:07", "text": "加入Astraans的时候一样，"}, {"type": "subtitle", "time": 4453.51, "timestamp": "01:14:13", "text": "因为基地已经建好了，"}, {"type": "subtitle", "time": 4455.669, "timestamp": "01:14:15", "text": "一切都建好了，我不需要"}, {"type": "subtitle", "time": 4458.149, "timestamp": "01:14:18", "text": "做太多事情，只需要专注"}, {"type": "subtitle", "time": 4462.87, "timestamp": "01:14:22", "text": "于升级，比如做任务之类的，我"}, {"type": "subtitle", "time": 4466.47, "timestamp": "01:14:26", "text": "自己"}, {"type": "subtitle", "time": 4468.47, "timestamp": "01:14:28", "text": "昨天就升到了20级，我当时就觉得"}]
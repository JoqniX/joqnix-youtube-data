[{"type": "subtitle", "time": 10762.07, "timestamp": "02:59:22", "text": "我这就结束。 感谢"}, {"type": "subtitle", "time": 10768.389, "timestamp": "02:59:28", "text": "今天来的人都……"}, {"type": "subtitle", "time": 10770.23, "timestamp": "02:59:30", "text": "（清嗓子）"}, {"type": "subtitle", "time": 10776.87, "timestamp": "02:59:36", "text": "面包。 布拉德，谢谢你过来。"}, {"type": "subtitle", "time": 10779.75, "timestamp": "02:59:39", "text": "呃，她的逃亡之歌。 谢谢"}, {"type": "subtitle", "time": 10781.349, "timestamp": "02:59:41", "text": "光临。"}, {"type": "subtitle", "time": 10783.19, "timestamp": "02:59:43", "text": "然后，"}, {"type": "subtitle", "time": 10787.59, "timestamp": "02:59:47", "text": "呃，多林原谅了一些人。 谢谢你"}, {"type": "subtitle", "time": 10790.07, "timestamp": "02:59:50", "text": "过来。"}, {"type": "subtitle", "time": 10792.15, "timestamp": "02:59:52", "text": "这是衡量标准。"}, {"type": "subtitle", "time": 10795.67, "timestamp": "02:59:55", "text": "谢谢你过来。"}, {"type": "subtitle", "time": 10798.23, "timestamp": "02:59:58", "text": "Destiny，谢谢你的关注，也"}]
[{"type": "subtitle", "time": 5345.91, "timestamp": "01:29:05", "text": "顺便说一句，我们不着急。   是的"}, {"type": "subtitle", "time": 5347.91, "timestamp": "01:29:07", "text": "，不用着急。 是的，我可以放松一下"}, {"type": "subtitle", "time": 5350.87, "timestamp": "01:29:10", "text": "。"}, {"type": "subtitle", "time": 5353.91, "timestamp": "01:29:13", "text": "只要有空，我就可以"}, {"type": "subtitle", "time": 5372.47, "timestamp": "01:29:32", "text": "说实话，我确实想建立一个功能齐全的"}, {"type": "subtitle", "time": 5374.229, "timestamp": "01:29:34", "text": "基地，"}, {"type": "subtitle", "time": 5378.229, "timestamp": "01:29:38", "text": "比如食物供应，所有东西都像"}, {"type": "subtitle", "time": 5380.629, "timestamp": "01:29:40", "text": "以前那样自动化。 我也"}, {"type": "subtitle", "time": 5383.99, "timestamp": "01:29:43", "text": "加入了。 我的朋友们身体"}, {"type": "subtitle", "time": 5386.55, "timestamp": "01:29:46", "text": "虚弱，仿佛骨折了一样，而且他们的"}, {"type": "subtitle", "time": 5389.392, "timestamp": "01:29:49", "text": "眼睛都充血了。"}, {"type": "subtitle", "time": 5390.39, "timestamp": "01:29:50", "text": "[笑声] 是"}, {"type": "subtitle", "time": 5391.99, "timestamp": "01:29:51", "text": "啊，我可"}, {"type": "subtitle", "time": 5394.709, "timestamp": "01:29:54", "text": "不想那样。 这就是为什么我"}]
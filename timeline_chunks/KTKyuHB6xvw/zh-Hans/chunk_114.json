[{"type": "subtitle", "time": 6855.109, "timestamp": "01:54:15", "text": "如果你们其他人的口味更重，"}, {"type": "subtitle", "time": 6857.669, "timestamp": "01:54:17", "text": "比如比辛醇含量更低，那也没关系。 我身处"}, {"type": "subtitle", "time": 6861.43, "timestamp": "01:54:21", "text": "异国他乡，所以"}, {"type": "subtitle", "time": 6895.03, "timestamp": "01:54:55", "text": "宝贝，我迟到了。 我快要"}, {"type": "subtitle", "time": 6897.43, "timestamp": "01:54:57", "text": "溺水了。"}]
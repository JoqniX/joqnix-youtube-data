[{"type": "subtitle", "time": 4899.59, "timestamp": "01:21:39", "text": "我们该怎么办？ 他们将继续"}, {"type": "subtitle", "time": 4901.91, "timestamp": "01:21:41", "text": "专注于巩固自己的基础。 我不会"}, {"type": "subtitle", "time": 4909.189, "timestamp": "01:21:49", "text": "我希望我们能"}, {"type": "subtitle", "time": 4911.43, "timestamp": "01:21:51", "text": "一起去探索，但是，嗯，我"}, {"type": "subtitle", "time": 4915.189, "timestamp": "01:21:55", "text": "现在得升级了。 我"}, {"type": "subtitle", "time": 4918.47, "timestamp": "01:21:58", "text": "现在就像个新手。"}]
[{"type": "subtitle", "time": 7204.31, "timestamp": "02:00:04", "text": "兄弟，"}, {"type": "subtitle", "time": 7212.95, "timestamp": "02:00:12", "text": "我的天，这延迟！"}, {"type": "subtitle", "time": 7228.07, "timestamp": "02:00:28", "text": "如果你拥有这么多，我觉得"}, {"type": "subtitle", "time": 7230.229, "timestamp": "02:00:30", "text": "你应该"}, {"type": "subtitle", "time": 7232.709, "timestamp": "02:00:32", "text": "重新考虑一下。"}, {"type": "subtitle", "time": 7232.87, "timestamp": "02:00:32", "text": "不，"}, {"type": "subtitle", "time": 7235.43, "timestamp": "02:00:35", "text": "我可以将服务器迁移到新加坡。 我"}, {"type": "subtitle", "time": 7243.35, "timestamp": "02:00:43", "text": "快点。"}, {"type": "subtitle", "time": 7246.709, "timestamp": "02:00:46", "text": "你需要多少佩利姆？"}, {"type": "subtitle", "time": 7250.95, "timestamp": "02:00:50", "text": "我目前有85个燃料，只需要100个"}, {"type": "subtitle", "time": 7251.99, "timestamp": "02:00:51", "text": "。"}, {"type": "subtitle", "time": 7254.229, "timestamp": "02:00:54", "text": "为了什么？ 你在做什么？"}, {"type": "subtitle", "time": 7257.83, "timestamp": "02:00:57", "text": "呃，不。 呃，我需要它来搭建"}]
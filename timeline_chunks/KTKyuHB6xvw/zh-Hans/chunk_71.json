[{"type": "subtitle", "time": 4273.75, "timestamp": "01:11:13", "text": "哦，那真不错。 然后"}, {"type": "subtitle", "time": 4276.709, "timestamp": "01:11:16", "text": "我就没法捡起来了，"}, {"type": "subtitle", "time": 4279.51, "timestamp": "01:11:19", "text": "或者说这太"}, {"type": "subtitle", "time": 4285.75, "timestamp": "01:11:25", "text": "两只羊。 我打算"}, {"type": "subtitle", "time": 4294.874, "timestamp": "01:11:34", "text": "我的朋友现在为什么在打架？"}, {"type": "subtitle", "time": 4295.99, "timestamp": "01:11:35", "text": "[尖叫]"}, {"type": "subtitle", "time": 4298.95, "timestamp": "01:11:38", "text": "你杀人了。"}, {"type": "subtitle", "time": 4301.91, "timestamp": "01:11:41", "text": "不要杀人。 不要消除"}, {"type": "subtitle", "time": 4305.99, "timestamp": "01:11:45", "text": "延迟。 杀了那"}]
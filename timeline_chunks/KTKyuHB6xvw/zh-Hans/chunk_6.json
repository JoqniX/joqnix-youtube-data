[{"type": "subtitle", "time": 373.99, "timestamp": "00:06:13", "text": "好的。 呃，所以我们从这里开始。"}, {"type": "subtitle", "time": 377.59, "timestamp": "00:06:17", "text": "呃，我得说，呃，是的，"}, {"type": "subtitle", "time": 379.189, "timestamp": "00:06:19", "text": "如果你听到背景噪音，请"}, {"type": "subtitle", "time": 381.43, "timestamp": "00:06:21", "text": "忽略我。"}, {"type": "subtitle", "time": 384.469, "timestamp": "00:06:24", "text": "嗯，我们就从这里开始。 这是一个全新的"}, {"type": "subtitle", "time": 386.79, "timestamp": "00:06:26", "text": "世界。"}, {"type": "subtitle", "time": 389.27, "timestamp": "00:06:29", "text": "我把所有东西都放在那边了。 我的朋友们快要"}, {"type": "subtitle", "time": 392.87, "timestamp": "00:06:32", "text": "饿死了，快要死了"}, {"type": "subtitle", "time": 396.71, "timestamp": "00:06:36", "text": "。 很快。  [笑声]"}, {"type": "subtitle", "time": 399.59000000000003, "timestamp": "00:06:39", "text": "你怎么会有一台HP？"}, {"type": "subtitle", "time": 403.51, "timestamp": "00:06:43", "text": "啊，因为我当时很冷。 我"}, {"type": "subtitle", "time": 405.749, "timestamp": "00:06:45", "text": "可能得吃点东西。"}, {"type": "subtitle", "time": 409.11, "timestamp": "00:06:49", "text": "我没有我的……我没有我的……我"}, {"type": "subtitle", "time": 412.71, "timestamp": "00:06:52", "text": "没有我的……我没有我的……嗯……"}]
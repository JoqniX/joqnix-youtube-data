[{"type": "subtitle", "time": 3373.829, "timestamp": "00:56:13", "text": "好了，我回来了。"}, {"type": "subtitle", "time": 3381.75, "timestamp": "00:56:21", "text": "兄弟。 仅仅为了拿到石头，我就得一路爬到"}, {"type": "subtitle", "time": 3390.15, "timestamp": "00:56:30", "text": "我为什么醒着？ 我为什么要把我的东西建在"}, {"type": "subtitle", "time": 3398.789, "timestamp": "00:56:38", "text": "好的，你先搭建基础部件。"}, {"type": "subtitle", "time": 3400.789, "timestamp": "00:56:40", "text": "我觉得我需要建一个石头"}, {"type": "subtitle", "time": 3418.95, "timestamp": "00:56:58", "text": "我看到你的基地了。"}]
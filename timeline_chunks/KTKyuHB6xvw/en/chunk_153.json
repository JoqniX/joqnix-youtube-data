[{"type": "subtitle", "time": 9182.87, "timestamp": "02:33:02", "text": "I I think I'm trying"}, {"type": "subtitle", "time": 9184.95, "timestamp": "02:33:04", "text": "on on my part."}, {"type": "subtitle", "time": 9190.469, "timestamp": "02:33:10", "text": "if I were to talk about what happened"}, {"type": "subtitle", "time": 9195.27, "timestamp": "02:33:15", "text": "today, it just made me a bit uh I really"}, {"type": "subtitle", "time": 9198.389, "timestamp": "02:33:18", "text": "lack vocabulary."}, {"type": "subtitle", "time": 9201.83, "timestamp": "02:33:21", "text": "Like today n my recently my cycle got"}, {"type": "subtitle", "time": 9205.59, "timestamp": "02:33:25", "text": "cycle key got stolen and there was no"}, {"type": "subtitle", "time": 9208.309, "timestamp": "02:33:28", "text": "way to cut the lock. I tried to buy a"}, {"type": "subtitle", "time": 9211.11, "timestamp": "02:33:31", "text": "hand saw and that did not work. I had to"}, {"type": "subtitle", "time": 9213.11, "timestamp": "02:33:33", "text": "like drag the cycle back all the way to"}, {"type": "subtitle", "time": 9215.91, "timestamp": "02:33:35", "text": "school. Thankfully I made it in time. I"}, {"type": "subtitle", "time": 9217.91, "timestamp": "02:33:37", "text": "was not late"}, {"type": "subtitle", "time": 9221.11, "timestamp": "02:33:41", "text": "and that me dragging the cycle ended up"}, {"type": "subtitle", "time": 9224.469, "timestamp": "02:33:44", "text": "I ended up wearing down the tire"}, {"type": "subtitle", "time": 9227.27, "timestamp": "02:33:47", "text": "uh due to friction and the tube bursted"}, {"type": "subtitle", "time": 9230.55, "timestamp": "02:33:50", "text": "and I have to pay like 5,500"}, {"type": "subtitle", "time": 9234.95, "timestamp": "02:33:54", "text": "yen to fix it."}, {"type": "subtitle", "time": 9239.51, "timestamp": "02:33:59", "text": "And when I was like out of breath"}]
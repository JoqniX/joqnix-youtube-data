[{"type": "subtitle", "time": 7744.069, "timestamp": "02:09:04", "text": "但是，呃，"}, {"type": "subtitle", "time": 7746.47, "timestamp": "02:09:06", "text": "说到 YouTube，"}, {"type": "subtitle", "time": 7749.109, "timestamp": "02:09:09", "text": "既然我们都同意"}, {"type": "subtitle", "time": 7752.55, "timestamp": "02:09:12", "text": "这个播放列表和直播"}, {"type": "subtitle", "time": 7755.35, "timestamp": "02:09:15", "text": "图库之类的东西，我想写一个"}, {"type": "subtitle", "time": 7759.109, "timestamp": "02:09:19", "text": "游戏数据库或者直播数据库之类的东西。"}, {"type": "subtitle", "time": 7761.27, "timestamp": "02:09:21", "text": "YouTube唯一的问题就是"}, {"type": "subtitle", "time": 7764.39, "timestamp": "02:09:24", "text": "播放列表功能。 无论你是进行艺术"}, {"type": "subtitle", "time": 7765.83, "timestamp": "02:09:25", "text": "直播，你都必须把它放到艺术"}, {"type": "subtitle", "time": 7768.709, "timestamp": "02:09:28", "text": "直播的播放列表中。 当你进行"}, {"type": "subtitle", "time": 7770.31, "timestamp": "02:09:30", "text": "工作流程时，你必须把它添加到"}, {"type": "subtitle", "time": 7773.99, "timestamp": "02:09:33", "text": "工作流程播放列表之类的东西中。"}, {"type": "chat", "time": 7774.87, "timestamp": "02:09:34", "author": "@sarthaksharma2476", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kmJohYAdmpQzCNN96t58cLSK8spv6Y2ITutBFF9nvi9Z8=s64-c-k-c0x00ffffff-no-rj", "message": "and web site making too"}, {"type": "subtitle", "time": 7777.189, "timestamp": "02:09:37", "text": "但问题不在于"}, {"type": "subtitle", "time": 7778.87, "timestamp": "02:09:38", "text": "我有时想要在"}, {"type": "subtitle", "time": 7780.95, "timestamp": "02:09:40", "text": "Twitch 上拥有那种自由，对吧？ 你可以随意观看"}, {"type": "subtitle", "time": 7783.91, "timestamp": "02:09:43", "text": "任何你想看的内容。 只是简单的类别"}, {"type": "subtitle", "time": 7786.79, "timestamp": "02:09:46", "text": "切换。 就是这样。"}, {"type": "subtitle", "time": 7789.35, "timestamp": "02:09:49", "text": "就像 YouTube 直播的问题一样，"}, {"type": "subtitle", "time": 7791.99, "timestamp": "02:09:51", "text": "比如说你在玩游戏"}, {"type": "subtitle", "time": 7795.109, "timestamp": "02:09:55", "text": "，达到高潮，对吧？ 你正在玩一款"}, {"type": "subtitle", "time": 7798.149, "timestamp": "02:09:58", "text": "巅峰游戏。 你把它添加到热门歌单里了"}]
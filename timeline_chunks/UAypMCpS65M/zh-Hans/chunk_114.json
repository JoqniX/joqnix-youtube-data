[{"type": "subtitle", "time": 6842.55, "timestamp": "01:54:02", "text": "那里进行每周一次的唱歌练习，"}, {"type": "subtitle", "time": 6846.07, "timestamp": "01:54:06", "text": "等等，"}, {"type": "subtitle", "time": 6850.149, "timestamp": "01:54:10", "text": "别这样戏弄我，鼻子查玛，"}, {"type": "subtitle", "time": 6851.83, "timestamp": "01:54:11", "text": "你到底要不要打喷嚏？ 对，"}, {"type": "subtitle", "time": 6854.709, "timestamp": "01:54:14", "text": "这就像那种声乐教学系列"}, {"type": "subtitle", "time": 6857.83, "timestamp": "01:54:17", "text": "节目，对吧？ 我只是"}, {"type": "subtitle", "time": 6859.83, "timestamp": "01:54:19", "text": "想把它保留在"}, {"type": "subtitle", "time": 6862.629, "timestamp": "01:54:22", "text": "网站上，这样人们就可以看到，哦，Jo"}, {"type": "subtitle", "time": 6865.589, "timestamp": "01:54:25", "text": "做过类似的系列节目，"}, {"type": "subtitle", "time": 6869.43, "timestamp": "01:54:29", "text": "他们可以去查看等等。"}, {"type": "subtitle", "time": 6872.79, "timestamp": "01:54:32", "text": "我还有一个合作歌"}, {"type": "subtitle", "time": 6876.86, "timestamp": "01:54:36", "text": "单。 不，当然我也可以做到。"}, {"type": "subtitle", "time": 6882.87, "timestamp": "01:54:42", "text": "为什么它要来了却又没来？"}, {"type": "subtitle", "time": 6885.91, "timestamp": "01:54:45", "text": "为什么我没有打喷嚏？哦，天哪，它要"}, {"type": "subtitle", "time": 6889.91, "timestamp": "01:54:49", "text": "来了。 但我会等。 别再"}]
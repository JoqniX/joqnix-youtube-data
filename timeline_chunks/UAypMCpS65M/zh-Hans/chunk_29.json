[{"type": "chat", "time": 1743.398, "timestamp": "00:29:03", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "happy belated friendship day"}, {"type": "subtitle", "time": 1745.35, "timestamp": "00:29:05", "text": "我的日程安排得满满当当"}, {"type": "subtitle", "time": 1749.669, "timestamp": "00:29:09", "text": "。 你好，Aditi。"}, {"type": "subtitle", "time": 1752.29, "timestamp": "00:29:12", "text": "迟来的友谊日快乐！"}, {"type": "subtitle", "time": 1753.43, "timestamp": "00:29:13", "text": "[音乐]"}, {"type": "chat", "time": 1755.352, "timestamp": "00:29:15", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "belated"}, {"type": "subtitle", "time": 1756.47, "timestamp": "00:29:16", "text": "你好吗？ 我生病了。"}, {"type": "chat", "time": 1758.632, "timestamp": "00:29:18", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "owo"}, {"type": "subtitle", "time": 1760.149, "timestamp": "00:29:20", "text": "我可能明天就会发烧。"}, {"type": "subtitle", "time": 1763.19, "timestamp": "00:29:23", "text": "我的身体已经感觉非常冷了"}, {"type": "subtitle", "time": 1766.87, "timestamp": "00:29:26", "text": "。 我的房间风扇开着，"}, {"type": "subtitle", "time": 1770.23, "timestamp": "00:29:30", "text": "风速只有两档，不是五档，也不是"}, {"type": "subtitle", "time": 1772.95, "timestamp": "00:29:32", "text": "四档，也不是三档，它真的只有两档"}, {"type": "subtitle", "time": 1775.669, "timestamp": "00:29:35", "text": "风速。"}, {"type": "subtitle", "time": 1777.43, "timestamp": "00:29:37", "text": "但是"}, {"type": "subtitle", "time": 1781.99, "timestamp": "00:29:41", "text": "每次风扇吹到我身上，我都感觉超级冷。"}, {"type": "subtitle", "time": 1785.99, "timestamp": "00:29:45", "text": "我不能直视"}, {"type": "subtitle", "time": 1789.029, "timestamp": "00:29:49", "text": "显示器，因为"}, {"type": "subtitle", "time": 1791.35, "timestamp": "00:29:51", "text": "看得越久越疼，所以我经常"}, {"type": "subtitle", "time": 1793.59, "timestamp": "00:29:53", "text": "闭上眼睛，"}, {"type": "subtitle", "time": 1796.23, "timestamp": "00:29:56", "text": "喉咙也疼。"}]
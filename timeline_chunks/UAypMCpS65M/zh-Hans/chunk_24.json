[{"type": "subtitle", "time": 1446.39, "timestamp": "00:24:06", "text": "所以，"}, {"type": "subtitle", "time": 1449.75, "timestamp": "00:24:09", "text": "今天上课的时候，我两个"}, {"type": "subtitle", "time": 1451.909, "timestamp": "00:24:11", "text": "日语同学"}, {"type": "subtitle", "time": 1457.59, "timestamp": "00:24:17", "text": "打电话问我，"}, {"type": "subtitle", "time": 1460.23, "timestamp": "00:24:20", "text": "你们觉得什么时候去参加面试什么的。"}, {"type": "subtitle", "time": 1465.83, "timestamp": "00:24:25", "text": "我当时就懵了，什么面试？"}, {"type": "subtitle", "time": 1468.789, "timestamp": "00:24:28", "text": "我没通过面试啊。"}, {"type": "subtitle", "time": 1471.59, "timestamp": "00:24:31", "text": "我们不是应该去GMA的那所"}, {"type": "subtitle", "time": 1475.029, "timestamp": "00:24:35", "text": "学校吗？其中一个同学不想去"}, {"type": "subtitle", "time": 1478.07, "timestamp": "00:24:38", "text": "GMA，想"}, {"type": "subtitle", "time": 1481.35, "timestamp": "00:24:41", "text": "换个学习机构，去"}, {"type": "subtitle", "time": 1486.149, "timestamp": "00:24:46", "text": "日本的那个学校，因为"}, {"type": "subtitle", "time": 1494.23, "timestamp": "00:24:54", "text": "他们不允许你开车，"}, {"type": "subtitle", "time": 1496.31, "timestamp": "00:24:56", "text": "甚至不允许你申请日本"}]
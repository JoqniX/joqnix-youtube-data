[{"type": "subtitle", "time": 2040.31, "timestamp": "00:34:00", "text": "如果有人这么说，我就会说："}, {"type": "subtitle", "time": 2042.87, "timestamp": "00:34:02", "text": "“没关系，我没事，我"}, {"type": "subtitle", "time": 2044.95, "timestamp": "00:34:04", "text": "藏起来就行了。”"}, {"type": "subtitle", "time": 2046.87, "timestamp": "00:34:06", "text": "但实际上，我会感觉超级"}, {"type": "subtitle", "time": 2049.829, "timestamp": "00:34:09", "text": "累、超级紧张，等等。 我"}, {"type": "subtitle", "time": 2054.23, "timestamp": "00:34:14", "text": "不会把它展示出来，因为我觉得那样"}, {"type": "subtitle", "time": 2058.23, "timestamp": "00:34:18", "text": "会让他们不得不阅读什么的。"}, {"type": "subtitle", "time": 2060.389, "timestamp": "00:34:20", "text": "所以，"}, {"type": "subtitle", "time": 2068.71, "timestamp": "00:34:28", "text": "嗯，好吧。  D线有空隙，"}, {"type": "subtitle", "time": 2073.77, "timestamp": "00:34:33", "text": "我们稍等片刻。"}, {"type": "subtitle", "time": 2088.389, "timestamp": "00:34:48", "text": "哦，我忘了发推特了。"}]
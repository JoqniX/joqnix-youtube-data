[{"type": "subtitle", "time": 1500.31, "timestamp": "00:25:00", "text": "驾照、他们的驾照等等。真是太"}, {"type": "subtitle", "time": 1507.11, "timestamp": "00:25:07", "text": "，他们非常严格。"}, {"type": "subtitle", "time": 1509.75, "timestamp": "00:25:09", "text": "我对"}, {"type": "subtitle", "time": 1513.029, "timestamp": "00:25:13", "text": "那里发生的事情一无所知。 我必须主动联系人们，"}, {"type": "subtitle", "time": 1516.71, "timestamp": "00:25:16", "text": "询问他们课程情况如何，"}, {"type": "subtitle", "time": 1519.19, "timestamp": "00:25:19", "text": "规章制度如何，"}, {"type": "subtitle", "time": 1521.51, "timestamp": "00:25:21", "text": "在日本和GMA的兼职工作情况如何"}, {"type": "subtitle", "time": 1527.59, "timestamp": "00:25:27", "text": "是的，"}, {"type": "subtitle", "time": 1529.75, "timestamp": "00:25:29", "text": "显然那些去过"}, {"type": "subtitle", "time": 1532.95, "timestamp": "00:25:32", "text": "东京语言"}, {"type": "subtitle", "time": 1534.789, "timestamp": "00:25:34", "text": "学院的人，其中"}, {"type": "subtitle", "time": 1540.47, "timestamp": "00:25:40", "text": "一些人现在都去当优步"}, {"type": "subtitle", "time": 1543.83, "timestamp": "00:25:43", "text": "司机了。 他们利用上午和中午的课余时间兼职开车，"}, {"type": "subtitle", "time": 1546.63, "timestamp": "00:25:46", "text": "同时也会做其他"}, {"type": "subtitle", "time": 1549.43, "timestamp": "00:25:49", "text": "兼职工作"}, {"type": "subtitle", "time": 1554.23, "timestamp": "00:25:54", "text": "。 太"}]
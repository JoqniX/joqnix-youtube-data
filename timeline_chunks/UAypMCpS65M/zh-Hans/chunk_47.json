[{"type": "subtitle", "time": 2820.79, "timestamp": "00:47:00", "text": "建立自己的"}, {"type": "subtitle", "time": 2825.19, "timestamp": "00:47:05", "text": "规则或文化之类的东西，无论是"}, {"type": "subtitle", "time": 2827.109, "timestamp": "00:47:07", "text": "说英语的还是说"}, {"type": "subtitle", "time": 2829.19, "timestamp": "00:47:09", "text": "方言的，"}, {"type": "subtitle", "time": 2838.069, "timestamp": "00:47:18", "text": "天哪，我得一直静音。我走神了"}, {"type": "subtitle", "time": 2847.03, "timestamp": "00:47:27", "text": "但这也不错。不。"}, {"type": "subtitle", "time": 2849.75, "timestamp": "00:47:29", "text": "好吧。是的"}, {"type": "subtitle", "time": 2851.75, "timestamp": "00:47:31", "text": "。所以，我一直在想的一件事"}, {"type": "subtitle", "time": 2854.63, "timestamp": "00:47:34", "text": "是，"}, {"type": "subtitle", "time": 2857.829, "timestamp": "00:47:37", "text": "嗯，我今天有了灵感。等等，我"}, {"type": "subtitle", "time": 2869.03, "timestamp": "00:47:49", "text": "哦，我的天哪。"}, {"type": "subtitle", "time": 2871.75, "timestamp": "00:47:51", "text": "天哪，我的喉咙。每次我碰到"}, {"type": "subtitle", "time": 2873.43, "timestamp": "00:47:53", "text": "喉咙，"}]
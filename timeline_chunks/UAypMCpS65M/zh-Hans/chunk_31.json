[{"type": "subtitle", "time": 1863.11, "timestamp": "00:31:03", "text": "她现在当然有很多事情要做"}, {"type": "subtitle", "time": 1864.63, "timestamp": "00:31:04", "text": "。 许多新的"}, {"type": "subtitle", "time": 1866.549, "timestamp": "00:31:06", "text": "机遇。 她无法发送消息。"}, {"type": "subtitle", "time": 1869.51, "timestamp": "00:31:09", "text": "所以，她必须越来越努力，"}, {"type": "subtitle", "time": 1873.43, "timestamp": "00:31:13", "text": "对吧？ 但是，没错，如果工作"}, {"type": "subtitle", "time": 1875.51, "timestamp": "00:31:15", "text": "过度，你会筋疲力尽。 如果"}, {"type": "subtitle", "time": 1879.75, "timestamp": "00:31:19", "text": "你不给自己时间"}, {"type": "subtitle", "time": 1881.99, "timestamp": "00:31:21", "text": "休息等等，那还有什么"}, {"type": "subtitle", "time": 1883.59, "timestamp": "00:31:23", "text": "意义呢？"}, {"type": "subtitle", "time": 1886.63, "timestamp": "00:31:26", "text": "但她"}, {"type": "subtitle", "time": 1890.789, "timestamp": "00:31:30", "text": "说的其中一句话让我印象深刻，她说"}, {"type": "subtitle", "time": 1893.51, "timestamp": "00:31:33", "text": "她以前做的任何事情都更像是一种爱好，而"}, {"type": "subtitle", "time": 1897.83, "timestamp": "00:31:37", "text": "现在她把爱好变成了"}, {"type": "subtitle", "time": 1903.029, "timestamp": "00:31:43", "text": "工作，或者说，变成了一种可以"}, {"type": "subtitle", "time": 1906.23, "timestamp": "00:31:46", "text": "做很多事情的方式，而不是像以前那样，一边"}, {"type": "subtitle", "time": 1911.19, "timestamp": "00:31:51", "text": "享受爱好，"}, {"type": "subtitle", "time": 1914.95, "timestamp": "00:31:54", "text": "一边把它当作工作来"}, {"type": "subtitle", "time": 1917.19, "timestamp": "00:31:57", "text": "赚钱"}, {"type": "subtitle", "time": 1918.95, "timestamp": "00:31:58", "text": "。   是的"}]
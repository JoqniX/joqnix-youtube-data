[{"type": "subtitle", "time": 3182.23, "timestamp": "00:53:02", "text": "我出现了发烧的早期症状，"}, {"type": "subtitle", "time": 3185.03, "timestamp": "00:53:05", "text": "所以你……呃，"}, {"type": "subtitle", "time": 3191.67, "timestamp": "00:53:11", "text": "我这样做……是的，这是一个"}, {"type": "subtitle", "time": 3194.15, "timestamp": "00:53:14", "text": "她自己编写的网站，所以是的，她"}, {"type": "subtitle", "time": 3196.549, "timestamp": "00:53:16", "text": "有她所有角色的其他"}, {"type": "subtitle", "time": 3199.27, "timestamp": "00:53:19", "text": "模型等等，"}, {"type": "subtitle", "time": 3201.67, "timestamp": "00:53:21", "text": "旧模型，"}, {"type": "subtitle", "time": 3203.27, "timestamp": "00:53:23", "text": "所有东西，还有生活"}, {"type": "subtitle", "time": 3205.27, "timestamp": "00:53:25", "text": "等等。这就是我计划"}, {"type": "subtitle", "time": 3208.79, "timestamp": "00:53:28", "text": "在我的个人资料页面或角色页面上做的事情，"}, {"type": "subtitle", "time": 3213.99, "timestamp": "00:53:33", "text": "在我的工作网站上。"}, {"type": "subtitle", "time": 3216.069, "timestamp": "00:53:36", "text": "呃，我会这样做。"}, {"type": "subtitle", "time": 3219.03, "timestamp": "00:53:39", "text": "你"}, {"type": "subtitle", "time": 3228.95, "timestamp": "00:53:48", "text": "她在 Twitch 上直播过的所有系列，"}, {"type": "subtitle", "time": 3231.27, "timestamp": "00:53:51", "text": "对吧？就在"}, {"type": "subtitle", "time": 3234.23, "timestamp": "00:53:54", "text": "这里。她还会像其他游戏一样，给游戏打分，还会显示"}, {"type": "subtitle", "time": 3239.99, "timestamp": "00:53:59", "text": "她上次"}]
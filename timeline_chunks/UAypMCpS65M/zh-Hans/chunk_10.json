[{"type": "subtitle", "time": 601.75, "timestamp": "00:10:01", "text": "店，他们"}, {"type": "subtitle", "time": 604.79, "timestamp": "00:10:04", "text": "有UPI，你知道，谷歌支付。我"}, {"type": "subtitle", "time": 608.949, "timestamp": "00:10:08", "text": "忘了停用我的谷歌支付"}, {"type": "subtitle", "time": 615.75, "timestamp": "00:10:15", "text": "商业应用，今天这个东西就出现在我的账户里了，"}, {"type": "subtitle", "time": 619.11, "timestamp": "00:10:19", "text": "我当时就想，"}, {"type": "subtitle", "time": 623.99, "timestamp": "00:10:23", "text": "哦，不。我为什么要用这个"}, {"type": "subtitle", "time": 627.35, "timestamp": "00:10:27", "text": "？谁会来我的实体"}, {"type": "subtitle", "time": 631.11, "timestamp": "00:10:31", "text": "店啊？ 什么？随便吧。"}, {"type": "subtitle", "time": 633.03, "timestamp": "00:10:33", "text": "那不可能。所以，我就想，"}, {"type": "subtitle", "time": 635.75, "timestamp": "00:10:35", "text": "“好吧，我可以……”然后"}, {"type": "subtitle", "time": 639.19, "timestamp": "00:10:39", "text": "我又想，“哦，不。” 但是"}, {"type": "subtitle", "time": 641.75, "timestamp": "00:10:41", "text": "，你知道，UPI 这个东西会显示"}, {"type": "subtitle", "time": 643.91, "timestamp": "00:10:43", "text": "电话号码。 我不想那样。 我"}, {"type": "subtitle", "time": 647.75, "timestamp": "00:10:47", "text": "不想那样。 隐私必须得到"}, {"type": "subtitle", "time": 651.03, "timestamp": "00:10:51", "text": "保障。 嗯，我的匿名性必须得到"}, {"type": "subtitle", "time": 657.829, "timestamp": "00:10:57", "text": "。"}, {"type": "subtitle", "time": 659.99, "timestamp": "00:10:59", "text": "所以，到了晚上"}]
[{"type": "subtitle", "time": 10449.67, "timestamp": "02:54:09", "text": "顺利。 我感觉自己"}, {"type": "subtitle", "time": 10456.389, "timestamp": "02:54:16", "text": "综合征很相似。 我"}, {"type": "subtitle", "time": 10475.03, "timestamp": "02:54:35", "text": "我因为"}, {"type": "subtitle", "time": 10476.95, "timestamp": "02:54:36", "text": "疼痛而脱水。"}, {"type": "subtitle", "time": 10483.11, "timestamp": "02:54:43", "text": "我漏水了。 我当时就想，呃，那里冷吗？"}, {"type": "subtitle", "time": 10486.87, "timestamp": "02:54:46", "text": "我把风扇转速设为"}, {"type": "subtitle", "time": 10489.75, "timestamp": "02:54:49", "text": "2。"}, {"type": "subtitle", "time": 10494.55, "timestamp": "02:54:54", "text": "呃，速度是2，我"}, {"type": "subtitle", "time": 10497.03, "timestamp": "02:54:57", "text": "现在感觉很冷，"}, {"type": "subtitle", "time": 10499.429, "timestamp": "02:54:59", "text": "而不是出汗。 我不明白，我完全不明白发生了什么事"}]
[{"type": "subtitle", "time": 2281.67, "timestamp": "00:38:01", "text": "她有空的时间是"}, {"type": "subtitle", "time": 2285.67, "timestamp": "00:38:05", "text": "早上6点到晚上10点。"}, {"type": "subtitle", "time": 2288.15, "timestamp": "00:38:08", "text": "上午 10:00，早上 6:00 到上午 10:00。所以那段时间"}, {"type": "subtitle", "time": 2291.27, "timestamp": "00:38:11", "text": "我的睡眠时间完全被打乱了"}, {"type": "subtitle", "time": 2294.069, "timestamp": "00:38:14", "text": "。 我以前早上7点就睡觉了。"}, {"type": "subtitle", "time": 2297.43, "timestamp": "00:38:17", "text": "现在我整夜都在忙"}, {"type": "subtitle", "time": 2299.99, "timestamp": "00:38:19", "text": "直播、网站之类的各种事情。"}, {"type": "subtitle", "time": 2304.79, "timestamp": "00:38:24", "text": "所以，最近我和她聊天，我"}, {"type": "subtitle", "time": 2309.589, "timestamp": "00:38:29", "text": "问了她一个关于"}, {"type": "subtitle", "time": 2313.27, "timestamp": "00:38:33", "text": "中国YouTuber如何"}, {"type": "subtitle", "time": 2315.589, "timestamp": "00:38:35", "text": "销售周边产品的问题，"}, {"type": "subtitle", "time": 2319.829, "timestamp": "00:38:39", "text": "她分享了很多"}, {"type": "subtitle", "time": 2323.27, "timestamp": "00:38:43", "text": "很有见地的知识，"}, {"type": "subtitle", "time": 2325.99, "timestamp": "00:38:45", "text": "即使在中国，对YouTuber来说，这也很"}, {"type": "subtitle", "time": 2329.829, "timestamp": "00:38:49", "text": "困难。 她讲述了自己的故事，说"}, {"type": "subtitle", "time": 2332.71, "timestamp": "00:38:52", "text": "她也想和一样把这当成一份"}, {"type": "subtitle", "time": 2336.95, "timestamp": "00:38:56", "text": "全职工作，并且想卖出"}, {"type": "subtitle", "time": 2338.87, "timestamp": "00:38:58", "text": "越来越多的周边产品等等。"}]
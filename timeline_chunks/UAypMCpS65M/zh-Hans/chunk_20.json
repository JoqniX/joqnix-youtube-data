[{"type": "subtitle", "time": 1203.99, "timestamp": "00:20:03", "text": "星座，对吧，我们的中国观众，"}, {"type": "subtitle", "time": 1208.95, "timestamp": "00:20:08", "text": "他们欢迎我回来，说欢迎"}, {"type": "subtitle", "time": 1212.31, "timestamp": "00:20:12", "text": "回来，我们想念你。"}, {"type": "subtitle", "time": 1216.15, "timestamp": "00:20:16", "text": "这让我哭了。 直到现在，我仍然感到内疚，"}, {"type": "subtitle", "time": 1220.549, "timestamp": "00:20:20", "text": "因为我无法在Billy Billy上观看直播。"}, {"type": "subtitle", "time": 1225.59, "timestamp": "00:20:25", "text": "我辛辛苦苦工作了两个月，对吧？"}, {"type": "subtitle", "time": 1227.909, "timestamp": "00:20:27", "text": "那件不幸的事情确实"}, {"type": "subtitle", "time": 1229.99, "timestamp": "00:20:29", "text": "发生了，"}, {"type": "subtitle", "time": 1233.029, "timestamp": "00:20:33", "text": "但公司解散了，我再也"}, {"type": "subtitle", "time": 1235.909, "timestamp": "00:20:35", "text": "没有其他办法在 Billy Billy 上观看流媒体了"}, {"type": "subtitle", "time": 1240.23, "timestamp": "00:20:40", "text": "。 呃，作为外国人，除非"}, {"type": "subtitle", "time": 1242.47, "timestamp": "00:20:42", "text": "你"}, {"type": "subtitle", "time": 1245.909, "timestamp": "00:20:45", "text": "与"}, {"type": "subtitle", "time": 1249.83, "timestamp": "00:20:49", "text": "中国的 MMCN 公司有合作关系，否则很难获得"}, {"type": "subtitle", "time": 1254.31, "timestamp": "00:20:54", "text": "广泛的播放权限。"}]
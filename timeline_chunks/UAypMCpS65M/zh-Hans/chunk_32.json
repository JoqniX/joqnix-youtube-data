[{"type": "subtitle", "time": 1921.59, "timestamp": "00:32:01", "text": "。"}, {"type": "subtitle", "time": 1924.07, "timestamp": "00:32:04", "text": "还有那件事，还有Drumsy"}, {"type": "subtitle", "time": 1927.909, "timestamp": "00:32:07", "text": "说过的话，嗯，我"}, {"type": "subtitle", "time": 1929.909, "timestamp": "00:32:09", "text": "记不清确切的措辞了，"}, {"type": "subtitle", "time": 1932.95, "timestamp": "00:32:12", "text": "但你知道，有时候我们真的"}, {"type": "subtitle", "time": 1938.63, "timestamp": "00:32:18", "text": "需要这样一个朋友，一个在你身边支持"}, {"type": "subtitle", "time": 1941.35, "timestamp": "00:32:21", "text": "你的人，一个知道"}, {"type": "subtitle", "time": 1943.99, "timestamp": "00:32:23", "text": "你每天都在多么努力工作，"}, {"type": "subtitle", "time": 1946.71, "timestamp": "00:32:26", "text": "但却"}, {"type": "subtitle", "time": 1949.75, "timestamp": "00:32:29", "text": "没有"}, {"type": "subtitle", "time": 1951.99, "timestamp": "00:32:31", "text": "时间陪伴"}, {"type": "subtitle", "time": 1953.909, "timestamp": "00:32:33", "text": "你、"}, {"type": "subtitle", "time": 1957.669, "timestamp": "00:32:37", "text": "和你聊天、和你一起出去玩的朋友。"}, {"type": "subtitle", "time": 1960.47, "timestamp": "00:32:40", "text": "你意识到它有多么……该"}, {"type": "subtitle", "time": 1963.35, "timestamp": "00:32:43", "text": "怎么称呼它呢？"}, {"type": "subtitle", "time": 1966.47, "timestamp": "00:32:46", "text": "他们的日程安排真繁忙。 但"}, {"type": "subtitle", "time": 1969.43, "timestamp": "00:32:49", "text": "作为一个人，你仍然会想要主动"}, {"type": "subtitle", "time": 1971.19, "timestamp": "00:32:51", "text": "联系他们，说：“是的，"}, {"type": "subtitle", "time": 1975.669, "timestamp": "00:32:55", "text": "停下来一会儿。” 先"}, {"type": "subtitle", "time": 1977.75, "timestamp": "00:32:57", "text": "冷静一下"}, {"type": "subtitle", "time": 1979.99, "timestamp": "00:32:59", "text": "。 不要想其他任何事"}]
[{"type": "subtitle", "time": 1561.35, "timestamp": "00:26:01", "text": "这只是一场梦。 我简直无法"}, {"type": "subtitle", "time": 1565.35, "timestamp": "00:26:05", "text": "想象在"}, {"type": "subtitle", "time": 1568.63, "timestamp": "00:26:08", "text": "日本，特别是东京，开出租车之类的会是什么感觉"}, {"type": "subtitle", "time": 1571.11, "timestamp": "00:26:11", "text": "。"}, {"type": "subtitle", "time": 1574.07, "timestamp": "00:26:14", "text": "糟糕，那里肯定会非常拥挤"}, {"type": "subtitle", "time": 1585.83, "timestamp": "00:26:25", "text": "嗯，我最近意识到一件事，"}, {"type": "subtitle", "time": 1591.83, "timestamp": "00:26:31", "text": "嗯，"}, {"type": "subtitle", "time": 1595.11, "timestamp": "00:26:35", "text": "如果你没注意到的话，我每个月大约每两到"}, {"type": "subtitle", "time": 1597.19, "timestamp": "00:26:37", "text": "三周就会"}, {"type": "subtitle", "time": 1602.789, "timestamp": "00:26:42", "text": "生病，对吧？"}, {"type": "subtitle", "time": 1605.99, "timestamp": "00:26:45", "text": "我不知道你们有没有注意到，今天早上"}, {"type": "subtitle", "time": 1610.549, "timestamp": "00:26:50", "text": "，"}, {"type": "subtitle", "time": 1614.87, "timestamp": "00:26:54", "text": "我"}, {"type": "subtitle", "time": 1618.63, "timestamp": "00:26:58", "text": "去库纳纳之后就发烧了。 回来"}]
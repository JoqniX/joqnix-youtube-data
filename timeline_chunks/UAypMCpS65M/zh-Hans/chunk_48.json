[{"type": "subtitle", "time": 2882.95, "timestamp": "00:48:02", "text": "好吧。嗯，所以我今天有了灵感。"}, {"type": "subtitle", "time": 2885.829, "timestamp": "00:48:05", "text": "嗯，有一个日本YouTuber，嗯，他会引用"}, {"type": "subtitle", "time": 2887.829, "timestamp": "00:48:07", "text": "自己网站上的内容"}, {"type": "subtitle", "time": 2890.55, "timestamp": "00:48:10", "text": "等等。嗯，我碰巧 我看到他们的"}, {"type": "subtitle", "time": 2894.39, "timestamp": "00:48:14", "text": "一个网站，我手机上装了他们的"}, {"type": "subtitle", "time": 2896.71, "timestamp": "00:48:16", "text": "应用。所以"}, {"type": "subtitle", "time": 2898.87, "timestamp": "00:48:18", "text": "我偶尔会看看他们的"}, {"type": "subtitle", "time": 2902.79, "timestamp": "00:48:22", "text": "博客什么的。然后"}, {"type": "subtitle", "time": 2905.27, "timestamp": "00:48:25", "text": "我碰巧看到他们的"}, {"type": "subtitle", "time": 2918.309, "timestamp": "00:48:38", "text": "网站上有个游戏专区，里面有"}, {"type": "subtitle", "time": 2922.15, "timestamp": "00:48:42", "text": "她直播过的所有游戏，包括已经直播"}, {"type": "subtitle", "time": 2925.43, "timestamp": "00:48:45", "text": "过的和正在直播的，她都会"}, {"type": "subtitle", "time": 2929.109, "timestamp": "00:48:49", "text": "给出星级评价，比如"}, {"type": "subtitle", "time": 2932.069, "timestamp": "00:48:52", "text": "五星。"}, {"type": "subtitle", "time": 2935.67, "timestamp": "00:48:55", "text": "这个专区分成了“正在玩”和“正在直播”之类的几个部分，"}]
[{"type": "subtitle", "time": 3540.549, "timestamp": "00:59:00", "text": "她提到她完全"}, {"type": "subtitle", "time": 3543.67, "timestamp": "00:59:03", "text": "不在乎数据，但"}, {"type": "subtitle", "time": 3545.91, "timestamp": "00:59:05", "text": "为了实现"}, {"type": "subtitle", "time": 3548.15, "timestamp": "00:59:08", "text": "你想要的一切，实现你的梦想，努力"}, {"type": "subtitle", "time": 3551.27, "timestamp": "00:59:11", "text": "去做，让它"}, {"type": "subtitle", "time": 3553.589, "timestamp": "00:59:13", "text": "成功，让它实现你的梦想，"}, {"type": "subtitle", "time": 3556.63, "timestamp": "00:59:16", "text": "你必须…… 达到那个"}, {"type": "subtitle", "time": 3561.51, "timestamp": "00:59:21", "text": "程度，"}, {"type": "subtitle", "time": 3563.91, "timestamp": "00:59:23", "text": "作为一项数字选择，它就足够好了，足够好到"}, {"type": "subtitle", "time": 3566.71, "timestamp": "00:59:26", "text": "能给你带来更多机会等等，对吧？"}, {"type": "subtitle", "time": 3569.349, "timestamp": "00:59:29", "text": "她刚才说"}, {"type": "subtitle", "time": 3572.63, "timestamp": "00:59:32", "text": "她很幸运，职业生涯"}, {"type": "subtitle", "time": 3577.51, "timestamp": "00:59:37", "text": "早期就达到了那个阶段"}, {"type": "subtitle", "time": 3582.15, "timestamp": "00:59:42", "text": "。"}, {"type": "subtitle", "time": 3585.27, "timestamp": "00:59:45", "text": "所以，我就想，每个人的"}, {"type": "subtitle", "time": 3589.27, "timestamp": "00:59:49", "text": "经历都不一样，有些人"}, {"type": "subtitle", "time": 3596.47, "timestamp": "00:59:56", "text": "成长得很快，有些人成长得比较慢等等。"}, {"type": "subtitle", "time": 3598.63, "timestamp": "00:59:58", "text": "关键在于你如何面对所有这些"}]
[{"type": "subtitle", "time": 3012.47, "timestamp": "00:50:12", "text": "时间越长，"}, {"type": "subtitle", "time": 3014.87, "timestamp": "00:50:14", "text": "我的灵感就越多。我做了很多"}, {"type": "subtitle", "time": 3023.99, "timestamp": "00:50:23", "text": "但最终，我相信，也希望"}, {"type": "subtitle", "time": 3028.069, "timestamp": "00:50:28", "text": "它能"}, {"type": "subtitle", "time": 3031.589, "timestamp": "00:50:31", "text": "对你们社区的各位有所帮助。Shane"}, {"type": "subtitle", "time": 3034.15, "timestamp": "00:50:34", "text": "，"}, {"type": "subtitle", "time": 3037.91, "timestamp": "00:50:37", "text": "这就是我唯一的愿望。"}, {"type": "subtitle", "time": 3039.75, "timestamp": "00:50:39", "text": "所以，"}, {"type": "subtitle", "time": 3042.39, "timestamp": "00:50:42", "text": "嗯。如果你想让我给"}, {"type": "subtitle", "time": 3045.589, "timestamp": "00:50:45", "text": "你看看我刚才说的那些"}, {"type": "subtitle", "time": 3050.069, "timestamp": "00:50:50", "text": "灵感来源，让我慢慢站起来。嗯，"}, {"type": "subtitle", "time": 3053.67, "timestamp": "00:50:53", "text": "我现在姿势有点怪"}, {"type": "subtitle", "time": 3055.829, "timestamp": "00:50:55", "text": "。"}, {"type": "chat", "time": 3059.652, "timestamp": "00:50:59", "author": "@ogbluealien", "avatar": "https://yt4.ggpht.com/kiZ3VTdjn3AS-JTnZV0Knzaa5v1Dk1BttGbjFA5CUBf-41f-rGfxFChEJlSkv4jicC8lwTvNdw=s64-c-k-c0x00ffffff-no-rj", "message": "hello Joq,, "}]
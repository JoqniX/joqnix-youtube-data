[{"type": "subtitle", "time": 2942.39, "timestamp": "00:49:02", "text": "现在好像是一个系列。她比较喜欢"}, {"type": "subtitle", "time": 2945.75, "timestamp": "00:49:05", "text": "玩老游戏，"}, {"type": "subtitle", "time": 2948.87, "timestamp": "00:49:08", "text": "比如任天堂Switch和"}, {"type": "subtitle", "time": 2953.589, "timestamp": "00:49:13", "text": "任天堂DS上的游戏，还有像《超级马里奥64》之类的，"}, {"type": "subtitle", "time": 2956.95, "timestamp": "00:49:16", "text": "所有那些马里奥游戏，以及所有那些"}, {"type": "subtitle", "time": 2960.069, "timestamp": "00:49:20", "text": "很酷的冒险类MMO游戏，"}, {"type": "subtitle", "time": 2971.67, "timestamp": "00:49:31", "text": "所以"}, {"type": "subtitle", "time": 2975.03, "timestamp": "00:49:35", "text": "我就想，“哦，我可以做这个，因为我"}, {"type": "subtitle", "time": 2977.91, "timestamp": "00:49:37", "text": "可以用Notion来做。”  “我频道里有个"}, {"type": "subtitle", "time": 2979.829, "timestamp": "00:49:39", "text": "数据库，记录了我玩过的所有游戏"}, {"type": "subtitle", "time": 2981.829, "timestamp": "00:49:41", "text": "，"}, {"type": "subtitle", "time": 2985.27, "timestamp": "00:49:45", "text": "对吧？”然后"}, {"type": "subtitle", "time": 2989.27, "timestamp": "00:49:49", "text": "用它来……"}, {"type": "subtitle", "time": 2990.87, "timestamp": "00:49:50", "text": "嗯，我之前没想过这个。"}, {"type": "subtitle", "time": 2992.549, "timestamp": "00:49:52", "text": "其实，这确实挺"}, {"type": "subtitle", "time": 2994.069, "timestamp": "00:49:54", "text": "有道理的。"}, {"type": "subtitle", "time": 2996.47, "timestamp": "00:49:56", "text": "这样，想知道"}, {"type": "subtitle", "time": 2998.71, "timestamp": "00:49:58", "text": "我玩过哪些游戏的人，就可以"}]
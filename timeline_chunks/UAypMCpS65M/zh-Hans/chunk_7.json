[{"type": "chat", "time": 422.265, "timestamp": "00:07:02", "author": "@kagami_tsukuyo", "avatar": "https://yt4.ggpht.com/K66mJIs5V3KzGLYSWraThSABbaCyYZBrOzSWyqsf_lfng2DzR9UpfpsccdViSMQXpqdKyjNeMtg=s64-c-k-c0x00ffffff-no-rj", "message": "get well soon"}, {"type": "subtitle", "time": 422.87, "timestamp": "00:07:02", "text": "死吗？ 嗨，是"}, {"type": "subtitle", "time": 426.95, "timestamp": "00:07:06", "text": "啊，我的嗓子……哑了。"}, {"type": "subtitle", "time": 428.469, "timestamp": "00:07:08", "text": "嗯，是的"}, {"type": "subtitle", "time": 433.11, "timestamp": "00:07:13", "text": "，昨天我觉得我……"}, {"type": "subtitle", "time": 435.67, "timestamp": "00:07:15", "text": "我是不是太勉强自己了？"}, {"type": "subtitle", "time": 438.39, "timestamp": "00:07:18", "text": "我昨天直播了多久？ 深夜。 我"}, {"type": "subtitle", "time": 440.309, "timestamp": "00:07:20", "text": "其实不想直播，但后来"}, {"type": "subtitle", "time": 443.43, "timestamp": "00:07:23", "text": "又想，“是啊，你必须直播。"}, {"type": "subtitle", "time": 449.909, "timestamp": "00:07:29", "text": "去日本之前你必须坚持一年。我必须这么做"}, {"type": "subtitle", "time": 451.67, "timestamp": "00:07:31", "text": "。” 所以我就想，“好吧，行。我"}, {"type": "subtitle", "time": 454.55, "timestamp": "00:07:34", "text": "不会错过‘信息马拉松’日的。” 所以我"}, {"type": "subtitle", "time": 458.07, "timestamp": "00:07:38", "text": "就想，好吧，我照做就行了。"}, {"type": "subtitle", "time": 461.11, "timestamp": "00:07:41", "text": "我照做就行了。然后我就做了。是的。"}, {"type": "subtitle", "time": 464.629, "timestamp": "00:07:44", "text": "昨天那次是在两个小时"}, {"type": "subtitle", "time": 466.55, "timestamp": "00:07:46", "text": "后，我不小心让"}, {"type": "subtitle", "time": 469.99, "timestamp": "00:07:49", "text": "雨水灌进了我的头里，呃，当时"}, {"type": "subtitle", "time": 473.43, "timestamp": "00:07:53", "text": "我刚从直播间出来。我得先"}, {"type": "subtitle", "time": 476.39, "timestamp": "00:07:56", "text": "出门，然后再从"}]
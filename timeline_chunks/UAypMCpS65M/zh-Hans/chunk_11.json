[{"type": "subtitle", "time": 663.19, "timestamp": "00:11:03", "text": "我必须振作起来。 你"}, {"type": "subtitle", "time": 666.23, "timestamp": "00:11:06", "text": "知道起床就像"}, {"type": "subtitle", "time": 669.43, "timestamp": "00:11:09", "text": "消耗10点能量一样吗？   呃，"}, {"type": "subtitle", "time": 674.55, "timestamp": "00:11:14", "text": "拿到包之后，我立刻"}, {"type": "subtitle", "time": 677.99, "timestamp": "00:11:17", "text": "去了附近的警察局，他们帮"}, {"type": "subtitle", "time": 681.19, "timestamp": "00:11:21", "text": "我处理了消费税、个体户"}, {"type": "subtitle", "time": 683.35, "timestamp": "00:11:23", "text": "注册之类的事情，"}, {"type": "subtitle", "time": 686.949, "timestamp": "00:11:26", "text": "现在为了"}, {"type": "subtitle", "time": 690.55, "timestamp": "00:11:30", "text": "隐藏我的名字，我"}, {"type": "subtitle", "time": 694.069, "timestamp": "00:11:34", "text": "得做很多事情。"}, {"type": "subtitle", "time": 697.67, "timestamp": "00:11:37", "text": "嗯，我去问了"}, {"type": "subtitle", "time": 699.43, "timestamp": "00:11:39", "text": "关于版权的"}, {"type": "subtitle", "time": 702.15, "timestamp": "00:11:42", "text": "事情该怎么办，他们说不知道。"}, {"type": "subtitle", "time": 704.63, "timestamp": "00:11:44", "text": "所以他们会打电话给某个律师或者"}, {"type": "subtitle", "time": 706.63, "timestamp": "00:11:46", "text": "他们认识的人，"}, {"type": "subtitle", "time": 708.71, "timestamp": "00:11:48", "text": "显然这个人认识孟买的人，"}, {"type": "subtitle", "time": 713.35, "timestamp": "00:11:53", "text": "他们会去问问，然后告诉"}, {"type": "subtitle", "time": 716.63, "timestamp": "00:11:56", "text": "我结果之类的，他们是这么说的。"}, {"type": "subtitle", "time": 719.59, "timestamp": "00:11:59", "text": "所以我不得不等这些支付"}]
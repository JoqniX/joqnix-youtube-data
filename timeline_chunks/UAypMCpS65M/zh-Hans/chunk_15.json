[{"type": "subtitle", "time": 900.23, "timestamp": "00:15:00", "text": "小贩那种。 但是他们做的"}, {"type": "subtitle", "time": 903.189, "timestamp": "00:15:03", "text": "鲜榨果汁什么的都很好。"}, {"type": "subtitle", "time": 912.87, "timestamp": "00:15:12", "text": "我和穆西一起去了。 嗯，"}, {"type": "subtitle", "time": 915.67, "timestamp": "00:15:15", "text": "那不错。 但是当我把"}, {"type": "subtitle", "time": 918.949, "timestamp": "00:15:18", "text": "琴弦穿好后，我的喉咙就开始"}, {"type": "subtitle", "time": 922.47, "timestamp": "00:15:22", "text": "发干，我心想：“哦不，我"}, {"type": "subtitle", "time": 925.269, "timestamp": "00:15:25", "text": "要脱水了。” 没有。 我"}, {"type": "subtitle", "time": 933.99, "timestamp": "00:15:33", "text": "从早上开始就一直吞咽困难。 是的，我"}, {"type": "subtitle", "time": 936.79, "timestamp": "00:15:36", "text": "之前提到的黄瓜，"}, {"type": "subtitle", "time": 938.389, "timestamp": "00:15:38", "text": "对吧？"}, {"type": "subtitle", "time": 941.509, "timestamp": "00:15:41", "text": "显然，我爸今天买了很多"}, {"type": "subtitle", "time": 944.55, "timestamp": "00:15:44", "text": "黄瓜回家，因为"}, {"type": "subtitle", "time": 947.829, "timestamp": "00:15:47", "text": "他"}, {"type": "subtitle", "time": 950.55, "timestamp": "00:15:50", "text": "明天早上八点要出门办点事什么的。所以，我"}, {"type": "subtitle", "time": 954.15, "timestamp": "00:15:54", "text": "现在也得照顾家人，"}, {"type": "subtitle", "time": 956.79, "timestamp": "00:15:56", "text": "即使生病也要把事情处理好。 但那"}, {"type": "subtitle", "time": 959.03, "timestamp": "00:15:59", "text": "是其中一件事。 是啊，"}]
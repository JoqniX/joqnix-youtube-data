[{"type": "subtitle", "time": 8521.99, "timestamp": "02:22:01", "text": "执着于金钱，我必须赚钱，"}, {"type": "subtitle", "time": 8524.95, "timestamp": "02:22:04", "text": "我必须赚钱，等等等等。"}, {"type": "subtitle", "time": 8528.309, "timestamp": "02:22:08", "text": "最初是因为"}, {"type": "subtitle", "time": 8530.469, "timestamp": "02:22:10", "text": "我作为模特所处的这种不幸境地，对吧？"}, {"type": "subtitle", "time": 8535.19, "timestamp": "02:22:15", "text": "这就是我如此"}, {"type": "subtitle", "time": 8538.87, "timestamp": "02:22:18", "text": "专注于金钱的唯一原因。有时候，"}, {"type": "subtitle", "time": 8541.91, "timestamp": "02:22:21", "text": "我会在夜里哭泣，思考"}, {"type": "subtitle", "time": 8545.429, "timestamp": "02:22:25", "text": "我的处境，然后问自己：天哪，"}, {"type": "subtitle", "time": 8547.67, "timestamp": "02:22:27", "text": "我做这件事是为了赚钱，还是把"}, {"type": "subtitle", "time": 8550.389, "timestamp": "02:22:30", "text": "它当作一种爱好，让我真正"}, {"type": "subtitle", "time": 8553.75, "timestamp": "02:22:33", "text": "享受其中？"}, {"type": "subtitle", "time": 8555.99, "timestamp": "02:22:35", "text": "这就是我的概括。 就像"}, {"type": "subtitle", "time": 8559.99, "timestamp": "02:22:39", "text": "他们最近"}, {"type": "subtitle", "time": 8562.63, "timestamp": "02:22:42", "text": "时不时会出现那种情况一样。 我"}, {"type": "subtitle", "time": 8564.95, "timestamp": "02:22:44", "text": "心想，唉，"}, {"type": "subtitle", "time": 8567.59, "timestamp": "02:22:47", "text": "这事儿没完没了了。"}, {"type": "subtitle", "time": 8569.75, "timestamp": "02:22:49", "text": "我应该干脆放弃一切吗"}, {"type": "subtitle", "time": 8571.83, "timestamp": "02:22:51", "text": "？"}, {"type": "subtitle", "time": 8573.91, "timestamp": "02:22:53", "text": "这些念头会一直萦绕在我心头，我会想："}, {"type": "subtitle", "time": 8576.71, "timestamp": "02:22:56", "text": "老兄，别这样，"}]
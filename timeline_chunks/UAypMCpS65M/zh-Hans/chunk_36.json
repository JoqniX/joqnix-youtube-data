[{"type": "subtitle", "time": 2164.55, "timestamp": "00:36:04", "text": "当我快要打喷嚏的时候，我会把"}, {"type": "subtitle", "time": 2168.39, "timestamp": "00:36:08", "text": "麦克风静音。 好的。 呃，太尴尬了。"}, {"type": "subtitle", "time": 2170.55, "timestamp": "00:36:10", "text": "让你们"}, {"type": "subtitle", "time": 2187.349, "timestamp": "00:36:27", "text": "嗨。 嗯，我原本应该"}, {"type": "subtitle", "time": 2191.19, "timestamp": "00:36:31", "text": "把一些黄瓜带到我"}, {"type": "subtitle", "time": 2193.829, "timestamp": "00:36:33", "text": "房间的楼上去。"}, {"type": "subtitle", "time": 2197.75, "timestamp": "00:36:37", "text": "呃，但我做不到。"}, {"type": "subtitle", "time": 2201.19, "timestamp": "00:36:41", "text": "为什么不带点……"}, {"type": "subtitle", "time": 2204.55, "timestamp": "00:36:44", "text": "嗯……为什么不带点黄瓜，让我"}]
[{"type": "subtitle", "time": 482.469, "timestamp": "00:08:02", "text": "后门进去。呃，所以我的头里进了点雨水"}, {"type": "subtitle", "time": 487.35, "timestamp": "00:08:07", "text": "。我忘了戴帽子。嗯，"}, {"type": "subtitle", "time": 489.43, "timestamp": "00:08:09", "text": "我通常戴帽子是为了保护"}, {"type": "subtitle", "time": 491.029, "timestamp": "00:08:11", "text": "头部，防止生病。"}, {"type": "subtitle", "time": 493.589, "timestamp": "00:08:13", "text": "昨天我忘了。是的，"}, {"type": "subtitle", "time": 496.71, "timestamp": "00:08:16", "text": "呃，早上我连自己"}, {"type": "subtitle", "time": 500.95, "timestamp": "00:08:20", "text": "的口水都咽不下去，也喝不了水。"}, {"type": "subtitle", "time": 504.15, "timestamp": "00:08:24", "text": "太疼了。"}, {"type": "subtitle", "time": 508.79, "timestamp": "00:08:28", "text": "但我呃，我吃了药，还有"}, {"type": "subtitle", "time": 513.19, "timestamp": "00:08:33", "text": "什么来着？大蒜。"}, {"type": "subtitle", "time": 516.469, "timestamp": "00:08:36", "text": "所以我吃了药，"}, {"type": "subtitle", "time": 520.31, "timestamp": "00:08:40", "text": "然后我今天还得去银行，呃，办"}, {"type": "subtitle", "time": 525.19, "timestamp": "00:08:45", "text": "UPI的事情。不，"}, {"type": "subtitle", "time": 528.87, "timestamp": "00:08:48", "text": "搞笑的是，我去的时候离"}, {"type": "subtitle", "time": 531.829, "timestamp": "00:08:51", "text": "银行关门只有5分钟了。"}, {"type": "subtitle", "time": 535.99, "timestamp": "00:08:55", "text": "简直疯了。我当时躺在床上，"}, {"type": "subtitle", "time": 539.59, "timestamp": "00:08:59", "text": "纠结要不要去。去还是不去？"}]
[{"type": "subtitle", "time": 1626.95, "timestamp": "00:27:06", "text": "之后，大概在"}, {"type": "subtitle", "time": 1632.63, "timestamp": "00:27:12", "text": "三月、四月、五月的时候，我又生病了。 呃，四月份我"}, {"type": "subtitle", "time": 1635.35, "timestamp": "00:27:15", "text": "又生病了，"}, {"type": "subtitle", "time": 1637.11, "timestamp": "00:27:17", "text": "因为一些我不知道的原因。"}, {"type": "subtitle", "time": 1640.07, "timestamp": "00:27:20", "text": "呃，我觉得我生病了。 是的。 是的。"}, {"type": "subtitle", "time": 1645.83, "timestamp": "00:27:25", "text": "精疲力竭。   感觉"}, {"type": "subtitle", "time": 1649.75, "timestamp": "00:27:29", "text": "像是生病了。 六月份，"}, {"type": "subtitle", "time": 1653.669, "timestamp": "00:27:33", "text": "因为随之而来的"}, {"type": "subtitle", "time": 1655.75, "timestamp": "00:27:35", "text": "合作以及"}, {"type": "subtitle", "time": 1657.909, "timestamp": "00:27:37", "text": "很多其他事情，我确实感到很不舒服。"}, {"type": "subtitle", "time": 1668.47, "timestamp": "00:27:48", "text": "嗨，"}, {"type": "subtitle", "time": 1673.99, "timestamp": "00:27:53", "text": "我今天看了个视频，嗯，是"}, {"type": "subtitle", "time": 1677.75, "timestamp": "00:27:57", "text": "一个叫……的人拍的，嗯，"}]
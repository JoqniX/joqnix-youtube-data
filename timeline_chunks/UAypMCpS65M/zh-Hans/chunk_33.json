[{"type": "subtitle", "time": 1983.59, "timestamp": "00:33:03", "text": "。 你只需要关注我。"}, {"type": "subtitle", "time": 1986.389, "timestamp": "00:33:06", "text": "专注于你面前的事情，专注于"}, {"type": "subtitle", "time": 1989.75, "timestamp": "00:33:09", "text": "你眼前的事情，"}, {"type": "subtitle", "time": 1993.83, "timestamp": "00:33:13", "text": "放松一下。 是啊，我"}, {"type": "subtitle", "time": 2004.63, "timestamp": "00:33:24", "text": "现在想找到一个好朋友真的很难，仔细"}, {"type": "subtitle", "time": 2007.59, "timestamp": "00:33:27", "text": "想想。"}, {"type": "subtitle", "time": 2011.11, "timestamp": "00:33:31", "text": "我当时就想：“哇。”"}, {"type": "subtitle", "time": 2015.19, "timestamp": "00:33:35", "text": "太酷了。 我也希望有人"}, {"type": "subtitle", "time": 2018.389, "timestamp": "00:33:38", "text": "能注意到我的坏习惯，"}, {"type": "subtitle", "time": 2021.509, "timestamp": "00:33:41", "text": "比如过度工作，我几乎每次都会这样做"}, {"type": "subtitle", "time": 2024.549, "timestamp": "00:33:44", "text": "。"}, {"type": "subtitle", "time": 2028.31, "timestamp": "00:33:48", "text": "嗯，就想办法让"}, {"type": "subtitle", "time": 2031.43, "timestamp": "00:33:51", "text": "我停下来一会儿，"}, {"type": "subtitle", "time": 2033.83, "timestamp": "00:33:53", "text": "放松一下。"}, {"type": "subtitle", "time": 2037.669, "timestamp": "00:33:57", "text": "你知道，我有点像个小孩子，"}]
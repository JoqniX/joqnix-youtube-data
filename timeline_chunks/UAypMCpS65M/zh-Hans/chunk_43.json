[{"type": "subtitle", "time": 2611.109, "timestamp": "00:43:31", "text": "玛雅，"}, {"type": "subtitle", "time": 2620.069, "timestamp": "00:43:40", "text": "有时候我觉得我不知道自己在"}, {"type": "subtitle", "time": 2622.23, "timestamp": "00:43:42", "text": "说什么，我生病了，"}, {"type": "subtitle", "time": 2625.99, "timestamp": "00:43:45", "text": "我不知道什么时候会有这种感觉，"}, {"type": "subtitle", "time": 2628.87, "timestamp": "00:43:48", "text": "我生病的时候，现在我会一直"}, {"type": "subtitle", "time": 2631.43, "timestamp": "00:43:51", "text": "说一些我"}, {"type": "subtitle", "time": 2635.03, "timestamp": "00:43:55", "text": "不应该说的话，"}]
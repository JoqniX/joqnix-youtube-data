[{"type": "subtitle", "time": 2764.79, "timestamp": "00:46:04", "text": "我觉得我……我需要……我不知道 我"}, {"type": "subtitle", "time": 2768.55, "timestamp": "00:46:08", "text": "知道。冒名顶替综合症，兄弟。"}, {"type": "subtitle", "time": 2772.98, "timestamp": "00:46:12", "text": "主要是冒名顶替综合症。"}, {"type": "subtitle", "time": 2782.069, "timestamp": "00:46:22", "text": "嗯，是的，有很多事情"}, {"type": "subtitle", "time": 2786.79, "timestamp": "00:46:26", "text": "我希望，嗯，我就像在闲逛，嗯，不是"}, {"type": "subtitle", "time": 2790.15, "timestamp": "00:46:30", "text": "闲逛，更像是聊天，好吧，还有一些"}, {"type": "subtitle", "time": 2792.71, "timestamp": "00:46:32", "text": "时候，我会在短"}, {"type": "subtitle", "time": 2801.03, "timestamp": "00:46:41", "text": "现在我意识到，文化上它如此"}, {"type": "subtitle", "time": 2802.79, "timestamp": "00:46:42", "text": "不同，"}, {"type": "subtitle", "time": 2806.39, "timestamp": "00:46:46", "text": "但又如此相似，但也"}, {"type": "subtitle", "time": 2808.47, "timestamp": "00:46:48", "text": "如此不同，对吧"}, {"type": "subtitle", "time": 2811.27, "timestamp": "00:46:51", "text": "。"}, {"type": "subtitle", "time": 2815.27, "timestamp": "00:46:55", "text": "我觉得慢慢地，"}, {"type": "subtitle", "time": 2818.069, "timestamp": "00:46:58", "text": "大多数印度人，他们正在慢慢地"}]
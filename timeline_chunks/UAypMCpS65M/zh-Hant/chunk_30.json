[{"type": "subtitle", "time": 1813.35, "timestamp": "00:30:13", "text": "是的，昨天我寫了過去兩週所有的直播總結。呃"}, {"type": "subtitle", "time": 1822.63, "timestamp": "00:30:22", "text": "，那相當於每天直播兩週的量"}, {"type": "subtitle", "time": 1825.83, "timestamp": "00:30:25", "text": "。所以總共"}, {"type": "subtitle", "time": 1854.07, "timestamp": "00:30:54", "text": "有 23 個流"}, {"type": "subtitle", "time": 1857.83, "timestamp": "00:30:57", "text": "，對吧？兩到三週。是的。完成摘要。  速度決定一切。  [音樂] 嗯，是的，我已經盡力了"}]
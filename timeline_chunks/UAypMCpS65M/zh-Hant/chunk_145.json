[{"type": "subtitle", "time": 8703.59, "timestamp": "02:25:03", "text": "不幸境地，對吧？這就是我的概括。"}, {"type": "subtitle", "time": 8712.309, "timestamp": "02:25:12", "text": "就像他們"}, {"type": "subtitle", "time": 8735.03, "timestamp": "02:25:35", "text": "最近時不時會出現那種情況一樣。不，我想停止玩漂流。這可不是一兩件事就能解決的。一樣，好的部分，壞的部分，所有的一切，但我一直熱愛生活中的一件事。"}, {"type": "chat", "time": 8742.277, "timestamp": "02:25:42", "author": "@sarthaksharma2476", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kmJohYAdmpQzCNN96t58cLSK8spv6Y2ITutBFF9nvi9Z8=s64-c-k-c0x00ffffff-no-rj", "message": "listen to this"}, {"type": "chat", "time": 8745.817, "timestamp": "02:25:45", "author": "@sarthaksharma2476", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kmJohYAdmpQzCNN96t58cLSK8spv6Y2ITutBFF9nvi9Z8=s64-c-k-c0x00ffffff-no-rj", "message": "i go now"}, {"type": "chat", "time": 8759.988, "timestamp": "02:25:59", "author": "@sarthaksharma2476", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kmJohYAdmpQzCNN96t58cLSK8spv6Y2ITutBFF9nvi9Z8=s64-c-k-c0x00ffffff-no-rj", "message": "bye"}]
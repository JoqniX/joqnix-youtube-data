[{"type": "subtitle", "time": 663.19, "timestamp": "00:11:03", "text": "我就做了。是的。昨天那次是在兩個小時後，我不小心讓雨水灌進了我的頭裡，呃，當時我剛從直播間出來。我得先出門，再從"}, {"type": "subtitle", "time": 666.23, "timestamp": "00:11:06", "text": "後門進去。呃，所以我的頭進了點"}, {"type": "subtitle", "time": 669.43, "timestamp": "00:11:09", "text": "雨水。我忘了戴帽子。嗯，我通常戴帽子是為了保護頭部，防止生病。"}, {"type": "subtitle", "time": 686.949, "timestamp": "00:11:26", "text": "昨天"}, {"type": "subtitle", "time": 702.15, "timestamp": "00:11:42", "text": "我忘了。是的，呃，早上我連自己的口水都吞不下去，也喝不了水。太痛了。但"}]
[{"type": "subtitle", "time": 3194.15, "timestamp": "00:53:14", "text": "她用這個糟糕的模型等等，製作了很多很棒的內容。她"}, {"type": "subtitle", "time": 3196.549, "timestamp": "00:53:16", "text": "是個風趣幽默、非常有趣的人。  所以，"}, {"type": "subtitle", "time": 3205.27, "timestamp": "00:53:25", "text": "這讓我想起來，天哪，菲爾簡直跟我一模一樣。我好像從來沒有休息日，"}, {"type": "subtitle", "time": 3231.27, "timestamp": "00:53:51", "text": "對吧？我一直忙個不停，讓我的行程安排得滿滿噹噹。你好，Aditi。"}, {"type": "subtitle", "time": 3239.99, "timestamp": "00:53:59", "text": "遲來的友誼日快樂！  [音樂] 你"}]
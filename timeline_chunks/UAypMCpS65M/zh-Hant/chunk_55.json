[{"type": "subtitle", "time": 3304.309, "timestamp": "00:55:04", "text": "三檔，"}, {"type": "subtitle", "time": 3315.589, "timestamp": "00:55:15", "text": "它真的只有兩檔風速。"}, {"type": "subtitle", "time": 3318.71, "timestamp": "00:55:18", "text": "但是每次"}, {"type": "subtitle", "time": 3322.309, "timestamp": "00:55:22", "text": "風扇吹到我身上，我都覺得超級冷"}, {"type": "subtitle", "time": 3352.15, "timestamp": "00:55:52", "text": "我不能直視顯示器，因為看得越久越"}]
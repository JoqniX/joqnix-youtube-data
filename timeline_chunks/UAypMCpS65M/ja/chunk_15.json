[{"type": "subtitle", "time": 900.23, "timestamp": "00:15:00", "text": "露天商みたいな感じ。 でも、彼らは"}, {"type": "subtitle", "time": 903.189, "timestamp": "00:15:03", "text": "美味しいフレッシュジュースとか色々作ってるんですよ。"}, {"type": "subtitle", "time": 912.87, "timestamp": "00:15:12", "text": "私は音楽と一緒に行った。 ああ、良かったよ"}, {"type": "subtitle", "time": 915.67, "timestamp": "00:15:15", "text": "。 でも"}, {"type": "subtitle", "time": 918.949, "timestamp": "00:15:18", "text": "弦を張り終えた途端、喉が"}, {"type": "subtitle", "time": 922.47, "timestamp": "00:15:22", "text": "乾き始めて、「ああ、"}, {"type": "subtitle", "time": 925.269, "timestamp": "00:15:25", "text": "脱水症状になりそうだ」と思ったんです。 そこには何もありませんでした。 そして、"}, {"type": "subtitle", "time": 933.99, "timestamp": "00:15:33", "text": "朝から「いいえ」と言うのがうまくできなかったんです。 そうそう、"}, {"type": "subtitle", "time": 936.79, "timestamp": "00:15:36", "text": "さっきキュウリについて話したよ"}, {"type": "subtitle", "time": 938.389, "timestamp": "00:15:38", "text": "ね？"}, {"type": "subtitle", "time": 941.509, "timestamp": "00:15:41", "text": "どうやら父は明日午前8時に"}, {"type": "subtitle", "time": 947.829, "timestamp": "00:15:47", "text": "仕事か"}, {"type": "subtitle", "time": 950.55, "timestamp": "00:15:50", "text": "何かで出かけるので、今日はきゅうりをたくさん買ってきてくれたらしい。だから、私も"}, {"type": "subtitle", "time": 956.79, "timestamp": "00:15:56", "text": "病気だけど家族の面倒を見たり、いろいろとやらなきゃいけないんだ。 しかし、"}, {"type": "subtitle", "time": 959.03, "timestamp": "00:15:59", "text": "それは一つのことだ。 ええ、だから"}]
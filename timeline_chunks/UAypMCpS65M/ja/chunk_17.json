[{"type": "subtitle", "time": 1023.35, "timestamp": "00:17:03", "text": "待って、私のモデルがフリーズしてるのかな、いや、"}, {"type": "subtitle", "time": 1026.549, "timestamp": "00:17:06", "text": "昨日、私はすべての要約を書いたような感じだった"}, {"type": "subtitle", "time": 1037.99, "timestamp": "00:17:17", "text": "。ええ、昨日、過去 2 週間のストリームの要約をすべて書きました。 えっと、それは毎日"}, {"type": "subtitle", "time": 1039.99, "timestamp": "00:17:19", "text": "配信すると2週間分くらいになりますね"}, {"type": "subtitle", "time": 1045.429, "timestamp": "00:17:25", "text": "。 つまり、合計23ストリームということですね"}, {"type": "subtitle", "time": 1049.27, "timestamp": "00:17:29", "text": "？  2週間、3週間。 うん。 要約を完成させてください"}, {"type": "subtitle", "time": 1051.909, "timestamp": "00:17:31", "text": "。"}, {"type": "subtitle", "time": 1054.19, "timestamp": "00:17:34", "text": "スピードが勝った。"}, {"type": "subtitle", "time": 1055.909, "timestamp": "00:17:35", "text": "[音楽]"}, {"type": "subtitle", "time": 1062.789, "timestamp": "00:17:42", "text": "。   完了しました"}, {"type": "subtitle", "time": 1075.35, "timestamp": "00:17:55", "text": "ここにいるかどうかわかりませんが、"}, {"type": "subtitle", "time": 1079.59, "timestamp": "00:17:59", "text": "立ち寄ってくれてありがとう。 それは"}]
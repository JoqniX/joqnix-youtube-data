[{"type": "subtitle", "time": 8460.95, "timestamp": "02:21:00", "text": "自分の部屋のどこか、あるいはどこかに"}, {"type": "subtitle", "time": 8465.03, "timestamp": "02:21:05", "text": "私の一部があるのを見れば、あなたは"}, {"type": "subtitle", "time": 8469.51, "timestamp": "02:21:09", "text": "私のことを思い出して、私が忘れられることもないでしょう"}, {"type": "subtitle", "time": 8472.55, "timestamp": "02:21:12", "text": "。 だから私は、「"}, {"type": "chat", "time": 8476.021, "timestamp": "02:21:16", "author": "@sarthaksharma2476", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kmJohYAdmpQzCNN96t58cLSK8spv6Y2ITutBFF9nvi9Z8=s64-c-k-c0x00ffffff-no-rj", "message": "listen to lost sound - distant memories."}, {"type": "subtitle", "time": 8476.309, "timestamp": "02:21:16", "text": "グッズとか全部いいんだけど、"}, {"type": "subtitle", "time": 8483.19, "timestamp": "02:21:23", "text": "私が心配しているのは、ああ、私は"}, {"type": "subtitle", "time": 8485.429, "timestamp": "02:21:25", "text": "今登録済みのビジネスなんだ」って思ったんです。 私は"}, {"type": "subtitle", "time": 8487.19, "timestamp": "02:21:27", "text": "お金を稼がなければならない。"}, {"type": "subtitle", "time": 8491.83, "timestamp": "02:21:31", "text": "えっと、私は毎月GST税を納付しなければなりません"}, {"type": "subtitle", "time": 8493.59, "timestamp": "02:21:33", "text": "。"}, {"type": "subtitle", "time": 8496.15, "timestamp": "02:21:36", "text": "彼らは私に尋ねないだろうか？"}, {"type": "chat", "time": 8499.31, "timestamp": "02:21:39", "author": "@sarthaksharma2476", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kmJohYAdmpQzCNN96t58cLSK8spv6Y2ITutBFF9nvi9Z8=s64-c-k-c0x00ffffff-no-rj", "message": "literally me dude"}, {"type": "subtitle", "time": 8499.429, "timestamp": "02:21:39", "text": "あなたは登録済みの企業で、"}, {"type": "subtitle", "time": 8502.63, "timestamp": "02:21:42", "text": "毎月私たちに釘を打って"}, {"type": "subtitle", "time": 8504.55, "timestamp": "02:21:44", "text": "利益を上げているか何かしている。 もしその"}, {"type": "subtitle", "time": 8507.51, "timestamp": "02:21:47", "text": "質問が私に投げかけられたら、私は「えーっと、"}, {"type": "subtitle", "time": 8514.55, "timestamp": "02:21:54", "text": "どうすればいいの？」と思うでしょう。 私はたくさんのことを知っていて、"}, {"type": "subtitle", "time": 8517.67, "timestamp": "02:21:57", "text": "奇妙な気分です。この気分は実際には悪いもので、"}]
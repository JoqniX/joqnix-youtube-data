[{"type": "subtitle", "time": 10449.67, "timestamp": "02:54:09", "text": "。 もうすぐ"}, {"type": "subtitle", "time": 10456.389, "timestamp": "02:54:16", "text": "症候群は類似している。"}, {"type": "subtitle", "time": 10475.03, "timestamp": "02:54:35", "text": "私は"}, {"type": "subtitle", "time": 10476.95, "timestamp": "02:54:36", "text": "痛みによって脱水症状を起こしているということです。"}, {"type": "subtitle", "time": 10483.11, "timestamp": "02:54:43", "text": "漏れてる。  「あぁ、寒いな」って感じ。"}, {"type": "subtitle", "time": 10486.87, "timestamp": "02:54:46", "text": "ファン速度をファン速度として、"}, {"type": "subtitle", "time": 10489.75, "timestamp": "02:54:49", "text": "ファン速度を2に設定しています。"}, {"type": "subtitle", "time": 10494.55, "timestamp": "02:54:54", "text": "速度は2に設定しているのですが、"}, {"type": "subtitle", "time": 10499.429, "timestamp": "02:54:59", "text": "汗をかくというより、今はすごく寒く感じます。 何が起こっているのか、私にはさっぱり分かりません"}]
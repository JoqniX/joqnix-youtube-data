[{"type": "subtitle", "time": 8703.59, "timestamp": "02:25:03", "text": "シナリオ 1B のようなもの、良い部分、悪い"}, {"type": "subtitle", "time": 8707.349, "timestamp": "02:25:07", "text": "部分、すべて、でも私は"}, {"type": "subtitle", "time": 8709.83, "timestamp": "02:25:09", "text": "人生でいつも 1 つのことを愛していました。 いいえ、人生とは"}, {"type": "subtitle", "time": 8712.309, "timestamp": "02:25:12", "text": "予期せぬ旅なのです。"}, {"type": "subtitle", "time": 8715.11, "timestamp": "02:25:15", "text": "どれだけ"}, {"type": "subtitle", "time": 8718.469, "timestamp": "02:25:18", "text": "未来や過去について考えすぎたり、"}, {"type": "subtitle", "time": 8721.429, "timestamp": "02:25:21", "text": "頭の中でたくさんのシナリオを思い描いたりしても、"}, {"type": "subtitle", "time": 8725.429, "timestamp": "02:25:25", "text": "人生ではいつも予期せぬことが起こる。"}, {"type": "subtitle", "time": 8729.349, "timestamp": "02:25:29", "text": "予想外の展開が、"}, {"type": "subtitle", "time": 8735.03, "timestamp": "02:25:35", "text": "現在の時間軸の中で繰り広げられる。 右。"}, {"type": "subtitle", "time": 8737.349, "timestamp": "02:25:37", "text": "最近、"}, {"type": "subtitle", "time": 8742.23, "timestamp": "02:25:42", "text": "フラッシュの映像とか、"}, {"type": "chat", "time": 8742.277, "timestamp": "02:25:42", "author": "@sarthaksharma2476", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kmJohYAdmpQzCNN96t58cLSK8spv6Y2ITutBFF9nvi9Z8=s64-c-k-c0x00ffffff-no-rj", "message": "listen to this"}, {"type": "subtitle", "time": 8745.27, "timestamp": "02:25:45", "text": "次元間"}, {"type": "chat", "time": 8745.817, "timestamp": "02:25:45", "author": "@sarthaksharma2476", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kmJohYAdmpQzCNN96t58cLSK8spv6Y2ITutBFF9nvi9Z8=s64-c-k-c0x00ffffff-no-rj", "message": "i go now"}, {"type": "subtitle", "time": 8749.19, "timestamp": "02:25:49", "text": "とか多次元的なものの映画をたくさん見るようになったからかな、って思うようになった。タイムラインを"}, {"type": "subtitle", "time": 8753.429, "timestamp": "02:25:53", "text": "追加してるんだけど、俺は"}, {"type": "chat", "time": 8759.988, "timestamp": "02:25:59", "author": "@sarthaksharma2476", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kmJohYAdmpQzCNN96t58cLSK8spv6Y2ITutBFF9nvi9Z8=s64-c-k-c0x00ffffff-no-rj", "message": "bye"}]
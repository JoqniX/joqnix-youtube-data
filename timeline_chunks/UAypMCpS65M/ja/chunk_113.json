[{"type": "subtitle", "time": 6781.35, "timestamp": "01:53:01", "text": "。すべてのプレイリストも確認できます。"}, {"type": "chat", "time": 6784.46, "timestamp": "01:53:04", "author": "@sarthaksharma2476", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kmJohYAdmpQzCNN96t58cLSK8spv6Y2ITutBFF9nvi9Z8=s64-c-k-c0x00ffffff-no-rj", "message": "FINAL FANTASY"}, {"type": "subtitle", "time": 6785.43, "timestamp": "01:53:05", "text": "だから私のアイデアは、"}, {"type": "subtitle", "time": 6790.07, "timestamp": "01:53:10", "text": "これと同じようにして、"}, {"type": "subtitle", "time": 6792.87, "timestamp": "01:53:12", "text": "ストリーム、"}, {"type": "subtitle", "time": 6795.43, "timestamp": "01:53:15", "text": "koke ストリーム、"}, {"type": "subtitle", "time": 6798.55, "timestamp": "01:53:18", "text": "クリエイティブ ストリーム、あれこれ、あれこれを追加するセクションを作ることでした"}, {"type": "subtitle", "time": 6802.39, "timestamp": "01:53:22", "text": "。 わかった。"}, {"type": "subtitle", "time": 6805.03, "timestamp": "01:53:25", "text": "うん。"}, {"type": "subtitle", "time": 6808.149, "timestamp": "01:53:28", "text": "それと、ジョアソンの配信、誕生日"}, {"type": "subtitle", "time": 6811.189, "timestamp": "01:53:31", "text": "配信、プレイリストのリンクみたいなものですよね？"}, {"type": "subtitle", "time": 6813.35, "timestamp": "01:53:33", "text": "人々はプレイリストをクリックして、"}, {"type": "subtitle", "time": 6817.189, "timestamp": "01:53:37", "text": "koka ストリームを取得できます。いいえ、私は"}, {"type": "subtitle", "time": 6819.83, "timestamp": "01:53:39", "text": "テストとして、ここで kok ストリームを少し行いました"}, {"type": "subtitle", "time": 6823.589, "timestamp": "01:53:43", "text": "。 つまり、ヨアトンの時に私はそれをしました。"}, {"type": "subtitle", "time": 6828.95, "timestamp": "01:53:48", "text": "ヨアトンの時に私はそれを読みました。"}, {"type": "subtitle", "time": 6831.75, "timestamp": "01:53:51", "text": "私は行くつもりです、それは来る。 それはもうすぐ来る。"}, {"type": "subtitle", "time": 6833.99, "timestamp": "01:53:53", "text": "ああ、進んでいる。 ああ、わかった。"}, {"type": "subtitle", "time": 6838.55, "timestamp": "01:53:58", "text": "ええ、時々ランダムに"}]
[{"type": "subtitle", "time": 1800.149, "timestamp": "00:30:00", "text": "唾液を飲み込むのが難しくなりました。"}, {"type": "subtitle", "time": 1802.789, "timestamp": "00:30:02", "text": "でも、あの"}, {"type": "subtitle", "time": 1807.029, "timestamp": "00:30:07", "text": "薬草茶を飲んだおかげで、今は話せるようになりました"}, {"type": "subtitle", "time": 1809.83, "timestamp": "00:30:09", "text": "。"}, {"type": "subtitle", "time": 1813.35, "timestamp": "00:30:13", "text": "ええ、寒さはありますね。"}, {"type": "subtitle", "time": 1822.63, "timestamp": "00:30:22", "text": "でも、大丈夫だよ。 それは"}, {"type": "subtitle", "time": 1825.83, "timestamp": "00:30:25", "text": "数日間、このままの状態になるでしょう。"}, {"type": "subtitle", "time": 1828.549, "timestamp": "00:30:28", "text": "来週月曜日の誕生日までに"}, {"type": "subtitle", "time": 1833.35, "timestamp": "00:30:33", "text": "良くなっていることを願うばかりです。   ええ、そうですね。"}, {"type": "subtitle", "time": 1843.029, "timestamp": "00:30:43", "text": "ああ、神様。"}, {"type": "subtitle", "time": 1845.19, "timestamp": "00:30:45", "text": "そうそう。 えっと、今日ラムジーの動画を見てたんだけど、"}, {"type": "subtitle", "time": 1854.07, "timestamp": "00:30:54", "text": "「うわあ、フィアンは本当にすごく"}, {"type": "subtitle", "time": 1857.83, "timestamp": "00:30:57", "text": "忙しいスケジュールなんだな」って思ったんだ。"}, {"type": "subtitle", "time": 1859.909, "timestamp": "00:30:59", "text": "まあ、彼女の方がより優れたクリエイターだ。 だから、"}]
[{"type": "subtitle", "time": 9120.389, "timestamp": "02:32:00", "text": "感嘆符の休憩をすると、"}, {"type": "subtitle", "time": 9128.07, "timestamp": "02:32:08", "text": "PCをシャットダウンして"}, {"type": "subtitle", "time": 9131.03, "timestamp": "02:32:11", "text": "モニターをオフにして寝るまで1分しかないというポップアップが表示されるような、そんな感じの、えっと、なんて"}, {"type": "subtitle", "time": 9140.79, "timestamp": "02:32:20", "text": "言うんだっけ？ えーと、"}, {"type": "subtitle", "time": 9145.11, "timestamp": "02:32:25", "text": "自己無効化。 いいえ。不具合のため終了します"}, {"type": "subtitle", "time": 9148.07, "timestamp": "02:32:28", "text": "。 いいえ。何ていう名前ですか？ えっと、"}, {"type": "subtitle", "time": 9152.389, "timestamp": "02:32:32", "text": "今タイマーを調べています。 爆弾タイマーみたいなやつですね"}, {"type": "subtitle", "time": 9154.389, "timestamp": "02:32:34", "text": "。 うん。 うん。 何てことだ。 それは"}, {"type": "subtitle", "time": 9157.51, "timestamp": "02:32:37", "text": "良い考えですね。 いや、想像してみてよ、"}, {"type": "subtitle", "time": 9161.12, "timestamp": "02:32:41", "text": "すごく楽しいと思うよ。"}, {"type": "subtitle", "time": 9175.83, "timestamp": "02:32:55", "text": "遠い将来、私はそういうことをするつもりです。 今じゃない。"}]
[{"type": "subtitle", "time": 2825.19, "timestamp": "00:47:05", "text": "ルールや文化を作っているように感じる。"}, {"type": "subtitle", "time": 2827.109, "timestamp": "00:47:07", "text": "英語を話す人も、"}, {"type": "subtitle", "time": 2829.19, "timestamp": "00:47:09", "text": "方言を話す人も、"}, {"type": "subtitle", "time": 2838.069, "timestamp": "00:47:18", "text": "ああ、ミュートし続けなきゃ。"}, {"type": "subtitle", "time": 2847.03, "timestamp": "00:47:27", "text": "けど、それもいいことなんだ。いや、わかった。"}, {"type": "subtitle", "time": 2851.75, "timestamp": "00:47:31", "text": "うん。それで、今日考えていたことの一つは、"}, {"type": "subtitle", "time": 2857.829, "timestamp": "00:47:37", "text": "インスピレーションを受けたこと。ちょっと待って、"}, {"type": "subtitle", "time": 2871.75, "timestamp": "00:47:51", "text": "喉が痛い。喉に触れるたびに"}]
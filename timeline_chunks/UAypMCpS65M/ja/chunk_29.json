[{"type": "subtitle", "time": 1741.99, "timestamp": "00:29:01", "text": "何かをやり続けて、"}, {"type": "chat", "time": 1743.398, "timestamp": "00:29:03", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "happy belated friendship day"}, {"type": "subtitle", "time": 1745.35, "timestamp": "00:29:05", "text": "スケジュールをとても"}, {"type": "subtitle", "time": 1749.669, "timestamp": "00:29:09", "text": "忙しくしています。 こんにちは、アディティさん。"}, {"type": "subtitle", "time": 1752.29, "timestamp": "00:29:12", "text": "遅ればせながら、友情の日おめでとうございます。"}, {"type": "subtitle", "time": 1753.43, "timestamp": "00:29:13", "text": "【音楽】"}, {"type": "chat", "time": 1755.352, "timestamp": "00:29:15", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "belated"}, {"type": "subtitle", "time": 1756.47, "timestamp": "00:29:16", "text": "お元気ですか？ 私は病気です。"}, {"type": "chat", "time": 1758.632, "timestamp": "00:29:18", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "owo"}, {"type": "subtitle", "time": 1760.149, "timestamp": "00:29:20", "text": "おそらく明日には熱が出るだろう。"}, {"type": "subtitle", "time": 1763.19, "timestamp": "00:29:23", "text": "体がもうすごく冷えている"}, {"type": "subtitle", "time": 1766.87, "timestamp": "00:29:26", "text": "。 部屋の扇風機は2段階の"}, {"type": "subtitle", "time": 1770.23, "timestamp": "00:29:30", "text": "速度で動いていて、5段階でも4段階でも3段階でもなく、"}, {"type": "subtitle", "time": 1772.95, "timestamp": "00:29:32", "text": "文字通り2段階の"}, {"type": "subtitle", "time": 1775.669, "timestamp": "00:29:35", "text": "速度で動いています。扇風機が体に当たるとすごく寒く感じます。"}, {"type": "subtitle", "time": 1789.029, "timestamp": "00:29:49", "text": "モニターをまっすぐ見ることができません。見れば見るほど痛いので、"}, {"type": "subtitle", "time": 1791.35, "timestamp": "00:29:51", "text": "頻繁に"}, {"type": "subtitle", "time": 1793.59, "timestamp": "00:29:53", "text": "目を閉じ、"}, {"type": "subtitle", "time": 1796.23, "timestamp": "00:29:56", "text": "喉が痛くなります。"}]
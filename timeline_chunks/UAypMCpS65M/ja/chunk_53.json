[{"type": "subtitle", "time": 3182.23, "timestamp": "00:53:02", "text": "発熱の初期症状が出ているので、ええ、私はこうやってこれをやります。ええ、"}, {"type": "subtitle", "time": 3191.67, "timestamp": "00:53:11", "text": "これは彼女が"}, {"type": "subtitle", "time": 3194.15, "timestamp": "00:53:14", "text": "カスタムコーディングしたウェブサイトです。ええ、彼女は"}, {"type": "subtitle", "time": 3196.549, "timestamp": "00:53:16", "text": "他の"}, {"type": "subtitle", "time": 3199.27, "timestamp": "00:53:19", "text": "モデルや"}, {"type": "subtitle", "time": 3201.67, "timestamp": "00:53:21", "text": "古いモデルなど、すべてのキャラクターや"}, {"type": "subtitle", "time": 3203.27, "timestamp": "00:53:23", "text": "ライブなど、"}, {"type": "subtitle", "time": 3205.27, "timestamp": "00:53:25", "text": "すべてを持っています。これは、"}, {"type": "subtitle", "time": 3213.99, "timestamp": "00:53:33", "text": "仕事用のウェブサイトで自分のプロフィールページまたはキャラクターページでやろうとしていることです。 こうやってやるんです"}, {"type": "subtitle", "time": 3216.069, "timestamp": "00:53:36", "text": "。"}, {"type": "subtitle", "time": 3219.03, "timestamp": "00:53:39", "text": "あなたも"}, {"type": "subtitle", "time": 3231.27, "timestamp": "00:53:51", "text": "？彼女がTwitchで配信したシリーズ全部が"}, {"type": "subtitle", "time": 3234.23, "timestamp": "00:53:54", "text": "ここにある。それに、いつものように"}, {"type": "subtitle", "time": 3237.99, "timestamp": "00:53:57", "text": "評価システムもあって、"}, {"type": "subtitle", "time": 3239.99, "timestamp": "00:53:59", "text": "最後にプレイした日時"}]
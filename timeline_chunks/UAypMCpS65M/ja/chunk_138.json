[{"type": "subtitle", "time": 8286.549, "timestamp": "02:18:06", "text": "それは後で追加できますが、それが"}, {"type": "subtitle", "time": 8297.589, "timestamp": "02:18:17", "text": "どうしてこんな突拍子もないアイデアが浮かぶのか分からないけど、たとえ体調が"}, {"type": "subtitle", "time": 8299.509, "timestamp": "02:18:19", "text": "悪くても、いや、絶対に"}, {"type": "subtitle", "time": 8302.309, "timestamp": "02:18:22", "text": "休まないんだ。 私はいつも"}, {"type": "subtitle", "time": 8305.27, "timestamp": "02:18:25", "text": "何かをしていて、仕事をしている。   長年の間、一度も"}, {"type": "subtitle", "time": 8308.23, "timestamp": "02:18:28", "text": "休暇を取ったことがないと思う"}, {"type": "subtitle", "time": 8315.589, "timestamp": "02:18:35", "text": "本当に休暇が必要だ。 しかし、"}, {"type": "subtitle", "time": 8317.75, "timestamp": "02:18:37", "text": "今はジョアトンでの一日たりとも欠かせない状況なのです"}, {"type": "subtitle", "time": 8319.589, "timestamp": "02:18:39", "text": "。"}, {"type": "subtitle", "time": 8322.309, "timestamp": "02:18:42", "text": "365まで上げなきゃいけないんです。今"}, {"type": "subtitle", "time": 8325.91, "timestamp": "02:18:45", "text": "147までしかなくて、"}, {"type": "subtitle", "time": 8330.79, "timestamp": "02:18:50", "text": "来年の3月に"}, {"type": "subtitle", "time": 8334.07, "timestamp": "02:18:54", "text": "日本に行く前に365まで上げられる自信があります。 私は"}]
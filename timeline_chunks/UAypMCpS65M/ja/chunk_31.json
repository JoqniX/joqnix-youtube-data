[{"type": "subtitle", "time": 1863.11, "timestamp": "00:31:03", "text": "もちろん、彼女には"}, {"type": "subtitle", "time": 1864.63, "timestamp": "00:31:04", "text": "今やらなければならないことがたくさんあるんです。 多くの新たな"}, {"type": "subtitle", "time": 1866.549, "timestamp": "00:31:06", "text": "機会。 彼女はそれをメッセージで送ることはできない。"}, {"type": "subtitle", "time": 1869.51, "timestamp": "00:31:09", "text": "だから、彼女はもっともっと頑張らなければならない、ということですよね"}, {"type": "subtitle", "time": 1873.43, "timestamp": "00:31:13", "text": "？ でも、確かに、働きすぎると"}, {"type": "subtitle", "time": 1875.51, "timestamp": "00:31:15", "text": "燃え尽きてしまうよね。 もし"}, {"type": "subtitle", "time": 1877.83, "timestamp": "00:31:17", "text": "あなたがそうしないなら、"}, {"type": "subtitle", "time": 1879.75, "timestamp": "00:31:19", "text": "もしあなたが自分に休息の時間を与えたりしないなら"}, {"type": "subtitle", "time": 1881.99, "timestamp": "00:31:21", "text": "、何の"}, {"type": "subtitle", "time": 1883.59, "timestamp": "00:31:23", "text": "意味があるのでしょう？"}, {"type": "subtitle", "time": 1886.63, "timestamp": "00:31:26", "text": "でも、彼女が言った言葉の中で特に印象に残ったのは、"}, {"type": "subtitle", "time": 1893.51, "timestamp": "00:31:33", "text": "彼女がやっていることは趣味のようなもので、"}, {"type": "subtitle", "time": 1897.83, "timestamp": "00:31:37", "text": "今は趣味を"}, {"type": "subtitle", "time": 1903.029, "timestamp": "00:31:43", "text": "仕事にしたり、いろいろなことができるようにしたりしている、という部分です。つまり、"}, {"type": "subtitle", "time": 1911.19, "timestamp": "00:31:51", "text": "趣味を楽しみながら、"}, {"type": "subtitle", "time": 1914.95, "timestamp": "00:31:54", "text": "同時に仕事として"}, {"type": "subtitle", "time": 1917.19, "timestamp": "00:31:57", "text": "お金を稼いだりしている、という感じです"}, {"type": "subtitle", "time": 1918.95, "timestamp": "00:31:58", "text": "。"}]
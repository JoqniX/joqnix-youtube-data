[{"type": "subtitle", "time": 1983.59, "timestamp": "00:33:03", "text": "。 私だけに集中して。   目の"}, {"type": "subtitle", "time": 1986.389, "timestamp": "00:33:06", "text": "前のこと、これから起こることに集中して"}, {"type": "subtitle", "time": 1989.75, "timestamp": "00:33:09", "text": "、少し"}, {"type": "subtitle", "time": 1993.83, "timestamp": "00:33:13", "text": "リラックスしましょう。 そう、考えてみれば"}, {"type": "subtitle", "time": 2001.909, "timestamp": "00:33:21", "text": "良い友達ってなかなか"}, {"type": "subtitle", "time": 2004.63, "timestamp": "00:33:24", "text": "見つからないよね"}, {"type": "subtitle", "time": 2007.59, "timestamp": "00:33:27", "text": "。"}, {"type": "subtitle", "time": 2011.11, "timestamp": "00:33:31", "text": "そして私は「うわあ」と思った。   それは本当に"}, {"type": "subtitle", "time": 2015.19, "timestamp": "00:33:35", "text": "素晴らしいですね。 私も、私がいつもやってしまう過労などの"}, {"type": "subtitle", "time": 2018.389, "timestamp": "00:33:38", "text": "悪い癖に気づいてくれる人が欲しいです"}, {"type": "subtitle", "time": 2024.549, "timestamp": "00:33:44", "text": "。"}, {"type": "subtitle", "time": 2028.31, "timestamp": "00:33:48", "text": "えっと、とにかくちょっと"}, {"type": "subtitle", "time": 2031.43, "timestamp": "00:33:51", "text": "立ち止まって、"}, {"type": "subtitle", "time": 2033.83, "timestamp": "00:33:53", "text": "どうにかして落ち着かせてください。"}, {"type": "subtitle", "time": 2037.669, "timestamp": "00:33:57", "text": "ほら、私はどちらかというとわがままなタイプで、"}]
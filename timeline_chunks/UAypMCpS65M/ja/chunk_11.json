[{"type": "subtitle", "time": 663.19, "timestamp": "00:11:03", "text": "今夜はもっとエネルギーを増やさなきゃ。"}, {"type": "subtitle", "time": 666.23, "timestamp": "00:11:06", "text": "ベッドから起き上がるのは、"}, {"type": "subtitle", "time": 669.43, "timestamp": "00:11:09", "text": "エネルギーが10ポイント減るようなものだよ。   えーと、"}, {"type": "subtitle", "time": 674.55, "timestamp": "00:11:14", "text": "バッグの後すぐに"}, {"type": "subtitle", "time": 677.99, "timestamp": "00:11:17", "text": "近くの警察署に行って、"}, {"type": "subtitle", "time": 681.19, "timestamp": "00:11:21", "text": "GST の件や登録、"}, {"type": "subtitle", "time": 683.35, "timestamp": "00:11:23", "text": "オーナーとしての登録などを手伝ってもらいました。"}, {"type": "subtitle", "time": 686.949, "timestamp": "00:11:26", "text": "今、これらすべては"}, {"type": "subtitle", "time": 690.55, "timestamp": "00:11:30", "text": "名前を隠すためだけにやっているのですが、やらなければならないことがたくさんあります。でも、著作権の権利"}, {"type": "subtitle", "time": 699.43, "timestamp": "00:11:39", "text": "についてどうしたらいいか尋ねたら、"}, {"type": "subtitle", "time": 702.15, "timestamp": "00:11:42", "text": "彼らは「わかりません」と言いました。"}, {"type": "subtitle", "time": 704.63, "timestamp": "00:11:44", "text": "それで、彼らは弁護士か知り合いに電話をかけて、どうやら"}, {"type": "subtitle", "time": 708.71, "timestamp": "00:11:48", "text": "その男はムンバイに知り合いがいるらしいので、その人に聞いてみて、"}, {"type": "subtitle", "time": 716.63, "timestamp": "00:11:56", "text": "私に知らせてくれるとか言っていた。"}, {"type": "subtitle", "time": 719.59, "timestamp": "00:11:59", "text": "だから、支払い処理の手続きを全部待たなきゃいけないし、"}]
[{"type": "subtitle", "time": 1626.95, "timestamp": "00:27:06", "text": "それから戻ってきて、"}, {"type": "subtitle", "time": 1632.63, "timestamp": "00:27:12", "text": "3月、4月、5月頃にまた病気になったんです。 えっと、4月に"}, {"type": "subtitle", "time": 1635.35, "timestamp": "00:27:15", "text": "また体調を崩しました。"}, {"type": "subtitle", "time": 1637.11, "timestamp": "00:27:17", "text": "理由はわからないのですが。   えっと、"}, {"type": "subtitle", "time": 1640.07, "timestamp": "00:27:20", "text": "風邪を引いたみたいです。 うん。 うん。"}, {"type": "subtitle", "time": 1645.83, "timestamp": "00:27:25", "text": "。   いっそ"}, {"type": "subtitle", "time": 1649.75, "timestamp": "00:27:29", "text": "病気になった方がましだ。  6月は、"}, {"type": "subtitle", "time": 1653.669, "timestamp": "00:27:33", "text": "その後の多くの"}, {"type": "subtitle", "time": 1655.75, "timestamp": "00:27:35", "text": "コラボレーションのせいで、とても気分が悪かった"}, {"type": "subtitle", "time": 1657.909, "timestamp": "00:27:37", "text": "。"}, {"type": "subtitle", "time": 1668.47, "timestamp": "00:27:48", "text": "H"}, {"type": "subtitle", "time": 1673.99, "timestamp": "00:27:53", "text": "今日、ある人のビデオを見ていたのですが、えっと、"}]
[{"type": "subtitle", "time": 724.23, "timestamp": "00:12:04", "text": "頭が痛くなるし、"}, {"type": "subtitle", "time": 728.55, "timestamp": "00:12:08", "text": "昨日はすごく寝てて"}, {"type": "subtitle", "time": 731.11, "timestamp": "00:12:11", "text": "酔っ払って、やってはいけないことをしちゃった。すごく"}, {"type": "subtitle", "time": 735.509, "timestamp": "00:12:15", "text": "ストレスが溜まって、"}, {"type": "subtitle", "time": 743.269, "timestamp": "00:12:23", "text": "人生で何をすべきかって考えてたら、うっかり"}, {"type": "subtitle", "time": 757.35, "timestamp": "00:12:37", "text": "でも、そうですね、「ああ、もう自分が何をしているのか分から"}, {"type": "subtitle", "time": 760.069, "timestamp": "00:12:40", "text": "ない」という感じでした。"}, {"type": "subtitle", "time": 762.069, "timestamp": "00:12:42", "text": "つまり、皆さんは"}, {"type": "subtitle", "time": 764.79, "timestamp": "00:12:44", "text": "最近私がこの問題について不満をぶちまけているのを何度も目にしているでしょう。   ごめんなさい"}, {"type": "subtitle", "time": 768.069, "timestamp": "00:12:48", "text": "。"}, {"type": "subtitle", "time": 778.71, "timestamp": "00:12:58", "text": "でも私は、"}]
[{"type": "subtitle", "time": 1264.71, "timestamp": "00:21:04", "text": "それで私は彼らに、ええ、申し訳ありませんが、まだ"}, {"type": "subtitle", "time": 1267.19, "timestamp": "00:21:07", "text": "Billy Billy でストリーミングすることはできません、"}, {"type": "subtitle", "time": 1269.909, "timestamp": "00:21:09", "text": "方法はありません、と言いました。 私は小規模なクリエイターです。 私は何者でもない、ごく普通の人間です"}, {"type": "subtitle", "time": 1273.27, "timestamp": "00:21:13", "text": "。"}, {"type": "subtitle", "time": 1276.63, "timestamp": "00:21:16", "text": "えーと、ビリー・ビリーはもっと、えーと、視点重視です。"}, {"type": "subtitle", "time": 1279.43, "timestamp": "00:21:19", "text": "もしあなたが、たくさんの視聴回数を持っていたり、より多くの"}, {"type": "subtitle", "time": 1281.27, "timestamp": "00:21:21", "text": "人に見てもらっていたりすれば"}, {"type": "subtitle", "time": 1283.75, "timestamp": "00:21:23", "text": "、あなたは非常に"}, {"type": "subtitle", "time": 1286.31, "timestamp": "00:21:26", "text": "違った扱いを受けるでしょう。"}, {"type": "subtitle", "time": 1290.149, "timestamp": "00:21:30", "text": "レベルアップシステムなどがたくさんあって、"}, {"type": "subtitle", "time": 1293.19, "timestamp": "00:21:33", "text": "競争が激しくて大変です。"}, {"type": "subtitle", "time": 1296.63, "timestamp": "00:21:36", "text": "ええ、ホワイトリストの場合も同様です。"}, {"type": "subtitle", "time": 1298.87, "timestamp": "00:21:38", "text": "難しいですね。"}, {"type": "subtitle", "time": 1305.11, "timestamp": "00:21:45", "text": "登録された組織、あるいはギルト、彼らは"}, {"type": "subtitle", "time": 1309.19, "timestamp": "00:21:49", "text": "それをギルトと呼んでいますが、そうすると"}, {"type": "subtitle", "time": 1311.99, "timestamp": "00:21:51", "text": "優先アクセス権が得られ、"}, {"type": "subtitle", "time": 1315.51, "timestamp": "00:21:55", "text": "優先リストに入れられます。 つまり、"}, {"type": "subtitle", "time": 1318.23, "timestamp": "00:21:58", "text": "ホワイトリストを"}]
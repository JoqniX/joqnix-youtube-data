[{"type": "subtitle", "time": 3255.43, "timestamp": "00:54:15", "text": "彼女がプレイしたゲームが全部載ってる。だから、私も"}, {"type": "subtitle", "time": 3259.19, "timestamp": "00:54:19", "text": "同じ"}, {"type": "subtitle", "time": 3261.589, "timestamp": "00:54:21", "text": "ことやって、YouTubeのプレイリストへのリンクも貼ろうかなって思ったんです。だって、今までやった"}, {"type": "subtitle", "time": 3271.829, "timestamp": "00:54:31", "text": "ゲーム配信全部をプレイリストにしてきたしね"}, {"type": "subtitle", "time": 3285.349, "timestamp": "00:54:45", "text": "クリアしなきゃいけないゲームとか、"}, {"type": "subtitle", "time": 3290.549, "timestamp": "00:54:50", "text": "プレイしなきゃいけないゲームとかが分かる。"}, {"type": "subtitle", "time": 3297.829, "timestamp": "00:54:57", "text": "実はいい方法があるんです。"}]
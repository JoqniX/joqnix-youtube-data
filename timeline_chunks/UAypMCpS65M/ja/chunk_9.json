[{"type": "subtitle", "time": 546.79, "timestamp": "00:09:06", "text": "それで、「わかった、行くよ」って思った。それから、どういうわけか"}, {"type": "subtitle", "time": 553.19, "timestamp": "00:09:13", "text": "スピードを上げて行った。"}, {"type": "subtitle", "time": 559.269, "timestamp": "00:09:19", "text": "それで、問題を聞いたら、「"}, {"type": "chat", "time": 559.975, "timestamp": "00:09:19", "author": "@kagami_tsukuyo", "avatar": "https://yt4.ggpht.com/K66mJIs5V3KzGLYSWraThSABbaCyYZBrOzSWyqsf_lfng2DzR9UpfpsccdViSMQXpqdKyjNeMtg=s64-c-k-c0x00ffffff-no-rj", "message": "take rests also!"}, {"type": "subtitle", "time": 564.07, "timestamp": "00:09:24", "text": "今夜中に有効化します」って言われて、電話"}, {"type": "subtitle", "time": 566.87, "timestamp": "00:09:26", "text": "番号を教えてもらった。"}, {"type": "subtitle", "time": 569.19, "timestamp": "00:09:29", "text": "それで、"}, {"type": "subtitle", "time": 571.99, "timestamp": "00:09:31", "text": "UPIがうまく機能すれば、"}, {"type": "subtitle", "time": 574.07, "timestamp": "00:09:34", "text": "インドの人たちも"}, {"type": "subtitle", "time": 577.35, "timestamp": "00:09:37", "text": "UPIで寄付できるし、"}, {"type": "subtitle", "time": 596.47, "timestamp": "00:09:56", "text": "実店舗を経営していて、"}, {"type": "subtitle", "time": 598.87, "timestamp": "00:09:58", "text": "外の店に行ったことがある人ならわかると思うけど、"}]
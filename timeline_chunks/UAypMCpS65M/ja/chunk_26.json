[{"type": "subtitle", "time": 1561.35, "timestamp": "00:26:01", "text": "それはただの夢だ。 日本、特に東京でタクシー"}, {"type": "subtitle", "time": 1565.35, "timestamp": "00:26:05", "text": "運転手とかをするのはどんな感じなのか、想像することしかできません"}, {"type": "subtitle", "time": 1571.11, "timestamp": "00:26:11", "text": "。"}, {"type": "subtitle", "time": 1574.07, "timestamp": "00:26:14", "text": "うわ、すごく混雑しそうだ"}, {"type": "subtitle", "time": 1585.83, "timestamp": "00:26:25", "text": "えっと、最近気づいたことがあるんですが、"}, {"type": "subtitle", "time": 1595.11, "timestamp": "00:26:35", "text": "もし気づいていなかったら、私は月に2～"}, {"type": "subtitle", "time": 1597.19, "timestamp": "00:26:37", "text": "3週間ごとに"}, {"type": "subtitle", "time": 1602.789, "timestamp": "00:26:42", "text": "病気になるんです。"}, {"type": "subtitle", "time": 1605.99, "timestamp": "00:26:45", "text": "皆さんが気づいたかどうかわかりませんが、今日の"}, {"type": "subtitle", "time": 1610.549, "timestamp": "00:26:50", "text": "初めに"}, {"type": "subtitle", "time": 1618.63, "timestamp": "00:26:58", "text": "クナナなどを訪れた後、熱が出てしまいました。"}]
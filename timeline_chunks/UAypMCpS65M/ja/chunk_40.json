[{"type": "subtitle", "time": 2401.99, "timestamp": "00:40:01", "text": "国際"}, {"type": "subtitle", "time": 2404.63, "timestamp": "00:40:04", "text": "配送や国際的に商品を販売することなど考えないでください。"}, {"type": "subtitle", "time": 2408.79, "timestamp": "00:40:08", "text": "国内でさえできないのに、何の"}, {"type": "subtitle", "time": 2418.15, "timestamp": "00:40:18", "text": "正直に"}, {"type": "subtitle", "time": 2420.95, "timestamp": "00:40:20", "text": "言って、それは本当に難しいことだと思います。"}, {"type": "subtitle", "time": 2426.87, "timestamp": "00:40:26", "text": "うん。 税金について調べなければならない。"}, {"type": "subtitle", "time": 2446.23, "timestamp": "00:40:46", "text": "ああ、大変だ。 またくしゃみが出そう。 少し時間をください"}]
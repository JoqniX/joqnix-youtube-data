[{"type": "subtitle", "time": 8521.99, "timestamp": "02:22:01", "text": "お金に執着しているような気分です。お金を稼がなければならない、"}, {"type": "subtitle", "time": 8524.95, "timestamp": "02:22:04", "text": "お金を稼がなければならない、あれこれと。"}, {"type": "subtitle", "time": 8528.309, "timestamp": "02:22:08", "text": "最初は、モデルとしてのこの"}, {"type": "subtitle", "time": 8530.469, "timestamp": "02:22:10", "text": "不幸な状況のせいで、"}, {"type": "subtitle", "time": 8538.87, "timestamp": "02:22:18", "text": "お金のことばかり考えていました。それが、私がお金のことばかり考えていた唯一の理由です。時々、"}, {"type": "subtitle", "time": 8541.91, "timestamp": "02:22:21", "text": "夜中に"}, {"type": "subtitle", "time": 8545.429, "timestamp": "02:22:25", "text": "自分の状況について考えて泣き出し、「"}, {"type": "subtitle", "time": 8547.67, "timestamp": "02:22:27", "text": "私はお金のためにこれをやっているのか、それとも"}, {"type": "subtitle", "time": 8550.389, "timestamp": "02:22:30", "text": "本当に楽しんでいる趣味としてこれをやっているのか"}, {"type": "subtitle", "time": 8553.75, "timestamp": "02:22:33", "text": "？」と自問します。   それが"}, {"type": "subtitle", "time": 8555.99, "timestamp": "02:22:35", "text": "私のすべてです。"}, {"type": "subtitle", "time": 8559.99, "timestamp": "02:22:39", "text": "最近、彼らは"}, {"type": "subtitle", "time": 8562.63, "timestamp": "02:22:42", "text": "時々そういうエピソードを経験するようになっている。  「"}, {"type": "subtitle", "time": 8564.95, "timestamp": "02:22:44", "text": "ああ、"}, {"type": "subtitle", "time": 8567.59, "timestamp": "02:22:47", "text": "これはどこにも行き着かないな」って感じだった。   いっそ"}, {"type": "subtitle", "time": 8569.75, "timestamp": "02:22:49", "text": "全部辞めてしまった方がいいのかな"}, {"type": "subtitle", "time": 8571.83, "timestamp": "02:22:51", "text": "？   そういう"}, {"type": "subtitle", "time": 8573.91, "timestamp": "02:22:53", "text": "考えが浮かんでくるんだけど、"}, {"type": "subtitle", "time": 8576.71, "timestamp": "02:22:56", "text": "バカ、わからない、"}]
[{"type": "subtitle", "time": 482.469, "timestamp": "00:08:02", "text": "。それで"}, {"type": "subtitle", "time": 487.35, "timestamp": "00:08:07", "text": "頭に少し雨が入った。帽子をかぶるのを忘れた。"}, {"type": "subtitle", "time": 489.43, "timestamp": "00:08:09", "text": "普段は頭を風邪から守るために帽子をかぶるんだけど、"}, {"type": "subtitle", "time": 493.589, "timestamp": "00:08:13", "text": "昨日は忘れた。それで、"}, {"type": "subtitle", "time": 496.71, "timestamp": "00:08:16", "text": "朝は"}, {"type": "subtitle", "time": 500.95, "timestamp": "00:08:20", "text": "自分の唾液を飲み込むことも、水を飲むこともできなかった。"}, {"type": "subtitle", "time": 504.15, "timestamp": "00:08:24", "text": "すごく痛かった。"}, {"type": "subtitle", "time": 508.79, "timestamp": "00:08:28", "text": "でも、"}, {"type": "subtitle", "time": 513.19, "timestamp": "00:08:33", "text": "薬を飲んだ。なんて言うんだっけ？ガーレ。"}, {"type": "subtitle", "time": 516.469, "timestamp": "00:08:36", "text": "それで、"}, {"type": "subtitle", "time": 520.31, "timestamp": "00:08:40", "text": "今日はUPIのことで銀行に行かなければならなかった"}, {"type": "subtitle", "time": 525.19, "timestamp": "00:08:45", "text": "。いや、"}, {"type": "subtitle", "time": 528.87, "timestamp": "00:08:48", "text": "面白いことに、"}, {"type": "subtitle", "time": 531.829, "timestamp": "00:08:51", "text": "銀行が閉まる5分前に行ったんだ。"}, {"type": "subtitle", "time": 535.99, "timestamp": "00:08:55", "text": "正気じゃなかった。ベッドにいたんだけど、"}, {"type": "subtitle", "time": 539.59, "timestamp": "00:08:59", "text": "行くべきか行かないべきか、"}]
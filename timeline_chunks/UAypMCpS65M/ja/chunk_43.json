[{"type": "subtitle", "time": 2611.109, "timestamp": "00:43:31", "text": "マヤマヤ、"}, {"type": "subtitle", "time": 2622.23, "timestamp": "00:43:42", "text": "病気で、いつから"}, {"type": "subtitle", "time": 2625.99, "timestamp": "00:43:45", "text": "こんな病気になったのか分からない。"}, {"type": "subtitle", "time": 2628.87, "timestamp": "00:43:48", "text": "病気だった時、今、"}, {"type": "subtitle", "time": 2631.43, "timestamp": "00:43:51", "text": "本当は話すべきではないことを話し続けている。私は話さない。"}]
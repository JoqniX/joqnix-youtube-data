[{"type": "subtitle", "time": 6842.55, "timestamp": "01:54:02", "text": "歌の練習をします。毎週、ちょっと"}, {"type": "subtitle", "time": 6846.07, "timestamp": "01:54:06", "text": "待って、"}, {"type": "subtitle", "time": 6850.149, "timestamp": "01:54:10", "text": "そんな風にからかわないで。鼻ちゃん、"}, {"type": "subtitle", "time": 6851.83, "timestamp": "01:54:11", "text": "くしゃみするの？しないの？ でも、"}, {"type": "subtitle", "time": 6854.709, "timestamp": "01:54:14", "text": "これは歌のレッスンシリーズみたいなものですよね"}, {"type": "subtitle", "time": 6857.83, "timestamp": "01:54:17", "text": "？ ウェブ"}, {"type": "subtitle", "time": 6862.629, "timestamp": "01:54:22", "text": "サイトで配信を続けたいと思ったのは、人々が「ああ、ジョーはこういう"}, {"type": "subtitle", "time": 6865.589, "timestamp": "01:54:25", "text": "シリーズをやっているんだ」と思って、それを"}, {"type": "subtitle", "time": 6869.43, "timestamp": "01:54:29", "text": "チェックできるようにするためです。   私"}, {"type": "subtitle", "time": 6872.79, "timestamp": "01:54:32", "text": "もコラボ"}, {"type": "subtitle", "time": 6876.86, "timestamp": "01:54:36", "text": "プレイリストを持っています。 いえ、もちろんそれもできますよ。"}, {"type": "subtitle", "time": 6882.87, "timestamp": "01:54:42", "text": "なぜ来るのか、来ないのか？"}, {"type": "subtitle", "time": 6885.91, "timestamp": "01:54:45", "text": "なぜ私はくしゃみをしないのか。ああ、"}, {"type": "subtitle", "time": 6889.91, "timestamp": "01:54:49", "text": "来るぞ。 でも、私は待つつもりです。 それをやめなさい"}]
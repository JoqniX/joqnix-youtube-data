[{"type": "subtitle", "time": 5823.27, "timestamp": "01:37:03", "text": "最初の配信は7月14日、最後の配信は7月"}, {"type": "subtitle", "time": 5825.91, "timestamp": "01:37:05", "text": "9日だった。えーと、"}, {"type": "subtitle", "time": 5832.07, "timestamp": "01:37:12", "text": "いつもここに戻ってきて、"}, {"type": "subtitle", "time": 5839.91, "timestamp": "01:37:19", "text": "これを更新しなかったらどうなる？"}, {"type": "subtitle", "time": 5843.669, "timestamp": "01:37:23", "text": "そうだね。大変すぎる。だから、やらないかもしれない"}, {"type": "subtitle", "time": 5845.669, "timestamp": "01:37:25", "text": "。まあ、"}, {"type": "subtitle", "time": 5849.75, "timestamp": "01:37:29", "text": "今はそのままにしておくよ。でも、えーと、ちょっと"}, {"type": "subtitle", "time": 5853.27, "timestamp": "01:37:33", "text": "聞いてみよう。"}, {"type": "subtitle", "time": 5855.43, "timestamp": "01:37:35", "text": "私は"}]
[{"type": "subtitle", "time": 2764.79, "timestamp": "00:46:04", "text": "私は"}, {"type": "subtitle", "time": 2768.55, "timestamp": "00:46:08", "text": "わかってるよ。インポスター症候群だよ、兄弟。"}, {"type": "subtitle", "time": 2772.98, "timestamp": "00:46:12", "text": "ほとんどインポスター症候群なんだ。"}, {"type": "subtitle", "time": 2782.069, "timestamp": "00:46:22", "text": "たくさんのことを願ってる。例えば、一緒に過ごしたり、一緒に過ごしたりじゃなくて、もっと一緒に過ごしたり。あと、"}, {"type": "subtitle", "time": 2792.71, "timestamp": "00:46:32", "text": "時々、短いサーバーで交流するんだけど、そこでは環境がすごく違う。"}, {"type": "subtitle", "time": 2801.03, "timestamp": "00:46:41", "text": "今気づいたんだけど、文化的にすごく違う"}, {"type": "subtitle", "time": 2806.39, "timestamp": "00:46:46", "text": "けど、すごく似てて、でもすごく"}, {"type": "subtitle", "time": 2808.47, "timestamp": "00:46:48", "text": "違うんだよね"}, {"type": "subtitle", "time": 2811.27, "timestamp": "00:46:51", "text": "。"}, {"type": "subtitle", "time": 2815.27, "timestamp": "00:46:55", "text": "ゆっくりと、ゆっくりと、"}, {"type": "subtitle", "time": 2818.069, "timestamp": "00:46:58", "text": "ほとんどのインド人が、ゆっくりと自分たちの"}]
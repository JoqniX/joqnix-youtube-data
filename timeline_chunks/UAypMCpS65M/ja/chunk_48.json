[{"type": "subtitle", "time": 2882.95, "timestamp": "00:48:02", "text": "今日インスピレーションを受けたこと。"}, {"type": "subtitle", "time": 2885.829, "timestamp": "00:48:05", "text": "日本のYouTuberがいて、"}, {"type": "subtitle", "time": 2887.829, "timestamp": "00:48:07", "text": "自分のウェブサイトとかを引用してるんだ"}, {"type": "subtitle", "time": 2890.55, "timestamp": "00:48:10", "text": "。 たまたま、彼らのウェブ"}, {"type": "subtitle", "time": 2896.71, "timestamp": "00:48:16", "text": "サイトアプリを携帯にインストールしたので、時々"}, {"type": "subtitle", "time": 2902.79, "timestamp": "00:48:22", "text": "ブログなどをチェックしていました。それで、たまたま"}, {"type": "subtitle", "time": 2913.91, "timestamp": "00:48:33", "text": "彼女のウェブサイトにゲームセクションがあるのを見つけました"}, {"type": "subtitle", "time": 2918.309, "timestamp": "00:48:38", "text": "。そこには、"}, {"type": "subtitle", "time": 2922.15, "timestamp": "00:48:42", "text": "彼女がストリーミング配信したゲームはすべて"}, {"type": "subtitle", "time": 2925.43, "timestamp": "00:48:45", "text": "完了し、保留中のゲームには"}, {"type": "subtitle", "time": 2932.069, "timestamp": "00:48:52", "text": "5段階評価の星評価のようなレビューが付けられています。"}, {"type": "subtitle", "time": 2939.829, "timestamp": "00:48:59", "text": "現在プレイ中のゲームなどのセクションがあり、"}]
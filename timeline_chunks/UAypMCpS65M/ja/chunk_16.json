[{"type": "subtitle", "time": 963.189, "timestamp": "00:16:03", "text": "キュウリがたくさんあるんです。 それで、"}, {"type": "subtitle", "time": 967.99, "timestamp": "00:16:07", "text": "配信を始める直前にキュウリを食べました。"}, {"type": "subtitle", "time": 970.389, "timestamp": "00:16:10", "text": "きゅうりって、実は美味しいと"}, {"type": "subtitle", "time": 972.389, "timestamp": "00:16:12", "text": "思いませんか？ まるで、それをむしゃむしゃ食べるような感じ"}, {"type": "subtitle", "time": 973.91, "timestamp": "00:16:13", "text": "。   まるでニンジンをむしゃむしゃ食べているウサギになったような気分になる"}, {"type": "subtitle", "time": 980.87, "timestamp": "00:16:20", "text": "。   あなたはナムナムナムナム。"}, {"type": "subtitle", "time": 986.15, "timestamp": "00:16:26", "text": "[音楽]"}, {"type": "subtitle", "time": 989.91, "timestamp": "00:16:29", "text": "ただのんびりん。 そう、もっともっと食べなさい"}, {"type": "subtitle", "time": 998.629, "timestamp": "00:16:38", "text": "あ、待って。 うーん、うーん、うーん、"}, {"type": "subtitle", "time": 1004.069, "timestamp": "00:16:44", "text": "今日の配信についてツイートするのを忘れていました。 えっと、"}, {"type": "subtitle", "time": 1012.71, "timestamp": "00:16:52", "text": "昨日、えっと、"}]
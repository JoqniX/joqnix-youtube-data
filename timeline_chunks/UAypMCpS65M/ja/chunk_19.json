[{"type": "subtitle", "time": 1143.029, "timestamp": "00:19:03", "text": "私にとってストレスの多い週になりそうです。なぜなら、"}, {"type": "subtitle", "time": 1146.07, "timestamp": "00:19:06", "text": "毎回、"}, {"type": "subtitle", "time": 1153.83, "timestamp": "00:19:13", "text": "もうすぐ誕生日だから、"}, {"type": "subtitle", "time": 1166.15, "timestamp": "00:19:26", "text": "何をすればいいか、ということばかり考えてしまうからです。 どうすればいいですか"}, {"type": "subtitle", "time": 1169.43, "timestamp": "00:19:29", "text": "？"}, {"type": "subtitle", "time": 1174.15, "timestamp": "00:19:34", "text": "それについてはストレスを感じるだろうな。"}, {"type": "subtitle", "time": 1185.99, "timestamp": "00:19:45", "text": "昨日、"}, {"type": "subtitle", "time": 1189.59, "timestamp": "00:19:49", "text": "ストリームでこれを共有したかどうか覚えていないのですが、"}, {"type": "subtitle", "time": 1195.35, "timestamp": "00:19:55", "text": "たまたま私の"}, {"type": "subtitle", "time": 1199.27, "timestamp": "00:19:59", "text": "ビリービリーQグループ、つまり中国の"}]
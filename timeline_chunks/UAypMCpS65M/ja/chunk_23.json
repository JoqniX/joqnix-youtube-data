[{"type": "subtitle", "time": 1380.63, "timestamp": "00:23:00", "text": "私はまた悪い癖、つまり"}, {"type": "subtitle", "time": 1385.51, "timestamp": "00:23:05", "text": "ヴィックス吸入器を使い始めてしまった。"}, {"type": "subtitle", "time": 1389.75, "timestamp": "00:23:09", "text": "私は「もうこんなことはやめよう」と思った。 私は「もう二度とこんなことはしない」と思った"}, {"type": "subtitle", "time": 1407.669, "timestamp": "00:23:27", "text": "はい、戻ってきました。"}, {"type": "subtitle", "time": 1411.59, "timestamp": "00:23:31", "text": "Twitchからご覧いただいている皆様、ようこそ。  「私は"}, {"type": "subtitle", "time": 1417.11, "timestamp": "00:23:37", "text": "もっともっともっと"}, {"type": "subtitle", "time": 1420.23, "timestamp": "00:23:40", "text": "。"}]
[{"type": "subtitle", "time": 17537.35, "timestamp": "04:52:17", "text": "[音楽]"}, {"type": "subtitle", "time": 17547.43, "timestamp": "04:52:27", "text": "うん、大丈夫だと思うよ。 とにかく、来てくださった"}, {"type": "subtitle", "time": 17552.39, "timestamp": "04:52:32", "text": "皆さん、ありがとうございました。 素敵な"}, {"type": "subtitle", "time": 17556.07, "timestamp": "04:52:36", "text": "夜をお過ごしください。そして、本当に、来てくださって"}, {"type": "subtitle", "time": 17561.43, "timestamp": "04:52:41", "text": "心から感謝しています。   したくなかったんです。ただ何かのために"}, {"type": "subtitle", "time": 17564.07, "timestamp": "04:52:44", "text": "配信したかっただけなんですが、えっと、"}, {"type": "subtitle", "time": 17568.788, "timestamp": "04:52:48", "text": "ご存知の通り、何か"}, {"type": "subtitle", "time": 17571.11, "timestamp": "04:52:51", "text": "一つのことに関しては、気が散ったり、何かアイデアが浮かんだりすると、「ああ、"}, {"type": "subtitle", "time": 17575.99, "timestamp": "04:52:55", "text": "これをやりたい」ってなって、すごくハマって、寝ることも食べることも"}]
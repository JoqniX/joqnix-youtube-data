[{"type": "subtitle", "time": 17345.35, "timestamp": "04:49:05", "text": "うん。"}, {"type": "subtitle", "time": 17352.708, "timestamp": "04:49:12", "text": "今日来てくださった皆さん、ありがとうございました。"}, {"type": "subtitle", "time": 17355.91, "timestamp": "04:49:15", "text": "それは本当に大きな意味があります。"}, {"type": "subtitle", "time": 17358.948, "timestamp": "04:49:18", "text": "今日の配信やその他すべてを楽しんでいただけたなら幸いです。"}, {"type": "subtitle", "time": 17362.07, "timestamp": "04:49:22", "text": "改めてありがとうございました。"}, {"type": "subtitle", "time": 17367.15, "timestamp": "04:49:27", "text": "えーと、"}, {"type": "subtitle", "time": 17395.67, "timestamp": "04:49:55", "text": "顧客に送るように指示する。 配置はできます"}, {"type": "subtitle", "time": 17399.43, "timestamp": "04:49:59", "text": "が、アップロードはできません。 ステッカーありがとう。"}, {"type": "subtitle", "time": 17399.91, "timestamp": "04:49:59", "text": "G J G J G J G J G J G J G J G J G J G J G J G J G J J J J J J J J J J J J J J J J J J J"}]
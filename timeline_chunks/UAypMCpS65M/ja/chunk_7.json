[{"type": "chat", "time": 422.265, "timestamp": "00:07:02", "author": "@kagami_tsukuyo", "avatar": "https://yt4.ggpht.com/K66mJIs5V3KzGLYSWraThSABbaCyYZBrOzSWyqsf_lfng2DzR9UpfpsccdViSMQXpqdKyjNeMtg=s64-c-k-c0x00ffffff-no-rj", "message": "get well soon"}, {"type": "subtitle", "time": 422.87, "timestamp": "00:07:02", "text": "殺されたのか？ こんにちは。"}, {"type": "subtitle", "time": 426.95, "timestamp": "00:07:06", "text": "ええ、喉が痛くて。"}, {"type": "subtitle", "time": 433.11, "timestamp": "00:07:13", "text": "ええと、昨日、ちょっと無理しすぎたかな"}, {"type": "subtitle", "time": 435.67, "timestamp": "00:07:15", "text": "？"}, {"type": "subtitle", "time": 438.39, "timestamp": "00:07:18", "text": "昨日、私はどれくらいの時間配信したでしょうか？ 深夜。"}, {"type": "subtitle", "time": 440.309, "timestamp": "00:07:20", "text": "本当は配信したくなかったんだけど、"}, {"type": "subtitle", "time": 443.43, "timestamp": "00:07:23", "text": "「いや、配信しなきゃいけない。"}, {"type": "subtitle", "time": 449.909, "timestamp": "00:07:29", "text": "日本に行く前に1年間続けなきゃいけないんだから。やらなきゃいけない"}, {"type": "subtitle", "time": 451.67, "timestamp": "00:07:31", "text": "」って思ったんだ。 だから私は「わかった、わかった。"}, {"type": "subtitle", "time": 454.55, "timestamp": "00:07:34", "text": "メッセージマラソンの日を逃さないよ」って思った。それで「わかった、わかった、やるよ」って思った"}, {"type": "subtitle", "time": 461.11, "timestamp": "00:07:41", "text": "。そしてやった。うん。"}, {"type": "subtitle", "time": 464.629, "timestamp": "00:07:44", "text": "昨日は、"}, {"type": "subtitle", "time": 473.43, "timestamp": "00:07:53", "text": "ストリームルームから出た時に、うっかり頭に雨が入った2時間後だった。"}, {"type": "subtitle", "time": 476.39, "timestamp": "00:07:56", "text": "家を出て、"}, {"type": "subtitle", "time": 478.07, "timestamp": "00:07:58", "text": "裏口から家に入った"}]
[{"type": "subtitle", "time": 4922.709, "timestamp": "01:22:02", "text": "つまり、基本的には私の"}, {"type": "subtitle", "time": 4932.229, "timestamp": "01:22:12", "text": "基本的には、"}, {"type": "subtitle", "time": 4939.669, "timestamp": "01:22:19", "text": "ここにゲームを選択できるようなものになります。他のストリームコンテンツは"}, {"type": "subtitle", "time": 4948.709, "timestamp": "01:22:28", "text": "このような表形式のものになります。"}, {"type": "subtitle", "time": 4951.35, "timestamp": "01:22:31", "text": "クリックして見たり、閲覧したりできるんだと"}, {"type": "subtitle", "time": 4958.39, "timestamp": "01:22:38", "text": "整理整頓もできるしね。"}, {"type": "subtitle", "time": 4965.83, "timestamp": "01:22:45", "text": "病気なのに仕事をしているなんて、休まなくちゃいけないのに、おかしいよ。ほら"}, {"type": "subtitle", "time": 4967.83, "timestamp": "01:22:47", "text": "、こういうことが起こるんだ。じっとしていられないんだ。"}, {"type": "subtitle", "time": 4974.95, "timestamp": "01:22:54", "text": "何かを見ると、"}, {"type": "subtitle", "time": 4978.55, "timestamp": "01:22:58", "text": "「ああ、あれが欲しい」って思う。インスピレーションの"}]
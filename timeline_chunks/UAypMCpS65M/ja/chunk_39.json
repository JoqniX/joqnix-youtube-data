[{"type": "subtitle", "time": 2341.67, "timestamp": "00:39:01", "text": "彼女は、"}, {"type": "subtitle", "time": 2343.91, "timestamp": "00:39:03", "text": "在庫"}, {"type": "subtitle", "time": 2346.79, "timestamp": "00:39:06", "text": "管理、物流、"}, {"type": "subtitle", "time": 2349.43, "timestamp": "00:39:09", "text": "大量の商品の発送など、これには非常に多くの要素が関係していることに気づいた。"}, {"type": "subtitle", "time": 2352.31, "timestamp": "00:39:12", "text": "商品やその他すべて、あるいは"}, {"type": "subtitle", "time": 2354.71, "timestamp": "00:39:14", "text": "商品の"}, {"type": "subtitle", "time": 2358.87, "timestamp": "00:39:18", "text": "製造コストなどを発送したい場合、"}, {"type": "subtitle", "time": 2361.109, "timestamp": "00:39:21", "text": "彼女は「割に合わない」と言ってそれを"}, {"type": "subtitle", "time": 2364.15, "timestamp": "00:39:24", "text": "止め、私は自分の"}, {"type": "subtitle", "time": 2380.069, "timestamp": "00:39:40", "text": "すみません、くしゃみをせずにはいられませんでした。"}, {"type": "subtitle", "time": 2387.03, "timestamp": "00:39:47", "text": "インド人ユーチューバーとして"}, {"type": "subtitle", "time": 2391.51, "timestamp": "00:39:51", "text": "インドで商品を販売することがどれほど大変か、私の経験を共有します。多くの法的手続きがあり、"}, {"type": "subtitle", "time": 2399.75, "timestamp": "00:39:59", "text": "知らないことがたくさんあります。"}]
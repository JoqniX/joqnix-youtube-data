[{"type": "subtitle", "time": 203.589, "timestamp": "00:03:23", "text": "ああ、ミュートされていました。"}, {"type": "subtitle", "time": 207.67000000000002, "timestamp": "00:03:27", "text": "皆様、こんばんは。 こんにちは。"}, {"type": "subtitle", "time": 211.50900000000001, "timestamp": "00:03:31", "text": "皆さんお元気でお過ごしでしょうか。"}, {"type": "subtitle", "time": 213.91, "timestamp": "00:03:33", "text": "こんにちは。"}, {"type": "subtitle", "time": 215.43, "timestamp": "00:03:35", "text": "えっと、"}, {"type": "subtitle", "time": 218.55, "timestamp": "00:03:38", "text": "タイトルの通り、"}, {"type": "subtitle", "time": 220.789, "timestamp": "00:03:40", "text": "私は病気です。"}, {"type": "subtitle", "time": 225.03, "timestamp": "00:03:45", "text": "症状が出始めたのは"}, {"type": "subtitle", "time": 227.03, "timestamp": "00:03:47", "text": "昨日からだったのですが、知りませんでした。"}, {"type": "subtitle", "time": 236.22899999999998, "timestamp": "00:03:56", "text": "自分の体が徐々に、そして何度も何度も"}, {"type": "subtitle", "time": 239.99, "timestamp": "00:03:59", "text": "悪化していることに気づき始めた。   というわけで、"}]
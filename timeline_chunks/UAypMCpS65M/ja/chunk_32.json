[{"type": "subtitle", "time": 1921.59, "timestamp": "00:32:01", "text": "うん。"}, {"type": "subtitle", "time": 1924.07, "timestamp": "00:32:04", "text": "そして、そのことと、ドラムシーの"}, {"type": "subtitle", "time": 1927.909, "timestamp": "00:32:07", "text": "言葉も、ええと、"}, {"type": "subtitle", "time": 1929.909, "timestamp": "00:32:09", "text": "正確な言葉は覚えていませんが、"}, {"type": "subtitle", "time": 1932.95, "timestamp": "00:32:12", "text": "時々、本当に"}, {"type": "subtitle", "time": 1938.63, "timestamp": "00:32:18", "text": "必要なのは、あなたが毎日どれだけ"}, {"type": "subtitle", "time": 1943.99, "timestamp": "00:32:23", "text": "一生懸命に働いているかを知っていて、あなたのそばにいてくれる友達です。"}, {"type": "subtitle", "time": 1946.71, "timestamp": "00:32:26", "text": "でも、あなたのために"}, {"type": "subtitle", "time": 1951.99, "timestamp": "00:32:31", "text": "時間を割いたり、"}, {"type": "subtitle", "time": 1957.669, "timestamp": "00:32:37", "text": "あなたと話したり、一緒に遊んだりする余裕がないほどです。"}, {"type": "subtitle", "time": 1960.47, "timestamp": "00:32:40", "text": "どれだけの、えっと、なんて"}, {"type": "subtitle", "time": 1963.35, "timestamp": "00:32:43", "text": "言うんだっけ？"}, {"type": "subtitle", "time": 1966.47, "timestamp": "00:32:46", "text": "彼らは本当に忙しいスケジュールを送っている。 でも、"}, {"type": "subtitle", "time": 1969.43, "timestamp": "00:32:49", "text": "人間として、"}, {"type": "subtitle", "time": 1971.19, "timestamp": "00:32:51", "text": "彼らに手を差し伸べて、「ちょっと待って」と言いたくなるでしょう"}, {"type": "subtitle", "time": 1975.669, "timestamp": "00:32:55", "text": "。 ちょっと落ち着いてください"}, {"type": "subtitle", "time": 1979.99, "timestamp": "00:32:59", "text": "。 他のことは何も考えないでください"}]
[{"type": "subtitle", "time": 17700.788, "timestamp": "04:55:00", "text": "配信を明日の次の配信に残しておきます。また、"}, {"type": "subtitle", "time": 17704.788, "timestamp": "04:55:04", "text": "皆さんには、おそらく明後日までに"}, {"type": "subtitle", "time": 17707.99, "timestamp": "04:55:07", "text": "記録の"}, {"type": "subtitle", "time": 17711.43, "timestamp": "04:55:11", "text": "リンクを作成します。"}, {"type": "subtitle", "time": 17719.99, "timestamp": "04:55:19", "text": "明日か"}, {"type": "subtitle", "time": 17721.75, "timestamp": "04:55:21", "text": "明後日までに、誕生日のお祝いカードのウェブサイトを公開します。 明日は"}, {"type": "subtitle", "time": 17724.15, "timestamp": "04:55:24", "text": "水曜日ですよね？ 水曜日は"}, {"type": "subtitle", "time": 17727.27, "timestamp": "04:55:27", "text": "良い日だと思います。 はい、明日リリースします"}, {"type": "subtitle", "time": 17729.51, "timestamp": "04:55:29", "text": "。 だから、"}, {"type": "subtitle", "time": 17733.35, "timestamp": "04:55:33", "text": "誕生日のメッセージや誕生日に関するメッセージを送りたい人は、"}, {"type": "subtitle", "time": 17740.628, "timestamp": "04:55:40", "text": "配信で私が読むためにそこに書いてください。そうすれば、ええ、それはそこに表示されます"}, {"type": "subtitle", "time": 17747.19, "timestamp": "04:55:47", "text": "。 うん、ただ"}, {"type": "subtitle", "time": 17753.91, "timestamp": "04:55:53", "text": "終わらせたいだけなんだ、でもまあいいかって感じ"}, {"type": "subtitle", "time": 17759.51, "timestamp": "04:55:59", "text": "。 私も具合が悪いんです。 あまり気にしすぎない方がいいだろう"}]
[{"type": "subtitle", "time": 17405.75, "timestamp": "04:50:05", "text": "Jivon Kim、グローバルアフェアーズマネージャー。 ああ、わかりました"}, {"type": "subtitle", "time": 17408.708, "timestamp": "04:50:08", "text": "。"}, {"type": "subtitle", "time": 17410.47, "timestamp": "04:50:10", "text": "でも待って、待って、待って、待って、待って。 ご"}, {"type": "subtitle", "time": 17412.07, "timestamp": "04:50:12", "text": "関心をお寄せいただきありがとうございます。 今すぐご"}, {"type": "subtitle", "time": 17414.23, "timestamp": "04:50:14", "text": "参加いただければ、限定特典をご用意しております"}, {"type": "subtitle", "time": 17416.07, "timestamp": "04:50:16", "text": "。"}, {"type": "subtitle", "time": 17419.11, "timestamp": "04:50:19", "text": "公式ベータ版のリリース日を8月18日に延期する"}, {"type": "subtitle", "time": 17431.43, "timestamp": "04:50:31", "text": "ベータプログラムへの参加にご応募いただき、誠にありがとうございます。"}, {"type": "subtitle", "time": 17433.59, "timestamp": "04:50:33", "text": "今回のベータ"}, {"type": "subtitle", "time": 17435.83, "timestamp": "04:50:35", "text": "テスターに​​は、残念ながらご参加いただけませんでした。 いいえ、この決定は"}, {"type": "subtitle", "time": 17438.868, "timestamp": "04:50:38", "text": "フォロワー数やコミュニティの規模に基づいたものではありません。 私たちは、"}, {"type": "subtitle", "time": 17440.55, "timestamp": "04:50:40", "text": "あなたが素晴らしい"}, {"type": "subtitle", "time": 17442.868, "timestamp": "04:50:42", "text": "友人になってくれると心から信じています。 私たちは、あなたがこれまでとは"}, {"type": "subtitle", "time": 17445.19, "timestamp": "04:50:45", "text": "異なる立場でこのプラットフォームにご参加いただけることを大変嬉しく思います。"}, {"type": "subtitle", "time": 17451.99, "timestamp": "04:50:51", "text": "[音楽]"}, {"type": "subtitle", "time": 17454.07, "timestamp": "04:50:54", "text": "もし私がそこにいたら、"}, {"type": "subtitle", "time": 17457.43, "timestamp": "04:50:57", "text": "このイベントで餌代として100ドル稼げたと"}]
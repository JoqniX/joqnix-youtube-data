[{"type": "subtitle", "time": 2828.39, "timestamp": "00:47:08", "text": "好了，我們趕緊結束這件事。這樣"}, {"type": "subtitle", "time": 2847.03, "timestamp": "00:47:27", "text": "去旅行吧。哦，我正在做一件絕對不能吃的"}, {"type": "subtitle", "time": 2851.19, "timestamp": "00:47:31", "text": "飛機餐。"}, {"type": "subtitle", "time": 2853.589, "timestamp": "00:47:33", "text": "我必須完成這個挑戰"}, {"type": "subtitle", "time": 2855.75, "timestamp": "00:47:35", "text": "。"}, {"type": "subtitle", "time": 2859.03, "timestamp": "00:47:39", "text": "呃，它在哪裡？是的，我正在努力在"}, {"type": "subtitle", "time": 2862.71, "timestamp": "00:47:42", "text": "這次"}, {"type": "subtitle", "time": 2866.55, "timestamp": "00:47:46", "text": "跑步中拿到這三個。我單人通關了"}, {"type": "subtitle", "time": 2869.99, "timestamp": "00:47:49", "text": "一次。我的背包裡裝著一些椰子"}, {"type": "subtitle", "time": 2872.47, "timestamp": "00:47:52", "text": "。  是的"}, {"type": "subtitle", "time": 2875.67, "timestamp": "00:47:55", "text": "。所以我傾向於「"}, {"type": "subtitle", "time": 2877.51, "timestamp": "00:47:57", "text": "是」。它的包裝。是的。是的。所以我"}]
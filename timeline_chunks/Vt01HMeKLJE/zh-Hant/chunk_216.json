[{"type": "subtitle", "time": 12965.429, "timestamp": "03:36:05", "text": "是的，我剛才說的是，我的確問過"}, {"type": "subtitle", "time": 12968.79, "timestamp": "03:36:08", "text": "TIS的工作人員課程時間。他們"}, {"type": "subtitle", "time": 12971.429, "timestamp": "03:36:11", "text": "說會通知我。"}, {"type": "subtitle", "time": 12973.51, "timestamp": "03:36:13", "text": "從那以後，他們就再也沒通知我。我"}, {"type": "subtitle", "time": 12976.15, "timestamp": "03:36:16", "text": "不知道發生了什麼事。我本來想給"}, {"type": "subtitle", "time": 12981.349, "timestamp": "03:36:21", "text": "你發訊息，後來就忘了。  是的"}, {"type": "subtitle", "time": 12983.03, "timestamp": "03:36:23", "text": "，在開課之前，"}, {"type": "subtitle", "time": 12985.269, "timestamp": "03:36:25", "text": "我想把所有東西都複習一遍"}, {"type": "subtitle", "time": 12988.469, "timestamp": "03:36:28", "text": "。我想我會在直播中講解"}, {"type": "subtitle", "time": 12991.59, "timestamp": "03:36:31", "text": "所有關於平假名、片假名、"}, {"type": "subtitle", "time": 12994.389, "timestamp": "03:36:34", "text": "文法等等的內容。這樣我就不會"}, {"type": "subtitle", "time": 13000.63, "timestamp": "03:36:40", "text": "本期課程安排在"}, {"type": "subtitle", "time": 13002.71, "timestamp": "03:36:42", "text": "下個月底。"}, {"type": "subtitle", "time": 13006.55, "timestamp": "03:36:46", "text": "哦，等等。當時有"}, {"type": "subtitle", "time": 13009.269, "timestamp": "03:36:49", "text": "不同批次的課程正在進行中。"}, {"type": "subtitle", "time": 13012.469, "timestamp": "03:36:52", "text": "目標是參加下個月的考試。哦好的。"}, {"type": "subtitle", "time": 13014.16, "timestamp": "03:36:54", "text": "好的。 等等，下個月是考試，"}, {"type": "subtitle", "time": 13017.2, "timestamp": "03:36:57", "text": "等等，下個月是考試， 這個月不是JPT考試嗎？有人"}]
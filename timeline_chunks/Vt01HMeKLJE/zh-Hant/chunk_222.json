[{"type": "subtitle", "time": 13323.03, "timestamp": "03:42:03", "text": "您"}, {"type": "subtitle", "time": 13327.67, "timestamp": "03:42:07", "text": "最近有沒有上課，知道具體的上課時間安排嗎"}, {"type": "subtitle", "time": 13330.63, "timestamp": "03:42:10", "text": "？哦，大概是早上6點半"}, {"type": "subtitle", "time": 13334.79, "timestamp": "03:42:14", "text": "到8點左右。啊，"}, {"type": "subtitle", "time": 13337.51, "timestamp": "03:42:17", "text": "那真不錯。"}, {"type": "subtitle", "time": 13352.79, "timestamp": "03:42:32", "text": "我想要早上吃的那份。"}, {"type": "subtitle", "time": 13356.55, "timestamp": "03:42:36", "text": "你會感覺神清氣爽，就像……是啊，"}, {"type": "subtitle", "time": 13358.71, "timestamp": "03:42:38", "text": "一大早你的腦子裡就充滿了日語"}, {"type": "subtitle", "time": 13360.87, "timestamp": "03:42:40", "text": "。"}, {"type": "subtitle", "time": 13362.95, "timestamp": "03:42:42", "text": "現在好多了。你不會受到"}, {"type": "subtitle", "time": 13365.67, "timestamp": "03:42:45", "text": "太多幹擾。"}, {"type": "subtitle", "time": 13368.469, "timestamp": "03:42:48", "text": "晚上你可能會，我可能會感到"}, {"type": "subtitle", "time": 13371.269, "timestamp": "03:42:51", "text": "疲倦或其他什麼感覺。然後我就會犯困什麼的。"}, {"type": "subtitle", "time": 13373.91, "timestamp": "03:42:53", "text": "那很糟糕。  是的"}, {"type": "subtitle", "time": 13377.03, "timestamp": "03:42:57", "text": "，早上更好。  好的，"}]
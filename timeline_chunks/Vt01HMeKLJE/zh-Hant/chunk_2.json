[{"type": "subtitle", "time": 123.109, "timestamp": "00:02:03", "text": "我其實想做，嗯，我其實"}, {"type": "subtitle", "time": 125.109, "timestamp": "00:02:05", "text": "想做，嗯，"}, {"type": "subtitle", "time": 129.749, "timestamp": "00:02:09", "text": "網站方面的事情。然後我看到像"}, {"type": "subtitle", "time": 133.27, "timestamp": "00:02:13", "text": "Astra Mitsuki 和"}, {"type": "subtitle", "time": 137.11, "timestamp": "00:02:17", "text": "Jalpi 這樣的選手在玩巔峰遊戲。所以我就想，"}, {"type": "subtitle", "time": 139.03, "timestamp": "00:02:19", "text": "「好吧，行。我要去刷成就了，"}, {"type": "subtitle", "time": 141.91, "timestamp": "00:02:21", "text": "因為我們"}, {"type": "subtitle", "time": 143.82999999999998, "timestamp": "00:02:23", "text": "昨天通關了。我們"}, {"type": "subtitle", "time": 145.82999999999998, "timestamp": "00:02:25", "text": "昨天到達了頂峰。所以我就想，『"}, {"type": "subtitle", "time": 149.67000000000002, "timestamp": "00:02:29", "text": "好吧，行。』我只會"}, {"type": "subtitle", "time": 152.55, "timestamp": "00:02:32", "text": "埋頭苦幹。我們只需要再"}, {"type": "subtitle", "time": 155.82999999999998, "timestamp": "00:02:35", "text": "拿到幾個徽章就行了。就是這樣。就是這樣"}, {"type": "subtitle", "time": 160.309, "timestamp": "00:02:40", "text": "。我只需要跑完一整趟。」嗯，要完成"}, {"type": "subtitle", "time": 163.50900000000001, "timestamp": "00:02:43", "text": "三輪完整的挑戰才能獲得一些"}, {"type": "subtitle", "time": 165.03, "timestamp": "00:02:45", "text": "徽章。 」"}, {"type": "subtitle", "time": 167.35, "timestamp": "00:02:47", "text": "所以我想，「好吧，好吧。好的，"}, {"type": "subtitle", "time": 170.309, "timestamp": "00:02:50", "text": "我就這麼做。  是的，"}, {"type": "subtitle", "time": 172.39, "timestamp": "00:02:52", "text": "我們今天會盡快完成"}, {"type": "subtitle", "time": 177.19, "timestamp": "00:02:57", "text": "。今晚。是的。所以，閉嘴。"}, {"type": "subtitle", "time": 179.19, "timestamp": "00:02:59", "text": "嗯，"}]
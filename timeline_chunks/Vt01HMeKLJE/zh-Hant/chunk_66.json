[{"type": "subtitle", "time": 3968.309, "timestamp": "01:06:08", "text": "。  我會浪費掉它的，兄弟。我不會浪費它的。"}, {"type": "subtitle", "time": 3975.109, "timestamp": "01:06:15", "text": "我的意思是，沒關係。不過我還需要"}, {"type": "subtitle", "time": 3982.39, "timestamp": "01:06:22", "text": "好的。"}, {"type": "subtitle", "time": 3991.349, "timestamp": "01:06:31", "text": "我現在必須拿著它。我應該讓「好的」。  沒關係。沒關係"}]
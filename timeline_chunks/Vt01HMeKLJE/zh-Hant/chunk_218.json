[{"type": "subtitle", "time": 13083.51, "timestamp": "03:38:03", "text": "並達到 N4 水平，那麼我就可以"}, {"type": "subtitle", "time": 13086.79, "timestamp": "03:38:06", "text": "參加 N4 考試，然後"}, {"type": "subtitle", "time": 13089.67, "timestamp": "03:38:09", "text": "這個人就擁有了 Skyro。等等，真的嗎？這"}, {"type": "subtitle", "time": 13091.349, "timestamp": "03:38:11", "text": "很酷。"}, {"type": "subtitle", "time": 13095.03, "timestamp": "03:38:15", "text": "好的。馬特因為人好而受到大家的讚賞"}, {"type": "subtitle", "time": 13103.67, "timestamp": "03:38:23", "text": "你好，薩巴特。"}, {"type": "subtitle", "time": 13106.15, "timestamp": "03:38:26", "text": "我去年這麼做了。你做到了。你去年也寫過文章"}, {"type": "subtitle", "time": 13110.15, "timestamp": "03:38:30", "text": "。哦，我們走吧。兩個動作，以及"}, {"type": "subtitle", "time": 13126.229, "timestamp": "03:38:46", "text": "真不錯。現在每個月都有"}, {"type": "subtitle", "time": 13131.99, "timestamp": "03:38:51", "text": "很多印度候選人。哦，不錯。"}, {"type": "subtitle", "time": 13135.19, "timestamp": "03:38:55", "text": "每個人都想去日本"}, {"type": "subtitle", "time": 13138.95, "timestamp": "03:38:58", "text": "或學日文。好的。"}]
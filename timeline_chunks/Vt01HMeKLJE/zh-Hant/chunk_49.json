[{"type": "subtitle", "time": 2969.19, "timestamp": "00:49:29", "text": "這張地圖不一樣。他們"}, {"type": "subtitle", "time": 2979.75, "timestamp": "00:49:39", "text": "我一直記著這件事。"}, {"type": "subtitle", "time": 2984.23, "timestamp": "00:49:44", "text": "哦。哦，是的。首先是繩索炮。我們"}, {"type": "subtitle", "time": 2985.91, "timestamp": "00:49:45", "text": "需要它來做第二個。你知道"}, {"type": "subtitle", "time": 2989.109, "timestamp": "00:49:49", "text": "嗎？那我吃掉它。"}, {"type": "subtitle", "time": 2997.349, "timestamp": "00:49:57", "text": "我會留著的。我們現在還需要完成"}]
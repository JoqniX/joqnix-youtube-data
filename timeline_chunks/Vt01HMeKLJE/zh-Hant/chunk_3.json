[{"type": "subtitle", "time": 180.949, "timestamp": "00:03:00", "text": "其次，"}, {"type": "subtitle", "time": 185.43, "timestamp": "00:03:05", "text": "我還沒有開通 Instagram 和 Twitter 帳號。"}, {"type": "subtitle", "time": 190.47, "timestamp": "00:03:10", "text": "讓我來做吧。"}, {"type": "chat", "time": 192.303, "timestamp": "00:03:12", "author": "@aniketwande4403", "avatar": "https://yt4.ggpht.com/ytc/AIdro_m_Z2M4vVHkWPdw0fzo-i-Dy4Pm4-b-bs22Utnn5zkWBHY=s64-c-k-c0x00ffffff-no-rj", "message": "today is day 2 of their Peak stream and they're still on the beach 😭"}, {"type": "subtitle", "time": 195.75, "timestamp": "00:03:15", "text": "我總是忘記發布我的"}, {"type": "subtitle", "time": 198.47, "timestamp": "00:03:18", "text": "Discord 伺服器公告。"}, {"type": "subtitle", "time": 200.869, "timestamp": "00:03:20", "text": "我想把這個流程自動化。我不想"}, {"type": "subtitle", "time": 204.47, "timestamp": "00:03:24", "text": "總是自己做。"}, {"type": "subtitle", "time": 206.949, "timestamp": "00:03:26", "text": "今天是這場史詩級探險的第二天，他們"}, {"type": "subtitle", "time": 210.07, "timestamp": "00:03:30", "text": "仍然在海灘上。  沒關係。"}, {"type": "subtitle", "time": 215.03, "timestamp": "00:03:35", "text": "他們正在學習。不用擔心。沒關係。  沒關係。  沒關係。  就是這樣。"}, {"type": "subtitle", "time": 231.11, "timestamp": "00:03:51", "text": "他們最終會明白的"}, {"type": "subtitle", "time": 234.39, "timestamp": "00:03:54", "text": "。他們需要先通過第一段"}, {"type": "subtitle", "time": 237.429, "timestamp": "00:03:57", "text": "沙灘路段，對吧？只有這樣他們才能"}, {"type": "subtitle", "time": 239.75, "timestamp": "00:03:59", "text": "到達"}]
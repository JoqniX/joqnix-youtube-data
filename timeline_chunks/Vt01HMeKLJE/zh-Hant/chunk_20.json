[{"type": "subtitle", "time": 1204.39, "timestamp": "00:20:04", "text": "等等，我好像在這裡看到他了。"}, {"type": "subtitle", "time": 1221.51, "timestamp": "00:20:21", "text": "我是不是運氣不好，遇到了糟糕的出生點？我應該重新"}, {"type": "subtitle", "time": 1239.43, "timestamp": "00:20:39", "text": "[音樂]"}, {"type": "subtitle", "time": 1242.31, "timestamp": "00:20:42", "text": "我覺得他們最近運氣不太好。"}, {"type": "subtitle", "time": 1249.83, "timestamp": "00:20:49", "text": "我這裡也沒看到蘑菇苗"}, {"type": "subtitle", "time": 1252.149, "timestamp": "00:20:52", "text": "。為什麼這裡沒有蘑菇"}]
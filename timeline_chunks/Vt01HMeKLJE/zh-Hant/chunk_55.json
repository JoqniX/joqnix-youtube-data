[{"type": "subtitle", "time": 3321.67, "timestamp": "00:55:21", "text": "一切。任何東西。我真的什麼都想要。  那就給我點"}, {"type": "subtitle", "time": 3324.79, "timestamp": "00:55:24", "text": "什麼吧。  就"}, {"type": "subtitle", "time": 3334.39, "timestamp": "00:55:34", "text": "剩下的我會從熱帶"}, {"type": "subtitle", "time": 3337.03, "timestamp": "00:55:37", "text": "島嶼上拿到。給我一種蘑菇，一種就好"}, {"type": "subtitle", "time": 3358.549, "timestamp": "00:55:58", "text": "總之，我們將在"}]
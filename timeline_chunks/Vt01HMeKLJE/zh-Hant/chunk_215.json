[{"type": "subtitle", "time": 12900.55, "timestamp": "03:35:00", "text": "我一直在等。我認為應該"}, {"type": "subtitle", "time": 12903.269, "timestamp": "03:35:03", "text": "從八月開始。我好像"}, {"type": "subtitle", "time": 12907.269, "timestamp": "03:35:07", "text": "什麼都沒聽到。我確實問了，"}, {"type": "subtitle", "time": 12911.19, "timestamp": "03:35:11", "text": "但哦，又插播廣告了。"}, {"type": "subtitle", "time": 12914.55, "timestamp": "03:35:14", "text": "等等，我問過了，但他們說會"}, {"type": "subtitle", "time": 12924.63, "timestamp": "03:35:24", "text": "所以，我得在"}, {"type": "subtitle", "time": 12926.469, "timestamp": "03:35:26", "text": "新班級練習hongo。是的。是的。是的。"}, {"type": "subtitle", "time": 12935.91, "timestamp": "03:35:35", "text": "我不知道這堂課是什麼時候。他們說會在"}, {"type": "subtitle", "time": 12941.67, "timestamp": "03:35:41", "text": "開課前通知我。我想複習一下，"}, {"type": "subtitle", "time": 12944.79, "timestamp": "03:35:44", "text": "確保自己跟上進度。我已經很久沒練習了"}, {"type": "subtitle", "time": 12947.11, "timestamp": "03:35:47", "text": "。  是的"}, {"type": "subtitle", "time": 12951.19, "timestamp": "03:35:51", "text": "。我不想，我不想被"}, {"type": "subtitle", "time": 12953.91, "timestamp": "03:35:53", "text": "落下。"}, {"type": "subtitle", "time": 12957.349, "timestamp": "03:35:57", "text": "從律師那裡回來了。您好，歡迎回來。  哎呀，"}]
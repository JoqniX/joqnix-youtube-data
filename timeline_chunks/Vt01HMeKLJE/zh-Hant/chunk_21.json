[{"type": "subtitle", "time": 1260.549, "timestamp": "00:21:00", "text": "我們必須一次性吃很多蘑菇"}, {"type": "subtitle", "time": 1302.789, "timestamp": "00:21:42", "text": "為什麼沒有蘑菇苗？我已經在"}, {"type": "subtitle", "time": 1306.149, "timestamp": "00:21:46", "text": "這個水平線上停留了"}, {"type": "subtitle", "time": 1309.35, "timestamp": "00:21:49", "text": "幾分鐘了。"}, {"type": "subtitle", "time": 1315.27, "timestamp": "00:21:55", "text": "昨天的地圖和今天的地圖差異太大了"}, {"type": "subtitle", "time": 1317.669, "timestamp": "00:21:57", "text": "。"}]
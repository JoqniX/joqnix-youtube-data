[{"type": "subtitle", "time": 2580.55, "timestamp": "00:43:00", "text": "川普啊"}, {"type": "subtitle", "time": 2620.63, "timestamp": "00:43:40", "text": "我對這張地圖不熟悉。所以我就想"}, {"type": "subtitle", "time": 2623.91, "timestamp": "00:43:43", "text": "，呃，我知道那邊有一朵蘑菇"}, {"type": "subtitle", "time": 2631.03, "timestamp": "00:43:51", "text": "但這個區域沒有"}]
[{"type": "subtitle", "time": 4627.59, "timestamp": "01:17:07", "text": "。  好險。我差點就死在那裡了"}, {"type": "subtitle", "time": 4634.87, "timestamp": "01:17:14", "text": "啊，羅布吃飽了。我的天啊。等等，它到底"}, {"type": "subtitle", "time": 4638.39, "timestamp": "01:17:18", "text": "搶劫了多少次來著？我們弄到了一把類似"}, {"type": "subtitle", "time": 4642.149, "timestamp": "01:17:22", "text": "搶劫槍的東西。搶劫槍。"}, {"type": "subtitle", "time": 4652.95, "timestamp": "01:17:32", "text": "結束前還有更多路要走。"}, {"type": "subtitle", "time": 4656.55, "timestamp": "01:17:36", "text": "我們其實需要更多的繩子"}]
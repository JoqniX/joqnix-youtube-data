[{"type": "subtitle", "time": 12841.67, "timestamp": "03:34:01", "text": "天亮再睡。哦，等等。熬夜"}, {"type": "subtitle", "time": 12843.91, "timestamp": "03:34:03", "text": "開始明天第 131 天的新直播，"}, {"type": "subtitle", "time": 12850.79, "timestamp": "03:34:10", "text": "然後睡覺"}, {"type": "subtitle", "time": 12855.03, "timestamp": "03:34:15", "text": "還是不睡覺我也不知道，但我當時想的是，嗯，"}, {"type": "subtitle", "time": 12858.79, "timestamp": "03:34:18", "text": "我會上傳視頻，然後"}, {"type": "subtitle", "time": 12861.51, "timestamp": "03:34:21", "text": "我就去睡覺，明天"}, {"type": "subtitle", "time": 12865.75, "timestamp": "03:34:25", "text": "早點起床。我已經完成了"}, {"type": "subtitle", "time": 12867.83, "timestamp": "03:34:27", "text": "指南頁面和其他所有事情，現在只"}, {"type": "subtitle", "time": 12871.03, "timestamp": "03:34:31", "text": "需要專注於剩下的幾頁"}, {"type": "subtitle", "time": 12874.95, "timestamp": "03:34:34", "text": "網站相關內容。嗯，那我沒事"}, {"type": "subtitle", "time": 12878.87, "timestamp": "03:34:38", "text": "。我沒事，大概。然後還有一些"}, {"type": "subtitle", "time": 12882.229, "timestamp": "03:34:42", "text": "待辦事項要做。"}, {"type": "subtitle", "time": 12884.469, "timestamp": "03:34:44", "text": "之後，我就徹底完成了。完畢。我"}, {"type": "subtitle", "time": 12886.87, "timestamp": "03:34:46", "text": "想知道"}, {"type": "subtitle", "time": 12890.15, "timestamp": "03:34:50", "text": "如何為下個月做準備。還有，"}, {"type": "subtitle", "time": 12892.87, "timestamp": "03:34:52", "text": "老師，如果您還在的話，請問"}, {"type": "subtitle", "time": 12897.429, "timestamp": "03:34:57", "text": "課程有什麼最新進展嗎？"}]
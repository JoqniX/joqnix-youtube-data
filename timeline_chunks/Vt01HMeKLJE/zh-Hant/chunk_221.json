[{"type": "subtitle", "time": 13262.469, "timestamp": "03:41:02", "text": "是的。那你知道嗎？我想"}, {"type": "subtitle", "time": 13265.269, "timestamp": "03:41:05", "text": "開始。是的。你知道，在那之前"}, {"type": "subtitle", "time": 13268.87, "timestamp": "03:41:08", "text": "我必須先設定動畫。是的。照做"}, {"type": "subtitle", "time": 13272.63, "timestamp": "03:41:12", "text": "。任何東西。我仍然保留著"}, {"type": "subtitle", "time": 13274.87, "timestamp": "03:41:14", "text": "他當時在"}, {"type": "subtitle", "time": 13277.59, "timestamp": "03:41:17", "text": "WhatsApp 群組裡分享的那個 ankid。  嗯，是的，"}, {"type": "subtitle", "time": 13280.469, "timestamp": "03:41:20", "text": "我一直在關注這件事。"}, {"type": "subtitle", "time": 13284.229, "timestamp": "03:41:24", "text": "是的。我必須這麼做。"}, {"type": "subtitle", "time": 13286.15, "timestamp": "03:41:26", "text": "所以，"}, {"type": "subtitle", "time": 13288.389, "timestamp": "03:41:28", "text": "你們知道嗎，夥伴們？我們每天至少可以進行"}, {"type": "subtitle", "time": 13290.63, "timestamp": "03:41:30", "text": "一個小時的閱讀練習"}, {"type": "subtitle", "time": 13293.59, "timestamp": "03:41:33", "text": "。我需要……"}, {"type": "subtitle", "time": 13295.83, "timestamp": "03:41:35", "text": "我需要做那件事。你或許可以"}, {"type": "subtitle", "time": 13298.15, "timestamp": "03:41:38", "text": "參加現在的課程。不妨問問。"}, {"type": "subtitle", "time": 13300.79, "timestamp": "03:41:40", "text": "是的。還有，課程時間是幾點？現在是"}, {"type": "subtitle", "time": 13304.79, "timestamp": "03:41:44", "text": "早上嗎？我聽"}, {"type": "subtitle", "time": 13310.79, "timestamp": "03:41:50", "text": "沙姆薩說，早上7點到8點，"}, {"type": "subtitle", "time": 13315.75, "timestamp": "03:41:55", "text": "6點到7點，"}, {"type": "subtitle", "time": 13319.83, "timestamp": "03:41:59", "text": "通常的7點半到9點半。  請問"}]
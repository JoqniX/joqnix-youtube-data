[{"type": "subtitle", "time": 3608.789, "timestamp": "01:00:08", "text": "我現在不想把它放在"}, {"type": "subtitle", "time": 3610.63, "timestamp": "01:00:10", "text": "懸崖邊。"}, {"type": "subtitle", "time": 3613.829, "timestamp": "01:00:13", "text": "呃，如果你問我為什麼，我會說為什麼"}, {"type": "subtitle", "time": 3616.63, "timestamp": "01:00:16", "text": "你不想把它掛在那裡？"}, {"type": "subtitle", "time": 3618.87, "timestamp": "01:00:18", "text": "因為現在我最終必須進行一次"}, {"type": "subtitle", "time": 3621.51, "timestamp": "01:00:21", "text": "不放置任何物品的挑戰。"}, {"type": "subtitle", "time": 3624.47, "timestamp": "01:00:24", "text": "正確的。所以"}, {"type": "subtitle", "time": 3631.43, "timestamp": "01:00:31", "text": "正確的"}, {"type": "subtitle", "time": 3635.03, "timestamp": "01:00:35", "text": "意識等等。"}]
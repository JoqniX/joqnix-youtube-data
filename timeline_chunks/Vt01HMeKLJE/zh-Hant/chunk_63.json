[{"type": "subtitle", "time": 3815.349, "timestamp": "01:03:35", "text": "太令人難過了。  說"}, {"type": "subtitle", "time": 3822.23, "timestamp": "01:03:42", "text": "這太令人難過了。"}, {"type": "subtitle", "time": 3826.63, "timestamp": "01:03:46", "text": "我離你這麼近，卻還是得不到你。  真是"}, {"type": "subtitle", "time": 3829.829, "timestamp": "01:03:49", "text": "太令人難過了。  我離你這麼"}]
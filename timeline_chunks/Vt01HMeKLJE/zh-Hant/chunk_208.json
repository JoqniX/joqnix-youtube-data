[{"type": "subtitle", "time": 12508.95, "timestamp": "03:28:28", "text": "呃[音樂] 好吧，總之，讓它"}, {"type": "subtitle", "time": 12512.309, "timestamp": "03:28:32", "text": "上傳吧，我今天就到"}, {"type": "subtitle", "time": 12513.99, "timestamp": "03:28:33", "text": "這裡了。謝謝大家。  我需要改善睡眠。一般般，一般般。"}, {"type": "subtitle", "time": 12527.269, "timestamp": "03:28:47", "text": "是的。謝謝你今天陪我，米娜。謝謝。謝謝。我就說到這裡吧，今天就到此為止。"}, {"type": "subtitle", "time": 12529.03, "timestamp": "03:28:49", "text": "我們明天，也就是第131天，再見。 131天。是的。謝謝你今天抽出時間。希望你玩得開心"}]
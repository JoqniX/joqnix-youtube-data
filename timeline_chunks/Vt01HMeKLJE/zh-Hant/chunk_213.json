[{"type": "subtitle", "time": 12783.67, "timestamp": "03:33:03", "text": "呃，日光燈管。什麼日光燈？嗯，是的，"}, {"type": "subtitle", "time": 12786.309, "timestamp": "03:33:06", "text": "你點燃"}, {"type": "subtitle", "time": 12788.55, "timestamp": "03:33:08", "text": "信號彈。耀斑。是的，耀斑。然後"}, {"type": "subtitle", "time": 12791.349, "timestamp": "03:33:11", "text": "直升機來了，你就通關了。"}, {"type": "subtitle", "time": 12794.07, "timestamp": "03:33:14", "text": "是的，我當時在挑戰成就。我"}, {"type": "subtitle", "time": 12797.349, "timestamp": "03:33:17", "text": "昨天通關了。呃，我撐了一"}, {"type": "subtitle", "time": 12798.79, "timestamp": "03:33:18", "text": "整夜。我當時在做網站相關的工作"}, {"type": "subtitle", "time": 12800.07, "timestamp": "03:33:20", "text": "。然後我就想，「哦，已經是"}, {"type": "subtitle", "time": 12802.87, "timestamp": "03:33:22", "text": "第二天了。我不想晚上起來"}, {"type": "subtitle", "time": 12805.67, "timestamp": "03:33:25", "text": "直播。」"}, {"type": "subtitle", "time": 12808.469, "timestamp": "03:33:28", "text": "於是我就想，「好吧，我要從晚上"}, {"type": "subtitle", "time": 12813.19, "timestamp": "03:33:33", "text": "7點直播到12點。」所以，我大概做了7到"}, {"type": "subtitle", "time": 12816.63, "timestamp": "03:33:36", "text": "12個吧。上午7:00至中午12:00我們當時試圖通關"}, {"type": "subtitle", "time": 12826.71, "timestamp": "03:33:46", "text": "。然後我就"}, {"type": "subtitle", "time": 12830.07, "timestamp": "03:33:50", "text": "睡著了，現在我在聽茶直播。  聽起來"}, {"type": "subtitle", "time": 12832.229, "timestamp": "03:33:52", "text": "你確實很累。你確定你沒事嗎"}, {"type": "subtitle", "time": 12835.429, "timestamp": "03:33:55", "text": "？嗯，我沒事。我一直在"}, {"type": "subtitle", "time": 12837.91, "timestamp": "03:33:57", "text": "考慮要不要熬夜到"}]
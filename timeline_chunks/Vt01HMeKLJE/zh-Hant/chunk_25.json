[{"type": "subtitle", "time": 1514.71, "timestamp": "00:25:14", "text": "我覺得我出生點運氣不好。我"}, {"type": "subtitle", "time": 1517.35, "timestamp": "00:25:17", "text": "一個蘑菇都沒看到。不，秒。"}, {"type": "subtitle", "time": 1519.909, "timestamp": "00:25:19", "text": "我還沒看到第二個刷新點。那是"}, {"type": "subtitle", "time": 1522.71, "timestamp": "00:25:22", "text": "藥用草本植物，還有"}, {"type": "subtitle", "time": 1534.789, "timestamp": "00:25:34", "text": "我們可以用這個東西吃飯。  就"}, {"type": "subtitle", "time": 1537.43, "timestamp": "00:25:37", "text": "放在那裡。"}, {"type": "subtitle", "time": 1546.789, "timestamp": "00:25:46", "text": "我這次是在挑戰活塞挑戰嗎"}, {"type": "subtitle", "time": 1549.99, "timestamp": "00:25:49", "text": "？不，我只是覺得"}, {"type": "subtitle", "time": 1555.11, "timestamp": "00:25:55", "text": "這次我只打算吃蘑菇。這裡"}, {"type": "subtitle", "time": 1557.83, "timestamp": "00:25:57", "text": "將涵蓋這部分內容。"}, {"type": "subtitle", "time": 1559.909, "timestamp": "00:25:59", "text": "你知道嗎？我將提出活塞"}]
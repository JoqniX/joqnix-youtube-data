[{"type": "subtitle", "time": 13501.67, "timestamp": "03:45:01", "text": "。"}, {"type": "subtitle", "time": 13509.429, "timestamp": "03:45:09", "text": "ああ、今でも覚えているよ。"}, {"type": "subtitle", "time": 13511.83, "timestamp": "03:45:11", "text": "あなたが"}, {"type": "subtitle", "time": 13514.389, "timestamp": "03:45:14", "text": "私の配信を通してそれを知ったという事実。"}, {"type": "subtitle", "time": 13518.15, "timestamp": "03:45:18", "text": "チャット"}, {"type": "subtitle", "time": 13521.59, "timestamp": "03:45:21", "text": "練習でパニック状態になってしまいました。   ああ"}, {"type": "subtitle", "time": 13524.71, "timestamp": "03:45:24", "text": "、今回はそういうことにはならないといいんだけどね"}, {"type": "subtitle", "time": 13528.47, "timestamp": "03:45:28", "text": "。"}, {"type": "subtitle", "time": 13529.99, "timestamp": "03:45:29", "text": "[音楽]"}, {"type": "subtitle", "time": 13535.189, "timestamp": "03:45:35", "text": "そしてユキサンは、次のバッチ、例えば"}, {"type": "subtitle", "time": 13539.269, "timestamp": "03:45:39", "text": "4月入学、"}, {"type": "subtitle", "time": 13543.11, "timestamp": "03:45:43", "text": "4月入学については、"}, {"type": "subtitle", "time": 13546.79, "timestamp": "03:45:46", "text": "8月か今月に面接をしなければならないと言いました"}, {"type": "subtitle", "time": 13549.349, "timestamp": "03:45:49", "text": "。2週間目に2人の学生が合格しました。 待って、"}, {"type": "subtitle", "time": 13551.189, "timestamp": "03:45:51", "text": "本当に"}, {"type": "subtitle", "time": 13556.07, "timestamp": "03:45:56", "text": "待って、新しい人、新しい人が好きな人。"}]
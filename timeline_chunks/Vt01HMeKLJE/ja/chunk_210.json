[{"type": "subtitle", "time": 12600.309, "timestamp": "03:30:00", "text": "8時か9時に寝ています。以前はいつも"}, {"type": "subtitle", "time": 12607.429, "timestamp": "03:30:07", "text": "こうやって一晩中起きていて、午後6時半頃に起きていました。"}, {"type": "subtitle", "time": 12612.469, "timestamp": "03:30:12", "text": "夕食を済ませてから配信します。 ずっとそうだったんです"}, {"type": "subtitle", "time": 12616.389, "timestamp": "03:30:16", "text": "。 私の睡眠スケジュールは"}, {"type": "subtitle", "time": 12622.55, "timestamp": "03:30:22", "text": "最近、うーん。 ウェブサイト"}, {"type": "subtitle", "time": 12625.75, "timestamp": "03:30:25", "text": "関連の作業をしていました。 だから、「そうだな、"}, {"type": "subtitle", "time": 12627.75, "timestamp": "03:30:27", "text": "ゲーム配信はやったことないから、"}, {"type": "subtitle", "time": 12629.67, "timestamp": "03:30:29", "text": "ゲーム配信をやってみよう」と思ったんです。"}, {"type": "subtitle", "time": 12632.55, "timestamp": "03:30:32", "text": "うん。 えーっと、その話は、"}, {"type": "subtitle", "time": 12638.389, "timestamp": "03:30:38", "text": "友達や一人で休暇に出かけるはずだったんだけど、飛行機が"}, {"type": "subtitle", "time": 12641.429, "timestamp": "03:30:41", "text": "島に不時着したっていう話。 だから、"}, {"type": "subtitle", "time": 12646.469, "timestamp": "03:30:46", "text": "頂上まで行かなければならない。"}, {"type": "subtitle", "time": 12649.51, "timestamp": "03:30:49", "text": "えっと、地図は4つくらいあります。 まず一つ目は、あの"}, {"type": "subtitle", "time": 12656.15, "timestamp": "03:30:56", "text": "熱帯の島です。 熱帯の島ではなく、"}, {"type": "subtitle", "time": 12658.229, "timestamp": "03:30:58", "text": "砂浜などがある普通の島です"}]
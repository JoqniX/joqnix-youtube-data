[{"type": "subtitle", "time": 15250.87, "timestamp": "04:14:10", "text": "日本語のインファイア関連のものをすべて完全に復習した後、それをやろうと計画していました。 そして、"}, {"type": "subtitle", "time": 15253.99, "timestamp": "04:14:13", "text": "ええ、授業が始まってからは、"}, {"type": "subtitle", "time": 15257.91, "timestamp": "04:14:17", "text": "毎日、努力を重ねていくことになります。そうすれば、常に"}, {"type": "subtitle", "time": 15266.469, "timestamp": "04:14:26", "text": "学び続けることになるでしょう。 それで、"}, {"type": "subtitle", "time": 15274.229, "timestamp": "04:14:34", "text": "ええ、紹介ビデオとか"}, {"type": "subtitle", "time": 15288.95, "timestamp": "04:14:48", "text": "JPコラボの時に、いきなり"}, {"type": "subtitle", "time": 15291.75, "timestamp": "04:14:51", "text": "英語を使い始めたので、かなり戸惑いました"}, {"type": "subtitle", "time": 15294.95, "timestamp": "04:14:54", "text": "。 ありがたいことに、その人は"}]
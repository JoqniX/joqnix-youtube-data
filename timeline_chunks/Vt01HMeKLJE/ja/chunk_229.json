[{"type": "subtitle", "time": 13740.07, "timestamp": "03:49:00", "text": "。 パートタイムのボスか"}, {"type": "subtitle", "time": 13741.59, "timestamp": "03:49:01", "text": "何か。   確か"}, {"type": "subtitle", "time": 13743.51, "timestamp": "03:49:03", "text": "コンビニか"}, {"type": "subtitle", "time": 13746.389, "timestamp": "03:49:06", "text": "何かだったと思う。 よくわからない。"}, {"type": "subtitle", "time": 13750.309, "timestamp": "03:49:10", "text": "私は「なんてことだ」と思いました。"}, {"type": "subtitle", "time": 13752.63, "timestamp": "03:49:12", "text": "うん。 彼らは、"}, {"type": "subtitle", "time": 13756.79, "timestamp": "03:49:16", "text": "他の人たちが適応するのに苦労している様子などを私に話してくれました"}, {"type": "subtitle", "time": 13759.51, "timestamp": "03:49:19", "text": "。"}, {"type": "subtitle", "time": 13764.309, "timestamp": "03:49:24", "text": "そう、"}, {"type": "subtitle", "time": 13767.83, "timestamp": "03:49:27", "text": "日本語が足りないんだよね？ それもまた"}, {"type": "subtitle", "time": 13771.349, "timestamp": "03:49:31", "text": "彼らにとっては難しいことなのかもしれない。   どちらかというと、"}, {"type": "subtitle", "time": 13773.59, "timestamp": "03:49:33", "text": "貧しい男を描いた"}, {"type": "subtitle", "time": 13784.87, "timestamp": "03:49:44", "text": "大変な道のりになるだろう。 それは"}, {"type": "subtitle", "time": 13787.3, "timestamp": "03:49:47", "text": "困難で厳しいものになるだろう。"}, {"type": "subtitle", "time": 13798.87, "timestamp": "03:49:58", "text": "こんにちは。 では、待ってください。 えっと、"}]
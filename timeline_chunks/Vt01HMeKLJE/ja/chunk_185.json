[{"type": "subtitle", "time": 11102.309, "timestamp": "03:05:02", "text": "ダウンロードと"}, {"type": "subtitle", "time": 11104.55, "timestamp": "03:05:04", "text": "アップロードはゆっくり進めます。"}, {"type": "subtitle", "time": 11108.95, "timestamp": "03:05:08", "text": "ええ、午後7時8分までには。"}, {"type": "subtitle", "time": 11111.75, "timestamp": "03:05:11", "text": "停電が発生します。   それまでは"}, {"type": "subtitle", "time": 11141.269, "timestamp": "03:05:41", "text": "ストリームに仕事のストリームを入れてはいけないことは分かっています。 今日の配信は"}, {"type": "subtitle", "time": 11143.349, "timestamp": "03:05:43", "text": "ゲーム配信です。 だから、私は"}, {"type": "subtitle", "time": 11145.99, "timestamp": "03:05:45", "text": "ゲーム配信だけをするべきではないんです。   それは"}, {"type": "subtitle", "time": 11150.63, "timestamp": "03:05:50", "text": "承知しています。 大丈夫。   えっと"}, {"type": "subtitle", "time": 11152.309, "timestamp": "03:05:52", "text": "、じゃあ、"}]
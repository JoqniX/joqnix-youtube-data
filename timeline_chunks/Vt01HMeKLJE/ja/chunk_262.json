[{"type": "subtitle", "time": 15722.79, "timestamp": "04:22:02", "text": "ええ、絵本のやつです。   わかりました、"}, {"type": "subtitle", "time": 15727.189, "timestamp": "04:22:07", "text": "ダウンロードしたままにしておきます。   わかりました"}, {"type": "subtitle", "time": 15729.91, "timestamp": "04:22:09", "text": "、今日中にやります。 明日ではない。"}, {"type": "subtitle", "time": 15731.59, "timestamp": "04:22:11", "text": "今日。"}, {"type": "subtitle", "time": 15741.99, "timestamp": "04:22:21", "text": "こんにちは。 明日やります。"}, {"type": "subtitle", "time": 15749.75, "timestamp": "04:22:29", "text": "ない。 覚えていません。 ああ、"}, {"type": "subtitle", "time": 15752.309, "timestamp": "04:22:32", "text": "名前を忘れてしまった。  「うん」という一文字の"}, {"type": "subtitle", "time": 15754.229, "timestamp": "04:22:34", "text": "もの。 うん、子供向けの"}, {"type": "subtitle", "time": 15756.309, "timestamp": "04:22:36", "text": "絵本みたいな感じだよ。"}, {"type": "subtitle", "time": 15766.95, "timestamp": "04:22:46", "text": "私の目標は、少なくとも4月まで、つまり"}, {"type": "subtitle", "time": 15769.59, "timestamp": "04:22:49", "text": "3月まで、出発する前に、"}]
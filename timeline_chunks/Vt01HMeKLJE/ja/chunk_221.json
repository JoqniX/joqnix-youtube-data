[{"type": "subtitle", "time": 13262.469, "timestamp": "03:41:02", "text": "。 じゃあ、知ってる？ 私は"}, {"type": "subtitle", "time": 13265.269, "timestamp": "03:41:05", "text": "始めたい。 うん。 ご存知のとおり、その前に"}, {"type": "subtitle", "time": 13268.87, "timestamp": "03:41:08", "text": "アニメーションの設定をする必要があります。 うん。 そうしてください"}, {"type": "subtitle", "time": 13272.63, "timestamp": "03:41:12", "text": "。 何でもいいよ。 私はまだ、"}, {"type": "subtitle", "time": 13274.87, "timestamp": "03:41:14", "text": "彼が当時WhatsAppグループで共有したアンキッドを持っています"}, {"type": "subtitle", "time": 13277.59, "timestamp": "03:41:17", "text": "。   ええ、私もそれを"}, {"type": "subtitle", "time": 13280.469, "timestamp": "03:41:20", "text": "追っています。"}, {"type": "subtitle", "time": 13284.229, "timestamp": "03:41:24", "text": "うん。 そうしなければならない。"}, {"type": "subtitle", "time": 13286.15, "timestamp": "03:41:26", "text": "それでね"}, {"type": "subtitle", "time": 13288.389, "timestamp": "03:41:28", "text": "、みんな？ 私たちは"}, {"type": "subtitle", "time": 13293.59, "timestamp": "03:41:33", "text": "毎日少なくとも1時間は読書練習をすることができます。 私はそれをやらなければならない"}, {"type": "subtitle", "time": 13295.83, "timestamp": "03:41:35", "text": "。 おそらく、"}, {"type": "subtitle", "time": 13298.15, "timestamp": "03:41:38", "text": "現在開講中のクラスに参加できるでしょう。 聞いてみてください。"}, {"type": "subtitle", "time": 13300.79, "timestamp": "03:41:40", "text": "うん。 あと、授業は何時からですか？"}, {"type": "subtitle", "time": 13304.79, "timestamp": "03:41:44", "text": "朝ですか？"}, {"type": "subtitle", "time": 13310.79, "timestamp": "03:41:50", "text": "シャムサが朝7時から8時、いや"}, {"type": "subtitle", "time": 13315.75, "timestamp": "03:41:55", "text": "6時から、5時から7時と言っていたのを聞きました。それから、"}, {"type": "subtitle", "time": 13319.83, "timestamp": "03:41:59", "text": "7時半から9時半のようないつもの時間帯もあります。   もし"}]
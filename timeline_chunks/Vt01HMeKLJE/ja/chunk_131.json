[{"type": "subtitle", "time": 7870.149, "timestamp": "02:11:10", "text": "それはただの荷物です。"}, {"type": "subtitle", "time": 7887.51, "timestamp": "02:11:27", "text": "卵を手に入れたら、そのまま持っておけばいいんです"}, {"type": "subtitle", "time": 7889.99, "timestamp": "02:11:29", "text": "。"}, {"type": "subtitle", "time": 7892.79, "timestamp": "02:11:32", "text": "手で持って運べるような感じ。 自動的に"}, {"type": "subtitle", "time": 7899.35, "timestamp": "02:11:39", "text": "大丈夫だよ。"}, {"type": "subtitle", "time": 7902.55, "timestamp": "02:11:42", "text": "そして、だんだんお腹が空いてきた。"}, {"type": "subtitle", "time": 7904.709, "timestamp": "02:11:44", "text": "そこが問題なんです。"}, {"type": "subtitle", "time": 7914.79, "timestamp": "02:11:54", "text": "私も"}, {"type": "subtitle", "time": 7917.99, "timestamp": "02:11:57", "text": "パッケージなしの食品買い出しをしています。"}]
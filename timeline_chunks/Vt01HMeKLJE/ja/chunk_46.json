[{"type": "subtitle", "time": 2785.19, "timestamp": "00:46:25", "text": "このマップでは、私はこんなに運が悪いのでしょうか？"}, {"type": "subtitle", "time": 2799.51, "timestamp": "00:46:39", "text": "、あのね？ さあ行こう。"}, {"type": "subtitle", "time": 2809.349, "timestamp": "00:46:49", "text": "ああ、キノコ。"}, {"type": "subtitle", "time": 2810.95, "timestamp": "00:46:50", "text": "毒性のないものをご使用ください。"}, {"type": "subtitle", "time": 2816.069, "timestamp": "00:46:56", "text": "私は毒のある人間にならざるを得なかった。 うーん、今回の成績は"}]
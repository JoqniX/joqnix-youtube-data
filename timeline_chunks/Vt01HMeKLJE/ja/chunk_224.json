[{"type": "subtitle", "time": 13442.469, "timestamp": "03:44:02", "text": "新しいバージョンを学ぶことができます。 もし時間があれば、"}, {"type": "subtitle", "time": 13445.349, "timestamp": "03:44:05", "text": "夜だけでも参加して練習できますよ。"}, {"type": "subtitle", "time": 13449.189, "timestamp": "03:44:09", "text": "例えば、読書やワーク"}, {"type": "subtitle", "time": 13452.55, "timestamp": "03:44:12", "text": "シートなどの作業があれば、"}, {"type": "subtitle", "time": 13456.87, "timestamp": "03:44:16", "text": "それをしたり、Anki を使ったりできますよね。でも、"}, {"type": "subtitle", "time": 13459.67, "timestamp": "03:44:19", "text": "NFI クラスのようなものだとおっしゃっていたと思いますので、"}, {"type": "subtitle", "time": 13461.59, "timestamp": "03:44:21", "text": "最初から、ひらがな、カタカナ、"}, {"type": "subtitle", "time": 13474.389, "timestamp": "03:44:34", "text": "私は自由な時間があるので、"}, {"type": "subtitle", "time": 13476.55, "timestamp": "03:44:36", "text": "技術的には許可することはできません。そして、もし私が事前に知らせたとしても"}, {"type": "subtitle", "time": 13480.389, "timestamp": "03:44:40", "text": "。 ああ、いいね。 ニース。   今度こそ前回と同じ過ちを繰り返さ"}, {"type": "subtitle", "time": 13483.03, "timestamp": "03:44:43", "text": "ないことを願うばかりだ"}, {"type": "subtitle", "time": 13486.87, "timestamp": "03:44:46", "text": "。 いいえ。"}, {"type": "subtitle", "time": 13492.15, "timestamp": "03:44:52", "text": "面接の時など、すべてにおいて。"}, {"type": "subtitle", "time": 13494.15, "timestamp": "03:44:54", "text": "ああ、神様。"}, {"type": "subtitle", "time": 13496.79, "timestamp": "03:44:56", "text": "今度こそ学生たちが"}, {"type": "subtitle", "time": 13498.71, "timestamp": "03:44:58", "text": "面接などに向けてしっかり準備してくれることを願おう"}]
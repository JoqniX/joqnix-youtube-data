[{"type": "subtitle", "time": 15120.79, "timestamp": "04:12:00", "text": "恋愛を学びたくない。"}, {"type": "subtitle", "time": 15122.95, "timestamp": "04:12:02", "text": "私は日本語を勉強しています。"}, {"type": "subtitle", "time": 15126.15, "timestamp": "04:12:06", "text": "日本人と一緒に学ばなければならない。"}, {"type": "subtitle", "time": 15130.63, "timestamp": "04:12:10", "text": "なぜ？ あ、待って。 うっかりして、ええ。"}, {"type": "subtitle", "time": 15132.229, "timestamp": "04:12:12", "text": "じゃあ、"}, {"type": "subtitle", "time": 15136.79, "timestamp": "04:12:16", "text": "練習してみようかな。"}, {"type": "subtitle", "time": 15140.63, "timestamp": "04:12:20", "text": "うん。 なぜなら、私にとっての究極の目標は、"}, {"type": "subtitle", "time": 15143.11, "timestamp": "04:12:23", "text": "日本に着いたら、"}, {"type": "subtitle", "time": 15147.429, "timestamp": "04:12:27", "text": "KokのブースやKroのイベントに参加して、そこでどんな"}, {"type": "subtitle", "time": 15153.83, "timestamp": "04:12:33", "text": "体験ができるのか、どんな感じなのかを確かめることだからです。"}, {"type": "subtitle", "time": 15162.229, "timestamp": "04:12:42", "text": "うん。"}, {"type": "subtitle", "time": 15165.349, "timestamp": "04:12:45", "text": "そして、他の人が"}, {"type": "subtitle", "time": 15170.389, "timestamp": "04:12:50", "text": "ストリーマーなどに使うJoey Sound Kokというソフトウェアは、"}, {"type": "subtitle", "time": 15178.87, "timestamp": "04:12:58", "text": "日本にいない限りSteamでは入手できません。 そういうことだ。 それも"}]
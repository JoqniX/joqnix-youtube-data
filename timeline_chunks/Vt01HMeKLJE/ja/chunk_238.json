[{"type": "subtitle", "time": 14280.389, "timestamp": "03:58:00", "text": "歌を覚えたいと思ったら、"}, {"type": "subtitle", "time": 14285.269, "timestamp": "03:58:05", "text": "日本語の歌詞を読むでしょう。 たとえ"}, {"type": "subtitle", "time": 14288.87, "timestamp": "03:58:08", "text": "コカールにいても、"}, {"type": "subtitle", "time": 14295.189, "timestamp": "03:58:15", "text": "画面に表示される日本語を読まなければならないでしょう？"}, {"type": "subtitle", "time": 14301.189, "timestamp": "03:58:21", "text": "一方、私はラマギ版を使って"}, {"type": "subtitle", "time": 14304.07, "timestamp": "03:58:24", "text": "英語版を読んでいます"}, {"type": "subtitle", "time": 14305.59, "timestamp": "03:58:25", "text": "。"}, {"type": "subtitle", "time": 14307.99, "timestamp": "03:58:27", "text": "うん、それはまずいね。 そうですね、それが"}, {"type": "subtitle", "time": 14311.11, "timestamp": "03:58:31", "text": "私が目指していることの一つです。"}, {"type": "subtitle", "time": 14313.349, "timestamp": "03:58:33", "text": "積極的に"}, {"type": "subtitle", "time": 14315.91, "timestamp": "03:58:35", "text": "音楽の練習をしたり、歌を歌ったり、"}, {"type": "subtitle", "time": 14318.15, "timestamp": "03:58:38", "text": "歌を習ったりするつもりです。 それは、"}, {"type": "subtitle", "time": 14324.79, "timestamp": "03:58:44", "text": "読書が上手になったらやってみたいことの一つです。 そう、こういうことや"}, {"type": "subtitle", "time": 14328.229, "timestamp": "03:58:48", "text": "こういうこと、こういう歌の歌詞を"}, {"type": "subtitle", "time": 14331.189, "timestamp": "03:58:51", "text": "日本語できちんと学ぶこと。 それは"}, {"type": "subtitle", "time": 14333.349, "timestamp": "03:58:53", "text": "いいですね。"}]
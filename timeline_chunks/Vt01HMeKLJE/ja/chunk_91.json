[{"type": "subtitle", "time": 5462.629, "timestamp": "01:31:02", "text": "。 何てことだ。 何てことだ。 何てことだ"}, {"type": "subtitle", "time": 5464.87, "timestamp": "01:31:04", "text": "。   何てことだ"}, {"type": "subtitle", "time": 5469.11, "timestamp": "01:31:09", "text": "。 いいえ。彼らはそれを奪った。"}, {"type": "subtitle", "time": 5476.87, "timestamp": "01:31:16", "text": "。 彼らはそれを持ち去った。   私は"}, {"type": "subtitle", "time": 5481.35, "timestamp": "01:31:21", "text": "誓います。 どこ？ ハニカムはどこにありますか？"}, {"type": "subtitle", "time": 5484.229, "timestamp": "01:31:24", "text": "あなたはそれを受け取ったのですか？"}, {"type": "subtitle", "time": 5490.07, "timestamp": "01:31:30", "text": "いや、奴らはハニカムを持って行ったんだよ、兄弟。 いいえ、"}, {"type": "subtitle", "time": 5492.629, "timestamp": "01:31:32", "text": "彼らはハニカムを持ち去りました。   何てことだ"}, {"type": "subtitle", "time": 5501.11, "timestamp": "01:31:41", "text": "ああ、もう二度とそんなことで命を危険にさらすつもりはない"}, {"type": "subtitle", "time": 5503.59, "timestamp": "01:31:43", "text": "。 ああ、神様、"}, {"type": "subtitle", "time": 5513.83, "timestamp": "01:31:53", "text": "私は半分毒されている。"}, {"type": "subtitle", "time": 5515.83, "timestamp": "01:31:55", "text": "でも待って、彼らはどうやって"}]
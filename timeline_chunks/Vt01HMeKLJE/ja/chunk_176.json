[{"type": "subtitle", "time": 10571.03, "timestamp": "02:56:11", "text": "新しい猫を見たいのでしょうね。 えっと、"}, {"type": "subtitle", "time": 10574.23, "timestamp": "02:56:14", "text": "これはまるで老猫のようだったけど、"}, {"type": "subtitle", "time": 10577.67, "timestamp": "02:56:17", "text": "彼が彼女を出産したんだ。   えっと、ちょっと"}, {"type": "subtitle", "time": 10583.429, "timestamp": "02:56:23", "text": "スマホを開いてみます。 でも、"}, {"type": "subtitle", "time": 10589.75, "timestamp": "02:56:29", "text": "彼女は私のベッドの下で出産したんです"}, {"type": "subtitle", "time": 10597.51, "timestamp": "02:56:37", "text": "。"}, {"type": "subtitle", "time": 10599.03, "timestamp": "02:56:39", "text": "では、"}, {"type": "subtitle", "time": 10618.63, "timestamp": "02:56:58", "text": "[笑い] 猫が"}]
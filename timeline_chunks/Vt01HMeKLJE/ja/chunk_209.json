[{"type": "subtitle", "time": 12544.71, "timestamp": "03:29:04", "text": "ソロでもう一度やって、チャレンジに挑戦してベストを尽くします"}, {"type": "subtitle", "time": 12553.349, "timestamp": "03:29:13", "text": "。 私たちはハニカム構造物"}, {"type": "subtitle", "time": 12562.309, "timestamp": "03:29:22", "text": "やその他のものを製作していました。"}, {"type": "subtitle", "time": 12565.99, "timestamp": "03:29:25", "text": "ああ、こんにちは。 こんにちは、カワ。"}, {"type": "subtitle", "time": 12570.63, "timestamp": "03:29:30", "text": "こんにちは、先生。 元気かい？"}, {"type": "subtitle", "time": 12576.87, "timestamp": "03:29:36", "text": "お元気でお過ごしでしょうか。"}, {"type": "subtitle", "time": 12583.67, "timestamp": "03:29:43", "text": "私たちは「ピーク」というゲームをプレイしていました。それは、"}, {"type": "subtitle", "time": 12586.15, "timestamp": "03:29:46", "text": "山を登って、"}, {"type": "subtitle", "time": 12590.469, "timestamp": "03:29:50", "text": "えーと、何かの終わりに到達するというゲームです"}, {"type": "subtitle", "time": 12593.19, "timestamp": "03:29:53", "text": "。"}, {"type": "subtitle", "time": 12595.91, "timestamp": "03:29:55", "text": "かなり遅いですよね？ うん。 最近は午前"}]
[{"type": "subtitle", "time": 16623.89, "timestamp": "04:37:03", "text": "版。 韓国語版。 ニース。"}, {"type": "subtitle", "time": 16626.07, "timestamp": "04:37:06", "text": "【音楽】"}, {"type": "subtitle", "time": 16633.189, "timestamp": "04:37:13", "text": "私は以前それをしていなかったようだ"}, {"type": "subtitle", "time": 16636.31, "timestamp": "04:37:16", "text": "。 あ、"}, {"type": "subtitle", "time": 16638.869, "timestamp": "04:37:18", "text": "待って。 日本語キーボードをお持ちですか？"}, {"type": "subtitle", "time": 16641.59, "timestamp": "04:37:21", "text": "それとも、"}, {"type": "subtitle", "time": 16649.83, "timestamp": "04:37:29", "text": "これは何のゲームですか？"}, {"type": "subtitle", "time": 16652.07, "timestamp": "04:37:32", "text": "おお。"}, {"type": "subtitle", "time": 16655.75, "timestamp": "04:37:35", "text": "登場人物たちは気性が荒い。"}, {"type": "subtitle", "time": 16666.23, "timestamp": "04:37:46", "text": "そしてアメリカはまさに現代のアメリカだ。 え、"}]
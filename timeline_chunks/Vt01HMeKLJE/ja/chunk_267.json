[{"type": "subtitle", "time": 16021.269, "timestamp": "04:27:01", "text": "メディアキットとかプレスキットとかメディア"}, {"type": "subtitle", "time": 16024.469, "timestamp": "04:27:04", "text": "キットみたいなものを作成する必要があるんだ。 それは必要だと思います。"}, {"type": "subtitle", "time": 16028.71, "timestamp": "04:27:08", "text": "ええと、ええ、"}, {"type": "subtitle", "time": 16033.429, "timestamp": "04:27:13", "text": "今すぐストリーミングしてください。"}, {"type": "subtitle", "time": 16035.429, "timestamp": "04:27:15", "text": "少し時間があるので、今から配信して彼を殺そうかな。 しかし、私にとって"}, {"type": "subtitle", "time": 16039.67, "timestamp": "04:27:19", "text": "ゲームを選ぶことは、まさに内なる地獄だ。"}, {"type": "subtitle", "time": 16042.79, "timestamp": "04:27:22", "text": "ところで、どんなゲームが好きなんですか？ どんな"}, {"type": "subtitle", "time": 16045.189, "timestamp": "04:27:25", "text": "ゲームが好きですか？"}, {"type": "subtitle", "time": 16050.389, "timestamp": "04:27:30", "text": "パズルはお好きですか？ いいえ。パズルゲームですか？ いや、"}, {"type": "subtitle", "time": 16053.83, "timestamp": "04:27:33", "text": "それを再生して。 ええと、猫が好きなら、または"}, {"type": "subtitle", "time": 16055.75, "timestamp": "04:27:35", "text": "好みがあるなら、猫が好きか"}, {"type": "subtitle", "time": 16058.79, "timestamp": "04:27:38", "text": "犬が好きか、"}, {"type": "subtitle", "time": 16063.59, "timestamp": "04:27:43", "text": "きちんと整理された猫を選びましょう。"}, {"type": "subtitle", "time": 16069.99, "timestamp": "04:27:49", "text": "それはどこで手に入れたの？ そう"}, {"type": "subtitle", "time": 16072.229, "timestamp": "04:27:52", "text": "言っていませんでしたか？ 例えば、『"}, {"type": "subtitle", "time": 16074.229, "timestamp": "04:27:54", "text": "ウィザリング・ウェーブス』をプレイしていた時、パズルに苦戦していました"}, {"type": "subtitle", "time": 16078.63, "timestamp": "04:27:58", "text": "。 いや、覚えてる？えっと、いつだったっけ"}]
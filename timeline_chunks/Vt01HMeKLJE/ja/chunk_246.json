[{"type": "subtitle", "time": 14765.349, "timestamp": "04:06:05", "text": "あ、広告は終わったの？"}, {"type": "subtitle", "time": 14767.189, "timestamp": "04:06:07", "text": "うん。"}, {"type": "subtitle", "time": 14769.51, "timestamp": "04:06:09", "text": "この曲はそこにある。"}, {"type": "subtitle", "time": 14778.389, "timestamp": "04:06:18", "text": "計画するような話ですね。 これとこれは、"}, {"type": "subtitle", "time": 14782.63, "timestamp": "04:06:22", "text": "私が昔よく練習していた2曲です。"}, {"type": "subtitle", "time": 14784.63, "timestamp": "04:06:24", "text": "そうそう。 ミサギ。"}, {"type": "subtitle", "time": 14788.07, "timestamp": "04:06:28", "text": "これは"}, {"type": "subtitle", "time": 14790.79, "timestamp": "04:06:30", "text": "CLANADの定番曲です。"}, {"type": "subtitle", "time": 14794.55, "timestamp": "04:06:34", "text": "私が警告を受けた原因となった曲。"}, {"type": "subtitle", "time": 14796.389, "timestamp": "04:06:36", "text": "えっと、私のチャンネルに"}, {"type": "subtitle", "time": 14799.91, "timestamp": "04:06:39", "text": "警告が出た曲です。 うん。"}, {"type": "subtitle", "time": 14804.79, "timestamp": "04:06:44", "text": "リムからのガイドに感謝します。"}, {"type": "subtitle", "time": 14807.11, "timestamp": "04:06:47", "text": "そして、誰かが提案したこの曲はとても"}, {"type": "subtitle", "time": 14809.59, "timestamp": "04:06:49", "text": "速くて、"}, {"type": "subtitle", "time": 14813.189, "timestamp": "04:06:53", "text": "私は速い日本語の歌を歌えません。それから、"}, {"type": "subtitle", "time": 14817.67, "timestamp": "04:06:57", "text": "カイウサクネイションズ、カイウがいて、カフェがいて、"}]
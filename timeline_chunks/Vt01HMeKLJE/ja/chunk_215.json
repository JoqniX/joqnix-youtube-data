[{"type": "subtitle", "time": 12900.55, "timestamp": "03:35:00", "text": "待っていたんです。"}, {"type": "subtitle", "time": 12903.269, "timestamp": "03:35:03", "text": "8月から始まると思います。 何も聞いていないようですね"}, {"type": "subtitle", "time": 12907.269, "timestamp": "03:35:07", "text": "。 聞いてみたんだ"}, {"type": "subtitle", "time": 12911.19, "timestamp": "03:35:11", "text": "けど、あぁ、またCMだ。"}, {"type": "subtitle", "time": 12914.55, "timestamp": "03:35:14", "text": "待って、確かに問い合わせたんだけど、後で連絡するって言われたんだ"}, {"type": "subtitle", "time": 12926.469, "timestamp": "03:35:26", "text": "新しい授業で本語を練習しなくてはならない。 うん。 うん。 うん。"}, {"type": "subtitle", "time": 12933.269, "timestamp": "03:35:33", "text": "だから、その授業がいつなのか分から"}, {"type": "subtitle", "time": 12935.91, "timestamp": "03:35:35", "text": "ないんです。"}, {"type": "subtitle", "time": 12938.87, "timestamp": "03:35:38", "text": "授業が"}, {"type": "subtitle", "time": 12941.67, "timestamp": "03:35:41", "text": "始まる前に知らせてくれると言っていました。 復習して、遅れを取り戻したいんです"}, {"type": "subtitle", "time": 12944.79, "timestamp": "03:35:44", "text": "。 しばらく練習していません"}, {"type": "subtitle", "time": 12947.11, "timestamp": "03:35:47", "text": "。"}, {"type": "subtitle", "time": 12951.19, "timestamp": "03:35:51", "text": "うん。 いや、私はしたくない、私は置いていかれたくない"}, {"type": "subtitle", "time": 12953.91, "timestamp": "03:35:53", "text": "。"}, {"type": "subtitle", "time": 12957.349, "timestamp": "03:35:57", "text": "弁護士から戻ってきた。 こんにちは、おかえりなさい。"}]
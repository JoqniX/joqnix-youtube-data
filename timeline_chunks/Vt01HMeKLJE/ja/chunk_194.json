[{"type": "subtitle", "time": 11680.55, "timestamp": "03:14:40", "text": "アップロードが終わったら、私は行きます"}, {"type": "subtitle", "time": 11683.51, "timestamp": "03:14:43", "text": "。 残りは明日置きます。"}, {"type": "subtitle", "time": 11686.389, "timestamp": "03:14:46", "text": "では、まず 124 があります。124、125、6、78、9 とします。"}, {"type": "subtitle", "time": 11697.19, "timestamp": "03:14:57", "text": "今日は 30 です。明日は 1、2、3、4、5、6、7 ワットです"}, {"type": "subtitle", "time": 11699.67, "timestamp": "03:14:59", "text": "。 以上です。 最新の状態に"}]
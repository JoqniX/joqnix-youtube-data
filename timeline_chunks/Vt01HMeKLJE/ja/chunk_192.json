[{"type": "subtitle", "time": 11535.57, "timestamp": "03:12:15", "text": "つまり、"}, {"type": "subtitle", "time": 11537.51, "timestamp": "03:12:17", "text": "[音楽]"}, {"type": "subtitle", "time": 11541.269, "timestamp": "03:12:21", "text": "もし私が望むなら、一"}, {"type": "subtitle", "time": 11545.99, "timestamp": "03:12:25", "text": "晩中起きていて、今日1:31の配信を始めて、"}, {"type": "subtitle", "time": 11550.469, "timestamp": "03:12:30", "text": "仕事を終わらせて、朝寝て"}, {"type": "subtitle", "time": 11555.19, "timestamp": "03:12:35", "text": "、夕方に戻ってくることもできる、ということですよね"}, {"type": "subtitle", "time": 11557.75, "timestamp": "03:12:37", "text": "？ 私にはあまりやることがないように感じる"}, {"type": "subtitle", "time": 11562.469, "timestamp": "03:12:42", "text": "。 私が優先していることはただ一つ、ええと"}, {"type": "subtitle", "time": 11565.75, "timestamp": "03:12:45", "text": "、やらなければならないことがたくさんあるんです。"}, {"type": "subtitle", "time": 11568.55, "timestamp": "03:12:48", "text": "でも、時々"}, {"type": "subtitle", "time": 11571.59, "timestamp": "03:12:51", "text": "ゲーム配信をしたいと思ってるんだ。そうすれば"}, {"type": "subtitle", "time": 11576.389, "timestamp": "03:12:56", "text": "みんながもっと楽しめるようになるしね。だって"}, {"type": "subtitle", "time": 11579.19, "timestamp": "03:12:59", "text": "、ウェブサイトのこともやってるし。 私がやっているのを見るのは"}]
[{"type": "subtitle", "time": 12783.67, "timestamp": "03:33:03", "text": "えっと、蛍光灯。 どの蛍光灯のことですか？ ああ、そうだ"}, {"type": "subtitle", "time": 12786.309, "timestamp": "03:33:06", "text": "、君が"}, {"type": "subtitle", "time": 12788.55, "timestamp": "03:33:08", "text": "発煙筒に火をつけるんだ。 フレア。 はい、フレアです。 そして"}, {"type": "subtitle", "time": 12791.349, "timestamp": "03:33:11", "text": "ヘリコプターがやってきて、ゲームクリアとなる。"}, {"type": "subtitle", "time": 12794.07, "timestamp": "03:33:14", "text": "ええ、実績解除のためにプレイしていたんです。"}, {"type": "subtitle", "time": 12797.349, "timestamp": "03:33:17", "text": "昨日、ゲームをクリアしました。 えっと、一"}, {"type": "subtitle", "time": 12798.79, "timestamp": "03:33:18", "text": "晩中起きてました。 私はウェブサイト"}, {"type": "subtitle", "time": 12800.07, "timestamp": "03:33:20", "text": "関連の作業をしていました。 それで私は「あ、もう"}, {"type": "subtitle", "time": 12802.87, "timestamp": "03:33:22", "text": "翌日だ。"}, {"type": "subtitle", "time": 12805.67, "timestamp": "03:33:25", "text": "夜遅くまで起きて配信するのは嫌だ」と思ったんです。"}, {"type": "subtitle", "time": 12808.469, "timestamp": "03:33:28", "text": "だから私は「よし、"}, {"type": "subtitle", "time": 12813.19, "timestamp": "03:33:33", "text": "7時から12時まで配信しよう」と思ったんです。 だから、7から"}, {"type": "subtitle", "time": 12816.63, "timestamp": "03:33:36", "text": "12までやったと思う。 午前7時から午後12時まで 私たちは"}, {"type": "subtitle", "time": 12818.63, "timestamp": "03:33:38", "text": "ゲームに勝とうとしました。"}, {"type": "subtitle", "time": 12826.71, "timestamp": "03:33:46", "text": "それは確かに何かだった。 そして私は"}, {"type": "subtitle", "time": 12830.07, "timestamp": "03:33:50", "text": "寝て、今はお茶をストリーミング配信している。"}, {"type": "subtitle", "time": 12832.229, "timestamp": "03:33:52", "text": "疲れているように聞こえますね。 本当に"}, {"type": "subtitle", "time": 12835.429, "timestamp": "03:33:55", "text": "大丈夫ですか？ ええ、大丈夫です。 一"}]
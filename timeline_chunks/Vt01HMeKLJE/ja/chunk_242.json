[{"type": "subtitle", "time": 14532.229, "timestamp": "04:02:12", "text": "こんにちは。 それは"}, {"type": "subtitle", "time": 14534.63, "timestamp": "04:02:14", "text": "あなたにとって午前7時ではないですか？ いや、待って。"}, {"type": "subtitle", "time": 14539.99, "timestamp": "04:02:19", "text": "えっと、"}, {"type": "subtitle", "time": 14548.63, "timestamp": "04:02:28", "text": "ええ、文字通りの意味になります。 こんにちは。"}, {"type": "subtitle", "time": 14550.63, "timestamp": "04:02:30", "text": "自分が楽しめるゲームをプレイすれば、"}, {"type": "subtitle", "time": 14553.349, "timestamp": "04:02:33", "text": "驚くほど上達するでしょう。 こんにちは。"}, {"type": "subtitle", "time": 14558.469, "timestamp": "04:02:38", "text": "だから、ああ、それは決して忘れられない。"}, {"type": "subtitle", "time": 14560.95, "timestamp": "04:02:40", "text": "心の中では、「ああ、今日は"}, {"type": "subtitle", "time": 14562.71, "timestamp": "04:02:42", "text": "月曜日だ」と考えている。"}, {"type": "subtitle", "time": 14568.07, "timestamp": "04:02:48", "text": "こんにちは。"}]
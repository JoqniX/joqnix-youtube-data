[{"type": "subtitle", "time": 1302.789, "timestamp": "00:21:42", "text": "なぜキノコが生えないのですか？ 私は"}, {"type": "subtitle", "time": 1306.149, "timestamp": "00:21:46", "text": "このレベルに数分います"}, {"type": "subtitle", "time": 1309.35, "timestamp": "00:21:49", "text": "。"}, {"type": "subtitle", "time": 1315.27, "timestamp": "00:21:55", "text": "昨日の地図と今日の地図は全然"}, {"type": "subtitle", "time": 1317.669, "timestamp": "00:21:57", "text": "違うね。"}]
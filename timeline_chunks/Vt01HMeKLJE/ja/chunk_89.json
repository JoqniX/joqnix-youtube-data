[{"type": "subtitle", "time": 5347.669, "timestamp": "01:29:07", "text": "うん。 ロープをリールに巻き取る。 これで"}, {"type": "subtitle", "time": 5350.95, "timestamp": "01:29:10", "text": "3本目のロープですよね？ 三つ。 あと6人"}, {"type": "subtitle", "time": 5361.91, "timestamp": "01:29:21", "text": "待てよ、宝箱がもう一つあったはずだろ"}, {"type": "subtitle", "time": 5371.91, "timestamp": "01:29:31", "text": "オレンジ色のやつですね。   何てことだ"}, {"type": "subtitle", "time": 5381.51, "timestamp": "01:29:41", "text": "俺はこんなに幸運なのか、それとも…"}, {"type": "subtitle", "time": 5384.39, "timestamp": "01:29:44", "text": "ああ、なんて幸運なんだ、兄弟。 また"}, {"type": "subtitle", "time": 5398.149, "timestamp": "01:29:58", "text": "またしてもハニーマネーだ。   ああ"}]
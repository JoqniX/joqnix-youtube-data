[{"type": "subtitle", "time": 15181.189, "timestamp": "04:13:01", "text": "私の好きなことの一つです。   それを"}, {"type": "subtitle", "time": 15184.95, "timestamp": "04:13:04", "text": "使いたい。   では、"}, {"type": "subtitle", "time": 15188.79, "timestamp": "04:13:08", "text": "どれくらいの量をアップロードすればいいのでしょうか？ 完了しましたか？"}, {"type": "subtitle", "time": 15191.99, "timestamp": "04:13:11", "text": "まだ続いている。 わかった。 こんにちは。"}, {"type": "subtitle", "time": 15195.91, "timestamp": "04:13:15", "text": "私は自分の体をアップロードしてきました。 私を信じて。"}, {"type": "subtitle", "time": 15198.229, "timestamp": "04:13:18", "text": "うん。   えっと、"}, {"type": "subtitle", "time": 15206.95, "timestamp": "04:13:26", "text": "YouTubeでスポーツ選手の自己紹介動画を"}, {"type": "subtitle", "time": 15210.87, "timestamp": "04:13:30", "text": "9月"}, {"type": "subtitle", "time": 15214.309, "timestamp": "04:13:34", "text": "か10月頃にやろうと思ってるんだけど、自分が"}, {"type": "subtitle", "time": 15222.79, "timestamp": "04:13:42", "text": "誰なのか、何をしているのか、"}, {"type": "subtitle", "time": 15226.309, "timestamp": "04:13:46", "text": "好きなものは何なのか、ストリーミングを始めてどれくらい経つのかとか、"}, {"type": "subtitle", "time": 15231.189, "timestamp": "04:13:51", "text": "将来の目標とか、そういうことを全部話したいんだ。"}, {"type": "subtitle", "time": 15234.95, "timestamp": "04:13:54", "text": "日本語で完全に完全なもの。"}, {"type": "subtitle", "time": 15237.269, "timestamp": "04:13:57", "text": "台本とか、"}, {"type": "subtitle", "time": 15239.269, "timestamp": "04:13:59", "text": "いろいろ準備しなきゃいけなかったんです。"}]
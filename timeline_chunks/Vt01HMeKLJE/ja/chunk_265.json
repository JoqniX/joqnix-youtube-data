[{"type": "subtitle", "time": 15916.55, "timestamp": "04:25:16", "text": "残りのことをします。"}, {"type": "subtitle", "time": 15925.04, "timestamp": "04:25:25", "text": "。 黄色ですよね？  7月は黄色です。"}, {"type": "subtitle", "time": 15936.229, "timestamp": "04:25:36", "text": "大丈夫です。 サムネイルは"}, {"type": "subtitle", "time": 15940.95, "timestamp": "04:25:40", "text": "明日作成します。 こんにちは。 じゃあ、"}, {"type": "subtitle", "time": 15944.95, "timestamp": "04:25:44", "text": "今から寝れば大丈夫だといいんだけど。 私は眠れるだろうか？ わかった。"}, {"type": "subtitle", "time": 15948.55, "timestamp": "04:25:48", "text": "寝てみます。"}, {"type": "subtitle", "time": 15952.389, "timestamp": "04:25:52", "text": "10時までには起きて、10時から12時まで配信をしたいと思っています。それから夕食も食べます"}, {"type": "subtitle", "time": 15954.95, "timestamp": "04:25:54", "text": "。 いいえ、昼食です。"}, {"type": "subtitle", "time": 15957.83, "timestamp": "04:25:57", "text": "いつも、"}]
[{"type": "subtitle", "time": 16209.03, "timestamp": "04:30:09", "text": "フィルターは無料です。   何てことだ"}, {"type": "subtitle", "time": 16220.87, "timestamp": "04:30:20", "text": "部屋を共同利用するにはどうすればいいですか？ ああ、なんてことだ、恐ろしい。 私は"}, {"type": "subtitle", "time": 16229.99, "timestamp": "04:30:29", "text": "これは日本語ですか、それとも中国語ですか？"}, {"type": "subtitle", "time": 16232.79, "timestamp": "04:30:32", "text": "それは日本風に見える。 いや、中国人じゃないの"}, {"type": "subtitle", "time": 16235.67, "timestamp": "04:30:35", "text": "？"}, {"type": "subtitle", "time": 16243.51, "timestamp": "04:30:43", "text": "アークナイツ・オブ・ゲンシン。 こんにちは。 そうそう。   たくさんの"}, {"type": "subtitle", "time": 16247.75, "timestamp": "04:30:47", "text": "MMO RPG、例えば"}, {"type": "subtitle", "time": 16251.189, "timestamp": "04:30:51", "text": "原神のようなゲームが登場しています。"}, {"type": "subtitle", "time": 16255.03, "timestamp": "04:30:55", "text": "原神、ずいぶん変わったと思う。"}, {"type": "subtitle", "time": 16257.429, "timestamp": "04:30:57", "text": "しかし、『原神』の問題点は、やらなければならない作業が多すぎることだ"}, {"type": "subtitle", "time": 16259.94, "timestamp": "04:30:59", "text": "。 いや。"}]
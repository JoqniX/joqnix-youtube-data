[{"type": "subtitle", "time": 13686.87, "timestamp": "03:48:06", "text": "こんなことが起こって残念です。でも、今は"}, {"type": "subtitle", "time": 13693.91, "timestamp": "03:48:13", "text": "4月なので、もっと時間があるので、"}, {"type": "subtitle", "time": 13696.63, "timestamp": "03:48:16", "text": "準備する時間が増えました。 だから今回は、"}, {"type": "subtitle", "time": 13705.99, "timestamp": "03:48:25", "text": "万全の準備を整えて臨む方が良いと思っています。"}, {"type": "subtitle", "time": 13710.389, "timestamp": "03:48:30", "text": "だから日本語のスキルを磨いてください。"}, {"type": "subtitle", "time": 13720.79, "timestamp": "03:48:40", "text": "シャムサから聞いた話ですが、飛行機に"}, {"type": "subtitle", "time": 13724.07, "timestamp": "03:48:44", "text": "乗った生徒の一人（誰だったか忘れましたが）が"}, {"type": "subtitle", "time": 13727.11, "timestamp": "03:48:47", "text": "パート"}, {"type": "subtitle", "time": 13728.87, "timestamp": "03:48:48", "text": "タイムの"}, {"type": "subtitle", "time": 13731.349, "timestamp": "03:48:51", "text": "成績が悪く、"}, {"type": "subtitle", "time": 13733.83, "timestamp": "03:48:53", "text": "アカデミーが謝罪の手紙を書いて、"}, {"type": "subtitle", "time": 13737.67, "timestamp": "03:48:57", "text": "上司と面談しなければならなかったそうです"}]
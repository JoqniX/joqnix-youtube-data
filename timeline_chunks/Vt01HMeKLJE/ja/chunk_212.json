[{"type": "subtitle", "time": 12724.63, "timestamp": "03:32:04", "text": "火山みたいなものの入り口まで行ってください。 うん。"}, {"type": "subtitle", "time": 12727.51, "timestamp": "03:32:07", "text": "うん。 そして、最後のpoの部分にたどり着きます"}, {"type": "subtitle", "time": 12730.55, "timestamp": "03:32:10", "text": "。 えっと、地図の最後の部分では、"}, {"type": "subtitle", "time": 12734.309, "timestamp": "03:32:14", "text": "火山の中にいることになります。"}, {"type": "subtitle", "time": 12736.389, "timestamp": "03:32:16", "text": "ええと、あなたは火山の中にいることになります。"}, {"type": "subtitle", "time": 12740.95, "timestamp": "03:32:20", "text": "何とかして頂点に上り詰めなければならない。"}, {"type": "subtitle", "time": 12747.75, "timestamp": "03:32:27", "text": "火山の壁にはマグマの岩石などが付着しているだろう。 気をつけなければならない。"}, {"type": "subtitle", "time": 12750.15, "timestamp": "03:32:30", "text": "それから、一番上まで登ります。 すると、"}, {"type": "subtitle", "time": 12753.19, "timestamp": "03:32:33", "text": "花壇の山のようなものが見える"}, {"type": "subtitle", "time": 12755.349, "timestamp": "03:32:35", "text": "。 それはまるで勝利の周回、"}, {"type": "subtitle", "time": 12758.15, "timestamp": "03:32:38", "text": "勝利の行進のようだ。"}, {"type": "subtitle", "time": 12761.269, "timestamp": "03:32:41", "text": "ゲームの最も難しい部分に到達し、それを終えます。"}, {"type": "subtitle", "time": 12764.71, "timestamp": "03:32:44", "text": "この花壇の中を歩いて、"}, {"type": "subtitle", "time": 12771.19, "timestamp": "03:32:51", "text": "岩か何かの上のショットのようなものに登って、"}, {"type": "subtitle", "time": 12774.79, "timestamp": "03:32:54", "text": "ライトを点けるんです。あれは"}, {"type": "subtitle", "time": 12776.79, "timestamp": "03:32:56", "text": "何て言うんでしたっけ？ それは何と"}, {"type": "subtitle", "time": 12779.59, "timestamp": "03:32:59", "text": "呼ばれますか？ あの煙みたいなやつ。"}]
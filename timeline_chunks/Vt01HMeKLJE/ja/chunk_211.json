[{"type": "subtitle", "time": 12660.07, "timestamp": "03:31:00", "text": "。 うん。 だから、"}, {"type": "subtitle", "time": 12663.269, "timestamp": "03:31:03", "text": "その頂点に立たなければならない。 それから、"}, {"type": "subtitle", "time": 12665.99, "timestamp": "03:31:05", "text": "熱帯地方に行くと、そこは完全に"}, {"type": "subtitle", "time": 12669.269, "timestamp": "03:31:09", "text": "森林で、雨がたくさん降ります。 どこも"}, {"type": "subtitle", "time": 12672.63, "timestamp": "03:31:12", "text": "危険だ。"}, {"type": "subtitle", "time": 12675.99, "timestamp": "03:31:15", "text": "毒キノコとか、"}, {"type": "subtitle", "time": 12679.11, "timestamp": "03:31:19", "text": "毒入りワインとか、そういう毒のあるものってあるよね"}, {"type": "subtitle", "time": 12681.269, "timestamp": "03:31:21", "text": "。 トニーはワインも何でも持っている。"}, {"type": "subtitle", "time": 12683.51, "timestamp": "03:31:23", "text": "それを克服しなければならない。 そして、"}, {"type": "subtitle", "time": 12687.83, "timestamp": "03:31:27", "text": "雪山の場所に着く。"}, {"type": "subtitle", "time": 12690.309, "timestamp": "03:31:30", "text": "名前は忘れたけど、"}, {"type": "subtitle", "time": 12693.349, "timestamp": "03:31:33", "text": "あの山を越えなきゃいけないんだ。風の"}, {"type": "subtitle", "time": 12698.229, "timestamp": "03:31:38", "text": "強い山々を登って、全部やらなきゃいけない"}, {"type": "subtitle", "time": 12701.429, "timestamp": "03:31:41", "text": "。 そしてその後、"}, {"type": "subtitle", "time": 12704.389, "timestamp": "03:31:44", "text": "頂上に着くと、火山"}, {"type": "subtitle", "time": 12706.55, "timestamp": "03:31:46", "text": "地帯にたどり着きます。"}, {"type": "subtitle", "time": 12710.63, "timestamp": "03:31:50", "text": "溶岩地帯を横断しないといけないし、丘陵地帯でも"}, {"type": "subtitle", "time": 12713.269, "timestamp": "03:31:53", "text": "ないけど、黒い岩とか"}, {"type": "subtitle", "time": 12716.389, "timestamp": "03:31:56", "text": "全部。 溶岩石とか、そういうもの全部。"}]
[{"type": "subtitle", "time": 16262.469, "timestamp": "04:31:02", "text": "[音楽]"}, {"type": "subtitle", "time": 16266.469, "timestamp": "04:31:06", "text": "うん。 やるべきことが山ほどある。"}, {"type": "subtitle", "time": 16269.51, "timestamp": "04:31:09", "text": "でも、新しいゲームがあるんです。"}, {"type": "subtitle", "time": 16278.87, "timestamp": "04:31:18", "text": "忘れちゃった。"}, {"type": "subtitle", "time": 16281.349, "timestamp": "04:31:21", "text": "彼らは本当に"}, {"type": "subtitle", "time": 16285.83, "timestamp": "04:31:25", "text": "優秀だ。 名前を忘れてしまった。 待って。"}, {"type": "subtitle", "time": 16287.83, "timestamp": "04:31:27", "text": "ああ、騙されたな"}, {"type": "subtitle", "time": 16291.67, "timestamp": "04:31:31", "text": "。"}, {"type": "subtitle", "time": 16304.55, "timestamp": "04:31:44", "text": "ゲームを試してみてください。"}, {"type": "subtitle", "time": 16307.51, "timestamp": "04:31:47", "text": "試してみるべきだよ。"}, {"type": "subtitle", "time": 16315.91, "timestamp": "04:31:55", "text": "それは何という名前でしたか？ ベータ版に登録した時のことを覚えています"}]
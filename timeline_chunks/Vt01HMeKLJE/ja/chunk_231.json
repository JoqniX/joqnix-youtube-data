[{"type": "subtitle", "time": 13861.91, "timestamp": "03:51:01", "text": "パートタイムの"}, {"type": "subtitle", "time": 13868.79, "timestamp": "03:51:08", "text": "何があるだろうか？  3つ目は、"}, {"type": "subtitle", "time": 13883.11, "timestamp": "03:51:23", "text": "歩くことや"}, {"type": "subtitle", "time": 13887.99, "timestamp": "03:51:27", "text": "サイクリングなど、社会的なことに順応できない人がいるということです。ホームシックになったり、"}, {"type": "subtitle", "time": 13909.03, "timestamp": "03:51:49", "text": "日本から帰ってきた学生はどうなったのでしょうか？"}, {"type": "subtitle", "time": 13914.15, "timestamp": "03:51:54", "text": "インドでは、それはまた別の出費となるだろう。 ええと、"}, {"type": "subtitle", "time": 13919.03, "timestamp": "03:51:59", "text": "日本では状況が全く違いますし、"}]
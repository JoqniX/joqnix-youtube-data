[{"type": "subtitle", "time": 7082.87, "timestamp": "01:58:02", "text": "。 目を覚ましてください。 目を覚ましてください"}, {"type": "subtitle", "time": 7084.47, "timestamp": "01:58:04", "text": "。 マジックマッシュルームまで落としてしまった"}, {"type": "subtitle", "time": 7088.47, "timestamp": "01:58:08", "text": "。 待って、食べ物はそこにあるよ。   さあ"}, {"type": "subtitle", "time": 7111.83, "timestamp": "01:58:31", "text": "お願いします。"}, {"type": "subtitle", "time": 7116.95, "timestamp": "01:58:36", "text": "主よ、聖なる神よ。 なぜ？ なぜ？"}, {"type": "subtitle", "time": 7119.679, "timestamp": "01:58:39", "text": "なぜ？ なぜ？ なぜ私はこんな人生と向き合わなければならないのか？   来て"}]
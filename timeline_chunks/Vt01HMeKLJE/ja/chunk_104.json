[{"type": "subtitle", "time": 6269.27, "timestamp": "01:44:29", "text": "。 つまり、私たちはこの"}, {"type": "subtitle", "time": 6273.59, "timestamp": "01:44:33", "text": "黄色い冬のベリーを求めてここに来たのです。 私たちはそうしなければならない、私たちは"}, {"type": "subtitle", "time": 6275.99, "timestamp": "01:44:35", "text": "それが必要だ。 それでは、ここに置きます"}, {"type": "subtitle", "time": 6279.35, "timestamp": "01:44:39", "text": "。"}, {"type": "subtitle", "time": 6282.39, "timestamp": "01:44:42", "text": "バックパックはこちら。   今すぐ"}, {"type": "subtitle", "time": 6285.59, "timestamp": "01:44:45", "text": "何かが必要なんです。 そこに置くのは気が進まない"}]
[{"type": "subtitle", "time": 13083.51, "timestamp": "03:38:03", "text": "N4レベルまで上達できれば、"}, {"type": "subtitle", "time": 13086.79, "timestamp": "03:38:06", "text": "N4を受験できます。そうすれば、"}, {"type": "subtitle", "time": 13089.67, "timestamp": "03:38:09", "text": "その人はスカイロを持っています。 え、本当に？"}, {"type": "subtitle", "time": 13091.349, "timestamp": "03:38:11", "text": "かっこいい。"}, {"type": "subtitle", "time": 13095.03, "timestamp": "03:38:15", "text": "ニース。 マットは"}, {"type": "subtitle", "time": 13103.67, "timestamp": "03:38:23", "text": "こんにちは、サバットさん。"}, {"type": "subtitle", "time": 13106.15, "timestamp": "03:38:26", "text": "去年はそうしました。 あなたはそうした。 あなたは"}, {"type": "subtitle", "time": 13110.15, "timestamp": "03:38:30", "text": "昨年も書いていましたね。 さあ、行こう。  2つのアクションと、"}, {"type": "subtitle", "time": 13126.229, "timestamp": "03:38:46", "text": "それはいいですね。 今では毎月のように、たくさんの"}, {"type": "subtitle", "time": 13131.99, "timestamp": "03:38:51", "text": "インド人候補者がいます。 おお、いいね。"}, {"type": "subtitle", "time": 13135.19, "timestamp": "03:38:55", "text": "誰もが日本に行きたがる"}, {"type": "subtitle", "time": 13138.95, "timestamp": "03:38:58", "text": "か、日本語を学びたがる。 ニース。"}]
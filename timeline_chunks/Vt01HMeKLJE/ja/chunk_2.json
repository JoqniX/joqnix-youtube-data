[{"type": "subtitle", "time": 123.109, "timestamp": "00:02:03", "text": "正直に言うと、えっと、正直に言うと、ウェブ"}, {"type": "subtitle", "time": 129.749, "timestamp": "00:02:09", "text": "サイト関連のことをしたかったんです。 それから、"}, {"type": "subtitle", "time": 133.27, "timestamp": "00:02:13", "text": "アストラミツキと"}, {"type": "subtitle", "time": 137.11, "timestamp": "00:02:17", "text": "ジャルピがピークゲームをしているのを見ました。 だから私は"}, {"type": "subtitle", "time": 139.03, "timestamp": "00:02:19", "text": "「わかった、わかった。"}, {"type": "subtitle", "time": 143.82999999999998, "timestamp": "00:02:23", "text": "昨日ゲームをクリアしたから実績解除の作業をしよう。"}, {"type": "subtitle", "time": 145.82999999999998, "timestamp": "00:02:25", "text": "昨日ピークに到達したから」と思った。だから私は"}, {"type": "subtitle", "time": 149.67000000000002, "timestamp": "00:02:29", "text": "「わかった、わかった」と思った。 私はただひたすら努力するだけです"}, {"type": "subtitle", "time": 152.55, "timestamp": "00:02:32", "text": "。 あと"}, {"type": "subtitle", "time": 155.82999999999998, "timestamp": "00:02:35", "text": "少しバッジを集めればいいだけだ。 それでおしまい。 それでおしまい"}, {"type": "subtitle", "time": 160.309, "timestamp": "00:02:40", "text": "。 とにかく、最初から最後まで走り切る必要がある。   「"}, {"type": "subtitle", "time": 165.03, "timestamp": "00:02:45", "text": "バッジをいくつか獲得するには、3回フルランする必要がある。」"}, {"type": "subtitle", "time": 167.35, "timestamp": "00:02:47", "text": "それで私は「ああ、わかった」と思った。 わかった、そうするよ"}, {"type": "subtitle", "time": 170.309, "timestamp": "00:02:50", "text": "。"}, {"type": "subtitle", "time": 172.39, "timestamp": "00:02:52", "text": "ええ、"}, {"type": "subtitle", "time": 177.19, "timestamp": "00:02:57", "text": "今日はスピードランを実施します。 今夜。 うん。 だから、黙ってろ。"}, {"type": "subtitle", "time": 179.19, "timestamp": "00:02:59", "text": "えっと、それから"}]
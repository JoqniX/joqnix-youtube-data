[{"type": "subtitle", "time": 15960.389, "timestamp": "04:26:00", "text": "昼食を夕食と呼んだり、夕食を昼食と呼んだり、"}, {"type": "subtitle", "time": 15966.71, "timestamp": "04:26:06", "text": "。"}, {"type": "subtitle", "time": 15970.149, "timestamp": "04:26:10", "text": "こんにちは。 えっと、午前10時。こんにちは。 明日午前10時、"}, {"type": "subtitle", "time": 15974.87, "timestamp": "04:26:14", "text": "日本の銀行。 わかった。"}, {"type": "subtitle", "time": 15976.389, "timestamp": "04:26:16", "text": "こんにちは。"}, {"type": "subtitle", "time": 15980.309, "timestamp": "04:26:20", "text": "そして、私は物事をひっくり返すようなことをやり遂げるつもりだ。"}, {"type": "subtitle", "time": 15983.59, "timestamp": "04:26:23", "text": "毎日"}, {"type": "subtitle", "time": 15986.229, "timestamp": "04:26:26", "text": "少なくとも1つの数字を数える。"}, {"type": "subtitle", "time": 15997.429, "timestamp": "04:26:37", "text": "ニース。 ニース。 わかった。 明日。   だから、"}, {"type": "subtitle", "time": 16002.229, "timestamp": "04:26:42", "text": "おそらく7時か9時前には"}, {"type": "subtitle", "time": 16004.79, "timestamp": "04:26:44", "text": "歌の練習をしなければならない。 わかった。"}, {"type": "subtitle", "time": 16007.189, "timestamp": "04:26:47", "text": "おそらく夕方までに終わらせて、"}, {"type": "subtitle", "time": 16009.59, "timestamp": "04:26:49", "text": "夜は自由に過ごせるようにするつもりです。"}, {"type": "subtitle", "time": 16011.11, "timestamp": "04:26:51", "text": "ええと、これで"}, {"type": "subtitle", "time": 16013.11, "timestamp": "04:26:53", "text": "情報"}, {"type": "subtitle", "time": 16017.83, "timestamp": "04:26:57", "text": "ページは終わりです。 明日、"}]
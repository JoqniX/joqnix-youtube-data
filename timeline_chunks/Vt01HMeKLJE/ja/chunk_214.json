[{"type": "subtitle", "time": 12841.67, "timestamp": "03:34:01", "text": "晩中起きていて、それから寝るべきかどうか考えていた。 あ、待って。 一"}, {"type": "subtitle", "time": 12843.91, "timestamp": "03:34:03", "text": "晩中起きて、明日の新しいストリーム 131"}, {"type": "subtitle", "time": 12847.67, "timestamp": "03:34:07", "text": "日目"}, {"type": "subtitle", "time": 12850.79, "timestamp": "03:34:10", "text": "131 を開始し、寝るか寝ないかわかりませんが、"}, {"type": "subtitle", "time": 12858.79, "timestamp": "03:34:18", "text": "アップロードのために v を付けて、"}, {"type": "subtitle", "time": 12861.51, "timestamp": "03:34:21", "text": "寝て、明日"}, {"type": "subtitle", "time": 12865.75, "timestamp": "03:34:25", "text": "早く起きて開始することにしました。"}, {"type": "subtitle", "time": 12867.83, "timestamp": "03:34:27", "text": "ガイドライン ページとすべての作業が完了したので、ウェブ"}, {"type": "subtitle", "time": 12874.95, "timestamp": "03:34:34", "text": "サイト関連のページに集中するだけです。 ええと、私は"}, {"type": "subtitle", "time": 12878.87, "timestamp": "03:34:38", "text": "大丈夫です。 まあ、大丈夫かな。 それから、まだいくつかやらなければならないことが残っています"}, {"type": "subtitle", "time": 12882.229, "timestamp": "03:34:42", "text": "。   これで"}, {"type": "subtitle", "time": 12884.469, "timestamp": "03:34:44", "text": "私の仕事は完全に終わりです。 終わり。"}, {"type": "subtitle", "time": 12890.15, "timestamp": "03:34:50", "text": "来月に向けてどう準備すればいいかな。 あと、"}, {"type": "subtitle", "time": 12892.87, "timestamp": "03:34:52", "text": "先生、もしまだいらっしゃるなら、"}, {"type": "subtitle", "time": 12897.429, "timestamp": "03:34:57", "text": "授業の進捗状況について何かお知らせはありますか？   ずっと"}]
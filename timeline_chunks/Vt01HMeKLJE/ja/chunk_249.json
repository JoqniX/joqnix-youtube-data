[{"type": "subtitle", "time": 14943.59, "timestamp": "04:09:03", "text": "彼女がそのように歌うという意味です。 彼女は、"}, {"type": "subtitle", "time": 14947.189, "timestamp": "04:09:07", "text": "まふまふが"}, {"type": "subtitle", "time": 14950.71, "timestamp": "04:09:10", "text": "他の誰かと一緒にそれをしている例を挙げてくれた。 両者とも、"}, {"type": "subtitle", "time": 14953.349, "timestamp": "04:09:13", "text": "それぞれのチャンネルでその件を隠蔽していた。 二人はそれぞれ違うパートを"}, {"type": "subtitle", "time": 14955.189, "timestamp": "04:09:15", "text": "歌った"}, {"type": "subtitle", "time": 14957.03, "timestamp": "04:09:17", "text": "。"}, {"type": "subtitle", "time": 14959.11, "timestamp": "04:09:19", "text": "日本の声の中には、いくつか掲載したものもあった。 そうそう"}, {"type": "subtitle", "time": 14960.95, "timestamp": "04:09:20", "text": "。 うん。 うん。 それについて調べてみる必要があります"}, {"type": "subtitle", "time": 14967.67, "timestamp": "04:09:27", "text": "そう、"}, {"type": "subtitle", "time": 14975.51, "timestamp": "04:09:35", "text": "良い曲だ。"}, {"type": "subtitle", "time": 14977.67, "timestamp": "04:09:37", "text": "本当に良い曲だ。 そして、"}, {"type": "subtitle", "time": 14980.309, "timestamp": "04:09:40", "text": "英語の歌を歌ってみました。 私は英語の歌を一人で歌うことはめったにありません"}, {"type": "subtitle", "time": 14982.95, "timestamp": "04:09:42", "text": "。 だから私は「ああ、これは"}, {"type": "subtitle", "time": 14986.95, "timestamp": "04:09:46", "text": "いいな」と思ったんです。 笑顔の夜。 青春バニーガール"}, {"type": "subtitle", "time": 14988.469, "timestamp": "04:09:48", "text": "赤崎が"}, {"type": "subtitle", "time": 14990.95, "timestamp": "04:09:50", "text": "話題の曲。"}, {"type": "subtitle", "time": 14995.11, "timestamp": "04:09:55", "text": "うん。 クリスマスソングのバックナンバー。"}]
[{"type": "subtitle", "time": 243.03, "timestamp": "00:04:03", "text": "溶岩地帯や"}, {"type": "subtitle", "time": 244.63, "timestamp": "00:04:04", "text": "殺戮、"}, {"type": "subtitle", "time": 246.55, "timestamp": "00:04:06", "text": "最後の場所など、最も困難な部分にたどり着くことができるのです"}, {"type": "subtitle", "time": 248.39, "timestamp": "00:04:08", "text": "。"}, {"type": "subtitle", "time": 250.22899999999998, "timestamp": "00:04:10", "text": "かなりのスキルが必要です。"}, {"type": "subtitle", "time": 253.27, "timestamp": "00:04:13", "text": "ゲームの物理法則、ジャンプの仕方やタイミング、やってはいけないこと"}, {"type": "subtitle", "time": 255.50900000000001, "timestamp": "00:04:15", "text": "、何をすべきか、何をすべきでないかなどを理解する必要があります。"}, {"type": "subtitle", "time": 260.229, "timestamp": "00:04:20", "text": "ですから、時間がかかります。"}, {"type": "subtitle", "time": 268.23, "timestamp": "00:04:28", "text": "こんにちは。 ええと、準備はできたと思います。"}]
[{"type": "subtitle", "time": 8825.03, "timestamp": "02:27:05", "text": "そうですね、そういう意味では、もう"}, {"type": "subtitle", "time": 8828.87, "timestamp": "02:27:08", "text": "ビッグスリーを登る必要はないんです。 それを"}, {"type": "subtitle", "time": 8830.87, "timestamp": "02:27:10", "text": "終えました。 リアルな目玉"}, {"type": "subtitle", "time": 8833.429, "timestamp": "02:27:13", "text": "パーツを手に入れました。   一番"}, {"type": "subtitle", "time": 8836.389, "timestamp": "02:27:16", "text": "難しい問題を終わらせてみます"}, {"type": "subtitle", "time": 8838.389, "timestamp": "02:27:18", "text": "。   ああ"}, {"type": "subtitle", "time": 8842.309, "timestamp": "02:27:22", "text": "、妖精さん。 妖精を手に入れた。   ああ"}, {"type": "subtitle", "time": 8844.79, "timestamp": "02:27:24", "text": "、なんて幸運なんだろう。"}, {"type": "subtitle", "time": 8850.309, "timestamp": "02:27:30", "text": "ああ、神様。 いいね、いいね、いいね、いいね、いいね、"}]
[{"type": "subtitle", "time": 15664.469, "timestamp": "04:21:04", "text": "。 えっと、どちらが"}, {"type": "subtitle", "time": 15669.11, "timestamp": "04:21:09", "text": "優れていると思いますか？ わかった。  A1 A2 A. こんにちは。 そうします、"}, {"type": "subtitle", "time": 15671.75, "timestamp": "04:21:11", "text": "これを使います。"}, {"type": "subtitle", "time": 15674.229, "timestamp": "04:21:14", "text": "これだったのか？ いいえ、別の"}, {"type": "subtitle", "time": 15676.63, "timestamp": "04:21:16", "text": "サイトがあって、それを勉強などに"}, {"type": "subtitle", "time": 15680.309, "timestamp": "04:21:20", "text": "使っていたんですが、"}, {"type": "subtitle", "time": 15684.71, "timestamp": "04:21:24", "text": "Twitterの人たちがそれを見て、"}, {"type": "subtitle", "time": 15686.63, "timestamp": "04:21:26", "text": "私たちがそれを学習などに使っていると書いたので、"}, {"type": "subtitle", "time": 15689.91, "timestamp": "04:21:29", "text": "彼らが来たんです。 それで"}, {"type": "subtitle", "time": 15693.51, "timestamp": "04:21:33", "text": "彼らは私のツイートに返信して、「私たちの"}, {"type": "subtitle", "time": 15698.389, "timestamp": "04:21:38", "text": "学習教材などを使ってくれてありがとう」と言ってくれました。 だから私は「"}, {"type": "subtitle", "time": 15701.189, "timestamp": "04:21:41", "text": "これらを作ってくれてありがとう」と言いました。 授業で見せてくれた"}, {"type": "subtitle", "time": 15708.79, "timestamp": "04:21:48", "text": "絵本みたいな、ひらがなが"}, {"type": "subtitle", "time": 15712.95, "timestamp": "04:21:52", "text": "全部載ってるやつ覚えてる？ えーっと、あれらみたいなものって何ですか"}, {"type": "subtitle", "time": 15718.79, "timestamp": "04:21:58", "text": "。"}]
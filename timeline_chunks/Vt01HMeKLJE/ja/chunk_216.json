[{"type": "subtitle", "time": 12965.429, "timestamp": "03:36:05", "text": "ええ、そうなんです、"}, {"type": "subtitle", "time": 12968.79, "timestamp": "03:36:08", "text": "TISのスタッフに授業がいつ行われるのか尋ねたんです。 彼らは"}, {"type": "subtitle", "time": 12971.429, "timestamp": "03:36:11", "text": "私に知らせると言っていました。   それ"}, {"type": "subtitle", "time": 12973.51, "timestamp": "03:36:13", "text": "以来、彼らは私に何も知らせてくれません。"}, {"type": "subtitle", "time": 12976.15, "timestamp": "03:36:16", "text": "何が起こっているのか分かりません。"}, {"type": "subtitle", "time": 12981.349, "timestamp": "03:36:21", "text": "あなたにメッセージを送ろうと思ったのですが、忘れてしまいました。"}, {"type": "subtitle", "time": 12983.03, "timestamp": "03:36:23", "text": "でも、授業が始まる前に、"}, {"type": "subtitle", "time": 12988.469, "timestamp": "03:36:28", "text": "全部復習しておきたいんです。 ひらがなと"}, {"type": "subtitle", "time": 12991.59, "timestamp": "03:36:31", "text": "カタカナのこと、"}, {"type": "subtitle", "time": 12994.389, "timestamp": "03:36:34", "text": "文法、全部配信でやろうと思う。 そして、私も"}, {"type": "subtitle", "time": 13000.63, "timestamp": "03:36:40", "text": "現在開講中のクラスは来月末に予定されています"}, {"type": "subtitle", "time": 13002.71, "timestamp": "03:36:42", "text": "。"}, {"type": "subtitle", "time": 13006.55, "timestamp": "03:36:46", "text": "あ、待って。"}, {"type": "subtitle", "time": 13009.269, "timestamp": "03:36:49", "text": "別のクラスの授業が行われていた。"}, {"type": "subtitle", "time": 13012.469, "timestamp": "03:36:52", "text": "来月の試験を目指しています。 ああ、わかりました。   わかった"}, {"type": "subtitle", "time": 13014.15, "timestamp": "03:36:54", "text": "。"}, {"type": "subtitle", "time": 13017.19, "timestamp": "03:36:57", "text": "待って、来月が試験なの？"}]
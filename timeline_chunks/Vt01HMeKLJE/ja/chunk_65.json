[{"type": "subtitle", "time": 3906.789, "timestamp": "01:05:06", "text": "後悔するようなことをしてしまうかもしれない。   わかった"}, {"type": "subtitle", "time": 3921.43, "timestamp": "01:05:21", "text": "待てよ、スプールは使えるぞ。 そうするべきでしょうか"}, {"type": "subtitle", "time": 3924.23, "timestamp": "01:05:24", "text": "？ わかった。"}, {"type": "subtitle", "time": 3931.51, "timestamp": "01:05:31", "text": "もし望めば、私はその反写本を持っている。 私は"}, {"type": "subtitle", "time": 3933.589, "timestamp": "01:05:33", "text": "ここでこれを無駄にすることもできた。"}, {"type": "subtitle", "time": 3949.589, "timestamp": "01:05:49", "text": "ジャンプしても、"}, {"type": "subtitle", "time": 3956.87, "timestamp": "01:05:56", "text": "本当に"}, {"type": "subtitle", "time": 3958.71, "timestamp": "01:05:58", "text": "ここで無駄にしなければならないのだろうか？   まあ"}]
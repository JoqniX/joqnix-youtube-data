[{"type": "subtitle", "time": 12900.55, "timestamp": "03:35:00", "text": "我一直在等。 我认为应该"}, {"type": "subtitle", "time": 12903.269, "timestamp": "03:35:03", "text": "从八月份开始。 我好像"}, {"type": "subtitle", "time": 12907.269, "timestamp": "03:35:07", "text": "什么都没听到。 我确实问了，"}, {"type": "subtitle", "time": 12911.19, "timestamp": "03:35:11", "text": "但是哦，又插播广告了。"}, {"type": "subtitle", "time": 12914.55, "timestamp": "03:35:14", "text": "等等，我问过了，但他们说会"}, {"type": "subtitle", "time": 12924.63, "timestamp": "03:35:24", "text": "所以，我得在"}, {"type": "subtitle", "time": 12926.469, "timestamp": "03:35:26", "text": "新班级里练习hongo。 是的。 是的。 是的。"}, {"type": "subtitle", "time": 12933.269, "timestamp": "03:35:33", "text": "所以，"}, {"type": "subtitle", "time": 12935.91, "timestamp": "03:35:35", "text": "我不知道这节课是什么时候。 他们说"}, {"type": "subtitle", "time": 12938.87, "timestamp": "03:35:38", "text": "会在开课前通知我"}, {"type": "subtitle", "time": 12941.67, "timestamp": "03:35:41", "text": "。 我想复习一下，"}, {"type": "subtitle", "time": 12944.79, "timestamp": "03:35:44", "text": "确保自己跟上进度。 我已经很久没练习了"}, {"type": "subtitle", "time": 12947.11, "timestamp": "03:35:47", "text": "。   是的"}, {"type": "subtitle", "time": 12951.19, "timestamp": "03:35:51", "text": "。 我不想，我不想被"}, {"type": "subtitle", "time": 12953.91, "timestamp": "03:35:53", "text": "落下。"}, {"type": "subtitle", "time": 12957.349, "timestamp": "03:35:57", "text": "从律师那里回来了。 您好，欢迎回来。"}]
[{"type": "subtitle", "time": 2828.39, "timestamp": "00:47:08", "text": "好了，我们赶紧结束这件事吧。 这样"}, {"type": "subtitle", "time": 2847.03, "timestamp": "00:47:27", "text": "去旅行吧。 哦，我正在做一件绝对"}, {"type": "subtitle", "time": 2851.19, "timestamp": "00:47:31", "text": "不能吃的飞机餐。"}, {"type": "subtitle", "time": 2853.589, "timestamp": "00:47:33", "text": "我必须完成这个挑战"}, {"type": "subtitle", "time": 2855.75, "timestamp": "00:47:35", "text": "。"}, {"type": "subtitle", "time": 2859.03, "timestamp": "00:47:39", "text": "呃，它在哪儿？ 是的，我正在努力在"}, {"type": "subtitle", "time": 2862.71, "timestamp": "00:47:42", "text": "这次"}, {"type": "subtitle", "time": 2866.55, "timestamp": "00:47:46", "text": "跑步中拿到这三个。 我单人通关了"}, {"type": "subtitle", "time": 2869.99, "timestamp": "00:47:49", "text": "一次。 我的背包里装着一些椰子"}, {"type": "subtitle", "time": 2872.47, "timestamp": "00:47:52", "text": "。   是的"}, {"type": "subtitle", "time": 2875.67, "timestamp": "00:47:55", "text": "。 所以我倾向于“是”"}, {"type": "subtitle", "time": 2877.51, "timestamp": "00:47:57", "text": "。 它的包装。 是的。 是的。 所以我"}]
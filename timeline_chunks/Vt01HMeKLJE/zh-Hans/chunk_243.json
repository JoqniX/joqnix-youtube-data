[{"type": "subtitle", "time": 14590.229, "timestamp": "04:03:10", "text": "日本游戏。 我想做视觉"}, {"type": "subtitle", "time": 14592.71, "timestamp": "04:03:12", "text": "小说之类的东西。 我三个小时"}, {"type": "subtitle", "time": 14595.349, "timestamp": "04:03:15", "text": "前就醒了。 啊，"}, {"type": "subtitle", "time": 14610.469, "timestamp": "04:03:30", "text": "啊，你现在想合作吗？"}, {"type": "subtitle", "time": 14612.87, "timestamp": "04:03:32", "text": "我不知道。 我"}, {"type": "subtitle", "time": 14615.99, "timestamp": "04:03:35", "text": "想我得去睡觉了。 没关系。 下次我们一定能做到"}, {"type": "subtitle", "time": 14619.03, "timestamp": "04:03:39", "text": "。 不用担心。"}, {"type": "subtitle", "time": 14623.269, "timestamp": "04:03:43", "text": "然后安排一个合适的日期。 然后他们"}, {"type": "subtitle", "time": 14625.91, "timestamp": "04:03:45", "text": "安排了一天的时间，就像……哦，"}, {"type": "subtitle", "time": 14629.75, "timestamp": "04:03:49", "text": "Persona 3 重制版。 哦，蒸汽。"}]
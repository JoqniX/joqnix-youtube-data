[{"type": "subtitle", "time": 13323.03, "timestamp": "03:42:03", "text": "请问您"}, {"type": "subtitle", "time": 13327.67, "timestamp": "03:42:07", "text": "最近有没有上课，知道"}, {"type": "subtitle", "time": 13330.63, "timestamp": "03:42:10", "text": "具体的上课时间安排吗？ 哦，大概是早上6点半"}, {"type": "subtitle", "time": 13334.79, "timestamp": "03:42:14", "text": "到8点左右。 啊，"}, {"type": "subtitle", "time": 13337.51, "timestamp": "03:42:17", "text": "那真不错。"}, {"type": "subtitle", "time": 13352.79, "timestamp": "03:42:32", "text": "我想要早上吃的那份。"}, {"type": "subtitle", "time": 13356.55, "timestamp": "03:42:36", "text": "你会感觉神清气爽，就像……是啊，"}, {"type": "subtitle", "time": 13358.71, "timestamp": "03:42:38", "text": "一大早你的脑子里就充满了日语"}, {"type": "subtitle", "time": 13360.87, "timestamp": "03:42:40", "text": "。"}, {"type": "subtitle", "time": 13362.95, "timestamp": "03:42:42", "text": "现在好多了。 你不会受到"}, {"type": "subtitle", "time": 13365.67, "timestamp": "03:42:45", "text": "太多干扰。"}, {"type": "subtitle", "time": 13368.469, "timestamp": "03:42:48", "text": "晚上你可能会，我可能会感到疲倦"}, {"type": "subtitle", "time": 13371.269, "timestamp": "03:42:51", "text": "或其他什么感觉。 然后我就会犯困什么的"}, {"type": "subtitle", "time": 13373.91, "timestamp": "03:42:53", "text": "。 那很糟糕。   是的"}, {"type": "subtitle", "time": 13377.03, "timestamp": "03:42:57", "text": "，早上更好。   好的"}]
[{"type": "subtitle", "time": 4627.59, "timestamp": "01:17:07", "text": "险。 我差点就死在那儿了"}, {"type": "subtitle", "time": 4634.87, "timestamp": "01:17:14", "text": "啊，罗布吃饱了。 我的天啊。 等等，"}, {"type": "subtitle", "time": 4638.39, "timestamp": "01:17:18", "text": "它到底抢劫了多少次来着？ 我们弄到了一把类似"}, {"type": "subtitle", "time": 4642.149, "timestamp": "01:17:22", "text": "抢劫枪的东西。 抢劫枪。"}, {"type": "subtitle", "time": 4652.95, "timestamp": "01:17:32", "text": "结束之前还有更多路要走。"}, {"type": "subtitle", "time": 4656.55, "timestamp": "01:17:36", "text": "我们其实需要更多的绳子"}]
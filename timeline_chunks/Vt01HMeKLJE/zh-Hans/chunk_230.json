[{"type": "subtitle", "time": 13801.91, "timestamp": "03:50:01", "text": "晚上有吗？ 不。嗯，是线下课程，"}, {"type": "subtitle", "time": 13807.99, "timestamp": "03:50:07", "text": "线下授课。 我想知道有哪些人"}, {"type": "subtitle", "time": 13811.11, "timestamp": "03:50:11", "text": "自愿来教书。"}, {"type": "subtitle", "time": 13813.349, "timestamp": "03:50:13", "text": "我不知道这个问题。 等等，他们"}, {"type": "subtitle", "time": 13815.67, "timestamp": "03:50:15", "text": "没告诉你吗？   是的"}, {"type": "subtitle", "time": 13818.55, "timestamp": "03:50:18", "text": "。"}, {"type": "subtitle", "time": 13823.349, "timestamp": "03:50:23", "text": "6月10日那天我去的时候，他们说，嗯，我想是的，"}, {"type": "subtitle", "time": 13828.07, "timestamp": "03:50:28", "text": "我们大概是早上9点或10点去的。所以，"}, {"type": "subtitle", "time": 13830.95, "timestamp": "03:50:30", "text": "那个"}, {"type": "subtitle", "time": 13835.59, "timestamp": "03:50:35", "text": "学生的会议，他们必须在下午12点到"}, {"type": "subtitle", "time": 13840.79, "timestamp": "03:50:40", "text": "1点之间进行。 或中午 12 点 某物。"}, {"type": "subtitle", "time": 13842.95, "timestamp": "03:50:42", "text": "嗯，是的，他们当时忙着那件事"}, {"type": "subtitle", "time": 13845.429, "timestamp": "03:50:45", "text": "。 在那之前我们聊过，他们"}, {"type": "subtitle", "time": 13847.83, "timestamp": "03:50:47", "text": "说，有一位学生"}, {"type": "subtitle", "time": 13850.15, "timestamp": "03:50:50", "text": "想家了，想回家，"}, {"type": "subtitle", "time": 13855.59, "timestamp": "03:50:55", "text": "他们需要和"}, {"type": "subtitle", "time": 13858.229, "timestamp": "03:50:58", "text": "校长谈谈，解决这个问题；"}]
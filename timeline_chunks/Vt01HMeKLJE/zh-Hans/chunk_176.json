[{"type": "subtitle", "time": 10560.95, "timestamp": "02:56:00", "text": "它损坏"}, {"type": "subtitle", "time": 10571.03, "timestamp": "02:56:11", "text": "虽然你想看看新来的猫，但我还是想说。 呃，"}, {"type": "subtitle", "time": 10574.23, "timestamp": "02:56:14", "text": "就像一只老猫，但"}, {"type": "subtitle", "time": 10577.67, "timestamp": "02:56:17", "text": "它生了孩子。"}, {"type": "subtitle", "time": 10583.429, "timestamp": "02:56:23", "text": "呃，让我打开手机。 但是，"}, {"type": "subtitle", "time": 10589.75, "timestamp": "02:56:29", "text": "呃，他，呃，她在我的床底下生下了孩子，"}, {"type": "subtitle", "time": 10597.51, "timestamp": "02:56:37", "text": "我的床底下。"}, {"type": "subtitle", "time": 10616.79, "timestamp": "02:56:56", "text": "看看"}, {"type": "subtitle", "time": 10618.63, "timestamp": "02:56:58", "text": "[笑声]"}]
[{"type": "subtitle", "time": 7082.87, "timestamp": "01:58:02", "text": "请醒醒。 请醒醒。 请"}, {"type": "subtitle", "time": 7084.47, "timestamp": "01:58:04", "text": "醒醒。 我甚至把迷幻蘑菇都弄丢了"}, {"type": "subtitle", "time": 7088.47, "timestamp": "01:58:08", "text": "。 等等，食物在那里。"}, {"type": "subtitle", "time": 7111.83, "timestamp": "01:58:31", "text": "请。"}, {"type": "subtitle", "time": 7116.95, "timestamp": "01:58:36", "text": "主啊，圣洁的上帝。 为什么？ 为什么？"}, {"type": "subtitle", "time": 7119.679, "timestamp": "01:58:39", "text": "为什么？ 为什么？ 我为什么要承受这样的生活？"}]
[{"type": "subtitle", "time": 13621.91, "timestamp": "03:47:01", "text": "如果需要的话，你可以转学。"}, {"type": "subtitle", "time": 13624.389, "timestamp": "03:47:04", "text": "我当时就想，好吧。 我只是想知道，既然"}, {"type": "subtitle", "time": 13631.75, "timestamp": "03:47:11", "text": "我已经通过了五年考试，我以后不会再换考生了。 所以，嗯，"}, {"type": "subtitle", "time": 13635.03, "timestamp": "03:47:15", "text": "那也会为我提供其他"}, {"type": "subtitle", "time": 13639.269, "timestamp": "03:47:19", "text": "上学的机会。 所以我就想，"}, {"type": "subtitle", "time": 13645.349, "timestamp": "03:47:25", "text": "拿到第一张签证才是最难的部分。   是的"}, {"type": "subtitle", "time": 13653.429, "timestamp": "03:47:33", "text": "[音乐]"}, {"type": "subtitle", "time": 13655.429, "timestamp": "03:47:35", "text": "一旦到了日本，一切都容易多了。"}, {"type": "subtitle", "time": 13657.75, "timestamp": "03:47:37", "text": "嗨，"}, {"type": "subtitle", "time": 13660.389, "timestamp": "03:47:40", "text": "嗯。"}, {"type": "subtitle", "time": 13665.03, "timestamp": "03:47:45", "text": "我仍然感觉很糟糕，我希望，我希望"}, {"type": "subtitle", "time": 13670.15, "timestamp": "03:47:50", "text": "他们能让我们，我希望在"}, {"type": "subtitle", "time": 13673.349, "timestamp": "03:47:53", "text": "这个时候我应该在日本"}, {"type": "subtitle", "time": 13676.229, "timestamp": "03:47:56", "text": "上课、做兼职"}, {"type": "subtitle", "time": 13678.79, "timestamp": "03:47:58", "text": "什么的，"}]
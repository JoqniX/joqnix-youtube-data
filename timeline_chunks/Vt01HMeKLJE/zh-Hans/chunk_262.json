[{"type": "subtitle", "time": 15722.79, "timestamp": "04:22:02", "text": "对，就是那本图画书。"}, {"type": "subtitle", "time": 15727.189, "timestamp": "04:22:07", "text": "好的，我就先把它下载下来吧。"}, {"type": "subtitle", "time": 15729.91, "timestamp": "04:22:09", "text": "好的，我们今天就做这件事。 不是明天。"}, {"type": "subtitle", "time": 15731.59, "timestamp": "04:22:11", "text": "今天。"}, {"type": "subtitle", "time": 15741.99, "timestamp": "04:22:21", "text": "你好。 我明天就做。 我会下载"}, {"type": "subtitle", "time": 15749.75, "timestamp": "04:22:29", "text": "没有把握。 我不记得了。 对，我"}, {"type": "subtitle", "time": 15752.309, "timestamp": "04:22:32", "text": "忘了名字。 就是那些单字母的“Yeah”"}, {"type": "subtitle", "time": 15754.229, "timestamp": "04:22:34", "text": "。 对，就像儿童"}, {"type": "subtitle", "time": 15756.309, "timestamp": "04:22:36", "text": "绘本一样。"}, {"type": "subtitle", "time": 15766.95, "timestamp": "04:22:46", "text": "我的目标是至少在四月之前，"}, {"type": "subtitle", "time": 15769.59, "timestamp": "04:22:49", "text": "比如三月之前，在我离开之前，我"}, {"type": "subtitle", "time": 15773.67, "timestamp": "04:22:53", "text": "想完全"}, {"type": "subtitle", "time": 15775.67, "timestamp": "04:22:55", "text": "达到能够阅读日语"}, {"type": "subtitle", "time": 15778.71, "timestamp": "04:22:58", "text": "轻小说之类的水平"}]
[{"type": "subtitle", "time": 5462.629, "timestamp": "01:31:02", "text": "我的天啊。 我的天啊。 我的天啊。 我的"}, {"type": "subtitle", "time": 5464.87, "timestamp": "01:31:04", "text": "天啊。"}, {"type": "subtitle", "time": 5469.11, "timestamp": "01:31:09", "text": "我的天啊。 不。他们拿走了那东西。"}, {"type": "subtitle", "time": 5476.87, "timestamp": "01:31:16", "text": "我的天啊。 他们把东西拿走了。"}, {"type": "subtitle", "time": 5481.35, "timestamp": "01:31:21", "text": "我发誓。 在哪里？ 蜂巢在哪里？"}, {"type": "subtitle", "time": 5484.229, "timestamp": "01:31:24", "text": "你拿了吗？"}, {"type": "subtitle", "time": 5490.07, "timestamp": "01:31:30", "text": "不，他们把蜂巢拿走了，兄弟。 不，"}, {"type": "subtitle", "time": 5492.629, "timestamp": "01:31:32", "text": "他们拿走了蜂巢。"}, {"type": "subtitle", "time": 5501.11, "timestamp": "01:31:41", "text": "哦，我再也不会为了这种事冒生命危险了"}, {"type": "subtitle", "time": 5503.59, "timestamp": "01:31:43", "text": "。 我的天啊，"}, {"type": "subtitle", "time": 5513.83, "timestamp": "01:31:53", "text": "我中毒了一半。"}, {"type": "subtitle", "time": 5515.83, "timestamp": "01:31:55", "text": "等等，他们是怎么把"}]
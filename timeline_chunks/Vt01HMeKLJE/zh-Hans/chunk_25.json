[{"type": "subtitle", "time": 1514.71, "timestamp": "00:25:14", "text": "我觉得我出生点运气不好。 我一个"}, {"type": "subtitle", "time": 1517.35, "timestamp": "00:25:17", "text": "蘑菇都没看到。 不，秒。"}, {"type": "subtitle", "time": 1519.909, "timestamp": "00:25:19", "text": "我还没看到第二个刷新点。 那是"}, {"type": "subtitle", "time": 1522.71, "timestamp": "00:25:22", "text": "药用草本植物，还有"}, {"type": "subtitle", "time": 1534.789, "timestamp": "00:25:34", "text": "我们可以用这个东西吃饭。   就"}, {"type": "subtitle", "time": 1537.43, "timestamp": "00:25:37", "text": "放在那儿。"}, {"type": "subtitle", "time": 1546.789, "timestamp": "00:25:46", "text": "我这次是在挑战活塞挑战吗"}, {"type": "subtitle", "time": 1549.99, "timestamp": "00:25:49", "text": "？ 不，我只是觉得这次我只打算吃"}, {"type": "subtitle", "time": 1555.11, "timestamp": "00:25:55", "text": "蘑菇。 这里"}, {"type": "subtitle", "time": 1557.83, "timestamp": "00:25:57", "text": "将涵盖这部分内容。"}, {"type": "subtitle", "time": 1559.909, "timestamp": "00:25:59", "text": "你知道吗？ 我将提出活塞"}]
[{"type": "subtitle", "time": 7870.149, "timestamp": "02:11:10", "text": "那只是一件行李。"}, {"type": "subtitle", "time": 7887.51, "timestamp": "02:11:27", "text": "就像我拿到蛋之后，我可以把"}, {"type": "subtitle", "time": 7889.99, "timestamp": "02:11:29", "text": "它留下来。 就像我可以把它拿"}, {"type": "subtitle", "time": 7892.79, "timestamp": "02:11:32", "text": "在手里一样。 它会自动"}, {"type": "subtitle", "time": 7899.35, "timestamp": "02:11:39", "text": "所以没问题。"}, {"type": "subtitle", "time": 7902.55, "timestamp": "02:11:42", "text": "我开始觉得饿了。   就是这样。"}, {"type": "subtitle", "time": 7904.709, "timestamp": "02:11:44", "text": "我"}, {"type": "subtitle", "time": 7917.99, "timestamp": "02:11:57", "text": "包装食品采购。"}]
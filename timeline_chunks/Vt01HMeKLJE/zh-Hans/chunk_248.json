[{"type": "subtitle", "time": 14881.75, "timestamp": "04:08:01", "text": "名字是 Das。 所以她唱蓝色部分，"}, {"type": "subtitle", "time": 14885.349, "timestamp": "04:08:05", "text": "我唱紫色部分。"}, {"type": "subtitle", "time": 14887.51, "timestamp": "04:08:07", "text": "呃，她一直教我写"}, {"type": "subtitle", "time": 14890.469, "timestamp": "04:08:10", "text": "第一节，第一行。 是的，第一段"}, {"type": "subtitle", "time": 14893.189, "timestamp": "04:08:13", "text": "。 是的，这周的行程应该是"}, {"type": "subtitle", "time": 14896.309, "timestamp": "04:08:16", "text": "从这里到那里。 那么第三周"}, {"type": "subtitle", "time": 14899.03, "timestamp": "04:08:19", "text": "就是最后一周了。 我已经会唱"}, {"type": "subtitle", "time": 14902.309, "timestamp": "04:08:22", "text": "这首歌了，但是我的发音有些"}, {"type": "subtitle", "time": 14913.189, "timestamp": "04:08:33", "text": "这一点我总是忽略，我总是犯这个"}, {"type": "subtitle", "time": 14915.83, "timestamp": "04:08:35", "text": "大错误。 有时"}, {"type": "subtitle", "time": 14919.75, "timestamp": "04:08:39", "text": "我说唱的时候，他却保持沉默。   是的"}, {"type": "subtitle", "time": 14923.99, "timestamp": "04:08:43", "text": "。 所以我们计划是，就像在她的"}, {"type": "subtitle", "time": 14926.229, "timestamp": "04:08:46", "text": "频道上，就像她正在做"}, {"type": "subtitle", "time": 14928.389, "timestamp": "04:08:48", "text": "这件事一样。 她会唱那首蓝色的歌"}, {"type": "subtitle", "time": 14930.87, "timestamp": "04:08:50", "text": "。 第二部分我会那样唱"}, {"type": "subtitle", "time": 14934.07, "timestamp": "04:08:54", "text": "。 然后我的频道会"}, {"type": "subtitle", "time": 14937.189, "timestamp": "04:08:57", "text": "翻转过来，或者这里的蓝色区域会代表我，我"}, {"type": "subtitle", "time": 14939.91, "timestamp": "04:08:59", "text": "会唱这首歌。 这里的紫色部分，"}]
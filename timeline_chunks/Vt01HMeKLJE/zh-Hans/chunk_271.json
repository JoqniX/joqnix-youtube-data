[{"type": "subtitle", "time": 16262.469, "timestamp": "04:31:02", "text": "[音乐] 是"}, {"type": "subtitle", "time": 16266.469, "timestamp": "04:31:06", "text": "啊。 要做的事情太多了。"}, {"type": "subtitle", "time": 16269.51, "timestamp": "04:31:09", "text": "不过，现在有一款新游戏。 我忘了它"}, {"type": "subtitle", "time": 16278.87, "timestamp": "04:31:18", "text": "呃，我忘了它叫什么了。"}, {"type": "subtitle", "time": 16281.349, "timestamp": "04:31:21", "text": "他们真的"}, {"type": "subtitle", "time": 16285.83, "timestamp": "04:31:25", "text": "很好。 忘了名字了。 等待。"}, {"type": "subtitle", "time": 16287.83, "timestamp": "04:31:27", "text": "呃，这是"}, {"type": "subtitle", "time": 16291.67, "timestamp": "04:31:31", "text": "陷阱游戏。"}, {"type": "subtitle", "time": 16300.95, "timestamp": "04:31:40", "text": "哦，是的。 试试这款名为“乌玛”的"}, {"type": "subtitle", "time": 16304.55, "timestamp": "04:31:44", "text": "马匹游戏。"}, {"type": "subtitle", "time": 16307.51, "timestamp": "04:31:47", "text": "你应该试试。"}, {"type": "subtitle", "time": 16315.91, "timestamp": "04:31:55", "text": "它叫什么名字？ 我记得我注册过测试"}]
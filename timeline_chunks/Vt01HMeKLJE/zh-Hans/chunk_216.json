[{"type": "subtitle", "time": 12965.429, "timestamp": "03:36:05", "text": "，我刚才说的是，我的确问过"}, {"type": "subtitle", "time": 12968.79, "timestamp": "03:36:08", "text": "TIS的工作人员课程时间。 他们"}, {"type": "subtitle", "time": 12971.429, "timestamp": "03:36:11", "text": "说会通知我。   从那以后，"}, {"type": "subtitle", "time": 12973.51, "timestamp": "03:36:13", "text": "他们就再也没通知过我。 我"}, {"type": "subtitle", "time": 12976.15, "timestamp": "03:36:16", "text": "不知道发生了什么事。 我本来想给"}, {"type": "subtitle", "time": 12981.349, "timestamp": "03:36:21", "text": "你发消息，后来就忘了。   是的"}, {"type": "subtitle", "time": 12983.03, "timestamp": "03:36:23", "text": "，在开课之前，我想把所有东西都"}, {"type": "subtitle", "time": 12985.269, "timestamp": "03:36:25", "text": "复习一遍"}, {"type": "subtitle", "time": 12988.469, "timestamp": "03:36:28", "text": "。 我想我会在直播中讲解"}, {"type": "subtitle", "time": 12991.59, "timestamp": "03:36:31", "text": "所有关于平假名、片假名"}, {"type": "subtitle", "time": 12994.389, "timestamp": "03:36:34", "text": "、语法等等的内容。 这样我就不会"}, {"type": "subtitle", "time": 13000.63, "timestamp": "03:36:40", "text": "本期课程安排在"}, {"type": "subtitle", "time": 13002.71, "timestamp": "03:36:42", "text": "下个月底。"}, {"type": "subtitle", "time": 13006.55, "timestamp": "03:36:46", "text": "哦，等等。 当时有"}, {"type": "subtitle", "time": 13009.269, "timestamp": "03:36:49", "text": "不同批次的课程正在进行。"}, {"type": "subtitle", "time": 13012.469, "timestamp": "03:36:52", "text": "目标是参加下个月的考试。 哦好的。"}, {"type": "subtitle", "time": 13014.16, "timestamp": "03:36:54", "text": "好的。 等等，下个月是考试，"}, {"type": "subtitle", "time": 13017.2, "timestamp": "03:36:57", "text": "等等，下个月是考试， 这个月不是JPT考试吗？ 有人"}]
[{"type": "subtitle", "time": 16745.83, "timestamp": "04:39:05", "text": "传统佐治亚州。"}, {"type": "subtitle", "time": 16748.551, "timestamp": "04:39:08", "text": "我很想念演奏宾·R的时光。已经"}, {"type": "subtitle", "time": 16751.189, "timestamp": "04:39:11", "text": "很久了。"}, {"type": "subtitle", "time": 16754.39, "timestamp": "04:39:14", "text": "我当时想，“哦，新角色。我要"}, {"type": "subtitle", "time": 16761.99, "timestamp": "04:39:21", "text": "练级，练级，练级。” 到那时我就会"}, {"type": "subtitle", "time": 16764.629, "timestamp": "04:39:24", "text": "后悔为什么花了那么多"}, {"type": "subtitle", "time": 16766.551, "timestamp": "04:39:26", "text": "时间。"}, {"type": "subtitle", "time": 16768.709, "timestamp": "04:39:28", "text": "我本来可以做其他事情的。 我本来可以"}, {"type": "subtitle", "time": 16772.23, "timestamp": "04:39:32", "text": "做很多事。 我只想"}, {"type": "subtitle", "time": 16775.59, "timestamp": "04:39:35", "text": "看故事。 是的。 哦，是的。"}, {"type": "subtitle", "time": 16777.83, "timestamp": "04:39:37", "text": "这些抽卡游戏或者《原神》的故事简直太"}, {"type": "subtitle", "time": 16780.708, "timestamp": "04:39:40", "text": "疯狂了。 不，"}, {"type": "subtitle", "time": 16783.91, "timestamp": "04:39:43", "text": "哇，这太酷了。 这些故事怎么会是这样的"}, {"type": "subtitle", "time": 16786.15, "timestamp": "04:39:46", "text": "？ 哦，我的"}, {"type": "subtitle", "time": 16791.67, "timestamp": "04:39:51", "text": "水壶掉地上了。 谢天谢地，水没洒出来。"}, {"type": "subtitle", "time": 16794.15, "timestamp": "04:39:54", "text": "是的，我也玩原神和"}, {"type": "subtitle", "time": 16795.91, "timestamp": "04:39:55", "text": "抽卡游戏，因为它们的故事情节很棒。"}, {"type": "subtitle", "time": 16798.55, "timestamp": "04:39:58", "text": "说实话，"}]
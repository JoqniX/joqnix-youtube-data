[{"type": "subtitle", "time": 14102.63, "timestamp": "03:55:02", "text": "第一天感觉如何？"}, {"type": "subtitle", "time": 14105.99, "timestamp": "03:55:05", "text": "第一天。"}, {"type": "subtitle", "time": 14113.75, "timestamp": "03:55:13", "text": "你第一次来日本的时候"}, {"type": "subtitle", "time": 14117.83, "timestamp": "03:55:17", "text": "，只有你一个人吗？ 感觉好像这一切都是"}, {"type": "subtitle", "time": 14141.67, "timestamp": "03:55:41", "text": "啊。 所以，我不应该感到"}, {"type": "subtitle", "time": 14144.469, "timestamp": "03:55:44", "text": "压力或沮丧。 我会这样想"}, {"type": "subtitle", "time": 14146.229, "timestamp": "03:55:46", "text": "。   是的"}, {"type": "subtitle", "time": 14148.389, "timestamp": "03:55:48", "text": "。 如果我的意思是既然我能做到，那么"}, {"type": "subtitle", "time": 14151.349, "timestamp": "03:55:51", "text": "我也能做到。"}, {"type": "subtitle", "time": 14153.11, "timestamp": "03:55:53", "text": "从头到尾都是我"}, {"type": "subtitle", "time": 14157.269, "timestamp": "03:55:57", "text": "自己安装的。 两人共用一块电池，没有网络。"}]
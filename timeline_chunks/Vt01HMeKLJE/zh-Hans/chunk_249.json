[{"type": "subtitle", "time": 14943.59, "timestamp": "04:09:03", "text": "她会那样唱。 她"}, {"type": "subtitle", "time": 14947.189, "timestamp": "04:09:07", "text": "给我举了个例子，说 Mafu Mafu 和"}, {"type": "subtitle", "time": 14950.71, "timestamp": "04:09:10", "text": "其他人一起做过这件事。 他们俩都"}, {"type": "subtitle", "time": 14953.349, "timestamp": "04:09:13", "text": "在各自的频道上发布了掩盖真相的内容。"}, {"type": "subtitle", "time": 14955.189, "timestamp": "04:09:15", "text": "他们俩分别唱了不同的声部"}, {"type": "subtitle", "time": 14957.03, "timestamp": "04:09:17", "text": "。"}, {"type": "subtitle", "time": 14959.11, "timestamp": "04:09:19", "text": "一些日本配音演员发布了一些作品。 哦，是的"}, {"type": "subtitle", "time": 14960.95, "timestamp": "04:09:20", "text": "。 是的。 是的。 我需要调查一下"}, {"type": "subtitle", "time": 14967.67, "timestamp": "04:09:27", "text": "所以，是的"}, {"type": "subtitle", "time": 14971.99, "timestamp": "04:09:31", "text": "，Yuri干花。 这首歌真"}, {"type": "subtitle", "time": 14975.51, "timestamp": "04:09:35", "text": "好听。   这"}, {"type": "subtitle", "time": 14977.67, "timestamp": "04:09:37", "text": "首歌真好听。 我试着唱了一首"}, {"type": "subtitle", "time": 14980.309, "timestamp": "04:09:40", "text": "英文歌。 我很少独自唱英文歌"}, {"type": "subtitle", "time": 14982.95, "timestamp": "04:09:42", "text": "。 我当时就想，“哦，这"}, {"type": "subtitle", "time": 14986.95, "timestamp": "04:09:46", "text": "不错。” 夜晚带着微笑。 兔女郎"}, {"type": "subtitle", "time": 14988.469, "timestamp": "04:09:48", "text": "赤崎是"}, {"type": "subtitle", "time": 14990.95, "timestamp": "04:09:50", "text": "热门歌曲。   是的"}, {"type": "subtitle", "time": 14995.11, "timestamp": "04:09:55", "text": "。 圣诞歌曲背景音乐。"}]
[{"type": "subtitle", "time": 15303.11, "timestamp": "04:15:03", "text": "哦，真是太尴尬了。 不，我想我"}, {"type": "subtitle", "time": 15305.75, "timestamp": "04:15:05", "text": "做到了。 他们说我表现不错，但我"}, {"type": "subtitle", "time": 15307.83, "timestamp": "04:15:07", "text": "感觉自己表现得并不好。 我需要"}, {"type": "subtitle", "time": 15310.55, "timestamp": "04:15:10", "text": "改进。 所以，在再次与日本主播合作之前"}, {"type": "subtitle", "time": 15313.189, "timestamp": "04:15:13", "text": "，我想重新学习一下"}, {"type": "subtitle", "time": 15325.51, "timestamp": "04:15:25", "text": "，等网站的事情再次解决之后，我们会慢慢地做这件事"}, {"type": "subtitle", "time": 15329.269, "timestamp": "04:15:29", "text": "。 我对自己"}, {"type": "subtitle", "time": 15332.79, "timestamp": "04:15:32", "text": "以前发的信息感到尴尬不已。"}, {"type": "subtitle", "time": 15335.349, "timestamp": "04:15:35", "text": "我也是。"}, {"type": "subtitle", "time": 15338.63, "timestamp": "04:15:38", "text": "甚至所有流媒体也"}, {"type": "subtitle", "time": 15341.11, "timestamp": "04:15:41", "text": "像 YouTube 一样。 呃，我已经停止"}, {"type": "subtitle", "time": 15344.149, "timestamp": "04:15:44", "text": "在 YouTube 上做接力颁奖活动了。 所以，"}, {"type": "subtitle", "time": 15346.63, "timestamp": "04:15:46", "text": "只有当我积极参与直播时，"}, {"type": "subtitle", "time": 15349.11, "timestamp": "04:15:49", "text": "我才会从这个月开始在 YouTube 上进行直播，而不是"}, {"type": "subtitle", "time": 15355.67, "timestamp": "04:15:55", "text": "像 Twitch、Kick 和其他平台那样。"}, {"type": "subtitle", "time": 15358.389, "timestamp": "04:15:58", "text": "我一直都像V继电器一样保持着。 所以所有"}]
[{"type": "subtitle", "time": 13920.71, "timestamp": "03:52:00", "text": "老实说，如果得不到日本方面的支持，后果"}, {"type": "subtitle", "time": 13923.83, "timestamp": "03:52:03", "text": "将不堪设想。 是的，"}, {"type": "subtitle", "time": 13926.309, "timestamp": "03:52:06", "text": "自从他们"}, {"type": "subtitle", "time": 13928.71, "timestamp": "03:52:08", "text": "分享了这些东西之后，我至少感到很高兴。 这样"}, {"type": "subtitle", "time": 13930.55, "timestamp": "03:52:10", "text": "我就明白了，学院"}, {"type": "subtitle", "time": 13934.79, "timestamp": "03:52:14", "text": "实际上会给你支持，"}, {"type": "subtitle", "time": 13938.15, "timestamp": "03:52:18", "text": "会照顾你，"}, {"type": "subtitle", "time": 13941.75, "timestamp": "03:52:21", "text": "无论发生什么，他们都必须……嗯，他们必须……"}, {"type": "subtitle", "time": 13945.67, "timestamp": "03:52:25", "text": "嗯，是的，会在"}, {"type": "subtitle", "time": 13949.03, "timestamp": "03:52:29", "text": "那里等等。现在我有点"}, {"type": "subtitle", "time": 13951.189, "timestamp": "03:52:31", "text": "词穷了，他们"}, {"type": "subtitle", "time": 13954.389, "timestamp": "03:52:34", "text": "现在要对你负责。所以，我很高兴"}, {"type": "subtitle", "time": 13956.71, "timestamp": "03:52:36", "text": "他们这样做，而不是仅仅"}, {"type": "subtitle", "time": 13959.03, "timestamp": "03:52:39", "text": "把你送到日本的学校，然后就没了"}, {"type": "subtitle", "time": 13963.51, "timestamp": "03:52:43", "text": "下文。 哦，凡事皆有度。"}]
[{"type": "subtitle", "time": 12660.07, "timestamp": "03:31:00", "text": "。 是的。 所以你必须爬到"}, {"type": "subtitle", "time": 12663.269, "timestamp": "03:31:03", "text": "顶峰。 然后，呃，然后你"}, {"type": "subtitle", "time": 12665.99, "timestamp": "03:31:05", "text": "就到了热带地区，那里全是"}, {"type": "subtitle", "time": 12669.269, "timestamp": "03:31:09", "text": "森林，而且雨水很多。 处处都很"}, {"type": "subtitle", "time": 12672.63, "timestamp": "03:31:12", "text": "危险。 呃，这里有一些有毒的"}, {"type": "subtitle", "time": 12675.99, "timestamp": "03:31:15", "text": "东西，比如毒蘑菇、"}, {"type": "subtitle", "time": 12679.11, "timestamp": "03:31:19", "text": "毒酒"}, {"type": "subtitle", "time": 12681.269, "timestamp": "03:31:21", "text": "等等。 托尼的酒和其他东西。"}, {"type": "subtitle", "time": 12683.51, "timestamp": "03:31:23", "text": "你必须重视这个问题。 然后你就"}, {"type": "subtitle", "time": 12687.83, "timestamp": "03:31:27", "text": "到达了白雪皑皑的山区。 我"}, {"type": "subtitle", "time": 12690.309, "timestamp": "03:31:30", "text": "忘了它的名字，但你必须"}, {"type": "subtitle", "time": 12693.349, "timestamp": "03:31:33", "text": "翻过那座山，"}, {"type": "subtitle", "time": 12698.229, "timestamp": "03:31:38", "text": "穿过那些风很大的山，"}, {"type": "subtitle", "time": 12701.429, "timestamp": "03:31:41", "text": "等等。 之后，"}, {"type": "subtitle", "time": 12704.389, "timestamp": "03:31:44", "text": "登上山顶，就到了火山"}, {"type": "subtitle", "time": 12706.55, "timestamp": "03:31:46", "text": "区。"}, {"type": "subtitle", "time": 12710.63, "timestamp": "03:31:50", "text": "你必须穿越熔岩，还有丘陵地带，"}, {"type": "subtitle", "time": 12713.269, "timestamp": "03:31:53", "text": "呃，不是丘陵地带，还有黑色的岩石"}, {"type": "subtitle", "time": 12716.389, "timestamp": "03:31:56", "text": "等等。 熔岩石等等。"}]
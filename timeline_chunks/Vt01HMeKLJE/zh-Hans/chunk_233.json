[{"type": "subtitle", "time": 13981.91, "timestamp": "03:53:01", "text": "[音乐]"}, {"type": "subtitle", "time": 13983.75, "timestamp": "03:53:03", "text": "他们不可能帮你解决所有问题。   是的"}, {"type": "subtitle", "time": 13987.429, "timestamp": "03:53:07", "text": "，没错。"}, {"type": "subtitle", "time": 13991.65, "timestamp": "03:53:11", "text": "现在他们需要照顾的学生人数会非常多。"}, {"type": "subtitle", "time": 13999.83, "timestamp": "03:53:19", "text": "哦，是的，情况"}, {"type": "subtitle", "time": 14008.309, "timestamp": "03:53:28", "text": "是的，希望他们的课程一切"}, {"type": "subtitle", "time": 14013.11, "timestamp": "03:53:33", "text": "顺利。 我一直"}, {"type": "subtitle", "time": 14015.83, "timestamp": "03:53:35", "text": "没能和"}, {"type": "subtitle", "time": 14017.59, "timestamp": "03:53:37", "text": "巴杜沙萨交谈。"}, {"type": "subtitle", "time": 14020.95, "timestamp": "03:53:40", "text": "好久不见了。"}, {"type": "subtitle", "time": 14023.99, "timestamp": "03:53:43", "text": "上次我跟他们谈的时候，他们说，"}, {"type": "subtitle", "time": 14025.91, "timestamp": "03:53:45", "text": "嗯，关于声音问题"}, {"type": "subtitle", "time": 14028.15, "timestamp": "03:53:48", "text": "等等，你不能在"}, {"type": "subtitle", "time": 14030.87, "timestamp": "03:53:50", "text": "穹顶内接听电话。"}, {"type": "subtitle", "time": 14035.349, "timestamp": "03:53:55", "text": "比如说噪音投诉之类的"}, {"type": "subtitle", "time": 14037.269, "timestamp": "03:53:57", "text": "。   是的"}]
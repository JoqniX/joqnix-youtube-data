[{"type": "subtitle", "time": 5761.91, "timestamp": "01:36:01", "text": "单调，不是单调的，而是"}, {"type": "subtitle", "time": 5763.669, "timestamp": "01:36:03", "text": "单调的。"}, {"type": "subtitle", "time": 5766.47, "timestamp": "01:36:06", "text": "但是，最终，"}, {"type": "subtitle", "time": 5769.59, "timestamp": "01:36:09", "text": "一旦我了解了自己的声音，"}, {"type": "subtitle", "time": 5773.51, "timestamp": "01:36:13", "text": "能够学会"}, {"type": "subtitle", "time": 5776.47, "timestamp": "01:36:16", "text": "如何控制它，"}, {"type": "subtitle", "time": 5780.149, "timestamp": "01:36:20", "text": "到那时，我就会足够好了，尤其是"}, {"type": "subtitle", "time": 5782.709, "timestamp": "01:36:22", "text": "呼吸方面。   就这些了"}, {"type": "subtitle", "time": 5784.79, "timestamp": "01:36:24", "text": "。 谢谢大家的"}, {"type": "subtitle", "time": 5792.87, "timestamp": "01:36:32", "text": "不敢相信，"}, {"type": "subtitle", "time": 5796.55, "timestamp": "01:36:36", "text": "我一直想为大家做一套kok套装"}, {"type": "subtitle", "time": 5799.43, "timestamp": "01:36:39", "text": "。 是的，我当时没有"}, {"type": "subtitle", "time": 5802.39, "timestamp": "01:36:42", "text": "在屏幕上显示歌词，但我"}, {"type": "subtitle", "time": 5805.109, "timestamp": "01:36:45", "text": "这里有歌词。 但是，总有一天，当我"}, {"type": "subtitle", "time": 5809.59, "timestamp": "01:36:49", "text": "自己演奏科吉斯时，我不会"}, {"type": "subtitle", "time": 5812.55, "timestamp": "01:36:52", "text": "过多地使用引导人声和歌词"}, {"type": "subtitle", "time": 5813.51, "timestamp": "01:36:53", "text": "。"}, {"type": "subtitle", "time": 5816.39, "timestamp": "01:36:56", "text": "就像那首美丽的 6 月"}, {"type": "subtitle", "time": 5819.189, "timestamp": "01:36:59", "text": "8 日的歌一样，我们"}]
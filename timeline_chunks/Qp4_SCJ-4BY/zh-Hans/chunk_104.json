[{"type": "subtitle", "time": 6240.95, "timestamp": "01:44:00", "text": "多少人会祝福"}, {"type": "subtitle", "time": 6244.629, "timestamp": "01:44:04", "text": "我，因为我一直对"}, {"type": "subtitle", "time": 6247.35, "timestamp": "01:44:07", "text": "所有人保密。 我当时"}, {"type": "subtitle", "time": 6251.43, "timestamp": "01:44:11", "text": "想，这只是个普通的工作日"}, {"type": "subtitle", "time": 6259.51, "timestamp": "01:44:19", "text": "我觉得我不需要奶油"}, {"type": "subtitle", "time": 6262.07, "timestamp": "01:44:22", "text": "蛋糕。 我只需要一个纸杯蛋糕"}, {"type": "subtitle", "time": 6264.47, "timestamp": "01:44:24", "text": "或者一个普通的李子蛋糕"}, {"type": "subtitle", "time": 6266.709, "timestamp": "01:44:26", "text": "就够了，我的家人有时候会给我买"}, {"type": "subtitle", "time": 6270.31, "timestamp": "01:44:30", "text": "奶油蛋糕。 是的。 或者就像"}, {"type": "subtitle", "time": 6272.47, "timestamp": "01:44:32", "text": "我当时说“是啊”。 我不该"}, {"type": "subtitle", "time": 6274.47, "timestamp": "01:44:34", "text": "这么说。"}, {"type": "subtitle", "time": 6278.07, "timestamp": "01:44:38", "text": "对不起，是的。 太多事情了。 但是"}, {"type": "subtitle", "time": 6280.629, "timestamp": "01:44:40", "text": "，嗯，"}, {"type": "subtitle", "time": 6282.39, "timestamp": "01:44:42", "text": "所以"}]
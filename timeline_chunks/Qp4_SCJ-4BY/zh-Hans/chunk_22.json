[{"type": "subtitle", "time": 1324.71, "timestamp": "00:22:04", "text": "我是明星。 你忘了？ 我是明星。"}, {"type": "subtitle", "time": 1327.27, "timestamp": "00:22:07", "text": "不，我是一颗星座。 我由"}, {"type": "subtitle", "time": 1330.95, "timestamp": "00:22:10", "text": "星星组成。 是的。 但我的成名日将会是……"}, {"type": "subtitle", "time": 1333.43, "timestamp": "00:22:13", "text": "明天才是正式的"}, {"type": "subtitle", "time": 1335.27, "timestamp": "00:22:15", "text": "庆祝活动。 但我们还有大约70"}, {"type": "subtitle", "time": 1340.07, "timestamp": "00:22:20", "text": "分钟。 你好。 嗯，呃，不过是的，我大概还会再待"}, {"type": "subtitle", "time": 1344.23, "timestamp": "00:22:24", "text": "一年。"}, {"type": "subtitle", "time": 1348.149, "timestamp": "00:22:28", "text": "我想，我的星星们又将带我走完一年了。 我不知道。"}, {"type": "subtitle", "time": 1350.63, "timestamp": "00:22:30", "text": "但是，是的，我意识到我已经够大了"}, {"type": "subtitle", "time": 1352.47, "timestamp": "00:22:32", "text": "。"}, {"type": "subtitle", "time": 1355.43, "timestamp": "00:22:35", "text": "我年纪越来越大了。"}, {"type": "subtitle", "time": 1361.51, "timestamp": "00:22:41", "text": "好的。 你好。"}, {"type": "subtitle", "time": 1365.11, "timestamp": "00:22:45", "text": "所以，呃，我不知道我该不该……呃，我"}, {"type": "subtitle", "time": 1369.029, "timestamp": "00:22:49", "text": "不知道我还能唱什么歌"}, {"type": "subtitle", "time": 1371.19, "timestamp": "00:22:51", "text": "？"}, {"type": "subtitle", "time": 1374.71, "timestamp": "00:22:54", "text": "呃，就像唱这首歌一样。   我已经很久没"}]
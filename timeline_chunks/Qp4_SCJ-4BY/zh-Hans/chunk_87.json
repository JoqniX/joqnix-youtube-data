[{"type": "subtitle", "time": 5221.11, "timestamp": "01:27:01", "text": "派对结束了，我们在地球上的时光也"}, {"type": "subtitle", "time": 5223.189, "timestamp": "01:27:03", "text": "结束了。"}, {"type": "subtitle", "time": 5225.189, "timestamp": "01:27:05", "text": "哦，"}, {"type": "subtitle", "time": 5229.91, "timestamp": "01:27:09", "text": "我只想抱你一会儿。"}, {"type": "subtitle", "time": 5231.99, "timestamp": "01:27:11", "text": "我面带"}, {"type": "subtitle", "time": 5234.709, "timestamp": "01:27:14", "text": "微笑地望着"}, {"type": "subtitle", "time": 5238.55, "timestamp": "01:27:18", "text": "墙，一切就此结束。 我想待在"}, {"type": "subtitle", "time": 5241.99, "timestamp": "01:27:21", "text": "你身边。 哦，等等。 音乐还"}, {"type": "subtitle", "time": 5245.75, "timestamp": "01:27:25", "text": "不错。 我还在唱歌。"}, {"type": "subtitle", "time": 5250.229, "timestamp": "01:27:30", "text": "哦，我想待在你身边。 我需要"}, {"type": "subtitle", "time": 5253.91, "timestamp": "01:27:33", "text": "学习这个，找到合适的"}, {"type": "subtitle", "time": 5256.629, "timestamp": "01:27:36", "text": "乐器演奏。 我收到的那款"}, {"type": "subtitle", "time": 5260.31, "timestamp": "01:27:40", "text": "底座太高了，"}, {"type": "subtitle", "time": 5263.51, "timestamp": "01:27:43", "text": "长度也不对。"}, {"type": "subtitle", "time": 5265.59, "timestamp": "01:27:45", "text": "没关系。"}, {"type": "subtitle", "time": 5268.149, "timestamp": "01:27:48", "text": "谢谢大家的生日祝福。"}, {"type": "subtitle", "time": 5269.75, "timestamp": "01:27:49", "text": "谢谢。"}, {"type": "subtitle", "time": 5272.31, "timestamp": "01:27:52", "text": "那歌声真是难听死了，对吧？ 英文"}, {"type": "subtitle", "time": 5275.75, "timestamp": "01:27:55", "text": "歌曲。 我不擅长这个。"}]
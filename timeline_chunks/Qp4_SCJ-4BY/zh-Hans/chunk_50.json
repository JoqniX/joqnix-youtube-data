[{"type": "subtitle", "time": 3001.51, "timestamp": "00:50:01", "text": "我不知道该说什么。   虽然"}, {"type": "subtitle", "time": 3003.829, "timestamp": "00:50:03", "text": "感觉不像是我的生日，但今天确实"}, {"type": "subtitle", "time": 3008.069, "timestamp": "00:50:08", "text": "是我的生日。 哦，天哪，我快要说到"}, {"type": "subtitle", "time": 3014.71, "timestamp": "00:50:14", "text": "你的“是”了。 再见。 这让我感到快乐。 嗯，"}, {"type": "subtitle", "time": 3018.23, "timestamp": "00:50:18", "text": "这真的让我很开心。 嗯，虽然"}, {"type": "subtitle", "time": 3021.589, "timestamp": "00:50:21", "text": "我现在还没到要哭的地步"}, {"type": "subtitle", "time": 3026.069, "timestamp": "00:50:26", "text": "，但是你们在这里真的让我很开心"}, {"type": "subtitle", "time": 3029.19, "timestamp": "00:50:29", "text": "。 你们都记得，"}, {"type": "subtitle", "time": 3033.03, "timestamp": "00:50:33", "text": "而且，虽然我"}, {"type": "subtitle", "time": 3036.71, "timestamp": "00:50:36", "text": "没告诉过一些人今天是我的生日，但"}, {"type": "subtitle", "time": 3040.069, "timestamp": "00:50:40", "text": "以前认识的人都记得今天是我的"}, {"type": "subtitle", "time": 3043.03, "timestamp": "00:50:43", "text": "生日。 太感谢了。 这真的对我意义"}, {"type": "subtitle", "time": 3047.43, "timestamp": "00:50:47", "text": "重大，"}, {"type": "subtitle", "time": 3051.109, "timestamp": "00:50:51", "text": "所以……嗯，"}, {"type": "subtitle", "time": 3055.829, "timestamp": "00:50:55", "text": "我不知道该怎么说，但是真的非常感谢你。"}, {"type": "subtitle", "time": 3057.43, "timestamp": "00:50:57", "text": "嗨，嗯……"}]
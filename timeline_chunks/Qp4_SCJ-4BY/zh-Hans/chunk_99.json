[{"type": "subtitle", "time": 5940.47, "timestamp": "01:39:00", "text": "。 呃，我以后总可以把它弄得漂亮些，"}, {"type": "subtitle", "time": 5945.669, "timestamp": "01:39:05", "text": "我现在只是把它做出来了而已。 所以以后我"}, {"type": "subtitle", "time": 5947.59, "timestamp": "01:39:07", "text": "总可以把它弄得漂亮些。 是的"}, {"type": "subtitle", "time": 5951.99, "timestamp": "01:39:11", "text": "。 所以我的音乐之旅从这"}, {"type": "subtitle", "time": 5957.109, "timestamp": "01:39:17", "text": "周开始，而且这周是我的生日，"}, {"type": "subtitle", "time": 5962.149, "timestamp": "01:39:22", "text": "我想借此机会说一下，嗯，"}, {"type": "subtitle", "time": 5966.31, "timestamp": "01:39:26", "text": "该怎么说呢，我"}, {"type": "subtitle", "time": 5969.43, "timestamp": "01:39:29", "text": "去年生日的时候给自己许了个承诺，就是等"}, {"type": "subtitle", "time": 5972.07, "timestamp": "01:39:32", "text": "我条件允许的时候，"}, {"type": "subtitle", "time": 5974.95, "timestamp": "01:39:34", "text": "我一定要重拾"}, {"type": "subtitle", "time": 5977.669, "timestamp": "01:39:37", "text": "音乐，重新开始做音乐，这"}, {"type": "subtitle", "time": 5980.39, "timestamp": "01:39:40", "text": "在我的新年愿望里也有体现。"}, {"type": "subtitle", "time": 5983.03, "timestamp": "01:39:43", "text": "所以，我的音乐学习之旅"}, {"type": "subtitle", "time": 5986.31, "timestamp": "01:39:46", "text": "从今年开始，一直持续到我去"}, {"type": "subtitle", "time": 5989.27, "timestamp": "01:39:49", "text": "日本为止。 所以大概会持续到三月份。 我们"}, {"type": "subtitle", "time": 5991.75, "timestamp": "01:39:51", "text": "有时间。 希望我能发布"}, {"type": "subtitle", "time": 5994.47, "timestamp": "01:39:54", "text": "一些足够好的作品"}, {"type": "subtitle", "time": 5997.669, "timestamp": "01:39:57", "text": "。 它不会让你们耳朵流血什么的"}]
[{"type": "subtitle", "time": 4566.31, "timestamp": "01:16:06", "text": "我会唱《兔女郎》。 我不知道"}, {"type": "subtitle", "time": 4568.95, "timestamp": "01:16:08", "text": "我是否应该这样做。 我不知道。"}, {"type": "subtitle", "time": 4571.03, "timestamp": "01:16:11", "text": "呃，"}, {"type": "subtitle", "time": 4573.669, "timestamp": "01:16:13", "text": "我好久没唱歌了，但我会"}, {"type": "subtitle", "time": 4576.31, "timestamp": "01:16:16", "text": "试着唱这首歌。"}, {"type": "subtitle", "time": 4593.27, "timestamp": "01:16:33", "text": "我很高兴自己只唱"}, {"type": "subtitle", "time": 4595.43, "timestamp": "01:16:35", "text": "日语歌。 因为那是"}, {"type": "subtitle", "time": 4605.189, "timestamp": "01:16:45", "text": "但将来，我希望我能学习一些"}, {"type": "subtitle", "time": 4608.39, "timestamp": "01:16:48", "text": "更新的技能。 是的。 你好。 嗯，我们把"}, {"type": "subtitle", "time": 4611.99, "timestamp": "01:16:51", "text": "它作为倒数第二首歌吧。 我……"}, {"type": "subtitle", "time": 4615.669, "timestamp": "01:16:55", "text": "我再唱一首歌吧。 我会把它做成"}]
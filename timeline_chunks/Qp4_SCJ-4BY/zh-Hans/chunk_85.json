[{"type": "subtitle", "time": 5101.99, "timestamp": "01:25:01", "text": "[音乐]"}, {"type": "subtitle", "time": 5105.03, "timestamp": "01:25:05", "text": "我输了。"}, {"type": "subtitle", "time": 5109.35, "timestamp": "01:25:09", "text": "迷失在我们呐喊的世界里，"}, {"type": "subtitle", "time": 5111.59, "timestamp": "01:25:11", "text": "我不想再这样下去了，"}, {"type": "subtitle", "time": 5117.43, "timestamp": "01:25:17", "text": "因为你不知道你对我有多重要，"}, {"type": "subtitle", "time": 5121.03, "timestamp": "01:25:21", "text": "我失去了唯一值得我为之奋斗的人"}, {"type": "subtitle", "time": 5123.35, "timestamp": "01:25:23", "text": "。"}, {"type": "subtitle", "time": 5125.669, "timestamp": "01:25:25", "text": "无论你去哪里，我都会"}, {"type": "subtitle", "time": 5127.99, "timestamp": "01:25:27", "text": "跟随你。"}, {"type": "subtitle", "time": 5132.47, "timestamp": "01:25:32", "text": "谁也无法保证明天会发生什么。"}, {"type": "subtitle", "time": 5134.55, "timestamp": "01:25:34", "text": "所以，我会像昨晚一样，每晚都爱你"}, {"type": "subtitle", "time": 5138.709, "timestamp": "01:25:38", "text": "。 我想应该是最后一次吧。"}, {"type": "subtitle", "time": 5142.709, "timestamp": "01:25:42", "text": "如果世界末日来临，我希望在"}, {"type": "subtitle", "time": 5151.43, "timestamp": "01:25:51", "text": "如果派对结束了，我们在"}]
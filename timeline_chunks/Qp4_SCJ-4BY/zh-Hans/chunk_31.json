[{"type": "subtitle", "time": 1861.19, "timestamp": "00:31:01", "text": "还没完全意识到，"}, {"type": "subtitle", "time": 1867.59, "timestamp": "00:31:07", "text": "但是2025年的这个生日，"}, {"type": "subtitle", "time": 1869.83, "timestamp": "00:31:09", "text": "实际上，"}, {"type": "subtitle", "time": 1872.71, "timestamp": "00:31:12", "text": "我不知道该怎么形容，感觉既"}, {"type": "subtitle", "time": 1875.35, "timestamp": "00:31:15", "text": "开心又难过，"}, {"type": "subtitle", "time": 1878.31, "timestamp": "00:31:18", "text": "因为，"}, {"type": "subtitle", "time": 1881.43, "timestamp": "00:31:21", "text": "嗯，这将是我最后一次"}, {"type": "subtitle", "time": 1885.43, "timestamp": "00:31:25", "text": "和家人一起庆祝生日了，嗯，还有"}, {"type": "subtitle", "time": 1892.31, "timestamp": "00:31:32", "text": "家里的所有人，嗯，"}, {"type": "subtitle", "time": 1897.029, "timestamp": "00:31:37", "text": "因为明年我就要去日本了，我会一个人过生日，真的会非常非常"}, {"type": "subtitle", "time": 1901.269, "timestamp": "00:31:41", "text": "孤单，"}, {"type": "subtitle", "time": 1908.63, "timestamp": "00:31:48", "text": "也许会自己庆祝吧，我"}, {"type": "subtitle", "time": 1911.909, "timestamp": "00:31:51", "text": "不知道。但是，因为我的现实"}, {"type": "subtitle", "time": 1914.389, "timestamp": "00:31:54", "text": "生日和我的虚拟主播生日是"}, {"type": "subtitle", "time": 1917.509, "timestamp": "00:31:57", "text": "同一天，即使我把它看作是普通的一天，我也必须强迫"}]
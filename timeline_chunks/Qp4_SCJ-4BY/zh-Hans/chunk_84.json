[{"type": "subtitle", "time": 5041.03, "timestamp": "01:24:01", "text": "我不知道这一切意味着什么，"}, {"type": "subtitle", "time": 5050.39, "timestamp": "01:24:10", "text": "我们要去那里，我就不会遵守"}, {"type": "subtitle", "time": 5054.55, "timestamp": "01:24:14", "text": "任何人的承诺，"}, {"type": "subtitle", "time": 5057.64, "timestamp": "01:24:17", "text": "所以热度。 热。 热。"}, {"type": "subtitle", "time": 5092.79, "timestamp": "01:24:52", "text": "如果爱情即将结束，我希望在"}, {"type": "subtitle", "time": 5095.189, "timestamp": "01:24:55", "text": "你身边。"}, {"type": "subtitle", "time": 5097.37, "timestamp": "01:24:57", "text": "等等，这真的很快吗？"}]
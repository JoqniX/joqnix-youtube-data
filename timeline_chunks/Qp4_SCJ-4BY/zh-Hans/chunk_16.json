[{"type": "subtitle", "time": 961.829, "timestamp": "00:16:01", "text": "不。你遇到什么问题了？ 你为什么这么……"}, {"type": "subtitle", "time": 964.31, "timestamp": "00:16:04", "text": "我的天哪。 我应该"}, {"type": "subtitle", "time": 966.71, "timestamp": "00:16:06", "text": "一个小时前就准备好的。 我当时就想，"}, {"type": "subtitle", "time": 971.35, "timestamp": "00:16:11", "text": "“莫，我还是走吧。没关系。反正也没"}, {"type": "subtitle", "time": 975.749, "timestamp": "00:16:15", "text": "人会祝福我。” 嗯"}, {"type": "subtitle", "time": 977.829, "timestamp": "00:16:17", "text": "，"}, {"type": "subtitle", "time": 980.79, "timestamp": "00:16:20", "text": "我会等的。 它卡住了。 我的天啊。 别"}, {"type": "subtitle", "time": 987.509, "timestamp": "00:16:27", "text": "好了，成功了。 好的。 你好。 让我，让我，让"}, {"type": "subtitle", "time": 992.629, "timestamp": "00:16:32", "text": "我去发现真实。"}, {"type": "subtitle", "time": 996.15, "timestamp": "00:16:36", "text": "好的。 你好。 三、二、一。 希望你能"}, {"type": "subtitle", "time": 1010.949, "timestamp": "00:16:50", "text": "我数到了三、二、"}, {"type": "subtitle", "time": 1019.03, "timestamp": "00:16:59", "text": "请别介意我难听的歌声，但我会尽全力"}]
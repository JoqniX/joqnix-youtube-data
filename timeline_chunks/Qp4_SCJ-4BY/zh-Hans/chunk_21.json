[{"type": "subtitle", "time": 1264.07, "timestamp": "00:21:04", "text": "我可以把你放在"}, {"type": "subtitle", "time": 1270.549, "timestamp": "00:21:10", "text": "我的生日还没到呢。"}, {"type": "subtitle", "time": 1274.71, "timestamp": "00:21:14", "text": "大家好，请进！因为我"}, {"type": "subtitle", "time": 1277.909, "timestamp": "00:21:17", "text": "没用 OBS，所以很抱歉，我"}, {"type": "subtitle", "time": 1279.99, "timestamp": "00:21:19", "text": "不能把你们的名字都写在"}, {"type": "subtitle", "time": 1283.51, "timestamp": "00:21:23", "text": "参加者的名单上。而且，我本来"}, {"type": "subtitle", "time": 1286.789, "timestamp": "00:21:26", "text": "想把你们的名字都写"}, {"type": "subtitle", "time": 1289.909, "timestamp": "00:21:29", "text": "在蛋糕上，"}, {"type": "subtitle", "time": 1294.149, "timestamp": "00:21:34", "text": "就像我们去年那样。不过"}, {"type": "subtitle", "time": 1295.99, "timestamp": "00:21:35", "text": "没关系，"}, {"type": "subtitle", "time": 1309.029, "timestamp": "00:21:49", "text": "你好。 以上就是雷姆·瓜诺。"}, {"type": "subtitle", "time": 1312.39, "timestamp": "00:21:52", "text": "呃，纯属虚构。"}, {"type": "subtitle", "time": 1315.35, "timestamp": "00:21:55", "text": "你好。 你现在多大了？ 我今年是"}, {"type": "subtitle", "time": 1318.95, "timestamp": "00:21:58", "text": "百万富翁。"}]
[{"type": "subtitle", "time": 1449.83, "timestamp": "00:24:09", "text": "好的。 嗯，"}, {"type": "subtitle", "time": 1453.19, "timestamp": "00:24:13", "text": "我试着唱一下这首歌。"}, {"type": "subtitle", "time": 1454.95, "timestamp": "00:24:14", "text": "好久不见了。"}, {"type": "subtitle", "time": 1457.35, "timestamp": "00:24:17", "text": "我不确定自己能不能唱好，但"}, {"type": "subtitle", "time": 1463.1, "timestamp": "00:24:23", "text": "我会试试。 你好。 三、二、一。"}, {"type": "subtitle", "time": 1475.27, "timestamp": "00:24:35", "text": "触动。"}, {"type": "subtitle", "time": 1494.52, "timestamp": "00:24:54", "text": "外国的。"}]
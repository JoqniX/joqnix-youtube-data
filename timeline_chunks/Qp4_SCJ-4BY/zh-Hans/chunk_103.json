[{"type": "subtitle", "time": 6181.99, "timestamp": "01:43:01", "text": "好吧，我想我就到此为止吧。"}, {"type": "subtitle", "time": 6184.39, "timestamp": "01:43:04", "text": "坚持，稍等。"}, {"type": "subtitle", "time": 6188.39, "timestamp": "01:43:08", "text": "我还得回复那些"}, {"type": "subtitle", "time": 6193.109, "timestamp": "01:43:13", "text": "寥寥无几的人发来的私信。"}, {"type": "subtitle", "time": 6214.87, "timestamp": "01:43:34", "text": "。 再见，"}, {"type": "subtitle", "time": 6219.75, "timestamp": "01:43:39", "text": "我不知道这种感觉，你"}, {"type": "subtitle", "time": 6222.709, "timestamp": "01:43:42", "text": "知道，就是有人真心实意地祝福我。"}, {"type": "subtitle", "time": 6226.95, "timestamp": "01:43:46", "text": "感觉很好，"}, {"type": "subtitle", "time": 6229.43, "timestamp": "01:43:49", "text": "你知道吗？ 嗯，是的。 我想我以前经常"}, {"type": "subtitle", "time": 6234.149, "timestamp": "01:43:54", "text": "这么说。 嗯，以前我从来不"}, {"type": "subtitle", "time": 6237.99, "timestamp": "01:43:57", "text": "庆祝，以前认识她的时候也没"}]
[{"type": "subtitle", "time": 4920.709, "timestamp": "01:22:00", "text": "仪器现在没问题了。 我"}, {"type": "subtitle", "time": 4923.35, "timestamp": "01:22:03", "text": "不去，那是官方的。"}, {"type": "subtitle", "time": 4926.229, "timestamp": "01:22:06", "text": "等等，这是环球音乐集团。 我很"}, {"type": "subtitle", "time": 4928.709, "timestamp": "01:22:08", "text": "害怕。 等等，我会收到版权"}, {"type": "subtitle", "time": 4931.99, "timestamp": "01:22:11", "text": "警告吗？ 好的，各位。 我的天哪，我好"}, {"type": "subtitle", "time": 4935.669, "timestamp": "01:22:15", "text": "害怕。 等等，什么？"}, {"type": "subtitle", "time": 4938.55, "timestamp": "01:22:18", "text": "贱人。 我的天啊。 我的天，这下糟了。 我"}, {"type": "subtitle", "time": 4944.629, "timestamp": "01:22:24", "text": "[音乐]"}, {"type": "subtitle", "time": 4947.11, "timestamp": "01:22:27", "text": "好的，我来演奏升调版本。 我"}, {"type": "subtitle", "time": 4950.47, "timestamp": "01:22:30", "text": "只希望我祈祷自己不会惹上"}, {"type": "subtitle", "time": 4959.91, "timestamp": "01:22:39", "text": "会放给你们听，我会这样做，"}, {"type": "subtitle", "time": 4971.189, "timestamp": "01:22:51", "text": "但我没有参考资料，所以我会说，"}, {"type": "subtitle", "time": 4976.47, "timestamp": "01:22:56", "text": "嗯，哦，"}]
[{"type": "subtitle", "time": 307.59, "timestamp": "00:05:07", "text": "好的。 我在这里。 我在这里。"}, {"type": "subtitle", "time": 310.469, "timestamp": "00:05:10", "text": "大家好。"}, {"type": "subtitle", "time": 321.67, "timestamp": "00:05:21", "text": "呃，我当时应该在场"}, {"type": "subtitle", "time": 326.629, "timestamp": "00:05:26", "text": "。 呃，非常抱歉我来晚了"}, {"type": "subtitle", "time": 331.67, "timestamp": "00:05:31", "text": "。 呃，因为我当时在"}, {"type": "subtitle", "time": 336.07, "timestamp": "00:05:36", "text": "想，我到底该不该做这件事"}, {"type": "subtitle", "time": 339.35, "timestamp": "00:05:39", "text": "？ 我当时想，过了好"}, {"type": "subtitle", "time": 342.31, "timestamp": "00:05:42", "text": "一会儿我才接受，然后我就想，"}, {"type": "subtitle", "time": 345.189, "timestamp": "00:05:45", "text": "好吧，那我就这么做吧。"}, {"type": "subtitle", "time": 348.79, "timestamp": "00:05:48", "text": "最初，我计划举办生日派对。"}, {"type": "subtitle", "time": 350.95, "timestamp": "00:05:50", "text": "我原本没打算做生日倒计时"}, {"type": "subtitle", "time": 355.27, "timestamp": "00:05:55", "text": "直播。 其实我只是想和"}]
[{"type": "subtitle", "time": 2174.71, "timestamp": "00:36:14", "text": "感谢各位到场支持"}, {"type": "subtitle", "time": 2177.349, "timestamp": "00:36:17", "text": "。 意义重大。 我"}, {"type": "subtitle", "time": 2180.55, "timestamp": "00:36:20", "text": "知道这是最后的机会了。 我知道上面有"}, {"type": "subtitle", "time": 2183.91, "timestamp": "00:36:23", "text": "很多划痕。   现在"}, {"type": "subtitle", "time": 2187.19, "timestamp": "00:36:27", "text": "发生的事情太多了"}, {"type": "subtitle", "time": 2189.91, "timestamp": "00:36:29", "text": "。 不过，"}, {"type": "subtitle", "time": 2193.91, "timestamp": "00:36:33", "text": "呃，其实"}, {"type": "subtitle", "time": 2196.31, "timestamp": "00:36:36", "text": "还是要谢谢米娜过来。"}, {"type": "subtitle", "time": 2198.79, "timestamp": "00:36:38", "text": "正确的。 呃，我该怎么说呢"}, {"type": "subtitle", "time": 2200.47, "timestamp": "00:36:40", "text": "？"}, {"type": "subtitle", "time": 2202.71, "timestamp": "00:36:42", "text": "等等，伙计。"}, {"type": "subtitle", "time": 2205.19, "timestamp": "00:36:45", "text": "我应该把它贴在我的刘海上。"}, {"type": "subtitle", "time": 2207.829, "timestamp": "00:36:47", "text": "正确的。   好了"}, {"type": "subtitle", "time": 2212.069, "timestamp": "00:36:52", "text": "。 它还在动吗？ 好的。"}, {"type": "subtitle", "time": 2214.79, "timestamp": "00:36:54", "text": "我不知道。 我无话可说了。 我的大脑一片"}, {"type": "subtitle", "time": 2216.63, "timestamp": "00:36:56", "text": "空白。"}, {"type": "subtitle", "time": 2218.87, "timestamp": "00:36:58", "text": "好像"}]
[{"type": "subtitle", "time": 6302.95, "timestamp": "01:45:02", "text": "今天很开心。 我很喜欢。"}, {"type": "subtitle", "time": 6304.87, "timestamp": "01:45:04", "text": "谢谢。"}, {"type": "subtitle", "time": 6309.189, "timestamp": "01:45:09", "text": "那么，我就说到"}, {"type": "subtitle", "time": 6311.35, "timestamp": "01:45:11", "text": "这里吧。"}, {"type": "subtitle", "time": 6314.709, "timestamp": "01:45:14", "text": "嗯，我就说到这里吧。"}, {"type": "subtitle", "time": 6317.189, "timestamp": "01:45:17", "text": "再次感谢"}, {"type": "subtitle", "time": 6320.39, "timestamp": "01:45:20", "text": "今天到场的每一位朋友。 我真的"}, {"type": "subtitle", "time": 6323.83, "timestamp": "01:45:23", "text": "非常感激。 谢谢你今晚陪"}, {"type": "subtitle", "time": 6326.229, "timestamp": "01:45:26", "text": "我一起"}, {"type": "subtitle", "time": 6328.79, "timestamp": "01:45:28", "text": "倒计时。"}, {"type": "subtitle", "time": 6330.95, "timestamp": "01:45:30", "text": "我知道大部分东西都"}, {"type": "subtitle", "time": 6334.629, "timestamp": "01:45:34", "text": "磨损得很厉害。 我没做"}, {"type": "subtitle", "time": 6336.709, "timestamp": "01:45:36", "text": "太多准备。   说"}, {"type": "subtitle", "time": 6340.629, "timestamp": "01:45:40", "text": "实话，我一开始并不想做这个"}, {"type": "subtitle", "time": 6342.39, "timestamp": "01:45:42", "text": "倒计时直播。 我只是想好好地"}, {"type": "subtitle", "time": 6344.47, "timestamp": "01:45:44", "text": "直播一下生日快乐。 只需要一个"}, {"type": "subtitle", "time": 6347.189, "timestamp": "01:45:47", "text": "流就够了。 相反，我把"}, {"type": "subtitle", "time": 6349.27, "timestamp": "01:45:49", "text": "它分成两部分。"}, {"type": "subtitle", "time": 6352.95, "timestamp": "01:45:52", "text": "但即使是最后一刻才来，呃，即使"}, {"type": "subtitle", "time": 6356.629, "timestamp": "01:45:56", "text": "是最后一刻，也谢谢你过来"}]
[{"type": "subtitle", "time": 6063.75, "timestamp": "01:41:03", "text": "それはすごくクールですね。"}, {"type": "subtitle", "time": 6071.189, "timestamp": "01:41:11", "text": "私のウェブサイトにも、誕生日カレンダータイマーみたいなものを設置した方がいいかも。"}, {"type": "subtitle", "time": 6075.03, "timestamp": "01:41:15", "text": "一番上のタイマーは、"}, {"type": "subtitle", "time": 6080.07, "timestamp": "01:41:20", "text": "チャンが作ったもので、2023年の"}, {"type": "subtitle", "time": 6084.31, "timestamp": "01:41:24", "text": "誕生日、つまり今日から2年前の2023年に作られました。"}, {"type": "subtitle", "time": 6086.87, "timestamp": "01:41:26", "text": "彼はその誕生日にそれを作ったのですが、"}, {"type": "subtitle", "time": 6092.31, "timestamp": "01:41:32", "text": "ストリームのためにまだ"}, {"type": "subtitle", "time": 6094.47, "timestamp": "01:41:34", "text": "使っています。Melを"}, {"type": "subtitle", "time": 6097.109, "timestamp": "01:41:37", "text": "使っているので、以前は使っていたような派手な機能"}, {"type": "subtitle", "time": 6102.47, "timestamp": "01:41:42", "text": "や"}, {"type": "subtitle", "time": 6106.95, "timestamp": "01:41:46", "text": "自動化プラグインにはアクセスできません。 ええ、そうですね、私たちはどちらかというと"}, {"type": "subtitle", "time": 6110.47, "timestamp": "01:41:50", "text": "ミニマリスト集団です。   そうそう"}, {"type": "subtitle", "time": 6115.91, "timestamp": "01:41:55", "text": "。 今日は楽しかった。 ありがとう。"}, {"type": "subtitle", "time": 6119.59, "timestamp": "01:41:59", "text": "明日の配信はスケジュールを立てます。 皆さんに"}]
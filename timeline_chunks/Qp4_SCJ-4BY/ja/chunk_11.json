[{"type": "subtitle", "time": 673.99, "timestamp": "00:11:13", "text": "待ちきれない。 私は去年何をしたっけ？"}, {"type": "subtitle", "time": 677.11, "timestamp": "00:11:17", "text": "次は話しましょう。 昨年は何をしていましたか？"}, {"type": "subtitle", "time": 680.15, "timestamp": "00:11:20", "text": "自分の誕生日が見つかりません。"}, {"type": "subtitle", "time": 684.71, "timestamp": "00:11:24", "text": "待って、できないよ。ああ、だめだ。 いや、"}, {"type": "subtitle", "time": 687.19, "timestamp": "00:11:27", "text": "待って。"}, {"type": "subtitle", "time": 691.829, "timestamp": "00:11:31", "text": "私は実際にはできない。待って、ミナ。"}, {"type": "subtitle", "time": 694.63, "timestamp": "00:11:34", "text": "実は誕生日用の帽子が見つからないんです。   何てことだ"}, {"type": "subtitle", "time": 697.99, "timestamp": "00:11:37", "text": "。 いや、そんなことしないで。 えっと、"}, {"type": "subtitle", "time": 702.71, "timestamp": "00:11:42", "text": "サムネイルのやつをやりますね。"}, {"type": "subtitle", "time": 706.15, "timestamp": "00:11:46", "text": "サムネイルに表示されている方をやります。"}, {"type": "subtitle", "time": 711.59, "timestamp": "00:11:51", "text": "ああ、これを今すぐもっとはっきりさせておこう。   まだ"}]
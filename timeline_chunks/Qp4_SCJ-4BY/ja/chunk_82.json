[{"type": "subtitle", "time": 4920.709, "timestamp": "01:22:00", "text": "楽器はもう大丈夫だと思います。 私は"}, {"type": "subtitle", "time": 4923.35, "timestamp": "01:22:03", "text": "行かない、それは公式のものだ。"}, {"type": "subtitle", "time": 4926.229, "timestamp": "01:22:06", "text": "待って、ユニバーサルミュージックグループだよ。 私は"}, {"type": "subtitle", "time": 4928.709, "timestamp": "01:22:08", "text": "怖いです。 待って、著作権侵害の"}, {"type": "subtitle", "time": 4931.99, "timestamp": "01:22:11", "text": "警告を受けるのかな？ そうするよ、みんな。 ああ、"}, {"type": "subtitle", "time": 4935.669, "timestamp": "01:22:15", "text": "怖い。 え、何？"}, {"type": "subtitle", "time": 4938.55, "timestamp": "01:22:18", "text": "[ __ ]。 何てことだ。 ああ、これはまずい。 わかりません"}, {"type": "subtitle", "time": 4944.629, "timestamp": "01:22:24", "text": "[音楽]"}, {"type": "subtitle", "time": 4947.11, "timestamp": "01:22:27", "text": "よし、ピッチアップバージョンをやろう。 ただ、トラブルに巻き込まれないように"}, {"type": "subtitle", "time": 4950.47, "timestamp": "01:22:30", "text": "祈るばかりです"}, {"type": "subtitle", "time": 4959.91, "timestamp": "01:22:39", "text": "皆さんに演奏してあげます。"}, {"type": "subtitle", "time": 4971.189, "timestamp": "01:22:51", "text": "参考資料がないので、えーっと、ちょっと待ってください。えーっと"}]
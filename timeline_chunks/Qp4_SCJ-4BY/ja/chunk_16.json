[{"type": "subtitle", "time": 961.829, "timestamp": "00:16:01", "text": "いいえ。なぜ行き詰まっているのですか？ なぜそんなに なぜそんなに ああ、なんてことだ"}, {"type": "subtitle", "time": 964.31, "timestamp": "00:16:04", "text": "。"}, {"type": "subtitle", "time": 966.71, "timestamp": "00:16:06", "text": "1時間前に準備しておくべきだった。 私は"}, {"type": "subtitle", "time": 971.35, "timestamp": "00:16:11", "text": "「モー、もう帰るよ。大丈夫。"}, {"type": "subtitle", "time": 975.749, "timestamp": "00:16:15", "text": "どうせ誰も私にお祝いの言葉なんて言ってくれないし」って言ったの。 ええ"}, {"type": "subtitle", "time": 977.829, "timestamp": "00:16:17", "text": "、"}, {"type": "subtitle", "time": 980.79, "timestamp": "00:16:20", "text": "待ちますよ。 動かなくなってしまった。 何てことだ。 そんなことしないで"}, {"type": "subtitle", "time": 987.509, "timestamp": "00:16:27", "text": "よし、うまくいった。 わかった。 こんにちは。 本当の自分を発見させてください"}, {"type": "subtitle", "time": 992.629, "timestamp": "00:16:32", "text": "。   わかった"}, {"type": "subtitle", "time": 996.15, "timestamp": "00:16:36", "text": "。 こんにちは。  ３、２、１。"}, {"type": "subtitle", "time": 1019.03, "timestamp": "00:16:59", "text": "私の下手な歌は気にしないでください。"}]
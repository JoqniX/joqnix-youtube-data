[{"type": "subtitle", "time": 540.47, "timestamp": "00:09:00", "text": "けど、そうだね。 そして、今気づいたのですが、このプラットフォームで"}, {"type": "subtitle", "time": 543.829, "timestamp": "00:09:03", "text": "ライブ配信中であることをツイートしていませんでした"}, {"type": "subtitle", "time": 546.55, "timestamp": "00:09:06", "text": "。 よし、残り2分だ。 それでは、"}, {"type": "subtitle", "time": 551.03, "timestamp": "00:09:11", "text": "手早くカカのことをやってみましょう。 えっと、"}, {"type": "subtitle", "time": 553.91, "timestamp": "00:09:13", "text": "私の誕生後、12 の後"}, {"type": "subtitle", "time": 557.19, "timestamp": "00:09:17", "text": "、12 の後、えっと、私の"}, {"type": "subtitle", "time": 559.99, "timestamp": "00:09:19", "text": "誕生日、"}, {"type": "subtitle", "time": 563.91, "timestamp": "00:09:23", "text": "車の場合も少し歌い続けます。 私は"}, {"type": "subtitle", "time": 567.43, "timestamp": "00:09:27", "text": "歌が上手なわけでも何でもないのですが、ベストを尽くします"}, {"type": "subtitle", "time": 571.59, "timestamp": "00:09:31", "text": "。 わかった。 ええと、"}, {"type": "subtitle", "time": 573.67, "timestamp": "00:09:33", "text": "でも下流に行くと"}, {"type": "subtitle", "time": 578.389, "timestamp": "00:09:38", "text": "落ち着きます。"}, {"type": "subtitle", "time": 581.67, "timestamp": "00:09:41", "text": "よし、じゃあやってみよう。 その擦り傷は"}, {"type": "subtitle", "time": 593.11, "timestamp": "00:09:53", "text": "はい、30分です。 そうそう。 さよなら。"}, {"type": "subtitle", "time": 596.79, "timestamp": "00:09:56", "text": "うん。 さよなら。 うん。 さよなら。   わかった"}]
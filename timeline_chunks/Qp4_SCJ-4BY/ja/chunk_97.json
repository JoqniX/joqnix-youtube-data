[{"type": "subtitle", "time": 5825.59, "timestamp": "01:37:05", "text": "息子と一緒にカバー曲を学んでいるところです。私たち二人は"}, {"type": "subtitle", "time": 5829.03, "timestamp": "01:37:09", "text": "一緒に作りたいと思っています。ええ、だから、"}, {"type": "subtitle", "time": 5837.109, "timestamp": "01:37:17", "text": "あの息子が教えてくれるように、私はそういう歌を覚えなければなりません。そうすれば、シャワーを浴びているとき、"}, {"type": "subtitle", "time": 5843.75, "timestamp": "01:37:23", "text": "歌詞を思い出したときなどにいつでも歌えるようになります。 私はこう言うだろう"}, {"type": "subtitle", "time": 5852.149, "timestamp": "01:37:32", "text": "そして私は"}, {"type": "subtitle", "time": 5855.99, "timestamp": "01:37:35", "text": "最初の節から最後まで全部歌った。 なんていうか、すごいな"}, {"type": "subtitle", "time": 5860.07, "timestamp": "01:37:40", "text": "、私の心に焼き付いているんだ。 ああ、もう"}, {"type": "subtitle", "time": 5862.39, "timestamp": "01:37:42", "text": "歌詞は必要ない。 私は何を"}, {"type": "subtitle", "time": 5865.03, "timestamp": "01:37:45", "text": "歌うべきか知っています。 そう、それが私が"}, {"type": "subtitle", "time": 5867.669, "timestamp": "01:37:47", "text": "これらの曲すべてでやりたいことなんです。 ということで、私が好きな"}, {"type": "subtitle", "time": 5873.99, "timestamp": "01:37:53", "text": "曲を聴いてくださってありがとうございます。   ええ"}, {"type": "subtitle", "time": 5876.95, "timestamp": "01:37:56", "text": "、いつか上手に歌えるようになると思います。上手に"}]
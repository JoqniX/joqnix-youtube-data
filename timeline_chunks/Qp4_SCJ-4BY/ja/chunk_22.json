[{"type": "subtitle", "time": 1324.71, "timestamp": "00:22:04", "text": "私はスターだ。 忘れたの？ 私はスターだ。"}, {"type": "subtitle", "time": 1327.27, "timestamp": "00:22:07", "text": "いいえ、私は星座です。 私は"}, {"type": "subtitle", "time": 1330.95, "timestamp": "00:22:10", "text": "星でできている。 うん。 でも私のスターデーはそうよ"}, {"type": "subtitle", "time": 1333.43, "timestamp": "00:22:13", "text": "。 明日が正式な"}, {"type": "subtitle", "time": 1335.27, "timestamp": "00:22:15", "text": "祝賀会となる。 でも、私たちには70分くらいの時間があるんです"}, {"type": "subtitle", "time": 1340.07, "timestamp": "00:22:20", "text": "。 こんにちは。 えーっと、でもそうですね、あと"}, {"type": "subtitle", "time": 1344.23, "timestamp": "00:22:24", "text": "1年くらいは続けると思います。 あと1年、幸運に恵まれるだろう"}, {"type": "subtitle", "time": 1348.149, "timestamp": "00:22:28", "text": "。 わからない。"}, {"type": "subtitle", "time": 1350.63, "timestamp": "00:22:30", "text": "でも、そうですね、もう十分な年齢です"}, {"type": "subtitle", "time": 1352.47, "timestamp": "00:22:32", "text": "。"}, {"type": "subtitle", "time": 1355.43, "timestamp": "00:22:35", "text": "私は年を取ってきた。"}, {"type": "subtitle", "time": 1361.51, "timestamp": "00:22:41", "text": "。 こんにちは。"}, {"type": "subtitle", "time": 1365.11, "timestamp": "00:22:45", "text": "それで、えっと、"}, {"type": "subtitle", "time": 1369.029, "timestamp": "00:22:49", "text": "どの歌を歌えばいいのか、他に何を歌えばいいのかわからないんです"}, {"type": "subtitle", "time": 1371.19, "timestamp": "00:22:51", "text": "。"}, {"type": "subtitle", "time": 1374.71, "timestamp": "00:22:54", "text": "えっと、この歌みたいに歌って。   えーっと、"}]
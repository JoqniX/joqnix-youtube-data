[{"type": "subtitle", "time": 2174.71, "timestamp": "00:36:14", "text": "皆様、ありがとうございました"}, {"type": "subtitle", "time": 2177.349, "timestamp": "00:36:17", "text": "。 本当に感謝しています。"}, {"type": "subtitle", "time": 2180.55, "timestamp": "00:36:20", "text": "これが最後の瞬間だと分かっています。"}, {"type": "subtitle", "time": 2183.91, "timestamp": "00:36:23", "text": "傷がたくさんあるのは分かっています。   以前よりもずっと多くのことが"}, {"type": "subtitle", "time": 2187.19, "timestamp": "00:36:27", "text": "起こっています"}, {"type": "subtitle", "time": 2189.91, "timestamp": "00:36:29", "text": "。 でも、"}, {"type": "subtitle", "time": 2193.91, "timestamp": "00:36:33", "text": "ミナ、来てくれて本当にありがとう"}, {"type": "subtitle", "time": 2196.31, "timestamp": "00:36:36", "text": "。"}, {"type": "subtitle", "time": 2198.79, "timestamp": "00:36:38", "text": "右。 えっと、もっとどうやって入れればいいですか"}, {"type": "subtitle", "time": 2200.47, "timestamp": "00:36:40", "text": "？   ちょっと"}, {"type": "subtitle", "time": 2202.71, "timestamp": "00:36:42", "text": "待ってくれ。"}, {"type": "subtitle", "time": 2205.19, "timestamp": "00:36:45", "text": "前髪につけることになっているんです。"}, {"type": "subtitle", "time": 2207.829, "timestamp": "00:36:47", "text": "右。   はい、どうぞ"}, {"type": "subtitle", "time": 2212.069, "timestamp": "00:36:52", "text": "。 まだ動いていますか？ わかった。   わからない"}, {"type": "subtitle", "time": 2214.79, "timestamp": "00:36:54", "text": "。 言葉が出ない。 私の脳が"}, {"type": "subtitle", "time": 2216.63, "timestamp": "00:36:56", "text": "停止しそうです。"}]
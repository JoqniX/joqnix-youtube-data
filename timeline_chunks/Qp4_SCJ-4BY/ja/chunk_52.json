[{"type": "subtitle", "time": 3123.43, "timestamp": "00:52:03", "text": "これを全部ここに載せておきますね。 えっと、もし私がこれだけ歌ったら、えっと、つまり、一行、一行と書くということです"}, {"type": "subtitle", "time": 3128.71, "timestamp": "00:52:08", "text": "。"}, {"type": "subtitle", "time": 3137.43, "timestamp": "00:52:17", "text": "これは"}, {"type": "subtitle", "time": 3140.79, "timestamp": "00:52:20", "text": "息子が最近私に歌を教えてくれた歌を歌いましょう"}, {"type": "subtitle", "time": 3143.43, "timestamp": "00:52:23", "text": "。 えーと、これは"}, {"type": "subtitle", "time": 3147.349, "timestamp": "00:52:27", "text": "私が今後歌ったりリリースしたりするカバー曲にもなるので、えーと皆さんのために用意しますね"}, {"type": "subtitle", "time": 3162.63, "timestamp": "00:52:42", "text": "[音楽]"}, {"type": "subtitle", "time": 3170.23, "timestamp": "00:52:50", "text": "最善を尽くします。   えっと"}]
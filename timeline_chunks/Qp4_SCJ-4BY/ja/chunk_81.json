[{"type": "subtitle", "time": 4861.83, "timestamp": "01:21:01", "text": "あれは"}, {"type": "subtitle", "time": 4868.31, "timestamp": "01:21:08", "text": "うん。"}, {"type": "subtitle", "time": 4870.54, "timestamp": "01:21:10", "text": "面白い。"}, {"type": "subtitle", "time": 4873.75, "timestamp": "01:21:13", "text": "[音楽]"}, {"type": "subtitle", "time": 4878.47, "timestamp": "01:21:18", "text": "あれ、私にはそれがないの？ えっと、"}, {"type": "subtitle", "time": 4880.79, "timestamp": "01:21:20", "text": "ブルーノの歌。"}, {"type": "subtitle", "time": 4883.99, "timestamp": "01:21:23", "text": "あ、待って。 私は実際には「ああ、"}, {"type": "subtitle", "time": 4889.189, "timestamp": "01:21:29", "text": "神様」という気持ちはありません。 私はそれを持っていません"}, {"type": "subtitle", "time": 4893.11, "timestamp": "01:21:33", "text": "。 いや、みんな。 いいえ、インス"}, {"type": "subtitle", "time": 4895.43, "timestamp": "01:21:35", "text": "トゥルメンタルは持っていません。"}, {"type": "subtitle", "time": 4900.47, "timestamp": "01:21:40", "text": "ちょっと待って。 神。 ああ、"}, {"type": "subtitle", "time": 4905.43, "timestamp": "01:21:45", "text": "ブルーノとレディの主よ、インストゥル"}, {"type": "subtitle", "time": 4914.149, "timestamp": "01:21:54", "text": "著作権侵害で訴えられそうだ。"}]
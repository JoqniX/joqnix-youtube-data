[{"type": "subtitle", "time": 2101.03, "timestamp": "00:35:01", "text": "ハッピーバースデーの歌をどうやって歌えばいいんだろう。"}, {"type": "subtitle", "time": 2103.349, "timestamp": "00:35:03", "text": "誕生日おめでとうの歌。 ああ、"}, {"type": "subtitle", "time": 2120.87, "timestamp": "00:35:20", "text": "。"}, {"type": "subtitle", "time": 2133.19, "timestamp": "00:35:33", "text": "えっと。 待って。 待って。 歌詞が必要です。"}, {"type": "subtitle", "time": 2136.47, "timestamp": "00:35:36", "text": "おお。 わかった。 わかった。 わかった。"}, {"type": "subtitle", "time": 2139.829, "timestamp": "00:35:39", "text": "待って、それは、ああ、そうそう、そう、わかった、わかった、というコーラスを"}, {"type": "subtitle", "time": 2141.27, "timestamp": "00:35:41", "text": "作ったものだった。"}]
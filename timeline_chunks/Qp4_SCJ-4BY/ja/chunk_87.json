[{"type": "subtitle", "time": 5221.11, "timestamp": "01:27:01", "text": "パーティーは終わり、私たちの地上での時間は"}, {"type": "subtitle", "time": 5223.189, "timestamp": "01:27:03", "text": "真実のものとなった。"}, {"type": "subtitle", "time": 5225.189, "timestamp": "01:27:05", "text": "ああ、ほんの少しの間だけ"}, {"type": "subtitle", "time": 5229.91, "timestamp": "01:27:09", "text": "君を抱きしめていたい。"}, {"type": "subtitle", "time": 5231.99, "timestamp": "01:27:11", "text": "そして私は、"}, {"type": "subtitle", "time": 5238.55, "timestamp": "01:27:18", "text": "壁に向かって微笑みながら、その作業が終わった。"}, {"type": "subtitle", "time": 5241.99, "timestamp": "01:27:21", "text": "君のそばにいたい。 あ、待って。 音楽は悪くない"}, {"type": "subtitle", "time": 5245.75, "timestamp": "01:27:25", "text": "。 私は今も歌い続けています。"}, {"type": "subtitle", "time": 5250.229, "timestamp": "01:27:30", "text": "ああ、あなたのそばにいたい。 私は"}, {"type": "subtitle", "time": 5253.91, "timestamp": "01:27:33", "text": "これを学んで、"}, {"type": "subtitle", "time": 5256.629, "timestamp": "01:27:36", "text": "適切な楽器を見つける必要があります。 私が手に入れたものはベースが高すぎたし、"}, {"type": "subtitle", "time": 5263.51, "timestamp": "01:27:43", "text": "現在の長さとも違っていた。"}, {"type": "subtitle", "time": 5265.59, "timestamp": "01:27:45", "text": "大丈夫。"}, {"type": "subtitle", "time": 5268.149, "timestamp": "01:27:48", "text": "誕生日のお祝いのメッセージをありがとうございます。"}, {"type": "subtitle", "time": 5269.75, "timestamp": "01:27:49", "text": "ありがとう。"}, {"type": "subtitle", "time": 5272.31, "timestamp": "01:27:52", "text": "ひどい歌声だったね？ 英語の"}, {"type": "subtitle", "time": 5275.75, "timestamp": "01:27:55", "text": "歌。 私はそれが得意ではありません。"}]
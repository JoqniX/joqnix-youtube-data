[{"type": "subtitle", "time": 486.15, "timestamp": "00:08:06", "text": "Twitchで視聴している方々へ。残念ながら、ビリー・ビリーには"}, {"type": "subtitle", "time": 488.79, "timestamp": "00:08:08", "text": "配信できませんでしたが、"}, {"type": "subtitle", "time": 491.749, "timestamp": "00:08:11", "text": "中国の"}, {"type": "subtitle", "time": 494.629, "timestamp": "00:08:14", "text": "家族コンステルには、"}, {"type": "subtitle", "time": 498.309, "timestamp": "00:08:18", "text": "キックとビームの配信に来てほしいと伝えました。なぜなら、"}, {"type": "subtitle", "time": 500.71, "timestamp": "00:08:20", "text": "その2つのプラットフォームは中国でも利用できるからです"}, {"type": "subtitle", "time": 503.589, "timestamp": "00:08:23", "text": "。 ええ、つまり、TwitchとYouTubeは"}, {"type": "subtitle", "time": 505.99, "timestamp": "00:08:25", "text": "そこでは利用できません。 ええ、大丈夫です。"}, {"type": "subtitle", "time": 514.469, "timestamp": "00:08:34", "text": "説明欄か"}, {"type": "subtitle", "time": 516.469, "timestamp": "00:08:36", "text": "固定コメントにリンクがあるので、"}, {"type": "subtitle", "time": 519.19, "timestamp": "00:08:39", "text": "誕生日メッセージを送りたい場合は、"}, {"type": "subtitle", "time": 522.07, "timestamp": "00:08:42", "text": "誕生日のお祝いメッセージなど、その"}, {"type": "subtitle", "time": 524.71, "timestamp": "00:08:44", "text": "誕生日カード、誕生日グリーティング"}, {"type": "subtitle", "time": 527.99, "timestamp": "00:08:47", "text": "カードボードを使ってメッセージを送ってください"}, {"type": "subtitle", "time": 530.63, "timestamp": "00:08:50", "text": "。"}, {"type": "subtitle", "time": 533.829, "timestamp": "00:08:53", "text": "今日は確認しませんが、明日確認します。 わかった。   まだ"}, {"type": "subtitle", "time": 537.269, "timestamp": "00:08:57", "text": "見ていない"}]
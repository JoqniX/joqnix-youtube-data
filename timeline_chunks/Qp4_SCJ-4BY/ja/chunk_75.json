[{"type": "subtitle", "time": 4500.79, "timestamp": "01:15:00", "text": "聴きいただいたのは、"}, {"type": "subtitle", "time": 4506.709, "timestamp": "01:15:06", "text": "オードラのウルトラ・アキュドラ・アキュドラのウルトラ・アレルギーです。"}, {"type": "subtitle", "time": 4515.03, "timestamp": "01:15:15", "text": "お祝いの言葉をありがとうございます。"}, {"type": "subtitle", "time": 4523.35, "timestamp": "01:15:23", "text": "、見せてください。 何を歌えばいいですか？"}, {"type": "subtitle", "time": 4527.46, "timestamp": "01:15:27", "text": "ああ、そうだね。 たくさんあります。 はぁ？"}, {"type": "chat", "time": 4533.353, "timestamp": "01:15:33", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "May your dream come true and you go far in life"}, {"type": "subtitle", "time": 4533.75, "timestamp": "01:15:33", "text": "自信のない曲もあるので、そういう曲は"}, {"type": "subtitle", "time": 4538.07, "timestamp": "01:15:38", "text": "歌いたくないんです。"}, {"type": "chat", "time": 4540.203, "timestamp": "01:15:40", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "UCdZBnUb7m8Pd_wUTDNqUu3Q/PVfsZ-7tIYCO_9EPt-GMgAwUCdZBnUb7m8Pd_wUTDNqUu3Q/PVfsZ-7tIYCO_9EPt-GMgAwUCdZBnUb7m8Pd_wUTDNqUu3Q/PVfsZ-7tIYCO_9EPt-GMgAw"}, {"type": "subtitle", "time": 4540.55, "timestamp": "01:15:40", "text": "あなたの夢が叶い、"}, {"type": "subtitle", "time": 4544.07, "timestamp": "01:15:44", "text": "人生で大きな成功を収められますように。 ありがとう。 それは本当に"}, {"type": "subtitle", "time": 4554.87, "timestamp": "01:15:54", "text": "えっと、"}, {"type": "subtitle", "time": 4559.27, "timestamp": "01:15:59", "text": "バニーガールは知ってるよ。"}]
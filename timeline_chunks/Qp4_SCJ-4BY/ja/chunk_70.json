[{"type": "subtitle", "time": 4206.55, "timestamp": "01:10:06", "text": "EDMの要素も少しあるけど、まあね。"}, {"type": "subtitle", "time": 4209.43, "timestamp": "01:10:09", "text": "ああ、この"}, {"type": "subtitle", "time": 4213.11, "timestamp": "01:10:13", "text": "配信は収益化停止になるだろうけど、"}, {"type": "subtitle", "time": 4216.95, "timestamp": "01:10:16", "text": "著作権のある曲だから大丈夫。 まあ、そうですね。 わかった。 これは"}, {"type": "subtitle", "time": 4219.669, "timestamp": "01:10:19", "text": "私が練習している曲の一つです。 私はずっと前にそれを"}, {"type": "subtitle", "time": 4222.31, "timestamp": "01:10:22", "text": "学んだ。 わかった。"}, {"type": "subtitle", "time": 4224.39, "timestamp": "01:10:24", "text": "私が歌を学びたいというこの旅を再開するずっと前のことです"}, {"type": "subtitle", "time": 4229.99, "timestamp": "01:10:29", "text": "。 こんにちは、"}, {"type": "subtitle", "time": 4232.87, "timestamp": "01:10:32", "text": "ガナチング・ディッシュです。 では、これは、ええと、"}, {"type": "subtitle", "time": 4244.47, "timestamp": "01:10:44", "text": "次はオードラです。"}, {"type": "subtitle", "time": 4247.35, "timestamp": "01:10:47", "text": "オードラは優秀なプロデューサーだ。"}, {"type": "subtitle", "time": 4249.91, "timestamp": "01:10:49", "text": "極度の警戒態勢。"}, {"type": "subtitle", "time": 4256.229, "timestamp": "01:10:56", "text": "皆さんのために英語の歌をいくつか覚えて、自分がどれくらい上手に歌えるか試してみたかったな"}, {"type": "subtitle", "time": 4258.41, "timestamp": "01:10:58", "text": "。"}]
[{"type": "subtitle", "time": 2823.43, "timestamp": "00:47:03", "text": "。 お母さん、"}, {"type": "subtitle", "time": 2827.91, "timestamp": "00:47:07", "text": "了解。 えーと、今日、えーと、今日は"}, {"type": "subtitle", "time": 2833.19, "timestamp": "00:47:13", "text": "私の誕生日です。 だから今日は、"}, {"type": "subtitle", "time": 2837.51, "timestamp": "00:47:17", "text": "私のアイドルである神様が止まって、"}, {"type": "subtitle", "time": 2840.47, "timestamp": "00:47:20", "text": "私のアイドルの誕生日でもあるんです。"}, {"type": "subtitle", "time": 2844.39, "timestamp": "00:47:24", "text": "だから、私は"}, {"type": "subtitle", "time": 2848.069, "timestamp": "00:47:28", "text": "家族と一緒に自宅でお祝いをするつもりです。 これは、"}, {"type": "subtitle", "time": 2852.71, "timestamp": "00:47:32", "text": "家族と過ごす最後の祝賀会となるでしょう。 つまり、私の記憶が"}, {"type": "chat", "time": 2853.036, "timestamp": "00:47:33", "author": "@Dragnozer", "avatar": "https://yt4.ggpht.com/S76Kh7cHFwpQNz9yjhQC88CHN2CaFRgcX6E1lcl7bEXBNP_DPdf1iSETHK2qlrHYkwo6BbPw=s64-c-k-c0x00ffffff-no-rj", "message": "i was afk for a bit did we sing the song?"}, {"type": "subtitle", "time": 2857.67, "timestamp": "00:47:37", "text": "正しければ、午後6時から放送されるということですね。"}, {"type": "subtitle", "time": 2860.63, "timestamp": "00:47:40", "text": "夕方に。 それで、"}, {"type": "subtitle", "time": 2863.99, "timestamp": "00:47:43", "text": "明日の誕生日配信、つまり午後"}, {"type": "subtitle", "time": 2871.27, "timestamp": "00:47:51", "text": "4時過ぎからのちゃんとした誕生日配信をするかどうか考えているんです。 あるいは午後3時頃。"}, {"type": "subtitle", "time": 2874.15, "timestamp": "00:47:54", "text": "午後に。"}, {"type": "subtitle", "time": 2879.27, "timestamp": "00:47:59", "text": "えーっと、午後4時か午後3時です。 午後に。 もしくは、"}]
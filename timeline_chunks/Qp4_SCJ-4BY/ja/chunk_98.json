[{"type": "subtitle", "time": 5882.87, "timestamp": "01:38:02", "text": "歌えるようになるために最善を尽くします"}, {"type": "subtitle", "time": 5885.75, "timestamp": "01:38:05", "text": "。 そしてまた、将来の日、何"}, {"type": "subtitle", "time": 5891.91, "timestamp": "01:38:11", "text": "年も先の将来には、"}, {"type": "subtitle", "time": 5894.95, "timestamp": "01:38:14", "text": "特に自分の誕生日に自分の音楽を作りたいと思っています"}, {"type": "subtitle", "time": 5897.99, "timestamp": "01:38:17", "text": "。 もし将来、音楽制作の腕がもっと上達したら、"}, {"type": "subtitle", "time": 5901.43, "timestamp": "01:38:21", "text": "自分が作った新しい音楽をリリースしたり、披露したりしたいと思っています"}, {"type": "subtitle", "time": 5914.55, "timestamp": "01:38:34", "text": "そうそう、音楽の話になったから"}, {"type": "subtitle", "time": 5916.149, "timestamp": "01:38:36", "text": "、"}, {"type": "subtitle", "time": 5918.629, "timestamp": "01:38:38", "text": "ああ、言い忘れてたけど"}, {"type": "subtitle", "time": 5921.35, "timestamp": "01:38:41", "text": "、今週から今日は月曜日だよね"}, {"type": "subtitle", "time": 5925.03, "timestamp": "01:38:45", "text": "？ はい。 今週から、私が"}, {"type": "subtitle", "time": 5929.03, "timestamp": "01:38:49", "text": "音楽活動をしている姿をお見かけするでしょう。   ウェブ"}, {"type": "subtitle", "time": 5931.99, "timestamp": "01:38:51", "text": "サイト関連のことはもう"}, {"type": "subtitle", "time": 5934.79, "timestamp": "01:38:54", "text": "十分だ。 残っているのは、ほとんどがジョックアソンの"}, {"type": "subtitle", "time": 5937.109, "timestamp": "01:38:57", "text": "ページだけだ。 残りのことはすべて"}]
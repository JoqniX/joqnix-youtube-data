[{"type": "subtitle", "time": 2460.55, "timestamp": "00:41:00", "text": "あ、待って、待って、待って。"}, {"type": "subtitle", "time": 2463.27, "timestamp": "00:41:03", "text": "ハッピーバースデーの歌を歌わせてください。 待って、待って、待って。   ちょっと"}, {"type": "subtitle", "time": 2472.39, "timestamp": "00:41:12", "text": "これはまるで子供の歌のようだ。 どこだ、"}, {"type": "subtitle", "time": 2474.79, "timestamp": "00:41:14", "text": "どこだ、ああ、ボーカル。 私はこれが欲しい"}, {"type": "subtitle", "time": 2476.87, "timestamp": "00:41:16", "text": "。 よし、じゃあ音楽なしで歌ってみよう。もしかしたら"}, {"type": "subtitle", "time": 2482.069, "timestamp": "00:41:22", "text": "音楽付きでもいいかも。 ボーカルなし。   何てことだ"}, {"type": "subtitle", "time": 2483.829, "timestamp": "00:41:23", "text": "。 よし、楽器だ。 わかった。"}, {"type": "subtitle", "time": 2500.63, "timestamp": "00:41:40", "text": "誕生日おめでとう、私。"}, {"type": "subtitle", "time": 2502.71, "timestamp": "00:41:42", "text": "誕生日おめでとう、"}, {"type": "subtitle", "time": 2504.87, "timestamp": "00:41:44", "text": "私。"}, {"type": "chat", "time": 2506.156, "timestamp": "00:41:46", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Greetings Konzteller! definitely not Taki ~🌟 Welcome to the Guild! Make sure to read the Guildmate Guidelines in the description below before chatting further. Enjoy your stay!"}, {"type": "subtitle", "time": 2507.03, "timestamp": "00:41:47", "text": "誕生日おめでとう、"}, {"type": "subtitle", "time": 2509.75, "timestamp": "00:41:49", "text": "親愛なる闇よ。"}, {"type": "subtitle", "time": 2513.589, "timestamp": "00:41:53", "text": "誕生日おめでとう、私。"}, {"type": "subtitle", "time": 2516.55, "timestamp": "00:41:56", "text": "お誕生日おめでとう。 待って待って待って。"}, {"type": "subtitle", "time": 2519.43, "timestamp": "00:41:59", "text": "神のご加護がありますように。"}]
[{"type": "subtitle", "time": 5101.99, "timestamp": "01:25:01", "text": "[音楽]"}, {"type": "subtitle", "time": 5105.03, "timestamp": "01:25:05", "text": "私は負けた。"}, {"type": "subtitle", "time": 5109.35, "timestamp": "01:25:09", "text": "私たちが叫ぶ世界に迷い込んでしまった。もう"}, {"type": "subtitle", "time": 5111.59, "timestamp": "01:25:11", "text": "こんなことはしたくない。だって、あなたが"}, {"type": "subtitle", "time": 5117.43, "timestamp": "01:25:17", "text": "私にとってどれほど大切な存在か、あなたは知らないし、"}, {"type": "subtitle", "time": 5121.03, "timestamp": "01:25:21", "text": "私は戦う価値のある唯一の人を失ってしまったから"}, {"type": "subtitle", "time": 5123.35, "timestamp": "01:25:23", "text": "。"}, {"type": "subtitle", "time": 5125.669, "timestamp": "01:25:25", "text": "あなたがどこへ行こうとも、私もついていきます"}, {"type": "subtitle", "time": 5127.99, "timestamp": "01:25:27", "text": "。"}, {"type": "subtitle", "time": 5132.47, "timestamp": "01:25:32", "text": "明日を約束できる人は誰もいない。"}, {"type": "subtitle", "time": 5134.55, "timestamp": "01:25:34", "text": "だから、昨夜みたいに毎晩君を愛するよ"}, {"type": "subtitle", "time": 5138.709, "timestamp": "01:25:38", "text": "。 たぶんこれが最後だろう。"}, {"type": "subtitle", "time": 5142.709, "timestamp": "01:25:42", "text": "世界が終わるなら、私は"}, {"type": "subtitle", "time": 5151.43, "timestamp": "01:25:51", "text": "もしパーティーが終わって、この世での私たちの時間が"}]
[{"type": "subtitle", "time": 1270.549, "timestamp": "00:21:10", "text": "まだ私の誕生日じゃない。 こんにちは、または"}, {"type": "subtitle", "time": 1274.71, "timestamp": "00:21:14", "text": "皆さん、どうぞお入りください。OBSを使用していないので、"}, {"type": "subtitle", "time": 1283.51, "timestamp": "00:21:23", "text": "参加している皆さんの名前を載せられなくて申し訳ありません。"}, {"type": "subtitle", "time": 1294.149, "timestamp": "00:21:34", "text": "去年のようにケーキに名前などすべてを載せたかったのですが、"}, {"type": "subtitle", "time": 1295.99, "timestamp": "00:21:35", "text": "大丈夫です。"}, {"type": "subtitle", "time": 1309.029, "timestamp": "00:21:49", "text": "こんにちは。 それがレム・グアノでした。"}, {"type": "subtitle", "time": 1312.39, "timestamp": "00:21:52", "text": "ええと、大げさな話ですね。"}, {"type": "subtitle", "time": 1315.35, "timestamp": "00:21:55", "text": "こんにちは。 あなたは今何歳ですか？ 私は"}, {"type": "subtitle", "time": 1318.95, "timestamp": "00:21:58", "text": "億万長者です。"}]
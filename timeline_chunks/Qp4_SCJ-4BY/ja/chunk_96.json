[{"type": "subtitle", "time": 5766.47, "timestamp": "01:36:06", "text": "ええ、最終的には、"}, {"type": "subtitle", "time": 5769.59, "timestamp": "01:36:09", "text": "自分の声"}, {"type": "subtitle", "time": 5773.51, "timestamp": "01:36:13", "text": "やその他すべてを理解し、"}, {"type": "subtitle", "time": 5776.47, "timestamp": "01:36:16", "text": "それをコントロールする方法を学べるようになれば、その頃には"}, {"type": "subtitle", "time": 5780.149, "timestamp": "01:36:20", "text": "十分上手くなると思います。特に"}, {"type": "subtitle", "time": 5782.709, "timestamp": "01:36:22", "text": "呼吸も。   以上です。"}, {"type": "subtitle", "time": 5784.79, "timestamp": "01:36:24", "text": "それでは、ご"}, {"type": "subtitle", "time": 5792.87, "timestamp": "01:36:32", "text": "信じられないけど、"}, {"type": "subtitle", "time": 5796.55, "timestamp": "01:36:36", "text": "ずっとみんなのためにコックセットをやりたかったんだ"}, {"type": "subtitle", "time": 5799.43, "timestamp": "01:36:39", "text": "。 そう、"}, {"type": "subtitle", "time": 5802.39, "timestamp": "01:36:42", "text": "歌詞は画面には表示していなかったけど、"}, {"type": "subtitle", "time": 5805.109, "timestamp": "01:36:45", "text": "ここにはあったよ。 でも、"}, {"type": "subtitle", "time": 5809.59, "timestamp": "01:36:49", "text": "いつか自分でコギッシュをやる時は、"}, {"type": "subtitle", "time": 5812.55, "timestamp": "01:36:52", "text": "ガイドボーカルも歌詞もあまり使わないつもりです"}, {"type": "subtitle", "time": 5813.51, "timestamp": "01:36:53", "text": "。"}, {"type": "subtitle", "time": 5816.39, "timestamp": "01:36:56", "text": "ちょうど、あの美しい6月"}, {"type": "subtitle", "time": 5819.189, "timestamp": "01:36:59", "text": "8日の歌のように、私たちは8時までに、あの"}]
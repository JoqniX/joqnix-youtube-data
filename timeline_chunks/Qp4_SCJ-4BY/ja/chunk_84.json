[{"type": "subtitle", "time": 5041.03, "timestamp": "01:24:01", "text": "意味なのか分からないけれど、だから私たちは行くんだと"}, {"type": "subtitle", "time": 5057.64, "timestamp": "01:24:17", "text": "。だから私は誰の約束にも従わない。だから熱。 熱。 熱。"}, {"type": "subtitle", "time": 5092.79, "timestamp": "01:24:52", "text": "もし愛が終わるなら、私は"}, {"type": "subtitle", "time": 5095.189, "timestamp": "01:24:55", "text": "あなたのそばにいたい。"}, {"type": "subtitle", "time": 5097.37, "timestamp": "01:24:57", "text": "え、それって本当に速いの？"}]
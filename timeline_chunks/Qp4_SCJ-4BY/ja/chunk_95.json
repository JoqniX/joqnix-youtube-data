[{"type": "subtitle", "time": 5701.03, "timestamp": "01:35:01", "text": "、"}, {"type": "subtitle", "time": 5703.27, "timestamp": "01:35:03", "text": "私は通常のギターバージョンを手に入れました。 それが"}, {"type": "subtitle", "time": 5706.31, "timestamp": "01:35:06", "text": "あなたが聞いた話ですね。"}, {"type": "subtitle", "time": 5709.99, "timestamp": "01:35:09", "text": "こんにちは、"}, {"type": "subtitle", "time": 5716.229, "timestamp": "01:35:16", "text": "今日のkokの部分からの挨拶は以上です。 わかった。"}, {"type": "subtitle", "time": 5720.47, "timestamp": "01:35:20", "text": "えっと、今夜歌った曲の"}, {"type": "subtitle", "time": 5724.149, "timestamp": "01:35:24", "text": "ほとんどは完璧とは言えませんが、"}, {"type": "subtitle", "time": 5726.95, "timestamp": "01:35:26", "text": "将来、"}, {"type": "subtitle", "time": 5729.51, "timestamp": "01:35:29", "text": "歌がもっと上手になることを願っています。そして、皆さんは"}, {"type": "subtitle", "time": 5732.629, "timestamp": "01:35:32", "text": "私が歌を上達させ、歌を学び、歌が上手くなっていく様子を見守ってくれるでしょう"}, {"type": "subtitle", "time": 5737.83, "timestamp": "01:35:37", "text": "。 えーっと、"}, {"type": "subtitle", "time": 5743.43, "timestamp": "01:35:43", "text": "もっとアクティブになって、練習して、えーっと、なんて"}, {"type": "subtitle", "time": 5746.31, "timestamp": "01:35:46", "text": "言うんだっけ、練習して、"}, {"type": "subtitle", "time": 5749.03, "timestamp": "01:35:49", "text": "もっとはっきりと、もっと表現豊かに、歌うときとかにもっと"}, {"type": "subtitle", "time": 5750.79, "timestamp": "01:35:50", "text": "表現豊かになるように最善を尽くします。私が"}, {"type": "subtitle", "time": 5758.95, "timestamp": "01:35:58", "text": "歌うときは、ほとんどの場合、単調で、単調というよりは単調っぽいのは分かっていますが、"}]
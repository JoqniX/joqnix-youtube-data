[{"type": "subtitle", "time": 6122.39, "timestamp": "01:42:02", "text": "お知らせします。   よし"}, {"type": "subtitle", "time": 6126.149, "timestamp": "01:42:06", "text": "。"}, {"type": "subtitle", "time": 6130.07, "timestamp": "01:42:10", "text": "このカードで皆さんにお知らせします。"}, {"type": "subtitle", "time": 6133.99, "timestamp": "01:42:13", "text": "お祝いの配信をするときは、"}, {"type": "subtitle", "time": 6136.709, "timestamp": "01:42:16", "text": "皆さんのメッセージなど"}, {"type": "subtitle", "time": 6138.31, "timestamp": "01:42:18", "text": "全て読み上げます。"}, {"type": "subtitle", "time": 6143.03, "timestamp": "01:42:23", "text": "うん、そうだよ。"}, {"type": "subtitle", "time": 6145.27, "timestamp": "01:42:25", "text": "見たい衝動に駆られるんだけど、"}, {"type": "subtitle", "time": 6147.109, "timestamp": "01:42:27", "text": "「うん、明日だ。"}, {"type": "subtitle", "time": 6149.109, "timestamp": "01:42:29", "text": "明日のことだ。明日やろう。"}, {"type": "subtitle", "time": 6151.51, "timestamp": "01:42:31", "text": "開けるなよ、バカ。"}, {"type": "subtitle", "time": 6155.91, "timestamp": "01:42:35", "text": "明日やろう。次はジョーだ」って思うんだ。"}, {"type": "subtitle", "time": 6172.95, "timestamp": "01:42:52", "text": "私たちは最善を尽くします。"}]
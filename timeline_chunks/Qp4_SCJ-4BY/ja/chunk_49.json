[{"type": "subtitle", "time": 2942.069, "timestamp": "00:49:02", "text": "Discordで集まるようなことをしました"}, {"type": "subtitle", "time": 2945.91, "timestamp": "00:49:05", "text": "。 えっと、Discord で"}, {"type": "subtitle", "time": 2948.87, "timestamp": "00:49:08", "text": "集まるようなもので、えっと、"}, {"type": "subtitle", "time": 2952.549, "timestamp": "00:49:12", "text": "みんなが Discord に参加して、いろいろやります"}, {"type": "subtitle", "time": 2955.67, "timestamp": "00:49:15", "text": "。"}, {"type": "subtitle", "time": 2957.99, "timestamp": "00:49:17", "text": "来年やってみようと思ったんです。 そういう時にこそ、"}, {"type": "subtitle", "time": 2961.109, "timestamp": "00:49:21", "text": "本当に必要なんです。"}, {"type": "chat", "time": 2961.66, "timestamp": "00:49:21", "author": "@Dragnozer", "avatar": "https://yt4.ggpht.com/S76Kh7cHFwpQNz9yjhQC88CHN2CaFRgcX6E1lcl7bEXBNP_DPdf1iSETHK2qlrHYkwo6BbPw=s64-c-k-c0x00ffffff-no-rj", "message": "happy birthday to you~ happy birthday dear joqnix~ may god bless you~ happy birthday to you~"}, {"type": "subtitle", "time": 2963.829, "timestamp": "00:49:23", "text": "だから、孤独感"}, {"type": "subtitle", "time": 2967.75, "timestamp": "00:49:27", "text": "や寂しさを感じないんです。 うん。 でも今年は、えーっと、"}, {"type": "subtitle", "time": 2970.79, "timestamp": "00:49:30", "text": "この誕生日を"}, {"type": "subtitle", "time": 2974.549, "timestamp": "00:49:34", "text": "もっと気楽なものにしたかったんです。"}, {"type": "subtitle", "time": 2976.15, "timestamp": "00:49:36", "text": "この「気楽な」という言葉を覚えて以来、ずっと"}, {"type": "subtitle", "time": 2978.76, "timestamp": "00:49:38", "text": "使っています。"}, {"type": "subtitle", "time": 2980.069, "timestamp": "00:49:40", "text": "[音楽]"}, {"type": "subtitle", "time": 2983.75, "timestamp": "00:49:43", "text": "でも、そうですね、"}, {"type": "subtitle", "time": 2987.349, "timestamp": "00:49:47", "text": "簡単に済ませたかったんです。"}, {"type": "subtitle", "time": 2989.51, "timestamp": "00:49:49", "text": "大切な人たちと過ごす時間を楽しんでいます"}, {"type": "subtitle", "time": 2995.91, "timestamp": "00:49:55", "text": "そうそう。 何てことだ。"}, {"type": "subtitle", "time": 2998.23,
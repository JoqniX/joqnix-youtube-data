[{"type": "subtitle", "time": 6247.35, "timestamp": "01:44:07", "text": "みんなに秘密にしていたので、お祝いしたり、祝福したりする人はあまりいませんでした。 私は「"}, {"type": "subtitle", "time": 6251.43, "timestamp": "01:44:11", "text": "ただの普通の仕事の日だし"}, {"type": "subtitle", "time": 6259.51, "timestamp": "01:44:19", "text": "そして、私はクリームケーキは必要ないと言えるでしょう"}, {"type": "subtitle", "time": 6262.07, "timestamp": "01:44:22", "text": "。 私の家族にはカップケーキ1個"}, {"type": "subtitle", "time": 6264.47, "timestamp": "01:44:24", "text": "か普通のプラムケーキ1個で"}, {"type": "subtitle", "time": 6266.709, "timestamp": "01:44:26", "text": "十分なのですが、"}, {"type": "subtitle", "time": 6270.31, "timestamp": "01:44:30", "text": "時々クリームケーキを買ってきてくれるんです。 うん。 あるいは、"}, {"type": "subtitle", "time": 6272.47, "timestamp": "01:44:32", "text": "私が「うん」って感じだった時。"}, {"type": "subtitle", "time": 6274.47, "timestamp": "01:44:34", "text": "そんなことを言うべきではない。"}, {"type": "subtitle", "time": 6278.07, "timestamp": "01:44:38", "text": "すみません、でもそうですね。 たくさんのこと。 でも、"}, {"type": "subtitle", "time": 6280.629, "timestamp": "01:44:40", "text": "ええ、ええと、"}]
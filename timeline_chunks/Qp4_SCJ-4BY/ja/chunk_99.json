[{"type": "subtitle", "time": 5940.47, "timestamp": "01:39:00", "text": "終わった。 えっと、後で綺麗にすることはいつでもできるし、とりあえず"}, {"type": "subtitle", "time": 5945.669, "timestamp": "01:39:05", "text": "今は存在させただけなんだ。 だから、"}, {"type": "subtitle", "time": 5947.59, "timestamp": "01:39:07", "text": "後でいつでも綺麗に仕上げることができる。 ええ、そうですね。 ということで、"}, {"type": "subtitle", "time": 5951.99, "timestamp": "01:39:11", "text": "今週から音楽の旅が始まります。今日は"}, {"type": "subtitle", "time": 5957.109, "timestamp": "01:39:17", "text": "私の誕生日で、少し時間を取って、えーと、なんて"}, {"type": "subtitle", "time": 5966.31, "timestamp": "01:39:26", "text": "言うんでしょう、"}, {"type": "subtitle", "time": 5969.43, "timestamp": "01:39:29", "text": "去年の誕生日に自分に約束したんです。えーと、"}, {"type": "subtitle", "time": 5972.07, "timestamp": "01:39:32", "text": "できるようになったら、"}, {"type": "subtitle", "time": 5977.669, "timestamp": "01:39:37", "text": "音楽に戻ってきて、すべてに取り組むって。それは"}, {"type": "subtitle", "time": 5980.39, "timestamp": "01:39:40", "text": "私の新年の抱負にも入っていました。"}, {"type": "subtitle", "time": 5983.03, "timestamp": "01:39:43", "text": "だから、私が音楽制作を学ぶ旅は、"}, {"type": "subtitle", "time": 5986.31, "timestamp": "01:39:46", "text": "今年から始まり、"}, {"type": "subtitle", "time": 5989.27, "timestamp": "01:39:49", "text": "日本に行くまで続きます。 つまり、3月までということですね。"}, {"type": "subtitle", "time": 5991.75, "timestamp": "01:39:51", "text": "時間はある。 うまくいけば、良いと呼べるだけのものをリリースできるといいな"}, {"type": "subtitle", "time": 5997.669, "timestamp": "01:39:57", "text": "。 耳が痛くなったり、そういうことにはならないよ"}]
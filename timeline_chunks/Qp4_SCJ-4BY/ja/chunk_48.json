[{"type": "subtitle", "time": 2889.67, "timestamp": "00:48:09", "text": "家族のお祝いとか全部終わった後に誕生日配信をすることもできます。"}, {"type": "subtitle", "time": 2904.23, "timestamp": "00:48:24", "text": "誕生日おめでとう、ワンちゃん。ちょっと"}, {"type": "subtitle", "time": 2907.349, "timestamp": "00:48:27", "text": "遅くなっちゃったけど。 大丈夫。 心配ない。 今日は丸一"}, {"type": "subtitle", "time": 2909.67, "timestamp": "00:48:29", "text": "日私の誕生日なので、皆さんにお祝いの言葉を贈っていただきたいです"}, {"type": "subtitle", "time": 2912.63, "timestamp": "00:48:32", "text": "。 だから大丈夫だよ。 心配しないことを心配しないでください"}, {"type": "subtitle", "time": 2917.99, "timestamp": "00:48:37", "text": "。 心配しないで。"}, {"type": "subtitle", "time": 2921.67, "timestamp": "00:48:41", "text": "去年の誕生日は、えーっと、"}, {"type": "subtitle", "time": 2925.51, "timestamp": "00:48:45", "text": "何て言うんだっけ、そんなことしなかったよ。"}, {"type": "subtitle", "time": 2927.349, "timestamp": "00:48:47", "text": "えっと、"}, {"type": "subtitle", "time": 2932.47, "timestamp": "00:48:52", "text": "カウントダウン配信ですよね？ そして"}, {"type": "subtitle", "time": 2934.87, "timestamp": "00:48:54", "text": "2023年の"}, {"type": "subtitle", "time": 2936.79, "timestamp": "00:48:56", "text": "誕生日には、えーと、"}]
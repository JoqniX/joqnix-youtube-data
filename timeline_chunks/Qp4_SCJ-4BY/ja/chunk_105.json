[{"type": "subtitle", "time": 6302.95, "timestamp": "01:45:02", "text": "今日は楽しかったです。 楽しかったです。"}, {"type": "subtitle", "time": 6304.87, "timestamp": "01:45:04", "text": "ありがとう。"}, {"type": "subtitle", "time": 6309.189, "timestamp": "01:45:09", "text": "それでは、これで終わりにします"}, {"type": "subtitle", "time": 6311.35, "timestamp": "01:45:11", "text": "。"}, {"type": "subtitle", "time": 6314.709, "timestamp": "01:45:14", "text": "えっと、ここで終わりにします。"}, {"type": "subtitle", "time": 6317.189, "timestamp": "01:45:17", "text": "そして、今日来てくださった皆さん、改めてありがとうございました"}, {"type": "subtitle", "time": 6320.39, "timestamp": "01:45:20", "text": "。 本当に、"}, {"type": "subtitle", "time": 6323.83, "timestamp": "01:45:23", "text": "本当に感謝しています。 えっと、"}, {"type": "subtitle", "time": 6326.229, "timestamp": "01:45:26", "text": "この"}, {"type": "subtitle", "time": 6328.79, "timestamp": "01:45:28", "text": "カウントダウン企画のために、私と一緒に夜を過ごしてくださってありがとうございます。"}, {"type": "subtitle", "time": 6330.95, "timestamp": "01:45:30", "text": "ほとんどのものがひどく"}, {"type": "subtitle", "time": 6334.629, "timestamp": "01:45:34", "text": "傷だらけだったのは知っています。"}, {"type": "subtitle", "time": 6336.709, "timestamp": "01:45:36", "text": "あまり準備をしなかった。"}, {"type": "subtitle", "time": 6340.629, "timestamp": "01:45:40", "text": "正直、この"}, {"type": "subtitle", "time": 6342.39, "timestamp": "01:45:42", "text": "カウントダウン配信はやりたくなかったんです。 ちゃんとした"}, {"type": "subtitle", "time": 6344.47, "timestamp": "01:45:44", "text": "誕生日配信をしたかっただけなんです。 ストリームは1つだけで"}, {"type": "subtitle", "time": 6347.189, "timestamp": "01:45:47", "text": "十分です。 むしろ、私は"}, {"type": "subtitle", "time": 6349.27, "timestamp": "01:45:49", "text": "それを二つに分けています。"}, {"type": "subtitle", "time": 6352.95, "timestamp": "01:45:52", "text": "でも、たとえ直前だったとしても"}, {"type": "subtitle", "time": 6356.629, "timestamp": "01:45:56", "text": "、来てくれてありがとう"}]
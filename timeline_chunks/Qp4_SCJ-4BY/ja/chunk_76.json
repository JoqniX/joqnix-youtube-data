[{"type": "subtitle", "time": 4566.31, "timestamp": "01:16:06", "text": "私はバニーガールを歌えます。 そうすべきかどうか分からない"}, {"type": "subtitle", "time": 4568.95, "timestamp": "01:16:08", "text": "。 わからない。"}, {"type": "subtitle", "time": 4571.03, "timestamp": "01:16:11", "text": "えーっと、"}, {"type": "subtitle", "time": 4573.669, "timestamp": "01:16:13", "text": "しばらく歌ってないけど、"}, {"type": "subtitle", "time": 4576.31, "timestamp": "01:16:16", "text": "この曲は歌ってみます。"}, {"type": "subtitle", "time": 4595.43, "timestamp": "01:16:35", "text": "日本の歌だけを歌っているという事実が大好きです。 だって、それが"}, {"type": "subtitle", "time": 4605.189, "timestamp": "01:16:45", "text": "でも将来的には、もっと"}, {"type": "subtitle", "time": 4608.39, "timestamp": "01:16:48", "text": "新しいものを学びたいと思っています。 まあ、そうですね。 こんにちは。 えっと、"}, {"type": "subtitle", "time": 4611.99, "timestamp": "01:16:51", "text": "これを最後から2番目の曲にしましょう。 えっと、もう"}, {"type": "subtitle", "time": 4615.669, "timestamp": "01:16:55", "text": "一曲歌おうかな。"}]
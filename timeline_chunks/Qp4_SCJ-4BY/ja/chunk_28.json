[{"type": "subtitle", "time": 1697.99, "timestamp": "00:28:17", "text": "。 えっと、あの"}, {"type": "subtitle", "time": 1700.31, "timestamp": "00:28:20", "text": "ショーはしばらく歌ってないな。 だから私は"}, {"type": "subtitle", "time": 1702.47, "timestamp": "00:28:22", "text": "「ああ、このショーは知ってる。"}, {"type": "subtitle", "time": 1705.19, "timestamp": "00:28:25", "text": "ずっと前に習ったことがある。でも、今でも上手くできるわけじゃない"}, {"type": "subtitle", "time": 1709.75, "timestamp": "00:28:29", "text": "。ジッシュが"}, {"type": "subtitle", "time": 1711.99, "timestamp": "00:28:31", "text": "セリフを間違えたり、いろいろと間違えているのを見て、そう思わざるを得なかった」と思ったんです。"}, {"type": "subtitle", "time": 1715.269, "timestamp": "00:28:35", "text": "まあ、そうですね。"}, {"type": "chat", "time": 1719.136, "timestamp": "00:28:39", "author": "@aniketwande4403", "avatar": "https://yt4.ggpht.com/ytc/AIdro_m_Z2M4vVHkWPdw0fzo-i-Dy4Pm4-b-bs22Utnn5zkWBHY=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/finger-red-number-oneUCkszU2WH9gy1mb0dV-11UJg/finger-red-number-oneUCkszU2WH9gy1mb0dV-11UJg/finger-red-number-one"}, {"type": "subtitle", "time": 1721.51, "timestamp": "00:28:41", "text": "つまり、11分です。 ああ、神様。"}, {"type": "subtitle", "time": 1723.669, "timestamp": "00:28:43", "text": "[音楽]"}, {"type": "subtitle", "time": 1729.51, "timestamp": "00:28:49", "text": "僕の"}, {"type": "subtitle", "time": 1734.95, "timestamp": "00:28:54", "text": "短いキックを聴いてくれてありがとう。 えっと、こんにちは。"}, {"type": "subtitle", "time": 1737.83, "timestamp": "00:28:57", "text": "ああ、大変だ。"}]
[{"type": "subtitle", "time": 841.67, "timestamp": "00:14:01", "text": "言うと、おとり作戦をすることもできたんだ"}, {"type": "subtitle", "time": 847.269, "timestamp": "00:14:07", "text": "けど、もう土壇場なんだ。 大丈夫です。"}, {"type": "subtitle", "time": 850.71, "timestamp": "00:14:10", "text": "おそらく大丈夫でしょう。"}, {"type": "subtitle", "time": 853.59, "timestamp": "00:14:13", "text": "えっと、そうじゃなくて"}, {"type": "subtitle", "time": 878.79, "timestamp": "00:14:38", "text": "、彼らにとっては12です。"}, {"type": "subtitle", "time": 879.91, "timestamp": "00:14:39", "text": "おお。"}, {"type": "subtitle", "time": 883.829, "timestamp": "00:14:43", "text": "ええ、彼らにとっては12です。 つまり、"}, {"type": "subtitle", "time": 887.03, "timestamp": "00:14:47", "text": "彼らにとっては12分間の高速レースとなる。 ええ、そうですね。 こんにちは。 えっと、"}, {"type": "subtitle", "time": 890.389, "timestamp": "00:14:50", "text": "この曲を歌わせてください。 それは、"}, {"type": "subtitle", "time": 893.269, "timestamp": "00:14:53", "text": "私のお気に入りの一つです。 ぬいぐるみ。 私は"}, {"type": "subtitle", "time": 896.23, "timestamp": "00:14:56", "text": "これをしばらく前から学びたいと思っていました"}, {"type": "subtitle", "time": 899.11, "timestamp": "00:14:59", "text": "。 もし知っていたら、もし知っていたら、もし知っていたら、えっと、"}]
[{"type": "subtitle", "time": 273.99, "timestamp": "00:04:33", "text": "H."}, {"type": "subtitle", "time": 277.51, "timestamp": "00:04:37", "text": "みなさん、こんにちは。 待って、待って、待って、待って。"}, {"type": "subtitle", "time": 280.55, "timestamp": "00:04:40", "text": "なぜ私は小さいのだろう？"}, {"type": "subtitle", "time": 282.31, "timestamp": "00:04:42", "text": "M."}, {"type": "subtitle", "time": 286.23, "timestamp": "00:04:46", "text": "なぜ私はこんなに小さいの？"}, {"type": "subtitle", "time": 295.51, "timestamp": "00:04:55", "text": "ああ、"}, {"type": "subtitle", "time": 298.87, "timestamp": "00:04:58", "text": "私のモデルが動作していません。"}]
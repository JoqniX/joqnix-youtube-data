[{"type": "subtitle", "time": 1380.39, "timestamp": "00:23:00", "text": "我已經很久沒唱這首歌了。我"}, {"type": "subtitle", "time": 1384.71, "timestamp": "00:23:04", "text": "不確定自己有沒有能力把這首歌唱"}, {"type": "subtitle", "time": 1387.83, "timestamp": "00:23:07", "text": "得好。嗯，生日快樂歌。還沒有。"}, {"type": "subtitle", "time": 1390.87, "timestamp": "00:23:10", "text": "我們必須得到它。我們現在必須達到這個"}, {"type": "subtitle", "time": 1395.909, "timestamp": "00:23:15", "text": "呃，"}, {"type": "subtitle", "time": 1400.149, "timestamp": "00:23:20", "text": "不，沒有生日快樂之類的東西。等等，"}, {"type": "subtitle", "time": 1402.789, "timestamp": "00:23:22", "text": "我是說明天我會進行一次正式直播。"}, {"type": "subtitle", "time": 1405.669, "timestamp": "00:23:25", "text": "這更像是卡其布，也像是"}, {"type": "subtitle", "time": 1408.63, "timestamp": "00:23:28", "text": "我生日倒數之類的東西。"}, {"type": "subtitle", "time": 1412.39, "timestamp": "00:23:32", "text": "嗯，是的。是的。明天我要"}, {"type": "subtitle", "time": 1415.51, "timestamp": "00:23:35", "text": "讀的那本書就像是《是啊》。嗯，"}, {"type": "subtitle", "time": 1417.029, "timestamp": "00:23:37", "text": "明天那期我會讀"}, {"type": "subtitle", "time": 1420.23, "timestamp": "00:23:40", "text": "生日祝福。再見。各位，如果"}, {"type": "subtitle", "time": 1422.31, "timestamp": "00:23:42", "text": "你在 Twitch 和 Kick 上，就會在"}, {"type": "subtitle", "time": 1425.99, "timestamp": "00:23:45", "text": "置頂評論裡看到。嗯，是的，置頂"}, {"type": "subtitle", "time": 1428.39, "timestamp": "00:23:48", "text": "公告或評論。請點擊連結。"}, {"type": "subtitle", "time": 1430.23, "timestamp": "00:23:50", "text": "你可以在生日卡上寫上你的祝福之類的東西"}, {"type": "subtitle", "time": 1432.71, "timestamp": "00:23:52", "text": "，就是那個板子"}, {"type": "subtitle", "time": 1434.23, "timestamp": "00:23:54", "text": "。  嗯，是的。  呃，"}]
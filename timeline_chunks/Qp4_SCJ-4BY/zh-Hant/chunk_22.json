[{"type": "subtitle", "time": 1324.71, "timestamp": "00:22:04", "text": "我是明星。你忘了？我是明星。  不，我是一顆星座。"}, {"type": "subtitle", "time": 1327.27, "timestamp": "00:22:07", "text": "我由星星組成。是的。"}, {"type": "subtitle", "time": 1330.95, "timestamp": "00:22:10", "text": "但我的成名日將會是…"}, {"type": "subtitle", "time": 1333.43, "timestamp": "00:22:13", "text": "明天才是正式的"}, {"type": "subtitle", "time": 1335.27, "timestamp": "00:22:15", "text": "慶祝活動。但我們還有大約70"}, {"type": "subtitle", "time": 1340.07, "timestamp": "00:22:20", "text": "分鐘。你好。嗯，呃，不過是的，我大概還會再待"}, {"type": "subtitle", "time": 1344.23, "timestamp": "00:22:24", "text": "一年。"}, {"type": "subtitle", "time": 1348.149, "timestamp": "00:22:28", "text": "我想，我的星星們又將帶我走完一年了。我不知道。"}, {"type": "subtitle", "time": 1350.63, "timestamp": "00:22:30", "text": "但是，是的，我意識到我已經"}, {"type": "subtitle", "time": 1352.47, "timestamp": "00:22:32", "text": "夠大了。"}, {"type": "subtitle", "time": 1355.43, "timestamp": "00:22:35", "text": "我年紀越來越大了。"}, {"type": "subtitle", "time": 1361.51, "timestamp": "00:22:41", "text": "好的。你好。"}, {"type": "subtitle", "time": 1365.11, "timestamp": "00:22:45", "text": "所以，呃，我不知道我該不該……呃，我"}, {"type": "subtitle", "time": 1369.029, "timestamp": "00:22:49", "text": "不知道我還能唱什麼歌"}, {"type": "subtitle", "time": 1371.19, "timestamp": "00:22:51", "text": "？"}, {"type": "subtitle", "time": 1374.71, "timestamp": "00:22:54", "text": "呃，就像唱這首歌一樣。"}]
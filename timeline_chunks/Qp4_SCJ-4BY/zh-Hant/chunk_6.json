[{"type": "subtitle", "time": 360.629, "timestamp": "00:06:00", "text": "去年一樣，做一個普通的生日直播。"}, {"type": "subtitle", "time": 362.31, "timestamp": "00:06:02", "text": "所以，我想換個方式慶祝，因為"}, {"type": "subtitle", "time": 364.23, "timestamp": "00:06:04", "text": "這將是我最後一次在"}, {"type": "subtitle", "time": 367.189, "timestamp": "00:06:07", "text": "印度過生日了，"}, {"type": "subtitle", "time": 369.59, "timestamp": "00:06:09", "text": "明年我就要去日本了。所以，誰"}, {"type": "subtitle", "time": 373.83, "timestamp": "00:06:13", "text": "知道我是否能夠……嗯……我是否能夠……哦，"}, {"type": "subtitle", "time": 381.189, "timestamp": "00:06:21", "text": "不。不，不，不是那個。"}, {"type": "subtitle", "time": 383.67, "timestamp": "00:06:23", "text": "對不起。"}, {"type": "subtitle", "time": 386.469, "timestamp": "00:06:26", "text": "等等，什麼？抱歉，圍巾有點礙眼。一"}, {"type": "subtitle", "time": 389.029, "timestamp": "00:06:29", "text": "秒鐘。所以，我們會在"}, {"type": "subtitle", "time": 393.189, "timestamp": "00:06:33", "text": "倒數計時開始前 30 分鐘做 koka 的事情。呃，"}, {"type": "subtitle", "time": 395.99, "timestamp": "00:06:35", "text": "我稍後會加入倒數計時。 1"}, {"type": "subtitle", "time": 398.55, "timestamp": "00:06:38", "text": "秒。 1秒。別在意這個。我"}, {"type": "subtitle", "time": 400.87, "timestamp": "00:06:40", "text": "不介意。呃，不好意思，"}, {"type": "subtitle", "time": 403.51, "timestamp": "00:06:43", "text": "圍巾有點礙眼。"}, {"type": "subtitle", "time": 412.15, "timestamp": "00:06:52", "text": "我今天只有這條圍巾。嗯，是的"}, {"type": "subtitle", "time": 414.95, "timestamp": "00:06:54", "text": "。呃，真抱歉弄丟"}, {"type": "subtitle", "time": 419.909, "timestamp": "00:06:59", "text": "圍巾了。呃，米娜。呃，稍等一下。"}]
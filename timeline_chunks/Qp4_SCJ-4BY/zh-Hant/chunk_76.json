[{"type": "subtitle", "time": 4573.669, "timestamp": "01:16:13", "text": "我能唱什麼歌？  是的，寶貝。太多了。嗯？  [音樂] 我對有些歌沒有信心，所以不想"}, {"type": "subtitle", "time": 4576.31, "timestamp": "01:16:16", "text": "唱那些"}, {"type": "subtitle", "time": 4595.43, "timestamp": "01:16:35", "text": "歌。  願你夢想成真，前程似錦。謝謝。這對"}, {"type": "subtitle", "time": 4605.189, "timestamp": "01:16:45", "text": "認識兔"}, {"type": "subtitle", "time": 4608.39, "timestamp": "01:16:48", "text": "女郎。  呃，我會唱《兔女郎》。我不知道我是否應該這樣做。我不知道。  呃，我好久沒唱了，但我會試著唱"}, {"type": "subtitle", "time": 4611.99, "timestamp": "01:16:51", "text": "這首歌。  赤崎。  兔子。  你好。下"}]
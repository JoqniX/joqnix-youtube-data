[{"type": "subtitle", "time": 540.47, "timestamp": "00:09:00", "text": "不過是的。我剛剛意識到我還"}, {"type": "subtitle", "time": 543.829, "timestamp": "00:09:03", "text": "沒有發推文說我正在直播。"}, {"type": "subtitle", "time": 546.55, "timestamp": "00:09:06", "text": "好的，還剩2分鐘。所以，"}, {"type": "subtitle", "time": 551.03, "timestamp": "00:09:11", "text": "我們這就快速做一下 kaka 的事。嗯，在"}, {"type": "subtitle", "time": 553.91, "timestamp": "00:09:13", "text": "我出生之後，比如過了12點，過了"}, {"type": "subtitle", "time": 557.19, "timestamp": "00:09:17", "text": "12點，也就是我的"}, {"type": "subtitle", "time": 559.99, "timestamp": "00:09:19", "text": "生日之後，"}, {"type": "subtitle", "time": 563.91, "timestamp": "00:09:23", "text": "如果是一輛車，我還會繼續唱一會兒歌。我唱歌"}, {"type": "subtitle", "time": 567.43, "timestamp": "00:09:27", "text": "不好，也不擅長唱歌什麼的，但我會"}, {"type": "subtitle", "time": 571.59, "timestamp": "00:09:31", "text": "盡力而為。好的。嗯，"}, {"type": "subtitle", "time": 573.67, "timestamp": "00:09:33", "text": "但"}, {"type": "subtitle", "time": 578.389, "timestamp": "00:09:38", "text": "下游它們就平靜下來了。"}, {"type": "subtitle", "time": 581.67, "timestamp": "00:09:41", "text": "好吧，那我就這麼做。擦傷是"}, {"type": "subtitle", "time": 593.11, "timestamp": "00:09:53", "text": "好的，還有30分鐘。哦，是的。再見。  是的。再見。是的。"}, {"type": "subtitle", "time": 596.79, "timestamp": "00:09:56", "text": "再見。  好的。  會比"}]
[{"type": "subtitle", "time": 903.91, "timestamp": "00:15:03", "text": "你知道，嗯，"}, {"type": "subtitle", "time": 909.829, "timestamp": "00:15:09", "text": "我會唱歌，嗯，我會唱歌，嗯，這首歌，"}, {"type": "subtitle", "time": 912.71, "timestamp": "00:15:12", "text": "我現在會唱三首歌，"}, {"type": "subtitle", "time": 916.55, "timestamp": "00:15:16", "text": "我想這應該足夠了，嗯，嗯，"}, {"type": "subtitle", "time": 923.189, "timestamp": "00:15:23", "text": "讓我喝點水，"}, {"type": "subtitle", "time": 944.71, "timestamp": "00:15:44", "text": "好的。你好。三、二、一。讓我來演奏這首歌"}, {"type": "subtitle", "time": 947.67, "timestamp": "00:15:47", "text": "。"}, {"type": "subtitle", "time": 950.31, "timestamp": "00:15:50", "text": "如果你能聽到的話請告訴我。好的。  你好"}]
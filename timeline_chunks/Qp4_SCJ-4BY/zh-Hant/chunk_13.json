[{"type": "subtitle", "time": 781.35, "timestamp": "00:13:01", "text": "。時候到了。我，我，我，"}, {"type": "subtitle", "time": 784.23, "timestamp": "00:13:04", "text": "我們只有27分鐘了。我"}, {"type": "subtitle", "time": 787.509, "timestamp": "00:13:07", "text": "很快就會唱首歌什麼的。  好的。你好。  你好。我會搜查你"}, {"type": "subtitle", "time": 795.509, "timestamp": "00:13:15", "text": "。嗯，"}, {"type": "subtitle", "time": 797.19, "timestamp": "00:13:17", "text": "好的。你知道嗎？我"}, {"type": "subtitle", "time": 799.43, "timestamp": "00:13:19", "text": "其實就把它放在這裡，"}, {"type": "subtitle", "time": 803.35, "timestamp": "00:13:23", "text": "嗯，"}, {"type": "subtitle", "time": 805.43, "timestamp": "00:13:25", "text": "然後……好吧，就是這樣。"}, {"type": "subtitle", "time": 818.31, "timestamp": "00:13:38", "text": "所以，呃，你想要一個"}, {"type": "subtitle", "time": 819.829, "timestamp": "00:13:39", "text": "背景嗎？  嗯，我就這麼做吧。是的，"}, {"type": "subtitle", "time": 823.35, "timestamp": "00:13:43", "text": "我"}, {"type": "subtitle", "time": 825.509, "timestamp": "00:13:45", "text": "沒有合適的……嗯……是的，"}, {"type": "subtitle", "time": 829.67, "timestamp": "00:13:49", "text": "我真的沒有合適的……呃……設備，呃……比如背景音樂之類的東西。但沒關係。嗯，老實說，我本來可以搞個"}, {"type": "subtitle", "time": 836.069, "timestamp": "00:13:56", "text": "迪斯可之類的，但呃，"}]
[{"type": "subtitle", "time": 1861.19, "timestamp": "00:31:01", "text": "意識到，"}, {"type": "subtitle", "time": 1867.59, "timestamp": "00:31:07", "text": "但是2025年的這個生日，"}, {"type": "subtitle", "time": 1869.83, "timestamp": "00:31:09", "text": "實際上，"}, {"type": "subtitle", "time": 1872.71, "timestamp": "00:31:12", "text": "我不知道該怎麼形容，感覺既"}, {"type": "subtitle", "time": 1875.35, "timestamp": "00:31:15", "text": "開心又"}, {"type": "subtitle", "time": 1878.31, "timestamp": "00:31:18", "text": "難過，因為，"}, {"type": "subtitle", "time": 1881.43, "timestamp": "00:31:21", "text": "嗯，這將是"}, {"type": "subtitle", "time": 1885.43, "timestamp": "00:31:25", "text": "我最後一次和家人一起慶祝生日了，"}, {"type": "subtitle", "time": 1892.31, "timestamp": "00:31:32", "text": "嗯，還有家裡的所有人，"}, {"type": "subtitle", "time": 1897.029, "timestamp": "00:31:37", "text": "嗯，因為明年我就要去日本了，我會一個人"}, {"type": "subtitle", "time": 1908.63, "timestamp": "00:31:48", "text": "過生日，也許真的會非常孤單"}, {"type": "subtitle", "time": 1911.909, "timestamp": "00:31:51", "text": "但是，因為我的現實"}, {"type": "subtitle", "time": 1914.389, "timestamp": "00:31:54", "text": "生日和我的虛擬主播生日是"}, {"type": "subtitle", "time": 1917.509, "timestamp": "00:31:57", "text": "同一天，"}]
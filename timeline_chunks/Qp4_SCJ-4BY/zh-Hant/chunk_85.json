[{"type": "subtitle", "time": 5101.99, "timestamp": "01:25:01", "text": "[音樂] [掌聲]"}, {"type": "subtitle", "time": 5105.03, "timestamp": "01:25:05", "text": "我剛從一個夢中醒來，夢裡你我道別，"}, {"type": "subtitle", "time": 5111.59, "timestamp": "01:25:11", "text": "我"}, {"type": "subtitle", "time": 5117.43, "timestamp": "01:25:17", "text": "不知道這一切意味著什麼，但既然我意識到我們要去那裡，"}, {"type": "subtitle", "time": 5125.669, "timestamp": "01:25:25", "text": "我就不會"}, {"type": "subtitle", "time": 5127.99, "timestamp": "01:25:27", "text": "遵守"}, {"type": "subtitle", "time": 5132.47, "timestamp": "01:25:32", "text": "任何人的承諾，所以熱度。熱。熱。  [音樂] [音樂] 熱浪。  熱。  [音樂]"}, {"type": "subtitle", "time": 5142.709, "timestamp": "01:25:42", "text": "如果愛情即將結束，我希望"}, {"type": "subtitle", "time": 5151.43, "timestamp": "01:25:51", "text": "迷失在我們"}]
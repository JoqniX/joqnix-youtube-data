[{"type": "subtitle", "time": 605.509, "timestamp": "00:10:05", "text": "之前更早。今天是我的生日。"}, {"type": "subtitle", "time": 607.59, "timestamp": "00:10:07", "text": "說實話，呃，我不知道該怎麼辦，我真的"}, {"type": "subtitle", "time": 609.509, "timestamp": "00:10:09", "text": "不知道。說實話，感覺"}, {"type": "subtitle", "time": 613.03, "timestamp": "00:10:13", "text": "不像是我的生日。"}, {"type": "subtitle", "time": 615.19, "timestamp": "00:10:15", "text": "讓我來讀一下今天的名言。你"}, {"type": "subtitle", "time": 616.949, "timestamp": "00:10:16", "text": "無法控制風暴，但你可以"}, {"type": "subtitle", "time": 619.11, "timestamp": "00:10:19", "text": "控制如何掌舵。所以請"}, {"type": "subtitle", "time": 621.269, "timestamp": "00:10:21", "text": "記住，即使在最"}, {"type": "subtitle", "time": 622.949, "timestamp": "00:10:22", "text": "糟糕的情況下，你仍然會有"}, {"type": "subtitle", "time": 625.11, "timestamp": "00:10:25", "text": "選擇，並且"}, {"type": "subtitle", "time": 628.63, "timestamp": "00:10:28", "text": "可以進行一些小的糾正措施，直到情況好轉"}, {"type": "subtitle", "time": 630.71, "timestamp": "00:10:30", "text": "。"}, {"type": "subtitle", "time": 634.23, "timestamp": "00:10:34", "text": "感謝Hunter Kings送的精美賀卡"}, {"type": "subtitle", "time": 638.069, "timestamp": "00:10:38", "text": "。謝謝。"}, {"type": "subtitle", "time": 640.399, "timestamp": "00:10:40", "text": "謝謝。 嗯……"}, {"type": "subtitle", "time": 643.279, "timestamp": "00:10:43", "text": "嗯…… 等等，我找不到我的……哦，找到了。  呃，我找不到我的生日"}]
[{"type": "subtitle", "time": 673.99, "timestamp": "00:11:13", "text": "我去年做了什麼？"}, {"type": "subtitle", "time": 677.11, "timestamp": "00:11:17", "text": "接下來討論。你去年做了什麼？  我找不到我的生日。"}, {"type": "subtitle", "time": 684.71, "timestamp": "00:11:24", "text": "等等，我不能……哦，不。不，"}, {"type": "subtitle", "time": 687.19, "timestamp": "00:11:27", "text": "等等。"}, {"type": "subtitle", "time": 691.829, "timestamp": "00:11:31", "text": "我真的不能等等，米娜。"}, {"type": "subtitle", "time": 694.63, "timestamp": "00:11:34", "text": "我竟然找不到我的生日帽。  我的天啊。"}, {"type": "subtitle", "time": 697.99, "timestamp": "00:11:37", "text": "不，別這樣對我。嗯，我會做"}, {"type": "subtitle", "time": 702.71, "timestamp": "00:11:42", "text": "縮圖裡的那個。  我會做縮圖裡的那個。  啊，"}, {"type": "subtitle", "time": 706.15, "timestamp": "00:11:46", "text": "我現在就把它更正一下。"}]
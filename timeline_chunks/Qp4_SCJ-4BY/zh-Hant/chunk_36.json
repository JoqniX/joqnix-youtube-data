[{"type": "subtitle", "time": 2174.71, "timestamp": "00:36:14", "text": "感謝各位到場支持。"}, {"type": "subtitle", "time": 2177.349, "timestamp": "00:36:17", "text": "意義重大。"}, {"type": "subtitle", "time": 2180.55, "timestamp": "00:36:20", "text": "我知道這是最後的機會了。我知道上面有"}, {"type": "subtitle", "time": 2183.91, "timestamp": "00:36:23", "text": "很多刮痕。  現在"}, {"type": "subtitle", "time": 2187.19, "timestamp": "00:36:27", "text": "發生的事情太多了"}, {"type": "subtitle", "time": 2189.91, "timestamp": "00:36:29", "text": "。不過，"}, {"type": "subtitle", "time": 2193.91, "timestamp": "00:36:33", "text": "呃，其實還是要謝謝米娜過來"}, {"type": "subtitle", "time": 2196.31, "timestamp": "00:36:36", "text": "。  正確的"}, {"type": "subtitle", "time": 2198.79, "timestamp": "00:36:38", "text": "。呃，該怎麼說"}, {"type": "subtitle", "time": 2200.47, "timestamp": "00:36:40", "text": "呢？  等等，"}, {"type": "subtitle", "time": 2202.71, "timestamp": "00:36:42", "text": "夥計。"}, {"type": "subtitle", "time": 2205.19, "timestamp": "00:36:45", "text": "我應該把它貼在我的瀏海上。  正確的。  好了。"}, {"type": "subtitle", "time": 2212.069, "timestamp": "00:36:52", "text": "它還在動嗎？好的。"}, {"type": "subtitle", "time": 2214.79, "timestamp": "00:36:54", "text": "我不知道。我無話可說了。我的大腦一片"}, {"type": "subtitle", "time": 2216.63, "timestamp": "00:36:56", "text": "空白。"}, {"type": "subtitle", "time": 2218.87, "timestamp": "00:36:58", "text": "好像"}]
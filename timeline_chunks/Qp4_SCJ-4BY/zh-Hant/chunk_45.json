[{"type": "subtitle", "time": 2700.87, "timestamp": "00:45:00", "text": "您，我再次"}, {"type": "subtitle", "time": 2706.63, "timestamp": "00:45:06", "text": "提醒一下，如果您還沒有"}, {"type": "subtitle", "time": 2708.95, "timestamp": "00:45:08", "text": "寫下生日祝福，請隨時將"}, {"type": "subtitle", "time": 2713.349, "timestamp": "00:45:13", "text": "其寫在留言卡上。呃，"}, {"type": "subtitle", "time": 2716.069, "timestamp": "00:45:16", "text": "連結就在這裡，我直接把"}, {"type": "subtitle", "time": 2721.99, "timestamp": "00:45:21", "text": "連結寄給你吧。你可以在這裡寫下生日"}, {"type": "subtitle", "time": 2727.19, "timestamp": "00:45:27", "text": "祝福。我會在"}, {"type": "subtitle", "time": 2729.91, "timestamp": "00:45:29", "text": "明天的"}, {"type": "subtitle", "time": 2737.829, "timestamp": "00:45:37", "text": "我會把它放在這裡，你們都可以看到"}, {"type": "subtitle", "time": 2739.589, "timestamp": "00:45:39", "text": "。"}, {"type": "subtitle", "time": 2742.39, "timestamp": "00:45:42", "text": "你好。"}, {"type": "chat", "time": 2742.9, "timestamp": "00:45:42", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "You can write birthday wishes here i'll be reading it on tomorrow's stream nee - https://recocards.com/board/happy-bir..."}, {"type": "subtitle", "time": 2748.309, "timestamp": "00:45:48", "text": "我今天是不是做好多袖口了？"}, {"type": "subtitle", "time": 2750.47, "timestamp": "00:45:50", "text": "對，準備工作大概就是這樣"}, {"type": "subtitle", "time": 2756.79, "timestamp": "00:45:56", "text": "既然今天是我的"}, {"type": "subtitle", "time": 2759.51, "timestamp": "00:45:59", "text": "生日，我就來跟大家介紹一下"}]
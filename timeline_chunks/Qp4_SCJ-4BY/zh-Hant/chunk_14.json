[{"type": "subtitle", "time": 847.269, "timestamp": "00:14:07", "text": "時間太緊了。沒關係。應該沒問題。  嗯，不是那個意思。是的，對他們來說是"}, {"type": "subtitle", "time": 878.79, "timestamp": "00:14:38", "text": "12。  哇。  是的，對他們來說是12。所以，對他們來說，這是快速的 12。是的。"}, {"type": "subtitle", "time": 879.91, "timestamp": "00:14:39", "text": "你好。呃，"}, {"type": "subtitle", "time": 887.03, "timestamp": "00:14:47", "text": "讓我來唱"}, {"type": "subtitle", "time": 890.389, "timestamp": "00:14:50", "text": "這首歌。嗯，這是我最喜歡的"}, {"type": "subtitle", "time": 893.269, "timestamp": "00:14:53", "text": "之一。豪華的。我一直"}, {"type": "subtitle", "time": 896.23, "timestamp": "00:14:56", "text": "想學，我已經學了"}, {"type": "subtitle", "time": 899.11, "timestamp": "00:14:59", "text": "一段時間了。如果你知道，如果你知道，如果"}]
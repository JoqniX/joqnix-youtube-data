[{"type": "subtitle", "time": 961.829, "timestamp": "00:16:01", "text": "不。你遇到什麼問題了？你為什麼這麼……"}, {"type": "subtitle", "time": 964.31, "timestamp": "00:16:04", "text": "我的天。我應該"}, {"type": "subtitle", "time": 966.71, "timestamp": "00:16:06", "text": "一個小時前就準備好的。我當時就想，"}, {"type": "subtitle", "time": 971.35, "timestamp": "00:16:11", "text": "「莫，我還是走吧。沒關係。"}, {"type": "subtitle", "time": 975.749, "timestamp": "00:16:15", "text": "反正也沒人會祝福我。」嗯"}, {"type": "subtitle", "time": 977.829, "timestamp": "00:16:17", "text": "，"}, {"type": "subtitle", "time": 980.79, "timestamp": "00:16:20", "text": "我會等的。它卡住了。我的天啊。別"}, {"type": "subtitle", "time": 987.509, "timestamp": "00:16:27", "text": "，成功了。好的。你好。讓我，讓我，讓"}, {"type": "subtitle", "time": 992.629, "timestamp": "00:16:32", "text": "我去發現真實。"}, {"type": "subtitle", "time": 996.15, "timestamp": "00:16:36", "text": "好的。你好。三、二、一。希望你能"}, {"type": "subtitle", "time": 1010.949, "timestamp": "00:16:50", "text": "我數到了三、二、"}, {"type": "subtitle", "time": 1019.03, "timestamp": "00:16:59", "text": "別介意我難聽的歌聲，但我會盡力"}]
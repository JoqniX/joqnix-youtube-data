[{"type": "subtitle", "time": 2045.43, "timestamp": "00:34:05", "text": "生日祝福板上寫下祝福的朋友們，如果你還"}, {"type": "subtitle", "time": 2047.029, "timestamp": "00:34:07", "text": "沒有留言，可以在"}, {"type": "subtitle", "time": 2048.869, "timestamp": "00:34:08", "text": "YouTube、Twitch和Kick的描述裡找到，也可以"}, {"type": "subtitle", "time": 2050.95, "timestamp": "00:34:10", "text": "在公告"}, {"type": "subtitle", "time": 2055.43, "timestamp": "00:34:15", "text": "信息或置頂評論裡找到。好的。你好。  嗯，是的。呃，"}, {"type": "subtitle", "time": 2059.03, "timestamp": "00:34:19", "text": "我不知道。感覺……嗯，是的。"}, {"type": "subtitle", "time": 2082.869, "timestamp": "00:34:42", "text": "再見。  我不擅長表達。  我不擅長言語。我不太擅長表達。我剛才說了嗎？  我應該說的是人聲，而不是鳥鳴。  我的天啊。  由我們製作。"}, {"type": "subtitle", "time": 2086.47, "timestamp": "00:34:46", "text": "你好。嗯，是的，明天。呃，如果非要"}, {"type": "subtitle", "time": 2088.31, "timestamp": "00:34:48", "text": "我回答的話，那就是明天。天哪，還剩五分鐘"}, {"type": "subtitle", "time": 2091.51, "timestamp": "00:34:51", "text": "。再見。呃，"}, {"type": "subtitle", "time": 2094.149, "timestamp": "00:34:54", "text": "我的天哪。  哦"}, {"type": "subtitle", "time": 2095.909, "timestamp": "00:34:55", "text": "，等等。我得準備"}, {"type": "chat", "time": 2097.211, "timestamp": "00:34:57", "author": "@MRTEDDY-1401", "avatar": "https://yt4.ggpht.com/v510NQZUUxn-kYA-mj4sLnvLBE_ct_gKXcimoMlgGatkEuNTMrDun0C850mLX7-pcFASlbfp7ys=s64-c-k-c0x00ffffff-no-rj", "message": "you said words i think"}, {"type": "subtitle", "time": 2097.829, "timestamp": "00:34:57", "text": "生日快樂歌，對吧？我的天啊，"}]
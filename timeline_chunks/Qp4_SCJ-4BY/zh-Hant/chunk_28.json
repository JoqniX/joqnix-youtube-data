[{"type": "subtitle", "time": 1697.99, "timestamp": "00:28:17", "text": "好久不見了。我好久沒唱"}, {"type": "subtitle", "time": 1700.31, "timestamp": "00:28:20", "text": "那首歌了。所以我就想，"}, {"type": "subtitle", "time": 1702.47, "timestamp": "00:28:22", "text": "「哦，我知道這個節目。我"}, {"type": "subtitle", "time": 1705.19, "timestamp": "00:28:25", "text": "很久以前就學過了。但我現在不"}, {"type": "subtitle", "time": 1709.75, "timestamp": "00:28:29", "text": "擅長了。我看到吉什在這裡把"}, {"type": "subtitle", "time": 1711.99, "timestamp": "00:28:31", "text": "台詞念錯什麼的。」是的"}, {"type": "subtitle", "time": 1715.269, "timestamp": "00:28:35", "text": "。"}, {"type": "chat", "time": 1719.136, "timestamp": "00:28:39", "author": "@aniketwande4403", "avatar": "https://yt4.ggpht.com/ytc/AIdro_m_Z2M4vVHkWPdw0fzo-i-Dy4Pm4-b-bs22Utnn5zkWBHY=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/finger-red-number-oneUCkszU2WH9gy1mb0dV-11UJg/finger-red-number-oneUCkszU2WH9gy1mb0dV-11UJg/finger-red-number-one"}, {"type": "subtitle", "time": 1721.51, "timestamp": "00:28:41", "text": "所以，時間是11分鐘。我的天哪。"}, {"type": "subtitle", "time": 1723.669, "timestamp": "00:28:43", "text": "[音樂]"}, {"type": "subtitle", "time": 1729.51, "timestamp": "00:28:49", "text": "謝謝你聽我這段"}, {"type": "subtitle", "time": 1734.95, "timestamp": "00:28:54", "text": "簡短的踢踏舞曲。嗯，你好。  我"}]
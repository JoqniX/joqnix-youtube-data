[{"type": "subtitle", "time": 1449.83, "timestamp": "00:24:09", "text": "好的。嗯，"}, {"type": "subtitle", "time": 1453.19, "timestamp": "00:24:13", "text": "我試著唱一下這首歌。好久不見了"}, {"type": "subtitle", "time": 1454.95, "timestamp": "00:24:14", "text": "。"}, {"type": "subtitle", "time": 1457.35, "timestamp": "00:24:17", "text": "我不確定自己能不能唱好，但"}, {"type": "subtitle", "time": 1463.1, "timestamp": "00:24:23", "text": "我會試試看。你好。三、二、一。"}, {"type": "subtitle", "time": 1475.27, "timestamp": "00:24:35", "text": "觸動。"}]
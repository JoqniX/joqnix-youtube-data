[{"type": "subtitle", "time": 1264.07, "timestamp": "00:21:04", "text": "我可以把你放在"}, {"type": "subtitle", "time": 1270.549, "timestamp": "00:21:10", "text": "我的生日還沒到。大家好，請進！"}, {"type": "subtitle", "time": 1274.71, "timestamp": "00:21:14", "text": "因為我"}, {"type": "subtitle", "time": 1277.909, "timestamp": "00:21:17", "text": "沒用 OBS，所以很抱歉，我"}, {"type": "subtitle", "time": 1279.99, "timestamp": "00:21:19", "text": "不能把你們的名字都寫在"}, {"type": "subtitle", "time": 1283.51, "timestamp": "00:21:23", "text": "參加者的名單上。而且，我本來"}, {"type": "subtitle", "time": 1286.789, "timestamp": "00:21:26", "text": "想把你們的名字都寫"}, {"type": "subtitle", "time": 1289.909, "timestamp": "00:21:29", "text": "在蛋糕上，"}, {"type": "subtitle", "time": 1294.149, "timestamp": "00:21:34", "text": "就像我們去年一樣。不過沒關係，"}, {"type": "subtitle", "time": 1309.029, "timestamp": "00:21:49", "text": "你好。以上就是雷姆·瓜諾。"}, {"type": "subtitle", "time": 1312.39, "timestamp": "00:21:52", "text": "呃，純屬虛構。"}, {"type": "subtitle", "time": 1315.35, "timestamp": "00:21:55", "text": "你好。你現在多大了？我今年是"}, {"type": "subtitle", "time": 1318.95, "timestamp": "00:21:58", "text": "百萬富翁。"}]
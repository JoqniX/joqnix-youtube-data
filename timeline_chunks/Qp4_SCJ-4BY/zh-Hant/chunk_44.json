[{"type": "subtitle", "time": 2646.47, "timestamp": "00:44:06", "text": "謝謝你的生日祝福和龍騎士。  謝謝"}, {"type": "subtitle", "time": 2650.15, "timestamp": "00:44:10", "text": "你的生日祝福。  為什麼要提醒大家認清現實？好的，"}, {"type": "subtitle", "time": 2654.55, "timestamp": "00:44:14", "text": "明白了。但沒關係。是啊，我"}, {"type": "subtitle", "time": 2656.39, "timestamp": "00:44:16", "text": "知道明年生日"}, {"type": "subtitle", "time": 2659.349, "timestamp": "00:44:19", "text": "我一定會哭"}, {"type": "subtitle", "time": 2662.47, "timestamp": "00:44:22", "text": "，但今天我表現得很淡定"}, {"type": "subtitle", "time": 2664.309, "timestamp": "00:44:24", "text": "，"}, {"type": "subtitle", "time": 2668.309, "timestamp": "00:44:28", "text": "所以沒關係。是的，讓《Crybaby Mix》"}, {"type": "subtitle", "time": 2671.51, "timestamp": "00:44:31", "text": "明年上映吧。"}, {"type": "subtitle", "time": 2673.99, "timestamp": "00:44:33", "text": "今年接下來會有一個漫不經心的運動健將，他/她很"}, {"type": "subtitle", "time": 2681.19, "timestamp": "00:44:41", "text": "高興"}, {"type": "subtitle", "time": 2684.15, "timestamp": "00:44:44", "text": "大家都能來，我會盡可能珍惜和"}, {"type": "subtitle", "time": 2689.03, "timestamp": "00:44:49", "text": "大家在一起的每一刻。  好的"}, {"type": "subtitle", "time": 2691.75, "timestamp": "00:44:51", "text": "，"}, {"type": "subtitle", "time": 2695.349, "timestamp": "00:44:55", "text": "我一定會這麼做。"}, {"type": "subtitle", "time": 2697.91, "timestamp": "00:44:57", "text": "願上帝保佑你。謝謝。謝謝"}]
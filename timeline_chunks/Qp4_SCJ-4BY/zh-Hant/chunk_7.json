[{"type": "subtitle", "time": 422.15, "timestamp": "00:07:02", "text": "一秒鐘。"}, {"type": "subtitle", "time": 427.99, "timestamp": "00:07:07", "text": "M：呃，讓我來做吧。"}, {"type": "subtitle", "time": 430.629, "timestamp": "00:07:10", "text": "我需要那個嗎？"}, {"type": "subtitle", "time": 438.469, "timestamp": "00:07:18", "text": "等等，等等，等等，等等，等等，"}, {"type": "subtitle", "time": 441.749, "timestamp": "00:07:21", "text": "等等。耽誤。"}, {"type": "subtitle", "time": 443.35, "timestamp": "00:07:23", "text": "那裡有一個通訊設備，對吧？好的。好的。  好的。你好。"}, {"type": "subtitle", "time": 451.749, "timestamp": "00:07:31", "text": "你沒看到。好的。你好。"}, {"type": "subtitle", "time": 455.029, "timestamp": "00:07:35", "text": "再次為刮痕深感抱歉。嗯，我其實"}, {"type": "subtitle", "time": 458.629, "timestamp": "00:07:38", "text": "沒怎麼計劃，因為"}, {"type": "subtitle", "time": 462.07, "timestamp": "00:07:42", "text": "我一"}, {"type": "subtitle", "time": 476.469, "timestamp": "00:07:56", "text": "不過別擔心，明天"}, {"type": "subtitle", "time": 479.99, "timestamp": "00:07:59", "text": "我會好好準備的，我想應該可以。"}]
[{"type": "subtitle", "time": 5101.99, "timestamp": "01:25:01", "text": "[Music]"}, {"type": "subtitle", "time": 5105.03, "timestamp": "01:25:05", "text": "I lost."}, {"type": "subtitle", "time": 5109.35, "timestamp": "01:25:09", "text": "lost in the world that we scream"}, {"type": "subtitle", "time": 5111.59, "timestamp": "01:25:11", "text": "and I don't want to want to do this"}, {"type": "subtitle", "time": 5113.91, "timestamp": "01:25:13", "text": "anymore"}, {"type": "subtitle", "time": 5117.43, "timestamp": "01:25:17", "text": "cuz you don't know what you mean to me"}, {"type": "subtitle", "time": 5121.03, "timestamp": "01:25:21", "text": "and I lost the only one worth fighting"}, {"type": "subtitle", "time": 5123.35, "timestamp": "01:25:23", "text": "for."}, {"type": "subtitle", "time": 5125.669, "timestamp": "01:25:25", "text": "Wherever you go, that's where I'll"}, {"type": "subtitle", "time": 5127.99, "timestamp": "01:25:27", "text": "follow."}, {"type": "subtitle", "time": 5132.47, "timestamp": "01:25:32", "text": "Nobody's promise tomorrow."}, {"type": "subtitle", "time": 5134.55, "timestamp": "01:25:34", "text": "So I'm going to love you every night"}, {"type": "subtitle", "time": 5138.709, "timestamp": "01:25:38", "text": "like last night. I guess the last time."}, {"type": "subtitle", "time": 5142.709, "timestamp": "01:25:42", "text": "If the world was ending, I want to be"}, {"type": "subtitle", "time": 5151.43, "timestamp": "01:25:51", "text": "If the party was over and our time on"}]
[{"type": "subtitle", "time": 4741.03, "timestamp": "01:19:01", "text": "And we extract from here at the central"}, {"type": "subtitle", "time": 4744.31, "timestamp": "01:19:04", "text": "swamp lift."}, {"type": "subtitle", "time": 4763.35, "timestamp": "01:19:23", "text": "If we are lucky, we will find a leaper."}, {"type": "subtitle", "time": 4787.75, "timestamp": "01:19:47", "text": "This is not looted. No one came."}]
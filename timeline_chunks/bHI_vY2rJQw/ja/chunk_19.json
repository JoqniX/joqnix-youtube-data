[{"type": "subtitle", "time": 1151.83, "timestamp": "00:19:11", "text": "ええと、私たちはただ"}, {"type": "subtitle", "time": 1159.909, "timestamp": "00:19:19", "text": "トライアルのために実質的にファームするつもりです。 それでおしまい。"}, {"type": "subtitle", "time": 1167.35, "timestamp": "00:19:27", "text": "えっと、これには女家長が必要なんです。 えーっと、"}, {"type": "subtitle", "time": 1169.83, "timestamp": "00:19:29", "text": "女王とマトリが欲しいんですが、"}, {"type": "subtitle", "time": 1172.07, "timestamp": "00:19:32", "text": "彼らは気にしてないんです。 おそらく"}, {"type": "subtitle", "time": 1188.39, "timestamp": "00:19:48", "text": "[鼻で笑う] 包帯が必要よね？"}]
[{"type": "subtitle", "time": 7153.99, "timestamp": "01:59:13", "text": "それで、はい、2つ完成しました。"}, {"type": "subtitle", "time": 7156.07, "timestamp": "01:59:16", "text": "冷凍コンテナの作業を行う必要があります"}, {"type": "subtitle", "time": 7158.149, "timestamp": "01:59:18", "text": "。 リーパーと第一波の家。"}, {"type": "subtitle", "time": 7161.99, "timestamp": "01:59:21", "text": "正しい。 リーパー。"}, {"type": "subtitle", "time": 7168.79, "timestamp": "01:59:28", "text": "トレーダーがリセットされるまで明日まで待ちます。"}, {"type": "subtitle", "time": 7173.03, "timestamp": "01:59:33", "text": "17時間。 いいえ、明日です。 とりあえずやります。"}, {"type": "subtitle", "time": 7176.31, "timestamp": "01:59:36", "text": "うん。 お金を取り戻さなければなりません。"}, {"type": "subtitle", "time": 7180.39, "timestamp": "01:59:40", "text": "うん。 それで、次の実行を実行します。 えーっと、"}]
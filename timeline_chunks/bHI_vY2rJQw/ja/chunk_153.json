[{"type": "subtitle", "time": 9210.469, "timestamp": "02:33:30", "text": "我々は、襲撃者の避難所"}, {"type": "subtitle", "time": 9215.83, "timestamp": "02:33:35", "text": "からボブキャットか何か他のものの設計図を入手しようとします"}, {"type": "subtitle", "time": 9219.91, "timestamp": "02:33:39", "text": "。 いいえ。あるいは巡礼者たちが"}, {"type": "subtitle", "time": 9238.309, "timestamp": "02:33:58", "text": "12時です。"}]
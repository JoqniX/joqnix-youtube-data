[{"type": "subtitle", "time": 8102.709, "timestamp": "02:15:02", "text": "これらも必要で、"}, {"type": "subtitle", "time": 8107.109, "timestamp": "02:15:07", "text": "クラフト テーブル用にこれらを実行する必要があります。 では、"}, {"type": "subtitle", "time": 8108.79, "timestamp": "02:15:08", "text": "種子貯蔵庫へ行きましょう。"}, {"type": "subtitle", "time": 8112.069, "timestamp": "02:15:12", "text": "種子貯蔵庫へ行ってください。"}, {"type": "subtitle", "time": 8115.589, "timestamp": "02:15:15", "text": "遅い襲撃です。"}, {"type": "subtitle", "time": 8117.589, "timestamp": "02:15:17", "text": "目が暗さに慣れてきたら。"}, {"type": "subtitle", "time": 8122.47, "timestamp": "02:15:22", "text": "トレドのほとんどの住民が眠っている間に、侵入者の略奪品は収穫できる状態になっています。 ただし、"}, {"type": "subtitle", "time": 8124.55, "timestamp": "02:15:24", "text": "私のサプライヤーによると、アークは"}, {"type": "subtitle", "time": 8135.589, "timestamp": "02:15:35", "text": "はい、遅い襲撃です。 人々は"}, {"type": "subtitle", "time": 8157.83, "timestamp": "02:15:57", "text": "ロビーに行きましょう。"}]
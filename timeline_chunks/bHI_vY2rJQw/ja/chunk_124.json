[{"type": "subtitle", "time": 7444.79, "timestamp": "02:04:04", "text": "私はここに生まれました。"}, {"type": "subtitle", "time": 7446.07, "timestamp": "02:04:06", "text": "シーズンが近づいているといいですね、"}, {"type": "subtitle", "time": 7447.99, "timestamp": "02:04:07", "text": "レイダー。 ろうそく摘みにはいい日ですが"}, {"type": "subtitle", "time": 7451.99, "timestamp": "02:04:11", "text": "、凍傷にはご注意ください。"}, {"type": "subtitle", "time": 7455.75, "timestamp": "02:04:15", "text": "私はここにいます。 いや。"}, {"type": "subtitle", "time": 7463.589, "timestamp": "02:04:23", "text": "ああ、スポーンオーバー。 はい、ここにレール"}, {"type": "subtitle", "time": 7466.31, "timestamp": "02:04:26", "text": "ケージがあります。 ここ。"}]
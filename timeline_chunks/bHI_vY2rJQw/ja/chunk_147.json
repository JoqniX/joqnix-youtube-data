[{"type": "subtitle", "time": 8828.469, "timestamp": "02:27:08", "text": "もしそれが向きを変えたら、もしそれが私を見たら、私は"}, {"type": "subtitle", "time": 8845.429, "timestamp": "02:27:25", "text": "2 回目の遠征では、"}, {"type": "subtitle", "time": 8848.63, "timestamp": "02:27:28", "text": "シュレッダーを破壊してコアなどを入手する必要があります"}, {"type": "subtitle", "time": 8851.11, "timestamp": "02:27:31", "text": "。"}, {"type": "subtitle", "time": 8869.19, "timestamp": "02:27:49", "text": "ああ、くそ。 なんてこった。 いいえ。いいえ。いいえ。いいえ。いいえ。いいえ。いいえ。"}]
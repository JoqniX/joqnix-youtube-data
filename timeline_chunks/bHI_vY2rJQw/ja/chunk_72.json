[{"type": "subtitle", "time": 4322.87, "timestamp": "01:12:02", "text": "私には化学物質さえありません。なぜ私は"}, {"type": "subtitle", "time": 4325.35, "timestamp": "01:12:05", "text": "こんな風になっているのでしょうか?"}, {"type": "subtitle", "time": 4327.669, "timestamp": "01:12:07", "text": "えーと、"}, {"type": "subtitle", "time": 4345.03, "timestamp": "01:12:25", "text": "かなりの量のものを失いました。 たくさんの"}, {"type": "subtitle", "time": 4357.91, "timestamp": "01:12:37", "text": "ストリーミング中にゲーマーをどのくらいの頻度で使用しますか? 私は現実世界では決してその言葉を使いません"}, {"type": "subtitle", "time": 4364.95, "timestamp": "01:12:44", "text": "問題は今の私ですが、以前は"}, {"type": "subtitle", "time": 4368.63, "timestamp": "01:12:48", "text": "それほど多くは言いませんでした。"}, {"type": "subtitle", "time": 4373.99, "timestamp": "01:12:53", "text": "えー、でも最近は"}, {"type": "subtitle", "time": 4378.47, "timestamp": "01:12:58", "text": "なんとなく出てくるようになってきた気がします。 普段、"}]
[{"type": "subtitle", "time": 3723.829, "timestamp": "01:02:03", "text": "。 十分近い。 来て。"}, {"type": "subtitle", "time": 3726.47, "timestamp": "01:02:06", "text": "1 回のリーパーを実行し、"}, {"type": "subtitle", "time": 3732.069, "timestamp": "01:02:12", "text": "8 分以内に 2 回目のリーパーが出現するのを待ちます。"}, {"type": "subtitle", "time": 3735.67, "timestamp": "01:02:15", "text": "その時までに、私は"}, {"type": "subtitle", "time": 3739.51, "timestamp": "01:02:19", "text": "このことをやります。"}, {"type": "subtitle", "time": 3742.39, "timestamp": "01:02:22", "text": "8匹くらい殺す必要があります。"}, {"type": "subtitle", "time": 3745.51, "timestamp": "01:02:25", "text": "厚さ8〜12。"}]
[{"type": "subtitle", "time": 4630.709, "timestamp": "01:17:10", "text": "。 待ってください。ゴミは"}, {"type": "subtitle", "time": 4638.63, "timestamp": "01:17:18", "text": "体力を無駄にしてしまった。 はい、待ってください。"}, {"type": "subtitle", "time": 4643.75, "timestamp": "01:17:23", "text": "それで、リーパーのスポーンは技術的には、"}, {"type": "subtitle", "time": 4646.229, "timestamp": "01:17:26", "text": "確認させてください、"}, {"type": "subtitle", "time": 4648.31, "timestamp": "01:17:28", "text": "4 つ、いや 5 つのスポーン"}, {"type": "subtitle", "time": 4651.83, "timestamp": "01:17:31", "text": "場所があります。 それで、1つはここにあります。"}, {"type": "subtitle", "time": 4654.07, "timestamp": "01:17:34", "text": "1つはここにあります。 それが前回の試合で私たちが戦ったことだ"}, {"type": "subtitle", "time": 4659.59, "timestamp": "01:17:39", "text": "。 そして他の3人はここにいます。"}]
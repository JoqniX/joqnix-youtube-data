[{"type": "subtitle", "time": 3962.309, "timestamp": "01:06:02", "text": "マラソンは似たような PV や PVP ですが、"}, {"type": "subtitle", "time": 3965.109, "timestamp": "01:06:05", "text": "問題は一人称視点になってしまい、"}, {"type": "subtitle", "time": 3967.589, "timestamp": "01:06:07", "text": "Apex のようになってしまったことです。"}, {"type": "subtitle", "time": 3971.51, "timestamp": "01:06:11", "text": "私の質問は、それをプレイするかどうかということです。"}, {"type": "subtitle", "time": 3973.67, "timestamp": "01:06:13", "text": "セールが来ることは知っていましたか？"}, {"type": "subtitle", "time": 3977.91, "timestamp": "01:06:17", "text": "はい、知っていましたが、"}, {"type": "subtitle", "time": 3981.51, "timestamp": "01:06:21", "text": "遠征をしなければいけないような気がしていました。 だから"}, {"type": "subtitle", "time": 3984.63, "timestamp": "01:06:24", "text": "私は"}, {"type": "subtitle", "time": 3995.349, "timestamp": "01:06:35", "text": "待って。 ああ、リーパー。 さあ行こう。 リーパーが来ました"}, {"type": "subtitle", "time": 3996.95, "timestamp": "01:06:36", "text": "。 待って、待って、待って、待って、待って、"}, {"type": "subtitle", "time": 4001.109, "timestamp": "01:06:41", "text": "待って。 よし、ジャンパーをやってみよう。"}]
[{"type": "subtitle", "time": 6425.109, "timestamp": "01:47:05", "text": "ここにはコオロギがいるはずだ。"}, {"type": "subtitle", "time": 6427.669, "timestamp": "01:47:07", "text": "ここにテキストがあるという意味ですが、ありません"}, {"type": "subtitle", "time": 6453.189, "timestamp": "01:47:33", "text": "弾を節約してください。"}, {"type": "subtitle", "time": 6455.99, "timestamp": "01:47:35", "text": "弾を節約しなければなりません。"}, {"type": "subtitle", "time": 6457.75, "timestamp": "01:47:37", "text": "ああそうだ、ここには間違いなく"}]
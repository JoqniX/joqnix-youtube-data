[{"type": "subtitle", "time": 4381.669, "timestamp": "01:13:01", "text": "私は"}, {"type": "subtitle", "time": 4386.07, "timestamp": "01:13:06", "text": "ゲーマー用語は言わないという厳しいルールを自分に課しています。"}, {"type": "subtitle", "time": 4388.31, "timestamp": "01:13:08", "text": "ああ、でも時々はそういうことが起こると思うよ"}, {"type": "subtitle", "time": 4403.91, "timestamp": "01:13:23", "text": "えっと、[うめき声]"}, {"type": "subtitle", "time": 4408.79, "timestamp": "01:13:28", "text": "でも、えっと、私は通常、"}, {"type": "subtitle", "time": 4411.669, "timestamp": "01:13:31", "text": "使用できるセンサー語を見つけます。 だから"}, {"type": "subtitle", "time": 4420.39, "timestamp": "01:13:40", "text": "そうですね、私はゲーマーという言葉をあまり使うタイプではありません"}, {"type": "subtitle", "time": 4424.709, "timestamp": "01:13:44", "text": "。 そうですね、それもありますね"}]
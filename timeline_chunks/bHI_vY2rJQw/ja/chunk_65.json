[{"type": "subtitle", "time": 3914.789, "timestamp": "01:05:14", "text": "セール中ではなかったときにクレーターを購入しました。 結局、2,400ルピーを費やさなければならず、"}, {"type": "subtitle", "time": 3919.27, "timestamp": "01:05:19", "text": "後悔しています。 後悔はしてないよ。"}, {"type": "subtitle", "time": 3922.069, "timestamp": "01:05:22", "text": "ベーコンが冬のセールで買ったみたい。"}, {"type": "subtitle", "time": 3924.71, "timestamp": "01:05:24", "text": "つまり、1,900 くらいでした"}, {"type": "subtitle", "time": 3926.549, "timestamp": "01:05:26", "text": "。"}, {"type": "subtitle", "time": 3938.549, "timestamp": "01:05:38", "text": "でもそうですね、"}, {"type": "subtitle", "time": 3941.51, "timestamp": "01:05:41", "text": "私は"}, {"type": "subtitle", "time": 3950.95, "timestamp": "01:05:50", "text": "マラソンが発売されたら買いたいです"}, {"type": "subtitle", "time": 3954.63, "timestamp": "01:05:54", "text": "。"}, {"type": "subtitle", "time": 3957.029, "timestamp": "01:05:57", "text": "アート クリエイターで楽しんでいるのでプレイするかどうかはわかりませんが、"}]
[{"type": "subtitle", "time": 362.71, "timestamp": "00:06:02", "text": "ここに持ってきて"}, {"type": "subtitle", "time": 365.67, "timestamp": "00:06:05", "text": "これをやってみましょう。"}, {"type": "subtitle", "time": 368.55, "timestamp": "00:06:08", "text": "今日のリンクを貼っておきます。   そうそう"}, {"type": "subtitle", "time": 371.27, "timestamp": "00:06:11", "text": "。 皆様のクリスマスはいかがでしたか"}, {"type": "subtitle", "time": 373.51, "timestamp": "00:06:13", "text": "？ あなたは何をしましたか？ 何を見せたんですか"}, {"type": "subtitle", "time": 375.43, "timestamp": "00:06:15", "text": "？ あなたは何をしましたか？"}, {"type": "subtitle", "time": 383.909, "timestamp": "00:06:23", "text": "皆さんはクリスマスに何をもらいましたか？"}, {"type": "subtitle", "time": 389.11, "timestamp": "00:06:29", "text": "私としては、正直"}, {"type": "subtitle", "time": 396.07, "timestamp": "00:06:36", "text": "昨日みたいにクリスマス配信をやりたかったんですが、体調が悪かったんです"}, {"type": "subtitle", "time": 399.189, "timestamp": "00:06:39", "text": "。 さらに、"}, {"type": "subtitle", "time": 402.629, "timestamp": "00:06:42", "text": "家族と過ごす時間をもっと増やしたいと考えました。"}, {"type": "subtitle", "time": 406.39, "timestamp": "00:06:46", "text": "それで、昨日それをやりました。"}, {"type": "subtitle", "time": 408.87, "timestamp": "00:06:48", "text": "でも大丈夫だよ。 いつもは"}, {"type": "subtitle", "time": 411.83, "timestamp": "00:06:51", "text": "クリスマスツリーみたいなものがあって、"}, {"type": "subtitle", "time": 414.07, "timestamp": "00:06:54", "text": "みんなをクリスマスツリーみたいに飾ったりしますよね"}, {"type": "subtitle", "time": 416.469, "timestamp": "00:06:56", "text": "？ 私たちも昔はそうしていたんです"}, {"type": "subtitle", "time": 418.95, "timestamp": "00:06:58", "text": "。"}]
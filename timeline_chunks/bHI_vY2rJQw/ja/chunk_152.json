[{"type": "subtitle", "time": 9137.75, "timestamp": "02:32:17", "text": "見た目は大したことないと思うかもしれませんが、"}, {"type": "subtitle", "time": 9153.349, "timestamp": "02:32:33", "text": "電圧変換器。 ああ、私ああ、いや。"}, {"type": "subtitle", "time": 9156.71, "timestamp": "02:32:36", "text": "以前どこかでこれを見たことがあります。"}, {"type": "subtitle", "time": 9173.27, "timestamp": "02:32:53", "text": "そうですね、ショートストッパーは素晴らしい"}, {"type": "subtitle", "time": 9176.55, "timestamp": "02:32:56", "text": "ものや私のあれこれに最適です。"}, {"type": "subtitle", "time": 9178.309, "timestamp": "02:32:58", "text": "これなら使えるかも。"}]
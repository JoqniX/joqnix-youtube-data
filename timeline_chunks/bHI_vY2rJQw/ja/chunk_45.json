[{"type": "subtitle", "time": 2701.349, "timestamp": "00:45:01", "text": "メリークリスマスいかがですか？ 私には何もありません。   どうして"}, {"type": "subtitle", "time": 2710.71, "timestamp": "00:45:10", "text": "はい、前回と同じスポーンが得られました"}, {"type": "subtitle", "time": 2714.15, "timestamp": "00:45:14", "text": "。 面白い。   わかったよ"}, {"type": "subtitle", "time": 2721.43, "timestamp": "00:45:21", "text": "アポロが話している。"}, {"type": "subtitle", "time": 2723.43, "timestamp": "00:45:23", "text": "レイダー、手榴弾を持ってきたか？ 私の新しいデザインは"}, {"type": "subtitle", "time": 2725.19, "timestamp": "00:45:25", "text": "紙の上ではとても素晴らしく見えますが、確かなことを"}, {"type": "subtitle", "time": 2726.47, "timestamp": "00:45:26", "text": "知るためには誰かがそれを機械に投げ込んでみる必要があります"}]
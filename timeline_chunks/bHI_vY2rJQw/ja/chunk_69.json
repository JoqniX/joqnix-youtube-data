[{"type": "subtitle", "time": 4160.229, "timestamp": "01:09:20", "text": "30 個買いました 40,000 で買いました"}, {"type": "subtitle", "time": 4162.63, "timestamp": "01:09:22", "text": "彼は逃げました"}, {"type": "subtitle", "time": 4169.767, "timestamp": "01:09:29", "text": "私のリーパー"}, {"type": "subtitle", "time": 4184.149, "timestamp": "01:09:44", "text": "えーと、あなたは私を略奪することができます。 私は死んでしまいます。   俺から"}, {"type": "subtitle", "time": 4193.749, "timestamp": "01:09:53", "text": "兄弟。 私のドリルろう付け機。"}, {"type": "subtitle", "time": 4197.59, "timestamp": "01:09:57", "text": "金庫のポケットに入れるのを忘れました。 いいえ。"}]
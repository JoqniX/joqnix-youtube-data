[{"type": "subtitle", "time": 3849.109, "timestamp": "01:04:09", "text": "ああ、歩哨。 これが必要です。"}, {"type": "subtitle", "time": 3876.87, "timestamp": "01:04:36", "text": "？"}, {"type": "subtitle", "time": 3879.349, "timestamp": "01:04:39", "text": "誰かが跳躍者と戦っている。"}, {"type": "subtitle", "time": 3881.67, "timestamp": "01:04:41", "text": "ああ、いや、いや、いや。 それがロケット打ち上げ人だ。"}, {"type": "subtitle", "time": 3893.27, "timestamp": "01:04:53", "text": "今日買ったゲームは何ですか？ 実は何も"}]
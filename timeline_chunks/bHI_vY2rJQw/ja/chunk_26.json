[{"type": "subtitle", "time": 1579.909, "timestamp": "00:26:19", "text": "そして、私たち"}, {"type": "subtitle", "time": 1582.71, "timestamp": "00:26:22", "text": "自身が解凍されるまで待ちます。"}, {"type": "subtitle", "time": 1586.47, "timestamp": "00:26:26", "text": "それで、私たちはどこにいるのでしょうか? 私たちはここにいます。"}, {"type": "subtitle", "time": 1605.59, "timestamp": "00:26:45", "text": "川沿いの土地を調べれば、"}, {"type": "subtitle", "time": 1608.63, "timestamp": "00:26:48", "text": "何か計画が見つかるかもしれません。"}, {"type": "subtitle", "time": 1617.269, "timestamp": "00:26:57", "text": "ええと、"}]
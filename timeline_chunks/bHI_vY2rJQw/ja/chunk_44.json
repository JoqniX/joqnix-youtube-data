[{"type": "subtitle", "time": 2651.67, "timestamp": "00:44:11", "text": "今度は厚い部分もやらなきゃ。   さあ行こう"}, {"type": "subtitle", "time": 2656.87, "timestamp": "00:44:16", "text": "。 我々は本当に順調にやっています"}, {"type": "subtitle", "time": 2664.39, "timestamp": "00:44:24", "text": "炎は出ません。"}, {"type": "subtitle", "time": 2691.67, "timestamp": "00:44:51", "text": "今年は統計学に不合格でした。 私は悲しいです。   ああ"}, {"type": "subtitle", "time": 2694.309, "timestamp": "00:44:54", "text": "、どうしたの？"}, {"type": "subtitle", "time": 2698.15, "timestamp": "00:44:58", "text": "大丈夫。 次回もう一度お試しください。"}]
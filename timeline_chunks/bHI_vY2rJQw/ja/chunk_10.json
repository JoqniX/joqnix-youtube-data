[{"type": "subtitle", "time": 601.11, "timestamp": "00:10:01", "text": "新しいレイダーデッキが発売されるのは今日じゃないですか、それとも"}, {"type": "subtitle", "time": 603.99, "timestamp": "00:10:03", "text": "明日ですか?"}, {"type": "subtitle", "time": 607.509, "timestamp": "00:10:07", "text": "すっかり忘れてました。 今日ですよね"}, {"type": "subtitle", "time": 610.31, "timestamp": "00:10:10", "text": "？ 今日はそうだと思います。 新しい"}, {"type": "subtitle", "time": 616.31, "timestamp": "00:10:16", "text": "冬のゴールキーパーのスキン。"}, {"type": "subtitle", "time": 619.11, "timestamp": "00:10:19", "text": "本当にかっこいいスキンですね。 ぜひ欲しいです"}, {"type": "subtitle", "time": 621.91, "timestamp": "00:10:21", "text": "。"}, {"type": "subtitle", "time": 626.31, "timestamp": "00:10:26", "text": "そのためには日々努力を重ねなければなりません。"}, {"type": "subtitle", "time": 629.269, "timestamp": "00:10:29", "text": "ちょっと奇妙だけど、そうですね、"}, {"type": "subtitle", "time": 642.63, "timestamp": "00:10:42", "text": "。"}, {"type": "subtitle", "time": 651.91, "timestamp": "00:10:51", "text": "はい、"}, {"type": "subtitle", "time": 658.23, "timestamp": "00:10:58", "text": "ええと、"}]
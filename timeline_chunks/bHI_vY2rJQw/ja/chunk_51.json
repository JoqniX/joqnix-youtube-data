[{"type": "subtitle", "time": 3066.069, "timestamp": "00:51:06", "text": "これをやるのは危険ではないでしょうか?"}, {"type": "subtitle", "time": 3069.99, "timestamp": "00:51:09", "text": "アークパワーシェルが必要です。"}, {"type": "subtitle", "time": 3088.95, "timestamp": "00:51:28", "text": "ああ、"}, {"type": "subtitle", "time": 3103.109, "timestamp": "00:51:43", "text": "おお。 何てことだ。 死にそうだった。 待って、"}, {"type": "subtitle", "time": 3106.71, "timestamp": "00:51:46", "text": "ジョックン、残りは取らないで。 ああ神様。"}, {"type": "subtitle", "time": 3111.109, "timestamp": "00:51:51", "text": "今、リスクを負うべきでしょうか? 分かりませんよ"}, {"type": "subtitle", "time": 3117.51, "timestamp": "00:51:57", "text": "私にわかっているのは、これが必要だということ、そして、"}]
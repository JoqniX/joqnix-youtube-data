[{"type": "subtitle", "time": 4741.03, "timestamp": "01:19:01", "text": "そして、ここから中央"}, {"type": "subtitle", "time": 4744.31, "timestamp": "01:19:04", "text": "湿地リフトで採掘します。   よし"}, {"type": "subtitle", "time": 4763.35, "timestamp": "01:19:23", "text": "運が良ければ、跳躍者を見つけることができるでしょう。   そうでない"}, {"type": "subtitle", "time": 4787.75, "timestamp": "01:19:47", "text": "これは略奪されたものではありません。 誰も来なかった。   そこに"}]
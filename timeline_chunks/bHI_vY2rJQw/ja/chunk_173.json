[{"type": "subtitle", "time": 10385.11, "timestamp": "02:53:05", "text": "こんにちは。"}, {"type": "subtitle", "time": 10397.11, "timestamp": "02:53:17", "text": "遅れずにこのゲームをプレイする方法を見つける必要があります。"}, {"type": "subtitle", "time": 10400.87, "timestamp": "02:53:20", "text": "非常に軽量なセットアップを実行しているのに、ストリーミングするたびに"}, {"type": "subtitle", "time": 10404.309, "timestamp": "02:53:24", "text": "このゲームで遅延が発生します。"}, {"type": "subtitle", "time": 10408.95, "timestamp": "02:53:28", "text": "ストリーミングするたびに"}, {"type": "subtitle", "time": 10412.55, "timestamp": "02:53:32", "text": "ゲームがそれを処理していないため、本当に"}, {"type": "subtitle", "time": 10427.11, "timestamp": "02:53:47", "text": "。 すでにみんなが私のチャンネルにいつも参加しているのを見ています"}]
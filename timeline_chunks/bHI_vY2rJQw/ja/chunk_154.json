[{"type": "subtitle", "time": 9240.79, "timestamp": "02:34:00", "text": "何時にどのくらいストリーミングしますか?"}, {"type": "subtitle", "time": 9244.87, "timestamp": "02:34:04", "text": "31分ほどで"}, {"type": "subtitle", "time": 9248.309, "timestamp": "02:34:08", "text": "今日のセッションを終了させて​​いただきます。 わかった。"}, {"type": "subtitle", "time": 9269.91, "timestamp": "02:34:29", "text": "誰かが何かと戦っている。 誰かが"}, {"type": "subtitle", "time": 9270.469, "timestamp": "02:34:30", "text": "亡くなりました。"}, {"type": "subtitle", "time": 9272.71, "timestamp": "02:34:32", "text": "門に目を向ける。 一部の悪党が"}, {"type": "subtitle", "time": 9274.71, "timestamp": "02:34:34", "text": "緊急停止を引き起こしたが、これは"}, {"type": "subtitle", "time": 9277.51, "timestamp": "02:34:37", "text": "悪い知らせでしかない。"}, {"type": "subtitle", "time": 9279.349, "timestamp": "02:34:39", "text": "プロトコルを無効にするキーカードを見つけて、"}, {"type": "subtitle", "time": 9284.389, "timestamp": "02:34:44", "text": "日光に耐えられないものが何であれ発見できるようにしてください。"}]
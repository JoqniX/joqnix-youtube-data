[{"type": "subtitle", "time": 5465.59, "timestamp": "01:31:05", "text": "ああ、これは最悪だ。"}, {"type": "subtitle", "time": 5472.149, "timestamp": "01:31:12", "text": "今回は無料で荷物を出してもらいました。 無料のロード"}, {"type": "subtitle", "time": 5473.83, "timestamp": "01:31:13", "text": "アウト。"}, {"type": "subtitle", "time": 5477.75, "timestamp": "01:31:17", "text": "何も失うわけにはいきません。"}, {"type": "subtitle", "time": 5480.149, "timestamp": "01:31:20", "text": "テキストにダメージを与えてみましょう。"}, {"type": "subtitle", "time": 5519.43, "timestamp": "01:31:59", "text": "一つずつ見ていきましょう。 うん。"}]
[{"type": "subtitle", "time": 4502.229, "timestamp": "01:15:02", "text": "問題は、"}, {"type": "subtitle", "time": 4508.87, "timestamp": "01:15:08", "text": "その愚かなスズメバチがやって来たときにトレイルブレイザーを失わなければ、私が好きなリーパーではないということです。もし私が今それに"}, {"type": "subtitle", "time": 4511.43, "timestamp": "01:15:11", "text": "死ななければ、"}, {"type": "subtitle", "time": 4514.79, "timestamp": "01:15:14", "text": "リープチャレンジを完了できたでしょう。"}, {"type": "subtitle", "time": 4517.03, "timestamp": "01:15:17", "text": "私は今苦労していないでしょう。   ここです"}, {"type": "subtitle", "time": 4558.79, "timestamp": "01:15:58", "text": "ああ、グープ。 グープ。 何かグープが手に入った。   ちょっと"}]
[{"type": "subtitle", "time": 1080.47, "timestamp": "00:18:00", "text": "。 それで、ええと、"}, {"type": "subtitle", "time": 1086.23, "timestamp": "00:18:06", "text": "加湿器が必要なんです。 えっと"}, {"type": "subtitle", "time": 1089.19, "timestamp": "00:18:09", "text": "、とりあえずトーンを分割します"}, {"type": "subtitle", "time": 1091.83, "timestamp": "00:18:11", "text": "。"}, {"type": "subtitle", "time": 1093.75, "timestamp": "00:18:13", "text": "少し難しいので、植物の収穫に焦点を当てます"}, {"type": "subtitle", "time": 1096.71, "timestamp": "00:18:16", "text": "。 少し難しくなりました。 収穫"}, {"type": "subtitle", "time": 1100.07, "timestamp": "00:18:20", "text": "計画とダニの"}, {"type": "subtitle", "time": 1103.27, "timestamp": "00:18:23", "text": "駆除。 リーパーを試してみるのもいいかもしれません"}, {"type": "subtitle", "time": 1105.27, "timestamp": "00:18:25", "text": "。"}, {"type": "subtitle", "time": 1107.43, "timestamp": "00:18:27", "text": "あのね？ それをやってみようと思います"}, {"type": "subtitle", "time": 1109.59, "timestamp": "00:18:29", "text": "。 リーパーにも挑戦してみます"}, {"type": "subtitle", "time": 1116.549, "timestamp": "00:18:36", "text": "トレイルプレーサーはどこですか？ はい、それを"}, {"type": "subtitle", "time": 1120.31, "timestamp": "00:18:40", "text": "私の金庫のポケットに入れておきます。"}, {"type": "subtitle", "time": 1138.71, "timestamp": "00:18:58", "text": "また、これを紛失したくないので、これに"}]
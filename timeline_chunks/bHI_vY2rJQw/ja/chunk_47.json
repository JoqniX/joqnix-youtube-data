[{"type": "subtitle", "time": 2838.47, "timestamp": "00:47:18", "text": "インド人は中国人をどう思っているのでしょうか"}, {"type": "subtitle", "time": 2841.109, "timestamp": "00:47:21", "text": "？ わからない。"}, {"type": "subtitle", "time": 2843.43, "timestamp": "00:47:23", "text": "かっこいいと思いますよ。 彼らの文化や"}, {"type": "subtitle", "time": 2851.109, "timestamp": "00:47:31", "text": "他の人に代わって話すことはできません。 私は自分自身のこと"}, {"type": "subtitle", "time": 2873.19, "timestamp": "00:47:53", "text": "こちらにはまだテキストが必要です。"}]
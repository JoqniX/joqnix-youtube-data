[{"type": "subtitle", "time": 4273.669, "timestamp": "01:11:13", "text": "それで、それは私の2番目のスナップ"}, {"type": "subtitle", "time": 4276.55, "timestamp": "01:11:16", "text": "フックになるのでしょうか？   さあ行こう"}, {"type": "subtitle", "time": 4283.75, "timestamp": "01:11:23", "text": "ああ、シュートが外れてしまった。 何てことだ。"}, {"type": "subtitle", "time": 4291.03, "timestamp": "01:11:31", "text": "私は権利を失いました。 何てことだ。"}, {"type": "subtitle", "time": 4298.87, "timestamp": "01:11:38", "text": "兄弟。 いい銃を失くしてしまいました。"}, {"type": "subtitle", "time": 4304.63, "timestamp": "01:11:44", "text": "。   ちくしょう"}, {"type": "subtitle", "time": 4307.03, "timestamp": "01:11:47", "text": "。   ああ、なんてことだ"}]
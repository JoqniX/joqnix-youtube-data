[{"type": "subtitle", "time": 421.749, "timestamp": "00:07:01", "text": "所以，（笑聲）"}, {"type": "subtitle", "time": 424.39, "timestamp": "00:07:04", "text": "今年這個時候我們沒能做到。"}, {"type": "subtitle", "time": 427.749, "timestamp": "00:07:07", "text": "但沒關係。明年，"}, {"type": "subtitle", "time": 430.629, "timestamp": "00:07:10", "text": "明年我們就可以做了，"}, {"type": "subtitle", "time": 433.029, "timestamp": "00:07:13", "text": "為什麼不呢？明年我們必須這麼做，"}, {"type": "subtitle", "time": 434.95, "timestamp": "00:07:14", "text": "因為我將獨自一人。我不會有"}, {"type": "subtitle", "time": 438.79, "timestamp": "00:07:18", "text": "任何家人之類的關係。所以，這算是個好消息吧"}, {"type": "subtitle", "time": 442.39, "timestamp": "00:07:22", "text": "。哇。  是的"}, {"type": "subtitle", "time": 444.74, "timestamp": "00:07:24", "text": "。明年我們就能做這件事了。"}, {"type": "subtitle", "time": 445.909, "timestamp": "00:07:25", "text": "[笑聲]"}, {"type": "subtitle", "time": 453.43, "timestamp": "00:07:33", "text": "好的。"}, {"type": "subtitle", "time": 455.99, "timestamp": "00:07:35", "text": "我的嗓子一直很不舒服。所以今天"}, {"type": "subtitle", "time": 458.30899999999997, "timestamp": "00:07:38", "text": "我也要打掃我的房間。我的"}, {"type": "subtitle", "time": 460.87, "timestamp": "00:07:40", "text": "辦公室。嗯，我的直播"}, {"type": "subtitle", "time": 462.55, "timestamp": "00:07:42", "text": "間。"}, {"type": "subtitle", "time": 466.07, "timestamp": "00:07:46", "text": "所以，嗯，我"}, {"type": "subtitle", "time": 470.55, "timestamp": "00:07:50", "text": "不太確定什麼時候"}, {"type": "subtitle", "time": 476.71, "timestamp": "00:07:56", "text": "下車，但我計劃在…嗯，"}]
[{"type": "subtitle", "time": 2768.95, "timestamp": "00:46:08", "text": "怎麼會"}, {"type": "subtitle", "time": 2779.589, "timestamp": "00:46:19", "text": "我們得到的刷新點和上次一樣。有趣的。  好的，阿魯斯。正確的。  阿波羅在說話。突襲者，你帶手榴彈了嗎？我的新設計在紙上看起來很棒，但我需要找人把它們放到機器上測試一下才能確定效果"}, {"type": "chat", "time": 2783.506, "timestamp": "00:46:23", "author": "@ObnoxiousAgnostic", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kVrH3KET_eX7LDEi_ka-c3eoI3J-Vcy4GX19VQNPnWwZQ=s64-c-k-c0x00ffffff-no-rj", "message": "Statistics is hard."}, {"type": "subtitle", "time": 2805.109, "timestamp": "00:46:45", "text": "我需要找個點煙器鑰匙之類的東西。  哪裡有煙，哪裡就有弧線。  我爸爸付的錢。"}]
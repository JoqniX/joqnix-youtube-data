[{"type": "subtitle", "time": 362.71, "timestamp": "00:06:02", "text": "讓我先把這個放上來，然後開始吧"}, {"type": "subtitle", "time": 365.67, "timestamp": "00:06:05", "text": "。"}, {"type": "subtitle", "time": 368.55, "timestamp": "00:06:08", "text": "讓我把今天的連結寄給你。"}, {"type": "subtitle", "time": 371.27, "timestamp": "00:06:11", "text": "哦，是的。大家聖誕節"}, {"type": "subtitle", "time": 373.51, "timestamp": "00:06:13", "text": "過得怎麼樣？你做了什麼"}, {"type": "subtitle", "time": 375.43, "timestamp": "00:06:15", "text": "？你展示了什麼？你做了什麼"}, {"type": "subtitle", "time": 383.909, "timestamp": "00:06:23", "text": "聖誕節收到了什麼禮物？  你們聖誕節收到了什麼禮物？"}, {"type": "subtitle", "time": 389.11, "timestamp": "00:06:29", "text": "對我來說，我本來"}, {"type": "subtitle", "time": 392.39, "timestamp": "00:06:32", "text": "想做個聖誕直播，就像"}, {"type": "subtitle", "time": 396.07, "timestamp": "00:06:36", "text": "昨天那樣，"}, {"type": "subtitle", "time": 399.189, "timestamp": "00:06:39", "text": "但我感覺很不舒服。另外，我也"}, {"type": "subtitle", "time": 400.629, "timestamp": "00:06:40", "text": "想多花點時間和"}, {"type": "subtitle", "time": 402.629, "timestamp": "00:06:42", "text": "家人在一起。"}, {"type": "subtitle", "time": 406.39, "timestamp": "00:06:46", "text": "所以，我昨天就這麼做了。"}, {"type": "subtitle", "time": 408.87, "timestamp": "00:06:48", "text": "但沒關係。就像我們以前通常會準備"}, {"type": "subtitle", "time": 411.83, "timestamp": "00:06:51", "text": "一個聖誕樹之類的東西，然後把"}, {"type": "subtitle", "time": 414.07, "timestamp": "00:06:54", "text": "所有人都放在那個聖誕樹旁邊"}, {"type": "subtitle", "time": 416.469, "timestamp": "00:06:56", "text": "，對吧？我們以前就是這麼做的"}, {"type": "subtitle", "time": 418.95, "timestamp": "00:06:58", "text": "。"}]
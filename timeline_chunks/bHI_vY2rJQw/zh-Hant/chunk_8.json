[{"type": "subtitle", "time": 480.07, "timestamp": "00:08:00", "text": "讓我想想，我計劃在"}, {"type": "subtitle", "time": 484.79, "timestamp": "00:08:04", "text": "中午之前下車，大概下午1點左右。"}, {"type": "subtitle", "time": 487.029, "timestamp": "00:08:07", "text": "至少"}, {"type": "subtitle", "time": 492.15, "timestamp": "00:08:12", "text": "今天是這樣。嗯，希望一切順利。"}, {"type": "subtitle", "time": 495.189, "timestamp": "00:08:15", "text": "H：所以，我們將進行一到兩個小時的"}, {"type": "subtitle", "time": 501.51, "timestamp": "00:08:21", "text": "所以，在本週結束之前，今天是"}, {"type": "subtitle", "time": 504.71, "timestamp": "00:08:24", "text": "星期五。我想做的就是完成那些試煉"}, {"type": "subtitle", "time": 507.029, "timestamp": "00:08:27", "text": "，就是"}, {"type": "subtitle", "time": 509.35, "timestamp": "00:08:29", "text": "每週的試煉，對吧？我把"}, {"type": "subtitle", "time": 511.909, "timestamp": "00:08:31", "text": "它們都完成了。所以，我們"}, {"type": "subtitle", "time": 515.029, "timestamp": "00:08:35", "text": "今天將重點討論這個問題。"}, {"type": "subtitle", "time": 518.949, "timestamp": "00:08:38", "text": "呃，我差不多有五十萬了。我得了"}, {"type": "subtitle", "time": 526.07, "timestamp": "00:08:46", "text": "進展順利。"}, {"type": "subtitle", "time": 528.71, "timestamp": "00:08:48", "text": "嗯，我很快就要賺到我的第一個一百萬了"}, {"type": "subtitle", "time": 533.43, "timestamp": "00:08:53", "text": "。我對此感到很興奮。"}, {"type": "subtitle", "time": 536.71, "timestamp": "00:08:56", "text": "那真是太好了。"}, {"type": "subtitle", "time": 538.87, "timestamp": "00:08:58", "text": "呃，"}]
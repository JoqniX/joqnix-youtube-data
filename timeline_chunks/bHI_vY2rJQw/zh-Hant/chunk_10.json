[{"type": "subtitle", "time": 601.11, "timestamp": "00:10:01", "text": "新的掠奪者卡組不是今天"}, {"type": "subtitle", "time": 603.99, "timestamp": "00:10:03", "text": "發布嗎？還是明天？"}, {"type": "subtitle", "time": 605.67, "timestamp": "00:10:05", "text": "我"}, {"type": "subtitle", "time": 607.509, "timestamp": "00:10:07", "text": "完全忘記了。我想應該是今天吧"}, {"type": "subtitle", "time": 610.31, "timestamp": "00:10:10", "text": "？我想應該是今天。新的"}, {"type": "subtitle", "time": 616.31, "timestamp": "00:10:16", "text": "冬季守門員皮膚。"}, {"type": "subtitle", "time": 619.11, "timestamp": "00:10:19", "text": "這款皮膚真酷。我非常想要"}, {"type": "subtitle", "time": 621.91, "timestamp": "00:10:21", "text": "它。"}, {"type": "subtitle", "time": 626.31, "timestamp": "00:10:26", "text": "為此，我必須完成每日任務。"}, {"type": "subtitle", "time": 629.269, "timestamp": "00:10:29", "text": "這有點奇怪，不過，是的，"}, {"type": "subtitle", "time": 651.91, "timestamp": "00:10:51", "text": "好的，請稍等片刻。  這只是些瑣事。  好了，"}, {"type": "subtitle", "time": 658.23, "timestamp": "00:10:58", "text": "呃，"}]
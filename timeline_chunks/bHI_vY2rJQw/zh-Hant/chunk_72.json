[{"type": "subtitle", "time": 4322.87, "timestamp": "01:12:02", "text": "我覺得我還活著。我能做些什麼"}, {"type": "subtitle", "time": 4325.35, "timestamp": "01:12:05", "text": "？"}, {"type": "subtitle", "time": 4327.669, "timestamp": "01:12:07", "text": "哦，"}, {"type": "subtitle", "time": 4345.03, "timestamp": "01:12:25", "text": "兩個彈簧鉤。  哦，我錯失良機了。我的天啊。我把那把好槍弄丟了。  我失去了"}, {"type": "subtitle", "time": 4357.91, "timestamp": "01:12:37", "text": "這項權利。"}, {"type": "subtitle", "time": 4373.99, "timestamp": "01:12:53", "text": "我的天啊。兄弟，我把那把好槍弄丟了。我丟了一把好槍。"}]
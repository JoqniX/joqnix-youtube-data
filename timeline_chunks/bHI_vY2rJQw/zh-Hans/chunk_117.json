[{"type": "subtitle", "time": 7040.07, "timestamp": "01:57:20", "text": "我听到火箭声。 我的天哪，他被"}, {"type": "subtitle", "time": 7043.03, "timestamp": "01:57:23", "text": "锁住了。"}, {"type": "subtitle", "time": 7051.669, "timestamp": "01:57:31", "text": "走，走，走，走，走，走，走，走。"}, {"type": "subtitle", "time": 7065.03, "timestamp": "01:57:45", "text": "你好，培根。 你好。 你好。 我只是"}, {"type": "subtitle", "time": 7068.31, "timestamp": "01:57:48", "text": "在 Cole Snap 里做一些试玩而已。"}, {"type": "subtitle", "time": 7070.55, "timestamp": "01:57:50", "text": "欢迎。 欢迎。"}, {"type": "subtitle", "time": 7075.83, "timestamp": "01:57:55", "text": "你知道吗，我被一只愚蠢的黄蜂弄死了，"}, {"type": "subtitle", "time": 7079.91, "timestamp": "01:57:59", "text": "我还丢了三个我为了"}]
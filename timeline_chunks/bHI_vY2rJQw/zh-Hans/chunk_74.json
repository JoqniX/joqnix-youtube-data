[{"type": "subtitle", "time": 4440.709, "timestamp": "01:14:00", "text": "我只有这一件吗？ 你"}, {"type": "subtitle", "time": 4448.709, "timestamp": "01:14:08", "text": "我的天哪，我穷死了。"}, {"type": "subtitle", "time": 4461.51, "timestamp": "01:14:21", "text": "请告诉我以及我的兄弟们，这句话用中文怎么说"}, {"type": "subtitle", "time": 4480.87, "timestamp": "01:14:40", "text": "你好。 祝你圣诞快乐。"}]
[{"type": "subtitle", "time": 1801.029, "timestamp": "00:30:01", "text": "哦，我们有三个。"}, {"type": "subtitle", "time": 1803.19, "timestamp": "00:30:03", "text": "哦，我们完成挑战了。 打扰一下"}, {"type": "subtitle", "time": 1807.19, "timestamp": "00:30:07", "text": "。 等等，我们已经完成了。"}, {"type": "subtitle", "time": 1808.63, "timestamp": "00:30:08", "text": "等等，等等，等等，等等。 我们真的"}, {"type": "subtitle", "time": 1810.789, "timestamp": "00:30:10", "text": "完成了。 哦，等等。 我再买一个"}, {"type": "subtitle", "time": 1813.19, "timestamp": "00:30:13", "text": "。"}, {"type": "subtitle", "time": 1815.51, "timestamp": "00:30:15", "text": "所以，我们没事。 好的。 但是，是的，我们还得"}, {"type": "subtitle", "time": 1818.789, "timestamp": "00:30:18", "text": "完成第一波外壳的清理工作"}, {"type": "subtitle", "time": 1831.99, "timestamp": "00:30:31", "text": "柠檬应该能增加生命值。 不。"}, {"type": "subtitle", "time": 1834.549, "timestamp": "00:30:34", "text": "哦，没事了。"}, {"type": "subtitle", "time": 1837.669, "timestamp": "00:30:37", "text": "哦，是的。"}]
[{"type": "subtitle", "time": 4160.229, "timestamp": "01:09:20", "text": "我买了30个，我花了40000买的，"}, {"type": "subtitle", "time": 4162.63, "timestamp": "01:09:22", "text": "兄弟，他跑了，"}, {"type": "subtitle", "time": 4169.767, "timestamp": "01:09:29", "text": "我的跳跃者"}, {"type": "subtitle", "time": 4184.149, "timestamp": "01:09:44", "text": "呃，你可以掠夺我。 我要死了。"}, {"type": "subtitle", "time": 4193.749, "timestamp": "01:09:53", "text": "兄弟。 我的电钻钎焊机。 我忘了把它放进"}, {"type": "subtitle", "time": 4197.59, "timestamp": "01:09:57", "text": "安全口袋里。 不。"}]
[{"type": "subtitle", "time": 3788.23, "timestamp": "01:03:08", "text": "我们来这里务农。 我出生在哪里？"}, {"type": "subtitle", "time": 3791.829, "timestamp": "01:03:11", "text": "这次我出生在郊区。"}, {"type": "subtitle", "time": 3794.63, "timestamp": "01:03:14", "text": "有意思。"}, {"type": "subtitle", "time": 3801.109, "timestamp": "01:03:21", "text": "我是塞莱斯特。 温馨"}, {"type": "subtitle", "time": 3802.71, "timestamp": "01:03:22", "text": "提示：请留意"}, {"type": "subtitle", "time": 3805.43, "timestamp": "01:03:25", "text": "田纳西州的打捞地点。 这或许正是"}, {"type": "subtitle", "time": 3806.87, "timestamp": "01:03:26", "text": "我们需要的，能让她尽到自己的"}, {"type": "subtitle", "time": 3831.75, "timestamp": "01:03:51", "text": "好的。 一。"}]
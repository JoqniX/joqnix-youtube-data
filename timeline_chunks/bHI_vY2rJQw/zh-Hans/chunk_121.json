[{"type": "subtitle", "time": 7263.91, "timestamp": "02:01:03", "text": "此外，我们还需要消灭一些哨兵"}, {"type": "subtitle", "time": 7270.47, "timestamp": "02:01:10", "text": "哦，是的。"}, {"type": "subtitle", "time": 7273.99, "timestamp": "02:01:13", "text": "消灭一切的最佳方法就是"}, {"type": "subtitle", "time": 7278.709, "timestamp": "02:01:18", "text": "获得"}, {"type": "subtitle", "time": 7282.229, "timestamp": "02:01:22", "text": "尘埃罐的蓝图，而尘埃罐的蓝图又是……"}, {"type": "subtitle", "time": 7294.95, "timestamp": "02:01:34", "text": "手榴弹。"}, {"type": "subtitle", "time": 7296.229, "timestamp": "02:01:36", "text": "想要一个舒适的家，"}, {"type": "subtitle", "time": 7297.75, "timestamp": "02:01:37", "text": "可以放松身心，这"}, {"type": "subtitle", "time": 7302.39, "timestamp": "02:01:42", "text": "也行得通。"}, {"type": "subtitle", "time": 7305.27, "timestamp": "02:01:45", "text": "我必须一次性杀死跳跃者。 不，"}, {"type": "subtitle", "time": 7308.79, "timestamp": "02:01:48", "text": "那才是难点所在。 不难，但是，是的"}, {"type": "subtitle", "time": 7313.109, "timestamp": "02:01:53", "text": "，我需要这些东西。 好的，通话"}, {"type": "subtitle", "time": 7317.189, "timestamp": "02:01:57", "text": "改到这里了。 哦"}]
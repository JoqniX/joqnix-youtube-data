[{"type": "subtitle", "time": 421.749, "timestamp": "00:07:01", "text": "所以，（笑声）"}, {"type": "subtitle", "time": 424.39, "timestamp": "00:07:04", "text": "今年这个时候我们没能做到。"}, {"type": "subtitle", "time": 427.749, "timestamp": "00:07:07", "text": "但没关系。 明年，"}, {"type": "subtitle", "time": 430.629, "timestamp": "00:07:10", "text": "明年我们就可以做了，"}, {"type": "subtitle", "time": 433.029, "timestamp": "00:07:13", "text": "为什么不呢？ 明年我们必须这么做，"}, {"type": "subtitle", "time": 434.95, "timestamp": "00:07:14", "text": "因为我将独自一人。 我不会有"}, {"type": "subtitle", "time": 438.79, "timestamp": "00:07:18", "text": "任何家人之类的关系。 所以，这算是个好消息吧"}, {"type": "subtitle", "time": 442.39, "timestamp": "00:07:22", "text": "。 哇。   是的"}, {"type": "subtitle", "time": 444.74, "timestamp": "00:07:24", "text": "。 明年我们就能做这件事了。"}, {"type": "subtitle", "time": 445.909, "timestamp": "00:07:25", "text": "[笑声]"}, {"type": "subtitle", "time": 453.43, "timestamp": "00:07:33", "text": "好的。"}, {"type": "subtitle", "time": 455.99, "timestamp": "00:07:35", "text": "我的嗓子一直很不舒服。 所以今天"}, {"type": "subtitle", "time": 458.30899999999997, "timestamp": "00:07:38", "text": "我也要打扫一下我的房间。 我的"}, {"type": "subtitle", "time": 460.87, "timestamp": "00:07:40", "text": "办公室。 嗯，我的直播"}, {"type": "subtitle", "time": 462.55, "timestamp": "00:07:42", "text": "间。"}, {"type": "subtitle", "time": 466.07, "timestamp": "00:07:46", "text": "所以，嗯，我"}, {"type": "subtitle", "time": 470.55, "timestamp": "00:07:50", "text": "不太确定什么时候"}, {"type": "subtitle", "time": 476.71, "timestamp": "00:07:56", "text": "下车，但我计划在……嗯，"}]
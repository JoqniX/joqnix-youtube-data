[{"type": "subtitle", "time": 3124.95, "timestamp": "00:52:04", "text": "[呻吟]"}, {"type": "subtitle", "time": 3139.19, "timestamp": "00:52:19", "text": "他在哪儿？"}, {"type": "subtitle", "time": 3156.79, "timestamp": "00:52:36", "text": "我的天啊。 一对一 SP。 没关系。"}, {"type": "subtitle", "time": 3158.47, "timestamp": "00:52:38", "text": "没关系。 别这么做。 别"}, {"type": "subtitle", "time": 3161.75, "timestamp": "00:52:41", "text": "这么做，乔克。 别这么做。 别这么做。"}, {"type": "subtitle", "time": 3165.27, "timestamp": "00:52:45", "text": "他不值得。"}, {"type": "subtitle", "time": 3174.309, "timestamp": "00:52:54", "text": "别开枪。"}]
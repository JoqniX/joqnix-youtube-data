[{"type": "subtitle", "time": 4630.709, "timestamp": "01:17:10", "text": "我的天啊。 等等，我把垃圾运过来"}, {"type": "subtitle", "time": 4638.63, "timestamp": "01:17:18", "text": "我浪费了体力。 好的，等等。"}, {"type": "subtitle", "time": 4643.75, "timestamp": "01:17:23", "text": "所以，严格来说，跳跃者的生成点有，"}, {"type": "subtitle", "time": 4646.229, "timestamp": "01:17:26", "text": "让我查一下，"}, {"type": "subtitle", "time": 4648.31, "timestamp": "01:17:28", "text": "有四个，呃，五个生成"}, {"type": "chat", "time": 4649.479, "timestamp": "01:17:29", "author": "@ObnoxiousAgnostic", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kVrH3KET_eX7LDEi_ka-c3eoI3J-Vcy4GX19VQNPnWwZQ=s64-c-k-c0x00ffffff-no-rj", "message": "My mentor at the Jain temple taught me the navkar mantra. She also told me that, even though the svastik is a symbol in Jainism, I still shouldn’t drive with one on my rear bumper."}, {"type": "subtitle", "time": 4651.83, "timestamp": "01:17:31", "text": "点。 所以，这边有一个。"}, {"type": "subtitle", "time": 4654.07, "timestamp": "01:17:34", "text": "这里有一个。 这就是我们上一场"}, {"type": "subtitle", "time": 4659.59, "timestamp": "01:17:39", "text": "比赛遇到的问题。 还有另外三个人也在这里。"}]
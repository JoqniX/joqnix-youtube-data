[{"type": "subtitle", "time": 3723.829, "timestamp": "01:02:03", "text": "好的。 足够接近。 快点。"}, {"type": "subtitle", "time": 3726.47, "timestamp": "01:02:06", "text": "我们先生成一个跳跃者，然后等待"}, {"type": "subtitle", "time": 3732.069, "timestamp": "01:02:12", "text": "第二个跳跃者在 8 分钟内出现。"}, {"type": "subtitle", "time": 3735.67, "timestamp": "01:02:15", "text": "到那时，我做了这件事，这件事就成了事实"}, {"type": "subtitle", "time": 3739.51, "timestamp": "01:02:19", "text": "。"}, {"type": "subtitle", "time": 3742.39, "timestamp": "01:02:22", "text": "我们需要杀死大约八只厚毛虫。"}, {"type": "subtitle", "time": 3745.51, "timestamp": "01:02:25", "text": "厚度为 8 至 12。"}]
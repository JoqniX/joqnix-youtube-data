[{"type": "subtitle", "time": 362.71, "timestamp": "00:06:02", "text": "让我先把这个放上来，然后开始吧"}, {"type": "subtitle", "time": 365.67, "timestamp": "00:06:05", "text": "。"}, {"type": "subtitle", "time": 368.55, "timestamp": "00:06:08", "text": "让我把今天的链接发给你。"}, {"type": "subtitle", "time": 371.27, "timestamp": "00:06:11", "text": "哦，是的。 大家圣诞节过得怎么样"}, {"type": "subtitle", "time": 373.51, "timestamp": "00:06:13", "text": "？ 你做了什么？ 你"}, {"type": "subtitle", "time": 375.43, "timestamp": "00:06:15", "text": "展示了什么？ 你做了什么？ 你圣诞节收到了什么礼物"}, {"type": "subtitle", "time": 383.909, "timestamp": "00:06:23", "text": "你们圣诞节收到了什么礼物？"}, {"type": "subtitle", "time": 389.11, "timestamp": "00:06:29", "text": "对我来说，我本来"}, {"type": "subtitle", "time": 392.39, "timestamp": "00:06:32", "text": "想做个圣诞直播，就像"}, {"type": "subtitle", "time": 396.07, "timestamp": "00:06:36", "text": "昨天那样，"}, {"type": "subtitle", "time": 399.189, "timestamp": "00:06:39", "text": "但我感觉很不舒服。 另外，我也"}, {"type": "subtitle", "time": 400.629, "timestamp": "00:06:40", "text": "想多花些时间和"}, {"type": "subtitle", "time": 402.629, "timestamp": "00:06:42", "text": "家人在一起。"}, {"type": "subtitle", "time": 406.39, "timestamp": "00:06:46", "text": "所以，我昨天就这么做了。"}, {"type": "subtitle", "time": 408.87, "timestamp": "00:06:48", "text": "但没关系。 就像我们以前通常会准备"}, {"type": "subtitle", "time": 411.83, "timestamp": "00:06:51", "text": "一个圣诞树之类的东西，然后把"}, {"type": "subtitle", "time": 414.07, "timestamp": "00:06:54", "text": "所有人都放在那个圣诞树旁边"}, {"type": "subtitle", "time": 416.469, "timestamp": "00:06:56", "text": "，对吧？ 我们以前就是这么做的"}, {"type": "subtitle", "time": 418.95, "timestamp": "00:06:58", "text": "。"}]
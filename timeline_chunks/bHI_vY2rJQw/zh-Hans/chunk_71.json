[{"type": "subtitle", "time": 4273.669, "timestamp": "01:11:13", "text": "所以，这将是我的第二个快"}, {"type": "subtitle", "time": 4276.55, "timestamp": "01:11:16", "text": "钩，对吧？   我们"}, {"type": "subtitle", "time": 4283.75, "timestamp": "01:11:23", "text": "哦，我错失了良机。 我的天啊。 我把那把"}, {"type": "subtitle", "time": 4291.03, "timestamp": "01:11:31", "text": "我失去了这项权利。 我的天啊。 兄弟，我把那把好枪弄丢了"}, {"type": "subtitle", "time": 4298.87, "timestamp": "01:11:38", "text": "。 我丢了一把好枪。"}, {"type": "subtitle", "time": 4304.63, "timestamp": "01:11:44", "text": "该死。"}]
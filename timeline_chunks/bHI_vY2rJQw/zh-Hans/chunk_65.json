[{"type": "subtitle", "time": 3910.069, "timestamp": "01:05:10", "text": "我买这些火山口的时候，它们并没有打折"}, {"type": "subtitle", "time": 3914.789, "timestamp": "01:05:14", "text": "。 所以，我不得不花了2400卢比，"}, {"type": "subtitle", "time": 3919.27, "timestamp": "01:05:19", "text": "我后悔了。 不，我不后悔。"}, {"type": "subtitle", "time": 3922.069, "timestamp": "01:05:22", "text": "就像培根在冬季促销时买的一样。"}, {"type": "subtitle", "time": 3924.71, "timestamp": "01:05:24", "text": "所以，大概只有1900左右"}, {"type": "subtitle", "time": 3926.549, "timestamp": "01:05:26", "text": "。"}, {"type": "subtitle", "time": 3938.549, "timestamp": "01:05:38", "text": "，"}, {"type": "subtitle", "time": 3941.51, "timestamp": "01:05:41", "text": "我一直没"}, {"type": "subtitle", "time": 3943.589, "timestamp": "01:05:43", "text": "玩过"}, {"type": "subtitle", "time": 3950.95, "timestamp": "01:05:50", "text": "我想在《马拉松》上映的时候入手"}, {"type": "subtitle", "time": 3954.63, "timestamp": "01:05:54", "text": "。 我不确定我会不会玩，因为"}, {"type": "subtitle", "time": 3957.029, "timestamp": "01:05:57", "text": "我在艺术创作者游戏中玩得很开心，但是"}]
[{"type": "subtitle", "time": 4741.03, "timestamp": "01:19:01", "text": "我们从中央"}, {"type": "subtitle", "time": 4744.31, "timestamp": "01:19:04", "text": "沼泽升降机这里提取物资。"}, {"type": "subtitle", "time": 4763.35, "timestamp": "01:19:23", "text": "如果我们足够幸运，就能找到一个跳跃者。"}, {"type": "subtitle", "time": 4787.75, "timestamp": "01:19:47", "text": "这并非被掠夺的物品。 没有人来。"}]
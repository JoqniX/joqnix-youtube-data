[{"type": "subtitle", "time": 480.07, "timestamp": "00:08:00", "text": "让我想想，我计划在"}, {"type": "subtitle", "time": 484.79, "timestamp": "00:08:04", "text": "中午之前下车，大概下午1点左右。 至少"}, {"type": "subtitle", "time": 492.15, "timestamp": "00:08:12", "text": "今天是这样。 嗯，希望一切顺利。"}, {"type": "subtitle", "time": 495.189, "timestamp": "00:08:15", "text": "H：所以，我们将进行一到两个小时的"}, {"type": "subtitle", "time": 501.51, "timestamp": "00:08:21", "text": "所以，在本周结束之前，今天是"}, {"type": "subtitle", "time": 504.71, "timestamp": "00:08:24", "text": "星期五。 我想做的就是完成那些试炼"}, {"type": "subtitle", "time": 507.029, "timestamp": "00:08:27", "text": "，就是"}, {"type": "subtitle", "time": 509.35, "timestamp": "00:08:29", "text": "每周的试炼，对吧？ 我把"}, {"type": "subtitle", "time": 511.909, "timestamp": "00:08:31", "text": "它们都完成了。 所以，我们"}, {"type": "subtitle", "time": 515.029, "timestamp": "00:08:35", "text": "今天将重点讨论这个问题。"}, {"type": "subtitle", "time": 518.949, "timestamp": "00:08:38", "text": "呃，我差不多有五十万了。 我得了"}, {"type": "subtitle", "time": 526.07, "timestamp": "00:08:46", "text": "进展顺利。"}, {"type": "subtitle", "time": 528.71, "timestamp": "00:08:48", "text": "嗯，我很快就要赚到我的第一个一百万了"}, {"type": "subtitle", "time": 533.43, "timestamp": "00:08:53", "text": "。 我对此感到很兴奋。"}, {"type": "subtitle", "time": 536.71, "timestamp": "00:08:56", "text": "那真是太好了。"}, {"type": "subtitle", "time": 538.87, "timestamp": "00:08:58", "text": "呃，"}]
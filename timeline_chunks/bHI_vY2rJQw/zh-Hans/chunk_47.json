[{"type": "subtitle", "time": 2838.47, "timestamp": "00:47:18", "text": "印度人认为中国人是什么样的"}, {"type": "subtitle", "time": 2841.109, "timestamp": "00:47:21", "text": "人？ 我不知道。 我觉得他们"}, {"type": "subtitle", "time": 2843.43, "timestamp": "00:47:23", "text": "很酷。 他们的文化和"}, {"type": "subtitle", "time": 2851.109, "timestamp": "00:47:31", "text": "我无法代表其他人发言。 我只能"}, {"type": "subtitle", "time": 2873.19, "timestamp": "00:47:53", "text": "我这边还需要短信。"}]
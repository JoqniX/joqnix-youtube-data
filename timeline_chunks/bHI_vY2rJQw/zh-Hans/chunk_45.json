[{"type": "subtitle", "time": 2701.349, "timestamp": "00:45:01", "text": "圣诞快乐！ 我一点也不傻。"}, {"type": "subtitle", "time": 2710.71, "timestamp": "00:45:10", "text": "好的，我们得到的刷新点和上次一样"}, {"type": "subtitle", "time": 2714.15, "timestamp": "00:45:14", "text": "。 有趣的。"}, {"type": "subtitle", "time": 2721.43, "timestamp": "00:45:21", "text": "阿波罗在说话。"}, {"type": "subtitle", "time": 2723.43, "timestamp": "00:45:23", "text": "突袭者，你带手榴弹了吗？ 我的新设计"}, {"type": "subtitle", "time": 2725.19, "timestamp": "00:45:25", "text": "在纸上看起来很棒，但我需要找人把"}, {"type": "subtitle", "time": 2726.47, "timestamp": "00:45:26", "text": "它们放到机器上测试一下才能确定效果"}, {"type": "chat", "time": 2735.247, "timestamp": "00:45:35", "author": "@ObnoxiousAgnostic", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kVrH3KET_eX7LDEi_ka-c3eoI3J-Vcy4GX19VQNPnWwZQ=s64-c-k-c0x00ffffff-no-rj", "message": "I’m not just sad about failing. I feel guilty because my dad paid for it."}]
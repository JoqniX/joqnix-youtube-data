[{"type": "subtitle", "time": 7803.03, "timestamp": "02:10:03", "text": "只见那女人。"}, {"type": "subtitle", "time": 7804.95, "timestamp": "02:10:04", "text": "是的。我不知道。我不知道该怎么办"}, {"type": "subtitle", "time": 7809.03, "timestamp": "02:10:09", "text": "如何处理这件事。好吧，我没事，没事的。"}, {"type": "subtitle", "time": 7810.55, "timestamp": "02:10:10", "text": "好的。我们抓到小丑前辈了。不"}, {"type": "subtitle", "time": 7812.87, "timestamp": "02:10:12", "text": "别担心。哦，等等。哪个服务器"}, {"type": "subtitle", "time": 7815.27, "timestamp": "02:10:15", "text": "这是吗？孟买还是新加坡？它是"}, {"type": "subtitle", "time": 7818.79, "timestamp": "02:10:18", "text": "新加坡。哦好的。是的，就是这样。"}, {"type": "subtitle", "time": 7824.95, "timestamp": "02:10:24", "text": "哦，等等。没人注意中场。"}, {"type": "subtitle", "time": 7837.35, "timestamp": "02:10:37", "text": "这里是诱饵。"}, {"type": "subtitle", "time": 7840.149, "timestamp": "02:10:40", "text": "敌人众多。一个"}, {"type": "subtitle", "time": 7843.109, "timestamp": "02:10:43", "text": "诱饵。费用已用完。别招惹"}, {"type": "subtitle", "time": 7853.229, "timestamp": "02:10:53", "text": "哦，他们都在这里。"}, {"type": "subtitle", "time": 7856.95, "timestamp": "02:10:56", "text": "是的，他们排名中等。"}]
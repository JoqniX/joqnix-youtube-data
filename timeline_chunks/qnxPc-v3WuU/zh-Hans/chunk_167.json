[{"type": "subtitle", "time": 10022.79, "timestamp": "02:47:02", "text": "但你好像很欣赏这种勇气之类的东西。"}, {"type": "subtitle", "time": 10025.11, "timestamp": "02:47:05", "text": "就像她主动来找我一样。她正从……来"}, {"type": "subtitle", "time": 10028.95, "timestamp": "02:47:08", "text": "B 随机。过来一下。还剩30秒。"}, {"type": "subtitle", "time": 10031.429, "timestamp": "02:47:11", "text": "还剩一个敌人。最后一名玩家"}, {"type": "subtitle", "time": 10039.19, "timestamp": "02:47:19", "text": "别叫我V，我会叫你V。就这么定了。"}, {"type": "subtitle", "time": 10042.63, "timestamp": "02:47:22", "text": "就像《赛博朋克V》一样。"}, {"type": "subtitle", "time": 10044.11, "timestamp": "02:47:24", "text": "主要的"}, {"type": "subtitle", "time": 10047.75, "timestamp": "02:47:27", "text": "五星好评。"}, {"type": "subtitle", "time": 10050.309, "timestamp": "02:47:30", "text": "我们走吧。"}, {"type": "subtitle", "time": 10054.71, "timestamp": "02:47:34", "text": "我的天啊。搞什么鬼？"}, {"type": "subtitle", "time": 10061.269, "timestamp": "02:47:41", "text": "天哪。等等，等等，等等，等等，等等。做"}, {"type": "subtitle", "time": 10064.23, "timestamp": "02:47:44", "text": "哦，是的，你确实有。你永远不会"}, {"type": "subtitle", "time": 10066.469, "timestamp": "02:47:46", "text": "头脑。不要靠近我。你 你有"}, {"type": "subtitle", "time": 10069.59, "timestamp": "02:47:49", "text": "战斗通行证皮肤。"}, {"type": "subtitle", "time": 10072.07, "timestamp": "02:47:52", "text": "老兄，那甚至都不想杀人。"}, {"type": "subtitle", "time": 10076.23, "timestamp": "02:47:56", "text": "哦，你还有这个。好的，"}]
[{"type": "subtitle", "time": 5653.75, "timestamp": "01:34:13", "text": "是的。他击杀了敌人。喂。我想得到"}, {"type": "subtitle", "time": 5655.07, "timestamp": "01:34:15", "text": "一把刀。去"}, {"type": "subtitle", "time": 5664.07, "timestamp": "01:34:24", "text": "刀。啊。"}, {"type": "subtitle", "time": 5666.31, "timestamp": "01:34:26", "text": "我没拿到刀是不会走的。"}, {"type": "subtitle", "time": 5673.43, "timestamp": "01:34:33", "text": "对不起。我不会买刀。"}, {"type": "subtitle", "time": 5681.59, "timestamp": "01:34:41", "text": "一秒钟。我接到一个电话，呃……"}, {"type": "subtitle", "time": 5683.83, "timestamp": "01:34:43", "text": "家庭。我的天啊。我需要参加"}, {"type": "subtitle", "time": 5686.79, "timestamp": "01:34:46", "text": "这。等等，我得结束游戏。我"}]
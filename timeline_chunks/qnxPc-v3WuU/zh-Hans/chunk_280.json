[{"type": "subtitle", "time": 16801.19, "timestamp": "04:40:01", "text": "游戏中的任务，所以是"}, {"type": "subtitle", "time": 16804.01, "timestamp": "04:40:04", "text": "技术上免费。"}, {"type": "subtitle", "time": 16806.07, "timestamp": "04:40:06", "text": "[音乐]"}, {"type": "subtitle", "time": 16809.67, "timestamp": "04:40:09", "text": "是的。哦，我身上好像有两层皮肤。"}, {"type": "subtitle", "time": 16813.03, "timestamp": "04:40:13", "text": "另一个账号我也收到了。"}, {"type": "subtitle", "time": 16815.51, "timestamp": "04:40:15", "text": "免费。"}, {"type": "subtitle", "time": 16817.39, "timestamp": "04:40:17", "text": "啊，真糟糕。"}, {"type": "subtitle", "time": 16819.75, "timestamp": "04:40:19", "text": "是啊，这是它唯一的优点。"}, {"type": "subtitle", "time": 16823.19, "timestamp": "04:40:23", "text": "马的竞争对手。如果我能得到我想要的皮肤，"}, {"type": "subtitle", "time": 16825.59, "timestamp": "04:40:25", "text": "我只是尽力玩，而且喜欢做所有事。"}, {"type": "subtitle", "time": 16827.59, "timestamp": "04:40:27", "text": "任务之类的。此外，他们还给予"}, {"type": "subtitle", "time": 16830.23, "timestamp": "04:40:30", "text": "你们这些变态皮肤也一样。我认为"}, {"type": "subtitle", "time": 16834.81, "timestamp": "04:40:34", "text": "人们看到了我用的贝琳牌护肤品。"}, {"type": "subtitle", "time": 16836.67, "timestamp": "04:40:36", "text": "[音乐]"}, {"type": "subtitle", "time": 16839.75, "timestamp": "04:40:39", "text": "是的，那几乎就是M系列的大部分竞争对手。"}, {"type": "subtitle", "time": 16842.628, "timestamp": "04:40:42", "text": "这是一款好游戏。它比"}, {"type": "subtitle", "time": 16847.55, "timestamp": "04:40:47", "text": "我玩过的绝大多数英雄射击游戏"}, {"type": "subtitle", "time": 16850.708, "timestamp": "04:40:50", "text": "亲自。但是，是的，它缺少这一点。"}, {"type": "subtitle", "time": 16853.67, "timestamp": "04:40:53", "text": "首先，它缺少一些东西。"}, {"type": "subtitle", "time": 16856.39, "timestamp": "04:40:56", "text": "PC端优化不多。"}, {"type": "subtitle", "time": 16857.628, "timestamp": "04:40:57", "text": "人们可以玩"}]
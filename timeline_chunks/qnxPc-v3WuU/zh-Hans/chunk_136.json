[{"type": "subtitle", "time": 8162.229, "timestamp": "02:16:02", "text": "好的。等等，富士山在你的聊天记录里。"}, {"type": "subtitle", "time": 8164.95, "timestamp": "02:16:04", "text": "呃，等等。富士山。"}, {"type": "subtitle", "time": 8167.99, "timestamp": "02:16:07", "text": "等等，你刚才不是说富士山吗？我听到了吗？"}, {"type": "subtitle", "time": 8170.91, "timestamp": "02:16:10", "text": "我好像听到了。不，"}, {"type": "subtitle", "time": 8174.31, "timestamp": "02:16:14", "text": "I 到 E。"}, {"type": "subtitle", "time": 8178.069, "timestamp": "02:16:18", "text": "哦，Twitch。花呢。是的，就是这样"}, {"type": "subtitle", "time": 8179.75, "timestamp": "02:16:19", "text": "读出这个名字。好的。发现敌人"}, {"type": "subtitle", "time": 8182.589, "timestamp": "02:16:22", "text": "B."}]
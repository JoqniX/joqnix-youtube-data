[{"type": "subtitle", "time": 7680.83, "timestamp": "02:08:00", "text": "代理人是"}, {"type": "subtitle", "time": 7686.069, "timestamp": "02:08:06", "text": "可能是扫兴的人。当然，我指的是她。"}, {"type": "subtitle", "time": 7688.79, "timestamp": "02:08:08", "text": "真是扫兴。是的。"}, {"type": "subtitle", "time": 7691.75, "timestamp": "02:08:11", "text": "但好像并不是因为她的孩子，或者"}, {"type": "subtitle", "time": 7694.149, "timestamp": "02:08:14", "text": "任何。只是因为她太……"}, {"type": "subtitle", "time": 7697.51, "timestamp": "02:08:17", "text": "书呆子气之类的。"}, {"type": "subtitle", "time": 7703.03, "timestamp": "02:08:23", "text": "你最喜欢的经纪人是谁？"}, {"type": "subtitle", "time": 7704.87, "timestamp": "02:08:24", "text": "氖。"}, {"type": "subtitle", "time": 7706.79, "timestamp": "02:08:26", "text": "好的。但是，呃，你知道吗？"}, {"type": "subtitle", "time": 7710.79, "timestamp": "02:08:30", "text": "《Valerant》的背景故事？嗯，没什么特别的。我没有"}, {"type": "subtitle", "time": 7713.99, "timestamp": "02:08:33", "text": "看过视频了吗？那个"}, {"type": "subtitle", "time": 7717.99, "timestamp": "02:08:37", "text": "各州以及这一点。我懂了。"}, {"type": "subtitle", "time": 7723.91, "timestamp": "02:08:43", "text": "我觉得我们没必要玩这种垃圾游戏。"}, {"type": "subtitle", "time": 7726.87, "timestamp": "02:08:46", "text": "不再是了。"}, {"type": "subtitle", "time": 7731.03, "timestamp": "02:08:51", "text": "什么？死的。哦，那是敌人。为……而死"}, {"type": "subtitle", "time": 7733.189, "timestamp": "02:08:53", "text": "当然。"}, {"type": "subtitle", "time": 7735.51, "timestamp": "02:08:55", "text": "我不会玩《夜曲》，"}, {"type": "subtitle", "time": 7737.75, "timestamp": "02:08:57", "text": "但幸好我们还有培根。培根是"}, {"type": "subtitle", "time": 7739.99, "timestamp": "02:08:59", "text": "我觉得我是个主玩 Yoru 的玩家。他饰演 Yoru，"}]
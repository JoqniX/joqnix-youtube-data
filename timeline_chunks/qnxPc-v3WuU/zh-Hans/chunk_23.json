[{"type": "subtitle", "time": 1387.35, "timestamp": "00:23:07", "text": "什么？是啊，最近一直不太稳定。"}, {"type": "subtitle", "time": 1390.07, "timestamp": "00:23:10", "text": "是的。你好 Ban，欢迎。早上好。"}, {"type": "subtitle", "time": 1392.95, "timestamp": "00:23:12", "text": "希望你周一过得愉快。你好"}, {"type": "subtitle", "time": 1394.87, "timestamp": "00:23:14", "text": "布拉德。希望你一切都好。"}, {"type": "subtitle", "time": 1397.63, "timestamp": "00:23:17", "text": "希望你"}, {"type": "subtitle", "time": 1400.789, "timestamp": "00:23:20", "text": "周一。等等，现在几点了？大多"}, {"type": "subtitle", "time": 1402.39, "timestamp": "00:23:22", "text": "很可能是星期天之类的。"}, {"type": "subtitle", "time": 1405.95, "timestamp": "00:23:25", "text": "正确的？是的，对你们俩来说，就像星期天一样。"}, {"type": "subtitle", "time": 1409.43, "timestamp": "00:23:29", "text": "晚上。我知道现在差不多是午夜了。"}, {"type": "subtitle", "time": 1412.39, "timestamp": "00:23:32", "text": "是的。希望你们今天过得愉快。"}, {"type": "subtitle", "time": 1415.27, "timestamp": "00:23:35", "text": "白天和晚上都过得很顺利。"}, {"type": "subtitle", "time": 1417.669, "timestamp": "00:23:37", "text": "很好。"}, {"type": "subtitle", "time": 1420.909, "timestamp": "00:23:40", "text": "我周一的工作效率如何？"}, {"type": "subtitle", "time": 1424.029, "timestamp": "00:23:44", "text": "不，而且你工作过度了。它是"}, {"type": "subtitle", "time": 1427.029, "timestamp": "00:23:47", "text": "星期日。是的，对你来说今天是星期天。为了"}, {"type": "subtitle", "time": 1428.909, "timestamp": "00:23:48", "text": "是我。"}]
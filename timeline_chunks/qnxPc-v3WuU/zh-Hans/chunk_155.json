[{"type": "subtitle", "time": 9332.87, "timestamp": "02:35:32", "text": "Y，还需要7个人头才能登顶。"}, {"type": "subtitle", "time": 9335.11, "timestamp": "02:35:35", "text": "为什么我总是陷入……"}, {"type": "subtitle", "time": 9337.83, "timestamp": "02:35:37", "text": "交火？好像总是有两个。"}, {"type": "subtitle", "time": 9339.91, "timestamp": "02:35:39", "text": "人们喜欢看我。看看这个。"}, {"type": "subtitle", "time": 9351.83, "timestamp": "02:35:51", "text": "我心想，我知道我不知道，但是……"}, {"type": "subtitle", "time": 9355.99, "timestamp": "02:35:55", "text": "为什么总是两个人？"}]
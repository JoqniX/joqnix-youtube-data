[{"type": "subtitle", "time": 15720.469, "timestamp": "04:22:00", "text": "对某些人来说，这有点像交易。"}, {"type": "subtitle", "time": 15724.229, "timestamp": "04:22:04", "text": "他们。所以感觉就像……"}, {"type": "subtitle", "time": 15726.51, "timestamp": "04:22:06", "text": "数字，为什么这些数字？"}, {"type": "subtitle", "time": 15730.469, "timestamp": "04:22:10", "text": "评判我的地位、我是谁，或者其他任何事"}, {"type": "subtitle", "time": 15733.99, "timestamp": "04:22:13", "text": "为什么会这样等等。是的。我"}, {"type": "subtitle", "time": 15736.229, "timestamp": "04:22:16", "text": "我觉得我当时非常沮丧，或者"}, {"type": "subtitle", "time": 15739.189, "timestamp": "04:22:19", "text": "总有那么一点是对的。是的。"}, {"type": "subtitle", "time": 15742.429, "timestamp": "04:22:22", "text": "在某种程度上，它的发展确实像……"}, {"type": "chat", "time": 15745.297, "timestamp": "04:22:25", "author": "@site36.official", "avatar": "https://yt4.ggpht.com/Oc0kgq4lSUaD-BoDbaDE3pXUquuz47c4Yh7kwPILHO2D70EQ5EnEgoGgTbb5gw993EEXRqCx_A=s64-c-k-c0x00ffffff-no-rj", "message": "Guess what"}, {"type": "subtitle", "time": 15746.71, "timestamp": "04:22:26", "text": "虽然有点害怕与人接触，但"}, {"type": "subtitle", "time": 15756.95, "timestamp": "04:22:36", "text": "即使如此，也会向人们发出信号"}, {"type": "subtitle", "time": 15761.189, "timestamp": "04:22:41", "text": "今天我联系了四个人。"}, {"type": "subtitle", "time": 15765.189, "timestamp": "04:22:45", "text": "希望他们能回应。"}, {"type": "subtitle", "time": 15767.189, "timestamp": "04:22:47", "text": "东西。是的。"}, {"type": "subtitle", "time": 15769.83, "timestamp": "04:22:49", "text": "哦，是的。这难道不说明你在成长吗？"}, {"type": "subtitle", "time": 15772.309, "timestamp": "04:22:52", "text": "因为以前，你不会发短信。"}, {"type": "subtitle", "time": 15775.429, "timestamp": "04:22:55", "text": "有没有人想合作？"}, {"type": "subtitle", "time": 15778.389, "timestamp": "04:22:58", "text": "再看看你现在的样子。每天四个人。"}]
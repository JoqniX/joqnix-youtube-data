[{"type": "subtitle", "time": 12480.15, "timestamp": "03:28:00", "text": "一片混乱。太多了。一片混乱。它是"}, {"type": "subtitle", "time": 12487.67, "timestamp": "03:28:07", "text": "网站上实际有多少人？"}, {"type": "subtitle", "time": 12489.349, "timestamp": "03:28:09", "text": "已经？"}, {"type": "subtitle", "time": 12492.55, "timestamp": "03:28:12", "text": "快的。搞什么鬼？是的，"}, {"type": "subtitle", "time": 12495.03, "timestamp": "03:28:15", "text": "速度非常快。"}, {"type": "subtitle", "time": 12497.11, "timestamp": "03:28:17", "text": "梦。"}, {"type": "subtitle", "time": 12500.07, "timestamp": "03:28:20", "text": "我可以买。哦，没事了。我可以买"}, {"type": "subtitle", "time": 12501.75, "timestamp": "03:28:21", "text": "卖。太多了。感谢上帝"}, {"type": "subtitle", "time": 12505.19, "timestamp": "03:28:25", "text": "没在那里种植。"}, {"type": "subtitle", "time": 12507.11, "timestamp": "03:28:27", "text": "呃，Jo，你可以买盾牌。他没有"}, {"type": "subtitle", "time": 12510.07, "timestamp": "03:28:30", "text": "有盾牌。哦，是的。我只是，我只是"}, {"type": "subtitle", "time": 12520.389, "timestamp": "03:28:40", "text": "手榴弹。"}, {"type": "subtitle", "time": 12528.389, "timestamp": "03:28:48", "text": "嗯？他妈的。"}, {"type": "subtitle", "time": 12532.63, "timestamp": "03:28:52", "text": "你可以推她一把。不。我的天哪。休息"}]
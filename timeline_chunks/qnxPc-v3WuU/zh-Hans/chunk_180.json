[{"type": "subtitle", "time": 10806.469, "timestamp": "03:00:06", "text": "还剩30秒。一起出行。"}, {"type": "subtitle", "time": 10808.349, "timestamp": "03:00:08", "text": "你可以"}, {"type": "subtitle", "time": 10822.23, "timestamp": "03:00:22", "text": "我听到了。取消。为什么？什么？"}, {"type": "subtitle", "time": 10824.469, "timestamp": "03:00:24", "text": "是的，他毫无征兆地取消了。"}, {"type": "subtitle", "time": 10827.19, "timestamp": "03:00:27", "text": "什么？"}, {"type": "subtitle", "time": 10830.389, "timestamp": "03:00:30", "text": "啊，他已经结束了。"}, {"type": "subtitle", "time": 10832.79, "timestamp": "03:00:32", "text": "是的。你好，纳林儿子。你好吗"}, {"type": "subtitle", "time": 10835.75, "timestamp": "03:00:35", "text": "今天做什么？希望你一切都好。你"}, {"type": "subtitle", "time": 10844.87, "timestamp": "03:00:44", "text": "这是个圈套。涓涓细流。"}, {"type": "subtitle", "time": 10847.469, "timestamp": "03:00:47", "text": "我有悟空。他为什么要取消？"}]
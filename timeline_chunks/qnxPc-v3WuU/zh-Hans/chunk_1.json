[{"type": "subtitle", "time": 60.75, "timestamp": "00:01:00", "text": "老鼠。要么我必须"}, {"type": "subtitle", "time": 65.03, "timestamp": "00:01:05", "text": "比如鼠标光标很大。等等，可以"}, {"type": "subtitle", "time": 68.51, "timestamp": "00:01:08", "text": "我更改了控制台大小？更近"}, {"type": "subtitle", "time": 73.27, "timestamp": "00:01:13", "text": "尺寸。是的，我可以。我必须成就一番大事业。"}, {"type": "subtitle", "time": 75.71000000000001, "timestamp": "00:01:15", "text": "是吗？是的，我必须这样做。"}, {"type": "subtitle", "time": 79.55, "timestamp": "00:01:19", "text": "大的。我必须把它做得这么大。"}, {"type": "subtitle", "time": 91.27, "timestamp": "00:01:31", "text": "是的。等等，我好像把我的鼠标弄丢了。"}, {"type": "subtitle", "time": 94.59, "timestamp": "00:01:34", "text": "指针之类的东西。一切恢复正常了。"}, {"type": "subtitle", "time": 98.99000000000001, "timestamp": "00:01:38", "text": "不，我想要回我的鼠标指针。"}, {"type": "subtitle", "time": 102.10900000000001, "timestamp": "00:01:42", "text": "等待。对，就是这个。黑色"}, {"type": "subtitle", "time": 105.63, "timestamp": "00:01:45", "text": "蝴蝶。那就是我当时的样子"}, {"type": "subtitle", "time": 112.38900000000001, "timestamp": "00:01:52", "text": "是的。教你一些技巧"}]
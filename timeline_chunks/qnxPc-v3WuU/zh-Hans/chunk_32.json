[{"type": "subtitle", "time": 1920.549, "timestamp": "00:32:00", "text": "广阔无垠。我们都说这是一个小问题"}, {"type": "subtitle", "time": 1923.909, "timestamp": "00:32:03", "text": "它不仅是世界上的，而且它本身也很大。"}, {"type": "subtitle", "time": 1925.07, "timestamp": "00:32:05", "text": "就像这样"}, {"type": "subtitle", "time": 1930.75, "timestamp": "00:32:10", "text": "许多城市，许多州，许多"}, {"type": "subtitle", "time": 1949.59, "timestamp": "00:32:29", "text": "快速地。哦，D。那句话是什么来着？我当时"}, {"type": "subtitle", "time": 1951.68, "timestamp": "00:32:31", "text": "不"}, {"type": "subtitle", "time": 1953.31, "timestamp": "00:32:33", "text": "[音乐]"}, {"type": "subtitle", "time": 1956.31, "timestamp": "00:32:36", "text": "知道。你被我推荐了。"}, {"type": "subtitle", "time": 1958.95, "timestamp": "00:32:38", "text": "等等，真的吗？等待。我猜是从照片上看的。"}, {"type": "subtitle", "time": 1960.789, "timestamp": "00:32:40", "text": "我觉得是因为你一直在看着我。"}, {"type": "subtitle", "time": 1962.549, "timestamp": "00:32:42", "text": "然后你们俩就想，“是啊，你们"}, {"type": "subtitle", "time": 1964.71, "timestamp": "00:32:44", "text": "注意这个人。我们将发送"}, {"type": "subtitle", "time": 1966.47, "timestamp": "00:32:46", "text": "给你。把他送到你那里去"}, {"type": "subtitle", "time": 1971.75, "timestamp": "00:32:51", "text": "某种东西。” 我觉得它类似于"}]
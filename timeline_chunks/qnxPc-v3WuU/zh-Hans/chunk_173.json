[{"type": "subtitle", "time": 10382.23, "timestamp": "02:53:02", "text": "买个皮肤。不，我不会买皮肤。"}, {"type": "subtitle", "time": 10383.95, "timestamp": "02:53:03", "text": "因为我不想有"}, {"type": "subtitle", "time": 10386.95, "timestamp": "02:53:06", "text": "遗憾。 Snake，你赢了吗？是的，我们"}, {"type": "subtitle", "time": 10389.67, "timestamp": "02:53:09", "text": "是。我被人抬着走了。你说得对。"}, {"type": "subtitle", "time": 10392.469, "timestamp": "02:53:12", "text": "哈克。"}, {"type": "subtitle", "time": 10394.55, "timestamp": "02:53:14", "text": "我被人抬着走了。"}, {"type": "subtitle", "time": 10396.91, "timestamp": "02:53:16", "text": "点头。呃，"}, {"type": "subtitle", "time": 10400.23, "timestamp": "02:53:20", "text": "哈坎，为什么那样做行不通？我听着"}, {"type": "subtitle", "time": 10414.23, "timestamp": "02:53:34", "text": "我已经在《卫报》上看到你了。是的。感谢"}, {"type": "subtitle", "time": 10416.309, "timestamp": "02:53:36", "text": "你。谢谢你送的黄油。我真的"}, {"type": "subtitle", "time": 10420.59, "timestamp": "02:53:40", "text": "谢谢。千兆吉。哦，你"}, {"type": "subtitle", "time": 10424.23, "timestamp": "02:53:44", "text": "听着，Gumi。哦，不错。好的。我听着"}, {"type": "subtitle", "time": 10425.67, "timestamp": "02:53:45", "text": "一首歌。好的。你知道我在等什么吗？"}, {"type": "subtitle", "time": 10429.67, "timestamp": "02:53:49", "text": "为了？如果我想要Valerent里的皮肤，"}, {"type": "subtitle", "time": 10432.79, "timestamp": "02:53:52", "text": "我想要任何种类的刀皮"}, {"type": "subtitle", "time": 10435.19, "timestamp": "02:53:55", "text": "因为你不能随便把刀给别人。"}, {"type": "subtitle", "time": 10437.99, "timestamp": "02:53:57", "text": "对人们来说，对吧？所以，我认为那样会"}]
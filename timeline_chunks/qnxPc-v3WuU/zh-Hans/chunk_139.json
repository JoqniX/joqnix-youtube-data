[{"type": "subtitle", "time": 8367.11, "timestamp": "02:19:27", "text": "后退。哦，别这样。我需要一滴。"}, {"type": "subtitle", "time": 8369.669, "timestamp": "02:19:29", "text": "S."}, {"type": "subtitle", "time": 8373.589, "timestamp": "02:19:33", "text": "瞧，他有一把大枪。等待，"}, {"type": "subtitle", "time": 8376.709, "timestamp": "02:19:36", "text": "这是什么大枪？哦，它是什么？"}, {"type": "subtitle", "time": 8384.79, "timestamp": "02:19:44", "text": "好的。那是守护者吗？决不。那是"}, {"type": "subtitle", "time": 8387.75, "timestamp": "02:19:47", "text": "哇。"}]
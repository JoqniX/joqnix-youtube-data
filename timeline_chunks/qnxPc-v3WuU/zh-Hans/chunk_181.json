[{"type": "subtitle", "time": 10876.59, "timestamp": "03:01:16", "text": "长钉。长钉"}, {"type": "subtitle", "time": 10879.389, "timestamp": "03:01:19", "text": "向下。"}, {"type": "subtitle", "time": 10882.389, "timestamp": "03:01:22", "text": "西南方向就在这里。这家伙知道怎么做"}, {"type": "subtitle", "time": 10905.15, "timestamp": "03:01:45", "text": "还剩一个敌人。"}, {"type": "subtitle", "time": 10909.79, "timestamp": "03:01:49", "text": "什么？离那里还很远，不要站在那里"}]
[{"type": "subtitle", "time": 17463.51, "timestamp": "04:51:03", "text": "太多了，伙计们。太多事情了。"}, {"type": "subtitle", "time": 17465.83, "timestamp": "04:51:05", "text": "是的。我期待着我们能一起出去玩。"}, {"type": "subtitle", "time": 17469.11, "timestamp": "04:51:09", "text": "出去聊聊天什么的。"}, {"type": "subtitle", "time": 17471.19, "timestamp": "04:51:11", "text": "当然会。我认为"}, {"type": "subtitle", "time": 17475.27, "timestamp": "04:51:15", "text": "每个人。是的。我希望如此。呃，那东西"}, {"type": "subtitle", "time": 17477.67, "timestamp": "04:51:17", "text": "我现在有一种恐惧，如果我"}, {"type": "subtitle", "time": 17480.35, "timestamp": "04:51:20", "text": "离开这些国家的人会"}, {"type": "subtitle", "time": 17485.35, "timestamp": "04:51:25", "text": "不要跟我说话之类的。嗯，什么"}, {"type": "subtitle", "time": 17488.23, "timestamp": "04:51:28", "text": "我不知道，因为什么是“什么”？"}, {"type": "chat", "time": 17490.31, "timestamp": "04:51:30", "author": "@site36.official", "avatar": "https://yt4.ggpht.com/Oc0kgq4lSUaD-BoDbaDE3pXUquuz47c4Yh7kwPILHO2D70EQ5EnEgoGgTbb5gw993EEXRqCx_A=s64-c-k-c0x00ffffff-no-rj", "message": "Pedo !???? "}, {"type": "subtitle", "time": 17490.67, "timestamp": "04:51:30", "text": "那个词的印地语是什么？"}, {"type": "subtitle", "time": 17493.75, "timestamp": "04:51:33", "text": "让我查一下。稍等片刻。我"}, {"type": "subtitle", "time": 17495.91, "timestamp": "04:51:35", "text": "我想应该有个词可以专门形容那种情况。"}, {"type": "chat", "time": 17496.887, "timestamp": "04:51:36", "author": "@site36.official", "avatar": "https://yt4.ggpht.com/Oc0kgq4lSUaD-BoDbaDE3pXUquuz47c4Yh7kwPILHO2D70EQ5EnEgoGgTbb5gw993EEXRqCx_A=s64-c-k-c0x00ffffff-no-rj", "message": "SLANDEROUS"}, {"type": "subtitle", "time": 17498.708, "timestamp": "04:51:38", "text": "事物。"}, {"type": "subtitle", "time": 17500.788, "timestamp": "04:51:40", "text": "我的天啊。"}, {"type": "chat", "time": 17501.989, "timestamp": "04:51:41", "author": "@Roku-rin", "avatar": "https://yt4.ggpht.com/8LlS_C2IirDMfA5r2V0q5G1kudp8dmG6RQvz_jCAUT3H-esyEgTNPDwrfCXiyX7Undc9UmHNgw=s64-c-k-c0x00ffffff-no-rj", "message": "he wanted to talk to toddler Jpq"}, {"type": "subtitle", "time": 17503.51, "timestamp": "04:51:43", "text": "不。你以为你像个德西人吗？"}, {"type": "subtitle", "time": 17507.91, "timestamp": "04:51:47", "text": "某物？德西？什么？"}, {"type": "chat", "time": 17511.577, "timestamp": "04:51:51", "author": "@Roku-rin", "avatar": "https://yt4.ggpht.com/8LlS_C2IirDMfA5r2V0q5G1kudp8dmG6RQvz_jCAUT3H-esyEgTNPDwrfCXiyX7Undc9UmHNgw=s64-c-k-c0x00ffffff-no-rj", "message": "Just saying PAUSE"}, {"type": "subtitle", "time": 17511.75, "timestamp": "04:51:51", "text": "你知道什么是des吗？"}, {"type": "subtitle", "time": 17514.23, "timestamp": "04:51:54", "text": "就像金库杀手一样。保险库杀手。什么"}, {"type": "chat", "time": 17515.385, "timestamp": "04:51:55", "author": "@site36.official", "avatar": "https://yt4.ggpht.com/Oc0kgq4lSUaD-BoDbaDE3pXUquuz47c4Yh7kwPILHO2D70EQ5EnEgoGgTbb5gw993EEXRqCx_A=s64-c-k-c0x00ffffff-no-rj", "message": "Oh... that is pedo-esq"}]
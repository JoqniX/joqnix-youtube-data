[{"type": "subtitle", "time": 8408.11, "timestamp": "02:20:08", "text": "我的模型怎么了？哦，我的"}, {"type": "subtitle", "time": 8411.99, "timestamp": "02:20:11", "text": "上帝。所以，现在就走吧。我不是那种人"}, {"type": "subtitle", "time": 8414.79, "timestamp": "02:20:14", "text": "搞砸了一些聊天。我回来了。我只是"}, {"type": "subtitle", "time": 8426.79, "timestamp": "02:20:26", "text": "我错过了什么？"}, {"type": "subtitle", "time": 8429.91, "timestamp": "02:20:29", "text": "小心点。我已经很久没做了。我"}, {"type": "subtitle", "time": 8432.389, "timestamp": "02:20:32", "text": "或许时间到了。哦，苹果派"}, {"type": "subtitle", "time": 8435.07, "timestamp": "02:20:35", "text": "东西。好的，我想我读过"}, {"type": "subtitle", "time": 8441.67, "timestamp": "02:20:41", "text": "睡觉。发现卧底工作就像"}, {"type": "subtitle", "time": 8443.59, "timestamp": "02:20:43", "text": "《碟中谍》的场景，他们"}, {"type": "subtitle", "time": 8445.87, "timestamp": "02:20:45", "text": "让他们去那里穿"}, {"type": "subtitle", "time": 8449.55, "timestamp": "02:20:49", "text": "面具。是的。已资助死亡"}, {"type": "subtitle", "time": 8452.07, "timestamp": "02:20:52", "text": "成功地。呃"}]
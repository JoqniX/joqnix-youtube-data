[{"type": "subtitle", "time": 1144.39, "timestamp": "00:19:04", "text": "不，我忘了，比如唐·迪亚布罗那件事。我"}, {"type": "subtitle", "time": 1146.789, "timestamp": "00:19:06", "text": "指的是他的周边商品。那是什么？"}, {"type": "subtitle", "time": 1148.31, "timestamp": "00:19:08", "text": "叫什么？"}, {"type": "subtitle", "time": 1152.35, "timestamp": "00:19:12", "text": "未来流行乐，某种类型的未来流行乐"}, {"type": "subtitle", "time": 1156.07, "timestamp": "00:19:16", "text": "未来网络材料"}, {"type": "subtitle", "time": 1159.99, "timestamp": "00:19:19", "text": "商品。是的。所以这就是我的原因"}, {"type": "subtitle", "time": 1163.51, "timestamp": "00:19:23", "text": "在某个时候，我甚至尝试学习……"}, {"type": "subtitle", "time": 1166.63, "timestamp": "00:19:26", "text": "设计服装及其他物品。我当时就像……"}, {"type": "subtitle", "time": 1168.95, "timestamp": "00:19:28", "text": "结果看了好多教程。我"}, {"type": "subtitle", "time": 1172.23, "timestamp": "00:19:32", "text": "甚至把我所有旧衣服都拆了。"}, {"type": "subtitle", "time": 1174.95, "timestamp": "00:19:34", "text": "出于某种奇怪的原因，我对布料很感兴趣，所以我"}, {"type": "subtitle", "time": 1177.99, "timestamp": "00:19:37", "text": "可以把它们缝在东西上。"}, {"type": "subtitle", "time": 1180.99, "timestamp": "00:19:40", "text": "嗯，是的，缝纫是"}, {"type": "subtitle", "time": 1184.95, "timestamp": "00:19:44", "text": "你知道，用针头很难……"}, {"type": "subtitle", "time": 1188.27, "timestamp": "00:19:48", "text": "只需一针一针地缝起来"}, {"type": "subtitle", "time": 1191.11, "timestamp": "00:19:51", "text": "手。这和学习编织是一样的。"}, {"type": "subtitle", "time": 1194.47, "timestamp": "00:19:54", "text": "出色地。哦，我甚至一度想过"}, {"type": "subtitle", "time": 1196.71, "timestamp": "00:19:56", "text": "甚至包括编织。所以我想，是啊，"}, {"type": "subtitle", "time": 1198.909, "timestamp": "00:19:58", "text": "或许我可以自己织一件毛衣，或者"}]
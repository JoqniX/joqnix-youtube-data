[{"type": "subtitle", "time": 5585.51, "timestamp": "01:33:05", "text": "我想要一把刀，但我买不到。"}, {"type": "subtitle", "time": 5607.91, "timestamp": "01:33:27", "text": "好的。天哪，我也搬家了。好的，"}, {"type": "subtitle", "time": 5617.11, "timestamp": "01:33:37", "text": "我的天哪。"}, {"type": "subtitle", "time": 5619.51, "timestamp": "01:33:39", "text": "还剩一次击杀机会。"}, {"type": "subtitle", "time": 5623.43, "timestamp": "01:33:43", "text": "壶前辈。是的。"}, {"type": "subtitle", "time": 5624.58, "timestamp": "01:33:44", "text": "你愿意吗？"}, {"type": "subtitle", "time": 5639.51, "timestamp": "01:33:59", "text": "杀。哦，我想用刀杀人。"}]
[{"type": "subtitle", "time": 840.35, "timestamp": "00:14:00", "text": "什么样的公司菜肴"}, {"type": "subtitle", "time": 843.47, "timestamp": "00:14:03", "text": "例如，假设"}, {"type": "subtitle", "time": 847.35, "timestamp": "00:14:07", "text": "掩护警察，这是第二个词合作"}, {"type": "subtitle", "time": 850.47, "timestamp": "00:14:10", "text": "公司权利涵盖公司合作社"}, {"type": "subtitle", "time": 854.59, "timestamp": "00:14:14", "text": "没错，就是全息生活 全息专业版 全息生活"}, {"type": "subtitle", "time": 858.79, "timestamp": "00:14:18", "text": "专业人士就像 Hol Life Productions 一样，对吧？"}, {"type": "subtitle", "time": 861.91, "timestamp": "00:14:21", "text": "那么，Kamisubaki Studios 就是那个工作室。"}, {"type": "subtitle", "time": 864.03, "timestamp": "00:14:24", "text": "东西"}, {"type": "subtitle", "time": 872.949, "timestamp": "00:14:32", "text": "由于 Onexia 没有办法"}, {"type": "subtitle", "time": 881.87, "timestamp": "00:14:41", "text": "嗯，就像你知道的，就像那些制作过程"}, {"type": "subtitle", "time": 886.069, "timestamp": "00:14:46", "text": "或者工作室之类的。我感觉"}, {"type": "subtitle", "time": 888.509, "timestamp": "00:14:48", "text": "更像是一个品牌"}, {"type": "subtitle", "time": 892.47, "timestamp": "00:14:52", "text": "它以自己的方式存在。我猜我"}, {"type": "subtitle", "time": 899.99, "timestamp": "00:14:59", "text": "知道吗？或许你能？嗯，某种程度上来说。"}]
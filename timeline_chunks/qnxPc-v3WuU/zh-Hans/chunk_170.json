[{"type": "subtitle", "time": 10201.99, "timestamp": "02:50:01", "text": "是的。是是是，当然是，当然。"}, {"type": "subtitle", "time": 10203.75, "timestamp": "02:50:03", "text": "培根也要被淘汰了。他需要吃饭"}, {"type": "subtitle", "time": 10205.83, "timestamp": "02:50:05", "text": "晚餐。哦，是的。是的。时间已晚。"}, {"type": "subtitle", "time": 10208.389, "timestamp": "02:50:08", "text": "是他们，对吧？是的。"}, {"type": "subtitle", "time": 10212.51, "timestamp": "02:50:12", "text": "好的。培根上桌了。我们来剪吧"}, {"type": "subtitle", "time": 10215.79, "timestamp": "02:50:15", "text": "它。抱歉，我马上回来。它是"}, {"type": "subtitle", "time": 10218.63, "timestamp": "02:50:18", "text": "好的。你来了，你刚刚伸手，"}, {"type": "subtitle", "time": 10221.59, "timestamp": "02:50:21", "text": "正确的？你被我们耍了。感谢"}, {"type": "subtitle", "time": 10223.19, "timestamp": "02:50:23", "text": "非常感谢你。我的游戏玩家放了这个"}, {"type": "subtitle", "time": 10225.99, "timestamp": "02:50:25", "text": "桌子呈V字形腿。有时是"}, {"type": "subtitle", "time": 10229.71, "timestamp": "02:50:29", "text": "L形，有时是O形。它是怎么形成的？"}, {"type": "subtitle", "time": 10232.63, "timestamp": "02:50:32", "text": "哦？什么？来自新加坡的问候。什么"}, {"type": "subtitle", "time": 10237.67, "timestamp": "02:50:37", "text": "你最近在听什么音乐？我"}, {"type": "subtitle", "time": 10242.15, "timestamp": "02:50:42", "text": "我什么都听，你知道，别这样。"}, {"type": "subtitle", "time": 10245.03, "timestamp": "02:50:45", "text": "严格来说，有一个特定的哦，"}, {"type": "subtitle", "time": 10246.71, "timestamp": "02:50:46", "text": "我只打算听这一首"}, {"type": "subtitle", "time": 10249.59, "timestamp": "02:50:49", "text": "类型。比如，你有很多东西。是的，我们确实有"}, {"type": "subtitle", "time": 10251.51, "timestamp": "02:50:51", "text": "有一个插槽。实际上有两个插槽。我"}, {"type": "subtitle", "time": 10253.75, "timestamp": "02:50:53", "text": "听各种类型的音乐。那"}, {"type": "subtitle", "time": 10254.99, "timestamp": "02:50:54", "text": "你，小丑"}, {"type": "subtitle", "time": 10258.55, "timestamp": "02:50:58", "text": "前辈？呃，我以前可是个铁杆EDM乐迷。"}]
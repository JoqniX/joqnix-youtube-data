[{"type": "subtitle", "time": 7260.83, "timestamp": "02:01:00", "text": "哦，我的"}, {"type": "subtitle", "time": 7263.229, "timestamp": "02:01:03", "text": "上帝。你有没有看到"}, {"type": "subtitle", "time": 7266.229, "timestamp": "02:01:06", "text": "那？我的天啊。"}, {"type": "subtitle", "time": 7284.43, "timestamp": "02:01:24", "text": "我"}, {"type": "subtitle", "time": 7287.35, "timestamp": "02:01:27", "text": "做不到。我原以为预先射击会奏效。"}, {"type": "subtitle", "time": 7290.149, "timestamp": "02:01:30", "text": "但事实并非如此。哦，不。"}, {"type": "subtitle", "time": 7292.709, "timestamp": "02:01:32", "text": "等等，预射对以下情况有效吗？"}, {"type": "subtitle", "time": 7295.35, "timestamp": "02:01:35", "text": "使用轻机枪？"}, {"type": "subtitle", "time": 7297.83, "timestamp": "02:01:37", "text": "如果使用什么方法，预燃有效吗？"}, {"type": "subtitle", "time": 7301.43, "timestamp": "02:01:41", "text": "比如你用白羊座和奥丁"}, {"type": "subtitle", "time": 7303.589, "timestamp": "02:01:43", "text": "预先开火的话，这样做能杀死敌人吗？"}, {"type": "subtitle", "time": 7308.709, "timestamp": "02:01:48", "text": "这个人？因为延误，对吧？我"}, {"type": "subtitle", "time": 7312.07, "timestamp": "02:01:52", "text": "我不知道“哦，火灾前夕”是什么意思"}, {"type": "subtitle", "time": 7313.91, "timestamp": "02:01:53", "text": "你知道敌人就在附近，"}, {"type": "subtitle", "time": 7316.87, "timestamp": "02:01:56", "text": "你开始射击，然后进入……"}]
[{"type": "subtitle", "time": 16201.03, "timestamp": "04:30:01", "text": "以前经常看我的直播。我当时就想，"}, {"type": "subtitle", "time": 16203.11, "timestamp": "04:30:03", "text": "“是啊，你为什么不看看呢？”"}, {"type": "subtitle", "time": 16205.83, "timestamp": "04:30:05", "text": "还有一些人就像在直播中作弊一样"}, {"type": "subtitle", "time": 16207.83, "timestamp": "04:30:07", "text": "那能帮到你吗？”我心想，“那真是……”"}, {"type": "subtitle", "time": 16210.81, "timestamp": "04:30:10", "text": "“真是个绝妙的主意。”"}, {"type": "subtitle", "time": 16212.07, "timestamp": "04:30:12", "text": "[音乐]"}, {"type": "subtitle", "time": 16215.149, "timestamp": "04:30:15", "text": "是的，从那时起，我就一直……"}, {"type": "subtitle", "time": 16218.309, "timestamp": "04:30:18", "text": "就像去往不同的地方"}, {"type": "subtitle", "time": 16220.63, "timestamp": "04:30:20", "text": "YouTube博主或者普通人"}, {"type": "subtitle", "time": 16222.95, "timestamp": "04:30:22", "text": "就像操纵溪流一样，"}, {"type": "subtitle", "time": 16226.469, "timestamp": "04:30:26", "text": "问他们，他们中的一些人就像……"}, {"type": "subtitle", "time": 16227.91, "timestamp": "04:30:27", "text": "有帮助。他们会说：“你为什么不……”"}, {"type": "subtitle", "time": 16230.149, "timestamp": "04:30:30", "text": "只要加入一家风险投资公司，我就能做到？”而且我已经"}, {"type": "subtitle", "time": 16232.79, "timestamp": "04:30:32", "text": "一直在直播，就像我们刚才那样"}, {"type": "subtitle", "time": 16235.429, "timestamp": "04:30:35", "text": "聊天的时候，我喜欢问问他们一些事情。"}, {"type": "subtitle", "time": 16237.91, "timestamp": "04:30:37", "text": "他们这样做，"}, {"type": "subtitle", "time": 16240.229, "timestamp": "04:30:40", "text": "你知道，他们就这么告诉我。一些"}, {"type": "subtitle", "time": 16241.99, "timestamp": "04:30:41", "text": "人们就像，你知道，不太大"}, {"type": "subtitle", "time": 16244.71, "timestamp": "04:30:44", "text": "主播们，但就像4K观众一样"}, {"type": "subtitle", "time": 16251.269, "timestamp": "04:30:51", "text": "信息或者他们通常只是"}, {"type": "subtitle", "time": 16253.03, "timestamp": "04:30:53", "text": "想想，“是的，那个人是"}, {"type": "subtitle", "time": 16255.11, "timestamp": "04:30:55", "text": "恶意捣乱。问我的那个人"}, {"type": "subtitle", "time": 16257.189, "timestamp": "04:30:57", "text": "关于操纵比赛的问题，他是在故意挑衅。"}, {"type": "subtitle", "time": 16258.79, "timestamp": "04:30:58", "text": "我不会理会他，或者"}]
[{"type": "subtitle", "time": 9602.309, "timestamp": "02:40:02", "text": "3点。” 是的，我想我崩溃了。是的，我"}, {"type": "subtitle", "time": 9611.91, "timestamp": "02:40:11", "text": "是的，他就是。这是第二条流"}, {"type": "subtitle", "time": 9616.71, "timestamp": "02:40:16", "text": "他今天的……是的。"}, {"type": "subtitle", "time": 9618.389, "timestamp": "02:40:18", "text": "是的。感觉如何？你累了吗？"}, {"type": "subtitle", "time": 9622.389, "timestamp": "02:40:22", "text": "你经常感到疲倦吗？呃，就像呃，我"}, {"type": "subtitle", "time": 9625.27, "timestamp": "02:40:25", "text": "不知道。我需要训练我的身体"}, {"type": "subtitle", "time": 9628.71, "timestamp": "02:40:28", "text": "呃，也许有一天会变成12小时或24小时。"}, {"type": "subtitle", "time": 9631.67, "timestamp": "02:40:31", "text": "我一直没做。是的。但"}, {"type": "subtitle", "time": 9635.59, "timestamp": "02:40:35", "text": "每当我参与风险投资之类的活动时，我"}, {"type": "subtitle", "time": 9637.99, "timestamp": "02:40:37", "text": "利用这些经验来训练身体"}, {"type": "subtitle", "time": 9639.83, "timestamp": "02:40:39", "text": "查玛。"}, {"type": "subtitle", "time": 9642.309, "timestamp": "02:40:42", "text": "所以如果我感到疲倦，我就会记下时间。"}, {"type": "subtitle", "time": 9646.389, "timestamp": "02:40:46", "text": "所以下次我直播的时候，我会尽量"}, {"type": "subtitle", "time": 9649.349, "timestamp": "02:40:49", "text": "克服时间就像战胜时间一样"}, {"type": "subtitle", "time": 9651.349, "timestamp": "02:40:51", "text": "不会感到疲倦之类的"}, {"type": "subtitle", "time": 9653.309, "timestamp": "02:40:53", "text": "那。哦，我的"}, {"type": "subtitle", "time": 9658.63, "timestamp": "02:40:58", "text": "上帝。我懂了。我的上帝。"}]
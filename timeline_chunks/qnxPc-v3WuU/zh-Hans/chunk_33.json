[{"type": "subtitle", "time": 1985.389, "timestamp": "00:33:05", "text": "我需要一次扫地，"}, {"type": "subtitle", "time": 1987.87, "timestamp": "00:33:07", "text": "兄弟。"}, {"type": "subtitle", "time": 1992.149, "timestamp": "00:33:12", "text": "我不想直播。我知道"}, {"type": "subtitle", "time": 1994.789, "timestamp": "00:33:14", "text": "我必须结束直播，但也是其中的一部分"}, {"type": "subtitle", "time": 1999.75, "timestamp": "00:33:19", "text": "我当时就想，是啊，我不想那样。"}, {"type": "subtitle", "time": 2005.19, "timestamp": "00:33:25", "text": "喜欢聊天。好的。呃，但就健康而言"}, {"type": "subtitle", "time": 2009.669, "timestamp": "00:33:29", "text": "你得休息，我得休息，我感觉"}, {"type": "subtitle", "time": 2012.47, "timestamp": "00:33:32", "text": "比如，如果我累到那种程度的话"}, {"type": "subtitle", "time": 2015.75, "timestamp": "00:33:35", "text": "那我就不想给了。"}, {"type": "subtitle", "time": 2018.47, "timestamp": "00:33:38", "text": "像个坏人一样离开"}, {"type": "subtitle", "time": 2021.669, "timestamp": "00:33:41", "text": "呃，感觉不太好，不是那种糟糕的氛围，而是比较弱的氛围。"}, {"type": "subtitle", "time": 2022.99, "timestamp": "00:33:42", "text": "你"}, {"type": "subtitle", "time": 2026.19, "timestamp": "00:33:46", "text": "我知道一些我不知道的事情。"}, {"type": "subtitle", "time": 2029.35, "timestamp": "00:33:49", "text": "我不知道我有没有那种感觉，或者说，有没有那种氛围。"}, {"type": "subtitle", "time": 2031.75, "timestamp": "00:33:51", "text": "我不了解"}, {"type": "subtitle", "time": 2033.669, "timestamp": "00:33:53", "text": "是的，更像是能量流。"}, {"type": "subtitle", "time": 2035.83, "timestamp": "00:33:55", "text": "你知道，流媒体有两种类型。"}, {"type": "subtitle", "time": 2038.31, "timestamp": "00:33:58", "text": "能量对没有三种类型，三种或"}]
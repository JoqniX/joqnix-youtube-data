[{"type": "subtitle", "time": 11583.269, "timestamp": "03:13:03", "text": "消除。得到它。得到它。得到它。得到"}, {"type": "subtitle", "time": 11586.07, "timestamp": "03:13:06", "text": "它。得到它。得到它。"}, {"type": "subtitle", "time": 11588.63, "timestamp": "03:13:08", "text": "球员站立。"}, {"type": "subtitle", "time": 11591.429, "timestamp": "03:13:11", "text": "我的天啊。没关系。"}, {"type": "subtitle", "time": 11594.469, "timestamp": "03:13:14", "text": "不错。不错。没关系。我们尽力了。"}, {"type": "subtitle", "time": 11595.99, "timestamp": "03:13:15", "text": "不。"}, {"type": "subtitle", "time": 11598.79, "timestamp": "03:13:18", "text": "等待。你为什么会死？我本来打算"}, {"type": "subtitle", "time": 11602.63, "timestamp": "03:13:22", "text": "让她一脸“我的天哪”。我的错。我的错。"}, {"type": "subtitle", "time": 11606.469, "timestamp": "03:13:26", "text": "我的错。我的天哪。"}, {"type": "subtitle", "time": 11608.469, "timestamp": "03:13:28", "text": "她不知道我在那里。我正要去"}, {"type": "subtitle", "time": 11610.59, "timestamp": "03:13:30", "text": "靠近"}, {"type": "subtitle", "time": 11614.15, "timestamp": "03:13:34", "text": "她。上帝。"}, {"type": "subtitle", "time": 11618.15, "timestamp": "03:13:38", "text": "如果我说我不知道​​，那可能就不是真的。"}, {"type": "subtitle", "time": 11621.59, "timestamp": "03:13:41", "text": "等等，不对，现在是孟买，我们刚才在哪儿？"}, {"type": "subtitle", "time": 11623.75, "timestamp": "03:13:43", "text": "我们在孟买比赛时，正在比赛"}, {"type": "subtitle", "time": 11627.83, "timestamp": "03:13:47", "text": "新加坡早些时候 哦，好的好的"}, {"type": "subtitle", "time": 11630.79, "timestamp": "03:13:50", "text": "嗨，我的天啊，服务器是……"}, {"type": "subtitle", "time": 11632.67, "timestamp": "03:13:52", "text": "孟买"}]
[{"type": "subtitle", "time": 16681.67, "timestamp": "04:38:01", "text": "把地图上所有的人都冻住，因为"}, {"type": "subtitle", "time": 16684.629, "timestamp": "04:38:04", "text": "他的冰冻箭矢能像穿墙一样穿透目标。"}, {"type": "subtitle", "time": 16687.189, "timestamp": "04:38:07", "text": "还有一些其他的东西。所以他基本上可以冻结"}, {"type": "subtitle", "time": 16690.23, "timestamp": "04:38:10", "text": "你在出生点"}, {"type": "subtitle", "time": 16691.789, "timestamp": "04:38:11", "text": "这很好。"}, {"type": "subtitle", "time": 16694.269, "timestamp": "04:38:14", "text": "猜测和"}, {"type": "subtitle", "time": 16699.75, "timestamp": "04:38:19", "text": "呃，还有新角色奥创也出现了。"}, {"type": "subtitle", "time": 16701.869, "timestamp": "04:38:21", "text": "基本上就是这样"}, {"type": "subtitle", "time": 16705.429, "timestamp": "04:38:25", "text": "它。我不知道为什么更新次数更多"}, {"type": "subtitle", "time": 16708.709, "timestamp": "04:38:28", "text": "来吧，这游戏，我的帧数再多一点就停了"}, {"type": "subtitle", "time": 16712.15, "timestamp": "04:38:32", "text": "你知道第一次第一次掉落"}, {"type": "subtitle", "time": 16717.47, "timestamp": "04:38:37", "text": "零赛季大概是200帧，2150帧。"}, {"type": "subtitle", "time": 16721.349, "timestamp": "04:38:41", "text": "《Frames Now》第一季回归了，正在热播。"}, {"type": "subtitle", "time": 16723.67, "timestamp": "04:38:43", "text": "大概170，我就想，哦，对，那就是"}, {"type": "subtitle", "time": 16726.629, "timestamp": "04:38:46", "text": "好吧，我猜第二季出来的时候我肯定会看的。"}, {"type": "subtitle", "time": 16729.51, "timestamp": "04:38:49", "text": "80帧"}, {"type": "subtitle", "time": 16731.75, "timestamp": "04:38:51", "text": "我的天啊"}, {"type": "subtitle", "time": 16734.789, "timestamp": "04:38:54", "text": "灰色地带 他们 他们没有优化他们的"}]
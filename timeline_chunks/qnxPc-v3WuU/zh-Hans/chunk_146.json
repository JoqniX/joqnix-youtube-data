[{"type": "subtitle", "time": 8762.15, "timestamp": "02:26:02", "text": "他在哪儿？哦，他来了"}, {"type": "subtitle", "time": 8765.59, "timestamp": "02:26:05", "text": "我想应该是来自康涅狄格州。是CT还是I"}, {"type": "subtitle", "time": 8766.95, "timestamp": "02:26:06", "text": "我也不知道。他正从……"}, {"type": "subtitle", "time": 8770.79, "timestamp": "02:26:10", "text": "生成。是的，我正要走，我完成了我的"}, {"type": "subtitle", "time": 8777.51, "timestamp": "02:26:17", "text": "我不知道我是怎么完成所有事情的。"}, {"type": "subtitle", "time": 8779.67, "timestamp": "02:26:19", "text": "在这场游戏中。"}, {"type": "subtitle", "time": 8783.27, "timestamp": "02:26:23", "text": "我的网络不好。没关系。没关系。"}, {"type": "subtitle", "time": 8791.429, "timestamp": "02:26:31", "text": "有人想加入吗？"}, {"type": "subtitle", "time": 8793.03, "timestamp": "02:26:33", "text": "你想一对一吗？呃，我们可以"}, {"type": "subtitle", "time": 8795.91, "timestamp": "02:26:35", "text": "可能晚点再做。大概是"}, {"type": "subtitle", "time": 8798.19, "timestamp": "02:26:38", "text": "你的网络没问题。"}, {"type": "subtitle", "time": 8802.23, "timestamp": "02:26:42", "text": "正确的？大概。我好难过。没关系。"}, {"type": "subtitle", "time": 8804.07, "timestamp": "02:26:44", "text": "别担心。等等，你有"}, {"type": "subtitle", "time": 8807.27, "timestamp": "02:26:47", "text": "有人要来吗？他想吗？"}, {"type": "subtitle", "time": 8810.07, "timestamp": "02:26:50", "text": "来？哦，如果他愿意的话。当然可以。他"}, {"type": "subtitle", "time": 8813.83, "timestamp": "02:26:53", "text": "能。我会继续邀请他。嗯。"}, {"type": "subtitle", "time": 8816.79, "timestamp": "02:26:56", "text": "他来了。现在没事了。是的。哦"}, {"type": "subtitle", "time": 8819.91, "timestamp": "02:26:59", "text": "上帝。呃，我们走吧。间谍迷恋。哦，你"}]
[{"type": "subtitle", "time": 13323.11, "timestamp": "03:42:03", "text": "我要把那个贱人拖出来。他将"}, {"type": "subtitle", "time": 13326.309, "timestamp": "03:42:06", "text": "把它彻底拆开，换成别的什么东西。"}, {"type": "subtitle", "time": 13329.03, "timestamp": "03:42:09", "text": "进去告诉我。我就在那里。"}, {"type": "subtitle", "time": 13331.19, "timestamp": "03:42:11", "text": "比如，“哇，这是这一边吗？”"}, {"type": "subtitle", "time": 13334.63, "timestamp": "03:42:14", "text": "寻求？这是我的支线任务吗？"}, {"type": "subtitle", "time": 13337.67, "timestamp": "03:42:17", "text": "哦，这就是人们所说的支线任务吗？"}, {"type": "subtitle", "time": 13341.309, "timestamp": "03:42:21", "text": "就像听一个NPC说话一样"}, {"type": "subtitle", "time": 13344.469, "timestamp": "03:42:24", "text": "对话？我的天啊。"}, {"type": "subtitle", "time": 13348.309, "timestamp": "03:42:28", "text": "哦，是的。是的。是的，但我们会提供帮助。"}, {"type": "subtitle", "time": 13349.83, "timestamp": "03:42:29", "text": "彼此。这就是我们所做的事。我们"}, {"type": "subtitle", "time": 13352.15, "timestamp": "03:42:32", "text": "互相帮助。"}, {"type": "subtitle", "time": 13357.75, "timestamp": "03:42:37", "text": "他给我发语音留言。我派他去"}, {"type": "subtitle", "time": 13361.67, "timestamp": "03:42:41", "text": "冷笑话。是的。冷笑话。真的"}, {"type": "subtitle", "time": 13364.71, "timestamp": "03:42:44", "text": "坏的。然后他问我，我没明白。"}, {"type": "subtitle", "time": 13367.19, "timestamp": "03:42:47", "text": "它。"}, {"type": "subtitle", "time": 13370.469, "timestamp": "03:42:50", "text": "是的。好吧，我只是……我只是"}, {"type": "subtitle", "time": 13372.389, "timestamp": "03:42:52", "text": "别管它了，好吗？感觉还好。"}, {"type": "subtitle", "time": 13379.51, "timestamp": "03:42:59", "text": "我的天啊。是的。你在说什么？"}]
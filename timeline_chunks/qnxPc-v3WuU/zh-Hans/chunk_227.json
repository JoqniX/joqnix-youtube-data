[{"type": "subtitle", "time": 13623.03, "timestamp": "03:47:03", "text": "我曾经想学小提琴。"}, {"type": "subtitle", "time": 13626.79, "timestamp": "03:47:06", "text": "呃，还有一些其他的东西。所以，我当时就像在听。"}, {"type": "subtitle", "time": 13629.51, "timestamp": "03:47:09", "text": "伴着小提琴声，我试图入睡。"}, {"type": "subtitle", "time": 13632.229, "timestamp": "03:47:12", "text": "下午12点半左右，因为"}, {"type": "subtitle", "time": 13634.51, "timestamp": "03:47:14", "text": "我当时非常累。"}, {"type": "subtitle", "time": 13637.79, "timestamp": "03:47:17", "text": "是的，"}, {"type": "subtitle", "time": 13642.67, "timestamp": "03:47:22", "text": "嗯……那它叫什么来着？"}, {"type": "subtitle", "time": 13647.11, "timestamp": "03:47:27", "text": "嗯，是的，我突然做了一个梦。"}, {"type": "subtitle", "time": 13653.349, "timestamp": "03:47:33", "text": "我和艾丽卡是朋友，我的上帝"}, {"type": "subtitle", "time": 13657.11, "timestamp": "03:47:37", "text": "我把她带进来，就像她允许我这么做一样。"}, {"type": "subtitle", "time": 13659.99, "timestamp": "03:47:39", "text": "和她一起直播。我当时在"}, {"type": "subtitle", "time": 13662.15, "timestamp": "03:47:42", "text": "背景中有人在和她说话"}, {"type": "subtitle", "time": 13665.429, "timestamp": "03:47:45", "text": "她正在弹吉他什么的"}, {"type": "subtitle", "time": 13667.91, "timestamp": "03:47:47", "text": "音乐之类的。每当她停下来的时候，"}, {"type": "subtitle", "time": 13670.63, "timestamp": "03:47:50", "text": "我们俩聊了会儿天，诸如此类。和"}, {"type": "subtitle", "time": 13673.67, "timestamp": "03:47:53", "text": "然后就停电了，我"}, {"type": "subtitle", "time": 13676.469, "timestamp": "03:47:56", "text": "切换了。我当时在他们的聊天群里"}, {"type": "subtitle", "time": 13679.51, "timestamp": "03:47:59", "text": "所有的一切，谈话等等"}]
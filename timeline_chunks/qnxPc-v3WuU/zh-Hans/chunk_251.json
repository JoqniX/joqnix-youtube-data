[{"type": "subtitle", "time": 15061.75, "timestamp": "04:11:01", "text": "没关系。你知道，我最喜欢的合作。"}, {"type": "subtitle", "time": 15064.469, "timestamp": "04:11:04", "text": "你玩得最开心。你度过了一段美好的时光"}, {"type": "subtitle", "time": 15067.59, "timestamp": "04:11:07", "text": "时间。你和那个人建立了深厚的感情。"}, {"type": "subtitle", "time": 15070.95, "timestamp": "04:11:10", "text": "查德非常喜欢它。"}, {"type": "subtitle", "time": 15075.469, "timestamp": "04:11:15", "text": "出色地。你呢？哪个最好？"}, {"type": "subtitle", "time": 15077.55, "timestamp": "04:11:17", "text": "我不"}, {"type": "subtitle", "time": 15080.95, "timestamp": "04:11:20", "text": "知道。呃，没人。你没有伤害任何人。"}, {"type": "subtitle", "time": 15083.59, "timestamp": "04:11:23", "text": "情怀。拜托，老兄。不。就像所有的一切一样。"}, {"type": "subtitle", "time": 15087.189, "timestamp": "04:11:27", "text": "它们很好。好的。"}, {"type": "subtitle", "time": 15090.469, "timestamp": "04:11:30", "text": "我知道。但你最喜欢哪一个？你"}, {"type": "subtitle", "time": 15097.83, "timestamp": "04:11:37", "text": "我的天啊。如果你不这样做，也没关系。"}, {"type": "subtitle", "time": 15099.83, "timestamp": "04:11:39", "text": "想说。如果你没有压力的话"}, {"type": "subtitle", "time": 15102.83, "timestamp": "04:11:42", "text": "想说。不，我好困惑。"}, {"type": "subtitle", "time": 15106.469, "timestamp": "04:11:46", "text": "等待。是的。告诉我，如果你是我的"}, {"type": "subtitle", "time": 15110.309, "timestamp": "04:11:50", "text": "最喜欢的一个。好的，所以有两个我"}, {"type": "subtitle", "time": 15113.91, "timestamp": "04:11:53", "text": "观看比赛最有趣的是"}, {"type": "subtitle", "time": 15114.91, "timestamp": "04:11:54", "text": "大概"}, {"type": "subtitle", "time": 15118.71, "timestamp": "04:11:58", "text": "呃，是哪个来着？让我先说明一下"}]
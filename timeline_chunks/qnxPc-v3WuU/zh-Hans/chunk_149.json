[{"type": "subtitle", "time": 8940.07, "timestamp": "02:29:00", "text": "光明会。他的网还是那么烂。"}, {"type": "subtitle", "time": 8942.79, "timestamp": "02:29:02", "text": "他打得太好了。"}, {"type": "subtitle", "time": 8943.94, "timestamp": "02:29:03", "text": "是的。"}, {"type": "subtitle", "time": 8946.23, "timestamp": "02:29:06", "text": "[音乐]"}, {"type": "subtitle", "time": 8955.71, "timestamp": "02:29:15", "text": "在哪里？"}, {"type": "subtitle", "time": 8976.79, "timestamp": "02:29:36", "text": "为什么？我听到的第一件事就是"}, {"type": "subtitle", "time": 8979.349, "timestamp": "02:29:39", "text": "她说的话简直疯了。我为什么会这样"}, {"type": "subtitle", "time": 8989.11, "timestamp": "02:29:49", "text": "好了，我得回去了。我必须赢"}, {"type": "subtitle", "time": 8998.63, "timestamp": "02:29:58", "text": "我的天啊。我的天哪。我的天啊。"}]
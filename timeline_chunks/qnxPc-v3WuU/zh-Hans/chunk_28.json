[{"type": "subtitle", "time": 1681.31, "timestamp": "00:28:01", "text": "善良，但那场演出也……"}, {"type": "subtitle", "time": 1683.31, "timestamp": "00:28:03", "text": "进展"}, {"type": "subtitle", "time": 1686.95, "timestamp": "00:28:06", "text": "那里。哦，我忘了。哦，等等，等等。"}, {"type": "subtitle", "time": 1690.59, "timestamp": "00:28:10", "text": "等待。我居然忘了"}, {"type": "subtitle", "time": 1694.35, "timestamp": "00:28:14", "text": "嗯，这些垂直流，呃，这些"}, {"type": "subtitle", "time": 1697.35, "timestamp": "00:28:17", "text": "参与模式对任何不在场的人都开放"}, {"type": "subtitle", "time": 1699.35, "timestamp": "00:28:19", "text": "仅限订阅用户。哦，我忘了。我忘了。"}, {"type": "subtitle", "time": 1703.47, "timestamp": "00:28:23", "text": "我忘了。我忘了那是……"}, {"type": "subtitle", "time": 1706.029, "timestamp": "00:28:26", "text": "事物。我忘了。"}, {"type": "subtitle", "time": 1708.269, "timestamp": "00:28:28", "text": "是的，现在我"}, {"type": "subtitle", "time": 1712.31, "timestamp": "00:28:32", "text": "记住。现在我想起来了，因为这些是"}, {"type": "subtitle", "time": 1715.51, "timestamp": "00:28:35", "text": "垂直流，对吧？所以，从这个意义上讲"}, {"type": "subtitle", "time": 1718.47, "timestamp": "00:28:38", "text": "你看看，如果你能看到我的直播的话"}, {"type": "subtitle", "time": 1721.269, "timestamp": "00:28:41", "text": "如果你发现它，可以从短途浏览。"}, {"type": "subtitle", "time": 1722.59, "timestamp": "00:28:42", "text": "那"}, {"type": "subtitle", "time": 1725.59, "timestamp": "00:28:45", "text": "方式。所以，我以为你就是这样，你知道的。"}, {"type": "subtitle", "time": 1728.63, "timestamp": "00:28:48", "text": "我就是不想拥有它。"}, {"type": "subtitle", "time": 1731.59, "timestamp": "00:28:51", "text": "所以你多少会强迫自己"}, {"type": "subtitle", "time": 1735.95, "timestamp": "00:28:55", "text": "订阅后，像我们平时一样和订阅者交流。"}, {"type": "subtitle", "time": 1739.51, "timestamp": "00:28:59", "text": "模式，但还有，嗯，是的，我做到了"}]
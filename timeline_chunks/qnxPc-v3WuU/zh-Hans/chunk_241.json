[{"type": "subtitle", "time": 14461.87, "timestamp": "04:01:01", "text": "实时更新到最新内容。"}, {"type": "subtitle", "time": 14465.229, "timestamp": "04:01:05", "text": "是的。嗯，那段经历真的很有趣。"}, {"type": "subtitle", "time": 14468.55, "timestamp": "04:01:08", "text": "诚实地去做这件事。看这个真有意思"}, {"type": "subtitle", "time": 14470.75, "timestamp": "04:01:10", "text": "也像古老的溪流，而你曾经是"}, {"type": "subtitle", "time": 14473.429, "timestamp": "04:01:13", "text": "听到自己的声音，我感到尴尬不已，就像……"}, {"type": "subtitle", "time": 14474.99, "timestamp": "04:01:14", "text": "我"}, {"type": "subtitle", "time": 14478.229, "timestamp": "04:01:18", "text": "怎么说？哦，对，那是以前的慢跑。"}, {"type": "subtitle", "time": 14483.309, "timestamp": "04:01:23", "text": "老狗太坦率了。它太开放了。"}, {"type": "subtitle", "time": 14486.51, "timestamp": "04:01:26", "text": "是的。哦，是的。喜欢"}, {"type": "subtitle", "time": 14489.429, "timestamp": "04:01:29", "text": "呃，明天之后就将是……"}, {"type": "subtitle", "time": 14492.63, "timestamp": "04:01:32", "text": "六月之后的最后冲刺阶段。就像……就像"}, {"type": "subtitle", "time": 14495.51, "timestamp": "04:01:35", "text": "六月我只会在那里待一段时间"}, {"type": "subtitle", "time": 14496.83, "timestamp": "04:01:36", "text": "还有两周"}, {"type": "subtitle", "time": 14501.189, "timestamp": "04:01:41", "text": "考试结束了。是啊，考试。"}, {"type": "subtitle", "time": 14504.79, "timestamp": "04:01:44", "text": "我会到场。所以，呃，在考试期间"}, {"type": "subtitle", "time": 14506.87, "timestamp": "04:01:46", "text": "呃，我当时在考虑限制……"}, {"type": "subtitle", "time": 14509.349, "timestamp": "04:01:49", "text": "合作就像如果有额外的额外……"}, {"type": "subtitle", "time": 14511.91, "timestamp": "04:01:51", "text": "待处理的那些，我马上就来，我会放好"}, {"type": "subtitle", "time": 14514.63, "timestamp": "04:01:54", "text": "在第二、三周或第三周。"}, {"type": "subtitle", "time": 14519.11, "timestamp": "04:01:59", "text": "最多到六月二十一日那一周，因为呃"}]
[{"type": "subtitle", "time": 8883.27, "timestamp": "02:28:03", "text": "不，是谁？哦，那是 Jok 前辈。"}, {"type": "subtitle", "time": 8886.469, "timestamp": "02:28:06", "text": "哦好的。是的。你好。哦，我看到了"}, {"type": "subtitle", "time": 8888.63, "timestamp": "02:28:08", "text": "那把刀。哦，等等。乔，你能……"}, {"type": "subtitle", "time": 8891.389, "timestamp": "02:28:11", "text": "面对我？等等，我想看看"}, {"type": "subtitle", "time": 8892.91, "timestamp": "02:28:12", "text": "刀。"}, {"type": "subtitle", "time": 8894.91, "timestamp": "02:28:14", "text": "哦。"}, {"type": "subtitle", "time": 8901.23, "timestamp": "02:28:21", "text": "不会杀死"}, {"type": "subtitle", "time": 8908.51, "timestamp": "02:28:28", "text": "不，我忘不了。"}, {"type": "subtitle", "time": 8927.03, "timestamp": "02:28:47", "text": "可以提前10人加入吗？我认为"}, {"type": "subtitle", "time": 8929.19, "timestamp": "02:28:49", "text": "你可以。是的，可以。我的意思是，我们可以。"}, {"type": "subtitle", "time": 8930.87, "timestamp": "02:28:50", "text": "是的，"}, {"type": "subtitle", "time": 8932.87, "timestamp": "02:28:52", "text": "如果你问的话。我甚至都不是"}, {"type": "subtitle", "time": 8937.309, "timestamp": "02:28:57", "text": "我们可以看看阿尼昆。我是说"}]
[{"type": "subtitle", "time": 6424.709, "timestamp": "01:47:04", "text": "孟买孟买。我们将在新加坡比赛。"}, {"type": "subtitle", "time": 6426.709, "timestamp": "01:47:06", "text": "因为我觉得大多数人"}, {"type": "subtitle", "time": 6429.35, "timestamp": "01:47:09", "text": "在新加坡网络延迟很好。它是"}, {"type": "subtitle", "time": 6432.07, "timestamp": "01:47:12", "text": "只有我一个人觉得网络延迟高。"}, {"type": "subtitle", "time": 6443.189, "timestamp": "01:47:23", "text": "我觉得你可能没意识到，但是"}, {"type": "subtitle", "time": 6446.149, "timestamp": "01:47:26", "text": "其实就像爱杀人一样。好的，我是"}, {"type": "subtitle", "time": 6448.47, "timestamp": "01:47:28", "text": "后退。我回来了。曾经有过一次。"}, {"type": "subtitle", "time": 6450.709, "timestamp": "01:47:30", "text": "等等，Job聊天能听到我说话吗？我不"}, {"type": "subtitle", "time": 6452.55, "timestamp": "01:47:32", "text": "甚至不知道。是的。是的。是的。我能听到吗？"}, {"type": "subtitle", "time": 6475.629, "timestamp": "01:47:55", "text": "哦，我的"}]
[{"type": "subtitle", "time": 10089.75, "timestamp": "02:48:09", "text": "那架飞机肯定会很生气。我"}, {"type": "subtitle", "time": 10122.23, "timestamp": "02:48:42", "text": "我看到了DG。这比想象中要容易得多。"}, {"type": "subtitle", "time": 10128.23, "timestamp": "02:48:48", "text": "什么是音乐？什么是游戏音乐？"}, {"type": "subtitle", "time": 10130.55, "timestamp": "02:48:50", "text": "什么是游戏音乐？我的游戏玩家"}, {"type": "subtitle", "time": 10133.79, "timestamp": "02:48:53", "text": "我的游戏姿势是V字形腿。"}, {"type": "subtitle", "time": 10137.75, "timestamp": "02:48:57", "text": "桌子。你有一张桌子。哦，等等。我得到了"}]
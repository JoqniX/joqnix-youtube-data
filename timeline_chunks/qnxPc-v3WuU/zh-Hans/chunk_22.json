[{"type": "subtitle", "time": 1320.23, "timestamp": "00:22:00", "text": "东西。抱歉打哈欠了。哇，我是"}, {"type": "subtitle", "time": 1323.11, "timestamp": "00:22:03", "text": "扫荡。我需要任何直播流。已经过去了。"}, {"type": "subtitle", "time": 1325.87, "timestamp": "00:22:05", "text": "不过，我们只达到了 2 级。"}, {"type": "subtitle", "time": 1328.31, "timestamp": "00:22:08", "text": "制作衣服。我找不到衣服。"}, {"type": "subtitle", "time": 1330.07, "timestamp": "00:22:10", "text": "那正合我意。如果他们真的这么做了，他们就会"}, {"type": "subtitle", "time": 1334.35, "timestamp": "00:22:14", "text": "昂贵的。嗯。衣服将是"}, {"type": "subtitle", "time": 1337.23, "timestamp": "00:22:17", "text": "疼痛。它是"}, {"type": "subtitle", "time": 1339.95, "timestamp": "00:22:19", "text": "好的。"}, {"type": "subtitle", "time": 1344.19, "timestamp": "00:22:24", "text": "试试用袜子做一个毛绒玩具。啊，"}, {"type": "subtitle", "time": 1347.149, "timestamp": "00:22:27", "text": "是的。可以试试看。"}, {"type": "subtitle", "time": 1350.75, "timestamp": "00:22:30", "text": "那。还有，我刚刚意识到"}, {"type": "subtitle", "time": 1353.83, "timestamp": "00:22:33", "text": "呃，那些在YouTube上聊天的人，你们"}, {"type": "subtitle", "time": 1356.789, "timestamp": "00:22:36", "text": "董事会并不欢迎他，对吧？"}, {"type": "subtitle", "time": 1362.71, "timestamp": "00:22:42", "text": "最近，YouTube上的这个东西"}, {"type": "subtitle", "time": 1365.87, "timestamp": "00:22:45", "text": "Streamboard一直不太稳定"}, {"type": "subtitle", "time": 1369.23, "timestamp": "00:22:49", "text": "实际上截至"}, {"type": "subtitle", "time": 1371.94, "timestamp": "00:22:51", "text": "晚的。是的。你正在被"}, {"type": "subtitle", "time": 1379.63, "timestamp": "00:22:59", "text": "歪斜的。现在连接成功了。"}]
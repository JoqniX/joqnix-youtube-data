[{"type": "subtitle", "time": 16501.83, "timestamp": "04:35:01", "text": "知道。 Aline 展示 Alpine 短时间。"}, {"type": "subtitle", "time": 16508.23, "timestamp": "04:35:08", "text": "是的。如果你想去，请务必这样做。"}, {"type": "subtitle", "time": 16510.23, "timestamp": "04:35:10", "text": "关注此人。我不记得是否"}, {"type": "subtitle", "time": 16512.551, "timestamp": "04:35:12", "text": "他们会直播吗？不会吧？但确实如此。"}, {"type": "subtitle", "time": 16515.109, "timestamp": "04:35:15", "text": "好的。"}, {"type": "subtitle", "time": 16517.99, "timestamp": "04:35:17", "text": "该死。好的。是的。"}, {"type": "subtitle", "time": 16520.47, "timestamp": "04:35:20", "text": "是的。是的，我一直都是这样。"}, {"type": "subtitle", "time": 16523.91, "timestamp": "04:35:23", "text": "你知道，就是这么做的。那就是工作和"}, {"type": "subtitle", "time": 16525.67, "timestamp": "04:35:25", "text": "你知道，就是那种东西。嗯，你不需要我"}, {"type": "subtitle", "time": 16527.67, "timestamp": "04:35:27", "text": "我不需要解释工作的事情。它是"}, {"type": "subtitle", "time": 16529.99, "timestamp": "04:35:29", "text": "真是无聊透顶。"}, {"type": "subtitle", "time": 16537.269, "timestamp": "04:35:37", "text": "是啊，这会很枯燥。"}, {"type": "subtitle", "time": 16540.551, "timestamp": "04:35:40", "text": "就像你一样，你知道，就像就是这样"}, {"type": "subtitle", "time": 16543.349, "timestamp": "04:35:43", "text": "工作很痛苦。"}, {"type": "subtitle", "time": 16545.31, "timestamp": "04:35:45", "text": "我太"}, {"type": "subtitle", "time": 16547.59, "timestamp": "04:35:47", "text": "疲劳的。别担心，乔。你也将"}, {"type": "subtitle", "time": 16555.91, "timestamp": "04:35:55", "text": "等你到了日本就会明白了。"}, {"type": "subtitle", "time": 16558.07, "timestamp": "04:35:58", "text": "就像洗碗一样，你会……"}, {"type": "subtitle", "time": 16559.99, "timestamp": "04:35:59", "text": "比如，“哦，对。我记得面包……”"}]
[{"type": "subtitle", "time": 2.71, "timestamp": "00:00:02", "text": "特意要求添加此功能，因为"}, {"type": "subtitle", "time": 5.51, "timestamp": "00:00:05", "text": "我没能做到这一点，我很高兴。"}, {"type": "subtitle", "time": 6.99, "timestamp": "00:00:06", "text": "我问了"}, {"type": "subtitle", "time": 10.31, "timestamp": "00:00:10", "text": "这位开发者是这款显而易见的插件的幕后推手"}, {"type": "subtitle", "time": 13.03, "timestamp": "00:00:13", "text": "你知道，如果可能的话，你能做"}, {"type": "subtitle", "time": 19.189, "timestamp": "00:00:19", "text": "比如双PC或三PC方案"}, {"type": "subtitle", "time": 22.87, "timestamp": "00:00:22", "text": "或者像多个PC用户那样"}, {"type": "subtitle", "time": 25.91, "timestamp": "00:00:25", "text": "可以像发送鼠标数据一样发送出去。"}, {"type": "subtitle", "time": 28.509, "timestamp": "00:00:28", "text": "插件，这样我就可以进行缩放了，而且"}, {"type": "subtitle", "time": 31.83, "timestamp": "00:00:31", "text": "东西 哦，对，有点像这样。库兹"}, {"type": "subtitle", "time": 34.15, "timestamp": "00:00:34", "text": "现在我可以放大查看了。"}, {"type": "subtitle", "time": 37.27, "timestamp": "00:00:37", "text": "教导人们。不，因为鼠标会……"}, {"type": "subtitle", "time": 39.79, "timestamp": "00:00:39", "text": "无论我走到哪里，我都跟着他。"}, {"type": "subtitle", "time": 41.63, "timestamp": "00:00:41", "text": "去。"}, {"type": "subtitle", "time": 44.389, "timestamp": "00:00:44", "text": "正确的。有点紧张不安，或者像"}, {"type": "subtitle", "time": 47.75, "timestamp": "00:00:47", "text": "有些地方气氛沉闷，有些地方则很热闹，但是"}, {"type": "subtitle", "time": 49.83, "timestamp": "00:00:49", "text": "除此之外，你还可以明显地……"}, {"type": "subtitle", "time": 53.35, "timestamp": "00:00:53", "text": "看到一点点。哦，这就是乔"}, {"type": "subtitle", "time": 55.75, "timestamp": "00:00:55", "text": "正在点击。就像这样"}, {"type": "subtitle", "time": 57.91, "timestamp": "00:00:57", "text": "那样的话，就很难不去追踪……"}]
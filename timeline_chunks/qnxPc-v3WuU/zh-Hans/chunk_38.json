[{"type": "subtitle", "time": 2281.63, "timestamp": "00:38:01", "text": "是的，但是我"}, {"type": "subtitle", "time": 2284.95, "timestamp": "00:38:04", "text": "忘了。说实话，我不知道是哪个。"}, {"type": "subtitle", "time": 2287.39, "timestamp": "00:38:07", "text": "是更好的选择"}, {"type": "subtitle", "time": 2289.79, "timestamp": "00:38:09", "text": "是"}, {"type": "subtitle", "time": 2293.43, "timestamp": "00:38:13", "text": "我觉得就像，让我告诉你"}, {"type": "subtitle", "time": 2297.31, "timestamp": "00:38:17", "text": "作为一名观众"}, {"type": "subtitle", "time": 2307.109, "timestamp": "00:38:27", "text": "对，比如说，如果我看到一个视频"}, {"type": "subtitle", "time": 2309.15, "timestamp": "00:38:29", "text": "流或"}, {"type": "subtitle", "time": 2315.67, "timestamp": "00:38:35", "text": "是的，如果是订阅模式，那会怎样？"}, {"type": "subtitle", "time": 2318.829, "timestamp": "00:38:38", "text": "我，我，什么，什么，我将做什么"}, {"type": "subtitle", "time": 2322.63, "timestamp": "00:38:42", "text": "会本能地去看主播。"}, {"type": "subtitle", "time": 2325.27, "timestamp": "00:38:45", "text": "或者去当一段时间的主播。看看他们是怎么做的"}, {"type": "subtitle", "time": 2327.43, "timestamp": "00:38:47", "text": "和他们聊聊，看看他们怎么样，做点什么。然后"}, {"type": "subtitle", "time": 2329.71, "timestamp": "00:38:49", "text": "如果我喜欢，我就会订阅。"}, {"type": "subtitle", "time": 2333.19, "timestamp": "00:38:53", "text": "东西。然后我会说话或者只是看着。那是"}, {"type": "subtitle", "time": 2335.349, "timestamp": "00:38:55", "text": "我做什么。"}, {"type": "subtitle", "time": 2339.71, "timestamp": "00:38:59", "text": "但如果我看到的是像流媒体那样的东西，那就是"}]
[{"type": "subtitle", "time": 15361.83, "timestamp": "04:16:01", "text": "OG们，是的"}, {"type": "subtitle", "time": 15366.469, "timestamp": "04:16:06", "text": "这是一件大事，一件相当大的事。"}, {"type": "subtitle", "time": 15369.189, "timestamp": "04:16:09", "text": "我真的很想把每个人都带过来。"}, {"type": "subtitle", "time": 15373.469, "timestamp": "04:16:13", "text": "和他们所有人一样，但为什么会这样呢？"}, {"type": "subtitle", "time": 15379.99, "timestamp": "04:16:19", "text": "太难了，我的精力都耗尽了，我快要死了。"}, {"type": "subtitle", "time": 15383.429, "timestamp": "04:16:23", "text": "我想让所有人都来看我"}, {"type": "subtitle", "time": 15385.83, "timestamp": "04:16:25", "text": "准备。我的意思是，我不在乎"}, {"type": "subtitle", "time": 15387.83, "timestamp": "04:16:27", "text": "有人在看我。我只想"}, {"type": "subtitle", "time": 15391.91, "timestamp": "04:16:31", "text": "挂出。不，某种程度上感觉像是"}, {"type": "subtitle", "time": 15394.389, "timestamp": "04:16:34", "text": "是的，某种程度上感觉就像我"}, {"type": "subtitle", "time": 15396.469, "timestamp": "04:16:36", "text": "做最后的告别之类的。"}, {"type": "subtitle", "time": 15400.11, "timestamp": "04:16:40", "text": "是啊，我也有这种感觉。不用担心。"}, {"type": "subtitle", "time": 15404.79, "timestamp": "04:16:44", "text": "呃，我的意思是，在某种程度上，我认为它是一种"}, {"type": "subtitle", "time": 15407.83, "timestamp": "04:16:47", "text": "与这款模型正式告别。谁知道呢"}, {"type": "subtitle", "time": 15411.11, "timestamp": "04:16:51", "text": "我什么时候可以拿到新款？大概"}, {"type": "subtitle", "time": 15414.07, "timestamp": "04:16:54", "text": "明年或者我不知道。我将保持静止"}, {"type": "subtitle", "time": 15415.75, "timestamp": "04:16:55", "text": "带着这个模型四处走走。但是，我"}, {"type": "subtitle", "time": 15418.63, "timestamp": "04:16:58", "text": "想给他一个最后的送别，或者"}]
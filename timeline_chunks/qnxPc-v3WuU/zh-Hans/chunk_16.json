[{"type": "subtitle", "time": 961.749, "timestamp": "00:16:01", "text": "呃，就像你知道的，做些事情，当然你"}, {"type": "subtitle", "time": 963.269, "timestamp": "00:16:03", "text": "得做点事，我的意思是，你知道的"}, {"type": "subtitle", "time": 965.11, "timestamp": "00:16:05", "text": "它不像个机构什么的，它不是"}, {"type": "subtitle", "time": 966.11, "timestamp": "00:16:06", "text": "更多的"}, {"type": "subtitle", "time": 969.629, "timestamp": "00:16:09", "text": "就像我喜欢说的，像个仓库一样"}, {"type": "subtitle", "time": 973.829, "timestamp": "00:16:13", "text": "它就像一个仓库，像一个车库。"}, {"type": "subtitle", "time": 977.71, "timestamp": "00:16:17", "text": "需要存放的东西，我的意思是，我想"}, {"type": "subtitle", "time": 981.269, "timestamp": "00:16:21", "text": "创作者，例如主播和创作者"}, {"type": "subtitle", "time": 983.949, "timestamp": "00:16:23", "text": "有那种东西"}, {"type": "subtitle", "time": 987.79, "timestamp": "00:16:27", "text": "正确的。我感觉自己像"}, {"type": "subtitle", "time": 991.03, "timestamp": "00:16:31", "text": "嗯，那个主播叫什么名字？"}, {"type": "subtitle", "time": 993.15, "timestamp": "00:16:33", "text": "我一直在观察你，嗯"}, {"type": "subtitle", "time": 995.67, "timestamp": "00:16:35", "text": "抽搐？他叫什么名字来着？他应该"}, {"type": "subtitle", "time": 1003.189, "timestamp": "00:16:43", "text": "有可能。啊，他是个大主播。我"}, {"type": "subtitle", "time": 1006.269, "timestamp": "00:16:46", "text": "忘了。他玩的游戏风格类似于大型多人在线游戏（MMO游戏）。"}]
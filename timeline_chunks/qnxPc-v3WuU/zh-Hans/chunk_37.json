[{"type": "subtitle", "time": 2220.03, "timestamp": "00:37:00", "text": "[音乐]"}, {"type": "subtitle", "time": 2222.55, "timestamp": "00:37:02", "text": "是啊，我当时在干什么？我当时是什么？"}, {"type": "subtitle", "time": 2224.91, "timestamp": "00:37:04", "text": "在说什么？我忘了我抱怨过"}, {"type": "subtitle", "time": 2227.67, "timestamp": "00:37:07", "text": "那里。是的。嗯嗯，你觉得呢？"}, {"type": "subtitle", "time": 2230.87, "timestamp": "00:37:10", "text": "以受欺凌者身份示弱是好事吗？如果不行，我们可以"}, {"type": "subtitle", "time": 2232.99, "timestamp": "00:37:12", "text": "总是"}, {"type": "subtitle", "time": 2234.829, "timestamp": "00:37:14", "text": "就像改变"}, {"type": "subtitle", "time": 2237.43, "timestamp": "00:37:17", "text": "它。我的意思是，目前，你打算怎么办？"}, {"type": "subtitle", "time": 2241.71, "timestamp": "00:37:21", "text": "感觉如何？好的，我相信"}, {"type": "subtitle", "time": 2245.87, "timestamp": "00:37:25", "text": "我相信我通常的直播"}, {"type": "subtitle", "time": 2247.71, "timestamp": "00:37:27", "text": "更"}, {"type": "subtitle", "time": 2251.19, "timestamp": "00:37:31", "text": "让我再确认一下。是"}, {"type": "subtitle", "time": 2252.75, "timestamp": "00:37:32", "text": "我通常的直播"}, {"type": "subtitle", "time": 2256.31, "timestamp": "00:37:36", "text": "在？等等，我平时直播的节目也开播了。"}, {"type": "subtitle", "time": 2259.43, "timestamp": "00:37:39", "text": "任意模式。哦，等等。我可能不得不"}, {"type": "subtitle", "time": 2263.55, "timestamp": "00:37:43", "text": "重置一下。等等，真的吗？这一切"}, {"type": "subtitle", "time": 2265.15, "timestamp": "00:37:45", "text": "时间？"}]
[{"type": "subtitle", "time": 13200.87, "timestamp": "03:40:00", "text": "像这样直播已经很久了"}, {"type": "subtitle", "time": 13204.309, "timestamp": "03:40:04", "text": "一段时间。是的。我想问一个问题"}, {"type": "subtitle", "time": 13206.15, "timestamp": "03:40:06", "text": "关于这个问题。是什么？"}, {"type": "subtitle", "time": 13209.349, "timestamp": "03:40:09", "text": "这一切中最难的部分是什么？"}, {"type": "subtitle", "time": 13220.07, "timestamp": "03:40:20", "text": "部分。你知道，最难的部分就是这个。是的。"}, {"type": "subtitle", "time": 13222.63, "timestamp": "03:40:22", "text": "是的。是的。那是什么？最难的部分"}, {"type": "subtitle", "time": 13227.75, "timestamp": "03:40:27", "text": "我的意思是，呃，联系"}, {"type": "subtitle", "time": 13230.229, "timestamp": "03:40:30", "text": "人们都还好，但我却……"}, {"type": "subtitle", "time": 13232.87, "timestamp": "03:40:32", "text": "想太多了"}, {"type": "subtitle", "time": 13235.51, "timestamp": "03:40:35", "text": "呃，那些数字什么的。"}, {"type": "subtitle", "time": 13238.309, "timestamp": "03:40:38", "text": "如果人们不喜欢、不想怎么办？"}, {"type": "subtitle", "time": 13240.79, "timestamp": "03:40:40", "text": "跟我一起做吧，因为我的频道比较小。"}, {"type": "subtitle", "time": 13243.75, "timestamp": "03:40:43", "text": "所有那些事情，那些担忧，都发生了"}, {"type": "subtitle", "time": 13245.91, "timestamp": "03:40:45", "text": "这个月我压力超级大。"}, {"type": "subtitle", "time": 13250.309, "timestamp": "03:40:50", "text": "关于这件事，你们两个现在都知道了。"}, {"type": "subtitle", "time": 13253.83, "timestamp": "03:40:53", "text": "我已经在你的私信里等了很久了。"}]
[{"type": "subtitle", "time": 2102.109, "timestamp": "00:35:02", "text": "哇。是的，"}, {"type": "subtitle", "time": 2105.47, "timestamp": "00:35:05", "text": "那就是你的旅行目的地。哦"}, {"type": "subtitle", "time": 2107.79, "timestamp": "00:35:07", "text": "我的。"}, {"type": "subtitle", "time": 2111.43, "timestamp": "00:35:11", "text": "什么？我的天啊。哦，我忘了是"}, {"type": "subtitle", "time": 2114.15, "timestamp": "00:35:14", "text": "周一。哦，我忘了今天是星期一。哦"}, {"type": "subtitle", "time": 2117.51, "timestamp": "00:35:17", "text": "主。所以工作日你得……"}, {"type": "subtitle", "time": 2120.63, "timestamp": "00:35:20", "text": "没用，我知道，我的意思是，是的，你必须……"}, {"type": "subtitle", "time": 2126.87, "timestamp": "00:35:26", "text": "你知道，我总是忘记所有的事情。"}, {"type": "subtitle", "time": 2129.829, "timestamp": "00:35:29", "text": "就像我的情况是，我刚刚……"}, {"type": "subtitle", "time": 2133.03, "timestamp": "00:35:33", "text": "在家学习，然后参加考试。"}, {"type": "subtitle", "time": 2135.19, "timestamp": "00:35:35", "text": "嗯，考试的时候我一直……"}, {"type": "subtitle", "time": 2136.95, "timestamp": "00:35:36", "text": "忘记了这并非度假"}, {"type": "subtitle", "time": 2140.91, "timestamp": "00:35:40", "text": "现在人人都去度假了"}, {"type": "subtitle", "time": 2145.03, "timestamp": "00:35:45", "text": "工作让他们离开家，而且喜欢"}, {"type": "subtitle", "time": 2147.349, "timestamp": "00:35:47", "text": "触摸草地，辛勤劳作，就像你知道的那样"}, {"type": "subtitle", "time": 2149.91, "timestamp": "00:35:49", "text": "参加各种活动，去办公室，去"}, {"type": "subtitle", "time": 2151.51, "timestamp": "00:35:51", "text": "课程，"}]
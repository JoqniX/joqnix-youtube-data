[{"type": "subtitle", "time": 11764.07, "timestamp": "03:16:04", "text": "他给Neon公司做了坏事。是的，他"}, {"type": "subtitle", "time": 11766.309, "timestamp": "03:16:06", "text": "其实我说这话的时候好像不太喜欢它。"}, {"type": "subtitle", "time": 11768.87, "timestamp": "03:16:08", "text": "当别人选霓虹色的时候，因为我"}, {"type": "subtitle", "time": 11772.469, "timestamp": "03:16:12", "text": "不想看到她和别人在一起。"}, {"type": "subtitle", "time": 11774.309, "timestamp": "03:16:14", "text": "他正在与他人建立一种准社会关系"}, {"type": "subtitle", "time": 11776.19, "timestamp": "03:16:16", "text": "和"}, {"type": "subtitle", "time": 11779.75, "timestamp": "03:16:19", "text": "氖。宝贝，"}, {"type": "subtitle", "time": 11781.429, "timestamp": "03:16:21", "text": "你知道他们正在制作一个新的精选系列"}, {"type": "subtitle", "time": 11783.03, "timestamp": "03:16:23", "text": "系统。你打算怎么对待尼奥？"}, {"type": "subtitle", "time": 11785.429, "timestamp": "03:16:25", "text": "它会来吗？等等，什么？不，等等。"}, {"type": "subtitle", "time": 11788.55, "timestamp": "03:16:28", "text": "什么？真的吗？什么？这是什么系统？我"}, {"type": "subtitle", "time": 11798.469, "timestamp": "03:16:38", "text": "等等，它会像Apex那样吗？"}, {"type": "subtitle", "time": 11801.59, "timestamp": "03:16:41", "text": "就像你知道的每个人一样"}, {"type": "subtitle", "time": 11804.389, "timestamp": "03:16:44", "text": "像一个一个地选？我觉得像"}, {"type": "subtitle", "time": 11807.269, "timestamp": "03:16:47", "text": "那。我不知道。他们已经"}, {"type": "subtitle", "time": 11811.59, "timestamp": "03:16:51", "text": "8月份宣布了这一消息。等等，什么？"}, {"type": "subtitle", "time": 11815.11, "timestamp": "03:16:55", "text": "你们在这里说话没关系。呃，你好。"}, {"type": "subtitle", "time": 11817.269, "timestamp": "03:16:57", "text": "是的。"}]
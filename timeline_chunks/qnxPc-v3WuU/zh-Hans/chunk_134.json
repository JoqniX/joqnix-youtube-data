[{"type": "subtitle", "time": 8052.35, "timestamp": "02:14:12", "text": "我的天哪，他们是"}, {"type": "subtitle", "time": 8068.43, "timestamp": "02:14:28", "text": "欢迎来到阿卡比亚。你好吗"}, {"type": "subtitle", "time": 8070.87, "timestamp": "02:14:30", "text": "今天？欢迎回来。谢谢你"}, {"type": "subtitle", "time": 8073.669, "timestamp": "02:14:33", "text": "如今在户外生存下去。"}, {"type": "subtitle", "time": 8075.629, "timestamp": "02:14:35", "text": "我做了什么？我甚至都不认识"}, {"type": "subtitle", "time": 8087.27, "timestamp": "02:14:47", "text": "这些人都在全力以赴。"}]
[{"type": "subtitle", "time": 16382.63, "timestamp": "04:33:02", "text": "我帮你拿吧。他就像"}, {"type": "subtitle", "time": 16385.83, "timestamp": "04:33:05", "text": "大概几个月前就挺出名的。"}, {"type": "subtitle", "time": 16387.59, "timestamp": "04:33:07", "text": "前。我想你可能已经看到了"}, {"type": "subtitle", "time": 16388.99, "timestamp": "04:33:08", "text": "那"}, {"type": "subtitle", "time": 16406.949, "timestamp": "04:33:26", "text": "什么？还有另一个人。有"}, {"type": "subtitle", "time": 16409.59, "timestamp": "04:33:29", "text": "另一个人。稍等片刻。让我"}, {"type": "subtitle", "time": 16412.551, "timestamp": "04:33:32", "text": "找到它就行了。是的，这种情况有可能发生。"}, {"type": "subtitle", "time": 16414.15, "timestamp": "04:33:34", "text": "哦，不。不，是同一个人。对不起。"}, {"type": "subtitle", "time": 16418.551, "timestamp": "04:33:38", "text": "是同一个人。该死。"}, {"type": "subtitle", "time": 16421.029, "timestamp": "04:33:41", "text": "是的。所以，"}, {"type": "subtitle", "time": 16423.83, "timestamp": "04:33:43", "text": "是的。我想做点什么，比如做某件事。"}, {"type": "subtitle", "time": 16427.429, "timestamp": "04:33:47", "text": "就像那样，你知道的。"}, {"type": "subtitle", "time": 16429.789, "timestamp": "04:33:49", "text": "查德看不见。那只是感觉而已。"}, {"type": "subtitle", "time": 16433.07, "timestamp": "04:33:53", "text": "伤心。我刚刚放"}, {"type": "subtitle", "time": 16436.551, "timestamp": "04:33:56", "text": "是的。好的。随便聊聊，就说“嗯……”"}, {"type": "subtitle", "time": 16439.349, "timestamp": "04:33:59", "text": "黏土油管模特，而那个人将"}]
[{"type": "subtitle", "time": 14641.83, "timestamp": "04:04:01", "text": "是的。去日本，压力，说"}, {"type": "subtitle", "time": 14644.87, "timestamp": "04:04:04", "text": "跟所有人告别之类的。然后是"}, {"type": "subtitle", "time": 14647.349, "timestamp": "04:04:07", "text": "中间的流媒体播放出现问题"}, {"type": "subtitle", "time": 14649.15, "timestamp": "04:04:09", "text": "比如技术"}, {"type": "subtitle", "time": 14651.55, "timestamp": "04:04:11", "text": "问题。"}, {"type": "subtitle", "time": 14655.269, "timestamp": "04:04:15", "text": "嗯，我觉得我失去了一些朋友。我"}, {"type": "subtitle", "time": 14658.389, "timestamp": "04:04:18", "text": "感觉好像有几个我的"}, {"type": "subtitle", "time": 14660.83, "timestamp": "04:04:20", "text": "那些惹上麻烦的朋友"}, {"type": "subtitle", "time": 14665.269, "timestamp": "04:04:25", "text": "我参加的一些事情和活动，包括……"}, {"type": "subtitle", "time": 14668.71, "timestamp": "04:04:28", "text": "乐趣。就像有好有坏一样。"}, {"type": "subtitle", "time": 14671.67, "timestamp": "04:04:31", "text": "很多。它里面充满了"}, {"type": "subtitle", "time": 14673.71, "timestamp": "04:04:33", "text": "我想，一切都是……"}, {"type": "subtitle", "time": 14677.349, "timestamp": "04:04:37", "text": "正确的？复杂的情绪和"}, {"type": "subtitle", "time": 14680.309, "timestamp": "04:04:40", "text": "最主要的是幕后的事情"}, {"type": "subtitle", "time": 14684.469, "timestamp": "04:04:44", "text": "关于哦，是的，凡人的事，以及"}, {"type": "subtitle", "time": 14686.389, "timestamp": "04:04:46", "text": "一切。"}, {"type": "subtitle", "time": 14688.07, "timestamp": "04:04:48", "text": "和"}, {"type": "subtitle", "time": 14689.71, "timestamp": "04:04:49", "text": "我仍然"}, {"type": "subtitle", "time": 14693.03, "timestamp": "04:04:53", "text": "难道我没想过邀请吗？"}, {"type": "subtitle", "time": 14697.51, "timestamp": "04:04:57", "text": "他们俩都对琼感兴趣。"}]
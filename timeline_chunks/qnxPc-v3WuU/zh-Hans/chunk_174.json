[{"type": "subtitle", "time": 10441.51, "timestamp": "02:54:01", "text": "哦，是的。好的。哦，等等。我认为"}, {"type": "subtitle", "time": 10444.03, "timestamp": "02:54:04", "text": "送礼季快到了，对吧？"}, {"type": "subtitle", "time": 10447.19, "timestamp": "02:54:07", "text": "是送礼吗？我不知道。他们说"}, {"type": "subtitle", "time": 10449.51, "timestamp": "02:54:09", "text": "2023年。"}, {"type": "subtitle", "time": 10452.07, "timestamp": "02:54:12", "text": "你可以赠送皮肤。是的。是的。只是"}, {"type": "subtitle", "time": 10454.469, "timestamp": "02:54:14", "text": "像其他游戏一样，《Apex英雄》、《堡垒之夜》和"}, {"type": "subtitle", "time": 10456.63, "timestamp": "02:54:16", "text": "东西。呃，他们说他们正在努力……"}, {"type": "subtitle", "time": 10460.11, "timestamp": "02:54:20", "text": "礼物制度。"}, {"type": "subtitle", "time": 10464.07, "timestamp": "02:54:24", "text": "哦，我不知道这件事。是的。"}, {"type": "subtitle", "time": 10467.269, "timestamp": "02:54:27", "text": "我们应该去排队看新加坡的演出吗？"}, {"type": "subtitle", "time": 10469.51, "timestamp": "02:54:29", "text": "Cuz V 来自"}, {"type": "subtitle", "time": 10471.75, "timestamp": "02:54:31", "text": "嗯，这取决于你。这取决于你。"}, {"type": "subtitle", "time": 10474.71, "timestamp": "02:54:34", "text": "好的。好的。好的。新加坡"}, {"type": "subtitle", "time": 10479.99, "timestamp": "02:54:39", "text": "现在。快点。好的。 81岁和79岁"}, {"type": "subtitle", "time": 10483.11, "timestamp": "02:54:43", "text": "没有拥抱。好的。我们走吧。扣球。"}, {"type": "subtitle", "time": 10488.87, "timestamp": "02:54:48", "text": "你是说所有的钱都要捐给"}, {"type": "subtitle", "time": 10491.429, "timestamp": "02:54:51", "text": "她。好的。这个。"}, {"type": "subtitle", "time": 10493.59, "timestamp": "02:54:53", "text": "如果我们是孟买，那就没问题。你是"}, {"type": "subtitle", "time": 10497.95, "timestamp": "02:54:57", "text": "当然？我代表新加坡。没关系。它是"}]
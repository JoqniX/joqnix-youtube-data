[{"type": "subtitle", "time": 9540.55, "timestamp": "02:39:00", "text": "是的，chi。我们在玩什么游戏？任何事物"}, {"type": "subtitle", "time": 9543.429, "timestamp": "02:39:03", "text": "你会喜欢的。尖刺突袭，我们没有。"}, {"type": "subtitle", "time": 9545.11, "timestamp": "02:39:05", "text": "尝试。"}, {"type": "subtitle", "time": 9546.87, "timestamp": "02:39:06", "text": "你喜欢什么都行。我的意思是，你曾经是"}, {"type": "subtitle", "time": 9551.11, "timestamp": "02:39:11", "text": "领导者。哦好的。我们先来吧，因为"}, {"type": "subtitle", "time": 9553.19, "timestamp": "02:39:13", "text": "我们进行了申请和升级"}, {"type": "subtitle", "time": 9554.87, "timestamp": "02:39:14", "text": "更早。"}, {"type": "subtitle", "time": 9562.51, "timestamp": "02:39:22", "text": "那么，该怎么做呢？"}, {"type": "subtitle", "time": 9565.19, "timestamp": "02:39:25", "text": "尤卡，你觉得怎么样？"}, {"type": "subtitle", "time": 9567.23, "timestamp": "02:39:27", "text": "前辈？"}, {"type": "subtitle", "time": 9572.389, "timestamp": "02:39:32", "text": "呃，想什么？想想今天。"}, {"type": "subtitle", "time": 9575.75, "timestamp": "02:39:35", "text": "今天？是的，我尿了很多次。"}, {"type": "subtitle", "time": 9578.23, "timestamp": "02:39:38", "text": "原因。你当时正在观看直播。你曾是"}, {"type": "subtitle", "time": 9582.15, "timestamp": "02:39:42", "text": "之前也直播过，对吧？是的。"}, {"type": "subtitle", "time": 9584.87, "timestamp": "02:39:44", "text": "看看这家伙。他正在直播"}, {"type": "subtitle", "time": 9586.67, "timestamp": "02:39:46", "text": "早晨和"}, {"type": "subtitle", "time": 9590.79, "timestamp": "02:39:50", "text": "那我想大概花了多少钱？和"}, {"type": "subtitle", "time": 9592.63, "timestamp": "02:39:52", "text": "半小时休息或一小时休息。我"}, {"type": "subtitle", "time": 9595.11, "timestamp": "02:39:55", "text": "不，我甚至都不记得了。然后他"}, {"type": "subtitle", "time": 9596.79, "timestamp": "02:39:56", "text": "当时我就想，“哦耶，我又开始直播了。”"}]
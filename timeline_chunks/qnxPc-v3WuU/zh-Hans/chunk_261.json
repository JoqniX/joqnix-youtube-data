[{"type": "subtitle", "time": 15660.95, "timestamp": "04:21:00", "text": "那。如果你只是觉得，你知道"}, {"type": "subtitle", "time": 15663.11, "timestamp": "04:21:03", "text": "什么？停止思考。我想我该走了"}, {"type": "subtitle", "time": 15665.91, "timestamp": "04:21:05", "text": "一切都会好起来的，你知道的。你为什么不呢？"}, {"type": "subtitle", "time": 15667.67, "timestamp": "04:21:07", "text": "你觉得呢？我觉得我将会完全"}, {"type": "subtitle", "time": 15670.309, "timestamp": "04:21:10", "text": "这样做是对的。是的。你知道，"}, {"type": "subtitle", "time": 15671.83, "timestamp": "04:21:11", "text": "因为"}, {"type": "subtitle", "time": 15673.75, "timestamp": "04:21:13", "text": "我们是好朋友，对吧？我们很好。"}, {"type": "subtitle", "time": 15677.189, "timestamp": "04:21:17", "text": "好朋友。是的。是的。是的。"}, {"type": "subtitle", "time": 15680.87, "timestamp": "04:21:20", "text": "所以，即使你变得超级有名，而我"}, {"type": "subtitle", "time": 15684.149, "timestamp": "04:21:24", "text": "就像一个只有两个观众的主播一样，我会"}, {"type": "subtitle", "time": 15686.07, "timestamp": "04:21:26", "text": "我仍然视你为我的好朋友，你"}, {"type": "chat", "time": 15687.254, "timestamp": "04:21:27", "author": "@kaiguyniki", "avatar": "https://yt4.ggpht.com/f9aZERpOc1bv1JDUl12ZTXeQ7j1KdXBflkbl-6qlBLzM-hbbEQKWUlPpcJJxTU-qSUwNxrez=s64-c-k-c0x00ffffff-no-rj", "message": "best thing to just have fun"}, {"type": "subtitle", "time": 15688.87, "timestamp": "04:21:28", "text": "知道。一切都不会改变。"}, {"type": "subtitle", "time": 15690.95, "timestamp": "04:21:30", "text": "我想我相信你确实给我展示了一个"}, {"type": "subtitle", "time": 15693.83, "timestamp": "04:21:33", "text": "例如，在 DM 上展示像某人一样的例子"}, {"type": "subtitle", "time": 15696.229, "timestamp": "04:21:36", "text": "其他人的直播，就像你记得的那样"}, {"type": "subtitle", "time": 15697.99, "timestamp": "04:21:37", "text": "那。"}, {"type": "subtitle", "time": 15701.83, "timestamp": "04:21:41", "text": "是的。是的，我知道。因为我同意。"}, {"type": "subtitle", "time": 15705.389, "timestamp": "04:21:45", "text": "是的。因为我当时压力太大了"}, {"type": "subtitle", "time": 15709.189, "timestamp": "04:21:49", "text": "总有一天会实现的。就像这些数字一样"}, {"type": "subtitle", "time": 15710.59, "timestamp": "04:21:50", "text": "东西"}, {"type": "subtitle", "time": 15714.87, "timestamp": "04:21:54", "text": "因为我尝试过的一些合作"}, {"type": "subtitle", "time": 15717.83, "timestamp": "04:21:57", "text": "为了联系人们，我联系了它。"}]
[{"type": "subtitle", "time": 13264.389, "timestamp": "03:41:04", "text": "是的。是的。我的语音留言一般般。"}, {"type": "subtitle", "time": 13268.03, "timestamp": "03:41:08", "text": "长的。嗯。这么久。这家伙给我发了条信息"}, {"type": "subtitle", "time": 13272.03, "timestamp": "03:41:12", "text": "语音留言，比如他最高的状态就像"}, {"type": "subtitle", "time": 13277.87, "timestamp": "03:41:17", "text": "45. 就像最高点一样。 45. 我坐了下来。"}, {"type": "subtitle", "time": 13281.429, "timestamp": "03:41:21", "text": "我坐在那里，像喝酒一样。"}, {"type": "subtitle", "time": 13283.349, "timestamp": "03:41:23", "text": "一边喝咖啡一边听这家伙说话"}, {"type": "subtitle", "time": 13287.03, "timestamp": "03:41:27", "text": "我正在听播客。"}, {"type": "subtitle", "time": 13290.07, "timestamp": "03:41:30", "text": "那是我人生中最低落的时期。"}, {"type": "subtitle", "time": 13291.99, "timestamp": "03:41:31", "text": "听朋友在《美国之声》节目中的表现，感觉真好。"}, {"type": "subtitle", "time": 13296.87, "timestamp": "03:41:36", "text": "聊天。那是最低的数值。"}, {"type": "subtitle", "time": 13299.99, "timestamp": "03:41:39", "text": "但没错，就像他一贯的作风一样"}, {"type": "subtitle", "time": 13303.63, "timestamp": "03:41:43", "text": "给我留个15分钟的语音留言吧"}, {"type": "subtitle", "time": 13306.67, "timestamp": "03:41:46", "text": "不真实，而且令人恼火。"}, {"type": "subtitle", "time": 13310.229, "timestamp": "03:41:50", "text": "什么？你是什​​么意思？"}, {"type": "subtitle", "time": 13312.229, "timestamp": "03:41:52", "text": "你每次都像他那样给我发信息"}, {"type": "subtitle", "time": 13313.75, "timestamp": "03:41:53", "text": "给我发语音留言，这不像"}, {"type": "subtitle", "time": 13316.15, "timestamp": "03:41:56", "text": "嗨，你好吗？他想要的一切"}, {"type": "subtitle", "time": 13318.71, "timestamp": "03:41:58", "text": "仅用一点就告诉我。他"}]
[{"type": "subtitle", "time": 10323.429, "timestamp": "02:52:03", "text": "你好。我该买吗？我不知道。做"}, {"type": "subtitle", "time": 10325.269, "timestamp": "02:52:05", "text": "我有钱买吗？我甚至都不认识"}, {"type": "subtitle", "time": 10327.99, "timestamp": "02:52:07", "text": "知道。三个 3,000。"}, {"type": "subtitle", "time": 10330.95, "timestamp": "02:52:10", "text": "我不知道那是多少。"}, {"type": "subtitle", "time": 10332.95, "timestamp": "02:52:12", "text": "哦，你好。"}, {"type": "subtitle", "time": 10344.429, "timestamp": "02:52:24", "text": "告诉我你被那个人摸了"}, {"type": "subtitle", "time": 10348.15, "timestamp": "02:52:28", "text": "氖。这是霓虹灯吗？是的，我做了。我做了。"}, {"type": "subtitle", "time": 10350.95, "timestamp": "02:52:30", "text": "但我喜欢吗？那就是"}, {"type": "subtitle", "time": 10357.59, "timestamp": "02:52:37", "text": "不，我没有。"}, {"type": "subtitle", "time": 10359.269, "timestamp": "02:52:39", "text": "你们平时都听什么类型的音乐？"}, {"type": "subtitle", "time": 10361.11, "timestamp": "02:52:41", "text": "到？"}, {"type": "subtitle", "time": 10363.59, "timestamp": "02:52:43", "text": "我喜欢听日本音乐。呃，你可以"}, {"type": "subtitle", "time": 10365.75, "timestamp": "02:52:45", "text": "继续这样做。是的，我确实会听。"}, {"type": "subtitle", "time": 10367.95, "timestamp": "02:52:47", "text": "日本人。是的。"}, {"type": "subtitle", "time": 10370.23, "timestamp": "02:52:50", "text": "嗯哼。你们喜欢什么类型的音乐？"}, {"type": "subtitle", "time": 10373.83, "timestamp": "02:52:53", "text": "听？是这个吗？呃，为了"}, {"type": "subtitle", "time": 10375.83, "timestamp": "02:52:55", "text": "是这个吗？是这个吗？"}, {"type": "subtitle", "time": 10377.51, "timestamp": "02:52:57", "text": "这个怎么样？我计划"}]
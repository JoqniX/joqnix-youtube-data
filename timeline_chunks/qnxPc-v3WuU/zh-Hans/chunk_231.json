[{"type": "subtitle", "time": 13862.15, "timestamp": "03:51:02", "text": "哦，该死。不行。并非全部。"}, {"type": "subtitle", "time": 13866.79, "timestamp": "03:51:06", "text": "乔，要学会所有东西。你好。你好。"}, {"type": "subtitle", "time": 13868.309, "timestamp": "03:51:08", "text": "你不能去赴约，或者"}, {"type": "subtitle", "time": 13870.79, "timestamp": "03:51:10", "text": "某物。我不能参加你的婚礼了，"}, {"type": "subtitle", "time": 13873.269, "timestamp": "03:51:13", "text": "你他妈的蜜月。"}, {"type": "subtitle", "time": 13875.67, "timestamp": "03:51:15", "text": "我的天啊。当你拉屎的时候，"}, {"type": "subtitle", "time": 13878.15, "timestamp": "03:51:18", "text": "我会到的，兄弟。但要始终陪伴在身边。"}, {"type": "subtitle", "time": 13880.07, "timestamp": "03:51:20", "text": "男人。"}, {"type": "subtitle", "time": 13882.71, "timestamp": "03:51:22", "text": "我只要给你一张湿巾就行了。这里"}, {"type": "subtitle", "time": 13885.75, "timestamp": "03:51:25", "text": "我们走吧，伙计。"}, {"type": "subtitle", "time": 13887.83, "timestamp": "03:51:27", "text": "是的。嗯，总之，回到“是的”这个话题。"}, {"type": "subtitle", "time": 13890.75, "timestamp": "03:51:30", "text": "是的。重新回到正轨。"}, {"type": "subtitle", "time": 13892.99, "timestamp": "03:51:32", "text": "嗯，是的，就像"}, {"type": "subtitle", "time": 13896.87, "timestamp": "03:51:36", "text": "嗯，我觉得我没办法照顾到所有人。"}, {"type": "subtitle", "time": 13899.189, "timestamp": "03:51:39", "text": "再次因为大多数人都会"}, {"type": "subtitle", "time": 13903.59, "timestamp": "03:51:43", "text": "比西加上呃，来自老家伙们"}, {"type": "subtitle", "time": 13907.429, "timestamp": "03:51:47", "text": "我想这个我应该能买到几个。"}, {"type": "subtitle", "time": 13909.83, "timestamp": "03:51:49", "text": "但我也不想让人们这样想"}, {"type": "subtitle", "time": 13912.79, "timestamp": "03:51:52", "text": "是的，Jock邀请我参加了第一次"}, {"type": "subtitle", "time": 13914.71, "timestamp": "03:51:54", "text": "第二个他没邀请的那种"}, {"type": "subtitle", "time": 13917.349, "timestamp": "03:51:57", "text": "因为最终我还是想……"}, {"type": "subtitle", "time": 13919.83, "timestamp": "03:51:59", "text": "想办法让所有人都进来，但我做不到。"}]
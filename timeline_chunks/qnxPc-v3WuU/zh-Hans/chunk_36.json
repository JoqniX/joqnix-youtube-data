[{"type": "subtitle", "time": 2171.03, "timestamp": "00:36:11", "text": "活动延期了。是的。是的。是的。它"}, {"type": "subtitle", "time": 2178.71, "timestamp": "00:36:18", "text": "是的。连我的家人都说：“你愿意吗？”"}, {"type": "subtitle", "time": 2181.23, "timestamp": "00:36:21", "text": "真的必须继续下去"}, {"type": "subtitle", "time": 2185.23, "timestamp": "00:36:25", "text": "周六？周一可以去。”我当时就想，"}, {"type": "subtitle", "time": 2190.95, "timestamp": "00:36:30", "text": "“不，我还有些事要做。我得……”"}]
[{"type": "subtitle", "time": 420.95, "timestamp": "00:07:00", "text": "将。有点……我不知道是不是"}, {"type": "subtitle", "time": 424.629, "timestamp": "00:07:04", "text": "这很奇怪，但我也觉得"}, {"type": "subtitle", "time": 427.589, "timestamp": "00:07:07", "text": "嗯，我有点认真对待这件事了。"}, {"type": "subtitle", "time": 428.749, "timestamp": "00:07:08", "text": "方式"}, {"type": "subtitle", "time": 432.189, "timestamp": "00:07:12", "text": "举止得体，严肃认真"}, {"type": "subtitle", "time": 434.35, "timestamp": "00:07:14", "text": "方式或"}, {"type": "subtitle", "time": 436.87, "timestamp": "00:07:16", "text": "以严肃的态度，比如“我会……”"}, {"type": "subtitle", "time": 441.629, "timestamp": "00:07:21", "text": "稍后会详细说明，这样就可以了。"}, {"type": "subtitle", "time": 444.79, "timestamp": "00:07:24", "text": "更难了"}, {"type": "subtitle", "time": 446.629, "timestamp": "00:07:26", "text": "呃，如果我与一家公司合作的话"}, {"type": "subtitle", "time": 448.629, "timestamp": "00:07:28", "text": "或者别的什么，不，不会，因为我"}, {"type": "subtitle", "time": 449.469, "timestamp": "00:07:29", "text": "必须"}, {"type": "subtitle", "time": 453.43, "timestamp": "00:07:33", "text": "嗯，我也得帮他们宣传一下。"}, {"type": "subtitle", "time": 454.79, "timestamp": "00:07:34", "text": "通过我以及所有这一切"}, {"type": "subtitle", "time": 456.30899999999997, "timestamp": "00:07:36", "text": "现在拥有这些东西，同时保留我自己的东西"}, {"type": "subtitle", "time": 459.029, "timestamp": "00:07:39", "text": "个人用品等等。"}, {"type": "subtitle", "time": 461.27, "timestamp": "00:07:41", "text": "所以从某种程度上来说，我觉得这有点像……"}, {"type": "subtitle", "time": 462.83, "timestamp": "00:07:42", "text": "疼痛和"}, {"type": "subtitle", "time": 465.909, "timestamp": "00:07:45", "text": "虽然很难，但我们希望有人能帮上忙。"}, {"type": "subtitle", "time": 469.55, "timestamp": "00:07:49", "text": "除了我以外，其他人都能接受我"}, {"type": "subtitle", "time": 474.71, "timestamp": "00:07:54", "text": "骑师和我的奥尼克西亚玩意儿，我喜欢"}, {"type": "subtitle", "time": 477.909, "timestamp": "00:07:57", "text": "说到底，就像你知道的，我"}, {"type": "subtitle", "time": 479.79, "timestamp": "00:07:59", "text": "没有"}]
[{"type": "subtitle", "time": 15601.349, "timestamp": "04:20:01", "text": "不再是小主播之类的了，但是"}, {"type": "subtitle", "time": 15605.03, "timestamp": "04:20:05", "text": "我仍然认为自己只是个小主播。"}, {"type": "chat", "time": 15605.572, "timestamp": "04:20:05", "author": "@kaiguyniki", "avatar": "https://yt4.ggpht.com/f9aZERpOc1bv1JDUl12ZTXeQ7j1KdXBflkbl-6qlBLzM-hbbEQKWUlPpcJJxTU-qSUwNxrez=s64-c-k-c0x00ffffff-no-rj", "message": "you're thinking too much about it"}, {"type": "subtitle", "time": 15608.469, "timestamp": "04:20:08", "text": "或者一个没人给我看"}, {"type": "subtitle", "time": 15610.309, "timestamp": "04:20:10", "text": "我不认为，我不认为你是"}, {"type": "subtitle", "time": 15613.269, "timestamp": "04:20:13", "text": "就像一条小彩带。我是。是的，"}, {"type": "subtitle", "time": 15616.149, "timestamp": "04:20:16", "text": "确切地。就像海·国木说的那样，你是"}, {"type": "subtitle", "time": 15618.79, "timestamp": "04:20:18", "text": "想太多了。"}, {"type": "subtitle", "time": 15620.63, "timestamp": "04:20:20", "text": "你们能看出他想太多了吗？"}, {"type": "subtitle", "time": 15622.87, "timestamp": "04:20:22", "text": "你们能看出来吗？"}, {"type": "subtitle", "time": 15627.99, "timestamp": "04:20:27", "text": "我确实想太多了。是的。是的。"}, {"type": "subtitle", "time": 15632.309, "timestamp": "04:20:32", "text": "闭嘴。我想太多了，伙计。哦，"}, {"type": "subtitle", "time": 15635.269, "timestamp": "04:20:35", "text": "你就别想那么多了，老兄。"}, {"type": "chat", "time": 15637.552, "timestamp": "04:20:37", "author": "@kaiguyniki", "avatar": "https://yt4.ggpht.com/f9aZERpOc1bv1JDUl12ZTXeQ7j1KdXBflkbl-6qlBLzM-hbbEQKWUlPpcJJxTU-qSUwNxrez=s64-c-k-c0x00ffffff-no-rj", "message": "just be yourself"}, {"type": "subtitle", "time": 15638.79, "timestamp": "04:20:38", "text": "世界上最快乐的动物是金鱼"}, {"type": "subtitle", "time": 15641.189, "timestamp": "04:20:41", "text": "因为它什么都不想，因为它"}, {"type": "subtitle", "time": 15644.149, "timestamp": "04:20:44", "text": "记不起来了。"}, {"type": "subtitle", "time": 15647.51, "timestamp": "04:20:47", "text": "做你自己就好。确切地。"}, {"type": "subtitle", "time": 15656.07, "timestamp": "04:20:56", "text": "你只是对一些事情太紧张了，你"}, {"type": "subtitle", "time": 15658.63, "timestamp": "04:20:58", "text": "知道？对此感到紧张，对……感到紧张"}]
[{"type": "subtitle", "time": 3841.91, "timestamp": "01:04:01", "text": "好可爱。某种程度上来说。那是"}, {"type": "subtitle", "time": 3844.349, "timestamp": "01:04:04", "text": "太可爱了。"}, {"type": "subtitle", "time": 3846.91, "timestamp": "01:04:06", "text": "以一种如此的方式"}, {"type": "subtitle", "time": 3849.589, "timestamp": "01:04:09", "text": "可爱的。好的。呃，我快完成了"}, {"type": "subtitle", "time": 3853.109, "timestamp": "01:04:13", "text": "多表功能。呃，你们可以"}, {"type": "subtitle", "time": 3857.549, "timestamp": "01:04:17", "text": "请查看描述。"}, {"type": "subtitle", "time": 3859.87, "timestamp": "01:04:19", "text": "三，"}, {"type": "subtitle", "time": 3861.63, "timestamp": "01:04:21", "text": "二，"}, {"type": "subtitle", "time": 3865.75, "timestamp": "01:04:25", "text": "一。我们走吧。你好。所以，描述"}, {"type": "subtitle", "time": 3868.39, "timestamp": "01:04:28", "text": "应该更新。呃，我和扎克是"}, {"type": "subtitle", "time": 3871.349, "timestamp": "01:04:31", "text": "目前正在直播。我们是呃，我们"}, {"type": "subtitle", "time": 3874.549, "timestamp": "01:04:34", "text": "我们正在一起玩瓦莱林。她是"}, {"type": "subtitle", "time": 3876.87, "timestamp": "01:04:36", "text": "也在练习场练习。"}, {"type": "subtitle", "time": 3878.99, "timestamp": "01:04:38", "text": "就在我们说话的此刻。她也是"}, {"type": "subtitle", "time": 3881.43, "timestamp": "01:04:41", "text": "流媒体。是的。是的。你好，哈希。"}, {"type": "subtitle", "time": 3884.19, "timestamp": "01:04:44", "text": "你好吗？希望你一切顺利"}, {"type": "subtitle", "time": 3887.109, "timestamp": "01:04:47", "text": "出色地。你好吗？你的战斗如何？"}, {"type": "subtitle", "time": 3888.789, "timestamp": "01:04:48", "text": "昨天那部分？我当时在玩"}, {"type": "subtitle", "time": 3891.589, "timestamp": "01:04:51", "text": "朋友们。你赢了吗？祝你赢。我"}, {"type": "subtitle", "time": 3898.789, "timestamp": "01:04:58", "text": "溪流。哦，是的。哦，是的。你知道吗"}]
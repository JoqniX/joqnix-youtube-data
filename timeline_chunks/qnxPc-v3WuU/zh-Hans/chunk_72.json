[{"type": "subtitle", "time": 4322.229, "timestamp": "01:12:02", "text": "你好。你好吗？"}, {"type": "subtitle", "time": 4324.709, "timestamp": "01:12:04", "text": "笑话。我一直都很抱歉。我"}, {"type": "subtitle", "time": 4328.03, "timestamp": "01:12:08", "text": "他以为他是女孩。等待，"}, {"type": "subtitle", "time": 4332.51, "timestamp": "01:12:12", "text": "什么？什么？哦，不。熏肉"}, {"type": "subtitle", "time": 4335.79, "timestamp": "01:12:15", "text": "以为你是"}, {"type": "subtitle", "time": 4338.7, "timestamp": "01:12:18", "text": "死者。"}, {"type": "subtitle", "time": 4340.91, "timestamp": "01:12:20", "text": "[音乐]"}, {"type": "subtitle", "time": 4345.03, "timestamp": "01:12:25", "text": "嗯？哦，等等。儿子也在这里。你好。"}, {"type": "subtitle", "time": 4348.55, "timestamp": "01:12:28", "text": "哦，他就是不说话。"}, {"type": "subtitle", "time": 4351.11, "timestamp": "01:12:31", "text": "是的。还记得我是怎么跟你说的吗？"}, {"type": "subtitle", "time": 4353.27, "timestamp": "01:12:33", "text": "我也威胁过别人。"}, {"type": "subtitle", "time": 4356.229, "timestamp": "01:12:36", "text": "跟我们一起走吧？那是国家层面的问题。"}, {"type": "subtitle", "time": 4357.27, "timestamp": "01:12:37", "text": "有人以为你生了个女儿。所以，"}, {"type": "subtitle", "time": 4359.189, "timestamp": "01:12:39", "text": "Mangle State 也在这里。我明白了。"}, {"type": "subtitle", "time": 4361.59, "timestamp": "01:12:41", "text": "很多。那将如同第七次一样。"}, {"type": "subtitle", "time": 4363.99, "timestamp": "01:12:43", "text": "他一句话也不说。让我看看"}, {"type": "subtitle", "time": 4366.709, "timestamp": "01:12:46", "text": "他在说些什么。可以使用我的"}, {"type": "subtitle", "time": 4370.87, "timestamp": "01:12:50", "text": "Discord，因为一切都没问题。他做不到"}, {"type": "subtitle", "time": 4373.35, "timestamp": "01:12:53", "text": "他会用游戏内的方式说话，但不会直接说出来。"}, {"type": "subtitle", "time": 4376.229, "timestamp": "01:12:56", "text": "麦克风。我指的是游戏内聊天。哦，"}]
[{"type": "subtitle", "time": 4745.43, "timestamp": "01:19:05", "text": "这样做效果如何？"}, {"type": "subtitle", "time": 4749.11, "timestamp": "01:19:09", "text": "是啊，肯定爽爆了。"}, {"type": "subtitle", "time": 4750.59, "timestamp": "01:19:10", "text": "哦，我的"}, {"type": "subtitle", "time": 4764.229, "timestamp": "01:19:24", "text": "坏的？对不起。寒冷的。是冷的。好的。"}, {"type": "subtitle", "time": 4775.51, "timestamp": "01:19:35", "text": "哦，不。我觉得我好像在杀了她。"}, {"type": "subtitle", "time": 4777.91, "timestamp": "01:19:37", "text": "太多了。她很生气。我很抱歉。"}, {"type": "subtitle", "time": 4779.669, "timestamp": "01:19:39", "text": "我的天啊。我简直要把她逼疯了。哦"}, {"type": "subtitle", "time": 4782.709, "timestamp": "01:19:42", "text": "我的上帝。我看见她了。我的天啊。我是"}, {"type": "subtitle", "time": 4785.79, "timestamp": "01:19:45", "text": "狠狠地杀了她。哦，我的"}, {"type": "subtitle", "time": 4789.83, "timestamp": "01:19:49", "text": "上帝。我的天哪。我要杀了她"}, {"type": "subtitle", "time": 4791.75, "timestamp": "01:19:51", "text": "很多。我的天啊。你是说……"}, {"type": "subtitle", "time": 4794.95, "timestamp": "01:19:54", "text": "他没有哦也这么优秀"}]
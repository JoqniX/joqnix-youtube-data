[{"type": "subtitle", "time": 3602.51, "timestamp": "01:00:02", "text": "最好的。那么，让我们开始吧！"}, {"type": "subtitle", "time": 3605.43, "timestamp": "01:00:05", "text": "最好的。呃，我忘了发推特。那么，让我"}, {"type": "subtitle", "time": 3607.309, "timestamp": "01:00:07", "text": "就这么做"}, {"type": "subtitle", "time": 3610.23, "timestamp": "01:00:10", "text": "那。我很抱歉。所以，让我……让我"}, {"type": "subtitle", "time": 3612.15, "timestamp": "01:00:12", "text": "让我来处理一下。所以，"}, {"type": "subtitle", "time": 3614.789, "timestamp": "01:00:14", "text": "你好吗？赫拉克勒斯。你好吗"}, {"type": "subtitle", "time": 3617.67, "timestamp": "01:00:17", "text": "爱德华，你在做什么？欢迎。欢迎。怎样"}, {"type": "subtitle", "time": 3618.67, "timestamp": "01:00:18", "text": "你们"}, {"type": "subtitle", "time": 3636.15, "timestamp": "01:00:36", "text": "[音乐]"}, {"type": "subtitle", "time": 3639.99, "timestamp": "01:00:39", "text": "你好。你好。去。去。呃，我的家人只是"}, {"type": "subtitle", "time": 3642.549, "timestamp": "01:00:42", "text": "因客人来访而中断。但"}, {"type": "subtitle", "time": 3645.03, "timestamp": "01:00:45", "text": "是的，所以我们要这样做。"}, {"type": "subtitle", "time": 3648.309, "timestamp": "01:00:48", "text": "你会玩《Valerant》吗？是的。"}, {"type": "subtitle", "time": 3655.109, "timestamp": "01:00:55", "text": "更好的。我的天哪，我总是忘记"}, {"type": "subtitle", "time": 3659.51, "timestamp": "01:00:59", "text": "那。好的，等等。我的天啊，我真是……我真是"}]
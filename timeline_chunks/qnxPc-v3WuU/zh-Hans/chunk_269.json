[{"type": "subtitle", "time": 16143.95, "timestamp": "04:29:03", "text": "在一些朋友的帮助下，以及仅仅通过"}, {"type": "subtitle", "time": 16147.67, "timestamp": "04:29:07", "text": "正在看一些主播的视频"}, {"type": "subtitle", "time": 16150.63, "timestamp": "04:29:10", "text": "就像在Twitch上作弊一样，就像直播一样"}, {"type": "subtitle", "time": 16152.71, "timestamp": "04:29:12", "text": "在 Twitch 上作弊，因为我关注了你"}, {"type": "subtitle", "time": 16154.75, "timestamp": "04:29:14", "text": "那种类型的人和"}, {"type": "subtitle", "time": 16158.229, "timestamp": "04:29:18", "text": "你知道，女孩们，我就问她们。"}, {"type": "subtitle", "time": 16160.469, "timestamp": "04:29:20", "text": "有问题或者只是想问什么？"}, {"type": "subtitle", "time": 16162.469, "timestamp": "04:29:22", "text": "我该怎么做？"}, {"type": "subtitle", "time": 16164.71, "timestamp": "04:29:24", "text": "他们只是把它显示在屏幕上。真是太"}, {"type": "subtitle", "time": 16168.07, "timestamp": "04:29:28", "text": "很有帮助。太神奇了。"}, {"type": "subtitle", "time": 16170.55, "timestamp": "04:29:30", "text": "哦，我就是这样，我就是这样。"}, {"type": "subtitle", "time": 16172.55, "timestamp": "04:29:32", "text": "也在学习。此外，他们还会告诉你……"}, {"type": "subtitle", "time": 16173.75, "timestamp": "04:29:33", "text": "东西。我当时就想，“哦，对，那是……”"}, {"type": "subtitle", "time": 16176.269, "timestamp": "04:29:36", "text": "非常棒。”因为我"}, {"type": "subtitle", "time": 16179.389, "timestamp": "04:29:39", "text": "记得我的一些朋友跟我说过什么吗？"}, {"type": "subtitle", "time": 16182.95, "timestamp": "04:29:42", "text": "那是因为，呃，她以前就像那样"}, {"type": "subtitle", "time": 16185.349, "timestamp": "04:29:45", "text": "就像直播中的装备一样。对，这个"}, {"type": "subtitle", "time": 16187.349, "timestamp": "04:29:47", "text": "你知道吗，这很酷。并已使用"}, {"type": "subtitle", "time": 16191.03, "timestamp": "04:29:51", "text": "看看那个。我也观察她那一团"}, {"type": "subtitle", "time": 16193.03, "timestamp": "04:29:53", "text": "这次也只是为了学习"}, {"type": "subtitle", "time": 16196.149, "timestamp": "04:29:56", "text": "那些古老溪流中的一些东西"}, {"type": "subtitle", "time": 16199.67, "timestamp": "04:29:59", "text": "她跟我说，就像你一样，她只是在操纵。"}]
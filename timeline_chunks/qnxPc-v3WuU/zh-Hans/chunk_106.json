[{"type": "subtitle", "time": 6364.91, "timestamp": "01:46:04", "text": "让我问一下"}, {"type": "subtitle", "time": 6366.669, "timestamp": "01:46:06", "text": "他"}, {"type": "subtitle", "time": 6380.87, "timestamp": "01:46:20", "text": "来？等待。我认为林森会加入。"}, {"type": "subtitle", "time": 6391.43, "timestamp": "01:46:31", "text": "不过没关系。你不必"}, {"type": "subtitle", "time": 6393.95, "timestamp": "01:46:33", "text": "别担心。我们有人员需要运送"}, {"type": "subtitle", "time": 6414.229, "timestamp": "01:46:54", "text": "远方。风俗。好的。自定义死亡竞赛。"}, {"type": "subtitle", "time": 6417.109, "timestamp": "01:46:57", "text": "咱们打一场生死决斗，直到他出现为止。我"}]
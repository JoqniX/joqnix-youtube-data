[{"type": "subtitle", "time": 16923.75, "timestamp": "04:42:03", "text": "给我施加压力，感觉快要让我窒息了。"}, {"type": "subtitle", "time": 16926.19, "timestamp": "04:42:06", "text": "这里那里，但"}, {"type": "subtitle", "time": 16930.55, "timestamp": "04:42:10", "text": "是啊，我也不知道。"}, {"type": "subtitle", "time": 16933.91, "timestamp": "04:42:13", "text": "什么事让你心烦？呃，"}, {"type": "chat", "time": 16935.071, "timestamp": "04:42:15", "author": "@site36.official", "avatar": "https://yt4.ggpht.com/Oc0kgq4lSUaD-BoDbaDE3pXUquuz47c4Yh7kwPILHO2D70EQ5EnEgoGgTbb5gw993EEXRqCx_A=s64-c-k-c0x00ffffff-no-rj", "message": "I finally got that VST plugin to work and the audio rendering is taking time so I'mma stay on that track for its reveal."}, {"type": "subtitle", "time": 16935.67, "timestamp": "04:42:15", "text": "太多事情了。是的。我的意思是，你知道"}, {"type": "subtitle", "time": 16937.788, "timestamp": "04:42:17", "text": "已经了。我觉得我不应该这样做。"}, {"type": "subtitle", "time": 16941.19, "timestamp": "04:42:21", "text": "兄弟。我的错。我不该问这个问题。我"}, {"type": "subtitle", "time": 16943.27, "timestamp": "04:42:23", "text": "猜猜看，查德好像不知道。所以，我"}, {"type": "subtitle", "time": 16946.47, "timestamp": "04:42:26", "text": "我想补充一点，我对此毫不知情。"}, {"type": "subtitle", "time": 16950.39, "timestamp": "04:42:30", "text": "你知道。我知道。我他妈的知道。"}, {"type": "subtitle", "time": 16959.99, "timestamp": "04:42:39", "text": "是的。是的。"}, {"type": "subtitle", "time": 16962.51, "timestamp": "04:42:42", "text": "所以别介意。呃，但是"}, {"type": "subtitle", "time": 16965.07, "timestamp": "04:42:45", "text": "是的，很多"}, {"type": "subtitle", "time": 16969.11, "timestamp": "04:42:49", "text": "我最在意的事，是的，为了"}, {"type": "subtitle", "time": 16973.07, "timestamp": "04:42:53", "text": "大多数情况下，感觉更像是"}, {"type": "subtitle", "time": 16977.27, "timestamp": "04:42:57", "text": "嗯，容易上当受骗就是这个词。"}, {"type": "subtitle", "time": 16979.47, "timestamp": "04:42:59", "text": "加利伯圣经，或者我确信"}]
[{"type": "subtitle", "time": 15781.67, "timestamp": "04:23:01", "text": "你是做什么的？该死的。你是做什么的？"}, {"type": "chat", "time": 15784.308, "timestamp": "04:23:04", "author": "@site36.official", "avatar": "https://yt4.ggpht.com/Oc0kgq4lSUaD-BoDbaDE3pXUquuz47c4Yh7kwPILHO2D70EQ5EnEgoGgTbb5gw993EEXRqCx_A=s64-c-k-c0x00ffffff-no-rj", "message": "I finally did an EDM track for you 🙂 😀 "}, {"type": "subtitle", "time": 15785.51, "timestamp": "04:23:05", "text": "是的，因为我觉得是的。我"}, {"type": "subtitle", "time": 15787.51, "timestamp": "04:23:07", "text": "没有合适的受众或"}, {"type": "subtitle", "time": 15789.75, "timestamp": "04:23:09", "text": "因为我没有为一家公司工作，所以有些事情发生了。"}, {"type": "subtitle", "time": 15792.229, "timestamp": "04:23:12", "text": "观众反应恰当。我有点放弃了"}, {"type": "subtitle", "time": 15794.07, "timestamp": "04:23:14", "text": "因为我当时正专注于……"}, {"type": "subtitle", "time": 15796.79, "timestamp": "04:23:16", "text": "社区活动，可邀请的社区"}, {"type": "chat", "time": 15797.985, "timestamp": "04:23:17", "author": "@site36.official", "avatar": "https://yt4.ggpht.com/Oc0kgq4lSUaD-BoDbaDE3pXUquuz47c4Yh7kwPILHO2D70EQ5EnEgoGgTbb5gw993EEXRqCx_A=s64-c-k-c0x00ffffff-no-rj", "message": "Took me ages to figure out the beat patterns "}, {"type": "subtitle", "time": 15801.51, "timestamp": "04:23:21", "text": "一切都很好，这让我……"}, {"type": "subtitle", "time": 15804.469, "timestamp": "04:23:24", "text": "很遗憾，是的，通过贾达，我得以……"}, {"type": "subtitle", "time": 15807.189, "timestamp": "04:23:27", "text": "和每个人聊了好几个小时。"}, {"type": "subtitle", "time": 15810.389, "timestamp": "04:23:30", "text": "我很高兴。但也是因为我"}, {"type": "subtitle", "time": 15812.71, "timestamp": "04:23:32", "text": "优先考虑合作，而不是进行合作。"}, {"type": "subtitle", "time": 15815.55, "timestamp": "04:23:35", "text": "感觉像是合作"}, {"type": "subtitle", "time": 15818.95, "timestamp": "04:23:38", "text": "直播就像其他社区一样"}, {"type": "subtitle", "time": 15821.189, "timestamp": "04:23:41", "text": "其他人的社区成员过来，"}, {"type": "subtitle", "time": 15823.83, "timestamp": "04:23:43", "text": "他们盯着你，然后拦下一辆车，但我感觉"}, {"type": "subtitle", "time": 15826.55, "timestamp": "04:23:46", "text": "就像应该有一些时刻，我会这样做"}, {"type": "subtitle", "time": 15828.389, "timestamp": "04:23:48", "text": "一个人直播，结果有人来找我"}, {"type": "subtitle", "time": 15831.87, "timestamp": "04:23:51", "text": "就是那种东西，对吧？我觉得"}, {"type": "subtitle", "time": 15836.07, "timestamp": "04:23:56", "text": "这种情况并不多见，而且一切都……"}, {"type": "subtitle", "time": 15838.229, "timestamp": "04:23:58", "text": "所以"}]
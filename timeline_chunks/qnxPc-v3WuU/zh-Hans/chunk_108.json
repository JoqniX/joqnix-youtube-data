[{"type": "subtitle", "time": 6495.229, "timestamp": "01:48:15", "text": "仅有的。去这里"}, {"type": "subtitle", "time": 6513.03, "timestamp": "01:48:33", "text": "我正在弄一个标签。兄弟，甚至你的"}, {"type": "subtitle", "time": 6517.03, "timestamp": "01:48:37", "text": "贝洛萨有一头绿头发。不，不，不。她"}, {"type": "subtitle", "time": 6520.07, "timestamp": "01:48:40", "text": "像一只绿色的猫。它不会变绿"}, {"type": "subtitle", "time": 6522.83, "timestamp": "01:48:42", "text": "头发。不，不"}, {"type": "subtitle", "time": 6533.39, "timestamp": "01:48:53", "text": "哦，我的"}]
[{"type": "subtitle", "time": 15540.79, "timestamp": "04:19:00", "text": "我有很多东西。是的。我，我是"}, {"type": "subtitle", "time": 15543.349, "timestamp": "04:19:03", "text": "担心很多事情，例如"}, {"type": "subtitle", "time": 15547.63, "timestamp": "04:19:07", "text": "你知道我现在结交的这些朋友。"}, {"type": "subtitle", "time": 15552.229, "timestamp": "04:19:12", "text": "嗯，我目前结交的朋友们。"}, {"type": "subtitle", "time": 15555.51, "timestamp": "04:19:15", "text": "比如说，如果我爆炸了或者"}, {"type": "subtitle", "time": 15559.03, "timestamp": "04:19:19", "text": "总感觉哪里不对劲。如果我输了怎么办"}, {"type": "subtitle", "time": 15561.03, "timestamp": "04:19:21", "text": "因为这些数字之类的东西而对他们不利？"}, {"type": "subtitle", "time": 15563.67, "timestamp": "04:19:23", "text": "这竟然是我最担心的事。自从我"}, {"type": "subtitle", "time": 15566.71, "timestamp": "04:19:26", "text": "等我开通自己的频道再看看吧。"}, {"type": "subtitle", "time": 15569.67, "timestamp": "04:19:29", "text": "看看我名字里的1K，它让我"}, {"type": "subtitle", "time": 15572.95, "timestamp": "04:19:32", "text": "感觉怪怪的。"}, {"type": "subtitle", "time": 15577.67, "timestamp": "04:19:37", "text": "哦不，我居然成了焦点。不，不是这样的"}, {"type": "subtitle", "time": 15580.75, "timestamp": "04:19:40", "text": "相关的。这些数字让我有点……"}, {"type": "subtitle", "time": 15584.149, "timestamp": "04:19:44", "text": "感到害怕、紧张，或者我不知道"}, {"type": "subtitle", "time": 15586.63, "timestamp": "04:19:46", "text": "这个词是什么样的？我会是吗？"}, {"type": "subtitle", "time": 15589.03, "timestamp": "04:19:49", "text": "数字会改变你"}, {"type": "subtitle", "time": 15592.63, "timestamp": "04:19:52", "text": "也改变你这一点，而且我会失去一个"}, {"type": "subtitle", "time": 15595.67, "timestamp": "04:19:55", "text": "我的观众中只有一小部分人或"}, {"type": "subtitle", "time": 15598.71, "timestamp": "04:19:58", "text": "音乐会门票，因为我不会被视为一个"}]
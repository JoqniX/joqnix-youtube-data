[{"type": "subtitle", "time": 10633.51, "timestamp": "02:57:13", "text": "我刚才看到你几乎全都有了。"}, {"type": "subtitle", "time": 10636.87, "timestamp": "02:57:16", "text": "过河之前。是的。"}, {"type": "subtitle", "time": 10646.71, "timestamp": "02:57:26", "text": "设置警报。我走了。放置"}, {"type": "subtitle", "time": 10654.79, "timestamp": "02:57:34", "text": "小心点。"}, {"type": "subtitle", "time": 10657.269, "timestamp": "02:57:37", "text": "我的天哪，这经典之作真是太棒了！"}, {"type": "subtitle", "time": 10659.03, "timestamp": "02:57:39", "text": "不知道它去了哪里。我本应该"}, {"type": "subtitle", "time": 10663.19, "timestamp": "02:57:43", "text": "昨天买了这款皮肤。"}, {"type": "subtitle", "time": 10665.07, "timestamp": "02:57:45", "text": "我的天哪，这太……"}, {"type": "subtitle", "time": 10669.03, "timestamp": "02:57:49", "text": "好的。现在我想，啊，我为什么跳过这一步呢？"}, {"type": "subtitle", "time": 10671.75, "timestamp": "02:57:51", "text": "这？"}]
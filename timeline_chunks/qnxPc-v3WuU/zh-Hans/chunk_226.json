[{"type": "subtitle", "time": 13565.349, "timestamp": "03:46:05", "text": "知道？我们走吧。拿走他们的钱。是的，"}, {"type": "subtitle", "time": 13568.55, "timestamp": "03:46:08", "text": "这就是我们喜欢的。"}, {"type": "subtitle", "time": 13579.269, "timestamp": "03:46:19", "text": "嗯，是的。不，不，不。请走"}, {"type": "subtitle", "time": 13582.389, "timestamp": "03:46:22", "text": "前方。好的，请便。前进。是的。"}, {"type": "subtitle", "time": 13585.03, "timestamp": "03:46:25", "text": "你先来。你知道最搞笑的是什么吗？"}, {"type": "subtitle", "time": 13588.229, "timestamp": "03:46:28", "text": "今天发生了什么事？就像一个小时前一样，"}, {"type": "subtitle", "time": 13591.11, "timestamp": "03:46:31", "text": "我当时情绪激动。好的。我当时正在看"}, {"type": "subtitle", "time": 13593.189, "timestamp": "03:46:33", "text": "YouTube节目，我碰巧看到了。"}, {"type": "subtitle", "time": 13596.189, "timestamp": "03:46:36", "text": "呃，你知道，那个熊女孩，"}, {"type": "subtitle", "time": 13604.67, "timestamp": "03:46:44", "text": "你知道。我是"}, {"type": "subtitle", "time": 13608.189, "timestamp": "03:46:48", "text": "怎么做？它用哪个词来形容？我是一名"}, {"type": "subtitle", "time": 13617.91, "timestamp": "03:46:57", "text": "她拉小提琴，我看着她，我是她的粉丝"}, {"type": "subtitle", "time": 13619.83, "timestamp": "03:46:59", "text": "替她当替补，因为她会拉小提琴。"}]
[{"type": "subtitle", "time": 6137.35, "timestamp": "01:42:17", "text": "警长？我车里的哪一个？我需要一个"}, {"type": "subtitle", "time": 6139.64, "timestamp": "01:42:19", "text": "车。好的。你好。你好。你好。你好。你好。"}, {"type": "subtitle", "time": 6143.109, "timestamp": "01:42:23", "text": "[笑声]"}, {"type": "subtitle", "time": 6145.669, "timestamp": "01:42:25", "text": "让开。"}, {"type": "subtitle", "time": 6149.35, "timestamp": "01:42:29", "text": "我把它弄丢了。"}, {"type": "subtitle", "time": 6163.99, "timestamp": "01:42:43", "text": "开玩笑。"}, {"type": "subtitle", "time": 6177.13, "timestamp": "01:42:57", "text": "瞧瞧。"}, {"type": "subtitle", "time": 6178.27, "timestamp": "01:42:58", "text": "[音乐]"}]
[{"type": "subtitle", "time": 9660.429, "timestamp": "02:41:00", "text": "当气是"}, {"type": "subtitle", "time": 9664.27, "timestamp": "02:41:04", "text": "气。哦，是的。当你说"}, {"type": "subtitle", "time": 9667.59, "timestamp": "02:41:07", "text": "在印度，chi 就像是“哦，是的”。它是"}, {"type": "subtitle", "time": 9672.23, "timestamp": "02:41:12", "text": "就像坏坏的，就像人们说的气一样，就像在"}, {"type": "subtitle", "time": 9674.23, "timestamp": "02:41:14", "text": "用来表达某事有多糟糕"}, {"type": "subtitle", "time": 9681.75, "timestamp": "02:41:21", "text": "然后，事情就结束了。"}, {"type": "subtitle", "time": 9685.99, "timestamp": "02:41:25", "text": "真正的玩家不会感到疲倦。"}, {"type": "subtitle", "time": 9689.51, "timestamp": "02:41:29", "text": "是的。你……我……我……我在想"}, {"type": "subtitle", "time": 9692.71, "timestamp": "02:41:32", "text": "我很好奇。你有游戏玩家的标志性姿势吗？"}, {"type": "subtitle", "time": 9695.51, "timestamp": "02:41:35", "text": "游戏玩家姿势？什么是游戏玩家姿势？所以"}, {"type": "subtitle", "time": 9697.91, "timestamp": "02:41:37", "text": "游戏玩家的姿势有点像懒散的姿势。"}, {"type": "subtitle", "time": 9700.79, "timestamp": "02:41:40", "text": "你知道，你的头就像"}, {"type": "subtitle", "time": 9703.51, "timestamp": "02:41:43", "text": "向前，你的躯干就像"}, {"type": "subtitle", "time": 9707.349, "timestamp": "02:41:47", "text": "稍微往后退了一点。啊，就像你坐着那样"}, {"type": "subtitle", "time": 9709.51, "timestamp": "02:41:49", "text": "也直勾勾地盯着屏幕。"}, {"type": "subtitle", "time": 9711.11, "timestamp": "02:41:51", "text": "关闭？是的。是的。或者你坐着"}, {"type": "subtitle", "time": 9712.83, "timestamp": "02:41:52", "text": "直的？"}, {"type": "subtitle", "time": 9715.429, "timestamp": "02:41:55", "text": "呃，我有时会驼背，但也有"}, {"type": "subtitle", "time": 9718.15, "timestamp": "02:41:58", "text": "有时当我全神贯注时，我会向前倾身，"}]
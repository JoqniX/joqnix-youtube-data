[{"type": "subtitle", "time": 1201.669, "timestamp": "00:20:01", "text": "你知道，就像电影里那样。"}, {"type": "subtitle", "time": 1204.789, "timestamp": "00:20:04", "text": "东西，你妈妈在哪里，或者"}, {"type": "subtitle", "time": 1208.789, "timestamp": "00:20:08", "text": "就像莱米亚尔角色总是那样，呃"}, {"type": "subtitle", "time": 1212.31, "timestamp": "00:20:12", "text": "成为那个喜欢，你知道，织毛衣的人"}, {"type": "subtitle", "time": 1214.39, "timestamp": "00:20:14", "text": "穿着衣服坐在摇椅上摇晃"}, {"type": "subtitle", "time": 1216.51, "timestamp": "00:20:16", "text": "还有一些东西要回来"}, {"type": "subtitle", "time": 1220.47, "timestamp": "00:20:20", "text": "向前，然后慢慢地，慢慢地，逐渐加速，"}, {"type": "subtitle", "time": 1224.07, "timestamp": "00:20:24", "text": "你知道，就是那种随着节奏摆动双手的感觉。"}, {"type": "subtitle", "time": 1230.549, "timestamp": "00:20:30", "text": "是的，我看到过类似 Instagram Reels 之类的视频。"}, {"type": "subtitle", "time": 1232.789, "timestamp": "00:20:32", "text": "最近发生了一些他们有点……"}, {"type": "subtitle", "time": 1235.51, "timestamp": "00:20:35", "text": "像五条悟那样编织的，像毛绒玩具或"}, {"type": "subtitle", "time": 1237.909, "timestamp": "00:20:37", "text": "大概就是这样。就像"}, {"type": "subtitle", "time": 1240.39, "timestamp": "00:20:40", "text": "包括脚、头发等等所有的一切"}, {"type": "subtitle", "time": 1243.59, "timestamp": "00:20:43", "text": "配件，所有东西。他们把它织了出来。我"}, {"type": "subtitle", "time": 1245.07, "timestamp": "00:20:45", "text": "当时的感觉就像是，"}, {"type": "subtitle", "time": 1247.789, "timestamp": "00:20:47", "text": "哇，真是太……"}, {"type": "subtitle", "time": 1250.149, "timestamp": "00:20:50", "text": "酷。”它就像一个毛绒玩具或"}]
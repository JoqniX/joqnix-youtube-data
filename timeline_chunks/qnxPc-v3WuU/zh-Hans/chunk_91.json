[{"type": "subtitle", "time": 5473.99, "timestamp": "01:31:13", "text": "我刚刚意识到我其实身处一家风险投资公司。"}, {"type": "subtitle", "time": 5477.35, "timestamp": "01:31:17", "text": "上帝。好了，那是你的车。不用担心"}, {"type": "subtitle", "time": 5490.79, "timestamp": "01:31:30", "text": "对不起，我刚才尖叫了。这是一个"}, {"type": "subtitle", "time": 5491.95, "timestamp": "01:31:31", "text": "车。不"}, {"type": "subtitle", "time": 5494.31, "timestamp": "01:31:34", "text": "担心。我的意思是，我也在尖叫，所以"}, {"type": "subtitle", "time": 5514.79, "timestamp": "01:31:54", "text": "10次​​击杀？我的天啊。"}, {"type": "subtitle", "time": 5516.709, "timestamp": "01:31:56", "text": "为什么会这样？那是他的非活跃状态"}]
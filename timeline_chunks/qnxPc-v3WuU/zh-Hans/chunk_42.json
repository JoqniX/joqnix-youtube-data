[{"type": "subtitle", "time": 2520.79, "timestamp": "00:42:00", "text": "今天所有到场的人。患病的"}, {"type": "subtitle", "time": 2523.03, "timestamp": "00:42:03", "text": "开始包装。好的。"}, {"type": "subtitle", "time": 2526.069, "timestamp": "00:42:06", "text": "另外，关于Discord服务器，我们"}, {"type": "subtitle", "time": 2528.87, "timestamp": "00:42:08", "text": "终于有了验证系统。"}, {"type": "subtitle", "time": 2531.589, "timestamp": "00:42:11", "text": "好的，我还有。我仍然有一个"}, {"type": "subtitle", "time": 2534.87, "timestamp": "00:42:14", "text": "修复这个问题还需要一些工作，但我"}, {"type": "subtitle", "time": 2538.39, "timestamp": "00:42:18", "text": "想说的是，我们正式拥有一个"}, {"type": "subtitle", "time": 2543.99, "timestamp": "00:42:23", "text": "验证系统。是的。所以，从某种意义上说，"}, {"type": "subtitle", "time": 2546.63, "timestamp": "00:42:26", "text": "让我来演示一下。尚未确认"}, {"type": "subtitle", "time": 2548.63, "timestamp": "00:42:28", "text": "我暂时会用这个，但是……"}, {"type": "subtitle", "time": 2550.349, "timestamp": "00:42:30", "text": "现在，我将使用"}, {"type": "subtitle", "time": 2553.589, "timestamp": "00:42:33", "text": "这。从某种意义上说，将会发生的事是……"}, {"type": "subtitle", "time": 2555.67, "timestamp": "00:42:35", "text": "加入服务器后，你会看到……"}, {"type": "subtitle", "time": 2557.589, "timestamp": "00:42:37", "text": "入职流程。你确实想"}, {"type": "subtitle", "time": 2560.63, "timestamp": "00:42:40", "text": "执行该流程。然后为了交谈"}, {"type": "subtitle", "time": 2563.47, "timestamp": "00:42:43", "text": "服务器，你得等你的"}, {"type": "subtitle", "time": 2567.03, "timestamp": "00:42:47", "text": "车。但最终你不再需要 if 语句了。"}, {"type": "subtitle", "time": 2569.829, "timestamp": "00:42:49", "text": "如果你不想去，完全没问题。"}, {"type": "subtitle", "time": 2572.95, "timestamp": "00:42:52", "text": "你会感觉自己像在一个地方州一样。你"}, {"type": "subtitle", "time": 2576.309, "timestamp": "00:42:56", "text": "可以看到其他频道，但不会是"}, {"type": "subtitle", "time": 2579.27, "timestamp": "00:42:59", "text": "民众。不会像"}]
[{"type": "subtitle", "time": 13683.71, "timestamp": "03:48:03", "text": "东西，然后我就想，我过得很愉快。"}, {"type": "subtitle", "time": 13686.95, "timestamp": "03:48:06", "text": "当时我好像在感谢她。"}, {"type": "subtitle", "time": 13690.79, "timestamp": "03:48:10", "text": "然后我就离开了，去做我自己的事。"}, {"type": "subtitle", "time": 13693.309, "timestamp": "03:48:13", "text": "溪流。我当时正在直播这个"}, {"type": "subtitle", "time": 13697.429, "timestamp": "03:48:17", "text": "也是在这一切发生的过程中，毫无征兆地发生了。我"}, {"type": "subtitle", "time": 13699.59, "timestamp": "03:48:19", "text": "我当时想，“我的天哪，我为什么会这样？”"}, {"type": "subtitle", "time": 13702.389, "timestamp": "03:48:22", "text": "那个梦？"}, {"type": "subtitle", "time": 13704.95, "timestamp": "03:48:24", "text": "哦，有些人说，你知道，好像不多吧，"}, {"type": "subtitle", "time": 13707.11, "timestamp": "03:48:27", "text": "但有人说，你的梦境也是……的一部分"}, {"type": "subtitle", "time": 13710.269, "timestamp": "03:48:30", "text": "你的未来，或者说，是来自另一个世界的你"}, {"type": "subtitle", "time": 13713.75, "timestamp": "03:48:33", "text": "宇宙。有些人这么说。所以，"}, {"type": "subtitle", "time": 13717.269, "timestamp": "03:48:37", "text": "是的。是的。所以，你或许会在"}, {"type": "subtitle", "time": 13719.83, "timestamp": "03:48:39", "text": "你和阿拉卡桑来自不同的宇宙"}, {"type": "subtitle", "time": 13722.389, "timestamp": "03:48:42", "text": "一起直播，或者也许是……"}, {"type": "subtitle", "time": 13725.91, "timestamp": "03:48:45", "text": "你知道，是遥远的未来。谁知道呢？"}, {"type": "subtitle", "time": 13726.59, "timestamp": "03:48:46", "text": "好的。"}, {"type": "subtitle", "time": 13733.269, "timestamp": "03:48:53", "text": "还是这个？礼物？哦，它"}, {"type": "subtitle", "time": 13737.189, "timestamp": "03:48:57", "text": "现在就等着吧，既然你"}, {"type": "subtitle", "time": 13739.51, "timestamp": "03:48:59", "text": "告诉我这件事。哦，我不知道。我"}]
[{"type": "subtitle", "time": 7099.51, "timestamp": "01:58:19", "text": "更多的是枪声。谁来过这里？"}, {"type": "subtitle", "time": 7101.83, "timestamp": "01:58:21", "text": "是的，我需要……我需要谈谈。呃，它"}, {"type": "subtitle", "time": 7104.39, "timestamp": "01:58:24", "text": "如果我不参与，那就不能算是合作了。"}, {"type": "subtitle", "time": 7108.75, "timestamp": "01:58:28", "text": "聊聊吧？我一句话也不说。啊，"}, {"type": "subtitle", "time": 7112.149, "timestamp": "01:58:32", "text": "笨蛋。我忘了。我的错。我的错。所以，我会"}, {"type": "subtitle", "time": 7115.35, "timestamp": "01:58:35", "text": "按下按钮说话。斗争。"}]
[{"type": "subtitle", "time": 12361.349, "timestamp": "03:26:01", "text": "我想来是因为我一直藏着一个秘密"}, {"type": "subtitle", "time": 12363.11, "timestamp": "03:26:03", "text": "秘密。"}, {"type": "subtitle", "time": 12374.95, "timestamp": "03:26:14", "text": "哦，什么？我当时正在看聊天记录。哦，我的"}, {"type": "subtitle", "time": 12376.87, "timestamp": "03:26:16", "text": "上帝。"}, {"type": "subtitle", "time": 12400.15, "timestamp": "03:26:40", "text": "我的天哪，我的腿。我回来了。我们如何"}, {"type": "subtitle", "time": 12408.469, "timestamp": "03:26:48", "text": "另一个喜欢扮演我的人。"}, {"type": "subtitle", "time": 12411.99, "timestamp": "03:26:51", "text": "哦，等等。你也不喜欢我吗？"}, {"type": "subtitle", "time": 12419.269, "timestamp": "03:26:59", "text": "我可以要一滴吗？"}]
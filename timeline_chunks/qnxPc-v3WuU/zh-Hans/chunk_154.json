[{"type": "subtitle", "time": 9249.95, "timestamp": "02:34:09", "text": "哦，对了，我是菲尼克斯。我不需要尝试"}, {"type": "subtitle", "time": 9252.87, "timestamp": "02:34:12", "text": "难的。相信我，我是霓虹灯。哦，是的。哦，"}, {"type": "subtitle", "time": 9254.11, "timestamp": "02:34:14", "text": "你是"}, {"type": "subtitle", "time": 9268.55, "timestamp": "02:34:28", "text": "主。人们就像这样对我开枪。"}, {"type": "subtitle", "time": 9270.95, "timestamp": "02:34:30", "text": "没什么。"}, {"type": "subtitle", "time": 9274.389, "timestamp": "02:34:34", "text": "我表现得好像什么事都没发生一样糟糕。某人"}, {"type": "subtitle", "time": 9281.75, "timestamp": "02:34:41", "text": "是的。"}, {"type": "subtitle", "time": 9284.11, "timestamp": "02:34:44", "text": "我的天啊。我正在明白 我正在明白"}, {"type": "subtitle", "time": 9286.11, "timestamp": "02:34:46", "text": "被烧毁。"}, {"type": "subtitle", "time": 9289.91, "timestamp": "02:34:49", "text": "哇。别那样烤我。我的天啊。"}]
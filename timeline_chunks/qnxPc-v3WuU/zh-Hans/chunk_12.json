[{"type": "subtitle", "time": 722.069, "timestamp": "00:12:02", "text": "正确的？我刚才说的就是今天的事。我的爸爸"}, {"type": "subtitle", "time": 724.55, "timestamp": "00:12:04", "text": "我还以为他会过来呢。"}, {"type": "subtitle", "time": 726.87, "timestamp": "00:12:06", "text": "还有一些其他的东西。我其实告诉他要带过来。"}, {"type": "subtitle", "time": 728.389, "timestamp": "00:12:08", "text": "喜欢"}, {"type": "subtitle", "time": 731.67, "timestamp": "00:12:11", "text": "呃，零食之类的。当然，我可以"}, {"type": "subtitle", "time": 733.75, "timestamp": "00:12:13", "text": "我亲自去过面包店买过东西。"}, {"type": "subtitle", "time": 735.19, "timestamp": "00:12:15", "text": "诸如此类的事情，但他却说：“是啊，你知道的。”"}, {"type": "subtitle", "time": 738.03, "timestamp": "00:12:18", "text": "什么？我会带来"}, {"type": "subtitle", "time": 740.99, "timestamp": "00:12:20", "text": "因为你知道，这就像……"}, {"type": "subtitle", "time": 745.19, "timestamp": "00:12:25", "text": "呃，我爸爸，他知道一些事情，比如……"}, {"type": "subtitle", "time": 749.43, "timestamp": "00:12:29", "text": "是的。我会买多少东西？"}, {"type": "subtitle", "time": 752.629, "timestamp": "00:12:32", "text": "要对我好，对一切都好。是他吗？"}, {"type": "subtitle", "time": 754.389, "timestamp": "00:12:34", "text": "获得奖学金吗？不，不，不，不，不，不。"}, {"type": "subtitle", "time": 757.829, "timestamp": "00:12:37", "text": "阿姨这周好像很忙。"}, {"type": "subtitle", "time": 761.19, "timestamp": "00:12:41", "text": "这个月婚礼比较多，感觉挺多的。"}, {"type": "subtitle", "time": 763.509, "timestamp": "00:12:43", "text": "还有一些其他的东西，比如……一些"}, {"type": "subtitle", "time": 766.55, "timestamp": "00:12:46", "text": "节日气氛就像嗯，节日正在进行中"}, {"type": "subtitle", "time": 769.99, "timestamp": "00:12:49", "text": "这是和当地教会有关的事情。"}, {"type": "subtitle", "time": 771.75, "timestamp": "00:12:51", "text": "所以昨天才会发生那些事。"}, {"type": "subtitle", "time": 773.949, "timestamp": "00:12:53", "text": "就像充满了呃"}, {"type": "subtitle", "time": 777.03, "timestamp": "00:12:57", "text": "这边好像人很多。"}]
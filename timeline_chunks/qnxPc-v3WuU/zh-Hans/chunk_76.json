[{"type": "subtitle", "time": 4560.03, "timestamp": "01:16:00", "text": "我今天过得很顺利。我当时有点……"}, {"type": "subtitle", "time": 4563.43, "timestamp": "01:16:03", "text": "呃，担心我迟到了，因为我确实迟到了。"}, {"type": "subtitle", "time": 4572.79, "timestamp": "01:16:12", "text": "是的。是时候开枪了"}, {"type": "subtitle", "time": 4575.51, "timestamp": "01:16:15", "text": "什么？"}, {"type": "subtitle", "time": 4577.669, "timestamp": "01:16:17", "text": "你说什么？"}, {"type": "subtitle", "time": 4585.83, "timestamp": "01:16:25", "text": "我看到一个鬼鬼祟祟的人。"}, {"type": "subtitle", "time": 4590.63, "timestamp": "01:16:30", "text": "不，等等。我在哪里？杀了我。我"}, {"type": "subtitle", "time": 4591.47, "timestamp": "01:16:31", "text": "听到"}, {"type": "subtitle", "time": 4594.95, "timestamp": "01:16:34", "text": "你。我听到有人出现的声音。"}, {"type": "subtitle", "time": 4597.189, "timestamp": "01:16:37", "text": "嗯，我参加。是的，你可以加入。你"}, {"type": "subtitle", "time": 4600.229, "timestamp": "01:16:40", "text": "可以加入。我需要一个，所以我需要一个。"}, {"type": "subtitle", "time": 4602.55, "timestamp": "01:16:42", "text": "还剩两个名额。所以，没错。"}, {"type": "subtitle", "time": 4606.229, "timestamp": "01:16:46", "text": "那些站在我这边的人，我们得等等"}, {"type": "subtitle", "time": 4610.47, "timestamp": "01:16:50", "text": "我觉得我们得向上骑行。"}, {"type": "subtitle", "time": 4613.51, "timestamp": "01:16:53", "text": "就像这样，我大概会渲染"}, {"type": "subtitle", "time": 4615.95, "timestamp": "01:16:55", "text": "暖和一下，好跟上那些"}, {"type": "subtitle", "time": 4618.31, "timestamp": "01:16:58", "text": "混蛋。你是说笑话是"}]
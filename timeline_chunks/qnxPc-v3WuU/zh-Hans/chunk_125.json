[{"type": "subtitle", "time": 7503.03, "timestamp": "02:05:03", "text": "好了。 Blink 是一款廉价的 Blink。"}, {"type": "subtitle", "time": 7506.03, "timestamp": "02:05:06", "text": "哦，是的。我不会忘记眨眼。"}, {"type": "subtitle", "time": 7509.35, "timestamp": "02:05:09", "text": "GG的。 GG的。但你连眼睛都没眨一下。你"}, {"type": "subtitle", "time": 7511.35, "timestamp": "02:05:11", "text": "集中注意力。"}, {"type": "subtitle", "time": 7513.99, "timestamp": "02:05:13", "text": "是啊，我只是忘了眨眼。看看"}, {"type": "subtitle", "time": 7520.149, "timestamp": "02:05:20", "text": "阿尼昆。我的天啊。凯莉。我的天啊。"}, {"type": "subtitle", "time": 7523.43, "timestamp": "02:05:23", "text": "我先观察一下。好的。好的。"}, {"type": "subtitle", "time": 7526.95, "timestamp": "02:05:26", "text": "她没有。有人想加入吗？我"}, {"type": "subtitle", "time": 7528.79, "timestamp": "02:05:28", "text": "没有灵魂。灵魂需要加入。我"}, {"type": "subtitle", "time": 7529.87, "timestamp": "02:05:29", "text": "没有"}, {"type": "subtitle", "time": 7535.669, "timestamp": "02:05:35", "text": "我内心深处感到我必须离开。好的。"}, {"type": "subtitle", "time": 7536.669, "timestamp": "02:05:36", "text": "哦，是的。"}, {"type": "subtitle", "time": 7541.43, "timestamp": "02:05:41", "text": "呃在这里。还有谁想加入？"}, {"type": "subtitle", "time": 7543.109, "timestamp": "02:05:43", "text": "室友们好。你好。你好吗？希望"}, {"type": "subtitle", "time": 7544.31, "timestamp": "02:05:44", "text": "你今天表现很棒。从未见过你"}, {"type": "subtitle", "time": 7546.31, "timestamp": "02:05:46", "text": "在聊天中。希望你一切都好。"}, {"type": "subtitle", "time": 7547.91, "timestamp": "02:05:47", "text": "今天。"}, {"type": "subtitle", "time": 7550.87, "timestamp": "02:05:50", "text": "我加入。好的。加入某人"}, {"type": "subtitle", "time": 7554.95, "timestamp": "02:05:54", "text": "已加入。这里也有民间传说。 WHO？谁的"}]
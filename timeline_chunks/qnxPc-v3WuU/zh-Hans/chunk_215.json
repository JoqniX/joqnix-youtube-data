[{"type": "subtitle", "time": 12910.95, "timestamp": "03:35:10", "text": "你好。你好，布拉德。你能够通过……"}, {"type": "subtitle", "time": 12914.63, "timestamp": "03:35:14", "text": "方式。我们正在直播吗？人们能听到我说话吗？"}, {"type": "subtitle", "time": 12916.63, "timestamp": "03:35:16", "text": "是的。"}, {"type": "subtitle", "time": 12918.87, "timestamp": "03:35:18", "text": "我的天哪。稍等片刻。然后我"}, {"type": "subtitle", "time": 12923.269, "timestamp": "03:35:23", "text": "吃。我那肥屁股正在吃东西。"}, {"type": "subtitle", "time": 12924.71, "timestamp": "03:35:24", "text": "不用担心。不用担心。慢慢来。"}, {"type": "subtitle", "time": 12934.67, "timestamp": "03:35:34", "text": "各位，今天的嘉宾是……"}, {"type": "subtitle", "time": 12938.469, "timestamp": "03:35:38", "text": "布拉德。今天的嘉宾是布拉德。你可能"}, {"type": "subtitle", "time": 12942.79, "timestamp": "03:35:42", "text": "我通过我的直播认识了他，因为他……"}, {"type": "subtitle", "time": 12945.11, "timestamp": "03:35:45", "text": "在 Jockathon 期间。他一直是"}, {"type": "subtitle", "time": 12949.429, "timestamp": "03:35:49", "text": "帮助我，就像每当我……"}, {"type": "subtitle", "time": 12951.91, "timestamp": "03:35:51", "text": "离开溪流或休息一下，"}, {"type": "subtitle", "time": 12954.429, "timestamp": "03:35:54", "text": "他过去常常在溪边工作"}, {"type": "subtitle", "time": 12957.83, "timestamp": "03:35:57", "text": "客人和我认为此时此刻的人们"}]
[{"type": "subtitle", "time": 14222.79, "timestamp": "03:57:02", "text": "47 47 48 49 甚至像 Astra 一样计数"}, {"type": "subtitle", "time": 14226.309, "timestamp": "03:57:06", "text": "就像 Shisan 和其他那些人一样"}, {"type": "subtitle", "time": 14229.03, "timestamp": "03:57:09", "text": "就像在 Minecraft 的合作中一样"}, {"type": "subtitle", "time": 14231.429, "timestamp": "03:57:11", "text": "一。不，我不需要把那个算进去。我们"}, {"type": "subtitle", "time": 14233.03, "timestamp": "03:57:13", "text": "会把这一个单独计算在内。不"}, {"type": "subtitle", "time": 14234.55, "timestamp": "03:57:14", "text": "担忧。"}, {"type": "subtitle", "time": 14237.349, "timestamp": "03:57:17", "text": "48岁快到50岁了。呃……"}, {"type": "subtitle", "time": 14240.07, "timestamp": "03:57:20", "text": "我们会出发的。我要去"}, {"type": "subtitle", "time": 14244.229, "timestamp": "03:57:24", "text": "放五个人，呃，不，三个人三个"}, {"type": "subtitle", "time": 14246.95, "timestamp": "03:57:26", "text": "曾经的合作者们"}, {"type": "subtitle", "time": 14249.429, "timestamp": "03:57:29", "text": "晚上就像晚上的老虎机。所以1小时1"}, {"type": "subtitle", "time": 14252.55, "timestamp": "03:57:32", "text": "每小时每种东西1小时。"}, {"type": "subtitle", "time": 14256.229, "timestamp": "03:57:36", "text": "所以，33人喜欢那个预约。"}, {"type": "subtitle", "time": 14258.469, "timestamp": "03:57:38", "text": "是的，如果可以的话，我会尽力做到。"}, {"type": "subtitle", "time": 14260.79, "timestamp": "03:57:40", "text": "前提是他们有自由。嗯，那是"}, {"type": "subtitle", "time": 14263.91, "timestamp": "03:57:43", "text": "我正在尝试做这件事，因为，呃，"}, {"type": "subtitle", "time": 14267.189, "timestamp": "03:57:47", "text": "我能够做到就像它从"}, {"type": "subtitle", "time": 14271.11, "timestamp": "03:57:51", "text": "单次合作，比如一天一次的合作"}, {"type": "subtitle", "time": 14274.15, "timestamp": "03:57:54", "text": "就像一天之内合作两次一样，真让人兴奋。"}, {"type": "subtitle", "time": 14276.71, "timestamp": "03:57:56", "text": "三次合作，四次合作，还有五次合作。"}, {"type": "subtitle", "time": 14279.75, "timestamp": "03:57:59", "text": "比如明天的那个实际上是5。"}]
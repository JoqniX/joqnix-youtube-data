[{"type": "subtitle", "time": 9916.71, "timestamp": "02:45:16", "text": "州斗牛犬。我还没玩过"}, {"type": "subtitle", "time": 9919.75, "timestamp": "02:45:19", "text": "那只斗牛犬就是这样。我需要得到"}, {"type": "subtitle", "time": 9922.309, "timestamp": "02:45:22", "text": "习惯了。比如，另一个是什么？"}, {"type": "subtitle", "time": 9923.07, "timestamp": "02:45:23", "text": "枪"}, {"type": "subtitle", "time": 9925.309, "timestamp": "02:45:25", "text": "姓名？不是"}, {"type": "subtitle", "time": 9928.95, "timestamp": "02:45:28", "text": "奇观。忘了名字了。哦，天哪，我"}, {"type": "subtitle", "time": 9940.63, "timestamp": "02:45:40", "text": "大家都躲到哪儿去了？"}, {"type": "subtitle", "time": 9945.59, "timestamp": "02:45:45", "text": "还剩一个敌人。看看他。"}, {"type": "subtitle", "time": 9954.429, "timestamp": "02:45:54", "text": "好的。我的"}, {"type": "subtitle", "time": 9957.83, "timestamp": "02:45:57", "text": "上帝。另外，关于游戏玩家帖子这个话题，"}]
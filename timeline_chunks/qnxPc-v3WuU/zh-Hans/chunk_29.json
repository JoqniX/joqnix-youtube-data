[{"type": "subtitle", "time": 1741.83, "timestamp": "00:29:01", "text": "就像你知道的那样，每个人都可以使用。"}, {"type": "subtitle", "time": 1743.909, "timestamp": "00:29:03", "text": "不需要订阅，你只要打个招呼就行了。"}, {"type": "subtitle", "time": 1746.63, "timestamp": "00:29:06", "text": "如果你感兴趣，如果你喜欢什么"}, {"type": "subtitle", "time": 1748.71, "timestamp": "00:29:08", "text": "你可以看到，之后你可以订阅或"}, {"type": "subtitle", "time": 1750.63, "timestamp": "00:29:10", "text": "大概就是这样。是的。所以，我"}, {"type": "subtitle", "time": 1753.549, "timestamp": "00:29:13", "text": "完全忘了这件事发生在任何人身上"}, {"type": "subtitle", "time": 1756.31, "timestamp": "00:29:16", "text": "一直以来，我对这件事的感觉就像"}, {"type": "subtitle", "time": 1757.31, "timestamp": "00:29:17", "text": "好奇"}, {"type": "subtitle", "time": 1760.389, "timestamp": "00:29:20", "text": "等等，这些新来的人都来了"}, {"type": "subtitle", "time": 1762.95, "timestamp": "00:29:22", "text": "他们就像"}, {"type": "subtitle", "time": 1766.029, "timestamp": "00:29:26", "text": "呃，就像是在字幕模式下一样。"}, {"type": "subtitle", "time": 1768.47, "timestamp": "00:29:28", "text": "他们订阅了一些东西"}, {"type": "subtitle", "time": 1770.19, "timestamp": "00:29:30", "text": "评论"}, {"type": "subtitle", "time": 1774.59, "timestamp": "00:29:34", "text": "某物。等等，我没意识到"}, {"type": "subtitle", "time": 1777.59, "timestamp": "00:29:37", "text": "不过，你觉得这样好吗？"}, {"type": "subtitle", "time": 1780.63, "timestamp": "00:29:40", "text": "尽管？你觉得保留它怎么样？"}, {"type": "subtitle", "time": 1783.75, "timestamp": "00:29:43", "text": "对于任何人来说，哪个更好，或者只是代班"}, {"type": "subtitle", "time": 1787.47, "timestamp": "00:29:47", "text": "订阅者专属福利就像这样"}, {"type": "subtitle", "time": 1791.75, "timestamp": "00:29:51", "text": "移除你认识的机器人，比如“喜欢”。"}, {"type": "subtitle", "time": 1793.99, "timestamp": "00:29:53", "text": "查看评论，而不是像垃圾邮件一样的评论"}, {"type": "subtitle", "time": 1796.389, "timestamp": "00:29:56", "text": "现在机器人之类的东西会入侵你的直播间。"}]
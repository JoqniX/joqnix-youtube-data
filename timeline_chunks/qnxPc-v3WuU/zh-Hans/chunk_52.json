[{"type": "subtitle", "time": 3122.349, "timestamp": "00:52:02", "text": "[音乐]"}, {"type": "subtitle", "time": 3126.39, "timestamp": "00:52:06", "text": "向上。非常感谢每一位"}, {"type": "subtitle", "time": 3130.549, "timestamp": "00:52:10", "text": "今天过来了。所有新的康纳勒斯，"}, {"type": "subtitle", "time": 3132.549, "timestamp": "00:52:12", "text": "又名音乐会餐盘，感谢各位光临"}, {"type": "subtitle", "time": 3135.43, "timestamp": "00:52:15", "text": "经过。如果你喜欢，如果你喜欢什么"}, {"type": "subtitle", "time": 3138.47, "timestamp": "00:52:18", "text": "如你所见，如果你愿意，请订阅。"}, {"type": "subtitle", "time": 3141.23, "timestamp": "00:52:21", "text": "就是这样。不要强迫。但"}, {"type": "subtitle", "time": 3144.549, "timestamp": "00:52:24", "text": "是的，但我可能会改变我的聊天方式。"}, {"type": "subtitle", "time": 3147.15, "timestamp": "00:52:27", "text": "参与模式"}, {"type": "subtitle", "time": 3151.349, "timestamp": "00:52:31", "text": "仅限订阅用户。"}, {"type": "subtitle", "time": 3153.75, "timestamp": "00:52:33", "text": "未来之所以如此，是因为我觉得"}, {"type": "subtitle", "time": 3158.309, "timestamp": "00:52:38", "text": "你知道，如果这是我想要的方式的话"}, {"type": "subtitle", "time": 3161.589, "timestamp": "00:52:41", "text": "为了让大家都能拥有它，但我也是"}, {"type": "subtitle", "time": 3165.19, "timestamp": "00:52:45", "text": "看着人们，我希望人们能接受"}, {"type": "subtitle", "time": 3166.75, "timestamp": "00:52:46", "text": "他们的"}, {"type": "subtitle", "time": 3169.91, "timestamp": "00:52:49", "text": "如果你是的话，可以稍微留意一下时间。"}, {"type": "subtitle", "time": 3172.87, "timestamp": "00:52:52", "text": "感兴趣 感兴趣 感兴趣 然后"}, {"type": "subtitle", "time": 3175.349, "timestamp": "00:52:55", "text": "只是订阅之类的，嗯，我"}, {"type": "subtitle", "time": 3177.309, "timestamp": "00:52:57", "text": "有点想效仿那种方式"}]
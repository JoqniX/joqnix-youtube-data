[{"type": "subtitle", "time": 14400.15, "timestamp": "04:00:00", "text": "因为我是专业人士，所以我对此并不在意。我会"}, {"type": "subtitle", "time": 14402.79, "timestamp": "04:00:02", "text": "如果不是像洪水一样的话，我会很喜欢的。"}, {"type": "subtitle", "time": 14405.269, "timestamp": "04:00:05", "text": "你知道，铺天盖地的运动员照片……"}, {"type": "subtitle", "time": 14407.91, "timestamp": "04:00:07", "text": "来到我的“为你推荐”页面。就像"}, {"type": "subtitle", "time": 14410.229, "timestamp": "04:00:10", "text": "我滚动浏览的每两卷胶卷都是"}, {"type": "subtitle", "time": 14412.389, "timestamp": "04:00:12", "text": "只是一段运动员的表演视频。我当时就想，“哦，天哪，"}, {"type": "subtitle", "time": 14419.429, "timestamp": "04:00:19", "text": "太多了。我当时就想，“哇，这家伙……”"}, {"type": "subtitle", "time": 14421.79, "timestamp": "04:00:21", "text": "发帖"}, {"type": "subtitle", "time": 14424.15, "timestamp": "04:00:24", "text": "发布。”所以，呃，你数过有多少个吗？"}, {"type": "subtitle", "time": 14426.87, "timestamp": "04:00:26", "text": "你之前发的照片好像就是那几周发的。"}, {"type": "subtitle", "time": 14430.07, "timestamp": "04:00:30", "text": "你当时是不是在做东西？"}, {"type": "subtitle", "time": 14433.349, "timestamp": "04:00:33", "text": "那里每天是10美元。"}, {"type": "subtitle", "time": 14435.59, "timestamp": "04:00:35", "text": "耶稣基督。"}, {"type": "subtitle", "time": 14438.469, "timestamp": "04:00:38", "text": "我还没看完 YouTube 呢。"}, {"type": "subtitle", "time": 14441.269, "timestamp": "04:00:41", "text": "部分，YouTube 上的节目片段"}, {"type": "subtitle", "time": 14442.87, "timestamp": "04:00:42", "text": "这些都是由社区制作的"}, {"type": "subtitle", "time": 14446.229, "timestamp": "04:00:46", "text": "成员。呃，我还有事要做。"}, {"type": "subtitle", "time": 14448.71, "timestamp": "04:00:48", "text": "赶上那个进度。我必须这么做。"}, {"type": "subtitle", "time": 14451.91, "timestamp": "04:00:51", "text": "这些日子。哦，是的。我忘了你是谁"}, {"type": "subtitle", "time": 14454.229, "timestamp": "04:00:54", "text": "就像追赶你的直播进度一样"}, {"type": "subtitle", "time": 14457.11, "timestamp": "04:00:57", "text": "就像从旧事物到旧事物"}, {"type": "subtitle", "time": 14459.03, "timestamp": "04:00:59", "text": "新的。是的。非常非常开始"}]
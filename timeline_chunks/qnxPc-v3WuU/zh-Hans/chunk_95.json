[{"type": "subtitle", "time": 5708.79, "timestamp": "01:35:08", "text": "你真的在等我说“不，我”。"}, {"type": "subtitle", "time": 5712.07, "timestamp": "01:35:12", "text": "我先看到的。我刚才看到你了"}, {"type": "subtitle", "time": 5714.87, "timestamp": "01:35:14", "text": "第一的。我当时就想，我的天哪。我进去了吗？"}, {"type": "subtitle", "time": 5717.51, "timestamp": "01:35:17", "text": "现在？"}, {"type": "subtitle", "time": 5732.47, "timestamp": "01:35:32", "text": "好的。 Kin，我们应该在新加坡玩吗？"}, {"type": "subtitle", "time": 5734.79, "timestamp": "01:35:34", "text": "我们可以在新加坡玩吗？会是吗？"}, {"type": "subtitle", "time": 5738.229, "timestamp": "01:35:38", "text": "好的？所以，是101。"}, {"type": "subtitle", "time": 5741.91, "timestamp": "01:35:41", "text": "我认为他可以代表新加坡队出战。是的。呃，"}, {"type": "subtitle", "time": 5743.83, "timestamp": "01:35:43", "text": "我想要颜色非常鲜艳的粉色。所以，"}, {"type": "subtitle", "time": 5746.87, "timestamp": "01:35:46", "text": "我对自己没抱太大期望。我们该怎么办？"}, {"type": "subtitle", "time": 5750.51, "timestamp": "01:35:50", "text": "做？我们还要再看一场吗？"}, {"type": "subtitle", "time": 5755.59, "timestamp": "01:35:55", "text": "没有匹配项。当然可以。好了，我们走吧。"}, {"type": "subtitle", "time": 5757.27, "timestamp": "01:35:57", "text": "好的。"}, {"type": "subtitle", "time": 5759.669, "timestamp": "01:35:59", "text": "哦，不。靠左走。等等，为什么？"}]
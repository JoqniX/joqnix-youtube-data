[{"type": "subtitle", "time": 7023.51, "timestamp": "01:57:03", "text": "像剧本一样演戏，对吧？是的。"}, {"type": "subtitle", "time": 7025.589, "timestamp": "01:57:05", "text": "好的。我们走吧。等等，你知道吗？"}, {"type": "subtitle", "time": 7028.149, "timestamp": "01:57:08", "text": "我们先玩升级游戏，然后再玩"}, {"type": "subtitle", "time": 7030.07, "timestamp": "01:57:10", "text": "复制，然后我们玩 Spike 和"}, {"type": "subtitle", "time": 7037.31, "timestamp": "01:57:17", "text": "哦，这是"}, {"type": "subtitle", "time": 7041.03, "timestamp": "01:57:21", "text": "真是愚蠢。"}, {"type": "subtitle", "time": 7043.83, "timestamp": "01:57:23", "text": "等等，是不是只有我一个人没听清你说话？"}, {"type": "subtitle", "time": 7046.31, "timestamp": "01:57:26", "text": "说"}, {"type": "subtitle", "time": 7050.07, "timestamp": "01:57:30", "text": "完全没有吗？你一句话都没说。是的。"}, {"type": "subtitle", "time": 7052.31, "timestamp": "01:57:32", "text": "是的。是的。是的。因为我总是忘记。"}, {"type": "subtitle", "time": 7054.55, "timestamp": "01:57:34", "text": "我的天啊。你忘了。你继续"}, {"type": "subtitle", "time": 7056.79, "timestamp": "01:57:36", "text": "忘记说话了。不，不，我是"}, {"type": "subtitle", "time": 7059.709, "timestamp": "01:57:39", "text": "说。我忘记按下……"}]
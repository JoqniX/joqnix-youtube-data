[{"type": "subtitle", "time": 5944.629, "timestamp": "01:39:04", "text": "什么？轻轻一点，就像……"}, {"type": "subtitle", "time": 5977.91, "timestamp": "01:39:37", "text": "好的。我觉得只是网络延迟。你"}, {"type": "subtitle", "time": 5980.55, "timestamp": "01:39:40", "text": "知道什么？你为什么喜欢露营？"}, {"type": "subtitle", "time": 5983.35, "timestamp": "01:39:43", "text": "那？这是生死搏斗。好吧，我不能"}, {"type": "subtitle", "time": 5985.229, "timestamp": "01:39:45", "text": "都怪他们。我猜是他们的"}, {"type": "subtitle", "time": 5989.189, "timestamp": "01:39:49", "text": "风格。他们喜欢那样做，所以"}]
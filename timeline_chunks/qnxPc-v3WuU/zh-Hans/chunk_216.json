[{"type": "subtitle", "time": 12961.95, "timestamp": "03:36:01", "text": "人们称他为BRB。"}, {"type": "subtitle", "time": 12965.83, "timestamp": "03:36:05", "text": "主播。是的，今天我们要去"}, {"type": "subtitle", "time": 12968.71, "timestamp": "03:36:08", "text": "今天被当作一位合格的客人来招待。并非作为"}, {"type": "subtitle", "time": 12971.19, "timestamp": "03:36:11", "text": "BRB 直播什么的。这是个合适的"}, {"type": "subtitle", "time": 12972.87, "timestamp": "03:36:12", "text": "客人。我们打算放松一下。"}, {"type": "subtitle", "time": 12974.95, "timestamp": "03:36:14", "text": "今天出去玩吧"}, {"type": "subtitle", "time": 12979.309, "timestamp": "03:36:19", "text": "嗯，到6点。所以，就是这样。"}, {"type": "subtitle", "time": 12982.95, "timestamp": "03:36:22", "text": "耶！我们今天打算一起出去玩。"}, {"type": "subtitle", "time": 12985.59, "timestamp": "03:36:25", "text": "是的，"}, {"type": "subtitle", "time": 12990.15, "timestamp": "03:36:30", "text": "鸡骑师。好的。好的。"}, {"type": "subtitle", "time": 12993.87, "timestamp": "03:36:33", "text": "对不起。就这么简单"}, {"type": "subtitle", "time": 12996.469, "timestamp": "03:36:36", "text": "那里。就在那儿，一个人也没有"}, {"type": "subtitle", "time": 13000.07, "timestamp": "03:36:40", "text": "正在使用它。我当时就想，天哪，"}, {"type": "subtitle", "time": 13002.95, "timestamp": "03:36:42", "text": "为什么没有人打卡？那"}, {"type": "subtitle", "time": 13005.59, "timestamp": "03:36:45", "text": "这正是我一直想知道的事情。"}, {"type": "subtitle", "time": 13007.429, "timestamp": "03:36:47", "text": "该死。"}, {"type": "subtitle", "time": 13009.83, "timestamp": "03:36:49", "text": "乔伊，你好吗？你怎么样"}, {"type": "subtitle", "time": 13014.51, "timestamp": "03:36:54", "text": "正在做？我一切都好。幸存下来，"}, {"type": "subtitle", "time": 13018.07, "timestamp": "03:36:58", "text": "压力很大，有很多事情让我感到压力。我的天哪。哦"}]
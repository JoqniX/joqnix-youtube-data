[{"type": "subtitle", "time": 120.31, "timestamp": "00:02:00", "text": "是的。是的。还有这些工作流程，"}, {"type": "subtitle", "time": 123.19, "timestamp": "00:02:03", "text": "我觉得这些对我来说至关重要。"}, {"type": "subtitle", "time": 125.749, "timestamp": "00:02:05", "text": "至少因为我们又有了我们的"}, {"type": "subtitle", "time": 128.71, "timestamp": "00:02:08", "text": "还有一些关于奥尼克斯的事情要做，对吧？"}, {"type": "subtitle", "time": 129.71, "timestamp": "00:02:09", "text": "这"}, {"type": "subtitle", "time": 135.71, "timestamp": "00:02:15", "text": "原因呃，就像看到呃，作为一个作为一个"}, {"type": "subtitle", "time": 139.67000000000002, "timestamp": "00:02:19", "text": "创作者我们有我们的呃乐趣娱乐"}, {"type": "subtitle", "time": 141.27, "timestamp": "00:02:21", "text": "比如游戏之类的东西"}, {"type": "subtitle", "time": 145.27, "timestamp": "00:02:25", "text": "一切，但主要是主要是主要是我"}, {"type": "subtitle", "time": 147.589, "timestamp": "00:02:27", "text": "想努力实现我的目标"}, {"type": "subtitle", "time": 151.11, "timestamp": "00:02:31", "text": "实现了我亲爱的愿望"}, {"type": "subtitle", "time": 154.55, "timestamp": "00:02:34", "text": "实现这个目标就像拥有自己的演唱会一样"}, {"type": "subtitle", "time": 157.19, "timestamp": "00:02:37", "text": "拥有自己的东西和项目"}, {"type": "subtitle", "time": 159.82999999999998, "timestamp": "00:02:39", "text": "比如网站相关的一切"}, {"type": "subtitle", "time": 164.589, "timestamp": "00:02:44", "text": "不，所以，是的，主要是我希望"}, {"type": "subtitle", "time": 168.22899999999998, "timestamp": "00:02:48", "text": "了解其中的技术细节……"}, {"type": "subtitle", "time": 171.91, "timestamp": "00:02:51", "text": "就像能够做到那样"}, {"type": "subtitle", "time": 175.19, "timestamp": "00:02:55", "text": "这样我就可以教别人，而不是教别人"}, {"type": "subtitle", "time": 178.50900000000001, "timestamp": "00:02:58", "text": "人们或喜欢让人们理解或"}]
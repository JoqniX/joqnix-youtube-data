[{"type": "subtitle", "time": 600.949, "timestamp": "00:10:00", "text": "向公众或公共场所展示"}, {"type": "subtitle", "time": 603.67, "timestamp": "00:10:03", "text": "新闻发布会或公共场合之类的，比如……"}, {"type": "subtitle", "time": 606.47, "timestamp": "00:10:06", "text": "不管怎样，结果会怎样，就像……"}, {"type": "subtitle", "time": 610.47, "timestamp": "00:10:10", "text": "你现实生活中的第一个名字，然后点赞"}, {"type": "subtitle", "time": 613.75, "timestamp": "00:10:13", "text": "你的名字由两个名字组成。"}, {"type": "subtitle", "time": 618.15, "timestamp": "00:10:18", "text": "最后两个呃，对吧？首先，最后，"}, {"type": "subtitle", "time": 620.91, "timestamp": "00:10:20", "text": "就像第一次一样"}, {"type": "subtitle", "time": 623.99, "timestamp": "00:10:23", "text": "名字，你的名字，呃，你现实生活中的名字，"}, {"type": "subtitle", "time": 626.47, "timestamp": "00:10:26", "text": "然后是你的游戏ID或者电竞"}, {"type": "subtitle", "time": 628.67, "timestamp": "00:10:28", "text": "你在社交媒体上使用的名字"}, {"type": "subtitle", "time": 631.91, "timestamp": "00:10:31", "text": "互联网，对吧？然后是最后一个"}, {"type": "subtitle", "time": 634.11, "timestamp": "00:10:34", "text": "姓名，"}, {"type": "subtitle", "time": 638.84, "timestamp": "00:10:38", "text": "正确的？是啊，就是这样，对吧？"}, {"type": "subtitle", "time": 641.069, "timestamp": "00:10:41", "text": "[音乐]"}, {"type": "subtitle", "time": 644.11, "timestamp": "00:10:44", "text": "嗯，举个例子来说……"}, {"type": "subtitle", "time": 647.15, "timestamp": "00:10:47", "text": "我们都知道裹尸布"}, {"type": "subtitle", "time": 651.269, "timestamp": "00:10:51", "text": "对，所以他的名字是迈克尔。"}, {"type": "subtitle", "time": 653.99, "timestamp": "00:10:53", "text": "就像迈克尔·施劳德那样，然后是他的"}, {"type": "subtitle", "time": 655.75, "timestamp": "00:10:55", "text": "难以发音的姓氏"}, {"type": "subtitle", "time": 659.43, "timestamp": "00:10:59", "text": "读作“哦我的天啊，油腻”之类的"}]
[{"type": "subtitle", "time": 14580.15, "timestamp": "04:03:00", "text": "请理解我不在直播间。"}, {"type": "subtitle", "time": 14584.229, "timestamp": "04:03:04", "text": "没错。是的。是的。但这就是"}, {"type": "subtitle", "time": 14586.95, "timestamp": "04:03:06", "text": "这是。这是。看起来很有趣。是"}, {"type": "subtitle", "time": 14589.51, "timestamp": "04:03:09", "text": "你的模型卡住了吗？不，不，不。"}, {"type": "subtitle", "time": 14591.91, "timestamp": "04:03:11", "text": "我要搬家了。小溪在哪里？我"}, {"type": "subtitle", "time": 14593.83, "timestamp": "04:03:13", "text": "不知道。好的。是的。是的。溪流"}, {"type": "subtitle", "time": 14597.269, "timestamp": "04:03:17", "text": "正在移动。我要搬家了。我明白了。"}, {"type": "subtitle", "time": 14599.83, "timestamp": "04:03:19", "text": "是的，它运行正常。是的。是的。是的。"}, {"type": "subtitle", "time": 14601.349, "timestamp": "04:03:21", "text": "是的。我当时就想，他为什么要这么做？"}, {"type": "subtitle", "time": 14603.91, "timestamp": "04:03:23", "text": "像模特那样摆姿势？他为什么会这样"}, {"type": "subtitle", "time": 14608.389, "timestamp": "04:03:28", "text": "舌位矫正？舌位矫正？我是。什么？是的。现在"}, {"type": "subtitle", "time": 14610.55, "timestamp": "04:03:30", "text": "你的模型毫无意义。只是"}, {"type": "subtitle", "time": 14613.59, "timestamp": "04:03:33", "text": "只露出他的下颌线条。哇，"}, {"type": "subtitle", "time": 14617.269, "timestamp": "04:03:37", "text": "下颌线条真好看。我喜欢。我当时"}, {"type": "subtitle", "time": 14619.59, "timestamp": "04:03:39", "text": "看着手机屏幕"}, {"type": "subtitle", "time": 14622.71, "timestamp": "04:03:42", "text": "监视器。这就是原因。"}, {"type": "subtitle", "time": 14625.189, "timestamp": "04:03:45", "text": "好的。"}, {"type": "subtitle", "time": 14632.389, "timestamp": "04:03:52", "text": "是的，这个贾塔是某种东西"}, {"type": "subtitle", "time": 14635.99, "timestamp": "04:03:55", "text": "要诚实。我拥有的东西数量庞大。"}, {"type": "subtitle", "time": 14639.11, "timestamp": "04:03:59", "text": "经历这一切简直太疯狂了，对吧？考试。"}]
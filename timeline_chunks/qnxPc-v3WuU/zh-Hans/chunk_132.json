[{"type": "subtitle", "time": 7923.31, "timestamp": "02:12:03", "text": "欲望。"}, {"type": "subtitle", "time": 7926.91, "timestamp": "02:12:06", "text": "相信我"}, {"type": "subtitle", "time": 7930.51, "timestamp": "02:12:10", "text": "我说我想"}, {"type": "subtitle", "time": 7934.39, "timestamp": "02:12:14", "text": "它。事情是这样的。"}, {"type": "subtitle", "time": 7935.99, "timestamp": "02:12:15", "text": "你感到痛苦的是什么？我开玩笑的"}, {"type": "subtitle", "time": 7938.31, "timestamp": "02:12:18", "text": "前辈。你问我软饮料是什么"}, {"type": "subtitle", "time": 7942.149, "timestamp": "02:12:22", "text": "我喜欢？自然的。是的。"}, {"type": "subtitle", "time": 7949.99, "timestamp": "02:12:29", "text": "那我来猜猜你最喜欢的水果是什么。"}, {"type": "subtitle", "time": 7958.629, "timestamp": "02:12:38", "text": "哦，他们是。我的天啊。我们都来了"}, {"type": "subtitle", "time": 7961.189, "timestamp": "02:12:41", "text": "致 A."}, {"type": "subtitle", "time": 7968.87, "timestamp": "02:12:48", "text": "是时候跳了。"}, {"type": "subtitle", "time": 7978.79, "timestamp": "02:12:58", "text": "不。"}]
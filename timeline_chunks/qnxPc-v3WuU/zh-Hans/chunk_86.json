[{"type": "subtitle", "time": 5161.669, "timestamp": "01:26:01", "text": "扫兴的人。他要么是要来捣乱，要么就是要来捣乱。"}, {"type": "subtitle", "time": 5163.83, "timestamp": "01:26:03", "text": "否则他就要杀人了。"}, {"type": "subtitle", "time": 5167.11, "timestamp": "01:26:07", "text": "一切。就是这样。哦，不。是的。"}, {"type": "subtitle", "time": 5169.03, "timestamp": "01:26:09", "text": "熊猫很合适。我的意思是，他是"}, {"type": "subtitle", "time": 5171.43, "timestamp": "01:26:11", "text": "三号钻石，对吧？他是诱饵吗？"}, {"type": "subtitle", "time": 5173.91, "timestamp": "01:26:13", "text": "所以我就想，对，他就是。"}, {"type": "subtitle", "time": 5176.87, "timestamp": "01:26:16", "text": "钻石。所以当时我就想，哦，我的天哪"}, {"type": "subtitle", "time": 5179.59, "timestamp": "01:26:19", "text": "天哪，他玩得太厉害了。"}, {"type": "subtitle", "time": 5181.91, "timestamp": "01:26:21", "text": "正确的？所以这就是我为什么会说，哦，我的天哪"}, {"type": "subtitle", "time": 5184.03, "timestamp": "01:26:24", "text": "主啊，别这样"}, {"type": "subtitle", "time": 5185.629, "timestamp": "01:26:25", "text": "这。"}]
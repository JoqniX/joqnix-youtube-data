[{"type": "subtitle", "time": 1080.07, "timestamp": "00:18:00", "text": "那个仓库，你甚至可以启动你的"}, {"type": "subtitle", "time": 1084.15, "timestamp": "00:18:04", "text": "商品之类的东西，对吧？所以，所以"}, {"type": "subtitle", "time": 1085.63, "timestamp": "00:18:05", "text": "喜欢"}, {"type": "subtitle", "time": 1088.789, "timestamp": "00:18:08", "text": "那。说实话，我，我想做"}, {"type": "subtitle", "time": 1092.47, "timestamp": "00:18:12", "text": "商品，伙计。你看，自从我"}, {"type": "subtitle", "time": 1095.35, "timestamp": "00:18:15", "text": "我非常喜欢音乐、音乐相关的一切。"}, {"type": "subtitle", "time": 1097.95, "timestamp": "00:18:17", "text": "比如，你知道的，DJ、演唱会等等"}, {"type": "subtitle", "time": 1101.19, "timestamp": "00:18:21", "text": "东西，我内心深处想做成这样"}, {"type": "subtitle", "time": 1105.549, "timestamp": "00:18:25", "text": "就像新一代最完美的产品一样"}, {"type": "subtitle", "time": 1107.83, "timestamp": "00:18:27", "text": "人们可以穿戴的商品。然后"}, {"type": "subtitle", "time": 1109.669, "timestamp": "00:18:29", "text": "我心想，哦等等，我得把它做出来。"}, {"type": "subtitle", "time": 1111.35, "timestamp": "00:18:31", "text": "也适合日常穿着。将会是"}, {"type": "subtitle", "time": 1114.07, "timestamp": "00:18:34", "text": "这种混合型的东西感觉很奇怪"}, {"type": "subtitle", "time": 1115.99, "timestamp": "00:18:35", "text": "当你……时，身上穿的衣服"}, {"type": "subtitle", "time": 1118.47, "timestamp": "00:18:38", "text": "外部。人们会看着你。"}, {"type": "subtitle", "time": 1124.83, "timestamp": "00:18:44", "text": "等待。嗯，"}, {"type": "subtitle", "time": 1127.99, "timestamp": "00:18:47", "text": "是的。呃，我想我是在直播的时候拍的。"}, {"type": "subtitle", "time": 1130.31, "timestamp": "00:18:50", "text": "正确的？呃，那个词是什么来着？"}, {"type": "subtitle", "time": 1132.19, "timestamp": "00:18:52", "text": "有人说"}, {"type": "subtitle", "time": 1136.83, "timestamp": "00:18:56", "text": "时间？超流行音乐。不。嗯，"}]
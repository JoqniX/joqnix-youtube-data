[{"type": "subtitle", "time": 12249.83, "timestamp": "03:24:09", "text": "我进度落后了。我进度落后了。我仍然不明白"}, {"type": "subtitle", "time": 12259.19, "timestamp": "03:24:19", "text": "准备好了。"}, {"type": "subtitle", "time": 12278.07, "timestamp": "03:24:38", "text": "你能让我休息一下吗？"}, {"type": "subtitle", "time": 12281.55, "timestamp": "03:24:41", "text": "他盼着夏天能和他待在一起。"}, {"type": "subtitle", "time": 12284.55, "timestamp": "03:24:44", "text": "是的。我知道如果他们改变，但是我们"}, {"type": "subtitle", "time": 12288.15, "timestamp": "03:24:48", "text": "虽然要待上几个月，但这事迟早会发生。"}, {"type": "subtitle", "time": 12290.429, "timestamp": "03:24:50", "text": "是的。我不"}, {"type": "subtitle", "time": 12293.91, "timestamp": "03:24:53", "text": "很久以来，我一直盼望着它到来。"}, {"type": "subtitle", "time": 12296.229, "timestamp": "03:24:56", "text": "好的。"}]
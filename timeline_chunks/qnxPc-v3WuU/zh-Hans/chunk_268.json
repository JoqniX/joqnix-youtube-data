[{"type": "subtitle", "time": 16082.389, "timestamp": "04:28:02", "text": "天哪，我还以为你永远不会问呢。如何"}, {"type": "subtitle", "time": 16083.83, "timestamp": "04:28:03", "text": "我去过吗？当然，我会问"}, {"type": "subtitle", "time": 16085.91, "timestamp": "04:28:05", "text": "那。"}, {"type": "subtitle", "time": 16086.91, "timestamp": "04:28:06", "text": "不，我是"}, {"type": "subtitle", "time": 16089.189, "timestamp": "04:28:09", "text": "开玩笑的。有时候我会忘记你不会明白"}, {"type": "subtitle", "time": 16090.71, "timestamp": "04:28:10", "text": "讽刺。"}, {"type": "subtitle", "time": 16093.99, "timestamp": "04:28:13", "text": "这是反讽。"}, {"type": "subtitle", "time": 16096.11, "timestamp": "04:28:16", "text": "确切地"}, {"type": "subtitle", "time": 16098.189, "timestamp": "04:28:18", "text": "乔有时我"}, {"type": "subtitle", "time": 16099.95, "timestamp": "04:28:19", "text": "忘记"}, {"type": "subtitle", "time": 16103.349, "timestamp": "04:28:23", "text": "确实没什么特别的。"}, {"type": "subtitle", "time": 16107.389, "timestamp": "04:28:27", "text": "事情正在发生，但我自己却一直如此。"}, {"type": "subtitle", "time": 16111.229, "timestamp": "04:28:31", "text": "没有练习过，一直在发展"}, {"type": "subtitle", "time": 16113.429, "timestamp": "04:28:33", "text": "我想我跟你说过这件事"}, {"type": "subtitle", "time": 16114.71, "timestamp": "04:28:34", "text": "或者其他什么人，我不记得了。"}, {"type": "subtitle", "time": 16118.149, "timestamp": "04:28:38", "text": "其实我跟谁说过这事儿？嗯。"}, {"type": "subtitle", "time": 16121.67, "timestamp": "04:28:41", "text": "我本人一直在研究一个模型哦"}, {"type": "subtitle", "time": 16124.59, "timestamp": "04:28:44", "text": "为自己体验2D生活。"}, {"type": "subtitle", "time": 16129.429, "timestamp": "04:28:49", "text": "谁知道呢？或许"}, {"type": "subtitle", "time": 16131.269, "timestamp": "04:28:51", "text": "我们走吧。"}, {"type": "subtitle", "time": 16135.429, "timestamp": "04:28:55", "text": "是的。是的，我一直在练习"}, {"type": "subtitle", "time": 16139.59, "timestamp": "04:28:59", "text": "嗯，总而言之，索具"}]
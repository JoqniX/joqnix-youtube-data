[{"type": "subtitle", "time": 3962.39, "timestamp": "01:06:02", "text": "紧张的。这就像……这就像……"}, {"type": "subtitle", "time": 3965.029, "timestamp": "01:06:05", "text": "如果你认为可以以某种方式进行合作，那就太好了。"}, {"type": "subtitle", "time": 3968.069, "timestamp": "01:06:08", "text": "关于它。就像合作的障碍一样"}, {"type": "subtitle", "time": 3971.47, "timestamp": "01:06:11", "text": "仔细想想，某种程度上确实如此。但"}, {"type": "subtitle", "time": 3974.109, "timestamp": "01:06:14", "text": "是的，而且"}, {"type": "subtitle", "time": 3977.15, "timestamp": "01:06:17", "text": "是的，我也有合作项目。"}, {"type": "subtitle", "time": 3980.549, "timestamp": "01:06:20", "text": "几次，三次到"}, {"type": "subtitle", "time": 3982.95, "timestamp": "01:06:22", "text": "我想应该是第四个吧。是三个吗？"}, {"type": "subtitle", "time": 3985.75, "timestamp": "01:06:25", "text": "四？是的。是的，有过几次，但是"}, {"type": "subtitle", "time": 3988.51, "timestamp": "01:06:28", "text": "我仍然对此感到紧张。"}, {"type": "subtitle", "time": 3993.029, "timestamp": "01:06:33", "text": "天。你没事。而且我更"}, {"type": "subtitle", "time": 3996.19, "timestamp": "01:06:36", "text": "呃，有点紧张，因为……"}, {"type": "subtitle", "time": 3998.789, "timestamp": "01:06:38", "text": "嗯，我更紧张了，因为……你……"}, {"type": "subtitle", "time": 4000.19, "timestamp": "01:06:40", "text": "叫它什么？"}, {"type": "subtitle", "time": 4004.91, "timestamp": "01:06:44", "text": "嗯，他们是来我家做客的客人。"}, {"type": "subtitle", "time": 4007.67, "timestamp": "01:06:47", "text": "所以他们真的能听到我说话。"}, {"type": "subtitle", "time": 4009.43, "timestamp": "01:06:49", "text": "英语，还有直播之类的。"}, {"type": "subtitle", "time": 4011.19, "timestamp": "01:06:51", "text": "所以，我为此感到非常尴尬。"}, {"type": "subtitle", "time": 4013.67, "timestamp": "01:06:53", "text": "他们做不到。"}, {"type": "subtitle", "time": 4015.87, "timestamp": "01:06:55", "text": "而我却不这么认为。"}]
[{"type": "subtitle", "time": 17280.31, "timestamp": "04:48:00", "text": "是的。问题是我无法使用Discord。"}, {"type": "subtitle", "time": 17283.11, "timestamp": "04:48:03", "text": "向下滚动并点赞，找到我认识的人"}, {"type": "subtitle", "time": 17285.75, "timestamp": "04:48:05", "text": "已互发信息并加好友。有些人甚至"}, {"type": "subtitle", "time": 17287.99, "timestamp": "04:48:07", "text": "他把我从好友列表里删除了。我甚至不知道它在哪里"}, {"type": "subtitle", "time": 17291.91, "timestamp": "04:48:11", "text": "为什么、为什么等等。我当时就想，这是什么？"}, {"type": "subtitle", "time": 17294.39, "timestamp": "04:48:14", "text": "名字是？我找不到这个名字。我"}, {"type": "subtitle", "time": 17299.11, "timestamp": "04:48:19", "text": "想起很久以前的某个人。"}, {"type": "subtitle", "time": 17301.51, "timestamp": "04:48:21", "text": "是的。这家伙真的很想要他的"}, {"type": "subtitle", "time": 17303.99, "timestamp": "04:48:23", "text": "他喜欢合作，对吧？我的意思是，我没看到"}, {"type": "subtitle", "time": 17306.31, "timestamp": "04:48:26", "text": "将其视为合作项目。我认为这是最后一次"}, {"type": "subtitle", "time": 17308.868, "timestamp": "04:48:28", "text": "大家一起聊聊吧，因为我正在直播。"}, {"type": "subtitle", "time": 17311.83, "timestamp": "04:48:31", "text": "惊人的。是的，我24小时不间断直播。和"}, {"type": "subtitle", "time": 17315.19, "timestamp": "04:48:35", "text": "即使我不在直播什么的，我"}, {"type": "subtitle", "time": 17317.35, "timestamp": "04:48:37", "text": "只想和大家一起放松放松，喜欢"}, {"type": "subtitle", "time": 17319.27, "timestamp": "04:48:39", "text": "与人交谈。这不是合作的问题。"}, {"type": "subtitle", "time": 17321.67, "timestamp": "04:48:41", "text": "或者任何东西。我只想放松一下。"}, {"type": "subtitle", "time": 17323.83, "timestamp": "04:48:43", "text": "玩的很开心。"}, {"type": "subtitle", "time": 17325.75, "timestamp": "04:48:45", "text": "是的。"}, {"type": "subtitle", "time": 17327.75, "timestamp": "04:48:47", "text": "我的意思是，你甚至都不用挤压。"}, {"type": "subtitle", "time": 17331.03, "timestamp": "04:48:51", "text": "我们想知道为什么。我认为那就是"}, {"type": "subtitle", "time": 17333.75, "timestamp": "04:48:53", "text": "他想表达的观点。就像他想的那样"}, {"type": "subtitle", "time": 17337.27, "timestamp": "04:48:57", "text": "把你们都挤进去，你知道，他想"}, {"type": "subtitle", "time": 17339.75, "timestamp": "04:48:59", "text": "去做这件事。"}]
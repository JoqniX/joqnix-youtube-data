[{"type": "subtitle", "time": 15901.59, "timestamp": "04:25:01", "text": "试试看。你知道，你知道那些俱乐部"}, {"type": "subtitle", "time": 15905.429, "timestamp": "04:25:05", "text": "音乐，对吧？舞曲"}, {"type": "subtitle", "time": 15909.189, "timestamp": "04:25:09", "text": "就像他们播放的那种低音音乐"}, {"type": "subtitle", "time": 15911.91, "timestamp": "04:25:11", "text": "俱乐部。是的，我想就是那种情况。"}, {"type": "subtitle", "time": 15916.229, "timestamp": "04:25:16", "text": "类型。是的。这是一首电子舞曲。有"}, {"type": "subtitle", "time": 15919.189, "timestamp": "04:25:19", "text": "好多子类型之类的东西啊。我的音乐"}, {"type": "subtitle", "time": 15921.51, "timestamp": "04:25:21", "text": "制作课程，他们教授电子舞曲（EDM）。"}, {"type": "subtitle", "time": 15925.75, "timestamp": "04:25:25", "text": "还有一些其他的东西。是的，"}, {"type": "subtitle", "time": 15928.95, "timestamp": "04:25:28", "text": "那很好。"}, {"type": "chat", "time": 15931.385, "timestamp": "04:25:31", "author": "@site36.official", "avatar": "https://yt4.ggpht.com/Oc0kgq4lSUaD-BoDbaDE3pXUquuz47c4Yh7kwPILHO2D70EQ5EnEgoGgTbb5gw993EEXRqCx_A=s64-c-k-c0x00ffffff-no-rj", "message": "I learnt it yesterday that you were an EDM fan and I kinda spent the entire night figuring it out 🥹"}, {"type": "subtitle", "time": 15932.389, "timestamp": "04:25:32", "text": "我仍然需要为此付费。呃，课程"}, {"type": "subtitle", "time": 15934.149, "timestamp": "04:25:34", "text": "仍在待处理状态。我必须付钱"}, {"type": "subtitle", "time": 15935.149, "timestamp": "04:25:35", "text": "这"}, {"type": "subtitle", "time": 15942.95, "timestamp": "04:25:42", "text": "事物。等等，我昨天就学会了。"}, {"type": "subtitle", "time": 15945.269, "timestamp": "04:25:45", "text": "你曾是电子舞曲（EDM）的粉丝。我有点儿消磨时间"}, {"type": "subtitle", "time": 15947.349, "timestamp": "04:25:47", "text": "整晚都在琢磨这个问题。等待，"}, {"type": "subtitle", "time": 15950.389, "timestamp": "04:25:50", "text": "我从未公开表示自己是电子舞曲的粉丝。"}, {"type": "subtitle", "time": 15953.269, "timestamp": "04:25:53", "text": "我以前也这么说过。等等，它甚至还在里面"}, {"type": "subtitle", "time": 15956.87, "timestamp": "04:25:56", "text": "粉丝群体，米奇。我相信"}, {"type": "subtitle", "time": 15959.99, "timestamp": "04:25:59", "text": "他是电子舞曲爱好者。你只是个电子舞曲爱好者而已。"}]
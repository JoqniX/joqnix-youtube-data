[{"type": "subtitle", "time": 7743.91, "timestamp": "02:09:03", "text": "正确的？嘿，假动作帮。你是什​​么"}, {"type": "subtitle", "time": 7747.709, "timestamp": "02:09:07", "text": "你这话是什么意思？哦，是的。你是什​​么"}, {"type": "subtitle", "time": 7756.47, "timestamp": "02:09:16", "text": "能。我不知道该怎么玩。患病的"}, {"type": "subtitle", "time": 7773.35, "timestamp": "02:09:33", "text": "我的天啊。我试着做了，而你却……"}, {"type": "subtitle", "time": 7782.47, "timestamp": "02:09:42", "text": "某种疼痛。"}, {"type": "subtitle", "time": 7789.39, "timestamp": "02:09:49", "text": "一"}, {"type": "subtitle", "time": 7792.95, "timestamp": "02:09:52", "text": "敌人穿过。"}, {"type": "subtitle", "time": 7796.149, "timestamp": "02:09:56", "text": "最后一名幸存者。"}]
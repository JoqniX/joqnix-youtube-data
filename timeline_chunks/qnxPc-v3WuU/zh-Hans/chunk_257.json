[{"type": "subtitle", "time": 15420.79, "timestamp": "04:17:00", "text": "比如和朋友们一起出去玩什么的。"}, {"type": "subtitle", "time": 15424.07, "timestamp": "04:17:04", "text": "就像新的篇章即将到来"}, {"type": "subtitle", "time": 15428.389, "timestamp": "04:17:08", "text": "对我来说，下个月，下个月。是的。"}, {"type": "subtitle", "time": 15430.95, "timestamp": "04:17:10", "text": "是的，还有那件事。"}, {"type": "subtitle", "time": 15432.71, "timestamp": "04:17:12", "text": "所以，我们暂时不会再见到你了。"}, {"type": "subtitle", "time": 15435.91, "timestamp": "04:17:15", "text": "同时。或者，如果那不是……"}, {"type": "subtitle", "time": 15437.99, "timestamp": "04:17:17", "text": "情况就是这样，因为你可以一边听一边直播"}, {"type": "subtitle", "time": 15446.67, "timestamp": "04:17:26", "text": "是的。我当时"}, {"type": "subtitle", "time": 15450.229, "timestamp": "04:17:30", "text": "我在想也许不行，我不确定我能不能做到"}, {"type": "subtitle", "time": 15453.75, "timestamp": "04:17:33", "text": "那样做，但我当时在想什么"}, {"type": "subtitle", "time": 15458.79, "timestamp": "04:17:38", "text": "如果我只是你知道，只是想保留"}, {"type": "subtitle", "time": 15461.91, "timestamp": "04:17:41", "text": "频道激活了一天左右"}, {"type": "subtitle", "time": 15464.149, "timestamp": "04:17:44", "text": "我大概一周玩一次左右。"}, {"type": "subtitle", "time": 15465.71, "timestamp": "04:17:45", "text": "一些退伍军人事务部"}, {"type": "subtitle", "time": 15469.51, "timestamp": "04:17:49", "text": "不知怎么的，是的，就像字面上的V或"}, {"type": "subtitle", "time": 15472.91, "timestamp": "04:17:52", "text": "不知何故，这台电脑里出现了一些东西。"}, {"type": "subtitle", "time": 15475.51, "timestamp": "04:17:55", "text": "不知何故，但这岂不是意味着我不应该"}, {"type": "subtitle", "time": 15477.91, "timestamp": "04:17:57", "text": "我无法带走我的数据"}, {"type": "subtitle", "time": 15479.99, "timestamp": "04:17:59", "text": "是我吧？我必须把我的数据带走"}]
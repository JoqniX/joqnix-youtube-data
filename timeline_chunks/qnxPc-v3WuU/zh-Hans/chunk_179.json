[{"type": "subtitle", "time": 10742.309, "timestamp": "02:59:02", "text": "皮肤。光谱皮肤。呃，等等，什么？"}, {"type": "subtitle", "time": 10744.95, "timestamp": "02:59:04", "text": "是那个吗？我的天啊。哦，她在那儿。"}, {"type": "subtitle", "time": 10754.95, "timestamp": "02:59:14", "text": "里面。我的天啊。"}, {"type": "subtitle", "time": 10756.469, "timestamp": "02:59:16", "text": "我们可以退而求其次。我们可以退而求其次。我们"}, {"type": "subtitle", "time": 10763.91, "timestamp": "02:59:23", "text": "小心点。现在要小心。来吧，来吧"}, {"type": "subtitle", "time": 10770.55, "timestamp": "02:59:30", "text": "等等，等等。间谍，你回去。天空男孩"}, {"type": "subtitle", "time": 10775.07, "timestamp": "02:59:35", "text": "得到"}, {"type": "subtitle", "time": 10777.349, "timestamp": "02:59:37", "text": "他。现在应该有一个地方他们"}, {"type": "subtitle", "time": 10786.79, "timestamp": "02:59:46", "text": "天堂。抓到他了。"}, {"type": "subtitle", "time": 10791.11, "timestamp": "02:59:51", "text": "还剩一个敌人。等等，他在哪里？"}, {"type": "subtitle", "time": 10793.51, "timestamp": "02:59:53", "text": "哦，他入选了。"}, {"type": "subtitle", "time": 10797.03, "timestamp": "02:59:57", "text": "我有三个。你可以把我的SP打包带走。"}]
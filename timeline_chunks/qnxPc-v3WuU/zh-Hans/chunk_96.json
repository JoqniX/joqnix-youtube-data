[{"type": "subtitle", "time": 5762.43, "timestamp": "01:36:02", "text": "你说左边？我不"}, {"type": "subtitle", "time": 5775.83, "timestamp": "01:36:15", "text": "正在输入。我必须放弃一切。"}, {"type": "subtitle", "time": 5777.47, "timestamp": "01:36:17", "text": "好的。"}, {"type": "subtitle", "time": 5783.99, "timestamp": "01:36:23", "text": "我们走吧。"}, {"type": "subtitle", "time": 5788.39, "timestamp": "01:36:28", "text": "有人可以参加吗？没关系。是"}, {"type": "subtitle", "time": 5794.629, "timestamp": "01:36:34", "text": "她不打排位赛。她没有。"}, {"type": "subtitle", "time": 5798.39, "timestamp": "01:36:38", "text": "哦，不。左边。"}, {"type": "subtitle", "time": 5800.95, "timestamp": "01:36:40", "text": "我会回来的。好的。好的。你喜欢"}, {"type": "subtitle", "time": 5805.35, "timestamp": "01:36:45", "text": "窥视。快点。给他们看看东西。"}, {"type": "subtitle", "time": 5807.91, "timestamp": "01:36:47", "text": "等待。不，不，不，不。我会的。我是"}, {"type": "subtitle", "time": 5811.51, "timestamp": "01:36:51", "text": "恼火。嗯嗯，我马上回来。我是"}, {"type": "subtitle", "time": 5814.55, "timestamp": "01:36:54", "text": "我猜就是被人这么叫过。"}, {"type": "subtitle", "time": 5817.109, "timestamp": "01:36:57", "text": "房子。这就是新加坡。我不"}, {"type": "subtitle", "time": 5819.91, "timestamp": "01:36:59", "text": "知道为什么新加坡人会这样吗？"}]
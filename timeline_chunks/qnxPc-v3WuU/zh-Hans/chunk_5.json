[{"type": "subtitle", "time": 302.99, "timestamp": "00:05:02", "text": "我真没想到会这样"}, {"type": "subtitle", "time": 310.79, "timestamp": "00:05:10", "text": "哇。但是，对我来说，这对我来说并不合适。"}, {"type": "subtitle", "time": 313.189, "timestamp": "00:05:13", "text": "做了 Jockn 和所有的一切，Jockn 是怎么做的"}, {"type": "subtitle", "time": 315.23, "timestamp": "00:05:15", "text": "是对的"}, {"type": "subtitle", "time": 319.189, "timestamp": "00:05:19", "text": "现在。呃，自从奥妮克西亚的事情发生以来……"}, {"type": "subtitle", "time": 322.23, "timestamp": "00:05:22", "text": "确实有这么回事，对吧？无性恋和性欲方面的东西是"}, {"type": "subtitle", "time": 325.51, "timestamp": "00:05:25", "text": "事物。事情是这样的，我的网站。"}, {"type": "subtitle", "time": 329.43, "timestamp": "00:05:29", "text": "我自己拥有的短链接域名，我自己的域名，这些东西"}, {"type": "subtitle", "time": 332.07, "timestamp": "00:05:32", "text": "以及我想要的"}, {"type": "subtitle", "time": 334.87, "timestamp": "00:05:34", "text": "呃，在 XOTV 上，就像在仓库里一样，所有……"}, {"type": "subtitle", "time": 336.67, "timestamp": "00:05:36", "text": "我的音乐相关"}, {"type": "subtitle", "time": 339.83, "timestamp": "00:05:39", "text": "与故事相关的各种东西，呃，还有一些其他的东西。"}, {"type": "subtitle", "time": 341.71, "timestamp": "00:05:41", "text": "一切和"}, {"type": "subtitle", "time": 344.95, "timestamp": "00:05:44", "text": "我也曾有过类似的想法，那就是喜欢你。"}, {"type": "subtitle", "time": 348.749, "timestamp": "00:05:48", "text": "知道像这样慷慨地付出"}, {"type": "subtitle", "time": 352.629, "timestamp": "00:05:52", "text": "为观众带来故事体验。"}, {"type": "subtitle", "time": 354.629, "timestamp": "00:05:54", "text": "读者和所有人都喜欢更多"}, {"type": "subtitle", "time": 357.67, "timestamp": "00:05:57", "text": "你知道，这是一份需要传承的遗产。"}]
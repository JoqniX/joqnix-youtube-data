[{"type": "subtitle", "time": 6843.589, "timestamp": "01:54:03", "text": "哦，真棒，干得好！"}, {"type": "subtitle", "time": 6845.27, "timestamp": "01:54:05", "text": "制作。"}, {"type": "subtitle", "time": 6861.189, "timestamp": "01:54:21", "text": "[掌声]"}, {"type": "subtitle", "time": 6862.27, "timestamp": "01:54:22", "text": "我和"}, {"type": "subtitle", "time": 6865.35, "timestamp": "01:54:25", "text": "阿尼库纳一对一。我当时并没有杀人。"}, {"type": "subtitle", "time": 6884.31, "timestamp": "01:54:44", "text": "我的天啊。我为什么打她？我打了她"}, {"type": "subtitle", "time": 6888.99, "timestamp": "01:54:48", "text": "不过，头脑很清醒。双关语让我很恼火。如何？"}, {"type": "subtitle", "time": 6891.669, "timestamp": "01:54:51", "text": "上帝创造了一个。我的天啊。他很擅长"}]
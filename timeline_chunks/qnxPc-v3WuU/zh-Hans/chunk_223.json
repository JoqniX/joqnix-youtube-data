[{"type": "subtitle", "time": 13381.51, "timestamp": "03:43:01", "text": "关于？你就像个小主播。"}, {"type": "subtitle", "time": 13384.469, "timestamp": "03:43:04", "text": "看看你，伙计。现在像个大男孩了。"}, {"type": "subtitle", "time": 13389.19, "timestamp": "03:43:09", "text": "你是个大男孩了。不，我只是个无名小卒。"}, {"type": "subtitle", "time": 13391.19, "timestamp": "03:43:11", "text": "闭嘴。"}, {"type": "subtitle", "time": 13393.75, "timestamp": "03:43:13", "text": "你是铁视频中的某个人"}, {"type": "subtitle", "time": 13396.67, "timestamp": "03:43:16", "text": "社区类似"}, {"type": "subtitle", "time": 13399.83, "timestamp": "03:43:19", "text": "就像在我们所有人身上一样，你知道，就是这样"}, {"type": "subtitle", "time": 13401.99, "timestamp": "03:43:21", "text": "很高兴看到你成长。"}, {"type": "subtitle", "time": 13403.67, "timestamp": "03:43:23", "text": "大的"}, {"type": "subtitle", "time": 13405.95, "timestamp": "03:43:25", "text": "我一直在观察你。"}, {"type": "subtitle", "time": 13410.07, "timestamp": "03:43:30", "text": "很久以前就关掉这家伙了，这家伙受不了了"}, {"type": "subtitle", "time": 13414.07, "timestamp": "03:43:34", "text": "他无法接受赞美。"}, {"type": "subtitle", "time": 13415.75, "timestamp": "03:43:35", "text": "这就是他令人讨厌的地方之一。"}, {"type": "subtitle", "time": 13417.99, "timestamp": "03:43:37", "text": "虽然他有某些特质，但他这样的人无法接受"}, {"type": "subtitle", "time": 13423.99, "timestamp": "03:43:43", "text": "比如，“是啊，你做得很好。”和"}, {"type": "subtitle", "time": 13436.189, "timestamp": "03:43:56", "text": "我不知道更多。"}, {"type": "subtitle", "time": 13439.63, "timestamp": "03:43:59", "text": "男人。我不知道。"}]
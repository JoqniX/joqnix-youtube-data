[{"type": "subtitle", "time": 2042.07, "timestamp": "00:34:02", "text": "四次各种不同的"}, {"type": "subtitle", "time": 2045.47, "timestamp": "00:34:05", "text": "能量水平就在那里，对吧？"}, {"type": "subtitle", "time": 2048.19, "timestamp": "00:34:08", "text": "是混乱的"}, {"type": "subtitle", "time": 2053.75, "timestamp": "00:34:13", "text": "一的混乱高能量二就像"}, {"type": "subtitle", "time": 2057.03, "timestamp": "00:34:17", "text": "平静能量三就像中性一样"}, {"type": "subtitle", "time": 2060.27, "timestamp": "00:34:20", "text": "我认为能量四就像"}, {"type": "subtitle", "time": 2063.55, "timestamp": "00:34:23", "text": "但我觉得就像往下坠落一样"}, {"type": "subtitle", "time": 2072.829, "timestamp": "00:34:32", "text": "笨蛋。你是"}, {"type": "subtitle", "time": 2075.95, "timestamp": "00:34:35", "text": "晚的。好的。希望你过得愉快"}, {"type": "subtitle", "time": 2078.349, "timestamp": "00:34:38", "text": "睡觉。好的"}, {"type": "subtitle", "time": 2086.149, "timestamp": "00:34:46", "text": "爸爸拍了拍。希望你睡得好。希望"}, {"type": "subtitle", "time": 2088.349, "timestamp": "00:34:48", "text": "你睡得很好。"}, {"type": "subtitle", "time": 2091.55, "timestamp": "00:34:51", "text": "肯定熬夜熬了很多夜。"}, {"type": "subtitle", "time": 2096.109, "timestamp": "00:34:56", "text": "昨天，老兄。巴卡让你这么做的"}, {"type": "subtitle", "time": 2097.51, "timestamp": "00:34:57", "text": "睡觉。"}, {"type": "subtitle", "time": 2099.069, "timestamp": "00:34:59", "text": "[音乐]"}]
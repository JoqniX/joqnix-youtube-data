[{"type": "subtitle", "time": 9842.07, "timestamp": "02:44:02", "text": "潘多拉？我不知道。是的。"}, {"type": "subtitle", "time": 9864.15, "timestamp": "02:44:24", "text": "我们是维多利亚时代的人。"}, {"type": "subtitle", "time": 9865.99, "timestamp": "02:44:25", "text": "是的。你好。欢迎，欢迎。怎样"}, {"type": "subtitle", "time": 9868.87, "timestamp": "02:44:28", "text": "你今天过得怎么样？"}, {"type": "subtitle", "time": 9870.87, "timestamp": "02:44:30", "text": "希望你一切都好。"}, {"type": "subtitle", "time": 9874.309, "timestamp": "02:44:34", "text": "我是罗。等等，比赛已经开始了吧？"}, {"type": "subtitle", "time": 9884.07, "timestamp": "02:44:44", "text": "还剩最后一个。 10秒。"}, {"type": "subtitle", "time": 9888.79, "timestamp": "02:44:48", "text": "阿曼的……呃……妄想症能力。"}, {"type": "subtitle", "time": 9895.99, "timestamp": "02:44:55", "text": "你呢？我一切都好。我是"}, {"type": "subtitle", "time": 9899.11, "timestamp": "02:44:59", "text": "也做得很好。"}]
[{"type": "subtitle", "time": 4696.55, "timestamp": "01:18:16", "text": "他们。我要离开一会儿，有事要办。哦"}, {"type": "subtitle", "time": 4712.229, "timestamp": "01:18:32", "text": "我的天啊。好的。"}, {"type": "subtitle", "time": 4715.63, "timestamp": "01:18:35", "text": "那是我唯一一次杀戮。他们是"}, {"type": "subtitle", "time": 4718.95, "timestamp": "01:18:38", "text": "好的。他们都是好人。就像他们"}, {"type": "subtitle", "time": 4721.35, "timestamp": "01:18:41", "text": "好好打。"}, {"type": "subtitle", "time": 4724.63, "timestamp": "01:18:44", "text": "你并非平庸之辈。快点。你是"}, {"type": "subtitle", "time": 4727.11, "timestamp": "01:18:47", "text": "绝非平庸。我告诉你"}, {"type": "subtitle", "time": 4731.99, "timestamp": "01:18:51", "text": "我看不到你在线，因为我躲起来了。"}]
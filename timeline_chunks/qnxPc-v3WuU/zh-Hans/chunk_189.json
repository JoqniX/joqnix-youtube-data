[{"type": "subtitle", "time": 11343.349, "timestamp": "03:09:03", "text": "还剩10秒。"}, {"type": "subtitle", "time": 11347.349, "timestamp": "03:09:07", "text": "我的天啊，这个笨蛋。哦，天哪。是的，"}, {"type": "subtitle", "time": 11349.83, "timestamp": "03:09:09", "text": "老兄。他把它解雇了，你知道的。他拿走了"}, {"type": "subtitle", "time": 11353.19, "timestamp": "03:09:13", "text": "他把尖刺刺倒了下去。他来过这里"}, {"type": "subtitle", "time": 11356.469, "timestamp": "03:09:16", "text": "一直如此。最后一名幸存者。我的"}, {"type": "subtitle", "time": 11369.429, "timestamp": "03:09:29", "text": "他是“不，不，不”。大概就像在某个地方"}, {"type": "subtitle", "time": 11377.429, "timestamp": "03:09:37", "text": "我的天哪。哇。"}, {"type": "subtitle", "time": 11380.79, "timestamp": "03:09:40", "text": "从后面。我的天啊。他在玩游戏"}, {"type": "subtitle", "time": 11383.03, "timestamp": "03:09:43", "text": "聪明绝顶。"}, {"type": "subtitle", "time": 11397.83, "timestamp": "03:09:57", "text": "我们能搞定。我们能搞定。"}]
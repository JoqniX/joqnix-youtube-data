[{"type": "subtitle", "time": 10145.67, "timestamp": "02:49:05", "text": "你已经尽力了。是的，你完成了你的"}, {"type": "subtitle", "time": 10148.63, "timestamp": "02:49:08", "text": "最好的。等等，我死了吗？我死过一次"}, {"type": "subtitle", "time": 10152.469, "timestamp": "02:49:12", "text": "尽管。但我们当时就是在玩这个。哦，"}, {"type": "subtitle", "time": 10155.19, "timestamp": "02:49:15", "text": "等待。两次。"}, {"type": "subtitle", "time": 10157.99, "timestamp": "02:49:17", "text": "现在我想玩……哦，你……"}, {"type": "subtitle", "time": 10159.75, "timestamp": "02:49:19", "text": "你可以加入。你可以加入我所有的活动。"}, {"type": "subtitle", "time": 10162.23, "timestamp": "02:49:22", "text": "还有很多事情要做。再看看"}, {"type": "subtitle", "time": 10166.87, "timestamp": "02:49:26", "text": "这。我的战斗通行证等级大概是 44、40、44。"}, {"type": "subtitle", "time": 10169.75, "timestamp": "02:49:29", "text": "也一样。哦，对了，我想你还有"}, {"type": "subtitle", "time": 10174.309, "timestamp": "02:49:34", "text": "时间。我需要去。谢谢。"}, {"type": "subtitle", "time": 10176.87, "timestamp": "02:49:36", "text": "你好。"}, {"type": "subtitle", "time": 10179.429, "timestamp": "02:49:39", "text": "嘿，我觉得你可以在孟买加入。"}, {"type": "subtitle", "time": 10182.269, "timestamp": "02:49:42", "text": "印度。是的，印度孟买。"}, {"type": "subtitle", "time": 10184.95, "timestamp": "02:49:44", "text": "是的。不，我只在……的时候听音乐"}, {"type": "subtitle", "time": 10187.269, "timestamp": "02:49:47", "text": "我感觉自己挺脆弱的，就像……"}, {"type": "subtitle", "time": 10190.469, "timestamp": "02:49:50", "text": "情绪脆弱之类的。"}, {"type": "subtitle", "time": 10194.309, "timestamp": "02:49:54", "text": "我可以再买一个吗？"}, {"type": "subtitle", "time": 10197.75, "timestamp": "02:49:57", "text": "什么？我可以问一个问题吗？"}, {"type": "subtitle", "time": 10199.269, "timestamp": "02:49:59", "text": "在？"}]
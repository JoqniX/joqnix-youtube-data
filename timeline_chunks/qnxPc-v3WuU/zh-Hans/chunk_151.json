[{"type": "subtitle", "time": 9098.75, "timestamp": "02:31:38", "text": "上帝。哦，他去世了。"}, {"type": "subtitle", "time": 9103.27, "timestamp": "02:31:43", "text": "出色地。我也死了。"}, {"type": "subtitle", "time": 9104.79, "timestamp": "02:31:44", "text": "什么？他们在那儿做什么？"}, {"type": "subtitle", "time": 9106.63, "timestamp": "02:31:46", "text": "他们是在一起聚会吗？"}, {"type": "subtitle", "time": 9109.51, "timestamp": "02:31:49", "text": "我不知道。"}, {"type": "subtitle", "time": 9111.309, "timestamp": "02:31:51", "text": "你好。"}, {"type": "subtitle", "time": 9116.389, "timestamp": "02:31:56", "text": "哦，凯瓦来了。你好，Ka。"}, {"type": "subtitle", "time": 9119.83, "timestamp": "02:31:59", "text": "你好。你好，Kaiwa。"}]
[{"type": "subtitle", "time": 9960.55, "timestamp": "02:46:00", "text": "你们都有游戏音乐吗？某物"}, {"type": "subtitle", "time": 9962.469, "timestamp": "02:46:02", "text": "你穿上它之后，正好掉落50"}, {"type": "subtitle", "time": 9964.79, "timestamp": "02:46:04", "text": "杀人之类的？等等，你为什么这样做？"}, {"type": "subtitle", "time": 9967.91, "timestamp": "02:46:07", "text": "那？等等，原来还有这回事？游戏玩家"}, {"type": "subtitle", "time": 9969.55, "timestamp": "02:46:09", "text": "音乐？"}, {"type": "subtitle", "time": 9971.51, "timestamp": "02:46:11", "text": "维多利亚时代。这是你第一次来这里，"}, {"type": "subtitle", "time": 9973.83, "timestamp": "02:46:13", "text": "正确的？你今天是怎么找到我的？"}, {"type": "subtitle", "time": 9976.63, "timestamp": "02:46:16", "text": "你好吗？哪种？比如，我只"}, {"type": "subtitle", "time": 9978.87, "timestamp": "02:46:18", "text": "当我心情特别低落的时候，我会听音乐。"}, {"type": "subtitle", "time": 9981.03, "timestamp": "02:46:21", "text": "情绪方面之类的。谁的"}, {"type": "subtitle", "time": 9988.15, "timestamp": "02:46:28", "text": "他们在这里吗？我要打电话给你"}, {"type": "subtitle", "time": 9990.63, "timestamp": "02:46:30", "text": "名字叫乔克。呃，你不能叫我乔克。"}, {"type": "subtitle", "time": 9994.23, "timestamp": "02:46:34", "text": "那会更容易些，因为对很多运动员来说……"}, {"type": "subtitle", "time": 10012.03, "timestamp": "02:46:52", "text": "可发音的。"}, {"type": "subtitle", "time": 10015.11, "timestamp": "02:46:55", "text": "萨。好的。是的。"}]
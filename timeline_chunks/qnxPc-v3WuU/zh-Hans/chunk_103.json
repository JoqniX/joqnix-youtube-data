[{"type": "subtitle", "time": 6180.629, "timestamp": "01:43:00", "text": "他们真的喜欢听"}, {"type": "subtitle", "time": 6189.51, "timestamp": "01:43:09", "text": "是的，大家都在走路。不。敌人"}, {"type": "subtitle", "time": 6192.629, "timestamp": "01:43:12", "text": "向下。啊，那时我们都在互相捅刀子。"}, {"type": "subtitle", "time": 6203.91, "timestamp": "01:43:23", "text": "再见了，东西。那东西是什么来着？"}]
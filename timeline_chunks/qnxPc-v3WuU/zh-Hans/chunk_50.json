[{"type": "subtitle", "time": 3000.549, "timestamp": "00:50:00", "text": "连。希望你今天过得愉快。非常感谢"}, {"type": "subtitle", "time": 3001.39, "timestamp": "00:50:01", "text": "所以"}, {"type": "subtitle", "time": 3011.309, "timestamp": "00:50:11", "text": "好的。位于"}, {"type": "subtitle", "time": 3027.549, "timestamp": "00:50:27", "text": "[音乐]"}, {"type": "subtitle", "time": 3033.95, "timestamp": "00:50:33", "text": "忍者，我想这就是全部了。"}, {"type": "subtitle", "time": 3043.71, "timestamp": "00:50:43", "text": "不，我觉得我们没事。是的，我们很好。我们"}, {"type": "subtitle", "time": 3046.87, "timestamp": "00:50:46", "text": "好的。你好。所以，是的，我们要收尾了。"}, {"type": "subtitle", "time": 3049.349, "timestamp": "00:50:49", "text": "就在这里。非常抱歉拖了这么久。"}, {"type": "subtitle", "time": 3053.79, "timestamp": "00:50:53", "text": "一，但非常感谢您光临。"}, {"type": "subtitle", "time": 3057.109, "timestamp": "00:50:57", "text": "今天。请留意摘要。"}, {"type": "subtitle", "time": 3059.75, "timestamp": "00:50:59", "text": "溪流。我会把它发布到社交媒体上。"}]
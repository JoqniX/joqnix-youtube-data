[{"type": "subtitle", "time": 1021.87, "timestamp": "00:17:01", "text": "呃，谁扮演了一些角色"}, {"type": "subtitle", "time": 1024.23, "timestamp": "00:17:04", "text": "游戏？它叫什么名字？他的"}, {"type": "subtitle", "time": 1031.189, "timestamp": "00:17:11", "text": "上帝。啊，他叫什么名字？搞什么鬼？"}, {"type": "subtitle", "time": 1032.11, "timestamp": "00:17:12", "text": "我"}, {"type": "subtitle", "time": 1037.27, "timestamp": "00:17:17", "text": "忘了。我忘了他的名字。什么？哦"}, {"type": "subtitle", "time": 1041.189, "timestamp": "00:17:21", "text": "呃，他们的名字好像是……什么的。"}, {"type": "subtitle", "time": 1043.309, "timestamp": "00:17:23", "text": "与 F。"}, {"type": "subtitle", "time": 1046.71, "timestamp": "00:17:26", "text": "好的。带F的。嗯。是的。"}, {"type": "subtitle", "time": 1050.31, "timestamp": "00:17:30", "text": "是的。所以更像是，呃，所以，呃，他写道"}, {"type": "subtitle", "time": 1053.27, "timestamp": "00:17:33", "text": "比如他网站上的博客之类的东西"}, {"type": "subtitle", "time": 1055.83, "timestamp": "00:17:35", "text": "呃，就是用那个名字，对吧？或者别的什么"}, {"type": "subtitle", "time": 1057.909, "timestamp": "00:17:37", "text": "比如换个名字之类的。呃"}, {"type": "subtitle", "time": 1059.909, "timestamp": "00:17:39", "text": "所以他的社区会更新它，"}, {"type": "subtitle", "time": 1062.87, "timestamp": "00:17:42", "text": "一切。他们出版了指南，"}, {"type": "subtitle", "time": 1066.47, "timestamp": "00:17:46", "text": "游戏相关内容，新游戏，大型多人在线游戏"}, {"type": "subtitle", "time": 1068.87, "timestamp": "00:17:48", "text": "诸如此类的事情。就像"}, {"type": "subtitle", "time": 1071.029, "timestamp": "00:17:51", "text": "社区团体项目之类的"}, {"type": "subtitle", "time": 1072.11, "timestamp": "00:17:52", "text": "那玩意儿，你"}, {"type": "subtitle", "time": 1074.95, "timestamp": "00:17:54", "text": "知道。再说，这也可以算是一种……"}, {"type": "subtitle", "time": 1078.15, "timestamp": "00:17:58", "text": "可以将其视为仓库。在"}]
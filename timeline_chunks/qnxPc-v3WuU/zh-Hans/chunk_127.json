[{"type": "subtitle", "time": 7626.31, "timestamp": "02:07:06", "text": "switchire，你知道那首Jenai的歌吗？"}, {"type": "subtitle", "time": 7628.87, "timestamp": "02:07:08", "text": "呃，我听说过。我忘了是谁"}, {"type": "subtitle", "time": 7631.75, "timestamp": "02:07:11", "text": "它来自哪里？"}, {"type": "subtitle", "time": 7635.589, "timestamp": "02:07:15", "text": "我是从电影里看到的。我"}, {"type": "subtitle", "time": 7639.589, "timestamp": "02:07:19", "text": "忘了。嗯？这是你电影里的吗？我"}, {"type": "subtitle", "time": 7643.109, "timestamp": "02:07:23", "text": "我不知道，但我真的不知道。是，是"}, {"type": "subtitle", "time": 7646.31, "timestamp": "02:07:26", "text": "它就像是咪咪的东西"}, {"type": "subtitle", "time": 7649.83, "timestamp": "02:07:29", "text": "是《神烦警探》（Brooklyn 999）里的吧？布鲁克林 9。"}, {"type": "subtitle", "time": 7651.99, "timestamp": "02:07:31", "text": "啊，"}, {"type": "subtitle", "time": 7654.629, "timestamp": "02:07:34", "text": "复制。你想玩什么游戏？"}, {"type": "subtitle", "time": 7657.51, "timestamp": "02:07:37", "text": "氖。氖。"}, {"type": "subtitle", "time": 7660.709, "timestamp": "02:07:40", "text": "好，我们来玩霓虹吧。"}, {"type": "subtitle", "time": 7662.99, "timestamp": "02:07:42", "text": "我总是给尼奥买东西。我不知道"}, {"type": "subtitle", "time": 7668.83, "timestamp": "02:07:48", "text": "为什么。我为什么这么糟糕？哦，我的"}, {"type": "subtitle", "time": 7672.47, "timestamp": "02:07:52", "text": "上帝。我会玩。没关系。没关系。"}, {"type": "subtitle", "time": 7674.55, "timestamp": "02:07:54", "text": "你最喜欢的经纪人是谁？"}, {"type": "subtitle", "time": 7676.95, "timestamp": "02:07:56", "text": "在阿兰特？"}, {"type": "subtitle", "time": 7678.51, "timestamp": "02:07:58", "text": "我最喜欢的"}]
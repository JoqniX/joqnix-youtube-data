[{"type": "subtitle", "time": 17640.948, "timestamp": "04:54:00", "text": "还有别的什么？是那个游戏吗？更多的"}, {"type": "subtitle", "time": 17644.55, "timestamp": "04:54:04", "text": "就像是令人放松和温暖的"}, {"type": "subtitle", "time": 17647.03, "timestamp": "04:54:07", "text": "你知道，就是那种世界观之类的东西？我为什么是"}, {"type": "subtitle", "time": 17649.03, "timestamp": "04:54:09", "text": "我问你这个吗？我可以直接搜一下。"}, {"type": "chat", "time": 17653.318, "timestamp": "04:54:13", "author": "@Roku-rin", "avatar": "https://yt4.ggpht.com/8LlS_C2IirDMfA5r2V0q5G1kudp8dmG6RQvz_jCAUT3H-esyEgTNPDwrfCXiyX7Undc9UmHNgw=s64-c-k-c0x00ffffff-no-rj", "message": "did u know japan has a lot of flavours in their everyday items like sweets and beverages"}, {"type": "subtitle", "time": 17653.67, "timestamp": "04:54:13", "text": "向上。好的，我会把链接发给你。"}, {"type": "subtitle", "time": 17658.23, "timestamp": "04:54:18", "text": "搜一下就知道了。哦，我看到了。居住"}, {"type": "subtitle", "time": 17659.75, "timestamp": "04:54:19", "text": "模拟。"}, {"type": "subtitle", "time": 17663.55, "timestamp": "04:54:23", "text": "它看起来也像梅萨。"}, {"type": "subtitle", "time": 17670.55, "timestamp": "04:54:30", "text": "那里。你有没有注意到日本有很多"}, {"type": "subtitle", "time": 17672.07, "timestamp": "04:54:32", "text": "他们日常用品中的各种口味，例如"}, {"type": "chat", "time": 17672.335, "timestamp": "04:54:32", "author": "@Roku-rin", "avatar": "https://yt4.ggpht.com/8LlS_C2IirDMfA5r2V0q5G1kudp8dmG6RQvz_jCAUT3H-esyEgTNPDwrfCXiyX7Undc9UmHNgw=s64-c-k-c0x00ffffff-no-rj", "message": "even candies?"}, {"type": "subtitle", "time": 17673.99, "timestamp": "04:54:33", "text": "糖果和饮料？是的，他们确实会这样做。"}, {"type": "subtitle", "time": 17675.75, "timestamp": "04:54:35", "text": "确实如此。"}, {"type": "subtitle", "time": 17679.51, "timestamp": "04:54:39", "text": "有猫咪口味吗？我很抱歉。"}, {"type": "subtitle", "time": 17681.628, "timestamp": "04:54:41", "text": "猫咪口味？"}, {"type": "subtitle", "time": 17685.35, "timestamp": "04:54:45", "text": "不。他们要怎么提取猫的味道呢？"}, {"type": "subtitle", "time": 17688.15, "timestamp": "04:54:48", "text": "那是一只动物。一只可爱的小动物。是的，"}, {"type": "subtitle", "time": 17691.67, "timestamp": "04:54:51", "text": "狗。是啊，我真是太笨了。猫咪口味"}, {"type": "chat", "time": 17692.184, "timestamp": "04:54:52", "author": "@kaiguyniki", "avatar": "https://yt4.ggpht.com/f9aZERpOc1bv1JDUl12ZTXeQ7j1KdXBflkbl-6qlBLzM-hbbEQKWUlPpcJJxTU-qSUwNxrez=s64-c-k-c0x00ffffff-no-rj", "message": "bruh"}, {"type": "subtitle", "time": 17693.99, "timestamp": "04:54:53", "text": "对吧，伙计们？"}, {"type": "subtitle", "time": 17696.55, "timestamp": "04:54:56", "text": "甚至包括糖果。好了，我们继续吧。"}, {"type": "subtitle", "time": 17697.82, "timestamp": "04:54:57", "text": "继续。"}, {"type": "chat", "time": 17697.962, "timestamp": "04:54:57", "author": "@kaiguyniki", "avatar": "https://yt4.ggpht.com/f9aZERpOc1bv1JDUl12ZTXeQ7j1KdXBflkbl-6qlBLzM-hbbEQKWUlPpcJJxTU-qSUwNxrez=s64-c-k-c0x00ffffff-no-rj", "message": "lmao"}]
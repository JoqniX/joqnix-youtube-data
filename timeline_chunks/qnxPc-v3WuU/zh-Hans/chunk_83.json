[{"type": "subtitle", "time": 4981.91, "timestamp": "01:23:01", "text": "知道自己是否想投身这场战斗。"}, {"type": "subtitle", "time": 4985.51, "timestamp": "01:23:05", "text": "你知道，你会赢的"}, {"type": "subtitle", "time": 4988.95, "timestamp": "01:23:08", "text": "战斗或者类似的事情，我的意思是蹲伏"}, {"type": "subtitle", "time": 4990.31, "timestamp": "01:23:10", "text": "就像你决心投入战斗一样"}, {"type": "subtitle", "time": 5001.03, "timestamp": "01:23:21", "text": "蹲伏，对，所以蹲伏实际上是"}, {"type": "subtitle", "time": 5008.91, "timestamp": "01:23:28", "text": "哦，明白了。"}, {"type": "subtitle", "time": 5011.27, "timestamp": "01:23:31", "text": "嗯。你就像是在承诺"}, {"type": "subtitle", "time": 5016.55, "timestamp": "01:23:36", "text": "但我觉得大多数情况下你"}, {"type": "subtitle", "time": 5018.79, "timestamp": "01:23:38", "text": "不应该蹲下，因为你有点……"}, {"type": "subtitle", "time": 5021.55, "timestamp": "01:23:41", "text": "就像脆弱一样，因为你真的无法做到"}, {"type": "subtitle", "time": 5025.11, "timestamp": "01:23:45", "text": "蹲下时向右移动。"}, {"type": "subtitle", "time": 5028.07, "timestamp": "01:23:48", "text": "是的。"}, {"type": "subtitle", "time": 5036.39, "timestamp": "01:23:56", "text": "去。它藏在哪里？蝗虫。哦"}, {"type": "subtitle", "time": 5039.189, "timestamp": "01:23:59", "text": "我的上帝。我不会杀你。"}]
[{"type": "subtitle", "time": 6678.709, "timestamp": "01:51:18", "text": "等等，大家都去吗？他当时和……在一起"}, {"type": "subtitle", "time": 6681.189, "timestamp": "01:51:21", "text": "奥丁。什么？等等，大家都要去吗？"}, {"type": "subtitle", "time": 6683.189, "timestamp": "01:51:23", "text": "左轮手枪之类的？不。对。不，"}, {"type": "subtitle", "time": 6685.189, "timestamp": "01:51:25", "text": "不，不，不，不。好的，好的。只是"}, {"type": "subtitle", "time": 6688.47, "timestamp": "01:51:28", "text": "是的，我要去当警长，而且我觉得我"}, {"type": "subtitle", "time": 6689.95, "timestamp": "01:51:29", "text": "警长"}, {"type": "subtitle", "time": 6693.03, "timestamp": "01:51:33", "text": "也。大概。我在玩游戏。我当时"}, {"type": "subtitle", "time": 6700.149, "timestamp": "01:51:40", "text": "我的天啊。任。是的。你好。你好吗"}, {"type": "subtitle", "time": 6715.189, "timestamp": "01:51:55", "text": "brinder。我的天啊。你该怎么做？"}, {"type": "subtitle", "time": 6716.51, "timestamp": "01:51:56", "text": "赢"}, {"type": "subtitle", "time": 6719.55, "timestamp": "01:51:59", "text": "面对你该如何取胜"}]
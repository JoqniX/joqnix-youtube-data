[{"type": "subtitle", "time": 6540.75, "timestamp": "01:49:00", "text": "我必须赢下那场比赛"}, {"type": "subtitle", "time": 6544.91, "timestamp": "01:49:04", "text": "不知怎么的。我的天啊。我毫无知觉"}, {"type": "subtitle", "time": 6556.87, "timestamp": "01:49:16", "text": "会是我零杀吗？嗯？"}, {"type": "subtitle", "time": 6563.189, "timestamp": "01:49:23", "text": "头脑。我想我仍然应该仍然"}, {"type": "subtitle", "time": 6566.31, "timestamp": "01:49:26", "text": "如果我使用阴凉处，请移动。"}, {"type": "subtitle", "time": 6568.27, "timestamp": "01:49:28", "text": "我"}, {"type": "subtitle", "time": 6589.51, "timestamp": "01:49:49", "text": "用赫氏武器很难杀死任。"}]
[{"type": "subtitle", "time": 6302.629, "timestamp": "01:45:02", "text": "感觉好高啊。你看到了吗？"}, {"type": "subtitle", "time": 6304.51, "timestamp": "01:45:04", "text": "那？我的延迟是"}, {"type": "subtitle", "time": 6308.47, "timestamp": "01:45:08", "text": "比如85岁，为此"}, {"type": "subtitle", "time": 6311.669, "timestamp": "01:45:11", "text": "嗯，我有很多。你们进度落后是因为"}, {"type": "subtitle", "time": 6313.27, "timestamp": "01:45:13", "text": "我的评论。不，不，不。没关系。"}, {"type": "subtitle", "time": 6315.83, "timestamp": "01:45:15", "text": "没关系。别担心。你可以"}, {"type": "subtitle", "time": 6318.55, "timestamp": "01:45:18", "text": "想加入的话还是可以的。是的，我没有"}, {"type": "subtitle", "time": 6321.83, "timestamp": "01:45:21", "text": "关心。没关系。你好。你好。怎样"}, {"type": "subtitle", "time": 6324.95, "timestamp": "01:45:24", "text": "你？邀请我这边的人。是的。"}, {"type": "subtitle", "time": 6327.59, "timestamp": "01:45:27", "text": "是的，没关系。你可以。好的。"}, {"type": "subtitle", "time": 6358.07, "timestamp": "01:45:58", "text": "什么？什么？ Jok senpai 离开了。我的意思是，他是"}]
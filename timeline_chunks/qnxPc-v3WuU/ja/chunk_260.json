[{"type": "subtitle", "time": 15601.349, "timestamp": "04:20:01", "text": "小さなストリーマーか何かですが"}, {"type": "subtitle", "time": 15605.03, "timestamp": "04:20:05", "text": "私は今でも自分を小さなストリーマーだと思っています"}, {"type": "chat", "time": 15605.572, "timestamp": "04:20:05", "author": "@kaiguyniki", "avatar": "https://yt4.ggpht.com/f9aZERpOc1bv1JDUl12ZTXeQ7j1KdXBflkbl-6qlBLzM-hbbEQKWUlPpcJJxTU-qSUwNxrez=s64-c-k-c0x00ffffff-no-rj", "message": "you're thinking too much about it"}, {"type": "subtitle", "time": 15608.469, "timestamp": "04:20:08", "text": "または、誰も私に見せてくれ"}, {"type": "subtitle", "time": 15610.309, "timestamp": "04:20:10", "text": "私はそうは思わない、あなたはそうは思わない"}, {"type": "subtitle", "time": 15613.269, "timestamp": "04:20:13", "text": "小さなリボンのように。私は。うん、"}, {"type": "subtitle", "time": 15616.149, "timestamp": "04:20:16", "text": "その通り。カイ・グニキが言ったように、あなたは"}, {"type": "subtitle", "time": 15618.79, "timestamp": "04:20:18", "text": "それについて考えすぎている。"}, {"type": "subtitle", "time": 15620.63, "timestamp": "04:20:20", "text": "彼が考えすぎだって、みんな分かりますか？"}, {"type": "subtitle", "time": 15622.87, "timestamp": "04:20:22", "text": "皆さん、分かりますか？"}, {"type": "subtitle", "time": 15627.99, "timestamp": "04:20:27", "text": "私は考えすぎる傾向がある。うん。はい。"}, {"type": "subtitle", "time": 15632.309, "timestamp": "04:20:32", "text": "黙れ。俺は考えすぎなんだよ。おお、"}, {"type": "subtitle", "time": 15635.269, "timestamp": "04:20:35", "text": "頭を空っぽにすればいいんだよ。"}, {"type": "chat", "time": 15637.552, "timestamp": "04:20:37", "author": "@kaiguyniki", "avatar": "https://yt4.ggpht.com/f9aZERpOc1bv1JDUl12ZTXeQ7j1KdXBflkbl-6qlBLzM-hbbEQKWUlPpcJJxTU-qSUwNxrez=s64-c-k-c0x00ffffff-no-rj", "message": "just be yourself"}, {"type": "subtitle", "time": 15638.79, "timestamp": "04:20:38", "text": "生きている動物の中で最も幸せなのは金魚です"}, {"type": "subtitle", "time": 15641.189, "timestamp": "04:20:41", "text": "何も考えていないから"}, {"type": "subtitle", "time": 15644.149, "timestamp": "04:20:44", "text": "覚えていない。"}, {"type": "subtitle", "time": 15647.51, "timestamp": "04:20:47", "text": "ありのままの自分でいればいい。その通り。"}, {"type": "subtitle", "time": 15656.07, "timestamp": "04:20:56", "text": "あなたは物事に対して緊張しすぎです、"}, {"type": "subtitle", "time": 15658.63, "timestamp": "04:20:58", "text": "知る？これについて緊張している、"}]
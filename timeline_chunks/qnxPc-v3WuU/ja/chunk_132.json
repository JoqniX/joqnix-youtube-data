[{"type": "subtitle", "time": 7923.31, "timestamp": "02:12:03", "text": "欲望。"}, {"type": "subtitle", "time": 7926.91, "timestamp": "02:12:06", "text": "私が信じてください"}, {"type": "subtitle", "time": 7930.51, "timestamp": "02:12:10", "text": "言いたい"}, {"type": "subtitle", "time": 7934.39, "timestamp": "02:12:14", "text": "それ。それはこうだ。"}, {"type": "subtitle", "time": 7935.99, "timestamp": "02:12:15", "text": "あなたにとって、その痛みとは何ですか？冗談だよ"}, {"type": "subtitle", "time": 7938.31, "timestamp": "02:12:18", "text": "先輩。あなたは私にソフトドリンクが"}, {"type": "subtitle", "time": 7942.149, "timestamp": "02:12:22", "text": "好き？自然。はい。"}, {"type": "subtitle", "time": 7949.99, "timestamp": "02:12:29", "text": "では、あなたの好きな果物を当ててみましょう。"}, {"type": "subtitle", "time": 7958.629, "timestamp": "02:12:38", "text": "ああ、彼らはそうだ。何てことだ。私たちは皆来た"}, {"type": "subtitle", "time": 7961.189, "timestamp": "02:12:41", "text": "Aへ。"}, {"type": "subtitle", "time": 7968.87, "timestamp": "02:12:48", "text": "飛び降りる時が来た。"}, {"type": "subtitle", "time": 7978.79, "timestamp": "02:12:58", "text": "いいえ。"}]
[{"type": "subtitle", "time": 9540.55, "timestamp": "02:39:00", "text": "うん、チ。私たちは何をプレイするのですか？何でも"}, {"type": "subtitle", "time": 9543.429, "timestamp": "02:39:03", "text": "あなたが望むもの。スパイクラッシュ、私たちは"}, {"type": "subtitle", "time": 9545.11, "timestamp": "02:39:05", "text": "試す。"}, {"type": "subtitle", "time": 9546.87, "timestamp": "02:39:06", "text": "お好きなものを何でも。つまり、あなたは"}, {"type": "subtitle", "time": 9551.11, "timestamp": "02:39:11", "text": "リーダー。ああ、わかりました。まずは"}, {"type": "subtitle", "time": 9553.19, "timestamp": "02:39:13", "text": "申請とエスカレーションを行いました"}, {"type": "subtitle", "time": 9554.87, "timestamp": "02:39:14", "text": "以前。"}, {"type": "subtitle", "time": 9562.51, "timestamp": "02:39:22", "text": "では、どのように"}, {"type": "subtitle", "time": 9565.19, "timestamp": "02:39:25", "text": "ジュカ、それについてどう思う？"}, {"type": "subtitle", "time": 9567.23, "timestamp": "02:39:27", "text": "先輩？"}, {"type": "subtitle", "time": 9572.389, "timestamp": "02:39:32", "text": "えっと、何を考えてるんですか？今日について考えてみてください。"}, {"type": "subtitle", "time": 9575.75, "timestamp": "02:39:35", "text": "今日？はい、しばらくの間、たくさんおしっこをしました"}, {"type": "subtitle", "time": 9578.23, "timestamp": "02:39:38", "text": "理由。あなたはストリーミング配信をしていました。あなたは"}, {"type": "subtitle", "time": 9582.15, "timestamp": "02:39:42", "text": "以前もストリーミング配信してましたよね？はい。"}, {"type": "subtitle", "time": 9584.87, "timestamp": "02:39:44", "text": "この男を見てください。彼はストリーミング配信していた"}, {"type": "subtitle", "time": 9586.67, "timestamp": "02:39:46", "text": "朝と"}, {"type": "subtitle", "time": 9590.79, "timestamp": "02:39:50", "text": "それから、確かいくらかかったと思いますか？そして"}, {"type": "subtitle", "time": 9592.63, "timestamp": "02:39:52", "text": "30分休憩か1時間休憩。私"}, {"type": "subtitle", "time": 9595.11, "timestamp": "02:39:55", "text": "覚えていない。そして彼は"}, {"type": "subtitle", "time": 9596.79, "timestamp": "02:39:56", "text": "「ああ、また配信してるよ」"}]
[{"type": "subtitle", "time": 3122.349, "timestamp": "00:52:02", "text": "[音楽]"}, {"type": "subtitle", "time": 3126.39, "timestamp": "00:52:06", "text": "上。皆さん本当にありがとうございました"}, {"type": "subtitle", "time": 3130.549, "timestamp": "00:52:10", "text": "今日立ち寄りました。すべての新しいコネラー、"}, {"type": "subtitle", "time": 3132.549, "timestamp": "00:52:12", "text": "別名コンサートプレート、ご来場ありがとうございました"}, {"type": "subtitle", "time": 3135.43, "timestamp": "00:52:15", "text": "による。もしあなたが楽しんで、もしあなたが"}, {"type": "subtitle", "time": 3138.47, "timestamp": "00:52:18", "text": "ご覧になった方は、よろしければぜひチャンネル登録してください。"}, {"type": "subtitle", "time": 3141.23, "timestamp": "00:52:21", "text": "それでおしまい。強制はしない。しかし"}, {"type": "subtitle", "time": 3144.549, "timestamp": "00:52:24", "text": "うん、でもチャットを変えるかもしれない"}, {"type": "subtitle", "time": 3147.15, "timestamp": "00:52:27", "text": "参加モード"}, {"type": "subtitle", "time": 3151.349, "timestamp": "00:52:31", "text": "今後は購読者限定となります。"}, {"type": "subtitle", "time": 3153.75, "timestamp": "00:52:33", "text": "将来、それは私が感じるからです"}, {"type": "subtitle", "time": 3158.309, "timestamp": "00:52:38", "text": "ほら、もしそれが私が望む方法なら"}, {"type": "subtitle", "time": 3161.589, "timestamp": "00:52:41", "text": "みんなのために取っておくけど、私も"}, {"type": "subtitle", "time": 3165.19, "timestamp": "00:52:45", "text": "人々を見て、私は人々が"}, {"type": "subtitle", "time": 3166.75, "timestamp": "00:52:46", "text": "彼らの"}, {"type": "subtitle", "time": 3169.91, "timestamp": "00:52:49", "text": "少し時間があれば"}, {"type": "subtitle", "time": 3172.87, "timestamp": "00:52:52", "text": "興味あり、興味あり、それでは"}, {"type": "subtitle", "time": 3175.349, "timestamp": "00:52:55", "text": "購読するだけのものですね。"}, {"type": "subtitle", "time": 3177.309, "timestamp": "00:52:57", "text": "そういう感じのものを追っていきたい"}]
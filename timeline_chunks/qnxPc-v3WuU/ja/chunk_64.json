[{"type": "subtitle", "time": 3841.91, "timestamp": "01:04:01", "text": "うん。すごくかわいいね。ある意味では。それは"}, {"type": "subtitle", "time": 3844.349, "timestamp": "01:04:04", "text": "とてもかわいい。"}, {"type": "subtitle", "time": 3846.91, "timestamp": "01:04:06", "text": "Aは、とても"}, {"type": "subtitle", "time": 3849.589, "timestamp": "01:04:09", "text": "かわいい。わかった。えっと、もうすぐ終わります"}, {"type": "subtitle", "time": 3853.109, "timestamp": "01:04:13", "text": "複数の時計を一緒に見るようなもの。えっと、君たちは"}, {"type": "subtitle", "time": 3857.549, "timestamp": "01:04:17", "text": "説明を確認してください"}, {"type": "subtitle", "time": 3859.87, "timestamp": "01:04:19", "text": "三つ、"}, {"type": "subtitle", "time": 3861.63, "timestamp": "01:04:21", "text": "二、"}, {"type": "subtitle", "time": 3865.75, "timestamp": "01:04:25", "text": "1つ。さあ行こう。こんにちは。つまり、説明は"}, {"type": "subtitle", "time": 3868.39, "timestamp": "01:04:28", "text": "更新する必要があります。えっと、私とザックは"}, {"type": "subtitle", "time": 3871.349, "timestamp": "01:04:31", "text": "現在配信中です。私たちは、えーと、"}, {"type": "subtitle", "time": 3874.549, "timestamp": "01:04:34", "text": "一緒にヴァレリンをプレイしています。彼女は"}, {"type": "subtitle", "time": 3876.87, "timestamp": "01:04:36", "text": "また、練習場で練習しています"}, {"type": "subtitle", "time": 3878.99, "timestamp": "01:04:38", "text": "まさに今、この瞬間に。彼女はまた"}, {"type": "subtitle", "time": 3881.43, "timestamp": "01:04:41", "text": "ストリーミング配信。まあ、そうですね。うん。こんにちは、ハッシュ。"}, {"type": "subtitle", "time": 3884.19, "timestamp": "01:04:44", "text": "お元気ですか？お元気でお過ごしでしょうか"}, {"type": "subtitle", "time": 3887.109, "timestamp": "01:04:47", "text": "良い。元気ですか？戦闘はどうでしたか？"}, {"type": "subtitle", "time": 3888.789, "timestamp": "01:04:48", "text": "昨日のセクション？私は遊んでいました"}, {"type": "subtitle", "time": 3891.589, "timestamp": "01:04:51", "text": "友達。あなたは勝ちましたか？優勝を祈っています。私"}, {"type": "subtitle", "time": 3898.789, "timestamp": "01:04:58", "text": "ストリーム。そうそう。そうそう。あなたは知っていますか"}]
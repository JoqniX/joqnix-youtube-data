[{"type": "subtitle", "time": 3602.51, "timestamp": "01:00:02", "text": "最高。それでは、"}, {"type": "subtitle", "time": 3605.43, "timestamp": "01:00:05", "text": "最高。あぁ、ツイートするのを忘れてた。それでは、"}, {"type": "subtitle", "time": 3607.309, "timestamp": "01:00:07", "text": "ただやるだけ"}, {"type": "subtitle", "time": 3610.23, "timestamp": "01:00:10", "text": "それ。ごめんなさい。では、えーと、"}, {"type": "subtitle", "time": 3612.15, "timestamp": "01:00:12", "text": "ちょっと待ってください、ちょっと待ってください、私が直します。それで、"}, {"type": "subtitle", "time": 3614.789, "timestamp": "01:00:14", "text": "お元気ですか？ヘラクレス。元気ですか"}, {"type": "subtitle", "time": 3617.67, "timestamp": "01:00:17", "text": "何をしているんだ、エドワード？いらっしゃいませ。いらっしゃいませ。調子はどうですか？"}, {"type": "subtitle", "time": 3618.67, "timestamp": "01:00:18", "text": "君たち"}, {"type": "subtitle", "time": 3636.15, "timestamp": "01:00:36", "text": "[音楽]"}, {"type": "subtitle", "time": 3639.99, "timestamp": "01:00:39", "text": "こんにちは。こんにちは。行く。行く。えっと、私の家族は"}, {"type": "subtitle", "time": 3642.549, "timestamp": "01:00:42", "text": "客のせいで中断された。しかし"}, {"type": "subtitle", "time": 3645.03, "timestamp": "01:00:45", "text": "ええ、それで私たちは"}, {"type": "subtitle", "time": 3648.309, "timestamp": "01:00:48", "text": "ヴァレラントをプレイする予定ですか。はい。"}, {"type": "subtitle", "time": 3655.109, "timestamp": "01:00:55", "text": "より良い。ああ、忘れちゃう"}, {"type": "subtitle", "time": 3659.51, "timestamp": "01:00:59", "text": "それ。ちょっと待って。ああ神様、私はとてもとても"}]
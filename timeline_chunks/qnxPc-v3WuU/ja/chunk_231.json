[{"type": "subtitle", "time": 13862.15, "timestamp": "03:51:02", "text": "ああ、くそったれ。それは良くない。全てではない。"}, {"type": "subtitle", "time": 13866.79, "timestamp": "03:51:06", "text": "ジョー、全てを学びなさい。こんにちは。こんにちは。"}, {"type": "subtitle", "time": 13868.309, "timestamp": "03:51:08", "text": "デートには行けない、"}, {"type": "subtitle", "time": 13870.79, "timestamp": "03:51:10", "text": "何か。結婚式には出席できません。"}, {"type": "subtitle", "time": 13873.269, "timestamp": "03:51:13", "text": "お前のクソみたいな新婚旅行。"}, {"type": "subtitle", "time": 13875.67, "timestamp": "03:51:15", "text": "何てことだ。うんこをしているとき、"}, {"type": "subtitle", "time": 13878.15, "timestamp": "03:51:18", "text": "行くよ。でもいつもそこにいて、"}, {"type": "subtitle", "time": 13880.07, "timestamp": "03:51:20", "text": "男。"}, {"type": "subtitle", "time": 13882.71, "timestamp": "03:51:22", "text": "ウェットティッシュをあげるだけでいいよ。ここ"}, {"type": "subtitle", "time": 13885.75, "timestamp": "03:51:25", "text": "行くぞ、相棒。"}, {"type": "subtitle", "time": 13887.83, "timestamp": "03:51:27", "text": "まあ、そうですね。ええと、とにかく、Yeah に戻ります。"}, {"type": "subtitle", "time": 13890.75, "timestamp": "03:51:30", "text": "うん。元の軌道に戻った。"}, {"type": "subtitle", "time": 13892.99, "timestamp": "03:51:32", "text": "ええ、そうですね"}, {"type": "subtitle", "time": 13896.87, "timestamp": "03:51:36", "text": "えっと、私は全員を理解できないような気がします"}, {"type": "subtitle", "time": 13899.189, "timestamp": "03:51:39", "text": "なぜならほとんどの人は"}, {"type": "subtitle", "time": 13903.59, "timestamp": "03:51:43", "text": "ビシープラス古いものから"}, {"type": "subtitle", "time": 13907.429, "timestamp": "03:51:47", "text": "これはいくつか手に入れると思う"}, {"type": "subtitle", "time": 13909.83, "timestamp": "03:51:49", "text": "でも、人々にこう思われたくはない"}, {"type": "subtitle", "time": 13912.79, "timestamp": "03:51:52", "text": "そう、ジョックが私を最初の"}, {"type": "subtitle", "time": 13914.71, "timestamp": "03:51:54", "text": "2番目は彼が招待しなかったような"}, {"type": "subtitle", "time": 13917.349, "timestamp": "03:51:57", "text": "結局私は"}, {"type": "subtitle", "time": 13919.83, "timestamp": "03:51:59", "text": "全員を中に入れたいけど、全員を入れることはできない"}]
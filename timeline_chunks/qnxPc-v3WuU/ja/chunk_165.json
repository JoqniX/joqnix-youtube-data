[{"type": "subtitle", "time": 9916.71, "timestamp": "02:45:16", "text": "州のブルドッグ。私は遊んでいません"}, {"type": "subtitle", "time": 9919.75, "timestamp": "02:45:19", "text": "ブルドッグはそれほどまでに。私は手に入れる必要がある"}, {"type": "subtitle", "time": 9922.309, "timestamp": "02:45:22", "text": "慣れたよ。他のものって何？"}, {"type": "subtitle", "time": 9923.07, "timestamp": "02:45:23", "text": "銃"}, {"type": "subtitle", "time": 9925.309, "timestamp": "02:45:25", "text": "名前？ではない"}, {"type": "subtitle", "time": 9928.95, "timestamp": "02:45:28", "text": "スペクタ。名前を忘れてしまった。ああ神様、私は"}, {"type": "subtitle", "time": 9940.63, "timestamp": "02:45:40", "text": "みんなはどこに隠れているんだ？"}, {"type": "subtitle", "time": 9945.59, "timestamp": "02:45:45", "text": "敵はあと一体。彼を見て。"}, {"type": "subtitle", "time": 9954.429, "timestamp": "02:45:54", "text": "ニース。私の"}, {"type": "subtitle", "time": 9957.83, "timestamp": "02:45:57", "text": "神。また、ゲーマーの投稿についてですが、"}]
[{"type": "subtitle", "time": 7866.99, "timestamp": "02:11:06", "text": "何てことだ。中。なぜ彼らは行くのか"}, {"type": "subtitle", "time": 7870.069, "timestamp": "02:11:10", "text": "牡羊座？何？"}, {"type": "subtitle", "time": 7906.069, "timestamp": "02:11:46", "text": "NT。"}, {"type": "subtitle", "time": 7909.75, "timestamp": "02:11:49", "text": "大丈夫。私たちは遊び方がわからない"}, {"type": "subtitle", "time": 7912.31, "timestamp": "02:11:52", "text": "夜。"}, {"type": "subtitle", "time": 7918.669, "timestamp": "02:11:58", "text": "君は僕の情熱の源だ。あなたは私の炎です。の"}]
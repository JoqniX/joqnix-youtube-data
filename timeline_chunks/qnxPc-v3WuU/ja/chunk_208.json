[{"type": "subtitle", "time": 12480.15, "timestamp": "03:28:00", "text": "混乱状態だ。とてもたくさん。とんでもない混乱だ。その"}, {"type": "subtitle", "time": 12487.67, "timestamp": "03:28:07", "text": "実際にサイト上にいた人数はどれくらいだったのか"}, {"type": "subtitle", "time": 12489.349, "timestamp": "03:28:09", "text": "すでに？"}, {"type": "subtitle", "time": 12492.55, "timestamp": "03:28:12", "text": "素早い。一体どういうことだ？うん、"}, {"type": "subtitle", "time": 12495.03, "timestamp": "03:28:15", "text": "とても速かった。"}, {"type": "subtitle", "time": 12497.11, "timestamp": "03:28:17", "text": "夢。"}, {"type": "subtitle", "time": 12500.07, "timestamp": "03:28:20", "text": "買えます。ああ、気にしないで。私は買うことができます"}, {"type": "subtitle", "time": 12501.75, "timestamp": "03:28:21", "text": "売る。たくさんあります。神様ありがとう"}, {"type": "subtitle", "time": 12505.19, "timestamp": "03:28:25", "text": "そこには植えなかった。"}, {"type": "subtitle", "time": 12507.11, "timestamp": "03:28:27", "text": "えー、ジョー、シールドは買えるよ。彼はそうしない"}, {"type": "subtitle", "time": 12510.07, "timestamp": "03:28:30", "text": "シールドを持っている。そうそう。ただただ"}, {"type": "subtitle", "time": 12520.389, "timestamp": "03:28:40", "text": "手榴弾。"}, {"type": "subtitle", "time": 12528.389, "timestamp": "03:28:48", "text": "はぁ？くそ。"}, {"type": "subtitle", "time": 12532.63, "timestamp": "03:28:52", "text": "彼女を後押ししてもいいよ。いや。ああ、なんてことだ。休む"}]
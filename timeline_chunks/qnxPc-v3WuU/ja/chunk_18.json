[{"type": "subtitle", "time": 1080.07, "timestamp": "00:18:00", "text": "その倉庫では、"}, {"type": "subtitle", "time": 1084.15, "timestamp": "00:18:04", "text": "グッズとかそういう類ですよね？それで、それで"}, {"type": "subtitle", "time": 1085.63, "timestamp": "00:18:05", "text": "のように"}, {"type": "subtitle", "time": 1088.789, "timestamp": "00:18:08", "text": "それ。そして正直に言うと、私は"}, {"type": "subtitle", "time": 1092.47, "timestamp": "00:18:12", "text": "商品だよ、男。ほら、私が"}, {"type": "subtitle", "time": 1095.35, "timestamp": "00:18:15", "text": "音楽、音楽関連、そして"}, {"type": "subtitle", "time": 1097.95, "timestamp": "00:18:17", "text": "DJとかコンサートとか"}, {"type": "subtitle", "time": 1101.19, "timestamp": "00:18:21", "text": "心の底では、こんなものを作りたかったんです"}, {"type": "subtitle", "time": 1105.549, "timestamp": "00:18:25", "text": "最高の新世代のような完璧な"}, {"type": "subtitle", "time": 1107.83, "timestamp": "00:18:27", "text": "人々が身に着けることができる商品。それから"}, {"type": "subtitle", "time": 1109.669, "timestamp": "00:18:29", "text": "私は思った、ああ、待て、私はそれを作らなければならない"}, {"type": "subtitle", "time": 1111.35, "timestamp": "00:18:31", "text": "普段着にも適しています。そしてそれは"}, {"type": "subtitle", "time": 1114.07, "timestamp": "00:18:34", "text": "こんなハイブリッドみたいなのが変だ"}, {"type": "subtitle", "time": 1115.99, "timestamp": "00:18:35", "text": "あなたが着ている服"}, {"type": "subtitle", "time": 1118.47, "timestamp": "00:18:38", "text": "外。人々はあなたを見ているでしょう。"}, {"type": "subtitle", "time": 1124.83, "timestamp": "00:18:44", "text": "待って。えっと、"}, {"type": "subtitle", "time": 1127.99, "timestamp": "00:18:47", "text": "うん。えっと、ストリーム配信中に撮影したと思うんだけど、"}, {"type": "subtitle", "time": 1130.31, "timestamp": "00:18:50", "text": "右？えっと、その言葉は何だったかな"}, {"type": "subtitle", "time": 1132.19, "timestamp": "00:18:52", "text": "誰かが言った"}, {"type": "subtitle", "time": 1136.83, "timestamp": "00:18:56", "text": "時間？ハイパーポップ。いいえ。えっと、"}]
[{"type": "subtitle", "time": 9660.429, "timestamp": "02:41:00", "text": "気は"}, {"type": "subtitle", "time": 9664.27, "timestamp": "02:41:04", "text": "ち。そうそう。あなたが言う"}, {"type": "subtitle", "time": 9667.59, "timestamp": "02:41:07", "text": "インドでの chi は、ああ、そうですね。その"}, {"type": "subtitle", "time": 9672.23, "timestamp": "02:41:12", "text": "悪い悪い、人々が言うチのように"}, {"type": "subtitle", "time": 9674.23, "timestamp": "02:41:14", "text": "何かがどれほど悪いかを表現するために"}, {"type": "subtitle", "time": 9681.75, "timestamp": "02:41:21", "text": "そして、終わったことは終わったことだ。"}, {"type": "subtitle", "time": 9685.99, "timestamp": "02:41:25", "text": "真のゲーマーは疲れない。"}, {"type": "subtitle", "time": 9689.51, "timestamp": "02:41:29", "text": "うん。えっと、私は疑問に思っているのですが"}, {"type": "subtitle", "time": 9692.71, "timestamp": "02:41:32", "text": "興味があります。ゲーマーポーズはありますか？"}, {"type": "subtitle", "time": 9695.51, "timestamp": "02:41:35", "text": "ゲーマーポーズ？ゲーマーポーズって何？だから"}, {"type": "subtitle", "time": 9697.91, "timestamp": "02:41:37", "text": "ゲーマーのポーズは、猫背のような感じ"}, {"type": "subtitle", "time": 9700.79, "timestamp": "02:41:40", "text": "後ろ、ほら、頭はこんな感じ"}, {"type": "subtitle", "time": 9703.51, "timestamp": "02:41:43", "text": "前方に向いていて、胴体は"}, {"type": "subtitle", "time": 9707.349, "timestamp": "02:41:47", "text": "少し後退した感じ。ああ、座る"}, {"type": "subtitle", "time": 9709.51, "timestamp": "02:41:49", "text": "モニターをじっと見つめている"}, {"type": "subtitle", "time": 9711.11, "timestamp": "02:41:51", "text": "近い？うん。うん。それともあなたは座りますか"}, {"type": "subtitle", "time": 9712.83, "timestamp": "02:41:52", "text": "真っ直ぐ？"}, {"type": "subtitle", "time": 9715.429, "timestamp": "02:41:55", "text": "ええと、私は時々猫背になりますが、"}, {"type": "subtitle", "time": 9718.15, "timestamp": "02:41:58", "text": "集中しているときは、身を乗り出して"}]
[{"type": "subtitle", "time": 2042.07, "timestamp": "00:34:02", "text": "4回さまざまなvの種類異なる"}, {"type": "subtitle", "time": 2045.47, "timestamp": "00:34:05", "text": "エネルギーレベルは正しいです"}, {"type": "subtitle", "time": 2048.19, "timestamp": "00:34:08", "text": "混沌とした"}, {"type": "subtitle", "time": 2053.75, "timestamp": "00:34:13", "text": "1つは混沌とした高エネルギーで、2つは"}, {"type": "subtitle", "time": 2057.03, "timestamp": "00:34:17", "text": "穏やかなエネルギー３は中立のようなもの"}, {"type": "subtitle", "time": 2060.27, "timestamp": "00:34:20", "text": "エネルギー4は"}, {"type": "subtitle", "time": 2063.55, "timestamp": "00:34:23", "text": "でも、落ち込んでいるような感じだったと思います"}, {"type": "subtitle", "time": 2072.829, "timestamp": "00:34:32", "text": "バカ。あなたは"}, {"type": "subtitle", "time": 2075.95, "timestamp": "00:34:35", "text": "遅い。よし。良い一日を過ごされたことを願っています"}, {"type": "subtitle", "time": 2078.349, "timestamp": "00:34:38", "text": "寝る。良い"}, {"type": "subtitle", "time": 2086.149, "timestamp": "00:34:46", "text": "お父さんがパット。よく眠れたことを願っています。希望"}, {"type": "subtitle", "time": 2088.349, "timestamp": "00:34:48", "text": "よく眠れたね。"}, {"type": "subtitle", "time": 2091.55, "timestamp": "00:34:51", "text": "きっとたくさん夜更かししたんだろうな"}, {"type": "subtitle", "time": 2096.109, "timestamp": "00:34:56", "text": "昨日だよ。バカが言った"}, {"type": "subtitle", "time": 2097.51, "timestamp": "00:34:57", "text": "寝る。"}, {"type": "subtitle", "time": 2099.069, "timestamp": "00:34:59", "text": "[音楽]"}]
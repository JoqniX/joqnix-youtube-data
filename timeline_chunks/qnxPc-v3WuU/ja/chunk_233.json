[{"type": "subtitle", "time": 13981.269, "timestamp": "03:53:01", "text": "他人のエネルギーとか、そういうもの全て。"}, {"type": "subtitle", "time": 13983.59, "timestamp": "03:53:03", "text": "彼らに話させたり、いろいろとやらせたり。たくさんの"}, {"type": "subtitle", "time": 13987.349, "timestamp": "03:53:07", "text": "物事、ですよね？彼らに発言させるなど。"}, {"type": "subtitle", "time": 13989.91, "timestamp": "03:53:09", "text": "たくさんのこと。"}, {"type": "subtitle", "time": 13994.63, "timestamp": "03:53:14", "text": "とても痛い。おい、痛いんだよ"}, {"type": "subtitle", "time": 13996.55, "timestamp": "03:53:16", "text": "その時間を確保しなければならない。あなたがしなければならない"}, {"type": "subtitle", "time": 13997.83, "timestamp": "03:53:17", "text": "相手に尋ねる"}, {"type": "subtitle", "time": 13999.67, "timestamp": "03:53:19", "text": "現時点で入手可能か、入手できないか"}, {"type": "subtitle", "time": 14001.67, "timestamp": "03:53:21", "text": "現時点で入手可能です。でも、"}, {"type": "subtitle", "time": 14003.91, "timestamp": "03:53:23", "text": "前回は？そしてもう一人は"}, {"type": "subtitle", "time": 14005.67, "timestamp": "03:53:25", "text": "他の時間帯には利用できません。そして"}, {"type": "subtitle", "time": 14008.389, "timestamp": "03:53:28", "text": "ただ、良いんです。うん。"}, {"type": "subtitle", "time": 14012.389, "timestamp": "03:53:32", "text": "ただただ悲しい。うん。"}, {"type": "subtitle", "time": 14015.429, "timestamp": "03:53:35", "text": "つまり、唯一の集団崩壊は"}, {"type": "subtitle", "time": 14018.269, "timestamp": "03:53:38", "text": "実際に起こる"}, {"type": "subtitle", "time": 14021.59, "timestamp": "03:53:41", "text": "カオス主義はあなたの普通のようなものです"}, {"type": "subtitle", "time": 14023.91, "timestamp": "03:53:43", "text": "友達、ほら、君が"}, {"type": "subtitle", "time": 14027.11, "timestamp": "03:53:47", "text": "実際に一緒に過ごすよ、うん、できるよ"}, {"type": "subtitle", "time": 14030.71, "timestamp": "03:53:50", "text": "ハングアウトの時間にストリーミングするだけで"}, {"type": "subtitle", "time": 14033.03, "timestamp": "03:53:53", "text": "その通り。その通り。"}, {"type": "subtitle", "time": 14037.189, "timestamp": "03:53:57", "text": "そして、それについて考えると、"}]
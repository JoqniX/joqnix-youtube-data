[{"type": "subtitle", "time": 4440.55, "timestamp": "01:14:00", "text": "協力者は文字通り彼を脅迫した。それでジェン、"}, {"type": "subtitle", "time": 4443.31, "timestamp": "01:14:03", "text": "あなたは"}, {"type": "subtitle", "time": 4446.95, "timestamp": "01:14:06", "text": "えっと、待って、私は何も言ってないよ。あなた"}, {"type": "subtitle", "time": 4456.709, "timestamp": "01:14:16", "text": "はい。"}, {"type": "subtitle", "time": 4460.189, "timestamp": "01:14:20", "text": "君はウォーミングアップしたね。ええ、暖まりました"}, {"type": "subtitle", "time": 4462.95, "timestamp": "01:14:22", "text": "上。でも、ウォーミングアップは必要だろうか？私はしない"}, {"type": "subtitle", "time": 4465.99, "timestamp": "01:14:25", "text": "ウォーミングアップは必須です。暖かいのはどうですか？"}, {"type": "subtitle", "time": 4468.31, "timestamp": "01:14:28", "text": "UPS？つまり、あなたが"}, {"type": "subtitle", "time": 4471.669, "timestamp": "01:14:31", "text": "それらはやらないでください。でも、そうするべきだと思うよ。"}, {"type": "subtitle", "time": 4474.149, "timestamp": "01:14:34", "text": "待って、これって既にやったことあるよ。なぜ私は"}, {"type": "subtitle", "time": 4477.59, "timestamp": "01:14:37", "text": "またこれやってるの？"}, {"type": "subtitle", "time": 4480.63, "timestamp": "01:14:40", "text": "私にもわからない。ゲームで上がったので"}, {"type": "subtitle", "time": 4482.87, "timestamp": "01:14:42", "text": "大丈夫。"}, {"type": "subtitle", "time": 4485.35, "timestamp": "01:14:45", "text": "わかった。"}, {"type": "subtitle", "time": 4488.39, "timestamp": "01:14:48", "text": "我々ができることといえば、デスマッチを行うことだ。"}, {"type": "subtitle", "time": 4490.149, "timestamp": "01:14:50", "text": "あなたはデスマッチに賛成ですか？やってみよう"}, {"type": "subtitle", "time": 4491.63, "timestamp": "01:14:51", "text": "カスタムデス"}, {"type": "subtitle", "time": 4495.11, "timestamp": "01:14:55", "text": "試合が終わったら、本当の死を演出できる。"}]
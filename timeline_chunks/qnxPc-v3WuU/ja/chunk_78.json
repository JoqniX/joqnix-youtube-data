[{"type": "subtitle", "time": 4696.55, "timestamp": "01:18:16", "text": "彼ら。ちょっと用事があって出かけます。おお"}, {"type": "subtitle", "time": 4712.229, "timestamp": "01:18:32", "text": "何てことだ。ニース。"}, {"type": "subtitle", "time": 4715.63, "timestamp": "01:18:35", "text": "それが私の唯一の殺害だった。彼らは"}, {"type": "subtitle", "time": 4718.95, "timestamp": "01:18:38", "text": "良い。彼らは良い人たちだ。まるで彼らが"}, {"type": "subtitle", "time": 4721.35, "timestamp": "01:18:41", "text": "良いプレーを。"}, {"type": "subtitle", "time": 4724.63, "timestamp": "01:18:44", "text": "あなたは平凡ではない。来て。あなたは"}, {"type": "subtitle", "time": 4727.11, "timestamp": "01:18:47", "text": "平凡とは程遠い。教えてあげよう"}, {"type": "subtitle", "time": 4731.99, "timestamp": "01:18:51", "text": "私は隠れているので、あなたのオンライン状態は見えません"}]
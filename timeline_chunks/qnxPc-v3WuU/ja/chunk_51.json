[{"type": "subtitle", "time": 3061.23, "timestamp": "00:51:01", "text": "メディア。"}, {"type": "subtitle", "time": 3065.99, "timestamp": "00:51:05", "text": "それでは、寝ます。実際には、"}, {"type": "subtitle", "time": 3069.309, "timestamp": "00:51:09", "text": "あるいは、今日はストリームではないかもしれません。"}, {"type": "subtitle", "time": 3072.79, "timestamp": "00:51:12", "text": "はい、延期していることは承知しています"}, {"type": "subtitle", "time": 3075.829, "timestamp": "00:51:15", "text": "さらに言えば、それでも健康は重要だ。"}, {"type": "subtitle", "time": 3077.63, "timestamp": "00:51:17", "text": "私はストリーミング配信だけをするべきだと思う"}, {"type": "subtitle", "time": 3081.43, "timestamp": "00:51:21", "text": "それ。上手くなったら配信時間も長くなります"}, {"type": "subtitle", "time": 3083.27, "timestamp": "00:51:23", "text": "より健康的な感じ。"}, {"type": "subtitle", "time": 3085.549, "timestamp": "00:51:25", "text": "そうでなければストリーミング配信できる"}, {"type": "subtitle", "time": 3088.71, "timestamp": "00:51:28", "text": "今日は体も疲れてきた"}, {"type": "subtitle", "time": 3089.71, "timestamp": "00:51:29", "text": "そして"}, {"type": "subtitle", "time": 3093.27, "timestamp": "00:51:33", "text": "ただ寝て横になるだけ"}, {"type": "subtitle", "time": 3095.309, "timestamp": "00:51:35", "text": "横になって眠りにつく"}, {"type": "subtitle", "time": 3102.71, "timestamp": "00:51:42", "text": "ええ、でもそれでもありがとう"}, {"type": "subtitle", "time": 3105.349, "timestamp": "00:51:45", "text": "今、私のそばに来ます。とても楽しかったです。"}, {"type": "subtitle", "time": 3107.51, "timestamp": "00:51:47", "text": "うん。素晴らしい生産的な一日をお過ごしください"}, {"type": "subtitle", "time": 3111.19, "timestamp": "00:51:51", "text": "月曜日がやってくる。わかった。"}, {"type": "subtitle", "time": 3112.95, "timestamp": "00:51:52", "text": "というわけで、これで終わりにします。"}]
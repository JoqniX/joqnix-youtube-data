[{"type": "subtitle", "time": 9482.75, "timestamp": "02:38:02", "text": "どちらが勝つだろうか？道に迷う"}, {"type": "subtitle", "time": 9490.71, "timestamp": "02:38:10", "text": "ああ、彼女はインド人だ。はい、彼女はGGです。 GG。"}, {"type": "subtitle", "time": 9494.23, "timestamp": "02:38:14", "text": "はい、彼女はインド人ユーチューバーです。はい、"}, {"type": "subtitle", "time": 9498.07, "timestamp": "02:38:18", "text": "会社。うん。うん。うん。ボン"}, {"type": "subtitle", "time": 9499.71, "timestamp": "02:38:19", "text": "ボン。"}, {"type": "subtitle", "time": 9517.83, "timestamp": "02:38:37", "text": "待って、あの歌聞いた？"}, {"type": "subtitle", "time": 9520.23, "timestamp": "02:38:40", "text": "それは歌だったの、トリクシー？歌があった"}, {"type": "subtitle", "time": 9523.429, "timestamp": "02:38:43", "text": "彼らが、まあ、誰かが作ったものだ。私"}, {"type": "subtitle", "time": 9525.469, "timestamp": "02:38:45", "text": "引っ張った"}, {"type": "subtitle", "time": 9528.469, "timestamp": "02:38:48", "text": "チチなんとか。ええ、歌があります"}, {"type": "subtitle", "time": 9530.27, "timestamp": "02:38:50", "text": "の"}, {"type": "subtitle", "time": 9534.15, "timestamp": "02:38:54", "text": "それ。私は気を引きました。とても悲しい"}, {"type": "subtitle", "time": 9537.11, "timestamp": "02:38:57", "text": "1つ。"}]
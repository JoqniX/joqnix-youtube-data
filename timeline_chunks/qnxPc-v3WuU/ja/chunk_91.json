[{"type": "subtitle", "time": 5473.99, "timestamp": "01:31:13", "text": "自分が実はVCの中にいることに今気づいた"}, {"type": "subtitle", "time": 5477.35, "timestamp": "01:31:17", "text": "神。はい、それがあなたの車です。心配しないで"}, {"type": "subtitle", "time": 5490.79, "timestamp": "01:31:30", "text": "あんなに大声で叫んでしまってすみません。それは"}, {"type": "subtitle", "time": 5491.95, "timestamp": "01:31:31", "text": "車。しないで"}, {"type": "subtitle", "time": 5494.31, "timestamp": "01:31:34", "text": "心配。つまり、私も叫んでいるので"}, {"type": "subtitle", "time": 5514.79, "timestamp": "01:31:54", "text": "10キル？何てことだ。"}, {"type": "subtitle", "time": 5516.709, "timestamp": "01:31:56", "text": "なぜそうなるのか？それは彼の非アクティブです"}]
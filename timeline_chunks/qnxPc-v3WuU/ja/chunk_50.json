[{"type": "subtitle", "time": 3000.549, "timestamp": "00:50:00", "text": "継続。今日を楽しんでください。本当にありがとうございます"}, {"type": "subtitle", "time": 3001.39, "timestamp": "00:50:01", "text": "それで"}, {"type": "subtitle", "time": 3011.309, "timestamp": "00:50:11", "text": "わかった。は"}, {"type": "subtitle", "time": 3027.549, "timestamp": "00:50:27", "text": "[音楽]"}, {"type": "subtitle", "time": 3033.95, "timestamp": "00:50:33", "text": "忍者、これで全員だと思います。"}, {"type": "subtitle", "time": 3043.71, "timestamp": "00:50:43", "text": "いや、大丈夫だと思うよ。うん、大丈夫だよ。私たちは"}, {"type": "subtitle", "time": 3046.87, "timestamp": "00:50:46", "text": "良い。こんにちは。ということで、"}, {"type": "subtitle", "time": 3049.349, "timestamp": "00:50:49", "text": "こっちへどうぞ。こんなに長い間ごめんなさい"}, {"type": "subtitle", "time": 3053.79, "timestamp": "00:50:53", "text": "1つですが、お越しいただき本当にありがとうございます。"}, {"type": "subtitle", "time": 3057.109, "timestamp": "00:50:57", "text": "今日。要約にご注目ください"}, {"type": "subtitle", "time": 3059.75, "timestamp": "00:50:59", "text": "小川。ソーシャルメディアに投稿します"}]
[{"type": "subtitle", "time": 15061.75, "timestamp": "04:11:01", "text": "大丈夫です。お気に入りのコラボレーションだよ。"}, {"type": "subtitle", "time": 15064.469, "timestamp": "04:11:04", "text": "あなたが一番楽しんでいましたね。素晴らしい"}, {"type": "subtitle", "time": 15067.59, "timestamp": "04:11:07", "text": "時間。あなたとその相手は親しくなった"}, {"type": "subtitle", "time": 15070.95, "timestamp": "04:11:10", "text": "チャドはそれをとても楽しんだ。"}, {"type": "subtitle", "time": 15075.469, "timestamp": "04:11:15", "text": "良い。あなたにとっては何のために？どれが一番良かった？"}, {"type": "subtitle", "time": 15077.55, "timestamp": "04:11:17", "text": "H 私はそうは思いません"}, {"type": "subtitle", "time": 15080.95, "timestamp": "04:11:20", "text": "知る。誰もいません。あなたは誰にも迷惑をかけていない"}, {"type": "subtitle", "time": 15083.59, "timestamp": "04:11:23", "text": "感情。おいおい、頼むよ。いいえ。"}, {"type": "subtitle", "time": 15087.189, "timestamp": "04:11:27", "text": "それらは良いものです。良い。"}, {"type": "subtitle", "time": 15090.469, "timestamp": "04:11:30", "text": "知っている。でも、あなたのお気に入りはどれでしたか？あなた"}, {"type": "subtitle", "time": 15097.83, "timestamp": "04:11:37", "text": "何てことだ。プレッシャーを感じなくても大丈夫です"}, {"type": "subtitle", "time": 15099.83, "timestamp": "04:11:39", "text": "伝えたい。もしあなたがプレッシャーを感じないなら"}, {"type": "subtitle", "time": 15102.83, "timestamp": "04:11:42", "text": "伝えたい。いいえ、私はとても混乱しています。"}, {"type": "subtitle", "time": 15106.469, "timestamp": "04:11:46", "text": "待って。うん。教えて、もしあなたが私の"}, {"type": "subtitle", "time": 15110.309, "timestamp": "04:11:50", "text": "一番のお気に入り。わかりました、では私は2つあります"}, {"type": "subtitle", "time": 15113.91, "timestamp": "04:11:53", "text": "見ていて一番楽しかったのは"}, {"type": "subtitle", "time": 15114.91, "timestamp": "04:11:54", "text": "おそらく"}, {"type": "subtitle", "time": 15118.71, "timestamp": "04:11:58", "text": "えっと、どれだったっけ？ちょっと待ってください"}]
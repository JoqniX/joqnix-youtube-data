[{"type": "subtitle", "time": 4260.79, "timestamp": "01:11:00", "text": "私たちは彼の声を聞くことができる。"}, {"type": "subtitle", "time": 4262.47, "timestamp": "01:11:02", "text": "こんにちは。こんにちは。今日は元気ですか？希望"}, {"type": "subtitle", "time": 4265.91, "timestamp": "01:11:05", "text": "今日は素晴らしいですね。こんにちは。こんにちは。"}, {"type": "subtitle", "time": 4268.55, "timestamp": "01:11:08", "text": "こんにちは。元気ですか？本当に久しぶりですね。私"}, {"type": "subtitle", "time": 4270.669, "timestamp": "01:11:10", "text": "逃す"}, {"type": "subtitle", "time": 4281.75, "timestamp": "01:11:21", "text": "ジョー先輩、お元気ですか？元気です。"}, {"type": "subtitle", "time": 4285.91, "timestamp": "01:11:25", "text": "元気ですか？私は元気です。元気ですか？私は"}, {"type": "subtitle", "time": 4288.63, "timestamp": "01:11:28", "text": "こちらも順調です。はい、あなたはそうしています"}, {"type": "subtitle", "time": 4291.669, "timestamp": "01:11:31", "text": "素晴らしい。それは嬉しいですね。それは良い。"}, {"type": "subtitle", "time": 4295.39, "timestamp": "01:11:35", "text": "チャットを読んでみます"}, {"type": "subtitle", "time": 4298.07, "timestamp": "01:11:38", "text": "少し。より高い感度を希望します。はい、"}, {"type": "subtitle", "time": 4300.39, "timestamp": "01:11:40", "text": "実際、同じです。はい。"}, {"type": "subtitle", "time": 4303.35, "timestamp": "01:11:43", "text": "おかけさまで元気です。それは良い。こんにちは。"}, {"type": "subtitle", "time": 4304.709, "timestamp": "01:11:44", "text": "こんにちは。元気ですか？お元気でお過ごしでしょうか"}, {"type": "subtitle", "time": 4306.87, "timestamp": "01:11:46", "text": "今日は素晴らしい一日でした。こんにちは。みなさん、こんにちは。こんにちは。"}, {"type": "subtitle", "time": 4307.75, "timestamp": "01:11:47", "text": "今日は元気ですか？お元気でお過ごしでしょうか"}, {"type": "subtitle", "time": 4310.149, "timestamp": "01:11:50", "text": "今日は素晴らしい一日でした。ジョーはここにいますか？はい、そうです。彼"}, {"type": "subtitle", "time": 4312.87, "timestamp": "01:11:52", "text": "は。ちょっと病的な感じがするね。あなたは"}, {"type": "subtitle", "time": 4315.75, "timestamp": "01:11:55", "text": "元気ですか？いいえ、私は病気です。はい。"}, {"type": "subtitle", "time": 4319.43, "timestamp": "01:11:59", "text": "ええ、彼の声は聞こえますよ。こんにちは。こんにちは。"}]
[{"type": "subtitle", "time": 3661.71, "timestamp": "01:01:01", "text": "私はとても"}, {"type": "subtitle", "time": 3664.39, "timestamp": "01:01:04", "text": "神経質。とても緊張しています。"}, {"type": "subtitle", "time": 3667.63, "timestamp": "01:01:07", "text": "初めてドゥチと一緒に銃を撃ちました。"}, {"type": "subtitle", "time": 3672.43, "timestamp": "01:01:12", "text": "だから、ある意味では、私は"}, {"type": "subtitle", "time": 3673.95, "timestamp": "01:01:13", "text": "神経質。"}, {"type": "subtitle", "time": 3676.829, "timestamp": "01:01:16", "text": "最高"}, {"type": "subtitle", "time": 3680.39, "timestamp": "01:01:20", "text": "神経質。ああ、緊張する。"}, {"type": "subtitle", "time": 3684.47, "timestamp": "01:01:24", "text": "[音楽]"}, {"type": "subtitle", "time": 3686.19, "timestamp": "01:01:26", "text": "私は"}, {"type": "subtitle", "time": 3689.51, "timestamp": "01:01:29", "text": "神経質。何てことだ。そして、あそこも"}, {"type": "subtitle", "time": 3693.43, "timestamp": "01:01:33", "text": "今日の私たちの計画は"}, {"type": "subtitle", "time": 3696.549, "timestamp": "01:01:36", "text": "ということで、今日の計画は、"}, {"type": "subtitle", "time": 3698.87, "timestamp": "01:01:38", "text": "視聴者1人、プレイしたい人"}, {"type": "subtitle", "time": 3701.99, "timestamp": "01:01:41", "text": "私と一緒に、彼らのうちの1つを手に入れます"}, {"type": "subtitle", "time": 3704.47, "timestamp": "01:01:44", "text": "そしてズチもそのうちの1つを手に入れるだろう"}, {"type": "subtitle", "time": 3707.19, "timestamp": "01:01:47", "text": "そして私たちは自転車で回ります。だから、私たちは"}, {"type": "subtitle", "time": 3710.95, "timestamp": "01:01:50", "text": "私とジッチとスタッドが参加します"}, {"type": "subtitle", "time": 3714.549, "timestamp": "01:01:54", "text": "この配信全体を通してのパーティーのために。それで、"}, {"type": "subtitle", "time": 3717.27, "timestamp": "01:01:57", "text": "残り枠はあと2つです。では、1つ目"}]
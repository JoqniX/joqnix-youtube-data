[{"type": "subtitle", "time": 3540.549, "timestamp": "00:59:00", "text": "マルチウォッチ設定。今はただ"}, {"type": "subtitle", "time": 3542.75, "timestamp": "00:59:02", "text": "それ。そして、まさに今この瞬間にも"}, {"type": "subtitle", "time": 3545.95, "timestamp": "00:59:05", "text": "えっと、何人かのお客さんが家に来たので、"}, {"type": "subtitle", "time": 3549.71, "timestamp": "00:59:09", "text": "ああ、タイミングがすごい"}, {"type": "subtitle", "time": 3553.95, "timestamp": "00:59:13", "text": "タイミング タイミング タイミング"}, {"type": "subtitle", "time": 3556.75, "timestamp": "00:59:16", "text": "タイミングはタイミングです"}, {"type": "subtitle", "time": 3559.67, "timestamp": "00:59:19", "text": "痛みはあるけど、そうならないことを願ってる"}, {"type": "subtitle", "time": 3562.789, "timestamp": "00:59:22", "text": "中断されたので、最善を尽くします"}, {"type": "subtitle", "time": 3566.67, "timestamp": "00:59:26", "text": "えっと、私たちの配信。そうですね、それでは設定します"}, {"type": "subtitle", "time": 3569.75, "timestamp": "00:59:29", "text": "マルチウォッチリンクを設定しますので"}, {"type": "subtitle", "time": 3572.63, "timestamp": "00:59:32", "text": "私とズチの両方を見ながら"}, {"type": "subtitle", "time": 3575.829, "timestamp": "00:59:35", "text": "現在配信中です。私たち二人の自己ベスト。"}, {"type": "subtitle", "time": 3577.63, "timestamp": "00:59:37", "text": "ということで、数試合行う予定です。"}, {"type": "subtitle", "time": 3581.47, "timestamp": "00:59:41", "text": "一緒に、とか色々。ええ、そうですね。"}, {"type": "subtitle", "time": 3585.309, "timestamp": "00:59:45", "text": "えっと、ちょっと確認させてください"}, {"type": "subtitle", "time": 3587.789, "timestamp": "00:59:47", "text": "何か。はい、彼女はまだそこにいます。"}, {"type": "subtitle", "time": 3591.109, "timestamp": "00:59:51", "text": "わかった。ああ、なんてことだ、私はミュートした"}, {"type": "subtitle", "time": 3598.99, "timestamp": "00:59:58", "text": "うん。うん。私はそうでしょうか？それでは、"}]
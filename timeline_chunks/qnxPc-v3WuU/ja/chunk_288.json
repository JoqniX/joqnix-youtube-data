[{"type": "subtitle", "time": 17280.31, "timestamp": "04:48:00", "text": "うん。問題は、Discord ができないことです"}, {"type": "subtitle", "time": 17283.11, "timestamp": "04:48:03", "text": "下にスクロールして、私が"}, {"type": "subtitle", "time": 17285.75, "timestamp": "04:48:05", "text": "メッセージを送り、友達になった。中には、"}, {"type": "subtitle", "time": 17287.99, "timestamp": "04:48:07", "text": "私を友達リストから削除しました。どこなのかもわからない"}, {"type": "subtitle", "time": 17291.91, "timestamp": "04:48:11", "text": "なぜ、なぜ、などなど。そして私は「えっ？」って感じだった"}, {"type": "subtitle", "time": 17294.39, "timestamp": "04:48:14", "text": "名前は？名前が見つかりません。私"}, {"type": "subtitle", "time": 17299.11, "timestamp": "04:48:19", "text": "昔の知り合いを思い出す。"}, {"type": "subtitle", "time": 17301.51, "timestamp": "04:48:21", "text": "うん。この男は本当に自分の"}, {"type": "subtitle", "time": 17303.99, "timestamp": "04:48:23", "text": "彼はコラボするよね？つまり、私には"}, {"type": "subtitle", "time": 17306.31, "timestamp": "04:48:26", "text": "これはコラボレーションです。私はこれを最後の"}, {"type": "subtitle", "time": 17308.868, "timestamp": "04:48:28", "text": "一緒に話そうよ、だって私配信してるんだもん。"}, {"type": "subtitle", "time": 17311.83, "timestamp": "04:48:31", "text": "すばらしい。ええ、24時間365日配信しています。そして"}, {"type": "subtitle", "time": 17315.19, "timestamp": "04:48:35", "text": "たとえ配信とかしてなくても、"}, {"type": "subtitle", "time": 17317.35, "timestamp": "04:48:37", "text": "人々とリラックスして過ごしたい"}, {"type": "subtitle", "time": 17319.27, "timestamp": "04:48:39", "text": "人々と話す。コラボレーションの話ではない"}, {"type": "subtitle", "time": 17321.67, "timestamp": "04:48:41", "text": "あるいは何でも。ただリラックスしたいだけ"}, {"type": "subtitle", "time": 17323.83, "timestamp": "04:48:43", "text": "楽しい時間をお過ごしください。"}, {"type": "subtitle", "time": 17325.75, "timestamp": "04:48:45", "text": "うん。"}, {"type": "subtitle", "time": 17327.75, "timestamp": "04:48:47", "text": "つまり、絞る必要すらないんです"}, {"type": "subtitle", "time": 17331.03, "timestamp": "04:48:51", "text": "なぜなのか、私たちにそう思わせる。それは"}, {"type": "subtitle", "time": 17333.75, "timestamp": "04:48:53", "text": "彼が言っていること。彼が望むように"}, {"type": "subtitle", "time": 17337.27, "timestamp": "04:48:57", "text": "君たちを無理やり押し込んで、ほら、彼は"}, {"type": "subtitle", "time": 17339.75, "timestamp": "04:48:59", "text": "それを実行する。"}]
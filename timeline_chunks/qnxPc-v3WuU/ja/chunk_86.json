[{"type": "subtitle", "time": 5161.669, "timestamp": "01:26:01", "text": "興ざめな人。彼は荒らしをするつもりだ"}, {"type": "subtitle", "time": 5163.83, "timestamp": "01:26:03", "text": "あるいは彼は殺すつもりだ"}, {"type": "subtitle", "time": 5167.11, "timestamp": "01:26:07", "text": "すべて。そういうことなんです。なんてこった。うん。"}, {"type": "subtitle", "time": 5169.03, "timestamp": "01:26:09", "text": "パンダは適切だ。つまり、彼は"}, {"type": "subtitle", "time": 5171.43, "timestamp": "01:26:11", "text": "ダイヤモンド３ですよね？彼は何の餌なの？"}, {"type": "subtitle", "time": 5173.91, "timestamp": "01:26:13", "text": "だから私は「ああ、彼は"}, {"type": "subtitle", "time": 5176.87, "timestamp": "01:26:16", "text": "ダイヤモンド。だから私は「ああ、なんてことだ」と思ったんです"}, {"type": "subtitle", "time": 5179.59, "timestamp": "01:26:19", "text": "ああ、彼はハイレベルな選手すぎる。"}, {"type": "subtitle", "time": 5181.91, "timestamp": "01:26:21", "text": "右？だから私は「ああ、"}, {"type": "subtitle", "time": 5184.03, "timestamp": "01:26:24", "text": "主よ、しないでください"}, {"type": "subtitle", "time": 5185.629, "timestamp": "01:26:25", "text": "これ。"}]
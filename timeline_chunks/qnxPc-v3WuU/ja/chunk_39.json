[{"type": "subtitle", "time": 2343.03, "timestamp": "00:39:03", "text": "チャットできるような"}, {"type": "subtitle", "time": 2346.63, "timestamp": "00:39:06", "text": "通常、そのように購読しないと"}, {"type": "subtitle", "time": 2349.43, "timestamp": "00:39:09", "text": "コミュニティとの交流を可能にする"}, {"type": "subtitle", "time": 2351.15, "timestamp": "00:39:11", "text": "権利なし"}, {"type": "subtitle", "time": 2354.47, "timestamp": "00:39:14", "text": "購読しているけど、それはまるで"}, {"type": "subtitle", "time": 2357.55, "timestamp": "00:39:17", "text": "購読を忘れた場合、または"}, {"type": "subtitle", "time": 2359.99, "timestamp": "00:39:19", "text": "何か、あるいは何かがまさにその時"}, {"type": "subtitle", "time": 2361.99, "timestamp": "00:39:21", "text": "それはまた独自の"}, {"type": "subtitle", "time": 2364.829, "timestamp": "00:39:24", "text": "難しい問題"}, {"type": "subtitle", "time": 2367.829, "timestamp": "00:39:27", "text": "そうですね、今すぐ配信します"}, {"type": "subtitle", "time": 2370.47, "timestamp": "00:39:30", "text": "私がたまたまクリックしたのは"}, {"type": "subtitle", "time": 2373.47, "timestamp": "00:39:33", "text": "現在、加入者限定モードになっています"}, {"type": "subtitle", "time": 2377.589, "timestamp": "00:39:37", "text": "そう、本能的にそうするだろう"}, {"type": "subtitle", "time": 2382.55, "timestamp": "00:39:42", "text": "そうですね、私はそれらを観ていて、"}, {"type": "subtitle", "time": 2384.39, "timestamp": "00:39:44", "text": "彼らがどのように話すか、すべてを見てください"}, {"type": "subtitle", "time": 2387.15, "timestamp": "00:39:47", "text": "そしてそれはただ見ているだけの"}, {"type": "subtitle", "time": 2390.31, "timestamp": "00:39:50", "text": "そうだけど、普通も欲しい"}, {"type": "subtitle", "time": 2396.91, "timestamp": "00:39:56", "text": "ああ、何"}]
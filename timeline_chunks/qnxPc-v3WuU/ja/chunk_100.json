[{"type": "subtitle", "time": 6015.51, "timestamp": "01:40:15", "text": "ファントムをスプレーすればいいだけです。忘れた"}, {"type": "subtitle", "time": 6050.39, "timestamp": "01:40:50", "text": "はぁ？ほら、たぶんピングの問題だと思うんだけど、"}, {"type": "subtitle", "time": 6052.79, "timestamp": "01:40:52", "text": "右？あなたのショットはまさにあなた、あなたはただ"}, {"type": "subtitle", "time": 6055.83, "timestamp": "01:40:55", "text": "ショットを当てるな。私はそうしていた"}, {"type": "subtitle", "time": 6057.55, "timestamp": "01:40:57", "text": "良い"}]
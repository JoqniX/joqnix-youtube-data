[{"type": "subtitle", "time": 1625.51, "timestamp": "00:27:05", "text": "ベイビー。待って、これって初めてなの？おお、"}, {"type": "subtitle", "time": 1627.43, "timestamp": "00:27:07", "text": "待って。このヤブ医者は違う。そうそう。"}, {"type": "subtitle", "time": 1630.47, "timestamp": "00:27:10", "text": "ああ、君は別のヤブ医者だね。標的"}, {"type": "subtitle", "time": 1633.19, "timestamp": "00:27:13", "text": "ごめん。つまり、もう一人視聴者がいたということだ。私"}, {"type": "subtitle", "time": 1636.47, "timestamp": "00:27:16", "text": "クワックのような似た名前を言わなければならなかった。"}, {"type": "subtitle", "time": 1638.71, "timestamp": "00:27:18", "text": "つまり、君は二人目のヤブ医者になるってことだね。知っている。"}, {"type": "subtitle", "time": 1641.19, "timestamp": "00:27:21", "text": "また、お越しいただきありがとうございました。私は信じている"}, {"type": "subtitle", "time": 1645.23, "timestamp": "00:27:25", "text": "初めてなんですね。いいえ。"}, {"type": "subtitle", "time": 1647.75, "timestamp": "00:27:27", "text": "いらっしゃいませ。今日はお元気でお過ごしでしょうか。"}, {"type": "subtitle", "time": 1649.71, "timestamp": "00:27:29", "text": "ハッピー"}, {"type": "subtitle", "time": 1653.87, "timestamp": "00:27:33", "text": "月曜日か日曜日（日曜日の場合）"}, {"type": "subtitle", "time": 1657.59, "timestamp": "00:27:37", "text": "あなた。クアンズへようこそ。ああ、"}, {"type": "subtitle", "time": 1660.95, "timestamp": "00:27:40", "text": "ああ、こんなにたくさんの人がいるなんて、これは"}, {"type": "subtitle", "time": 1663.35, "timestamp": "00:27:43", "text": "普通？これは普通のことですか？私は"}, {"type": "subtitle", "time": 1665.43, "timestamp": "00:27:45", "text": "おすすめですか？それはつまり"}, {"type": "subtitle", "time": 1676.99, "timestamp": "00:27:56", "text": "[音楽]"}]
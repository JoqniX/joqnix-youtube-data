[{"type": "subtitle", "time": 13800.389, "timestamp": "03:50:00", "text": "私自身とすべてに連絡を取り、"}, {"type": "subtitle", "time": 13802.55, "timestamp": "03:50:02", "text": "人々、すべてをスケジュールし、書き留める"}, {"type": "subtitle", "time": 13805.15, "timestamp": "03:50:05", "text": "どこか遠くへ、すべてが落ちていく。だから私は"}, {"type": "subtitle", "time": 13809.51, "timestamp": "03:50:09", "text": "将来、もし私がそうしたら"}, {"type": "subtitle", "time": 13811.91, "timestamp": "03:50:11", "text": "私は、それをすべきでしょうか"}, {"type": "subtitle", "time": 13814.95, "timestamp": "03:50:14", "text": "私がこのジョアソンを一緒にやった人たち"}, {"type": "subtitle", "time": 13818.15, "timestamp": "03:50:18", "text": "すでに20個くらい終わった"}, {"type": "subtitle", "time": 13821.429, "timestamp": "03:50:21", "text": "プラス 人々のコラボレーションが正しい"}, {"type": "subtitle", "time": 13824.229, "timestamp": "03:50:24", "text": "だから私は、そうしたいと思った"}, {"type": "subtitle", "time": 13826.469, "timestamp": "03:50:26", "text": "しかし、私はもっと多くの機会を与えたいと思っています"}, {"type": "subtitle", "time": 13828.83, "timestamp": "03:50:28", "text": "人々はそれを手に入れることができませんでした"}, {"type": "subtitle", "time": 13832.95, "timestamp": "03:50:32", "text": "ジョアソン、そうだね、もし君が、もし"}, {"type": "subtitle", "time": 13835.11, "timestamp": "03:50:35", "text": "これをもう一度やってコラボレーションしたい"}, {"type": "subtitle", "time": 13836.469, "timestamp": "03:50:36", "text": "お年寄りたちと一緒に。それは"}, {"type": "subtitle", "time": 13838.15, "timestamp": "03:50:38", "text": "素晴らしいね、だって、うん、あれは"}, {"type": "subtitle", "time": 13839.75, "timestamp": "03:50:39", "text": "良い。はい。まるでそれは少し"}, {"type": "subtitle", "time": 13842.55, "timestamp": "03:50:42", "text": "人々が初めて"}, {"type": "subtitle", "time": 13844.15, "timestamp": "03:50:44", "text": "初めてそこにいた人たち"}, {"type": "subtitle", "time": 13846.229, "timestamp": "03:50:46", "text": "時間が経って、今彼らは戻ってきたんだよ。"}, {"type": "subtitle", "time": 13849.189, "timestamp": "03:50:49", "text": "うん、それはいいことだね。"}, {"type": "subtitle", "time": 13852.469, "timestamp": "03:50:52", "text": "またここに来たい。はい、私は"}, {"type": "subtitle", "time": 13855.269, "timestamp": "03:50:55", "text": "またここに来てほしい。はい、"}, {"type": "subtitle", "time": 13856.63, "timestamp": "03:50:56", "text": "コース。あなたもそこにいるでしょう。ない"}, {"type": "subtitle", "time": 13858.95, "timestamp": "03:50:58", "text": "みんな。すべて。"}]
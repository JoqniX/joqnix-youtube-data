[{"type": "subtitle", "time": 60.75, "timestamp": "00:01:00", "text": "ねずみ。私は"}, {"type": "subtitle", "time": 65.03, "timestamp": "00:01:05", "text": "大きなマウスカーソルみたいに。待って、"}, {"type": "subtitle", "time": 68.51, "timestamp": "00:01:08", "text": "コンソールのサイズを変更しますか？クローサー"}, {"type": "subtitle", "time": 73.27, "timestamp": "00:01:13", "text": "サイズ。はい、できます。私は大成功させなければならない。"}, {"type": "subtitle", "time": 75.71000000000001, "timestamp": "00:01:15", "text": "そうなんですか？うん、こうしないといけないんだ"}, {"type": "subtitle", "time": 79.55, "timestamp": "00:01:19", "text": "大きい。こんなに大きくしなければならなかった"}, {"type": "subtitle", "time": 91.27, "timestamp": "00:01:31", "text": "うん。待って、マウスをなくしたみたい"}, {"type": "subtitle", "time": 94.59, "timestamp": "00:01:34", "text": "ポインターのようなもの。元通りになった。"}, {"type": "subtitle", "time": 98.99000000000001, "timestamp": "00:01:38", "text": "いいえ、マウスカーソルを返してください。"}, {"type": "subtitle", "time": 102.10900000000001, "timestamp": "00:01:42", "text": "待って。ああ、これだ。黒"}, {"type": "subtitle", "time": 105.63, "timestamp": "00:01:45", "text": "蝶。それが私の"}, {"type": "subtitle", "time": 112.38900000000001, "timestamp": "00:01:52", "text": "うん。テクニックについて教える"}]
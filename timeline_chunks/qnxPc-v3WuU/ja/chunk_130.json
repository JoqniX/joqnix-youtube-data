[{"type": "subtitle", "time": 7803.03, "timestamp": "02:10:03", "text": "その女性はただ見ているだけだ。"}, {"type": "subtitle", "time": 7804.95, "timestamp": "02:10:04", "text": "うん。わからない。何をすればいいのかわからない"}, {"type": "subtitle", "time": 7809.03, "timestamp": "02:10:09", "text": "これについてどうすべきか。はい、わかりました、わかりました、"}, {"type": "subtitle", "time": 7810.55, "timestamp": "02:10:10", "text": "わかった。ジョーカー先輩をゲットしました。しないで"}, {"type": "subtitle", "time": 7812.87, "timestamp": "02:10:12", "text": "それについて心配してください。あ、待って。どのサーバー"}, {"type": "subtitle", "time": 7815.27, "timestamp": "02:10:15", "text": "これですか？ムンバイかシンガポールか？その"}, {"type": "subtitle", "time": 7818.79, "timestamp": "02:10:18", "text": "シンガポール。ああ、わかりました。ええ、そうです"}, {"type": "subtitle", "time": 7824.95, "timestamp": "02:10:24", "text": "ああ、待って。誰も中盤を見ていない。"}, {"type": "subtitle", "time": 7837.35, "timestamp": "02:10:37", "text": "ここに囮があります。"}, {"type": "subtitle", "time": 7840.149, "timestamp": "02:10:40", "text": "多くの敵。 A"}, {"type": "subtitle", "time": 7843.109, "timestamp": "02:10:43", "text": "デコイ。料金がかかりません。手を出さないで"}, {"type": "subtitle", "time": 7853.229, "timestamp": "02:10:53", "text": "ああ、みんなここにいる。"}, {"type": "subtitle", "time": 7856.95, "timestamp": "02:10:56", "text": "ええ、彼らは中堅レベルです。"}]
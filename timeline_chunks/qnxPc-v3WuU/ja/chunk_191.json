[{"type": "subtitle", "time": 11499.99, "timestamp": "03:11:39", "text": "当時彼らを見たとき、今のように"}, {"type": "subtitle", "time": 11503.269, "timestamp": "03:11:43", "text": "線は私たち全員に当てはまる"}, {"type": "subtitle", "time": 11505.75, "timestamp": "03:11:45", "text": "私は推測する。"}, {"type": "subtitle", "time": 11509.11, "timestamp": "03:11:49", "text": "え、何の列？"}, {"type": "subtitle", "time": 11511.59, "timestamp": "03:11:51", "text": "上の文字を見てください。"}, {"type": "subtitle", "time": 11514.95, "timestamp": "03:11:54", "text": "それらは、すべての白い線のようなもので"}, {"type": "subtitle", "time": 11518.389, "timestamp": "03:11:58", "text": "私たち。ああ、あれは体力ゲージのことかな。"}, {"type": "subtitle", "time": 11519.91, "timestamp": "03:11:59", "text": "それ"}]
[{"type": "subtitle", "time": 1387.35, "timestamp": "00:23:07", "text": "何？ええ、最近調子が悪いんです。"}, {"type": "subtitle", "time": 1390.07, "timestamp": "00:23:10", "text": "うん。こんにちは、バンさん。ようこそ。おはよう。"}, {"type": "subtitle", "time": 1392.95, "timestamp": "00:23:12", "text": "月曜日が良い一日であることを願っています。こんにちは"}, {"type": "subtitle", "time": 1394.87, "timestamp": "00:23:14", "text": "ブラッド。お元気でお過ごしでしょうか。"}, {"type": "subtitle", "time": 1397.63, "timestamp": "00:23:17", "text": "あなたの"}, {"type": "subtitle", "time": 1400.789, "timestamp": "00:23:20", "text": "月曜日。待って、今何時？たいてい"}, {"type": "subtitle", "time": 1402.39, "timestamp": "00:23:22", "text": "おそらく日曜日か何かでしょう。"}, {"type": "subtitle", "time": 1405.95, "timestamp": "00:23:25", "text": "右？ええ、お二人とも日曜日が好きです"}, {"type": "subtitle", "time": 1409.43, "timestamp": "00:23:29", "text": "夕方。もう真夜中だってことは分かってるよ。"}, {"type": "subtitle", "time": 1412.39, "timestamp": "00:23:32", "text": "うん。皆さん、良い一日をお過ごしでしょうか。"}, {"type": "subtitle", "time": 1415.27, "timestamp": "00:23:35", "text": "昼夜問わず、夕方も順調です。"}, {"type": "subtitle", "time": 1417.669, "timestamp": "00:23:37", "text": "それは良いです。"}, {"type": "subtitle", "time": 1420.909, "timestamp": "00:23:40", "text": "月曜日は生産的な一日になるだろうか？"}, {"type": "subtitle", "time": 1424.029, "timestamp": "00:23:44", "text": "いいえ。それに、あなたは働きすぎです。その"}, {"type": "subtitle", "time": 1427.029, "timestamp": "00:23:47", "text": "日曜日。ええ、あなたにとっては日曜日ですね。のために"}, {"type": "subtitle", "time": 1428.909, "timestamp": "00:23:48", "text": "私にとってそれは"}]
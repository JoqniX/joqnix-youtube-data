[{"type": "subtitle", "time": 4560.03, "timestamp": "01:16:00", "text": "今日は順調だった。私はちょっと"}, {"type": "subtitle", "time": 4563.43, "timestamp": "01:16:03", "text": "えっと、遅刻したことを心配していたので、"}, {"type": "subtitle", "time": 4572.79, "timestamp": "01:16:12", "text": "うん。さあ、ピューピューと撃つ時が来た"}, {"type": "subtitle", "time": 4575.51, "timestamp": "01:16:15", "text": "何？"}, {"type": "subtitle", "time": 4577.669, "timestamp": "01:16:17", "text": "何って言ったの？"}, {"type": "subtitle", "time": 4585.83, "timestamp": "01:16:25", "text": "こっそりと何かが見える。"}, {"type": "subtitle", "time": 4590.63, "timestamp": "01:16:30", "text": "いや、待って。私はどこにいるの？私を殺して。私"}, {"type": "subtitle", "time": 4591.47, "timestamp": "01:16:31", "text": "聞く"}, {"type": "subtitle", "time": 4594.95, "timestamp": "01:16:34", "text": "あなた。誰かが出現する音が聞こえる。"}, {"type": "subtitle", "time": 4597.189, "timestamp": "01:16:37", "text": "ええ、私も参加します。はい、参加できますよ。あなた"}, {"type": "subtitle", "time": 4600.229, "timestamp": "01:16:40", "text": "参加できます。私には、私には、"}, {"type": "subtitle", "time": 4602.55, "timestamp": "01:16:42", "text": "空き枠は2つあります。そうそう"}, {"type": "subtitle", "time": 4606.229, "timestamp": "01:16:46", "text": "私の側にいる人たちは待たなければならない"}, {"type": "subtitle", "time": 4610.47, "timestamp": "01:16:50", "text": "自転車で登らなければならないと思う"}, {"type": "subtitle", "time": 4613.51, "timestamp": "01:16:53", "text": "たぶんレンダリングする"}, {"type": "subtitle", "time": 4615.95, "timestamp": "01:16:55", "text": "ウォーミングアップして、彼らについていく"}, {"type": "subtitle", "time": 4618.31, "timestamp": "01:16:58", "text": "クソ野郎ども。ジョークは"}]
[{"type": "subtitle", "time": 11522.71, "timestamp": "03:12:02", "text": "ええ、すべての「いや、いや、いや」に対して。上の"}, {"type": "subtitle", "time": 11527.19, "timestamp": "03:12:07", "text": "頭。頭上。頭上。"}, {"type": "subtitle", "time": 11528.87, "timestamp": "03:12:08", "text": "上には白い線もあります"}, {"type": "subtitle", "time": 11531.91, "timestamp": "03:12:11", "text": "頭ですよね？おお。そうそう。うん。待って、私は"}, {"type": "subtitle", "time": 11533.59, "timestamp": "03:12:13", "text": "それは見当たらない。何てことだ。そうそう。"}, {"type": "subtitle", "time": 11535.03, "timestamp": "03:12:15", "text": "ええ、分かります。なるほど。なるほど。どうやって"}, {"type": "subtitle", "time": 11537.269, "timestamp": "03:12:17", "text": "それが見えないの？わかった。わかった。うん。だって私は"}, {"type": "subtitle", "time": 11542.63, "timestamp": "03:12:22", "text": "統計データがありました。"}, {"type": "subtitle", "time": 11560.429, "timestamp": "03:12:40", "text": "待って。ストレス"}, {"type": "subtitle", "time": 11564.309, "timestamp": "03:12:44", "text": "あれ。ストレス。えっと、そのやつはえっと"}, {"type": "subtitle", "time": 11567.75, "timestamp": "03:12:47", "text": "ああ、なんてことだ、私は死んでしまった。おお。"}]
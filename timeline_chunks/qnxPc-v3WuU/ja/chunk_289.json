[{"type": "subtitle", "time": 17342.07, "timestamp": "04:49:02", "text": "最後にもう一度だけ、だってあなたは"}, {"type": "subtitle", "time": 17345.35, "timestamp": "04:49:05", "text": "彼がいつあなたの元カレに戻るか分かる。"}, {"type": "subtitle", "time": 17347.51, "timestamp": "04:49:07", "text": "うん。あなたが知っている、"}, {"type": "subtitle", "time": 17350.47, "timestamp": "04:49:10", "text": "私自身もできるかどうかわかりません"}, {"type": "chat", "time": 17352.741, "timestamp": "04:49:12", "author": "@Roku-rin", "avatar": "https://yt4.ggpht.com/8LlS_C2IirDMfA5r2V0q5G1kudp8dmG6RQvz_jCAUT3H-esyEgTNPDwrfCXiyX7Undc9UmHNgw=s64-c-k-c0x00ffffff-no-rj", "message": "No"}, {"type": "subtitle", "time": 17353.27, "timestamp": "04:49:13", "text": "実際は日本から配信している。行くよ"}, {"type": "subtitle", "time": 17355.83, "timestamp": "04:49:15", "text": "完全に一人きりになること。誰も助けてくれない"}, {"type": "subtitle", "time": 17358.868, "timestamp": "04:49:18", "text": "今のところは、ですよね？私は対処しなければならない"}, {"type": "subtitle", "time": 17363.11, "timestamp": "04:49:23", "text": "それと共に。そうですね、おそらく私は自分の"}, {"type": "subtitle", "time": 17365.43, "timestamp": "04:49:25", "text": "携帯電話から動画をアップロードするのが一番良い"}, {"type": "subtitle", "time": 17369.35, "timestamp": "04:49:29", "text": "編集が難しい場合。"}, {"type": "subtitle", "time": 17371.83, "timestamp": "04:49:31", "text": "私が試してみます。編集者として"}, {"type": "subtitle", "time": 17374.708, "timestamp": "04:49:34", "text": "スマホで動画を見るのは、それほど悪くないよ。"}, {"type": "subtitle", "time": 17376.47, "timestamp": "04:49:36", "text": "うん、ちょっとイライラするけど、"}, {"type": "subtitle", "time": 17378.82, "timestamp": "04:49:38", "text": "それほど悪くはないよ。"}, {"type": "subtitle", "time": 17380.788, "timestamp": "04:49:40", "text": "[音楽]"}, {"type": "subtitle", "time": 17382.67, "timestamp": "04:49:42", "text": "どういう意味ですか？"}, {"type": "subtitle", "time": 17391.59, "timestamp": "04:49:51", "text": "いいえ。彼はどういう意味でそう言っているのですか？あなたは"}, {"type": "subtitle", "time": 17394.788, "timestamp": "04:49:54", "text": "何か心当たりはありますか？わからない。全く分からない。"}]
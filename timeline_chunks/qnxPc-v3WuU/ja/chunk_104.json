[{"type": "subtitle", "time": 6242.31, "timestamp": "01:44:02", "text": "ええ、しばらくの間、FKになります。ただ"}, {"type": "subtitle", "time": 6246.709, "timestamp": "01:44:06", "text": "私はただ「オーケー」を待っているだけです。何？私は"}, {"type": "subtitle", "time": 6248.109, "timestamp": "01:44:08", "text": "ただ待っているだけ"}, {"type": "subtitle", "time": 6251.79, "timestamp": "01:44:11", "text": "君たちが去るためだ。"}, {"type": "subtitle", "time": 6255.27, "timestamp": "01:44:15", "text": "圧倒的だ。あなたはAFK状態になります。ええ、ええ、"}, {"type": "subtitle", "time": 6257.27, "timestamp": "01:44:17", "text": "うん。あ、待って。私は押し下げていました"}, {"type": "subtitle", "time": 6260.51, "timestamp": "01:44:20", "text": "ペダルを漕ぎながら話す。何てことだ。私の"}, {"type": "subtitle", "time": 6263.99, "timestamp": "01:44:23", "text": "悪い。ええ、そうですね。うん。ああ、行けよ。病気"}, {"type": "subtitle", "time": 6267.47, "timestamp": "01:44:27", "text": "心配しないで。私は植え付けている"}, {"type": "subtitle", "time": 6271.51, "timestamp": "01:44:31", "text": "君が話しているんだね。私のミスです。私のミスです。私のミスです。おお"}, {"type": "subtitle", "time": 6273.43, "timestamp": "01:44:33", "text": "我が神よ。私はステップについて話していました"}, {"type": "subtitle", "time": 6276.149, "timestamp": "01:44:36", "text": "下。私は最後の犠牲者になりたくない、"}, {"type": "subtitle", "time": 6283.149, "timestamp": "01:44:43", "text": "あれは誰"}, {"type": "subtitle", "time": 6295.149, "timestamp": "01:44:55", "text": "GG。"}, {"type": "subtitle", "time": 6299.669, "timestamp": "01:44:59", "text": "うん、シンガポールは私のpingのせい"}]
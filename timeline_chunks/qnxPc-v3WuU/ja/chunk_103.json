[{"type": "subtitle", "time": 6180.629, "timestamp": "01:43:00", "text": "彼らは文字通り"}, {"type": "subtitle", "time": 6189.51, "timestamp": "01:43:09", "text": "ええ、みんな歩いていますよ。いいえ。敵"}, {"type": "subtitle", "time": 6192.629, "timestamp": "01:43:12", "text": "下。ああ、それは私たちがお互いをナイフで刺していたことだった"}, {"type": "subtitle", "time": 6203.91, "timestamp": "01:43:23", "text": "さようなら、それ。あれって何でしたっけ？"}]
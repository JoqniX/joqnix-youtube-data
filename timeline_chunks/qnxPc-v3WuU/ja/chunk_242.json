[{"type": "subtitle", "time": 14521.67, "timestamp": "04:02:01", "text": "先週、荷物をまとめて出発しなければならなかった"}, {"type": "subtitle", "time": 14523.99, "timestamp": "04:02:03", "text": "先週はちょうどいいので、いくつか欲しい"}, {"type": "subtitle", "time": 14528.269, "timestamp": "04:02:08", "text": "みんなと過ごす最後の瞬間"}, {"type": "subtitle", "time": 14531.67, "timestamp": "04:02:11", "text": "そう、そう、"}, {"type": "subtitle", "time": 14534.71, "timestamp": "04:02:14", "text": "男。私もそこにいたらよかったのに"}, {"type": "subtitle", "time": 14539.269, "timestamp": "04:02:19", "text": "ストリーム。うん。うん。うん。ぜひお立ち寄りください。"}, {"type": "subtitle", "time": 14542.55, "timestamp": "04:02:22", "text": "私にはできないと思う。おお、"}, {"type": "subtitle", "time": 14545.11, "timestamp": "04:02:25", "text": "いいえ。大丈夫。いつでも見ることができます"}, {"type": "subtitle", "time": 14548.87, "timestamp": "04:02:28", "text": "壁だから大丈夫。うん。古いものを見て、"}, {"type": "subtitle", "time": 14550.79, "timestamp": "04:02:30", "text": "あなたが知っている。うん。声を送ってください"}, {"type": "subtitle", "time": 14552.71, "timestamp": "04:02:32", "text": "メッセージ。君は行くことになるって分かってるよね。ただ"}, {"type": "subtitle", "time": 14555.309, "timestamp": "04:02:35", "text": "音声メッセージを送ってください。うん、そうするよ"}, {"type": "subtitle", "time": 14559.75, "timestamp": "04:02:39", "text": "それ。もしあなたがVODのようなものを見たら"}, {"type": "subtitle", "time": 14562.71, "timestamp": "04:02:42", "text": "私のVSSは配信で再生されています"}, {"type": "subtitle", "time": 14565.229, "timestamp": "04:02:45", "text": "それから、えーと探す"}, {"type": "subtitle", "time": 14568.469, "timestamp": "04:02:48", "text": "さらに前へ進むと、"}, {"type": "subtitle", "time": 14572.07, "timestamp": "04:02:52", "text": "私が配信中に登場する部分"}, {"type": "subtitle", "time": 14575.189, "timestamp": "04:02:55", "text": "などなど。"}, {"type": "subtitle", "time": 14577.75, "timestamp": "04:02:57", "text": "人々がまだ知らないのはとても面白い"}]
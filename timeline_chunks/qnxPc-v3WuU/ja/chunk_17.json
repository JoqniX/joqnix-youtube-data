[{"type": "subtitle", "time": 1021.87, "timestamp": "00:17:01", "text": "えーと、誰が演奏するの？"}, {"type": "subtitle", "time": 1024.23, "timestamp": "00:17:04", "text": "ゲーム？それは何と呼ばれていますか？彼の"}, {"type": "subtitle", "time": 1031.189, "timestamp": "00:17:11", "text": "神。ああ、彼の名前は？一体どういうことだ？"}, {"type": "subtitle", "time": 1032.11, "timestamp": "00:17:12", "text": "私"}, {"type": "subtitle", "time": 1037.27, "timestamp": "00:17:17", "text": "忘れた。彼の名前を忘れてしまった。何？ O"}, {"type": "subtitle", "time": 1041.189, "timestamp": "00:17:21", "text": "えっと、名前はえっと、何か"}, {"type": "subtitle", "time": 1043.309, "timestamp": "00:17:23", "text": "Fと一緒。"}, {"type": "subtitle", "time": 1046.71, "timestamp": "00:17:26", "text": "わかった。 Fで始まるやつ。うん。うん。"}, {"type": "subtitle", "time": 1050.31, "timestamp": "00:17:30", "text": "うん。つまり、彼はこう書いている"}, {"type": "subtitle", "time": 1053.27, "timestamp": "00:17:33", "text": "彼のウェブサイトのブログか何かのようなもの"}, {"type": "subtitle", "time": 1055.83, "timestamp": "00:17:35", "text": "ええと、その名前で、ですよね？あるいは何か"}, {"type": "subtitle", "time": 1057.909, "timestamp": "00:17:37", "text": "別の名前とか、そういう感じ。えっと"}, {"type": "subtitle", "time": 1059.909, "timestamp": "00:17:39", "text": "そのため、彼のコミュニティはそれを更新し、"}, {"type": "subtitle", "time": 1062.87, "timestamp": "00:17:42", "text": "すべて。彼らはガイドを出し、"}, {"type": "subtitle", "time": 1066.47, "timestamp": "00:17:46", "text": "ゲーム関連グッズ、最新ゲーム、MMOゲーム"}, {"type": "subtitle", "time": 1068.87, "timestamp": "00:17:48", "text": "などなど。まるで"}, {"type": "subtitle", "time": 1071.029, "timestamp": "00:17:51", "text": "地域グループのプロジェクトのようなもの"}, {"type": "subtitle", "time": 1072.11, "timestamp": "00:17:52", "text": "あれ、君"}, {"type": "subtitle", "time": 1074.95, "timestamp": "00:17:54", "text": "知る。また、それはまた"}, {"type": "subtitle", "time": 1078.15, "timestamp": "00:17:58", "text": "倉庫とみなすことができる。で"}]
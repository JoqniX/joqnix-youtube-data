[{"type": "subtitle", "time": 13381.51, "timestamp": "03:43:01", "text": "について？あなたはまるで小さなストリーマーのようだ。"}, {"type": "subtitle", "time": 13384.469, "timestamp": "03:43:04", "text": "君を見てみろよ。まるで大人になったみたいだ。"}, {"type": "subtitle", "time": 13389.19, "timestamp": "03:43:09", "text": "君はもう大きくなったね。いいえ、私は何者でもありません。"}, {"type": "subtitle", "time": 13391.19, "timestamp": "03:43:11", "text": "黙れ。"}, {"type": "subtitle", "time": 13393.75, "timestamp": "03:43:13", "text": "あなたはアイアンビデオの誰かです"}, {"type": "subtitle", "time": 13396.67, "timestamp": "03:43:16", "text": "コミュニティ"}, {"type": "subtitle", "time": 13399.83, "timestamp": "03:43:19", "text": "私たちみんなの中にあるように、それは"}, {"type": "subtitle", "time": 13401.99, "timestamp": "03:43:21", "text": "君が成長していくのを見るのは本当に素晴らしいことだね"}, {"type": "subtitle", "time": 13403.67, "timestamp": "03:43:23", "text": "大きい"}, {"type": "subtitle", "time": 13405.95, "timestamp": "03:43:25", "text": "あなたをずっと見てきたので"}, {"type": "subtitle", "time": 13410.07, "timestamp": "03:43:30", "text": "長い間閉じているこの男この男は耐えられない"}, {"type": "subtitle", "time": 13414.07, "timestamp": "03:43:34", "text": "褒め言葉を受け入れることができない"}, {"type": "subtitle", "time": 13415.75, "timestamp": "03:43:35", "text": "そしてそれは彼の迷惑なことの一つです"}, {"type": "subtitle", "time": 13417.99, "timestamp": "03:43:37", "text": "しかし、彼のような男は"}, {"type": "subtitle", "time": 13423.99, "timestamp": "03:43:43", "text": "「うん、よくやってるね」みたいな感じ。そして"}, {"type": "subtitle", "time": 13436.189, "timestamp": "03:43:56", "text": "それ以上は分かりません。"}, {"type": "subtitle", "time": 13439.63, "timestamp": "03:43:59", "text": "男。 「わからない。」しかし"}]
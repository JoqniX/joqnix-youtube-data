[{"type": "subtitle", "time": 11227.95, "timestamp": "03:07:07", "text": "彼らはただ"}, {"type": "subtitle", "time": 11231.91, "timestamp": "03:07:11", "text": "側面にWの文字。わかった。ええ、私は2倍でした。"}, {"type": "subtitle", "time": 11243.19, "timestamp": "03:07:23", "text": "フラッシュ。大丈夫。あなたは最善を尽くしました。"}, {"type": "subtitle", "time": 11263.03, "timestamp": "03:07:43", "text": "なぜか自分自身のことのように感じてしまうのはなぜだろう？わかったよ、B。"}, {"type": "subtitle", "time": 11265.67, "timestamp": "03:07:45", "text": "ええ、彼らはBです。ああ、彼らはここにはいませんね。"}, {"type": "subtitle", "time": 11266.75, "timestamp": "03:07:46", "text": "彼らは"}]
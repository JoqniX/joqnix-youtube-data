[{"type": "subtitle", "time": 14040.59, "timestamp": "03:54:00", "text": "今ではほとんどのユーチューバーが、"}, {"type": "subtitle", "time": 14043.469, "timestamp": "03:54:03", "text": "私は感じる"}, {"type": "subtitle", "time": 14046.83, "timestamp": "03:54:06", "text": "えっと、私は感じます"}, {"type": "subtitle", "time": 14050.15, "timestamp": "03:54:10", "text": "親密な関係で、一緒に過ごすのもいいですね。"}, {"type": "subtitle", "time": 14052.91, "timestamp": "03:54:12", "text": "もしそれが"}, {"type": "subtitle", "time": 14056.07, "timestamp": "03:54:16", "text": "招待する、"}, {"type": "subtitle", "time": 14059.189, "timestamp": "03:54:19", "text": "YouTuberは寿司とかが好きだから、私も"}, {"type": "subtitle", "time": 14061.429, "timestamp": "03:54:21", "text": "時間をかけてつながり"}, {"type": "subtitle", "time": 14063.67, "timestamp": "03:54:23", "text": "彼らと知り合い、彼らと協力する"}, {"type": "subtitle", "time": 14067.59, "timestamp": "03:54:27", "text": "たくさん、など、私は"}, {"type": "subtitle", "time": 14071.51, "timestamp": "03:54:31", "text": "今は快適です。つまり、こうなるということです。"}, {"type": "subtitle", "time": 14075.269, "timestamp": "03:54:35", "text": "心配事は少なく、"}, {"type": "subtitle", "time": 14078.15, "timestamp": "03:54:38", "text": "メンテナンスですよね？考えてみてください"}, {"type": "subtitle", "time": 14080.63, "timestamp": "03:54:40", "text": "たまり場みたいな感じ。それが"}, {"type": "subtitle", "time": 14082.63, "timestamp": "03:54:42", "text": "新しい人に会うと、"}, {"type": "subtitle", "time": 14084.469, "timestamp": "03:54:44", "text": "多くのメンテナンス用品と"}, {"type": "subtitle", "time": 14086.95, "timestamp": "03:54:46", "text": "全てをきちんと管理しておかないといけないよね？"}, {"type": "subtitle", "time": 14090.15, "timestamp": "03:54:50", "text": "それはちょっと面倒ですね。"}, {"type": "subtitle", "time": 14093.99, "timestamp": "03:54:53", "text": "まあ、そういうものですよね。そして現状は"}, {"type": "subtitle", "time": 14096.15, "timestamp": "03:54:56", "text": "それが何であるか。"}, {"type": "subtitle", "time": 14099.349, "timestamp": "03:54:59", "text": "良い旅だったと思う。"}]
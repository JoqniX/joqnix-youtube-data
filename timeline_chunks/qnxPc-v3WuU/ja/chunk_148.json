[{"type": "subtitle", "time": 8883.27, "timestamp": "02:28:03", "text": "いいえ。誰ですか？ああ、あれはジョク先輩ですね。"}, {"type": "subtitle", "time": 8886.469, "timestamp": "02:28:06", "text": "ああ、わかりました。はい。こんにちは。ああ、私は"}, {"type": "subtitle", "time": 8888.63, "timestamp": "02:28:08", "text": "ナイフ。あ、待って。ジョー、あなたは"}, {"type": "subtitle", "time": 8891.389, "timestamp": "02:28:11", "text": "私と向き合いますか？待って、私は見たい"}, {"type": "subtitle", "time": 8892.91, "timestamp": "02:28:12", "text": "ナイフ。"}, {"type": "subtitle", "time": 8894.91, "timestamp": "02:28:14", "text": "おお。"}, {"type": "subtitle", "time": 8901.23, "timestamp": "02:28:21", "text": "殺さない"}, {"type": "subtitle", "time": 8908.51, "timestamp": "02:28:28", "text": "いいえ、忘れることはできません"}, {"type": "subtitle", "time": 8927.03, "timestamp": "02:28:47", "text": "10人まで事前に参加できますか？私は思う"}, {"type": "subtitle", "time": 8929.19, "timestamp": "02:28:49", "text": "あなたはできる。はい、できますよ。つまり、私たちはできるんです。"}, {"type": "subtitle", "time": 8930.87, "timestamp": "02:28:50", "text": "はい、"}, {"type": "subtitle", "time": 8932.87, "timestamp": "02:28:52", "text": "もしあなたが尋ねれば。私は"}, {"type": "subtitle", "time": 8937.309, "timestamp": "02:28:57", "text": "アニクンを見てみましょう。つまり"}]
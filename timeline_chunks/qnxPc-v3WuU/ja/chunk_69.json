[{"type": "subtitle", "time": 4143.59, "timestamp": "01:09:03", "text": "外？私の言っていることが二度聞こえましたか？"}, {"type": "subtitle", "time": 4148.43, "timestamp": "01:09:08", "text": "もし私の声が2回聞こえたら教えてください。"}, {"type": "subtitle", "time": 4161.11, "timestamp": "01:09:21", "text": "働く。さて、Discordの部分は完了しました。"}, {"type": "subtitle", "time": 4164.349, "timestamp": "01:09:24", "text": "これに関しては何の問題もありません"}, {"type": "subtitle", "time": 4168.63, "timestamp": "01:09:28", "text": "カード。私は自分の"}, {"type": "subtitle", "time": 4170.87, "timestamp": "01:09:30", "text": "時間。私はそんなことをするべきではなかった"}, {"type": "subtitle", "time": 4173.349, "timestamp": "01:09:33", "text": "遅れるべきではなかった、えっと、遅延"}, {"type": "subtitle", "time": 4175.149, "timestamp": "01:09:35", "text": "長時間の配信はするべきではなかった"}, {"type": "subtitle", "time": 4177.709, "timestamp": "01:09:37", "text": "トゥイッチ。だから遅刻したんです。ああ、"}, {"type": "subtitle", "time": 4187.189, "timestamp": "01:09:47", "text": "うん。えっと、待って、待って。そうだ、そうしなければならない"}, {"type": "subtitle", "time": 4192.51, "timestamp": "01:09:52", "text": "これを送信してください。彼女はここで言うだろう。うん。"}, {"type": "subtitle", "time": 4195.55, "timestamp": "01:09:55", "text": "こんにちは。調子はどうですか？"}, {"type": "subtitle", "time": 4199.189, "timestamp": "01:09:59", "text": "あなた？元気ですか？元気ですか？あ、待って。"}]
[{"type": "subtitle", "time": 8106.39, "timestamp": "02:15:06", "text": "何てことだ。おお。"}, {"type": "subtitle", "time": 8108.709, "timestamp": "02:15:08", "text": "ああ、前兆を待たなければならない"}, {"type": "subtitle", "time": 8112.39, "timestamp": "02:15:12", "text": "到着。もちろんです。ああ、彼は"}, {"type": "subtitle", "time": 8114.31, "timestamp": "02:15:14", "text": "エースが出せたかもしれない。実際、私は"}, {"type": "subtitle", "time": 8117.03, "timestamp": "02:15:17", "text": "1キルした。ごめんなさい。"}, {"type": "subtitle", "time": 8141.669, "timestamp": "02:15:41", "text": "我々は全てのクローンと同じように行動できる。ジョー先輩。おお"}]
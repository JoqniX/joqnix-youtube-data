[{"type": "subtitle", "time": 12720.11, "timestamp": "03:32:00", "text": "ふぅ。あ、ちょっと待って"}, {"type": "subtitle", "time": 12722.67, "timestamp": "03:32:02", "text": "2番。"}, {"type": "subtitle", "time": 12728.83, "timestamp": "03:32:08", "text": "待って。私に"}, {"type": "subtitle", "time": 12731.11, "timestamp": "03:32:11", "text": "分。少し時間をください。私に"}, {"type": "subtitle", "time": 12733.11, "timestamp": "03:32:13", "text": "分。少し時間をください。吹かせてくれ"}, {"type": "subtitle", "time": 12734.91, "timestamp": "03:32:14", "text": "それ"}, {"type": "subtitle", "time": 12739.03, "timestamp": "03:32:19", "text": "外。それを取り出せ。"}, {"type": "subtitle", "time": 12741.429, "timestamp": "03:32:21", "text": "わかった。それでは、皆さん、ようこそ"}, {"type": "subtitle", "time": 12743.79, "timestamp": "03:32:23", "text": "ヨアトンの日"}, {"type": "subtitle", "time": 12749.03, "timestamp": "03:32:29", "text": "80. 今日は金曜日なので、"}, {"type": "subtitle", "time": 12751.11, "timestamp": "03:32:31", "text": "あと1分。コラボレーションを行います"}, {"type": "subtitle", "time": 12754.389, "timestamp": "03:32:34", "text": "本日のゲストはこちらです。もう一つちょうだい"}, {"type": "subtitle", "time": 12758.429, "timestamp": "03:32:38", "text": "分。こんなことになって本当に申し訳ないです"}, {"type": "subtitle", "time": 12760.51, "timestamp": "03:32:40", "text": "遅延"}, {"type": "subtitle", "time": 12763.51, "timestamp": "03:32:43", "text": "こんな感じだけど、うん、1つちょうだい"}, {"type": "subtitle", "time": 12764.59, "timestamp": "03:32:44", "text": "もっと"}, {"type": "subtitle", "time": 12767.71, "timestamp": "03:32:47", "text": "1分で私は"}, {"type": "subtitle", "time": 12773.63, "timestamp": "03:32:53", "text": "えっと、Twitchでこれをスピードアップさせてください"}]
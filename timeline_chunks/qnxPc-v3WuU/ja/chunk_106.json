[{"type": "subtitle", "time": 6364.91, "timestamp": "01:46:04", "text": "質問させてください"}, {"type": "subtitle", "time": 6366.669, "timestamp": "01:46:06", "text": "彼"}, {"type": "subtitle", "time": 6380.87, "timestamp": "01:46:20", "text": "来る？待って。リンソンが参加すると思う"}, {"type": "subtitle", "time": 6391.43, "timestamp": "01:46:31", "text": "でも、大丈夫だよ。あなたはそうする必要はありません"}, {"type": "subtitle", "time": 6393.95, "timestamp": "01:46:33", "text": "それについて心配してください。運ぶべき人がいる"}, {"type": "subtitle", "time": 6414.229, "timestamp": "01:46:54", "text": "遠く離れて。カスタム。わかった。カスタムデスマッチ。"}, {"type": "subtitle", "time": 6417.109, "timestamp": "01:46:57", "text": "彼が来るまでデスマッチをしよう。私"}]
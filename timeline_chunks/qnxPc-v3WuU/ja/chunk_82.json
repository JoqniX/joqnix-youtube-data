[{"type": "subtitle", "time": 4921.27, "timestamp": "01:22:01", "text": "H しゃがむ動作を解除します。これがどうなるか見てみましょう"}, {"type": "subtitle", "time": 4927.59, "timestamp": "01:22:07", "text": "誰でも参加できます。はい、誰でも参加できます"}, {"type": "subtitle", "time": 4934.87, "timestamp": "01:22:14", "text": "まだウォーミングアップ段階だ。私たちはただ"}, {"type": "subtitle", "time": 4937.03, "timestamp": "01:22:17", "text": "ウォーミングアップ中。やり方がわからない"}, {"type": "subtitle", "time": 4953.51, "timestamp": "01:22:33", "text": "えっと、待って、インスタグラムをやらなきゃ。"}, {"type": "subtitle", "time": 4954.629, "timestamp": "01:22:34", "text": "もの。待って、待って、待って。忘れた。私"}, {"type": "subtitle", "time": 4956.39, "timestamp": "01:22:36", "text": "忘れた。それはしゃがむ、"}, {"type": "subtitle", "time": 4958.39, "timestamp": "01:22:38", "text": "みんな。しゃがむ姿勢がポイントだ。"}, {"type": "subtitle", "time": 4961.35, "timestamp": "01:22:41", "text": "え、じゃああなたはよくしゃがむの？ええ、私は"}, {"type": "subtitle", "time": 4963.55, "timestamp": "01:22:43", "text": "よくしゃがむ。"}, {"type": "subtitle", "time": 4967.51, "timestamp": "01:22:47", "text": "ああ、本当にしゃがんでるよ。"}, {"type": "subtitle", "time": 4969.75, "timestamp": "01:22:49", "text": "ええ、その方があなたの狙いとしては良いと思います。"}, {"type": "subtitle", "time": 4971.99, "timestamp": "01:22:51", "text": "だからあなたの狙いは良いのです、なぜならあなたは"}, {"type": "subtitle", "time": 4974.87, "timestamp": "01:22:54", "text": "おそらく、全くしゃがまない方がいいでしょう。でもでも私は"}, {"type": "subtitle", "time": 4976.51, "timestamp": "01:22:56", "text": "しゃがんでいるのが聞こえた"}, {"type": "subtitle", "time": 4979.35, "timestamp": "01:22:59", "text": "良い。しかし、しゃがむのは良いことだ。いいね"}]
[{"type": "subtitle", "time": 8581.75, "timestamp": "02:23:01", "text": "あなたが欲しかったナイフ。"}, {"type": "subtitle", "time": 8592.95, "timestamp": "02:23:12", "text": "大きな"}, {"type": "subtitle", "time": 8596.63, "timestamp": "02:23:16", "text": "これが私が欲しかったナイフだ。"}, {"type": "subtitle", "time": 8600.23, "timestamp": "02:23:20", "text": "彼がそれを持っているのを見てください。私は買うことができます"}, {"type": "subtitle", "time": 8603.91, "timestamp": "02:23:23", "text": "あなた。一滴欲しい。"}, {"type": "subtitle", "time": 8606.79, "timestamp": "02:23:26", "text": "ここに銃がある。時間に参加しましょう。参加したいですか？"}, {"type": "subtitle", "time": 8609.23, "timestamp": "02:23:29", "text": "次のもののために？わかった。"}, {"type": "subtitle", "time": 8612.23, "timestamp": "02:23:32", "text": "同意する。空きがあれば、"}, {"type": "subtitle", "time": 8621.349, "timestamp": "02:23:41", "text": "ベーコンを見てください。ツイート。 TWは"}, {"type": "subtitle", "time": 8624.309, "timestamp": "02:23:44", "text": "ヨリー。"}, {"type": "subtitle", "time": 8627.99, "timestamp": "02:23:47", "text": "うん。うん。うん。あれ。うん。"}, {"type": "subtitle", "time": 8630.79, "timestamp": "02:23:50", "text": "くそ。前回、辞退すると言ったでしょう。"}, {"type": "subtitle", "time": 8632.83, "timestamp": "02:23:52", "text": "うん。私 私"}, {"type": "subtitle", "time": 8635.71, "timestamp": "02:23:55", "text": "知る。ジスポッピング。いいえ、私は"}, {"type": "subtitle", "time": 8639.51, "timestamp": "02:23:59", "text": "ない。私は本当に下手なプレーをしている。"}]
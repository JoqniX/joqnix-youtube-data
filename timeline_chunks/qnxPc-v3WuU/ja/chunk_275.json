[{"type": "subtitle", "time": 16501.83, "timestamp": "04:35:01", "text": "知る。アルプスの風景を短時間でご覧いただけます。"}, {"type": "subtitle", "time": 16508.23, "timestamp": "04:35:08", "text": "はい。行きたいなら、これをあげてください"}, {"type": "subtitle", "time": 16510.23, "timestamp": "04:35:10", "text": "フォローする人。覚えていないのですが"}, {"type": "subtitle", "time": 16512.551, "timestamp": "04:35:12", "text": "配信するかどうかは別として、そうなんです。"}, {"type": "subtitle", "time": 16515.109, "timestamp": "04:35:15", "text": "ニース。"}, {"type": "subtitle", "time": 16517.99, "timestamp": "04:35:17", "text": "くそ。ニース。うん。"}, {"type": "subtitle", "time": 16520.47, "timestamp": "04:35:20", "text": "うん。ええ、それが私が"}, {"type": "subtitle", "time": 16523.91, "timestamp": "04:35:23", "text": "やってるんだよ、わかるだろ。それが仕事であり、"}, {"type": "subtitle", "time": 16525.67, "timestamp": "04:35:25", "text": "そういうことだよ。まあ、必要ないけど"}, {"type": "subtitle", "time": 16527.67, "timestamp": "04:35:27", "text": "仕事について説明する必要はない。その"}, {"type": "subtitle", "time": 16529.99, "timestamp": "04:35:29", "text": "ただただ退屈だ。"}, {"type": "subtitle", "time": 16537.269, "timestamp": "04:35:37", "text": "うん、退屈だろうね。"}, {"type": "subtitle", "time": 16540.551, "timestamp": "04:35:40", "text": "あなたみたいに、ほら、それはただ"}, {"type": "subtitle", "time": 16543.349, "timestamp": "04:35:43", "text": "悲しい仕事。"}, {"type": "subtitle", "time": 16545.31, "timestamp": "04:35:45", "text": "私はとても"}, {"type": "subtitle", "time": 16547.59, "timestamp": "04:35:47", "text": "疲れた。心配しないで、ジョー。また、"}, {"type": "subtitle", "time": 16555.91, "timestamp": "04:35:55", "text": "日本にいると、"}, {"type": "subtitle", "time": 16558.07, "timestamp": "04:35:58", "text": "食器を洗うのと同じように、"}, {"type": "subtitle", "time": 16559.99, "timestamp": "04:35:59", "text": "「ああ、そうだね。パンを覚えているよ、"}]
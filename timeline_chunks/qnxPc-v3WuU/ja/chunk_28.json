[{"type": "subtitle", "time": 1681.31, "timestamp": "00:28:01", "text": "親切だけど、あの番組も"}, {"type": "subtitle", "time": 1683.31, "timestamp": "00:28:03", "text": "進歩"}, {"type": "subtitle", "time": 1686.95, "timestamp": "00:28:06", "text": "そこには。ああ、忘れてた。あ、待って、待って、"}, {"type": "subtitle", "time": 1690.59, "timestamp": "00:28:10", "text": "待って。実は忘れてた"}, {"type": "subtitle", "time": 1694.35, "timestamp": "00:28:14", "text": "えーと、これらの垂直の流れは、"}, {"type": "subtitle", "time": 1697.35, "timestamp": "00:28:17", "text": "参加モードは、参加していない人全員に有効です。"}, {"type": "subtitle", "time": 1699.35, "timestamp": "00:28:19", "text": "購読者限定。ああ、忘れてた。忘れた。"}, {"type": "subtitle", "time": 1703.47, "timestamp": "00:28:23", "text": "忘れた。それは忘れていました"}, {"type": "subtitle", "time": 1706.029, "timestamp": "00:28:26", "text": "もの。忘れた。"}, {"type": "subtitle", "time": 1708.269, "timestamp": "00:28:28", "text": "ええ、今は"}, {"type": "subtitle", "time": 1712.31, "timestamp": "00:28:32", "text": "覚えて。今思い出したのですが、これらは"}, {"type": "subtitle", "time": 1715.51, "timestamp": "00:28:35", "text": "垂直の流れですよね？そういう意味で"}, {"type": "subtitle", "time": 1718.47, "timestamp": "00:28:38", "text": "私のストリームをチェックしてください"}, {"type": "subtitle", "time": 1721.269, "timestamp": "00:28:41", "text": "ショートパンツを閲覧して見つけたら"}, {"type": "subtitle", "time": 1722.59, "timestamp": "00:28:42", "text": "それ"}, {"type": "subtitle", "time": 1725.59, "timestamp": "00:28:45", "text": "方法。だから、君はそういう風に思ったんだ、わかるだろ？"}, {"type": "subtitle", "time": 1728.63, "timestamp": "00:28:48", "text": "欲しくないから欲しくない"}, {"type": "subtitle", "time": 1731.59, "timestamp": "00:28:51", "text": "だからあなたは自分に無理強いする"}, {"type": "subtitle", "time": 1735.95, "timestamp": "00:28:55", "text": "購読して、いつものように話しましょう。"}, {"type": "subtitle", "time": 1739.51, "timestamp": "00:28:59", "text": "モードだけど、ああ、作ったよ"}]
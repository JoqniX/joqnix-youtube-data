[{"type": "subtitle", "time": 2821.75, "timestamp": "00:47:01", "text": "新しい私です。ようこそ"}, {"type": "subtitle", "time": 2823.51, "timestamp": "00:47:03", "text": "コンステラス。良い月曜日をお過ごしください"}, {"type": "subtitle", "time": 2827.349, "timestamp": "00:47:07", "text": "午前中がやってくる。いいえ、頑張ってください"}, {"type": "subtitle", "time": 2829.589, "timestamp": "00:47:09", "text": "あなたのこれからの一日。ご来店ありがとうございました"}, {"type": "subtitle", "time": 2832.19, "timestamp": "00:47:12", "text": "今日、私たちと一緒に執筆活動をしましょう。いいえ、結構です。"}, {"type": "subtitle", "time": 2833.87, "timestamp": "00:47:13", "text": "あなた。"}, {"type": "subtitle", "time": 2837.03, "timestamp": "00:47:17", "text": "サタラン・ラヨさん、お越しいただきありがとうございます。"}, {"type": "subtitle", "time": 2839.27, "timestamp": "00:47:19", "text": "今日も。本当に感謝しています。"}, {"type": "subtitle", "time": 2841.51, "timestamp": "00:47:21", "text": "ロン・ステラスへようこそ。楽しんでいただけたでしょうか。"}, {"type": "subtitle", "time": 2843.27, "timestamp": "00:47:23", "text": "今日。それでは、お越しいただきありがとうございました。それ"}, {"type": "subtitle", "time": 2844.589, "timestamp": "00:47:24", "text": "本当の意味は"}, {"type": "subtitle", "time": 2847.829, "timestamp": "00:47:27", "text": "多く。デビルチャマがやって来た。私は"}, {"type": "subtitle", "time": 2850.829, "timestamp": "00:47:30", "text": "私が話した時に悪魔が出現した"}, {"type": "subtitle", "time": 2855.71, "timestamp": "00:47:35", "text": "約 フェアライト 76 または 86 または"}, {"type": "subtitle", "time": 2858.55, "timestamp": "00:47:38", "text": "何でも。あれはすごかった。でも、ありがとう"}, {"type": "subtitle", "time": 2860.47, "timestamp": "00:47:40", "text": "悪魔め。うまくいくことを願っています"}, {"type": "subtitle", "time": 2862.23, "timestamp": "00:47:42", "text": "仕事関係。今は月曜日です。幸運を"}, {"type": "subtitle", "time": 2866.23, "timestamp": "00:47:46", "text": "仕事とか色々あってね。幸運を。しかし"}, {"type": "subtitle", "time": 2870.069, "timestamp": "00:47:50", "text": "また、本日はお越しいただきありがとうございました。"}, {"type": "subtitle", "time": 2873.03, "timestamp": "00:47:53", "text": "Pを倒しました。お越しいただきありがとうございました。"}, {"type": "subtitle", "time": 2875.87, "timestamp": "00:47:55", "text": "今日を楽しんでください。ようこそ"}, {"type": "subtitle", "time": 2878.51, "timestamp": "00:47:58", "text": "コンステルは実り多い一日を迎えるでしょう。"}]
[{"type": "subtitle", "time": 12961.95, "timestamp": "03:36:01", "text": "人々は彼をBRBと呼んだ"}, {"type": "subtitle", "time": 12965.83, "timestamp": "03:36:05", "text": "ストリーマー。でも、今日は"}, {"type": "subtitle", "time": 12968.71, "timestamp": "03:36:08", "text": "今日では、立派な客人として育てられている。としてではなく"}, {"type": "subtitle", "time": 12971.19, "timestamp": "03:36:11", "text": "ちょっと待って、配信でも何でもやろう。それは適切な"}, {"type": "subtitle", "time": 12972.87, "timestamp": "03:36:12", "text": "ゲスト。私たちはただリラックスして"}, {"type": "subtitle", "time": 12974.95, "timestamp": "03:36:14", "text": "今日は一緒に過ごそう"}, {"type": "subtitle", "time": 12979.309, "timestamp": "03:36:19", "text": "えっと、6時まで。まあ、そういうことです。"}, {"type": "subtitle", "time": 12982.95, "timestamp": "03:36:22", "text": "やったー。今日は一緒に過ごす予定です。"}, {"type": "subtitle", "time": 12985.59, "timestamp": "03:36:25", "text": "うん、"}, {"type": "subtitle", "time": 12990.15, "timestamp": "03:36:30", "text": "チキンジョッキー。わかった。よし。"}, {"type": "subtitle", "time": 12993.87, "timestamp": "03:36:33", "text": "ごめん。ちょうどいい感じ"}, {"type": "subtitle", "time": 12996.469, "timestamp": "03:36:36", "text": "そこには。すぐそこに誰もいない"}, {"type": "subtitle", "time": 13000.07, "timestamp": "03:36:40", "text": "それを使っています。そして私は、神様、"}, {"type": "subtitle", "time": 13002.95, "timestamp": "03:36:42", "text": "どうして誰も出勤しなかったんだろう？それ"}, {"type": "subtitle", "time": 13005.59, "timestamp": "03:36:45", "text": "それが私が疑問に思っていた点です。"}, {"type": "subtitle", "time": 13007.429, "timestamp": "03:36:47", "text": "くそ。"}, {"type": "subtitle", "time": 13009.83, "timestamp": "03:36:49", "text": "ところで、ジョイ、元気にしてる？どうやって"}, {"type": "subtitle", "time": 13014.51, "timestamp": "03:36:54", "text": "何をしているの？私は元気です。生き残る、"}, {"type": "subtitle", "time": 13018.07, "timestamp": "03:36:58", "text": "ストレスが溜まっているし、いろいろと。ああ、なんてことだ。おお"}]
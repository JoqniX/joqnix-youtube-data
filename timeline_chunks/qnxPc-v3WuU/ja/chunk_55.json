[{"type": "subtitle", "time": 3301.109, "timestamp": "00:55:01", "text": "星の光が今夜、今日、あなたを導きますように。"}, {"type": "subtitle", "time": 3305.39, "timestamp": "00:55:05", "text": "良い一日をお過ごしください"}, {"type": "subtitle", "time": 3310.069, "timestamp": "00:55:10", "text": "暖かい月曜日、または朝または夕方"}, {"type": "subtitle", "time": 3313.99, "timestamp": "00:55:13", "text": "日曜の夜がやってくる。わかった。こんにちは。バイバイ。"}, {"type": "subtitle", "time": 3315.589, "timestamp": "00:55:15", "text": "それでは、次の配信でお会いしましょう。"}, {"type": "subtitle", "time": 3317.91, "timestamp": "00:55:17", "text": "わかった。今後もっと配信するかどうかはわかりません"}, {"type": "subtitle", "time": 3321.67, "timestamp": "00:55:21", "text": "詳細は後ほど。でももし私がそうしたら、ぜひ来てください"}, {"type": "subtitle", "time": 3346.02, "timestamp": "00:55:46", "text": "[音楽]"}, {"type": "subtitle", "time": 3346.32, "timestamp": "00:55:46", "text": "[拍手]"}]
[{"type": "subtitle", "time": 14461.87, "timestamp": "04:01:01", "text": "最新のストリームを配信します。"}, {"type": "subtitle", "time": 14465.229, "timestamp": "04:01:05", "text": "うん。ああ、それは本当に楽しかった"}, {"type": "subtitle", "time": 14468.55, "timestamp": "04:01:08", "text": "正直にそうするつもりだ。あれは見ていて楽しかった"}, {"type": "subtitle", "time": 14470.75, "timestamp": "04:01:10", "text": "古い流れのように、あなたは"}, {"type": "subtitle", "time": 14473.429, "timestamp": "04:01:13", "text": "自分の声に身を縮めるなんて、私は"}, {"type": "subtitle", "time": 14474.99, "timestamp": "04:01:14", "text": "私"}, {"type": "subtitle", "time": 14478.229, "timestamp": "04:01:18", "text": "言っているの？ああ、それは古いジョギングコースだ。"}, {"type": "subtitle", "time": 14483.309, "timestamp": "04:01:23", "text": "老犬はあまりにも無防備だった。それはあまりにも開放的すぎた。"}, {"type": "subtitle", "time": 14486.51, "timestamp": "04:01:26", "text": "うん。そうそう。のように"}, {"type": "subtitle", "time": 14489.429, "timestamp": "04:01:29", "text": "えーと、明日以降は"}, {"type": "subtitle", "time": 14492.63, "timestamp": "04:01:32", "text": "6月以降の最後の追い込み。えっと、"}, {"type": "subtitle", "time": 14495.51, "timestamp": "04:01:35", "text": "6月は、私はそこにいるだけです"}, {"type": "subtitle", "time": 14496.83, "timestamp": "04:01:36", "text": "あと2週間"}, {"type": "subtitle", "time": 14501.189, "timestamp": "04:01:41", "text": "そしてそれが終われば、試験がある。うん、試験"}, {"type": "subtitle", "time": 14504.79, "timestamp": "04:01:44", "text": "そこに行きます。試験中は"}, {"type": "subtitle", "time": 14506.87, "timestamp": "04:01:46", "text": "えっと、制限しようと思ってたんだけど"}, {"type": "subtitle", "time": 14509.349, "timestamp": "04:01:49", "text": "コラボレーションは、もし追加があれば"}, {"type": "subtitle", "time": 14511.91, "timestamp": "04:01:51", "text": "保留中のもの、私が来るので"}, {"type": "subtitle", "time": 14514.63, "timestamp": "04:01:54", "text": "2週目か3週目に"}, {"type": "subtitle", "time": 14519.11, "timestamp": "04:01:59", "text": "6月の週は最大21日までです。"}]
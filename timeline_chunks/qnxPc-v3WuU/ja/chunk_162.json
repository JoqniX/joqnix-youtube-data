[{"type": "subtitle", "time": 9720.11, "timestamp": "02:42:00", "text": "ピューのように"}, {"type": "subtitle", "time": 9724.469, "timestamp": "02:42:04", "text": "え。モニターを保管しなければならなかった"}, {"type": "subtitle", "time": 9727.51, "timestamp": "02:42:07", "text": "うん。だって私の力は、えっと、なんて呼ぶんだっけ"}, {"type": "subtitle", "time": 9730.309, "timestamp": "02:42:10", "text": "それ？目玉みたいなやつが、えっと、"}, {"type": "subtitle", "time": 9732.63, "timestamp": "02:42:12", "text": "大幅に増加している。だから私は近づかないようにしなければならなかった"}, {"type": "subtitle", "time": 9736.63, "timestamp": "02:42:16", "text": "私の顔の近くにあるモニター。以前はよく＿＿していた"}, {"type": "subtitle", "time": 9740.23, "timestamp": "02:42:20", "text": "そのままにしておいてくれ、他のプロを見たから"}, {"type": "subtitle", "time": 9742.63, "timestamp": "02:42:22", "text": "そして私は「ああ、だからあなたは"}, {"type": "subtitle", "time": 9746.79, "timestamp": "02:42:26", "text": "狙いを定めるか、それぞれが適切に見えるようにする"}, {"type": "subtitle", "time": 9749.429, "timestamp": "02:42:29", "text": "すごく近くでじっと見つめると、"}, {"type": "subtitle", "time": 9751.91, "timestamp": "02:42:31", "text": "「モニターか何かに。」ああ、そうだね。"}, {"type": "subtitle", "time": 9754.389, "timestamp": "02:42:34", "text": "しかし、目にも良くない。うん。"}, {"type": "subtitle", "time": 9759.349, "timestamp": "02:42:39", "text": "うん。うん。そうです。それは本当です。"}, {"type": "subtitle", "time": 9761.59, "timestamp": "02:42:41", "text": "えっと、あなたは眼鏡をかけているんですよね？それで、"}, {"type": "subtitle", "time": 9764.469, "timestamp": "02:42:44", "text": "あなたのメガネは、えっと、"}, {"type": "subtitle", "time": 9766.63, "timestamp": "02:42:46", "text": "ブルーライトフィルターみたいなやつ。おお、"}, {"type": "subtitle", "time": 9769.429, "timestamp": "02:42:49", "text": "うん。確かにそういう機能があります。あります"}, {"type": "subtitle", "time": 9772.23, "timestamp": "02:42:52", "text": "それ。うん。だって、私には光があるから"}, {"type": "subtitle", "time": 9773.67, "timestamp": "02:42:53", "text": "それは何と呼ばれますか？忘れた。"}, {"type": "subtitle", "time": 9776.07, "timestamp": "02:42:56", "text": "光恐怖症みたいなもの。うん。うん。だから、"}]
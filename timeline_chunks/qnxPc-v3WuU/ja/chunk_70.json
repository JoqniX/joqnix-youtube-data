[{"type": "subtitle", "time": 4203.03, "timestamp": "01:10:03", "text": "私は準備ができています。こんにちは。聞こえますか？"}, {"type": "subtitle", "time": 4205.03, "timestamp": "01:10:05", "text": "えっと、こんにちは。"}, {"type": "subtitle", "time": 4206.8, "timestamp": "01:10:06", "text": "こんにちは。 先輩の声が聞こえますか？待って。"}, {"type": "subtitle", "time": 4209.84, "timestamp": "01:10:09", "text": "先輩の声が聞こえますか？待って。 彼はこの件に関してはあまりにも無関心だと思う。"}, {"type": "subtitle", "time": 4212.8, "timestamp": "01:10:12", "text": "彼はこの件に関してはあまりにも無関心だと思う。 待って頂けますか。いいえ。いいえ。なぜなら私が追加したからです。"}, {"type": "subtitle", "time": 4216.239, "timestamp": "01:10:16", "text": "待って頂けますか。いいえ。いいえ。なぜなら私が追加したからです。 ストリームキットのやつ。ああ、わかりました。"}, {"type": "subtitle", "time": 4219.12, "timestamp": "01:10:19", "text": "ストリームキットのやつ。ああ、わかりました。 わかった。わかった。うん。大丈夫。大丈夫。"}, {"type": "subtitle", "time": 4223.76, "timestamp": "01:10:23", "text": "わかった。わかった。うん。大丈夫。大丈夫。 彼の声が聞こえますか？分かりますか？"}, {"type": "subtitle", "time": 4227.04, "timestamp": "01:10:27", "text": "彼の声が聞こえますか？分かりますか？ 何か？"}, {"type": "subtitle", "time": 4233.75, "timestamp": "01:10:33", "text": "こんにちは。こんにちは。"}, {"type": "subtitle", "time": 4236.63, "timestamp": "01:10:36", "text": "例えば、文章を書いてください。"}, {"type": "subtitle", "time": 4240.11, "timestamp": "01:10:40", "text": "何てことだ。何て言えばいいんだろう？いやいや。おお、"}, {"type": "subtitle", "time": 4247.84, "timestamp": "01:10:47", "text": "今日一番良い。"}, {"type": "subtitle", "time": 4249.75, "timestamp": "01:10:49", "text": "[音楽]"}, {"type": "subtitle", "time": 4252.149, "timestamp": "01:10:52", "text": "私は何て言ったの？そうそう。うん。うん。"}, {"type": "subtitle", "time": 4253.43, "timestamp": "01:10:53", "text": "それで十分です。それで十分です。"}, {"type": "subtitle", "time": 4257.83, "timestamp": "01:10:57", "text": "あなたの声は大丈夫だと思います。うん、"}]
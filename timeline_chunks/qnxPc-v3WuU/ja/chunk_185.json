[{"type": "subtitle", "time": 11105.429, "timestamp": "03:05:05", "text": "わかった。"}, {"type": "subtitle", "time": 11106.95, "timestamp": "03:05:06", "text": "おお、"}, {"type": "subtitle", "time": 11110.23, "timestamp": "03:05:10", "text": "彼らは既に中にいた。"}, {"type": "subtitle", "time": 11113.83, "timestamp": "03:05:13", "text": "最後に残ったプレイヤー。あ、私の間違いでした。私の"}, {"type": "subtitle", "time": 11127.269, "timestamp": "03:05:27", "text": "何だって？私にもわからない。私 私"}, {"type": "subtitle", "time": 11131.07, "timestamp": "03:05:31", "text": "私の頭の中にあった。大丈夫。その"}, {"type": "subtitle", "time": 11133.83, "timestamp": "03:05:33", "text": "わかった。私は知らなかった"}, {"type": "subtitle", "time": 11140.99, "timestamp": "03:05:40", "text": "何？私は怖がらなかった。私はこう思った"}, {"type": "subtitle", "time": 11143.429, "timestamp": "03:05:43", "text": "混乱しているのは、ただ彼らがただ"}, {"type": "subtitle", "time": 11146.79, "timestamp": "03:05:46", "text": "文字通り、横にあるWキーを押してください。"}, {"type": "subtitle", "time": 11150.269, "timestamp": "03:05:50", "text": "ええ、そうでしたよ。ああ、"}, {"type": "subtitle", "time": 11157.469, "timestamp": "03:05:57", "text": "うん。そうそう。私は決して"}]
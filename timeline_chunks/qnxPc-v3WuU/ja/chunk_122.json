[{"type": "subtitle", "time": 7331.109, "timestamp": "02:02:11", "text": "私は、"}, {"type": "subtitle", "time": 7333.35, "timestamp": "02:02:13", "text": "アリーナも待って、何してるの"}, {"type": "subtitle", "time": 7336.629, "timestamp": "02:02:16", "text": "もう一度言っていますか？フリーファイアみたいに。うん。ない"}, {"type": "subtitle", "time": 7338.83, "timestamp": "02:02:18", "text": "フリーファイア"}, {"type": "subtitle", "time": 7341.99, "timestamp": "02:02:21", "text": "プリファイアリング、まるであなたが知っているように、"}, {"type": "subtitle", "time": 7344.31, "timestamp": "02:02:24", "text": "えっと、僕たちはデスマッチに参加してたんだよね？"}, {"type": "subtitle", "time": 7347.99, "timestamp": "02:02:27", "text": "レンは、私たちを見たとき、発射準備中だった。"}, {"type": "subtitle", "time": 7351.189, "timestamp": "02:02:31", "text": "うん。うん。それはオーディンを手に入れるのに役立ちますか？"}, {"type": "subtitle", "time": 7355.75, "timestamp": "02:02:35", "text": "殺すか、再スキルアップするか、隠れるのが好きですか？"}, {"type": "subtitle", "time": 7358.95, "timestamp": "02:02:38", "text": "それなら、やってみればうまくいく？わからない。うん。"}]
[{"type": "subtitle", "time": 8762.15, "timestamp": "02:26:02", "text": "彼はどこにいたのか？ああ、彼は来ていた"}, {"type": "subtitle", "time": 8765.59, "timestamp": "02:26:05", "text": "CT出身だと思います。 CTですか、それともIですか"}, {"type": "subtitle", "time": 8766.95, "timestamp": "02:26:06", "text": "全く知らない。彼は"}, {"type": "subtitle", "time": 8770.79, "timestamp": "02:26:10", "text": "スポーン。ええ、私は"}, {"type": "subtitle", "time": 8777.51, "timestamp": "02:26:17", "text": "どうやって全部終わらせたのか分からない"}, {"type": "subtitle", "time": 8779.67, "timestamp": "02:26:19", "text": "このゲームでは。"}, {"type": "subtitle", "time": 8783.27, "timestamp": "02:26:23", "text": "私のネット接続が悪い。大丈夫。大丈夫です。"}, {"type": "subtitle", "time": 8791.429, "timestamp": "02:26:31", "text": "参加したい人はいますか？"}, {"type": "subtitle", "time": 8793.03, "timestamp": "02:26:33", "text": "1対1で勝負したいの？ええと、私たちは"}, {"type": "subtitle", "time": 8795.91, "timestamp": "02:26:35", "text": "多分後でやるよ。おそらく"}, {"type": "subtitle", "time": 8798.19, "timestamp": "02:26:38", "text": "あなたのネットは問題ありません。"}, {"type": "subtitle", "time": 8802.23, "timestamp": "02:26:42", "text": "右？おそらく。とても大変だった。大丈夫。"}, {"type": "subtitle", "time": 8804.07, "timestamp": "02:26:44", "text": "ご心配なく。待って、あなたは"}, {"type": "subtitle", "time": 8807.27, "timestamp": "02:26:47", "text": "誰か来る人いますか？彼は"}, {"type": "subtitle", "time": 8810.07, "timestamp": "02:26:50", "text": "来る？ああ、彼がそう望むならね。ええ、もちろんです。彼"}, {"type": "subtitle", "time": 8813.83, "timestamp": "02:26:53", "text": "できる。彼を招待し続けるつもりだ。うん。"}, {"type": "subtitle", "time": 8816.79, "timestamp": "02:26:56", "text": "彼は来た。今は大丈夫です。うん。おお"}, {"type": "subtitle", "time": 8819.91, "timestamp": "02:26:59", "text": "神。ええと、行きましょう。スパイに夢中。ああ、あなたは"}]
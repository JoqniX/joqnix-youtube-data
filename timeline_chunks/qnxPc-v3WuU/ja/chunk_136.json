[{"type": "subtitle", "time": 8162.229, "timestamp": "02:16:02", "text": "わかった。待って、富士山があなたのチャットにいますよ。"}, {"type": "subtitle", "time": 8164.95, "timestamp": "02:16:04", "text": "えっと、待って。富士。"}, {"type": "subtitle", "time": 8167.99, "timestamp": "02:16:07", "text": "えっと、富士山って言いませんでしたっけ？聞こえましたか？"}, {"type": "subtitle", "time": 8170.91, "timestamp": "02:16:10", "text": "聞こえたような気がする。いいえ、"}, {"type": "subtitle", "time": 8174.31, "timestamp": "02:16:14", "text": "IからEまで。"}, {"type": "subtitle", "time": 8178.069, "timestamp": "02:16:18", "text": "ああ、Twitch。ツイード。そう、そうやって"}, {"type": "subtitle", "time": 8179.75, "timestamp": "02:16:19", "text": "その名前を発音してください。わかった。敵を発見"}, {"type": "subtitle", "time": 8182.589, "timestamp": "02:16:22", "text": "B."}]
[{"type": "subtitle", "time": 5944.629, "timestamp": "01:39:04", "text": "何？ワンタップで、まるで"}, {"type": "subtitle", "time": 5977.91, "timestamp": "01:39:37", "text": "わかった。単にピングの問題だと思います。あなた"}, {"type": "subtitle", "time": 5980.55, "timestamp": "01:39:40", "text": "何だと思う？なぜキャンプをしているのですか"}, {"type": "subtitle", "time": 5983.35, "timestamp": "01:39:43", "text": "それ？これはデスマッチだ。はい、できません"}, {"type": "subtitle", "time": 5985.229, "timestamp": "01:39:45", "text": "彼らを責めなさい。彼らのものだと思う"}, {"type": "subtitle", "time": 5989.189, "timestamp": "01:39:49", "text": "スタイル。彼らはそうするのが好きなので、"}]
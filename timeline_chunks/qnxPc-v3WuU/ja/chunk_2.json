[{"type": "subtitle", "time": 120.31, "timestamp": "00:02:00", "text": "はい。うん。また、これらの作業の流れでは、"}, {"type": "subtitle", "time": 123.19, "timestamp": "00:02:03", "text": "それらは私にとって不可欠だと感じます"}, {"type": "subtitle", "time": 125.749, "timestamp": "00:02:05", "text": "少なくとも、また私たちには"}, {"type": "subtitle", "time": 128.71, "timestamp": "00:02:08", "text": "オネクシアにはやるべきことがたくさんあるよね？"}, {"type": "subtitle", "time": 129.71, "timestamp": "00:02:09", "text": "の"}, {"type": "subtitle", "time": 135.71, "timestamp": "00:02:15", "text": "理由としては、"}, {"type": "subtitle", "time": 139.67000000000002, "timestamp": "00:02:19", "text": "クリエイター 私たちは楽しいエンターテイメントを持っています"}, {"type": "subtitle", "time": 141.27, "timestamp": "00:02:21", "text": "ゲームのようなものと"}, {"type": "subtitle", "time": 145.27, "timestamp": "00:02:25", "text": "すべてですが、主に主に主に私は"}, {"type": "subtitle", "time": 147.589, "timestamp": "00:02:27", "text": "私が目指すものに向かって努力したい"}, {"type": "subtitle", "time": 151.11, "timestamp": "00:02:31", "text": "私の大切な願いを叶え、"}, {"type": "subtitle", "time": 154.55, "timestamp": "00:02:34", "text": "目標は、まるで自分のコンサートを開くようなものだ"}, {"type": "subtitle", "time": 157.19, "timestamp": "00:02:37", "text": "自分の作品やプロジェクトを持っていて、"}, {"type": "subtitle", "time": 159.82999999999998, "timestamp": "00:02:39", "text": "ウェブサイト関連のものなど、すべて"}, {"type": "subtitle", "time": 164.589, "timestamp": "00:02:44", "text": "いいえ、そうですね、主に私が願っているのは"}, {"type": "subtitle", "time": 168.22899999999998, "timestamp": "00:02:48", "text": "その技術的な詳細を学ぶには、"}, {"type": "subtitle", "time": 171.91, "timestamp": "00:02:51", "text": "そして、そういうことができるようになる、みたいなこと"}, {"type": "subtitle", "time": 175.19, "timestamp": "00:02:55", "text": "そうすれば私は人に教えるのではなく教えることができる"}, {"type": "subtitle", "time": 178.50900000000001, "timestamp": "00:02:58", "text": "人々や、人々を理解させるような人々、あるいは"}]
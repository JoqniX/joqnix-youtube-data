[{"type": "subtitle", "time": 13442.03, "timestamp": "03:44:02", "text": "ええ、そうです"}, {"type": "subtitle", "time": 13444.71, "timestamp": "03:44:04", "text": "そこに行ったことがあるということは、何かしらあったということだろう。"}, {"type": "subtitle", "time": 13447.91, "timestamp": "03:44:07", "text": "うん。私は後悔している"}, {"type": "subtitle", "time": 13450.229, "timestamp": "03:44:10", "text": "イベント。もっとうまくできたはずだ"}, {"type": "subtitle", "time": 13451.07, "timestamp": "03:44:11", "text": "そして"}, {"type": "subtitle", "time": 13455.59, "timestamp": "03:44:15", "text": "すべて、でも、そう、それは"}, {"type": "subtitle", "time": 13457.07, "timestamp": "03:44:17", "text": "は。いいえ、"}, {"type": "subtitle", "time": 13460.55, "timestamp": "03:44:20", "text": "これは初めてのことでした"}, {"type": "subtitle", "time": 13462.389, "timestamp": "03:44:22", "text": "こういうことをするのが好きです。だから、"}, {"type": "subtitle", "time": 13464.95, "timestamp": "03:44:24", "text": "もちろん、完璧ではないでしょう。"}, {"type": "subtitle", "time": 13468.07, "timestamp": "03:44:28", "text": "しかし、あなたは今経験があり、"}, {"type": "subtitle", "time": 13470.71, "timestamp": "03:44:30", "text": "あなたは何をすべきか、何ができるかを知っている"}, {"type": "subtitle", "time": 13473.51, "timestamp": "03:44:33", "text": "他者を助けると同時に、自分自身も助ける。はい。真実。"}, {"type": "subtitle", "time": 13475.309, "timestamp": "03:44:35", "text": "真実。このタイプの"}, {"type": "subtitle", "time": 13479.03, "timestamp": "03:44:39", "text": "もの。ほら、ほとんどの人は"}, {"type": "subtitle", "time": 13481.99, "timestamp": "03:44:41", "text": "ジョアトンをしながら話した人も"}, {"type": "subtitle", "time": 13485.269, "timestamp": "03:44:45", "text": "あなたにアドバイスをしました。"}, {"type": "subtitle", "time": 13487.03, "timestamp": "03:44:47", "text": "やってみて。すでにそうした人たちは"}, {"type": "subtitle", "time": 13489.83, "timestamp": "03:44:49", "text": "ドナソン、知ってる？はい。はい。はい。はい。"}, {"type": "subtitle", "time": 13491.75, "timestamp": "03:44:51", "text": "うん。彼らはあなたを助けてくれたし、"}, {"type": "subtitle", "time": 13493.67, "timestamp": "03:44:53", "text": "君はそういう人になれるんだよ、ほら、今、"}, {"type": "subtitle", "time": 13495.95, "timestamp": "03:44:55", "text": "あなたは自分を"}, {"type": "subtitle", "time": 13498.71, "timestamp": "03:44:58", "text": "プロの配信者。"}]
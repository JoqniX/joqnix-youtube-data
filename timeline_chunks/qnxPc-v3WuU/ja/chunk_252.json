[{"type": "subtitle", "time": 15120.469, "timestamp": "04:12:00", "text": "それを見つけてください。ほら、私はただ、私は"}, {"type": "subtitle", "time": 15123.03, "timestamp": "04:12:03", "text": "Pという人物の名前を覚えておいてください。"}, {"type": "subtitle", "time": 15125.83, "timestamp": "04:12:05", "text": "えっと、まず第一にサイコパスだと思う"}, {"type": "subtitle", "time": 15127.75, "timestamp": "04:12:07", "text": "一人はサイコパスとかそういうのにとても親切だった。"}, {"type": "subtitle", "time": 15131.03, "timestamp": "04:12:11", "text": "個人的にはとても気に入りました。サバンナは"}, {"type": "subtitle", "time": 15134.229, "timestamp": "04:12:14", "text": "サバンナと一緒に。その時、"}, {"type": "subtitle", "time": 15138.309, "timestamp": "04:12:18", "text": "ほとんどの人が参加し、彼女は"}, {"type": "subtitle", "time": 15140.79, "timestamp": "04:12:20", "text": "しばらく配信してないけど、"}, {"type": "subtitle", "time": 15143.03, "timestamp": "04:12:23", "text": "彼女をあなたのストリームに連れてきたのは"}, {"type": "subtitle", "time": 15151.429, "timestamp": "04:12:31", "text": "それは、クロスのようなものだった"}, {"type": "subtitle", "time": 15153.99, "timestamp": "04:12:33", "text": "トップ5だけど、まあ、わかるでしょ"}, {"type": "subtitle", "time": 15156.79, "timestamp": "04:12:36", "text": "私にとって一番は、"}, {"type": "subtitle", "time": 15161.11, "timestamp": "04:12:41", "text": "Cherryさんと一緒に日本語を学べば"}, {"type": "subtitle", "time": 15173.91, "timestamp": "04:12:53", "text": "協力する 人々を見る"}, {"type": "subtitle", "time": 15176.63, "timestamp": "04:12:56", "text": "チャットと、皆さんが楽しんでいる様子。うん、"}, {"type": "subtitle", "time": 15179.91, "timestamp": "04:12:59", "text": "それは良かった。では、もう1つ。"}]
[{"type": "subtitle", "time": 9372.79, "timestamp": "02:36:12", "text": "ああ、アニーク。私が試みたこと"}, {"type": "subtitle", "time": 9375.75, "timestamp": "02:36:15", "text": "しゃがむ、でもしゃがむことができないのは"}, {"type": "subtitle", "time": 9383.51, "timestamp": "02:36:23", "text": "いいえ。"}, {"type": "subtitle", "time": 9386.99, "timestamp": "02:36:26", "text": "何てことだ。 TD。ああ、"}, {"type": "subtitle", "time": 9390.19, "timestamp": "02:36:30", "text": "神。うん。さよなら。勝っているのは誰ですか？"}, {"type": "subtitle", "time": 9399.51, "timestamp": "02:36:39", "text": "何てことだ。私は3つの頭をぶつけている"}, {"type": "subtitle", "time": 9400.75, "timestamp": "02:36:40", "text": "行。"}, {"type": "subtitle", "time": 9403.51, "timestamp": "02:36:43", "text": "なぜ？おお、"}, {"type": "subtitle", "time": 9407.83, "timestamp": "02:36:47", "text": "この飛び跳ねるジョークを見てください。"}]
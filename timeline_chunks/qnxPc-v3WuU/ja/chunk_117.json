[{"type": "subtitle", "time": 7023.51, "timestamp": "01:57:03", "text": "台本通りの劇のように演じる、ということですよね？うん。"}, {"type": "subtitle", "time": 7025.589, "timestamp": "01:57:05", "text": "わかった。さあ行こう。待って、あのね？"}, {"type": "subtitle", "time": 7028.149, "timestamp": "01:57:08", "text": "エスカレーションをプレイしてから、"}, {"type": "subtitle", "time": 7030.07, "timestamp": "01:57:10", "text": "複製して、それからスパイクをプレイして"}, {"type": "subtitle", "time": 7037.31, "timestamp": "01:57:17", "text": "ああ、これは"}, {"type": "subtitle", "time": 7041.03, "timestamp": "01:57:21", "text": "なんてバカなんだ。"}, {"type": "subtitle", "time": 7043.83, "timestamp": "01:57:23", "text": "待って、私だけ？それとも聞こえない？"}, {"type": "subtitle", "time": 7046.31, "timestamp": "01:57:26", "text": "話している"}, {"type": "subtitle", "time": 7050.07, "timestamp": "01:57:30", "text": "全く？あなたは全く話さない。うん。"}, {"type": "subtitle", "time": 7052.31, "timestamp": "01:57:32", "text": "うん。うん。うん。私はすぐに忘れてしまうんです。"}, {"type": "subtitle", "time": 7054.55, "timestamp": "01:57:34", "text": "何てことだ。忘れてるよ。あなたは"}, {"type": "subtitle", "time": 7056.79, "timestamp": "01:57:36", "text": "話すのを忘れてしまう。いいえ。いいえ。私は"}, {"type": "subtitle", "time": 7059.709, "timestamp": "01:57:39", "text": "話している。私は押し下げるのを忘れた"}]
[{"type": "subtitle", "time": 2220.03, "timestamp": "00:37:00", "text": "[音楽]"}, {"type": "subtitle", "time": 2222.55, "timestamp": "00:37:02", "text": "ああ、私は何をしていたんだろう？私は何者だったのか"}, {"type": "subtitle", "time": 2224.91, "timestamp": "00:37:04", "text": "何について話しているのですか？文句を言うのを忘れてた"}, {"type": "subtitle", "time": 2227.67, "timestamp": "00:37:07", "text": "そこには。ええ、そうですね。えーっと、あなたはこう思いますか"}, {"type": "subtitle", "time": 2230.87, "timestamp": "00:37:10", "text": "サブブリーモードは良いですか？そうでない場合は、"}, {"type": "subtitle", "time": 2232.99, "timestamp": "00:37:12", "text": "いつも"}, {"type": "subtitle", "time": 2234.829, "timestamp": "00:37:14", "text": "変化のように"}, {"type": "subtitle", "time": 2237.43, "timestamp": "00:37:17", "text": "それ。つまり、現時点では、"}, {"type": "subtitle", "time": 2241.71, "timestamp": "00:37:21", "text": "どんな感じ？はい、私は信じます"}, {"type": "subtitle", "time": 2245.87, "timestamp": "00:37:25", "text": "私のいつもの配信だと思います"}, {"type": "subtitle", "time": 2247.71, "timestamp": "00:37:27", "text": "より"}, {"type": "subtitle", "time": 2251.19, "timestamp": "00:37:31", "text": "念のため、もう一度確認させてください。は"}, {"type": "subtitle", "time": 2252.75, "timestamp": "00:37:32", "text": "いつもの配信"}, {"type": "subtitle", "time": 2256.31, "timestamp": "00:37:36", "text": "の上？待って、私のいつもの配信も"}, {"type": "subtitle", "time": 2259.43, "timestamp": "00:37:39", "text": "誰でもモード。あ、待って。私はそうしなければならないかもしれない"}, {"type": "subtitle", "time": 2263.55, "timestamp": "00:37:43", "text": "それをリセットしてください。え、本当に？これらすべて"}, {"type": "subtitle", "time": 2265.15, "timestamp": "00:37:45", "text": "時間？"}]
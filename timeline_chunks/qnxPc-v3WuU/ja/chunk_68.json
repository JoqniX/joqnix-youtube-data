[{"type": "subtitle", "time": 4080.91, "timestamp": "01:08:00", "text": "準備ができて。"}, {"type": "subtitle", "time": 4083.589, "timestamp": "01:08:03", "text": "うん。わかった。ささやきを送るよ"}, {"type": "subtitle", "time": 4087.19, "timestamp": "01:08:07", "text": "彼女へ。何てことだ。はい。そうですね、2つくらい"}, {"type": "subtitle", "time": 4088.589, "timestamp": "01:08:08", "text": "私たちの。"}, {"type": "subtitle", "time": 4091.109, "timestamp": "01:08:11", "text": "うん。あ、待って。私はストレスを感じませんでした"}, {"type": "subtitle", "time": 4094.029, "timestamp": "01:08:14", "text": "Discordでのテスト"}, {"type": "subtitle", "time": 4096.55, "timestamp": "01:08:16", "text": "音量。なんてこった。なんてこった。なんてこった。なんてこった。いいえ。"}, {"type": "subtitle", "time": 4098.95, "timestamp": "01:08:18", "text": "いや。いや。いや。いや。いや。いや。ああ、いや。何をするか？"}, {"type": "subtitle", "time": 4100.229, "timestamp": "01:08:20", "text": "何をするか？何をするか？何をするか？何"}, {"type": "subtitle", "time": 4102.63, "timestamp": "01:08:22", "text": "何をすべきか？何をするか？何をするか？おお。何"}, {"type": "subtitle", "time": 4105.03, "timestamp": "01:08:25", "text": "何をすべきか？何をするか？何をするか？何を"}, {"type": "subtitle", "time": 4108.11, "timestamp": "01:08:28", "text": "する？なんてこった。なんてこった。なんてこった。いいえ。いいえ。いいえ。いいえ。"}, {"type": "subtitle", "time": 4118.749, "timestamp": "01:08:38", "text": "確認するにはどうすればいいですか？いやいや。わかった。"}, {"type": "subtitle", "time": 4120.829, "timestamp": "01:08:40", "text": "わかった。私にさせて"}, {"type": "subtitle", "time": 4124.63, "timestamp": "01:08:44", "text": "知る。もしあなたが私に知らせてくれるなら、教えてください。"}, {"type": "subtitle", "time": 4127.43, "timestamp": "01:08:47", "text": "あなたはこれを聞きます。わかった。これは私たちが"}, {"type": "subtitle", "time": 4128.51, "timestamp": "01:08:48", "text": "テスト中"}, {"type": "subtitle", "time": 4136.51, "timestamp": "01:08:56", "text": "二重に聞こえる場合はお知らせください"}, {"type": "subtitle", "time": 4138.709, "timestamp": "01:08:58", "text": "オーディオ。これは効果がありますか？これは私に効きますか？"}]
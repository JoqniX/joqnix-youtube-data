[{"type": "subtitle", "time": 15660.95, "timestamp": "04:21:00", "text": "それ。もしあなたがただこうだったら、ほら"}, {"type": "subtitle", "time": 15663.11, "timestamp": "04:21:03", "text": "何？考えるのをやめろ。私は行くと思います"}, {"type": "subtitle", "time": 15665.91, "timestamp": "04:21:05", "text": "大丈夫だよ、わかるだろ。なぜあなたは"}, {"type": "subtitle", "time": 15667.67, "timestamp": "04:21:07", "text": "そう思いますか？私は"}, {"type": "subtitle", "time": 15670.309, "timestamp": "04:21:10", "text": "これらすべてを正しく行う。うん。あなたが知っている、"}, {"type": "subtitle", "time": 15671.83, "timestamp": "04:21:11", "text": "なぜなら"}, {"type": "subtitle", "time": 15673.75, "timestamp": "04:21:13", "text": "私たちは良い友達ですよね？私たちは元気です。"}, {"type": "subtitle", "time": 15677.189, "timestamp": "04:21:17", "text": "良い友達。はい。はい。はい。"}, {"type": "subtitle", "time": 15680.87, "timestamp": "04:21:20", "text": "だから、たとえあなたが超有名になって私が"}, {"type": "subtitle", "time": 15684.149, "timestamp": "04:21:24", "text": "2人の視聴者のストリーマーのように、私は"}, {"type": "subtitle", "time": 15686.07, "timestamp": "04:21:26", "text": "今でもあなたは私の親友です、"}, {"type": "chat", "time": 15687.254, "timestamp": "04:21:27", "author": "@kaiguyniki", "avatar": "https://yt4.ggpht.com/f9aZERpOc1bv1JDUl12ZTXeQ7j1KdXBflkbl-6qlBLzM-hbbEQKWUlPpcJJxTU-qSUwNxrez=s64-c-k-c0x00ffffff-no-rj", "message": "best thing to just have fun"}, {"type": "subtitle", "time": 15688.87, "timestamp": "04:21:28", "text": "知る。何も変わらないだろう。"}, {"type": "subtitle", "time": 15690.95, "timestamp": "04:21:30", "text": "私はあなたが私に見せてくれたと信じています"}, {"type": "subtitle", "time": 15693.83, "timestamp": "04:21:33", "text": "DMの例は、誰かが見せるようなものです"}, {"type": "subtitle", "time": 15696.229, "timestamp": "04:21:36", "text": "他の人の配信と、あなたが覚えているように"}, {"type": "subtitle", "time": 15697.99, "timestamp": "04:21:37", "text": "それ。"}, {"type": "subtitle", "time": 15701.83, "timestamp": "04:21:41", "text": "うん。ええ、わかっています。なぜなら、私がそれに同意するからだ。"}, {"type": "subtitle", "time": 15705.389, "timestamp": "04:21:45", "text": "うん。ストレスが溜まりすぎていたから"}, {"type": "subtitle", "time": 15709.189, "timestamp": "04:21:49", "text": "いつかはそうなるだろう。数字のように"}, {"type": "subtitle", "time": 15710.59, "timestamp": "04:21:50", "text": "あれ"}, {"type": "subtitle", "time": 15714.87, "timestamp": "04:21:54", "text": "だって、私が試したコラボの中には"}, {"type": "subtitle", "time": 15717.83, "timestamp": "04:21:57", "text": "人々に連絡を取るために、私は連絡を取りました"}]
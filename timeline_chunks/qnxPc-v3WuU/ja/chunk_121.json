[{"type": "subtitle", "time": 7260.83, "timestamp": "02:01:00", "text": "ああ、"}, {"type": "subtitle", "time": 7263.229, "timestamp": "02:01:03", "text": "神。あなたは見ましたか"}, {"type": "subtitle", "time": 7266.229, "timestamp": "02:01:06", "text": "それ？何てことだ。"}, {"type": "subtitle", "time": 7284.43, "timestamp": "02:01:24", "text": "私"}, {"type": "subtitle", "time": 7287.35, "timestamp": "02:01:27", "text": "できなかった。事前発射がうまくいくと思った"}, {"type": "subtitle", "time": 7290.149, "timestamp": "02:01:30", "text": "しかし、そうはならなかった。なんてこった。"}, {"type": "subtitle", "time": 7292.709, "timestamp": "02:01:32", "text": "じゃあ、プリファイアは、"}, {"type": "subtitle", "time": 7295.35, "timestamp": "02:01:35", "text": "LMGを使う？"}, {"type": "subtitle", "time": 7297.83, "timestamp": "02:01:37", "text": "どのような方法を使えば、事前発射は効果を発揮しますか？"}, {"type": "subtitle", "time": 7301.43, "timestamp": "02:01:41", "text": "例えば、牡羊座やオーディンを使う場合など。"}, {"type": "subtitle", "time": 7303.589, "timestamp": "02:01:43", "text": "事前発射中に、それは殺傷に効果がありますか？"}, {"type": "subtitle", "time": 7308.709, "timestamp": "02:01:48", "text": "その人物？えっと、遅延のせいですよね？私"}, {"type": "subtitle", "time": 7312.07, "timestamp": "02:01:52", "text": "火災前ってどういう意味かわかりません"}, {"type": "subtitle", "time": 7313.91, "timestamp": "02:01:53", "text": "角に敵がいるのは分かっている、"}, {"type": "subtitle", "time": 7316.87, "timestamp": "02:01:56", "text": "射撃を開始して中に入る"}]
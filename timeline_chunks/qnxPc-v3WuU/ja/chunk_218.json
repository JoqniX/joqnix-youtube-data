[{"type": "subtitle", "time": 13080.07, "timestamp": "03:38:00", "text": "くそ。 2か月間ストリーミング配信する"}, {"type": "subtitle", "time": 13083.51, "timestamp": "03:38:03", "text": "漕げよ、間髪入れずに？三つ"}, {"type": "subtitle", "time": 13085.67, "timestamp": "03:38:05", "text": "数ヶ月。今回で３人目。そうそう。これ"}, {"type": "subtitle", "time": 13087.75, "timestamp": "03:38:07", "text": "この3ヶ月間ですよね？うん。その"}, {"type": "subtitle", "time": 13089.429, "timestamp": "03:38:09", "text": "３ヶ月になるよ。はい。うん。さあ"}, {"type": "subtitle", "time": 13092.15, "timestamp": "03:38:12", "text": "おめでとうございます。"}, {"type": "subtitle", "time": 13100.389, "timestamp": "03:38:20", "text": "それは、それとこれとこれ、えっとこれのようなものではありません"}, {"type": "subtitle", "time": 13103.269, "timestamp": "03:38:23", "text": "今月はコラボ企画ばかりだったよね？"}, {"type": "subtitle", "time": 13105.11, "timestamp": "03:38:25", "text": "今月。今月と来月"}, {"type": "subtitle", "time": 13107.19, "timestamp": "03:38:27", "text": "すべてコラボレーションになります。私はそうは思わない"}, {"type": "subtitle", "time": 13109.349, "timestamp": "03:38:29", "text": "そうしようと思う"}, {"type": "subtitle", "time": 13111.59, "timestamp": "03:38:31", "text": "ええと、それ以上のことは何も。私は持っていません"}, {"type": "subtitle", "time": 13114.389, "timestamp": "03:38:34", "text": "今から何かをする時間です。"}, {"type": "subtitle", "time": 13116.229, "timestamp": "03:38:36", "text": "コラボは止められない、なぜなら"}, {"type": "subtitle", "time": 13118.79, "timestamp": "03:38:38", "text": "文字通り私が招待したすべての人"}, {"type": "subtitle", "time": 13123.309, "timestamp": "03:38:43", "text": "薬と"}, {"type": "subtitle", "time": 13127.349, "timestamp": "03:38:47", "text": "もの。だから私たちは、現実世界で"}, {"type": "subtitle", "time": 13130.07, "timestamp": "03:38:50", "text": "ストリーマー、VTuber、X が登場します"}, {"type": "subtitle", "time": 13133.469, "timestamp": "03:38:53", "text": "YouTuber、XC コーポ YouTuber、コーポ"}, {"type": "subtitle", "time": 13137.19, "timestamp": "03:38:57", "text": "YouTuberや、現実世界で"}, {"type": "subtitle", "time": 13139.269, "timestamp": "03:38:59", "text": "私の近くにいる。"}]
[{"type": "subtitle", "time": 16801.19, "timestamp": "04:40:01", "text": "ゲーム内のミッションなので、"}, {"type": "subtitle", "time": 16804.01, "timestamp": "04:40:04", "text": "技術的には無料。"}, {"type": "subtitle", "time": 16806.07, "timestamp": "04:40:06", "text": "[音楽]"}, {"type": "subtitle", "time": 16809.67, "timestamp": "04:40:09", "text": "ええ、そうですね。ああ、私は2つのスキンを持っています"}, {"type": "subtitle", "time": 16813.03, "timestamp": "04:40:13", "text": "他のアカウントでもそれらを入手しました"}, {"type": "subtitle", "time": 16815.51, "timestamp": "04:40:15", "text": "無料です。"}, {"type": "subtitle", "time": 16817.39, "timestamp": "04:40:17", "text": "ああ、くそ。"}, {"type": "subtitle", "time": 16819.75, "timestamp": "04:40:19", "text": "うん、それが唯一の良いところだよ"}, {"type": "subtitle", "time": 16823.19, "timestamp": "04:40:23", "text": "私のライバルたち。もし私が望む肌を手に入れることができるなら"}, {"type": "subtitle", "time": 16825.59, "timestamp": "04:40:25", "text": "私はただ十分に一生懸命プレーして、すべてをやり遂げます"}, {"type": "subtitle", "time": 16827.59, "timestamp": "04:40:27", "text": "任務とかそういうこと。さらに、彼らは"}, {"type": "subtitle", "time": 16830.23, "timestamp": "04:40:30", "text": "お前らの病的な変質スキンもなんだよ。私は思う"}, {"type": "subtitle", "time": 16834.81, "timestamp": "04:40:34", "text": "私が使っていたベリンの肌を見た人がいました。"}, {"type": "subtitle", "time": 16836.67, "timestamp": "04:40:36", "text": "[音楽]"}, {"type": "subtitle", "time": 16839.75, "timestamp": "04:40:39", "text": "ええ、それはMシリーズのライバル車のほとんどに当てはまりますね。"}, {"type": "subtitle", "time": 16842.628, "timestamp": "04:40:42", "text": "良いゲームです。それはより優れている"}, {"type": "subtitle", "time": 16847.55, "timestamp": "04:40:47", "text": "私がプレイしたヒーローシューターのほとんどは"}, {"type": "subtitle", "time": 16850.708, "timestamp": "04:40:50", "text": "個人的に。でも、それは欠けている"}, {"type": "subtitle", "time": 16853.67, "timestamp": "04:40:53", "text": "まず第一に欠けているもの"}, {"type": "subtitle", "time": 16856.39, "timestamp": "04:40:56", "text": "PCでの最適化は多くないので"}, {"type": "subtitle", "time": 16857.628, "timestamp": "04:40:57", "text": "人々は遊ぶことができる"}]
[{"type": "subtitle", "time": 10022.79, "timestamp": "02:47:02", "text": "でも、勇気とかそういうのが好きなんだね"}, {"type": "subtitle", "time": 10025.11, "timestamp": "02:47:05", "text": "まるで彼女が私のところにやって来たかのようだった。彼女は"}, {"type": "subtitle", "time": 10028.95, "timestamp": "02:47:08", "text": "Bはランダムに選ばれる。ぜひお越しください。残り30秒。"}, {"type": "subtitle", "time": 10031.429, "timestamp": "02:47:11", "text": "敵はあと一体。最後のプレイヤー"}, {"type": "subtitle", "time": 10039.19, "timestamp": "02:47:19", "text": "私をVと呼ばないで。私があなたをVと呼ぶわ。"}, {"type": "subtitle", "time": 10042.63, "timestamp": "02:47:22", "text": "サイバーパンクVのように。"}, {"type": "subtitle", "time": 10044.11, "timestamp": "02:47:24", "text": "主要"}, {"type": "subtitle", "time": 10047.75, "timestamp": "02:47:27", "text": "5段階評価で1点。"}, {"type": "subtitle", "time": 10050.309, "timestamp": "02:47:30", "text": "さあ行こう。"}, {"type": "subtitle", "time": 10054.71, "timestamp": "02:47:34", "text": "何てことだ。一体どういうことだ？"}, {"type": "subtitle", "time": 10061.269, "timestamp": "02:47:41", "text": "ああ。待って、待って、待って、待って、待って。する"}, {"type": "subtitle", "time": 10064.23, "timestamp": "02:47:44", "text": "ああ、そうだね。あなたは決して"}, {"type": "subtitle", "time": 10066.469, "timestamp": "02:47:46", "text": "心。近づかないで。あなたは持っている"}, {"type": "subtitle", "time": 10069.59, "timestamp": "02:47:49", "text": "バトルパススキン。"}, {"type": "subtitle", "time": 10072.07, "timestamp": "02:47:52", "text": "おい、それは殺したいわけでもないのに"}, {"type": "subtitle", "time": 10076.23, "timestamp": "02:47:56", "text": "ああ、これは君が持っているよ。わかった、"}]
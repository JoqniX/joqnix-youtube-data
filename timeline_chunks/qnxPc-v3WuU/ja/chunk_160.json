[{"type": "subtitle", "time": 9602.309, "timestamp": "02:40:02", "text": "3時に。「うん、壊れると思う。うん、"}, {"type": "subtitle", "time": 9611.91, "timestamp": "02:40:11", "text": "ええ、そうです。これは2番目のストリームです"}, {"type": "subtitle", "time": 9616.71, "timestamp": "02:40:16", "text": "彼の今日の。うん。"}, {"type": "subtitle", "time": 9618.389, "timestamp": "02:40:18", "text": "うん。どんな感じですか？疲れましたか？"}, {"type": "subtitle", "time": 9622.389, "timestamp": "02:40:22", "text": "あなたは疲れを感じることがありますか？えーっと、えーっと、私は"}, {"type": "subtitle", "time": 9625.27, "timestamp": "02:40:25", "text": "わからない。私は体を鍛える必要がある"}, {"type": "subtitle", "time": 9628.71, "timestamp": "02:40:28", "text": "いつか12時間24時間になる。"}, {"type": "subtitle", "time": 9631.67, "timestamp": "02:40:31", "text": "やってないんです。うん。しかし"}, {"type": "subtitle", "time": 9635.59, "timestamp": "02:40:35", "text": "VCとかにいるときはいつでも、"}, {"type": "subtitle", "time": 9637.99, "timestamp": "02:40:37", "text": "その経験を活かして体を鍛えよう"}, {"type": "subtitle", "time": 9639.83, "timestamp": "02:40:39", "text": "チャマ。"}, {"type": "subtitle", "time": 9642.309, "timestamp": "02:40:42", "text": "だから、疲れたら時間をメモするようにしている。"}, {"type": "subtitle", "time": 9646.389, "timestamp": "02:40:46", "text": "だから、次に配信するときは、"}, {"type": "subtitle", "time": 9649.349, "timestamp": "02:40:49", "text": "時間を克服する、"}, {"type": "subtitle", "time": 9651.349, "timestamp": "02:40:51", "text": "疲れたりしないとか、"}, {"type": "subtitle", "time": 9653.309, "timestamp": "02:40:53", "text": "それ。ああ、"}, {"type": "subtitle", "time": 9658.63, "timestamp": "02:40:58", "text": "神。なるほど。我が神よ。"}]
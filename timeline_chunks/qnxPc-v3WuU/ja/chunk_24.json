[{"type": "subtitle", "time": 1443.549, "timestamp": "00:24:03", "text": "それから？なぜ？今日は日曜日です。"}, {"type": "subtitle", "time": 1448.39, "timestamp": "00:24:08", "text": "何？ニース。今は夕方です。ある夜"}, {"type": "subtitle", "time": 1449.39, "timestamp": "00:24:09", "text": "時間"}, {"type": "subtitle", "time": 1471.51, "timestamp": "00:24:31", "text": "おお。あ、待って。 BはMST出身です。わかった。私"}, {"type": "subtitle", "time": 1473.11, "timestamp": "00:24:33", "text": "忘れた。忘れた。そうそう。うん。私"}, {"type": "subtitle", "time": 1475.35, "timestamp": "00:24:35", "text": "そんなことがあるなんて忘れてた。そこには"}, {"type": "subtitle", "time": 1480.83, "timestamp": "00:24:40", "text": "まるでアメリカの3つの異なるタイムゾーンのようだ。 PST、"}, {"type": "subtitle", "time": 1484.269, "timestamp": "00:24:44", "text": "EST、C、"}, {"type": "subtitle", "time": 1488.789, "timestamp": "00:24:48", "text": "CDT、CST。うん。中国北部標準"}, {"type": "subtitle", "time": 1490.95, "timestamp": "00:24:50", "text": "時間。それは、中央標準のようなものだ"}]
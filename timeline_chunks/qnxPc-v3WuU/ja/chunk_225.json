[{"type": "subtitle", "time": 13506.389, "timestamp": "03:45:06", "text": "それは良い音色だ。あなたが知っている、"}, {"type": "subtitle", "time": 13508.55, "timestamp": "03:45:08", "text": "ジョックニックのプロフェッショナル"}, {"type": "subtitle", "time": 13517.87, "timestamp": "03:45:17", "text": "えーと、ええ、私は自分が"}, {"type": "subtitle", "time": 13520.71, "timestamp": "03:45:20", "text": "プロ。それは本当に最低限のものです、私は"}, {"type": "subtitle", "time": 13523.269, "timestamp": "03:45:23", "text": "推測。"}, {"type": "subtitle", "time": 13524.79, "timestamp": "03:45:24", "text": "プロフェッショナルを何と呼ぶでしょうか？何"}, {"type": "subtitle", "time": 13528.63, "timestamp": "03:45:28", "text": "あなたにとってプロフェッショナルなビートとは何ですか？"}, {"type": "subtitle", "time": 13531.51, "timestamp": "03:45:31", "text": "ええと、制作品質とその他すべて"}, {"type": "subtitle", "time": 13535.59, "timestamp": "03:45:35", "text": "すべてにおいて、そうでなければならない。"}, {"type": "subtitle", "time": 13537.83, "timestamp": "03:45:37", "text": "それが私が"}, {"type": "subtitle", "time": 13540.07, "timestamp": "03:45:40", "text": "死体。うん。"}, {"type": "subtitle", "time": 13541.99, "timestamp": "03:45:41", "text": "うん。企業らしくあれ。コルポスはまさに"}, {"type": "subtitle", "time": 13544.309, "timestamp": "03:45:44", "text": "企業系ユーチューバーってこと、わかる？彼らは持っている"}, {"type": "subtitle", "time": 13546.389, "timestamp": "03:45:46", "text": "プロフェッショナルであること"}, {"type": "subtitle", "time": 13548.229, "timestamp": "03:45:48", "text": "すべてにおいて。"}, {"type": "subtitle", "time": 13550.63, "timestamp": "03:45:50", "text": "何かを言うな、与えるな"}, {"type": "subtitle", "time": 13554.189, "timestamp": "03:45:54", "text": "ほとんどの場合、物事についての意見。"}, {"type": "subtitle", "time": 13557.309, "timestamp": "03:45:57", "text": "そう、まさに"}, {"type": "subtitle", "time": 13559.67, "timestamp": "03:45:59", "text": "コミュニティを殴り倒すように、"}]
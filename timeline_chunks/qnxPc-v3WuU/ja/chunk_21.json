[{"type": "subtitle", "time": 1267.99, "timestamp": "00:21:07", "text": "けれど？ああ、ぬいぐるみみたいな感じ"}, {"type": "subtitle", "time": 1271.07, "timestamp": "00:21:11", "text": "あれのことですよね？そうそう。うん。"}, {"type": "subtitle", "time": 1279.27, "timestamp": "00:21:19", "text": "うん。それは、"}, {"type": "subtitle", "time": 1290.549, "timestamp": "00:21:30", "text": "これ。こんな感じです。まるで"}, {"type": "subtitle", "time": 1293.43, "timestamp": "00:21:33", "text": "こういう人形みたいなやつですよね？"}, {"type": "subtitle", "time": 1295.27, "timestamp": "00:21:35", "text": "うん。もしくは、ただその件を済ませてしまえばいい。"}, {"type": "subtitle", "time": 1297.59, "timestamp": "00:21:37", "text": "こんな感じです。でも、私は"}, {"type": "subtitle", "time": 1299.43, "timestamp": "00:21:39", "text": "独自のサイズ感があるように感じる"}, {"type": "subtitle", "time": 1310.07, "timestamp": "00:21:50", "text": "考える。うん。"}]
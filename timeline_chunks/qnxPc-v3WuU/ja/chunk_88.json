[{"type": "subtitle", "time": 5281.87, "timestamp": "01:28:01", "text": "つまり、それはむしろ"}, {"type": "subtitle", "time": 5285.83, "timestamp": "01:28:05", "text": "エイペックスですよね？実際に1つ使ってみました。ただ"}, {"type": "subtitle", "time": 5288.31, "timestamp": "01:28:08", "text": "しゃがみ動作を削除する方がずっと良い"}, {"type": "subtitle", "time": 5294.79, "timestamp": "01:28:14", "text": "ええ、そうですね。"}, {"type": "subtitle", "time": 5297.189, "timestamp": "01:28:17", "text": "君の息子がどうやってたくさん手に入れたか"}, {"type": "subtitle", "time": 5316.99, "timestamp": "01:28:36", "text": "私の古いものはどこにある？"}, {"type": "subtitle", "time": 5320.79, "timestamp": "01:28:40", "text": "今？では、すべて話してください。では、すべて話してください。"}, {"type": "subtitle", "time": 5324.31, "timestamp": "01:28:44", "text": "ズチーノには内緒にしておいて。"}]
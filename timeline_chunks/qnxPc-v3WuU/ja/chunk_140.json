[{"type": "subtitle", "time": 8408.11, "timestamp": "02:20:08", "text": "私のモデルに何が起こっているのですか？ああ、"}, {"type": "subtitle", "time": 8411.99, "timestamp": "02:20:11", "text": "神。ええ、今すぐ行ってください。私はそういうタイプではない"}, {"type": "subtitle", "time": 8414.79, "timestamp": "02:20:14", "text": "チャットを少し台無しにした。戻ってきました。私はただ"}, {"type": "subtitle", "time": 8426.79, "timestamp": "02:20:26", "text": "何か見落としたかな？"}, {"type": "subtitle", "time": 8429.91, "timestamp": "02:20:29", "text": "ここは注意が必要だ。しばらく作っていませんでした。私"}, {"type": "subtitle", "time": 8432.389, "timestamp": "02:20:32", "text": "時間内に間に合うかもしれない。ああ、アップルパイ"}, {"type": "subtitle", "time": 8435.07, "timestamp": "02:20:35", "text": "もの。はい、読んだと思います"}, {"type": "subtitle", "time": 8441.67, "timestamp": "02:20:41", "text": "寝る。潜入捜査は、"}, {"type": "subtitle", "time": 8443.59, "timestamp": "02:20:43", "text": "ミッション・インポッシブルのシーンで"}, {"type": "subtitle", "time": 8445.87, "timestamp": "02:20:45", "text": "着用する場所を作る"}, {"type": "subtitle", "time": 8449.55, "timestamp": "02:20:49", "text": "マスク。はい。資金提供を受けた死者"}, {"type": "subtitle", "time": 8452.07, "timestamp": "02:20:52", "text": "成功しました。えっと"}]
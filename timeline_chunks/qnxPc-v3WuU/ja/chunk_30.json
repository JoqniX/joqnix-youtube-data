[{"type": "subtitle", "time": 1800.149, "timestamp": "00:30:00", "text": "ストリームとスパムスパムスパムは、ええと"}, {"type": "subtitle", "time": 1805.269, "timestamp": "00:30:05", "text": "それは取り外せる、それが1つ目、2つ目です"}, {"type": "subtitle", "time": 1808.149, "timestamp": "00:30:08", "text": "えーと、サブみたいなものだから多分"}, {"type": "subtitle", "time": 1809.75, "timestamp": "00:30:09", "text": "購読者"}, {"type": "subtitle", "time": 1813.31, "timestamp": "00:30:13", "text": "えーと、購読者になる必要があります"}, {"type": "subtitle", "time": 1816.549, "timestamp": "00:30:16", "text": "YouTubeでただおしゃべりするようなもの"}, {"type": "subtitle", "time": 1820.43, "timestamp": "00:30:20", "text": "そうすれば、"}, {"type": "subtitle", "time": 1823.909, "timestamp": "00:30:23", "text": "右の人、あなたはそうは思わないでしょう"}, {"type": "subtitle", "time": 1826.07, "timestamp": "00:30:26", "text": "すぐに入って来られるので、"}, {"type": "subtitle", "time": 1830.149, "timestamp": "00:30:30", "text": "しばらくその人の様子を見て、それから"}, {"type": "subtitle", "time": 1832.389, "timestamp": "00:30:32", "text": "コメントを残して挨拶してください"}, {"type": "subtitle", "time": 1836.07, "timestamp": "00:30:36", "text": "ストリームは、"}, {"type": "subtitle", "time": 1840.149, "timestamp": "00:30:40", "text": "ずいぶん前のことですよね？昔はこうだった。"}, {"type": "subtitle", "time": 1842.95, "timestamp": "00:30:42", "text": "さて、どちらの方が優れていると思いますか？"}, {"type": "subtitle", "time": 1845.029, "timestamp": "00:30:45", "text": "でも、私はそれを"}, {"type": "subtitle", "time": 1847.669, "timestamp": "00:30:47", "text": "強制されたとか、そういう感じですね。"}, {"type": "subtitle", "time": 1851.11, "timestamp": "00:30:51", "text": "購読する必要があります。私はサブ uh のような"}, {"type": "subtitle", "time": 1853.11, "timestamp": "00:30:53", "text": "空腹か何かを追いかけろ。私はほしくない"}, {"type": "subtitle", "time": 1855.07, "timestamp": "00:30:55", "text": "それに"}, {"type": "subtitle", "time": 1857.75, "timestamp": "00:30:57", "text": "印象。いつでも購読を解除できます"}]
[{"type": "subtitle", "time": 10201.99, "timestamp": "02:50:01", "text": "うん。ええ、もちろん、もちろんです。"}, {"type": "subtitle", "time": 10203.75, "timestamp": "02:50:03", "text": "ベーコンも売り切れだ。彼は食べる必要がある"}, {"type": "subtitle", "time": 10205.83, "timestamp": "02:50:05", "text": "夕食。そうそう。うん。もう遅い"}, {"type": "subtitle", "time": 10208.389, "timestamp": "02:50:08", "text": "彼らですよね？うん。"}, {"type": "subtitle", "time": 10212.51, "timestamp": "02:50:12", "text": "わかった。ベーコンが焼けた。カットしましょう"}, {"type": "subtitle", "time": 10215.79, "timestamp": "02:50:15", "text": "それ。すみません、戻ってきました。その"}, {"type": "subtitle", "time": 10218.63, "timestamp": "02:50:18", "text": "わかった。あなたは来て、あなたはただ到達した、"}, {"type": "subtitle", "time": 10221.59, "timestamp": "02:50:21", "text": "右？そして君は我々に騙されたんだ。感謝"}, {"type": "subtitle", "time": 10223.19, "timestamp": "02:50:23", "text": "本当に本当にありがとう。私のゲーマーがこれを"}, {"type": "subtitle", "time": 10225.99, "timestamp": "02:50:25", "text": "テーブルの脚はV字型です。時には"}, {"type": "subtitle", "time": 10229.71, "timestamp": "02:50:29", "text": "L字型、時にはO字型。"}, {"type": "subtitle", "time": 10232.63, "timestamp": "02:50:32", "text": "お？何？シンガポールからこんにちは。何"}, {"type": "subtitle", "time": 10237.67, "timestamp": "02:50:37", "text": "最近はどんな音楽を聴いていますか？私"}, {"type": "subtitle", "time": 10242.15, "timestamp": "02:50:42", "text": "私は何でも聴きます、"}, {"type": "subtitle", "time": 10245.03, "timestamp": "02:50:45", "text": "技術的には特定のものがあり、ああ、"}, {"type": "subtitle", "time": 10246.71, "timestamp": "02:50:46", "text": "私はこれだけを聴くつもりです"}, {"type": "subtitle", "time": 10249.59, "timestamp": "02:50:49", "text": "ジャンル。つまり、あなたはたくさん持っているということですね。ええ、そうです"}, {"type": "subtitle", "time": 10251.51, "timestamp": "02:50:51", "text": "枠があります。実際には2つのスロットがあります。私"}, {"type": "subtitle", "time": 10253.75, "timestamp": "02:50:53", "text": "あらゆる種類の音楽を聴く。では"}, {"type": "subtitle", "time": 10254.99, "timestamp": "02:50:54", "text": "ジョーカー"}, {"type": "subtitle", "time": 10258.55, "timestamp": "02:50:58", "text": "先輩？えっと、私は昔は筋金入りのEDMファンだったんです"}]
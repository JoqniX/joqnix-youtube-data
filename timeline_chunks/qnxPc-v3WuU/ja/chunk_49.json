[{"type": "subtitle", "time": 2941.71, "timestamp": "00:49:01", "text": "ああ、なんてことだ、サミー"}, {"type": "subtitle", "time": 2943.79, "timestamp": "00:49:03", "text": "墜落しました。私は思う"}, {"type": "subtitle", "time": 2948.87, "timestamp": "00:49:08", "text": "サミー、ああ、サミーが墜落した。ああ、兄弟。サミー"}, {"type": "subtitle", "time": 2952.11, "timestamp": "00:49:12", "text": "墜落しました。いいえ、これは"}, {"type": "subtitle", "time": 2953.87, "timestamp": "00:49:13", "text": "[音楽]"}, {"type": "subtitle", "time": 2956.47, "timestamp": "00:49:16", "text": "ハプニング。では、待ってください。えっと、誰を見逃したかな？"}, {"type": "subtitle", "time": 2957.99, "timestamp": "00:49:17", "text": "誰か見落としたかな？誰か見落としたかな？ああ、"}, {"type": "subtitle", "time": 2960.71, "timestamp": "00:49:20", "text": "神。何てことだ。何てことだ。有田"}, {"type": "subtitle", "time": 2962.23, "timestamp": "00:49:22", "text": "通りかかるよ。ありがとう。バイアンさん、ありがとう"}, {"type": "subtitle", "time": 2965.19, "timestamp": "00:49:25", "text": "お越しいただきありがとうございます。皆さんが良い一日を過ごせますように"}, {"type": "subtitle", "time": 2968.829, "timestamp": "00:49:28", "text": "月曜日または日曜日の夜または月曜日"}, {"type": "subtitle", "time": 2971.349, "timestamp": "00:49:31", "text": "朝。幸運を。ありがとうございます"}, {"type": "subtitle", "time": 2974.309, "timestamp": "00:49:34", "text": "ちょっと立ち寄ってみます。 Evolve the quack は新しい"}, {"type": "subtitle", "time": 2975.75, "timestamp": "00:49:35", "text": "人。はい、来てくれてありがとう。"}, {"type": "subtitle", "time": 2978.47, "timestamp": "00:49:38", "text": "それは本当に大きな意味があります。ようこそ"}, {"type": "subtitle", "time": 2981.03, "timestamp": "00:49:41", "text": "最後。私の場所を見つけてくださってありがとうございます"}, {"type": "subtitle", "time": 2983.109, "timestamp": "00:49:43", "text": "私のチャンネル。お立ち寄りいただきありがとうございます。"}, {"type": "subtitle", "time": 2984.71, "timestamp": "00:49:44", "text": "それは本当に大きな意味があります。楽しんでいただければ幸いです。"}, {"type": "subtitle", "time": 2988.71, "timestamp": "00:49:48", "text": "今日。いや、幸運を祈るよ。ありがとう。希望"}, {"type": "subtitle", "time": 2991.19, "timestamp": "00:49:51", "text": "今日は充実した生産的な一日になりそうです。"}, {"type": "subtitle", "time": 2993.51, "timestamp": "00:49:53", "text": "ブラッドが今日来たよ。ブラッドさん、ありがとうございます。"}, {"type": "subtitle", "time": 2996.47, "timestamp": "00:49:56", "text": "通りかかるよ。今日は良い日です。エマのレンジャー、"}, {"type": "subtitle", "time": 2998.03, "timestamp": "00:49:58", "text": "お越しいただきありがとうございます。ようこそ"}]
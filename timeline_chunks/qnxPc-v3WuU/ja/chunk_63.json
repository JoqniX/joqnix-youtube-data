[{"type": "subtitle", "time": 3781.43, "timestamp": "01:03:01", "text": "リンク。ああ、私を見て"}, {"type": "subtitle", "time": 3785.99, "timestamp": "01:03:05", "text": "ズチはこうやって一緒にいる。それだけです。えっと"}, {"type": "subtitle", "time": 3788.39, "timestamp": "01:03:08", "text": "動画を編集させてください。 1秒。"}, {"type": "subtitle", "time": 3790.47, "timestamp": "01:03:10", "text": "では、少し時間をください。そうします"}, {"type": "subtitle", "time": 3793.589, "timestamp": "01:03:13", "text": "今すぐ。"}, {"type": "subtitle", "time": 3806.67, "timestamp": "01:03:26", "text": "待って。"}, {"type": "subtitle", "time": 3813.43, "timestamp": "01:03:33", "text": "ストリーム配信はありました。"}, {"type": "subtitle", "time": 3818.069, "timestamp": "01:03:38", "text": "わかった。彼は償いをしました停止は償いをしました"}, {"type": "subtitle", "time": 3820.63, "timestamp": "01:03:40", "text": "立ち止まって考えよう。"}, {"type": "subtitle", "time": 3827.789, "timestamp": "01:03:47", "text": "神。頭"}, {"type": "subtitle", "time": 3831.19, "timestamp": "01:03:51", "text": "ピング。ああ、そうだね。おお。ああ、私は"}, {"type": "subtitle", "time": 3832.75, "timestamp": "01:03:52", "text": "自分のヘッドパッチ。"}]
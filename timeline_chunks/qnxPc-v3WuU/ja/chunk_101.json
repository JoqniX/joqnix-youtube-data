[{"type": "subtitle", "time": 6061.669, "timestamp": "01:41:01", "text": "ムンバイ出身だけど、今の私を見て。"}, {"type": "subtitle", "time": 6096.35, "timestamp": "01:41:36", "text": "はい、戻ってきました。戻ってきました。私は"}, {"type": "subtitle", "time": 6099.229, "timestamp": "01:41:39", "text": "ああ、神様、私は戻ってきました。戻ってきました。私は"}, {"type": "subtitle", "time": 6103.87, "timestamp": "01:41:43", "text": "戻る。ああ、ただいま。取らせてください"}, {"type": "subtitle", "time": 6107.189, "timestamp": "01:41:47", "text": "「ああ、ただいま」に。私は何をしたのか"}, {"type": "subtitle", "time": 6110.43, "timestamp": "01:41:50", "text": "逃す？あなた"}, {"type": "subtitle", "time": 6113.189, "timestamp": "01:41:53", "text": "何も見逃さなかった。何も見逃していません"}, {"type": "subtitle", "time": 6114.87, "timestamp": "01:41:54", "text": "実は。"}, {"type": "subtitle", "time": 6116.629, "timestamp": "01:41:56", "text": "おお"}]
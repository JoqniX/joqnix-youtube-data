[{"type": "subtitle", "time": 15540.79, "timestamp": "04:19:00", "text": "私はたくさんのものを持っています。うん。私は"}, {"type": "subtitle", "time": 15543.349, "timestamp": "04:19:03", "text": "次のような多くのことを心配しています"}, {"type": "subtitle", "time": 15547.63, "timestamp": "04:19:07", "text": "今私が作った友達のこと、知ってるでしょ？"}, {"type": "subtitle", "time": 15552.229, "timestamp": "04:19:12", "text": "えっと、友達は、ええ、今作ったものです"}, {"type": "subtitle", "time": 15555.51, "timestamp": "04:19:15", "text": "例えば、私が爆発したり、"}, {"type": "subtitle", "time": 15559.03, "timestamp": "04:19:19", "text": "何かがおかしい。もし負けたらどうなる？"}, {"type": "subtitle", "time": 15561.03, "timestamp": "04:19:21", "text": "これらの数字とかのせいでそうなってるの？"}, {"type": "subtitle", "time": 15563.67, "timestamp": "04:19:23", "text": "それが私の一番の心配事です。私が"}, {"type": "subtitle", "time": 15566.71, "timestamp": "04:19:26", "text": "自分のチャンネルを開設すると、"}, {"type": "subtitle", "time": 15569.67, "timestamp": "04:19:29", "text": "私の名前にある1Kを見て、"}, {"type": "subtitle", "time": 15572.95, "timestamp": "04:19:32", "text": "変な感じがする。"}, {"type": "subtitle", "time": 15577.67, "timestamp": "04:19:37", "text": "ああ、私は重要な存在だ。いいえ、そうではありません"}, {"type": "subtitle", "time": 15580.75, "timestamp": "04:19:40", "text": "関連する。数字を見ると、"}, {"type": "subtitle", "time": 15584.149, "timestamp": "04:19:44", "text": "怖かったり緊張したり、あるいはわからない"}, {"type": "subtitle", "time": 15586.63, "timestamp": "04:19:46", "text": "言葉はどんな感じですか、私は"}, {"type": "subtitle", "time": 15589.03, "timestamp": "04:19:49", "text": "数字はあなたを変える"}, {"type": "subtitle", "time": 15592.63, "timestamp": "04:19:52", "text": "それも変えて、私は失うことになる"}, {"type": "subtitle", "time": 15595.67, "timestamp": "04:19:55", "text": "私の聴衆のごく一部または"}, {"type": "subtitle", "time": 15598.71, "timestamp": "04:19:58", "text": "コンサートプレート、私は"}]
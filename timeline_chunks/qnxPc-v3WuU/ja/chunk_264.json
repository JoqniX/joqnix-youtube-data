[{"type": "subtitle", "time": 15841.75, "timestamp": "04:24:01", "text": "なんとなくそう感じた"}, {"type": "subtitle", "time": 15846.71, "timestamp": "04:24:06", "text": "えっと、そうするべきだ、うん、そうするべきだ、大丈夫だよ"}, {"type": "subtitle", "time": 15849.03, "timestamp": "04:24:09", "text": "私にとってソロモードになるのも、"}, {"type": "subtitle", "time": 15852.389, "timestamp": "04:24:12", "text": "コラボモードにするのもいいですね"}, {"type": "subtitle", "time": 15855.59, "timestamp": "04:24:15", "text": "ええ、つまり、考えてみてください"}, {"type": "subtitle", "time": 15858.79, "timestamp": "04:24:18", "text": "こうして私は自分を閉じ込めた"}, {"type": "subtitle", "time": 15862.87, "timestamp": "04:24:22", "text": "このソロコラボレーションにソロなしの年"}, {"type": "subtitle", "time": 15866.469, "timestamp": "04:24:26", "text": "今はvlogのロックを解除したので、"}, {"type": "chat", "time": 15872.553, "timestamp": "04:24:32", "author": "@kaiguyniki", "avatar": "https://yt4.ggpht.com/f9aZERpOc1bv1JDUl12ZTXeQ7j1KdXBflkbl-6qlBLzM-hbbEQKWUlPpcJJxTU-qSUwNxrez=s64-c-k-c0x00ffffff-no-rj", "message": "sicko mode"}, {"type": "subtitle", "time": 15874.79, "timestamp": "04:24:34", "text": "私はそれが好きです。あなただけが持っていることを示している"}, {"type": "subtitle", "time": 15878.63, "timestamp": "04:24:38", "text": "成長を続けている。私たちはそれを見てきました"}, {"type": "subtitle", "time": 15881.349, "timestamp": "04:24:41", "text": "それは素晴らしいことだ。ところで、"}, {"type": "subtitle", "time": 15886.149, "timestamp": "04:24:46", "text": "AMKチームの皆さん、EDMトラックとは何ですか？"}, {"type": "subtitle", "time": 15889.75, "timestamp": "04:24:49", "text": "エレクトロニック・ダンス・ミュージックの楽曲。ありえない"}, {"type": "subtitle", "time": 15899.429, "timestamp": "04:24:59", "text": "私はかつてEDMの大ファンだった。まるで私が"}]
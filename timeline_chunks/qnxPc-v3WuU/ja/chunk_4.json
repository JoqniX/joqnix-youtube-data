[{"type": "subtitle", "time": 240.07, "timestamp": "00:04:00", "text": "それは大変役に立つ支援です。うん。"}, {"type": "subtitle", "time": 242.39, "timestamp": "00:04:02", "text": "うん。しかしそれは本当に稀で難しい"}, {"type": "subtitle", "time": 244.19, "timestamp": "00:04:04", "text": "見つける。そしてそれが"}, {"type": "subtitle", "time": 247.229, "timestamp": "00:04:07", "text": "最近のvtubing界隈では"}, {"type": "subtitle", "time": 249.67, "timestamp": "00:04:09", "text": "そう、諦めて"}, {"type": "subtitle", "time": 252.19, "timestamp": "00:04:12", "text": "過去を卒業しよう"}, {"type": "subtitle", "time": 253.789, "timestamp": "00:04:13", "text": "IP"}, {"type": "subtitle", "time": 258.069, "timestamp": "00:04:18", "text": "そして、割り当てて、仕事に取り掛かる"}, {"type": "subtitle", "time": 260.909, "timestamp": "00:04:20", "text": "企業内の代理店"}, {"type": "subtitle", "time": 263.51, "timestamp": "00:04:23", "text": "環境、または運が良ければ"}, {"type": "subtitle", "time": 264.67, "timestamp": "00:04:24", "text": "手に入れる"}, {"type": "subtitle", "time": 268.87, "timestamp": "00:04:28", "text": "ああ、スカウトされるか、"}, {"type": "subtitle", "time": 275.43, "timestamp": "00:04:35", "text": "えーと、代理店とかそういうのが"}, {"type": "subtitle", "time": 277.51, "timestamp": "00:04:37", "text": "あなたの個人的な情熱をサポートする"}, {"type": "subtitle", "time": 280.23, "timestamp": "00:04:40", "text": "夢とか、そういう類のものすべて"}, {"type": "subtitle", "time": 282.31, "timestamp": "00:04:42", "text": "商標などを勉強するべき"}, {"type": "subtitle", "time": 285.27, "timestamp": "00:04:45", "text": "うんうん、商標関係ね"}, {"type": "subtitle", "time": 287.43, "timestamp": "00:04:47", "text": "インドでは商標登録されているようです"}, {"type": "subtitle", "time": 289.67, "timestamp": "00:04:49", "text": "商標関連のものは本当に高価です"}, {"type": "subtitle", "time": 292.55, "timestamp": "00:04:52", "text": "1つは、それよりも、"}, {"type": "subtitle", "time": 294.23, "timestamp": "00:04:54", "text": "商標登録には10万ルピーか何か"}, {"type": "subtitle", "time": 299.95, "timestamp": "00:04:59", "text": "どのような"}]
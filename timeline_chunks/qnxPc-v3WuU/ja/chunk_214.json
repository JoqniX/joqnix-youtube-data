[{"type": "subtitle", "time": 12868.229, "timestamp": "03:34:28", "text": "わかったよ。わかった。わかった。捕まえたぞ。捕まえたぞ。"}, {"type": "subtitle", "time": 12872.15, "timestamp": "03:34:32", "text": "捕まえたぞ。捕まえたぞ。ああ、時間がかかったよ。"}, {"type": "subtitle", "time": 12874.349, "timestamp": "03:34:34", "text": "でも、君は僕が守るよ。"}, {"type": "subtitle", "time": 12877.95, "timestamp": "03:34:37", "text": "男。私は手に入れた"}, {"type": "subtitle", "time": 12890.229, "timestamp": "03:34:50", "text": "あなた。そしてベン。わかりました、"}]
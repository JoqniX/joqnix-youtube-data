[{"type": "subtitle", "time": 16201.03, "timestamp": "04:30:01", "text": "以前は私の配信を見てくれていた。私はこう思う、"}, {"type": "subtitle", "time": 16203.11, "timestamp": "04:30:03", "text": "「ああ、見てみたらどうだい"}, {"type": "subtitle", "time": 16205.83, "timestamp": "04:30:05", "text": "ストリーム上で仕掛けをしているような他の人たち"}, {"type": "subtitle", "time": 16207.83, "timestamp": "04:30:07", "text": "「それはあなたを助けてくれる？」私は「それは"}, {"type": "subtitle", "time": 16210.81, "timestamp": "04:30:10", "text": "最高に素晴らしいアイデアだ。"}, {"type": "subtitle", "time": 16212.07, "timestamp": "04:30:12", "text": "[音楽]"}, {"type": "subtitle", "time": 16215.149, "timestamp": "04:30:15", "text": "ええ、その時から私は"}, {"type": "subtitle", "time": 16218.309, "timestamp": "04:30:18", "text": "まるで違うものみたい"}, {"type": "subtitle", "time": 16220.63, "timestamp": "04:30:20", "text": "YouTuber、あるいは一般の人々"}, {"type": "subtitle", "time": 16222.95, "timestamp": "04:30:22", "text": "まるでストリームを操作しているような人たちで、"}, {"type": "subtitle", "time": 16226.469, "timestamp": "04:30:26", "text": "彼らに尋ねると、彼らの何人かはとても"}, {"type": "subtitle", "time": 16227.91, "timestamp": "04:30:27", "text": "役立つ。彼らはこう言う。「なぜあなたは"}, {"type": "subtitle", "time": 16230.149, "timestamp": "04:30:30", "text": "「VCに参加すれば、私がやりますよ？」そして私は"}, {"type": "subtitle", "time": 16232.79, "timestamp": "04:30:32", "text": "ストリーム配信をしていて、ちょうど"}, {"type": "subtitle", "time": 16235.429, "timestamp": "04:30:35", "text": "チャットして、どうやって"}, {"type": "subtitle", "time": 16237.91, "timestamp": "04:30:37", "text": "彼らはこれをする、"}, {"type": "subtitle", "time": 16240.229, "timestamp": "04:30:40", "text": "ほら、彼らはただ私にそう言うだけなんです。いくつかの"}, {"type": "subtitle", "time": 16241.99, "timestamp": "04:30:41", "text": "人々は、ほら、大きくない"}, {"type": "subtitle", "time": 16244.71, "timestamp": "04:30:44", "text": "ストリーマーたち、でも4K人が視聴している"}, {"type": "subtitle", "time": 16251.269, "timestamp": "04:30:51", "text": "メッセージ、あるいは単に一般的に"}, {"type": "subtitle", "time": 16253.03, "timestamp": "04:30:53", "text": "「ああ、あの人は"}, {"type": "subtitle", "time": 16255.11, "timestamp": "04:30:55", "text": "荒らし行為。私に尋ねたその人"}, {"type": "subtitle", "time": 16257.189, "timestamp": "04:30:57", "text": "不正操作に関する質問は、彼が荒らし行為をしている証拠だ。"}, {"type": "subtitle", "time": 16258.79, "timestamp": "04:30:58", "text": "私は彼に注意を払わないし、"}]
[{"type": "subtitle", "time": 4745.43, "timestamp": "01:19:05", "text": "これはうまく機能しているように見えますか？"}, {"type": "subtitle", "time": 4749.11, "timestamp": "01:19:09", "text": "ああ、最高にいいだろうね。"}, {"type": "subtitle", "time": 4750.59, "timestamp": "01:19:10", "text": "ああ、"}, {"type": "subtitle", "time": 4764.229, "timestamp": "01:19:24", "text": "悪い？ごめんなさい。寒い。寒いです。わかった。"}, {"type": "subtitle", "time": 4775.51, "timestamp": "01:19:35", "text": "なんてこった。私は彼女を殺しているような気がする"}, {"type": "subtitle", "time": 4777.91, "timestamp": "01:19:37", "text": "そんなに。そして彼女は怒っている。ごめんなさい。"}, {"type": "subtitle", "time": 4779.669, "timestamp": "01:19:39", "text": "何てことだ。私は彼女をひどく苦しめている。おお"}, {"type": "subtitle", "time": 4782.709, "timestamp": "01:19:42", "text": "我が神よ。彼女が見える。何てことだ。私は"}, {"type": "subtitle", "time": 4785.79, "timestamp": "01:19:45", "text": "彼女をひどく苦しめている。ああ、"}, {"type": "subtitle", "time": 4789.83, "timestamp": "01:19:49", "text": "神。ああ、なんてことだ。私は彼女を殺している"}, {"type": "subtitle", "time": 4791.75, "timestamp": "01:19:51", "text": "多くの。何てことだ。つまり、"}, {"type": "subtitle", "time": 4794.95, "timestamp": "01:19:54", "text": "彼は、ああなしでもこれほど優れている。"}]
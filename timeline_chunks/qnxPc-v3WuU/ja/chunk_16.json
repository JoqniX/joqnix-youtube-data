[{"type": "subtitle", "time": 961.749, "timestamp": "00:16:01", "text": "えーっと、まあ、いろいろやるよね"}, {"type": "subtitle", "time": 963.269, "timestamp": "00:16:03", "text": "やらなきゃいけないことがあるんだよ、ほら、"}, {"type": "subtitle", "time": 965.11, "timestamp": "00:16:05", "text": "代理店とかそういうのじゃなくて、"}, {"type": "subtitle", "time": 966.11, "timestamp": "00:16:06", "text": "もっと"}, {"type": "subtitle", "time": 969.629, "timestamp": "00:16:09", "text": "倉庫みたいだと私はよく言う。"}, {"type": "subtitle", "time": 973.829, "timestamp": "00:16:13", "text": "それは倉庫のような、ガレージのような"}, {"type": "subtitle", "time": 977.71, "timestamp": "00:16:17", "text": "保管するもの、つまり、"}, {"type": "subtitle", "time": 981.269, "timestamp": "00:16:21", "text": "ストリーマーやクリエイターのようなクリエイター"}, {"type": "subtitle", "time": 983.949, "timestamp": "00:16:23", "text": "そういうものを持っている"}, {"type": "subtitle", "time": 987.79, "timestamp": "00:16:27", "text": "右。私はとても"}, {"type": "subtitle", "time": 991.03, "timestamp": "00:16:31", "text": "あの、その配信者の名前は何ですか？"}, {"type": "subtitle", "time": 993.15, "timestamp": "00:16:33", "text": "私があなたを見ているのは"}, {"type": "subtitle", "time": 995.67, "timestamp": "00:16:35", "text": "Twitch？彼の名前は何でしたっけ？彼はそうすべきだ"}, {"type": "subtitle", "time": 1003.189, "timestamp": "00:16:43", "text": "おそらく。ああ、彼は有名な配信者だよ。私"}, {"type": "subtitle", "time": 1006.269, "timestamp": "00:16:46", "text": "忘れた。彼はMMOゲームのようにプレイし、"}]
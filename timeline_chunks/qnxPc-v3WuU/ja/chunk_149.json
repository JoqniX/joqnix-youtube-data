[{"type": "subtitle", "time": 8940.07, "timestamp": "02:29:00", "text": "イルミナティ。彼のネットは相変わらずひどい。"}, {"type": "subtitle", "time": 8942.79, "timestamp": "02:29:02", "text": "彼はとてもいいプレーをしている。"}, {"type": "subtitle", "time": 8943.94, "timestamp": "02:29:03", "text": "うん。"}, {"type": "subtitle", "time": 8946.23, "timestamp": "02:29:06", "text": "[音楽]"}, {"type": "subtitle", "time": 8955.71, "timestamp": "02:29:15", "text": "どこに"}, {"type": "subtitle", "time": 8976.79, "timestamp": "02:29:36", "text": "なぜ？そして最初に耳にしたのは"}, {"type": "subtitle", "time": 8979.349, "timestamp": "02:29:39", "text": "彼女はとんでもないことを言っている。なぜ私は"}, {"type": "subtitle", "time": 8989.11, "timestamp": "02:29:49", "text": "よし、戻らなきゃ。私は勝つ必要がある"}, {"type": "subtitle", "time": 8998.63, "timestamp": "02:29:58", "text": "何てことだ。ああ、神様が必要だ。何てことだ。"}]
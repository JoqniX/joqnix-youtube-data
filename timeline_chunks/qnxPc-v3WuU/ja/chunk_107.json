[{"type": "subtitle", "time": 6424.709, "timestamp": "01:47:04", "text": "ムンビッド ムンバイ。シンガポールで演奏します"}, {"type": "subtitle", "time": 6426.709, "timestamp": "01:47:06", "text": "なぜなら、ほとんどの人が"}, {"type": "subtitle", "time": 6429.35, "timestamp": "01:47:09", "text": "シンガポールではping値が良い。その"}, {"type": "subtitle", "time": 6432.07, "timestamp": "01:47:12", "text": "私だけかもしれませんが、ping値が良くないんです。"}, {"type": "subtitle", "time": 6443.189, "timestamp": "01:47:23", "text": "あなたは気づいていないと思うけど、"}, {"type": "subtitle", "time": 6446.149, "timestamp": "01:47:26", "text": "実際、殺人を愛するのが好きです。はい、私は"}, {"type": "subtitle", "time": 6448.47, "timestamp": "01:47:28", "text": "戻る。戻ってきました。一度だけあった。"}, {"type": "subtitle", "time": 6450.709, "timestamp": "01:47:30", "text": "待って、じゃあジョブのチャットは私の声を聞けるの？私はしません"}, {"type": "subtitle", "time": 6452.55, "timestamp": "01:47:32", "text": "知っていることさえある。うん。うん。うん。聞いてもいいですか"}, {"type": "subtitle", "time": 6475.629, "timestamp": "01:47:55", "text": "ああ、"}]
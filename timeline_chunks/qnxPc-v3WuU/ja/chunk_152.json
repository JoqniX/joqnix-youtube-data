[{"type": "subtitle", "time": 9122.55, "timestamp": "02:32:02", "text": "私たちはウェラーの曲を演奏します。私たちと一緒に活動しませんか？"}, {"type": "subtitle", "time": 9123.99, "timestamp": "02:32:03", "text": "私たちと一緒に活動しませんか？そして私たちはストリーミング配信しています"}, {"type": "subtitle", "time": 9126.389, "timestamp": "02:32:06", "text": "私たち二人とも。はい。え、何これ？私は"}, {"type": "subtitle", "time": 9129.349, "timestamp": "02:32:09", "text": "ひどい。それは知りません。"}, {"type": "subtitle", "time": 9149.83, "timestamp": "02:32:29", "text": "いいえ。あなたたち二人はよく見かけましたよ。"}, {"type": "subtitle", "time": 9152.07, "timestamp": "02:32:32", "text": "大丈夫。ご希望であれば、ご参加いただけます。"}, {"type": "subtitle", "time": 9157.469, "timestamp": "02:32:37", "text": "ああ、"}, {"type": "subtitle", "time": 9170.87, "timestamp": "02:32:50", "text": "見る。いや、いや、いや。良い配信を。"}, {"type": "subtitle", "time": 9173.11, "timestamp": "02:32:53", "text": "わかった。"}, {"type": "subtitle", "time": 9175.349, "timestamp": "02:32:55", "text": "こんにちは。わかった。いいえ、ただ言いに来ただけです"}, {"type": "subtitle", "time": 9177.95, "timestamp": "02:32:57", "text": "こんにちは。こんにちは。"}]
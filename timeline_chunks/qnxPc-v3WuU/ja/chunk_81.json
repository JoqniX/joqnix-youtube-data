[{"type": "subtitle", "time": 4873.35, "timestamp": "01:21:13", "text": "私は最近、あまり努力していません。わからない。"}, {"type": "subtitle", "time": 4881.63, "timestamp": "01:21:21", "text": "1つ。私は文字通り彼の"}, {"type": "subtitle", "time": 4884.229, "timestamp": "01:21:24", "text": "十字線。私はこれが本当に苦手なんです。見てください"}, {"type": "subtitle", "time": 4885.87, "timestamp": "01:21:25", "text": "彼。 14"}, {"type": "subtitle", "time": 4892.91, "timestamp": "01:21:32", "text": "自分。ああ、"}, {"type": "subtitle", "time": 4897.03, "timestamp": "01:21:37", "text": "神。私はできなかった"}, {"type": "subtitle", "time": 4913.03, "timestamp": "01:21:53", "text": "なぜ私はしゃがむのか？私はそうすべきではない"}, {"type": "subtitle", "time": 4917.11, "timestamp": "01:21:57", "text": "私は好きです。コントロール。削除しましょう"}, {"type": "subtitle", "time": 4919.11, "timestamp": "01:21:59", "text": "しゃがむ。"}]
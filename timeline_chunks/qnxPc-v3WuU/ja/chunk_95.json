[{"type": "subtitle", "time": 5708.79, "timestamp": "01:35:08", "text": "あなたは文字通り私が「いいえ、私は」と言うのを待っていました"}, {"type": "subtitle", "time": 5712.07, "timestamp": "01:35:12", "text": "今、あなたを最初に見かけました。それで、私は今あなたを見かけました"}, {"type": "subtitle", "time": 5714.87, "timestamp": "01:35:14", "text": "初め。だから私はただ「ああ、なんてことだ」と思った。私は入ったのか"}, {"type": "subtitle", "time": 5717.51, "timestamp": "01:35:17", "text": "今？"}, {"type": "subtitle", "time": 5732.47, "timestamp": "01:35:32", "text": "わかった。キン、シンガポールでプレイしようか？"}, {"type": "subtitle", "time": 5734.79, "timestamp": "01:35:34", "text": "シンガポールでプレイできますか？そうなるだろうか"}, {"type": "subtitle", "time": 5738.229, "timestamp": "01:35:38", "text": "わかった？つまり、101です。"}, {"type": "subtitle", "time": 5741.91, "timestamp": "01:35:41", "text": "彼はシンガポールでプレーできると思う。うん。えっと、"}, {"type": "subtitle", "time": 5743.83, "timestamp": "01:35:43", "text": "私はすごく濃いピンク色が好きだった。それで、"}, {"type": "subtitle", "time": 5746.87, "timestamp": "01:35:46", "text": "自分に多くを期待していない。私たちは何を"}, {"type": "subtitle", "time": 5750.51, "timestamp": "01:35:50", "text": "する？私たちはその試合をもう一度観戦するのでしょうか？"}, {"type": "subtitle", "time": 5755.59, "timestamp": "01:35:55", "text": "一致するものはありません。ええ、もちろんです。よし、行こう。"}, {"type": "subtitle", "time": 5757.27, "timestamp": "01:35:57", "text": "わかった。"}, {"type": "subtitle", "time": 5759.669, "timestamp": "01:35:59", "text": "なんてこった。左側通行。待って、なぜ"}]
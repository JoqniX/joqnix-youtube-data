[{"type": "subtitle", "time": 13922.87, "timestamp": "03:52:02", "text": "片方の端ですよね？なぜできないのか？あなたのような"}, {"type": "subtitle", "time": 13924.75, "timestamp": "03:52:04", "text": "ほとんどの場合、シングルのような"}, {"type": "subtitle", "time": 13927.75, "timestamp": "03:52:07", "text": "コラボレーション。あなたもジョッカソンに参加するなら、"}, {"type": "subtitle", "time": 13929.11, "timestamp": "03:52:09", "text": "グループコラボレーションのようなものを持つことができます"}, {"type": "subtitle", "time": 13931.83, "timestamp": "03:52:11", "text": "みんな。ええ、グループコラボレーションは"}, {"type": "subtitle", "time": 13934.71, "timestamp": "03:52:14", "text": "いいけど、混沌として、"}, {"type": "subtitle", "time": 13937.67, "timestamp": "03:52:17", "text": "楽しい部分になるでしょう。"}, {"type": "subtitle", "time": 13941.11, "timestamp": "03:52:21", "text": "楽しい部分。うん、新しいものになるよ"}, {"type": "subtitle", "time": 13942.87, "timestamp": "03:52:22", "text": "あなたにとっての目標、つまり新しい"}, {"type": "subtitle", "time": 13946.309, "timestamp": "03:52:26", "text": "任務を完了する。どうすれば"}, {"type": "subtitle", "time": 13948.229, "timestamp": "03:52:28", "text": "コラボレーションに参加して、"}, {"type": "subtitle", "time": 13952.07, "timestamp": "03:52:32", "text": "仕事？ええ、つまり私は"}, {"type": "subtitle", "time": 13957.67, "timestamp": "03:52:37", "text": "しかし、今はそれをしなくてはならなかった。"}, {"type": "subtitle", "time": 13960.55, "timestamp": "03:52:40", "text": "右？ええ、それはあなたの"}, {"type": "subtitle", "time": 13962.469, "timestamp": "03:52:42", "text": "ここ数週間のあなたの様子"}, {"type": "subtitle", "time": 13965.83, "timestamp": "03:52:45", "text": "何週間もエネルギーがなかった。ああ、そうじゃない"}, {"type": "subtitle", "time": 13969.11, "timestamp": "03:52:49", "text": "君ならできると思うよ。うん、それ"}, {"type": "subtitle", "time": 13973.71, "timestamp": "03:52:53", "text": "それも要因の一つです。ええ、そうです。"}, {"type": "subtitle", "time": 13976.87, "timestamp": "03:52:56", "text": "グループの方が難しいことに気づいた"}, {"type": "subtitle", "time": 13979.67, "timestamp": "03:52:59", "text": "管理もできる。あなたは気をつけなければならない"}]
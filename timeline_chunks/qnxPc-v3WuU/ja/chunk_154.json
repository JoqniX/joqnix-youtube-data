[{"type": "subtitle", "time": 9249.95, "timestamp": "02:34:09", "text": "ああ、僕はフェニックスだよ。試す必要はない"}, {"type": "subtitle", "time": 9252.87, "timestamp": "02:34:12", "text": "難しい。私はネオンカラーだと信じてください。そうそう。おお、"}, {"type": "subtitle", "time": 9254.11, "timestamp": "02:34:14", "text": "あなたは"}, {"type": "subtitle", "time": 9268.55, "timestamp": "02:34:28", "text": "主。人々は私をヘッドショットした"}, {"type": "subtitle", "time": 9270.95, "timestamp": "02:34:30", "text": "何でもありません。"}, {"type": "subtitle", "time": 9274.389, "timestamp": "02:34:34", "text": "そして私は、まるで何でもないことのようにひどく落ち込んだ。誰か"}, {"type": "subtitle", "time": 9281.75, "timestamp": "02:34:41", "text": "うん。"}, {"type": "subtitle", "time": 9284.11, "timestamp": "02:34:44", "text": "何てことだ。私は得ている 私は得ている"}, {"type": "subtitle", "time": 9286.11, "timestamp": "02:34:46", "text": "焼き払われた。"}, {"type": "subtitle", "time": 9289.91, "timestamp": "02:34:49", "text": "おお。そんな風に私を揚げないで。何てことだ。"}]
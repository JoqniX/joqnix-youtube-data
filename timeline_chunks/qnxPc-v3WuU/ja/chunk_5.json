[{"type": "subtitle", "time": 302.99, "timestamp": "00:05:02", "text": "全く予想していなかった"}, {"type": "subtitle", "time": 310.79, "timestamp": "00:05:10", "text": "おお。でも、私にとっては、私が"}, {"type": "subtitle", "time": 313.189, "timestamp": "00:05:13", "text": "ジョックンとその他すべてを作った、どうやってジョックンにしたのか"}, {"type": "subtitle", "time": 315.23, "timestamp": "00:05:15", "text": "正しい"}, {"type": "subtitle", "time": 319.189, "timestamp": "00:05:19", "text": "今。えーと、オネクシアの件以来"}, {"type": "subtitle", "time": 322.23, "timestamp": "00:05:22", "text": "そういうことですよね？無性愛や拒食症のものは"}, {"type": "subtitle", "time": 325.51, "timestamp": "00:05:25", "text": "もの。問題は、私のウェブサイトが正しいということです"}, {"type": "subtitle", "time": 329.43, "timestamp": "00:05:29", "text": "自分の短縮URLドメイン、自分のドメイン関連"}, {"type": "subtitle", "time": 332.07, "timestamp": "00:05:32", "text": "そして私が欲しいもの"}, {"type": "subtitle", "time": 334.87, "timestamp": "00:05:34", "text": "XOTVでは、倉庫ですべての"}, {"type": "subtitle", "time": 336.67, "timestamp": "00:05:36", "text": "私の音楽関連"}, {"type": "subtitle", "time": 339.83, "timestamp": "00:05:39", "text": "ストーリー関連のもの、えーと"}, {"type": "subtitle", "time": 341.71, "timestamp": "00:05:41", "text": "すべてと"}, {"type": "subtitle", "time": 344.95, "timestamp": "00:05:44", "text": "また、私の主なビジョンはあなたを好きになることでした"}, {"type": "subtitle", "time": 348.749, "timestamp": "00:05:48", "text": "このように与えることで豊かになる"}, {"type": "subtitle", "time": 352.629, "timestamp": "00:05:52", "text": "視聴者にとっての物語体験。"}, {"type": "subtitle", "time": 354.629, "timestamp": "00:05:54", "text": "そして読者やみんながもっと好き"}, {"type": "subtitle", "time": 357.67, "timestamp": "00:05:57", "text": "そして、受け継がれるべき遺産を"}]
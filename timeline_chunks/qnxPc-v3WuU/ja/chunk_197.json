[{"type": "subtitle", "time": 11821.349, "timestamp": "03:17:01", "text": "ああ、わからない。えっと、こんにちは。"}, {"type": "subtitle", "time": 11826.389, "timestamp": "03:17:06", "text": "えっと、どういうわけかVの声が聞こえません。"}, {"type": "subtitle", "time": 11829.269, "timestamp": "03:17:09", "text": "そうそう。彼の声。わかった。彼の声。"}, {"type": "subtitle", "time": 11831.83, "timestamp": "03:17:11", "text": "ええ、でも彼が努力しているのが聞こえます"}, {"type": "subtitle", "time": 11833.269, "timestamp": "03:17:13", "text": "何か言おうとするが、聞こえない"}, {"type": "subtitle", "time": 11835.99, "timestamp": "03:17:15", "text": "彼の方からでも彼女の方からでも、何でも構わない。私"}, {"type": "subtitle", "time": 11846.469, "timestamp": "03:17:26", "text": "はい、選手は1つを選ぶことができます"}, {"type": "subtitle", "time": 11848.83, "timestamp": "03:17:28", "text": "1つずつ。"}, {"type": "subtitle", "time": 11850.07, "timestamp": "03:17:30", "text": "いいえ、私"}, {"type": "subtitle", "time": 11856.51, "timestamp": "03:17:36", "text": "の上"}, {"type": "subtitle", "time": 11865.95, "timestamp": "03:17:45", "text": "私たちはすべきでしょうか"}, {"type": "subtitle", "time": 11868.99, "timestamp": "03:17:48", "text": "回転？ああ、私たちは"}, {"type": "subtitle", "time": 11871.51, "timestamp": "03:17:51", "text": "おそらく押すだろう。あ、待って。ああ、"}]
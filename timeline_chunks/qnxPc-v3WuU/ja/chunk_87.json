[{"type": "subtitle", "time": 5246.149, "timestamp": "01:27:26", "text": "何らかの理由でこのELO帯にいる。"}, {"type": "subtitle", "time": 5255.83, "timestamp": "01:27:35", "text": "しゃがむ。見逃してしまいました。メインを見逃す"}, {"type": "subtitle", "time": 5258.149, "timestamp": "01:27:38", "text": "もの。集中力が必要だ。何てことだ。ホーカス"}, {"type": "subtitle", "time": 5265.51, "timestamp": "01:27:45", "text": "いいえ、差別はしていません。"}, {"type": "subtitle", "time": 5276.79, "timestamp": "01:27:56", "text": "待って、それって大きなことなの？私はしません"}, {"type": "subtitle", "time": 5278.83, "timestamp": "01:27:58", "text": "知る。私"}]
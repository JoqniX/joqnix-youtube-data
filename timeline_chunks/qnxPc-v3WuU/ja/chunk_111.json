[{"type": "subtitle", "time": 6678.709, "timestamp": "01:51:18", "text": "え、みんな行くの？彼は"}, {"type": "subtitle", "time": 6681.189, "timestamp": "01:51:21", "text": "オーディン。何？待って、みんな行くの？"}, {"type": "subtitle", "time": 6683.189, "timestamp": "01:51:23", "text": "リボルバーか何か？いいえ。そうですね。いいえ、"}, {"type": "subtitle", "time": 6685.189, "timestamp": "01:51:25", "text": "いや、いや、いや、いや。はい、はい。ただ"}, {"type": "subtitle", "time": 6688.47, "timestamp": "01:51:28", "text": "ええ、保安官になるつもりです。"}, {"type": "subtitle", "time": 6689.95, "timestamp": "01:51:29", "text": "シェリフ、"}, {"type": "subtitle", "time": 6693.03, "timestamp": "01:51:33", "text": "あまりにも。おそらく。私は遊んでいました。私は"}, {"type": "subtitle", "time": 6700.149, "timestamp": "01:51:40", "text": "何てことだ。レン。うん。こんにちは。元気ですか"}, {"type": "subtitle", "time": 6715.189, "timestamp": "01:51:55", "text": "ブリンダー。何てことだ。どうやって"}, {"type": "subtitle", "time": 6716.51, "timestamp": "01:51:56", "text": "勝つ"}, {"type": "subtitle", "time": 6719.55, "timestamp": "01:51:59", "text": "どうやって勝つつもりですか？"}]
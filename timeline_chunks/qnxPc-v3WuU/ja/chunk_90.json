[{"type": "subtitle", "time": 5411.59, "timestamp": "01:30:11", "text": "圧倒的だ。"}, {"type": "subtitle", "time": 5415.75, "timestamp": "01:30:15", "text": "ああ、よかった。どうしたの？"}, {"type": "subtitle", "time": 5417.91, "timestamp": "01:30:17", "text": "マンゴーは残った。あ、待って。 Steもまた"}, {"type": "subtitle", "time": 5420.709, "timestamp": "01:30:20", "text": "私に追いついてきた。なんてこった。"}, {"type": "subtitle", "time": 5454.35, "timestamp": "01:30:54", "text": "で？聖なる"}, {"type": "subtitle", "time": 5457.189, "timestamp": "01:30:57", "text": "神。あと2人、この場所から追い出せ"}]
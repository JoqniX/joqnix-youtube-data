[{"type": "subtitle", "time": 14282.87, "timestamp": "03:58:02", "text": "午前11時、それから正午、正午、2時頃"}, {"type": "subtitle", "time": 14286.389, "timestamp": "03:58:06", "text": "午後6時、そしてグループコラボレーションは10時"}, {"type": "subtitle", "time": 14289.11, "timestamp": "03:58:09", "text": "午後そして、文字通り午前3時半頃。"}, {"type": "subtitle", "time": 14291.229, "timestamp": "03:58:11", "text": "真夜中がある"}, {"type": "subtitle", "time": 14293.469, "timestamp": "03:58:13", "text": "コラボレーション"}, {"type": "subtitle", "time": 14297.75, "timestamp": "03:58:17", "text": "日曜日午後2時午後9時"}, {"type": "subtitle", "time": 14300.71, "timestamp": "03:58:20", "text": "50人くらいの名前も挙げられないと思う"}, {"type": "subtitle", "time": 14303.59, "timestamp": "03:58:23", "text": "コラボしているYouTuberみたいに"}, {"type": "subtitle", "time": 14306.15, "timestamp": "03:58:26", "text": "個人の名前すら挙げられないなんてすごい"}, {"type": "subtitle", "time": 14309.67, "timestamp": "03:58:29", "text": "たくさんの人"}, {"type": "subtitle", "time": 14311.91, "timestamp": "03:58:31", "text": "つまり、あなたは本当に数えていないのですか？"}, {"type": "subtitle", "time": 14313.99, "timestamp": "03:58:33", "text": "再び人間らしい生活を送れるようになる？他のものと同じように"}, {"type": "subtitle", "time": 14317.389, "timestamp": "03:58:37", "text": "ストリームがまた来たり、いろいろあったり。"}, {"type": "subtitle", "time": 14321.269, "timestamp": "03:58:41", "text": "いえ、いいえ、ありません。私はしていません。わかった、"}, {"type": "subtitle", "time": 14324.51, "timestamp": "03:58:44", "text": "かっこいい。それは"}, {"type": "chat", "time": 14326.114, "timestamp": "03:58:46", "author": "@kaiguyniki", "avatar": "https://yt4.ggpht.com/f9aZERpOc1bv1JDUl12ZTXeQ7j1KdXBflkbl-6qlBLzM-hbbEQKWUlPpcJJxTU-qSUwNxrez=s64-c-k-c0x00ffffff-no-rj", "message": "wow"}, {"type": "subtitle", "time": 14327.189, "timestamp": "03:58:47", "text": "いいね、マジで。"}, {"type": "subtitle", "time": 14330.469, "timestamp": "03:58:50", "text": "50人以上。"}, {"type": "subtitle", "time": 14332.389, "timestamp": "03:58:52", "text": "ええ、そういう人もいます"}, {"type": "subtitle", "time": 14334.71, "timestamp": "03:58:54", "text": "来られなかったし、"}, {"type": "subtitle", "time": 14336.389, "timestamp": "03:58:56", "text": "誰が"}, {"type": "subtitle", "time": 14339.189, "timestamp": "03:58:59", "text": "やりたかったけど、できなかった"}]
[{"type": "subtitle", "time": 13323.11, "timestamp": "03:42:03", "text": "あの女を引きずり出してやる。彼は"}, {"type": "subtitle", "time": 13326.309, "timestamp": "03:42:06", "text": "ぶち壊して、別のものを入れろ"}, {"type": "subtitle", "time": 13329.03, "timestamp": "03:42:09", "text": "その中に何が入っているか、そして私に教えてください。そして私はそこにいる"}, {"type": "subtitle", "time": 13331.19, "timestamp": "03:42:11", "text": "「うわー、これは、これは側面みたいなものです」"}, {"type": "subtitle", "time": 13334.63, "timestamp": "03:42:14", "text": "クエスト？これは私のサイドクエストですか？"}, {"type": "subtitle", "time": 13337.67, "timestamp": "03:42:17", "text": "ああ、これが世間で言うところのサイドクエストなのか？"}, {"type": "subtitle", "time": 13341.309, "timestamp": "03:42:21", "text": "まるでNPCの話を聞いているみたいだ"}, {"type": "subtitle", "time": 13344.469, "timestamp": "03:42:24", "text": "対話？何てことだ。"}, {"type": "subtitle", "time": 13348.309, "timestamp": "03:42:28", "text": "そうそう。うん。でも、私たちは助けます"}, {"type": "subtitle", "time": 13349.83, "timestamp": "03:42:29", "text": "お互い。それが私たちの仕事です。私たちは"}, {"type": "subtitle", "time": 13352.15, "timestamp": "03:42:32", "text": "お互いに助け合う。"}, {"type": "subtitle", "time": 13357.75, "timestamp": "03:42:37", "text": "彼は私に音声メッセージを送ってくる。私は彼を送ります"}, {"type": "subtitle", "time": 13361.67, "timestamp": "03:42:41", "text": "くだらないジョーク。うん。つまらないジョーク。本当に"}, {"type": "subtitle", "time": 13364.71, "timestamp": "03:42:44", "text": "悪い。そして彼は私に尋ねたが、私は理解できなかった"}, {"type": "subtitle", "time": 13367.19, "timestamp": "03:42:47", "text": "それ。"}, {"type": "subtitle", "time": 13370.469, "timestamp": "03:42:50", "text": "うん。えっと、まあ、私はただ"}, {"type": "subtitle", "time": 13372.389, "timestamp": "03:42:52", "text": "それは放っておけよ、わかるだろ？まあ、大丈夫だよ。"}, {"type": "subtitle", "time": 13379.51, "timestamp": "03:42:59", "text": "何てことだ。うん。何の話をしてるの？"}]
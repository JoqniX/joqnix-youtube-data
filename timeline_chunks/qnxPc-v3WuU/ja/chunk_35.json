[{"type": "subtitle", "time": 2102.109, "timestamp": "00:35:02", "text": "おお。うん、"}, {"type": "subtitle", "time": 2105.47, "timestamp": "00:35:05", "text": "そこがあなたの旅行先です。おお"}, {"type": "subtitle", "time": 2107.79, "timestamp": "00:35:07", "text": "私の。"}, {"type": "subtitle", "time": 2111.43, "timestamp": "00:35:11", "text": "何？何てことだ。ああ、忘れてた"}, {"type": "subtitle", "time": 2114.15, "timestamp": "00:35:14", "text": "月曜日。あ、月曜日だったのを忘れてた。おお"}, {"type": "subtitle", "time": 2117.51, "timestamp": "00:35:17", "text": "主。だから、仕事の日には"}, {"type": "subtitle", "time": 2120.63, "timestamp": "00:35:20", "text": "うまくいかなかった、つまり、そうしないといけない"}, {"type": "subtitle", "time": 2126.87, "timestamp": "00:35:26", "text": "私が忘れがちなこと全部知ってるでしょ"}, {"type": "subtitle", "time": 2129.829, "timestamp": "00:35:29", "text": "私のことは、私がちょうど持っていたようなものなので"}, {"type": "subtitle", "time": 2133.03, "timestamp": "00:35:33", "text": "自宅で勉強して試験を受けるだけ"}, {"type": "subtitle", "time": 2135.19, "timestamp": "00:35:35", "text": "試験期間になると私は"}, {"type": "subtitle", "time": 2136.95, "timestamp": "00:35:36", "text": "休暇とは違うことを忘れて"}, {"type": "subtitle", "time": 2140.91, "timestamp": "00:35:40", "text": "今はみんなが休暇を取って"}, {"type": "subtitle", "time": 2145.03, "timestamp": "00:35:45", "text": "仕事のために家から出て、"}, {"type": "subtitle", "time": 2147.349, "timestamp": "00:35:47", "text": "草に触れて、仕事をして、ご存知のように"}, {"type": "subtitle", "time": 2149.91, "timestamp": "00:35:49", "text": "物事に参加する、オフィスに行く、"}, {"type": "subtitle", "time": 2151.51, "timestamp": "00:35:51", "text": "クラス、"}]
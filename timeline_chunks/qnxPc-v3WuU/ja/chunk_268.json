[{"type": "subtitle", "time": 16082.389, "timestamp": "04:28:02", "text": "ああ、まさかそんなことを聞​​かれるとは思ってもみなかったよ。どうやって"}, {"type": "subtitle", "time": 16083.83, "timestamp": "04:28:03", "text": "私は行ったことがあるだろうか？もちろん、私は尋ねるつもりです"}, {"type": "subtitle", "time": 16085.91, "timestamp": "04:28:05", "text": "それ。"}, {"type": "subtitle", "time": 16086.91, "timestamp": "04:28:06", "text": "いいえ、私は"}, {"type": "subtitle", "time": 16089.189, "timestamp": "04:28:09", "text": "冗談だよ。時々、あなたは理解していないことを忘れてしまう"}, {"type": "subtitle", "time": 16090.71, "timestamp": "04:28:10", "text": "皮肉。"}, {"type": "subtitle", "time": 16093.99, "timestamp": "04:28:13", "text": "それは皮肉だよ。"}, {"type": "subtitle", "time": 16096.11, "timestamp": "04:28:16", "text": "その通り"}, {"type": "subtitle", "time": 16098.189, "timestamp": "04:28:18", "text": "ジョー、時々私は"}, {"type": "subtitle", "time": 16099.95, "timestamp": "04:28:19", "text": "忘れる"}, {"type": "subtitle", "time": 16103.349, "timestamp": "04:28:23", "text": "まさにその通りで、特に何もありませんでした"}, {"type": "subtitle", "time": 16107.389, "timestamp": "04:28:27", "text": "起こっているが、私自身は"}, {"type": "subtitle", "time": 16111.229, "timestamp": "04:28:31", "text": "実践は開発されていません"}, {"type": "subtitle", "time": 16113.429, "timestamp": "04:28:33", "text": "これについては以前お話ししたと思いますが"}, {"type": "subtitle", "time": 16114.71, "timestamp": "04:28:34", "text": "もしくは、私が覚えていない他の誰か"}, {"type": "subtitle", "time": 16118.149, "timestamp": "04:28:38", "text": "実際、私はこれを誰に話したのか、まあ、"}, {"type": "subtitle", "time": 16121.67, "timestamp": "04:28:41", "text": "私自身もモデルに取り組んでいます"}, {"type": "subtitle", "time": 16124.59, "timestamp": "04:28:44", "text": "あなた自身のために2Dで生きよう。"}, {"type": "subtitle", "time": 16129.429, "timestamp": "04:28:49", "text": "ああ、誰にもわからないよ。多分"}, {"type": "subtitle", "time": 16131.269, "timestamp": "04:28:51", "text": "さあ行こう。"}, {"type": "subtitle", "time": 16135.429, "timestamp": "04:28:55", "text": "うん。ええ、練習してきました"}, {"type": "subtitle", "time": 16139.59, "timestamp": "04:28:59", "text": "ええと、一般的にリギングは"}]
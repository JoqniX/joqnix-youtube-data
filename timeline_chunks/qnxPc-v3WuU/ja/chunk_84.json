[{"type": "subtitle", "time": 5041.59, "timestamp": "01:24:01", "text": "よし、殺してもいいぞ。それがポイントです"}, {"type": "subtitle", "time": 5043.43, "timestamp": "01:24:03", "text": "デスマッチ。"}, {"type": "subtitle", "time": 5075.83, "timestamp": "01:24:35", "text": "ジャンプ。頑張れ、スネーク。ありがとう。彼らは"}, {"type": "subtitle", "time": 5078.229, "timestamp": "01:24:38", "text": "これを必ず行ってください。うん。ああ、彼らは行く"}, {"type": "subtitle", "time": 5081.27, "timestamp": "01:24:41", "text": "カスタム5対5をプレイする。私は自分が"}, {"type": "subtitle", "time": 5083.43, "timestamp": "01:24:43", "text": "おそらく十分な数の選手を集められるだろう。あなた"}, {"type": "subtitle", "time": 5084.95, "timestamp": "01:24:44", "text": "男の人たちは私よりずっと優れている。いいえ、いいえ、"}, {"type": "subtitle", "time": 5088.229, "timestamp": "01:24:48", "text": "いいえ。待って、待って、待って。私たちはそうではありません。えっと、私は"}, {"type": "subtitle", "time": 5089.31, "timestamp": "01:24:49", "text": "見る"}, {"type": "subtitle", "time": 5092.51, "timestamp": "01:24:52", "text": "あなた。待って、誰かを見たよ"}]
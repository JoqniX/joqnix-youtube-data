[{"type": "subtitle", "time": 15720.469, "timestamp": "04:22:00", "text": "ある意味、取引的なものだった"}, {"type": "subtitle", "time": 15724.229, "timestamp": "04:22:04", "text": "彼ら。だからそれは、ああ"}, {"type": "subtitle", "time": 15726.51, "timestamp": "04:22:06", "text": "数字 なぜ数字は"}, {"type": "subtitle", "time": 15730.469, "timestamp": "04:22:10", "text": "私の地位や私が何者であるかなどを判断してください。"}, {"type": "subtitle", "time": 15733.99, "timestamp": "04:22:13", "text": "なぜそうなっているのか、とかそういうこと。うん。私"}, {"type": "subtitle", "time": 15736.229, "timestamp": "04:22:16", "text": "私はそれについてすごく落ち込んでいたと思う"}, {"type": "subtitle", "time": 15739.189, "timestamp": "04:22:19", "text": "どこかの時点で正しいことが起こっている。うん。"}, {"type": "subtitle", "time": 15742.429, "timestamp": "04:22:22", "text": "そしてある意味では、それは"}, {"type": "chat", "time": 15745.297, "timestamp": "04:22:25", "author": "@site36.official", "avatar": "https://yt4.ggpht.com/Oc0kgq4lSUaD-BoDbaDE3pXUquuz47c4Yh7kwPILHO2D70EQ5EnEgoGgTbb5gw993EEXRqCx_A=s64-c-k-c0x00ffffff-no-rj", "message": "Guess what"}, {"type": "subtitle", "time": 15746.71, "timestamp": "04:22:26", "text": "人に手を差し伸べることへの小さな恐怖心だが"}, {"type": "subtitle", "time": 15756.95, "timestamp": "04:22:36", "text": "たとえ人々に強迫観念を抱くことであっても、"}, {"type": "subtitle", "time": 15761.189, "timestamp": "04:22:41", "text": "今日、私は4人に連絡を取りました"}, {"type": "subtitle", "time": 15765.189, "timestamp": "04:22:45", "text": "そして、彼らが反応してくれることを願う"}, {"type": "subtitle", "time": 15767.189, "timestamp": "04:22:47", "text": "もの。うん。"}, {"type": "subtitle", "time": 15769.83, "timestamp": "04:22:49", "text": "そうそう。それはあなたが成長していることを示していると思いませんか？"}, {"type": "subtitle", "time": 15772.309, "timestamp": "04:22:52", "text": "昔は、テキストメッセージなんて送らなかったからね"}, {"type": "subtitle", "time": 15775.429, "timestamp": "04:22:55", "text": "コラボしてくれる人募集中。"}, {"type": "subtitle", "time": 15778.389, "timestamp": "04:22:58", "text": "そして今のあなたを見てください。 1日4人。"}]
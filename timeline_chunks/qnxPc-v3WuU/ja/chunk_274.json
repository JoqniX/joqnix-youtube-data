[{"type": "subtitle", "time": 16440.59, "timestamp": "04:34:00", "text": "おそらく来る"}, {"type": "subtitle", "time": 16447.83, "timestamp": "04:34:07", "text": "ええ、そうなんです、私もそうしていますし"}, {"type": "subtitle", "time": 16450.029, "timestamp": "04:34:10", "text": "全て。だから、私はあなたに話したと思うのですが"}, {"type": "subtitle", "time": 16453.67, "timestamp": "04:34:13", "text": "これは昨日のことです。"}, {"type": "subtitle", "time": 16454.51, "timestamp": "04:34:14", "text": "あなた"}, {"type": "subtitle", "time": 16457.269, "timestamp": "04:34:17", "text": "した？ええ、つまりこれは"}, {"type": "subtitle", "time": 16460.31, "timestamp": "04:34:20", "text": "これは粘土のユーチューバーが話していたものです"}, {"type": "subtitle", "time": 16462.189, "timestamp": "04:34:22", "text": "について。させて"}, {"type": "subtitle", "time": 16465.029, "timestamp": "04:34:25", "text": "勃起させる。私はただそれを投稿することができます"}, {"type": "subtitle", "time": 16466.709, "timestamp": "04:34:26", "text": "Discord、ほら、必要ないでしょ"}, {"type": "subtitle", "time": 16468.67, "timestamp": "04:34:28", "text": "それを示すために。これ"}, {"type": "subtitle", "time": 16474.869, "timestamp": "04:34:34", "text": "すごくかっこいい。すごくかっこいいですよね？"}, {"type": "subtitle", "time": 16477.189, "timestamp": "04:34:37", "text": "うん、この人が持っているのはきれいだね"}, {"type": "subtitle", "time": 16480.869, "timestamp": "04:34:40", "text": "別のモデル。さらに良い"}, {"type": "subtitle", "time": 16488.789, "timestamp": "04:34:48", "text": "わあ、これはすごくクールだ。"}, {"type": "subtitle", "time": 16491.269, "timestamp": "04:34:51", "text": "私が言いたいのはそういうことです。まるで"}, {"type": "subtitle", "time": 16495.05, "timestamp": "04:34:55", "text": "実際はストップモーションアニメーションのようなもので、"}, {"type": "subtitle", "time": 16498.029, "timestamp": "04:34:58", "text": "[音楽]"}]
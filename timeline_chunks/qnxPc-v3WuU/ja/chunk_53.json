[{"type": "subtitle", "time": 3180.349, "timestamp": "00:53:00", "text": "良いものかどうかわからない"}, {"type": "subtitle", "time": 3184.23, "timestamp": "00:53:04", "text": "でも、そうなると思う"}, {"type": "subtitle", "time": 3187.829, "timestamp": "00:53:07", "text": "まあ、良くなったと思う。わからない。多分"}, {"type": "subtitle", "time": 3191.109, "timestamp": "00:53:11", "text": "説明欄に書いておきます"}, {"type": "subtitle", "time": 3194.87, "timestamp": "00:53:14", "text": "あるいは、そんな感じ。なぜ私はなぜあなたは持っているのか"}, {"type": "subtitle", "time": 3197.349, "timestamp": "00:53:17", "text": "なぜ質問するのですか、なぜ私は"}, {"type": "subtitle", "time": 3201.47, "timestamp": "00:53:21", "text": "チャットに登録する？そして私はこう答えた"}, {"type": "subtitle", "time": 3205.99, "timestamp": "00:53:25", "text": "うん、少しは見ておくといいよ。"}, {"type": "subtitle", "time": 3208.43, "timestamp": "00:53:28", "text": "そして、もしあなたが"}, {"type": "subtitle", "time": 3211.15, "timestamp": "00:53:31", "text": "ストリーム、もしあなたが"}, {"type": "subtitle", "time": 3213.03, "timestamp": "00:53:33", "text": "クリエイターとか、もしあなたが望むなら"}, {"type": "subtitle", "time": 3214.87, "timestamp": "00:53:34", "text": "作成者と交流し、"}, {"type": "subtitle", "time": 3218.549, "timestamp": "00:53:38", "text": "登録して、コメントして、"}, {"type": "subtitle", "time": 3221.63, "timestamp": "00:53:41", "text": "彼らと交流する"}, {"type": "subtitle", "time": 3224.87, "timestamp": "00:53:44", "text": "あれ。でも皆さん、覚えておいてください。"}, {"type": "subtitle", "time": 3227.91, "timestamp": "00:53:47", "text": "必ずしも購読する必要はありません。見て、もし"}, {"type": "subtitle", "time": 3231.91, "timestamp": "00:53:51", "text": "あなたは誰かをよく観察しているんですね、"}, {"type": "subtitle", "time": 3234.63, "timestamp": "00:53:54", "text": "YouTube は最終的に"}, {"type": "subtitle", "time": 3236.63, "timestamp": "00:53:56", "text": "ストリームを配信するか、何らかの方法でストリームを推奨する"}, {"type": "subtitle", "time": 3239.71, "timestamp": "00:53:59", "text": "あるいは何らかの方法で。だから覚えておいて"}]
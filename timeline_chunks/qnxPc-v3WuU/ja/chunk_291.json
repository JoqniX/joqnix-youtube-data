[{"type": "subtitle", "time": 17463.51, "timestamp": "04:51:03", "text": "本当にたくさんのことがあるよ、みんな。たくさんのこと。"}, {"type": "subtitle", "time": 17465.83, "timestamp": "04:51:05", "text": "うん。一緒に過ごすのを楽しみにしています"}, {"type": "subtitle", "time": 17469.11, "timestamp": "04:51:09", "text": "外に出て話したり、いろいろする。"}, {"type": "subtitle", "time": 17471.19, "timestamp": "04:51:11", "text": "もちろんそうしますよ。私は思う"}, {"type": "subtitle", "time": 17475.27, "timestamp": "04:51:15", "text": "みんな。うん。そうだといい。えっと、その"}, {"type": "subtitle", "time": 17477.67, "timestamp": "04:51:17", "text": "今は、もし私が"}, {"type": "subtitle", "time": 17480.35, "timestamp": "04:51:20", "text": "国外に出ると人々は"}, {"type": "subtitle", "time": 17485.35, "timestamp": "04:51:25", "text": "私と話さないとか、そういうこと。えっと、何？"}, {"type": "subtitle", "time": 17488.23, "timestamp": "04:51:28", "text": "わからない、だって何が"}, {"type": "chat", "time": 17490.31, "timestamp": "04:51:30", "author": "@site36.official", "avatar": "https://yt4.ggpht.com/Oc0kgq4lSUaD-BoDbaDE3pXUquuz47c4Yh7kwPILHO2D70EQ5EnEgoGgTbb5gw993EEXRqCx_A=s64-c-k-c0x00ffffff-no-rj", "message": "Pedo !???? "}, {"type": "subtitle", "time": 17490.67, "timestamp": "04:51:30", "text": "ヒンディー語で何と言いますか"}, {"type": "subtitle", "time": 17493.75, "timestamp": "04:51:33", "text": "調べてみます。ちょっと待って。私"}, {"type": "subtitle", "time": 17495.91, "timestamp": "04:51:35", "text": "特定の言葉があったと思う"}, {"type": "chat", "time": 17496.887, "timestamp": "04:51:36", "author": "@site36.official", "avatar": "https://yt4.ggpht.com/Oc0kgq4lSUaD-BoDbaDE3pXUquuz47c4Yh7kwPILHO2D70EQ5EnEgoGgTbb5gw993EEXRqCx_A=s64-c-k-c0x00ffffff-no-rj", "message": "SLANDEROUS"}, {"type": "subtitle", "time": 17498.708, "timestamp": "04:51:38", "text": "もの。"}, {"type": "subtitle", "time": 17500.788, "timestamp": "04:51:40", "text": "何てことだ。"}, {"type": "chat", "time": 17501.989, "timestamp": "04:51:41", "author": "@Roku-rin", "avatar": "https://yt4.ggpht.com/8LlS_C2IirDMfA5r2V0q5G1kudp8dmG6RQvz_jCAUT3H-esyEgTNPDwrfCXiyX7Undc9UmHNgw=s64-c-k-c0x00ffffff-no-rj", "message": "he wanted to talk to toddler Jpq"}, {"type": "subtitle", "time": 17503.51, "timestamp": "04:51:43", "text": "いいえ。あなたは自分がデシか"}, {"type": "subtitle", "time": 17507.91, "timestamp": "04:51:47", "text": "何か？デシ？何？"}, {"type": "chat", "time": 17511.577, "timestamp": "04:51:51", "author": "@Roku-rin", "avatar": "https://yt4.ggpht.com/8LlS_C2IirDMfA5r2V0q5G1kudp8dmG6RQvz_jCAUT3H-esyEgTNPDwrfCXiyX7Undc9UmHNgw=s64-c-k-c0x00ffffff-no-rj", "message": "Just saying PAUSE"}, {"type": "subtitle", "time": 17511.75, "timestamp": "04:51:51", "text": "あなたは、何のことか知っていますか？"}, {"type": "subtitle", "time": 17514.23, "timestamp": "04:51:54", "text": "まるで金庫破りのようだ。金庫キラー。何"}, {"type": "chat", "time": 17515.385, "timestamp": "04:51:55", "author": "@site36.official", "avatar": "https://yt4.ggpht.com/Oc0kgq4lSUaD-BoDbaDE3pXUquuz47c4Yh7kwPILHO2D70EQ5EnEgoGgTbb5gw993EEXRqCx_A=s64-c-k-c0x00ffffff-no-rj", "message": "Oh... that is pedo-esq"}]
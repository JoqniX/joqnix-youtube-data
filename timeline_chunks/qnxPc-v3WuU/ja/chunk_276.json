[{"type": "subtitle", "time": 16563.429, "timestamp": "04:36:03", "text": "彼は仕事のことで泣いていた。"}, {"type": "subtitle", "time": 16577.99, "timestamp": "04:36:17", "text": "たくさんのこと。"}, {"type": "subtitle", "time": 16590.47, "timestamp": "04:36:30", "text": "[音楽]"}, {"type": "subtitle", "time": 16594.23, "timestamp": "04:36:34", "text": "ゲームはどうですか？"}, {"type": "subtitle", "time": 16597.189, "timestamp": "04:36:37", "text": "ゲーム？うん。どういう意味ですか？あなたは"}, {"type": "subtitle", "time": 16599.429, "timestamp": "04:36:39", "text": "ゲームとか色々やってたよ。マーベルライバルズと"}, {"type": "subtitle", "time": 16601.23, "timestamp": "04:36:41", "text": "もの。"}, {"type": "subtitle", "time": 16605.83, "timestamp": "04:36:45", "text": "ああ、それね。ああ、残念だ。それは"}, {"type": "subtitle", "time": 16607.789, "timestamp": "04:36:47", "text": "マーベルをプレイするたびに憂鬱になる"}, {"type": "subtitle", "time": 16617.83, "timestamp": "04:36:57", "text": "脳細胞を失いたいなら"}, {"type": "subtitle", "time": 16619.59, "timestamp": "04:36:59", "text": "そして本当にひどい目に遭うなら、"}]
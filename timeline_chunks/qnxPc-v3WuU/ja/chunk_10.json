[{"type": "subtitle", "time": 600.949, "timestamp": "00:10:00", "text": "公衆に展示または公の場で"}, {"type": "subtitle", "time": 603.67, "timestamp": "00:10:03", "text": "報道や公的な事柄で、例えば"}, {"type": "subtitle", "time": 606.47, "timestamp": "00:10:06", "text": "どうなるかはわからないけど、"}, {"type": "subtitle", "time": 610.47, "timestamp": "00:10:10", "text": "あなたの本名（ファーストネーム）をいいねしてください"}, {"type": "subtitle", "time": 613.75, "timestamp": "00:10:13", "text": "あなたの名前は、えーと、2つのファーストネームで構成されています。"}, {"type": "subtitle", "time": 618.15, "timestamp": "00:10:18", "text": "最後の２つ、えっと、あれですよね？最初、最後、"}, {"type": "subtitle", "time": 620.91, "timestamp": "00:10:20", "text": "最初はこんな感じ"}, {"type": "subtitle", "time": 623.99, "timestamp": "00:10:23", "text": "名前、あなたのファーストネーム、あなたの本名、"}, {"type": "subtitle", "time": 626.47, "timestamp": "00:10:26", "text": "それからあなたのゲーマーネームか、eスポーツ関連のもの"}, {"type": "subtitle", "time": 628.67, "timestamp": "00:10:28", "text": "あなたが"}, {"type": "subtitle", "time": 631.91, "timestamp": "00:10:31", "text": "インターネットですよね？そして最後に"}, {"type": "subtitle", "time": 634.11, "timestamp": "00:10:34", "text": "名前、"}, {"type": "subtitle", "time": 638.84, "timestamp": "00:10:38", "text": "右？うん、そういうことだよね？"}, {"type": "subtitle", "time": 641.069, "timestamp": "00:10:41", "text": "[音楽]"}, {"type": "subtitle", "time": 644.11, "timestamp": "00:10:44", "text": "えーと、例えば"}, {"type": "subtitle", "time": 647.15, "timestamp": "00:10:47", "text": "シュラウド、私たちは皆シュラウドを知っている"}, {"type": "subtitle", "time": 651.269, "timestamp": "00:10:51", "text": "そうですね、彼のファーストネームはマイケルです。"}, {"type": "subtitle", "time": 653.99, "timestamp": "00:10:53", "text": "それはマイケル・シュラウドのようになるだろう、そして彼の"}, {"type": "subtitle", "time": 655.75, "timestamp": "00:10:55", "text": "発音しにくい苗字、または"}, {"type": "subtitle", "time": 659.43, "timestamp": "00:10:59", "text": "オーマイゴッドグリーシーとか何とか発音する"}]
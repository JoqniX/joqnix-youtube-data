[{"type": "subtitle", "time": 11583.269, "timestamp": "03:13:03", "text": "排除する。それを得る。それを得る。それを得る。得る"}, {"type": "subtitle", "time": 11586.07, "timestamp": "03:13:06", "text": "それ。それを得る。それを得る。"}, {"type": "subtitle", "time": 11588.63, "timestamp": "03:13:08", "text": "選手の立ち位置。"}, {"type": "subtitle", "time": 11591.429, "timestamp": "03:13:11", "text": "何てことだ。大丈夫。"}, {"type": "subtitle", "time": 11594.469, "timestamp": "03:13:14", "text": "惜しかったね。惜しかったね。大丈夫。私たちは努力します。"}, {"type": "subtitle", "time": 11595.99, "timestamp": "03:13:15", "text": "いいえ。"}, {"type": "subtitle", "time": 11598.79, "timestamp": "03:13:18", "text": "待って。なぜあなたは死んだのですか？私は"}, {"type": "subtitle", "time": 11602.63, "timestamp": "03:13:22", "text": "彼女を「ああ神様」って感じにする。私のミスです。私のミスです。"}, {"type": "subtitle", "time": 11606.469, "timestamp": "03:13:26", "text": "私のミスです。ああ、神様。"}, {"type": "subtitle", "time": 11608.469, "timestamp": "03:13:28", "text": "彼女は私がそこにいることに気づいていなかった。私は行くつもりだった"}, {"type": "subtitle", "time": 11610.59, "timestamp": "03:13:30", "text": "近づく"}, {"type": "subtitle", "time": 11614.15, "timestamp": "03:13:34", "text": "彼女。神。"}, {"type": "subtitle", "time": 11618.15, "timestamp": "03:13:38", "text": "もし私が知らないと言ったら、おそらく"}, {"type": "subtitle", "time": 11621.59, "timestamp": "03:13:41", "text": "待って、いや、今はムンバイだ。私たちはどこへ行ったんだっけ？"}, {"type": "subtitle", "time": 11623.75, "timestamp": "03:13:43", "text": "ムンバイで演奏していたとき、"}, {"type": "subtitle", "time": 11627.83, "timestamp": "03:13:47", "text": "シンガポールでは、ああ、わかった、わかった"}, {"type": "subtitle", "time": 11630.79, "timestamp": "03:13:50", "text": "こんにちは、ああ、サーバーは"}, {"type": "subtitle", "time": 11632.67, "timestamp": "03:13:52", "text": "ムンバイ"}]
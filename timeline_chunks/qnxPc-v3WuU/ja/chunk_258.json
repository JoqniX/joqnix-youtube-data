[{"type": "subtitle", "time": 15483.03, "timestamp": "04:18:03", "text": "私もサムネイル全部好きです"}, {"type": "subtitle", "time": 15484.75, "timestamp": "04:18:04", "text": "親指すべて"}, {"type": "subtitle", "time": 15488.149, "timestamp": "04:18:08", "text": "もの。だから、それがどういうことなのかよくわからない"}, {"type": "subtitle", "time": 15491.83, "timestamp": "04:18:11", "text": "そうなるだろうけど、うん、君は置くことができる"}, {"type": "subtitle", "time": 15494.95, "timestamp": "04:18:14", "text": "そのデータ全てをDMで他の誰かに送る"}, {"type": "subtitle", "time": 15498.63, "timestamp": "04:18:18", "text": "アカウント。それは本当です。うん。"}, {"type": "subtitle", "time": 15500.389, "timestamp": "04:18:20", "text": "いつでも好きな時に選ぶことができます"}, {"type": "subtitle", "time": 15502.55, "timestamp": "04:18:22", "text": "あなたが望むもの。まるでそれができるかのように"}, {"type": "subtitle", "time": 15506.55, "timestamp": "04:18:26", "text": "そうだけど、仕事になるんだよ。はい。"}, {"type": "subtitle", "time": 15510.309, "timestamp": "04:18:30", "text": "私ももう時間がない。"}, {"type": "subtitle", "time": 15512.229, "timestamp": "04:18:32", "text": "その通り。"}, {"type": "subtitle", "time": 15515.67, "timestamp": "04:18:35", "text": "ええ、そうですね。うん。君はまだ僕を捕まえているよ、"}, {"type": "subtitle", "time": 15516.87, "timestamp": "04:18:36", "text": "けれど。サムネイルを作成します。しないで"}, {"type": "subtitle", "time": 15518.79, "timestamp": "04:18:38", "text": "心配。"}, {"type": "subtitle", "time": 15521.309, "timestamp": "04:18:41", "text": "ありがとう。ランダムに作成する"}, {"type": "subtitle", "time": 15523.83, "timestamp": "04:18:43", "text": "サムネイル。落書きみたいな感じで描いてみます"}, {"type": "subtitle", "time": 15525.67, "timestamp": "04:18:45", "text": "サムネイル。あなたにとってはそれで十分でしょう。うん。"}, {"type": "subtitle", "time": 15527.349, "timestamp": "04:18:47", "text": "うん。それで十分です。それは良い"}, {"type": "subtitle", "time": 15529.91, "timestamp": "04:18:49", "text": "十分。"}, {"type": "subtitle", "time": 15535.389, "timestamp": "04:18:55", "text": "うん。 H でも、そう、たくさんいる"}]
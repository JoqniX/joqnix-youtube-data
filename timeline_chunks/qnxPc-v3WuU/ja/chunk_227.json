[{"type": "subtitle", "time": 13623.03, "timestamp": "03:47:03", "text": "そして私は一度バイオリンを習いたいと思った"}, {"type": "subtitle", "time": 13626.79, "timestamp": "03:47:06", "text": "えーと、その他いろいろ。だから、私は聞いていた"}, {"type": "subtitle", "time": 13629.51, "timestamp": "03:47:09", "text": "バイオリンを聴きながら眠りにつこうとしている"}, {"type": "subtitle", "time": 13632.229, "timestamp": "03:47:12", "text": "午後12時半頃かな"}, {"type": "subtitle", "time": 13634.51, "timestamp": "03:47:14", "text": "とても疲れていた。"}, {"type": "subtitle", "time": 13637.79, "timestamp": "03:47:17", "text": "ええ、"}, {"type": "subtitle", "time": 13642.67, "timestamp": "03:47:22", "text": "えっと、なんて言うんでしたっけ？"}, {"type": "subtitle", "time": 13647.11, "timestamp": "03:47:27", "text": "ええ、突然夢を見たんです"}, {"type": "subtitle", "time": 13653.349, "timestamp": "03:47:33", "text": "私はエリカと友達で、神様"}, {"type": "subtitle", "time": 13657.11, "timestamp": "03:47:37", "text": "そして私は、彼女が許してくれたように彼女を参加させた。"}, {"type": "subtitle", "time": 13659.99, "timestamp": "03:47:39", "text": "彼女の配信を一緒に楽しむ。私は"}, {"type": "subtitle", "time": 13662.15, "timestamp": "03:47:42", "text": "背景で彼女と話している"}, {"type": "subtitle", "time": 13665.429, "timestamp": "03:47:45", "text": "彼女はギターを弾いたりしている"}, {"type": "subtitle", "time": 13667.91, "timestamp": "03:47:47", "text": "音楽とかそういうもの。彼女が立ち止まるたびに、"}, {"type": "subtitle", "time": 13670.63, "timestamp": "03:47:50", "text": "私たちは二人で話したり、そういうことをしました。そして"}, {"type": "subtitle", "time": 13673.67, "timestamp": "03:47:53", "text": "そして停電が来て、私は"}, {"type": "subtitle", "time": 13676.469, "timestamp": "03:47:56", "text": "切り替えました。私は彼らのチャットに参加していて、"}, {"type": "subtitle", "time": 13679.51, "timestamp": "03:47:59", "text": "すべて、話したり、その他いろいろ"}]
[{"type": "subtitle", "time": 9199.59, "timestamp": "02:33:19", "text": "必ず一番乗りを目指しましょう。どうやって"}, {"type": "subtitle", "time": 9224.389, "timestamp": "02:33:44", "text": "ポン引き。ジュク先輩、調子はどうですか？いいえ、"}, {"type": "subtitle", "time": 9227.19, "timestamp": "02:33:47", "text": "私はトップの座を獲得するつもりはありません。"}, {"type": "subtitle", "time": 9229.51, "timestamp": "02:33:49", "text": "私は全力を尽くしています。彼らもまたとても"}, {"type": "subtitle", "time": 9231.11, "timestamp": "02:33:51", "text": "良い。"}, {"type": "subtitle", "time": 9232.63, "timestamp": "02:33:52", "text": "何？"}, {"type": "subtitle", "time": 9235.75, "timestamp": "02:33:55", "text": "うん。あなたは全力を尽くしているのですか？ああ、"}, {"type": "subtitle", "time": 9238.95, "timestamp": "02:33:58", "text": "最も難しい。でも、本当に美味しいんです。はい。いいえ、"}]
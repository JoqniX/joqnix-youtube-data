[{"type": "subtitle", "time": 11641.91, "timestamp": "03:14:01", "text": "ピューピュー いやいやいや、私が話していたのは"}, {"type": "subtitle", "time": 11643.349, "timestamp": "03:14:03", "text": "私が話していたあのバーは"}, {"type": "subtitle", "time": 11647.51, "timestamp": "03:14:07", "text": "細い棒のようなものがある"}, {"type": "subtitle", "time": 11650.15, "timestamp": "03:14:10", "text": "ヘルスバーのデザイン。いや、いや、"}, {"type": "subtitle", "time": 11652.07, "timestamp": "03:14:12", "text": "いいえ。しかし、それは設計上の意図ではありません。"}, {"type": "subtitle", "time": 11655.83, "timestamp": "03:14:15", "text": "前回のように、その前の試合を見たとき"}, {"type": "subtitle", "time": 11658.389, "timestamp": "03:14:18", "text": "私たちのうち1人だけがそのバーを持っていて、4人が"}, {"type": "subtitle", "time": 11661.349, "timestamp": "03:14:21", "text": "敵は、まるで私がそうではないかのようにそのバーを持っていた"}, {"type": "subtitle", "time": 11665.03, "timestamp": "03:14:25", "text": "それが何であるかを知る。究極の"}, {"type": "subtitle", "time": 11667.11, "timestamp": "03:14:27", "text": "一致するものが見つかりましたか？"}, {"type": "subtitle", "time": 11669.03, "timestamp": "03:14:29", "text": "私も今回は注意して見てみようと思います。うん。"}]
[{"type": "subtitle", "time": 16622.15, "timestamp": "04:37:02", "text": "M Rivals Randをプレイしてください。それが"}, {"type": "subtitle", "time": 16623.99, "timestamp": "04:37:03", "text": "そうすべきだ。"}, {"type": "subtitle", "time": 16625.47, "timestamp": "04:37:05", "text": "Mライバル、あなたは"}, {"type": "subtitle", "time": 16628.47, "timestamp": "04:37:08", "text": "平均？どういう意味ですか？それは良いことではない"}, {"type": "subtitle", "time": 16635.349, "timestamp": "04:37:15", "text": "[音楽]"}, {"type": "subtitle", "time": 16638.39, "timestamp": "04:37:18", "text": "プレイしたいです。はい。現在私は"}, {"type": "subtitle", "time": 16640.949, "timestamp": "04:37:20", "text": "アンインストールする"}, {"type": "subtitle", "time": 16651.31, "timestamp": "04:37:31", "text": "ええと、新しいアップデートとサブがあります"}, {"type": "subtitle", "time": 16654.39, "timestamp": "04:37:34", "text": "バージョン2.5が本日リリースされました。おそらく"}, {"type": "subtitle", "time": 16657.91, "timestamp": "04:37:37", "text": "今。ほぼ間違いないと思います。"}, {"type": "subtitle", "time": 16659.429, "timestamp": "04:37:39", "text": "うん。"}, {"type": "subtitle", "time": 16661.349, "timestamp": "04:37:41", "text": "ええと、あなたのキャラクターは強化されました"}, {"type": "subtitle", "time": 16663.349, "timestamp": "04:37:43", "text": "季節。"}, {"type": "subtitle", "time": 16665.39, "timestamp": "04:37:45", "text": "どれの？"}, {"type": "subtitle", "time": 16667.349, "timestamp": "04:37:47", "text": "ホークアイ。それが唯一のキャラクターです"}, {"type": "subtitle", "time": 16669.91, "timestamp": "04:37:49", "text": "遊ぶ。どういう意味ですか？どれの？ああ、"}, {"type": "subtitle", "time": 16673.029, "timestamp": "04:37:53", "text": "ホークアイ。はい。はい。はい。はい。"}, {"type": "subtitle", "time": 16675.269, "timestamp": "04:37:55", "text": "わかった。バフとか色々手に入れたよ。彼は"}, {"type": "subtitle", "time": 16677.75, "timestamp": "04:37:57", "text": "今は凍結矢を撃てるようになりました。彼はできる"}]
[{"type": "subtitle", "time": 7992.709, "timestamp": "02:13:12", "text": "敵はあと一体。最後のプレイヤー"}, {"type": "subtitle", "time": 8002.669, "timestamp": "02:13:22", "text": "いいえ。"}, {"type": "subtitle", "time": 8005.629, "timestamp": "02:13:25", "text": "NT。私はその曲が好きです。"}, {"type": "subtitle", "time": 8007.87, "timestamp": "02:13:27", "text": "うん。"}, {"type": "subtitle", "time": 8010.069, "timestamp": "02:13:30", "text": "こんにちは、Sの署名です。こんにちは。元気ですか"}, {"type": "subtitle", "time": 8011.27, "timestamp": "02:13:31", "text": "今日？今日は良い一日をお過ごしでしょうか。私"}, {"type": "subtitle", "time": 8014.229, "timestamp": "02:13:34", "text": "チャットであ​​なたを見かけたことは一度もありません。あなたに"}, {"type": "subtitle", "time": 8016.229, "timestamp": "02:13:36", "text": "ご滞在をお楽しみください。"}, {"type": "subtitle", "time": 8018.709, "timestamp": "02:13:38", "text": "今日はまあまあですね。わからない。私は好きではありません"}, {"type": "subtitle", "time": 8022.069, "timestamp": "02:13:42", "text": "リンゴジュース。私はオレンジ色が好きではありません。だから私は"}, {"type": "subtitle", "time": 8023.91, "timestamp": "02:13:43", "text": "オレンジジュースは好きじゃない。あなたの"}, {"type": "subtitle", "time": 8025.91, "timestamp": "02:13:45", "text": "でも一番好きなのは？えーと、私のお気に入りは"}, {"type": "subtitle", "time": 8028.149, "timestamp": "02:13:48", "text": "リンゴジュース。そしてもし"}, {"type": "subtitle", "time": 8031.95, "timestamp": "02:13:51", "text": "ミルクシェイク、それからストロベリー"}, {"type": "subtitle", "time": 8034.069, "timestamp": "02:13:54", "text": "いつも。なぜ好きなのかわからない"}]
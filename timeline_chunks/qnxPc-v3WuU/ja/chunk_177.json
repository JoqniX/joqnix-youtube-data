[{"type": "subtitle", "time": 10633.51, "timestamp": "02:57:13", "text": "ほとんど全部持っているのを見ました"}, {"type": "subtitle", "time": 10636.87, "timestamp": "02:57:16", "text": "渡る前に。うん。"}, {"type": "subtitle", "time": 10646.71, "timestamp": "02:57:26", "text": "アラームを設置します。私はここから出て行く。配置"}, {"type": "subtitle", "time": 10654.79, "timestamp": "02:57:34", "text": "ここは注意が必要だ。"}, {"type": "subtitle", "time": 10657.269, "timestamp": "02:57:37", "text": "ああ、ああ、なんてことだ、この古典は"}, {"type": "subtitle", "time": 10659.03, "timestamp": "02:57:39", "text": "どこに行ったのか分からない。私はそうすべきだった"}, {"type": "subtitle", "time": 10663.19, "timestamp": "02:57:43", "text": "昨日このスキンを買いました。"}, {"type": "subtitle", "time": 10665.07, "timestamp": "02:57:45", "text": "ああ、それはとても"}, {"type": "subtitle", "time": 10669.03, "timestamp": "02:57:49", "text": "良い。今考えると、なぜスキップしたんだろう"}, {"type": "subtitle", "time": 10671.75, "timestamp": "02:57:51", "text": "これ？"}]
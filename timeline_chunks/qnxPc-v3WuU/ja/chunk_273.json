[{"type": "subtitle", "time": 16382.63, "timestamp": "04:33:02", "text": "私が取ってあげましょう。彼は"}, {"type": "subtitle", "time": 16385.83, "timestamp": "04:33:05", "text": "数ヶ月ほどかなり有名"}, {"type": "subtitle", "time": 16387.59, "timestamp": "04:33:07", "text": "前。ご覧になったことがあるかもしれません"}, {"type": "subtitle", "time": 16388.99, "timestamp": "04:33:08", "text": "それ"}, {"type": "subtitle", "time": 16406.949, "timestamp": "04:33:26", "text": "何？もう一人いる。そこには"}, {"type": "subtitle", "time": 16409.59, "timestamp": "04:33:29", "text": "別の人。ちょっと待ってください。私にさせて"}, {"type": "subtitle", "time": 16412.551, "timestamp": "04:33:32", "text": "ただ見つければいい。ええ、そういうこともあり得ますね。"}, {"type": "subtitle", "time": 16414.15, "timestamp": "04:33:34", "text": "なんてこった。いいえ。同一人物です。ごめん。"}, {"type": "subtitle", "time": 16418.551, "timestamp": "04:33:38", "text": "同一人物です。くそ。"}, {"type": "subtitle", "time": 16421.029, "timestamp": "04:33:41", "text": "うん。それで、"}, {"type": "subtitle", "time": 16423.83, "timestamp": "04:33:43", "text": "うん。私は何かをしたかった"}, {"type": "subtitle", "time": 16427.429, "timestamp": "04:33:47", "text": "そういう感じだよ。"}, {"type": "subtitle", "time": 16429.789, "timestamp": "04:33:49", "text": "チャドにはそれが見えない。それはただの感覚です"}, {"type": "subtitle", "time": 16433.07, "timestamp": "04:33:53", "text": "悲しい。私はただ置いた"}, {"type": "subtitle", "time": 16436.551, "timestamp": "04:33:56", "text": "うん。わかった。ただチャットして、えっと"}, {"type": "subtitle", "time": 16439.349, "timestamp": "04:33:59", "text": "粘土ユーチューバーモデル、そしてその人は"}]
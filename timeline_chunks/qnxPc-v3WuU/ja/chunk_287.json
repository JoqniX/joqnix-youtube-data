[{"type": "subtitle", "time": 17221.35, "timestamp": "04:47:01", "text": "いつでも気軽にコラボレーションできる人たちです。"}, {"type": "subtitle", "time": 17223.91, "timestamp": "04:47:03", "text": "いつでも気軽に一緒に過ごせるような感じ。"}, {"type": "subtitle", "time": 17227.75, "timestamp": "04:47:07", "text": "全部最後に取っておくのがいいと思うし"}, {"type": "subtitle", "time": 17230.35, "timestamp": "04:47:10", "text": "えっと、最初のコラボを全部最初に手に入れよう"}, {"type": "subtitle", "time": 17232.51, "timestamp": "04:47:12", "text": "コラボレーションする"}, {"type": "subtitle", "time": 17235.27, "timestamp": "04:47:15", "text": "さて、あなたはただ"}, {"type": "subtitle", "time": 17238.07, "timestamp": "04:47:18", "text": "最終日のギャングたち、だから君たちも"}, {"type": "chat", "time": 17239.369, "timestamp": "04:47:19", "author": "@Roku-rin", "avatar": "https://yt4.ggpht.com/8LlS_C2IirDMfA5r2V0q5G1kudp8dmG6RQvz_jCAUT3H-esyEgTNPDwrfCXiyX7Undc9UmHNgw=s64-c-k-c0x00ffffff-no-rj", "message": "I mean you dont even have to squeeze us in too "}, {"type": "subtitle", "time": 17240.39, "timestamp": "04:47:20", "text": "最高に楽しい時間を過ごせる"}, {"type": "subtitle", "time": 17243.43, "timestamp": "04:47:23", "text": "私なしで。"}, {"type": "subtitle", "time": 17245.03, "timestamp": "04:47:25", "text": "ジョー、それが君の言いたいことなの？"}, {"type": "subtitle", "time": 17248.628, "timestamp": "04:47:28", "text": "わかった。何てことだ。いいえ。"}, {"type": "subtitle", "time": 17251.51, "timestamp": "04:47:31", "text": "いいえ。もし私がまたそう思うなら、Rokuだけだと思います。"}, {"type": "subtitle", "time": 17254.23, "timestamp": "04:47:34", "text": "残っている。"}, {"type": "subtitle", "time": 17257.11, "timestamp": "04:47:37", "text": "うん。ロク。 Rokuと州。私はできませんでした"}, {"type": "subtitle", "time": 17258.83, "timestamp": "04:47:38", "text": "連絡を取る"}, {"type": "subtitle", "time": 17263.35, "timestamp": "04:47:43", "text": "滞在した。でも、そう、ただそこにいるだけ。私はそうします"}, {"type": "subtitle", "time": 17265.03, "timestamp": "04:47:45", "text": "私が代わりに州に連絡してみます。心配しないで"}, {"type": "subtitle", "time": 17268.628, "timestamp": "04:47:48", "text": "それについて。私はほとんど連絡を取らなかった"}, {"type": "subtitle", "time": 17271.11, "timestamp": "04:47:51", "text": "この時点では、スタッドのような誰もが、"}, {"type": "subtitle", "time": 17273.27, "timestamp": "04:47:53", "text": "クラウド、私がDestinyをプレイしていた時のもの"}, {"type": "subtitle", "time": 17275.03, "timestamp": "04:47:55", "text": "と。"}, {"type": "subtitle", "time": 17276.59, "timestamp": "04:47:56", "text": "イエス。"}]
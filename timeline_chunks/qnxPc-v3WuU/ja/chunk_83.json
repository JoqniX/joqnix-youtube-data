[{"type": "subtitle", "time": 4981.91, "timestamp": "01:23:01", "text": "戦いに身を投じる覚悟があるかどうかを知る"}, {"type": "subtitle", "time": 4985.51, "timestamp": "01:23:05", "text": "そして、あなたは勝つでしょう"}, {"type": "subtitle", "time": 4988.95, "timestamp": "01:23:08", "text": "戦うとか、しゃがむとか、そういうこと"}, {"type": "subtitle", "time": 4990.31, "timestamp": "01:23:10", "text": "それはまるで戦いに身を投じるようなものだ"}, {"type": "subtitle", "time": 5001.03, "timestamp": "01:23:21", "text": "しゃがむ、そう、しゃがむというのは実際には"}, {"type": "subtitle", "time": 5008.91, "timestamp": "01:23:28", "text": "ああ、なるほど。"}, {"type": "subtitle", "time": 5011.27, "timestamp": "01:23:31", "text": "うん。あなたは、"}, {"type": "subtitle", "time": 5016.55, "timestamp": "01:23:36", "text": "でも、ほとんどの場合、"}, {"type": "subtitle", "time": 5018.79, "timestamp": "01:23:38", "text": "しゃがむべきではない、なぜならあなたは"}, {"type": "subtitle", "time": 5021.55, "timestamp": "01:23:41", "text": "脆弱なのは、実際にはできないから"}, {"type": "subtitle", "time": 5025.11, "timestamp": "01:23:45", "text": "しゃがんだまま右に動く。"}, {"type": "subtitle", "time": 5028.07, "timestamp": "01:23:48", "text": "はい。"}, {"type": "subtitle", "time": 5036.39, "timestamp": "01:23:56", "text": "行く。どこに隠れているのですか？イナゴ。おお"}, {"type": "subtitle", "time": 5039.189, "timestamp": "01:23:59", "text": "我が神よ。私はあなたを殺しているわけではありません。"}]
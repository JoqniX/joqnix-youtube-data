[{"type": "subtitle", "time": 7561.43, "timestamp": "02:06:01", "text": "一体誰がそんなに優秀なんだろう。うん。だから"}, {"type": "subtitle", "time": 7565.669, "timestamp": "02:06:05", "text": "調子はどう？今日はいい一日だ。"}, {"type": "subtitle", "time": 7568.55, "timestamp": "02:06:08", "text": "はい、オレンジジュースを飲んでいます。"}, {"type": "subtitle", "time": 7572.07, "timestamp": "02:06:12", "text": "ああ、オレンジジュースを飲んでいるんですね。"}, {"type": "subtitle", "time": 7575.03, "timestamp": "02:06:15", "text": "はい、わかりました。待って、えーと、何味の"}, {"type": "subtitle", "time": 7577.109, "timestamp": "02:06:17", "text": "飲む？ええと、ソフトドリンク。好きですか"}, {"type": "subtitle", "time": 7580.629, "timestamp": "02:06:20", "text": "オレンジジュースかソフトドリンクか？私は好きです"}, {"type": "subtitle", "time": 7584.109, "timestamp": "02:06:24", "text": "ええ、私は自然飲料が好きです。何でも"}, {"type": "subtitle", "time": 7588.629, "timestamp": "02:06:28", "text": "自然？つまり、君と僕が1対1で戦うってことか。"}, {"type": "subtitle", "time": 7591.03, "timestamp": "02:06:31", "text": "つまり、もしあなたが望むなら、私はできると思います。"}, {"type": "subtitle", "time": 7595.31, "timestamp": "02:06:35", "text": "はい、もしあなたがそれに勝ったなら"}, {"type": "subtitle", "time": 7601.709, "timestamp": "02:06:41", "text": "スペア"}, {"type": "subtitle", "time": 7608.99, "timestamp": "02:06:48", "text": "大丈夫かな？いやいや、大丈夫だよ"}, {"type": "subtitle", "time": 7610.669, "timestamp": "02:06:50", "text": "行く"}, {"type": "subtitle", "time": 7614.149, "timestamp": "02:06:54", "text": "私の火の複製"}, {"type": "subtitle", "time": 7617.27, "timestamp": "02:06:57", "text": "どういう意味ですか？あなたは私の"}]
[{"type": "subtitle", "time": 6137.35, "timestamp": "01:42:17", "text": "シェリフ？私の車のどれですか？私は"}, {"type": "subtitle", "time": 6139.64, "timestamp": "01:42:19", "text": "車。わかった。こんにちは。こんにちは。こんにちは。こんにちは。こんにちは。"}, {"type": "subtitle", "time": 6143.109, "timestamp": "01:42:23", "text": "[笑い]"}, {"type": "subtitle", "time": 6145.669, "timestamp": "01:42:25", "text": "邪魔だ、どけ。"}, {"type": "subtitle", "time": 6149.35, "timestamp": "01:42:29", "text": "私は理性を失った。"}, {"type": "subtitle", "time": 6163.99, "timestamp": "01:42:43", "text": "ジョーク。"}, {"type": "subtitle", "time": 6177.13, "timestamp": "01:42:57", "text": "あれを見て。"}, {"type": "subtitle", "time": 6178.27, "timestamp": "01:42:58", "text": "[音楽]"}]
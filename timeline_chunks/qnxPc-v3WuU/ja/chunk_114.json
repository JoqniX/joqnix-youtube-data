[{"type": "subtitle", "time": 6843.589, "timestamp": "01:54:03", "text": "ああ、いい、いい、いい、いい仕事だ"}, {"type": "subtitle", "time": 6845.27, "timestamp": "01:54:05", "text": "作成中。"}, {"type": "subtitle", "time": 6861.189, "timestamp": "01:54:21", "text": "[拍手]"}, {"type": "subtitle", "time": 6862.27, "timestamp": "01:54:22", "text": "私と"}, {"type": "subtitle", "time": 6865.35, "timestamp": "01:54:25", "text": "アニクナと1対1で。私は殺していなかった"}, {"type": "subtitle", "time": 6884.31, "timestamp": "01:54:44", "text": "何てことだ。なぜ私は彼女を殴ったのか？私は彼女を殴った"}, {"type": "subtitle", "time": 6888.99, "timestamp": "01:54:48", "text": "しかし、頭が。ダジャレが私を打ちのめしている。どうやって？"}, {"type": "subtitle", "time": 6891.669, "timestamp": "01:54:51", "text": "神は一つを創造した。何てことだ。彼は"}]
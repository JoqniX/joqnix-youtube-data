[{"type": "subtitle", "time": 14641.83, "timestamp": "04:04:01", "text": "うん。日本に行く、ストレス、言う"}, {"type": "subtitle", "time": 14644.87, "timestamp": "04:04:04", "text": "みんなにさよならを言うやつ。それから"}, {"type": "subtitle", "time": 14647.349, "timestamp": "04:04:07", "text": "ストリームが途中で機能せず、"}, {"type": "subtitle", "time": 14649.15, "timestamp": "04:04:09", "text": "技術的なもののように"}, {"type": "subtitle", "time": 14651.55, "timestamp": "04:04:11", "text": "問題。"}, {"type": "subtitle", "time": 14655.269, "timestamp": "04:04:15", "text": "えっと、友達を何人か失ったような気がする。私"}, {"type": "subtitle", "time": 14658.389, "timestamp": "04:04:18", "text": "私の"}, {"type": "subtitle", "time": 14660.83, "timestamp": "04:04:20", "text": "トラブルに巻き込まれた友人たちと"}, {"type": "subtitle", "time": 14665.269, "timestamp": "04:04:25", "text": "いろいろなことや、私が参加したイベントは"}, {"type": "subtitle", "time": 14668.71, "timestamp": "04:04:28", "text": "楽しい。善と悪のようなものがあった"}, {"type": "subtitle", "time": 14671.67, "timestamp": "04:04:31", "text": "多く。それは満たされていた"}, {"type": "subtitle", "time": 14673.71, "timestamp": "04:04:33", "text": "すべてだと思う。"}, {"type": "subtitle", "time": 14677.349, "timestamp": "04:04:37", "text": "右？さまざまな感情と"}, {"type": "subtitle", "time": 14680.309, "timestamp": "04:04:40", "text": "一番重要なのは舞台裏の出来事だった"}, {"type": "subtitle", "time": 14684.469, "timestamp": "04:04:44", "text": "ああ、そうそう、人間のことと"}, {"type": "subtitle", "time": 14686.389, "timestamp": "04:04:46", "text": "すべて。"}, {"type": "subtitle", "time": 14688.07, "timestamp": "04:04:48", "text": "そして"}, {"type": "subtitle", "time": 14689.71, "timestamp": "04:04:49", "text": "私はまだ"}, {"type": "subtitle", "time": 14693.03, "timestamp": "04:04:53", "text": "実際に招待することを考えたことはない"}, {"type": "subtitle", "time": 14697.51, "timestamp": "04:04:57", "text": "二人ともジョーンについて。"}]
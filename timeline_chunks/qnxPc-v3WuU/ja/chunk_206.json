[{"type": "subtitle", "time": 12361.349, "timestamp": "03:26:01", "text": "私は、"}, {"type": "subtitle", "time": 12363.11, "timestamp": "03:26:03", "text": "秘密。"}, {"type": "subtitle", "time": 12374.95, "timestamp": "03:26:14", "text": "え、何？私はここでチャットを読んでいました。ああ、"}, {"type": "subtitle", "time": 12376.87, "timestamp": "03:26:16", "text": "神。"}, {"type": "subtitle", "time": 12400.15, "timestamp": "03:26:40", "text": "ああ、なんてことだ、私の足が。戻ってきました。どのように"}, {"type": "subtitle", "time": 12408.469, "timestamp": "03:26:48", "text": "もう一人、私としてプレイするのが好きな人。"}, {"type": "subtitle", "time": 12411.99, "timestamp": "03:26:51", "text": "あ、待って。あなたも好きじゃないですか"}, {"type": "subtitle", "time": 12419.269, "timestamp": "03:26:59", "text": "ドロップをもらえますか？"}]
[{"type": "subtitle", "time": 10382.23, "timestamp": "02:53:02", "text": "スキンを購入する。いいえ、スキンは買いません。"}, {"type": "subtitle", "time": 10383.95, "timestamp": "02:53:03", "text": "だって私は"}, {"type": "subtitle", "time": 10386.95, "timestamp": "02:53:06", "text": "後悔。スネーク、君は勝っているのか？はい、私たちは"}, {"type": "subtitle", "time": 10389.67, "timestamp": "02:53:09", "text": "は。私は運ばれています。その通りです。"}, {"type": "subtitle", "time": 10392.469, "timestamp": "02:53:12", "text": "ハク。"}, {"type": "subtitle", "time": 10394.55, "timestamp": "02:53:14", "text": "私は運ばれています。"}, {"type": "subtitle", "time": 10396.91, "timestamp": "02:53:16", "text": "うなずく。えっと、"}, {"type": "subtitle", "time": 10400.23, "timestamp": "02:53:20", "text": "ハカン、なぜうまくいかなかったのですか？私は聞いています"}, {"type": "subtitle", "time": 10414.23, "timestamp": "02:53:34", "text": "ガーディアン紙で君を見つけたよ。うん。感謝"}, {"type": "subtitle", "time": 10416.309, "timestamp": "02:53:36", "text": "あなた。バターをありがとう。本当に"}, {"type": "subtitle", "time": 10420.59, "timestamp": "02:53:40", "text": "感謝します。ギガギグ。ああ、君"}, {"type": "subtitle", "time": 10424.23, "timestamp": "02:53:44", "text": "グミの言うことを聞いて。おお、いいね。ニース。私は"}, {"type": "subtitle", "time": 10425.67, "timestamp": "02:53:45", "text": "歌。わかった。私が何を待っているか、あなたは知っていますよね"}, {"type": "subtitle", "time": 10429.67, "timestamp": "02:53:49", "text": "のために？もし私がヴァレレントのスキンが欲しいなら、"}, {"type": "subtitle", "time": 10432.79, "timestamp": "02:53:52", "text": "ナイフの皮なら何でもいいです"}, {"type": "subtitle", "time": 10435.19, "timestamp": "02:53:55", "text": "ナイフを渡すことはできない"}, {"type": "subtitle", "time": 10437.99, "timestamp": "02:53:57", "text": "人々にとって、そうですよね？だから、それは"}]
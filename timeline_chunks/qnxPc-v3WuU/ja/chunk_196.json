[{"type": "subtitle", "time": 11764.07, "timestamp": "03:16:04", "text": "彼はネオンにとって悪いことをした。ええ、彼は"}, {"type": "subtitle", "time": 11766.309, "timestamp": "03:16:06", "text": "実際には、私はそれが好きではないと言っている"}, {"type": "subtitle", "time": 11768.87, "timestamp": "03:16:08", "text": "他の人がネオンを選んだとき、私は"}, {"type": "subtitle", "time": 11772.469, "timestamp": "03:16:12", "text": "彼女が他の誰かと一緒にいるところは見たくない。"}, {"type": "subtitle", "time": 11774.309, "timestamp": "03:16:14", "text": "彼は擬似社会関係を築いている"}, {"type": "subtitle", "time": 11776.19, "timestamp": "03:16:16", "text": "と"}, {"type": "subtitle", "time": 11779.75, "timestamp": "03:16:19", "text": "ネオン。ベイビー、"}, {"type": "subtitle", "time": 11781.429, "timestamp": "03:16:21", "text": "彼らが新しい選抜を作っているのはご存知でしょう"}, {"type": "subtitle", "time": 11783.03, "timestamp": "03:16:23", "text": "システム。ネオをどうやって連れて行くつもり？"}, {"type": "subtitle", "time": 11785.429, "timestamp": "03:16:25", "text": "それは来るのでしょうか？え、何？いや、待って、"}, {"type": "subtitle", "time": 11788.55, "timestamp": "03:16:28", "text": "何？本当に？何？システムはどうなっていますか？私"}, {"type": "subtitle", "time": 11798.469, "timestamp": "03:16:38", "text": "待って、それはApexみたいになるのかな？"}, {"type": "subtitle", "time": 11801.59, "timestamp": "03:16:41", "text": "みんなが知ってるように、"}, {"type": "subtitle", "time": 11804.389, "timestamp": "03:16:44", "text": "一つずつ選ぶような感じ？私はこう思う"}, {"type": "subtitle", "time": 11807.269, "timestamp": "03:16:47", "text": "それ。わからない。彼らはすでに"}, {"type": "subtitle", "time": 11811.59, "timestamp": "03:16:51", "text": "8月に発表された。え、何？"}, {"type": "subtitle", "time": 11815.11, "timestamp": "03:16:55", "text": "ここで話しても構いませんよ。あ、こんにちは。"}, {"type": "subtitle", "time": 11817.269, "timestamp": "03:16:57", "text": "はい。"}]
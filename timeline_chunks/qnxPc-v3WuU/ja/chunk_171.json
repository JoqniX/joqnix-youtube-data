[{"type": "subtitle", "time": 10260.63, "timestamp": "02:51:00", "text": "ファン。それから何が起こったのかはわかりません"}, {"type": "subtitle", "time": 10262.87, "timestamp": "02:51:02", "text": "今。私のハードコアは日本語に"}, {"type": "subtitle", "time": 10265.429, "timestamp": "02:51:05", "text": "音楽。"}, {"type": "subtitle", "time": 10269.99, "timestamp": "02:51:09", "text": "ああ、なるほど。なるほど。"}, {"type": "subtitle", "time": 10273.349, "timestamp": "02:51:13", "text": "どういうわけか、店にナイフが2本入荷してしまった。"}, {"type": "subtitle", "time": 10276.71, "timestamp": "02:51:16", "text": "ナイフ2本。何をもらったの？うん。手に入れた"}, {"type": "subtitle", "time": 10280.51, "timestamp": "02:51:20", "text": "プライム。プライマックス。"}, {"type": "subtitle", "time": 10285.79, "timestamp": "02:51:25", "text": "そして、カトリーナ。何？カトリーナ。おお。"}, {"type": "subtitle", "time": 10291.469, "timestamp": "02:51:31", "text": "カトリーナ。それはとても良いことです。それは"}, {"type": "subtitle", "time": 10294.6, "timestamp": "02:51:34", "text": "ナイフの名前としてはとてもクールだ。"}, {"type": "subtitle", "time": 10302.51, "timestamp": "02:51:42", "text": "えっと、私の"}, {"type": "subtitle", "time": 10310.79, "timestamp": "02:51:50", "text": "いや、違う。えーと、入ったら、"}, {"type": "subtitle", "time": 10314.71, "timestamp": "02:51:54", "text": "知ってるよ。バンがここで待っています。こんにちは、"}, {"type": "subtitle", "time": 10317.349, "timestamp": "02:51:57", "text": "Vson。"}]
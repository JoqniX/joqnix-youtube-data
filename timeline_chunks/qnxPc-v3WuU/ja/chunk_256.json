[{"type": "subtitle", "time": 15361.83, "timestamp": "04:16:01", "text": "OGのイェー"}, {"type": "subtitle", "time": 15366.469, "timestamp": "04:16:06", "text": "それは大きなことであり、かなり大きなことです"}, {"type": "subtitle", "time": 15369.189, "timestamp": "04:16:09", "text": "私は本当にみんなに"}, {"type": "subtitle", "time": 15373.469, "timestamp": "04:16:13", "text": "どれもそうですが、なぜこれは"}, {"type": "subtitle", "time": 15379.99, "timestamp": "04:16:19", "text": "大変だし、エネルギーも尽きそうだし、もう死にそうだ。"}, {"type": "subtitle", "time": 15383.429, "timestamp": "04:16:23", "text": "みんなに私を見てもらいたい"}, {"type": "subtitle", "time": 15385.83, "timestamp": "04:16:25", "text": "準備して。つまり、私は気にしない"}, {"type": "subtitle", "time": 15387.83, "timestamp": "04:16:27", "text": "人々がそれを見ている。私はただ"}, {"type": "subtitle", "time": 15391.91, "timestamp": "04:16:31", "text": "遊ぶ。いいえ、ある意味では"}, {"type": "subtitle", "time": 15394.389, "timestamp": "04:16:34", "text": "ええ、ある意味では、私は"}, {"type": "subtitle", "time": 15396.469, "timestamp": "04:16:36", "text": "最後に別れを告げるとか、そういうこと。"}, {"type": "subtitle", "time": 15400.11, "timestamp": "04:16:40", "text": "ええ、私も感じます。心配しないで。"}, {"type": "subtitle", "time": 15404.79, "timestamp": "04:16:44", "text": "ええと、つまり、ある意味では、"}, {"type": "subtitle", "time": 15407.83, "timestamp": "04:16:47", "text": "このモデルとはこれで最後です。知るか"}, {"type": "subtitle", "time": 15411.11, "timestamp": "04:16:51", "text": "新しいモデルはいつ入手できますか？おそらく"}, {"type": "subtitle", "time": 15414.07, "timestamp": "04:16:54", "text": "来年か、それとも分からない。私はじっとしている"}, {"type": "subtitle", "time": 15415.75, "timestamp": "04:16:55", "text": "このモデルでいろいろと試してみましょう。それでも私は"}, {"type": "subtitle", "time": 15418.63, "timestamp": "04:16:58", "text": "最後にお別れを言いたかった、"}]
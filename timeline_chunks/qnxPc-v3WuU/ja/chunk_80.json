[{"type": "subtitle", "time": 4803.669, "timestamp": "01:20:03", "text": "あんなに高く飛べるなんて知らなかった。"}, {"type": "subtitle", "time": 4807.11, "timestamp": "01:20:07", "text": "私は飛行機に乗った。あなたは文字通り飛行機で"}, {"type": "subtitle", "time": 4817.03, "timestamp": "01:20:17", "text": "ああ、なんてことだ。どうやって"}, {"type": "subtitle", "time": 4819.11, "timestamp": "01:20:19", "text": "私はこれが本当に苦手なんです。わかった、私はこんなにひどい"}, {"type": "subtitle", "time": 4821.03, "timestamp": "01:20:21", "text": "私はヴァレリンをあまりプレイしないから"}, {"type": "subtitle", "time": 4824.55, "timestamp": "01:20:24", "text": "今。それは言っておきます。"}, {"type": "subtitle", "time": 4827.27, "timestamp": "01:20:27", "text": "私は、つまり、私は、"}, {"type": "subtitle", "time": 4828.35, "timestamp": "01:20:28", "text": "再生中"}, {"type": "subtitle", "time": 4832.87, "timestamp": "01:20:32", "text": "Apexのみ有効です。わからない"}, {"type": "subtitle", "time": 4835.51, "timestamp": "01:20:35", "text": "どうやってそれをやったのか、でも、そう、私は"}, {"type": "subtitle", "time": 4837.75, "timestamp": "01:20:37", "text": "ここ数週間、ヴァレリンをプレイしている。私"}, {"type": "subtitle", "time": 4839.83, "timestamp": "01:20:39", "text": "確か前日だったと思う"}, {"type": "subtitle", "time": 4841.83, "timestamp": "01:20:41", "text": "昨日は1試合だけプレイしました。"}, {"type": "subtitle", "time": 4843.87, "timestamp": "01:20:43", "text": "うん。こんにちは、ヤーシャ。お元気ですか"}]
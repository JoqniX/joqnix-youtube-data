[{"type": "subtitle", "time": 6302.629, "timestamp": "01:45:02", "text": "とても高い。ご覧になりましたか？"}, {"type": "subtitle", "time": 6304.51, "timestamp": "01:45:04", "text": "それ？私のpingは"}, {"type": "subtitle", "time": 6308.47, "timestamp": "01:45:08", "text": "85 のように、そしてそのために"}, {"type": "subtitle", "time": 6311.669, "timestamp": "01:45:11", "text": "ええ、たくさんあります。君たちが遅れているのは"}, {"type": "subtitle", "time": 6313.27, "timestamp": "01:45:13", "text": "私のコメントについて。いや、いや、いや。大丈夫。"}, {"type": "subtitle", "time": 6315.83, "timestamp": "01:45:15", "text": "大丈夫です。ご心配なく。あなたはできる"}, {"type": "subtitle", "time": 6318.55, "timestamp": "01:45:18", "text": "参加したいなら、それでも構いませんよ。ええ、そうは思いません"}, {"type": "subtitle", "time": 6321.83, "timestamp": "01:45:21", "text": "ケア。大丈夫です。こんにちは。こんにちは。調子はどうですか？"}, {"type": "subtitle", "time": 6324.95, "timestamp": "01:45:24", "text": "あなた？私の方から誰か招待してください。うん。"}, {"type": "subtitle", "time": 6327.59, "timestamp": "01:45:27", "text": "うん、大丈夫だよ。あなたはできる。わかった。"}, {"type": "subtitle", "time": 6358.07, "timestamp": "01:45:58", "text": "何？何？ジョク先輩は左にいました。つまり彼は"}]
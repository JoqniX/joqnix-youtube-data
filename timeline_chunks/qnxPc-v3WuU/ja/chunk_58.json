[{"type": "subtitle", "time": 3493.19, "timestamp": "00:58:13", "text": "[音楽]"}, {"type": "subtitle", "time": 3495.349, "timestamp": "00:58:15", "text": "うん。こんにちは。うん。こんにちは。うん。こんにちは"}, {"type": "subtitle", "time": 3497.95, "timestamp": "00:58:17", "text": "みんな。皆さんお元気ですか？"}, {"type": "subtitle", "time": 3500.99, "timestamp": "00:58:20", "text": "今日？うん。"}, {"type": "subtitle", "time": 3504.789, "timestamp": "00:58:24", "text": "こんにちは。ということで、またここに戻ってきました"}, {"type": "subtitle", "time": 3506.19, "timestamp": "00:58:26", "text": "別の"}, {"type": "subtitle", "time": 3514.15, "timestamp": "00:58:34", "text": "騎手。ということで、今日は"}, {"type": "subtitle", "time": 3517.99, "timestamp": "00:58:37", "text": "えっと、ヴァレラント。私は確信しています。しかし"}, {"type": "subtitle", "time": 3522.23, "timestamp": "00:58:42", "text": "えっと、ついにズチを手に入れることができました。それで"}, {"type": "subtitle", "time": 3527.789, "timestamp": "00:58:47", "text": "ええ、ええと、ジアと一緒にプレイします"}, {"type": "subtitle", "time": 3531.51, "timestamp": "00:58:51", "text": "マスク。ああ、彼女はストリーミングもやってるよ"}, {"type": "subtitle", "time": 3532.99, "timestamp": "00:58:52", "text": "現時点で。"}, {"type": "subtitle", "time": 3537.43, "timestamp": "00:58:57", "text": "えーと、たぶん設定するべきだと思う"}]
[{"type": "subtitle", "time": 8460.79, "timestamp": "02:21:00", "text": "最後に残ったプレイヤー。彼女は知らない。"}, {"type": "subtitle", "time": 8473.91, "timestamp": "02:21:13", "text": "敵はあと一体。"}, {"type": "subtitle", "time": 8477.19, "timestamp": "02:21:17", "text": "ああ、あと少しだったのに。でも、まあいいでしょう。いいえ、いいえ、男。"}, {"type": "subtitle", "time": 8479.99, "timestamp": "02:21:19", "text": "潜入捜査のように"}, {"type": "subtitle", "time": 8482.309, "timestamp": "02:21:22", "text": "私たちがしたこと。立体的な生地"}, {"type": "subtitle", "time": 8485.67, "timestamp": "02:21:25", "text": "それは、それができる唯一のことではない"}, {"type": "subtitle", "time": 8489.83, "timestamp": "02:21:29", "text": "潜入捜査任務として。"}, {"type": "subtitle", "time": 8490.91, "timestamp": "02:21:30", "text": "私たちは"}, {"type": "subtitle", "time": 8494.71, "timestamp": "02:21:34", "text": "無事に死ぬ。うん。うん。うん。"}, {"type": "subtitle", "time": 8497.83, "timestamp": "02:21:37", "text": "はい。はい。"}, {"type": "subtitle", "time": 8501.99, "timestamp": "02:21:41", "text": "好きじゃない。ああ、みんなそれぞれ好きなものがあるよ。"}, {"type": "subtitle", "time": 8504.389, "timestamp": "02:21:44", "text": "彼らにはそれぞれ自分の理由がある。ジョー先輩。うん。"}, {"type": "subtitle", "time": 8506.64, "timestamp": "02:21:46", "text": "うん。 私もサブアカウントは全く使いません。"}]
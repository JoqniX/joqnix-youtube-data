[{"type": "subtitle", "time": 4020.109, "timestamp": "01:07:00", "text": "痛みだと分かっている"}, {"type": "subtitle", "time": 4022.829, "timestamp": "01:07:02", "text": "しかし"}, {"type": "subtitle", "time": 4030.349, "timestamp": "01:07:10", "text": "それ。誰か推測する人も"}, {"type": "subtitle", "time": 4042.549, "timestamp": "01:07:22", "text": "はい。わかった。えっと、すべて確認させてください"}, {"type": "subtitle", "time": 4045.59, "timestamp": "01:07:25", "text": "うまく機能しているので切り替えます"}, {"type": "subtitle", "time": 4050.349, "timestamp": "01:07:30", "text": "[音楽]"}, {"type": "subtitle", "time": 4053.15, "timestamp": "01:07:33", "text": "上。ああ、"}, {"type": "subtitle", "time": 4056.789, "timestamp": "01:07:36", "text": "神。ああ、大変だ。さあ行こう。私は 私は 私は"}, {"type": "subtitle", "time": 4062.47, "timestamp": "01:07:42", "text": "シーン。よし。ああ、待って、待って、待って、"}, {"type": "subtitle", "time": 4064.069, "timestamp": "01:07:44", "text": "待って、待って。彼女はそうあるべきではなかった"}, {"type": "subtitle", "time": 4067.15, "timestamp": "01:07:47", "text": "今、ここにいます。彼女は参加する"}, {"type": "subtitle", "time": 4070.549, "timestamp": "01:07:50", "text": "少し。インスタグラムの投稿を忘れてた"}, {"type": "subtitle", "time": 4079.23, "timestamp": "01:07:59", "text": "良い。いつ行くか教えてください"}]
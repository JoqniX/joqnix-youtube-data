[{"type": "subtitle", "time": 661.03, "timestamp": "00:11:01", "text": "分かりません、台無しにして申し訳ありません"}, {"type": "subtitle", "time": 664.47, "timestamp": "00:11:04", "text": "あなたの名前を覆い隠す、そんな感じ"}, {"type": "subtitle", "time": 667.67, "timestamp": "00:11:07", "text": "私にとってそれは私のイアルのようなものになるでしょう"}, {"type": "subtitle", "time": 670.63, "timestamp": "00:11:10", "text": "現実世界では私は"}, {"type": "subtitle", "time": 672.87, "timestamp": "00:11:12", "text": "私が何人の名前を挙げたかは明かすべきではない"}, {"type": "subtitle", "time": 675.11, "timestamp": "00:11:15", "text": "持っている。ああ、待って、知らないよ。うん。それで"}, {"type": "subtitle", "time": 679.11, "timestamp": "00:11:19", "text": "それは、ファーストネーム、犬、ネスト、ラストネームのようなものになるでしょう"}, {"type": "subtitle", "time": 680.269, "timestamp": "00:11:20", "text": "名前の種類"}, {"type": "subtitle", "time": 684.79, "timestamp": "00:11:24", "text": "あれ。もしあなたが持っているなら、もしあなたが持っているなら、私はそう思います"}, {"type": "subtitle", "time": 686.55, "timestamp": "00:11:26", "text": "3つの名前、それからどこに行けばいいのかわからない"}, {"type": "subtitle", "time": 688.03, "timestamp": "00:11:28", "text": "真ん中を置く"}, {"type": "subtitle", "time": 694.389, "timestamp": "00:11:34", "text": "XD。うん、それについては調べてみる必要があるね。"}, {"type": "subtitle", "time": 696.63, "timestamp": "00:11:36", "text": "けれど。 eスポーツ選手がいるかもしれない"}, {"type": "subtitle", "time": 697.949, "timestamp": "00:11:37", "text": "と"}, {"type": "subtitle", "time": 701.269, "timestamp": "00:11:41", "text": "IR の名前は 3 つか 4 つになります。"}, {"type": "subtitle", "time": 703.269, "timestamp": "00:11:43", "text": "右？万が一、あなたが"}]
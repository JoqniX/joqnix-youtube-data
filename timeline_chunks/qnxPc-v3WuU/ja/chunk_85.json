[{"type": "subtitle", "time": 5106.79, "timestamp": "01:25:06", "text": "待って。えっと、誰が来るんですか？"}, {"type": "subtitle", "time": 5110.95, "timestamp": "01:25:10", "text": "パンディットはその一人です。えっと、ハッシュは来るの？えっと"}, {"type": "subtitle", "time": 5120.229, "timestamp": "01:25:20", "text": "良い１日を。あなたも。君たちは"}, {"type": "subtitle", "time": 5122.79, "timestamp": "01:25:22", "text": "来る？もっと多くの人が集まれば、"}, {"type": "subtitle", "time": 5124.39, "timestamp": "01:25:24", "text": "こんにちは。こんにちは。今日は元気ですか？希望"}, {"type": "subtitle", "time": 5126.149, "timestamp": "01:25:26", "text": "今日は素晴らしいですね。こんにちは。いいえ"}, {"type": "subtitle", "time": 5128.07, "timestamp": "01:25:28", "text": "評論家。あなたを招待しない理由は"}, {"type": "subtitle", "time": 5129.59, "timestamp": "01:25:29", "text": "あなたは高すぎるレベルであり、"}, {"type": "subtitle", "time": 5131.47, "timestamp": "01:25:31", "text": "それは"}, {"type": "subtitle", "time": 5134.39, "timestamp": "01:25:34", "text": "私たちにとっては興ざめだ。"}, {"type": "subtitle", "time": 5137.83, "timestamp": "01:25:37", "text": "うん。さよなら。はい、それが私のやり方です"}, {"type": "subtitle", "time": 5141.35, "timestamp": "01:25:41", "text": "やってみて。申し訳ありません、評論家さん。"}, {"type": "subtitle", "time": 5144.47, "timestamp": "01:25:44", "text": "そんなに遠くまで行くの？わかった。うん。できる"}, {"type": "subtitle", "time": 5153.189, "timestamp": "01:25:53", "text": "ええ、そうですね。レンとパンディットは再び"}, {"type": "subtitle", "time": 5156.31, "timestamp": "01:25:56", "text": "私の"}, {"type": "subtitle", "time": 5158.79, "timestamp": "01:25:58", "text": "評論家を中に入れないでください。彼はとても"}]
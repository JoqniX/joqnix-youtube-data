[{"type": "subtitle", "time": 1201.669, "timestamp": "00:20:01", "text": "映画みたいに、"}, {"type": "subtitle", "time": 1204.789, "timestamp": "00:20:04", "text": "あなたのお母さんや"}, {"type": "subtitle", "time": 1208.789, "timestamp": "00:20:08", "text": "常にレミアル文字のように、"}, {"type": "subtitle", "time": 1212.31, "timestamp": "00:20:12", "text": "編み物をするのが好きな人になる"}, {"type": "subtitle", "time": 1214.39, "timestamp": "00:20:14", "text": "ロッキングチェアに揺られながら服を着る"}, {"type": "subtitle", "time": 1216.51, "timestamp": "00:20:16", "text": "そして、物を戻して"}, {"type": "subtitle", "time": 1220.47, "timestamp": "00:20:20", "text": "前進し、ゆっくりと勢いをつけて、"}, {"type": "subtitle", "time": 1224.07, "timestamp": "00:20:24", "text": "ほら、勢いをつけて手を動かすんだ"}, {"type": "subtitle", "time": 1230.549, "timestamp": "00:20:30", "text": "うん、インスタグラムのリールか何かを見たよ"}, {"type": "subtitle", "time": 1232.789, "timestamp": "00:20:32", "text": "最近彼らが"}, {"type": "subtitle", "time": 1235.51, "timestamp": "00:20:35", "text": "五条サトゥルのようなぬいぐるみのような編み物、"}, {"type": "subtitle", "time": 1237.909, "timestamp": "00:20:37", "text": "そんな感じですね。のように"}, {"type": "subtitle", "time": 1240.39, "timestamp": "00:20:40", "text": "足や髪など、全体的に"}, {"type": "subtitle", "time": 1243.59, "timestamp": "00:20:43", "text": "アクセサリー、すべて。彼らはそれを編む。私"}, {"type": "subtitle", "time": 1245.07, "timestamp": "00:20:45", "text": "まるで、"}, {"type": "subtitle", "time": 1247.789, "timestamp": "00:20:47", "text": "「わあ、それはとても"}, {"type": "subtitle", "time": 1250.149, "timestamp": "00:20:50", "text": "かっこいい。ぬいぐるみみたいで、"}]
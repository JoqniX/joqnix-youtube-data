[{"type": "subtitle", "time": 2171.03, "timestamp": "00:36:11", "text": "延期になった。うん。うん。うん。それ"}, {"type": "subtitle", "time": 2178.71, "timestamp": "00:36:18", "text": "うん。家族でさえ、「あなたは"}, {"type": "subtitle", "time": 2181.23, "timestamp": "00:36:21", "text": "本当に続けなければならない"}, {"type": "subtitle", "time": 2185.23, "timestamp": "00:36:25", "text": "土曜日？ 「月曜日に行けるよ。」私はこう思った。"}, {"type": "subtitle", "time": 2190.95, "timestamp": "00:36:30", "text": "「いや、やらなきゃいけないことがあるんだ。"}]
[{"type": "subtitle", "time": 13743.429, "timestamp": "03:49:03", "text": "おそらくこれだと思うけど、私は"}, {"type": "subtitle", "time": 13746.03, "timestamp": "03:49:06", "text": "新しい"}, {"type": "subtitle", "time": 13755.429, "timestamp": "03:49:15", "text": "つまり、ジョアトン2.0を見ることになるかもしれない。そして"}, {"type": "subtitle", "time": 13758.469, "timestamp": "03:49:18", "text": "ルクもここにいるんだよ。知るか？その"}, {"type": "subtitle", "time": 13760.75, "timestamp": "03:49:20", "text": "ネタバレ注意。"}, {"type": "subtitle", "time": 13764.389, "timestamp": "03:49:24", "text": "うん。わからない。何が起こるかわからない。しかし"}, {"type": "subtitle", "time": 13767.07, "timestamp": "03:49:27", "text": "ええ、わかっています。何が起こるかわからない。うん、"}, {"type": "subtitle", "time": 13770.389, "timestamp": "03:49:30", "text": "真実。そして私はそれについて考えていました"}, {"type": "subtitle", "time": 13774.79, "timestamp": "03:49:34", "text": "今。ジョアソン、今まさにこれをやってるよ"}, {"type": "subtitle", "time": 13777.349, "timestamp": "03:49:37", "text": "そしてもちろん将来は、"}, {"type": "subtitle", "time": 13780.95, "timestamp": "03:49:40", "text": "日本でもう一度それを実行できる"}, {"type": "subtitle", "time": 13784.95, "timestamp": "03:49:44", "text": "私の自由度などにもよるけどね。"}, {"type": "subtitle", "time": 13787.11, "timestamp": "03:49:47", "text": "休暇などで、"}, {"type": "subtitle", "time": 13789.349, "timestamp": "03:49:49", "text": "短期間であれば、"}, {"type": "subtitle", "time": 13793.269, "timestamp": "03:49:53", "text": "すべて計画済みだから"}, {"type": "subtitle", "time": 13796.389, "timestamp": "03:49:56", "text": "今まさにその経験を積んでいる。それは"}, {"type": "subtitle", "time": 13798.71, "timestamp": "03:49:58", "text": "すべてをスケジュールするのは"}]
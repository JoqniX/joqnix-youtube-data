[{"type": "subtitle", "time": 9960.55, "timestamp": "02:46:00", "text": "皆さんはゲーマー向けの音楽を持っていますか？何か"}, {"type": "subtitle", "time": 9962.469, "timestamp": "02:46:02", "text": "50ポンド落とす直前に着る"}, {"type": "subtitle", "time": 9964.79, "timestamp": "02:46:04", "text": "殺したとか、そういうこと？待って、なぜ"}, {"type": "subtitle", "time": 9967.91, "timestamp": "02:46:07", "text": "それ？え、そんなものがあるの？ゲーマー"}, {"type": "subtitle", "time": 9969.55, "timestamp": "02:46:09", "text": "音楽？"}, {"type": "subtitle", "time": 9971.51, "timestamp": "02:46:11", "text": "ビクトリア朝。ここは初めてですね。"}, {"type": "subtitle", "time": 9973.83, "timestamp": "02:46:13", "text": "右？それで、今日はどうやって私を見つけたんですか？"}, {"type": "subtitle", "time": 9976.63, "timestamp": "02:46:16", "text": "元気ですか？どんな種類ですか？例えば、私は"}, {"type": "subtitle", "time": 9978.87, "timestamp": "02:46:18", "text": "本当に"}, {"type": "subtitle", "time": 9981.03, "timestamp": "02:46:21", "text": "感情的とか、そんな感じ。誰"}, {"type": "subtitle", "time": 9988.15, "timestamp": "02:46:28", "text": "彼らはここにいますか？あなたの"}, {"type": "subtitle", "time": 9990.63, "timestamp": "02:46:30", "text": "名前はジョック。えっと、僕のことをジョックって呼ばないでよ。"}, {"type": "subtitle", "time": 9994.23, "timestamp": "02:46:34", "text": "そうすればもっと簡単になるだろう、なぜなら多くのジョックは"}, {"type": "subtitle", "time": 10012.03, "timestamp": "02:46:52", "text": "発音可能。"}, {"type": "subtitle", "time": 10015.11, "timestamp": "02:46:55", "text": "サ。わかった。うん。"}]
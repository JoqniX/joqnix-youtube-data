[{"type": "subtitle", "time": 2701.91, "timestamp": "00:45:01", "text": "十分。でも、今のところは"}, {"type": "subtitle", "time": 2702.99, "timestamp": "00:45:02", "text": "それ。"}, {"type": "subtitle", "time": 2705.91, "timestamp": "00:45:05", "text": "よし、どうなるか見てみよう。これは"}, {"type": "subtitle", "time": 2709.349, "timestamp": "00:45:09", "text": "これらを分けて知ることを許可してください。"}, {"type": "subtitle", "time": 2711.27, "timestamp": "00:45:11", "text": "だって、Twitchで配信してるんだもん"}, {"type": "subtitle", "time": 2713.829, "timestamp": "00:45:13", "text": "などなど。 GFSボットが多数存在します"}, {"type": "subtitle", "time": 2718.069, "timestamp": "00:45:18", "text": "ボットとか、そういう人たち"}, {"type": "subtitle", "time": 2720.91, "timestamp": "00:45:20", "text": "ランダムに自動参加する、とかそういう感じ。私はしません"}, {"type": "subtitle", "time": 2724.79, "timestamp": "00:45:24", "text": "知る。彼らは私の"}, {"type": "subtitle", "time": 2727.03, "timestamp": "00:45:27", "text": "入社手続きに関するものも。だから私はこう思う、"}, {"type": "subtitle", "time": 2730.63, "timestamp": "00:45:30", "text": "うん、ファミリアのメンバーは残しておきたいんだ"}, {"type": "subtitle", "time": 2733.15, "timestamp": "00:45:33", "text": "安全"}, {"type": "subtitle", "time": 2735.95, "timestamp": "00:45:35", "text": "どうにか。えっと、それで"}, {"type": "subtitle", "time": 2739.43, "timestamp": "00:45:39", "text": "うん。だから、私はこう思っていました。「ああ、私は"}, {"type": "subtitle", "time": 2742.71, "timestamp": "00:45:42", "text": "こういうシステムとか作ってみろよ。"}, {"type": "subtitle", "time": 2751.75, "timestamp": "00:45:51", "text": "何。まあ、そういうものですよね。のように"}, {"type": "subtitle", "time": 2753.99, "timestamp": "00:45:53", "text": "どうすればこれができるか見て、"}, {"type": "subtitle", "time": 2757.51, "timestamp": "00:45:57", "text": "未来のすべて。私は主に"}]
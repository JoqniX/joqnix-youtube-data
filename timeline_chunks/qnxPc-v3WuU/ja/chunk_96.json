[{"type": "subtitle", "time": 5762.43, "timestamp": "01:36:02", "text": "左って言ったの？私はしません"}, {"type": "subtitle", "time": 5775.83, "timestamp": "01:36:15", "text": "タイピング。私は全てを置いていかなければならない。"}, {"type": "subtitle", "time": 5777.47, "timestamp": "01:36:17", "text": "わかった。"}, {"type": "subtitle", "time": 5783.99, "timestamp": "01:36:23", "text": "さあ行こう。"}, {"type": "subtitle", "time": 5788.39, "timestamp": "01:36:28", "text": "誰でも参加できますか？大丈夫。だった"}, {"type": "subtitle", "time": 5794.629, "timestamp": "01:36:34", "text": "彼女はランク戦はプレイしません。彼女はそうしない。"}, {"type": "subtitle", "time": 5798.39, "timestamp": "01:36:38", "text": "なんてこった。左。"}, {"type": "subtitle", "time": 5800.95, "timestamp": "01:36:40", "text": "私は戻ってきます。わかった。わかった。あなたは楽しんでいます"}, {"type": "subtitle", "time": 5805.35, "timestamp": "01:36:45", "text": "覗き見。来て。彼らに何か見せてあげよう。"}, {"type": "subtitle", "time": 5807.91, "timestamp": "01:36:47", "text": "待って。いや、いや、いや、いや。私はそうなるでしょう。私は"}, {"type": "subtitle", "time": 5811.51, "timestamp": "01:36:51", "text": "イライラする。あ、あ、すぐ戻ります。私は"}, {"type": "subtitle", "time": 5814.55, "timestamp": "01:36:54", "text": "たぶんそう呼ばれているだけだと思う"}, {"type": "subtitle", "time": 5817.109, "timestamp": "01:36:57", "text": "家。まあ、ここはシンガポールだからね。私はしません"}, {"type": "subtitle", "time": 5819.91, "timestamp": "01:36:59", "text": "シンガポールの人々がなぜか"}]
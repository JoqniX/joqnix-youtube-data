[{"type": "subtitle", "time": 1741.83, "timestamp": "00:29:01", "text": "あなたが知っているように、誰でも利用できます"}, {"type": "subtitle", "time": 1743.909, "timestamp": "00:29:03", "text": "サブは必要ないから、ただ「こんにちは」と言えばいいよ"}, {"type": "subtitle", "time": 1746.63, "timestamp": "00:29:06", "text": "興味があれば、気に入ったら"}, {"type": "subtitle", "time": 1748.71, "timestamp": "00:29:08", "text": "後でサブまたは"}, {"type": "subtitle", "time": 1750.63, "timestamp": "00:29:10", "text": "そんな感じですね。うん。だから私は"}, {"type": "subtitle", "time": 1753.549, "timestamp": "00:29:13", "text": "誰かの手に渡っていることをすっかり忘れていた"}, {"type": "subtitle", "time": 1756.31, "timestamp": "00:29:16", "text": "ずっとこのことについて考えていたんだけど、"}, {"type": "subtitle", "time": 1757.31, "timestamp": "00:29:17", "text": "疑問に思う"}, {"type": "subtitle", "time": 1760.389, "timestamp": "00:29:20", "text": "通りかかった新しい人たち全員を待って"}, {"type": "subtitle", "time": 1762.95, "timestamp": "00:29:22", "text": "彼らはこうだった"}, {"type": "subtitle", "time": 1766.029, "timestamp": "00:29:26", "text": "えっと、それは字幕モードか何かだった"}, {"type": "subtitle", "time": 1768.47, "timestamp": "00:29:28", "text": "彼らが購読していたもの"}, {"type": "subtitle", "time": 1770.19, "timestamp": "00:29:30", "text": "コメントする"}, {"type": "subtitle", "time": 1774.59, "timestamp": "00:29:34", "text": "何か。待って、気づいてなかった"}, {"type": "subtitle", "time": 1777.59, "timestamp": "00:29:37", "text": "でも、それは良かったと思いますか？"}, {"type": "subtitle", "time": 1780.63, "timestamp": "00:29:40", "text": "けれど？ほら、それを保管しておくとどう思う？"}, {"type": "subtitle", "time": 1783.75, "timestamp": "00:29:43", "text": "誰にとってもより良い、またはサブのみ"}, {"type": "subtitle", "time": 1787.47, "timestamp": "00:29:47", "text": "サブのみの利点は、"}, {"type": "subtitle", "time": 1791.75, "timestamp": "00:29:51", "text": "知っているボットを「いいね」から削除します"}, {"type": "subtitle", "time": 1793.99, "timestamp": "00:29:53", "text": "閲覧ではなく閲覧、コメントはスパムのよう"}, {"type": "subtitle", "time": 1796.389, "timestamp": "00:29:56", "text": "ボットとかがあなたのライブ配信を襲撃するようになった"}]
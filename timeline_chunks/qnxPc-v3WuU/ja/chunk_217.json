[{"type": "subtitle", "time": 13020.63, "timestamp": "03:37:00", "text": "おお。そして、誰があなたと一緒にいるか当ててみてください。"}, {"type": "subtitle", "time": 13024.229, "timestamp": "03:37:04", "text": "今？うん。 HDブリッジ。"}, {"type": "subtitle", "time": 13029.11, "timestamp": "03:37:09", "text": "HDブリード。 M ええと、ストリームが"}, {"type": "subtitle", "time": 13032.389, "timestamp": "03:37:12", "text": "素晴らしい昨日でした。私はそこにいました"}, {"type": "subtitle", "time": 13035.51, "timestamp": "03:37:15", "text": "一日の大半は良い。"}, {"type": "subtitle", "time": 13039.99, "timestamp": "03:37:19", "text": "良かったし、私は"}, {"type": "subtitle", "time": 13042.03, "timestamp": "03:37:22", "text": "かなり"}, {"type": "subtitle", "time": 13045.83, "timestamp": "03:37:25", "text": "眠い。私はとても眠かった。ええ、そうでした"}, {"type": "subtitle", "time": 13049.59, "timestamp": "03:37:29", "text": "本当に眠くて、どういうわけか"}, {"type": "subtitle", "time": 13056.63, "timestamp": "03:37:36", "text": "ええ、それは素晴らしいですね。それは素晴らしいことです。それは"}, {"type": "subtitle", "time": 13057.79, "timestamp": "03:37:37", "text": "素晴らしい"}, {"type": "subtitle", "time": 13062.55, "timestamp": "03:37:42", "text": "現時点でストリーミング配信しており、人々は"}, {"type": "subtitle", "time": 13064.79, "timestamp": "03:37:44", "text": "彼は死んだのか？と考える。彼は行くのか"}, {"type": "subtitle", "time": 13066.11, "timestamp": "03:37:46", "text": "に"}, {"type": "subtitle", "time": 13068.91, "timestamp": "03:37:48", "text": "死ぬのか？彼がこれまで行ってきたストリームの数は"}, {"type": "subtitle", "time": 13071.59, "timestamp": "03:37:51", "text": "ほら、なんてこった、これ"}, {"type": "subtitle", "time": 13073.95, "timestamp": "03:37:53", "text": "男はいくつか持っている"}, {"type": "subtitle", "time": 13077.07, "timestamp": "03:37:57", "text": "粘り強さってやつだよ。"}]
[{"type": "subtitle", "time": 14341.55, "timestamp": "03:59:01", "text": "ほんの数分しか時間を割けず、"}, {"type": "subtitle", "time": 14345.429, "timestamp": "03:59:05", "text": "すべて。そう、そんな感じ。こんにちは、カヤン"}, {"type": "subtitle", "time": 14349.11, "timestamp": "03:59:09", "text": "ニキサ。こんにちは。こんにちは、死んだゲーマー"}, {"type": "subtitle", "time": 14351.75, "timestamp": "03:59:11", "text": "66. ようこそ。"}, {"type": "subtitle", "time": 14354.07, "timestamp": "03:59:14", "text": "水分補給。こんにちは。"}, {"type": "subtitle", "time": 14356.389, "timestamp": "03:59:16", "text": "こんにちは。ああ、水分補給をしよう"}, {"type": "subtitle", "time": 14360.79, "timestamp": "03:59:20", "text": "それから。はい。こんにちは。"}, {"type": "subtitle", "time": 14362.55, "timestamp": "03:59:22", "text": "もうやめるべき時だと気づいた"}, {"type": "subtitle", "time": 14364.309, "timestamp": "03:59:24", "text": "先延ばしにして、ついにアップロード"}, {"type": "subtitle", "time": 14367.75, "timestamp": "03:59:27", "text": "やっとコンテンツをアップロードできた。うん、"}, {"type": "subtitle", "time": 14370.309, "timestamp": "03:59:30", "text": "真実。それは私ができたことの一つです"}, {"type": "subtitle", "time": 14373.429, "timestamp": "03:59:33", "text": "ヨアトンを通して行う。私はできた"}, {"type": "subtitle", "time": 14375.99, "timestamp": "03:59:35", "text": "少なくとも動画として何かを投稿して"}, {"type": "subtitle", "time": 14379.189, "timestamp": "03:59:39", "text": "短い形式のコンテンツとして"}, {"type": "subtitle", "time": 14381.99, "timestamp": "03:59:41", "text": "そうそう、ショートパンツとかそういうやつ。うん、"}, {"type": "subtitle", "time": 14383.67, "timestamp": "03:59:43", "text": "ショットはなかなか良かったよ。私は"}, {"type": "subtitle", "time": 14385.03, "timestamp": "03:59:45", "text": "正直に言うと、ショットはかなり"}, {"type": "subtitle", "time": 14387.349, "timestamp": "03:59:47", "text": "良い。まるで本当に"}, {"type": "subtitle", "time": 14390.07, "timestamp": "03:59:50", "text": "基本的なもので、編集されていないようなものですが、"}, {"type": "subtitle", "time": 14391.67, "timestamp": "03:59:51", "text": "まだ"}, {"type": "subtitle", "time": 14393.99, "timestamp": "03:59:53", "text": "少なくともアップロードできたのは良かった"}, {"type": "subtitle", "time": 14395.67, "timestamp": "03:59:55", "text": "続けるよりも何か"}, {"type": "subtitle", "time": 14397.59, "timestamp": "03:59:57", "text": "それについて夢見たり、先延ばしにしたり"}]
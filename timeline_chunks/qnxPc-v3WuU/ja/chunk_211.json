[{"type": "subtitle", "time": 12672.79, "timestamp": "03:31:12", "text": "これで終わりだ。お前は死んだ。私は待ちます"}, {"type": "subtitle", "time": 12676.95, "timestamp": "03:31:16", "text": "ここに降りていくように。"}, {"type": "subtitle", "time": 12684.75, "timestamp": "03:31:24", "text": "ああ、"}, {"type": "subtitle", "time": 12688.469, "timestamp": "03:31:28", "text": "神。どうしてそれを見逃したんだろう？"}, {"type": "subtitle", "time": 12692.309, "timestamp": "03:31:32", "text": "Ax なしではピューピューできません。"}, {"type": "subtitle", "time": 12693.83, "timestamp": "03:31:33", "text": "何か。わからない。私は慣れすぎている"}, {"type": "subtitle", "time": 12696.71, "timestamp": "03:31:36", "text": "RX。"}, {"type": "subtitle", "time": 12706.87, "timestamp": "03:31:46", "text": "ニース。何てことだ。私は遊んでいた"}, {"type": "subtitle", "time": 12709.11, "timestamp": "03:31:49", "text": "バン。どうしたの？買えます。できる"}, {"type": "subtitle", "time": 12710.71, "timestamp": "03:31:50", "text": "買う。"}]
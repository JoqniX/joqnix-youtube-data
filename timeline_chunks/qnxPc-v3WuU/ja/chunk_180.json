[{"type": "subtitle", "time": 10806.469, "timestamp": "03:00:06", "text": "残り30秒。一緒に行く。"}, {"type": "subtitle", "time": 10808.349, "timestamp": "03:00:08", "text": "あなたはできる"}, {"type": "subtitle", "time": 10822.23, "timestamp": "03:00:22", "text": "私は彼の声を聞いた。キャンセルしてください。なぜ？何？"}, {"type": "subtitle", "time": 10824.469, "timestamp": "03:00:24", "text": "ええ、彼は突然キャンセルしたんです。"}, {"type": "subtitle", "time": 10827.19, "timestamp": "03:00:27", "text": "何？"}, {"type": "subtitle", "time": 10830.389, "timestamp": "03:00:30", "text": "ああ、彼は終わった。"}, {"type": "subtitle", "time": 10832.79, "timestamp": "03:00:32", "text": "うん。こんにちは、ナリン君。元気ですか"}, {"type": "subtitle", "time": 10835.75, "timestamp": "03:00:35", "text": "今日は何をしますか？お元気でお過ごしでしょうか。あなた"}, {"type": "subtitle", "time": 10844.87, "timestamp": "03:00:44", "text": "それは罠だ。ちょろちょろと。"}, {"type": "subtitle", "time": 10847.469, "timestamp": "03:00:47", "text": "私は悟空を持っています。なぜ彼はそれをキャンセルしたのか"}]
[{"type": "subtitle", "time": 1144.39, "timestamp": "00:19:04", "text": "いや、ドン・ディアブロの件を忘れてたんだ。私"}, {"type": "subtitle", "time": 1146.789, "timestamp": "00:19:06", "text": "それは彼のグッズ類のことでした。それは何？"}, {"type": "subtitle", "time": 1148.31, "timestamp": "00:19:08", "text": "電話した？"}, {"type": "subtitle", "time": 1152.35, "timestamp": "00:19:12", "text": "未来のポップ 未来のポップの種類"}, {"type": "subtitle", "time": 1156.07, "timestamp": "00:19:16", "text": "未来のサイバー素材の種類"}, {"type": "subtitle", "time": 1159.99, "timestamp": "00:19:19", "text": "商品。うん。だから私は"}, {"type": "subtitle", "time": 1163.51, "timestamp": "00:19:23", "text": "ある時点で私は"}, {"type": "subtitle", "time": 1166.63, "timestamp": "00:19:26", "text": "服や雑貨のデザインをする。私は"}, {"type": "subtitle", "time": 1168.95, "timestamp": "00:19:28", "text": "結局、たくさんのチュートリアル動画を見てしまった。私"}, {"type": "subtitle", "time": 1172.23, "timestamp": "00:19:32", "text": "古い服も全部解体した"}, {"type": "subtitle", "time": 1174.95, "timestamp": "00:19:34", "text": "生地に関して奇妙な理由で"}, {"type": "subtitle", "time": 1177.99, "timestamp": "00:19:37", "text": "それらを物に縫い付けることができます。"}, {"type": "subtitle", "time": 1180.99, "timestamp": "00:19:40", "text": "ええ、ステッチは"}, {"type": "subtitle", "time": 1184.95, "timestamp": "00:19:44", "text": "難しいですよね、針を使って"}, {"type": "subtitle", "time": 1188.27, "timestamp": "00:19:48", "text": "ただ縫うだけ"}, {"type": "subtitle", "time": 1191.11, "timestamp": "00:19:51", "text": "手。編み物を学ぶのと同じで"}, {"type": "subtitle", "time": 1194.47, "timestamp": "00:19:54", "text": "良い。ああ、ある時点で私は"}, {"type": "subtitle", "time": 1196.71, "timestamp": "00:19:56", "text": "編み物もね。だから私は思った、そう、"}, {"type": "subtitle", "time": 1198.909, "timestamp": "00:19:58", "text": "自分でセーターを作れるかも"}]
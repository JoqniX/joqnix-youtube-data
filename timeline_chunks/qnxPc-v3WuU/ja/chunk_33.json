[{"type": "subtitle", "time": 1985.389, "timestamp": "00:33:05", "text": "掃除が必要です、"}, {"type": "subtitle", "time": 1987.87, "timestamp": "00:33:07", "text": "兄弟。"}, {"type": "subtitle", "time": 1992.149, "timestamp": "00:33:12", "text": "A：ストリーミング配信はしたくない。私は私は知っています"}, {"type": "subtitle", "time": 1994.789, "timestamp": "00:33:14", "text": "ストリームを終了しなければなりませんが、"}, {"type": "subtitle", "time": 1999.75, "timestamp": "00:33:19", "text": "私は、そう、私はしたくない"}, {"type": "subtitle", "time": 2005.19, "timestamp": "00:33:25", "text": "おしゃべりが大好き。わかった。ええと、でも健康面では"}, {"type": "subtitle", "time": 2009.669, "timestamp": "00:33:29", "text": "私は休まなければならないし、"}, {"type": "subtitle", "time": 2012.47, "timestamp": "00:33:32", "text": "例えば、私が疲れているような場合"}, {"type": "subtitle", "time": 2015.75, "timestamp": "00:33:35", "text": "そうすれば、私は与えたくない"}, {"type": "subtitle", "time": 2018.47, "timestamp": "00:33:38", "text": "悪い"}, {"type": "subtitle", "time": 2021.669, "timestamp": "00:33:41", "text": "うーん、悪い雰囲気というよりは、弱い雰囲気といった感じ。"}, {"type": "subtitle", "time": 2022.99, "timestamp": "00:33:42", "text": "あなた"}, {"type": "subtitle", "time": 2026.19, "timestamp": "00:33:46", "text": "私が知らない何かを知っている"}, {"type": "subtitle", "time": 2029.35, "timestamp": "00:33:49", "text": "私には雰囲気とかそういうものがあるのか​​な？"}, {"type": "subtitle", "time": 2031.75, "timestamp": "00:33:51", "text": "私が持っていないもの"}, {"type": "subtitle", "time": 2033.669, "timestamp": "00:33:53", "text": "うん、むしろストリームエネルギーみたいな感じ"}, {"type": "subtitle", "time": 2035.83, "timestamp": "00:33:55", "text": "ストリームには2種類あるって知ってる？"}, {"type": "subtitle", "time": 2038.31, "timestamp": "00:33:58", "text": "エネルギーは正しい3種類または3つです"}]
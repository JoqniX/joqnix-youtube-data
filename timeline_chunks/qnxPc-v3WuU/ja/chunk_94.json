[{"type": "subtitle", "time": 5653.75, "timestamp": "01:34:13", "text": "はい。彼はキルを決めた。おい。私は手に入れたい"}, {"type": "subtitle", "time": 5655.07, "timestamp": "01:34:15", "text": "ナイフ。行く"}, {"type": "subtitle", "time": 5664.07, "timestamp": "01:34:24", "text": "ナイフ。ああ。"}, {"type": "subtitle", "time": 5666.31, "timestamp": "01:34:26", "text": "ナイフを手に入れるまで、私はここを離れない"}, {"type": "subtitle", "time": 5673.43, "timestamp": "01:34:33", "text": "ごめん。私はナイフは買いません。"}, {"type": "subtitle", "time": 5681.59, "timestamp": "01:34:41", "text": "1秒。電話がかかってきて"}, {"type": "subtitle", "time": 5683.83, "timestamp": "01:34:43", "text": "家族。何てことだ。出席する必要がある"}, {"type": "subtitle", "time": 5686.79, "timestamp": "01:34:46", "text": "これ。待って、ゲームを終了させなきゃ。私"}]
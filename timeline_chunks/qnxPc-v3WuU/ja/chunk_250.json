[{"type": "subtitle", "time": 15002.479, "timestamp": "04:10:02", "text": "標準的な権利は痛みであり、 値段も高い"}, {"type": "subtitle", "time": 15009.11, "timestamp": "04:10:09", "text": "でも大丈夫、何とかするよ"}, {"type": "subtitle", "time": 15011.59, "timestamp": "04:10:11", "text": "たとえ時間がかかっても、"}, {"type": "subtitle", "time": 15013.91, "timestamp": "04:10:13", "text": "何かだが"}, {"type": "subtitle", "time": 15017.429, "timestamp": "04:10:17", "text": "ええ、私たちはゆっくりと確実にあなた"}, {"type": "subtitle", "time": 15020.229, "timestamp": "04:10:20", "text": "まるで新しいスポーツマンに変身しているようだ。"}, {"type": "subtitle", "time": 15021.75, "timestamp": "04:10:21", "text": "あなたが知っている。君が"}, {"type": "subtitle", "time": 15023.67, "timestamp": "04:10:23", "text": "もう年寄りじゃない。このモデルは古いですが"}, {"type": "subtitle", "time": 15026.67, "timestamp": "04:10:26", "text": "あなたは年寄りじゃないよ。あなたは"}, {"type": "subtitle", "time": 15029.83, "timestamp": "04:10:29", "text": "新しいので、新しいジョックニックを見ることになるでしょう"}, {"type": "subtitle", "time": 15033.429, "timestamp": "04:10:33", "text": "それもすぐに。うん。"}, {"type": "subtitle", "time": 15034.96, "timestamp": "04:10:34", "text": "うん。 それで、"}, {"type": "subtitle", "time": 15037.359, "timestamp": "04:10:37", "text": "それで、 わかった。質問がありました。私"}, {"type": "subtitle", "time": 15040.16, "timestamp": "04:10:40", "text": "わかった。質問がありました。私 配信とかでは聞かなかったよ。"}, {"type": "subtitle", "time": 15042.0, "timestamp": "04:10:42", "text": "配信とかでは聞かなかったよ。 ここで聞きたいのですが、あなたの"}, {"type": "subtitle", "time": 15044.64, "timestamp": "04:10:44", "text": "ここで聞きたいのですが、あなたの お気に入りのコラボは？"}, {"type": "subtitle", "time": 15050.389, "timestamp": "04:10:50", "text": "みんな。"}, {"type": "subtitle", "time": 15054.55, "timestamp": "04:10:54", "text": "なんてこった。私はそうは思わない。私は愛する"}, {"type": "subtitle", "time": 15057.83, "timestamp": "04:10:57", "text": "みんな。あなたはそれを知っています。うん。いいえ、いいえ、"}, {"type": "subtitle", "time": 15059.59, "timestamp": "04:10:59", "text": "いや、いや。言わなきゃダメだよ。ほら、それは"}]
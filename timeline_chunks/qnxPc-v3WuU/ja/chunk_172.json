[{"type": "subtitle", "time": 10323.429, "timestamp": "02:52:03", "text": "こんにちは。買うべきでしょうか？わからない。する"}, {"type": "subtitle", "time": 10325.269, "timestamp": "02:52:05", "text": "それを買うお金はある？私は"}, {"type": "subtitle", "time": 10327.99, "timestamp": "02:52:07", "text": "知る。 3,000。"}, {"type": "subtitle", "time": 10330.95, "timestamp": "02:52:10", "text": "それがいくらなのか分かりません。"}, {"type": "subtitle", "time": 10332.95, "timestamp": "02:52:12", "text": "ああ、こんにちは。"}, {"type": "subtitle", "time": 10344.429, "timestamp": "02:52:24", "text": "指で触られたって言って"}, {"type": "subtitle", "time": 10348.15, "timestamp": "02:52:28", "text": "ネオン。これはネオンですか？ええ、そうしました。はい、そうしました。"}, {"type": "subtitle", "time": 10350.95, "timestamp": "02:52:30", "text": "でも、楽しかったかって？それは"}, {"type": "subtitle", "time": 10357.59, "timestamp": "02:52:37", "text": "いいえ、していません。"}, {"type": "subtitle", "time": 10359.269, "timestamp": "02:52:39", "text": "皆さんはどんな音楽を聴きますか？"}, {"type": "subtitle", "time": 10361.11, "timestamp": "02:52:41", "text": "に？"}, {"type": "subtitle", "time": 10363.59, "timestamp": "02:52:43", "text": "私は日本の音楽を聴きます。ええと、できます"}, {"type": "subtitle", "time": 10365.75, "timestamp": "02:52:45", "text": "これを続けてください。ええ、私は聴いています"}, {"type": "subtitle", "time": 10367.95, "timestamp": "02:52:47", "text": "日本語。はい。"}, {"type": "subtitle", "time": 10370.23, "timestamp": "02:52:50", "text": "うんうん。君たちはどんな音楽が好き？"}, {"type": "subtitle", "time": 10373.83, "timestamp": "02:52:53", "text": "聞く？これですよね？えーと、"}, {"type": "subtitle", "time": 10375.83, "timestamp": "02:52:55", "text": "これですよね？これですよね？"}, {"type": "subtitle", "time": 10377.51, "timestamp": "02:52:57", "text": "これはどれくらい良いですか？私は計画しています"}]
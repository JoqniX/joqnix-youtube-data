[{"type": "subtitle", "time": 13683.71, "timestamp": "03:48:03", "text": "いろいろあって、いい感じだった"}, {"type": "subtitle", "time": 13686.95, "timestamp": "03:48:06", "text": "時間があって、彼女に感謝しているような感じでした"}, {"type": "subtitle", "time": 13690.79, "timestamp": "03:48:10", "text": "そして私は去って、自分のことをしていた"}, {"type": "subtitle", "time": 13693.309, "timestamp": "03:48:13", "text": "ストリーム。私はこれをストリーミングしていました"}, {"type": "subtitle", "time": 13697.429, "timestamp": "03:48:17", "text": "そして、このすべての中で、突然のことだった。私"}, {"type": "subtitle", "time": 13699.59, "timestamp": "03:48:19", "text": "「ああ、どうして私は"}, {"type": "subtitle", "time": 13702.389, "timestamp": "03:48:22", "text": "あの夢？"}, {"type": "subtitle", "time": 13704.95, "timestamp": "03:48:24", "text": "ああ、そう言う人もいるよ、あまり多くはないけど、"}, {"type": "subtitle", "time": 13707.11, "timestamp": "03:48:27", "text": "しかし、夢は"}, {"type": "subtitle", "time": 13710.269, "timestamp": "03:48:30", "text": "あなたの未来、あるいは別の世界からのあなた"}, {"type": "subtitle", "time": 13713.75, "timestamp": "03:48:33", "text": "宇宙。そう言う人もいる。それで、"}, {"type": "subtitle", "time": 13717.269, "timestamp": "03:48:37", "text": "うん。うん。だから、あなたはもしかしたら"}, {"type": "subtitle", "time": 13719.83, "timestamp": "03:48:39", "text": "別の宇宙であなたとアラカサンは"}, {"type": "subtitle", "time": 13722.389, "timestamp": "03:48:42", "text": "一緒にストリーミングするか、あるいはそれは"}, {"type": "subtitle", "time": 13725.91, "timestamp": "03:48:45", "text": "遠い未来の話だよ。知るか？"}, {"type": "subtitle", "time": 13726.59, "timestamp": "03:48:46", "text": "わかった。"}, {"type": "subtitle", "time": 13733.269, "timestamp": "03:48:53", "text": "それとも、これ？それとも、これ？現在？ああ、それは"}, {"type": "subtitle", "time": 13737.189, "timestamp": "03:48:57", "text": "待って、今あなたが"}, {"type": "subtitle", "time": 13739.51, "timestamp": "03:48:59", "text": "それについて話してくれた。ああ、わからない。私"}]
[{"type": "subtitle", "time": 12249.83, "timestamp": "03:24:09", "text": "遅れています。遅れています。私はまだ"}, {"type": "subtitle", "time": 12259.19, "timestamp": "03:24:19", "text": "準備ができました。"}, {"type": "subtitle", "time": 12278.07, "timestamp": "03:24:38", "text": "休ませてもらえますか？"}, {"type": "subtitle", "time": 12281.55, "timestamp": "03:24:41", "text": "彼は夏の間、彼と一緒に過ごすために来た。"}, {"type": "subtitle", "time": 12284.55, "timestamp": "03:24:44", "text": "はい。彼らが変更すれば、私たちは"}, {"type": "subtitle", "time": 12288.15, "timestamp": "03:24:48", "text": "数ヶ月滞在することになったが、それは避けられないことだった。"}, {"type": "subtitle", "time": 12290.429, "timestamp": "03:24:50", "text": "うん。私はしません"}, {"type": "subtitle", "time": 12293.91, "timestamp": "03:24:53", "text": "それが来るまで長い間待ち望んでいた。"}, {"type": "subtitle", "time": 12296.229, "timestamp": "03:24:56", "text": "よし。"}]
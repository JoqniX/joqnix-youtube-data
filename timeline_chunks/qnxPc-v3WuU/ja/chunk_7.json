[{"type": "subtitle", "time": 420.95, "timestamp": "00:07:00", "text": "そうなるだろう。それは、私にはわからない"}, {"type": "subtitle", "time": 424.629, "timestamp": "00:07:04", "text": "変だけど、同時に"}, {"type": "subtitle", "time": 427.589, "timestamp": "00:07:07", "text": "えっと、私はそれを真剣に受け止めました"}, {"type": "subtitle", "time": 428.749, "timestamp": "00:07:08", "text": "態度"}, {"type": "subtitle", "time": 432.189, "timestamp": "00:07:12", "text": "正しいやり方で深刻な"}, {"type": "subtitle", "time": 434.35, "timestamp": "00:07:14", "text": "方法または"}, {"type": "subtitle", "time": 436.87, "timestamp": "00:07:16", "text": "深刻なこと、例えば私は"}, {"type": "subtitle", "time": 441.629, "timestamp": "00:07:21", "text": "後で詳しく説明しますので、"}, {"type": "subtitle", "time": 444.79, "timestamp": "00:07:24", "text": "より難しい"}, {"type": "subtitle", "time": 446.629, "timestamp": "00:07:26", "text": "えっと、もし私が会社とコラボレーションしているなら"}, {"type": "subtitle", "time": 448.629, "timestamp": "00:07:28", "text": "もしくは何か何か、いや、それは私が"}, {"type": "subtitle", "time": 449.469, "timestamp": "00:07:29", "text": "しなければならない"}, {"type": "subtitle", "time": 453.43, "timestamp": "00:07:33", "text": "えっと、私も彼らを宣伝しないといけないですね"}, {"type": "subtitle", "time": 454.79, "timestamp": "00:07:34", "text": "私を通して、そしてそれらすべて"}, {"type": "subtitle", "time": 456.30899999999997, "timestamp": "00:07:36", "text": "自分のものを保持しながら、今は"}, {"type": "subtitle", "time": 459.029, "timestamp": "00:07:39", "text": "パーソナルケア用品など、すべて。"}, {"type": "subtitle", "time": 461.27, "timestamp": "00:07:41", "text": "だからある意味、それは"}, {"type": "subtitle", "time": 462.83, "timestamp": "00:07:42", "text": "痛みと"}, {"type": "subtitle", "time": 465.909, "timestamp": "00:07:45", "text": "難しいけど、誰かが"}, {"type": "subtitle", "time": 469.55, "timestamp": "00:07:49", "text": "私以外は受け入れることができます"}, {"type": "subtitle", "time": 474.71, "timestamp": "00:07:54", "text": "ジョッキーと私のオネクシアのやつ、私が好きなのは"}, {"type": "subtitle", "time": 477.909, "timestamp": "00:07:57", "text": "結局のところ、"}, {"type": "subtitle", "time": 479.79, "timestamp": "00:07:59", "text": "持っていません"}]
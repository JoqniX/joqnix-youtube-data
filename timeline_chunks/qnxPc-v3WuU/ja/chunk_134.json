[{"type": "subtitle", "time": 8052.35, "timestamp": "02:14:12", "text": "ああ、なんてことだ、彼らは"}, {"type": "subtitle", "time": 8068.43, "timestamp": "02:14:28", "text": "ようこそ、アカビア。お元気ですか"}, {"type": "subtitle", "time": 8070.87, "timestamp": "02:14:30", "text": "今日？おかえり。ありがとうございます"}, {"type": "subtitle", "time": 8073.669, "timestamp": "02:14:33", "text": "今日、屋外で生き延びている。"}, {"type": "subtitle", "time": 8075.629, "timestamp": "02:14:35", "text": "私は何をしたの？私は"}, {"type": "subtitle", "time": 8087.27, "timestamp": "02:14:47", "text": "彼らは一生懸命やっている。"}]
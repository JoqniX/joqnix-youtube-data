[{"type": "subtitle", "time": 15305.03, "timestamp": "04:15:05", "text": "冗談だよ。冗談です。誰もが"}, {"type": "subtitle", "time": 15307.189, "timestamp": "04:15:07", "text": "美しい。ジョーとコラボレーションした人は誰でも"}, {"type": "subtitle", "time": 15309.99, "timestamp": "04:15:09", "text": "あなたは彼ら全員を知っている。さくらを手に入れた"}, {"type": "subtitle", "time": 15317.03, "timestamp": "04:15:17", "text": "理由がわからない。理由がわからない"}, {"type": "subtitle", "time": 15319.269, "timestamp": "04:15:19", "text": "誰もが驚いた。ええ、わかりません"}, {"type": "subtitle", "time": 15321.189, "timestamp": "04:15:21", "text": "みんなが驚いたのは"}, {"type": "subtitle", "time": 15324.389, "timestamp": "04:15:24", "text": "それ。分かりません。それは大きなものですか"}, {"type": "subtitle", "time": 15326.389, "timestamp": "04:15:26", "text": "もの？"}, {"type": "subtitle", "time": 15328.87, "timestamp": "04:15:28", "text": "いいえ、誰も彼女を見たことがない"}, {"type": "subtitle", "time": 15331.429, "timestamp": "04:15:31", "text": "そんな時間なのに、いきなり私の配信を中断するなんて。"}, {"type": "subtitle", "time": 15333.63, "timestamp": "04:15:33", "text": "彼女はコラボレーションしました"}, {"type": "subtitle", "time": 15337.91, "timestamp": "04:15:37", "text": "自分。それは本当に大きなことです。"}, {"type": "subtitle", "time": 15340.229, "timestamp": "04:15:40", "text": "彼女はOSGの一人のような人ではないですか、"}, {"type": "subtitle", "time": 15343.83, "timestamp": "04:15:43", "text": "知ってるよ、そういうやつ。うん。最初のV"}, {"type": "subtitle", "time": 15346.95, "timestamp": "04:15:46", "text": "インド人ユーチューバーと交流し、"}, {"type": "subtitle", "time": 15349.67, "timestamp": "04:15:49", "text": "コラボレーションなど、"}, {"type": "subtitle", "time": 15350.75, "timestamp": "04:15:50", "text": "彼女"}, {"type": "subtitle", "time": 15357.87, "timestamp": "04:15:57", "text": "OGのOG 5人、そう、全員"}]
[{"type": "subtitle", "time": 13142.15, "timestamp": "03:39:02", "text": "そうですね、たくさんあります"}, {"type": "subtitle", "time": 13150.71, "timestamp": "03:39:10", "text": "君も知ってると思うけど、私は人を大切にするんだ。"}, {"type": "subtitle", "time": 13153.269, "timestamp": "03:39:13", "text": "一度話したことがあるなら、私たちは"}, {"type": "subtitle", "time": 13155.83, "timestamp": "03:39:15", "text": "彼らは友達で、私は彼らに連絡を取り、"}, {"type": "subtitle", "time": 13159.59, "timestamp": "03:39:19", "text": "大丈夫か、人生は順調かと尋ねるか、"}, {"type": "subtitle", "time": 13162.79, "timestamp": "03:39:22", "text": "そんな感じで、あなたの人生はどうですか？"}, {"type": "subtitle", "time": 13166.07, "timestamp": "03:39:26", "text": "一緒にコラボしたい？"}, {"type": "subtitle", "time": 13169.429, "timestamp": "03:39:29", "text": "しかし、ある意味ではそれは"}, {"type": "subtitle", "time": 13172.87, "timestamp": "03:39:32", "text": "それもまた悪いことだ。アプローチする"}, {"type": "subtitle", "time": 13174.63, "timestamp": "03:39:34", "text": "しばらく話していない人"}, {"type": "subtitle", "time": 13176.389, "timestamp": "03:39:36", "text": "そしてコラボレーションを依頼すると、彼らは"}, {"type": "subtitle", "time": 13179.83, "timestamp": "03:39:39", "text": "「えーと、コラボはしたくない」"}, {"type": "subtitle", "time": 13182.15, "timestamp": "03:39:42", "text": "だって、まだあなたのことを知らないから。まあ、そんな感じ。でも"}, {"type": "subtitle", "time": 13184.15, "timestamp": "03:39:44", "text": "たとえあなたが場を和ませようとしているとしても"}, {"type": "subtitle", "time": 13186.95, "timestamp": "03:39:46", "text": "そのコラボレーションに安心感を覚える人もいるが、"}, {"type": "subtitle", "time": 13189.11, "timestamp": "03:39:49", "text": "中には不快に感じる人もいる。それが私が"}, {"type": "subtitle", "time": 13191.59, "timestamp": "03:39:51", "text": "言っていた。"}, {"type": "subtitle", "time": 13194.67, "timestamp": "03:39:54", "text": "うん。うん。えっと"}, {"type": "subtitle", "time": 13198.55, "timestamp": "03:39:58", "text": "ええと、ここ3ヶ月くらいは"}]
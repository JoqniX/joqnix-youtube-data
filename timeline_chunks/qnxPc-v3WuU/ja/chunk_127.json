[{"type": "subtitle", "time": 7626.31, "timestamp": "02:07:06", "text": "switchireさん、Jenaiという曲を知っていますか？"}, {"type": "subtitle", "time": 7628.87, "timestamp": "02:07:08", "text": "ええ、聞いたことはあります。誰だったか忘れた"}, {"type": "subtitle", "time": 7631.75, "timestamp": "02:07:11", "text": "それはどこから来たのですか？"}, {"type": "subtitle", "time": 7635.589, "timestamp": "02:07:15", "text": "それは映画か何かで言ったセリフだと思う。私"}, {"type": "subtitle", "time": 7639.589, "timestamp": "02:07:19", "text": "忘れた。はぁ？それはあなたの映画からのものですか？私"}, {"type": "subtitle", "time": 7643.109, "timestamp": "02:07:23", "text": "わからないけど、わからない。それは それは"}, {"type": "subtitle", "time": 7646.31, "timestamp": "02:07:26", "text": "それはミミの件から来ている"}, {"type": "subtitle", "time": 7649.83, "timestamp": "02:07:29", "text": "ブルックリン999からですよね？ブルックリン9。"}, {"type": "subtitle", "time": 7651.99, "timestamp": "02:07:31", "text": "ああ、"}, {"type": "subtitle", "time": 7654.629, "timestamp": "02:07:34", "text": "複製。何をプレイしたいですか？"}, {"type": "subtitle", "time": 7657.51, "timestamp": "02:07:37", "text": "ネオン。ネオン。"}, {"type": "subtitle", "time": 7660.709, "timestamp": "02:07:40", "text": "よし、ネオンをプレイしよう。"}, {"type": "subtitle", "time": 7662.99, "timestamp": "02:07:42", "text": "私はいつもネオのために買っていた。わからない"}, {"type": "subtitle", "time": 7668.83, "timestamp": "02:07:48", "text": "なぜ。なぜ私はこんなにダメなんだろう？ああ、"}, {"type": "subtitle", "time": 7672.47, "timestamp": "02:07:52", "text": "神。プレイできます。大丈夫。大丈夫。"}, {"type": "subtitle", "time": 7674.55, "timestamp": "02:07:54", "text": "あなたが好きなエージェントは誰ですか？"}, {"type": "subtitle", "time": 7676.95, "timestamp": "02:07:56", "text": "アラントで？"}, {"type": "subtitle", "time": 7678.51, "timestamp": "02:07:58", "text": "私のお気に入り"}]
[{"type": "subtitle", "time": 4621.43, "timestamp": "01:17:01", "text": "準備なしでこんなに美味しいの？えっと、そうかな"}, {"type": "subtitle", "time": 4624.87, "timestamp": "01:17:04", "text": "おそらくそれが問題なのでしょう。うん。"}, {"type": "subtitle", "time": 4628.07, "timestamp": "01:17:08", "text": "ああ、それからヘラクレスもね。つまり、4人全員が"}, {"type": "subtitle", "time": 4631.51, "timestamp": "01:17:11", "text": "君たち。何？あなたたち4人全員。ああ、"}, {"type": "subtitle", "time": 4638.91, "timestamp": "01:17:18", "text": "手が冷たい。そして見てください"}, {"type": "subtitle", "time": 4642.39, "timestamp": "01:17:22", "text": "これ。私は、私は"}, {"type": "subtitle", "time": 4646.43, "timestamp": "01:17:26", "text": "うん。"}, {"type": "subtitle", "time": 4649.43, "timestamp": "01:17:29", "text": "こんにちは。誰かがそこへ行く音が聞こえる。こんにちは。"}, {"type": "subtitle", "time": 4652.79, "timestamp": "01:17:32", "text": "マヤ、今日の調子はどう？ありがとうございます"}, {"type": "subtitle", "time": 4654.63, "timestamp": "01:17:34", "text": "川にたどり着く。元気でいてくれるといいな"}, {"type": "subtitle", "time": 4656.87, "timestamp": "01:17:36", "text": "順調です。いいえ。"}, {"type": "subtitle", "time": 4659.11, "timestamp": "01:17:39", "text": "そして、ラインダーも。お元気でお過ごしでしょうか"}, {"type": "subtitle", "time": 4667.75, "timestamp": "01:17:47", "text": "あなた？お元気でお過ごしでしょうか。"}, {"type": "subtitle", "time": 4671.27, "timestamp": "01:17:51", "text": "かくれんぼでもするの？"}, {"type": "subtitle", "time": 4673.27, "timestamp": "01:17:53", "text": "みんなはどこにいるの？"}, {"type": "subtitle", "time": 4675.83, "timestamp": "01:17:55", "text": "私にもわからない。"}, {"type": "subtitle", "time": 4677.43, "timestamp": "01:17:57", "text": "おお、"}]
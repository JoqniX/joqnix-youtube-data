[{"type": "subtitle", "time": 2.71, "timestamp": "00:00:02", "text": "この機能については特にリクエストしました"}, {"type": "subtitle", "time": 5.51, "timestamp": "00:00:05", "text": "私はこれをすることができなかったし、"}, {"type": "subtitle", "time": 6.99, "timestamp": "00:00:06", "text": "私が尋ねた"}, {"type": "subtitle", "time": 10.31, "timestamp": "00:00:10", "text": "この明らかなプラグインの開発者"}, {"type": "subtitle", "time": 13.03, "timestamp": "00:00:13", "text": "ご存知のように、可能であれば、"}, {"type": "subtitle", "time": 19.189, "timestamp": "00:00:19", "text": "デュアルPCやトリプルPCのような方法"}, {"type": "subtitle", "time": 22.87, "timestamp": "00:00:22", "text": "あるいは、複数のPCユーザーが"}, {"type": "subtitle", "time": 25.91, "timestamp": "00:00:25", "text": "マウスデータを送信するだけで"}, {"type": "subtitle", "time": 28.509, "timestamp": "00:00:28", "text": "プラグインなのでズームできます"}, {"type": "subtitle", "time": 31.83, "timestamp": "00:00:31", "text": "ああ、こんな感じかな。なぜなら"}, {"type": "subtitle", "time": 34.15, "timestamp": "00:00:34", "text": "これは今ではズームインして"}, {"type": "subtitle", "time": 37.27, "timestamp": "00:00:37", "text": "人々に教える。いいえ、マウスは"}, {"type": "subtitle", "time": 39.79, "timestamp": "00:00:39", "text": "私がどこへ行ってもついてきた"}, {"type": "subtitle", "time": 41.63, "timestamp": "00:00:41", "text": "行く。"}, {"type": "subtitle", "time": 44.389, "timestamp": "00:00:44", "text": "右。ちょっと神経質というか、"}, {"type": "subtitle", "time": 47.75, "timestamp": "00:00:47", "text": "息苦しいところもあるが、"}, {"type": "subtitle", "time": 49.83, "timestamp": "00:00:49", "text": "それ以外では、ある程度目に見えて"}, {"type": "subtitle", "time": 53.35, "timestamp": "00:00:53", "text": "少しだけ見る。ああ、これはジョーが"}, {"type": "subtitle", "time": 55.75, "timestamp": "00:00:55", "text": "カチカチと音がしていた。こんな感じだったら"}, {"type": "subtitle", "time": 57.91, "timestamp": "00:00:57", "text": "そうすれば追跡しないのは難しいだろう"}]
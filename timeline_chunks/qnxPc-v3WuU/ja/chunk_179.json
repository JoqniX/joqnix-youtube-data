[{"type": "subtitle", "time": 10742.309, "timestamp": "02:59:02", "text": "肌。スペクトルスキン。えっと、何？"}, {"type": "subtitle", "time": 10744.95, "timestamp": "02:59:04", "text": "あれはそうだったのか？何てことだ。ああ、あそこにいる。"}, {"type": "subtitle", "time": 10754.95, "timestamp": "02:59:14", "text": "内部。何てことだ。"}, {"type": "subtitle", "time": 10756.469, "timestamp": "02:59:16", "text": "我々は後退することができる。我々は後退することができる。私たちは"}, {"type": "subtitle", "time": 10763.91, "timestamp": "02:59:23", "text": "ここは注意が必要だ。気をつけて。さあ、さあ、"}, {"type": "subtitle", "time": 10770.55, "timestamp": "02:59:30", "text": "待って、待って。スパイ、戻れ。スカイボーイ"}, {"type": "subtitle", "time": 10775.07, "timestamp": "02:59:35", "text": "手に入れた"}, {"type": "subtitle", "time": 10777.349, "timestamp": "02:59:37", "text": "彼。今は彼らが"}, {"type": "subtitle", "time": 10786.79, "timestamp": "02:59:46", "text": "天国。捕まえたぞ。"}, {"type": "subtitle", "time": 10791.11, "timestamp": "02:59:51", "text": "敵はあと一体。待って、彼はどこにいるの？"}, {"type": "subtitle", "time": 10793.51, "timestamp": "02:59:53", "text": "ああ、彼は参加している。"}, {"type": "subtitle", "time": 10797.03, "timestamp": "02:59:57", "text": "私は3つ持っています。私のSPを梱包してもいいですよ。"}]
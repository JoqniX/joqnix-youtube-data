[{"type": "subtitle", "time": 7503.03, "timestamp": "02:05:03", "text": "はい、どうぞ。ブリンクは安価なブリンクだ。"}, {"type": "subtitle", "time": 7506.03, "timestamp": "02:05:06", "text": "そうそう。私は瞬きを忘れません。"}, {"type": "subtitle", "time": 7509.35, "timestamp": "02:05:09", "text": "GG。 GG。しかし、あなたは瞬きもしなかった。あなた"}, {"type": "subtitle", "time": 7511.35, "timestamp": "02:05:11", "text": "すごく集中する。"}, {"type": "subtitle", "time": 7513.99, "timestamp": "02:05:13", "text": "ええ、瞬きするのを忘れてしまうんです。見てください"}, {"type": "subtitle", "time": 7520.149, "timestamp": "02:05:20", "text": "アニクン。何てことだ。キャリー。何てことだ。"}, {"type": "subtitle", "time": 7523.43, "timestamp": "02:05:23", "text": "とりあえず、今は様子を見ます。わかった。わかった。"}, {"type": "subtitle", "time": 7526.95, "timestamp": "02:05:26", "text": "彼女はそうしない。参加したい人はいますか？私"}, {"type": "subtitle", "time": 7528.79, "timestamp": "02:05:28", "text": "魂がない。魂は参加する必要がある。私"}, {"type": "subtitle", "time": 7529.87, "timestamp": "02:05:29", "text": "持っていない"}, {"type": "subtitle", "time": 7535.669, "timestamp": "02:05:35", "text": "私の魂は、行かなければならない。わかった。"}, {"type": "subtitle", "time": 7536.669, "timestamp": "02:05:36", "text": "そうそう。"}, {"type": "subtitle", "time": 7541.43, "timestamp": "02:05:41", "text": "えーとここにあります。他に誰か参加したい人はいますか？"}, {"type": "subtitle", "time": 7543.109, "timestamp": "02:05:43", "text": "ルームメイトのみなさん、こんにちは。こんにちは。元気ですか？希望"}, {"type": "subtitle", "time": 7544.31, "timestamp": "02:05:44", "text": "今日は素晴らしいですね。一度も会ったことがない"}, {"type": "subtitle", "time": 7546.31, "timestamp": "02:05:46", "text": "チャットで。お元気でお過ごしでしょうか"}, {"type": "subtitle", "time": 7547.91, "timestamp": "02:05:47", "text": "今日。"}, {"type": "subtitle", "time": 7550.87, "timestamp": "02:05:50", "text": "私も参加します。わかった。誰かと一緒に"}, {"type": "subtitle", "time": 7554.95, "timestamp": "02:05:54", "text": "参加しました。民話もここにある。誰が？誰"}]
[{"type": "subtitle", "time": 16326.63, "timestamp": "04:32:06", "text": "モデル。ええ、それは彼でした"}, {"type": "subtitle", "time": 16328.95, "timestamp": "04:32:08", "text": "また、別のタイプのスタイルも好きです。"}, {"type": "subtitle", "time": 16332.63, "timestamp": "04:32:12", "text": "まるで私がそれを見て"}, {"type": "subtitle", "time": 16333.95, "timestamp": "04:32:13", "text": "まるで、"}, {"type": "subtitle", "time": 16336.79, "timestamp": "04:32:16", "text": "「わあ、あれ欲しいな。」"}, {"type": "subtitle", "time": 16340.95, "timestamp": "04:32:20", "text": "だから私は好きになる方法を学んでいます"}, {"type": "subtitle", "time": 16343.03, "timestamp": "04:32:23", "text": "粘土模型を作らなきゃいけないから"}, {"type": "subtitle", "time": 16345.59, "timestamp": "04:32:25", "text": "まずあなた自身が、それからあなたが"}, {"type": "subtitle", "time": 16352.55, "timestamp": "04:32:32", "text": "自分がよく知っているものにそれを仕掛けるんだ。それで"}, {"type": "subtitle", "time": 16355.429, "timestamp": "04:32:35", "text": "うん、私はこれらを試している"}, {"type": "subtitle", "time": 16357.189, "timestamp": "04:32:37", "text": "数週間はただ作ろうとしていた"}, {"type": "subtitle", "time": 16359.51, "timestamp": "04:32:39", "text": "粘土模型みたいで、うまくいかない"}, {"type": "subtitle", "time": 16363.189, "timestamp": "04:32:43", "text": "だって、それに関するチュートリアルがないんだもん。"}, {"type": "subtitle", "time": 16365.269, "timestamp": "04:32:45", "text": "ああ、"}, {"type": "subtitle", "time": 16367.91, "timestamp": "04:32:47", "text": "でも、それはまるであなたみたい"}, {"type": "subtitle", "time": 16369.11, "timestamp": "04:32:49", "text": "何だと思う？見せてあげましょう。私は思う"}, {"type": "subtitle", "time": 16371.99, "timestamp": "04:32:51", "text": "私が何を見せるか見せれば、あなたはそれを理解できるでしょう"}, {"type": "subtitle", "time": 16375.75, "timestamp": "04:32:55", "text": "話している。わかった。"}]
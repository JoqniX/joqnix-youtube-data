[{"type": "subtitle", "time": 8822.389, "timestamp": "02:27:02", "text": "待って。わかった。あなたを"}, {"type": "subtitle", "time": 8824.23, "timestamp": "02:27:04", "text": "今こそリーダーだ。つまり、ストリーミング配信しているわけですね"}, {"type": "subtitle", "time": 8825.75, "timestamp": "02:27:05", "text": "良い。"}, {"type": "subtitle", "time": 8829.03, "timestamp": "02:27:09", "text": "わかった。わかった。わかった。スパイク、君はプレイできない"}, {"type": "subtitle", "time": 8831.59, "timestamp": "02:27:11", "text": "もう。泣きなさい。大丈夫。心配しないで"}, {"type": "subtitle", "time": 8836.15, "timestamp": "02:27:16", "text": "それについて。おお。なんてこった。ペナルティがある。"}, {"type": "subtitle", "time": 8839.11, "timestamp": "02:27:19", "text": "2分待ってください。ああ、おそらくできるだろう"}, {"type": "subtitle", "time": 8840.95, "timestamp": "02:27:20", "text": "それに合うカスタムデス。できるだろうか？"}, {"type": "subtitle", "time": 8842.79, "timestamp": "02:27:22", "text": "うん。うん。うん。うん。やってみよう"}, {"type": "subtitle", "time": 8855.51, "timestamp": "02:27:35", "text": "彼女に地獄のホスト役を任されたいのか？私"}, {"type": "subtitle", "time": 8858.55, "timestamp": "02:27:38", "text": "文字通り州の息子を脅迫した"}, {"type": "subtitle", "time": 8866.79, "timestamp": "02:27:46", "text": "私は「絶対来てよ」って言ったんです。それは それは"}, {"type": "subtitle", "time": 8868.95, "timestamp": "02:27:48", "text": "うん。ああ、なんてことだ。それはとてもひどい話ですね。それ"}, {"type": "subtitle", "time": 8874.15, "timestamp": "02:27:54", "text": "うん。"}]
[{"type": "subtitle", "time": 1500.269, "timestamp": "00:25:00", "text": "うん。待って。"}, {"type": "subtitle", "time": 1504.07, "timestamp": "00:25:04", "text": "パシフィック。 ESTって何でしたっけ？東部。"}, {"type": "subtitle", "time": 1506.149, "timestamp": "00:25:06", "text": "パシフィック。待って、待って、待って。さあ、さあ、私は"}, {"type": "subtitle", "time": 1507.71, "timestamp": "00:25:07", "text": "忘れた。待って。"}, {"type": "subtitle", "time": 1510.35, "timestamp": "00:25:10", "text": "何？ ESTとはどういう意味ですか"}, {"type": "subtitle", "time": 1512.789, "timestamp": "00:25:12", "text": "東部？北部にはないって言うなよ、"}, {"type": "subtitle", "time": 1516.549, "timestamp": "00:25:16", "text": "南部のどこかの国か何か。うん。待って。待って。"}, {"type": "subtitle", "time": 1518.47, "timestamp": "00:25:18", "text": "そこにいると思う、待って、私に言わないで"}, {"type": "subtitle", "time": 1525.51, "timestamp": "00:25:25", "text": "待って、まさかそれがNSTだなんて言わないよね。新しい"}, {"type": "subtitle", "time": 1532.59, "timestamp": "00:25:32", "text": "それ？そんなこと言わないで"}, {"type": "subtitle", "time": 1535.269, "timestamp": "00:25:35", "text": "SST。何かあるなんて言わないで"}, {"type": "subtitle", "time": 1538.23, "timestamp": "00:25:38", "text": "SSTと呼ばれています。がある。あ、待って。それは"}, {"type": "subtitle", "time": 1539.71, "timestamp": "00:25:39", "text": "いくつかの"}, {"type": "subtitle", "time": 1543.789, "timestamp": "00:25:43", "text": "もっと時間が必要だ。それはまるでどこかの場所のようで、"}, {"type": "subtitle", "time": 1557.95, "timestamp": "00:25:57", "text": "時間？"}]
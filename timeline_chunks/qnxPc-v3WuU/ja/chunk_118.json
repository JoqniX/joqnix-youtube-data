[{"type": "subtitle", "time": 7099.51, "timestamp": "01:58:19", "text": "もっとピュンピュン。ここにいたのは誰ですか？"}, {"type": "subtitle", "time": 7101.83, "timestamp": "01:58:21", "text": "うん、話したいことがあるんだ。えっと、それは"}, {"type": "subtitle", "time": 7104.39, "timestamp": "01:58:24", "text": "私がそうしなければコラボとは言えない"}, {"type": "subtitle", "time": 7108.75, "timestamp": "01:58:28", "text": "話すんだよね？私は全く話しません。ああ、"}, {"type": "subtitle", "time": 7112.149, "timestamp": "01:58:32", "text": "バカ。忘れた。私のミスです。私のミスです。だから、"}, {"type": "subtitle", "time": 7115.35, "timestamp": "01:58:35", "text": "押し下げて話してください。戦い。"}]
[{"type": "subtitle", "time": 11708.19, "timestamp": "03:15:08", "text": "わからない"}, {"type": "subtitle", "time": 11712.71, "timestamp": "03:15:12", "text": "起こった。なぜ私はこんなにもそうするのか、なぜ私はそうするのか、そしてそうするのか"}, {"type": "subtitle", "time": 11714.71, "timestamp": "03:15:14", "text": "ネオン？他のゲームをプレイする予定です"}, {"type": "subtitle", "time": 11718.15, "timestamp": "03:15:18", "text": "キャラクター。理由がわからない。"}, {"type": "subtitle", "time": 11721.11, "timestamp": "03:15:21", "text": "スピードが大事ですよね？スピード感はお好きですか？"}, {"type": "subtitle", "time": 11723.83, "timestamp": "03:15:23", "text": "ああ、それもそうだね。誰をプレイしますか?"}, {"type": "subtitle", "time": 11727.349, "timestamp": "03:15:27", "text": "あなたはApexをプレイしていますか？オクタン。"}, {"type": "subtitle", "time": 11729.99, "timestamp": "03:15:29", "text": "ああ、そう、オクタン。ええ、主にオクタンですね。"}, {"type": "subtitle", "time": 11733.19, "timestamp": "03:15:33", "text": "Octaneをプレイしていますが、今は"}, {"type": "subtitle", "time": 11736.389, "timestamp": "03:15:36", "text": "新たな伝説、触媒。"}, {"type": "subtitle", "time": 11739.269, "timestamp": "03:15:39", "text": "なるほど。何かあると思う"}, {"type": "subtitle", "time": 11742.79, "timestamp": "03:15:42", "text": "スピードのことです。あなたは短い髪が好きですね。私"}, {"type": "subtitle", "time": 11744.87, "timestamp": "03:15:44", "text": "わからない。"}, {"type": "subtitle", "time": 11747.11, "timestamp": "03:15:47", "text": "あなたは速いのがお好きですね。"}, {"type": "subtitle", "time": 11750.229, "timestamp": "03:15:50", "text": "はい、そうします。あなたは速いのが好きなんですね。私は推測する"}, {"type": "subtitle", "time": 11752.71, "timestamp": "03:15:52", "text": "だからあなたのエージェントは速いのです"}, {"type": "subtitle", "time": 11755.19, "timestamp": "03:15:55", "text": "おそらく。それはいいですね、なぜなら私は"}]
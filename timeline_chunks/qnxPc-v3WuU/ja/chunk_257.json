[{"type": "subtitle", "time": 15420.79, "timestamp": "04:17:00", "text": "人と遊んだりとか、そういうこと。"}, {"type": "subtitle", "time": 15424.07, "timestamp": "04:17:04", "text": "まるで新しい章が始まるかのようだ"}, {"type": "subtitle", "time": 15428.389, "timestamp": "04:17:08", "text": "私にとっては来月、来月です。ええ、そうですね。"}, {"type": "subtitle", "time": 15430.95, "timestamp": "04:17:10", "text": "ええ、それもありますね。"}, {"type": "subtitle", "time": 15432.71, "timestamp": "04:17:12", "text": "ということで、しばらくお会いすることはありませんが"}, {"type": "subtitle", "time": 15435.91, "timestamp": "04:17:15", "text": "同時に。あるいは、それが"}, {"type": "subtitle", "time": 15437.99, "timestamp": "04:17:17", "text": "ケース、ストリーミングできるとき"}, {"type": "subtitle", "time": 15446.67, "timestamp": "04:17:26", "text": "うん。私は"}, {"type": "subtitle", "time": 15450.229, "timestamp": "04:17:30", "text": "考えてみて、いや、できるかどうかわからない"}, {"type": "subtitle", "time": 15453.75, "timestamp": "04:17:33", "text": "そうするけど、私はちょっと考えていた"}, {"type": "subtitle", "time": 15458.79, "timestamp": "04:17:38", "text": "もし私がただ、知ってるでしょ、"}, {"type": "subtitle", "time": 15461.91, "timestamp": "04:17:41", "text": "チャンネルが1日かそこらでアクティブ"}, {"type": "subtitle", "time": 15464.149, "timestamp": "04:17:44", "text": "週に一度くらいプレイします"}, {"type": "subtitle", "time": 15465.71, "timestamp": "04:17:45", "text": "一部のVA"}, {"type": "subtitle", "time": 15469.51, "timestamp": "04:17:49", "text": "どういうわけか、そう、文字通りVか"}, {"type": "subtitle", "time": 15472.91, "timestamp": "04:17:52", "text": "何らかの形でこのPCから何らかの形で"}, {"type": "subtitle", "time": 15475.51, "timestamp": "04:17:55", "text": "どういうわけか、それは私がそうすべきではないことを意味する"}, {"type": "subtitle", "time": 15477.91, "timestamp": "04:17:57", "text": "私は自分のデータを持ち運ぶことができません"}, {"type": "subtitle", "time": 15479.99, "timestamp": "04:17:59", "text": "私ですよね？私は自分のデータを持っていかなければならない"}]
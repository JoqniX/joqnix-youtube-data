[{"type": "subtitle", "time": 15246.79, "timestamp": "04:14:06", "text": "はぁ？どちらも楽しかったです。私は"}, {"type": "subtitle", "time": 15250.149, "timestamp": "04:14:10", "text": "誰に対しても中立的すぎる。いいえ、たとえ"}, {"type": "subtitle", "time": 15253.67, "timestamp": "04:14:13", "text": "私は楽しんでいません、私は楽しんでいます"}, {"type": "subtitle", "time": 15255.51, "timestamp": "04:14:15", "text": "みんなと一緒にいる時間を楽しむのが好きです。知っている"}, {"type": "subtitle", "time": 15258.229, "timestamp": "04:14:18", "text": "それ。うん。なぜなら、人それぞれ違うから"}, {"type": "subtitle", "time": 15260.71, "timestamp": "04:14:20", "text": "雰囲気が違う。いいえ、混沌としています"}, {"type": "subtitle", "time": 15263.83, "timestamp": "04:14:23", "text": "1つ。その通り。静かな者たち。混沌とした存在。"}, {"type": "subtitle", "time": 15265.349, "timestamp": "04:14:25", "text": "うん、"}, {"type": "subtitle", "time": 15267.83, "timestamp": "04:14:27", "text": "持っていないものもあるだろう"}, {"type": "subtitle", "time": 15270.95, "timestamp": "04:14:30", "text": "永遠にコラボレーションもして、"}, {"type": "subtitle", "time": 15274.87, "timestamp": "04:14:34", "text": "コラボレーションとかのために参加するよ。うん、君"}, {"type": "subtitle", "time": 15279.149, "timestamp": "04:14:39", "text": "今後、コラボレーション企画も予定しています。うん。うん。"}, {"type": "subtitle", "time": 15283.269, "timestamp": "04:14:43", "text": "正直に言うと、"}, {"type": "chat", "time": 15284.916, "timestamp": "04:14:44", "author": "@kaiguyniki", "avatar": "https://yt4.ggpht.com/f9aZERpOc1bv1JDUl12ZTXeQ7j1KdXBflkbl-6qlBLzM-hbbEQKWUlPpcJJxTU-qSUwNxrez=s64-c-k-c0x00ffffff-no-rj", "message": "hype"}, {"type": "subtitle", "time": 15285.189, "timestamp": "04:14:45", "text": "私のお気に入りの配信はこれかもしれません。"}, {"type": "subtitle", "time": 15288.95, "timestamp": "04:14:48", "text": "ほら、私がここにいるから。私がその男です。私"}, {"type": "subtitle", "time": 15292.28, "timestamp": "04:14:52", "text": "俺がその人だよ。"}, {"type": "subtitle", "time": 15294.229, "timestamp": "04:14:54", "text": "[音楽]"}, {"type": "subtitle", "time": 15296.309, "timestamp": "04:14:56", "text": "はい。はい。そして私は最も似ている"}, {"type": "subtitle", "time": 15297.99, "timestamp": "04:14:57", "text": "彼らの中で一番ハンサムだよ。のように、"}]
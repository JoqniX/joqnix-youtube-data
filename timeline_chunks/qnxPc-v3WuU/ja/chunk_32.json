[{"type": "subtitle", "time": 1920.549, "timestamp": "00:32:00", "text": "広大で大きい。私たちは皆、それは小さなものだと言います"}, {"type": "subtitle", "time": 1923.909, "timestamp": "00:32:03", "text": "世界規模で展開しているが、独自の意味でも大きな存在だ。"}, {"type": "subtitle", "time": 1925.07, "timestamp": "00:32:05", "text": "こんな感じ"}, {"type": "subtitle", "time": 1930.75, "timestamp": "00:32:10", "text": "多くの都市、非常に多くの州、非常に多くの"}, {"type": "subtitle", "time": 1949.59, "timestamp": "00:32:29", "text": "速い。ああ、D。何て言ったんだっけ？私は私だった"}, {"type": "subtitle", "time": 1951.68, "timestamp": "00:32:31", "text": "しないで"}, {"type": "subtitle", "time": 1953.31, "timestamp": "00:32:33", "text": "[音楽]"}, {"type": "subtitle", "time": 1956.31, "timestamp": "00:32:36", "text": "知る。私の推薦リストに載りました。"}, {"type": "subtitle", "time": 1958.95, "timestamp": "00:32:38", "text": "え、本当に？待って。銃撃によるものだろう。"}, {"type": "subtitle", "time": 1960.789, "timestamp": "00:32:40", "text": "あなたが私を見ていたからだと思います"}, {"type": "subtitle", "time": 1962.549, "timestamp": "00:32:42", "text": "そして君たち二人はこう思った。「ああ、君たち"}, {"type": "subtitle", "time": 1964.71, "timestamp": "00:32:44", "text": "この人物に注目してください。私たちは送るつもりです"}, {"type": "subtitle", "time": 1966.47, "timestamp": "00:32:46", "text": "あなたに。彼をあなたの"}, {"type": "subtitle", "time": 1971.75, "timestamp": "00:32:51", "text": "何か。それは似ていると思う"}]
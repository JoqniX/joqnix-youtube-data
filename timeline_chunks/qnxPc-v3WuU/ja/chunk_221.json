[{"type": "subtitle", "time": 13264.389, "timestamp": "03:41:04", "text": "うん。うん。私のボイスメッセージはまあまあ"}, {"type": "subtitle", "time": 13268.03, "timestamp": "03:41:08", "text": "長さ。はぁ。さよなら。この男は私に"}, {"type": "subtitle", "time": 13272.03, "timestamp": "03:41:12", "text": "彼の最高値は次のような音声メッセージでした"}, {"type": "subtitle", "time": 13277.87, "timestamp": "03:41:17", "text": "45. 最高タイムのように。 45. そして私は座った"}, {"type": "subtitle", "time": 13281.429, "timestamp": "03:41:21", "text": "そこにいて、私はそこに座って飲んでいました"}, {"type": "subtitle", "time": 13283.349, "timestamp": "03:41:23", "text": "コーヒーを飲みながら、この男の話を聞いていると"}, {"type": "subtitle", "time": 13287.03, "timestamp": "03:41:27", "text": "ポッドキャストを聴いています。"}, {"type": "subtitle", "time": 13290.07, "timestamp": "03:41:30", "text": "それは私の人生で最も落ち込んだ部分でした"}, {"type": "subtitle", "time": 13291.99, "timestamp": "03:41:31", "text": "人生、友人の声を聞いている"}, {"type": "subtitle", "time": 13296.87, "timestamp": "03:41:36", "text": "チャット。あれが最低値だった。"}, {"type": "subtitle", "time": 13299.99, "timestamp": "03:41:39", "text": "でも、彼の一貫性はいつも"}, {"type": "subtitle", "time": 13303.63, "timestamp": "03:41:43", "text": "15分間のボイスメッセージをください"}, {"type": "subtitle", "time": 13306.67, "timestamp": "03:41:46", "text": "非現実的で、しかもイライラする。"}, {"type": "subtitle", "time": 13310.229, "timestamp": "03:41:50", "text": "何？どういう意味ですか？"}, {"type": "subtitle", "time": 13312.229, "timestamp": "03:41:52", "text": "彼が毎回私に送ってくる"}, {"type": "subtitle", "time": 13313.75, "timestamp": "03:41:53", "text": "音声メッセージを送ってくる、"}, {"type": "subtitle", "time": 13316.15, "timestamp": "03:41:56", "text": "こんにちは、お元気ですか？彼が望むものすべて"}, {"type": "subtitle", "time": 13318.71, "timestamp": "03:41:58", "text": "要点を一つだけ教えてください。彼"}]
[{"type": "subtitle", "time": 6729.589, "timestamp": "01:52:09", "text": "もの？もうすぐ寝ます。こんにちは、レン。私"}, {"type": "subtitle", "time": 6736.07, "timestamp": "01:52:16", "text": "アップルパイはお好きですか？はい、大好きです"}, {"type": "subtitle", "time": 6738.07, "timestamp": "01:52:18", "text": "アップルパイ。私はまだ食べていないけれど、"}, {"type": "subtitle", "time": 6774.189, "timestamp": "01:52:54", "text": "ニース。"}, {"type": "subtitle", "time": 6777.669, "timestamp": "01:52:57", "text": "いいえ。ベーコンは死んだのですか？いや、いや、いや。彼は"}]
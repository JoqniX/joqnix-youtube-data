[{"type": "subtitle", "time": 16681.67, "timestamp": "04:38:01", "text": "マップの向こう側から人々を凍らせるから"}, {"type": "subtitle", "time": 16684.629, "timestamp": "04:38:04", "text": "彼の凍結矢は壁を貫通する"}, {"type": "subtitle", "time": 16687.189, "timestamp": "04:38:07", "text": "などなど。つまり彼は凍ることができる"}, {"type": "subtitle", "time": 16690.23, "timestamp": "04:38:10", "text": "スポーン地点でスポーン"}, {"type": "subtitle", "time": 16691.789, "timestamp": "04:38:11", "text": "それは良いことだ"}, {"type": "subtitle", "time": 16694.269, "timestamp": "04:38:14", "text": "推測して"}, {"type": "subtitle", "time": 16699.75, "timestamp": "04:38:19", "text": "えっと、新キャラクターのウルトロンも登場します。"}, {"type": "subtitle", "time": 16701.869, "timestamp": "04:38:21", "text": "それは基本的に"}, {"type": "subtitle", "time": 16705.429, "timestamp": "04:38:25", "text": "それ。アップデートが増えるほど"}, {"type": "subtitle", "time": 16708.709, "timestamp": "04:38:28", "text": "さあ、そのゲームで私のフレームを止めてください"}, {"type": "subtitle", "time": 16712.15, "timestamp": "04:38:32", "text": "初めてドロップする"}, {"type": "subtitle", "time": 16717.47, "timestamp": "04:38:37", "text": "シーズンゼロは200フレーム2150くらいだった"}, {"type": "subtitle", "time": 16721.349, "timestamp": "04:38:41", "text": "フレームズ シーズン1が帰ってきた、今"}, {"type": "subtitle", "time": 16723.67, "timestamp": "04:38:43", "text": "170くらいで、ああ、そうだねって思った"}, {"type": "subtitle", "time": 16726.629, "timestamp": "04:38:46", "text": "よし、シーズン2が出たら私は"}, {"type": "subtitle", "time": 16729.51, "timestamp": "04:38:49", "text": "80フレーム"}, {"type": "subtitle", "time": 16731.75, "timestamp": "04:38:51", "text": "何てことだ"}, {"type": "subtitle", "time": 16734.789, "timestamp": "04:38:54", "text": "灰色 彼らは最適化しない"}]
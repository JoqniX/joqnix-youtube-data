[{"type": "subtitle", "time": 14400.15, "timestamp": "04:00:00", "text": "私はプロだから、それについて話す。私は...するだろう"}, {"type": "subtitle", "time": 14402.79, "timestamp": "04:00:02", "text": "洪水のような状況でなければ良かったのですが、"}, {"type": "subtitle", "time": 14405.269, "timestamp": "04:00:05", "text": "ほら、スポーツマンの写真が大量に出てきて"}, {"type": "subtitle", "time": 14407.91, "timestamp": "04:00:07", "text": "私の「おすすめ」ページへどうぞ。のように"}, {"type": "subtitle", "time": 14410.229, "timestamp": "04:00:10", "text": "私がスクロールする2つのリールは"}, {"type": "subtitle", "time": 14412.389, "timestamp": "04:00:12", "text": "ただのスポーツ選手の映像集。 「ああ、"}, {"type": "subtitle", "time": 14419.429, "timestamp": "04:00:19", "text": "とてもたくさん。 「うわあ、この男は"}, {"type": "subtitle", "time": 14421.79, "timestamp": "04:00:21", "text": "投稿"}, {"type": "subtitle", "time": 14426.87, "timestamp": "04:00:26", "text": "あなたがその数週間前に投稿した写真"}, {"type": "subtitle", "time": 14430.07, "timestamp": "04:00:30", "text": "あなたが何かを作っていた頃のこと？"}, {"type": "subtitle", "time": 14433.349, "timestamp": "04:00:33", "text": "そこでは1日10ドルだった。"}, {"type": "subtitle", "time": 14435.59, "timestamp": "04:00:35", "text": "イエス・キリスト。"}, {"type": "subtitle", "time": 14438.469, "timestamp": "04:00:38", "text": "そして、YouTubeはまだ終わっていません"}, {"type": "subtitle", "time": 14441.269, "timestamp": "04:00:41", "text": "一部、YouTube側の番組クリップ"}, {"type": "subtitle", "time": 14442.87, "timestamp": "04:00:42", "text": "コミュニティによって作られた"}, {"type": "subtitle", "time": 14446.229, "timestamp": "04:00:46", "text": "メンバー。えっと、まだ終わらせなきゃいけないし"}, {"type": "subtitle", "time": 14448.71, "timestamp": "04:00:48", "text": "それを追いかける。私はそれをしなければならない"}, {"type": "subtitle", "time": 14451.91, "timestamp": "04:00:51", "text": "最近。そうそう。あなたが"}, {"type": "subtitle", "time": 14454.229, "timestamp": "04:00:54", "text": "ストリームを追いかけるように"}, {"type": "subtitle", "time": 14457.11, "timestamp": "04:00:57", "text": "古いものから古いものまで"}, {"type": "subtitle", "time": 14459.03, "timestamp": "04:00:59", "text": "新しい。うん。ごくごく初期の段階"}]
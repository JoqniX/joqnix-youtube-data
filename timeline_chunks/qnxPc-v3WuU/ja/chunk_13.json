[{"type": "subtitle", "time": 780.79, "timestamp": "00:13:00", "text": "そしてこの場所の周りのすべてと同じように"}, {"type": "subtitle", "time": 782.269, "timestamp": "00:13:02", "text": "花火"}, {"type": "subtitle", "time": 789.55, "timestamp": "00:13:09", "text": "そして、とても多くの人が"}, {"type": "subtitle", "time": 793.11, "timestamp": "00:13:13", "text": "バンドやその他たくさんのもの"}, {"type": "subtitle", "time": 796.509, "timestamp": "00:13:16", "text": "いろいろなことが起こっていた。"}, {"type": "subtitle", "time": 798.949, "timestamp": "00:13:18", "text": "そう、だから私はためらっていたんだ"}, {"type": "subtitle", "time": 801.269, "timestamp": "00:13:21", "text": "昨日は騒音がひどかったので配信しました"}, {"type": "subtitle", "time": 808.269, "timestamp": "00:13:28", "text": "今。"}, {"type": "subtitle", "time": 812.11, "timestamp": "00:13:32", "text": "ええ、そうですね。えっと、私は何だったっけ？"}, {"type": "subtitle", "time": 814.43, "timestamp": "00:13:34", "text": "言っているの？私"}, {"type": "subtitle", "time": 817.269, "timestamp": "00:13:37", "text": "忘れた。ええ、名前の面ではね。ええ、それは"}, {"type": "subtitle", "time": 818.829, "timestamp": "00:13:38", "text": "なぜ私がそう思うかというと"}, {"type": "subtitle", "time": 822.03, "timestamp": "00:13:42", "text": "また、Onexiaは"}, {"type": "subtitle", "time": 825.269, "timestamp": "00:13:45", "text": "だから私はあなたが好きじゃなかった"}, {"type": "subtitle", "time": 827.87, "timestamp": "00:13:47", "text": "Twitterカードではなく、"}, {"type": "subtitle", "time": 830.47, "timestamp": "00:13:50", "text": "通常、あなたが"}, {"type": "subtitle", "time": 833.67, "timestamp": "00:13:53", "text": "会社か何かですよね？通常"}, {"type": "subtitle", "time": 836.79, "timestamp": "00:13:56", "text": "あなたはその定義を持っているはずです"}]
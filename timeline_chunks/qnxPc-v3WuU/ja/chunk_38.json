[{"type": "subtitle", "time": 2281.63, "timestamp": "00:38:01", "text": "ええ、でも私は"}, {"type": "subtitle", "time": 2284.95, "timestamp": "00:38:04", "text": "忘れた。正直に言うと、どちらが"}, {"type": "subtitle", "time": 2287.39, "timestamp": "00:38:07", "text": "より良いのは"}, {"type": "subtitle", "time": 2289.79, "timestamp": "00:38:09", "text": "なれ"}, {"type": "subtitle", "time": 2293.43, "timestamp": "00:38:13", "text": "えっと、私が思うに、あなたに言ってみましょう"}, {"type": "subtitle", "time": 2297.31, "timestamp": "00:38:17", "text": "視聴者として"}, {"type": "subtitle", "time": 2307.109, "timestamp": "00:38:27", "text": "そう、例えば、ビデオを見たとしましょう"}, {"type": "subtitle", "time": 2309.15, "timestamp": "00:38:29", "text": "ストリームまたは"}, {"type": "subtitle", "time": 2315.67, "timestamp": "00:38:35", "text": "ええ、もしそれが購読者モードなら、"}, {"type": "subtitle", "time": 2318.829, "timestamp": "00:38:38", "text": "私は何をするつもりですか"}, {"type": "subtitle", "time": 2322.63, "timestamp": "00:38:42", "text": "本能的に配信者を視聴する"}, {"type": "subtitle", "time": 2325.27, "timestamp": "00:38:45", "text": "あるいは、しばらくの間ストリーマーとして活動してみるのもいいでしょう。彼らがどのように"}, {"type": "subtitle", "time": 2327.43, "timestamp": "00:38:47", "text": "話したり、様子を見たり、何でもいいんです。それから"}, {"type": "subtitle", "time": 2329.71, "timestamp": "00:38:49", "text": "気に入ったら購読する"}, {"type": "subtitle", "time": 2333.19, "timestamp": "00:38:53", "text": "あれ。それから私は話すか、ただ見ているだけです。それは"}, {"type": "subtitle", "time": 2335.349, "timestamp": "00:38:55", "text": "私がやること。"}, {"type": "subtitle", "time": 2339.71, "timestamp": "00:38:59", "text": "しかし、ストリームのようなものを見ていると、"}]
[{"type": "subtitle", "time": 722.069, "timestamp": "00:12:02", "text": "右？私は今日のことを話していました。私の父"}, {"type": "subtitle", "time": 724.55, "timestamp": "00:12:04", "text": "彼が来ると思っていた。"}, {"type": "subtitle", "time": 726.87, "timestamp": "00:12:06", "text": "などなど。私は実際に彼に持ってきてもらうように言った"}, {"type": "subtitle", "time": 728.389, "timestamp": "00:12:08", "text": "のように"}, {"type": "subtitle", "time": 731.67, "timestamp": "00:12:11", "text": "えーと、お菓子とか。もちろん、私は"}, {"type": "subtitle", "time": 733.75, "timestamp": "00:12:13", "text": "自分でパン屋に行って買いました"}, {"type": "subtitle", "time": 735.19, "timestamp": "00:12:15", "text": "いろいろあったんだけど、彼は「ああ、知ってるよ」って感じだった。"}, {"type": "subtitle", "time": 738.03, "timestamp": "00:12:18", "text": "何？私は持っていきます"}, {"type": "subtitle", "time": 740.99, "timestamp": "00:12:20", "text": "だって、ほら、"}, {"type": "subtitle", "time": 745.19, "timestamp": "00:12:25", "text": "えっと、私の父は、"}, {"type": "subtitle", "time": 749.43, "timestamp": "00:12:29", "text": "うん。どれくらいのものが"}, {"type": "subtitle", "time": 752.629, "timestamp": "00:12:32", "text": "良い人でいて、私のためにも、そして全てのためにも。彼は"}, {"type": "subtitle", "time": 754.389, "timestamp": "00:12:34", "text": "学者になる？いや、いや、いや、いや、いや、いや。"}, {"type": "subtitle", "time": 757.829, "timestamp": "00:12:37", "text": "おばさんは今週は忙しいみたい"}, {"type": "subtitle", "time": 761.19, "timestamp": "00:12:41", "text": "今月は結婚式が多い月だと思う"}, {"type": "subtitle", "time": 763.509, "timestamp": "00:12:43", "text": "などなど、"}, {"type": "subtitle", "time": 766.55, "timestamp": "00:12:46", "text": "お祭りのようなお祭りが行われている"}, {"type": "subtitle", "time": 769.99, "timestamp": "00:12:49", "text": "これは地元の教会とのつながりです。"}, {"type": "subtitle", "time": 771.75, "timestamp": "00:12:51", "text": "だから昨日とかあれは"}, {"type": "subtitle", "time": 773.949, "timestamp": "00:12:53", "text": "いっぱいの"}, {"type": "subtitle", "time": 777.03, "timestamp": "00:12:57", "text": "まるでここにたくさんの人がいるみたいだ"}]
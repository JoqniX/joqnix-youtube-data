[{"type": "subtitle", "time": 6788.229, "timestamp": "01:53:08", "text": "すごく時間がかかってしまった。"}, {"type": "subtitle", "time": 6790.99, "timestamp": "01:53:10", "text": "ハロースティック"}, {"type": "subtitle", "time": 6796.31, "timestamp": "01:53:16", "text": "789. こんにちは。つまり"}, {"type": "subtitle", "time": 6798.87, "timestamp": "01:53:18", "text": "つまり、どこかで食べるつもりです。右。"}, {"type": "subtitle", "time": 6801.91, "timestamp": "01:53:21", "text": "お元気でお過ごしでしょうか。ああ、ソール、"}, {"type": "subtitle", "time": 6813.07, "timestamp": "01:53:33", "text": "今日？何てことだ。いろいろ試してみた。"}, {"type": "subtitle", "time": 6816.229, "timestamp": "01:53:36", "text": "はい。え、今、そう言ったの？いいえ、私は"}, {"type": "subtitle", "time": 6823.83, "timestamp": "01:53:43", "text": "こんにちは、786。こんにちは。今日は元気ですか？"}, {"type": "subtitle", "time": 6824.709, "timestamp": "01:53:44", "text": "今日は良い一日をお過ごしでしょうか。私は決して"}, {"type": "subtitle", "time": 6827.51, "timestamp": "01:53:47", "text": "君を見たよ。楽しんでいただければ幸いです。元気でいてくれるといいな"}]
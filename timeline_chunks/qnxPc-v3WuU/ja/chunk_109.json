[{"type": "subtitle", "time": 6540.75, "timestamp": "01:49:00", "text": "私はそれに勝たなければならない"}, {"type": "subtitle", "time": 6544.91, "timestamp": "01:49:04", "text": "どうにか。何てことだ。私は感覚がない"}, {"type": "subtitle", "time": 6556.87, "timestamp": "01:49:16", "text": "キル数ゼロで終わるのは私になる​​のかな？はぁ？"}, {"type": "subtitle", "time": 6563.189, "timestamp": "01:49:23", "text": "心。私はまだそうすべきだと思う"}, {"type": "subtitle", "time": 6566.31, "timestamp": "01:49:26", "text": "日陰を使用している場合は移動してください。"}, {"type": "subtitle", "time": 6568.27, "timestamp": "01:49:28", "text": "私"}, {"type": "subtitle", "time": 6589.51, "timestamp": "01:49:49", "text": "レンは、彼と一緒に殺すのはとても難しいです。"}]
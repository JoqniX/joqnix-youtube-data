[{"type": "subtitle", "time": 14222.79, "timestamp": "03:57:02", "text": "47 47 48 49 アストラのように数えることも"}, {"type": "subtitle", "time": 14226.309, "timestamp": "03:57:06", "text": "シサンや他の人たちのように"}, {"type": "subtitle", "time": 14229.03, "timestamp": "03:57:09", "text": "Minecraftのコラボのように"}, {"type": "subtitle", "time": 14231.429, "timestamp": "03:57:11", "text": "1つ。いいえ、それは数える必要はありません。私たちは"}, {"type": "subtitle", "time": 14233.03, "timestamp": "03:57:13", "text": "個々のものをカウントします。いいえ"}, {"type": "subtitle", "time": 14234.55, "timestamp": "03:57:14", "text": "心配事。"}, {"type": "subtitle", "time": 14237.349, "timestamp": "03:57:17", "text": "48歳はもうすぐ50歳になる。"}, {"type": "subtitle", "time": 14240.07, "timestamp": "03:57:20", "text": "行くぞ。私は行きます"}, {"type": "subtitle", "time": 14244.229, "timestamp": "03:57:24", "text": "5人、いや3人を置く"}, {"type": "subtitle", "time": 14246.95, "timestamp": "03:57:26", "text": "かつての協力者たち"}, {"type": "subtitle", "time": 14249.429, "timestamp": "03:57:29", "text": "夕方のスロットのような夜。 1時間1"}, {"type": "subtitle", "time": 14252.55, "timestamp": "03:57:32", "text": "1時間ずつ、それぞれの種類ごとに。"}, {"type": "subtitle", "time": 14256.229, "timestamp": "03:57:36", "text": "つまり、そのように3、3回の約束をしたということです。"}, {"type": "subtitle", "time": 14258.469, "timestamp": "03:57:38", "text": "ええ、できる限りそうします"}, {"type": "subtitle", "time": 14260.79, "timestamp": "03:57:40", "text": "それは、彼らが自由かどうかということです。えっと、それは"}, {"type": "subtitle", "time": 14263.91, "timestamp": "03:57:43", "text": "私がやろうとしていることの一つは、ええと、"}, {"type": "subtitle", "time": 14267.189, "timestamp": "03:57:47", "text": "私は、それが"}, {"type": "subtitle", "time": 14271.11, "timestamp": "03:57:51", "text": "1日に1回のコラボレーションなど、単発のコラボレーション"}, {"type": "subtitle", "time": 14274.15, "timestamp": "03:57:54", "text": "1日に2つのコラボをするみたいに"}, {"type": "subtitle", "time": 14276.71, "timestamp": "03:57:56", "text": "3つのコラボレーション、4つのコラボレーション、そして5つのコラボレーション。"}, {"type": "subtitle", "time": 14279.75, "timestamp": "03:57:59", "text": "例えば明日のものは実際には5です。"}]
[{"type": "subtitle", "time": 7680.83, "timestamp": "02:08:00", "text": "エージェントは"}, {"type": "subtitle", "time": 7686.069, "timestamp": "02:08:06", "text": "おそらくキルジョイだろう。もちろん、彼女のことです。"}, {"type": "subtitle", "time": 7688.79, "timestamp": "02:08:08", "text": "それで、興ざめな人。うん。"}, {"type": "subtitle", "time": 7691.75, "timestamp": "02:08:11", "text": "でもそれは彼女の子供のせいではなく、"}, {"type": "subtitle", "time": 7694.149, "timestamp": "02:08:14", "text": "何でも。それは彼女がとても"}, {"type": "subtitle", "time": 7697.51, "timestamp": "02:08:17", "text": "オタクっぽいとか、そういう類のもの。"}, {"type": "subtitle", "time": 7703.03, "timestamp": "02:08:23", "text": "あなたのお気に入りのエージェントは誰ですか？"}, {"type": "subtitle", "time": 7704.87, "timestamp": "02:08:24", "text": "ネオン。"}, {"type": "subtitle", "time": 7706.79, "timestamp": "02:08:26", "text": "わかった。でも、あの、知ってる？"}, {"type": "subtitle", "time": 7710.79, "timestamp": "02:08:30", "text": "ヴァレラントの伝承？うーん、大したことないですね。私はしていません"}, {"type": "subtitle", "time": 7713.99, "timestamp": "02:08:33", "text": "まだ動画を見ていません。あるもの"}, {"type": "subtitle", "time": 7717.99, "timestamp": "02:08:37", "text": "州とこれ。ああ、なるほど。"}, {"type": "subtitle", "time": 7723.91, "timestamp": "02:08:43", "text": "こんなクソみたいな曲をやる必要はないと思う"}, {"type": "subtitle", "time": 7726.87, "timestamp": "02:08:46", "text": "もう。"}, {"type": "subtitle", "time": 7731.03, "timestamp": "02:08:51", "text": "何？死んだ。ああ、あれは敵だった。死んだのは"}, {"type": "subtitle", "time": 7733.189, "timestamp": "02:08:53", "text": "もちろん。"}, {"type": "subtitle", "time": 7735.51, "timestamp": "02:08:55", "text": "私は夜をどう遊ぶのか知りません。"}, {"type": "subtitle", "time": 7737.75, "timestamp": "02:08:57", "text": "でも、ベーコンがあってよかった。ベーコンは"}, {"type": "subtitle", "time": 7739.99, "timestamp": "02:08:59", "text": "ヨル使いだと思う。彼はヨルを演じます。"}]
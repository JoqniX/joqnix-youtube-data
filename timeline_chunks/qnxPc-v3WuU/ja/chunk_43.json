[{"type": "subtitle", "time": 2581.589, "timestamp": "00:43:01", "text": "ええ、重要なものだけが表示されます"}, {"type": "subtitle", "time": 2583.67, "timestamp": "00:43:03", "text": "チャンネル。それが私が言いたかったことです。"}, {"type": "subtitle", "time": 2585.43, "timestamp": "00:43:05", "text": "これらの重要なチャネルはすべて、"}, {"type": "subtitle", "time": 2588.829, "timestamp": "00:43:08", "text": "おなじみのアナウンス 男性"}, {"type": "subtitle", "time": 2593.47, "timestamp": "00:43:13", "text": "えーと、スポーツマン関連のものとか、そういうもの全部"}, {"type": "subtitle", "time": 2597.03, "timestamp": "00:43:17", "text": "それ。そう、それがあなたが見るものになるでしょう"}, {"type": "subtitle", "time": 2599.19, "timestamp": "00:43:19", "text": "検証は待つようなものになります"}, {"type": "subtitle", "time": 2601.309, "timestamp": "00:43:21", "text": "どうすればいいの？私にはできないと思う"}, {"type": "subtitle", "time": 2604.15, "timestamp": "00:43:24", "text": "でも、数字体系をやらなきゃいけないんだよ"}, {"type": "subtitle", "time": 2609.03, "timestamp": "00:43:29", "text": "そして全てがそうなので、私はできると信じています"}, {"type": "subtitle", "time": 2611.069, "timestamp": "00:43:31", "text": "それを実行する"}, {"type": "subtitle", "time": 2621.349, "timestamp": "00:43:41", "text": "できない、できないと思うけど、"}, {"type": "subtitle", "time": 2622.349, "timestamp": "00:43:42", "text": "わかった"}, {"type": "subtitle", "time": 2625.109, "timestamp": "00:43:45", "text": "でも、皆さんに見せたいのは"}, {"type": "subtitle", "time": 2629.03, "timestamp": "00:43:49", "text": "検証関連のもの。私はしたい 私はしたい"}, {"type": "subtitle", "time": 2631.71, "timestamp": "00:43:51", "text": "したい、したい、したい"}, {"type": "subtitle", "time": 2634.67, "timestamp": "00:43:54", "text": "ショーを見たい"}, {"type": "subtitle", "time": 2638.47, "timestamp": "00:43:58", "text": "私はどこにいますか？私に"}]
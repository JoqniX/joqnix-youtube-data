[{"type": "subtitle", "time": 3962.39, "timestamp": "01:06:02", "text": "神経質。それはまるで"}, {"type": "subtitle", "time": 3965.029, "timestamp": "01:06:05", "text": "協力する傾向が強いと思うなら"}, {"type": "subtitle", "time": 3968.069, "timestamp": "01:06:08", "text": "それについて。コラボレーションに不向きな"}, {"type": "subtitle", "time": 3971.47, "timestamp": "01:06:11", "text": "よく考えてみれば、ある意味そう言える。しかし"}, {"type": "subtitle", "time": 3974.109, "timestamp": "01:06:14", "text": "ええ、そして"}, {"type": "subtitle", "time": 3977.15, "timestamp": "01:06:17", "text": "そうですね、コラボもしています"}, {"type": "subtitle", "time": 3980.549, "timestamp": "01:06:20", "text": "2、3回"}, {"type": "subtitle", "time": 3982.95, "timestamp": "01:06:22", "text": "4つ目かな。 ３つだったか、それとも"}, {"type": "subtitle", "time": 3985.75, "timestamp": "01:06:25", "text": "4つ？うん。ええ、数回ですが"}, {"type": "subtitle", "time": 3988.51, "timestamp": "01:06:28", "text": "それでも私はまだ緊張しています"}, {"type": "subtitle", "time": 3993.029, "timestamp": "01:06:33", "text": "日。大丈夫ですよ。そして私はもっと"}, {"type": "subtitle", "time": 3996.19, "timestamp": "01:06:36", "text": "えっと、緊張してるんだけど、"}, {"type": "subtitle", "time": 3998.789, "timestamp": "01:06:38", "text": "えっと、もっと緊張するのは、"}, {"type": "subtitle", "time": 4000.19, "timestamp": "01:06:40", "text": "それって何？"}, {"type": "subtitle", "time": 4004.91, "timestamp": "01:06:44", "text": "えっと、彼らは私の家に遊びに来ているお客さんなんです。"}, {"type": "subtitle", "time": 4007.67, "timestamp": "01:06:47", "text": "だから彼らは文字通り私の声を聞くことができる"}, {"type": "subtitle", "time": 4009.43, "timestamp": "01:06:49", "text": "英語が好きで、配信とか色々やってます。"}, {"type": "subtitle", "time": 4011.19, "timestamp": "01:06:51", "text": "だから私は本当に恥ずかしいのですが"}, {"type": "subtitle", "time": 4013.67, "timestamp": "01:06:53", "text": "彼らにはできない。"}, {"type": "subtitle", "time": 4015.87, "timestamp": "01:06:55", "text": "そして私はそうは思わない"}]
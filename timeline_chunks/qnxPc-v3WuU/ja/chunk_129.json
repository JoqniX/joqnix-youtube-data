[{"type": "subtitle", "time": 7743.91, "timestamp": "02:09:03", "text": "右？おい、フェイント集団。あなたは何を"}, {"type": "subtitle", "time": 7747.709, "timestamp": "02:09:07", "text": "それはどういう意味ですか？そうそう。あなたは何を"}, {"type": "subtitle", "time": 7756.47, "timestamp": "02:09:16", "text": "できる。どうやって遊ぶのか分からない。病気"}, {"type": "subtitle", "time": 7773.35, "timestamp": "02:09:33", "text": "何てことだ。やってみたけど、あなたは"}, {"type": "subtitle", "time": 7782.47, "timestamp": "02:09:42", "text": "痛みを感じる。"}, {"type": "subtitle", "time": 7789.39, "timestamp": "02:09:49", "text": "1つ"}, {"type": "subtitle", "time": 7792.95, "timestamp": "02:09:52", "text": "敵を突破する。"}, {"type": "subtitle", "time": 7796.149, "timestamp": "02:09:56", "text": "最後に残ったプレイヤー。"}]
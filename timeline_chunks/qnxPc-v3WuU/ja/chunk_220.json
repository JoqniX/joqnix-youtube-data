[{"type": "subtitle", "time": 13200.87, "timestamp": "03:40:00", "text": "こんな風にストリーミング配信をするのは長い"}, {"type": "subtitle", "time": 13204.309, "timestamp": "03:40:04", "text": "期間。うん。質問したいのですが"}, {"type": "subtitle", "time": 13206.15, "timestamp": "03:40:06", "text": "それについて質問があります。何が"}, {"type": "subtitle", "time": 13209.349, "timestamp": "03:40:09", "text": "この中で一番難しい部分は？"}, {"type": "subtitle", "time": 13220.07, "timestamp": "03:40:20", "text": "一部。一番大変なのは、ご存じの通りです。うん。"}, {"type": "subtitle", "time": 13222.63, "timestamp": "03:40:22", "text": "うん。うん。それは何だったのか？最も難しい部分"}, {"type": "subtitle", "time": 13227.75, "timestamp": "03:40:27", "text": "つまり、連絡を取るということです"}, {"type": "subtitle", "time": 13230.229, "timestamp": "03:40:30", "text": "みんなは大丈夫だったけど、私は"}, {"type": "subtitle", "time": 13232.87, "timestamp": "03:40:32", "text": "考えすぎてしまう"}, {"type": "subtitle", "time": 13235.51, "timestamp": "03:40:35", "text": "えーと、数字とか全部"}, {"type": "subtitle", "time": 13238.309, "timestamp": "03:40:38", "text": "人々が好きでなく、望まない場合はどうなるでしょうか"}, {"type": "subtitle", "time": 13240.79, "timestamp": "03:40:40", "text": "私と一緒にやってください、私は小さなチャンネルなので"}, {"type": "subtitle", "time": 13243.75, "timestamp": "03:40:43", "text": "それらの心配事はすべて現実になった"}, {"type": "subtitle", "time": 13245.91, "timestamp": "03:40:45", "text": "今月はすごくストレスが溜まっていた"}, {"type": "subtitle", "time": 13250.309, "timestamp": "03:40:50", "text": "それについて、あなたたち二人はもう知っている。"}, {"type": "subtitle", "time": 13253.83, "timestamp": "03:40:53", "text": "私はあなたのDMをずっと待っていました"}]
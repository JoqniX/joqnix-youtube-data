[{"type": "subtitle", "time": 16143.95, "timestamp": "04:29:03", "text": "友人たちの助けと"}, {"type": "subtitle", "time": 16147.67, "timestamp": "04:29:07", "text": "ストリーマーの動画をいくつか見ています"}, {"type": "subtitle", "time": 16150.63, "timestamp": "04:29:10", "text": "Twitchでリギングしているみたい、ライブ配信しているみたい"}, {"type": "subtitle", "time": 16152.71, "timestamp": "04:29:12", "text": "Twitchでリギングしてるよ、だってフォローしてるから"}, {"type": "subtitle", "time": 16154.75, "timestamp": "04:29:14", "text": "そういうタイプの男たちと"}, {"type": "subtitle", "time": 16158.229, "timestamp": "04:29:18", "text": "女の子たち、わかるでしょ、それで私はただ彼女たちに尋ねるだけ"}, {"type": "subtitle", "time": 16160.469, "timestamp": "04:29:20", "text": "質問や、単に質問する"}, {"type": "subtitle", "time": 16162.469, "timestamp": "04:29:22", "text": "彼らにどうすればいいですか"}, {"type": "subtitle", "time": 16164.71, "timestamp": "04:29:24", "text": "彼らはそれを画面に表示するだけだ。それはとても"}, {"type": "subtitle", "time": 16168.07, "timestamp": "04:29:28", "text": "大変参考になりました。素晴らしいですね。"}, {"type": "subtitle", "time": 16170.55, "timestamp": "04:29:30", "text": "ああ、それが私なんだ、それが私なんだ"}, {"type": "subtitle", "time": 16172.55, "timestamp": "04:29:32", "text": "学習もしています。さらに、彼らはあなたに伝え、"}, {"type": "subtitle", "time": 16173.75, "timestamp": "04:29:33", "text": "もの。 「ああ、そうだね」"}, {"type": "subtitle", "time": 16176.269, "timestamp": "04:29:36", "text": "かなり素晴らしい。だって私は"}, {"type": "subtitle", "time": 16179.389, "timestamp": "04:29:39", "text": "私の友人たちが私に言ったように覚えておいて"}, {"type": "subtitle", "time": 16182.95, "timestamp": "04:29:42", "text": "だって彼女は昔は"}, {"type": "subtitle", "time": 16185.349, "timestamp": "04:29:45", "text": "配信でも機材を使っているように。うん、これ"}, {"type": "subtitle", "time": 16187.349, "timestamp": "04:29:47", "text": "それはかなりクールだと思うよ。そして使用"}, {"type": "subtitle", "time": 16191.03, "timestamp": "04:29:51", "text": "それを見るために。私も彼女の札束を見ています"}, {"type": "subtitle", "time": 16193.03, "timestamp": "04:29:53", "text": "今回もただ学ぶために"}, {"type": "subtitle", "time": 16196.149, "timestamp": "04:29:56", "text": "古いストリームからの何か"}, {"type": "subtitle", "time": 16199.67, "timestamp": "04:29:59", "text": "リギングと彼女は私に言った、まるで"}]
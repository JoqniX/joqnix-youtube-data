[{"type": "subtitle", "time": 12910.95, "timestamp": "03:35:10", "text": "こんにちは。こんにちは、ブラッド。あなたは"}, {"type": "subtitle", "time": 12914.63, "timestamp": "03:35:14", "text": "方法。生放送中ですか？皆さん、私の声は聞こえますか？"}, {"type": "subtitle", "time": 12916.63, "timestamp": "03:35:16", "text": "はい。"}, {"type": "subtitle", "time": 12918.87, "timestamp": "03:35:18", "text": "ああ、神様。ちょっと待ってください。それから私は"}, {"type": "subtitle", "time": 12923.269, "timestamp": "03:35:23", "text": "食べる。私の太ったお尻は何かを食べていた。"}, {"type": "subtitle", "time": 12924.71, "timestamp": "03:35:24", "text": "心配ない。心配ない。ゆっくりしてください。"}, {"type": "subtitle", "time": 12934.67, "timestamp": "03:35:34", "text": "皆さん、今日のゲストは"}, {"type": "subtitle", "time": 12938.469, "timestamp": "03:35:38", "text": "ブラッド。今日のゲストはブラッドさんです。あなたはそうするかもしれない"}, {"type": "subtitle", "time": 12942.79, "timestamp": "03:35:42", "text": "彼については、私の配信から知っています。"}, {"type": "subtitle", "time": 12945.11, "timestamp": "03:35:45", "text": "ジョッカソン開催中。彼は"}, {"type": "subtitle", "time": 12949.429, "timestamp": "03:35:49", "text": "私が"}, {"type": "subtitle", "time": 12951.91, "timestamp": "03:35:51", "text": "流れから離れて休憩しているとき、"}, {"type": "subtitle", "time": 12954.429, "timestamp": "03:35:54", "text": "彼はかつて、川で"}, {"type": "subtitle", "time": 12957.83, "timestamp": "03:35:57", "text": "ゲストと人々は、現時点では"}]
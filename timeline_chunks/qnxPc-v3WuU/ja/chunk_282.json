[{"type": "subtitle", "time": 16923.75, "timestamp": "04:42:03", "text": "プレッシャーがかかって、息が詰まるような感じ"}, {"type": "subtitle", "time": 16926.19, "timestamp": "04:42:06", "text": "あちこちで"}, {"type": "subtitle", "time": 16930.55, "timestamp": "04:42:10", "text": "ああ、わからないよ。"}, {"type": "subtitle", "time": 16933.91, "timestamp": "04:42:13", "text": "それで、何があなたを悩ませているのですか？えっと、"}, {"type": "chat", "time": 16935.071, "timestamp": "04:42:15", "author": "@site36.official", "avatar": "https://yt4.ggpht.com/Oc0kgq4lSUaD-BoDbaDE3pXUquuz47c4Yh7kwPILHO2D70EQ5EnEgoGgTbb5gw993EEXRqCx_A=s64-c-k-c0x00ffffff-no-rj", "message": "I finally got that VST plugin to work and the audio rendering is taking time so I'mma stay on that track for its reveal."}, {"type": "subtitle", "time": 16935.67, "timestamp": "04:42:15", "text": "たくさんのこと。うん。つまり、ほら、"}, {"type": "subtitle", "time": 16937.788, "timestamp": "04:42:17", "text": "もうすでにそうなっている。私はそうすべきではないと思います。"}, {"type": "subtitle", "time": 16941.19, "timestamp": "04:42:21", "text": "兄弟。私のミスです。質問してしまってすみませんでした。私"}, {"type": "subtitle", "time": 16943.27, "timestamp": "04:42:23", "text": "チャドは知らないと思う。だから私は"}, {"type": "subtitle", "time": 16946.47, "timestamp": "04:42:26", "text": "気づかない、と付け加えておこうと思った。"}, {"type": "subtitle", "time": 16950.39, "timestamp": "04:42:30", "text": "あなたが知っている。知っている。わかってるよ"}, {"type": "subtitle", "time": 16959.99, "timestamp": "04:42:39", "text": "うん。うん。"}, {"type": "subtitle", "time": 16962.51, "timestamp": "04:42:42", "text": "だから気にしないでください。えっと、でも"}, {"type": "subtitle", "time": 16965.07, "timestamp": "04:42:45", "text": "うん、たくさん"}, {"type": "subtitle", "time": 16969.11, "timestamp": "04:42:49", "text": "私が一番感じていること"}, {"type": "subtitle", "time": 16973.07, "timestamp": "04:42:53", "text": "ほとんどの場合、それは感じて、"}, {"type": "subtitle", "time": 16977.27, "timestamp": "04:42:57", "text": "うーん、騙されやすいというのは、その言葉です"}, {"type": "subtitle", "time": 16979.47, "timestamp": "04:42:59", "text": "ガリビブルか、私は確信しています"}]
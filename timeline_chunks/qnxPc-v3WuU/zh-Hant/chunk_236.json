[{"type": "subtitle", "time": 14161.189, "timestamp": "03:56:01", "text": "光譜嗎？哦，我錯過了這個。  不，我持懷疑態度。  是的。"}, {"type": "subtitle", "time": 14165.269, "timestamp": "03:56:05", "text": "你想要嗎？哦好的。這裡發生了什麼事？"}, {"type": "subtitle", "time": 14174.229, "timestamp": "03:56:14", "text": "等等，我剛才想問什麼。  你按下Y鍵，它就會唱歌給你聽。"}, {"type": "subtitle", "time": 14179.95, "timestamp": "03:56:19", "text": "嘿，你在做那個嗎？"}, {"type": "subtitle", "time": 14183.51, "timestamp": "03:56:23", "text": "我剛才看到你在"}, {"type": "subtitle", "time": 14185.83, "timestamp": "03:56:25", "text": "過河前幾乎都帶齊了。是的。  狩獵時間到了。"}, {"type": "subtitle", "time": 14193.03, "timestamp": "03:56:33", "text": "設置警報。我走了。放置炸彈手榴彈。"}, {"type": "subtitle", "time": 14203.309, "timestamp": "03:56:43", "text": "小心點"}, {"type": "subtitle", "time": 14209.429, "timestamp": "03:56:49", "text": "。  我的天啊，經典之作"}]
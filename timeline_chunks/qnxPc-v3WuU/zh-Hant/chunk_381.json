[{"type": "subtitle", "time": 22873.67, "timestamp": "06:21:13", "text": "所以，我從這裡向他問好。"}, {"type": "subtitle", "time": 22889.67, "timestamp": "06:21:29", "text": "該死。"}, {"type": "subtitle", "time": 22892.788, "timestamp": "06:21:32", "text": "我信任他的命運技能，兄弟。"}, {"type": "subtitle", "time": 22900.948, "timestamp": "06:21:40", "text": "他被懷疑了，"}, {"type": "subtitle", "time": 22904.23, "timestamp": "06:21:44", "text": "告訴我一件事，聊天記錄裡"}]
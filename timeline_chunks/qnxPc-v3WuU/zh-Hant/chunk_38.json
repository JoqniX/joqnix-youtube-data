[{"type": "subtitle", "time": 2293.43, "timestamp": "00:38:13", "text": "我想做週邊產品。你"}, {"type": "subtitle", "time": 2307.109, "timestamp": "00:38:27", "text": "看，自從我成為音樂的忠實粉絲以來，音樂就一直讓我很著迷。你知道，就是那種DJ、演唱會之類的東西，我"}, {"type": "subtitle", "time": 2322.63, "timestamp": "00:38:42", "text": "內心深處其實想做出那種完美的、最棒的新一代週邊產品，那種人們"}]
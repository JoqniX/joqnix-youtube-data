[{"type": "subtitle", "time": 9789.429, "timestamp": "02:43:09", "text": "我說話嗎？ 我什至都不知道"}, {"type": "subtitle", "time": 9799.03, "timestamp": "02:43:19", "text": "。  我正在弄一個標籤。兄弟，連你的貝洛莎都是"}, {"type": "subtitle", "time": 9812.63, "timestamp": "02:43:32", "text": "綠頭髮。不，不，不。她養了一隻綠色的貓。它不會讓頭髮變綠。不，不，不。"}]
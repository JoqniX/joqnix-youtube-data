[{"type": "subtitle", "time": 2941.71, "timestamp": "00:49:01", "text": "周一的工作效率高嗎？"}, {"type": "subtitle", "time": 2952.11, "timestamp": "00:49:12", "text": "不。你工作過度了。"}, {"type": "subtitle", "time": 2962.23, "timestamp": "00:49:22", "text": "今天是周日。是啊，對你來說是星期日。對我來說是星期一。我像個殭屍。那"}, {"type": "subtitle", "time": 2965.19, "timestamp": "00:49:25", "text": "你那邊現在幾點了？怎麼了？今天是"}, {"type": "subtitle", "time": 2968.829, "timestamp": "00:49:28", "text": "周日"}, {"type": "subtitle", "time": 2988.71, "timestamp": "00:49:48", "text": "。什麼？不錯。現在是晚上。晚上。太好了。哦。哦，等等。 B 是 MST 時間。好的。我忘了。我忘了。"}]
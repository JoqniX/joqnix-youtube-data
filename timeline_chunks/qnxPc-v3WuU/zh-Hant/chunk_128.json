[{"type": "subtitle", "time": 7691.75, "timestamp": "02:08:11", "text": "不，還有"}, {"type": "subtitle", "time": 7704.87, "timestamp": "02:08:24", "text": "雷因德。希望你一切都好。你好嗎？你好嗎？希望"}, {"type": "subtitle", "time": 7706.79, "timestamp": "02:08:26", "text": "你一切都好。  玩"}, {"type": "subtitle", "time": 7710.79, "timestamp": "02:08:30", "text": "捉迷藏嗎？  人都去哪兒了？  我甚至都不知道。  哦好的。我聽說對我來說是“不”"}, {"type": "subtitle", "time": 7717.99, "timestamp": "02:08:37", "text": "。那嚇到我了。好的，我看到了。我要離開"}, {"type": "subtitle", "time": 7735.51, "timestamp": "02:08:55", "text": "一會兒，有事要辦"}, {"type": "subtitle", "time": 7737.75, "timestamp": "02:08:57", "text": "。我的天哪。我的天哪。你好。你好。你好。你好。  火已經滅了。  我的"}]
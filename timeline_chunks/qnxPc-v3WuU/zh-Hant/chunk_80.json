[{"type": "subtitle", "time": 4807.11, "timestamp": "01:20:07", "text": "在簡介裡"}, {"type": "subtitle", "time": 4819.11, "timestamp": "01:20:19", "text": "是這裡的新人。 或其他什麼的時候，竟然會有人想到我。真酷。"}, {"type": "subtitle", "time": 4835.51, "timestamp": "01:20:35", "text": "不過，謝謝你，魔鬼。希望你工作上一切順利。"}, {"type": "subtitle", "time": 4837.75, "timestamp": "01:20:37", "text": "今天是星期一。"}]
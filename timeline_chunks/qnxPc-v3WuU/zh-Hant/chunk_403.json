[{"type": "subtitle", "time": 24183.11, "timestamp": "06:43:03", "text": "我說說吧。好的。她是怎麼做到的？  從現在"}, {"type": "subtitle", "time": 24226.99, "timestamp": "06:43:46", "text": "開始。  是的。"}, {"type": "subtitle", "time": 24234.23, "timestamp": "06:43:54", "text": "你的眼睛。  友誼日快樂。巴米。  友誼長存，快樂無憂。  好的。炸彈來了。炸彈來了。炸彈。  你在接線嗎？哦，友誼日快樂！晃動"}]
[{"type": "subtitle", "time": 2.71, "timestamp": "00:00:02", "text": "我特意要求添加這個功能，因為"}, {"type": "subtitle", "time": 5.51, "timestamp": "00:00:05", "text": "我之前無法做到這一點。我很高興"}, {"type": "subtitle", "time": 6.99, "timestamp": "00:00:06", "text": "我"}, {"type": "subtitle", "time": 10.31, "timestamp": "00:00:10", "text": "向這個顯而易見的插件的開發者提出了請求，問他"}, {"type": "subtitle", "time": 13.03, "timestamp": "00:00:13", "text": "是否可以為"}, {"type": "subtitle", "time": 19.189, "timestamp": "00:00:19", "text": "雙PC、三PC"}, {"type": "subtitle", "time": 22.87, "timestamp": "00:00:22", "text": "或多台PC用戶提供一種方法，讓"}, {"type": "subtitle", "time": 49.83, "timestamp": "00:00:49", "text": "他們可以將滑鼠資料傳送到插件，這樣我就可以進行縮放之類的操作"}, {"type": "subtitle", "time": 53.35, "timestamp": "00:00:53", "text": "。哦，是的，有點像這樣"}, {"type": "subtitle", "time": 55.75, "timestamp": "00:00:55", "text": "。因為現在我可以放大講解，教給其他人了。不，因為無論我走到哪裡，"}]
[{"type": "subtitle", "time": 14222.79, "timestamp": "03:57:02", "text": "竟然消失了，"}, {"type": "subtitle", "time": 14231.429, "timestamp": "03:57:11", "text": "我都不知道它去哪兒了"}, {"type": "subtitle", "time": 14240.07, "timestamp": "03:57:20", "text": "。我昨天就應該買這款皮膚的。  我的天哪，太好吃了"}, {"type": "subtitle", "time": 14252.55, "timestamp": "03:57:32", "text": "。現在我想，啊，我為什麼跳過這一步呢？"}, {"type": "subtitle", "time": 14258.469, "timestamp": "03:57:38", "text": "哦，不。好的，記下來。  謝謝。偵察區域。"}, {"type": "subtitle", "time": 14260.79, "timestamp": "03:57:40", "text": "哦，我們搞定了。啊，"}, {"type": "subtitle", "time": 14267.189, "timestamp": "03:57:47", "text": "我的天哪。  我們走吧。好的。我跟你說過我的生活很糟糕。  沒關係。我只是用了光譜圖。"}]
[{"type": "subtitle", "time": 23589.75, "timestamp": "06:33:09", "text": "難題。"}, {"type": "subtitle", "time": 23602.948, "timestamp": "06:33:22", "text": "我看到"}, {"type": "subtitle", "time": 23621.27, "timestamp": "06:33:41", "text": "炸彈了。真的假的？噓。哇。哦，卡西"}, {"type": "subtitle", "time": 23636.31, "timestamp": "06:33:56", "text": "。哇。混種狗。凱在對你耍脾氣。你相信嗎？耍脾氣。什麼是耍脾氣？他在對你擺架子"}]
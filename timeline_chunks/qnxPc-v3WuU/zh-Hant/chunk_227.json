[{"type": "subtitle", "time": 13629.51, "timestamp": "03:47:09", "text": "V，我會"}, {"type": "subtitle", "time": 13642.67, "timestamp": "03:47:22", "text": "叫你V。就像《賽博朋克V》的主角一樣。五星好評。  我們走吧。  我的天啊。搞什麼鬼？"}, {"type": "subtitle", "time": 13659.99, "timestamp": "03:47:39", "text": "我的"}, {"type": "subtitle", "time": 13662.15, "timestamp": "03:47:42", "text": "天哪。"}, {"type": "subtitle", "time": 13676.469, "timestamp": "03:47:56", "text": "等等，"}]
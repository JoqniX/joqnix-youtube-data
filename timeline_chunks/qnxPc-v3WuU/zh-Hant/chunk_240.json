[{"type": "subtitle", "time": 14419.429, "timestamp": "04:00:19", "text": "男孩"}, {"type": "subtitle", "time": 14424.15, "timestamp": "04:00:24", "text": "天空。  抓到他了。"}, {"type": "subtitle", "time": 14430.07, "timestamp": "04:00:30", "text": "他們所在的地方現在應該已經有一台了。"}, {"type": "subtitle", "time": 14435.59, "timestamp": "04:00:35", "text": "天堂。"}, {"type": "subtitle", "time": 14448.71, "timestamp": "04:00:48", "text": "抓到他了。  還剩一個敵人。等等，他在哪裡？  哦，他進來了。我有三個。你可以把我的SP打包帶走。  謝謝。  還剩30秒。一起出行。"}, {"type": "subtitle", "time": 14451.91, "timestamp": "04:00:51", "text": "你可以種植任意數量的"}, {"type": "subtitle", "time": 14454.229, "timestamp": "04:00:54", "text": "植物。"}]
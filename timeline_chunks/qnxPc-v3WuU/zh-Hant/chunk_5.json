[{"type": "subtitle", "time": 310.79, "timestamp": "00:05:10", "text": "我們還有 Onexia 的相關工作要做，對吧？"}, {"type": "subtitle", "time": 322.23, "timestamp": "00:05:22", "text": "原因嘛，嗯，就像你看，作為一個創作者，我們有一些有趣的娛樂內容，比如遊戲等等，但主要，"}, {"type": "subtitle", "time": 332.07, "timestamp": "00:05:32", "text": "我最想做的是實現我的願望和目標，比如舉辦自己的"}, {"type": "subtitle", "time": 336.67, "timestamp": "00:05:36", "text": "演唱會，擁有自己的作品和項目"}]
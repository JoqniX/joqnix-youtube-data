[{"type": "subtitle", "time": 18903.31, "timestamp": "05:15:03", "text": "哦，不。不，是同一個人。"}, {"type": "subtitle", "time": 18933.91, "timestamp": "05:15:33", "text": "對不起。  是同一個人。該死。  是的。是的。我想做一些類似的事情，你知道嗎？  查德看不見"}, {"type": "subtitle", "time": 18939.99, "timestamp": "05:15:39", "text": "。真讓人難過。我剛輸入了“是”。好的"}, {"type": "subtitle", "time": 18950.23, "timestamp": "05:15:50", "text": "。你就隨便聊聊，"}]
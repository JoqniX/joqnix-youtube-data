[{"type": "subtitle", "time": 3517.99, "timestamp": "00:58:37", "text": "相信這是你第一次來。不。歡迎。希望你今天過得愉快。星期一快樂，或者如果你今天是星期天，那就星期天快樂。歡迎"}, {"type": "subtitle", "time": 3522.23, "timestamp": "00:58:42", "text": "來到Quans to L。"}, {"type": "subtitle", "time": 3531.51, "timestamp": "00:58:51", "text": "哦，我的天哪，有這麼多人。這樣正常嗎？這樣正常嗎？"}, {"type": "subtitle", "time": 3537.43, "timestamp": "00:58:57", "text": "我會推薦它嗎？是嗎？那是不是意味著，我既是音樂愛好者，又能展現我的"}]
[{"type": "subtitle", "time": 23702.788, "timestamp": "06:35:02", "text": "放炸彈的鴨子。對了，你做得很好。是啊，她做得很好。嗯哼。如果我的"}, {"type": "subtitle", "time": 23709.51, "timestamp": "06:35:09", "text": "多動症沒發作，我可能會說：“"}, {"type": "subtitle", "time": 23717.67, "timestamp": "06:35:17", "text": "我按了"}, {"type": "subtitle", "time": 23720.15, "timestamp": "06:35:20", "text": "第四個按鈕，第三個按鈕是什麼？ 「哦，不。好吧。那麼，呃，輪到你了。輪到我了。是的。好的。嗨。好的。鞋子。等等，我們要做"}, {"type": "subtitle", "time": 23721.43, "timestamp": "06:35:21", "text": "第一個"}, {"type": "subtitle", "time": 23731.19, "timestamp": "06:35:31", "text": "炸彈，對吧？我們想打破祖奇的紀錄，對吧"}]
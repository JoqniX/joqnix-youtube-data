[{"type": "subtitle", "time": 13818.15, "timestamp": "03:50:18", "text": "兩道光芒。  告訴我你被那個霓虹燈招手摸到了。這是霓虹燈嗎？是的，我做了。"}, {"type": "subtitle", "time": 13835.11, "timestamp": "03:50:35", "text": "我做了。  但我喜歡嗎？"}, {"type": "subtitle", "time": 13838.15, "timestamp": "03:50:38", "text": "這就是問題所在。"}, {"type": "subtitle", "time": 13839.75, "timestamp": "03:50:39", "text": "不，我"}, {"type": "subtitle", "time": 13856.63, "timestamp": "03:50:56", "text": "沒有。  你們平時都聽什麼類型的音樂？  我喜歡聽日本音樂。呃，你可以繼續。是的，我聽"}]
[{"type": "subtitle", "time": 10702.309, "timestamp": "02:58:22", "text": "好的。我不會玩《Yoru》，但幸好我們有"}, {"type": "subtitle", "time": 10712.07, "timestamp": "02:58:32", "text": "培根。  我的天啊。"}, {"type": "subtitle", "time": 10720.23, "timestamp": "02:58:40", "text": "我試過了，但你是個假醫生。我的"}, {"type": "subtitle", "time": 10722.71, "timestamp": "02:58:42", "text": "天啊。那真是痛不欲生。  我的天啊。發現"}, {"type": "subtitle", "time": 10732.95, "timestamp": "02:58:52", "text": "敵軍。  一個敵人穿過"}]
[{"type": "subtitle", "time": 977.71, "timestamp": "00:16:17", "text": "覺得這有點痛苦和艱難，但願有人能接受我，除了我的騎師"}, {"type": "subtitle", "time": 981.269, "timestamp": "00:16:21", "text": "和我的奧尼西亞之外"}, {"type": "subtitle", "time": 987.79, "timestamp": "00:16:27", "text": "。說到底，你知道，我沒有"}, {"type": "subtitle", "time": 991.03, "timestamp": "00:16:31", "text": "姓氏，但辛西亞是從騎師那裡誕生的，或是來自騎師，"}, {"type": "subtitle", "time": 1003.189, "timestamp": "00:16:43", "text": "。這部劇集、其他角色、有趣的背景故事、"}, {"type": "subtitle", "time": 1006.269, "timestamp": "00:16:46", "text": "深奧的背景故事，一切都將阻礙你。我的意思是，你可能在其他直播串流之類的地方也看過"}]
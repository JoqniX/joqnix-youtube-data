[{"type": "subtitle", "time": 20285.35, "timestamp": "05:38:05", "text": "什麼的"}, {"type": "subtitle", "time": 20288.47, "timestamp": "05:38:08", "text": "。對，可口可樂行。對，這樣別人就能"}, {"type": "subtitle", "time": 20290.15, "timestamp": "05:38:10", "text": "看到了。"}, {"type": "subtitle", "time": 20299.43, "timestamp": "05:38:19", "text": "哦，他在喝東西，他們不會知道是可口可樂。"}, {"type": "subtitle", "time": 20314.31, "timestamp": "05:38:34", "text": "這叫「古巴處女」。閉嘴，Roku。"}, {"type": "subtitle", "time": 20321.43, "timestamp": "05:38:41", "text": "我們知道。我們知道你是個酒鬼。是我的年齡。下。呃，Jo讓我想起了Joan。覺我的大腦……香蕉奶昔。那有多少"}, {"type": "chat", "time": 20324.796, "timestamp": "05:38:44", "author": "@Roku-rin", "avatar": "https://yt4.ggpht.com/8LlS_C2IirDMfA5r2V0q5G1kudp8dmG6RQvz_jCAUT3H-esyEgTNPDwrfCXiyX7Undc9UmHNgw=s64-c-k-c0x00ffffff-no-rj", "message": "why dont u go to colosseum there too LMAO"}]
[{"type": "subtitle", "time": 13588.229, "timestamp": "03:46:28", "text": "天啊，"}, {"type": "subtitle", "time": 13591.11, "timestamp": "03:46:31", "text": "我死了。有座位。這都躲到哪裡去了？你好嗎？"}, {"type": "subtitle", "time": 13593.189, "timestamp": "03:46:33", "text": "但"}, {"type": "subtitle", "time": 13596.189, "timestamp": "03:46:36", "text": "你就像她對我展現的勇氣或某種東西一樣。"}, {"type": "subtitle", "time": 13617.91, "timestamp": "03:46:57", "text": "她隨機從B地過來的。過來一下。還剩30秒。  還剩一個敵人。最後一名倖存者。  別叫我"}]
[{"type": "subtitle", "time": 3908.15, "timestamp": "01:05:08", "text": "不想給人"}, {"type": "subtitle", "time": 3914.95, "timestamp": "01:05:14", "text": "你可以隨時取消訂閱或訂閱，隨你便"}, {"type": "subtitle", "time": 3918.109, "timestamp": "01:05:18", "text": "。這取決於你，也"}, {"type": "subtitle", "time": 3931.95, "timestamp": "01:05:31", "text": "取決於現在正在觀看的人。"}, {"type": "subtitle", "time": 3939.23, "timestamp": "01:05:39", "text": "所以我就在"}]
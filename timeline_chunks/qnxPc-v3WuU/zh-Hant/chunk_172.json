[{"type": "subtitle", "time": 10323.429, "timestamp": "02:52:03", "text": "我一句話也不說。"}, {"type": "subtitle", "time": 10332.95, "timestamp": "02:52:12", "text": "啊，笨蛋。我忘了。我的錯。我的錯。所以，我會按下按鈕"}, {"type": "subtitle", "time": 10363.59, "timestamp": "02:52:43", "text": "哦，我是阿斯特拉。"}, {"type": "subtitle", "time": 10367.95, "timestamp": "02:52:47", "text": "耶。  我殺了一個人，但我自己也死了。  離開。"}]
[{"type": "subtitle", "time": 19981.27, "timestamp": "05:33:01", "text": "D。別"}, {"type": "subtitle", "time": 19985.27, "timestamp": "05:33:05", "text": "擔心。我知道你是。這就是瓊善良美麗的內心。不是每個人都值得擁有，但我們都需要。謝謝你，"}, {"type": "subtitle", "time": 19998.788, "timestamp": "05:33:18", "text": "D。別"}, {"type": "subtitle", "time": 20017.27, "timestamp": "05:33:37", "text": "擔心。我知道"}]
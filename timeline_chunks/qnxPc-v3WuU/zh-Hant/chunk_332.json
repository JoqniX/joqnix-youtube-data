[{"type": "subtitle", "time": 19921.59, "timestamp": "05:32:01", "text": "。的話。"}, {"type": "subtitle", "time": 19924.23, "timestamp": "05:32:04", "text": "我不是說，你知道，我也很過分，但沒那麼過分。制不住。"}, {"type": "subtitle", "time": 19936.31, "timestamp": "05:32:16", "text": "傷什麼的。 O C K E Y」還是「J O Q Y」？不，你，我"}, {"type": "subtitle", "time": 19938.39, "timestamp": "05:32:18", "text": "知道，Roku。你是在說我。別擔心。"}, {"type": "chat", "time": 19959.396, "timestamp": "05:32:39", "author": "@Roku-rin", "avatar": "https://yt4.ggpht.com/8LlS_C2IirDMfA5r2V0q5G1kudp8dmG6RQvz_jCAUT3H-esyEgTNPDwrfCXiyX7Undc9UmHNgw=s64-c-k-c0x00ffffff-no-rj", "message": "deserved "}, {"type": "subtitle", "time": 19960.39, "timestamp": "05:32:40", "text": "不是每個人都值得擁有，但我們都需要。"}, {"type": "chat", "time": 19979.841, "timestamp": "05:32:59", "author": "@Roku-rin", "avatar": "https://yt4.ggpht.com/8LlS_C2IirDMfA5r2V0q5G1kudp8dmG6RQvz_jCAUT3H-esyEgTNPDwrfCXiyX7Undc9UmHNgw=s64-c-k-c0x00ffffff-no-rj", "message": "double it and give it to him back"}]
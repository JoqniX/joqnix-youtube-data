[{"type": "subtitle", "time": 20340.868, "timestamp": "05:39:00", "text": "卡路里？腦子死定的"}, {"type": "subtitle", "time": 20362.948, "timestamp": "05:39:22", "text": "女人。走吧。腦子死定了。走吧。哦，你好，劍魚。歡迎。你好，劍魚。歡迎來到腦子死定。他為什麼要故意拖延刑期來陷害我"}, {"type": "subtitle", "time": 20365.75, "timestamp": "05:39:25", "text": "？好吧，"}, {"type": "subtitle", "time": 20379.548, "timestamp": "05:39:39", "text": "去你的，Roku。哦，我的天。隨便你吧。你想怎樣，伙計。你知道，我就是喜歡被欺負，"}]
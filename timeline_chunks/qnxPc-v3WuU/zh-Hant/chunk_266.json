[{"type": "subtitle", "time": 15983.429, "timestamp": "04:26:23", "text": "你可以買盾牌。他沒有盾牌。"}, {"type": "subtitle", "time": 15993.469, "timestamp": "04:26:33", "text": "哦，是的。"}, {"type": "subtitle", "time": 16001.59, "timestamp": "04:26:41", "text": "我剛剛才意識到我"}, {"type": "subtitle", "time": 16003.99, "timestamp": "04:26:43", "text": "沒有護盾。"}, {"type": "subtitle", "time": 16014.469, "timestamp": "04:26:54", "text": "手榴彈。  重新裝彈。  嗯？他媽的。  你"}, {"type": "subtitle", "time": 16018.07, "timestamp": "04:26:58", "text": "可以推她一把。不。我的天哪。休息時間過長了。  我已經用過了。  我的天啊。  我"}]
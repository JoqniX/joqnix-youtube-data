[{"type": "subtitle", "time": 10148.63, "timestamp": "02:49:08", "text": "我的天啊。他沒問題。  我的天啊。  任也開始殺人了。  你好。"}, {"type": "subtitle", "time": 10157.99, "timestamp": "02:49:17", "text": "哦，他把它幹掉了"}, {"type": "subtitle", "time": 10159.75, "timestamp": "02:49:19", "text": "。"}, {"type": "subtitle", "time": 10166.87, "timestamp": "02:49:26", "text": "我簡直無語了。  我的天啊。"}, {"type": "subtitle", "time": 10182.269, "timestamp": "02:49:42", "text": "哦，等等。"}, {"type": "subtitle", "time": 10184.95, "timestamp": "02:49:44", "text": "我好像聽到他說話了。  搞定了。  還剩"}, {"type": "subtitle", "time": 10194.309, "timestamp": "02:49:54", "text": "一分鐘。他在哪裡？ 他在哪裡？  我的天啊。我的天啊。奧丁。我懂了。  是的。 GG。 GG。"}]
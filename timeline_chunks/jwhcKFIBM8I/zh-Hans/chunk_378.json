[{"type": "subtitle", "time": 22687.19, "timestamp": "06:18:07", "text": "利用下水道来建造"}, {"type": "subtitle", "time": 22690.31, "timestamp": "06:18:10", "text": "他们的藏身之处等等。 而且他们"}, {"type": "subtitle", "time": 22692.708, "timestamp": "06:18:12", "text": "俩都喜欢表演，所以这么做也合情合理。 他们"}, {"type": "subtitle", "time": 22695.43, "timestamp": "06:18:15", "text": "搞得像在演歌剧一样。 歌剧之类的东西。   哇，"}, {"type": "subtitle", "time": 22699.03, "timestamp": "06:18:19", "text": "这说得通。"}, {"type": "subtitle", "time": 22726.548, "timestamp": "06:18:46", "text": "他去世了。   是的"}]
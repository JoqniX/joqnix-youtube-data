[{"type": "subtitle", "time": 7102.39, "timestamp": "01:58:22", "text": "所以，她是个叛徒。"}, {"type": "subtitle", "time": 7120.709, "timestamp": "01:58:40", "text": "伙计，"}, {"type": "subtitle", "time": 7124.229, "timestamp": "01:58:44", "text": "卡，为什么？ 顺便说一句，我很喜欢你的穿着打扮"}, {"type": "subtitle", "time": 7125.91, "timestamp": "01:58:45", "text": "。"}, {"type": "subtitle", "time": 7130.55, "timestamp": "01:58:50", "text": "双马尾女士。 我觉得她可以上场。"}, {"type": "subtitle", "time": 7133.51, "timestamp": "01:58:53", "text": "我猜"}, {"type": "subtitle", "time": 7137.27, "timestamp": "01:58:57", "text": "她觉得自己还是个可玩角色。"}]
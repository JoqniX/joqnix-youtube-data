[{"type": "subtitle", "time": 932.31, "timestamp": "00:15:32", "text": "好吧，[笑]"}, {"type": "subtitle", "time": 934.79, "timestamp": "00:15:34", "text": "垂直运动确实有点"}, {"type": "subtitle", "time": 937.189, "timestamp": "00:15:37", "text": "痛苦。 我觉得汹涌的波涛把"}, {"type": "subtitle", "time": 940.87, "timestamp": "00:15:40", "text": "我惯坏了，它们在奔跑中展现出的杂技般的动作让我难以招架"}]
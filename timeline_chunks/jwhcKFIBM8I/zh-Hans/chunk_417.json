[{"type": "subtitle", "time": 25022.468, "timestamp": "06:57:02", "text": "好了，我想我们今天可以到此为止了"}, {"type": "subtitle", "time": 25030.548, "timestamp": "06:57:10", "text": "。"}, {"type": "subtitle", "time": 25033.43, "timestamp": "06:57:13", "text": "感谢你今天陪伴迈阿密来到《"}, {"type": "subtitle", "time": 25038.07, "timestamp": "06:57:18", "text": "深夜深渊》。"}, {"type": "subtitle", "time": 25040.788, "timestamp": "06:57:20", "text": "我们已经直播了将近7个"}, {"type": "subtitle", "time": 25042.548, "timestamp": "06:57:22", "text": "小时了。"}, {"type": "subtitle", "time": 25045.35, "timestamp": "06:57:25", "text": "直播结束时应该是七点。 今天过得很开心。"}, {"type": "subtitle", "time": 25047.11, "timestamp": "06:57:27", "text": "故事和所有事情都结束了。"}, {"type": "subtitle", "time": 25049.83, "timestamp": "06:57:29", "text": "今天是第二天。 我很高兴"}, {"type": "subtitle", "time": 25051.99, "timestamp": "06:57:31", "text": "大部分事情都完成了。 至于其他的"}, {"type": "subtitle", "time": 25053.67, "timestamp": "06:57:33", "text": "事情，比如收集所有角色"}, {"type": "subtitle", "time": 25056.628, "timestamp": "06:57:36", "text": "并把他们升到满级等等，"}, {"type": "subtitle", "time": 25062.548, "timestamp": "06:57:42", "text": "那可能就需要反复"}, {"type": "subtitle", "time": 25065.83, "timestamp": "06:57:45", "text": "刷材料之类的，"}, {"type": "subtitle", "time": 25067.91, "timestamp": "06:57:47", "text": "对吧？ 我们可以稍后再做，比如"}, {"type": "subtitle", "time": 25069.91, "timestamp": "06:57:49", "text": "明天的直播之类的。"}, {"type": "subtitle", "time": 25073.35, "timestamp": "06:57:53", "text": "你仍然需要做枯萎这件事。"}, {"type": "subtitle", "time": 25077.27, "timestamp": "06:57:57", "text": "嗯，还得执行蓝色协议。 所以"}, {"type": "subtitle", "time": 25079.67, "timestamp": "06:57:59", "text": "，我还不确定今晚"}]
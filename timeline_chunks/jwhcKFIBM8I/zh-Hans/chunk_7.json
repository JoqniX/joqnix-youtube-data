[{"type": "subtitle", "time": 430.95, "timestamp": "00:07:10", "text": "我也喜欢飞。 好的。"}, {"type": "subtitle", "time": 434.07, "timestamp": "00:07:14", "text": "所以，我认为合作区域应该就在"}, {"type": "subtitle", "time": 437.749, "timestamp": "00:07:17", "text": "这家酒馆附近，或者可能就"}, {"type": "subtitle", "time": 440.15, "timestamp": "00:07:20", "text": "在……"}, {"type": "subtitle", "time": 443.43, "timestamp": "00:07:23", "text": "哦，我……"}, {"type": "subtitle", "time": 444.469, "timestamp": "00:07:24", "text": "[笑]"}, {"type": "subtitle", "time": 447.99, "timestamp": "00:07:27", "text": "我看到了……我看到了人……"}, {"type": "subtitle", "time": 459.27, "timestamp": "00:07:39", "text": "奇怪的是，我在这游戏里看不到延迟"}]
[{"type": "subtitle", "time": 20660.788, "timestamp": "05:44:20", "text": "我必须把它限制在60。这就是它运行"}, {"type": "subtitle", "time": 20663.03, "timestamp": "05:44:23", "text": "缓慢的原因。"}, {"type": "subtitle", "time": 20665.75, "timestamp": "05:44:25", "text": "好吧，我的融化情况不太好。"}, {"type": "subtitle", "time": 20675.67, "timestamp": "05:44:35", "text": "好的，现在是5点30分。 我现在应该睡着了"}, {"type": "subtitle", "time": 20678.868, "timestamp": "05:44:38", "text": "。 再过一个小时，我就会在6点半醒来"}, {"type": "subtitle", "time": 20680.542, "timestamp": "05:44:40", "text": "。"}, {"type": "subtitle", "time": 20681.19, "timestamp": "05:44:41", "text": "[嗤笑]"}, {"type": "subtitle", "time": 20684.628, "timestamp": "05:44:44", "text": "我觉得我今天"}, {"type": "subtitle", "time": 20690.868, "timestamp": "05:44:50", "text": "下课后会超级累，一个小时后下课就累死了。"}]
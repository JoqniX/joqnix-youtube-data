[{"type": "subtitle", "time": 2101.91, "timestamp": "00:35:01", "text": "更安全的生活。 但"}, {"type": "subtitle", "time": 2104.71, "timestamp": "00:35:04", "text": "我还是选择了那只富有同情心的厚脸皮乌鸦，我想是"}, {"type": "subtitle", "time": 2108.069, "timestamp": "00:35:08", "text": "因为她说她什么都没吃，"}, {"type": "subtitle", "time": 2110.79, "timestamp": "00:35:10", "text": "而且她靠接"}, {"type": "subtitle", "time": 2113.589, "timestamp": "00:35:13", "text": "委托和猎杀怪物为生。 所以我"}, {"type": "subtitle", "time": 2115.91, "timestamp": "00:35:15", "text": "觉得很内疚，"}, {"type": "subtitle", "time": 2118.47, "timestamp": "00:35:18", "text": "但同时也希望她平安无事。"}, {"type": "subtitle", "time": 2147.109, "timestamp": "00:35:47", "text": "我想知道会发生什么。 我的"}, {"type": "subtitle", "time": 2150.23, "timestamp": "00:35:50", "text": "意思是，这是一个动态任务，所以下次我会遇到"}, {"type": "subtitle", "time": 2152.15, "timestamp": "00:35:52", "text": "更多类似的任务。 我"}, {"type": "subtitle", "time": 2154.63, "timestamp": "00:35:54", "text": "不会那样做。 我不知道。 我想"}, {"type": "subtitle", "time": 2156.31, "timestamp": "00:35:56", "text": "知道接下来会"}]
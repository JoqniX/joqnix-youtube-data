[{"type": "subtitle", "time": 182.63, "timestamp": "00:03:02", "text": "我终于可以玩游戏了。   从那以后"}, {"type": "subtitle", "time": 184.55, "timestamp": "00:03:04", "text": "我就再也没碰过蓝色协议了，"}, {"type": "subtitle", "time": 189.50900000000001, "timestamp": "00:03:09", "text": "我感觉很愧疚，但没关系。"}, {"type": "subtitle", "time": 191.91, "timestamp": "00:03:11", "text": "但没关系。 另外，"}, {"type": "subtitle", "time": 194.07, "timestamp": "00:03:14", "text": "今天的直播时长最多只有 4 小时"}, {"type": "subtitle", "time": 196.47, "timestamp": "00:03:16", "text": "。 所以，我会像速通玩家一样快速通关，也就是先"}, {"type": "subtitle", "time": 199.11, "timestamp": "00:03:19", "text": "完成主线任务、支线"}, {"type": "subtitle", "time": 201.50900000000001, "timestamp": "00:03:21", "text": "任务和大部分任务，然后再去刷"}, {"type": "subtitle", "time": 203.27, "timestamp": "00:03:23", "text": "素材，因为我们需要"}, {"type": "subtitle", "time": 205.19, "timestamp": "00:03:25", "text": "解锁所有内容并完成"}, {"type": "subtitle", "time": 208.71, "timestamp": "00:03:28", "text": "所有进度。 是的，我们会"}, {"type": "subtitle", "time": 211.67000000000002, "timestamp": "00:03:31", "text": "这么做。 而且，"}, {"type": "subtitle", "time": 214.177, "timestamp": "00:03:34", "text": "呃，还有"}, {"type": "subtitle", "time": 217.75, "timestamp": "00:03:37", "text": "[嗤笑]我的日语课，呃，"}, {"type": "subtitle", "time": 219.82999999999998, "timestamp": "00:03:39", "text": "可能要改到"}, {"type": "subtitle", "time": 223.03, "timestamp": "00:03:43", "text": "下午5点了。 到7点半左右"}, {"type": "subtitle", "time": 225.75, "timestamp": "00:03:45", "text": "。 所以时间安排会有所调整。 所以"}, {"type": "subtitle", "time": 227.43, "timestamp": "00:03:47", "text": "这意味着我必须在凌晨 4 点"}, {"type": "subtitle", "time": 232.949, "timestamp": "00:03:52", "text": "或 3 点之前结束直播。也就是说，我"}, {"type": "subtitle", "time": 236.309, "timestamp": "00:03:56", "text": "今天只有三个小时或两个小时的直播时间。   是的"}, {"type": "subtitle", "time": 239.35, "timestamp": "00:03:59", "text": "，我以后会尽量早点到"}]
[{"type": "subtitle", "time": 5176.629, "timestamp": "01:26:16", "text": "什么来着？ 哦，对，你"}, {"type": "subtitle", "time": 5179.59, "timestamp": "01:26:19", "text": "必须做其中一项。 不，是在"}, {"type": "subtitle", "time": 5181.51, "timestamp": "01:26:21", "text": "把这件事做对之后"}, {"type": "subtitle", "time": 5191.43, "timestamp": "01:26:31", "text": "实际上，我也可能这样做。"}, {"type": "subtitle", "time": 5193.75, "timestamp": "01:26:33", "text": "说实话，我觉得我也需要尝试一下这种"}, {"type": "subtitle", "time": 5196.31, "timestamp": "01:26:36", "text": "无声（音乐）之吻。"}, {"type": "subtitle", "time": 5198.31, "timestamp": "01:26:38", "text": "我有395封"}, {"type": "subtitle", "time": 5205.59, "timestamp": "01:26:45", "text": "所以，除了兰迪之外，我想我已经把这里几乎所有人都叫来了"}, {"type": "subtitle", "time": 5209.43, "timestamp": "01:26:49", "text": "。 我想随着时间的推移，我们以后会"}, {"type": "subtitle", "time": 5213.35, "timestamp": "01:26:53", "text": "遇到这些男的、女的、男的"}]
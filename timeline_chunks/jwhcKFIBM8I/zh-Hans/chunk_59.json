[{"type": "subtitle", "time": 3543.91, "timestamp": "00:59:03", "text": "所以，呃，是"}, {"type": "subtitle", "time": 3553.109, "timestamp": "00:59:13", "text": "哦，我可以说“哦，"}, {"type": "subtitle", "time": 3555.51, "timestamp": "00:59:15", "text": "真好”。"}, {"type": "subtitle", "time": 3559.19, "timestamp": "00:59:19", "text": "所以，它和其他武器一样。 我可以把那张"}, {"type": "subtitle", "time": 3561.27, "timestamp": "00:59:21", "text": "皮放进去。"}, {"type": "subtitle", "time": 3592.309, "timestamp": "00:59:52", "text": "还有，我现在才意识到，"}, {"type": "subtitle", "time": 3593.91, "timestamp": "00:59:53", "text": "好像"}, {"type": "subtitle", "time": 3597.589, "timestamp": "00:59:57", "text": "有些角色有自己"}]
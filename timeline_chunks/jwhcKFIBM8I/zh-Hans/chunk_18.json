[{"type": "subtitle", "time": 1087.51, "timestamp": "00:18:07", "text": "松子更"}, {"type": "subtitle", "time": 1095.669, "timestamp": "00:18:15", "text": "如何获得史诗级稀有度的杰农？ 那个"}, {"type": "subtitle", "time": 1098.31, "timestamp": "00:18:18", "text": "看起来像"}, {"type": "subtitle", "time": 1102.23, "timestamp": "00:18:22", "text": "独角兽或丝袜的。 我想要那个。 我"}, {"type": "subtitle", "time": 1104.47, "timestamp": "00:18:24", "text": "觉得它更有力量，也更"}, {"type": "subtitle", "time": 1106.47, "timestamp": "00:18:26", "text": "稀有。"}]
[{"type": "subtitle", "time": 19094.788, "timestamp": "05:18:14", "text": "好的，我回来了。 对不起。"}, {"type": "subtitle", "time": 19097.11, "timestamp": "05:18:17", "text": "我花了多长时间？"}, {"type": "subtitle", "time": 19103.19, "timestamp": "05:18:23", "text": "回来了。 我喝了茶。 我回来了。 我想"}, {"type": "subtitle", "time": 19111.35, "timestamp": "05:18:31", "text": "我明天有考试。 我来这里放松一下。"}, {"type": "subtitle", "time": 19114.628, "timestamp": "05:18:34", "text": "不。你好。 然后放松。   祝你"}, {"type": "subtitle", "time": 19116.628, "timestamp": "05:18:36", "text": "明天考试顺利。 罗卡。"}, {"type": "subtitle", "time": 19118.39, "timestamp": "05:18:38", "text": "我不知道你是否还在。"}, {"type": "subtitle", "time": 19119.91, "timestamp": "05:18:39", "text": "萨布萨。"}]
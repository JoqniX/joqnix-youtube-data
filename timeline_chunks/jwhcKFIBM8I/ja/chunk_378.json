[{"type": "subtitle", "time": 22687.19, "timestamp": "06:18:07", "text": "下水道を隠れ家などを作る手段として利用していたということだ"}, {"type": "subtitle", "time": 22690.31, "timestamp": "06:18:10", "text": "。 そして、二人はどちらも"}, {"type": "subtitle", "time": 22692.708, "timestamp": "06:18:12", "text": "パフォーマンスが好きだったので、うまくいった。 彼らは"}, {"type": "subtitle", "time": 22695.43, "timestamp": "06:18:15", "text": "オペラみたいなものを作った。 オペラみたいなやつ。   ああ、なるほど、納得だ"}, {"type": "subtitle", "time": 22699.03, "timestamp": "06:18:19", "text": "。"}, {"type": "subtitle", "time": 22726.548, "timestamp": "06:18:46", "text": "彼は亡くなった。"}]
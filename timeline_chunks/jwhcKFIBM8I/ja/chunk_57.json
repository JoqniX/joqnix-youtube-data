[{"type": "subtitle", "time": 3423.99, "timestamp": "00:57:03", "text": "くそ。 よし、もう一度"}, {"type": "subtitle", "time": 3434.39, "timestamp": "00:57:14", "text": "えっと、もう1つ。"}, {"type": "subtitle", "time": 3459.19, "timestamp": "00:57:39", "text": "一体何が起こったんだ？"}, {"type": "subtitle", "time": 3462.309, "timestamp": "00:57:42", "text": "少なくとも良いスキンは手に入る。"}, {"type": "subtitle", "time": 3465.829, "timestamp": "00:57:45", "text": "えっと、私はこういうものにはロイヤルティシステムのようなものは持っていません"}, {"type": "subtitle", "time": 3469.75, "timestamp": "00:57:49", "text": "。  Kickにはまだロイヤリティプログラムみたいなものはないんです"}, {"type": "subtitle", "time": 3472.47, "timestamp": "00:57:52", "text": "。"}, {"type": "subtitle", "time": 3476.069, "timestamp": "00:57:56", "text": "ええ、そうですね。"}, {"type": "subtitle", "time": 3478.47, "timestamp": "00:57:58", "text": "さて、最後です。"}]
[{"type": "subtitle", "time": 306.629, "timestamp": "00:05:06", "text": "お湯と"}, {"type": "subtitle", "time": 308.87, "timestamp": "00:05:08", "text": "飲み水を持ってきてください。 皆さん、水分補給をしっかりしてくださいね。"}, {"type": "subtitle", "time": 311.909, "timestamp": "00:05:11", "text": "まだ水分補給をしていない方は、どうぞ"}, {"type": "subtitle", "time": 325.51, "timestamp": "00:05:25", "text": "。 だから、サイド"}, {"type": "subtitle", "time": 337.35, "timestamp": "00:05:37", "text": "共同利用エリア。 一部のエリアは協力プレイエリアとなっており、"}, {"type": "subtitle", "time": 338.87, "timestamp": "00:05:38", "text": "異なる"}, {"type": "subtitle", "time": 341.029, "timestamp": "00:05:41", "text": "時間軸から来たプレイヤーが参加する場合があります。 これらのエリアに入ると、"}, {"type": "subtitle", "time": 342.87, "timestamp": "00:05:42", "text": "自動的に協力プレイモードが有効になります。"}, {"type": "subtitle", "time": 346.15, "timestamp": "00:05:46", "text": "それらを放置すると、無効になります。"}, {"type": "subtitle", "time": 348.629, "timestamp": "00:05:48", "text": "設定で自動参加をオフにしてください。"}, {"type": "subtitle", "time": 351.43, "timestamp": "00:05:51", "text": "チームは友人を招待してチームを結成し、"}, {"type": "subtitle", "time": 354.23, "timestamp": "00:05:54", "text": "一緒に依頼を完了させることができます。 ああ、わかった。"}]
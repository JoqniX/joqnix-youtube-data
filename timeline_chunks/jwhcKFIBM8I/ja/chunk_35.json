[{"type": "subtitle", "time": 2101.91, "timestamp": "00:35:01", "text": "もっと安全に暮らせるようになっただろう。 でも、またしても"}, {"type": "subtitle", "time": 2104.71, "timestamp": "00:35:04", "text": "共感力のある分厚いカラスを選んだのは、"}, {"type": "subtitle", "time": 2108.069, "timestamp": "00:35:08", "text": "彼女が何も食べていないと言っていて、"}, {"type": "subtitle", "time": 2113.589, "timestamp": "00:35:13", "text": "依頼を受けて仕事をしたりモンスターを狩ったりして生計を立てているからだと思う。 だから、申し訳ない気持ちになった"}, {"type": "subtitle", "time": 2118.47, "timestamp": "00:35:18", "text": "けど、同時に彼女には安全でいてほしいとも思った。"}, {"type": "subtitle", "time": 2147.109, "timestamp": "00:35:47", "text": "どうなっていたのだろうか。"}, {"type": "subtitle", "time": 2150.23, "timestamp": "00:35:50", "text": "つまり、これは変化に富んだクエストなので、"}, {"type": "subtitle", "time": 2152.15, "timestamp": "00:35:52", "text": "次回もこのようなクエストをもっと受けたいですね。 それはしません"}, {"type": "subtitle", "time": 2154.63, "timestamp": "00:35:54", "text": "。 わからない。"}]
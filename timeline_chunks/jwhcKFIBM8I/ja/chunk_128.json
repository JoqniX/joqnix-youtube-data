[{"type": "subtitle", "time": 7724.069, "timestamp": "02:08:44", "text": "どういうことだ？ はぁ？ 待て、彼は"}, {"type": "subtitle", "time": 7725.75, "timestamp": "02:08:45", "text": "裏切り者だ。"}, {"type": "subtitle", "time": 7736.55, "timestamp": "02:08:56", "text": "私たちのようなカレンが"}, {"type": "subtitle", "time": 7739.27, "timestamp": "02:08:59", "text": "ハイパーやトランスに立ち向かわなくなった場所はどこ？ 私は我が異星人たちを"}]
[{"type": "subtitle", "time": 8506.23, "timestamp": "02:21:46", "text": "男は。 我々にはもう味方はいない。"}, {"type": "subtitle", "time": 8508.23, "timestamp": "02:21:48", "text": "この箱をもらってもいいですか？ わからない。"}, {"type": "subtitle", "time": 8514.79, "timestamp": "02:21:54", "text": "今はインタラクティブマップを使っていないので、それを受け取ります。 だから、"}, {"type": "subtitle", "time": 8517.349, "timestamp": "02:21:57", "text": "どの"}]
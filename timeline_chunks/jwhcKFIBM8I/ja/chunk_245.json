[{"type": "subtitle", "time": 14703.03, "timestamp": "04:05:03", "text": "。"}, {"type": "subtitle", "time": 14705.91, "timestamp": "04:05:05", "text": "それが私にとって最後のこの仕事だった。 そして"}, {"type": "subtitle", "time": 14727.429, "timestamp": "04:05:27", "text": "。 いや、私はこれで彼女を昇格させる必要がある"}, {"type": "subtitle", "time": 14729.91, "timestamp": "04:05:29", "text": "。"}, {"type": "subtitle", "time": 14732.79, "timestamp": "04:05:32", "text": "私もそうしたいです"}, {"type": "subtitle", "time": 14743.51, "timestamp": "04:05:43", "text": "えっと、私たちのクラスはレベル4です。"}]
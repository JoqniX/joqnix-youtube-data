[{"type": "subtitle", "time": 10201.67, "timestamp": "02:50:01", "text": "このゲームは良い意味でぶっ飛んでる。"}, {"type": "subtitle", "time": 10226.23, "timestamp": "02:50:26", "text": "ええ、彼女が取引したんです。"}, {"type": "subtitle", "time": 10244.389, "timestamp": "02:50:44", "text": "裏切り者。 彼はクロニックだ。 おそらく彼は"}, {"type": "subtitle", "time": 10249.11, "timestamp": "02:50:49", "text": "私の頭痛の原因だったのでしょう。 帝国の裏切り者は、"}, {"type": "subtitle", "time": 10254.79, "timestamp": "02:50:54", "text": "裏切り者の首に反対した。   ああ"}]
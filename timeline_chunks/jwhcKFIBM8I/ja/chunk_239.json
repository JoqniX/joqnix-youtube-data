[{"type": "subtitle", "time": 14375.59, "timestamp": "03:59:35", "text": "それでは、"}, {"type": "subtitle", "time": 14377.349, "timestamp": "03:59:37", "text": "敵全員のところまでスキップしましょう。"}, {"type": "subtitle", "time": 14379.67, "timestamp": "03:59:39", "text": "それでいい。"}, {"type": "subtitle", "time": 14388.95, "timestamp": "03:59:48", "text": "ああ、俺は運が悪いんだよ、"}, {"type": "subtitle", "time": 14391.189, "timestamp": "03:59:51", "text": "兄弟。 私は運が悪い。   あの時、あの"}, {"type": "subtitle", "time": 14393.11, "timestamp": "03:59:53", "text": "バカげた刃物を持って行っておけばよかった"}]
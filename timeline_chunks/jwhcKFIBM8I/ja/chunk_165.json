[{"type": "subtitle", "time": 9901.51, "timestamp": "02:45:01", "text": "乾杯、ダーリン。 パス設定についてはこちらです。"}, {"type": "subtitle", "time": 9903.99, "timestamp": "02:45:03", "text": "よくやった、友よ。"}, {"type": "subtitle", "time": 9908.15, "timestamp": "02:45:08", "text": "これは何ですか？ まったくその通りだ。"}, {"type": "subtitle", "time": 9953.429, "timestamp": "02:45:53", "text": "私が耳を傾けなかった場所。 好きにやってくれ。"}]
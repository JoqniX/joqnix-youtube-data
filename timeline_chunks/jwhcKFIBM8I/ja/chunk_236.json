[{"type": "subtitle", "time": 14172.469, "timestamp": "03:56:12", "text": "[鼻を鳴らす]"}, {"type": "subtitle", "time": 14175.51, "timestamp": "03:56:15", "text": "錬金術師。 ああ、"}, {"type": "subtitle", "time": 14178.79, "timestamp": "03:56:18", "text": "パトロールドローンだ。 完全に"}, {"type": "subtitle", "time": 14198.79, "timestamp": "03:56:38", "text": "よし、行こう。"}, {"type": "subtitle", "time": 14208.95, "timestamp": "03:56:48", "text": "刃物を私に渡してください。"}, {"type": "subtitle", "time": 14211.83, "timestamp": "03:56:51", "text": "私は運が悪い。"}]
[{"type": "subtitle", "time": 1087.51, "timestamp": "00:18:07", "text": "松の実が"}, {"type": "subtitle", "time": 1095.669, "timestamp": "00:18:15", "text": "エピックレアリティのジェノンはどうすれば入手できますか？"}, {"type": "subtitle", "time": 1102.23, "timestamp": "00:18:22", "text": "ユニコーンかストッキングのように見えるもの。 私はそれを手に入れたい。 そっちの方が、"}, {"type": "subtitle", "time": 1104.47, "timestamp": "00:18:24", "text": "より力強く、より"}, {"type": "subtitle", "time": 1106.47, "timestamp": "00:18:26", "text": "希少な感じがする。"}, {"type": "subtitle", "time": 1108.95, "timestamp": "00:18:28", "text": "クリティカルダメージと攻撃速度を上昇させる効果だと"}]
[{"type": "subtitle", "time": 21823.03, "timestamp": "06:03:43", "text": "何？"}, {"type": "subtitle", "time": 21825.67, "timestamp": "06:03:45", "text": "一体全体、下に行くってどういうことなんだよ"}, {"type": "subtitle", "time": 21836.708, "timestamp": "06:03:56", "text": "私がダイヤモンドだと思っていたものは、"}, {"type": "subtitle", "time": 21839.51, "timestamp": "06:03:59", "text": "ダイヤモンドではなくガラスだった。"}]
[{"type": "subtitle", "time": 8410.23, "timestamp": "02:20:10", "text": "これが欲しい。 どうすれば"}, {"type": "subtitle", "time": 8421.99, "timestamp": "02:20:21", "text": "何か？ 口ひげを追加できます。"}, {"type": "subtitle", "time": 8435.67, "timestamp": "02:20:35", "text": "これは一体何ですか？ これは野生のように見える。 何てことだ"}, {"type": "subtitle", "time": 8438.87, "timestamp": "02:20:38", "text": "。"}, {"type": "subtitle", "time": 8445.51, "timestamp": "02:20:45", "text": "何か環境に優しいものが必要だと思う。 でも、私はそれを持っていません"}, {"type": "subtitle", "time": 8448.15, "timestamp": "02:20:48", "text": "。 でも、これは本当に"}]
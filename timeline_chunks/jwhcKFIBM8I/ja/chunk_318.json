[{"type": "subtitle", "time": 19094.788, "timestamp": "05:18:14", "text": "大丈夫、戻ってきたよ。 ごめん。"}, {"type": "subtitle", "time": 19097.11, "timestamp": "05:18:17", "text": "どれくらい時間がかかりましたか？"}, {"type": "subtitle", "time": 19103.19, "timestamp": "05:18:23", "text": "。 私はお茶を飲んだ。 戻ってきました。 私は階段を駆け上がったと思う"}, {"type": "subtitle", "time": 19111.35, "timestamp": "05:18:31", "text": "明日試験があります。 リラックスしに来ました。"}, {"type": "subtitle", "time": 19114.628, "timestamp": "05:18:34", "text": "いいえ。こんにちは。 さあ、リラックスしましょう。"}, {"type": "subtitle", "time": 19116.628, "timestamp": "05:18:36", "text": "明日の試験、頑張ってくださいね。 ロッカ。"}, {"type": "subtitle", "time": 19118.39, "timestamp": "05:18:38", "text": "あなたがまだここにいるかどうかわかりません。"}, {"type": "subtitle", "time": 19119.91, "timestamp": "05:18:39", "text": "サプサ。   そうそう"}]
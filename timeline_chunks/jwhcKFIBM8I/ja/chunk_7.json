[{"type": "subtitle", "time": 430.95, "timestamp": "00:07:10", "text": "私も飛ぶのが好きです。 わかった。"}, {"type": "subtitle", "time": 434.07, "timestamp": "00:07:14", "text": "だから、協力エリアは"}, {"type": "subtitle", "time": 437.749, "timestamp": "00:07:17", "text": "この酒場の近くにあると思う、もしくは恐らくは、"}, {"type": "subtitle", "time": 443.43, "timestamp": "00:07:23", "text": "ああ、私は"}, {"type": "subtitle", "time": 444.469, "timestamp": "00:07:24", "text": "[笑い]"}, {"type": "subtitle", "time": 447.99, "timestamp": "00:07:27", "text": "人が見える、"}, {"type": "subtitle", "time": 459.27, "timestamp": "00:07:39", "text": "このゲームでピングが見えないのは奇妙だ"}]
[{"type": "subtitle", "time": 20660.788, "timestamp": "05:44:20", "text": "60に設定しておかなければならなかったんです。だから動作が"}, {"type": "subtitle", "time": 20663.03, "timestamp": "05:44:23", "text": "遅くなっているんです。"}, {"type": "subtitle", "time": 20665.75, "timestamp": "05:44:25", "text": "うーん、私のメルトは今、うまくいってないみたい。   わかった"}, {"type": "subtitle", "time": 20675.67, "timestamp": "05:44:35", "text": "はい、今は5時30分です。 もう寝ている時間であるはずだ"}, {"type": "subtitle", "time": 20678.868, "timestamp": "05:44:38", "text": "。 私はあと1時間で6時半には起きていただろう"}, {"type": "subtitle", "time": 20680.542, "timestamp": "05:44:40", "text": "。"}, {"type": "subtitle", "time": 20681.19, "timestamp": "05:44:41", "text": "[鼻を鳴らす]"}, {"type": "subtitle", "time": 20684.628, "timestamp": "05:44:44", "text": "今日は"}, {"type": "subtitle", "time": 20687.67, "timestamp": "05:44:47", "text": "すごく疲れると思う。あと"}, {"type": "subtitle", "time": 20690.868, "timestamp": "05:44:50", "text": "1時間で授業が終わるんだけど、中がぐったりすると思う。一体"}]
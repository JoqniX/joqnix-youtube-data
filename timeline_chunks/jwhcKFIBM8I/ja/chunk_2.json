[{"type": "subtitle", "time": 151.82999999999998, "timestamp": "00:02:31", "text": "みなさん、こんにちは。 みなさん"}, {"type": "subtitle", "time": 153.50900000000001, "timestamp": "00:02:33", "text": "、お元気ですか"}, {"type": "subtitle", "time": 155.03, "timestamp": "00:02:35", "text": "？ こんにちは、こんにちは、"}, {"type": "subtitle", "time": 158.22899999999998, "timestamp": "00:02:38", "text": "こんにちは。"}, {"type": "subtitle", "time": 160.39, "timestamp": "00:02:40", "text": "配信開始が遅れてしまい、大変申し訳ありません。"}, {"type": "subtitle", "time": 165.27, "timestamp": "00:02:45", "text": "このゲームが"}, {"type": "subtitle", "time": 167.27, "timestamp": "00:02:47", "text": "ラグやバッファリングを止めてなくなるまで、私は待って待って待っていました。"}, {"type": "subtitle", "time": 171.11, "timestamp": "00:02:51", "text": "サーバーに問題が発生したり、いろいろと問題がありました。"}, {"type": "subtitle", "time": 176.186, "timestamp": "00:02:56", "text": "ああ、でも、やっとプレイできるようになったよ。"}, {"type": "subtitle", "time": 179.11, "timestamp": "00:02:59", "text": "[鼻を鳴らす] やっとやっと"}]
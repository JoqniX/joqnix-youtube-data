[{"type": "subtitle", "time": 5176.629, "timestamp": "01:26:16", "text": "何から来てたんだっけ？ ああ、このうちのどれかをやらなきゃいけないよ"}, {"type": "subtitle", "time": 5179.59, "timestamp": "01:26:19", "text": "。 いいえ、これを正しく理解した後、これを"}, {"type": "subtitle", "time": 5191.43, "timestamp": "01:26:31", "text": "実際、私もそうするかもしれません。"}, {"type": "subtitle", "time": 5193.75, "timestamp": "01:26:33", "text": "正直言って、私もこの"}, {"type": "subtitle", "time": 5196.31, "timestamp": "01:26:36", "text": "沈黙（音楽）キスをやってみるべきだと思う。"}, {"type": "subtitle", "time": 5198.31, "timestamp": "01:26:38", "text": "私は395通の"}, {"type": "subtitle", "time": 5209.43, "timestamp": "01:26:49", "text": "ランディ以外はほぼ全員写っていると思います。 そうすれば、"}]
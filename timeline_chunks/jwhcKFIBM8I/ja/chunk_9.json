[{"type": "subtitle", "time": 542.949, "timestamp": "00:09:02", "text": "このゲームにある2人の主人公（デュアルMC）のうち、2番目の主人公として、私は人間の男性を選びました。 わからない。"}, {"type": "subtitle", "time": 545.269, "timestamp": "00:09:05", "text": "正直に言うと、"}, {"type": "subtitle", "time": 550.31, "timestamp": "00:09:10", "text": "新しいアカウントを作って"}, {"type": "subtitle", "time": 554.23, "timestamp": "00:09:14", "text": "アジアアカウントかSCAでやり直したいとさえ思っています。というのも、"}, {"type": "subtitle", "time": 561.19, "timestamp": "00:09:21", "text": "女性の人間とMCが欲しいと思うからです。"}, {"type": "subtitle", "time": 571.35, "timestamp": "00:09:31", "text": "というのも、Withering Wavesや他のgotaゲームではいつも女性のMCを選んでいましたが、"}, {"type": "subtitle", "time": 573.99, "timestamp": "00:09:33", "text": "変化が欲しかったのです。 でも、私にはわからない。"}, {"type": "subtitle", "time": 579.19, "timestamp": "00:09:39", "text": "最近、妙な考えが頭をよぎるんです。"}, {"type": "subtitle", "time": 583.03, "timestamp": "00:09:43", "text": "変な考えが浮かんだ。"}, {"type": "subtitle", "time": 586.23, "timestamp": "00:09:46", "text": "うん、多分ね。 ええ"}, {"type": "subtitle", "time": 588.55, "timestamp": "00:09:48", "text": "、変更するかもしれません。 わからない。 このままにしておきます"}, {"type": "subtitle", "time": 590.949, "timestamp": "00:09:50", "text": "。  [笑い] わから"}]
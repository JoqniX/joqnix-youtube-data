[{"type": "subtitle", "time": 7741.03, "timestamp": "02:09:01", "text": "フォーセイクンに忠誠を誓う。 帝国は"}, {"type": "subtitle", "time": 7742.95, "timestamp": "02:09:02", "text": "彼の行動に対して責任を負わなければならない。 私たちの"}, {"type": "subtitle", "time": 7756.229, "timestamp": "02:09:16", "text": "その日の計画を待っていて、カティアは、"}, {"type": "subtitle", "time": 7758.87, "timestamp": "02:09:18", "text": "ああ、それは彼女の"}, {"type": "subtitle", "time": 7761.03, "timestamp": "02:09:21", "text": "2番目の文書"}]
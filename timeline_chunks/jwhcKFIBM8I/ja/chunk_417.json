[{"type": "subtitle", "time": 25022.468, "timestamp": "06:57:02", "text": "よし、今日はこれで終わりにしようと思う"}, {"type": "subtitle", "time": 25030.548, "timestamp": "06:57:10", "text": "。"}, {"type": "subtitle", "time": 25038.07, "timestamp": "06:57:18", "text": "本日はマイアミの「デットナイトアビス」に同行していただき、ありがとうございました。"}, {"type": "subtitle", "time": 25040.788, "timestamp": "06:57:20", "text": "私たちは約7"}, {"type": "subtitle", "time": 25042.548, "timestamp": "06:57:22", "text": "時間ほど配信を続けています。"}, {"type": "subtitle", "time": 25045.35, "timestamp": "06:57:25", "text": "配信を終了する頃には7時になっているでしょう。 今日は楽しかった。"}, {"type": "subtitle", "time": 25047.11, "timestamp": "06:57:27", "text": "物語も全て完結しました。"}, {"type": "subtitle", "time": 25049.83, "timestamp": "06:57:29", "text": "今日は2日目だった。"}, {"type": "subtitle", "time": 25051.99, "timestamp": "06:57:31", "text": "ほとんどのことを終えられてよかった。 残りの"}, {"type": "subtitle", "time": 25053.67, "timestamp": "06:57:33", "text": "こと、例えば全てのキャラクターを入手して最大レベルまで上げるとか"}, {"type": "subtitle", "time": 25056.628, "timestamp": "06:57:36", "text": "、あれこれとかは、おそらく、"}, {"type": "subtitle", "time": 25062.548, "timestamp": "06:57:42", "text": "ええ、明らかに、"}, {"type": "subtitle", "time": 25065.83, "timestamp": "06:57:45", "text": "アイテムをファームしたり、その他諸々のことになるでしょうね。"}, {"type": "subtitle", "time": 25067.91, "timestamp": "06:57:47", "text": "それは"}, {"type": "subtitle", "time": 25069.91, "timestamp": "06:57:49", "text": "明日の配信とか、後でやればいいんじゃない？ まだ"}, {"type": "subtitle", "time": 25073.35, "timestamp": "06:57:53", "text": "枯れなければならない。   えっと、まだ"}, {"type": "subtitle", "time": 25077.27, "timestamp": "06:57:57", "text": "ブループロトコルをやらなきゃいけないんです。"}, {"type": "subtitle", "time": 25079.67, "timestamp": "06:57:59", "text": "ええ、今夜"}]
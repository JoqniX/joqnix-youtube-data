[{"type": "subtitle", "time": 932.31, "timestamp": "00:15:32", "text": "好吧，[笑]"}, {"type": "subtitle", "time": 934.79, "timestamp": "00:15:34", "text": "垂直運動確實有點"}, {"type": "subtitle", "time": 937.189, "timestamp": "00:15:37", "text": "痛苦。我覺得洶湧的波濤把"}, {"type": "subtitle", "time": 940.87, "timestamp": "00:15:40", "text": "我慣壞了，它們在奔跑中展現出的雜技般的動作讓我難以招架"}]
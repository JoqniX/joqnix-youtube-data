[{"type": "subtitle", "time": 7102.39, "timestamp": "01:58:22", "text": "所以，她是個叛徒。"}, {"type": "subtitle", "time": 7120.709, "timestamp": "01:58:40", "text": "夥計，"}, {"type": "subtitle", "time": 7124.229, "timestamp": "01:58:44", "text": "卡，為什麼？順便說一句，我很喜歡你的穿著打扮"}, {"type": "subtitle", "time": 7125.91, "timestamp": "01:58:45", "text": "。"}, {"type": "subtitle", "time": 7130.55, "timestamp": "01:58:50", "text": "雙馬尾女士。我覺得她可以上場。"}, {"type": "subtitle", "time": 7133.51, "timestamp": "01:58:53", "text": "我想"}, {"type": "subtitle", "time": 7137.27, "timestamp": "01:58:57", "text": "她覺得自己還是個可以上場的角色。"}]
[{"type": "subtitle", "time": 182.63, "timestamp": "00:03:02", "text": "我終於可以玩遊戲了。  從那以後"}, {"type": "subtitle", "time": 184.55, "timestamp": "00:03:04", "text": "我就再也沒碰過藍色協議了，"}, {"type": "subtitle", "time": 189.50900000000001, "timestamp": "00:03:09", "text": "我覺得很愧疚，但沒關係。"}, {"type": "subtitle", "time": 191.91, "timestamp": "00:03:11", "text": "但沒關係。另外，"}, {"type": "subtitle", "time": 194.07, "timestamp": "00:03:14", "text": "今天的直播時間最多只有 4 小時"}, {"type": "subtitle", "time": 196.47, "timestamp": "00:03:16", "text": "。所以，我會像"}, {"type": "subtitle", "time": 199.11, "timestamp": "00:03:19", "text": "速通玩家一樣快速通關，也就是先完成主線任務、支線任務和"}, {"type": "subtitle", "time": 201.50900000000001, "timestamp": "00:03:21", "text": "大部分任務，然後再去刷素材，"}, {"type": "subtitle", "time": 203.27, "timestamp": "00:03:23", "text": "因為我們需要"}, {"type": "subtitle", "time": 205.19, "timestamp": "00:03:25", "text": "解鎖所有內容並完成"}, {"type": "subtitle", "time": 208.71, "timestamp": "00:03:28", "text": "所有進度。是的，我們會"}, {"type": "subtitle", "time": 211.67000000000002, "timestamp": "00:03:31", "text": "這麼做。而且，"}, {"type": "subtitle", "time": 214.177, "timestamp": "00:03:34", "text": "呃，還有"}, {"type": "subtitle", "time": 217.75, "timestamp": "00:03:37", "text": "[嗤笑]我的日文課，呃，"}, {"type": "subtitle", "time": 219.82999999999998, "timestamp": "00:03:39", "text": "可能要改到"}, {"type": "subtitle", "time": 223.03, "timestamp": "00:03:43", "text": "下午5點了。到7點半左右"}, {"type": "subtitle", "time": 225.75, "timestamp": "00:03:45", "text": "。所以時間安排會有所調整。所以"}, {"type": "subtitle", "time": 227.43, "timestamp": "00:03:47", "text": "這意味著我必須在凌晨 4 點"}, {"type": "subtitle", "time": 232.949, "timestamp": "00:03:52", "text": "或 3 點之前結束直播。也就是說，我"}, {"type": "subtitle", "time": 236.309, "timestamp": "00:03:56", "text": "今天只有三小時或兩小時的直播時間。"}, {"type": "subtitle", "time": 239.35, "timestamp": "00:03:59", "text": "是的，我"}]
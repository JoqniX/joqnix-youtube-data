[{"type": "subtitle", "time": 430.95, "timestamp": "00:07:10", "text": "我也喜歡飛。好的。"}, {"type": "subtitle", "time": 434.07, "timestamp": "00:07:14", "text": "所以，我認為合作區域應該就在"}, {"type": "subtitle", "time": 437.749, "timestamp": "00:07:17", "text": "這家酒館附近，或者可能就在……"}, {"type": "subtitle", "time": 443.43, "timestamp": "00:07:23", "text": "哦，我……"}, {"type": "subtitle", "time": 444.469, "timestamp": "00:07:24", "text": "[笑]我"}, {"type": "subtitle", "time": 447.99, "timestamp": "00:07:27", "text": "看到了……我看到了人……"}, {"type": "subtitle", "time": 459.27, "timestamp": "00:07:39", "text": "奇怪的是，我在這遊戲裡看不到延遲"}]
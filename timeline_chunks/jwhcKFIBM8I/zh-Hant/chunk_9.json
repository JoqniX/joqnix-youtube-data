[{"type": "subtitle", "time": 542.949, "timestamp": "00:09:02", "text": "。我不知道。"}, {"type": "subtitle", "time": 545.269, "timestamp": "00:09:05", "text": "說實話，我一直在猶豫不決，甚至"}, {"type": "subtitle", "time": 550.31, "timestamp": "00:09:10", "text": "想創建一個新帳號，"}, {"type": "subtitle", "time": 554.23, "timestamp": "00:09:14", "text": "在亞洲伺服器或SCA伺服器上重新開始，"}, {"type": "subtitle", "time": 556.71, "timestamp": "00:09:16", "text": "因為我覺得啊，我真的很想扮演"}, {"type": "subtitle", "time": 561.19, "timestamp": "00:09:21", "text": "一個女性人類主角，因為，嗯，我"}, {"type": "subtitle", "time": 564.389, "timestamp": "00:09:24", "text": "不知道，但我"}, {"type": "subtitle", "time": 568.55, "timestamp": "00:09:28", "text": "在《枯萎之浪》或其他GOTA"}, {"type": "subtitle", "time": 571.35, "timestamp": "00:09:31", "text": "遊戲中總是選擇女性主角，對吧？但我不知道，我就是想"}, {"type": "subtitle", "time": 573.99, "timestamp": "00:09:33", "text": "換個玩法。但我不知道。我"}, {"type": "subtitle", "time": 579.19, "timestamp": "00:09:39", "text": "最近腦子裡一直有個奇怪的想法。  突然"}, {"type": "subtitle", "time": 583.03, "timestamp": "00:09:43", "text": "冒出一個奇怪的想法："}, {"type": "subtitle", "time": 586.23, "timestamp": "00:09:46", "text": "嗯，可能吧。嗯，是的"}, {"type": "subtitle", "time": 588.55, "timestamp": "00:09:48", "text": "，我可能會換。我不知道。我會"}, {"type": "subtitle", "time": 590.949, "timestamp": "00:09:50", "text": "維持現狀。 [笑聲]"}]
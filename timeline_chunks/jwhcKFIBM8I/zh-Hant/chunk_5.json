[{"type": "subtitle", "time": 306.629, "timestamp": "00:05:06", "text": "讓我去拿熱水和"}, {"type": "subtitle", "time": 308.87, "timestamp": "00:05:08", "text": "飲用水。大家要多喝水。如果你"}, {"type": "subtitle", "time": 311.909, "timestamp": "00:05:11", "text": "還沒補充水分，請盡快補充"}, {"type": "subtitle", "time": 325.51, "timestamp": "00:05:25", "text": "好的。所以，我們需要完成這個支線"}, {"type": "subtitle", "time": 337.35, "timestamp": "00:05:37", "text": "合作區域。有些區域是合作區域，"}, {"type": "subtitle", "time": 338.87, "timestamp": "00:05:38", "text": "你可能會來自不同的"}, {"type": "subtitle", "time": 341.029, "timestamp": "00:05:41", "text": "時間軸。進入這些區域會"}, {"type": "subtitle", "time": 342.87, "timestamp": "00:05:42", "text": "自動啟用合作模式。"}, {"type": "subtitle", "time": 346.15, "timestamp": "00:05:46", "text": "離開它們會停用此功能。"}, {"type": "subtitle", "time": 348.629, "timestamp": "00:05:48", "text": "在設定中關閉自動加入功能。"}, {"type": "subtitle", "time": 351.43, "timestamp": "00:05:51", "text": "團隊可以邀請好友組隊，"}, {"type": "subtitle", "time": 354.23, "timestamp": "00:05:54", "text": "共同完成委託。嗯，明白了。"}]
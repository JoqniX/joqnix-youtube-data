[{"type": "subtitle", "time": 241.35, "timestamp": "00:04:01", "text": "以後會盡量早點到。是的。你好。我們切換"}, {"type": "subtitle", "time": 244.71, "timestamp": "00:04:04", "text": "到遊戲模式開始玩吧。"}, {"type": "subtitle", "time": 248.63, "timestamp": "00:04:08", "text": "我確實收集了第二天的東西。"}, {"type": "subtitle", "time": 253.35, "timestamp": "00:04:13", "text": "我們和我們可愛的麗貝卡在一起。我還把"}, {"type": "subtitle", "time": 255.83, "timestamp": "00:04:15", "text": "語言改成了日文。所以對"}, {"type": "subtitle", "time": 261.99, "timestamp": "00:04:21", "text": "我來說，它更像是一種日語式的情感表達。這將有助於我"}, {"type": "subtitle", "time": 265.27, "timestamp": "00:04:25", "text": "理解這一點。所以我改用"}, {"type": "subtitle", "time": 269.67, "timestamp": "00:04:29", "text": "日文了。你好。你好，FI。"}, {"type": "subtitle", "time": 275.03, "timestamp": "00:04:35", "text": "[清喉嚨] 是的。  就是"}, {"type": "subtitle", "time": 280.469, "timestamp": "00:04:40", "text": "這樣。"}, {"type": "subtitle", "time": 283.83, "timestamp": "00:04:43", "text": "希望你能聽到比賽的聲音，對吧？  好的"}, {"type": "subtitle", "time": 298.23, "timestamp": "00:04:58", "text": "。好了，我們走吧。  我們走吧"}]
[{"type": "subtitle", "time": 1381.19, "timestamp": "00:23:01", "text": "我会大声喊你，大声喊你"}, {"type": "subtitle", "time": 1384.789, "timestamp": "00:23:04", "text": "直播，谢谢，谢谢。"}, {"type": "subtitle", "time": 1386.39, "timestamp": "00:23:06", "text": "具体来说"}, {"type": "subtitle", "time": 1389.99, "timestamp": "00:23:09", "text": "呃，为了成为会员等等。"}, {"type": "subtitle", "time": 1394.149, "timestamp": "00:23:14", "text": "我很久以前就做过这件事。呃，我"}, {"type": "subtitle", "time": 1396.31, "timestamp": "00:23:16", "text": "很久以前就这么做了，每"}, {"type": "subtitle", "time": 1399.51, "timestamp": "00:23:19", "text": "出现在我直播中的单身人士"}, {"type": "subtitle", "time": 1401.51, "timestamp": "00:23:21", "text": "就像在我的直播间里聊天一样。我一直都用"}, {"type": "subtitle", "time": 1404.39, "timestamp": "00:23:24", "text": "即使他们……也要感谢他们每一个人"}, {"type": "subtitle", "time": 1407.11, "timestamp": "00:23:27", "text": "直播中没有出现。"}, {"type": "subtitle", "time": 1409.669, "timestamp": "00:23:29", "text": "嗯，在直播的最后……"}, {"type": "subtitle", "time": 1411.909, "timestamp": "00:23:31", "text": "在直播结束前，我总是"}, {"type": "subtitle", "time": 1414.51, "timestamp": "00:23:34", "text": "花点时间，比如一小时或半小时"}, {"type": "subtitle", "time": 1417.75, "timestamp": "00:23:37", "text": "或者五到十分钟，你会喜欢我。"}, {"type": "subtitle", "time": 1419.83, "timestamp": "00:23:39", "text": "知道要列出一小份人名清单。"}, {"type": "subtitle", "time": 1422.35, "timestamp": "00:23:42", "text": "感谢所有前来参加的人们"}, {"type": "subtitle", "time": 1425.19, "timestamp": "00:23:45", "text": "我们会感谢他们，就像他们一样。"}, {"type": "subtitle", "time": 1426.63, "timestamp": "00:23:46", "text": "最后所有成员"}, {"type": "subtitle", "time": 1429.59, "timestamp": "00:23:49", "text": "直播以及现场直播"}, {"type": "subtitle", "time": 1433.75, "timestamp": "00:23:53", "text": "当你成为会员时，你也会获得同样的权益。是的。"}, {"type": "subtitle", "time": 1435.789, "timestamp": "00:23:55", "text": "和"}, {"type": "subtitle", "time": 1439.83, "timestamp": "00:23:59", "text": "呃，我的意思是，如果我在做的话，我觉得我可以做到。"}]
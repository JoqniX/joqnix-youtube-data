[{"type": "subtitle", "time": 16380.429, "timestamp": "04:33:00", "text": "[音乐]"}, {"type": "subtitle", "time": 16381.95, "timestamp": "04:33:01", "text": "男人。"}, {"type": "subtitle", "time": 16384.349, "timestamp": "04:33:04", "text": "哦，盛开的芦荟"}, {"type": "subtitle", "time": 16386.429, "timestamp": "04:33:06", "text": "维拉。"}, {"type": "subtitle", "time": 16390.949, "timestamp": "04:33:10", "text": "刺猬花（Pricklyia catus）。意思是鱼。哦，是的。"}, {"type": "subtitle", "time": 16393.83, "timestamp": "04:33:13", "text": "Machi在印地语中是鱼的意思。我忘了。"}, {"type": "subtitle", "time": 16396.949, "timestamp": "04:33:16", "text": "是的。是的。是的。是的。"}, {"type": "subtitle", "time": 16399.789, "timestamp": "04:33:19", "text": "我当时就想，等等，这是什么？"}, {"type": "subtitle", "time": 16403.789, "timestamp": "04:33:23", "text": "这？奥地利崛起。"}, {"type": "subtitle", "time": 16406.029, "timestamp": "04:33:26", "text": "好的。是什么"}, {"type": "subtitle", "time": 16408.109, "timestamp": "04:33:28", "text": "这？"}, {"type": "subtitle", "time": 16412.789, "timestamp": "04:33:32", "text": "海拉。绣球花灌木。那可真不少"}, {"type": "subtitle", "time": 16416.949, "timestamp": "04:33:36", "text": "颜色。好的。罂粟。丹吉利安。"}, {"type": "subtitle", "time": 16420.709, "timestamp": "04:33:40", "text": "老兄，我喜欢看到新的。"}, {"type": "subtitle", "time": 16427.91, "timestamp": "04:33:47", "text": "呃，一些全新的事物。是的。哦，"}, {"type": "subtitle", "time": 16429.789, "timestamp": "04:33:49", "text": "这是一朵玫瑰"}]
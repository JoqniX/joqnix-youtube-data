[{"type": "subtitle", "time": 21481.91, "timestamp": "05:58:01", "text": "东西。我通常在所有情况下都这样做"}, {"type": "subtitle", "time": 21484.75, "timestamp": "05:58:04", "text": "中小企业。我刚才说的是像杀戮一样"}, {"type": "subtitle", "time": 21488.948, "timestamp": "05:58:08", "text": "东西，但不是像其他东西那样的 PvP。"}, {"type": "subtitle", "time": 21491.91, "timestamp": "05:58:11", "text": "PvE击杀。我的意思是，我不想做。"}, {"type": "subtitle", "time": 21494.628, "timestamp": "05:58:14", "text": "那。我只想安定下来，呃……"}, {"type": "subtitle", "time": 21499.15, "timestamp": "05:58:19", "text": "我也想为自己创作一些东西，你"}, {"type": "subtitle", "time": 21504.51, "timestamp": "05:58:24", "text": "知道。我的樱桃船在哪儿？在哪里？"}, {"type": "subtitle", "time": 21519.03, "timestamp": "05:58:39", "text": "帮助。哦，也许吧。你的目标是什么？但"}, {"type": "subtitle", "time": 21522.43, "timestamp": "05:58:42", "text": "我目前的目标是"}, {"type": "subtitle", "time": 21526.15, "timestamp": "05:58:46", "text": "呃，我目前的目标是真正得到我的"}, {"type": "subtitle", "time": 21530.23, "timestamp": "05:58:50", "text": "我所有死的东西，我的东西都在这里，还有"}, {"type": "subtitle", "time": 21533.708, "timestamp": "05:58:53", "text": "在某个生物群落或地方定居下来"}, {"type": "subtitle", "time": 21537.75, "timestamp": "05:58:57", "text": "里面有一些木头和其他东西"}, {"type": "subtitle", "time": 21539.99, "timestamp": "05:58:59", "text": "就是这个区域。我或许会安定下来"}]
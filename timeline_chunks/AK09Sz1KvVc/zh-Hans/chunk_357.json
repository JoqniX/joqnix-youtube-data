[{"type": "subtitle", "time": 21421.51, "timestamp": "05:57:01", "text": "花朵盛开，在花丛中筑巢。所以，我是"}, {"type": "subtitle", "time": 21424.548, "timestamp": "05:57:04", "text": "就像找到一个我可以得到……的地方"}, {"type": "subtitle", "time": 21426.75, "timestamp": "05:57:06", "text": "很多木材，而且"}, {"type": "subtitle", "time": 21430.51, "timestamp": "05:57:10", "text": "不太像"}, {"type": "subtitle", "time": 21433.35, "timestamp": "05:57:13", "text": "靠近。他站不住"}, {"type": "subtitle", "time": 21435.75, "timestamp": "05:57:15", "text": "各位，这是下界。哦，是的。我将前往"}, {"type": "subtitle", "time": 21442.708, "timestamp": "05:57:22", "text": "为什么？我仍然需要拿回我以前的我的呃我的"}, {"type": "subtitle", "time": 21446.548, "timestamp": "05:57:26", "text": "这里全是铁，但我死了。我 我"}, {"type": "subtitle", "time": 21448.39, "timestamp": "05:57:28", "text": "我的铁镐和剑都丢了。"}, {"type": "subtitle", "time": 21449.97, "timestamp": "05:57:29", "text": "东西。"}, {"type": "subtitle", "time": 21451.19, "timestamp": "05:57:31", "text": "[音乐]"}, {"type": "subtitle", "time": 21453.59, "timestamp": "05:57:33", "text": "Neco猫去哪儿了？他是"}, {"type": "subtitle", "time": 21457.47, "timestamp": "05:57:37", "text": "睡眠。是的，Neco Neo骑师去了"}, {"type": "subtitle", "time": 21461.19, "timestamp": "05:57:41", "text": "扫。我们让这个人想象一个"}, {"type": "subtitle", "time": 21465.27, "timestamp": "05:57:45", "text": "今天这里有骑师。嗯。也许他会"}, {"type": "subtitle", "time": 21474.23, "timestamp": "05:57:54", "text": "小时。可以做更好的事情，比如杀戮"}, {"type": "subtitle", "time": 21476.47, "timestamp": "05:57:56", "text": "村庄。是啊，还有那个。但我没有"}, {"type": "subtitle", "time": 21479.67, "timestamp": "05:57:59", "text": "想要像杀戮一样具有侵略性"}]
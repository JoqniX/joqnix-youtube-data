[{"type": "subtitle", "time": 19262.628, "timestamp": "05:21:02", "text": "上帝。有人在场。我的天哪。我希望"}, {"type": "subtitle", "time": 19265.31, "timestamp": "05:21:05", "text": "这里不是他们该来的地方。哦"}, {"type": "subtitle", "time": 19266.83, "timestamp": "05:21:06", "text": "不。"}, {"type": "subtitle", "time": 19269.99, "timestamp": "05:21:09", "text": "圣。我会非常害羞。哦，不。我应该"}, {"type": "subtitle", "time": 19300.55, "timestamp": "05:21:40", "text": "我好饿。我应该 我应该 我"}, {"type": "subtitle", "time": 19302.19, "timestamp": "05:21:42", "text": "我应该吗？"}, {"type": "subtitle", "time": 19304.91, "timestamp": "05:21:44", "text": "实际上应该"}, {"type": "subtitle", "time": 19309.788, "timestamp": "05:21:49", "text": "嗯，就是这里，对吧？所以我需要"}, {"type": "subtitle", "time": 19312.99, "timestamp": "05:21:52", "text": "我的樱桃木主板在哪儿？"}, {"type": "subtitle", "time": 19315.868, "timestamp": "05:21:55", "text": "哦，樱桃"}]
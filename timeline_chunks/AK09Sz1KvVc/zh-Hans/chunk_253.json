[{"type": "subtitle", "time": 15184.71, "timestamp": "04:13:04", "text": "中心点应该就在正上方"}, {"type": "subtitle", "time": 15186.03, "timestamp": "04:13:06", "text": "这里。"}, {"type": "subtitle", "time": 15188.91, "timestamp": "04:13:08", "text": "所以方式"}, {"type": "subtitle", "time": 15191.79, "timestamp": "04:13:11", "text": "观点。是的。"}, {"type": "subtitle", "time": 15211.389, "timestamp": "04:13:31", "text": "可爱。我们走吧"}, {"type": "subtitle", "time": 15218.55, "timestamp": "04:13:38", "text": "生物群落。传送。我无法瞬间移动。是的，"}, {"type": "subtitle", "time": 15219.6, "timestamp": "04:13:39", "text": "我当然不能"}, {"type": "subtitle", "time": 15221.229, "timestamp": "04:13:41", "text": "[音乐]"}, {"type": "subtitle", "time": 15222.83, "timestamp": "04:13:42", "text": "传送。"}, {"type": "subtitle", "time": 15225.429, "timestamp": "04:13:45", "text": "呃，等等。停靠点在哪里"}, {"type": "subtitle", "time": 15227.56, "timestamp": "04:13:47", "text": "再次？码头在哪里？"}, {"type": "subtitle", "time": 15230.269, "timestamp": "04:13:50", "text": "[音乐]"}, {"type": "subtitle", "time": 15233.309, "timestamp": "04:13:53", "text": "地方？哦，不。我来自哪里？"}, {"type": "subtitle", "time": 15235.87, "timestamp": "04:13:55", "text": "从？码头在哪里？"}, {"type": "subtitle", "time": 15239.149, "timestamp": "04:13:59", "text": "地方？我的"}]
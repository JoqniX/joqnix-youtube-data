[{"type": "subtitle", "time": 14046.189, "timestamp": "03:54:06", "text": "合十礼。怎样"}, {"type": "subtitle", "time": 14049.03, "timestamp": "03:54:09", "text": "你？我的天啊。看。去。看看他。"}, {"type": "subtitle", "time": 14052.269, "timestamp": "03:54:12", "text": "他看起来像个王子。实际的"}, {"type": "subtitle", "time": 14055.99, "timestamp": "03:54:15", "text": "朋友们。去。"}, {"type": "subtitle", "time": 14058.429, "timestamp": "03:54:18", "text": "所以他非常"}, {"type": "chat", "time": 14059.053, "timestamp": "03:54:19", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "a wut prince"}, {"type": "subtitle", "time": 14062.229, "timestamp": "03:54:22", "text": "可爱的。公主床。是啊，他看起来"}, {"type": "chat", "time": 14062.421, "timestamp": "03:54:22", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "ah nvm"}, {"type": "subtitle", "time": 14064.03, "timestamp": "03:54:24", "text": "和他一模一样"}, {"type": "subtitle", "time": 14067.99, "timestamp": "03:54:27", "text": "甜的。嗯，是的。嗯，当然。这真是太……"}, {"type": "subtitle", "time": 14069.79, "timestamp": "03:54:29", "text": "很糟糕。"}, {"type": "subtitle", "time": 14074.51, "timestamp": "03:54:34", "text": "是的。我要去拿，我就像我要走了"}, {"type": "subtitle", "time": 14076.429, "timestamp": "03:54:36", "text": "要得到"}, {"type": "subtitle", "time": 14078.429, "timestamp": "03:54:38", "text": "我的"}, {"type": "subtitle", "time": 14080.67, "timestamp": "03:54:40", "text": "项目。"}, {"type": "subtitle", "time": 14088.309, "timestamp": "03:54:48", "text": "去。超人正在飞行。那看起来"}, {"type": "subtitle", "time": 14089.99, "timestamp": "03:54:49", "text": "虽然我抬头看的时候，它就像一条龙。"}, {"type": "subtitle", "time": 14092.349, "timestamp": "03:54:52", "text": "天空。"}, {"type": "subtitle", "time": 14096.67, "timestamp": "03:54:56", "text": "哇。好的。是的，我应该把床铺好。"}, {"type": "subtitle", "time": 14098.99, "timestamp": "03:54:58", "text": "是的。所以，这就是这里"}]
[{"type": "subtitle", "time": 13022.95, "timestamp": "03:37:02", "text": "产卵。哇，他们真的很不错"}, {"type": "subtitle", "time": 13025.63, "timestamp": "03:37:05", "text": "布局也是如此。好的。哦，我的"}, {"type": "subtitle", "time": 13028.87, "timestamp": "03:37:08", "text": "天哪。哦。或许我应该做点什么。"}, {"type": "subtitle", "time": 13033.11, "timestamp": "03:37:13", "text": "像这样。比如我有很多木头。"}, {"type": "subtitle", "time": 13035.63, "timestamp": "03:37:15", "text": "或许我应该做点类似的东西"}, {"type": "subtitle", "time": 13039.17, "timestamp": "03:37:19", "text": "这。这是个很酷的设计。"}, {"type": "subtitle", "time": 13041.309, "timestamp": "03:37:21", "text": "[音乐]"}, {"type": "subtitle", "time": 13050.99, "timestamp": "03:37:30", "text": "低的。给"}, {"type": "subtitle", "time": 13058.349, "timestamp": "03:37:38", "text": "健康。在那里"}, {"type": "subtitle", "time": 13060.429, "timestamp": "03:37:40", "text": "去。芯片"}, {"type": "subtitle", "time": 13066.469, "timestamp": "03:37:46", "text": "僵尸。哦，等等。就像南瓜一样"}, {"type": "subtitle", "time": 13070.269, "timestamp": "03:37:50", "text": "男人的东西。哇。真是这样"}, {"type": "subtitle", "time": 13073.91, "timestamp": "03:37:53", "text": "可爱的。等等，这是下一场雪吗？"}]
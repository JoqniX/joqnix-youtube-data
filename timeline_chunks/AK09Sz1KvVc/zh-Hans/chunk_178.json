[{"type": "subtitle", "time": 10696.59, "timestamp": "02:58:16", "text": "我不知道你需要把那个名字写在你的……"}, {"type": "subtitle", "time": 10705.71, "timestamp": "02:58:25", "text": "汁。所以，"}, {"type": "subtitle", "time": 10714.71, "timestamp": "02:58:34", "text": "完毕。嗯，可以说已经完成了。它是"}, {"type": "subtitle", "time": 10717.23, "timestamp": "02:58:37", "text": "尤其喜欢当一个成员"}, {"type": "subtitle", "time": 10719.83, "timestamp": "02:58:39", "text": "事情的进展正好说明了这一点。"}, {"type": "subtitle", "time": 10729.95, "timestamp": "02:58:49", "text": "对，你知道的，我明白。"}, {"type": "subtitle", "time": 10733.269, "timestamp": "02:58:53", "text": "我们有一份捐赠电子表格"}, {"type": "subtitle", "time": 10736.63, "timestamp": "02:58:56", "text": "就是这个"}]
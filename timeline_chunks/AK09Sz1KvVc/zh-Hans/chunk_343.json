[{"type": "subtitle", "time": 20587.47, "timestamp": "05:43:07", "text": "这样我或许就能精力充沛了。"}, {"type": "subtitle", "time": 20590.39, "timestamp": "05:43:10", "text": "你知道，拥有好音乐很重要。"}, {"type": "subtitle", "time": 20592.19, "timestamp": "05:43:12", "text": "在你周围，就像你一样"}, {"type": "subtitle", "time": 20594.91, "timestamp": "05:43:14", "text": "知道那将会是"}, {"type": "subtitle", "time": 20598.15, "timestamp": "05:43:18", "text": "还好她没发布任何新作品。"}, {"type": "subtitle", "time": 20610.47, "timestamp": "05:43:30", "text": "欢迎，下午好，希望你一切都好。"}, {"type": "subtitle", "time": 20613.27, "timestamp": "05:43:33", "text": "我想这是你第一次来这里吧。"}, {"type": "subtitle", "time": 20621.948, "timestamp": "05:43:41", "text": "哦。呃，亚洲检查。呃，瘾君子"}, {"type": "subtitle", "time": 20623.708, "timestamp": "05:43:43", "text": "呃，"}, {"type": "subtitle", "time": 20625.83, "timestamp": "05:43:45", "text": "弗雷德里克。瘾君子弗雷德里克。等待，"}, {"type": "subtitle", "time": 20631.39, "timestamp": "05:43:51", "text": "什么？那是旧的"}, {"type": "subtitle", "time": 20638.708, "timestamp": "05:43:58", "text": "等待。哦好的。好的，那是旧的"}]
[{"type": "subtitle", "time": 12908.91, "timestamp": "03:35:08", "text": "神圣的"}, {"type": "subtitle", "time": 12912.55, "timestamp": "03:35:12", "text": "呃，我刚才说到哪儿了？我们走吧"}, {"type": "subtitle", "time": 12927.11, "timestamp": "03:35:27", "text": "很快。哦。哦，不。不，不，不。我意外"}, {"type": "subtitle", "time": 12928.79, "timestamp": "03:35:28", "text": "我出了意外。哦，等等。等待。我需要"}, {"type": "subtitle", "time": 12931.349, "timestamp": "03:35:31", "text": "积木。我需要积木。让我圣洁，"}, {"type": "subtitle", "time": 12935.349, "timestamp": "03:35:35", "text": "圣哉，圣哉，圣哉。屏蔽他。实际上，"}, {"type": "subtitle", "time": 12936.63, "timestamp": "03:35:36", "text": "屏蔽他。哦，等等，等等，等等。堵塞"}, {"type": "subtitle", "time": 12939.309, "timestamp": "03:35:39", "text": "他。屏蔽他。开锁"}, {"type": "subtitle", "time": 12947.71, "timestamp": "03:35:47", "text": "村民。哦"}, {"type": "subtitle", "time": 12952.309, "timestamp": "03:35:52", "text": "男生。我的木头。等等，他出来了。如何？"}, {"type": "subtitle", "time": 12958.91, "timestamp": "03:35:58", "text": "什么？好吧，我可能会死。我需要"}]
[{"type": "subtitle", "time": 13680.95, "timestamp": "03:48:00", "text": "很多。我已经吃饱了。等等，不，别这样"}, {"type": "subtitle", "time": 13683.55, "timestamp": "03:48:03", "text": "头脑。可以穿这些"}, {"type": "subtitle", "time": 13687.07, "timestamp": "03:48:07", "text": "东西。是的，库存更多了。"}, {"type": "subtitle", "time": 13689.95, "timestamp": "03:48:09", "text": "空间。所以可以"}, {"type": "subtitle", "time": 13692.08, "timestamp": "03:48:12", "text": "加入。"}, {"type": "subtitle", "time": 13709.71, "timestamp": "03:48:29", "text": "我们？"}, {"type": "subtitle", "time": 13712.469, "timestamp": "03:48:32", "text": "嗯，我喜欢这个地方只有"}, {"type": "subtitle", "time": 13716.429, "timestamp": "03:48:36", "text": "樱花。什么？嗯？"}, {"type": "subtitle", "time": 13719.189, "timestamp": "03:48:39", "text": "兄弟，你干嘛这么快就想跟我打？"}, {"type": "subtitle", "time": 13720.11, "timestamp": "03:48:40", "text": "他妈的"}, {"type": "subtitle", "time": 13722.229, "timestamp": "03:48:42", "text": "向上。等等，等等，等等，等等，等等，等等，"}, {"type": "subtitle", "time": 13723.59, "timestamp": "03:48:43", "text": "等等，等等。我不想，我不想"}, {"type": "subtitle", "time": 13727.309, "timestamp": "03:48:47", "text": "真的会死。"}, {"type": "subtitle", "time": 13731.189, "timestamp": "03:48:51", "text": "我根本就没安排那件事。"}, {"type": "subtitle", "time": 13733.63, "timestamp": "03:48:53", "text": "等等，等等，等等，等等，等等，等等，"}, {"type": "subtitle", "time": 13736.95, "timestamp": "03:48:56", "text": "等待。给我食物。给我食物。"}, {"type": "subtitle", "time": 13738.55, "timestamp": "03:48:58", "text": "剑在哪儿？那是什么？所以"}]
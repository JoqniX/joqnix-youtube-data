[{"type": "subtitle", "time": 19380.67, "timestamp": "05:23:00", "text": "嗯，手臂"}, {"type": "subtitle", "time": 19383.59, "timestamp": "05:23:03", "text": "日志。等等，我能取个样品吗？"}, {"type": "subtitle", "time": 19384.75, "timestamp": "05:23:04", "text": "这"}, {"type": "subtitle", "time": 19386.91, "timestamp": "05:23:06", "text": "也？眨眼"}, {"type": "subtitle", "time": 19388.99, "timestamp": "05:23:08", "text": "眨眼。等等，那是谁？"}, {"type": "subtitle", "time": 19391.15, "timestamp": "05:23:11", "text": "那？等等，那是谁？"}, {"type": "subtitle", "time": 19408.788, "timestamp": "05:23:28", "text": "简来过这里。哦，我认识杰德·简。嗯。"}, {"type": "subtitle", "time": 19411.788, "timestamp": "05:23:31", "text": "我认识杰德·杰德"}, {"type": "subtitle", "time": 19414.83, "timestamp": "05:23:34", "text": "简·杰德·简。我知道"}, {"type": "subtitle", "time": 19417.59, "timestamp": "05:23:37", "text": "他。这就是接待我的那个人。"}, {"type": "subtitle", "time": 19421.948, "timestamp": "05:23:41", "text": "比如跟我打招呼什么的。呃，所以"}]
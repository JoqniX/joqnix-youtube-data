[{"type": "subtitle", "time": 18961.75, "timestamp": "05:16:01", "text": "东西。哇。所以现在是春天"}, {"type": "subtitle", "time": 18964.55, "timestamp": "05:16:04", "text": "接下来，28天后就会发生这件事。它是"}, {"type": "subtitle", "time": 18973.788, "timestamp": "05:16:13", "text": "相信。"}, {"type": "subtitle", "time": 18975.708, "timestamp": "05:16:15", "text": "等待，"}, {"type": "subtitle", "time": 18978.708, "timestamp": "05:16:18", "text": "日历显示还剩19天。这就是我的原因"}, {"type": "subtitle", "time": 18981.07, "timestamp": "05:16:21", "text": "种植了很多……"}, {"type": "subtitle", "time": 18984.23, "timestamp": "05:16:24", "text": "樱花 樱花 我不知道樱桃"}, {"type": "subtitle", "time": 18986.47, "timestamp": "05:16:26", "text": "盛开的叶子，让我能喜欢你"}, {"type": "subtitle", "time": 18988.948, "timestamp": "05:16:28", "text": "知道可以把它变成农场。不是农场"}, {"type": "subtitle", "time": 18997.59, "timestamp": "05:16:37", "text": "某物。这些都像是四个"}, {"type": "subtitle", "time": 19003.67, "timestamp": "05:16:43", "text": "四个，四个，四个，一堆。"}, {"type": "subtitle", "time": 19006.51, "timestamp": "05:16:46", "text": "你看它有多厚？ 1 2 3 四"}, {"type": "subtitle", "time": 19013.99, "timestamp": "05:16:53", "text": "哇。好的。所以，或许我们可以找到一个"}, {"type": "subtitle", "time": 19016.628, "timestamp": "05:16:56", "text": "还有一件事，但我认为"}]
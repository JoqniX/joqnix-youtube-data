[{"type": "subtitle", "time": 19562.55, "timestamp": "05:26:02", "text": "游戏里我有h，就像我的肚子一样"}, {"type": "subtitle", "time": 19566.55, "timestamp": "05:26:06", "text": "我已经吃饱了，我要去吃饭了。所以你知道"}, {"type": "subtitle", "time": 19569.55, "timestamp": "05:26:09", "text": "我就在这儿露营吧"}, {"type": "subtitle", "time": 19572.83, "timestamp": "05:26:12", "text": "猜测。看来我只能在这儿露营了。和"}, {"type": "subtitle", "time": 19605.708, "timestamp": "05:26:45", "text": "是。是的，他们应该"}, {"type": "subtitle", "time": 19609.31, "timestamp": "05:26:49", "text": "好的。我会受到保护"}, {"type": "subtitle", "time": 19618.03, "timestamp": "05:26:58", "text": "所以，所以"}]
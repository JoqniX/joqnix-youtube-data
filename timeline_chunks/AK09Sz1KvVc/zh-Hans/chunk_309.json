[{"type": "subtitle", "time": 18542.868, "timestamp": "05:09:02", "text": "好的，这样就容易多了。我不需要"}, {"type": "subtitle", "time": 18553.44, "timestamp": "05:09:13", "text": "它。哦"}, {"type": "subtitle", "time": 18560.868, "timestamp": "05:09:20", "text": "男生。是的，我只清理了一个。"}, {"type": "subtitle", "time": 18563.788, "timestamp": "05:09:23", "text": "植物，一株"}, {"type": "subtitle", "time": 18567.19, "timestamp": "05:09:27", "text": "整块树干。不是块，而是"}, {"type": "subtitle", "time": 18570.39, "timestamp": "05:09:30", "text": "一小片树林。是的，我觉得是"}]
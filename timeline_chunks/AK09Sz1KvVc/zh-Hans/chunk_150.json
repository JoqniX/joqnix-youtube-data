[{"type": "subtitle", "time": 9000.07, "timestamp": "02:30:00", "text": "呃，他们好像只会买同一档次的商品。"}, {"type": "subtitle", "time": 9002.429, "timestamp": "02:30:02", "text": "对，那是30。"}, {"type": "subtitle", "time": 9006.389, "timestamp": "02:30:06", "text": "卢比续期对你来说会是这样的"}, {"type": "subtitle", "time": 9009.19, "timestamp": "02:30:09", "text": "提前几个月续费，对吧？"}, {"type": "subtitle", "time": 9010.27, "timestamp": "02:30:10", "text": "思考"}, {"type": "subtitle", "time": 9014.55, "timestamp": "02:30:14", "text": "所以，即便如此，也仍然算数，就像是……"}, {"type": "subtitle", "time": 9017.59, "timestamp": "02:30:17", "text": "续签五份合同，这意味着他们买下了"}, {"type": "subtitle", "time": 9020.389, "timestamp": "02:30:20", "text": "第五级没错，那就是145"}, {"type": "subtitle", "time": 9022.51, "timestamp": "02:30:22", "text": "如果我是卢比，那就对了。"}, {"type": "subtitle", "time": 9025.99, "timestamp": "02:30:25", "text": "正确，五份礼物一共多少钱？"}, {"type": "subtitle", "time": 9028.19, "timestamp": "02:30:28", "text": "五位会员天赋"}, {"type": "subtitle", "time": 9030.87, "timestamp": "02:30:30", "text": "会员资格，让我查一下，我找不到。"}, {"type": "subtitle", "time": 9032.99, "timestamp": "02:30:32", "text": "这里没有"}, {"type": "subtitle", "time": 9036.03, "timestamp": "02:30:36", "text": "那里就是它所在的地方。"}, {"type": "subtitle", "time": 9039.27, "timestamp": "02:30:39", "text": "加入"}, {"type": "subtitle", "time": 9041.349, "timestamp": "02:30:41", "text": "不不不不，不是这里，是这里，对吧？"}, {"type": "subtitle", "time": 9043.309, "timestamp": "02:30:43", "text": "会员资格"}, {"type": "subtitle", "time": 9052.27, "timestamp": "02:30:52", "text": "145卢比"}, {"type": "subtitle", "time": 9055.83, "timestamp": "02:30:55", "text": "五卢比，是的，所以积分会是……"}, {"type": "subtitle", "time": 9057.83, "timestamp": "02:30:57", "text": "得分将计算五次。"}]
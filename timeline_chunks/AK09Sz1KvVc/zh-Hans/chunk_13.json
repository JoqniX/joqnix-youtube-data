title", "time": 827.59, "timestamp": "00:13:47", "text": "这位幸运的玩笑会员"}, {"type": "subtitle", "time": 831.03, "timestamp": "00:13:51", "text": "能够接触到书籍。点击“允许”。"}, {"type": "subtitle", "time": 833.509, "timestamp": "00:13:53", "text": "礼物。这样做就对了。点击"}, {"type": "chat", "time": 833.638, "timestamp": "00:13:53", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "it just says block or report"}, {"type": "subtitle", "time": 835.47, "timestamp": "00:13:55", "text": "允许"}, {"type": "subtitle", "time": 839.189, "timestamp": "00:13:59", "text": "礼物，我敢打赌你能得到。如果我"}]
[{"type": "subtitle", "time": 18660.47, "timestamp": "05:11:00", "text": "呃，我不太想用完呃……"}, {"type": "subtitle", "time": 18668.11, "timestamp": "05:11:08", "text": "很遗憾，我不得不使用"}, {"type": "subtitle", "time": 18670.99, "timestamp": "05:11:10", "text": "它。别看我"}, {"type": "subtitle", "time": 18674.47, "timestamp": "05:11:14", "text": "请。蜘蛛约翰。"}, {"type": "subtitle", "time": 18686.91, "timestamp": "05:11:26", "text": "动作。蜘蛛呻吟"}, {"type": "subtitle", "time": 18690.11, "timestamp": "05:11:30", "text": "嘶嘶声。哦"}, {"type": "subtitle", "time": 18700.43, "timestamp": "05:11:40", "text": "我。不要"}, {"type": "subtitle", "time": 18704.628, "timestamp": "05:11:44", "text": "移动。不要动。"}, {"type": "subtitle", "time": 18715.99, "timestamp": "05:11:55", "text": "你。团子。他们并不怀有敌意。哦，我的"}, {"type": "subtitle", "time": 18717.39, "timestamp": "05:11:57", "text": "上帝。"}]
[{"type": "subtitle", "time": 13380.91, "timestamp": "03:43:00", "text": "对我来说足够了。我没有那种高……"}, {"type": "subtitle", "time": 13401.11, "timestamp": "03:43:21", "text": "那。不，我刚才是不是点了“总计”？"}, {"type": "subtitle", "time": 13405.15, "timestamp": "03:43:25", "text": "幻想？哦，不。不。发射"}, {"type": "subtitle", "time": 13408.75, "timestamp": "03:43:28", "text": "它。等待。呃，需要使用开源着色器包。"}, {"type": "subtitle", "time": 13411.79, "timestamp": "03:43:31", "text": "好的，我来关闭它。"}, {"type": "subtitle", "time": 13414.349, "timestamp": "03:43:34", "text": "那。别介意"}, {"type": "subtitle", "time": 13417.349, "timestamp": "03:43:37", "text": "我。好的。把那段粘贴到那边。"}, {"type": "subtitle", "time": 13425.91, "timestamp": "03:43:45", "text": "那。搞定。然后点击。重新开放。"}, {"type": "subtitle", "time": 13429.15, "timestamp": "03:43:49", "text": "中等的。再打开一次。中等和"}, {"type": "subtitle", "time": 13431.67, "timestamp": "03:43:51", "text": "申请。请别告诉我这是真的"}, {"type": "subtitle", "time": 13432.51, "timestamp": "03:43:52", "text": "会"}, {"type": "subtitle", "time": 13435.469, "timestamp": "03:43:55", "text": "比如对……很严厉"}, {"type": "subtitle", "time": 13438.63, "timestamp": "03:43:58", "text": "这。好的，那边刚才，"}]
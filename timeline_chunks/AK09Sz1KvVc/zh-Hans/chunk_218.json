[{"type": "subtitle", "time": 13080.83, "timestamp": "03:38:00", "text": "好的。真是这样"}, {"type": "subtitle", "time": 13083.349, "timestamp": "03:38:03", "text": "可爱的。那是只兔子吗？等等，还有"}, {"type": "subtitle", "time": 13085.51, "timestamp": "03:38:05", "text": "我的世界里会有兔子吗？真的吗？等待，"}, {"type": "subtitle", "time": 13088.15, "timestamp": "03:38:08", "text": "什么？哦，等等。是的。是的，"}, {"type": "subtitle", "time": 13090.67, "timestamp": "03:38:10", "text": "有只兔子。"}, {"type": "subtitle", "time": 13094.19, "timestamp": "03:38:14", "text": "忘了。它太难杀死了。"}, {"type": "subtitle", "time": 13105.51, "timestamp": "03:38:25", "text": "等等，他们不会掉东西吧？"}, {"type": "subtitle", "time": 13107.55, "timestamp": "03:38:27", "text": "不，我杀了一个"}, {"type": "subtitle", "time": 13110.19, "timestamp": "03:38:30", "text": "清白的。大木"}, {"type": "subtitle", "time": 13112.36, "timestamp": "03:38:32", "text": "帕科杀害了一名无辜者。"}, {"type": "subtitle", "time": 13115.07, "timestamp": "03:38:35", "text": "[音乐]"}, {"type": "subtitle", "time": 13119.59, "timestamp": "03:38:39", "text": "不。好的。呃，我们这是在哪儿？我需要"}, {"type": "subtitle", "time": 13121.71, "timestamp": "03:38:41", "text": "找到最多"}, {"type": "subtitle", "time": 13123.99, "timestamp": "03:38:43", "text": "准确。哦，等等。这是一条河，"}, {"type": "subtitle", "time": 13130.55, "timestamp": "03:38:50", "text": "船。这套装置应该用于什么用途？"}]
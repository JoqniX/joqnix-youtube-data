[{"type": "subtitle", "time": 18445.43, "timestamp": "05:07:25", "text": "我需要一颗樱桃"}, {"type": "subtitle", "time": 18447.868, "timestamp": "05:07:27", "text": "工作台。我的天哪，这太……"}, {"type": "subtitle", "time": 18450.75, "timestamp": "05:07:30", "text": "凉爽的。我的天，这太不可思议了"}, {"type": "subtitle", "time": 18452.948, "timestamp": "05:07:32", "text": "凉爽的。太酷了。太酷了。"}, {"type": "subtitle", "time": 18455.868, "timestamp": "05:07:35", "text": "太酷了。木制的"}, {"type": "subtitle", "time": 18458.23, "timestamp": "05:07:38", "text": "铲。想象一下，如果我们能得到所有的木头"}, {"type": "subtitle", "time": 18459.628, "timestamp": "05:07:39", "text": "物品作为"}, {"type": "subtitle", "time": 18462.07, "timestamp": "05:07:42", "text": "木制的。有个小樱桃男孩。我会"}, {"type": "subtitle", "time": 18477.67, "timestamp": "05:07:57", "text": "你。樱桃工艺恶魔。患病的"}]
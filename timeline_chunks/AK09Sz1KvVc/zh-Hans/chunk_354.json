[{"type": "subtitle", "time": 21243.03, "timestamp": "05:54:03", "text": "被包围了。红衣人。问号。他"}, {"type": "subtitle", "time": 21245.03, "timestamp": "05:54:05", "text": "他找到了我家，但他还没有绑架我。"}, {"type": "subtitle", "time": 21249.59, "timestamp": "05:54:09", "text": "我还没呢。等等，什么？嗯？"}, {"type": "subtitle", "time": 21257.23, "timestamp": "05:54:17", "text": "等待。是的。你好。哦，我的"}, {"type": "subtitle", "time": 21274.51, "timestamp": "05:54:34", "text": "巴。等等，等等，等等，等等，等等，等等，"}, {"type": "subtitle", "time": 21276.868, "timestamp": "05:54:36", "text": "等待。他也会找到我家。等待，"}, {"type": "subtitle", "time": 21278.23, "timestamp": "05:54:38", "text": "等等，等等。"}, {"type": "subtitle", "time": 21280.628, "timestamp": "05:54:40", "text": "如果你去下界，我会捐款。什么"}, {"type": "subtitle", "time": 21282.19, "timestamp": "05:54:42", "text": "你的意思是"}, {"type": "subtitle", "time": 21284.03, "timestamp": "05:54:44", "text": "捐？"}, {"type": "subtitle", "time": 21286.948, "timestamp": "05:54:46", "text": "什么？你说的捐赠是什么意思？不"}, {"type": "subtitle", "time": 21289.628, "timestamp": "05:54:49", "text": "把钱花在我身上吧。我会揍你。"}, {"type": "subtitle", "time": 21293.868, "timestamp": "05:54:53", "text": "为什么？不花钱。抓住"}]
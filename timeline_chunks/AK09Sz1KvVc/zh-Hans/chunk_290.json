[{"type": "subtitle", "time": 17400.39, "timestamp": "04:50:00", "text": "呃，我用的是惠普电脑。我随时都可能死去。"}, {"type": "subtitle", "time": 17402.39, "timestamp": "04:50:02", "text": "我真的要死了。我真的要死了。"}, {"type": "subtitle", "time": 17405.15, "timestamp": "04:50:05", "text": "我死了。我死了。"}, {"type": "subtitle", "time": 17406.59, "timestamp": "04:50:06", "text": "哇。"}, {"type": "subtitle", "time": 17409.47, "timestamp": "04:50:09", "text": "[音乐]"}, {"type": "subtitle", "time": 17417.39, "timestamp": "04:50:17", "text": "哇。"}, {"type": "subtitle", "time": 17420.03, "timestamp": "04:50:20", "text": "等待。事情经过是这样的。"}, {"type": "subtitle", "time": 17423.67, "timestamp": "04:50:23", "text": "孩子们，米娜，不仅仅是孩子们，米娜。如果你"}, {"type": "subtitle", "time": 17427.67, "timestamp": "04:50:27", "text": "没有一个叫做家的地方，而你"}, {"type": "subtitle", "time": 17430.11, "timestamp": "04:50:30", "text": "漫步"}, {"type": "subtitle", "time": 17432.27, "timestamp": "04:50:32", "text": "大约"}, {"type": "subtitle", "time": 17444.948, "timestamp": "04:50:44", "text": "圣。说实话，我不知道为什么。"}, {"type": "subtitle", "time": 17447.43, "timestamp": "04:50:47", "text": "你。我最近一直在直播"}, {"type": "subtitle", "time": 17448.948, "timestamp": "04:50:48", "text": "我已经直播了大概12个小时了，"}, {"type": "subtitle", "time": 17451.83, "timestamp": "04:50:51", "text": "正确的？我感觉有点不舒服。"}, {"type": "subtitle", "time": 17453.23, "timestamp": "04:50:53", "text": "有点儿"}, {"type": "subtitle", "time": 17455.43, "timestamp": "04:50:55", "text": "今天。这就是他们所说的"}, {"type": "subtitle", "time": 17458.27, "timestamp": "04:50:58", "text": "恢复"}]
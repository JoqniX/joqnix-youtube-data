[{"type": "subtitle", "time": 8701.51, "timestamp": "02:25:01", "text": "这些东西看起来好奇怪啊"}, {"type": "subtitle", "time": 8704.63, "timestamp": "02:25:04", "text": "奇怪吗？这不是“我的天哪”。那"}, {"type": "subtitle", "time": 8708.23, "timestamp": "02:25:08", "text": "这是以前的我做的，对吧？什么时候"}, {"type": "subtitle", "time": 8710.79, "timestamp": "02:25:10", "text": "我看了看，就能看出有多少"}, {"type": "subtitle", "time": 8715.19, "timestamp": "02:25:15", "text": "新手，我希望这是土豆。为什么"}, {"type": "subtitle", "time": 8718.309, "timestamp": "02:25:18", "text": "你会把这样放在这里吗？为什么"}, {"type": "subtitle", "time": 8721.11, "timestamp": "02:25:21", "text": "案件陈述书就放在那里？不像"}, {"type": "subtitle", "time": 8730.15, "timestamp": "02:25:30", "text": "那？我不知道。总之，超级聊天。"}, {"type": "subtitle", "time": 8731.99, "timestamp": "02:25:31", "text": "我们不需要这些人。我们可以删除"}, {"type": "subtitle", "time": 8734.71, "timestamp": "02:25:34", "text": "他们。哦，等等。实际上，我们确实需要它。"}, {"type": "subtitle", "time": 8736.95, "timestamp": "02:25:36", "text": "我们要撤出这个平台。好的。是"}, {"type": "subtitle", "time": 8738.67, "timestamp": "02:25:38", "text": "拉出颜色。"}, {"type": "subtitle", "time": 8741.349, "timestamp": "02:25:41", "text": "好的。不，我们……好吧，等等。"}, {"type": "subtitle", "time": 8744.67, "timestamp": "02:25:44", "text": "听。我们不会那样做。不是"}, {"type": "subtitle", "time": 8747.349, "timestamp": "02:25:47", "text": "这。我们正在获取用户下标。"}, {"type": "subtitle", "time": 8749.83, "timestamp": "02:25:49", "text": "不，我们不需要用户订阅。"}, {"type": "subtitle", "time": 8752.95, "timestamp": "02:25:52", "text": "是的。呃，我们需要超级留言的金额。"}, {"type": "subtitle", "time": 8755.429, "timestamp": "02:25:55", "text": "超级聊天金额字符串货币和"}, {"type": "subtitle", "time": 8756.99, "timestamp": "02:25:56", "text": "超级留言等级。"}]
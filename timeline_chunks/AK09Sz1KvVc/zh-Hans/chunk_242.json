[{"type": "subtitle", "time": 14523.51, "timestamp": "04:02:03", "text": "如果需要的话，可以运行电力系统。等等，我可以"}, {"type": "subtitle", "time": 14527.91, "timestamp": "04:02:07", "text": "如果你愿意，我可以花32美元翻新一台Elro。"}, {"type": "subtitle", "time": 14530.99, "timestamp": "04:02:10", "text": "熨烫之神。一边"}, {"type": "subtitle", "time": 14534.429, "timestamp": "04:02:14", "text": "旅行时我没有带铁剂。我"}, {"type": "subtitle", "time": 14538.15, "timestamp": "04:02:18", "text": "制作了铁盔，然后我把它熨烫了。"}, {"type": "subtitle", "time": 14541.79, "timestamp": "04:02:21", "text": "神。等等，我等着。我只得到了它"}, {"type": "subtitle", "time": 14544.51, "timestamp": "04:02:24", "text": "从"}, {"type": "subtitle", "time": 14547.83, "timestamp": "04:02:27", "text": "艾泽拉斯，但我把它用作其他用途。"}, {"type": "subtitle", "time": 14551.269, "timestamp": "04:02:31", "text": "东西。哦，没关系。我破产了，但是"}, {"type": "subtitle", "time": 14557.269, "timestamp": "04:02:37", "text": "美好的。嘿，着色器已禁用。等等，怎么会这样"}, {"type": "subtitle", "time": 14570.63, "timestamp": "04:02:50", "text": "哦，为什么要禁用着色器？哦。哦，"}]
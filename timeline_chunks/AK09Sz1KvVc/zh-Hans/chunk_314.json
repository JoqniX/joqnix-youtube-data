[{"type": "subtitle", "time": 18840.47, "timestamp": "05:14:00", "text": "地方。冒险之旅。"}, {"type": "subtitle", "time": 18843.91, "timestamp": "05:14:03", "text": "为了工作，我得付出很多努力。"}, {"type": "subtitle", "time": 18855.59, "timestamp": "05:14:15", "text": "现在，我会按照原样种植它。"}, {"type": "subtitle", "time": 18857.83, "timestamp": "05:14:17", "text": "这里有位已经工作过的人"}, {"type": "subtitle", "time": 18861.27, "timestamp": "05:14:21", "text": "这里种植了。我很高兴我得到了很多"}, {"type": "subtitle", "time": 18862.91, "timestamp": "05:14:22", "text": "圣洁"}, {"type": "subtitle", "time": 18866.948, "timestamp": "05:14:26", "text": "植物。哦，或许我可以办个市集。"}, {"type": "subtitle", "time": 18870.47, "timestamp": "05:14:30", "text": "地方。哦，不。我做了什么？你曾是"}, {"type": "subtitle", "time": 18873.39, "timestamp": "05:14:33", "text": "好孩子。喂，你以前是个好孩子。"}, {"type": "subtitle", "time": 18885.99, "timestamp": "05:14:45", "text": "但有28棵树苗。我的天啊。等待。 30"}, {"type": "subtitle", "time": 18889.67, "timestamp": "05:14:49", "text": "树苗。我的天啊。哇。好的，就是这样。"}, {"type": "subtitle", "time": 18892.91, "timestamp": "05:14:52", "text": "我的职责。我需要"}, {"type": "subtitle", "time": 18895.91, "timestamp": "05:14:55", "text": "一。"}, {"type": "subtitle", "time": 18899.39, "timestamp": "05:14:59", "text": "一棵、两棵、三棵、四棵小树苗"}]
[{"type": "subtitle", "time": 16021.03, "timestamp": "04:27:01", "text": "那里。红枫。这个怎么样？"}, {"type": "subtitle", "time": 16027.71, "timestamp": "04:27:07", "text": "日志？所以那会是毛茸茸的叶子。"}, {"type": "subtitle", "time": 16031.91, "timestamp": "04:27:11", "text": "好的。还有这些松树叶。哦，松树"}, {"type": "subtitle", "time": 16034.149, "timestamp": "04:27:14", "text": "日志。好的。"}, {"type": "subtitle", "time": 16037.11, "timestamp": "04:27:17", "text": "橙色大地。但是，是否存在一个地球"}, {"type": "subtitle", "time": 16042.99, "timestamp": "04:27:22", "text": "科塔？哇。红色岩石。什么？哇。红色的"}, {"type": "subtitle", "time": 16047.03, "timestamp": "04:27:27", "text": "沙。棕色陶土。哇。什么是"}, {"type": "subtitle", "time": 16052.51, "timestamp": "04:27:32", "text": "这？帕洛维拉维德原木。什么是"}, {"type": "subtitle", "time": 16054.67, "timestamp": "04:27:34", "text": "这？帕洛"}, {"type": "subtitle", "time": 16059.55, "timestamp": "04:27:39", "text": "芦荟叶。"}, {"type": "subtitle", "time": 16063.429, "timestamp": "04:27:43", "text": "哇。芦荟。宝贝。什么？甚至还有"}, {"type": "subtitle", "time": 16069.149, "timestamp": "04:27:49", "text": "芦荟也是。什么？带刺的啤酒罐"}, {"type": "subtitle", "time": 16070.54, "timestamp": "04:27:50", "text": "猫"}, {"type": "subtitle", "time": 16072.269, "timestamp": "04:27:52", "text": "[音乐]"}, {"type": "subtitle", "time": 16076.469, "timestamp": "04:27:56", "text": "鸡被风吹乱了 被风吹乱了 呃 吹乱了"}]
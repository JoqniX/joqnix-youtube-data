[{"type": "subtitle", "time": 13741.269, "timestamp": "03:49:01", "text": "那是“我的天哪”。这是禁止的"}, {"type": "subtitle", "time": 13743.62, "timestamp": "03:49:03", "text": "别死。不"}, {"type": "subtitle", "time": 13745.63, "timestamp": "03:49:05", "text": "[音乐]"}, {"type": "subtitle", "time": 13756.87, "timestamp": "03:49:16", "text": "安全的。好的。这里很安全。好的。"}, {"type": "subtitle", "time": 13758.6, "timestamp": "03:49:18", "text": "感谢"}, {"type": "subtitle", "time": 13761.55, "timestamp": "03:49:21", "text": "[音乐]"}, {"type": "subtitle", "time": 13765.83, "timestamp": "03:49:25", "text": "上帝。食物不足。"}, {"type": "subtitle", "time": 13772.67, "timestamp": "03:49:32", "text": "也。让我找一个"}, {"type": "subtitle", "time": 13775.51, "timestamp": "03:49:35", "text": "等待。你能像用“等等，等等”那样用吗？"}, {"type": "subtitle", "time": 13778.55, "timestamp": "03:49:38", "text": "等等，等等。可以进行检查"}, {"type": "subtitle", "time": 13785.15, "timestamp": "03:49:45", "text": "忘了。"}, {"type": "subtitle", "time": 13789.07, "timestamp": "03:49:49", "text": "呃，我该如何检查……"}, {"type": "subtitle", "time": 13791.07, "timestamp": "03:49:51", "text": "传送"}, {"type": "subtitle", "time": 13794.07, "timestamp": "03:49:54", "text": "命令？等等，TP 命令就在那里。"}, {"type": "subtitle", "time": 13795.389, "timestamp": "03:49:55", "text": "不，我"}, {"type": "subtitle", "time": 13797.95, "timestamp": "03:49:57", "text": "忘了。"}]
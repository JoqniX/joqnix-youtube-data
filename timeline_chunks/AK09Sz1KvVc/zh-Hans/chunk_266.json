[{"type": "subtitle", "time": 15966.51, "timestamp": "04:26:06", "text": "什么是塔利姆"}, {"type": "subtitle", "time": 15968.189, "timestamp": "04:26:08", "text": "堵塞？"}, {"type": "subtitle", "time": 15971.11, "timestamp": "04:26:11", "text": "哇，那是我从未听说过的新模块。"}, {"type": "subtitle", "time": 15975.269, "timestamp": "04:26:15", "text": "前。有一个紫色的三。什么？"}, {"type": "subtitle", "time": 15977.99, "timestamp": "04:26:17", "text": "等等，这是什么？这是什么？"}, {"type": "subtitle", "time": 15980.03, "timestamp": "04:26:20", "text": "杰克"}, {"type": "subtitle", "time": 15987.91, "timestamp": "04:26:27", "text": "日志显示该区域包含了所有区域的 80%"}, {"type": "subtitle", "time": 15989.389, "timestamp": "04:26:29", "text": "我们个人简介中的"}, {"type": "subtitle", "time": 15992.349, "timestamp": "04:26:32", "text": "世界。"}, {"type": "subtitle", "time": 15998.83, "timestamp": "04:26:38", "text": "80%。"}, {"type": "subtitle", "time": 16001.67, "timestamp": "04:26:41", "text": "哇。它是如何获得所有方块的？"}, {"type": "subtitle", "time": 16003.149, "timestamp": "04:26:43", "text": "尽管？哦，我的"}, {"type": "subtitle", "time": 16008.229, "timestamp": "04:26:48", "text": "上帝。等待。被植物覆盖的石头。"}, {"type": "subtitle", "time": 16011.83, "timestamp": "04:26:51", "text": "所以，这就像枫木原木一样。这"}, {"type": "subtitle", "time": 16018.149, "timestamp": "04:26:58", "text": "枫木，那么银枫木也是"}]
[{"type": "subtitle", "time": 17760.91, "timestamp": "04:56:00", "text": "死。圣。我做了一个大"}, {"type": "subtitle", "time": 17764.39, "timestamp": "04:56:04", "text": "跳。我的天哪。"}, {"type": "subtitle", "time": 17766.51, "timestamp": "04:56:06", "text": "哦"}, {"type": "subtitle", "time": 17770.51, "timestamp": "04:56:10", "text": "天哪，我不知道我是怎么活下来的。"}, {"type": "subtitle", "time": 17773.47, "timestamp": "04:56:13", "text": "这。有"}, {"type": "subtitle", "time": 17776.39, "timestamp": "04:56:16", "text": "我之前在那边。我不想"}, {"type": "subtitle", "time": 17777.47, "timestamp": "04:56:17", "text": "它"}, {"type": "subtitle", "time": 17784.75, "timestamp": "04:56:24", "text": "走了。"}, {"type": "subtitle", "time": 17791.59, "timestamp": "04:56:31", "text": "最后。我只想等……"}, {"type": "subtitle", "time": 17792.68, "timestamp": "04:56:32", "text": "暴民"}, {"type": "subtitle", "time": 17794.99, "timestamp": "04:56:34", "text": "[音乐]"}, {"type": "subtitle", "time": 17797.628, "timestamp": "04:56:37", "text": "重生。我只想吃樱花叶。"}, {"type": "subtitle", "time": 17800.788, "timestamp": "04:56:40", "text": "好的。樱桃树苗之类的东西。那是"}, {"type": "subtitle", "time": 17802.948, "timestamp": "04:56:42", "text": "它。我只要求这些。我将安家"}, {"type": "subtitle", "time": 17810.708, "timestamp": "04:56:50", "text": "附近。这意味着这个区域，因为它"}, {"type": "subtitle", "time": 17813.91, "timestamp": "04:56:53", "text": "就在这个超棒的基地附近。"}, {"type": "subtitle", "time": 17815.31, "timestamp": "04:56:55", "text": "不"}]
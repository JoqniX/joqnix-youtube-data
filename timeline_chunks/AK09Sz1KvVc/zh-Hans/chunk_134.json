[{"type": "subtitle", "time": 8053.589, "timestamp": "02:14:13", "text": "它是如何检查的？我的日志真的有效吗？"}, {"type": "subtitle", "time": 8056.149, "timestamp": "02:14:16", "text": "你需要知道他们都变成了谁。"}, {"type": "subtitle", "time": 8057.39, "timestamp": "02:14:17", "text": "成员们，"}, {"type": "subtitle", "time": 8062.109, "timestamp": "02:14:22", "text": "正确的？哦，它确实有效。看看，看看"}, {"type": "subtitle", "time": 8065.189, "timestamp": "02:14:25", "text": "看那边。我有一份日志。好的，就是这样。"}, {"type": "subtitle", "time": 8067.669, "timestamp": "02:14:27", "text": "在职的。我的天啊。我是这样做的"}, {"type": "subtitle", "time": 8070.55, "timestamp": "02:14:30", "text": "很多年都像去年或去年一样"}, {"type": "subtitle", "time": 8073.109, "timestamp": "02:14:33", "text": "是今年吧？这是我做的。我没想到"}, {"type": "subtitle", "time": 8076.189, "timestamp": "02:14:36", "text": "这招居然奏效了。我的天啊。"}, {"type": "subtitle", "time": 8078.43, "timestamp": "02:14:38", "text": "瞧，Roku"}, {"type": "subtitle", "time": 8083.069, "timestamp": "02:14:43", "text": "然后我喜欢我们家奶牛的 Roku 设备"}, {"type": "subtitle", "time": 8087.31, "timestamp": "02:14:47", "text": "昨天的事了。是的。克洛诺斯橙"}, {"type": "subtitle", "time": 8091.75, "timestamp": "02:14:51", "text": "它奏效了。耶。它实际上正在记录日志"}, {"type": "subtitle", "time": 8095.27, "timestamp": "02:14:55", "text": "它。我的天啊。尼斯之后。你只是哦"}, {"type": "subtitle", "time": 8098.43, "timestamp": "02:14:58", "text": "对，你就展示这个就行了。"}]
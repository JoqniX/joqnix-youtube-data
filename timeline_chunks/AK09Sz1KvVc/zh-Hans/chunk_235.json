[{"type": "subtitle", "time": 14102.71, "timestamp": "03:55:02", "text": "苦力怕死了。苦力怕把我炸飞了。"}, {"type": "subtitle", "time": 14106.55, "timestamp": "03:55:06", "text": "不，苦力怕差点把我炸飞，我死了"}, {"type": "subtitle", "time": 14108.59, "timestamp": "03:55:08", "text": "超过"}, {"type": "subtitle", "time": 14112.15, "timestamp": "03:55:12", "text": "有人从树上跳下来，半身朝下"}, {"type": "subtitle", "time": 14113.59, "timestamp": "03:55:13", "text": "健康。"}, {"type": "subtitle", "time": 14121.03, "timestamp": "03:55:21", "text": "男生。鹅卵石上，我想知道是什么"}, {"type": "subtitle", "time": 14123.15, "timestamp": "03:55:23", "text": "鹅卵石劈裂器"}, {"type": "subtitle", "time": 14144.59, "timestamp": "03:55:44", "text": "好的。所以我们需要迅速"}, {"type": "subtitle", "time": 14154.63, "timestamp": "03:55:54", "text": "呃，当时我正在四处逛逛，对吧？为什么是我"}, {"type": "subtitle", "time": 14156.11, "timestamp": "03:55:56", "text": "我是不是吸毒了？"}, {"type": "subtitle", "time": 14158.349, "timestamp": "03:55:58", "text": "我死了。不。"}]
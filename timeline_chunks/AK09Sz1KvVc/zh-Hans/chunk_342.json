[{"type": "subtitle", "time": 20537.35, "timestamp": "05:42:17", "text": "[音乐]"}, {"type": "subtitle", "time": 20542.59, "timestamp": "05:42:22", "text": "哦，等等。我记得Cough的那首歌。"}, {"type": "subtitle", "time": 20547.15, "timestamp": "05:42:27", "text": "表情包。咳嗽，还有另一个人打电话"}, {"type": "subtitle", "time": 20551.67, "timestamp": "05:42:31", "text": "我。美好的。那首歌真酷。我想念我"}, {"type": "subtitle", "time": 20553.91, "timestamp": "05:42:33", "text": "想念你们俩，你知道吗？我应该"}, {"type": "subtitle", "time": 20556.23, "timestamp": "05:42:36", "text": "认真听听，并解释原因。尽管"}, {"type": "subtitle", "time": 20558.47, "timestamp": "05:42:38", "text": "你们听不到，因为"}, {"type": "subtitle", "time": 20559.548, "timestamp": "05:42:39", "text": "再次"}, {"type": "subtitle", "time": 20562.51, "timestamp": "05:42:42", "text": "DMCA版权仍然有效"}, {"type": "subtitle", "time": 20565.19, "timestamp": "05:42:45", "text": "痛苦，但我会确保你不会"}, {"type": "subtitle", "time": 20568.628, "timestamp": "05:42:48", "text": "我听到它正从那边传来。"}, {"type": "subtitle", "time": 20571.43, "timestamp": "05:42:51", "text": "没用对高保真线缆，那就不是问题。"}, {"type": "subtitle", "time": 20574.19, "timestamp": "05:42:54", "text": "使用直接连接的方式，好的，不错"}, {"type": "subtitle", "time": 20575.708, "timestamp": "05:42:55", "text": "好的"}]
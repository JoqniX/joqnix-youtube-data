[{"type": "subtitle", "time": 1020.23, "timestamp": "00:17:00", "text": "我太高兴了。昨天的直播，两个"}, {"type": "subtitle", "time": 1022.15, "timestamp": "00:17:02", "text": "溪流，第一部分，第二期"}, {"type": "subtitle", "time": 1026.309, "timestamp": "00:17:06", "text": "Jockathon 第 16 天，我们进行了超级聊天"}, {"type": "subtitle", "time": 1028.789, "timestamp": "00:17:08", "text": "感谢你们的支持"}, {"type": "subtitle", "time": 1032.35, "timestamp": "00:17:12", "text": "感谢大家的积极参与和超级聊天！"}, {"type": "subtitle", "time": 1035.59, "timestamp": "00:17:15", "text": "东西。我这辈子都没想过"}, {"type": "subtitle", "time": 1038.549, "timestamp": "00:17:18", "text": "我昨天看到了一条红色的超级留言。"}, {"type": "subtitle", "time": 1040.71, "timestamp": "00:17:20", "text": "感谢Akiawi提供的红色超级"}, {"type": "subtitle", "time": 1049.15, "timestamp": "00:17:29", "text": "而且"}, {"type": "subtitle", "time": 1051.75, "timestamp": "00:17:31", "text": "就像昨天在直播中我们准备的那样"}, {"type": "subtitle", "time": 1054.549, "timestamp": "00:17:34", "text": "成员们，今天的直播……"}, {"type": "subtitle", "time": 1058.47, "timestamp": "00:17:38", "text": "会员等级等等一切都对"}, {"type": "subtitle", "time": 1061.75, "timestamp": "00:17:41", "text": "我很久很久以前就没提过这件事了。"}, {"type": "subtitle", "time": 1065.43, "timestamp": "00:17:45", "text": "我确实提过我一直想……"}, {"type": "subtitle", "time": 1067.99, "timestamp": "00:17:47", "text": "当我有一天……如果我能"}, {"type": "subtitle", "time": 1070.549, "timestamp": "00:17:50", "text": "会员资格我会选择最低档。"}, {"type": "subtitle", "time": 1073.909, "timestamp": "00:17:53", "text": "尽可能分层，因为我觉得我"}, {"type": "subtitle", "time": 1077.75, "timestamp": "00:17:57", "text": "希望大家都像这样，嗯，我希望它是"}]
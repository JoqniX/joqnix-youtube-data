[{"type": "subtitle", "time": 8283.429, "timestamp": "02:18:03", "text": "呃，我刚才吓了一跳。我当时"}, {"type": "subtitle", "time": 8285.27, "timestamp": "02:18:05", "text": "比如，“哦，等等。我把它改成我的了吗？”"}, {"type": "subtitle", "time": 8288.23, "timestamp": "02:18:08", "text": "音乐别名账号？因为我不想用。"}, {"type": "subtitle", "time": 8290.469, "timestamp": "02:18:10", "text": "我不想泄露我的其他信息"}, {"type": "subtitle", "time": 8293.23, "timestamp": "02:18:13", "text": "除了 Jock 之外的别名"}, {"type": "subtitle", "time": 8296.91, "timestamp": "02:18:16", "text": "现在，因为那应该是……"}, {"type": "subtitle", "time": 8300.91, "timestamp": "02:18:20", "text": "秘密。那得由你们自己去找。"}, {"type": "subtitle", "time": 8307.07, "timestamp": "02:18:27", "text": "[音乐]"}, {"type": "subtitle", "time": 8331.15, "timestamp": "02:18:51", "text": "做？如果萨米也能做到这一点就好了。"}, {"type": "subtitle", "time": 8333.83, "timestamp": "02:18:53", "text": "男人。如果萨米也能做到这一点就好了。"}, {"type": "subtitle", "time": 8336.23, "timestamp": "02:18:56", "text": "我本可以做得更好。"}, {"type": "subtitle", "time": 8338.429, "timestamp": "02:18:58", "text": "我更快，更好，"}]
[{"type": "subtitle", "time": 16990.27, "timestamp": "04:43:10", "text": "嗨，就是枫树"}, {"type": "subtitle", "time": 16993.11, "timestamp": "04:43:13", "text": "锁。美好的。别理我。我会去买一些"}, {"type": "subtitle", "time": 17000.03, "timestamp": "04:43:20", "text": "日志。但是，但是我想出去。"}, {"type": "subtitle", "time": 17003.788, "timestamp": "04:43:23", "text": "用……做整个东西"}, {"type": "subtitle", "time": 17007.35, "timestamp": "04:43:27", "text": "就像樱桃一样的东西。"}, {"type": "subtitle", "time": 17010.39, "timestamp": "04:43:30", "text": "但我需要找到一个能抽出时间的人"}, {"type": "subtitle", "time": 17015.07, "timestamp": "04:43:35", "text": "给我一些樱桃木块，或者至少一些"}, {"type": "subtitle", "time": 17019.628, "timestamp": "04:43:39", "text": "樱桃。哦，是蜘蛛。不，不，不"}, {"type": "subtitle", "time": 17022.31, "timestamp": "04:43:42", "text": "不。另外，我需要小心不要"}, {"type": "subtitle", "time": 17024.708, "timestamp": "04:43:44", "text": "死。我需要把这一切都带回来。"}, {"type": "subtitle", "time": 17027.75, "timestamp": "04:43:47", "text": "东西都带回家了，对吧？但家究竟是什么？"}, {"type": "subtitle", "time": 17029.23, "timestamp": "04:43:49", "text": "在哪里？"}, {"type": "subtitle", "time": 17030.99, "timestamp": "04:43:50", "text": "家？不是"}]
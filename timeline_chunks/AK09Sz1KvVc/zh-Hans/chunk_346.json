[{"type": "subtitle", "time": 20763.43, "timestamp": "05:46:03", "text": "无用。是的。你好。又来了。我等待。"}, {"type": "subtitle", "time": 20765.75, "timestamp": "05:46:05", "text": "又来了。哦，我想你是新来的吧。"}, {"type": "subtitle", "time": 20767.868, "timestamp": "05:46:07", "text": "这里。欢迎，"}, {"type": "subtitle", "time": 20771.03, "timestamp": "05:46:11", "text": "欢迎，欢迎，欢迎。你是怎么做到的？"}, {"type": "subtitle", "time": 20780.708, "timestamp": "05:46:20", "text": "我？好的，明白了。我需要一个我需要"}, {"type": "subtitle", "time": 20783.03, "timestamp": "05:46:23", "text": "将此线缆连接到另一根线缆上。"}, {"type": "subtitle", "time": 20785.43, "timestamp": "05:46:25", "text": "我不是用来直播的。"}, {"type": "subtitle", "time": 20794.15, "timestamp": "05:46:34", "text": "DCB正在问：你们都在干什么？"}, {"type": "subtitle", "time": 20796.628, "timestamp": "05:46:36", "text": "在木板上？呃，我只是……我之前不在。"}, {"type": "subtitle", "time": 20801.07, "timestamp": "05:46:41", "text": "一点。我去吃午饭了，所以我……"}, {"type": "subtitle", "time": 20803.708, "timestamp": "05:46:43", "text": "等等"}, {"type": "subtitle", "time": 20811.948, "timestamp": "05:46:51", "text": "这？等待。这不是“等等等等”"}, {"type": "subtitle", "time": 20816.99, "timestamp": "05:46:56", "text": "等待。为什么会这样？等待，"}, {"type": "subtitle", "time": 20819.99, "timestamp": "05:46:59", "text": "什么？这就像一种控制手段。等等，什么？"}]
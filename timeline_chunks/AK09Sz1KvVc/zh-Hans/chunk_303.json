[{"type": "subtitle", "time": 18182.83, "timestamp": "05:03:02", "text": "你看，我连那样都看不懂。"}, {"type": "subtitle", "time": 18199.15, "timestamp": "05:03:19", "text": "某物。那可真不少"}, {"type": "subtitle", "time": 18201.07, "timestamp": "05:03:21", "text": "木头。哦"}, {"type": "subtitle", "time": 18213.27, "timestamp": "05:03:33", "text": "是的。呃，等我完成这一切之后"}, {"type": "subtitle", "time": 18215.43, "timestamp": "05:03:35", "text": "那个东西，对吧，还有数量"}, {"type": "subtitle", "time": 18218.59, "timestamp": "05:03:38", "text": "我收到样品后，会回复说我会保留。"}, {"type": "subtitle", "time": 18222.628, "timestamp": "05:03:42", "text": "我这里还会留四个，然后我会"}, {"type": "subtitle", "time": 18224.43, "timestamp": "05:03:44", "text": "拿一个"}, {"type": "subtitle", "time": 18228.47, "timestamp": "05:03:48", "text": "一半人拿走另一半。这意味着我是"}, {"type": "subtitle", "time": 18231.868, "timestamp": "05:03:51", "text": "期待着像树苗一样掉落"}, {"type": "subtitle", "time": 18235.59, "timestamp": "05:03:55", "text": "比如五、六、七、八，因为"}, {"type": "subtitle", "time": 18238.03, "timestamp": "05:03:58", "text": "有多少片叶子？"}]
[{"type": "subtitle", "time": 21180.628, "timestamp": "05:53:00", "text": "实际上。嗯，这是有目的的。"}, {"type": "subtitle", "time": 21182.43, "timestamp": "05:53:02", "text": "尤其是对于 YouTube 而言，"}, {"type": "subtitle", "time": 21185.91, "timestamp": "05:53:05", "text": "正确的？谁也说不准。呃，你永远不会"}, {"type": "subtitle", "time": 21189.43, "timestamp": "05:53:09", "text": "要知道，呃，对呃，它不像"}, {"type": "subtitle", "time": 21191.27, "timestamp": "05:53:11", "text": "是Twitch吧？你可以立即封禁一个"}, {"type": "subtitle", "time": 21194.31, "timestamp": "05:53:14", "text": "人和其他事，但你需要一个渠道"}, {"type": "subtitle", "time": 21197.35, "timestamp": "05:53:17", "text": "身份证之类的东西，以防万一"}, {"type": "subtitle", "time": 21199.11, "timestamp": "05:53:19", "text": "发生任何事我都需要一个"}, {"type": "subtitle", "time": 21201.83, "timestamp": "05:53:21", "text": "用户的频道 ID，这样我就可以添加它了。"}, {"type": "subtitle", "time": 21204.868, "timestamp": "05:53:24", "text": "在阻止列表中，以便处理类似情况。"}, {"type": "subtitle", "time": 21207.35, "timestamp": "05:53:27", "text": "我需要保留一份记录，以防万一。"}, {"type": "subtitle", "time": 21211.03, "timestamp": "05:53:31", "text": "你知道，而且也是为了……呃"}, {"type": "subtitle", "time": 21214.868, "timestamp": "05:53:34", "text": "一些我想知道的私人事情"}, {"type": "subtitle", "time": 21217.03, "timestamp": "05:53:37", "text": "你们都发些什么信息？"}, {"type": "subtitle", "time": 21219.59, "timestamp": "05:53:39", "text": "这样我以后就可以回顾了，你知道吗？"}, {"type": "subtitle", "time": 21221.75, "timestamp": "05:53:41", "text": "记住，每张面孔都会出现。"}, {"type": "subtitle", "time": 21223.47, "timestamp": "05:53:43", "text": "像溪流一样"}, {"type": "subtitle", "time": 21226.548, "timestamp": "05:53:46", "text": "那。好的。你玩《心跳文学俱乐部》吗？是的，我们"}, {"type": "subtitle", "time": 21228.868, "timestamp": "05:53:48", "text": "完成了。呃，我们最后才完​​成的。"}, {"type": "subtitle", "time": 21230.11, "timestamp": "05:53:50", "text": "溪流。"}, {"type": "subtitle", "time": 21233.99, "timestamp": "05:53:53", "text": "是的。我当时非常痛苦。哦，等等。蜘蛛。"}, {"type": "subtitle", "time": 21235.67, "timestamp": "05:53:55", "text": "哦，不。我被包围了。哦，不。我是"}]
[{"type": "subtitle", "time": 960.11, "timestamp": "00:16:00", "text": "今天我要推出我的会员服务了"}, {"type": "subtitle", "time": 962.629, "timestamp": "00:16:02", "text": "会员资格。你们中的许多人将会"}, {"type": "subtitle", "time": 965.87, "timestamp": "00:16:05", "text": "问，骑师，为什么会员资格"}, {"type": "subtitle", "time": 968.67, "timestamp": "00:16:08", "text": "更便宜？为什么是会员资格"}, {"type": "subtitle", "time": 971.03, "timestamp": "00:16:11", "text": "便宜的？你保留它的原因是什么？"}, {"type": "subtitle", "time": 974.47, "timestamp": "00:16:14", "text": "尽可能用最少的钱？"}, {"type": "subtitle", "time": 976.87, "timestamp": "00:16:16", "text": "你为什么不留着它呢？呃，会有吗？"}, {"type": "subtitle", "time": 979.269, "timestamp": "00:16:19", "text": "未来的层级，那些想要……的人"}, {"type": "subtitle", "time": 982.59, "timestamp": "00:16:22", "text": "支持更多罐头和"}, {"type": "subtitle", "time": 984.87, "timestamp": "00:16:24", "text": "关于这方面的所有问题？"}, {"type": "subtitle", "time": 988.069, "timestamp": "00:16:28", "text": "我今天会讲到这个。我会报道。"}, {"type": "subtitle", "time": 991.15, "timestamp": "00:16:31", "text": "今天。所以别担心。"}, {"type": "subtitle", "time": 999.069, "timestamp": "00:16:39", "text": "是的，首先，我只想……"}, {"type": "subtitle", "time": 1002.55, "timestamp": "00:16:42", "text": "难以置信，这竟然是一场梦"}, {"type": "subtitle", "time": 1004.949, "timestamp": "00:16:44", "text": "梦想成真了，这是我一直以来的梦想。"}, {"type": "subtitle", "time": 1007.629, "timestamp": "00:16:47", "text": "必须得有 YouTube 账号才行。"}, {"type": "subtitle", "time": 1011.11, "timestamp": "00:16:51", "text": "你知道，会员资格，还有昨天"}, {"type": "subtitle", "time": 1013.91, "timestamp": "00:16:53", "text": "当我符合资格时，以及当我"}, {"type": "subtitle", "time": 1017.11, "timestamp": "00:16:57", "text": "我申请后，立刻就被录取了。"}]
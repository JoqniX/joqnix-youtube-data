[{"type": "subtitle", "time": 129.869, "timestamp": "00:02:09", "text": "呃，记得吗？"}, {"type": "subtitle", "time": 133.309, "timestamp": "00:02:13", "text": "一路都是船"}, {"type": "subtitle", "time": 148.57, "timestamp": "00:02:28", "text": "名为 Astral 的成员"}, {"type": "subtitle", "time": 158.19, "timestamp": "00:02:38", "text": "康因斯。我希望命名是"}, {"type": "subtitle", "time": 162.309, "timestamp": "00:02:42", "text": "正确的。但是，嗯，我希望如此。"}, {"type": "subtitle", "time": 166.589, "timestamp": "00:02:46", "text": "已启动。尝试刷新页面等等。"}, {"type": "subtitle", "time": 171.19, "timestamp": "00:02:51", "text": "嗯，请检查一下“加入”按钮是否在那里。"}, {"type": "subtitle", "time": 174.71, "timestamp": "00:02:54", "text": "或不。我不知道。我启动了它。"}, {"type": "subtitle", "time": 176.67000000000002, "timestamp": "00:02:56", "text": "我是"}, {"type": "subtitle", "time": 178.04, "timestamp": "00:02:58", "text": "害怕的。"}, {"type": "subtitle", "time": 179.309, "timestamp": "00:02:59", "text": "[音乐]"}]
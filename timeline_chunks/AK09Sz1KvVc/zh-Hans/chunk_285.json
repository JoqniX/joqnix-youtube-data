[{"type": "subtitle", "time": 17102.27, "timestamp": "04:45:02", "text": "那？那是什么？"}, {"type": "subtitle", "time": 17106.83, "timestamp": "04:45:06", "text": "地方？这看起来像"}, {"type": "subtitle", "time": 17111.08, "timestamp": "04:45:11", "text": "这是什么RGB地方？我的天啊。"}, {"type": "subtitle", "time": 17136.91, "timestamp": "04:45:36", "text": "你？所以，这就是我们共同的水晶世界。"}, {"type": "subtitle", "time": 17147.948, "timestamp": "04:45:47", "text": "哇。这太酷了"}, {"type": "subtitle", "time": 17150.55, "timestamp": "04:45:50", "text": "尽管。我不知道你是怎么做到的"}, {"type": "subtitle", "time": 17152.03, "timestamp": "04:45:52", "text": "制作"}, {"type": "subtitle", "time": 17155.03, "timestamp": "04:45:55", "text": "它。你给我爆米花，我就戳你"}]
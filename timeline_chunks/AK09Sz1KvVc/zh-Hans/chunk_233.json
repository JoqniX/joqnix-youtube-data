[{"type": "subtitle", "time": 13992.269, "timestamp": "03:53:12", "text": "我？"}, {"type": "subtitle", "time": 13995.469, "timestamp": "03:53:15", "text": "所以，我应该杀了这只小鸭子吗？"}, {"type": "subtitle", "time": 14000.03, "timestamp": "03:53:20", "text": "不。小鸭子有好处。"}, {"type": "subtitle", "time": 14003.63, "timestamp": "03:53:23", "text": "笑声真的很大"}, {"type": "subtitle", "time": 14007.11, "timestamp": "03:53:27", "text": "杀死它们之后，还传来一阵嘈杂声。"}, {"type": "subtitle", "time": 14011.11, "timestamp": "03:53:31", "text": "我现在给你巧克力。耶。是的。"}, {"type": "subtitle", "time": 14013.79, "timestamp": "03:53:33", "text": "送巧克力。巧克力。"}, {"type": "subtitle", "time": 14016.07, "timestamp": "03:53:36", "text": "巧克力。好的。我可以分享我的"}, {"type": "subtitle", "time": 14017.55, "timestamp": "03:53:37", "text": "巧克力？"}, {"type": "subtitle", "time": 14019.95, "timestamp": "03:53:39", "text": "是的。"}, {"type": "subtitle", "time": 14021.71, "timestamp": "03:53:41", "text": "一个。"}, {"type": "subtitle", "time": 14025.189, "timestamp": "03:53:45", "text": "你好。你好。"}]
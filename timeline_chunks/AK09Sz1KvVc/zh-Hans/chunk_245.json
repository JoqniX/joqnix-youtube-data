[{"type": "subtitle", "time": 14723.309, "timestamp": "04:05:23", "text": "是的。"}, {"type": "subtitle", "time": 14733.389, "timestamp": "04:05:33", "text": "热风枪。是的。你好。你好吗？热"}, {"type": "subtitle", "time": 14736.469, "timestamp": "04:05:36", "text": "枪。希望你一切都好。是的。"}, {"type": "subtitle", "time": 14746.11, "timestamp": "04:05:46", "text": "你好。这是怎么回事？我正在做我的"}, {"type": "subtitle", "time": 14747.95, "timestamp": "04:05:47", "text": "冒险"}, {"type": "subtitle", "time": 14750.389, "timestamp": "04:05:50", "text": "经验。所以，我们就像在尝试……"}, {"type": "subtitle", "time": 14752.189, "timestamp": "04:05:52", "text": "寻找"}, {"type": "subtitle", "time": 14756.75, "timestamp": "04:05:56", "text": "嗯，我正在寻找一朵樱花。"}, {"type": "subtitle", "time": 14759.269, "timestamp": "04:05:59", "text": "这样我就可以，你知道，创造我的生物群落"}]
[{"type": "subtitle", "time": 19621.51, "timestamp": "05:27:01", "text": "呃，我做了这种，我想是因为我会……"}, {"type": "subtitle", "time": 19629.92, "timestamp": "05:27:09", "text": "阿富汗人就是阿富汗人？我不"}, {"type": "subtitle", "time": 19632.43, "timestamp": "05:27:12", "text": "[音乐]"}, {"type": "subtitle", "time": 19636.788, "timestamp": "05:27:16", "text": "知道。床很有弹性。哦，被挡住了。"}, {"type": "subtitle", "time": 19644.19, "timestamp": "05:27:24", "text": "不。好了。这样我就可以睡觉了。"}, {"type": "subtitle", "time": 19646.948, "timestamp": "05:27:26", "text": "好的，我就把它放在这儿，然后……"}, {"type": "subtitle", "time": 19648.19, "timestamp": "05:27:28", "text": "正确的"}, {"type": "subtitle", "time": 19651.19, "timestamp": "05:27:31", "text": "后退。好的。哦，等等。我有点想要"}, {"type": "subtitle", "time": 19658.35, "timestamp": "05:27:38", "text": "一个"}, {"type": "subtitle", "time": 19661.628, "timestamp": "05:27:41", "text": "咱们欣赏一下风景吧？我需要"}, {"type": "subtitle", "time": 19664.83, "timestamp": "05:27:44", "text": "即使我有一个"}, {"type": "subtitle", "time": 19668.19, "timestamp": "05:27:48", "text": "风景，然后我"}, {"type": "subtitle", "time": 19671.59, "timestamp": "05:27:51", "text": "估计这样行得通。这将是"}, {"type": "subtitle", "time": 19672.35, "timestamp": "05:27:52", "text": "好的"}]
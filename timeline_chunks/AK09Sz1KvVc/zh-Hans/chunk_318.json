[{"type": "subtitle", "time": 19089.948, "timestamp": "05:18:09", "text": "哇。好的。我把它放上去"}, {"type": "subtitle", "time": 19097.59, "timestamp": "05:18:17", "text": "那。这边有一棵小树苗。"}, {"type": "subtitle", "time": 19099.948, "timestamp": "05:18:19", "text": "别介意我拿"}, {"type": "subtitle", "time": 19103.36, "timestamp": "05:18:23", "text": "它。我只是个园丁。哦，我是"}]
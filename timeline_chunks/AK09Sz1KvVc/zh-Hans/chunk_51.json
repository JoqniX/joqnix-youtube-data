[{"type": "subtitle", "time": 3060.589, "timestamp": "00:51:00", "text": "那。"}, {"type": "subtitle", "time": 3064.47, "timestamp": "00:51:04", "text": "不，没有，那里没有。"}, {"type": "subtitle", "time": 3066.79, "timestamp": "00:51:06", "text": "对双方来说，没有什么是无关紧要的。"}, {"type": "subtitle", "time": 3070.309, "timestamp": "00:51:10", "text": "由于流元素的限制"}, {"type": "subtitle", "time": 3073.109, "timestamp": "00:51:13", "text": "限制本身。"}, {"type": "subtitle", "time": 3075.99, "timestamp": "00:51:15", "text": "兄弟，你知道有多少时间多少"}, {"type": "subtitle", "time": 3079.349, "timestamp": "00:51:19", "text": "我曾多次……呃，绕到Stream后面。"}, {"type": "subtitle", "time": 3082.47, "timestamp": "00:51:22", "text": "元素人只是为了确保他们"}, {"type": "subtitle", "time": 3085.47, "timestamp": "00:51:25", "text": "或许可以做到"}, {"type": "subtitle", "time": 3088.549, "timestamp": "00:51:28", "text": "就像做这个功能一样，他们"}, {"type": "subtitle", "time": 3091.19, "timestamp": "00:51:31", "text": "就像他们如何直播一样合并它们"}, {"type": "subtitle", "time": 3093.87, "timestamp": "00:51:33", "text": "竞争对手 Streamlabs 已经做到了"}, {"type": "subtitle", "time": 3101.91, "timestamp": "00:51:41", "text": "所以，我在想或许我们可以禁用它。"}, {"type": "subtitle", "time": 3106.67, "timestamp": "00:51:46", "text": "YouTube 计时器和我"}, {"type": "subtitle", "time": 3118.309, "timestamp": "00:51:58", "text": "尽管。或许我们可以换一个。"}]
[{"type": "subtitle", "time": 17706.708, "timestamp": "04:55:06", "text": "方式。你好呀。他快要窒息了"}, {"type": "subtitle", "time": 17708.948, "timestamp": "04:55:08", "text": "或者别的什么。我不知道。总之，我是"}, {"type": "subtitle", "time": 17709.868, "timestamp": "04:55:09", "text": "后退"}, {"type": "subtitle", "time": 17711.948, "timestamp": "04:55:11", "text": "这里。这些都是"}, {"type": "subtitle", "time": 17714.11, "timestamp": "04:55:14", "text": "红树林被剥蚀"}, {"type": "subtitle", "time": 17718.47, "timestamp": "04:55:18", "text": "luc 樱桃日志就是这样。好的。所以，"}, {"type": "subtitle", "time": 17719.708, "timestamp": "04:55:19", "text": "他们使用"}, {"type": "subtitle", "time": 17728.07, "timestamp": "04:55:28", "text": "呃，应该是日志吧。樱桃原木会像这样"}, {"type": "subtitle", "time": 17732.23, "timestamp": "04:55:32", "text": "这片黑暗。好的。樱桃木楼梯"}, {"type": "subtitle", "time": 17736.15, "timestamp": "04:55:36", "text": "红色的。好的。樱桃木栅栏。好的。"}, {"type": "subtitle", "time": 17738.15, "timestamp": "04:55:38", "text": "那么，我为什么又来这里了呢？我不知道"}, {"type": "subtitle", "time": 17740.35, "timestamp": "04:55:40", "text": "这是谁的房子？但他们如此"}, {"type": "subtitle", "time": 17743.11, "timestamp": "04:55:43", "text": "凉爽的。凉爽的。凉爽的。我想知道是谁"}, {"type": "subtitle", "time": 17744.75, "timestamp": "04:55:44", "text": "建造它，但是"}, {"type": "subtitle", "time": 17746.75, "timestamp": "04:55:46", "text": "是的。樱桃"}, {"type": "subtitle", "time": 17751.43, "timestamp": "04:55:51", "text": "走吧。不，不，不。我不想死。"}, {"type": "subtitle", "time": 17752.47, "timestamp": "04:55:52", "text": "我不想死。我不想"}, {"type": "subtitle", "time": 17753.67, "timestamp": "04:55:53", "text": "死。我不想死。我不想"}]
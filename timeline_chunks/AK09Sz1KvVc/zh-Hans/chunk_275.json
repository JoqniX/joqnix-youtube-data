[{"type": "subtitle", "time": 16500.91, "timestamp": "04:35:00", "text": "哦，这里有一份春季日历。哦，我的"}, {"type": "subtitle", "time": 16505.629, "timestamp": "04:35:05", "text": "上帝。目前窗口上有 22 个。"}, {"type": "subtitle", "time": 16507.629, "timestamp": "04:35:07", "text": "哦。哦"}, {"type": "subtitle", "time": 16510.59, "timestamp": "04:35:10", "text": "男生。我的天哪。真是这样"}, {"type": "subtitle", "time": 16514.39, "timestamp": "04:35:14", "text": "凉爽的。一个钟和一本书，就能度过一个季节"}, {"type": "subtitle", "time": 16516.629, "timestamp": "04:35:16", "text": "日历。好的。哦，我可以悬停。"}, {"type": "subtitle", "time": 16520.31, "timestamp": "04:35:20", "text": "超过它。真是太方便了。"}, {"type": "subtitle", "time": 16523.799, "timestamp": "04:35:23", "text": "真是太方便了。 是的。春天来了。我认为是弹簧。等待，"}, {"type": "subtitle", "time": 16527.92, "timestamp": "04:35:27", "text": "是的。春天来了。我认为是弹簧。等待， 那"}, {"type": "subtitle", "time": 16538.07, "timestamp": "04:35:38", "text": "这意味着像"}, {"type": "subtitle", "time": 16539.869, "timestamp": "04:35:39", "text": "呃"}, {"type": "subtitle", "time": 16542.269, "timestamp": "04:35:42", "text": "在喜欢"}, {"type": "subtitle", "time": 16545.109, "timestamp": "04:35:45", "text": "樱桃。哎呀，好多樱桃啊！"}, {"type": "subtitle", "time": 16547.189, "timestamp": "04:35:47", "text": "东西。"}, {"type": "subtitle", "time": 16549.07, "timestamp": "04:35:49", "text": "樱桃"}, {"type": "subtitle", "time": 16552.349, "timestamp": "04:35:52", "text": "木板，樱桃木原木，"}, {"type": "subtitle", "time": 16556.31, "timestamp": "04:35:56", "text": "樱桃橡树等等，所以，红色的东西是什么？"}, {"type": "subtitle", "time": 16559.269, "timestamp": "04:35:59", "text": "我们之前在产卵地附近看到的是樱桃树"}]
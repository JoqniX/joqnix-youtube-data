[{"type": "subtitle", "time": 14221.11, "timestamp": "03:57:01", "text": "我真的，真的，真的，真的，真的"}, {"type": "subtitle", "time": 14224.469, "timestamp": "03:57:04", "text": "我不想死在这里。所以，"}, {"type": "subtitle", "time": 14231.71, "timestamp": "03:57:11", "text": "这里。"}, {"type": "subtitle", "time": 14234.349, "timestamp": "03:57:14", "text": "好的，下一个"}, {"type": "subtitle", "time": 14237.03, "timestamp": "03:57:17", "text": "角落。是的，我在这里放了一块面包。"}, {"type": "subtitle", "time": 14237.29, "timestamp": "03:57:17", "text": "为了"}, {"type": "subtitle", "time": 14240.349, "timestamp": "03:57:20", "text": "[音乐]"}, {"type": "subtitle", "time": 14251.11, "timestamp": "03:57:31", "text": "我以为这个东西就是这个模组"}, {"type": "subtitle", "time": 14254.51, "timestamp": "03:57:34", "text": "我不需要使用类似的东西"}, {"type": "subtitle", "time": 14256.99, "timestamp": "03:57:36", "text": "呃"}, {"type": "subtitle", "time": 14264.189, "timestamp": "03:57:44", "text": "[音乐]"}, {"type": "subtitle", "time": 14268.389, "timestamp": "03:57:48", "text": "呃，制作东西，把所有东西都做出来"}, {"type": "subtitle", "time": 14269.87, "timestamp": "03:57:49", "text": "东西。但显然你需要一个"}, {"type": "subtitle", "time": 14272.229, "timestamp": "03:57:52", "text": "工作台，用来制作物品。好的，"}, {"type": "subtitle", "time": 14275.55, "timestamp": "03:57:55", "text": "我们走吧。我会一直让床保持死寂状态。"}]
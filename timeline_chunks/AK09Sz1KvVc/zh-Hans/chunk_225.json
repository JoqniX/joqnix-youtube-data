[{"type": "subtitle", "time": 13505.91, "timestamp": "03:45:05", "text": "某物？刚从后面回来"}, {"type": "subtitle", "time": 13508.309, "timestamp": "03:45:08", "text": "来自课堂。好的。真好。是的，"}, {"type": "subtitle", "time": 13513.03, "timestamp": "03:45:13", "text": "是的。而且斯托实际上也加入了"}, {"type": "subtitle", "time": 13515.03, "timestamp": "03:45:15", "text": "我也想加入服务器。他"}, {"type": "subtitle", "time": 13517.51, "timestamp": "03:45:17", "text": "实际上已经设置了白名单。"}, {"type": "subtitle", "time": 13521.59, "timestamp": "03:45:21", "text": "不，不。迫不及待地想看到他也不这样。"}, {"type": "subtitle", "time": 13528.07, "timestamp": "03:45:28", "text": "我。是啊，伙计。很多事情"}, {"type": "subtitle", "time": 13530.87, "timestamp": "03:45:30", "text": "测试版发布后就立刻改变了。"}, {"type": "subtitle", "time": 13533.91, "timestamp": "03:45:33", "text": "那次测试我们做了。我们改变了"}, {"type": "subtitle", "time": 13535.15, "timestamp": "03:45:35", "text": "很多"}, {"type": "subtitle", "time": 13538.229, "timestamp": "03:45:38", "text": "东西，然后我就不用GD之类的了。"}, {"type": "subtitle", "time": 13540.229, "timestamp": "03:45:40", "text": "启动器并开始使用"}, {"type": "subtitle", "time": 13542.79, "timestamp": "03:45:42", "text": "不，不，不，不，不，不，不，不，不，不"}, {"type": "subtitle", "time": 13555.15, "timestamp": "03:45:55", "text": "疼痛。哦，"}, {"type": "subtitle", "time": 13558.95, "timestamp": "03:45:58", "text": "疼痛。我是那样的人吗？等等，是300米。好的，"}]
[{"type": "subtitle", "time": 21360.708, "timestamp": "05:56:00", "text": "所以，我已经很久很久没玩了。"}, {"type": "subtitle", "time": 21366.23, "timestamp": "05:56:06", "text": "我不需要去下界。"}, {"type": "subtitle", "time": 21369.51, "timestamp": "05:56:09", "text": "此刻，因为我需要，我需要做出决定"}, {"type": "subtitle", "time": 21372.47, "timestamp": "05:56:12", "text": "我建好房子，就像你知道的那样安顿下来"}, {"type": "subtitle", "time": 21374.43, "timestamp": "05:56:14", "text": "第一垒"}, {"type": "subtitle", "time": 21378.59, "timestamp": "05:56:18", "text": "然后探索下界，那就是……"}, {"type": "subtitle", "time": 21380.42, "timestamp": "05:56:20", "text": "做事的方法"}, {"type": "subtitle", "time": 21383.47, "timestamp": "05:56:23", "text": "[音乐]"}, {"type": "subtitle", "time": 21386.39, "timestamp": "05:56:26", "text": "它。让我们来制作，我知道怎么做"}, {"type": "subtitle", "time": 21389.11, "timestamp": "05:56:29", "text": "是的，但我现在不想做。"}, {"type": "subtitle", "time": 21391.39, "timestamp": "05:56:31", "text": "我想安顿下来"}, {"type": "subtitle", "time": 21394.67, "timestamp": "05:56:34", "text": "已经倒下了。我一直快要死了"}, {"type": "subtitle", "time": 21398.708, "timestamp": "05:56:38", "text": "很多。我想先安定下来。你"}, {"type": "subtitle", "time": 21400.59, "timestamp": "05:56:40", "text": "不"}, {"type": "subtitle", "time": 21403.03, "timestamp": "05:56:43", "text": "头脑。所以，我就像在寻找一个好的"}, {"type": "subtitle", "time": 21405.83, "timestamp": "05:56:45", "text": "去某个地方"}, {"type": "subtitle", "time": 21409.91, "timestamp": "05:56:49", "text": "呃，我大概有44颗粉红色的樱桃。"}, {"type": "subtitle", "time": 21412.07, "timestamp": "05:56:52", "text": "呃，树苗。所以，我有点想做"}, {"type": "subtitle", "time": 21413.31, "timestamp": "05:56:53", "text": "喜欢"}, {"type": "subtitle", "time": 21418.19, "timestamp": "05:56:58", "text": "整个生物群落，整片土地都长满了樱桃树"}]
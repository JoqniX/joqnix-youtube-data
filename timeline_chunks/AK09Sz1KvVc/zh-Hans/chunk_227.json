[{"type": "subtitle", "time": 13623.87, "timestamp": "03:47:03", "text": "它？鞍。对，马鞍。"}, {"type": "subtitle", "time": 13625.56, "timestamp": "03:47:05", "text": "鞍。 正确的。天哪，有那么多冒险等着我去经历呢！"}, {"type": "subtitle", "time": 13635.429, "timestamp": "03:47:15", "text": "今天。是的。首先，我们来找一个"}, {"type": "subtitle", "time": 13638.55, "timestamp": "03:47:18", "text": "樱花树下，我可以在那里建房子。"}, {"type": "subtitle", "time": 13641.79, "timestamp": "03:47:21", "text": "因为我想在……建一栋房子"}, {"type": "subtitle", "time": 13644.55, "timestamp": "03:47:24", "text": "樱花。然后万圣节期间，我将"}, {"type": "subtitle", "time": 13647.269, "timestamp": "03:47:27", "text": "在这个地方做点什么"}, {"type": "subtitle", "time": 13649.95, "timestamp": "03:47:29", "text": "哪个更符合万圣节主题？"}, {"type": "subtitle", "time": 13664.87, "timestamp": "03:47:44", "text": "东西。等等，所以你还没添加“喜欢”选项"}, {"type": "subtitle", "time": 13672.229, "timestamp": "03:47:52", "text": "然而？等等，吃葡萄也不错。"}, {"type": "subtitle", "time": 13673.87, "timestamp": "03:47:53", "text": "好吗？我不"}, {"type": "subtitle", "time": 13678.349, "timestamp": "03:47:58", "text": "知道。哇。我希望不会花费太长时间"}]
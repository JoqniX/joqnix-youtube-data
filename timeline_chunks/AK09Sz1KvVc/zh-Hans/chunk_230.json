[{"type": "subtitle", "time": 13800.11, "timestamp": "03:50:00", "text": "刷子"}, {"type": "subtitle", "time": 13808.429, "timestamp": "03:50:08", "text": "丢弃。那是锁之类的东西吗？不。"}, {"type": "subtitle", "time": 13828.269, "timestamp": "03:50:28", "text": "那？运气"}, {"type": "subtitle", "time": 13831.189, "timestamp": "03:50:31", "text": "炸弹。您无权使用"}, {"type": "subtitle", "time": 13833.59, "timestamp": "03:50:33", "text": "任何子命令。好的，原来如此。所以，我"}, {"type": "subtitle", "time": 13835.55, "timestamp": "03:50:35", "text": "什么都用不了。"}, {"type": "subtitle", "time": 13839.03, "timestamp": "03:50:39", "text": "好的，还有。那我们就自己去找吧。"}, {"type": "subtitle", "time": 13848.15, "timestamp": "03:50:48", "text": "欺骗。不得不这么做。不得不这么做。"}]
[{"type": "subtitle", "time": 17220.92, "timestamp": "04:47:00", "text": "爆米花。 流行色情片。爆米花。他们"}, {"type": "subtitle", "time": 17225.48, "timestamp": "04:47:05", "text": "流行色情片。爆米花。他们 爆米花。谢谢。"}, {"type": "subtitle", "time": 17233.31, "timestamp": "04:47:13", "text": "谢谢。巴卡"}, {"type": "subtitle", "time": 17235.708, "timestamp": "04:47:15", "text": "车。这辆车"}, {"type": "subtitle", "time": 17245.948, "timestamp": "04:47:25", "text": "车。我是一名"}, {"type": "subtitle", "time": 17249.91, "timestamp": "04:47:29", "text": "明星安慰奖。不，蓝色魔法"}, {"type": "subtitle", "time": 17252.07, "timestamp": "04:47:32", "text": "日志。哦，等等。我需要这样。绝不"}, {"type": "subtitle", "time": 17255.708, "timestamp": "04:47:35", "text": "头脑。这里有一棵小树苗。我确实有一个。"}, {"type": "subtitle", "time": 17258.47, "timestamp": "04:47:38", "text": "树苗。我觉得是有人栽赃的。"}, {"type": "subtitle", "time": 17260.19, "timestamp": "04:47:40", "text": "所以，我只是"}, {"type": "subtitle", "time": 17263.51, "timestamp": "04:47:43", "text": "需要啊，不，不，不，不，不，不。"}, {"type": "subtitle", "time": 17265.35, "timestamp": "04:47:45", "text": "别那样做。别那样做。不要这样做"}, {"type": "subtitle", "time": 17266.788, "timestamp": "04:47:46", "text": "那。别那样做。你敢！"}, {"type": "subtitle", "time": 17268.15, "timestamp": "04:47:48", "text": "你别那样做。你别那样做。不"}, {"type": "subtitle", "time": 17269.51, "timestamp": "04:47:49", "text": "你这样做。你别那样做。难道你不这么认为吗？"}, {"type": "subtitle", "time": 17271.628, "timestamp": "04:47:51", "text": "那。难道你不这么认为吗？"}, {"type": "subtitle", "time": 17273.628, "timestamp": "04:47:53", "text": "那。"}, {"type": "subtitle", "time": 17277.27, "timestamp": "04:47:57", "text": "圣。我想敲你的头。 N."}]
[{"type": "subtitle", "time": 13083.349, "timestamp": "03:38:03", "text": "等等，他們不會"}, {"type": "subtitle", "time": 13094.19, "timestamp": "03:38:14", "text": "掉東西吧？  不，我殺了一個無辜的人"}, {"type": "subtitle", "time": 13112.36, "timestamp": "03:38:32", "text": "帕科殺害了一名無辜者。"}, {"type": "subtitle", "time": 13115.07, "timestamp": "03:38:35", "text": "[音樂]"}, {"type": "subtitle", "time": 13119.59, "timestamp": "03:38:39", "text": "否。好的。呃，我們這是在哪裡？我需要"}, {"type": "subtitle", "time": 13121.71, "timestamp": "03:38:41", "text": "找到最"}, {"type": "subtitle", "time": 13123.99, "timestamp": "03:38:43", "text": "準確的答案。哦，等等。這是一條河，"}, {"type": "subtitle", "time": 13130.55, "timestamp": "03:38:50", "text": "設定來著"}]
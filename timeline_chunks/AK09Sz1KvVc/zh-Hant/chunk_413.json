[{"type": "subtitle", "time": 24783.35, "timestamp": "06:53:03", "text": "才華越多，就越容易"}, {"type": "subtitle", "time": 24786.35, "timestamp": "06:53:06", "text": "獲得認可等等。所以我"}, {"type": "subtitle", "time": 24789.35, "timestamp": "06:53:09", "text": "想，目前我還是要盡我所能做好運動員這個角色"}, {"type": "subtitle", "time": 24792.23, "timestamp": "06:53:12", "text": "。接下來，Jo 是我畢生的項目，也是我的"}, {"type": "subtitle", "time": 24795.43, "timestamp": "06:53:15", "text": "人生目標。所以我現在會專注於此"}, {"type": "subtitle", "time": 24797.51, "timestamp": "06:53:17", "text": "。等到我對一切都滿意"}, {"type": "subtitle", "time": 24799.67, "timestamp": "06:53:19", "text": "之後，我就會轉而投入 Onexa 的"}, {"type": "subtitle", "time": 24802.548, "timestamp": "06:53:22", "text": "事情上，更專注於"}, {"type": "subtitle", "time": 24805.67, "timestamp": "06:53:25", "text": "讓這個我充滿熱情的專案重新啟動"}, {"type": "subtitle", "time": 24807.868, "timestamp": "06:53:27", "text": "並運作起來"}, {"type": "subtitle", "time": 24815.91, "timestamp": "06:53:35", "text": "是啊，還有很多事要做呢。"}, {"type": "subtitle", "time": 24819.51, "timestamp": "06:53:39", "text": "你知道，我有很多想做的事情。我想"}, {"type": "subtitle", "time": 24822.43, "timestamp": "06:53:42", "text": "製作自己的演唱會直播，並自己剪輯"}, {"type": "subtitle", "time": 24825.03, "timestamp": "06:53:45", "text": "演唱會影片。就像我的孩子一樣，就像"}, {"type": "subtitle", "time": 24827.35, "timestamp": "06:53:47", "text": "我剛開始直播的時候，"}, {"type": "subtitle", "time": 24829.27, "timestamp": "06:53:49", "text": "有一個叫"}, {"type": "subtitle", "time": 24833.27, "timestamp": "06:53:53", "text": "壽司龍的 Twitch 主播。他是一位網路主播，擅長"}, {"type": "subtitle", "time": 24836.788, "timestamp": "06:53:56", "text": "用他的技術做一些瘋狂的事情，"}, {"type": "subtitle", "time": 24839.27, "timestamp": "06:53:59", "text": "例如即時剪輯、一些顯而易見的事情，"}]
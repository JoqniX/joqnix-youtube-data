[{"type": "subtitle", "time": 14347.229, "timestamp": "03:59:07", "text": "哦。哦，或許我可以這樣走"}, {"type": "subtitle", "time": 14360.91, "timestamp": "03:59:20", "text": "其實，我只是想"}, {"type": "subtitle", "time": 14367.95, "timestamp": "03:59:27", "text": "叢中安家。那是誰"}, {"type": "subtitle", "time": 14371.229, "timestamp": "03:59:31", "text": "？那是一個人，對吧？"}, {"type": "subtitle", "time": 14373.349, "timestamp": "03:59:33", "text": "哦，那是村民。等等，等等，等等，等等。那是一位村民。  聖。呃，我們"}, {"type": "subtitle", "time": 14388.63, "timestamp": "03:59:48", "text": "走吧。等待。分享航點。等等，等等，等等，等等，等等，等等。  新增交易穹頂"}, {"type": "subtitle", "time": 14394.83, "timestamp": "03:59:54", "text": "項目"}, {"type": "subtitle", "time": 14397.189, "timestamp": "03:59:57", "text": "一。哪裡是？哪裡是？"}]
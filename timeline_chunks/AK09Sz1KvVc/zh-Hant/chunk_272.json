[{"type": "subtitle", "time": 16320.99, "timestamp": "04:32:00", "text": "很正常。罌粟花寬闊的阿蒙。  好的。這是什麼？末端燈泡燈籠"}, {"type": "subtitle", "time": 16327.03, "timestamp": "04:32:07", "text": "。哇，這裡有很多"}, {"type": "subtitle", "time": 16343.469, "timestamp": "04:32:23", "text": "什麼？  我認為這是附魔的原木。是魔法樹，對吧？這裡還有一個藍色的地方。  哦，這裡"}, {"type": "subtitle", "time": 16347.189, "timestamp": "04:32:27", "text": "好像有什麼機關。"}, {"type": "subtitle", "time": 16359.349, "timestamp": "04:32:39", "text": "這些是什麼？但看起來好像這邊有東西被高亮顯示了。  但當你"}, {"type": "subtitle", "time": 16360.99, "timestamp": "04:32:40", "text": "走進這個地方，你會發現它就像一個巨大的圓頂。太酷了。太酷了。碎紙穹頂項目一"}]
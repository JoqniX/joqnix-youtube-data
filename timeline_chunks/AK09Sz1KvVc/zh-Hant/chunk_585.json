[{"type": "subtitle", "time": 35144.15, "timestamp": "09:45:44", "text": "。 Ryuka 或 Ryu。好的。別忘了把 Twitch 的名字改回來。"}, {"type": "subtitle", "time": 35147.19, "timestamp": "09:45:47", "text": "所以，我，所以或是"}, {"type": "subtitle", "time": 35149.67, "timestamp": "09:45:49", "text": "別的什麼。所以我需要慢慢習慣。不。你好。由你決定。呃，"}, {"type": "subtitle", "time": 35153.99, "timestamp": "09:45:53", "text": "你不需要"}, {"type": "subtitle", "time": 35157.55, "timestamp": "09:45:57", "text": "改變。我會習慣的。我已經習慣抽大麻了。所以就去那裡吧。你現在"}]
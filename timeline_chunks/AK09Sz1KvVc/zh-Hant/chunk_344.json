[{"type": "subtitle", "time": 20654.51, "timestamp": "05:44:14", "text": "希望你一切都好。我相信這是"}, {"type": "subtitle", "time": 20658.19, "timestamp": "05:44:18", "text": "你第一次來這裡，"}, {"type": "subtitle", "time": 20665.788, "timestamp": "05:44:25", "text": "你好嗎？哦。呃，亞洲檢查"}, {"type": "subtitle", "time": 20680.47, "timestamp": "05:44:40", "text": "。呃，Junky，呃，"}, {"type": "subtitle", "time": 20682.548, "timestamp": "05:44:42", "text": "Frederick。癮君子弗雷德里克。等等，那是什麼？等等，什麼？那是舊帳號。哦，等等。哦好的"}, {"type": "subtitle", "time": 20694.39, "timestamp": "05:44:54", "text": "。好的，那是舊帳號。好的，那是"}, {"type": "subtitle", "time": 20696.948, "timestamp": "05:44:56", "text": "你的舊帳號。  等等，你的意思是像 Azer Asteroth 的兒子那樣嗎？"}]
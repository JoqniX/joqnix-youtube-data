[{"type": "subtitle", "time": 37030.31, "timestamp": "10:17:10", "text": "傻笑？為什麼？我沒找到"}, {"type": "subtitle", "time": 37048.07, "timestamp": "10:17:28", "text": "不。哦，不。不，不，不，哦不。  哦，不。不，不，哦，不。請。"}, {"type": "subtitle", "time": 37052.15, "timestamp": "10:17:32", "text": "請"}, {"type": "subtitle", "time": 37054.746, "timestamp": "10:17:34", "text": "不要這樣做。請不要死。請不要死。請不要死"}, {"type": "subtitle", "time": 37056.79, "timestamp": "10:17:36", "text": "。請不要死。"}, {"type": "subtitle", "time": 37057.746, "timestamp": "10:17:37", "text": "請不要死。請不要死。  請不要死。"}, {"type": "subtitle", "time": 37059.39, "timestamp": "10:17:39", "text": "請不要死。  請。"}, {"type": "subtitle", "time": 37061.586, "timestamp": "10:17:41", "text": "哈利路亞。哈利路亞。我的"}, {"type": "subtitle", "time": 37068.31, "timestamp": "10:17:48", "text": "求求你，求求你，求求你，求求你，求求你"}, {"type": "subtitle", "time": 37074.06, "timestamp": "10:17:54", "text": "不求你了"}]
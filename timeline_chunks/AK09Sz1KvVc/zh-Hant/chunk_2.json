[{"type": "subtitle", "time": 129.869, "timestamp": "00:02:09", "text": "呃，記得那些船，那些船一直"}, {"type": "subtitle", "time": 148.57, "timestamp": "00:02:28", "text": "成員，名叫 Astral"}, {"type": "subtitle", "time": 158.19, "timestamp": "00:02:38", "text": "Conions。我希望命名"}, {"type": "subtitle", "time": 162.309, "timestamp": "00:02:42", "text": "正確。但是，嗯，我希望它能"}, {"type": "subtitle", "time": 166.589, "timestamp": "00:02:46", "text": "上線。嘗試刷新頁面等等。"}, {"type": "subtitle", "time": 171.19, "timestamp": "00:02:51", "text": "嗯，請檢查一下“加入”按鈕是否存在"}, {"type": "subtitle", "time": 174.71, "timestamp": "00:02:54", "text": "。我不知道。我啟動了它。"}, {"type": "subtitle", "time": 176.67000000000002, "timestamp": "00:02:56", "text": "我很"}, {"type": "subtitle", "time": 178.04, "timestamp": "00:02:58", "text": "害怕。"}, {"type": "subtitle", "time": 179.309, "timestamp": "00:02:59", "text": "[音樂]"}]
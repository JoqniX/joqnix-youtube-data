[{"type": "subtitle", "time": 35834.95, "timestamp": "09:57:14", "text": "我在尋找末影人。"}, {"type": "subtitle", "time": 35838.11, "timestamp": "09:57:18", "text": "他為什麼沒來？就像往常一樣，你會在任何地方發現"}, {"type": "subtitle", "time": 35840.66, "timestamp": "09:57:20", "text": "散落的末影人"}, {"type": "subtitle", "time": 35853.266, "timestamp": "09:57:33", "text": "。我只需要一根末端桿。"}, {"type": "subtitle", "time": 35871.83, "timestamp": "09:57:51", "text": "哦。哦。哦。另外，我"}, {"type": "subtitle", "time": 35874.95, "timestamp": "09:57:54", "text": "沒有床。所以，我要去睡一會兒。帶"}]
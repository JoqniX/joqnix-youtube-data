[{"type": "subtitle", "time": 36912.39, "timestamp": "10:15:12", "text": "這裡沒有鑽石。我的天啊。  是的。"}, {"type": "subtitle", "time": 36915.11, "timestamp": "10:15:15", "text": "這裡沒有鑽石。我得回家了。不。"}, {"type": "subtitle", "time": 36945.586, "timestamp": "10:15:45", "text": "東西。探索深洞真是太"}, {"type": "subtitle", "time": 36947.39, "timestamp": "10:15:47", "text": "有趣了。我們需要"}, {"type": "subtitle", "time": 36950.83, "timestamp": "10:15:50", "text": "更多地這樣做。但是，我也得回家了"}, {"type": "subtitle", "time": 36957.99, "timestamp": "10:15:57", "text": "影人。但我有鑽石。我可以"}]
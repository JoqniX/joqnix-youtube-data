[{"type": "subtitle", "time": 24721.75, "timestamp": "06:52:01", "text": "需要很多人幫忙，"}, {"type": "subtitle", "time": 24725.03, "timestamp": "06:52:05", "text": "像是美術、漫畫、故事"}, {"type": "subtitle", "time": 24728.31, "timestamp": "06:52:08", "text": "、音樂等等，"}, {"type": "subtitle", "time": 24730.468, "timestamp": "06:52:10", "text": "太多東西了，對吧？很"}, {"type": "subtitle", "time": 24732.15, "timestamp": "06:52:12", "text": "費錢，你需要很多"}, {"type": "subtitle", "time": 24734.868, "timestamp": "06:52:14", "text": "人脈，需要"}, {"type": "subtitle", "time": 24737.11, "timestamp": "06:52:17", "text": "願意幫助你的人，但我沒有這些，我只能靠自己，孤軍奮戰。天哪，"}, {"type": "subtitle", "time": 24744.39, "timestamp": "06:52:24", "text": "英文真差勁！所以我"}, {"type": "subtitle", "time": 24747.11, "timestamp": "06:52:27", "text": "意識到，我得暫時把這個"}, {"type": "subtitle", "time": 24750.11, "timestamp": "06:52:30", "text": "項目存檔，這就是它被"}, {"type": "subtitle", "time": 24752.708, "timestamp": "06:52:32", "text": "存檔的原因。我想我之前提到過，是的，這就是它被存檔的原因。這樣我就"}, {"type": "subtitle", "time": 24758.868, "timestamp": "06:52:38", "text": "可以專注於下一個項目，"}, {"type": "subtitle", "time": 24761.11, "timestamp": "06:52:41", "text": "盡可能地擴大規模。所以，我沒有那種"}, {"type": "chat", "time": 24767.445, "timestamp": "06:52:47", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "It's actually really fascinating... you came a long way and there's more to go"}, {"type": "subtitle", "time": 24770.548, "timestamp": "06:52:50", "text": "因為粉絲數量少或別人"}, {"type": "subtitle", "time": 24772.31, "timestamp": "06:52:52", "text": "因為我粉絲數量少而評判我，或"}, {"type": "subtitle", "time": 24774.548, "timestamp": "06:52:54", "text": "其他任何原因而無法與我想合作的人合作的問題。所以我不想"}, {"type": "subtitle", "time": 24777.75, "timestamp": "06:52:57", "text": "那樣，在這個行業裡，人脈越多，"}]
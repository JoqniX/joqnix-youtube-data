[{"type": "subtitle", "time": 25261.39, "timestamp": "07:01:01", "text": "格羅納。瓜納。因為兄弟有"}, {"type": "subtitle", "time": 25268.51, "timestamp": "07:01:08", "text": "[音樂]"}, {"type": "subtitle", "time": 25275.11, "timestamp": "07:01:15", "text": "就像我想盡我所能做到最好。嗯，"}, {"type": "chat", "time": 25275.454, "timestamp": "07:01:15", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "bro doesnt know giorno giovanna, tch tch"}, {"type": "subtitle", "time": 25277.19, "timestamp": "07:01:17", "text": "某種程度上來說，當我要去日本——"}, {"type": "subtitle", "time": 25279.11, "timestamp": "07:01:19", "text": "虛擬主播的發源地——的時候，"}, {"type": "subtitle", "time": 25287.468, "timestamp": "07:01:27", "text": "我知道這不太現實，"}, {"type": "subtitle", "time": 25291.83, "timestamp": "07:01:31", "text": "但我想要的工作是，"}, {"type": "subtitle", "time": 25295.19, "timestamp": "07:01:35", "text": "我真正想在日本從事的工作是娛樂業相關的工作，比如和"}, {"type": "subtitle", "time": 25299.83, "timestamp": "07:01:39", "text": "虛擬主播相關的，或者其他什麼相關的工作。"}, {"type": "subtitle", "time": 25302.31, "timestamp": "07:01:42", "text": "如果這條路"}, {"type": "subtitle", "time": 25304.51, "timestamp": "07:01:44", "text": "走不通，我更想從事音樂產業。"}, {"type": "subtitle", "time": 25307.83, "timestamp": "07:01:47", "text": "所以從某種意義上來說，"}, {"type": "subtitle", "time": 25310.628, "timestamp": "07:01:50", "text": "整個頻道、ETing 之類的東西都可以"}, {"type": "subtitle", "time": 25313.19, "timestamp": "07:01:53", "text": "像作品集或業績記錄一樣。"}, {"type": "subtitle", "time": 25315.03, "timestamp": "07:01:55", "text": "好的。如果我過往業績良好，"}, {"type": "subtitle", "time": 25317.83, "timestamp": "07:01:57", "text": "就能獲得很好的機會，"}]
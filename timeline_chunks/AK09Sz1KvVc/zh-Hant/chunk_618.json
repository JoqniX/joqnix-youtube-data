[{"type": "subtitle", "time": 37087.266, "timestamp": "10:18:07", "text": "求你了，兄弟。女巫殺了她。匈牙利"}, {"type": "subtitle", "time": 37091.63, "timestamp": "10:18:11", "text": "現在可以屠殺所有人了。"}, {"type": "subtitle", "time": 37095.35, "timestamp": "10:18:15", "text": "你竟敢如此？"}, {"type": "subtitle", "time": 37097.746, "timestamp": "10:18:17", "text": "你竟敢毒害星空？我"}, {"type": "subtitle", "time": 37100.87, "timestamp": "10:18:20", "text": "要去當獵巫人了，兄弟。"}, {"type": "subtitle", "time": 37105.586, "timestamp": "10:18:25", "text": "迪奧，回來。我可以逃離我自己嗎？別"}, {"type": "subtitle", "time": 37107.23, "timestamp": "10:18:27", "text": "傻笑，"}, {"type": "subtitle", "time": 37121.67, "timestamp": "10:18:41", "text": "。我這是怎麼了？  我的"}]
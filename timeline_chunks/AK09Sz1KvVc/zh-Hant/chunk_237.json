[{"type": "subtitle", "time": 14221.11, "timestamp": "03:57:01", "text": "我真的、真的、真的、真的"}, {"type": "subtitle", "time": 14224.469, "timestamp": "03:57:04", "text": "不想死在這裡。所以，我就在這裡放張床。  好了，下一個彎道。是的，"}, {"type": "subtitle", "time": 14231.71, "timestamp": "03:57:11", "text": "。製作一塊"}, {"type": "subtitle", "time": 14251.11, "timestamp": "03:57:31", "text": "我以為這個東西，對吧，這個模組，我不需要用那種，呃，呃，"}, {"type": "subtitle", "time": 14259.15, "timestamp": "03:57:39", "text": "用那種，"}, {"type": "subtitle", "time": 14261.81, "timestamp": "03:57:41", "text": "呃，它叫什麼來著？使用類似"}, {"type": "subtitle", "time": 14264.189, "timestamp": "03:57:44", "text": "[音樂]的"}, {"type": "subtitle", "time": 14268.389, "timestamp": "03:57:48", "text": "製作工具來獲得製作物品所需的一切。"}, {"type": "subtitle", "time": 14269.87, "timestamp": "03:57:49", "text": "但顯然你需要一張"}, {"type": "subtitle", "time": 14272.229, "timestamp": "03:57:52", "text": "工作台才能製作物品。好了，"}, {"type": "subtitle", "time": 14275.55, "timestamp": "03:57:55", "text": "我們走吧。為了以防萬一，我會讓床鋪保持死水"}]
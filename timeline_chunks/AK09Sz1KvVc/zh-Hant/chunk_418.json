[{"type": "subtitle", "time": 25080.39, "timestamp": "06:58:00", "text": "你未來的旅程，你就會賦予它意義。"}, {"type": "subtitle", "time": 25083.67, "timestamp": "06:58:03", "text": "哦，"}, {"type": "subtitle", "time": 25086.468, "timestamp": "06:58:06", "text": "天哪，英語，是的，我想賦予它"}, {"type": "subtitle", "time": 25089.99, "timestamp": "06:58:09", "text": "意義。所以，當你聽到"}, {"type": "subtitle", "time": 25092.708, "timestamp": "06:58:12", "text": "或看到這個名字時，你可能會想："}, {"type": "subtitle", "time": 25095.11, "timestamp": "06:58:15", "text": "Jocknik 是什麼？什麼是 Jocknik？這是什麼"}, {"type": "subtitle", "time": 25096.868, "timestamp": "06:58:16", "text": "名字？有些東西讀起來或"}, {"type": "subtitle", "time": 25099.83, "timestamp": "06:58:19", "text": "讀起來太難了。但即便如此"}, {"type": "subtitle", "time": 25101.39, "timestamp": "06:58:21", "text": "，我也想賦予它"}, {"type": "subtitle", "time": 25104.91, "timestamp": "06:58:24", "text": "意義。"}, {"type": "subtitle", "time": 25107.51, "timestamp": "06:58:27", "text": "我想為她的"}, {"type": "subtitle", "time": 25109.948, "timestamp": "06:58:29", "text": "其他角色也做同樣短暫的旅程。希恩表示，"}, {"type": "subtitle", "time": 25112.628, "timestamp": "06:58:32", "text": "他們每個人都有自己獨特的"}, {"type": "subtitle", "time": 25115.788, "timestamp": "06:58:35", "text": "故事。  是的"}, {"type": "subtitle", "time": 25118.948, "timestamp": "06:58:38", "text": "。是的，這也是我一直"}, {"type": "subtitle", "time": 25121.51, "timestamp": "06:58:41", "text": "想創作的故事。所以我想"}, {"type": "subtitle", "time": 25124.468, "timestamp": "06:58:44", "text": "成為像作家或撰稿人那樣的人。我在"}, {"type": "subtitle", "time": 25128.31, "timestamp": "06:58:48", "text": "這方面仍然很差勁，但我會學會的。這"}, {"type": "subtitle", "time": 25131.35, "timestamp": "06:58:51", "text": "需要時間。音樂也是如此。這需要時間"}, {"type": "subtitle", "time": 25133.99, "timestamp": "06:58:53", "text": "。你必須學習並堅持下去"}, {"type": "subtitle", "time": 25136.868, "timestamp": "06:58:56", "text": "。不，其他東西也一樣"}]
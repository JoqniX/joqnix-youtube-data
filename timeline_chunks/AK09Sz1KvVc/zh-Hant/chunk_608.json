[{"type": "subtitle", "time": 36482.95, "timestamp": "10:08:02", "text": "耶。好的。總之，咱們開始"}, {"type": "subtitle", "time": 36488.35, "timestamp": "10:08:08", "text": "Tokco"}, {"type": "subtitle", "time": 36492.31, "timestamp": "10:08:12", "text": "升級磁鐵。好的。我需要"}, {"type": "subtitle", "time": 36495.83, "timestamp": "10:08:15", "text": "一位熨燙之神，就像青金石一樣。我沒有"}, {"type": "subtitle", "time": 36499.03, "timestamp": "10:08:19", "text": "空白升級包。哦，真棒。不，不，不，"}, {"type": "subtitle", "time": 36501.586, "timestamp": "10:08:21", "text": "等等。消除需求。好的，我需要空白"}, {"type": "subtitle", "time": 36504.95, "timestamp": "10:08:24", "text": "升級包。哦，不。我需要什麼？皮革。"}, {"type": "subtitle", "time": 36507.426, "timestamp": "10:08:27", "text": "我的天啊。我現在身上有皮革和繩子嗎"}, {"type": "subtitle", "time": 36512.266, "timestamp": "10:08:32", "text": "？好的。末影珍珠"}, {"type": "subtitle", "time": 36516.31, "timestamp": "10:08:36", "text": "。我們需要一根末端桿。不，"}]
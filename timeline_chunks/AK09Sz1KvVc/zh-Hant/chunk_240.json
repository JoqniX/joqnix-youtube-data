[{"type": "subtitle", "time": 14400.55, "timestamp": "04:00:00", "text": "交易穹頂項目一。目前就這些。  等等，這是……哦，等等。那邊有東西。"}, {"type": "subtitle", "time": 14405.51, "timestamp": "04:00:05", "text": "我"}, {"type": "subtitle", "time": 14410.75, "timestamp": "04:00:10", "text": "確認一下。"}, {"type": "subtitle", "time": 14413.269, "timestamp": "04:00:13", "text": "哦，或許我們可以去那邊。嗯，我覺得還算公平。好，咱們就去那裡吧。"}, {"type": "subtitle", "time": 14419.99, "timestamp": "04:00:19", "text": "感覺就像是，是啊，因為褻瀆神靈的人都在這裡，對吧"}, {"type": "subtitle", "time": 14422.63, "timestamp": "04:00:22", "text": "？這意味著這裡"}, {"type": "subtitle", "time": 14425.309, "timestamp": "04:00:25", "text": "將會有東西"}, {"type": "subtitle", "time": 14427.87, "timestamp": "04:00:27", "text": "。或許。是的，我們繼續前往交易項目穹頂。  那就先做第"}, {"type": "subtitle", "time": 14438.07, "timestamp": "04:00:38", "text": "。讓我們也來探討一下"}, {"type": "subtitle", "time": 14439.63, "timestamp": "04:00:39", "text": "音樂方面的問題"}, {"type": "subtitle", "time": 14443.11, "timestamp": "04:00:43", "text": "。於是，鋪好了一張床。那它在哪裡"}, {"type": "subtitle", "time": 14450.75, "timestamp": "04:00:50", "text": "？我剛剛意識到我沒有"}, {"type": "subtitle", "time": 14452.51, "timestamp": "04:00:52", "text": "食物了。喔"}, {"type": "subtitle", "time": 14455.309, "timestamp": "04:00:55", "text": "不，這裡有七塊"}]
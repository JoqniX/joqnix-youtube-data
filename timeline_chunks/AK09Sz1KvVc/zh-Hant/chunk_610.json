[{"type": "subtitle", "time": 36602.67, "timestamp": "10:10:02", "text": "難？它說在"}, {"type": "subtitle", "time": 36605.266, "timestamp": "10:10:05", "text": "各地均有發現。我想要末影人的時候，他卻不見了"}, {"type": "subtitle", "time": 36608.23, "timestamp": "10:10:08", "text": "。除此之外，我發現末"}, {"type": "subtitle", "time": 36617.586, "timestamp": "10:10:17", "text": "我要把它"}, {"type": "subtitle", "time": 36635.67, "timestamp": "10:10:35", "text": "還有，Astra，背包升級真的"}, {"type": "subtitle", "time": 36638.79, "timestamp": "10:10:38", "text": "太棒了。我正在嘗試獲得"}, {"type": "subtitle", "time": 36646.906, "timestamp": "10:10:46", "text": "升級。我該如何離開這裡"}]
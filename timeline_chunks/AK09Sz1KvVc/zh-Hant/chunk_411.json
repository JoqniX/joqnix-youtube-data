[{"type": "subtitle", "time": 24661.35, "timestamp": "06:51:01", "text": "嗯，最初它應該是個"}, {"type": "subtitle", "time": 24663.27, "timestamp": "06:51:03", "text": "唱片公司之類的，那是我兒時的"}, {"type": "subtitle", "time": 24665.75, "timestamp": "06:51:05", "text": "夢想，或者像個廣播節目之類的。後來"}, {"type": "subtitle", "time": 24667.83, "timestamp": "06:51:07", "text": "它從那個"}, {"type": "subtitle", "time": 24669.91, "timestamp": "06:51:09", "text": "想法變成了唱片公司，然後唱片公司的想法又"}, {"type": "subtitle", "time": 24671.99, "timestamp": "06:51:11", "text": "變成了虛擬主播之類的東西，所以我"}, {"type": "subtitle", "time": 24674.07, "timestamp": "06:51:14", "text": "想到我可以添加更多角色，就像"}, {"type": "subtitle", "time": 24675.91, "timestamp": "06:51:15", "text": "我創造了 Jock 一樣。接下來，我可以創建"}, {"type": "subtitle", "time": 24678.628, "timestamp": "06:51:18", "text": "多個角色，讓他們引導玩家在"}, {"type": "subtitle", "time": 24681.35, "timestamp": "06:51:21", "text": "Jock 的世界中四處走走等等。"}, {"type": "subtitle", "time": 24683.11, "timestamp": "06:51:23", "text": "然後我開始為角色創作角色，"}, {"type": "subtitle", "time": 24685.83, "timestamp": "06:51:25", "text": "這些角色目前"}, {"type": "subtitle", "time": 24687.67, "timestamp": "06:51:27", "text": "公開被稱為四個角色，其中"}, {"type": "subtitle", "time": 24691.83, "timestamp": "06:51:31", "text": "包括 Jock。所以 Jockn、Ceso Aquina"}, {"type": "subtitle", "time": 24694.868, "timestamp": "06:51:34", "text": "和 Tishton al，還有我說的所有這些事情都"}, {"type": "subtitle", "time": 24697.11, "timestamp": "06:51:37", "text": "在粉絲維基上。我"}, {"type": "subtitle", "time": 24699.99, "timestamp": "06:51:39", "text": "特意把它加到粉絲維基裡了。呃"}, {"type": "subtitle", "time": 24704.468, "timestamp": "06:51:44", "text": "，讓我共享一下螢幕。是的，這在粉絲圈很常見。如果你"}, {"type": "subtitle", "time": 24708.31, "timestamp": "06:51:48", "text": "向下滾動，你可能會看到原核生物"}, {"type": "subtitle", "time": 24709.75, "timestamp": "06:51:49", "text": "等等。所有角色、"}, {"type": "subtitle", "time": 24711.23, "timestamp": "06:51:51", "text": "生日、推特帳號"}, {"type": "subtitle", "time": 24713.67, "timestamp": "06:51:53", "text": "等等。是啊，我本來有很多計劃"}, {"type": "subtitle", "time": 24716.15, "timestamp": "06:51:56", "text": "。但我意識到，你知道，我必須"}, {"type": "subtitle", "time": 24719.19, "timestamp": "06:51:59", "text": "專注於一件事。這個 Onia 專案"}]
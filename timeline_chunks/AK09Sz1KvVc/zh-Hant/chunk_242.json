[{"type": "subtitle", "time": 14523.51, "timestamp": "04:02:03", "text": "電力系統。等等，如果你願意，"}, {"type": "subtitle", "time": 14527.91, "timestamp": "04:02:07", "text": "我可以翻新一台 Elro，只要你願意支付 32 個"}, {"type": "subtitle", "time": 14530.99, "timestamp": "04:02:10", "text": "熨燙神。單程"}, {"type": "subtitle", "time": 14534.429, "timestamp": "04:02:14", "text": "旅行時我沒有帶熨斗。我用"}, {"type": "subtitle", "time": 14538.15, "timestamp": "04:02:18", "text": "熨斗之神賜予的神力製作了鐵製盔甲"}, {"type": "subtitle", "time": 14541.79, "timestamp": "04:02:21", "text": "。等等，我等著。我只"}, {"type": "subtitle", "time": 14544.51, "timestamp": "04:02:24", "text": "在"}, {"type": "subtitle", "time": 14547.83, "timestamp": "04:02:27", "text": "艾澤拉斯獲得了它，但我把它用在了其他"}, {"type": "subtitle", "time": 14551.269, "timestamp": "04:02:31", "text": "事情上。哦，沒關係。我身無分文，但"}, {"type": "subtitle", "time": 14557.269, "timestamp": "04:02:37", "text": "沒事。嘿，著色器已停用。等等，"}, {"type": "subtitle", "time": 14570.63, "timestamp": "04:02:50", "text": "。哦，那真酷。"}]
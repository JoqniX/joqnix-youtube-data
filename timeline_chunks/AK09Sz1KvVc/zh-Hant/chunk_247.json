[{"type": "subtitle", "time": 14822.07, "timestamp": "04:07:02", "text": "？哦，這綠色的東西是什麼？"}, {"type": "subtitle", "time": 14823.87, "timestamp": "04:07:03", "text": "那是一個"}, {"type": "subtitle", "time": 14828.429, "timestamp": "04:07:08", "text": "村莊嗎？哇，我在這裡還發現了其他東西"}, {"type": "subtitle", "time": 14851.75, "timestamp": "04:07:31", "text": "不能做到。我的藍色魔法書丟了，"}, {"type": "subtitle", "time": 14855.03, "timestamp": "04:07:35", "text": "艾澤拉斯也把它丟掉了，然後"}, {"type": "subtitle", "time": 14860.07, "timestamp": "04:07:40", "text": "他殺了我，我就死了。是的，因為我"}, {"type": "subtitle", "time": 14869.269, "timestamp": "04:07:49", "text": "哦，我真希望我能把那本書找回來，但這"}, {"type": "subtitle", "time": 14872.15, "timestamp": "04:07:52", "text": "是什麼？一個公園，一個停車場"}, {"type": "subtitle", "time": 14874.67, "timestamp": "04:07:54", "text": "？等等，一個停車場？"}]
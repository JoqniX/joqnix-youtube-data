[{"type": "subtitle", "time": 27085.948, "timestamp": "07:31:25", "text": "不記得了。讓我們來看看。  我給這款遊戲打10顆星"}, {"type": "subtitle", "time": 27089.15, "timestamp": "07:31:29", "text": "。  每當我"}, {"type": "subtitle", "time": 27093.23, "timestamp": "07:31:33", "text": "按下我的"}, {"type": "subtitle", "time": 27105.19, "timestamp": "07:31:45", "text": "我卻沒有反應，我以為是因為我按了「取得」按鈕。我的天哪。"}, {"type": "subtitle", "time": 27116.788, "timestamp": "07:31:56", "text": "我當時想，等等，這是在說我嗎？我當時想，我做錯什麼了嗎？  他在開玩笑。  我們 blet。  以及地面組件。我打算去，然後我"}]
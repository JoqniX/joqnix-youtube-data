[{"type": "subtitle", "time": 36848.746, "timestamp": "10:14:08", "text": "影人，"}, {"type": "subtitle", "time": 36851.79, "timestamp": "10:14:11", "text": "我是如何找到她的？"}, {"type": "subtitle", "time": 36857.07, "timestamp": "10:14:17", "text": "什麼？末影人，你在哪裡？"}, {"type": "subtitle", "time": 36865.906, "timestamp": "10:14:25", "text": "末影人，如果我看到一顆鑽石，如果我真的在任何地方看到"}, {"type": "subtitle", "time": 36872.39, "timestamp": "10:14:32", "text": "。呃，我剛才是不是來過這裡？"}, {"type": "subtitle", "time": 36898.03, "timestamp": "10:14:58", "text": "那裡。"}]
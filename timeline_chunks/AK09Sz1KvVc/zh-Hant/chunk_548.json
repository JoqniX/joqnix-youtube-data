[{"type": "subtitle", "time": 32888.428, "timestamp": "09:08:08", "text": "你好。你好。你好。"}, {"type": "subtitle", "time": 32892.112, "timestamp": "09:08:12", "text": "我可能想問末影珍珠，但那東西很容易獲得。我只需要找到"}, {"type": "subtitle", "time": 32910.31, "timestamp": "09:08:30", "text": "並殺死末影人就行了，對吧？"}, {"type": "subtitle", "time": 32929.19, "timestamp": "09:08:49", "text": "但我沒看出來。是因為不允許嗎"}]
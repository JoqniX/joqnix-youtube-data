[{"type": "subtitle", "time": 36240.07, "timestamp": "10:04:00", "text": "有趣的。我其實真的很"}, {"type": "subtitle", "time": 36290.23, "timestamp": "10:04:50", "text": "我還想在挖礦的時候找到紅石，"}, {"type": "subtitle", "time": 36292.95, "timestamp": "10:04:52", "text": "這樣我才能完成"}, {"type": "subtitle", "time": 36297.19, "timestamp": "10:04:57", "text": "磁鐵裝置。那麼磁鐵的作用是什麼呢？它能把"}, {"type": "subtitle", "time": 36299.67, "timestamp": "10:04:59", "text": "五格"}]
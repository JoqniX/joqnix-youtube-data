[{"type": "subtitle", "time": 36188.35, "timestamp": "10:03:08", "text": "太蠢了吧。我的"}, {"type": "subtitle", "time": 36193.586, "timestamp": "10:03:13", "text": "天啊。不。如果它爆炸了，醫生，我向"}, {"type": "subtitle", "time": 36195.23, "timestamp": "10:03:15", "text": "上帝發誓，你"}, {"type": "subtitle", "time": 36212.87, "timestamp": "10:03:32", "text": "鑽石。探索火焰洞穴。"}, {"type": "subtitle", "time": 36216.47, "timestamp": "10:03:36", "text": "還有，這些不就是夜光石嗎？"}, {"type": "subtitle", "time": 36218.47, "timestamp": "10:03:38", "text": "不，那不是螢石，對吧？那是熔岩"}, {"type": "subtitle", "time": 36228.586, "timestamp": "10:03:48", "text": "是什麼黑色"}, {"type": "subtitle", "time": 36237.55, "timestamp": "10:03:57", "text": "-41。"}]
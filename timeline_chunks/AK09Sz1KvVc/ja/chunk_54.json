[{"type": "subtitle", "time": 3248.51, "timestamp": "00:54:08", "text": "実際にはトリミングするつもりだった"}, {"type": "subtitle", "time": 3259.43, "timestamp": "00:54:19", "text": "より小さい。ええ、小さくなります。いいえ、私は"}, {"type": "subtitle", "time": 3265.95, "timestamp": "00:54:25", "text": "[音楽]"}, {"type": "subtitle", "time": 3277.43, "timestamp": "00:54:37", "text": "また。えーと、会員費は10ドルになります"}, {"type": "subtitle", "time": 3279.43, "timestamp": "00:54:39", "text": "分ですよね？わかった。待って、私は私は私は"}, {"type": "subtitle", "time": 3297.51, "timestamp": "00:54:57", "text": "えっと、どうやって画像を挿入すればいいですか？"}, {"type": "subtitle", "time": 3299.309, "timestamp": "00:54:59", "text": "スケーリング"}]
[{"type": "subtitle", "time": 20409.11, "timestamp": "05:40:09", "text": "わかった。わかった。わかった。だから、待って、待って、待って。"}, {"type": "subtitle", "time": 20411.59, "timestamp": "05:40:11", "text": "えっと、今うっかり"}, {"type": "subtitle", "time": 20415.43, "timestamp": "05:40:15", "text": "無効にする？何てことだ。はい、戻ってきました。"}, {"type": "subtitle", "time": 20418.868, "timestamp": "05:40:18", "text": "それで、えーと、私は3Dモールを維持しています"}, {"type": "subtitle", "time": 20421.43, "timestamp": "05:40:21", "text": "4時間くらいジャンキー状態。それはあまりにも"}, {"type": "subtitle", "time": 20424.03, "timestamp": "05:40:24", "text": "多くの。何てことだ。さあ、"}, {"type": "subtitle", "time": 20428.708, "timestamp": "05:40:28", "text": "変化。変わる時が来た。えっと、私は思う"}, {"type": "subtitle", "time": 20431.948, "timestamp": "05:40:31", "text": "Slicer を使うこともできます"}, {"type": "subtitle", "time": 20434.27, "timestamp": "05:40:34", "text": "1つ。"}, {"type": "subtitle", "time": 20436.548, "timestamp": "05:40:36", "text": "うん。待って、私が"}, {"type": "subtitle", "time": 20441.19, "timestamp": "05:40:41", "text": "ジョックのために3Dジョッキーに愛を捧げた。だから私は"}, {"type": "subtitle", "time": 20442.67, "timestamp": "05:40:42", "text": "たぶん"}, {"type": "subtitle", "time": 20445.788, "timestamp": "05:40:45", "text": "大丈夫。それが理由です"}, {"type": "subtitle", "time": 20447.31, "timestamp": "05:40:47", "text": "ない"}, {"type": "subtitle", "time": 20450.11, "timestamp": "05:40:50", "text": "これ以上"}, {"type": "subtitle", "time": 20451.788, "timestamp": "05:40:51", "text": "騎手。"}, {"type": "subtitle", "time": 20455.75, "timestamp": "05:40:55", "text": "やあ、彼女が次の人に行くよ。はい、"}, {"type": "subtitle", "time": 20457.39, "timestamp": "05:40:57", "text": "名前は"}]
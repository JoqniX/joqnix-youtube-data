[{"type": "subtitle", "time": 20763.43, "timestamp": "05:46:03", "text": "使い物にならない。うん。こんにちは。またか。私は待つ。"}, {"type": "subtitle", "time": 20765.75, "timestamp": "05:46:05", "text": "またか。ああ、あなたは新人だと思います"}, {"type": "subtitle", "time": 20767.868, "timestamp": "05:46:07", "text": "ここ。いらっしゃいませ、"}, {"type": "subtitle", "time": 20771.03, "timestamp": "05:46:11", "text": "ようこそ、ようこそ、ようこそ。どうやって"}, {"type": "subtitle", "time": 20780.708, "timestamp": "05:46:20", "text": "自分？はい、わかりました。私は必要としています 私は必要としています"}, {"type": "subtitle", "time": 20783.03, "timestamp": "05:46:23", "text": "これを別のケーブルにルーティングすると"}, {"type": "subtitle", "time": 20785.43, "timestamp": "05:46:25", "text": "ストリーミングには使用していません。"}, {"type": "subtitle", "time": 20794.15, "timestamp": "05:46:34", "text": "DCBは「みんな一人で何してるの？」という企画を行っています。"}, {"type": "subtitle", "time": 20796.628, "timestamp": "05:46:36", "text": "板の上で？えっと、ちょっと席を外していたんです"}, {"type": "subtitle", "time": 20801.07, "timestamp": "05:46:41", "text": "少しだけ。昼食を食べに行ったので"}, {"type": "subtitle", "time": 20803.708, "timestamp": "05:46:43", "text": "ちょっと待って"}, {"type": "subtitle", "time": 20811.948, "timestamp": "05:46:51", "text": "これ？待って。これは待って待って待って"}, {"type": "subtitle", "time": 20816.99, "timestamp": "05:46:56", "text": "待って。なぜこうなっているのか？待って、"}, {"type": "subtitle", "time": 20819.99, "timestamp": "05:46:59", "text": "何？それはまるでコントロールのようなものだ。え、何？"}]
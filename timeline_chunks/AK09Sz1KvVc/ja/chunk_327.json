[{"type": "subtitle", "time": 19621.51, "timestamp": "05:27:01", "text": "えっと、私はこういうのを作ったと思う、なぜなら私は"}, {"type": "subtitle", "time": 19629.92, "timestamp": "05:27:09", "text": "アフガン人として生きる？私はしません"}, {"type": "subtitle", "time": 19632.43, "timestamp": "05:27:12", "text": "[音楽]"}, {"type": "subtitle", "time": 19636.788, "timestamp": "05:27:16", "text": "知る。ベッドは弾力がある。ああ、障害物がある。"}, {"type": "subtitle", "time": 19644.19, "timestamp": "05:27:24", "text": "いいえ。よし、これでいい。だから、眠れる。"}, {"type": "subtitle", "time": 19646.948, "timestamp": "05:27:26", "text": "わかった、ここに置いておくよ"}, {"type": "subtitle", "time": 19648.19, "timestamp": "05:27:28", "text": "右"}, {"type": "subtitle", "time": 19651.19, "timestamp": "05:27:31", "text": "戻る。わかった。あ、待って。私は、"}, {"type": "subtitle", "time": 19658.35, "timestamp": "05:27:38", "text": "1"}, {"type": "subtitle", "time": 19661.628, "timestamp": "05:27:41", "text": "景色を楽しみましょうか？私は必要としている"}, {"type": "subtitle", "time": 19664.83, "timestamp": "05:27:44", "text": "たとえ私が"}, {"type": "subtitle", "time": 19668.19, "timestamp": "05:27:48", "text": "景色、それから私は"}, {"type": "subtitle", "time": 19671.59, "timestamp": "05:27:51", "text": "これはうまくいくと思う。これは"}, {"type": "subtitle", "time": 19672.35, "timestamp": "05:27:52", "text": "ニース"}]
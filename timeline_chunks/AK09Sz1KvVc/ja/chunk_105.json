[{"type": "subtitle", "time": 6305.47, "timestamp": "01:45:05", "text": "1ポイント"}, {"type": "subtitle", "time": 6309.43, "timestamp": "01:45:09", "text": "えーと、1.1メンバーシップティア1は"}, {"type": "subtitle", "time": 6310.35, "timestamp": "01:45:10", "text": "等しい"}, {"type": "subtitle", "time": 6314.43, "timestamp": "01:45:14", "text": "会員ティア1は1に相当します"}, {"type": "subtitle", "time": 6317.629, "timestamp": "01:45:17", "text": "ポイントティア22"}, {"type": "subtitle", "time": 6319.95, "timestamp": "01:45:19", "text": "ポイントティア"}, {"type": "subtitle", "time": 6323.87, "timestamp": "01:45:23", "text": "3、3ポイント"}, {"type": "subtitle", "time": 6325.95, "timestamp": "01:45:25", "text": "等"}, {"type": "subtitle", "time": 6331.629, "timestamp": "01:45:31", "text": "ポイントとスーパーチャットは同等です"}, {"type": "subtitle", "time": 6334.43, "timestamp": "01:45:34", "text": "いかなる"}, {"type": "subtitle", "time": 6344.79, "timestamp": "01:45:44", "text": "ポイント。待って、これ確認する必要がある。もし"}, {"type": "subtitle", "time": 6347.51, "timestamp": "01:45:47", "text": "スーパーチャットの金額は2,000ドルかそれくらいです"}, {"type": "subtitle", "time": 6351.83, "timestamp": "01:45:51", "text": "待って、200ドル。待って、10ドルか何かか"}, {"type": "subtitle", "time": 6355.109, "timestamp": "01:45:55", "text": "100ドルくらい？増加しますか"}, {"type": "subtitle", "time": 6358.31, "timestamp": "01:45:58", "text": "ポイント制ですか、それとも1ポイントあたりですか？待って、"}, {"type": "subtitle", "time": 6359.95, "timestamp": "01:45:59", "text": "それを確認してください。"}]
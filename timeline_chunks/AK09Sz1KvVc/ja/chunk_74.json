[{"type": "subtitle", "time": 4441.51, "timestamp": "01:14:01", "text": "それで、これに関して私が言いたいのは"}, {"type": "subtitle", "time": 4445.59, "timestamp": "01:14:05", "text": "コマンドを使用したい。あなたは"}, {"type": "subtitle", "time": 4447.03, "timestamp": "01:14:07", "text": "みんな、これを覚えておいてね"}, {"type": "subtitle", "time": 4449.709, "timestamp": "01:14:09", "text": "感嘆符コマンド"}, {"type": "subtitle", "time": 4453.43, "timestamp": "01:14:13", "text": "あれ？うん。それで、ここで読みたかったのは"}, {"type": "subtitle", "time": 4458.59, "timestamp": "01:14:18", "text": "イベント。"}, {"type": "subtitle", "time": 4462.39, "timestamp": "01:14:22", "text": "はい、ちょっと待ってください。"}, {"type": "subtitle", "time": 4464.669, "timestamp": "01:14:24", "text": "使用する必要があります"}, {"type": "subtitle", "time": 4493.43, "timestamp": "01:14:53", "text": "これ。これは「Yeah」のためだった。わかった。"}, {"type": "subtitle", "time": 4497.99, "timestamp": "01:14:57", "text": "ありがとう。すごくよく機能します。だから、私は"}]
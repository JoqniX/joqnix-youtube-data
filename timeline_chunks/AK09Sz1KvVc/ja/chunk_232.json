[{"type": "subtitle", "time": 13924.189, "timestamp": "03:52:04", "text": "[音楽]"}, {"type": "subtitle", "time": 13926.75, "timestamp": "03:52:06", "text": "知ってる、私たちは何をしていたのか"}, {"type": "subtitle", "time": 13935.349, "timestamp": "03:52:15", "text": "そこには。待って、今100FPS出てるよ。"}, {"type": "subtitle", "time": 13938.99, "timestamp": "03:52:18", "text": "さあ行こう。中程度のものを使用することで"}, {"type": "subtitle", "time": 13942.71, "timestamp": "03:52:22", "text": "実際に鮮やかな極限を使用している"}, {"type": "subtitle", "time": 13945.51, "timestamp": "03:52:25", "text": "20～30FPSしか出なかった"}, {"type": "subtitle", "time": 13949.95, "timestamp": "03:52:29", "text": "もっと欲しいなら、135くらい欲しい。"}, {"type": "subtitle", "time": 13952.11, "timestamp": "03:52:32", "text": "おお。クール、クール、"}, {"type": "subtitle", "time": 13954.389, "timestamp": "03:52:34", "text": "いいね。元気ですか？あなたに"}, {"type": "subtitle", "time": 13957.189, "timestamp": "03:52:37", "text": "パッド。はい。"}, {"type": "subtitle", "time": 13958.91, "timestamp": "03:52:38", "text": "昨日"}, {"type": "subtitle", "time": 13964.07, "timestamp": "03:52:44", "text": "そして君は僕をボングして、それからそれは"}, {"type": "subtitle", "time": 13968.349, "timestamp": "03:52:48", "text": "あなたがくれたチョコレート"}]
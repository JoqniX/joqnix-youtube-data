[{"type": "subtitle", "time": 21481.91, "timestamp": "05:58:01", "text": "もの。私は通常、すべての"}, {"type": "subtitle", "time": 21484.75, "timestamp": "05:58:04", "text": "中小企業。私は殺すようなことを言った"}, {"type": "subtitle", "time": 21488.948, "timestamp": "05:58:08", "text": "他のものと同様に、PvPではないが、いろいろなものがある。"}, {"type": "subtitle", "time": 21491.91, "timestamp": "05:58:11", "text": "PvEキル。したくないという意味です"}, {"type": "subtitle", "time": 21494.628, "timestamp": "05:58:14", "text": "それ。ただ落ち着きたいだけなんです"}, {"type": "subtitle", "time": 21499.15, "timestamp": "05:58:19", "text": "自分のために何かを作る、"}, {"type": "subtitle", "time": 21504.51, "timestamp": "05:58:24", "text": "知る。私のチェリーボートはどこ？どこに"}, {"type": "subtitle", "time": 21519.03, "timestamp": "05:58:39", "text": "ヘルプ。ああ、そうかもしれないね。あなたの目標は何ですか？しかし"}, {"type": "subtitle", "time": 21522.43, "timestamp": "05:58:42", "text": "私の現在の目標は"}, {"type": "subtitle", "time": 21526.15, "timestamp": "05:58:46", "text": "えーと、今の私の目標は実際に私の"}, {"type": "subtitle", "time": 21530.23, "timestamp": "05:58:50", "text": "私の死んだ物、ここにある私の物、そして"}, {"type": "subtitle", "time": 21533.708, "timestamp": "05:58:53", "text": "生物群系や場所に定住する"}, {"type": "subtitle", "time": 21537.75, "timestamp": "05:58:57", "text": "木材やその他諸々が入っています"}, {"type": "subtitle", "time": 21539.99, "timestamp": "05:58:59", "text": "つまり、この地域のことです。落ち着くかもしれない"}]
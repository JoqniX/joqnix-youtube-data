[{"type": "subtitle", "time": 11400.389, "timestamp": "03:10:00", "text": "[音楽]"}, {"type": "subtitle", "time": 11403.5, "timestamp": "03:10:03", "text": "わからない。"}, {"type": "subtitle", "time": 11423.11, "timestamp": "03:10:23", "text": "眠くなってきた。もし私が眠ってしまったら、"}, {"type": "subtitle", "time": 11424.83, "timestamp": "03:10:24", "text": "何をすべきか分かっているだろう、"}, {"type": "subtitle", "time": 11438.87, "timestamp": "03:10:38", "text": "ええと、今日は手動でやります。私"}, {"type": "subtitle", "time": 11440.89, "timestamp": "03:10:40", "text": "考えなければならない"}, {"type": "subtitle", "time": 11444.11, "timestamp": "03:10:44", "text": "[音楽]"}, {"type": "subtitle", "time": 11447.19, "timestamp": "03:10:47", "text": "システムコミュニティの才能。私は何をしますか"}, {"type": "subtitle", "time": 11456.15, "timestamp": "03:10:56", "text": "才能がある？私は既に対処済みです。そうそう、"}, {"type": "subtitle", "time": 11458.51, "timestamp": "03:10:58", "text": "会員権とコミュニティギフトは"}]
[{"type": "subtitle", "time": 15662.04, "timestamp": "04:21:02", "text": "それ。そうするべきだろう"}, {"type": "subtitle", "time": 15664.67, "timestamp": "04:21:04", "text": "[音楽]"}, {"type": "subtitle", "time": 15667.59, "timestamp": "04:21:07", "text": "すぐ。彼が飛ぶ様子を見てごらん。それは"}, {"type": "subtitle", "time": 15687.429, "timestamp": "04:21:27", "text": "時間。どうやら、"}, {"type": "subtitle", "time": 15690.07, "timestamp": "04:21:30", "text": "さらに多くのものを育てることはできません"}, {"type": "subtitle", "time": 15694.03, "timestamp": "04:21:34", "text": "木というのは、実際にはあなたが見るものすべてです。私"}, {"type": "subtitle", "time": 15696.99, "timestamp": "04:21:36", "text": "それは状況によると思います"}, {"type": "subtitle", "time": 15699.51, "timestamp": "04:21:39", "text": "季節。しかし、私の質問は、"}, {"type": "subtitle", "time": 15713.91, "timestamp": "04:21:53", "text": "知る？押したときのあの機能が大好きです"}, {"type": "subtitle", "time": 15717.309, "timestamp": "04:21:57", "text": "タブにはサーバー名が表示され、"}, {"type": "subtitle", "time": 15719.99, "timestamp": "04:21:59", "text": "また、何人まで参加できるかも教えてください。それはとても"}]
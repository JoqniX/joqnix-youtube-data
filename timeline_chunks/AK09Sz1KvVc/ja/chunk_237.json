[{"type": "subtitle", "time": 14221.11, "timestamp": "03:57:01", "text": "本当に、本当に、本当に、本当に、本当に"}, {"type": "subtitle", "time": 14224.469, "timestamp": "03:57:04", "text": "ここで死にたくない。それで、"}, {"type": "subtitle", "time": 14231.71, "timestamp": "03:57:11", "text": "ここ。"}, {"type": "subtitle", "time": 14234.349, "timestamp": "03:57:14", "text": "はい、次"}, {"type": "subtitle", "time": 14237.03, "timestamp": "03:57:17", "text": "コーナー。うん、ここにパンを置いたよ"}, {"type": "subtitle", "time": 14237.29, "timestamp": "03:57:17", "text": "のために"}, {"type": "subtitle", "time": 14240.349, "timestamp": "03:57:20", "text": "[音楽]"}, {"type": "subtitle", "time": 14251.11, "timestamp": "03:57:31", "text": "このMODのこの部分について考えました"}, {"type": "subtitle", "time": 14254.51, "timestamp": "03:57:34", "text": "私は～のようなことを使う必要はありません"}, {"type": "subtitle", "time": 14256.99, "timestamp": "03:57:36", "text": "えーと"}, {"type": "subtitle", "time": 14259.15, "timestamp": "03:57:39", "text": "えっと、このように使います"}, {"type": "subtitle", "time": 14261.81, "timestamp": "03:57:41", "text": "えっと、なんて呼ぶんだっけ？次のように使用"}, {"type": "subtitle", "time": 14264.189, "timestamp": "03:57:44", "text": "[音楽]"}, {"type": "subtitle", "time": 14268.389, "timestamp": "03:57:48", "text": "えーっと、クラフトで全部作れるように"}, {"type": "subtitle", "time": 14269.87, "timestamp": "03:57:49", "text": "もの。でもどうやら、"}, {"type": "subtitle", "time": 14272.229, "timestamp": "03:57:52", "text": "物を作るための作業台。わかった、"}, {"type": "subtitle", "time": 14275.55, "timestamp": "03:57:55", "text": "さあ行こう。ベッドはそのままにしておきます"}]
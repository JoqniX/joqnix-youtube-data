[{"type": "subtitle", "time": 13505.91, "timestamp": "03:45:05", "text": "何か？後ろから戻ってきたばかり"}, {"type": "subtitle", "time": 13508.309, "timestamp": "03:45:08", "text": "授業から。ニース。とても素敵です。はい、"}, {"type": "subtitle", "time": 13513.03, "timestamp": "03:45:13", "text": "はい。そして、ストーは実際に参加しました"}, {"type": "subtitle", "time": 13515.03, "timestamp": "03:45:15", "text": "彼もサーバーに参加したかった。彼"}, {"type": "subtitle", "time": 13517.51, "timestamp": "03:45:17", "text": "実際、ホワイトリスト登録の手続きは済ませました。"}, {"type": "subtitle", "time": 13521.59, "timestamp": "03:45:21", "text": "いや、いや。彼がそうしないのが待ちきれない"}, {"type": "subtitle", "time": 13528.07, "timestamp": "03:45:28", "text": "自分。でも、そうだよ。たくさんのこと"}, {"type": "subtitle", "time": 13530.87, "timestamp": "03:45:30", "text": "ベータ版の直後に変更されました"}, {"type": "subtitle", "time": 13533.91, "timestamp": "03:45:33", "text": "その時に行ったテスト。私たちは"}, {"type": "subtitle", "time": 13535.15, "timestamp": "03:45:35", "text": "たくさん"}, {"type": "subtitle", "time": 13538.229, "timestamp": "03:45:38", "text": "いろいろと、GD の使用をやめました"}, {"type": "subtitle", "time": 13540.229, "timestamp": "03:45:40", "text": "ランチャーを使い始め、"}, {"type": "subtitle", "time": 13542.79, "timestamp": "03:45:42", "text": "いいえ、"}, {"type": "subtitle", "time": 13555.15, "timestamp": "03:45:55", "text": "痛み。おお、"}, {"type": "subtitle", "time": 13558.95, "timestamp": "03:45:58", "text": "痛み。私はそうなのでしょうか？待って、300メートルだよ。わかった、"}]
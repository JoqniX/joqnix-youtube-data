[{"type": "subtitle", "time": 21243.03, "timestamp": "05:54:03", "text": "包囲された。赤い男。疑問符。彼"}, {"type": "subtitle", "time": 21245.03, "timestamp": "05:54:05", "text": "彼は私の家を見つけたが、誘拐はしていない"}, {"type": "subtitle", "time": 21249.59, "timestamp": "05:54:09", "text": "まだ私です。え、何？はぁ？"}, {"type": "subtitle", "time": 21257.23, "timestamp": "05:54:17", "text": "待って。うん。こんにちは。ああ、"}, {"type": "subtitle", "time": 21274.51, "timestamp": "05:54:34", "text": "バ。待って、待って、待って、待って、待って、待って、待って、"}, {"type": "subtitle", "time": 21276.868, "timestamp": "05:54:36", "text": "待って。彼は私の家も見つけるだろう。待って、"}, {"type": "subtitle", "time": 21278.23, "timestamp": "05:54:38", "text": "待って、待って。"}, {"type": "subtitle", "time": 21280.628, "timestamp": "05:54:40", "text": "あなたがネザーに行くなら、寄付します。何"}, {"type": "subtitle", "time": 21282.19, "timestamp": "05:54:42", "text": "つまり"}, {"type": "subtitle", "time": 21284.03, "timestamp": "05:54:44", "text": "寄付する？"}, {"type": "subtitle", "time": 21286.948, "timestamp": "05:54:46", "text": "何？寄付とはどういう意味ですか？しないで"}, {"type": "subtitle", "time": 21289.628, "timestamp": "05:54:49", "text": "私のためにお金を使ってください。ぶん殴ってやるよ。"}, {"type": "subtitle", "time": 21293.868, "timestamp": "05:54:53", "text": "なぜ？お金は一切使わない。所有"}]
[{"type": "subtitle", "time": 18062.67, "timestamp": "05:01:02", "text": "しかし、それでも疑問に思う。私はちょっと欲しい"}, {"type": "subtitle", "time": 18066.23, "timestamp": "05:01:06", "text": "このコムはそれを盗んだ。おい、これ"}, {"type": "subtitle", "time": 18069.11, "timestamp": "05:01:09", "text": "黒や赤によく似合います"}, {"type": "subtitle", "time": 18070.27, "timestamp": "05:01:10", "text": "カーペット"}, {"type": "subtitle", "time": 18094.91, "timestamp": "05:01:34", "text": "のように"}, {"type": "subtitle", "time": 18099.83, "timestamp": "05:01:39", "text": "これ。どうやって起き上がればいいの？いや、ちくしょう。あなた"}, {"type": "subtitle", "time": 18104.75, "timestamp": "05:01:44", "text": "お前は虫だ。どうやって起き上がるつもりですか、"}]
[{"type": "subtitle", "time": 20700.948, "timestamp": "05:45:00", "text": "あそこにあるはずだ。待って。あ、待って。もし"}, {"type": "subtitle", "time": 20703.59, "timestamp": "05:45:03", "text": "私はこれをプレイします、私もそれを聞きます"}, {"type": "subtitle", "time": 20705.39, "timestamp": "05:45:05", "text": "音楽をストリーミング再生する。"}, {"type": "subtitle", "time": 20707.628, "timestamp": "05:45:07", "text": "ああ、私は"}, {"type": "subtitle", "time": 20711.59, "timestamp": "05:45:11", "text": "あ、待って。忘れた。ええと、両方とも"}, {"type": "subtitle", "time": 20714.27, "timestamp": "05:45:14", "text": "それらは同じ仮想ケーブル上にあります。"}, {"type": "subtitle", "time": 20717.99, "timestamp": "05:45:17", "text": "あ、待って。別の方法を見つける必要がある"}, {"type": "subtitle", "time": 20720.03, "timestamp": "05:45:20", "text": "する"}, {"type": "subtitle", "time": 20723.43, "timestamp": "05:45:23", "text": "これ。どこにいるの？はい、では"}, {"type": "subtitle", "time": 20738.99, "timestamp": "05:45:38", "text": "そして餌を与えられた"}, {"type": "subtitle", "time": 20742.07, "timestamp": "05:45:42", "text": "あなた。ああ、これはフレデリックの作品ですね。の"}, {"type": "subtitle", "time": 20744.27, "timestamp": "05:45:44", "text": "歌"}, {"type": "subtitle", "time": 20749.628, "timestamp": "05:45:49", "text": "ジャンキー。ああ、日本のロックバンドですね。"}, {"type": "subtitle", "time": 20751.708, "timestamp": "05:45:51", "text": "ああ、あなたの頭"}, {"type": "subtitle", "time": 20759.39, "timestamp": "05:45:59", "text": "それで"}]
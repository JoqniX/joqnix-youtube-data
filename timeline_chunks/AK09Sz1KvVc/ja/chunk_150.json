[{"type": "subtitle", "time": 9000.07, "timestamp": "02:30:00", "text": "えーと、彼らは同じティアのものしか買わないだろう"}, {"type": "subtitle", "time": 9002.429, "timestamp": "02:30:02", "text": "そう、それは30だ"}, {"type": "subtitle", "time": 9006.389, "timestamp": "02:30:06", "text": "ルピーの更新はあなたにとって次のようになります"}, {"type": "subtitle", "time": 9009.19, "timestamp": "02:30:09", "text": "数ヶ月前に更新すればいいですよね"}, {"type": "subtitle", "time": 9010.27, "timestamp": "02:30:10", "text": "考える"}, {"type": "subtitle", "time": 9014.55, "timestamp": "02:30:14", "text": "だから、それはまだ、もしそれが"}, {"type": "subtitle", "time": 9017.59, "timestamp": "02:30:17", "text": "5つの更新とは、彼らが購入したことを意味します"}, {"type": "subtitle", "time": 9020.389, "timestamp": "02:30:20", "text": "ティア5回右、つまり145"}, {"type": "subtitle", "time": 9022.51, "timestamp": "02:30:22", "text": "ルピーで、もし私が"}, {"type": "subtitle", "time": 9025.99, "timestamp": "02:30:25", "text": "正しいです。5つのギフトでいくらですか？"}, {"type": "subtitle", "time": 9028.19, "timestamp": "02:30:28", "text": "才能ある5人の会員"}, {"type": "subtitle", "time": 9030.87, "timestamp": "02:30:30", "text": "会員登録確認させてください。私には見えません。"}, {"type": "subtitle", "time": 9032.99, "timestamp": "02:30:32", "text": "ここからは何も"}, {"type": "subtitle", "time": 9036.03, "timestamp": "02:30:36", "text": "そこにあるだろう"}, {"type": "subtitle", "time": 9039.27, "timestamp": "02:30:39", "text": "周囲に加わる"}, {"type": "subtitle", "time": 9041.349, "timestamp": "02:30:41", "text": "いやいやいや、ここじゃない、ここだよ"}, {"type": "subtitle", "time": 9043.309, "timestamp": "02:30:43", "text": "会員"}, {"type": "subtitle", "time": 9052.27, "timestamp": "02:30:52", "text": "145ルピー"}, {"type": "subtitle", "time": 9055.83, "timestamp": "02:30:55", "text": "5ルピー、そう、ポイントは"}, {"type": "subtitle", "time": 9057.83, "timestamp": "02:30:57", "text": "ポイントは5回カウントされます"}]
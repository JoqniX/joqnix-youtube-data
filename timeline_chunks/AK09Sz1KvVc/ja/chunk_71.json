[{"type": "subtitle", "time": 4260.229, "timestamp": "01:11:00", "text": "会員資格と会員マイルストーン、私は"}, {"type": "subtitle", "time": 4267.47, "timestamp": "01:11:07", "text": "えっと、もし私が再確認して"}, {"type": "subtitle", "time": 4270.43, "timestamp": "01:11:10", "text": "確認します、これを切り替えます"}, {"type": "subtitle", "time": 4278.55, "timestamp": "01:11:18", "text": "Twitchで配信して、二重チェックします。私たちは"}, {"type": "subtitle", "time": 4286.83, "timestamp": "01:11:26", "text": "良い。"}, {"type": "subtitle", "time": 4308.07, "timestamp": "01:11:48", "text": "これ。でも、これは"}, {"type": "subtitle", "time": 4310.79, "timestamp": "01:11:50", "text": "小数点ポインタも含む。の"}, {"type": "subtitle", "time": 4313.709, "timestamp": "01:11:53", "text": "シンボルカウンターも。それは"}, {"type": "subtitle", "time": 4316.229, "timestamp": "01:11:56", "text": "問題。何らかの理由で、"}, {"type": "subtitle", "time": 4318.709, "timestamp": "01:11:58", "text": "小数点もです。"}]
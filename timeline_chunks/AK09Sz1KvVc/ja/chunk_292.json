[{"type": "subtitle", "time": 17522.628, "timestamp": "04:52:02", "text": "私？あ、待って。もう3歳だよ。私は必要としている"}, {"type": "subtitle", "time": 17555.23, "timestamp": "04:52:35", "text": "ここ。この箱を手に入れよう"}, {"type": "subtitle", "time": 17557.91, "timestamp": "04:52:37", "text": "オフ。うん、荷物を取り戻さないといけないんだ"}, {"type": "subtitle", "time": 17560.11, "timestamp": "04:52:40", "text": "である"}, {"type": "subtitle", "time": 17562.628, "timestamp": "04:52:42", "text": "正直。また、チェリーもたくさんあります"}, {"type": "subtitle", "time": 17565.27, "timestamp": "04:52:45", "text": "木。だから、何か買おうと思う"}, {"type": "subtitle", "time": 17569.31, "timestamp": "04:52:49", "text": "実はここからなんです。それから私は移動します"}, {"type": "subtitle", "time": 17571.55, "timestamp": "04:52:51", "text": "フォワード。"}, {"type": "subtitle", "time": 17574.39, "timestamp": "04:52:54", "text": "うん、それが一番いい方法だね"}, {"type": "subtitle", "time": 17576.15, "timestamp": "04:52:56", "text": "それ。さもないと、さもないと、私は"}, {"type": "subtitle", "time": 17577.47, "timestamp": "04:52:57", "text": "死にゆく"}]
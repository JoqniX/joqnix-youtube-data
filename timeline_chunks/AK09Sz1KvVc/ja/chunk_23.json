[{"type": "subtitle", "time": 1381.19, "timestamp": "00:23:01", "text": "叫び続けるだろう、叫び続けるだろう、叫び続けるだろう、"}, {"type": "subtitle", "time": 1384.789, "timestamp": "00:23:04", "text": "ストリームしてありがとう、ありがとう"}, {"type": "subtitle", "time": 1386.39, "timestamp": "00:23:06", "text": "具体的には"}, {"type": "subtitle", "time": 1389.99, "timestamp": "00:23:09", "text": "えっと、会員になることとか、いろいろと。"}, {"type": "subtitle", "time": 1394.149, "timestamp": "00:23:14", "text": "そして、私はずっと昔、これをやっていたんです。えっと、私は"}, {"type": "subtitle", "time": 1396.31, "timestamp": "00:23:16", "text": "昔はこれをあらゆる"}, {"type": "subtitle", "time": 1399.51, "timestamp": "00:23:19", "text": "私の配信に登場した一人の人物"}, {"type": "subtitle", "time": 1401.51, "timestamp": "00:23:21", "text": "私の配信でチャットしたように。私はいつも"}, {"type": "subtitle", "time": 1404.39, "timestamp": "00:23:24", "text": "たとえ彼らが"}, {"type": "subtitle", "time": 1407.11, "timestamp": "00:23:27", "text": "配信には映っていませんでした。"}, {"type": "subtitle", "time": 1409.669, "timestamp": "00:23:29", "text": "えっと、ストリームの終わりの終わりに"}, {"type": "subtitle", "time": 1411.909, "timestamp": "00:23:31", "text": "最後にストリームを終える前に私はいつも"}, {"type": "subtitle", "time": 1414.51, "timestamp": "00:23:34", "text": "1時間か30分くらい時間を取って"}, {"type": "subtitle", "time": 1417.75, "timestamp": "00:23:37", "text": "あるいは、5分か10分であなたを好きになる"}, {"type": "subtitle", "time": 1419.83, "timestamp": "00:23:39", "text": "人々のリストを少し紹介します"}, {"type": "subtitle", "time": 1422.35, "timestamp": "00:23:42", "text": "来場してくださった参加者の皆様に感謝申し上げます。"}, {"type": "subtitle", "time": 1425.19, "timestamp": "00:23:45", "text": "彼らには、私たちが感謝するのと似たようなことをします"}, {"type": "subtitle", "time": 1426.63, "timestamp": "00:23:46", "text": "最後のメンバー全員"}, {"type": "subtitle", "time": 1429.59, "timestamp": "00:23:49", "text": "ストリーミング配信も、その場での配信も"}, {"type": "subtitle", "time": 1433.75, "timestamp": "00:23:53", "text": "あなたも会員になると。うん。"}, {"type": "subtitle", "time": 1435.789, "timestamp": "00:23:55", "text": "そして"}, {"type": "subtitle", "time": 1439.83, "timestamp": "00:23:59", "text": "えっと、もし私が"}]
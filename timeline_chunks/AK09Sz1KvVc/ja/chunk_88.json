[{"type": "subtitle", "time": 5285.99, "timestamp": "01:28:05", "text": "1つ。わかった。試してみましょう。よし、これ"}, {"type": "subtitle", "time": 5287.83, "timestamp": "01:28:07", "text": "メインのものに適合するように調整されます。"}, {"type": "subtitle", "time": 5291.47, "timestamp": "01:28:11", "text": "ということで、配信中です。そうですね、"}, {"type": "subtitle", "time": 5294.99, "timestamp": "01:28:14", "text": "イベントをエミュレートし、購読イベントをエミュレートします。それは"}, {"type": "subtitle", "time": 5297.79, "timestamp": "01:28:17", "text": "贈り物。では、"}, {"type": "subtitle", "time": 5301.59, "timestamp": "01:28:21", "text": "起こる？一点。わかった。もしそれが"}, {"type": "subtitle", "time": 5302.07, "timestamp": "01:28:22", "text": "コミュニティ"}, {"type": "subtitle", "time": 5303.55, "timestamp": "01:28:23", "text": "[音楽]"}, {"type": "subtitle", "time": 5312.35, "timestamp": "01:28:32", "text": "何？"}, {"type": "subtitle", "time": 5322.43, "timestamp": "01:28:42", "text": "えっと、もしそれがコミュニティなら"}, {"type": "subtitle", "time": 5325.83, "timestamp": "01:28:45", "text": "贈り物。待って、なぜコミュニティギフトは"}, {"type": "subtitle", "time": 5329.31, "timestamp": "01:28:49", "text": "10としてカウントされる"}, {"type": "subtitle", "time": 5331.59, "timestamp": "01:28:51", "text": "ポイント？理解できません。待って、待って、待って、"}]
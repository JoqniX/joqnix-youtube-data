[{"type": "subtitle", "time": 20460.75, "timestamp": "05:41:00", "text": "バムにあげたバージョン"}, {"type": "subtitle", "time": 20464.868, "timestamp": "05:41:04", "text": "バージョン6にはたくさんの愛が込められています。いいえ、"}, {"type": "subtitle", "time": 20468.788, "timestamp": "05:41:08", "text": "いや、いや。 Destiny 2を9時間プレイ"}, {"type": "subtitle", "time": 20471.11, "timestamp": "05:41:11", "text": "ストリーム、これは次のパート2です"}, {"type": "subtitle", "time": 20473.35, "timestamp": "05:41:13", "text": "12時間の配信を終えて、私たちは再び"}, {"type": "subtitle", "time": 20475.23, "timestamp": "05:41:15", "text": "9時間配信。"}, {"type": "subtitle", "time": 20478.75, "timestamp": "05:41:18", "text": "つまり、21時間ってことかな。"}, {"type": "subtitle", "time": 20491.35, "timestamp": "05:41:31", "text": "私は実際に髪を結んでそれを保っています"}, {"type": "subtitle", "time": 20493.15, "timestamp": "05:41:33", "text": "ダウン"}]
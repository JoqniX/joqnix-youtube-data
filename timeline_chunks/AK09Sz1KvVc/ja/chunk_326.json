[{"type": "subtitle", "time": 19562.55, "timestamp": "05:26:02", "text": "ゲーム内で私はお腹が好きです"}, {"type": "subtitle", "time": 19566.55, "timestamp": "05:26:06", "text": "お腹いっぱいになったので、食事に行きます。だから、"}, {"type": "subtitle", "time": 19569.55, "timestamp": "05:26:09", "text": "私はここでキャンプするだけです"}, {"type": "subtitle", "time": 19572.83, "timestamp": "05:26:12", "text": "推測。とりあえずここでキャンプしようかな。そして"}, {"type": "subtitle", "time": 19605.708, "timestamp": "05:26:45", "text": "なれ。ええ、そうあるべきです"}, {"type": "subtitle", "time": 19609.31, "timestamp": "05:26:49", "text": "良い。私は守られるだろう"}, {"type": "subtitle", "time": 19618.03, "timestamp": "05:26:58", "text": "それで、それで"}]
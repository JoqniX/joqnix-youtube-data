[{"type": "subtitle", "time": 14102.71, "timestamp": "03:55:02", "text": "つる植物は枯れてしまった。クリーパーに爆破された。"}, {"type": "subtitle", "time": 14106.55, "timestamp": "03:55:06", "text": "いや、クリーパーが私を爆破しようとして、私は死んだ"}, {"type": "subtitle", "time": 14108.59, "timestamp": "03:55:08", "text": "以上"}, {"type": "subtitle", "time": 14112.15, "timestamp": "03:55:12", "text": "木から半分飛び降りる"}, {"type": "subtitle", "time": 14113.59, "timestamp": "03:55:13", "text": "健康。"}, {"type": "subtitle", "time": 14121.03, "timestamp": "03:55:21", "text": "男の子。石畳に何が"}, {"type": "subtitle", "time": 14123.15, "timestamp": "03:55:23", "text": "敷石分割器"}, {"type": "subtitle", "time": 14144.59, "timestamp": "03:55:44", "text": "わかった。だから、私たちはすぐに"}, {"type": "subtitle", "time": 14154.63, "timestamp": "03:55:54", "text": "えっと、私が探索している間に、ですよね？なぜ私は"}, {"type": "subtitle", "time": 14156.11, "timestamp": "03:55:56", "text": "私がハイになっている？"}, {"type": "subtitle", "time": 14158.349, "timestamp": "03:55:58", "text": "私は死ぬ。いいえ。"}]
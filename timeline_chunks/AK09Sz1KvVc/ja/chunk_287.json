[{"type": "subtitle", "time": 17220.92, "timestamp": "04:47:00", "text": "ポップコーン。 ポップポルノ。ポップコーン。彼らは"}, {"type": "subtitle", "time": 17225.48, "timestamp": "04:47:05", "text": "ポップポルノ。ポップコーン。彼らは ポップコーン。ありがとう。"}, {"type": "subtitle", "time": 17233.31, "timestamp": "04:47:13", "text": "ありがとう。バカ"}, {"type": "subtitle", "time": 17235.708, "timestamp": "04:47:15", "text": "車。車"}, {"type": "subtitle", "time": 17245.948, "timestamp": "04:47:25", "text": "車。私は"}, {"type": "subtitle", "time": 17249.91, "timestamp": "04:47:29", "text": "星の慰め。いいえ、青い魔法"}, {"type": "subtitle", "time": 17252.07, "timestamp": "04:47:32", "text": "ログ。あ、待って。私はこうする必要があるのです。一度もない"}, {"type": "subtitle", "time": 17255.708, "timestamp": "04:47:35", "text": "心。苗木がある。私は持っています"}, {"type": "subtitle", "time": 17258.47, "timestamp": "04:47:38", "text": "苗木。誰かが仕掛けたんだと思う。"}, {"type": "subtitle", "time": 17260.19, "timestamp": "04:47:40", "text": "だから、私はただ"}, {"type": "subtitle", "time": 17263.51, "timestamp": "04:47:43", "text": "ああ、いや、いや、いや、いや、いや、いや。"}, {"type": "subtitle", "time": 17265.35, "timestamp": "04:47:45", "text": "そんなことはしないでください。そんなことはしないでください。しないでください"}, {"type": "subtitle", "time": 17266.788, "timestamp": "04:47:46", "text": "それ。そんなことはしないでください。そんなことは絶対に許さない。"}, {"type": "subtitle", "time": 17268.15, "timestamp": "04:47:48", "text": "そんなことはしないでください。そんなことしないで。しないで"}, {"type": "subtitle", "time": 17269.51, "timestamp": "04:47:49", "text": "そうしてください。そんなことしないで。そうでしょう"}, {"type": "subtitle", "time": 17271.628, "timestamp": "04:47:51", "text": "それ。そうでしょう"}, {"type": "subtitle", "time": 17273.628, "timestamp": "04:47:53", "text": "それ。"}, {"type": "subtitle", "time": 17277.27, "timestamp": "04:47:57", "text": "聖なる。お前の頭を殴ってやりたい。 N."}]
[{"type": "subtitle", "time": 8760.15, "timestamp": "02:26:00", "text": "はい。チャンネルURL。それは無関係ではない"}, {"type": "subtitle", "time": 8762.429, "timestamp": "02:26:02", "text": "ここは"}, {"type": "subtitle", "time": 8766.23, "timestamp": "02:26:06", "text": "指示。でも、手に入れますよ。なぜだめですか？"}, {"type": "subtitle", "time": 8768.15, "timestamp": "02:26:08", "text": "Discord関連のものは要りません。我々はできる"}, {"type": "subtitle", "time": 8769.07, "timestamp": "02:26:09", "text": "取り除く"}, {"type": "subtitle", "time": 8773.67, "timestamp": "02:26:13", "text": "それ。 HTTPコードは送信したくありません。"}, {"type": "subtitle", "time": 8777.03, "timestamp": "02:26:17", "text": "これとこれを削除できます。同じことが"}, {"type": "subtitle", "time": 8779.63, "timestamp": "02:26:19", "text": "スーパーステッカーを完成させる"}, {"type": "subtitle", "time": 8781.75, "timestamp": "02:26:21", "text": "良い。私たちは"}, {"type": "subtitle", "time": 8783.15, "timestamp": "02:26:23", "text": "[音楽]"}, {"type": "subtitle", "time": 8812.66, "timestamp": "02:26:52", "text": "写真とこれらは"}]
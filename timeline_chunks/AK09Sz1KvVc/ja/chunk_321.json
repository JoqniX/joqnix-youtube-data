[{"type": "subtitle", "time": 19262.628, "timestamp": "05:21:02", "text": "神。誰かがいる。ああ、神様。願っています"}, {"type": "subtitle", "time": 19265.31, "timestamp": "05:21:05", "text": "ここは彼らの居場所ではない。おお"}, {"type": "subtitle", "time": 19266.83, "timestamp": "05:21:06", "text": "いいえ。"}, {"type": "subtitle", "time": 19269.99, "timestamp": "05:21:09", "text": "聖なる。私はとても恥ずかしがります。なんてこった。そうするべきです。"}, {"type": "subtitle", "time": 19300.55, "timestamp": "05:21:40", "text": "お腹がすごく空いた。私はすべきです 私はすべきです 私は"}, {"type": "subtitle", "time": 19302.19, "timestamp": "05:21:42", "text": "私はすべきでしょうか"}, {"type": "subtitle", "time": 19304.91, "timestamp": "05:21:44", "text": "実際には"}, {"type": "subtitle", "time": 19309.788, "timestamp": "05:21:49", "text": "えっと、ここですよね？だから私は"}, {"type": "subtitle", "time": 19312.99, "timestamp": "05:21:52", "text": "私のチェリーボードはどこ？"}, {"type": "subtitle", "time": 19315.868, "timestamp": "05:21:55", "text": "ああ、チェリー"}]
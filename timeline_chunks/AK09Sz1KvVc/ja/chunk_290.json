[{"type": "subtitle", "time": 17400.39, "timestamp": "04:50:00", "text": "えっと、私はHPを使っています。私はもうすぐ死ぬだろう。"}, {"type": "subtitle", "time": 17402.39, "timestamp": "04:50:02", "text": "私は本当に死ぬんだ。私は本当に死ぬんだ。"}, {"type": "subtitle", "time": 17405.15, "timestamp": "04:50:05", "text": "私は死んだ。私は死んだ。"}, {"type": "subtitle", "time": 17406.59, "timestamp": "04:50:06", "text": "おお。"}, {"type": "subtitle", "time": 17409.47, "timestamp": "04:50:09", "text": "[音楽]"}, {"type": "subtitle", "time": 17417.39, "timestamp": "04:50:17", "text": "おお。"}, {"type": "subtitle", "time": 17420.03, "timestamp": "04:50:20", "text": "待って。これが実際に起こったことです。"}, {"type": "subtitle", "time": 17423.67, "timestamp": "04:50:23", "text": "子供たちのミナ、ただの子供たちじゃない、ミナ。もしあなたが"}, {"type": "subtitle", "time": 17427.67, "timestamp": "04:50:27", "text": "家と呼ばれる場所がなく、"}, {"type": "subtitle", "time": 17430.11, "timestamp": "04:50:30", "text": "さまよう"}, {"type": "subtitle", "time": 17432.27, "timestamp": "04:50:32", "text": "その周り"}, {"type": "subtitle", "time": 17444.948, "timestamp": "04:50:44", "text": "聖なる。正直に言うと、理由はわかりません"}, {"type": "subtitle", "time": 17447.43, "timestamp": "04:50:47", "text": "あなた。最近ストリーミング配信を始めました"}, {"type": "subtitle", "time": 17448.948, "timestamp": "04:50:48", "text": "私は12時間ほど配信しています。"}, {"type": "subtitle", "time": 17451.83, "timestamp": "04:50:51", "text": "右？気分が悪いわけではない"}, {"type": "subtitle", "time": 17453.23, "timestamp": "04:50:53", "text": "種の"}, {"type": "subtitle", "time": 17455.43, "timestamp": "04:50:55", "text": "今日。これは彼らが言うところの"}, {"type": "subtitle", "time": 17458.27, "timestamp": "04:50:58", "text": "復元"}]
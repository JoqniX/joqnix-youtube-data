[{"type": "subtitle", "time": 8701.51, "timestamp": "02:25:01", "text": "これらのものはとても奇妙に見えます"}, {"type": "subtitle", "time": 8704.63, "timestamp": "02:25:04", "text": "そして奇妙？これは「オーマイゴッド」ではありません。それ"}, {"type": "subtitle", "time": 8708.23, "timestamp": "02:25:08", "text": "これは昔の私が作ったものですよね？いつ"}, {"type": "subtitle", "time": 8710.79, "timestamp": "02:25:10", "text": "これを見ると、どれだけ"}, {"type": "subtitle", "time": 8715.19, "timestamp": "02:25:15", "text": "初心者です。このポテトがそうだったらいいのに。なぜ"}, {"type": "subtitle", "time": 8718.309, "timestamp": "02:25:18", "text": "ここにこうやって置いてくれますか？なぜ"}, {"type": "subtitle", "time": 8721.11, "timestamp": "02:25:21", "text": "そこに事件の陳述書が置いてある？まるで"}, {"type": "subtitle", "time": 8730.15, "timestamp": "02:25:30", "text": "それ？わからない。とにかく、スーパーチャット。"}, {"type": "subtitle", "time": 8731.99, "timestamp": "02:25:31", "text": "こいつらは必要ない。削除できます"}, {"type": "subtitle", "time": 8734.71, "timestamp": "02:25:34", "text": "彼ら。あ、待って。実際、私たちにはそれが必要なのです。"}, {"type": "subtitle", "time": 8736.95, "timestamp": "02:25:36", "text": "プラットフォームを撤去します。わかった。だった"}, {"type": "subtitle", "time": 8738.67, "timestamp": "02:25:38", "text": "色を引っ張る。"}, {"type": "subtitle", "time": 8741.349, "timestamp": "02:25:41", "text": "わかった。いいえ、違います。ちょっと待ってください。"}, {"type": "subtitle", "time": 8744.67, "timestamp": "02:25:44", "text": "聞く。私たちはそうはしません。ない"}, {"type": "subtitle", "time": 8747.349, "timestamp": "02:25:47", "text": "これ。ユーザーの添え字を取得しています。"}, {"type": "subtitle", "time": 8749.83, "timestamp": "02:25:49", "text": "いいえ、ユーザー登録は必要ありません。"}, {"type": "subtitle", "time": 8752.95, "timestamp": "02:25:52", "text": "うん。えっと、スーパーチャットの金額が必要です。"}, {"type": "subtitle", "time": 8755.429, "timestamp": "02:25:55", "text": "スーパーチャット金額文字列通貨と"}, {"type": "subtitle", "time": 8756.99, "timestamp": "02:25:56", "text": "スーパーチャットティア。"}]
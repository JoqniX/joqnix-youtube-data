[{"type": "subtitle", "time": 13022.95, "timestamp": "03:37:02", "text": "産卵。わあ、彼らは本当に良い"}, {"type": "subtitle", "time": 13025.63, "timestamp": "03:37:05", "text": "レイアウトも。ニース。ああ、"}, {"type": "subtitle", "time": 13028.87, "timestamp": "03:37:08", "text": "ああ。おお。何か作ってみようかな"}, {"type": "subtitle", "time": 13033.11, "timestamp": "03:37:13", "text": "このような。私には木材がたくさんある。"}, {"type": "subtitle", "time": 13035.63, "timestamp": "03:37:15", "text": "たぶん私はこんなものを作るべきでしょう"}, {"type": "subtitle", "time": 13039.17, "timestamp": "03:37:19", "text": "これ。これはクールなデザインですね。"}, {"type": "subtitle", "time": 13041.309, "timestamp": "03:37:21", "text": "[音楽]"}, {"type": "subtitle", "time": 13050.99, "timestamp": "03:37:30", "text": "低い。与える"}, {"type": "subtitle", "time": 13058.349, "timestamp": "03:37:38", "text": "健康。そこにいる"}, {"type": "subtitle", "time": 13060.429, "timestamp": "03:37:40", "text": "行く。チップ"}, {"type": "subtitle", "time": 13066.469, "timestamp": "03:37:46", "text": "ゾンビ。あ、待って。カボチャのような"}, {"type": "subtitle", "time": 13070.269, "timestamp": "03:37:50", "text": "男の物。おお。それはとても"}, {"type": "subtitle", "time": 13073.91, "timestamp": "03:37:53", "text": "かわいい。待って、これは次の雪ですか"}]
[{"type": "subtitle", "time": 1020.23, "timestamp": "00:17:00", "text": "私はとても幸せです。昨日の配信は両方とも"}, {"type": "subtitle", "time": 1022.15, "timestamp": "00:17:02", "text": "ストリーム、パート１、２番目の"}, {"type": "subtitle", "time": 1026.309, "timestamp": "00:17:06", "text": "ジョッカソン16日目、私たちは素晴らしいチャットをしました"}, {"type": "subtitle", "time": 1028.789, "timestamp": "00:17:08", "text": "そして、このサポートに感謝します。"}, {"type": "subtitle", "time": 1032.35, "timestamp": "00:17:12", "text": "皆さん、本当にスーパーチャットして"}, {"type": "subtitle", "time": 1035.59, "timestamp": "00:17:15", "text": "もの。人生でこんなことが起こるとは思ってもみなかった"}, {"type": "subtitle", "time": 1038.549, "timestamp": "00:17:18", "text": "昨日、赤いスーパーチャットを見ました"}, {"type": "subtitle", "time": 1040.71, "timestamp": "00:17:20", "text": "そして、赤いスーパーをくれたアキアウィに感謝します"}, {"type": "subtitle", "time": 1049.15, "timestamp": "00:17:29", "text": "そしてまた"}, {"type": "subtitle", "time": 1051.75, "timestamp": "00:17:31", "text": "昨日の配信のように、私たちは準備しました"}, {"type": "subtitle", "time": 1054.549, "timestamp": "00:17:34", "text": "今日のストリームのメンバー"}, {"type": "subtitle", "time": 1058.47, "timestamp": "00:17:38", "text": "会員ランクとその他すべては正しいので"}, {"type": "subtitle", "time": 1061.75, "timestamp": "00:17:41", "text": "私はずっと昔からそのことを言っていませんでした"}, {"type": "subtitle", "time": 1065.43, "timestamp": "00:17:45", "text": "私はずっとそうしたいと思っていたと言いましたが"}, {"type": "subtitle", "time": 1067.99, "timestamp": "00:17:47", "text": "いつか私が"}, {"type": "subtitle", "time": 1070.549, "timestamp": "00:17:50", "text": "会員権は最低価格で取得します"}, {"type": "subtitle", "time": 1073.909, "timestamp": "00:17:53", "text": "できるだけティアにしたいので、"}, {"type": "subtitle", "time": 1077.75, "timestamp": "00:17:57", "text": "みんなにこうあってほしい。"}]
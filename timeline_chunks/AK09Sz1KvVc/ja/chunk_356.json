[{"type": "subtitle", "time": 21360.708, "timestamp": "05:56:00", "text": "だから、私は長い間プレイしていません"}, {"type": "subtitle", "time": 21366.23, "timestamp": "05:56:06", "text": "私はネザーに行く必要はありません"}, {"type": "subtitle", "time": 21369.51, "timestamp": "05:56:09", "text": "瞬間が必要だから、私は作る必要がある"}, {"type": "subtitle", "time": 21372.47, "timestamp": "05:56:12", "text": "私の家を作り、あなたが知っているように落ち着く"}, {"type": "subtitle", "time": 21374.43, "timestamp": "05:56:14", "text": "最初にダウン"}, {"type": "subtitle", "time": 21378.59, "timestamp": "05:56:18", "text": "それからネザーを探検する、それが"}, {"type": "subtitle", "time": 21380.42, "timestamp": "05:56:20", "text": "やり方"}, {"type": "subtitle", "time": 21383.47, "timestamp": "05:56:23", "text": "[音楽]"}, {"type": "subtitle", "time": 21386.39, "timestamp": "05:56:26", "text": "それ。作り方を知っています"}, {"type": "subtitle", "time": 21389.11, "timestamp": "05:56:29", "text": "したいけど、今はしたくない。"}, {"type": "subtitle", "time": 21391.39, "timestamp": "05:56:31", "text": "解決したい"}, {"type": "subtitle", "time": 21394.67, "timestamp": "05:56:34", "text": "すでに下がっている。私は死にそうだったので"}, {"type": "subtitle", "time": 21398.708, "timestamp": "05:56:38", "text": "多くの。まずは落ち着きたい。 H あなた"}, {"type": "subtitle", "time": 21400.59, "timestamp": "05:56:40", "text": "しないで"}, {"type": "subtitle", "time": 21403.03, "timestamp": "05:56:43", "text": "心。だから、良いものを探しているんです"}, {"type": "subtitle", "time": 21405.83, "timestamp": "05:56:45", "text": "場所"}, {"type": "subtitle", "time": 21409.91, "timestamp": "05:56:49", "text": "えっと、チェリーピンクチェリーが44個くらいあるんです"}, {"type": "subtitle", "time": 21412.07, "timestamp": "05:56:52", "text": "ええと、苗木です。だから、私は作りたいんです"}, {"type": "subtitle", "time": 21413.31, "timestamp": "05:56:53", "text": "のように"}, {"type": "subtitle", "time": 21418.19, "timestamp": "05:56:58", "text": "バイオーム全体、桜でいっぱいの土地"}]
[{"type": "subtitle", "time": 8283.429, "timestamp": "02:18:03", "text": "ええと、一瞬怖かったんです。私は"}, {"type": "subtitle", "time": 8285.27, "timestamp": "02:18:05", "text": "「あ、待って。私、自分の"}, {"type": "subtitle", "time": 8288.23, "timestamp": "02:18:08", "text": "音楽の別名アカウント？だって私は"}, {"type": "subtitle", "time": 8290.469, "timestamp": "02:18:10", "text": "他の情報を漏らしたくない"}, {"type": "subtitle", "time": 8293.23, "timestamp": "02:18:13", "text": "ジョック以外の別名"}, {"type": "subtitle", "time": 8296.91, "timestamp": "02:18:16", "text": "なぜならそれは"}, {"type": "subtitle", "time": 8300.91, "timestamp": "02:18:20", "text": "秘密。それは君たちが見つけるべきものだ"}, {"type": "subtitle", "time": 8307.07, "timestamp": "02:18:27", "text": "[音楽]"}, {"type": "subtitle", "time": 8331.15, "timestamp": "02:18:51", "text": "する？サミーがこれをやってくれていたら、"}, {"type": "subtitle", "time": 8333.83, "timestamp": "02:18:53", "text": "男。サミーがこれをやってくれていたら、"}, {"type": "subtitle", "time": 8336.23, "timestamp": "02:18:56", "text": "もっとうまくできたはずだ。"}, {"type": "subtitle", "time": 8338.429, "timestamp": "02:18:58", "text": "私はより速く、より良く、"}]
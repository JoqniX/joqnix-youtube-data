[{"type": "subtitle", "time": 21421.51, "timestamp": "05:57:01", "text": "花を咲かせ、その中に家を建てる。だから私は"}, {"type": "subtitle", "time": 21424.548, "timestamp": "05:57:04", "text": "まるで、"}, {"type": "subtitle", "time": 21426.75, "timestamp": "05:57:06", "text": "たくさんの木材と"}, {"type": "subtitle", "time": 21430.51, "timestamp": "05:57:10", "text": "あまり"}, {"type": "subtitle", "time": 21433.35, "timestamp": "05:57:13", "text": "近く。彼は立っていられない"}, {"type": "subtitle", "time": 21435.75, "timestamp": "05:57:15", "text": "ネザーだよ、みんな。そうそう。私は行く"}, {"type": "subtitle", "time": 21442.708, "timestamp": "05:57:22", "text": "なぜ？まだ古いものを手に入れなければならない"}, {"type": "subtitle", "time": 21446.548, "timestamp": "05:57:26", "text": "鉄製品がここにあるけど、私は死んだ。私 私"}, {"type": "subtitle", "time": 21448.39, "timestamp": "05:57:28", "text": "鉄のつるはしと剣を失くし、"}, {"type": "subtitle", "time": 21449.97, "timestamp": "05:57:29", "text": "もの。"}, {"type": "subtitle", "time": 21451.19, "timestamp": "05:57:31", "text": "[音楽]"}, {"type": "subtitle", "time": 21453.59, "timestamp": "05:57:33", "text": "ネコはどこへ行ったの？彼は"}, {"type": "subtitle", "time": 21457.47, "timestamp": "05:57:37", "text": "寝ている。ええ、ネコネオの騎手は"}, {"type": "subtitle", "time": 21461.19, "timestamp": "05:57:41", "text": "スイープ。私たちは男性に"}, {"type": "subtitle", "time": 21465.27, "timestamp": "05:57:45", "text": "今日は騎手がここにいます。うん。彼がそうするかもしれない"}, {"type": "subtitle", "time": 21474.23, "timestamp": "05:57:54", "text": "時間。殺すなどのもっと良いことができる"}, {"type": "subtitle", "time": 21476.47, "timestamp": "05:57:56", "text": "村々。ああ、それもそうだね。でも私はそうは思わない"}, {"type": "subtitle", "time": 21479.67, "timestamp": "05:57:59", "text": "攻撃的に殺したい"}]
[{"type": "subtitle", "time": 16021.03, "timestamp": "04:27:01", "text": "そこには。赤いカエデ。これはどうですか？"}, {"type": "subtitle", "time": 16027.71, "timestamp": "04:27:07", "text": "ログ？つまり、それは毛皮の葉っぱということになりますね。"}, {"type": "subtitle", "time": 16031.91, "timestamp": "04:27:11", "text": "わかった。そして、この松の葉。ああ、松"}, {"type": "subtitle", "time": 16034.149, "timestamp": "04:27:14", "text": "ログ。わかった。"}, {"type": "subtitle", "time": 16037.11, "timestamp": "04:27:17", "text": "オレンジ色のテラ。しかし、テラは存在するのか"}, {"type": "subtitle", "time": 16042.99, "timestamp": "04:27:22", "text": "コッタ？おお。赤い岩。何？おお。赤"}, {"type": "subtitle", "time": 16047.03, "timestamp": "04:27:27", "text": "砂。茶色のテラコッタ。おお。何が"}, {"type": "subtitle", "time": 16052.51, "timestamp": "04:27:32", "text": "これ？パロベラベルデの丸太。何が"}, {"type": "subtitle", "time": 16054.67, "timestamp": "04:27:34", "text": "これ？パロ"}, {"type": "subtitle", "time": 16059.55, "timestamp": "04:27:39", "text": "ベラベラの葉。"}, {"type": "subtitle", "time": 16063.429, "timestamp": "04:27:43", "text": "おお。アロエベラ。ベイビー。何？それだけではない"}, {"type": "subtitle", "time": 16069.149, "timestamp": "04:27:49", "text": "アロエベラも。何？トゲトゲしたビール缶"}, {"type": "subtitle", "time": 16070.54, "timestamp": "04:27:50", "text": "ネコ"}, {"type": "subtitle", "time": 16072.269, "timestamp": "04:27:52", "text": "[音楽]"}, {"type": "subtitle", "time": 16076.469, "timestamp": "04:27:56", "text": "鶏 風に吹かれた 風に吹かれた ああ、吹かれた"}]
[{"type": "subtitle", "time": 17581.868, "timestamp": "04:53:01", "text": "死にかけている。それは良くない。これは実際には"}, {"type": "subtitle", "time": 17586.52, "timestamp": "04:53:06", "text": "悪い。よし、行こう。"}, {"type": "subtitle", "time": 17589.15, "timestamp": "04:53:09", "text": "[音楽]"}, {"type": "subtitle", "time": 17608.15, "timestamp": "04:53:28", "text": "葉？ええ、桜の葉は"}, {"type": "subtitle", "time": 17610.708, "timestamp": "04:53:30", "text": "最も需要の高いものになる"}, {"type": "subtitle", "time": 17613.59, "timestamp": "04:53:33", "text": "サーバーだと思います。いや、いや、いや。しかし"}, {"type": "subtitle", "time": 17616.51, "timestamp": "04:53:36", "text": "桜はみんな好きだけど、"}, {"type": "subtitle", "time": 17620.47, "timestamp": "04:53:40", "text": "右？嫌いな人なんていないでしょう？いいえ。"}, {"type": "subtitle", "time": 17622.47, "timestamp": "04:53:42", "text": "しかし、さまざまなタイプがあります"}, {"type": "subtitle", "time": 17626.15, "timestamp": "04:53:46", "text": "アオラの木やエンチャントのような木"}, {"type": "subtitle", "time": 17628.788, "timestamp": "04:53:48", "text": "エメラルド色の木々やカエデのような木々"}, {"type": "subtitle", "time": 17632.83, "timestamp": "04:53:52", "text": "葉っぱとか、木とか、そういうもの。それで"}, {"type": "subtitle", "time": 17635.75, "timestamp": "04:53:55", "text": "いいね。私はここの建物が大好きです。私"}, {"type": "subtitle", "time": 17637.47, "timestamp": "04:53:57", "text": "誰が建てたのかはわからない"}]
[{"type": "subtitle", "time": 15966.51, "timestamp": "04:26:06", "text": "タリウムとは何か"}, {"type": "subtitle", "time": 15968.189, "timestamp": "04:26:08", "text": "ブロック？"}, {"type": "subtitle", "time": 15971.11, "timestamp": "04:26:11", "text": "わあ、それは聞いたことのない新しいブロックだ"}, {"type": "subtitle", "time": 15975.269, "timestamp": "04:26:15", "text": "前に。紫色の３があります。何？"}, {"type": "subtitle", "time": 15977.99, "timestamp": "04:26:17", "text": "待って、これは何？これは何ですか？"}, {"type": "subtitle", "time": 15980.03, "timestamp": "04:26:20", "text": "ジャック"}, {"type": "subtitle", "time": 15987.91, "timestamp": "04:26:27", "text": "ログ領域には、すべての 80% が含まれています"}, {"type": "subtitle", "time": 15989.389, "timestamp": "04:26:29", "text": "プロフィールは"}, {"type": "subtitle", "time": 15992.349, "timestamp": "04:26:32", "text": "世界。"}, {"type": "subtitle", "time": 15998.83, "timestamp": "04:26:38", "text": "80%。"}, {"type": "subtitle", "time": 16001.67, "timestamp": "04:26:41", "text": "おお。どうやってすべてのブロックを手に入れたのか"}, {"type": "subtitle", "time": 16003.149, "timestamp": "04:26:43", "text": "けれど？ああ、"}, {"type": "subtitle", "time": 16008.229, "timestamp": "04:26:48", "text": "神。待って。草木に覆われた石。"}, {"type": "subtitle", "time": 16011.83, "timestamp": "04:26:51", "text": "これは、まるでカエデの丸太のようです。の"}, {"type": "subtitle", "time": 16018.149, "timestamp": "04:26:58", "text": "カエデ、それから銀カエデもまた"}]
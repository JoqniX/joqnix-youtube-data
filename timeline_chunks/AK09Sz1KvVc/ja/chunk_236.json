[{"type": "subtitle", "time": 14163.189, "timestamp": "03:56:03", "text": "見る？なんてこった。キラーのping値が高い。"}, {"type": "subtitle", "time": 14164.51, "timestamp": "03:56:04", "text": "春"}, {"type": "subtitle", "time": 14167.99, "timestamp": "03:56:07", "text": "さっきは本当に低かったんだけどね。そして"}, {"type": "subtitle", "time": 14171.07, "timestamp": "03:56:11", "text": "Suryakunのpingがなぜ"}, {"type": "subtitle", "time": 14180.189, "timestamp": "03:56:20", "text": "おお。ピング値はゼロです。おお。低い"}, {"type": "subtitle", "time": 14181.79, "timestamp": "03:56:21", "text": "遅延。"}, {"type": "subtitle", "time": 14187.15, "timestamp": "03:56:27", "text": "おお。待って。キラーのピング値がゼロになった。"}, {"type": "subtitle", "time": 14194.07, "timestamp": "03:56:34", "text": "サス。もしかしたら彼らはとても近いところにいるのかもしれない"}, {"type": "subtitle", "time": 14200.59, "timestamp": "03:56:40", "text": "サーバ。ああ、それは"}, {"type": "subtitle", "time": 14202.83, "timestamp": "03:56:42", "text": "ページャ。"}, {"type": "subtitle", "time": 14204.75, "timestamp": "03:56:44", "text": "なぜ？あなたはするであろう"}]
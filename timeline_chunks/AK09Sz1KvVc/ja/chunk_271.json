[{"type": "subtitle", "time": 16262.149, "timestamp": "04:31:02", "text": "ああ、これは何でしょう？ポピー。ああ、それは"}, {"type": "subtitle", "time": 16270.75, "timestamp": "04:31:10", "text": "アンモン。"}, {"type": "subtitle", "time": 16272.67, "timestamp": "04:31:12", "text": "わかった。何が"}, {"type": "subtitle", "time": 16277.99, "timestamp": "04:31:17", "text": "これ？終点型電球ランタン。おお、"}, {"type": "subtitle", "time": 16281.07, "timestamp": "04:31:21", "text": "すごく素敵なものがたくさんあるよ。ああ、"}, {"type": "subtitle", "time": 16284.75, "timestamp": "04:31:24", "text": "ああ、私はすべてを発見する必要がある"}, {"type": "subtitle", "time": 16287.95, "timestamp": "04:31:27", "text": "これ。まだ続きがあります。これは何ですか？"}, {"type": "subtitle", "time": 16291.429, "timestamp": "04:31:31", "text": "これは魔法がかけられていると思います"}, {"type": "subtitle", "time": 16294.87, "timestamp": "04:31:34", "text": "ログ。魔法の木々ですよね？そこには"}, {"type": "subtitle", "time": 16298.11, "timestamp": "04:31:38", "text": "青い場所も。"}, {"type": "subtitle", "time": 16301.469, "timestamp": "04:31:41", "text": "おお、何らかのメカニズムが"}, {"type": "subtitle", "time": 16308.87, "timestamp": "04:31:48", "text": "これら？でも、それはまるで"}, {"type": "subtitle", "time": 16311.189, "timestamp": "04:31:51", "text": "何かがハイライトされているようです。"}, {"type": "subtitle", "time": 16314.149, "timestamp": "04:31:54", "text": "しかし、この場所の中に入ると、"}, {"type": "subtitle", "time": 16316.269, "timestamp": "04:31:56", "text": "大きな"}, {"type": "subtitle", "time": 16318.99, "timestamp": "04:31:58", "text": "ドーム。それはとても"}]
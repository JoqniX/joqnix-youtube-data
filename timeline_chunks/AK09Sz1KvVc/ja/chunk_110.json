[{"type": "subtitle", "time": 6601.43, "timestamp": "01:50:01", "text": "数学そのものだと私は思います。だから私は"}, {"type": "subtitle", "time": 6602.43, "timestamp": "01:50:02", "text": "テスト"}, {"type": "subtitle", "time": 6605.629, "timestamp": "01:50:05", "text": "それ。試してみたい。"}, {"type": "subtitle", "time": 6609.03, "timestamp": "01:50:09", "text": "ええと、テストしてみます。わかった。だからどうぞ"}, {"type": "subtitle", "time": 6611.75, "timestamp": "01:50:11", "text": "チャットに表示されるメッセージは無視してください"}, {"type": "subtitle", "time": 6615.43, "timestamp": "01:50:15", "text": "今のところはYouTubeとTwitchの両方です。それで"}, {"type": "subtitle", "time": 6618.95, "timestamp": "01:50:18", "text": "まず最初にスーパーをチェックします"}, {"type": "subtitle", "time": 6620.75, "timestamp": "01:50:20", "text": "会員"}, {"type": "subtitle", "time": 6644.31, "timestamp": "01:50:44", "text": "1つ。わかった。なぜチャットで送信されなかったのですか？"}, {"type": "subtitle", "time": 6649.3, "timestamp": "01:50:49", "text": "神。何"}, {"type": "chat", "time": 6657.19, "timestamp": "01:50:57", "author": "@myself_lostkid", "avatar": "https://yt4.ggpht.com/DutRWyzqfw4DHLMg2yazBW0gzopTU4iTKRzen-XCZ2cqt2Gfe0GhPOl1vG4yGNDQTNXhMVMm7w=s64-c-k-c0x00ffffff-no-rj", "message": "😔"}]
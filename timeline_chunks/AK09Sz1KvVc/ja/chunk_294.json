[{"type": "subtitle", "time": 17641.67, "timestamp": "04:54:01", "text": "それ。彼はとんでもない奴だ。これはとても赤い"}, {"type": "subtitle", "time": 17643.39, "timestamp": "04:54:03", "text": "そして"}, {"type": "subtitle", "time": 17650.27, "timestamp": "04:54:10", "text": "これはたくさん使ったに違いない"}, {"type": "subtitle", "time": 17666.948, "timestamp": "04:54:26", "text": "いいえ。私にはベッドがありません。私は持っていません"}, {"type": "subtitle", "time": 17672.788, "timestamp": "04:54:32", "text": "大丈夫です。大丈夫です。大丈夫です。行く"}, {"type": "subtitle", "time": 17686.39, "timestamp": "04:54:46", "text": "うん。死ね、死ね、死ね、死ね、死ね。死ぬ"}, {"type": "subtitle", "time": 17687.708, "timestamp": "04:54:47", "text": "の"}, {"type": "subtitle", "time": 17695.23, "timestamp": "04:54:55", "text": "もの。私の"}]
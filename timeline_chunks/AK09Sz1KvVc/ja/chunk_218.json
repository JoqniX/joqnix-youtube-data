[{"type": "subtitle", "time": 13080.83, "timestamp": "03:38:00", "text": "わかった。それはとても"}, {"type": "subtitle", "time": 13083.349, "timestamp": "03:38:03", "text": "かわいい。あれはウサギですか？待って、"}, {"type": "subtitle", "time": 13085.51, "timestamp": "03:38:05", "text": "マインクラフトにウサギが登場？え、本当に？待って、"}, {"type": "subtitle", "time": 13088.15, "timestamp": "03:38:08", "text": "何？あ、待って。あったよ。うん、"}, {"type": "subtitle", "time": 13090.67, "timestamp": "03:38:10", "text": "ウサギがいる。"}, {"type": "subtitle", "time": 13094.19, "timestamp": "03:38:14", "text": "忘れていた。殺すのはとても難しい"}, {"type": "subtitle", "time": 13105.51, "timestamp": "03:38:25", "text": "待って、彼らは何も落とさないんじゃないの？"}, {"type": "subtitle", "time": 13107.55, "timestamp": "03:38:27", "text": "いいえ、私は1人殺しました"}, {"type": "subtitle", "time": 13110.19, "timestamp": "03:38:30", "text": "無実の。オアギ"}, {"type": "subtitle", "time": 13112.36, "timestamp": "03:38:32", "text": "パコは罪のない一人を殺害した。"}, {"type": "subtitle", "time": 13115.07, "timestamp": "03:38:35", "text": "[音楽]"}, {"type": "subtitle", "time": 13119.59, "timestamp": "03:38:39", "text": "いいえ。わかりました。えっと、ここはどこ？する必要がある"}, {"type": "subtitle", "time": 13121.71, "timestamp": "03:38:41", "text": "最も"}, {"type": "subtitle", "time": 13123.99, "timestamp": "03:38:43", "text": "正確に。あ、待って。それは川です、"}, {"type": "subtitle", "time": 13130.55, "timestamp": "03:38:50", "text": "ボート。どのような設定が想定されているか"}]
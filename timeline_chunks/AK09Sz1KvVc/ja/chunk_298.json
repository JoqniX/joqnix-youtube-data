[{"type": "subtitle", "time": 17881.31, "timestamp": "04:58:01", "text": "良い。"}, {"type": "subtitle", "time": 17883.23, "timestamp": "04:58:03", "text": "運命は留まる"}, {"type": "subtitle", "time": 17885.708, "timestamp": "04:58:05", "text": "の"}, {"type": "subtitle", "time": 17917.11, "timestamp": "04:58:37", "text": "良い。待って、斧をなくしちゃった。待って、どこに"}, {"type": "subtitle", "time": 17928.47, "timestamp": "04:58:48", "text": "斧？斧が必要だった。斧をなくしてしまった。"}, {"type": "subtitle", "time": 17937.91, "timestamp": "04:58:57", "text": "[音楽]"}]
[{"type": "subtitle", "time": 12965.15, "timestamp": "03:36:05", "text": "1"}, {"type": "subtitle", "time": 12968.55, "timestamp": "03:36:08", "text": "ああ、料理しておけばよかったのに"}, {"type": "subtitle", "time": 12982.63, "timestamp": "03:36:22", "text": "待って、誰かの家がある"}, {"type": "subtitle", "time": 12984.03, "timestamp": "03:36:24", "text": "こっちにいるのは"}, {"type": "subtitle", "time": 12987.07, "timestamp": "03:36:27", "text": "このベリー"}, {"type": "subtitle", "time": 12993.63, "timestamp": "03:36:33", "text": "聖なる。誰の家が"}, {"type": "subtitle", "time": 12997.15, "timestamp": "03:36:37", "text": "これ？ A それはとても"}, {"type": "subtitle", "time": 12999.07, "timestamp": "03:36:39", "text": "かわいい"}, {"type": "subtitle", "time": 13003.87, "timestamp": "03:36:43", "text": "予告なしに中に入っていく。それで、"}, {"type": "subtitle", "time": 13011.03, "timestamp": "03:36:51", "text": "これ？私たちはまだある意味で"}, {"type": "subtitle", "time": 13014.469, "timestamp": "03:36:54", "text": "建設工事ですね。待って、この部分は"}, {"type": "subtitle", "time": 13016.71, "timestamp": "03:36:56", "text": "暗い。ええ、暴徒がいるかもしれません。そこには"}]
[{"type": "subtitle", "time": 13800.11, "timestamp": "03:50:00", "text": "ブラシ"}, {"type": "subtitle", "time": 13808.429, "timestamp": "03:50:08", "text": "破棄。それは鍵のようなものですか？いいえ。"}, {"type": "subtitle", "time": 13828.269, "timestamp": "03:50:28", "text": "それ？運"}, {"type": "subtitle", "time": 13831.189, "timestamp": "03:50:31", "text": "爆弾。使用許可がありません"}, {"type": "subtitle", "time": 13833.59, "timestamp": "03:50:33", "text": "任意のサブコマンド。なるほど、そういうことだったんですね。だから私は"}, {"type": "subtitle", "time": 13835.55, "timestamp": "03:50:35", "text": "何も使えなくなるでしょう。"}, {"type": "subtitle", "time": 13839.03, "timestamp": "03:50:39", "text": "よし、もっと。では、自分たちで見つけてみましょう。"}, {"type": "subtitle", "time": 13848.15, "timestamp": "03:50:48", "text": "浮気。そうせざるを得なかった。そうせざるを得なかった。"}]
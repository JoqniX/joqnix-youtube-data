[{"type": "subtitle", "time": 19682.75, "timestamp": "05:28:02", "text": "私は"}, {"type": "subtitle", "time": 19686.788, "timestamp": "05:28:06", "text": "戻る。はい。音楽を聴くことができ、"}, {"type": "subtitle", "time": 19688.948, "timestamp": "05:28:08", "text": "また、待って、Chromeを入れるべきでしょうか？私"}, {"type": "subtitle", "time": 19690.51, "timestamp": "05:28:10", "text": "しないで"}, {"type": "subtitle", "time": 19697.868, "timestamp": "05:28:17", "text": "わかった。あ、待って。私は危うく壊すところだった"}, {"type": "subtitle", "time": 19707.39, "timestamp": "05:28:27", "text": "すぐ戻ります。何？"}, {"type": "subtitle", "time": 19710.03, "timestamp": "05:28:30", "text": "わかった。"}, {"type": "subtitle", "time": 19713.548, "timestamp": "05:28:33", "text": "すぐ戻ります。もしそれがあなただったら"}, {"type": "subtitle", "time": 19717.99, "timestamp": "05:28:37", "text": "猫の体温を赤ちゃんの熱のように感じさせることができます。"}, {"type": "subtitle", "time": 19721.35, "timestamp": "05:28:41", "text": "だからネオちゃんに餌をあげられる。しかし、痛みは"}, {"type": "subtitle", "time": 19722.99, "timestamp": "05:28:42", "text": "する"}, {"type": "subtitle", "time": 19726.31, "timestamp": "05:28:46", "text": "痛み。とにかく、昼食を買ってから行きます。"}]
[{"type": "subtitle", "time": 1260.47, "timestamp": "00:21:00", "text": "インセンティブとは、ええ、私たちは"}, {"type": "subtitle", "time": 1262.789, "timestamp": "00:21:02", "text": "糸車を回す"}, {"type": "subtitle", "time": 1266.31, "timestamp": "00:21:06", "text": "それらのタイプのサブアトンをすべて実行する必要があります"}, {"type": "subtitle", "time": 1268.789, "timestamp": "00:21:08", "text": "コンテンツも同様です。"}, {"type": "subtitle", "time": 1273.83, "timestamp": "00:21:13", "text": "ええ、そうします。私はただ、えーと"}, {"type": "subtitle", "time": 1276.43, "timestamp": "00:21:16", "text": "Googleにすべてログを記録するような"}, {"type": "subtitle", "time": 1280.39, "timestamp": "00:21:20", "text": "スプレッドシート、そしてそれに基づいて"}, {"type": "subtitle", "time": 1283.27, "timestamp": "00:21:23", "text": "やらなきゃいけないんだよ。では、そうします。"}, {"type": "subtitle", "time": 1286.23, "timestamp": "00:21:26", "text": "今日中にも。心配しないで、私がここにいるから"}, {"type": "subtitle", "time": 1288.909, "timestamp": "00:21:28", "text": "24回の試験用。しないで"}, {"type": "subtitle", "time": 1292.71, "timestamp": "00:21:32", "text": "心配。ええ、そういうことです。そして、"}, {"type": "subtitle", "time": 1296.07, "timestamp": "00:21:36", "text": "から何を得るかに関して"}, {"type": "subtitle", "time": 1298.59, "timestamp": "00:21:38", "text": "メンバー、"}, {"type": "subtitle", "time": 1306.87, "timestamp": "00:21:46", "text": "男の子。それで、メンバーシップを確認すると"}, {"type": "subtitle", "time": 1308.99, "timestamp": "00:21:48", "text": "あれ、私は"}, {"type": "subtitle", "time": 1311.51, "timestamp": "00:21:51", "text": "「はい」と答えると、参加ボタンが表示されます。"}, {"type": "subtitle", "time": 1314.029, "timestamp": "00:21:54", "text": "ああ、ついに私の"}, {"type": "subtitle", "time": 1316.87, "timestamp": "00:21:56", "text": "チャネル。まさに夢が叶ったようだ。"}, {"type": "subtitle", "time": 1319.43, "timestamp": "00:21:59", "text": "正直言って、そうだよ。そう、クリックすると"}]
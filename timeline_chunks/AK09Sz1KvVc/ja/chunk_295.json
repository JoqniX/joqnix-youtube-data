[{"type": "subtitle", "time": 17706.708, "timestamp": "04:55:06", "text": "方法。こんにちは。彼は窒息しそうだ"}, {"type": "subtitle", "time": 17708.948, "timestamp": "04:55:08", "text": "あるいは、そんな感じ。わからない。とにかく、私は"}, {"type": "subtitle", "time": 17709.868, "timestamp": "04:55:09", "text": "戻る"}, {"type": "subtitle", "time": 17711.948, "timestamp": "04:55:11", "text": "ここ。これらは"}, {"type": "subtitle", "time": 17714.11, "timestamp": "04:55:14", "text": "マングローブが剥ぎ取られた"}, {"type": "subtitle", "time": 17718.47, "timestamp": "04:55:18", "text": "luc チェリーログはこんな感じです。わかった。それで、"}, {"type": "subtitle", "time": 17719.708, "timestamp": "04:55:19", "text": "彼らは使用する"}, {"type": "subtitle", "time": 17728.07, "timestamp": "04:55:28", "text": "ええと、ログかな。チェリーの丸太はこんな感じになります"}, {"type": "subtitle", "time": 17732.23, "timestamp": "04:55:32", "text": "これは暗い。わかった。桜の階段は"}, {"type": "subtitle", "time": 17736.15, "timestamp": "04:55:36", "text": "赤。わかった。桜のフェンス。わかった。"}, {"type": "subtitle", "time": 17738.15, "timestamp": "04:55:38", "text": "では、そもそもなぜ私はここにいたのだろうか？わからない"}, {"type": "subtitle", "time": 17740.35, "timestamp": "04:55:40", "text": "これは誰の家ですか、しかし彼らはとても"}, {"type": "subtitle", "time": 17743.11, "timestamp": "04:55:43", "text": "いいね。いいね。いいね。誰が知りたいのか知りたい"}, {"type": "subtitle", "time": 17744.75, "timestamp": "04:55:44", "text": "それを構築しますが、"}, {"type": "subtitle", "time": 17746.75, "timestamp": "04:55:46", "text": "うん。チェリー"}, {"type": "subtitle", "time": 17751.43, "timestamp": "04:55:51", "text": "さあ行こう。いやだ。いやだ。いやだ。死にたくない。"}, {"type": "subtitle", "time": 17752.47, "timestamp": "04:55:52", "text": "私は死にたくない。私はしたくない"}, {"type": "subtitle", "time": 17753.67, "timestamp": "04:55:53", "text": "死ぬ。私は死にたくない。私はほしくない"}]
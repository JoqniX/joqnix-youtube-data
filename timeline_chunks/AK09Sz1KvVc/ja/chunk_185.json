[{"type": "subtitle", "time": 11101.71, "timestamp": "03:05:01", "text": "[音楽]"}, {"type": "subtitle", "time": 11104.51, "timestamp": "03:05:04", "text": "会員権を受け取るべきではないと言うべきではない"}, {"type": "subtitle", "time": 11106.02, "timestamp": "03:05:06", "text": "自由であるべきだ"}, {"type": "subtitle", "time": 11107.389, "timestamp": "03:05:07", "text": "[音楽]"}, {"type": "subtitle", "time": 11110.99, "timestamp": "03:05:10", "text": "受け取ると言う"}, {"type": "subtitle", "time": 11115.269, "timestamp": "03:05:15", "text": "uh.com コミュニティのギフト会員。"}, {"type": "subtitle", "time": 11117.0, "timestamp": "03:05:17", "text": "クリックして"}, {"type": "subtitle", "time": 11118.429, "timestamp": "03:05:18", "text": "[音楽]"}, {"type": "subtitle", "time": 11122.11, "timestamp": "03:05:22", "text": "受け取る"}, {"type": "subtitle", "time": 11127.07, "timestamp": "03:05:27", "text": "それ。受け取るために受け取るために"}, {"type": "subtitle", "time": 11129.67, "timestamp": "03:05:29", "text": "贈り物。よし、これで大丈夫だよね？"}, {"type": "subtitle", "time": 11131.15, "timestamp": "03:05:31", "text": "あなたは何を"}, {"type": "subtitle", "time": 11133.15, "timestamp": "03:05:33", "text": "考える？待って。"}, {"type": "subtitle", "time": 11145.55, "timestamp": "03:05:45", "text": "オンにして許可する"}, {"type": "subtitle", "time": 11148.79, "timestamp": "03:05:48", "text": "贈り物。私は声に出して言わなければならない"}, {"type": "subtitle", "time": 11151.11, "timestamp": "03:05:51", "text": "うまく書かなければならないのは、"}, {"type": "subtitle", "time": 11153.91, "timestamp": "03:05:53", "text": "否定の仕方がわからない人たち。"}, {"type": "subtitle", "time": 11154.99, "timestamp": "03:05:54", "text": "つまり"}]
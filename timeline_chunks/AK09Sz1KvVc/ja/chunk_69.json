[{"type": "subtitle", "time": 4145.149, "timestamp": "01:09:05", "text": "ドキュメント。はい、私は"}, {"type": "subtitle", "time": 4154.11, "timestamp": "01:09:14", "text": "えっと、ちょっと待ってください。そうですね、"}, {"type": "subtitle", "time": 4158.149, "timestamp": "01:09:18", "text": "YouTubeはこちら。 YouTubeを見たい"}, {"type": "subtitle", "time": 4159.87, "timestamp": "01:09:19", "text": "メンバー。"}, {"type": "subtitle", "time": 4163.63, "timestamp": "01:09:23", "text": "右。なぜ私はCを見ているのか"}, {"type": "subtitle", "time": 4169.149, "timestamp": "01:09:29", "text": "行く。"}, {"type": "subtitle", "time": 4171.47, "timestamp": "01:09:31", "text": "こんにちは、"}, {"type": "subtitle", "time": 4174.55, "timestamp": "01:09:34", "text": "YouTube。 YouTubeはいくつかの動作を引き起こします。"}, {"type": "subtitle", "time": 4181.63, "timestamp": "01:09:41", "text": "トリガー。ああ、彼らは更新していない"}, {"type": "subtitle", "time": 4185.47, "timestamp": "01:09:45", "text": "わかった。わかった。では"}, {"type": "subtitle", "time": 4189.55, "timestamp": "01:09:49", "text": "サミー？サミーは私が"}, {"type": "subtitle", "time": 4192.91, "timestamp": "01:09:52", "text": "それ。統合 YouTube"}, {"type": "subtitle", "time": 4196.149, "timestamp": "01:09:56", "text": "ライブ。わかった。会員登録をしましょう。二人で"}]
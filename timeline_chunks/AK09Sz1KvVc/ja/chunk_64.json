[{"type": "subtitle", "time": 3840.51, "timestamp": "01:04:00", "text": "コタとサミーの問題"}, {"type": "subtitle", "time": 3844.19, "timestamp": "01:04:04", "text": "しかし、人々がそれを使っているとは思えません"}, {"type": "subtitle", "time": 3846.87, "timestamp": "01:04:06", "text": "サミーはYouTubeでまだそれを使っています"}, {"type": "subtitle", "time": 3849.109, "timestamp": "01:04:09", "text": "サミー、私は"}, {"type": "subtitle", "time": 3852.309, "timestamp": "01:04:12", "text": "まだ受け取っていません。うん、"}, {"type": "subtitle", "time": 3854.91, "timestamp": "01:04:14", "text": "受け取った時もある"}, {"type": "subtitle", "time": 3858.71, "timestamp": "01:04:18", "text": "それには5日くらいかかる"}, {"type": "subtitle", "time": 3860.51, "timestamp": "01:04:20", "text": "それを修正するために"}, {"type": "subtitle", "time": 3873.43, "timestamp": "01:04:33", "text": "はい、少々お待ちください。すべて削除します"}]
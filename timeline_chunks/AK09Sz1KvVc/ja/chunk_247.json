[{"type": "subtitle", "time": 14822.07, "timestamp": "04:07:02", "text": "あれ？ああ、この緑色のものは何だろう？"}, {"type": "subtitle", "time": 14823.87, "timestamp": "04:07:03", "text": "それは"}, {"type": "subtitle", "time": 14828.429, "timestamp": "04:07:08", "text": "村？わあ、別のものを見つけた"}, {"type": "subtitle", "time": 14851.75, "timestamp": "04:07:31", "text": "男ならできる。青い本をなくしてしまいました。"}, {"type": "subtitle", "time": 14855.03, "timestamp": "04:07:35", "text": "アゼロスはそれを捨てて、私は死んだ"}, {"type": "subtitle", "time": 14860.07, "timestamp": "04:07:40", "text": "彼が私を殺した時。はい、私が選んだのは"}, {"type": "subtitle", "time": 14869.269, "timestamp": "04:07:49", "text": "ああ、あの本を取り戻せたらいいのに。"}, {"type": "subtitle", "time": 14872.15, "timestamp": "04:07:52", "text": "これは何ですか？駐車場、待って、"}, {"type": "subtitle", "time": 14874.67, "timestamp": "04:07:54", "text": "ボード駐車場？待って、"}, {"type": "subtitle", "time": 14879.389, "timestamp": "04:07:59", "text": "何？それはBです。それはドッキング場所です。"}]
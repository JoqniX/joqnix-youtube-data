[{"type": "subtitle", "time": 13623.87, "timestamp": "03:47:03", "text": "それ？サドル。ああ、鞍だ。"}, {"type": "subtitle", "time": 13625.55, "timestamp": "03:47:05", "text": "サドル。"}, {"type": "subtitle", "time": 13635.429, "timestamp": "03:47:15", "text": "今日。うん。まず、"}, {"type": "subtitle", "time": 13638.55, "timestamp": "03:47:18", "text": "桜の場所だから、そこに家を建てたい"}, {"type": "subtitle", "time": 13641.79, "timestamp": "03:47:21", "text": "なぜなら私は"}, {"type": "subtitle", "time": 13644.55, "timestamp": "03:47:24", "text": "さくら。そしてハロウィーンの期間中、私は"}, {"type": "subtitle", "time": 13647.269, "timestamp": "03:47:27", "text": "この場所で何かを作る"}, {"type": "subtitle", "time": 13649.95, "timestamp": "03:47:29", "text": "ハロウィーンに合うもの"}, {"type": "subtitle", "time": 13664.87, "timestamp": "03:47:44", "text": "もの。待って、つまり、あなたは次のように追加していないのですね"}, {"type": "subtitle", "time": 13672.229, "timestamp": "03:47:52", "text": "まだ？待てよ、ブドウを食べるのも良いことだ。"}, {"type": "subtitle", "time": 13673.87, "timestamp": "03:47:53", "text": "良いですか？私はしません"}, {"type": "subtitle", "time": 13678.349, "timestamp": "03:47:58", "text": "知る。おお。あまり時間がかからないといいのですが"}]
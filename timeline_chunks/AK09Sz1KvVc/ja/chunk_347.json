[{"type": "subtitle", "time": 20821.708, "timestamp": "05:47:01", "text": "何が"}, {"type": "subtitle", "time": 20824.91, "timestamp": "05:47:04", "text": "これ？私は何をしたの？私は何かしただろうか？"}, {"type": "subtitle", "time": 20827.868, "timestamp": "05:47:07", "text": "待って、これは何？のように"}, {"type": "subtitle", "time": 20830.708, "timestamp": "05:47:10", "text": "はぁ？何？このマウススムージングとは何ですか？"}, {"type": "subtitle", "time": 20832.35, "timestamp": "05:47:12", "text": "あれ？待って、"}, {"type": "subtitle", "time": 20840.43, "timestamp": "05:47:20", "text": "はぁ？ベイビー、"}, {"type": "subtitle", "time": 20842.51, "timestamp": "05:47:22", "text": "これ？これは何ですか？"}, {"type": "subtitle", "time": 20845.23, "timestamp": "05:47:25", "text": "ほとんど。何が"}, {"type": "subtitle", "time": 20847.91, "timestamp": "05:47:27", "text": "これ？待って。ああ、神様。それを押す"}, {"type": "subtitle", "time": 20849.708, "timestamp": "05:47:29", "text": "あれ。何"}, {"type": "subtitle", "time": 20858.75, "timestamp": "05:47:38", "text": "これ？まるで映画みたいだ"}, {"type": "subtitle", "time": 20861.11, "timestamp": "05:47:41", "text": "何か。なぜ有効化したのですか？待って、"}, {"type": "subtitle", "time": 20862.788, "timestamp": "05:47:42", "text": "私は何を有効化したのですか？待って、私は何をしたの？"}, {"type": "subtitle", "time": 20866.67, "timestamp": "05:47:46", "text": "活性化？おい、なんでだよ？え、何？待って、"}, {"type": "subtitle", "time": 20871.39, "timestamp": "05:47:51", "text": "何？え、何？私は何を有効化したのですか？"}, {"type": "subtitle", "time": 20874.43, "timestamp": "05:47:54", "text": "待って、待って、待って、"}, {"type": "subtitle", "time": 20877.27, "timestamp": "05:47:57", "text": "待って。キーボードのキーを押してください。私"}]
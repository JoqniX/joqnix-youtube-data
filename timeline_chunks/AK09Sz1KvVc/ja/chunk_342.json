[{"type": "subtitle", "time": 20537.35, "timestamp": "05:42:17", "text": "[音楽]"}, {"type": "subtitle", "time": 20542.59, "timestamp": "05:42:22", "text": "あ、待って。 Coughの曲を覚えています。"}, {"type": "subtitle", "time": 20547.15, "timestamp": "05:42:27", "text": "ミーム。咳をして、誰かが"}, {"type": "subtitle", "time": 20551.67, "timestamp": "05:42:31", "text": "自分。大丈夫。かっこいい曲ですね。私は恋しい"}, {"type": "subtitle", "time": 20553.91, "timestamp": "05:42:33", "text": "あなたたち二人が恋しいわ、わかる？そうするべきです。"}, {"type": "subtitle", "time": 20556.23, "timestamp": "05:42:36", "text": "実際に聴いてみて、その理由を説明してください。けれど"}, {"type": "subtitle", "time": 20558.47, "timestamp": "05:42:38", "text": "君たちには聞こえないよ、なぜなら"}, {"type": "subtitle", "time": 20559.548, "timestamp": "05:42:39", "text": "また"}, {"type": "subtitle", "time": 20562.51, "timestamp": "05:42:42", "text": "DMCA著作権は依然として"}, {"type": "subtitle", "time": 20565.19, "timestamp": "05:42:45", "text": "痛みはないが、必ず"}, {"type": "subtitle", "time": 20568.628, "timestamp": "05:42:48", "text": "そっちから聞こえてくると思う"}, {"type": "subtitle", "time": 20571.43, "timestamp": "05:42:51", "text": "ハイファイケーブルを正しく使用していないので、"}, {"type": "subtitle", "time": 20574.19, "timestamp": "05:42:54", "text": "直接使うのはいいよ"}, {"type": "subtitle", "time": 20575.708, "timestamp": "05:42:55", "text": "良い"}]
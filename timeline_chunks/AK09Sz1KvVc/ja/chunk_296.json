[{"type": "subtitle", "time": 17760.91, "timestamp": "04:56:00", "text": "死ぬ。聖なる。私は大きな"}, {"type": "subtitle", "time": 17764.39, "timestamp": "04:56:04", "text": "ジャンプ。ああ、神様。"}, {"type": "subtitle", "time": 17766.51, "timestamp": "04:56:06", "text": "おお"}, {"type": "subtitle", "time": 17770.51, "timestamp": "04:56:10", "text": "ああ、どうやって生き延びているのか分からない"}, {"type": "subtitle", "time": 17773.47, "timestamp": "04:56:13", "text": "これ。持っている"}, {"type": "subtitle", "time": 17776.39, "timestamp": "04:56:16", "text": "前回の投稿はあちらです。私はほしくない"}, {"type": "subtitle", "time": 17777.47, "timestamp": "04:56:17", "text": "それ"}, {"type": "subtitle", "time": 17784.75, "timestamp": "04:56:24", "text": "去った。"}, {"type": "subtitle", "time": 17791.59, "timestamp": "04:56:31", "text": "ついに。私はただ待ちたいだけです"}, {"type": "subtitle", "time": 17792.68, "timestamp": "04:56:32", "text": "モブに"}, {"type": "subtitle", "time": 17794.99, "timestamp": "04:56:34", "text": "[音楽]"}, {"type": "subtitle", "time": 17797.628, "timestamp": "04:56:37", "text": "リスポーン。私はただ桜の葉が欲しいだけなんです。"}, {"type": "subtitle", "time": 17800.788, "timestamp": "04:56:40", "text": "わかった。桜の苗木とか。それは"}, {"type": "subtitle", "time": 17802.948, "timestamp": "04:56:42", "text": "それ。私が求めるのはそれだけです。私は家を作る"}, {"type": "subtitle", "time": 17810.708, "timestamp": "04:56:50", "text": "近く。つまりこのエリアは"}, {"type": "subtitle", "time": 17813.91, "timestamp": "04:56:53", "text": "このすごくクールな基地の近くにいるでしょう。"}, {"type": "subtitle", "time": 17815.31, "timestamp": "04:56:55", "text": "いいえ"}]
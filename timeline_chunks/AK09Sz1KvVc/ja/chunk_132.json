[{"type": "subtitle", "time": 7921.99, "timestamp": "02:12:01", "text": "わかった。だから、ここで放送したいんです。おやおや、"}, {"type": "subtitle", "time": 7924.069, "timestamp": "02:12:04", "text": "スーパーチャットですよね？そしてスーパーステッカー"}, {"type": "subtitle", "time": 7926.149, "timestamp": "02:12:06", "text": "これもカウントされますよね？それらも問題ありません。"}, {"type": "subtitle", "time": 7930.149, "timestamp": "02:12:10", "text": "ああ、しまった、それを忘れてた。それで"}, {"type": "subtitle", "time": 7933.43, "timestamp": "02:12:13", "text": "えーと、スーパーチャットの通貨コード。いいえ"}, {"type": "subtitle", "time": 7934.589, "timestamp": "02:12:14", "text": "額、"}, {"type": "chat", "time": 7935.385, "timestamp": "02:12:15", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "UCdZBnUb7m8Pd_wUTDNqUu3Q/f3TlZ-r4KpS3_9EP-duW6Qo"}, {"type": "subtitle", "time": 7939.149, "timestamp": "02:12:19", "text": "右？スーパーチャットの金額"}, {"type": "subtitle", "time": 7943.629, "timestamp": "02:12:23", "text": "額。スーパーチャート"}, {"type": "subtitle", "time": 7945.79, "timestamp": "02:12:25", "text": "額。"}, {"type": "subtitle", "time": 7952.99, "timestamp": "02:12:32", "text": "量 al"}, {"type": "subtitle", "time": 7957.79, "timestamp": "02:12:37", "text": "金額とスーパー"}, {"type": "subtitle", "time": 7960.109, "timestamp": "02:12:40", "text": "ステッカー。スーパーステッカーを追加します"}, {"type": "subtitle", "time": 7962.51, "timestamp": "02:12:42", "text": "実は。素晴らしい"}, {"type": "subtitle", "time": 7966.35, "timestamp": "02:12:46", "text": "ステッカーの枚数。"}, {"type": "subtitle", "time": 7969.669, "timestamp": "02:12:49", "text": "右。これには段階があります。ティア"}, {"type": "subtitle", "time": 7972.189, "timestamp": "02:12:52", "text": "歩道の段差"}, {"type": "subtitle", "time": 7974.83, "timestamp": "02:12:54", "text": "階層がある"}]
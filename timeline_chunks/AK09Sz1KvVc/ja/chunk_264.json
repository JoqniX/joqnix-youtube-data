[{"type": "subtitle", "time": 15851.07, "timestamp": "04:24:11", "text": "開ける。そこにいる"}, {"type": "subtitle", "time": 15855.04, "timestamp": "04:24:15", "text": "は。待って、ちゃんと確認したっけ？"}, {"type": "subtitle", "time": 15857.71, "timestamp": "04:24:17", "text": "[音楽]"}, {"type": "subtitle", "time": 15887.91, "timestamp": "04:24:47", "text": "いいね。何？何てことだ。それは実際には"}, {"type": "subtitle", "time": 15891.469, "timestamp": "04:24:51", "text": "ドーム。何てことだ。"}, {"type": "subtitle", "time": 15894.389, "timestamp": "04:24:54", "text": "何？とんでもない。まさか"}, {"type": "subtitle", "time": 15897.07, "timestamp": "04:24:57", "text": "実際に構築する"}]
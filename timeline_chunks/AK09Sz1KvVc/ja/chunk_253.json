[{"type": "subtitle", "time": 15184.71, "timestamp": "04:13:04", "text": "中央はちょうどその上にあるはずです"}, {"type": "subtitle", "time": 15186.03, "timestamp": "04:13:06", "text": "ここ。"}, {"type": "subtitle", "time": 15188.91, "timestamp": "04:13:08", "text": "それで"}, {"type": "subtitle", "time": 15191.79, "timestamp": "04:13:11", "text": "ポイント。うん。"}, {"type": "subtitle", "time": 15211.389, "timestamp": "04:13:31", "text": "かわいい。さあ行こう"}, {"type": "subtitle", "time": 15218.55, "timestamp": "04:13:38", "text": "生物群系。テレポート。私はテレポートできません。うん、"}, {"type": "subtitle", "time": 15219.6, "timestamp": "04:13:39", "text": "もちろんできません"}, {"type": "subtitle", "time": 15221.229, "timestamp": "04:13:41", "text": "[音楽]"}, {"type": "subtitle", "time": 15222.83, "timestamp": "04:13:42", "text": "テレポート。"}, {"type": "subtitle", "time": 15225.429, "timestamp": "04:13:45", "text": "えっと、待って。ドッキング場所はどこですか？"}, {"type": "subtitle", "time": 15227.56, "timestamp": "04:13:47", "text": "また？ドッキングステーションはどこですか？"}, {"type": "subtitle", "time": 15230.269, "timestamp": "04:13:50", "text": "[音楽]"}, {"type": "subtitle", "time": 15233.309, "timestamp": "04:13:53", "text": "場所？なんてこった。私はどこから来たのか"}, {"type": "subtitle", "time": 15235.87, "timestamp": "04:13:55", "text": "から？ドッキングステーションはどこですか？"}, {"type": "subtitle", "time": 15239.149, "timestamp": "04:13:59", "text": "場所？私の"}]
[{"type": "subtitle", "time": 18961.75, "timestamp": "05:16:01", "text": "あれ。おお。だから春は"}, {"type": "subtitle", "time": 18964.55, "timestamp": "05:16:04", "text": "28日後にまさにその出来事が起こります。その"}, {"type": "subtitle", "time": 18973.788, "timestamp": "05:16:13", "text": "信じる。"}, {"type": "subtitle", "time": 18975.708, "timestamp": "05:16:15", "text": "待って、"}, {"type": "subtitle", "time": 18978.708, "timestamp": "05:16:18", "text": "カレンダーによると、残り19日です。だから私は"}, {"type": "subtitle", "time": 18981.07, "timestamp": "05:16:21", "text": "たくさんの作物を育てました"}, {"type": "subtitle", "time": 18984.23, "timestamp": "05:16:24", "text": "さくらさくら、わからないチェリー"}, {"type": "subtitle", "time": 18986.47, "timestamp": "05:16:26", "text": "花びらを咲かせて、あなたを好きになれるように"}, {"type": "subtitle", "time": 18988.948, "timestamp": "05:16:28", "text": "それを農場に変える方法を知っている。農場ではない"}, {"type": "subtitle", "time": 18997.59, "timestamp": "05:16:37", "text": "何か。そしてこれらはすべて4つくらい"}, {"type": "subtitle", "time": 19003.67, "timestamp": "05:16:43", "text": "4 4 個、4 4 スタック。"}, {"type": "subtitle", "time": 19006.51, "timestamp": "05:16:46", "text": "どれだけ厚みがあるか分かりますか？ 1 2 3 4"}, {"type": "subtitle", "time": 19013.99, "timestamp": "05:16:53", "text": "おお。わかった。だから、もしかしたら見つけられるかもしれない"}, {"type": "subtitle", "time": 19016.628, "timestamp": "05:16:56", "text": "もう一つ、でも私は思う"}]
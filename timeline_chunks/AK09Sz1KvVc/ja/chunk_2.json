[{"type": "subtitle", "time": 129.869, "timestamp": "00:02:09", "text": "ああ、覚えてるよ"}, {"type": "subtitle", "time": 133.309, "timestamp": "00:02:13", "text": "船 船 ずっと"}, {"type": "subtitle", "time": 148.57, "timestamp": "00:02:28", "text": "アストラルという名のメンバー"}, {"type": "subtitle", "time": 158.19, "timestamp": "00:02:38", "text": "コニオン。命名が"}, {"type": "subtitle", "time": 162.309, "timestamp": "00:02:42", "text": "正しい。でも、そうですね、そう願っています"}, {"type": "subtitle", "time": 166.589, "timestamp": "00:02:46", "text": "上がっています。リフレッシュとか色々試してみてください。"}, {"type": "subtitle", "time": 171.19, "timestamp": "00:02:51", "text": "参加ボタンがあるかどうか確認してください。"}, {"type": "subtitle", "time": 174.71, "timestamp": "00:02:54", "text": "か否か。わからない。私がそれを起動しました。"}, {"type": "subtitle", "time": 176.67000000000002, "timestamp": "00:02:56", "text": "私は"}, {"type": "subtitle", "time": 178.04, "timestamp": "00:02:58", "text": "怖がった。"}, {"type": "subtitle", "time": 179.309, "timestamp": "00:02:59", "text": "[音楽]"}]
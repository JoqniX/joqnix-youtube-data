[{"type": "subtitle", "time": 18182.83, "timestamp": "05:03:02", "text": "ほら、私にはそこからも理解できないんだ。"}, {"type": "subtitle", "time": 18199.15, "timestamp": "05:03:19", "text": "何か。それはたくさん"}, {"type": "subtitle", "time": 18201.07, "timestamp": "05:03:21", "text": "木材。おお"}, {"type": "subtitle", "time": 18213.27, "timestamp": "05:03:33", "text": "うん。えっと、これを全部終えたら"}, {"type": "subtitle", "time": 18215.43, "timestamp": "05:03:35", "text": "あれ、そう、そしてその量"}, {"type": "subtitle", "time": 18218.59, "timestamp": "05:03:38", "text": "サンプルを入手したら、返信します。"}, {"type": "subtitle", "time": 18222.628, "timestamp": "05:03:42", "text": "ここにまた4つ残しておきます。それから"}, {"type": "subtitle", "time": 18224.43, "timestamp": "05:03:44", "text": "取る"}, {"type": "subtitle", "time": 18228.47, "timestamp": "05:03:48", "text": "半分が次の半分を取る。つまり私は"}, {"type": "subtitle", "time": 18231.868, "timestamp": "05:03:51", "text": "まるで一滴の苗木が落ちるように期待している"}, {"type": "subtitle", "time": 18235.59, "timestamp": "05:03:55", "text": "5、6、7、8くらいかな"}, {"type": "subtitle", "time": 18238.03, "timestamp": "05:03:58", "text": "葉は何枚ありますか"}]
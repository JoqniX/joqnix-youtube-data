[{"type": "subtitle", "time": 15737.63, "timestamp": "04:22:17", "text": "おお、"}, {"type": "subtitle", "time": 15740.189, "timestamp": "04:22:20", "text": "カレンダー。待って、"}, {"type": "subtitle", "time": 15748.11, "timestamp": "04:22:28", "text": "チェック。"}, {"type": "subtitle", "time": 15754.67, "timestamp": "04:22:34", "text": "何？"}, {"type": "subtitle", "time": 15757.389, "timestamp": "04:22:37", "text": "くそ。あなたの車"}, {"type": "subtitle", "time": 15765.79, "timestamp": "04:22:45", "text": "素晴らしい？待って、これは何だ？"}, {"type": "subtitle", "time": 15769.229, "timestamp": "04:22:49", "text": "小麦？待って、それは小麦です、"}, {"type": "subtitle", "time": 15772.03, "timestamp": "04:22:52", "text": "右？それは雑草のようだ。"}, {"type": "subtitle", "time": 15773.63, "timestamp": "04:22:53", "text": "わかった。"}, {"type": "subtitle", "time": 15776.469, "timestamp": "04:22:56", "text": "おお。ああ、銀色のカエデの木々が"}]
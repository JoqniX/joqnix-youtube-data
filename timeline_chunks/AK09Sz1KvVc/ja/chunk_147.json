[{"type": "subtitle", "time": 8824.469, "timestamp": "02:27:04", "text": "そこには。うん、これは良さそうだ。"}, {"type": "subtitle", "time": 8826.389, "timestamp": "02:27:06", "text": "よし、基本的なものは揃った。私たちは"}, {"type": "subtitle", "time": 8829.63, "timestamp": "02:27:09", "text": "このようにデータを取得する。"}, {"type": "subtitle", "time": 8832.389, "timestamp": "02:27:12", "text": "さて、ジョッキーにこう尋ねるでしょう。"}, {"type": "subtitle", "time": 8845.469, "timestamp": "02:27:25", "text": "これ。私たちはテストします"}, {"type": "subtitle", "time": 8857.07, "timestamp": "02:27:37", "text": "あ、待って。私はもう一度それをやります。"}, {"type": "subtitle", "time": 8859.75, "timestamp": "02:27:39", "text": "ええと、それがメンバーです。そしてあなたは"}, {"type": "subtitle", "time": 8862.95, "timestamp": "02:27:42", "text": "データチャットID。それは関係ない。病気"}, {"type": "subtitle", "time": 8865.51, "timestamp": "02:27:45", "text": "それを削除してください。メッセージは無関係です。その"}, {"type": "subtitle", "time": 8866.91, "timestamp": "02:27:46", "text": "大丈夫、なぜなら"}, {"type": "subtitle", "time": 8869.91, "timestamp": "02:27:49", "text": "待って、もしあなたが会員になるなら、"}, {"type": "subtitle", "time": 8872.23, "timestamp": "02:27:52", "text": "できると思うけど、"}, {"type": "subtitle", "time": 8874.309, "timestamp": "02:27:54", "text": "メッセージですよね？うん。チャットメッセージは"}, {"type": "subtitle", "time": 8877.67, "timestamp": "02:27:57", "text": "会員資格とは無関係です。わかった。私たちは"}]
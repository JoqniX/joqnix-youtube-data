[{"type": "subtitle", "time": 8101.43, "timestamp": "02:15:01", "text": "わかった。スーパーを作らなきゃいけない、待って、私は"}, {"type": "subtitle", "time": 8103.589, "timestamp": "02:15:03", "text": "スーパーチャットがないの？私はスーパーを持っています"}, {"type": "subtitle", "time": 8106.27, "timestamp": "02:15:06", "text": "チャット。スーパーチャットが壊れています。"}, {"type": "subtitle", "time": 8109.47, "timestamp": "02:15:09", "text": "ああ、スーパーチャットが壊れてる。修正する必要がある"}, {"type": "subtitle", "time": 8112.47, "timestamp": "02:15:12", "text": "それ。スーパーステッカーも壊れています。私"}, {"type": "subtitle", "time": 8119.91, "timestamp": "02:15:19", "text": "あまりにも。これらはサミーで行われた。この男"}, {"type": "subtitle", "time": 8123.189, "timestamp": "02:15:23", "text": "こちらでショーをご覧ください。ええ、それは"}, {"type": "subtitle", "time": 8125.43, "timestamp": "02:15:25", "text": "Discordのバックエンド。イベントの中にあります"}, {"type": "subtitle", "time": 8128.229, "timestamp": "02:15:28", "text": "こちらです。ええ、こちらです。私には必要"}, {"type": "subtitle", "time": 8130.99, "timestamp": "02:15:30", "text": "これを更新するには"}, {"type": "subtitle", "time": 8150.55, "timestamp": "02:15:50", "text": "男。わかった。スーパーステッカーの量と"}]
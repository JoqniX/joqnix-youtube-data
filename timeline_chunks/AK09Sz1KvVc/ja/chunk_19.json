[{"type": "subtitle", "time": 1140.31, "timestamp": "00:19:00", "text": "今は物を提供できると約束します"}, {"type": "subtitle", "time": 1142.31, "timestamp": "00:19:02", "text": "この時点ではヨアトンのせいで"}, {"type": "subtitle", "time": 1145.909, "timestamp": "00:19:05", "text": "イベントは開催中、理由はなんであれ"}, {"type": "subtitle", "time": 1149.83, "timestamp": "00:19:09", "text": "私たちは今あなたからサポートを得ています。"}, {"type": "subtitle", "time": 1152.63, "timestamp": "00:19:12", "text": "YouTubeメンバーシップには"}, {"type": "subtitle", "time": 1155.99, "timestamp": "00:19:15", "text": "YouTube パートナー関連のものもあるので、"}, {"type": "subtitle", "time": 1160.549, "timestamp": "00:19:20", "text": "えっと、だから私は手に入れることができる、私は"}, {"type": "subtitle", "time": 1164.07, "timestamp": "00:19:24", "text": "私はできる"}, {"type": "subtitle", "time": 1167.51, "timestamp": "00:19:27", "text": "YouTubeのサポートを受けるには、"}, {"type": "subtitle", "time": 1169.75, "timestamp": "00:19:29", "text": "会員からの資金と"}, {"type": "subtitle", "time": 1173.029, "timestamp": "00:19:33", "text": "ジョアトン大会に向けてのすべて。私はできる"}, {"type": "subtitle", "time": 1176.07, "timestamp": "00:19:36", "text": "付け加えると、そういうことだと言える"}, {"type": "subtitle", "time": 1179.19, "timestamp": "00:19:39", "text": "モデルとリギングに向かって、"}, {"type": "subtitle", "time": 1182.63, "timestamp": "00:19:42", "text": "すべて。そう、すべてのメンバーシップ、"}, {"type": "subtitle", "time": 1185.35, "timestamp": "00:19:45", "text": "すべてのスーパーチャット、すべてが"}, {"type": "subtitle", "time": 1187.549, "timestamp": "00:19:47", "text": "に向かって、そしてそれに対してカウントされます"}, {"type": "subtitle", "time": 1193.15, "timestamp": "00:19:53", "text": "新型モデル、新型モデル関連。うん。"}, {"type": "subtitle", "time": 1196.35, "timestamp": "00:19:56", "text": "それで、それで"}, {"type": "subtitle", "time": 1199.71, "timestamp": "00:19:59", "text": "そしてまたまた"}]
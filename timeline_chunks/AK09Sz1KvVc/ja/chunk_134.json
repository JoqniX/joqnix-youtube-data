[{"type": "subtitle", "time": 8053.589, "timestamp": "02:14:13", "text": "どのように確認したのですか？私のログは実際には"}, {"type": "subtitle", "time": 8056.149, "timestamp": "02:14:16", "text": "みんなが誰になるのかを知る必要がある"}, {"type": "subtitle", "time": 8057.39, "timestamp": "02:14:17", "text": "メンバー、"}, {"type": "subtitle", "time": 8062.109, "timestamp": "02:14:22", "text": "右？ああ、確かに効果がありますよ。見て見て見て"}, {"type": "subtitle", "time": 8065.189, "timestamp": "02:14:25", "text": "あそこを見て。ログがあります。はい、それは"}, {"type": "subtitle", "time": 8067.669, "timestamp": "02:14:27", "text": "働く。何てことだ。私はこのようにしました"}, {"type": "subtitle", "time": 8070.55, "timestamp": "02:14:30", "text": "昨年や昨年のように何年も"}, {"type": "subtitle", "time": 8073.109, "timestamp": "02:14:33", "text": "年ですよね？私がこれをやったんです。予想していなかった"}, {"type": "subtitle", "time": 8076.189, "timestamp": "02:14:36", "text": "これは実際にうまくいった。何てことだ。"}, {"type": "subtitle", "time": 8078.43, "timestamp": "02:14:38", "text": "見て、ロク"}, {"type": "subtitle", "time": 8083.069, "timestamp": "02:14:43", "text": "それから私は私たちの牛のロクが大好きです"}, {"type": "subtitle", "time": 8087.31, "timestamp": "02:14:47", "text": "昨日のことだ。うん。えっと、クロノスオレンジ"}, {"type": "subtitle", "time": 8091.75, "timestamp": "02:14:51", "text": "ほら、うまくいったよ。わーい。実際にログを記録しています"}, {"type": "subtitle", "time": 8095.27, "timestamp": "02:14:55", "text": "それ。何てことだ。ニースの次は。あなたはただああ"}, {"type": "subtitle", "time": 8098.43, "timestamp": "02:14:58", "text": "うん、これだけ見せればいいよ。"}]
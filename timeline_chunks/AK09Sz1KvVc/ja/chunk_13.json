[{"type": "subtitle", "time": 782.35, "timestamp": "00:13:02", "text": "これ。はい、手動で送信することはできません。"}, {"type": "subtitle", "time": 784.949, "timestamp": "00:13:04", "text": "残念ながら、そこにはありません。では、待ってください。それは"}, {"type": "subtitle", "time": 787.91, "timestamp": "00:13:07", "text": "それはブランドアカウントですか、それとも"}, {"type": "subtitle", "time": 790.629, "timestamp": "00:13:10", "text": "個人アカウントですか？"}, {"type": "subtitle", "time": 792.949, "timestamp": "00:13:12", "text": "ブランドアカウントですか、それとも個人アカウントですか？"}, {"type": "subtitle", "time": 795.87, "timestamp": "00:13:15", "text": "アカウント？ブランド品でないことを願います"}, {"type": "chat", "time": 796.114, "timestamp": "00:13:16", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "mine own"}, {"type": "subtitle", "time": 798.79, "timestamp": "00:13:18", "text": "アカウント。ブランドアカウントの場合は、"}, {"type": "subtitle", "time": 800.75, "timestamp": "00:13:20", "text": "見ないだろう"}, {"type": "subtitle", "time": 803.75, "timestamp": "00:13:23", "text": "それ。個人アカウントの場合、私は"}, {"type": "subtitle", "time": 806.15, "timestamp": "00:13:26", "text": "の上？わかった。個人アカウント、それから"}, {"type": "subtitle", "time": 811.829, "timestamp": "00:13:31", "text": "それ。うん。うん。うん。うん。見て、見て、"}, {"type": "subtitle", "time": 814.23, "timestamp": "00:13:34", "text": "見て。選択肢があります。"}, {"type": "chat", "time": 814.65, "timestamp": "00:13:34", "author": "@Roku-rin", "avatar": "https://yt4.ggpht.com/8LlS_C2IirDMfA5r2V0q5G1kudp8dmG6RQvz_jCAUT3H-esyEgTNPDwrfCXiyX7Undc9UmHNgw=s64-c-k-c0x00ffffff-no-rj", "message": "click on that notification"}, {"type": "subtitle", "time": 816.55, "timestamp": "00:13:36", "text": "現れるだろう。"}, {"type": "subtitle", "time": 819.19, "timestamp": "00:13:39", "text": "だから、もしあなたがそうなら、もしそれがRokuなら"}, {"type": "subtitle", "time": 821.11, "timestamp": "00:13:41", "text": "贈り物をありがとう"}, {"type": "subtitle", "time": 823.67, "timestamp": "00:13:43", "text": "Rokuのメンバーシップ。それではクリックしてください"}, {"type": "subtitle", "time": 825.59, "timestamp": "00:13:45", "text": "通知には、"}, {"type": "subtitle", "time": 827.59, "timestamp": "00:13:47", "text": "ジョーク会員の幸運な受取人"}, {"type": "subtitle", "time": 831.03, "timestamp": "00:13:51", "text": "書籍にアクセスできる。許可をクリック"}, {"type": "subtitle", "time": 833.509, "timestamp": "00:13:53", "text": "贈り物。やり方はこうです。クリックする"}, {"type": "chat", "time": 833.638, "timestamp": "00:13:53", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "it just says block or report"}, {"type": "subtitle", "time": 835.47, "timestamp": "00:13:55", "text": "許可する"}, {"type": "subtitle", "time": 839.189, "timestamp": "00:13:59", "text": "プレゼントとして贈れば、きっと手に入ると思いますよ。もし私が"}]
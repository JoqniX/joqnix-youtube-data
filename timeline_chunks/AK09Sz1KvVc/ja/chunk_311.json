[{"type": "subtitle", "time": 18660.47, "timestamp": "05:11:00", "text": "えーと、使いたくないんです"}, {"type": "subtitle", "time": 18668.11, "timestamp": "05:11:08", "text": "残念ながら使用しなければならない"}, {"type": "subtitle", "time": 18670.99, "timestamp": "05:11:10", "text": "それ。私を見ないで"}, {"type": "subtitle", "time": 18674.47, "timestamp": "05:11:14", "text": "お願いします。スパイダー・ジョン。"}, {"type": "subtitle", "time": 18686.91, "timestamp": "05:11:26", "text": "動き。クモがうめき声をあげる"}, {"type": "subtitle", "time": 18690.11, "timestamp": "05:11:30", "text": "シューッという音。おお"}, {"type": "subtitle", "time": 18700.43, "timestamp": "05:11:40", "text": "自分。しないでください"}, {"type": "subtitle", "time": 18704.628, "timestamp": "05:11:44", "text": "動く。動かないでください。"}, {"type": "subtitle", "time": 18715.99, "timestamp": "05:11:55", "text": "あなた。団子。彼らは敵対的ではない。ああ、"}, {"type": "subtitle", "time": 18717.39, "timestamp": "05:11:57", "text": "神。"}]
[{"type": "subtitle", "time": 16868.868, "timestamp": "04:41:08", "text": "ああ、私はそれが永遠に続くのを待ちます"}, {"type": "subtitle", "time": 16877.708, "timestamp": "04:41:17", "text": "手に入れた"}, {"type": "subtitle", "time": 16885.27, "timestamp": "04:41:25", "text": "えっと、でも平手打ちはやめてください。"}, {"type": "subtitle", "time": 16888.55, "timestamp": "04:41:28", "text": "いや、いや。実際、私は捨てます"}, {"type": "subtitle", "time": 16900.868, "timestamp": "04:41:40", "text": "おそらく。すごくかっこいい。ああ、すごくクールだね。"}, {"type": "subtitle", "time": 16902.75, "timestamp": "04:41:42", "text": "のように、"}, {"type": "subtitle", "time": 16911.27, "timestamp": "04:41:51", "text": "神。ああ、終わりがあるよ。しないでください"}, {"type": "subtitle", "time": 16912.43, "timestamp": "04:41:52", "text": "見守る"}]
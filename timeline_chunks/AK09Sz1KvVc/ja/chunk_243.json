[{"type": "subtitle", "time": 14584.63, "timestamp": "04:03:04", "text": "いいえ。これは何ですか？他にも場所はある。"}, {"type": "subtitle", "time": 14591.07, "timestamp": "04:03:11", "text": "村？"}, {"type": "subtitle", "time": 14604.95, "timestamp": "04:03:24", "text": "いいね。こんな家は他にない。"}, {"type": "subtitle", "time": 14607.11, "timestamp": "04:03:27", "text": "これらの人々のコミュニティはどこにあるのか"}, {"type": "subtitle", "time": 14624.03, "timestamp": "04:03:44", "text": "ああ、もしかしたら誰かの建物かもしれない"}, {"type": "subtitle", "time": 14627.67, "timestamp": "04:03:47", "text": "どこかで。ああ、ここは村だ。おお、"}, {"type": "subtitle", "time": 14630.79, "timestamp": "04:03:50", "text": "ベッドがあります。ああ、私は"}, {"type": "subtitle", "time": 14637.79, "timestamp": "04:03:57", "text": "侵略している。さよなら。さよなら。による"}]
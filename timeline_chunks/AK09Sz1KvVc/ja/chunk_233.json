[{"type": "subtitle", "time": 13992.269, "timestamp": "03:53:12", "text": "自分？"}, {"type": "subtitle", "time": 13995.469, "timestamp": "03:53:15", "text": "それで、アヒルを殺すべきでしょうか？"}, {"type": "subtitle", "time": 14000.03, "timestamp": "03:53:20", "text": "いいえ。アヒルは良い"}, {"type": "subtitle", "time": 14003.63, "timestamp": "03:53:23", "text": "すごく面白い笑い声"}, {"type": "subtitle", "time": 14007.11, "timestamp": "03:53:27", "text": "彼らを殺した後、その後に音がした。"}, {"type": "subtitle", "time": 14011.11, "timestamp": "03:53:31", "text": "今、チョコレートをあげるよ。わーい。はい。"}, {"type": "subtitle", "time": 14013.79, "timestamp": "03:53:33", "text": "チョコレートをあげよう。チョコレート。"}, {"type": "subtitle", "time": 14016.07, "timestamp": "03:53:36", "text": "チョコレート。良い。私の"}, {"type": "subtitle", "time": 14017.55, "timestamp": "03:53:37", "text": "チョコレート？"}, {"type": "subtitle", "time": 14019.95, "timestamp": "03:53:39", "text": "はい。"}, {"type": "subtitle", "time": 14021.71, "timestamp": "03:53:41", "text": "A."}, {"type": "subtitle", "time": 14025.189, "timestamp": "03:53:45", "text": "こんにちは。こんにちは。"}]
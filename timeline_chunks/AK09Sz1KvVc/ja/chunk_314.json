[{"type": "subtitle", "time": 18840.47, "timestamp": "05:14:00", "text": "場所。冒険。"}, {"type": "subtitle", "time": 18843.91, "timestamp": "05:14:03", "text": "仕事のためにたくさん働かなければならないし、"}, {"type": "subtitle", "time": 18855.59, "timestamp": "05:14:15", "text": "それでは、正確に植え付けます"}, {"type": "subtitle", "time": 18857.83, "timestamp": "05:14:17", "text": "すでに働いたことがあるこちらの人"}, {"type": "subtitle", "time": 18861.27, "timestamp": "05:14:21", "text": "ここに植えられた。たくさんもらえて嬉しいです"}, {"type": "subtitle", "time": 18862.91, "timestamp": "05:14:22", "text": "聖なる"}, {"type": "subtitle", "time": 18866.948, "timestamp": "05:14:26", "text": "植物。ああ、もしかしたらマーケットを開催できるかもしれない"}, {"type": "subtitle", "time": 18870.47, "timestamp": "05:14:30", "text": "場所。なんてこった。私は何をしたの？あなたは"}, {"type": "subtitle", "time": 18873.39, "timestamp": "05:14:33", "text": "いい子だね。おい、お前はいい子だったよ。"}, {"type": "subtitle", "time": 18885.99, "timestamp": "05:14:45", "text": "しかし、苗木は28本。何てことだ。待って。 30"}, {"type": "subtitle", "time": 18889.67, "timestamp": "05:14:49", "text": "苗木。何てことだ。おお。はい、それは"}, {"type": "subtitle", "time": 18892.91, "timestamp": "05:14:52", "text": "私の義務。私は必要としている"}, {"type": "subtitle", "time": 18895.91, "timestamp": "05:14:55", "text": "1つ。"}, {"type": "subtitle", "time": 18899.39, "timestamp": "05:14:59", "text": "1本、2本、3本、4本の苗木"}]
[{"type": "subtitle", "time": 16202.87, "timestamp": "04:30:02", "text": "あなた？つまり、サクランボには2種類あるということです。"}, {"type": "subtitle", "time": 16204.95, "timestamp": "04:30:04", "text": "葉。"}, {"type": "subtitle", "time": 16208.469, "timestamp": "04:30:08", "text": "ピンク色のものと白色のものがある"}, {"type": "subtitle", "time": 16230.63, "timestamp": "04:30:30", "text": "わかった。紫色の砂。待って、色を塗ることができます"}, {"type": "subtitle", "time": 16237.83, "timestamp": "04:30:37", "text": "待って、待って、待って。これは何ですか？日本語"}, {"type": "subtitle", "time": 16240.03, "timestamp": "04:30:40", "text": "蘭。待って、"}, {"type": "subtitle", "time": 16250.03, "timestamp": "04:30:50", "text": "ポピー。ホワイトチェリー"}]
[{"type": "subtitle", "time": 14046.189, "timestamp": "03:54:06", "text": "ナマステ。調子はどうですか"}, {"type": "subtitle", "time": 14049.03, "timestamp": "03:54:09", "text": "あなた？何てことだ。見て。行く。彼を見て。"}, {"type": "subtitle", "time": 14052.269, "timestamp": "03:54:12", "text": "彼は王子様のように見える。実際の"}, {"type": "subtitle", "time": 14055.99, "timestamp": "03:54:15", "text": "友達。行く。"}, {"type": "subtitle", "time": 14058.429, "timestamp": "03:54:18", "text": "だから彼はとても"}, {"type": "chat", "time": 14059.053, "timestamp": "03:54:19", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "a wut prince"}, {"type": "subtitle", "time": 14062.229, "timestamp": "03:54:22", "text": "かわいい。お姫様のベッド。うん、彼は"}, {"type": "chat", "time": 14062.421, "timestamp": "03:54:22", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "ah nvm"}, {"type": "subtitle", "time": 14064.03, "timestamp": "03:54:24", "text": "彼と全く同じように"}, {"type": "subtitle", "time": 14067.99, "timestamp": "03:54:27", "text": "甘い。ええ、そうですね。ええ、もちろんです。それはとても"}, {"type": "subtitle", "time": 14069.79, "timestamp": "03:54:29", "text": "でも、それは良くない。"}, {"type": "subtitle", "time": 14074.51, "timestamp": "03:54:34", "text": "はい。手に入れるつもりだ、私は行くつもりだ"}, {"type": "subtitle", "time": 14076.429, "timestamp": "03:54:36", "text": "取得するため"}, {"type": "subtitle", "time": 14078.429, "timestamp": "03:54:38", "text": "私の"}, {"type": "subtitle", "time": 14080.67, "timestamp": "03:54:40", "text": "アイテム。"}, {"type": "subtitle", "time": 14088.309, "timestamp": "03:54:48", "text": "行く。スーパーマンが飛んでいる。それは"}, {"type": "subtitle", "time": 14089.99, "timestamp": "03:54:49", "text": "見上げるとまるでドラゴンのようだった"}, {"type": "subtitle", "time": 14092.349, "timestamp": "03:54:52", "text": "空。"}, {"type": "subtitle", "time": 14096.67, "timestamp": "03:54:56", "text": "おお。ニース。うん、ベッドを整えなきゃ。"}, {"type": "subtitle", "time": 14098.99, "timestamp": "03:54:58", "text": "うん。つまり、ここが"}]
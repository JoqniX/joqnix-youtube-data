[{"type": "subtitle", "time": 14723.309, "timestamp": "04:05:23", "text": "うん。"}, {"type": "subtitle", "time": 14733.389, "timestamp": "04:05:33", "text": "ヒートガン。うん。こんにちは。元気ですか？熱"}, {"type": "subtitle", "time": 14736.469, "timestamp": "04:05:36", "text": "銃。お元気でお過ごしでしょうか。うん。"}, {"type": "subtitle", "time": 14746.11, "timestamp": "04:05:46", "text": "こんにちは。どうしたの？私は自分のことをしています"}, {"type": "subtitle", "time": 14747.95, "timestamp": "04:05:47", "text": "アドベンチャー"}, {"type": "subtitle", "time": 14750.389, "timestamp": "04:05:50", "text": "経験。だから私たちは、"}, {"type": "subtitle", "time": 14752.189, "timestamp": "04:05:52", "text": "探す"}, {"type": "subtitle", "time": 14756.75, "timestamp": "04:05:56", "text": "えっと、桜の花を探しています"}, {"type": "subtitle", "time": 14759.269, "timestamp": "04:05:59", "text": "バイオームを作って、"}]
[{"type": "subtitle", "time": 1626.789, "timestamp": "00:27:06", "text": "服装。でも私は"}, {"type": "subtitle", "time": 1629.07, "timestamp": "00:27:09", "text": "会員資格は"}, {"type": "subtitle", "time": 1632.789, "timestamp": "00:27:12", "text": "外。ええ、わかっています。それをブランド化する必要がある"}, {"type": "subtitle", "time": 1634.59, "timestamp": "00:27:14", "text": "きちんと。実は"}, {"type": "subtitle", "time": 1637.83, "timestamp": "00:27:17", "text": "会員アイコンと"}, {"type": "subtitle", "time": 1643.63, "timestamp": "00:27:23", "text": "[音楽]"}, {"type": "subtitle", "time": 1654.35, "timestamp": "00:27:34", "text": "これ。私は計画を持っています"}, {"type": "subtitle", "time": 1668.549, "timestamp": "00:27:48", "text": "ええ、許可を選択した場合はそうではありません"}, {"type": "subtitle", "time": 1670.63, "timestamp": "00:27:50", "text": "特定のギフトメンバーシップ"}, {"type": "subtitle", "time": 1674.389, "timestamp": "00:27:54", "text": "過去にはチャンネルを選択する必要があったかもしれません"}, {"type": "subtitle", "time": 1678.149, "timestamp": "00:27:58", "text": "ええと、世界的に、"}]
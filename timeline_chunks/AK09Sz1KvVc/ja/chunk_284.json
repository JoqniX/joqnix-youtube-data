[{"type": "subtitle", "time": 17051.83, "timestamp": "04:44:11", "text": "家。待って、私が置けるよ。ええ、私は"}, {"type": "subtitle", "time": 17055.55, "timestamp": "04:44:15", "text": "こんな風にゴールに入れることもできる。"}, {"type": "subtitle", "time": 17058.03, "timestamp": "04:44:18", "text": "うん。"}, {"type": "subtitle", "time": 17073.11, "timestamp": "04:44:33", "text": "さて、それでは旅の話に戻りましょう。だった"}, {"type": "subtitle", "time": 17078.708, "timestamp": "04:44:38", "text": "場所。この物をなくさないといいな。"}, {"type": "subtitle", "time": 17098.99, "timestamp": "04:44:58", "text": "何が"}]
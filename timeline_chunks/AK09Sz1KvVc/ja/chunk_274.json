[{"type": "subtitle", "time": 16440.23, "timestamp": "04:34:00", "text": "終了した。それで、私は、ええと、"}, {"type": "subtitle", "time": 16448.349, "timestamp": "04:34:08", "text": "待って、この背の高い草は何？見てください"}, {"type": "subtitle", "time": 16450.67, "timestamp": "04:34:10", "text": "これ。"}, {"type": "subtitle", "time": 16453.47, "timestamp": "04:34:13", "text": "おお。胸の中身は？"}, {"type": "subtitle", "time": 16457.31, "timestamp": "04:34:17", "text": "けれど？蜂がいる"}, {"type": "subtitle", "time": 16462.349, "timestamp": "04:34:22", "text": "ネスト。おお。蜂がいる。"}, {"type": "subtitle", "time": 16466.629, "timestamp": "04:34:26", "text": "何？これは、えーと、Minecraftのアンケートから得たものです。"}, {"type": "subtitle", "time": 16468.99, "timestamp": "04:34:28", "text": "できないよ、そこには"}, {"type": "subtitle", "time": 16472.109, "timestamp": "04:34:32", "text": "ちょっと待って、これをチェックしたい"}, {"type": "subtitle", "time": 16481.629, "timestamp": "04:34:41", "text": "蜂の巣クレーターの後ろにあるビートルートクレーター"}, {"type": "subtitle", "time": 16485.31, "timestamp": "04:34:45", "text": "ビーツの種。何てことだ。"}, {"type": "subtitle", "time": 16487.39, "timestamp": "04:34:47", "text": "何？"}, {"type": "subtitle", "time": 16491.349, "timestamp": "04:34:51", "text": "くそ。おお。"}, {"type": "subtitle", "time": 16492.91, "timestamp": "04:34:52", "text": "では、待ってください。"}, {"type": "subtitle", "time": 16497.39, "timestamp": "04:34:57", "text": "えっと、カレンダーですよね？カレンダー。"}]
[{"type": "subtitle", "time": 17462.788, "timestamp": "04:51:02", "text": "プロセスは、やり過ぎたようなものだ"}, {"type": "subtitle", "time": 17466.47, "timestamp": "04:51:06", "text": "体には疲労が蓄積する。あ、待って、私は"}, {"type": "subtitle", "time": 17469.43, "timestamp": "04:51:09", "text": "ヘッドホンをつけないようにしないと"}, {"type": "subtitle", "time": 17472.15, "timestamp": "04:51:12", "text": "頭痛がする。全部着るのを忘れてた"}, {"type": "subtitle", "time": 17481.89, "timestamp": "04:51:21", "text": "入手する"}, {"type": "subtitle", "time": 17500.65, "timestamp": "04:51:40", "text": "もの。私はその場所に行きたいのですが、"}, {"type": "subtitle", "time": 17502.67, "timestamp": "04:51:42", "text": "[音楽]"}]
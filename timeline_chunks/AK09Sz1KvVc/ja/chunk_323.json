[{"type": "subtitle", "time": 19380.67, "timestamp": "05:23:00", "text": "えっと、腕"}, {"type": "subtitle", "time": 19383.59, "timestamp": "05:23:03", "text": "ログ。待って、サンプルをもらえますか？"}, {"type": "subtitle", "time": 19384.75, "timestamp": "05:23:04", "text": "これ"}, {"type": "subtitle", "time": 19386.91, "timestamp": "05:23:06", "text": "あまりにも？ウィンク"}, {"type": "subtitle", "time": 19388.99, "timestamp": "05:23:08", "text": "ウィンク。待って、誰が"}, {"type": "subtitle", "time": 19391.15, "timestamp": "05:23:11", "text": "それ？待って、誰が"}, {"type": "subtitle", "time": 19408.788, "timestamp": "05:23:28", "text": "ヤンはここにいた。ああ、ジェド・ジャンは知ってるよ。ええと、"}, {"type": "subtitle", "time": 19411.788, "timestamp": "05:23:31", "text": "私はジェド・ジェドを知っている"}, {"type": "subtitle", "time": 19414.83, "timestamp": "05:23:34", "text": "ジャン。ジェド・ジャン。知ってるよ。"}, {"type": "subtitle", "time": 19417.59, "timestamp": "05:23:37", "text": "彼。さて、こちらが私を歓迎してくれた男性です。"}, {"type": "subtitle", "time": 19421.948, "timestamp": "05:23:41", "text": "挨拶してくれたりとか。それで、"}]
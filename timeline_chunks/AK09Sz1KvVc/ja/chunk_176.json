[{"type": "subtitle", "time": 10567.02, "timestamp": "02:56:07", "text": "悪い。"}, {"type": "subtitle", "time": 10569.63, "timestamp": "02:56:09", "text": "[音楽]"}, {"type": "subtitle", "time": 10571.99, "timestamp": "02:56:11", "text": "よし、もうすぐだ。私たちは手に入れています"}, {"type": "subtitle", "time": 10574.269, "timestamp": "02:56:14", "text": "そこには、"}, {"type": "subtitle", "time": 10577.23, "timestamp": "02:56:17", "text": "みんな。"}, {"type": "subtitle", "time": 10600.19, "timestamp": "02:56:40", "text": "神。なぜ私はそこにダブルを置いたのだろうか？"}, {"type": "subtitle", "time": 10604.15, "timestamp": "02:56:44", "text": "ああ、椅子にだらんと座っているよ。なぜ"}, {"type": "subtitle", "time": 10606.95, "timestamp": "02:56:46", "text": "私は下り坂を辿っているのだろうか？座ることになっている"}, {"type": "subtitle", "time": 10608.63, "timestamp": "02:56:48", "text": "真っ直ぐ。まっすぐ座ることさえできない"}, {"type": "subtitle", "time": 10615.51, "timestamp": "02:56:55", "text": "体。わかった。 5ポイント。それは動作します。それ"}, {"type": "subtitle", "time": 10618.429, "timestamp": "02:56:58", "text": "作品。わかった。わかった。わかった。それ"}]
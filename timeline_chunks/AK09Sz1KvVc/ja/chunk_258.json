[{"type": "subtitle", "time": 15487.55, "timestamp": "04:18:07", "text": "わかった。おお、"}, {"type": "subtitle", "time": 15493.71, "timestamp": "04:18:13", "text": "わかった。さあ"}, {"type": "subtitle", "time": 15495.389, "timestamp": "04:18:15", "text": "行く。"}, {"type": "subtitle", "time": 15498.79, "timestamp": "04:18:18", "text": "スイープ。私はベッドを手に入れられなかった。いいえ。"}, {"type": "subtitle", "time": 15500.87, "timestamp": "04:18:20", "text": "ウールはありますか？私は羊毛を捨てた。ああ、"}, {"type": "subtitle", "time": 15504.309, "timestamp": "04:18:24", "text": "ああ、いいジョーだ。ああ、なんて良いんだ、ああ、いや、"}, {"type": "subtitle", "time": 15520.269, "timestamp": "04:18:40", "text": "死ぬ。おお。聞いたよ"}]
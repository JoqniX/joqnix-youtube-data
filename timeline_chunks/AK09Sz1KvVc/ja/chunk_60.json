[{"type": "subtitle", "time": 3601.829, "timestamp": "01:00:01", "text": "YouTube、ボードを作成するために送信できます"}, {"type": "subtitle", "time": 3604.47, "timestamp": "01:00:04", "text": "ポイント追加を自動的に行う"}, {"type": "subtitle", "time": 3607.75, "timestamp": "01:00:07", "text": "私たちにとっては、そうですよね？画面上ではこうなります"}, {"type": "subtitle", "time": 3611.789, "timestamp": "01:00:11", "text": "見えるでしょ？新しいポイントが"}, {"type": "subtitle", "time": 3614.789, "timestamp": "01:00:14", "text": "会員がさらに追加した"}, {"type": "subtitle", "time": 3617.43, "timestamp": "01:00:17", "text": "よくあることですよね？そんな感じ。それを取ろう"}, {"type": "subtitle", "time": 3620.39, "timestamp": "01:00:20", "text": "そんな感じ。さて、問題はスーパー"}, {"type": "subtitle", "time": 3623.71, "timestamp": "01:00:23", "text": "チャット。スーパーチャットはどのように"}, {"type": "chat", "time": 3625.027, "timestamp": "01:00:25", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "but what bout the main progression bar? will it also update it?"}, {"type": "subtitle", "time": 3626.349, "timestamp": "01:00:26", "text": "仕事？どのように"}, {"type": "subtitle", "time": 3634.789, "timestamp": "01:00:34", "text": "わかった。わかりました、それはカウントされません。あ、待って。"}, {"type": "subtitle", "time": 3638.75, "timestamp": "01:00:38", "text": "それは確かにカウントされます。自信は"}, {"type": "subtitle", "time": 3641.39, "timestamp": "01:00:41", "text": "上。待って、"}, {"type": "subtitle", "time": 3643.829, "timestamp": "01:00:43", "text": "何？主な進行はどうでしょうか？"}, {"type": "subtitle", "time": 3646.15, "timestamp": "01:00:46", "text": "バー？はい、それもアップデートされます。"}, {"type": "subtitle", "time": 3648.87, "timestamp": "01:00:48", "text": "そこが問題なんです。"}, {"type": "subtitle", "time": 3650.99, "timestamp": "01:00:50", "text": "それが私の望みです"}, {"type": "subtitle", "time": 3653.15, "timestamp": "01:00:53", "text": "今。"}, {"type": "subtitle", "time": 3657.349, "timestamp": "01:00:57", "text": "つまり、Twitchを優先しているということですね。"}]
[{"type": "subtitle", "time": 9843.469, "timestamp": "02:44:03", "text": "兄弟？メガソン"}, {"type": "subtitle", "time": 9846.87, "timestamp": "02:44:06", "text": "ポイント。 2つのことを付け加えなければならない。"}, {"type": "subtitle", "time": 9848.63, "timestamp": "02:44:08", "text": "右？だから、それを足さなければならない。私はしなければならない"}, {"type": "subtitle", "time": 9853.65, "timestamp": "02:44:13", "text": "だから考えよう、考えよう"}, {"type": "subtitle", "time": 9856.269, "timestamp": "02:44:16", "text": "[音楽]"}, {"type": "subtitle", "time": 9860.19, "timestamp": "02:44:20", "text": "えーと、それはえーと"}, {"type": "subtitle", "time": 9863.23, "timestamp": "02:44:23", "text": "追加なので"}, {"type": "subtitle", "time": 9870.59, "timestamp": "02:44:30", "text": "プラス"}, {"type": "subtitle", "time": 9878.95, "timestamp": "02:44:38", "text": "実際に動作しているところを見てみましょう。わかった、私は"}, {"type": "subtitle", "time": 9880.59, "timestamp": "02:44:40", "text": "保存"}, {"type": "subtitle", "time": 9883.07, "timestamp": "02:44:43", "text": "それ。行く"}, {"type": "subtitle", "time": 9886.55, "timestamp": "02:44:46", "text": "ここ。一緒に見ましょう。私たちは"}, {"type": "subtitle", "time": 9889.75, "timestamp": "02:44:49", "text": "更新手続き中。月ごとに計算します。"}, {"type": "subtitle", "time": 9893.03, "timestamp": "02:44:53", "text": "5つやってみましょう。わかった。 5 + 1 は"}]
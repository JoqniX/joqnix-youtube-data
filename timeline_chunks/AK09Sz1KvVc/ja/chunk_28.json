[{"type": "subtitle", "time": 1680.71, "timestamp": "00:28:00", "text": "他のギフト会員資格の対象"}, {"type": "subtitle", "time": 1682.83, "timestamp": "00:28:02", "text": "チャンネル。どうやらそれは"}, {"type": "subtitle", "time": 1691.95, "timestamp": "00:28:11", "text": "[音楽]"}, {"type": "subtitle", "time": 1696.11, "timestamp": "00:28:16", "text": "ええと、リンクがあります"}, {"type": "subtitle", "time": 1705.83, "timestamp": "00:28:25", "text": "2番。うん。チャンネルを有効にするには、"}, {"type": "subtitle", "time": 1711.55, "timestamp": "00:28:31", "text": "あれ。"}, {"type": "subtitle", "time": 1720.43, "timestamp": "00:28:40", "text": "えっと、どのチャンネルでも"}, {"type": "chat", "time": 1720.887, "timestamp": "00:28:40", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "had breakfast?"}, {"type": "subtitle", "time": 1723.909, "timestamp": "00:28:43", "text": "うん。だから、どこからでもクリックしてください"}, {"type": "subtitle", "time": 1728.47, "timestamp": "00:28:48", "text": "チャンネル参加ウィンドウといいね切り替え"}, {"type": "subtitle", "time": 1730.549, "timestamp": "00:28:50", "text": "点いたり消えたりする。私は朝食をとります。まだ。"}, {"type": "subtitle", "time": 1737.99, "timestamp": "00:28:57", "text": "それ。ああ、買いに行かなきゃ。私はただ"}, {"type": "subtitle", "time": 1739.909, "timestamp": "00:28:59", "text": "目が覚めたよ。歯を磨いたところです"}]
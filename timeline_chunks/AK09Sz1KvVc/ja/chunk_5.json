[{"type": "subtitle", "time": 302.87, "timestamp": "00:05:02", "text": "プロはイベントをきちんと宣伝するんだよ。"}, {"type": "subtitle", "time": 306.95, "timestamp": "00:05:06", "text": "きちんと宣伝しなかったことを申し訳なく思っています"}, {"type": "subtitle", "time": 309.95, "timestamp": "00:05:09", "text": "[音楽]"}, {"type": "subtitle", "time": 320.79, "timestamp": "00:05:20", "text": "わかった。ええ、準備したかったんです"}, {"type": "subtitle", "time": 324.55, "timestamp": "00:05:24", "text": "ストリームのためにかなり多くのものを用意しましたが、"}, {"type": "subtitle", "time": 327.749, "timestamp": "00:05:27", "text": "あまり準備をしていない"}, {"type": "chat", "time": 329.637, "timestamp": "00:05:29", "author": "@Roku-rin", "avatar": "https://yt4.ggpht.com/8LlS_C2IirDMfA5r2V0q5G1kudp8dmG6RQvz_jCAUT3H-esyEgTNPDwrfCXiyX7Undc9UmHNgw=s64-c-k-c0x00ffffff-no-rj", "message": "i believe you should have waited for peak hours but yeah imma dip for work"}, {"type": "subtitle", "time": 330.029, "timestamp": "00:05:30", "text": "昨日疲れていたので"}, {"type": "subtitle", "time": 338.71, "timestamp": "00:05:38", "text": "わかった。ビリー、君は待つべきだった"}, {"type": "subtitle", "time": 340.469, "timestamp": "00:05:40", "text": "Picoも同様です。私は仕事でそこに行ったのではありません。"}, {"type": "subtitle", "time": 342.35, "timestamp": "00:05:42", "text": "大丈夫。いいえ、いいえ、ストリームは"}, {"type": "subtitle", "time": 346.469, "timestamp": "00:05:46", "text": "しばらくの間、流れのように走り続ける。"}, {"type": "subtitle", "time": 350.31, "timestamp": "00:05:50", "text": "ええ、ストリームは独自の方法で実行する必要があります"}, {"type": "subtitle", "time": 352.87, "timestamp": "00:05:52", "text": "あれ、二重のあれ。だから、大丈夫です。いいえ"}]
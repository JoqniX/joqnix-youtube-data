[{"type": "subtitle", "time": 20587.47, "timestamp": "05:43:07", "text": "そうすれば、私は元気になれるかもしれない"}, {"type": "subtitle", "time": 20590.39, "timestamp": "05:43:10", "text": "良い音楽があることは、"}, {"type": "subtitle", "time": 20592.19, "timestamp": "05:43:12", "text": "周りにいて、あなたと同じように"}, {"type": "subtitle", "time": 20594.91, "timestamp": "05:43:14", "text": "そうなるだろうと分かっている"}, {"type": "subtitle", "time": 20598.15, "timestamp": "05:43:18", "text": "彼女が新しいものをリリースしなかったのは良かった"}, {"type": "subtitle", "time": 20610.47, "timestamp": "05:43:30", "text": "こんにちは、お元気ですか？"}, {"type": "subtitle", "time": 20613.27, "timestamp": "05:43:33", "text": "ええと、あなたはここに来るのは初めてだと思います"}, {"type": "subtitle", "time": 20621.948, "timestamp": "05:43:41", "text": "おお。えっと、アジアチェック。えーと、ジャンキー"}, {"type": "subtitle", "time": 20623.708, "timestamp": "05:43:43", "text": "えーと、"}, {"type": "subtitle", "time": 20625.83, "timestamp": "05:43:45", "text": "フレデリック。ジャンキー・フレデリック。待って、"}, {"type": "subtitle", "time": 20631.39, "timestamp": "05:43:51", "text": "何？それは古い"}, {"type": "subtitle", "time": 20638.708, "timestamp": "05:43:58", "text": "待って。ああ、わかりました。よし、それは古い"}]
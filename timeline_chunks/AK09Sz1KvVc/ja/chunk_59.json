[{"type": "chat", "time": 3542.828, "timestamp": "00:59:02", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "*51%"}, {"type": "subtitle", "time": 3546.39, "timestamp": "00:59:06", "text": "右？これは複製です。"}, {"type": "subtitle", "time": 3549.23, "timestamp": "00:59:09", "text": "そう、私が持っているもののうちの"}, {"type": "chat", "time": 3549.38, "timestamp": "00:59:09", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "mhm"}, {"type": "subtitle", "time": 3553.99, "timestamp": "00:59:13", "text": "トゥイッチ。私の考えはポイントにまとめました。"}, {"type": "subtitle", "time": 3557.19, "timestamp": "00:59:17", "text": "右？ポイントでは、1、2、3"}, {"type": "subtitle", "time": 3559.75, "timestamp": "00:59:19", "text": "えーと、ティア1に1ポイント、1"}, {"type": "subtitle", "time": 3561.75, "timestamp": "00:59:21", "text": "ティア2には1ポイント、ティア1には1ポイント"}, {"type": "subtitle", "time": 3564.15, "timestamp": "00:59:24", "text": "３つ目と、もう一つのことですよね？のために"}, {"type": "subtitle", "time": 3567.589, "timestamp": "00:59:27", "text": "会員権"}, {"type": "subtitle", "time": 3571.789, "timestamp": "00:59:31", "text": "会員になるには1ポイント必要です"}, {"type": "subtitle", "time": 3575.67, "timestamp": "00:59:35", "text": "だから私は変更するか、"}, {"type": "subtitle", "time": 3578.23, "timestamp": "00:59:38", "text": "ポイントを追加する方法があります"}, {"type": "subtitle", "time": 3580.91, "timestamp": "00:59:40", "text": "ここ"}, {"type": "subtitle", "time": 3583.549, "timestamp": "00:59:43", "text": "えっと、どこですか"}, {"type": "subtitle", "time": 3591.75, "timestamp": "00:59:51", "text": "ポイント、そう、ポイントを追加、そう、感嘆"}, {"type": "subtitle", "time": 3593.109, "timestamp": "00:59:53", "text": "ポイント"}, {"type": "subtitle", "time": 3595.99, "timestamp": "00:59:55", "text": "うん。うん。今ならできる。できました"}, {"type": "subtitle", "time": 3598.87, "timestamp": "00:59:58", "text": "使用。そのため、イベントが発生するたびに"}]
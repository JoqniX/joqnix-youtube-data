[{"type": "subtitle", "time": 13560.11, "timestamp": "03:46:00", "text": "私はできる"}, {"type": "subtitle", "time": 13562.75, "timestamp": "03:46:02", "text": "行く。"}, {"type": "subtitle", "time": 13565.51, "timestamp": "03:46:05", "text": "痛み。モ、ベッドさえ置いてないのに"}, {"type": "subtitle", "time": 13569.349, "timestamp": "03:46:09", "text": "眠った。ああ、それは私のせいだった。ああ、それは"}, {"type": "subtitle", "time": 13572.95, "timestamp": "03:46:12", "text": "大丈夫。それは異常に多い量です"}, {"type": "subtitle", "time": 13576.429, "timestamp": "03:46:16", "text": "あそこに暴徒がいる。ああ、"}, {"type": "subtitle", "time": 13582.189, "timestamp": "03:46:22", "text": "[音楽]"}, {"type": "subtitle", "time": 13586.67, "timestamp": "03:46:26", "text": "聖なる。楽しい時間を過ごしています。読んだ"}, {"type": "subtitle", "time": 13589.75, "timestamp": "03:46:29", "text": "それ。さあ行こう。ああ、本当に"}, {"type": "subtitle", "time": 13594.59, "timestamp": "03:46:34", "text": "02のスキンを変更する。たぶん"}, {"type": "subtitle", "time": 13599.91, "timestamp": "03:46:39", "text": "えっと、自分のジョックスのやつを入れた方がいいかも。"}, {"type": "subtitle", "time": 13610.11, "timestamp": "03:46:50", "text": "[音楽]"}, {"type": "subtitle", "time": 13613.389, "timestamp": "03:46:53", "text": "ブッシュ。なんでしょう？"}, {"type": "subtitle", "time": 13616.87, "timestamp": "03:46:56", "text": "165. それは馬です。馬が必要だ"}, {"type": "subtitle", "time": 13619.87, "timestamp": "03:46:59", "text": "あれ。えっと、なんて言うんだっけ"}]
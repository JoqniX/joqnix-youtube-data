[{"type": "subtitle", "time": 16320.99, "timestamp": "04:32:00", "text": "いいね。まあまあ"}, {"type": "subtitle", "time": 16323.87, "timestamp": "04:32:03", "text": "いいね。シュレッディングドームプロジェクト"}, {"type": "subtitle", "time": 16327.03, "timestamp": "04:32:07", "text": "1つ。待って、それはもっとあるということ"}, {"type": "subtitle", "time": 16340.67, "timestamp": "04:32:20", "text": "かわいい。ああ、大変だ。彼女はおそらく"}, {"type": "subtitle", "time": 16343.469, "timestamp": "04:32:23", "text": "夕食。夕食って何？"}, {"type": "subtitle", "time": 16347.189, "timestamp": "04:32:27", "text": "3時までに昼食。3時前または3時前に"}, {"type": "subtitle", "time": 16359.349, "timestamp": "04:32:39", "text": "はい。待って。これは何ですか？確認していません"}, {"type": "subtitle", "time": 16360.99, "timestamp": "04:32:40", "text": "これを外す。"}, {"type": "subtitle", "time": 16365.55, "timestamp": "04:32:45", "text": "待って。待ってください。"}, {"type": "subtitle", "time": 16374.67, "timestamp": "04:32:54", "text": "待って、それってインドの名前？ムリー"}, {"type": "subtitle", "time": 16376.269, "timestamp": "04:32:56", "text": "ムレイ。"}, {"type": "subtitle", "time": 16378.81, "timestamp": "04:32:58", "text": "Mleyの口ひげ"}]
[{"type": "subtitle", "time": 13380.91, "timestamp": "03:43:00", "text": "私にとってはそれで十分です。私はハイな気分ではない"}, {"type": "subtitle", "time": 13401.11, "timestamp": "03:43:21", "text": "それ。いや、今「合計」をクリックしたのか？"}, {"type": "subtitle", "time": 13405.15, "timestamp": "03:43:25", "text": "ファンタジー？なんてこった。いいえ。"}, {"type": "subtitle", "time": 13408.75, "timestamp": "03:43:28", "text": "それ。待って。ええと、そのためにはオープンシェーダーパックを使用してください。"}, {"type": "subtitle", "time": 13411.79, "timestamp": "03:43:31", "text": "はい、最後に"}, {"type": "subtitle", "time": 13414.349, "timestamp": "03:43:34", "text": "それ。気にしないで"}, {"type": "subtitle", "time": 13417.349, "timestamp": "03:43:37", "text": "自分。よし。それをあそこに貼り付けてください。"}, {"type": "subtitle", "time": 13425.91, "timestamp": "03:43:45", "text": "それ。完了。そしてカチッ。再び開いてください。"}, {"type": "subtitle", "time": 13429.15, "timestamp": "03:43:49", "text": "中くらい。もう一度開いてください。中程度および"}, {"type": "subtitle", "time": 13431.67, "timestamp": "03:43:51", "text": "適用する。こんなことを言わないでください"}, {"type": "subtitle", "time": 13432.51, "timestamp": "03:43:52", "text": "だろう"}, {"type": "subtitle", "time": 13435.469, "timestamp": "03:43:55", "text": "厳しくする"}, {"type": "subtitle", "time": 13438.63, "timestamp": "03:43:58", "text": "これ。よし、ちょっとあちらで、"}]
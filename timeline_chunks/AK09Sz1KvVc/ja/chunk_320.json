[{"type": "subtitle", "time": 19227.708, "timestamp": "05:20:27", "text": "良い。"}, {"type": "subtitle", "time": 19240.75, "timestamp": "05:20:40", "text": "何か"}, {"type": "subtitle", "time": 19245.03, "timestamp": "05:20:45", "text": "これ。わかりました、それなら入手できます。私は必要としている"}, {"type": "subtitle", "time": 19249.59, "timestamp": "05:20:49", "text": "この44枚の仙葉の苗木を維持するために"}, {"type": "subtitle", "time": 19251.39, "timestamp": "05:20:51", "text": "どこかで"}, {"type": "subtitle", "time": 19254.67, "timestamp": "05:20:54", "text": "それ以外。待って、ちょっと待って。誰かいたのか"}, {"type": "subtitle", "time": 19258.91, "timestamp": "05:20:58", "text": "私が近くにいたとき、ああ"}]
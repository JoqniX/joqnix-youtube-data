[{"type": "subtitle", "time": 18907.43, "timestamp": "05:15:07", "text": "26. ああ、私の強迫性障害はこう言うんだ、神様、おっぱい、彼"}, {"type": "subtitle", "time": 18910.07, "timestamp": "05:15:10", "text": "汚れる必要がある。でも私は幸せです"}, {"type": "subtitle", "time": 18911.868, "timestamp": "05:15:11", "text": "と"}, {"type": "subtitle", "time": 18914.03, "timestamp": "05:15:14", "text": "これ。全て"}, {"type": "subtitle", "time": 18927.93, "timestamp": "05:15:27", "text": "すぐに成長するだろう"}, {"type": "subtitle", "time": 18931.07, "timestamp": "05:15:31", "text": "[音楽]"}, {"type": "subtitle", "time": 18935.11, "timestamp": "05:15:35", "text": "信じる。えっと、もっと穴を見せてください。えっと"}, {"type": "subtitle", "time": 18938.628, "timestamp": "05:15:38", "text": "表示されるまでシード全体が表示されるまでお待ちください。あ、ちょっと待って"}, {"type": "subtitle", "time": 18941.35, "timestamp": "05:15:41", "text": "待って待って。この計画がどのように影響を受けるか"}, {"type": "subtitle", "time": 18945.35, "timestamp": "05:15:45", "text": "バネの力で100%の速度。"}, {"type": "subtitle", "time": 18950.39, "timestamp": "05:15:50", "text": "夏は速度80%、秋は60%、冬は0"}, {"type": "subtitle", "time": 18952.59, "timestamp": "05:15:52", "text": "苗木"}, {"type": "subtitle", "time": 18955.75, "timestamp": "05:15:55", "text": "パターン。わあ、すごい。彼らは"}]
[{"type": "subtitle", "time": 10860.309, "timestamp": "03:01:00", "text": "絵文字。そうそう。ああ、私も一つ欲しい。"}, {"type": "subtitle", "time": 10862.309, "timestamp": "03:01:02", "text": "はい、あと1人メンバーを追加する必要があります"}, {"type": "subtitle", "time": 10866.79, "timestamp": "03:01:06", "text": "6つ目の絵文字。よし、行こう。はい、絵文字"}, {"type": "subtitle", "time": 10877.83, "timestamp": "03:01:17", "text": "それで、呼吸の絵文字を追加しました"}, {"type": "subtitle", "time": 10882.15, "timestamp": "03:01:22", "text": "例えば、ボンクコンフィーヘッドパッドハイドレートなど。"}, {"type": "subtitle", "time": 10894.59, "timestamp": "03:01:34", "text": "キラキラ輝く。保存して"}, {"type": "subtitle", "time": 10897.11, "timestamp": "03:01:37", "text": "公開。さあ行こう。君たちは新しいものを手に入れる"}, {"type": "subtitle", "time": 10905.429, "timestamp": "03:01:45", "text": "彼とそれは私に才能を見せてくれない"}, {"type": "subtitle", "time": 10906.91, "timestamp": "03:01:46", "text": "メンバー、"}, {"type": "subtitle", "time": 10909.91, "timestamp": "03:01:49", "text": "右？ええ、そうは見えませんね。それは"}, {"type": "subtitle", "time": 10912.99, "timestamp": "03:01:52", "text": "誰も贈り物を受け取らなかったという意味です"}, {"type": "subtitle", "time": 10916.76, "timestamp": "03:01:56", "text": "会員ですか？待って。あ、待って。えっと、"}, {"type": "subtitle", "time": 10917.87, "timestamp": "03:01:57", "text": "[音楽]"}]
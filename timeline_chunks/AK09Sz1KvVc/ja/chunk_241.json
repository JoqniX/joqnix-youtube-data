[{"type": "subtitle", "time": 14464.63, "timestamp": "04:01:04", "text": "実際、私は大丈夫です。"}, {"type": "subtitle", "time": 14476.63, "timestamp": "04:01:16", "text": "プレイ中。待って、私は正しい方向へ進んでいるのだろうか？"}, {"type": "subtitle", "time": 14479.51, "timestamp": "04:01:19", "text": "ああ、あれはストレートエンドだった。だから、これは"}, {"type": "subtitle", "time": 14504.389, "timestamp": "04:01:44", "text": "でも、すごく可愛いですね。待って、ボートがある"}, {"type": "subtitle", "time": 14511.309, "timestamp": "04:01:51", "text": "ここ。だから平和でとても"}, {"type": "subtitle", "time": 14519.59, "timestamp": "04:01:59", "text": "それ？ああ、それは神社だ。"}]
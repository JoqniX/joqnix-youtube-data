[{"type": "subtitle", "time": 14400.55, "timestamp": "04:00:00", "text": "トレーディングドームプロジェクト1。今のところは、ここまでです。"}, {"type": "subtitle", "time": 14403.389, "timestamp": "04:00:03", "text": "待って、これはオー、"}, {"type": "subtitle", "time": 14405.51, "timestamp": "04:00:05", "text": "待って。あそこに何かある。私"}, {"type": "subtitle", "time": 14410.75, "timestamp": "04:00:10", "text": "チェック。"}, {"type": "subtitle", "time": 14413.269, "timestamp": "04:00:13", "text": "ああ、もしかしたらあちらに行ってみるのもいいかもしれないね。ええ、私は"}, {"type": "subtitle", "time": 14419.99, "timestamp": "04:00:19", "text": "そこには。なんだかそう感じるね、だって"}, {"type": "subtitle", "time": 14422.63, "timestamp": "04:00:22", "text": "冒涜的な人たちがここにいるんですよね？つまり"}, {"type": "subtitle", "time": 14425.309, "timestamp": "04:00:25", "text": "何かが起こるだろう"}, {"type": "subtitle", "time": 14427.87, "timestamp": "04:00:27", "text": "ここ。多分。うん、そうしよう"}, {"type": "subtitle", "time": 14431.349, "timestamp": "04:00:31", "text": "貿易プロジェクトのドームへ進んでください。"}, {"type": "subtitle", "time": 14438.07, "timestamp": "04:00:38", "text": "それから。それについて調べてみましょう。"}, {"type": "subtitle", "time": 14439.63, "timestamp": "04:00:39", "text": "[音楽]"}, {"type": "subtitle", "time": 14443.11, "timestamp": "04:00:43", "text": "あまりにも。それで、ベッドを1つ作った。そこは"}, {"type": "subtitle", "time": 14450.75, "timestamp": "04:00:50", "text": "それ？私は持っていないことに今気づきました"}, {"type": "subtitle", "time": 14452.51, "timestamp": "04:00:52", "text": "食べ物。おお"}, {"type": "subtitle", "time": 14455.309, "timestamp": "04:00:55", "text": "いいえ、7つあります"}]
[{"type": "subtitle", "time": 15302.59, "timestamp": "04:15:02", "text": "うん。いいえ。ウサギは死んでしまいました。あなたは見ましたか"}, {"type": "subtitle", "time": 15306.149, "timestamp": "04:15:06", "text": "それ？ウサギはサクランボで死んでしまった"}, {"type": "subtitle", "time": 15308.59, "timestamp": "04:15:08", "text": "ブッシュ。"}, {"type": "subtitle", "time": 15311.99, "timestamp": "04:15:11", "text": "いいえ。いいえ。いいえ。いいえ。いいえ。いいえ。ああ、ありがとう"}, {"type": "subtitle", "time": 15313.63, "timestamp": "04:15:13", "text": "ウサギのために"}, {"type": "subtitle", "time": 15318.67, "timestamp": "04:15:18", "text": "食べ物。はぁ？何だって？それはコインです。"}, {"type": "subtitle", "time": 15323.389, "timestamp": "04:15:23", "text": "待って、それは私が知るためだった、"}, {"type": "subtitle", "time": 15325.79, "timestamp": "04:15:25", "text": "右？ああ、"}, {"type": "subtitle", "time": 15329.87, "timestamp": "04:15:29", "text": "神。このウサギを捕まえさせてください。"}, {"type": "subtitle", "time": 15332.03, "timestamp": "04:15:32", "text": "待って。 H 1"}, {"type": "chat", "time": 15333.012, "timestamp": "04:15:33", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "adithi o7"}, {"type": "subtitle", "time": 15334.349, "timestamp": "04:15:34", "text": "秒私は"}, {"type": "subtitle", "time": 15340.63, "timestamp": "04:15:40", "text": "あなた。あっちの方です。私に従ってください。わかった。"}, {"type": "subtitle", "time": 15351.03, "timestamp": "04:15:51", "text": "おお。おお。あ、あそこだよ。わかった。私"}]
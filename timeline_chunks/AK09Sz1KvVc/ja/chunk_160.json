[{"type": "subtitle", "time": 9603.19, "timestamp": "02:40:03", "text": "私に言うなら、マインクラフトでもやってろよ。こんにちは、私も"}, {"type": "subtitle", "time": 9604.87, "timestamp": "02:40:04", "text": "今すぐマインクラフトをプレイしたい。私はしなければならない"}, {"type": "subtitle", "time": 9607.63, "timestamp": "02:40:07", "text": "それらをすり潰す。これを"}, {"type": "subtitle", "time": 9612.75, "timestamp": "02:40:12", "text": "あれ。メンバーの月数が等しい場合"}, {"type": "subtitle", "time": 9616.429, "timestamp": "02:40:16", "text": "うーん、これはちょっと分かりにくいですね。"}, {"type": "subtitle", "time": 9619.99, "timestamp": "02:40:19", "text": "えっと、ジョッキーについて考えてみてください。到達しました"}, {"type": "subtitle", "time": 9622.23, "timestamp": "02:40:22", "text": "ここまで。君ならできるって分かってるよ。"}, {"type": "subtitle", "time": 9627.56, "timestamp": "02:40:27", "text": "あなた自身。わかった。待って。"}, {"type": "subtitle", "time": 9630.11, "timestamp": "02:40:30", "text": "[音楽]"}, {"type": "subtitle", "time": 9633.51, "timestamp": "02:40:33", "text": "えっと、未定義の場合は、"}, {"type": "subtitle", "time": 9636.51, "timestamp": "02:40:36", "text": "1ポイントですね"}, {"type": "subtitle", "time": 9645.309, "timestamp": "02:40:45", "text": "それが物でなければそうではない"}, {"type": "subtitle", "time": 9650.55, "timestamp": "02:40:50", "text": "えーと更新更新私がやることは"}, {"type": "subtitle", "time": 9656.309, "timestamp": "02:40:56", "text": "いや、本当に竜巻のメッセージを送ることができる"}, {"type": "subtitle", "time": 9659.03, "timestamp": "02:40:59", "text": "遅延しました。大丈夫です。大丈夫です。私たちはそうしません"}]
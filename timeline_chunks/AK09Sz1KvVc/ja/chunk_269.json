[{"type": "subtitle", "time": 16141.07, "timestamp": "04:29:01", "text": "さまざまなタイプの"}, {"type": "subtitle", "time": 16144.99, "timestamp": "04:29:04", "text": "えっと、花。"}, {"type": "subtitle", "time": 16161.11, "timestamp": "04:29:21", "text": "ジャカルディア。それは普通のことです。それは"}, {"type": "subtitle", "time": 16162.99, "timestamp": "04:29:22", "text": "通常の葉。"}, {"type": "subtitle", "time": 16166.229, "timestamp": "04:29:26", "text": "おお。つまり、この場所は80％完成したということです。"}, {"type": "subtitle", "time": 16167.83, "timestamp": "04:29:27", "text": "待って、あれって桜の葉っぱだよね？"}, {"type": "subtitle", "time": 16169.95, "timestamp": "04:29:29", "text": "あれはサクラです。"}, {"type": "subtitle", "time": 16178.55, "timestamp": "04:29:38", "text": "さくら。きっとすぐに見つかるだろう。ピンク"}, {"type": "subtitle", "time": 16181.71, "timestamp": "04:29:41", "text": "桜の葉。待って、チェリー"}, {"type": "subtitle", "time": 16188.469, "timestamp": "04:29:48", "text": "おお。ホワイトチェリー。白と"}, {"type": "subtitle", "time": 16191.389, "timestamp": "04:29:51", "text": "ピンク。うん。こんにちは、スクリーンフォックス。いらっしゃいませ。"}, {"type": "subtitle", "time": 16193.83, "timestamp": "04:29:53", "text": "いらっしゃいませ。まるでこれがあなたの"}, {"type": "subtitle", "time": 16195.91, "timestamp": "04:29:55", "text": "初めて来たんですよね？どうやって見つけたの？"}, {"type": "chat", "time": 16198.316, "timestamp": "04:29:58", "author": "@KJ-xf4oh", "avatar": "https://yt4.ggpht.com/ytc/AIdro_nsVHJ1yWuEN04q59rxDiEp9IaGYYAIEUmiZVVyXPIuIJA=s64-c-k-c0x00ffffff-no-rj", "message": "damn the game looks beautiful"}]
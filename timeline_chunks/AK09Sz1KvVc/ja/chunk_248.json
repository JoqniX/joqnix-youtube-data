[{"type": "subtitle", "time": 14882.389, "timestamp": "04:08:02", "text": "何？ここは停泊場所です。え、何？"}, {"type": "subtitle", "time": 14884.71, "timestamp": "04:08:04", "text": "どうすればここから出られますか？待って、待って、待って、"}, {"type": "subtitle", "time": 14886.71, "timestamp": "04:08:06", "text": "待って、待って、待って。どうすればここから出られますか？全て"}, {"type": "subtitle", "time": 14888.63, "timestamp": "04:08:08", "text": "はい、どうぞ。ドッキングです"}, {"type": "subtitle", "time": 14892.15, "timestamp": "04:08:12", "text": "場所。うわぁ。"}, {"type": "subtitle", "time": 14894.91, "timestamp": "04:08:14", "text": "これは何ですか"}, {"type": "subtitle", "time": 14899.63, "timestamp": "04:08:19", "text": "緑色の魔法の丸太の木？"}, {"type": "subtitle", "time": 14901.63, "timestamp": "04:08:21", "text": "おお。"}, {"type": "subtitle", "time": 14906.429, "timestamp": "04:08:26", "text": "わあ、ここは本当に素晴らしい場所だ。"}, {"type": "subtitle", "time": 14921.429, "timestamp": "04:08:41", "text": "場所？おお。まったく新しい"}, {"type": "subtitle", "time": 14923.07, "timestamp": "04:08:43", "text": "国または"}, {"type": "subtitle", "time": 14925.11, "timestamp": "04:08:45", "text": "何か。都市か何か。ない"}, {"type": "subtitle", "time": 14928.67, "timestamp": "04:08:48", "text": "国。都市か何か。"}, {"type": "subtitle", "time": 14935.59, "timestamp": "04:08:55", "text": "おお。彼らはアパート複合施設を持っている"}, {"type": "subtitle", "time": 14938.429, "timestamp": "04:08:58", "text": "あるいは、そんな感じ。どこ"}]
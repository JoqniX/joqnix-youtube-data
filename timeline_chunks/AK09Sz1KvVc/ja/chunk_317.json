[{"type": "subtitle", "time": 19025.35, "timestamp": "05:17:05", "text": "金。おそらく、これだろう。これだけ"}, {"type": "subtitle", "time": 19031.67, "timestamp": "05:17:11", "text": "つまり、春になるということです"}, {"type": "subtitle", "time": 19040.07, "timestamp": "05:17:20", "text": "大丈夫。うん、たぶん大丈夫だろう。その"}, {"type": "subtitle", "time": 19041.75, "timestamp": "05:17:21", "text": "大丈夫だよ。大丈夫だよ。私"}, {"type": "subtitle", "time": 19072.948, "timestamp": "05:17:52", "text": "何？樹液の苗木がかなり多いですね。 1 2"}, {"type": "subtitle", "time": 19076.35, "timestamp": "05:17:56", "text": "3 4 5 6"}]
[{"type": "subtitle", "time": 18364.75, "timestamp": "05:06:04", "text": "全部自分で育てる必要があるの？私は"}, {"type": "subtitle", "time": 18368.07, "timestamp": "05:06:08", "text": "ちょっと待って、本当に必要なの？"}, {"type": "subtitle", "time": 18388.75, "timestamp": "05:06:28", "text": "私はもう帰ります"}, {"type": "subtitle", "time": 18397.23, "timestamp": "05:06:37", "text": "[音楽]"}, {"type": "subtitle", "time": 18402.59, "timestamp": "05:06:42", "text": "あまりにも。というわけで、今のところ苗木を3本手に入れました。"}, {"type": "subtitle", "time": 18405.69, "timestamp": "05:06:45", "text": "良い。それは良い。"}, {"type": "subtitle", "time": 18415.59, "timestamp": "05:06:55", "text": "全部終わらせます。よし、それが"}]
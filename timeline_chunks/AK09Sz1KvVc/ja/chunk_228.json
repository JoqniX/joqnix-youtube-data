[{"type": "subtitle", "time": 13680.95, "timestamp": "03:48:00", "text": "多くの。もうお腹いっぱいです。待って、いや、やめて"}, {"type": "subtitle", "time": 13683.55, "timestamp": "03:48:03", "text": "心。これらを着ることができます"}, {"type": "subtitle", "time": 13687.07, "timestamp": "03:48:07", "text": "もの。ええ、在庫を増やしましょう"}, {"type": "subtitle", "time": 13689.95, "timestamp": "03:48:09", "text": "空間。それでできる"}, {"type": "subtitle", "time": 13692.08, "timestamp": "03:48:12", "text": "参加する。"}, {"type": "subtitle", "time": 13709.71, "timestamp": "03:48:29", "text": "私たちは？"}, {"type": "subtitle", "time": 13712.469, "timestamp": "03:48:32", "text": "えっと、この場所には"}, {"type": "subtitle", "time": 13716.429, "timestamp": "03:48:36", "text": "さくら。何？はぁ？"}, {"type": "subtitle", "time": 13719.189, "timestamp": "03:48:39", "text": "なんでもう俺と喧嘩するつもりなんだよ、兄弟？"}, {"type": "subtitle", "time": 13720.11, "timestamp": "03:48:40", "text": "くそ"}, {"type": "subtitle", "time": 13722.229, "timestamp": "03:48:42", "text": "上。待って、待って、待って、待って、待って、待って、待って、"}, {"type": "subtitle", "time": 13723.59, "timestamp": "03:48:43", "text": "待って、待って。したくない、したくない"}, {"type": "subtitle", "time": 13727.309, "timestamp": "03:48:47", "text": "実際に死ぬこと。"}, {"type": "subtitle", "time": 13731.189, "timestamp": "03:48:51", "text": "そもそも、私はその手配すらしていなかったんです。"}, {"type": "subtitle", "time": 13733.63, "timestamp": "03:48:53", "text": "待って、待って、待って、待って、待って、待って、待って、"}, {"type": "subtitle", "time": 13736.95, "timestamp": "03:48:56", "text": "待って。食べ物をください。食べ物をください。"}, {"type": "subtitle", "time": 13738.55, "timestamp": "03:48:58", "text": "剣はどこだ？それは何だったのか？それで"}]
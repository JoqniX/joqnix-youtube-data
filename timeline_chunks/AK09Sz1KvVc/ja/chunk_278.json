[{"type": "subtitle", "time": 16682.029, "timestamp": "04:38:02", "text": "はい。"}, {"type": "subtitle", "time": 16686.23, "timestamp": "04:38:06", "text": "うん。こんにちは。だから、ベイビー、えっと、私たちは見つける必要がある"}, {"type": "subtitle", "time": 16693.23, "timestamp": "04:38:13", "text": "えっと、私は"}, {"type": "subtitle", "time": 16695.99, "timestamp": "04:38:15", "text": "私は本当に退席すべきでしょうか"}, {"type": "subtitle", "time": 16698.269, "timestamp": "04:38:18", "text": "から"}, {"type": "subtitle", "time": 16700.789, "timestamp": "04:38:20", "text": "ここを案内してくれてありがとう。"}, {"type": "subtitle", "time": 16704.31, "timestamp": "04:38:24", "text": "本当に本当に楽しかった。"}, {"type": "subtitle", "time": 16707.189, "timestamp": "04:38:27", "text": "これは何ですか？そして、蓮の花。"}, {"type": "subtitle", "time": 16710.75, "timestamp": "04:38:30", "text": "蓮の花がある。さあ"}, {"type": "subtitle", "time": 16715.429, "timestamp": "04:38:35", "text": "行く。この家があれば、"}, {"type": "subtitle", "time": 16729.51, "timestamp": "04:38:49", "text": "蓮。ああ、サトウキビは実際には"}, {"type": "subtitle", "time": 16730.429, "timestamp": "04:38:50", "text": "いいね。"}, {"type": "subtitle", "time": 16733.83, "timestamp": "04:38:53", "text": "彼らが書いたように"}, {"type": "subtitle", "time": 16737.189, "timestamp": "04:38:57", "text": "光はここにも当たります。"}]
[{"type": "subtitle", "time": 10635.63, "timestamp": "02:57:15", "text": "そこには。わかった。これで完了です。"}, {"type": "subtitle", "time": 10639.349, "timestamp": "02:57:19", "text": "それで、次に問題となるのは"}, {"type": "subtitle", "time": 10642.23, "timestamp": "02:57:22", "text": "スーパーチャットをまとめると、"}, {"type": "subtitle", "time": 10666.95, "timestamp": "02:57:46", "text": "私は戻ってきた。父が入ってきた。"}, {"type": "subtitle", "time": 10671.03, "timestamp": "02:57:51", "text": "私はニムの子犬のようなもの、ニムのジュースのようなもの"}, {"type": "subtitle", "time": 10673.95, "timestamp": "02:57:53", "text": "20 の物"}, {"type": "subtitle", "time": 10677.99, "timestamp": "02:57:57", "text": "ルピー。待って、これを飲ませて。私は必要としている"}]
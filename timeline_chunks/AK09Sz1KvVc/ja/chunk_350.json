[{"type": "subtitle", "time": 21001.99, "timestamp": "05:50:01", "text": "あなたが購読していることは知っていますよ？我慢する。私"}, {"type": "subtitle", "time": 21003.948, "timestamp": "05:50:03", "text": "DMにあると思う。させて"}, {"type": "subtitle", "time": 21007.31, "timestamp": "05:50:07", "text": "私に見せて、"}, {"type": "subtitle", "time": 21010.03, "timestamp": "05:50:10", "text": "秒あなたは何者ですか"}, {"type": "subtitle", "time": 21012.15, "timestamp": "05:50:12", "text": "不和？どうやって"}, {"type": "subtitle", "time": 21015.59, "timestamp": "05:50:15", "text": "知ってるよ、YouTube用のシステムを作ったんだ。"}, {"type": "subtitle", "time": 21017.99, "timestamp": "05:50:17", "text": "誰かがそうするたびに私が知ることができる"}, {"type": "subtitle", "time": 21020.23, "timestamp": "05:50:20", "text": "配信中のアクティビティ。例えば、"}, {"type": "subtitle", "time": 21022.708, "timestamp": "05:50:22", "text": "YouTube の登録者は私が"}, {"type": "subtitle", "time": 21024.868, "timestamp": "05:50:24", "text": "彼らのチャンネル名と"}, {"type": "subtitle", "time": 21026.75, "timestamp": "05:50:26", "text": "名前と、いつ購読したか、"}, {"type": "subtitle", "time": 21030.11, "timestamp": "05:50:30", "text": "バックログを溜めているようなもの"}, {"type": "subtitle", "time": 21032.99, "timestamp": "05:50:32", "text": "もの。だからTwitch用に持ってるし、"}, {"type": "subtitle", "time": 21036.628, "timestamp": "05:50:36", "text": "すべてのフォロワーのためのYouTube、すべての"}, {"type": "subtitle", "time": 21038.91, "timestamp": "05:50:38", "text": "YouTubeのアクティビティやコンテンツ"}, {"type": "subtitle", "time": 21046.31, "timestamp": "05:50:46", "text": "そうすれば誰がやったのか簡単にわかる"}, {"type": "subtitle", "time": 21049.91, "timestamp": "05:50:49", "text": "などなど。ストーカーだ。オストル。 O."}, {"type": "subtitle", "time": 21052.628, "timestamp": "05:50:52", "text": "これは在庫の問題ではありません。まるで"}, {"type": "subtitle", "time": 21054.948, "timestamp": "05:50:54", "text": "何が起こっているのかを知るように"}]
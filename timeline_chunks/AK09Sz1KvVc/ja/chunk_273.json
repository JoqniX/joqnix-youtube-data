[{"type": "subtitle", "time": 16380.429, "timestamp": "04:33:00", "text": "[音楽]"}, {"type": "subtitle", "time": 16381.95, "timestamp": "04:33:01", "text": "男。"}, {"type": "subtitle", "time": 16384.349, "timestamp": "04:33:04", "text": "ああ、咲き誇るアロエ"}, {"type": "subtitle", "time": 16386.429, "timestamp": "04:33:06", "text": "ベラ。"}, {"type": "subtitle", "time": 16390.949, "timestamp": "04:33:10", "text": "プリックリア・カトゥス。それは魚を意味します。そうそう。"}, {"type": "subtitle", "time": 16393.83, "timestamp": "04:33:13", "text": "マチはヒンディー語で魚を意味します。忘れた。"}, {"type": "subtitle", "time": 16396.949, "timestamp": "04:33:16", "text": "うん。うん。うん。うん。"}, {"type": "subtitle", "time": 16399.789, "timestamp": "04:33:19", "text": "私は「待って、これは何？」と思った。"}, {"type": "subtitle", "time": 16403.789, "timestamp": "04:33:23", "text": "これ？オーストリアが上昇した。"}, {"type": "subtitle", "time": 16406.029, "timestamp": "04:33:26", "text": "わかった。何ですか"}, {"type": "subtitle", "time": 16408.109, "timestamp": "04:33:28", "text": "これ？"}, {"type": "subtitle", "time": 16412.789, "timestamp": "04:33:32", "text": "ハイラ。アジサイの低木。それはたくさん"}, {"type": "subtitle", "time": 16416.949, "timestamp": "04:33:36", "text": "色。わかった。ポピー。ダンジェリアン。"}, {"type": "subtitle", "time": 16420.709, "timestamp": "04:33:40", "text": "いや、新しいものを見るのが好きなんだ"}, {"type": "subtitle", "time": 16427.91, "timestamp": "04:33:47", "text": "ええと、新しいタイプのもの。うん。おお、"}, {"type": "subtitle", "time": 16429.789, "timestamp": "04:33:49", "text": "これはバラです"}]
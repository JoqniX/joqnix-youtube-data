[{"type": "subtitle", "time": 12908.91, "timestamp": "03:35:08", "text": "なんてこった"}, {"type": "subtitle", "time": 12912.55, "timestamp": "03:35:12", "text": "えっと、それで、私は一体どこにいたんだっけ？さあ行こう"}, {"type": "subtitle", "time": 12927.11, "timestamp": "03:35:27", "text": "すぐ。おお。なんてこった。いや、いや、いや。私は事故を起こしました"}, {"type": "subtitle", "time": 12928.79, "timestamp": "03:35:28", "text": "私は事故を起こしました。あ、待って。待って。私は"}, {"type": "subtitle", "time": 12931.349, "timestamp": "03:35:31", "text": "ブロック。ブロックが必要です。聖なるかな"}, {"type": "subtitle", "time": 12935.349, "timestamp": "03:35:35", "text": "聖なるかな、聖なるかな、聖なるかな。彼をブロックしてください。実は、"}, {"type": "subtitle", "time": 12936.63, "timestamp": "03:35:36", "text": "彼をブロックしてください。あ、待って、待って、待って。ブロック"}, {"type": "subtitle", "time": 12939.309, "timestamp": "03:35:39", "text": "彼。彼をブロックしてください。ロック解除"}, {"type": "subtitle", "time": 12947.71, "timestamp": "03:35:47", "text": "村人。おお"}, {"type": "subtitle", "time": 12952.309, "timestamp": "03:35:52", "text": "男の子。私の木材。待て、彼は出て行った。どうやって？"}, {"type": "subtitle", "time": 12958.91, "timestamp": "03:35:58", "text": "何？わかった、私は死ぬかもしれない。私は必要としている"}]
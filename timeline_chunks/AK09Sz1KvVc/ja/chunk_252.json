[{"type": "subtitle", "time": 15121.91, "timestamp": "04:12:01", "text": "自分で自己紹介文を作ります。ああ、なんてことだ。私"}, {"type": "subtitle", "time": 15137.51, "timestamp": "04:12:17", "text": "知る。それは必要ない。雑草の海。投げる"}, {"type": "subtitle", "time": 15139.55, "timestamp": "04:12:19", "text": "あっちの方へ。"}, {"type": "subtitle", "time": 15146.63, "timestamp": "04:12:26", "text": "離れて。今シーズンは植物は成長しないでしょう。"}, {"type": "subtitle", "time": 15149.59, "timestamp": "04:12:29", "text": "いいえ。"}, {"type": "subtitle", "time": 15163.51, "timestamp": "04:12:43", "text": "最悪だ。あなたも取引に参加すべきです。おお、"}, {"type": "subtitle", "time": 15164.55, "timestamp": "04:12:44", "text": "待って、待って、待って。うん、うん、うん、"}, {"type": "subtitle", "time": 15166.15, "timestamp": "04:12:46", "text": "うん。今行ってる。待って、待って。どこ"}, {"type": "subtitle", "time": 15169.55, "timestamp": "04:12:49", "text": "それ？どこにあるの？どこにあるの？スポーン"}, {"type": "subtitle", "time": 15172.51, "timestamp": "04:12:52", "text": "場所。バイオームがたくさんある"}, {"type": "subtitle", "time": 15177.189, "timestamp": "04:12:57", "text": "そこには。ああ、わかりました。待って、待って、待って。"}]
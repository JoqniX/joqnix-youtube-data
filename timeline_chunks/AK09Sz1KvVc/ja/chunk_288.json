[{"type": "subtitle", "time": 17280.19, "timestamp": "04:48:00", "text": "なぜ無垢なバカをボンしたいのか"}, {"type": "subtitle", "time": 17283.628, "timestamp": "04:48:03", "text": "自分？私は何をしたのか"}, {"type": "subtitle", "time": 17286.948, "timestamp": "04:48:06", "text": "する？待って、この場所には"}, {"type": "subtitle", "time": 17288.19, "timestamp": "04:48:08", "text": "のように"}, {"type": "subtitle", "time": 17291.948, "timestamp": "04:48:11", "text": "キャンプファイヤーまたは"}, {"type": "subtitle", "time": 17297.83, "timestamp": "04:48:17", "text": "ああ、無料のチキンがあるよ"}, {"type": "subtitle", "time": 17300.948, "timestamp": "04:48:20", "text": "ここ。私がそれを殺しても気にしないでください。参加します"}, {"type": "subtitle", "time": 17332.15, "timestamp": "04:48:52", "text": "それ？何かが落ちてくるように見える"}, {"type": "subtitle", "time": 17333.31, "timestamp": "04:48:53", "text": "下。"}, {"type": "subtitle", "time": 17336.31, "timestamp": "04:48:56", "text": "あ、待って。私はそれを自分の"}, {"type": "subtitle", "time": 17338.27, "timestamp": "04:48:58", "text": "エンダーチェスト。の"}]
[{"type": "subtitle", "time": 16930.07, "timestamp": "04:42:10", "text": "ええ、チェックポイントはありません。 A"}, {"type": "subtitle", "time": 16945.83, "timestamp": "04:42:25", "text": "痛み。わかった。だから、私は満足します"}, {"type": "subtitle", "time": 16948.23, "timestamp": "04:42:28", "text": "今頃は幸せであるべきだ。欲しいもの"}, {"type": "subtitle", "time": 16950.59, "timestamp": "04:42:30", "text": "もっと。うん、このカエデの丸太をもらおう"}, {"type": "subtitle", "time": 16961.43, "timestamp": "04:42:41", "text": "心。アスペン材。ちょっとした使い捨て"}]
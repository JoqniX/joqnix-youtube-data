[{"type": "subtitle", "time": 16990.27, "timestamp": "04:43:10", "text": "こんにちは、メープルです"}, {"type": "subtitle", "time": 16993.11, "timestamp": "04:43:13", "text": "ロック。大丈夫。気にしないでください。いくつか手に入れます"}, {"type": "subtitle", "time": 17000.03, "timestamp": "04:43:20", "text": "ログ。でも、でも、私はそれを成し遂げたい"}, {"type": "subtitle", "time": 17003.788, "timestamp": "04:43:23", "text": "全体を作るために"}, {"type": "subtitle", "time": 17007.35, "timestamp": "04:43:27", "text": "チェリーみたいなやつ。"}, {"type": "subtitle", "time": 17010.39, "timestamp": "04:43:30", "text": "でも、余裕のある人を見つけないと"}, {"type": "subtitle", "time": 17015.07, "timestamp": "04:43:35", "text": "チェリーの丸太をいくつか、もしくは少なくとも"}, {"type": "subtitle", "time": 17019.628, "timestamp": "04:43:39", "text": "チェリー。ああ、クモだ。いや、いや、いや、"}, {"type": "subtitle", "time": 17022.31, "timestamp": "04:43:42", "text": "いいえ。また、私は気をつけなければならない"}, {"type": "subtitle", "time": 17024.708, "timestamp": "04:43:44", "text": "死ぬ。私はこれら全てを取り戻さなければならない"}, {"type": "subtitle", "time": 17027.75, "timestamp": "04:43:47", "text": "家に持ち帰るものですよね？しかし、家とは一体何だろうか？"}, {"type": "subtitle", "time": 17029.23, "timestamp": "04:43:49", "text": "どこ"}, {"type": "subtitle", "time": 17030.99, "timestamp": "04:43:50", "text": "家？ない"}]
[{"type": "subtitle", "time": 13866.59, "timestamp": "03:51:06", "text": "女王。待って、"}, {"type": "subtitle", "time": 13870.87, "timestamp": "03:51:10", "text": "何？え、何？私の許可を保存します。"}, {"type": "subtitle", "time": 13872.389, "timestamp": "03:51:12", "text": "待って、私、何をしたの？私は何をしたの？何"}, {"type": "subtitle", "time": 13874.03, "timestamp": "03:51:14", "text": "私は"}, {"type": "subtitle", "time": 13880.15, "timestamp": "03:51:20", "text": "ニ。待って、この繰り返し再生を止めるにはどうすればいいの？"}, {"type": "subtitle", "time": 13882.79, "timestamp": "03:51:22", "text": "常に繰り返し再生されている。いいえ"}, {"type": "subtitle", "time": 13884.269, "timestamp": "03:51:24", "text": "録音、"}, {"type": "subtitle", "time": 13886.269, "timestamp": "03:51:26", "text": "待って。であるべきだ"}, {"type": "subtitle", "time": 13905.07, "timestamp": "03:51:45", "text": "は。えーと、オート"}, {"type": "subtitle", "time": 13908.15, "timestamp": "03:51:48", "text": "リプレイ。うん。こんにちは。元気かい？"}, {"type": "subtitle", "time": 13910.91, "timestamp": "03:51:50", "text": "録画を自動化する。電源を切ります。"}, {"type": "subtitle", "time": 13914.389, "timestamp": "03:51:54", "text": "最後に、私は本当に録音します"}, {"type": "subtitle", "time": 13916.11, "timestamp": "03:51:56", "text": "良い"}]
[{"type": "subtitle", "time": 13202.229, "timestamp": "03:40:02", "text": "100%。ちょっと待って。ちょっと待って。は"}, {"type": "subtitle", "time": 13210.349, "timestamp": "03:40:10", "text": "待って、"}, {"type": "subtitle", "time": 13214.55, "timestamp": "03:40:14", "text": "GPU。 GPUを大量に消費している。ああ、"}, {"type": "subtitle", "time": 13217.67, "timestamp": "03:40:17", "text": "神。待って、それはまずい。それはまずい。"}, {"type": "subtitle", "time": 13221.469, "timestamp": "03:40:21", "text": "悪い。待って、どうすれば直せるの？"}, {"type": "subtitle", "time": 13226.03, "timestamp": "03:40:26", "text": "待って。聖なる。ほぼ100％と言えるでしょう。"}, {"type": "subtitle", "time": 13232.95, "timestamp": "03:40:32", "text": "何？シェーダーの使用をやめるべきでしょうか？私 私"}, {"type": "subtitle", "time": 13235.95, "timestamp": "03:40:35", "text": "私のPCが処理したいと思っている"}, {"type": "subtitle", "time": 13245.309, "timestamp": "03:40:45", "text": "更新されました。ああ、"}, {"type": "subtitle", "time": 13250.269, "timestamp": "03:40:50", "text": "いいね。ああ、私のGPUは"}, {"type": "subtitle", "time": 13253.59, "timestamp": "03:40:53", "text": "ほぼ100％、99％。ああ、そうだね。私はそうすべきだ"}, {"type": "subtitle", "time": 13256.87, "timestamp": "03:40:56", "text": "実際にはシェーダーを一切使用しない方が良いでしょう。"}]
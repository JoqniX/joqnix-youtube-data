[{"type": "subtitle", "time": 1570.39, "timestamp": "00:26:10", "text": "看看毒液。 他正在横冲直撞"}, {"type": "subtitle", "time": 1572.87, "timestamp": "00:26:12", "text": "。"}, {"type": "subtitle", "time": 1595.11, "timestamp": "00:26:35", "text": "哦，等等。 什么？ 发生了什么事？"}, {"type": "subtitle", "time": 1596.4, "timestamp": "00:26:36", "text": "发生了什么事？ 乔说：“你做得太过分了。” 乔。"}, {"type": "subtitle", "time": 1599.919, "timestamp": "00:26:39", "text": "乔说：“你做得太过分了。” 乔。 我的天啊。"}, {"type": "subtitle", "time": 1615.11, "timestamp": "00:26:55", "text": "弹药算在内吗？"}]
[{"type": "subtitle", "time": 3561.51, "timestamp": "00:59:21", "text": "嗯，我的意思是，我想最主要的问题是"}, {"type": "subtitle", "time": 3564.541, "timestamp": "00:59:24", "text": "我表现很糟糕。"}, {"type": "subtitle", "time": 3573.19, "timestamp": "00:59:33", "text": "我们有个叫杰夫的人，对吧？"}, {"type": "subtitle", "time": 3573.51, "timestamp": "00:59:33", "text": "不，"}, {"type": "subtitle", "time": 3575.349, "timestamp": "00:59:35", "text": "我以为我们有个杰夫。"}, {"type": "subtitle", "time": 3583.43, "timestamp": "00:59:43", "text": "你好，丹妮尔。"}]
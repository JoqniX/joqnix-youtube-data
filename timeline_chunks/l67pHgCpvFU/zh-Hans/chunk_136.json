[{"type": "subtitle", "time": 8161.75, "timestamp": "02:16:01", "text": "游戏或比赛一样。"}, {"type": "subtitle", "time": 8164.149, "timestamp": "02:16:04", "text": "你在游戏中指的是什么？ 该死。"}, {"type": "subtitle", "time": 8166.629, "timestamp": "02:16:06", "text": "这太疯狂了，就像……是啊，我们也在玩"}, {"type": "subtitle", "time": 8169.109, "timestamp": "02:16:09", "text": "游戏，兄弟。"}, {"type": "subtitle", "time": 8171.03, "timestamp": "02:16:11", "text": "没关系。"}, {"type": "subtitle", "time": 8174.39, "timestamp": "02:16:14", "text": "他们会玩。 是的，"}, {"type": "subtitle", "time": 8177.99, "timestamp": "02:16:17", "text": "乔克。 我在你的运动积分里有 24000 分。"}, {"type": "subtitle", "time": 8181.109, "timestamp": "02:16:21", "text": "为什么你们没有建立自己的"}, {"type": "subtitle", "time": 8183.669, "timestamp": "02:16:23", "text": "网站？"}, {"type": "subtitle", "time": 8184.149, "timestamp": "02:16:24", "text": "哪个？"}, {"type": "subtitle", "time": 8186.229, "timestamp": "02:16:26", "text": "你知道吗，有些人就像是靠着赚"}, {"type": "subtitle", "time": 8188.31, "timestamp": "02:16:28", "text": "一百万分之类的东西，不断地把自己变成一个鞭子"}, {"type": "subtitle", "time": 8189.99, "timestamp": "02:16:29", "text": "。"}, {"type": "subtitle", "time": 8192.87, "timestamp": "02:16:32", "text": "啊，我也有过。 我阻止了它。"}, {"type": "subtitle", "time": 8193.83, "timestamp": "02:16:33", "text": "为什么？"}, {"type": "subtitle", "time": 8196.709, "timestamp": "02:16:36", "text": "我需要把它带回来。 所以，呃，"}, {"type": "subtitle", "time": 8199.11, "timestamp": "02:16:39", "text": "达到10级。我必须达到这个等级。"}, {"type": "subtitle", "time": 8200.87, "timestamp": "02:16:40", "text": "我们不能进行排名赛。   是的"}, {"type": "subtitle", "time": 8202.23, "timestamp": "02:16:42", "text": "，我知道。"}, {"type": "subtitle", "time": 8204.309, "timestamp": "02:16:44", "text": "不，我连10级都没到。"}, {"type": "subtitle", "time": 8213.589, "timestamp": "02:16:53", "text": "加我。 啊，游戏开始了。"}, {"type": "subtitle", "time": 8214.07, "timestamp": "02:16:54", "text": "等待。"}, {"type": "subtitle", "time": 8216.469, "timestamp": "02:16:56", "text": "真是个傻瓜，老兄。 在一场游戏中，他救了我们，"}, {"type": "subtitle", "time": 8219.679, "timestamp": "02:16:59", "text": "当时我们[笑声]"}]
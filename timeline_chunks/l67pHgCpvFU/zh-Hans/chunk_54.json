[{"type": "subtitle", "time": 3248.71, "timestamp": "00:54:08", "text": "你已经完成了任务的一半以上"}, {"type": "subtitle", "time": 3256.63, "timestamp": "00:54:16", "text": "我已经准备好表演了。"}, {"type": "subtitle", "time": 3259.307, "timestamp": "00:54:19", "text": "哦，他侥幸躲过了我的故障。"}, {"type": "subtitle", "time": 3259.67, "timestamp": "00:54:19", "text": "[尖叫声]"}, {"type": "subtitle", "time": 3262.39, "timestamp": "00:54:22", "text": "蜘蛛准备出拳。"}, {"type": "subtitle", "time": 3278.309, "timestamp": "00:54:38", "text": "她浪费了她年迈的兄弟。"}, {"type": "subtitle", "time": 3280.71, "timestamp": "00:54:40", "text": "灵蝶浪费了她的机会。 她当时正试图"}, {"type": "subtitle", "time": 3283.349, "timestamp": "00:54:43", "text": "回来。"}, {"type": "subtitle", "time": 3285.99, "timestamp": "00:54:45", "text": "哦，我的天啊。"}]
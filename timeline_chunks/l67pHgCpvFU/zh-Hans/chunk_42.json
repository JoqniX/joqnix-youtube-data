[{"type": "subtitle", "time": 2538.309, "timestamp": "00:42:18", "text": "兄弟，最近怎么样啊"}, {"type": "subtitle", "time": 2540.63, "timestamp": "00:42:20", "text": "，儿子？"}, {"type": "subtitle", "time": 2567.51, "timestamp": "00:42:47", "text": "别惹神奇蜘蛛侠。"}, {"type": "subtitle", "time": 2568.069, "timestamp": "00:42:48", "text": "什么？"}, {"type": "subtitle", "time": 2571.67, "timestamp": "00:42:51", "text": "对不起。 知道它在哪里。 呃，"}, {"type": "subtitle", "time": 2573.589, "timestamp": "00:42:53", "text": "不过我杀了他。"}]
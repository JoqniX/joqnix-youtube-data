[{"type": "subtitle", "time": 4983.83, "timestamp": "01:23:03", "text": "现实被混乱所吞噬。 我不会。"}, {"type": "subtitle", "time": 4989.43, "timestamp": "01:23:09", "text": "[倒吸一口凉气]"}, {"type": "subtitle", "time": 4992.95, "timestamp": "01:23:12", "text": "就让他尝尝吧。"}, {"type": "subtitle", "time": 4994.79, "timestamp": "01:23:14", "text": "但你现在状态超棒。"}, {"type": "subtitle", "time": 4998.149, "timestamp": "01:23:18", "text": "哦，我超棒。 好的。"}, {"type": "subtitle", "time": 5000.55, "timestamp": "01:23:20", "text": "即使是星界，也会随着时间的流逝而分崩离析"}, {"type": "subtitle", "time": 5003.43, "timestamp": "01:23:23", "text": "。 我或许能看出她有能力把"}, {"type": "subtitle", "time": 5022.47, "timestamp": "01:23:42", "text": "战斗将于 5、4、3、2、1 时开始。"}, {"type": "subtitle", "time": 5023.91, "timestamp": "01:23:43", "text": "你只需要占领"}, {"type": "subtitle", "time": 5027.03, "timestamp": "01:23:47", "text": "任务区域即可。 知道了。  [笑声]"}, {"type": "subtitle", "time": 5029.43, "timestamp": "01:23:49", "text": "事情的发生绝对没有"}, {"type": "subtitle", "time": 5034.87, "timestamp": "01:23:54", "text": "现在，他消失了。"}, {"type": "subtitle", "time": 5035.99, "timestamp": "01:23:55", "text": "摇晃均匀。"}, {"type": "subtitle", "time": 5038.149, "timestamp": "01:23:58", "text": "唯一一个比他更丑陋的英雄"}]
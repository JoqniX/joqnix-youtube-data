[{"type": "subtitle", "time": 8340.709, "timestamp": "02:19:00", "text": "它们是如何攀爬的呢？ 看看"}, {"type": "subtitle", "time": 8342.309, "timestamp": "02:19:02", "text": "攀岩就知道了。 哦，他正在康复。 你正在"}, {"type": "subtitle", "time": 8342.79, "timestamp": "02:19:02", "text": "康复。"}, {"type": "subtitle", "time": 8344.87, "timestamp": "02:19:04", "text": "外面的敌人比我脑子里的声音还多"}, {"type": "subtitle", "time": 8369.589, "timestamp": "02:19:29", "text": "巫术控制他们。  [呻吟]"}, {"type": "subtitle", "time": 8379.03, "timestamp": "02:19:39", "text": "。 好的。 好的。"}, {"type": "subtitle", "time": 8380.549, "timestamp": "02:19:40", "text": "这个角色很难演。 我会练习魔法，"}, {"type": "subtitle", "time": 8387.83, "timestamp": "02:19:47", "text": "哦，问题是我的队伍"}, {"type": "subtitle", "time": 8390.309, "timestamp": "02:19:50", "text": "现在根本没能造成任何伤害。"}, {"type": "subtitle", "time": 8392.79, "timestamp": "02:19:52", "text": "呃，"}, {"type": "subtitle", "time": 8395.75, "timestamp": "02:19:55", "text": "我想我得把钢铁侠的装扮脱下来了。"}, {"type": "subtitle", "time": 8399.83, "timestamp": "02:19:59", "text": "如果我喜欢蜘蛛侠的话，我想我会选他"}]
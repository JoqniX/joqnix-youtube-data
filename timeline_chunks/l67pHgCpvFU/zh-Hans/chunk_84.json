[{"type": "subtitle", "time": 5046.167, "timestamp": "01:24:06", "text": "不，不，不，不，不，不，不。"}, {"type": "subtitle", "time": 5046.79, "timestamp": "01:24:06", "text": "[笑声和喘息声]"}, {"type": "subtitle", "time": 5049.43, "timestamp": "01:24:09", "text": "哦，我活过来了。 谢谢。"}, {"type": "subtitle", "time": 5052.229, "timestamp": "01:24:12", "text": "再见。 帮我挠挠背。"}, {"type": "subtitle", "time": 5073.678, "timestamp": "01:24:33", "text": "[尖叫]"}, {"type": "subtitle", "time": 5075.11, "timestamp": "01:24:35", "text": "[哭泣]"}, {"type": "subtitle", "time": 5091.35, "timestamp": "01:24:51", "text": "不。"}, {"type": "subtitle", "time": 5095.43, "timestamp": "01:24:55", "text": "啊，他们挡住了我的大招。"}]
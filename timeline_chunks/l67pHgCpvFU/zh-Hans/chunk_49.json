[{"type": "subtitle", "time": 2944.903, "timestamp": "00:49:04", "text": "琼，别走得太远。"}, {"type": "subtitle", "time": 2945.589, "timestamp": "00:49:05", "text": "[笑声]"}, {"type": "subtitle", "time": 2950.143, "timestamp": "00:49:10", "text": "等等，我还活着。 哦好的。 谢谢。"}, {"type": "subtitle", "time": 2959.03, "timestamp": "00:49:19", "text": "我不知道自己在做什么。"}, {"type": "subtitle", "time": 2965.109, "timestamp": "00:49:25", "text": "只要他们在圈内，"}, {"type": "subtitle", "time": 2979.43, "timestamp": "00:49:39", "text": "那是杰夫吗？ 我的天啊。 我能让自己"}, {"type": "subtitle", "time": 2984.204, "timestamp": "00:49:44", "text": "步履轻盈一些吗？ 你看，我还是挺有用的。"}, {"type": "subtitle", "time": 2984.79, "timestamp": "00:49:44", "text": "[笑声]"}, {"type": "chat", "time": 2991.18, "timestamp": "00:49:51", "author": "@bakononcopiumm", "avatar": "https://yt4.ggpht.com/hb5sPAHLUD7fBrZZsmfkzISQWwRqI8BY1n8lceyhZz0sNISomD05pCwUe-GL2amD5y-voH_uYw=s64-c-k-c0x00ffffff-no-rj", "message": "happy nnn btw"}]
[{"type": "subtitle", "time": 12249.59, "timestamp": "03:24:09", "text": "除非你在"}, {"type": "subtitle", "time": 12263.429, "timestamp": "03:24:23", "text": "好的，杰夫。 我有个计划，但这需要"}, {"type": "subtitle", "time": 12265.349, "timestamp": "03:24:25", "text": "精准的时机把握和完美的执行"}, {"type": "subtitle", "time": 12268.15, "timestamp": "03:24:28", "text": "。"}, {"type": "subtitle", "time": 12270.229, "timestamp": "03:24:30", "text": "哦，我只是跟你开玩笑。 你"}, {"type": "subtitle", "time": 12272.55, "timestamp": "03:24:32", "text": "只需要把所有人都吞回家就行了。 知道了"}, {"type": "subtitle", "time": 12278.55, "timestamp": "03:24:38", "text": "我喜欢"}, {"type": "subtitle", "time": 12280.79, "timestamp": "03:24:40", "text": "这个角色和杰夫之间的互动（清嗓子）。   是的"}, {"type": "subtitle", "time": 12291.91, "timestamp": "03:24:51", "text": "这看起来像是银河护卫队的入口"}]
[{"type": "subtitle", "time": 4811.43, "timestamp": "01:20:11", "text": "我觉得我把这个角色演得不错"}, {"type": "subtitle", "time": 4813.99, "timestamp": "01:20:13", "text": "。 这样更容易。 让我把"}, {"type": "subtitle", "time": 4819.535, "timestamp": "01:20:19", "text": "他们的疗伤药都杀了。 优秀的治疗师死了。"}, {"type": "subtitle", "time": 4821.43, "timestamp": "01:20:21", "text": "[尖叫]"}, {"type": "subtitle", "time": 4824.87, "timestamp": "01:20:24", "text": "拥抱混乱吧。"}, {"type": "subtitle", "time": 4837.83, "timestamp": "01:20:37", "text": "等等，这不是那个吸血鬼吗？"}, {"type": "subtitle", "time": 4840.47, "timestamp": "01:20:40", "text": "吸血鬼猎人。 那个人。 等等，他也在"}, {"type": "subtitle", "time": 4858.55, "timestamp": "01:20:58", "text": "天啊，我要死了。"}, {"type": "subtitle", "time": 4858.709, "timestamp": "01:20:58", "text": "哦，"}]
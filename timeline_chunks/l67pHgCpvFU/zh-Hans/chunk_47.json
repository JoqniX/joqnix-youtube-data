[{"type": "subtitle", "time": 2827.349, "timestamp": "00:47:07", "text": "哦，我们要进去了。"}, {"type": "subtitle", "time": 2841.99, "timestamp": "00:47:21", "text": "这是新地图吗？ 以前从未见过这种情况"}, {"type": "subtitle", "time": 2842.47, "timestamp": "00:47:22", "text": "。"}, {"type": "subtitle", "time": 2855.43, "timestamp": "00:47:35", "text": "选出你的反派角色。 我没有评判的意思。"}, {"type": "subtitle", "time": 2856.95, "timestamp": "00:47:36", "text": "好的。"}, {"type": "subtitle", "time": 2860.15, "timestamp": "00:47:40", "text": "如果我变成蜘蛛侠会怎么样？ 真是"}, {"type": "subtitle", "time": 2870.39, "timestamp": "00:47:50", "text": "不过我已经报名了。"}, {"type": "subtitle", "time": 2870.95, "timestamp": "00:47:50", "text": "哦，"}, {"type": "subtitle", "time": 2874.069, "timestamp": "00:47:54", "text": "我想我"}, {"type": "subtitle", "time": 2875.51, "timestamp": "00:47:55", "text": "应该化身蜘蛛侠，去"}]
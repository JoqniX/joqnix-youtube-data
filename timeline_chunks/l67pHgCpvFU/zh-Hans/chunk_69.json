[{"type": "subtitle", "time": 4145.669, "timestamp": "01:09:05", "text": "我要死了。"}, {"type": "subtitle", "time": 4147.91, "timestamp": "01:09:07", "text": "感觉现在日子变长了。 现在"}, {"type": "subtitle", "time": 4149.829, "timestamp": "01:09:09", "text": "想想，夏令时好像"}, {"type": "subtitle", "time": 4153.99, "timestamp": "01:09:13", "text": "很快就要开始了。"}, {"type": "subtitle", "time": 4165.669, "timestamp": "01:09:25", "text": "[呻吟]"}, {"type": "subtitle", "time": 4167.43, "timestamp": "01:09:27", "text": "我死了。"}, {"type": "subtitle", "time": 4176.789, "timestamp": "01:09:36", "text": "我现在状态不太好。 我"}, {"type": "subtitle", "time": 4178.709, "timestamp": "01:09:38", "text": "已经准备好表演了。"}, {"type": "subtitle", "time": 4181.99, "timestamp": "01:09:41", "text": "法官、陪审团、刽子手。"}]
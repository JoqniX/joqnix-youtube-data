[{"type": "subtitle", "time": 480.71, "timestamp": "00:08:00", "text": "我扮演杰夫。"}, {"type": "subtitle", "time": 482.469, "timestamp": "00:08:02", "text": "合适的英雄可以改变一切"}, {"type": "subtitle", "time": 483.43, "timestamp": "00:08:03", "text": "。"}, {"type": "subtitle", "time": 485.189, "timestamp": "00:08:05", "text": "杰菲。"}, {"type": "subtitle", "time": 487.029, "timestamp": "00:08:07", "text": "嗯，"}, {"type": "subtitle", "time": 490.71, "timestamp": "00:08:10", "text": "一日复仇者，终身复仇者。"}, {"type": "subtitle", "time": 503.11, "timestamp": "00:08:23", "text": "我不知道这个游戏的操作方法。"}, {"type": "subtitle", "time": 507.43, "timestamp": "00:08:27", "text": "哦不，就像"}, {"type": "subtitle", "time": 509.749, "timestamp": "00:08:29", "text": "哦，这里有个英雄。 好的。"}, {"type": "subtitle", "time": 522.55, "timestamp": "00:08:42", "text": "我认为我被选中是为了给世界带来一些好处"}, {"type": "subtitle", "time": 527.11, "timestamp": "00:08:47", "text": "他还有30秒就到。"}, {"type": "subtitle", "time": 527.67, "timestamp": "00:08:47", "text": "坚强点。"}, {"type": "subtitle", "time": 531.269, "timestamp": "00:08:51", "text": "看着我。 我在骑他。   只有拥有"}, {"type": "subtitle", "time": 537.096, "timestamp": "00:08:57", "text": "皇室血统的人才能被称为“领主”。"}, {"type": "subtitle", "time": 538.23, "timestamp": "00:08:58", "text": "[音乐]"}]
[{"type": "subtitle", "time": 14401.349, "timestamp": "04:00:01", "text": "我们应该多玩玩这个游戏。 我我会把"}, {"type": "subtitle", "time": 14403.83, "timestamp": "04:00:03", "text": "这个游戏留一个星期，"}, {"type": "subtitle", "time": 14405.91, "timestamp": "04:00:05", "text": "然后[笑]，"}, {"type": "subtitle", "time": 14410.07, "timestamp": "04:00:10", "text": "然后就没地方放了。 是的，"}, {"type": "subtitle", "time": 14413.03, "timestamp": "04:00:13", "text": "我得腾出更多空间。"}, {"type": "subtitle", "time": 14414.229, "timestamp": "04:00:14", "text": "哦，不。"}, {"type": "subtitle", "time": 14417.361, "timestamp": "04:00:17", "text": "如今游戏规模都非常大。"}, {"type": "subtitle", "time": 14418.15, "timestamp": "04:00:18", "text": "[笑声]"}, {"type": "subtitle", "time": 14421.11, "timestamp": "04:00:21", "text": "不。不。"}, {"type": "subtitle", "time": 14427.429, "timestamp": "04:00:27", "text": "不过，很"}, {"type": "subtitle", "time": 14429.67, "timestamp": "04:00:29", "text": "高兴能和你一起玩这个游戏。"}, {"type": "subtitle", "time": 14432.15, "timestamp": "04:00:32", "text": "平时我不会和任何人一起玩这个游戏"}, {"type": "subtitle", "time": 14436.63, "timestamp": "04:00:36", "text": "[笑]，因为它太卡了。   是的"}, {"type": "subtitle", "time": 14438.63, "timestamp": "04:00:38", "text": "，"}, {"type": "subtitle", "time": 14441.429, "timestamp": "04:00:41", "text": "谢谢你的建议。   我的天哪"}, {"type": "subtitle", "time": 14445.03, "timestamp": "04:00:45", "text": "，我玩得太开心了。"}, {"type": "subtitle", "time": 14453.189, "timestamp": "04:00:53", "text": "下次你想玩这个游戏吗？或者"}, {"type": "subtitle", "time": 14455.11, "timestamp": "04:00:55", "text": "如果你有其他游戏，"}, {"type": "subtitle", "time": 14458.469, "timestamp": "04:00:58", "text": "下次有空的时候可以玩那个。"}]
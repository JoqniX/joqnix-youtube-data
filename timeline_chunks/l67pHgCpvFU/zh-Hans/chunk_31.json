[{"type": "subtitle", "time": 1862.389, "timestamp": "00:31:02", "text": "你为什么没获得最有价值球员奖呢？ 你"}, {"type": "subtitle", "time": 1864.149, "timestamp": "00:31:04", "text": "杀了好多人。"}, {"type": "subtitle", "time": 1867.75, "timestamp": "00:31:07", "text": "不，没关系。 这就是我击杀数减少的"}, {"type": "subtitle", "time": 1869.11, "timestamp": "00:31:09", "text": "原因。"}, {"type": "subtitle", "time": 1872.47, "timestamp": "00:31:12", "text": "所以我现在只处于恢复模式。"}, {"type": "subtitle", "time": 1875.029, "timestamp": "00:31:15", "text": "啊，"}, {"type": "subtitle", "time": 1876.87, "timestamp": "00:31:16", "text": "我想看我的精彩集锦。"}, {"type": "subtitle", "time": 1879.269, "timestamp": "00:31:19", "text": "点击角色头像即可观看精彩集锦"}, {"type": "subtitle", "time": 1882.07, "timestamp": "00:31:22", "text": "。 你也可以"}, {"type": "subtitle", "time": 1884.63, "timestamp": "00:31:24", "text": "观看其他人的精彩集锦。"}, {"type": "subtitle", "time": 1889.43, "timestamp": "00:31:29", "text": "哦，等等。 如何？ 呃，记分牌。 不。呃，"}, {"type": "subtitle", "time": 1893.75, "timestamp": "00:31:33", "text": "跳到右边。 哦，等等。 哦，VU的精彩瞬间。"}, {"type": "subtitle", "time": 1909.43, "timestamp": "00:31:49", "text": "哦，是这个。"}, {"type": "subtitle", "time": 1911.75, "timestamp": "00:31:51", "text": "我们应该看看我的。 我没意识到我"}, {"type": "subtitle", "time": 1915.029, "timestamp": "00:31:55", "text": "拿到了五杀。"}, {"type": "subtitle", "time": 1919.11, "timestamp": "00:31:59", "text": "等等，等等，等等。 很难看到你的。 嗯。"}]
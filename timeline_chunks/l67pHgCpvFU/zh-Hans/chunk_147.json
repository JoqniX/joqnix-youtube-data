[{"type": "subtitle", "time": 8825.67, "timestamp": "02:27:05", "text": "嗯，你可以爆头。 我可以把"}, {"type": "subtitle", "time": 8828.309, "timestamp": "02:27:08", "text": "它们清除掉，"}, {"type": "subtitle", "time": 8830.79, "timestamp": "02:27:10", "text": "你知道的。 我有范围伤害技能。"}, {"type": "subtitle", "time": 8833.67, "timestamp": "02:27:13", "text": "我从未失手。 音乐"}, {"type": "subtitle", "time": 8834.309, "timestamp": "02:27:14", "text": "声太大，我根本听不到。"}, {"type": "subtitle", "time": 8836.469, "timestamp": "02:27:16", "text": "他们还有30秒就到。"}, {"type": "subtitle", "time": 8843.03, "timestamp": "02:27:23", "text": "螳螂，浣熊是什么？"}, {"type": "subtitle", "time": 8846.63, "timestamp": "02:27:26", "text": "哦，呃，它们是地球上最可爱的动物"}, {"type": "subtitle", "time": 8847.67, "timestamp": "02:27:27", "text": "。"}, {"type": "subtitle", "time": 8849.75, "timestamp": "02:27:29", "text": "真的吗？ 为什么大家都在"}, {"type": "subtitle", "time": 8852.71, "timestamp": "02:27:32", "text": "叫浣熊？ 我可是个狠角色。"}, {"type": "subtitle", "time": 8862.469, "timestamp": "02:27:42", "text": "战斗倒计时：五、四、三。"}, {"type": "subtitle", "time": 8863.59, "timestamp": "02:27:43", "text": "入选。"}, {"type": "subtitle", "time": 8865.19, "timestamp": "02:27:45", "text": "对了，各位，我的直播还能正常进行吗"}, {"type": "subtitle", "time": 8867.51, "timestamp": "02:27:47", "text": "？ 没有，没人告诉我。"}, {"type": "subtitle", "time": 8868.07, "timestamp": "02:27:48", "text": "我要买它。"}, {"type": "subtitle", "time": 8869.67, "timestamp": "02:27:49", "text": "不客气。"}, {"type": "subtitle", "time": 8871.67, "timestamp": "02:27:51", "text": "有时，同理心是一种沉重的负担"}, {"type": "subtitle", "time": 8874.55, "timestamp": "02:27:54", "text": "。"}, {"type": "subtitle", "time": 8877.27, "timestamp": "02:27:57", "text": "你必须停止这种行为。"}, {"type": "subtitle", "time": 8879.11, "timestamp": "02:27:59", "text": "好的。 拉屎。 顺便说一下，我的电脑好像出问题了"}]
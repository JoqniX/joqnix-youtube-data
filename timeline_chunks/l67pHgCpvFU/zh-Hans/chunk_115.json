[{"type": "subtitle", "time": 6902.07, "timestamp": "01:55:02", "text": "哦。 哦，那可不好。 那可不好"}, {"type": "subtitle", "time": 6918.95, "timestamp": "01:55:18", "text": "如果打成平局，那我觉得"}, {"type": "subtitle", "time": 6921.109, "timestamp": "01:55:21", "text": "Yui会晋级。  [倒吸一口凉气]"}, {"type": "subtitle", "time": 6937.589, "timestamp": "01:55:37", "text": "艾玛真的就这么跟我说，我死后，我的孩子就不能留给"}, {"type": "subtitle", "time": 6944.87, "timestamp": "01:55:44", "text": "我的天啊。"}, {"type": "subtitle", "time": 6959.99, "timestamp": "01:55:59", "text": "拥抱保护。"}]
[{"type": "subtitle", "time": 13148.87, "timestamp": "03:39:08", "text": "是的，你可以读格鲁特的故事。"}, {"type": "subtitle", "time": 13150.95, "timestamp": "03:39:10", "text": "格鲁特。"}, {"type": "subtitle", "time": 13160.63, "timestamp": "03:39:20", "text": "就连星界也因"}, {"type": "subtitle", "time": 13162.71, "timestamp": "03:39:22", "text": "时间线纠缠而分崩离析。   还有"}, {"type": "subtitle", "time": 13164.389, "timestamp": "03:39:24", "text": "谁"}, {"type": "subtitle", "time": 13165.67, "timestamp": "03:39:25", "text": "比你我更适合把它们重新组装起来呢？"}, {"type": "subtitle", "time": 13175.349, "timestamp": "03:39:35", "text": "哦，等等。 他可以压在"}, {"type": "subtitle", "time": 13177.429, "timestamp": "03:39:37", "text": "露丝身上。"}, {"type": "subtitle", "time": 13178.07, "timestamp": "03:39:38", "text": "什么？   是的"}, {"type": "subtitle", "time": 13179.349, "timestamp": "03:39:39", "text": "。"}, {"type": "subtitle", "time": 13182.229, "timestamp": "03:39:42", "text": "哇。 太酷了！"}, {"type": "subtitle", "time": 13185.292, "timestamp": "03:39:45", "text": "哦，好可爱。"}, {"type": "subtitle", "time": 13186.469, "timestamp": "03:39:46", "text": "[笑声]"}]
[{"type": "subtitle", "time": 842.629, "timestamp": "00:14:02", "text": "兄弟，这可不好。 我曾试图杀死"}, {"type": "subtitle", "time": 844.87, "timestamp": "00:14:04", "text": "他们，但"}, {"type": "subtitle", "time": 847.91, "timestamp": "00:14:07", "text": "现在"}, {"type": "chat", "time": 862.266, "timestamp": "00:14:22", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "ahhhh yes"}, {"type": "subtitle", "time": 865.43, "timestamp": "00:14:25", "text": "如何跑步。 如何跑步。"}, {"type": "subtitle", "time": 867.189, "timestamp": "00:14:27", "text": "哦，不。 蜘蛛侠。"}, {"type": "subtitle", "time": 868.31, "timestamp": "00:14:28", "text": "等待。  [笑声] 去哪儿呢？"}, {"type": "subtitle", "time": 870.389, "timestamp": "00:14:30", "text": "他杀了我。"}, {"type": "subtitle", "time": 872.79, "timestamp": "00:14:32", "text": "蜘蛛侠杀了我。"}, {"type": "subtitle", "time": 876.71, "timestamp": "00:14:36", "text": "去哪儿？ 我迷路了。 我迷路了。 好的。"}, {"type": "subtitle", "time": 878.87, "timestamp": "00:14:38", "text": "我没迷路。 好的。 我找到了出路。"}, {"type": "subtitle", "time": 897.11, "timestamp": "00:14:57", "text": "正确的。"}]
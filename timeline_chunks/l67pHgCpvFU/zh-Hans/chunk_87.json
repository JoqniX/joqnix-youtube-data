[{"type": "subtitle", "time": 5222.55, "timestamp": "01:27:02", "text": "[笑声]"}, {"type": "subtitle", "time": 5225.189, "timestamp": "01:27:05", "text": "这个角色太有趣了。"}, {"type": "subtitle", "time": 5227.91, "timestamp": "01:27:07", "text": "我喜欢乔兰直接向"}, {"type": "subtitle", "time": 5230.31, "timestamp": "01:27:10", "text": "他们射击，而我则在这边射击，这样"}, {"type": "subtitle", "time": 5269.51, "timestamp": "01:27:49", "text": "天哪，我要死了。 获胜者。 时候到了"}, {"type": "subtitle", "time": 5270.709, "timestamp": "01:27:50", "text": "。"}, {"type": "subtitle", "time": 5272.55, "timestamp": "01:27:52", "text": "稍等片刻。 稍等片刻。 我的"}]
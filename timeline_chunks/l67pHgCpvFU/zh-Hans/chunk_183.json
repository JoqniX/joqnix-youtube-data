[{"type": "subtitle", "time": 10994.292, "timestamp": "03:03:14", "text": "我的再见。"}, {"type": "subtitle", "time": 10995.83, "timestamp": "03:03:15", "text": "[笑声]"}, {"type": "subtitle", "time": 11002.63, "timestamp": "03:03:22", "text": "他的名字叫坦克，兄弟。 我们已经走了"}, {"type": "subtitle", "time": 11005.429, "timestamp": "03:03:25", "text": "一半的路程。"}, {"type": "subtitle", "time": 11012.79, "timestamp": "03:03:32", "text": "我试着后退一步。"}, {"type": "subtitle", "time": 11015.75, "timestamp": "03:03:35", "text": "我是怎么死的？"}, {"type": "subtitle", "time": 11017.51, "timestamp": "03:03:37", "text": "哎呀，这地方对"}, {"type": "subtitle", "time": 11022.15, "timestamp": "03:03:42", "text": "我来说简直太完美了。"}]
[{"type": "subtitle", "time": 6780.55, "timestamp": "01:53:00", "text": "你想走就走吧。 我觉得因为"}, {"type": "subtitle", "time": 6782.95, "timestamp": "01:53:02", "text": "我们……"}, {"type": "subtitle", "time": 6784.709, "timestamp": "01:53:04", "text": "没关系。 没关系。 没关系。 他"}, {"type": "subtitle", "time": 6786.523, "timestamp": "01:53:06", "text": "等不及了。"}, {"type": "subtitle", "time": 6791.83, "timestamp": "01:53:11", "text": "有多远？ 你不用开车去"}, {"type": "subtitle", "time": 6793.35, "timestamp": "01:53:13", "text": "取货吗？"}, {"type": "subtitle", "time": 6799.589, "timestamp": "01:53:19", "text": "我们会加速。 不，我只是开玩笑。 我"}, {"type": "subtitle", "time": 6802.47, "timestamp": "01:53:22", "text": "不会超速。 我会像往常一样平安无事。"}, {"type": "subtitle", "time": 6804.31, "timestamp": "01:53:24", "text": "嗨，"}, {"type": "subtitle", "time": 6812.87, "timestamp": "01:53:32", "text": "我们只需要不断占领据点，"}, {"type": "subtitle", "time": 6815.83, "timestamp": "01:53:35", "text": "而且我们不会走得太远，因为只要有"}, {"type": "subtitle", "time": 6817.91, "timestamp": "01:53:37", "text": "三个人，当有效"}, {"type": "subtitle", "time": 6821.03, "timestamp": "01:53:41", "text": "载荷（"}, {"type": "subtitle", "time": 6833.35, "timestamp": "01:53:53", "text": "知道了。"}, {"type": "subtitle", "time": 6836.07, "timestamp": "01:53:56", "text": "一旦我"}]
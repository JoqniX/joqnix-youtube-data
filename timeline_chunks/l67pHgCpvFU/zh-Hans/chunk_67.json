[{"type": "subtitle", "time": 4027.109, "timestamp": "01:07:07", "text": "决不。 好了，我明白了。 我正在尽"}, {"type": "subtitle", "time": 4063.001, "timestamp": "01:07:43", "text": "死不了。 我们是唯一活着的人。"}, {"type": "subtitle", "time": 4068.71, "timestamp": "01:07:48", "text": "拜托。"}, {"type": "subtitle", "time": 4070.069, "timestamp": "01:07:50", "text": "对不起。"}, {"type": "subtitle", "time": 4071.67, "timestamp": "01:07:51", "text": "我的天啊。 它们结霜了。"}, {"type": "subtitle", "time": 4073.91, "timestamp": "01:07:53", "text": "我想保护你，但他们都在"}, {"type": "subtitle", "time": 4076.101, "timestamp": "01:07:56", "text": "那里。"}]
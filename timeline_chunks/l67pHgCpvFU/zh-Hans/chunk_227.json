[{"type": "subtitle", "time": 13661.189, "timestamp": "03:47:41", "text": "我想我找到我的主角了。 我"}, {"type": "subtitle", "time": 13663.189, "timestamp": "03:47:43", "text": "想念汉索（笑声）。"}, {"type": "subtitle", "time": 13666.229, "timestamp": "03:47:46", "text": "等等，不是汉索。 等等，抱歉。 是《"}, {"type": "subtitle", "time": 13673.67, "timestamp": "03:47:53", "text": "我想念所有的车。"}, {"type": "subtitle", "time": 13675.429, "timestamp": "03:47:55", "text": "好的，让我看看精彩片段。"}]
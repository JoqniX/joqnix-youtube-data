[{"type": "subtitle", "time": 540.23, "timestamp": "00:09:00", "text": "我父亲，你知道，他有点儿……"}, {"type": "subtitle", "time": 543.59, "timestamp": "00:09:03", "text": "但他也有点儿……混蛋。"}, {"type": "subtitle", "time": 545.269, "timestamp": "00:09:05", "text": "看来我们确实有一些共同之处"}, {"type": "subtitle", "time": 547.19, "timestamp": "00:09:07", "text": "。 我觉得我把难度调到了最低，"}, {"type": "subtitle", "time": 555.59, "timestamp": "00:09:15", "text": "战斗还有五、四、三、二、一秒就开始了。"}, {"type": "subtitle", "time": 557.35, "timestamp": "00:09:17", "text": "你必须阻止他们占领"}, {"type": "subtitle", "time": 564.949, "timestamp": "00:09:24", "text": "哇。"}, {"type": "subtitle", "time": 567.881, "timestamp": "00:09:27", "text": "你得杀了"}, {"type": "subtitle", "time": 577.75, "timestamp": "00:09:37", "text": "我们看起来精神抖擞。"}, {"type": "subtitle", "time": 589.03, "timestamp": "00:09:49", "text": "哦，他叫什么名字来着？ 我忘了他的名字，"}, {"type": "subtitle", "time": 591.43, "timestamp": "00:09:51", "text": "但我们只是按照"}, {"type": "subtitle", "time": 593.75, "timestamp": "00:09:53", "text": "医嘱做了标记。"}, {"type": "subtitle", "time": 597.509, "timestamp": "00:09:57", "text": "哦不，我要死了。"}, {"type": "subtitle", "time": 599.75, "timestamp": "00:09:59", "text": "我不会射击。"}]
[{"type": "subtitle", "time": 8101.43, "timestamp": "02:15:01", "text": "代码给你。"}, {"type": "subtitle", "time": 8104.709, "timestamp": "02:15:04", "text": "呃，请提供您的"}, {"type": "subtitle", "time": 8107.91, "timestamp": "02:15:07", "text": "好友代码，就像您点击"}, {"type": "subtitle", "time": 8111.83, "timestamp": "02:15:11", "text": "个人资料时，请提供 ID，"}, {"type": "subtitle", "time": 8114.39, "timestamp": "02:15:14", "text": "以便我们添加您并邀请您加入"}, {"type": "subtitle", "time": 8115.91, "timestamp": "02:15:15", "text": "游戏。   是的"}, {"type": "subtitle", "time": 8121.75, "timestamp": "02:15:21", "text": "你觉得这说得通吗？ 你"}, {"type": "subtitle", "time": 8125.51, "timestamp": "02:15:25", "text": "看得出你脑子有点问题，是吧？"}, {"type": "subtitle", "time": 8129.669, "timestamp": "02:15:29", "text": "好的。 他就像在玩游戏一样，就像在参加比赛一样。"}, {"type": "subtitle", "time": 8133.03, "timestamp": "02:15:33", "text": "好的。 我的天啊。 蠢到家了。"}, {"type": "subtitle", "time": 8135.838, "timestamp": "02:15:35", "text": "不知道该怎么做"}, {"type": "subtitle", "time": 8137.35, "timestamp": "02:15:37", "text": "[笑声]"}, {"type": "subtitle", "time": 8139.43, "timestamp": "02:15:39", "text": "行动迟缓，该死的"}, {"type": "subtitle", "time": 8141.733, "timestamp": "02:15:41", "text": "你不应该说那个词。"}, {"type": "subtitle", "time": 8142.629, "timestamp": "02:15:42", "text": "[笑声]"}, {"type": "subtitle", "time": 8144.87, "timestamp": "02:15:44", "text": "他在直播。"}, {"type": "subtitle", "time": 8149.669, "timestamp": "02:15:49", "text": "嘿，兄弟。 我男人以前是这样的。"}, {"type": "subtitle", "time": 8152.229, "timestamp": "02:15:52", "text": "耶稣。 他好像看不到我以为他"}, {"type": "subtitle", "time": 8154.31, "timestamp": "02:15:54", "text": "在游戏里的样子。 我当时想，好吧，在游戏中，你"}, {"type": "subtitle", "time": 8156.149, "timestamp": "02:15:56", "text": "发送请求，发送一些东西。 感觉就像"}, {"type": "subtitle", "time": 8157.83, "timestamp": "02:15:57", "text": "我在参加比赛一样。 你的语气就像正在玩"}]
[{"type": "subtitle", "time": 6551.75, "timestamp": "01:49:11", "text": "我的工作并非"}, {"type": "subtitle", "time": 6561.43, "timestamp": "01:49:21", "text": "哦，加油！ 我无法治愈我们的"}, {"type": "subtitle", "time": 6562.87, "timestamp": "01:49:22", "text": "奇异博士。"}, {"type": "subtitle", "time": 6566.229, "timestamp": "01:49:26", "text": "我本应该治好他的。"}, {"type": "subtitle", "time": 6568.47, "timestamp": "01:49:28", "text": "他离我太远太远了，我无法"}, {"type": "subtitle", "time": 6578.79, "timestamp": "01:49:38", "text": "啊。"}]
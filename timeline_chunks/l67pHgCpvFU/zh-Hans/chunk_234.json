[{"type": "subtitle", "time": 14057.429, "timestamp": "03:54:17", "text": "你现在被召唤去做什么？ 内马尔。"}, {"type": "subtitle", "time": 14059.59, "timestamp": "03:54:19", "text": "再见。"}, {"type": "subtitle", "time": 14073.429, "timestamp": "03:54:33", "text": "只要确保他们不要"}, {"type": "subtitle", "time": 14089.91, "timestamp": "03:54:49", "text": "他是谁？ 我的天啊，钢铁侠正在"}, {"type": "subtitle", "time": 14091.67, "timestamp": "03:54:51", "text": "康复。"}]
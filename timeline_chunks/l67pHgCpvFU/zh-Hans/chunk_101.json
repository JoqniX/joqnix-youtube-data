[{"type": "subtitle", "time": 6061.109, "timestamp": "01:41:01", "text": "没关系。 我打算"}, {"type": "subtitle", "time": 6069.669, "timestamp": "01:41:09", "text": "我或许受混乱驱使，但我正"}, {"type": "subtitle", "time": 6071.91, "timestamp": "01:41:11", "text": "努力为宇宙带来一丝秩序"}, {"type": "subtitle", "time": 6079.43, "timestamp": "01:41:19", "text": "现在却消失了。"}, {"type": "subtitle", "time": 6080.87, "timestamp": "01:41:20", "text": "这是什么？"}, {"type": "subtitle", "time": 6088.31, "timestamp": "01:41:28", "text": "哦，它切换屏幕了。"}, {"type": "subtitle", "time": 6090.87, "timestamp": "01:41:30", "text": "想象一下，这对兄弟并肩作战，"}, {"type": "subtitle", "time": 6092.87, "timestamp": "01:41:32", "text": "为了世界的命运而"}, {"type": "subtitle", "time": 6094.55, "timestamp": "01:41:34", "text": "战。"}, {"type": "subtitle", "time": 6096.39, "timestamp": "01:41:36", "text": "如果我们那样做呢？"}, {"type": "subtitle", "time": 6099.75, "timestamp": "01:41:39", "text": "现在，这件事正在发生。 虽然和"}, {"type": "subtitle", "time": 6111.189, "timestamp": "01:41:51", "text": "战斗将于 5、4、3、2、1 时开始。"}, {"type": "subtitle", "time": 6112.629, "timestamp": "01:41:52", "text": "你只需要占领"}, {"type": "subtitle", "time": 6115.83, "timestamp": "01:41:55", "text": "任务区域即可。 知道了。"}, {"type": "subtitle", "time": 6118.39, "timestamp": "01:41:58", "text": "这才是墙上真正的男子汉啊"}]
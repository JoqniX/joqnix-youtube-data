[{"type": "subtitle", "time": 5314.07, "timestamp": "01:28:34", "text": "不，"}, {"type": "subtitle", "time": 5315.669, "timestamp": "01:28:35", "text": "我明白了。 我接到你了。"}, {"type": "subtitle", "time": 5317.51, "timestamp": "01:28:37", "text": "我死了。  [笑声]"}, {"type": "subtitle", "time": 5322.229, "timestamp": "01:28:42", "text": "我要输了，摧毁这些武器。"}, {"type": "subtitle", "time": 5326.149, "timestamp": "01:28:46", "text": "我的命运尚未注定。"}, {"type": "subtitle", "time": 5328.629, "timestamp": "01:28:48", "text": "38次击杀。 我的天啊。"}, {"type": "subtitle", "time": 5335.43, "timestamp": "01:28:55", "text": "哦，不。 他们肯定会拿到那东西。"}, {"type": "subtitle", "time": 5339.59, "timestamp": "01:28:59", "text": "我们需要到达“哦，不”那里。 我们还要"}]
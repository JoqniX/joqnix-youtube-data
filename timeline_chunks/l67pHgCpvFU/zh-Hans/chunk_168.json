[{"type": "subtitle", "time": 10085.11, "timestamp": "02:48:05", "text": "哦，对了，我在大厅里的电脑，我"}, {"type": "subtitle", "time": 10088.87, "timestamp": "02:48:08", "text": "把所有设置都没限制，我"}, {"type": "subtitle", "time": 10092.346, "timestamp": "02:48:12", "text": "在大厅里的帧数达到了300，接近400。"}, {"type": "subtitle", "time": 10092.469, "timestamp": "02:48:12", "text": "[笑声]"}, {"type": "subtitle", "time": 10108.721, "timestamp": "02:48:28", "text": "而且你可以随时开始。"}, {"type": "subtitle", "time": 10109.51, "timestamp": "02:48:29", "text": "[笑声]"}, {"type": "subtitle", "time": 10123.99, "timestamp": "02:48:43", "text": "东京挺好的。   无论"}, {"type": "subtitle", "time": 10127.03, "timestamp": "02:48:47", "text": "我身处美国何处，这对我来说都是司空见惯的事情"}]
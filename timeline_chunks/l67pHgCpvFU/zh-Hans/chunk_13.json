[{"type": "subtitle", "time": 782.629, "timestamp": "00:13:02", "text": "我正在试图杀人。  [尖叫声]"}, {"type": "subtitle", "time": 784.069, "timestamp": "00:13:04", "text": "他们撞到检查站了。"}, {"type": "subtitle", "time": 787.43, "timestamp": "00:13:07", "text": "现在或许是阻止他们的更好时机。"}, {"type": "subtitle", "time": 790.31, "timestamp": "00:13:10", "text": "终极目标在哪里？ 哦，Q是什么意思？"}, {"type": "subtitle", "time": 790.629, "timestamp": "00:13:10", "text": "哦，"}, {"type": "subtitle", "time": 793.11, "timestamp": "00:13:13", "text": "我死了。"}, {"type": "subtitle", "time": 803.03, "timestamp": "00:13:23", "text": "我的天啊。 死。 死。"}, {"type": "subtitle", "time": 804.949, "timestamp": "00:13:24", "text": "为什么要引导目标？"}, {"type": "subtitle", "time": 806.71, "timestamp": "00:13:26", "text": "用这支箭不行。"}, {"type": "subtitle", "time": 808.71, "timestamp": "00:13:28", "text": "好的。"}, {"type": "chat", "time": 814.002, "timestamp": "00:13:34", "author": "@bakononcopiumm", "avatar": "https://yt4.ggpht.com/hb5sPAHLUD7fBrZZsmfkzISQWwRqI8BY1n8lceyhZz0sNISomD05pCwUe-GL2amD5y-voH_uYw=s64-c-k-c0x00ffffff-no-rj", "message": "wtf was that"}, {"type": "chat", "time": 817.785, "timestamp": "00:13:37", "author": "@bakononcopiumm", "avatar": "https://yt4.ggpht.com/hb5sPAHLUD7fBrZZsmfkzISQWwRqI8BY1n8lceyhZz0sNISomD05pCwUe-GL2amD5y-voH_uYw=s64-c-k-c0x00ffffff-no-rj", "message": "how did you do that"}, {"type": "subtitle", "time": 818.749, "timestamp": "00:13:38", "text": "我去不了。"}, {"type": "subtitle", "time": 818.87, "timestamp": "00:13:38", "text": "[笑声]"}, {"type": "subtitle", "time": 823.75, "timestamp": "00:13:43", "text": "嘿，至少我的箭筒还颤抖。"}, {"type": "subtitle", "time": 827.35, "timestamp": "00:13:47", "text": "我会扮演星爵。"}, {"type": "subtitle", "time": 829.829, "timestamp": "00:13:49", "text": "我在太空找到了一个家。"}, {"type": "chat", "time": 830.505, "timestamp": "00:13:50", "author": "@TannerHernandez-u9i", "avatar": "https://yt4.ggpht.com/rS3mcXLfYbbeP0EJ-TMgHjDTIugqwSIruRtSjdtZ9RxHyooV3hG_Ig908WUqlL9m_DWxGYPJOg=s64-c-k-c0x00ffffff-no-rj", "message": "I will help you you will be pro"}, {"type": "subtitle", "time": 831.269, "timestamp": "00:13:51", "text": "我会不惜一切代价保护他们的"}, {"type": "subtitle", "time": 832.87, "timestamp": "00:13:52", "text": "安全。"}, {"type": "subtitle", "time": 835.91, "timestamp": "00:13:55", "text": "我来做Star。 我不能。"}, {"type": "subtitle", "time": 839.189, "timestamp": "00:13:59", "text": "我之后会玩《破界》。"}]
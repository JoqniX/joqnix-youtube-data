[{"type": "subtitle", "time": 2342.39, "timestamp": "00:39:02", "text": "我参与了他最后的"}, {"type": "subtitle", "time": 2344.15, "timestamp": "00:39:04", "text": "决战。"}, {"type": "subtitle", "time": 2354.47, "timestamp": "00:39:14", "text": "蜘蛛侠。"}, {"type": "subtitle", "time": 2370.462, "timestamp": "00:39:30", "text": "他在哪儿？"}, {"type": "subtitle", "time": 2378.069, "timestamp": "00:39:38", "text": "蜘蛛侠杀了我，所以我不太清楚"}, {"type": "subtitle", "time": 2382.39, "timestamp": "00:39:42", "text": "他当时在哪里。 别惹他。"}]
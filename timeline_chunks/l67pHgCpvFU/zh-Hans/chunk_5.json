[{"type": "subtitle", "time": 300.31, "timestamp": "00:05:00", "text": "走吧。"}, {"type": "subtitle", "time": 302.71, "timestamp": "00:05:02", "text": "你好。 呃，等等。 我游戏里加你好友了吧"}, {"type": "subtitle", "time": 304.87, "timestamp": "00:05:04", "text": "？ 让我查一下。 你好。"}, {"type": "subtitle", "time": 307.749, "timestamp": "00:05:07", "text": "哦，或许我没看到通知。"}, {"type": "subtitle", "time": 310.15, "timestamp": "00:05:10", "text": "哦，是的，你做到了。 是的。"}, {"type": "subtitle", "time": 312.87, "timestamp": "00:05:12", "text": "你好。 呃，我加入你们的大厅。 哦。 哦，你确实跟我打了"}, {"type": "subtitle", "time": 321.11, "timestamp": "00:05:21", "text": "这款游戏变化很大。 并非"}, {"type": "subtitle", "time": 321.83, "timestamp": "00:05:21", "text": "如此。   是的"}, {"type": "subtitle", "time": 322.87, "timestamp": "00:05:22", "text": "。 是的。"}, {"type": "subtitle", "time": 325.27, "timestamp": "00:05:25", "text": "你好。 由你决定。 好像有"}, {"type": "subtitle", "time": 327.51, "timestamp": "00:05:27", "text": "不同的服务器，所以我不知道"}, {"type": "subtitle", "time": 329.59, "timestamp": "00:05:29", "text": "你是想在东京玩还是在"}, {"type": "subtitle", "time": 330.31, "timestamp": "00:05:30", "text": "其他地方玩。"}, {"type": "subtitle", "time": 332.95, "timestamp": "00:05:32", "text": "哦，什么方法都行。 呃，等等，我想让我"}, {"type": "subtitle", "time": 337.59000000000003, "timestamp": "00:05:37", "text": "加入你们的联盟吧。 等待。"}, {"type": "subtitle", "time": 343.83, "timestamp": "00:05:43", "text": "你好。 游戏运行卡顿。 我的天啊。"}, {"type": "subtitle", "time": 345.909, "timestamp": "00:05:45", "text": "哦（笑声）不。"}, {"type": "subtitle", "time": 348.469, "timestamp": "00:05:48", "text": "你好。 好的。 呃，在我们切换到"}, {"type": "subtitle", "time": 353.67, "timestamp": "00:05:53", "text": "游戏之前，呃，让我断开连接，呃，断开"}, {"type": "subtitle", "time": 356.79, "timestamp": "00:05:56", "text": "连接，呃，等等，在我断开连接之前"}, {"type": "subtitle", "time": 359.909, "timestamp": "00:05:59", "text": "，让我再确认一下。"}]
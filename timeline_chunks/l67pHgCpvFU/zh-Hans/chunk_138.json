[{"type": "subtitle", "time": 8284.15, "timestamp": "02:18:04", "text": "你"}, {"type": "subtitle", "time": 8285.589, "timestamp": "02:18:05", "text": "无法摆脱这个事实。"}, {"type": "subtitle", "time": 8288.469, "timestamp": "02:18:08", "text": "是我错觉吗？感觉好像是"}, {"type": "subtitle", "time": 8290.309, "timestamp": "02:18:10", "text": "我的帧率问题。"}, {"type": "subtitle", "time": 8297.11, "timestamp": "02:18:17", "text": "你的帧率是多少？” 我的帧率"}, {"type": "subtitle", "time": 8299.03, "timestamp": "02:18:19", "text": "达到了最高值。 另一个问题是，我"}, {"type": "subtitle", "time": 8301.03, "timestamp": "02:18:21", "text": "现在没有一台好的显示器。"}, {"type": "subtitle", "time": 8304.23, "timestamp": "02:18:24", "text": "我现在确实有两个显示器。 我"}, {"type": "subtitle", "time": 8306.709, "timestamp": "02:18:26", "text": "想等找到稳定的住处后再买显示器"}, {"type": "subtitle", "time": 8310.549, "timestamp": "02:18:30", "text": "。"}, {"type": "subtitle", "time": 8314.23, "timestamp": "02:18:34", "text": "不知为何，我的数值无法超过 60。"}, {"type": "subtitle", "time": 8320.629, "timestamp": "02:18:40", "text": "晚安。"}, {"type": "subtitle", "time": 8323.83, "timestamp": "02:18:43", "text": "哦，一次击杀。"}, {"type": "subtitle", "time": 8326.709, "timestamp": "02:18:46", "text": "悟空已经腐烂了。 我不知道为什么他们的伤势"}, {"type": "subtitle", "time": 8328.95, "timestamp": "02:18:48", "text": "没有好转。 该死的。 谁是"}, {"type": "subtitle", "time": 8330.709, "timestamp": "02:18:50", "text": "治疗师？ 没有治疗师。"}, {"type": "subtitle", "time": 8331.27, "timestamp": "02:18:51", "text": "我死了。"}, {"type": "subtitle", "time": 8332.95, "timestamp": "02:18:52", "text": "什么鬼？ 为什么？ 他妈的为什么？ 没有"}]
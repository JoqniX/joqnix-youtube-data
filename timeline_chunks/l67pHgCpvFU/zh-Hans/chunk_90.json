[{"type": "subtitle", "time": 5402.629, "timestamp": "01:30:02", "text": "传教士就行了。 知道了。"}, {"type": "subtitle", "time": 5406.149, "timestamp": "01:30:06", "text": "我可以付费赢得这场比赛吗？"}, {"type": "subtitle", "time": 5414.937, "timestamp": "01:30:14", "text": "再见。"}, {"type": "subtitle", "time": 5422.229, "timestamp": "01:30:22", "text": "我们的敌人近在咫尺。 你属于我。"}, {"type": "subtitle", "time": 5423.35, "timestamp": "01:30:23", "text": "在哪里？  WHO？"}, {"type": "subtitle", "time": 5433.99, "timestamp": "01:30:33", "text": "我被吃掉了。"}, {"type": "subtitle", "time": 5435.669, "timestamp": "01:30:35", "text": "不，"}]
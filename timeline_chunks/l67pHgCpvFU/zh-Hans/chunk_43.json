[{"type": "subtitle", "time": 2583.43, "timestamp": "00:43:03", "text": "是的，我觉得我做不到 30 到 60 帧。 我"}, {"type": "subtitle", "time": 2585.75, "timestamp": "00:43:05", "text": "必须做30个。"}, {"type": "subtitle", "time": 2607.51, "timestamp": "00:43:27", "text": "这个蜘蛛侠老是缠着我。"}, {"type": "subtitle", "time": 2611.349, "timestamp": "00:43:31", "text": "兄弟，这太烦人了。"}, {"type": "subtitle", "time": 2613.43, "timestamp": "00:43:33", "text": "蜘蛛侠。"}, {"type": "subtitle", "time": 2615.67, "timestamp": "00:43:35", "text": "他们老是想杀我，真是"}, {"type": "subtitle", "time": 2622.71, "timestamp": "00:43:42", "text": "我无法治愈你，毒液。 你操之过急了"}, {"type": "subtitle", "time": 2631.589, "timestamp": "00:43:51", "text": "我的天哪。"}, {"type": "subtitle", "time": 2636.069, "timestamp": "00:43:56", "text": "[笑声]"}, {"type": "subtitle", "time": 2638.55, "timestamp": "00:43:58", "text": "为什么是“我的天哪”。"}]
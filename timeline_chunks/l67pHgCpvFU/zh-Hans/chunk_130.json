[{"type": "subtitle", "time": 7801.669, "timestamp": "02:10:01", "text": "对了，这是你第一次玩《漫威宿敌》吗？   是的"}, {"type": "subtitle", "time": 7803.35, "timestamp": "02:10:03", "text": "。"}, {"type": "subtitle", "time": 7803.91, "timestamp": "02:10:03", "text": "耶稣。"}, {"type": "subtitle", "time": 7805.43, "timestamp": "02:10:05", "text": "呃，所以你（笑）做了"}, {"type": "subtitle", "time": 7807.669, "timestamp": "02:10:07", "text": "教程之类的东西吗？"}, {"type": "subtitle", "time": 7810.79, "timestamp": "02:10:10", "text": "是的，我做了。"}, {"type": "subtitle", "time": 7813.575, "timestamp": "02:10:13", "text": "我很庆幸我这么做了。 是的。"}, {"type": "subtitle", "time": 7815.51, "timestamp": "02:10:15", "text": "[笑声]"}, {"type": "subtitle", "time": 7819.35, "timestamp": "02:10:19", "text": "好了，就是这样。 我的身份证。   该死的"}, {"type": "subtitle", "time": 7821.91, "timestamp": "02:10:21", "text": "。 我现在不运行"}, {"type": "subtitle", "time": 7824.229, "timestamp": "02:10:24", "text": "命令，因为"}, {"type": "subtitle", "time": 7826.79, "timestamp": "02:10:26", "text": "流媒体现在可能出现故障"}, {"type": "subtitle", "time": 7834.87, "timestamp": "02:10:34", "text": "顺便说一下，命令已经下线了，所以"}, {"type": "subtitle", "time": 7837.669, "timestamp": "02:10:37", "text": "你们都知道了，"}, {"type": "subtitle", "time": 7840.149, "timestamp": "02:10:40", "text": "可以加入我们，但我不知道"}, {"type": "subtitle", "time": 7843.05, "timestamp": "02:10:43", "text": "你们的代码。"}, {"type": "subtitle", "time": 7849.43, "timestamp": "02:10:49", "text": "呃，我不知道该怎么做。"}]
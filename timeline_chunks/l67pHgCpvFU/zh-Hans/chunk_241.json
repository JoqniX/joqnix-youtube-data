[{"type": "subtitle", "time": 14461.11, "timestamp": "04:01:01", "text": "我想玩《Peak》，但我"}, {"type": "subtitle", "time": 14463.269, "timestamp": "04:01:03", "text": "还没有这款游戏。 你知道那是什么游戏吗"}, {"type": "subtitle", "time": 14464.07, "timestamp": "04:01:04", "text": "？"}, {"type": "subtitle", "time": 14466.309, "timestamp": "04:01:06", "text": "H峰？ 是的。"}, {"type": "subtitle", "time": 14468.95, "timestamp": "04:01:08", "text": "没有人需要你去攀登。 我想要玩"}, {"type": "subtitle", "time": 14473.83, "timestamp": "04:01:13", "text": "那个游戏。 没人想玩那个游戏。"}, {"type": "subtitle", "time": 14476.469, "timestamp": "04:01:16", "text": "Be Pik 很不错。"}, {"type": "subtitle", "time": 14478.87, "timestamp": "04:01:18", "text": "他们添加了一些新地图和其他内容。 我没"}, {"type": "subtitle", "time": 14479.59, "timestamp": "04:01:19", "text": "玩过那款游戏。"}, {"type": "subtitle", "time": 14481.11, "timestamp": "04:01:21", "text": "哦，"}, {"type": "subtitle", "time": 14494.63, "timestamp": "04:01:34", "text": "是啊，至少我知道"}, {"type": "subtitle", "time": 14496.63, "timestamp": "04:01:36", "text": "在这个游戏里该选哪个角色了，因为[笑]"}, {"type": "subtitle", "time": 14499.75, "timestamp": "04:01:39", "text": "我玩其他角色太菜了。"}, {"type": "subtitle", "time": 14502.63, "timestamp": "04:01:42", "text": "但现在你知道了。   是的"}, {"type": "subtitle", "time": 14509.11, "timestamp": "04:01:49", "text": "Scarlet Fetch。"}, {"type": "subtitle", "time": 14509.83, "timestamp": "04:01:49", "text": "你好。"}, {"type": "subtitle", "time": 14512.63, "timestamp": "04:01:52", "text": "嗯。 我想"}, {"type": "subtitle", "time": 14514.389, "timestamp": "04:01:54", "text": "今天就到此为止吧。"}, {"type": "subtitle", "time": 14517.349, "timestamp": "04:01:57", "text": "好的。 各位，谢谢"}, {"type": "subtitle", "time": 14519.91, "timestamp": "04:01:59", "text": "收看。 希望你喜欢。"}]
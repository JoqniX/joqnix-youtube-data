[{"type": "subtitle", "time": 10383.269, "timestamp": "02:53:03", "text": "你需要用它的护盾挡住那辆车"}, {"type": "subtitle", "time": 10390.95, "timestamp": "02:53:10", "text": "哦，不。 我的天哪。 他们把我拉了"}, {"type": "subtitle", "time": 10392.15, "timestamp": "02:53:12", "text": "进去。"}, {"type": "subtitle", "time": 10423.125, "timestamp": "02:53:43", "text": "我的命运如今竟成了一场消失的闹剧。"}]
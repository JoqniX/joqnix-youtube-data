[{"type": "subtitle", "time": 8220.87, "timestamp": "02:17:00", "text": "[喘息声]"}, {"type": "subtitle", "time": 8230.309, "timestamp": "02:17:10", "text": "抓住了我的男人。"}, {"type": "subtitle", "time": 8240.629, "timestamp": "02:17:20", "text": "你想玩钢铁侠就玩吧。 妈的。"}, {"type": "subtitle", "time": 8243.429, "timestamp": "02:17:23", "text": "并"}, {"type": "subtitle", "time": 8244.549, "timestamp": "02:17:24", "text": "为这个宇宙找到和平。"}, {"type": "subtitle", "time": 8245.91, "timestamp": "02:17:25", "text": "灵能者很棒。 他们说我从来没"}, {"type": "subtitle", "time": 8249.03, "timestamp": "02:17:29", "text": "真正玩过灵能锁。"}, {"type": "subtitle", "time": 8251.589, "timestamp": "02:17:31", "text": "好的，我选月夜。"}, {"type": "subtitle", "time": 8253.669, "timestamp": "02:17:33", "text": "我们可以改变它，对吧？"}, {"type": "subtitle", "time": 8254.469, "timestamp": "02:17:34", "text": "哦，当然。"}, {"type": "subtitle", "time": 8257.669, "timestamp": "02:17:37", "text": "我是科努之拳，旅行者的守护者"}, {"type": "subtitle", "time": 8258.23, "timestamp": "02:17:38", "text": "。   是的"}, {"type": "subtitle", "time": 8259.91, "timestamp": "02:17:39", "text": "。 你的月光。"}, {"type": "subtitle", "time": 8261.91, "timestamp": "02:17:41", "text": "他还有30秒就到。"}, {"type": "subtitle", "time": 8263.19, "timestamp": "02:17:43", "text": "等等，等等，等等。"}, {"type": "subtitle", "time": 8264.95, "timestamp": "02:17:44", "text": "真是幸运。"}, {"type": "subtitle", "time": 8269.91, "timestamp": "02:17:49", "text": "我可以抬头看看吗？ 好的。"}, {"type": "subtitle", "time": 8271.75, "timestamp": "02:17:51", "text": "如果你需要帮助，不要用错误的方式。 你知道，"}, {"type": "subtitle", "time": 8274.07, "timestamp": "02:17:54", "text": "不要妄下评判"}, {"type": "subtitle", "time": 8274.95, "timestamp": "02:17:54", "text": "。"}, {"type": "subtitle", "time": 8277.429, "timestamp": "02:17:57", "text": "他是个好朋友。 我会等待。 不要让"}]
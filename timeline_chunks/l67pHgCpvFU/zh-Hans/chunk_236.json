[{"type": "subtitle", "time": 14168.71, "timestamp": "03:56:08", "text": "我死了吗？ 我可能会以何种方式死去？"}, {"type": "subtitle", "time": 14182.389, "timestamp": "03:56:22", "text": "奇异博士，"}, {"type": "subtitle", "time": 14189.51, "timestamp": "03:56:29", "text": "再见。"}, {"type": "subtitle", "time": 14191.75, "timestamp": "03:56:31", "text": "我唯一不太喜欢的一点"}, {"type": "subtitle", "time": 14193.59, "timestamp": "03:56:33", "text": "是，当你阵亡后，你必须走"}, {"type": "subtitle", "time": 14197.11, "timestamp": "03:56:37", "text": "很远的路才能回到战场。"}, {"type": "subtitle", "time": 14199.67, "timestamp": "03:56:39", "text": "是的，这张地图只有这一点问题"}, {"type": "subtitle", "time": 14219.269, "timestamp": "03:56:59", "text": "脉冲充能射击。"}]
[{"type": "subtitle", "time": 5820.47, "timestamp": "01:37:00", "text": "战斗倒计时开始：五、四、三、"}, {"type": "subtitle", "time": 5823.03, "timestamp": "01:37:03", "text": "二、一。"}, {"type": "subtitle", "time": 5824.47, "timestamp": "01:37:04", "text": "你只需要占领"}, {"type": "subtitle", "time": 5827.59, "timestamp": "01:37:07", "text": "任务区域即可。 知道了。"}, {"type": "subtitle", "time": 5830.55, "timestamp": "01:37:10", "text": "清理出一条路。 除非你想让我"}, {"type": "subtitle", "time": 5854.87, "timestamp": "01:37:34", "text": "看来现在这项任务就交给你来完成了"}, {"type": "subtitle", "time": 5877.03, "timestamp": "01:37:57", "text": "我死了。"}]
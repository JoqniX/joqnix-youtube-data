[{"type": "subtitle", "time": 3363.19, "timestamp": "00:56:03", "text": "然后你的右键，我记得是可以"}, {"type": "subtitle", "time": 3366.789, "timestamp": "00:56:06", "text": "击退敌人并造成伤害。"}, {"type": "subtitle", "time": 3370.789, "timestamp": "00:56:10", "text": "嗯。 然后，你的小号会吞噬"}, {"type": "subtitle", "time": 3372.95, "timestamp": "00:56:12", "text": "所有人，但你必须在"}, {"type": "subtitle", "time": 3376.39, "timestamp": "00:56:16", "text": "合适的时间这样做，他们在哪里，"}, {"type": "subtitle", "time": 3380.069, "timestamp": "00:56:20", "text": "你什么时候打电话？"}, {"type": "subtitle", "time": 3383.589, "timestamp": "00:56:23", "text": "基本上他们都在你的圈子里。"}, {"type": "subtitle", "time": 3389.51, "timestamp": "00:56:29", "text": "不，没关系。 你可以接受。"}, {"type": "subtitle", "time": 3392.789, "timestamp": "00:56:32", "text": "你背着我。  [笑声]"}, {"type": "subtitle", "time": 3394.549, "timestamp": "00:56:34", "text": "好的。 好的。"}, {"type": "subtitle", "time": 3396.71, "timestamp": "00:56:36", "text": "瞧瞧这只凤凰。"}, {"type": "subtitle", "time": 3398.71, "timestamp": "00:56:38", "text": "哦，这就是凤凰。 好的，我试试"}]
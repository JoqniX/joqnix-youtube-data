[{"type": "subtitle", "time": 5788.39, "timestamp": "01:36:28", "text": "我们身处混乱之中，但我乐于"}, {"type": "subtitle", "time": 5792.55, "timestamp": "01:36:32", "text": "展现出掌控一切的能力。"}, {"type": "subtitle", "time": 5802.55, "timestamp": "01:36:42", "text": "姐姐，我好想你。 您的"}, {"type": "subtitle", "time": 5805.99, "timestamp": "01:36:45", "text": "长矛将非常受欢迎。 埃克斯加德。"}, {"type": "subtitle", "time": 5808.95, "timestamp": "01:36:48", "text": "我最后一次见到父亲时，他非常"}, {"type": "subtitle", "time": 5811.669, "timestamp": "01:36:51", "text": "明确地表示事实并非如此。"}, {"type": "subtitle", "time": 5814.149, "timestamp": "01:36:54", "text": "你没听说吗？ 新国王"}, {"type": "subtitle", "time": 5816.39, "timestamp": "01:36:56", "text": "登基了。"}]
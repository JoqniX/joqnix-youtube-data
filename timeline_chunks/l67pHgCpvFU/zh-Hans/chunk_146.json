[{"type": "subtitle", "time": 8760.79, "timestamp": "02:26:00", "text": "我将停止使用DLSS。 该死的。 我"}, {"type": "subtitle", "time": 8763.429, "timestamp": "02:26:03", "text": "不需要什么RTX之类的东西。"}, {"type": "subtitle", "time": 8767.03, "timestamp": "02:26:07", "text": "你当时穿着那件衣服？ 哇。"}, {"type": "subtitle", "time": 8771.11, "timestamp": "02:26:11", "text": "等等，这就是我崩溃的原因吗？"}, {"type": "subtitle", "time": 8772.95, "timestamp": "02:26:12", "text": "是吗？"}, {"type": "subtitle", "time": 8782.07, "timestamp": "02:26:22", "text": "或许是"}, {"type": "subtitle", "time": 8784.23, "timestamp": "02:26:24", "text": "因为富士的"}, {"type": "subtitle", "time": 8791.429, "timestamp": "02:26:31", "text": "合适的英雄可以改变一切"}, {"type": "subtitle", "time": 8803.91, "timestamp": "02:26:43", "text": "走出阴影。"}, {"type": "subtitle", "time": 8807.27, "timestamp": "02:26:47", "text": "我在想，我应该去当狙击手吗？"}, {"type": "subtitle", "time": 8809.75, "timestamp": "02:26:49", "text": "鹰眼在哪儿？ 好的，我选鹰眼。"}, {"type": "subtitle", "time": 8812.79, "timestamp": "02:26:52", "text": "复仇者联盟也造成了破坏。 顺便一提，呃，"}, {"type": "subtitle", "time": 8816.15, "timestamp": "02:26:56", "text": "你的狙击枪几乎可以一枪爆头任何"}, {"type": "subtitle", "time": 8818.71, "timestamp": "02:26:58", "text": "角色。"}]
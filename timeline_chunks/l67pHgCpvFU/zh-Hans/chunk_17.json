[{"type": "chat", "time": 1021.762, "timestamp": "00:17:01", "author": "@bakononcopiumm", "avatar": "https://yt4.ggpht.com/hb5sPAHLUD7fBrZZsmfkzISQWwRqI8BY1n8lceyhZz0sNISomD05pCwUe-GL2amD5y-voH_uYw=s64-c-k-c0x00ffffff-no-rj", "message": "go winter soldier, show me the asim"}, {"type": "subtitle", "time": 1022.949, "timestamp": "00:17:02", "text": "菲尼克斯。"}, {"type": "chat", "time": 1023.921, "timestamp": "00:17:03", "author": "@bakononcopiumm", "avatar": "https://yt4.ggpht.com/hb5sPAHLUD7fBrZZsmfkzISQWwRqI8BY1n8lceyhZz0sNISomD05pCwUe-GL2amD5y-voH_uYw=s64-c-k-c0x00ffffff-no-rj", "message": "*aim"}, {"type": "subtitle", "time": 1025.189, "timestamp": "00:17:05", "text": "虽然我很确定菲尼克斯被"}, {"type": "subtitle", "time": 1029.029, "timestamp": "00:17:09", "text": "削弱了。 我不记得了。 我不知道。"}, {"type": "subtitle", "time": 1033.27, "timestamp": "00:17:13", "text": "我只是个休闲玩家。"}, {"type": "subtitle", "time": 1036.47, "timestamp": "00:17:16", "text": "冬日战士。 哦，原来"}, {"type": "subtitle", "time": 1040.39, "timestamp": "00:17:20", "text": "是他！ 哦，冬日战士。 哦，是这个"}, {"type": "subtitle", "time": 1041.189, "timestamp": "00:17:21", "text": "。"}, {"type": "subtitle", "time": 1043.669, "timestamp": "00:17:23", "text": "我不是任何人的跟班。 我做的事"}, {"type": "subtitle", "time": 1045.909, "timestamp": "00:17:25", "text": "最好独自完成。  《冬日战士》是一款"}, {"type": "subtitle", "time": 1050.87, "timestamp": "00:17:30", "text": "相当简单的游戏，或者说是一个相当容易"}, {"type": "subtitle", "time": 1052.31, "timestamp": "00:17:32", "text": "上手的角色。"}, {"type": "subtitle", "time": 1056.63, "timestamp": "00:17:36", "text": "那我试试《美国队长2：冬日战士》。"}, {"type": "subtitle", "time": 1060.07, "timestamp": "00:17:40", "text": "它说会有很多新角色。"}, {"type": "subtitle", "time": 1068.31, "timestamp": "00:17:48", "text": "只要还有希望，"}]
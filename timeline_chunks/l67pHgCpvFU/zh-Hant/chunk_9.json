[{"type": "subtitle", "time": 540.23, "timestamp": "00:09:00", "text": "我父親，你知道，他有點兒……"}, {"type": "subtitle", "time": 543.59, "timestamp": "00:09:03", "text": "但他也有點……混蛋。"}, {"type": "subtitle", "time": 545.269, "timestamp": "00:09:05", "text": "看來我們確實有一些共同點"}, {"type": "subtitle", "time": 547.19, "timestamp": "00:09:07", "text": "。我覺得我把難度調到了最低，"}, {"type": "subtitle", "time": 555.59, "timestamp": "00:09:15", "text": "戰鬥還有五、四、三、二、一秒就開始了。"}, {"type": "subtitle", "time": 557.35, "timestamp": "00:09:17", "text": "你必須阻止他們佔領"}, {"type": "subtitle", "time": 564.949, "timestamp": "00:09:24", "text": "哇。"}, {"type": "subtitle", "time": 567.881, "timestamp": "00:09:27", "text": "你得殺了他"}, {"type": "subtitle", "time": 577.75, "timestamp": "00:09:37", "text": "我們看起來精神抖擻。"}, {"type": "subtitle", "time": 589.03, "timestamp": "00:09:49", "text": "哦，他叫什麼名字來著？我忘了他的名字，"}, {"type": "subtitle", "time": 591.43, "timestamp": "00:09:51", "text": "但我們只是照"}, {"type": "subtitle", "time": 593.75, "timestamp": "00:09:53", "text": "醫囑做了標記。"}, {"type": "subtitle", "time": 597.509, "timestamp": "00:09:57", "text": "哦不，我要死了。"}, {"type": "subtitle", "time": 599.75, "timestamp": "00:09:59", "text": "我不會射擊。"}]
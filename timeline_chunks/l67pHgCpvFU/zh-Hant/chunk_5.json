[{"type": "subtitle", "time": 300.31, "timestamp": "00:05:00", "text": "走吧。"}, {"type": "subtitle", "time": 302.71, "timestamp": "00:05:02", "text": "你好。呃，等等。我遊戲裡加你好友了吧"}, {"type": "subtitle", "time": 304.87, "timestamp": "00:05:04", "text": "？讓我查一下。你好。"}, {"type": "subtitle", "time": 307.749, "timestamp": "00:05:07", "text": "哦，或許我沒看到通知。"}, {"type": "subtitle", "time": 310.15, "timestamp": "00:05:10", "text": "哦，是的，你做到了。是的。  你好。"}, {"type": "subtitle", "time": 312.87, "timestamp": "00:05:12", "text": "呃，我加入你們的大廳。哦。哦，你確實跟我打了個"}, {"type": "subtitle", "time": 321.11, "timestamp": "00:05:21", "text": "這款遊戲變化很大。並非"}, {"type": "subtitle", "time": 321.83, "timestamp": "00:05:21", "text": "如此。  是的。是的。  你好。由"}, {"type": "subtitle", "time": 325.27, "timestamp": "00:05:25", "text": "你決定。"}, {"type": "subtitle", "time": 327.51, "timestamp": "00:05:27", "text": "好像有不同的伺服器，所以我不知道"}, {"type": "subtitle", "time": 329.59, "timestamp": "00:05:29", "text": "你是想在東京玩還是在其他地方玩"}, {"type": "subtitle", "time": 330.31, "timestamp": "00:05:30", "text": "。"}, {"type": "subtitle", "time": 332.95, "timestamp": "00:05:32", "text": "哦，什麼方法都行。呃，等等，我想讓我"}, {"type": "subtitle", "time": 337.59000000000003, "timestamp": "00:05:37", "text": "加入你們的聯盟。等待。  你好。  你好"}, {"type": "subtitle", "time": 343.83, "timestamp": "00:05:43", "text": "。遊戲運行卡頓。我的天啊。"}, {"type": "subtitle", "time": 345.909, "timestamp": "00:05:45", "text": "哦（笑聲）不。"}, {"type": "subtitle", "time": 348.469, "timestamp": "00:05:48", "text": "你好。好的。呃，在我們切換到"}, {"type": "subtitle", "time": 353.67, "timestamp": "00:05:53", "text": "遊戲之前，呃，讓我斷開連接，呃，斷開連接，"}, {"type": "subtitle", "time": 356.79, "timestamp": "00:05:56", "text": "呃，等等，在我斷開連接之前"}, {"type": "subtitle", "time": 359.909, "timestamp": "00:05:59", "text": "，讓我再確認一下。  大家"}]
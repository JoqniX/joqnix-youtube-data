[{"type": "subtitle", "time": 1570.39, "timestamp": "00:26:10", "text": "看看毒液。他正在橫衝直撞"}, {"type": "subtitle", "time": 1572.87, "timestamp": "00:26:12", "text": "。"}, {"type": "subtitle", "time": 1595.11, "timestamp": "00:26:35", "text": "，等等。什麼？發生了什麼事？"}, {"type": "subtitle", "time": 1596.4, "timestamp": "00:26:36", "text": "發生了什麼事？ 喬說：「你做得太過分了。」喬。  我的天啊。"}]
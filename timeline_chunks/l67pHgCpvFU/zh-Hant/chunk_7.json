[{"type": "subtitle", "time": 422.469, "timestamp": "00:07:02", "text": "電腦崩潰，因為會有"}, {"type": "subtitle", "time": 424.55, "timestamp": "00:07:04", "text": "一大堆殭屍追著你跑，"}, {"type": "subtitle", "time": 426.309, "timestamp": "00:07:06", "text": "你必須把它們都殺死。"}, {"type": "subtitle", "time": 427.189, "timestamp": "00:07:07", "text": "我的天啊。"}, {"type": "subtitle", "time": 429.67, "timestamp": "00:07:09", "text": "有點像《決勝時刻》的殭屍模式。"}, {"type": "subtitle", "time": 429.99, "timestamp": "00:07:09", "text": "哦，"}, {"type": "subtitle", "time": 432.07, "timestamp": "00:07:12", "text": "但是它們一直在不斷繁殖。"}, {"type": "subtitle", "time": 435.749, "timestamp": "00:07:15", "text": "我們也可以試試。是的。"}, {"type": "subtitle", "time": 438.95, "timestamp": "00:07:18", "text": "等待。糟糕。為什麼我會這樣？哦，等等。你是"}, {"type": "subtitle", "time": 442.79, "timestamp": "00:07:22", "text": "北美伺服器的Oreon伺服器嗎？哦"}, {"type": "subtitle", "time": 445.51, "timestamp": "00:07:25", "text": "，你可以選擇它。好的。哦，"}, {"type": "subtitle", "time": 447.67, "timestamp": "00:07:27", "text": "這太酷了。他們有一些"}, {"type": "subtitle", "time": 450.23, "timestamp": "00:07:30", "text": "不同的服務。"}, {"type": "subtitle", "time": 452.39, "timestamp": "00:07:32", "text": "是的。我不太想玩"}, {"type": "subtitle", "time": 455.27, "timestamp": "00:07:35", "text": "殭屍模式，所以遊戲卡頓很嚴重。"}, {"type": "subtitle", "time": 457.99, "timestamp": "00:07:37", "text": "然後我們就可以做正常的了。"}, {"type": "subtitle", "time": 459.27, "timestamp": "00:07:39", "text": "哦，太好了。"}, {"type": "subtitle", "time": 465.67, "timestamp": "00:07:45", "text": "因為我們中間隔著東京，所以我們選擇在東京伺服器玩"}, {"type": "subtitle", "time": 473.83, "timestamp": "00:07:53", "text": "你用的是哪個字元？"}, {"type": "subtitle", "time": 474.55, "timestamp": "00:07:54", "text": "H，"}, {"type": "subtitle", "time": 477.43, "timestamp": "00:07:57", "text": "你在我的世界裡用的是哪個角色"}, {"type": "subtitle", "time": 479.189, "timestamp": "00:07:59", "text": "？你玩這個遊戲嗎？"}]
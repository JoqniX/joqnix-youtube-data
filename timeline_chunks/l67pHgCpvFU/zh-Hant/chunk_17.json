[{"type": "chat", "time": 1021.762, "timestamp": "00:17:01", "author": "@bakononcopiumm", "avatar": "https://yt4.ggpht.com/hb5sPAHLUD7fBrZZsmfkzISQWwRqI8BY1n8lceyhZz0sNISomD05pCwUe-GL2amD5y-voH_uYw=s64-c-k-c0x00ffffff-no-rj", "message": "go winter soldier, show me the asim"}, {"type": "subtitle", "time": 1022.949, "timestamp": "00:17:02", "text": "菲尼克斯。"}, {"type": "chat", "time": 1023.921, "timestamp": "00:17:03", "author": "@bakononcopiumm", "avatar": "https://yt4.ggpht.com/hb5sPAHLUD7fBrZZsmfkzISQWwRqI8BY1n8lceyhZz0sNISomD05pCwUe-GL2amD5y-voH_uYw=s64-c-k-c0x00ffffff-no-rj", "message": "*aim"}, {"type": "subtitle", "time": 1025.189, "timestamp": "00:17:05", "text": "雖然我很確定菲尼克斯被"}, {"type": "subtitle", "time": 1029.029, "timestamp": "00:17:09", "text": "削弱了。我不記得了。我不知道。"}, {"type": "subtitle", "time": 1033.27, "timestamp": "00:17:13", "text": "我只是個休閒玩家。"}, {"type": "subtitle", "time": 1036.47, "timestamp": "00:17:16", "text": "冬日戰士。哦，原來"}, {"type": "subtitle", "time": 1040.39, "timestamp": "00:17:20", "text": "是他！哦，冬日戰士。哦，是這個"}, {"type": "subtitle", "time": 1041.189, "timestamp": "00:17:21", "text": "。"}, {"type": "subtitle", "time": 1043.669, "timestamp": "00:17:23", "text": "我不是任何人的跟班。我做的事"}, {"type": "subtitle", "time": 1045.909, "timestamp": "00:17:25", "text": "最好是獨自完成。 《冬日戰士》是一款"}, {"type": "subtitle", "time": 1050.87, "timestamp": "00:17:30", "text": "相當簡單的遊戲，或者說是相當容易"}, {"type": "subtitle", "time": 1052.31, "timestamp": "00:17:32", "text": "上手的角色。  那"}, {"type": "subtitle", "time": 1056.63, "timestamp": "00:17:36", "text": "我試試《美國隊長2：酷寒戰士》。"}, {"type": "subtitle", "time": 1060.07, "timestamp": "00:17:40", "text": "它說會有很多新角色。"}, {"type": "subtitle", "time": 1068.31, "timestamp": "00:17:48", "text": "只要還有希望，"}]
[{"type": "subtitle", "time": 1621.51, "timestamp": "00:27:01", "text": "呃，彈藥算嗎？  這是什麼章魚？  呃，"}, {"type": "subtitle", "time": 1623.75, "timestamp": "00:27:03", "text": "我拿到10個人頭了。"}, {"type": "subtitle", "time": 1647.99, "timestamp": "00:27:27", "text": "[笑聲]"}, {"type": "subtitle", "time": 1655.669, "timestamp": "00:27:35", "text": "哦，這太搞笑了。"}, {"type": "subtitle", "time": 1658.71, "timestamp": "00:27:38", "text": "或許會減少死亡人數。鋼鐵人。好的。  呃，我推了一下"}]
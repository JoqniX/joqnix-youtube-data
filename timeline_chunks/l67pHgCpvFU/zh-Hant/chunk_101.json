[{"type": "subtitle", "time": 6069.669, "timestamp": "01:41:09", "text": "魔法留給"}, {"type": "subtitle", "time": 6079.43, "timestamp": "01:41:19", "text": "如今正在消失。  我仍然希望你在我身後。  啊，我要把角色換成"}, {"type": "subtitle", "time": 6088.31, "timestamp": "01:41:28", "text": "呃，我想試試雷神。  再見。  我的天啊。  《超凡蜘蛛人》真是一團糟。  我嘗試"}, {"type": "subtitle", "time": 6112.629, "timestamp": "01:41:52", "text": "取得控制"}, {"type": "subtitle", "time": 6115.83, "timestamp": "01:41:55", "text": "權。  我的天啊，我死了。  我接到你了。  呃，或許我們應該組隊。  是的，我們應該這麼做。"}]
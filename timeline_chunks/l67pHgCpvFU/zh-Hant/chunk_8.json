[{"type": "subtitle", "time": 480.71, "timestamp": "00:08:00", "text": "我扮演傑夫。"}, {"type": "subtitle", "time": 482.469, "timestamp": "00:08:02", "text": "合適的英雄可以改變一切"}, {"type": "subtitle", "time": 483.43, "timestamp": "00:08:03", "text": "。"}, {"type": "subtitle", "time": 485.189, "timestamp": "00:08:05", "text": "傑菲。"}, {"type": "subtitle", "time": 487.029, "timestamp": "00:08:07", "text": "嗯，"}, {"type": "subtitle", "time": 490.71, "timestamp": "00:08:10", "text": "一日復仇者，終身復仇者。"}, {"type": "subtitle", "time": 503.11, "timestamp": "00:08:23", "text": "我不知道這個遊戲的操作方法。"}, {"type": "subtitle", "time": 507.43, "timestamp": "00:08:27", "text": "喔不，就像"}, {"type": "subtitle", "time": 509.749, "timestamp": "00:08:29", "text": "哦，這裡有個英雄。好的。  簡歷沒問題"}, {"type": "subtitle", "time": 522.55, "timestamp": "00:08:42", "text": "我認為我被選中是為了給世界帶來一些好處"}, {"type": "subtitle", "time": 527.11, "timestamp": "00:08:47", "text": "他還有30秒就到。"}, {"type": "subtitle", "time": 527.67, "timestamp": "00:08:47", "text": "堅強點。"}, {"type": "subtitle", "time": 531.269, "timestamp": "00:08:51", "text": "看著我。我在騎他。  只有擁有"}, {"type": "subtitle", "time": 537.096, "timestamp": "00:08:57", "text": "皇室血統的人才能被稱為「領主」。"}, {"type": "subtitle", "time": 538.23, "timestamp": "00:08:58", "text": "[音樂]"}]
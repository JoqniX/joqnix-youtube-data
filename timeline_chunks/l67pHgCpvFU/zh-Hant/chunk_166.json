[{"type": "subtitle", "time": 9990.82, "timestamp": "02:46:30", "text": "。 [笑聲] [尖叫"}, {"type": "subtitle", "time": 9992.15, "timestamp": "02:46:32", "text": "聲] 馬上回來。  他沒事吧？  還有人會說「我的"}, {"type": "subtitle", "time": 9995.405, "timestamp": "02:46:35", "text": "天哪，我剛剛死了」。  暫別了。"}, {"type": "subtitle", "time": 9995.91, "timestamp": "02:46:35", "text": "[笑聲] [尖叫聲] 馬上回來"}]
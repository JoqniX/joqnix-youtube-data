[{"type": "subtitle", "time": 782.629, "timestamp": "00:13:02", "text": "我正在試圖殺人。 [尖叫聲]"}, {"type": "subtitle", "time": 784.069, "timestamp": "00:13:04", "text": "他們撞到檢查站了。"}, {"type": "subtitle", "time": 787.43, "timestamp": "00:13:07", "text": "現在或許是阻止他們的更好時機。"}, {"type": "subtitle", "time": 790.31, "timestamp": "00:13:10", "text": "終極目標在哪裡？哦，Q是什麼意思？"}, {"type": "subtitle", "time": 790.629, "timestamp": "00:13:10", "text": "哦，"}, {"type": "subtitle", "time": 793.11, "timestamp": "00:13:13", "text": "我死了。"}, {"type": "subtitle", "time": 803.03, "timestamp": "00:13:23", "text": "天啊。死。死。"}, {"type": "subtitle", "time": 804.949, "timestamp": "00:13:24", "text": "為什麼要引導目標？"}, {"type": "subtitle", "time": 806.71, "timestamp": "00:13:26", "text": "用這支箭不行。"}, {"type": "subtitle", "time": 808.71, "timestamp": "00:13:28", "text": "好的。"}, {"type": "chat", "time": 814.002, "timestamp": "00:13:34", "author": "@bakononcopiumm", "avatar": "https://yt4.ggpht.com/hb5sPAHLUD7fBrZZsmfkzISQWwRqI8BY1n8lceyhZz0sNISomD05pCwUe-GL2amD5y-voH_uYw=s64-c-k-c0x00ffffff-no-rj", "message": "wtf was that"}, {"type": "chat", "time": 817.785, "timestamp": "00:13:37", "author": "@bakononcopiumm", "avatar": "https://yt4.ggpht.com/hb5sPAHLUD7fBrZZsmfkzISQWwRqI8BY1n8lceyhZz0sNISomD05pCwUe-GL2amD5y-voH_uYw=s64-c-k-c0x00ffffff-no-rj", "message": "how did you do that"}, {"type": "subtitle", "time": 818.749, "timestamp": "00:13:38", "text": "我去不了。"}, {"type": "subtitle", "time": 818.87, "timestamp": "00:13:38", "text": "[笑聲]"}, {"type": "subtitle", "time": 823.75, "timestamp": "00:13:43", "text": "嘿，至少我的箭筒還顫抖。  我會"}, {"type": "subtitle", "time": 827.35, "timestamp": "00:13:47", "text": "扮演星爵。"}, {"type": "subtitle", "time": 829.829, "timestamp": "00:13:49", "text": "我在太空找到了一個家。"}, {"type": "chat", "time": 830.505, "timestamp": "00:13:50", "author": "@TannerHernandez-u9i", "avatar": "https://yt4.ggpht.com/rS3mcXLfYbbeP0EJ-TMgHjDTIugqwSIruRtSjdtZ9RxHyooV3hG_Ig908WUqlL9m_DWxGYPJOg=s64-c-k-c0x00ffffff-no-rj", "message": "I will help you you will be pro"}, {"type": "subtitle", "time": 831.269, "timestamp": "00:13:51", "text": "我會不惜一切代價保護他們的"}, {"type": "subtitle", "time": 832.87, "timestamp": "00:13:52", "text": "安全。"}, {"type": "subtitle", "time": 835.91, "timestamp": "00:13:55", "text": "我來做Star。我不能。"}, {"type": "subtitle", "time": 839.189, "timestamp": "00:13:59", "text": "我之後會玩《破界》。"}]
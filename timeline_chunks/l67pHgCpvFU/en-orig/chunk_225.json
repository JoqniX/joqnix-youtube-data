[{"type": "subtitle", "time": 13505.03, "timestamp": "03:45:05", "text": ">> By the eye of Agamoto."}, {"type": "subtitle", "time": 13533.11, "timestamp": "03:45:33", "text": ">> Will not be erased again."}, {"type": "subtitle", "time": 13533.91, "timestamp": "03:45:33", "text": ">> I got you."}, {"type": "subtitle", "time": 13534.63, "timestamp": "03:45:34", "text": ">> Goodbye."}, {"type": "subtitle", "time": 13541.11, "timestamp": "03:45:41", "text": ">> That's it. Don't let anything stand in"}]
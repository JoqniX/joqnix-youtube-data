[{"type": "subtitle", "time": 6061.109, "timestamp": "01:41:01", "text": "大丈夫。"}, {"type": "subtitle", "time": 6069.669, "timestamp": "01:41:09", "text": "私は混沌に突き動かされているのかもしれないが、"}, {"type": "subtitle", "time": 6079.43, "timestamp": "01:41:19", "text": "今や姿を消した。"}, {"type": "subtitle", "time": 6080.87, "timestamp": "01:41:20", "text": "これは何ですか？"}, {"type": "subtitle", "time": 6088.31, "timestamp": "01:41:28", "text": "ああ、画面が切り替わるんだ。"}, {"type": "subtitle", "time": 6090.87, "timestamp": "01:41:30", "text": "この兄弟が、王国の運命をかけて、彼らと肩を並べて戦う姿を想像してみてください"}, {"type": "subtitle", "time": 6094.55, "timestamp": "01:41:34", "text": "。   もし"}, {"type": "subtitle", "time": 6096.39, "timestamp": "01:41:36", "text": "私たちがそうしたとしたら？"}, {"type": "subtitle", "time": 6099.75, "timestamp": "01:41:39", "text": "今、それが現実になっている。 しかし、それは"}, {"type": "subtitle", "time": 6111.189, "timestamp": "01:41:51", "text": "戦闘開始まで5、4、3、2、1秒。"}, {"type": "subtitle", "time": 6112.629, "timestamp": "01:41:52", "text": "君がやるべきことは、"}, {"type": "subtitle", "time": 6115.83, "timestamp": "01:41:55", "text": "ミッションエリアを占領することだけだ。 わかった。"}, {"type": "subtitle", "time": 6118.39, "timestamp": "01:41:58", "text": "これはまさに壁の上の本物の男だ"}]
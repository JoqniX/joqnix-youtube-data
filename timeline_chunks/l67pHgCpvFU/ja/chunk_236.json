[{"type": "subtitle", "time": 14168.71, "timestamp": "03:56:08", "text": "私は死んだのか？ 私はどのように死ぬ可能性があるだろうか？"}, {"type": "subtitle", "time": 14182.389, "timestamp": "03:56:22", "text": "ドクター・ストレンジが"}, {"type": "subtitle", "time": 14189.51, "timestamp": "03:56:29", "text": "さようなら。"}, {"type": "subtitle", "time": 14191.75, "timestamp": "03:56:31", "text": "このゲームで唯一ちょっと嫌なのは、"}, {"type": "subtitle", "time": 14193.59, "timestamp": "03:56:33", "text": "死んだ時に"}, {"type": "subtitle", "time": 14197.11, "timestamp": "03:56:37", "text": "戦場に戻るのにすごく歩かなきゃいけないところだ。"}, {"type": "subtitle", "time": 14199.67, "timestamp": "03:56:39", "text": "ええ、この地図について言えることはそれだけです"}, {"type": "subtitle", "time": 14219.269, "timestamp": "03:56:59", "text": "パルスチャージ発射。   ちなみに、それは"}]
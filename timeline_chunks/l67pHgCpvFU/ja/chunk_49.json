[{"type": "subtitle", "time": 2944.903, "timestamp": "00:49:04", "text": "ジョーン、あまり遠くまで行かないで。"}, {"type": "subtitle", "time": 2945.589, "timestamp": "00:49:05", "text": "[笑い]"}, {"type": "subtitle", "time": 2950.143, "timestamp": "00:49:10", "text": "待って、私は生きている。 ああ、わかりました。 ありがとう。"}, {"type": "subtitle", "time": 2959.04, "timestamp": "00:49:19", "text": "。 私はただ飛び回っているだけです。"}, {"type": "subtitle", "time": 2965.109, "timestamp": "00:49:25", "text": "彼らが円の中にいる限り、"}, {"type": "subtitle", "time": 2979.43, "timestamp": "00:49:39", "text": "あれはジェフですか？ 何てことだ。 もう少し"}, {"type": "subtitle", "time": 2984.204, "timestamp": "00:49:44", "text": "元気を出せますか？ ほら、私は役に立つ人間でしょう？"}, {"type": "subtitle", "time": 2984.79, "timestamp": "00:49:44", "text": "[笑い] 自分が何をしているのか分から"}, {"type": "chat", "time": 2991.18, "timestamp": "00:49:51", "author": "@bakononcopiumm", "avatar": "https://yt4.ggpht.com/hb5sPAHLUD7fBrZZsmfkzISQWwRqI8BY1n8lceyhZz0sNISomD05pCwUe-GL2amD5y-voH_uYw=s64-c-k-c0x00ffffff-no-rj", "message": "happy nnn btw"}]
[{"type": "subtitle", "time": 5046.167, "timestamp": "01:24:06", "text": "いや、いや、いや、いや、いや、いや、いや。"}, {"type": "subtitle", "time": 5046.79, "timestamp": "01:24:06", "text": "[笑い声と息を呑む音]"}, {"type": "subtitle", "time": 5049.43, "timestamp": "01:24:09", "text": "ああ、元気が出た。 ありがとう。"}, {"type": "subtitle", "time": 5052.229, "timestamp": "01:24:12", "text": "さようなら。 背中を掻いてくれよ。"}, {"type": "subtitle", "time": 5073.678, "timestamp": "01:24:33", "text": "[叫び声]"}, {"type": "subtitle", "time": 5075.11, "timestamp": "01:24:35", "text": "[泣き声]"}, {"type": "subtitle", "time": 5091.35, "timestamp": "01:24:51", "text": "いいえ。"}, {"type": "subtitle", "time": 5095.43, "timestamp": "01:24:55", "text": "ああ、彼らは私の必殺技をブロックしました。"}]
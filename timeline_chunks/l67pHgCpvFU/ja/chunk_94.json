[{"type": "subtitle", "time": 5652.229, "timestamp": "01:34:12", "text": "ああ、これは長いハイライトですね。 わあ、"}, {"type": "subtitle", "time": 5655.325, "timestamp": "01:34:15", "text": "そうだね。 ああ、そうだね。"}, {"type": "subtitle", "time": 5662.55, "timestamp": "01:34:22", "text": "君はクワッドを手に入れたんだね。 そんなこと、全く知らなかった。"}, {"type": "subtitle", "time": 5664.31, "timestamp": "01:34:24", "text": "私はしませんでした。"}, {"type": "subtitle", "time": 5673.43, "timestamp": "01:34:33", "text": "私も自分のハイライトを見たいです。"}]
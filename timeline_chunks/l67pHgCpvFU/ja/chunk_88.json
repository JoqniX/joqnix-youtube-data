[{"type": "subtitle", "time": 5314.07, "timestamp": "01:28:34", "text": "いいえ。"}, {"type": "subtitle", "time": 5315.669, "timestamp": "01:28:35", "text": "私が守ります。 見つけた。"}, {"type": "subtitle", "time": 5317.51, "timestamp": "01:28:37", "text": "私は死んだ。  [笑い]"}, {"type": "subtitle", "time": 5322.229, "timestamp": "01:28:42", "text": "私は負けている、これらの腕を破壊します。"}, {"type": "subtitle", "time": 5326.149, "timestamp": "01:28:46", "text": "私の運命はまだ決まっていない。"}, {"type": "subtitle", "time": 5328.629, "timestamp": "01:28:48", "text": "38キル。 何てことだ。"}, {"type": "subtitle", "time": 5335.43, "timestamp": "01:28:55", "text": "いや。 彼らはそれを手に入れるだろう。   ああ、まずい。"}]
[{"type": "subtitle", "time": 4682.229, "timestamp": "01:18:02", "text": "ええ、うちのチームはそれに対して攻撃を仕掛ける必要があります。"}, {"type": "subtitle", "time": 4685.914, "timestamp": "01:18:05", "text": "だから、君と私がモイを攻撃するんだ。"}, {"type": "subtitle", "time": 4711.03, "timestamp": "01:18:31", "text": "正しいのか本当にはわかりません。   私"}, {"type": "subtitle", "time": 4714.149, "timestamp": "01:18:34", "text": "と取引した方が得策でしょう。"}, {"type": "subtitle", "time": 4717.59, "timestamp": "01:18:37", "text": "ああ、これは"}, {"type": "subtitle", "time": 4729.99, "timestamp": "01:18:49", "text": "君がやるべきことは、"}, {"type": "subtitle", "time": 4733.27, "timestamp": "01:18:53", "text": "ミッションを制圧することだけだ。 わかった。   全くの役立たずだ"}, {"type": "subtitle", "time": 4735.75, "timestamp": "01:18:55", "text": "。 これは"}]
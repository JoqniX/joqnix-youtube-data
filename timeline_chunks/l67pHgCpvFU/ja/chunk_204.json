[{"type": "subtitle", "time": 12263.429, "timestamp": "03:24:23", "text": "、ジェフ。 計画はあるが、"}, {"type": "subtitle", "time": 12265.349, "timestamp": "03:24:25", "text": "完璧なタイミングと極めて高い"}, {"type": "subtitle", "time": 12268.15, "timestamp": "03:24:28", "text": "精度が求められる。"}, {"type": "subtitle", "time": 12270.229, "timestamp": "03:24:30", "text": "ああ、冗談だよ。 あなたがすべきことは、"}, {"type": "subtitle", "time": 12272.55, "timestamp": "03:24:32", "text": "全員を家に飲み込むことだけです。 わかった。"}, {"type": "subtitle", "time": 12278.55, "timestamp": "03:24:38", "text": "私は"}, {"type": "subtitle", "time": 12280.79, "timestamp": "03:24:40", "text": "このキャラクターとジェフのやり取りが大好きです。"}, {"type": "subtitle", "time": 12291.91, "timestamp": "03:24:51", "text": "これはガーディアンズ・オブ・"}]
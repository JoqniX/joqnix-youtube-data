[{"type": "subtitle", "time": 3854.71, "timestamp": "01:04:14", "text": "彼らに渡さないでください、さもないと"}, {"type": "subtitle", "time": 3857.029, "timestamp": "01:04:17", "text": "。   まあ"}, {"type": "subtitle", "time": 3859.589, "timestamp": "01:04:19", "text": "、正直に言おう。 癒す。 私たちのヒーラーたちは、もう二度と"}, {"type": "subtitle", "time": 3865.67, "timestamp": "01:04:25", "text": "。"}, {"type": "subtitle", "time": 3868.39, "timestamp": "01:04:28", "text": "まあ、すべての試合に勝つことは期待できないし、負けることだってある"}, {"type": "subtitle", "time": 3888.39, "timestamp": "01:04:48", "text": "プレイできなかったので、それは望んでいません。"}, {"type": "subtitle", "time": 3899.109, "timestamp": "01:04:59", "text": "でも君はレベル21だよ。[笑い] すごいね。"}]
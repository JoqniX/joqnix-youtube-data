[{"type": "subtitle", "time": 5820.47, "timestamp": "01:37:00", "text": "戦闘開始まで、5、4、3、2、1"}, {"type": "subtitle", "time": 5823.03, "timestamp": "01:37:03", "text": "。"}, {"type": "subtitle", "time": 5824.47, "timestamp": "01:37:04", "text": "あなたがすべきことは、"}, {"type": "subtitle", "time": 5827.59, "timestamp": "01:37:07", "text": "任務エリアを占領することだけです。 わかった。"}, {"type": "subtitle", "time": 5830.55, "timestamp": "01:37:10", "text": "道を開けてください。 あなたが私のせいで"}, {"type": "subtitle", "time": 5854.87, "timestamp": "01:37:34", "text": "君がこの任務を"}, {"type": "subtitle", "time": 5877.03, "timestamp": "01:37:57", "text": "私は死んだ。"}]
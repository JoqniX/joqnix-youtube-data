[{"type": "subtitle", "time": 6384.55, "timestamp": "01:46:24", "text": "マッチメイキングは、"}, {"type": "subtitle", "time": 6389.109, "timestamp": "01:46:29", "text": "時々とても速いのですが、時々とても遅いです。   まだ"}, {"type": "subtitle", "time": 6397.109, "timestamp": "01:46:37", "text": "電話がかかってきて、"}, {"type": "subtitle", "time": 6399.189, "timestamp": "01:46:39", "text": "行かなきゃいけなくなったのかと思ったよ。"}, {"type": "subtitle", "time": 6401.59, "timestamp": "01:46:41", "text": "ああ、誰かが持って行ってしまった。"}, {"type": "subtitle", "time": 6403.75, "timestamp": "01:46:43", "text": "うん、彼らは"}, {"type": "subtitle", "time": 6405.75, "timestamp": "01:46:45", "text": "スカーレットの上位ランクだと思うよ。"}, {"type": "subtitle", "time": 6408.39, "timestamp": "01:46:48", "text": "肌の色からしてそう見える。"}, {"type": "subtitle", "time": 6410.39, "timestamp": "01:46:50", "text": "ああ、"}, {"type": "subtitle", "time": 6413.51, "timestamp": "01:46:53", "text": "アルロンは何をしているの？   わから"}]
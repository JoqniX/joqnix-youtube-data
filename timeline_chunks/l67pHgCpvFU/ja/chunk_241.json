[{"type": "subtitle", "time": 14461.11, "timestamp": "04:01:01", "text": "Peakをプレイしたいのですが、まだ"}, {"type": "subtitle", "time": 14463.269, "timestamp": "04:01:03", "text": "ゲームを持っていません。 そのゲームを知っていますか"}, {"type": "subtitle", "time": 14464.07, "timestamp": "04:01:04", "text": "？"}, {"type": "subtitle", "time": 14466.309, "timestamp": "04:01:06", "text": "Hピーク？ はい。"}, {"type": "subtitle", "time": 14468.95, "timestamp": "04:01:08", "text": "登らなければならない相手は誰もいない。"}, {"type": "subtitle", "time": 14473.83, "timestamp": "04:01:13", "text": "そのゲームが欲しい。 そんなゲーム、誰もやりたがらないよ。"}, {"type": "subtitle", "time": 14476.469, "timestamp": "04:01:16", "text": "Be Pikはいいよ。"}, {"type": "subtitle", "time": 14478.87, "timestamp": "04:01:18", "text": "新しいマップなどが追加されました。 私はそれを"}, {"type": "subtitle", "time": 14479.59, "timestamp": "04:01:19", "text": "プレイしたことがありません。"}, {"type": "subtitle", "time": 14481.11, "timestamp": "04:01:21", "text": "ああ、"}, {"type": "subtitle", "time": 14494.63, "timestamp": "04:01:34", "text": "うん、少なくともこのゲームではどのキャラクターを選べばいいかはわかってるよ。だって"}, {"type": "subtitle", "time": 14496.63, "timestamp": "04:01:36", "text": "（笑）"}, {"type": "subtitle", "time": 14499.75, "timestamp": "04:01:39", "text": "他のゲームは全然ダメだったからね。"}, {"type": "subtitle", "time": 14502.63, "timestamp": "04:01:42", "text": "でも、これであなたは知ったわけですね。"}, {"type": "subtitle", "time": 14509.11, "timestamp": "04:01:49", "text": "スカーレット・フェッチです。"}, {"type": "subtitle", "time": 14509.83, "timestamp": "04:01:49", "text": "こんにちは。"}, {"type": "subtitle", "time": 14512.63, "timestamp": "04:01:52", "text": "うん。"}, {"type": "subtitle", "time": 14514.389, "timestamp": "04:01:54", "text": "今日もそろそろ終わりにしようと思います。   よし"}, {"type": "subtitle", "time": 14517.349, "timestamp": "04:01:57", "text": "。 それでは皆さん、ご"}, {"type": "subtitle", "time": 14519.91, "timestamp": "04:01:59", "text": "視聴ありがとうございました。 楽しんでいただけたなら幸いです。 そして、"}]
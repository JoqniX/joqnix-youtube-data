[{"type": "subtitle", "time": 13684.469, "timestamp": "03:48:04", "text": "究極だと思う。 私のハイライト。"}, {"type": "subtitle", "time": 13688.338, "timestamp": "03:48:08", "text": "ああ、それは究極だ。"}, {"type": "subtitle", "time": 13689.349, "timestamp": "03:48:09", "text": "[叫び声]"}, {"type": "subtitle", "time": 13703.99, "timestamp": "03:48:23", "text": "[笑い]"}, {"type": "subtitle", "time": 13721.03, "timestamp": "03:48:41", "text": "ニース。"}, {"type": "subtitle", "time": 13724.79, "timestamp": "03:48:44", "text": "クアッドキル。 ニース。   もうエースは出せ"}, {"type": "subtitle", "time": 13727.51, "timestamp": "03:48:47", "text": "ない。"}]
[{"type": "subtitle", "time": 9121.75, "timestamp": "02:32:01", "text": "ちなみに、ドクター・ストレンジは料理をしていません。"}, {"type": "subtitle", "time": 9124.79, "timestamp": "02:32:04", "text": "私はしくじった。"}, {"type": "subtitle", "time": 9129.349, "timestamp": "02:32:09", "text": "まだ彼らを阻止するチャンスはある。"}, {"type": "subtitle", "time": 9138.87, "timestamp": "02:32:18", "text": "おお。"}, {"type": "subtitle", "time": 9140.55, "timestamp": "02:32:20", "text": "くそ。"}, {"type": "subtitle", "time": 9142.07, "timestamp": "02:32:22", "text": "強くありなさい。 彼らはこれを永遠に続けることはできない"}, {"type": "subtitle", "time": 9151.19, "timestamp": "02:32:31", "text": "私は決して外さない。"}, {"type": "subtitle", "time": 9152.95, "timestamp": "02:32:32", "text": "イエス。"}, {"type": "subtitle", "time": 9161.91, "timestamp": "02:32:41", "text": "セクシーなお尻をしているだけです。  3キル。 どうですか"}, {"type": "subtitle", "time": 9170.87, "timestamp": "02:32:50", "text": "お前はただ、自分のクソ野郎の中でキルを盗む方法を知っていればいいだけだ"}, {"type": "subtitle", "time": 9172.79, "timestamp": "02:32:52", "text": "。"}, {"type": "subtitle", "time": 9173.51, "timestamp": "02:32:53", "text": "はい、わかりました。"}, {"type": "subtitle", "time": 9174.95, "timestamp": "02:32:54", "text": "敵は我々の目の前にいる。   一体"}, {"type": "subtitle", "time": 9178.389, "timestamp": "02:32:58", "text": "どこにいるんだ？"}]
[{"type": "subtitle", "time": 11767.19, "timestamp": "03:16:07", "text": "勝つだろうしね。 私の"}, {"type": "subtitle", "time": 11769.75, "timestamp": "03:16:09", "text": "運命はまだ決まっていない。 忽然と姿を消す"}, {"type": "subtitle", "time": 11785.99, "timestamp": "03:16:25", "text": "あいつらは今にも俺たちを撃とうとしている。"}, {"type": "subtitle", "time": 11797.99, "timestamp": "03:16:37", "text": "[叫び声]"}, {"type": "subtitle", "time": 11798.229, "timestamp": "03:16:38", "text": "ああ、"}, {"type": "subtitle", "time": 11799.75, "timestamp": "03:16:39", "text": "リス、"}]
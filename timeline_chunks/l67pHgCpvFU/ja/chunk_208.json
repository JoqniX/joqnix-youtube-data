[{"type": "subtitle", "time": 12481.83, "timestamp": "03:28:01", "text": "これは誰ですか？"}, {"type": "subtitle", "time": 12506.15, "timestamp": "03:28:26", "text": "わあ、たくさんの功績ですね。"}, {"type": "subtitle", "time": 12514.07, "timestamp": "03:28:34", "text": "時間の流れを考えていると思った。   今日は"}, {"type": "subtitle", "time": 12517.269, "timestamp": "03:28:37", "text": "どんな一日でしたか？ レッドブルは熱い。   良い"}, {"type": "subtitle", "time": 12521.51, "timestamp": "03:28:41", "text": "日曜日をお過ごしでしょうか。"}, {"type": "subtitle", "time": 12525.51, "timestamp": "03:28:45", "text": "待って、そちらでは今日は日曜日ですか？"}, {"type": "subtitle", "time": 12529.19, "timestamp": "03:28:49", "text": "いいえ、"}, {"type": "subtitle", "time": 12533.269, "timestamp": "03:28:53", "text": "この世界ではまだ土曜日です。 しかし、それは確かに役に立つ。"}]
[{"type": "subtitle", "time": 6423.43, "timestamp": "01:47:03", "text": "燃え盛るエネルギービーム。 火事を引き寄せるのはひどい"}, {"type": "subtitle", "time": 6441.91, "timestamp": "01:47:21", "text": "攻撃開始の30秒前。 準備してください。"}, {"type": "subtitle", "time": 6444.629, "timestamp": "01:47:24", "text": "強化。"}, {"type": "subtitle", "time": 6447.189, "timestamp": "01:47:27", "text": "星界でさえ、"}, {"type": "subtitle", "time": 6449.03, "timestamp": "01:47:29", "text": "時間の絡み合いによって引き裂かれてしまう。"}, {"type": "subtitle", "time": 6449.91, "timestamp": "01:47:29", "text": "それは"}, {"type": "subtitle", "time": 6452.149, "timestamp": "01:47:32", "text": "彼らを再び結びつけるのでしょうか？ あなたと私。"}, {"type": "subtitle", "time": 6453.51, "timestamp": "01:47:33", "text": "あなたの楽観主義が好きです。"}, {"type": "subtitle", "time": 6455.43, "timestamp": "01:47:35", "text": "ああ、それは癒しだ。 ああ、それは治癒"}, {"type": "subtitle", "time": 6458.149, "timestamp": "01:47:38", "text": "能力ですね。 ああ、"}, {"type": "subtitle", "time": 6466.55, "timestamp": "01:47:46", "text": "4"}, {"type": "subtitle", "time": 6469.109, "timestamp": "01:47:49", "text": "2 1."}, {"type": "subtitle", "time": 6470.47, "timestamp": "01:47:50", "text": "あなたがすべきことは、"}, {"type": "subtitle", "time": 6473.75, "timestamp": "01:47:53", "text": "ミッションエリアを占領することだけです。 わかった。"}, {"type": "subtitle", "time": 6476.149, "timestamp": "01:47:56", "text": "あなた方は皆、"}]
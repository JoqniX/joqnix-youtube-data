[{"type": "subtitle", "time": 2342.39, "timestamp": "00:39:02", "text": "私は彼の最終"}, {"type": "subtitle", "time": 2344.15, "timestamp": "00:39:04", "text": "決戦に足を踏み入れた。   また来たよ"}, {"type": "subtitle", "time": 2354.47, "timestamp": "00:39:14", "text": "スパイダーマン。"}, {"type": "subtitle", "time": 2370.462, "timestamp": "00:39:30", "text": "彼はどこにいるの？"}, {"type": "subtitle", "time": 2378.069, "timestamp": "00:39:38", "text": "スパイダーマンに殺されたので、"}, {"type": "subtitle", "time": 2382.39, "timestamp": "00:39:42", "text": "彼がどこにいたのかよく分かりません。 彼にちょっかいを出さないで。"}]
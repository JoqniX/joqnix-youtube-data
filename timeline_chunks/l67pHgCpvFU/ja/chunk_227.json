[{"type": "subtitle", "time": 13661.189, "timestamp": "03:47:41", "text": "主人公を見つけたと思う。 懐かしいな"}, {"type": "subtitle", "time": 13663.189, "timestamp": "03:47:43", "text": "（笑）でも、ハンソが懐かしい。"}, {"type": "subtitle", "time": 13666.229, "timestamp": "03:47:46", "text": "待て、ハンソじゃない。 待って、すみません。 オーバー"}, {"type": "subtitle", "time": 13673.67, "timestamp": "03:47:53", "text": "私は全ての車が恋しい。"}, {"type": "subtitle", "time": 13675.429, "timestamp": "03:47:55", "text": "よし、ハイライトを見せてくれ。"}]
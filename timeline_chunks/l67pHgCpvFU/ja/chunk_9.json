[{"type": "subtitle", "time": 540.23, "timestamp": "00:09:00", "text": "私の父は、まあ、ある意味、"}, {"type": "subtitle", "time": 543.59, "timestamp": "00:09:03", "text": "でも、ある意味では大きなジャンクでもありました。   ということは、"}, {"type": "subtitle", "time": 545.269, "timestamp": "00:09:05", "text": "私たちには"}, {"type": "subtitle", "time": 547.19, "timestamp": "00:09:07", "text": "何か共通点があるようだ。"}, {"type": "subtitle", "time": 555.59, "timestamp": "00:09:15", "text": "戦闘開始まであと5、4、3、2、1で、最低設定になっていると思います。敵が"}, {"type": "subtitle", "time": 564.949, "timestamp": "00:09:24", "text": "おお。"}, {"type": "subtitle", "time": 567.881, "timestamp": "00:09:27", "text": "殺さなきゃいけない"}, {"type": "subtitle", "time": 577.75, "timestamp": "00:09:37", "text": "私たちはとても格好良く見えます。"}, {"type": "subtitle", "time": 589.03, "timestamp": "00:09:49", "text": "ああ、彼の名前は何でしたっけ？ 彼の名前は忘れてしまったが、"}, {"type": "subtitle", "time": 591.43, "timestamp": "00:09:51", "text": "私たちはただ"}, {"type": "subtitle", "time": 593.75, "timestamp": "00:09:53", "text": "医師の指示に従っているだけだ。   ああ"}, {"type": "subtitle", "time": 597.509, "timestamp": "00:09:57", "text": "、私は死ぬんだ。"}, {"type": "subtitle", "time": 599.75, "timestamp": "00:09:59", "text": "私は撃てません。"}]
[{"type": "subtitle", "time": 7622.229, "timestamp": "02:07:02", "text": "そこには何もありませんでした。 なぜ操作できないのですか"}, {"type": "subtitle", "time": 7644.149, "timestamp": "02:07:24", "text": "待って、どうして彼女とやり取りできないの？"}, {"type": "subtitle", "time": 7664.47, "timestamp": "02:07:44", "text": "えっと、トリミングした方がいいかもしれません。"}, {"type": "subtitle", "time": 7668.39, "timestamp": "02:07:48", "text": "よし、とりあえずこれを見てくれ。 後で刈り戻します"}, {"type": "subtitle", "time": 7671.109, "timestamp": "02:07:51", "text": "。"}, {"type": "subtitle", "time": 7675.43, "timestamp": "02:07:55", "text": "これは本当に奇妙だ。 明らか。"}]
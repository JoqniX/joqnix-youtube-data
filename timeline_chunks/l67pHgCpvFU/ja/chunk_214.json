[{"type": "subtitle", "time": 12842.71, "timestamp": "03:34:02", "text": "同じことが言えたらいいのですが。 父さん、"}, {"type": "subtitle", "time": 12845.19, "timestamp": "03:34:05", "text": "あなたは真のミュータントではないかもしれません。"}, {"type": "subtitle", "time": 12847.67, "timestamp": "03:34:07", "text": "なんでもっと早くヘラをプレイしなかったの？ さっきは"}, {"type": "subtitle", "time": 12851.238, "timestamp": "03:34:11", "text": "すごくいいプレーしてたよ。"}, {"type": "subtitle", "time": 12869.91, "timestamp": "03:34:29", "text": "ドクター・デューンズにとっては朝飯前だ。"}, {"type": "subtitle", "time": 12871.269, "timestamp": "03:34:31", "text": "ドクター・デューンズは二人いる。"}, {"type": "subtitle", "time": 12871.83, "timestamp": "03:34:31", "text": "ドクター・ドゥームが二人"}, {"type": "subtitle", "time": 12877.83, "timestamp": "03:34:37", "text": "我々の"}, {"type": "subtitle", "time": 12892.309, "timestamp": "03:34:52", "text": "任務区域は今や君たちのものだ。占領せよ。"}]
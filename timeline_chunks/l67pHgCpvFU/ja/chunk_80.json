[{"type": "subtitle", "time": 4811.43, "timestamp": "01:20:11", "text": "このキャラクター、うまく演じられていると思う"}, {"type": "subtitle", "time": 4813.99, "timestamp": "01:20:13", "text": "。 その方が簡単だ。"}, {"type": "subtitle", "time": 4819.535, "timestamp": "01:20:19", "text": "そこで奴らのヒールを潰してやろう。 いいヒーラーが死んだ。"}, {"type": "subtitle", "time": 4821.43, "timestamp": "01:20:21", "text": "[叫び声]"}, {"type": "subtitle", "time": 4824.87, "timestamp": "01:20:24", "text": "混沌を受け入れろ。"}, {"type": "subtitle", "time": 4837.83, "timestamp": "01:20:37", "text": "待って、この人って吸血鬼の人じゃない？"}, {"type": "subtitle", "time": 4840.47, "timestamp": "01:20:40", "text": "吸血鬼ハンターの男。 あの男。 待て、彼も"}, {"type": "subtitle", "time": 4858.55, "timestamp": "01:20:58", "text": "ああ、神様、私は死にそうです。"}, {"type": "subtitle", "time": 4858.709, "timestamp": "01:20:58", "text": "ああ、"}]
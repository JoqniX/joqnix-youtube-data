[{"type": "subtitle", "time": 8580.87, "timestamp": "02:23:00", "text": "待てよ、毎回毎回ゲームがクラッシュする。"}, {"type": "subtitle", "time": 8582.15, "timestamp": "02:23:02", "text": "ああ、ゲームがクラッシュした。 時間はどれくらいありますか"}, {"type": "subtitle", "time": 8583.91, "timestamp": "02:23:03", "text": "？ うん。 うん。 うん。"}, {"type": "subtitle", "time": 8588.309, "timestamp": "02:23:08", "text": "私は6個持っています。え、32個？"}, {"type": "subtitle", "time": 8589.429, "timestamp": "02:23:09", "text": "32でしたか？"}, {"type": "subtitle", "time": 8590.79, "timestamp": "02:23:10", "text": "待って。 えっと、待って、待って、待って。"}, {"type": "subtitle", "time": 8591.75, "timestamp": "02:23:11", "text": "確認してみます。"}, {"type": "subtitle", "time": 8593.75, "timestamp": "02:23:13", "text": "RAMは32GBですか？ それは正気の沙汰ではない。"}, {"type": "subtitle", "time": 8601.83, "timestamp": "02:23:21", "text": "64. 64 GP RAM。"}, {"type": "subtitle", "time": 8604.389, "timestamp": "02:23:24", "text": "ああ、64か。そっちの方がずっとクレイジーだ。 私の"}, {"type": "subtitle", "time": 8605.67, "timestamp": "02:23:25", "text": "ミスです。"}, {"type": "subtitle", "time": 8608.87, "timestamp": "02:23:28", "text": "配信用PCとしてだけ使っていたのですが、本当に"}, {"type": "subtitle", "time": 8613.339, "timestamp": "02:23:33", "text": "面倒でした。 今でもそうではないというわけではない。"}, {"type": "subtitle", "time": 8613.99, "timestamp": "02:23:33", "text": "[笑い] だから、あんなにひどい目に遭っても、"}, {"type": "subtitle", "time": 8615.59, "timestamp": "02:23:35", "text": "墜落しないんだよ"}, {"type": "subtitle", "time": 8618.389, "timestamp": "02:23:38", "text": "。   それは、"}, {"type": "subtitle", "time": 8622.95, "timestamp": "02:23:42", "text": "CPU使用率が100%ということでしょうか。   なんてこった。"}, {"type": "subtitle", "time": 8624.63, "timestamp": "02:23:44", "text": "RAMが必要です。 控えめな感じ。"}, {"type": "subtitle", "time": 8627.03, "timestamp": "02:23:47", "text": "RAMが必要です。   もっと性能の"}, {"type": "subtitle", "time": 8635.67, "timestamp": "02:23:55", "text": "それについてはよく分かりません。"}]
[{"type": "subtitle", "time": 13080.63, "timestamp": "03:38:00", "text": "私はフライドポテトを揚げます。"}, {"type": "subtitle", "time": 13086.07, "timestamp": "03:38:06", "text": "それは良い知らせですね。"}, {"type": "subtitle", "time": 13086.71, "timestamp": "03:38:06", "text": "うん。"}, {"type": "subtitle", "time": 13091.349, "timestamp": "03:38:11", "text": "私を殺し続けた。"}, {"type": "subtitle", "time": 13112.95, "timestamp": "03:38:32", "text": "水分補給をしっかりするように心がけています。"}, {"type": "subtitle", "time": 13116.469, "timestamp": "03:38:36", "text": "こんにちは。 ありがとう。"}]
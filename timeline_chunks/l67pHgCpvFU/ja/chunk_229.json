[{"type": "subtitle", "time": 13747.67, "timestamp": "03:49:07", "text": "よし、これが最後の試合だと思う。"}, {"type": "subtitle", "time": 13756.07, "timestamp": "03:49:16", "text": "違いを生むんです。"}, {"type": "subtitle", "time": 13795.429, "timestamp": "03:49:55", "text": "私は、混沌によってあらゆる現実が飲み込まれていく様を目の当たりにしてきた"}, {"type": "subtitle", "time": 13796.389, "timestamp": "03:49:56", "text": "。"}, {"type": "subtitle", "time": 13798.469, "timestamp": "03:49:58", "text": "30秒後に来るよ。"}]
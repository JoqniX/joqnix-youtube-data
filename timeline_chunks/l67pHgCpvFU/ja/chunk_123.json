[{"type": "subtitle", "time": 7388.95, "timestamp": "02:03:08", "text": "ああ、お腹が空いた。  [笑い]"}, {"type": "subtitle", "time": 7391.51, "timestamp": "02:03:11", "text": "あのねえ、あのね？ えっと、"}, {"type": "subtitle", "time": 7394.229, "timestamp": "02:03:14", "text": "何か食べてきます。 それまでに、フアンは戻ってくるよね"}, {"type": "subtitle", "time": 7419.43, "timestamp": "02:03:39", "text": "通貨の種類が多すぎる。 何に使われていたのかさえ分からない"}]
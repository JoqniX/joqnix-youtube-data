[{"type": "subtitle", "time": 6902.07, "timestamp": "01:55:02", "text": "おお。 ああ、それは良くないですね。 それは"}, {"type": "subtitle", "time": 6918.95, "timestamp": "01:55:18", "text": "もし同点の場合、"}, {"type": "subtitle", "time": 6921.109, "timestamp": "01:55:21", "text": "ユイが勝つと思う。  [息を呑む] わかった"}, {"type": "subtitle", "time": 6937.589, "timestamp": "01:55:37", "text": "エマは私が死んだら「私の赤ちゃん」って本当に言ったの"}, {"type": "subtitle", "time": 6944.87, "timestamp": "01:55:44", "text": "。"}, {"type": "subtitle", "time": 6959.99, "timestamp": "01:55:59", "text": "保護を受け入れよう。"}]
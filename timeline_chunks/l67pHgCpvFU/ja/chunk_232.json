[{"type": "subtitle", "time": 13921.51, "timestamp": "03:52:01", "text": "。 だから、"}, {"type": "subtitle", "time": 13924.63, "timestamp": "03:52:04", "text": "大丈夫だよ。"}, {"type": "subtitle", "time": 13942.07, "timestamp": "03:52:22", "text": "ああ、大変だ、後退しないといけない"}, {"type": "subtitle", "time": 13951.67, "timestamp": "03:52:31", "text": "今度は同じ過ちは繰り返さない。 忽然と姿を"}, {"type": "subtitle", "time": 13966.716, "timestamp": "03:52:46", "text": "今では姿を消す芸人だ。  [笑い声]"}]
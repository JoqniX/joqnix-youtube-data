[{"type": "subtitle", "time": 9065.349, "timestamp": "02:31:05", "text": "逃げ出さなきゃ。"}, {"type": "subtitle", "time": 9067.349, "timestamp": "02:31:07", "text": "ニース。 ニース。 癒し手は誰ですか？ 彼は"}, {"type": "subtitle", "time": 9070.469, "timestamp": "02:31:10", "text": "私たちをうまく癒してくれている。"}, {"type": "subtitle", "time": 9077.11, "timestamp": "02:31:17", "text": "一つ手に入れた。"}, {"type": "subtitle", "time": 9079.75, "timestamp": "02:31:19", "text": "ああ、神様。 走る。   まさに"}, {"type": "subtitle", "time": 9081.03, "timestamp": "02:31:21", "text": "求めていたものだ。 陽子"}, {"type": "subtitle", "time": 9082.55, "timestamp": "02:31:22", "text": "で一口食べると、そういうことが起こるんです"}, {"type": "subtitle", "time": 9085.429, "timestamp": "02:31:25", "text": "。"}, {"type": "subtitle", "time": 9087.27, "timestamp": "02:31:27", "text": "うん。 ジョー、ゲーム楽しんでる？"}, {"type": "subtitle", "time": 9088.07, "timestamp": "02:31:28", "text": "はい。   とても、"}, {"type": "subtitle", "time": 9090.55, "timestamp": "02:31:30", "text": "とても集中力が必要です。   それほど"}, {"type": "subtitle", "time": 9092.07, "timestamp": "02:31:32", "text": "大変なことではないけれど、"}, {"type": "subtitle", "time": 9093.91, "timestamp": "02:31:33", "text": "あなたのやっていることは素晴らしいと思います。 ああ、くそ。"}, {"type": "subtitle", "time": 9096.389, "timestamp": "02:31:36", "text": "テオレの背後にいるのは誰ですか？"}, {"type": "subtitle", "time": 9117.03, "timestamp": "02:31:57", "text": "ああ、"}, {"type": "subtitle", "time": 9118.63, "timestamp": "02:31:58", "text": "ドクター・ストレンジは料理をしていません。"}]
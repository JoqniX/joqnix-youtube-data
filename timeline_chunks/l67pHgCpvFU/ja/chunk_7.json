[{"type": "subtitle", "time": 422.469, "timestamp": "00:07:02", "text": "コンピューターがクラッシュしてしまうから"}, {"type": "subtitle", "time": 426.309, "timestamp": "00:07:06", "text": "。   何てことだ"}, {"type": "subtitle", "time": 427.189, "timestamp": "00:07:07", "text": "。   まるで"}, {"type": "subtitle", "time": 429.67, "timestamp": "00:07:09", "text": "コールオブデューティのゾンビモードみたいだ。"}, {"type": "subtitle", "time": 429.99, "timestamp": "00:07:09", "text": "ああ、"}, {"type": "subtitle", "time": 432.07, "timestamp": "00:07:12", "text": "でも奴らは次から次へと湧いてくるんだ。"}, {"type": "subtitle", "time": 435.749, "timestamp": "00:07:15", "text": "それも試してみてもいいかもしれませんね。 うん。"}, {"type": "subtitle", "time": 438.95, "timestamp": "00:07:18", "text": "待って。 あらら。 なぜ私はああ、待って。 あなたは"}, {"type": "subtitle", "time": 442.79, "timestamp": "00:07:22", "text": "Oreonの北米サーバーユーザーですか？ ああ、"}, {"type": "subtitle", "time": 445.51, "timestamp": "00:07:25", "text": "あなたはそれを選択できます。 わかった。 おお、"}, {"type": "subtitle", "time": 447.67, "timestamp": "00:07:27", "text": "これはすごい。 彼らは"}, {"type": "subtitle", "time": 450.23, "timestamp": "00:07:30", "text": "別のサービスを提供しています。"}, {"type": "subtitle", "time": 452.39, "timestamp": "00:07:32", "text": "うん。"}, {"type": "subtitle", "time": 455.27, "timestamp": "00:07:35", "text": "ゾンビモードはあまりやりたくないので、すごくラグが発生します。"}, {"type": "subtitle", "time": 457.99, "timestamp": "00:07:37", "text": "それなら、通常の方法でやってみましょう。"}, {"type": "subtitle", "time": 459.27, "timestamp": "00:07:39", "text": "ああ、やったー。"}, {"type": "subtitle", "time": 465.67, "timestamp": "00:07:45", "text": "私たちは東京サーバーでプレイしています。なぜなら、そこが私たちの中間地点だからです"}, {"type": "subtitle", "time": 473.83, "timestamp": "00:07:53", "text": "あなたはどのキャラクターを使っていますか？"}, {"type": "subtitle", "time": 477.43, "timestamp": "00:07:57", "text": "私の世界ではどのキャラクターを使っていますか"}, {"type": "subtitle", "time": 479.189, "timestamp": "00:07:59", "text": "？ あなたはプレイしますか？"}]
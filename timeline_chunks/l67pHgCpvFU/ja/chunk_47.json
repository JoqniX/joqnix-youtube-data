[{"type": "subtitle", "time": 2827.349, "timestamp": "00:47:07", "text": "ああ、入るんだ。"}, {"type": "subtitle", "time": 2841.99, "timestamp": "00:47:21", "text": "これは新しい地図ですか？ こんなの見たことない"}, {"type": "subtitle", "time": 2842.47, "timestamp": "00:47:22", "text": "。   よくわかりません"}, {"type": "subtitle", "time": 2855.43, "timestamp": "00:47:35", "text": "悪役を選んでください。 私は批判しているわけではありません。   わかった"}, {"type": "subtitle", "time": 2856.95, "timestamp": "00:47:36", "text": "。"}, {"type": "subtitle", "time": 2860.15, "timestamp": "00:47:40", "text": "私がスパイダーマンになったらどうなるの？ あれは"}, {"type": "subtitle", "time": 2867.27, "timestamp": "00:47:47", "text": "私はすでに"}, {"type": "subtitle", "time": 2869.51, "timestamp": "00:47:49", "text": "登録済みの人だった"}, {"type": "subtitle", "time": 2870.39, "timestamp": "00:47:50", "text": "。"}, {"type": "subtitle", "time": 2870.95, "timestamp": "00:47:50", "text": "ああ、じゃあ"}, {"type": "subtitle", "time": 2875.51, "timestamp": "00:47:55", "text": "スパイダーマンになって"}]
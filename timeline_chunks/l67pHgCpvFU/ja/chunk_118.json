[{"type": "subtitle", "time": 7083.669, "timestamp": "01:58:03", "text": "あ、待って。 我々が勝っている。"}, {"type": "subtitle", "time": 7085.589, "timestamp": "01:58:05", "text": "私たちはそうしました。"}, {"type": "subtitle", "time": 7086.149, "timestamp": "01:58:06", "text": "いえ、そうではありません。"}, {"type": "subtitle", "time": 7089.589, "timestamp": "01:58:09", "text": "いいえ、していません。 わかったよ、ユイ。"}, {"type": "subtitle", "time": 7090.229, "timestamp": "01:58:10", "text": "こんにちは。  [笑い声] どうぞ入って"}, {"type": "subtitle", "time": 7093.27, "timestamp": "01:58:13", "text": "。どうぞ入って。"}, {"type": "subtitle", "time": 7102.47, "timestamp": "01:58:22", "text": "でも、技術的には、戻ってきたらプレイできます"}, {"type": "subtitle", "time": 7105.189, "timestamp": "01:58:25", "text": "。 もっと"}, {"type": "subtitle", "time": 7107.51, "timestamp": "01:58:27", "text": "遊びたいなら。"}, {"type": "subtitle", "time": 7113.92, "timestamp": "01:58:33", "text": "。 準備してください。"}, {"type": "subtitle", "time": 7125.51, "timestamp": "01:58:45", "text": "彼らは神々"}, {"type": "subtitle", "time": 7127.35, "timestamp": "01:58:47", "text": "自身と戦っているのだ。"}, {"type": "subtitle", "time": 7129.99, "timestamp": "01:58:49", "text": "時々、まるで自分が独身で、"}, {"type": "chat", "time": 7131.847, "timestamp": "01:58:51", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "holy"}, {"type": "subtitle", "time": 7132.31, "timestamp": "01:58:52", "text": "混乱を遠ざけているような気分になる。"}, {"type": "subtitle", "time": 7135.43, "timestamp": "01:58:55", "text": "私はジェフィー役です。 しかし、ついにその時が来たのかもしれない"}, {"type": "subtitle", "time": 7135.91, "timestamp": "01:58:55", "text": "。"}]
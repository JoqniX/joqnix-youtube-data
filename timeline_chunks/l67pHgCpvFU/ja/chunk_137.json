[{"type": "subtitle", "time": 8220.87, "timestamp": "02:17:00", "text": "[息を呑む]"}, {"type": "subtitle", "time": 8230.309, "timestamp": "02:17:10", "text": "私の男を奪ったとき。   わかった"}, {"type": "subtitle", "time": 8240.629, "timestamp": "02:17:20", "text": "アイアンマンをプレイしたいなら、プレイすればいいよ。 ああ、くそ。"}, {"type": "subtitle", "time": 8243.429, "timestamp": "02:17:23", "text": "そして、"}, {"type": "subtitle", "time": 8244.549, "timestamp": "02:17:24", "text": "この宇宙に平和を見出す。"}, {"type": "subtitle", "time": 8245.91, "timestamp": "02:17:25", "text": "サイロックは良い。"}, {"type": "subtitle", "time": 8249.03, "timestamp": "02:17:29", "text": "でも、私がサイロックをちゃんとプレイしたことがないって言われるんだよね。"}, {"type": "subtitle", "time": 8251.589, "timestamp": "02:17:31", "text": "よし、ムーンナイトにしよう。"}, {"type": "subtitle", "time": 8253.669, "timestamp": "02:17:33", "text": "私たちはそれを変えることができるでしょう？"}, {"type": "subtitle", "time": 8254.469, "timestamp": "02:17:34", "text": "ああ、もちろんです。"}, {"type": "subtitle", "time": 8257.669, "timestamp": "02:17:37", "text": "私はコヌの拳、"}, {"type": "subtitle", "time": 8258.23, "timestamp": "02:17:38", "text": "旅人たちの守護者だ。"}, {"type": "subtitle", "time": 8259.91, "timestamp": "02:17:39", "text": "うん。 あなたの月光。"}, {"type": "subtitle", "time": 8261.91, "timestamp": "02:17:41", "text": "彼は30秒後に来るでしょう。"}, {"type": "subtitle", "time": 8263.19, "timestamp": "02:17:43", "text": "待って、待って、待って。"}, {"type": "subtitle", "time": 8264.95, "timestamp": "02:17:44", "text": "それは幸運だ。 ちょっと"}, {"type": "subtitle", "time": 8269.91, "timestamp": "02:17:49", "text": "調べてもいいですか？ 良い。"}, {"type": "subtitle", "time": 8271.75, "timestamp": "02:17:51", "text": "助けが必要な場合は、間違った方法に行かないでください。 ほら、"}, {"type": "subtitle", "time": 8274.07, "timestamp": "02:17:54", "text": "判断しないで"}, {"type": "subtitle", "time": 8274.95, "timestamp": "02:17:54", "text": "。"}, {"type": "subtitle", "time": 8277.429, "timestamp": "02:17:57", "text": "彼は良い友人だ。 待ちます。 このことで、あなたが脱出できないという"}]
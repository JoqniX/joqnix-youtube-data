[{"type": "subtitle", "time": 7981.669, "timestamp": "02:13:01", "text": "接続エラーが発生したのかな？"}, {"type": "subtitle", "time": 7984.55, "timestamp": "02:13:04", "text": "ああ、私たちのチャット。 私たちのチャットは再び単調になった"}, {"type": "subtitle", "time": 7986.629, "timestamp": "02:13:06", "text": "。"}, {"type": "subtitle", "time": 7987.83, "timestamp": "02:13:07", "text": "何？"}, {"type": "subtitle", "time": 7988.629, "timestamp": "02:13:08", "text": "ええ、"}, {"type": "subtitle", "time": 7991.03, "timestamp": "02:13:11", "text": "そうでした。   私は思う。   いいえ。ええ。"}, {"type": "subtitle", "time": 7998.229, "timestamp": "02:13:18", "text": "あれ、そうじゃなかったっけ？   そうだったと"}, {"type": "subtitle", "time": 7999.91, "timestamp": "02:13:19", "text": "思います。"}, {"type": "subtitle", "time": 8002.79, "timestamp": "02:13:22", "text": "待って、待って、待って、待って、待って。 いや、まだ"}, {"type": "subtitle", "time": 8005.109, "timestamp": "02:13:25", "text": "その"}, {"type": "subtitle", "time": 8006.629, "timestamp": "02:13:26", "text": "場にいるんだよね？"}, {"type": "subtitle", "time": 8009.109, "timestamp": "02:13:29", "text": "いいえ。 いいえ、違います。   そうではありません"}, {"type": "subtitle", "time": 8011.75, "timestamp": "02:13:31", "text": "。 おお。 ああ、わかりました。 わかった。 よし、やったぞ"}, {"type": "subtitle", "time": 8014.39, "timestamp": "02:13:34", "text": "。 またやってしまった。 リラックスして、"}, {"type": "subtitle", "time": 8016.47, "timestamp": "02:13:36", "text": "おしゃべりしよう。 わかった。"}, {"type": "subtitle", "time": 8019.35, "timestamp": "02:13:39", "text": "コードを教えてくれよ、弟よ。"}, {"type": "subtitle", "time": 8034.149, "timestamp": "02:13:54", "text": "プラットに行って、どのエージェントか見てみよう。つまり、"}, {"type": "subtitle", "time": 8037.669, "timestamp": "02:13:57", "text": "ヒーローって何て言うんだっけ？"}, {"type": "subtitle", "time": 8039.91, "timestamp": "02:13:59", "text": "ああ、ヒーローたち。"}]
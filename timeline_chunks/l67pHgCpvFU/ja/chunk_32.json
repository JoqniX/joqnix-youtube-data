[{"type": "subtitle", "time": 1936.847, "timestamp": "00:32:16", "text": "。 あなたはそれらを全部食べて、"}, {"type": "subtitle", "time": 1939.35, "timestamp": "00:32:19", "text": "[笑い]全部中に放り込んだ。"}, {"type": "subtitle", "time": 1940.23, "timestamp": "00:32:20", "text": "うん。"}, {"type": "subtitle", "time": 1943.43, "timestamp": "00:32:23", "text": "あなたは自殺したのですか？"}, {"type": "subtitle", "time": 1947.269, "timestamp": "00:32:27", "text": "うん。 優位性を示すためだよ、わかるだろ？"}, {"type": "subtitle", "time": 1951.909, "timestamp": "00:32:31", "text": "[息を呑む]"}, {"type": "subtitle", "time": 1954.47, "timestamp": "00:32:34", "text": "ああ、なんてことだ。  [鼻を鳴らす]"}, {"type": "subtitle", "time": 1957.83, "timestamp": "00:32:37", "text": "ちくしょう。  [笑い] ああ、なんてことだ。 こんにちは。 私はここにいます"}, {"type": "subtitle", "time": 1959.43, "timestamp": "00:32:39", "text": "。"}, {"type": "subtitle", "time": 1963.029, "timestamp": "00:32:43", "text": "それは（笑い）すごくクールですね。   はい"}, {"type": "subtitle", "time": 1965.029, "timestamp": "00:32:45", "text": "、すぐ戻ります。"}, {"type": "subtitle", "time": 1967.509, "timestamp": "00:32:47", "text": "トイレに急いで行かなければならない。   わかった"}, {"type": "subtitle", "time": 1978.23, "timestamp": "00:32:58", "text": "皆さん、お元気ですか？ こんにちは、ベーコン。"}]
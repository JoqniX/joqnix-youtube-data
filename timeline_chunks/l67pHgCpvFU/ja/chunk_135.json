[{"type": "subtitle", "time": 8101.43, "timestamp": "02:15:01", "text": "あなたにお渡しできるコードは持ち合わせていません。"}, {"type": "subtitle", "time": 8104.709, "timestamp": "02:15:04", "text": "えっと、あなたの"}, {"type": "subtitle", "time": 8107.91, "timestamp": "02:15:07", "text": "友達コードを教えてください。プロフィールをクリックしたときに表示される"}, {"type": "subtitle", "time": 8111.83, "timestamp": "02:15:11", "text": "IDを教えてください。"}, {"type": "subtitle", "time": 8114.39, "timestamp": "02:15:14", "text": "そうすれば、あなたを追加してゲームに招待できます"}, {"type": "subtitle", "time": 8115.91, "timestamp": "02:15:15", "text": "。"}, {"type": "subtitle", "time": 8121.75, "timestamp": "02:15:21", "text": "あなたにはそれが理解できますか？"}, {"type": "subtitle", "time": 8125.51, "timestamp": "02:15:25", "text": "小さな脳みそでもわかるんだな？   わかった"}, {"type": "subtitle", "time": 8129.669, "timestamp": "02:15:29", "text": "。 彼は試合中と同じようにゲームにも参加している。   わかった"}, {"type": "subtitle", "time": 8133.03, "timestamp": "02:15:33", "text": "。 何てことだ。 めちゃくちゃバカだ。"}, {"type": "subtitle", "time": 8135.838, "timestamp": "02:15:35", "text": "やり方がわからない"}, {"type": "subtitle", "time": 8137.35, "timestamp": "02:15:37", "text": "[笑い]"}, {"type": "subtitle", "time": 8139.43, "timestamp": "02:15:39", "text": "クソみたいな行動のバカ"}, {"type": "subtitle", "time": 8141.733, "timestamp": "02:15:41", "text": "その言葉は言ってはいけない。"}, {"type": "subtitle", "time": 8142.629, "timestamp": "02:15:42", "text": "[笑い]"}, {"type": "subtitle", "time": 8144.87, "timestamp": "02:15:44", "text": "彼は配信中だよ。"}, {"type": "subtitle", "time": 8149.669, "timestamp": "02:15:49", "text": "おい、相棒。 私の夫は昔はそうだったけど。"}, {"type": "subtitle", "time": 8152.229, "timestamp": "02:15:52", "text": "イエス。 彼は私が思っていたようには見えていない。彼は"}, {"type": "subtitle", "time": 8154.31, "timestamp": "02:15:54", "text": "ゲームをしているからだ。 ゲーム内で"}, {"type": "subtitle", "time": 8156.149, "timestamp": "02:15:56", "text": "リクエストを送信して何かを送る、という感じだと思いました。 まるで"}, {"type": "subtitle", "time": 8157.83, "timestamp": "02:15:57", "text": "試合をしているような気分だ。 まるで"}]
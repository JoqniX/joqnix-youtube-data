[{"type": "subtitle", "time": 2040.23, "timestamp": "00:34:00", "text": "私"}, {"type": "subtitle", "time": 2042.789, "timestamp": "00:34:02", "text": "とあなたのCHチャンピオンはどうすればいいですか？ 忘れた。"}, {"type": "subtitle", "time": 2066.069, "timestamp": "00:34:26", "text": "これで３つ目だ。"}, {"type": "subtitle", "time": 2068.79, "timestamp": "00:34:28", "text": "えっと、"}, {"type": "subtitle", "time": 2073.589, "timestamp": "00:34:33", "text": "これはどうやって変更するんですか？ いいえ。チャムスターです。"}, {"type": "subtitle", "time": 2089.109, "timestamp": "00:34:49", "text": "こんにちは、おかえりなさい。"}, {"type": "subtitle", "time": 2093.909, "timestamp": "00:34:53", "text": "よし、練習"}]
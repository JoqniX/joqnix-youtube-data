[{"type": "subtitle", "time": 4626.308, "timestamp": "01:17:06", "text": "彼はまだ私にメールしてこないので、"}, {"type": "subtitle", "time": 4627.99, "timestamp": "01:17:07", "text": "（笑）まだ"}, {"type": "subtitle", "time": 4629.669, "timestamp": "01:17:09", "text": "遊べるわ。"}, {"type": "subtitle", "time": 4630.63, "timestamp": "01:17:10", "text": "はい。"}, {"type": "subtitle", "time": 4631.99, "timestamp": "01:17:11", "text": "うん。 うん。   よし"}, {"type": "subtitle", "time": 4643.11, "timestamp": "01:17:23", "text": "いやあ、楽しかったよ。   私は"}, {"type": "subtitle", "time": 4646.95, "timestamp": "01:17:26", "text": "攻撃チームでプレイしようかなと思っています"}, {"type": "subtitle", "time": 4648.63, "timestamp": "01:17:28", "text": "。   見てみましょう"}, {"type": "subtitle", "time": 4651.11, "timestamp": "01:17:31", "text": "。 誰を"}, {"type": "subtitle", "time": 4653.99, "timestamp": "01:17:33", "text": "操作するかはまだ決めていない。"}, {"type": "subtitle", "time": 4656.55, "timestamp": "01:17:36", "text": "ヒーローか悪役かを選んでください。 私は"}, {"type": "subtitle", "time": 4674.47, "timestamp": "01:17:54", "text": "私が彼女を演じたらどうなるだろう？   私が"}, {"type": "subtitle", "time": 4676.149, "timestamp": "01:17:56", "text": "試してみます。"}, {"type": "subtitle", "time": 4678.709, "timestamp": "01:17:58", "text": "ああ、彼女はなかなかいい子だよ。"}]
[{"type": "subtitle", "time": 7694.31, "timestamp": "02:08:14", "text": "H がいればもっと良かったかもしれない。まあいいけど"}, {"type": "subtitle", "time": 7697.75, "timestamp": "02:08:17", "text": "。 こんにちは。  Vを楽しんでください。じゃあ、私は"}, {"type": "subtitle", "time": 7700.79, "timestamp": "02:08:20", "text": "寝かせてください。"}, {"type": "subtitle", "time": 7704.069, "timestamp": "02:08:24", "text": "ここからご覧ください。 ああ、神様。"}, {"type": "subtitle", "time": 7704.47, "timestamp": "02:08:24", "text": "ああ、"}, {"type": "subtitle", "time": 7708.069, "timestamp": "02:08:28", "text": "なんて言うんでしたっけ？ トゥイッチ。"}, {"type": "subtitle", "time": 7709.03, "timestamp": "02:08:29", "text": "えっと、そこから先は、"}, {"type": "subtitle", "time": 7716.149, "timestamp": "02:08:36", "text": "無料のアイアンマンスキンコードで"}, {"type": "subtitle", "time": 7730.069, "timestamp": "02:08:50", "text": "。 ああ、チャットに入力してください。"}, {"type": "subtitle", "time": 7732.39, "timestamp": "02:08:52", "text": "ピン留めしてもいいと思いますよ。"}, {"type": "subtitle", "time": 7734.629, "timestamp": "02:08:54", "text": "ピン留めしておきます。"}, {"type": "subtitle", "time": 7736.79, "timestamp": "02:08:56", "text": "どうすれば引き換えられますか？"}, {"type": "subtitle", "time": 7738.39, "timestamp": "02:08:58", "text": "はい。  P."}, {"type": "subtitle", "time": 7739.91, "timestamp": "02:08:59", "text": "わかりました。"}]
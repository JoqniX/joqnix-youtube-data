[{"type": "subtitle", "time": 11581.19, "timestamp": "03:13:01", "text": "戦闘開始まで、5、4、3、2、1"}, {"type": "subtitle", "time": 11583.75, "timestamp": "03:13:03", "text": "。"}, {"type": "subtitle", "time": 11585.269, "timestamp": "03:13:05", "text": "あなたがすべきことは、"}, {"type": "subtitle", "time": 11617.269, "timestamp": "03:13:37", "text": "今はあなたのものみたいですね。"}, {"type": "subtitle", "time": 11618.71, "timestamp": "03:13:38", "text": "武装して（うめき声と叫び声を上げながら）"}, {"type": "subtitle", "time": 11622.71, "timestamp": "03:13:42", "text": "再び危険だ。"}, {"type": "subtitle", "time": 11634.234, "timestamp": "03:13:54", "text": "さようなら。"}]
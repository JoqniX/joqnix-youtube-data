[{"type": "subtitle", "time": 4264.149, "timestamp": "01:11:04", "text": "強そうに見えるね。 君は"}, {"type": "subtitle", "time": 4266.709, "timestamp": "01:11:06", "text": "高校生に見えるよ。 あなたは何者ですか？"}, {"type": "subtitle", "time": 4268.55, "timestamp": "01:11:08", "text": "有名な歌手。"}, {"type": "subtitle", "time": 4270.95, "timestamp": "01:11:10", "text": "私は音楽を聴きません。 私は"}, {"type": "subtitle", "time": 4272.709, "timestamp": "01:11:12", "text": "犯罪者を罰する。"}, {"type": "subtitle", "time": 4274.79, "timestamp": "01:11:14", "text": "私たちはまさにそのための最適な場所にいる。   さあ行こう"}, {"type": "subtitle", "time": 4287.59, "timestamp": "01:11:27", "text": "君がやるべきことは、そのエリアを占領することだけだ。"}, {"type": "subtitle", "time": 4293.189, "timestamp": "01:11:33", "text": "ドクター、"}, {"type": "chat", "time": 4299.526, "timestamp": "01:11:39", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "watching joq play mr might be the toughest thing ive done in a while"}, {"type": "subtitle", "time": 4301.51, "timestamp": "01:11:41", "text": "息子よ。 円を描くように進んでください。"}, {"type": "subtitle", "time": 4304.63, "timestamp": "01:11:44", "text": "さあ、素早く降りて。"}, {"type": "subtitle", "time": 4306.95, "timestamp": "01:11:46", "text": "犬が遊んでいるのを見るのは、ここしばらくで一番辛いことだった"}, {"type": "subtitle", "time": 4310.709, "timestamp": "01:11:50", "text": "。 何てことだ。"}]
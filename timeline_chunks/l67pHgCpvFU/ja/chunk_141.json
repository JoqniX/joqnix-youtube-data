[{"type": "subtitle", "time": 8467.51, "timestamp": "02:21:07", "text": "ブラック・ウィドウは出撃準備完了。   ああ、しまった、"}, {"type": "subtitle", "time": 8469.11, "timestamp": "02:21:09", "text": "逃げるべきだった。 くそっ"}, {"type": "subtitle", "time": 8471.19, "timestamp": "02:21:11", "text": "、俺は健康じゃない。 なるほど、"}, {"type": "subtitle", "time": 8479.429, "timestamp": "02:21:19", "text": "君は僕のものだ。"}, {"type": "subtitle", "time": 8481.27, "timestamp": "02:21:21", "text": "私はこのキャラクターが好きです。 ところで、"}, {"type": "subtitle", "time": 8483.429, "timestamp": "02:21:23", "text": "何か事故でも起きたの？ えっと、"}, {"type": "subtitle", "time": 8486.63, "timestamp": "02:21:26", "text": "設定を変更しようとしてるんだけど、何なの"}, {"type": "subtitle", "time": 8488.87, "timestamp": "02:21:28", "text": "？ うん、じゃあ全部低めに抑えておこう。"}, {"type": "subtitle", "time": 8491.27, "timestamp": "02:21:31", "text": "低い。"}, {"type": "subtitle", "time": 8492.71, "timestamp": "02:21:32", "text": "全てが低価格。 チェック。 チェック。 全てが"}, {"type": "subtitle", "time": 8499.429, "timestamp": "02:21:39", "text": "これは私のものです。これは99です。"}, {"type": "subtitle", "time": 8507.83, "timestamp": "02:21:47", "text": "とんでもないダメージ。 ムナはとんでもないダメージを与える。   何だって"}, {"type": "subtitle", "time": 8508.87, "timestamp": "02:21:48", "text": "？"}, {"type": "subtitle", "time": 8511.75, "timestamp": "02:21:51", "text": "うん。"}, {"type": "subtitle", "time": 8513.349, "timestamp": "02:21:53", "text": "もし彼が私をイライラさせ続けるなら、"}, {"type": "subtitle", "time": 8515.51, "timestamp": "02:21:55", "text": "スパイダーマンをもらうわよ。"}]
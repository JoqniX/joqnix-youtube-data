[{"type": "subtitle", "time": 11522.79, "timestamp": "03:12:02", "text": "え？"}, {"type": "subtitle", "time": 11525.91, "timestamp": "03:12:05", "text": "今回のラウンドは我々が勝ちました。"}, {"type": "subtitle", "time": 11528.469, "timestamp": "03:12:08", "text": "ああ、彼はサブアカウントを無駄にした。  [笑い] こちらは"}, {"type": "subtitle", "time": 11555.349, "timestamp": "03:12:35", "text": "30秒。 攻撃する前に、"}, {"type": "subtitle", "time": 11557.83, "timestamp": "03:12:37", "text": "準備をせよ。"}, {"type": "subtitle", "time": 11568.55, "timestamp": "03:12:48", "text": "ああ、冗談だよ。 あなたがすべきことは、"}, {"type": "subtitle", "time": 11570.95, "timestamp": "03:12:50", "text": "全員を家に飲み込むことだけです。 わかった。"}]
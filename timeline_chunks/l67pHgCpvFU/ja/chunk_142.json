[{"type": "subtitle", "time": 8525.28, "timestamp": "02:22:05", "text": "。 狙いを定めることすらできない。 アイアンマン。"}, {"type": "subtitle", "time": 8538.07, "timestamp": "02:22:18", "text": "月があなたを悩ませる。"}, {"type": "subtitle", "time": 8539.59, "timestamp": "02:22:19", "text": "見よ、叫んでいる"}, {"type": "subtitle", "time": 8548.15, "timestamp": "02:22:28", "text": "。 私たちはそれを失ってしまった。"}, {"type": "subtitle", "time": 8549.19, "timestamp": "02:22:29", "text": "ああ、"}, {"type": "subtitle", "time": 8551.67, "timestamp": "02:22:31", "text": "そのジョークは伝わらなかったな。 私たちはそれを失ってしまった。"}, {"type": "subtitle", "time": 8552.309, "timestamp": "02:22:32", "text": "何？"}, {"type": "subtitle", "time": 8557.19, "timestamp": "02:22:37", "text": "失われてしまったのかもしれませんね？"}, {"type": "subtitle", "time": 8560.55, "timestamp": "02:22:40", "text": "ああ、あのムーンナイトは死んでしまったんだ、ベイビー。  19"}, {"type": "subtitle", "time": 8570.95, "timestamp": "02:22:50", "text": "よし、ロビーに戻ろうか？"}, {"type": "subtitle", "time": 8573.11, "timestamp": "02:22:53", "text": "ああ、そうだよ。 私は"}, {"type": "subtitle", "time": 8577.83, "timestamp": "02:22:57", "text": "[ため息]"}]
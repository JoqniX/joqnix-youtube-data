[{"type": "subtitle", "time": 10801.91, "timestamp": "03:00:01", "text": "ニース。"}, {"type": "subtitle", "time": 10815.429, "timestamp": "03:00:15", "text": "ああ、すぐに一致するものを見つけます。"}, {"type": "subtitle", "time": 10823.19, "timestamp": "03:00:23", "text": "ヘルパー・ガラ。 わかった。 適切なヒーローがいれば、"}, {"type": "subtitle", "time": 10825.59, "timestamp": "03:00:25", "text": "すべてが変わるかもしれない。"}, {"type": "subtitle", "time": 10829.75, "timestamp": "03:00:29", "text": "この世界に魔法を見つけるのに、魔女である必要はない。"}, {"type": "subtitle", "time": 10838.23, "timestamp": "03:00:38", "text": "、どういうわけか、"}, {"type": "subtitle", "time": 10840.87, "timestamp": "03:00:40", "text": "僕がジェフと対戦するときは、みんなランダムにプレイするように言ってるんだよ"}]
[{"type": "subtitle", "time": 8340.709, "timestamp": "02:19:00", "text": "しかし、彼らはどうやって登るのだろうか？"}, {"type": "subtitle", "time": 8342.309, "timestamp": "02:19:02", "text": "登り坂も見てみよう。 ああ、彼は回復している。 あなたは"}, {"type": "subtitle", "time": 8342.79, "timestamp": "02:19:02", "text": "回復に向かっています。"}, {"type": "subtitle", "time": 8344.87, "timestamp": "02:19:04", "text": "私の頭の中の声よりも、外にはもっと多くの敵がいる"}, {"type": "subtitle", "time": 8369.589, "timestamp": "02:19:29", "text": "彼らをウォーロックする。  [うめき声]"}, {"type": "subtitle", "time": 8379.03, "timestamp": "02:19:39", "text": "ああ、くそ。 ニース。 ニース。"}, {"type": "subtitle", "time": 8380.549, "timestamp": "02:19:40", "text": "このキャラクターを演じるのは非常に難しい。"}, {"type": "subtitle", "time": 8387.83, "timestamp": "02:19:47", "text": "ああ、問題は、私のチームが"}, {"type": "subtitle", "time": 8390.309, "timestamp": "02:19:50", "text": "今、ダメージを与えていないということです。"}, {"type": "subtitle", "time": 8392.79, "timestamp": "02:19:52", "text": "えっと、"}, {"type": "subtitle", "time": 8395.75, "timestamp": "02:19:55", "text": "アイアンマンを外さないといけないと思う。"}, {"type": "subtitle", "time": 8399.83, "timestamp": "02:19:59", "text": "スパイダーマンが好きなら、それを買うと思う"}]
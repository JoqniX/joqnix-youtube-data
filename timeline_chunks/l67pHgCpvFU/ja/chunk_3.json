[{"type": "subtitle", "time": 181.509, "timestamp": "00:03:01", "text": "こんにちは。"}, {"type": "subtitle", "time": 182.47, "timestamp": "00:03:02", "text": "元気ですか？"}, {"type": "subtitle", "time": 186.47, "timestamp": "00:03:06", "text": "こんにちは。 私は元気です。"}, {"type": "subtitle", "time": 188.869, "timestamp": "00:03:08", "text": "こんにちは。  [笑い] 久しぶりですね"}, {"type": "subtitle", "time": 190.63, "timestamp": "00:03:10", "text": "。"}, {"type": "subtitle", "time": 192.63, "timestamp": "00:03:12", "text": "ええ、久しぶりですね。  [笑い]"}, {"type": "subtitle", "time": 201.19, "timestamp": "00:03:21", "text": "そう、そうだね。"}, {"type": "subtitle", "time": 203.91, "timestamp": "00:03:23", "text": "マーベル・ライバルズをプレイするのが楽しみですか？ それ以来、"}, {"type": "subtitle", "time": 206.869, "timestamp": "00:03:26", "text": "このゲームには全く触れていません"}, {"type": "subtitle", "time": 212.55, "timestamp": "00:03:32", "text": "私は興奮しています。"}, {"type": "subtitle", "time": 213.50900000000001, "timestamp": "00:03:33", "text": "うん。   久しぶりに、一人で"}, {"type": "subtitle", "time": 224.949, "timestamp": "00:03:44", "text": "ゲームをする代わりに他の人と一緒に遊べるゲームに出会えた気がする。  [笑い]"}, {"type": "subtitle", "time": 227.11, "timestamp": "00:03:47", "text": "ええ、"}, {"type": "subtitle", "time": 230.869, "timestamp": "00:03:50", "text": "このゲームは以前はすごくラグがひどかったんです"}]
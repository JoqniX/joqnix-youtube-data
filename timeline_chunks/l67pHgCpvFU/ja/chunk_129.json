[{"type": "subtitle", "time": 7742.31, "timestamp": "02:09:02", "text": "ドロップを有効にするように書き込む必要があります。 わからない"}, {"type": "subtitle", "time": 7745.109, "timestamp": "02:09:05", "text": "。 ドロップ機能は有効になっていますか？"}, {"type": "subtitle", "time": 7747.99, "timestamp": "02:09:07", "text": "滴。 ちなみに、それは滴です。"}, {"type": "subtitle", "time": 7749.83, "timestamp": "02:09:09", "text": "ああ、それは書かなきゃ"}, {"type": "subtitle", "time": 7751.99, "timestamp": "02:09:11", "text": "。"}, {"type": "subtitle", "time": 7752.709, "timestamp": "02:09:12", "text": "ドロップは、"}, {"type": "subtitle", "time": 7754.87, "timestamp": "02:09:14", "text": "ああ、これは私が彼の配信を見ているところですよね"}, {"type": "subtitle", "time": 7762.629, "timestamp": "02:09:22", "text": "私はゲームを始める。   わかった"}, {"type": "subtitle", "time": 7764.47, "timestamp": "02:09:24", "text": "。 皆さんが"}, {"type": "subtitle", "time": 7767.75, "timestamp": "02:09:27", "text": "コマンドを使ってヒントを作成できるように、私が責任を持って対応します。"}, {"type": "subtitle", "time": 7768.39, "timestamp": "02:09:28", "text": "それはここからのものです。"}, {"type": "subtitle", "time": 7774.32, "timestamp": "02:09:34", "text": "。 はい。"}, {"type": "subtitle", "time": 7776.32, "timestamp": "02:09:36", "text": "はい。 あなたを追加しないといけないですよね？"}, {"type": "subtitle", "time": 7778.8, "timestamp": "02:09:38", "text": "あなたを追加しないといけないですよね？ うん。 うん。 だって、そうでしょ。   わかった"}, {"type": "subtitle", "time": 7797.189, "timestamp": "02:09:57", "text": "。 こんにちは。 私は戻ってきます。 ボードゲームをお楽しみください。"}, {"type": "subtitle", "time": 7798.79, "timestamp": "02:09:58", "text": "滴。"}, {"type": "subtitle", "time": 7799.27, "timestamp": "02:09:59", "text": "あ、そういえば、"}]
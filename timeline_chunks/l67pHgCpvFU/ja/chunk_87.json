[{"type": "subtitle", "time": 5222.55, "timestamp": "01:27:02", "text": "[笑い]"}, {"type": "subtitle", "time": 5225.189, "timestamp": "01:27:05", "text": "このキャラクター、すごく面白いですね。"}, {"type": "subtitle", "time": 5227.91, "timestamp": "01:27:07", "text": "ジョランが"}, {"type": "subtitle", "time": 5230.31, "timestamp": "01:27:10", "text": "彼らを撃っているのに、僕はここで撃っているだけで、"}, {"type": "subtitle", "time": 5269.51, "timestamp": "01:27:49", "text": "、もう死にそうだ。 勝者。 その時が来た"}, {"type": "subtitle", "time": 5270.709, "timestamp": "01:27:50", "text": "。"}, {"type": "subtitle", "time": 5272.55, "timestamp": "01:27:52", "text": "少しお待ちください。 少しお待ちください。 何てことだ"}]
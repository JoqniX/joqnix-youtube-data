[{"type": "subtitle", "time": 1862.389, "timestamp": "00:31:02", "text": "なぜMVPに選ばれなかったのですか？ 君はたくさんの"}, {"type": "subtitle", "time": 1864.149, "timestamp": "00:31:04", "text": "敵を倒したね。"}, {"type": "subtitle", "time": 1867.75, "timestamp": "00:31:07", "text": "いいえ、大丈夫です。 キル数が少なかったからだよ"}, {"type": "subtitle", "time": 1869.11, "timestamp": "00:31:09", "text": "。   今は"}, {"type": "subtitle", "time": 1872.47, "timestamp": "00:31:12", "text": "回復モードしか使っていないから、そういうことなんです。"}, {"type": "subtitle", "time": 1875.029, "timestamp": "00:31:15", "text": "ああ、"}, {"type": "subtitle", "time": 1876.87, "timestamp": "00:31:16", "text": "自分のハイライトを見たい。 自分のキャラクターのハイライトを"}, {"type": "subtitle", "time": 1879.269, "timestamp": "00:31:19", "text": "クリックすると、そのハイライトを見ることができます"}, {"type": "subtitle", "time": 1882.07, "timestamp": "00:31:22", "text": "。 また、他の参加者"}, {"type": "subtitle", "time": 1884.63, "timestamp": "00:31:24", "text": "のハイライト映像も視聴できます。"}, {"type": "subtitle", "time": 1889.43, "timestamp": "00:31:29", "text": "あ、待って。 どうやって？ えっと、スコアボード。 いいえ。ええと、"}, {"type": "subtitle", "time": 1893.75, "timestamp": "00:31:33", "text": "右に飛ばしてください。 あ、待って。 ああ、ヴェルヴェット・アンダーグラウンドのハイライトだね。"}, {"type": "subtitle", "time": 1909.43, "timestamp": "00:31:49", "text": "ああ、これだ。   私の作品も見ておく"}, {"type": "subtitle", "time": 1911.75, "timestamp": "00:31:51", "text": "べきだ。"}, {"type": "subtitle", "time": 1915.029, "timestamp": "00:31:55", "text": "ペンタキルを達成したことに気づかなかった。"}, {"type": "subtitle", "time": 1919.11, "timestamp": "00:31:59", "text": "待って、待って、待って。 あなたのものは見えにくいですね。 えっと。"}]
[{"type": "subtitle", "time": 14401.349, "timestamp": "04:00:01", "text": "もっとこれをプレイするべきだ。 私は"}, {"type": "subtitle", "time": 14403.83, "timestamp": "04:00:03", "text": "このゲームを1週間保管しておきますが、"}, {"type": "subtitle", "time": 14410.07, "timestamp": "04:00:10", "text": "その後は[笑い]もうスペースがありません。 でも、"}, {"type": "subtitle", "time": 14413.03, "timestamp": "04:00:13", "text": "もっとスペースを作らないといけないですね。   なんてこった。"}, {"type": "subtitle", "time": 14417.361, "timestamp": "04:00:17", "text": "最近のゲームのサイズは非常に大きい。"}, {"type": "subtitle", "time": 14418.15, "timestamp": "04:00:18", "text": "[笑い]"}, {"type": "subtitle", "time": 14421.11, "timestamp": "04:00:21", "text": "いいえ。いいえ。"}, {"type": "subtitle", "time": 14427.429, "timestamp": "04:00:27", "text": "でも、君と一緒に"}, {"type": "subtitle", "time": 14429.67, "timestamp": "04:00:29", "text": "このゲームをプレイできてよかったよ。"}, {"type": "subtitle", "time": 14432.15, "timestamp": "04:00:32", "text": "普通ならラグがひどかったから誰ともプレイしないんだけどね"}, {"type": "subtitle", "time": 14436.63, "timestamp": "04:00:36", "text": "（笑）。   ええ"}, {"type": "subtitle", "time": 14438.63, "timestamp": "04:00:38", "text": "、ご"}, {"type": "subtitle", "time": 14441.429, "timestamp": "04:00:41", "text": "提案いただきありがとうございます。   ああ"}, {"type": "subtitle", "time": 14445.03, "timestamp": "04:00:45", "text": "、本当に楽しかった！"}, {"type": "subtitle", "time": 14453.189, "timestamp": "04:00:53", "text": "次回は、このゲームをプレイしたいですか？それとも、"}, {"type": "subtitle", "time": 14455.11, "timestamp": "04:00:55", "text": "他にプレイしたいゲームがあれば、"}, {"type": "subtitle", "time": 14458.469, "timestamp": "04:00:58", "text": "次回お時間のある時にそちらをプレイしてもいいですよ。"}]
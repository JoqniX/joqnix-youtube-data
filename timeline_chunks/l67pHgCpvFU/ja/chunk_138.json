[{"type": "subtitle", "time": 8285.589, "timestamp": "02:18:05", "text": "。"}, {"type": "subtitle", "time": 8288.469, "timestamp": "02:18:08", "text": "私だけでしょうか、それとも"}, {"type": "subtitle", "time": 8290.309, "timestamp": "02:18:10", "text": "私のFPSがおかしいのでしょうか。"}, {"type": "subtitle", "time": 8297.11, "timestamp": "02:18:17", "text": "どれくらいですか？"}, {"type": "subtitle", "time": 8299.03, "timestamp": "02:18:19", "text": "最大フレームレートが出ています。 もう一つは、"}, {"type": "subtitle", "time": 8301.03, "timestamp": "02:18:21", "text": "今、良いモニターを持っていないことです。"}, {"type": "subtitle", "time": 8304.23, "timestamp": "02:18:24", "text": "今はモニターを2台使っています。"}, {"type": "subtitle", "time": 8310.549, "timestamp": "02:18:30", "text": "安定した住居が見つかるまでは、モニターは買わないでおこうと思う。"}, {"type": "subtitle", "time": 8314.23, "timestamp": "02:18:34", "text": "どういうわけか、時速60キロ以上出すことができません。"}, {"type": "subtitle", "time": 8320.629, "timestamp": "02:18:40", "text": "おやすみ。"}, {"type": "subtitle", "time": 8323.83, "timestamp": "02:18:43", "text": "ああ、1キルか。"}, {"type": "subtitle", "time": 8326.709, "timestamp": "02:18:46", "text": "悟空は腐っている。 なぜ"}, {"type": "subtitle", "time": 8328.95, "timestamp": "02:18:48", "text": "治らないのか分かりません。 ちくしょう。"}, {"type": "subtitle", "time": 8330.709, "timestamp": "02:18:50", "text": "ヒーラーは誰ですか？ 癒し手はいない。"}, {"type": "subtitle", "time": 8331.27, "timestamp": "02:18:51", "text": "私は死んだ。   何だって"}, {"type": "subtitle", "time": 8332.95, "timestamp": "02:18:52", "text": "？ なぜ？ 一体何なんだ？"}]
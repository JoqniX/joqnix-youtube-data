[{"type": "subtitle", "time": 8042.87, "timestamp": "02:14:02", "text": "うん。 どのヒーローを選べばいいですか？"}, {"type": "subtitle", "time": 8044.95, "timestamp": "02:14:04", "text": "ええ、あなたが選ぶものなら何でも。 アイアンマンのように、"}, {"type": "subtitle", "time": 8047.109, "timestamp": "02:14:07", "text": "簡単にプレイできます。 ジェフは非常に有害な人物だ。"}, {"type": "subtitle", "time": 8049.91, "timestamp": "02:14:09", "text": "スパイダーマンはいい奴だ。 ちなみに、サイロックはとても優秀だ"}, {"type": "subtitle", "time": 8051.91, "timestamp": "02:14:11", "text": "。 女性。 そして、"}, {"type": "subtitle", "time": 8055.669, "timestamp": "02:14:15", "text": "チュートリアルの内容を変えなければならない。"}, {"type": "subtitle", "time": 8059.109, "timestamp": "02:14:19", "text": "チュートリアルはどれをやらなければなりませんでしたか？"}, {"type": "subtitle", "time": 8059.669, "timestamp": "02:14:19", "text": "あなたは変われるのか？ うん。"}, {"type": "chat", "time": 8060.201, "timestamp": "02:14:20", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "reminder that the footage playing is an older stream~ ill come back after lunch nee~ do enjoy the vod till then~"}, {"type": "subtitle", "time": 8062.149, "timestamp": "02:14:22", "text": "いや、いや、いや、いや。 私は練習"}, {"type": "subtitle", "time": 8064.709, "timestamp": "02:14:24", "text": "場にいました。 チュートリアルを終えました。 うん。"}, {"type": "subtitle", "time": 8067.669, "timestamp": "02:14:27", "text": "ああ、"}, {"type": "subtitle", "time": 8070.47, "timestamp": "02:14:30", "text": "スカーレット・ウィッチは命を奪って生きるのがうまい"}, {"type": "subtitle", "time": 8072.31, "timestamp": "02:14:32", "text": "。"}, {"type": "subtitle", "time": 8073.99, "timestamp": "02:14:33", "text": "彼女は人の人生を奪う。"}, {"type": "subtitle", "time": 8080.87, "timestamp": "02:14:40", "text": "人々は導かれることを望んでいる。 私は"}, {"type": "subtitle", "time": 8081.589, "timestamp": "02:14:41", "text": "責任者になりたい。   まるで"}, {"type": "subtitle", "time": 8087.51, "timestamp": "02:14:47", "text": "HPを吸い取るように再生しているようだった。"}, {"type": "subtitle", "time": 8090.149, "timestamp": "02:14:50", "text": "彼女は私をとてもイライラさせる。   楽勝だ"}, {"type": "subtitle", "time": 8093.27, "timestamp": "02:14:53", "text": "。"}, {"type": "subtitle", "time": 8095.03, "timestamp": "02:14:55", "text": "ところで、コードを教えてくれ、R。ちくしょう"}, {"type": "subtitle", "time": 8096.069, "timestamp": "02:14:56", "text": "。 遊びたいなら、"}, {"type": "subtitle", "time": 8097.75, "timestamp": "02:14:57", "text": "ゲームに参加しているってどういう意味ですか？"}, {"type": "subtitle", "time": 8099.669, "timestamp": "02:14:59", "text": "君が本気で戦ってるってことはわかってるよ、相棒。"}]
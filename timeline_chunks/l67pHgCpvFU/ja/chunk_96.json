[{"type": "subtitle", "time": 5788.39, "timestamp": "01:36:28", "text": "混沌が私たちを取り囲んでいるが、私は"}, {"type": "subtitle", "time": 5792.55, "timestamp": "01:36:32", "text": "それを喜んで支配者に見せつけてやる。"}, {"type": "subtitle", "time": 5802.55, "timestamp": "01:36:42", "text": "姉さん、本当に会いたかったよ。 あなたの"}, {"type": "subtitle", "time": 5805.99, "timestamp": "01:36:45", "text": "槍は大変ありがたいです。 エクスガード。"}, {"type": "subtitle", "time": 5808.95, "timestamp": "01:36:48", "text": "最後に父に会った時、彼はそれが"}, {"type": "subtitle", "time": 5811.669, "timestamp": "01:36:51", "text": "事実ではないと明確に述べていた。   聞いてい"}, {"type": "subtitle", "time": 5814.149, "timestamp": "01:36:54", "text": "ないのですか？ 新たな王が即位した"}, {"type": "subtitle", "time": 5816.39, "timestamp": "01:36:56", "text": "。"}]
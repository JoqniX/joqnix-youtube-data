[{"type": "subtitle", "time": 10530.63, "timestamp": "02:55:30", "text": "消える。"}, {"type": "subtitle", "time": 10540.469, "timestamp": "02:55:40", "text": "魔法だ。"}, {"type": "subtitle", "time": 10543.75, "timestamp": "02:55:43", "text": "私は二度と同じ過ちを繰り返さない。   よし"}, {"type": "subtitle", "time": 10544.389, "timestamp": "02:55:44", "text": "。"}, {"type": "subtitle", "time": 10556.23, "timestamp": "02:55:56", "text": "彼らは半分まで来た。 彼らを止めろ。"}, {"type": "subtitle", "time": 10558.55, "timestamp": "02:55:58", "text": "あの車を止めた方がいい。"}, {"type": "subtitle", "time": 10559.99, "timestamp": "02:55:59", "text": "私たちは飢えている。"}]
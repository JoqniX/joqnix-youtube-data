[{"type": "subtitle", "time": 2889.589, "timestamp": "00:48:09", "text": "タイムラインはどこにあるの？"}, {"type": "subtitle", "time": 2892.23, "timestamp": "00:48:12", "text": "ああ、それは臭い。 パンチング。 よし、"}, {"type": "subtitle", "time": 2894.15, "timestamp": "00:48:14", "text": "この物体を右クリックすると、"}, {"type": "subtitle", "time": 2896.79, "timestamp": "00:48:16", "text": "ウェブを使ってあらゆる場所に飛び回れるようになる"}, {"type": "subtitle", "time": 2917.91, "timestamp": "00:48:37", "text": "バトルの間には、常に多くのチャンスがあるという、実に素晴らしい組み合わせです"}, {"type": "subtitle", "time": 2922.15, "timestamp": "00:48:42", "text": "。"}, {"type": "subtitle", "time": 2926.549, "timestamp": "00:48:46", "text": "4 3 2 1。やるべきことは、"}, {"type": "subtitle", "time": 2931.43, "timestamp": "00:48:51", "text": "ミッションエリアを占領することだけです。 わかった。   まるで、"}, {"type": "subtitle", "time": 2936.309, "timestamp": "00:48:56", "text": "部品が何もない状態でここにいるようなものだ。"}]
[{"type": "subtitle", "time": 13148.87, "timestamp": "03:39:08", "text": "ええ、グルートの言葉を読めるんですよ。"}, {"type": "subtitle", "time": 13150.95, "timestamp": "03:39:10", "text": "グルート。"}, {"type": "subtitle", "time": 13160.63, "timestamp": "03:39:20", "text": "星界でさえ、"}, {"type": "subtitle", "time": 13162.71, "timestamp": "03:39:22", "text": "時間領域の絡み合いによって引き裂かれてしまう。"}, {"type": "subtitle", "time": 13164.389, "timestamp": "03:39:24", "text": "それらを元通りにできるのは、"}, {"type": "subtitle", "time": 13165.67, "timestamp": "03:39:25", "text": "あなたと私以上に適任な人はいないでしょう？"}, {"type": "subtitle", "time": 13175.349, "timestamp": "03:39:35", "text": "あ、待って。 彼は"}, {"type": "subtitle", "time": 13177.429, "timestamp": "03:39:37", "text": "ルースの上に立つことができる。"}, {"type": "subtitle", "time": 13178.07, "timestamp": "03:39:38", "text": "何？"}, {"type": "subtitle", "time": 13179.349, "timestamp": "03:39:39", "text": "うん。"}, {"type": "subtitle", "time": 13182.229, "timestamp": "03:39:42", "text": "おお。 それはすごくクールですね。"}, {"type": "subtitle", "time": 13185.292, "timestamp": "03:39:45", "text": "ああ、かわいい。"}, {"type": "subtitle", "time": 13186.469, "timestamp": "03:39:46", "text": "[笑い] お二人とも"}]
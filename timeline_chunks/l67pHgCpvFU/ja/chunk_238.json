[{"type": "subtitle", "time": 14280.389, "timestamp": "03:58:00", "text": "今度は世界に対する消滅だ。"}, {"type": "subtitle", "time": 14288.63, "timestamp": "03:58:08", "text": "ああ、だめだ"}, {"type": "subtitle", "time": 14289.269, "timestamp": "03:58:09", "text": "。"}, {"type": "subtitle", "time": 14291.349, "timestamp": "03:58:11", "text": "ああ、彼らはヴェノムを演奏しなくなったんだ。 私は、"}, {"type": "subtitle", "time": 14294.229, "timestamp": "03:58:14", "text": "なぜシールドがシールドとして機能しないのか不思議に思っていました"}, {"type": "subtitle", "time": 14311.03, "timestamp": "03:58:31", "text": "タンクを処分したので、"}, {"type": "subtitle", "time": 14323.75, "timestamp": "03:58:43", "text": "チーズ、"}, {"type": "subtitle", "time": 14325.91, "timestamp": "03:58:45", "text": "私たちの勝ちだよね？"}, {"type": "subtitle", "time": 14328.87, "timestamp": "03:58:48", "text": "うん、いい最終戦だったね。"}]
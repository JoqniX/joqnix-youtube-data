[{"type": "subtitle", "time": 9675.349, "timestamp": "02:41:15", "text": "ほら、次の犠牲者だ。 今や"}, {"type": "subtitle", "time": 9683.03, "timestamp": "02:41:23", "text": "彼らは検問所に差し掛かった。 今こそ"}, {"type": "subtitle", "time": 9697.19, "timestamp": "02:41:37", "text": "私は同じ過ちは繰り返さない。   すぐそこに行きます"}, {"type": "subtitle", "time": 9698.07, "timestamp": "02:41:38", "text": "。"}]
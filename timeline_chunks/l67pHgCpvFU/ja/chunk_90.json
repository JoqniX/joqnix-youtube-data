[{"type": "subtitle", "time": 5402.629, "timestamp": "01:30:02", "text": "宣教師を捕らえることだけです。 わかった。   お金を払って"}, {"type": "subtitle", "time": 5406.149, "timestamp": "01:30:06", "text": "このゲームに勝つことはできますか？"}, {"type": "subtitle", "time": 5414.937, "timestamp": "01:30:14", "text": "さようなら。"}, {"type": "subtitle", "time": 5422.229, "timestamp": "01:30:22", "text": "敵が近くにいる。 君は私のものだ。"}, {"type": "subtitle", "time": 5423.35, "timestamp": "01:30:23", "text": "どこ？ 誰が？"}, {"type": "subtitle", "time": 5433.99, "timestamp": "01:30:33", "text": "私は食べられてしまった。"}, {"type": "subtitle", "time": 5435.669, "timestamp": "01:30:35", "text": "いやだ。いやだ。"}]
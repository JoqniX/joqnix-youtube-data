[{"type": "subtitle", "time": 2583.43, "timestamp": "00:43:03", "text": "うん、30～60FPSは無理だと思う。"}, {"type": "subtitle", "time": 2585.75, "timestamp": "00:43:05", "text": "30個やらなきゃいけないんだ。"}, {"type": "subtitle", "time": 2607.51, "timestamp": "00:43:27", "text": "このスパイダーマンは私を放っておいてくれない。"}, {"type": "subtitle", "time": 2611.349, "timestamp": "00:43:31", "text": "おい、それってすごくイライラするよ。"}, {"type": "subtitle", "time": 2613.43, "timestamp": "00:43:33", "text": "スパイディ。"}, {"type": "subtitle", "time": 2615.67, "timestamp": "00:43:35", "text": "彼らは私を殺そうとし続けていて、本当に"}, {"type": "subtitle", "time": 2622.71, "timestamp": "00:43:42", "text": "ヴェノム、君を治すことはできない。 あなたは飛び込み"}, {"type": "subtitle", "time": 2631.589, "timestamp": "00:43:51", "text": "ああ、なんてことだ。"}, {"type": "subtitle", "time": 2636.069, "timestamp": "00:43:56", "text": "[笑い]"}, {"type": "subtitle", "time": 2638.55, "timestamp": "00:43:58", "text": "なぜオーマイゴッド。"}]
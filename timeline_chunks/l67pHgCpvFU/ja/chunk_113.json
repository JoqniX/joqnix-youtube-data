[{"type": "subtitle", "time": 6780.55, "timestamp": "01:53:00", "text": "もしよろしければお帰りいただいても構いません。"}, {"type": "subtitle", "time": 6784.709, "timestamp": "01:53:04", "text": "大丈夫だと思うよ。 大丈夫。 大丈夫。 彼は待ちきれない"}, {"type": "subtitle", "time": 6786.523, "timestamp": "01:53:06", "text": "。"}, {"type": "subtitle", "time": 6791.83, "timestamp": "01:53:11", "text": "どれくらい遠いですか？"}, {"type": "subtitle", "time": 6793.35, "timestamp": "01:53:13", "text": "受け取りに行くのに運転する必要はないのですか？   それほど遠くはないよ"}, {"type": "subtitle", "time": 6799.589, "timestamp": "01:53:19", "text": "スピードを上げます。 いや、冗談だよ。 私は"}, {"type": "subtitle", "time": 6802.47, "timestamp": "01:53:22", "text": "スピード違反はしません。 私はいつも通り安全です。"}, {"type": "subtitle", "time": 6804.31, "timestamp": "01:53:24", "text": "こんにちは。"}, {"type": "subtitle", "time": 6812.87, "timestamp": "01:53:32", "text": "私たちはポイントを確保し続けなければなりませんが、あまり遠くまで"}, {"type": "subtitle", "time": 6815.83, "timestamp": "01:53:35", "text": "押し進めてはいけません。なぜなら、"}, {"type": "subtitle", "time": 6817.91, "timestamp": "01:53:37", "text": "3人いる限り、"}, {"type": "subtitle", "time": 6821.03, "timestamp": "01:53:41", "text": "ペイロードがロードされるとすぐに"}, {"type": "subtitle", "time": 6833.35, "timestamp": "01:53:53", "text": "わかった。"}]
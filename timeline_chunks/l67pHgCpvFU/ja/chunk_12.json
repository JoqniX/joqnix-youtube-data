[{"type": "subtitle", "time": 721.269, "timestamp": "00:12:01", "text": "[笑い] ああ、なんてことだ。"}, {"type": "subtitle", "time": 724.069, "timestamp": "00:12:04", "text": "アメイジング・スパイダーマンに手出しするな。"}, {"type": "subtitle", "time": 724.55, "timestamp": "00:12:04", "text": "スパイダーマン。"}, {"type": "subtitle", "time": 727.35, "timestamp": "00:12:07", "text": "いや。いや。いや。いや。スパイダーマンが私を殺そうとしている。"}, {"type": "subtitle", "time": 733.509, "timestamp": "00:12:13", "text": "ブースト。"}, {"type": "subtitle", "time": 735.99, "timestamp": "00:12:15", "text": "うん。  [うめき声と叫び声]"}, {"type": "subtitle", "time": 737.99, "timestamp": "00:12:17", "text": "ああ、なんてことだ。 私は死にかけている。 私は死にかけている。 私は"}, {"type": "subtitle", "time": 739.03, "timestamp": "00:12:19", "text": "死にかけている。 癒す。 癒す。"}, {"type": "chat", "time": 739.092, "timestamp": "00:12:19", "author": "@TannerHernandez-u9i", "avatar": "https://yt4.ggpht.com/rS3mcXLfYbbeP0EJ-TMgHjDTIugqwSIruRtSjdtZ9RxHyooV3hG_Ig908WUqlL9m_DWxGYPJOg=s64-c-k-c0x00ffffff-no-rj", "message": "I can help you"}, {"type": "subtitle", "time": 745.75, "timestamp": "00:12:25", "text": "ああ、なんてことだ。 このワシは誰ですか？"}, {"type": "subtitle", "time": 746.949, "timestamp": "00:12:26", "text": "埃と戦え。"}, {"type": "subtitle", "time": 749.03, "timestamp": "00:12:29", "text": "組み立てる。  [叫び声]"}, {"type": "subtitle", "time": 750.71, "timestamp": "00:12:30", "text": "お客さんが来たよ。"}, {"type": "subtitle", "time": 756.55, "timestamp": "00:12:36", "text": "探しています。"}, {"type": "subtitle", "time": 757.99, "timestamp": "00:12:37", "text": "キャラクターを変えてみようかな。 私は"}, {"type": "subtitle", "time": 772.629, "timestamp": "00:12:52", "text": "飛行キャラクターを使っているから、プレイするのがちょっと難しいからだと思う"}, {"type": "chat", "time": 779.89, "timestamp": "00:12:59", "author": "@TannerHernandez-u9i", "avatar": "https://yt4.ggpht.com/rS3mcXLfYbbeP0EJ-TMgHjDTIugqwSIruRtSjdtZ9RxHyooV3hG_Ig908WUqlL9m_DWxGYPJOg=s64-c-k-c0x00ffffff-no-rj", "message": "I’ll train you 😎"}]
[{"type": "subtitle", "time": 8825.67, "timestamp": "02:27:05", "text": "えっと、ヘッドショットすればいいですよ。 簡単に片付けられるよ。"}, {"type": "subtitle", "time": 8830.79, "timestamp": "02:27:10", "text": "私は範囲攻撃を持っています。"}, {"type": "subtitle", "time": 8833.67, "timestamp": "02:27:13", "text": "私は決して外さない。 音楽が"}, {"type": "subtitle", "time": 8834.309, "timestamp": "02:27:14", "text": "うるさいから見逃せない。"}, {"type": "subtitle", "time": 8836.469, "timestamp": "02:27:16", "text": "30秒後に来るよ。"}, {"type": "subtitle", "time": 8843.03, "timestamp": "02:27:23", "text": "カマキリ、アライグマって何？"}, {"type": "subtitle", "time": 8846.63, "timestamp": "02:27:26", "text": "ああ、えっと、彼らは地球上で一番かわいい動物です"}, {"type": "subtitle", "time": 8847.67, "timestamp": "02:27:27", "text": "。"}, {"type": "subtitle", "time": 8849.75, "timestamp": "02:27:29", "text": "本当に？ どうしてみんな"}, {"type": "subtitle", "time": 8852.71, "timestamp": "02:27:32", "text": "アライグマって呼ぶの？ 私はすごい奴だ。"}, {"type": "subtitle", "time": 8862.469, "timestamp": "02:27:42", "text": "戦いは5、4、3で始まる。   選考を"}, {"type": "subtitle", "time": 8863.59, "timestamp": "02:27:43", "text": "通過した。"}, {"type": "subtitle", "time": 8865.19, "timestamp": "02:27:45", "text": "ところで、私の配信はちゃんと配信できてる？それともできていない"}, {"type": "subtitle", "time": 8867.51, "timestamp": "02:27:47", "text": "？ いいえ。誰も教えてくれませんでした。   買います"}, {"type": "subtitle", "time": 8868.07, "timestamp": "02:27:48", "text": "。   どういたしまして"}, {"type": "subtitle", "time": 8869.67, "timestamp": "02:27:49", "text": "。"}, {"type": "subtitle", "time": 8871.67, "timestamp": "02:27:51", "text": "共感することは、時に重荷となる"}, {"type": "subtitle", "time": 8874.55, "timestamp": "02:27:54", "text": "。   それはやめるべきだ"}, {"type": "subtitle", "time": 8877.27, "timestamp": "02:27:57", "text": "。   わかった"}, {"type": "subtitle", "time": 8879.11, "timestamp": "02:27:59", "text": "。 くそっ。 ちなみに、私のものは動作していません"}]
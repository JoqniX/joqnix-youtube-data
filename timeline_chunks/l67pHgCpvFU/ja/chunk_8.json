[{"type": "subtitle", "time": 480.71, "timestamp": "00:08:00", "text": "私はジェフ役を演じます。"}, {"type": "subtitle", "time": 482.469, "timestamp": "00:08:02", "text": "適切なヒーローがいれば、すべてが"}, {"type": "subtitle", "time": 483.43, "timestamp": "00:08:03", "text": "変わるかもしれない。"}, {"type": "subtitle", "time": 485.189, "timestamp": "00:08:05", "text": "ジェフィー。"}, {"type": "subtitle", "time": 490.71, "timestamp": "00:08:10", "text": "一度アベンジャーズになったら、永遠にアベンジャーズだ。"}, {"type": "subtitle", "time": 503.11, "timestamp": "00:08:23", "text": "このゲームの操作方法がわかりません。"}, {"type": "subtitle", "time": 507.43, "timestamp": "00:08:27", "text": "ああ、いや、まるで「"}, {"type": "subtitle", "time": 509.749, "timestamp": "00:08:29", "text": "ああ、ここにヒーローがいる」という感じだ。 わかった。"}, {"type": "subtitle", "time": 527.11, "timestamp": "00:08:47", "text": "彼は30秒後に来るでしょう。"}, {"type": "subtitle", "time": 527.67, "timestamp": "00:08:47", "text": "強くありなさい。   私を見て。"}, {"type": "subtitle", "time": 531.269, "timestamp": "00:08:51", "text": "私は彼に乗っている。"}, {"type": "subtitle", "time": 533.829, "timestamp": "00:08:53", "text": "領主の称号は、"}, {"type": "subtitle", "time": 537.096, "timestamp": "00:08:57", "text": "王族の血を引く者にのみ与えられるべきである。"}, {"type": "subtitle", "time": 538.23, "timestamp": "00:08:58", "text": "[音楽]"}]
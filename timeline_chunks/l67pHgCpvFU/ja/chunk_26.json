[{"type": "subtitle", "time": 1570.39, "timestamp": "00:26:10", "text": "ヴェノムを見てみろ。 彼は次々と敵を倒している"}, {"type": "subtitle", "time": 1572.87, "timestamp": "00:26:12", "text": "。"}, {"type": "subtitle", "time": 1595.11, "timestamp": "00:26:35", "text": "あ、待って。 何？ 何が起こっていますか？ 何が"}, {"type": "subtitle", "time": 1596.39, "timestamp": "00:26:36", "text": "起こっていますか？"}, {"type": "subtitle", "time": 1599.909, "timestamp": "00:26:39", "text": "ジョーは「やりすぎよ」と言った。 ジョー。   何てことだ"}, {"type": "subtitle", "time": 1615.11, "timestamp": "00:26:55", "text": "弾薬もこれに含まれますか？"}]
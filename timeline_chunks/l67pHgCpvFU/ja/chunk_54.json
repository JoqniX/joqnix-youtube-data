[{"type": "subtitle", "time": 3248.71, "timestamp": "00:54:08", "text": "あなたは任務の半分以上を達成しました"}, {"type": "subtitle", "time": 3256.63, "timestamp": "00:54:16", "text": "私はショーを披露する準備ができています。"}, {"type": "subtitle", "time": 3259.307, "timestamp": "00:54:19", "text": "ああ、彼は私の不具合から逃れたばかりだ。"}, {"type": "subtitle", "time": 3259.67, "timestamp": "00:54:19", "text": "[叫び声]"}, {"type": "subtitle", "time": 3262.39, "timestamp": "00:54:22", "text": "スパイダーはパンチする準備ができています。"}, {"type": "subtitle", "time": 3278.309, "timestamp": "00:54:38", "text": "彼女は自分の年を無駄にしたんだ、兄弟。"}, {"type": "subtitle", "time": 3280.71, "timestamp": "00:54:40", "text": "サイロックは彼女の才能を無駄にした。 彼女は"}, {"type": "subtitle", "time": 3283.349, "timestamp": "00:54:43", "text": "戻ってこようとしていた。"}, {"type": "subtitle", "time": 3285.99, "timestamp": "00:54:45", "text": "ああ、なんてこった。"}]
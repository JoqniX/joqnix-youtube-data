[{"type": "subtitle", "time": 10865.83, "timestamp": "03:01:05", "text": "多元宇宙は無限の"}, {"type": "subtitle", "time": 10866.55, "timestamp": "03:01:06", "text": "可能性を秘めている。"}, {"type": "subtitle", "time": 10869.51, "timestamp": "03:01:09", "text": "30秒後に到着します。"}, {"type": "subtitle", "time": 10871.67, "timestamp": "03:01:11", "text": "面白いことに、実は私は"}, {"type": "subtitle", "time": 10874.71, "timestamp": "03:01:14", "text": "オーバーウォッチが好きではなかったんです。 私は多くの"}, {"type": "subtitle", "time": 10875.19, "timestamp": "03:01:15", "text": "奇妙な人に出会った。   あの"}, {"type": "subtitle", "time": 10880.71, "timestamp": "03:01:20", "text": "ゲームはほんの少ししかプレイしなかったと思う。 ああ、まだそうだった。うん、"}, {"type": "subtitle", "time": 10882.07, "timestamp": "03:01:22", "text": "最初の試みではなかった。"}, {"type": "subtitle", "time": 10903.59, "timestamp": "03:01:43", "text": "次元間の境界が"}, {"type": "subtitle", "time": 10906.309, "timestamp": "03:01:46", "text": "崩れつつある。 彼らを守るのは私たちの責任だ"}, {"type": "subtitle", "time": 10908.309, "timestamp": "03:01:48", "text": "。"}]
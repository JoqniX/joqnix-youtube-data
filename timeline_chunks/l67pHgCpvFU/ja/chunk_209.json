[{"type": "subtitle", "time": 12546.659, "timestamp": "03:29:06", "text": "また戦車キャラで遊んでるよ。"}, {"type": "subtitle", "time": 12552.71, "timestamp": "03:29:12", "text": "私は彼らと遊び続けています。"}, {"type": "subtitle", "time": 12558.79, "timestamp": "03:29:18", "text": "[笑い]"}, {"type": "subtitle", "time": 12561.67, "timestamp": "03:29:21", "text": "これらの配信はスナイピングですか？"}, {"type": "subtitle", "time": 12574.95, "timestamp": "03:29:34", "text": "十分速く動けると思っているのか？"}, {"type": "subtitle", "time": 12585.19, "timestamp": "03:29:45", "text": "。 このような。"}, {"type": "subtitle", "time": 12586.63, "timestamp": "03:29:46", "text": "え、"}, {"type": "subtitle", "time": 12588.389, "timestamp": "03:29:48", "text": "返信してくれないと思うんだけど"}, {"type": "subtitle", "time": 12591.19, "timestamp": "03:29:51", "text": "。"}, {"type": "subtitle", "time": 12599.19, "timestamp": "03:29:59", "text": "君がやるべきことは、"}]
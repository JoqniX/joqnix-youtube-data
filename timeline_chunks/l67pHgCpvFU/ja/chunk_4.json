[{"type": "chat", "time": 240.081, "timestamp": "00:04:00", "author": "@JorgeLopez-u8f", "avatar": "https://yt4.ggpht.com/UNCiCGX4xcFHoQfa6cOKciX1n8RRSTGwMho79f2Q61T9FOKoYq9UnbsgpnSYujXp94KpJQOHchw=s64-c-k-c0x00ffffff-no-rj", "message": "Hi there!"}, {"type": "subtitle", "time": 241.429, "timestamp": "00:04:01", "text": "それで、最近どうですか？ お元気ですか"}, {"type": "subtitle", "time": 249.03, "timestamp": "00:04:09", "text": "私は何度も不運に見舞われてきました。まるで"}, {"type": "chat", "time": 250.91, "timestamp": "00:04:10", "author": "@JorgeLopez-u8f", "avatar": "https://yt4.ggpht.com/UNCiCGX4xcFHoQfa6cOKciX1n8RRSTGwMho79f2Q61T9FOKoYq9UnbsgpnSYujXp94KpJQOHchw=s64-c-k-c0x00ffffff-no-rj", "message": "I’m good"}, {"type": "subtitle", "time": 252.47, "timestamp": "00:04:12", "text": "不運の連続のようです。 でも、私はまだ頑張っています"}, {"type": "subtitle", "time": 260.789, "timestamp": "00:04:20", "text": "。 道場。"}, {"type": "subtitle", "time": 263.189, "timestamp": "00:04:23", "text": "ええ、順調です。 私は"}, {"type": "subtitle", "time": 265.43, "timestamp": "00:04:25", "text": "ストリーミング配信に復帰しました。"}, {"type": "subtitle", "time": 271.27, "timestamp": "00:04:31", "text": "えーと、あと、えーと、しばらくの間"}, {"type": "subtitle", "time": 278.629, "timestamp": "00:04:38", "text": "コラボ配信はしないと自分に言ったと思うんだ"}, {"type": "subtitle", "time": 281.03, "timestamp": "00:04:41", "text": "けど、"}, {"type": "subtitle", "time": 284.55, "timestamp": "00:04:44", "text": "大丈夫だと思う。 久しぶりに"}, {"type": "subtitle", "time": 286.55, "timestamp": "00:04:46", "text": "コラボ配信をするのは今回が初めてだと思います"}, {"type": "subtitle", "time": 290.629, "timestamp": "00:04:50", "text": "。 でも、"}, {"type": "subtitle", "time": 293.59000000000003, "timestamp": "00:04:53", "text": "あなたを最初のコラボ相手として迎えられて嬉しいです。"}, {"type": "subtitle", "time": 295.43, "timestamp": "00:04:55", "text": "うん、"}, {"type": "subtitle", "time": 297.189, "timestamp": "00:04:57", "text": "私も。   さあ行こう"}]
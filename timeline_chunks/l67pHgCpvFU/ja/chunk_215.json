[{"type": "subtitle", "time": 12908.71, "timestamp": "03:35:08", "text": "男となったが、この鉄拳はユイを放っておかないだろう"}, {"type": "subtitle", "time": 12923.289, "timestamp": "03:35:23", "text": "私の運命はもはや消え去るようなものではない。"}, {"type": "subtitle", "time": 12950.63, "timestamp": "03:35:50", "text": "おお。"}, {"type": "subtitle", "time": 12959.349, "timestamp": "03:35:59", "text": "彼らのチームの進捗状況は"}]
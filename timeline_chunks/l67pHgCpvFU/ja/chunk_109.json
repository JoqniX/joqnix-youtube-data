[{"type": "subtitle", "time": 6551.75, "timestamp": "01:49:11", "text": "私の仕事は"}, {"type": "subtitle", "time": 6561.43, "timestamp": "01:49:21", "text": "おお、すごいぞ。 私はドクター・ストレンジを治すことはできません"}, {"type": "subtitle", "time": 6562.87, "timestamp": "01:49:22", "text": "。"}, {"type": "subtitle", "time": 6566.229, "timestamp": "01:49:26", "text": "でも、彼を治してあげるべきだった。"}, {"type": "subtitle", "time": 6568.47, "timestamp": "01:49:28", "text": "彼は私にとってはあまりにも遠く離れすぎていて、"}, {"type": "subtitle", "time": 6578.79, "timestamp": "01:49:38", "text": "ああ。"}]
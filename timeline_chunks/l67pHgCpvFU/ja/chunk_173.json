[{"type": "subtitle", "time": 10383.269, "timestamp": "02:53:03", "text": "その車両をシールド内で停止させる必要があります"}, {"type": "subtitle", "time": 10390.95, "timestamp": "02:53:10", "text": "。 彼らは私を中に引きずり込んだ"}, {"type": "subtitle", "time": 10392.15, "timestamp": "02:53:12", "text": "。私は"}, {"type": "subtitle", "time": 10423.125, "timestamp": "02:53:43", "text": "私の運命は今や消え去る運命だ。"}]
[{"type": "subtitle", "time": 12001.67, "timestamp": "03:20:01", "text": "彼のことはよく覚えています。 私たちは"}, {"type": "subtitle", "time": 12003.349, "timestamp": "03:20:03", "text": "かつて恋人同士になりかけたことがあった。"}, {"type": "subtitle", "time": 12005.51, "timestamp": "03:20:05", "text": "まあ、それで全てがわかるね。"}, {"type": "subtitle", "time": 12009.59, "timestamp": "03:20:09", "text": "戦闘開始まで、5、4、3、2、1"}, {"type": "subtitle", "time": 12011.99, "timestamp": "03:20:11", "text": "。"}, {"type": "subtitle", "time": 12013.429, "timestamp": "03:20:13", "text": "君がやるべきことは、"}, {"type": "subtitle", "time": 12016.63, "timestamp": "03:20:16", "text": "ミッションを成功させることだけだ。 みんな、君たちが"}, {"type": "subtitle", "time": 12018.229, "timestamp": "03:20:18", "text": "実在するなんて信じてないよな"}, {"type": "subtitle", "time": 12019.03, "timestamp": "03:20:19", "text": "？"}, {"type": "subtitle", "time": 12043.83, "timestamp": "03:20:43", "text": "任務区域はあなたのものになりそうです。"}, {"type": "subtitle", "time": 12049.349, "timestamp": "03:20:49", "text": "ありがとう。 ありがとう。 ありがとう。 何てことだ"}]
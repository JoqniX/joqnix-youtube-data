[{"type": "chat", "time": 9302.768, "timestamp": "02:35:02", "author": "@Dragnozer", "avatar": "https://yt4.ggpht.com/S76Kh7cHFwpQNz9yjhQC88CHN2CaFRgcX6E1lcl7bEXBNP_DPdf1iSETHK2qlrHYkwo6BbPw=s64-c-k-c0x00ffffff-no-rj", "message": "didnt know you played rivals"}, {"type": "subtitle", "time": 9318.309, "timestamp": "02:35:18", "text": "私は遊び方を知っている。 私"}, {"type": "subtitle", "time": 9321.429, "timestamp": "02:35:21", "text": "のPCでは動作が非常に重いため、このゲームはほとんどプレイしていません。"}, {"type": "subtitle", "time": 9325.429, "timestamp": "02:35:25", "text": "このゲームを配信するために、OBSに戻らざるを得なかった。"}, {"type": "subtitle", "time": 9328.23, "timestamp": "02:35:28", "text": "そして、Battlefield 6やFar LightのようなGPU負荷の高いゲームをプレイするときだけOBSに切り替えます"}, {"type": "subtitle", "time": 9336.07, "timestamp": "02:35:36", "text": "。"}, {"type": "subtitle", "time": 9337.51, "timestamp": "02:35:37", "text": "でも、ここ数日配信している他の2つのゲームは、"}, {"type": "subtitle", "time": 9345.83, "timestamp": "02:35:45", "text": "メタルスタジオで問題なくプレイできています。 しかし、"}, {"type": "subtitle", "time": 9348.63, "timestamp": "02:35:48", "text": "こういったゲームをプレイするには、高性能なGPUが必要だ"}]
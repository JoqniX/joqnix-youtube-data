[{"type": "subtitle", "time": 12301.349, "timestamp": "03:25:01", "text": "さようなら。"}, {"type": "subtitle", "time": 12304.229, "timestamp": "03:25:04", "text": "こんにちは、オニキス。 えっと、レッドブルさん、配信へようこ​​そ"}, {"type": "subtitle", "time": 12306.229, "timestamp": "03:25:06", "text": "。"}, {"type": "subtitle", "time": 12310.95, "timestamp": "03:25:10", "text": "待って、私は…それは間違ったやり方です。 わかった。   なんてこった"}, {"type": "subtitle", "time": 12326.95, "timestamp": "03:25:26", "text": "私はヒンディー語が読めない。 私が"}, {"type": "subtitle", "time": 12328.87, "timestamp": "03:25:28", "text": "死んでしまって残念です。"}, {"type": "subtitle", "time": 12337.19, "timestamp": "03:25:37", "text": "意味ですか？"}, {"type": "subtitle", "time": 12340.79, "timestamp": "03:25:40", "text": "混沌の中から生まれ変わった。"}, {"type": "subtitle", "time": 12345.83, "timestamp": "03:25:45", "text": "コメント欄にいます。 えっと、今日の"}, {"type": "subtitle", "time": 12348.79, "timestamp": "03:25:48", "text": "調子はどうですか？ うん、今日はいい一日だよ。"}, {"type": "subtitle", "time": 12357.51, "timestamp": "03:25:57", "text": "ああ、このキャラクターの演じ方がわからない"}]
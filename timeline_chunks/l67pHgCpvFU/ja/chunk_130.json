[{"type": "subtitle", "time": 7801.669, "timestamp": "02:10:01", "text": "マーベル・ライバルズをプレイするのは今回が初めてですよね。"}, {"type": "subtitle", "time": 7803.35, "timestamp": "02:10:03", "text": "はい。"}, {"type": "subtitle", "time": 7803.91, "timestamp": "02:10:03", "text": "イエス。"}, {"type": "subtitle", "time": 7805.43, "timestamp": "02:10:05", "text": "えっと、チュートリアルとかやったの？（笑）"}, {"type": "subtitle", "time": 7810.79, "timestamp": "02:10:10", "text": "はい、そうしました。   やってよかった"}, {"type": "subtitle", "time": 7813.575, "timestamp": "02:10:13", "text": "。 うん。"}, {"type": "subtitle", "time": 7815.51, "timestamp": "02:10:15", "text": "[笑い]"}, {"type": "subtitle", "time": 7819.35, "timestamp": "02:10:19", "text": "はい、どうぞ。 私のID。   ちくしょう"}, {"type": "subtitle", "time": 7821.91, "timestamp": "02:10:21", "text": "。"}, {"type": "subtitle", "time": 7824.229, "timestamp": "02:10:24", "text": "今はコマンドを維持していません。ストリームが現在"}, {"type": "subtitle", "time": 7826.79, "timestamp": "02:10:26", "text": "不安定になっている可能性があるからです"}, {"type": "subtitle", "time": 7834.87, "timestamp": "02:10:34", "text": "ちなみにコマンドはダウンしているので、"}, {"type": "subtitle", "time": 7837.669, "timestamp": "02:10:37", "text": "皆さんも"}, {"type": "subtitle", "time": 7840.149, "timestamp": "02:10:40", "text": "参加できますが、皆さんの"}, {"type": "subtitle", "time": 7843.05, "timestamp": "02:10:43", "text": "コードはわかりません。"}, {"type": "subtitle", "time": 7849.43, "timestamp": "02:10:49", "text": "ええと、実際にどうすればいいのかわかりません"}]
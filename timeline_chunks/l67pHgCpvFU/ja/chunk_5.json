[{"type": "subtitle", "time": 300.31, "timestamp": "00:05:00", "text": "。"}, {"type": "subtitle", "time": 302.71, "timestamp": "00:05:02", "text": "こんにちは。 えっと、待って。 ゲーム内であなたをフレンドに追加しましたよね"}, {"type": "subtitle", "time": 304.87, "timestamp": "00:05:04", "text": "？ 確認してみます。 こんにちは。"}, {"type": "subtitle", "time": 307.749, "timestamp": "00:05:07", "text": "ああ、通知を見落としていたのかもしれません。"}, {"type": "subtitle", "time": 310.15, "timestamp": "00:05:10", "text": "ああ、そうだね。 はい。"}, {"type": "subtitle", "time": 312.87, "timestamp": "00:05:12", "text": "こんにちは。 ええと、あなたのロビーに参加します。 おお。 ああ、挨拶してくれたんですね"}, {"type": "subtitle", "time": 321.11, "timestamp": "00:05:21", "text": "このゲームは大きく変わった。 そうではない"}, {"type": "subtitle", "time": 321.83, "timestamp": "00:05:21", "text": "。"}, {"type": "subtitle", "time": 322.87, "timestamp": "00:05:22", "text": "うん。 うん。"}, {"type": "subtitle", "time": 325.27, "timestamp": "00:05:25", "text": "こんにちは。 それはあなた次第です。"}, {"type": "subtitle", "time": 327.51, "timestamp": "00:05:27", "text": "サーバーがいくつかあるので、"}, {"type": "subtitle", "time": 329.59, "timestamp": "00:05:29", "text": "東京でプレイしたいのかどうかわかりません"}, {"type": "subtitle", "time": 330.31, "timestamp": "00:05:30", "text": "。"}, {"type": "subtitle", "time": 332.95, "timestamp": "00:05:32", "text": "ああ、何でもいいよ。 えっと、待ってください、私も"}, {"type": "subtitle", "time": 337.59000000000003, "timestamp": "00:05:37", "text": "あなたの仲間に入れてください。 待って。"}, {"type": "subtitle", "time": 343.83, "timestamp": "00:05:43", "text": "こんにちは。 ゲーム全体がカクカクしている。 何てことだ。"}, {"type": "subtitle", "time": 345.909, "timestamp": "00:05:45", "text": "ああ、いや。"}, {"type": "subtitle", "time": 348.469, "timestamp": "00:05:48", "text": "こんにちは。 わかった。 えーっと、ゲームに切り替える前に、えーっと、"}, {"type": "subtitle", "time": 353.67, "timestamp": "00:05:53", "text": "切断します。えーっと、切断する"}, {"type": "subtitle", "time": 356.79, "timestamp": "00:05:56", "text": "前に"}, {"type": "subtitle", "time": 359.909, "timestamp": "00:05:59", "text": "、ちょっと確認させてください。"}]
[{"type": "subtitle", "time": 7561.109, "timestamp": "02:06:01", "text": "変更点です。 だから、自動化はできないんです。 だから、私が"}, {"type": "subtitle", "time": 7565.03, "timestamp": "02:06:05", "text": "どうするか分かる？ 昔の"}, {"type": "subtitle", "time": 7568.149, "timestamp": "02:06:08", "text": "配信を再生します。 これは私が"}, {"type": "subtitle", "time": 7571.91, "timestamp": "02:06:11", "text": "Rokuとパンで遊んだ時のものだと思う。   ええ"}, {"type": "subtitle", "time": 7577.99, "timestamp": "02:06:17", "text": "、ここでそれを演奏します。"}, {"type": "subtitle", "time": 7579.99, "timestamp": "02:06:19", "text": "待ってくれ、みんな。俺が"}, {"type": "subtitle", "time": 7608.709, "timestamp": "02:06:48", "text": "なぜこの言葉なのか？ でも、私は戻ってきます"}, {"type": "subtitle", "time": 7611.589, "timestamp": "02:06:51", "text": "。"}]
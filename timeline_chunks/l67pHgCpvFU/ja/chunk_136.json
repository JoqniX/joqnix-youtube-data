[{"type": "subtitle", "time": 8161.75, "timestamp": "02:16:01", "text": "試合やゲームの最中みたいに言うね。"}, {"type": "subtitle", "time": 8164.149, "timestamp": "02:16:04", "text": "ゲーム内ではどういう意味ですか？ ちくしょう。"}, {"type": "subtitle", "time": 8166.629, "timestamp": "02:16:06", "text": "それはすごいね。ああ、俺たちも"}, {"type": "subtitle", "time": 8169.109, "timestamp": "02:16:09", "text": "ゲームに参加してるよ。"}, {"type": "subtitle", "time": 8171.03, "timestamp": "02:16:11", "text": "大丈夫。"}, {"type": "subtitle", "time": 8174.39, "timestamp": "02:16:14", "text": "彼らはプレーできる。 ああ、"}, {"type": "subtitle", "time": 8177.99, "timestamp": "02:16:17", "text": "ジョック。 君のスポーツポイントは24,000ポイントだ。"}, {"type": "subtitle", "time": 8181.109, "timestamp": "02:16:21", "text": "なぜウェブサイトを持たないのですか"}, {"type": "subtitle", "time": 8183.669, "timestamp": "02:16:23", "text": "？"}, {"type": "subtitle", "time": 8184.149, "timestamp": "02:16:24", "text": "どれ？   ほら、ほら"}, {"type": "subtitle", "time": 8186.229, "timestamp": "02:16:26", "text": "、みんなが"}, {"type": "subtitle", "time": 8188.31, "timestamp": "02:16:28", "text": "100万ポイントとかのために鞭になり続けるでしょ"}, {"type": "subtitle", "time": 8189.99, "timestamp": "02:16:29", "text": "。"}, {"type": "subtitle", "time": 8192.87, "timestamp": "02:16:32", "text": "ああ、私もそれ持ってたよ。 私はそれを止めました。"}, {"type": "subtitle", "time": 8193.83, "timestamp": "02:16:33", "text": "なぜ？"}, {"type": "subtitle", "time": 8196.709, "timestamp": "02:16:36", "text": "もう一度取り戻さなければならない。 それで、えーと、"}, {"type": "subtitle", "time": 8199.11, "timestamp": "02:16:39", "text": "レベル10に到達します。レベルに到達する必要があります。"}, {"type": "subtitle", "time": 8200.87, "timestamp": "02:16:40", "text": "ランク戦はできません。"}, {"type": "subtitle", "time": 8202.23, "timestamp": "02:16:42", "text": "ええ、わかっています。"}, {"type": "subtitle", "time": 8204.309, "timestamp": "02:16:44", "text": "いいえ、私はレベル10にも達していません。"}, {"type": "subtitle", "time": 8213.589, "timestamp": "02:16:53", "text": "追加してください。 ああ、ゲームが始まったよ。"}, {"type": "subtitle", "time": 8214.07, "timestamp": "02:16:54", "text": "待って。"}, {"type": "subtitle", "time": 8216.469, "timestamp": "02:16:56", "text": "本当にバカだな、あんた。 彼は試合で私たちを救ってくれた。"}, {"type": "subtitle", "time": 8219.679, "timestamp": "02:16:59", "text": "私たちが [笑い] 私たちの"}]
[{"type": "subtitle", "time": 13863.269, "timestamp": "03:51:03", "text": "排除された。   それを"}, {"type": "subtitle", "time": 13867.03, "timestamp": "03:51:07", "text": "教えてください。"}, {"type": "subtitle", "time": 13869.59, "timestamp": "03:51:09", "text": "ダブルキル。"}, {"type": "subtitle", "time": 13914.15, "timestamp": "03:51:54", "text": "狙いを定めるのが難しい。 お前らを殺したいんだ。"}, {"type": "subtitle", "time": 13916.15, "timestamp": "03:51:56", "text": "お前らは奥深くまで来ているし、俺は"}, {"type": "subtitle", "time": 13919.429, "timestamp": "03:51:59", "text": "攻撃されないように距離を保とうとしているんだ"}]
[{"type": "subtitle", "time": 11940.79, "timestamp": "03:19:00", "text": "非常に重要な人物とマッチングする。  [笑い]"}, {"type": "subtitle", "time": 11945.269, "timestamp": "03:19:05", "text": "勝負にならない。 ああ"}, {"type": "subtitle", "time": 11948.95, "timestamp": "03:19:08", "text": "、プレイできない。"}, {"type": "subtitle", "time": 11952.63, "timestamp": "03:19:12", "text": "ああ、そうしないといけない。   なんてこった。"}, {"type": "subtitle", "time": 11966.309, "timestamp": "03:19:26", "text": "本当にそう思います。"}, {"type": "subtitle", "time": 11983.429, "timestamp": "03:19:43", "text": "私もそれなりに間違いを犯してきました。"}, {"type": "subtitle", "time": 11990.87, "timestamp": "03:19:50", "text": "私はお前からどこかで嗅いだことのある神性の気配を感じる"}, {"type": "subtitle", "time": 11993.269, "timestamp": "03:19:53", "text": "。"}, {"type": "subtitle", "time": 11997.51, "timestamp": "03:19:57", "text": "復讐の月の神よ。"}]
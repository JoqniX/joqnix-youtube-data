[{"type": "chat", "time": 1021.762, "timestamp": "00:17:01", "author": "@bakononcopiumm", "avatar": "https://yt4.ggpht.com/hb5sPAHLUD7fBrZZsmfkzISQWwRqI8BY1n8lceyhZz0sNISomD05pCwUe-GL2amD5y-voH_uYw=s64-c-k-c0x00ffffff-no-rj", "message": "go winter soldier, show me the asim"}, {"type": "subtitle", "time": 1022.949, "timestamp": "00:17:02", "text": "フェニックス。"}, {"type": "chat", "time": 1023.921, "timestamp": "00:17:03", "author": "@bakononcopiumm", "avatar": "https://yt4.ggpht.com/hb5sPAHLUD7fBrZZsmfkzISQWwRqI8BY1n8lceyhZz0sNISomD05pCwUe-GL2amD5y-voH_uYw=s64-c-k-c0x00ffffff-no-rj", "message": "*aim"}, {"type": "subtitle", "time": 1025.189, "timestamp": "00:17:05", "text": "フェニックスは"}, {"type": "subtitle", "time": 1029.029, "timestamp": "00:17:09", "text": "弱体化されたはずだ。 覚えていない。 わからない。"}, {"type": "subtitle", "time": 1033.27, "timestamp": "00:17:13", "text": "私はただのカジュアルゲーマーです。"}, {"type": "subtitle", "time": 1036.47, "timestamp": "00:17:16", "text": "ウィンター・ソルジャー。 ああ、ああ、あの人が"}, {"type": "subtitle", "time": 1040.39, "timestamp": "00:17:20", "text": "ここにいる。 ああ、ウィンター・ソルジャー。 ああ、これだ"}, {"type": "subtitle", "time": 1041.189, "timestamp": "00:17:21", "text": "。"}, {"type": "subtitle", "time": 1043.669, "timestamp": "00:17:23", "text": "私は誰かの相棒ではない。 私の仕事は"}, {"type": "subtitle", "time": 1045.909, "timestamp": "00:17:25", "text": "一人で行うのが一番良い。 ウィンター・ソルジャーは、"}, {"type": "subtitle", "time": 1050.87, "timestamp": "00:17:30", "text": "かなり簡単なゲーム、もしくはかなり簡単な"}, {"type": "subtitle", "time": 1052.31, "timestamp": "00:17:32", "text": "キャラクターです。"}, {"type": "subtitle", "time": 1056.63, "timestamp": "00:17:36", "text": "それなら『ウィンター・ソルジャー』を試してみます。   たくさんの"}, {"type": "subtitle", "time": 1060.07, "timestamp": "00:17:40", "text": "新キャラクターが登場すると書いてあります。"}, {"type": "subtitle", "time": 1068.31, "timestamp": "00:17:48", "text": "何かが残っている限り、"}]
[{"type": "subtitle", "time": 5788.39, "timestamp": "01:36:28", "text": "Chaos surrounds us, but I will gladly"}, {"type": "subtitle", "time": 5792.55, "timestamp": "01:36:32", "text": "show it to control."}, {"type": "subtitle", "time": 5802.55, "timestamp": "01:36:42", "text": ">> Sister, how I have missed you. Your"}, {"type": "subtitle", "time": 5805.99, "timestamp": "01:36:45", "text": "spear would be quite welcome. Exgard."}, {"type": "subtitle", "time": 5808.95, "timestamp": "01:36:48", "text": ">> Last I saw our father, he made it very"}, {"type": "subtitle", "time": 5811.669, "timestamp": "01:36:51", "text": "clear that was not the case."}, {"type": "subtitle", "time": 5814.149, "timestamp": "01:36:54", "text": ">> Have you not heard? There is a new king"}, {"type": "subtitle", "time": 5816.39, "timestamp": "01:36:56", "text": "on the throne."}]
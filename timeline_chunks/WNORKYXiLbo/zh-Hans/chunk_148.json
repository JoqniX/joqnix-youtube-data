[{"type": "subtitle", "time": 8881.03, "timestamp": "02:28:01", "text": "欢迎加入，和我聊聊。"}, {"type": "subtitle", "time": 8884.389, "timestamp": "02:28:04", "text": "只要我直播。现在这是开放式风险投资。"}, {"type": "subtitle", "time": 8888.83, "timestamp": "02:28:08", "text": "所以，只要你在线，就可以加入。"}, {"type": "subtitle", "time": 8892.23, "timestamp": "02:28:12", "text": "一切正常。我很感激"}, {"type": "subtitle", "time": 8893.75, "timestamp": "02:28:13", "text": "非常感谢。非常感谢"}, {"type": "subtitle", "time": 8895.99, "timestamp": "02:28:15", "text": "很多。更像是，我看到了你们所有人"}, {"type": "subtitle", "time": 8899.349, "timestamp": "02:28:19", "text": "在网上，但更像是我，我太……"}, {"type": "subtitle", "time": 8901.349, "timestamp": "02:28:21", "text": "尴尬和难堪。所以，就像"}, {"type": "subtitle", "time": 8903.91, "timestamp": "02:28:23", "text": "你要么会看到我保持沉默，要么会看到我保持沉默。"}, {"type": "subtitle", "time": 8912.87, "timestamp": "02:28:32", "text": "多谢。"}, {"type": "subtitle", "time": 8915.83, "timestamp": "02:28:35", "text": "所以，嗯，我会静音。"}, {"type": "subtitle", "time": 8917.91, "timestamp": "02:28:37", "text": "目前情况有所不同。哦，等等。我会"}, {"type": "subtitle", "time": 8919.91, "timestamp": "02:28:39", "text": "实际上，我现在先离开风险投资领域，我会……"}, {"type": "subtitle", "time": 8923.23, "timestamp": "02:28:43", "text": "当我参与社区活动时，请加入"}, {"type": "subtitle", "time": 8926.389, "timestamp": "02:28:46", "text": "新越战。好的。再次感谢您"}, {"type": "subtitle", "time": 8930.309, "timestamp": "02:28:50", "text": "参与其中，意义重大。是的。感谢"}, {"type": "subtitle", "time": 8932.71, "timestamp": "02:28:52", "text": "又是你。是的，我不会涉足风险投资。"}, {"type": "subtitle", "time": 8934.07, "timestamp": "02:28:54", "text": "因为我要离开了，所以有很多话想说。我"}, {"type": "subtitle", "time": 8936.79, "timestamp": "02:28:56", "text": "想跟你打个招呼。总之，谢谢。"}]
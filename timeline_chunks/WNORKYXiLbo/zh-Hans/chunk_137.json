[{"type": "subtitle", "time": 8222.389, "timestamp": "02:17:02", "text": "所以，是的，但是新型号，新的"}, {"type": "subtitle", "time": 8225.07, "timestamp": "02:17:05", "text": "模特没有佩戴耳环或"}, {"type": "subtitle", "time": 8227.95, "timestamp": "02:17:07", "text": "我觉得这样也太……"}, {"type": "subtitle", "time": 8231.589, "timestamp": "02:17:11", "text": "很多。是的，"}, {"type": "subtitle", "time": 8233.99, "timestamp": "02:17:13", "text": "不过我挺喜欢的。我，我是天上的"}, {"type": "subtitle", "time": 8237.03, "timestamp": "02:17:17", "text": "我也很喜欢看到更多空间。"}, {"type": "subtitle", "time": 8240.389, "timestamp": "02:17:20", "text": "或者更像是“是的”。更多空间灵感"}, {"type": "subtitle", "time": 8245.11, "timestamp": "02:17:25", "text": "模型之类的东西。耶。我们是太空帮。"}, {"type": "subtitle", "time": 8252.469, "timestamp": "02:17:32", "text": "是的。也跟我说说你自己的情况吧。如何"}, {"type": "subtitle", "time": 8256.23, "timestamp": "02:17:36", "text": "你的模型也受到了你的启发吗？哦，真是的"}, {"type": "subtitle", "time": 8259.429, "timestamp": "02:17:39", "text": "我非常喜欢《犬夜叉》和《最终幻想14》。"}, {"type": "subtitle", "time": 8262.79, "timestamp": "02:17:42", "text": "幻想。所以，这件事启发了我。"}, {"type": "subtitle", "time": 8264.389, "timestamp": "02:17:44", "text": "比如根据……制作我的模型"}, {"type": "subtitle", "time": 8267.509, "timestamp": "02:17:47", "text": "来自 Inasha 和 Sepharoth 的 Shashomaru"}, {"type": "subtitle", "time": 8271.75, "timestamp": "02:17:51", "text": "出自《最终幻想7》。哦，"}, {"type": "subtitle", "time": 8276.79, "timestamp": "02:17:56", "text": "我也喜欢《转生史莱姆》。所以，我"}, {"type": "subtitle", "time": 8279.669, "timestamp": "02:17:59", "text": "非常喜欢，非常漂亮"}]
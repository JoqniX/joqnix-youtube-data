[{"type": "subtitle", "time": 9181.11, "timestamp": "02:33:01", "text": "流媒体，你真的不想喜欢"}, {"type": "subtitle", "time": 9184.55, "timestamp": "02:33:04", "text": "把所有事情都展示出来，因为呃，每一次"}, {"type": "subtitle", "time": 9186.469, "timestamp": "02:33:06", "text": "过一段时间，一切都变成了你的东西。"}, {"type": "subtitle", "time": 9189.03, "timestamp": "02:33:09", "text": "不想露面。啊，我明白了。"}, {"type": "subtitle", "time": 9191.99, "timestamp": "02:33:11", "text": "稳妥起见，还是通风换气比较好。"}, {"type": "subtitle", "time": 9195.27, "timestamp": "02:33:15", "text": "我以前用的是双电脑配置，所以"}, {"type": "subtitle", "time": 9198.63, "timestamp": "02:33:18", "text": "因为采集卡呃，它只"}, {"type": "subtitle", "time": 9200.87, "timestamp": "02:33:20", "text": "让你感觉它像是一个整体"}, {"type": "subtitle", "time": 9209.59, "timestamp": "02:33:29", "text": "我必须得有个按钮才能……"}, {"type": "subtitle", "time": 9213.83, "timestamp": "02:33:33", "text": "模糊不清之类的。真是太疯狂了。"}, {"type": "subtitle", "time": 9215.349, "timestamp": "02:33:35", "text": "你应该始终保留一个模糊按钮。"}, {"type": "subtitle", "time": 9217.19, "timestamp": "02:33:37", "text": "拥有模糊按钮的人太少了。"}, {"type": "subtitle", "time": 9221.03, "timestamp": "02:33:41", "text": "他们施压。真的。那个紧急按钮"}, {"type": "subtitle", "time": 9226.07, "timestamp": "02:33:46", "text": "非常实用。是的。恐慌。"}, {"type": "subtitle", "time": 9228.87, "timestamp": "02:33:48", "text": "这个追踪器到底是怎么回事？这是"}, {"type": "subtitle", "time": 9231.59, "timestamp": "02:33:51", "text": "这和我预想的反应不一样。所以，"}, {"type": "subtitle", "time": 9234.79, "timestamp": "02:33:54", "text": "你收到了多少个追踪器？就像我"}, {"type": "subtitle", "time": 9236.469, "timestamp": "02:33:56", "text": "应该是八吧？我做了"}]
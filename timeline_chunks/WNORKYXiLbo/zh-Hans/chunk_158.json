[{"type": "subtitle", "time": 9482.309, "timestamp": "02:38:02", "text": "有3D模型了吗？我确实有一个Veroid的。"}, {"type": "subtitle", "time": 9486.469, "timestamp": "02:38:06", "text": "呃，但是，嗯，是的，还没完全修好。"}, {"type": "subtitle", "time": 9489.19, "timestamp": "02:38:09", "text": "向上。它没有包含这个"}, {"type": "subtitle", "time": 9491.67, "timestamp": "02:38:11", "text": "当前设计。所以我必须做一个"}, {"type": "subtitle", "time": 9493.67, "timestamp": "02:38:13", "text": "新的"}, {"type": "subtitle", "time": 9495.99, "timestamp": "02:38:15", "text": "它采用了这种电流设计。"}, {"type": "subtitle", "time": 9497.51, "timestamp": "02:38:17", "text": "是的。"}, {"type": "subtitle", "time": 9500.389, "timestamp": "02:38:20", "text": "好的。祝你好运。是的。感谢"}, {"type": "subtitle", "time": 9502.63, "timestamp": "02:38:22", "text": "你。是的。如果你想永远"}, {"type": "subtitle", "time": 9504.79, "timestamp": "02:38:24", "text": "就像玩3D游戏一样。"}, {"type": "subtitle", "time": 9507.11, "timestamp": "02:38:27", "text": "无需花费 200 美元即可进行追踪"}, {"type": "subtitle", "time": 9509.99, "timestamp": "02:38:29", "text": "单追踪器，呃，看看 Slime VR。"}, {"type": "subtitle", "time": 9513.19, "timestamp": "02:38:33", "text": "你其实可以使用任天堂 Joy-Con 手柄。"}, {"type": "subtitle", "time": 9517.75, "timestamp": "02:38:37", "text": "哦，用Switch手柄做追踪器。"}, {"type": "subtitle", "time": 9520.07, "timestamp": "02:38:40", "text": "哦，我有个朋友确实有"}, {"type": "subtitle", "time": 9522.63, "timestamp": "02:38:42", "text": "史莱姆VR。是的。是的。是的。我听说是"}, {"type": "subtitle", "time": 9525.67, "timestamp": "02:38:45", "text": "呃，等等，难道不需要一段时间才能得到吗？"}, {"type": "subtitle", "time": 9530.15, "timestamp": "02:38:50", "text": "虽然已经发货了？嗯，是的。呃，但是如果你"}, {"type": "subtitle", "time": 9532.15, "timestamp": "02:38:52", "text": "您可以自己组装，也可以直接订购。"}, {"type": "subtitle", "time": 9534.389, "timestamp": "02:38:54", "text": "使用通用零件，然后组装起来。"}, {"type": "subtitle", "time": 9535.99, "timestamp": "02:38:55", "text": "哦，原来是你做的。你不必"}, {"type": "subtitle", "time": 9539.91, "timestamp": "02:38:59", "text": "等待。是的，我是从速卖通上订购的。"}]
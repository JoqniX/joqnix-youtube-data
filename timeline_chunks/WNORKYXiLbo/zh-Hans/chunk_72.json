[{"type": "subtitle", "time": 4328.95, "timestamp": "01:12:08", "text": "永远？是的，这些人来自莫因"}, {"type": "subtitle", "time": 4331.75, "timestamp": "01:12:11", "text": "实验室，对吧？他们有账户系统，"}, {"type": "subtitle", "time": 4334.31, "timestamp": "01:12:14", "text": "通用账户系统就像……"}, {"type": "subtitle", "time": 4337.669, "timestamp": "01:12:17", "text": "生态系统中，呃，采矿实验室有"}, {"type": "subtitle", "time": 4339.669, "timestamp": "01:12:19", "text": "单一账户系统。所以任何"}, {"type": "subtitle", "time": 4341.91, "timestamp": "01:12:21", "text": "其他类似的项目，你只需要做一个。"}, {"type": "subtitle", "time": 4344.709, "timestamp": "01:12:24", "text": "您仍然可以像以前一样转移账户"}, {"type": "subtitle", "time": 4346.63, "timestamp": "01:12:26", "text": "或与其他帐户同步"}, {"type": "subtitle", "time": 4349.35, "timestamp": "01:12:29", "text": "他们的项目等等。真酷。"}, {"type": "subtitle", "time": 4351.43, "timestamp": "01:12:31", "text": "这就是我想要的店铺风格。但我"}, {"type": "subtitle", "time": 4354.07, "timestamp": "01:12:34", "text": "不懂编程。我不懂编程。"}, {"type": "subtitle", "time": 4356.31, "timestamp": "01:12:36", "text": "展示。是的。莫因 ID。是的。相同"}, {"type": "subtitle", "time": 4358.91, "timestamp": "01:12:38", "text": "事物。这就是我"}, {"type": "subtitle", "time": 4361.63, "timestamp": "01:12:41", "text": "我想要的就是那种感觉。"}, {"type": "subtitle", "time": 4365.87, "timestamp": "01:12:45", "text": "会员门户网站之类的东西。"}, {"type": "subtitle", "time": 4369.35, "timestamp": "01:12:49", "text": "是啊，因为现在我为什么想要……"}, {"type": "subtitle", "time": 4372.63, "timestamp": "01:12:52", "text": "有网站，还有各种各样的东西。"}, {"type": "subtitle", "time": 4375.47, "timestamp": "01:12:55", "text": "我为什么要付出额外的努力？"}, {"type": "subtitle", "time": 4377.669, "timestamp": "01:12:57", "text": "因为我必须思考，我必须思考"}]
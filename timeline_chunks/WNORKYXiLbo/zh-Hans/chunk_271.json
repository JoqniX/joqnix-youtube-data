[{"type": "subtitle", "time": 16262.389, "timestamp": "04:31:02", "text": "天。我以前做过一些小部件之类的东西。"}, {"type": "subtitle", "time": 16263.229, "timestamp": "04:31:03", "text": "为了"}, {"type": "subtitle", "time": 16265.91, "timestamp": "04:31:05", "text": "溪流。很有趣。即使是"}, {"type": "subtitle", "time": 16269.469, "timestamp": "04:31:09", "text": "一些小事，但它让我……"}, {"type": "subtitle", "time": 16273.189, "timestamp": "04:31:13", "text": "很高兴能让直播更有吸引力。"}, {"type": "subtitle", "time": 16275.149, "timestamp": "04:31:15", "text": "和"}, {"type": "subtitle", "time": 16277.75, "timestamp": "04:31:17", "text": "有趣。观众参与度也"}, {"type": "subtitle", "time": 16279.99, "timestamp": "04:31:19", "text": "一件重要的事情。"}, {"type": "subtitle", "time": 16282.95, "timestamp": "04:31:22", "text": "是啊，因为我注意到，呃，那件事……"}, {"type": "subtitle", "time": 16285.429, "timestamp": "04:31:25", "text": "Joathon 中缺少的就是这一点，对吧？"}, {"type": "subtitle", "time": 16287.99, "timestamp": "04:31:27", "text": "提高参与度。没有更多了"}, {"type": "subtitle", "time": 16291.75, "timestamp": "04:31:31", "text": "对大多数人来说，这不难做到吗？唯一"}, {"type": "subtitle", "time": 16293.429, "timestamp": "04:31:33", "text": "问题是你在跟我聊天，而你"}, {"type": "subtitle", "time": 16296.83, "timestamp": "04:31:36", "text": "观察、潜伏之类的。那是"}, {"type": "subtitle", "time": 16301.349, "timestamp": "04:31:41", "text": "它。是的。我为此感到难过。"}, {"type": "subtitle", "time": 16304.11, "timestamp": "04:31:44", "text": "我正在同时进行多项任务，很难喜欢"}, {"type": "subtitle", "time": 16308.469, "timestamp": "04:31:48", "text": "把那个东西提供给所有平台。"}, {"type": "subtitle", "time": 16309.55, "timestamp": "04:31:49", "text": "所以是"}, {"type": "subtitle", "time": 16313.55, "timestamp": "04:31:53", "text": "痛苦地谈论着比利比利那边。所以"}, {"type": "subtitle", "time": 16316.55, "timestamp": "04:31:56", "text": "是的，我们要去日本留学。呃"}, {"type": "subtitle", "time": 16318.99, "timestamp": "04:31:58", "text": "这个为期两年的课程是为了学习"}]
[{"type": "subtitle", "time": 18181.43, "timestamp": "05:03:01", "text": "想去，但又觉得……嗯"}, {"type": "subtitle", "time": 18184.27, "timestamp": "05:03:04", "text": "呃，我得走了。计划原本就是这样，但是"}, {"type": "subtitle", "time": 18187.59, "timestamp": "05:03:07", "text": "那就像是，如果这样就没关系了。"}, {"type": "subtitle", "time": 18189.75, "timestamp": "05:03:09", "text": "你不想来这里胡闹"}, {"type": "subtitle", "time": 18191.708, "timestamp": "05:03:11", "text": "你很忙，而且"}, {"type": "subtitle", "time": 18195.35, "timestamp": "05:03:15", "text": "东西。所以我就想，好吧，行吧。但是爸爸"}, {"type": "subtitle", "time": 18197.83, "timestamp": "05:03:17", "text": "有人问我是否愿意点赞，如果你想的话。"}, {"type": "subtitle", "time": 18200.948, "timestamp": "05:03:20", "text": "安排一天的时间去见见你的同类"}, {"type": "subtitle", "time": 18203.27, "timestamp": "05:03:23", "text": "爸爸的祖母，就是她"}, {"type": "subtitle", "time": 18206.868, "timestamp": "05:03:26", "text": "奶奶老鼠的妈妈之类的，因为我"}, {"type": "subtitle", "time": 18208.948, "timestamp": "05:03:28", "text": "现在连看都看不到他们了。"}, {"type": "subtitle", "time": 18212.788, "timestamp": "05:03:32", "text": "如果我再去日本，我就不会了。"}, {"type": "subtitle", "time": 18215.43, "timestamp": "05:03:35", "text": "能够回来这里两年"}, {"type": "subtitle", "time": 18218.07, "timestamp": "05:03:38", "text": "除非是紧急情况，否则至少不应该这样做。"}, {"type": "subtitle", "time": 18221.27, "timestamp": "05:03:41", "text": "如果我获得了官方许可"}, {"type": "subtitle", "time": 18233.19, "timestamp": "05:03:53", "text": "夏季度假期间或外出度假"}, {"type": "subtitle", "time": 18235.11, "timestamp": "05:03:55", "text": "我将休假两到三周。"}, {"type": "subtitle", "time": 18238.35, "timestamp": "05:03:58", "text": "我猜有两个假期"}]
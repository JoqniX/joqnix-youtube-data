[{"type": "subtitle", "time": 10681.269, "timestamp": "02:58:01", "text": "事物。我觉得我需要惊呼一声“我的天哪”。做过"}, {"type": "subtitle", "time": 10683.11, "timestamp": "02:58:03", "text": "我崩溃了，我的天哪。我必须小心谨慎。"}, {"type": "subtitle", "time": 10685.71, "timestamp": "02:58:05", "text": "和这只大猩猩。不是大猩猩。"}, {"type": "subtitle", "time": 10688.269, "timestamp": "02:58:08", "text": "嗯，鹅颈"}, {"type": "subtitle", "time": 10695.429, "timestamp": "02:58:15", "text": "我需要调整一下，因为问题是……"}, {"type": "subtitle", "time": 10697.67, "timestamp": "02:58:17", "text": "现在我不知道你是怎么放手机的。"}, {"type": "subtitle", "time": 10700.19, "timestamp": "02:58:20", "text": "跟踪您的"}, {"type": "subtitle", "time": 10703.349, "timestamp": "02:58:23", "text": "模型。就像我有一个普通的手机支架。"}, {"type": "subtitle", "time": 10706.269, "timestamp": "02:58:26", "text": "一。我可以这样说"}, {"type": "subtitle", "time": 10708.91, "timestamp": "02:58:28", "text": "这。你在追踪吗？"}, {"type": "subtitle", "time": 10716.429, "timestamp": "02:58:36", "text": "你好。等待。啊，它没有跟踪到目标。"}, {"type": "subtitle", "time": 10722.23, "timestamp": "02:58:42", "text": "我。喂。喂。喂。喂。"}, {"type": "subtitle", "time": 10725.71, "timestamp": "02:58:45", "text": "我是否对你来说重要？"}, {"type": "subtitle", "time": 10727.389, "timestamp": "02:58:47", "text": "某物？"}]
[{"type": "subtitle", "time": 10020.03, "timestamp": "02:47:00", "text": "也。我不知道你有没有注意到"}, {"type": "subtitle", "time": 10023.91, "timestamp": "02:47:03", "text": "当时我正竭尽全力不去……呃"}, {"type": "subtitle", "time": 10026.87, "timestamp": "02:47:06", "text": "特别冒犯或类似的话"}, {"type": "subtitle", "time": 10028.79, "timestamp": "02:47:08", "text": "和"}, {"type": "subtitle", "time": 10031.11, "timestamp": "02:47:11", "text": "呃，现在连代词和其他一切都变了。"}, {"type": "subtitle", "time": 10033.429, "timestamp": "02:47:13", "text": "是的。"}, {"type": "subtitle", "time": 10038.75, "timestamp": "02:47:18", "text": "幸好日本的太阳……"}, {"type": "subtitle", "time": 10042.07, "timestamp": "02:47:22", "text": "以你的方式也能奏效"}, {"type": "subtitle", "time": 10043.91, "timestamp": "02:47:23", "text": "给予他们更多尊重，而不是指责他们"}, {"type": "subtitle", "time": 10046.56, "timestamp": "02:47:26", "text": "正式地对待他们。所以"}, {"type": "subtitle", "time": 10055.429, "timestamp": "02:47:35", "text": "是啊，你觉得我应该喜欢吗？"}, {"type": "subtitle", "time": 10057.95, "timestamp": "02:47:37", "text": "我跟所有交谈过的人都成了朋友。"}, {"type": "subtitle", "time": 10060.95, "timestamp": "02:47:40", "text": "和？我不知道。我觉得就是这样"}, {"type": "subtitle", "time": 10069.91, "timestamp": "02:47:49", "text": "种类？就像有被屏蔽的用户一样。"}, {"type": "subtitle", "time": 10072.71, "timestamp": "02:47:52", "text": "还有聊天功能。你可以聊天"}, {"type": "subtitle", "time": 10074.75, "timestamp": "02:47:54", "text": "实际上与"}]
[{"type": "subtitle", "time": 3961.349, "timestamp": "01:06:01", "text": "兄弟，这就是为什么我的一部分也是这样。"}, {"type": "subtitle", "time": 3963.87, "timestamp": "01:06:03", "text": "非常想使用门户网站，但是……"}, {"type": "subtitle", "time": 3966.63, "timestamp": "01:06:06", "text": "这对创作者来说是好事，他们应该拥有自己的"}, {"type": "subtitle", "time": 3970.75, "timestamp": "01:06:10", "text": "周边商店或者一些免费的东西"}, {"type": "subtitle", "time": 3974.15, "timestamp": "01:06:14", "text": "一切都无关紧要，但……嗯，这不是重点。"}, {"type": "subtitle", "time": 3977.51, "timestamp": "01:06:17", "text": "对我来说，我也想要，我会，我计划"}, {"type": "subtitle", "time": 3979.63, "timestamp": "01:06:19", "text": "其他东西"}, {"type": "subtitle", "time": 3988.12, "timestamp": "01:06:28", "text": "是的，显示成员页面"}, {"type": "subtitle", "time": 3990.109, "timestamp": "01:06:30", "text": "[音乐]"}, {"type": "subtitle", "time": 3992.549, "timestamp": "01:06:32", "text": "一切。所以，但是我没有"}, {"type": "subtitle", "time": 3995.91, "timestamp": "01:06:35", "text": "有人能帮帮我吗？所以，我"}, {"type": "subtitle", "time": 3997.67, "timestamp": "01:06:37", "text": "就好像我把它放在后面一样"}, {"type": "subtitle", "time": 3999.589, "timestamp": "01:06:39", "text": "刻录机。"}, {"type": "subtitle", "time": 4008.63, "timestamp": "01:06:48", "text": "嗯，甚至，我真希望我能做一个网站"}, {"type": "subtitle", "time": 4010.63, "timestamp": "01:06:50", "text": "除了我的工作以外，其他一切都挺好的。"}, {"type": "subtitle", "time": 4013.95, "timestamp": "01:06:53", "text": "道路。未来就业"}, {"type": "subtitle", "time": 4018.19, "timestamp": "01:06:58", "text": "也。不用担心。专注于你自己"}, {"type": "subtitle", "time": 4019.87, "timestamp": "01:06:59", "text": "东西。"}]
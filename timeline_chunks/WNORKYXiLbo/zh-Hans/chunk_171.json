[{"type": "subtitle", "time": 10274.91, "timestamp": "02:51:14", "text": "嗯"}, {"type": "subtitle", "time": 10277.07, "timestamp": "02:51:17", "text": "是的，人们是"}, {"type": "subtitle", "time": 10279.469, "timestamp": "02:51:19", "text": "尊重。我是"}, {"type": "subtitle", "time": 10283.79, "timestamp": "02:51:23", "text": "开心是因为现在，嗯，内心深处我"}, {"type": "subtitle", "time": 10286.59, "timestamp": "02:51:26", "text": "感到不安"}, {"type": "subtitle", "time": 10289.91, "timestamp": "02:51:29", "text": "因为我不想做千篇一律的事情。"}, {"type": "subtitle", "time": 10292.71, "timestamp": "02:51:32", "text": "现在这种 YouTuber 风格的东西就像"}, {"type": "subtitle", "time": 10294.95, "timestamp": "02:51:34", "text": "尤其是为了参加运动马拉松。"}, {"type": "subtitle", "time": 10298.469, "timestamp": "02:51:38", "text": "我这是在嘲讽对手，对吧？我不是"}, {"type": "subtitle", "time": 10300.59, "timestamp": "02:51:40", "text": "在适当的嘲讽之后"}, {"type": "subtitle", "time": 10302.349, "timestamp": "02:51:42", "text": "东西"}, {"type": "subtitle", "time": 10305.59, "timestamp": "02:51:45", "text": "以及所有这些东西。尤其是那件事"}, {"type": "subtitle", "time": 10308.389, "timestamp": "02:51:48", "text": "就像两万分之一的人能脱颖而出一样。"}, {"type": "subtitle", "time": 10311.269, "timestamp": "02:51:51", "text": "不，那样反而会让人产生误解。"}, {"type": "subtitle", "time": 10314.389, "timestamp": "02:51:54", "text": "好像不太顺利似的"}, {"type": "subtitle", "time": 10318.349, "timestamp": "02:51:58", "text": "或者就像人们可能会假设的那样"}]
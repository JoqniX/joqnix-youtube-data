[{"type": "subtitle", "time": 4742.709, "timestamp": "01:19:02", "text": "像列表一样，或者像在……上展示一样"}, {"type": "subtitle", "time": 4743.55, "timestamp": "01:19:03", "text": "一个"}, {"type": "subtitle", "time": 4746.149, "timestamp": "01:19:06", "text": "你需要考虑的数据库"}, {"type": "subtitle", "time": 4748.55, "timestamp": "01:19:08", "text": "巴基斯坦 YouTuber，孟加拉国"}, {"type": "subtitle", "time": 4750.87, "timestamp": "01:19:10", "text": "YouTuber 和其他所有人一样"}, {"type": "subtitle", "time": 4753.75, "timestamp": "01:19:13", "text": "各国及周边国家"}, {"type": "subtitle", "time": 4756.87, "timestamp": "01:19:16", "text": "尼泊尔的YouTube博主等等。不，你必须这样做。"}, {"type": "subtitle", "time": 4762.47, "timestamp": "01:19:22", "text": "比如，呃，获取那些呃类别"}, {"type": "subtitle", "time": 4765.07, "timestamp": "01:19:25", "text": "就像一份人员名单"}, {"type": "subtitle", "time": 4767.43, "timestamp": "01:19:27", "text": "也。但仔细想想，我还没有"}, {"type": "subtitle", "time": 4775.35, "timestamp": "01:19:35", "text": "然而。孟加拉国的YouTube博主。是的，只有"}, {"type": "subtitle", "time": 4778.03, "timestamp": "01:19:38", "text": "像三四个这样的就很少了。"}, {"type": "subtitle", "time": 4781.189, "timestamp": "01:19:41", "text": "五点左右。我曾与巴基斯坦人合作过"}, {"type": "subtitle", "time": 4784.709, "timestamp": "01:19:44", "text": "和。嗯，我想，呃，我确实和……合作过"}, {"type": "subtitle", "time": 4788.229, "timestamp": "01:19:48", "text": "其中三个，我知道我有。"}, {"type": "subtitle", "time": 4792.47, "timestamp": "01:19:52", "text": "除了我所在的三个之外，周围还有其他人。"}, {"type": "subtitle", "time": 4796.59, "timestamp": "01:19:56", "text": "大约在两到五个地方见过。"}]
[{"type": "subtitle", "time": 16022.229, "timestamp": "04:27:02", "text": "我害怕的是，我会……"}, {"type": "subtitle", "time": 16024.309, "timestamp": "04:27:04", "text": "就因为我身处另一个国家，"}, {"type": "subtitle", "time": 16025.95, "timestamp": "04:27:05", "text": "不在印度"}, {"type": "subtitle", "time": 16036.03, "timestamp": "04:27:16", "text": "我，我仍然会被称为印度人。"}, {"type": "subtitle", "time": 16038.75, "timestamp": "04:27:18", "text": "但"}, {"type": "subtitle", "time": 16043.63, "timestamp": "04:27:23", "text": "是的，即使我用日语说话"}, {"type": "subtitle", "time": 16045.87, "timestamp": "04:27:25", "text": "三语否"}, {"type": "subtitle", "time": 16059.67, "timestamp": "04:27:39", "text": "是啊，坚持住，这会很痛苦。现在是"}, {"type": "subtitle", "time": 16061.91, "timestamp": "04:27:41", "text": "我必须搞定那种全息生活类型"}, {"type": "chat", "time": 16063.532, "timestamp": "04:27:43", "author": "@Anti-SpiritArt", "avatar": "https://yt4.ggpht.com/wYaIbwf481rN5bfgaxWnbUoh-faRynKzhqgZXK5WIvlx9DlMJJl0M6boNmqYwDkmuSY99pM-=s64-c-k-c0x00ffffff-no-rj", "message": "So you are going to japan permanently"}, {"type": "subtitle", "time": 16065.03, "timestamp": "04:27:45", "text": "如果你看过《疯狂》，就会发现很多类似的东西。"}, {"type": "subtitle", "time": 16067.83, "timestamp": "04:27:47", "text": "奥利，你能理解她是怎么做到的。"}, {"type": "subtitle", "time": 16070.229, "timestamp": "04:27:50", "text": "像英语这样的三语能力，"}, {"type": "subtitle", "time": 16072.63, "timestamp": "04:27:52", "text": "印度尼西亚和日本。她皈依了"}, {"type": "subtitle", "time": 16075.349, "timestamp": "04:27:55", "text": "她用三种语言说的每一句话。"}, {"type": "subtitle", "time": 16077.189, "timestamp": "04:27:57", "text": "所以不需要字幕或"}, {"type": "subtitle", "time": 16079.83, "timestamp": "04:27:59", "text": "在线观看时会显示字幕。她手动完成"}]
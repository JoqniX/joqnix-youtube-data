[{"type": "subtitle", "time": 1082.87, "timestamp": "00:18:02", "text": "YouTuber们，还有这个，嗯，他们主要是"}, {"type": "subtitle", "time": 1087.31, "timestamp": "00:18:07", "text": "涵盖了关于这个呃呃这个现实的内容"}, {"type": "subtitle", "time": 1090.87, "timestamp": "00:18:10", "text": "看起来有点像人工智能，挺逼真的。"}, {"type": "subtitle", "time": 1096.51, "timestamp": "00:18:16", "text": "像虚幻引擎模型一样的 YouTuber"}, {"type": "subtitle", "time": 1101.669, "timestamp": "00:18:21", "text": "西德拉克斯。不，我忘了他的名字了，兄弟。呃"}, {"type": "subtitle", "time": 1105.789, "timestamp": "00:18:25", "text": "是的，还有几个人工智能。"}, {"type": "subtitle", "time": 1108.71, "timestamp": "00:18:28", "text": "就像那些逼真的模型一样，对吧？"}, {"type": "subtitle", "time": 1111.11, "timestamp": "00:18:31", "text": "逼真的类似雅阁Mico类型的模型"}, {"type": "chat", "time": 1114.095, "timestamp": "00:18:34", "author": "@N_I_R_NASHAK", "avatar": "https://yt4.ggpht.com/1tUEQ85FwbdYgcMSwBtAKUjwpzN8k-JYCUeDTQQXUvSFn0hVEvGSW0HPICJMtxNg5tVEcjZ-cOc=s64-c-k-c0x00ffffff-no-rj", "message": "i don't remember anything but I remember searching indian vtuber back then and like there was an girl who was google translated ai vtuber it was kinda jarring to listen"}, {"type": "subtitle", "time": 1114.31, "timestamp": "00:18:34", "text": "那里有些人……"}, {"type": "subtitle", "time": 1116.63, "timestamp": "00:18:36", "text": "有几家公司主动联系过我。"}, {"type": "subtitle", "time": 1118.87, "timestamp": "00:18:38", "text": "问类似“你是否有兴趣”之类的问题"}, {"type": "subtitle", "time": 1119.789, "timestamp": "00:18:39", "text": "做"}, {"type": "subtitle", "time": 1123.029, "timestamp": "00:18:43", "text": "诸如此类的事情，然后我就拒绝了。"}, {"type": "subtitle", "time": 1126.51, "timestamp": "00:18:46", "text": "这么说"}, {"type": "subtitle", "time": 1130.63, "timestamp": "00:18:50", "text": "嗯，我是一名YouTuber，一个虚拟的"}, {"type": "subtitle", "time": 1134.71, "timestamp": "00:18:54", "text": "YouTuber，我想拥有我拥有我"}, {"type": "subtitle", "time": 1137.07, "timestamp": "00:18:57", "text": "没有合适的设计"}]
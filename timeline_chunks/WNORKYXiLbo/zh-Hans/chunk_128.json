[{"type": "subtitle", "time": 7683.75, "timestamp": "02:08:03", "text": "知道该聊些什么。是的。"}, {"type": "subtitle", "time": 7685.99, "timestamp": "02:08:05", "text": "太酷了！"}, {"type": "subtitle", "time": 7697.589, "timestamp": "02:08:17", "text": "好的。呃，这是定时器吗？"}, {"type": "subtitle", "time": 7701.43, "timestamp": "02:08:21", "text": "屏幕？呃，那感觉就像……你会……"}, {"type": "subtitle", "time": 7704.47, "timestamp": "02:08:24", "text": "可以跳过，或者移到下一个环节。"}, {"type": "subtitle", "time": 7706.39, "timestamp": "02:08:26", "text": "跳绳杆旁边有一个计时器。所以如果"}, {"type": "subtitle", "time": 7708.31, "timestamp": "02:08:28", "text": "你感觉你更想和……交谈"}, {"type": "subtitle", "time": 7711.27, "timestamp": "02:08:31", "text": "人们五分钟或三分钟"}, {"type": "subtitle", "time": 7713.91, "timestamp": "02:08:33", "text": "几分钟，甚至两分钟，你都可以做到"}, {"type": "subtitle", "time": 7716.27, "timestamp": "02:08:36", "text": "那。最后，它会自动"}, {"type": "subtitle", "time": 7719.83, "timestamp": "02:08:39", "text": "跳过而不是像你必须停留那样"}, {"type": "subtitle", "time": 7721.669, "timestamp": "02:08:41", "text": "因为团体，所以会在那里待一段时间。"}, {"type": "subtitle", "time": 7724.55, "timestamp": "02:08:44", "text": "聊天时间可能在15到20分钟之间。"}, {"type": "subtitle", "time": 7734.589, "timestamp": "02:08:54", "text": "啊，真是如此"}, {"type": "subtitle", "time": 7737.91, "timestamp": "02:08:57", "text": "凉爽的。我也可以查看你的个人资料。"}]
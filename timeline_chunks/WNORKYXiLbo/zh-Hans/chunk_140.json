[{"type": "subtitle", "time": 8401.99, "timestamp": "02:20:01", "text": "去。我已经和三个人谈过了。哦，我的"}, {"type": "subtitle", "time": 8405.55, "timestamp": "02:20:05", "text": "上帝。我是外向型性格吗？我是个秘密吗？"}, {"type": "subtitle", "time": 8408.71, "timestamp": "02:20:08", "text": "外向？决不。我是个秘密吗？"}, {"type": "subtitle", "time": 8411.99, "timestamp": "02:20:11", "text": "你是外向型的人吗，兄弟？我确实在说话。"}, {"type": "subtitle", "time": 8419.99, "timestamp": "02:20:19", "text": "决不。决不。我的君主怎么了？"}, {"type": "subtitle", "time": 8437.19, "timestamp": "02:20:37", "text": "今天有很多太空主题的YouTube博主大家好。"}, {"type": "subtitle", "time": 8440.07, "timestamp": "02:20:40", "text": "你好。很高兴见到你。很高兴见到你"}, {"type": "subtitle", "time": 8443.51, "timestamp": "02:20:43", "text": "你也。我喜欢这三只鼹鼠。"}, {"type": "subtitle", "time": 8447.03, "timestamp": "02:20:47", "text": "谢谢。是的，我也有。"}, {"type": "subtitle", "time": 8449.75, "timestamp": "02:20:49", "text": "所以，我想到要把这一点融入到……"}, {"type": "subtitle", "time": 8452.95, "timestamp": "02:20:52", "text": "我的模型也是。"}, {"type": "subtitle", "time": 8454.309, "timestamp": "02:20:54", "text": "你就像参加一个聚会一样，"}, {"type": "subtitle", "time": 8455.91, "timestamp": "02:20:55", "text": "打招呼的时候，有人会说："}, {"type": "subtitle", "time": 8459.19, "timestamp": "02:20:59", "text": "“是你。”"}]
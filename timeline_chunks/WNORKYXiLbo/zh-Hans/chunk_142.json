[{"type": "subtitle", "time": 8522.07, "timestamp": "02:22:02", "text": "其中一位Discord管理员，他们是"}, {"type": "subtitle", "time": 8525.03, "timestamp": "02:22:05", "text": "谈论计时器。所以计时器"}, {"type": "subtitle", "time": 8526.87, "timestamp": "02:22:06", "text": "可以同时出现在两个人身上，也可以只出现在一个人身上。"}, {"type": "subtitle", "time": 8529.03, "timestamp": "02:22:09", "text": "如果对方开启了快速聊天功能，那么"}, {"type": "subtitle", "time": 8531.83, "timestamp": "02:22:11", "text": "谁的时间短谁就出发。"}, {"type": "subtitle", "time": 8533.91, "timestamp": "02:22:13", "text": "是啊，但我没戴。"}, {"type": "subtitle", "time": 8537.19, "timestamp": "02:22:17", "text": "所以不应该设置计时器。"}, {"type": "subtitle", "time": 8541.27, "timestamp": "02:22:21", "text": "哦，是那个叫M的吗？我忘了她叫什么名字了。"}, {"type": "subtitle", "time": 8544.63, "timestamp": "02:22:24", "text": "但那是粉色的头像吗？"}, {"type": "subtitle", "time": 8549.51, "timestamp": "02:22:29", "text": "颜色？是的。哦，是的。是的。是的。我做了"}, {"type": "subtitle", "time": 8552.63, "timestamp": "02:22:32", "text": "也要和他们谈谈。"}, {"type": "subtitle", "time": 8555.349, "timestamp": "02:22:35", "text": "是的，他们人很好。是的，他们确实这么做了。"}, {"type": "subtitle", "time": 8558.07, "timestamp": "02:22:38", "text": "提到有 15 到 30 分钟"}, {"type": "subtitle", "time": 8559.99, "timestamp": "02:22:39", "text": "一个看不见的计时器，它会……"}, {"type": "subtitle", "time": 8562.15, "timestamp": "02:22:42", "text": "如果继续进行，则自动触发"}, {"type": "subtitle", "time": 8564.71, "timestamp": "02:22:44", "text": "时间太长了。"}, {"type": "subtitle", "time": 8568.55, "timestamp": "02:22:48", "text": "看来这值得思考。"}, {"type": "subtitle", "time": 8570.15, "timestamp": "02:22:50", "text": "挺搞笑的，就像30岁一样。"}, {"type": "subtitle", "time": 8571.83, "timestamp": "02:22:51", "text": "几分钟后，感觉就像，哦，是的，"}, {"type": "subtitle", "time": 8573.19, "timestamp": "02:22:53", "text": "一切进展顺利。你是"}, {"type": "subtitle", "time": 8574.63, "timestamp": "02:22:54", "text": "比如，哦，没有计时器。没有"}]
[{"type": "subtitle", "time": 8761.99, "timestamp": "02:26:01", "text": "随便说点什么。一秒钟。呃，某人"}, {"type": "subtitle", "time": 8764.15, "timestamp": "02:26:04", "text": "加入我的 Bish 一件事。一秒钟。"}, {"type": "subtitle", "time": 8771.429, "timestamp": "02:26:11", "text": "你好。我当时正在直播。你好"}, {"type": "subtitle", "time": 8773.19, "timestamp": "02:26:13", "text": "这里。实际上，我忘了这是在……"}, {"type": "subtitle", "time": 8775.91, "timestamp": "02:26:15", "text": "Discord通话。你好。"}, {"type": "subtitle", "time": 8777.99, "timestamp": "02:26:17", "text": "那样做没有任何作用。哦，你好。如何"}, {"type": "subtitle", "time": 8779.91, "timestamp": "02:26:19", "text": "你在做什么？"}, {"type": "subtitle", "time": 8781.51, "timestamp": "02:26:21", "text": "不知道我能不能做到。我一切都好。感谢"}, {"type": "subtitle", "time": 8783.83, "timestamp": "02:26:23", "text": "非常感谢您的询问。是的，我"}, {"type": "subtitle", "time": 8786.23, "timestamp": "02:26:26", "text": "我只是想加入进来打个招呼，但是……"}, {"type": "subtitle", "time": 8788.63, "timestamp": "02:26:28", "text": "我们来做体能训练吧。抱歉。我当时"}, {"type": "subtitle", "time": 8791.71, "timestamp": "02:26:31", "text": "就像这样做一样"}, {"type": "subtitle", "time": 8796.95, "timestamp": "02:26:36", "text": "嗯，你的东西。所以，我是……是的。我的焦点"}, {"type": "subtitle", "time": 8801.75, "timestamp": "02:26:41", "text": "在那边。很高兴认识你。你好。"}, {"type": "subtitle", "time": 8803.23, "timestamp": "02:26:43", "text": "是啊，很高兴见到你"}, {"type": "subtitle", "time": 8807.429, "timestamp": "02:26:47", "text": "再次。呃，是的，抱歉，我有点笨拙。"}, {"type": "subtitle", "time": 8810.15, "timestamp": "02:26:50", "text": "地狱。我不知道你在直播。"}, {"type": "subtitle", "time": 8811.99, "timestamp": "02:26:51", "text": "没关系。我需要对……进行改造"}, {"type": "subtitle", "time": 8815.11, "timestamp": "02:26:55", "text": "服务器显示我在线。不"}, {"type": "subtitle", "time": 8819.99, "timestamp": "02:26:59", "text": "担忧。我的3D追踪器在哪里？是的，"}]
[{"type": "subtitle", "time": 8822.389, "timestamp": "02:27:02", "text": "我一切都好。你呢？"}, {"type": "subtitle", "time": 8825.349, "timestamp": "02:27:05", "text": "我一切都好。希望你"}, {"type": "subtitle", "time": 8827.91, "timestamp": "02:27:07", "text": "做得很好。"}, {"type": "subtitle", "time": 8830.349, "timestamp": "02:27:10", "text": "乐于"}, {"type": "subtitle", "time": 8833.309, "timestamp": "02:27:13", "text": "听太多流媒体的声音了。哦"}, {"type": "subtitle", "time": 8838.15, "timestamp": "02:27:18", "text": "是的，我需要睡一觉。"}, {"type": "subtitle", "time": 8841.03, "timestamp": "02:27:21", "text": "是的，我当时经常在那里，但是上帝"}, {"type": "subtitle", "time": 8844.389, "timestamp": "02:27:24", "text": "我当时甚至都没怎么参与聊天。我"}, {"type": "subtitle", "time": 8845.99, "timestamp": "02:27:25", "text": "我以为你甚至都忘了"}, {"type": "subtitle", "time": 8849.349, "timestamp": "02:27:29", "text": "关于我真正的自我。不，不，我确实"}, {"type": "subtitle", "time": 8851.59, "timestamp": "02:27:31", "text": "记住你。是的，你确实画了你"}, {"type": "subtitle", "time": 8853.99, "timestamp": "02:27:33", "text": "我们……我记得有你……"}, {"type": "subtitle", "time": 8856.469, "timestamp": "02:27:36", "text": "就是那个圣诞树。你曾是"}, {"type": "subtitle", "time": 8858.23, "timestamp": "02:27:38", "text": "去那里送上生日祝福。是的。"}, {"type": "subtitle", "time": 8861.429, "timestamp": "02:27:41", "text": "是的，我还记得你。是的。"}, {"type": "subtitle", "time": 8862.95, "timestamp": "02:27:42", "text": "是的。再次感谢您的圣诞礼物"}, {"type": "subtitle", "time": 8875.51, "timestamp": "02:27:55", "text": "是的，呃，我这里有人在等。所以"}, {"type": "subtitle", "time": 8878.71, "timestamp": "02:27:58", "text": "我会去处理这件事。嗯，免费"}]
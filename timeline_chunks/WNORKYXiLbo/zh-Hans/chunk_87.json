[{"type": "subtitle", "time": 5220.87, "timestamp": "01:27:00", "text": "希望是那种工作室办公室的房间。"}, {"type": "subtitle", "time": 5223.27, "timestamp": "01:27:03", "text": "但那很贵。现在我唯一的"}, {"type": "subtitle", "time": 5228.79, "timestamp": "01:27:08", "text": "我正在考虑的是模型。我"}, {"type": "subtitle", "time": 5231.91, "timestamp": "01:27:11", "text": "我一踏上日本的土地，就开始努力工作。"}, {"type": "subtitle", "time": 5234.629, "timestamp": "01:27:14", "text": "活下去，这样我才能吃上饭，而且实际上"}, {"type": "subtitle", "time": 5237.39, "timestamp": "01:27:17", "text": "保持健康之类的"}, {"type": "subtitle", "time": 5241.43, "timestamp": "01:27:21", "text": "呃，还有一些其他的东西。是的，为了生存。"}, {"type": "subtitle", "time": 5244.87, "timestamp": "01:27:24", "text": "剩下的钱我会用来做这件事。"}, {"type": "subtitle", "time": 5248.189, "timestamp": "01:27:28", "text": "对于模型之类的东西"}, {"type": "subtitle", "time": 5251.75, "timestamp": "01:27:31", "text": "不知怎么的。我好像是从一个人那里听说的。"}, {"type": "subtitle", "time": 5254.87, "timestamp": "01:27:34", "text": "我的同学朋友们中，有人去了……"}, {"type": "subtitle", "time": 5259.55, "timestamp": "01:27:39", "text": "四月份入学。他们说你"}, {"type": "subtitle", "time": 5261.629, "timestamp": "01:27:41", "text": "无法赚取"}, {"type": "subtitle", "time": 5265.51, "timestamp": "01:27:45", "text": "收入或者像你不能做YouTube之类的"}, {"type": "subtitle", "time": 5268.75, "timestamp": "01:27:48", "text": "收入相关"}, {"type": "subtitle", "time": 5272.149, "timestamp": "01:27:52", "text": "呃，转到你的银行账户或其他什么地方"}, {"type": "subtitle", "time": 5275.51, "timestamp": "01:27:55", "text": "严格的规定，我对此感到担忧。"}, {"type": "subtitle", "time": 5278.55, "timestamp": "01:27:58", "text": "因为我现在已经开始盈利了。嗯，将会是"}]
[{"type": "subtitle", "time": 1621.11, "timestamp": "00:27:01", "text": "不，我们正在向所有加盟商推广。"}, {"type": "subtitle", "time": 1623.39, "timestamp": "00:27:03", "text": "以及今天的合作伙伴。哦，"}, {"type": "subtitle", "time": 1627.51, "timestamp": "00:27:07", "text": "那个夹子徽章已经下架了。"}, {"type": "subtitle", "time": 1631.149, "timestamp": "00:27:11", "text": "Twitch 直播间里那个翻转徽章的小玩意儿。"}, {"type": "subtitle", "time": 1633.149, "timestamp": "00:27:13", "text": "好的。嘿，"}, {"type": "subtitle", "time": 1636.269, "timestamp": "00:27:16", "text": "VanX，她叫什么名字？大猩猩"}, {"type": "subtitle", "time": 1640.11, "timestamp": "00:27:20", "text": "女孩。我当时真的很高兴。我当时"}, {"type": "subtitle", "time": 1644.149, "timestamp": "00:27:24", "text": "就像，“哇，一个印地语说呃印地语。"}, {"type": "subtitle", "time": 1646.149, "timestamp": "00:27:26", "text": "她懂印地语。她用印地语唱歌。她"}, {"type": "subtitle", "time": 1648.31, "timestamp": "00:27:28", "text": "用印地语做了自我介绍。我当时"}, {"type": "subtitle", "time": 1656.95, "timestamp": "00:27:36", "text": "我看到好多关于这个的呃……东西。"}, {"type": "subtitle", "time": 1658.83, "timestamp": "00:27:38", "text": "一款名为“银牌”的游戏"}]
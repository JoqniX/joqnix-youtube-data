[{"type": "subtitle", "time": 14402.79, "timestamp": "04:00:02", "text": "但我现在每次拿到东西都喜欢"}, {"type": "subtitle", "time": 14407.83, "timestamp": "04:00:07", "text": "分享出去。我喜欢多买一些，这样我就可以送人了。"}, {"type": "subtitle", "time": 14410.55, "timestamp": "04:00:10", "text": "把它送给真正需要的人，因为我"}, {"type": "subtitle", "time": 14414.11, "timestamp": "04:00:14", "text": "感觉过段时间我就不会再用它了。"}, {"type": "subtitle", "time": 14416.429, "timestamp": "04:00:16", "text": "时间。"}, {"type": "subtitle", "time": 14423.75, "timestamp": "04:00:23", "text": "这是动画提示。哦，我要去"}, {"type": "subtitle", "time": 14427.389, "timestamp": "04:00:27", "text": "也弄到那个。为什么"}, {"type": "subtitle", "time": 14431.91, "timestamp": "04:00:31", "text": "不是？好的，我数到一、二、三。我"}, {"type": "subtitle", "time": 14439.11, "timestamp": "04:00:39", "text": "嗯，我买了这些铂金版头像框。"}, {"type": "subtitle", "time": 14442.51, "timestamp": "04:00:42", "text": "锁背面樱花框樱花"}, {"type": "subtitle", "time": 14445.91, "timestamp": "04:00:45", "text": "相框和可爱的相框。我觉得我"}, {"type": "subtitle", "time": 14449.309, "timestamp": "04:00:49", "text": "想用铂金"}, {"type": "subtitle", "time": 14451.389, "timestamp": "04:00:51", "text": "一。可能会用"}, {"type": "subtitle", "time": 14454.55, "timestamp": "04:00:54", "text": "这样我就可以把我的头像放在这里了。"}]
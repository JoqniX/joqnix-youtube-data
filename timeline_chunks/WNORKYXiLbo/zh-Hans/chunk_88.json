[{"type": "subtitle", "time": 5280.629, "timestamp": "01:28:00", "text": "到那时我已经实现了盈利，我想到我击中"}, {"type": "subtitle", "time": 5283.51, "timestamp": "01:28:03", "text": "现在一千了，但我有超级聊天功能。"}, {"type": "subtitle", "time": 5286.709, "timestamp": "01:28:06", "text": "一切都好，但是，嗯，我担心的是……"}, {"type": "subtitle", "time": 5290.07, "timestamp": "01:28:10", "text": "他们好像提到了……"}, {"type": "subtitle", "time": 5291.149, "timestamp": "01:28:11", "text": "规则"}, {"type": "subtitle", "time": 5293.149, "timestamp": "01:28:13", "text": "东西和"}, {"type": "subtitle", "time": 5295.99, "timestamp": "01:28:15", "text": "你觉得我会公开谈论所有事情吗？"}, {"type": "subtitle", "time": 5298.31, "timestamp": "01:28:18", "text": "如果我查看，我的私人信息就会泄露。"}, {"type": "subtitle", "time": 5300.669, "timestamp": "01:28:20", "text": "我自己的学校"}, {"type": "subtitle", "time": 5305.03, "timestamp": "01:28:25", "text": "现在在日本，我的意思是，如果不是这样的话……"}, {"type": "subtitle", "time": 5308.59, "timestamp": "01:28:28", "text": "任何人都会来日本"}, {"type": "subtitle", "time": 5311.07, "timestamp": "01:28:31", "text": "正确的。"}, {"type": "subtitle", "time": 5315.87, "timestamp": "01:28:35", "text": "知道。我"}, {"type": "subtitle", "time": 5319.03, "timestamp": "01:28:39", "text": "也就是说，你不可能找到我。"}, {"type": "subtitle", "time": 5322.189, "timestamp": "01:28:42", "text": "找到我。外面人真多"}, {"type": "subtitle", "time": 5324.27, "timestamp": "01:28:44", "text": "那里，"}, {"type": "subtitle", "time": 5327.229, "timestamp": "01:28:47", "text": "正确的？我知道我不知道。"}, {"type": "subtitle", "time": 5331.189, "timestamp": "01:28:51", "text": "但我其实想看看……"}, {"type": "subtitle", "time": 5333.669, "timestamp": "01:28:53", "text": "访问他们的学校网站，看看他们在哪里。"}, {"type": "subtitle", "time": 5338.31, "timestamp": "01:28:58", "text": "规章制度是因为……知道"}]
[{"type": "subtitle", "time": 11882.19, "timestamp": "03:18:02", "text": "是的，"}, {"type": "subtitle", "time": 11884.67, "timestamp": "03:18:04", "text": "呃，既然我们有一个"}, {"type": "chat", "time": 11888.148, "timestamp": "03:18:08", "author": "@baebae8403", "avatar": "https://yt4.ggpht.com/OdCljOM7Z-IW-aduSOxmr7dLa3EadW4Esy80MxUu6e5ZFoEtOrbG5Sn-Ar2tm7N25BpvPHou=s64-c-k-c0x00ffffff-no-rj", "message": "UCdZBnUb7m8Pd_wUTDNqUu3Q/PVfsZ8LuIYCO_9EPt-GMgAwUCdZBnUb7m8Pd_wUTDNqUu3Q/PVfsZ8LuIYCO_9EPt-GMgAwUCdZBnUb7m8Pd_wUTDNqUu3Q/PVfsZ8LuIYCO_9EPt-GMgAw"}, {"type": "subtitle", "time": 11888.75, "timestamp": "03:18:08", "text": "合作就像我会有一个"}, {"type": "subtitle", "time": 11891.99, "timestamp": "03:18:11", "text": "宣布任何合作项目"}, {"type": "subtitle", "time": 11894.63, "timestamp": "03:18:14", "text": "正在发生。所以人们给它起了名字。它"}, {"type": "subtitle", "time": 11898.07, "timestamp": "03:18:18", "text": "将在节目安排频道播出。好的。"}, {"type": "subtitle", "time": 11899.309, "timestamp": "03:18:19", "text": "这将是"}, {"type": "subtitle", "time": 11902.87, "timestamp": "03:18:22", "text": "动态动态嵌入。将会进行编辑"}, {"type": "subtitle", "time": 11905.59, "timestamp": "03:18:25", "text": "一直如此。"}, {"type": "subtitle", "time": 11908.67, "timestamp": "03:18:28", "text": "取决于是否有变化"}, {"type": "subtitle", "time": 11911.59, "timestamp": "03:18:31", "text": "等等。唉，如果我当初那样做就好了。"}, {"type": "subtitle", "time": 11913.99, "timestamp": "03:18:33", "text": "以前，要是有人帮忙就好了"}, {"type": "subtitle", "time": 11917.11, "timestamp": "03:18:37", "text": "我觉得我当时有几个版主。"}, {"type": "subtitle", "time": 11919.63, "timestamp": "03:18:39", "text": "帮我。但我当时"}, {"type": "subtitle", "time": 11923.91, "timestamp": "03:18:43", "text": "那时候我专注于自己的事情，"}, {"type": "subtitle", "time": 11925.229, "timestamp": "03:18:45", "text": "我当时"}, {"type": "subtitle", "time": 11929.63, "timestamp": "03:18:49", "text": "就像害怕寻求帮助一样"}, {"type": "subtitle", "time": 11932.95, "timestamp": "03:18:52", "text": "很少有人知道该怎么做"}, {"type": "subtitle", "time": 11936.429, "timestamp": "03:18:56", "text": "比如像网络钩子那样的东西"}, {"type": "subtitle", "time": 11939.51, "timestamp": "03:18:59", "text": "把所有东西都检查一遍。"}]
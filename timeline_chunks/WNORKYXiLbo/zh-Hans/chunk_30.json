[{"type": "subtitle", "time": 1800.51, "timestamp": "00:30:00", "text": "[音乐]"}, {"type": "subtitle", "time": 1803.43, "timestamp": "00:30:03", "text": "嗯，我觉得社区更好。"}, {"type": "subtitle", "time": 1805.83, "timestamp": "00:30:05", "text": "是会员而不是 YouTuber 做的。"}, {"type": "subtitle", "time": 1809.75, "timestamp": "00:30:09", "text": "这样做是因为VTuber承受的压力太大了。"}, {"type": "subtitle", "time": 1812.07, "timestamp": "00:30:12", "text": "处理。"}, {"type": "subtitle", "time": 1829.51, "timestamp": "00:30:29", "text": "有时我觉得，如果可以的话，邀请也挺好的。"}, {"type": "subtitle", "time": 1831.23, "timestamp": "00:30:31", "text": "由……制作"}, {"type": "subtitle", "time": 1834.11, "timestamp": "00:30:34", "text": "社区是"}, {"type": "subtitle", "time": 1837.19, "timestamp": "00:30:37", "text": "很好，但是随之而来的是责任和"}, {"type": "subtitle", "time": 1839.789, "timestamp": "00:30:39", "text": "一切都将摆上台面"}, {"type": "subtitle", "time": 1842.71, "timestamp": "00:30:42", "text": "所有不必要的戏剧性事件"}, {"type": "subtitle", "time": 1846.63, "timestamp": "00:30:46", "text": "你将被赋予很多东西，但是"}, {"type": "subtitle", "time": 1848.549, "timestamp": "00:30:48", "text": "是的，现在每个人都在做他们的"}, {"type": "subtitle", "time": 1851.389, "timestamp": "00:30:51", "text": "这是我自己的事，所以无所谓。"}, {"type": "subtitle", "time": 1854.789, "timestamp": "00:30:54", "text": "我猜也是，但我确实希望有人能……"}, {"type": "subtitle", "time": 1859.269, "timestamp": "00:30:59", "text": "我发现它就像一个单身的新加坡虚拟主播"}]
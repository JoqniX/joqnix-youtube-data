[{"type": "subtitle", "time": 8643.67, "timestamp": "02:24:03", "text": "希望一切都好。通常呃"}, {"type": "subtitle", "time": 8647.67, "timestamp": "02:24:07", "text": "aons 表示有事发生。但"}, {"type": "subtitle", "time": 8649.91, "timestamp": "02:24:09", "text": "是的，"}, {"type": "subtitle", "time": 8652.95, "timestamp": "02:24:12", "text": "一切都很好。是的。所以我所做的就是"}, {"type": "subtitle", "time": 8655.67, "timestamp": "02:24:15", "text": "比如，当我睡觉或吃东西的时候"}, {"type": "subtitle", "time": 8658.63, "timestamp": "02:24:18", "text": "休息一下，我正在播放滑稽剧。"}, {"type": "subtitle", "time": 8661.75, "timestamp": "02:24:21", "text": "为了我的 YouTube 直播。好的。是的。"}, {"type": "subtitle", "time": 8665.309, "timestamp": "02:24:25", "text": "所以我把它做成了……呃，它拉动……"}, {"type": "subtitle", "time": 8668.95, "timestamp": "02:24:28", "text": "从随机时间戳中随机抽取一个 V，并且"}, {"type": "subtitle", "time": 8671.19, "timestamp": "02:24:31", "text": "将随机播放 WS 歌曲列表"}, {"type": "subtitle", "time": 8674.79, "timestamp": "02:24:34", "text": "出色地。所以它就像一个随机扭蛋游戏。"}, {"type": "subtitle", "time": 8678.79, "timestamp": "02:24:38", "text": "明白了。是的。我总是喜欢……当"}, {"type": "subtitle", "time": 8680.55, "timestamp": "02:24:40", "text": "人们播放视频片段时"}, {"type": "subtitle", "time": 8682.15, "timestamp": "02:24:42", "text": "他们正在办理稍后回来 (BRB) 的手续，感觉就像……"}, {"type": "subtitle", "time": 8684.07, "timestamp": "02:24:44", "text": "随机剪辑，这样你就可以像我一样制作了"}, {"type": "subtitle", "time": 8687.75, "timestamp": "02:24:47", "text": "那段视频。我在那里。"}, {"type": "subtitle", "time": 8688.99, "timestamp": "02:24:48", "text": "总是"}, {"type": "subtitle", "time": 8690.55, "timestamp": "02:24:50", "text": "乐趣。"}, {"type": "subtitle", "time": 8693.11, "timestamp": "02:24:53", "text": "我看得出你对角色塑造很感兴趣。"}, {"type": "subtitle", "time": 8695.19, "timestamp": "02:24:55", "text": "设计。我猜你设计了你的"}, {"type": "subtitle", "time": 8698.23, "timestamp": "02:24:58", "text": "个性鲜明。呃，这个，不，它是一个"}]
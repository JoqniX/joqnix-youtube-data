[{"type": "subtitle", "time": 3060.19, "timestamp": "00:51:00", "text": "东西。"}, {"type": "subtitle", "time": 3063.71, "timestamp": "00:51:03", "text": "呃，等等，不是吗？"}, {"type": "chat", "time": 3066.506, "timestamp": "00:51:06", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "semantics"}, {"type": "subtitle", "time": 3066.71, "timestamp": "00:51:06", "text": "嗯，你能在粉丝圈里混下去吗？但"}, {"type": "subtitle", "time": 3069.27, "timestamp": "00:51:09", "text": "粉丝圈那一套，呃，就是那样做的"}, {"type": "subtitle", "time": 3071.829, "timestamp": "00:51:11", "text": "我觉得可能有点过头了。"}, {"type": "subtitle", "time": 3079.43, "timestamp": "00:51:19", "text": "嗯，Notion 确实不错，但你必须……"}, {"type": "subtitle", "time": 3081.75, "timestamp": "00:51:21", "text": "获得高级会员，例如成为"}, {"type": "subtitle", "time": 3084.43, "timestamp": "00:51:24", "text": "网站之类的。就是这样。"}, {"type": "subtitle", "time": 3086.75, "timestamp": "00:51:26", "text": "疼痛。"}, {"type": "subtitle", "time": 3088.829, "timestamp": "00:51:28", "text": "嗯"}, {"type": "chat", "time": 3090.981, "timestamp": "00:51:30", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "fandom is cool and all but thats more for the public"}, {"type": "subtitle", "time": 3093.03, "timestamp": "00:51:33", "text": "是的，但我还有网页工作室，"}, {"type": "subtitle", "time": 3095.87, "timestamp": "00:51:35", "text": "栩栩如生的终身版"}, {"type": "subtitle", "time": 3101.109, "timestamp": "00:51:41", "text": "这是它的计划。所以如果有人……我就不会。"}, {"type": "subtitle", "time": 3103.51, "timestamp": "00:51:43", "text": "擅长制作网站，而且制作过程也很有趣。"}, {"type": "subtitle", "time": 3107.67, "timestamp": "00:51:47", "text": "就像那样，或者把它连接到内容管理系统（CMS）上。"}, {"type": "chat", "time": 3108.634, "timestamp": "00:51:48", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "the spreadsheet is for the server people only "}, {"type": "subtitle", "time": 3110.309, "timestamp": "00:51:50", "text": "诸如此类的事情，然后你就可以使用网络了。"}, {"type": "subtitle", "time": 3112.95, "timestamp": "00:51:52", "text": "使用工作室网站构建器来完成这项工作。我不会"}, {"type": "subtitle", "time": 3113.95, "timestamp": "00:51:53", "text": "头脑"}, {"type": "subtitle", "time": 3117.51, "timestamp": "00:51:57", "text": "分享一下我的方法，因为我可以无限循环"}]
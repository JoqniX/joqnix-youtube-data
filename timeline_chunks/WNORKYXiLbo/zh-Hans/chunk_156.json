[{"type": "subtitle", "time": 9360.23, "timestamp": "02:36:00", "text": "我负责审核的人之一是"}, {"type": "subtitle", "time": 9361.59, "timestamp": "02:36:01", "text": "你会想这么做的。我知道在"}, {"type": "subtitle", "time": 9364.55, "timestamp": "02:36:04", "text": "至少有五个人想这样做。我是"}, {"type": "subtitle", "time": 9365.59, "timestamp": "02:36:05", "text": "之后会把它寄给他们。"}, {"type": "subtitle", "time": 9367.429, "timestamp": "02:36:07", "text": "是的，但我想要的是氛围测试。"}, {"type": "subtitle", "time": 9369.83, "timestamp": "02:36:09", "text": "看看效果如何。到目前为止，"}, {"type": "subtitle", "time": 9373.51, "timestamp": "02:36:13", "text": "大家看起来都很好。"}, {"type": "subtitle", "time": 9375.429, "timestamp": "02:36:15", "text": "好的。你做 YouTube 很久了吗？"}, {"type": "subtitle", "time": 9379.27, "timestamp": "02:36:19", "text": "然后？嗯，是的，今年将是我的"}, {"type": "subtitle", "time": 9383.03, "timestamp": "02:36:23", "text": "第五年。我想我是从……开始的"}, {"type": "subtitle", "time": 9385.349, "timestamp": "02:36:25", "text": "是啊，但问题是我从未出道过。"}, {"type": "subtitle", "time": 9387.11, "timestamp": "02:36:27", "text": "它。"}, {"type": "subtitle", "time": 9389.27, "timestamp": "02:36:29", "text": "没关系。你可以随时出道"}, {"type": "subtitle", "time": 9392.79, "timestamp": "02:36:32", "text": "想。嗯。无论何时你感觉有"}, {"type": "subtitle", "time": 9394.71, "timestamp": "02:36:34", "text": "玩得很开心。"}, {"type": "subtitle", "time": 9402.15, "timestamp": "02:36:42", "text": "哦，我明白了。我明白了"}, {"type": "subtitle", "time": 9404.309, "timestamp": "02:36:44", "text": "它为什么这么奇特。呃，我把它拿在手里……"}, {"type": "subtitle", "time": 9405.75, "timestamp": "02:36:45", "text": "右手，但现在它正在追踪"}, {"type": "subtitle", "time": 9407.63, "timestamp": "02:36:47", "text": "我的左边"}, {"type": "subtitle", "time": 9411.309, "timestamp": "02:36:51", "text": "手。好的，就是这样。"}, {"type": "subtitle", "time": 9415.27, "timestamp": "02:36:55", "text": "向后。呃，等等，那边走。好的，"}, {"type": "subtitle", "time": 9418.55, "timestamp": "02:36:58", "text": "虽然有点反常，但就是这样。"}]
[{"type": "subtitle", "time": 8583.51, "timestamp": "02:23:03", "text": "是的。嗯，你如何才能像……"}, {"type": "subtitle", "time": 8587.11, "timestamp": "02:23:07", "text": "认证过的VTuber？我觉得我觉得"}, {"type": "subtitle", "time": 8590.79, "timestamp": "02:23:10", "text": "我收到邀请了，你收到邮件了。"}, {"type": "subtitle", "time": 8593.27, "timestamp": "02:23:13", "text": "邀请函之类的东西，但是当我登录时"}, {"type": "subtitle", "time": 8596.23, "timestamp": "02:23:16", "text": "今天好像根本没有邀请码。"}, {"type": "subtitle", "time": 8599.03, "timestamp": "02:23:19", "text": "放进去。所以他们真的完全喜欢吗？"}, {"type": "subtitle", "time": 8602.309, "timestamp": "02:23:22", "text": "发布这个？呃，你已经验证过了"}, {"type": "subtitle", "time": 8604.79, "timestamp": "02:23:24", "text": "你的个人资料，但对我来说我只需要做"}, {"type": "subtitle", "time": 8606.309, "timestamp": "02:23:26", "text": "我连接了我的Twitch频道，然后"}, {"type": "subtitle", "time": 8609.95, "timestamp": "02:23:29", "text": "这感觉就像你很厉害一样。"}, {"type": "subtitle", "time": 8612.309, "timestamp": "02:23:32", "text": "啊，原来是这样。你一直"}, {"type": "subtitle", "time": 8614.63, "timestamp": "02:23:34", "text": "持续了九个小时。"}, {"type": "subtitle", "time": 8617.03, "timestamp": "02:23:37", "text": "九个小时。哦，那个哦，我做了一个新的"}, {"type": "subtitle", "time": 8619.349, "timestamp": "02:23:39", "text": "溪流。哦，是的。 Twitch 只允许向上"}, {"type": "subtitle", "time": 8624.15, "timestamp": "02:23:44", "text": "现在还有48小时。等等，等等，等等"}, {"type": "subtitle", "time": 8628.15, "timestamp": "02:23:48", "text": "你真的全力以赴了。"}, {"type": "subtitle", "time": 8630.389, "timestamp": "02:23:50", "text": "是啊，太疯狂了。"}, {"type": "subtitle", "time": 8632.07, "timestamp": "02:23:52", "text": "希望你一切都好。请确保你"}, {"type": "subtitle", "time": 8635.03, "timestamp": "02:23:55", "text": "多喝水，做些拉伸运动。谢谢"}, {"type": "subtitle", "time": 8637.91, "timestamp": "02:23:57", "text": "提醒至少保持 20 英尺的距离。让"}]
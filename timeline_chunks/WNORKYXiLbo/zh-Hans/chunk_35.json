[{"type": "subtitle", "time": 2103.829, "timestamp": "00:35:03", "text": "我有点难过，因为 p 喜欢"}, {"type": "subtitle", "time": 2109.069, "timestamp": "00:35:09", "text": "事件。"}, {"type": "subtitle", "time": 2112.79, "timestamp": "00:35:12", "text": "嗯，是的，事情本来可能不会那样发展。"}, {"type": "subtitle", "time": 2114.75, "timestamp": "00:35:14", "text": "那。有很多"}, {"type": "subtitle", "time": 2118.39, "timestamp": "00:35:18", "text": "充满热情、活跃在这个领域的创作者们"}, {"type": "subtitle", "time": 2122.829, "timestamp": "00:35:22", "text": "总体来说，都想取得巨大成功。"}, {"type": "subtitle", "time": 2125.349, "timestamp": "00:35:25", "text": "事物。我感觉我好像接受了这一点。"}, {"type": "subtitle", "time": 2133.87, "timestamp": "00:35:33", "text": "因为某种原因，因为在某种程度上，我的"}, {"type": "subtitle", "time": 2137.67, "timestamp": "00:35:37", "text": "对我来说，这在某种程度上是理想的，因为这就是我理想的电视观看方式。"}, {"type": "subtitle", "time": 2140.55, "timestamp": "00:35:40", "text": "社区不是那样，感觉就像我施加了压力。"}, {"type": "subtitle", "time": 2142.71, "timestamp": "00:35:42", "text": "我将自己的理想融入整个社区"}, {"type": "subtitle", "time": 2144.87, "timestamp": "00:35:44", "text": "或者别的什么。我不知道对我来说是怎样的。"}, {"type": "subtitle", "time": 2148.15, "timestamp": "00:35:48", "text": "就像我不希望这个空间变成这样一样"}, {"type": "subtitle", "time": 2151.99, "timestamp": "00:35:51", "text": "有毒的或者太戏剧化了。我只想"}, {"type": "subtitle", "time": 2153.79, "timestamp": "00:35:53", "text": "大家要和睦相处"}, {"type": "subtitle", "time": 2156.95, "timestamp": "00:35:56", "text": "并且保持良好的沟通，我们"}, {"type": "subtitle", "time": 2159.19, "timestamp": "00:35:59", "text": "地方很小，你知道每个人都在工作"}]
[{"type": "subtitle", "time": 6545.35, "timestamp": "01:49:05", "text": "原神、我的世界、香港，我要去"}, {"type": "subtitle", "time": 6547.49, "timestamp": "01:49:07", "text": "到"}, {"type": "subtitle", "time": 6554.51, "timestamp": "01:49:14", "text": "缩小版动漫漫画。我们开始吧"}, {"type": "subtitle", "time": 6557.83, "timestamp": "01:49:17", "text": "看看有多少芒果。我喜欢这个事实"}, {"type": "subtitle", "time": 6560.149, "timestamp": "01:49:20", "text": "他们已经预先选择了零"}, {"type": "subtitle", "time": 6563.75, "timestamp": "01:49:23", "text": "对我来说，《rezero Tokyo》和《柔术开战》。"}, {"type": "subtitle", "time": 6571.07, "timestamp": "01:49:31", "text": "闪光人粘液是一种"}, {"type": "subtitle", "time": 6582.99, "timestamp": "01:49:42", "text": "[音乐]"}, {"type": "subtitle", "time": 6585.629, "timestamp": "01:49:45", "text": "我看了一点封面"}, {"type": "subtitle", "time": 6588.39, "timestamp": "01:49:48", "text": "有点，但我不太了解。所以，我"}, {"type": "subtitle", "time": 6591.189, "timestamp": "01:49:51", "text": "我想要，但我不知道我是否应该接受。"}, {"type": "subtitle", "time": 6594.43, "timestamp": "01:49:54", "text": "艺术、角色设计、下界"}, {"type": "subtitle", "time": 6597.31, "timestamp": "01:49:57", "text": "建造，我们"}]
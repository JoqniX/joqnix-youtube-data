[{"type": "subtitle", "time": 1140.07, "timestamp": "00:19:00", "text": "然而。我没有，我甚至还没发布我的"}, {"type": "subtitle", "time": 1142.47, "timestamp": "00:19:02", "text": "正式的官方设计方案是什么？"}, {"type": "subtitle", "time": 1146.029, "timestamp": "00:19:06", "text": "严格来说，第二套装备是"}, {"type": "subtitle", "time": 1149.51, "timestamp": "00:19:09", "text": "官方消息还没出来呢。合适的，不是合适的"}, {"type": "subtitle", "time": 1154.789, "timestamp": "00:19:14", "text": "2D，嗯，还不是真正的3D。那么，如何才能……"}, {"type": "subtitle", "time": 1157.029, "timestamp": "00:19:17", "text": "世界会希望我发布一个"}, {"type": "subtitle", "time": 1159.87, "timestamp": "00:19:19", "text": "逼真的模型？我当然可以做到"}, {"type": "subtitle", "time": 1163.43, "timestamp": "00:19:23", "text": "如果我的频道发展壮大了，"}, {"type": "subtitle", "time": 1165.59, "timestamp": "00:19:25", "text": "一切妥当。我可以像"}, {"type": "subtitle", "time": 1170.47, "timestamp": "00:19:30", "text": "你觉得K是怎么对付她的？K"}, {"type": "subtitle", "time": 1172.39, "timestamp": "00:19:32", "text": "神椿与"}, {"type": "subtitle", "time": 1176.23, "timestamp": "00:19:36", "text": "超人类之类的东西。呃，那是什么？那是什么？"}, {"type": "subtitle", "time": 1180.15, "timestamp": "00:19:40", "text": "这位艺术家的名字是 Tu Inu 吗？不，你知道T不"}, {"type": "subtitle", "time": 1183.19, "timestamp": "00:19:43", "text": "那位日本DJ叫什么名字？我忘了"}, {"type": "subtitle", "time": 1185.19, "timestamp": "00:19:45", "text": "是的，就像一些合作一样"}, {"type": "subtitle", "time": 1188.63, "timestamp": "00:19:48", "text": "就像，嗯，K当时也在那里。"}, {"type": "subtitle", "time": 1191.23, "timestamp": "00:19:51", "text": "虚拟人类"}, {"type": "subtitle", "time": 1193.99, "timestamp": "00:19:53", "text": "网站上的汽车和轮毂都在里面"}, {"type": "subtitle", "time": 1195.75, "timestamp": "00:19:55", "text": "那个虚拟人玩意儿，我当时"}, {"type": "subtitle", "time": 1197.31, "timestamp": "00:19:57", "text": "喜欢"}]
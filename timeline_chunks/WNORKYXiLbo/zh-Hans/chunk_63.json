[{"type": "subtitle", "time": 3781.67, "timestamp": "01:03:01", "text": "你知道，在这个午夜，当谈到……"}, {"type": "subtitle", "time": 3784.789, "timestamp": "01:03:04", "text": "午夜时分，我想我深入其中了，是这样吗？"}, {"type": "subtitle", "time": 3792.069, "timestamp": "01:03:12", "text": "死了，婴儿也谢谢你。"}, {"type": "subtitle", "time": 3795.99, "timestamp": "01:03:15", "text": "成为会员，抱歉我没看到。"}, {"type": "subtitle", "time": 3799.19, "timestamp": "01:03:19", "text": "我刚才看到了那个警报。"}, {"type": "subtitle", "time": 3801.19, "timestamp": "01:03:21", "text": "抱歉，但感谢您成为……"}, {"type": "chat", "time": 3803.296, "timestamp": "01:03:23", "author": "@baebae8403", "avatar": "https://yt4.ggpht.com/OdCljOM7Z-IW-aduSOxmr7dLa3EadW4Esy80MxUu6e5ZFoEtOrbG5Sn-Ar2tm7N25BpvPHou=s64-c-k-c0x00ffffff-no-rj", "message": "UCdZBnUb7m8Pd_wUTDNqUu3Q/f3TlZ5L1KpS3_9EP-duW6QoUCdZBnUb7m8Pd_wUTDNqUu3Q/f3TlZ5L1KpS3_9EP-duW6QoUCdZBnUb7m8Pd_wUTDNqUu3Q/f3TlZ5L1KpS3_9EP-duW6Qo"}, {"type": "subtitle", "time": 3803.54, "timestamp": "01:03:23", "text": "成员。欢迎来到星界"}, {"type": "chat", "time": 3806.758, "timestamp": "01:03:26", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Greetings Konzteller! Bae bae~🌟 Welcome to the Guild! Make sure to read the Guildmate Guidelines in the description below before chatting further. Enjoy your stay!"}, {"type": "subtitle", "time": 3808.71, "timestamp": "01:03:28", "text": "星座人。我必须这样做"}, {"type": "subtitle", "time": 3819.349, "timestamp": "01:03:39", "text": "主意。但由于我专注于我的"}, {"type": "subtitle", "time": 3821.75, "timestamp": "01:03:41", "text": "joathon，我一直没能做到"}, {"type": "subtitle", "time": 3824.71, "timestamp": "01:03:44", "text": "任何事物。你知道，有很多这样的人。"}, {"type": "subtitle", "time": 3826.43, "timestamp": "01:03:46", "text": "我拥有的东西"}, {"type": "subtitle", "time": 3829.27, "timestamp": "01:03:49", "text": "思维，月历，月"}, {"type": "subtitle", "time": 3833.789, "timestamp": "01:03:53", "text": "壁纸，每月"}, {"type": "subtitle", "time": 3838.95, "timestamp": "01:03:58", "text": "东西还有像每月语音包之类的东西"}]
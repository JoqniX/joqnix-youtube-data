[{"type": "subtitle", "time": 10383.429, "timestamp": "02:53:03", "text": "知道。就是那个推特之类的东西。我"}, {"type": "subtitle", "time": 10387.11, "timestamp": "02:53:07", "text": "必须采取一些措施。"}, {"type": "subtitle", "time": 10389.67, "timestamp": "02:53:09", "text": "是啊，我当时就想，我得做点什么。"}, {"type": "subtitle", "time": 10392.79, "timestamp": "02:53:12", "text": "直到它首映之后我才明白。"}, {"type": "subtitle", "time": 10394.269, "timestamp": "02:53:14", "text": "或者"}, {"type": "subtitle", "time": 10396.349, "timestamp": "02:53:16", "text": "某物或"}, {"type": "subtitle", "time": 10399.15, "timestamp": "02:53:19", "text": "某物。呃或"}, {"type": "subtitle", "time": 10402.429, "timestamp": "02:53:22", "text": "我不太确定该怎么做。"}, {"type": "subtitle", "time": 10405.469, "timestamp": "02:53:25", "text": "账户"}, {"type": "subtitle", "time": 10408.11, "timestamp": "02:53:28", "text": "东西。"}, {"type": "subtitle", "time": 10410.79, "timestamp": "02:53:30", "text": "嗯，我不知道，但是，是的，我不应该……"}, {"type": "subtitle", "time": 10413.95, "timestamp": "02:53:33", "text": "想太多了。我又关注了人们"}, {"type": "subtitle", "time": 10417.349, "timestamp": "02:53:37", "text": "在子账户上，因为那样我"}, {"type": "subtitle", "time": 10419.349, "timestamp": "02:53:39", "text": "我有更大的自由去关注我想关注的人。"}, {"type": "subtitle", "time": 10422.469, "timestamp": "02:53:42", "text": "以及所有的一切。更像是……"}, {"type": "subtitle", "time": 10425.309, "timestamp": "02:53:45", "text": "主账号就像一个公关账号"}, {"type": "subtitle", "time": 10428.389, "timestamp": "02:53:48", "text": "账户，公共推广账户"}, {"type": "subtitle", "time": 10431.429, "timestamp": "02:53:51", "text": "一个东西，另一个更像我的"}, {"type": "subtitle", "time": 10433.83, "timestamp": "02:53:53", "text": "我可以在公共二级账户中做什么"}, {"type": "subtitle", "time": 10436.349, "timestamp": "02:53:56", "text": "随心所欲，跟随他人"}, {"type": "subtitle", "time": 10438.59, "timestamp": "02:53:58", "text": "等等。是的。"}]
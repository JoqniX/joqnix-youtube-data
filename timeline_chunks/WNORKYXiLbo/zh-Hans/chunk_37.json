[{"type": "subtitle", "time": 2222.31, "timestamp": "00:37:02", "text": "我有时挺喜欢这个虚拟旅游社区的。"}, {"type": "subtitle", "time": 2225.91, "timestamp": "00:37:05", "text": "太痛苦了，就像一部电视剧一样。"}, {"type": "subtitle", "time": 2228.15, "timestamp": "00:37:08", "text": "其他社区的人会通过协商解决，或者"}, {"type": "subtitle", "time": 2231.03, "timestamp": "00:37:11", "text": "小打小闹之类的，就这些。他们会"}, {"type": "subtitle", "time": 2233.43, "timestamp": "00:37:13", "text": "他们之间有过节，但他们会重归于好。"}, {"type": "subtitle", "time": 2236.55, "timestamp": "00:37:16", "text": "一起。但看到这一切，推特"}, {"type": "subtitle", "time": 2239.51, "timestamp": "00:37:19", "text": "比如公开指责别人"}, {"type": "subtitle", "time": 2242.63, "timestamp": "00:37:22", "text": "并发表公开公益广告之类的言论，公开"}, {"type": "subtitle", "time": 2245.27, "timestamp": "00:37:25", "text": "服务意识之类的东西"}, {"type": "subtitle", "time": 2248.23, "timestamp": "00:37:28", "text": "告诉他们不要搞猎巫行动"}, {"type": "subtitle", "time": 2251.19, "timestamp": "00:37:31", "text": "向他们散播仇恨。他们这样做"}, {"type": "subtitle", "time": 2254.39, "timestamp": "00:37:34", "text": "Twitter 上的 Google 文档公开"}, {"type": "subtitle", "time": 2258.47, "timestamp": "00:37:38", "text": "它更加戏剧化、更加引人注目。"}, {"type": "subtitle", "time": 2261.589, "timestamp": "00:37:41", "text": "人们这样做，也憎恨这样做，这使得它成为一种"}, {"type": "chat", "time": 2262.521, "timestamp": "00:37:42", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "gotta stay away from that kinda stuff"}, {"type": "subtitle", "time": 2264.55, "timestamp": "00:37:44", "text": "病毒式新闻或其他什么的，还有一些"}, {"type": "subtitle", "time": 2267.43, "timestamp": "00:37:47", "text": "人们甚至会做这种戏剧性的事情。"}, {"type": "subtitle", "time": 2269.39, "timestamp": "00:37:49", "text": "浏览量"}, {"type": "subtitle", "time": 2272.23, "timestamp": "00:37:52", "text": "增长，以及你知道的，作为一种消极的方式。"}, {"type": "subtitle", "time": 2274.75, "timestamp": "00:37:54", "text": "为了影响力和"}, {"type": "chat", "time": 2275.252, "timestamp": "00:37:55", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "focus on self, chill with friends"}, {"type": "subtitle", "time": 2278.95, "timestamp": "00:37:58", "text": "一切，还有这红色的管子"}]
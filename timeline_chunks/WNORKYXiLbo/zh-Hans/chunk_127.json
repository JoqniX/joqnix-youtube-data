[{"type": "subtitle", "time": 7621.43, "timestamp": "02:07:01", "text": "加入的压力。它把一切都告诉你了"}, {"type": "subtitle", "time": 7623.189, "timestamp": "02:07:03", "text": "如果你真的想参加这些活动的话"}, {"type": "subtitle", "time": 7625.03, "timestamp": "02:07:05", "text": "真的会像那些日子一样继续关注"}, {"type": "subtitle", "time": 7627.189, "timestamp": "02:07:07", "text": "这里聚集了一些特别的人。我们有导师"}, {"type": "subtitle", "time": 7629.51, "timestamp": "02:07:09", "text": "星期一，也就是即将到来的星期一。"}, {"type": "subtitle", "time": 7633.99, "timestamp": "02:07:13", "text": "星期。嗯，我们这整个周末都有空。"}, {"type": "subtitle", "time": 7635.91, "timestamp": "02:07:15", "text": "这周真是忙得不可开交。"}, {"type": "subtitle", "time": 7638.149, "timestamp": "02:07:18", "text": "东西。所以，甚至不用担心"}, {"type": "subtitle", "time": 7640.629, "timestamp": "02:07:20", "text": "错过其中一天，因为直到"}, {"type": "subtitle", "time": 7642.55, "timestamp": "02:07:22", "text": "周二。"}, {"type": "subtitle", "time": 7643.75, "timestamp": "02:07:23", "text": "我想今天是星期二。让我加倍"}, {"type": "subtitle", "time": 7646.629, "timestamp": "02:07:26", "text": "查看。"}, {"type": "subtitle", "time": 7648.109, "timestamp": "02:07:28", "text": "让我再核对这些"}, {"type": "subtitle", "time": 7651.47, "timestamp": "02:07:31", "text": "公告。我可能在喋喋不休"}, {"type": "subtitle", "time": 7653.83, "timestamp": "02:07:33", "text": "屁股。不，要等到下周二。所以，"}, {"type": "subtitle", "time": 7656.149, "timestamp": "02:07:36", "text": "基本上整整一周。哦好的。"}, {"type": "subtitle", "time": 7658.149, "timestamp": "02:07:38", "text": "17日星期六至20日星期六。我们"}, {"type": "subtitle", "time": 7661.35, "timestamp": "02:07:41", "text": "有很多东西。"}, {"type": "subtitle", "time": 7662.709, "timestamp": "02:07:42", "text": "所以，如果你错过了其中一个，也不要感到难过。"}, {"type": "subtitle", "time": 7664.95, "timestamp": "02:07:44", "text": "那些日子。我们有很多。啊，"}, {"type": "subtitle", "time": 7667.83, "timestamp": "02:07:47", "text": "陷阱。"}, {"type": "subtitle", "time": 7677.99, "timestamp": "02:07:57", "text": "是的。这里。哦，他们会给你呃……"}, {"type": "subtitle", "time": 7679.83, "timestamp": "02:07:59", "text": "如果你没有的话，可以聊聊这个。"}]
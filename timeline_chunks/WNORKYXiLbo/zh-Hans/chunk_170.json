[{"type": "subtitle", "time": 10200.15, "timestamp": "02:50:00", "text": "当我更多地了解他们时，我感觉"}, {"type": "subtitle", "time": 10202.95, "timestamp": "02:50:02", "text": "我好像有很多问题想问。我感觉"}, {"type": "subtitle", "time": 10204.63, "timestamp": "02:50:04", "text": "我现在就打算开始自己的播客了。"}, {"type": "subtitle", "time": 10204.97, "timestamp": "02:50:04", "text": "或者"}, {"type": "subtitle", "time": 10206.269, "timestamp": "02:50:06", "text": "[音乐]"}, {"type": "subtitle", "time": 10209.71, "timestamp": "02:50:09", "text": "任何。但是，是的，就像"}, {"type": "subtitle", "time": 10212.95, "timestamp": "02:50:12", "text": "真的像我期待的那样好玩。"}, {"type": "subtitle", "time": 10217.23, "timestamp": "02:50:17", "text": "问他，你如何处理和管理"}, {"type": "subtitle", "time": 10220.79, "timestamp": "02:50:20", "text": "这些东西？"}, {"type": "subtitle", "time": 10223.429, "timestamp": "02:50:23", "text": "是啊，那太酷了。不，其实"}, {"type": "subtitle", "time": 10227.269, "timestamp": "02:50:27", "text": "密切关注你的审核情况"}, {"type": "subtitle", "time": 10228.429, "timestamp": "02:50:28", "text": "主播"}, {"type": "subtitle", "time": 10231.269, "timestamp": "02:50:31", "text": "在窗下聊天，也做"}, {"type": "subtitle", "time": 10234.79, "timestamp": "02:50:34", "text": "这是业余爱好和闲逛。那是"}, {"type": "subtitle", "time": 10240.03, "timestamp": "02:50:40", "text": "凉爽的。我的头发"}, {"type": "subtitle", "time": 10253.87, "timestamp": "02:50:53", "text": "黑暗的。太好玩了。这真是太"}]
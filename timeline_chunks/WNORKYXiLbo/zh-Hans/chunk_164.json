[{"type": "subtitle", "time": 9843.309, "timestamp": "02:44:03", "text": "适应了，实际上"}, {"type": "subtitle", "time": 9850.99, "timestamp": "02:44:10", "text": "已改编。我其实"}, {"type": "subtitle", "time": 9852.91, "timestamp": "02:44:12", "text": "已改编。"}, {"type": "subtitle", "time": 9855.83, "timestamp": "02:44:15", "text": "嗯，我其实已经适应了和别人交谈。"}, {"type": "subtitle", "time": 9858.269, "timestamp": "02:44:18", "text": "陌生人。是的。"}, {"type": "subtitle", "time": 9860.03, "timestamp": "02:44:20", "text": "再见。"}, {"type": "subtitle", "time": 9869.71, "timestamp": "02:44:29", "text": "红色的好处是……"}, {"type": "subtitle", "time": 9871.309, "timestamp": "02:44:31", "text": "不"}, {"type": "subtitle", "time": 9875.429, "timestamp": "02:44:35", "text": "他们中没有一个像他们中的大多数人那样。"}, {"type": "subtitle", "time": 9878.349, "timestamp": "02:44:38", "text": "他们都很冷静，"}, {"type": "subtitle", "time": 9883.83, "timestamp": "02:44:43", "text": "他们都很友善，而且没有一个人粗鲁无礼。"}, {"type": "subtitle", "time": 9887.55, "timestamp": "02:44:47", "text": "或者其他任何东西，那就是"}, {"type": "subtitle", "time": 9890.83, "timestamp": "02:44:50", "text": "很好，就是这样。"}]
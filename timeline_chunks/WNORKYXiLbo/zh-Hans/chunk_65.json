[{"type": "subtitle", "time": 3900.789, "timestamp": "01:05:00", "text": "有足够的钱委托制作"}, {"type": "subtitle", "time": 3903.67, "timestamp": "01:05:03", "text": "然后我就可以把它做成壁纸之类的东西了。"}, {"type": "subtitle", "time": 3906.069, "timestamp": "01:05:06", "text": "呃，比如说我们做了壁纸那件事"}, {"type": "subtitle", "time": 3909.67, "timestamp": "01:05:09", "text": "从一月份开始，然后接下来……"}, {"type": "subtitle", "time": 3912.15, "timestamp": "01:05:12", "text": "比如6个月左右，我可以接受"}, {"type": "subtitle", "time": 3914.789, "timestamp": "01:05:14", "text": "将这些重新利用为限时活动"}, {"type": "subtitle", "time": 3915.87, "timestamp": "01:05:15", "text": "提供或"}, {"type": "subtitle", "time": 3919.67, "timestamp": "01:05:19", "text": "有些东西，还有一些其他的东西，嗯，给那些"}, {"type": "subtitle", "time": 3921.99, "timestamp": "01:05:21", "text": "想要免费获得之类的。那"}, {"type": "subtitle", "time": 3925.19, "timestamp": "01:05:25", "text": "也仅适用于自定义"}, {"type": "subtitle", "time": 3928.309, "timestamp": "01:05:28", "text": "我想放在网站上的东西。"}, {"type": "subtitle", "time": 3930.43, "timestamp": "01:05:30", "text": "那个普遍的解释"}, {"type": "subtitle", "time": 3933.309, "timestamp": "01:05:33", "text": "那个地方，来自其他所有地方的人都在那里"}, {"type": "subtitle", "time": 3936.15, "timestamp": "01:05:36", "text": "平台可以像注册一样使用他们的"}, {"type": "subtitle", "time": 3938.349, "timestamp": "01:05:38", "text": "拥有自己的帐户，并且仍然可以访问"}, {"type": "subtitle", "time": 3941.47, "timestamp": "01:05:41", "text": "一切。他们可以链接他们的YouTube账号，"}, {"type": "subtitle", "time": 3944.789, "timestamp": "01:05:44", "text": "Twitch账号之类的。是的，我"}, {"type": "subtitle", "time": 3946.589, "timestamp": "01:05:46", "text": "我希望有一天能做到那样。"}, {"type": "subtitle", "time": 3950.71, "timestamp": "01:05:50", "text": "男人。以擅长做这类事情而闻名"}, {"type": "subtitle", "time": 3958.829, "timestamp": "01:05:58", "text": "但这样做很好，但我想要现金。"}]
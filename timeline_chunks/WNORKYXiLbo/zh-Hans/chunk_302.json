[{"type": "subtitle", "time": 18122.31, "timestamp": "05:02:02", "text": "5月24日晚上7:30 5月24日。我们有"}, {"type": "subtitle", "time": 18124.15, "timestamp": "05:02:04", "text": "第一的"}, {"type": "subtitle", "time": 18128.07, "timestamp": "05:02:08", "text": "呃，打电话给VC那边。"}, {"type": "subtitle", "time": 18137.31, "timestamp": "05:02:17", "text": "嗯，那是24号的事。"}, {"type": "subtitle", "time": 18141.51, "timestamp": "05:02:21", "text": "三月，是的，我们当时就像"}, {"type": "subtitle", "time": 18143.67, "timestamp": "05:02:23", "text": "因为我本来应该去度假的"}, {"type": "subtitle", "time": 18146.55, "timestamp": "05:02:26", "text": "和家人一起待了3天"}, {"type": "subtitle", "time": 18148.15, "timestamp": "05:02:28", "text": "呃，我不知道你是否了解这个"}, {"type": "subtitle", "time": 18150.39, "timestamp": "05:02:30", "text": "有个地方叫瓦兰加尼，对吧？我得去那里。"}, {"type": "subtitle", "time": 18154.55, "timestamp": "05:02:34", "text": "他们去了，因为家人就像……呃"}, {"type": "subtitle", "time": 18159.67, "timestamp": "05:02:39", "text": "献祭之类的。所以，就像如果呃"}, {"type": "subtitle", "time": 18163.43, "timestamp": "05:02:43", "text": "现在有租客来这里租房了"}, {"type": "subtitle", "time": 18165.83, "timestamp": "05:02:45", "text": "如果它进入商业空间，它就能获得"}, {"type": "subtitle", "time": 18168.788, "timestamp": "05:02:48", "text": "被带走了，最后人们来了。"}, {"type": "subtitle", "time": 18173.19, "timestamp": "05:02:53", "text": "我们全家会去拜访。"}, {"type": "subtitle", "time": 18175.83, "timestamp": "05:02:55", "text": "东西等等。"}, {"type": "subtitle", "time": 18177.91, "timestamp": "05:02:57", "text": "是的，某种程度上，我能理解，但他们并没有。"}]
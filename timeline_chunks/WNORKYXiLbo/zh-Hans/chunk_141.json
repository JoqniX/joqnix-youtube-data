[{"type": "subtitle", "time": 8462.95, "timestamp": "02:21:02", "text": "是的，这事确实发生过。我确实喜欢"}, {"type": "subtitle", "time": 8465.75, "timestamp": "02:21:05", "text": "嗯，我确实和一些油管博主见过面。"}, {"type": "subtitle", "time": 8468.15, "timestamp": "02:21:08", "text": "我的朋友们，他们真的看到了"}, {"type": "subtitle", "time": 8469.75, "timestamp": "02:21:09", "text": "那。"}, {"type": "subtitle", "time": 8471.91, "timestamp": "02:21:11", "text": "是的。他们会说：“哦，这很搭。”"}, {"type": "subtitle", "time": 8475.91, "timestamp": "02:21:15", "text": "耶。嘿。是的。那么，另一个怎么样？"}, {"type": "subtitle", "time": 8478.79, "timestamp": "02:21:18", "text": "天？一切顺利。制作"}, {"type": "subtitle", "time": 8480.87, "timestamp": "02:21:20", "text": "账户，摆弄所有按钮，"}, {"type": "subtitle", "time": 8483.67, "timestamp": "02:21:23", "text": "学习新事物，并了解它如何运作"}, {"type": "subtitle", "time": 8486.55, "timestamp": "02:21:26", "text": "一切皆有可能。你的直播进行得怎么样？哦，"}, {"type": "subtitle", "time": 8489.11, "timestamp": "02:21:29", "text": "一切顺利。我正在尝试这个"}, {"type": "subtitle", "time": 8492.23, "timestamp": "02:21:32", "text": "网络聊天。我当时紧张得要命。"}, {"type": "subtitle", "time": 8494.07, "timestamp": "02:21:34", "text": "跟人聊聊，嗯，事情正在发展。"}, {"type": "subtitle", "time": 8496.87, "timestamp": "02:21:36", "text": "目前为止一切顺利。"}, {"type": "subtitle", "time": 8499.27, "timestamp": "02:21:39", "text": "是的，似乎每个人都……"}, {"type": "subtitle", "time": 8500.95, "timestamp": "02:21:40", "text": "这部分挺酷的。"}, {"type": "subtitle", "time": 8502.87, "timestamp": "02:21:42", "text": "看起来确实能获得相当广泛的范围。"}, {"type": "subtitle", "time": 8507.349, "timestamp": "02:21:47", "text": "适合各个年龄段的人，所以总是很有趣。是的，"}, {"type": "subtitle", "time": 8514.07, "timestamp": "02:21:54", "text": "我注意到这里有个计时器。"}, {"type": "subtitle", "time": 8516.63, "timestamp": "02:21:56", "text": "东西。是因为人们拥有它吗？"}, {"type": "subtitle", "time": 8519.67, "timestamp": "02:21:59", "text": "开机了吗？是的。所以，我刚才和……聊了聊"}]
[{"type": "subtitle", "time": 481.83, "timestamp": "00:08:01", "text": "受欢迎的佣金率和"}, {"type": "subtitle", "time": 484.749, "timestamp": "00:08:04", "text": "那里的一切都变了"}, {"type": "subtitle", "time": 489.07, "timestamp": "00:08:09", "text": "时间，而这正是我害怕的地方。"}, {"type": "subtitle", "time": 492.15, "timestamp": "00:08:12", "text": "此外，我还得支付许可证费用。"}, {"type": "subtitle", "time": 499.23, "timestamp": "00:08:19", "text": "所以"}, {"type": "subtitle", "time": 503.27, "timestamp": "00:08:23", "text": "是啊，说实话，我真的不喜欢。"}, {"type": "subtitle", "time": 506.51, "timestamp": "00:08:26", "text": "我愿意更有耐心，你"}, {"type": "subtitle", "time": 508.909, "timestamp": "00:08:28", "text": "知道，"}, {"type": "subtitle", "time": 513.389, "timestamp": "00:08:33", "text": "但是我的所有作品都已经完成了。但"}, {"type": "subtitle", "time": 516.35, "timestamp": "00:08:36", "text": "想象一下，就像艺术是"}, {"type": "subtitle", "time": 520.949, "timestamp": "00:08:40", "text": "就像我说的，呃，我呃，艺术作品完成了"}, {"type": "subtitle", "time": 524.23, "timestamp": "00:08:44", "text": "现在可以，但你必须等待"}, {"type": "subtitle", "time": 526.71, "timestamp": "00:08:46", "text": "七年，或者说不到七年也太长了。"}, {"type": "subtitle", "time": 528.63, "timestamp": "00:08:48", "text": "差不多三四年吧，至少"}, {"type": "subtitle", "time": 531.71, "timestamp": "00:08:51", "text": "或至少两年，一年"}, {"type": "subtitle", "time": 535.43, "timestamp": "00:08:55", "text": "至少要把整件事都弄明白，就像……一样"}, {"type": "subtitle", "time": 537.67, "timestamp": "00:08:57", "text": "既然你喜欢，那就这样吧"}, {"type": "subtitle", "time": 539.59, "timestamp": "00:08:59", "text": "比如说有人投资了我之类的。"}]
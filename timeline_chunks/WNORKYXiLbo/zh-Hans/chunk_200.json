[{"type": "subtitle", "time": 12007.469, "timestamp": "03:20:07", "text": "研磨。我真的努力奋斗过了，现在……"}, {"type": "subtitle", "time": 12011.07, "timestamp": "03:20:11", "text": "64. 明天将是"}, {"type": "subtitle", "time": 12019.55, "timestamp": "03:20:19", "text": "它？哦，我的"}, {"type": "subtitle", "time": 12021.91, "timestamp": "03:20:21", "text": "上帝。什么时候是“哦，对了，我需要……”"}, {"type": "subtitle", "time": 12024.07, "timestamp": "03:20:24", "text": "联系对方确认比赛事宜。这"}, {"type": "subtitle", "time": 12026.79, "timestamp": "03:20:26", "text": "我现在彻底糊涂了。我该怎么办？"}, {"type": "subtitle", "time": 12029.389, "timestamp": "03:20:29", "text": "玩"}, {"type": "subtitle", "time": 12038.99, "timestamp": "03:20:38", "text": "呃，我"}, {"type": "subtitle", "time": 12041.55, "timestamp": "03:20:41", "text": "不可能吧，现在是晚上"}, {"type": "subtitle", "time": 12046.15, "timestamp": "03:20:46", "text": "和喵喵和米奇在一起。嗯，它在……"}, {"type": "subtitle", "time": 12047.95, "timestamp": "03:20:47", "text": "夜晚"}, {"type": "subtitle", "time": 12057.19, "timestamp": "03:20:57", "text": "不是因为我必须早起，所以"}]
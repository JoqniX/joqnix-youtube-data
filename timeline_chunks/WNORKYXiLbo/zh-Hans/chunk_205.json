[{"type": "subtitle", "time": 12301.83, "timestamp": "03:25:01", "text": "已经打电话了，呃，跟我谈过了。"}, {"type": "subtitle", "time": 12306.429, "timestamp": "03:25:06", "text": "我们在这段旅程中相遇了"}, {"type": "subtitle", "time": 12309.99, "timestamp": "03:25:09", "text": "以及计划和空闲时间"}, {"type": "subtitle", "time": 12314.87, "timestamp": "03:25:14", "text": "货源太难找了，真是太麻烦了。"}, {"type": "subtitle", "time": 12317.19, "timestamp": "03:25:17", "text": "呃，我不太想数数。"}, {"type": "subtitle", "time": 12320.229, "timestamp": "03:25:20", "text": "小组活动、小组合作，以及其他"}, {"type": "subtitle", "time": 12322.469, "timestamp": "03:25:22", "text": "分组颜色可以计数，但我也"}, {"type": "subtitle", "time": 12324.36, "timestamp": "03:25:24", "text": "感觉像"}, {"type": "subtitle", "time": 12331.269, "timestamp": "03:25:31", "text": "嗯，我觉得如果我有……会更好。"}, {"type": "subtitle", "time": 12334.309, "timestamp": "03:25:34", "text": "就是那个开放式的风险投资平台，对吧？是的。你"}, {"type": "subtitle", "time": 12336.83, "timestamp": "03:25:36", "text": "知道什么？我明天就去做。"}, {"type": "subtitle", "time": 12340.269, "timestamp": "03:25:40", "text": "早晨。无论如何，我都要去做"}, {"type": "subtitle", "time": 12342.03, "timestamp": "03:25:42", "text": "那。"}, {"type": "subtitle", "time": 12345.51, "timestamp": "03:25:45", "text": "是的。你好。现在是3点30分。我这就去"}, {"type": "subtitle", "time": 12348.51, "timestamp": "03:25:48", "text": "睡觉。我这就下楼去吃饭。"}, {"type": "subtitle", "time": 12351.67, "timestamp": "03:25:51", "text": "喝点茶，喝点东西，然后睡觉。"}, {"type": "subtitle", "time": 12354.55, "timestamp": "03:25:54", "text": "睡觉。因为茶，红茶让我"}, {"type": "subtitle", "time": 12356.75, "timestamp": "03:25:56", "text": "晚上让我入睡"}, {"type": "subtitle", "time": 12359.269, "timestamp": "03:25:59", "text": "实际上，因为我一直都在这样做。"}]
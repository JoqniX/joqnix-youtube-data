[{"type": "subtitle", "time": 12362.51, "timestamp": "03:26:02", "text": "像七、五、六年那样，喝黑咖啡"}, {"type": "subtitle", "time": 12365.349, "timestamp": "03:26:05", "text": "因为我无聊，所以想喝茶。有"}, {"type": "subtitle", "time": 12368.11, "timestamp": "03:26:08", "text": "没有东西吃。"}, {"type": "subtitle", "time": 12371.51, "timestamp": "03:26:11", "text": "呃，我以前常喝茶，然后……"}, {"type": "subtitle", "time": 12388.79, "timestamp": "03:26:28", "text": "告诉你，我有个计划。它不是"}, {"type": "subtitle", "time": 12391.07, "timestamp": "03:26:31", "text": "确认的"}, {"type": "subtitle", "time": 12393.99, "timestamp": "03:26:33", "text": "然而。有点想把我的眼睛露出来"}, {"type": "subtitle", "time": 12397.83, "timestamp": "03:26:37", "text": "一位朋友，一个我紧紧拥抱的人"}, {"type": "subtitle", "time": 12402.87, "timestamp": "03:26:42", "text": "紧紧地抱着我，嗯，就像……来吧"}, {"type": "subtitle", "time": 12404.269, "timestamp": "03:26:44", "text": "流和"}, {"type": "subtitle", "time": 12407.91, "timestamp": "03:26:47", "text": "比如聊天什么的，感觉更像是……"}, {"type": "subtitle", "time": 12410.83, "timestamp": "03:26:50", "text": "就像和我互动一样"}, {"type": "subtitle", "time": 12413.51, "timestamp": "03:26:53", "text": "但是如果"}, {"type": "subtitle", "time": 12415.83, "timestamp": "03:26:55", "text": "嗯，聊天室里有些人会"}, {"type": "subtitle", "time": 12419.349, "timestamp": "03:26:59", "text": "想和他们谈谈，也喜欢他们"}]
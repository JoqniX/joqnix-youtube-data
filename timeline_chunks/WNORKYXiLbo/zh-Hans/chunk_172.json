[{"type": "subtitle", "time": 10322.389, "timestamp": "02:52:02", "text": "随便什么事。是的，我仍然"}, {"type": "subtitle", "time": 10324.71, "timestamp": "02:52:04", "text": "研磨。"}, {"type": "subtitle", "time": 10326.79, "timestamp": "02:52:06", "text": "那让我有点高兴，你"}, {"type": "subtitle", "time": 10327.79, "timestamp": "02:52:07", "text": "知道，"}, {"type": "subtitle", "time": 10330.87, "timestamp": "02:52:10", "text": "实际上。嗯，他们问我过得怎么样，"}, {"type": "subtitle", "time": 10333.19, "timestamp": "02:52:13", "text": "一切。你还好吗？还有其他一些东西，因为"}, {"type": "subtitle", "time": 10341.87, "timestamp": "02:52:21", "text": "现在。"}, {"type": "subtitle", "time": 10345.07, "timestamp": "02:52:25", "text": "是的。哦，这让我……"}, {"type": "subtitle", "time": 10348.87, "timestamp": "02:52:28", "text": "快乐的。坚持，稍等。"}, {"type": "subtitle", "time": 10351.91, "timestamp": "02:52:31", "text": "呃，尤其是其中一件事情……"}, {"type": "subtitle", "time": 10355.23, "timestamp": "02:52:35", "text": "最担心的事"}, {"type": "subtitle", "time": 10358.75, "timestamp": "02:52:38", "text": "更好的神"}, {"type": "subtitle", "time": 10360.83, "timestamp": "02:52:40", "text": "叽叽喳喳。"}, {"type": "subtitle", "time": 10364.99, "timestamp": "02:52:44", "text": "呃，我更担心幼儿的事情。"}, {"type": "subtitle", "time": 10379.469, "timestamp": "02:52:59", "text": "我不知道，我不知道"}]
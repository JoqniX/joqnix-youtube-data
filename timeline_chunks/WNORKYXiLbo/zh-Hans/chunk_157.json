[{"type": "subtitle", "time": 9423.19, "timestamp": "02:37:03", "text": "你好。我现在可以做了。"}, {"type": "subtitle", "time": 9425.429, "timestamp": "02:37:05", "text": "是的。"}, {"type": "subtitle", "time": 9427.27, "timestamp": "02:37:07", "text": "真的吗？我右边只有一个追踪器。"}, {"type": "subtitle", "time": 9429.91, "timestamp": "02:37:09", "text": "现在因为我还没做好肩带。"}, {"type": "subtitle", "time": 9433.11, "timestamp": "02:37:13", "text": "我还没把它们和我联系起来。哦。"}, {"type": "subtitle", "time": 9435.11, "timestamp": "02:37:15", "text": "哦，所以你必须拿着它"}, {"type": "subtitle", "time": 9437.349, "timestamp": "02:37:17", "text": "一直如此。是的，我只是拿着它。"}, {"type": "subtitle", "time": 9439.83, "timestamp": "02:37:19", "text": "在我手中。"}, {"type": "subtitle", "time": 9441.99, "timestamp": "02:37:21", "text": "但你难道不需要喜欢名字吗？呃，就像"}, {"type": "subtitle", "time": 9444.389, "timestamp": "02:37:24", "text": "贴上标签，这样你就知道这是你的权利。"}, {"type": "subtitle", "time": 9447.349, "timestamp": "02:37:27", "text": "像这样的手部追踪器吗？是的，我会"}, {"type": "subtitle", "time": 9449.03, "timestamp": "02:37:29", "text": "迟早都得这么做。我只是"}, {"type": "subtitle", "time": 9451.59, "timestamp": "02:37:31", "text": "焊接完成了。呃，所以我刚才说什么？"}, {"type": "subtitle", "time": 9453.99, "timestamp": "02:37:33", "text": "我做的就是随便拿了一个追踪器"}, {"type": "subtitle", "time": 9455.83, "timestamp": "02:37:35", "text": "碰巧是我的脚，而且我"}, {"type": "subtitle", "time": 9458.79, "timestamp": "02:37:38", "text": "把它移到了我的手臂上。"}, {"type": "subtitle", "time": 9460.15, "timestamp": "02:37:40", "text": "我不知道你刚才有没有看到。"}, {"type": "subtitle", "time": 9461.349, "timestamp": "02:37:41", "text": "当你和朋友说话的时候"}, {"type": "subtitle", "time": 9463.75, "timestamp": "02:37:43", "text": "我的AR腿当时就像离地面一样。"}, {"type": "subtitle", "time": 9466.71, "timestamp": "02:37:46", "text": "嗯，是的，我看到了。是的。那是"}, {"type": "subtitle", "time": 9468.389, "timestamp": "02:37:48", "text": "因为我拿错了追踪器"}, {"type": "subtitle", "time": 9470.07, "timestamp": "02:37:50", "text": "我以为我还没布置这个作业呢。"}, {"type": "subtitle", "time": 9472.07, "timestamp": "02:37:52", "text": "因为这是我放的最后一个。"}, {"type": "subtitle", "time": 9475.11, "timestamp": "02:37:55", "text": "一起。嗯。"}, {"type": "subtitle", "time": 9477.83, "timestamp": "02:37:57", "text": "是的。呃，如果你想做……你有……"}]
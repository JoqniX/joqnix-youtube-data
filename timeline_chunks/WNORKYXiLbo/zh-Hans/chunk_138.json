[{"type": "subtitle", "time": 8283.27, "timestamp": "02:18:03", "text": "因为我喜欢，所以想找个男模看看。我喜欢"}, {"type": "subtitle", "time": 8288.79, "timestamp": "02:18:08", "text": "正是这种模棱两可之处。所以，"}, {"type": "subtitle", "time": 8291.349, "timestamp": "02:18:11", "text": "是啊，真漂亮。"}, {"type": "subtitle", "time": 8293.87, "timestamp": "02:18:13", "text": "哦，非常感谢。"}, {"type": "subtitle", "time": 8297.589, "timestamp": "02:18:17", "text": "是的。呃，这是个呃，是你，你呢？"}, {"type": "subtitle", "time": 8299.99, "timestamp": "02:18:19", "text": "像3D效果一样，还是像“不，这是3D效果，对吧？”"}, {"type": "subtitle", "time": 8304.07, "timestamp": "02:18:24", "text": "是的，是它的二维版本。我希望我有2D设备。"}, {"type": "subtitle", "time": 8307.309, "timestamp": "02:18:27", "text": "我现在只有3D效果。啊，"}, {"type": "subtitle", "time": 8310.79, "timestamp": "02:18:30", "text": "陷阱。是的。所以，你喜欢"}, {"type": "subtitle", "time": 8314.309, "timestamp": "02:18:34", "text": "还设计了不同的服装？我愿意"}, {"type": "subtitle", "time": 8318.309, "timestamp": "02:18:38", "text": "穿不同的衣服。哦，不错。"}, {"type": "subtitle", "time": 8320.07, "timestamp": "02:18:40", "text": "比如说，让我看看我是否"}, {"type": "subtitle", "time": 8321.91, "timestamp": "02:18:41", "text": "很快就能拿到一个。我可以改变"}, {"type": "subtitle", "time": 8324.429, "timestamp": "02:18:44", "text": "我的穿搭。这是我的一种赎回。"}, {"type": "subtitle", "time": 8328.629, "timestamp": "02:18:48", "text": "溪流。我看看我手里拿的是哪一个。"}, {"type": "subtitle", "time": 8330.629, "timestamp": "02:18:50", "text": "H和服挺好的。我们可以跳进去"}, {"type": "subtitle", "time": 8333.549, "timestamp": "02:18:53", "text": "和服套装。砰。 A，那真是太……"}, {"type": "subtitle", "time": 8338.389, "timestamp": "02:18:58", "text": "漂亮的。我的天哪，太漂亮了。"}]
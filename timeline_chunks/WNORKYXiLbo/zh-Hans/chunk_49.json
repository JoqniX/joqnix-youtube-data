[{"type": "subtitle", "time": 2941.589, "timestamp": "00:49:01", "text": "还有一些公司主动联系了我。"}, {"type": "subtitle", "time": 2945.349, "timestamp": "00:49:05", "text": "要求提供类似分析图表"}, {"type": "subtitle", "time": 2949.27, "timestamp": "00:49:09", "text": "至于那份清单，呃，当我拥有它的时候"}, {"type": "subtitle", "time": 2950.51, "timestamp": "00:49:10", "text": "那"}, {"type": "subtitle", "time": 2952.99, "timestamp": "00:49:12", "text": "时间"}, {"type": "chat", "time": 2953.12, "timestamp": "00:49:13", "author": "@SuzukiZurikoVTuber", "avatar": "https://yt4.ggpht.com/852SZLheWUnfQGntgjphW0AD17oXLR9MhuzMLEzOm451wzhCllgmSUMTMpDu7wtBK7HSHR9J=s64-c-k-c0x00ffffff-no-rj", "message": "WHAT"}, {"type": "subtitle", "time": 2956.99, "timestamp": "00:49:16", "text": "但是，哦，天哪，真是"}, {"type": "subtitle", "time": 2961.27, "timestamp": "00:49:21", "text": "疼痛，我在想我能……我的意思是，呃……"}, {"type": "subtitle", "time": 2965.19, "timestamp": "00:49:25", "text": "不介意继续像这样送出去"}, {"type": "subtitle", "time": 2968.23, "timestamp": "00:49:28", "text": "任何人……呃，我有个想法，行得通……呃"}, {"type": "subtitle", "time": 2972.47, "timestamp": "00:49:32", "text": "就像 Invuber 的工作区之类的东西"}, {"type": "subtitle", "time": 2975.75, "timestamp": "00:49:35", "text": "我确实做了，但是现在的问题是……"}, {"type": "subtitle", "time": 2978.27, "timestamp": "00:49:38", "text": "我担心的是分类问题。"}, {"type": "subtitle", "time": 2980.87, "timestamp": "00:49:40", "text": "好像出现了一些问题"}, {"type": "subtitle", "time": 2983.67, "timestamp": "00:49:43", "text": "例如如何处理主播"}, {"type": "subtitle", "time": 2985.63, "timestamp": "00:49:45", "text": "成为 YouTuber。他们还在吗？"}, {"type": "subtitle", "time": 2987.15, "timestamp": "00:49:47", "text": "经过考虑的"}, {"type": "subtitle", "time": 2989.589, "timestamp": "00:49:49", "text": "YouTuber？当然，从某种意义上说，它们确实如此。"}, {"type": "subtitle", "time": 2992.27, "timestamp": "00:49:52", "text": "现代虚拟主播的感觉"}, {"type": "subtitle", "time": 2997.19, "timestamp": "00:49:57", "text": "是。嗯，是的，诸如此类的事情。"}]
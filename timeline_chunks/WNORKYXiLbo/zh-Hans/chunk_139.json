[{"type": "subtitle", "time": 8344.95, "timestamp": "02:19:04", "text": "我为不同的场合准备了不同的服装。"}, {"type": "subtitle", "time": 8346.309, "timestamp": "02:19:06", "text": "表格之类的东西。这完全取决于……"}, {"type": "subtitle", "time": 8348.459, "timestamp": "02:19:08", "text": "我想采取的形式。"}, {"type": "subtitle", "time": 8350.629, "timestamp": "02:19:10", "text": "[音乐]"}, {"type": "subtitle", "time": 8353.83, "timestamp": "02:19:13", "text": "这很酷。所以，就像我可以接受"}, {"type": "subtitle", "time": 8356.15, "timestamp": "02:19:16", "text": "走之前，快速问一个问题。哦，"}, {"type": "subtitle", "time": 8359.11, "timestamp": "02:19:19", "text": "它在移动。哦，不错。好的。哦，那是"}, {"type": "subtitle", "time": 8361.589, "timestamp": "02:19:21", "text": "太酷了。款式也很时尚。"}, {"type": "subtitle", "time": 8365.27, "timestamp": "02:19:25", "text": "啊，非常感谢。"}, {"type": "subtitle", "time": 8372.589, "timestamp": "02:19:32", "text": "在"}, {"type": "subtitle", "time": 8375.07, "timestamp": "02:19:35", "text": "到"}, {"type": "subtitle", "time": 8398.59, "timestamp": "02:19:58", "text": "来的人越来越多"}]
[{"type": "subtitle", "time": 420.55, "timestamp": "00:07:00", "text": "他们对我说他们想要他们"}, {"type": "subtitle", "time": 426.07, "timestamp": "00:07:06", "text": "我同意这个月做这件事，而且"}, {"type": "subtitle", "time": 427.71, "timestamp": "00:07:07", "text": "就像……"}, {"type": "subtitle", "time": 431.27, "timestamp": "00:07:11", "text": "是啊，我就像说你可以随时做这件事"}, {"type": "subtitle", "time": 434.469, "timestamp": "00:07:14", "text": "想。我并不着急，但我的主要"}, {"type": "subtitle", "time": 438.029, "timestamp": "00:07:18", "text": "问题在于资金。"}, {"type": "subtitle", "time": 441.35, "timestamp": "00:07:21", "text": "自从她成为艺术家以来，她就需要一些东西"}, {"type": "subtitle", "time": 444.029, "timestamp": "00:07:24", "text": "重新绘制整个"}, {"type": "subtitle", "time": 447.83, "timestamp": "00:07:27", "text": "事情对吧。她重新绘制了整个画面。"}, {"type": "chat", "time": 449.493, "timestamp": "00:07:29", "author": "@N_I_R_NASHAK", "avatar": "https://yt4.ggpht.com/1tUEQ85FwbdYgcMSwBtAKUjwpzN8k-JYCUeDTQQXUvSFn0hVEvGSW0HPICJMtxNg5tVEcjZ-cOc=s64-c-k-c0x00ffffff-no-rj", "message": "yeaaa vtubing in india is currently in infancy stage still + an hobby thing"}, {"type": "subtitle", "time": 449.749, "timestamp": "00:07:29", "text": "这样就可以进行现场操纵了。"}, {"type": "subtitle", "time": 451.79, "timestamp": "00:07:31", "text": "责任。所以，实战"}, {"type": "subtitle", "time": 455.589, "timestamp": "00:07:35", "text": "索具工她和艺术家他们俩"}, {"type": "subtitle", "time": 459.83, "timestamp": "00:07:39", "text": "需要坐下来好好想想"}, {"type": "subtitle", "time": 462.43, "timestamp": "00:07:42", "text": "嗯，坐下吧。"}, {"type": "subtitle", "time": 466.79, "timestamp": "00:07:46", "text": "就像现在重新绘制所有内容一样。"}, {"type": "subtitle", "time": 470.11, "timestamp": "00:07:50", "text": "所以我必须付钱给这位艺术家。"}, {"type": "subtitle", "time": 472.99, "timestamp": "00:07:52", "text": "按小时和"}, {"type": "subtitle", "time": 476.71, "timestamp": "00:07:56", "text": "是的，而且事情越多，就越"}, {"type": "subtitle", "time": 478.909, "timestamp": "00:07:58", "text": "一位艺术家"}]
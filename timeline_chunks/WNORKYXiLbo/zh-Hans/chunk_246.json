[{"type": "subtitle", "time": 14760.91, "timestamp": "04:06:00", "text": "那"}, {"type": "subtitle", "time": 14763.469, "timestamp": "04:06:03", "text": "其中一个是"}, {"type": "subtitle", "time": 14766.63, "timestamp": "04:06:06", "text": "就像我以前经常做的那样，建立一个社区"}, {"type": "subtitle", "time": 14770.309, "timestamp": "04:06:10", "text": "无论何时我使用移动设备，我都可以执行此操作。"}, {"type": "subtitle", "time": 14773.67, "timestamp": "04:06:13", "text": "在我玩的某些游戏中，它会出现。所以如果"}, {"type": "subtitle", "time": 14775.91, "timestamp": "04:06:15", "text": "玩我们这款游戏的人"}, {"type": "subtitle", "time": 14778.95, "timestamp": "04:06:18", "text": "可以互相切磋，也可以进行突袭或"}, {"type": "subtitle", "time": 14781.389, "timestamp": "04:06:21", "text": "小组活动"}, {"type": "subtitle", "time": 14784.83, "timestamp": "04:06:24", "text": "一起。好的。我通常会这样做"}, {"type": "subtitle", "time": 14788.389, "timestamp": "04:06:28", "text": "那。我觉得人不多。"}, {"type": "subtitle", "time": 14790.55, "timestamp": "04:06:30", "text": "我们当时就在那里。已经有点放弃了。"}, {"type": "subtitle", "time": 14793.429, "timestamp": "04:06:33", "text": "东西。别再那样做了。但我仍然"}, {"type": "subtitle", "time": 14796.75, "timestamp": "04:06:36", "text": "现有的那些，Apex"}]
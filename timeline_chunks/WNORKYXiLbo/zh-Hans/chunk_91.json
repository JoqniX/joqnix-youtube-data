[{"type": "subtitle", "time": 5461.79, "timestamp": "01:31:01", "text": "呃，它出现在我的信息流里。"}, {"type": "subtitle", "time": 5465.229, "timestamp": "01:31:05", "text": "兄弟。她要摔倒了吗？"}, {"type": "subtitle", "time": 5468.55, "timestamp": "01:31:08", "text": "这是什么？恐龙战队。哦，是的"}, {"type": "subtitle", "time": 5471.07, "timestamp": "01:31:11", "text": "神奇的。什么"}, {"type": "subtitle", "time": 5486.31, "timestamp": "01:31:26", "text": "哇。这是一个充满魔力的美少女战士。等待，"}, {"type": "subtitle", "time": 5489.27, "timestamp": "01:31:29", "text": "他们有真人版《美少女战士》吗？"}, {"type": "subtitle", "time": 5494.83, "timestamp": "01:31:34", "text": "等等，不会吧。我以前从不知道这件事。"}, {"type": "subtitle", "time": 5496.91, "timestamp": "01:31:36", "text": "喜欢，"}, {"type": "subtitle", "time": 5501.39, "timestamp": "01:31:41", "text": "该死。哇。对，就是那个游戏。"}, {"type": "subtitle", "time": 5503.47, "timestamp": "01:31:43", "text": "嗯，"}, {"type": "subtitle", "time": 5508.91, "timestamp": "01:31:48", "text": "呃，哪里是"}, {"type": "subtitle", "time": 5513.59, "timestamp": "01:31:53", "text": "它？我觉得我需要切换账户。"}, {"type": "subtitle", "time": 5516.229, "timestamp": "01:31:56", "text": "是在我的主账号上。我想我"}]
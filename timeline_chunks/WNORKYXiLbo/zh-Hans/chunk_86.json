[{"type": "subtitle", "time": 5163.51, "timestamp": "01:26:03", "text": "是的。她太棒了。我想合作"}, {"type": "subtitle", "time": 5165.0, "timestamp": "01:26:05", "text": "但"}, {"type": "subtitle", "time": 5166.75, "timestamp": "01:26:06", "text": "[音乐]"}, {"type": "subtitle", "time": 5169.51, "timestamp": "01:26:09", "text": "仅有的。是的。我得修补一下我的"}, {"type": "subtitle", "time": 5173.149, "timestamp": "01:26:13", "text": "日本人，伙计。我必须学习日语"}, {"type": "subtitle", "time": 5175.83, "timestamp": "01:26:15", "text": "适当地。她也很活跃。做"}, {"type": "subtitle", "time": 5178.47, "timestamp": "01:26:18", "text": "Aiana 直播之类的，直播时间"}, {"type": "subtitle", "time": 5182.39, "timestamp": "01:26:22", "text": "也可以在她的另一个频道上观看。"}, {"type": "subtitle", "time": 5184.43, "timestamp": "01:26:24", "text": "作为"}, {"type": "subtitle", "time": 5187.43, "timestamp": "01:26:27", "text": "渠道。这个也很有趣。是的，她是"}, {"type": "subtitle", "time": 5189.229, "timestamp": "01:26:29", "text": "存活两周"}, {"type": "subtitle", "time": 5191.149, "timestamp": "01:26:31", "text": "前。那是"}, {"type": "subtitle", "time": 5203.59, "timestamp": "01:26:43", "text": "她的节目。"}, {"type": "subtitle", "time": 5205.87, "timestamp": "01:26:45", "text": "但这份谷歌列表如此"}, {"type": "subtitle", "time": 5211.39, "timestamp": "01:26:51", "text": "好的。它有分析功能、图像等等。"}, {"type": "subtitle", "time": 5217.39, "timestamp": "01:26:57", "text": "[音乐]"}]
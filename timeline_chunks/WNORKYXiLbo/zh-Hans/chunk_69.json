[{"type": "subtitle", "time": 4140.95, "timestamp": "01:09:00", "text": "也能起到类似作用的东西"}, {"type": "subtitle", "time": 4148.709, "timestamp": "01:09:08", "text": "知道就像最后……呃，对于虚拟主播来说"}, {"type": "subtitle", "time": 4152.55, "timestamp": "01:09:12", "text": "列表就像一个网格。"}, {"type": "subtitle", "time": 4155.43, "timestamp": "01:09:15", "text": "类似 Holo Live 的 YouTuber 或"}, {"type": "subtitle", "time": 4158.39, "timestamp": "01:09:18", "text": "他们派了人才过来。想想看"}, {"type": "subtitle", "time": 4160.669, "timestamp": "01:09:20", "text": "就是这样。我想我"}, {"type": "subtitle", "time": 4163.189, "timestamp": "01:09:23", "text": "假设人们只需要悬停在……上方"}, {"type": "subtitle", "time": 4165.669, "timestamp": "01:09:25", "text": "头像、他们的名字和"}, {"type": "subtitle", "time": 4170.229, "timestamp": "01:09:30", "text": "头像。你点击弹出的窗口"}, {"type": "subtitle", "time": 4174.189, "timestamp": "01:09:34", "text": "嗯，那个东西突然弹出来了，然后你就看到了"}, {"type": "subtitle", "time": 4177.829, "timestamp": "01:09:37", "text": "他们的横幅或频道之类的东西"}, {"type": "subtitle", "time": 4180.149, "timestamp": "01:09:40", "text": "东西。"}, {"type": "subtitle", "time": 4183.189, "timestamp": "01:09:43", "text": "难道没有一个网站做过这件事吗？"}, {"type": "subtitle", "time": 4185.55, "timestamp": "01:09:45", "text": "跟我刚才说的一样，对吧？"}, {"type": "subtitle", "time": 4187.63, "timestamp": "01:09:47", "text": "现在？"}, {"type": "subtitle", "time": 4190.03, "timestamp": "01:09:50", "text": "呃，全息投影"}, {"type": "subtitle", "time": 4191.49, "timestamp": "01:09:51", "text": "不"}, {"type": "subtitle", "time": 4194.43, "timestamp": "01:09:54", "text": "[音乐]"}, {"type": "subtitle", "time": 4196.91, "timestamp": "01:09:56", "text": "YouTuber holo"}]
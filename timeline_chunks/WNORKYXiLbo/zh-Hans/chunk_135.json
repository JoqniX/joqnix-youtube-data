[{"type": "subtitle", "time": 8101.75, "timestamp": "02:15:01", "text": "模糊吗？是互联网那玩意儿吧？"}, {"type": "subtitle", "time": 8103.51, "timestamp": "02:15:03", "text": "但就像我的事情一直都很模糊一样。"}, {"type": "subtitle", "time": 8105.109, "timestamp": "02:15:05", "text": "一分钟。所以，我真的很开心"}, {"type": "subtitle", "time": 8111.91, "timestamp": "02:15:11", "text": "你今天过得怎么样？就像你"}, {"type": "subtitle", "time": 8114.39, "timestamp": "02:15:14", "text": "今天过得愉快吗？"}, {"type": "subtitle", "time": 8116.709, "timestamp": "02:15:16", "text": "我今天过得挺好的。我正在尝试这个"}, {"type": "subtitle", "time": 8119.03, "timestamp": "02:15:19", "text": "首次外出。我从来没有"}, {"type": "subtitle", "time": 8121.35, "timestamp": "02:15:21", "text": "已完成。嗯，看起来挺酷的。"}, {"type": "subtitle", "time": 8124.149, "timestamp": "02:15:24", "text": "比如偶尔试一试。嗯，我"}, {"type": "subtitle", "time": 8126.069, "timestamp": "02:15:26", "text": "我做得很好。我做了早餐。我拿了我的"}, {"type": "subtitle", "time": 8128.31, "timestamp": "02:15:28", "text": "狗狗出去上厕所了。所以现在我只是"}, {"type": "subtitle", "time": 8132.069, "timestamp": "02:15:32", "text": "这里。我们走吧。是的。我也正在尝试"}, {"type": "subtitle", "time": 8135.35, "timestamp": "02:15:35", "text": "把它拿出来。我当时很害怕喜欢你。"}, {"type": "subtitle", "time": 8138.47, "timestamp": "02:15:38", "text": "我知道，呃，这是我的第一次，而且是"}, {"type": "subtitle", "time": 8141.39, "timestamp": "02:15:41", "text": "我很难跟他/她说话"}, {"type": "subtitle", "time": 8144.79, "timestamp": "02:15:44", "text": "虽然是别人做的，但我做到了。你在和……说话"}, {"type": "subtitle", "time": 8146.629, "timestamp": "02:15:46", "text": "我很好，而且我实际上在"}, {"type": "subtitle", "time": 8149.47, "timestamp": "02:15:49", "text": "学校。"}, {"type": "subtitle", "time": 8153.91, "timestamp": "02:15:53", "text": "是的。那你现在是怎么活下来的？"}, {"type": "subtitle", "time": 8156.55, "timestamp": "02:15:56", "text": "不，我在线。我的聊天记录显示如何"}, {"type": "subtitle", "time": 8159.589, "timestamp": "02:15:59", "text": "他们觉得你的眼睛很漂亮。"}]
[{"type": "subtitle", "time": 17465.19, "timestamp": "04:51:05", "text": "我们应该一起玩游戏，巴卡。我"}, {"type": "subtitle", "time": 17467.948, "timestamp": "04:51:07", "text": "一直很想和你合作，"}, {"type": "subtitle", "time": 17470.788, "timestamp": "04:51:10", "text": "笨蛋。如果我们可以一起玩游戏的话"}, {"type": "subtitle", "time": 17479.0, "timestamp": "04:51:19", "text": "意思是，我会让你……"}, {"type": "subtitle", "time": 17487.47, "timestamp": "04:51:27", "text": "知道何时想要"}, {"type": "subtitle", "time": 17496.628, "timestamp": "04:51:36", "text": "H Apex Gamer，伙计，这会很令人难过"}, {"type": "subtitle", "time": 17498.788, "timestamp": "04:51:38", "text": "现在我要去日本了，我不会"}, {"type": "subtitle", "time": 17508.63, "timestamp": "04:51:48", "text": "兄弟，瓦莱兰也是一样"}, {"type": "subtitle", "time": 17510.75, "timestamp": "04:51:50", "text": "[音乐]"}, {"type": "subtitle", "time": 17513.59, "timestamp": "04:51:53", "text": "兄弟，我也没法玩了。"}, {"type": "subtitle", "time": 17515.99, "timestamp": "04:51:55", "text": "与他人合作，我会被视为……"}, {"type": "subtitle", "time": 17518.708, "timestamp": "04:51:58", "text": "那个外国人喜欢和人在一起"}]
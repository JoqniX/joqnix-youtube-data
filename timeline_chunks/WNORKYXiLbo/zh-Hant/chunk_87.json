[{"type": "subtitle", "time": 5223.27, "timestamp": "01:27:03", "text": "但我喜歡做這件事，你"}, {"type": "subtitle", "time": 5231.91, "timestamp": "01:27:11", "text": "坐下來，進入那種專注的狀態，做各種事情，一兩個小時後，你就做出了一些東西"}, {"type": "subtitle", "time": 5251.75, "timestamp": "01:27:31", "text": "。"}, {"type": "subtitle", "time": 5259.55, "timestamp": "01:27:39", "text": "你或許"}, {"type": "subtitle", "time": 5261.629, "timestamp": "01:27:41", "text": "沒做出什麼好"}, {"type": "subtitle", "time": 5265.51, "timestamp": "01:27:45", "text": "東西，但至少你努力過了。不，那你以後隨時可以回來改進。"}, {"type": "subtitle", "time": 5272.149, "timestamp": "01:27:52", "text": "與藝術和音樂等一切事物類似。"}, {"type": "subtitle", "time": 5275.51, "timestamp": "01:27:55", "text": "我贊成建立維基百科的想法。  順便一提，如果有人有興趣的話，我嘗試為我"}, {"type": "subtitle", "time": 5278.55, "timestamp": "01:27:58", "text": "明年的專案建立一個維基頁面。如果我沒記錯的話，我應該試過mira。不，還有其他免費的維基網站。我的"}]
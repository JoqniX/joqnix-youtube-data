[{"type": "subtitle", "time": 1800.51, "timestamp": "00:30:00", "text": "Brana，你能想到的所有公司，對吧？百事可樂、可口可樂，你能想到的所有"}, {"type": "subtitle", "time": 1842.71, "timestamp": "00:30:42", "text": "廣告品牌都會來。孩子們會說：「看，媽媽，動漫人物在說話！」"}, {"type": "subtitle", "time": 1846.63, "timestamp": "00:30:46", "text": "但"}, {"type": "subtitle", "time": 1848.549, "timestamp": "00:30:48", "text": "他們現在對電視感興趣，而"}, {"type": "subtitle", "time": 1851.389, "timestamp": "00:30:51", "text": "不是對真人表演感興趣"}]
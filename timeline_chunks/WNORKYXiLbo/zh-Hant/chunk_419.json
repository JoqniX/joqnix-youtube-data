[{"type": "subtitle", "time": 25156.708, "timestamp": "06:59:16", "text": "對手。嗯，我之前一直以為所有角色實力超強的動漫都是好動漫，現在看來真是"}, {"type": "subtitle", "time": 25170.868, "timestamp": "06:59:30", "text": "大錯特錯了。  嗯。  所以，是的，這些是其中一些作品，但之後我就想，不，"}, {"type": "subtitle", "time": 25175.51, "timestamp": "06:59:35", "text": "我不想再做了。"}, {"type": "subtitle", "time": 25178.948, "timestamp": "06:59:38", "text": "你好。我暫時停止看動漫了。好的。呃，Jo，你能來我的直播間"}, {"type": "subtitle", "time": 25186.39, "timestamp": "06:59:46", "text": "看看我的草圖嗎？哇，看起來真棒！哦，你猜對了。是的。  猜猜是誰？  所以，那就是那個討厭的"}]
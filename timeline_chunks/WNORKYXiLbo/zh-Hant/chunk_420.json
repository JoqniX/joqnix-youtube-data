[{"type": "subtitle", "time": 25233.19, "timestamp": "07:00:33", "text": "我是"}, {"type": "subtitle", "time": 25237.11, "timestamp": "07:00:37", "text": "一個叢林人。我是打野愛好者，所以我熱愛打野。  我還"}, {"type": "subtitle", "time": 25239.468, "timestamp": "07:00:39", "text": "沒有Yoia，但如果有一天我能擁有她，我會非常非常喜歡她。  是的，我有Yia，"}, {"type": "subtitle", "time": 25252.628, "timestamp": "07:00:52", "text": "但如果我有Aayaka就太棒了，因為我腦海裡有很多火焰系角色。我本來挺想要Yia的，但現在她就像"}, {"type": "subtitle", "time": 25255.27, "timestamp": "07:00:55", "text": "她的嘴唇一樣。所以"}]
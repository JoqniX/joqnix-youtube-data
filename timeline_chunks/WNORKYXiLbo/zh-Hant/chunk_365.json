[{"type": "subtitle", "time": 21911.03, "timestamp": "06:05:11", "text": "我睡不好覺。我大概凌晨兩點左右醒了。  嗯。  下午2點今天就到了。我沒有早起，而是反覆地睡著了，那些東西一直伴隨著我。"}, {"type": "subtitle", "time": 21914.788, "timestamp": "06:05:14", "text": "嗯。"}, {"type": "subtitle", "time": 21934.07, "timestamp": "06:05:34", "text": "兄弟，你別休息。"}]
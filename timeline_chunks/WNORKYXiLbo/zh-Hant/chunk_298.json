[{"type": "subtitle", "time": 17882.868, "timestamp": "04:58:02", "text": "。是的，我"}, {"type": "subtitle", "time": 17890.11, "timestamp": "04:58:10", "text": "這裡有縟瑪瑙，對吧？"}, {"type": "subtitle", "time": 17897.15, "timestamp": "04:58:17", "text": "我待處理的五個四字、三個字的劇本，我想賦予它們生命。在"}, {"type": "subtitle", "time": 17907.39, "timestamp": "04:58:27", "text": "官方公佈的三個角色中，"}, {"type": "subtitle", "time": 17911.19, "timestamp": "04:58:31", "text": "我接下來要公佈的是 Jockn。我已經創作了36個角色。它們都有一個獨一無二的名字。"}, {"type": "subtitle", "time": 17938.27, "timestamp": "04:58:58", "text": "到了這個地步，"}]
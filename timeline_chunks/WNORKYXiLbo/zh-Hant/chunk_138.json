[{"type": "subtitle", "time": 8304.07, "timestamp": "02:18:24", "text": "我的天哪。哦，他們公開了。  哦，他們公開上市了。並非僅限受邀者參加。它適用於一切。如果"}, {"type": "subtitle", "time": 8307.309, "timestamp": "02:18:27", "text": "現在對每個人都適用。  哦"}, {"type": "subtitle", "time": 8310.79, "timestamp": "02:18:30", "text": "，原來如此。呃，自發布以來終於"}, {"type": "subtitle", "time": 8314.309, "timestamp": "02:18:34", "text": "舉辦了派對活動。  [音樂]"}, {"type": "subtitle", "time": 8318.309, "timestamp": "02:18:38", "text": "嗯，我們聊聊。好的"}, {"type": "subtitle", "time": 8320.07, "timestamp": "02:18:40", "text": "，我看看能不能"}, {"type": "subtitle", "time": 8321.91, "timestamp": "02:18:41", "text": "打個[音樂]電話。登出登入。聊天。開始聊天。  運動頸 [音樂] 08 只有兩個人在那裡。  沒有兩位用戶"}, {"type": "subtitle", "time": 8324.429, "timestamp": "02:18:44", "text": "在線上"}, {"type": "subtitle", "time": 8328.629, "timestamp": "02:18:48", "text": "。哦"}, {"type": "subtitle", "time": 8333.549, "timestamp": "02:18:53", "text": "，是啊，現在用網路聊天的人也不多。"}, {"type": "subtitle", "time": 8338.389, "timestamp": "02:18:58", "text": "喔等等，網路上有九次使用機會。"}]
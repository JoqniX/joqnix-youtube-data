[{"type": "subtitle", "time": 8590.79, "timestamp": "02:23:10", "text": "芒果。我很"}, {"type": "subtitle", "time": 8599.03, "timestamp": "02:23:19", "text": "高興他們已經為"}, {"type": "subtitle", "time": 8604.79, "timestamp": "02:23:24", "text": "我預先選好了《零：從零開始的異世界生活 東京篇》"}, {"type": "subtitle", "time": 8606.309, "timestamp": "02:23:26", "text": "和《柔術回戰》。"}, {"type": "subtitle", "time": 8612.309, "timestamp": "02:23:32", "text": "哇。  閃光人粘液是一種指南。我稍微看過一點黑人音樂的翻唱，但不太了解。所以我不知道我是否應該接受它。  藝術、角色設計、底層世界建構、我們的藝術。我也很喜歡二維藝術。兄弟，你最喜歡的油管部落客"}]
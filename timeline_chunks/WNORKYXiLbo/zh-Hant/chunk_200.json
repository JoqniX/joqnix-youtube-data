[{"type": "subtitle", "time": 12007.469, "timestamp": "03:20:07", "text": "現在看起來……"}, {"type": "subtitle", "time": 12021.91, "timestamp": "03:20:21", "text": "上帝啊，有時候它也會讓我感到害怕，就像哦，他們就像我在跟"}, {"type": "subtitle", "time": 12041.55, "timestamp": "03:20:41", "text": "聊天，你知道的，因為就我而言，我不知道，呃，有點奇怪，我不知道該怎麼說。"}, {"type": "subtitle", "time": 12046.15, "timestamp": "03:20:46", "text": "V，也要去日本，兄弟。"}, {"type": "subtitle", "time": 12047.95, "timestamp": "03:20:47", "text": "天哪，"}]
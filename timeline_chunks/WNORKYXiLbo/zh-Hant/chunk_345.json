[{"type": "subtitle", "time": 20703.27, "timestamp": "05:45:03", "text": "這輩子畫過的最……正常的眼睛了。"}, {"type": "subtitle", "time": 20717.35, "timestamp": "05:45:17", "text": "嗯。  咱們來畫臉吧。  做這些。"}, {"type": "subtitle", "time": 20719.91, "timestamp": "05:45:19", "text": "我可以這樣做嗎？簡單點好嗎？還是詳細點好？我完全沒有頭緒"}, {"type": "subtitle", "time": 20729.788, "timestamp": "05:45:29", "text": "。是的。你好，拉莫薩。歡迎。"}, {"type": "subtitle", "time": 20734.83, "timestamp": "05:45:34", "text": "歡迎。你好嗎？  因為他看起來有點側臉，"}]
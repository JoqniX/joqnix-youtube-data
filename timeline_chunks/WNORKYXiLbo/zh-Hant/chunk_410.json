[{"type": "subtitle", "time": 24607.91, "timestamp": "06:50:07", "text": "我可沒說我天天看動漫似的，老兄。  所以BL是什麼，嗯……它就像……該怎麼稱呼它呢？"}, {"type": "subtitle", "time": 24617.43, "timestamp": "06:50:17", "text": "嗯，可以說是男生"}, {"type": "subtitle", "time": 24638.07, "timestamp": "06:50:38", "text": "喜歡的那種"}, {"type": "subtitle", "time": 24645.15, "timestamp": "06:50:45", "text": "呃，其中一個好像對"}, {"type": "subtitle", "time": 24659.11, "timestamp": "06:50:59", "text": "彼此產生了某種感覺之"}]
[{"type": "subtitle", "time": 18306.708, "timestamp": "05:05:06", "text": "でも、もし"}, {"type": "subtitle", "time": 18309.59, "timestamp": "05:05:09", "text": "私を見て、そのコラボレーションから、今では"}, {"type": "subtitle", "time": 18311.75, "timestamp": "05:05:11", "text": "あなたもサポートしていただけると嬉しいです"}, {"type": "subtitle", "time": 18314.55, "timestamp": "05:05:14", "text": "彼女の配信を見たり、"}, {"type": "subtitle", "time": 18317.75, "timestamp": "05:05:17", "text": "彼女のチャットに入って、"}, {"type": "subtitle", "time": 18319.868, "timestamp": "05:05:19", "text": "挨拶でも何でもいいから。彼女は読むことができる"}, {"type": "subtitle", "time": 18324.23, "timestamp": "05:05:24", "text": "英語。彼女は英語を勉強している。"}, {"type": "subtitle", "time": 18325.75, "timestamp": "05:05:25", "text": "だから私たちは繋がることができたのです"}, {"type": "subtitle", "time": 18328.39, "timestamp": "05:05:28", "text": "彼女は今英語を勉強しているから、私は"}, {"type": "subtitle", "time": 18330.15, "timestamp": "05:05:30", "text": "繋がることができて、彼女が知っていることを知ることができました"}, {"type": "subtitle", "time": 18332.628, "timestamp": "05:05:32", "text": "スキップとかその他諸々について。すべての"}, {"type": "subtitle", "time": 18336.55, "timestamp": "05:05:36", "text": "ミーム。彼女はミーム好きです。"}, {"type": "chat", "time": 18339.139, "timestamp": "05:05:39", "author": "@Anti-SpiritArt", "avatar": "https://yt4.ggpht.com/wYaIbwf481rN5bfgaxWnbUoh-faRynKzhqgZXK5WIvlx9DlMJJl0M6boNmqYwDkmuSY99pM-=s64-c-k-c0x00ffffff-no-rj", "message": "ohh okay have to do two raids then 👍"}, {"type": "subtitle", "time": 18339.51, "timestamp": "05:05:39", "text": "私は正反対ですが、私はそうではありません"}, {"type": "subtitle", "time": 18343.67, "timestamp": "05:05:43", "text": "ミームを理解する、彼は痛みを感じる。私は行く、私は入る"}, {"type": "subtitle", "time": 18346.15, "timestamp": "05:05:46", "text": "なぜ面白いのか、その深みとは？なぜ"}, {"type": "subtitle", "time": 18349.75, "timestamp": "05:05:49", "text": "笑い飛ばすのではなく、こうやって受け止める？"}, {"type": "subtitle", "time": 18351.83, "timestamp": "05:05:51", "text": "彼らはその後、2回の襲撃を行う。いいえ、大丈夫です。"}, {"type": "subtitle", "time": 18353.91, "timestamp": "05:05:53", "text": "えーと、私たちは"}, {"type": "subtitle", "time": 18356.948, "timestamp": "05:05:56", "text": "複数ウォッチのリンクですよね？だからあなたは"}]
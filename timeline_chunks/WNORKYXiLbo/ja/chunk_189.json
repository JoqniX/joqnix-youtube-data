[{"type": "subtitle", "time": 11341.87, "timestamp": "03:09:01", "text": "くそ。誕生日のお祝い。ヴァトン。"}, {"type": "subtitle", "time": 11344.269, "timestamp": "03:09:04", "text": "おお。"}, {"type": "subtitle", "time": 11357.429, "timestamp": "03:09:17", "text": "アトン。私は実際に変更する必要があります"}, {"type": "subtitle", "time": 11360.75, "timestamp": "03:09:20", "text": "背景とか何か。しかし、"}, {"type": "subtitle", "time": 11369.19, "timestamp": "03:09:29", "text": "ええ、そうですね。緑色に塗る"}, {"type": "subtitle", "time": 11370.91, "timestamp": "03:09:30", "text": "ビリーのせいで"}, {"type": "subtitle", "time": 11374.71, "timestamp": "03:09:34", "text": "これが必要だと分かっている。では、待ってください。あなたはできる"}, {"type": "subtitle", "time": 11377.91, "timestamp": "03:09:37", "text": "これを見るために。待って、ちょっと待って。私は思った"}, {"type": "subtitle", "time": 11379.71, "timestamp": "03:09:39", "text": "押した"}, {"type": "subtitle", "time": 11382.07, "timestamp": "03:09:42", "text": "設定。ああ、そうそう。今あなた"}, {"type": "subtitle", "time": 11384.87, "timestamp": "03:09:44", "text": "できません。"}, {"type": "subtitle", "time": 11385.67, "timestamp": "03:09:45", "text": "おお、"}]
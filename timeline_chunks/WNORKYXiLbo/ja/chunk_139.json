[{"type": "subtitle", "time": 8344.95, "timestamp": "02:19:04", "text": "私は様々な場面に合わせて様々な服を用意しています"}, {"type": "subtitle", "time": 8346.309, "timestamp": "02:19:06", "text": "書類とかそういうもの。それは"}, {"type": "subtitle", "time": 8348.459, "timestamp": "02:19:08", "text": "私が取りたい形。"}, {"type": "subtitle", "time": 8350.629, "timestamp": "02:19:10", "text": "[音楽]"}, {"type": "subtitle", "time": 8353.83, "timestamp": "02:19:13", "text": "かっこいい。だから、私は"}, {"type": "subtitle", "time": 8356.15, "timestamp": "02:19:16", "text": "出発前に、手短に1つだけ。おお、"}, {"type": "subtitle", "time": 8359.11, "timestamp": "02:19:19", "text": "動いている。おお、いいね。ニース。ああ、それは"}, {"type": "subtitle", "time": 8361.589, "timestamp": "02:19:21", "text": "すごくかっこいい。スタイリッシュでもある。"}, {"type": "subtitle", "time": 8365.27, "timestamp": "02:19:25", "text": "ああ、本当にありがとうございます。"}, {"type": "subtitle", "time": 8372.589, "timestamp": "02:19:32", "text": "の上"}, {"type": "subtitle", "time": 8375.07, "timestamp": "02:19:35", "text": "に"}, {"type": "subtitle", "time": 8398.59, "timestamp": "02:19:58", "text": "より多くの人が来て"}]
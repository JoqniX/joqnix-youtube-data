[{"type": "subtitle", "time": 1929.11, "timestamp": "00:32:09", "text": "それで、でも私はこのインド人のことが心配です"}, {"type": "subtitle", "time": 1930.75, "timestamp": "00:32:10", "text": "YouTuber関連のもの"}, {"type": "subtitle", "time": 1932.269, "timestamp": "00:32:12", "text": "時々"}, {"type": "subtitle", "time": 1935.63, "timestamp": "00:32:15", "text": "そうならないことを願う"}, {"type": "subtitle", "time": 1939.029, "timestamp": "00:32:19", "text": "行く。偽造IDに繋がらないことを願います"}, {"type": "subtitle", "time": 1943.19, "timestamp": "00:32:23", "text": "動画などのストリーミング配信。今は"}, {"type": "subtitle", "time": 1945.269, "timestamp": "00:32:25", "text": "昔はただの嘘だった"}, {"type": "subtitle", "time": 1949.75, "timestamp": "00:32:29", "text": "ID、えーと、いくつかのチャンネル。忘れた"}, {"type": "subtitle", "time": 1952.23, "timestamp": "00:32:32", "text": "名前を思い出すと、しばらくぶりだからね。しかし今は"}, {"type": "subtitle", "time": 1955.909, "timestamp": "00:32:35", "text": "私が好きなのは、小さめの、過小評価されているものです"}, {"type": "subtitle", "time": 1960.35, "timestamp": "00:32:40", "text": "YouTuberたちはニュースタイプの"}, {"type": "subtitle", "time": 1964.43, "timestamp": "00:32:44", "text": "コンテンツ。えっと、私はこう思う"}, {"type": "subtitle", "time": 1973.35, "timestamp": "00:32:53", "text": "おお。でも、すべてがうまくいくことを願っています"}, {"type": "subtitle", "time": 1974.269, "timestamp": "00:32:54", "text": "行く"}, {"type": "subtitle", "time": 1976.59, "timestamp": "00:32:56", "text": "良い。しかし"}, {"type": "subtitle", "time": 1979.269, "timestamp": "00:32:59", "text": "繰り返しますが、あまり深く考えるべきではありません"}]
[{"type": "subtitle", "time": 14343.269, "timestamp": "03:59:03", "text": "全員です。白金。"}, {"type": "subtitle", "time": 14351.91, "timestamp": "03:59:11", "text": "さよなら。カードを追加できないのですか？ちょっと待って。"}, {"type": "subtitle", "time": 14354.59, "timestamp": "03:59:14", "text": "プロフィールをいくつか購入します"}, {"type": "subtitle", "time": 14373.309, "timestamp": "03:59:33", "text": "えっと、ちょっと待ってください。買いたい"}, {"type": "subtitle", "time": 14375.469, "timestamp": "03:59:35", "text": "このゼロ"}, {"type": "subtitle", "time": 14387.269, "timestamp": "03:59:47", "text": "ダウンロードショップ。わかった。リバーサイドサクラ"}, {"type": "subtitle", "time": 14389.429, "timestamp": "03:59:49", "text": "テーマ。ダウンロード中です。送ることができます"}, {"type": "subtitle", "time": 14392.71, "timestamp": "03:59:52", "text": "ミツキさんへ。"}, {"type": "subtitle", "time": 14395.229, "timestamp": "03:59:55", "text": "私について言えることは、今私は知っているということです"}, {"type": "subtitle", "time": 14398.429, "timestamp": "03:59:58", "text": "それは愚かだ"}]
[{"type": "subtitle", "time": 3900.789, "timestamp": "01:05:00", "text": "それを依頼するのに十分なお金"}, {"type": "subtitle", "time": 3903.67, "timestamp": "01:05:03", "text": "壁紙のやつ、そうすればこうできる"}, {"type": "subtitle", "time": 3906.069, "timestamp": "01:05:06", "text": "えーっと、壁紙の件をやったとしましょう"}, {"type": "subtitle", "time": 3909.67, "timestamp": "01:05:09", "text": "1月から、それから次の"}, {"type": "subtitle", "time": 3912.15, "timestamp": "01:05:12", "text": "6ヶ月くらいかな、"}, {"type": "subtitle", "time": 3914.789, "timestamp": "01:05:14", "text": "それらを期間限定で再利用する"}, {"type": "subtitle", "time": 3915.87, "timestamp": "01:05:15", "text": "提供するか、"}, {"type": "subtitle", "time": 3919.67, "timestamp": "01:05:19", "text": "何かとかそういうの、"}, {"type": "subtitle", "time": 3921.99, "timestamp": "01:05:21", "text": "無料で欲しいとか何とか。それ"}, {"type": "subtitle", "time": 3925.19, "timestamp": "01:05:25", "text": "また、カスタムの場合のみ適用されます"}, {"type": "subtitle", "time": 3928.309, "timestamp": "01:05:28", "text": "自分のウェブサイトに載せたいと思っていたもの。"}, {"type": "subtitle", "time": 3930.43, "timestamp": "01:05:30", "text": "その普遍的なアカウント"}, {"type": "subtitle", "time": 3933.309, "timestamp": "01:05:33", "text": "他のすべての国の人々が集まる場所"}, {"type": "subtitle", "time": 3936.15, "timestamp": "01:05:36", "text": "プラットフォームは、"}, {"type": "subtitle", "time": 3938.349, "timestamp": "01:05:38", "text": "自分のアカウントを持ち、引き続きアクセスできるようにする"}, {"type": "subtitle", "time": 3941.47, "timestamp": "01:05:41", "text": "すべて。彼らはYouTubeをリンクできます、"}, {"type": "subtitle", "time": 3944.789, "timestamp": "01:05:44", "text": "Twitchアカウントとか。ええ、私も"}, {"type": "subtitle", "time": 3946.589, "timestamp": "01:05:46", "text": "いつかそれをやってみたい。"}, {"type": "subtitle", "time": 3950.71, "timestamp": "01:05:50", "text": "男。は次のようなものに適しています"}, {"type": "subtitle", "time": 3958.829, "timestamp": "01:05:58", "text": "でもそれは良いけど現金が欲しい"}]
[{"type": "subtitle", "time": 6545.35, "timestamp": "01:49:05", "text": "原神、マインクラフト、香港、行くよ"}, {"type": "subtitle", "time": 6547.49, "timestamp": "01:49:07", "text": "に"}, {"type": "subtitle", "time": 6554.51, "timestamp": "01:49:14", "text": "縮小したアニメ・マンガ。さあ"}, {"type": "subtitle", "time": 6557.83, "timestamp": "01:49:17", "text": "マンゴーがいくつあるか見てみましょう。私は、"}, {"type": "subtitle", "time": 6560.149, "timestamp": "01:49:20", "text": "彼らはすでにゼロを事前に選択していた"}, {"type": "subtitle", "time": 6563.75, "timestamp": "01:49:23", "text": "私にとってはリゼロ東京と柔術廻戦。"}, {"type": "subtitle", "time": 6571.07, "timestamp": "01:49:31", "text": "ティンセルマンスライムは"}, {"type": "subtitle", "time": 6582.99, "timestamp": "01:49:42", "text": "[音楽]"}, {"type": "subtitle", "time": 6585.629, "timestamp": "01:49:45", "text": "表紙を少し見た"}, {"type": "subtitle", "time": 6588.39, "timestamp": "01:49:48", "text": "少しは知っているけど、それについてはあまり詳しくない。だから私は"}, {"type": "subtitle", "time": 6591.189, "timestamp": "01:49:51", "text": "欲しい。受け取るべきかどうかわからない。"}, {"type": "subtitle", "time": 6594.43, "timestamp": "01:49:54", "text": "アート、キャラクターデザイン、下界"}, {"type": "subtitle", "time": 6597.31, "timestamp": "01:49:57", "text": "建物、私たちは"}]
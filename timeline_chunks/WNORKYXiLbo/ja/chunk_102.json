[{"type": "subtitle", "time": 6127.99, "timestamp": "01:42:07", "text": "ああ、彼らは株式を公開したんだ。招待ではありません"}, {"type": "subtitle", "time": 6129.31, "timestamp": "01:42:09", "text": "のみ。これは"}, {"type": "subtitle", "time": 6131.91, "timestamp": "01:42:11", "text": "すべて。もしそれが今、すべての人にとってのことであるならば。"}, {"type": "subtitle", "time": 6140.31, "timestamp": "01:42:20", "text": "なぜ。えーと、発売以来ずっとパーティー"}, {"type": "subtitle", "time": 6160.99, "timestamp": "01:42:40", "text": "チャット。よし、私が作れるかどうか見てみよう"}]
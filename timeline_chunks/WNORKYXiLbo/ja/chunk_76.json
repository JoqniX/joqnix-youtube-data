[{"type": "subtitle", "time": 4564.47, "timestamp": "01:16:04", "text": "私たち自身？待って、実際にはこれは"}, {"type": "subtitle", "time": 4566.87, "timestamp": "01:16:06", "text": "景色も同様です。ここに動画があります"}, {"type": "subtitle", "time": 4570.229, "timestamp": "01:16:10", "text": "そして購読者も同様です。それは最後の行動ですか？"}, {"type": "subtitle", "time": 4572.87, "timestamp": "01:16:12", "text": "ああ、誰かが手動でアップデートするように頼んだ"}, {"type": "subtitle", "time": 4576.51, "timestamp": "01:16:16", "text": "これ。ああ、でも自動化する方法はないの？"}, {"type": "subtitle", "time": 4579.99, "timestamp": "01:16:19", "text": "これ？右。不可能ですか"}, {"type": "subtitle", "time": 4582.709, "timestamp": "01:16:22", "text": "自動化する？ Twitterもありますよ。"}, {"type": "subtitle", "time": 4590.95, "timestamp": "01:16:30", "text": "フォロワー。これはこれは何か"}, {"type": "subtitle", "time": 4595.87, "timestamp": "01:16:35", "text": "これはオールインワンのようなものです"}, {"type": "subtitle", "time": 4599.59, "timestamp": "01:16:39", "text": "分析とコミュニティの両方をパッケージ化"}, {"type": "subtitle", "time": 4603.39, "timestamp": "01:16:43", "text": "コミュニティにとってもこれはすごい"}, {"type": "subtitle", "time": 4613.63, "timestamp": "01:16:53", "text": "これは実際良いですね。待って、"}, {"type": "subtitle", "time": 4616.189, "timestamp": "01:16:56", "text": "何？これは実際には"}, {"type": "subtitle", "time": 4619.07, "timestamp": "01:16:59", "text": "良い。彼らはTwitchを"}]
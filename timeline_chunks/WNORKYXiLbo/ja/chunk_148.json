[{"type": "subtitle", "time": 8881.03, "timestamp": "02:28:01", "text": "気軽に参加して私と話してください。"}, {"type": "subtitle", "time": 8884.389, "timestamp": "02:28:04", "text": "私がライブ配信している時は常に。こちらは現在公開されているビデオ会議です。"}, {"type": "subtitle", "time": 8888.83, "timestamp": "02:28:08", "text": "そうですね、いつでも参加できます"}, {"type": "subtitle", "time": 8892.23, "timestamp": "02:28:12", "text": "了解。すべて順調です。私は感謝しています"}, {"type": "subtitle", "time": 8893.75, "timestamp": "02:28:13", "text": "本当に感謝しています。どうもありがとうございました"}, {"type": "subtitle", "time": 8895.99, "timestamp": "02:28:15", "text": "多くの。むしろ、皆さんのことはお見通しです"}, {"type": "subtitle", "time": 8899.349, "timestamp": "02:28:19", "text": "オンラインだけど、私はとても"}, {"type": "subtitle", "time": 8901.349, "timestamp": "02:28:21", "text": "気まずくて恥ずかしい。つまり、"}, {"type": "subtitle", "time": 8903.91, "timestamp": "02:28:23", "text": "あなたは私が静かにしているか、"}, {"type": "subtitle", "time": 8912.87, "timestamp": "02:28:32", "text": "どうもありがとう。"}, {"type": "subtitle", "time": 8915.83, "timestamp": "02:28:35", "text": "じゃあ、ええと、ミュートして"}, {"type": "subtitle", "time": 8917.91, "timestamp": "02:28:37", "text": "今のところは違う。あ、待って。私は"}, {"type": "subtitle", "time": 8919.91, "timestamp": "02:28:39", "text": "とりあえずVCを離れます。"}, {"type": "subtitle", "time": 8923.23, "timestamp": "02:28:43", "text": "私がコミュニティを運営しているときに参加してください"}, {"type": "subtitle", "time": 8926.389, "timestamp": "02:28:46", "text": "NVA。そうします。改めて感謝申し上げます"}, {"type": "subtitle", "time": 8930.309, "timestamp": "02:28:50", "text": "参加してくれること。それはとても大きな意味があります。うん。感謝"}, {"type": "subtitle", "time": 8932.71, "timestamp": "02:28:52", "text": "また君か。ええ、私はVCには参加しません"}, {"type": "subtitle", "time": 8934.07, "timestamp": "02:28:54", "text": "たくさんあります。なぜなら、私はここを去るからです。私"}, {"type": "subtitle", "time": 8936.79, "timestamp": "02:28:56", "text": "あなたに挨拶したかったんです。とにかく、ありがとう。"}]
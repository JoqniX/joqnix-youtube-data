[{"type": "subtitle", "time": 15901.67, "timestamp": "04:25:01", "text": "M、それは私が"}, {"type": "subtitle", "time": 15903.71, "timestamp": "04:25:03", "text": "気づいたのは"}, {"type": "subtitle", "time": 15906.469, "timestamp": "04:25:06", "text": "インド人がたくさんいるから"}, {"type": "subtitle", "time": 15910.63, "timestamp": "04:25:10", "text": "YouTuberにとってタイミングは重要ですよね"}, {"type": "subtitle", "time": 15916.189, "timestamp": "04:25:16", "text": "例えば5人から10人のYouTuberがライブ配信をする"}, {"type": "subtitle", "time": 15920.95, "timestamp": "04:25:20", "text": "そうそう、もしそれがグループだったらどうなるか想像してみて"}, {"type": "subtitle", "time": 15923.189, "timestamp": "04:25:23", "text": "イベントコラボのようなコラボレーションとみんな"}, {"type": "subtitle", "time": 15924.03, "timestamp": "04:25:24", "text": "は"}, {"type": "subtitle", "time": 15926.79, "timestamp": "04:25:26", "text": "生で生きるなら、君は今まさにこのプレッシャーにさらされているんだ。"}, {"type": "subtitle", "time": 15930.349, "timestamp": "04:25:30", "text": "ああ神様、誰を見て、"}, {"type": "subtitle", "time": 15933.429, "timestamp": "04:25:33", "text": "実際にチャットに入力して、"}, {"type": "subtitle", "time": 15936.389, "timestamp": "04:25:36", "text": "チャットなど。私は全部見るのが大好きだから"}, {"type": "subtitle", "time": 15939.389, "timestamp": "04:25:39", "text": "ええと、そういうもの全部"}, {"type": "subtitle", "time": 15941.55, "timestamp": "04:25:41", "text": "今"}, {"type": "subtitle", "time": 15944.63, "timestamp": "04:25:44", "text": "起こる。だから私は衝突しないようにする"}, {"type": "subtitle", "time": 15948.07, "timestamp": "04:25:48", "text": "他の人の配信。私の配信時間"}, {"type": "subtitle", "time": 15949.71, "timestamp": "04:25:49", "text": "いつも"}, {"type": "subtitle", "time": 15954.149, "timestamp": "04:25:54", "text": "朝であって、夜ではない。"}, {"type": "subtitle", "time": 15954.99, "timestamp": "04:25:54", "text": "しかし"}]
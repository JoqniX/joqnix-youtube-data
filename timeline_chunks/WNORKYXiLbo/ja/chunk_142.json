[{"type": "subtitle", "time": 8522.07, "timestamp": "02:22:02", "text": "Discordの管理者の1人で、"}, {"type": "subtitle", "time": 8525.03, "timestamp": "02:22:05", "text": "タイマーについて話しています。タイマー"}, {"type": "subtitle", "time": 8526.87, "timestamp": "02:22:06", "text": "両方の人または片方の人に表示されることがあります"}, {"type": "subtitle", "time": 8529.03, "timestamp": "02:22:09", "text": "スピードチャットをオンにしている人が"}, {"type": "subtitle", "time": 8531.83, "timestamp": "02:22:11", "text": "タイムが短い方が勝ちとなる。"}, {"type": "subtitle", "time": 8533.91, "timestamp": "02:22:13", "text": "ええ、でも私はつけていません、"}, {"type": "subtitle", "time": 8537.19, "timestamp": "02:22:17", "text": "だからタイマーは必要ないはずだ。"}, {"type": "subtitle", "time": 8541.27, "timestamp": "02:22:21", "text": "ああ、えっと、Mさんだったかな、名前を忘れちゃったけど、"}, {"type": "subtitle", "time": 8544.63, "timestamp": "02:22:24", "text": "でもそれはピンクのようなアバターだったのか"}, {"type": "subtitle", "time": 8549.51, "timestamp": "02:22:29", "text": "色？うん。そうそう。うん。うん。私はそうしました"}, {"type": "subtitle", "time": 8552.63, "timestamp": "02:22:32", "text": "彼らとも話してみてください。"}, {"type": "subtitle", "time": 8555.349, "timestamp": "02:22:35", "text": "うん、いい人たちだよ。ええ、そうでした。"}, {"type": "subtitle", "time": 8558.07, "timestamp": "02:22:38", "text": "15分から30分あることを言及してください"}, {"type": "subtitle", "time": 8559.99, "timestamp": "02:22:39", "text": "目に見えないタイマーが"}, {"type": "subtitle", "time": 8562.15, "timestamp": "02:22:42", "text": "実行された場合は自動的にトリガーされます"}, {"type": "subtitle", "time": 8564.71, "timestamp": "02:22:44", "text": "長すぎた。"}, {"type": "subtitle", "time": 8568.55, "timestamp": "02:22:48", "text": "それは考えてみる価値があるかもしれないね。"}, {"type": "subtitle", "time": 8570.15, "timestamp": "02:22:50", "text": "面白いね、まるで30歳みたいだ"}, {"type": "subtitle", "time": 8571.83, "timestamp": "02:22:51", "text": "数分後には、ああ、そうだ、"}, {"type": "subtitle", "time": 8573.19, "timestamp": "02:22:53", "text": "物事は順調に進んでいる。あなたは"}, {"type": "subtitle", "time": 8574.63, "timestamp": "02:22:54", "text": "ああ、タイマーがない。持っていません"}]
[{"type": "subtitle", "time": 12252.55, "timestamp": "03:24:12", "text": "これと関係があるんです。ジョーン・デイト"}, {"type": "subtitle", "time": 12271.83, "timestamp": "03:24:31", "text": "いや、もっと欲しいんだ"}, {"type": "subtitle", "time": 12283.429, "timestamp": "03:24:43", "text": "すぐ。私の一部は後悔している"}, {"type": "subtitle", "time": 12285.83, "timestamp": "03:24:45", "text": "たくさんのこと。これを計画しておくべきだった"}, {"type": "subtitle", "time": 12288.63, "timestamp": "03:24:48", "text": "時間通りに。なぜ私は準備万端だと確信しているのか"}, {"type": "subtitle", "time": 12291.19, "timestamp": "03:24:51", "text": "私のジョーカーグッズ？"}, {"type": "subtitle", "time": 12294.79, "timestamp": "03:24:54", "text": "つまり、私は今プロになったのだが"}, {"type": "subtitle", "time": 12297.19, "timestamp": "03:24:57", "text": "自分自身に目標を約束する、そう、私は"}, {"type": "subtitle", "time": 12299.11, "timestamp": "03:24:59", "text": "全てのYouTuberとコラボする予定です"}]
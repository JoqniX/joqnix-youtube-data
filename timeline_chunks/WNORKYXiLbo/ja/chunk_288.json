[{"type": "subtitle", "time": 17283.35, "timestamp": "04:48:03", "text": "だから、祖母は今そこにいるんだ。だから"}, {"type": "subtitle", "time": 17286.31, "timestamp": "04:48:06", "text": "えっと、だから、お父さんは"}, {"type": "subtitle", "time": 17289.27, "timestamp": "04:48:09", "text": "外に出て家族全員の面倒を見てください"}, {"type": "subtitle", "time": 17291.67, "timestamp": "04:48:11", "text": "そういうことですよね？だから彼はいつも"}, {"type": "subtitle", "time": 17295.51, "timestamp": "04:48:15", "text": "母の世話をするためにそこに行った。えっと、"}, {"type": "subtitle", "time": 17297.99, "timestamp": "04:48:17", "text": "そして祖母も。そうなるだろう"}, {"type": "subtitle", "time": 17302.948, "timestamp": "04:48:22", "text": "今は難しい。そして私はそうするつもりです、そして"}, {"type": "subtitle", "time": 17305.51, "timestamp": "04:48:25", "text": "叔母は家族と一緒にいたいと思っていたので"}, {"type": "subtitle", "time": 17309.19, "timestamp": "04:48:29", "text": "私たちは彼らに家を与えたんです、ほら"}, {"type": "subtitle", "time": 17311.99, "timestamp": "04:48:31", "text": "だから彼らは私たちと一緒に滞在しているし、"}, {"type": "subtitle", "time": 17315.59, "timestamp": "04:48:35", "text": "仕事やその他すべて"}, {"type": "subtitle", "time": 17319.23, "timestamp": "04:48:39", "text": "外に出て6時までに戻ってくるか"}, {"type": "subtitle", "time": 17323.51, "timestamp": "04:48:43", "text": "7 そして写真を撮ったり、その他すべて"}, {"type": "subtitle", "time": 17328.55, "timestamp": "04:48:48", "text": "すべて、そう、彼女はタミル人で、"}, {"type": "chat", "time": 17330.886, "timestamp": "04:48:50", "author": "@Anti-SpiritArt", "avatar": "https://yt4.ggpht.com/wYaIbwf481rN5bfgaxWnbUoh-faRynKzhqgZXK5WIvlx9DlMJJl0M6boNmqYwDkmuSY99pM-=s64-c-k-c0x00ffffff-no-rj", "message": "man it's light outside i should sleep 😅"}, {"type": "subtitle", "time": 17331.03, "timestamp": "04:48:51", "text": "彼女の家がどこにあるか忘れてしまった。忘れた"}, {"type": "subtitle", "time": 17334.59, "timestamp": "04:48:54", "text": "エリアのような場所"}, {"type": "subtitle", "time": 17338.948, "timestamp": "04:48:58", "text": "ドラド。ええ、でも、ほとんどのことは聞こえます"}]
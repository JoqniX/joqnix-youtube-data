[{"type": "subtitle", "time": 12422.389, "timestamp": "03:27:02", "text": "えーと質問とかするよ"}, {"type": "subtitle", "time": 12425.349, "timestamp": "03:27:05", "text": "良い。でも今はジョアソンをやっている"}, {"type": "subtitle", "time": 12429.91, "timestamp": "03:27:09", "text": "今。だから私は24時間、12時間ライブ配信している"}, {"type": "subtitle", "time": 12432.15, "timestamp": "03:27:12", "text": "パート1　パート2。だから、誰も知らないだろう。"}, {"type": "subtitle", "time": 12434.83, "timestamp": "03:27:14", "text": "だから私はそう思う、"}, {"type": "subtitle", "time": 12437.59, "timestamp": "03:27:17", "text": "今からこれを発表して"}, {"type": "subtitle", "time": 12439.99, "timestamp": "03:27:19", "text": "人々は特定の時間に参加できます"}, {"type": "subtitle", "time": 12442.469, "timestamp": "03:27:22", "text": "出来事が起こっているとき、"}, {"type": "subtitle", "time": 12445.11, "timestamp": "03:27:25", "text": "コラボレーションは、それらすべてで行われます"}, {"type": "subtitle", "time": 12448.229, "timestamp": "03:27:28", "text": "もの。いいえ、それは連続的な流れだからです"}, {"type": "subtitle", "time": 12449.469, "timestamp": "03:27:29", "text": "ストリーム。"}, {"type": "subtitle", "time": 12479.63, "timestamp": "03:27:59", "text": "マインクラフト"}]
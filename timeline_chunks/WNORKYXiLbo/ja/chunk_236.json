[{"type": "subtitle", "time": 14161.75, "timestamp": "03:56:01", "text": "明日からそうすることにします。わかった。"}, {"type": "subtitle", "time": 14164.07, "timestamp": "03:56:04", "text": "こんにちは。明日、サーバーの改修を行います。"}, {"type": "subtitle", "time": 14164.75, "timestamp": "03:56:04", "text": "として"}, {"type": "subtitle", "time": 14172.75, "timestamp": "03:56:12", "text": "もの。それで"}, {"type": "subtitle", "time": 14189.51, "timestamp": "03:56:29", "text": "とにかく最高だ。えっと、準備準備。 64日目"}, {"type": "subtitle", "time": 14208.03, "timestamp": "03:56:48", "text": "準備して仕事に取り掛かろう"}, {"type": "subtitle", "time": 14212.75, "timestamp": "03:56:52", "text": "崩壊したから終わった"}, {"type": "subtitle", "time": 14217.68, "timestamp": "03:56:57", "text": "今日。そして、これをスケジュールします"}, {"type": "subtitle", "time": 14218.99, "timestamp": "03:56:58", "text": "[音楽]"}]
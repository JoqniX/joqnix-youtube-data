[{"type": "subtitle", "time": 17221.31, "timestamp": "04:47:01", "text": "私がこれまでに明らかにしたことは"}, {"type": "chat", "time": 17224.203, "timestamp": "04:47:04", "author": "@Anti-SpiritArt", "avatar": "https://yt4.ggpht.com/wYaIbwf481rN5bfgaxWnbUoh-faRynKzhqgZXK5WIvlx9DlMJJl0M6boNmqYwDkmuSY99pM-=s64-c-k-c0x00ffffff-no-rj", "message": "Understandable"}, {"type": "subtitle", "time": 17224.628, "timestamp": "04:47:04", "text": "言語 なぜなら正直に言うと私は"}, {"type": "subtitle", "time": 17228.55, "timestamp": "04:47:08", "text": "使用するにはもっと順序が必要だったが"}, {"type": "subtitle", "time": 17231.75, "timestamp": "04:47:11", "text": "問題は、私はそれが下手だということです。私はまるで"}, {"type": "subtitle", "time": 17232.91, "timestamp": "04:47:12", "text": "1"}, {"type": "subtitle", "time": 17237.55, "timestamp": "04:47:17", "text": "外国人。ああ、そうだね"}, {"type": "subtitle", "time": 17242.15, "timestamp": "04:47:22", "text": "良い。ああ、タミル語、えっと、私の家族は知っています"}, {"type": "subtitle", "time": 17243.91, "timestamp": "04:47:23", "text": "そしてタンブルを話す、たぶん彼らは"}, {"type": "subtitle", "time": 17247.628, "timestamp": "04:47:27", "text": "映画鑑賞など"}, {"type": "subtitle", "time": 17253.75, "timestamp": "04:47:33", "text": "えーと、おばさん、えーと、手伝ってくれるおばさん"}, {"type": "subtitle", "time": 17256.07, "timestamp": "04:47:36", "text": "手助けをしてくれる人"}, {"type": "subtitle", "time": 17258.868, "timestamp": "04:47:38", "text": "上部構造の構築"}, {"type": "subtitle", "time": 17261.83, "timestamp": "04:47:41", "text": "1階の改修工事"}, {"type": "subtitle", "time": 17264.15, "timestamp": "04:47:44", "text": "部屋も何もかも。彼女は"}, {"type": "subtitle", "time": 17268.07, "timestamp": "04:47:48", "text": "私たち、彼女の家族、彼女の夫、そして彼女"}, {"type": "subtitle", "time": 17271.83, "timestamp": "04:47:51", "text": "私たちと一緒に滞在します。それで、それで、私たちは"}, {"type": "subtitle", "time": 17274.31, "timestamp": "04:47:54", "text": "この裏庭の物置小屋か何か"}, {"type": "subtitle", "time": 17278.03, "timestamp": "04:47:58", "text": "それは大きな部屋みたいなものだ。そうですね"}]
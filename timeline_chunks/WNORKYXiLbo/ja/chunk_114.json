[{"type": "subtitle", "time": 6843.03, "timestamp": "01:54:03", "text": "プロフィール画像を保存する"}, {"type": "subtitle", "time": 6850.75, "timestamp": "01:54:10", "text": "これ。カスタムのように設定することはできません"}, {"type": "subtitle", "time": 6855.36, "timestamp": "01:54:15", "text": "発音する"}, {"type": "subtitle", "time": 6856.589, "timestamp": "01:54:16", "text": "[音楽]"}, {"type": "subtitle", "time": 6859.83, "timestamp": "01:54:19", "text": "彼。慰めとして、私はどうですか？できますか"}, {"type": "subtitle", "time": 6862.27, "timestamp": "01:54:22", "text": "どれでも？そうですか"}, {"type": "subtitle", "time": 6864.709, "timestamp": "01:54:24", "text": "もう問題になっているのか？人々は"}, {"type": "subtitle", "time": 6867.47, "timestamp": "01:54:27", "text": "私の言葉を聞いて混乱する"}, {"type": "subtitle", "time": 6872.669, "timestamp": "01:54:32", "text": "声。それは痛みだ。 H."}, {"type": "subtitle", "time": 6877.24, "timestamp": "01:54:37", "text": "なぜこうなったのですか？"}]
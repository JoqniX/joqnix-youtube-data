[{"type": "subtitle", "time": 9910.91, "timestamp": "02:45:10", "text": "ああ、あなたの"}, {"type": "subtitle", "time": 9918.349, "timestamp": "02:45:18", "text": "ニース。子犬のオオカミの看板も"}, {"type": "subtitle", "time": 9923.19, "timestamp": "02:45:23", "text": "楽しい。天上の泡。"}, {"type": "subtitle", "time": 9925.59, "timestamp": "02:45:25", "text": "私は、あなたが気づいたかどうかわかりませんが、そうでした。私"}, {"type": "subtitle", "time": 9928.67, "timestamp": "02:45:28", "text": "話すのに苦労していた"}, {"type": "subtitle", "time": 9940.55, "timestamp": "02:45:40", "text": "話す。私は実際に話すのに苦労していた"}, {"type": "subtitle", "time": 9943.429, "timestamp": "02:45:43", "text": "えーっと、話す話題を考え出す"}, {"type": "subtitle", "time": 9945.469, "timestamp": "02:45:45", "text": "についてと"}, {"type": "chat", "time": 9946.304, "timestamp": "02:45:46", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "i wouldnt say you were struggling"}, {"type": "subtitle", "time": 9953.15, "timestamp": "02:45:53", "text": "うん、ベストを尽くせてよかった。その"}, {"type": "chat", "time": 9954.54, "timestamp": "02:45:54", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "you were just very reactive"}, {"type": "subtitle", "time": 9955.55, "timestamp": "02:45:55", "text": "良い。彼はそうではないと思う"}, {"type": "subtitle", "time": 9958.67, "timestamp": "02:45:58", "text": "もがく。私はしません"}, {"type": "chat", "time": 9959.809, "timestamp": "02:45:59", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "rather than proactive"}]
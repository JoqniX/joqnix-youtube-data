[{"type": "subtitle", "time": 14760.91, "timestamp": "04:06:00", "text": "それ"}, {"type": "subtitle", "time": 14763.469, "timestamp": "04:06:03", "text": "一つは"}, {"type": "subtitle", "time": 14766.63, "timestamp": "04:06:06", "text": "昔からコミュニティを作っていたように"}, {"type": "subtitle", "time": 14770.309, "timestamp": "04:06:10", "text": "モバイルでできるバージョン"}, {"type": "subtitle", "time": 14773.67, "timestamp": "04:06:13", "text": "私がプレイする特定のゲームでそれを使います。だからもし"}, {"type": "subtitle", "time": 14775.91, "timestamp": "04:06:15", "text": "その特定のゲームをプレイする人たちは"}, {"type": "subtitle", "time": 14778.95, "timestamp": "04:06:18", "text": "お互いにプレイしてレイドをしたり"}, {"type": "subtitle", "time": 14781.389, "timestamp": "04:06:21", "text": "グループ活動"}, {"type": "subtitle", "time": 14784.83, "timestamp": "04:06:24", "text": "一緒に。よし。私は普段そうする"}, {"type": "subtitle", "time": 14788.389, "timestamp": "04:06:28", "text": "それ。あまり人がいないように感じた"}, {"type": "subtitle", "time": 14790.55, "timestamp": "04:06:30", "text": "彼らはそこにいた。それをやめた"}, {"type": "subtitle", "time": 14793.429, "timestamp": "04:06:33", "text": "あれ。それをやめなさい。でも私はまだ"}, {"type": "subtitle", "time": 14796.75, "timestamp": "04:06:36", "text": "既存のもの、Apex"}]
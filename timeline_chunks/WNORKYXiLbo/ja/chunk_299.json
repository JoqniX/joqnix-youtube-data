[{"type": "subtitle", "time": 17941.67, "timestamp": "04:59:01", "text": "外。あ、待って、次は連絡しないといけない"}, {"type": "subtitle", "time": 17944.75, "timestamp": "04:59:04", "text": "彼女が都合が良いかどうか尋ねる"}, {"type": "subtitle", "time": 17948.868, "timestamp": "04:59:08", "text": "電話。ああ、ルナ。ああ、なんてたくさんの人だ。"}, {"type": "subtitle", "time": 17953.31, "timestamp": "04:59:13", "text": "俺はブロだ、みんなに連絡を取らなきゃいけない"}, {"type": "subtitle", "time": 17960.39, "timestamp": "04:59:20", "text": "ええと、入手可能かどうかは分かりません。"}, {"type": "subtitle", "time": 17962.23, "timestamp": "04:59:22", "text": "問題は、もし私がその質問をしたら"}, {"type": "subtitle", "time": 17964.55, "timestamp": "04:59:24", "text": "コラボレーションの形で連絡を取ると、"}, {"type": "subtitle", "time": 17966.47, "timestamp": "04:59:26", "text": "どんなアイデアをお持ちですか？あなたは何を"}, {"type": "subtitle", "time": 17969.59, "timestamp": "04:59:29", "text": "信じる？私たちは何をして、"}, {"type": "subtitle", "time": 17972.19, "timestamp": "04:59:32", "text": "現実？私はただ一緒に過ごしたいだけです"}, {"type": "subtitle", "time": 17975.83, "timestamp": "04:59:35", "text": "そういう類のもの。それはある程度可能です"}, {"type": "subtitle", "time": 17978.39, "timestamp": "04:59:38", "text": "ゲームに参加するか、ゲームに参加する必要はない。私たちは"}, {"type": "subtitle", "time": 17982.11, "timestamp": "04:59:42", "text": "ただ話したり、そういうことをするだけ。それもまた"}, {"type": "chat", "time": 17982.418, "timestamp": "04:59:42", "author": "@Anti-SpiritArt", "avatar": "https://yt4.ggpht.com/wYaIbwf481rN5bfgaxWnbUoh-faRynKzhqgZXK5WIvlx9DlMJJl0M6boNmqYwDkmuSY99pM-=s64-c-k-c0x00ffffff-no-rj", "message": "since you will be going to Japan why not try a Japanese v tuber?"}, {"type": "subtitle", "time": 17984.788, "timestamp": "04:59:44", "text": "大丈夫。うん。"}, {"type": "subtitle", "time": 17986.788, "timestamp": "04:59:46", "text": "私は様々なタイプのコンテンツを作らなければならない"}, {"type": "subtitle", "time": 17994.868, "timestamp": "04:59:54", "text": "今。試してみませんか？日本人がいます"}, {"type": "subtitle", "time": 17999.23, "timestamp": "04:59:59", "text": "土曜日の24日にYouTuberが"}]
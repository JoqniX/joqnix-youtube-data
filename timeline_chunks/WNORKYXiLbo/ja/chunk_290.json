[{"type": "subtitle", "time": 17400.07, "timestamp": "04:50:00", "text": "実際に最後まで付き合ってくれたみんな"}, {"type": "subtitle", "time": 17401.788, "timestamp": "04:50:01", "text": "そして、"}, {"type": "subtitle", "time": 17405.82, "timestamp": "04:50:05", "text": "自分。それは私を幸せにしてくれた。感謝"}, {"type": "subtitle", "time": 17407.55, "timestamp": "04:50:07", "text": "[音楽]"}, {"type": "subtitle", "time": 17411.67, "timestamp": "04:50:11", "text": "あなた。ありがとう。"}, {"type": "subtitle", "time": 17429.91, "timestamp": "04:50:29", "text": "良い。私はおそらくアスマン・ゴールドを見るだろう"}, {"type": "subtitle", "time": 17434.55, "timestamp": "04:50:34", "text": "あるいはYouTuberの動画とかで"}, {"type": "subtitle", "time": 17437.788, "timestamp": "04:50:37", "text": "寝る。お腹が空きました。だから、私は食べる"}, {"type": "subtitle", "time": 17440.868, "timestamp": "04:50:40", "text": "何か作って、紅茶を淹れて、"}, {"type": "subtitle", "time": 17444.11, "timestamp": "04:50:44", "text": "そしてそれを飲んで、すぐに"}, {"type": "subtitle", "time": 17447.69, "timestamp": "04:50:47", "text": "ベッド。おやすみ。"}]
[{"type": "subtitle", "time": 6271.83, "timestamp": "01:44:31", "text": "カメラの取り扱いにも気をつけなければならない。"}, {"type": "subtitle", "time": 6274.189, "timestamp": "01:44:34", "text": "私はそうしたくない"}, {"type": "subtitle", "time": 6284.75, "timestamp": "01:44:44", "text": "支持します。私のカメラを使うと想像してください。"}, {"type": "subtitle", "time": 6287.43, "timestamp": "01:44:47", "text": "兄弟。今はそうではない。いや、いや、いや、いや、"}, {"type": "subtitle", "time": 6294.43, "timestamp": "01:44:54", "text": "サポート。いいえ、"}, {"type": "subtitle", "time": 6296.81, "timestamp": "01:44:56", "text": "待って。私は許可しなければならない"}]
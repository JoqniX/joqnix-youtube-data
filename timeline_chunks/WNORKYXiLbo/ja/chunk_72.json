[{"type": "subtitle", "time": 4328.95, "timestamp": "01:12:08", "text": "永遠に？ええ、この人たちはモイン出身です"}, {"type": "subtitle", "time": 4331.75, "timestamp": "01:12:11", "text": "研究所ですよね？彼らにはアカウントシステムがあり、"}, {"type": "subtitle", "time": 4334.31, "timestamp": "01:12:14", "text": "ユニバーサルアカウントシステムのようなもの"}, {"type": "subtitle", "time": 4337.669, "timestamp": "01:12:17", "text": "マイニングラボがあるエコシステム"}, {"type": "subtitle", "time": 4339.669, "timestamp": "01:12:19", "text": "単一のアカウントシステム。だからどんな"}, {"type": "subtitle", "time": 4341.91, "timestamp": "01:12:21", "text": "これ以外にもプロジェクトがあるので、一つ作ってみよう"}, {"type": "subtitle", "time": 4344.709, "timestamp": "01:12:24", "text": "アカウントはまだ転送できます"}, {"type": "subtitle", "time": 4346.63, "timestamp": "01:12:26", "text": "または他のアカウントと同期する"}, {"type": "subtitle", "time": 4349.35, "timestamp": "01:12:29", "text": "彼らのプロジェクトとかそういうもの。それは素晴らしいですね。"}, {"type": "subtitle", "time": 4351.43, "timestamp": "01:12:31", "text": "それが私の店に欲しいものです。でも私は"}, {"type": "subtitle", "time": 4354.07, "timestamp": "01:12:34", "text": "プログラミングは知りません。私はプログラミングを知りません"}, {"type": "subtitle", "time": 4356.31, "timestamp": "01:12:36", "text": "見せる。うん。モインID。うん。同じ"}, {"type": "subtitle", "time": 4358.91, "timestamp": "01:12:38", "text": "もの。これは私が"}, {"type": "subtitle", "time": 4361.63, "timestamp": "01:12:41", "text": "私のためにそんな感じが欲しかった"}, {"type": "subtitle", "time": 4365.87, "timestamp": "01:12:45", "text": "会員ポータルサイトみたいなもの。"}, {"type": "subtitle", "time": 4369.35, "timestamp": "01:12:49", "text": "そう、だって今私が望む理由は"}, {"type": "subtitle", "time": 4372.63, "timestamp": "01:12:52", "text": "ウェブサイトとか色々ある"}, {"type": "subtitle", "time": 4375.47, "timestamp": "01:12:55", "text": "なぜ私はそこまで努力しているのだろうか？"}, {"type": "subtitle", "time": 4377.669, "timestamp": "01:12:57", "text": "考えなければならないから考えなければならない"}]
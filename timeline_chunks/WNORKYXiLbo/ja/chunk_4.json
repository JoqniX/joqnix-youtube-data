[{"type": "subtitle", "time": 252.63, "timestamp": "00:04:12", "text": "ああ、それから私たちはたくさんのことをカバーしています"}, {"type": "subtitle", "time": 256.39, "timestamp": "00:04:16", "text": "ええと、主に現時点では見ています。それで"}, {"type": "subtitle", "time": 259.43, "timestamp": "00:04:19", "text": "それが私の欠席理由です。いいえ、大丈夫です。"}, {"type": "subtitle", "time": 262.79, "timestamp": "00:04:22", "text": "大丈夫だよ。"}, {"type": "subtitle", "time": 265.79, "timestamp": "00:04:25", "text": "あなたが時間を費やしているという事実"}, {"type": "subtitle", "time": 270.189, "timestamp": "00:04:30", "text": "何かをする、または何かを描くなど"}, {"type": "subtitle", "time": 274.67, "timestamp": "00:04:34", "text": "YouTuberにとって、それは大きなことだ。あなた"}, {"type": "subtitle", "time": 278.03, "timestamp": "00:04:38", "text": "知ってるよ、あの人たちは"}, {"type": "subtitle", "time": 282.31, "timestamp": "00:04:42", "text": "贈り物を受け取る人のように"}, {"type": "subtitle", "time": 284.87, "timestamp": "00:04:44", "text": "そうすれば、彼らはとても幸せになり、"}, {"type": "subtitle", "time": 287.27, "timestamp": "00:04:47", "text": "とても大切にしています。"}, {"type": "subtitle", "time": 289.749, "timestamp": "00:04:49", "text": "みんながそうするわけじゃないんだよ、"}, {"type": "subtitle", "time": 293.469, "timestamp": "00:04:53", "text": "このコミュニティは本当に"}, {"type": "subtitle", "time": 295.79, "timestamp": "00:04:55", "text": "小さい。"}]
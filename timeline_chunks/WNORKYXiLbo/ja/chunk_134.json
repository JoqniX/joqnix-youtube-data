[{"type": "subtitle", "time": 8040.99, "timestamp": "02:14:00", "text": "時間だが、"}, {"type": "subtitle", "time": 8043.629, "timestamp": "02:14:03", "text": "うん。ああ、"}, {"type": "subtitle", "time": 8046.669, "timestamp": "02:14:06", "text": "いいえ。タイマー。"}, {"type": "subtitle", "time": 8068.39, "timestamp": "02:14:28", "text": "あ、こんにちは。よう、どうしたの？ ああ、それは"}, {"type": "subtitle", "time": 8070.79, "timestamp": "02:14:30", "text": "順調です。私はこれを試していました"}, {"type": "subtitle", "time": 8072.95, "timestamp": "02:14:32", "text": "初めてプラットフォーム上で。調子はどうですか"}, {"type": "subtitle", "time": 8075.75, "timestamp": "02:14:35", "text": "あなた？同じ。元気です。何てことだ、"}, {"type": "subtitle", "time": 8077.83, "timestamp": "02:14:37", "text": "あなたは素晴らしい目をお持ちですね。私は"}, {"type": "subtitle", "time": 8080.87, "timestamp": "02:14:40", "text": "青と紫。ありがとう。私は愛する"}, {"type": "subtitle", "time": 8083.669, "timestamp": "02:14:43", "text": "あなたのアバターも同様です。"}, {"type": "subtitle", "time": 8085.27, "timestamp": "02:14:45", "text": "ありがとう。どうやってあなたにカミングアウトすればいいですか？する"}, {"type": "subtitle", "time": 8088.229, "timestamp": "02:14:48", "text": "ぼやけて見える？それとも、ややぼやけて見える？"}, {"type": "subtitle", "time": 8090.87, "timestamp": "02:14:50", "text": "うーん、ちょっとぼやけてる。"}, {"type": "subtitle", "time": 8094.79, "timestamp": "02:14:54", "text": "それを受け取ります。それは私にとっての勝利だ。"}, {"type": "subtitle", "time": 8098.27, "timestamp": "02:14:58", "text": "待って。えっと、ぼやけているのが正しいのでしょうか？"}]
[{"type": "subtitle", "time": 16262.389, "timestamp": "04:31:02", "text": "日。昔はウィジェットとか色々作ってたんだ"}, {"type": "subtitle", "time": 16263.229, "timestamp": "04:31:03", "text": "のために"}, {"type": "subtitle", "time": 16265.91, "timestamp": "04:31:05", "text": "ストリーム。楽しかった。たとえそれが"}, {"type": "subtitle", "time": 16269.469, "timestamp": "04:31:09", "text": "小さなことだけど、"}, {"type": "subtitle", "time": 16273.189, "timestamp": "04:31:13", "text": "配信をより魅力的なものにできて嬉しいです"}, {"type": "subtitle", "time": 16275.149, "timestamp": "04:31:15", "text": "そして"}, {"type": "subtitle", "time": 16277.75, "timestamp": "04:31:17", "text": "面白い。視聴者のエンゲージメントも"}, {"type": "subtitle", "time": 16279.99, "timestamp": "04:31:19", "text": "何か重要なこと。"}, {"type": "subtitle", "time": 16282.95, "timestamp": "04:31:22", "text": "うん、だって、それは何か"}, {"type": "subtitle", "time": 16285.429, "timestamp": "04:31:25", "text": "それはジョアトンには欠けているものですよね？"}, {"type": "subtitle", "time": 16287.99, "timestamp": "04:31:27", "text": "より多くの関与。モーには何もない"}, {"type": "subtitle", "time": 16291.75, "timestamp": "04:31:31", "text": "ほとんどの人にとってそうですよね？唯一の"}, {"type": "subtitle", "time": 16293.429, "timestamp": "04:31:33", "text": "問題は、あなたが私とチャットしていて、"}, {"type": "subtitle", "time": 16296.83, "timestamp": "04:31:36", "text": "監視したり、こっそり様子を伺ったり、そういうこと。それは"}, {"type": "subtitle", "time": 16301.349, "timestamp": "04:31:41", "text": "それ。うん。そして私は、"}, {"type": "subtitle", "time": 16304.11, "timestamp": "04:31:44", "text": "私はマルチリーミングをしています、好きになるのは難しい"}, {"type": "subtitle", "time": 16308.469, "timestamp": "04:31:48", "text": "それをすべてのプラットフォームに提供してください。"}, {"type": "subtitle", "time": 16309.55, "timestamp": "04:31:49", "text": "だからそれは"}, {"type": "subtitle", "time": 16313.55, "timestamp": "04:31:53", "text": "ビリー・ビリー側について話すのは辛い。それで"}, {"type": "subtitle", "time": 16316.55, "timestamp": "04:31:56", "text": "ええ、私たちは日本に留学する予定です。えっと"}, {"type": "subtitle", "time": 16318.99, "timestamp": "04:31:58", "text": "この2年間のコースは、"}]
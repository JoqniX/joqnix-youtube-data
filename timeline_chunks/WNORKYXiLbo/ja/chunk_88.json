[{"type": "subtitle", "time": 5280.629, "timestamp": "01:28:00", "text": "収益化は、私がヒットした頃には"}, {"type": "subtitle", "time": 5283.51, "timestamp": "01:28:03", "text": "今は千ですが、スーパーチャットがあります。"}, {"type": "subtitle", "time": 5286.709, "timestamp": "01:28:06", "text": "すべてですが、ええ、心配なのは"}, {"type": "subtitle", "time": 5290.07, "timestamp": "01:28:10", "text": "彼らが言及したこと"}, {"type": "subtitle", "time": 5291.149, "timestamp": "01:28:11", "text": "ルール"}, {"type": "subtitle", "time": 5293.149, "timestamp": "01:28:13", "text": "あれと"}, {"type": "subtitle", "time": 5295.99, "timestamp": "01:28:15", "text": "すべて私がオープンになると思いますか"}, {"type": "subtitle", "time": 5298.31, "timestamp": "01:28:18", "text": "私が見たら私の個人情報が漏洩する"}, {"type": "subtitle", "time": 5300.669, "timestamp": "01:28:20", "text": "自分の学校を上る"}, {"type": "subtitle", "time": 5305.03, "timestamp": "01:28:25", "text": "今日本では、つまり、もし"}, {"type": "subtitle", "time": 5308.59, "timestamp": "01:28:28", "text": "誰でも日本に来る"}, {"type": "subtitle", "time": 5311.07, "timestamp": "01:28:31", "text": "右。"}, {"type": "subtitle", "time": 5315.87, "timestamp": "01:28:35", "text": "知る。私"}, {"type": "subtitle", "time": 5319.03, "timestamp": "01:28:39", "text": "つまり、私を見つけることはできないってこと。"}, {"type": "subtitle", "time": 5322.189, "timestamp": "01:28:42", "text": "私を見つけてください。たくさんの人が外に出ている"}, {"type": "subtitle", "time": 5324.27, "timestamp": "01:28:44", "text": "そこには、"}, {"type": "subtitle", "time": 5327.229, "timestamp": "01:28:47", "text": "右？自分が知らないことは分かっている。"}, {"type": "subtitle", "time": 5331.189, "timestamp": "01:28:51", "text": "でも、ちょっとチェックしたかったんです"}, {"type": "subtitle", "time": 5333.669, "timestamp": "01:28:53", "text": "学校のウェブサイトを見て、"}, {"type": "subtitle", "time": 5338.31, "timestamp": "01:28:58", "text": "規則や規制は、"}]
[{"type": "subtitle", "time": 1140.07, "timestamp": "00:19:00", "text": "まだ。私はまだリリースしていません"}, {"type": "subtitle", "time": 1142.47, "timestamp": "00:19:02", "text": "まだ正式なデザインではないか、または"}, {"type": "subtitle", "time": 1146.029, "timestamp": "00:19:06", "text": "技術的には2番目の衣装は"}, {"type": "subtitle", "time": 1149.51, "timestamp": "00:19:09", "text": "まだ正式な発表はない。適切ではない、適切ではない"}, {"type": "subtitle", "time": 1154.789, "timestamp": "00:19:14", "text": "2D、いや、まだちゃんとした3Dではない。では、どのように"}, {"type": "subtitle", "time": 1157.029, "timestamp": "00:19:17", "text": "世界は私がリリースしたいと思う"}, {"type": "subtitle", "time": 1159.87, "timestamp": "00:19:19", "text": "現実的なモデル？もちろんできますよ"}, {"type": "subtitle", "time": 1163.43, "timestamp": "00:19:23", "text": "もし私がチャンネルを成長させ、"}, {"type": "subtitle", "time": 1165.59, "timestamp": "00:19:25", "text": "すべて順調に。私は引っ張ることができる"}, {"type": "subtitle", "time": 1170.47, "timestamp": "00:19:30", "text": "Kが彼女にしたように、あなたはどう思いますか？Kが彼女にしたように。"}, {"type": "subtitle", "time": 1172.39, "timestamp": "00:19:32", "text": "そして上須木はコラボレーションを行った"}, {"type": "subtitle", "time": 1176.23, "timestamp": "00:19:36", "text": "メタヒューマンみたいなやつ。えっと、何ですか、何ですか"}, {"type": "subtitle", "time": 1180.15, "timestamp": "00:19:40", "text": "アーティスト名はTu Inuですか？いや、Tは知らないよ"}, {"type": "subtitle", "time": 1183.19, "timestamp": "00:19:43", "text": "その日本人DJの名前は何ですか？忘れた"}, {"type": "subtitle", "time": 1185.19, "timestamp": "00:19:45", "text": "でも、コラボレーションのようなものですね"}, {"type": "subtitle", "time": 1188.63, "timestamp": "00:19:48", "text": "それで、K はそこにいました"}, {"type": "subtitle", "time": 1191.23, "timestamp": "00:19:51", "text": "仮想人間とその"}, {"type": "subtitle", "time": 1193.99, "timestamp": "00:19:53", "text": "ウェブサイトの車とリムはすべてそこにありました"}, {"type": "subtitle", "time": 1195.75, "timestamp": "00:19:55", "text": "あのバーチャルヒューマンのやつ、そして私は"}, {"type": "subtitle", "time": 1197.31, "timestamp": "00:19:57", "text": "のように"}]
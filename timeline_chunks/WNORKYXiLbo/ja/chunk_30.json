[{"type": "subtitle", "time": 1800.51, "timestamp": "00:30:00", "text": "[音楽]"}, {"type": "subtitle", "time": 1803.43, "timestamp": "00:30:03", "text": "えっと、コミュニティの方が良いと思う"}, {"type": "subtitle", "time": 1805.83, "timestamp": "00:30:05", "text": "メンバーがYouTuberではなくそれを行う"}, {"type": "subtitle", "time": 1809.75, "timestamp": "00:30:09", "text": "VTuberにとって負担が大きすぎるからそうしている"}, {"type": "subtitle", "time": 1812.07, "timestamp": "00:30:12", "text": "対処する。"}, {"type": "subtitle", "time": 1829.51, "timestamp": "00:30:29", "text": "招待する時、そう思う時もある"}, {"type": "subtitle", "time": 1831.23, "timestamp": "00:30:31", "text": "は"}, {"type": "subtitle", "time": 1834.11, "timestamp": "00:30:34", "text": "コミュニティは"}, {"type": "subtitle", "time": 1837.19, "timestamp": "00:30:37", "text": "いいけど、責任と"}, {"type": "subtitle", "time": 1839.789, "timestamp": "00:30:39", "text": "すべては上に置かれる"}, {"type": "subtitle", "time": 1842.71, "timestamp": "00:30:42", "text": "新しい不必要なドラマは何であれ"}, {"type": "subtitle", "time": 1846.63, "timestamp": "00:30:46", "text": "あなたにはたくさんのことが課せられるでしょうが"}, {"type": "subtitle", "time": 1848.549, "timestamp": "00:30:48", "text": "ええ、最近はみんな自分の"}, {"type": "subtitle", "time": 1851.389, "timestamp": "00:30:51", "text": "自分のものだから問題ない"}, {"type": "subtitle", "time": 1854.789, "timestamp": "00:30:54", "text": "推測だけど、そう、誰かが実際に"}, {"type": "subtitle", "time": 1859.269, "timestamp": "00:30:59", "text": "SG Vtuber 1人を見つけたのですが、"}]
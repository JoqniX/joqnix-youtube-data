[{"type": "subtitle", "time": 1021.269, "timestamp": "00:17:01", "text": "何かだが、実際にはそうではない"}, {"type": "subtitle", "time": 1025.27, "timestamp": "00:17:05", "text": "それらはただの人工物だ。えっと"}, {"type": "subtitle", "time": 1027.829, "timestamp": "00:17:07", "text": "頭の中で思い出すと"}, {"type": "subtitle", "time": 1031.71, "timestamp": "00:17:11", "text": "最初のインド人として"}, {"type": "subtitle", "time": 1033.71, "timestamp": "00:17:13", "text": "テラクション。どれの"}, {"type": "subtitle", "time": 1036.909, "timestamp": "00:17:16", "text": "1つ？誰が"}, {"type": "subtitle", "time": 1041.47, "timestamp": "00:17:21", "text": "それ？知ってるよ、ある男が"}, {"type": "chat", "time": 1048.418, "timestamp": "00:17:28", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "hey hey joqqy how u doin"}, {"type": "chat", "time": 1051.158, "timestamp": "00:17:31", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Greetings Konzteller! Lord HeadAss~🌟 Welcome to the Guild! Make sure to read the Guildmate Guidelines in the description below before chatting further. Enjoy your stay!"}, {"type": "subtitle", "time": 1055.59, "timestamp": "00:17:35", "text": "私はあるビデオを覚えています"}, {"type": "subtitle", "time": 1059.23, "timestamp": "00:17:39", "text": "えっと、私の記憶が正しければ"}, {"type": "subtitle", "time": 1064.11, "timestamp": "00:17:44", "text": "正しくは、それを共有したのは私でした"}, {"type": "subtitle", "time": 1067.11, "timestamp": "00:17:47", "text": "ズキかズキ、そう、知らなかったから"}, {"type": "subtitle", "time": 1069.35, "timestamp": "00:17:49", "text": "ヒンディー語は今、人々が"}, {"type": "subtitle", "time": 1071.669, "timestamp": "00:17:51", "text": "悪口を言ったり、良いことを言ったりする"}, {"type": "subtitle", "time": 1074.95, "timestamp": "00:17:54", "text": "ヒンディー語でこれがあった"}, {"type": "subtitle", "time": 1077.83, "timestamp": "00:17:57", "text"
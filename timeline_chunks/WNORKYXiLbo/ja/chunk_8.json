[{"type": "subtitle", "time": 481.83, "timestamp": "00:08:01", "text": "大衆の権利、手数料率、そして"}, {"type": "subtitle", "time": 484.749, "timestamp": "00:08:04", "text": "そこではすべてが変わる"}, {"type": "subtitle", "time": 489.07, "timestamp": "00:08:09", "text": "時間、そしてそこが私が怖いところなんです"}, {"type": "subtitle", "time": 492.15, "timestamp": "00:08:12", "text": "ライセンス料を支払わなければならない"}, {"type": "subtitle", "time": 499.23, "timestamp": "00:08:19", "text": "それで"}, {"type": "subtitle", "time": 503.27, "timestamp": "00:08:23", "text": "うん、正直言って好きじゃなかったよ、正直言って"}, {"type": "subtitle", "time": 506.51, "timestamp": "00:08:26", "text": "私はもっ​​と忍耐強く待つつもりだった、"}, {"type": "subtitle", "time": 508.909, "timestamp": "00:08:28", "text": "知る、"}, {"type": "subtitle", "time": 513.389, "timestamp": "00:08:33", "text": "しかし、私の作品はすべて既に完成していた。しかし"}, {"type": "subtitle", "time": 516.35, "timestamp": "00:08:36", "text": "芸術が"}, {"type": "subtitle", "time": 520.949, "timestamp": "00:08:40", "text": "えっと、アートが完成しました"}, {"type": "subtitle", "time": 524.23, "timestamp": "00:08:44", "text": "今すぐですが、待たなければなりません"}, {"type": "subtitle", "time": 526.71, "timestamp": "00:08:46", "text": "7年か、7年ではない、それは長すぎる"}, {"type": "subtitle", "time": 528.63, "timestamp": "00:08:48", "text": "少なくとも３、４年くらい"}, {"type": "subtitle", "time": 531.71, "timestamp": "00:08:51", "text": "または少なくとも2年間、1年間は"}, {"type": "subtitle", "time": 535.43, "timestamp": "00:08:55", "text": "少なくとも全体を手に入れるために"}, {"type": "subtitle", "time": 537.67, "timestamp": "00:08:57", "text": "つまり、あなたのように、"}, {"type": "subtitle", "time": 539.59, "timestamp": "00:08:59", "text": "例えば、誰かが私に投資してくれたとか。"}]
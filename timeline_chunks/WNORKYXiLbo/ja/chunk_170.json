[{"type": "subtitle", "time": 10200.15, "timestamp": "02:50:00", "text": "彼らについてもっと知ると、"}, {"type": "subtitle", "time": 10202.95, "timestamp": "02:50:02", "text": "私にはたくさんの疑問があります。私は"}, {"type": "subtitle", "time": 10204.63, "timestamp": "02:50:04", "text": "この時点で私は自分のポッドキャストを始めます"}, {"type": "subtitle", "time": 10204.97, "timestamp": "02:50:04", "text": "または"}, {"type": "subtitle", "time": 10206.269, "timestamp": "02:50:06", "text": "[音楽]"}, {"type": "subtitle", "time": 10209.71, "timestamp": "02:50:09", "text": "何でも。でもまあ、"}, {"type": "subtitle", "time": 10212.95, "timestamp": "02:50:12", "text": "文字通り、私が望んでいたように楽しかった"}, {"type": "subtitle", "time": 10217.23, "timestamp": "02:50:17", "text": "男性に質問して、どのように対処し管理するか"}, {"type": "subtitle", "time": 10220.79, "timestamp": "02:50:20", "text": "これですか？"}, {"type": "subtitle", "time": 10223.429, "timestamp": "02:50:23", "text": "うん、それはすごくクールだね。いいえ、実際は"}, {"type": "subtitle", "time": 10227.269, "timestamp": "02:50:27", "text": "モデレーションを監視しています"}, {"type": "subtitle", "time": 10228.429, "timestamp": "02:50:28", "text": "ストリーマー"}, {"type": "subtitle", "time": 10231.269, "timestamp": "02:50:31", "text": "窓の下でチャットしたり、"}, {"type": "subtitle", "time": 10234.79, "timestamp": "02:50:34", "text": "これは横に置いて、ぶら下げている。それは"}, {"type": "subtitle", "time": 10240.03, "timestamp": "02:50:40", "text": "いいね。私の髪は"}, {"type": "subtitle", "time": 10253.87, "timestamp": "02:50:53", "text": "暗い。とても楽しかった。これはとても"}]
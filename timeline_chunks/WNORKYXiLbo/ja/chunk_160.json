[{"type": "subtitle", "time": 9601.27, "timestamp": "02:40:01", "text": "ああ、それからSlime VRは"}, {"type": "subtitle", "time": 9604.07, "timestamp": "02:40:04", "text": "干渉はあったが、彼らはそれを修正している。"}, {"type": "subtitle", "time": 9605.91, "timestamp": "02:40:05", "text": "ソニーが"}, {"type": "subtitle", "time": 9607.51, "timestamp": "02:40:07", "text": "彼らの問題を解決してあげてください。彼らはそうしなければならないかもしれない"}, {"type": "subtitle", "time": 9611.349, "timestamp": "02:40:11", "text": "新バージョンをリリースする。えーと、ちょっと待って、えーと"}, {"type": "subtitle", "time": 9613.59, "timestamp": "02:40:13", "text": "Slime VRの修正では、"}, {"type": "subtitle", "time": 9615.75, "timestamp": "02:40:15", "text": "新バージョンまたは類似のソフトウェアまたは"}, {"type": "subtitle", "time": 9617.11, "timestamp": "02:40:17", "text": "何か。えっと、Slime VRでは、"}, {"type": "subtitle", "time": 9618.63, "timestamp": "02:40:18", "text": "おそらく彼らはおそらく次のような"}, {"type": "subtitle", "time": 9621.27, "timestamp": "02:40:21", "text": "モジュール式の修正。ああ、あるいは彼らは"}, {"type": "subtitle", "time": 9625.83, "timestamp": "02:40:25", "text": "既に修正点などが改善されています。しかし"}, {"type": "subtitle", "time": 9627.75, "timestamp": "02:40:27", "text": "公式の仕組みはよく分かりません。"}, {"type": "subtitle", "time": 9629.19, "timestamp": "02:40:29", "text": "私の知る限りでは、公式のものは"}, {"type": "subtitle", "time": 9631.27, "timestamp": "02:40:31", "text": "すでにかなり良いですが、もしあなたが"}, {"type": "subtitle", "time": 9633.11, "timestamp": "02:40:33", "text": "自分で構築する場合、選択できます"}, {"type": "subtitle", "time": 9634.389, "timestamp": "02:40:34", "text": "含めるかどうか"}, {"type": "subtitle", "time": 9637.59, "timestamp": "02:40:37", "text": "修理するかしないか。ああ、それは本当に便利だ。"}, {"type": "subtitle", "time": 9645.03, "timestamp": "02:40:45", "text": "ええ、そうですね。ありがとうございます。私は思う"}, {"type": "subtitle", "time": 9647.75, "timestamp": "02:40:47", "text": "あなたは今すぐ行かなければなりません。ありがとう。うん。私は"}, {"type": "subtitle", "time": 9649.67, "timestamp": "02:40:49", "text": "仕事があるから出かけよう"}, {"type": "subtitle", "time": 9652.87, "timestamp": "02:40:52", "text": "1時間後。こんにちは。気をつけて。そしてそれは"}, 
[{"type": "subtitle", "time": 18181.43, "timestamp": "05:03:01", "text": "行きたいけど、うん"}, {"type": "subtitle", "time": 18184.27, "timestamp": "05:03:04", "text": "あ、もう行かなきゃ。それが計画だったが"}, {"type": "subtitle", "time": 18187.59, "timestamp": "05:03:07", "text": "それで、それは大丈夫ではないということだった"}, {"type": "subtitle", "time": 18189.75, "timestamp": "05:03:09", "text": "もしあなたが来て何かをしたくないなら"}, {"type": "subtitle", "time": 18191.708, "timestamp": "05:03:11", "text": "あなたは忙しくて"}, {"type": "subtitle", "time": 18195.35, "timestamp": "05:03:15", "text": "もの。だから私は「わかった、いいよ」と思った。でもパパ"}, {"type": "subtitle", "time": 18197.83, "timestamp": "05:03:17", "text": "私に「好き」と頼んだら、あなたはそうしたい"}, {"type": "subtitle", "time": 18200.948, "timestamp": "05:03:20", "text": "日帰り旅行であなたの好きな人に会いに行きましょう"}, {"type": "subtitle", "time": 18203.27, "timestamp": "05:03:23", "text": "父方の祖母は"}, {"type": "subtitle", "time": 18206.868, "timestamp": "05:03:26", "text": "おばあちゃんネズミのお母さんとか、だって私は"}, {"type": "subtitle", "time": 18208.948, "timestamp": "05:03:28", "text": "今はもう見ることもできないだろう"}, {"type": "subtitle", "time": 18212.788, "timestamp": "05:03:32", "text": "もし私が日本に行ったら、私は"}, {"type": "subtitle", "time": 18215.43, "timestamp": "05:03:35", "text": "2年間ここに戻って来られる"}, {"type": "subtitle", "time": 18218.07, "timestamp": "05:03:38", "text": "少なくとも緊急事態でない限り、"}, {"type": "subtitle", "time": 18221.27, "timestamp": "05:03:41", "text": "正式な許可があれば"}, {"type": "subtitle", "time": 18233.19, "timestamp": "05:03:53", "text": "夏休み中または夏休みに行くとき"}, {"type": "subtitle", "time": 18235.11, "timestamp": "05:03:55", "text": "休暇は2～3週間あります"}, {"type": "subtitle", "time": 18238.35, "timestamp": "05:03:58", "text": "休日の2つか3つだと思う"}]
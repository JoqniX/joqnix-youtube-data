[{"type": "subtitle", "time": 4022.309, "timestamp": "01:07:02", "text": "うん。つまり、私は"}, {"type": "subtitle", "time": 4025.829, "timestamp": "01:07:05", "text": "CSSとHTMLの知識があればもっとうまくできたのに"}, {"type": "subtitle", "time": 4029.029, "timestamp": "01:07:09", "text": "きちんとこなして、コーディングとかそういうのが好きなんです。私"}, {"type": "subtitle", "time": 4032.23, "timestamp": "01:07:12", "text": "ホームページのコンテンツを自分のウェブサイトにできたはずなのに"}, {"type": "subtitle", "time": 4036.069, "timestamp": "01:07:16", "text": "もっといいのは、私が座るたびに"}, {"type": "subtitle", "time": 4039.029, "timestamp": "01:07:19", "text": "ウェブスタジオのプロジェクトに取り組む。いいえ、私は"}, {"type": "subtitle", "time": 4041.43, "timestamp": "01:07:21", "text": "たくさんのチュートリアルを見る"}, {"type": "subtitle", "time": 4045.829, "timestamp": "01:07:25", "text": "ウェブスタジオチャンネル。作り方"}, {"type": "subtitle", "time": 4049.589, "timestamp": "01:07:29", "text": "横スクロールまたはこのフッターページ。"}, {"type": "subtitle", "time": 4053.19, "timestamp": "01:07:33", "text": "使えるテンプレートはあるけど"}, {"type": "subtitle", "time": 4057.029, "timestamp": "01:07:37", "text": "変化とか色々あるけど、それでも"}, {"type": "subtitle", "time": 4059.71, "timestamp": "01:07:39", "text": "特定の物の使い方"}, {"type": "subtitle", "time": 4065.63, "timestamp": "01:07:45", "text": "物を使いすぎるなど"}, {"type": "subtitle", "time": 4070.63, "timestamp": "01:07:50", "text": "痛みはありますが、座るのが楽しいです"}, {"type": "subtitle", "time": 4074.47, "timestamp": "01:07:54", "text": "下に行くと、そのゾーンに閉じ込められます"}, {"type": "subtitle", "time": 4078.15, "timestamp": "01:07:58", "text": "物事をした後、"}]
[{"type": "subtitle", "time": 9240.15, "timestamp": "02:34:00", "text": "八。うん。ああ、いいね。"}, {"type": "subtitle", "time": 9242.15, "timestamp": "02:34:02", "text": "それはどのように考えているのか、私はそう思う"}, {"type": "subtitle", "time": 9245.59, "timestamp": "02:34:05", "text": "おそらく電話に出て、それから"}, {"type": "subtitle", "time": 9247.59, "timestamp": "02:34:07", "text": "これに取り組む。おそらくこれが"}, {"type": "subtitle", "time": 9254.15, "timestamp": "02:34:14", "text": "私がこうすることで、物事は前進する。"}, {"type": "subtitle", "time": 9256.95, "timestamp": "02:34:16", "text": "でも、トラッカーを切り替えて"}, {"type": "subtitle", "time": 9259.349, "timestamp": "02:34:19", "text": "見る。"}, {"type": "subtitle", "time": 9262.79, "timestamp": "02:34:22", "text": "トラッカーの電源を切ります。"}, {"type": "subtitle", "time": 9266.23, "timestamp": "02:34:26", "text": "私の手もそれに合わせて動くのがわかるでしょう。うん。そして"}, {"type": "subtitle", "time": 9269.91, "timestamp": "02:34:29", "text": "突然右の方へ移動した。"}, {"type": "subtitle", "time": 9271.07, "timestamp": "02:34:31", "text": "私"}, {"type": "subtitle", "time": 9274.63, "timestamp": "02:34:34", "text": "解明しようとしないでください。"}, {"type": "subtitle", "time": 9277.11, "timestamp": "02:34:37", "text": "キャリブレーションは大変な作業だと思います。"}, {"type": "subtitle", "time": 9280.79, "timestamp": "02:34:40", "text": "右？うん。えーと、これら"}, {"type": "subtitle", "time": 9283.15, "timestamp": "02:34:43", "text": "かなり安い。私は8つすべてを手に入れました"}, {"type": "subtitle", "time": 9287.79, "timestamp": "02:34:47", "text": "160. 私はそれらを渡しますが、彼らは負けます"}, {"type": "subtitle", "time": 9293.19, "timestamp": "02:34:53", "text": "ええと、その後かなり同期がずれます。"}, {"type": "subtitle", "time": 9295.67, "timestamp": "02:34:55", "text": "でも、おそらく何にでも十分でしょう"}, {"type": "subtitle", "time": 9298.469, "timestamp": "02:34:58", "text": "私はやりたい。うん。"}]
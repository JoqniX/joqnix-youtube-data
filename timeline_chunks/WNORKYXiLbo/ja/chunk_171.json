[{"type": "subtitle", "time": 10274.91, "timestamp": "02:51:14", "text": "えっと"}, {"type": "subtitle", "time": 10277.07, "timestamp": "02:51:17", "text": "ええ、人々は"}, {"type": "subtitle", "time": 10279.469, "timestamp": "02:51:19", "text": "敬意を払う。私は"}, {"type": "subtitle", "time": 10283.79, "timestamp": "02:51:23", "text": "幸せだよ、今は、心の底では"}, {"type": "subtitle", "time": 10286.59, "timestamp": "02:51:26", "text": "意識する"}, {"type": "subtitle", "time": 10289.91, "timestamp": "02:51:29", "text": "ありきたりなことはしたくないから"}, {"type": "subtitle", "time": 10292.71, "timestamp": "02:51:32", "text": "YouTuber風のスタイルは今や"}, {"type": "subtitle", "time": 10294.95, "timestamp": "02:51:34", "text": "特にジョックマラソンでは。"}, {"type": "subtitle", "time": 10298.469, "timestamp": "02:51:38", "text": "挑発してるんだよね？そして私はそうではない"}, {"type": "subtitle", "time": 10300.59, "timestamp": "02:51:40", "text": "適切な挑発に続いて"}, {"type": "subtitle", "time": 10302.349, "timestamp": "02:51:42", "text": "もの"}, {"type": "subtitle", "time": 10305.59, "timestamp": "02:51:45", "text": "そしてその他諸々。特にあの"}, {"type": "subtitle", "time": 10308.389, "timestamp": "02:51:48", "text": "2万人に1人くらいの確率でトップに立つ。"}, {"type": "subtitle", "time": 10311.269, "timestamp": "02:51:51", "text": "いや、それは人々にそう思わせることになる"}, {"type": "subtitle", "time": 10314.389, "timestamp": "02:51:54", "text": "えっと、うまくいってないとか、そういう感じ"}, {"type": "subtitle", "time": 10318.349, "timestamp": "02:51:58", "text": "あるいは、人々が推測するように"}]
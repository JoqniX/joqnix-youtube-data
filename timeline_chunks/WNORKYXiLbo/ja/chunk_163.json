[{"type": "subtitle", "time": 9780.389, "timestamp": "02:43:00", "text": "この神を見たとき、私は自分自身を見た。その"}, {"type": "subtitle", "time": 9784.71, "timestamp": "02:43:04", "text": "久しぶりですね。ミーシャンを見かけた"}, {"type": "subtitle", "time": 9793.429, "timestamp": "02:43:13", "text": "相互作用した。たとえ"}, {"type": "subtitle", "time": 9796.71, "timestamp": "02:43:16", "text": "それはほんの少しの間だった。"}, {"type": "subtitle", "time": 9798.95, "timestamp": "02:43:18", "text": "ちょっと失礼な感じがした"}, {"type": "subtitle", "time": 9802.15, "timestamp": "02:43:22", "text": "ほら、こんにちはとかさよならとか言うよね"}, {"type": "subtitle", "time": 9803.79, "timestamp": "02:43:23", "text": "出発"}, {"type": "subtitle", "time": 9807.83, "timestamp": "02:43:27", "text": "VCだけど、デニスを作りたくなかった"}, {"type": "subtitle", "time": 9816.79, "timestamp": "02:43:36", "text": "だって、本当に安心できたから"}, {"type": "subtitle", "time": 9817.79, "timestamp": "02:43:37", "text": "話している"}, {"type": "subtitle", "time": 9821.07, "timestamp": "02:43:41", "text": "その曲について。"}, {"type": "subtitle", "time": 9825.429, "timestamp": "02:43:45", "text": "うん。ええ、そういうことです。"}, {"type": "subtitle", "time": 9828.15, "timestamp": "02:43:48", "text": "私の携帯電話は追跡していません。何が何だ"}, {"type": "subtitle", "time": 9839.55, "timestamp": "02:43:59", "text": "オム。本当に"}]
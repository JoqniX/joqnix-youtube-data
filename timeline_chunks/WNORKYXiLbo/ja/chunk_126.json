[{"type": "subtitle", "time": 7562.79, "timestamp": "02:06:02", "text": "えっと、あなたは何をしているのですか、あなたはライブ配信していますか"}, {"type": "subtitle", "time": 7566.07, "timestamp": "02:06:06", "text": "今ストリーミング中、または"}, {"type": "subtitle", "time": 7567.83, "timestamp": "02:06:07", "text": "今ログインしたばかりですか？わからない。私はしませんでした"}, {"type": "subtitle", "time": 7570.31, "timestamp": "02:06:10", "text": "火曜日に爆発すると思うので、"}, {"type": "subtitle", "time": 7580.87, "timestamp": "02:06:20", "text": "たぶん私は乗るべきで、"}, {"type": "subtitle", "time": 7584.229, "timestamp": "02:06:24", "text": "私がそうすると言ったから、ただVチャットにいるだけ"}, {"type": "subtitle", "time": 7589.91, "timestamp": "02:06:29", "text": "このVでの経験はどうでしたか？"}, {"type": "subtitle", "time": 7593.03, "timestamp": "02:06:33", "text": "チャット？さて、問題はここからです。私は私は"}, {"type": "subtitle", "time": 7595.109, "timestamp": "02:06:35", "text": "Discordのモデレーターなので、私はただ"}, {"type": "subtitle", "time": 7596.79, "timestamp": "02:06:36", "text": "飛び乗って、新しい赤ちゃんたちをみんな見る"}, {"type": "subtitle", "time": 7600.47, "timestamp": "02:06:40", "text": "火曜日は私たちの曜日ではないからです。おお、"}, {"type": "subtitle", "time": 7603.149, "timestamp": "02:06:43", "text": "ここ。けれど。"}, {"type": "subtitle", "time": 7606.47, "timestamp": "02:06:46", "text": "あ、待って。あなたは実際には"}, {"type": "subtitle", "time": 7611.31, "timestamp": "02:06:51", "text": "ウェブチャット、Discordなど。おお、"}, {"type": "subtitle", "time": 7614.55, "timestamp": "02:06:54", "text": "ニース。まだ参加していませんが、"}, {"type": "chat", "time": 7615.436, "timestamp": "02:06:55", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "ah thats pretty fucken cool"}, {"type": "subtitle", "time": 7617.669, "timestamp": "02:06:57", "text": "正しい。うん、私も参加しないといけないな。"}, {"type": "subtitle", "time": 7619.43, "timestamp": "02:06:59", "text": "ご都合の良い時にご確認ください。それは違う"}]
[{"type": "subtitle", "time": 1680.47, "timestamp": "00:28:00", "text": "私は自分の"}, {"type": "subtitle", "time": 1683.95, "timestamp": "00:28:03", "text": "Twitterアカウント。実際、私は失敗した"}, {"type": "subtitle", "time": 1686.87, "timestamp": "00:28:06", "text": "上。そして人々はこう考えるかもしれない。"}, {"type": "subtitle", "time": 1690.99, "timestamp": "00:28:10", "text": "「ああ、ジョーはとても自己中心的だ、あるいは"}, {"type": "subtitle", "time": 1693.71, "timestamp": "00:28:13", "text": "何か。」実際には、それは"}, {"type": "subtitle", "time": 1696.47, "timestamp": "00:28:16", "text": "それ。私はただより大きなものを追いかけていた"}, {"type": "subtitle", "time": 1698.669, "timestamp": "00:28:18", "text": "クリエイターみたいなもの。私は"}, {"type": "subtitle", "time": 1701.07, "timestamp": "00:28:21", "text": "形式。私は"}, {"type": "subtitle", "time": 1703.789, "timestamp": "00:28:23", "text": "のように、"}, {"type": "subtitle", "time": 1706.87, "timestamp": "00:28:26", "text": "「ああ、物事が物事のようだったら"}, {"type": "subtitle", "time": 1707.789, "timestamp": "00:28:27", "text": "道"}, {"type": "subtitle", "time": 1711.35, "timestamp": "00:28:31", "text": "それは行くはずだった、私は"}, {"type": "subtitle", "time": 1713.87, "timestamp": "00:28:33", "text": "これについては心配する必要はないですよね"}, {"type": "subtitle", "time": 1717.35, "timestamp": "00:28:37", "text": "今。私を見て。うまくいかなかった。"}, {"type": "subtitle", "time": 1720.95, "timestamp": "00:28:40", "text": "「だからそうしてるんだよ。」でも、そうだね。"}, {"type": "subtitle", "time": 1723.029, "timestamp": "00:28:43", "text": "まるでそれがメインであるかのように"}, {"type": "subtitle", "time": 1726.47, "timestamp": "00:28:46", "text": "アカウント。私はただ従うだけだと思った"}, {"type": "subtitle", "time": 1729.75, "timestamp": "00:28:49", "text": "人々を作り出す私は密接に協力しています"}, {"type": "subtitle", "time": 1732.95, "timestamp": "00:28:52", "text": "すべてと"}, {"type": "subtitle", "time": 1737.669, "timestamp": "00:28:57", "text": "えーっと、その他いろいろ。だから私は「わかった」と言って"}, {"type": "subtitle", "time": 1739.07, "timestamp": "00:28:59", "text": "えーっと"}]
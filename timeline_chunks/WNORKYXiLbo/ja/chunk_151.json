[{"type": "subtitle", "time": 9061.83, "timestamp": "02:31:01", "text": "はい、フォローします"}, {"type": "subtitle", "time": 9068.15, "timestamp": "02:31:08", "text": "あなたは主にYouTubeで配信活動をしている方ですね。"}, {"type": "subtitle", "time": 9070.469, "timestamp": "02:31:10", "text": "YouTube、Twitch、マルチリームと"}, {"type": "subtitle", "time": 9073.349, "timestamp": "02:31:13", "text": "実際、信じられるほどだ。"}, {"type": "subtitle", "time": 9076.55, "timestamp": "02:31:16", "text": "もう一度言ってください。ああ、配信してるよ。私"}, {"type": "subtitle", "time": 9078.79, "timestamp": "02:31:18", "text": "マルチリーム。つまり、YouTube、Twitch、そして"}, {"type": "subtitle", "time": 9080.87, "timestamp": "02:31:20", "text": "信じられる。わかった。あなたはまだ"}, {"type": "subtitle", "time": 9083.91, "timestamp": "02:31:23", "text": "どれをメインキャラとして使うのが好きか分かった？"}, {"type": "subtitle", "time": 9086.95, "timestamp": "02:31:26", "text": "えっと、ストリーミングを始めたのは"}, {"type": "subtitle", "time": 9092.07, "timestamp": "02:31:32", "text": "まずTwitch、それからえーと、それから私のほとんど"}, {"type": "subtitle", "time": 9094.469, "timestamp": "02:31:34", "text": "友達がYouTubeにいて、私は"}, {"type": "subtitle", "time": 9097.349, "timestamp": "02:31:37", "text": "Twitchで一人で配信中。私は「わかった、わかった」と思った。"}, {"type": "subtitle", "time": 9102.27, "timestamp": "02:31:42", "text": "YouTubeに行きます。それから私は"}, {"type": "subtitle", "time": 9106.55, "timestamp": "02:31:46", "text": "実際、彼女がスクリーンキャプチャを使っているのを見かけた。"}, {"type": "subtitle", "time": 9109.51, "timestamp": "02:31:49", "text": "これは、えーと、ビリーのためのものです"}, {"type": "subtitle", "time": 9112.309, "timestamp": "02:31:52", "text": "いじめっ子。そうそう。うん。えーと、これについては"}, {"type": "subtitle", "time": 9115.91, "timestamp": "02:31:55", "text": "フレーク。ええ、この旗の後です。"}, {"type": "subtitle", "time": 9118.15, "timestamp": "02:31:58", "text": "わかった。ほら、やってはいけないことは分かってるでしょ"}, {"type": "subtitle", "time": 9119.99, "timestamp": "02:31:59", "text": "画面キャプチャのことですよね？うん。うん。"}]
[{"type": "subtitle", "time": 3600.47, "timestamp": "01:00:00", "text": "[音楽]"}, {"type": "subtitle", "time": 3603.95, "timestamp": "01:00:03", "text": "ええ、私たちはたくさんのことを話していました"}, {"type": "subtitle", "time": 3607.349, "timestamp": "01:00:07", "text": "もの。こんにちは、シアリさん。ああ、なんてことだ、私は"}, {"type": "subtitle", "time": 3609.589, "timestamp": "01:00:09", "text": "コメントを読んでください。歓迎するのを忘れていました"}, {"type": "subtitle", "time": 3612.75, "timestamp": "01:00:12", "text": "あなた。ごめんなさい。ああ、"}, {"type": "subtitle", "time": 3619.91, "timestamp": "01:00:19", "text": "ディオ。お元気でお過ごしでしょうか。どうでしたか？"}, {"type": "subtitle", "time": 3621.75, "timestamp": "01:00:21", "text": "あなたの配信？あなたも配信していませんでしたか？"}, {"type": "subtitle", "time": 3626.069, "timestamp": "01:00:26", "text": "今日は漫画を描いていたと思いますよ。"}, {"type": "subtitle", "time": 3629.589, "timestamp": "01:00:29", "text": "ええ、あなたは漫画を描いていましたよね。ズキ"}, {"type": "subtitle", "time": 3632.43, "timestamp": "01:00:32", "text": "ピューピューMCOだった。"}, {"type": "subtitle", "time": 3636.309, "timestamp": "01:00:36", "text": "Shiは記念日配信をしていた。"}, {"type": "subtitle", "time": 3640.39, "timestamp": "01:00:40", "text": "他に誰が生中継に参加していましたか？カスピアンは生放送中だった。"}, {"type": "subtitle", "time": 3643.63, "timestamp": "01:00:43", "text": "うん、ハンナも生放送してるよね？"}, {"type": "chat", "time": 3652.66, "timestamp": "01:00:52", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "teehee"}]
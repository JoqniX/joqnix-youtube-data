[{"type": "subtitle", "time": 5461.79, "timestamp": "01:31:01", "text": "えっと、私のフィードにありました。"}, {"type": "subtitle", "time": 5465.229, "timestamp": "01:31:05", "text": "兄弟。彼女は落ちているのか？"}, {"type": "subtitle", "time": 5468.55, "timestamp": "01:31:08", "text": "これは何ですか？パワーレンジャー。ああ、それは"}, {"type": "subtitle", "time": 5471.07, "timestamp": "01:31:11", "text": "魔法のようだ。何"}, {"type": "subtitle", "time": 5486.31, "timestamp": "01:31:26", "text": "おお。それは魔法のようなセーラームーンです。待って、"}, {"type": "subtitle", "time": 5489.27, "timestamp": "01:31:29", "text": "セーラームーンの実写版があるの？"}, {"type": "subtitle", "time": 5494.83, "timestamp": "01:31:34", "text": "待って、まさか。私はこれを全く知りませんでした。"}, {"type": "subtitle", "time": 5496.91, "timestamp": "01:31:36", "text": "のように、"}, {"type": "subtitle", "time": 5501.39, "timestamp": "01:31:41", "text": "くそ。おお。そう、あのゲームね。"}, {"type": "subtitle", "time": 5503.47, "timestamp": "01:31:43", "text": "えっと、"}, {"type": "subtitle", "time": 5513.59, "timestamp": "01:31:53", "text": "それ？アカウントを変更する必要があると思う。"}, {"type": "subtitle", "time": 5516.229, "timestamp": "01:31:56", "text": "それは私のメインアカウントでの出来事でした。私は思う"}]
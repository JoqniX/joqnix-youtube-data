[{"type": "subtitle", "time": 16200.03, "timestamp": "04:30:00", "text": "私が"}, {"type": "subtitle", "time": 16202.63, "timestamp": "04:30:02", "text": "不思議に思った。ええ、その時私は"}, {"type": "subtitle", "time": 16206.95, "timestamp": "04:30:06", "text": "私のスキルセットを今すぐ見せたいので、"}, {"type": "subtitle", "time": 16208.95, "timestamp": "04:30:08", "text": "娯楽が不足していたので"}, {"type": "subtitle", "time": 16211.83, "timestamp": "04:30:11", "text": "私がストリーミングを始めたとき、私は"}, {"type": "subtitle", "time": 16215.91, "timestamp": "04:30:15", "text": "私はいつも真面目なタイプで、"}, {"type": "subtitle", "time": 16218.469, "timestamp": "04:30:18", "text": "ジョークの言い方も知らないから、ジョークすら言えない"}, {"type": "subtitle", "time": 16219.229, "timestamp": "04:30:19", "text": "に"}, {"type": "subtitle", "time": 16221.389, "timestamp": "04:30:21", "text": "ジョークか"}, {"type": "subtitle", "time": 16225.03, "timestamp": "04:30:25", "text": "えっと、ジョークを言うか、ジョークを理解する。それで"}, {"type": "subtitle", "time": 16227.75, "timestamp": "04:30:27", "text": "ユーモアというものはユーモアがない"}, {"type": "subtitle", "time": 16232.11, "timestamp": "04:30:32", "text": "私にとって。スキルセットに多くの不足がある"}, {"type": "subtitle", "time": 16235.67, "timestamp": "04:30:35", "text": "部門だから私はこう思った"}, {"type": "subtitle", "time": 16237.469, "timestamp": "04:30:37", "text": "私は一緒に行きます"}, {"type": "subtitle", "time": 16239.469, "timestamp": "04:30:39", "text": "革新的な技術"}, {"type": "subtitle", "time": 16242.51, "timestamp": "04:30:42", "text": "物事の流れの革新タイプ"}, {"type": "chat", "time": 16246.294, "timestamp": "04:30:46", "author": "@Anti-SpiritArt", "avatar": "https://yt4.ggpht.com/wYaIbwf481rN5bfgaxWnbUoh-faRynKzhqgZXK5WIvlx9DlMJJl0M6boNmqYwDkmuSY99pM-=s64-c-k-c0x00ffffff-no-rj", "message": "What are you going to study in japan?"}, {"type": "subtitle", "time": 16246.389, "timestamp": "04:30:46", "text": "あれ。だから私は最善を尽くした"}, {"type": "subtitle", "time": 16248.71, "timestamp": "04:30:48", "text": "このSammyソフトウェアを研究して、"}, {"type": "subtitle", "time": 16251.349, "timestamp": "04:30:51", "text": "ストリーミング配信とかそういう類のもの。ストリームボード"}, {"type": "subtitle", "time": 16253.75, "timestamp": "04:30:53", "text": "3年後にやってきた。ああ、サミー・レオリン"}, {"type": "subtitle", "time": 16256.91, "timestamp": "04:30:56", "text": "ボードは当時そこにありました"}]
[{"type": "subtitle", "time": 9543.429, "timestamp": "02:39:03", "text": "わかった、それはいいよ。うん。うん。うん。私"}, {"type": "subtitle", "time": 9546.75, "timestamp": "02:39:06", "text": "私はずっと3D VRをやってみたかったんです"}, {"type": "subtitle", "time": 9550.429, "timestamp": "02:39:10", "text": "あれ。うん、私も調べてみるべきだね"}, {"type": "subtitle", "time": 9553.75, "timestamp": "02:39:13", "text": "それ。うん。つまり、Slime VRは"}, {"type": "subtitle", "time": 9558.429, "timestamp": "02:39:18", "text": "MoPopのことですよね？えーと"}, {"type": "subtitle", "time": 9562.309, "timestamp": "02:39:22", "text": "サイズを考えると、おそらくそちらの方が良いでしょう"}, {"type": "subtitle", "time": 9565.59, "timestamp": "02:39:25", "text": "そして、その全てが便利な点も。ええ、それはとても"}, {"type": "subtitle", "time": 9568.55, "timestamp": "02:39:28", "text": "より小さく、はるかに使いやすい。しかし"}, {"type": "subtitle", "time": 9571.83, "timestamp": "02:39:31", "text": "開発の観点から言えば、Slime VRは"}, {"type": "subtitle", "time": 9573.11, "timestamp": "02:39:33", "text": "おそらく今後さらに発展するだろう"}, {"type": "subtitle", "time": 9575.67, "timestamp": "02:39:35", "text": "後々、さらなる改良が加えられる予定です。"}, {"type": "subtitle", "time": 9578.15, "timestamp": "02:39:38", "text": "ええと、彼らはすでに方法を見つけています"}, {"type": "subtitle", "time": 9581.51, "timestamp": "02:39:41", "text": "磁気ドリフトを防ぐ。その間、"}, {"type": "subtitle", "time": 9584.79, "timestamp": "02:39:44", "text": "えーと、モイはソフトウェアの修正をしています"}, {"type": "subtitle", "time": 9587.51, "timestamp": "02:39:47", "text": "ドリフトを修正することはできますが、できることには限界があります。"}, {"type": "subtitle", "time": 9589.83, "timestamp": "02:39:49", "text": "環境がソフトウェア修正である場合"}, {"type": "subtitle", "time": 9594.79, "timestamp": "02:39:54", "text": "それはひどいことだ。そうそう。ええと、MoPIは"}, {"type": "subtitle", "time": 9598.79, "timestamp": "02:39:58", "text": "干渉を受けやすい。"}]
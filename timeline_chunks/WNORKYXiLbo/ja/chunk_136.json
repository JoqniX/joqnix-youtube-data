[{"type": "subtitle", "time": 8161.069, "timestamp": "02:16:01", "text": "こんにちは、"}, {"type": "subtitle", "time": 8163.589, "timestamp": "02:16:03", "text": "T. こんにちは。こんにちは。ああ、ありがとう"}, {"type": "subtitle", "time": 8166.629, "timestamp": "02:16:06", "text": "褒め言葉でもある。"}, {"type": "subtitle", "time": 8168.47, "timestamp": "02:16:08", "text": "では、あなたのデザインのインスピレーションは何だったのでしょうか？私は"}, {"type": "subtitle", "time": 8171.51, "timestamp": "02:16:11", "text": "気に入ったよ。それはとてもパンクっぽいですね。"}, {"type": "subtitle", "time": 8174.229, "timestamp": "02:16:14", "text": "非常にゴシックパンク。"}, {"type": "subtitle", "time": 8178.55, "timestamp": "02:16:18", "text": "えーと、これは、えーと、これは"}, {"type": "subtitle", "time": 8182.189, "timestamp": "02:16:22", "text": "実際には、私の最初の"}, {"type": "subtitle", "time": 8186.95, "timestamp": "02:16:26", "text": "ジョックミックスの初期コンセプトデザイン。えっと"}, {"type": "subtitle", "time": 8189.83, "timestamp": "02:16:29", "text": "現在、新しいものを開発中です。えっと、でも"}, {"type": "subtitle", "time": 8192.709, "timestamp": "02:16:32", "text": "うん、これは私が望んでいたもの"}, {"type": "subtitle", "time": 8197.509, "timestamp": "02:16:37", "text": "クールになるには、うーん、わからない。えっと"}, {"type": "subtitle", "time": 8200.07, "timestamp": "02:16:40", "text": "最初はイヤリングなどは"}, {"type": "subtitle", "time": 8203.629, "timestamp": "02:16:43", "text": "もっとかっこよくなりたかったから"}, {"type": "subtitle", "time": 8206.95, "timestamp": "02:16:46", "text": "クールだね、だって、何人かの人が"}, {"type": "subtitle", "time": 8209.669, "timestamp": "02:16:49", "text": "ピアスやイヤリングをしている人、"}, {"type": "subtitle", "time": 8212.79, "timestamp": "02:16:52", "text": "良さそうですね。だから私は「わかった、"}, {"type": "subtitle", "time": 8215.15, "timestamp": "02:16:55", "text": "それらを追加してください。でも私は"}, {"type": "subtitle", "time": 8218.629, "timestamp": "02:16:58", "text": "星座。私は星座です。"}]
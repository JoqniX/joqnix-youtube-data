[{"type": "subtitle", "time": 7621.43, "timestamp": "02:07:01", "text": "入会を強要される。それはすべてを物語っている"}, {"type": "subtitle", "time": 7623.189, "timestamp": "02:07:03", "text": "もしあなたが本当に望むなら、イベント"}, {"type": "subtitle", "time": 7625.03, "timestamp": "02:07:05", "text": "本当に、あの頃のように"}, {"type": "subtitle", "time": 7627.189, "timestamp": "02:07:07", "text": "特別な人たちがここにいる。私たちにはメンターがいます"}, {"type": "subtitle", "time": 7629.51, "timestamp": "02:07:09", "text": "月曜日、それはもうすぐやってくる"}, {"type": "subtitle", "time": 7633.99, "timestamp": "02:07:13", "text": "週。えっと、今週末は丸々あるんだけど"}, {"type": "subtitle", "time": 7635.91, "timestamp": "02:07:15", "text": "たくさんのことでいっぱいの週"}, {"type": "subtitle", "time": 7638.149, "timestamp": "02:07:18", "text": "いろいろなもの。だから、心配しなくても"}, {"type": "subtitle", "time": 7640.629, "timestamp": "02:07:20", "text": "これらの日のうちの1日を逃すのは、"}, {"type": "subtitle", "time": 7642.55, "timestamp": "02:07:22", "text": "火曜日。"}, {"type": "subtitle", "time": 7643.75, "timestamp": "02:07:23", "text": "今日は火曜日だと思う。倍にさせてください"}, {"type": "subtitle", "time": 7646.629, "timestamp": "02:07:26", "text": "チェック。"}, {"type": "subtitle", "time": 7648.109, "timestamp": "02:07:28", "text": "これらをもう一度確認させてください"}, {"type": "subtitle", "time": 7651.47, "timestamp": "02:07:31", "text": "お知らせ。私は自分のことをしゃべりまくっているのかもしれない"}, {"type": "subtitle", "time": 7653.83, "timestamp": "02:07:33", "text": "お尻。いいえ、来週の火曜日までです。それで、"}, {"type": "subtitle", "time": 7656.149, "timestamp": "02:07:36", "text": "基本的に丸一週間。ああ、わかりました。"}, {"type": "subtitle", "time": 7658.149, "timestamp": "02:07:38", "text": "17日（土）から20日（日）まで。私たちは"}, {"type": "subtitle", "time": 7661.35, "timestamp": "02:07:41", "text": "たくさんの物を持っている。"}, {"type": "subtitle", "time": 7662.709, "timestamp": "02:07:42", "text": "だから、もし見逃しても気にしないでください。"}, {"type": "subtitle", "time": 7664.95, "timestamp": "02:07:44", "text": "あの頃は。私たちはそれをたくさん持っています。ああ、"}, {"type": "subtitle", "time": 7667.83, "timestamp": "02:07:47", "text": "わかった。"}, {"type": "subtitle", "time": 7677.99, "timestamp": "02:07:57", "text": "うん。ここ。ああ、彼らはあなたに、"}, {"type": "subtitle", "time": 7679.83, "timestamp": "02:07:59", "text": "もしあなたがそうしないなら、話すこと"}]
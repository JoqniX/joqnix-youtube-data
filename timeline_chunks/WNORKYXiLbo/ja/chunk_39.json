[{"type": "subtitle", "time": 2340.109, "timestamp": "00:39:00", "text": "いいえ。突然の私です。 CSはどうだった？"}, {"type": "subtitle", "time": 2343.069, "timestamp": "00:39:03", "text": "あまりにも？楽しかったですか？"}, {"type": "chat", "time": 2344.824, "timestamp": "00:39:04", "author": "@SuzukiZurikoVTuber", "avatar": "https://yt4.ggpht.com/852SZLheWUnfQGntgjphW0AD17oXLR9MhuzMLEzOm451wzhCllgmSUMTMpDu7wtBK7HSHR9J=s64-c-k-c0x00ffffff-no-rj", "message": "its fun"}, {"type": "subtitle", "time": 2345.63, "timestamp": "00:39:05", "text": "バカ？私たちはただのチットだった"}, {"type": "subtitle", "time": 2348.63, "timestamp": "00:39:08", "text": "チャット中。誰があなたを悲しませたのですか？いや、私たちは"}, {"type": "chat", "time": 2349.678, "timestamp": "00:39:09", "author": "@SuzukiZurikoVTuber", "avatar": "https://yt4.ggpht.com/852SZLheWUnfQGntgjphW0AD17oXLR9MhuzMLEzOm451wzhCllgmSUMTMpDu7wtBK7HSHR9J=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/hcMfY5_zAbbxvwKLooCoCA"}, {"type": "subtitle", "time": 2352.19, "timestamp": "00:39:12", "text": "ちょっと雑談してただけ"}, {"type": "subtitle", "time": 2356.31, "timestamp": "00:39:16", "text": "インドのメチューバーについて、えっと、"}, {"type": "subtitle", "time": 2358.829, "timestamp": "00:39:18", "text": "メチュービングの成長"}, {"type": "subtitle", "time": 2362.03, "timestamp": "00:39:22", "text": "インド。うん、ピューピューはどうだった？"}, {"type": "subtitle", "time": 2365.75, "timestamp": "00:39:25", "text": "CS:GO？楽しんでいただけたなら幸いです。私は私がしたことを見せる"}, {"type": "subtitle", "time": 2369.03, "timestamp": "00:39:29", "text": "ちょっとだけ覗いてみる。私が"}, {"type": "subtitle", "time": 2371.19, "timestamp": "00:39:31", "text": "夜間に誰が配信しているか確認中"}, {"type": "subtitle", "time": 2372.589, "timestamp": "00:39:32", "text": "そして私は見た"}, {"type": "subtitle", "time": 2376.23, "timestamp": "00:39:36", "text": "あなたもソミとして配信していましたね。その"}, {"type": "subtitle", "time": 2379.87, "timestamp": "00:39:39", "text": "どうやら私たちの3周年記念日のようです。"}, {"type": "subtitle", "time": 2382.99, "timestamp": "00:39:42", "text": "うん。見せる"}, {"type": "chat", "time": 2383.983, "timestamp": "00:39:43", "author": "@SuzukiZurikoVTuber", "avatar": "https://yt4.ggpht.com/852SZLheWUnfQGntgjphW0AD17oXLR9MhuzMLEzOm451wzhCllgmSUMTMpDu7wtBK7HSHR9J=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/zPgfY66lCJGRhL0Pz6iA4Aw i always raid u lol"}, {"type": "subtitle", "time": 2386.349, "timestamp": "00:39:46", "text": "終わり。うん。多くの人がストリーミング配信をしている"}, {"type": "subtitle", "time": 2388.03, "timestamp": "00:39:48", "text": "今。"}, {"type": "subtitle", "time": 2392.27, "timestamp": "00:39:52", "text": "BチャンネルのSさん、こんにちは。こんにちは、ようこそ"}, {"type": "subtitle", "time": 2397.15, "timestamp": "00:39:57", "text": "男。いつも君を襲撃してるよ（笑）。ありがとう"}]
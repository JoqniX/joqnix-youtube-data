[{"type": "subtitle", "time": 17173.948, "timestamp": "04:46:13", "text": "生き残る。彼は私にアンダースコアを言った"}, {"type": "subtitle", "time": 17176.43, "timestamp": "04:46:16", "text": "問題は"}, {"type": "subtitle", "time": 17179.15, "timestamp": "04:46:19", "text": "のような"}, {"type": "subtitle", "time": 17181.59, "timestamp": "04:46:21", "text": "正直、私の中にはそうしたくない部分もある"}, {"type": "subtitle", "time": 17185.75, "timestamp": "04:46:25", "text": "明らかにするよ、だってたとえ"}, {"type": "subtitle", "time": 17189.27, "timestamp": "04:46:29", "text": "日本のユーチューバーはたくさんいます、あるいは"}, {"type": "subtitle", "time": 17191.43, "timestamp": "04:46:31", "text": "アメリカの、ええと西洋のユーチューバーたちは"}, {"type": "subtitle", "time": 17193.19, "timestamp": "04:46:33", "text": "出身地を明かす"}, {"type": "subtitle", "time": 17196.708, "timestamp": "04:46:36", "text": "する人もいれば、しない人もいる"}, {"type": "subtitle", "time": 17199.51, "timestamp": "04:46:39", "text": "えっと、私はカリフォルニア出身です"}, {"type": "subtitle", "time": 17202.47, "timestamp": "04:46:42", "text": "州とかそんな感じ"}, {"type": "subtitle", "time": 17203.868, "timestamp": "04:46:43", "text": "えーっと"}, {"type": "subtitle", "time": 17206.75, "timestamp": "04:46:46", "text": "そうですね、私にとっては"}, {"type": "subtitle", "time": 17209.11, "timestamp": "04:46:49", "text": "知っているか何か、そう感じる"}, {"type": "subtitle", "time": 17213.03, "timestamp": "04:46:53", "text": "まるでプロイの侵略か何かみたいだ"}, {"type": "subtitle", "time": 17214.75, "timestamp": "04:46:54", "text": "プライバシーまたは"}, {"type": "subtitle", "time": 17217.91, "timestamp": "04:46:57", "text": "知らないことだけど、唯一の"}]
[{"type": "subtitle", "time": 10681.269, "timestamp": "02:58:01", "text": "もの。 「オーマイゴッド」って言いたくなる。した"}, {"type": "subtitle", "time": 10683.11, "timestamp": "02:58:03", "text": "私は壊れてしまう。ああ、神様。気をつけなければならない"}, {"type": "subtitle", "time": 10685.71, "timestamp": "02:58:05", "text": "このゴリラと一緒に。ゴリラではない。"}, {"type": "subtitle", "time": 10688.269, "timestamp": "02:58:08", "text": "えっと、グースネック"}, {"type": "subtitle", "time": 10695.429, "timestamp": "02:58:15", "text": "これを調整する必要があるのは、"}, {"type": "subtitle", "time": 10697.67, "timestamp": "02:58:17", "text": "携帯電話をどうやって置いたのかはわかりません"}, {"type": "subtitle", "time": 10700.19, "timestamp": "02:58:20", "text": "追跡するために"}, {"type": "subtitle", "time": 10703.349, "timestamp": "02:58:23", "text": "モデル。普通のスマホスタンドを使っているように"}, {"type": "subtitle", "time": 10706.269, "timestamp": "02:58:26", "text": "1つ。言い換えるとこうなります"}, {"type": "subtitle", "time": 10708.91, "timestamp": "02:58:28", "text": "これ。追跡していますか？"}, {"type": "subtitle", "time": 10716.429, "timestamp": "02:58:36", "text": "こんにちは。待って。ああ、追跡していない"}, {"type": "subtitle", "time": 10722.23, "timestamp": "02:58:42", "text": "自分。おい。おい。おい。おい。"}, {"type": "subtitle", "time": 10725.71, "timestamp": "02:58:45", "text": "私はあなたにとって関係ありますか、それとも"}, {"type": "subtitle", "time": 10727.389, "timestamp": "02:58:47", "text": "何か？"}]
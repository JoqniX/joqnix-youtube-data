[{"type": "subtitle", "time": 9300.15, "timestamp": "02:35:00", "text": "それは基本的に、人々に手を振るだけのことだ。"}, {"type": "subtitle", "time": 9313.429, "timestamp": "02:35:13", "text": "それで、チューブ遊びはどれくらい続けているんですか？おお、"}, {"type": "subtitle", "time": 9315.59, "timestamp": "02:35:15", "text": "うん。もうそろそろ終わりですよね？あなたは"}, {"type": "subtitle", "time": 9319.429, "timestamp": "02:35:19", "text": "それを修正するために。うん。それは心配なことだ。いや、違う"}, {"type": "subtitle", "time": 9323.03, "timestamp": "02:35:23", "text": "長すぎる、というか2年くらいかな。えっと、でも私は"}, {"type": "subtitle", "time": 9324.87, "timestamp": "02:35:24", "text": "時々YouTuberになるんだけど、実は"}, {"type": "subtitle", "time": 9326.469, "timestamp": "02:35:26", "text": "30種類ほどの適度な"}, {"type": "subtitle", "time": 9328.79, "timestamp": "02:35:28", "text": "YouTuber。だから、普段は配信はしていません。"}, {"type": "subtitle", "time": 9330.71, "timestamp": "02:35:30", "text": "私は普段、モデレーターを務めています。実際、私は"}, {"type": "subtitle", "time": 9332.71, "timestamp": "02:35:32", "text": "私の右側にあるスクリーンで、"}, {"type": "subtitle", "time": 9334.309, "timestamp": "02:35:34", "text": "実際には他人の面倒を見ている"}, {"type": "subtitle", "time": 9337.67, "timestamp": "02:35:37", "text": "現在チャット中です。だからあなたは私を見ない"}, {"type": "subtitle", "time": 9341.11, "timestamp": "02:35:41", "text": "ストリーミング配信中。うん。でも私は"}, {"type": "subtitle", "time": 9344.389, "timestamp": "02:35:44", "text": "私自身も、彼らが手伝う準備ができています"}, {"type": "subtitle", "time": 9347.91, "timestamp": "02:35:47", "text": "尋ねたことはありますか。だから、私が誰かを助けるなら"}, {"type": "subtitle", "time": 9349.51, "timestamp": "02:35:49", "text": "中程度の人は、「ねえ、私は"}, {"type": "subtitle", "time": 9351.03, "timestamp": "02:35:51", "text": "これをやってください。どうやってやるんですか？"}, {"type": "subtitle", "time": 9352.79, "timestamp": "02:35:52", "text": "「よし、こうやってやるんだ」"}, {"type": "subtitle", "time": 9355.91, "timestamp": "02:35:55", "text": "なぜなら、私には経験があるからです。"}, {"type": "subtitle", "time": 9358.389, "timestamp": "02:35:58", "text": "そしてこうして、私は確信している"}]
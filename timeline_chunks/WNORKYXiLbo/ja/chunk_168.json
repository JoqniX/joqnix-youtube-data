[{"type": "subtitle", "time": 10081.55, "timestamp": "02:48:01", "text": "くそ、それは"}, {"type": "subtitle", "time": 10085.03, "timestamp": "02:48:05", "text": "いいね。彼らはスピードチャット機能を持っている。"}, {"type": "subtitle", "time": 10087.19, "timestamp": "02:48:07", "text": "兄弟。彼らはスピードチャットをしていて"}, {"type": "subtitle", "time": 10089.49, "timestamp": "02:48:09", "text": "もの。"}, {"type": "subtitle", "time": 10095.75, "timestamp": "02:48:15", "text": "クレイジー。私は本当に"}, {"type": "subtitle", "time": 10100.469, "timestamp": "02:48:20", "text": "自己紹介文を書いて、自分が何をしているのかを説明しよう。"}, {"type": "chat", "time": 10101.564, "timestamp": "02:48:21", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "yeah if you turn that setting off"}, {"type": "subtitle", "time": 10103.51, "timestamp": "02:48:23", "text": "モデルを見ると、"}, {"type": "subtitle", "time": 10108.469, "timestamp": "02:48:28", "text": "ある意味、この髪はあなたに"}, {"type": "chat", "time": 10109.121, "timestamp": "02:48:29", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "theres probably more people"}, {"type": "subtitle", "time": 10118.389, "timestamp": "02:48:38", "text": "雰囲気。どれ？もしあなたが、もしあなたが"}, {"type": "subtitle", "time": 10120.07, "timestamp": "02:48:40", "text": "その設定を考えると、"}, {"type": "subtitle", "time": 10123.389, "timestamp": "02:48:43", "text": "おそらくスピードを好む人が多い"}, {"type": "subtitle", "time": 10127.269, "timestamp": "02:48:47", "text": "チャット。ええ、私のはもうオフになっていました。だから、"}, {"type": "chat", "time": 10129.239, "timestamp": "02:48:49", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "yep"}, {"type": "subtitle", "time": 10130.99, "timestamp": "02:48:50", "text": "スピードチャットの場合、"}, {"type": "subtitle", "time": 10136.07, "timestamp": "02:48:56", "text": "2人用で、"}, {"type": "subtitle", "time": 10138.23, "timestamp": "02:48:58", "text": "スピードチャットモード。でも私の電源は切れていました。"}]
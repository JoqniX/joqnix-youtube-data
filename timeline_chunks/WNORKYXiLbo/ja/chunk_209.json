[{"type": "subtitle", "time": 12542.429, "timestamp": "03:29:02", "text": "クリエイティブで全て"}, {"type": "subtitle", "time": 12548.91, "timestamp": "03:29:08", "text": "うん、サムネイルああ"}, {"type": "subtitle", "time": 12551.91, "timestamp": "03:29:11", "text": "いいえ。なぜできないのか"}, {"type": "subtitle", "time": 12564.95, "timestamp": "03:29:24", "text": "私は実際に戻って、"}, {"type": "subtitle", "time": 12567.11, "timestamp": "03:29:27", "text": "すべてを見る、見るように探す"}, {"type": "subtitle", "time": 12569.19, "timestamp": "03:29:29", "text": "ジョアソンのすべてのストリームを通して、そして"}, {"type": "subtitle", "time": 12571.83, "timestamp": "03:29:31", "text": "実際にサムネイルを更新してください。私は思う"}, {"type": "subtitle", "time": 12574.03, "timestamp": "03:29:34", "text": "いつか必ずやるよ。"}, {"type": "subtitle", "time": 12576.349, "timestamp": "03:29:36", "text": "わかった。"}, {"type": "subtitle", "time": 12579.67, "timestamp": "03:29:39", "text": "えっと、待って。その日曜日はもうすぐ来るはずだ。おお"}, {"type": "subtitle", "time": 12583.75, "timestamp": "03:29:43", "text": "神。えーと、今月は"}, {"type": "subtitle", "time": 12586.15, "timestamp": "03:29:46", "text": "コラボレーションのために毎日予約を入れています。試す"}, {"type": "subtitle", "time": 12588.83, "timestamp": "03:29:48", "text": "人々ができるだけ多くを得る"}, {"type": "subtitle", "time": 12593.19, "timestamp": "03:29:53", "text": "可能。ええと、今は誰もが自由なわけではありません。"}, {"type": "subtitle", "time": 12595.59, "timestamp": "03:29:55", "text": "今日、誰もが都合がつくかどうかはそれぞれ異なります。"}]
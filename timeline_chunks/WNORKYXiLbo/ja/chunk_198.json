[{"type": "subtitle", "time": 11882.19, "timestamp": "03:18:02", "text": "うん、"}, {"type": "subtitle", "time": 11884.67, "timestamp": "03:18:04", "text": "ええと、私たちは"}, {"type": "chat", "time": 11888.148, "timestamp": "03:18:08", "author": "@baebae8403", "avatar": "https://yt4.ggpht.com/OdCljOM7Z-IW-aduSOxmr7dLa3EadW4Esy80MxUu6e5ZFoEtOrbG5Sn-Ar2tm7N25BpvPHou=s64-c-k-c0x00ffffff-no-rj", "message": "UCdZBnUb7m8Pd_wUTDNqUu3Q/PVfsZ8LuIYCO_9EPt-GMgAwUCdZBnUb7m8Pd_wUTDNqUu3Q/PVfsZ8LuIYCO_9EPt-GMgAwUCdZBnUb7m8Pd_wUTDNqUu3Q/PVfsZ8LuIYCO_9EPt-GMgAw"}, {"type": "subtitle", "time": 11888.75, "timestamp": "03:18:08", "text": "コラボすると、"}, {"type": "subtitle", "time": 11891.99, "timestamp": "03:18:11", "text": "コラボレーションの発表"}, {"type": "subtitle", "time": 11894.63, "timestamp": "03:18:14", "text": "ハプニング。だから人々はそれに名前をつけたのだ。それ"}, {"type": "subtitle", "time": 11898.07, "timestamp": "03:18:18", "text": "スケジュールチャンネルに掲載されます。わかった。"}, {"type": "subtitle", "time": 11899.309, "timestamp": "03:18:19", "text": "それは"}, {"type": "subtitle", "time": 11902.87, "timestamp": "03:18:22", "text": "動的埋め込み。編集されます"}, {"type": "subtitle", "time": 11905.59, "timestamp": "03:18:25", "text": "いつも。"}, {"type": "subtitle", "time": 11908.67, "timestamp": "03:18:28", "text": "変更があるかどうかによります"}, {"type": "subtitle", "time": 11911.59, "timestamp": "03:18:31", "text": "など。ああ、もし私がこれをやるべきだったのに。"}, {"type": "subtitle", "time": 11913.99, "timestamp": "03:18:33", "text": "以前は、手伝ってくれる人がいれば"}, {"type": "subtitle", "time": 11917.11, "timestamp": "03:18:37", "text": "私には、何人かのモデレーターがいたと思います"}, {"type": "subtitle", "time": 11919.63, "timestamp": "03:18:39", "text": "助けて。でも私は"}, {"type": "subtitle", "time": 11923.91, "timestamp": "03:18:43", "text": "その時は自分のことに集中して"}, {"type": "subtitle", "time": 11925.229, "timestamp": "03:18:45", "text": "私は"}, {"type": "subtitle", "time": 11929.63, "timestamp": "03:18:49", "text": "助けを求めるのが怖い"}, {"type": "subtitle", "time": 11932.95, "timestamp": "03:18:52", "text": "あまり知らない"}, {"type": "subtitle", "time": 11936.429, "timestamp": "03:18:56", "text": "ウェブフックのようなもの"}, {"type": "subtitle", "time": 11939.51, "timestamp": "03:18:59", "text": "あれこれと検証すること、すべて。"}]
[{"type": "subtitle", "time": 8462.95, "timestamp": "02:21:02", "text": "ええ、実際にそういうことがありました。私は好きでした"}, {"type": "subtitle", "time": 8465.75, "timestamp": "02:21:05", "text": "ええと、何人かのユーチューバーと会いました"}, {"type": "subtitle", "time": 8468.15, "timestamp": "02:21:08", "text": "私の友人たちは実際に見た"}, {"type": "subtitle", "time": 8469.75, "timestamp": "02:21:09", "text": "それ。"}, {"type": "subtitle", "time": 8471.91, "timestamp": "02:21:11", "text": "うん。彼らは「ああ、合ってるね」って感じ。"}, {"type": "subtitle", "time": 8475.91, "timestamp": "02:21:15", "text": "わーい。おい。うん。では、もう一方の方はどうでしたか？"}, {"type": "subtitle", "time": 8478.79, "timestamp": "02:21:18", "text": "日？順調に進んでいます。作った"}, {"type": "subtitle", "time": 8480.87, "timestamp": "02:21:20", "text": "アカウント、すべてのボタンで遊んでいます、"}, {"type": "subtitle", "time": 8483.67, "timestamp": "02:21:23", "text": "新しいことを学び、それがどのように"}, {"type": "subtitle", "time": 8486.55, "timestamp": "02:21:26", "text": "すべて順調です。配信の調子はどうですか？おお、"}, {"type": "subtitle", "time": 8489.11, "timestamp": "02:21:29", "text": "順調です。私はこれを試していました"}, {"type": "subtitle", "time": 8492.23, "timestamp": "02:21:32", "text": "ウェブチャット。実際に緊張した"}, {"type": "subtitle", "time": 8494.07, "timestamp": "02:21:34", "text": "人々と話しますが、ええ、それは"}, {"type": "subtitle", "time": 8496.87, "timestamp": "02:21:36", "text": "今のところは順調です。"}, {"type": "subtitle", "time": 8499.27, "timestamp": "02:21:39", "text": "ええ、みんな大抵は"}, {"type": "subtitle", "time": 8500.95, "timestamp": "02:21:40", "text": "かなりクールな部分だ。"}, {"type": "subtitle", "time": 8502.87, "timestamp": "02:21:42", "text": "かなり広範囲に及ぶようです"}, {"type": "subtitle", "time": 8507.349, "timestamp": "02:21:47", "text": "年齢層が幅広いので、いつも楽しいです。はい、"}, {"type": "subtitle", "time": 8514.07, "timestamp": "02:21:54", "text": "えっと、タイマーみたいなものがあるのに気付いたんだけど"}, {"type": "subtitle", "time": 8516.63, "timestamp": "02:21:56", "text": "あれ。人々がそれを持っているからでしょうか"}, {"type": "subtitle", "time": 8519.67, "timestamp": "02:21:59", "text": "電源を入れた？うん。それで、私は"}]
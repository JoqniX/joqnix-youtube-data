[{"type": "subtitle", "time": 18360.55, "timestamp": "05:06:00", "text": "私のチャットと彼女のチャットがあるので、"}, {"type": "subtitle", "time": 18364.43, "timestamp": "05:06:04", "text": "私たち二人が一緒にいるところを見て、"}, {"type": "subtitle", "time": 18367.07, "timestamp": "05:06:07", "text": "そういう感じですね。いいえ"}, {"type": "subtitle", "time": 18369.628, "timestamp": "05:06:09", "text": "心配事。えっと"}, {"type": "subtitle", "time": 18373.15, "timestamp": "05:06:13", "text": "ああ、だって今はもうしたくないから"}, {"type": "subtitle", "time": 18377.43, "timestamp": "05:06:17", "text": "がっかりする。がっかりさせたくない。"}, {"type": "subtitle", "time": 18379.59, "timestamp": "05:06:19", "text": "問題は、私はまだ"}, {"type": "subtitle", "time": 18382.23, "timestamp": "05:06:22", "text": "私のコミュニティを構築していますが、彼らはそうではありません。"}, {"type": "subtitle", "time": 18386.43, "timestamp": "05:06:26", "text": "誰でも来て何かできる"}, {"type": "subtitle", "time": 18388.868, "timestamp": "05:06:28", "text": "そして時には誰もいないこともある"}, {"type": "subtitle", "time": 18391.43, "timestamp": "05:06:31", "text": "チャットもするよ。大丈夫です。でも私は"}, {"type": "subtitle", "time": 18393.91, "timestamp": "05:06:33", "text": "それを理解する。私は十分忍耐強い。その"}, {"type": "subtitle", "time": 18397.51, "timestamp": "05:06:37", "text": "大丈夫。しかし、"}, {"type": "subtitle", "time": 18400.23, "timestamp": "05:06:40", "text": "他人の目から見れば、いいえ。ええと、もし彼らが"}, {"type": "chat", "time": 18401.373, "timestamp": "05:06:41", "author": "@Anti-SpiritArt", "avatar": "https://yt4.ggpht.com/wYaIbwf481rN5bfgaxWnbUoh-faRynKzhqgZXK5WIvlx9DlMJJl0M6boNmqYwDkmuSY99pM-=s64-c-k-c0x00ffffff-no-rj", "message": "btw i also played REPO with Xeno"}, {"type": "subtitle", "time": 18401.47, "timestamp": "05:06:41", "text": "感じる"}, {"type": "subtitle", "time": 18405.43, "timestamp": "05:06:45", "text": "もし彼らが、ああ、これは"}, {"type": "subtitle", "time": 18407.67, "timestamp": "05:06:47", "text": "良いコラボレーションだったけど、チャットが少なかった"}, {"type": "subtitle", "time": 18410.788, "timestamp": "05:06:50", "text": "婚約とかそういうの、それから、えっと、"}, {"type": "subtitle", "time": 18413.51, "timestamp": "05:06:53", "text": "痛み。いいえ。ところで、私はレポをプレイしました"}, {"type": "subtitle", "time": 18417.43, "timestamp": "05:06:57", "text": "ゼノン。そうそう。ゼノは、ある部分について意見を述べる"}]
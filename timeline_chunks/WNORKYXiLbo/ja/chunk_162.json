[{"type": "subtitle", "time": 9723.67, "timestamp": "02:42:03", "text": "クレイジー。デニスは何してるの？"}, {"type": "subtitle", "time": 9726.07, "timestamp": "02:42:06", "text": "すると息子が言った、「いや、これは僕が持ってきたんだ」"}, {"type": "subtitle", "time": 9728.95, "timestamp": "02:42:08", "text": "捕獲前。うん。あ、待って。あ、待って。"}, {"type": "subtitle", "time": 9731.63, "timestamp": "02:42:11", "text": "自分のモデルがアップロードされていないことに今気づきました"}, {"type": "subtitle", "time": 9735.67, "timestamp": "02:42:15", "text": "配信されていません。何？何？いや。いや。何？"}, {"type": "subtitle", "time": 9738.91, "timestamp": "02:42:18", "text": "そうすることは日没を意味するのか？いいえ。"}, {"type": "subtitle", "time": 9741.91, "timestamp": "02:42:21", "text": "このプレイキャプチャ機能について。私は必要としている"}, {"type": "subtitle", "time": 9743.95, "timestamp": "02:42:23", "text": "変更する"}, {"type": "subtitle", "time": 9748.469, "timestamp": "02:42:28", "text": "それ。それを変えなければならない。私 私 私"}, {"type": "subtitle", "time": 9751.11, "timestamp": "02:42:31", "text": "文字通り、私の持ち物を見せてください。私の"}, {"type": "subtitle", "time": 9753.03, "timestamp": "02:42:33", "text": "ファイル。"}, {"type": "chat", "time": 9755.338, "timestamp": "02:42:35", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "yeah probably"}, {"type": "subtitle", "time": 9756.19, "timestamp": "02:42:36", "text": "それは良くない。ええ、そうです"}, {"type": "subtitle", "time": 9758.19, "timestamp": "02:42:38", "text": "悪い。その"}, {"type": "subtitle", "time": 9762.23, "timestamp": "02:42:42", "text": "悪い。私は怖かった。そしてそれは私を怖がらせた"}, {"type": "subtitle", "time": 9765.389, "timestamp": "02:42:45", "text": "けれど。えっと、それは私を怖がらせました"}, {"type": "subtitle", "time": 9769.27, "timestamp": "02:42:49", "text": "VCの件について。私は怖くなった。私"}, {"type": "subtitle", "time": 9770.71, "timestamp": "02:42:50", "text": "「待って、この声はどこ？」"}, {"type": "subtitle", "time": 9773.309, "timestamp": "02:42:53", "text": "どこから来たの？私は見ているのか"}, {"type": "subtitle", "time": 9776.55, "timestamp": "02:42:56", "text": "「ストリーム？」そして私は見ました"}]
[{"type": "subtitle", "time": 18122.31, "timestamp": "05:02:02", "text": "5月24日午後7時30分5月24日。私たちは"}, {"type": "subtitle", "time": 18124.15, "timestamp": "05:02:04", "text": "初め"}, {"type": "subtitle", "time": 18128.07, "timestamp": "05:02:08", "text": "えっと、VCのやつに電話する"}, {"type": "subtitle", "time": 18137.31, "timestamp": "05:02:17", "text": "えーと、24日に"}, {"type": "subtitle", "time": 18141.51, "timestamp": "05:02:21", "text": "3月、そう、私たちはこうだった"}, {"type": "subtitle", "time": 18143.67, "timestamp": "05:02:23", "text": "休暇を取る予定だったので"}, {"type": "subtitle", "time": 18146.55, "timestamp": "05:02:26", "text": "家族と3日間"}, {"type": "subtitle", "time": 18148.15, "timestamp": "05:02:28", "text": "えっと、ご存知かどうかわかりませんが"}, {"type": "subtitle", "time": 18150.39, "timestamp": "05:02:30", "text": "ヴァランガニという場所ですね。"}, {"type": "subtitle", "time": 18154.55, "timestamp": "05:02:34", "text": "彼らは家族がやったように"}, {"type": "subtitle", "time": 18159.67, "timestamp": "05:02:39", "text": "何かお供え物か何か。だから、もし"}, {"type": "subtitle", "time": 18163.43, "timestamp": "05:02:43", "text": "テナントの人々は今、再入居のためにやって来ます"}, {"type": "subtitle", "time": 18165.83, "timestamp": "05:02:45", "text": "商業スペースでそれが"}, {"type": "subtitle", "time": 18168.788, "timestamp": "05:02:48", "text": "撮影され、最後に人々がやって来る"}, {"type": "subtitle", "time": 18173.19, "timestamp": "05:02:53", "text": "私たち家族は、訪問して"}, {"type": "subtitle", "time": 18175.83, "timestamp": "05:02:55", "text": "物など"}, {"type": "subtitle", "time": 18177.91, "timestamp": "05:02:57", "text": "ええ、ある意味では、彼らはそうしなかった"}]
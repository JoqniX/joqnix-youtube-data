[{"type": "subtitle", "time": 9001.07, "timestamp": "02:30:01", "text": "自分自身。おお、いいね。でも、"}, {"type": "subtitle", "time": 9003.91, "timestamp": "02:30:03", "text": "正しい道に進んではいけない。よし、これでいい。うん。"}, {"type": "subtitle", "time": 9009.389, "timestamp": "02:30:09", "text": "まるでDIYみたいですよね？うん。"}, {"type": "subtitle", "time": 9012.389, "timestamp": "02:30:12", "text": "ニース。だから、もしあなたが壊してしまったら"}, {"type": "subtitle", "time": 9015.83, "timestamp": "02:30:15", "text": "回路図は、"}, {"type": "subtitle", "time": 9018.63, "timestamp": "02:30:18", "text": "修理キットですよね？えっと、私はただ"}, {"type": "subtitle", "time": 9020.389, "timestamp": "02:30:20", "text": "おそらく新しい部品を注文するでしょう。"}, {"type": "subtitle", "time": 9023.59, "timestamp": "02:30:23", "text": "キットは届きませんでした。生のものを食べた"}, {"type": "subtitle", "time": 9025.19, "timestamp": "02:30:25", "text": "回路基板をはんだ付けしました"}, {"type": "subtitle", "time": 9027.51, "timestamp": "02:30:27", "text": "一緒に。おお。はい、どうぞ。待てます"}, {"type": "subtitle", "time": 9034.63, "timestamp": "02:30:34", "text": "バッテリーを単体で購入したからです。"}, {"type": "subtitle", "time": 9038.469, "timestamp": "02:30:38", "text": "それはただの電線だった。マグネトーを買いました"}, {"type": "subtitle", "time": 9041.75, "timestamp": "02:30:41", "text": "球状のもの、BMOS回路"}, {"type": "subtitle", "time": 9045.83, "timestamp": "02:30:45", "text": "マザーボードのチップと充電基板。"}, {"type": "subtitle", "time": 9048.309, "timestamp": "02:30:48", "text": "なぜ？"}, {"type": "subtitle", "time": 9051.429, "timestamp": "02:30:51", "text": "星座の星を点と結ぶことで"}, {"type": "subtitle", "time": 9058.55, "timestamp": "02:30:58", "text": "ドット。フォローしてくれてありがとう。"}]
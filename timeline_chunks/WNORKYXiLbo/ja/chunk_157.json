[{"type": "subtitle", "time": 9423.19, "timestamp": "02:37:03", "text": "こんにちは。今ならできる。"}, {"type": "subtitle", "time": 9425.429, "timestamp": "02:37:05", "text": "うん。"}, {"type": "subtitle", "time": 9427.27, "timestamp": "02:37:07", "text": "本当に？右側にトラッカーが1つだけ付いています"}, {"type": "subtitle", "time": 9429.91, "timestamp": "02:37:09", "text": "まだストラップを作っていないので"}, {"type": "subtitle", "time": 9433.11, "timestamp": "02:37:13", "text": "まだそれらを自分自身に結びつけていない。おお。"}, {"type": "subtitle", "time": 9435.11, "timestamp": "02:37:15", "text": "ああ、だからあなたはそれを保持しなければならない"}, {"type": "subtitle", "time": 9437.349, "timestamp": "02:37:17", "text": "いつも。ええ、ただ持っているだけです"}, {"type": "subtitle", "time": 9439.83, "timestamp": "02:37:19", "text": "私の手の中に。"}, {"type": "subtitle", "time": 9441.99, "timestamp": "02:37:21", "text": "でも名前を付ける必要はないんじゃない？"}, {"type": "subtitle", "time": 9444.389, "timestamp": "02:37:24", "text": "これがあなたの権利だとわかるようにラベルを貼ってください"}, {"type": "subtitle", "time": 9447.349, "timestamp": "02:37:27", "text": "そういうハンドトラッカーのこと？うん、そうするよ"}, {"type": "subtitle", "time": 9449.03, "timestamp": "02:37:29", "text": "いずれはそうしなければならない。私はただ"}, {"type": "subtitle", "time": 9451.59, "timestamp": "02:37:31", "text": "はんだ付けが終わった。えっと、それで私は"}, {"type": "subtitle", "time": 9453.99, "timestamp": "02:37:33", "text": "私がやったことは、ランダムなトラッカーを拾ったことです"}, {"type": "subtitle", "time": 9455.83, "timestamp": "02:37:35", "text": "それはたまたま私の足で、"}, {"type": "subtitle", "time": 9458.79, "timestamp": "02:37:38", "text": "それを腕に移動させた。"}, {"type": "subtitle", "time": 9460.15, "timestamp": "02:37:40", "text": "少し前にご覧になったかどうかわかりませんが"}, {"type": "subtitle", "time": 9461.349, "timestamp": "02:37:41", "text": "友達と話していたとき"}, {"type": "subtitle", "time": 9463.75, "timestamp": "02:37:43", "text": "私のAR脚は宙に浮いているような感じだった。"}, {"type": "subtitle", "time": 9466.71, "timestamp": "02:37:46", "text": "ええ、確かに見ましたよ。はい。それは"}, {"type": "subtitle", "time": 9468.389, "timestamp": "02:37:48", "text": "間違ったトラッカーを取ってしまったので"}, {"type": "subtitle", "time": 9470.07, "timestamp": "02:37:50", "text": "まだ割り当てていないと思っていたのですが"}, {"type": "subtitle", "time": 9472.07, "timestamp": "02:37:52", "text": "これが私が最後に置いたものだから"}, {"type": "subtitle", "time": 9475.11, "timestamp": "02:37:55", "text": "一緒に。うん。"}, {"type": "subtitle", "time": 9477.83, "timestamp": "02:37:57", "text": "うん。えっと、もしあなたがしたいなら、"}]
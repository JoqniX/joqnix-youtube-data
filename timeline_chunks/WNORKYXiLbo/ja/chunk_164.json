[{"type": "subtitle", "time": 9843.309, "timestamp": "02:44:03", "text": "適応した私は実際に"}, {"type": "subtitle", "time": 9850.99, "timestamp": "02:44:10", "text": "適応しました。私は実際に"}, {"type": "subtitle", "time": 9852.91, "timestamp": "02:44:12", "text": "適応しました。"}, {"type": "subtitle", "time": 9855.83, "timestamp": "02:44:15", "text": "えっと、私は実際に話すことに慣れました"}, {"type": "subtitle", "time": 9858.269, "timestamp": "02:44:18", "text": "見知らぬ人たち。うん。"}, {"type": "subtitle", "time": 9860.03, "timestamp": "02:44:20", "text": "さよなら。"}, {"type": "subtitle", "time": 9869.71, "timestamp": "02:44:29", "text": "赤の良いところは"}, {"type": "subtitle", "time": 9871.309, "timestamp": "02:44:31", "text": "いいえ"}, {"type": "subtitle", "time": 9875.429, "timestamp": "02:44:35", "text": "それらのどれも、それらのほとんどが"}, {"type": "subtitle", "time": 9878.349, "timestamp": "02:44:38", "text": "みんな落ち着いていて"}, {"type": "subtitle", "time": 9883.83, "timestamp": "02:44:43", "text": "親切で、失礼な人はいませんでした。"}, {"type": "subtitle", "time": 9887.55, "timestamp": "02:44:47", "text": "あるいは何か、そしてそれは"}, {"type": "subtitle", "time": 9890.83, "timestamp": "02:44:50", "text": "良いですね、それは"}]
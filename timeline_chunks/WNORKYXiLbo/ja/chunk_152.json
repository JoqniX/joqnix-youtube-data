[{"type": "subtitle", "time": 9124.87, "timestamp": "02:32:04", "text": "うん。わかった。だってそうだから。人々は"}, {"type": "subtitle", "time": 9126.15, "timestamp": "02:32:06", "text": "ストリーミングを開始し、彼らは使用しています"}, {"type": "subtitle", "time": 9127.83, "timestamp": "02:32:07", "text": "画面キャプチャと回数"}, {"type": "subtitle", "time": 9129.75, "timestamp": "02:32:09", "text": "うっかり個人情報を漏らしてしまった人を見たことがあります"}, {"type": "subtitle", "time": 9133.23, "timestamp": "02:32:13", "text": "彼ら自身は、ある意味"}, {"type": "subtitle", "time": 9136.15, "timestamp": "02:32:16", "text": "うん。そうそう。ええと、その話が出たので"}, {"type": "subtitle", "time": 9138.79, "timestamp": "02:32:18", "text": "話題について、どう思いますか？"}, {"type": "subtitle", "time": 9140.87, "timestamp": "02:32:20", "text": "YouTuberが"}, {"type": "subtitle", "time": 9142.79, "timestamp": "02:32:22", "text": "ファイルなどを見せてください"}, {"type": "subtitle", "time": 9147.83, "timestamp": "02:32:27", "text": "中立的なもののように個人情報が漏洩することはない？"}, {"type": "subtitle", "time": 9150.55, "timestamp": "02:32:30", "text": "それは中立的なもののようなものですか？"}, {"type": "subtitle", "time": 9153.03, "timestamp": "02:32:33", "text": "例えば、"}, {"type": "subtitle", "time": 9155.95, "timestamp": "02:32:35", "text": "自分のストリームを編集しているか、"}, {"type": "subtitle", "time": 9158.469, "timestamp": "02:32:38", "text": "何か。だから、もしあなたが"}, {"type": "subtitle", "time": 9160.95, "timestamp": "02:32:40", "text": "その操作を行う際の画面キャプチャ"}, {"type": "subtitle", "time": 9163.51, "timestamp": "02:32:43", "text": "ファイルや物を見せてください、"}, {"type": "subtitle", "time": 9167.27, "timestamp": "02:32:47", "text": "あなたは思う？それは良いことなのか、悪いことなのか？悪い"}, {"type": "subtitle", "time": 9169.27, "timestamp": "02:32:49", "text": "いつ行くことになるかわからないから"}, {"type": "subtitle", "time": 9170.95, "timestamp": "02:32:50", "text": "うっかりして、うっかり見せてしまう"}, {"type": "subtitle", "time": 9173.91, "timestamp": "02:32:53", "text": "同じもの"}, {"type": "subtitle", "time": 9176.469, "timestamp": "02:32:56", "text": "場所。ああ、そうだね。持っていない限り"}, {"type": "subtitle", "time": 9178.87, "timestamp": "02:32:5
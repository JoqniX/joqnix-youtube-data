[{"type": "subtitle", "time": 10322.389, "timestamp": "02:52:02", "text": "何でもいい。でも、私はまだ"}, {"type": "subtitle", "time": 10324.71, "timestamp": "02:52:04", "text": "研削。"}, {"type": "subtitle", "time": 10326.79, "timestamp": "02:52:06", "text": "そしてそれは私を幸せにしてくれた、"}, {"type": "subtitle", "time": 10327.79, "timestamp": "02:52:07", "text": "知る、"}, {"type": "subtitle", "time": 10330.87, "timestamp": "02:52:10", "text": "実は。えっと、彼らは私の調子はどうですかと尋ねて、"}, {"type": "subtitle", "time": 10333.19, "timestamp": "02:52:13", "text": "すべて。大丈夫ですか？そして、"}, {"type": "subtitle", "time": 10341.87, "timestamp": "02:52:21", "text": "今。"}, {"type": "subtitle", "time": 10345.07, "timestamp": "02:52:25", "text": "うん。ああ、それが私を"}, {"type": "subtitle", "time": 10348.87, "timestamp": "02:52:28", "text": "ハッピー。持続する。"}, {"type": "subtitle", "time": 10351.91, "timestamp": "02:52:31", "text": "ええと、特に私が"}, {"type": "subtitle", "time": 10355.23, "timestamp": "02:52:35", "text": "最も心配なこと"}, {"type": "subtitle", "time": 10358.75, "timestamp": "02:52:38", "text": "神の方が優れている"}, {"type": "subtitle", "time": 10360.83, "timestamp": "02:52:40", "text": "ツイッター。"}, {"type": "subtitle", "time": 10364.99, "timestamp": "02:52:44", "text": "えっと、私は幼児のことについてもっと心配しています"}, {"type": "subtitle", "time": 10379.469, "timestamp": "02:52:59", "text": "知らないよ"}]
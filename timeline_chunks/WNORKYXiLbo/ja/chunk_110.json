[{"type": "subtitle", "time": 6604.669, "timestamp": "01:50:04", "text": "良い。あなたのお気に入りは何ですか？"}, {"type": "subtitle", "time": 6611.51, "timestamp": "01:50:11", "text": "兄弟？彼らは本当に待って、彼らは"}, {"type": "subtitle", "time": 6615.149, "timestamp": "01:50:15", "text": "えっと、ちょっと待って、自分で確認してもいいですか？"}, {"type": "subtitle", "time": 6639.47, "timestamp": "01:50:39", "text": "と"}, {"type": "subtitle", "time": 6643.87, "timestamp": "01:50:43", "text": "もちろんGはそこにいないよ、兄弟"}, {"type": "subtitle", "time": 6645.47, "timestamp": "01:50:45", "text": "なぜなぜ"}, {"type": "subtitle", "time": 6649.59, "timestamp": "01:50:49", "text": "彼女がユーチューバーと見なされる理由だよ、兄弟。"}]
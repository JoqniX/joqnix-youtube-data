[{"type": "subtitle", "time": 16022.229, "timestamp": "04:27:02", "text": "私が恐れていることは、"}, {"type": "subtitle", "time": 16024.309, "timestamp": "04:27:04", "text": "私が別の国にいるからというだけで、"}, {"type": "subtitle", "time": 16025.95, "timestamp": "04:27:05", "text": "インドではそうではない"}, {"type": "subtitle", "time": 16036.03, "timestamp": "04:27:16", "text": "私は依然としてインド人として知られるだろう"}, {"type": "subtitle", "time": 16038.75, "timestamp": "04:27:18", "text": "しかし"}, {"type": "subtitle", "time": 16043.63, "timestamp": "04:27:23", "text": "ええ、たとえ私が日本語で話しても、"}, {"type": "subtitle", "time": 16045.87, "timestamp": "04:27:25", "text": "3ヶ国語対応 いいえ"}, {"type": "subtitle", "time": 16059.67, "timestamp": "04:27:39", "text": "ああ、待って、ウィルはとても痛い。今"}, {"type": "subtitle", "time": 16061.91, "timestamp": "04:27:41", "text": "私はあのホロライフタイプを成功させなければならない"}, {"type": "chat", "time": 16063.532, "timestamp": "04:27:43", "author": "@Anti-SpiritArt", "avatar": "https://yt4.ggpht.com/wYaIbwf481rN5bfgaxWnbUoh-faRynKzhqgZXK5WIvlx9DlMJJl0M6boNmqYwDkmuSY99pM-=s64-c-k-c0x00ffffff-no-rj", "message": "So you are going to japan permanently"}, {"type": "subtitle", "time": 16065.03, "timestamp": "04:27:45", "text": "クレイジーなことを見ていると、"}, {"type": "subtitle", "time": 16067.83, "timestamp": "04:27:47", "text": "オリー、彼女がどうするのか理解できるよ"}, {"type": "subtitle", "time": 16070.229, "timestamp": "04:27:50", "text": "英語のような3言語のもの、"}, {"type": "subtitle", "time": 16072.63, "timestamp": "04:27:52", "text": "インドネシア語と日本語。彼女は改宗する"}, {"type": "subtitle", "time": 16075.349, "timestamp": "04:27:55", "text": "彼女は話すこと全てを3つの言語で話す。"}, {"type": "subtitle", "time": 16077.189, "timestamp": "04:27:57", "text": "だからクローズドキャプションは必要ない、"}, {"type": "subtitle", "time": 16079.83, "timestamp": "04:27:59", "text": "配信に字幕が表示されます。彼女は手動で"}]
[{"type": "subtitle", "time": 720.55, "timestamp": "00:12:00", "text": "次に仮想のものが多くありました"}, {"type": "subtitle", "time": 730.55, "timestamp": "00:12:10", "text": "そうだと思うよ。つまり、数年後には"}, {"type": "subtitle", "time": 733.67, "timestamp": "00:12:13", "text": "真剣な人や"}, {"type": "subtitle", "time": 736.23, "timestamp": "00:12:16", "text": "今ここにいる人たちはみんな"}, {"type": "subtitle", "time": 738.23, "timestamp": "00:12:18", "text": "現在そこにいるユーチューバーたち"}, {"type": "subtitle", "time": 740.31, "timestamp": "00:12:20", "text": "最善を尽くすと、彼らは切り替えるだろう"}, {"type": "subtitle", "time": 742.389, "timestamp": "00:12:22", "text": "になる"}, {"type": "subtitle", "time": 744.99, "timestamp": "00:12:24", "text": "もっと"}, {"type": "subtitle", "time": 755.23, "timestamp": "00:12:35", "text": "うん、時間がかかるだろうね。"}, {"type": "subtitle", "time": 758.79, "timestamp": "00:12:38", "text": "15回から20回もかかったこと"}, {"type": "subtitle", "time": 762.47, "timestamp": "00:12:42", "text": "私のオーマイゴッドのために完全にピムパスをトリガーします"}, {"type": "subtitle", "time": 765.43, "timestamp": "00:12:45", "text": "うん、それは本当に難しいことだよ。"}, {"type": "subtitle", "time": 766.59, "timestamp": "00:12:46", "text": "事実"}, {"type": "subtitle", "time": 770.79, "timestamp": "00:12:50", "text": "ほとんどのインド人ユーチューバー"}, {"type": "subtitle", "time": 774.269, "timestamp": "00:12:54", "text": "彼らは自分たちで作ろうとする"}, {"type": "subtitle", "time": 777.03, "timestamp": "00:12:57", "text": "モデル学習ライブ任務、学習方法"}, {"type": "subtitle", "time": 778.35, "timestamp": "00:12:58", "text": "描くことと"}]
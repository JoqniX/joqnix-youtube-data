[{"type": "subtitle", "time": 1861.99, "timestamp": "00:31:01", "text": "Twitterとウェブサイト最近私は"}, {"type": "subtitle", "time": 1864.51, "timestamp": "00:31:04", "text": "わあ、シンガポールに"}, {"type": "subtitle", "time": 1867.59, "timestamp": "00:31:07", "text": "YouTuberコミュニティとウェブサイト、そして"}, {"type": "subtitle", "time": 1871.31, "timestamp": "00:31:11", "text": "Twitterやイベントも開催しています"}, {"type": "subtitle", "time": 1877.909, "timestamp": "00:31:17", "text": "うん、誰かが"}, {"type": "subtitle", "time": 1880.71, "timestamp": "00:31:20", "text": "他の人がやります。私はしたくない、私はしたくない"}, {"type": "subtitle", "time": 1884.07, "timestamp": "00:31:24", "text": "これ以上関わりたくないのは、"}, {"type": "subtitle", "time": 1885.789, "timestamp": "00:31:25", "text": "感じる"}, {"type": "subtitle", "time": 1889.35, "timestamp": "00:31:29", "text": "すでに多くのことを成し遂げたが、"}, {"type": "subtitle", "time": 1896.47, "timestamp": "00:31:36", "text": "外。私はコミュニティが形成される過程を目撃した。こんな感じ"}, {"type": "subtitle", "time": 1898.59, "timestamp": "00:31:38", "text": "私は火傷するだろう"}, {"type": "subtitle", "time": 1903.509, "timestamp": "00:31:43", "text": "下。これに関しては多くのことがあり、"}, {"type": "subtitle", "time": 1904.269, "timestamp": "00:31:44", "text": "私は"}, {"type": "subtitle", "time": 1907.95, "timestamp": "00:31:47", "text": "うん"}, {"type": "subtitle", "time": 1912.83, "timestamp": "00:31:52", "text": "には、もっと誰かが必要だ"}, {"type": "subtitle", "time": 1916.07, "timestamp": "00:31:56", "text": "えっと、何て呼ぶんですか？まるで誰かが"}, {"type": "subtitle", "time": 1919.669, "timestamp": "00:31:59", "text": "どちらがより優れたリーダーであり、指導者であるか。それは"}]
[{"type": "subtitle", "time": 8101.75, "timestamp": "02:15:01", "text": "ぼやけてる？インターネットのやつですよね？"}, {"type": "subtitle", "time": 8103.51, "timestamp": "02:15:03", "text": "でも、私の場合はほとんどぼやけている"}, {"type": "subtitle", "time": 8105.109, "timestamp": "02:15:05", "text": "1分間だけ。だから私はただ幸せです"}, {"type": "subtitle", "time": 8111.91, "timestamp": "02:15:11", "text": "さあ、今日はどんな一日でしたか？君が"}, {"type": "subtitle", "time": 8114.39, "timestamp": "02:15:14", "text": "今日は楽しんでいますか？"}, {"type": "subtitle", "time": 8116.709, "timestamp": "02:15:16", "text": "今日はなかなか良い一日だった。私はこれを試しています"}, {"type": "subtitle", "time": 8119.03, "timestamp": "02:15:19", "text": "初めて外出する。私は今まで"}, {"type": "subtitle", "time": 8121.35, "timestamp": "02:15:21", "text": "これをやった。うーん、見た目はかっこよくて"}, {"type": "subtitle", "time": 8124.149, "timestamp": "02:15:24", "text": "時々試してみる、といった感じですね。えっと、私は"}, {"type": "subtitle", "time": 8126.069, "timestamp": "02:15:26", "text": "私はよくやった。朝食を作った。私は"}, {"type": "subtitle", "time": 8128.31, "timestamp": "02:15:28", "text": "犬をトイレに連れ出す。だから今はただ"}, {"type": "subtitle", "time": 8132.069, "timestamp": "02:15:32", "text": "ここ。さあ行こう。うん。私も試しています"}, {"type": "subtitle", "time": 8135.35, "timestamp": "02:15:35", "text": "それを出す。私はとても怖かった、"}, {"type": "subtitle", "time": 8138.47, "timestamp": "02:15:38", "text": "えっと、初めてなんですが、"}, {"type": "subtitle", "time": 8141.39, "timestamp": "02:15:41", "text": "私にとっては話すのが難しい"}, {"type": "subtitle", "time": 8144.79, "timestamp": "02:15:44", "text": "人々はそう思っていたが、私はやり遂げた。あなたは誰と話していますか？"}, {"type": "subtitle", "time": 8146.629, "timestamp": "02:15:46", "text": "私はとても元気で、実際私は"}, {"type": "subtitle", "time": 8149.47, "timestamp": "02:15:49", "text": "学校。"}, {"type": "subtitle", "time": 8153.91, "timestamp": "02:15:53", "text": "うん。それで、あなたは今どうやって生きているのですか？"}, {"type": "subtitle", "time": 8156.55, "timestamp": "02:15:56", "text": "いいえ、私は生放送中です。私のチャットでは、"}, {"type": "subtitle", "time": 8159.589, "timestamp": "02:15:59", "text": "彼らはあなたの目がとても美しいと思っています。"}]
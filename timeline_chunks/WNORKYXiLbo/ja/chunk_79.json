[{"type": "subtitle", "time": 4742.709, "timestamp": "01:19:02", "text": "リストのような、または紹介されているような"}, {"type": "subtitle", "time": 4743.55, "timestamp": "01:19:03", "text": "1"}, {"type": "subtitle", "time": 4746.149, "timestamp": "01:19:06", "text": "考えなければならないデータベース"}, {"type": "subtitle", "time": 4748.55, "timestamp": "01:19:08", "text": "パキスタンのユーチューバー、バングラデシュ"}, {"type": "subtitle", "time": 4750.87, "timestamp": "01:19:10", "text": "YouTuberや他の人たちと同じように"}, {"type": "subtitle", "time": 4753.75, "timestamp": "01:19:13", "text": "周辺諸国も含め"}, {"type": "subtitle", "time": 4756.87, "timestamp": "01:19:16", "text": "ネパールのユーチューバーなど。いいえ、あなたは"}, {"type": "subtitle", "time": 4762.47, "timestamp": "01:19:22", "text": "えーっと、カテゴリのカテゴリを取得する"}, {"type": "subtitle", "time": 4765.07, "timestamp": "01:19:25", "text": "人々のリストのように"}, {"type": "subtitle", "time": 4767.43, "timestamp": "01:19:27", "text": "あまりにも。でもよく考えてみると、私は"}, {"type": "subtitle", "time": 4775.35, "timestamp": "01:19:35", "text": "まだ。バングラデシュのユーチューバーたち。ええ、ただ"}, {"type": "subtitle", "time": 4778.03, "timestamp": "01:19:38", "text": "3人、4人くらいしかいない"}, {"type": "subtitle", "time": 4781.189, "timestamp": "01:19:41", "text": "5時頃。私がコラボレーションしたパキスタン人"}, {"type": "subtitle", "time": 4784.709, "timestamp": "01:19:44", "text": "と。えっと、私はコラボしたと思います"}, {"type": "subtitle", "time": 4788.229, "timestamp": "01:19:48", "text": "３つですね、３つあります。"}, {"type": "subtitle", "time": 4792.47, "timestamp": "01:19:52", "text": "私が見た3人を除いて、他の人たちの周りにいるのを見た"}, {"type": "subtitle", "time": 4796.59, "timestamp": "01:19:56", "text": "2つくらいで5つくらい見ました"}]
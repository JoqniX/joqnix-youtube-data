[{"type": "subtitle", "time": 12900.389, "timestamp": "03:35:00", "text": "うん、犬は車庫にいるよ"}, {"type": "subtitle", "time": 12902.389, "timestamp": "03:35:02", "text": "あれ。ええと、でも、後ろの席に着いてください"}, {"type": "subtitle", "time": 12904.229, "timestamp": "03:35:04", "text": "そこが入り口です。使わなければならない"}, {"type": "subtitle", "time": 12906.79, "timestamp": "03:35:06", "text": "トイレとかそういうもの。私は自分の"}, {"type": "subtitle", "time": 12908.79, "timestamp": "03:35:08", "text": "家の中に入る唯一の方法は裏口から"}, {"type": "subtitle", "time": 12911.59, "timestamp": "03:35:11", "text": "祖母の物置への入り口。全て"}, {"type": "subtitle", "time": 12914.59, "timestamp": "03:35:14", "text": "私はすべての"}, {"type": "subtitle", "time": 12918.79, "timestamp": "03:35:18", "text": "家の正面にある門を移動します"}, {"type": "chat", "time": 12920.616, "timestamp": "03:35:20", "author": "@Anti-SpiritArt", "avatar": "https://yt4.ggpht.com/wYaIbwf481rN5bfgaxWnbUoh-faRynKzhqgZXK5WIvlx9DlMJJl0M6boNmqYwDkmuSY99pM-=s64-c-k-c0x00ffffff-no-rj", "message": "you have your phone she can just make a call right"}, {"type": "subtitle", "time": 12922.229, "timestamp": "03:35:22", "text": "などなど。うん、ゲートが2つあって、それから行く"}, {"type": "subtitle", "time": 12926.15, "timestamp": "03:35:26", "text": "バイクが2秒目までずっと"}, {"type": "subtitle", "time": 12929.19, "timestamp": "03:35:29", "text": "ガレージ。そこは自動車修理工場だったと言ってもいいでしょう。"}, {"type": "subtitle", "time": 12932.87, "timestamp": "03:35:32", "text": "しかし、トップの人々にとって2番目は"}, {"type": "subtitle", "time": 12935.11, "timestamp": "03:35:35", "text": "それを商業的なものにしたとき、"}, {"type": "subtitle", "time": 12938.229, "timestamp": "03:35:38", "text": "駐車場用の2台目の車を作った"}, {"type": "subtitle", "time": 12941.51, "timestamp": "03:35:41", "text": "などなど。だから、今ではそれを"}, {"type": "subtitle", "time": 12942.91, "timestamp": "03:35:42", "text": "自転車"}, {"type": "subtitle", "time": 12946.63, "timestamp": "03:35:46", "text": "ガレージには家族の車があり、私の"}, {"type": "subtitle", "time": 12948.63, "timestamp": "03:35:48", "text": "スクーターと、父の自転車のようなもの"}, {"type": "subtitle", "time": 12950.63, "timestamp": "03:35:50", "text": "全て揃っている。ということで、"}, {"type": "subtitle", "time": 12952.67, "timestamp": "03:35:52", "text": "そこから戻る道"}, {"type": "subtitle", "time": 12954.51, "timestamp": "03:35:54", "text": "入り口ですが"}, {"type": "subtitle", "time": 12957.03, "timestamp": "03:35:57", "text": "声を上げるには、あなたに電話するだけでいい"}, {"type": "subtitle", "time": 12959.91, "timestamp": "03:35:59", "text": "右。でも、お母さんのこととなると、えーと、"}]
[{"type": "subtitle", "time": 5163.51, "timestamp": "01:26:03", "text": "うん。彼女は本当に素晴らしい。コラボレーションしたい"}, {"type": "subtitle", "time": 5165.0, "timestamp": "01:26:05", "text": "しかし"}, {"type": "subtitle", "time": 5166.75, "timestamp": "01:26:06", "text": "[音楽]"}, {"type": "subtitle", "time": 5169.51, "timestamp": "01:26:09", "text": "のみ。うん。私は自分の"}, {"type": "subtitle", "time": 5173.149, "timestamp": "01:26:13", "text": "日本人だよ、男。日本語を学ばなければならない"}, {"type": "subtitle", "time": 5175.83, "timestamp": "01:26:15", "text": "きちんと。彼女は活動的な人でもある。する"}, {"type": "subtitle", "time": 5178.47, "timestamp": "01:26:18", "text": "アイアナは配信したり、配信時間を過ごしたりします"}, {"type": "subtitle", "time": 5182.39, "timestamp": "01:26:22", "text": "タイミングも良く、または彼女の別のチャンネルでも"}, {"type": "subtitle", "time": 5184.43, "timestamp": "01:26:24", "text": "として"}, {"type": "subtitle", "time": 5187.43, "timestamp": "01:26:27", "text": "チャネル。これも楽しいですね。ええ、彼女は"}, {"type": "subtitle", "time": 5189.229, "timestamp": "01:26:29", "text": "2週間生存"}, {"type": "subtitle", "time": 5191.149, "timestamp": "01:26:31", "text": "前。それは"}, {"type": "subtitle", "time": 5203.59, "timestamp": "01:26:43", "text": "彼女の番組。"}, {"type": "subtitle", "time": 5205.87, "timestamp": "01:26:45", "text": "しかし、このGoogleリストは"}, {"type": "subtitle", "time": 5211.39, "timestamp": "01:26:51", "text": "良い。分析、画像、その他多数"}, {"type": "subtitle", "time": 5217.39, "timestamp": "01:26:57", "text": "[音楽]"}]
[{"type": "subtitle", "time": 7987.03, "timestamp": "02:13:07", "text": "あ、こんにちは。こんにちは。"}, {"type": "subtitle", "time": 7989.91, "timestamp": "02:13:09", "text": "こんにちは。こんにちは。こんにちは。今日はどんな一日でしたか？ああ、私の"}, {"type": "subtitle", "time": 7993.27, "timestamp": "02:13:13", "text": "今日はいい一日だ。今日はどんな一日でしたか？"}, {"type": "subtitle", "time": 7995.589, "timestamp": "02:13:15", "text": "今日はとても順調です。感謝"}, {"type": "subtitle", "time": 7999.589, "timestamp": "02:13:19", "text": "あなた。何してるの？私は私は"}, {"type": "subtitle", "time": 8001.669, "timestamp": "02:13:21", "text": "初めてこのポップチャットを試してみます"}, {"type": "subtitle", "time": 8004.589, "timestamp": "02:13:24", "text": "時間。それで、えーと"}, {"type": "subtitle", "time": 8008.39, "timestamp": "02:13:28", "text": "ええ、私も配信をしていますよ。"}, {"type": "subtitle", "time": 8011.669, "timestamp": "02:13:31", "text": "あなたもこの電話を使うのは初めてですか？"}, {"type": "subtitle", "time": 8013.99, "timestamp": "02:13:33", "text": "ええ、これが私にとって初めてのことです"}, {"type": "subtitle", "time": 8016.95, "timestamp": "02:13:36", "text": "アプリ。今のところ、特に予定はありません。"}, {"type": "subtitle", "time": 8019.51, "timestamp": "02:13:39", "text": "順調に進んでいます。しかしチャットは"}, {"type": "chat", "time": 8022.776, "timestamp": "02:13:42", "author": "@baebae8403", "avatar": "https://yt4.ggpht.com/OdCljOM7Z-IW-aduSOxmr7dLa3EadW4Esy80MxUu6e5ZFoEtOrbG5Sn-Ar2tm7N25BpvPHou=s64-c-k-c0x00ffffff-no-rj", "message": "she has a nice sword"}, {"type": "subtitle", "time": 8023.149, "timestamp": "02:13:43", "text": "なんていうか、よくわからない。とても小さい"}, {"type": "subtitle", "time": 8028.189, "timestamp": "02:13:48", "text": "チャット中。時間が経つのは本当に早い。ああ、"}, {"type": "subtitle", "time": 8032.069, "timestamp": "02:13:52", "text": "うん。方向転換する方法があると思う"}, {"type": "subtitle", "time": 8036.79, "timestamp": "02:13:56", "text": "オフとか、そういうことですよね？よくわからない。"}, {"type": "subtitle", "time": 8039.43, "timestamp": "02:13:59", "text": "あ、待って。タイマーが切れそうです。初め"}]
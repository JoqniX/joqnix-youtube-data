[{"type": "subtitle", "time": 12842.07, "timestamp": "03:34:02", "text": "9か10くらいからだと思うけど、"}, {"type": "subtitle", "time": 12845.349, "timestamp": "03:34:05", "text": "今週か来週。この3番目のえーと"}, {"type": "subtitle", "time": 12847.99, "timestamp": "03:34:07", "text": "2番目の部分、前部の人々"}, {"type": "subtitle", "time": 12852.15, "timestamp": "03:34:12", "text": "彼らが来て引っ越しを始める"}, {"type": "subtitle", "time": 12855.03, "timestamp": "03:34:15", "text": "プロセス。だからトップ2位は1位"}, {"type": "subtitle", "time": 12858.71, "timestamp": "03:34:18", "text": "1階。ここにいるのは私一人だけです。うん、"}, {"type": "subtitle", "time": 12861.11, "timestamp": "03:34:21", "text": "そういう意味で、私は夜に叫ぶことができる"}, {"type": "chat", "time": 12862.743, "timestamp": "03:34:22", "author": "@Anti-SpiritArt", "avatar": "https://yt4.ggpht.com/wYaIbwf481rN5bfgaxWnbUoh-faRynKzhqgZXK5WIvlx9DlMJJl0M6boNmqYwDkmuSY99pM-=s64-c-k-c0x00ffffff-no-rj", "message": "yeah you are not the only one who had peoblames saying my names belive it or not🤣"}, {"type": "subtitle", "time": 12863.429, "timestamp": "03:34:23", "text": "なぜなら、弁護士たちは"}, {"type": "subtitle", "time": 12866.469, "timestamp": "03:34:26", "text": "10時に出発します。だから10年後には"}, {"type": "subtitle", "time": 12868.19, "timestamp": "03:34:28", "text": "実際に叫ぶ"}, {"type": "subtitle", "time": 12871.75, "timestamp": "03:34:31", "text": "悲鳴。私は誰にも迷惑をかけません。しかし"}, {"type": "subtitle", "time": 12874.95, "timestamp": "03:34:34", "text": "ええ、階下で、今は"}, {"type": "subtitle", "time": 12879.03, "timestamp": "03:34:39", "text": "1階の部屋から出るために"}, {"type": "subtitle", "time": 12883.55, "timestamp": "03:34:43", "text": "階段のようなエントがある"}, {"type": "subtitle", "time": 12887.67, "timestamp": "03:34:47", "text": "何かだけど、外からのものみたいに"}, {"type": "subtitle", "time": 12889.429, "timestamp": "03:34:49", "text": "私の家には階段があります。それで"}, {"type": "subtitle", "time": 12891.79, "timestamp": "03:34:51", "text": "私は降りなければならない"}, {"type": "subtitle", "time": 12894.63, "timestamp": "03:34:54", "text": "階段を上って裏口へ"}, {"type": "subtitle", "time": 12897.91, "timestamp": "03:34:57", "text": "私の祖母の部屋では、"}]
[{"type": "subtitle", "time": 8401.99, "timestamp": "02:20:01", "text": "行く。私は今までに３人と話しました。ああ、"}, {"type": "subtitle", "time": 8405.55, "timestamp": "02:20:05", "text": "神。私は外向的な性格ですか？私は秘密ですか"}, {"type": "subtitle", "time": 8408.71, "timestamp": "02:20:08", "text": "外向的？とんでもない。私は秘密ですか"}, {"type": "subtitle", "time": 8411.99, "timestamp": "02:20:11", "text": "外向的な人だね？私は実際に話しているんです。"}, {"type": "subtitle", "time": 8419.99, "timestamp": "02:20:19", "text": "とんでもない。とんでもない。私の君主はどうしたの？"}, {"type": "subtitle", "time": 8437.19, "timestamp": "02:20:37", "text": "今日は宇宙系YouTuberの皆さん、こんにちは。"}, {"type": "subtitle", "time": 8440.07, "timestamp": "02:20:40", "text": "こんにちは。はじめまして。お会いできて嬉しいです"}, {"type": "subtitle", "time": 8443.51, "timestamp": "02:20:43", "text": "あなたも。私はあの3つのホクロが大好きです。"}, {"type": "subtitle", "time": 8447.03, "timestamp": "02:20:47", "text": "ありがとう。ええ、私も持っています。"}, {"type": "subtitle", "time": 8449.75, "timestamp": "02:20:49", "text": "そこで、それを組み込むことを考えました"}, {"type": "subtitle", "time": 8452.95, "timestamp": "02:20:52", "text": "私のモデルも同様です。"}, {"type": "subtitle", "time": 8454.309, "timestamp": "02:20:54", "text": "あなたはまるでミーティングにいるような気分になるでしょう"}, {"type": "subtitle", "time": 8455.91, "timestamp": "02:20:55", "text": "挨拶すると誰かがこう言うだろう、"}, {"type": "subtitle", "time": 8459.19, "timestamp": "02:20:59", "text": "「あなただ。」"}]
[{"type": "subtitle", "time": 7276.669, "timestamp": "02:01:16", "text": "ダッキー、信じて"}, {"type": "subtitle", "time": 7292.31, "timestamp": "02:01:32", "text": "これ。あなたが「簡単」という言葉を使ったからですか？私は"}, {"type": "subtitle", "time": 7297.79, "timestamp": "02:01:37", "text": "[音楽]"}, {"type": "subtitle", "time": 7301.07, "timestamp": "02:01:41", "text": "ああ、わかった。ヘッドホンをつけさせてください"}, {"type": "subtitle", "time": 7303.87, "timestamp": "02:01:43", "text": "きちんと。座らせてください"}]
[{"type": "subtitle", "time": 12301.83, "timestamp": "03:25:01", "text": "電話をかけた、話をした、話した"}, {"type": "subtitle", "time": 12306.429, "timestamp": "03:25:06", "text": "そして今、この旅で出会った"}, {"type": "subtitle", "time": 12309.99, "timestamp": "03:25:09", "text": "計画と自由な時間"}, {"type": "subtitle", "time": 12314.87, "timestamp": "03:25:14", "text": "入手可能性は非常に厄介で、"}, {"type": "subtitle", "time": 12317.19, "timestamp": "03:25:17", "text": "えっと、数えたくないんです"}, {"type": "subtitle", "time": 12320.229, "timestamp": "03:25:20", "text": "グループ活動、グループコラボレーション、そして"}, {"type": "subtitle", "time": 12322.469, "timestamp": "03:25:22", "text": "グループの色は数えられますが、"}, {"type": "subtitle", "time": 12324.36, "timestamp": "03:25:24", "text": "感じる"}, {"type": "subtitle", "time": 12331.269, "timestamp": "03:25:31", "text": "えっと、私はこうする方が良いと思います"}, {"type": "subtitle", "time": 12334.309, "timestamp": "03:25:34", "text": "オープンVCのやつですよね？うん。あなた"}, {"type": "subtitle", "time": 12336.83, "timestamp": "03:25:36", "text": "何だと思う？明日、私はそれをやるつもりだ"}, {"type": "subtitle", "time": 12340.269, "timestamp": "03:25:40", "text": "朝。何があっても、私は"}, {"type": "subtitle", "time": 12342.03, "timestamp": "03:25:42", "text": "それ。"}, {"type": "subtitle", "time": 12345.51, "timestamp": "03:25:45", "text": "うん。こんにちは。 3時30分です。私はただ"}, {"type": "subtitle", "time": 12348.51, "timestamp": "03:25:48", "text": "寝る。私は実際に階下へ降りて食事をします"}, {"type": "subtitle", "time": 12351.67, "timestamp": "03:25:51", "text": "何か飲んで、お茶を飲んで、寝て、"}, {"type": "subtitle", "time": 12354.55, "timestamp": "03:25:54", "text": "寝る。だって紅茶、ブラックティーは私を"}, {"type": "subtitle", "time": 12356.75, "timestamp": "03:25:56", "text": "夜寝るときに眠くなる"}, {"type": "subtitle", "time": 12359.269, "timestamp": "03:25:59", "text": "実際、私はそれをずっとやってきたから"}]
[{"type": "subtitle", "time": 7862.43, "timestamp": "02:11:02", "text": "イアン側の友人たち"}, {"type": "subtitle", "time": 7865.83, "timestamp": "02:11:05", "text": "YouTuber。私はインド人のユーチューバーなので"}, {"type": "subtitle", "time": 7869.27, "timestamp": "02:11:09", "text": "YouTuberにこだわり続ける。だから難しい"}, {"type": "subtitle", "time": 7872.79, "timestamp": "02:11:12", "text": "友達を作るために、私は"}, {"type": "subtitle", "time": 7875.91, "timestamp": "02:11:15", "text": "乗り込んで「うん」って感じ。"}, {"type": "subtitle", "time": 7878.31, "timestamp": "02:11:18", "text": "ええ、間違いなくそうです。楽しいですよ。"}, {"type": "subtitle", "time": 7880.709, "timestamp": "02:11:20", "text": "ええ、間違いなくそうです。試してみることをお勧めします"}, {"type": "subtitle", "time": 7882.39, "timestamp": "02:11:22", "text": "えっと、もしお時間があれば、今週の土曜日に。もし"}, {"type": "subtitle", "time": 7884.47, "timestamp": "02:11:24", "text": "いいえ、火曜日までずっとです。それで、"}, {"type": "subtitle", "time": 7888.229, "timestamp": "02:11:28", "text": "機会があればいつでも。はい。"}, {"type": "subtitle", "time": 7889.75, "timestamp": "02:11:29", "text": "しかし、今日だけは"}, {"type": "subtitle", "time": 7891.589, "timestamp": "02:11:31", "text": "誰とマッチングできるか見てみましょう"}, {"type": "subtitle", "time": 7895.75, "timestamp": "02:11:35", "text": "気軽に乗り込んでください、心配いりません。"}, {"type": "subtitle", "time": 7901.109, "timestamp": "02:11:41", "text": "この新しいネット上の雑談って何？"}, {"type": "subtitle", "time": 7905.109, "timestamp": "02:11:45", "text": "それは、人々が"}, {"type": "subtitle", "time": 7908.229, "timestamp": "02:11:48", "text": "ああ、誰がウェブチャットグループに参加しているんだ"}, {"type": "subtitle", "time": 7913.51, "timestamp": "02:11:53", "text": "チャット？うん。わあ、それはすごくクールだね。"}, {"type": "subtitle", "time": 7917.189, "timestamp": "02:11:57", "text": "今、誰かいますか？ああ、わかりました。こんにちは。"}]
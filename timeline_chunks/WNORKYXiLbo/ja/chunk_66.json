[{"type": "subtitle", "time": 3961.349, "timestamp": "01:06:01", "text": "兄弟、だから私の一部は"}, {"type": "subtitle", "time": 3963.87, "timestamp": "01:06:03", "text": "積極的にポータルを使いたいのですが、"}, {"type": "subtitle", "time": 3966.63, "timestamp": "01:06:06", "text": "クリエイターが自分のものを持つのは良いことだ"}, {"type": "subtitle", "time": 3970.75, "timestamp": "01:06:10", "text": "グッズストアか何か無料のもの"}, {"type": "subtitle", "time": 3974.15, "timestamp": "01:06:14", "text": "すべてだけど、そう、それは"}, {"type": "subtitle", "time": 3977.51, "timestamp": "01:06:17", "text": "それも私にとっては欲しい、私は計画する"}, {"type": "subtitle", "time": 3979.63, "timestamp": "01:06:19", "text": "その他のもの"}, {"type": "subtitle", "time": 3988.12, "timestamp": "01:06:28", "text": "はい、メンバーページを表示します"}, {"type": "subtitle", "time": 3990.109, "timestamp": "01:06:30", "text": "[音楽]"}, {"type": "subtitle", "time": 3992.549, "timestamp": "01:06:32", "text": "すべて。そう、でも私は持っていない"}, {"type": "subtitle", "time": 3995.91, "timestamp": "01:06:35", "text": "誰か、それを手伝ってくれませんか。だから私は"}, {"type": "subtitle", "time": 3997.67, "timestamp": "01:06:37", "text": "後ろにしまっておくよ"}, {"type": "subtitle", "time": 3999.589, "timestamp": "01:06:39", "text": "バーナー。"}, {"type": "subtitle", "time": 4008.63, "timestamp": "01:06:48", "text": "えっと、私もウェブサイトを作れたらいいのにと思います"}, {"type": "subtitle", "time": 4010.63, "timestamp": "01:06:50", "text": "そして私の仕事以外のすべてが"}, {"type": "subtitle", "time": 4013.95, "timestamp": "01:06:53", "text": "道。将来の雇用"}, {"type": "subtitle", "time": 4018.19, "timestamp": "01:06:58", "text": "あまりにも。心配ない。自分のことに集中する"}, {"type": "subtitle", "time": 4019.87, "timestamp": "01:06:59", "text": "もの。"}]
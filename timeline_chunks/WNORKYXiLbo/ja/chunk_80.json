[{"type": "subtitle", "time": 4804.95, "timestamp": "01:20:04", "text": "ブッシュの1つは実際には日本にあります"}, {"type": "subtitle", "time": 4808.99, "timestamp": "01:20:08", "text": "ナディアンは日本にいる"}, {"type": "subtitle", "time": 4814.39, "timestamp": "01:20:14", "text": "えっと、でも彼女はパキスタンでのジンみたいな感じなんです。"}, {"type": "subtitle", "time": 4815.79, "timestamp": "01:20:15", "text": "それで"}, {"type": "subtitle", "time": 4819.59, "timestamp": "01:20:19", "text": "うん。うん。待って、カイニキは"}, {"type": "subtitle", "time": 4820.51, "timestamp": "01:20:20", "text": "コラボレーション"}, {"type": "subtitle", "time": 4823.43, "timestamp": "01:20:23", "text": "これで？うん。ええ、見ましたよ。"}, {"type": "subtitle", "time": 4828.189, "timestamp": "01:20:28", "text": "ストリーム。私は、そんなはずはないと思った。"}, {"type": "subtitle", "time": 4830.63, "timestamp": "01:20:30", "text": "これ。私が誰なのか知らないなら"}, {"type": "subtitle", "time": 4834.149, "timestamp": "01:20:34", "text": "話はこれです。見上げる"}, {"type": "subtitle", "time": 4835.87, "timestamp": "01:20:35", "text": "えーと"}, {"type": "subtitle", "time": 4837.63, "timestamp": "01:20:37", "text": "パキスタン"}, {"type": "subtitle", "time": 4841.91, "timestamp": "01:20:41", "text": "YouTuber、Kiranじゃないよ。そこには"}, {"type": "subtitle", "time": 4844.12, "timestamp": "01:20:44", "text": "もう一つ"}, {"type": "subtitle", "time": 4847.39, "timestamp": "01:20:47", "text": "[音楽]"}, {"type": "subtitle", "time": 4851.95, "timestamp": "01:20:51", "text": "良い。ええ、もっと小さなチャンネルもあります"}, {"type": "subtitle", "time": 4856.35, "timestamp": "01:20:56", "text": "あまりにも。 OrangeはKaで動画を作った。待って、"}, {"type": "subtitle", "time": 4858.27, "timestamp": "01:20:58", "text": "何？"}]
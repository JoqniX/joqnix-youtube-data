[{"type": "subtitle", "time": 8283.27, "timestamp": "02:18:03", "text": "男性モデルを探しているのは、それが好きだからです。私は好きです"}, {"type": "subtitle", "time": 8288.79, "timestamp": "02:18:08", "text": "その曖昧さそのもの。それで、"}, {"type": "subtitle", "time": 8291.349, "timestamp": "02:18:11", "text": "うん、すごくきれいだね。"}, {"type": "subtitle", "time": 8293.87, "timestamp": "02:18:13", "text": "ああ、本当にありがとうございます。"}, {"type": "subtitle", "time": 8297.589, "timestamp": "02:18:17", "text": "うん。えーと、それは、えーと、それは、あなたが"}, {"type": "subtitle", "time": 8299.99, "timestamp": "02:18:19", "text": "3Dみたいな感じ？それとも違う、これは3Dだよね？"}, {"type": "subtitle", "time": 8304.07, "timestamp": "02:18:24", "text": "ええ、その2D版ですね。 2Dだったらよかったのに。"}, {"type": "subtitle", "time": 8307.309, "timestamp": "02:18:27", "text": "今のところ、私は3Dでしか存在しません。ああ、"}, {"type": "subtitle", "time": 8310.79, "timestamp": "02:18:30", "text": "わかった。うん。それで、それで、あなたは"}, {"type": "subtitle", "time": 8314.309, "timestamp": "02:18:34", "text": "衣装も別々にデザインしたの？私はします"}, {"type": "subtitle", "time": 8318.309, "timestamp": "02:18:38", "text": "異なる服装をしている。おお、いいね。"}, {"type": "subtitle", "time": 8320.07, "timestamp": "02:18:40", "text": "例えば、私が"}, {"type": "subtitle", "time": 8321.91, "timestamp": "02:18:41", "text": "すぐに手に入れることができます。私は変わることができる"}, {"type": "subtitle", "time": 8324.429, "timestamp": "02:18:44", "text": "私の服装。これは私の償いです"}, {"type": "subtitle", "time": 8328.629, "timestamp": "02:18:48", "text": "ストリーム。どちらを持っているか確認してみます。"}, {"type": "subtitle", "time": 8330.629, "timestamp": "02:18:50", "text": "Hの着物はかなり良いですね。飛び込むことができます"}, {"type": "subtitle", "time": 8333.549, "timestamp": "02:18:53", "text": "着物姿。バン。ああ、それは"}, {"type": "subtitle", "time": 8338.389, "timestamp": "02:18:58", "text": "かわいい。ああ、なんて綺麗なの。"}]
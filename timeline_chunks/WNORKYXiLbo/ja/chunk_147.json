[{"type": "subtitle", "time": 8822.389, "timestamp": "02:27:02", "text": "私はとにかく元気です。あなたはどうですか？"}, {"type": "subtitle", "time": 8825.349, "timestamp": "02:27:05", "text": "私も元気です。元気でいてくれるといいな"}, {"type": "subtitle", "time": 8827.91, "timestamp": "02:27:07", "text": "絶好調です。"}, {"type": "subtitle", "time": 8830.349, "timestamp": "02:27:10", "text": "喜んで"}, {"type": "subtitle", "time": 8833.309, "timestamp": "02:27:13", "text": "ストリーミングを聴きすぎている。おお"}, {"type": "subtitle", "time": 8838.15, "timestamp": "02:27:18", "text": "ああ、一度くらいは寝たいな。"}, {"type": "subtitle", "time": 8841.03, "timestamp": "02:27:21", "text": "ええ、私はよくそこにいましたが、神様"}, {"type": "subtitle", "time": 8844.389, "timestamp": "02:27:24", "text": "私はチャットでほとんど活動していませんでした。私"}, {"type": "subtitle", "time": 8845.99, "timestamp": "02:27:25", "text": "君は忘れていると思うよ"}, {"type": "subtitle", "time": 8849.349, "timestamp": "02:27:29", "text": "私が実際どんな人間なのかについて。いいえ、いいえ、私は"}, {"type": "subtitle", "time": 8851.59, "timestamp": "02:27:31", "text": "君のことを覚えているよ。はい、あなたは描きました"}, {"type": "subtitle", "time": 8853.99, "timestamp": "02:27:33", "text": "君が出演したのを覚えてるよ"}, {"type": "subtitle", "time": 8856.469, "timestamp": "02:27:36", "text": "クリスマスツリーみたいなやつ。あなたは"}, {"type": "subtitle", "time": 8858.23, "timestamp": "02:27:38", "text": "誕生日のお祝いのためにそこにいた。うん。"}, {"type": "subtitle", "time": 8861.429, "timestamp": "02:27:41", "text": "ええ、あなたのことは今でも覚えていますよ。はい。"}, {"type": "subtitle", "time": 8862.95, "timestamp": "02:27:42", "text": "うん。クリスマスプレゼント、改めてありがとうございました。"}, {"type": "subtitle", "time": 8875.51, "timestamp": "02:27:55", "text": "ええ、ええと、ここに待っているものがあります。それで"}, {"type": "subtitle", "time": 8878.71, "timestamp": "02:27:58", "text": "私が対応します。ええと、無料です"}]
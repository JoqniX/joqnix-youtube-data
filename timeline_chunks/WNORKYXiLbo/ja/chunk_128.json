[{"type": "subtitle", "time": 7683.75, "timestamp": "02:08:03", "text": "何を話すべきかを知っている。うん。"}, {"type": "subtitle", "time": 7685.99, "timestamp": "02:08:05", "text": "これはすごくクールだ。"}, {"type": "subtitle", "time": 7697.589, "timestamp": "02:08:17", "text": "ニース。そして、これはタイマーですか？"}, {"type": "subtitle", "time": 7701.43, "timestamp": "02:08:21", "text": "画面？それはどんな感じですか"}, {"type": "subtitle", "time": 7704.47, "timestamp": "02:08:24", "text": "スキップされるか、または次に進みます"}, {"type": "subtitle", "time": 7706.39, "timestamp": "02:08:26", "text": "スキップバットの隣にはタイマーがあります。だからもし"}, {"type": "subtitle", "time": 7708.31, "timestamp": "02:08:28", "text": "むしろ話したい気分"}, {"type": "subtitle", "time": 7711.27, "timestamp": "02:08:31", "text": "5分または3分"}, {"type": "subtitle", "time": 7713.91, "timestamp": "02:08:33", "text": "数分、2分でも、"}, {"type": "subtitle", "time": 7716.27, "timestamp": "02:08:36", "text": "それ。そして最後には自動的に"}, {"type": "subtitle", "time": 7719.83, "timestamp": "02:08:39", "text": "スキップする代わりに、あなたが留まる必要がある"}, {"type": "subtitle", "time": 7721.669, "timestamp": "02:08:41", "text": "グループのため、その期間中そこにいる"}, {"type": "subtitle", "time": 7724.55, "timestamp": "02:08:44", "text": "チャットは15から20まで可能です"}, {"type": "subtitle", "time": 7734.589, "timestamp": "02:08:54", "text": "ああ、それはとても"}, {"type": "subtitle", "time": 7737.91, "timestamp": "02:08:57", "text": "いいね。私もあなたのプロフィールを確認できますよ。"}]
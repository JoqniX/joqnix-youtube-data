[{"type": "subtitle", "time": 14402.79, "timestamp": "04:00:02", "text": "でも今は何かを手に入れると"}, {"type": "subtitle", "time": 14407.83, "timestamp": "04:00:07", "text": "共有する。私は余分に買ってあげたい"}, {"type": "subtitle", "time": 14410.55, "timestamp": "04:00:10", "text": "本当に必要としている人たちに渡します。"}, {"type": "subtitle", "time": 14414.11, "timestamp": "04:00:14", "text": "しばらくしたら使わなくなる気がする"}, {"type": "subtitle", "time": 14416.429, "timestamp": "04:00:16", "text": "時間。"}, {"type": "subtitle", "time": 14423.75, "timestamp": "04:00:23", "text": "これはアニメーションアラートです。ああ、私は"}, {"type": "subtitle", "time": 14427.389, "timestamp": "04:00:27", "text": "それも手に入れよう。なぜ"}, {"type": "subtitle", "time": 14431.91, "timestamp": "04:00:31", "text": "ない？はい、１、２、３。私"}, {"type": "subtitle", "time": 14439.11, "timestamp": "04:00:39", "text": "えっと、このプロファイルフレームプラチナを手に入れました"}, {"type": "subtitle", "time": 14442.51, "timestamp": "04:00:42", "text": "ロックス 裏面 桜フレーム 桜"}, {"type": "subtitle", "time": 14445.91, "timestamp": "04:00:45", "text": "フレームと可愛いフレーム。私は"}, {"type": "subtitle", "time": 14449.309, "timestamp": "04:00:49", "text": "プラチナを使いたい"}, {"type": "subtitle", "time": 14451.389, "timestamp": "04:00:51", "text": "1つ。使うかもしれない"}, {"type": "subtitle", "time": 14454.55, "timestamp": "04:00:54", "text": "ここにアバターを配置できるように"}]
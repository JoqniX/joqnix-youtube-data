[{"type": "subtitle", "time": 2103.829, "timestamp": "00:35:03", "text": "私は、p が"}, {"type": "subtitle", "time": 2109.069, "timestamp": "00:35:09", "text": "イベント。"}, {"type": "subtitle", "time": 2112.79, "timestamp": "00:35:12", "text": "ああ、こうはならなかったかもしれない"}, {"type": "subtitle", "time": 2114.75, "timestamp": "00:35:14", "text": "それ。たくさんあった"}, {"type": "subtitle", "time": 2118.39, "timestamp": "00:35:18", "text": "この分野で情熱的なクリエイターたちが"}, {"type": "subtitle", "time": 2122.829, "timestamp": "00:35:22", "text": "一般的に素晴らしいことをしたいと思っていました"}, {"type": "subtitle", "time": 2125.349, "timestamp": "00:35:25", "text": "もの。私はそれを受け取ったような気がした"}, {"type": "subtitle", "time": 2133.87, "timestamp": "00:35:33", "text": "何か、だって、ある意味で私の"}, {"type": "subtitle", "time": 2137.67, "timestamp": "00:35:37", "text": "理想的だから、ある意味で私の理想のテレビ"}, {"type": "subtitle", "time": 2140.55, "timestamp": "00:35:40", "text": "コミュニティはそうではなく、まるで私がプレッシャーを感じていたかのようだった。"}, {"type": "subtitle", "time": 2142.71, "timestamp": "00:35:42", "text": "私自身の理想をコミュニティ全体に"}, {"type": "subtitle", "time": 2144.87, "timestamp": "00:35:44", "text": "あるいは、そんな感じ。私にとっては"}, {"type": "subtitle", "time": 2148.15, "timestamp": "00:35:48", "text": "まるで私がこの空間を"}, {"type": "subtitle", "time": 2151.99, "timestamp": "00:35:51", "text": "有害、あるいは大げさすぎる。私はただ"}, {"type": "subtitle", "time": 2153.79, "timestamp": "00:35:53", "text": "みんな仲良く"}, {"type": "subtitle", "time": 2156.95, "timestamp": "00:35:56", "text": "そして、良い繋がりがあり、"}, {"type": "subtitle", "time": 2159.19, "timestamp": "00:35:59", "text": "小さいからみんな働いてるよ"}]
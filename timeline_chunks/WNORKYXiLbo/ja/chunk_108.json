[{"type": "subtitle", "time": 6489.87, "timestamp": "01:48:09", "text": "何てことだ。それは"}, {"type": "subtitle", "time": 6493.39, "timestamp": "01:48:13", "text": "遠隔。リモコンは"}, {"type": "subtitle", "time": 6497.149, "timestamp": "01:48:17", "text": "リモート接続。わかった。リモート。"}, {"type": "subtitle", "time": 6501.149, "timestamp": "01:48:21", "text": "わかった。私は怖いです。私は怖いです。私は"}, {"type": "subtitle", "time": 6507.229, "timestamp": "01:48:27", "text": "[音楽]"}, {"type": "subtitle", "time": 6511.99, "timestamp": "01:48:31", "text": "する？実際に人が通りかかる様子を想像してみてください。しないで"}, {"type": "subtitle", "time": 6513.59, "timestamp": "01:48:33", "text": "考える。考えるな。"}, {"type": "subtitle", "time": 6515.35, "timestamp": "01:48:35", "text": "よし、私が何者なのか見てみよう"}, {"type": "subtitle", "time": 6522.51, "timestamp": "01:48:42", "text": "生存、"}, {"type": "subtitle", "time": 6534.59, "timestamp": "01:48:54", "text": "G、ファイナルF、"}]
[{"type": "subtitle", "time": 10383.429, "timestamp": "02:53:03", "text": "知る。えっと、ツイッターの件ですね。私"}, {"type": "subtitle", "time": 10387.11, "timestamp": "02:53:07", "text": "何とかしなければならない。"}, {"type": "subtitle", "time": 10389.67, "timestamp": "02:53:09", "text": "ええ、私は何か対策を講じようと思いました"}, {"type": "subtitle", "time": 10392.79, "timestamp": "02:53:12", "text": "デビューするまでは"}, {"type": "subtitle", "time": 10394.269, "timestamp": "02:53:14", "text": "または"}, {"type": "subtitle", "time": 10396.349, "timestamp": "02:53:16", "text": "何かまたは"}, {"type": "subtitle", "time": 10399.15, "timestamp": "02:53:19", "text": "何か。えっと、または"}, {"type": "subtitle", "time": 10402.429, "timestamp": "02:53:22", "text": "どうしたらいいのかわからない"}, {"type": "subtitle", "time": 10405.469, "timestamp": "02:53:25", "text": "アカウント"}, {"type": "subtitle", "time": 10408.11, "timestamp": "02:53:28", "text": "あれ。"}, {"type": "subtitle", "time": 10410.79, "timestamp": "02:53:30", "text": "うーん、わからないけど、そうすべきじゃないと思う。"}, {"type": "subtitle", "time": 10413.95, "timestamp": "02:53:33", "text": "心配しすぎです。私はまた人々をフォローします"}, {"type": "subtitle", "time": 10417.349, "timestamp": "02:53:37", "text": "サブアカウントでは、"}, {"type": "subtitle", "time": 10419.349, "timestamp": "02:53:39", "text": "好きな人をフォローする自由度がさらに高まる"}, {"type": "subtitle", "time": 10422.469, "timestamp": "02:53:42", "text": "そして全て。それはむしろ、"}, {"type": "subtitle", "time": 10425.309, "timestamp": "02:53:45", "text": "メインアカウントはPRのようなもの"}, {"type": "subtitle", "time": 10428.389, "timestamp": "02:53:48", "text": "アカウント、公開プロモーションアカウント"}, {"type": "subtitle", "time": 10431.429, "timestamp": "02:53:51", "text": "あれと、もう一つは私の"}, {"type": "subtitle", "time": 10433.83, "timestamp": "02:53:53", "text": "公開セカンダリアカウントで"}, {"type": "subtitle", "time": 10436.349, "timestamp": "02:53:56", "text": "私が望むことを何でもして、人々に従う"}, {"type": "subtitle", "time": 10438.59, "timestamp": "02:53:58", "text": "など。ええ。"}]
[{"type": "subtitle", "time": 9181.11, "timestamp": "02:33:01", "text": "ストリーミングでは、本当に好きになりたくない"}, {"type": "subtitle", "time": 9184.55, "timestamp": "02:33:04", "text": "すべてを見せてください、なぜなら、一度"}, {"type": "subtitle", "time": 9186.469, "timestamp": "02:33:06", "text": "しばらくすると、すべてがあなたにとって"}, {"type": "subtitle", "time": 9189.03, "timestamp": "02:33:09", "text": "見せたくない。ああ、分かります。"}, {"type": "subtitle", "time": 9191.99, "timestamp": "02:33:11", "text": "念のため、放送しておいた方が良いでしょう。"}, {"type": "subtitle", "time": 9195.27, "timestamp": "02:33:15", "text": "以前は2台のPC構​​成だったので"}, {"type": "subtitle", "time": 9198.63, "timestamp": "02:33:18", "text": "キャプチャカードは、"}, {"type": "subtitle", "time": 9200.87, "timestamp": "02:33:20", "text": "まるで全体が"}, {"type": "subtitle", "time": 9209.59, "timestamp": "02:33:29", "text": "ボタンが必要だった"}, {"type": "subtitle", "time": 9213.83, "timestamp": "02:33:33", "text": "ぼやけたりしてます。信じられない光景だった。"}, {"type": "subtitle", "time": 9215.349, "timestamp": "02:33:35", "text": "ぼかしボタンは常に用意しておくべきです。"}, {"type": "subtitle", "time": 9217.19, "timestamp": "02:33:37", "text": "ぼかしボタンを持っている人が少なすぎる"}, {"type": "subtitle", "time": 9221.03, "timestamp": "02:33:41", "text": "彼らは圧力をかける。真実。パニックボタンを押す"}, {"type": "subtitle", "time": 9226.07, "timestamp": "02:33:46", "text": "とても便利です。はい。パニック。"}, {"type": "subtitle", "time": 9228.87, "timestamp": "02:33:48", "text": "このトラッカーって一体何なの？それは"}, {"type": "subtitle", "time": 9231.59, "timestamp": "02:33:51", "text": "私が予想していた反応とは違う。それで、"}, {"type": "subtitle", "time": 9234.79, "timestamp": "02:33:54", "text": "トラッカーはいくつ入手しましたか？まるで私が"}, {"type": "subtitle", "time": 9236.469, "timestamp": "02:33:56", "text": "確か8個くらいだったと思うんだけど、そうだよね？私は作った"}]
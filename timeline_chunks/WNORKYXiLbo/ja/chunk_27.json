[{"type": "subtitle", "time": 1621.11, "timestamp": "00:27:01", "text": "いいえ、すべての提携会社に展開中です"}, {"type": "subtitle", "time": 1623.39, "timestamp": "00:27:03", "text": "そして今日のパートナーたち。おお、"}, {"type": "subtitle", "time": 1627.51, "timestamp": "00:27:07", "text": "クリップみたいなバッジみたいなのが発売されたよ。"}, {"type": "subtitle", "time": 1631.149, "timestamp": "00:27:11", "text": "Twitchシャワー用のフリップバッジ。"}, {"type": "subtitle", "time": 1633.149, "timestamp": "00:27:13", "text": "ニース。おい、"}, {"type": "subtitle", "time": 1636.269, "timestamp": "00:27:16", "text": "ヴァンX、彼女の名前は何だっけ？ゴリラ"}, {"type": "subtitle", "time": 1640.11, "timestamp": "00:27:20", "text": "女の子。でも、私はとても幸せでした。私は"}, {"type": "subtitle", "time": 1644.149, "timestamp": "00:27:24", "text": "「うわー、ヒンディー語を話すヒンディー語、ああ、ヒンディー語。"}, {"type": "subtitle", "time": 1646.149, "timestamp": "00:27:26", "text": "彼女はヒンディー語を知っている。彼女はヒンディー語で歌った。彼女"}, {"type": "subtitle", "time": 1648.31, "timestamp": "00:27:28", "text": "ヒンディー語で自己紹介をした。私は"}, {"type": "subtitle", "time": 1656.95, "timestamp": "00:27:36", "text": "これについてたくさんの情報を見かける"}, {"type": "subtitle", "time": 1658.83, "timestamp": "00:27:38", "text": "シルバーというゲーム"}]
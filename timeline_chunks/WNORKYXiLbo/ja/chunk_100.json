[{"type": "subtitle", "time": 6006.95, "timestamp": "01:40:06", "text": "兄弟。アカウントを作成しました。私は持っています"}, {"type": "subtitle", "time": 6009.43, "timestamp": "01:40:09", "text": "これへのアクセス。私はジョアトンのようだった、"}, {"type": "subtitle", "time": 6012.149, "timestamp": "01:40:12", "text": "私はこれをやるつもりだ。まだ"}, {"type": "subtitle", "time": 6018.51, "timestamp": "01:40:18", "text": "それ。私は"}, {"type": "subtitle", "time": 6021.31, "timestamp": "01:40:21", "text": "怖がった。私は"}, {"type": "subtitle", "time": 6025.149, "timestamp": "01:40:25", "text": "怖がった。正直怖い"}, {"type": "subtitle", "time": 6038.629, "timestamp": "01:40:38", "text": "正しい。え、何？待て、違う。間違っている"}, {"type": "subtitle", "time": 6041.51, "timestamp": "01:40:41", "text": "アカウント。 1秒。"}]
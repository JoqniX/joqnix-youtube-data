[{"type": "subtitle", "time": 12362.51, "timestamp": "03:26:02", "text": "7年、5年、6年くらい、黒酒を飲む"}, {"type": "subtitle", "time": 12365.349, "timestamp": "03:26:05", "text": "退屈だからお茶を飲む。そこには"}, {"type": "subtitle", "time": 12368.11, "timestamp": "03:26:08", "text": "食べるものが何もない。"}, {"type": "subtitle", "time": 12371.51, "timestamp": "03:26:11", "text": "ええと、私は以前はお茶を飲んでいて、"}, {"type": "subtitle", "time": 12388.79, "timestamp": "03:26:28", "text": "教えてくれれば、私には計画がある。そうではありません"}, {"type": "subtitle", "time": 12391.07, "timestamp": "03:26:31", "text": "確認済み"}, {"type": "subtitle", "time": 12393.99, "timestamp": "03:26:33", "text": "まだ。自分の目を際立たせたかった"}, {"type": "subtitle", "time": 12397.83, "timestamp": "03:26:37", "text": "友人の、私が抱きしめていた人、そして"}, {"type": "subtitle", "time": 12402.87, "timestamp": "03:26:42", "text": "私を近くに抱きしめて、えっと、さあ"}, {"type": "subtitle", "time": 12404.269, "timestamp": "03:26:44", "text": "ストリームと"}, {"type": "subtitle", "time": 12407.91, "timestamp": "03:26:47", "text": "話したり、そういうこと、もっと"}, {"type": "subtitle", "time": 12410.83, "timestamp": "03:26:50", "text": "それは私とのやり取りのようなものになるでしょう"}, {"type": "subtitle", "time": 12413.51, "timestamp": "03:26:53", "text": "しかしもし"}, {"type": "subtitle", "time": 12415.83, "timestamp": "03:26:55", "text": "チャットには、"}, {"type": "subtitle", "time": 12419.349, "timestamp": "03:26:59", "text": "彼らと話したいし、好きでもある"}]
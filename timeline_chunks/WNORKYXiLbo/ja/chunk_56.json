[{"type": "subtitle", "time": 3362.47, "timestamp": "00:56:02", "text": "いつも幸せだけど、そう、そうなることもある"}, {"type": "subtitle", "time": 3365.47, "timestamp": "00:56:05", "text": "我々の競争力のある"}, {"type": "subtitle", "time": 3377.27, "timestamp": "00:56:17", "text": "たくさんの新しい人が"}, {"type": "subtitle", "time": 3379.829, "timestamp": "00:56:19", "text": "未来のことですよね？ええと、現在のすべて"}, {"type": "subtitle", "time": 3381.91, "timestamp": "00:56:21", "text": "最善を尽くしているYouTuberたちは、"}, {"type": "subtitle", "time": 3383.71, "timestamp": "00:56:23", "text": "積極的に"}, {"type": "subtitle", "time": 3387.91, "timestamp": "00:56:27", "text": "自分たちのような新しい人々を刺激する"}, {"type": "subtitle", "time": 3390.91, "timestamp": "00:56:30", "text": "視聴者がユーチューバーになる、"}, {"type": "subtitle", "time": 3393.069, "timestamp": "00:56:33", "text": "右？"}, {"type": "subtitle", "time": 3395.91, "timestamp": "00:56:35", "text": "うん。将来にはもっと"}, {"type": "subtitle", "time": 3399.03, "timestamp": "00:56:39", "text": "たくさんのユーチューバーが登場するだろう。私たちの"}, {"type": "subtitle", "time": 3402.23, "timestamp": "00:56:42", "text": "人口は増加するだろう。"}, {"type": "subtitle", "time": 3405.75, "timestamp": "00:56:45", "text": "想像できますか、あのユーチューバーのリストのように"}, {"type": "subtitle", "time": 3411.47, "timestamp": "00:56:51", "text": "約200人以上いた"}, {"type": "subtitle", "time": 3414.19, "timestamp": "00:56:54", "text": "それはユーチューバーです"}, {"type": "subtitle", "time": 3418.15, "timestamp": "00:56:58", "text": "2023年。今はもう2025年のような気がする。"}]
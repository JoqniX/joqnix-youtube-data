[{"type": "subtitle", "time": 3840.27, "timestamp": "01:04:00", "text": "たくさん"}, {"type": "subtitle", "time": 3842.589, "timestamp": "01:04:02", "text": "もの。私はしません"}, {"type": "subtitle", "time": 3846.71, "timestamp": "01:04:06", "text": "傷のついたものを知っている。"}, {"type": "subtitle", "time": 3849.19, "timestamp": "01:04:09", "text": "面白いのは、たとえ私がそれをしても"}, {"type": "subtitle", "time": 3851.51, "timestamp": "01:04:11", "text": "メンバーには、"}, {"type": "subtitle", "time": 3855.029, "timestamp": "01:04:15", "text": "無料で提供するのは、誰もがそうではないことを知っているからです"}, {"type": "subtitle", "time": 3858.349, "timestamp": "01:04:18", "text": "会員費を支払うお金があり、"}, {"type": "subtitle", "time": 3862.069, "timestamp": "01:04:22", "text": "Twitchであっても全てです。それで、"}, {"type": "subtitle", "time": 3865.349, "timestamp": "01:04:25", "text": "うーん、でも、それも悪いことですよね。わかった"}, {"type": "subtitle", "time": 3871.029, "timestamp": "01:04:31", "text": "したいのですが、私は、"}, {"type": "subtitle", "time": 3873.549, "timestamp": "01:04:33", "text": "プレミアム"}, {"type": "subtitle", "time": 3876.51, "timestamp": "01:04:36", "text": "バージョン、つまり無料版と"}, {"type": "subtitle", "time": 3879.309, "timestamp": "01:04:39", "text": "プレミアム。ゲームを作っているのか、それとも"}, {"type": "subtitle", "time": 3882.39, "timestamp": "01:04:42", "text": "何か？まるで無料ティアのようなバス"}, {"type": "subtitle", "time": 3889.51, "timestamp": "01:04:49", "text": "階層。ああ、そんな感じ。"}, {"type": "subtitle", "time": 3892.789, "timestamp": "01:04:52", "text": "えーと、あるいは、えーと、私たちは"}, {"type": "subtitle", "time": 3895.23, "timestamp": "01:04:55", "text": "いつもこうやってやる"}, {"type": "subtitle", "time": 3899.029, "timestamp": "01:04:59", "text": "えーっと、将来もし私が"}]
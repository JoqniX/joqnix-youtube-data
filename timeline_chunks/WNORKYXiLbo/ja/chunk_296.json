[{"type": "subtitle", "time": 17762.708, "timestamp": "04:56:02", "text": "イアンのVtuberグッズとイアン・イアン・コーポ"}, {"type": "subtitle", "time": 17765.51, "timestamp": "04:56:05", "text": "えーと、ストリームとかそういうやつですよね？私はちょっと"}, {"type": "subtitle", "time": 17768.51, "timestamp": "04:56:08", "text": "そんな感じ。良い関係を保つべきだと思う"}, {"type": "subtitle", "time": 17772.51, "timestamp": "04:56:12", "text": "企業と"}, {"type": "subtitle", "time": 17775.948, "timestamp": "04:56:15", "text": "コーポリッシュも同様に"}, {"type": "subtitle", "time": 17783.51, "timestamp": "04:56:23", "text": "うん。うん。私が持っているもの"}, {"type": "subtitle", "time": 17787.27, "timestamp": "04:56:27", "text": "一生懸命働くことは、内容的に賢明なことだ。私は持っている"}, {"type": "subtitle", "time": 17791.43, "timestamp": "04:56:31", "text": "今、何か貢献できることをしなければならない。"}, {"type": "subtitle", "time": 17794.15, "timestamp": "04:56:34", "text": "うん。私はたくさんのことを学ぶ必要がある"}, {"type": "subtitle", "time": 17801.11, "timestamp": "04:56:41", "text": "もちろん。私がストリーミング配信をしている間は"}, {"type": "subtitle", "time": 17806.48, "timestamp": "04:56:46", "text": "年月が経ち、すべてが"}, {"type": "subtitle", "time": 17807.948, "timestamp": "04:56:47", "text": "[音楽]"}, {"type": "subtitle", "time": 17811.15, "timestamp": "04:56:51", "text": "新しい。すべてが"}, {"type": "subtitle", "time": 17815.11, "timestamp": "04:56:55", "text": "新しい。あなたはすべて新しいことを学ぶ。あなたは学ぶ"}]
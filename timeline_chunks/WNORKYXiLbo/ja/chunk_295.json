[{"type": "subtitle", "time": 17726.788, "timestamp": "04:55:26", "text": "このブラウザは完全に壊れている。それは"}, {"type": "subtitle", "time": 17741.31, "timestamp": "04:55:41", "text": "ワ。"}, {"type": "subtitle", "time": 17744.67, "timestamp": "04:55:44", "text": "とにかく、私は新しい存在になりたい"}, {"type": "subtitle", "time": 17747.788, "timestamp": "04:55:47", "text": "えっと、そういうタイプのユーチューバー"}, {"type": "subtitle", "time": 17751.35, "timestamp": "04:55:51", "text": "君は短いものについてよく知ってるよね？えーと"}, {"type": "subtitle", "time": 17754.31, "timestamp": "04:55:54", "text": "彼は以前はノンジコラボやホルをやっていました"}, {"type": "subtitle", "time": 17758.07, "timestamp": "04:55:58", "text": "コラボってことかな？そして、えーと"}]
[{"type": "subtitle", "time": 12060.11, "timestamp": "03:21:00", "text": "寝なければならないということだ"}, {"type": "subtitle", "time": 12063.75, "timestamp": "03:21:03", "text": "時間。木曜日のコラボはfじゃないよ。私"}, {"type": "subtitle", "time": 12066.229, "timestamp": "03:21:06", "text": "ああ、そうだね。私はそうしたくない。の"}, {"type": "subtitle", "time": 12071.19, "timestamp": "03:21:11", "text": "寝て寝るなんて、私の考えではありえない。"}, {"type": "subtitle", "time": 12074.469, "timestamp": "03:21:14", "text": "もし私が誰かと時間を予定したら"}, {"type": "subtitle", "time": 12077.19, "timestamp": "03:21:17", "text": "異なるタイムゾーンで、"}, {"type": "subtitle", "time": 12079.83, "timestamp": "03:21:19", "text": "1四半期目"}, {"type": "subtitle", "time": 12083.59, "timestamp": "03:21:23", "text": "トークマラソンって、朝の配信のことだよね？"}, {"type": "subtitle", "time": 12087.11, "timestamp": "03:21:27", "text": "午前9時頃"}, {"type": "subtitle", "time": 12090.389, "timestamp": "03:21:30", "text": "午前9時か午前9時前。うん、私は"}, {"type": "subtitle", "time": 12092.99, "timestamp": "03:21:32", "text": "起きていなければならない、"}, {"type": "subtitle", "time": 12095.17, "timestamp": "03:21:35", "text": "兄弟。そして精神的に"}, {"type": "subtitle", "time": 12100.99, "timestamp": "03:21:40", "text": "準備した。"}, {"type": "subtitle", "time": 12112.95, "timestamp": "03:21:52", "text": "素早い。それに気づいた。"}]
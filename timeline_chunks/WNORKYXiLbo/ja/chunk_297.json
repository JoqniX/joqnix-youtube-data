[{"type": "subtitle", "time": 17820.55, "timestamp": "04:57:00", "text": "日。うん。私たち全員が消費しているように"}, {"type": "subtitle", "time": 17823.91, "timestamp": "04:57:03", "text": "インターネット接続ができるようになりました。私たちは皆、毎日何かを学んでいる。"}, {"type": "subtitle", "time": 17865.91, "timestamp": "04:57:45", "text": "うん、後で彼女にメッセージを送るよ。えーと、それで、えーと"}, {"type": "subtitle", "time": 17868.43, "timestamp": "04:57:48", "text": "連絡を取らなければならない"}, {"type": "subtitle", "time": 17872.19, "timestamp": "04:57:52", "text": "了解、このコラボレーションは確定しました"}, {"type": "subtitle", "time": 17876.948, "timestamp": "04:57:56", "text": "24日 午後7時30分土曜日。"}]
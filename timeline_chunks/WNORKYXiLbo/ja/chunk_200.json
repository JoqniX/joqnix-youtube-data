[{"type": "subtitle", "time": 12007.469, "timestamp": "03:20:07", "text": "研削。私は実際に努力しました"}, {"type": "subtitle", "time": 12011.07, "timestamp": "03:20:11", "text": "64. 明日は"}, {"type": "subtitle", "time": 12019.55, "timestamp": "03:20:19", "text": "それ？ああ、"}, {"type": "subtitle", "time": 12021.91, "timestamp": "03:20:21", "text": "神。ああ、そう、私は"}, {"type": "subtitle", "time": 12024.07, "timestamp": "03:20:24", "text": "連絡を取って試合を確認してください。の"}, {"type": "subtitle", "time": 12026.79, "timestamp": "03:20:26", "text": "問題は、今、私がとても混乱しているということです。何をすればいいですか"}, {"type": "subtitle", "time": 12029.389, "timestamp": "03:20:29", "text": "遊ぶ"}, {"type": "subtitle", "time": 12038.99, "timestamp": "03:20:38", "text": "そして、私は"}, {"type": "subtitle", "time": 12041.55, "timestamp": "03:20:41", "text": "夜だから無理だよ"}, {"type": "subtitle", "time": 12046.15, "timestamp": "03:20:46", "text": "ミャオとミッチと一緒にいる。えっと、それは"}, {"type": "subtitle", "time": 12047.95, "timestamp": "03:20:47", "text": "夜"}, {"type": "subtitle", "time": 12057.19, "timestamp": "03:20:57", "text": "早起きしないといけないからじゃない"}]
[{"type": "subtitle", "time": 8222.389, "timestamp": "02:17:02", "text": "そう、でも新しいモデル、新しい"}, {"type": "subtitle", "time": 8225.07, "timestamp": "02:17:05", "text": "モデルにはイヤリングがありません"}, {"type": "subtitle", "time": 8227.95, "timestamp": "02:17:07", "text": "何か、だってそうなる気がしたから"}, {"type": "subtitle", "time": 8231.589, "timestamp": "02:17:11", "text": "多くの。うん、"}, {"type": "subtitle", "time": 8233.99, "timestamp": "02:17:13", "text": "でも、私はそれが好きなんです。私は私は天界の存在です"}, {"type": "subtitle", "time": 8237.03, "timestamp": "02:17:17", "text": "私もそう思うので、もっと広い空間が見られるのはいいですね"}, {"type": "subtitle", "time": 8240.389, "timestamp": "02:17:20", "text": "もしくは、そうですね。宇宙にインスパイアされた作品"}, {"type": "subtitle", "time": 8245.11, "timestamp": "02:17:25", "text": "モデルとかそういうもの。わーい。俺たちは宇宙ギャングだ。"}, {"type": "subtitle", "time": 8252.469, "timestamp": "02:17:32", "text": "うん。あなたのことも教えてください。どうやって"}, {"type": "subtitle", "time": 8256.23, "timestamp": "02:17:36", "text": "あなたのモデルにも影響を与えましたか？ああ、そう"}, {"type": "subtitle", "time": 8259.429, "timestamp": "02:17:39", "text": "私は犬夜叉やファイナルの大ファンです"}, {"type": "subtitle", "time": 8262.79, "timestamp": "02:17:42", "text": "ファンタジー。だから、それが私にインスピレーションを与えて"}, {"type": "subtitle", "time": 8264.389, "timestamp": "02:17:44", "text": "私のモデルを次のようにベースに作ります"}, {"type": "subtitle", "time": 8267.509, "timestamp": "02:17:47", "text": "イナーシャとセファロスの写生丸"}, {"type": "subtitle", "time": 8271.75, "timestamp": "02:17:51", "text": "ファイナルファンタジー7から。ああ、"}, {"type": "subtitle", "time": 8276.79, "timestamp": "02:17:56", "text": "あと、えっと、転生スライムも好きです。だから私は"}, {"type": "subtitle", "time": 8279.669, "timestamp": "02:17:59", "text": "とても気に入ったので、とてもきれいに行きました"}]
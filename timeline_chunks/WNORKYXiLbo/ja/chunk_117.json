[{"type": "subtitle", "time": 7039.47, "timestamp": "01:57:19", "text": "充電。よし、編集は終わった"}, {"type": "subtitle", "time": 7043.189, "timestamp": "01:57:23", "text": "プロフィール。ああ、怖い。私は"}, {"type": "subtitle", "time": 7051.31, "timestamp": "01:57:31", "text": "これ。"}, {"type": "subtitle", "time": 7064.709, "timestamp": "01:57:44", "text": "怖がった。ああ、彼らはスピードチャットをしている"}, {"type": "subtitle", "time": 7068.91, "timestamp": "01:57:48", "text": "もの。怖いよ、兄弟。その"}, {"type": "subtitle", "time": 7077.07, "timestamp": "01:57:57", "text": "[音楽]"}, {"type": "subtitle", "time": 7079.27, "timestamp": "01:57:59", "text": "自信がある。今日やるべきか、それとも"}]
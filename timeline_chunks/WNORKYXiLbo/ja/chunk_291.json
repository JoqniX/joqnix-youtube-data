[{"type": "subtitle", "time": 17465.19, "timestamp": "04:51:05", "text": "一緒にゲームしようぜ、バカ。私"}, {"type": "subtitle", "time": 17467.948, "timestamp": "04:51:07", "text": "ずっとあなたとコラボレーションしたいと思っていました。"}, {"type": "subtitle", "time": 17470.788, "timestamp": "04:51:10", "text": "バカ。一緒にゲームをするなら"}, {"type": "subtitle", "time": 17479.0, "timestamp": "04:51:19", "text": "つまり、私はあなたに"}, {"type": "subtitle", "time": 17487.47, "timestamp": "04:51:27", "text": "いつ欲しいかを知る"}, {"type": "subtitle", "time": 17496.628, "timestamp": "04:51:36", "text": "H Apex Gamer 悲しいことになるよ"}, {"type": "subtitle", "time": 17498.788, "timestamp": "04:51:38", "text": "これから日本に行くので、"}, {"type": "subtitle", "time": 17508.63, "timestamp": "04:51:48", "text": "ヴァレランも同じだよ"}, {"type": "subtitle", "time": 17510.75, "timestamp": "04:51:50", "text": "[音楽]"}, {"type": "subtitle", "time": 17513.59, "timestamp": "04:51:53", "text": "兄弟、私もプレイできないし"}, {"type": "subtitle", "time": 17515.99, "timestamp": "04:51:55", "text": "他の人とコラボレーションすると、私は"}, {"type": "subtitle", "time": 17518.708, "timestamp": "04:51:58", "text": "外国人は、人々がいるのが好きです"}]
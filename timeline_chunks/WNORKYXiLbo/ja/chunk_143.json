[{"type": "subtitle", "time": 8583.51, "timestamp": "02:23:03", "text": "うん。それで、どうやって"}, {"type": "subtitle", "time": 8587.11, "timestamp": "02:23:07", "text": "認証済みVTuberってやつ？私は思う 私は思う"}, {"type": "subtitle", "time": 8590.79, "timestamp": "02:23:10", "text": "招待されたので、メールを受け取りました"}, {"type": "subtitle", "time": 8593.27, "timestamp": "02:23:13", "text": "招待状とか色々あったけど、ログインしたら"}, {"type": "subtitle", "time": 8596.23, "timestamp": "02:23:16", "text": "今日では招待コードのようなものはなかった"}, {"type": "subtitle", "time": 8599.03, "timestamp": "02:23:19", "text": "入れるために。それで、彼らは完全に気に入ったのでしょうか。"}, {"type": "subtitle", "time": 8602.309, "timestamp": "02:23:22", "text": "これをリリースしますか？ええと、あなたは確認済みです"}, {"type": "subtitle", "time": 8604.79, "timestamp": "02:23:24", "text": "あなたのプロフィールですが、私にとっては、"}, {"type": "subtitle", "time": 8606.309, "timestamp": "02:23:26", "text": "私のTwitchチャンネルに接続して、それから"}, {"type": "subtitle", "time": 8609.95, "timestamp": "02:23:29", "text": "なんだか、あなたは上手ですね。"}, {"type": "subtitle", "time": 8612.309, "timestamp": "02:23:32", "text": "ああ、そういう仕組みなんですね。あなたは"}, {"type": "subtitle", "time": 8614.63, "timestamp": "02:23:34", "text": "9時間かかる。"}, {"type": "subtitle", "time": 8617.03, "timestamp": "02:23:37", "text": "9時間。ああ、ああ、新しいものを作った"}, {"type": "subtitle", "time": 8619.349, "timestamp": "02:23:39", "text": "ストリーム。そうそう。 Twitch は上限までしか許可していません"}, {"type": "subtitle", "time": 8624.15, "timestamp": "02:23:44", "text": "現在48時間経過しています。待って、待って、待って、"}, {"type": "subtitle", "time": 8628.15, "timestamp": "02:23:48", "text": "あなたは本当に本気で取り組んでいますね。"}, {"type": "subtitle", "time": 8630.389, "timestamp": "02:23:50", "text": "うん、それはすごいね。"}, {"type": "subtitle", "time": 8632.07, "timestamp": "02:23:52", "text": "お元気でお過ごしでしょうか。必ず"}, {"type": "subtitle", "time": 8635.03, "timestamp": "02:23:55", "text": "水分補給をして、ストレッチをしましょう。ありがとう"}, {"type": "subtitle", "time": 8637.91, "timestamp": "02:23:57", "text": "少なくとも20フィート（約6メートル）離れてください。させて"}]
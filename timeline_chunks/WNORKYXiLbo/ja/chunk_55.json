[{"type": "subtitle", "time": 3300.15, "timestamp": "00:55:00", "text": "自分。うん。だから私はまだ後悔している"}, {"type": "subtitle", "time": 3302.39, "timestamp": "00:55:02", "text": "自分のコミュニティを犠牲にして、"}, {"type": "subtitle", "time": 3305.43, "timestamp": "00:55:05", "text": "VTuber関連の話題に注力する。まるで"}, {"type": "subtitle", "time": 3307.549, "timestamp": "00:55:07", "text": "たくさん無駄にした"}, {"type": "chat", "time": 3308.637, "timestamp": "00:55:08", "author": "@SuzukiZurikoVTuber", "avatar": "https://yt4.ggpht.com/852SZLheWUnfQGntgjphW0AD17oXLR9MhuzMLEzOm451wzhCllgmSUMTMpDu7wtBK7HSHR9J=s64-c-k-c0x00ffffff-no-rj", "message": "people throw u around too much :("}, {"type": "subtitle", "time": 3312.15, "timestamp": "00:55:12", "text": "年。ああ、大丈夫です。少なくともよかった"}, {"type": "subtitle", "time": 3314.95, "timestamp": "00:55:14", "text": "人々がここにいて、人々は活動的で"}, {"type": "subtitle", "time": 3318.19, "timestamp": "00:55:18", "text": "新しい人たちがいます"}, {"type": "subtitle", "time": 3319.71, "timestamp": "00:55:19", "text": "えっと"}, {"type": "subtitle", "time": 3322.549, "timestamp": "00:55:22", "text": "ええと、人々はそこにいて、彼らは"}, {"type": "subtitle", "time": 3325.589, "timestamp": "00:55:25", "text": "彼らは協力し合い、様々なものを繋ぎ合わせている。"}, {"type": "chat", "time": 3325.659, "timestamp": "00:55:25", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "you're not wrong but idk i think i have enough people to rely on where i think i can manage comfortably"}, {"type": "subtitle", "time": 3328.23, "timestamp": "00:55:28", "text": "私が嫌いなのは、このタイプの"}, {"type": "subtitle", "time": 3330.79, "timestamp": "00:55:30", "text": "グループっぽいとか、このドラマみたいな感じ"}, {"type": "subtitle", "time": 3333.829, "timestamp": "00:55:33", "text": "そして人々は偽のフェイクニュースを避けている"}, {"type": "subtitle", "time": 3336.79, "timestamp": "00:55:36", "text": "偽ドラマとかそういうのと、"}, {"type": "subtitle", "time": 3340.39, "timestamp": "00:55:40", "text": "ゲート、ゲートキーピングなど。つまり、私たちは"}, {"type": "subtitle", "time": 3342.71, "timestamp": "00:55:42", "text": "これについて何か情報があれば教えてください。いつも"}, {"type": "subtitle", "time": 3345.87, "timestamp": "00:55:45", "text": "内で起こる"}, {"type": "subtitle", "time": 3355.27, "timestamp": "00:55:55", "text": "そう、アニメとは違うんだ"}, {"type": "subtitle", "time": 3358.309, "timestamp": "00:55:58", "text": "幸せそうで、陽気でいたいと思った"}]
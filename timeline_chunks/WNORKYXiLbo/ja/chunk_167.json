[{"type": "subtitle", "time": 10020.03, "timestamp": "02:47:00", "text": "あまりにも。気づいたかどうかわかりませんが"}, {"type": "subtitle", "time": 10023.91, "timestamp": "02:47:03", "text": "今は、そうしないように最善を尽くしている"}, {"type": "subtitle", "time": 10026.87, "timestamp": "02:47:06", "text": "不快なことや、特に"}, {"type": "subtitle", "time": 10028.79, "timestamp": "02:47:08", "text": "と共に"}, {"type": "subtitle", "time": 10031.11, "timestamp": "02:47:11", "text": "えっと、代名詞とか、そういうの全部ですね。"}, {"type": "subtitle", "time": 10033.429, "timestamp": "02:47:13", "text": "うん。"}, {"type": "subtitle", "time": 10038.75, "timestamp": "02:47:18", "text": "ありがたいことに日本の太陽は"}, {"type": "subtitle", "time": 10042.07, "timestamp": "02:47:22", "text": "あなたが"}, {"type": "subtitle", "time": 10043.91, "timestamp": "02:47:23", "text": "彼らに敬意を払うことは、彼らに向き合うことよりも重要である。"}, {"type": "subtitle", "time": 10046.56, "timestamp": "02:47:26", "text": "彼らを正式に。それで"}, {"type": "subtitle", "time": 10055.429, "timestamp": "02:47:35", "text": "うん、私が好きになるべきだと思う？"}, {"type": "subtitle", "time": 10057.95, "timestamp": "02:47:37", "text": "私が話した人はみんな友達"}, {"type": "subtitle", "time": 10060.95, "timestamp": "02:47:40", "text": "と？わからない。それは"}, {"type": "subtitle", "time": 10069.91, "timestamp": "02:47:49", "text": "親切？ブロックされたユーザーのようなものがあり、"}, {"type": "subtitle", "time": 10072.71, "timestamp": "02:47:52", "text": "チャット機能もあります。チャットできます"}, {"type": "subtitle", "time": 10074.75, "timestamp": "02:47:54", "text": "実際には"}]
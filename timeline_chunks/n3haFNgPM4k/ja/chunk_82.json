[{"type": "subtitle", "time": 4921.35, "timestamp": "01:22:01", "text": "一つ言い忘れていましたが、"}, {"type": "subtitle", "time": 4923.35, "timestamp": "01:22:03", "text": "実はあの憂鬱なアイテムを装備する必要はないんです"}, {"type": "subtitle", "time": 4927.27, "timestamp": "01:22:07", "text": "。 鎧を装備すれば、それを"}, {"type": "subtitle", "time": 4933.35, "timestamp": "01:22:13", "text": "鏡のようなものにすることができます。"}, {"type": "subtitle", "time": 4936.79, "timestamp": "01:22:16", "text": "俺たち仲間は剣を作っているところだ。 私は"}, {"type": "subtitle", "time": 4939.59, "timestamp": "01:22:19", "text": "エクスカリバーを手に入れた。これでテクノロジー関連のものを全て破壊するつもりだ"}, {"type": "subtitle", "time": 4957.43, "timestamp": "01:22:37", "text": "ああ、なんてことだ、まるで「"}, {"type": "subtitle", "time": 4968.149, "timestamp": "01:22:48", "text": "、アラならそれをアンティークの"}, {"type": "subtitle", "time": 4970.07, "timestamp": "01:22:50", "text": "ドレッサーみたいなものにできるよ。"}, {"type": "subtitle", "time": 4975.669, "timestamp": "01:22:55", "text": "21秒以内に1回短いキルをすれば、あとはキャラクターをカスタマイズするだけです"}]
[{"type": "subtitle", "time": 7265.83, "timestamp": "02:01:05", "text": "私の基地で何が起こっているのかも確認させてください"}, {"type": "subtitle", "time": 7296.229, "timestamp": "02:01:36", "text": "古代文明の精髄凝縮器の部品。 どうやって"}, {"type": "subtitle", "time": 7299.35, "timestamp": "02:01:39", "text": "それを手に入れるのですか？   わからない"}, {"type": "subtitle", "time": 7301.91, "timestamp": "02:01:41", "text": "。 私は"}, {"type": "subtitle", "time": 7303.43, "timestamp": "02:01:43", "text": "胸を手に入れて、この[咳払い]と"}, {"type": "subtitle", "time": 7306.629, "timestamp": "02:01:46", "text": "あの前面を倒すことでそれを手に入れるだけです。 ああ、"}, {"type": "subtitle", "time": 7310.07, "timestamp": "02:01:50", "text": "インタラクティブな地図とかを使っているんですか"}, {"type": "subtitle", "time": 7317.03, "timestamp": "02:01:57", "text": "いいえ。"}, {"type": "subtitle", "time": 7319.589, "timestamp": "02:01:59", "text": "ああ、ただぶらぶらしているだけで、大丈夫です。 ああ、わかりました"}]
[{"type": "subtitle", "time": 3003.67, "timestamp": "00:50:03", "text": "くそ。 私は実際にNPCを殺しました。 ああ、私の"}, {"type": "subtitle", "time": 3013.43, "timestamp": "00:50:13", "text": "パーカー、君なのか？"}, {"type": "subtitle", "time": 3016.79, "timestamp": "00:50:16", "text": "スパークルです。 ああ、"}, {"type": "subtitle", "time": 3031.67, "timestamp": "00:50:31", "text": "あなたは飛び降りるつもりだ。  Sh。"}, {"type": "subtitle", "time": 3035.75, "timestamp": "00:50:35", "text": "ここから飛び降りるつもりですか？ ああ、"}, {"type": "subtitle", "time": 3045.19, "timestamp": "00:50:45", "text": "えっと、"}, {"type": "subtitle", "time": 3047.99, "timestamp": "00:50:47", "text": "テレポート地点を探しています。"}, {"type": "subtitle", "time": 3051.03, "timestamp": "00:50:51", "text": "ここにはテレポート地点はないのですか？ お知らせください"}, {"type": "subtitle", "time": 3051.75, "timestamp": "00:50:51", "text": "。   わかった"}, {"type": "subtitle", "time": 3054.15, "timestamp": "00:50:54", "text": "。 だから、私たちは（音楽に合わせて）ジャンプして、あの"}, {"type": "subtitle", "time": 3056.63, "timestamp": "00:50:56", "text": "黄色いエリアに行かなければならない。 だから、"}, {"type": "subtitle", "time": 3058.79, "timestamp": "00:50:58", "text": "ミナ、体力を維持しなさい。   わかった"}]
[{"type": "subtitle", "time": 5161.27, "timestamp": "01:26:01", "text": "ああ、いや、いや、いやです。 私たちは"}, {"type": "subtitle", "time": 5164.47, "timestamp": "01:26:04", "text": "何を作らなければならないのか？ やらなきゃいけないんだ"}, {"type": "subtitle", "time": 5174.55, "timestamp": "01:26:14", "text": "ああ、これだ。 だから、服は両方とも必要なんです。"}, {"type": "subtitle", "time": 5184.47, "timestamp": "01:26:24", "text": "おいおい、勘弁してくれよ。   それは"}, {"type": "subtitle", "time": 5188.709, "timestamp": "01:26:28", "text": "何ですか？ クラフトの影などを受け取り、"}, {"type": "subtitle", "time": 5208.55, "timestamp": "01:26:48", "text": "ああ、あるいは基地に行くこともできます。"}, {"type": "subtitle", "time": 5209.83, "timestamp": "01:26:49", "text": "うん、うん、うん、うん、うん。"}, {"type": "subtitle", "time": 5217.27, "timestamp": "01:26:57", "text": "ジョー、私が何て言うか分かる？ 自分でパルを"}, {"type": "subtitle", "time": 5219.669, "timestamp": "01:26:59", "text": "倒すのではなく、高レベルのパルを雇いましょう"}]
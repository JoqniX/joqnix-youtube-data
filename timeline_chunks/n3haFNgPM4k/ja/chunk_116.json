[{"type": "subtitle", "time": 6973.189, "timestamp": "01:56:13", "text": "何て言うんでしたっけ？"}, {"type": "subtitle", "time": 6990.79, "timestamp": "01:56:30", "text": "何？"}, {"type": "subtitle", "time": 6991.589, "timestamp": "01:56:31", "text": "どうやって手に入れたの？"}, {"type": "subtitle", "time": 6994.149, "timestamp": "01:56:34", "text": "それは抑うつ剤だよ。 私はそれを着ています。"}, {"type": "subtitle", "time": 6995.83, "timestamp": "01:56:35", "text": "クエストをこなして、100個の"}, {"type": "subtitle", "time": 6998.09, "timestamp": "01:56:38", "text": "毒腺を20個の高品質な"}, {"type": "subtitle", "time": 6999.109, "timestamp": "01:56:39", "text": "[咳払い]服に渡すと、それが手に入ります"}, {"type": "subtitle", "time": 7000.47, "timestamp": "01:56:40", "text": "。"}, {"type": "subtitle", "time": 7002.55, "timestamp": "01:56:42", "text": "ああ、メインクエストだけでなく、サイドクエストもやるんですね"}, {"type": "subtitle", "time": 7004.31, "timestamp": "01:56:44", "text": "。"}, {"type": "subtitle", "time": 7006.39, "timestamp": "01:56:46", "text": "メインクエストはやってるけど、"}, {"type": "subtitle", "time": 7014.79, "timestamp": "01:56:54", "text": "ほら、私の制作ギルド版のアップグレード版を手に入れたよ"}, {"type": "subtitle", "time": 7019.51, "timestamp": "01:56:59", "text": "。"}]
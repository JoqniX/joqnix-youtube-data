[{"type": "subtitle", "time": 4501.43, "timestamp": "01:15:01", "text": "楽しむ。 ああ、わかりました。"}, {"type": "subtitle", "time": 4512.149, "timestamp": "01:15:12", "text": "そして、私がここにいるのが見えますか？"}, {"type": "subtitle", "time": 4515.43, "timestamp": "01:15:15", "text": "ええ、でも選択できないんです。 なぜ？ あ、"}, {"type": "subtitle", "time": 4518.709, "timestamp": "01:15:18", "text": "待って。 ロックを解除していませんでしたか？   いや"}, {"type": "subtitle", "time": 4521.189, "timestamp": "01:15:21", "text": "、違うよ。"}, {"type": "subtitle", "time": 4523.51, "timestamp": "01:15:23", "text": "ああ、わかった。 じゃあ、こっちに行ってみようか"}, {"type": "subtitle", "time": 4530.39, "timestamp": "01:15:30", "text": "私はこれを持っています。"}, {"type": "subtitle", "time": 4532.149, "timestamp": "01:15:32", "text": "うん。 うん。 ここに来て。 ここに来て。 そこには。"}, {"type": "subtitle", "time": 4545.75, "timestamp": "01:15:45", "text": "ここ。"}]
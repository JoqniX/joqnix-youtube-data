[{"type": "subtitle", "time": 8225.75, "timestamp": "02:17:05", "text": "、今日は楽しかったよ。 それでは失礼します"}, {"type": "subtitle", "time": 8233.11, "timestamp": "02:17:13", "text": "今日来てくれた人全員を読み上げます。ああ、なんてことだ"}, {"type": "subtitle", "time": 8241.11, "timestamp": "02:17:21", "text": "、私は逃してしまった。 えっと、いくつか"}, {"type": "subtitle", "time": 8244.95, "timestamp": "02:17:24", "text": "読んでないものがあります。"}, {"type": "subtitle", "time": 8249.349, "timestamp": "02:17:29", "text": "ああ、私みたいな人がいる。"}, {"type": "subtitle", "time": 8251.429, "timestamp": "02:17:31", "text": "それでは、一人ずつ説明していきます。 さて、"}, {"type": "subtitle", "time": 8253.349, "timestamp": "02:17:33", "text": "皆さんがまだここにいるかどうかわかりませんが、これまで本当に"}, {"type": "subtitle", "time": 8257.669, "timestamp": "02:17:37", "text": "ありがとうございましたと言いたいです。   では"}, {"type": "subtitle", "time": 8260.79, "timestamp": "02:17:40", "text": "、Neon Senさん、"}, {"type": "subtitle", "time": 8262.629, "timestamp": "02:17:42", "text": "今日は来てくれてありがとう。 そして、私"}, {"type": "subtitle", "time": 8266.23, "timestamp": "02:17:46", "text": "のチャンネルをご覧になるのは今回が初めてだと思います。"}, {"type": "subtitle", "time": 8267.99, "timestamp": "02:17:47", "text": "私を見つけてくださって、ありがとうございます。 それは本当に本当に大きな"}, {"type": "subtitle", "time": 8269.589, "timestamp": "02:17:49", "text": "意味があります。  [音楽]"}, {"type": "subtitle", "time": 8271.75, "timestamp": "02:17:51", "text": "お越しいただきありがとうございました。 さて、"}, {"type": "subtitle", "time": 8274.15, "timestamp": "02:17:54", "text": "ネオナとミスター。"}]
[{"type": "subtitle", "time": 6840.229, "timestamp": "01:54:00", "text": "これはすごくクールだ。   そうやって挽いて、"}, {"type": "subtitle", "time": 6849.99, "timestamp": "01:54:09", "text": "自動的に作物を育てて"}, {"type": "subtitle", "time": 6851.91, "timestamp": "01:54:11", "text": "収穫して水やりをしてくれる仲間がいる。"}, {"type": "subtitle", "time": 6853.589, "timestamp": "01:54:13", "text": "はい。 はい。 はい。"}, {"type": "subtitle", "time": 6854.87, "timestamp": "01:54:14", "text": "おお。"}, {"type": "subtitle", "time": 6857.03, "timestamp": "01:54:17", "text": "そして彼らはその食料箱に食料を保管する。"}, {"type": "subtitle", "time": 6859.27, "timestamp": "01:54:19", "text": "空っぽになったら取りに行くだけです。"}, {"type": "subtitle", "time": 6863.83, "timestamp": "01:54:23", "text": "ああ、自動的にそこに置かれるんです。"}, {"type": "subtitle", "time": 6865.03, "timestamp": "01:54:25", "text": "はい。"}, {"type": "subtitle", "time": 6869.03, "timestamp": "01:54:29", "text": "何？ それはあなたにもできることです。"}, {"type": "subtitle", "time": 6872.149, "timestamp": "01:54:32", "text": "ああ、胸部の設定ですね。 あなたはフィルタリングを行います。   わかった"}, {"type": "subtitle", "time": 6883.43, "timestamp": "01:54:43", "text": "これは本当に素晴らしい。"}, {"type": "subtitle", "time": 6886.55, "timestamp": "01:54:46", "text": "そして、キングサイズのベッドもありますよ"}, {"type": "subtitle", "time": 6889.35, "timestamp": "01:54:49", "text": "。 快適なベッド。"}, {"type": "subtitle", "time": 6893.27, "timestamp": "01:54:53", "text": "強いよりは良い。"}]
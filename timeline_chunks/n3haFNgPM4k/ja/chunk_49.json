[{"type": "subtitle", "time": 2942.47, "timestamp": "00:49:02", "text": "そう、ハルク、あの悪者。"}, {"type": "subtitle", "time": 2946.549, "timestamp": "00:49:06", "text": "私は彼に2ダメージを与えて、"}, {"type": "subtitle", "time": 2949.03, "timestamp": "00:49:09", "text": "彼を倒した。"}, {"type": "subtitle", "time": 2952.47, "timestamp": "00:49:12", "text": "クリティカルヒットを狙っています。"}, {"type": "chat", "time": 2953.575, "timestamp": "00:49:13", "author": "@redx7454", "avatar": "https://yt4.ggpht.com/ZnCeavb1XjhCUyF0gPZf2zqHWkwDjnzleyD1oxpd-9re-emmqNet6n-8w_OiHe_rvcNpzZPLgw=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/finger-red-number-oneUCkszU2WH9gy1mb0dV-11UJg/finger-red-number-one"}, {"type": "subtitle", "time": 2955.75, "timestamp": "00:49:15", "text": "私に"}, {"type": "subtitle", "time": 2958.63, "timestamp": "00:49:18", "text": "批評を4つ暗唱してほしいのですか？ うん。 顔のアップ。   来て"}, {"type": "subtitle", "time": 2961.91, "timestamp": "00:49:21", "text": "。 来て。   何てことだ"}, {"type": "subtitle", "time": 2964.549, "timestamp": "00:49:24", "text": "。 これは史上最高の試合だ。"}, {"type": "subtitle", "time": 2971.109, "timestamp": "00:49:31", "text": "アストラドンは干渉しなかった。"}, {"type": "subtitle", "time": 2973.03, "timestamp": "00:49:33", "text": "彼女を殺させてくれ。"}, {"type": "subtitle", "time": 2974.309, "timestamp": "00:49:34", "text": "私は自分の顔に誇りを持っている。"}, {"type": "subtitle", "time": 2977.19, "timestamp": "00:49:37", "text": "ドクターは気に入っている。"}, {"type": "subtitle", "time": 2980.39, "timestamp": "00:49:40", "text": "待って、私のものを盗まないで。"}, {"type": "subtitle", "time": 2984.15, "timestamp": "00:49:44", "text": "私は行くことになっている。"}, {"type": "subtitle", "time": 2987.589, "timestamp": "00:49:47", "text": "基地に来てくれれば、君にあげるよ。 あげましょう。  「OK」を使っても構いません"}, {"type": "subtitle", "time": 2988.95, "timestamp": "00:49:48", "text": "。 わかった。 わかった。"}, {"type": "subtitle", "time": 2991.27, "timestamp": "00:49:51", "text": "ポイントをありがとうございます。   そうすれば"}, {"type": "subtitle", "time": 2993.19, "timestamp": "00:49:53", "text": "彼を使えるようになるよ。 ちょっと待ってください。"}, {"type": "subtitle", "time": 2996.23, "timestamp": "00:49:56", "text": "ああ、鶏を殺すこともできます。"}, {"type": "subtitle", "time": 2999.03, "timestamp": "00:49:59", "text": "うん。"}]
[{"type": "subtitle", "time": 7926.95, "timestamp": "02:12:06", "text": "ああ、見た目は同じだよ、兄弟。 変更点はなく、"}, {"type": "subtitle", "time": 7930.47, "timestamp": "02:12:10", "text": "色が違うだけです。 何？ メガスピアは"}, {"type": "subtitle", "time": 7933.91, "timestamp": "02:12:13", "text": "以前より良くなった。"}, {"type": "subtitle", "time": 7935.27, "timestamp": "02:12:15", "text": "伝説の球体。"}, {"type": "subtitle", "time": 7937.27, "timestamp": "02:12:17", "text": "ああ、できるよ。 ああ、伝説的ですね。"}, {"type": "subtitle", "time": 7939.589, "timestamp": "02:12:19", "text": "すでに巨大な槍が見えている。 その"}, {"type": "subtitle", "time": 7942.39, "timestamp": "02:12:22", "text": "技術とは何ですか？"}, {"type": "subtitle", "time": 7945.109, "timestamp": "02:12:25", "text": "私はギガススペア、ハイパースフィア、ウルトラ"}, {"type": "subtitle", "time": 7946.541, "timestamp": "02:12:26", "text": "スフィア、そしてレジェンダリー"}, {"type": "subtitle", "time": 7947.589, "timestamp": "02:12:27", "text": "[咳払い]スフィアを持っています。"}, {"type": "subtitle", "time": 7948.229, "timestamp": "02:12:28", "text": "おお。"}, {"type": "subtitle", "time": 7970.31, "timestamp": "02:12:50", "text": "うん。 さようなら、犬。 どうもありがとう。"}, {"type": "subtitle", "time": 7972.31, "timestamp": "02:12:52", "text": "こんにちは。 本日はありがとうございました。 とても"}, {"type": "subtitle", "time": 7974.149, "timestamp": "02:12:54", "text": "楽しかったです。 ありがとうございます。"}, {"type": "subtitle", "time": 7976.39, "timestamp": "02:12:56", "text": "とても楽しかったです。"}, {"type": "subtitle", "time": 7978.95, "timestamp": "02:12:58", "text": "今後はもっとこういうことをしましょう。"}, {"type": "subtitle", "time": 7979.99, "timestamp": "02:12:59", "text": "はい。"}]
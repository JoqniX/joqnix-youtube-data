[{"type": "subtitle", "time": 3720.789, "timestamp": "01:02:00", "text": "ええ、じゃあ入れてください。"}, {"type": "subtitle", "time": 3724.87, "timestamp": "01:02:04", "text": "待って、人間は"}, {"type": "subtitle", "time": 3727.19, "timestamp": "01:02:07", "text": "時々普通の"}, {"type": "subtitle", "time": 3728.549, "timestamp": "01:02:08", "text": "友達よりも優れている。"}, {"type": "subtitle", "time": 3731.75, "timestamp": "01:02:11", "text": "君が金色で捉えた"}, {"type": "subtitle", "time": 3739.829, "timestamp": "01:02:19", "text": "。 つまり、私がまだ必要としている"}, {"type": "subtitle", "time": 3744.71, "timestamp": "01:02:24", "text": "パルメタルのインゴットを持っていないということです。"}]
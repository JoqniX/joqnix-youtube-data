[{"type": "subtitle", "time": 6122.709, "timestamp": "01:42:02", "text": "それは基地によりますね"}, {"type": "subtitle", "time": 6126.55, "timestamp": "01:42:06", "text": "。 ああ、ベースのみですね。"}, {"type": "subtitle", "time": 6126.79, "timestamp": "01:42:06", "text": "いいえ、"}, {"type": "subtitle", "time": 6129.03, "timestamp": "01:42:09", "text": "あなたも私のギルドに所属しているので、"}, {"type": "subtitle", "time": 6131.59, "timestamp": "01:42:11", "text": "私の拠点を使うことができます。"}, {"type": "subtitle", "time": 6131.83, "timestamp": "01:42:11", "text": "ああ、それは"}, {"type": "subtitle", "time": 6145.109, "timestamp": "01:42:25", "text": "硫黄の過剰粉砕は非常に厄介です。"}, {"type": "subtitle", "time": 6149.27, "timestamp": "01:42:29", "text": "硫黄、あるいはああ、石英以外の種類がたくさんある"}, {"type": "subtitle", "time": 6152.55, "timestamp": "01:42:32", "text": "。 クワッド。 クワッド。 純粋な水晶。"}, {"type": "subtitle", "time": 6155.03, "timestamp": "01:42:35", "text": "ああ。"}, {"type": "subtitle", "time": 6158.79, "timestamp": "01:42:38", "text": "では、待ってください。 別の基地。"}, {"type": "subtitle", "time": 6160.47, "timestamp": "01:42:40", "text": "ああ、君は複数の塁を破壊しているね。   わかった"}, {"type": "subtitle", "time": 6162.87, "timestamp": "01:42:42", "text": "。 わかった。 わかった。 では、待ってください。 つまり、私には"}, {"type": "subtitle", "time": 6164.95, "timestamp": "01:42:44", "text": "2つの基地があるということです。 いいえ、片方は過剰研削"}, {"type": "subtitle", "time": 6168.87, "timestamp": "01:42:48", "text": "と冷間研削だけです。  M を置くだけでいいです。M"}, {"type": "subtitle", "time": 6170.79, "timestamp": "01:42:50", "text": "M を押して、押さ"}, {"type": "subtitle", "time": 6175.59, "timestamp": "01:42:55", "text": "ないでください。  M とすると、一番上の一番上の一番上に"}, {"type": "subtitle", "time": 6177.91, "timestamp": "01:42:57", "text": "別のベースが見えます"}]
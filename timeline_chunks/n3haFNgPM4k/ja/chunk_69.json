[{"type": "subtitle", "time": 4141.349, "timestamp": "01:09:01", "text": "対処してくれるだろう。   何てことだ"}, {"type": "subtitle", "time": 4142.229, "timestamp": "01:09:02", "text": "。"}, {"type": "subtitle", "time": 4143.91, "timestamp": "01:09:03", "text": "あなたの基地が襲撃されました。 何？"}, {"type": "subtitle", "time": 4157.749, "timestamp": "01:09:17", "text": "何だって？ 私は何か良いことをしたと思った"}, {"type": "subtitle", "time": 4163.749, "timestamp": "01:09:23", "text": "。"}, {"type": "subtitle", "time": 4166.229, "timestamp": "01:09:26", "text": "何？"}, {"type": "subtitle", "time": 4169.269, "timestamp": "01:09:29", "text": "私は指名手配犯だった。   何てことだ"}, {"type": "subtitle", "time": 4172.789, "timestamp": "01:09:32", "text": "。 あなたは何をしましたか？ 私は"}, {"type": "subtitle", "time": 4174.55, "timestamp": "01:09:34", "text": "人を殴ってしまった。 おお。  [笑い] まるで、えっと、なんて"}, {"type": "subtitle", "time": 4180.309, "timestamp": "01:09:40", "text": "言うんだっけ？"}, {"type": "subtitle", "time": 4183.349, "timestamp": "01:09:43", "text": "エルダーリングは現在稼働中です。"}, {"type": "subtitle", "time": 4185.11, "timestamp": "01:09:45", "text": "おお。"}, {"type": "subtitle", "time": 4185.749, "timestamp": "01:09:45", "text": "はぁ。"}, {"type": "subtitle", "time": 4188.149, "timestamp": "01:09:48", "text": "ダッジ。 ダッジ。 パティ。"}, {"type": "subtitle", "time": 4189.829, "timestamp": "01:09:49", "text": "おお。"}, {"type": "chat", "time": 4196.03, "timestamp": "01:09:56", "author": "@Ghewar_Ji_ka_No-1FAN", "avatar": "https://yt4.ggpht.com/CqrtcQvHFvr33XJk7uI96qZ5HyIAEb1ifU1jdPzM7vetPMlUZ4oYhF9BjVOj5xYYbkMi18Zfvg=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/E8MfY5u7JPSXkNAP95GAmAEUCkszU2WH9gy1mb0dV-11UJg/E8MfY5u7JPSXkNAP95GAmAEUCkszU2WH9gy1mb0dV-11UJg/E8MfY5u7JPSXkNAP95GAmAE"}, {"type": "subtitle", "time": 4196.39, "timestamp": "01:09:56", "text": "。 シールド。 彼らにボールを見つけてもらう必要がある"}]
[{"type": "subtitle", "time": 3544.23, "timestamp": "00:59:04", "text": "一体どういうことだ？   「"}, {"type": "subtitle", "time": 3555.109, "timestamp": "00:59:15", "text": "我が神よ。 とにかく、あなたはそれを取り消すべきです。 私はそれを望んでいません"}, {"type": "subtitle", "time": 3556.63, "timestamp": "00:59:16", "text": "。"}, {"type": "subtitle", "time": 3558.47, "timestamp": "00:59:18", "text": "ログアウトする直前に、"}, {"type": "subtitle", "time": 3561.75, "timestamp": "00:59:21", "text": "すべてのリソースを今すぐ配置してください。"}, {"type": "subtitle", "time": 3563.43, "timestamp": "00:59:23", "text": "ああ、もう"}, {"type": "subtitle", "time": 3575.27, "timestamp": "00:59:35", "text": "なぜ彼は最初に来るのか？"}, {"type": "subtitle", "time": 3598.71, "timestamp": "00:59:58", "text": "だから男らしくあれ。 文句を言うのはやめろ。 わかった。"}]
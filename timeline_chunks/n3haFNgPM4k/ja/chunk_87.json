[{"type": "subtitle", "time": 5222.39, "timestamp": "01:27:02", "text": "。 私よりずっと良い仕事ぶりだ。"}, {"type": "subtitle", "time": 5225.03, "timestamp": "01:27:05", "text": "彼が何と言ったか覚えていますか？"}, {"type": "subtitle", "time": 5227.11, "timestamp": "01:27:07", "text": "ソロで挑戦するつもりだ。   先ほども言いました"}, {"type": "subtitle", "time": 5227.75, "timestamp": "01:27:07", "text": "。"}, {"type": "subtitle", "time": 5229.189, "timestamp": "01:27:09", "text": "さあ、こっちへ来てください。 ここに来て。 私は"}, {"type": "subtitle", "time": 5230.31, "timestamp": "01:27:10", "text": "友達ではない。 わかった。"}, {"type": "subtitle", "time": 5232.629, "timestamp": "01:27:12", "text": "彼はその友達を使いたくない。 彼は"}, {"type": "subtitle", "time": 5235.669, "timestamp": "01:27:15", "text": "自分でやりたいと思っている。"}, {"type": "subtitle", "time": 5238.95, "timestamp": "01:27:18", "text": "私は何かに使う金貨を持っています。   えっと"}, {"type": "subtitle", "time": 5242.629, "timestamp": "01:27:22", "text": "、待って。 物を壊すにはどうすればいいですか？"}, {"type": "subtitle", "time": 5244.47, "timestamp": "01:27:24", "text": "出来ますか？"}, {"type": "subtitle", "time": 5246.709, "timestamp": "01:27:26", "text": "精神的な問題だ。"}, {"type": "subtitle", "time": 5249.27, "timestamp": "01:27:29", "text": "ああ、どこですか？ ああ、捨てて"}, {"type": "subtitle", "time": 5251.03, "timestamp": "01:27:31", "text": "偽装する。"}, {"type": "subtitle", "time": 5255.91, "timestamp": "01:27:35", "text": "うん。 ああ、それはそうだ、このカードだ。   メタ"}, {"type": "subtitle", "time": 5256.95, "timestamp": "01:27:36", "text": "ラックス。"}, {"type": "subtitle", "time": 5259.43, "timestamp": "01:27:39", "text": "うん。 ここみたいに、だと思う。"}, {"type": "subtitle", "time": 5259.99, "timestamp": "01:27:39", "text": "ここには来ないでください。"}, {"type": "subtitle", "time": 5260.55, "timestamp": "01:27:40", "text": "うん。"}, {"type": "subtitle", "time": 5261.99, "timestamp": "01:27:41", "text": "これを受け取って。"}, {"type": "subtitle", "time": 5264.07, "timestamp": "01:27:44", "text": "これです。   ここに"}, {"type": "subtitle", "time": 5268.31, "timestamp": "01:27:48", "text": "来て。 ここ。 ここ。 うちにおいで。   わかった"}, {"type": "subtitle", "time": 5270.95, "timestamp": "01:27:50", "text": "。 ぐにゃぐにゃ。 ぐにゃぐにゃ。 右。 そうそう。"}, {"type": "subtitle", "time": 5277.59, "timestamp": "01:27:57", "text": "だから、私たちはそれを"}, {"type": "subtitle", "time": 5278.95, "timestamp": "01:27:58", "text": "受け取る必要がある。   持ってきますよ、あと、"}]
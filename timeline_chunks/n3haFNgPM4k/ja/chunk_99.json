[{"type": "subtitle", "time": 5940.31, "timestamp": "01:39:00", "text": "グローバルPALボックスを作成できます。"}, {"type": "subtitle", "time": 5942.709, "timestamp": "01:39:02", "text": "大丈夫です。 もしあなたがいつか"}, {"type": "subtitle", "time": 5944.79, "timestamp": "01:39:04", "text": "サーバーを作るなら、私はそこでちゃんとちゃんとプレイします"}, {"type": "subtitle", "time": 5947.669, "timestamp": "01:39:07", "text": "。"}, {"type": "subtitle", "time": 5950.31, "timestamp": "01:39:10", "text": "あのね？ サーバーを作成します。"}, {"type": "subtitle", "time": 5952.79, "timestamp": "01:39:12", "text": "はぁ？ じゃあ、ちゃんと演奏してみます"}, {"type": "subtitle", "time": 5976.229, "timestamp": "01:39:36", "text": "初期段階の作品をどこに位置づけたらいいのか、今は分かりません。 もしあなたの友人の"}, {"type": "subtitle", "time": 5979.35, "timestamp": "01:39:39", "text": "正気がゼロだったら、どうすればいいでしょうか？"}, {"type": "subtitle", "time": 5983.03, "timestamp": "01:39:43", "text": "彼らを殺して新しいものを手に入れるべきか、"}, {"type": "subtitle", "time": 5986.104, "timestamp": "01:39:46", "text": "それとも回復させるべきか？"}, {"type": "subtitle", "time": 5987.43, "timestamp": "01:39:47", "text": "[笑い] それはできますよ"}, {"type": "subtitle", "time": 5994.95, "timestamp": "01:39:54", "text": "あ、でももう行かなくちゃ。"}]
[{"type": "subtitle", "time": 5822.709, "timestamp": "01:37:02", "text": "Eキーを押すと、"}, {"type": "subtitle", "time": 5825.189, "timestamp": "01:37:05", "text": "ここにあなたの友達全員が表示されます。"}, {"type": "subtitle", "time": 5826.87, "timestamp": "01:37:06", "text": "そうそう。"}, {"type": "subtitle", "time": 5829.189, "timestamp": "01:37:09", "text": "そして、"}, {"type": "subtitle", "time": 5830.39, "timestamp": "01:37:10", "text": "好きなものを装備できます。"}, {"type": "subtitle", "time": 5839.75, "timestamp": "01:37:19", "text": "それらを入手できる場所を知っているでしょう。"}, {"type": "subtitle", "time": 5844.39, "timestamp": "01:37:24", "text": "人々の檻のような場所で見つけたと思う。 まるで"}, {"type": "subtitle", "time": 5847.109, "timestamp": "01:37:27", "text": "檻から彼女を連れ出したばかりみたいだ。"}, {"type": "subtitle", "time": 5849.75, "timestamp": "01:37:29", "text": "人々は彼女を罠にかけようとしていた。"}, {"type": "subtitle", "time": 5850.87, "timestamp": "01:37:30", "text": "私は死んだ。"}, {"type": "subtitle", "time": 5852.229, "timestamp": "01:37:32", "text": "ああ、じゃあ"}, {"type": "subtitle", "time": 5855.27, "timestamp": "01:37:35", "text": "友達も手放せるんですね。"}, {"type": "subtitle", "time": 5857.51, "timestamp": "01:37:37", "text": "うん。"}, {"type": "subtitle", "time": 5861.43, "timestamp": "01:37:41", "text": "ああ、なんてことだ、私は死んでしまった。"}, {"type": "subtitle", "time": 5864.95, "timestamp": "01:37:44", "text": "お母さん、あなたも繁殖できるよ。"}, {"type": "subtitle", "time": 5874.709, "timestamp": "01:37:54", "text": "フォローしていただきありがとうございます"}]
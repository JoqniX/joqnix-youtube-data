[{"type": "subtitle", "time": 7167.109, "timestamp": "01:59:27", "text": "待って、ジャスミンは何か力を持っているの？"}, {"type": "subtitle", "time": 7169.43, "timestamp": "01:59:29", "text": "うんうん。 いいえ、彼女はそうしません。 少なくとも彼女は"}, {"type": "subtitle", "time": 7173.189, "timestamp": "01:59:33", "text": "まともに仕事をしていない。 いいえ。ええ"}, {"type": "subtitle", "time": 7176.149, "timestamp": "01:59:36", "text": "、彼女にそれを手に入れてほしかったのですが、はい。"}, {"type": "subtitle", "time": 7178.87, "timestamp": "01:59:38", "text": "彼女はこのゲームをきっと気に入っただろう。"}, {"type": "subtitle", "time": 7187.83, "timestamp": "01:59:47", "text": "振るタイプだと思うんです（笑）"}, {"type": "subtitle", "time": 7195.669, "timestamp": "01:59:55", "text": "予備の部品に交換させてください。 それと、"}]
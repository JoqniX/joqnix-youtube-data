[{"type": "subtitle", "time": 2401.03, "timestamp": "00:40:01", "text": "。 木材が必要だ。 わかった。"}, {"type": "subtitle", "time": 2409.03, "timestamp": "00:40:09", "text": "おお。 それを受け取って。"}, {"type": "subtitle", "time": 2428.23, "timestamp": "00:40:28", "text": "。 ニース。   私のものを"}, {"type": "subtitle", "time": 2434.71, "timestamp": "00:40:34", "text": "強くしよう。"}, {"type": "subtitle", "time": 2437.829, "timestamp": "00:40:37", "text": "手がくっついてしまった。"}, {"type": "subtitle", "time": 2440.95, "timestamp": "00:40:40", "text": "おお。 そうそう。"}, {"type": "subtitle", "time": 2444.069, "timestamp": "00:40:44", "text": "何？ スタミナ。 スタミナ。"}, {"type": "subtitle", "time": 2454.47, "timestamp": "00:40:54", "text": "アフリカの番だ。"}, {"type": "subtitle", "time": 2457.43, "timestamp": "00:40:57", "text": "はい。"}]
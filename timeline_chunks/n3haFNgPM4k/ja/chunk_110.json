[{"type": "subtitle", "time": 6600.629, "timestamp": "01:50:00", "text": "札を携えておく必要がある。 自分の部屋に行って、"}, {"type": "subtitle", "time": 6605.109, "timestamp": "01:50:05", "text": "ナイトウィングを連れてきて、彼のサドルを作ってください。"}, {"type": "subtitle", "time": 6605.59, "timestamp": "01:50:05", "text": "うん。"}, {"type": "subtitle", "time": 6607.43, "timestamp": "01:50:07", "text": "そして、"}, {"type": "subtitle", "time": 6609.189, "timestamp": "01:50:09", "text": "私が話しているこれらの親和性をすべて集めて、それを"}, {"type": "subtitle", "time": 6611.189, "timestamp": "01:50:11", "text": "この像に与えるのです。"}, {"type": "subtitle", "time": 6622.39, "timestamp": "01:50:22", "text": "でも、"}, {"type": "subtitle", "time": 6625.35, "timestamp": "01:50:25", "text": "サーバーを作るなら、シングルプレイではプレイできないと思うよ"}, {"type": "subtitle", "time": 6628.55, "timestamp": "01:50:28", "text": "。   成功するかどうかわからない"}, {"type": "subtitle", "time": 6630.39, "timestamp": "01:50:30", "text": "。 支払いは済んでいます。   いいえ。ええ。"}, {"type": "subtitle", "time": 6633.99, "timestamp": "01:50:33", "text": "ああ、支払われたよ。"}, {"type": "subtitle", "time": 6636.07, "timestamp": "01:50:36", "text": "サーバーというのは、"}, {"type": "subtitle", "time": 6648.79, "timestamp": "01:50:48", "text": "ゲームMODを見てみます。"}]
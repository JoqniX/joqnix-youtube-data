[{"type": "subtitle", "time": 8522.15, "timestamp": "02:22:02", "text": "私のチャンネルを見つけてくださってありがとうございます"}, {"type": "subtitle", "time": 8533.19, "timestamp": "02:22:13", "text": "ええ、[笑い]"}, {"type": "subtitle", "time": 8536.389, "timestamp": "02:22:16", "text": "しおりささんに感謝しなければなりません。"}, {"type": "subtitle", "time": 8540.15, "timestamp": "02:22:20", "text": "彼女がそうだったからだと思うんだけど、つまり、"}, {"type": "subtitle", "time": 8542.71, "timestamp": "02:22:22", "text": "今日は誰も配信しなかったと思う。私以外は。"}, {"type": "subtitle", "time": 8545.91, "timestamp": "02:22:25", "text": "今日は配信したかったから"}, {"type": "subtitle", "time": 8548.87, "timestamp": "02:22:28", "text": "。デスクトップ配信をあまりやっていないと感じたから。"}, {"type": "subtitle", "time": 8552.79, "timestamp": "02:22:32", "text": "それを配信したかったんです。 うん。 だから私はそれを"}, {"type": "subtitle", "time": 8556.71, "timestamp": "02:22:36", "text": "ストリーミング配信した。 だから、ある意味では"}, {"type": "subtitle", "time": 8559.349, "timestamp": "02:22:39", "text": "コラボレーションではなかったけれど、私の友人たちに感謝します。"}, {"type": "subtitle", "time": 8561.67, "timestamp": "02:22:41", "text": "うん。 今日は音楽の"}, {"type": "subtitle", "time": 8566.15, "timestamp": "02:22:46", "text": "友情の日でもありましたよね。 そうだよ、そうだよ"}, {"type": "subtitle", "time": 8568.55, "timestamp": "02:22:48", "text": "。 去年は、"}, {"type": "subtitle", "time": 8570.95, "timestamp": "02:22:50", "text": "Discord の全員に「"}, {"type": "subtitle", "time": 8573.429, "timestamp": "02:22:53", "text": "ハッピーフレンドシップデー」ってメッセージを送るのが好きだった。 今年はできなかった"}, {"type": "subtitle", "time": 8575.75, "timestamp": "02:22:55", "text": "。 今日は昨日もすごく忙しかった"}, {"type": "subtitle", "time": 8577.67, "timestamp": "02:22:57", "text": "。  [音楽] やらなきゃいけないこと"}]
[{"type": "subtitle", "time": 4397.11, "timestamp": "01:13:17", "text": "よし、もっと良いギアが必要だと思う。"}, {"type": "subtitle", "time": 4411.43, "timestamp": "01:13:31", "text": "。   何てことだ"}, {"type": "subtitle", "time": 4417.91, "timestamp": "01:13:37", "text": "しかし、ここは別の場所だ。   私は何か別のものを"}, {"type": "subtitle", "time": 4431.51, "timestamp": "01:13:51", "text": "ヨサ、戻ってきて。 戻ってくる。"}, {"type": "subtitle", "time": 4433.11, "timestamp": "01:13:53", "text": "えっと、ベースへ。"}, {"type": "subtitle", "time": 4436.39, "timestamp": "01:13:56", "text": "うん。 うん。 うん。"}, {"type": "subtitle", "time": 4438.39, "timestamp": "01:13:58", "text": "私たちはランプを取りやすい場所へ行きます"}]
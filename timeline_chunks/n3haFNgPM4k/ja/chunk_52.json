[{"type": "subtitle", "time": 3130.549, "timestamp": "00:52:10", "text": "犯罪活動が進行中。 何てことだ。"}, {"type": "subtitle", "time": 3132.309, "timestamp": "00:52:12", "text": "私は彼を殺した。"}, {"type": "subtitle", "time": 3133.51, "timestamp": "00:52:13", "text": "大丈夫。 ここに来て。   何てことだ"}, {"type": "subtitle", "time": 3134.15, "timestamp": "00:52:14", "text": "。   ここに"}, {"type": "subtitle", "time": 3135.03, "timestamp": "00:52:15", "text": "来て。 来る。"}, {"type": "subtitle", "time": 3138.549, "timestamp": "00:52:18", "text": "おお。 私は何でも殺せる。"}, {"type": "subtitle", "time": 3139.109, "timestamp": "00:52:19", "text": "うん。"}, {"type": "subtitle", "time": 3140.15, "timestamp": "00:52:20", "text": "はい、できますよ。"}, {"type": "subtitle", "time": 3142.87, "timestamp": "00:52:22", "text": "クソじゃない。"}, {"type": "subtitle", "time": 3145.589, "timestamp": "00:52:25", "text": "彼らは復活する。 彼らには物語上の都合による"}, {"type": "subtitle", "time": 3147.19, "timestamp": "00:52:27", "text": "保護がある。"}, {"type": "subtitle", "time": 3154.47, "timestamp": "00:52:34", "text": "これを解除してください。"}, {"type": "subtitle", "time": 3158.23, "timestamp": "00:52:38", "text": "ああ、このTPはとても良いですね。"}, {"type": "subtitle", "time": 3160.79, "timestamp": "00:52:40", "text": "ここに来たら、私の"}, {"type": "subtitle", "time": 3161.67, "timestamp": "00:52:41", "text": "後ろについてきてください。"}, {"type": "subtitle", "time": 3164.87, "timestamp": "00:52:44", "text": "私の友人2人が右奥で亡くなりました"}, {"type": "subtitle", "time": 3172.23, "timestamp": "00:52:52", "text": "ここは村です。"}, {"type": "subtitle", "time": 3174.309, "timestamp": "00:52:54", "text": "うん。 うん。 うん。 ですから、正面に行けば、"}]
[{"type": "subtitle", "time": 4084.87, "timestamp": "01:08:04", "text": "。 半分の馬力。 半分の馬力。 私は"}, {"type": "subtitle", "time": 4086.789, "timestamp": "01:08:06", "text": "確信しています。   戻ってくる"}, {"type": "subtitle", "time": 4095.029, "timestamp": "01:08:15", "text": "、お願いします。"}, {"type": "subtitle", "time": 4099.027, "timestamp": "01:08:19", "text": "ポケモンの話はやめてくれませんか？"}, {"type": "subtitle", "time": 4099.829, "timestamp": "01:08:19", "text": "[笑い]"}, {"type": "subtitle", "time": 4101.11, "timestamp": "01:08:21", "text": "君はきっとトラブルに巻き込まれるよ"}, {"type": "subtitle", "time": 4102.229, "timestamp": "01:08:22", "text": "。   ごめんなさい"}, {"type": "subtitle", "time": 4109.99, "timestamp": "01:08:29", "text": "ジョー、それは笑い事じゃないよ。 笑い事じゃない。"}, {"type": "subtitle", "time": 4128.709, "timestamp": "01:08:48", "text": "何？   えっと"}, {"type": "subtitle", "time": 4130.709, "timestamp": "01:08:50", "text": "、"}, {"type": "subtitle", "time": 4134.309, "timestamp": "01:08:54", "text": "何？ これは何ですか？"}, {"type": "subtitle", "time": 4136.309, "timestamp": "01:08:56", "text": "何？"}, {"type": "subtitle", "time": 4139.51, "timestamp": "01:08:59", "text": "あなたの拠点。 攻撃を受けている。 彼らが"}]
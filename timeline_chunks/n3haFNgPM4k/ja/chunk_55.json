[{"type": "subtitle", "time": 3313.19, "timestamp": "00:55:13", "text": "上に。"}, {"type": "subtitle", "time": 3315.19, "timestamp": "00:55:15", "text": "よし、じゃあこっちへ行こう。"}, {"type": "subtitle", "time": 3318.23, "timestamp": "00:55:18", "text": "誰か今すぐ石ころが必要だ。"}, {"type": "subtitle", "time": 3320.95, "timestamp": "00:55:20", "text": "君たちは何をしているの？"}, {"type": "subtitle", "time": 3321.91, "timestamp": "00:55:21", "text": "何が"}, {"type": "subtitle", "time": 3322.87, "timestamp": "00:55:22", "text": "爆発したんだ？"}, {"type": "subtitle", "time": 3323.589, "timestamp": "00:55:23", "text": "爆発する。 わかった。"}, {"type": "subtitle", "time": 3325.589, "timestamp": "00:55:25", "text": "ああ、石よ。"}, {"type": "subtitle", "time": 3327.829, "timestamp": "00:55:27", "text": "うん。"}, {"type": "subtitle", "time": 3330.47, "timestamp": "00:55:30", "text": "私は今、まさに山の頂上にいます"}, {"type": "subtitle", "time": 3332.23, "timestamp": "00:55:32", "text": "。 はい。"}, {"type": "subtitle", "time": 3334.15, "timestamp": "00:55:34", "text": "なぜ地図上でお互いが見えないのか、なぜ見えないのか、なぜ見え"}, {"type": "subtitle", "time": 3354.47, "timestamp": "00:55:54", "text": "大丈夫です。 ああ、もういいや。"}, {"type": "subtitle", "time": 3357.349, "timestamp": "00:55:57", "text": "待ってはいけません。 皆さん、基地に来ていただけますか？"}, {"type": "subtitle", "time": 3358.95, "timestamp": "00:55:58", "text": "近日公開。 近日公開。 近日公開。 ああ、"}]
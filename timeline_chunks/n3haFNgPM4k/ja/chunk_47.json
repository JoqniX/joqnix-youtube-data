[{"type": "subtitle", "time": 2821.03, "timestamp": "00:47:01", "text": "ああ、攻撃的だ。"}, {"type": "subtitle", "time": 2822.63, "timestamp": "00:47:02", "text": "うん。"}, {"type": "subtitle", "time": 2825.43, "timestamp": "00:47:05", "text": "これからはあなたと一緒にいます。"}, {"type": "subtitle", "time": 2827.99, "timestamp": "00:47:07", "text": "ああ、まるでペットみたいだ。"}, {"type": "subtitle", "time": 2833.27, "timestamp": "00:47:13", "text": "調べてみましょう。"}, {"type": "subtitle", "time": 2835.43, "timestamp": "00:47:15", "text": "もう片方はどうですか？ もう"}, {"type": "subtitle", "time": 2837.829, "timestamp": "00:47:17", "text": "一方の友達は、"}, {"type": "subtitle", "time": 2844.309, "timestamp": "00:47:24", "text": "キーボードの1と3のようにスクロールすると、"}, {"type": "subtitle", "time": 2848.87, "timestamp": "00:47:28", "text": "左下をスクロールできるのがわかります"}, {"type": "subtitle", "time": 2850.63, "timestamp": "00:47:30", "text": "。"}, {"type": "subtitle", "time": 2851.109, "timestamp": "00:47:31", "text": "うん。"}, {"type": "subtitle", "time": 2852.309, "timestamp": "00:47:32", "text": "おお。"}, {"type": "subtitle", "time": 2856.55, "timestamp": "00:47:36", "text": "それからEキーを押すと、それらが出てきます。"}, {"type": "subtitle", "time": 2861.03, "timestamp": "00:47:41", "text": "そうそう。 どちらを外すかはあなたが選べます"}, {"type": "subtitle", "time": 2869.91, "timestamp": "00:47:49", "text": "うん。"}, {"type": "subtitle", "time": 2871.75, "timestamp": "00:47:51", "text": "ああ、それは違う"}, {"type": "subtitle", "time": 2873.829, "timestamp": "00:47:53", "text": "、それは私たちの場所だけのようなものです"}, {"type": "subtitle", "time": 2876.39, "timestamp": "00:47:56", "text": "。"}, {"type": "subtitle", "time": 2878.23, "timestamp": "00:47:58", "text": "わあ、すごい。"}, {"type": "chat", "time": 2879.456, "timestamp": "00:47:59", "author": "@Ghewar_Ji_ka_No-1FAN", "avatar": "https://yt4.ggpht.com/CqrtcQvHFvr33XJk7uI96qZ5HyIAEb1ifU1jdPzM7vetPMlUZ4oYhF9BjVOj5xYYbkMi18Zfvg=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/E8MfY5u7JPSXkNAP95GAmAEUCkszU2WH9gy1mb0dV-11UJg/E8MfY5u7JPSXkNAP95GAmAE"}]
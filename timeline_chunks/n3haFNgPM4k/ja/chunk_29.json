[{"type": "subtitle", "time": 1742.07, "timestamp": "00:29:02", "text": "私が作った白い服のことだったよね。"}, {"type": "subtitle", "time": 1743.11, "timestamp": "00:29:03", "text": "これは重大な問題だ。"}, {"type": "subtitle", "time": 1747.669, "timestamp": "00:29:07", "text": "いや、いや、いや。 君は私があげたものを無駄にしただけだ"}, {"type": "subtitle", "time": 1750.07, "timestamp": "00:29:10", "text": "。"}, {"type": "chat", "time": 1752.406, "timestamp": "00:29:12", "author": "@SAMPAD0xd", "avatar": "https://yt4.ggpht.com/z-ouOkiDmuLnDm7vYDgN15VrTbt3sZOYbPL2lTNTVk0bk60NZ3SuexCRYV5ICoE55YuyGhpt9w=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/finger-red-number-one"}, {"type": "subtitle", "time": 1753.99, "timestamp": "00:29:13", "text": "そうそう。   ロックを"}, {"type": "subtitle", "time": 1756.149, "timestamp": "00:29:16", "text": "解除する必要があります。"}, {"type": "subtitle", "time": 1759.43, "timestamp": "00:29:19", "text": "うん。 自分で作るしかないよ。 一時的な措置でいいと思います"}, {"type": "subtitle", "time": 1761.19, "timestamp": "00:29:21", "text": "。"}, {"type": "subtitle", "time": 1761.99, "timestamp": "00:29:21", "text": "うん。"}, {"type": "subtitle", "time": 1775.75, "timestamp": "00:29:35", "text": "猫好きのおばさん。 彼女は私のためにそうしてくれたんです。"}, {"type": "chat", "time": 1778.678, "timestamp": "00:29:38", "author": "@redx7454", "avatar": "https://yt4.ggpht.com/ZnCeavb1XjhCUyF0gPZf2zqHWkwDjnzleyD1oxpd-9re-emmqNet6n-8w_OiHe_rvcNpzZPLgw=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/finger-red-number-one"}, {"type": "subtitle", "time": 1779.11, "timestamp": "00:29:39", "text": "ああ、彼女は"}, {"type": "subtitle", "time": 1781.669, "timestamp": "00:29:41", "text": "猫の踊りを踊る。 たぶん"}, {"type": "subtitle", "time": 1796.789, "timestamp": "00:29:56", "text": "ええ、"}, {"type": "subtitle", "time": 1799.43, "timestamp": "00:29:59", "text": "何かを作っているんですね。 あるいは、"}]
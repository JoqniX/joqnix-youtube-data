[{"type": "subtitle", "time": 4023.43, "timestamp": "01:07:03", "text": "そうみたいに。 うん。 ちょっと待って、すぐに繰り返すよ"}, {"type": "subtitle", "time": 4025.43, "timestamp": "01:07:05", "text": "。"}, {"type": "subtitle", "time": 4030.069, "timestamp": "01:07:10", "text": "私は最強の仲間の一人を手に入れた。"}, {"type": "subtitle", "time": 4030.87, "timestamp": "01:07:10", "text": "死んだドラゴンよ、来い。   死んでしまえ"}, {"type": "subtitle", "time": 4033.51, "timestamp": "01:07:13", "text": "。 死んでしまえ。 死んでしまえ。 死んでしまえ。   死んでしまえ"}, {"type": "subtitle", "time": 4035.43, "timestamp": "01:07:15", "text": "。 死んでしまえ。 彼に殺させてしまえ"}, {"type": "subtitle", "time": 4037.67, "timestamp": "01:07:17", "text": "。"}, {"type": "subtitle", "time": 4039.19, "timestamp": "01:07:19", "text": "なぜ？   死んでしまえ"}, {"type": "subtitle", "time": 4042.309, "timestamp": "01:07:22", "text": "。 いいえ。諦めてはいけません"}, {"type": "subtitle", "time": 4045.43, "timestamp": "01:07:25", "text": "。 あきらめないで。"}, {"type": "subtitle", "time": 4048.789, "timestamp": "01:07:28", "text": "私はそう感じています。"}, {"type": "subtitle", "time": 4049.589, "timestamp": "01:07:29", "text": "あなたはできないでしょう。"}, {"type": "subtitle", "time": 4052.23, "timestamp": "01:07:32", "text": "ああ、なんてことだ。"}, {"type": "subtitle", "time": 4055.51, "timestamp": "01:07:35", "text": "私は戻ってきます。"}, {"type": "subtitle", "time": 4063.029, "timestamp": "01:07:43", "text": "君の剣が必要だ。 ああ、"}, {"type": "subtitle", "time": 4065.349, "timestamp": "01:07:45", "text": "あなたの剣が必要です。 待って、私、"}, {"type": "subtitle", "time": 4068.63, "timestamp": "01:07:48", "text": "ダメージを与えてる。 これを見てください。"}, {"type": "subtitle", "time": 4076.63, "timestamp": "01:07:56", "text": "なあ、今すぐ来れる？"}]
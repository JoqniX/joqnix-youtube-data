[{"type": "subtitle", "time": 6301.189, "timestamp": "01:45:01", "text": "待って、鶏の基地に行くよ。"}, {"type": "subtitle", "time": 6303.27, "timestamp": "01:45:03", "text": "進路を変えなければならない。 ああ、"}, {"type": "subtitle", "time": 6305.669, "timestamp": "01:45:05", "text": "もし君が僕の本拠地に来てくれたら、見せてあげるよ。"}, {"type": "subtitle", "time": 6308.39, "timestamp": "01:45:08", "text": "あなたの主な拠点はどこですか？"}, {"type": "subtitle", "time": 6310.79, "timestamp": "01:45:10", "text": "ビーチが1つだけのやつ。"}, {"type": "subtitle", "time": 6325.51, "timestamp": "01:45:25", "text": "。   ここに"}, {"type": "subtitle", "time": 6329.27, "timestamp": "01:45:29", "text": "来て。 これは、OPの"}, {"type": "subtitle", "time": 6332.629, "timestamp": "01:45:32", "text": "仲間です。 まるで最大のドラゴンみたいだ。"}, {"type": "subtitle", "time": 6333.109, "timestamp": "01:45:33", "text": "うん。"}, {"type": "subtitle", "time": 6334.229, "timestamp": "01:45:34", "text": "はい。"}, {"type": "subtitle", "time": 6337.188, "timestamp": "01:45:37", "text": "ああ、"}, {"type": "subtitle", "time": 6346.55, "timestamp": "01:45:46", "text": "これが探検隊です。"}, {"type": "subtitle", "time": 6349.99, "timestamp": "01:45:49", "text": "こうして、オルスや"}, {"type": "subtitle", "time": 6352.95, "timestamp": "01:45:52", "text": "仲間などを手に入れることができるのです。"}, {"type": "subtitle", "time": 6356.149, "timestamp": "01:45:56", "text": "友達じゃないよ。  Oといくつかのメダルだけです。私は"}, {"type": "subtitle", "time": 6358.07, "timestamp": "01:45:58", "text": "今、PALボックスにたくさんのPALを持っているので、"}]
[{"type": "subtitle", "time": 5403.35, "timestamp": "01:30:03", "text": "、100で十分です。"}, {"type": "subtitle", "time": 5407.59, "timestamp": "01:30:07", "text": "ゾーイはまるで小さな女の子のようだ。 じゃあ、行きます。"}, {"type": "subtitle", "time": 5409.189, "timestamp": "01:30:09", "text": "彼女はそれに対して無力なのだろうか？"}, {"type": "subtitle", "time": 5411.27, "timestamp": "01:30:11", "text": "どなたも私の精製物を取らないでください。 私は"}, {"type": "subtitle", "time": 5419.51, "timestamp": "01:30:19", "text": "メインの炉のような炉のためにそれをやらなければなりません。   わかった"}, {"type": "subtitle", "time": 5420.39, "timestamp": "01:30:20", "text": "、"}, {"type": "subtitle", "time": 5423.83, "timestamp": "01:30:23", "text": "私は受け取らないよ。"}, {"type": "subtitle", "time": 5428.692, "timestamp": "01:30:28", "text": "彼女がなぜそうするのかさえわからないけど"}, {"type": "subtitle", "time": 5436.552, "timestamp": "01:30:36", "text": "彼女はただそれを選ぶだけだよ。 黙れ。"}, {"type": "subtitle", "time": 5441.83, "timestamp": "01:30:41", "text": "ジョーはなぜか、私の精錬したインゴットを8個、"}, {"type": "subtitle", "time": 5443.91, "timestamp": "01:30:43", "text": "自分の箱の中に保管していた。"}, {"type": "subtitle", "time": 5446.39, "timestamp": "01:30:46", "text": "私は"}]
[{"type": "subtitle", "time": 3062.23, "timestamp": "00:51:02", "text": "。 うん。   えっと"}, {"type": "subtitle", "time": 3066.23, "timestamp": "00:51:06", "text": "、どう思いますか？"}, {"type": "subtitle", "time": 3069.03, "timestamp": "00:51:09", "text": "パラシュート降下する。"}, {"type": "subtitle", "time": 3071.27, "timestamp": "00:51:11", "text": "私は転びそうです。 いや、いや、いや。"}, {"type": "subtitle", "time": 3076.15, "timestamp": "00:51:16", "text": "どこにいるの？"}, {"type": "subtitle", "time": 3080.23, "timestamp": "00:51:20", "text": "キングペッカも一緒にいるのはどれですか？"}, {"type": "subtitle", "time": 3098.23, "timestamp": "00:51:38", "text": "光る方は、まるで輝く友達のようだ。"}, {"type": "subtitle", "time": 3101.03, "timestamp": "00:51:41", "text": "待って、"}, {"type": "subtitle", "time": 3103.91, "timestamp": "00:51:43", "text": "大きなバラのようなラムボールを牧場に置くことができると思う。"}, {"type": "subtitle", "time": 3107.349, "timestamp": "00:51:47", "text": "羊毛も生産されるだろう。 私はアルファ"}, {"type": "subtitle", "time": 3108.95, "timestamp": "00:51:48", "text": "ワラを持っています。"}, {"type": "subtitle", "time": 3115.03, "timestamp": "00:51:55", "text": "農家さんです。"}]
[{"type": "subtitle", "time": 7391.51, "timestamp": "02:03:11", "text": "何か食べようと思います。"}, {"type": "subtitle", "time": 7400.629, "timestamp": "02:03:20", "text": "12時になる。そろそろ締めくくらなくちゃ。"}, {"type": "subtitle", "time": 7418.31, "timestamp": "02:03:38", "text": "今日は気分がとても良かったので、あと20個必要です。 でも、本当に嬉しい"}, {"type": "subtitle", "time": 7420.95, "timestamp": "02:03:40", "text": "。 今日は皆さんと一緒に行くのに少し遅れてしまいました"}, {"type": "subtitle", "time": 7423.51, "timestamp": "02:03:43", "text": "。"}, {"type": "subtitle", "time": 7425.75, "timestamp": "02:03:45", "text": "うん。   ああ"}, {"type": "subtitle", "time": 7428.55, "timestamp": "02:03:48", "text": "、本当に素晴らしかったよ。 もし私が"}, {"type": "subtitle", "time": 7430.55, "timestamp": "02:03:50", "text": "今遅れていなければ、今日のクエストでレベル20に到達していたはずだ"}, {"type": "subtitle", "time": 7439.109, "timestamp": "02:03:59", "text": "いや、君は"}]
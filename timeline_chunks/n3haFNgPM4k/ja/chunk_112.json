[{"type": "subtitle", "time": 6721.35, "timestamp": "01:52:01", "text": "もし望むなら、ナイトホークをあげてもいいよ。"}, {"type": "subtitle", "time": 6723.75, "timestamp": "01:52:03", "text": "夜間フックをお持ちですね。"}, {"type": "subtitle", "time": 6725.35, "timestamp": "01:52:05", "text": "ええ、"}, {"type": "subtitle", "time": 6732.629, "timestamp": "01:52:12", "text": "ナイトウィング。 それは「おやすみ」じゃないよ。"}, {"type": "subtitle", "time": 6735.99, "timestamp": "01:52:15", "text": "あれは実はナイトウィングだよ。   私がこれまでに出した"}, {"type": "subtitle", "time": 6739.589, "timestamp": "01:52:19", "text": "最高得点を見せてください。"}, {"type": "subtitle", "time": 6747.51, "timestamp": "01:52:27", "text": "私が持っている最高レベルは"}, {"type": "subtitle", "time": 6749.35, "timestamp": "01:52:29", "text": "13です。"}, {"type": "subtitle", "time": 6751.51, "timestamp": "01:52:31", "text": "ああ、こっちに来て"}, {"type": "subtitle", "time": 6753.83, "timestamp": "01:52:33", "text": "。 さあ、行くよ"}, {"type": "subtitle", "time": 6755.51, "timestamp": "01:52:35", "text": "。"}, {"type": "subtitle", "time": 6777.83, "timestamp": "01:52:57", "text": "彼は"}]
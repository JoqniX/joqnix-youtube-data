[{"type": "subtitle", "time": 6360.149, "timestamp": "01:46:00", "text": "遠征隊に送ることができます。   ああ、"}, {"type": "subtitle", "time": 6367.669, "timestamp": "01:46:07", "text": "私のPALボックスではそのまま使えますよ。   わかった"}, {"type": "subtitle", "time": 6370.149, "timestamp": "01:46:10", "text": "。 わかった。 それはとても素晴らしいですね。"}, {"type": "subtitle", "time": 6373.03, "timestamp": "01:46:13", "text": "では、"}, {"type": "subtitle", "time": 6374.709, "timestamp": "01:46:14", "text": "食品の保管などを"}, {"type": "subtitle", "time": 6377.189, "timestamp": "01:46:17", "text": "自動的に行うにはどうすればいいのでしょうか？   今のところ、"}, {"type": "subtitle", "time": 6379.75, "timestamp": "01:46:19", "text": "食品の自動化は行っていません。 例えば、"}, {"type": "subtitle", "time": 6381.189, "timestamp": "01:46:21", "text": "さまざまな権限を使って作業を割り当てることで、自動化することができます"}, {"type": "subtitle", "time": 6384.709, "timestamp": "01:46:24", "text": "。"}, {"type": "subtitle", "time": 6404.79, "timestamp": "01:46:44", "text": "このゲームは"}, {"type": "subtitle", "time": 6407.35, "timestamp": "01:46:47", "text": "発売当初からずっとプレイしたいと思っていました。 それで私は、「ああ、今度機会があったら"}, {"type": "subtitle", "time": 6411.51, "timestamp": "01:46:51", "text": "買おう」と思ったんです。"}]
[{"type": "subtitle", "time": 3369.589, "timestamp": "00:56:09", "text": "私は自分のためにとてもかわいいものを作っています"}, {"type": "subtitle", "time": 3370.789, "timestamp": "00:56:10", "text": "。"}, {"type": "subtitle", "time": 3372.39, "timestamp": "00:56:12", "text": "あなたのためにとてもかわいいものを買ってきました。"}, {"type": "subtitle", "time": 3374.789, "timestamp": "00:56:14", "text": "タワーのチェックポイントに到達しました。 さあ行こう。"}, {"type": "subtitle", "time": 3386.71, "timestamp": "00:56:26", "text": "好きです。 私はあなたにそれを与えるつもりはありません。"}, {"type": "subtitle", "time": 3389.43, "timestamp": "00:56:29", "text": "私はそれについて話していません。   わかった"}, {"type": "subtitle", "time": 3391.43, "timestamp": "00:56:31", "text": "。 でも、あなたは"}, {"type": "subtitle", "time": 3392.47, "timestamp": "00:56:32", "text": "帽子の話をしていましたよね。"}, {"type": "subtitle", "time": 3394.63, "timestamp": "00:56:34", "text": "帽子の話をしているのではない。"}, {"type": "subtitle", "time": 3397.349, "timestamp": "00:56:37", "text": "うん。 彼女に可愛いものをあげて。   わかった"}, {"type": "subtitle", "time": 3399.829, "timestamp": "00:56:39", "text": "。 それで、私は"}, {"type": "subtitle", "time": 3402.15, "timestamp": "00:56:42", "text": "帽子の話をしていたんです。 紫色の"}, {"type": "subtitle", "time": 3403.19, "timestamp": "00:56:43", "text": "帽子。"}, {"type": "subtitle", "time": 3406.39, "timestamp": "00:56:46", "text": "私は帽子のことを言っているのではありません。"}, {"type": "subtitle", "time": 3410.95, "timestamp": "00:56:50", "text": "うん。 これを見てください。 我が神よ。 とんでもない。"}, {"type": "subtitle", "time": 3411.27, "timestamp": "00:56:51", "text": "何？   何てことだ"}]
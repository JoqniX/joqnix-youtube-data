[{"type": "subtitle", "time": 4202.79, "timestamp": "01:10:02", "text": "チル。"}, {"type": "subtitle", "time": 4205.99, "timestamp": "01:10:05", "text": "それはどこへ行ったの？"}, {"type": "subtitle", "time": 4209.75, "timestamp": "01:10:09", "text": "犬のコイン。 私は犬のコインを20枚持っています。 どうやって？"}, {"type": "subtitle", "time": 4210.87, "timestamp": "01:10:10", "text": "ドッグコインとは何ですか？"}, {"type": "subtitle", "time": 4219.83, "timestamp": "01:10:19", "text": "え、何？ 犬のコイン。"}, {"type": "subtitle", "time": 4222.149, "timestamp": "01:10:22", "text": "犬が発行するコインが通貨だ。"}, {"type": "subtitle", "time": 4224.55, "timestamp": "01:10:24", "text": "彼らから物を買うことができます。 黒人"}, {"type": "subtitle", "time": 4225.99, "timestamp": "01:10:25", "text": "商人から。"}, {"type": "subtitle", "time": 4237.99, "timestamp": "01:10:37", "text": "私はもうすぐ尽きそうな槍で彼を突いています。"}, {"type": "subtitle", "time": 4246.95, "timestamp": "01:10:46", "text": "もし今、一人でこれをできるなら、私は"}]
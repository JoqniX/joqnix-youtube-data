[{"type": "subtitle", "time": 7761.109, "timestamp": "02:09:21", "text": "あなたは何をしていますか？"}, {"type": "subtitle", "time": 7769.91, "timestamp": "02:09:29", "text": "ああ、ガラスの壁。 わかった。 わかった。 あなたは"}, {"type": "subtitle", "time": 7778.39, "timestamp": "02:09:38", "text": "つまり、ゲームからキャラクターを"}, {"type": "subtitle", "time": 7780.87, "timestamp": "02:09:40", "text": "削除しない限り、私たちの進行状況は保存されるということですよ"}, {"type": "subtitle", "time": 7784.47, "timestamp": "02:09:44", "text": "ね？"}, {"type": "subtitle", "time": 7785.75, "timestamp": "02:09:45", "text": "うん。"}, {"type": "subtitle", "time": 7795.43, "timestamp": "02:09:55", "text": "杯追加するんですね。 待って、どうやって"}, {"type": "subtitle", "time": 7797.35, "timestamp": "02:09:57", "text": "ガラスを投げつけるようになったの？ ああ、"}]
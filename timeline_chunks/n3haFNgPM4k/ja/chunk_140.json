[{"type": "subtitle", "time": 8402.55, "timestamp": "02:20:02", "text": "えっと。 そうねぇ。"}, {"type": "subtitle", "time": 8405.11, "timestamp": "02:20:05", "text": "ああ、ロッカーのシヴァン [音楽]"}, {"type": "subtitle", "time": 8416.63, "timestamp": "02:20:16", "text": "ありがとう。 さよなら。 ジョイボーイ0205。"}, {"type": "subtitle", "time": 8418.23, "timestamp": "02:20:18", "text": "お越しいただきありがとうございます。 初めてだと"}, {"type": "subtitle", "time": 8421.59, "timestamp": "02:20:21", "text": "思いますよ。 プレートの世界へようこそ。"}, {"type": "subtitle", "time": 8424.07, "timestamp": "02:20:24", "text": "いらっしゃいませ。"}, {"type": "subtitle", "time": 8425.91, "timestamp": "02:20:25", "text": "Twitchにお越しいただきありがとうございます。"}, {"type": "subtitle", "time": 8428.23, "timestamp": "02:20:28", "text": "今日は楽しんでいただけたでしょうか。"}, {"type": "subtitle", "time": 8430.63, "timestamp": "02:20:30", "text": "水分補給を促す"}, {"type": "subtitle", "time": 8432.87, "timestamp": "02:20:32", "text": "コメントはしていません。 ああ、それは見ていませんでした。"}, {"type": "subtitle", "time": 8435.83, "timestamp": "02:20:35", "text": "私は世界のことにばかり気を取られていた。 あまりリーチ"}, {"type": "subtitle", "time": 8438.15, "timestamp": "02:20:38", "text": "チャットを見かけなかったので、今来て"}, {"type": "subtitle", "time": 8441.51, "timestamp": "02:20:41", "text": "くださってありがとうございます。"}, {"type": "subtitle", "time": 8444.309, "timestamp": "02:20:44", "text": "アドバイスをいただき、ありがとうございます"}, {"type": "subtitle", "time": 8454.23, "timestamp": "02:20:54", "text": "Twitchにも出演していました。"}, {"type": "subtitle", "time": 8456.63, "timestamp": "02:20:56", "text": "Twitchにお越しいただきありがとうございます。"}, {"type": "subtitle", "time": 8457.99, "timestamp": "02:20:57", "text": "Twitchにも出演していました。"}]
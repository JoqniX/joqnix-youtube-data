[{"type": "subtitle", "time": 2591.67, "timestamp": "00:43:11", "text": "。"}, {"type": "subtitle", "time": 2603.829, "timestamp": "00:43:23", "text": "毒腺。"}, {"type": "subtitle", "time": 2611.99, "timestamp": "00:43:31", "text": "バナナのようなベルと、キノコのようなキノコが見られます"}, {"type": "subtitle", "time": 2623.91, "timestamp": "00:43:43", "text": "子羊を捕まえる。 ランブル。 何？ ランボ。"}, {"type": "subtitle", "time": 2625.67, "timestamp": "00:43:45", "text": "羊だ。 それは羊です。 ここに来て。   ここに"}, {"type": "subtitle", "time": 2629.99, "timestamp": "00:43:49", "text": "来て。 道中で彼らを見つけるだろう。"}, {"type": "subtitle", "time": 2631.349, "timestamp": "00:43:51", "text": "硬さはどこにあるのか？   何てことだ"}, {"type": "subtitle", "time": 2636.55, "timestamp": "00:43:56", "text": "。 まずロックを解除しなければなりません。"}]
[{"type": "subtitle", "time": 4740.149, "timestamp": "01:19:00", "text": "うん。 それからそれを装備して二段ジャンプをしてください。"}, {"type": "subtitle", "time": 4742.229, "timestamp": "01:19:02", "text": "それを右クリックしてください。"}, {"type": "subtitle", "time": 4743.669, "timestamp": "01:19:03", "text": "うん。"}, {"type": "subtitle", "time": 4745.43, "timestamp": "01:19:05", "text": "二段跳び。"}, {"type": "subtitle", "time": 4746.47, "timestamp": "01:19:06", "text": "わあ、すごい。 それは"}, {"type": "subtitle", "time": 4747.91, "timestamp": "01:19:07", "text": "普通のことではない。"}, {"type": "subtitle", "time": 4749.59, "timestamp": "01:19:09", "text": "さあ、行こう。"}, {"type": "subtitle", "time": 4751.83, "timestamp": "01:19:11", "text": "おお。 おお。"}, {"type": "subtitle", "time": 4754.79, "timestamp": "01:19:14", "text": "小さな集落を見つけて、族長に話しかけてください"}, {"type": "subtitle", "time": 4757.59, "timestamp": "01:19:17", "text": "。 わかった。 わかった。 それはとても遠い"}, {"type": "subtitle", "time": 4761.43, "timestamp": "01:19:21", "text": "どこかにある。 どこですか？"}, {"type": "subtitle", "time": 4771.43, "timestamp": "01:19:31", "text": "。"}, {"type": "subtitle", "time": 4778.47, "timestamp": "01:19:38", "text": "待って。 えっと、石、金属、鉄は、ここでいう"}, {"type": "subtitle", "time": 4781.99, "timestamp": "01:19:41", "text": "資源ってどういう仕組みなの"}, {"type": "subtitle", "time": 4785.91, "timestamp": "01:19:45", "text": "？ マインクラフトみたいに、木材から"}, {"type": "subtitle", "time": 4789.669, "timestamp": "01:19:49", "text": "石、鉄、ダイヤモンドへと進化していくんだよね？ ここではどのように"}, {"type": "subtitle", "time": 4796.39, "timestamp": "01:19:56", "text": "ない。"}]
[{"type": "subtitle", "time": 4327.43, "timestamp": "01:12:07", "text": "タイマー。   はい"}, {"type": "subtitle", "time": 4333.11, "timestamp": "01:12:13", "text": "、わかりました。 ごめんなさい。 私は死んだ。"}, {"type": "subtitle", "time": 4335.43, "timestamp": "01:12:15", "text": "彼は違う。"}, {"type": "subtitle", "time": 4352.31, "timestamp": "01:12:32", "text": "ラムボールは見つかりません。"}, {"type": "subtitle", "time": 4355.43, "timestamp": "01:12:35", "text": "それは羊です。 それは羊です。"}, {"type": "subtitle", "time": 4356.47, "timestamp": "01:12:36", "text": "それは"}, {"type": "subtitle", "time": 4358.39, "timestamp": "01:12:38", "text": "私が探しているものです。 その写真は見た"}, {"type": "subtitle", "time": 4360.229, "timestamp": "01:12:40", "text": "けど、探しているところだ。 見つかりません"}, {"type": "subtitle", "time": 4360.87, "timestamp": "01:12:40", "text": "。"}, {"type": "subtitle", "time": 4363.27, "timestamp": "01:12:43", "text": "よし、じゃあ簡単な場所、つまり"}, {"type": "subtitle", "time": 4367.27, "timestamp": "01:12:47", "text": "僕たちがスポーンする場所に行ってみよう。"}, {"type": "subtitle", "time": 4368.39, "timestamp": "01:12:48", "text": "おい、ちょっと待って"}, {"type": "subtitle", "time": 4369.669, "timestamp": "01:12:49", "text": "、ちょっと待って、ちょっと待って、ちょっと"}, {"type": "subtitle", "time": 4372.149, "timestamp": "01:12:52", "text": "待って。 そういう"}, {"type": "subtitle", "time": 4376.229, "timestamp": "01:12:56", "text": "地図みたいなものがあって、それを見ると、"}, {"type": "subtitle", "time": 4377.99, "timestamp": "01:12:57", "text": "ああ、見つけた。 見つけた"}]
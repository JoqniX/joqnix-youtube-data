[{"type": "subtitle", "time": 6782.55, "timestamp": "01:53:02", "text": "猫好きの女性だと思う。"}, {"type": "subtitle", "time": 6783.589, "timestamp": "01:53:03", "text": "ああ、犬のやつね。"}, {"type": "subtitle", "time": 6785.669, "timestamp": "01:53:05", "text": "最強の男の一人。"}, {"type": "subtitle", "time": 6792.149, "timestamp": "01:53:12", "text": "生き延びてくれ。 おお。   それを"}, {"type": "subtitle", "time": 6795.669, "timestamp": "01:53:15", "text": "超えるのは難しかったですか？"}, {"type": "subtitle", "time": 6798.229, "timestamp": "01:53:18", "text": "私はただ高レベルのパラディンに入って、"}, {"type": "subtitle", "time": 6800.31, "timestamp": "01:53:20", "text": "これを連投するだけです。"}, {"type": "subtitle", "time": 6803.589, "timestamp": "01:53:23", "text": "これはパルフィア投擲銃です。"}, {"type": "subtitle", "time": 6806.39, "timestamp": "01:53:26", "text": "ああ、これだ。   わかった"}, {"type": "subtitle", "time": 6807.27, "timestamp": "01:53:27", "text": "。 わかった。 わかった。"}, {"type": "subtitle", "time": 6811.35, "timestamp": "01:53:31", "text": "はい。 それで、ここで何人かの高レベルの友達にスパムを送って、"}, {"type": "subtitle", "time": 6814.629, "timestamp": "01:53:34", "text": "彼をゲットしました。その時、私の"}, {"type": "subtitle", "time": 6823.75, "timestamp": "01:53:43", "text": "これもまた、"}, {"type": "subtitle", "time": 6826.229, "timestamp": "01:53:46", "text": "私のフライングウィンドの青いバージョンです。 わかった"}, {"type": "subtitle", "time": 6828.229, "timestamp": "01:53:48", "text": "。 損害すら与えない。"}]
[{"type": "subtitle", "time": 5340.31, "timestamp": "01:29:00", "text": "ええ、それらはあなたのものです。"}, {"type": "subtitle", "time": 5340.629, "timestamp": "01:29:00", "text": "ええ、"}, {"type": "subtitle", "time": 5342.95, "timestamp": "01:29:02", "text": "それはあなたのものです。 箱の中の1つ、"}, {"type": "subtitle", "time": 5347.75, "timestamp": "01:29:07", "text": "2つの箱、つまり32個。全部あなたのものです。"}, {"type": "subtitle", "time": 5350.229, "timestamp": "01:29:10", "text": "ああ。"}, {"type": "subtitle", "time": 5350.709, "timestamp": "01:29:10", "text": "うん。"}, {"type": "subtitle", "time": 5353.59, "timestamp": "01:29:13", "text": "つまり、彼は"}, {"type": "subtitle", "time": 5355.27, "timestamp": "01:29:15", "text": "1から32までを捕らえたってことだよね。"}, {"type": "subtitle", "time": 5360.31, "timestamp": "01:29:20", "text": "うん。 ええと、"}, {"type": "subtitle", "time": 5362.31, "timestamp": "01:29:22", "text": "私が見た限りでは、1つの箱に入っているのは1つだけです。"}, {"type": "subtitle", "time": 5365.99, "timestamp": "01:29:25", "text": "うん。 スロットボックス2～32は空です。"}, {"type": "subtitle", "time": 5368.07, "timestamp": "01:29:28", "text": "そうそう。"}, {"type": "subtitle", "time": 5370.709, "timestamp": "01:29:30", "text": "待って、あなたは別の山積み箱を持っていますね。"}, {"type": "subtitle", "time": 5371.27, "timestamp": "01:29:31", "text": "うん。"}, {"type": "subtitle", "time": 5373.83, "timestamp": "01:29:33", "text": "いいえ、みんなそれぞれ違う時間帯に活動しています。"}, {"type": "subtitle", "time": 5376.47, "timestamp": "01:29:36", "text": "みんなそれぞれ違う時間帯に当たるようなものだ。"}, {"type": "subtitle", "time": 5379.99, "timestamp": "01:29:39", "text": "グローバルとは普遍的なものである。   つまり、"}, {"type": "subtitle", "time": 5382.47, "timestamp": "01:29:42", "text": "彼は私のファンを見ることができないということだ。"}, {"type": "subtitle", "time": 5391.03, "timestamp": "01:29:51", "text": "1人だけ。 私たちは彼らを見ることができます"}, {"type": "subtitle", "time": 5393.669, "timestamp": "01:29:53", "text": "。"}]
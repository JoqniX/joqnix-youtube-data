[{"type": "subtitle", "time": 5640.79, "timestamp": "01:34:00", "text": "なぜ"}, {"type": "subtitle", "time": 5641.99, "timestamp": "01:34:01", "text": "今までこのことを教えてくれなかったのですか？"}, {"type": "subtitle", "time": 5643.91, "timestamp": "01:34:03", "text": "あなたが尋ねなかったからです。"}, {"type": "subtitle", "time": 5644.629, "timestamp": "01:34:04", "text": "おお。"}, {"type": "subtitle", "time": 5647.27, "timestamp": "01:34:07", "text": "大丈夫です。 大丈夫。 ほら、"}, {"type": "subtitle", "time": 5652.55, "timestamp": "01:34:12", "text": "クエストが本当にたくさんあるんだよ。 大丈夫です。 たとえ"}, {"type": "subtitle", "time": 5654.709, "timestamp": "01:34:14", "text": "それが今のような経験に過ぎなくても、あなたはこれからこういったことをしなければならないと知っている"}, {"type": "chat", "time": 5658.387, "timestamp": "01:34:18", "author": "@Rafuru-kun", "avatar": "https://yt4.ggpht.com/RSNQezryqjIUt2eZ7qUKQhaxvO0n4vUecnjPV4OOX9fEvgK7V1zIa1uzk4RwpsgFvU3I1e4xvus=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/E8MfY5u7JPSXkNAP95GAmAEUCkszU2WH9gy1mb0dV-11UJg/E8MfY5u7JPSXkNAP95GAmAEUCkszU2WH9gy1mb0dV-11UJg/E8MfY5u7JPSXkNAP95GAmAE"}, {"type": "subtitle", "time": 5658.709, "timestamp": "01:34:18", "text": "。"}, {"type": "subtitle", "time": 5661.27, "timestamp": "01:34:21", "text": "あなたは"}, {"type": "subtitle", "time": 5671.03, "timestamp": "01:34:31", "text": "私もあなたと一緒にそれらをやっていました。"}, {"type": "subtitle", "time": 5673.43, "timestamp": "01:34:33", "text": "あなたは、その任務を知っている"}, {"type": "subtitle", "time": 5680.47, "timestamp": "01:34:40", "text": "いいえ、もしかしたら皆さんの"}, {"type": "subtitle", "time": 5682.95, "timestamp": "01:34:42", "text": "世界では既に実現しているかもしれないと思ったので、皆さん"}, {"type": "subtitle", "time": 5685.03, "timestamp": "01:34:45", "text": "にもチャンスがあると思ったんです。"}, {"type": "subtitle", "time": 5686.149, "timestamp": "01:34:46", "text": "いや、いや、いや、いや。"}, {"type": "subtitle", "time": 5688.95, "timestamp": "01:34:48", "text": "私のためだけに開いている。"}, {"type": "subtitle", "time": 5689.75, "timestamp": "01:34:49", "text": "ああ、"}, {"type": "subtitle", "time": 5692.229, "timestamp": "01:34:52", "text": "ここは私の世界だ。"}]
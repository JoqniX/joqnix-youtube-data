[{"type": "subtitle", "time": 5894.149, "timestamp": "01:38:14", "text": "ああ、わかりました"}, {"type": "subtitle", "time": 5900.709, "timestamp": "01:38:20", "text": "これを持って行ってください。私はもう行きます。"}, {"type": "subtitle", "time": 5903.43, "timestamp": "01:38:23", "text": "8になります。"}, {"type": "subtitle", "time": 5905.43, "timestamp": "01:38:25", "text": "ああ、くそ"}, {"type": "subtitle", "time": 5908.149, "timestamp": "01:38:28", "text": "。 それが必要ですか？   私にくれるの"}, {"type": "subtitle", "time": 5909.83, "timestamp": "01:38:29", "text": "？"}, {"type": "subtitle", "time": 5914.629, "timestamp": "01:38:34", "text": "ああ、これが私のベストです。"}, {"type": "subtitle", "time": 5916.55, "timestamp": "01:38:36", "text": "それらを要約することができます。"}, {"type": "subtitle", "time": 5918.39, "timestamp": "01:38:38", "text": "私は死んだ。 でも、ええ、戻ってきますよ。"}, {"type": "subtitle", "time": 5920.709, "timestamp": "01:38:40", "text": "次回参加するなら、差し上げますよ"}, {"type": "subtitle", "time": 5924.39, "timestamp": "01:38:44", "text": "。 自分のものだけを覚えておいてください。"}, {"type": "subtitle", "time": 5925.35, "timestamp": "01:38:45", "text": "ああ、大丈夫ですよ。"}, {"type": "subtitle", "time": 5931.189, "timestamp": "01:38:51", "text": "グローバルな設定にいくつかの呪文を持ち帰ることはできますか？ 大丈夫ですか？"}, {"type": "subtitle", "time": 5933.43, "timestamp": "01:38:53", "text": "あ、待って。 ヨッシー、君の"}, {"type": "subtitle", "time": 5935.189, "timestamp": "01:38:55", "text": "基地に持って行っていいよ。 いいえ。ああ"}, {"type": "subtitle", "time": 5937.51, "timestamp": "01:38:57", "text": "、大丈夫です。"}]
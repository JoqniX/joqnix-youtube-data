[{"type": "subtitle", "time": 3965.19, "timestamp": "01:06:05", "text": "ああ、撃たれた。"}, {"type": "subtitle", "time": 3966.63, "timestamp": "01:06:06", "text": "えっと、"}, {"type": "subtitle", "time": 3967.109, "timestamp": "01:06:07", "text": "こんにちは。"}, {"type": "subtitle", "time": 3972.23, "timestamp": "01:06:12", "text": "できません。 クエストの"}, {"type": "subtitle", "time": 3974.23, "timestamp": "01:06:14", "text": "仕事をこなさなければなりません。"}, {"type": "subtitle", "time": 3976.63, "timestamp": "01:06:16", "text": "私はクエストをこなしています。   今行ってる"}, {"type": "subtitle", "time": 3991.43, "timestamp": "01:06:31", "text": "待って、君たちも"}, {"type": "subtitle", "time": 3994.87, "timestamp": "01:06:34", "text": "このNPCの戦闘イベントに参加するの？それとも僕が"}, {"type": "subtitle", "time": 3996.71, "timestamp": "01:06:36", "text": "兄貴を支えてるだけ？僕は彼らを倒せなかったよ。 私はできなかった。"}, {"type": "subtitle", "time": 4004.71, "timestamp": "01:06:44", "text": "あなたは敗北した。 より簡単に。 これは"}, {"type": "subtitle", "time": 4007.75, "timestamp": "01:06:47", "text": "簡単に倒せるよ、兄弟。 君は僕に"}, {"type": "subtitle", "time": 4009.67, "timestamp": "01:06:49", "text": "死んでほしいんだろ？ 一度僕が戻ってきて、"}, {"type": "subtitle", "time": 4012.789, "timestamp": "01:06:52", "text": "一緒にそれを打ち負かしてやるよ。"}]
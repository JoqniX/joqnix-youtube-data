[{"type": "subtitle", "time": 8581.429, "timestamp": "02:23:01", "text": "、責任、"}, {"type": "subtitle", "time": 8585.27, "timestamp": "02:23:05", "text": "食料品の買い物、"}, {"type": "subtitle", "time": 8587.429, "timestamp": "02:23:07", "text": "掃除など、たくさんある。"}, {"type": "subtitle", "time": 8592.379, "timestamp": "02:23:12", "text": "時間が経つのは本当に早い。"}, {"type": "subtitle", "time": 8593.429, "timestamp": "02:23:13", "text": "[笑い] しかも"}, {"type": "subtitle", "time": 8597.349, "timestamp": "02:23:17", "text": "時間もない。 たぶん、"}, {"type": "subtitle", "time": 8599.429, "timestamp": "02:23:19", "text": "音楽ってそういうものなんだろうね。"}, {"type": "subtitle", "time": 8602.389, "timestamp": "02:23:22", "text": "大人になること、大人になること、"}, {"type": "subtitle", "time": 8605.67, "timestamp": "02:23:25", "text": "大人であること。 ほとんど時間が取れない。私もまさにそんな感じだと"}, {"type": "subtitle", "time": 8615.349, "timestamp": "02:23:35", "text": "皆さん、今日はありがとうございました。   しばらく前から"}, {"type": "subtitle", "time": 8618.79, "timestamp": "02:23:38", "text": "言っていることですが、"}, {"type": "subtitle", "time": 8620.63, "timestamp": "02:23:40", "text": "ええ、[音楽] 今日はありがとうございました。"}, {"type": "subtitle", "time": 8623.83, "timestamp": "02:23:43", "text": "皆さん、良い一日を。 わかった。"}, {"type": "subtitle", "time": 8628.469, "timestamp": "02:23:48", "text": "どうぞ、楽しんでください。"}, {"type": "subtitle", "time": 8630.87, "timestamp": "02:23:50", "text": "今日は最高の笑顔を見せて、たとえ"}, {"type": "subtitle", "time": 8633.99, "timestamp": "02:23:53", "text": "辛くても最善を尽くし続けてください。"}, {"type": "subtitle", "time": 8638.389, "timestamp": "02:23:58", "text": "休んでください。 十分な休息をとること。 そして、そのまま続けてください"}]
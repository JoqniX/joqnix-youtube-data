[{"type": "subtitle", "time": 121.429, "timestamp": "00:02:01", "text": "今天我們請到了 Astra 的 Kushiri 先生"}, {"type": "subtitle", "time": 125.67, "timestamp": "00:02:05", "text": "和 Yosha Foger。"}, {"type": "subtitle", "time": 129.91, "timestamp": "00:02:09", "text": "呃，讓我先把這件事做了。好的，"}, {"type": "subtitle", "time": 132.79, "timestamp": "00:02:12", "text": "請稍等片刻。"}, {"type": "subtitle", "time": 137.27, "timestamp": "00:02:17", "text": "呃，你好。這就是我。"}, {"type": "subtitle", "time": 145.11, "timestamp": "00:02:25", "text": "等等，我的「哦，反應」功能在哪裡？好了"}, {"type": "subtitle", "time": 148.22899999999998, "timestamp": "00:02:28", "text": "。你好。"}, {"type": "subtitle", "time": 150.07, "timestamp": "00:02:30", "text": "呃，"}, {"type": "subtitle", "time": 163.589, "timestamp": "00:02:43", "text": "好了，我開始直播了。忘了你可以在"}, {"type": "subtitle", "time": 163.91, "timestamp": "00:02:43", "text": "直播中啟用此功能。"}, {"type": "subtitle", "time": 165.19, "timestamp": "00:02:45", "text": "我們走吧。"}, {"type": "subtitle", "time": 166.39, "timestamp": "00:02:46", "text": "大家好。  你好。  你好"}, {"type": "subtitle", "time": 172.39, "timestamp": "00:02:52", "text": "。  你好。你好。你好。你好。"}, {"type": "subtitle", "time": 174.22899999999998, "timestamp": "00:02:54", "text": "盡情享受 YouTube。"}, {"type": "subtitle", "time": 177.589, "timestamp": "00:02:57", "text": "呃，你們做踢腿比賽嗎？是的。"}]
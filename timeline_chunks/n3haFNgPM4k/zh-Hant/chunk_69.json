[{"type": "subtitle", "time": 4142.229, "timestamp": "01:09:02", "text": "。來吧，死龍。  去死吧。去死吧。去死吧。去死吧。  去死吧。去死吧。讓他殺了"}, {"type": "subtitle", "time": 4143.91, "timestamp": "01:09:03", "text": "你。  為什麼？  去死吧。不，別放棄。不要放棄。"}, {"type": "subtitle", "time": 4157.749, "timestamp": "01:09:17", "text": "我覺得自己好像做不到"}, {"type": "subtitle", "time": 4163.749, "timestamp": "01:09:23", "text": "我的天哪。  我回來了。  你去。"}, {"type": "subtitle", "time": 4169.269, "timestamp": "01:09:29", "text": "我需要你的劍。"}, {"type": "subtitle", "time": 4172.789, "timestamp": "01:09:32", "text": "哦，我需要你的劍。等等，我正在造成破壞。看看這個。  我要死了。但我正在造成破壞。"}, {"type": "subtitle", "time": 4183.349, "timestamp": "01:09:43", "text": "兄弟，你能現在過來嗎"}, {"type": "chat", "time": 4196.03, "timestamp": "01:09:56", "author": "@Ghewar_Ji_ka_No-1FAN", "avatar": "https://yt4.ggpht.com/CqrtcQvHFvr33XJk7uI96qZ5HyIAEb1ifU1jdPzM7vetPMlUZ4oYhF9BjVOj5xYYbkMi18Zfvg=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/E8MfY5u7JPSXkNAP95GAmAEUCkszU2WH9gy1mb0dV-11UJg/E8MfY5u7JPSXkNAP95GAmAEUCkszU2WH9gy1mb0dV-11UJg/E8MfY5u7JPSXkNAP95GAmAE"}]
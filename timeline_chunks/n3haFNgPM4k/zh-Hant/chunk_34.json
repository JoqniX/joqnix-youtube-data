[{"type": "subtitle", "time": 2067.589, "timestamp": "00:34:27", "text": "硬木。你的木材完美標準是什麼"}, {"type": "subtitle", "time": 2078.069, "timestamp": "00:34:38", "text": "？哦，我現在11級了。什麼？  硬木。你有一個金屬墊，一塊金屬錠。  好的，你們有一艘國防支援艦。  攻擊穿透"}, {"type": "subtitle", "time": 2082.149, "timestamp": "00:34:42", "text": "。  好的，所以我不必把所有東西都撿起來。"}, {"type": "subtitle", "time": 2096.71, "timestamp": "00:34:56", "text": "哦，我真是太笨了。我為什麼要挑選東西？"}, {"type": "chat", "time": 2098.123, "timestamp": "00:34:58", "author": "@SAMPAD0xd", "avatar": "https://yt4.ggpht.com/z-ouOkiDmuLnDm7vYDgN15VrTbt3sZOYbPL2lTNTVk0bk60NZ3SuexCRYV5ICoE55YuyGhpt9w=s64-c-k-c0x00ffffff-no-rj", "message": "UCdZBnUb7m8Pd_wUTDNqUu3Q/f3TlZ-r4KpS3_9EP-duW6QoUCdZBnUb7m8Pd_wUTDNqUu3Q/f3TlZ-r4KpS3_9EP-duW6QoUCdZBnUb7m8Pd_wUTDNqUu3Q/AkXmZ8zFMpS3_9EP-duW6Qo"}]
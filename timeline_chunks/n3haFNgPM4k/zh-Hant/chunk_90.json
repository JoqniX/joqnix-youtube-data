[{"type": "subtitle", "time": 5403.35, "timestamp": "01:30:03", "text": "哦，我得回去了。所以，"}, {"type": "subtitle", "time": 5407.59, "timestamp": "01:30:07", "text": "我們得回去。"}, {"type": "subtitle", "time": 5409.189, "timestamp": "01:30:09", "text": "是的，我可以利用他。  瘋狂的。  你可以利用他。所以，別從"}, {"type": "subtitle", "time": 5419.51, "timestamp": "01:30:19", "text": "我的朋友箱拿走朋友。"}, {"type": "subtitle", "time": 5420.39, "timestamp": "01:30:20", "text": "好吧，為什麼"}, {"type": "subtitle", "time": 5423.83, "timestamp": "01:30:23", "text": "不呢？拿著吧。"}, {"type": "subtitle", "time": 5436.552, "timestamp": "01:30:36", "text": "別拿。  第一個盒子是我的"}]
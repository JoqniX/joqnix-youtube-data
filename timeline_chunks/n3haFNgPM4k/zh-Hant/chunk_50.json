[{"type": "subtitle", "time": 3013.43, "timestamp": "00:50:13", "text": "？  好的，噓"}, {"type": "subtitle", "time": 3016.79, "timestamp": "00:50:16", "text": "。我們得去類似森林的地方。  好了，各位。"}, {"type": "subtitle", "time": 3031.67, "timestamp": "00:50:31", "text": "你想讓我背誦"}, {"type": "subtitle", "time": 3047.99, "timestamp": "00:50:47", "text": "四段評論？是的。頭部特寫。  快點。快點。  我的天啊。這是有史以​​來最精彩的戰鬥。"}]
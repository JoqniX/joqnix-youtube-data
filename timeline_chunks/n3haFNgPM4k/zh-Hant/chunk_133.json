[{"type": "subtitle", "time": 7994.47, "timestamp": "02:13:14", "text": "不。哦，"}, {"type": "subtitle", "time": 7999.91, "timestamp": "02:13:19", "text": "該死。邊後衛。哦。哦，這架滑翔機。  哦"}, {"type": "subtitle", "time": 8018.55, "timestamp": "02:13:38", "text": "。人工智慧核心。熱芯。古代文明核心。我的天，這麼多核心！  那就像《我的世界》裡的伊萊克特拉（Electra）一樣。"}]
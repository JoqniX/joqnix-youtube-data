[{"type": "subtitle", "time": 8343.19, "timestamp": "02:19:03", "text": "罗兰，谢谢你送的萨莫萨三角饺。 我"}, {"type": "subtitle", "time": 8345.429, "timestamp": "02:19:05", "text": "没看到这些。"}, {"type": "subtitle", "time": 8349.11, "timestamp": "02:19:09", "text": "什么？ 我需要对这些情况进行语音提醒。"}, {"type": "subtitle", "time": 8353.19, "timestamp": "02:19:13", "text": "我的天啊。 图例 80055"}, {"type": "subtitle", "time": 8357.589, "timestamp": "02:19:17", "text": "呃 连字符 7。感谢您的光临，"}, {"type": "subtitle", "time": 8360.15, "timestamp": "02:19:20", "text": "希望您喜欢。 呃 [音乐] 你留在这里，"}, {"type": "subtitle", "time": 8363.429, "timestamp": "02:19:23", "text": "欢迎来到硬币的世界，告诉我们"}, {"type": "subtitle", "time": 8371.19, "timestamp": "02:19:31", "text": "然后感谢 Raja"}, {"type": "subtitle", "time": 8373.83, "timestamp": "02:19:33", "text": "今天光临。 希望你玩得开心。 谢谢"}, {"type": "subtitle", "time": 8376.07, "timestamp": "02:19:36", "text": "光临。 现在欢迎来到"}, {"type": "subtitle", "time": 8378.191, "timestamp": "02:19:38", "text": "音乐会现场。"}, {"type": "subtitle", "time": 8380.309, "timestamp": "02:19:40", "text": "[音乐] 感谢你每次都来观看"}, {"type": "subtitle", "time": 8389.19, "timestamp": "02:19:49", "text": "还有，Red X [音乐] 也感谢你"}, {"type": "subtitle", "time": 8393.429, "timestamp": "02:19:53", "text": "送给 Red X 的 con um 星象星座礼物。"}]
[{"type": "subtitle", "time": 673.67, "timestamp": "00:11:13", "text": "狗，过来，过来，过来，过来。 首先，"}, {"type": "subtitle", "time": 675.75, "timestamp": "00:11:15", "text": "请跟随我。 来。 我的基地里"}, {"type": "subtitle", "time": 676.71, "timestamp": "00:11:16", "text": "什么都有。 你不需要建造"}, {"type": "subtitle", "time": 679.35, "timestamp": "00:11:19", "text": "任何东西。 来，到我后面来。"}, {"type": "subtitle", "time": 681.59, "timestamp": "00:11:21", "text": "不，狗。 不要跟着他。 他要"}, {"type": "subtitle", "time": 688.63, "timestamp": "00:11:28", "text": "我不会绑架任何人。 来。"}, {"type": "subtitle", "time": 690.31, "timestamp": "00:11:30", "text": "不，应该提供一个选项，让"}, {"type": "subtitle", "time": 693.509, "timestamp": "00:11:33", "text": "多人可以"}, {"type": "subtitle", "time": 696.15, "timestamp": "00:11:36", "text": "一起乘坐，比如说，他们可以一起骑车。"}, {"type": "subtitle", "time": 699.91, "timestamp": "00:11:39", "text": "什么？ 为什么会有阴影呢？"}, {"type": "subtitle", "time": 701.91, "timestamp": "00:11:41", "text": "不，你不需要。 是的，就像这样，但是对于这个"}, {"type": "subtitle", "time": 703.75, "timestamp": "00:11:43", "text": "平底锅，你必须把它锁定在非常"}, {"type": "subtitle", "time": 706.389, "timestamp": "00:11:46", "text": "高的位置才能获得这种特定的阴影。"}, {"type": "subtitle", "time": 711.35, "timestamp": "00:11:51", "text": "我需要朋友来修理我的"}, {"type": "subtitle", "time": 713.35, "timestamp": "00:11:53", "text": "房子。   嗯"}]
[{"type": "subtitle", "time": 4023.43, "timestamp": "01:07:03", "text": "看起来像“是”。 是的。 兄弟，我马上再说一遍"}, {"type": "subtitle", "time": 4025.43, "timestamp": "01:07:05", "text": "。"}, {"type": "subtitle", "time": 4030.069, "timestamp": "01:07:10", "text": "我有个超强的伙伴。 来吧，"}, {"type": "subtitle", "time": 4030.87, "timestamp": "01:07:10", "text": "死龙。"}, {"type": "subtitle", "time": 4033.51, "timestamp": "01:07:13", "text": "去死吧。 去死吧。 去死吧。 去死吧。"}, {"type": "subtitle", "time": 4035.43, "timestamp": "01:07:15", "text": "去死吧。 去死吧。 让他杀了"}, {"type": "subtitle", "time": 4037.67, "timestamp": "01:07:17", "text": "你。"}, {"type": "subtitle", "time": 4039.19, "timestamp": "01:07:19", "text": "为什么？"}, {"type": "subtitle", "time": 4042.309, "timestamp": "01:07:22", "text": "去死吧。 不，"}, {"type": "subtitle", "time": 4045.43, "timestamp": "01:07:25", "text": "别放弃。 不要放弃。"}, {"type": "subtitle", "time": 4048.789, "timestamp": "01:07:28", "text": "我感觉自己好像做不到"}, {"type": "subtitle", "time": 4049.589, "timestamp": "01:07:29", "text": "。"}, {"type": "subtitle", "time": 4052.23, "timestamp": "01:07:32", "text": "我的天哪。"}, {"type": "subtitle", "time": 4055.51, "timestamp": "01:07:35", "text": "我回来了。"}, {"type": "subtitle", "time": 4063.029, "timestamp": "01:07:43", "text": "我需要你的剑。 哦，"}, {"type": "subtitle", "time": 4065.349, "timestamp": "01:07:45", "text": "我需要你的剑。 等等，我正在造成"}, {"type": "subtitle", "time": 4068.63, "timestamp": "01:07:48", "text": "破坏。 看看这个。"}, {"type": "subtitle", "time": 4076.63, "timestamp": "01:07:56", "text": "兄弟，你能现在过来吗？ 让"}]
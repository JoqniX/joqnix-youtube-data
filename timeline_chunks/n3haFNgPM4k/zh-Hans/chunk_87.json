[{"type": "subtitle", "time": 5222.39, "timestamp": "01:27:02", "text": "。 比我做得好。"}, {"type": "subtitle", "time": 5225.03, "timestamp": "01:27:05", "text": "你还记得他说了什么吗？"}, {"type": "subtitle", "time": 5227.11, "timestamp": "01:27:07", "text": "我打算独自完成。"}, {"type": "subtitle", "time": 5227.75, "timestamp": "01:27:07", "text": "我告诉你了。"}, {"type": "subtitle", "time": 5229.189, "timestamp": "01:27:09", "text": "过来这里看看。 过来。 我"}, {"type": "subtitle", "time": 5230.31, "timestamp": "01:27:10", "text": "不是朋友。 好的。"}, {"type": "subtitle", "time": 5232.629, "timestamp": "01:27:12", "text": "他不想用那个朋友。 他想"}, {"type": "subtitle", "time": 5235.669, "timestamp": "01:27:15", "text": "亲自去做。"}, {"type": "subtitle", "time": 5238.95, "timestamp": "01:27:18", "text": "我有一枚金币，有事要办。"}, {"type": "subtitle", "time": 5242.629, "timestamp": "01:27:22", "text": "呃，等等。 如何销毁物品？"}, {"type": "subtitle", "time": 5244.47, "timestamp": "01:27:24", "text": "是否可以？"}, {"type": "subtitle", "time": 5246.709, "timestamp": "01:27:26", "text": "这简直是​​疯了。"}, {"type": "subtitle", "time": 5249.27, "timestamp": "01:27:29", "text": "哦，在哪儿？ 啊，丢弃"}, {"type": "subtitle", "time": 5251.03, "timestamp": "01:27:31", "text": "并拆解。   是的"}, {"type": "subtitle", "time": 5255.91, "timestamp": "01:27:35", "text": "。 哦，对，就是这张卡片。"}, {"type": "subtitle", "time": 5256.95, "timestamp": "01:27:36", "text": "金属怪兽。   是的"}, {"type": "subtitle", "time": 5259.43, "timestamp": "01:27:39", "text": "。 我想就像这里一样。"}, {"type": "subtitle", "time": 5259.99, "timestamp": "01:27:39", "text": "不要来这里。   是的"}, {"type": "subtitle", "time": 5260.55, "timestamp": "01:27:40", "text": "。"}, {"type": "subtitle", "time": 5261.99, "timestamp": "01:27:41", "text": "拿着。"}, {"type": "subtitle", "time": 5264.07, "timestamp": "01:27:44", "text": "这个。"}, {"type": "subtitle", "time": 5268.31, "timestamp": "01:27:48", "text": "过来。 这里。 这里。 到我这里来。"}, {"type": "subtitle", "time": 5270.95, "timestamp": "01:27:50", "text": "好的。 软绵绵的。 软绵绵的。 正确的。 哦，是的。   是的"}, {"type": "subtitle", "time": 5277.59, "timestamp": "01:27:57", "text": "所以我们需要"}, {"type": "subtitle", "time": 5278.95, "timestamp": "01:27:58", "text": "接受它。"}]
[{"type": "subtitle", "time": 5940.31, "timestamp": "01:39:00", "text": "我可以制作全球 PAL 盒子。"}, {"type": "subtitle", "time": 5942.709, "timestamp": "01:39:02", "text": "没关系。 比如，如果有一天你"}, {"type": "subtitle", "time": 5944.79, "timestamp": "01:39:04", "text": "建了服务器，那我就会在那里好好玩，好好地玩"}, {"type": "subtitle", "time": 5947.669, "timestamp": "01:39:07", "text": "。"}, {"type": "subtitle", "time": 5950.31, "timestamp": "01:39:10", "text": "你知道吗？ 我会搭建服务器。"}, {"type": "subtitle", "time": 5952.79, "timestamp": "01:39:12", "text": "嗯？ 然后我会好好演奏的"}, {"type": "subtitle", "time": 5971.51, "timestamp": "01:39:31", "text": "我的"}, {"type": "subtitle", "time": 5976.229, "timestamp": "01:39:36", "text": "早期阶段放在哪里。 如果你的朋友"}, {"type": "subtitle", "time": 5979.35, "timestamp": "01:39:39", "text": "精神状态极差，该怎么办？ 我应该"}, {"type": "subtitle", "time": 5983.03, "timestamp": "01:39:43", "text": "杀了它们再招募新的，"}, {"type": "subtitle", "time": 5986.104, "timestamp": "01:39:46", "text": "还是应该治好它们？"}, {"type": "subtitle", "time": 5987.43, "timestamp": "01:39:47", "text": "[笑声]"}, {"type": "subtitle", "time": 5994.95, "timestamp": "01:39:54", "text": "呃，但我现在得走了。"}]
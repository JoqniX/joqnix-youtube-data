[{"type": "subtitle", "time": 6929.669, "timestamp": "01:55:29", "text": "等等，我无法转移刀剑和"}, {"type": "subtitle", "time": 6932.79, "timestamp": "01:55:32", "text": "武器。 哇，真令人难过。"}, {"type": "subtitle", "time": 6935.589, "timestamp": "01:55:35", "text": "呃，就在把这个守护者登记进"}, {"type": "subtitle", "time": 6936.229, "timestamp": "01:55:36", "text": "箱子之前。"}, {"type": "subtitle", "time": 6938.95, "timestamp": "01:55:38", "text": "哦，好的，好的，让我去找找"}, {"type": "subtitle", "time": 6945.27, "timestamp": "01:55:45", "text": "不，就像我看到的那样，我会给你展示一些"}, {"type": "subtitle", "time": 6949.43, "timestamp": "01:55:49", "text": "服装。 请到主区域来。"}]
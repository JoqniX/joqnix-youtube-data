[{"type": "subtitle", "time": 6360.149, "timestamp": "01:46:00", "text": "可以把它们寄给探险队。"}, {"type": "subtitle", "time": 6362.55, "timestamp": "01:46:02", "text": "哦，"}, {"type": "subtitle", "time": 6367.669, "timestamp": "01:46:07", "text": "我的PAL制式盒子里可以直接用它们。"}, {"type": "subtitle", "time": 6370.149, "timestamp": "01:46:10", "text": "好的。 好的。 太好了。"}, {"type": "subtitle", "time": 6373.03, "timestamp": "01:46:13", "text": "那么，如何实现"}, {"type": "subtitle", "time": 6374.709, "timestamp": "01:46:14", "text": "食品储存等环节的自动化呢"}, {"type": "subtitle", "time": 6377.189, "timestamp": "01:46:17", "text": "？"}, {"type": "subtitle", "time": 6379.75, "timestamp": "01:46:19", "text": "我目前还没有实现食品自动化。"}, {"type": "subtitle", "time": 6381.189, "timestamp": "01:46:21", "text": "你可以通过使用不同的"}, {"type": "subtitle", "time": 6384.709, "timestamp": "01:46:24", "text": "权限并将工作分配给它们来实现自动化。   我的"}, {"type": "subtitle", "time": 6404.79, "timestamp": "01:46:44", "text": "这款游戏刚推出的时候我就一直想玩"}, {"type": "subtitle", "time": 6407.35, "timestamp": "01:46:47", "text": "。 我当时就想，嗯，"}, {"type": "subtitle", "time": 6411.51, "timestamp": "01:46:51", "text": "下次有机会我一定买。"}]
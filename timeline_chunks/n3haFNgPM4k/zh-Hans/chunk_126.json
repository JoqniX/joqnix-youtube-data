[{"type": "subtitle", "time": 7561.99, "timestamp": "02:06:01", "text": "剑。 哦，我看到所有东西都解锁了"}, {"type": "subtitle", "time": 7564.79, "timestamp": "02:06:04", "text": "。 美好的早晨。"}, {"type": "subtitle", "time": 7566.07, "timestamp": "02:06:06", "text": "哦，我看到了，"}, {"type": "subtitle", "time": 7568.07, "timestamp": "02:06:08", "text": "不，我不知道。 我只有"}, {"type": "subtitle", "time": 7570.629, "timestamp": "02:06:10", "text": "它的电路图。 这就是原因。 如果你有"}, {"type": "subtitle", "time": 7572.47, "timestamp": "02:06:12", "text": "电路图，就不需要解锁了吧"}, {"type": "subtitle", "time": 7574.229, "timestamp": "02:06:14", "text": "？"}, {"type": "subtitle", "time": 7577.35, "timestamp": "02:06:17", "text": "不，要么你需要"}, {"type": "subtitle", "time": 7613.669, "timestamp": "02:06:53", "text": "古代盔甲。"}, {"type": "subtitle", "time": 7615.83, "timestamp": "02:06:55", "text": "哦，原来你穿的是这个啊。 等等，"}, {"type": "subtitle", "time": 7618.47, "timestamp": "02:06:58", "text": "你现在用的是什么技术"}]
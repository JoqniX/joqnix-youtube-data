[{"type": "subtitle", "time": 4680.63, "timestamp": "01:18:00", "text": "金属盔甲已清洗干净。 我不知道是不是还有"}, {"type": "subtitle", "time": 4702.709, "timestamp": "01:18:22", "text": "我一定要狠狠杀了佐伊。 但"}, {"type": "subtitle", "time": 4705.51, "timestamp": "01:18:25", "text": "现在用同样的方法给普通降落伞装备上"}, {"type": "subtitle", "time": 4709.669, "timestamp": "01:18:29", "text": "。 然后按“通过”。"}, {"type": "subtitle", "time": 4713.43, "timestamp": "01:18:33", "text": "我可以把它烧掉吗？"}, {"type": "subtitle", "time": 4715.11, "timestamp": "01:18:35", "text": "等等，等等，等等，等等，等等。"}, {"type": "subtitle", "time": 4717.35, "timestamp": "01:18:37", "text": "我可以让你再读一遍。"}, {"type": "subtitle", "time": 4720.31, "timestamp": "01:18:40", "text": "嗯，同样的方法也可以装备普通"}, {"type": "subtitle", "time": 4724.39, "timestamp": "01:18:44", "text": "降落伞。 然后按住Y键，"}, {"type": "subtitle", "time": 4728.79, "timestamp": "01:18:48", "text": "同时跳跃即可使用它。 降落伞。"}, {"type": "subtitle", "time": 4731.03, "timestamp": "01:18:51", "text": "呃，"}, {"type": "subtitle", "time": 4733.75, "timestamp": "01:18:53", "text": "你的物品栏里有普通降落伞吗？"}, {"type": "subtitle", "time": 4735.35, "timestamp": "01:18:55", "text": "我"}, {"type": "subtitle", "time": 4736.87, "timestamp": "01:18:56", "text": "必须掌握这项技术。   是的"}]
[{"type": "subtitle", "time": 791.35, "timestamp": "00:13:11", "text": "你看到了吗？ 是的"}, {"type": "subtitle", "time": 794.23, "timestamp": "00:13:14", "text": "。 所以在这个区域内，无论他"}, {"type": "subtitle", "time": 796.629, "timestamp": "00:13:16", "text": "建造什么，都不会损坏，他的"}, {"type": "chat", "time": 797.942, "timestamp": "00:13:17", "author": "@Ghewar_Ji_ka_No-1FAN", "avatar": "https://yt4.ggpht.com/CqrtcQvHFvr33XJk7uI96qZ5HyIAEb1ifU1jdPzM7vetPMlUZ4oYhF9BjVOj5xYYbkMi18Zfvg=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/E8MfY5u7JPSXkNAP95GAmAEUCkszU2WH9gy1mb0dV-11UJg/E8MfY5u7JPSXkNAP95GAmAEUCkszU2WH9gy1mb0dV-11UJg/E8MfY5u7JPSXkNAP95GAmAE"}, {"type": "subtitle", "time": 799.11, "timestamp": "00:13:19", "text": "朋友们也会"}, {"type": "subtitle", "time": 802.23, "timestamp": "00:13:22", "text": "自己修理。 但如果他像"}, {"type": "subtitle", "time": 804.31, "timestamp": "00:13:24", "text": "建造其他东西那样破坏它，那么它"}, {"type": "subtitle", "time": 807.03, "timestamp": "00:13:27", "text": "就会破灭。"}, {"type": "subtitle", "time": 809.509, "timestamp": "00:13:29", "text": "所以你需要一个 PAL 盒子，你可以"}, {"type": "subtitle", "time": 812.87, "timestamp": "00:13:32", "text": "像 PAL 设备一样获得它，就像"}, {"type": "subtitle", "time": 815.91, "timestamp": "00:13:35", "text": "你按下 B 键进入 PAL 模式时，就能得到"}, {"type": "subtitle", "time": 818.15, "timestamp": "00:13:38", "text": "PAL 盒子，对吧？但是你现在还不能放置它，"}, {"type": "subtitle", "time": 821.829, "timestamp": "00:13:41", "text": "我们首先需要升级，也就是进入“"}, {"type": "subtitle", "time": 824.55, "timestamp": "00:13:44", "text": "愿景之地”模式。"}, {"type": "chat", "time": 826.573, "timestamp": "00:13:46", "author": "@Legend__8055-7", "avatar": "https://yt4.ggpht.com/h7rPbxlZLgAoQ4WQreLmN5CGuBDaAqrOcRu5IS2bB9ZxFUTHgdnW1GYPK4UM2if6lNaCX_KYaLU=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/egJ1XufTKYfegwOo57ewAg"}, {"type": "chat", "time": 827.766, "timestamp": "00:13:47", "author": "@redx7454", "avatar": "https://yt4.ggpht.com/ZnCeavb1XjhCUyF0gPZf2zqHWkwDjnzleyD1oxpd-9re-emmqNet6n-8w_OiHe_rvcNpzZPLgw=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/egJ1XufTKYfegwOo57ewAg"}, {"type": "subtitle", "time": 828.47, "timestamp": "00:13:48", "text": "我已经有了 PAL 盒子，是的，"}, {"type": "subtitle", "time": 830.87, "timestamp": "00:13:50", "text": "但是我们不能放置它，因为数量"}, {"type": "subtitle", "time": 833.75, "timestamp": "00:13:53", "text": "限制为两个，你"}, {"type": "subtitle", "time": 837.11, "timestamp": "00:13:57", "text": "必须去那里放置盒子。"}, {"type": "subtitle", "time": 839.269, "timestamp": "00:13:59", "text": "所以，它要坏了。"}]
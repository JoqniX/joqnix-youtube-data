[{"type": "subtitle", "time": 5640.79, "timestamp": "01:34:00", "text": "为什么你之前没告诉我这件事"}, {"type": "subtitle", "time": 5641.99, "timestamp": "01:34:01", "text": "？"}, {"type": "subtitle", "time": 5643.91, "timestamp": "01:34:03", "text": "因为你没问。"}, {"type": "subtitle", "time": 5644.629, "timestamp": "01:34:04", "text": "哇。"}, {"type": "subtitle", "time": 5647.27, "timestamp": "01:34:07", "text": "没关系。 没关系。 你"}, {"type": "subtitle", "time": 5649.11, "timestamp": "01:34:09", "text": "知道，那里有很多"}, {"type": "subtitle", "time": 5652.55, "timestamp": "01:34:12", "text": "任务。 没关系。 即使只是积累了"}, {"type": "subtitle", "time": 5654.709, "timestamp": "01:34:14", "text": "经验，比如现在你"}, {"type": "subtitle", "time": 5656.47, "timestamp": "01:34:16", "text": "知道自己以后会遇到这类"}, {"type": "chat", "time": 5658.387, "timestamp": "01:34:18", "author": "@Rafuru-kun", "avatar": "https://yt4.ggpht.com/RSNQezryqjIUt2eZ7qUKQhaxvO0n4vUecnjPV4OOX9fEvgK7V1zIa1uzk4RwpsgFvU3I1e4xvus=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/E8MfY5u7JPSXkNAP95GAmAEUCkszU2WH9gy1mb0dV-11UJg/E8MfY5u7JPSXkNAP95GAmAEUCkszU2WH9gy1mb0dV-11UJg/E8MfY5u7JPSXkNAP95GAmAE"}, {"type": "subtitle", "time": 5658.709, "timestamp": "01:34:18", "text": "事情。"}, {"type": "subtitle", "time": 5661.27, "timestamp": "01:34:21", "text": "你"}, {"type": "subtitle", "time": 5671.03, "timestamp": "01:34:31", "text": "我当时也和你一起做这些。"}, {"type": "subtitle", "time": 5673.43, "timestamp": "01:34:33", "text": "你知道这个"}, {"type": "subtitle", "time": 5680.47, "timestamp": "01:34:40", "text": "不，我以为你们可能"}, {"type": "subtitle", "time": 5682.95, "timestamp": "01:34:42", "text": "已经在自己的世界里做过这件事了，所以"}, {"type": "subtitle", "time": 5685.03, "timestamp": "01:34:45", "text": "对你们来说也是开放的。"}, {"type": "subtitle", "time": 5686.149, "timestamp": "01:34:46", "text": "不，不，不，不。"}, {"type": "subtitle", "time": 5688.95, "timestamp": "01:34:48", "text": "只为我打开。"}, {"type": "subtitle", "time": 5689.75, "timestamp": "01:34:49", "text": "哦，"}, {"type": "subtitle", "time": 5692.229, "timestamp": "01:34:52", "text": "这是我的世界。   是的"}]
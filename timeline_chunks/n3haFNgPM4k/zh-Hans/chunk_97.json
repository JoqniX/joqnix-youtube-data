[{"type": "subtitle", "time": 5822.709, "timestamp": "01:37:02", "text": "如果你按下 E 键，就能在"}, {"type": "subtitle", "time": 5825.189, "timestamp": "01:37:05", "text": "这里看到你所有的朋友。"}, {"type": "subtitle", "time": 5826.87, "timestamp": "01:37:06", "text": "哦，是的。"}, {"type": "subtitle", "time": 5829.189, "timestamp": "01:37:09", "text": "你可以给他们配备任何你"}, {"type": "subtitle", "time": 5830.39, "timestamp": "01:37:10", "text": "喜欢的装备。"}, {"type": "subtitle", "time": 5832.47, "timestamp": "01:37:12", "text": "哦，是的"}, {"type": "subtitle", "time": 5837.03, "timestamp": "01:37:17", "text": "你知道哪里能找到"}, {"type": "subtitle", "time": 5839.75, "timestamp": "01:37:19", "text": "他们。"}, {"type": "subtitle", "time": 5840.95, "timestamp": "01:37:20", "text": "我觉得我是在"}, {"type": "subtitle", "time": 5844.39, "timestamp": "01:37:24", "text": "人们的笼子里找到它的。 就像我"}, {"type": "subtitle", "time": 5847.109, "timestamp": "01:37:27", "text": "刚把她从笼子里放出来一样。"}, {"type": "subtitle", "time": 5849.75, "timestamp": "01:37:29", "text": "人们在设陷阱困住她。"}, {"type": "subtitle", "time": 5850.87, "timestamp": "01:37:30", "text": "我死了。"}, {"type": "subtitle", "time": 5852.229, "timestamp": "01:37:32", "text": "哦，所以你也可以把"}, {"type": "subtitle", "time": 5855.27, "timestamp": "01:37:35", "text": "你的朋友送人。   是的"}, {"type": "subtitle", "time": 5857.51, "timestamp": "01:37:37", "text": "。   我的"}, {"type": "subtitle", "time": 5861.43, "timestamp": "01:37:41", "text": "天啊，我死了。"}, {"type": "subtitle", "time": 5864.95, "timestamp": "01:37:44", "text": "妈妈，你也可以繁殖它们。"}, {"type": "subtitle", "time": 5874.709, "timestamp": "01:37:54", "text": "谢谢你关注我之后的深星"}]
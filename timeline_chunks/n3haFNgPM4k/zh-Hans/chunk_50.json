[{"type": "subtitle", "time": 3003.67, "timestamp": "00:50:03", "text": "该死。 我真的杀了一个NPC。 我的天哪，"}, {"type": "subtitle", "time": 3013.43, "timestamp": "00:50:13", "text": "帕克，是你吗？ 它是"}, {"type": "subtitle", "time": 3016.79, "timestamp": "00:50:16", "text": "闪耀。 哦，"}, {"type": "subtitle", "time": 3031.67, "timestamp": "00:50:31", "text": "你要跳下去。 嘘。 你要从"}, {"type": "subtitle", "time": 3035.75, "timestamp": "00:50:35", "text": "这里跳下去吗？ 哦，"}, {"type": "subtitle", "time": 3045.19, "timestamp": "00:50:45", "text": "呃，"}, {"type": "subtitle", "time": 3047.99, "timestamp": "00:50:47", "text": "我在找传送点。"}, {"type": "subtitle", "time": 3051.03, "timestamp": "00:50:51", "text": "这里没有传送点吗？ 请"}, {"type": "subtitle", "time": 3051.75, "timestamp": "00:50:51", "text": "告知我们。"}, {"type": "subtitle", "time": 3054.15, "timestamp": "00:50:54", "text": "好的。 所以，我们需要跳（音乐），然后我们"}, {"type": "subtitle", "time": 3056.63, "timestamp": "00:50:56", "text": "必须去那个黄色区域。 所以，"}, {"type": "subtitle", "time": 3058.79, "timestamp": "00:50:58", "text": "米娜，保持体力。"}]
[{"type": "subtitle", "time": 3965.19, "timestamp": "01:06:05", "text": "哦，他们要开枪打我。"}, {"type": "subtitle", "time": 3966.63, "timestamp": "01:06:06", "text": "嗯，"}, {"type": "subtitle", "time": 3967.109, "timestamp": "01:06:07", "text": "你好。"}, {"type": "subtitle", "time": 3972.23, "timestamp": "01:06:12", "text": "你不能。 你必须完成这个"}, {"type": "subtitle", "time": 3974.23, "timestamp": "01:06:14", "text": "任务。"}, {"type": "subtitle", "time": 3976.63, "timestamp": "01:06:16", "text": "我正在做任务。"}, {"type": "subtitle", "time": 3991.43, "timestamp": "01:06:31", "text": "等等，你们也会来参加"}, {"type": "subtitle", "time": 3994.87, "timestamp": "01:06:34", "text": "这个NPC战斗吗？（笑）还是说我拖延了？"}, {"type": "subtitle", "time": 3996.71, "timestamp": "01:06:36", "text": "兄弟，我打不过他们。 我"}, {"type": "subtitle", "time": 4004.71, "timestamp": "01:06:44", "text": "你输了。 更轻松。 这"}, {"type": "subtitle", "time": 4007.75, "timestamp": "01:06:47", "text": "很容易打败，兄弟。 你想让我"}, {"type": "subtitle", "time": 4009.67, "timestamp": "01:06:49", "text": "死吗？等我来了，我们"}, {"type": "subtitle", "time": 4012.789, "timestamp": "01:06:52", "text": "一起打败它。"}]
[{"type": "subtitle", "time": 4981.83, "timestamp": "01:23:01", "text": "好，"}, {"type": "subtitle", "time": 4983.189, "timestamp": "01:23:03", "text": "我们走吧。"}, {"type": "subtitle", "time": 4984.55, "timestamp": "01:23:04", "text": "我必须……"}, {"type": "subtitle", "time": 4987.669, "timestamp": "01:23:07", "text": "你想去那个地下城吗？ 我"}, {"type": "subtitle", "time": 4990.31, "timestamp": "01:23:10", "text": "地牢捕获"}, {"type": "subtitle", "time": 4993.43, "timestamp": "01:23:13", "text": "捕获狐狸火花。"}, {"type": "subtitle", "time": 4995.03, "timestamp": "01:23:15", "text": "狐狸火花。 过来。 过来。 过来"}, {"type": "subtitle", "time": 5000.95, "timestamp": "01:23:20", "text": "。"}, {"type": "subtitle", "time": 5003.83, "timestamp": "01:23:23", "text": "我们再玩一会儿吧，你们可以……"}, {"type": "subtitle", "time": 5007.75, "timestamp": "01:23:27", "text": "哦，我看到"}, {"type": "subtitle", "time": 5009.75, "timestamp": "01:23:29", "text": "前面有几个了。   是的"}, {"type": "subtitle", "time": 5011.99, "timestamp": "01:23:31", "text": "，"}, {"type": "subtitle", "time": 5014.229, "timestamp": "01:23:34", "text": "我找到了。   我们"}, {"type": "subtitle", "time": 5031.27, "timestamp": "01:23:51", "text": "知道了。"}, {"type": "subtitle", "time": 5033.59, "timestamp": "01:23:53", "text": "去。"}, {"type": "subtitle", "time": 5036.39, "timestamp": "01:23:56", "text": "好的。 解锁四火花束线"}, {"type": "subtitle", "time": 5039.669, "timestamp": "01:23:59", "text": "技术，即可将其制作成消防装备。"}]
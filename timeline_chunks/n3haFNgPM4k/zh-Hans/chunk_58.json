[{"type": "subtitle", "time": 3482.23, "timestamp": "00:58:02", "text": "塔楼第一塔楼区域。"}, {"type": "subtitle", "time": 3489.349, "timestamp": "00:58:09", "text": "我是什么？"}, {"type": "subtitle", "time": 3492.549, "timestamp": "00:58:12", "text": "我不能，我不能用卫生纸。 为什么？ 过来。 过来"}, {"type": "subtitle", "time": 3493.99, "timestamp": "00:58:13", "text": "。   是的"}, {"type": "subtitle", "time": 3496.63, "timestamp": "00:58:16", "text": "。"}, {"type": "subtitle", "time": 3500.15, "timestamp": "00:58:20", "text": "所以在PAL世界里我们不能那样传送。"}, {"type": "subtitle", "time": 3503.51, "timestamp": "00:58:23", "text": "所以我们需要找到其中一个物体，"}, {"type": "subtitle", "time": 3506.71, "timestamp": "00:58:26", "text": "然后靠近它。 按下快速旅行键，"}, {"type": "subtitle", "time": 3509.51, "timestamp": "00:58:29", "text": "现在我们可以进行DP了。   是的"}, {"type": "subtitle", "time": 3517.109, "timestamp": "00:58:37", "text": "哦，原来是这样啊。   是的"}, {"type": "subtitle", "time": 3517.51, "timestamp": "00:58:37", "text": "。"}, {"type": "subtitle", "time": 3520.309, "timestamp": "00:58:40", "text": "哦，"}, {"type": "subtitle", "time": 3522.39, "timestamp": "00:58:42", "text": "你可以穿着裤子一起睡觉。"}, {"type": "subtitle", "time": 3525.349, "timestamp": "00:58:45", "text": "什么？   是的"}, {"type": "subtitle", "time": 3526.309, "timestamp": "00:58:46", "text": "。"}, {"type": "subtitle", "time": 3527.27, "timestamp": "00:58:47", "text": "你在哪里？"}]
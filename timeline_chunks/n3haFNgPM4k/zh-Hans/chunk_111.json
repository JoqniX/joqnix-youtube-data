[{"type": "subtitle", "time": 6661.75, "timestamp": "01:51:01", "text": "但我得去慢跑。 等等，让我"}, {"type": "subtitle", "time": 6664.229, "timestamp": "01:51:04", "text": "先把那个全局堆叠箱给你。"}, {"type": "subtitle", "time": 6678.55, "timestamp": "01:51:18", "text": "你花了多长时间制作这个基地？"}, {"type": "subtitle", "time": 6680.709, "timestamp": "01:51:20", "text": "它真漂亮。"}, {"type": "subtitle", "time": 6683.59, "timestamp": "01:51:23", "text": "还没完成，对吧？   是的"}, {"type": "subtitle", "time": 6686.149, "timestamp": "01:51:26", "text": "。 从这里离开。 不要动它。"}, {"type": "subtitle", "time": 6686.709, "timestamp": "01:51:26", "text": "移动。   是的"}, {"type": "subtitle", "time": 6696.709, "timestamp": "01:51:36", "text": "这样我就可以把它放下来了。"}, {"type": "subtitle", "time": 6700.07, "timestamp": "01:51:40", "text": "他们速度很快。"}, {"type": "subtitle", "time": 6709.83, "timestamp": "01:51:49", "text": "我现在可以直接拖拽它们了。 我不能带走"}, {"type": "subtitle", "time": 6712.39, "timestamp": "01:51:52", "text": "鹰。"}, {"type": "subtitle", "time": 6715.03, "timestamp": "01:51:55", "text": "好的。"}, {"type": "subtitle", "time": 6716.55, "timestamp": "01:51:56", "text": "如果你想要的话，我可以送你一个飞行器"}, {"type": "subtitle", "time": 6718.31, "timestamp": "01:51:58", "text": "。 但你不需要，"}]
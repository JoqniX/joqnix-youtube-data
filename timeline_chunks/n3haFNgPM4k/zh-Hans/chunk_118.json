[{"type": "subtitle", "time": 7081.189, "timestamp": "01:58:01", "text": "耐啃食。 哦，原来他"}, {"type": "subtitle", "time": 7083.43, "timestamp": "01:58:03", "text": "穿的就是这个。   是的"}, {"type": "subtitle", "time": 7105.03, "timestamp": "01:58:25", "text": "那么，如何才能获得更高稀有度的"}, {"type": "subtitle", "time": 7107.83, "timestamp": "01:58:27", "text": "物品呢？"}, {"type": "subtitle", "time": 7109.51, "timestamp": "01:58:29", "text": "我不知道。 我只是"}, {"type": "subtitle", "time": 7111.109, "timestamp": "01:58:31", "text": "随机得到的。"}, {"type": "subtitle", "time": 7113.669, "timestamp": "01:58:33", "text": "嗯。"}, {"type": "subtitle", "time": 7114.95, "timestamp": "01:58:34", "text": "假设我需要某样东西。 我去拿"}, {"type": "subtitle", "time": 7117.91, "timestamp": "01:58:37", "text": "。 看看我究竟"}, {"type": "subtitle", "time": 7120.229, "timestamp": "01:58:40", "text": "需要什么。"}, {"type": "subtitle", "time": 7122.87, "timestamp": "01:58:42", "text": "是的，我达到了最高等级。"}, {"type": "subtitle", "time": 7125.91, "timestamp": "01:58:45", "text": "等等，那是最高等级的金属吗？"}, {"type": "subtitle", "time": 7129.43, "timestamp": "01:58:49", "text": "是啊，这套盔甲比我之前"}, {"type": "subtitle", "time": 7130.31, "timestamp": "01:58:50", "text": "用的那套酷多了。"}]
[{"type": "subtitle", "time": 4327.43, "timestamp": "01:12:07", "text": "定时器。"}, {"type": "subtitle", "time": 4333.11, "timestamp": "01:12:13", "text": "好的，我明白了。 对不起。 我死了。"}, {"type": "subtitle", "time": 4335.43, "timestamp": "01:12:15", "text": "他不是那个人。"}, {"type": "subtitle", "time": 4352.31, "timestamp": "01:12:32", "text": "我找不到羊肉丸。"}, {"type": "subtitle", "time": 4355.43, "timestamp": "01:12:35", "text": "这是一只绵羊。 这是一只绵羊。"}, {"type": "subtitle", "time": 4356.47, "timestamp": "01:12:36", "text": "就在里面，"}, {"type": "subtitle", "time": 4358.39, "timestamp": "01:12:38", "text": "我正在找它。 我看到了那张照片，"}, {"type": "subtitle", "time": 4360.229, "timestamp": "01:12:40", "text": "但我正在找它。 我找不到"}, {"type": "subtitle", "time": 4360.87, "timestamp": "01:12:40", "text": "它。"}, {"type": "subtitle", "time": 4363.27, "timestamp": "01:12:43", "text": "好的，那我们去最简单的地方，也就是"}, {"type": "subtitle", "time": 4367.27, "timestamp": "01:12:47", "text": "我们出生的出生点。"}, {"type": "subtitle", "time": 4368.39, "timestamp": "01:12:48", "text": "嘿，"}, {"type": "subtitle", "time": 4369.669, "timestamp": "01:12:49", "text": "等等，等等，等等，"}, {"type": "subtitle", "time": 4372.149, "timestamp": "01:12:52", "text": "等等。 有一种"}, {"type": "subtitle", "time": 4376.229, "timestamp": "01:12:56", "text": "地图之类的东西，它会"}, {"type": "subtitle", "time": 4377.99, "timestamp": "01:12:57", "text": "显示“哦，我找到了”。 我找到了"}]
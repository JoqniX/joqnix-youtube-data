[{"type": "subtitle", "time": 3062.23, "timestamp": "00:51:02", "text": "好的。 是的。"}, {"type": "subtitle", "time": 3066.23, "timestamp": "00:51:06", "text": "呃，你觉得怎么样？"}, {"type": "subtitle", "time": 3069.03, "timestamp": "00:51:09", "text": "你跳伞。"}, {"type": "subtitle", "time": 3071.27, "timestamp": "00:51:11", "text": "我要摔倒了。 不，不，不。 你"}, {"type": "subtitle", "time": 3076.15, "timestamp": "00:51:16", "text": "你在哪里？"}, {"type": "subtitle", "time": 3080.23, "timestamp": "00:51:20", "text": "国王佩卡还有哪些能力？"}, {"type": "subtitle", "time": 3098.23, "timestamp": "00:51:38", "text": "闪闪发光的那个就像一个闪亮的朋友。"}, {"type": "subtitle", "time": 3101.03, "timestamp": "00:51:41", "text": "等等，我想我可以把羊肉球"}, {"type": "subtitle", "time": 3103.91, "timestamp": "00:51:43", "text": "像大巴拉一样放在牧场里。 它还会"}, {"type": "subtitle", "time": 3107.349, "timestamp": "00:51:47", "text": "产羊毛。 我有一个 alpha"}, {"type": "subtitle", "time": 3108.95, "timestamp": "00:51:48", "text": "wala。"}, {"type": "subtitle", "time": 3115.03, "timestamp": "00:51:55", "text": "农户。   是的"}]
[{"type": "subtitle", "time": 4202.79, "timestamp": "01:10:02", "text": "寒意。"}, {"type": "subtitle", "time": 4205.99, "timestamp": "01:10:05", "text": "它去哪儿了？"}, {"type": "subtitle", "time": 4209.75, "timestamp": "01:10:09", "text": "狗币。 我有 20 枚狗币。 如何？"}, {"type": "subtitle", "time": 4210.87, "timestamp": "01:10:10", "text": "什么是狗币？"}, {"type": "subtitle", "time": 4219.83, "timestamp": "01:10:19", "text": "等等，什么？ 狗币。"}, {"type": "subtitle", "time": 4222.149, "timestamp": "01:10:22", "text": "狗狗币就是货币。 你可以"}, {"type": "subtitle", "time": 4224.55, "timestamp": "01:10:24", "text": "从他们那里购买东西。 来自黑市"}, {"type": "subtitle", "time": 4225.99, "timestamp": "01:10:25", "text": "商人。"}, {"type": "subtitle", "time": 4227.75, "timestamp": "01:10:27", "text": "哦，对了，"}, {"type": "subtitle", "time": 4237.99, "timestamp": "01:10:37", "text": "我用那根快要用完的长矛戳他。"}, {"type": "subtitle", "time": 4246.95, "timestamp": "01:10:46", "text": "如果我现在不用队友就能独自完成这件事，那我"}]
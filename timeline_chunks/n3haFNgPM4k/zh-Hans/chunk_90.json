[{"type": "subtitle", "time": 5403.35, "timestamp": "01:30:03", "text": "呃，我有吗？好吧，100个就够了。"}, {"type": "subtitle", "time": 5407.59, "timestamp": "01:30:07", "text": "佐伊就像个小女孩。 我这就走。"}, {"type": "subtitle", "time": 5409.189, "timestamp": "01:30:09", "text": "她对此无能为力吗？"}, {"type": "subtitle", "time": 5411.27, "timestamp": "01:30:11", "text": "请不要拿走我精炼的东西。 我"}, {"type": "subtitle", "time": 5414.07, "timestamp": "01:30:14", "text": "必须这样做，"}, {"type": "subtitle", "time": 5419.51, "timestamp": "01:30:19", "text": "因为我是主炉子。"}, {"type": "subtitle", "time": 5420.39, "timestamp": "01:30:20", "text": "好吧，"}, {"type": "subtitle", "time": 5423.83, "timestamp": "01:30:23", "text": "我不拿了，"}, {"type": "subtitle", "time": 5428.692, "timestamp": "01:30:28", "text": "我甚至不知道她为什么要拿"}, {"type": "subtitle", "time": 5436.552, "timestamp": "01:30:36", "text": "她就是会选它。 住口。"}, {"type": "subtitle", "time": 5443.91, "timestamp": "01:30:43", "text": "不知为何，乔把我的八块精炼锭子一直放在他的箱子里。"}, {"type": "subtitle", "time": 5446.39, "timestamp": "01:30:46", "text": "我有"}]
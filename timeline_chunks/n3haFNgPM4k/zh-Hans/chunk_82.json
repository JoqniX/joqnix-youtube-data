[{"type": "subtitle", "time": 4921.35, "timestamp": "01:22:01", "text": "还有一件事忘了告诉你，"}, {"type": "subtitle", "time": 4923.35, "timestamp": "01:22:03", "text": "其实你不必装备那个"}, {"type": "subtitle", "time": 4927.27, "timestamp": "01:22:07", "text": "抑郁药水。 你可以装备你的"}, {"type": "subtitle", "time": 4930.31, "timestamp": "01:22:10", "text": "盔甲，然后我们可以把那个东西变成"}, {"type": "subtitle", "time": 4933.35, "timestamp": "01:22:13", "text": "镜子。"}, {"type": "subtitle", "time": 4936.79, "timestamp": "01:22:16", "text": "我们几个朋友正在打造这把剑。 我"}, {"type": "subtitle", "time": 4937.43, "timestamp": "01:22:17", "text": "拿到了"}, {"type": "subtitle", "time": 4939.59, "timestamp": "01:22:19", "text": "王者之剑，它将会终结"}, {"type": "subtitle", "time": 4957.43, "timestamp": "01:22:37", "text": "我的天哪，这就好比说“"}, {"type": "subtitle", "time": 4968.149, "timestamp": "01:22:48", "text": "哦，对了，Ara 可以把它做成那个古董"}, {"type": "subtitle", "time": 4970.07, "timestamp": "01:22:50", "text": "梳妆台。"}, {"type": "subtitle", "time": 4975.669, "timestamp": "01:22:55", "text": "21分钟内完成一次短杀。然后你就可以"}]
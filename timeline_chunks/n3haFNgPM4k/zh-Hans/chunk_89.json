[{"type": "subtitle", "time": 5340.31, "timestamp": "01:29:00", "text": "，它们是你的。   是的"}, {"type": "subtitle", "time": 5340.629, "timestamp": "01:29:00", "text": "，"}, {"type": "subtitle", "time": 5342.95, "timestamp": "01:29:02", "text": "它们是你的。 盒子一、盒子二、"}, {"type": "subtitle", "time": 5347.75, "timestamp": "01:29:07", "text": "盒子三十二里，都是你的了。"}, {"type": "subtitle", "time": 5350.229, "timestamp": "01:29:10", "text": "啊。   是的"}, {"type": "subtitle", "time": 5350.709, "timestamp": "01:29:10", "text": "。"}, {"type": "subtitle", "time": 5353.59, "timestamp": "01:29:13", "text": "我的意思是，他把他们从"}, {"type": "subtitle", "time": 5355.27, "timestamp": "01:29:15", "text": "1号到32号都抓走了。"}, {"type": "subtitle", "time": 5360.31, "timestamp": "01:29:20", "text": "是的。 呃，"}, {"type": "subtitle", "time": 5362.31, "timestamp": "01:29:22", "text": "我看到的只有一个盒子。   是的"}, {"type": "subtitle", "time": 5365.99, "timestamp": "01:29:25", "text": "。 插槽 2 至 32 为空。 哦，是的"}, {"type": "subtitle", "time": 5368.07, "timestamp": "01:29:28", "text": "。"}, {"type": "subtitle", "time": 5370.709, "timestamp": "01:29:30", "text": "等等，你的堆叠箱不一样。   是的"}, {"type": "subtitle", "time": 5371.27, "timestamp": "01:29:31", "text": "。"}, {"type": "subtitle", "time": 5373.83, "timestamp": "01:29:33", "text": "不，我们每个人都有不同的位置。"}, {"type": "subtitle", "time": 5376.47, "timestamp": "01:29:36", "text": "就像我们每个人都有不同的位置一样。"}, {"type": "subtitle", "time": 5379.99, "timestamp": "01:29:39", "text": "全球性即普遍性。"}, {"type": "subtitle", "time": 5382.47, "timestamp": "01:29:42", "text": "所以基本上我的粉丝他看不见。"}, {"type": "subtitle", "time": 5391.03, "timestamp": "01:29:51", "text": "只有分配给我们的那个。 我们能看到"}, {"type": "subtitle", "time": 5393.669, "timestamp": "01:29:53", "text": "它们。 那些在"}]
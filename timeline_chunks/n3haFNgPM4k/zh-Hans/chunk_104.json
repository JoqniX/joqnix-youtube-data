[{"type": "subtitle", "time": 6243.189, "timestamp": "01:44:03", "text": "我有很多强壮的朋友，兄弟。 不，"}, {"type": "subtitle", "time": 6245.109, "timestamp": "01:44:05", "text": "我一次都没打过就拿到了70级的PAL"}, {"type": "subtitle", "time": 6247.03, "timestamp": "01:44:07", "text": "。   就像"}, {"type": "subtitle", "time": 6249.03, "timestamp": "01:44:09", "text": "结束了一样，伙计。"}, {"type": "subtitle", "time": 6252.31, "timestamp": "01:44:12", "text": "什么？ 如何？"}, {"type": "subtitle", "time": 6254.39, "timestamp": "01:44:14", "text": "我得到了一把古代长矛。 它能让你"}, {"type": "subtitle", "time": 6257.83, "timestamp": "01:44:17", "text": "与任何朋友建立强大的联系。"}, {"type": "subtitle", "time": 6259.83, "timestamp": "01:44:19", "text": "哦，古老的长矛。 你是如何被"}, {"type": "subtitle", "time": 6262.709, "timestamp": "01:44:22", "text": "塑造成这样的？ 你可以在一个宝箱里找到它，"}, {"type": "subtitle", "time": 6264.87, "timestamp": "01:44:24", "text": "也可以在一个未被记录的岛屿上找到它，而其他岛屿则已被记录"}, {"type": "subtitle", "time": 6267.189, "timestamp": "01:44:27", "text": "。 所以，你"}, {"type": "subtitle", "time": 6269.03, "timestamp": "01:44:29", "text": "必须打败一个boss。 但我去了那座"}, {"type": "subtitle", "time": 6270.709, "timestamp": "01:44:30", "text": "塔。"}, {"type": "subtitle", "time": 6272.07, "timestamp": "01:44:32", "text": "所以塔里有个传送门。"}, {"type": "subtitle", "time": 6273.109, "timestamp": "01:44:33", "text": "即使不打败 Boss，你"}, {"type": "subtitle", "time": 6275.109, "timestamp": "01:44:35", "text": "仍然可以进入传送门。 然后我登录"}, {"type": "subtitle", "time": 6278.47, "timestamp": "01:44:38", "text": "门户网站。 然后我解锁了那片天空。"}, {"type": "subtitle", "time": 6280.39, "timestamp": "01:44:40", "text": "然后我找到了宝箱，因为那些"}, {"type": "subtitle", "time": 6282.95, "timestamp": "01:44:42", "text": "怪物等级非常高。 我和"}, {"type": "subtitle", "time": 6285.109, "timestamp": "01:44:45", "text": "我的小队一起死了五六次。"}, {"type": "subtitle", "time": 6287.109, "timestamp": "01:44:47", "text": "然后我发现了很多箱子。 然后我找到了"}, {"type": "subtitle", "time": 6289.59, "timestamp": "01:44:49", "text": "一个非常古老的备用件，就一个。"}, {"type": "subtitle", "time": 6289.99, "timestamp": "01:44:49", "text": "嗯。"}, {"type": "subtitle", "time": 6292.31, "timestamp": "01:44:52", "text": "我冒险挑战了那个超强"}, {"type": "subtitle", "time": 6294.612, "timestamp": "01:44:54", "text": "级别的怪物。 就像那种游戏末期的"}, {"type": "subtitle", "time": 6296.629, "timestamp": "01:44:56", "text": "暴民一样[清嗓子]。"}, {"type": "subtitle", "time": 6299.27, "timestamp": "01:44:59", "text": "来我的主基地。 我来给你演示一下。"}]
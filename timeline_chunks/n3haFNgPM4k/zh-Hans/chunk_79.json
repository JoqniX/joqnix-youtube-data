[{"type": "subtitle", "time": 4740.149, "timestamp": "01:19:00", "text": "。 然后装备上它，进行二段跳。"}, {"type": "subtitle", "time": 4742.229, "timestamp": "01:19:02", "text": "右键点击它。   是的"}, {"type": "subtitle", "time": 4743.669, "timestamp": "01:19:03", "text": "。"}, {"type": "subtitle", "time": 4745.43, "timestamp": "01:19:05", "text": "二段跳。"}, {"type": "subtitle", "time": 4746.47, "timestamp": "01:19:06", "text": "哇哦。 但这"}, {"type": "subtitle", "time": 4747.91, "timestamp": "01:19:07", "text": "并非常态。"}, {"type": "subtitle", "time": 4749.59, "timestamp": "01:19:09", "text": "哦，我们走吧。"}, {"type": "subtitle", "time": 4751.83, "timestamp": "01:19:11", "text": "哇。 哇。"}, {"type": "subtitle", "time": 4754.79, "timestamp": "01:19:14", "text": "找到一个小村落，和"}, {"type": "subtitle", "time": 4757.59, "timestamp": "01:19:17", "text": "村长谈谈。 好的。 好的。 它位于非常遥远的"}, {"type": "subtitle", "time": 4761.43, "timestamp": "01:19:21", "text": "地方。 它在哪里？"}, {"type": "subtitle", "time": 4771.43, "timestamp": "01:19:31", "text": "好的。"}, {"type": "subtitle", "time": 4778.47, "timestamp": "01:19:38", "text": "等待。 呃，石头、金属、铁，这里的"}, {"type": "subtitle", "time": 4781.99, "timestamp": "01:19:41", "text": "资源是怎么运作的"}, {"type": "subtitle", "time": 4785.91, "timestamp": "01:19:45", "text": "？ 就像在《我的世界》里一样，我们从木头"}, {"type": "subtitle", "time": 4789.669, "timestamp": "01:19:49", "text": "到石头，再到铁，最后到钻石，对吧？"}, {"type": "subtitle", "time": 4796.39, "timestamp": "01:19:56", "text": "。   是的"}]
[{"type": "subtitle", "time": 6782.55, "timestamp": "01:53:02", "text": "你想见的那个猫女士。"}, {"type": "subtitle", "time": 6783.589, "timestamp": "01:53:03", "text": "哦，是那个狗狗的。   他是"}, {"type": "subtitle", "time": 6785.669, "timestamp": "01:53:05", "text": "最强壮的人之一。"}, {"type": "subtitle", "time": 6792.149, "timestamp": "01:53:12", "text": "活下去。 哇。"}, {"type": "subtitle", "time": 6795.669, "timestamp": "01:53:15", "text": "很难打败它吗？"}, {"type": "subtitle", "time": 6798.229, "timestamp": "01:53:18", "text": "我直接进入一个高级好友房间，然后"}, {"type": "subtitle", "time": 6800.31, "timestamp": "01:53:20", "text": "用这个狂轰滥炸。"}, {"type": "subtitle", "time": 6803.589, "timestamp": "01:53:23", "text": "这是一把投掷帕尔菲尔的枪。"}, {"type": "subtitle", "time": 6806.39, "timestamp": "01:53:26", "text": "哦，这个。"}, {"type": "subtitle", "time": 6807.27, "timestamp": "01:53:27", "text": "好的。 好的。 好的。   是的"}, {"type": "subtitle", "time": 6811.35, "timestamp": "01:53:31", "text": "。 所以我联系了一些等级很高的朋友，就把他弄到手了，当时"}, {"type": "subtitle", "time": 6823.75, "timestamp": "01:53:43", "text": "就连这个，这也是"}, {"type": "subtitle", "time": 6826.229, "timestamp": "01:53:46", "text": "我的飞风的蓝色版本。 我"}, {"type": "subtitle", "time": 6828.229, "timestamp": "01:53:48", "text": "得到了它。 甚至没有造成任何损害。"}]
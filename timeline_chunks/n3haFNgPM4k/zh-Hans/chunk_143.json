[{"type": "subtitle", "time": 8581.429, "timestamp": "02:23:01", "text": "要做的事情很多，责任很多，比如"}, {"type": "subtitle", "time": 8585.27, "timestamp": "02:23:05", "text": "去超市买东西、"}, {"type": "subtitle", "time": 8587.429, "timestamp": "02:23:07", "text": "打扫卫生"}, {"type": "subtitle", "time": 8588.95, "timestamp": "02:23:08", "text": "等等。"}, {"type": "subtitle", "time": 8592.379, "timestamp": "02:23:12", "text": "时间过得真快。"}, {"type": "subtitle", "time": 8593.429, "timestamp": "02:23:13", "text": "[笑声]"}, {"type": "subtitle", "time": 8597.349, "timestamp": "02:23:17", "text": "你甚至都没时间。 我想"}, {"type": "subtitle", "time": 8599.429, "timestamp": "02:23:19", "text": "这就是（音乐）的本质，它关乎"}, {"type": "subtitle", "time": 8602.389, "timestamp": "02:23:22", "text": "成为一个成年人，"}, {"type": "subtitle", "time": 8605.67, "timestamp": "02:23:25", "text": "或者说成为一个成年人。 你几乎没有时间，"}, {"type": "subtitle", "time": 8607.59, "timestamp": "02:23:27", "text": "我想这就是我现在的处境"}, {"type": "subtitle", "time": 8615.349, "timestamp": "02:23:35", "text": "不过，谢谢大家今天的一切。"}, {"type": "subtitle", "time": 8618.79, "timestamp": "02:23:38", "text": "我已经说过一段时间了，"}, {"type": "subtitle", "time": 8620.63, "timestamp": "02:23:40", "text": "但是，是的，[音乐]，谢谢你今天。"}, {"type": "subtitle", "time": 8623.83, "timestamp": "02:23:43", "text": "祝大家一切顺利。 好的。"}, {"type": "subtitle", "time": 8628.469, "timestamp": "02:23:48", "text": "一定要玩得开心。 今天一定要笑容"}, {"type": "subtitle", "time": 8630.87, "timestamp": "02:23:50", "text": "灿烂，"}, {"type": "subtitle", "time": 8633.99, "timestamp": "02:23:53", "text": "即使很困难也要继续努力。"}, {"type": "subtitle", "time": 8638.389, "timestamp": "02:23:58", "text": "休息一下。 充分休息。"}]
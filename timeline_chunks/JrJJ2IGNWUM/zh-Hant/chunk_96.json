[{"type": "subtitle", "time": 5763.27, "timestamp": "01:36:03", "text": "問題，總是會說"}, {"type": "subtitle", "time": 5766.629, "timestamp": "01:36:06", "text": "我被虐待了，現在我走了，"}, {"type": "subtitle", "time": 5768.709, "timestamp": "01:36:08", "text": "英雄隊伍沒有我就很痛苦，"}, {"type": "subtitle", "time": 5770.47, "timestamp": "01:36:10", "text": "他們想讓我回去，總是"}, {"type": "subtitle", "time": 5772.99, "timestamp": "01:36:12", "text": "同樣的破事一遍又一遍地發生"}, {"type": "subtitle", "time": 5776.79, "timestamp": "01:36:16", "text": "。但我還是覺得很有趣，對吧？"}, {"type": "subtitle", "time": 5778.629, "timestamp": "01:36:18", "text": "我不在乎劇情是否"}, {"type": "subtitle", "time": 5780.47, "timestamp": "01:36:20", "text": "重複。我不在乎"}, {"type": "subtitle", "time": 5782.149, "timestamp": "01:36:22", "text": "角色基本上是從前作複製貼上過來的，"}, {"type": "subtitle", "time": 5784.95, "timestamp": "01:36:24", "text": "也不在乎"}, {"type": "subtitle", "time": 5787.03, "timestamp": "01:36:27", "text": "主角團是不是一群傻瓜，"}, {"type": "subtitle", "time": 5789.59, "timestamp": "01:36:29", "text": "更不在乎新作總是"}, {"type": "subtitle", "time": 5791.99, "timestamp": "01:36:31", "text": "比舊作好。就好像，老兄，"}, {"type": "subtitle", "time": 5794.55, "timestamp": "01:36:34", "text": "我不在乎。我讀得很開心，"}, {"type": "subtitle", "time": 5796.39, "timestamp": "01:36:36", "text": "對吧？是的。那你呢，"}, {"type": "subtitle", "time": 5798.79, "timestamp": "01:36:38", "text": "傑基？除了異世界主題的爛片之外，"}, {"type": "subtitle", "time": 5801.27, "timestamp": "01:36:41", "text": "你覺得還有哪些作品雖然被"}, {"type": "subtitle", "time": 5804.709, "timestamp": "01:36:44", "text": "大家視為垃圾，但仍然很有趣"}, {"type": "subtitle", "time": 5806.59, "timestamp": "01:36:46", "text": "或讓人覺得很"}, {"type": "subtitle", "time": 5811.83, "timestamp": "01:36:51", "text": "享受？哦，呃，就是那種科學"}, {"type": "subtitle", "time": 5816.95, "timestamp": "01:36:56", "text": "意義上的時間旅行，或者像那種"}]
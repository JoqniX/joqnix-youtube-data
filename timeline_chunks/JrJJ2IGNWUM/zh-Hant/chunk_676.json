[{"type": "subtitle", "time": 40564.07, "timestamp": "11:16:04", "text": "我這就找出所有"}, {"type": "subtitle", "time": 40572.63, "timestamp": "11:16:12", "text": "來過並鎖門的人。我覺得DA當時也在聊天群組。  然後祖寇的兒子也在場，維克塔桑也在場。阿基亞比當時也在場"}, {"type": "subtitle", "time": 40596.106, "timestamp": "11:16:36", "text": "今天來了。然後，奎克森也在那裡。羅伯特傑克森當時也在場。  羅伯特，然後我們有了 YP 流，Y 流來阻止和在那裡"}, {"type": "subtitle", "time": 40599.51, "timestamp": "11:16:39", "text": "。聊天。"}, {"type": "subtitle", "time": 40602.19, "timestamp": "11:16:42", "text": "你好。就這樣，包括凱登在內，所有人都會待到最後。感謝你們一直陪伴我到最後，也感謝STA"}]
[{"type": "subtitle", "time": 5820.629, "timestamp": "01:37:00", "text": "理論太多、心理學意義上的時間旅行。  是"}, {"type": "subtitle", "time": 5823.59, "timestamp": "01:37:03", "text": "啊，理論太多了。是的。我從來"}, {"type": "subtitle", "time": 5824.95, "timestamp": "01:37:04", "text": "沒看過像《"}, {"type": "subtitle", "time": 5826.87, "timestamp": "01:37:06", "text": "全面啟動》之類的電影，我從來沒"}, {"type": "subtitle", "time": 5829.95, "timestamp": "01:37:09", "text": "看過。我只知道，我覺得就像"}, {"type": "subtitle", "time": 5840.55, "timestamp": "01:37:20", "text": "漫威電影《復仇者聯盟4：終局之戰》裡有個場景，好像就算"}, {"type": "subtitle", "time": 5843.51, "timestamp": "01:37:23", "text": "你殺了幼年滅霸，也不會"}, {"type": "subtitle", "time": 5845.189, "timestamp": "01:37:25", "text": "改變時間線，因為會"}, {"type": "subtitle", "time": 5847.95, "timestamp": "01:37:27", "text": "抵消掉之前的事件，創造出一個"}, {"type": "subtitle", "time": 5850.95, "timestamp": "01:37:30", "text": "沒有薩諾斯的現實。是啊，我明白這有多"}, {"type": "subtitle", "time": 5852.55, "timestamp": "01:37:32", "text": "煩人，因為它"}, {"type": "subtitle", "time": 5854.629, "timestamp": "01:37:34", "text": "反駁了所有其他理論，而"}, {"type": "subtitle", "time": 5856.95, "timestamp": "01:37:36", "text": "你必須堅持一種理論才能編出一個"}, {"type": "subtitle", "time": 5859.109, "timestamp": "01:37:39", "text": "連貫的故事。是的，我"}, {"type": "subtitle", "time": 5861.109, "timestamp": "01:37:41", "text": "明白為什麼人們會"}, {"type": "subtitle", "time": 5864.87, "timestamp": "01:37:44", "text": "覺得這很噁心，但我也不明白。"}, {"type": "subtitle", "time": 5866.79, "timestamp": "01:37:46", "text": "看到關於"}, {"type": "subtitle", "time": 5869.109, "timestamp": "01:37:49", "text": "時間旅行如何運作的新觀點似乎很有趣，"}, {"type": "subtitle", "time": 5871.51, "timestamp": "01:37:51", "text": "但如果你已經對"}, {"type": "subtitle", "time": 5873.669, "timestamp": "01:37:53", "text": "時間旅行如何運作以及"}, {"type": "subtitle", "time": 5875.83, "timestamp": "01:37:55", "text": "你希望它如何運作有了固定的想法。我覺得你"}, {"type": "subtitle", "time": 5878.07, "timestamp": "01:37:58", "text": "只是因為"}]
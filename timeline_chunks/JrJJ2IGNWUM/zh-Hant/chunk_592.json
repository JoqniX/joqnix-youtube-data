[{"type": "subtitle", "time": 35523.71, "timestamp": "09:52:03", "text": "請你現在"}, {"type": "subtitle", "time": 35536.83, "timestamp": "09:52:16", "text": "不要看我的"}, {"type": "subtitle", "time": 35541.11, "timestamp": "09:52:21", "text": "靈魂之流。等待。哦，是的。是的。是的。我會努力不死。沒有。守護者，你保存了嗎？  呃，哇。"}, {"type": "subtitle", "time": 35563.79, "timestamp": "09:52:43", "text": "我會殺了你。我寧願自殺也不見你。哦，等等。我沒有彈藥了。  哦，你確實殺死了"}]
[{"type": "subtitle", "time": 9012.59, "timestamp": "02:30:12", "text": "拍影片。  嗯"}, {"type": "subtitle", "time": 9015.83, "timestamp": "02:30:15", "text": "。至少這樣會有幫助，對吧"}, {"type": "subtitle", "time": 9018.07, "timestamp": "02:30:18", "text": "？至少這樣有幫助。  哦，那裡有人。  我失語了。我的"}, {"type": "subtitle", "time": 9047.71, "timestamp": "02:30:47", "text": "說話。"}, {"type": "subtitle", "time": 9053.309, "timestamp": "02:30:53", "text": "我不……我害怕。"}, {"type": "subtitle", "time": 9056.51, "timestamp": "02:30:56", "text": "哦，我當時真想殺了他"}]
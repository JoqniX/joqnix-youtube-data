[{"type": "subtitle", "time": 6360.55, "timestamp": "01:46:00", "text": "形容FNAF電影。對我來說，這感覺可謂是"}, {"type": "subtitle", "time": 6367.91, "timestamp": "01:46:07", "text": "喜憂參半。"}, {"type": "subtitle", "time": 6371.669, "timestamp": "01:46:11", "text": "但我努力想討厭傑克"}, {"type": "subtitle", "time": 6378.87, "timestamp": "01:46:18", "text": "布萊克這個人，對吧？我並不是因為傑克·布萊克是傑克·布萊克就討厭他。我討厭他，是因為他演繹了我心愛的史蒂夫這個角色，對吧？但後來我意識到傑克布萊克"}, {"type": "subtitle", "time": 6384.229, "timestamp": "01:46:24", "text": "扮演史蒂夫其實還"}, {"type": "subtitle", "time": 6386.07, "timestamp": "01:46:26", "text": "不錯，因為他展現了"}, {"type": "subtitle", "time": 6400.31, "timestamp": "01:46:40", "text": "史蒂夫在那個世界裡所擁有的樂趣和精湛技藝，我覺得這超級有趣。他把這個角色演繹得與眾不同，這完全出乎我的意料。它顛覆了我的預期，傑克布萊克對角色的詮釋確實很有深度，"}, {"type": "subtitle", "time": 6408.55, "timestamp": "01:46:48", "text": "我很喜歡。真的很好"}, {"type": "subtitle", "time": 6412.07, "timestamp": "01:46:52", "text": "。"}, {"type": "subtitle", "time": 6413.59, "timestamp": "01:46:53", "text": "人物塑造真的非常優秀。"}]
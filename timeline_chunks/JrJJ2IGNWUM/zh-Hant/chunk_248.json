[{"type": "subtitle", "time": 14891.429, "timestamp": "04:08:11", "text": "你六月什麼時候有空。"}, {"type": "subtitle", "time": 14899.75, "timestamp": "04:08:19", "text": "我們最多做1小時。最多一到兩個小時。我目前正在嘗試一天內完成多個合作項目。  例如一個人花一個小時，另一個人花另一個小時，以此類推。一小時，兩小時，就這樣。我們將暫停“你好”"}, {"type": "subtitle", "time": 14912.229, "timestamp": "04:08:32", "text": "啊，歡迎回來。"}, {"type": "subtitle", "time": 14937.59, "timestamp": "04:08:57", "text": "謝謝。  歡迎回來。  [音樂] [音樂] 耶。你吃晚餐了嗎"}]
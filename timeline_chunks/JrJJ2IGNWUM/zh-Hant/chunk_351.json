[{"type": "subtitle", "time": 21065.47, "timestamp": "05:51:05", "text": "新年快樂。 Honeyan也是如此。謝謝光臨"}, {"type": "subtitle", "time": 21108.39, "timestamp": "05:51:48", "text": "嗯，確保今年對你來說是美好的一年。努力工作，做到最好。我怎麼會忘記"}, {"type": "subtitle", "time": 21112.51, "timestamp": "05:51:52", "text": "這件事呢？阿尼桑，"}, {"type": "subtitle", "time": 21114.59, "timestamp": "05:51:54", "text": "謝謝你時隔許久再回來。"}, {"type": "subtitle", "time": 21118.868, "timestamp": "05:51:58", "text": "它又黏住了。  但別"}]
[{"type": "subtitle", "time": 15540.79, "timestamp": "04:19:00", "text": "伺服器出了問題，如果當時有上傳的文件，那就表示沒問題了，也許他們已經"}, {"type": "subtitle", "time": 15559.149, "timestamp": "04:19:19", "text": "記憶是個可怕的東西。"}, {"type": "subtitle", "time": 15566.67, "timestamp": "04:19:26", "text": "別擔心，我會是你最後記得的"}, {"type": "subtitle", "time": 15585.67, "timestamp": "04:19:45", "text": "老兄。  但他卻是英國人。  義大利語。義大利語。好的，我們應該在"}]
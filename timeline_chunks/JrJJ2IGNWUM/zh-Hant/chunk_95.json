[{"type": "subtitle", "time": 5703.51, "timestamp": "01:35:03", "text": "。  是的"}, {"type": "subtitle", "time": 5705.91, "timestamp": "01:35:05", "text": "，"}, {"type": "subtitle", "time": 5707.75, "timestamp": "01:35:07", "text": "我明白你的意思，兄弟。我明白你的意思了。"}, {"type": "subtitle", "time": 5711.75, "timestamp": "01:35:11", "text": "有時候，你就是想要那種被"}, {"type": "subtitle", "time": 5713.91, "timestamp": "01:35:13", "text": "扇子扇動的感覺。就算"}, {"type": "subtitle", "time": 5715.99, "timestamp": "01:35:15", "text": "角色是複製貼上過來"}, {"type": "subtitle", "time": 5719.51, "timestamp": "01:35:19", "text": "供自己代入也無所謂。"}, {"type": "subtitle", "time": 5722.95, "timestamp": "01:35:22", "text": "讀起來仍然很有趣。不過有些情節還不錯。"}, {"type": "subtitle", "time": 5725.27, "timestamp": "01:35:25", "text": "如果感覺不到它們，我就丟掉。我"}, {"type": "subtitle", "time": 5726.79, "timestamp": "01:35:26", "text": "仍然會讀一些情節平淡、毫無吸引力的低俗小說。"}, {"type": "subtitle", "time": 5733.189, "timestamp": "01:35:33", "text": "我並不是真的在尋找"}, {"type": "subtitle", "time": 5736.189, "timestamp": "01:35:36", "text": "那種我變成"}, {"type": "subtitle", "time": 5740.07, "timestamp": "01:35:40", "text": "異世界自動販賣機之類的東西。我"}, {"type": "subtitle", "time": 5742.43, "timestamp": "01:35:42", "text": "覺得那些東西很有趣，"}, {"type": "subtitle", "time": 5746.229, "timestamp": "01:35:46", "text": "看和讀都很有趣，但等等，不讀。"}, {"type": "subtitle", "time": 5747.669, "timestamp": "01:35:47", "text": "抱歉，我覺得目前"}, {"type": "subtitle", "time": 5749.91, "timestamp": "01:35:49", "text": "還沒有相關的動畫。有時候會說"}, {"type": "subtitle", "time": 5752.709, "timestamp": "01:35:52", "text": "我被英雄隊伍踢出去了，有時候又會說"}, {"type": "subtitle", "time": 5756.709, "timestamp": "01:35:56", "text": "我被英雄"}, {"type": "subtitle", "time": 5759.43, "timestamp": "01:35:59", "text": "隊伍禁止加入，好像都是同樣的"}]
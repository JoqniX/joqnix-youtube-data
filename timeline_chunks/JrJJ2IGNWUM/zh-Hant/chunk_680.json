[{"type": "subtitle", "time": 40800.03, "timestamp": "11:20:00", "text": "這是我第一次買雨衣。"}, {"type": "subtitle", "time": 40819.87, "timestamp": "11:20:19", "text": "下雨，但我感覺今天可能會下雨。"}, {"type": "subtitle", "time": 40843.426, "timestamp": "11:20:43", "text": "哎，下了一整天的雨。是的。你好。歡迎。希望我的聲音能被聽到，對吧？我希望我的聲音能被聽見。所以我在"}]
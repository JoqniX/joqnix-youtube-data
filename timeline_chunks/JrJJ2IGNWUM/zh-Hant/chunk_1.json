[{"type": "subtitle", "time": 67.75, "timestamp": "00:01:07", "text": "現在正被它召喚呢。這是"}, {"type": "subtitle", "time": 70.23, "timestamp": "00:01:10", "text": "喬基。"}, {"type": "subtitle", "time": 72.35, "timestamp": "00:01:12", "text": "我還記得那個騎師"}, {"type": "subtitle", "time": 76.429, "timestamp": "00:01:16", "text": "寶寶。你是誰？你是誰？我是"}, {"type": "subtitle", "time": 80.23, "timestamp": "00:01:20", "text": "喬。我是一顆星座。"}, {"type": "subtitle", "time": 84.03, "timestamp": "00:01:24", "text": "你好，壽司。你好嗎？已經過了"}, {"type": "subtitle", "time": 87.99, "timestamp": "00:01:27", "text": "很久了。你好嗎？我一直都在這裡，嗯，"}, {"type": "subtitle", "time": 90.789, "timestamp": "00:01:30", "text": "你在這裡已經有一段時間了。兄弟，我離開太久了。"}, {"type": "subtitle", "time": 95.91, "timestamp": "00:01:35", "text": "嗯。"}, {"type": "subtitle", "time": 97.99000000000001, "timestamp": "00:01:37", "text": "堅持，稍等。讓我把你們喜歡的那種彈跳的"}, {"type": "subtitle", "time": 101.59, "timestamp": "00:01:41", "text": "PNG圖片上傳到這裡。"}, {"type": "subtitle", "time": 104.31, "timestamp": "00:01:44", "text": "兄弟，我是在模仿你。我"}, {"type": "subtitle", "time": 107.19, "timestamp": "00:01:47", "text": "大概一天都沒睡好覺了。我在開玩笑。但"}, {"type": "subtitle", "time": 109.429, "timestamp": "00:01:49", "text": "你沒睡。"}, {"type": "subtitle", "time": 112.38900000000001, "timestamp": "00:01:52", "text": "我沒有。我最近忙於現實生活中的事"}, {"type": "chat", "time": 113.702, "timestamp": "00:01:53", "author": "@OtakuArceus", "avatar": "https://yt4.ggpht.com/VSZC0x7e02-tCAnte525GcpFOF0YcSpYQWplJkdg1RARvkQA3ETFxFaiYVshpLrqHFKUMz4VmA=s64-c-k-c0x00ffffff-no-rj", "message": "ello~"}, {"type": "subtitle", "time": 115.749, "timestamp": "00:01:55", "text": "。但我當時想，他們可能真的沒有"}, {"type": "subtitle", "time": 118.31, "timestamp": "00:01:58", "text": "時間休息，你知道，"}]
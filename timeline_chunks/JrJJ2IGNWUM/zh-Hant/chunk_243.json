[{"type": "subtitle", "time": 14581.67, "timestamp": "04:03:01", "text": "不。哦，在上面。  好，好，好，好，"}, {"type": "subtitle", "time": 14584.95, "timestamp": "04:03:04", "text": "好。幹掉他。下一個是誰？  不，這樣的比賽遠不止"}, {"type": "subtitle", "time": 14597.269, "timestamp": "04:03:17", "text": "一"}, {"type": "subtitle", "time": 14601.75, "timestamp": "04:03:21", "text": "分鐘之內。是的。是的，慢慢來。不用"}, {"type": "subtitle", "time": 14605.91, "timestamp": "04:03:25", "text": "擔心。  您可以"}, {"type": "subtitle", "time": 14609.31, "timestamp": "04:03:29", "text": "返回大廳。"}]
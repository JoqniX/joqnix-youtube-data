[{"type": "subtitle", "time": 27540.388, "timestamp": "07:39:00", "text": "把他屠殺了。等等，什麼？這是什麼"}, {"type": "subtitle", "time": 27544.07, "timestamp": "07:39:04", "text": "領域？哦，這個。等等。等等。等等。呃，有人"}, {"type": "subtitle", "time": 27558.788, "timestamp": "07:39:18", "text": "救贖了"}, {"type": "subtitle", "time": 27561.75, "timestamp": "07:39:21", "text": "驅魔師。好久不見了。好吧，讓我快速完成這個。嗨，別急。一，二，"}, {"type": "subtitle", "time": 27575.75, "timestamp": "07:39:35", "text": "我是說，實際上他用了四，五，五。他在五的時候死了。"}, {"type": "subtitle", "time": 27577.43, "timestamp": "07:39:37", "text": "謝謝你的救贖，愛德華。怎麼樣？現在我的身體感覺怪怪的，多虧了你。謝謝你讓我的身體感覺怪怪的。哦，天哪，那把弓威力真大。是啊，有點"}]
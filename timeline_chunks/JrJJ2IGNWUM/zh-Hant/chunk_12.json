[{"type": "subtitle", "time": 729.91, "timestamp": "00:12:09", "text": "呃，我不知道我在哪裡。如果我一直待在這個又熱又悶又亂的房間裡，我什麼都做不了。所以我就想，也許，也許，也許我該做點什麼，試著做點什麼，讓我的生活更有意義。是的。"}, {"type": "subtitle", "time": 731.75, "timestamp": "00:12:11", "text": "然後，這就像是一段很奇怪的"}, {"type": "subtitle", "time": 734.79, "timestamp": "00:12:14", "text": "旅程，從意識到你是你自己，"}, {"type": "subtitle", "time": 736.47, "timestamp": "00:12:16", "text": "因為當你處於那個階段時，"}, {"type": "subtitle", "time": 738.47, "timestamp": "00:12:18", "text": "你會意識到這樣"}, {"type": "subtitle", "time": 741.03, "timestamp": "00:12:21", "text": "很好，對吧？還好。這就是"}, {"type": "subtitle", "time": 743.11, "timestamp": "00:12:23", "text": "我的生活方式，然後你會開始"}, {"type": "subtitle", "time": 745.19, "timestamp": "00:12:25", "text": "意識到，你可以做得更好，"}, {"type": "subtitle", "time": 747.75, "timestamp": "00:12:27", "text": "好上100%。  就像"}, {"type": "subtitle", "time": 749.99, "timestamp": "00:12:29", "text": "你到了那個階段一樣。是的。"}, {"type": "subtitle", "time": 751.269, "timestamp": "00:12:31", "text": "我他媽到底在扯些什麼"}, {"type": "subtitle", "time": 752.55, "timestamp": "00:12:32", "text": "？對不起。"}, {"type": "subtitle", "time": 754.069, "timestamp": "00:12:34", "text": "再次。"}, {"type": "subtitle", "time": 757.67, "timestamp": "00:12:37", "text": "不，不，我無法感同身受。我能"}, {"type": "subtitle", "time": 760.629, "timestamp": "00:12:40", "text": "理解你的感受，因為我也做過同樣的"}, {"type": "subtitle", "time": 763.03, "timestamp": "00:12:43", "text": "事情，我想大概是在CO開始之後，"}, {"type": "subtitle", "time": 767.03, "timestamp": "00:12:47", "text": "或者在我"}, {"type": "subtitle", "time": 769.67, "timestamp": "00:12:49", "text": "12年級之後吧。我不再去了。我當時對"}, {"type": "subtitle", "time": 772.55, "timestamp": "00:12:52", "text": "上"}, {"type": "subtitle", "time": 774.79, "timestamp": "00:12:54", "text": "大學或做任何事、"}, {"type": "subtitle", "time": 777.629, "timestamp": "00:12:57", "text": "追求任何目標都沒興趣。我確實嘗試過了，但是"}]
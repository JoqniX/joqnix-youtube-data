[{"type": "subtitle", "time": 17472.27, "timestamp": "04:51:12", "text": "。  還有一個人。我忘了。我的天哪，我把她忘了。呃，丹，時間是下午3點。它。我的天哪，我"}, {"type": "subtitle", "time": 17482.15, "timestamp": "04:51:22", "text": "竟然忘了大山。"}, {"type": "subtitle", "time": 17483.67, "timestamp": "04:51:23", "text": "我當時正在走那條路，"}, {"type": "subtitle", "time": 17488.23, "timestamp": "04:51:28", "text": "我看到了水壩，我正在聯繫人們"}, {"type": "subtitle", "time": 17490.47, "timestamp": "04:51:30", "text": "，嗯，我正在"}, {"type": "subtitle", "time": 17498.708, "timestamp": "04:51:38", "text": "聯繫人們。 [音樂]呃，聯絡人們，這樣我就可以…呃，聯絡到緊急救援人員，中午12點，好的，"}]
[{"type": "subtitle", "time": 29892.03, "timestamp": "08:18:12", "text": "很重的兒子。別殺我。我給他抹了奶油，然後我就死了。疼痛。  監護人。  等等，有冷卻時間嗎？實際上，呃，是在夜幕降臨的時候。是的，復活"}, {"type": "subtitle", "time": 29899.27, "timestamp": "08:18:19", "text": "啊。歡迎，歡迎"}, {"type": "subtitle", "time": 29902.708, "timestamp": "08:18:22", "text": "。你好嗎？你好嗎？  你好。  你好。你好嗎？"}]
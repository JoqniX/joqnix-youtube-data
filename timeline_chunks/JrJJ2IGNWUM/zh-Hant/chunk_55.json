[{"type": "subtitle", "time": 3304.069, "timestamp": "00:55:04", "text": "我那樣做了一整年左右。現在我喝紅茶的時候，我會覺得想睡。"}, {"type": "subtitle", "time": 3309.19, "timestamp": "00:55:09", "text": "它就像你的屁股，就像你的身體的鬧鐘，告訴你該睡覺了，喝了這個，然後睡覺。"}, {"type": "subtitle", "time": 3324.63, "timestamp": "00:55:24", "text": "呃，現在想吃奶油餅乾當尿布。說實話，我喜歡黃油餅乾，但我不一定會用它們"}, {"type": "subtitle", "time": 3327.069, "timestamp": "00:55:27", "text": "配茶吃。我就直接吃了。我直接就去吃漿果了。你吃過嗎？它看起來像果凍一樣。  嗯"}, {"type": "subtitle", "time": 3330.309, "timestamp": "00:55:30", "text": "，其實不算軟果凍。它上面好像有藍莓果凍，還有，呃，那叫"}, {"type": "subtitle", "time": 3332.95, "timestamp": "00:55:32", "text": "什麼來著"}, {"type": "subtitle", "time": 3334.79, "timestamp": "00:55:34", "text": "？就像中間夾著香草糖霜，"}, {"type": "subtitle", "time": 3337.51, "timestamp": "00:55:37", "text": "又像一塊"}, {"type": "subtitle", "time": 3339.43, "timestamp": "00:55:39", "text": "餅乾。是的，我喜歡。"}, {"type": "subtitle", "time": 3343.19, "timestamp": "00:55:43", "text": "我喜歡把它加到咖啡裡。"}, {"type": "subtitle", "time": 3347.03, "timestamp": "00:55:47", "text": "哦，聽起來真好吃。  確實如此。"}, {"type": "subtitle", "time": 3348.23, "timestamp": "00:55:48", "text": "我 我 我 吃 我 是這樣的，對吧？"}, {"type": "subtitle", "time": 3355.19, "timestamp": "00:55:55", "text": "我和家人會一起分享一些食物。我爸買了大概兩包。他一個都沒吃，因為我一直在狂吃"}]
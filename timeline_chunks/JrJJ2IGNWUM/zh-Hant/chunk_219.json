[{"type": "subtitle", "time": 13164.03, "timestamp": "03:39:24", "text": "創作《我的天哪》。"}, {"type": "subtitle", "time": 13169.03, "timestamp": "03:39:29", "text": "45秒。 Shay會說我需要…"}, {"type": "subtitle", "time": 13182.11, "timestamp": "03:39:42", "text": "呃，最近的工作台在哪裡？能標記一下嗎？我們過去吧。我好"}, {"type": "subtitle", "time": 13196.79, "timestamp": "03:39:56", "text": "行政。我覺得我可以去。"}]
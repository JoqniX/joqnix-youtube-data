[{"type": "subtitle", "time": 42087.266, "timestamp": "11:41:27", "text": "尷尬了。是啊，在哪裡？等等，我沒……哦，天哪，我沒……我的頭。耳機。"}, {"type": "subtitle", "time": 42089.79, "timestamp": "11:41:29", "text": "我的天哪。沒關係。  沒關係。我買了一雙新的。我拿了"}, {"type": "subtitle", "time": 42093.266, "timestamp": "11:41:33", "text": "這雙新鞋。我忘了帶耳機。呃，就是那個容器，對吧？無線"}, {"type": "subtitle", "time": 42096.426, "timestamp": "11:41:36", "text": "耳機。哦，"}]
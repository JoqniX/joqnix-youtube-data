[{"type": "subtitle", "time": 120.63, "timestamp": "00:02:00", "text": "我最多也"}, {"type": "subtitle", "time": 123.83, "timestamp": "00:02:03", "text": "睡了兩個小時的午覺。"}, {"type": "subtitle", "time": 126.63, "timestamp": "00:02:06", "text": "不，我現在完全是靠著一股勁兒，"}, {"type": "subtitle", "time": 130.15, "timestamp": "00:02:10", "text": "可能還喝了點咖啡。我的天啊。"}, {"type": "subtitle", "time": 132.39, "timestamp": "00:02:12", "text": "但沒關係。我們在玩遊戲。我們很好。我們"}, {"type": "subtitle", "time": 135.51, "timestamp": "00:02:15", "text": "很好。等待。呃，你們"}, {"type": "subtitle", "time": 141.99, "timestamp": "00:02:21", "text": "那邊現在幾點？呃，晚上11點11分。晚上11點等待。所以，"}, {"type": "subtitle", "time": 145.99, "timestamp": "00:02:25", "text": "就像…等等，現在對"}, {"type": "subtitle", "time": 149.11, "timestamp": "00:02:29", "text": "我來說是 8:30 了。所以，晚上11點。哦，中部標準時間。只需"}, {"type": "subtitle", "time": 152.15, "timestamp": "00:02:32", "text": "幾個小時。是的。哦，好的。好的。中部標準"}, {"type": "subtitle", "time": 154.63, "timestamp": "00:02:34", "text": "時間。好的。我是中部標準時間（CST）還是太平洋標準時間（PS）？我已經"}, {"type": "subtitle", "time": 156.55, "timestamp": "00:02:36", "text": "記不清自己用的是哪個時區了，"}, {"type": "subtitle", "time": 161.82999999999998, "timestamp": "00:02:41", "text": "因為我一直"}, {"type": "subtitle", "time": 171.589, "timestamp": "00:02:51", "text": "迷失了。  你看，我根本就沒心思再玩這該死的遊戲了。  我快崩潰了。 M，"}]
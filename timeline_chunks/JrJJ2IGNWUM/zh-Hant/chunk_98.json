[{"type": "subtitle", "time": 5881.35, "timestamp": "01:38:01", "text": "覺得自己的理論和想法比較好，所以才對其他理論和想法"}, {"type": "subtitle", "time": 5885.109, "timestamp": "01:38:05", "text": "不屑一顧，你知道嗎？"}, {"type": "subtitle", "time": 5886.87, "timestamp": "01:38:06", "text": "是的。你具體指的是什麼"}, {"type": "subtitle", "time": 5888.149, "timestamp": "01:38:08", "text": "？你有沒有"}, {"type": "subtitle", "time": 5896.43, "timestamp": "01:38:16", "text": "呃，我的天，"}, {"type": "subtitle", "time": 5900.189, "timestamp": "01:38:20", "text": "那部動畫叫什麼名字來著"}, {"type": "subtitle", "time": 5902.03, "timestamp": "01:38:22", "text": "？"}, {"type": "subtitle", "time": 5905.83, "timestamp": "01:38:25", "text": "呃，忘了名字了。"}, {"type": "subtitle", "time": 5909.109, "timestamp": "01:38:29", "text": "我不記得有什麼穿越時空的動畫。"}, {"type": "subtitle", "time": 5910.629, "timestamp": "01:38:30", "text": "我看過一些"}, {"type": "subtitle", "time": 5912.149, "timestamp": "01:38:32", "text": "關於重生和"}, {"type": "subtitle", "time": 5914.99, "timestamp": "01:38:34", "text": "復仇的中國電視劇片段，挺喜歡的，"}, {"type": "subtitle", "time": 5917.83, "timestamp": "01:38:37", "text": "啊，我以前從來沒看過這種類型的"}, {"type": "subtitle", "time": 5919.83, "timestamp": "01:38:39", "text": "中國電視劇。對了，你還"}, {"type": "subtitle", "time": 5923.51, "timestamp": "01:38:43", "text": "記得那部同名劇嗎？哦，《命運石之"}, {"type": "subtitle", "time": 5938.39, "timestamp": "01:38:58", "text": "門》？"}]
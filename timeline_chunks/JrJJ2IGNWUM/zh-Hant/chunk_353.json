[{"type": "subtitle", "time": 21184.03, "timestamp": "05:53:04", "text": "這對我意義重大。也感謝你的關注"}, {"type": "subtitle", "time": 21193.91, "timestamp": "05:53:13", "text": "。這對我意義重大。  謝謝。"}, {"type": "subtitle", "time": 21195.91, "timestamp": "05:53:15", "text": "嗯，謝謝。"}, {"type": "subtitle", "time": 21198.868, "timestamp": "05:53:18", "text": "謝謝。呃，我們一刻也不等。為什麼？耽誤。它又卡住了。不，"}, {"type": "subtitle", "time": 21208.07, "timestamp": "05:53:28", "text": "它又卡住了。為什麼我記得我還在這裡？哦，等等。  它回來了。好的。你好。你好。嗯，Flexie TTV，也謝謝你的"}, {"type": "subtitle", "time": 21211.99, "timestamp": "05:53:31", "text": "關注。謝謝光臨。歡迎來到星座，就像你遇到幀率下降問題一樣。歡迎來到康奈拉。希望您入住"}, {"type": "subtitle", "time": 21217.39, "timestamp": "05:53:37", "text": "愉快。謝謝光臨。然後是科學，謝謝"}, {"type": "subtitle", "time": 21225.628, "timestamp": "05:53:45", "text": "各位的光臨。  希望你今天過得"}, {"type": "subtitle", "time": 21228.548, "timestamp": "05:53:48", "text": "愉快。謝謝光臨。新年快樂，也"}, {"type": "subtitle", "time": 21233.628, "timestamp": "05:53:53", "text": "祝羅布新年快樂。祝您新的一年繁榮昌盛。然後烏布安來了。感謝您今天光臨。謝謝。謝謝。希望你……等等，我查看了私訊。我們待了幾分鐘"}]
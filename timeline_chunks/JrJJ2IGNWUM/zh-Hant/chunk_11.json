[{"type": "subtitle", "time": 660.47, "timestamp": "00:11:00", "text": "主要像一個"}, {"type": "subtitle", "time": 662.79, "timestamp": "00:11:02", "text": "英語專業的英語老師。但是，是的，我當時"}, {"type": "subtitle", "time": 665.269, "timestamp": "00:11:05", "text": "在船上，感覺自己"}, {"type": "subtitle", "time": 667.67, "timestamp": "00:11:07", "text": "超級棒，我為此感到自豪。我甚至不"}, {"type": "subtitle", "time": 669.269, "timestamp": "00:11:09", "text": "知道我當時為什麼會為那些事感到自豪。"}, {"type": "subtitle", "time": 672.31, "timestamp": "00:11:12", "text": "就像我朋友一樣，我什麼都沒做。  感覺就像"}, {"type": "subtitle", "time": 676.63, "timestamp": "00:11:16", "text": "我幾乎沒洗澡一樣。我的天啊。"}, {"type": "subtitle", "time": 678.87, "timestamp": "00:11:18", "text": "好像情況真的那麼糟似的。我今天一整天都在做一件事，就是"}, {"type": "subtitle", "time": 682.069, "timestamp": "00:11:22", "text": "起床"}, {"type": "subtitle", "time": 684.47, "timestamp": "00:11:24", "text": "，把手機從充電槽裡拿出來"}, {"type": "subtitle", "time": 686.23, "timestamp": "00:11:26", "text": "充上幾個小時電，然後"}, {"type": "subtitle", "time": 688.79, "timestamp": "00:11:28", "text": "玩《托蘭傳說》。你聽過《托蘭"}, {"type": "subtitle", "time": 692.63, "timestamp": "00:11:32", "text": "傳說》嗎？是的。是的。我玩到大概"}, {"type": "subtitle", "time": 694.71, "timestamp": "00:11:34", "text": "一歲，我記得當時的階級"}, {"type": "subtitle", "time": 697.91, "timestamp": "00:11:37", "text": "上限是150級。那之後我就徹底"}, {"type": "subtitle", "time": 699.99, "timestamp": "00:11:39", "text": "不玩遊戲了，"}, {"type": "subtitle", "time": 702.79, "timestamp": "00:11:42", "text": "開始做 YouTube 視頻，因為之後我們搬到了"}, {"type": "subtitle", "time": 707.59, "timestamp": "00:11:47", "text": "菲律賓的市中心。所以事情就是這樣，我不得不意識到，"}, {"type": "subtitle", "time": 712.389, "timestamp": "00:11:52", "text": "我在這裡好像沒有任何朋友"}, {"type": "subtitle", "time": 715.509, "timestamp": "00:11:55", "text": "。"}]
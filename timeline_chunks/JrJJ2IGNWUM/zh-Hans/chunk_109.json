[{"type": "subtitle", "time": 6541.669, "timestamp": "01:49:01", "text": "暂停营业至七月。哦，他们确实是。什么？"}, {"type": "subtitle", "time": 6544.31, "timestamp": "01:49:04", "text": "蓝精灵。他状态很差。是啊，没错。他是"}, {"type": "subtitle", "time": 6546.149, "timestamp": "01:49:06", "text": "情况很糟糕。他准备吐露他的舌头"}, {"type": "subtitle", "time": 6549.91, "timestamp": "01:49:09", "text": "蓝色代表蓝精灵。还不错。等待，"}, {"type": "subtitle", "time": 6551.59, "timestamp": "01:49:11", "text": "等等，听我说完。还有一个。"}, {"type": "subtitle", "time": 6553.03, "timestamp": "01:49:13", "text": "他说，这里还有另一个。这里是"}, {"type": "subtitle", "time": 6555.55, "timestamp": "01:49:15", "text": "他说，还有一个。你知道，那个"}, {"type": "subtitle", "time": 6558.55, "timestamp": "01:49:18", "text": "来自《艾尔文和……》的雌性花栗鼠"}, {"type": "subtitle", "time": 6561.75, "timestamp": "01:49:21", "text": "花栗鼠。是的。她准备好了。他准备好了。"}, {"type": "subtitle", "time": 6564.87, "timestamp": "01:49:24", "text": "像主目标那样粉碎，主要目标"}, {"type": "subtitle", "time": 6573.27, "timestamp": "01:49:33", "text": "是的。嘿嘿嘿，他很讨厌毛茸茸的"}, {"type": "subtitle", "time": 6574.99, "timestamp": "01:49:34", "text": "人物。我不能责怪他。"}, {"type": "subtitle", "time": 6577.35, "timestamp": "01:49:37", "text": "说实话，我不明白。我不是"}, {"type": "subtitle", "time": 6580.87, "timestamp": "01:49:40", "text": "虽然他是个毛茸茸爱好者，但我会听他解释的。患病的"}, {"type": "subtitle", "time": 6588.629, "timestamp": "01:49:48", "text": "你想知道他说了什么吗？你想"}, {"type": "subtitle", "time": 6591.03, "timestamp": "01:49:51", "text": "想知道他说了什么？他们已经拥有"}, {"type": "subtitle", "time": 6599.43, "timestamp": "01:49:59", "text": "老兄，他们已经有了阴道"}]
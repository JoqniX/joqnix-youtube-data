[{"type": "subtitle", "time": 2580.63, "timestamp": "00:43:00", "text": "我以前也这样做过。我怀念做那件事。"}, {"type": "subtitle", "time": 2582.309, "timestamp": "00:43:02", "text": "是的。这就像是另一种体验"}, {"type": "subtitle", "time": 2584.069, "timestamp": "00:43:04", "text": "就像看视频片段一样。当然，它给你"}, {"type": "subtitle", "time": 2585.43, "timestamp": "00:43:05", "text": "所有美好的瞬间，你都错过了。"}, {"type": "subtitle", "time": 2589.91, "timestamp": "00:43:09", "text": "就像传说故事里那样，你知道吗？点赞"}, {"type": "subtitle", "time": 2591.99, "timestamp": "00:43:11", "text": "如果你看过我的一些视频，你"}, {"type": "subtitle", "time": 2596.069, "timestamp": "00:43:16", "text": "意识到这就像，哦，一个怪人，一个怪人"}, {"type": "subtitle", "time": 2598.95, "timestamp": "00:43:18", "text": "呃，又吵又蠢。嗯，就像当你"}, {"type": "subtitle", "time": 2601.67, "timestamp": "00:43:21", "text": "就像观看比赛一样，就像谁"}, {"type": "subtitle", "time": 2603.03, "timestamp": "00:43:23", "text": "他他到底是谁？我他妈也不知道发生了什么"}, {"type": "subtitle", "time": 2606.069, "timestamp": "00:43:26", "text": "他不再做了。就像……"}, {"type": "subtitle", "time": 2607.75, "timestamp": "00:43:27", "text": "你知道，就是那种事。或许他"}, {"type": "subtitle", "time": 2609.349, "timestamp": "00:43:29", "text": "可以打F，也可以不打。但是就像"}, {"type": "subtitle", "time": 2610.87, "timestamp": "00:43:30", "text": "当你观看这些片段时，你会觉得……"}, {"type": "subtitle", "time": 2612.95, "timestamp": "00:43:32", "text": "这是我对他的看法。"}, {"type": "subtitle", "time": 2614.55, "timestamp": "00:43:34", "text": "根据视频片段判断。我明白"}, {"type": "subtitle", "time": 2616.069, "timestamp": "00:43:36", "text": "人们这样做，但这其实并不是一种"}, {"type": "subtitle", "time": 2619.19, "timestamp": "00:43:39", "text": "坏事。就像它一样，嗯，它对你有帮助。"}, {"type": "subtitle", "time": 2621.03, "timestamp": "00:43:41", "text": "熟悉某种事物"}, {"type": "subtitle", "time": 2622.95, "timestamp": "00:43:42", "text": "角色或者像一个 YouTuber 和他们的"}, {"type": "subtitle", "time": 2624.63, "timestamp": "00:43:44", "text": "就像性格类型一样，但又像"}, {"type": "subtitle", "time": 2626.309, "timestamp": "00:43:46", "text": "有时候它并不能讲述全部故事。"}, {"type": "subtitle", "time": 2629.75, "timestamp": "00:43:49", "text": "就像那个人是什么样的人，或者像什么"}, {"type": "subtitle", "time": 2631.27, "timestamp": "00:43:51", "text": "它们代表着什么？"}, {"type": "subtitle", "time": 2633.43, "timestamp": "00:43:53", "text": "流媒体之类的。说到这里，我"}, {"type": "subtitle", "time": 2637.589, "timestamp": "00:43:57", "text": "我喜欢Ena，因为她的声音听起来很性感。"}]
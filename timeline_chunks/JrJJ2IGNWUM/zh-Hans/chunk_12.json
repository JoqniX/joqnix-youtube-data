[{"type": "subtitle", "time": 722.31, "timestamp": "00:12:02", "text": "我所在的这个房间又热又傻，真是太……"}, {"type": "subtitle", "time": 725.75, "timestamp": "00:12:05", "text": "湿。所以我就想，也许也许也许"}, {"type": "subtitle", "time": 727.67, "timestamp": "00:12:07", "text": "拿起某样东西，试着去做。"}, {"type": "subtitle", "time": 729.91, "timestamp": "00:12:09", "text": "你知道，我生活中发生了一些事。是的。"}, {"type": "subtitle", "time": 731.75, "timestamp": "00:12:11", "text": "然后，这就像是……"}, {"type": "subtitle", "time": 734.79, "timestamp": "00:12:14", "text": "从意识到自己是这样的旅程"}, {"type": "subtitle", "time": 736.47, "timestamp": "00:12:16", "text": "你当时也是这样"}, {"type": "subtitle", "time": 738.47, "timestamp": "00:12:18", "text": "没错，你意识到了这一点。"}, {"type": "subtitle", "time": 741.03, "timestamp": "00:12:21", "text": "没问题吧？还好。这是"}, {"type": "subtitle", "time": 743.11, "timestamp": "00:12:23", "text": "我的生活方式，然后你就开始了"}, {"type": "subtitle", "time": 745.19, "timestamp": "00:12:25", "text": "意识到自己可以做得更好"}, {"type": "subtitle", "time": 747.75, "timestamp": "00:12:27", "text": "提升了100%。"}, {"type": "subtitle", "time": 749.99, "timestamp": "00:12:29", "text": "就像你到了那个阶段一样。是的。"}, {"type": "subtitle", "time": 751.269, "timestamp": "00:12:31", "text": "我他妈到底在扯什么？"}, {"type": "subtitle", "time": 752.55, "timestamp": "00:12:32", "text": "在？对不起。"}, {"type": "subtitle", "time": 754.069, "timestamp": "00:12:34", "text": "再次。"}, {"type": "subtitle", "time": 757.67, "timestamp": "00:12:37", "text": "不，不，我无法感同身受。我可以"}, {"type": "subtitle", "time": 760.629, "timestamp": "00:12:40", "text": "感同身受，因为我也做过同样的事。"}, {"type": "subtitle", "time": 763.03, "timestamp": "00:12:43", "text": "我觉得在CO开始之后的事情"}, {"type": "subtitle", "time": 767.03, "timestamp": "00:12:47", "text": "或者在我……之后，就像……之后"}, {"type": "subtitle", "time": 769.67, "timestamp": "00:12:49", "text": "12年级之类的。我不再去了。我"}, {"type": "subtitle", "time": 772.55, "timestamp": "00:12:52", "text": "好像对去那里没什么兴趣。"}, {"type": "subtitle", "time": 774.79, "timestamp": "00:12:54", "text": "上大学或者做任何事"}, {"type": "subtitle", "time": 777.629, "timestamp": "00:12:57", "text": "追求任何事。我试过了，但是一直"}]
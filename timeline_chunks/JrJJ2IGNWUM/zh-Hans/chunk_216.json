[{"type": "subtitle", "time": 12962.469, "timestamp": "03:36:02", "text": "嗯，是的，已经……"}, {"type": "subtitle", "time": 12967.429, "timestamp": "03:36:07", "text": "尽管。所以我也不确定。"}, {"type": "subtitle", "time": 12970.7, "timestamp": "03:36:10", "text": "它显示“无法连接”的错误信息。哦"}, {"type": "subtitle", "time": 12980.51, "timestamp": "03:36:20", "text": "典型的猿猴"}, {"type": "subtitle", "time": 13002.269, "timestamp": "03:36:42", "text": "他们。我觉得它们就像钱一样。"}, {"type": "subtitle", "time": 13008.75, "timestamp": "03:36:48", "text": "某种程度上，我饿了。他们其实很喜欢"}, {"type": "subtitle", "time": 13017.469, "timestamp": "03:36:57", "text": "无偿付出了很多。就像他们给予的"}, {"type": "subtitle", "time": 13019.469, "timestamp": "03:36:59", "text": "80"}]
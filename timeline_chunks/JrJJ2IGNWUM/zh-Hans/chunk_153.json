[{"type": "subtitle", "time": 9187.95, "timestamp": "02:33:07", "text": "[音乐]"}, {"type": "subtitle", "time": 9194.67, "timestamp": "02:33:14", "text": "片刻。哦"}, {"type": "subtitle", "time": 9197.91, "timestamp": "02:33:17", "text": "男生。如果我听起来很……请不要介意"}, {"type": "subtitle", "time": 9201.75, "timestamp": "02:33:21", "text": "我现在内心一片死寂，因为我就是这样。"}, {"type": "subtitle", "time": 9203.12, "timestamp": "02:33:23", "text": "现在就在里面。"}, {"type": "subtitle", "time": 9204.75, "timestamp": "02:33:24", "text": "[音乐]"}, {"type": "subtitle", "time": 9207.63, "timestamp": "02:33:27", "text": "是的。"}, {"type": "subtitle", "time": 9212.349, "timestamp": "02:33:32", "text": "呃，我甚至忘了发推特。"}, {"type": "subtitle", "time": 9219.23, "timestamp": "02:33:39", "text": "[音乐]"}, {"type": "subtitle", "time": 9222.11, "timestamp": "02:33:42", "text": "呃，这位神。一"}, {"type": "subtitle", "time": 9226.67, "timestamp": "02:33:46", "text": "第二。我怎么忘了发推文了？"}, {"type": "subtitle", "time": 9227.79, "timestamp": "02:33:47", "text": "它？"}]
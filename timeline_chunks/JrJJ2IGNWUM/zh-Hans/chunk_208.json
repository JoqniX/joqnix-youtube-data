[{"type": "subtitle", "time": 12489.67, "timestamp": "03:28:09", "text": "他有两个人"}, {"type": "subtitle", "time": 12491.229, "timestamp": "03:28:11", "text": "有两个"}, {"type": "subtitle", "time": 12493.95, "timestamp": "03:28:13", "text": "他周围都是人。"}, {"type": "subtitle", "time": 12497.99, "timestamp": "03:28:17", "text": "不用，直接跳。"}, {"type": "subtitle", "time": 12521.51, "timestamp": "03:28:41", "text": "哦，不。哦，不。不，不，不，不，不，不，哦"}, {"type": "subtitle", "time": 12524.55, "timestamp": "03:28:44", "text": "我的上帝。我的天啊。"}, {"type": "subtitle", "time": 12526.67, "timestamp": "03:28:46", "text": "你好吗？"}, {"type": "subtitle", "time": 12531.59, "timestamp": "03:28:51", "text": "你还活着吗？我不知道。"}, {"type": "subtitle", "time": 12533.429, "timestamp": "03:28:53", "text": "哟，复制器要来了"}]
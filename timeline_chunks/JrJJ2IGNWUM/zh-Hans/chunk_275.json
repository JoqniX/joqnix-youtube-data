[{"type": "subtitle", "time": 16500.31, "timestamp": "04:35:00", "text": "现在。哇，这么多新功能！"}, {"type": "subtitle", "time": 16502.551, "timestamp": "04:35:02", "text": "YouTube。"}, {"type": "subtitle", "time": 16504.83, "timestamp": "04:35:04", "text": "你可以剪辑你的 Twitch 直播片段。什么？"}, {"type": "subtitle", "time": 16507.59, "timestamp": "04:35:07", "text": "是的。为此，我不得不结束直播。"}, {"type": "subtitle", "time": 16515.029, "timestamp": "04:35:15", "text": "可剪辑。是的。总之，明天是……"}, {"type": "subtitle", "time": 16518.31, "timestamp": "04:35:18", "text": "星期五。明天下午2点直到6点"}, {"type": "subtitle", "time": 16521.83, "timestamp": "04:35:21", "text": "我们有面包。我们将拥有"}, {"type": "subtitle", "time": 16522.67, "timestamp": "04:35:22", "text": "面包"}, {"type": "subtitle", "time": 16525.269, "timestamp": "04:35:25", "text": "明天。面包会在那里。"}, {"type": "subtitle", "time": 16527.67, "timestamp": "04:35:27", "text": "明天因为我们会处于高位或"}, {"type": "subtitle", "time": 16530.709, "timestamp": "04:35:30", "text": "下周之后的事情。"}, {"type": "subtitle", "time": 16535.029, "timestamp": "04:35:35", "text": "星期。呃，所以他想来这里。我"}, {"type": "subtitle", "time": 16537.109, "timestamp": "04:35:37", "text": "我希望他能在这里，我们聊了聊。"}, {"type": "subtitle", "time": 16540.31, "timestamp": "04:35:40", "text": "六月出行前或之前，和大家一起出去玩玩"}, {"type": "subtitle", "time": 16542.949, "timestamp": "04:35:42", "text": "我喜欢去日本之类的地方。是的。然后"}, {"type": "subtitle", "time": 16545.029, "timestamp": "04:35:45", "text": "我们得到了吉信农山。与"}, {"type": "subtitle", "time": 16550.15, "timestamp": "04:35:50", "text": "晚上8点，Yoshin Nosan印度标准时间晚上。"}, {"type": "subtitle", "time": 16552.789, "timestamp": "04:35:52", "text": "所以上午的课程将由布雷特主持。"}, {"type": "subtitle", "time": 16556.349, "timestamp": "04:35:56", "text": "晚间课程将由 Yoshan 主持。"}]
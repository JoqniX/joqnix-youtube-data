[{"type": "subtitle", "time": 2940.87, "timestamp": "00:49:00", "text": "是的，我确定。当然。好吧。"}, {"type": "subtitle", "time": 2943.91, "timestamp": "00:49:03", "text": "美好的。是的，我不得不把它搬走。"}, {"type": "subtitle", "time": 2945.67, "timestamp": "00:49:05", "text": "一点。我还是会这么做。"}, {"type": "subtitle", "time": 2947.75, "timestamp": "00:49:07", "text": "事后，但我感觉自己不得不搬家。"}, {"type": "subtitle", "time": 2949.109, "timestamp": "00:49:09", "text": "稍微这样我们就可以，你知道，"}, {"type": "subtitle", "time": 2951.43, "timestamp": "00:49:11", "text": "尽情玩乐，放松心情，畅所欲言。但"}, {"type": "subtitle", "time": 2954.069, "timestamp": "00:49:14", "text": "是的。是的。你需要吗？"}, {"type": "subtitle", "time": 2956.549, "timestamp": "00:49:16", "text": "也包括睡眠？我们一直醒着"}, {"type": "subtitle", "time": 2959.99, "timestamp": "00:49:19", "text": "从早到晚，老兄。咖啡就是一切"}, {"type": "subtitle", "time": 2962.15, "timestamp": "00:49:22", "text": "我需要。我们现在有咖啡机了。"}, {"type": "subtitle", "time": 2966.47, "timestamp": "00:49:26", "text": "我非常喜欢用它。好的。你"}, {"type": "subtitle", "time": 2968.79, "timestamp": "00:49:28", "text": "好的。别恨我，对吧？不"}, {"type": "subtitle", "time": 2970.51, "timestamp": "00:49:30", "text": "大家别恨我，"}, {"type": "subtitle", "time": 2973.43, "timestamp": "00:49:33", "text": "你们用咖啡机吗？"}, {"type": "subtitle", "time": 2976.79, "timestamp": "00:49:36", "text": "没有过滤器吗？就像不是真的"}, {"type": "subtitle", "time": 2979.19, "timestamp": "00:49:39", "text": "纸质过滤器？"}, {"type": "subtitle", "time": 2980.95, "timestamp": "00:49:40", "text": "我不知道。我从没喝过咖啡。"}, {"type": "subtitle", "time": 2982.95, "timestamp": "00:49:42", "text": "是机器，所以我也不知道。哦真的吗？"}, {"type": "subtitle", "time": 2985.19, "timestamp": "00:49:45", "text": "你还没有？拉屎。就像有时候"}, {"type": "subtitle", "time": 2988.589, "timestamp": "00:49:48", "text": "就像不要打坏人一样。"}, {"type": "subtitle", "time": 2991.03, "timestamp": "00:49:51", "text": "不。那你的受众呢？什么"}, {"type": "subtitle", "time": 2993.109, "timestamp": "00:49:53", "text": "你们觉得呢？你们是吗？"}, {"type": "subtitle", "time": 2994.95, "timestamp": "00:49:54", "text": "使用咖啡机没问题"}, {"type": "subtitle", "time": 2996.87, "timestamp": "00:49:56", "text": "就像金属过滤器一样，而且没有"}, {"type": "subtitle", "time": 2998.549, "timestamp": "00:49:58", "text": "比如还没拥有过一辆？哦，你"}]
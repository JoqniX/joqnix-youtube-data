[{"type": "subtitle", "time": 17220.27, "timestamp": "04:47:00", "text": "嗯，等等"}, {"type": "subtitle", "time": 17224.948, "timestamp": "04:47:04", "text": "向上。呃，现在是2025年6月1日凌晨2点30分。"}, {"type": "subtitle", "time": 17228.47, "timestamp": "04:47:08", "text": "星期天就到这里了。哦，星期六。我有"}, {"type": "subtitle", "time": 17231.83, "timestamp": "04:47:11", "text": "不要出去。我的天啊。星期六是"}, {"type": "subtitle", "time": 17233.15, "timestamp": "04:47:13", "text": "三人合作"}, {"type": "subtitle", "time": 17235.51, "timestamp": "04:47:15", "text": "天。我的天啊。没关系。没关系。"}, {"type": "subtitle", "time": 17237.31, "timestamp": "04:47:17", "text": "没关系。它是"}, {"type": "subtitle", "time": 17240.708, "timestamp": "04:47:20", "text": "美好的。该死。"}, {"type": "subtitle", "time": 17244.36, "timestamp": "04:47:24", "text": "呃，这个节目在2点30分播出。"}, {"type": "subtitle", "time": 17245.47, "timestamp": "04:47:25", "text": "[音乐]"}, {"type": "subtitle", "time": 17248.31, "timestamp": "04:47:28", "text": "上午。周六的合作项目很糟糕。最后的"}, {"type": "subtitle", "time": 17249.47, "timestamp": "04:47:29", "text": "星期六是"}, {"type": "subtitle", "time": 17252.91, "timestamp": "04:47:32", "text": "我也喜欢那样。哦，但是是"}, {"type": "subtitle", "time": 17255.83, "timestamp": "04:47:35", "text": "好的。我得到了它。哦，等等。不，等等。抓住"}, {"type": "subtitle", "time": 17258.99, "timestamp": "04:47:38", "text": "向上。等一下。她没有证实"}, {"type": "subtitle", "time": 17260.99, "timestamp": "04:47:40", "text": "然而。哦，"}, {"type": "subtitle", "time": 17264.628, "timestamp": "04:47:44", "text": "等待。哦，等等。我的天啊。等待。"}, {"type": "subtitle", "time": 17266.59, "timestamp": "04:47:46", "text": "如果星期六"}, {"type": "subtitle", "time": 17271.19, "timestamp": "04:47:51", "text": "变成四五个合作项目？哦，等等。"}, {"type": "subtitle", "time": 17274.19, "timestamp": "04:47:54", "text": "太平洋标准时间 (PST) 有人。"}, {"type": "subtitle", "time": 17278.47, "timestamp": "04:47:58", "text": "呃，时区。哦，那大概是10点11点。"}]
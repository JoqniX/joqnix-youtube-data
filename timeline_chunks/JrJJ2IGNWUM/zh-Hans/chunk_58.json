[{"type": "subtitle", "time": 3480.549, "timestamp": "00:58:00", "text": "是的。本，你的水平如何？"}, {"type": "subtitle", "time": 3483.67, "timestamp": "00:58:03", "text": "香料？呃，骑师。你的水平如何？"}, {"type": "subtitle", "time": 3486.71, "timestamp": "00:58:06", "text": "现在需要香料吗？是的。嗯，我喜欢吃辣的。"}, {"type": "subtitle", "time": 3490.39, "timestamp": "00:58:10", "text": "食物。我愿意。我小时候的事了。"}, {"type": "subtitle", "time": 3492.63, "timestamp": "00:58:12", "text": "我以前经常吃辣椒之类的东西，因为我"}, {"type": "subtitle", "time": 3496.15, "timestamp": "00:58:16", "text": "我当时很无聊，就经常喝热水。"}, {"type": "subtitle", "time": 3500.15, "timestamp": "00:58:20", "text": "这样就完全进入愤怒模式了，对吧？"}, {"type": "subtitle", "time": 3502.47, "timestamp": "00:58:22", "text": "是的。是的。激怒对方。是的。是的。"}, {"type": "subtitle", "time": 3505.43, "timestamp": "00:58:25", "text": "是的。是的。我觉得自己正在变成"}, {"type": "subtitle", "time": 3508.63, "timestamp": "00:58:28", "text": "绿巨人之类的。"}, {"type": "subtitle", "time": 3511.03, "timestamp": "00:58:31", "text": "你当时真的生气了。你"}, {"type": "subtitle", "time": 3513.75, "timestamp": "00:58:33", "text": "当时正在燃烧。而不是走绿色环保路线，"}, {"type": "subtitle", "time": 3520.39, "timestamp": "00:58:40", "text": "普通的充气面条会造成伤害"}, {"type": "subtitle", "time": 3525.75, "timestamp": "00:58:45", "text": "我。不会。很好。很好。"}, {"type": "subtitle", "time": 3528.87, "timestamp": "00:58:48", "text": "你只需要忽略味道就好"}, {"type": "subtitle", "time": 3531.51, "timestamp": "00:58:51", "text": "很辣吧？因为真正的味道"}, {"type": "subtitle", "time": 3535.19, "timestamp": "00:58:55", "text": "卡邦尼意面的口感超级棒"}, {"type": "subtitle", "time": 3538.15, "timestamp": "00:58:58", "text": "真他妈好。什么意大利面？"}]
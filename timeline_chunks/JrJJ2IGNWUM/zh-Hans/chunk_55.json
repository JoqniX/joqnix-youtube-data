[{"type": "subtitle", "time": 3304.069, "timestamp": "00:55:04", "text": "茶。我就直接吃了。我这就继续。"}, {"type": "subtitle", "time": 3306.87, "timestamp": "00:55:06", "text": "还有，呃，小浆果。你有没有过？你有没有过"}, {"type": "subtitle", "time": 3309.19, "timestamp": "00:55:09", "text": "那？它看起来像果冻一样。"}, {"type": "subtitle", "time": 3311.19, "timestamp": "00:55:11", "text": "嗯，其实不算软果冻。就像"}, {"type": "subtitle", "time": 3313.91, "timestamp": "00:55:13", "text": "上面好像有一层蓝莓果冻。"}, {"type": "subtitle", "time": 3318.589, "timestamp": "00:55:18", "text": "呃，它叫什么来着？喜欢"}, {"type": "subtitle", "time": 3321.99, "timestamp": "00:55:21", "text": "中间是香草糖霜，而且……"}, {"type": "subtitle", "time": 3324.63, "timestamp": "00:55:24", "text": "饼干。是的，我喜欢。我喜欢"}, {"type": "subtitle", "time": 3327.069, "timestamp": "00:55:27", "text": "我把它和咖啡一起吃了。"}, {"type": "subtitle", "time": 3330.309, "timestamp": "00:55:30", "text": "哦，听起来真好吃。"}, {"type": "subtitle", "time": 3332.95, "timestamp": "00:55:32", "text": "确实如此。我我我吃我事情是这样的，"}, {"type": "subtitle", "time": 3334.79, "timestamp": "00:55:34", "text": "正确的？我和我的家人分享了一些"}, {"type": "subtitle", "time": 3337.51, "timestamp": "00:55:37", "text": "就像这里的食物一样。我爸买了两个"}, {"type": "subtitle", "time": 3339.43, "timestamp": "00:55:39", "text": "包。他一个也没吃。"}, {"type": "subtitle", "time": 3343.19, "timestamp": "00:55:43", "text": "因为我一直在吃那种垃圾食品。"}, {"type": "subtitle", "time": 3347.03, "timestamp": "00:55:47", "text": "我的天啊。是的。正确的。因为，"}, {"type": "subtitle", "time": 3348.23, "timestamp": "00:55:48", "text": "好吧，事情是这样的，对吧？我只"}, {"type": "subtitle", "time": 3349.75, "timestamp": "00:55:49", "text": "想喝茶的时候就喝茶"}, {"type": "subtitle", "time": 3353.109, "timestamp": "00:55:53", "text": "我在喝健康饮品。我喜欢喝茶。听到"}, {"type": "subtitle", "time": 3355.19, "timestamp": "00:55:55", "text": "把我赶出去。我喜欢喝茶。如果我被给予"}, {"type": "subtitle", "time": 3356.95, "timestamp": "00:55:56", "text": "可以选择喝，而且有人向我提供了这个选项。"}]
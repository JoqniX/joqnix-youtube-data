[{"type": "subtitle", "time": 6660.31, "timestamp": "01:51:00", "text": "短发，性格好。是的，"}, {"type": "subtitle", "time": 6662.95, "timestamp": "01:51:02", "text": "我准备好了。"}, {"type": "subtitle", "time": 6666.229, "timestamp": "01:51:06", "text": "或许是个假小子"}, {"type": "subtitle", "time": 6667.99, "timestamp": "01:51:07", "text": "因为每当我想起红发女郎，就会想到矮个子。"}, {"type": "subtitle", "time": 6670.47, "timestamp": "01:51:10", "text": "头发和良好的性格，我想……"}, {"type": "subtitle", "time": 6679.03, "timestamp": "01:51:19", "text": "对，假小子。是的。是啊，我就知道。我"}, {"type": "subtitle", "time": 6681.669, "timestamp": "01:51:21", "text": "我就知道。"}, {"type": "subtitle", "time": 6683.83, "timestamp": "01:51:23", "text": "但是，是的，我觉得有些汤巴"}, {"type": "subtitle", "time": 6686.79, "timestamp": "01:51:26", "text": "感觉并没有过分夸张，"}, {"type": "subtitle", "time": 6688.709, "timestamp": "01:51:28", "text": "每当它像浪漫的一样"}, {"type": "subtitle", "time": 6691.35, "timestamp": "01:51:31", "text": "和他们在一起的那一刻，感觉就像……呃，那是什么？"}, {"type": "subtitle", "time": 6695.109, "timestamp": "01:51:35", "text": "叫什么？就像通风和热情一样"}, {"type": "subtitle", "time": 6697.27, "timestamp": "01:51:37", "text": "他们并没有过分张扬。"}, {"type": "subtitle", "time": 6699.27, "timestamp": "01:51:39", "text": "一点也不浮夸的男孩气"}, {"type": "subtitle", "time": 6701.27, "timestamp": "01:51:41", "text": "他们处理事情的方式。就像"}, {"type": "subtitle", "time": 6703.51, "timestamp": "01:51:43", "text": "你就能获得片刻的宁静。"}, {"type": "subtitle", "time": 6705.31, "timestamp": "01:51:45", "text": "闲逛"}, {"type": "subtitle", "time": 6708.47, "timestamp": "01:51:48", "text": "和你喜欢的、有点像你的人"}, {"type": "subtitle", "time": 6710.47, "timestamp": "01:51:50", "text": "兄弟，你懂的？"}, {"type": "subtitle", "time": 6713.03, "timestamp": "01:51:53", "text": "所以这就像是另一个层次的……"}, {"type": "subtitle", "time": 6715.83, "timestamp": "01:51:55", "text": "你和他们之间的亲密程度。我明白了。"}, {"type": "subtitle", "time": 6718.79, "timestamp": "01:51:58", "text": "诚实地。是的。"}]
[{"type": "subtitle", "time": 5280.79, "timestamp": "01:28:00", "text": "错误肯定会有。但机器"}, {"type": "subtitle", "time": 5284.55, "timestamp": "01:28:04", "text": "一种是更偏向机器本地化。呃，它"}, {"type": "subtitle", "time": 5286.629, "timestamp": "01:28:06", "text": "未达标。它忽略了细微差别。"}, {"type": "subtitle", "time": 5289.59, "timestamp": "01:28:09", "text": "消息内容。是的。是的。是的。就"}, {"type": "subtitle", "time": 5291.669, "timestamp": "01:28:11", "text": "直接翻译，无需翻译"}, {"type": "subtitle", "time": 5294.629, "timestamp": "01:28:14", "text": "包括其他所有因素。但是就像"}, {"type": "subtitle", "time": 5296.07, "timestamp": "01:28:16", "text": "有时候那样更好，有时候"}, {"type": "subtitle", "time": 5297.99, "timestamp": "01:28:17", "text": "那更糟。它也有其用途。"}, {"type": "subtitle", "time": 5300.87, "timestamp": "01:28:20", "text": "是案例，对吧？但是就像"}, {"type": "subtitle", "time": 5303.43, "timestamp": "01:28:23", "text": "我感觉我不喜欢本地化"}, {"type": "subtitle", "time": 5305.03, "timestamp": "01:28:25", "text": "他们试图把所有这些东西都塞进去。"}, {"type": "subtitle", "time": 5307.669, "timestamp": "01:28:27", "text": "将其融入某个特定想法或试图使其成立"}, {"type": "subtitle", "time": 5310.07, "timestamp": "01:28:30", "text": "针对特定文化，因为我真的"}, {"type": "subtitle", "time": 5312.55, "timestamp": "01:28:32", "text": "不喜欢你。这是一个很好的例子。"}, {"type": "subtitle", "time": 5315.11, "timestamp": "01:28:35", "text": "是老版 Kirby 的 Kirby 艺术作品吗？"}, {"type": "subtitle", "time": 5317.43, "timestamp": "01:28:37", "text": "天。你知道，就像卡比游戏盒封面那样。"}, {"type": "subtitle", "time": 5320.87, "timestamp": "01:28:40", "text": "在美国，柯比很生气，他"}, {"type": "subtitle", "time": 5324.149, "timestamp": "01:28:44", "text": "在日本可爱到爆。那种类型的"}, {"type": "subtitle", "time": 5327.03, "timestamp": "01:28:47", "text": "事物。嗯。他回答说：“是啊。”这就像……"}, {"type": "subtitle", "time": 5328.629, "timestamp": "01:28:48", "text": "完全是两码事。"}, {"type": "subtitle", "time": 5330.55, "timestamp": "01:28:50", "text": "就像他们进行本地化以适应"}, {"type": "subtitle", "time": 5332.149, "timestamp": "01:28:52", "text": "针对特定受众群体销售少量产品"}, {"type": "subtitle", "time": 5333.59, "timestamp": "01:28:53", "text": "更多，有时可能会改变"}, {"type": "subtitle", "time": 5335.59, "timestamp": "01:28:55", "text": "给它发条信息。"}, {"type": "subtitle", "time": 5337.91, "timestamp": "01:28:57", "text": "真是太奇怪了。我相当确定"}, {"type": "subtitle", "time": 5339.35, "timestamp": "01:28:59", "text": "好像发生了很多戏剧性的事情。"}]
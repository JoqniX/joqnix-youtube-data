[{"type": "subtitle", "time": 6360.55, "timestamp": "01:46:00", "text": "展现乐趣，并达到这种水平"}, {"type": "subtitle", "time": 6362.87, "timestamp": "01:46:02", "text": "史蒂夫所拥有的那种技艺，正是我想要的。"}, {"type": "subtitle", "time": 6365.109, "timestamp": "01:46:05", "text": "假设我身处那个世界，我当时就想："}, {"type": "subtitle", "time": 6367.91, "timestamp": "01:46:07", "text": "超级好玩。他让角色鲜活起来"}, {"type": "subtitle", "time": 6370.149, "timestamp": "01:46:10", "text": "像个不同类型的人"}, {"type": "subtitle", "time": 6371.669, "timestamp": "01:46:11", "text": "这完全出乎我的意料。和"}, {"type": "subtitle", "time": 6374.47, "timestamp": "01:46:14", "text": "它颠覆了我的预期，是的。"}, {"type": "subtitle", "time": 6377.109, "timestamp": "01:46:17", "text": "这其中蕴含着一些深度。"}, {"type": "subtitle", "time": 6378.87, "timestamp": "01:46:18", "text": "杰克·布莱克实际上扮演了一个角色"}, {"type": "subtitle", "time": 6382.31, "timestamp": "01:46:22", "text": "我很喜欢。真的很好。"}, {"type": "subtitle", "time": 6384.229, "timestamp": "01:46:24", "text": "就像角色塑造一样"}, {"type": "subtitle", "time": 6386.07, "timestamp": "01:46:26", "text": "非常好。这不是史蒂夫。"}, {"type": "subtitle", "time": 6388.709, "timestamp": "01:46:28", "text": "想象。它不像头部"}, {"type": "subtitle", "time": 6391.79, "timestamp": "01:46:31", "text": "我们很多人都对史蒂夫抱有好感，但是"}, {"type": "subtitle", "time": 6396.91, "timestamp": "01:46:36", "text": "感觉很接近了，对吧？是的。"}, {"type": "subtitle", "time": 6400.31, "timestamp": "01:46:40", "text": "你会让亚历克斯变得顺从吗？"}, {"type": "subtitle", "time": 6402.87, "timestamp": "01:46:42", "text": "在你的 Minecraft 中可以繁殖"}, {"type": "subtitle", "time": 6408.55, "timestamp": "01:46:48", "text": "我不知道。"}, {"type": "subtitle", "time": 6412.07, "timestamp": "01:46:52", "text": "好的。对，就是这样。"}, {"type": "subtitle", "time": 6413.59, "timestamp": "01:46:53", "text": "他会的。大多数角色只是"}, {"type": "subtitle", "time": 6415.83, "timestamp": "01:46:55", "text": "就是他。是的。正确的。很有趣。真实的"}, {"type": "subtitle", "time": 6417.43, "timestamp": "01:46:57", "text": "问题。正确的。正确的。正确的。正确的。"}, {"type": "subtitle", "time": 6419.59, "timestamp": "01:46:59", "text": "事情是这样的。正确的。你会做"}]
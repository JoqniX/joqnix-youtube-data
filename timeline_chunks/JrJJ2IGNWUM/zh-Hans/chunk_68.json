[{"type": "subtitle", "time": 4081.589, "timestamp": "01:08:01", "text": "通常情况下，它上面不会滋生霉菌，因为"}, {"type": "subtitle", "time": 4083.15, "timestamp": "01:08:03", "text": "我们把它放进去了"}, {"type": "subtitle", "time": 4085.75, "timestamp": "01:08:05", "text": "冰箱。我们现在把它放进冰箱冷冻室了。"}, {"type": "subtitle", "time": 4087.309, "timestamp": "01:08:07", "text": "防止它发霉等等。"}, {"type": "subtitle", "time": 4089.43, "timestamp": "01:08:09", "text": "拉屎。但确实如此"}, {"type": "subtitle", "time": 4091.75, "timestamp": "01:08:11", "text": "放进烤面包机后烤起来很麻烦。"}, {"type": "subtitle", "time": 4094.95, "timestamp": "01:08:14", "text": "冰箱。它简直太他妈的了"}, {"type": "subtitle", "time": 4098.11, "timestamp": "01:08:18", "text": "就像里面很湿润，所以很难……"}, {"type": "subtitle", "time": 4100.149, "timestamp": "01:08:20", "text": "吐司。你们呢？你们"}, {"type": "subtitle", "time": 4102.47, "timestamp": "01:08:22", "text": "把面包放进冰箱里，或者像这样……"}, {"type": "subtitle", "time": 4104.229, "timestamp": "01:08:24", "text": "冰箱？因为我们把它放进去了"}, {"type": "subtitle", "time": 4106.43, "timestamp": "01:08:26", "text": "现在放进冰箱。"}, {"type": "subtitle", "time": 4108.709, "timestamp": "01:08:28", "text": "如果你把它放进去，那就不足为奇了。"}, {"type": "subtitle", "time": 4111.669, "timestamp": "01:08:31", "text": "外面的冰柜？"}, {"type": "subtitle", "time": 4113.749, "timestamp": "01:08:33", "text": "不，令人惊讶的是，它仍然有味道。"}, {"type": "subtitle", "time": 4116.229, "timestamp": "01:08:36", "text": "相同的。因为它持续时间更长，因为我们已经有了。"}, {"type": "subtitle", "time": 4117.669, "timestamp": "01:08:37", "text": "我们吃那面包已经超过……"}, {"type": "subtitle", "time": 4120.229, "timestamp": "01:08:40", "text": "已经三个月了，老兄。并非如此"}, {"type": "subtitle", "time": 4122.47, "timestamp": "01:08:42", "text": "模制的。它完全冻住了。进而"}, {"type": "subtitle", "time": 4123.829, "timestamp": "01:08:43", "text": "每当我们想加热它的时候"}, {"type": "subtitle", "time": 4125.269, "timestamp": "01:08:45", "text": "我们又把它放进去了，就像这样"}, {"type": "subtitle", "time": 4128.229, "timestamp": "01:08:48", "text": "烤箱，然后它就能正常工作了。"}, {"type": "subtitle", "time": 4134.55, "timestamp": "01:08:54", "text": "嘿，兰比。但是，是的，所以我就……"}, {"type": "subtitle", "time": 4137.51, "timestamp": "01:08:57", "text": "检查检查。还有，呃，Adi R Negi，我"}]
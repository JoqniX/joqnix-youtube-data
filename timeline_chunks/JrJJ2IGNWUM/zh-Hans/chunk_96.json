[{"type": "subtitle", "time": 5763.27, "timestamp": "01:36:03", "text": "问题总是出现，就像……哦"}, {"type": "subtitle", "time": 5766.629, "timestamp": "01:36:06", "text": "我曾遭受虐待，现在我走了。"}, {"type": "subtitle", "time": 5768.709, "timestamp": "01:36:08", "text": "没有我，那个英雄党就惨了。"}, {"type": "subtitle", "time": 5770.47, "timestamp": "01:36:10", "text": "他们想让我回去，而且一直都是这样。"}, {"type": "subtitle", "time": 5772.99, "timestamp": "01:36:12", "text": "一遍又一遍地重复着同样该死的事"}, {"type": "subtitle", "time": 5776.79, "timestamp": "01:36:16", "text": "再次。但我还是觉得很有趣，对吧？"}, {"type": "subtitle", "time": 5778.629, "timestamp": "01:36:18", "text": "我不在乎剧情如何"}, {"type": "subtitle", "time": 5780.47, "timestamp": "01:36:20", "text": "重复。我不在乎"}, {"type": "subtitle", "time": 5782.149, "timestamp": "01:36:22", "text": "角色基本上都是复制粘贴的。"}, {"type": "subtitle", "time": 5784.95, "timestamp": "01:36:24", "text": "从另一个来看，就像主要部分一样"}, {"type": "subtitle", "time": 5787.03, "timestamp": "01:36:27", "text": "英雄党就像一群傻瓜"}, {"type": "subtitle", "time": 5789.59, "timestamp": "01:36:29", "text": "而且新部分总是他妈的"}, {"type": "subtitle", "time": 5791.99, "timestamp": "01:36:31", "text": "比旧款好。就像老兄，"}, {"type": "subtitle", "time": 5794.55, "timestamp": "01:36:34", "text": "我不在乎。我读得很开心。"}, {"type": "subtitle", "time": 5796.39, "timestamp": "01:36:36", "text": "正确的？是的。你呢？"}, {"type": "subtitle", "time": 5798.79, "timestamp": "01:36:38", "text": "杰基？除了异世界题材之外还有什么？"}, {"type": "subtitle", "time": 5801.27, "timestamp": "01:36:41", "text": "你觉得像这种东西算是……"}, {"type": "subtitle", "time": 5804.709, "timestamp": "01:36:44", "text": "虽然大家都觉得它很烂，但还是挺好玩的。"}, {"type": "subtitle", "time": 5806.59, "timestamp": "01:36:46", "text": "观看或"}, {"type": "subtitle", "time": 5811.83, "timestamp": "01:36:51", "text": "像放纵一样？哦，呃，科学"}, {"type": "subtitle", "time": 5816.95, "timestamp": "01:36:56", "text": "那种时间旅行之类的东西，哦，那些"}]
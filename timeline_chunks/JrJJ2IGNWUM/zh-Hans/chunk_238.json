[{"type": "subtitle", "time": 14282.87, "timestamp": "03:58:02", "text": "六月底。上周我得收拾行李了。"}, {"type": "subtitle", "time": 14285.79, "timestamp": "03:58:05", "text": "一切。"}, {"type": "subtitle", "time": 14297.349, "timestamp": "03:58:17", "text": "希望你一直在学习"}, {"type": "subtitle", "time": 14299.189, "timestamp": "03:58:19", "text": "研究。现在我必须认真对待这件事了。"}, {"type": "subtitle", "time": 14302.309, "timestamp": "03:58:22", "text": "只要我在场，就永远不会发生。我不能，我是"}, {"type": "subtitle", "time": 14306.63, "timestamp": "03:58:26", "text": "主人，我现在都无法喜欢你。"}, {"type": "subtitle", "time": 14308.51, "timestamp": "03:58:28", "text": "不会后悔的"}, {"type": "subtitle", "time": 14310.51, "timestamp": "03:58:30", "text": "大概"}, {"type": "subtitle", "time": 14313.389, "timestamp": "03:58:33", "text": "考试。我甚至都不是"}, {"type": "subtitle", "time": 14316.07, "timestamp": "03:58:36", "text": "学习中。我好像在做所有这些事"}, {"type": "subtitle", "time": 14324.63, "timestamp": "03:58:44", "text": "一切。但我觉得我花了很长时间"}, {"type": "subtitle", "time": 14327.07, "timestamp": "03:58:47", "text": "我会尽量"}, {"type": "subtitle", "time": 14334.389, "timestamp": "03:58:54", "text": "是的。我们去那里吧。在那边。外观"}]
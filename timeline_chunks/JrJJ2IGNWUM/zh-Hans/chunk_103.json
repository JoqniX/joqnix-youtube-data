[{"type": "subtitle", "time": 6183.27, "timestamp": "01:43:03", "text": "想更多地了解世界"}, {"type": "subtitle", "time": 6186.229, "timestamp": "01:43:06", "text": "最后把所有那些事情都妥善处理好。是的，"}, {"type": "subtitle", "time": 6188.87, "timestamp": "01:43:08", "text": "他们确实错过了很多东西。"}, {"type": "subtitle", "time": 6196.149, "timestamp": "01:43:16", "text": "是的，对我来说，我可能会做"}, {"type": "subtitle", "time": 6200.31, "timestamp": "01:43:20", "text": "就像，呃，我希望史蒂夫能像……"}, {"type": "subtitle", "time": 6203.109, "timestamp": "01:43:23", "text": "滑稽有趣的角色，但也非常"}, {"type": "subtitle", "time": 6205.75, "timestamp": "01:43:25", "text": "他工作能力很强。"}, {"type": "subtitle", "time": 6208.87, "timestamp": "01:43:28", "text": "我希望亚历克斯成为"}, {"type": "subtitle", "time": 6211.99, "timestamp": "01:43:31", "text": "呃，那个既搞笑又超级厉害的女孩"}, {"type": "subtitle", "time": 6214.07, "timestamp": "01:43:34", "text": "胜任的，"}, {"type": "subtitle", "time": 6215.99, "timestamp": "01:43:35", "text": "但她只想做自己想做的事。"}, {"type": "subtitle", "time": 6218.55, "timestamp": "01:43:38", "text": "不受史蒂夫打扰。和"}, {"type": "subtitle", "time": 6220.87, "timestamp": "01:43:40", "text": "他们会进行各种稀奇古怪的冒险，"}, {"type": "subtitle", "time": 6223.669, "timestamp": "01:43:43", "text": "就像是，“哦不，这里有一个……”"}, {"type": "subtitle", "time": 6226.07, "timestamp": "01:43:46", "text": "一大群僵尸正朝我们扑来。快的，"}, {"type": "subtitle", "time": 6228.99, "timestamp": "01:43:48", "text": "搭建一个庇护所。我已经做好了TNT炸药"}, {"type": "subtitle", "time": 6231.43, "timestamp": "01:43:51", "text": "大炮。”那种东西，就是……"}, {"type": "subtitle", "time": 6234.55, "timestamp": "01:43:54", "text": "就是超级超级随机，而且很滑稽"}, {"type": "subtitle", "time": 6236.95, "timestamp": "01:43:56", "text": "这似乎表明了他们的水平"}, {"type": "subtitle", "time": 6239.03, "timestamp": "01:43:59", "text": "他们精通自己所处的世界。"}]
[{"type": "subtitle", "time": 15792.189, "timestamp": "04:23:12", "text": "我的天啊。不"}, {"type": "subtitle", "time": 15796.11, "timestamp": "04:23:16", "text": "方式。决不。 Roku 实际上"}, {"type": "subtitle", "time": 15798.87, "timestamp": "04:23:18", "text": "重放器。该死。我以为你是"}, {"type": "subtitle", "time": 15806.469, "timestamp": "04:23:26", "text": "笨蛋。想象一下他正在告诉他"}, {"type": "subtitle", "time": 15814.63, "timestamp": "04:23:34", "text": "朋友。我这里有一个。事情就是这样。"}, {"type": "subtitle", "time": 15835.07, "timestamp": "04:23:55", "text": "去。"}]
[{"type": "subtitle", "time": 240.869, "timestamp": "00:04:00", "text": "我觉得我……是的，那个测验"}, {"type": "subtitle", "time": 242.63, "timestamp": "00:04:02", "text": "也展出。对，我忘了那个问答节目。"}, {"type": "subtitle", "time": 245.75, "timestamp": "00:04:05", "text": "哦是的。哦，我喜欢这个问答节目。你"}, {"type": "subtitle", "time": 248.47, "timestamp": "00:04:08", "text": "我为此做了很多准备。我真希望我"}, {"type": "subtitle", "time": 250.149, "timestamp": "00:04:10", "text": "可以多做一些这样的事，伙计。但我没有"}, {"type": "subtitle", "time": 253.35, "timestamp": "00:04:13", "text": "我有时间。我想举办更多活动"}, {"type": "subtitle", "time": 255.27, "timestamp": "00:04:15", "text": "类型类事物，而不仅仅是电子游戏"}, {"type": "subtitle", "time": 257.43, "timestamp": "00:04:17", "text": "你知道，一整天都是这样。"}, {"type": "subtitle", "time": 260.71, "timestamp": "00:04:20", "text": "那样做需要花费很多精力。是的。甚至"}, {"type": "subtitle", "time": 262.71, "timestamp": "00:04:22", "text": "虽然这艺术风格就像个傻瓜"}, {"type": "subtitle", "time": 268.07, "timestamp": "00:04:28", "text": "是的。嘿，大家好。你好。欢迎来到"}, {"type": "subtitle", "time": 270.31, "timestamp": "00:04:30", "text": "溪流。大家今天过得怎么样？"}, {"type": "subtitle", "time": 273.67, "timestamp": "00:04:33", "text": "大家好。你好。欢迎光临。"}, {"type": "subtitle", "time": 276.189, "timestamp": "00:04:36", "text": "大家好。 RCS。你好"}, {"type": "subtitle", "time": 279.11, "timestamp": "00:04:39", "text": "爸爸。是的。可惜我们今天不玩游戏。"}, {"type": "subtitle", "time": 280.95, "timestamp": "00:04:40", "text": "我觉得我们根本没玩成游戏。"}, {"type": "subtitle", "time": 282.95, "timestamp": "00:04:42", "text": "准备好。"}, {"type": "subtitle", "time": 285.59000000000003, "timestamp": "00:04:45", "text": "哦。等等。呃，你提到过你"}, {"type": "subtitle", "time": 289.189, "timestamp": "00:04:49", "text": "拥有《彩虹六号：围攻》和《军团要塞2》以及团队"}, {"type": "subtitle", "time": 291.59000000000003, "timestamp": "00:04:51", "text": "先玩《要塞2》，然后是《瓦伦特》。那些是"}, {"type": "subtitle", "time": 293.749, "timestamp": "00:04:53", "text": "我这台电脑上只有这些游戏。"}, {"type": "subtitle", "time": 296.03, "timestamp": "00:04:56", "text": "现在因为我格式化了"}, {"type": "subtitle", "time": 298.629, "timestamp": "00:04:58", "text": "一切都是因为 Windows 我要……"}]
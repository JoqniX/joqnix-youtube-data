[{"type": "subtitle", "time": 9667.59, "timestamp": "02:41:07", "text": "事物。晚餐不错。我感觉困了。"}, {"type": "subtitle", "time": 9672.11, "timestamp": "02:41:12", "text": "是的。好的。呃，让我带你上车"}, {"type": "subtitle", "time": 9676.55, "timestamp": "02:41:16", "text": "溪流。你好。三、二、一。你好"}, {"type": "subtitle", "time": 9679.91, "timestamp": "02:41:19", "text": "每个人。所以今天最后一部分是……"}, {"type": "subtitle", "time": 9683.75, "timestamp": "02:41:23", "text": "Joathon 第 79 天的第二部分，我们将"}, {"type": "subtitle", "time": 9687.75, "timestamp": "02:41:27", "text": "我们最终选定马兰作为我们的合作者。"}, {"type": "subtitle", "time": 9692.79, "timestamp": "02:41:32", "text": "那天。你好，马兰。你好。"}, {"type": "subtitle", "time": 9700.95, "timestamp": "02:41:40", "text": "所以这是我们第一次"}, {"type": "subtitle", "time": 9704.79, "timestamp": "02:41:44", "text": "嗯，合作，对吧？"}, {"type": "subtitle", "time": 9706.389, "timestamp": "02:41:46", "text": "是的。"}, {"type": "subtitle", "time": 9710.75, "timestamp": "02:41:50", "text": "是的，这是我们第一次。我是"}, {"type": "subtitle", "time": 9714.07, "timestamp": "02:41:54", "text": "兴奋的。所以，今天我们要玩……"}]
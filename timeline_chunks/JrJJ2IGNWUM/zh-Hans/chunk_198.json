[{"type": "subtitle", "time": 11884.229, "timestamp": "03:18:04", "text": "你做了吗？你有一个等等，你有一个"}, {"type": "subtitle", "time": 11886.63, "timestamp": "03:18:06", "text": "发梳？"}, {"type": "subtitle", "time": 11890.55, "timestamp": "03:18:10", "text": "是的。你花钱了吗？"}, {"type": "subtitle", "time": 11896.309, "timestamp": "03:18:16", "text": "不。怎么会这样？免费。我买的是Yes。"}, {"type": "subtitle", "time": 11898.469, "timestamp": "03:18:18", "text": "什么时候？"}, {"type": "subtitle", "time": 11904.469, "timestamp": "03:18:24", "text": "我读到50级的时候才拿到。近"}, {"type": "subtitle", "time": 11906.229, "timestamp": "03:18:26", "text": "50."}, {"type": "subtitle", "time": 11909.03, "timestamp": "03:18:29", "text": "等等，升级就能获得一个头发"}, {"type": "subtitle", "time": 11913.19, "timestamp": "03:18:33", "text": "当你达到50级左右的时候？什么"}, {"type": "subtitle", "time": 11918.59, "timestamp": "03:18:38", "text": "如果你运气好的话？是的，"}, {"type": "subtitle", "time": 11920.389, "timestamp": "03:18:40", "text": "[音乐]"}, {"type": "subtitle", "time": 11922.95, "timestamp": "03:18:42", "text": "他们什么时候开始放弃的？"}, {"type": "subtitle", "time": 11924.469, "timestamp": "03:18:44", "text": "自由的？"}, {"type": "subtitle", "time": 11926.349, "timestamp": "03:18:46", "text": "我是说"}, {"type": "subtitle", "time": 11936.15, "timestamp": "03:18:56", "text": "呃"}, {"type": "subtitle", "time": 11939.59, "timestamp": "03:18:59", "text": "这太酷了。"}]
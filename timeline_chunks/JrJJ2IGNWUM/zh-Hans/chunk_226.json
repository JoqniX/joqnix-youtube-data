[{"type": "subtitle", "time": 13561.67, "timestamp": "03:46:01", "text": "好的。"}, {"type": "subtitle", "time": 13565.79, "timestamp": "03:46:05", "text": "那里有什么？落后一分。但我会得到"}, {"type": "subtitle", "time": 13568.03, "timestamp": "03:46:08", "text": "那。房子"}, {"type": "subtitle", "time": 13585.51, "timestamp": "03:46:25", "text": "哦，是的。哦，是的。我们遇到敌人了。我"}, {"type": "subtitle", "time": 13586.51, "timestamp": "03:46:26", "text": "遇到了一些坏事"}, {"type": "subtitle", "time": 13589.269, "timestamp": "03:46:29", "text": "伙计们。我们开始吧。我来了。是"}, {"type": "subtitle", "time": 13591.83, "timestamp": "03:46:31", "text": "并不孤单。我这里有几个坏蛋。啊，"}, {"type": "subtitle", "time": 13595.349, "timestamp": "03:46:35", "text": "从后面。我还没完成。尽量"}, {"type": "subtitle", "time": 13597.349, "timestamp": "03:46:37", "text": "这边。"}, {"type": "subtitle", "time": 13600.389, "timestamp": "03:46:40", "text": "快跑，快跑，快跑。跑就行了。不用担心。"}, {"type": "subtitle", "time": 13602.389, "timestamp": "03:46:42", "text": "我正在给护盾充能。我正在尝试"}, {"type": "subtitle", "time": 13604.95, "timestamp": "03:46:44", "text": "来找你。"}, {"type": "subtitle", "time": 13608.95, "timestamp": "03:46:48", "text": "如果你愿意的话，可以尝试复活他。"}, {"type": "subtitle", "time": 13610.79, "timestamp": "03:46:50", "text": "没关系。我觉得没人看到"}, {"type": "subtitle", "time": 13617.79, "timestamp": "03:46:57", "text": "哇，我的护盾值很低。我是否有"}]
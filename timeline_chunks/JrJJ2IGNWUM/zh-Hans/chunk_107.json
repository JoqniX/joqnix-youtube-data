[{"type": "subtitle", "time": 6423.91, "timestamp": "01:47:03", "text": "Alex是个性感尤物，或者你会让Alex成为​​Alex吗？"}, {"type": "subtitle", "time": 6428.109, "timestamp": "01:47:08", "text": "只是一个漂亮的女人？匹配"}, {"type": "subtitle", "time": 6430.87, "timestamp": "01:47:10", "text": "史蒂夫，因为我觉得如果这样可行的话"}, {"type": "subtitle", "time": 6433.189, "timestamp": "01:47:13", "text": "她就像一个相对有魅力的人。"}, {"type": "subtitle", "time": 6435.51, "timestamp": "01:47:15", "text": "女士。不太吸引人，只是"}, {"type": "subtitle", "time": 6437.51, "timestamp": "01:47:17", "text": "足够吸引人，值得考虑"}, {"type": "subtitle", "time": 6439.43, "timestamp": "01:47:19", "text": "吸引人的。"}, {"type": "subtitle", "time": 6441.83, "timestamp": "01:47:21", "text": "她喜欢游走在边缘，对吧？但是如果"}, {"type": "subtitle", "time": 6443.91, "timestamp": "01:47:23", "text": "如果他们把它做得像顺从者一样"}, {"type": "subtitle", "time": 6446.07, "timestamp": "01:47:26", "text": "而且透气性好，我觉得它会"}, {"type": "subtitle", "time": 6448.47, "timestamp": "01:47:28", "text": "就像主线剧情构思一样，毁坏了什么？"}, {"type": "subtitle", "time": 6449.709, "timestamp": "01:47:29", "text": "亚历克斯会"}, {"type": "subtitle", "time": 6452.629, "timestamp": "01:47:32", "text": "是。因为我觉得亚历克斯仍然会是"}, {"type": "subtitle", "time": 6455.59, "timestamp": "01:47:35", "text": "就像下面肌肉超级发达一样，"}, {"type": "subtitle", "time": 6458.39, "timestamp": "01:47:38", "text": "你知道？像个肌肉发达的妈妈，但又不是那种。"}, {"type": "subtitle", "time": 6461.43, "timestamp": "01:47:41", "text": "身材健壮的辣妈，一看就知道。"}, {"type": "subtitle", "time": 6463.83, "timestamp": "01:47:43", "text": "我到底在说什么？但是就像"}, {"type": "subtitle", "time": 6465.59, "timestamp": "01:47:45", "text": "好的。说出一个电子游戏角色的名字"}, {"type": "subtitle", "time": 6468.55, "timestamp": "01:47:48", "text": "你想做爱。"}, {"type": "subtitle", "time": 6472.55, "timestamp": "01:47:52", "text": "我的天啊。或者至少有浪漫情愫"}]
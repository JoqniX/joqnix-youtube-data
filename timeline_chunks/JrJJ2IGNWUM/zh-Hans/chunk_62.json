[{"type": "subtitle", "time": 3721.589, "timestamp": "01:02:01", "text": "我觉得每个人都在里面"}, {"type": "subtitle", "time": 3723.03, "timestamp": "01:02:03", "text": "聊天室里的人都知道我在说什么。"}, {"type": "subtitle", "time": 3724.789, "timestamp": "01:02:04", "text": "差不多吧？你们肯定"}, {"type": "subtitle", "time": 3726.47, "timestamp": "01:02:06", "text": "你小时候吃过那种有颜色的番茄酱"}, {"type": "subtitle", "time": 3730.23, "timestamp": "01:02:10", "text": "更年轻些，对吧？是的。真是太奇怪了"}, {"type": "subtitle", "time": 3733.75, "timestamp": "01:02:13", "text": "因为它有股奇怪的化学味道。它"}, {"type": "subtitle", "time": 3736.789, "timestamp": "01:02:16", "text": "感觉不像新鲜的番茄。它是"}, {"type": "subtitle", "time": 3738.87, "timestamp": "01:02:18", "text": "比如他们添加的食用色素"}, {"type": "subtitle", "time": 3743.589, "timestamp": "01:02:23", "text": "感觉有一股奇怪的人工味道。"}, {"type": "subtitle", "time": 3745.99, "timestamp": "01:02:25", "text": "是的。彩色番茄酱。是的。就这么"}, {"type": "subtitle", "time": 3747.829, "timestamp": "01:02:27", "text": "不喜欢那些奇怪的食用色素"}, {"type": "subtitle", "time": 3750.19, "timestamp": "01:02:30", "text": "感觉就像超级他妈的"}, {"type": "subtitle", "time": 3752.95, "timestamp": "01:02:32", "text": "诡异的。从未听说过。你从未"}, {"type": "subtitle", "time": 3756.95, "timestamp": "01:02:36", "text": "听说过彩色番茄酱吗，帕特？"}, {"type": "subtitle", "time": 3758.789, "timestamp": "01:02:38", "text": "好的。那百事蓝呢？你们"}, {"type": "subtitle", "time": 3762.069, "timestamp": "01:02:42", "text": "还有百事蓝吗？百事蓝。这"}, {"type": "subtitle", "time": 3763.63, "timestamp": "01:02:43", "text": "竖起大拇指"}, {"type": "subtitle", "time": 3766.309, "timestamp": "01:02:46", "text": "印度。点赞。我完全没有头绪"}, {"type": "subtitle", "time": 3768.87, "timestamp": "01:02:48", "text": "竖起大拇指是什么意思？那就像……"}, {"type": "subtitle", "time": 3771.99, "timestamp": "01:02:51", "text": "对，就像百事可乐一样。"}, {"type": "subtitle", "time": 3774.63, "timestamp": "01:02:54", "text": "是啊，不过是蓝色的。像霓虹蓝。"}, {"type": "subtitle", "time": 3777.109, "timestamp": "01:02:57", "text": "哦，不是霓虹蓝。哦，不是"}, {"type": "subtitle", "time": 3779.109, "timestamp": "01:02:59", "text": "就是那个。"}]
[{"type": "subtitle", "time": 3601.99, "timestamp": "01:00:01", "text": "以前是花园吗？橄榄园？不，但是"}, {"type": "subtitle", "time": 3605.349, "timestamp": "01:00:05", "text": "Olive Garden餐厅提供无限量供应。"}, {"type": "subtitle", "time": 3607.589, "timestamp": "01:00:07", "text": "面包棒。"}, {"type": "subtitle", "time": 3609.589, "timestamp": "01:00:09", "text": "等等，还有这种事？"}, {"type": "subtitle", "time": 3611.829, "timestamp": "01:00:11", "text": "是的，"}, {"type": "subtitle", "time": 3614.549, "timestamp": "01:00:14", "text": "男人。老兄，就连奶酪味的也一样。是的，"}, {"type": "subtitle", "time": 3617.829, "timestamp": "01:00:17", "text": "那些都很好。"}, {"type": "subtitle", "time": 3620.87, "timestamp": "01:00:20", "text": "还有什么？比如，像意大利面之类的。"}, {"type": "subtitle", "time": 3623.51, "timestamp": "01:00:23", "text": "我觉得他们就像一个大大……"}, {"type": "subtitle", "time": 3625.19, "timestamp": "01:00:25", "text": "对我来说是好事，但我其实不太喜欢"}, {"type": "subtitle", "time": 3627.75, "timestamp": "01:00:27", "text": "菲律宾菜现在已经不那么流行了。我"}, {"type": "subtitle", "time": 3632.23, "timestamp": "01:00:32", "text": "我喜欢菲律宾的味道，因为我……"}, {"type": "subtitle", "time": 3635.27, "timestamp": "01:00:35", "text": "妻子的家人都很喜欢烹饪。我的"}, {"type": "subtitle", "time": 3637.43, "timestamp": "01:00:37", "text": "家人不是。我们喜欢非常西式的风格，"}, {"type": "subtitle", "time": 3641.349, "timestamp": "01:00:41", "text": "吃些随意的欧洲食物。呃，所以"}, {"type": "subtitle", "time": 3643.91, "timestamp": "01:00:43", "text": "不得不像我妻子的父母那样吃饭"}, {"type": "subtitle", "time": 3646.15, "timestamp": "01:00:46", "text": "地方和味道都像家常菜一样。"}, {"type": "subtitle", "time": 3647.99, "timestamp": "01:00:47", "text": "菲律宾家常菜让我更加欣赏"}, {"type": "subtitle", "time": 3649.99, "timestamp": "01:00:49", "text": "略带一丝鲜美"}, {"type": "subtitle", "time": 3653.43, "timestamp": "01:00:53", "text": "配有菲律宾菜肴。嗯。和"}, {"type": "subtitle", "time": 3655.91, "timestamp": "01:00:55", "text": "有时候，当你意识到很多事情"}, {"type": "subtitle", "time": 3658.069, "timestamp": "01:00:58", "text": "就像菲律宾人的调色板是居中的"}]
[{"type": "subtitle", "time": 3660.069, "timestamp": "01:01:00", "text": "趋向甜蜜。这就是我们使用的原因"}, {"type": "subtitle", "time": 3663.349, "timestamp": "01:01:03", "text": "香蕉番茄酱配一切。就像"}, {"type": "subtitle", "time": 3666.15, "timestamp": "01:01:06", "text": "很多香蕉番茄酱。什么？是的，我们"}, {"type": "subtitle", "time": 3668.47, "timestamp": "01:01:08", "text": "加香蕉番茄酱。是的，就像"}, {"type": "subtitle", "time": 3670.87, "timestamp": "01:01:10", "text": "辣的或甜的。不，不，它超级棒"}, {"type": "subtitle", "time": 3674.95, "timestamp": "01:01:14", "text": "甜的。它超级甜。哦。"}, {"type": "subtitle", "time": 3677.03, "timestamp": "01:01:17", "text": "哦。你还记得那些彩色的东西吗？"}, {"type": "subtitle", "time": 3679.109, "timestamp": "01:01:19", "text": "番茄酱？"}, {"type": "subtitle", "time": 3681.03, "timestamp": "01:01:21", "text": "我想我当时……你用过那些吗？"}, {"type": "subtitle", "time": 3682.39, "timestamp": "01:01:22", "text": "前？你以前用过那些吗？"}, {"type": "subtitle", "time": 3684.39, "timestamp": "01:01:24", "text": "你当时年纪更小？是的。是啊，我记得。"}, {"type": "subtitle", "time": 3687.03, "timestamp": "01:01:27", "text": "使用它们。是的。"}, {"type": "subtitle", "time": 3688.47, "timestamp": "01:01:28", "text": "我记得用过它们，当时我就想"}, {"type": "subtitle", "time": 3692.39, "timestamp": "01:01:32", "text": "我在想，为什么这味道像屁股？"}, {"type": "subtitle", "time": 3694.069, "timestamp": "01:01:34", "text": "因为它实际上并没有水果。"}, {"type": "subtitle", "time": 3696.39, "timestamp": "01:01:36", "text": "番茄酱的味道，因为我们就是这么……"}, {"type": "subtitle", "time": 3698.23, "timestamp": "01:01:38", "text": "在菲律宾以前经常这样。所以，我"}, {"type": "subtitle", "time": 3700.71, "timestamp": "01:01:40", "text": "我当时就想，为什么这东西尝起来像屁股？"}, {"type": "subtitle", "time": 3703.109, "timestamp": "01:01:43", "text": "我不知道它是不是像食物那样。"}, {"type": "subtitle", "time": 3705.829, "timestamp": "01:01:45", "text": "他们添加的颜色可能是因为我"}, {"type": "subtitle", "time": 3707.51, "timestamp": "01:01:47", "text": "知道普通番茄酱是什么味道"}, {"type": "subtitle", "time": 3711.15, "timestamp": "01:01:51", "text": "喜欢。是番茄。就是这样。是的。但"}, {"type": "subtitle", "time": 3714.47, "timestamp": "01:01:54", "text": "就像他妈的尝到了那种怪异的颜色"}, {"type": "subtitle", "time": 3717.63, "timestamp": "01:01:57", "text": "妈的，我也不知道。它"}, {"type": "subtitle", "time": 3719.91, "timestamp": "01:01:59", "text": "感觉……我不知道是不是只有我这样。你"}]
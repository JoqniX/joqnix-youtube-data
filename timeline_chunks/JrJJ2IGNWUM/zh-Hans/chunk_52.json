[{"type": "subtitle", "time": 3121.589, "timestamp": "00:52:01", "text": "时不时地，就像是满足一下自己的欲望。"}, {"type": "subtitle", "time": 3124.63, "timestamp": "00:52:04", "text": "饮料而不是咖啡，因为咖啡"}, {"type": "subtitle", "time": 3126.549, "timestamp": "00:52:06", "text": "在家感觉更好。我同意你们的看法。"}, {"type": "subtitle", "time": 3128.23, "timestamp": "00:52:08", "text": "如果你想煮出好咖啡，那就去做。"}, {"type": "subtitle", "time": 3130.39, "timestamp": "00:52:10", "text": "你自己。"}, {"type": "subtitle", "time": 3131.91, "timestamp": "00:52:11", "text": "如果你想要一杯好咖啡，那就来这里吧！"}, {"type": "subtitle", "time": 3134.95, "timestamp": "00:52:14", "text": "根据自己的口味，总是选择你喜欢的。"}, {"type": "subtitle", "time": 3137.51, "timestamp": "00:52:17", "text": "在家即可使用，并可自行实验。"}, {"type": "subtitle", "time": 3139.67, "timestamp": "00:52:19", "text": "这就好比做饭一样。我"}, {"type": "subtitle", "time": 3141.03, "timestamp": "00:52:21", "text": "热爱烹饪。我不知道你们是不是"}, {"type": "subtitle", "time": 3144.39, "timestamp": "00:52:24", "text": "我知道这一点，但我确实会做饭。就"}, {"type": "subtitle", "time": 3146.23, "timestamp": "00:52:26", "text": "尝试不同的口味"}, {"type": "subtitle", "time": 3149.91, "timestamp": "00:52:29", "text": "你想去。如果你不去探索"}, {"type": "subtitle", "time": 3152.79, "timestamp": "00:52:32", "text": "风味特征的可能性"}, {"type": "subtitle", "time": 3154.47, "timestamp": "00:52:34", "text": "你永远不会明白你真正的自己是什么。"}, {"type": "subtitle", "time": 3157.03, "timestamp": "00:52:37", "text": "想。因为对我来说，我发现我"}, {"type": "subtitle", "time": 3159.63, "timestamp": "00:52:39", "text": "就像我的超级他妈的"}, {"type": "subtitle", "time": 3162.15, "timestamp": "00:52:42", "text": "辛辣的。你知道，你知道鸭子或"}, {"type": "subtitle", "time": 3165.51, "timestamp": "00:52:45", "text": "不管是什么粉红色的韩国面条"}, {"type": "subtitle", "time": 3168.71, "timestamp": "00:52:48", "text": "超级辣。是的。是的。我爱"}, {"type": "subtitle", "time": 3171.67, "timestamp": "00:52:51", "text": "把所有酱汁都蘸着吃，然后……"}, {"type": "subtitle", "time": 3174.23, "timestamp": "00:52:54", "text": "我一点都不觉得辣。就像我"}, {"type": "subtitle", "time": 3176.71, "timestamp": "00:52:56", "text": "吃两包那种东西。我仍然有"}, {"type": "subtitle", "time": 3178.39, "timestamp": "00:52:58", "text": "楼下其实有两包。我应该"}]
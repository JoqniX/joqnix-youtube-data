[{"type": "subtitle", "time": 6241.669, "timestamp": "01:44:01", "text": "我希望它能成为主线剧情。"}, {"type": "subtitle", "time": 6244.629, "timestamp": "01:44:04", "text": "我原本打算拍一部《我的世界》电影。嗯。"}, {"type": "subtitle", "time": 6246.95, "timestamp": "01:44:06", "text": "我希望史蒂夫真的喜欢我"}, {"type": "subtitle", "time": 6249.03, "timestamp": "01:44:09", "text": "不想让他那样，因为那只是假设"}, {"type": "subtitle", "time": 6251.35, "timestamp": "01:44:11", "text": "我是根据现实生活改编的，我不想……"}, {"type": "subtitle", "time": 6253.51, "timestamp": "01:44:13", "text": "他就像一座砖砌的粪屋。我"}, {"type": "subtitle", "time": 6255.83, "timestamp": "01:44:15", "text": "只希望他像精瘦的milfit那样。"}, {"type": "subtitle", "time": 6258.87, "timestamp": "01:44:18", "text": "那种类型的人。"}, {"type": "subtitle", "time": 6261.75, "timestamp": "01:44:21", "text": "呃，仔细想想，这就不太合适了。"}, {"type": "subtitle", "time": 6263.43, "timestamp": "01:44:23", "text": "谁是蜘蛛侠的演员"}, {"type": "subtitle", "time": 6265.43, "timestamp": "01:44:25", "text": "再次？不是他。我不希望是这样。"}, {"type": "subtitle", "time": 6268.87, "timestamp": "01:44:28", "text": "像他一样。我希望它像这样"}, {"type": "subtitle", "time": 6270.87, "timestamp": "01:44:30", "text": "呃，汤姆·霍兰德。"}, {"type": "subtitle", "time": 6271.99, "timestamp": "01:44:31", "text": "是的。是的。我不想让汤姆"}, {"type": "subtitle", "time": 6275.03, "timestamp": "01:44:35", "text": "霍兰德，因为汤姆·霍兰德就像个孩子"}, {"type": "subtitle", "time": 6276.87, "timestamp": "01:44:36", "text": "正在寻找。是的。是的。我希望史蒂夫在"}, {"type": "subtitle", "time": 6279.39, "timestamp": "01:44:39", "text": "至少要像这样"}, {"type": "subtitle", "time": 6284.47, "timestamp": "01:44:44", "text": "也许是25岁，30岁。不，不，糟糕。是的。是的。"}, {"type": "subtitle", "time": 6286.47, "timestamp": "01:44:46", "text": "是的。是的。呃，《超凡蜘蛛侠》。"}, {"type": "subtitle", "time": 6287.59, "timestamp": "01:44:47", "text": "是的。他妈的。它叫什么名字？安德鲁"}, {"type": "subtitle", "time": 6288.95, "timestamp": "01:44:48", "text": "加菲猫。是的。安德鲁·加菲尔德。"}, {"type": "subtitle", "time": 6291.27, "timestamp": "01:44:51", "text": "有点像安德鲁·加菲尔德。我想"}, {"type": "subtitle", "time": 6292.83, "timestamp": "01:44:52", "text": "让他们看起来像安德鲁"}, {"type": "subtitle", "time": 6294.95, "timestamp": "01:44:54", "text": "加菲猫。是的。 《我的世界》电影是"}, {"type": "subtitle", "time": 6296.79, "timestamp": "01:44:56", "text": "除非我看到杰克·布莱克。我的天哪。"}, {"type": "subtitle", "time": 6299.99, "timestamp": "01:44:59", "text": "那是杰克·布莱克。我当时我真的"}]
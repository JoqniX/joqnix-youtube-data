[{"type": "subtitle", "time": 6783.03, "timestamp": "01:53:03", "text": "不是性方面的，因为我觉得自己像春李"}, {"type": "subtitle", "time": 6786.31, "timestamp": "01:53:06", "text": "似乎太沉迷于这个想法了"}, {"type": "subtitle", "time": 6788.07, "timestamp": "01:53:08", "text": "保护某物。我明白"}, {"type": "subtitle", "time": 6790.55, "timestamp": "01:53:10", "text": "没错，但我不是那种男人"}, {"type": "subtitle", "time": 6793.109, "timestamp": "01:53:13", "text": "需要受到保护。我喜欢那个做"}, {"type": "subtitle", "time": 6794.709, "timestamp": "01:53:14", "text": "保护。我不认为会这样。"}, {"type": "subtitle", "time": 6798.31, "timestamp": "01:53:18", "text": "为我工作。浪漫意义上的。"}, {"type": "subtitle", "time": 6803.03, "timestamp": "01:53:23", "text": "是的。所以，对我来说，不，不，不。对不起。"}, {"type": "subtitle", "time": 6805.07, "timestamp": "01:53:25", "text": "还有谁？"}, {"type": "subtitle", "time": 6807.229, "timestamp": "01:53:27", "text": "就像这样"}, {"type": "subtitle", "time": 6809.91, "timestamp": "01:53:29", "text": "比如，维吉尔呢？风暴"}, {"type": "subtitle", "time": 6811.99, "timestamp": "01:53:31", "text": "暴风雨即将来临。我不是"}, {"type": "chat", "time": 6812.346, "timestamp": "01:53:32", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "Emma Frost?"}, {"type": "subtitle", "time": 6815.43, "timestamp": "01:53:35", "text": "喜欢男生。对不起。我可能每时每刻都表现得像个同性恋"}, {"type": "subtitle", "time": 6817.27, "timestamp": "01:53:37", "text": "偶尔会，但我不是同性恋，伙计们。我是"}, {"type": "subtitle", "time": 6819.229, "timestamp": "01:53:39", "text": "完全地"}, {"type": "subtitle", "time": 6821.99, "timestamp": "01:53:41", "text": "异性。来自艾玛·弗罗斯特"}, {"type": "subtitle", "time": 6823.589, "timestamp": "01:53:43", "text": "漫威劲敌游戏。我不认识她。"}, {"type": "subtitle", "time": 6825.79, "timestamp": "01:53:45", "text": "人格类型。我不玩漫威游戏。"}, {"type": "subtitle", "time": 6830.43, "timestamp": "01:53:50", "text": "对手，我也没见过她像那样。"}, {"type": "subtitle", "time": 6833.43, "timestamp": "01:53:53", "text": "漫画。就漫画而言，我大概会选择"}, {"type": "chat", "time": 6833.592, "timestamp": "01:53:53", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "u mean from X-men"}, {"type": "subtitle", "time": 6838.229, "timestamp": "01:53:58", "text": "就像我现在这样想。我到底该不该这么做？"}, {"type": "subtitle", "time": 6839.87, "timestamp": "01:53:59", "text": "就像来自……的任何人"}]
[{"type": "subtitle", "time": 1321.83, "timestamp": "00:22:01", "text": "那时候，我就直接用了你的PNG图片。"}, {"type": "subtitle", "time": 1323.99, "timestamp": "00:22:03", "text": "还有其他所有我喜欢的人。"}, {"type": "subtitle", "time": 1328.789, "timestamp": "00:22:08", "text": "摆出一副拥有超酷枪支之类的架势。"}, {"type": "subtitle", "time": 1334.07, "timestamp": "00:22:14", "text": "我只是轻柔地摇晃着两台重型机器"}, {"type": "subtitle", "time": 1342.47, "timestamp": "00:22:22", "text": "是的，很久以前了。"}, {"type": "subtitle", "time": 1345.51, "timestamp": "00:22:25", "text": "那就像一款免费游戏，就像"}, {"type": "subtitle", "time": 1349.029, "timestamp": "00:22:29", "text": "发薪日也到了。呃，比如一起持械抢劫案"}, {"type": "subtitle", "time": 1352.31, "timestamp": "00:22:32", "text": "某物。和《发薪日》一样。你有"}, {"type": "subtitle", "time": 1355.029, "timestamp": "00:22:35", "text": "磨蹭，然后惹上警察之类的"}, {"type": "subtitle", "time": 1357.11, "timestamp": "00:22:37", "text": "然后磨武器之类的东西。它是"}, {"type": "subtitle", "time": 1358.87, "timestamp": "00:22:38", "text": "乐趣。是的，我还没玩过任何免费游戏。"}, {"type": "subtitle", "time": 1360.87, "timestamp": "00:22:40", "text": "相对较新的游戏"}, {"type": "subtitle", "time": 1362.71, "timestamp": "00:22:42", "text": "至少是这样，或者类似这样。只是"}, {"type": "subtitle", "time": 1366.31, "timestamp": "00:22:46", "text": "说实话，我不怎么玩电子游戏。"}, {"type": "subtitle", "time": 1369.75, "timestamp": "00:22:49", "text": "不好意思，我放屁了。"}, {"type": "subtitle", "time": 1373.909, "timestamp": "00:22:53", "text": "但是，嗯，你知道的。"}, {"type": "subtitle", "time": 1375.909, "timestamp": "00:22:55", "text": "当你喜欢花太多时间的时候"}, {"type": "subtitle", "time": 1378.549, "timestamp": "00:22:58", "text": "开始玩你喜欢的电子游戏"}]
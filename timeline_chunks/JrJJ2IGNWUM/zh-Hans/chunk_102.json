[{"type": "subtitle", "time": 6121.99, "timestamp": "01:42:01", "text": "他们会如何描绘……"}, {"type": "subtitle", "time": 6125.03, "timestamp": "01:42:05", "text": "女主人和村民"}, {"type": "subtitle", "time": 6127.35, "timestamp": "01:42:07", "text": "看看他们有没有孩子。我想看"}, {"type": "subtitle", "time": 6131.43, "timestamp": "01:42:11", "text": "那件事发生了。嗯。就像真实生活一样"}, {"type": "subtitle", "time": 6133.87, "timestamp": "01:42:13", "text": "女人和 Minecraft"}, {"type": "subtitle", "time": 6136.47, "timestamp": "01:42:16", "text": "村民生孩子了。我想看"}, {"type": "subtitle", "time": 6138.67, "timestamp": "01:42:18", "text": "那看起来是什么样子。"}, {"type": "subtitle", "time": 6140.709, "timestamp": "01:42:20", "text": "[音乐]"}, {"type": "subtitle", "time": 6144.31, "timestamp": "01:42:24", "text": "不过，Jockey，你呢？"}, {"type": "subtitle", "time": 6146.47, "timestamp": "01:42:26", "text": "你对什么感兴趣？如果你是"}, {"type": "subtitle", "time": 6148.31, "timestamp": "01:42:28", "text": "实际上，如何才能拍一部《我的世界》电影呢？"}, {"type": "subtitle", "time": 6150.27, "timestamp": "01:42:30", "text": "你会怎么做？"}, {"type": "subtitle", "time": 6153.51, "timestamp": "01:42:33", "text": "它？就像现实生活中那样？我的意思是，某种东西"}, {"type": "subtitle", "time": 6155.43, "timestamp": "01:42:35", "text": "就像《我的世界》电影那样的"}, {"type": "subtitle", "time": 6160.91, "timestamp": "01:42:40", "text": "那种类型的"}, {"type": "subtitle", "time": 6165.83, "timestamp": "01:42:45", "text": "风格。是的，我认为目前的"}, {"type": "subtitle", "time": 6168.47, "timestamp": "01:42:48", "text": "一部由传奇人物主演的电影，"}, {"type": "subtitle", "time": 6172.31, "timestamp": "01:42:52", "text": "正确的？是的。没错，都是传奇人物。是的，我"}, {"type": "subtitle", "time": 6175.189, "timestamp": "01:42:55", "text": "会是《我的世界：传奇》吗？"}, {"type": "subtitle", "time": 6176.43, "timestamp": "01:42:56", "text": "我会"}, {"type": "subtitle", "time": 6179.629, "timestamp": "01:42:59", "text": "想要它"}]
[{"type": "subtitle", "time": 8420.92, "timestamp": "02:20:20", "text": "去。我回来了。我回来了。去。"}, {"type": "subtitle", "time": 8422.27, "timestamp": "02:20:22", "text": "[音乐]"}, {"type": "subtitle", "time": 8429.51, "timestamp": "02:20:29", "text": "对不起。我应该事先问问的"}, {"type": "subtitle", "time": 8431.51, "timestamp": "02:20:31", "text": "直播是因为我表弟想看。"}, {"type": "subtitle", "time": 8436.63, "timestamp": "02:20:36", "text": "他要出门，而且必须独自一人。"}, {"type": "subtitle", "time": 8439.19, "timestamp": "02:20:39", "text": "我不能像现在这样停止直播。"}, {"type": "subtitle", "time": 8443.03, "timestamp": "02:20:43", "text": "现在对吧？我告诉他我喜欢我"}, {"type": "subtitle", "time": 8445.71, "timestamp": "02:20:45", "text": "多道歉。"}, {"type": "subtitle", "time": 8456.23, "timestamp": "02:20:56", "text": "去。你是不是又得了祖基病？"}, {"type": "subtitle", "time": 8458.11, "timestamp": "02:20:58", "text": "Zuki 开始"}]
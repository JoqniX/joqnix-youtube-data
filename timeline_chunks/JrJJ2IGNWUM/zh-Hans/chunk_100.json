[{"type": "subtitle", "time": 6002.229, "timestamp": "01:40:02", "text": "我还是不明白那些梗。"}, {"type": "subtitle", "time": 6003.59, "timestamp": "01:40:03", "text": "对不起。人们已经向他们解释过了"}, {"type": "subtitle", "time": 6006.31, "timestamp": "01:40:06", "text": "我。我永远也搞不定新的大脑轮转。"}, {"type": "subtitle", "time": 6007.99, "timestamp": "01:40:07", "text": "疯狂的。"}, {"type": "subtitle", "time": 6010.79, "timestamp": "01:40:10", "text": "另一个是什么来着？"}, {"type": "subtitle", "time": 6012.55, "timestamp": "01:40:12", "text": "是的。"}, {"type": "subtitle", "time": 6020.39, "timestamp": "01:40:20", "text": "是那个打蝙蝠的家伙，对吧？那个打棒球的。"}, {"type": "subtitle", "time": 6024.229, "timestamp": "01:40:24", "text": "那个长相怪异的。是的。但"}, {"type": "subtitle", "time": 6026.47, "timestamp": "01:40:26", "text": "是啊，老兄，你可能还没经历过。"}, {"type": "subtitle", "time": 6027.99, "timestamp": "01:40:27", "text": "当时看了《我的世界》电影，但是"}, {"type": "subtitle", "time": 6029.51, "timestamp": "01:40:29", "text": "感觉就像《我的世界》电影"}, {"type": "subtitle", "time": 6032.07, "timestamp": "01:40:32", "text": "这里。哦，我看过了。就像我的世界"}, {"type": "subtitle", "time": 6034.39, "timestamp": "01:40:34", "text": "电影。对不起。一部《我的世界》电影。对不起。"}, {"type": "subtitle", "time": 6038.229, "timestamp": "01:40:38", "text": "不是《我的世界》电影。啊，是啊。"}, {"type": "subtitle", "time": 6040.55, "timestamp": "01:40:40", "text": "因为他们不想让它成为……"}, {"type": "subtitle", "time": 6042.109, "timestamp": "01:40:42", "text": "生成方式"}, {"type": "subtitle", "time": 6045.669, "timestamp": "01:40:45", "text": "这是唯一一部关于《我的世界》的电影，因为"}, {"type": "subtitle", "time": 6047.109, "timestamp": "01:40:47", "text": "重点并非如此。"}, {"type": "subtitle", "time": 6049.03, "timestamp": "01:40:49", "text": "关于。这只是他们对……的诠释。"}, {"type": "subtitle", "time": 6051.99, "timestamp": "01:40:51", "text": "他们认为《我的世界》电影会是……"}, {"type": "subtitle", "time": 6054.39, "timestamp": "01:40:54", "text": "喜欢。这边走。这不是《我的世界》"}, {"type": "subtitle", "time": 6056.83, "timestamp": "01:40:56", "text": "电影，但对我来说，是的。"}]
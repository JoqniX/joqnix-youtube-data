[{"type": "subtitle", "time": 11580.79, "timestamp": "03:13:00", "text": "和这个人？好的，我选奥坎。"}, {"type": "subtitle", "time": 11585.269, "timestamp": "03:13:05", "text": "我忘了我扮演的是谁。"}, {"type": "subtitle", "time": 11590.55, "timestamp": "03:13:10", "text": "你应该试试和他一起玩。他很有趣。"}, {"type": "subtitle", "time": 11616.55, "timestamp": "03:13:36", "text": "是时候跳了。我们身在何处？我们在哪里？"}, {"type": "subtitle", "time": 11629.59, "timestamp": "03:13:49", "text": "哦，他们现在会展示战利品之类的东西了。"}, {"type": "subtitle", "time": 11633.469, "timestamp": "03:13:53", "text": "你能得到什么？他们变化很大。"}, {"type": "subtitle", "time": 11639.59, "timestamp": "03:13:59", "text": "哦，那些是个人武器之类的东西。"}]
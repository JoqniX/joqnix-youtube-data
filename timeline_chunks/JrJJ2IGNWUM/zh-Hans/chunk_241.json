[{"type": "subtitle", "time": 14460.229, "timestamp": "04:01:00", "text": "快点。快点。快点。"}, {"type": "subtitle", "time": 14462.469, "timestamp": "04:01:02", "text": "带上你的男人。带走它们。医疗包"}, {"type": "subtitle", "time": 14464.15, "timestamp": "04:01:04", "text": "这里。"}, {"type": "subtitle", "time": 14474.67, "timestamp": "04:01:14", "text": "我正在充电。离开"}, {"type": "subtitle", "time": 14476.99, "timestamp": "04:01:16", "text": "正确的"}, {"type": "subtitle", "time": 14480.91, "timestamp": "04:01:20", "text": "我的标记上的联系方式是"}, {"type": "subtitle", "time": 14495.51, "timestamp": "04:01:35", "text": "让他复活。"}, {"type": "subtitle", "time": 14498.75, "timestamp": "04:01:38", "text": "我的天啊。"}, {"type": "subtitle", "time": 14502.79, "timestamp": "04:01:42", "text": "复活功能已损坏。重新装弹。"}, {"type": "subtitle", "time": 14505.229, "timestamp": "04:01:45", "text": "呃，推"}, {"type": "subtitle", "time": 14507.0, "timestamp": "04:01:47", "text": "你"}]
[{"type": "subtitle", "time": 5820.629, "timestamp": "01:37:00", "text": "理论太多，心理学类型太多了。"}, {"type": "subtitle", "time": 5823.59, "timestamp": "01:37:03", "text": "是啊，理论太多了。是的。我已经"}, {"type": "subtitle", "time": 5824.95, "timestamp": "01:37:04", "text": "我以前从来没看过这类电影。"}, {"type": "subtitle", "time": 5826.87, "timestamp": "01:37:06", "text": "《盗梦空间》或者那种类型的，我从未"}, {"type": "subtitle", "time": 5829.95, "timestamp": "01:37:09", "text": "见过。我只知道我感觉"}, {"type": "subtitle", "time": 5833.109, "timestamp": "01:37:13", "text": "就像你知道的，在那个场景里"}, {"type": "subtitle", "time": 5837.669, "timestamp": "01:37:17", "text": "就像……就像《复仇者联盟4：终局之战》电影里那样"}, {"type": "subtitle", "time": 5840.55, "timestamp": "01:37:20", "text": "漫威那边就跟“哦，即使”一样。"}, {"type": "subtitle", "time": 5843.51, "timestamp": "01:37:23", "text": "你杀人就像幼年灭霸一样，它不会的。"}, {"type": "subtitle", "time": 5845.189, "timestamp": "01:37:25", "text": "确实改变了时间线，因为它"}, {"type": "subtitle", "time": 5847.95, "timestamp": "01:37:27", "text": "相互抵消，最终成为现实"}, {"type": "subtitle", "time": 5850.95, "timestamp": "01:37:30", "text": "哪里不像是？是的，我明白了。"}, {"type": "subtitle", "time": 5852.55, "timestamp": "01:37:32", "text": "会很烦人，因为它就像"}, {"type": "subtitle", "time": 5854.629, "timestamp": "01:37:34", "text": "它反驳了所有其他理论，而且"}, {"type": "subtitle", "time": 5856.95, "timestamp": "01:37:36", "text": "你必须坚持一种方式才能成功"}, {"type": "subtitle", "time": 5859.109, "timestamp": "01:37:39", "text": "首先，故事本身就比较连贯。是的，我"}, {"type": "subtitle", "time": 5861.109, "timestamp": "01:37:41", "text": "我明白人们为什么会这样"}, {"type": "subtitle", "time": 5864.87, "timestamp": "01:37:44", "text": "我觉得很恶心，但我也不确定。"}, {"type": "subtitle", "time": 5866.79, "timestamp": "01:37:46", "text": "看到新的感觉很有趣"}, {"type": "subtitle", "time": 5869.109, "timestamp": "01:37:49", "text": "关于时间旅行如何运作的观点"}, {"type": "subtitle", "time": 5871.51, "timestamp": "01:37:51", "text": "但如果你已经有了初步的想法呢？"}, {"type": "subtitle", "time": 5873.669, "timestamp": "01:37:53", "text": "关于你认为时间旅行是如何运作的，"}, {"type": "subtitle", "time": 5875.83, "timestamp": "01:37:55", "text": "按你希望的方式运作。我感觉就像你"}, {"type": "subtitle", "time": 5878.07, "timestamp": "01:37:58", "text": "其他理论让我很反感。"}, {"type": "subtitle", "time": 5878.91, "timestamp": "01:37:58", "text": "和"}]
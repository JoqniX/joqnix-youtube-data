[{"type": "subtitle", "time": 16980.788, "timestamp": "04:43:00", "text": "对，那真是完美的两个小时。"}, {"type": "subtitle", "time": 16983.03, "timestamp": "04:43:03", "text": "是的，是的，我们完美地度过了两个小时。"}, {"type": "subtitle", "time": 16985.59, "timestamp": "04:43:05", "text": "寿司唱歌，我觉得这样挺好。"}, {"type": "subtitle", "time": 16988.628, "timestamp": "04:43:08", "text": "我们也正好在2小时内完成了任务。"}, {"type": "subtitle", "time": 16992.948, "timestamp": "04:43:12", "text": "从11点到12点，12点到1点，是的，2个小时。"}, {"type": "subtitle", "time": 16995.07, "timestamp": "04:43:15", "text": "两个小时。两个小时。好的。好的。好的。"}, {"type": "subtitle", "time": 16998.788, "timestamp": "04:43:18", "text": "好的。好的。我也必须这样做。我"}, {"type": "subtitle", "time": 17001.15, "timestamp": "04:43:21", "text": "有"}, {"type": "subtitle", "time": 17005.35, "timestamp": "04:43:25", "text": "嗯，是的。那还有谁？哦，对了，星期六。"}, {"type": "subtitle", "time": 17006.91, "timestamp": "04:43:26", "text": "还有一个人。我"}, {"type": "subtitle", "time": 17011.67, "timestamp": "04:43:31", "text": "忘了。我的天哪，我把她忘了。呃，丹，"}, {"type": "subtitle", "time": 17012.83, "timestamp": "04:43:32", "text": "将会是"}, {"type": "subtitle", "time": 17016.788, "timestamp": "04:43:36", "text": "下午3点开始它。我的天哪，我忘了"}, {"type": "subtitle", "time": 17018.708, "timestamp": "04:43:38", "text": "关于大山。"}, {"type": "subtitle", "time": 17021.35, "timestamp": "04:43:41", "text": "我当时在里面的时候，正打算拿"}, {"type": "subtitle", "time": 17024.788, "timestamp": "04:43:44", "text": "我沿着小路看到了我伸手去够的水坝"}, {"type": "subtitle", "time": 17026.43, "timestamp": "04:43:46", "text": "人们"}, {"type": "subtitle", "time": 17029.72, "timestamp": "04:43:49", "text": "嗯，我当时在联系一些人。"}, {"type": "subtitle", "time": 17031.23, "timestamp": "04:43:51", "text": "[音乐]"}, {"type": "subtitle", "time": 17035.19, "timestamp": "04:43:55", "text": "呃，联系别人，这样我就可以……"}]
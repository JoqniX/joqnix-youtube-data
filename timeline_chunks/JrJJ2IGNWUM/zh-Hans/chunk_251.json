[{"type": "subtitle", "time": 15070.309, "timestamp": "04:11:10", "text": "那个人已经到了。我的天啊。"}, {"type": "subtitle", "time": 15073.67, "timestamp": "04:11:13", "text": "我的天哪。我们应该去那边看看。"}, {"type": "subtitle", "time": 15074.59, "timestamp": "04:11:14", "text": "我们开始吧"}, {"type": "subtitle", "time": 15088.55, "timestamp": "04:11:28", "text": "我里面有个对手。"}, {"type": "subtitle", "time": 15108.469, "timestamp": "04:11:48", "text": "时间。等等，我有没有死亡图腾？"}, {"type": "subtitle", "time": 15111.269, "timestamp": "04:11:51", "text": "亡灵？我忘了那是什么能力了"}, {"type": "subtitle", "time": 15114.55, "timestamp": "04:11:54", "text": "又是《亡灵大战》。盾牌，对吧？"}, {"type": "subtitle", "time": 15117.59, "timestamp": "04:11:57", "text": "他们改了。时候到了。啊，是的。"}]
[{"type": "subtitle", "time": 3900.71, "timestamp": "01:05:00", "text": "正确的？我喜欢，但我不是那种人"}, {"type": "subtitle", "time": 3907.75, "timestamp": "01:05:07", "text": "某物。信不信由你，我有一个"}, {"type": "subtitle", "time": 3908.829, "timestamp": "01:05:08", "text": "不错"}, {"type": "subtitle", "time": 3911.43, "timestamp": "01:05:11", "text": "身体，对吧？我努力保持身材"}, {"type": "subtitle", "time": 3913.829, "timestamp": "01:05:13", "text": "健康。我正在努力控制局面。"}, {"type": "subtitle", "time": 3915.27, "timestamp": "01:05:15", "text": "其实，我体型挺大的"}, {"type": "subtitle", "time": 3918.069, "timestamp": "01:05:18", "text": "现在。我仍然有那种感觉……"}, {"type": "subtitle", "time": 3919.99, "timestamp": "01:05:19", "text": "我拥有的重量。如果你有五分，我愿意给你。"}, {"type": "subtitle", "time": 3921.829, "timestamp": "01:05:21", "text": "坚持，稍等。我把它放在桌子上。"}, {"type": "subtitle", "time": 3924.069, "timestamp": "01:05:24", "text": "是的，如果你能听到的话。我有一个5公斤的"}, {"type": "subtitle", "time": 3926.309, "timestamp": "01:05:26", "text": "我现在手里拿着哑铃。"}, {"type": "subtitle", "time": 3928.549, "timestamp": "01:05:28", "text": "其实我喜欢一边和别人说话一边做这件事"}, {"type": "subtitle", "time": 3931.67, "timestamp": "01:05:31", "text": "你，骑师。你们听不到，但是"}, {"type": "subtitle", "time": 3934.15, "timestamp": "01:05:34", "text": "但我是在说话的同时做的。你"}, {"type": "subtitle", "time": 3935.829, "timestamp": "01:05:35", "text": "知道，边做边锻炼"}, {"type": "subtitle", "time": 3938.789, "timestamp": "01:05:38", "text": "某物。更喜欢"}, {"type": "subtitle", "time": 3941.109, "timestamp": "01:05:41", "text": "整个事情，你知道吗？是的。有"}, {"type": "subtitle", "time": 3943.19, "timestamp": "01:05:43", "text": "背面隐藏着一把光剑。不，"}, {"type": "subtitle", "time": 3945.589, "timestamp": "01:05:45", "text": "老兄。我不会像个混蛋一样待着。"}, {"type": "subtitle", "time": 3948.309, "timestamp": "01:05:48", "text": "我冰箱里放着一瓶蓝色的百事可乐。"}, {"type": "subtitle", "time": 3950.309, "timestamp": "01:05:50", "text": "大概过了两年我才开始享受它"}, {"type": "subtitle", "time": 3953.01, "timestamp": "01:05:53", "text": "再次。那件事不会发生。"}, {"type": "subtitle", "time": 3955.029, "timestamp": "01:05:55", "text": "[音乐]"}, {"type": "subtitle", "time": 3957.51, "timestamp": "01:05:57", "text": "比如，你是那种会放任这种事情发生的人吗？"}, {"type": "subtitle", "time": 3959.51, "timestamp": "01:05:59", "text": "放在冰箱里会变质吗？"}]
[{"type": "subtitle", "time": 5460.79, "timestamp": "01:31:00", "text": "还没完全投入进去。但这就是我"}, {"type": "subtitle", "time": 5463.59, "timestamp": "01:31:03", "text": "可以根据这几章的内容来判断。"}, {"type": "subtitle", "time": 5465.43, "timestamp": "01:31:05", "text": "我读过了。"}, {"type": "subtitle", "time": 5466.629, "timestamp": "01:31:06", "text": "[音乐]"}, {"type": "subtitle", "time": 5468.629, "timestamp": "01:31:08", "text": "但没错，她就像个女孩。"}, {"type": "subtitle", "time": 5472.51, "timestamp": "01:31:12", "text": "感觉她在每个人眼里都超级古怪。"}, {"type": "subtitle", "time": 5476.07, "timestamp": "01:31:16", "text": "眼睛，但她已经尽力做到最真实的自己了。"}, {"type": "subtitle", "time": 5479.83, "timestamp": "01:31:19", "text": "因为在她眼里，她就是她自己。和"}, {"type": "subtitle", "time": 5482.39, "timestamp": "01:31:22", "text": "有些人就是喜欢叙述故事。"}, {"type": "subtitle", "time": 5484.07, "timestamp": "01:31:24", "text": "所以，这里就存在一种主角类型。"}, {"type": "subtitle", "time": 5485.99, "timestamp": "01:31:25", "text": "兄弟，那只是在叙述事情经过。"}, {"type": "subtitle", "time": 5487.709, "timestamp": "01:31:27", "text": "正在发生什么，周围发生了什么事"}, {"type": "subtitle", "time": 5491.03, "timestamp": "01:31:31", "text": "学校，人们对什么的反应"}, {"type": "subtitle", "time": 5493.669, "timestamp": "01:31:33", "text": "星女以及她为何像某种……"}, {"type": "subtitle", "time": 5497.11, "timestamp": "01:31:37", "text": "她之所以成为名人，是因为她太古怪、太另类了。"}, {"type": "subtitle", "time": 5500.629, "timestamp": "01:31:40", "text": "感觉就是这样，而且感觉"}, {"type": "subtitle", "time": 5503.189, "timestamp": "01:31:43", "text": "就像……"}, {"type": "subtitle", "time": 5505.43, "timestamp": "01:31:45", "text": "呃，解释忠于……的想法"}, {"type": "subtitle", "time": 5507.83, "timestamp": "01:31:47", "text": "你自己。但我不知道也许"}, {"type": "subtitle", "time": 5509.75, "timestamp": "01:31:49", "text": "情况将会发生巨大变化。我会……我会保留"}, {"type": "subtitle", "time": 5512.47, "timestamp": "01:31:52", "text": "阅读。看看我的想法。我献上我的"}, {"type": "subtitle", "time": 5514.39, "timestamp": "01:31:54", "text": "以后再说吧，不过现在这样也行。"}, {"type": "subtitle", "time": 5516.229, "timestamp": "01:31:56", "text": "还不够。我读的书还不够多。"}, {"type": "subtitle", "time": 5519.669, "timestamp": "01:31:59", "text": "告诉你它主要讲的是什么。"}]
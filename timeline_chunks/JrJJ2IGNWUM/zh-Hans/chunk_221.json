[{"type": "subtitle", "time": 13267.11, "timestamp": "03:41:07", "text": "出现了一个新的杀手。收割机现在"}, {"type": "subtitle", "time": 13277.269, "timestamp": "03:41:17", "text": "另外，就像充能步枪是自动向右射击一样。"}, {"type": "subtitle", "time": 13289.15, "timestamp": "03:41:29", "text": "我有一个料斗，"}, {"type": "subtitle", "time": 13293.389, "timestamp": "03:41:33", "text": "比如可以用于充电"}, {"type": "subtitle", "time": 13301.309, "timestamp": "03:41:41", "text": "僚机。僚机"}, {"type": "subtitle", "time": 13305.91, "timestamp": "03:41:45", "text": "就是现在。它坏了"}]
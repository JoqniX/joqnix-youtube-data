[{"type": "subtitle", "time": 540.79, "timestamp": "00:09:00", "text": "就像出去玩一样。所以，情况就是这样。"}, {"type": "subtitle", "time": 542.31, "timestamp": "00:09:02", "text": "为什么我会喜欢上美国口音"}, {"type": "subtitle", "time": 544.71, "timestamp": "00:09:04", "text": "即使我连0%都算不上，"}, {"type": "subtitle", "time": 547.949, "timestamp": "00:09:07", "text": "美国人，老兄。我没有白血病"}, {"type": "subtitle", "time": 553.11, "timestamp": "00:09:13", "text": "我。我身上只有菲律宾血统。"}, {"type": "subtitle", "time": 554.949, "timestamp": "00:09:14", "text": "菲律宾血统，还有一点中国血统。"}, {"type": "subtitle", "time": 558.07, "timestamp": "00:09:18", "text": "就是这样。"}, {"type": "subtitle", "time": 561.269, "timestamp": "00:09:21", "text": "嗯，明白了。"}, {"type": "subtitle", "time": 563.75, "timestamp": "00:09:23", "text": "嗯，他们表示没问题。"}, {"type": "subtitle", "time": 566.07, "timestamp": "00:09:26", "text": "那。他们就像在问你：你在做什么？"}, {"type": "subtitle", "time": 568.47, "timestamp": "00:09:28", "text": "你想把某件事做好"}, {"type": "subtitle", "time": 570.47, "timestamp": "00:09:30", "text": "你第一次去，他们就相当"}, {"type": "subtitle", "time": 573.11, "timestamp": "00:09:33", "text": "很高兴我做了这个选择"}, {"type": "subtitle", "time": 575.75, "timestamp": "00:09:35", "text": "呃，我这么做了，他们也问为什么。"}, {"type": "subtitle", "time": 578.55, "timestamp": "00:09:38", "text": "你之前不是来告诉我们这件事的吗？"}, {"type": "subtitle", "time": 580.87, "timestamp": "00:09:40", "text": "既然你有时间，为什么浪费时间呢？"}, {"type": "subtitle", "time": 584.55, "timestamp": "00:09:44", "text": "你给了我很多次时间，所以是的，我是"}, {"type": "subtitle", "time": 586.389, "timestamp": "00:09:46", "text": "我也犯过同样的错误，但确实就是这样。"}, {"type": "subtitle", "time": 589.829, "timestamp": "00:09:49", "text": "突然冒出一个念头：是啊，我不应该……"}, {"type": "subtitle", "time": 593.59, "timestamp": "00:09:53", "text": "不敢问，我只会自信。"}, {"type": "subtitle", "time": 596.23, "timestamp": "00:09:56", "text": "兄弟，我以前也这样，因为……"}, {"type": "subtitle", "time": 598.71, "timestamp": "00:09:58", "text": "有趣的故事。我当时的情况和他们一样。"}]
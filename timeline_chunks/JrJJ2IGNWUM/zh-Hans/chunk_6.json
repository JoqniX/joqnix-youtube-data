[{"type": "subtitle", "time": 363.43, "timestamp": "00:06:03", "text": "工作或其他任何事情。我确实尝试过这样做"}, {"type": "subtitle", "time": 366.15, "timestamp": "00:06:06", "text": "嗯，英语文学学位"}, {"type": "subtitle", "time": 369.27, "timestamp": "00:06:09", "text": "东西。嗯，是的，我仍然是第三名。"}, {"type": "subtitle", "time": 373.35, "timestamp": "00:06:13", "text": "一年，但是，呃，我当时就想，我不想"}, {"type": "subtitle", "time": 376.309, "timestamp": "00:06:16", "text": "能来到这里，来到印度。这太难了，我"}, {"type": "subtitle", "time": 378.71, "timestamp": "00:06:18", "text": "我想做点什么"}, {"type": "subtitle", "time": 381.189, "timestamp": "00:06:21", "text": "我真心喜欢它之类的。"}, {"type": "subtitle", "time": 383.27, "timestamp": "00:06:23", "text": "然后我就想，“是啊，说真的，什么？”"}, {"type": "subtitle", "time": 386.95, "timestamp": "00:06:26", "text": "如果我像我一样问我的父母，我会喜欢"}, {"type": "subtitle", "time": 389.99, "timestamp": "00:06:29", "text": "我想，这完全符合我的预期。"}, {"type": "subtitle", "time": 391.99, "timestamp": "00:06:31", "text": "或许我为什么不去日本呢？"}, {"type": "subtitle", "time": 395.27, "timestamp": "00:06:35", "text": "某物？也许我可以尽力去试试。”"}, {"type": "subtitle", "time": 397.27, "timestamp": "00:06:37", "text": "我好像看过一些人的视频"}, {"type": "subtitle", "time": 400.15, "timestamp": "00:06:40", "text": "就像搬到一座新城市一样"}, {"type": "subtitle", "time": 403.029, "timestamp": "00:06:43", "text": "就像一切重新开始一样。"}, {"type": "subtitle", "time": 405.35, "timestamp": "00:06:45", "text": "是的。是的。从零开始"}, {"type": "subtitle", "time": 407.029, "timestamp": "00:06:47", "text": "他们重新找回了生活，或者"}, {"type": "subtitle", "time": 409.11, "timestamp": "00:06:49", "text": "差不多就是这样。所以我就想，嗯，"}, {"type": "subtitle", "time": 411.51, "timestamp": "00:06:51", "text": "或许我也可以这么做。但我更"}, {"type": "subtitle", "time": 413.749, "timestamp": "00:06:53", "text": "一个与世隔绝、总是待在温室里的人"}, {"type": "subtitle", "time": 415.83, "timestamp": "00:06:55", "text": "我的房间之类的东西。所以我就想，"}, {"type": "subtitle", "time": 417.43, "timestamp": "00:06:57", "text": "是的，这将是一次很好的经历。"}]
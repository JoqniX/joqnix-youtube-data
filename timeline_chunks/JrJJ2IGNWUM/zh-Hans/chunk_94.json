[{"type": "subtitle", "time": 5641.91, "timestamp": "01:34:01", "text": "很糟糕，但你认为这其实"}, {"type": "subtitle", "time": 5649.83, "timestamp": "01:34:09", "text": "必须像大家认为的那样。"}, {"type": "subtitle", "time": 5651.81, "timestamp": "01:34:11", "text": "坏的。"}, {"type": "subtitle", "time": 5653.51, "timestamp": "01:34:13", "text": "[音乐]"}, {"type": "subtitle", "time": 5660.149, "timestamp": "01:34:20", "text": "它不一定非得像书一样。"}, {"type": "subtitle", "time": 5663.709, "timestamp": "01:34:23", "text": "它可以是任何东西。任何形式的"}, {"type": "subtitle", "time": 5666.47, "timestamp": "01:34:26", "text": "媒体。哦。"}, {"type": "subtitle", "time": 5674.31, "timestamp": "01:34:34", "text": "你明白轻小说是怎么回事了吧？"}, {"type": "subtitle", "time": 5677.99, "timestamp": "01:34:37", "text": "是的。是的。他们大多数都像超级英雄一样。"}, {"type": "subtitle", "time": 5679.91, "timestamp": "01:34:39", "text": "陈词滥调。他们其实并没有真正远离。"}, {"type": "subtitle", "time": 5681.91, "timestamp": "01:34:41", "text": "由公式得出。它们就像是添加一样"}, {"type": "subtitle", "time": 5683.99, "timestamp": "01:34:43", "text": "这里有点小伤害，一点点"}, {"type": "subtitle", "time": 5686.31, "timestamp": "01:34:46", "text": "那简直是权力游戏。"}, {"type": "subtitle", "time": 5689.99, "timestamp": "01:34:49", "text": "就像，是啊，很多人"}, {"type": "subtitle", "time": 5693.11, "timestamp": "01:34:53", "text": "来自动漫社区之类的"}, {"type": "subtitle", "time": 5694.709, "timestamp": "01:34:54", "text": "真的很讨厌他们，因为他们不"}, {"type": "subtitle", "time": 5696.91, "timestamp": "01:34:56", "text": "偏离既定模式，它就会……"}, {"type": "subtitle", "time": 5699.55, "timestamp": "01:34:59", "text": "就像这样"}]
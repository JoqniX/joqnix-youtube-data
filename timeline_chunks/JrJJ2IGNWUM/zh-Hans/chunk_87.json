[{"type": "subtitle", "time": 5220.79, "timestamp": "01:27:00", "text": "它。但说话，其实不是真正意义上的说话"}, {"type": "subtitle", "time": 5222.79, "timestamp": "01:27:02", "text": "大声说出来。是的，这可以理解。"}, {"type": "subtitle", "time": 5224.39, "timestamp": "01:27:04", "text": "老兄。"}, {"type": "subtitle", "time": 5226.87, "timestamp": "01:27:06", "text": "但至少你现在明白了。我是"}, {"type": "subtitle", "time": 5229.03, "timestamp": "01:27:09", "text": "嫉妒你居然能看懂这些东西"}, {"type": "subtitle", "time": 5232.55, "timestamp": "01:27:12", "text": "现在。是啊，我真希望自己会日语。"}, {"type": "subtitle", "time": 5233.91, "timestamp": "01:27:13", "text": "所以我不用等别人"}, {"type": "subtitle", "time": 5236.629, "timestamp": "01:27:16", "text": "他妈的帮我翻译一下。而我是"}, {"type": "subtitle", "time": 5238.79, "timestamp": "01:27:18", "text": "不是那种类型。事情就是这样，对吧？我"}, {"type": "subtitle", "time": 5242.189, "timestamp": "01:27:22", "text": "我喜欢人们制作"}, {"type": "subtitle", "time": 5244.07, "timestamp": "01:27:24", "text": "翻译。好的，这是一个热门话题"}, {"type": "subtitle", "time": 5245.149, "timestamp": "01:27:25", "text": "拿，"}, {"type": "subtitle", "time": 5249.709, "timestamp": "01:27:29", "text": "但我认为人工智能翻译是"}, {"type": "subtitle", "time": 5252.709, "timestamp": "01:27:32", "text": "好的。是我太敏感了吗？还是像 Cuz 那样？"}, {"type": "subtitle", "time": 5254.629, "timestamp": "01:27:34", "text": "有时候当你……呃"}, {"type": "subtitle", "time": 5256.31, "timestamp": "01:27:36", "text": "有人好好点个赞吧"}, {"type": "subtitle", "time": 5258.39, "timestamp": "01:27:38", "text": "翻译不太恰当，"}, {"type": "subtitle", "time": 5261.35, "timestamp": "01:27:41", "text": "它已进行本地化以适应特殊情况。"}, {"type": "subtitle", "time": 5264.31, "timestamp": "01:27:44", "text": "类似漫画之类的东西。所以，就是这样。"}, {"type": "subtitle", "time": 5267.59, "timestamp": "01:27:47", "text": "比如漫画或漫画书之类的。什么"}, {"type": "subtitle", "time": 5268.95, "timestamp": "01:27:48", "text": "您对本地化有什么看法？"}, {"type": "subtitle", "time": 5270.55, "timestamp": "01:27:50", "text": "骑师？"}, {"type": "subtitle", "time": 5272.31, "timestamp": "01:27:52", "text": "本土化。"}, {"type": "subtitle", "time": 5275.43, "timestamp": "01:27:55", "text": "是的，本地化需要专人来完成。"}, {"type": "subtitle", "time": 5278.229, "timestamp": "01:27:58", "text": "更好一些。我觉得不会。"}]
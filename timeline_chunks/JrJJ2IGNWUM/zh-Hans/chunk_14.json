[{"type": "subtitle", "time": 842.79, "timestamp": "00:14:02", "text": "太过分了，他们把那个人当成了恶习。"}, {"type": "subtitle", "time": 844.389, "timestamp": "00:14:04", "text": "校长什么的，她就是那个人。"}, {"type": "subtitle", "time": 846.31, "timestamp": "00:14:06", "text": "谁说“是啊，那太多了”？"}, {"type": "subtitle", "time": 848.87, "timestamp": "00:14:08", "text": "理论上，既然你是，你就有"}, {"type": "subtitle", "time": 852.23, "timestamp": "00:14:12", "text": "不会，呃，即使这样也会太多……"}, {"type": "subtitle", "time": 854.55, "timestamp": "00:14:14", "text": "即使我多么优秀，我"}, {"type": "subtitle", "time": 857.35, "timestamp": "00:14:17", "text": "我在电脑前，这太多了。"}, {"type": "subtitle", "time": 859.59, "timestamp": "00:14:19", "text": "理论上的，我不喜欢。"}, {"type": "subtitle", "time": 862.31, "timestamp": "00:14:22", "text": "理论上的东西，所以就是这样。是的，你。"}, {"type": "subtitle", "time": 864.31, "timestamp": "00:14:24", "text": "例如实际工作。你喜欢这样"}, {"type": "subtitle", "time": 866.55, "timestamp": "00:14:26", "text": "亲自动手。"}, {"type": "subtitle", "time": 870.23, "timestamp": "00:14:30", "text": "是的。是的，我明白了。然后我就想"}, {"type": "subtitle", "time": 872.629, "timestamp": "00:14:32", "text": "大众传播会有点……呃……"}, {"type": "subtitle", "time": 875.11, "timestamp": "00:14:35", "text": "我觉得我不需要。我当时就想……"}, {"type": "subtitle", "time": 877.269, "timestamp": "00:14:37", "text": "暂时搁置了这件事。我当时就像……"}, {"type": "subtitle", "time": 879.35, "timestamp": "00:14:39", "text": "不想做。我一直回到"}, {"type": "subtitle", "time": 882.23, "timestamp": "00:14:42", "text": "就像在房间里做自己的事一样"}, {"type": "subtitle", "time": 884.71, "timestamp": "00:14:44", "text": "喜欢玩游戏之类的。我觉得我"}, {"type": "subtitle", "time": 886.79, "timestamp": "00:14:46", "text": "是啊，那次我在玩水上滑板。"}, {"type": "subtitle", "time": 889.67, "timestamp": "00:14:49", "text": "除了开始吃饭之外，其他一切都开始了"}, {"type": "subtitle", "time": 892.47, "timestamp": "00:14:52", "text": "一切。我当时专注于那件事。只是"}, {"type": "subtitle", "time": 895.269, "timestamp": "00:14:55", "text": "浪费时间跟朋友聊天"}, {"type": "subtitle", "time": 897.11, "timestamp": "00:14:57", "text": "天。是啊，这就是梦想，兄弟。"}]
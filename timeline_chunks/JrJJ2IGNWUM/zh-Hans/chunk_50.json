[{"type": "subtitle", "time": 3001.19, "timestamp": "00:50:01", "text": "还没有吗？是的。但这感觉就像拥有"}, {"type": "subtitle", "time": 3003.349, "timestamp": "00:50:03", "text": "就像烤过的咖啡豆一样"}, {"type": "subtitle", "time": 3005.99, "timestamp": "00:50:05", "text": "磨碎后直接用……冲泡"}, {"type": "subtitle", "time": 3007.67, "timestamp": "00:50:07", "text": "咖啡机其实味道很差"}, {"type": "subtitle", "time": 3010.39, "timestamp": "00:50:10", "text": "与速溶咖啡不同。它是"}, {"type": "subtitle", "time": 3013.109, "timestamp": "00:50:13", "text": "截然不同。是的。就像它曾经那样"}, {"type": "subtitle", "time": 3015.91, "timestamp": "00:50:15", "text": "味道层次丰富，非常微妙。正确的。我"}, {"type": "subtitle", "time": 3018.069, "timestamp": "00:50:18", "text": "我不煮咖啡，所以我不在乎。我 你"}, {"type": "subtitle", "time": 3020.069, "timestamp": "00:50:20", "text": "别等了，你们在干什么？你们在干什么？"}, {"type": "subtitle", "time": 3024.95, "timestamp": "00:50:24", "text": "平时喝什么？因为好吧。我不是茶。"}, {"type": "subtitle", "time": 3028.23, "timestamp": "00:50:28", "text": "哦，你喜欢红茶？是的。咖啡。我"}, {"type": "subtitle", "time": 3030.71, "timestamp": "00:50:30", "text": "我把它放在外面，当我……"}, {"type": "subtitle", "time": 3033.589, "timestamp": "00:50:33", "text": "外部。水。水。公平的。我仍然"}, {"type": "subtitle", "time": 3036.069, "timestamp": "00:50:36", "text": "就像我有一个巨大的……如果你"}, {"type": "subtitle", "time": 3038.23, "timestamp": "00:50:38", "text": "大家都能听到，我有一个巨大的"}, {"type": "subtitle", "time": 3041.27, "timestamp": "00:50:41", "text": "我旁边就有一壶2.5升的水。"}, {"type": "subtitle", "time": 3044.549, "timestamp": "00:50:44", "text": "我用这个喝水。我喜欢水。是的，"}, {"type": "subtitle", "time": 3047.109, "timestamp": "00:50:47", "text": "有时候你需要咖啡因提神。"}, {"type": "subtitle", "time": 3049.03, "timestamp": "00:50:49", "text": "兄弟，每次我去大学的时候，对吧，"}, {"type": "subtitle", "time": 3051.79, "timestamp": "00:50:51", "text": "无论我去哪上大学，我都会喜欢"}, {"type": "subtitle", "time": 3054.71, "timestamp": "00:50:54", "text": "买一瓶能量饮料。我们有两个"}, {"type": "subtitle", "time": 3056.309, "timestamp": "00:50:56", "text": "这里有很多便宜的能量饮料。"}, {"type": "subtitle", "time": 3058.95, "timestamp": "00:50:58", "text": "菲律宾。要么是眼镜蛇，要么是……"}]
[{"type": "subtitle", "time": 660.47, "timestamp": "00:11:00", "text": "主要是一名英语老师"}, {"type": "subtitle", "time": 662.79, "timestamp": "00:11:02", "text": "主修英语。但是，是的，我"}, {"type": "subtitle", "time": 665.269, "timestamp": "00:11:05", "text": "我当时在船上，感觉就像……"}, {"type": "subtitle", "time": 667.67, "timestamp": "00:11:07", "text": "太棒了，我为此感到自豪。我不"}, {"type": "subtitle", "time": 669.269, "timestamp": "00:11:09", "text": "甚至不知道我当时为什么会为那些事感到自豪。"}, {"type": "subtitle", "time": 672.31, "timestamp": "00:11:12", "text": "就像我朋友一样，我什么也没做。"}, {"type": "subtitle", "time": 676.63, "timestamp": "00:11:16", "text": "感觉就像我几乎没洗澡一样。我的天啊。"}, {"type": "subtitle", "time": 678.87, "timestamp": "00:11:18", "text": "好像情况真的那么糟糕似的。我所做的一切"}, {"type": "subtitle", "time": 682.069, "timestamp": "00:11:22", "text": "一整天就像起床一样"}, {"type": "subtitle", "time": 684.47, "timestamp": "00:11:24", "text": "我的床，把我的手机从床上拿出来，就像"}, {"type": "subtitle", "time": 686.23, "timestamp": "00:11:26", "text": "充电大概几个小时后"}, {"type": "subtitle", "time": 688.79, "timestamp": "00:11:28", "text": "就玩玩“你听说过托拉姆吗？”这种游戏吧"}, {"type": "subtitle", "time": 692.63, "timestamp": "00:11:32", "text": "在线的？是的。是的。我玩到我"}, {"type": "subtitle", "time": 694.71, "timestamp": "00:11:34", "text": "我觉得大概达到了150次。"}, {"type": "subtitle", "time": 697.91, "timestamp": "00:11:37", "text": "当时的水平上限。我简直太……"}, {"type": "subtitle", "time": 699.99, "timestamp": "00:11:39", "text": "之后我就没再玩了，我只是"}, {"type": "subtitle", "time": 702.79, "timestamp": "00:11:42", "text": "之后我开始喜欢做YouTube。"}, {"type": "subtitle", "time": 705.03, "timestamp": "00:11:45", "text": "我们搬到了像城市一样的地方"}, {"type": "subtitle", "time": 707.59, "timestamp": "00:11:47", "text": "菲律宾的中心。所以就是这样。"}, {"type": "subtitle", "time": 709.91, "timestamp": "00:11:49", "text": "确实有那件事，我被迫喜欢"}, {"type": "subtitle", "time": 712.389, "timestamp": "00:11:52", "text": "感觉自己好像没有朋友似的。"}, {"type": "subtitle", "time": 715.509, "timestamp": "00:11:55", "text": "这里。呃，我不知道我在哪里。我"}, {"type": "subtitle", "time": 717.43, "timestamp": "00:11:57", "text": "我不会那样做。"}, {"type": "subtitle", "time": 718.949, "timestamp": "00:11:58", "text": "如果我只是待在这里的话，那会怎么样呢？"}]
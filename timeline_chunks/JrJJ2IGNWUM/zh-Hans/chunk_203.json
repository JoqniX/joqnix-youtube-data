[{"type": "subtitle", "time": 12182.71, "timestamp": "03:23:02", "text": "好消息。哦，是我拍的。好的。停留"}, {"type": "subtitle", "time": 12185.51, "timestamp": "03:23:05", "text": "这里。嗯？他们不应该放弃。"}, {"type": "subtitle", "time": 12218.309, "timestamp": "03:23:38", "text": "对，就在这边。这家伙不在我们这边"}, {"type": "subtitle", "time": 12228.269, "timestamp": "03:23:48", "text": "他们"}]
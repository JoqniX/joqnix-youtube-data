[{"type": "subtitle", "time": 5521.189, "timestamp": "01:32:01", "text": "是的。是的。我希望自己能读更多书。"}, {"type": "subtitle", "time": 5522.709, "timestamp": "01:32:02", "text": "那你呢，杰基？什么"}, {"type": "subtitle", "time": 5525.189, "timestamp": "01:32:05", "text": "你有什么暂缓执行的计划吗？我想"}, {"type": "subtitle", "time": 5528.43, "timestamp": "01:32:08", "text": "读起来就像那些"}, {"type": "subtitle", "time": 5531.83, "timestamp": "01:32:11", "text": "嗯，我觉得现在是时候轮到我了。"}, {"type": "subtitle", "time": 5533.83, "timestamp": "01:32:13", "text": "了解生活和一切事物。所以"}, {"type": "subtitle", "time": 5536.27, "timestamp": "01:32:16", "text": "我好像不太看这类书。"}, {"type": "subtitle", "time": 5539.27, "timestamp": "01:32:19", "text": "自助书籍或其他类似的东西"}, {"type": "subtitle", "time": 5541.31, "timestamp": "01:32:21", "text": "理解"}, {"type": "subtitle", "time": 5544.79, "timestamp": "01:32:24", "text": "人们如何写作以及喜欢他们如何写作"}, {"type": "subtitle", "time": 5547.35, "timestamp": "01:32:27", "text": "他们的经历以及所有这些东西，"}, {"type": "subtitle", "time": 5548.91, "timestamp": "01:32:28", "text": "正确的？"}, {"type": "subtitle", "time": 5553.59, "timestamp": "01:32:33", "text": "啊，我见过一些，我不介意。"}, {"type": "subtitle", "time": 5555.59, "timestamp": "01:32:35", "text": "读些轻小说之类的"}, {"type": "subtitle", "time": 5557.51, "timestamp": "01:32:37", "text": "只是为了那些奇幻的东西。哦，是的。"}, {"type": "subtitle", "time": 5560.229, "timestamp": "01:32:40", "text": "光。是的。获得那种满足感"}, {"type": "subtitle", "time": 5562.87, "timestamp": "01:32:42", "text": "你知道，就是幻想题材吧？即使是我也不得不"}, {"type": "subtitle", "time": 5566.55, "timestamp": "01:32:46", "text": "就像你一样，我还在等呢。"}, {"type": "subtitle", "time": 5568.99, "timestamp": "01:32:48", "text": "下一章就像"}, {"type": "subtitle", "time": 5573.75, "timestamp": "01:32:53", "text": "呃呃，欢迎来到恶魔学校，还有……"}, {"type": "subtitle", "time": 5576.79, "timestamp": "01:32:56", "text": "是的。是的。还有 Web Tune 上的 Unordinary。"}, {"type": "subtitle", "time": 5578.31, "timestamp": "01:32:58", "text": "我还在等那些东西到货。"}]
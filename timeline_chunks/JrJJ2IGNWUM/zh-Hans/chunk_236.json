[{"type": "subtitle", "time": 14161.99, "timestamp": "03:56:01", "text": "我敢打赌我肯定能做到。嗯，如果……请告诉我。"}, {"type": "subtitle", "time": 14163.469, "timestamp": "03:56:03", "text": "你是自由的"}, {"type": "subtitle", "time": 14167.03, "timestamp": "03:56:07", "text": "六月。我只剩下两周时间了。所以，让我们"}, {"type": "subtitle", "time": 14169.11, "timestamp": "03:56:09", "text": "告诉我你六月份什么时候有空。出色地"}, {"type": "subtitle", "time": 14172.03, "timestamp": "03:56:12", "text": "最多做1个小时。一到两个小时"}, {"type": "subtitle", "time": 14175.429, "timestamp": "03:56:15", "text": "最大限度。我目前正在尝试……"}, {"type": "subtitle", "time": 14178.469, "timestamp": "03:56:18", "text": "一天之内完成多个合作项目。"}, {"type": "subtitle", "time": 14181.11, "timestamp": "03:56:21", "text": "就像一个人一小时，一个"}, {"type": "subtitle", "time": 14183.269, "timestamp": "03:56:23", "text": "像那样花一个小时去见另一个人。 1"}, {"type": "subtitle", "time": 14185.99, "timestamp": "03:56:25", "text": "就这样，一个小时，两个小时。我们将暂停"}, {"type": "subtitle", "time": 14188.229, "timestamp": "03:56:28", "text": "这"}, {"type": "subtitle", "time": 14191.99, "timestamp": "03:56:31", "text": "你好。啊，欢迎回来。"}, {"type": "subtitle", "time": 14194.63, "timestamp": "03:56:34", "text": "谢谢。"}, {"type": "subtitle", "time": 14197.7, "timestamp": "03:56:37", "text": "欢迎回来。"}, {"type": "subtitle", "time": 14215.67, "timestamp": "03:56:55", "text": "是的。你吃晚饭了吗？好的。"}, {"type": "subtitle", "time": 14218.67, "timestamp": "03:56:58", "text": "我确实喜欢"}]
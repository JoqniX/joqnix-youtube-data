[{"type": "subtitle", "time": 5163.709, "timestamp": "01:26:03", "text": "是的。呃，帕特，他是澳大利亚人。"}, {"type": "subtitle", "time": 5166.149, "timestamp": "01:26:06", "text": "YouTuber 竟然只喝咖啡就为了"}, {"type": "subtitle", "time": 5168.149, "timestamp": "01:26:08", "text": "看完之后打哈欠？老婆是"}, {"type": "subtitle", "time": 5170.229, "timestamp": "01:26:10", "text": "基本上也是那样。因为每当"}, {"type": "subtitle", "time": 5173.629, "timestamp": "01:26:13", "text": "老婆喝咖啡，她要去"}, {"type": "subtitle", "time": 5176.07, "timestamp": "01:26:16", "text": "睡觉。她其实并没有醒来"}, {"type": "subtitle", "time": 5178.31, "timestamp": "01:26:18", "text": "咖啡。对她来说，这就像是安眠药一样。"}, {"type": "subtitle", "time": 5179.91, "timestamp": "01:26:19", "text": "所以，这真的太他妈奇怪了。"}, {"type": "subtitle", "time": 5181.83, "timestamp": "01:26:21", "text": "我。但话说回来，她当时已经"}, {"type": "subtitle", "time": 5184.07, "timestamp": "01:26:24", "text": "学习日语。啊，这就是我的原因……"}, {"type": "subtitle", "time": 5185.83, "timestamp": "01:26:25", "text": "我从未真正学过日语，也没有"}, {"type": "subtitle", "time": 5187.51, "timestamp": "01:26:27", "text": "我学过其他任何正规语言。"}, {"type": "subtitle", "time": 5189.669, "timestamp": "01:26:29", "text": "除了菲律宾语和英语之外，还有其他语言吗？"}, {"type": "subtitle", "time": 5191.43, "timestamp": "01:26:31", "text": "或许还会一点西班牙语，甚至"}, {"type": "subtitle", "time": 5193.95, "timestamp": "01:26:33", "text": "虽然我完全错了"}, {"type": "subtitle", "time": 5196.629, "timestamp": "01:26:36", "text": "西班牙语。是啊，我听不懂"}, {"type": "subtitle", "time": 5197.99, "timestamp": "01:26:37", "text": "除了这两种语言之外，还有其他不同的语言。"}, {"type": "subtitle", "time": 5199.669, "timestamp": "01:26:39", "text": "那些我真正知道我是"}, {"type": "subtitle", "time": 5203.11, "timestamp": "01:26:43", "text": "还不错，不太好"}, {"type": "subtitle", "time": 5205.43, "timestamp": "01:26:45", "text": "对话是这个词"}, {"type": "subtitle", "time": 5207.43, "timestamp": "01:26:47", "text": "我在找。"}, {"type": "subtitle", "time": 5213.75, "timestamp": "01:26:53", "text": "是的。我很高兴你能说话。"}, {"type": "subtitle", "time": 5215.669, "timestamp": "01:26:55", "text": "现在是日本人了，骑师。你能够"}, {"type": "subtitle", "time": 5218.39, "timestamp": "01:26:58", "text": "搞懂这玩意儿。是的，我能理解"}]
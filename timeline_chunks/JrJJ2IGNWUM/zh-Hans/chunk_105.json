[{"type": "subtitle", "time": 6302.709, "timestamp": "01:45:02", "text": "我当时真的做好了去看电影的准备。"}, {"type": "subtitle", "time": 6305.669, "timestamp": "01:45:05", "text": "我讨厌杰克·布莱克扮演史蒂夫，但后来"}, {"type": "subtitle", "time": 6307.91, "timestamp": "01:45:07", "text": "我意识到他们玩得很开心。"}, {"type": "subtitle", "time": 6310.149, "timestamp": "01:45:10", "text": "我心想，“我怎么能讨厌这个呢？这个"}, {"type": "subtitle", "time": 6313.03, "timestamp": "01:45:13", "text": "很有趣。看杰克·布莱克表演很有趣"}, {"type": "subtitle", "time": 6314.95, "timestamp": "01:45:14", "text": "他自己的想法。"}, {"type": "subtitle", "time": 6318.87, "timestamp": "01:45:18", "text": "是的。是啊。就像你会……"}, {"type": "subtitle", "time": 6321.43, "timestamp": "01:45:21", "text": "那。这是好电影的标志。如果"}, {"type": "subtitle", "time": 6324.07, "timestamp": "01:45:24", "text": "你带着讨厌它的心态去体验它。"}, {"type": "subtitle", "time": 6327.51, "timestamp": "01:45:27", "text": "然后你就不知不觉地喜欢上了它。"}, {"type": "subtitle", "time": 6329.43, "timestamp": "01:45:29", "text": "那是一部好电影。那真是"}, {"type": "subtitle", "time": 6333.109, "timestamp": "01:45:33", "text": "好电影。嗯。就像去"}, {"type": "subtitle", "time": 6335.109, "timestamp": "01:45:35", "text": "进入井里，我真的不能这么说。"}, {"type": "subtitle", "time": 6336.79, "timestamp": "01:45:36", "text": "关于FNAF电影。这相当"}, {"type": "subtitle", "time": 6339.27, "timestamp": "01:45:39", "text": "对我来说，感觉好坏参半。"}, {"type": "subtitle", "time": 6340.95, "timestamp": "01:45:40", "text": "但我努力想讨厌杰克·布莱克。"}, {"type": "subtitle", "time": 6344.709, "timestamp": "01:45:44", "text": "是杰克·布莱克吧？我不是那种人"}, {"type": "subtitle", "time": 6347.109, "timestamp": "01:45:47", "text": "讨厌杰克·布莱克，就因为他是杰克·布莱克。我"}, {"type": "subtitle", "time": 6349.109, "timestamp": "01:45:49", "text": "我只是讨厌他，因为他塑造了……的形象。"}, {"type": "subtitle", "time": 6351.99, "timestamp": "01:45:51", "text": "我最爱的史蒂夫这个角色，对吧？但"}, {"type": "subtitle", "time": 6355.51, "timestamp": "01:45:55", "text": "然后我意识到杰克·布莱克扮演的是史蒂夫"}, {"type": "subtitle", "time": 6357.59, "timestamp": "01:45:57", "text": "其实也没那么糟，因为他可以……"}]
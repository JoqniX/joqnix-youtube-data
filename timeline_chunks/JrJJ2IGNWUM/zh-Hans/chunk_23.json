[{"type": "subtitle", "time": 1382.549, "timestamp": "00:23:02", "text": "失去了你曾经拥有的那份热情。"}, {"type": "subtitle", "time": 1385.83, "timestamp": "00:23:05", "text": "或者说，喜欢保持一致性，对吧？"}, {"type": "subtitle", "time": 1387.83, "timestamp": "00:23:07", "text": "是的。因为，我就是这种感觉。"}, {"type": "subtitle", "time": 1389.99, "timestamp": "00:23:09", "text": "因为你知道我们浪费了太多时间"}, {"type": "subtitle", "time": 1393.43, "timestamp": "00:23:13", "text": "玩电子游戏就像这样"}, {"type": "subtitle", "time": 1395.83, "timestamp": "00:23:15", "text": "感觉就像你已经经历过你"}, {"type": "subtitle", "time": 1398.47, "timestamp": "00:23:18", "text": "一直想体验一下。当然，"}, {"type": "subtitle", "time": 1401.029, "timestamp": "00:23:21", "text": "有新的体验，新的刺激"}, {"type": "subtitle", "time": 1402.95, "timestamp": "00:23:22", "text": "在当今的游戏界。如你看到的，"}, {"type": "subtitle", "time": 1405.59, "timestamp": "00:23:25", "text": "人们喜欢尝试新鲜事物和玩游戏。"}, {"type": "subtitle", "time": 1408.149, "timestamp": "00:23:28", "text": "越来越成为一种"}, {"type": "subtitle", "time": 1410.71, "timestamp": "00:23:30", "text": "被接受的文化概念，而不是，"}, {"type": "subtitle", "time": 1412.789, "timestamp": "00:23:32", "text": "你知道，以前当你……"}, {"type": "subtitle", "time": 1414.87, "timestamp": "00:23:34", "text": "仅仅因为带了一台DS游戏机就被欺负"}, {"type": "subtitle", "time": 1418.07, "timestamp": "00:23:38", "text": "学校。顺便说一句，那是我。哦，我的"}, {"type": "subtitle", "time": 1420.87, "timestamp": "00:23:40", "text": "上帝。是啊，想当年，电子游戏"}, {"type": "subtitle", "time": 1423.19, "timestamp": "00:23:43", "text": "他们似乎不太受人赏识，而且我"}, {"type": "subtitle", "time": 1425.59, "timestamp": "00:23:45", "text": "那时候我超级迷电子游戏"}, {"type": "subtitle", "time": 1428.23, "timestamp": "00:23:48", "text": "当时人们并不处于那种……的时代"}, {"type": "subtitle", "time": 1429.75, "timestamp": "00:23:49", "text": "其实我挺喜欢那种破事的"}, {"type": "subtitle", "time": 1433.029, "timestamp": "00:23:53", "text": "然后。所以，这就好比是电子游戏一样，"}, {"type": "subtitle", "time": 1434.87, "timestamp": "00:23:54", "text": "我认为他们更像是，而不仅仅是"}, {"type": "subtitle", "time": 1437.83, "timestamp": "00:23:57", "text": "出于傻乐的目的，我明白这一点。"}]
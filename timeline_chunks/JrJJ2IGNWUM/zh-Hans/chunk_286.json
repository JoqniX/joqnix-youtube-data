[{"type": "subtitle", "time": 17161.43, "timestamp": "04:46:01", "text": "是啊，事情就是这样。所以，我有点……"}, {"type": "subtitle", "time": 17165.07, "timestamp": "04:46:05", "text": "取消、取消或重新安排"}, {"type": "subtitle", "time": 17168.868, "timestamp": "04:46:08", "text": "外出，周四和周四、周五，"}, {"type": "subtitle", "time": 17170.708, "timestamp": "04:46:10", "text": "星期日。这是免费老虎机游戏。我要"}, {"type": "subtitle", "time": 17172.948, "timestamp": "04:46:12", "text": "把所有人都放进去。我得找人。"}, {"type": "subtitle", "time": 17176.15, "timestamp": "04:46:16", "text": "那些一直在排队的人。我必须"}, {"type": "subtitle", "time": 17177.91, "timestamp": "04:46:17", "text": "把它们都放进去。我得查一下。"}, {"type": "subtitle", "time": 17180.23, "timestamp": "04:46:20", "text": "以及所有的一切。我想我之后会做。"}, {"type": "subtitle", "time": 17184.07, "timestamp": "04:46:24", "text": "稍微睡一会儿。所以，是的，我会"}, {"type": "subtitle", "time": 17188.628, "timestamp": "04:46:28", "text": "慢慢来。是的，疼痛。无论如何"}, {"type": "subtitle", "time": 17191.11, "timestamp": "04:46:31", "text": "各位，我先告辞了。我真的会"}, {"type": "subtitle", "time": 17193.91, "timestamp": "04:46:33", "text": "睡觉之类的。得去买点东西。"}, {"type": "chat", "time": 17195.835, "timestamp": "04:46:35", "author": "@Roku-rin", "avatar": "https://yt4.ggpht.com/8LlS_C2IirDMfA5r2V0q5G1kudp8dmG6RQvz_jCAUT3H-esyEgTNPDwrfCXiyX7Undc9UmHNgw=s64-c-k-c0x00ffffff-no-rj", "message": "take ur time good night"}, {"type": "subtitle", "time": 17196.868, "timestamp": "04:46:36", "text": "准备好了。然后我就去睡觉。谢谢"}, {"type": "subtitle", "time": 17199.23, "timestamp": "04:46:39", "text": "今天就到这里。真是，真是"}, {"type": "subtitle", "time": 17201.99, "timestamp": "04:46:41", "text": "乐趣。正确的。谢谢。不，再见。"}, {"type": "subtitle", "time": 17205.31, "timestamp": "04:46:45", "text": "明天清晨。我会尽量做到"}, {"type": "subtitle", "time": 17208.15, "timestamp": "04:46:48", "text": "醒了，但我会试着睡着，因为"}, {"type": "subtitle", "time": 17211.03, "timestamp": "04:46:51", "text": "我明天有很长的一天要过。我必须"}, {"type": "subtitle", "time": 17213.91, "timestamp": "04:46:53", "text": "熬夜之类的。等等，明天是……"}, {"type": "subtitle", "time": 17215.628, "timestamp": "04:46:55", "text": "我必须留下来的那一天"}, {"type": "subtitle", "time": 17217.39, "timestamp": "04:46:57", "text": "向上？"}]
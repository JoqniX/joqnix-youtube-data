[{"type": "subtitle", "time": 5581.189, "timestamp": "01:33:01", "text": "如实更新。嗯。等等，是"}, {"type": "subtitle", "time": 5583.27, "timestamp": "01:33:03", "text": "各位，Unorryinary要更新了吗？"}, {"type": "subtitle", "time": 5586.07, "timestamp": "01:33:06", "text": "什么？我不知道是不是因为……"}, {"type": "subtitle", "time": 5588.629, "timestamp": "01:33:08", "text": "已经好几个月了。"}, {"type": "subtitle", "time": 5590.149, "timestamp": "01:33:10", "text": "我不知道这位艺术家有多长"}, {"type": "subtitle", "time": 5593.03, "timestamp": "01:33:13", "text": "她打算利用休息时间，但是……"}, {"type": "subtitle", "time": 5594.47, "timestamp": "01:33:14", "text": "已经过去几个月了，我不知道是不是……"}, {"type": "subtitle", "time": 5597.35, "timestamp": "01:33:17", "text": "回来之后，我其实有点害怕。我"}, {"type": "subtitle", "time": 5599.95, "timestamp": "01:33:19", "text": "希望这个故事"}, {"type": "subtitle", "time": 5603.11, "timestamp": "01:33:23", "text": "继续。你们觉得怎么样？"}, {"type": "subtitle", "time": 5604.95, "timestamp": "01:33:24", "text": "等等，稍等。好的，问题。"}, {"type": "subtitle", "time": 5607.59, "timestamp": "01:33:27", "text": "哪个？非凡的。就是那个"}, {"type": "subtitle", "time": 5610.07, "timestamp": "01:33:30", "text": "就像主角的名字是"}, {"type": "subtitle", "time": 5611.43, "timestamp": "01:33:31", "text": "约翰"}, {"type": "subtitle", "time": 5612.79, "timestamp": "01:33:32", "text": "[音乐]"}, {"type": "subtitle", "time": 5615.83, "timestamp": "01:33:35", "text": "他就像个普通人一样，他"}, {"type": "subtitle", "time": 5618.07, "timestamp": "01:33:38", "text": "虽然没有超能力，但令人惊讶的是……"}, {"type": "subtitle", "time": 5620.629, "timestamp": "01:33:40", "text": "剧透警告：他其实拥有超能力。"}, {"type": "subtitle", "time": 5622.629, "timestamp": "01:33:42", "text": "他只是因为受到创伤而不敢使用它们。"}, {"type": "subtitle", "time": 5624.47, "timestamp": "01:33:44", "text": "诸如此类的东西"}, {"type": "subtitle", "time": 5631.27, "timestamp": "01:33:51", "text": "一个，好吧，你们怎么看？"}, {"type": "subtitle", "time": 5636.03, "timestamp": "01:33:56", "text": "认为它就像一种媒体形式，或者"}, {"type": "subtitle", "time": 5639.39, "timestamp": "01:33:59", "text": "任何通常被认为是"}]
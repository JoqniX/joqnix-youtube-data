[{"type": "subtitle", "time": 13393.67, "timestamp": "03:43:13", "text": "死。好的。我们能得到他敌人的"}, {"type": "subtitle", "time": 13399.429, "timestamp": "03:43:19", "text": "重新装弹。"}, {"type": "subtitle", "time": 13405.59, "timestamp": "03:43:25", "text": "他们再也爬不起来了。"}, {"type": "subtitle", "time": 13414.55, "timestamp": "03:43:34", "text": "已淘汰。 “给我一秒钟”在哪里？"}, {"type": "subtitle", "time": 13416.389, "timestamp": "03:43:36", "text": "修缮中。它在哪里？你的下一个"}, {"type": "subtitle", "time": 13419.51, "timestamp": "03:43:39", "text": "冠军就在这里。你得到了一个"}]
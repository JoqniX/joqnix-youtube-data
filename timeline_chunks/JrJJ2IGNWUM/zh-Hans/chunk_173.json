[{"type": "subtitle", "time": 10382.63, "timestamp": "02:53:02", "text": "我现在用的是耳机"}, {"type": "subtitle", "time": 10388.51, "timestamp": "02:53:08", "text": "但我打算进入你的显示器"}, {"type": "subtitle", "time": 10393.91, "timestamp": "02:53:13", "text": "比如有线的"}, {"type": "subtitle", "time": 10400.429, "timestamp": "02:53:20", "text": "那很好。那是"}, {"type": "subtitle", "time": 10403.95, "timestamp": "02:53:23", "text": "好的。坚持，稍等。阿姆拉向你问好"}, {"type": "subtitle", "time": 10411.71, "timestamp": "02:53:31", "text": "[音乐]"}, {"type": "subtitle", "time": 10415.349, "timestamp": "02:53:35", "text": "你好。你好。"}, {"type": "subtitle", "time": 10417.17, "timestamp": "02:53:37", "text": "还有，你好，Roku。"}, {"type": "subtitle", "time": 10424.67, "timestamp": "02:53:44", "text": "欢迎。"}, {"type": "subtitle", "time": 10429.269, "timestamp": "02:53:49", "text": "嗨，如果我知道我必须做着色器就好了。"}, {"type": "subtitle", "time": 10431.83, "timestamp": "02:53:51", "text": "也玩。"}, {"type": "subtitle", "time": 10433.389, "timestamp": "02:53:53", "text": "是的。是的。是的。他"}, {"type": "subtitle", "time": 10436.95, "timestamp": "02:53:56", "text": "做。他以前每天都像这样玩耍"}]
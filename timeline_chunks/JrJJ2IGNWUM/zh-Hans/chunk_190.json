[{"type": "subtitle", "time": 11405.389, "timestamp": "03:10:05", "text": "第15季或第40季。"}, {"type": "subtitle", "time": 11408.07, "timestamp": "03:10:08", "text": "嗯。从那时起你就迷上了"}, {"type": "subtitle", "time": 11410.15, "timestamp": "03:10:10", "text": "现在开始游戏吗？"}, {"type": "subtitle", "time": 11412.55, "timestamp": "03:10:12", "text": "是的。"}, {"type": "subtitle", "time": 11416.75, "timestamp": "03:10:16", "text": "当我开始玩游戏的时候，"}, {"type": "subtitle", "time": 11422.95, "timestamp": "03:10:22", "text": "竞技场还在那里，他们"}, {"type": "subtitle", "time": 11426.11, "timestamp": "03:10:26", "text": "把它移除了"}, {"type": "subtitle", "time": 11439.51, "timestamp": "03:10:39", "text": "现在他们又把它作为限量版重新上架了。"}, {"type": "subtitle", "time": 11442.15, "timestamp": "03:10:42", "text": "模式。"}, {"type": "subtitle", "time": 11445.15, "timestamp": "03:10:45", "text": "好的，我现在在大厅里。"}, {"type": "subtitle", "time": 11447.67, "timestamp": "03:10:47", "text": "那。我的天哪，你已经得到了"}, {"type": "subtitle", "time": 11451.91, "timestamp": "03:10:51", "text": "皮肤之类的东西。走吧。"}, {"type": "subtitle", "time": 11453.51, "timestamp": "03:10:53", "text": "该死。"}]
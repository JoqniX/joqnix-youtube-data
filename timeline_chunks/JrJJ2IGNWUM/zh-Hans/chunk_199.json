[{"type": "subtitle", "time": 11940.429, "timestamp": "03:19:00", "text": "我的"}, {"type": "subtitle", "time": 11944.71, "timestamp": "03:19:04", "text": "上帝。在哪里？"}, {"type": "subtitle", "time": 11960.07, "timestamp": "03:19:20", "text": "他在哪儿？别让他们看到"}, {"type": "subtitle", "time": 11963.83, "timestamp": "03:19:23", "text": "这里。我。"}, {"type": "subtitle", "time": 11969.67, "timestamp": "03:19:29", "text": "跳回去。"}, {"type": "subtitle", "time": 11972.469, "timestamp": "03:19:32", "text": "不。"}, {"type": "subtitle", "time": 11976.55, "timestamp": "03:19:36", "text": "已锁定。向下。嘿，我升级了。必须"}, {"type": "subtitle", "time": 11978.469, "timestamp": "03:19:38", "text": "选择升级选项。他们没得到"}, {"type": "subtitle", "time": 11981.03, "timestamp": "03:19:41", "text": "后退。我们有"}, {"type": "subtitle", "time": 11983.429, "timestamp": "03:19:43", "text": "胜利。"}, {"type": "subtitle", "time": 11985.83, "timestamp": "03:19:45", "text": "升级了。这是哪里？这是哪里？"}, {"type": "subtitle", "time": 11988.63, "timestamp": "03:19:48", "text": "战利品箱？"}, {"type": "subtitle", "time": 11995.95, "timestamp": "03:19:55", "text": "哦"}]
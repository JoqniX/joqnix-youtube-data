[{"type": "subtitle", "time": 4380.79, "timestamp": "01:13:00", "text": "在城市里。但当你像这样的时候"}, {"type": "subtitle", "time": 4382.07, "timestamp": "01:13:02", "text": "当你在乡村时，你"}, {"type": "subtitle", "time": 4384.149, "timestamp": "01:13:04", "text": "我想出去走走，但是……"}, {"type": "subtitle", "time": 4386.87, "timestamp": "01:13:06", "text": "什么都没有。"}, {"type": "subtitle", "time": 4388.47, "timestamp": "01:13:08", "text": "你在这里的朋友就像……"}, {"type": "subtitle", "time": 4391.11, "timestamp": "01:13:11", "text": "超级喜欢，它叫什么来着？隐居"}, {"type": "subtitle", "time": 4392.87, "timestamp": "01:13:12", "text": "而且不太愿意接受这种观点"}, {"type": "subtitle", "time": 4394.47, "timestamp": "01:13:14", "text": "概念或者只是闲聊之类的"}, {"type": "subtitle", "time": 4396.91, "timestamp": "01:13:16", "text": "屎。他们相当"}, {"type": "subtitle", "time": 4399.669, "timestamp": "01:13:19", "text": "嗯，是的，他们确实比较隐居。"}, {"type": "subtitle", "time": 4401.11, "timestamp": "01:13:21", "text": "关于他们想如何展现自己"}, {"type": "subtitle", "time": 4403.27, "timestamp": "01:13:23", "text": "和新朋友一起做各种乱七八糟的事。是的，"}, {"type": "subtitle", "time": 4406.55, "timestamp": "01:13:26", "text": "我的情况正在好转。嗯。"}, {"type": "subtitle", "time": 4408.31, "timestamp": "01:13:28", "text": "你有没有注意到，我不知道是不是"}, {"type": "subtitle", "time": 4410.47, "timestamp": "01:13:30", "text": "这在印度确实存在，但就像在……"}, {"type": "subtitle", "time": 4411.91, "timestamp": "01:13:31", "text": "菲律宾，那里有数不清的"}, {"type": "subtitle", "time": 4416.47, "timestamp": "01:13:36", "text": "现在流行哥特风。哥特人？是的。另类"}, {"type": "subtitle", "time": 4417.669, "timestamp": "01:13:37", "text": "我想，那应该叫服装吧。"}, {"type": "subtitle", "time": 4419.27, "timestamp": "01:13:39", "text": "现在。对，哥特族。就像人们一样"}, {"type": "subtitle", "time": 4422.95, "timestamp": "01:13:42", "text": "穿一身黑的人看起来酷毙了。"}, {"type": "subtitle", "time": 4425.189, "timestamp": "01:13:45", "text": "哇。说实话，我挺喜欢他们的风格，但是……"}, {"type": "subtitle", "time": 4427.03, "timestamp": "01:13:47", "text": "实在做不到。我的身体"}, {"type": "subtitle", "time": 4429.229, "timestamp": "01:13:49", "text": "体型并不一定……"}, {"type": "subtitle", "time": 4431.75, "timestamp": "01:13:51", "text": "知道，要和那种人一起工作，因为你需要"}, {"type": "subtitle", "time": 4433.27, "timestamp": "01:13:53", "text": "要有点小可爱才能做到"}, {"type": "subtitle", "time": 4435.59, "timestamp": "01:13:55", "text": "工作。诚实地，"}, {"type": "subtitle", "time": 4438.07, "timestamp": "01:13:58", "text": "我的意思是，我见过一些身材健壮的哥特族，"}]
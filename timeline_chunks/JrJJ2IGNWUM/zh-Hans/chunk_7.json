[{"type": "subtitle", "time": 420.189, "timestamp": "00:07:00", "text": "了解生活，了解生活是怎样的。"}, {"type": "subtitle", "time": 422.629, "timestamp": "00:07:02", "text": "一切。是的，那会很不错。"}, {"type": "subtitle", "time": 425.43, "timestamp": "00:07:05", "text": "老兄。你将了解到什么是……"}, {"type": "subtitle", "time": 427.67, "timestamp": "00:07:07", "text": "外面发生的事情。你将被迫"}, {"type": "subtitle", "time": 429.43, "timestamp": "00:07:09", "text": "了解外面正在发生的事情。"}, {"type": "subtitle", "time": 431.589, "timestamp": "00:07:11", "text": "是的。和老奶奶聊天的时间更多"}, {"type": "subtitle", "time": 435.029, "timestamp": "00:07:15", "text": "现在经常在你移动的时候。"}, {"type": "subtitle", "time": 437.51, "timestamp": "00:07:17", "text": "嗯。老兄，她们是老奶奶们"}, {"type": "subtitle", "time": 440.23, "timestamp": "00:07:20", "text": "狠。就像你所在的任何国家一样"}, {"type": "subtitle", "time": 442.23, "timestamp": "00:07:22", "text": "在里面，这无关紧要。奶奶的，"}, {"type": "subtitle", "time": 444.39, "timestamp": "00:07:24", "text": "他们总是有事发生。哦"}, {"type": "subtitle", "time": 446.629, "timestamp": "00:07:26", "text": "我的上帝。是的。他们总有东西。"}, {"type": "subtitle", "time": 448.79, "timestamp": "00:07:28", "text": "谈论这些简直太疯狂了，或者他们总是……"}, {"type": "subtitle", "time": 451.27, "timestamp": "00:07:31", "text": "一件会让你耿耿于怀的事。老实说，"}, {"type": "subtitle", "time": 453.909, "timestamp": "00:07:33", "text": "这有点滑稽。我没想到会这样"}, {"type": "subtitle", "time": 456.629, "timestamp": "00:07:36", "text": "老年人有很多喜欢的东西"}, {"type": "subtitle", "time": 458.75, "timestamp": "00:07:38", "text": "发生了很多事。"}, {"type": "subtitle", "time": 460.79, "timestamp": "00:07:40", "text": "[音乐]"}, {"type": "subtitle", "time": 462.629, "timestamp": "00:07:42", "text": "你可以从他们那里打听到很多八卦。"}, {"type": "subtitle", "time": 464.469, "timestamp": "00:07:44", "text": "是的。哦，确实如此。真的。还有很多"}, {"type": "subtitle", "time": 468.469, "timestamp": "00:07:48", "text": "他们也会给出建议，对吧？有时。"}, {"type": "subtitle", "time": 470.79, "timestamp": "00:07:50", "text": "是的，他们经历过一些事，你"}, {"type": "subtitle", "time": 475.27, "timestamp": "00:07:55", "text": "知道。是的。是的。嗯，是的，所以我当时"}, {"type": "subtitle", "time": 478.51, "timestamp": "00:07:58", "text": "我四处寻找一个像这样的"}]
[{"type": "subtitle", "time": 13080.03, "timestamp": "03:38:00", "text": "买一个"}, {"type": "subtitle", "time": 13081.55, "timestamp": "03:38:01", "text": "事件"}, {"type": "subtitle", "time": 13084.51, "timestamp": "03:38:04", "text": "然后你就得到了"}, {"type": "subtitle", "time": 13092.63, "timestamp": "03:38:12", "text": "[音乐]"}, {"type": "subtitle", "time": 13095.91, "timestamp": "03:38:15", "text": "哦，活动又回来了。哦，"}, {"type": "subtitle", "time": 13099.95, "timestamp": "03:38:19", "text": "抬起头来。就像那里有"}, {"type": "subtitle", "time": 13101.469, "timestamp": "03:38:21", "text": "到过"}, {"type": "subtitle", "time": 13106.03, "timestamp": "03:38:26", "text": "您可以参加的活动"}, {"type": "subtitle", "time": 13108.03, "timestamp": "03:38:28", "text": "碎片"}, {"type": "subtitle", "time": 13117.63, "timestamp": "03:38:37", "text": "皮肤。啊，那个"}, {"type": "subtitle", "time": 13120.55, "timestamp": "03:38:40", "text": "一名球员的技能分布。哦，是的"}, {"type": "subtitle", "time": 13123.11, "timestamp": "03:38:43", "text": "我们余额不足。该死。应该是这样"}, {"type": "subtitle", "time": 13127.429, "timestamp": "03:38:47", "text": "降低。它也位列前茅"}, {"type": "subtitle", "time": 13132.99, "timestamp": "03:38:52", "text": "它还会向玩家展示游戏画面。"}, {"type": "subtitle", "time": 13138.75, "timestamp": "03:38:58", "text": "分布情况，它将像每一样显示出来。"}]
[{"type": "subtitle", "time": 14884.07, "timestamp": "04:08:04", "text": "那场战斗中富人的皮肤。"}, {"type": "subtitle", "time": 14886.71, "timestamp": "04:08:06", "text": "我太"}, {"type": "subtitle", "time": 14891.429, "timestamp": "04:08:11", "text": "哦，你喝得烂醉如泥啊，伙计。"}, {"type": "subtitle", "time": 14899.75, "timestamp": "04:08:19", "text": "意大利语。意大利语。好的，我们应该降落了。"}, {"type": "subtitle", "time": 14912.229, "timestamp": "04:08:32", "text": "大概有三件事。我的天啊。"}, {"type": "subtitle", "time": 14937.59, "timestamp": "04:08:57", "text": "注意力。获得了一把强化武器。准备好"}]
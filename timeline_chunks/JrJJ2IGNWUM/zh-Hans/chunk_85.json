[{"type": "subtitle", "time": 5102.91, "timestamp": "01:25:02", "text": "等级。是的。是的。此外，他们"}, {"type": "subtitle", "time": 5107.43, "timestamp": "01:25:07", "text": "更喜欢美国人。"}, {"type": "subtitle", "time": 5110.149, "timestamp": "01:25:10", "text": "就像英语里那样。是的，"}, {"type": "subtitle", "time": 5111.75, "timestamp": "01:25:11", "text": "我是亚洲人，所以这永远不会发生。"}, {"type": "subtitle", "time": 5114.629, "timestamp": "01:25:14", "text": "工作。"}, {"type": "subtitle", "time": 5116.99, "timestamp": "01:25:16", "text": "我绝对"}, {"type": "subtitle", "time": 5119.35, "timestamp": "01:25:19", "text": "菲律宾人。是啊，没错。比如，哦"}, {"type": "subtitle", "time": 5121.03, "timestamp": "01:25:21", "text": "是的，科托的意思是，“我宁愿……”"}, {"type": "subtitle", "time": 5122.79, "timestamp": "01:25:22", "text": "多喝咖啡，少喝酒。咖啡是"}, {"type": "subtitle", "time": 5124.79, "timestamp": "01:25:24", "text": "“对我来说，酒精很重要。” 是啊，老兄。"}, {"type": "subtitle", "time": 5126.709, "timestamp": "01:25:26", "text": "可以理解。我见过这样的人"}, {"type": "subtitle", "time": 5129.75, "timestamp": "01:25:29", "text": "狂饮咖啡。比如，你难道不明白吗？"}, {"type": "subtitle", "time": 5131.35, "timestamp": "01:25:31", "text": "是这样的，对吧？你发展"}, {"type": "subtitle", "time": 5133.11, "timestamp": "01:25:33", "text": "对咖啡产生某种程度的抵触情绪"}, {"type": "subtitle", "time": 5134.95, "timestamp": "01:25:34", "text": "过一会儿，因为咖啡因开始消退了"}, {"type": "subtitle", "time": 5136.87, "timestamp": "01:25:36", "text": "它很火。因为我注意到了这一点。"}, {"type": "subtitle", "time": 5138.229, "timestamp": "01:25:38", "text": "和我的一群其他朋友"}, {"type": "subtitle", "time": 5139.75, "timestamp": "01:25:39", "text": "因为就像他们每次喝咖啡的时候"}, {"type": "subtitle", "time": 5141.99, "timestamp": "01:25:41", "text": "喝两三杯就能达到同样的效果"}, {"type": "subtitle", "time": 5143.99, "timestamp": "01:25:43", "text": "就像我喝一杯酒时那样兴奋"}, {"type": "subtitle", "time": 5150.95, "timestamp": "01:25:50", "text": "我认识一位澳大利亚的虚拟主播，他后来成为了"}, {"type": "subtitle", "time": 5153.27, "timestamp": "01:25:53", "text": "一位日本英语老师。那是"}, {"type": "subtitle", "time": 5155.75, "timestamp": "01:25:55", "text": "真实的。哦，是真的。所以你开发了"}]
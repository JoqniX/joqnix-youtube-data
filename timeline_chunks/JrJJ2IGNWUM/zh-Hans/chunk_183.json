[{"type": "subtitle", "time": 10981.03, "timestamp": "03:03:01", "text": "上车。上车。加油，萨卡。 H."}, {"type": "subtitle", "time": 10990.23, "timestamp": "03:03:10", "text": "进去。不。你没看见。"}, {"type": "subtitle", "time": 10993.83, "timestamp": "03:03:13", "text": "什么？你没明白吗？"}, {"type": "subtitle", "time": 10999.67, "timestamp": "03:03:19", "text": "我没明白，但就像它显示的那样"}, {"type": "subtitle", "time": 11001.99, "timestamp": "03:03:21", "text": "相同的。"}, {"type": "subtitle", "time": 11005.51, "timestamp": "03:03:25", "text": "等等，你重启了吗？重新启动？"}, {"type": "subtitle", "time": 11007.75, "timestamp": "03:03:27", "text": "是的。"}, {"type": "subtitle", "time": 11016.75, "timestamp": "03:03:36", "text": "等等，加入我的派对吧。"}, {"type": "subtitle", "time": 11018.51, "timestamp": "03:03:38", "text": "是的，"}, {"type": "subtitle", "time": 11021.67, "timestamp": "03:03:41", "text": "接受。加入失败游戏不会发生"}, {"type": "subtitle", "time": 11024.99, "timestamp": "03:03:44", "text": "比赛主持人。什么？"}, {"type": "subtitle", "time": 11028.79, "timestamp": "03:03:48", "text": "什么？我应该尝试加入一场普通游戏吗？"}, {"type": "subtitle", "time": 11038.07, "timestamp": "03:03:58", "text": "正常游戏，退出后再重新进入。"}]
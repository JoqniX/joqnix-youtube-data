[{"type": "subtitle", "time": 962.55, "timestamp": "00:16:02", "text": "证书无效或类似"}, {"type": "subtitle", "time": 965.03, "timestamp": "00:16:05", "text": "有效性之类的，或者类似你不会"}, {"type": "subtitle", "time": 967.67, "timestamp": "00:16:07", "text": "凭此证书可以找到工作等等。"}, {"type": "subtitle", "time": 969.35, "timestamp": "00:16:09", "text": "现在这样做只会浪费时间。所以"}, {"type": "subtitle", "time": 971.03, "timestamp": "00:16:11", "text": "他不相信。当"}, {"type": "subtitle", "time": 972.949, "timestamp": "00:16:12", "text": "教授"}, {"type": "subtitle", "time": 975.829, "timestamp": "00:16:15", "text": "是的，当教授叔叔说他"}, {"type": "subtitle", "time": 977.91, "timestamp": "00:16:17", "text": "他当时就说，好啊，那就开始吧。"}, {"type": "subtitle", "time": 979.749, "timestamp": "00:16:19", "text": "因为别人这么说，所以就相信了。"}, {"type": "subtitle", "time": 983.189, "timestamp": "00:16:23", "text": "现在说它就像有保证一样"}, {"type": "subtitle", "time": 987.189, "timestamp": "00:16:27", "text": "是的，这样更好，而且一直如此。"}, {"type": "subtitle", "time": 990.629, "timestamp": "00:16:30", "text": "我大概从2022年开始做这件事。"}, {"type": "subtitle", "time": 995.59, "timestamp": "00:16:35", "text": "是的，英语文学荣誉课程。"}, {"type": "subtitle", "time": 998.79, "timestamp": "00:16:38", "text": "我还是不想，我不知道"}, {"type": "subtitle", "time": 1001.749, "timestamp": "00:16:41", "text": "我为什么失去了学习动力？"}, {"type": "subtitle", "time": 1003.99, "timestamp": "00:16:43", "text": "某物。自从"}, {"type": "subtitle", "time": 1007.269, "timestamp": "00:16:47", "text": "嗯，自从我喜欢上这个之后，就一直觉得很棒。"}, {"type": "subtitle", "time": 1009.99, "timestamp": "00:16:49", "text": "玩游戏以及做我的"}, {"type": "subtitle", "time": 1012.23, "timestamp": "00:16:52", "text": "自己的东西。是的。你进入了"}, {"type": "subtitle", "time": 1014.71, "timestamp": "00:16:54", "text": "令人上瘾的。这就像上瘾一样"}, {"type": "subtitle", "time": 1016.55, "timestamp": "00:16:56", "text": "必须离开，但你知道"}]
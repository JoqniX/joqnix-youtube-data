[{"type": "subtitle", "time": 6905.27, "timestamp": "01:55:05", "text": "是啊，如果你要走，那就走吧。"}, {"type": "subtitle", "time": 6907.35, "timestamp": "01:55:07", "text": "前面去吧，伙计。别着急。请尽情享受吧。"}, {"type": "chat", "time": 6909.7, "timestamp": "01:55:09", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "yappers yapped alot today nice"}, {"type": "subtitle", "time": 6911.83, "timestamp": "01:55:11", "text": "你自己看着办吧，老兄。嗯，我该结束了。"}, {"type": "subtitle", "time": 6915.43, "timestamp": "01:55:15", "text": "所以，因为呃，之后我还有另一个"}, {"type": "subtitle", "time": 6919.109, "timestamp": "01:55:19", "text": "客人。所以，好的，你继续吧。我是"}, {"type": "subtitle", "time": 6920.55, "timestamp": "01:55:20", "text": "可能会继续随机进行下去。"}, {"type": "subtitle", "time": 6923.589, "timestamp": "01:55:23", "text": "胡说八道。你好。你好。你好。因为我"}, {"type": "subtitle", "time": 6927.95, "timestamp": "01:55:27", "text": "通常会这样做。是的。所以，呃，谢谢。"}, {"type": "subtitle", "time": 6930.95, "timestamp": "01:55:30", "text": "感谢大家收留我。那真是太……"}, {"type": "subtitle", "time": 6933.589, "timestamp": "01:55:33", "text": "很荣幸能和大家聚聚，放松一下"}, {"type": "subtitle", "time": 6937.109, "timestamp": "01:55:37", "text": "今天吃寿司。真的很不错。我们"}, {"type": "subtitle", "time": 6939.189, "timestamp": "01:55:39", "text": "现在我们聊了很多，各种事情都有。"}, {"type": "subtitle", "time": 6941.669, "timestamp": "01:55:41", "text": "和往常一样，我们这些爱唠叨的人。我们"}, {"type": "subtitle", "time": 6943.83, "timestamp": "01:55:43", "text": "喋喋不休的人。"}, {"type": "subtitle", "time": 6946.629, "timestamp": "01:55:46", "text": "我有点担心我们该怎么做。"}, {"type": "subtitle", "time": 6949.189, "timestamp": "01:55:49", "text": "没有玩游戏，但我们真的做到了"}, {"type": "subtitle", "time": 6951.109, "timestamp": "01:55:51", "text": "我很喜欢。兄弟，这又不是我们"}, {"type": "subtitle", "time": 6952.95, "timestamp": "01:55:52", "text": "我们当时在聊一些无关紧要的事情，而不是"}, {"type": "subtitle", "time": 6954.709, "timestamp": "01:55:54", "text": "那时候在游戏里做任何事。我们"}, {"type": "subtitle", "time": 6956.55, "timestamp": "01:55:56", "text": "我们只是在游戏里站着不动而已"}]
[{"type": "subtitle", "time": 7562.229, "timestamp": "02:06:02", "text": "坏的。我真的好害怕。"}, {"type": "subtitle", "time": 7564.99, "timestamp": "02:06:04", "text": "就像我不想做另一个"}, {"type": "subtitle", "time": 7569.91, "timestamp": "02:06:09", "text": "队友生气了或者很愤怒。我"}, {"type": "subtitle", "time": 7572.87, "timestamp": "02:06:12", "text": "不知道。但是，是的，它只是一个"}, {"type": "subtitle", "time": 7577.95, "timestamp": "02:06:17", "text": "游戏，你知道，只是个游戏。愤怒"}, {"type": "subtitle", "time": 7580.43, "timestamp": "02:06:20", "text": "总是"}, {"type": "subtitle", "time": 7584.51, "timestamp": "02:06:24", "text": "那里。是的。"}, {"type": "subtitle", "time": 7588.629, "timestamp": "02:06:28", "text": "嗯。不用担心。我也很糟糕。啊。"}, {"type": "subtitle", "time": 7590.8, "timestamp": "02:06:30", "text": "是的。我也是。"}, {"type": "subtitle", "time": 7593.229, "timestamp": "02:06:33", "text": "[音乐]"}, {"type": "subtitle", "time": 7597.83, "timestamp": "02:06:37", "text": "信心。你好。你好。你好。所以，我一直"}, {"type": "subtitle", "time": 7599.91, "timestamp": "02:06:39", "text": "说着说着我会准备一个"}, {"type": "subtitle", "time": 7601.709, "timestamp": "02:06:41", "text": "安排和日程。"}, {"type": "subtitle", "time": 7605.79, "timestamp": "02:06:45", "text": "但即使到了今天，我仍然"}, {"type": "subtitle", "time": 7608.91, "timestamp": "02:06:48", "text": "连日程安排都没制定。"}, {"type": "subtitle", "time": 7619.109, "timestamp": "02:06:59", "text": "生活？是的。呃，我也不了解我的生活。"}]
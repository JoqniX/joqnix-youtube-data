[{"type": "subtitle", "time": 2042.509, "timestamp": "00:34:02", "text": "像疯了一样"}, {"type": "subtitle", "time": 2047.59, "timestamp": "00:34:07", "text": "像白人男孩那样的风格，就像……"}, {"type": "subtitle", "time": 2051.27, "timestamp": "00:34:11", "text": "呃，就像10公斤的卧推重量。"}, {"type": "subtitle", "time": 2054.71, "timestamp": "00:34:14", "text": "他像用尿液一样保持平衡"}, {"type": "subtitle", "time": 2056.79, "timestamp": "00:34:16", "text": "双臂自然垂于身体两侧。所以他只是在平衡。"}, {"type": "subtitle", "time": 2059.99, "timestamp": "00:34:19", "text": "把它放在小便上。"}, {"type": "subtitle", "time": 2063.829, "timestamp": "00:34:23", "text": "我的天啊。什么？互联网真是个疯狂的地方"}, {"type": "subtitle", "time": 2066.23, "timestamp": "00:34:26", "text": "是那种东西，不是吗？你知道，我是被塑造的。"}, {"type": "subtitle", "time": 2069.99, "timestamp": "00:34:29", "text": "并受到不受限制的访问的影响"}, {"type": "subtitle", "time": 2073.669, "timestamp": "00:34:33", "text": "互联网。嘿，Yappy。真诡异。是的，就是这样。"}, {"type": "subtitle", "time": 2075.589, "timestamp": "00:34:35", "text": "真诡异。我有点怪异，不是吗？"}, {"type": "subtitle", "time": 2077.55, "timestamp": "00:34:37", "text": "我要撒谎。是的，"}, {"type": "subtitle", "time": 2080.31, "timestamp": "00:34:40", "text": "它是对互联网的无限制访问"}, {"type": "subtitle", "time": 2083.589, "timestamp": "00:34:43", "text": "就像很小的时候那样。真的搞砸了"}, {"type": "subtitle", "time": 2085.349, "timestamp": "00:34:45", "text": "孩子。是啊，因为事情就是这样，"}, {"type": "subtitle", "time": 2087.27, "timestamp": "00:34:47", "text": "正确的？如今，一切都只是算法而已。"}, {"type": "subtitle", "time": 2089.909, "timestamp": "00:34:49", "text": "告诉你他们认为你想要什么"}, {"type": "subtitle", "time": 2092.75, "timestamp": "00:34:52", "text": "看。但回到我的"}, {"type": "subtitle", "time": 2096.23, "timestamp": "00:34:56", "text": "想当年，在我那个年代，你得看看"}, {"type": "subtitle", "time": 2099.109, "timestamp": "00:34:59", "text": "你想看的那些乱七八糟的东西。唯一的形式"}]
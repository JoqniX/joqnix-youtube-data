[{"type": "subtitle", "time": 11101.11, "timestamp": "03:05:01", "text": "保留和我一样的版本。是的，"}, {"type": "subtitle", "time": 11104.15, "timestamp": "03:05:04", "text": "那已经过时了。"}, {"type": "subtitle", "time": 11113.349, "timestamp": "03:05:13", "text": "正常情况下，它不会让我排队。"}, {"type": "subtitle", "time": 11118.269, "timestamp": "03:05:18", "text": "你可以"}, {"type": "subtitle", "time": 11141.349, "timestamp": "03:05:41", "text": "是的。"}, {"type": "subtitle", "time": 11145.03, "timestamp": "03:05:45", "text": "你到我那里了吗？"}, {"type": "subtitle", "time": 11148.95, "timestamp": "03:05:48", "text": "呃，我到了那个年龄段，而且很挑剔。"}]
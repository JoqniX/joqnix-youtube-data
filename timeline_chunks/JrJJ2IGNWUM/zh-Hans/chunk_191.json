[{"type": "subtitle", "time": 11461.71, "timestamp": "03:11:01", "text": "哦，你付费了，或者买了战斗通行证之类的东西"}, {"type": "subtitle", "time": 11466.83, "timestamp": "03:11:06", "text": "自由的？你可以买到这款皮肤"}, {"type": "subtitle", "time": 11471.99, "timestamp": "03:11:11", "text": "由工艺材料制成。哦，那是在"}, {"type": "subtitle", "time": 11474.67, "timestamp": "03:11:14", "text": "事件"}, {"type": "subtitle", "time": 11478.91, "timestamp": "03:11:18", "text": "如果你有喜欢"}, {"type": "subtitle", "time": 11483.349, "timestamp": "03:11:23", "text": "然后你可以购买1600个制作材料。"}, {"type": "subtitle", "time": 11485.309, "timestamp": "03:11:25", "text": "把它放在"}, {"type": "subtitle", "time": 11491.63, "timestamp": "03:11:31", "text": "活动，现在你必须付费了，就像这样"}, {"type": "subtitle", "time": 11494.03, "timestamp": "03:11:34", "text": "1,800 Apex"}, {"type": "subtitle", "time": 11500.95, "timestamp": "03:11:40", "text": "嗯？为什么这个人看起来这么酷"}, {"type": "subtitle", "time": 11503.83, "timestamp": "03:11:43", "text": "拥有传奇技能皮肤吗？他是"}, {"type": "subtitle", "time": 11507.91, "timestamp": "03:11:47", "text": "像个有钱人一样。这只麻雀。"}, {"type": "subtitle", "time": 11511.99, "timestamp": "03:11:51", "text": "该死。是的。我喜欢《鬼泣》"}, {"type": "subtitle", "time": 11515.11, "timestamp": "03:11:55", "text": "参考类型。那种吸血鬼"}, {"type": "subtitle", "time": 11517.67, "timestamp": "03:11:57", "text": "拥有麦加女神般的肌肤。"}]
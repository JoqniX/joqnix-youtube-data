[{"type": "subtitle", "time": 6482.79, "timestamp": "01:48:02", "text": "H想不出什么好主意。"}, {"type": "subtitle", "time": 6485.52, "timestamp": "01:48:05", "text": "你呢？"}, {"type": "subtitle", "time": 6487.59, "timestamp": "01:48:07", "text": "[音乐]"}, {"type": "subtitle", "time": 6490.47, "timestamp": "01:48:10", "text": "我知道很多人都有奇怪的癖好。"}, {"type": "subtitle", "time": 6493.669, "timestamp": "01:48:13", "text": "有个朋友说，好吧，我要……"}, {"type": "subtitle", "time": 6495.83, "timestamp": "01:48:15", "text": "真他妈想狠狠揍他们一顿"}, {"type": "subtitle", "time": 6497.99, "timestamp": "01:48:17", "text": "现在。我不知道。他们不监视我，"}, {"type": "subtitle", "time": 6500.95, "timestamp": "01:48:20", "text": "所以没问题。我们之前聊过。"}, {"type": "subtitle", "time": 6503.35, "timestamp": "01:48:23", "text": "就像电子游戏，或者甚至不是电子游戏"}, {"type": "subtitle", "time": 6505.43, "timestamp": "01:48:25", "text": "游戏，只是媒体的宠儿。 Bowzette。"}, {"type": "subtitle", "time": 6508.07, "timestamp": "01:48:28", "text": "绝对地。 100% 粉碎。碧琪公主"}, {"type": "subtitle", "time": 6510.39, "timestamp": "01:48:30", "text": "也。黛西公主。当然。"}, {"type": "subtitle", "time": 6511.83, "timestamp": "01:48:31", "text": "但是，是的，说到我的"}, {"type": "subtitle", "time": 6513.27, "timestamp": "01:48:33", "text": "朋友在此。我们当时在谈论……"}, {"type": "subtitle", "time": 6516.79, "timestamp": "01:48:36", "text": "一些乱七八糟的事，还有他，我，我提到过我"}, {"type": "subtitle", "time": 6518.87, "timestamp": "01:48:38", "text": "我知道你是个毛茸茸控，但你是"}, {"type": "subtitle", "time": 6521.109, "timestamp": "01:48:41", "text": "大概是那种会舔蓝色的那种人"}, {"type": "subtitle", "time": 6522.27, "timestamp": "01:48:42", "text": "的"}, {"type": "subtitle", "time": 6524.87, "timestamp": "01:48:44", "text": "蓝精灵。他和他达成了一致。他是"}, {"type": "subtitle", "time": 6527.35, "timestamp": "01:48:47", "text": "比如，“哦，对，蓝精灵。”我当时就想，"}, {"type": "subtitle", "time": 6529.35, "timestamp": "01:48:49", "text": "他为此高兴极了。我"}, {"type": "subtitle", "time": 6533.189, "timestamp": "01:48:53", "text": "我当时就想，老兄，我不能怪你，"}, {"type": "subtitle", "time": 6537.03, "timestamp": "01:48:57", "text": "但是，我的天啊，冷静点。"}, {"type": "subtitle", "time": 6538.95, "timestamp": "01:48:58", "text": "根据Reddit上的消息，我将会出现在……"}]
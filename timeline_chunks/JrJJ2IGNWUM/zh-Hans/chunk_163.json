[{"type": "subtitle", "time": 9781.51, "timestamp": "02:43:01", "text": "好的。那里的天气怎么样？是吗？"}, {"type": "subtitle", "time": 9787.95, "timestamp": "02:43:07", "text": "它撤退了"}, {"type": "subtitle", "time": 9796.07, "timestamp": "02:43:16", "text": "就像昨天下雨一样。"}, {"type": "subtitle", "time": 9801.75, "timestamp": "02:43:21", "text": "啊，但这里好像一直在下雨。"}, {"type": "subtitle", "time": 9805.11, "timestamp": "02:43:25", "text": "就像已经开始下雨了。"}, {"type": "subtitle", "time": 9808.67, "timestamp": "02:43:28", "text": "嗯。现在。"}, {"type": "subtitle", "time": 9813.349, "timestamp": "02:43:33", "text": "嗯。我要去买本书。"}, {"type": "subtitle", "time": 9816.07, "timestamp": "02:43:36", "text": "对我来说，每一天都和每一天一样。"}, {"type": "subtitle", "time": 9820.15, "timestamp": "02:43:40", "text": "下雨了，我的天哪，简直就像……"}, {"type": "subtitle", "time": 9823.15, "timestamp": "02:43:43", "text": "几乎会发生洪水"}, {"type": "subtitle", "time": 9829.63, "timestamp": "02:43:49", "text": "我。"}, {"type": "subtitle", "time": 9832.469, "timestamp": "02:43:52", "text": "是的。你一直……呃……你一直……"}, {"type": "subtitle", "time": 9835.95, "timestamp": "02:43:55", "text": "一会儿就直播，对吧？"}, {"type": "subtitle", "time": 9838.79, "timestamp": "02:43:58", "text": "是的。嗯。"}]
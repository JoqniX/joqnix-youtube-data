[{"type": "subtitle", "time": 16861.11, "timestamp": "04:41:01", "text": "与呃之类的团队合作。嗯，是的。"}, {"type": "subtitle", "time": 16864.07, "timestamp": "04:41:04", "text": "我会安排的。问题是我"}, {"type": "subtitle", "time": 16866.23, "timestamp": "04:41:06", "text": "必须决定玩什么游戏。那就是"}, {"type": "subtitle", "time": 16870.15, "timestamp": "04:41:10", "text": "唯一的问题。我打算等到六月。"}, {"type": "subtitle", "time": 16873.27, "timestamp": "04:41:13", "text": "从第一名到最后一名。我打算等到6月2日再说。"}, {"type": "subtitle", "time": 16874.51, "timestamp": "04:41:14", "text": "我可以"}, {"type": "subtitle", "time": 16877.35, "timestamp": "04:41:17", "text": "卸载。我可以卸载《海洋》"}, {"type": "subtitle", "time": 16880.07, "timestamp": "04:41:20", "text": "盗贼与地狱潜行者。我错过了什么吗？"}, {"type": "subtitle", "time": 16881.67, "timestamp": "04:41:21", "text": "合作？是的，你某种程度上确实做到了。它是"}, {"type": "subtitle", "time": 16885.07, "timestamp": "04:41:25", "text": "好的。我的工作室。欢迎，"}, {"type": "subtitle", "time": 16887.788, "timestamp": "04:41:27", "text": "男人。欢迎，兄弟。"}, {"type": "subtitle", "time": 16891.31, "timestamp": "04:41:31", "text": "错过了。嗯，是的，我们有过三次合作。"}, {"type": "subtitle", "time": 16892.91, "timestamp": "04:41:32", "text": "今天。"}, {"type": "subtitle", "time": 16895.59, "timestamp": "04:41:35", "text": "呃，我们原本应该与……合作"}, {"type": "subtitle", "time": 16898.55, "timestamp": "04:41:38", "text": "中午时分，我和玛丽莎碰面了，但我搞砸了。"}, {"type": "subtitle", "time": 16900.948, "timestamp": "04:41:40", "text": "定时。我没有再次确认。"}, {"type": "subtitle", "time": 16903.59, "timestamp": "04:41:43", "text": "我以为她会获得自由。我们"}, {"type": "subtitle", "time": 16908.15, "timestamp": "04:41:48", "text": "下午两三点可以。所以，我和加"}, {"type": "subtitle", "time": 16910.948, "timestamp": "04:41:50", "text": "我当时联系了很多人，18"}, {"type": "subtitle", "time": 16913.67, "timestamp": "04:41:53", "text": "如今人们对我的这种行为感到震惊。"}, {"type": "subtitle", "time": 16917.35, "timestamp": "04:41:57", "text": "疲劳的。我没去，我当时感觉很不舒服。"}, {"type": "subtitle", "time": 16919.75, "timestamp": "04:41:59", "text": "并感到恶心。于是我躺下，醒来"}]
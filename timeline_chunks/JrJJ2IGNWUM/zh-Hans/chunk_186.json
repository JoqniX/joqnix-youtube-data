[{"type": "subtitle", "time": 11161.11, "timestamp": "03:06:01", "text": "前进。"}, {"type": "subtitle", "time": 11166.309, "timestamp": "03:06:06", "text": "你收到更新选项了吗？"}, {"type": "subtitle", "time": 11175.19, "timestamp": "03:06:15", "text": "是的，我正在玩游戏。我身处"}, {"type": "subtitle", "time": 11177.99, "timestamp": "03:06:17", "text": "游戏。"}, {"type": "subtitle", "time": 11180.469, "timestamp": "03:06:20", "text": "所以"}, {"type": "subtitle", "time": 11182.99, "timestamp": "03:06:22", "text": "我的想法和你一样。"}, {"type": "subtitle", "time": 11188.71, "timestamp": "03:06:28", "text": "可以加入游戏，但你也需要"}, {"type": "subtitle", "time": 11190.87, "timestamp": "03:06:30", "text": "更新它。"}, {"type": "subtitle", "time": 11193.67, "timestamp": "03:06:33", "text": "但是，如果我只是重新启动，该如何更新呢？"}, {"type": "subtitle", "time": 11201.75, "timestamp": "03:06:41", "text": "次数。这确实很奇怪。一秒钟。"}, {"type": "subtitle", "time": 11205.55, "timestamp": "03:06:45", "text": "你不喜欢吗？你不喜欢看吗？"}, {"type": "subtitle", "time": 11209.11, "timestamp": "03:06:49", "text": "选项？"}, {"type": "subtitle", "time": 11213.63, "timestamp": "03:06:53", "text": "没有。 Steam上没有更新选项。"}, {"type": "subtitle", "time": 11215.63, "timestamp": "03:06:55", "text": "或许像"}, {"type": "subtitle", "time": 11218.23, "timestamp": "03:06:58", "text": "重启团队。"}]
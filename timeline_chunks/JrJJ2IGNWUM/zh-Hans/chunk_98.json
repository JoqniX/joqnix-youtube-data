[{"type": "subtitle", "time": 5881.35, "timestamp": "01:38:01", "text": "因为你已经认为你的想法是"}, {"type": "subtitle", "time": 5885.109, "timestamp": "01:38:05", "text": "你知道，这种类型的文字更好。"}, {"type": "subtitle", "time": 5886.87, "timestamp": "01:38:06", "text": "是的。你具体指的是什么？"}, {"type": "subtitle", "time": 5888.149, "timestamp": "01:38:08", "text": "指的是什么？你有类似……"}, {"type": "subtitle", "time": 5896.43, "timestamp": "01:38:16", "text": "呃，那是什么？"}, {"type": "subtitle", "time": 5900.189, "timestamp": "01:38:20", "text": "说出我的……那是什么动漫"}, {"type": "subtitle", "time": 5902.03, "timestamp": "01:38:22", "text": "再次？"}, {"type": "subtitle", "time": 5905.83, "timestamp": "01:38:25", "text": "呃，忘了名字了。"}, {"type": "subtitle", "time": 5909.109, "timestamp": "01:38:29", "text": "我不记得有什么穿越时空的动画。"}, {"type": "subtitle", "time": 5910.629, "timestamp": "01:38:30", "text": "我看过那些中国的小片段。"}, {"type": "subtitle", "time": 5912.149, "timestamp": "01:38:32", "text": "以重生为主题的电视剧"}, {"type": "subtitle", "time": 5914.99, "timestamp": "01:38:34", "text": "复仇，我乐在其中。"}, {"type": "subtitle", "time": 5917.83, "timestamp": "01:38:37", "text": "啊，我以前从来没见过这些。"}, {"type": "subtitle", "time": 5919.83, "timestamp": "01:38:39", "text": "是的，你喜欢中国电视剧吗？"}, {"type": "subtitle", "time": 5923.51, "timestamp": "01:38:43", "text": "记住这个名字的由来哦，命运石之门"}, {"type": "subtitle", "time": 5926.31, "timestamp": "01:38:46", "text": "我其实从来没看完过。"}, {"type": "subtitle", "time": 5928.229, "timestamp": "01:38:48", "text": "只看了一集，我就没看。"}, {"type": "subtitle", "time": 5930.149, "timestamp": "01:38:50", "text": "我真的非常投入，就那样。"}, {"type": "subtitle", "time": 5931.27, "timestamp": "01:38:51", "text": "把它扔了，然后去看别的了。"}, {"type": "subtitle", "time": 5932.55, "timestamp": "01:38:52", "text": "但那是很久以前的事了，也许吧"}, {"type": "subtitle", "time": 5938.39, "timestamp": "01:38:58", "text": "Stegate 还没完成两件事。是的。"}]
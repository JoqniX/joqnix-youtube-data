[{"type": "subtitle", "time": 5401.91, "timestamp": "01:30:01", "text": "它。是的。"}, {"type": "subtitle", "time": 5405.189, "timestamp": "01:30:05", "text": "暂且搁置。是的。"}, {"type": "subtitle", "time": 5407.669, "timestamp": "01:30:07", "text": "是的。我的想法和我想的一样。"}, {"type": "subtitle", "time": 5409.189, "timestamp": "01:30:09", "text": "嗯，我现在正在读的是……"}, {"type": "subtitle", "time": 5412.149, "timestamp": "01:30:12", "text": "因为我刚看完《老黄狗》，"}, {"type": "subtitle", "time": 5414.31, "timestamp": "01:30:14", "text": "是书，不是电影。我刚结束"}, {"type": "subtitle", "time": 5418.229, "timestamp": "01:30:18", "text": "《老黄狗》这本书。呃，我有"}, {"type": "subtitle", "time": 5421.51, "timestamp": "01:30:21", "text": "我还在读另外两本书。就是这样"}, {"type": "subtitle", "time": 5425.11, "timestamp": "01:30:25", "text": "偷狗。这就是标题。这是一个"}, {"type": "subtitle", "time": 5428.03, "timestamp": "01:30:28", "text": "这是一本书。另一个是"}, {"type": "subtitle", "time": 5431.11, "timestamp": "01:30:31", "text": "Starirl，事情就是这样，"}, {"type": "subtitle", "time": 5433.91, "timestamp": "01:30:33", "text": "正确的？我觉得这跟什么都没关系。"}, {"type": "subtitle", "time": 5436.709, "timestamp": "01:30:36", "text": "太花哨了。它只是有一个很好的"}, {"type": "subtitle", "time": 5440.149, "timestamp": "01:30:40", "text": "信息。我认为Starirl代表了"}, {"type": "subtitle", "time": 5442.79, "timestamp": "01:30:42", "text": "呃，真正的自我，那是一种与生俱来的特质。"}, {"type": "subtitle", "time": 5445.83, "timestamp": "01:30:45", "text": "就像人类的解释"}, {"type": "subtitle", "time": 5447.189, "timestamp": "01:30:47", "text": "性格就是他们只是"}, {"type": "subtitle", "time": 5448.87, "timestamp": "01:30:48", "text": "忠于自己想做的事，而不是"}, {"type": "subtitle", "time": 5450.47, "timestamp": "01:30:50", "text": "隐藏在伪装之下以获得认可"}, {"type": "subtitle", "time": 5453.03, "timestamp": "01:30:53", "text": "由社会决定。这就是我的基本结论。"}, {"type": "subtitle", "time": 5455.11, "timestamp": "01:30:55", "text": "就我目前读到的内容来看。但我"}, {"type": "subtitle", "time": 5456.47, "timestamp": "01:30:56", "text": "不知道，也许会改变吧"}, {"type": "subtitle", "time": 5457.75, "timestamp": "01:30:57", "text": "当我……的时候，我会更深入一些。"}, {"type": "subtitle", "time": 5459.11, "timestamp": "01:30:59", "text": "读一下。但我其实离得并不远。"}]
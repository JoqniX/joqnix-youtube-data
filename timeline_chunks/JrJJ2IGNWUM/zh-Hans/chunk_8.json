[{"type": "subtitle", "time": 482.23, "timestamp": "00:08:02", "text": "附近的语言和呃研究"}, {"type": "subtitle", "time": 485.35, "timestamp": "00:08:05", "text": "他们每一个人。我独自一人前往。"}, {"type": "subtitle", "time": 487.909, "timestamp": "00:08:07", "text": "有时和我的表弟在一起"}, {"type": "subtitle", "time": 491.51, "timestamp": "00:08:11", "text": "那里。是的，我把它们展示给了"}, {"type": "subtitle", "time": 494.71, "timestamp": "00:08:14", "text": "家人都觉得还好，然后他就……"}, {"type": "subtitle", "time": 497.589, "timestamp": "00:08:17", "text": "叔叔也一起来了"}, {"type": "subtitle", "time": 500.79, "timestamp": "00:08:20", "text": "出色地。叔叔也在那里，他们都在那里。"}, {"type": "subtitle", "time": 502.869, "timestamp": "00:08:22", "text": "讨论、研究等等"}, {"type": "subtitle", "time": 504.23, "timestamp": "00:08:24", "text": "来自学校，他们就像"}, {"type": "subtitle", "time": 507.11, "timestamp": "00:08:27", "text": "愿意让我学习等等。"}, {"type": "subtitle", "time": 509.189, "timestamp": "00:08:29", "text": "所以他们建议学院的人"}, {"type": "subtitle", "time": 512.55, "timestamp": "00:08:32", "text": "有人建议我从印度学习一个级别的课程。"}, {"type": "subtitle", "time": 515.829, "timestamp": "00:08:35", "text": "然后从那里去日本。"}, {"type": "subtitle", "time": 517.509, "timestamp": "00:08:37", "text": "环境将影响每个人。"}, {"type": "subtitle", "time": 519.11, "timestamp": "00:08:39", "text": "我说的日语没错，所以我会"}, {"type": "subtitle", "time": 520.63, "timestamp": "00:08:40", "text": "最终你会明白的。"}, {"type": "subtitle", "time": 523.029, "timestamp": "00:08:43", "text": "是的，我是被迫的，被迫去做这件事。"}, {"type": "subtitle", "time": 524.63, "timestamp": "00:08:44", "text": "被迫适应环境"}, {"type": "subtitle", "time": 527.99, "timestamp": "00:08:47", "text": "我不知道你会听到什么样的口音。"}, {"type": "subtitle", "time": 529.67, "timestamp": "00:08:49", "text": "因为他们总是喜欢模仿口音"}, {"type": "subtitle", "time": 531.269, "timestamp": "00:08:51", "text": "你跟那些人说话，对吧？"}, {"type": "subtitle", "time": 533.19, "timestamp": "00:08:53", "text": "那太常见了，就是这样。"}, {"type": "subtitle", "time": 535.269, "timestamp": "00:08:55", "text": "这件事发生在我身上，我想知道为什么人们会这么想。"}, {"type": "subtitle", "time": 536.949, "timestamp": "00:08:56", "text": "我的口音听起来像美国人，因为我总是滔滔不绝地说话。"}, {"type": "subtitle", "time": 539.19, "timestamp": "00:08:59", "text": "当我遇到一些奇怪的美国陌生人时"}]
[{"type": "subtitle", "time": 2522.309, "timestamp": "00:42:02", "text": "医生。我有医生吗？不。"}, {"type": "subtitle", "time": 2523.99, "timestamp": "00:42:03", "text": "我甚至连一家专门的医院都没有。"}, {"type": "subtitle", "time": 2527.109, "timestamp": "00:42:07", "text": "我们随心所欲地去任何地方。"}, {"type": "subtitle", "time": 2529.27, "timestamp": "00:42:09", "text": "关于我们刚才讨论的另一个话题"}, {"type": "subtitle", "time": 2531.67, "timestamp": "00:42:11", "text": "关于。是的，真的有人这么做了。"}, {"type": "subtitle", "time": 2535.19, "timestamp": "00:42:15", "text": "我得到了名字。我的天啊。什么？你"}, {"type": "subtitle", "time": 2539.349, "timestamp": "00:42:19", "text": "做过？是日本虚拟主播。这是ASMR。"}, {"type": "subtitle", "time": 2541.109, "timestamp": "00:42:21", "text": "YouTuber。"}, {"type": "subtitle", "time": 2549.27, "timestamp": "00:42:29", "text": "降临节之类的。"}, {"type": "subtitle", "time": 2556.79, "timestamp": "00:42:36", "text": "但就像聊聊像谁这样的 YouTuber 一样"}, {"type": "subtitle", "time": 2558.87, "timestamp": "00:42:38", "text": "你最近有没有沉迷于……"}, {"type": "subtitle", "time": 2563.43, "timestamp": "00:42:43", "text": "正在看吗？我没看"}, {"type": "subtitle", "time": 2565.109, "timestamp": "00:42:45", "text": "我只看过一些片段。所以"}, {"type": "subtitle", "time": 2567.99, "timestamp": "00:42:47", "text": "有时我看到一些随机片段"}, {"type": "subtitle", "time": 2570.19, "timestamp": "00:42:50", "text": "还有一些其他的东西，我确实会看。"}, {"type": "subtitle", "time": 2572.87, "timestamp": "00:42:52", "text": "那。我一直没坐下来，"}, {"type": "subtitle", "time": 2577.109, "timestamp": "00:42:57", "text": "目前还喜欢看直播吗？嗯。我是说，"}]
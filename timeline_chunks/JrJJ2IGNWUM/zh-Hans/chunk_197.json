[{"type": "subtitle", "time": 11820.11, "timestamp": "03:17:00", "text": "在哪里？"}, {"type": "subtitle", "time": 11836.79, "timestamp": "03:17:16", "text": "你觉得这边是什么？"}, {"type": "subtitle", "time": 11840.63, "timestamp": "03:17:20", "text": "我的天啊。查看地图。我看到一个"}, {"type": "subtitle", "time": 11843.83, "timestamp": "03:17:23", "text": "敌人。它还在那里。我认为他们"}, {"type": "subtitle", "time": 11847.429, "timestamp": "03:17:27", "text": "战斗结束了。等等，那是什么？"}, {"type": "subtitle", "time": 11851.19, "timestamp": "03:17:31", "text": "小地图上那个绿色的……呃……红色的东西？"}, {"type": "subtitle", "time": 11855.67, "timestamp": "03:17:35", "text": "线圈图。那太酷了。"}]
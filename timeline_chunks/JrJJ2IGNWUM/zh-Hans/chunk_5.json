[{"type": "subtitle", "time": 301.07, "timestamp": "00:05:01", "text": "对自己真实一点。 Windows 11 就是这样一个"}, {"type": "subtitle", "time": 305.43, "timestamp": "00:05:05", "text": "类似操作系统的 dookie dookie"}, {"type": "subtitle", "time": 308.31, "timestamp": "00:05:08", "text": "因为它漏洞百出，所以不用了。我恨它。"}, {"type": "subtitle", "time": 311.15, "timestamp": "00:05:11", "text": "我极其厌恶使用"}, {"type": "subtitle", "time": 312.749, "timestamp": "00:05:12", "text": "它。"}, {"type": "subtitle", "time": 315.35, "timestamp": "00:05:15", "text": "好吧。好的。这就像……"}, {"type": "subtitle", "time": 317.99, "timestamp": "00:05:17", "text": "这是一年内第五次发生这种情况了。"}, {"type": "subtitle", "time": 321.67, "timestamp": "00:05:21", "text": "我真是气死了。哦，不。我想要"}, {"type": "subtitle", "time": 324.39, "timestamp": "00:05:24", "text": "降级回 Windows 10，因为我知道"}, {"type": "subtitle", "time": 327.749, "timestamp": "00:05:27", "text": "Windows 10 的稳定性如何，但就像"}, {"type": "subtitle", "time": 330.39, "timestamp": "00:05:30", "text": "唉，这真的很难做到。"}, {"type": "subtitle", "time": 333.11, "timestamp": "00:05:33", "text": "一切恢复正常运转。没错，没错。"}, {"type": "subtitle", "time": 335.43, "timestamp": "00:05:35", "text": "真的。"}, {"type": "subtitle", "time": 337.029, "timestamp": "00:05:37", "text": "我懒得做启动盘之类的东西。"}, {"type": "subtitle", "time": 341.11, "timestamp": "00:05:41", "text": "USB。所以那是另一回事。"}, {"type": "subtitle", "time": 342.31, "timestamp": "00:05:42", "text": "是啊，你没跟我细说那些事……"}, {"type": "subtitle", "time": 344.87, "timestamp": "00:05:44", "text": "那个移动的东西。你没有"}, {"type": "subtitle", "time": 346.87, "timestamp": "00:05:46", "text": "请详细说说这方面的情况。过去发生了什么"}, {"type": "subtitle", "time": 351.99, "timestamp": "00:05:51", "text": "正在发生？哦，呃，搬家。是的。所以，我"}, {"type": "subtitle", "time": 354.71, "timestamp": "00:05:54", "text": "这些年来，我一直都是那个人。"}, {"type": "subtitle", "time": 356.71, "timestamp": "00:05:56", "text": "我对自己的人生感到迷茫，不知道该何去何从。"}, {"type": "subtitle", "time": 359.749, "timestamp": "00:05:59", "text": "比如没有兼职工作或者没有其他事情"}]
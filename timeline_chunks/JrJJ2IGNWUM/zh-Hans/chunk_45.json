[{"type": "subtitle", "time": 2702.87, "timestamp": "00:45:02", "text": "舒服舒服舒服。是的。它不是。"}, {"type": "subtitle", "time": 2704.63, "timestamp": "00:45:04", "text": "事情就是这样，对吧？什么是"}, {"type": "subtitle", "time": 2707.67, "timestamp": "00:45:07", "text": "层级，例如，层级有哪些？"}, {"type": "subtitle", "time": 2710.309, "timestamp": "00:45:10", "text": "我们这儿有什么小混蛋？正确的？你知道"}, {"type": "subtitle", "time": 2711.51, "timestamp": "00:45:11", "text": "我说的就是这个，对吧，Jockey？"}, {"type": "subtitle", "time": 2714.39, "timestamp": "00:45:14", "text": "比如有哥布林，还有小妖精，"}, {"type": "subtitle", "time": 2717.51, "timestamp": "00:45:17", "text": "有格雷姆利德。"}, {"type": "subtitle", "time": 2719.589, "timestamp": "00:45:19", "text": "我的天啊。就像有很多这样的"}, {"type": "subtitle", "time": 2722.23, "timestamp": "00:45:22", "text": "泪流满面。所以我就想，这是什么情况"}, {"type": "subtitle", "time": 2724.47, "timestamp": "00:45:24", "text": "等级是 Ena 吗？因为她只是个双关语"}, {"type": "subtitle", "time": 2727.67, "timestamp": "00:45:27", "text": "一位乐于享受乐趣的大师。她不是个混蛋。"}, {"type": "subtitle", "time": 2729.67, "timestamp": "00:45:29", "text": "我可以告诉你她不是个混蛋，因为"}, {"type": "subtitle", "time": 2731.829, "timestamp": "00:45:31", "text": "我真是个废物，对吧？"}, {"type": "subtitle", "time": 2733.589, "timestamp": "00:45:33", "text": "但实际上并非如此。我是个小恶魔。"}, {"type": "subtitle", "time": 2735.51, "timestamp": "00:45:35", "text": "错误的。我错了。我错了。有这么多"}, {"type": "subtitle", "time": 2742.39, "timestamp": "00:45:42", "text": "是的。是的。是啊。是的。有"}, {"type": "subtitle", "time": 2745.99, "timestamp": "00:45:45", "text": "小鬼，有小妖精，还有呃……"}, {"type": "subtitle", "time": 2748.309, "timestamp": "00:45:48", "text": "哥布林，太多了，老兄。"}, {"type": "subtitle", "time": 2751.349, "timestamp": "00:45:51", "text": "它叫什么名字？我忘了那是什么了。"}, {"type": "subtitle", "time": 2753.17, "timestamp": "00:45:53", "text": "打电话。哦，我的"}, {"type": "subtitle", "time": 2754.99, "timestamp": "00:45:54", "text": "[音乐]"}]
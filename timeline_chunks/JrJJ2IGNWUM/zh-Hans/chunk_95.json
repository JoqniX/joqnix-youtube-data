[{"type": "subtitle", "time": 5703.51, "timestamp": "01:35:03", "text": "重复乏味。太低俗了。"}, {"type": "subtitle", "time": 5705.91, "timestamp": "01:35:05", "text": "是的，我明白你的意思。"}, {"type": "subtitle", "time": 5707.75, "timestamp": "01:35:07", "text": "差不多吧，老兄。我明白你的意思了。"}, {"type": "subtitle", "time": 5709.51, "timestamp": "01:35:09", "text": "关于。"}, {"type": "subtitle", "time": 5711.75, "timestamp": "01:35:11", "text": "有时候，你就是想要……"}, {"type": "subtitle", "time": 5713.91, "timestamp": "01:35:13", "text": "粉丝的感觉。不管它是不是"}, {"type": "subtitle", "time": 5715.99, "timestamp": "01:35:15", "text": "就像一个被复制粘贴的角色"}, {"type": "subtitle", "time": 5719.51, "timestamp": "01:35:19", "text": "为了自我代入。仍然很有趣"}, {"type": "subtitle", "time": 5722.95, "timestamp": "01:35:22", "text": "读。不过有些情节还不错。我 我"}, {"type": "subtitle", "time": 5725.27, "timestamp": "01:35:25", "text": "如果感觉不到它们，就会扔掉。我"}, {"type": "subtitle", "time": 5726.79, "timestamp": "01:35:26", "text": "仍然会读一些不好看的垃圾书。"}, {"type": "subtitle", "time": 5728.629, "timestamp": "01:35:28", "text": "不一定有什么令人兴奋的事情发生"}, {"type": "subtitle", "time": 5730.75, "timestamp": "01:35:30", "text": "继续"}, {"type": "subtitle", "time": 5733.189, "timestamp": "01:35:33", "text": "他们。好像我其实并没有在寻找什么"}, {"type": "subtitle", "time": 5736.189, "timestamp": "01:35:36", "text": "我把它改造成了一个自动售货机"}, {"type": "subtitle", "time": 5740.07, "timestamp": "01:35:40", "text": "类似异世界机器之类的东西。我"}, {"type": "subtitle", "time": 5742.43, "timestamp": "01:35:42", "text": "觉得这些很有趣，而且它们也很有意思。"}, {"type": "subtitle", "time": 5746.229, "timestamp": "01:35:46", "text": "观看和阅读，但就像等等，不阅读一样。"}, {"type": "subtitle", "time": 5747.669, "timestamp": "01:35:47", "text": "抱歉，我觉得没有动漫"}, {"type": "subtitle", "time": 5749.91, "timestamp": "01:35:49", "text": "尚未实现。有时候会这样"}, {"type": "subtitle", "time": 5752.709, "timestamp": "01:35:52", "text": "就像我被英雄踢出去了一样"}, {"type": "subtitle", "time": 5754.31, "timestamp": "01:35:54", "text": "派对，还有另一个派对，"}, {"type": "subtitle", "time": 5756.709, "timestamp": "01:35:56", "text": "感觉就像我被英雄封禁了一样"}, {"type": "subtitle", "time": 5759.43, "timestamp": "01:35:59", "text": "聚会，感觉一切都一样。"}]
[{"type": "subtitle", "time": 2161.069, "timestamp": "00:36:01", "text": "不，不，我只是看着人们聊天。"}, {"type": "subtitle", "time": 2164.15, "timestamp": "00:36:04", "text": "聊聊，嗯。"}, {"type": "subtitle", "time": 2165.589, "timestamp": "00:36:05", "text": "整个过程是的。你看到的就是"}, {"type": "subtitle", "time": 2167.67, "timestamp": "00:36:07", "text": "评论和"}, {"type": "subtitle", "time": 2170.71, "timestamp": "00:36:10", "text": "是的。是的。真是意料之外。我当时"}, {"type": "subtitle", "time": 2173.99, "timestamp": "00:36:13", "text": "那时我加入了小马宝莉的粉丝圈。我曾是"}, {"type": "subtitle", "time": 2177.27, "timestamp": "00:36:17", "text": "那时候我还是个小马迷。是的。我知道。怪异"}, {"type": "subtitle", "time": 2179.349, "timestamp": "00:36:19", "text": "马匹。"}, {"type": "subtitle", "time": 2181.91, "timestamp": "00:36:21", "text": "脑腐烂现在敲门"}, {"type": "subtitle", "time": 2184.79, "timestamp": "00:36:24", "text": "反而。是的。就像你不必那样"}, {"type": "subtitle", "time": 2187.43, "timestamp": "00:36:27", "text": "寻找类似的东西"}, {"type": "subtitle", "time": 2190.23, "timestamp": "00:36:30", "text": "太棒了，就像老式YouTube一样。"}, {"type": "subtitle", "time": 2191.829, "timestamp": "00:36:31", "text": "正确的？如果你不是那种人"}, {"type": "subtitle", "time": 2193.349, "timestamp": "00:36:33", "text": "看看以前的电子游戏。"}, {"type": "subtitle", "time": 2195.589, "timestamp": "00:36:35", "text": "学校的 YouTube 频道，这只是一个合集。"}, {"type": "subtitle", "time": 2198.19, "timestamp": "00:36:38", "text": "人们随意谈论一只滑稽的猫"}, {"type": "subtitle", "time": 2202.71, "timestamp": "00:36:42", "text": "视频，还有像一些随机的家伙"}, {"type": "subtitle", "time": 2205.829, "timestamp": "00:36:45", "text": "他车的视频。嗯。我觉得就像"}, {"type": "subtitle", "time": 2208.79, "timestamp": "00:36:48", "text": "就像是超级随机发生的一样"}, {"type": "subtitle", "time": 2211.75, "timestamp": "00:36:51", "text": "当时的算法就像个婴儿一样。"}, {"type": "subtitle", "time": 2214.23, "timestamp": "00:36:54", "text": "不管怎样，老兄，你想知道什么"}, {"type": "subtitle", "time": 2215.95, "timestamp": "00:36:55", "text": "某物"}]
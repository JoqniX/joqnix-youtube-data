[{"type": "subtitle", "time": 3242.069, "timestamp": "00:54:02", "text": "我的舌头。这就像一种刺激"}, {"type": "subtitle", "time": 3244.39, "timestamp": "00:54:04", "text": "呃，喉咙上好像有什么东西。就像一个"}, {"type": "subtitle", "time": 3246.549, "timestamp": "00:54:06", "text": "喉咙出现刺激反应"}, {"type": "subtitle", "time": 3248.15, "timestamp": "00:54:08", "text": "比起真正感受到香料的味道，我感觉不到它的存在。"}, {"type": "subtitle", "time": 3252.03, "timestamp": "00:54:12", "text": "舌头。就像"}, {"type": "subtitle", "time": 3254.15, "timestamp": "00:54:14", "text": "是的。你通常会和什么一起吃？"}, {"type": "subtitle", "time": 3258.71, "timestamp": "00:54:18", "text": "你的茶呢，伙计？我只喝茶。我觉得"}, {"type": "subtitle", "time": 3260.71, "timestamp": "00:54:20", "text": "我的身体"}, {"type": "subtitle", "time": 3263.109, "timestamp": "00:54:23", "text": "嗯，我在家泡茶的时候，比如黑茶。"}, {"type": "subtitle", "time": 3267.109, "timestamp": "00:54:27", "text": "在家喝茶，嗯，我以前晚上会喝，因为我"}, {"type": "subtitle", "time": 3271.27, "timestamp": "00:54:31", "text": "膝盖受伤那段时间，我睡不着觉。"}, {"type": "subtitle", "time": 3272.87, "timestamp": "00:54:32", "text": "它叫什么？什么也没有"}, {"type": "subtitle", "time": 3274.79, "timestamp": "00:54:34", "text": "在房子里。我当时就像我想的那样"}, {"type": "subtitle", "time": 3276.87, "timestamp": "00:54:36", "text": "我打算泡杯红茶喝。"}, {"type": "subtitle", "time": 3279.91, "timestamp": "00:54:39", "text": "睡觉。我这样做了一整年。"}, {"type": "subtitle", "time": 3282.069, "timestamp": "00:54:42", "text": "某物。现在我喝黑咖啡的时候"}, {"type": "subtitle", "time": 3285.109, "timestamp": "00:54:45", "text": "喝了茶，我感觉昏昏欲睡。就这么"}, {"type": "subtitle", "time": 3287.43, "timestamp": "00:54:47", "text": "变得像你的屁股一样，就像你的"}, {"type": "subtitle", "time": 3289.51, "timestamp": "00:54:49", "text": "你的身体会发出警报，就像去……"}, {"type": "subtitle", "time": 3292.19, "timestamp": "00:54:52", "text": "睡觉，喝这个，然后去"}, {"type": "subtitle", "time": 3295.589, "timestamp": "00:54:55", "text": "睡觉。呃，给尿布用的黄油饼干，对吧？"}, {"type": "subtitle", "time": 3298.309, "timestamp": "00:54:58", "text": "现在。说实话，我喜欢黄油饼干。"}, {"type": "subtitle", "time": 3299.91, "timestamp": "00:54:59", "text": "但我并不一定带着它们。"}]
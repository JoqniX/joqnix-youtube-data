[{"type": "subtitle", "time": 1142.549, "timestamp": "00:19:02", "text": "胡闹一番。我只是在说话"}, {"type": "subtitle", "time": 1145.99, "timestamp": "00:19:05", "text": "关于生活以及一切。"}, {"type": "subtitle", "time": 1147.59, "timestamp": "00:19:07", "text": "关于生活，还有什么其他的事情是……"}, {"type": "subtitle", "time": 1152.2, "timestamp": "00:19:12", "text": "你觉得它重得像坨屎吗？"}, {"type": "subtitle", "time": 1154.95, "timestamp": "00:19:14", "text": "[音乐]"}, {"type": "subtitle", "time": 1156.19, "timestamp": "00:19:16", "text": "重的？"}, {"type": "subtitle", "time": 1160.47, "timestamp": "00:19:20", "text": "不，是太重了，难以承受。"}, {"type": "subtitle", "time": 1164.87, "timestamp": "00:19:24", "text": "就像“是啊，就是是啊”。"}, {"type": "subtitle", "time": 1166.95, "timestamp": "00:19:26", "text": "呃，我为什么要那样解释呢？为什么"}, {"type": "subtitle", "time": 1169.19, "timestamp": "00:19:29", "text": "是我出了问题吗？为什么是我"}, {"type": "subtitle", "time": 1172.95, "timestamp": "00:19:32", "text": "句子是不是过于复杂了？"}, {"type": "subtitle", "time": 1177.35, "timestamp": "00:19:37", "text": "是的。你知道，至少嗯……"}, {"type": "subtitle", "time": 1181.19, "timestamp": "00:19:41", "text": "生活中的重担大概就是应对……"}, {"type": "subtitle", "time": 1183.43, "timestamp": "00:19:43", "text": "现实生活中的事情，对吧？做你的"}, {"type": "subtitle", "time": 1185.669, "timestamp": "00:19:45", "text": "充满热情的爱好等等，而不是"}, {"type": "subtitle", "time": 1188.87, "timestamp": "00:19:48", "text": "抽出时间做自己想做的事情。"}, {"type": "subtitle", "time": 1191.43, "timestamp": "00:19:51", "text": "我感觉就像你想要的东西。是的。"}, {"type": "subtitle", "time": 1195.029, "timestamp": "00:19:55", "text": "我想做的事情，有时是"}, {"type": "subtitle", "time": 1198.39, "timestamp": "00:19:58", "text": "感觉很多事情都遥不可及。"}]
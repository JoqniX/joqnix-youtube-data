[{"type": "subtitle", "time": 12123.51, "timestamp": "03:22:03", "text": "好的。看，宝贝。下降。来吧，用"}, {"type": "subtitle", "time": 12131.19, "timestamp": "03:22:11", "text": "嘿，我们同舟共济，阿米奇。"}, {"type": "subtitle", "time": 12132.95, "timestamp": "03:22:12", "text": "我们走吧。"}, {"type": "subtitle", "time": 12135.15, "timestamp": "03:22:15", "text": "我认为"}, {"type": "subtitle", "time": 12139.99, "timestamp": "03:22:19", "text": "多支队伍。是的。我们有派对"}, {"type": "subtitle", "time": 12144.63, "timestamp": "03:22:24", "text": "参与竞争的各方。我的天哪。哦"}, {"type": "subtitle", "time": 12155.11, "timestamp": "03:22:35", "text": "某种程度上，它甚至比……更美。"}, {"type": "subtitle", "time": 12170.469, "timestamp": "03:22:50", "text": "我的天哪。"}]
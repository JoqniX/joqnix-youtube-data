[{"type": "subtitle", "time": 1920.149, "timestamp": "00:32:00", "text": "溪流。好吧，你想让我被诅咒。"}, {"type": "subtitle", "time": 1923.35, "timestamp": "00:32:03", "text": "再次？我有可能。我的意思是，你可以是"}, {"type": "subtitle", "time": 1925.35, "timestamp": "00:32:05", "text": "你自己。一切都好。我没有应用程序"}, {"type": "subtitle", "time": 1927.43, "timestamp": "00:32:07", "text": "玩家限制。问题就在这里。"}, {"type": "subtitle", "time": 1931.11, "timestamp": "00:32:11", "text": "对，就像我记得的那样，呃，我以前是怎么用的"}, {"type": "subtitle", "time": 1933.11, "timestamp": "00:32:13", "text": "在互联网上展现自我"}, {"type": "subtitle", "time": 1936.389, "timestamp": "00:32:16", "text": "感觉就像超级吵闹又搞笑。我说话"}, {"type": "subtitle", "time": 1938.35, "timestamp": "00:32:18", "text": "关于一些毫无意义的废话"}, {"type": "subtitle", "time": 1940.63, "timestamp": "00:32:20", "text": "这不合适，我明白。我仍然如此"}, {"type": "subtitle", "time": 1943.11, "timestamp": "00:32:23", "text": "那。我喜欢做这件事。但就像我"}, {"type": "subtitle", "time": 1945.43, "timestamp": "00:32:25", "text": "我没有我那样的精力水平。"}, {"type": "subtitle", "time": 1947.909, "timestamp": "00:32:27", "text": "以前有过，因为我感觉自己像个傻瓜。"}, {"type": "subtitle", "time": 1950.07, "timestamp": "00:32:30", "text": "我年纪大了，正在经历一些新鲜事。"}, {"type": "subtitle", "time": 1954.31, "timestamp": "00:32:34", "text": "正确的？ M，然后我就想，该死，也许我是个"}, {"type": "subtitle", "time": 1956.63, "timestamp": "00:32:36", "text": "有点尴尬，但我本来就有点尴尬。"}, {"type": "subtitle", "time": 1958.35, "timestamp": "00:32:38", "text": "我很高兴"}, {"type": "subtitle", "time": 1961.909, "timestamp": "00:32:41", "text": "我就是这样，你知道吗？就像我"}, {"type": "subtitle", "time": 1964.389, "timestamp": "00:32:44", "text": "想聊聊狂犬病的鸡巴，但是就像"}, {"type": "subtitle", "time": 1965.909, "timestamp": "00:32:45", "text": "其实没人想听我说话。"}, {"type": "subtitle", "time": 1967.43, "timestamp": "00:32:47", "text": "关于兔子的阴茎，除非那是我的"}, {"type": "subtitle", "time": 1968.87, "timestamp": "00:32:48", "text": "会听这类音乐的听众"}, {"type": "subtitle", "time": 1972.07, "timestamp": "00:32:52", "text": "糟透了，对吧？我的天啊。就像我"}, {"type": "subtitle", "time": 1974.07, "timestamp": "00:32:54", "text": "我无法强迫别人喜欢我的东西。"}, {"type": "subtitle", "time": 1976.47, "timestamp": "00:32:56", "text": "喜欢。"}, {"type": "subtitle", "time": 1979.43, "timestamp": "00:32:59", "text": "这是真的。这是真的。是的。我不"}]
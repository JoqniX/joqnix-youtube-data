[{"type": "subtitle", "time": 17040.35, "timestamp": "04:44:00", "text": "呃，找个紧急情况的人来帮忙。"}, {"type": "subtitle", "time": 17043.23, "timestamp": "04:44:03", "text": "中午"}, {"type": "subtitle", "time": 17047.35, "timestamp": "04:44:07", "text": "时间合适，周六中午有三个人。"}, {"type": "subtitle", "time": 17049.99, "timestamp": "04:44:09", "text": "下午6:00至晚上10点然后是晚上10点10分。"}, {"type": "subtitle", "time": 17054.43, "timestamp": "04:44:14", "text": "小组合作。你好，愿望。知道了。我"}, {"type": "subtitle", "time": 17058.23, "timestamp": "04:44:18", "text": "我确实和Vic一起做过这件事，对吧？我"}, {"type": "subtitle", "time": 17061.03, "timestamp": "04:44:21", "text": "确实做了。这些也是群组里的。"}, {"type": "subtitle", "time": 17063.51, "timestamp": "04:44:23", "text": "被视为这样的东西。我确实这么做了。"}, {"type": "subtitle", "time": 17067.11, "timestamp": "04:44:27", "text": "和维克一起。嗯，其实我的确想……"}, {"type": "subtitle", "time": 17069.51, "timestamp": "04:44:29", "text": "再和一些人一起做一次，因为我"}, {"type": "subtitle", "time": 17073.27, "timestamp": "04:44:33", "text": "就像连续狂欢一样，但也"}, {"type": "subtitle", "time": 17077.59, "timestamp": "04:44:37", "text": "我必须对此保持清醒的意识。"}, {"type": "subtitle", "time": 17080.55, "timestamp": "04:44:40", "text": "那相当于给人们两次机会。"}, {"type": "subtitle", "time": 17084.31, "timestamp": "04:44:44", "text": "我得联系上那些我还没联系上的人。"}, {"type": "subtitle", "time": 17088.27, "timestamp": "04:44:48", "text": "我的频道也还没开通。"}, {"type": "subtitle", "time": 17091.43, "timestamp": "04:44:51", "text": "是的。很多人都会说：“哦，我愿意。”"}, {"type": "subtitle", "time": 17093.47, "timestamp": "04:44:53", "text": "想得到呃"}, {"type": "subtitle", "time": 17096.868, "timestamp": "04:44:56", "text": "“春山，日本块茎。”我做了那个"}, {"type": "subtitle", "time": 17099.39, "timestamp": "04:44:59", "text": "仓库协作"}]
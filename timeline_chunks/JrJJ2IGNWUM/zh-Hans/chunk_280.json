[{"type": "subtitle", "time": 16801.39, "timestamp": "04:40:01", "text": "东西。她六月份会来这里。"}, {"type": "subtitle", "time": 16805.07, "timestamp": "04:40:05", "text": "大概。我确实给她发了私信。"}, {"type": "subtitle", "time": 16808.788, "timestamp": "04:40:08", "text": "Instagram。是的。然后我们就会拥有禅宗了。"}, {"type": "subtitle", "time": 16812.31, "timestamp": "04:40:12", "text": "也即将到来。然后是专业星景"}, {"type": "subtitle", "time": 16816.55, "timestamp": "04:40:16", "text": "成员们也暂时离开了。嗯，不，我是"}, {"type": "subtitle", "time": 16822.59, "timestamp": "04:40:22", "text": "呃，"}, {"type": "subtitle", "time": 16825.91, "timestamp": "04:40:25", "text": "新星。不，还没有。呃，他仍然需要"}, {"type": "subtitle", "time": 16830.19, "timestamp": "04:40:30", "text": "请跟我确认一下。新星，禅。"}, {"type": "subtitle", "time": 16834.55, "timestamp": "04:40:34", "text": "嗯，Zen，呃，Salastia，Kyra，那些"}, {"type": "subtitle", "time": 16836.43, "timestamp": "04:40:36", "text": "人们去获取"}, {"type": "subtitle", "time": 16839.91, "timestamp": "04:40:39", "text": "他们。呃，我觉得我没有合适的"}, {"type": "subtitle", "time": 16841.59, "timestamp": "04:40:41", "text": "目前还没有和塞拉斯蒂娅合作过，所以那将会"}, {"type": "subtitle", "time": 16844.708, "timestamp": "04:40:44", "text": "第一次参加。是啊，凯拉也包括在内。我"}, {"type": "subtitle", "time": 16847.59, "timestamp": "04:40:47", "text": "之前曾和她有过一次单独合作。"}, {"type": "subtitle", "time": 16849.51, "timestamp": "04:40:49", "text": "是的。是的。"}, {"type": "subtitle", "time": 16851.47, "timestamp": "04:40:51", "text": "然后是病例线"}, {"type": "subtitle", "time": 16855.43, "timestamp": "04:40:55", "text": "萨苏里对我的身份很感兴趣。"}]
[{"type": "subtitle", "time": 6061.35, "timestamp": "01:41:01", "text": "我觉得还不错。我知道"}, {"type": "subtitle", "time": 6062.91, "timestamp": "01:41:02", "text": "很多人"}, {"type": "subtitle", "time": 6065.109, "timestamp": "01:41:05", "text": "我觉得很多人其实"}, {"type": "subtitle", "time": 6066.629, "timestamp": "01:41:06", "text": "我也很喜欢。我认为总体而言"}, {"type": "subtitle", "time": 6069.83, "timestamp": "01:41:09", "text": "民众普遍认为这是一部好电影。"}, {"type": "subtitle", "time": 6072.149, "timestamp": "01:41:12", "text": "哦，现在想想，现在想想，一个"}, {"type": "subtitle", "time": 6073.99, "timestamp": "01:41:13", "text": "已经有很多优秀的电子游戏改编电影了。"}, {"type": "subtitle", "time": 6075.43, "timestamp": "01:41:15", "text": "出柜。嗯。我大概应该看看"}, {"type": "subtitle", "time": 6078.55, "timestamp": "01:41:18", "text": "索尼克3。我还没看过索尼克3。"}, {"type": "subtitle", "time": 6079.99, "timestamp": "01:41:19", "text": "应该看看。那些是"}, {"type": "subtitle", "time": 6081.669, "timestamp": "01:41:21", "text": "生成的字符和给定的意大利语"}, {"type": "subtitle", "time": 6084.709, "timestamp": "01:41:24", "text": "名字之类的。啊，"}, {"type": "subtitle", "time": 6087.669, "timestamp": "01:41:27", "text": "意思是等，等，等。吃封斋饭。"}, {"type": "subtitle", "time": 6089.51, "timestamp": "01:41:29", "text": "啊，原来是这样。我见过"}, {"type": "subtitle", "time": 6091.03, "timestamp": "01:41:31", "text": "我的世界电影。或许下课后吧。"}, {"type": "subtitle", "time": 6092.31, "timestamp": "01:41:32", "text": "是的，你应该这么做。欢快。它很漂亮"}, {"type": "subtitle", "time": 6096.59, "timestamp": "01:41:36", "text": "好，因为他们不一定非要这样。"}, {"type": "subtitle", "time": 6100.31, "timestamp": "01:41:40", "text": "比如对某些事情过于苛刻"}, {"type": "subtitle", "time": 6102.79, "timestamp": "01:41:42", "text": "他们只是把它当成一个有趣的故事。"}, {"type": "subtitle", "time": 6104.39, "timestamp": "01:41:44", "text": "他们其实并不追求背景故事。"}, {"type": "subtitle", "time": 6107.27, "timestamp": "01:41:47", "text": "准确性之类的东西。他们是"}, {"type": "subtitle", "time": 6108.95, "timestamp": "01:41:48", "text": "只是想做一些类似引用的事情"}, {"type": "subtitle", "time": 6112.229, "timestamp": "01:41:52", "text": "玩游戏，享受其中的乐趣"}, {"type": "subtitle", "time": 6114.35, "timestamp": "01:41:54", "text": "描绘"}, {"type": "subtitle", "time": 6116.95, "timestamp": "01:41:56", "text": "人物。我真的很想看看"}, {"type": "subtitle", "time": 6119.27, "timestamp": "01:41:59", "text": "如果会有一部新电影的话"}]
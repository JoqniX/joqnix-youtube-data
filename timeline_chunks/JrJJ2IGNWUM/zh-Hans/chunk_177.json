[{"type": "subtitle", "time": 10620.79, "timestamp": "02:57:00", "text": "我画的。一段美好的时光。"}, {"type": "subtitle", "time": 10623.75, "timestamp": "02:57:03", "text": "我觉得我们没有“神女”主题。"}, {"type": "subtitle", "time": 10649.03, "timestamp": "02:57:29", "text": "好的，已经上传了。"}, {"type": "subtitle", "time": 10651.79, "timestamp": "02:57:31", "text": "我的电脑"}, {"type": "subtitle", "time": 10665.19, "timestamp": "02:57:45", "text": "好的，我需要补充一点：等等，他们……"}, {"type": "subtitle", "time": 10669.91, "timestamp": "02:57:49", "text": "把这四个人从这东西里移除？"}, {"type": "subtitle", "time": 10671.59, "timestamp": "02:57:51", "text": "是的。"}, {"type": "subtitle", "time": 10676.87, "timestamp": "02:57:56", "text": "哇，这个分数系统。他们把它移走了。"}]
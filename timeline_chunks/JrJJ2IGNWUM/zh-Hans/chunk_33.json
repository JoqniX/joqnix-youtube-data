[{"type": "subtitle", "time": 1981.669, "timestamp": "00:33:01", "text": "知道马丁和帕帕塔是否还在"}, {"type": "subtitle", "time": 1983.029, "timestamp": "00:33:03", "text": "这里，不过，是的，他们上次……"}, {"type": "subtitle", "time": 1986.07, "timestamp": "00:33:06", "text": "溪流。我们当时在谈论狂犬病。"}, {"type": "subtitle", "time": 1989.269, "timestamp": "00:33:09", "text": "呃，它叫什么来着？疯兔不安全"}, {"type": "subtitle", "time": 1993.19, "timestamp": "00:33:13", "text": "用于工作内容。我的天啊。"}, {"type": "subtitle", "time": 1997.509, "timestamp": "00:33:17", "text": "是啊，我们喜欢，伙计，我就是喜欢这些东西。"}, {"type": "subtitle", "time": 1999.83, "timestamp": "00:33:19", "text": "这有点粗俗。这样做有错吗？"}, {"type": "subtitle", "time": 2003.19, "timestamp": "00:33:23", "text": "我？你知道，我只是个普通人。"}, {"type": "subtitle", "time": 2010.95, "timestamp": "00:33:30", "text": "是的。有时候我只是想找人聊聊天。"}, {"type": "subtitle", "time": 2014.789, "timestamp": "00:33:34", "text": "关于诸如此类无意义的话题"}, {"type": "subtitle", "time": 2017.43, "timestamp": "00:33:37", "text": "这完全说不通。兔子平衡"}, {"type": "subtitle", "time": 2019.35, "timestamp": "00:33:39", "text": "他们阴茎上挂着重物。正确，帕特。"}, {"type": "subtitle", "time": 2022.07, "timestamp": "00:33:42", "text": "说得太对了。是的，这里有个im"}, {"type": "subtitle", "time": 2024.47, "timestamp": "00:33:44", "text": "我想我应该还留着那张照片。等等，做"}, {"type": "subtitle", "time": 2026.23, "timestamp": "00:33:46", "text": "我还有那张照片吗？不，我没有。我"}, {"type": "subtitle", "time": 2028.389, "timestamp": "00:33:48", "text": "思考。但我不想和别人分享。"}, {"type": "subtitle", "time": 2030.789, "timestamp": "00:33:50", "text": "你现在就是。不在这个直播流里。我"}, {"type": "subtitle", "time": 2031.99, "timestamp": "00:33:51", "text": "不想让你的眼睛受到损害"}, {"type": "subtitle", "time": 2034.07, "timestamp": "00:33:54", "text": "再次。我知道。因为上帝知道你已经看到了"}, {"type": "subtitle", "time": 2036.71, "timestamp": "00:33:56", "text": "已经很多了。"}, {"type": "subtitle", "time": 2038.99, "timestamp": "00:33:58", "text": "哦，是的，那里有一张类似……的图片"}]
[{"type": "subtitle", "time": 4020.63, "timestamp": "01:07:00", "text": "你把面包发霉的部分剥掉。"}, {"type": "subtitle", "time": 4025.67, "timestamp": "01:07:05", "text": "然后吃掉它？是的，"}, {"type": "subtitle", "time": 4028.069, "timestamp": "01:07:08", "text": "男人。好的。所以，我让人们这样做。"}, {"type": "subtitle", "time": 4030.23, "timestamp": "01:07:10", "text": "但我不是那种会这么做的人。我曾经"}, {"type": "subtitle", "time": 4032.589, "timestamp": "01:07:12", "text": "看到霉菌，我就想，我才不碰呢。"}, {"type": "subtitle", "time": 4035.91, "timestamp": "01:07:15", "text": "那。有孢子。我不喜欢"}, {"type": "subtitle", "time": 4037.67, "timestamp": "01:07:17", "text": "它。"}, {"type": "subtitle", "time": 4039.829, "timestamp": "01:07:19", "text": "里面有微孢子。我已经开始吃了。"}, {"type": "subtitle", "time": 4041.829, "timestamp": "01:07:21", "text": "微塑料。我不需要更多微生物"}, {"type": "subtitle", "time": 4044.47, "timestamp": "01:07:24", "text": "我身体里有屎。当你看着它"}, {"type": "subtitle", "time": 4046.87, "timestamp": "01:07:26", "text": "但它确实有效。我很漂亮"}, {"type": "subtitle", "time": 4048.309, "timestamp": "01:07:28", "text": "当然它仍然有效，因为你不会得到"}, {"type": "subtitle", "time": 4049.829, "timestamp": "01:07:29", "text": "如果脱掉它会生病，对吧，而且只是"}, {"type": "subtitle", "time": 4051.95, "timestamp": "01:07:31", "text": "正常吃面包。"}, {"type": "subtitle", "time": 4053.75, "timestamp": "01:07:33", "text": "是的。"}, {"type": "subtitle", "time": 4055.309, "timestamp": "01:07:35", "text": "但"}, {"type": "subtitle", "time": 4057.99, "timestamp": "01:07:37", "text": "是的。帕特，这真的管用吗？如果"}, {"type": "subtitle", "time": 4059.589, "timestamp": "01:07:39", "text": "我面包的保质期是"}, {"type": "subtitle", "time": 4061.27, "timestamp": "01:07:41", "text": "临近结束时，我只需烤一下面包，"}, {"type": "subtitle", "time": 4063.51, "timestamp": "01:07:43", "text": "吃掉它们。那就像真实的生活一样吗？"}, {"type": "subtitle", "time": 4065.27, "timestamp": "01:07:45", "text": "我之前都不知道的黑客攻击？"}, {"type": "subtitle", "time": 4067.75, "timestamp": "01:07:47", "text": "嗯，这样可以。我已经做过了。是的。"}, {"type": "subtitle", "time": 4070.15, "timestamp": "01:07:50", "text": "妈的。你做过这件事？是的。该死。我"}, {"type": "subtitle", "time": 4071.589, "timestamp": "01:07:51", "text": "必须他妈的开始多做这件事。"}, {"type": "subtitle", "time": 4075.27, "timestamp": "01:07:55", "text": "经常。把面包拿来吃。"}, {"type": "subtitle", "time": 4077.109, "timestamp": "01:07:57", "text": "那样吗？嗯，我真的不知道。"}, {"type": "subtitle", "time": 4078.63, "timestamp": "01:07:58", "text": "即使面包像……一样，也要吃掉它。"}, {"type": "subtitle", "time": 4079.829, "timestamp": "01:07:59", "text": "稍微过期了，因为"}]
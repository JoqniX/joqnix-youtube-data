[{"type": "subtitle", "time": 14359.269, "timestamp": "03:59:19", "text": "注意力。第一滴血。"}, {"type": "subtitle", "time": 14362.15, "timestamp": "03:59:22", "text": "有人先拔头筹。好的。尊重。"}, {"type": "subtitle", "time": 14365.269, "timestamp": "03:59:25", "text": "它在哪里？尼尔一号。第一轮。"}, {"type": "subtitle", "time": 14368.229, "timestamp": "03:59:28", "text": "有人在外面。"}, {"type": "subtitle", "time": 14396.63, "timestamp": "03:59:56", "text": "重新装弹。正在恢复护盾。覆盖"}]
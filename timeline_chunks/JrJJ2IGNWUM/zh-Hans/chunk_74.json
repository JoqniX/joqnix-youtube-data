[{"type": "subtitle", "time": 4440.39, "timestamp": "01:14:00", "text": "但我连那个水平都没达到。我参加了"}, {"type": "subtitle", "time": 4443.99, "timestamp": "01:14:03", "text": "介于两者之间，就像Twinky一样，所以我处于两者之间。"}, {"type": "subtitle", "time": 4445.83, "timestamp": "01:14:05", "text": "中间。我真的什么都运行不了。"}, {"type": "subtitle", "time": 4448.51, "timestamp": "01:14:08", "text": "如果我身处"}, {"type": "subtitle", "time": 4450.99, "timestamp": "01:14:10", "text": "中间。是的，"}, {"type": "subtitle", "time": 4453.03, "timestamp": "01:14:13", "text": "那你呢，杰克？你"}, {"type": "subtitle", "time": 4455.03, "timestamp": "01:14:15", "text": "注意到印度的哥特人比较多吗？"}, {"type": "subtitle", "time": 4459.11, "timestamp": "01:14:19", "text": "那就像个东西？"}, {"type": "subtitle", "time": 4462.39, "timestamp": "01:14:22", "text": "其实我没看到什么。"}, {"type": "subtitle", "time": 4465.35, "timestamp": "01:14:25", "text": "我喜欢，可能是因为我现在不出门吧。"}, {"type": "subtitle", "time": 4467.31, "timestamp": "01:14:27", "text": "好久不见了。"}, {"type": "subtitle", "time": 4471.35, "timestamp": "01:14:31", "text": "啊，因为我现在喜欢出去走走，因为就像"}, {"type": "subtitle", "time": 4473.43, "timestamp": "01:14:33", "text": "给大家一个小提示。非常有帮助"}, {"type": "subtitle", "time": 4474.87, "timestamp": "01:14:34", "text": "道路。如果你们想要一条人生建议，我"}, {"type": "subtitle", "time": 4478.95, "timestamp": "01:14:38", "text": "得到一条人生建议。所以，如果你非常"}, {"type": "subtitle", "time": 4482.149, "timestamp": "01:14:42", "text": "疲惫不堪，没有心情工作。"}, {"type": "subtitle", "time": 4484.63, "timestamp": "01:14:44", "text": "出去走走。不要带你的"}, {"type": "subtitle", "time": 4487.709, "timestamp": "01:14:47", "text": "电话。出去走走，不要……"}, {"type": "subtitle", "time": 4489.75, "timestamp": "01:14:49", "text": "目的地。比如，即使它像"}, {"type": "subtitle", "time": 4491.59, "timestamp": "01:14:51", "text": "只需步行一小段路程，大约20分钟。"}, {"type": "subtitle", "time": 4494.149, "timestamp": "01:14:54", "text": "几分钟，15分钟，都可以。只是"}, {"type": "subtitle", "time": 4496.07, "timestamp": "01:14:56", "text": "出去走走，清醒一下头脑，然后回来"}, {"type": "subtitle", "time": 4497.669, "timestamp": "01:14:57", "text": "回来后，你会开始感觉有点……"}, {"type": "subtitle", "time": 4499.669, "timestamp": "01:14:59", "text": "神清气爽。这是作弊。这是一种生活"}]
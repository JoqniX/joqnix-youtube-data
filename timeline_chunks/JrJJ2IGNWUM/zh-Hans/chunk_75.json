[{"type": "subtitle", "time": 4501.91, "timestamp": "01:15:01", "text": "黑客。我用这个已经很久了。"}, {"type": "subtitle", "time": 4504.55, "timestamp": "01:15:04", "text": "他妈的已经很久很久了。我"}, {"type": "subtitle", "time": 4506.51, "timestamp": "01:15:06", "text": "不知道为什么它有效，但它就是有效。"}, {"type": "subtitle", "time": 4509.669, "timestamp": "01:15:09", "text": "作品。所以，我建议你们使用"}, {"type": "subtitle", "time": 4511.59, "timestamp": "01:15:11", "text": "相反。真的超级实用，"}, {"type": "subtitle", "time": 4513.99, "timestamp": "01:15:13", "text": "男人。它给你的感觉就像一样"}, {"type": "subtitle", "time": 4516.47, "timestamp": "01:15:16", "text": "水平大概是什么？那是什么？"}, {"type": "subtitle", "time": 4518.229, "timestamp": "01:15:18", "text": "叫什么？即使你已经有了动力"}, {"type": "subtitle", "time": 4519.91, "timestamp": "01:15:19", "text": "除了走路和清理你的"}, {"type": "subtitle", "time": 4521.99, "timestamp": "01:15:21", "text": "头。因为你知道那种感觉"}, {"type": "subtitle", "time": 4524.149, "timestamp": "01:15:24", "text": "当你忙于大量工作时"}, {"type": "subtitle", "time": 4525.669, "timestamp": "01:15:25", "text": "然后你就会有那种感觉。"}, {"type": "subtitle", "time": 4527.75, "timestamp": "01:15:27", "text": "就像压力太大或令人难以承受一样。"}, {"type": "subtitle", "time": 4529.91, "timestamp": "01:15:29", "text": "感觉就像你的大脑里充满了……"}, {"type": "subtitle", "time": 4531.59, "timestamp": "01:15:31", "text": "你有很多关于工作的想法"}, {"type": "subtitle", "time": 4533.11, "timestamp": "01:15:33", "text": "实际上已经无法正常工作了，尽管"}, {"type": "subtitle", "time": 4535.83, "timestamp": "01:15:35", "text": "这和你正在做的事情有关。"}, {"type": "subtitle", "time": 4537.27, "timestamp": "01:15:37", "text": "就是这样。就像焕然一新一样。"}, {"type": "subtitle", "time": 4541.03, "timestamp": "01:15:41", "text": "你就像在按F5键刷新你的大脑。"}, {"type": "subtitle", "time": 4542.39, "timestamp": "01:15:42", "text": "你只是在放松大脑而已。"}, {"type": "subtitle", "time": 4544.709, "timestamp": "01:15:44", "text": "这一点。就像，但又"}, {"type": "subtitle", "time": 4546.31, "timestamp": "01:15:46", "text": "这并非适用于所有人。"}, {"type": "subtitle", "time": 4548.39, "timestamp": "01:15:48", "text": "因为并非每个人都生活在一个相当安全的地方。"}, {"type": "subtitle", "time": 4550.31, "timestamp": "01:15:50", "text": "邻里。我一直在做……"}, {"type": "subtitle", "time": 4551.43, "timestamp": "01:15:51", "text": "我稍微查了一下。它是"}, {"type": "subtitle", "time": 4554.229, "timestamp": "01:15:54", "text": "就像那样，就像能够去"}, {"type": "subtitle", "time": 4555.99, "timestamp": "01:15:55", "text": "到户外探索和享受"}, {"type": "subtitle", "time": 4558.709, "timestamp": "01:15:58", "text": "环境很大程度上取决于……"}]
[{"type": "subtitle", "time": 10081.11, "timestamp": "02:48:01", "text": "我为什么要用麦克风？我会难过的。"}, {"type": "subtitle", "time": 10084.349, "timestamp": "02:48:04", "text": "我当时就想，“哇。”有些日子我"}, {"type": "subtitle", "time": 10086.63, "timestamp": "02:48:06", "text": "确信什么事都不会发生"}, {"type": "subtitle", "time": 10088.23, "timestamp": "02:48:08", "text": "谢天谢地。"}, {"type": "subtitle", "time": 10090.429, "timestamp": "02:48:10", "text": "我不用"}, {"type": "subtitle", "time": 10096.71, "timestamp": "02:48:16", "text": "我一点都不喜欢。嗯。我通常"}, {"type": "subtitle", "time": 10099.75, "timestamp": "02:48:19", "text": "比如给通讯员"}, {"type": "subtitle", "time": 10102.08, "timestamp": "02:48:22", "text": "到文本中。"}, {"type": "subtitle", "time": 10103.99, "timestamp": "02:48:23", "text": "[音乐]"}, {"type": "subtitle", "time": 10106.469, "timestamp": "02:48:26", "text": "你怎么抽出时间来把它打出来？"}, {"type": "subtitle", "time": 10110.79, "timestamp": "02:48:30", "text": "当你在游戏中试图说"}, {"type": "subtitle", "time": 10115.99, "timestamp": "02:48:35", "text": "当我情绪低落时，我可以给别人打赏。哦，"}, {"type": "subtitle", "time": 10120.469, "timestamp": "02:48:40", "text": "是的。我倒下了。是的，我可以挂机。"}, {"type": "subtitle", "time": 10125.03, "timestamp": "02:48:45", "text": "安全区域并提供通信。"}, {"type": "subtitle", "time": 10138.19, "timestamp": "02:48:58", "text": "有毒的"}]
[{"type": "subtitle", "time": 4920.709, "timestamp": "01:22:00", "text": "现在就邀请我吧。最后"}, {"type": "subtitle", "time": 4924.39, "timestamp": "01:22:04", "text": "我当时喝的酒感觉就像，哦，糟了，我"}, {"type": "subtitle", "time": 4928.55, "timestamp": "01:22:08", "text": "我想大概喝了20杯杜松子酒吧。"}, {"type": "subtitle", "time": 4931.51, "timestamp": "01:22:11", "text": "20 杯纯杜松子酒。甚至都不是"}, {"type": "subtitle", "time": 4933.35, "timestamp": "01:22:13", "text": "像小酒杯一样。它比镜头还大"}, {"type": "subtitle", "time": 4935.75, "timestamp": "01:22:15", "text": "眼镜。你知道那种塑料杯吗？哦"}, {"type": "subtitle", "time": 4940.709, "timestamp": "01:22:20", "text": "是的。我当时喝得烂醉。我的天哪。但"}, {"type": "subtitle", "time": 4942.629, "timestamp": "01:22:22", "text": "是的，通常别人问起的时候我才会喝酒。"}, {"type": "subtitle", "time": 4944.629, "timestamp": "01:22:24", "text": "这是一个活动类型的事情，你"}, {"type": "subtitle", "time": 4946.55, "timestamp": "01:22:26", "text": "可以出去玩，或者就像真的一样"}, {"type": "subtitle", "time": 4948.47, "timestamp": "01:22:28", "text": "像圣诞节这样的特殊活动，或者"}, {"type": "subtitle", "time": 4950.31, "timestamp": "01:22:30", "text": "就像新年一样。仅此而已"}, {"type": "subtitle", "time": 4951.669, "timestamp": "01:22:31", "text": "我喝酒的时候。我不太清楚。"}, {"type": "subtitle", "time": 4954.95, "timestamp": "01:22:34", "text": "独自饮酒或为了……而饮酒"}, {"type": "subtitle", "time": 4957.51, "timestamp": "01:22:37", "text": "想喝点东西。我不认为这是"}, {"type": "subtitle", "time": 4960.79, "timestamp": "01:22:40", "text": "虽然健康，但我认为这并不好，因为"}, {"type": "subtitle", "time": 4964.39, "timestamp": "01:22:44", "text": "我仍然讨厌那种该死的感觉"}, {"type": "subtitle", "time": 4966.79, "timestamp": "01:22:46", "text": "就像宿醉一样。我简直恨透了它。"}, {"type": "subtitle", "time": 4969.35, "timestamp": "01:22:49", "text": "正确的。"}, {"type": "subtitle", "time": 4971.03, "timestamp": "01:22:51", "text": "是的。杰基，你呢？多少"}, {"type": "subtitle", "time": 4973.43, "timestamp": "01:22:53", "text": "你喝酒吗？你觉得呢？"}, {"type": "subtitle", "time": 4975.189, "timestamp": "01:22:55", "text": "你自己是轻量级选手、中量级选手还是"}, {"type": "subtitle", "time": 4976.79, "timestamp": "01:22:56", "text": "重量级？"}, {"type": "subtitle", "time": 4979.11, "timestamp": "01:22:59", "text": "我体重超轻。我觉得呃"}]
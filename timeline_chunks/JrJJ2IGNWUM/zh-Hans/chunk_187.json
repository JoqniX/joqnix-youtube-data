[{"type": "subtitle", "time": 11223.83, "timestamp": "03:07:03", "text": "我重启游戏两次了，还是不行。"}, {"type": "subtitle", "time": 11227.19, "timestamp": "03:07:07", "text": "呃，我不知道为什么。重启团队。哦，"}, {"type": "subtitle", "time": 11229.19, "timestamp": "03:07:09", "text": "重置“确定”。好的。好的。好的。让我"}, {"type": "subtitle", "time": 11231.91, "timestamp": "03:07:11", "text": "照做。出口。"}, {"type": "subtitle", "time": 11238.59, "timestamp": "03:07:18", "text": "可能是因为我确实收到了更新啊"}, {"type": "subtitle", "time": 11242.59, "timestamp": "03:07:22", "text": "溪流。好吧，我退出。"}, {"type": "subtitle", "time": 11244.79, "timestamp": "03:07:24", "text": "蒸汽。关闭"}, {"type": "subtitle", "time": 11247.389, "timestamp": "03:07:27", "text": "[音乐]"}, {"type": "subtitle", "time": 11256.93, "timestamp": "03:07:36", "text": "打开。发射"}, {"type": "subtitle", "time": 11271.15, "timestamp": "03:07:51", "text": "蒸汽。我看到了CFI。是的。没有更新"}, {"type": "subtitle", "time": 11274.79, "timestamp": "03:07:54", "text": "顶点。哦，我看到更新了。哦。哦。我懂了"}, {"type": "subtitle", "time": 11279.75, "timestamp": "03:07:59", "text": "更新。哦，明白了。我告诉你了。"}]
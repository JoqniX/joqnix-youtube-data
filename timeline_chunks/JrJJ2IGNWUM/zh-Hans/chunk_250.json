[{"type": "subtitle", "time": 15001.269, "timestamp": "04:10:01", "text": "说实话吧。我是唯一真正的"}, {"type": "subtitle", "time": 15004.309, "timestamp": "04:10:04", "text": "冠军在此。我们过去吧。我是"}, {"type": "subtitle", "time": 15007.59, "timestamp": "04:10:07", "text": "好无聊。拉穆尔，"}, {"type": "subtitle", "time": 15010.07, "timestamp": "04:10:10", "text": "别想太多"}, {"type": "subtitle", "time": 15013.189, "timestamp": "04:10:13", "text": "哦，等等。哦，他拿了辛烷值提升剂。那是"}, {"type": "subtitle", "time": 15017.349, "timestamp": "04:10:17", "text": "我为何是亡灵？我根本没意识到"}, {"type": "subtitle", "time": 15023.83, "timestamp": "04:10:23", "text": "我当时就想，等等，为什么会有……"}, {"type": "subtitle", "time": 15026.55, "timestamp": "04:10:26", "text": "亡灵之声？我不是亡灵。我是否"}]
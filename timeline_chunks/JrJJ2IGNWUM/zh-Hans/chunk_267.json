[{"type": "subtitle", "time": 16021.229, "timestamp": "04:27:01", "text": "和你一起玩真的很有趣"}, {"type": "subtitle", "time": 16024.71, "timestamp": "04:27:04", "text": "此外，也喜欢与此合作"}, {"type": "subtitle", "time": 16027.429, "timestamp": "04:27:07", "text": "我们的首次合作。我很高兴我们做到了"}, {"type": "subtitle", "time": 16029.91, "timestamp": "04:27:09", "text": "一切顺利。"}, {"type": "subtitle", "time": 16034.229, "timestamp": "04:27:14", "text": "是的。我，我，我其实不记得了。"}, {"type": "subtitle", "time": 16036.469, "timestamp": "04:27:16", "text": "呃，听到你的声音，听到你在说话，"}, {"type": "subtitle", "time": 16040.55, "timestamp": "04:27:20", "text": "但我认为我们确实聊了一会儿，现在我们"}, {"type": "subtitle", "time": 16043.11, "timestamp": "04:27:23", "text": "我们得再谈谈。"}, {"type": "subtitle", "time": 16048.189, "timestamp": "04:27:28", "text": "感谢"}, {"type": "subtitle", "time": 16052.63, "timestamp": "04:27:32", "text": "你。也祝你今晚睡个好觉"}, {"type": "subtitle", "time": 16060.309, "timestamp": "04:27:40", "text": "晚安。你好。我们有吗？"}, {"type": "subtitle", "time": 16062.79, "timestamp": "04:27:42", "text": "临走前还有什么要宣布的吗？"}, {"type": "subtitle", "time": 16065.11, "timestamp": "04:27:45", "text": "有什么想分享的吗？"}, {"type": "subtitle", "time": 16067.189, "timestamp": "04:27:47", "text": "公告或其他任何事项，当你……"}, {"type": "subtitle", "time": 16079.349, "timestamp": "04:27:59", "text": "我不知道。就像我做梦一样"}]
[{"type": "subtitle", "time": 12317.389, "timestamp": "03:25:17", "text": "他为什么这样做？"}, {"type": "subtitle", "time": 12321.67, "timestamp": "03:25:21", "text": "我重新加载了我的"}, {"type": "subtitle", "time": 12339.11, "timestamp": "03:25:39", "text": "哦，这里有人。等等，等等，等等"}, {"type": "subtitle", "time": 12341.87, "timestamp": "03:25:41", "text": "等待。回去。发现敌人"}, {"type": "subtitle", "time": 12344.51, "timestamp": "03:25:44", "text": "那里。"}, {"type": "subtitle", "time": 12347.19, "timestamp": "03:25:47", "text": "对手在那里。他们或许应该"}, {"type": "subtitle", "time": 12357.75, "timestamp": "03:25:57", "text": "推。"}]
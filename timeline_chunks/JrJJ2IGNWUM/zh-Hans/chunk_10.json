[{"type": "subtitle", "time": 600.949, "timestamp": "00:10:00", "text": "你当时在那儿，因为我觉得这是"}, {"type": "subtitle", "time": 603.389, "timestamp": "00:10:03", "text": "我不知道。也许我"}, {"type": "subtitle", "time": 605.59, "timestamp": "00:10:05", "text": "比如，我不记得了。我想是"}, {"type": "subtitle", "time": 608.55, "timestamp": "00:10:08", "text": "像14岁。不，不是14岁。我想应该是……"}, {"type": "subtitle", "time": 610.949, "timestamp": "00:10:10", "text": "是的，14。是的。我好像就此停止了。"}, {"type": "chat", "time": 611.299, "timestamp": "00:10:11", "author": "@AsAnOtaku", "avatar": "https://yt4.ggpht.com/ytc/AIdro_ml9qi1LKsmPGIy_j3CcCCPBXWFNxXjZJ9lViNDhl_52A=s64-c-k-c0x00ffffff-no-rj", "message": "Otakus unite !"}, {"type": "subtitle", "time": 613.19, "timestamp": "00:10:13", "text": "去上学，然后什么也没做，大概两个小时"}, {"type": "subtitle", "time": 615.75, "timestamp": "00:10:15", "text": "除了玩电子游戏和喜欢之外，多年来一直如此"}, {"type": "subtitle", "time": 619.269, "timestamp": "00:10:19", "text": "做YouTube。我以前也和自己一样。我当时真是太"}, {"type": "subtitle", "time": 620.87, "timestamp": "00:10:20", "text": "我不知道该怎么办，感觉很困惑"}, {"type": "subtitle", "time": 622.63, "timestamp": "00:10:22", "text": "生活。我当时想，我真的想去吗？"}, {"type": "subtitle", "time": 624.389, "timestamp": "00:10:24", "text": "去学校吗？比如，我不知道那是什么"}, {"type": "subtitle", "time": 626.949, "timestamp": "00:10:26", "text": "我真受够了这破事。比如，是"}, {"type": "subtitle", "time": 628.15, "timestamp": "00:10:28", "text": "这真的能帮到我吗？然后我"}, {"type": "subtitle", "time": 629.99, "timestamp": "00:10:29", "text": "突然意识到，该死，我不能去了"}, {"type": "subtitle", "time": 631.59, "timestamp": "00:10:31", "text": "无论身处何地，只要有生活，只要我只是"}, {"type": "subtitle", "time": 633.91, "timestamp": "00:10:33", "text": "我会做这件事。所以，最后我"}, {"type": "subtitle", "time": 635.99, "timestamp": "00:10:35", "text": "继续。然后我就感觉……"}, {"type": "subtitle", "time": 637.75, "timestamp": "00:10:37", "text": "刚参加了一个加速课程"}, {"type": "subtitle", "time": 638.949, "timestamp": "00:10:38", "text": "弥补我这些年没能完成的工作。"}, {"type": "subtitle", "time": 642.509, "timestamp": "00:10:42", "text": "一直在做。然后我又休学了一年。"}, {"type": "subtitle", "time": 645.99, "timestamp": "00:10:45", "text": "离开。所以，我耽搁的时间更多了。是的。"}, {"type": "subtitle", "time": 649.59, "timestamp": "00:10:49", "text": "大学我也在读大学。我快要完成了，因为"}, {"type": "subtitle", "time": 651.43, "timestamp": "00:10:51", "text": "你知道我要走了，我要成为一个完整的"}, {"type": "subtitle", "time": 654.55, "timestamp": "00:10:54", "text": "正式教师。哦，那是在……"}, {"type": "subtitle", "time": 656.31, "timestamp": "00:10:56", "text": "一点。是的。所以，我教得就像"}, {"type": "subtitle", "time": 658.15, "timestamp": "00:10:58", "text": "我将教授语言学，而且喜欢"}]
[{"type": "subtitle", "time": 4560.63, "timestamp": "01:16:00", "text": "呃，环境因素包括"}, {"type": "subtitle", "time": 4562.79, "timestamp": "01:16:02", "text": "公共交通安全"}, {"type": "subtitle", "time": 4564.87, "timestamp": "01:16:04", "text": "步行道等等。呃，你觉得呢？"}, {"type": "subtitle", "time": 4566.709, "timestamp": "01:16:06", "text": "乔，你觉得呢？你认为印度有这样的情况吗？"}, {"type": "subtitle", "time": 4568.87, "timestamp": "01:16:08", "text": "有些人喜欢良好的基础设施。"}, {"type": "subtitle", "time": 4572.47, "timestamp": "01:16:12", "text": "走路之类的，还是就只是这样？"}, {"type": "subtitle", "time": 4575.43, "timestamp": "01:16:15", "text": "有些地方更适合"}, {"type": "subtitle", "time": 4577.669, "timestamp": "01:16:17", "text": "比如更好的步行道等等。"}, {"type": "subtitle", "time": 4581.07, "timestamp": "01:16:21", "text": "比如在我所在的地区，就像步行一样。"}, {"type": "subtitle", "time": 4585.35, "timestamp": "01:16:25", "text": "靠近海岸一侧的地方"}, {"type": "subtitle", "time": 4587.27, "timestamp": "01:16:27", "text": "那里有像船只和游船一样的东西"}, {"type": "subtitle", "time": 4589.03, "timestamp": "01:16:29", "text": "一切都对吧？所以这里就像一个很大的"}, {"type": "subtitle", "time": 4591.99, "timestamp": "01:16:31", "text": "步行场所。现在有健身房了"}, {"type": "subtitle", "time": 4595.83, "timestamp": "01:16:35", "text": "供公众使用的内容。哦，很多"}, {"type": "subtitle", "time": 4597.669, "timestamp": "01:16:37", "text": "事物。我希望这种情况能更频繁一些。喜欢"}, {"type": "subtitle", "time": 4599.99, "timestamp": "01:16:39", "text": "那里还有更多。我希望我们曾经拥有"}, {"type": "subtitle", "time": 4601.27, "timestamp": "01:16:41", "text": "那些我们拥有的东西"}, {"type": "subtitle", "time": 4603.27, "timestamp": "01:16:43", "text": "公共健身房，但是，是的，我们只有……"}, {"type": "subtitle", "time": 4605.51, "timestamp": "01:16:45", "text": "这里有车库健身房，而且像个大品牌"}, {"type": "subtitle", "time": 4608.149, "timestamp": "01:16:48", "text": "像 Anytime Fitness 这样的健身房。我不"}, {"type": "subtitle", "time": 4609.83, "timestamp": "01:16:49", "text": "真的很想去 Anytime Fitness"}, {"type": "subtitle", "time": 4613.31, "timestamp": "01:16:53", "text": "因为它很贵"}, {"type": "subtitle", "time": 4617.11, "timestamp": "01:16:57", "text": "我已经把任何人深深地印在了我的脑海里。"}]
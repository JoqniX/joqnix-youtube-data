[{"type": "subtitle", "time": 7026.51, "timestamp": "01:57:06", "text": "嗨，那是寿司。"}, {"type": "subtitle", "time": 7028.03, "timestamp": "01:57:08", "text": "又名"}, {"type": "subtitle", "time": 7031.83, "timestamp": "01:57:11", "text": "肾脏。谢谢你今天抽出时间。那是"}, {"type": "subtitle", "time": 7034.229, "timestamp": "01:57:14", "text": "和他们聊天、一起玩都非常开心"}, {"type": "subtitle", "time": 7036.709, "timestamp": "01:57:16", "text": "寿司。我们聊了很多。我们实际上"}, {"type": "subtitle", "time": 7039.75, "timestamp": "01:57:19", "text": "话很多。而我当时，实际上，"}, {"type": "subtitle", "time": 7041.99, "timestamp": "01:57:21", "text": "说实话，我很享受。加，"}, {"type": "subtitle", "time": 7044.629, "timestamp": "01:57:24", "text": "在享受这一切的同时，我也如此"}, {"type": "subtitle", "time": 7049.189, "timestamp": "01:57:29", "text": "因为只吃了一点点东西，所以有点困。"}, {"type": "subtitle", "time": 7052.95, "timestamp": "01:57:32", "text": "睡觉。呃，今天只有大约15分钟或"}, {"type": "subtitle", "time": 7057.189, "timestamp": "01:57:37", "text": "某物。但确实有这方面的原因。和"}, {"type": "subtitle", "time": 7061.03, "timestamp": "01:57:41", "text": "呃，接下来是马兰。我们将"}, {"type": "subtitle", "time": 7064.07, "timestamp": "01:57:44", "text": "我问过她，能否在11点之前和她合作。"}, {"type": "subtitle", "time": 7066.39, "timestamp": "01:57:46", "text": "我问她是否可以……"}, {"type": "subtitle", "time": 7069.51, "timestamp": "01:57:49", "text": "比如推迟到11点。所以我们会……"}, {"type": "subtitle", "time": 7071.83, "timestamp": "01:57:51", "text": "拥有 Apex。我们将玩Apex英雄，"}, {"type": "subtitle", "time": 7074.31, "timestamp": "01:57:54", "text": "我们会谈谈。嗯，希望我们能……"}, {"type": "subtitle", "time": 7076.629, "timestamp": "01:57:56", "text": "也在说话。这将是我的第一个"}, {"type": "subtitle", "time": 7079.75, "timestamp": "01:57:59", "text": "这是她第一次与 Marisa 合作。"}]
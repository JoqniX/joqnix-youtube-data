[{"type": "subtitle", "time": 3781.03, "timestamp": "01:03:01", "text": "什么？山露汽水。我希望它能回来。"}, {"type": "subtitle", "time": 3785.43, "timestamp": "01:03:05", "text": "老兄。哦，激浪汽水。是的。"}, {"type": "subtitle", "time": 3786.47, "timestamp": "01:03:06", "text": "好的，稍等。我需要得到一个"}, {"type": "subtitle", "time": 3789.67, "timestamp": "01:03:09", "text": "类似百事蓝色的图片。一秒钟。"}, {"type": "subtitle", "time": 3792.75, "timestamp": "01:03:12", "text": "兄弟，我一直在找"}, {"type": "subtitle", "time": 3795.75, "timestamp": "01:03:15", "text": "这他妈也太长了吧。没人卖它"}, {"type": "subtitle", "time": 3797.27, "timestamp": "01:03:17", "text": "不再这样了，因为我觉得他们完全"}, {"type": "subtitle", "time": 3799.43, "timestamp": "01:03:19", "text": "已停产。是的，它是一种浆果。"}, {"type": "subtitle", "time": 3803.109, "timestamp": "01:03:23", "text": "百事可乐出品的风味可乐汽水。"}, {"type": "subtitle", "time": 3805.19, "timestamp": "01:03:25", "text": "他超爱百事蓝，但是"}, {"type": "subtitle", "time": 3806.87, "timestamp": "01:03:26", "text": "我觉得他把它拔出来了，因为我"}, {"type": "subtitle", "time": 3809.349, "timestamp": "01:03:29", "text": "再也看不到了。我只曾经"}, {"type": "subtitle", "time": 3811.43, "timestamp": "01:03:31", "text": "听说过那些在时代中被提及的人。"}, {"type": "subtitle", "time": 3814.23, "timestamp": "01:03:34", "text": "别这么说，帕特。我并不老。出色地，"}, {"type": "subtitle", "time": 3817.75, "timestamp": "01:03:37", "text": "我是，但感觉自己没那么老。这里，"}, {"type": "subtitle", "time": 3818.829, "timestamp": "01:03:38", "text": "这里。让"}, {"type": "subtitle", "time": 3822.109, "timestamp": "01:03:42", "text": "我复制这张图片"}, {"type": "subtitle", "time": 3824.27, "timestamp": "01:03:44", "text": "地址浏览器"}, {"type": "subtitle", "time": 3826.549, "timestamp": "01:03:46", "text": "来源。如果你们去看直播的话，"}, {"type": "subtitle", "time": 3828.15, "timestamp": "01:03:48", "text": "你会明白的，你会看到我想要的"}, {"type": "subtitle", "time": 3830.789, "timestamp": "01:03:50", "text": "我说的是地狱。就是这款百事可乐"}, {"type": "subtitle", "time": 3833.95, "timestamp": "01:03:53", "text": "蓝色的。这是蓝色的百事可乐。它是浆果"}, {"type": "subtitle", "time": 3837.27, "timestamp": "01:03:57", "text": "调味的。我以前超爱这玩意儿。我"}, {"type": "subtitle", "time": 3839.75, "timestamp": "01:03:59", "text": "我现在仍然很想吃那个，但是"}]
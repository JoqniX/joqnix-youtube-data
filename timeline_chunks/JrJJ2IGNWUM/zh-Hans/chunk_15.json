[{"type": "subtitle", "time": 900.47, "timestamp": "00:15:00", "text": "这就是梦想。是的。成为一种需要。哦"}, {"type": "subtitle", "time": 905.87, "timestamp": "00:15:05", "text": "我的上帝。是的。我几乎没怎么出门"}, {"type": "subtitle", "time": 908.79, "timestamp": "00:15:08", "text": "出门之类的"}, {"type": "subtitle", "time": 910.389, "timestamp": "00:15:10", "text": "男人。当我还是内特的时候，我只是在我的"}, {"type": "subtitle", "time": 912.629, "timestamp": "00:15:12", "text": "一直躺在床上。我当时真的在床上"}, {"type": "subtitle", "time": 916.31, "timestamp": "00:15:16", "text": "腐烂。床臭得要命。"}, {"type": "subtitle", "time": 926.47, "timestamp": "00:15:26", "text": "哦，是的。然后，呃，在某个时候，呃，我的"}, {"type": "subtitle", "time": 930.389, "timestamp": "00:15:30", "text": "爸爸就像在和表弟聊天一样。"}, {"type": "subtitle", "time": 934.629, "timestamp": "00:15:34", "text": "他的远房表亲，嗯……"}, {"type": "subtitle", "time": 937.189, "timestamp": "00:15:37", "text": "大学教授或"}, {"type": "subtitle", "time": 939.59, "timestamp": "00:15:39", "text": "某某或大学教授。所以他"}, {"type": "subtitle", "time": 942.949, "timestamp": "00:15:42", "text": "建议去那里，就像这样"}, {"type": "subtitle", "time": 945.35, "timestamp": "00:15:45", "text": "远程在线大学"}, {"type": "subtitle", "time": 950.629, "timestamp": "00:15:50", "text": "这里有个东西。哦，是的。是的。是的。所以，我"}, {"type": "subtitle", "time": 953.269, "timestamp": "00:15:53", "text": "甚至还向我爸爸提过这个建议。"}, {"type": "subtitle", "time": 955.949, "timestamp": "00:15:55", "text": "由于我无法进入附近的"}, {"type": "subtitle", "time": 959.11, "timestamp": "00:15:59", "text": "大学，他当时想，如果……"}]
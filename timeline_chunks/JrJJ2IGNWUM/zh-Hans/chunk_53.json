[{"type": "subtitle", "time": 3180.47, "timestamp": "00:53:00", "text": "可能晚点再吃。"}, {"type": "subtitle", "time": 3183.19, "timestamp": "00:53:03", "text": "是的，我超爱吃辣的。"}, {"type": "subtitle", "time": 3184.95, "timestamp": "00:53:04", "text": "因为我其实不太受影响。"}, {"type": "subtitle", "time": 3187.829, "timestamp": "00:53:07", "text": "他们做了很多。我只是因为有时候"}, {"type": "subtitle", "time": 3190.71, "timestamp": "00:53:10", "text": "味道隐藏在香料之中。"}, {"type": "subtitle", "time": 3192.39, "timestamp": "00:53:12", "text": "但总的来说，对于普通人来说，我认为"}, {"type": "subtitle", "time": 3193.99, "timestamp": "00:53:13", "text": "香料的味道盖过了其他所有味道。"}, {"type": "subtitle", "time": 3195.589, "timestamp": "00:53:15", "text": "口味。"}, {"type": "subtitle", "time": 3197.349, "timestamp": "00:53:17", "text": "但对我来说，我的调色板似乎太……"}, {"type": "subtitle", "time": 3198.71, "timestamp": "00:53:18", "text": "以前喜欢这样。所以，事情是这样的。喜欢，"}, {"type": "subtitle", "time": 3200.15, "timestamp": "00:53:20", "text": "我们菲律宾人有各种各样的"}, {"type": "subtitle", "time": 3202.23, "timestamp": "00:53:22", "text": "文化，但有时当你来自……"}, {"type": "subtitle", "time": 3206.069, "timestamp": "00:53:26", "text": "人们说，在某个特定地区，你"}, {"type": "subtitle", "time": 3210.19, "timestamp": "00:53:30", "text": "我喜欢吃辣椒。"}, {"type": "subtitle", "time": 3214.39, "timestamp": "00:53:34", "text": "而我恰好也是……的后裔"}, {"type": "subtitle", "time": 3217.349, "timestamp": "00:53:37", "text": "来自该地区的人们。那么，我们开始吧"}, {"type": "subtitle", "time": 3221.63, "timestamp": "00:53:41", "text": "就说我的味蕾已经进化出了一种"}, {"type": "subtitle", "time": 3224.95, "timestamp": "00:53:44", "text": "巨大的，它叫什么来着？呃，一个巨大的"}, {"type": "subtitle", "time": 3228.309, "timestamp": "00:53:48", "text": "对辣椒素的耐受性。我的喉咙还没好。"}, {"type": "subtitle", "time": 3230.069, "timestamp": "00:53:50", "text": "这就是为什么有时候我们喜欢的时候"}, {"type": "subtitle", "time": 3232.23, "timestamp": "00:53:52", "text": "做点辣酱之类的东西，对吧？记住"}, {"type": "subtitle", "time": 3233.99, "timestamp": "00:53:53", "text": "瓦莱兰特，我们喝辣酱的时候"}, {"type": "subtitle", "time": 3236.549, "timestamp": "00:53:56", "text": "有时？呃，我的确还有"}, {"type": "subtitle", "time": 3238.79, "timestamp": "00:53:58", "text": "打嗝，但我感觉不到辣味。"}]
[{"type": "subtitle", "time": 181.55, "timestamp": "00:03:01", "text": "那股劲头。"}, {"type": "subtitle", "time": 184.229, "timestamp": "00:03:04", "text": "是的。你最初玩的是《彩虹六号》。"}, {"type": "subtitle", "time": 187.309, "timestamp": "00:03:07", "text": "围城。我的天啊，"}, {"type": "subtitle", "time": 190.39, "timestamp": "00:03:10", "text": "老兄。我只记得我们"}, {"type": "subtitle", "time": 199.11, "timestamp": "00:03:19", "text": "是啊，那是很久以前的事了。我 我 我"}, {"type": "subtitle", "time": 201.43, "timestamp": "00:03:21", "text": "已经离开太久了。我不"}, {"type": "subtitle", "time": 202.63, "timestamp": "00:03:22", "text": "知道到底发生了什么事"}, {"type": "subtitle", "time": 203.76, "timestamp": "00:03:23", "text": "不再是了。"}, {"type": "subtitle", "time": 205.43, "timestamp": "00:03:25", "text": "[音乐]"}, {"type": "subtitle", "time": 208.869, "timestamp": "00:03:28", "text": "已经过去这么久了。一直是我"}, {"type": "subtitle", "time": 209.71, "timestamp": "00:03:29", "text": "仍然"}, {"type": "subtitle", "time": 213.50900000000001, "timestamp": "00:03:33", "text": "还记得瓦莱兰特吗？呃，牙膏"}, {"type": "subtitle", "time": 215.19, "timestamp": "00:03:35", "text": "溪流。"}, {"type": "subtitle", "time": 218.22899999999998, "timestamp": "00:03:38", "text": "哦，对。当像L这样的人喜欢"}, {"type": "subtitle", "time": 220.39, "timestamp": "00:03:40", "text": "无论谁遭受损失或其他损失，"}, {"type": "subtitle", "time": 222.47, "timestamp": "00:03:42", "text": "我们得他妈的像喝一杯一样喝上一杯"}, {"type": "subtitle", "time": 224.71, "timestamp": "00:03:44", "text": "就像牙膏一样。哦，那就是……"}, {"type": "subtitle", "time": 227.11, "timestamp": "00:03:47", "text": "疯狂的。那些乱七八糟的事。让我看看。"}, {"type": "subtitle", "time": 235.589, "timestamp": "00:03:55", "text": "太好玩了。那是上帝。我想要"}, {"type": "subtitle", "time": 238.07, "timestamp": "00:03:58", "text": "再来一次。"}]
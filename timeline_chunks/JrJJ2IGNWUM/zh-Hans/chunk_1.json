[{"type": "subtitle", "time": 67.75, "timestamp": "00:01:07", "text": "我现在正被它召唤呢。这是"}, {"type": "subtitle", "time": 70.23, "timestamp": "00:01:10", "text": "乔基。"}, {"type": "subtitle", "time": 72.35, "timestamp": "00:01:12", "text": "我记得那个骑师。"}, {"type": "subtitle", "time": 76.429, "timestamp": "00:01:16", "text": "婴儿。你是谁？你是谁？我是"}, {"type": "subtitle", "time": 80.23, "timestamp": "00:01:20", "text": "乔。我是一颗星座。"}, {"type": "subtitle", "time": 84.03, "timestamp": "00:01:24", "text": "你好，寿司。你好吗？它已经"}, {"type": "subtitle", "time": 87.99, "timestamp": "00:01:27", "text": "永远。你好吗？我一直都很好"}, {"type": "subtitle", "time": 90.789, "timestamp": "00:01:30", "text": "你在这里待了一段时间了。我一直"}, {"type": "subtitle", "time": 95.91, "timestamp": "00:01:35", "text": "兄弟，你走了太久了。嗯。"}, {"type": "subtitle", "time": 97.99000000000001, "timestamp": "00:01:37", "text": "坚持，稍等。让我让你像弹跳一样兴奋起来。"}, {"type": "subtitle", "time": 101.59, "timestamp": "00:01:41", "text": "这里是PNG格式的图片。"}, {"type": "subtitle", "time": 104.31, "timestamp": "00:01:44", "text": "兄弟，我是在模仿你。我没有"}, {"type": "subtitle", "time": 107.19, "timestamp": "00:01:47", "text": "睡了一整天。我在开玩笑。但"}, {"type": "subtitle", "time": 109.429, "timestamp": "00:01:49", "text": "你没睡。"}, {"type": "subtitle", "time": 112.38900000000001, "timestamp": "00:01:52", "text": "我没有。我一直忙着各种事情"}, {"type": "chat", "time": 113.702, "timestamp": "00:01:53", "author": "@OtakuArceus", "avatar": "https://yt4.ggpht.com/VSZC0x7e02-tCAnte525GcpFOF0YcSpYQWplJkdg1RARvkQA3ETFxFaiYVshpLrqHFKUMz4VmA=s64-c-k-c0x00ffffff-no-rj", "message": "ello~"}, {"type": "subtitle", "time": 115.749, "timestamp": "00:01:55", "text": "现实生活中。但我当时想，他们其实不可能真的做到。"}, {"type": "subtitle", "time": 118.31, "timestamp": "00:01:58", "text": "有时间，你知道，去做"}]
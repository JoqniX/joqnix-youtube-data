[{"type": "subtitle", "time": 15605.309, "timestamp": "04:20:05", "text": "我可以等。我"}, {"type": "subtitle", "time": 15608.229, "timestamp": "04:20:08", "text": "听到了敌人的声音。"}, {"type": "subtitle", "time": 15609.55, "timestamp": "04:20:09", "text": "你听说了吗？"}, {"type": "subtitle", "time": 15612.469, "timestamp": "04:20:12", "text": "它？他开了一枪。他们本不应该"}, {"type": "subtitle", "time": 15615.59, "timestamp": "04:20:15", "text": "放弃了。等待。决不。"}, {"type": "subtitle", "time": 15617.87, "timestamp": "04:20:17", "text": "我们在游戏中可以在哪里见面？这是我"}, {"type": "subtitle", "time": 15621.07, "timestamp": "04:20:21", "text": "第一直播狙击手"}, {"type": "subtitle", "time": 15623.429, "timestamp": "04:20:23", "text": "经验。我的天啊。我们在哪里可以"}, {"type": "subtitle", "time": 15626.07, "timestamp": "04:20:26", "text": "见面？"}, {"type": "subtitle", "time": 15629.269, "timestamp": "04:20:29", "text": "我的意思是，他就在那里。"}, {"type": "subtitle", "time": 15641.469, "timestamp": "04:20:41", "text": "想象一下，如果那不是他呢。等等，那是"}, {"type": "subtitle", "time": 15647.99, "timestamp": "04:20:47", "text": "你？等等，Roku，是你吗？等等，不对。"}, {"type": "subtitle", "time": 15649.83, "timestamp": "04:20:49", "text": "等待，"}, {"type": "subtitle", "time": 15653.11, "timestamp": "04:20:53", "text": "等等，等等，等等。我想确认一下。"}]
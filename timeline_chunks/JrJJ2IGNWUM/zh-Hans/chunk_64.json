[{"type": "subtitle", "time": 3842.71, "timestamp": "01:04:02", "text": "我不知道哪里可以买到。最后"}, {"type": "subtitle", "time": 3845.91, "timestamp": "01:04:05", "text": "我买东西的那家店就像……"}, {"type": "subtitle", "time": 3847.51, "timestamp": "01:04:07", "text": "当我接老婆的时候，她"}, {"type": "subtitle", "time": 3850.87, "timestamp": "01:04:10", "text": "以前住在城里，呃，在"}, {"type": "subtitle", "time": 3854.069, "timestamp": "01:04:14", "text": "这家店看起来真奇怪。就像真的"}, {"type": "subtitle", "time": 3858.109, "timestamp": "01:04:18", "text": "看起来很奇怪，呃，那是什么？"}, {"type": "subtitle", "time": 3861.27, "timestamp": "01:04:21", "text": "叫什么？ Si 商店。我不知道姐姐"}, {"type": "subtitle", "time": 3863.91, "timestamp": "01:04:23", "text": "商店界面为英文。呃，稍等一下。让我"}, {"type": "subtitle", "time": 3865.589, "timestamp": "01:04:25", "text": "让我来翻译一下。沙特阿拉伯"}, {"type": "subtitle", "time": 3868.829, "timestamp": "01:04:28", "text": "英文中的悲伤商店。就像"}, {"type": "subtitle", "time": 3873.99, "timestamp": "01:04:33", "text": "一家社区乡村商店"}, {"type": "subtitle", "time": 3876.39, "timestamp": "01:04:36", "text": "或者便利店。但无论何时你"}, {"type": "subtitle", "time": 3877.51, "timestamp": "01:04:37", "text": "想想便利店，你不会想到"}, {"type": "subtitle", "time": 3879.829, "timestamp": "01:04:39", "text": "真的感觉像个妈妈一样"}, {"type": "subtitle", "time": 3883.27, "timestamp": "01:04:43", "text": "popun 小型杂货店。"}, {"type": "subtitle", "time": 3884.71, "timestamp": "01:04:44", "text": "那甚至都不是杂货店那种类型的。它是"}, {"type": "subtitle", "time": 3887.19, "timestamp": "01:04:47", "text": "只是一个小开口"}, {"type": "subtitle", "time": 3889.109, "timestamp": "01:04:49", "text": "里面装着你根本无法想象的东西"}, {"type": "subtitle", "time": 3890.39, "timestamp": "01:04:50", "text": "进入。你只要向他们要就行了。"}, {"type": "subtitle", "time": 3891.829, "timestamp": "01:04:51", "text": "一些东西，他们就这么给了你"}, {"type": "subtitle", "time": 3894.15, "timestamp": "01:04:54", "text": "然后你付钱。应该多买一些的。"}, {"type": "subtitle", "time": 3895.71, "timestamp": "01:04:55", "text": "比一个还多。"}, {"type": "subtitle", "time": 3898.95, "timestamp": "01:04:58", "text": "兄弟，事情是这样的。我可能会喜欢它。"}]
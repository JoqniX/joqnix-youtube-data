[{"type": "subtitle", "time": 15605.309, "timestamp": "04:20:05", "text": "I mean I can wait. I"}, {"type": "subtitle", "time": 15608.229, "timestamp": "04:20:08", "text": "heard the enemy."}, {"type": "subtitle", "time": 15609.55, "timestamp": "04:20:09", "text": "Did you hear"}, {"type": "subtitle", "time": 15612.469, "timestamp": "04:20:12", "text": "it? He shot once. They should not have"}, {"type": "subtitle", "time": 15615.59, "timestamp": "04:20:15", "text": "given up. Wait. No way."}, {"type": "subtitle", "time": 15617.87, "timestamp": "04:20:17", "text": "Where can we meet in game? This was my"}, {"type": "subtitle", "time": 15621.07, "timestamp": "04:20:21", "text": "first stream sniper"}, {"type": "subtitle", "time": 15623.429, "timestamp": "04:20:23", "text": "experience. Oh my god. Where can we"}, {"type": "subtitle", "time": 15626.07, "timestamp": "04:20:26", "text": "meet?"}, {"type": "subtitle", "time": 15629.269, "timestamp": "04:20:29", "text": "I mean, he's there."}, {"type": "subtitle", "time": 15641.469, "timestamp": "04:20:41", "text": "Imagine if that's not him. Wait, that's"}, {"type": "subtitle", "time": 15647.99, "timestamp": "04:20:47", "text": "you? Wait, Roku, is that you? Wait, no."}, {"type": "subtitle", "time": 15649.83, "timestamp": "04:20:49", "text": "Wait,"}, {"type": "subtitle", "time": 15653.11, "timestamp": "04:20:53", "text": "wait, wait, wait. I want to confirm."}]
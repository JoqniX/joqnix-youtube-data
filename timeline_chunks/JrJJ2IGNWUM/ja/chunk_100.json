[{"type": "subtitle", "time": 6002.229, "timestamp": "01:40:02", "text": "私はまだあのミームの意味が理解できません。"}, {"type": "subtitle", "time": 6003.59, "timestamp": "01:40:03", "text": "ごめんなさい。人々は彼らに説明しました"}, {"type": "subtitle", "time": 6006.31, "timestamp": "01:40:06", "text": "自分。私は新しい脳のローテーションを絶対に理解できないだろう。"}, {"type": "subtitle", "time": 6007.99, "timestamp": "01:40:07", "text": "非常識な。"}, {"type": "subtitle", "time": 6010.79, "timestamp": "01:40:10", "text": "もう一つは何だったっけ？"}, {"type": "subtitle", "time": 6012.55, "timestamp": "01:40:12", "text": "うん。"}, {"type": "subtitle", "time": 6020.39, "timestamp": "01:40:20", "text": "バットマンのことですよね？野球好きの男。"}, {"type": "subtitle", "time": 6024.229, "timestamp": "01:40:24", "text": "変な顔をしたやつ。うん。しかし"}, {"type": "subtitle", "time": 6026.47, "timestamp": "01:40:26", "text": "うん、君はたぶん知らないと思うけど"}, {"type": "subtitle", "time": 6027.99, "timestamp": "01:40:27", "text": "当時マインクラフトの映画を見たが、"}, {"type": "subtitle", "time": 6029.51, "timestamp": "01:40:29", "text": "まるでマインクラフトの映画みたい"}, {"type": "subtitle", "time": 6032.07, "timestamp": "01:40:32", "text": "ここ。ああ、見ましたよ。マインクラフトのように"}, {"type": "subtitle", "time": 6034.39, "timestamp": "01:40:34", "text": "映画。ごめん。マインクラフトの映画。ごめん。"}, {"type": "subtitle", "time": 6038.229, "timestamp": "01:40:38", "text": "マインクラフトの映画ではありません。ああ、そうだね、"}, {"type": "subtitle", "time": 6040.55, "timestamp": "01:40:40", "text": "なぜなら、彼らはそれを望まないからです。"}, {"type": "subtitle", "time": 6042.109, "timestamp": "01:40:42", "text": "生成された例"}, {"type": "subtitle", "time": 6045.669, "timestamp": "01:40:45", "text": "マインクラフトについての唯一の映画は"}, {"type": "subtitle", "time": 6047.109, "timestamp": "01:40:47", "text": "それは要点ではない"}, {"type": "subtitle", "time": 6049.03, "timestamp": "01:40:49", "text": "について。それはただ彼らの解釈です"}, {"type": "subtitle", "time": 6051.99, "timestamp": "01:40:51", "text": "彼らはマインクラフトの映画が"}, {"type": "subtitle", "time": 6054.39, "timestamp": "01:40:54", "text": "のように。こちらです。これはマインクラフトではありません"}, {"type": "subtitle", "time": 6056.83, "timestamp": "01:40:56", "text": "映画だけど、うん、私にとっては、"}]
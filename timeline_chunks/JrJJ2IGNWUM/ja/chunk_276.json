[{"type": "subtitle", "time": 16561.109, "timestamp": "04:36:01", "text": "うん、もう少し入れてみようかな"}, {"type": "subtitle", "time": 16565.59, "timestamp": "04:36:05", "text": "人々。えっと、まだ試してみたいんだけど"}, {"type": "subtitle", "time": 16567.629, "timestamp": "04:36:07", "text": "私のお気に入り"}, {"type": "subtitle", "time": 16571.429, "timestamp": "04:36:11", "text": "えっと、ちょっとだけ人を投入する"}, {"type": "subtitle", "time": 16573.99, "timestamp": "04:36:13", "text": "少なくともそれは一種のハングのようなもの"}, {"type": "subtitle", "time": 16577.39, "timestamp": "04:36:17", "text": "放送中。たとえ同様の問題があったとしても"}, {"type": "subtitle", "time": 16580.47, "timestamp": "04:36:20", "text": "えーと、どのゲームをプレイするか、それが"}, {"type": "subtitle", "time": 16584.589, "timestamp": "04:36:24", "text": "問題全体。今、どんなゲームをプレイしようかな？"}, {"type": "subtitle", "time": 16586.429, "timestamp": "04:36:26", "text": "[音楽]"}, {"type": "subtitle", "time": 16587.65, "timestamp": "04:36:27", "text": "うん。"}, {"type": "subtitle", "time": 16590.189, "timestamp": "04:36:30", "text": "[音楽]"}, {"type": "subtitle", "time": 16592.869, "timestamp": "04:36:32", "text": "ええ、自由な人もいます"}, {"type": "chat", "time": 16596.103, "timestamp": "04:36:36", "author": "@Roku-rin", "avatar": "https://yt4.ggpht.com/8LlS_C2IirDMfA5r2V0q5G1kudp8dmG6RQvz_jCAUT3H-esyEgTNPDwrfCXiyX7Undc9UmHNgw=s64-c-k-c0x00ffffff-no-rj", "message": "its ur choice i would reccomend doing with people who didnt get time to collab with"}, {"type": "subtitle", "time": 16597.75, "timestamp": "04:36:37", "text": "今週末、私はどのようにすればいいのかわかりません。"}, {"type": "subtitle", "time": 16605.91, "timestamp": "04:36:45", "text": "ええ、それは私がお勧めする選択肢です"}, {"type": "subtitle", "time": 16607.51, "timestamp": "04:36:47", "text": "時間のない人たちと一緒にそれを行う"}, {"type": "chat", "time": 16608.481, "timestamp": "04:36:48", "author": "@Roku-rin", "avatar": "https://yt4.ggpht.com/8LlS_C2IirDMfA5r2V0q5G1kudp8dmG6RQvz_jCAUT3H-esyEgTNPDwrfCXiyX7Undc9UmHNgw=s64-c-k-c0x00ffffff-no-rj", "message": "keep people like us in later or dont mind me at all"}, {"type": "subtitle", "time": 16608.91, "timestamp": "04:36:48", "text": "協力する"}, {"type": "subtitle", "time": 16611.83, "timestamp": "04:36:51", "text": "一緒にコラボレーションする時間が取れないだろう。"}, {"type": "subtitle", "time": 16614.23, "timestamp": "04:36:54", "text": "しばらくコラボしてないな"}, {"type": "subtitle", "time": 16616.629, "timestamp": "04:36:56", "text": "うん。うん。うん。うん。だから、"}, {"type": "subtitle", "time": 16618.629, "timestamp": "04:36:58", "text": "後々、私たちのような幸運な人々が現れる。気にしないで"}]
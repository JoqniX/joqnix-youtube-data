[{"type": "subtitle", "time": 6121.99, "timestamp": "01:42:01", "text": "彼らはどのように描写するつもりか"}, {"type": "subtitle", "time": 6125.03, "timestamp": "01:42:05", "text": "主役の女性と村人が"}, {"type": "subtitle", "time": 6127.35, "timestamp": "01:42:07", "text": "彼らに子供がいるかどうか確認する。見たい"}, {"type": "subtitle", "time": 6131.43, "timestamp": "01:42:11", "text": "そういうことが起こる。うん。まるで現実の"}, {"type": "subtitle", "time": 6133.87, "timestamp": "01:42:13", "text": "女性とマインクラフト"}, {"type": "subtitle", "time": 6136.47, "timestamp": "01:42:16", "text": "村人が赤ちゃんを産む。見たい"}, {"type": "subtitle", "time": 6138.67, "timestamp": "01:42:18", "text": "それがどんなものか。"}, {"type": "subtitle", "time": 6140.709, "timestamp": "01:42:20", "text": "[音楽]"}, {"type": "subtitle", "time": 6144.31, "timestamp": "01:42:24", "text": "ええと、ジョッキー、君はどう？"}, {"type": "subtitle", "time": 6146.47, "timestamp": "01:42:26", "text": "何に興味がありますか？もしあなたが"}, {"type": "subtitle", "time": 6148.31, "timestamp": "01:42:28", "text": "マインクラフトの映画を作るには、実際にはどうすればいいのでしょうか"}, {"type": "subtitle", "time": 6150.27, "timestamp": "01:42:30", "text": "どうやって作るか"}, {"type": "subtitle", "time": 6153.51, "timestamp": "01:42:33", "text": "それ？現実世界と同じように？つまり、何か"}, {"type": "subtitle", "time": 6155.43, "timestamp": "01:42:35", "text": "マインクラフトの映画のような、そういうタイプの"}, {"type": "subtitle", "time": 6160.92, "timestamp": "01:42:40", "text": "そういうタイプの スタイル。ええ、今の"}, {"type": "subtitle", "time": 6165.84, "timestamp": "01:42:45", "text": "スタイル。ええ、今の 伝説の人物が登場する映画、"}, {"type": "subtitle", "time": 6168.48, "timestamp": "01:42:48", "text": "伝説の人物が登場する映画、 右？うん。そう、伝説の人たちだ。ええ、私は"}, {"type": "subtitle", "time": 6172.32, "timestamp": "01:42:52", "text": "右？うん。そう、伝説の人たちだ。ええ、私は マインクラフト レジェンド。"}, {"type": "subtitle", "time": 6175.199, "timestamp": "01:42:55", "text": "マインクラフト レジェンド。 私は...するだろう"}, {"type": "subtitle", "time": 6176.44, "timestamp": "01:42:56", "text": "私は...するだろう 欲しい"}, {"type": "subtitle", "time": 6179.639, "timestamp": "01:42:59", "text": "欲しい 世界についてもっと知りたい"}]
[{"type": "subtitle", "time": 15180.55, "timestamp": "04:13:00", "text": "人生。"}, {"type": "subtitle", "time": 15183.11, "timestamp": "04:13:03", "text": "そこに敵がいる。彼らはそうすべきではなかった"}, {"type": "subtitle", "time": 15184.95, "timestamp": "04:13:04", "text": "彼らはその地位を放棄した。健康になる"}, {"type": "subtitle", "time": 15215.67, "timestamp": "04:13:35", "text": "立ち往生。はい、戻ってきました。"}, {"type": "subtitle", "time": 15218.229, "timestamp": "04:13:38", "text": "私があなたに何か借りがあると思わないでください。"}, {"type": "subtitle", "time": 15219.83, "timestamp": "04:13:39", "text": "その敵は追跡されている。入手"}, {"type": "subtitle", "time": 15227.51, "timestamp": "04:13:47", "text": "ここに1つあります。"}]
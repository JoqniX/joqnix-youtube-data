[{"type": "subtitle", "time": 5881.35, "timestamp": "01:38:01", "text": "アイデアは、あなたがすでに自分のアイデアだと思っているから"}, {"type": "subtitle", "time": 5885.109, "timestamp": "01:38:05", "text": "もっといい文章を書けよ、わかるだろ？"}, {"type": "subtitle", "time": 5886.87, "timestamp": "01:38:06", "text": "うん。具体的に何ですか"}, {"type": "subtitle", "time": 5888.149, "timestamp": "01:38:08", "text": "何のことですか？何かありますか？"}, {"type": "subtitle", "time": 5896.43, "timestamp": "01:38:16", "text": "えっと、何だったの？"}, {"type": "subtitle", "time": 5900.189, "timestamp": "01:38:20", "text": "私の名前は何ですか、あのアニメは何でしたか"}, {"type": "subtitle", "time": 5902.03, "timestamp": "01:38:22", "text": "また？"}, {"type": "subtitle", "time": 5905.83, "timestamp": "01:38:25", "text": "えっと、名前を忘れちゃった。"}, {"type": "subtitle", "time": 5909.109, "timestamp": "01:38:29", "text": "タイムトラベルを題材にしたアニメは、全く記憶にない。"}, {"type": "subtitle", "time": 5910.629, "timestamp": "01:38:30", "text": "私は中国語の短いクリップを見ました"}, {"type": "subtitle", "time": 5912.149, "timestamp": "01:38:32", "text": "再生と"}, {"type": "subtitle", "time": 5914.99, "timestamp": "01:38:34", "text": "復讐として、そして私はそれらを楽しんでいます"}, {"type": "subtitle", "time": 5917.83, "timestamp": "01:38:37", "text": "ああ、私は実際にそれらを見たことがありません"}, {"type": "subtitle", "time": 5919.83, "timestamp": "01:38:39", "text": "中国ドラマだけど、うん、君は"}, {"type": "subtitle", "time": 5923.51, "timestamp": "01:38:43", "text": "その名の由来となったスタインズゲートを覚えておいてください"}, {"type": "subtitle", "time": 5926.31, "timestamp": "01:38:46", "text": "実際に完成させたことはない"}, {"type": "subtitle", "time": 5928.229, "timestamp": "01:38:48", "text": "1エピソードだけ見て、"}, {"type": "subtitle", "time": 5930.149, "timestamp": "01:38:50", "text": "本当にそこまでの熱中は"}, {"type": "subtitle", "time": 5931.27, "timestamp": "01:38:51", "text": "それを置いて別のものを見た"}, {"type": "subtitle", "time": 5932.55, "timestamp": "01:38:52", "text": "でもそれはすごく昔のことだったから、たぶん"}, {"type": "subtitle", "time": 5938.39, "timestamp": "01:38:58", "text": "Stegateはまだ2つ完成させていない。"}]
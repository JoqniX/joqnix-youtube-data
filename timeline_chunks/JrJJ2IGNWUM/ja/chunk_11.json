[{"type": "subtitle", "time": 660.47, "timestamp": "00:11:00", "text": "主に英語教師"}, {"type": "subtitle", "time": 662.79, "timestamp": "00:11:02", "text": "英文学を専攻しています。でも、そうですね、私は"}, {"type": "subtitle", "time": 665.269, "timestamp": "00:11:05", "text": "私はボートに乗っていて、"}, {"type": "subtitle", "time": 667.67, "timestamp": "00:11:07", "text": "すごく綺麗だったし、誇りに思った。私はしません"}, {"type": "subtitle", "time": 669.269, "timestamp": "00:11:09", "text": "なぜ自分がそれらのことを誇りに思っていたのか、自分でもわからない。"}, {"type": "subtitle", "time": 672.31, "timestamp": "00:11:12", "text": "彼と同じように、私も何もしていませんでした。"}, {"type": "subtitle", "time": 676.63, "timestamp": "00:11:16", "text": "まるでシャワーをほとんど浴びていないかのようだった。何てことだ。"}, {"type": "subtitle", "time": 678.87, "timestamp": "00:11:18", "text": "そんなにひどかったのか。そして私がしてきたこと"}, {"type": "subtitle", "time": 682.069, "timestamp": "00:11:22", "text": "一日中起き上がるのは"}, {"type": "subtitle", "time": 684.47, "timestamp": "00:11:24", "text": "私のベッドから携帯電話を取り出して"}, {"type": "subtitle", "time": 686.23, "timestamp": "00:11:26", "text": "2時間ほど充電して"}, {"type": "subtitle", "time": 688.79, "timestamp": "00:11:28", "text": "「トーラム」を聴いてみて"}, {"type": "subtitle", "time": 692.63, "timestamp": "00:11:32", "text": "オンライン？はい。うん。私はそれをプレイしました"}, {"type": "subtitle", "time": 694.71, "timestamp": "00:11:34", "text": "150くらいまで到達したと思う"}, {"type": "subtitle", "time": 697.91, "timestamp": "00:11:37", "text": "当時のレベル上限。私は本当に"}, {"type": "subtitle", "time": 699.99, "timestamp": "00:11:39", "text": "その後はプレイをやめて、"}, {"type": "subtitle", "time": 702.79, "timestamp": "00:11:42", "text": "YouTubeを始めて以来"}, {"type": "subtitle", "time": 705.03, "timestamp": "00:11:45", "text": "私たちが引っ越した街のように"}, {"type": "subtitle", "time": 707.59, "timestamp": "00:11:47", "text": "フィリピンの中心部。だからそこに"}, {"type": "subtitle", "time": 709.91, "timestamp": "00:11:49", "text": "それがあって、私は好きにならざるを得なかった"}, {"type": "subtitle", "time": 712.389, "timestamp": "00:11:52", "text": "友達がいないみたいに考える"}, {"type": "subtitle", "time": 715.509, "timestamp": "00:11:55", "text": "ここ。えっと、自分がどこにいるのか分かりません。私"}, {"type": "subtitle", "time": 717.43, "timestamp": "00:11:57", "text": "私はしないつもりです"}, {"type": "subtitle", "time": 718.949, "timestamp": "00:11:58", "text": "私がここに留まるつもりなら、"}]
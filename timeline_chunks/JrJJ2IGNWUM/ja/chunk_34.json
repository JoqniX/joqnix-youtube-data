[{"type": "subtitle", "time": 2042.509, "timestamp": "00:34:02", "text": "狂犬病のように"}, {"type": "subtitle", "time": 2047.59, "timestamp": "00:34:07", "text": "白人少年スタイルで、いいね"}, {"type": "subtitle", "time": 2051.27, "timestamp": "00:34:11", "text": "えーっと、ベンチプレスで10kgくらいの重さ"}, {"type": "subtitle", "time": 2054.71, "timestamp": "00:34:14", "text": "彼が小便をするようにバランスを取っている"}, {"type": "subtitle", "time": 2056.79, "timestamp": "00:34:16", "text": "両腕を体の横に下ろして。彼はただバランスを取ろうとしているだけだ"}, {"type": "subtitle", "time": 2059.99, "timestamp": "00:34:19", "text": "それをおしっこに乗せる。"}, {"type": "subtitle", "time": 2063.829, "timestamp": "00:34:23", "text": "何てことだ。何？インターネットはクレイジーだ"}, {"type": "subtitle", "time": 2066.23, "timestamp": "00:34:26", "text": "そういうことですよね？ご存知の通り、私は育てられました"}, {"type": "subtitle", "time": 2069.99, "timestamp": "00:34:29", "text": "そして、無制限のアクセスによって形作られ、"}, {"type": "subtitle", "time": 2073.669, "timestamp": "00:34:33", "text": "インターネット。やあ、ヤッピー。不気味だ。ええ、そうです"}, {"type": "subtitle", "time": 2075.589, "timestamp": "00:34:35", "text": "不気味だ。私はちょっと変わった人間で、"}, {"type": "subtitle", "time": 2077.55, "timestamp": "00:34:37", "text": "嘘をつくつもりだ。うん、"}, {"type": "subtitle", "time": 2080.31, "timestamp": "00:34:40", "text": "インターネットへの無制限アクセス"}, {"type": "subtitle", "time": 2083.589, "timestamp": "00:34:43", "text": "幼い頃から。本当に台無しにする"}, {"type": "subtitle", "time": 2085.349, "timestamp": "00:34:45", "text": "子供。そう、だってこういうことなんだよ、"}, {"type": "subtitle", "time": 2087.27, "timestamp": "00:34:47", "text": "右？今では、それはただのアルゴリズムだ"}, {"type": "subtitle", "time": 2089.909, "timestamp": "00:34:49", "text": "あなたが何を望んでいると思うかをあなたに伝える"}, {"type": "subtitle", "time": 2092.75, "timestamp": "00:34:52", "text": "見る。でも私の"}, {"type": "subtitle", "time": 2096.23, "timestamp": "00:34:56", "text": "私の時代は、"}, {"type": "subtitle", "time": 2099.109, "timestamp": "00:34:59", "text": "見たいもののために。唯一の形式"}]
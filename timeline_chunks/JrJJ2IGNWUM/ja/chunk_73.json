[{"type": "subtitle", "time": 4380.79, "timestamp": "01:13:00", "text": "市内で。でも、あなたが"}, {"type": "subtitle", "time": 4382.07, "timestamp": "01:13:02", "text": "田舎にいるときは、"}, {"type": "subtitle", "time": 4384.149, "timestamp": "01:13:04", "text": "外に出たいんだけど、"}, {"type": "subtitle", "time": 4386.87, "timestamp": "01:13:06", "text": "何も見るものはない。"}, {"type": "subtitle", "time": 4388.47, "timestamp": "01:13:08", "text": "そして、ここにいる友達は"}, {"type": "subtitle", "time": 4391.11, "timestamp": "01:13:11", "text": "すごく好き。なんていう名前だったっけ？隠遁生活"}, {"type": "subtitle", "time": 4392.87, "timestamp": "01:13:12", "text": "あまりオープンではない"}, {"type": "subtitle", "time": 4394.47, "timestamp": "01:13:14", "text": "概念とか、ただ話したり、そういう類の"}, {"type": "subtitle", "time": 4396.91, "timestamp": "01:13:16", "text": "クソの。彼らはむしろ"}, {"type": "subtitle", "time": 4399.669, "timestamp": "01:13:19", "text": "ええ、彼らはまたしてもかなり隠遁的です"}, {"type": "subtitle", "time": 4401.11, "timestamp": "01:13:21", "text": "自分たちをどのように表現したいか"}, {"type": "subtitle", "time": 4403.27, "timestamp": "01:13:23", "text": "新しい友達や、くだらないことの種類と一緒に。うん、"}, {"type": "subtitle", "time": 4406.55, "timestamp": "01:13:26", "text": "良くなってきています。うん。"}, {"type": "subtitle", "time": 4408.31, "timestamp": "01:13:28", "text": "気付いたかな、わからないけど"}, {"type": "subtitle", "time": 4410.47, "timestamp": "01:13:30", "text": "これはインドではよくあることですが、"}, {"type": "subtitle", "time": 4411.91, "timestamp": "01:13:31", "text": "フィリピンには、"}, {"type": "subtitle", "time": 4416.47, "timestamp": "01:13:36", "text": "今のゴス系の人々。ゴス系の人たち？うん。代替"}, {"type": "subtitle", "time": 4417.669, "timestamp": "01:13:37", "text": "服、たぶんそう呼ばれていると思う"}, {"type": "subtitle", "time": 4419.27, "timestamp": "01:13:39", "text": "今。そう、ゴス系の人たち。人々のように"}, {"type": "subtitle", "time": 4422.95, "timestamp": "01:13:42", "text": "全身黒を着ている人は、めちゃくちゃエッジーに見える。"}, {"type": "subtitle", "time": 4425.189, "timestamp": "01:13:45", "text": "おお。正直彼らのスタイルは好きだけど、"}, {"type": "subtitle", "time": 4427.03, "timestamp": "01:13:47", "text": "実際にはうまくいかないだろう。私の体、私の"}, {"type": "subtitle", "time": 4429.229, "timestamp": "01:13:49", "text": "体型は必ずしも、"}, {"type": "subtitle", "time": 4431.75, "timestamp": "01:13:51", "text": "知っておく、そのタイプの人と仕事をする必要がある"}, {"type": "subtitle", "time": 4433.27, "timestamp": "01:13:53", "text": "少しトゥインキーにするために"}, {"type": "subtitle", "time": 4435.59, "timestamp": "01:13:55", "text": "仕事。正直に、"}, {"type": "subtitle", "time": 4438.07, "timestamp": "01:13:58", "text": "つまり、筋肉質のゴスを見たことがあるんだけど、"}]
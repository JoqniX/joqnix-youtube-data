[{"type": "subtitle", "time": 9420.99, "timestamp": "02:37:00", "text": "トゥイッチ。わからない"}, {"type": "subtitle", "time": 9424.15, "timestamp": "02:37:04", "text": "ママは"}, {"type": "subtitle", "time": 9426.23, "timestamp": "02:37:06", "text": "ええと、プレイしています。えっと、待って、待って、"}, {"type": "subtitle", "time": 9428.91, "timestamp": "02:37:08", "text": "待って、待って、待って。彼女がそうでないことを願います"}, {"type": "subtitle", "time": 9431.87, "timestamp": "02:37:11", "text": "わかった。わかった、待って"}, {"type": "subtitle", "time": 9435.87, "timestamp": "02:37:15", "text": "けれど。はい、私はちょっと"}, {"type": "subtitle", "time": 9437.87, "timestamp": "02:37:17", "text": "終わり。"}, {"type": "subtitle", "time": 9441.07, "timestamp": "02:37:21", "text": "ああ、近い"}, {"type": "subtitle", "time": 9443.87, "timestamp": "02:37:23", "text": "これ。近い"}, {"type": "subtitle", "time": 9447.11, "timestamp": "02:37:27", "text": "これ。ああ、なんてことだ、動作が遅い。来て。"}, {"type": "subtitle", "time": 9461.23, "timestamp": "02:37:41", "text": "それ。"}, {"type": "subtitle", "time": 9469.79, "timestamp": "02:37:49", "text": "私は思う"}, {"type": "subtitle", "time": 9479.99, "timestamp": "02:37:59", "text": "はい、ゲームを待っていますと表示されています。わかった。"}]
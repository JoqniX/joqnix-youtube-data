[{"type": "subtitle", "time": 600.949, "timestamp": "00:10:00", "text": "君は当時、これは"}, {"type": "subtitle", "time": 603.389, "timestamp": "00:10:03", "text": "私にはわからない。たぶん私は"}, {"type": "subtitle", "time": 605.59, "timestamp": "00:10:05", "text": "私自身、覚えていません。だったと思います"}, {"type": "subtitle", "time": 608.55, "timestamp": "00:10:08", "text": "14歳くらいかな。いや、14歳じゃない。確か、"}, {"type": "subtitle", "time": 610.949, "timestamp": "00:10:10", "text": "うん、14歳。うん。そして私は行くのをやめました"}, {"type": "chat", "time": 611.299, "timestamp": "00:10:11", "author": "@AsAnOtaku", "avatar": "https://yt4.ggpht.com/ytc/AIdro_ml9qi1LKsmPGIy_j3CcCCPBXWFNxXjZJ9lViNDhl_52A=s64-c-k-c0x00ffffff-no-rj", "message": "Otakus unite !"}, {"type": "subtitle", "time": 613.19, "timestamp": "00:10:13", "text": "学校に行って、2時間くらい何もせずに"}, {"type": "subtitle", "time": 615.75, "timestamp": "00:10:15", "text": "ビデオゲームをしたり、"}, {"type": "subtitle", "time": 619.269, "timestamp": "00:10:19", "text": "YouTubeをやろう。私も同じ気持ちでした。私はとても"}, {"type": "subtitle", "time": 620.87, "timestamp": "00:10:20", "text": "何をすればいいのか分からなくて困惑している"}, {"type": "subtitle", "time": 622.63, "timestamp": "00:10:22", "text": "人生。私は「本当に行きたいのかな」と思った。"}, {"type": "subtitle", "time": 624.389, "timestamp": "00:10:24", "text": "学校へ？えっと、何なのかわからないんだけど"}, {"type": "subtitle", "time": 626.949, "timestamp": "00:10:26", "text": "こんなくだらないことに付き合ってる暇はない。えっと、"}, {"type": "subtitle", "time": 628.15, "timestamp": "00:10:28", "text": "これは本当に私の役に立つのでしょうか？そして私は"}, {"type": "subtitle", "time": 629.99, "timestamp": "00:10:29", "text": "気づいたんだ、くそ、行かないよ"}, {"type": "subtitle", "time": 631.59, "timestamp": "00:10:31", "text": "人生のあるところならどこでも、もし私がただ"}, {"type": "subtitle", "time": 633.91, "timestamp": "00:10:33", "text": "これをやろうと思っています。だから、結局私は"}, {"type": "subtitle", "time": 635.99, "timestamp": "00:10:35", "text": "ただ続けるだけです。そして私はこう思う"}, {"type": "subtitle", "time": 637.75, "timestamp": "00:10:37", "text": "加速コースを受講したばかり"}, {"type": "subtitle", "time": 638.949, "timestamp": "00:10:38", "text": "これまでできていなかった年月を取り戻そう"}, {"type": "subtitle", "time": 642.509, "timestamp": "00:10:42", "text": "やってきた。そして私はさらに一年を費やした"}, {"type": "subtitle", "time": 645.99, "timestamp": "00:10:45", "text": "オフ。それで、さらに遅れてしまった。うん。"}, {"type": "subtitle", "time": 649.59, "timestamp": "00:10:49", "text": "大学私も大学に通っています。終わらせるよ"}, {"type": "subtitle", "time": 651.43, "timestamp": "00:10:51", "text": "知ってるでしょ、私はフルになるつもりです"}, {"type": "subtitle", "time": 654.55, "timestamp": "00:10:54", "text": "一人前の教師。ああ、それは"}, {"type": "subtitle", "time": 656.31, "timestamp": "00:10:56", "text": "若干。うん。だから、私は次のように教えています"}, {"type": "subtitle", "time": 658.15, "timestamp": "00:10:58", "text": "私は言語学を教える予定で、"}]
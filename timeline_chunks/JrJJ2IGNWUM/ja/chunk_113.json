[{"type": "subtitle", "time": 6783.03, "timestamp": "01:53:03", "text": "性的じゃないよ、だって私はチュン・リーみたいだから"}, {"type": "subtitle", "time": 6786.31, "timestamp": "01:53:06", "text": "考えにこだわりすぎている"}, {"type": "subtitle", "time": 6788.07, "timestamp": "01:53:08", "text": "何かを守る。そして、私は理解しています"}, {"type": "subtitle", "time": 6790.55, "timestamp": "01:53:10", "text": "そういうことだけど、僕はそういうタイプの男じゃない"}, {"type": "subtitle", "time": 6793.109, "timestamp": "01:53:13", "text": "保護されるべきである。私は、"}, {"type": "subtitle", "time": 6794.709, "timestamp": "01:53:14", "text": "保護すること。そうは思わない"}, {"type": "subtitle", "time": 6798.31, "timestamp": "01:53:18", "text": "私のために働いてください。ロマンチックな意味で。"}, {"type": "subtitle", "time": 6803.03, "timestamp": "01:53:23", "text": "うん。だから、私には無理です。ごめん。"}, {"type": "subtitle", "time": 6805.07, "timestamp": "01:53:25", "text": "えっと、他に誰がいる？"}, {"type": "subtitle", "time": 6807.229, "timestamp": "01:53:27", "text": "まるで"}, {"type": "subtitle", "time": 6809.91, "timestamp": "01:53:29", "text": "えっと、ヴァージルはどうですか？嵐"}, {"type": "subtitle", "time": 6811.99, "timestamp": "01:53:31", "text": "接近中の嵐。私はそうではない"}, {"type": "chat", "time": 6812.346, "timestamp": "01:53:32", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "Emma Frost?"}, {"type": "subtitle", "time": 6815.43, "timestamp": "01:53:35", "text": "男が好き。ごめん。私は毎日ゲイのように振る舞うかもしれない"}, {"type": "subtitle", "time": 6817.27, "timestamp": "01:53:37", "text": "たまにはそうだけど、僕はゲイじゃないよ、みんな。私は"}, {"type": "subtitle", "time": 6819.229, "timestamp": "01:53:39", "text": "完全に"}, {"type": "subtitle", "time": 6821.99, "timestamp": "01:53:41", "text": "異性愛者。エマ・フロストは"}, {"type": "subtitle", "time": 6823.589, "timestamp": "01:53:43", "text": "マーベル・ライバルズというゲーム。私は彼女を知らない"}, {"type": "subtitle", "time": 6825.79, "timestamp": "01:53:45", "text": "性格タイプ。私はマーベルをプレイしません"}, {"type": "subtitle", "time": 6830.43, "timestamp": "01:53:50", "text": "ライバルでもなく、私も彼女を見たことがない"}, {"type": "subtitle", "time": 6833.43, "timestamp": "01:53:53", "text": "漫画。コミックに関しては、おそらく"}, {"type": "chat", "time": 6833.592, "timestamp": "01:53:53", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "u mean from X-men"}, {"type": "subtitle", "time": 6838.229, "timestamp": "01:53:58", "text": "今考えてみると、まさにそんな感じだ。私は"}, {"type": "subtitle", "time": 6839.87, "timestamp": "01:53:59", "text": "誰にとっても"}]
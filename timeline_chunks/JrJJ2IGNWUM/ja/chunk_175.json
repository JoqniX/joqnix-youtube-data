[{"type": "subtitle", "time": 10501.27, "timestamp": "02:55:01", "text": "これだけをずっと待って"}, {"type": "subtitle", "time": 10502.83, "timestamp": "02:55:02", "text": "[音楽]"}, {"type": "subtitle", "time": 10505.67, "timestamp": "02:55:05", "text": "来る。おお。"}, {"type": "subtitle", "time": 10507.83, "timestamp": "02:55:07", "text": "もし知っていたら、これを開けて"}, {"type": "subtitle", "time": 10516.75, "timestamp": "02:55:16", "text": "私はWindowsを持っています"}, {"type": "subtitle", "time": 10521.59, "timestamp": "02:55:21", "text": "アップデートしたように再起動すると"}, {"type": "subtitle", "time": 10525.07, "timestamp": "02:55:25", "text": "再起動が必要です。"}, {"type": "subtitle", "time": 10528.71, "timestamp": "02:55:28", "text": "ああ、今から再起動するか、"}, {"type": "subtitle", "time": 10531.99, "timestamp": "02:55:31", "text": "後でやってくれますか？"}, {"type": "subtitle", "time": 10536.11, "timestamp": "02:55:36", "text": "後でやります。"}, {"type": "subtitle", "time": 10539.11, "timestamp": "02:55:39", "text": "H. ああ、なんてことだ。新しい"}, {"type": "subtitle", "time": 10541.59, "timestamp": "02:55:41", "text": "Windowsのアップデートとか、そういう類のこと。私はしていません"}, {"type": "subtitle", "time": 10545.19, "timestamp": "02:55:45", "text": "5日間もパソコンの電源を切ってしまいました。おお"}]
[{"type": "subtitle", "time": 11820.11, "timestamp": "03:17:00", "text": "どこ"}, {"type": "subtitle", "time": 11836.79, "timestamp": "03:17:16", "text": "ここには何があると思いますか？"}, {"type": "subtitle", "time": 11840.63, "timestamp": "03:17:20", "text": "何てことだ。地図を確認してください。私は"}, {"type": "subtitle", "time": 11843.83, "timestamp": "03:17:23", "text": "敵。まだそこにある。彼らは"}, {"type": "subtitle", "time": 11847.429, "timestamp": "03:17:27", "text": "戦いを終えた。待って、あれは何？"}, {"type": "subtitle", "time": 11851.19, "timestamp": "03:17:31", "text": "ミニマップ上の緑色、いや赤色のやつ？"}, {"type": "subtitle", "time": 11855.67, "timestamp": "03:17:35", "text": "コイルマップ。それはすごいですね。"}]
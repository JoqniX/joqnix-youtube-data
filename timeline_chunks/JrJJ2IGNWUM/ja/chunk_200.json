[{"type": "subtitle", "time": 12001.349, "timestamp": "03:20:01", "text": "いや、転んだんだ。私は死んだ。おお"}, {"type": "subtitle", "time": 12021.51, "timestamp": "03:20:21", "text": "いや、少なくとも1人は倒せた。"}, {"type": "subtitle", "time": 12025.51, "timestamp": "03:20:25", "text": "彼らはどこから来たのか？彼らは"}, {"type": "subtitle", "time": 12029.87, "timestamp": "03:20:29", "text": "ああ、その側。うん。その地域では、"}, {"type": "subtitle", "time": 12033.75, "timestamp": "03:20:33", "text": "右？私が立っていた場所。うん。"}, {"type": "subtitle", "time": 12035.99, "timestamp": "03:20:35", "text": "あの後ろ姿。彼らは違っていた"}, {"type": "subtitle", "time": 12044.19, "timestamp": "03:20:44", "text": "中。それは"}, {"type": "subtitle", "time": 12047.87, "timestamp": "03:20:47", "text": "奇妙な。奇妙な。まあ、ノーマルとエイペックスですね。"}]
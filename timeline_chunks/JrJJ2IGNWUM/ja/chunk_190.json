[{"type": "subtitle", "time": 11405.389, "timestamp": "03:10:05", "text": "シーズン15か40。"}, {"type": "subtitle", "time": 11408.07, "timestamp": "03:10:08", "text": "うん。それ以来、あなたは"}, {"type": "subtitle", "time": 11410.15, "timestamp": "03:10:10", "text": "今のゲームは？"}, {"type": "subtitle", "time": 11412.55, "timestamp": "03:10:12", "text": "はい。"}, {"type": "subtitle", "time": 11416.75, "timestamp": "03:10:16", "text": "私がプレイを始めたとき、"}, {"type": "subtitle", "time": 11422.95, "timestamp": "03:10:22", "text": "アリーナはまだそこにあり、彼らは"}, {"type": "subtitle", "time": 11426.11, "timestamp": "03:10:26", "text": "削除しました"}, {"type": "subtitle", "time": 11439.51, "timestamp": "03:10:39", "text": "そして今、彼らはそれを限定版として再び追加した。"}, {"type": "subtitle", "time": 11442.15, "timestamp": "03:10:42", "text": "モード。"}, {"type": "subtitle", "time": 11445.15, "timestamp": "03:10:45", "text": "はい、私はロビーにいます"}, {"type": "subtitle", "time": 11447.67, "timestamp": "03:10:47", "text": "それ。ああ、もう手に入れたのね"}, {"type": "subtitle", "time": 11451.91, "timestamp": "03:10:51", "text": "皮膚とかそういうもの。さあ、行きなさい。"}, {"type": "subtitle", "time": 11453.51, "timestamp": "03:10:53", "text": "くそ。"}]
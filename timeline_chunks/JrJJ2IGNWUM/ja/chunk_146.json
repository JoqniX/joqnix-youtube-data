[{"type": "subtitle", "time": 8778.51, "timestamp": "02:26:18", "text": "だから、ストリーミングできないことを知りました"}, {"type": "subtitle", "time": 8781.349, "timestamp": "02:26:21", "text": "ゲーム。何？できないことを想像してみてください"}, {"type": "subtitle", "time": 8783.51, "timestamp": "02:26:23", "text": "お気に入りのゲームを配信でプレイしよう。"}, {"type": "subtitle", "time": 8787.469, "timestamp": "02:26:27", "text": "ええ、つまり多くの人がそうでした"}, {"type": "subtitle", "time": 8790.469, "timestamp": "02:26:30", "text": "問題。名前を忘れてしまったのですが、"}, {"type": "subtitle", "time": 8793.309, "timestamp": "02:26:33", "text": "どのゲームだったかはさておき、"}, {"type": "subtitle", "time": 8797.11, "timestamp": "02:26:37", "text": "ええ、スペインですね。ええ、実際はペインコです。"}, {"type": "subtitle", "time": 8807.349, "timestamp": "02:26:47", "text": "でも、それでも、何があっても"}, {"type": "subtitle", "time": 8809.67, "timestamp": "02:26:49", "text": "ああ、そういうこともあるけど、"}, {"type": "subtitle", "time": 8814.51, "timestamp": "02:26:54", "text": "動画ですよね？つまり、どんなに"}, {"type": "subtitle", "time": 8817.15, "timestamp": "02:26:57", "text": "え、そうでしょ？あなたはできる、"}]
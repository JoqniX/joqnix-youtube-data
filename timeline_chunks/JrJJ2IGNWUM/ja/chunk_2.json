[{"type": "subtitle", "time": 120.63, "timestamp": "00:02:00", "text": "私が持っていたもののほとんどは"}, {"type": "subtitle", "time": 123.83, "timestamp": "00:02:03", "text": "おそらく2時間程度の昼寝でしょう。"}, {"type": "subtitle", "time": 126.63, "timestamp": "00:02:06", "text": "いいえ。だから私は熱い蒸気で動いていて"}, {"type": "subtitle", "time": 130.15, "timestamp": "00:02:10", "text": "コーヒーを少しだけ。何てことだ。"}, {"type": "subtitle", "time": 132.39, "timestamp": "00:02:12", "text": "でも大丈夫。私たちはゲームをしています。大丈夫です。私たちは"}, {"type": "subtitle", "time": 135.51, "timestamp": "00:02:15", "text": "良い。待って。えっと、そちらは何時ですか？"}, {"type": "subtitle", "time": 141.99, "timestamp": "00:02:21", "text": "そこには？えっと、午後11時11分午後11時待って。それで、"}, {"type": "subtitle", "time": 145.99, "timestamp": "00:02:25", "text": "それは、えっと、待って、8時30分です"}, {"type": "subtitle", "time": 149.11, "timestamp": "00:02:29", "text": "自分。午後11時ああ、CST時間ですね。たった"}, {"type": "subtitle", "time": 152.15, "timestamp": "00:02:32", "text": "数時間。うん。ああ、わかりました。わかった。 CST"}, {"type": "subtitle", "time": 154.63, "timestamp": "00:02:34", "text": "時間。わかった。私は中部標準時（CST）だったのか、太平洋標準時（PS）だったのか？私はしません"}, {"type": "subtitle", "time": 156.55, "timestamp": "00:02:36", "text": "私が使っているタイムゾーンのようなものを覚えておいてください"}, {"type": "subtitle", "time": 161.82999999999998, "timestamp": "00:02:41", "text": "もう無理。だって、すごく迷子になってるから。"}, {"type": "subtitle", "time": 164.309, "timestamp": "00:02:44", "text": "ご覧のとおり、私はとてもとても"}, {"type": "subtitle", "time": 167.03, "timestamp": "00:02:47", "text": "クソみたいなゲーム。"}, {"type": "subtitle", "time": 171.589, "timestamp": "00:02:51", "text": "私は正気を失いつつある。 M. そしてあなたは私を始めた"}, {"type": "subtitle", "time": 173.91, "timestamp": "00:02:53", "text": "ストリーミング配信に戻ってきたことに気づきました"}, {"type": "subtitle", "time": 177.91, "timestamp": "00:02:57", "text": "最近。ああ、戻ってきたぜ、坊や。さあ行こう。"}, {"type": "subtitle", "time": 179.589, "timestamp": "00:02:59", "text": "そこに戻って、そこに戻って"}]
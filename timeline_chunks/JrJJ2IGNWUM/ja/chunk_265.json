[{"type": "subtitle", "time": 15900.389, "timestamp": "04:25:00", "text": "神よ、イシュマよ、私を滅ぼしてください。うん。あなたは"}, {"type": "subtitle", "time": 15902.55, "timestamp": "04:25:02", "text": "夜中の雨が午前3時に降るって知ってる？"}, {"type": "subtitle", "time": 15906.07, "timestamp": "04:25:06", "text": "夜の雨とは何ですか？"}, {"type": "subtitle", "time": 15909.149, "timestamp": "04:25:09", "text": "エルダーだと思います"}, {"type": "subtitle", "time": 15912.71, "timestamp": "04:25:12", "text": "指輪。のように"}, {"type": "subtitle", "time": 15915.309, "timestamp": "04:25:15", "text": "エルダーリング。"}, {"type": "subtitle", "time": 15920.469, "timestamp": "04:25:20", "text": "はい。エルダーリング・ナイトトレイン。ああ、それ"}, {"type": "subtitle", "time": 15924.71, "timestamp": "04:25:24", "text": "ゲーム。何か。これはゲームだ。"}, {"type": "subtitle", "time": 15927.11, "timestamp": "04:25:27", "text": "くそ。"}, {"type": "subtitle", "time": 15929.03, "timestamp": "04:25:29", "text": "私にはお金がない、そうでなければ"}, {"type": "subtitle", "time": 15931.229, "timestamp": "04:25:31", "text": "プレイしただろう。しかしそれは"}, {"type": "subtitle", "time": 15934.389, "timestamp": "04:25:34", "text": "わかった。すべて順調です。再生できません"}, {"type": "subtitle", "time": 15937.03, "timestamp": "04:25:37", "text": "日本。数回後にはそうではないと思う"}, {"type": "subtitle", "time": 15939.63, "timestamp": "04:25:39", "text": "数年、数ヶ月。"}, {"type": "subtitle", "time": 15942.55, "timestamp": "04:25:42", "text": "うん。私は一生懸命努力します"}, {"type": "subtitle", "time": 15945.11, "timestamp": "04:25:45", "text": "すべて終わったら予備の"}, {"type": "subtitle", "time": 15948.67, "timestamp": "04:25:48", "text": "ゲームを買うとか、何か別のことに使うお金。"}, {"type": "subtitle", "time": 15951.189, "timestamp": "04:25:51", "text": "うん。何てことだ。私は変えなければならない"}, {"type": "chat", "time": 15951.295, "timestamp": "04:25:51", "author": "@Roku-rin", "avatar": "https://yt4.ggpht.com/8LlS_C2IirDMfA5r2V0q5G1kudp8dmG6RQvz_jCAUT3H-esyEgTNPDwrfCXiyX7Undc9UmHNgw=s64-c-k-c0x00ffffff-no-rj", "message": "GG"}, {"type": "subtitle", "time": 15955.03, "timestamp": "04:25:55", "text": "Steamストアとか、今はそういうのもあるよ。"}, {"type": "subtitle", "time": 15956.349, "timestamp": "04:25:56", "text": "おお"}, {"type": "subtitle", "time": 15959.389, "timestamp": "04:25:59", "text": "男の子。こんにちは、アリ。ありがとう。"}]
[{"type": "subtitle", "time": 5401.91, "timestamp": "01:30:01", "text": "それ。うん。"}, {"type": "subtitle", "time": 5405.189, "timestamp": "01:30:05", "text": "後回しにしている。はい。"}, {"type": "subtitle", "time": 5407.669, "timestamp": "01:30:07", "text": "うん。私は自分が考えているように考えている"}, {"type": "subtitle", "time": 5409.189, "timestamp": "01:30:09", "text": "ええと、私が今読んでいるのは"}, {"type": "subtitle", "time": 5412.149, "timestamp": "01:30:12", "text": "えっと、ちょうどオールド・イェラーを見終わったところなので、"}, {"type": "subtitle", "time": 5414.31, "timestamp": "01:30:14", "text": "映画ではなく、原作小説の方です。ちょうど終わったところです"}, {"type": "subtitle", "time": 5418.229, "timestamp": "01:30:18", "text": "『オールド・イェラー』という本。そして、私が持っているのは"}, {"type": "subtitle", "time": 5421.51, "timestamp": "01:30:21", "text": "他に2冊読んでいます。それは"}, {"type": "subtitle", "time": 5425.11, "timestamp": "01:30:25", "text": "犬を盗む。それがタイトルです。それは"}, {"type": "subtitle", "time": 5428.03, "timestamp": "01:30:28", "text": "それは本です。そしてもう一つは"}, {"type": "subtitle", "time": 5431.11, "timestamp": "01:30:31", "text": "Starirl、つまりこういうことなんですが、"}, {"type": "subtitle", "time": 5433.91, "timestamp": "01:30:33", "text": "右？それは何の意味もないと思う"}, {"type": "subtitle", "time": 5436.709, "timestamp": "01:30:36", "text": "凝りすぎている。それは良い"}, {"type": "subtitle", "time": 5440.149, "timestamp": "01:30:40", "text": "メッセージ。私はスターリルが"}, {"type": "subtitle", "time": 5442.79, "timestamp": "01:30:42", "text": "ええと、真の自己とは、生まれつきのものです"}, {"type": "subtitle", "time": 5445.83, "timestamp": "01:30:45", "text": "人間の説明のようなもの"}, {"type": "subtitle", "time": 5447.189, "timestamp": "01:30:47", "text": "性格はただ"}, {"type": "subtitle", "time": 5448.87, "timestamp": "01:30:48", "text": "彼らが本当にやりたいことではなく"}, {"type": "subtitle", "time": 5450.47, "timestamp": "01:30:50", "text": "受け入れられるためにペルソナの裏に隠れる"}, {"type": "subtitle", "time": 5453.03, "timestamp": "01:30:53", "text": "社会によって。それが私の基本的な感想です"}, {"type": "subtitle", "time": 5455.11, "timestamp": "01:30:55", "text": "今読んでいるところによると。でも私は"}, {"type": "subtitle", "time": 5456.47, "timestamp": "01:30:56", "text": "わからない、もしかしたら変わるかもしれない"}, {"type": "subtitle", "time": 5457.75, "timestamp": "01:30:57", "text": "私はもう少し深く掘り下げて"}, {"type": "subtitle", "time": 5459.11, "timestamp": "01:30:59", "text": "それを読んでください。でも、そんなに遠くはないよ"}]
[{"type": "subtitle", "time": 16500.31, "timestamp": "04:35:00", "text": "今。くそ、たくさんの新機能"}, {"type": "subtitle", "time": 16502.551, "timestamp": "04:35:02", "text": "YouTube。"}, {"type": "subtitle", "time": 16504.83, "timestamp": "04:35:04", "text": "Twitchからクリップできます。何？"}, {"type": "subtitle", "time": 16507.59, "timestamp": "04:35:07", "text": "はい。そのためには配信を終了しなければなりません"}, {"type": "subtitle", "time": 16515.029, "timestamp": "04:35:15", "text": "クリップ可能。ええ、そうですね。とにかく、明日は"}, {"type": "subtitle", "time": 16518.31, "timestamp": "04:35:18", "text": "金曜日。明日午後2時6時まで"}, {"type": "subtitle", "time": 16521.83, "timestamp": "04:35:21", "text": "パンがあります。私たちは、"}, {"type": "subtitle", "time": 16522.67, "timestamp": "04:35:22", "text": "パン"}, {"type": "subtitle", "time": 16525.269, "timestamp": "04:35:25", "text": "明日。パンはそこにあるでしょう"}, {"type": "subtitle", "time": 16527.67, "timestamp": "04:35:27", "text": "明日は、私たちは高いところにいるか、"}, {"type": "subtitle", "time": 16530.709, "timestamp": "04:35:30", "text": "来週の後の何か"}, {"type": "subtitle", "time": 16535.029, "timestamp": "04:35:35", "text": "週。ええと、彼はここに来たかったんです。私"}, {"type": "subtitle", "time": 16537.109, "timestamp": "04:35:37", "text": "彼にここにいてほしかったし、私たちは話をして"}, {"type": "subtitle", "time": 16540.31, "timestamp": "04:35:40", "text": "6月に行く前に、またはそれより前に、ぶらぶらする"}, {"type": "subtitle", "time": 16542.949, "timestamp": "04:35:42", "text": "私は日本とかに行くんです。ええ、そうですね。それから"}, {"type": "subtitle", "time": 16545.029, "timestamp": "04:35:45", "text": "ヨシン・ノサンが来ました。コラボレーション"}, {"type": "subtitle", "time": 16550.15, "timestamp": "04:35:50", "text": "ヨシン・ノサン 午後8時夜間のインド標準時。"}, {"type": "subtitle", "time": 16552.789, "timestamp": "04:35:52", "text": "午前中のセッションはブレットが担当します。"}, {"type": "subtitle", "time": 16556.349, "timestamp": "04:35:56", "text": "夜のセッションはヨシャンと行います。"}]
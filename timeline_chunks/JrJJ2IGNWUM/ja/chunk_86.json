[{"type": "subtitle", "time": 5163.709, "timestamp": "01:26:03", "text": "うん。えっと、パット、オーストラリア人は誰？"}, {"type": "subtitle", "time": 5166.149, "timestamp": "01:26:06", "text": "YouTuberがコーヒーを飲んで"}, {"type": "subtitle", "time": 5168.149, "timestamp": "01:26:08", "text": "読み終えた後にあくびが出る？ワイフは"}, {"type": "subtitle", "time": 5170.229, "timestamp": "01:26:10", "text": "基本的にはそれと同じようなものです。だっていつでも"}, {"type": "subtitle", "time": 5173.629, "timestamp": "01:26:13", "text": "ワイフはコーヒーを飲む、彼女は"}, {"type": "subtitle", "time": 5176.07, "timestamp": "01:26:16", "text": "寝る。彼女は実際には目を覚まさない"}, {"type": "subtitle", "time": 5178.31, "timestamp": "01:26:18", "text": "コーヒー。彼女にとっては、それは睡眠薬のようなものだ。"}, {"type": "subtitle", "time": 5179.91, "timestamp": "01:26:19", "text": "だから、すごく変な感じ"}, {"type": "subtitle", "time": 5181.83, "timestamp": "01:26:21", "text": "自分。しかし、彼女はすでに"}, {"type": "subtitle", "time": 5184.07, "timestamp": "01:26:24", "text": "日本語を勉強しています。ああ、だから私は"}, {"type": "subtitle", "time": 5185.83, "timestamp": "01:26:25", "text": "日本語を勉強したことは一度もないし、"}, {"type": "subtitle", "time": 5187.51, "timestamp": "01:26:27", "text": "私は他の適切な言語を学びました"}, {"type": "subtitle", "time": 5189.669, "timestamp": "01:26:29", "text": "フィリピン語と英語以外にも、"}, {"type": "subtitle", "time": 5191.43, "timestamp": "01:26:31", "text": "スペイン語を少し話せるかもしれないし、"}, {"type": "subtitle", "time": 5193.95, "timestamp": "01:26:33", "text": "私は完全に間違っているが"}, {"type": "subtitle", "time": 5196.629, "timestamp": "01:26:36", "text": "スペイン語。ええ、私には理解できません"}, {"type": "subtitle", "time": 5197.99, "timestamp": "01:26:37", "text": "2つ以外の言語"}, {"type": "subtitle", "time": 5199.669, "timestamp": "01:26:39", "text": "私が実際に知っているのは"}, {"type": "subtitle", "time": 5203.11, "timestamp": "01:26:43", "text": "比較的良い、良くない、"}, {"type": "subtitle", "time": 5205.43, "timestamp": "01:26:45", "text": "会話は、その言葉です"}, {"type": "subtitle", "time": 5207.43, "timestamp": "01:26:47", "text": "を探しています。"}, {"type": "subtitle", "time": 5213.75, "timestamp": "01:26:53", "text": "うん。あなたが話せるようになって嬉しいです"}, {"type": "subtitle", "time": 5215.669, "timestamp": "01:26:55", "text": "今は日本人、騎手。あなたは"}, {"type": "subtitle", "time": 5218.39, "timestamp": "01:26:58", "text": "クソを理解する。ええ、分かります。"}]
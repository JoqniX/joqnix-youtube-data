[{"type": "subtitle", "time": 14940.55, "timestamp": "04:09:00", "text": "それを使うために。最初に攻撃を仕掛けたのは誰？私は"}, {"type": "subtitle", "time": 14951.83, "timestamp": "04:09:11", "text": "第1ラウンド、リングカウントダウン開始。"}, {"type": "subtitle", "time": 14953.91, "timestamp": "04:09:13", "text": "私たちはリングの中にいる、つまり彼らは"}, {"type": "subtitle", "time": 14961.63, "timestamp": "04:09:21", "text": "あなたは使うべきです 私たちは"}, {"type": "subtitle", "time": 14963.55, "timestamp": "04:09:23", "text": "試す"}, {"type": "subtitle", "time": 14968.95, "timestamp": "04:09:28", "text": "現在30歳。とても美味しいです。"}, {"type": "subtitle", "time": 14979.469, "timestamp": "04:09:39", "text": "はい"}]
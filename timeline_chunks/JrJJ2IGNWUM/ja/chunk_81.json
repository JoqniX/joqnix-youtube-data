[{"type": "subtitle", "time": 4861.189, "timestamp": "01:21:01", "text": "なぜならそれはただその化学物質を与えるだけだからです"}, {"type": "subtitle", "time": 4863.83, "timestamp": "01:21:03", "text": "脳内で起こる反応"}, {"type": "subtitle", "time": 4866.27, "timestamp": "01:21:06", "text": "どちらにしても幸せです。そして"}, {"type": "subtitle", "time": 4869.189, "timestamp": "01:21:09", "text": "率直に言って、良くない。はい、違います"}, {"type": "subtitle", "time": 4871.11, "timestamp": "01:21:11", "text": "良い。あまり良くない。それを吸うことさえも"}, {"type": "subtitle", "time": 4873.51, "timestamp": "01:21:13", "text": "棒のようなものから外れるのも良くない。"}, {"type": "subtitle", "time": 4876.63, "timestamp": "01:21:16", "text": "はい、好きではありません。でも、そうですね、"}, {"type": "subtitle", "time": 4879.03, "timestamp": "01:21:19", "text": "効果は否定できないし、値段も安い。"}, {"type": "subtitle", "time": 4883.189, "timestamp": "01:21:23", "text": "だから、そうなんです。そうかもしれないね。のように"}, {"type": "subtitle", "time": 4885.189, "timestamp": "01:21:25", "text": "最近、もうすぐ1年になります。私"}, {"type": "subtitle", "time": 4887.11, "timestamp": "01:21:27", "text": "今年はまだ1本も吸ってないよ"}, {"type": "subtitle", "time": 4889.11, "timestamp": "01:21:29", "text": "正しく覚えておいてください。もうすぐ1年になります"}, {"type": "subtitle", "time": 4891.03, "timestamp": "01:21:31", "text": "今。今年はまだ吸ってない"}, {"type": "subtitle", "time": 4893.91, "timestamp": "01:21:33", "text": "意外にも。"}, {"type": "subtitle", "time": 4895.43, "timestamp": "01:21:35", "text": "ものすごくストレスが溜まっているけれど"}, {"type": "subtitle", "time": 4897.51, "timestamp": "01:21:37", "text": "仕事のせいだけど、私は"}, {"type": "subtitle", "time": 4898.95, "timestamp": "01:21:38", "text": "吸ったことはない。私はまだ到達していません"}, {"type": "subtitle", "time": 4900.79, "timestamp": "01:21:40", "text": "めちゃくちゃ腹が立って、"}, {"type": "subtitle", "time": 4903.669, "timestamp": "01:21:43", "text": "まだ疲れている。でも、ええ、お酒を飲むのは"}, {"type": "subtitle", "time": 4906.07, "timestamp": "01:21:46", "text": "非常にありふれたことだ。問題はここです。"}, {"type": "subtitle", "time": 4908.47, "timestamp": "01:21:48", "text": "私はそんなにたくさんお酒を飲むわけじゃないですよね？"}, {"type": "subtitle", "time": 4910.63, "timestamp": "01:21:50", "text": "君たち、君たちは知っているよね。私は遠くまで行った"}, {"type": "subtitle", "time": 4913.43, "timestamp": "01:21:53", "text": "誕生日配信で泥酔しすぎて"}, {"type": "subtitle", "time": 4915.83, "timestamp": "01:21:55", "text": "もう酒は飲みたくない。"}, {"type": "subtitle", "time": 4918.47, "timestamp": "01:21:58", "text": "でも友達と飲むときは、"}]
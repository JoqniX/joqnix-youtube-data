[{"type": "subtitle", "time": 16861.11, "timestamp": "04:41:01", "text": "グループコラボレーション、えーと色々。ああ、そうだね。"}, {"type": "subtitle", "time": 16864.07, "timestamp": "04:41:04", "text": "それについては手配しておきます。問題は私が"}, {"type": "subtitle", "time": 16866.23, "timestamp": "04:41:06", "text": "試合を決めなければならない。それは"}, {"type": "subtitle", "time": 16870.15, "timestamp": "04:41:10", "text": "唯一の問題点。そして私は6月まで待つ"}, {"type": "subtitle", "time": 16873.27, "timestamp": "04:41:13", "text": "1番目から最後まで。私は6月2日まで待つので"}, {"type": "subtitle", "time": 16874.51, "timestamp": "04:41:14", "text": "私はできる"}, {"type": "subtitle", "time": 16877.35, "timestamp": "04:41:17", "text": "アンインストールします。 Sea of​​をアンインストールできます"}, {"type": "subtitle", "time": 16880.07, "timestamp": "04:41:20", "text": "泥棒と地獄の潜水夫。私は見逃しましたか"}, {"type": "subtitle", "time": 16881.67, "timestamp": "04:41:21", "text": "コラボレーション？ええ、まあ、そうですね。その"}, {"type": "subtitle", "time": 16885.07, "timestamp": "04:41:25", "text": "わかった。私のスタジオ。いらっしゃいませ、"}, {"type": "subtitle", "time": 16887.788, "timestamp": "04:41:27", "text": "男。ようこそ。"}, {"type": "subtitle", "time": 16891.31, "timestamp": "04:41:31", "text": "見逃した。ええ、コラボは3つありました"}, {"type": "subtitle", "time": 16892.91, "timestamp": "04:41:32", "text": "今日。"}, {"type": "subtitle", "time": 16895.59, "timestamp": "04:41:35", "text": "えーと、私たちはコラボレーションする予定だったんだけど"}, {"type": "subtitle", "time": 16898.55, "timestamp": "04:41:38", "text": "正午にマリサと会ったが、私は台無しにしてしまった。"}, {"type": "subtitle", "time": 16900.948, "timestamp": "04:41:40", "text": "タイミング。私は自分自身に再確認しなかった。"}, {"type": "subtitle", "time": 16903.59, "timestamp": "04:41:43", "text": "彼女は自由の身だと思っていた。私たちは"}, {"type": "subtitle", "time": 16908.15, "timestamp": "04:41:48", "text": "午後2時か3時ならできるかもしれません。だから私はプラス"}, {"type": "subtitle", "time": 16910.948, "timestamp": "04:41:50", "text": "私はたくさんの人に連絡を取っていました 18"}, {"type": "subtitle", "time": 16913.67, "timestamp": "04:41:53", "text": "今日の人々は私がとても"}, {"type": "subtitle", "time": 16917.35, "timestamp": "04:41:57", "text": "疲れた。気分が悪かったので、"}, {"type": "subtitle", "time": 16919.75, "timestamp": "04:41:59", "text": "そして吐き気もする。だから横になって目が覚めた"}]
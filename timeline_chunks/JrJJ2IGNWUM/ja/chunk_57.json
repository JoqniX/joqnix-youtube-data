[{"type": "subtitle", "time": 3421.67, "timestamp": "00:57:01", "text": "発症前に始まり、まるで"}, {"type": "subtitle", "time": 3423.589, "timestamp": "00:57:03", "text": "わかった、回復したら役に立つだろう"}, {"type": "subtitle", "time": 3426.63, "timestamp": "00:57:06", "text": "私は推測する。だから、それが"}, {"type": "subtitle", "time": 3428.95, "timestamp": "00:57:08", "text": "もの。ええ、私はラズベリーが大好きですが、"}, {"type": "subtitle", "time": 3430.549, "timestamp": "00:57:10", "text": "もうそういうのはほとんど買わない"}, {"type": "subtitle", "time": 3432.39, "timestamp": "00:57:12", "text": "だって、ここでは売られていないと思うから。"}, {"type": "subtitle", "time": 3436.39, "timestamp": "00:57:16", "text": "輸入品だったと思います。それで"}, {"type": "subtitle", "time": 3438.789, "timestamp": "00:57:18", "text": "ああ、そうだね、"}, {"type": "subtitle", "time": 3440.789, "timestamp": "00:57:20", "text": "ラズベリーティー。あれは最高だった。"}, {"type": "subtitle", "time": 3443.03, "timestamp": "00:57:23", "text": "あれは最高だった。私は文字通り"}, {"type": "subtitle", "time": 3449.99, "timestamp": "00:57:29", "text": "バッグ。奇妙だと思いませんか？これまでに"}, {"type": "subtitle", "time": 3452.23, "timestamp": "00:57:32", "text": "まるで"}, {"type": "subtitle", "time": 3454.71, "timestamp": "00:57:34", "text": "お茶がとても好きなので、"}, {"type": "subtitle", "time": 3458.23, "timestamp": "00:57:38", "text": "ティーバッグからすべて抽出する？おお、"}, {"type": "subtitle", "time": 3461.67, "timestamp": "00:57:41", "text": "うん。それほど素晴らしいということです。はい。"}, {"type": "subtitle", "time": 3463.589, "timestamp": "00:57:43", "text": "はい。はい。はい。私はそれを実行しました。うん。私"}, {"type": "subtitle", "time": 3466.87, "timestamp": "00:57:46", "text": "それが欲しい。それは奇妙に聞こえるかもしれない"}, {"type": "subtitle", "time": 3468.63, "timestamp": "00:57:48", "text": "だって君はただ葉っぱを吸ってるだけで"}, {"type": "subtitle", "time": 3471.829, "timestamp": "00:57:51", "text": "ドライフルーツかもしれないけど、"}, {"type": "subtitle", "time": 3474.309, "timestamp": "00:57:54", "text": "ただ違うだけなんです。君たちはそうしない"}]
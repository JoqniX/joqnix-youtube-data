[{"type": "subtitle", "time": 12182.71, "timestamp": "03:23:02", "text": "良い知らせです。ああ、私が撃ったんだ。ニース。滞在する"}, {"type": "subtitle", "time": 12185.51, "timestamp": "03:23:05", "text": "ここ。はぁ？彼らは諦めるべきではなかった"}, {"type": "subtitle", "time": 12218.309, "timestamp": "03:23:38", "text": "ええ、こちらです。この男は"}, {"type": "subtitle", "time": 12228.269, "timestamp": "03:23:48", "text": "彼らは"}]
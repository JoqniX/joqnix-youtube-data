[{"type": "subtitle", "time": 16321.03, "timestamp": "04:32:01", "text": "くそ。そして少なくともあなたは"}, {"type": "subtitle", "time": 16323.91, "timestamp": "04:32:03", "text": "私がインドにいる間は、今すぐストリーミング配信してください。では"}, {"type": "subtitle", "time": 16326.309, "timestamp": "04:32:06", "text": "そんな未来はあり得ないだろう。いいえ、だって"}, {"type": "subtitle", "time": 16329.349, "timestamp": "04:32:09", "text": "私は日本にいます。私はいくつかの"}, {"type": "subtitle", "time": 16332.389, "timestamp": "04:32:12", "text": "別のサーバーですよね？それは難しいだろう。"}, {"type": "subtitle", "time": 16335.03, "timestamp": "04:32:15", "text": "でも、実際に手に入れたらどうなるか想像してみて"}, {"type": "subtitle", "time": 16337.63, "timestamp": "04:32:17", "text": "日本語で私"}, {"type": "chat", "time": 16339.615, "timestamp": "04:32:19", "author": "@Roku-rin", "avatar": "https://yt4.ggpht.com/8LlS_C2IirDMfA5r2V0q5G1kudp8dmG6RQvz_jCAUT3H-esyEgTNPDwrfCXiyX7Undc9UmHNgw=s64-c-k-c0x00ffffff-no-rj", "message": "lmao think if i was in japan there too"}, {"type": "subtitle", "time": 16346.71, "timestamp": "04:32:26", "text": "最高だ。それを切り取ってください。後でそのスポーツマンを懲らしめてやる。"}, {"type": "subtitle", "time": 16351.429, "timestamp": "04:32:31", "text": "ナニ・ナ・ナニ・リモート・サーバーが戻りました"}, {"type": "subtitle", "time": 16353.63, "timestamp": "04:32:33", "text": "ティア1向け。何が"}, {"type": "subtitle", "time": 16357.03, "timestamp": "04:32:37", "text": "それ？私は日本にいた時のことを考えています"}, {"type": "subtitle", "time": 16366.11, "timestamp": "04:32:46", "text": "バカ、あぁ"}, {"type": "subtitle", "time": 16369.03, "timestamp": "04:32:49", "text": "ええ、誰かタイムスタンプを知っていますか？もし"}, {"type": "subtitle", "time": 16372.469, "timestamp": "04:32:52", "text": "Roku のときにそれを切り取ってください"}, {"type": "subtitle", "time": 16375.59, "timestamp": "04:32:55", "text": "実際、私を狙撃したりしたんです。それは"}, {"type": "subtitle", "time": 16379.79, "timestamp": "04:32:59", "text": "最高の瞬間になる。私はしたいです"}]
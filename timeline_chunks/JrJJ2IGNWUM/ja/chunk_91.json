[{"type": "subtitle", "time": 5460.79, "timestamp": "01:31:00", "text": "まだその段階には達していない。でもそれが私が"}, {"type": "subtitle", "time": 5463.59, "timestamp": "01:31:03", "text": "いくつかの章を基にしているのがわかる"}, {"type": "subtitle", "time": 5465.43, "timestamp": "01:31:05", "text": "読みました。"}, {"type": "subtitle", "time": 5466.629, "timestamp": "01:31:06", "text": "[音楽]"}, {"type": "subtitle", "time": 5468.629, "timestamp": "01:31:08", "text": "でも、それは女の子みたいなもの"}, {"type": "subtitle", "time": 5472.51, "timestamp": "01:31:12", "text": "そして彼女はみんなにとってすごく変な人"}, {"type": "subtitle", "time": 5476.07, "timestamp": "01:31:16", "text": "目は、だが彼女は可能な限り本物だ"}, {"type": "subtitle", "time": 5479.83, "timestamp": "01:31:19", "text": "なぜなら、彼女にとって彼女は彼女自身だからだ。そして"}, {"type": "subtitle", "time": 5482.39, "timestamp": "01:31:22", "text": "物語を語るのが大好きな人もいる。"}, {"type": "subtitle", "time": 5484.07, "timestamp": "01:31:24", "text": "つまり、主人公のタイプというものがあるんです。"}, {"type": "subtitle", "time": 5485.99, "timestamp": "01:31:25", "text": "おい、それはただのナレーションだよ"}, {"type": "subtitle", "time": 5487.709, "timestamp": "01:31:27", "text": "何が起こっているのか、周りで何が起こっているのか"}, {"type": "subtitle", "time": 5491.03, "timestamp": "01:31:31", "text": "学校で、人々がどのように反応するか"}, {"type": "subtitle", "time": 5493.669, "timestamp": "01:31:33", "text": "スターガール、そして彼女がなぜある種の"}, {"type": "subtitle", "time": 5497.11, "timestamp": "01:31:37", "text": "彼女はとても奇妙で風変わりだから有名人"}, {"type": "subtitle", "time": 5500.629, "timestamp": "01:31:40", "text": "そしてそれはただそれだけで、"}, {"type": "subtitle", "time": 5503.189, "timestamp": "01:31:43", "text": "まるで"}, {"type": "subtitle", "time": 5505.43, "timestamp": "01:31:45", "text": "えーと、真実であることの考え方を説明する"}, {"type": "subtitle", "time": 5507.83, "timestamp": "01:31:47", "text": "あなた自身。でも、たぶんわからない"}, {"type": "subtitle", "time": 5509.75, "timestamp": "01:31:49", "text": "本当に変わるだろう。私は私は私は"}, {"type": "subtitle", "time": 5512.47, "timestamp": "01:31:52", "text": "読む。私の考えを見てください。私は"}, {"type": "subtitle", "time": 5514.39, "timestamp": "01:31:54", "text": "後でまた考えてみるけど、まあ、そうだね。"}, {"type": "subtitle", "time": 5516.229, "timestamp": "01:31:56", "text": "それでは不十分だ。私はまだ十分に読んでいないので"}, {"type": "subtitle", "time": 5519.669, "timestamp": "01:31:59", "text": "それが主に何についてなのかをお話しします。"}]
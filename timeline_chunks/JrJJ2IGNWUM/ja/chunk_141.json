[{"type": "subtitle", "time": 8461.469, "timestamp": "02:21:01", "text": "ジュンはこういうのが好き、"}, {"type": "subtitle", "time": 8482.389, "timestamp": "02:21:22", "text": "ジュン：それで、ハン、今日はどんな一日だった？私はしません"}, {"type": "subtitle", "time": 8484.23, "timestamp": "02:21:24", "text": "あなたがまだここにいるかどうかはわかりませんが、"}, {"type": "subtitle", "time": 8485.87, "timestamp": "02:21:25", "text": "あなたの一日は？"}, {"type": "subtitle", "time": 8488.67, "timestamp": "02:21:28", "text": "頭。"}, {"type": "subtitle", "time": 8492.17, "timestamp": "02:21:32", "text": "ヘッドは正常に動作します。全員分のヘッド。"}, {"type": "subtitle", "time": 8494.07, "timestamp": "02:21:34", "text": "[音楽]"}, {"type": "subtitle", "time": 8496.83, "timestamp": "02:21:36", "text": "誰かがこの男を連れて行く。では、"}, {"type": "subtitle", "time": 8500.469, "timestamp": "02:21:40", "text": "これ。ミラージュを選びます。昨日私は"}, {"type": "subtitle", "time": 8503.15, "timestamp": "02:21:43", "text": "彼に勝たせたいんだ"}, {"type": "subtitle", "time": 8506.55, "timestamp": "02:21:46", "text": "今。パコールはドラゴンをプレイしている。おお、いいね。"}, {"type": "subtitle", "time": 8514.27, "timestamp": "02:21:54", "text": "サポート。見て楽しもう"}]
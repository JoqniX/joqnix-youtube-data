[{"type": "subtitle", "time": 13080.03, "timestamp": "03:38:00", "text": "購入する"}, {"type": "subtitle", "time": 13081.55, "timestamp": "03:38:01", "text": "イベント"}, {"type": "subtitle", "time": 13084.51, "timestamp": "03:38:04", "text": "そしてあなたは"}, {"type": "subtitle", "time": 13092.63, "timestamp": "03:38:12", "text": "[音楽]"}, {"type": "subtitle", "time": 13095.91, "timestamp": "03:38:15", "text": "ああ、イベントが戻ってきた。おお、"}, {"type": "subtitle", "time": 13099.95, "timestamp": "03:38:19", "text": "顔を上げて。そこにあるもののように"}, {"type": "subtitle", "time": 13101.469, "timestamp": "03:38:21", "text": "された"}, {"type": "subtitle", "time": 13106.03, "timestamp": "03:38:26", "text": "入手できるイベント"}, {"type": "subtitle", "time": 13108.03, "timestamp": "03:38:28", "text": "破片"}, {"type": "subtitle", "time": 13117.63, "timestamp": "03:38:37", "text": "肌。ああ、それ"}, {"type": "subtitle", "time": 13120.55, "timestamp": "03:38:40", "text": "プレイヤーのスキル分布は1つだけ。そうそう"}, {"type": "subtitle", "time": 13123.11, "timestamp": "03:38:43", "text": "我々は低い。くそ。ずっと"}, {"type": "subtitle", "time": 13127.429, "timestamp": "03:38:47", "text": "より低い。ランキングでも"}, {"type": "subtitle", "time": 13132.99, "timestamp": "03:38:52", "text": "プレイヤーにも表示される"}, {"type": "subtitle", "time": 13138.75, "timestamp": "03:38:58", "text": "分布と、すべての"}]
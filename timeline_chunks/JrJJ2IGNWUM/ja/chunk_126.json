[{"type": "subtitle", "time": 7562.229, "timestamp": "02:06:02", "text": "悪い。本当に怖かったんだよ。"}, {"type": "subtitle", "time": 7564.99, "timestamp": "02:06:04", "text": "私は他のものを作りたくない"}, {"type": "subtitle", "time": 7569.91, "timestamp": "02:06:09", "text": "チームメイトが腹を立てたり、怒ったりする。私"}, {"type": "subtitle", "time": 7572.87, "timestamp": "02:06:12", "text": "わからない。でも、それはただの"}, {"type": "subtitle", "time": 7577.95, "timestamp": "02:06:17", "text": "ゲームだよ、ただのゲームさ。激怒"}, {"type": "subtitle", "time": 7580.43, "timestamp": "02:06:20", "text": "いつも"}, {"type": "subtitle", "time": 7584.51, "timestamp": "02:06:24", "text": "そこには。ええ、そうですね。"}, {"type": "subtitle", "time": 7588.629, "timestamp": "02:06:28", "text": "うん。心配しないで。私もひどい人間だよ。ああ。"}, {"type": "subtitle", "time": 7590.8, "timestamp": "02:06:30", "text": "うん。私も。"}, {"type": "subtitle", "time": 7593.229, "timestamp": "02:06:33", "text": "[音楽]"}, {"type": "subtitle", "time": 7597.83, "timestamp": "02:06:37", "text": "自信。こんにちは。こんにちは。こんにちは。だから、私は"}, {"type": "subtitle", "time": 7599.91, "timestamp": "02:06:39", "text": "準備すると言いながら"}, {"type": "subtitle", "time": 7601.709, "timestamp": "02:06:41", "text": "スケジュールを立てて、スケジュールを立てる。"}, {"type": "subtitle", "time": 7605.79, "timestamp": "02:06:45", "text": "しかし今日に至るまで、私は"}, {"type": "subtitle", "time": 7608.91, "timestamp": "02:06:48", "text": "スケジュールすら準備していない"}, {"type": "subtitle", "time": 7619.109, "timestamp": "02:06:59", "text": "人生？ええ、そうですね。えっと、私も自分の人生"}]
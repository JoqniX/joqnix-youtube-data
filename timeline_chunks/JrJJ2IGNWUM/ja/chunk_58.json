[{"type": "subtitle", "time": 3480.549, "timestamp": "00:58:00", "text": "うん。ベン、あなたのレベルはどうですか"}, {"type": "subtitle", "time": 3483.67, "timestamp": "00:58:03", "text": "スパイス？ええと、騎手。あなたのレベルは"}, {"type": "subtitle", "time": 3486.71, "timestamp": "00:58:06", "text": "今、スパイスが欲しい？はい。えっと、私は辛いものが大好きなんです"}, {"type": "subtitle", "time": 3490.39, "timestamp": "00:58:10", "text": "食べ物。私はします。子供の頃はそうだった。"}, {"type": "subtitle", "time": 3492.63, "timestamp": "00:58:12", "text": "昔は唐辛子とか食べてたんだけど"}, {"type": "subtitle", "time": 3496.15, "timestamp": "00:58:16", "text": "退屈だったので、よくお湯を飲んでいました。"}, {"type": "subtitle", "time": 3500.15, "timestamp": "00:58:20", "text": "それって、すごく怒ってるモードになるよね？"}, {"type": "subtitle", "time": 3502.47, "timestamp": "00:58:22", "text": "うん。うん。もっとイライラさせる。うん。うん。"}, {"type": "subtitle", "time": 3505.43, "timestamp": "00:58:25", "text": "うん。うん。私は自分が"}, {"type": "subtitle", "time": 3508.63, "timestamp": "00:58:28", "text": "ハルクとかそんな感じ。"}, {"type": "subtitle", "time": 3511.03, "timestamp": "00:58:31", "text": "あなたは実際に怒っていたのです。あなた"}, {"type": "subtitle", "time": 3513.75, "timestamp": "00:58:33", "text": "燃え上がっていた。環境に配慮する代わりに、"}, {"type": "subtitle", "time": 3520.39, "timestamp": "00:58:40", "text": "普通の空気注入式ヌードルは"}, {"type": "subtitle", "time": 3525.75, "timestamp": "00:58:45", "text": "自分。そうはならないだろう。それは良いです。それは良いです。"}, {"type": "subtitle", "time": 3528.87, "timestamp": "00:58:48", "text": "味は気にしなくていい"}, {"type": "subtitle", "time": 3531.51, "timestamp": "00:58:51", "text": "辛いですよね？実際の味"}, {"type": "subtitle", "time": 3535.19, "timestamp": "00:58:55", "text": "カルボナーラのようなプロファイルは最高です"}, {"type": "subtitle", "time": 3538.15, "timestamp": "00:58:58", "text": "最高だ。どんなパスタですか"}]
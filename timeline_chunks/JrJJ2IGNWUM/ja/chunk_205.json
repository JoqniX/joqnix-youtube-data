[{"type": "subtitle", "time": 12317.389, "timestamp": "03:25:17", "text": "なぜ彼は"}, {"type": "subtitle", "time": 12321.67, "timestamp": "03:25:21", "text": "私は"}, {"type": "subtitle", "time": 12339.11, "timestamp": "03:25:39", "text": "ああ、人がいる。待って、待って、待って、"}, {"type": "subtitle", "time": 12341.87, "timestamp": "03:25:41", "text": "待って。戻ってください。敵を発見"}, {"type": "subtitle", "time": 12344.51, "timestamp": "03:25:44", "text": "そこには。"}, {"type": "subtitle", "time": 12347.19, "timestamp": "03:25:47", "text": "相手はそこにいる。彼らはそうするかもしれないし、そうすべきだ"}, {"type": "subtitle", "time": 12357.75, "timestamp": "03:25:57", "text": "押す。"}]
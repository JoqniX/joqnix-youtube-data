[{"type": "subtitle", "time": 12489.67, "timestamp": "03:28:09", "text": "彼には2人の人がいる"}, {"type": "subtitle", "time": 12491.229, "timestamp": "03:28:11", "text": "2つあります"}, {"type": "subtitle", "time": 12493.95, "timestamp": "03:28:13", "text": "彼の周りには人々がいた。"}, {"type": "subtitle", "time": 12497.99, "timestamp": "03:28:17", "text": "いや、ただジャンプすればいい。"}, {"type": "subtitle", "time": 12521.51, "timestamp": "03:28:41", "text": "なんてこった。なんてこった。いいえ。いいえ。いいえ。いいえ。いいえ。いいえ。ああ"}, {"type": "subtitle", "time": 12524.55, "timestamp": "03:28:44", "text": "我が神よ。何てことだ。"}, {"type": "subtitle", "time": 12526.67, "timestamp": "03:28:46", "text": "元気ですか？"}, {"type": "subtitle", "time": 12531.59, "timestamp": "03:28:51", "text": "生きてるの？分かりません。"}, {"type": "subtitle", "time": 12533.429, "timestamp": "03:28:53", "text": "よぉ、レプリケーターがやってくる"}]
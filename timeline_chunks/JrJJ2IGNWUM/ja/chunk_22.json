[{"type": "subtitle", "time": 1321.83, "timestamp": "00:22:01", "text": "当時は、あなたのPNG画像のようなものを使っていました"}, {"type": "subtitle", "time": 1323.99, "timestamp": "00:22:03", "text": "そして、私が好きになれた他の人たちもみんな"}, {"type": "subtitle", "time": 1328.789, "timestamp": "00:22:08", "text": "壮大な銃とかを持ってポーズをとる。"}, {"type": "subtitle", "time": 1334.07, "timestamp": "00:22:14", "text": "私はただ2台の重機を揺らしているだけです"}, {"type": "subtitle", "time": 1342.47, "timestamp": "00:22:22", "text": "ええ、すごく昔のことですね。"}, {"type": "subtitle", "time": 1345.51, "timestamp": "00:22:25", "text": "それは無料ゲームのようなもので、"}, {"type": "subtitle", "time": 1349.029, "timestamp": "00:22:29", "text": "給料日でもある。片腕強盗とか"}, {"type": "subtitle", "time": 1352.31, "timestamp": "00:22:32", "text": "何か。 Paydayと同じです。あなたが持っている"}, {"type": "subtitle", "time": 1355.029, "timestamp": "00:22:35", "text": "警察を捕まえたり、その他諸々"}, {"type": "subtitle", "time": 1357.11, "timestamp": "00:22:37", "text": "そして武器などを磨く。その"}, {"type": "subtitle", "time": 1358.87, "timestamp": "00:22:38", "text": "楽しい。ええ、無料ゲームはプレイしたことがありません"}, {"type": "subtitle", "time": 1360.87, "timestamp": "00:22:40", "text": "比較的最近登場した新しいゲーム"}, {"type": "subtitle", "time": 1362.71, "timestamp": "00:22:42", "text": "少なくとも、あるいはそれに近い。ただ"}, {"type": "subtitle", "time": 1366.31, "timestamp": "00:22:46", "text": "いや、俺はビデオゲームを深く探求したりしないんだ。"}, {"type": "subtitle", "time": 1369.75, "timestamp": "00:22:49", "text": "すみません、おならが出てしまいました。"}, {"type": "subtitle", "time": 1373.909, "timestamp": "00:22:53", "text": "でも、ええ、そうですね、ほら。"}, {"type": "subtitle", "time": 1375.909, "timestamp": "00:22:55", "text": "好きなら時間をかけすぎる"}, {"type": "subtitle", "time": 1378.549, "timestamp": "00:22:58", "text": "好きなビデオゲームをプレイし始める"}]
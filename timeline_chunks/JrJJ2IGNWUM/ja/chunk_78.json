[{"type": "subtitle", "time": 4680.79, "timestamp": "01:18:00", "text": "薬物、騎手？"}, {"type": "subtitle", "time": 4683.75, "timestamp": "01:18:03", "text": "つまり、葉巻の話をしているなら"}, {"type": "subtitle", "time": 4687.75, "timestamp": "01:18:07", "text": "喫煙とかそういうもの。うん。ええと、"}, {"type": "subtitle", "time": 4690.47, "timestamp": "01:18:10", "text": "私が高校生の時にこんなことがあった"}, {"type": "subtitle", "time": 4693.43, "timestamp": "01:18:13", "text": "強制的にやらされたような感じだった。私たちは"}, {"type": "subtitle", "time": 4695.35, "timestamp": "01:18:15", "text": "昔は、周りに合わせようとするタイプのものが好きだった。"}, {"type": "subtitle", "time": 4698.11, "timestamp": "01:18:18", "text": "うん。うん。ああ、そうだね。馴染むために"}, {"type": "subtitle", "time": 4703.03, "timestamp": "01:18:23", "text": "もの。でも、そうですね。だから私たちはそれに慣れた"}, {"type": "subtitle", "time": 4705.83, "timestamp": "01:18:25", "text": "とても不健康だった。これは"}, {"type": "subtitle", "time": 4709.11, "timestamp": "01:18:29", "text": "気持ち悪いけど、そう、私たちは昔は"}, {"type": "subtitle", "time": 4712.229, "timestamp": "01:18:32", "text": "使用済みの捨てられたタバコ。ということで、"}, {"type": "subtitle", "time": 4717.03, "timestamp": "01:18:37", "text": "お前。"}, {"type": "subtitle", "time": 4718.55, "timestamp": "01:18:38", "text": "[音楽]"}, {"type": "subtitle", "time": 4722.95, "timestamp": "01:18:42", "text": "何てことだ。それは"}, {"type": "subtitle", "time": 4725.99, "timestamp": "01:18:45", "text": "何てことだ。それに、私たちはよく転がしていました"}, {"type": "subtitle", "time": 4727.669, "timestamp": "01:18:47", "text": "論文。"}, {"type": "subtitle", "time": 4730.229, "timestamp": "01:18:50", "text": "うん。普通の巻紙で巻いて、そのまま吸うだけ。"}, {"type": "subtitle", "time": 4734.709, "timestamp": "01:18:54", "text": "うん。うん。何てことだ。それは"}, {"type": "subtitle", "time": 4737.43, "timestamp": "01:18:57", "text": "了解しました。あなたを責めることはできません。"}, {"type": "subtitle", "time": 4739.99, "timestamp": "01:18:59", "text": "私も同じことをしたことがあります。"}]
[{"type": "subtitle", "time": 8900.99, "timestamp": "02:28:20", "text": "神。多すぎる"}, {"type": "subtitle", "time": 8904.469, "timestamp": "02:28:24", "text": "人々。人が多すぎる。"}, {"type": "subtitle", "time": 8910.91, "timestamp": "02:28:30", "text": "人々。痛み。痛み。"}, {"type": "subtitle", "time": 8930.27, "timestamp": "02:28:50", "text": "ここにはどれくらいの人がいますか？"}, {"type": "subtitle", "time": 8934.23, "timestamp": "02:28:54", "text": "でも、できるよ。でも、このゲームは40歳向けなんだ。"}, {"type": "subtitle", "time": 8937.03, "timestamp": "02:28:57", "text": "50時間もかかるなんて、もしそれが"}, {"type": "subtitle", "time": 8939.51, "timestamp": "02:28:59", "text": "ケースは20個のパーツで作れると思います"}]
[{"type": "subtitle", "time": 5341.91, "timestamp": "01:29:01", "text": "ローカライザー系のものがたくさん入っているが、"}, {"type": "subtitle", "time": 5344.229, "timestamp": "01:29:04", "text": "ああ、そうだね。私は、もし私が"}, {"type": "subtitle", "time": 5346.229, "timestamp": "01:29:06", "text": "怠け者で、本当に読みたい"}, {"type": "subtitle", "time": 5349.43, "timestamp": "01:29:09", "text": "次の章では、私はまだ"}, {"type": "subtitle", "time": 5351.669, "timestamp": "01:29:11", "text": "AI翻訳を実行してから、"}, {"type": "subtitle", "time": 5355.51, "timestamp": "01:29:15", "text": "実際、適切な翻訳は"}, {"type": "subtitle", "time": 5358.47, "timestamp": "01:29:18", "text": "実際に認定されたUH転写者または"}, {"type": "subtitle", "time": 5359.88, "timestamp": "01:29:19", "text": "翻訳者。"}, {"type": "subtitle", "time": 5362.95, "timestamp": "01:29:22", "text": "[音楽]"}, {"type": "subtitle", "time": 5365.03, "timestamp": "01:29:25", "text": "MTLゲームの機械翻訳とは"}, {"type": "subtitle", "time": 5372.07, "timestamp": "01:29:32", "text": "比較的最近の文献を読んでも。うん。"}, {"type": "subtitle", "time": 5376.709, "timestamp": "01:29:36", "text": "機械翻訳。 MTL MTL。うん。何"}, {"type": "subtitle", "time": 5378.629, "timestamp": "01:29:38", "text": "ジャッキー、最近何か読んでる？私"}, {"type": "subtitle", "time": 5381.11, "timestamp": "01:29:41", "text": "何も読んでいない。私は好きです"}, {"type": "subtitle", "time": 5384.31, "timestamp": "01:29:44", "text": "さっき言った通りだろ？えっと、負けちゃったので無理です"}, {"type": "subtitle", "time": 5386.229, "timestamp": "01:29:46", "text": "勉強への意欲。つまり、"}, {"type": "subtitle", "time": 5388.87, "timestamp": "01:29:48", "text": "本を読んだら、私はできない"}, {"type": "subtitle", "time": 5390.47, "timestamp": "01:29:50", "text": "本を読むことさえできた。読み続けてください。"}, {"type": "subtitle", "time": 5392.669, "timestamp": "01:29:52", "text": "うん。"}, {"type": "subtitle", "time": 5398.31, "timestamp": "01:29:58", "text": "私は完全にはできませんでした。ああ、あなたはただ"}, {"type": "subtitle", "time": 5399.91, "timestamp": "01:29:59", "text": "読む時間ができるのを待っているだけです"}]
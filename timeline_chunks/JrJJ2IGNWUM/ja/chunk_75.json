[{"type": "subtitle", "time": 4501.91, "timestamp": "01:15:01", "text": "ハック。私はこれを使い始めてから"}, {"type": "subtitle", "time": 4504.55, "timestamp": "01:15:04", "text": "もう本当に長い間。私"}, {"type": "subtitle", "time": 4506.51, "timestamp": "01:15:06", "text": "なぜ効果があるのか​​はわからないが、"}, {"type": "subtitle", "time": 4509.669, "timestamp": "01:15:09", "text": "作品。だから、皆さんにお勧めしたいのは"}, {"type": "subtitle", "time": 4511.59, "timestamp": "01:15:11", "text": "その代わりに。それはとても役に立つ、"}, {"type": "subtitle", "time": 4513.99, "timestamp": "01:15:13", "text": "男。つまり、同じようなものが得られるということです。"}, {"type": "subtitle", "time": 4516.47, "timestamp": "01:15:16", "text": "レベルって何ですか？それは何？"}, {"type": "subtitle", "time": 4518.229, "timestamp": "01:15:18", "text": "電話した？モチベーションは、"}, {"type": "subtitle", "time": 4519.91, "timestamp": "01:15:19", "text": "歩いてクリアする以外に何もしていない"}, {"type": "subtitle", "time": 4521.99, "timestamp": "01:15:21", "text": "頭。だって、その気持ちわかるでしょ？"}, {"type": "subtitle", "time": 4524.149, "timestamp": "01:15:24", "text": "たくさんの仕事をしているとき、"}, {"type": "subtitle", "time": 4525.669, "timestamp": "01:15:25", "text": "すると、そういう気持ちになる"}, {"type": "subtitle", "time": 4527.75, "timestamp": "01:15:27", "text": "圧倒されるような、あるいは"}, {"type": "subtitle", "time": 4529.91, "timestamp": "01:15:29", "text": "まるで脳が"}, {"type": "subtitle", "time": 4531.59, "timestamp": "01:15:31", "text": "あなたが仕事について考えていること"}, {"type": "subtitle", "time": 4533.11, "timestamp": "01:15:33", "text": "実際にはもう機能していないが、"}, {"type": "subtitle", "time": 4535.83, "timestamp": "01:15:35", "text": "それはあなたがしていることに関係しています。"}, {"type": "subtitle", "time": 4537.27, "timestamp": "01:15:37", "text": "そういうことなんです。まるでリフレッシュしたような気分だ。"}, {"type": "subtitle", "time": 4541.03, "timestamp": "01:15:41", "text": "まるで脳内でF5キーを押したようなものだ。"}, {"type": "subtitle", "time": 4542.39, "timestamp": "01:15:42", "text": "あなたはただ脳をリフレッシュしているだけです"}, {"type": "subtitle", "time": 4544.709, "timestamp": "01:15:44", "text": "その点です。それはまるで、でもまた"}, {"type": "subtitle", "time": 4546.31, "timestamp": "01:15:46", "text": "それは必ずしもすべての人に当てはまるわけではない"}, {"type": "subtitle", "time": 4548.39, "timestamp": "01:15:48", "text": "誰もが安全な場所に住んでいるわけではないから"}, {"type": "subtitle", "time": 4550.31, "timestamp": "01:15:50", "text": "近所。私は"}, {"type": "subtitle", "time": 4551.43, "timestamp": "01:15:51", "text": "それについて少し調べてみました。その"}, {"type": "subtitle", "time": 4554.229, "timestamp": "01:15:54", "text": "そういうことは、行けるようにできるようなものだ"}, {"type": "subtitle", "time": 4555.99, "timestamp": "01:15:55", "text": "外に出て探検して楽しむ"}, {"type": "subtitle", "time": 4558.709, "timestamp": "01:15:58", "text": "環境は、例えば、"}]
[{"type": "subtitle", "time": 3544.15, "timestamp": "00:59:04", "text": "どんなパスタがお好みですか？"}, {"type": "subtitle", "time": 3546.95, "timestamp": "00:59:06", "text": "パスタ麺。パスタ料理。うん。おお、"}, {"type": "subtitle", "time": 3550.87, "timestamp": "00:59:10", "text": "普通のやつ。えっと、普通って何ですか？の"}, {"type": "subtitle", "time": 3552.63, "timestamp": "00:59:12", "text": "パスタ。"}, {"type": "subtitle", "time": 3556.069, "timestamp": "00:59:16", "text": "何？だから、スパゲッティのように、"}, {"type": "subtitle", "time": 3558.39, "timestamp": "00:59:18", "text": "スパゲッティ、もう食べたと思う。"}, {"type": "subtitle", "time": 3561.109, "timestamp": "00:59:21", "text": "マカロニチーズ。うん。ええ、持っています"}, {"type": "subtitle", "time": 3562.63, "timestamp": "00:59:22", "text": "それがあった。うん、それでいいよ"}, {"type": "subtitle", "time": 3565.03, "timestamp": "00:59:25", "text": "すべて。"}, {"type": "subtitle", "time": 3567.03, "timestamp": "00:59:27", "text": "おお。ああ、パスタに関することなら何でも。追加"}, {"type": "subtitle", "time": 3570.309, "timestamp": "00:59:30", "text": "それ。私の場合、カルボナーラが好きです。"}, {"type": "subtitle", "time": 3572.309, "timestamp": "00:59:32", "text": "スパゲッティ。あの二人は"}, {"type": "subtitle", "time": 3576.51, "timestamp": "00:59:36", "text": "私の本の中で上位にランクインしているのは、"}, {"type": "chat", "time": 3578.478, "timestamp": "00:59:38", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "carbonara is peak"}, {"type": "subtitle", "time": 3579.829, "timestamp": "00:59:39", "text": "えーと、パスタ料理、"}, {"type": "subtitle", "time": 3582.309, "timestamp": "00:59:42", "text": "男。いくつか欲しい"}, {"type": "subtitle", "time": 3584.63, "timestamp": "00:59:44", "text": "クソカルボナーラとクソうーん"}, {"type": "subtitle", "time": 3587.87, "timestamp": "00:59:47", "text": "それは何という名前ですか？えっと、ガーリックブレッドですよね。"}, {"type": "subtitle", "time": 3590.47, "timestamp": "00:59:50", "text": "今。ガーリックブレッドが食べたくてたまらない"}, {"type": "subtitle", "time": 3592.71, "timestamp": "00:59:52", "text": "今すぐ。なあ、もし俺たちが会うことがあったら、"}, {"type": "subtitle", "time": 3594.789, "timestamp": "00:59:54", "text": "ジャッキー、オリーブガーデンに行くわよ。"}, {"type": "subtitle", "time": 3596.549, "timestamp": "00:59:56", "text": "はい。"}, {"type": "subtitle", "time": 3598.23, "timestamp": "00:59:58", "text": "オリーブに行ったことがありますか？"}]
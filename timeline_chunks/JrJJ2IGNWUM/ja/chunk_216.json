[{"type": "subtitle", "time": 12962.469, "timestamp": "03:36:02", "text": "ええ、"}, {"type": "subtitle", "time": 12967.429, "timestamp": "03:36:07", "text": "その間。だから、よくわからないんです。"}, {"type": "subtitle", "time": 12970.7, "timestamp": "03:36:10", "text": "「エラー：接続できません」と表示されます。 O"}, {"type": "subtitle", "time": 12980.51, "timestamp": "03:36:20", "text": "典型的な類人猿類人猿は"}, {"type": "subtitle", "time": 13002.269, "timestamp": "03:36:42", "text": "彼ら。お金のように感じます"}, {"type": "subtitle", "time": 13008.75, "timestamp": "03:36:48", "text": "ある意味、空腹だ。彼らは実際に"}, {"type": "subtitle", "time": 13017.469, "timestamp": "03:36:57", "text": "無料でたくさんのものを提供してくれた。彼らが与えたように"}, {"type": "subtitle", "time": 13019.469, "timestamp": "03:36:59", "text": "80"}]
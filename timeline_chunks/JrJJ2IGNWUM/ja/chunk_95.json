[{"type": "subtitle", "time": 5703.51, "timestamp": "01:35:03", "text": "単調で退屈だ。くだらない。"}, {"type": "subtitle", "time": 5705.91, "timestamp": "01:35:05", "text": "でも、あなたの言いたいことは分かりますよ。"}, {"type": "subtitle", "time": 5707.75, "timestamp": "01:35:07", "text": "なあ、君。おっしゃっていることは分かります。"}, {"type": "subtitle", "time": 5709.51, "timestamp": "01:35:09", "text": "について。"}, {"type": "subtitle", "time": 5711.75, "timestamp": "01:35:11", "text": "時々、ただ"}, {"type": "subtitle", "time": 5713.91, "timestamp": "01:35:13", "text": "ファンとしての感覚。それが"}, {"type": "subtitle", "time": 5715.99, "timestamp": "01:35:15", "text": "まるでコピー＆ペーストされたキャラクターのようだ"}, {"type": "subtitle", "time": 5719.51, "timestamp": "01:35:19", "text": "自己投影のため。それはまだ楽しい"}, {"type": "subtitle", "time": 5722.95, "timestamp": "01:35:22", "text": "読む。ストーリー展開はなかなか良い。私 私"}, {"type": "subtitle", "time": 5725.27, "timestamp": "01:35:25", "text": "感じなかったら落とすけどね。私"}, {"type": "subtitle", "time": 5726.79, "timestamp": "01:35:26", "text": "それでもくだらないものを読んでしまう"}, {"type": "subtitle", "time": 5728.629, "timestamp": "01:35:28", "text": "必ずしも何か面白いことが起こるわけではない"}, {"type": "subtitle", "time": 5730.75, "timestamp": "01:35:30", "text": "続ける"}, {"type": "subtitle", "time": 5733.189, "timestamp": "01:35:33", "text": "彼ら。私は特に探しているわけではない"}, {"type": "subtitle", "time": 5736.189, "timestamp": "01:35:36", "text": "私が改造した自動販売機"}, {"type": "subtitle", "time": 5740.07, "timestamp": "01:35:40", "text": "異世界の機械みたいなもの。私"}, {"type": "subtitle", "time": 5742.43, "timestamp": "01:35:42", "text": "面白いと思うし、楽しい"}, {"type": "subtitle", "time": 5746.229, "timestamp": "01:35:46", "text": "見て読んで、でも待って、読まない。"}, {"type": "subtitle", "time": 5747.669, "timestamp": "01:35:47", "text": "申し訳ありませんが、アニメはないと思います。"}, {"type": "subtitle", "time": 5749.91, "timestamp": "01:35:49", "text": "それについては、まだ。時々"}, {"type": "subtitle", "time": 5752.709, "timestamp": "01:35:52", "text": "えっと、ヒーローから追い出されたんだ"}, {"type": "subtitle", "time": 5754.31, "timestamp": "01:35:54", "text": "パーティーがあって、他にもあるんだけど"}, {"type": "subtitle", "time": 5756.709, "timestamp": "01:35:56", "text": "まるでヒーローから追放されたみたいだ"}, {"type": "subtitle", "time": 5759.43, "timestamp": "01:35:59", "text": "パーティー、まるでみんな同じ"}]
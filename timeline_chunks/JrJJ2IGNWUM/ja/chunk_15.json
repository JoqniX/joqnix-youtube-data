[{"type": "subtitle", "time": 900.47, "timestamp": "00:15:00", "text": "それが私の夢です。うん。必要不可欠なものであること。おお"}, {"type": "subtitle", "time": 905.87, "timestamp": "00:15:05", "text": "我が神よ。うん。私はほとんど外出していなかった"}, {"type": "subtitle", "time": 908.79, "timestamp": "00:15:08", "text": "家から出たりすることに関して、"}, {"type": "subtitle", "time": 910.389, "timestamp": "00:15:10", "text": "男。私がネイトだった頃は、"}, {"type": "subtitle", "time": 912.629, "timestamp": "00:15:12", "text": "ずっとベッドで寝ていた。私は文字通りベッドにいました"}, {"type": "subtitle", "time": 916.31, "timestamp": "00:15:16", "text": "腐敗している。ベッドがひどく臭かった"}, {"type": "subtitle", "time": 926.47, "timestamp": "00:15:26", "text": "そうそう。そして、ある時点で、私の"}, {"type": "subtitle", "time": 930.389, "timestamp": "00:15:30", "text": "父は従兄弟と話していた"}, {"type": "subtitle", "time": 934.629, "timestamp": "00:15:34", "text": "遠い親戚で、"}, {"type": "subtitle", "time": 937.189, "timestamp": "00:15:37", "text": "大学教授または"}, {"type": "subtitle", "time": 939.59, "timestamp": "00:15:39", "text": "大学教授か何か。だから彼は"}, {"type": "subtitle", "time": 942.949, "timestamp": "00:15:42", "text": "次のようなものを使うことを提案しました"}, {"type": "subtitle", "time": 945.35, "timestamp": "00:15:45", "text": "遠隔学習オンライン大学"}, {"type": "subtitle", "time": 950.629, "timestamp": "00:15:50", "text": "ここに何かあります。そうそう。うん。うん。だから私は"}, {"type": "subtitle", "time": 953.269, "timestamp": "00:15:53", "text": "父にこれを提案したことさえある"}, {"type": "subtitle", "time": 955.949, "timestamp": "00:15:55", "text": "近くの"}, {"type": "subtitle", "time": 959.11, "timestamp": "00:15:59", "text": "大学で彼はこう思った。「もし"}]
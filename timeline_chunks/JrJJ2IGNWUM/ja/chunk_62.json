[{"type": "subtitle", "time": 3721.589, "timestamp": "01:02:01", "text": "みんなが"}, {"type": "subtitle", "time": 3723.03, "timestamp": "01:02:03", "text": "チャットでは私が何を言っているのか既に分かっている"}, {"type": "subtitle", "time": 3724.789, "timestamp": "01:02:04", "text": "だいたいそんな感じですよね？君たちは間違いなく"}, {"type": "subtitle", "time": 3726.47, "timestamp": "01:02:06", "text": "あなたがその色のケチャップを持っていたとき"}, {"type": "subtitle", "time": 3730.23, "timestamp": "01:02:10", "text": "若いですよね？うん。それはとても奇妙だった"}, {"type": "subtitle", "time": 3733.75, "timestamp": "01:02:13", "text": "だって、妙な化学薬品みたいな味がしたんだもん。それ"}, {"type": "subtitle", "time": 3736.789, "timestamp": "01:02:16", "text": "新鮮なトマトのような感触ではなかった。その"}, {"type": "subtitle", "time": 3738.87, "timestamp": "01:02:18", "text": "彼らが加えた食品着色料のように"}, {"type": "subtitle", "time": 3743.589, "timestamp": "01:02:23", "text": "まるで人工的な変な味がした。"}, {"type": "subtitle", "time": 3745.99, "timestamp": "01:02:25", "text": "うん。色付きケチャップ。うん。それはただ"}, {"type": "subtitle", "time": 3747.829, "timestamp": "01:02:27", "text": "変な着色料が気に入らなかった"}, {"type": "subtitle", "time": 3750.19, "timestamp": "01:02:30", "text": "超クソだった"}, {"type": "subtitle", "time": 3752.95, "timestamp": "01:02:32", "text": "奇妙な。聞いたことがない。あなたは一度も"}, {"type": "subtitle", "time": 3756.95, "timestamp": "01:02:36", "text": "色付きケチャップのパットについて聞いたことがある。"}, {"type": "subtitle", "time": 3758.789, "timestamp": "01:02:38", "text": "わかった。ペプシブルーはどうですか？君たちは"}, {"type": "subtitle", "time": 3762.069, "timestamp": "01:02:42", "text": "まだペプシブルー持ってる？ペプシブルー。の"}, {"type": "subtitle", "time": 3763.63, "timestamp": "01:02:43", "text": "いいね"}, {"type": "subtitle", "time": 3766.309, "timestamp": "01:02:46", "text": "インド。親指を立てて賛成。全く見当もつかない"}, {"type": "subtitle", "time": 3768.87, "timestamp": "01:02:48", "text": "親指を立てるジェスチャーとは何か。それは"}, {"type": "subtitle", "time": 3771.99, "timestamp": "01:02:51", "text": "そう、ペプシみたいなものだね。"}, {"type": "subtitle", "time": 3774.63, "timestamp": "01:02:54", "text": "ええ、でも青色です。ネオンブルーみたい。"}, {"type": "subtitle", "time": 3777.109, "timestamp": "01:02:57", "text": "ああ、ネオンブルーはダメだ。それはただ、ああ、違う"}, {"type": "subtitle", "time": 3779.109, "timestamp": "01:02:59", "text": "それですね。"}]
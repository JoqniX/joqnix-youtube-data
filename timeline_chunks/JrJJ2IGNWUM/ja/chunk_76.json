[{"type": "subtitle", "time": 4560.63, "timestamp": "01:16:00", "text": "環境変数には以下が含まれます"}, {"type": "subtitle", "time": 4562.79, "timestamp": "01:16:02", "text": "公共交通機関の安全性、"}, {"type": "subtitle", "time": 4564.87, "timestamp": "01:16:04", "text": "歩きやすい道など。えっと、あなたは"}, {"type": "subtitle", "time": 4566.709, "timestamp": "01:16:06", "text": "ジョーはどう思う？インドのように考えますか？"}, {"type": "subtitle", "time": 4568.87, "timestamp": "01:16:08", "text": "良いインフラのようなもの"}, {"type": "subtitle", "time": 4572.47, "timestamp": "01:16:12", "text": "ウォーキングとかそういうの？それともただの"}, {"type": "subtitle", "time": 4575.43, "timestamp": "01:16:15", "text": "場所によっては、"}, {"type": "subtitle", "time": 4577.669, "timestamp": "01:16:17", "text": "歩道とか、そういうのがもっといい"}, {"type": "subtitle", "time": 4581.07, "timestamp": "01:16:21", "text": "私の地域では、ウォーキングのような"}, {"type": "subtitle", "time": 4585.35, "timestamp": "01:16:25", "text": "海岸沿いの近くの場所で"}, {"type": "subtitle", "time": 4587.27, "timestamp": "01:16:27", "text": "そこにはボートや観光船などがあり、"}, {"type": "subtitle", "time": 4589.03, "timestamp": "01:16:29", "text": "すべて、ですよね？だから大きな"}, {"type": "subtitle", "time": 4591.99, "timestamp": "01:16:31", "text": "散歩に最適な場所。ジムはもうありません"}, {"type": "subtitle", "time": 4595.83, "timestamp": "01:16:35", "text": "公共利用のためのもの。ああ、たくさん"}, {"type": "subtitle", "time": 4597.669, "timestamp": "01:16:37", "text": "もの。もっと頻繁にそうだったらいいのに。のように"}, {"type": "subtitle", "time": 4599.99, "timestamp": "01:16:39", "text": "他にもたくさんあります。僕が願っていたように"}, {"type": "subtitle", "time": 4601.27, "timestamp": "01:16:41", "text": "そういった類のもので、"}, {"type": "subtitle", "time": 4603.27, "timestamp": "01:16:43", "text": "公共のジムはありますが、そうですね、私たちには"}, {"type": "subtitle", "time": 4605.51, "timestamp": "01:16:45", "text": "ここにはガレージジムがあり、大手ブランドのような存在です。"}, {"type": "subtitle", "time": 4608.149, "timestamp": "01:16:48", "text": "エニタイムフィットネスのようなジム。私はしません"}, {"type": "subtitle", "time": 4609.83, "timestamp": "01:16:49", "text": "エニタイムフィットネスに本当に行きたい"}, {"type": "subtitle", "time": 4613.31, "timestamp": "01:16:53", "text": "なぜならそれは高価だから"}, {"type": "subtitle", "time": 4617.11, "timestamp": "01:16:57", "text": "そして私は自分の心に刻み込んだ"}]
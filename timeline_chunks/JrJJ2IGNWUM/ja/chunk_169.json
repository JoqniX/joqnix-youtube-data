[{"type": "subtitle", "time": 10145.99, "timestamp": "02:49:05", "text": "順位表示"}, {"type": "subtitle", "time": 10151.11, "timestamp": "02:49:11", "text": "私は、コラボしようとしたのが好きです"}, {"type": "subtitle", "time": 10154.23, "timestamp": "02:49:14", "text": "今は日本のユーチューバーもいるけど、問題は私が"}, {"type": "subtitle", "time": 10156.63, "timestamp": "02:49:16", "text": "プレイするには一定のランクに到達する必要があります"}, {"type": "subtitle", "time": 10173.59, "timestamp": "02:49:33", "text": "彼らは最近私がやったように、たくさんのコラボレーションをしています"}, {"type": "subtitle", "time": 10189.309, "timestamp": "02:49:49", "text": "ああ、カスタムロビー2番目。はい、2番目です"}, {"type": "subtitle", "time": 10193.11, "timestamp": "02:49:53", "text": "カスタム。これは2番目の習慣です。"}, {"type": "subtitle", "time": 10196.91, "timestamp": "02:49:56", "text": "だからその後"}]
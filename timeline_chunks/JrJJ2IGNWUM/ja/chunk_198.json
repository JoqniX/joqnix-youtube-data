[{"type": "subtitle", "time": 11884.229, "timestamp": "03:18:04", "text": "待って、あなたは"}, {"type": "subtitle", "time": 11886.63, "timestamp": "03:18:06", "text": "ヘアールーム？"}, {"type": "subtitle", "time": 11890.55, "timestamp": "03:18:10", "text": "はい。お金を使いましたか？"}, {"type": "subtitle", "time": 11896.309, "timestamp": "03:18:16", "text": "いいえ。どうやって？無料です。はい、それを手に入れました。"}, {"type": "subtitle", "time": 11898.469, "timestamp": "03:18:18", "text": "いつ？"}, {"type": "subtitle", "time": 11904.469, "timestamp": "03:18:24", "text": "レベル50の時に手に入れました。近くのように"}, {"type": "subtitle", "time": 11906.229, "timestamp": "03:18:26", "text": "50."}, {"type": "subtitle", "time": 11909.03, "timestamp": "03:18:29", "text": "待って、レベルアップすると髪の毛がもらえるの？"}, {"type": "subtitle", "time": 11913.19, "timestamp": "03:18:33", "text": "レベル50くらいになったら？何"}, {"type": "subtitle", "time": 11918.59, "timestamp": "03:18:38", "text": "運が良ければ？そうですね、"}, {"type": "subtitle", "time": 11920.389, "timestamp": "03:18:40", "text": "[音楽]"}, {"type": "subtitle", "time": 11922.95, "timestamp": "03:18:42", "text": "いつから配布を始めたのですか"}, {"type": "subtitle", "time": 11924.469, "timestamp": "03:18:44", "text": "無料？"}, {"type": "subtitle", "time": 11926.349, "timestamp": "03:18:46", "text": "つまり"}, {"type": "subtitle", "time": 11936.15, "timestamp": "03:18:56", "text": "えーと"}, {"type": "subtitle", "time": 11939.59, "timestamp": "03:18:59", "text": "それは素晴らしいですね。"}]
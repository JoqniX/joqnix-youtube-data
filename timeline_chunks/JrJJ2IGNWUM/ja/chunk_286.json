[{"type": "subtitle", "time": 17161.43, "timestamp": "04:46:01", "text": "ああ、そういうことなんだ。だから、私はちょっと"}, {"type": "subtitle", "time": 17165.07, "timestamp": "04:46:05", "text": "キャンセル、キャンセルまたは日程変更"}, {"type": "subtitle", "time": 17168.868, "timestamp": "04:46:08", "text": "木曜日と木曜日、金曜日、"}, {"type": "subtitle", "time": 17170.708, "timestamp": "04:46:10", "text": "日曜日。無料スロットです。私は"}, {"type": "subtitle", "time": 17172.948, "timestamp": "04:46:12", "text": "全員入れる。人を集めなきゃ。"}, {"type": "subtitle", "time": 17176.15, "timestamp": "04:46:16", "text": "列に並んでいた人たち。私はしなければならない"}, {"type": "subtitle", "time": 17177.91, "timestamp": "04:46:17", "text": "全部入れて。調べてみないと。"}, {"type": "subtitle", "time": 17180.23, "timestamp": "04:46:20", "text": "そして全て。後でやろうと思う"}, {"type": "subtitle", "time": 17184.07, "timestamp": "04:46:24", "text": "少しだけ睡眠をとる。ええ、そうします"}, {"type": "subtitle", "time": 17188.628, "timestamp": "04:46:28", "text": "ゆっくりやってください。しかし、確かに痛みはあった。とにかく"}, {"type": "subtitle", "time": 17191.11, "timestamp": "04:46:31", "text": "皆さん、私はこれで失礼します。実際に"}, {"type": "subtitle", "time": 17193.91, "timestamp": "04:46:33", "text": "睡眠とか、そういうこと。いくつか物を手に入れなければならない"}, {"type": "chat", "time": 17195.835, "timestamp": "04:46:35", "author": "@Roku-rin", "avatar": "https://yt4.ggpht.com/8LlS_C2IirDMfA5r2V0q5G1kudp8dmG6RQvz_jCAUT3H-esyEgTNPDwrfCXiyX7Undc9UmHNgw=s64-c-k-c0x00ffffff-no-rj", "message": "take ur time good night"}, {"type": "subtitle", "time": 17196.868, "timestamp": "04:46:36", "text": "準備した。それから寝ます。ありがとう"}, {"type": "subtitle", "time": 17199.23, "timestamp": "04:46:39", "text": "今日もまた。本当に、本当に"}, {"type": "subtitle", "time": 17201.99, "timestamp": "04:46:41", "text": "楽しい。右。ありがとう。いいえ。またね。"}, {"type": "subtitle", "time": 17205.31, "timestamp": "04:46:45", "text": "明日の早朝。私は努力します"}, {"type": "subtitle", "time": 17208.15, "timestamp": "04:46:48", "text": "目が覚めて、実際に寝ようと思うのは"}, {"type": "subtitle", "time": 17211.03, "timestamp": "04:46:51", "text": "明日は長い一日になりそうだ。私はしなければならない"}, {"type": "subtitle", "time": 17213.91, "timestamp": "04:46:53", "text": "夜更かしとか色々するよ。待って、明日は"}, {"type": "subtitle", "time": 17215.628, "timestamp": "04:46:55", "text": "私は滞在しなければならない日"}, {"type": "subtitle", "time": 17217.39, "timestamp": "04:46:57", "text": "上？"}]
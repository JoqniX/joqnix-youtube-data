[{"type": "subtitle", "time": 5280.79, "timestamp": "01:28:00", "text": "エラーは必ず発生します。しかし機械も"}, {"type": "subtitle", "time": 5284.55, "timestamp": "01:28:04", "text": "一つは、より機械的なローカライズです。えっと、それは"}, {"type": "subtitle", "time": 5286.629, "timestamp": "01:28:06", "text": "的を外している。ニュアンスが欠けている"}, {"type": "subtitle", "time": 5289.59, "timestamp": "01:28:09", "text": "メッセージの。はい。はい。はい。そしてただ"}, {"type": "subtitle", "time": 5291.669, "timestamp": "01:28:11", "text": "ストレートに翻訳して、"}, {"type": "subtitle", "time": 5294.629, "timestamp": "01:28:14", "text": "その他全てが含まれます。でも、"}, {"type": "subtitle", "time": 5296.07, "timestamp": "01:28:16", "text": "時にはその方が良い、時には"}, {"type": "subtitle", "time": 5297.99, "timestamp": "01:28:17", "text": "それはもっと悪い。そしてそれは彼らにとって役に立つ"}, {"type": "subtitle", "time": 5300.87, "timestamp": "01:28:20", "text": "ケースですよね？でも、"}, {"type": "subtitle", "time": 5303.43, "timestamp": "01:28:23", "text": "ローカライズが好きじゃない気がする"}, {"type": "subtitle", "time": 5305.03, "timestamp": "01:28:25", "text": "彼らがそれを収めようとする場所にそれほど多くのもの"}, {"type": "subtitle", "time": 5307.669, "timestamp": "01:28:27", "text": "特定のアイデアに当てはめたり、それを適合させようとしたりする"}, {"type": "subtitle", "time": 5310.07, "timestamp": "01:28:30", "text": "特定の文化のために、私は本当に"}, {"type": "subtitle", "time": 5312.55, "timestamp": "01:28:32", "text": "君のことが好きじゃない。この良い例"}, {"type": "subtitle", "time": 5315.11, "timestamp": "01:28:35", "text": "カービィのアートは昔のものですか？"}, {"type": "subtitle", "time": 5317.43, "timestamp": "01:28:37", "text": "日。ほら、カービィのパッケージアートみたいなやつ。"}, {"type": "subtitle", "time": 5320.87, "timestamp": "01:28:40", "text": "カービーはアメリカで怒っていて、"}, {"type": "subtitle", "time": 5324.149, "timestamp": "01:28:44", "text": "日本ではめちゃくちゃ可愛い。そういうタイプの"}, {"type": "subtitle", "time": 5327.03, "timestamp": "01:28:47", "text": "もの。うん。彼は「ああ」という感じだ。それはまるで"}, {"type": "subtitle", "time": 5328.629, "timestamp": "01:28:48", "text": "全く別のもの。"}, {"type": "subtitle", "time": 5330.55, "timestamp": "01:28:50", "text": "まるでローカライズして"}, {"type": "subtitle", "time": 5332.149, "timestamp": "01:28:52", "text": "特定のターゲット層に少しだけ販売する"}, {"type": "subtitle", "time": 5333.59, "timestamp": "01:28:53", "text": "さらに、場合によっては変更する"}, {"type": "subtitle", "time": 5335.59, "timestamp": "01:28:55", "text": "それに関するメッセージ。"}, {"type": "subtitle", "time": 5337.91, "timestamp": "01:28:57", "text": "すごく変な感じ。ほぼ確信している"}, {"type": "subtitle", "time": 5339.35, "timestamp": "01:28:59", "text": "ドラマチックな出来事がたくさん起こっている"}]
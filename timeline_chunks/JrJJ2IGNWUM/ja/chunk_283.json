[{"type": "subtitle", "time": 16980.788, "timestamp": "04:43:00", "text": "うん、完璧な2時間だったよね。"}, {"type": "subtitle", "time": 16983.03, "timestamp": "04:43:03", "text": "うんうんうん、完璧な2時間だったよ"}, {"type": "subtitle", "time": 16985.59, "timestamp": "04:43:05", "text": "寿司を歌いながら、私はこれについて"}, {"type": "subtitle", "time": 16988.628, "timestamp": "04:43:08", "text": "完璧な2時間だったよ"}, {"type": "subtitle", "time": 16992.948, "timestamp": "04:43:12", "text": "11時から12時まで。12時から1時まで。うん、2時間。"}, {"type": "subtitle", "time": 16995.07, "timestamp": "04:43:15", "text": "2時間。 2時間。ニース。ニース。ニース。"}, {"type": "subtitle", "time": 16998.788, "timestamp": "04:43:18", "text": "ニース。ニース。私も同じことをしなければならない。私"}, {"type": "subtitle", "time": 17001.15, "timestamp": "04:43:21", "text": "持っている"}, {"type": "subtitle", "time": 17005.35, "timestamp": "04:43:25", "text": "ええ、そうですね。じゃあ、他に誰がいる？ああ、土曜日。"}, {"type": "subtitle", "time": 17006.91, "timestamp": "04:43:26", "text": "あと一人いる。私"}, {"type": "subtitle", "time": 17011.67, "timestamp": "04:43:31", "text": "忘れた。ああ、しまった、彼女のことを忘れてた。ああ、ダン、"}, {"type": "subtitle", "time": 17012.83, "timestamp": "04:43:32", "text": "それは"}, {"type": "subtitle", "time": 17016.788, "timestamp": "04:43:36", "text": "午後3時からそれ。ああ、忘れてた"}, {"type": "subtitle", "time": 17018.708, "timestamp": "04:43:38", "text": "ダシャンについて。"}, {"type": "subtitle", "time": 17021.35, "timestamp": "04:43:41", "text": "私はそこにいる間に、"}, {"type": "subtitle", "time": 17024.788, "timestamp": "04:43:44", "text": "道中、私が手を伸ばしていたダムが見えた"}, {"type": "subtitle", "time": 17026.43, "timestamp": "04:43:46", "text": "人々"}, {"type": "subtitle", "time": 17029.72, "timestamp": "04:43:49", "text": "えっと、私は人々に連絡を取っていました"}, {"type": "subtitle", "time": 17031.23, "timestamp": "04:43:51", "text": "[音楽]"}, {"type": "subtitle", "time": 17035.19, "timestamp": "04:43:55", "text": "えーっと、人々に連絡を取って、"}]
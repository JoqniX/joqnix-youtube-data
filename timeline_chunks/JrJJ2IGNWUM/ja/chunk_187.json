[{"type": "subtitle", "time": 11223.83, "timestamp": "03:07:03", "text": "ゲームを2回再起動しましたが、それでも"}, {"type": "subtitle", "time": 11227.19, "timestamp": "03:07:07", "text": "えっと、理由はわかりません。チームを再起動してください。おお、"}, {"type": "subtitle", "time": 11229.19, "timestamp": "03:07:09", "text": "OKをリセットします。わかった。わかった。わかった。私にさせて"}, {"type": "subtitle", "time": 11231.91, "timestamp": "03:07:11", "text": "そうしてください。出口。"}, {"type": "subtitle", "time": 11238.59, "timestamp": "03:07:18", "text": "たぶん、アップデートがあったからかな"}, {"type": "subtitle", "time": 11242.59, "timestamp": "03:07:22", "text": "ストリーム。わかった、辞めるよ"}, {"type": "subtitle", "time": 11244.79, "timestamp": "03:07:24", "text": "スチーム。シャットダウン"}, {"type": "subtitle", "time": 11247.389, "timestamp": "03:07:27", "text": "[音楽]"}, {"type": "subtitle", "time": 11256.93, "timestamp": "03:07:36", "text": "開ける。発売"}, {"type": "subtitle", "time": 11271.15, "timestamp": "03:07:51", "text": "スチーム。 CFIが見えますね。うん。更新情報なし"}, {"type": "subtitle", "time": 11274.79, "timestamp": "03:07:54", "text": "頂点。ああ、アップデートですね。おお。おお。なるほど"}, {"type": "subtitle", "time": 11279.75, "timestamp": "03:07:59", "text": "アップデート。ああ、なるほど。先ほども言いました。"}]
[{"type": "subtitle", "time": 1382.549, "timestamp": "00:23:02", "text": "かつて持っていた情熱を失ってしまった"}, {"type": "subtitle", "time": 1385.83, "timestamp": "00:23:05", "text": "あるいは、一貫性を保つこと、ですよね？"}, {"type": "subtitle", "time": 1387.83, "timestamp": "00:23:07", "text": "うん。だって、それが私の気持ちだから"}, {"type": "subtitle", "time": 1389.99, "timestamp": "00:23:09", "text": "だって、私たちはたくさんの時間を無駄にしてきたから"}, {"type": "subtitle", "time": 1393.43, "timestamp": "00:23:13", "text": "ビデオゲームをプレイしているような"}, {"type": "subtitle", "time": 1395.83, "timestamp": "00:23:15", "text": "まるで自分が経験したかのような感覚"}, {"type": "subtitle", "time": 1398.47, "timestamp": "00:23:18", "text": "すでに体験したいと思っていた。もちろん、"}, {"type": "subtitle", "time": 1401.029, "timestamp": "00:23:21", "text": "新しい体験、新しいスリルがある"}, {"type": "subtitle", "time": 1402.95, "timestamp": "00:23:22", "text": "今日のゲーム業界では。ご覧のように、"}, {"type": "subtitle", "time": 1405.59, "timestamp": "00:23:25", "text": "人々は新しいものを試したりゲームをしたりするのが好きです"}, {"type": "subtitle", "time": 1408.149, "timestamp": "00:23:28", "text": "はますます"}, {"type": "subtitle", "time": 1410.71, "timestamp": "00:23:30", "text": "受け入れられた文化的概念ではなく、"}, {"type": "subtitle", "time": 1412.789, "timestamp": "00:23:32", "text": "昔は、"}, {"type": "subtitle", "time": 1414.87, "timestamp": "00:23:34", "text": "DSを持ってきただけでいじめられた"}, {"type": "subtitle", "time": 1418.07, "timestamp": "00:23:38", "text": "学校。ちなみに、それは私のことです。ああ、"}, {"type": "subtitle", "time": 1420.87, "timestamp": "00:23:40", "text": "神。そう、昔のビデオゲームは"}, {"type": "subtitle", "time": 1423.19, "timestamp": "00:23:43", "text": "あまり評価されていなかったし、"}, {"type": "subtitle", "time": 1425.59, "timestamp": "00:23:45", "text": "ビデオゲームにすごくハマっていた頃"}, {"type": "subtitle", "time": 1428.23, "timestamp": "00:23:48", "text": "人々が"}, {"type": "subtitle", "time": 1429.75, "timestamp": "00:23:49", "text": "実際にそういうのを楽しんでる"}, {"type": "subtitle", "time": 1433.029, "timestamp": "00:23:53", "text": "それから。つまり、ビデオゲームの場合、"}, {"type": "subtitle", "time": 1434.87, "timestamp": "00:23:54", "text": "彼らはただ"}, {"type": "subtitle", "time": 1437.83, "timestamp": "00:23:57", "text": "くだらない楽しみであることは理解しています"}]
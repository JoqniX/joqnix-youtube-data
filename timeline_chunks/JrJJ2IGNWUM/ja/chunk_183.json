[{"type": "subtitle", "time": 10981.03, "timestamp": "03:03:01", "text": "乗れ。乗れ。さあ、サカ。 H."}, {"type": "subtitle", "time": 10990.23, "timestamp": "03:03:10", "text": "いいえ。あなたは見ていません"}, {"type": "subtitle", "time": 10993.83, "timestamp": "03:03:13", "text": "何？理解できなかったの？"}, {"type": "subtitle", "time": 10999.67, "timestamp": "03:03:19", "text": "理解できなかったけど、"}, {"type": "subtitle", "time": 11001.99, "timestamp": "03:03:21", "text": "同じ。"}, {"type": "subtitle", "time": 11005.51, "timestamp": "03:03:25", "text": "待って、再起動したの？再始動？"}, {"type": "subtitle", "time": 11007.75, "timestamp": "03:03:27", "text": "はい。"}, {"type": "subtitle", "time": 11016.75, "timestamp": "03:03:36", "text": "待って、私のパーティーに参加して。"}, {"type": "subtitle", "time": 11018.51, "timestamp": "03:03:38", "text": "うん、"}, {"type": "subtitle", "time": 11021.67, "timestamp": "03:03:41", "text": "受け入れる。参加失敗ゲームは参加しません"}, {"type": "subtitle", "time": 11024.99, "timestamp": "03:03:44", "text": "試合主催者。何"}, {"type": "subtitle", "time": 11028.79, "timestamp": "03:03:48", "text": "えっ？通常のゲームに参加してみるべきでしょうか？"}, {"type": "subtitle", "time": 11038.07, "timestamp": "03:03:58", "text": "通常通りゲームをプレイして、一度終了して、また戻ってきてください。"}]
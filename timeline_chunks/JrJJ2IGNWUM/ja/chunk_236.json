[{"type": "subtitle", "time": 14161.99, "timestamp": "03:56:01", "text": "それについて私に挑戦してみろ。えっと、もし"}, {"type": "subtitle", "time": 14163.469, "timestamp": "03:56:03", "text": "あなたは無料です"}, {"type": "subtitle", "time": 14167.03, "timestamp": "03:56:07", "text": "6月。あと2週間しか残っていない。だから"}, {"type": "subtitle", "time": 14169.11, "timestamp": "03:56:09", "text": "6月に都合の良い日を教えてください。良い"}, {"type": "subtitle", "time": 14172.03, "timestamp": "03:56:12", "text": "最大1時間までで行ってください。 1～2時間"}, {"type": "subtitle", "time": 14175.429, "timestamp": "03:56:15", "text": "最大。私は今、"}, {"type": "subtitle", "time": 14178.469, "timestamp": "03:56:18", "text": "1日に複数のコラボレーションを詰め込む。"}, {"type": "subtitle", "time": 14181.11, "timestamp": "03:56:21", "text": "1人につき1時間、1"}, {"type": "subtitle", "time": 14183.269, "timestamp": "03:56:23", "text": "そんな風に、他の人のために1時間も費やす。 1"}, {"type": "subtitle", "time": 14185.99, "timestamp": "03:56:25", "text": "そんな感じで1時間、2時間。一時停止します"}, {"type": "subtitle", "time": 14188.229, "timestamp": "03:56:28", "text": "の"}, {"type": "subtitle", "time": 14191.99, "timestamp": "03:56:31", "text": "こんにちは。ああ、おかえりなさい。"}, {"type": "subtitle", "time": 14194.63, "timestamp": "03:56:34", "text": "ありがとう。"}, {"type": "subtitle", "time": 14197.7, "timestamp": "03:56:37", "text": "おかえり。"}, {"type": "subtitle", "time": 14215.67, "timestamp": "03:56:55", "text": "うん。夕食は食べましたか？よし。"}, {"type": "subtitle", "time": 14218.67, "timestamp": "03:56:58", "text": "私は好きでした"}]
[{"type": "subtitle", "time": 2880.56, "timestamp": "00:48:00", "text": "何かに夢中になっていると、忘れてしまう あなたは実際に仕事をしていて、"}, {"type": "subtitle", "time": 2882.0, "timestamp": "00:48:02", "text": "あなたは実際に仕事をしていて、 ただじっと見つめているだけですよね？"}, {"type": "subtitle", "time": 2885.04, "timestamp": "00:48:05", "text": "ただじっと見つめているだけですよね？ 私が"}, {"type": "subtitle", "time": 2886.56, "timestamp": "00:48:06", "text": "私が 実際はただ仕事をして"}, {"type": "subtitle", "time": 2888.88, "timestamp": "00:48:08", "text": "実際はただ仕事をして 何かを聞いてください。私には無理です"}, {"type": "subtitle", "time": 2891.44, "timestamp": "00:48:11", "text": "何かを聞いてください。私には無理です だって私は理解することに集中しすぎているから"}, {"type": "subtitle", "time": 2895.2, "timestamp": "00:48:15", "text": "だって私は理解することに集中しすぎているから 彼らが話していることや好きなこと"}, {"type": "subtitle", "time": 2897.2, "timestamp": "00:48:17", "text": "彼らが話していることや好きなこと 彼らが話している内容に興味がある"}, {"type": "subtitle", "time": 2898.64, "timestamp": "00:48:18", "text": "彼らが話している内容に興味がある 私は自分が持っていることを完全に忘れてしまう"}, {"type": "subtitle", "time": 2901.119, "timestamp": "00:48:21", "text": "私は自分が持っていることを完全に忘れてしまう 私が"}, {"type": "subtitle", "time": 2907.75, "timestamp": "00:48:27", "text": "実行中。でも、ああ、俺は"}, {"type": "subtitle", "time": 2909.51, "timestamp": "00:48:29", "text": "君たちの配信をもっと頻繁に見たいな"}, {"type": "subtitle", "time": 2912.309, "timestamp": "00:48:32", "text": "だって、私はあまり頻繁にオンラインにならないから。"}, {"type": "subtitle", "time": 2915.27, "timestamp": "00:48:35", "text": "そう、私はそうなる運命ではなかった"}, {"type": "subtitle", "time": 2917.27, "timestamp": "00:48:37", "text": "今日も無料です。私は、私は、私はただ"}, {"type": "subtitle", "time": 2919.109, "timestamp": "00:48:39", "text": "予定を変更して別の予定を入れる"}, {"type": "subtitle", "time": 2922.39, "timestamp": "00:48:42", "text": "本日より入手可能です。えっ、何？しないで"}, {"type": "subtitle", "time": 2923.51, "timestamp": "00:48:43", "text": "気にしなくていいよ。それは それは"}, {"type": "subtitle", "time": 2924.87, "timestamp": "00:48:44", "text": "それは些細なことです。軽微な"}, {"type": "subtitle", "time": 2927.99, "timestamp": "00:48:47", "text": "もの。心配しないで。些細なことです。"}, {"type": "subtitle", "time": 2930.069, "timestamp": "00:48:50", "text": "わかった。いや、いや、いや、いや、いや、いや。いいえ、いいえ、"}, {"type": "subtitle", "time": 2931.67, "timestamp": "00:48:51", "text": "いや、いや、いや。気にしないで。感じないで"}, {"type": "subtitle", "time": 2933.51, "timestamp": "00:48:53", "text": "悪い。たいしたことないよ、おい。その"}, {"type": "subtitle", "time": 2936.47, "timestamp": "00:48:56", "text": "なんて些細なこと。ごく些細なことだ。私はただ"}, {"type": "subtitle", "time": 2938.15, "timestamp": "00:48:58", "text": "スケジュールから外さざるを得なかった。"}]
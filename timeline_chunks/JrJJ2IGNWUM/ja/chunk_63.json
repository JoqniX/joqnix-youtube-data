[{"type": "subtitle", "time": 3781.03, "timestamp": "01:03:01", "text": "何？マウンテンデュー。戻ってきてほしい、"}, {"type": "subtitle", "time": 3785.43, "timestamp": "01:03:05", "text": "お前。ああ、マウンテンデュー。うん。"}, {"type": "subtitle", "time": 3786.47, "timestamp": "01:03:06", "text": "よし、ちょっと待って。私は"}, {"type": "subtitle", "time": 3789.67, "timestamp": "01:03:09", "text": "ペプシブルーのようなイメージ。 1秒。"}, {"type": "subtitle", "time": 3792.75, "timestamp": "01:03:12", "text": "だって、俺はずっと探していたんだ"}, {"type": "subtitle", "time": 3795.75, "timestamp": "01:03:15", "text": "めちゃくちゃ長い。誰も売っていない"}, {"type": "subtitle", "time": 3797.27, "timestamp": "01:03:17", "text": "もう、彼らは完全に"}, {"type": "subtitle", "time": 3799.43, "timestamp": "01:03:19", "text": "販売を中止しました。ええ、それはベリーです"}, {"type": "subtitle", "time": 3803.109, "timestamp": "01:03:23", "text": "ペプシのフレーバー付きコーラ飲料。"}, {"type": "subtitle", "time": 3805.19, "timestamp": "01:03:25", "text": "ペプシブルーが大好きだけど、"}, {"type": "subtitle", "time": 3806.87, "timestamp": "01:03:26", "text": "くそ、それを抜いたと思う、なぜなら私は"}, {"type": "subtitle", "time": 3809.349, "timestamp": "01:03:29", "text": "もう見かけなくなった。私はこれまで"}, {"type": "subtitle", "time": 3811.43, "timestamp": "01:03:31", "text": "の時代に言及された人々のことを聞いたことがある"}, {"type": "subtitle", "time": 3814.23, "timestamp": "01:03:34", "text": "そんなこと言わないで、パット。私は年寄りではない。良い、"}, {"type": "subtitle", "time": 3817.75, "timestamp": "01:03:37", "text": "そうだけど、そんなに年寄りじゃないよ。ここ、"}, {"type": "subtitle", "time": 3818.829, "timestamp": "01:03:38", "text": "ここ。させて"}, {"type": "subtitle", "time": 3822.109, "timestamp": "01:03:42", "text": "私 画像をコピー"}, {"type": "subtitle", "time": 3824.27, "timestamp": "01:03:44", "text": "アドレスブラウザ"}, {"type": "subtitle", "time": 3826.549, "timestamp": "01:03:46", "text": "ソース。ストリームをチェックすると、"}, {"type": "subtitle", "time": 3828.15, "timestamp": "01:03:48", "text": "あなたは私が何を望んでいるかを知るでしょう"}, {"type": "subtitle", "time": 3830.789, "timestamp": "01:03:50", "text": "私が言っているのは地獄のことだ。これはペプシです"}, {"type": "subtitle", "time": 3833.95, "timestamp": "01:03:53", "text": "青。青いペプシです。ベリーです"}, {"type": "subtitle", "time": 3837.27, "timestamp": "01:03:57", "text": "風味付き。昔はこういうのが大好きだったんだ。私"}, {"type": "subtitle", "time": 3839.75, "timestamp": "01:03:59", "text": "私は今でもそれが恋しいのですが、"}]
[{"type": "subtitle", "time": 2522.309, "timestamp": "00:42:02", "text": "医者。私にはかかりつけの医者はいるのだろうか？いいえ。"}, {"type": "subtitle", "time": 2523.99, "timestamp": "00:42:03", "text": "私には専用の病院すらありません。"}, {"type": "subtitle", "time": 2527.109, "timestamp": "00:42:07", "text": "私たちはただ、どこへでも行くだけです。"}, {"type": "subtitle", "time": 2529.27, "timestamp": "00:42:09", "text": "私たちが話していたもう一つの話題について"}, {"type": "subtitle", "time": 2531.67, "timestamp": "00:42:11", "text": "について。ええ、実際にそういうことをした人がいましたよ。"}, {"type": "subtitle", "time": 2535.19, "timestamp": "00:42:15", "text": "名前を聞きました。何てことだ。何？あなた"}, {"type": "subtitle", "time": 2539.349, "timestamp": "00:42:19", "text": "した？日本のVTuberです。これはASMRです"}, {"type": "subtitle", "time": 2541.109, "timestamp": "00:42:21", "text": "YouTuber。"}, {"type": "subtitle", "time": 2549.27, "timestamp": "00:42:29", "text": "アドベントとか、そんな感じのやつ。"}, {"type": "subtitle", "time": 2556.79, "timestamp": "00:42:36", "text": "でも、例えばユーチューバーについて話すと、"}, {"type": "subtitle", "time": 2558.87, "timestamp": "00:42:38", "text": "最近はどんなことにハマってるの？"}, {"type": "subtitle", "time": 2563.43, "timestamp": "00:42:43", "text": "見ている？私は見ていません"}, {"type": "subtitle", "time": 2565.109, "timestamp": "00:42:45", "text": "私は動画クリップしか見ていません。それで"}, {"type": "subtitle", "time": 2567.99, "timestamp": "00:42:47", "text": "時々、ランダムなクリップを見ると"}, {"type": "subtitle", "time": 2570.19, "timestamp": "00:42:50", "text": "などなど、私は見ています"}, {"type": "subtitle", "time": 2572.87, "timestamp": "00:42:52", "text": "それ。私は座って"}, {"type": "subtitle", "time": 2577.109, "timestamp": "00:42:57", "text": "ストリーミング配信を見るのが好きです。うん。つまり、"}]
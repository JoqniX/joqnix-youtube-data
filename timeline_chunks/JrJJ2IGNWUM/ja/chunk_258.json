[{"type": "subtitle", "time": 15480.149, "timestamp": "04:18:00", "text": "ここに来た方がいいと思う。"}, {"type": "subtitle", "time": 15485.189, "timestamp": "04:18:05", "text": "一人だけが行くと思っていた"}, {"type": "chat", "time": 15487.377, "timestamp": "04:18:07", "author": "@Roku-rin", "avatar": "https://yt4.ggpht.com/8LlS_C2IirDMfA5r2V0q5G1kudp8dmG6RQvz_jCAUT3H-esyEgTNPDwrfCXiyX7Undc9UmHNgw=s64-c-k-c0x00ffffff-no-rj", "message": "thats me btw"}, {"type": "subtitle", "time": 15488.269, "timestamp": "04:18:08", "text": "土地。うん、私も同じ。"}, {"type": "subtitle", "time": 15493.429, "timestamp": "04:18:13", "text": "それから私はたくさんの"}, {"type": "subtitle", "time": 15496.79, "timestamp": "04:18:16", "text": "何てことだ。その通り。それは私です、"}, {"type": "subtitle", "time": 15499.11, "timestamp": "04:18:19", "text": "方法。一体どういうことだ？"}, {"type": "subtitle", "time": 15501.71, "timestamp": "04:18:21", "text": "いや、違うよ。あなたは"}, {"type": "subtitle", "time": 15504.469, "timestamp": "04:18:24", "text": "荒らし行為。あなたはRokuを荒らしている。いや、"}, {"type": "subtitle", "time": 15511.75, "timestamp": "04:18:31", "text": "ミラージュ。"}, {"type": "chat", "time": 15512.342, "timestamp": "04:18:32", "author": "@Roku-rin", "avatar": "https://yt4.ggpht.com/8LlS_C2IirDMfA5r2V0q5G1kudp8dmG6RQvz_jCAUT3H-esyEgTNPDwrfCXiyX7Undc9UmHNgw=s64-c-k-c0x00ffffff-no-rj", "message": "check names in feedback "}, {"type": "subtitle", "time": 15515.309, "timestamp": "04:18:35", "text": "私はミラージュを使っていました。"}, {"type": "subtitle", "time": 15518.309, "timestamp": "04:18:38", "text": "ストリームスナイプされて、"}, {"type": "subtitle", "time": 15520.83, "timestamp": "04:18:40", "text": "文字通り、私を殺します。それは"}, {"type": "subtitle", "time": 15524.99, "timestamp": "04:18:44", "text": "小切手の名前とフィードバック。"}, {"type": "subtitle", "time": 15538.95, "timestamp": "04:18:58", "text": "何？注意深く見守っています。"}]
[{"type": "subtitle", "time": 1202.23, "timestamp": "00:20:02", "text": "とても近いように感じますが、"}, {"type": "subtitle", "time": 1204.15, "timestamp": "00:20:04", "text": "手の届かないところにある。"}, {"type": "subtitle", "time": 1206.07, "timestamp": "00:20:06", "text": "すぐ隣の部屋だけど、"}, {"type": "subtitle", "time": 1209.35, "timestamp": "00:20:09", "text": "その部屋に行く"}, {"type": "subtitle", "time": 1212.07, "timestamp": "00:20:12", "text": "または、あなたを阻む障害物のように"}, {"type": "subtitle", "time": 1215.07, "timestamp": "00:20:15", "text": "壁は押すことができない、または"}, {"type": "subtitle", "time": 1217.35, "timestamp": "00:20:17", "text": "何かそういう類のもの。うん、わかるよ"}, {"type": "subtitle", "time": 1220.549, "timestamp": "00:20:20", "text": "それ。うん。そしてこれは人間にも起こる"}, {"type": "subtitle", "time": 1223.11, "timestamp": "00:20:23", "text": "また、私が望むものすべてと同じように"}, {"type": "subtitle", "time": 1226.39, "timestamp": "00:20:26", "text": "そう言われると、「ああ、人生の一部だよ」って思うんです。"}, {"type": "subtitle", "time": 1229.909, "timestamp": "00:20:29", "text": "いずれは乗り越えられると思うよ。"}, {"type": "subtitle", "time": 1231.35, "timestamp": "00:20:31", "text": "時間はかかるけど、みんな"}, {"type": "subtitle", "time": 1236.39, "timestamp": "00:20:36", "text": "かなりの努力が必要だ"}, {"type": "subtitle", "time": 1239.87, "timestamp": "00:20:39", "text": "けれど。私はそれが好きではない。"}, {"type": "subtitle", "time": 1242.11, "timestamp": "00:20:42", "text": "うん。"}, {"type": "subtitle", "time": 1248.39, "timestamp": "00:20:48", "text": "初対面？実際は"}, {"type": "subtitle", "time": 1250.789, "timestamp": "00:20:50", "text": "さくらだよね？何てことだ。私はしません"}, {"type": "subtitle", "time": 1253.51, "timestamp": "00:20:53", "text": "覚えておいて、だって私はどれが"}, {"type": "subtitle", "time": 1255.669, "timestamp": "00:20:55", "text": "先に来たのは君か、それとも鈴木か。私はしません"}, {"type": "subtitle", "time": 1258.31, "timestamp": "00:20:58", "text": "今、覚えておいてください。まるで私はとても"}]
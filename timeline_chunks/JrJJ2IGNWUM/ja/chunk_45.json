[{"type": "subtitle", "time": 2702.87, "timestamp": "00:45:02", "text": "快適、快適、快適。うん。そうではありません。"}, {"type": "subtitle", "time": 2704.63, "timestamp": "00:45:04", "text": "問題はここですよね？何が"}, {"type": "subtitle", "time": 2707.67, "timestamp": "00:45:07", "text": "レベルとは、どのようなレベルですか？"}, {"type": "subtitle", "time": 2710.309, "timestamp": "00:45:10", "text": "うちには小さなクソ野郎がいるのか？右？あなたが知っている"}, {"type": "subtitle", "time": 2711.51, "timestamp": "00:45:11", "text": "私が言っていること、分かりますよね、ジョッキー？"}, {"type": "subtitle", "time": 2714.39, "timestamp": "00:45:14", "text": "ゴブリンとかグレムリンとか、"}, {"type": "subtitle", "time": 2717.51, "timestamp": "00:45:17", "text": "グレムリッドがいる。"}, {"type": "subtitle", "time": 2719.589, "timestamp": "00:45:19", "text": "何てことだ。たくさんあります"}, {"type": "subtitle", "time": 2722.23, "timestamp": "00:45:22", "text": "それには涙が出た。だから私は、何何って感じだった"}, {"type": "subtitle", "time": 2724.47, "timestamp": "00:45:24", "text": "レベルはエナですか？彼女はただのダジャレだから"}, {"type": "subtitle", "time": 2727.67, "timestamp": "00:45:27", "text": "楽しむ達人。彼女はクソ女じゃない。"}, {"type": "subtitle", "time": 2729.67, "timestamp": "00:45:29", "text": "彼女はクソ女じゃないって言えるよ、"}, {"type": "subtitle", "time": 2731.829, "timestamp": "00:45:31", "text": "俺はクソ野郎だろ？"}, {"type": "subtitle", "time": 2733.589, "timestamp": "00:45:33", "text": "でも実際はそうじゃない。私はグレムリンです。"}, {"type": "subtitle", "time": 2735.51, "timestamp": "00:45:35", "text": "間違っている。私が間違っていた。私が間違っていた。とても"}, {"type": "subtitle", "time": 2742.39, "timestamp": "00:45:42", "text": "うん。うん。そうだよね。うん。そこには"}, {"type": "subtitle", "time": 2745.99, "timestamp": "00:45:45", "text": "生意気なガキ、グレムリンがいる、えーと"}, {"type": "subtitle", "time": 2748.309, "timestamp": "00:45:48", "text": "ゴブリン、たくさんいるんだよ、おい。"}, {"type": "subtitle", "time": 2751.349, "timestamp": "00:45:51", "text": "それは何という名前ですか？それが何だったか忘れてしまった"}, {"type": "subtitle", "time": 2753.17, "timestamp": "00:45:53", "text": "電話がかかってきた。ああ、"}, {"type": "subtitle", "time": 2754.99, "timestamp": "00:45:54", "text": "[音楽]"}]
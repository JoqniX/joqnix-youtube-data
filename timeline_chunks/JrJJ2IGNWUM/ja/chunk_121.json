[{"type": "subtitle", "time": 7263.51, "timestamp": "02:01:03", "text": "Twitchではゲームをほとんどプレイしないので"}, {"type": "subtitle", "time": 7267.83, "timestamp": "02:01:07", "text": "Twitchでは完全なウルトラ設定が欲しいと言った"}, {"type": "subtitle", "time": 7271.43, "timestamp": "02:01:11", "text": "視聴者のインタラクションは、どんな場合でも"}, {"type": "subtitle", "time": 7274.629, "timestamp": "02:01:14", "text": "チャットモード100%。うん。だから私は思った"}, {"type": "subtitle", "time": 7278.47, "timestamp": "02:01:18", "text": "YouTubeをやめるのはやめよう。だから私は"}, {"type": "subtitle", "time": 7281.43, "timestamp": "02:01:21", "text": "YouTubeでも配信中です。なぜだろうと思った"}, {"type": "subtitle", "time": 7283.99, "timestamp": "02:01:23", "text": "このプラットフォームをゲーム配信に使用しないでください"}, {"type": "subtitle", "time": 7287.35, "timestamp": "02:01:27", "text": "ゲームなどをして楽しむのが好きです"}]
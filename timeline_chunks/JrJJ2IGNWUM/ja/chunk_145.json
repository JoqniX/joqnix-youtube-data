[{"type": "subtitle", "time": 8703.07, "timestamp": "02:25:03", "text": "悲しい章。えっと、"}, {"type": "subtitle", "time": 8705.75, "timestamp": "02:25:05", "text": "ダメージ処理はほぼ完了しました"}, {"type": "subtitle", "time": 8708.27, "timestamp": "02:25:08", "text": "あれ。おお。おお。"}, {"type": "subtitle", "time": 8712.95, "timestamp": "02:25:12", "text": "ああ、JPが負けたから「いや、ないよ」って感じ。"}, {"type": "subtitle", "time": 8715.03, "timestamp": "02:25:15", "text": "それは、それは、それは、それは"}, {"type": "subtitle", "time": 8722.15, "timestamp": "02:25:22", "text": "帽子。なぜ人々は自由にできないのか"}, {"type": "subtitle", "time": 8725.03, "timestamp": "02:25:25", "text": "彼らが何をしようと、一体何であろうと"}, {"type": "subtitle", "time": 8725.95, "timestamp": "02:25:25", "text": "彼らは"}, {"type": "subtitle", "time": 8730.63, "timestamp": "02:25:30", "text": "欲しい？なぜこの人たちは「いや、"}, {"type": "subtitle", "time": 8733.07, "timestamp": "02:25:33", "text": "家族。そんなことはできません。あなたはできない"}, {"type": "subtitle", "time": 8748.51, "timestamp": "02:25:48", "text": "痛み？まさにその通り。"}]
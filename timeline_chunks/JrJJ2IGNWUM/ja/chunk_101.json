[{"type": "subtitle", "time": 6061.35, "timestamp": "01:41:01", "text": "いいと思ったよ。私は知っています"}, {"type": "subtitle", "time": 6062.91, "timestamp": "01:41:02", "text": "多くの人々"}, {"type": "subtitle", "time": 6065.109, "timestamp": "01:41:05", "text": "多くの人が実際に"}, {"type": "subtitle", "time": 6066.629, "timestamp": "01:41:06", "text": "私も楽しめました。一般的に"}, {"type": "subtitle", "time": 6069.83, "timestamp": "01:41:09", "text": "人々はそれを良い映画だと考えている。"}, {"type": "subtitle", "time": 6072.149, "timestamp": "01:41:12", "text": "ああ、今考えてみると、"}, {"type": "subtitle", "time": 6073.99, "timestamp": "01:41:13", "text": "多くの優れたビデオゲーム映画が"}, {"type": "subtitle", "time": 6075.43, "timestamp": "01:41:15", "text": "カミングアウト。はぁ。おそらく見るべき"}, {"type": "subtitle", "time": 6078.55, "timestamp": "01:41:18", "text": "ソニック3。ソニック3は見ていません。"}, {"type": "subtitle", "time": 6079.99, "timestamp": "01:41:19", "text": "あれは見ておくべきだろう。それらは"}, {"type": "subtitle", "time": 6081.669, "timestamp": "01:41:21", "text": "生成された文字とイタリア語が与えられた"}, {"type": "subtitle", "time": 6084.709, "timestamp": "01:41:24", "text": "名前とか、何か。ああ、"}, {"type": "subtitle", "time": 6087.669, "timestamp": "01:41:27", "text": "それは、待って、待って、待つという意味です。サフール（夜明け前の食事）を食べましょう。"}, {"type": "subtitle", "time": 6089.51, "timestamp": "01:41:29", "text": "ああ、そういう意味だったんですね。私は"}, {"type": "subtitle", "time": 6091.03, "timestamp": "01:41:31", "text": "マインクラフトの映画。授業後ならいいかもしれません。"}, {"type": "subtitle", "time": 6092.31, "timestamp": "01:41:32", "text": "ええ、そうするべきです。ヤッピー。きれい"}, {"type": "subtitle", "time": 6096.59, "timestamp": "01:41:36", "text": "いいよ、だって彼らは必ずしもそうじゃないから"}, {"type": "subtitle", "time": 6100.31, "timestamp": "01:41:40", "text": "特定の物事に過度に集中し、"}, {"type": "subtitle", "time": 6102.79, "timestamp": "01:41:42", "text": "彼らはただそれを面白い話にしているだけだ。"}, {"type": "subtitle", "time": 6104.39, "timestamp": "01:41:44", "text": "彼らは実際には伝承を追求しているわけではない"}, {"type": "subtitle", "time": 6107.27, "timestamp": "01:41:47", "text": "正確さとか、そういう類のこと。彼らは"}, {"type": "subtitle", "time": 6108.95, "timestamp": "01:41:48", "text": "単に、"}, {"type": "subtitle", "time": 6112.229, "timestamp": "01:41:52", "text": "ゲームを楽しんで、"}, {"type": "subtitle", "time": 6114.35, "timestamp": "01:41:54", "text": "描写する"}, {"type": "subtitle", "time": 6116.95, "timestamp": "01:41:56", "text": "キャラクター。見るのが本当に楽しみです"}, {"type": "subtitle", "time": 6119.27, "timestamp": "01:41:59", "text": "新しい映画が公開される予定で、"}]
[{"type": "subtitle", "time": 6541.669, "timestamp": "01:49:01", "text": "7月まで休止します。ええ、そうです。何？"}, {"type": "subtitle", "time": 6544.31, "timestamp": "01:49:04", "text": "スマーフェット。彼はひどく落ち込んでいる。ああ、そうかい。彼は"}, {"type": "subtitle", "time": 6546.149, "timestamp": "01:49:06", "text": "ひどく落ち込んでいる。彼は舌をひっくり返す準備ができている"}, {"type": "subtitle", "time": 6549.91, "timestamp": "01:49:09", "text": "スマーフェットには青を。悪くないね。待って、"}, {"type": "subtitle", "time": 6551.59, "timestamp": "01:49:11", "text": "待って、ちょっと聞いて。もう一つあります。"}, {"type": "subtitle", "time": 6553.03, "timestamp": "01:49:13", "text": "「もう一つあるよ」と彼は言った。ここに"}, {"type": "subtitle", "time": 6555.55, "timestamp": "01:49:15", "text": "「もう1つ」と彼は言った。ほら、"}, {"type": "subtitle", "time": 6558.55, "timestamp": "01:49:18", "text": "アルビンと"}, {"type": "subtitle", "time": 6561.75, "timestamp": "01:49:21", "text": "シマリス。うん。彼女は準備万端だ。彼は準備万端だ"}, {"type": "subtitle", "time": 6564.87, "timestamp": "01:49:24", "text": "メインのように粉砕する、メイン"}, {"type": "subtitle", "time": 6573.27, "timestamp": "01:49:33", "text": "うん。へへ、彼は毛皮にひどく落ち込んでいる"}, {"type": "subtitle", "time": 6574.99, "timestamp": "01:49:34", "text": "キャラクター。彼を責めることはできない。"}, {"type": "subtitle", "time": 6577.35, "timestamp": "01:49:37", "text": "正直言って、私には理解できません。私は違います"}, {"type": "subtitle", "time": 6580.87, "timestamp": "01:49:40", "text": "ケモナーだけど、でも、彼の話を聞いてみるよ。病気"}, {"type": "subtitle", "time": 6588.629, "timestamp": "01:49:48", "text": "彼が何と言ったか知りたいですか？あなたは欲しい"}, {"type": "subtitle", "time": 6591.03, "timestamp": "01:49:51", "text": "彼が何を言ったのかを知るために？彼らはすでに"}, {"type": "subtitle", "time": 6599.43, "timestamp": "01:49:59", "text": "おい、あいつらはもう[ __ ]を持ってるぞ"}]
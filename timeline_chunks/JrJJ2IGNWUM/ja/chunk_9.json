[{"type": "subtitle", "time": 540.79, "timestamp": "00:09:00", "text": "ただ一緒に時間を過ごすだけ。つまり、それは"}, {"type": "subtitle", "time": 542.31, "timestamp": "00:09:02", "text": "私がアメリカ英語のアクセントを習得した理由"}, {"type": "subtitle", "time": 544.71, "timestamp": "00:09:04", "text": "私は0％ですが"}, {"type": "subtitle", "time": 547.949, "timestamp": "00:09:07", "text": "アメリカ人だよ、おい。私は白血球を持っていません"}, {"type": "subtitle", "time": 553.11, "timestamp": "00:09:13", "text": "自分。私に残っているのは、フィリピン人の血だけだ。"}, {"type": "subtitle", "time": 554.949, "timestamp": "00:09:14", "text": "フィリピン語と少し中国語の知識があります。"}, {"type": "subtitle", "time": 558.07, "timestamp": "00:09:18", "text": "それでおしまい。"}, {"type": "subtitle", "time": 561.269, "timestamp": "00:09:21", "text": "ええ、わかりました。"}, {"type": "subtitle", "time": 563.75, "timestamp": "00:09:23", "text": "ええ、彼らはそれで大丈夫でした"}, {"type": "subtitle", "time": 566.07, "timestamp": "00:09:26", "text": "それ。彼らは、あなたがしていることと同じように"}, {"type": "subtitle", "time": 568.47, "timestamp": "00:09:28", "text": "あなたが正しく行いたいこと"}, {"type": "subtitle", "time": 570.47, "timestamp": "00:09:30", "text": "初めてで、彼らはとても"}, {"type": "subtitle", "time": 573.11, "timestamp": "00:09:33", "text": "選んだことを嬉しく思います"}, {"type": "subtitle", "time": 575.75, "timestamp": "00:09:35", "text": "えっと、これをやって、彼らはなぜかと尋ねた"}, {"type": "subtitle", "time": 578.55, "timestamp": "00:09:38", "text": "以前にもこのことを伝えに来なかったのですか？"}, {"type": "subtitle", "time": 580.87, "timestamp": "00:09:40", "text": "時間があったのに、なぜ無駄にしたのですか？"}, {"type": "subtitle", "time": 584.55, "timestamp": "00:09:44", "text": "あなたの時間を何度も使って、そう、私は"}, {"type": "subtitle", "time": 586.389, "timestamp": "00:09:46", "text": "私もそうだけど、そうだった"}, {"type": "subtitle", "time": 589.829, "timestamp": "00:09:49", "text": "ああ、そうすべきじゃない、という突然の考え"}, {"type": "subtitle", "time": 593.59, "timestamp": "00:09:53", "text": "怖くて聞けないけど、自信を持って話すよ"}, {"type": "subtitle", "time": 596.23, "timestamp": "00:09:56", "text": "おい、俺も前はそうだったんだよ、だって、えーと"}, {"type": "subtitle", "time": 598.71, "timestamp": "00:09:58", "text": "面白い話だ。私も同じ状況でした"}]
[{"type": "subtitle", "time": 15001.269, "timestamp": "04:10:01", "text": "正直に言おう。私は唯一の本物"}, {"type": "subtitle", "time": 15004.309, "timestamp": "04:10:04", "text": "チャンピオンはここにいます。あちらへ行きましょう。私は"}, {"type": "subtitle", "time": 15007.59, "timestamp": "04:10:07", "text": "退屈だ。ラムル、"}, {"type": "subtitle", "time": 15010.07, "timestamp": "04:10:10", "text": "私が"}, {"type": "subtitle", "time": 15013.189, "timestamp": "04:10:13", "text": "あ、待って。えっと、彼はオクタンを飲んだんだ。それは"}, {"type": "subtitle", "time": 15017.349, "timestamp": "04:10:17", "text": "私がレヴナントである理由。気付かなかった"}, {"type": "subtitle", "time": 15023.83, "timestamp": "04:10:23", "text": "私は「待って、なぜ、なぜ"}, {"type": "subtitle", "time": 15026.55, "timestamp": "04:10:26", "text": "亡霊の音？私はレヴナントではありません。私は"}]
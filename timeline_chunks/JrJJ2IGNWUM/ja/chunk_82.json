[{"type": "subtitle", "time": 4920.709, "timestamp": "01:22:00", "text": "最近は私を招待してください。そして最後"}, {"type": "subtitle", "time": 4924.39, "timestamp": "01:22:04", "text": "飲んでたんだけど、たぶん、やばい"}, {"type": "subtitle", "time": 4928.55, "timestamp": "01:22:08", "text": "ジンを20杯くらい飲んだと思う。"}, {"type": "subtitle", "time": 4931.51, "timestamp": "01:22:11", "text": "純粋なジン20杯。それは"}, {"type": "subtitle", "time": 4933.35, "timestamp": "01:22:13", "text": "ショットグラスのように。ショットよりも大きかった"}, {"type": "subtitle", "time": 4935.75, "timestamp": "01:22:15", "text": "眼鏡。あのプラスチックカップ、知ってる？おお"}, {"type": "subtitle", "time": 4940.709, "timestamp": "01:22:20", "text": "はい。私はそれほどひどく酔っていた。ああ、もう。しかし"}, {"type": "subtitle", "time": 4942.629, "timestamp": "01:22:22", "text": "うん、普段は人に頼まれたら飲むよ"}, {"type": "subtitle", "time": 4944.629, "timestamp": "01:22:24", "text": "そしてそれはイベントのようなもので、"}, {"type": "subtitle", "time": 4946.55, "timestamp": "01:22:26", "text": "一緒に過ごすか、実際の"}, {"type": "subtitle", "time": 4948.47, "timestamp": "01:22:28", "text": "クリスマスなどの特別なイベント、あるいは"}, {"type": "subtitle", "time": 4950.31, "timestamp": "01:22:30", "text": "新年みたいに。それらは唯一の"}, {"type": "subtitle", "time": 4951.669, "timestamp": "01:22:31", "text": "私が飲む時。私はあまり"}, {"type": "subtitle", "time": 4954.95, "timestamp": "01:22:34", "text": "一人で飲むか、"}, {"type": "subtitle", "time": 4957.51, "timestamp": "01:22:37", "text": "飲み物が欲しい。私はそうは思わない"}, {"type": "subtitle", "time": 4960.79, "timestamp": "01:22:40", "text": "健康的だけど、いいとは思わない。"}, {"type": "subtitle", "time": 4964.39, "timestamp": "01:22:44", "text": "私はまだあのクソみたいな感覚が大嫌いです"}, {"type": "subtitle", "time": 4966.79, "timestamp": "01:22:46", "text": "二日酔いのような感じ。私はそれが大嫌いです。"}, {"type": "subtitle", "time": 4969.35, "timestamp": "01:22:49", "text": "右。"}, {"type": "subtitle", "time": 4971.03, "timestamp": "01:22:51", "text": "うん。ジャッキー、あなたは？いくら"}, {"type": "subtitle", "time": 4973.43, "timestamp": "01:22:53", "text": "あなたは何を飲みますか？あなたはどう思いますか"}, {"type": "subtitle", "time": 4975.189, "timestamp": "01:22:55", "text": "軽量級、中量級、"}, {"type": "subtitle", "time": 4976.79, "timestamp": "01:22:56", "text": "ヘビー級？"}, {"type": "subtitle", "time": 4979.11, "timestamp": "01:22:59", "text": "私は超軽量級です。えっと、"}]
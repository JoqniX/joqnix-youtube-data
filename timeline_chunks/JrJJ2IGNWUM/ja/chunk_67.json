[{"type": "subtitle", "time": 4020.63, "timestamp": "01:07:00", "text": "パンのカビの生えた部分を剥がす"}, {"type": "subtitle", "time": 4025.67, "timestamp": "01:07:05", "text": "そしてそれを食べる？うん、"}, {"type": "subtitle", "time": 4028.069, "timestamp": "01:07:08", "text": "男。わかった。だから、私は人々にそうさせるんです。"}, {"type": "subtitle", "time": 4030.23, "timestamp": "01:07:10", "text": "でも、私はそういうことをするタイプじゃないんです。一度"}, {"type": "subtitle", "time": 4032.589, "timestamp": "01:07:12", "text": "カビを見たら、触らないよ。"}, {"type": "subtitle", "time": 4035.91, "timestamp": "01:07:15", "text": "それ。胞子があります。私は好きではありません"}, {"type": "subtitle", "time": 4037.67, "timestamp": "01:07:17", "text": "それ。"}, {"type": "subtitle", "time": 4039.829, "timestamp": "01:07:19", "text": "微細な胞子があります。私はもう食べています"}, {"type": "subtitle", "time": 4041.829, "timestamp": "01:07:21", "text": "マイクロプラスチック。これ以上マイクロは必要ない"}, {"type": "subtitle", "time": 4044.47, "timestamp": "01:07:24", "text": "体内に[ __ ]便。見てみると"}, {"type": "subtitle", "time": 4046.87, "timestamp": "01:07:26", "text": "しかし、それは機能します。私はかなり"}, {"type": "subtitle", "time": 4048.309, "timestamp": "01:07:28", "text": "確かにまだ機能するよ、だって君は"}, {"type": "subtitle", "time": 4049.829, "timestamp": "01:07:29", "text": "外すと気分が悪くなるよね、そしてただ"}, {"type": "subtitle", "time": 4051.95, "timestamp": "01:07:31", "text": "パンは普通に食べてください。"}, {"type": "subtitle", "time": 4053.75, "timestamp": "01:07:33", "text": "うん。"}, {"type": "subtitle", "time": 4055.309, "timestamp": "01:07:35", "text": "しかし"}, {"type": "subtitle", "time": 4057.99, "timestamp": "01:07:37", "text": "うん。パット、それって本当に効果があるの？もし"}, {"type": "subtitle", "time": 4059.589, "timestamp": "01:07:39", "text": "私のパンの賞味期限は"}, {"type": "subtitle", "time": 4061.27, "timestamp": "01:07:41", "text": "近づいてきたら、パンをトーストして"}, {"type": "subtitle", "time": 4063.51, "timestamp": "01:07:43", "text": "それらを食べなさい。それは実際の生活のようなものですか"}, {"type": "subtitle", "time": 4065.27, "timestamp": "01:07:45", "text": "私が全く知らなかったハッキン​​グ？"}, {"type": "subtitle", "time": 4067.75, "timestamp": "01:07:47", "text": "うん、それでいいよ。それはやったよ。うん。"}, {"type": "subtitle", "time": 4070.15, "timestamp": "01:07:50", "text": "ああ、くそ。あなたはそれをやったのですか？うん。くそ。私"}, {"type": "subtitle", "time": 4071.589, "timestamp": "01:07:51", "text": "もっとそうしないといけない"}, {"type": "subtitle", "time": 4075.27, "timestamp": "01:07:55", "text": "頻繁。パンを食べて。"}, {"type": "subtitle", "time": 4077.109, "timestamp": "01:07:57", "text": "そういうことってある？ いや、私はあまりない"}, {"type": "subtitle", "time": 4078.63, "timestamp": "01:07:58", "text": "それでもパンを食べる"}, {"type": "subtitle", "time": 4079.829, "timestamp": "01:07:59", "text": "賞味期限が少し過ぎているのは"}]
[{"type": "subtitle", "time": 3842.71, "timestamp": "01:04:02", "text": "どこで買えるのか分かりません。最後"}, {"type": "subtitle", "time": 3845.91, "timestamp": "01:04:05", "text": "私がそれを買った場所は、えっと"}, {"type": "subtitle", "time": 3847.51, "timestamp": "01:04:07", "text": "私がワイフを拾っていたとき、彼女は"}, {"type": "subtitle", "time": 3850.87, "timestamp": "01:04:10", "text": "以前はシティサイドに住んでいました"}, {"type": "subtitle", "time": 3854.069, "timestamp": "01:04:14", "text": "本当に奇妙な外観の店。本当に"}, {"type": "subtitle", "time": 3858.109, "timestamp": "01:04:18", "text": "変な見た目、えっと、何ですか"}, {"type": "subtitle", "time": 3861.27, "timestamp": "01:04:21", "text": "電話した？ Siストア。姉さん、何のことかわからない"}, {"type": "subtitle", "time": 3863.91, "timestamp": "01:04:23", "text": "この店は英語のみで営業しています。えっと、ちょっと待ってください。私にさせて"}, {"type": "subtitle", "time": 3865.589, "timestamp": "01:04:25", "text": "では、私がそれを翻訳してみましょう。サウジ"}, {"type": "subtitle", "time": 3868.829, "timestamp": "01:04:28", "text": "悲しい店（英語）まるで"}, {"type": "subtitle", "time": 3873.99, "timestamp": "01:04:33", "text": "近所の田舎の雑貨店"}, {"type": "subtitle", "time": 3876.39, "timestamp": "01:04:36", "text": "またはコンビニエンスストア。でもあなたが"}, {"type": "subtitle", "time": 3877.51, "timestamp": "01:04:37", "text": "コンビニエンスストアを思い浮かべると、"}, {"type": "subtitle", "time": 3879.829, "timestamp": "01:04:39", "text": "お母さんのことを考えて"}, {"type": "subtitle", "time": 3883.27, "timestamp": "01:04:43", "text": "ポパンは、小型の食料品店タイプのスーパーマーケットです。"}, {"type": "subtitle", "time": 3884.71, "timestamp": "01:04:44", "text": "それは食料品店の商品ですらない。その"}, {"type": "subtitle", "time": 3887.19, "timestamp": "01:04:47", "text": "小さな開口部"}, {"type": "subtitle", "time": 3889.109, "timestamp": "01:04:49", "text": "中には、あなたが想像もできないようなものが入っている"}, {"type": "subtitle", "time": 3890.39, "timestamp": "01:04:50", "text": "入り込む。彼らに頼むだけで"}, {"type": "subtitle", "time": 3891.829, "timestamp": "01:04:51", "text": "何か、そして彼らはただそれをあなたにあげる"}, {"type": "subtitle", "time": 3894.15, "timestamp": "01:04:54", "text": "そして、あなたは支払う。もっと買っておけばよかった"}, {"type": "subtitle", "time": 3895.71, "timestamp": "01:04:55", "text": "1つよりも多かった。"}, {"type": "subtitle", "time": 3898.95, "timestamp": "01:04:58", "text": "なあ、実はね。私はそれが好きかもしれない、"}]
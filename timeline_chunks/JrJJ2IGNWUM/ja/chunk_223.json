[{"type": "subtitle", "time": 13393.67, "timestamp": "03:43:13", "text": "死ぬ。ニース。彼の敵の"}, {"type": "subtitle", "time": 13399.429, "timestamp": "03:43:19", "text": "再装填中。"}, {"type": "subtitle", "time": 13405.59, "timestamp": "03:43:25", "text": "彼らはそこから立ち直れないだろう。"}, {"type": "subtitle", "time": 13414.55, "timestamp": "03:43:34", "text": "脱落。どこですか？ちょっと待ってください。"}, {"type": "subtitle", "time": 13416.389, "timestamp": "03:43:36", "text": "修理中。どこですか？そしてあなたの次の"}, {"type": "subtitle", "time": 13419.51, "timestamp": "03:43:39", "text": "チャンピオンはここにいる。あなたは"}]
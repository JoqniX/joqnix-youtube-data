[{"type": "subtitle", "time": 1142.549, "timestamp": "00:19:02", "text": "ふざけたり、くだらないことをしたりする。ただ話しているだけです"}, {"type": "subtitle", "time": 1145.99, "timestamp": "00:19:05", "text": "人生やあらゆることについて。"}, {"type": "subtitle", "time": 1147.59, "timestamp": "00:19:07", "text": "人生で他に何か"}, {"type": "subtitle", "time": 1152.2, "timestamp": "00:19:12", "text": "めちゃくちゃ重いってこと？"}, {"type": "subtitle", "time": 1154.95, "timestamp": "00:19:14", "text": "[音楽]"}, {"type": "subtitle", "time": 1156.19, "timestamp": "00:19:16", "text": "重い？"}, {"type": "subtitle", "time": 1160.47, "timestamp": "00:19:20", "text": "いいえ。重いというのは、ええと、扱いきれないほど重いという意味です。"}, {"type": "subtitle", "time": 1164.87, "timestamp": "00:19:24", "text": "そう、そうだね。"}, {"type": "subtitle", "time": 1166.95, "timestamp": "00:19:26", "text": "えっと、なんであんな説明をしたんだろう？なぜ"}, {"type": "subtitle", "time": 1169.19, "timestamp": "00:19:29", "text": "私自身に何か問題があるのだろうか？なぜ私は"}, {"type": "subtitle", "time": 1172.95, "timestamp": "00:19:32", "text": "文を複雑にしすぎている？"}, {"type": "subtitle", "time": 1177.35, "timestamp": "00:19:37", "text": "うん。ええと、少なくともh"}, {"type": "subtitle", "time": 1181.19, "timestamp": "00:19:41", "text": "人生で重いのは、"}, {"type": "subtitle", "time": 1183.43, "timestamp": "00:19:43", "text": "現実世界のことですよね？そしてあなたの"}, {"type": "subtitle", "time": 1185.669, "timestamp": "00:19:45", "text": "情熱的な趣味やその他"}, {"type": "subtitle", "time": 1188.87, "timestamp": "00:19:48", "text": "自分のやりたいことをする時間を作る。"}, {"type": "subtitle", "time": 1191.43, "timestamp": "00:19:51", "text": "私はあなたが望むものを感じます。うん。"}, {"type": "subtitle", "time": 1195.029, "timestamp": "00:19:55", "text": "私がやりたいこと、そして時には"}, {"type": "subtitle", "time": 1198.39, "timestamp": "00:19:58", "text": "物事が手の届かないところにあるように感じる"}]
[{"type": "subtitle", "time": 2461.309, "timestamp": "00:41:01", "text": "しかし"}, {"type": "subtitle", "time": 2463.67, "timestamp": "00:41:03", "text": "ええ、他に何かありますか？私たちは他に何だったのか"}, {"type": "subtitle", "time": 2465.67, "timestamp": "00:41:05", "text": "何について話しているのですか？ごめん、私は"}, {"type": "subtitle", "time": 2467.95, "timestamp": "00:41:07", "text": "ちょっと話が逸れちゃったけど、そういうことね"}, {"type": "subtitle", "time": 2470.95, "timestamp": "00:41:10", "text": "また。すみません、話が脱線してしまいました。"}, {"type": "subtitle", "time": 2474.069, "timestamp": "00:41:14", "text": "以前よりも頻繁に。のように"}, {"type": "subtitle", "time": 2475.589, "timestamp": "00:41:15", "text": "それはよくあることだ"}, {"type": "subtitle", "time": 2478.87, "timestamp": "00:41:18", "text": "最近では。私はただ"}, {"type": "subtitle", "time": 2481.43, "timestamp": "00:41:21", "text": "だって、私の記憶力も落ちてきたことに気づいたから"}, {"type": "subtitle", "time": 2483.19, "timestamp": "00:41:23", "text": "うんこをする。それがただの"}, {"type": "subtitle", "time": 2485.51, "timestamp": "00:41:25", "text": "普通のことのように、でも私は"}, {"type": "subtitle", "time": 2487.67, "timestamp": "00:41:27", "text": "実際、"}, {"type": "subtitle", "time": 2490.309, "timestamp": "00:41:30", "text": "記憶喪失のエピソード。超ランダム"}, {"type": "subtitle", "time": 2492.39, "timestamp": "00:41:32", "text": "記憶喪失。"}, {"type": "subtitle", "time": 2493.91, "timestamp": "00:41:33", "text": "ある人たちはこう言うかもしれない。「ああ"}, {"type": "subtitle", "time": 2495.589, "timestamp": "00:41:35", "text": "いや、君はただ単に物忘れがひどいだけだよ。」"}, {"type": "subtitle", "time": 2498.79, "timestamp": "00:41:38", "text": "「何だったか覚えてない」"}, {"type": "subtitle", "time": 2502.47, "timestamp": "00:41:42", "text": "今朝はそうしたよ。だって、"}, {"type": "subtitle", "time": 2503.99, "timestamp": "00:41:43", "text": "ああ、しまった、実際何だったか覚えてない"}, {"type": "subtitle", "time": 2510.069, "timestamp": "00:41:50", "text": "朝。それはまるで"}, {"type": "subtitle", "time": 2512.309, "timestamp": "00:41:52", "text": "悪い。でもそれが本当かどうかはわからない"}, {"type": "subtitle", "time": 2514.71, "timestamp": "00:41:54", "text": "私が対処しなければならない問題。たぶん私は"}, {"type": "subtitle", "time": 2516.43, "timestamp": "00:41:56", "text": "正直言って、一度診てもらった方がいいよ。しかし"}, {"type": "subtitle", "time": 2518.63, "timestamp": "00:41:58", "text": "私はそれを自分の"}]
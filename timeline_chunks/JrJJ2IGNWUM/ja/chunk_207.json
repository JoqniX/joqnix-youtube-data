[{"type": "subtitle", "time": 12423.67, "timestamp": "03:27:03", "text": "あなた。敵はここにいる。"}, {"type": "subtitle", "time": 12425.67, "timestamp": "03:27:05", "text": "敵はここにいる。近日公開。近日公開。近日公開。"}, {"type": "subtitle", "time": 12432.79, "timestamp": "03:27:12", "text": "時間がかかりすぎている。ちょうど今。わかった、"}, {"type": "subtitle", "time": 12445.99, "timestamp": "03:27:25", "text": "彼らは私を見つけた。私はショットを飲んでいます。"}, {"type": "subtitle", "time": 12449.11, "timestamp": "03:27:29", "text": "敵のシールドが破壊された。再装填中。なんてこった。"}, {"type": "subtitle", "time": 12452.63, "timestamp": "03:27:32", "text": "よーい、ドン！直面する"}, {"type": "subtitle", "time": 12455.389, "timestamp": "03:27:35", "text": "右。私は変わった"}, {"type": "subtitle", "time": 12460.75, "timestamp": "03:27:40", "text": "それで"}, {"type": "subtitle", "time": 12464.389, "timestamp": "03:27:44", "text": "今は大変だ。"}, {"type": "subtitle", "time": 12466.75, "timestamp": "03:27:46", "text": "私は使用しています"}, {"type": "subtitle", "time": 12470.03, "timestamp": "03:27:50", "text": "私より低い"}]
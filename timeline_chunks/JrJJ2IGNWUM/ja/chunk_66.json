[{"type": "subtitle", "time": 3962.23, "timestamp": "01:06:02", "text": "冷蔵庫の中身は全部使いますか？つまり、私の"}, {"type": "subtitle", "time": 3965.99, "timestamp": "01:06:05", "text": "両親はそれをしばらく保管していて、私は"}, {"type": "subtitle", "time": 3968.39, "timestamp": "01:06:08", "text": "以前、賞味期限切れのマスタードのようなものを食べたことがあるの？"}, {"type": "subtitle", "time": 3971.51, "timestamp": "01:06:11", "text": "そうそう。そうそう。一度。"}, {"type": "subtitle", "time": 3973.99, "timestamp": "01:06:13", "text": "同じ。マスタードを食べたことがある"}, {"type": "subtitle", "time": 3976.15, "timestamp": "01:06:16", "text": "3歳くらいで、"}, {"type": "subtitle", "time": 3977.75, "timestamp": "01:06:17", "text": "賞味期限が過ぎていたが、まだ美味しかった。"}, {"type": "subtitle", "time": 3979.91, "timestamp": "01:06:19", "text": "大丈夫。"}, {"type": "subtitle", "time": 3981.99, "timestamp": "01:06:21", "text": "私は、これについては特に問題はないと思った。"}, {"type": "subtitle", "time": 3983.51, "timestamp": "01:06:23", "text": "これは私が"}, {"type": "subtitle", "time": 3985.589, "timestamp": "01:06:25", "text": "年下だった。まあ、私はまだ若かったから。"}, {"type": "subtitle", "time": 3987.67, "timestamp": "01:06:27", "text": "当時、でも3年後だった"}, {"type": "subtitle", "time": 3989.51, "timestamp": "01:06:29", "text": "日付。そして私はこう思った、味は"}, {"type": "subtitle", "time": 3992.95, "timestamp": "01:06:32", "text": "私にとってはマスタードだ。全部使います。"}, {"type": "subtitle", "time": 3994.87, "timestamp": "01:06:34", "text": "なんていうか、私は何も悪いとは思わなかった"}, {"type": "subtitle", "time": 3998.15, "timestamp": "01:06:38", "text": "それ。いや、いや、いや、いや。すべて順調だった。"}, {"type": "subtitle", "time": 4000.47, "timestamp": "01:06:40", "text": "私は病気にもならなかった。"}, {"type": "subtitle", "time": 4005.349, "timestamp": "01:06:45", "text": "あなたはどうですか？それ以外にも、"}, {"type": "chat", "time": 4006.357, "timestamp": "01:06:46", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "eloo joqqqqqqyyyyyy"}, {"type": "subtitle", "time": 4008.39, "timestamp": "01:06:48", "text": "他にどんな期限切れの食品を食べましたか？"}, {"type": "subtitle", "time": 4011.71, "timestamp": "01:06:51", "text": "賞味期限切れ"}, {"type": "subtitle", "time": 4015.43, "timestamp": "01:06:55", "text": "えっと、パンのやつ。"}, {"type": "subtitle", "time": 4017.91, "timestamp": "01:06:57", "text": "待って、あなたはこんな風に食べるタイプですか？"}]
[{"type": "subtitle", "time": 6961.589, "timestamp": "01:56:01", "text": "ええ、当時はそんなゲームはやっていませんでしたよ。"}, {"type": "subtitle", "time": 6964.95, "timestamp": "01:56:04", "text": "うん、すごく楽しかったよ。楽しかったです。"}, {"type": "subtitle", "time": 6967.669, "timestamp": "01:56:07", "text": "うん。今後、"}, {"type": "subtitle", "time": 6969.83, "timestamp": "01:56:09", "text": "将来、私がいる間に、ああ、そうだ。おい、ただ"}, {"type": "subtitle", "time": 6973.03, "timestamp": "01:56:13", "text": "聞いてみろよ、兄弟。はい。はい。はい。正直に言うと、私は"}, {"type": "subtitle", "time": 6974.39, "timestamp": "01:56:14", "text": "もっと多くの人に聞いてみるべきだろう。"}, {"type": "subtitle", "time": 6975.51, "timestamp": "01:56:15", "text": "つまり、こういうことですよね？私は"}, {"type": "subtitle", "time": 6977.35, "timestamp": "01:56:17", "text": "今は誰に対しても受動的すぎる。そうするべきです。"}, {"type": "subtitle", "time": 6978.55, "timestamp": "01:56:18", "text": "おそらくもっと活動的になり、"}, {"type": "subtitle", "time": 6980.87, "timestamp": "01:56:20", "text": "人に聞いてみればいい。楽しそうだね。私"}, {"type": "subtitle", "time": 6982.229, "timestamp": "01:56:22", "text": "その後はもっとそうするべきだ。さて、あなたは"}, {"type": "subtitle", "time": 6985.03, "timestamp": "01:56:25", "text": "質問するのはオカだと思いますか？例えば、もし彼らが"}, {"type": "subtitle", "time": 6987.43, "timestamp": "01:56:27", "text": "もし彼らが断ったらどうなる？それならばそうあれ"}, {"type": "subtitle", "time": 6989.109, "timestamp": "01:56:29", "text": "それ。"}, {"type": "subtitle", "time": 6990.55, "timestamp": "01:56:30", "text": "もし彼らが断るなら、それはそれで仕方がない。それは"}, {"type": "subtitle", "time": 6992.79, "timestamp": "01:56:32", "text": "私としては構いません。正直言って、もし彼らがそうしないなら"}, {"type": "subtitle", "time": 6994.709, "timestamp": "01:56:34", "text": "私のコンテンツが好きで、公平に言うと、それは"}, {"type": "subtitle", "time": 6997.75, "timestamp": "01:56:37", "text": "わかった。私は諦め始めました"}, {"type": "subtitle", "time": 7000.39, "timestamp": "01:56:40", "text": "もしかしたら自分が迷惑をかけているのかもしれないという考え。私"}, {"type": "subtitle", "time": 7002.39, "timestamp": "01:56:42", "text": "私は既に迷惑な存在だ。私はそれを受け入れた"}, {"type": "subtitle", "time": 7009.669, "timestamp": "01:56:49", "text": "ああ、ありがとう、ジョッキー。良い会話でした"}, {"type": "subtitle", "time": 7011.35, "timestamp": "01:56:51", "text": "また会おうぜ、相棒。大好きです。まさにそれだった"}, {"type": "subtitle", "time": 7014.27, "timestamp": "01:56:54", "text": "とても楽しかった。こんにちは。ええ、そうですね。楽しむ"}, {"type": "subtitle", "time": 7017.27, "timestamp": "01:56:57", "text": "それでは皆さん、失礼します。こんにちは。"}]
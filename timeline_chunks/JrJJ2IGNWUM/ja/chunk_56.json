[{"type": "subtitle", "time": 3361.27, "timestamp": "00:56:01", "text": "それなら、飲もう。問題ありません。えっと、でも"}, {"type": "subtitle", "time": 3363.91, "timestamp": "00:56:03", "text": "そう、あのサンドイッチクッキーだけど"}, {"type": "subtitle", "time": 3365.27, "timestamp": "00:56:05", "text": "中央にある果物のようなもの。はい。はい、"}, {"type": "subtitle", "time": 3368.15, "timestamp": "00:56:08", "text": "パット。はい、タッド。ヤッピー。うん。うん。うん。"}, {"type": "subtitle", "time": 3369.27, "timestamp": "00:56:09", "text": "とても素敵ですね。私は真ん中を離れる"}, {"type": "subtitle", "time": 3370.95, "timestamp": "00:56:10", "text": "最後の部分のための部分。いいえ、私はただ食べるだけです"}, {"type": "subtitle", "time": 3373.589, "timestamp": "00:56:13", "text": "それ。半分だけかじって、残りの半分は"}, {"type": "subtitle", "time": 3375.51, "timestamp": "00:56:15", "text": "半分は何でもいい。私の"}, {"type": "subtitle", "time": 3379.349, "timestamp": "00:56:19", "text": "歯が少しだけなら、私の問題ではない。"}, {"type": "subtitle", "time": 3381.47, "timestamp": "00:56:21", "text": "まあ、何の話をしていたんだっけ？"}, {"type": "subtitle", "time": 3384.789, "timestamp": "00:56:24", "text": "ごめん。もう一度よく考えるべきだった。赤"}, {"type": "subtitle", "time": 3386.95, "timestamp": "00:56:26", "text": "チュット。おお。あ、待って。いや、いや、いや。ない"}, {"type": "subtitle", "time": 3390.069, "timestamp": "00:56:30", "text": "ジュベリー。ああ、お茶ですね。うん、でも"}, {"type": "subtitle", "time": 3392.309, "timestamp": "00:56:32", "text": "うん。私は普段お茶を飲むだけです"}, {"type": "subtitle", "time": 3394.87, "timestamp": "00:56:34", "text": "健康でいたいし、もしオファーがあれば"}, {"type": "subtitle", "time": 3397.99, "timestamp": "00:56:37", "text": "私はそれを飲んで楽しむだけですが、"}, {"type": "subtitle", "time": 3400.15, "timestamp": "00:56:40", "text": "私はそういうものを探すタイプではないんです。しかし"}, {"type": "subtitle", "time": 3402.15, "timestamp": "00:56:42", "text": "そうだよ、だって私が行った時はいつも"}, {"type": "subtitle", "time": 3404.549, "timestamp": "00:56:44", "text": "お茶を勧められたのは、"}, {"type": "subtitle", "time": 3408.63, "timestamp": "00:56:48", "text": "少し憂鬱そう、あるいは実際"}, {"type": "subtitle", "time": 3410.63, "timestamp": "00:56:50", "text": "少し気分が悪くなり始めて"}, {"type": "subtitle", "time": 3412.309, "timestamp": "00:56:52", "text": "ひどいですよね？その症状はご存知ですよね"}, {"type": "subtitle", "time": 3413.51, "timestamp": "00:56:53", "text": "自分がどこにいるか分かっている"}, {"type": "subtitle", "time": 3417.03, "timestamp": "00:56:57", "text": "熱が出て具合が悪いみたい？うん。"}, {"type": "subtitle", "time": 3419.27, "timestamp": "00:56:59", "text": "うん。人々がそれを提供するのと同じように"}]
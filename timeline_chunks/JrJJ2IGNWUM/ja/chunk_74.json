[{"type": "subtitle", "time": 4440.39, "timestamp": "01:14:00", "text": "でも、私はまだそのレベルには達していません。参加します"}, {"type": "subtitle", "time": 4443.99, "timestamp": "01:14:03", "text": "それとトゥインキーの間だから、私は"}, {"type": "subtitle", "time": 4445.83, "timestamp": "01:14:05", "text": "真ん中。私は何も実行できません"}, {"type": "subtitle", "time": 4448.51, "timestamp": "01:14:08", "text": "もし私が"}, {"type": "subtitle", "time": 4450.99, "timestamp": "01:14:10", "text": "真ん中。うん、"}, {"type": "subtitle", "time": 4453.03, "timestamp": "01:14:13", "text": "ジャック、君はどう思う？あなたは"}, {"type": "subtitle", "time": 4455.03, "timestamp": "01:14:15", "text": "インドでゴス系の人が増えていることに気づいた、あるいは"}, {"type": "subtitle", "time": 4459.11, "timestamp": "01:14:19", "text": "それは単なる物のようなものですか？"}, {"type": "subtitle", "time": 4462.39, "timestamp": "01:14:22", "text": "実はあまり見ていないんです。"}, {"type": "subtitle", "time": 4465.35, "timestamp": "01:14:25", "text": "たぶん、今は外出しないからかな。"}, {"type": "subtitle", "time": 4467.31, "timestamp": "01:14:27", "text": "久しぶりですね。"}, {"type": "subtitle", "time": 4471.35, "timestamp": "01:14:31", "text": "ああ、だって私は今歩き出すのが大好きだから、"}, {"type": "subtitle", "time": 4473.43, "timestamp": "01:14:33", "text": "皆さんへのちょっとしたアドバイスです。とても役に立った"}, {"type": "subtitle", "time": 4474.87, "timestamp": "01:14:34", "text": "道。人生のアドバイスが欲しいなら、"}, {"type": "subtitle", "time": 4478.95, "timestamp": "01:14:38", "text": "人生のアドバイスをもらった。だから、もしあなたが信じられないほど"}, {"type": "subtitle", "time": 4482.149, "timestamp": "01:14:42", "text": "疲れていて、仕事をする気分ではない。"}, {"type": "subtitle", "time": 4484.63, "timestamp": "01:14:44", "text": "外に出て散歩しよう。持参しないでください"}, {"type": "subtitle", "time": 4487.709, "timestamp": "01:14:47", "text": "電話。外に出て、"}, {"type": "subtitle", "time": 4489.75, "timestamp": "01:14:49", "text": "行き先。例えば、たとえ"}, {"type": "subtitle", "time": 4491.59, "timestamp": "01:14:51", "text": "ほんの少し歩くだけで20分くらい"}, {"type": "subtitle", "time": 4494.149, "timestamp": "01:14:54", "text": "15分、15分なら大丈夫です。ただ"}, {"type": "subtitle", "time": 4496.07, "timestamp": "01:14:56", "text": "外に出て、頭をすっきりさせて、"}, {"type": "subtitle", "time": 4497.669, "timestamp": "01:14:57", "text": "戻ると、少し"}, {"type": "subtitle", "time": 4499.669, "timestamp": "01:14:59", "text": "リフレッシュした。それはズルだ。それは人生だ"}]
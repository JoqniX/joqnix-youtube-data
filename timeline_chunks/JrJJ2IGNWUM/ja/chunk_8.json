[{"type": "subtitle", "time": 482.23, "timestamp": "00:08:02", "text": "近くの言語と調査済み"}, {"type": "subtitle", "time": 485.35, "timestamp": "00:08:05", "text": "彼ら全員。私は一人で行き、"}, {"type": "subtitle", "time": 487.909, "timestamp": "00:08:07", "text": "いとこの兄と一緒の時は"}, {"type": "subtitle", "time": 491.51, "timestamp": "00:08:11", "text": "そこには。そう、それで私はそれらを"}, {"type": "subtitle", "time": 494.71, "timestamp": "00:08:14", "text": "家族は、それで大丈夫だと思った。"}, {"type": "subtitle", "time": 497.589, "timestamp": "00:08:17", "text": "叔父と一緒に来た"}, {"type": "subtitle", "time": 500.79, "timestamp": "00:08:20", "text": "良い。叔父もそこにいて、みんな"}, {"type": "subtitle", "time": 502.869, "timestamp": "00:08:22", "text": "話し合ったり、調べたり、その他すべて"}, {"type": "subtitle", "time": 504.23, "timestamp": "00:08:24", "text": "学校から来た彼らはこう言った"}, {"type": "subtitle", "time": 507.11, "timestamp": "00:08:27", "text": "勉強させてくれるなど、何でもしてくれる。"}, {"type": "subtitle", "time": 509.189, "timestamp": "00:08:29", "text": "そこで彼らはアカデミーの人たちに提案した"}, {"type": "subtitle", "time": 512.55, "timestamp": "00:08:32", "text": "インドから1レベル学ぶことを提案された"}, {"type": "subtitle", "time": 515.829, "timestamp": "00:08:35", "text": "それから日本へ行き、そこから"}, {"type": "subtitle", "time": 517.509, "timestamp": "00:08:37", "text": "環境は誰もが"}, {"type": "subtitle", "time": 519.11, "timestamp": "00:08:39", "text": "日本語を正しく話せるので、"}, {"type": "subtitle", "time": 520.63, "timestamp": "00:08:40", "text": "最終的には拾うよ、君は"}, {"type": "subtitle", "time": 523.029, "timestamp": "00:08:43", "text": "そう、強制されてそうして、"}, {"type": "subtitle", "time": 524.63, "timestamp": "00:08:44", "text": "環境に適応することを強いられる"}, {"type": "subtitle", "time": 527.99, "timestamp": "00:08:47", "text": "どんなアクセントになるかはわかりません"}, {"type": "subtitle", "time": 529.67, "timestamp": "00:08:49", "text": "だって彼らはいつもアクセントを真似したがるから"}, {"type": "subtitle", "time": 531.269, "timestamp": "00:08:51", "text": "あなたが話す人々のうち、"}, {"type": "subtitle", "time": 533.19, "timestamp": "00:08:53", "text": "それはとてもよくあることです"}, {"type": "subtitle", "time": 535.269, "timestamp": "00:08:55", "text": "私に起こったこと、そしてなぜ人々がそう思うのか"}, {"type": "subtitle", "time": 536.949, "timestamp": "00:08:56", "text": "私はいつもアメリカ英語を話すので、アメリカ人のように聞こえます"}, {"type": "subtitle", "time": 539.19, "timestamp": "00:08:59", "text": "私が"}]
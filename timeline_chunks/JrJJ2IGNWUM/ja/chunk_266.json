[{"type": "subtitle", "time": 15963.11, "timestamp": "04:26:03", "text": "Mゲームプレイ、みんな。"}, {"type": "subtitle", "time": 15964.79, "timestamp": "04:26:04", "text": "うん。"}, {"type": "subtitle", "time": 15968.95, "timestamp": "04:26:08", "text": "お招きいただきありがとうございます。はい、そうでした。"}, {"type": "subtitle", "time": 15972.389, "timestamp": "04:26:12", "text": "本当に楽しかった。私たちはたくさん話しましたし、"}, {"type": "subtitle", "time": 15975.59, "timestamp": "04:26:15", "text": "プレイして、ピューピュー撃って、グループキルを達成した"}, {"type": "subtitle", "time": 15978.71, "timestamp": "04:26:18", "text": "そして全て。遊ぶのは楽しかった"}, {"type": "subtitle", "time": 15980.99, "timestamp": "04:26:20", "text": "また。私はほとんど触っていません"}, {"type": "subtitle", "time": 15984.309, "timestamp": "04:26:24", "text": "ゲーム。楽しかった。 D、私たちは"}, {"type": "subtitle", "time": 15988.66, "timestamp": "04:26:28", "text": "それをプレイするために。ありがとう、Dさん。"}, {"type": "subtitle", "time": 15990.269, "timestamp": "04:26:30", "text": "[音楽]"}, {"type": "subtitle", "time": 15993.269, "timestamp": "04:26:33", "text": "わーい。では、もっとプレイしますか、それとも"}, {"type": "subtitle", "time": 15997.99, "timestamp": "04:26:37", "text": "もう寝るの？"}, {"type": "subtitle", "time": 16008.229, "timestamp": "04:26:48", "text": "もっと。私は去るだろう"}, {"type": "subtitle", "time": 16016.07, "timestamp": "04:26:56", "text": "ええ、私も睡眠をとりました。そうですね、ありがとうございます"}, {"type": "subtitle", "time": 16018.389, "timestamp": "04:26:58", "text": "今日はあなたへ。本当に、本当に、"}]
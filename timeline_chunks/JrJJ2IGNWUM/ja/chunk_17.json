[{"type": "subtitle", "time": 1020.31, "timestamp": "00:17:00", "text": "もう後戻りできないほど深く入り込んでしまったね。"}, {"type": "subtitle", "time": 1021.55, "timestamp": "00:17:01", "text": "うん。その"}, {"type": "subtitle", "time": 1023.829, "timestamp": "00:17:03", "text": "まるで私が作ろうとしていたように"}, {"type": "subtitle", "time": 1025.909, "timestamp": "00:17:05", "text": "クラックを使うことと似ているが、私は"}, {"type": "subtitle", "time": 1029.11, "timestamp": "00:17:09", "text": "それは当てはまると思う。"}, {"type": "subtitle", "time": 1031.59, "timestamp": "00:17:11", "text": "ああ、私の例えはひどい。でも、そうですね、"}, {"type": "subtitle", "time": 1033.189, "timestamp": "00:17:13", "text": "それは一種の中毒のようなもので、"}, {"type": "subtitle", "time": 1035.429, "timestamp": "00:17:15", "text": "あなたが既に慣れ親しんでいるもの。だからそれは"}, {"type": "subtitle", "time": 1038.029, "timestamp": "00:17:18", "text": "抜け出すのが難しい"}, {"type": "chat", "time": 1039.112, "timestamp": "00:17:19", "author": "@LeverBoi", "avatar": "https://yt4.ggpht.com/xNxuxXmHi1c7fysDq7xCqQFkIHS14-WZ-pDk_WA0vJh_7H6RdN1zGFsbYrCE6izTRTxqZPdBqA=s64-c-k-c0x00ffffff-no-rj", "message": "this convo is getting too real"}, {"type": "subtitle", "time": 1041.59, "timestamp": "00:17:21", "text": "えーと、あなたがやっていることの苦労"}, {"type": "subtitle", "time": 1044.549, "timestamp": "00:17:24", "text": "すでに自分の快適な領域にいるようなものだ。だから"}, {"type": "subtitle", "time": 1047.11, "timestamp": "00:17:27", "text": "まるで、あなたが"}, {"type": "subtitle", "time": 1049.029, "timestamp": "00:17:29", "text": "起き上がって実際に何か新しいことに挑戦してみよう。"}, {"type": "subtitle", "time": 1052.23, "timestamp": "00:17:32", "text": "あなたはいつもただ怯えて"}, {"type": "subtitle", "time": 1054.549, "timestamp": "00:17:34", "text": "遠く離れた場所を探検するのではなく、知ること"}, {"type": "subtitle", "time": 1057.909, "timestamp": "00:17:37", "text": "地平線みたいなやつ。そう、そうなる"}, {"type": "subtitle", "time": 1060.39, "timestamp": "00:17:40", "text": "スーパー"}, {"type": "subtitle", "time": 1062.23, "timestamp": "00:17:42", "text": "繰り返しのようにそれに固執して、"}, {"type": "subtitle", "time": 1064.63, "timestamp": "00:17:44", "text": "知る？はい。まるで楽しんでいるかのように。"}, {"type": "subtitle", "time": 1066.789, "timestamp": "00:17:46", "text": "まるで問題が分からないかのようだ"}, {"type": "subtitle", "time": 1068.87, "timestamp": "00:17:48", "text": "その時期にそれをやって、そしてそれはただ、"}, {"type": "subtitle", "time": 1071.029, "timestamp": "00:17:51", "text": "知っておくと、それはただ普通になり始める"}, {"type": "subtitle", "time": 1073.59, "timestamp": "00:17:53", "text": "あなたも他のものもすべて消え去り、"}, {"type": "subtitle", "time": 1076.47, "timestamp": "00:17:56", "text": "その間は特に何も起こらない"}, {"type": "subtitle", "time": 1079.669, "timestamp": "00:17:59", "text": "もうあなたにとって大切な存在ではなくなった。"}]
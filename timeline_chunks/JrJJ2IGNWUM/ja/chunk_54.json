[{"type": "subtitle", "time": 3242.069, "timestamp": "00:54:02", "text": "私の舌。それはただの苛立ちのようなものだ"}, {"type": "subtitle", "time": 3244.39, "timestamp": "00:54:04", "text": "喉に何かがある。まるで"}, {"type": "subtitle", "time": 3246.549, "timestamp": "00:54:06", "text": "喉に刺激反応が出ました"}, {"type": "subtitle", "time": 3248.15, "timestamp": "00:54:08", "text": "実際にスパイスを感じるよりも"}, {"type": "subtitle", "time": 3252.03, "timestamp": "00:54:12", "text": "舌。まるで"}, {"type": "subtitle", "time": 3254.15, "timestamp": "00:54:14", "text": "うん。普段は何を一緒に食べるのですか？"}, {"type": "subtitle", "time": 3258.71, "timestamp": "00:54:18", "text": "お茶はいかがですか？私はただお茶を飲むだけです。私は思う"}, {"type": "subtitle", "time": 3260.71, "timestamp": "00:54:20", "text": "私の体"}, {"type": "subtitle", "time": 3263.109, "timestamp": "00:54:23", "text": "えっと、家で紅茶を入れるときは、ブラックティーのように"}, {"type": "subtitle", "time": 3267.109, "timestamp": "00:54:27", "text": "家でお茶を飲む、えっと、夜はよく飲んでたんだけど、"}, {"type": "subtitle", "time": 3271.27, "timestamp": "00:54:31", "text": "膝の怪我の時は眠れなかった"}, {"type": "subtitle", "time": 3272.87, "timestamp": "00:54:32", "text": "それは何と呼ばれますか？何もなかった"}, {"type": "subtitle", "time": 3274.79, "timestamp": "00:54:34", "text": "家の中で。私は思った"}, {"type": "subtitle", "time": 3276.87, "timestamp": "00:54:36", "text": "紅茶を淹れて飲むよ"}, {"type": "subtitle", "time": 3279.91, "timestamp": "00:54:39", "text": "寝る。私はそれを1年間続けました。"}, {"type": "subtitle", "time": 3282.069, "timestamp": "00:54:42", "text": "何か。そして今、私はブラックを飲む"}, {"type": "subtitle", "time": 3285.109, "timestamp": "00:54:45", "text": "お茶を飲むと、眠くなって眠くなります。それはただ"}, {"type": "subtitle", "time": 3287.43, "timestamp": "00:54:47", "text": "あなたのお尻のようになる"}, {"type": "subtitle", "time": 3289.51, "timestamp": "00:54:49", "text": "あなたの体にアラームを鳴らす"}, {"type": "subtitle", "time": 3292.19, "timestamp": "00:54:52", "text": "寝て、これを飲んで、"}, {"type": "subtitle", "time": 3295.589, "timestamp": "00:54:55", "text": "寝る。おむつ用のバタークッキーですよね？"}, {"type": "subtitle", "time": 3298.309, "timestamp": "00:54:58", "text": "今。えっと、正直言うと、私はバタークッキーが好きです。"}, {"type": "subtitle", "time": 3299.91, "timestamp": "00:54:59", "text": "でも私は必ずしも一緒に食べるわけではありません"}]
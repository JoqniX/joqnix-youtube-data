[{"type": "subtitle", "time": 11161.11, "timestamp": "03:06:01", "text": "どうぞ。"}, {"type": "subtitle", "time": 11166.309, "timestamp": "03:06:06", "text": "アップデートオプションは表示されましたか？"}, {"type": "subtitle", "time": 11175.19, "timestamp": "03:06:15", "text": "ええ、私はゲームに参加しています。私は"}, {"type": "subtitle", "time": 11177.99, "timestamp": "03:06:17", "text": "ゲーム。"}, {"type": "subtitle", "time": 11180.469, "timestamp": "03:06:20", "text": "それで"}, {"type": "subtitle", "time": 11182.99, "timestamp": "03:06:22", "text": "私もあなたと同じように考えます"}, {"type": "subtitle", "time": 11188.71, "timestamp": "03:06:28", "text": "ゲームに参加できますが、"}, {"type": "subtitle", "time": 11190.87, "timestamp": "03:06:30", "text": "更新してください。"}, {"type": "subtitle", "time": 11193.67, "timestamp": "03:06:33", "text": "でも、再起動したばかりなのにどうやってアップデートすればいいの？"}, {"type": "subtitle", "time": 11201.75, "timestamp": "03:06:41", "text": "回。それは奇妙ですね。 1秒。"}, {"type": "subtitle", "time": 11205.55, "timestamp": "03:06:45", "text": "見たくないですか、見たくないですか"}, {"type": "subtitle", "time": 11209.11, "timestamp": "03:06:49", "text": "選択肢は？"}, {"type": "subtitle", "time": 11213.63, "timestamp": "03:06:53", "text": "いいえ。 Steamにはアップデートオプションがありません。"}, {"type": "subtitle", "time": 11215.63, "timestamp": "03:06:55", "text": "たぶんこんな感じ"}, {"type": "subtitle", "time": 11218.23, "timestamp": "03:06:58", "text": "チームを再起動する。"}]
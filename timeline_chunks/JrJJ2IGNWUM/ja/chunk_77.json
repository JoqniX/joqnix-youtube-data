[{"type": "subtitle", "time": 4620.31, "timestamp": "01:17:00", "text": "エニタイムフィットネスに行く人は、"}, {"type": "subtitle", "time": 4623.83, "timestamp": "01:17:03", "text": "年配の男性または年配の女性"}, {"type": "subtitle", "time": 4626.31, "timestamp": "01:17:06", "text": "機械の操作方法がわからない。"}, {"type": "subtitle", "time": 4628.79, "timestamp": "01:17:08", "text": "それは私の脳がこうなっているような感じだけど、私はそうする"}, {"type": "subtitle", "time": 4630.87, "timestamp": "01:17:10", "text": "多くの人が使っていることは知っています。私はかなり"}, {"type": "subtitle", "time": 4633.75, "timestamp": "01:17:13", "text": "確かに、ワイフはゲイの友達みたいなものだよ、それを使ってみて"}, {"type": "subtitle", "time": 4635.43, "timestamp": "01:17:15", "text": "たくさん。私は彼らの体を見たことがある。なんてこった、"}, {"type": "subtitle", "time": 4638.47, "timestamp": "01:17:18", "text": "彼らの体型は最高だ。うん。どれの"}, {"type": "subtitle", "time": 4640.39, "timestamp": "01:17:20", "text": "私は彼らの体型を本当に欲しいとは思っていません。その"}, {"type": "subtitle", "time": 4642.63, "timestamp": "01:17:22", "text": "まるで建てられたかのように。私は特に建ててほしくないんです。私"}, {"type": "subtitle", "time": 4646.63, "timestamp": "01:17:26", "text": "細身のような感じが欲しい、というのが適切な言葉だと思う。私"}, {"type": "subtitle", "time": 4649.35, "timestamp": "01:17:29", "text": "体を引き締めたい。でも、"}, {"type": "subtitle", "time": 4651.75, "timestamp": "01:17:31", "text": "筋肉の輪郭。あれだ"}, {"type": "subtitle", "time": 4654.63, "timestamp": "01:17:34", "text": "私は～を目指しています。引き締まった感じ。うん。本当に？"}, {"type": "subtitle", "time": 4656.07, "timestamp": "01:17:36", "text": "探せばジムはいくつか見つかるよ。"}, {"type": "subtitle", "time": 4658.47, "timestamp": "01:17:38", "text": "1セッションあたり約50フィリピンペソ稼げました。うん、"}, {"type": "subtitle", "time": 4660.229, "timestamp": "01:17:40", "text": "あれらはガレージにあるやつだ。その"}, {"type": "subtitle", "time": 4662.87, "timestamp": "01:17:42", "text": "ガレージジム。でも、私は普段は"}, {"type": "subtitle", "time": 4664.87, "timestamp": "01:17:44", "text": "MMAトレーニングで自宅トレーニングをしよう"}, {"type": "subtitle", "time": 4666.709, "timestamp": "01:17:46", "text": "ルーティーン。だから、私は通常"}, {"type": "subtitle", "time": 4669.59, "timestamp": "01:17:49", "text": "ただ行くのではなく今すぐやる、私は傾く"}, {"type": "subtitle", "time": 4672.55, "timestamp": "01:17:52", "text": "あの奇妙な紫色の飲み物。さあ、パット、君"}, {"type": "subtitle", "time": 4675.03, "timestamp": "01:17:55", "text": "ジョーイとはそのことについて話さないってことは分かってるよね。"}, {"type": "subtitle", "time": 4677.229, "timestamp": "01:17:57", "text": "違法なものを試したことはありますか？"}]
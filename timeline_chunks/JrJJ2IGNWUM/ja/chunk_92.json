[{"type": "subtitle", "time": 5521.189, "timestamp": "01:32:01", "text": "うん。うん。もっと読書ができたらいいのに。"}, {"type": "subtitle", "time": 5522.709, "timestamp": "01:32:02", "text": "ジャッキー、あなたはどうですか？何"}, {"type": "subtitle", "time": 5525.189, "timestamp": "01:32:05", "text": "後回しにしている計画はありますか？欲しい"}, {"type": "subtitle", "time": 5528.43, "timestamp": "01:32:08", "text": "それらのようなものを読む"}, {"type": "subtitle", "time": 5531.83, "timestamp": "01:32:11", "text": "ああ、今こそ私の番だと思う"}, {"type": "subtitle", "time": 5533.83, "timestamp": "01:32:13", "text": "人生やあらゆることについて学ぶため。それで"}, {"type": "subtitle", "time": 5536.27, "timestamp": "01:32:16", "text": "私はそういうのはあまり読まない"}, {"type": "subtitle", "time": 5539.27, "timestamp": "01:32:19", "text": "自己啓発本か何か"}, {"type": "subtitle", "time": 5541.31, "timestamp": "01:32:21", "text": "理解する"}, {"type": "subtitle", "time": 5544.79, "timestamp": "01:32:24", "text": "人々がどのように書くか、そして彼らの書き方をどう思うか"}, {"type": "subtitle", "time": 5547.35, "timestamp": "01:32:27", "text": "彼らの経験やその他諸々、"}, {"type": "subtitle", "time": 5548.91, "timestamp": "01:32:28", "text": "右？"}, {"type": "subtitle", "time": 5553.59, "timestamp": "01:32:33", "text": "ああ、いくつか見たことがあるけど、私は気にしないよ。"}, {"type": "subtitle", "time": 5555.59, "timestamp": "01:32:35", "text": "ライトノベルでも読んでる"}, {"type": "subtitle", "time": 5557.51, "timestamp": "01:32:37", "text": "ただのファンタジーのためだけに。そうそう、"}, {"type": "subtitle", "time": 5560.229, "timestamp": "01:32:40", "text": "ライト。うん。満腹になる"}, {"type": "subtitle", "time": 5562.87, "timestamp": "01:32:42", "text": "ファンタジーだよ、わかる？私でさえ"}, {"type": "subtitle", "time": 5566.55, "timestamp": "01:32:46", "text": "君は、まだ待っているよ"}, {"type": "subtitle", "time": 5568.99, "timestamp": "01:32:48", "text": "次の章は"}, {"type": "subtitle", "time": 5573.75, "timestamp": "01:32:53", "text": "えーっと、魔界学校へようこそ、そして"}, {"type": "subtitle", "time": 5576.79, "timestamp": "01:32:56", "text": "はい。うん。そして、Web Tuneで配信中のUnordinary。"}, {"type": "subtitle", "time": 5578.31, "timestamp": "01:32:58", "text": "私はまだそれらが届くのを待っています"}]
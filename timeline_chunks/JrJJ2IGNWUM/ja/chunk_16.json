[{"type": "subtitle", "time": 962.55, "timestamp": "00:16:02", "text": "証明書が正規のものではないか、"}, {"type": "subtitle", "time": 965.03, "timestamp": "00:16:05", "text": "有効性とか何か、あるいはあなたがしないようなこと"}, {"type": "subtitle", "time": 967.67, "timestamp": "00:16:07", "text": "この証明書で仕事やその他諸々を手に入れよう"}, {"type": "subtitle", "time": 969.35, "timestamp": "00:16:09", "text": "今となっては時間の無駄になるだろう。それで"}, {"type": "subtitle", "time": 971.03, "timestamp": "00:16:11", "text": "彼はそれを信じなかった。その時"}, {"type": "subtitle", "time": 972.949, "timestamp": "00:16:12", "text": "教授した"}, {"type": "subtitle", "time": 975.829, "timestamp": "00:16:15", "text": "ええ、教授のおじさんが言ったとき"}, {"type": "subtitle", "time": 977.91, "timestamp": "00:16:17", "text": "よし、やろう、と彼は言い始めた"}, {"type": "subtitle", "time": 979.749, "timestamp": "00:16:19", "text": "他の人が信じたから信じる"}, {"type": "subtitle", "time": 983.189, "timestamp": "00:16:23", "text": "今、それは保証があると言った"}, {"type": "subtitle", "time": 987.189, "timestamp": "00:16:27", "text": "うん、こっちの方がいいし、"}, {"type": "subtitle", "time": 990.629, "timestamp": "00:16:30", "text": "2022年頃からこれを始めました"}, {"type": "subtitle", "time": 995.59, "timestamp": "00:16:35", "text": "英語文学優等コース"}, {"type": "subtitle", "time": 998.79, "timestamp": "00:16:38", "text": "そして私はまだしたくない、わからない"}, {"type": "subtitle", "time": 1001.749, "timestamp": "00:16:41", "text": "なぜ勉強する意欲を失ったのか、"}, {"type": "subtitle", "time": 1003.99, "timestamp": "00:16:43", "text": "何か。それ以来"}, {"type": "subtitle", "time": 1007.269, "timestamp": "00:16:47", "text": "えっと、この素敵なものを楽しんで以来"}, {"type": "subtitle", "time": 1009.99, "timestamp": "00:16:49", "text": "ゲーム活動や"}, {"type": "subtitle", "time": 1012.23, "timestamp": "00:16:52", "text": "自分のもの。うん。あなたは"}, {"type": "subtitle", "time": 1014.71, "timestamp": "00:16:54", "text": "中毒性がある。それは中毒のようなものだ"}, {"type": "subtitle", "time": 1016.55, "timestamp": "00:16:56", "text": "そこから抜け出さなきゃいけないけど、わかるでしょ"}]
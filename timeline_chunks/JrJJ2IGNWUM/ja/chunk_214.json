[{"type": "subtitle", "time": 12843.99, "timestamp": "03:34:03", "text": "優勝シーズン。"}, {"type": "subtitle", "time": 12846.349, "timestamp": "03:34:06", "text": "ええ、難しいですね。以前は"}, {"type": "subtitle", "time": 12851.11, "timestamp": "03:34:11", "text": "以前は簡単だった。"}, {"type": "subtitle", "time": 12853.309, "timestamp": "03:34:13", "text": "みんなそれを持ってるよ"}, {"type": "subtitle", "time": 12860.55, "timestamp": "03:34:20", "text": "すべて、ですよね？その動き、"}, {"type": "subtitle", "time": 12863.11, "timestamp": "03:34:23", "text": "狙いを定めるか、狙いを定めるかではなく、動きそのものが痛みなのだ。"}, {"type": "subtitle", "time": 12864.63, "timestamp": "03:34:24", "text": "の"}, {"type": "subtitle", "time": 12868.95, "timestamp": "03:34:28", "text": "リダイレクト、あの狂った人たち"}, {"type": "subtitle", "time": 12870.59, "timestamp": "03:34:30", "text": "動き"}, {"type": "subtitle", "time": 12890.75, "timestamp": "03:34:50", "text": "あなたは"}, {"type": "subtitle", "time": 12893.91, "timestamp": "03:34:53", "text": "再度読み込まれない？"}, {"type": "subtitle", "time": 12897.11, "timestamp": "03:34:57", "text": "いいえ、まだ読み込み中です。どうしたの？"}, {"type": "subtitle", "time": 12899.87, "timestamp": "03:34:59", "text": "待って、ロードしましたか、"}]
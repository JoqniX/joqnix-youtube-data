[{"type": "subtitle", "time": 7622.229, "timestamp": "02:07:02", "text": "それはどんな感じですか？待って、君もプレイする"}, {"type": "subtitle", "time": 7623.75, "timestamp": "02:07:03", "text": "多く、"}, {"type": "subtitle", "time": 7626.99, "timestamp": "02:07:06", "text": "[音楽]"}, {"type": "subtitle", "time": 7629.43, "timestamp": "02:07:09", "text": "右？正直に言うと、私はプレイしました"}, {"type": "subtitle", "time": 7632.069, "timestamp": "02:07:12", "text": "アニメを実際に聴くために"}, {"type": "subtitle", "time": 7634.709, "timestamp": "02:07:14", "text": "曲をダウンロードしたり、"}, {"type": "subtitle", "time": 7638.55, "timestamp": "02:07:18", "text": "あなたが知っている。でも、オハイオ州立大学は大変だったよ。まるで私が"}, {"type": "subtitle", "time": 7641.069, "timestamp": "02:07:21", "text": "4つ星を超えることはできない"}, {"type": "subtitle", "time": 7643.149, "timestamp": "02:07:23", "text": "地図。それはとても"}, {"type": "subtitle", "time": 7655.589, "timestamp": "02:07:35", "text": "これで直るといいのですが。ええ、彼は亡くなりました。おお、"}, {"type": "subtitle", "time": 7673.709, "timestamp": "02:07:53", "text": "くそ？"}]
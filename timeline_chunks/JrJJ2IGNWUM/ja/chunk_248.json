[{"type": "subtitle", "time": 14884.07, "timestamp": "04:08:04", "text": "その戦いにおける金持ちの皮。"}, {"type": "subtitle", "time": 14886.71, "timestamp": "04:08:06", "text": "私はとても"}, {"type": "subtitle", "time": 14891.429, "timestamp": "04:08:11", "text": "ああ、お前、ひどく酔っ払ったな。"}, {"type": "subtitle", "time": 14899.75, "timestamp": "04:08:19", "text": "イタリア語。イタリア語。よし、着陸しよう"}, {"type": "subtitle", "time": 14912.229, "timestamp": "04:08:32", "text": "3つくらいあります。何てことだ。"}, {"type": "subtitle", "time": 14937.59, "timestamp": "04:08:57", "text": "注意。強化された武器を手に入れた。準備ができて"}]
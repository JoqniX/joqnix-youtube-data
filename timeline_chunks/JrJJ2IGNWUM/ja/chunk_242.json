[{"type": "subtitle", "time": 14528.83, "timestamp": "04:02:08", "text": "彼？くそ。もう一人の男は2つ手に入れた"}, {"type": "subtitle", "time": 14536.469, "timestamp": "04:02:16", "text": "[音楽]"}, {"type": "subtitle", "time": 14537.469, "timestamp": "04:02:17", "text": "それは"}, {"type": "subtitle", "time": 14560.87, "timestamp": "04:02:40", "text": "ああ、最初のやつだ。ああ、わかりました。"}, {"type": "subtitle", "time": 14562.389, "timestamp": "04:02:42", "text": "わかった。あなたが言っていたのはそういうことだったんですね。私"}, {"type": "subtitle", "time": 14567.03, "timestamp": "04:02:47", "text": "君は"}, {"type": "subtitle", "time": 14575.87, "timestamp": "04:02:55", "text": "何か。プレイしましたか"}]
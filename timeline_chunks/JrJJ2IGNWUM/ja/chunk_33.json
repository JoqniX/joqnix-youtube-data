[{"type": "subtitle", "time": 1981.669, "timestamp": "00:33:01", "text": "マーティンやパパタのような人がまだいるかどうかはわかりません"}, {"type": "subtitle", "time": 1983.029, "timestamp": "00:33:03", "text": "ここだけど、そう、彼らは最後の"}, {"type": "subtitle", "time": 1986.07, "timestamp": "00:33:06", "text": "ストリーム。私たちは狂犬病について話していました"}, {"type": "subtitle", "time": 1989.269, "timestamp": "00:33:09", "text": "えっと、なんていう名前ですか？ラビッツは安全ではない"}, {"type": "subtitle", "time": 1993.19, "timestamp": "00:33:13", "text": "仕事内容について。何てことだ。"}, {"type": "subtitle", "time": 1997.509, "timestamp": "00:33:17", "text": "うん、俺たちは、俺はただ楽しんでるだけなんだ"}, {"type": "subtitle", "time": 1999.83, "timestamp": "00:33:19", "text": "それはかなり粗雑だ。それはそんなに間違っているのか"}, {"type": "subtitle", "time": 2003.19, "timestamp": "00:33:23", "text": "自分？ご存知の通り、私はただの個人です。"}, {"type": "subtitle", "time": 2010.95, "timestamp": "00:33:30", "text": "うん。時々、ただ話したいだけなんです"}, {"type": "subtitle", "time": 2014.789, "timestamp": "00:33:34", "text": "このようなナンセンスな話題について"}, {"type": "subtitle", "time": 2017.43, "timestamp": "00:33:37", "text": "それは全く意味をなさない。バランスをとるウサギたち"}, {"type": "subtitle", "time": 2019.35, "timestamp": "00:33:39", "text": "彼らのペニスに重りが付いている。その通りだよ、パット。"}, {"type": "subtitle", "time": 2022.07, "timestamp": "00:33:42", "text": "まさにその通りです。そう、"}, {"type": "subtitle", "time": 2024.47, "timestamp": "00:33:44", "text": "まだその画像を持っていると思う。待って、"}, {"type": "subtitle", "time": 2026.23, "timestamp": "00:33:46", "text": "まだその画像を持っていますか？いいえ、私はしません。私"}, {"type": "subtitle", "time": 2028.389, "timestamp": "00:33:48", "text": "考える。でも、それを共有したくない"}, {"type": "subtitle", "time": 2030.789, "timestamp": "00:33:50", "text": "今のあなた。この配信では配信していません。私"}, {"type": "subtitle", "time": 2031.99, "timestamp": "00:33:51", "text": "目が悪くなるのは嫌だ"}, {"type": "subtitle", "time": 2034.07, "timestamp": "00:33:54", "text": "また。知っている。だって神様はあなたが見たことを知っているから"}, {"type": "subtitle", "time": 2036.71, "timestamp": "00:33:56", "text": "すでにたくさんあります。"}, {"type": "subtitle", "time": 2038.99, "timestamp": "00:33:58", "text": "ああ、"}]
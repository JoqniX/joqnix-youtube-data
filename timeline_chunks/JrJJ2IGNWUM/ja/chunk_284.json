[{"type": "subtitle", "time": 17040.35, "timestamp": "04:44:00", "text": "えーと、緊急事態の人、"}, {"type": "subtitle", "time": 17043.23, "timestamp": "04:44:03", "text": "正午 正午"}, {"type": "subtitle", "time": 17047.35, "timestamp": "04:44:07", "text": "土曜日の正午に3人で行くのがいいでしょう。"}, {"type": "subtitle", "time": 17049.99, "timestamp": "04:44:09", "text": "午後6時午後10時までそして午後10時10分"}, {"type": "subtitle", "time": 17054.43, "timestamp": "04:44:14", "text": "グループコラボレーション。こんにちは、ウィッシュ。わかった。私"}, {"type": "subtitle", "time": 17058.23, "timestamp": "04:44:18", "text": "ヴィックとこういうことやったよね？私"}, {"type": "subtitle", "time": 17061.03, "timestamp": "04:44:21", "text": "やったよ。これらはグループ向けのものでもあります"}, {"type": "subtitle", "time": 17063.51, "timestamp": "04:44:23", "text": "このものとして考えられています。私はそれをやった"}, {"type": "subtitle", "time": 17067.11, "timestamp": "04:44:27", "text": "ヴィックと一緒です。えっと、実は私は"}, {"type": "subtitle", "time": 17069.51, "timestamp": "04:44:29", "text": "何人かの人ともう一度やります。なぜなら私は"}, {"type": "subtitle", "time": 17073.27, "timestamp": "04:44:33", "text": "連続してやっているようにも、"}, {"type": "subtitle", "time": 17077.59, "timestamp": "04:44:37", "text": "意識しておかなければならない。"}, {"type": "subtitle", "time": 17080.55, "timestamp": "04:44:40", "text": "それは、人々が2度チャンスを得るということだ。"}, {"type": "subtitle", "time": 17084.31, "timestamp": "04:44:44", "text": "まだ知り合っていない人たちと連絡を取らなければならない"}, {"type": "subtitle", "time": 17088.27, "timestamp": "04:44:48", "text": "私のチャンネルもまだです。"}, {"type": "subtitle", "time": 17091.43, "timestamp": "04:44:51", "text": "うん。 「ああ、そうだよ」という人がたくさんいます"}, {"type": "subtitle", "time": 17093.47, "timestamp": "04:44:53", "text": "手に入れたい"}, {"type": "subtitle", "time": 17096.868, "timestamp": "04:44:56", "text": "「ハルサン、JPBの塊茎。」私がそれをやった"}, {"type": "subtitle", "time": 17099.39, "timestamp": "04:44:59", "text": "リポジトリコラボレーション"}]
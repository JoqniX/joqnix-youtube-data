[{"type": "subtitle", "time": 7516.589, "timestamp": "02:05:16", "text": "最高。いいね、いいね、いいね。取っていく"}, {"type": "subtitle", "time": 7520.75, "timestamp": "02:05:20", "text": "シールド。私は上がっていく。おお"}, {"type": "subtitle", "time": 7523.31, "timestamp": "02:05:23", "text": "いいえ。ああ。"}, {"type": "subtitle", "time": 7527.589, "timestamp": "02:05:27", "text": "GG。私たちは努力しました。私はひどいリードをしていた"}, {"type": "subtitle", "time": 7530.709, "timestamp": "02:05:30", "text": "そちら側。まあ、そうですね。うん、たぶん"}, {"type": "subtitle", "time": 7532.629, "timestamp": "02:05:32", "text": "Apexは何かできるのか。ええ、もちろんです。もちろん。"}, {"type": "subtitle", "time": 7534.31, "timestamp": "02:05:34", "text": "いつか、いつか。うん。だから今日私は"}, {"type": "subtitle", "time": 7536.79, "timestamp": "02:05:36", "text": "一人でやりたかったんだよ、ほら、"}, {"type": "subtitle", "time": 7538.91, "timestamp": "02:05:38", "text": "挽く"}, {"type": "subtitle", "time": 7542.229, "timestamp": "02:05:42", "text": "前に。うん。シーズンが終わる前に。"}, {"type": "subtitle", "time": 7544.31, "timestamp": "02:05:44", "text": "ええ、そうですね。本日の次の配信"}, {"type": "subtitle", "time": 7547.35, "timestamp": "02:05:47", "text": "続いて、視聴者を招待します"}, {"type": "subtitle", "time": 7550.03, "timestamp": "02:05:50", "text": "ビデオでの参加も可能です。"}, {"type": "subtitle", "time": 7553.35, "timestamp": "02:05:53", "text": "それで、でもそれについてもちょっと怖いんです"}, {"type": "subtitle", "time": 7556.07, "timestamp": "02:05:56", "text": "だって、私の演奏はすごく下手だから。私の全ては"}, {"type": "subtitle", "time": 7557.79, "timestamp": "02:05:57", "text": "消えた"}]
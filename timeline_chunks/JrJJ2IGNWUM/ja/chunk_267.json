[{"type": "subtitle", "time": 16021.229, "timestamp": "04:27:01", "text": "あなたと一緒に過ごすのは本当に楽しいし、"}, {"type": "subtitle", "time": 16024.71, "timestamp": "04:27:04", "text": "また、これとのコラボレーションも"}, {"type": "subtitle", "time": 16027.429, "timestamp": "04:27:07", "text": "私たちの最初のコラボレーション。私たちはそれを嬉しく思います"}, {"type": "subtitle", "time": 16029.91, "timestamp": "04:27:09", "text": "うまくいった。"}, {"type": "subtitle", "time": 16034.229, "timestamp": "04:27:14", "text": "うん。そして私は実際には覚えていません"}, {"type": "subtitle", "time": 16036.469, "timestamp": "04:27:16", "text": "ああ、あなたの声を聞いて、あなたが話しているのを聞いて、"}, {"type": "subtitle", "time": 16040.55, "timestamp": "04:27:20", "text": "でも、私たちは少し話をしたと思うし、今は"}, {"type": "subtitle", "time": 16043.11, "timestamp": "04:27:23", "text": "また話さなきゃ。"}, {"type": "subtitle", "time": 16048.189, "timestamp": "04:27:28", "text": "感謝"}, {"type": "subtitle", "time": 16052.63, "timestamp": "04:27:32", "text": "あなた。それでは、今日も素敵な夜をお過ごしください。"}, {"type": "subtitle", "time": 16060.309, "timestamp": "04:27:40", "text": "おやすみ。こんにちは。私たちには何かありますか、"}, {"type": "subtitle", "time": 16062.79, "timestamp": "04:27:42", "text": "出発前に何かお知らせはありますか？"}, {"type": "subtitle", "time": 16065.11, "timestamp": "04:27:45", "text": "何か共有したいことはありますか？"}, {"type": "subtitle", "time": 16067.189, "timestamp": "04:27:47", "text": "お知らせやその他"}, {"type": "subtitle", "time": 16079.349, "timestamp": "04:27:59", "text": "わからない。夢を見ているとき"}]
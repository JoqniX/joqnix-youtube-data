[{"type": "subtitle", "time": 14460.229, "timestamp": "04:01:00", "text": "来て。来て。来て。"}, {"type": "subtitle", "time": 14462.469, "timestamp": "04:01:02", "text": "あなたの男を連れて行ってください。それらを受け取ってください。救急キット"}, {"type": "subtitle", "time": 14464.15, "timestamp": "04:01:04", "text": "ここ。"}, {"type": "subtitle", "time": 14474.67, "timestamp": "04:01:14", "text": "充電中です。オフ"}, {"type": "subtitle", "time": 14476.99, "timestamp": "04:01:16", "text": "右"}, {"type": "subtitle", "time": 14480.91, "timestamp": "04:01:20", "text": "私のマーカーの連絡先は"}, {"type": "subtitle", "time": 14495.51, "timestamp": "04:01:35", "text": "彼を蘇生させてください。"}, {"type": "subtitle", "time": 14498.75, "timestamp": "04:01:38", "text": "何てことだ。"}, {"type": "subtitle", "time": 14502.79, "timestamp": "04:01:42", "text": "蘇生機能が壊れています。再装填中。"}, {"type": "subtitle", "time": 14505.229, "timestamp": "04:01:45", "text": "押している"}, {"type": "subtitle", "time": 14507.0, "timestamp": "04:01:47", "text": "あなた"}]
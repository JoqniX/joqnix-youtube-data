[{"type": "subtitle", "time": 10081.11, "timestamp": "02:48:01", "text": "なんでマイクを使ったんだろう？悲しくなるだろう。"}, {"type": "subtitle", "time": 10084.349, "timestamp": "02:48:04", "text": "「うわあ」って感じ。私は"}, {"type": "subtitle", "time": 10086.63, "timestamp": "02:48:06", "text": "何も起こらないと確信している"}, {"type": "subtitle", "time": 10088.23, "timestamp": "02:48:08", "text": "ありがたいことに。"}, {"type": "subtitle", "time": 10090.429, "timestamp": "02:48:10", "text": "私は使用しません"}, {"type": "subtitle", "time": 10096.71, "timestamp": "02:48:16", "text": "私は全く好きではありません。うん。私は普段"}, {"type": "subtitle", "time": 10099.75, "timestamp": "02:48:19", "text": "いいね、コメント"}, {"type": "subtitle", "time": 10102.08, "timestamp": "02:48:22", "text": "本文へ。"}, {"type": "subtitle", "time": 10103.99, "timestamp": "02:48:23", "text": "[音楽]"}, {"type": "subtitle", "time": 10106.469, "timestamp": "02:48:26", "text": "どうやってそれを書き出す時間を見つけるのですか？"}, {"type": "subtitle", "time": 10110.79, "timestamp": "02:48:30", "text": "ゲーム中に言おうとしている"}, {"type": "subtitle", "time": 10115.99, "timestamp": "02:48:35", "text": "落ち込んでいるときは、com を与えることができます。おお、"}, {"type": "subtitle", "time": 10120.469, "timestamp": "02:48:40", "text": "はい。賛成です。はい、AFK で"}, {"type": "subtitle", "time": 10125.03, "timestamp": "02:48:45", "text": "安全なフィールドを提供し、通信を提供します。"}, {"type": "subtitle", "time": 10138.19, "timestamp": "02:48:58", "text": "有毒"}]
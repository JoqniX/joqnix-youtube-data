[{"type": "subtitle", "time": 6302.709, "timestamp": "01:45:02", "text": "私は本当に映画を見る準備万端だった"}, {"type": "subtitle", "time": 6305.669, "timestamp": "01:45:05", "text": "ジャック・ブラックがスティーブを演じるのが嫌いだが、"}, {"type": "subtitle", "time": 6307.91, "timestamp": "01:45:07", "text": "彼らはそれを楽しんでいることに気づきました"}, {"type": "subtitle", "time": 6310.149, "timestamp": "01:45:10", "text": "そして私はこう思う。「どうしてこれを嫌いになれるだろうか？これは"}, {"type": "subtitle", "time": 6313.03, "timestamp": "01:45:13", "text": "楽しいです。ジャック・ブラックが"}, {"type": "subtitle", "time": 6314.95, "timestamp": "01:45:14", "text": "彼自身のやり方だ。"}, {"type": "subtitle", "time": 6318.87, "timestamp": "01:45:18", "text": "うん。そうだよね。まるで"}, {"type": "subtitle", "time": 6321.43, "timestamp": "01:45:21", "text": "それ。それは良い映画の証だ。もし"}, {"type": "subtitle", "time": 6324.07, "timestamp": "01:45:24", "text": "あなたは最初からそれを嫌うつもりでいる"}, {"type": "subtitle", "time": 6327.51, "timestamp": "01:45:27", "text": "そしてあなたはそれを好きになるように仕向けられ、"}, {"type": "subtitle", "time": 6329.43, "timestamp": "01:45:29", "text": "それは良い映画だ。それは本当に"}, {"type": "subtitle", "time": 6333.109, "timestamp": "01:45:33", "text": "良い映画だった。うん。まるで"}, {"type": "subtitle", "time": 6335.109, "timestamp": "01:45:35", "text": "ええと、それは本当に言えません"}, {"type": "subtitle", "time": 6336.79, "timestamp": "01:45:36", "text": "FNAF映画について。それはむしろ"}, {"type": "subtitle", "time": 6339.27, "timestamp": "01:45:39", "text": "私にとっては賛否両論といったところだ。"}, {"type": "subtitle", "time": 6340.95, "timestamp": "01:45:40", "text": "でも私はジャック・ブラックを嫌おうとしている"}, {"type": "subtitle", "time": 6344.709, "timestamp": "01:45:44", "text": "ジャック・ブラックですよね？私はそうじゃない"}, {"type": "subtitle", "time": 6347.109, "timestamp": "01:45:47", "text": "ジャック・ブラックがジャック・ブラックであるという理由で、ジャック・ブラックが嫌いだ。私"}, {"type": "subtitle", "time": 6349.109, "timestamp": "01:45:49", "text": "彼が、"}, {"type": "subtitle", "time": 6351.99, "timestamp": "01:45:51", "text": "私の大好きなスティーブというキャラクターですよね？しかし"}, {"type": "subtitle", "time": 6355.51, "timestamp": "01:45:55", "text": "そしてジャック・ブラックがスティーブを演じていることに気づいた"}, {"type": "subtitle", "time": 6357.59, "timestamp": "01:45:57", "text": "それほど悪くはない、なぜなら彼は"}]
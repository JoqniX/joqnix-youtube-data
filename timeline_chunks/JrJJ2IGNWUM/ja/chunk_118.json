[{"type": "subtitle", "time": 7082.47, "timestamp": "01:58:02", "text": "かなり長い間。うん、楽しみだよ"}, {"type": "subtitle", "time": 7085.669, "timestamp": "01:58:05", "text": "それ。だから、私が"}, {"type": "subtitle", "time": 7090.55, "timestamp": "01:58:10", "text": "えっと、あなたを置いていきたいのですが"}, {"type": "subtitle", "time": 7093.43, "timestamp": "01:58:13", "text": "男たちはすぐ戻る。 BRB V をお楽しみいただけます"}, {"type": "subtitle", "time": 7096.79, "timestamp": "01:58:16", "text": "などなど。また、"}, {"type": "subtitle", "time": 7099.589, "timestamp": "01:58:19", "text": "えっと、Sushiも登録して応援してください。"}, {"type": "subtitle", "time": 7101.83, "timestamp": "01:58:21", "text": "彼のリンクは説明欄にあります。"}, {"type": "subtitle", "time": 7103.83, "timestamp": "01:58:23", "text": "また、すべての固定コメントにも"}, {"type": "subtitle", "time": 7107.75, "timestamp": "01:58:27", "text": "プラットフォーム。どうぞご自由にご覧ください"}, {"type": "subtitle", "time": 7110.47, "timestamp": "01:58:30", "text": "サポートについてなので、彼女は寿司のコンテンツです"}, {"type": "subtitle", "time": 7112.39, "timestamp": "01:58:32", "text": "そして彼は今ライブ配信中なので"}, {"type": "subtitle", "time": 7114.79, "timestamp": "01:58:34", "text": "彼らと話したり、おしゃべりしたり、リラックスしたり"}, {"type": "subtitle", "time": 7118.03, "timestamp": "01:58:38", "text": "物もそれを行うことができます。それで"}, {"type": "subtitle", "time": 7122.95, "timestamp": "01:58:42", "text": "うん、こんにちは。食事とかしに行くよ。"}, {"type": "subtitle", "time": 7126.39, "timestamp": "01:58:46", "text": "わかった、ちょっとご飯食べてくるね。戻ってくる"}, {"type": "chat", "time": 7131.511, "timestamp": "01:58:51", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "Joq went to have his dinner~ do enjoy the vods till i come back nee~"}, {"type": "chat", "time": 7134.717, "timestamp": "01:58:54", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "Joq's Activity State is MealTime - Dinner"}, {"type": "subtitle", "time": 7139.109, "timestamp": "01:58:59", "text": "夕食。よし。 Vを楽しんでください、皆さん。"}]
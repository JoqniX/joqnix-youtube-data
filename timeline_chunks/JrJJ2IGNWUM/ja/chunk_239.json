[{"type": "subtitle", "time": 14359.269, "timestamp": "03:59:19", "text": "注意。ファーストブラッド。"}, {"type": "subtitle", "time": 14362.15, "timestamp": "03:59:22", "text": "先制攻撃を仕掛けたのはどちらか。わかった。尊敬。"}, {"type": "subtitle", "time": 14365.269, "timestamp": "03:59:25", "text": "どこですか？ニール1。第1ラウンド。"}, {"type": "subtitle", "time": 14368.229, "timestamp": "03:59:28", "text": "誰かがそこにいる。"}, {"type": "subtitle", "time": 14396.63, "timestamp": "03:59:56", "text": "再装填中。シールドを再充電中。カバー"}]
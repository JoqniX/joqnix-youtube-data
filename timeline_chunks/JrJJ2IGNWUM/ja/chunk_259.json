[{"type": "subtitle", "time": 15540.79, "timestamp": "04:19:00", "text": "待って、私はストリーマーモードを持っているので、"}, {"type": "subtitle", "time": 15553.429, "timestamp": "04:19:13", "text": "ちょっと待って。人を通報するにはどうすればよいですか？"}, {"type": "subtitle", "time": 15555.07, "timestamp": "04:19:15", "text": "動き"}, {"type": "subtitle", "time": 15559.149, "timestamp": "04:19:19", "text": "進捗。報告しているが、我々は"}, {"type": "subtitle", "time": 15564.55, "timestamp": "04:19:24", "text": "あなたの葬儀で。お前を殺さなければならない。"}, {"type": "subtitle", "time": 15566.67, "timestamp": "04:19:26", "text": "感謝はしません。彼らは"}, {"type": "subtitle", "time": 15569.91, "timestamp": "04:19:29", "text": "あなたのチーム。"}, {"type": "subtitle", "time": 15574.149, "timestamp": "04:19:34", "text": "私を通報するために。これは"}, {"type": "subtitle", "time": 15579.469, "timestamp": "04:19:39", "text": "ああ、"}, {"type": "subtitle", "time": 15582.55, "timestamp": "04:19:42", "text": "神。これは本当ですか？"}, {"type": "subtitle", "time": 15585.67, "timestamp": "04:19:45", "text": "何てことだ。"}, {"type": "subtitle", "time": 15589.229, "timestamp": "04:19:49", "text": "神に誓って。いや。彼"}, {"type": "subtitle", "time": 15592.99, "timestamp": "04:19:52", "text": "n Ro もしあなたが撃つなら"}]
[{"type": "subtitle", "time": 782.15, "timestamp": "00:13:02", "text": "私が拒否されたのは、私が"}, {"type": "chat", "time": 784.386, "timestamp": "00:13:04", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "hey hey Joqqy"}, {"type": "subtitle", "time": 785.75, "timestamp": "00:13:05", "text": "えっと、あと２点必要だったんだけど"}, {"type": "chat", "time": 787.98, "timestamp": "00:13:07", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "how u doin today?"}, {"type": "subtitle", "time": 788.31, "timestamp": "00:13:08", "text": "最低合格点のようなもの"}, {"type": "subtitle", "time": 791.43, "timestamp": "00:13:11", "text": "その科目を研究すること。私は思う"}, {"type": "subtitle", "time": 793.829, "timestamp": "00:13:13", "text": "友人から物流の仕事を頼まれた"}, {"type": "subtitle", "time": 797.269, "timestamp": "00:13:17", "text": "あるいは何かが私に彼らと一緒にいたいと望んでいた"}, {"type": "subtitle", "time": 800.31, "timestamp": "00:13:20", "text": "などなど。だから私は「よし、やってみよう」と思ったんです。"}, {"type": "subtitle", "time": 802.629, "timestamp": "00:13:22", "text": "私は大学に行きました"}, {"type": "subtitle", "time": 804.949, "timestamp": "00:13:24", "text": "文字通り私の家のすぐ近くです。"}, {"type": "subtitle", "time": 809.509, "timestamp": "00:13:29", "text": "次の角の家か"}, {"type": "subtitle", "time": 811.67, "timestamp": "00:13:31", "text": "その地域には住宅がないところもある。だから私はこう思った"}, {"type": "subtitle", "time": 814.99, "timestamp": "00:13:34", "text": "うん、やってみるよ。私の祖父は"}, {"type": "subtitle", "time": 817.19, "timestamp": "00:13:37", "text": "この大学の学長と"}, {"type": "subtitle", "time": 818.87, "timestamp": "00:13:38", "text": "もの。だから私は、もしかしたら手に入れることができるかもしれないと思った"}, {"type": "subtitle", "time": 822.03, "timestamp": "00:13:42", "text": "彼がもっと何かを推奨する"}, {"type": "subtitle", "time": 825.829, "timestamp": "00:13:45", "text": "ええ、そうでした。しかし実際には私は"}, {"type": "subtitle", "time": 828.949, "timestamp": "00:13:48", "text": "物流分野へ。私は2人の"}, {"type": "subtitle", "time": 832.55, "timestamp": "00:13:52", "text": "オプション。コミュニケーションかITのどちらかを選べ。"}, {"type": "subtitle", "time": 835.67, "timestamp": "00:13:55", "text": "私は「うん、両方ともマスクコム、最高だ」って感じだった"}, {"type": "subtitle", "time": 839.189, "timestamp": "00:13:59", "text": "マスコムとか、えっと、それで、えっと、"}]
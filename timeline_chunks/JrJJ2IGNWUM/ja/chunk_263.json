[{"type": "subtitle", "time": 15792.189, "timestamp": "04:23:12", "text": "何てことだ。いいえ"}, {"type": "subtitle", "time": 15796.11, "timestamp": "04:23:16", "text": "方法。とんでもない。 Rokuは実際には"}, {"type": "subtitle", "time": 15798.87, "timestamp": "04:23:18", "text": "リプレイヤー。くそ。私はあなたが"}, {"type": "subtitle", "time": 15806.469, "timestamp": "04:23:26", "text": "バカ。彼が自分の"}, {"type": "subtitle", "time": 15814.63, "timestamp": "04:23:34", "text": "友人。ここに1つあります。そしてそれはとても"}, {"type": "subtitle", "time": 15835.07, "timestamp": "04:23:55", "text": "行く。"}]
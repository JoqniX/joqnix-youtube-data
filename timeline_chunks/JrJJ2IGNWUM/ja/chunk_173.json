[{"type": "subtitle", "time": 10382.63, "timestamp": "02:53:02", "text": "私は今イヤホンを使っています"}, {"type": "subtitle", "time": 10388.51, "timestamp": "02:53:08", "text": "でも、あなたのモニターに入り込むつもりです"}, {"type": "subtitle", "time": 10393.91, "timestamp": "02:53:13", "text": "有線タイプのようなもの"}, {"type": "subtitle", "time": 10400.429, "timestamp": "02:53:20", "text": "それはすばらしい。それは"}, {"type": "subtitle", "time": 10403.95, "timestamp": "02:53:23", "text": "ニース。持続する。ああむらはこんにちは"}, {"type": "subtitle", "time": 10411.71, "timestamp": "02:53:31", "text": "[音楽]"}, {"type": "subtitle", "time": 10415.349, "timestamp": "02:53:35", "text": "こんにちは。こんにちは。"}, {"type": "subtitle", "time": 10417.17, "timestamp": "02:53:37", "text": "そして、こんにちは、Roku。"}, {"type": "subtitle", "time": 10424.67, "timestamp": "02:53:44", "text": "いらっしゃいませ。"}, {"type": "subtitle", "time": 10429.269, "timestamp": "02:53:49", "text": "シェーダーを作らなければならないと知っていたら、"}, {"type": "subtitle", "time": 10431.83, "timestamp": "02:53:51", "text": "プレイもできます。"}, {"type": "subtitle", "time": 10433.389, "timestamp": "02:53:53", "text": "うん。うん。うん。彼"}, {"type": "subtitle", "time": 10436.95, "timestamp": "02:53:56", "text": "そうです。彼は毎日遊んでいた"}]
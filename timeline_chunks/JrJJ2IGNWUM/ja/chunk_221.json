[{"type": "subtitle", "time": 13267.11, "timestamp": "03:41:07", "text": "新たな殺人犯が現れた。収穫機は現在"}, {"type": "subtitle", "time": 13277.269, "timestamp": "03:41:17", "text": "また、チャージライフルは自動右です"}, {"type": "subtitle", "time": 13289.15, "timestamp": "03:41:29", "text": "私はホッパーを持っています"}, {"type": "subtitle", "time": 13293.389, "timestamp": "03:41:33", "text": "充電に使用できます"}, {"type": "subtitle", "time": 13301.309, "timestamp": "03:41:41", "text": "相棒。ウィングマン"}, {"type": "subtitle", "time": 13305.91, "timestamp": "03:41:45", "text": "まさに今です。壊れています"}]
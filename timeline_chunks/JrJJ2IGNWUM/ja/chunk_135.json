[{"type": "subtitle", "time": 8105.149, "timestamp": "02:15:05", "text": "いいえ。"}, {"type": "subtitle", "time": 8125.189, "timestamp": "02:15:25", "text": "実際には私を必要としている。えっと、彼を手伝いに行ってきます"}, {"type": "subtitle", "time": 8126.35, "timestamp": "02:15:26", "text": "で"}, {"type": "subtitle", "time": 8130.35, "timestamp": "02:15:30", "text": "少し。えーっと、心は"}, {"type": "subtitle", "time": 8134.47, "timestamp": "02:15:34", "text": "うん、もうすぐ彼氏になるよ。わかった。それで"}, {"type": "subtitle", "time": 8141.39, "timestamp": "02:15:41", "text": "そして"}, {"type": "subtitle", "time": 8144.03, "timestamp": "02:15:44", "text": "GGz、それは良い"}, {"type": "subtitle", "time": 8147.99, "timestamp": "02:15:47", "text": "1つ。えっと、ちょっと席を外します。"}, {"type": "subtitle", "time": 8150.069, "timestamp": "02:15:50", "text": "すぐ戻ります。すべて大丈夫です"}, {"type": "subtitle", "time": 8152.629, "timestamp": "02:15:52", "text": "もの。こんにちは。また、いとこを助けて"}, {"type": "subtitle", "time": 8156.03, "timestamp": "02:15:56", "text": "少し。わかった。それでは、音楽をお楽しみください。"}, {"type": "subtitle", "time": 8159.629, "timestamp": "02:15:59", "text": "わかりました、また来ます。私は"}]
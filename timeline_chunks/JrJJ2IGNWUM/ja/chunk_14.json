[{"type": "subtitle", "time": 842.79, "timestamp": "00:14:02", "text": "多すぎるし、その悪徳な人"}, {"type": "subtitle", "time": 844.389, "timestamp": "00:14:04", "text": "校長か何か、彼女がその人だった"}, {"type": "subtitle", "time": 846.31, "timestamp": "00:14:06", "text": "誰が「うん、それは多すぎる」と言ったのか"}, {"type": "subtitle", "time": 848.87, "timestamp": "00:14:08", "text": "理論的であり、あなたがそうであるならば、"}, {"type": "subtitle", "time": 852.23, "timestamp": "00:14:12", "text": "たとえ"}, {"type": "subtitle", "time": 857.35, "timestamp": "00:14:17", "text": "コンピューターの前にいると、多すぎる"}, {"type": "subtitle", "time": 859.59, "timestamp": "00:14:19", "text": "理論的で、私は好きではなかった"}, {"type": "subtitle", "time": 862.31, "timestamp": "00:14:22", "text": "理論的なことなので、そうだった。"}, {"type": "subtitle", "time": 864.31, "timestamp": "00:14:24", "text": "実務的な作業のように。君はそれが好きだね"}, {"type": "subtitle", "time": 866.55, "timestamp": "00:14:26", "text": "実践的。"}, {"type": "subtitle", "time": 870.23, "timestamp": "00:14:30", "text": "うん。ええ、分かります。それから私はこう思った"}, {"type": "subtitle", "time": 872.629, "timestamp": "00:14:32", "text": "マスコミュニケーションは少し、えーと"}, {"type": "subtitle", "time": 875.11, "timestamp": "00:14:35", "text": "必要ないと思う。そして私はこう思った"}, {"type": "subtitle", "time": 877.269, "timestamp": "00:14:37", "text": "後回しにしていた。私は"}, {"type": "subtitle", "time": 879.35, "timestamp": "00:14:39", "text": "やりたくない。私は何度も戻って"}, {"type": "subtitle", "time": 882.23, "timestamp": "00:14:42", "text": "自分の部屋で自分の好きなことをしているだけ"}, {"type": "subtitle", "time": 884.71, "timestamp": "00:14:44", "text": "ゲームとかして遊ぶのも好きです。私は思う"}, {"type": "subtitle", "time": 886.79, "timestamp": "00:14:46", "text": "そうだった、あの時チューブに乗っていて"}, {"type": "subtitle", "time": 889.67, "timestamp": "00:14:49", "text": "食べ始めた以外はすべて"}, {"type": "subtitle", "time": 892.47, "timestamp": "00:14:52", "text": "すべて。私はそれに集中していました。ただ"}, {"type": "subtitle", "time": 895.269, "timestamp": "00:14:55", "text": "友達と話す時間を無駄にする"}, {"type": "subtitle", "time": 897.11, "timestamp": "00:14:57", "text": "日。そうだよ、それが夢なんだ。"}]
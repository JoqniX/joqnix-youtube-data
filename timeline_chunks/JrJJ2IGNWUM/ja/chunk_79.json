[{"type": "subtitle", "time": 4741.91, "timestamp": "01:19:01", "text": "若い頃はよくやっていたんだけど"}, {"type": "subtitle", "time": 4743.35, "timestamp": "01:19:03", "text": "えーと、私たちがよく訪れていたのは"}, {"type": "subtitle", "time": 4745.51, "timestamp": "01:19:05", "text": "田舎、私と私のとても遠い"}, {"type": "subtitle", "time": 4748.31, "timestamp": "01:19:08", "text": "親戚も子供だった"}, {"type": "subtitle", "time": 4750.87, "timestamp": "01:19:10", "text": "「君たち、一服してみないか？」みたいな感じ。そして"}, {"type": "subtitle", "time": 4752.229, "timestamp": "01:19:12", "text": "それは、もちろん、"}, {"type": "subtitle", "time": 4754.63, "timestamp": "01:19:14", "text": "英語。ええと、それは"}, {"type": "subtitle", "time": 4756.229, "timestamp": "01:19:16", "text": "フィリピン人だけど、君たちが連れて行きたいみたい"}, {"type": "subtitle", "time": 4758.51, "timestamp": "01:19:18", "text": "大ヒット。彼らはクソみたいなワックスを取り出す"}, {"type": "subtitle", "time": 4761.59, "timestamp": "01:19:21", "text": "ろうそく、彼らはそれに火をつけ、彼らは私に"}, {"type": "subtitle", "time": 4763.03, "timestamp": "01:19:23", "text": "ノートを見て、「一体何なんだ」と思った。"}, {"type": "subtitle", "time": 4765.27, "timestamp": "01:19:25", "text": "「私はこれで何をするんだろう？」そして"}, {"type": "subtitle", "time": 4767.669, "timestamp": "01:19:27", "text": "彼らは私に、まるで引き裂いたかのように見せた"}, {"type": "subtitle", "time": 4769.75, "timestamp": "01:19:29", "text": "紙切れを丸めて、"}, {"type": "subtitle", "time": 4772.07, "timestamp": "01:19:32", "text": "先端が焼けたので、吹き消して、"}, {"type": "subtitle", "time": 4774.39, "timestamp": "01:19:34", "text": "それらは煙をすべて吸い出す。そして私は"}, {"type": "subtitle", "time": 4777.669, "timestamp": "01:19:37", "text": "「なんだこれ？めっちゃクールじゃん。」私"}, {"type": "subtitle", "time": 4780.229, "timestamp": "01:19:40", "text": "そう思った後、試してみた。そして私は"}, {"type": "subtitle", "time": 4782.39, "timestamp": "01:19:42", "text": "「なんてこった、俺は一体何者なんだ」"}, {"type": "subtitle", "time": 4784.59, "timestamp": "01:19:44", "text": "何をしているの？これは、"}, {"type": "subtitle", "time": 4787.51, "timestamp": "01:19:47", "text": "「ケツ」私はまるで本物のクソを吸っているようだった"}, {"type": "subtitle", "time": 4789.43, "timestamp": "01:19:49", "text": "焦げた紙。"}, {"type": "subtitle", "time": 4791.189, "timestamp": "01:19:51", "text": "うん。本物のタバコを試したことはありますか？"}, {"type": "subtitle", "time": 4794.87, "timestamp": "01:19:54", "text": "以前、ジャッキーは？私は持っている。うん、君はそうしたね"}, {"type": "subtitle", "time": 4796.79, "timestamp": "01:19:56", "text": "お前は本当に気持ち悪い奴だ"}, {"type": "subtitle", "time": 4799.669, "timestamp": "01:19:59", "text": "新しいタバコを選ぶことについて？"}]
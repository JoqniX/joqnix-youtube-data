[{"type": "subtitle", "time": 3001.19, "timestamp": "00:50:01", "text": "ないの？はい。でもそれはまるで"}, {"type": "subtitle", "time": 3003.349, "timestamp": "00:50:03", "text": "焙煎した実際の豆のように"}, {"type": "subtitle", "time": 3005.99, "timestamp": "00:50:05", "text": "挽いて、それをそのまま"}, {"type": "subtitle", "time": 3007.67, "timestamp": "00:50:07", "text": "コーヒーマシンは実際にとても美味しいです"}, {"type": "subtitle", "time": 3010.39, "timestamp": "00:50:10", "text": "インスタントコーヒーとは違う。その"}, {"type": "subtitle", "time": 3013.109, "timestamp": "00:50:13", "text": "全く違う。うん。まるでそれがそうであるように"}, {"type": "subtitle", "time": 3015.91, "timestamp": "00:50:15", "text": "風味に非常に繊細さがある。右。私"}, {"type": "subtitle", "time": 3018.069, "timestamp": "00:50:18", "text": "コーヒーを淹れないから、気にしない。私 あなた"}, {"type": "subtitle", "time": 3020.069, "timestamp": "00:50:20", "text": "待たないで、君たちは何をするの？"}, {"type": "subtitle", "time": 3024.95, "timestamp": "00:50:24", "text": "普段はお酒を飲む？だって、わかったよ。私はお茶ではありません。"}, {"type": "subtitle", "time": 3028.23, "timestamp": "00:50:28", "text": "ああ、あなたは紅茶がお好きなんですね？うん。コーヒー。私"}, {"type": "subtitle", "time": 3030.71, "timestamp": "00:50:30", "text": "外にいるとき、私はそれを持っています"}, {"type": "subtitle", "time": 3033.589, "timestamp": "00:50:33", "text": "外。水。水。公平。私はまだ"}, {"type": "subtitle", "time": 3036.069, "timestamp": "00:50:36", "text": "巨大なものを持っているようなものを持っているなら、"}, {"type": "subtitle", "time": 3038.23, "timestamp": "00:50:38", "text": "みんな聞こえるよ、僕は巨大な"}, {"type": "subtitle", "time": 3041.27, "timestamp": "00:50:41", "text": "私のすぐ隣にある2.5リットルの水差し"}, {"type": "subtitle", "time": 3044.549, "timestamp": "00:50:44", "text": "私はこれを使って飲みます。私は水が好きです。うん、"}, {"type": "subtitle", "time": 3047.109, "timestamp": "00:50:47", "text": "時にはカフェインでエネルギーをチャージする必要がある。"}, {"type": "subtitle", "time": 3049.03, "timestamp": "00:50:49", "text": "なあ、俺が大学に行くときはいつでも、"}, {"type": "subtitle", "time": 3051.79, "timestamp": "00:50:51", "text": "大学に行くときはいつでも、私はいつも"}, {"type": "subtitle", "time": 3054.71, "timestamp": "00:50:54", "text": "エナジードリンクを買う。 2つあります"}, {"type": "subtitle", "time": 3056.309, "timestamp": "00:50:56", "text": "ここの安いエナジードリンクは"}, {"type": "subtitle", "time": 3058.95, "timestamp": "00:50:58", "text": "フィリピン。それはコブラか"}]
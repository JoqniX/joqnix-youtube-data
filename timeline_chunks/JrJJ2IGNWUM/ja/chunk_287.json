[{"type": "subtitle", "time": 17220.27, "timestamp": "04:47:00", "text": "えっと、ちょっと待って"}, {"type": "subtitle", "time": 17224.948, "timestamp": "04:47:04", "text": "上。えっと、今日は2025年6月1日午前2時30分です。"}, {"type": "subtitle", "time": 17228.47, "timestamp": "04:47:08", "text": "というわけで、日曜日です。ああ、土曜日。私は持っている"}, {"type": "subtitle", "time": 17231.83, "timestamp": "04:47:11", "text": "立ち入り禁止。何てことだ。土曜日は"}, {"type": "subtitle", "time": 17233.15, "timestamp": "04:47:13", "text": "3つのコラボレーション"}, {"type": "subtitle", "time": 17235.51, "timestamp": "04:47:15", "text": "日。何てことだ。大丈夫。大丈夫。"}, {"type": "subtitle", "time": 17237.31, "timestamp": "04:47:17", "text": "大丈夫です。その"}, {"type": "subtitle", "time": 17240.708, "timestamp": "04:47:20", "text": "大丈夫。くそ。"}, {"type": "subtitle", "time": 17244.36, "timestamp": "04:47:24", "text": "えっと、これは2時30分からです"}, {"type": "subtitle", "time": 17245.47, "timestamp": "04:47:25", "text": "[音楽]"}, {"type": "subtitle", "time": 17248.31, "timestamp": "04:47:28", "text": "午前。土曜日のコラボレーションはイマイチ。最後"}, {"type": "subtitle", "time": 17249.47, "timestamp": "04:47:29", "text": "土曜日は"}, {"type": "subtitle", "time": 17252.91, "timestamp": "04:47:32", "text": "それもいいですね。ああ、でもそれは"}, {"type": "subtitle", "time": 17255.83, "timestamp": "04:47:35", "text": "わかった。わかった。あ、待って。いや、待って。所有"}, {"type": "subtitle", "time": 17258.99, "timestamp": "04:47:38", "text": "上。ちょっと待って。彼女は確認しなかった"}, {"type": "subtitle", "time": 17260.99, "timestamp": "04:47:40", "text": "まだ。おお、"}, {"type": "subtitle", "time": 17264.628, "timestamp": "04:47:44", "text": "待って。サット ああ、待って。何てことだ。待って。"}, {"type": "subtitle", "time": 17266.59, "timestamp": "04:47:46", "text": "土曜日だったら"}, {"type": "subtitle", "time": 17271.19, "timestamp": "04:47:51", "text": "4～5つのコラボレーションになる？あ、待って。"}, {"type": "subtitle", "time": 17274.19, "timestamp": "04:47:54", "text": "PST出身の人がいる"}, {"type": "subtitle", "time": 17278.47, "timestamp": "04:47:58", "text": "えっと、タイムゾーン。ああ、それは10時か11時くらいですね。"}]
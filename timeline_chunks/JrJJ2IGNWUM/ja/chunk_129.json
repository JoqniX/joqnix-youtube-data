[{"type": "subtitle", "time": 7774.55, "timestamp": "02:09:34", "text": "それ。次の試合でやります。もし私が"}, {"type": "subtitle", "time": 7777.91, "timestamp": "02:09:37", "text": "ショットガンをください。だから、このマッシュは"}, {"type": "subtitle", "time": 7779.87, "timestamp": "02:09:39", "text": "この試合では、"}, {"type": "subtitle", "time": 7788.03, "timestamp": "02:09:48", "text": "[音楽]"}, {"type": "subtitle", "time": 7799.47, "timestamp": "02:09:59", "text": "フレーム？少しピークに達した"}]
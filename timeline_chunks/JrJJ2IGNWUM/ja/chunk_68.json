[{"type": "subtitle", "time": 4081.589, "timestamp": "01:08:01", "text": "通常、カビは発生しません。"}, {"type": "subtitle", "time": 4083.15, "timestamp": "01:08:03", "text": "私たちはそれを"}, {"type": "subtitle", "time": 4085.75, "timestamp": "01:08:05", "text": "冷凍庫。冷凍庫に入れて"}, {"type": "subtitle", "time": 4087.309, "timestamp": "01:08:07", "text": "カビが生えるのを防ぎ、そのような"}, {"type": "subtitle", "time": 4089.43, "timestamp": "01:08:09", "text": "くそっ。でも、本当に"}, {"type": "subtitle", "time": 4091.75, "timestamp": "01:08:11", "text": "一度入れたらトーストするのが面倒です"}, {"type": "subtitle", "time": 4094.95, "timestamp": "01:08:14", "text": "冷凍庫。とにかくクソが多すぎる"}, {"type": "subtitle", "time": 4098.11, "timestamp": "01:08:18", "text": "濡れていてとても難しい"}, {"type": "subtitle", "time": 4100.149, "timestamp": "01:08:20", "text": "トースト。皆さんはどうですか？君たちは"}, {"type": "subtitle", "time": 4102.47, "timestamp": "01:08:22", "text": "パンを冷蔵庫に入れるか、"}, {"type": "subtitle", "time": 4104.229, "timestamp": "01:08:24", "text": "冷凍庫？なぜなら私たちはそれを"}, {"type": "subtitle", "time": 4106.43, "timestamp": "01:08:26", "text": "冷凍庫へ今すぐ。"}, {"type": "subtitle", "time": 4108.709, "timestamp": "01:08:28", "text": "それを入れたら驚くことではない"}, {"type": "subtitle", "time": 4111.669, "timestamp": "01:08:31", "text": "外にある冷凍庫？"}, {"type": "subtitle", "time": 4113.749, "timestamp": "01:08:33", "text": "いいえ、驚くべきことにまだ味がします"}, {"type": "subtitle", "time": 4116.229, "timestamp": "01:08:36", "text": "同じ。長持ちするのは、私たちがそれを経験してきたからです"}, {"type": "subtitle", "time": 4117.669, "timestamp": "01:08:37", "text": "私たちはそのパンを10年以上持っています"}, {"type": "subtitle", "time": 4120.229, "timestamp": "01:08:40", "text": "もう3ヶ月だよ、相棒。そしてそれはそうではない"}, {"type": "subtitle", "time": 4122.47, "timestamp": "01:08:42", "text": "成形された。それはただ凍っていただけだった。その後"}, {"type": "subtitle", "time": 4123.829, "timestamp": "01:08:43", "text": "いつでも温めたいときは"}, {"type": "subtitle", "time": 4125.269, "timestamp": "01:08:45", "text": "もう一度言いますが、私たちはそれを中に入れるだけです"}, {"type": "subtitle", "time": 4128.229, "timestamp": "01:08:48", "text": "トースターオーブンを使えば、あとは問題なく使えます。"}, {"type": "subtitle", "time": 4134.55, "timestamp": "01:08:54", "text": "やあ、ランビ。でも、そう、だから私は"}, {"type": "subtitle", "time": 4137.51, "timestamp": "01:08:57", "text": "確認中。また、アディ・R・ネギ、私は"}]
[{"type": "subtitle", "time": 3660.069, "timestamp": "01:01:00", "text": "甘みの方へ。これが私たちが"}, {"type": "subtitle", "time": 3663.349, "timestamp": "01:01:03", "text": "何にでもバナナケチャップを。そして、"}, {"type": "subtitle", "time": 3666.15, "timestamp": "01:01:06", "text": "バナナケチャップをたっぷり。何？ええ、私たちは"}, {"type": "subtitle", "time": 3668.47, "timestamp": "01:01:08", "text": "バナナケチャップがあります。うん、まるで"}, {"type": "subtitle", "time": 3670.87, "timestamp": "01:01:10", "text": "辛いか甘いか。いや、いや、最高だよ"}, {"type": "subtitle", "time": 3674.95, "timestamp": "01:01:14", "text": "甘い。すごくすごく甘い。おお。"}, {"type": "subtitle", "time": 3677.03, "timestamp": "01:01:17", "text": "おお。色付きのものを覚えていますか"}, {"type": "subtitle", "time": 3679.109, "timestamp": "01:01:19", "text": "ケチャップ？"}, {"type": "subtitle", "time": 3681.03, "timestamp": "01:01:21", "text": "私はそうだったと思います。あなたはそれらのいずれかを使用しましたか？"}, {"type": "subtitle", "time": 3682.39, "timestamp": "01:01:22", "text": "前に？以前にそれらを使用したことがありますか?"}, {"type": "subtitle", "time": 3684.39, "timestamp": "01:01:24", "text": "あなたはもっと若かった？うん。ええ、覚えています"}, {"type": "subtitle", "time": 3687.03, "timestamp": "01:01:27", "text": "それらを使用する。うん。"}, {"type": "subtitle", "time": 3688.47, "timestamp": "01:01:28", "text": "それらを使っていた時のことを覚えているよ、"}, {"type": "subtitle", "time": 3692.39, "timestamp": "01:01:32", "text": "なんでこれ、お尻みたいな味がするんだろう？"}, {"type": "subtitle", "time": 3694.069, "timestamp": "01:01:34", "text": "だって、実際には果物が入っていなかったから"}, {"type": "subtitle", "time": 3696.39, "timestamp": "01:01:36", "text": "ケチャップ味、だってそれが私たちだから"}, {"type": "subtitle", "time": 3698.23, "timestamp": "01:01:38", "text": "フィリピンではよく使われていました。だから私は"}, {"type": "subtitle", "time": 3700.71, "timestamp": "01:01:40", "text": "なんでこれ、お尻みたいな味がするんだろう？"}, {"type": "subtitle", "time": 3703.109, "timestamp": "01:01:43", "text": "食べ物みたいなものか分からないけど"}, {"type": "subtitle", "time": 3705.829, "timestamp": "01:01:45", "text": "彼らがそれに加えた着色料は、私が"}, {"type": "subtitle", "time": 3707.51, "timestamp": "01:01:47", "text": "普通のケチャップの味を知ってるだろ"}, {"type": "subtitle", "time": 3711.15, "timestamp": "01:01:51", "text": "のように。それはトマトです。それでおしまい。うん。しかし"}, {"type": "subtitle", "time": 3714.47, "timestamp": "01:01:54", "text": "まるであの変な色の味を味わうみたいだ"}, {"type": "subtitle", "time": 3717.63, "timestamp": "01:01:57", "text": "いや、とにかく分からない。それ"}, {"type": "subtitle", "time": 3719.91, "timestamp": "01:01:59", "text": "感じた。私だけなのかどうかわからない。あなた"}]
[{"type": "subtitle", "time": 17105.11, "timestamp": "04:45:05", "text": "いや、私は彼らのオープンなオープンに参加した"}, {"type": "subtitle", "time": 17106.868, "timestamp": "04:45:06", "text": "リポジトリのコラボレーションですよね？うん。うん。うん。"}, {"type": "subtitle", "time": 17110.39, "timestamp": "04:45:10", "text": "そして私は良い日本のユーチューバーを見つけました"}, {"type": "subtitle", "time": 17112.99, "timestamp": "04:45:12", "text": "英語も上手です"}, {"type": "subtitle", "time": 17116.07, "timestamp": "04:45:16", "text": "ハリサンの協力者やその他すべて。"}, {"type": "subtitle", "time": 17118.708, "timestamp": "04:45:18", "text": "だから、もし彼らが"}, {"type": "subtitle", "time": 17120.55, "timestamp": "04:45:20", "text": "下がっているかもしれないので、"}, {"type": "subtitle", "time": 17123.11, "timestamp": "04:45:23", "text": "何かだけど、今の数字は"}, {"type": "subtitle", "time": 17126.788, "timestamp": "04:45:26", "text": "怖いけど、私はそうするべきだ、そうするべきだ"}, {"type": "subtitle", "time": 17131.15, "timestamp": "04:45:31", "text": "大丈夫、勇気を出して"}, {"type": "subtitle", "time": 17133.99, "timestamp": "04:45:33", "text": "コラボしたいですか？"}, {"type": "subtitle", "time": 17136.43, "timestamp": "04:45:36", "text": "何か一緒に、あるいは何か。"}, {"type": "subtitle", "time": 17141.19, "timestamp": "04:45:41", "text": "うん。ええ、そうですね、私は"}, {"type": "subtitle", "time": 17145.23, "timestamp": "04:45:45", "text": "6月から6月第1週までのスピードラン"}, {"type": "subtitle", "time": 17147.99, "timestamp": "04:45:47", "text": "もの。人を詰め込む。"}, {"type": "subtitle", "time": 17150.708, "timestamp": "04:45:50", "text": "水曜日と金曜日と木曜日"}, {"type": "subtitle", "time": 17154.15, "timestamp": "04:45:54", "text": "一つは、それが確認されていないと思うということです。えっと"}, {"type": "subtitle", "time": 17156.31, "timestamp": "04:45:56", "text": "なぜなら私は手を伸ばすことができないから"}, {"type": "subtitle", "time": 17158.868, "timestamp": "04:45:58", "text": "もはや人間ではない。理由はわからないけど、"}]
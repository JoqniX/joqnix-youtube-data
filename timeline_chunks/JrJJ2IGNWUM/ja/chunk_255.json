[{"type": "subtitle", "time": 15313.189, "timestamp": "04:15:13", "text": "俺はこれをやる、このゲームで彼らにやる"}, {"type": "subtitle", "time": 15315.75, "timestamp": "04:15:15", "text": "最後の試合になるから"}, {"type": "subtitle", "time": 15329.59, "timestamp": "04:15:29", "text": "[音楽]"}, {"type": "subtitle", "time": 15332.149, "timestamp": "04:15:32", "text": "私たちは、私が"}, {"type": "subtitle", "time": 15346.13, "timestamp": "04:15:46", "text": "礼拝の時間"}, {"type": "subtitle", "time": 15352.95, "timestamp": "04:15:52", "text": "ピュー。このプレイヤーのスキルは何ですか？"}, {"type": "subtitle", "time": 15356.87, "timestamp": "04:15:56", "text": "配布はもう一度行いますか？それはあなたに"}, {"type": "subtitle", "time": 15359.75, "timestamp": "04:15:59", "text": "人々がどれくらいランク付けされているかといったアイデア"}]
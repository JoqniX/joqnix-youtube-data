[{"type": "subtitle", "time": 6183.28, "timestamp": "01:43:03", "text": "世界についてもっと知りたい 最後に、それらすべてをきちんと終わらせてください。うん、"}, {"type": "subtitle", "time": 6186.239, "timestamp": "01:43:06", "text": "最後に、それらすべてをきちんと終わらせてください。うん、 彼らは多くのことを逃してしまった。"}, {"type": "subtitle", "time": 6188.88, "timestamp": "01:43:08", "text": "彼らは多くのことを逃してしまった。 うん。"}, {"type": "subtitle", "time": 6196.149, "timestamp": "01:43:16", "text": "うん、私としてはたぶん作りたい"}, {"type": "subtitle", "time": 6200.31, "timestamp": "01:43:20", "text": "えっと、スティーブにはこうあってほしいな"}, {"type": "subtitle", "time": 6203.109, "timestamp": "01:43:23", "text": "おかしな楽しいキャラクターですが、とても"}, {"type": "subtitle", "time": 6205.75, "timestamp": "01:43:25", "text": "彼は自分の仕事に有能だ。"}, {"type": "subtitle", "time": 6208.87, "timestamp": "01:43:28", "text": "そして私はアレックスに"}, {"type": "subtitle", "time": 6211.99, "timestamp": "01:43:31", "text": "えーと、面白い女の子で、しかも超"}, {"type": "subtitle", "time": 6214.07, "timestamp": "01:43:34", "text": "有能な、"}, {"type": "subtitle", "time": 6215.99, "timestamp": "01:43:35", "text": "でも自分のやりたいことをしたいだけ"}, {"type": "subtitle", "time": 6218.55, "timestamp": "01:43:38", "text": "スティーブに邪魔されずに。そして"}, {"type": "subtitle", "time": 6220.87, "timestamp": "01:43:40", "text": "彼らはただ奇妙な冒険に出かけるだけです"}, {"type": "subtitle", "time": 6223.669, "timestamp": "01:43:43", "text": "「ああ、いや、そこには、そこには"}, {"type": "subtitle", "time": 6226.07, "timestamp": "01:43:46", "text": "ゾンビの大群が我々を襲ってくる。素早い、"}, {"type": "subtitle", "time": 6228.99, "timestamp": "01:43:48", "text": "シェルターを作る。私はすでにTNTを作りました"}, {"type": "subtitle", "time": 6231.43, "timestamp": "01:43:51", "text": "大砲。」そういう類のもので、"}, {"type": "subtitle", "time": 6234.55, "timestamp": "01:43:54", "text": "すごくすごくランダムで、ちょっとおかしな感じ"}, {"type": "subtitle", "time": 6236.95, "timestamp": "01:43:56", "text": "そしてそれは彼らのレベルを示している"}, {"type": "subtitle", "time": 6239.03, "timestamp": "01:43:59", "text": "彼らがいる世界に対する熟達。"}]
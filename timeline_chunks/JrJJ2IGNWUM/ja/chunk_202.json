[{"type": "subtitle", "time": 12123.51, "timestamp": "03:22:03", "text": "ニース。見て、ベイビー。下降中。さあ、使って"}, {"type": "subtitle", "time": 12131.19, "timestamp": "03:22:11", "text": "なあ、アミチ、俺たちは同じ状況にいるんだぞ。"}, {"type": "subtitle", "time": 12132.95, "timestamp": "03:22:12", "text": "さあ行こう。"}, {"type": "subtitle", "time": 12135.15, "timestamp": "03:22:15", "text": "私は思う"}, {"type": "subtitle", "time": 12139.99, "timestamp": "03:22:19", "text": "複数のチーム。はい。パーティーがあるよ"}, {"type": "subtitle", "time": 12144.63, "timestamp": "03:22:24", "text": "競合する政党の政党。ああ、神様。おお"}, {"type": "subtitle", "time": 12155.11, "timestamp": "03:22:35", "text": "どういうわけか、それよりもさらに美しい"}, {"type": "subtitle", "time": 12170.469, "timestamp": "03:22:50", "text": "ああ、大変だ。"}]
[{"type": "subtitle", "time": 9667.59, "timestamp": "02:41:07", "text": "もの。夕食は美味しかった。眠いです。"}, {"type": "subtitle", "time": 9672.11, "timestamp": "02:41:12", "text": "まあ、そうですね。わかった。えっと、接続させてください"}, {"type": "subtitle", "time": 9676.55, "timestamp": "02:41:16", "text": "ストリーム。こんにちは。 ３、２、１。こんにちは"}, {"type": "subtitle", "time": 9679.91, "timestamp": "02:41:19", "text": "みんな。今日は最後の部分として"}, {"type": "subtitle", "time": 9683.75, "timestamp": "02:41:23", "text": "ヨアトン79日目のパート2では、"}, {"type": "subtitle", "time": 9687.75, "timestamp": "02:41:27", "text": "マランを最後の協力者として迎え、"}, {"type": "subtitle", "time": 9692.79, "timestamp": "02:41:32", "text": "その日。こんにちは、マラン。こんにちは。"}, {"type": "subtitle", "time": 9700.95, "timestamp": "02:41:40", "text": "私たちにとっては初めてのことです"}, {"type": "subtitle", "time": 9704.79, "timestamp": "02:41:44", "text": "えっと、一緒にコラボレーションするんですよね？"}, {"type": "subtitle", "time": 9706.389, "timestamp": "02:41:46", "text": "はい。"}, {"type": "subtitle", "time": 9710.75, "timestamp": "02:41:50", "text": "はい、今回が初めてです。私は"}, {"type": "subtitle", "time": 9714.07, "timestamp": "02:41:54", "text": "興奮した。それでは、今日は"}]
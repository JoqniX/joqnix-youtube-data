[{"type": "subtitle", "time": 5040.99, "timestamp": "01:24:00", "text": "水が流れ落ちるような感じ"}, {"type": "subtitle", "time": 5043.03, "timestamp": "01:24:03", "text": "喉。だからそれは素晴らしいのです"}, {"type": "subtitle", "time": 5045.75, "timestamp": "01:24:05", "text": "スミノフを飲むのはめちゃくちゃ危険だ"}, {"type": "chat", "time": 5046.165, "timestamp": "01:24:06", "author": "@sadclipy", "avatar": "https://yt4.ggpht.com/NWvAEsOJEb9XkxRRhbuJXnXDMWtc2foWGBwLbBuCxWYqdOpSmqfbtNXfVgmn1YExqB7uWppD9A=s64-c-k-c0x00ffffff-no-rj", "message": "Hello"}, {"type": "subtitle", "time": 5049.35, "timestamp": "01:24:09", "text": "まるで水のようにスタミナが湧いてくるからだ。"}, {"type": "subtitle", "time": 5051.669, "timestamp": "01:24:11", "text": "そして焼酎を少し飲んだが、"}, {"type": "subtitle", "time": 5054.79, "timestamp": "01:24:14", "text": "本当に飲む。うん、焼酎。焼酎は"}, {"type": "subtitle", "time": 5056.47, "timestamp": "01:24:16", "text": "違う。うん。あなたはどうですか？何ですか"}, {"type": "subtitle", "time": 5059.35, "timestamp": "01:24:19", "text": "あなたのお気に入りの焼酎は？私は焼酎を飲んだことがないので"}, {"type": "subtitle", "time": 5062.149, "timestamp": "01:24:22", "text": "わからない。欲しい"}, {"type": "subtitle", "time": 5066.229, "timestamp": "01:24:26", "text": "一度焼酎を飲んで試してみたいです。"}, {"type": "subtitle", "time": 5068.229, "timestamp": "01:24:28", "text": "試してみてもいいかもしれません。高くない。私"}, {"type": "subtitle", "time": 5070.709, "timestamp": "01:24:30", "text": "試してみる価値はある。缶は高価ではない。"}, {"type": "subtitle", "time": 5073.59, "timestamp": "01:24:33", "text": "ああ。ああ、日本には美味しい焼酎がたくさんあるね。"}, {"type": "subtitle", "time": 5075.91, "timestamp": "01:24:35", "text": "はい。きっと何か見つかると思います"}, {"type": "subtitle", "time": 5077.91, "timestamp": "01:24:37", "text": "日本に行けばきっと気に入るよ。しかしその後"}, {"type": "subtitle", "time": 5080.31, "timestamp": "01:24:40", "text": "また、私と妻も行きたい"}, {"type": "subtitle", "time": 5082.79, "timestamp": "01:24:42", "text": "日本に行きたいけど、そこに住むつもりはない"}, {"type": "subtitle", "time": 5085.03, "timestamp": "01:24:45", "text": "なぜなら、私は話せないからです"}, {"type": "subtitle", "time": 5087.27, "timestamp": "01:24:47", "text": "言語。うん。正直に言うと、私はかなり"}, {"type": "subtitle", "time": 5089.03, "timestamp": "01:24:49", "text": "もちろん、あなたが応募しようとしたら"}, {"type": "subtitle", "time": 5090.47, "timestamp": "01:24:50", "text": "英語の先生がそこにいる、それはまるで"}, {"type": "subtitle", "time": 5092.07, "timestamp": "01:24:52", "text": "試用期間中。実際には理解できない"}, {"type": "chat", "time": 5093.311, "timestamp": "01:24:53", "author": "@sadclipy", "avatar": "https://yt4.ggpht.com/NWvAEsOJEb9XkxRRhbuJXnXDMWtc2foWGBwLbBuCxWYqdOpSmqfbtNXfVgmn1YExqB7uWppD9A=s64-c-k-c0x00ffffff-no-rj", "message": "I would rather drink coffee than alcohol. COFFEE is alcohol for me :>"}, {"type": "subtitle", "time": 5094.07, "timestamp": "01:24:54", "text": "フルタイムの仕事。あなたは"}, {"type": "subtitle", "time": 5097.03, "timestamp": "01:24:57", "text": "実際の適切な言葉遣いは、"}, {"type": "subtitle", "time": 5098.629, "timestamp": "01:24:58", "text": "プロフェッショナルな環境で皆と一緒に没頭する"}]
[{"type": "subtitle", "time": 14823.269, "timestamp": "04:07:03", "text": "これは私にはわからない"}, {"type": "subtitle", "time": 14827.03, "timestamp": "04:07:07", "text": "サーバーに問題が発生し、"}, {"type": "subtitle", "time": 14828.429, "timestamp": "04:07:08", "text": "そこには"}, {"type": "subtitle", "time": 14831.91, "timestamp": "04:07:11", "text": "そこにアップロードがあります"}, {"type": "subtitle", "time": 14833.83, "timestamp": "04:07:13", "text": "それなら大丈夫、彼らは"}, {"type": "subtitle", "time": 14846.75, "timestamp": "04:07:26", "text": "[音楽]"}, {"type": "subtitle", "time": 14865.03, "timestamp": "04:07:45", "text": "記憶とは恐ろしいものだ。心配しないで、"}, {"type": "subtitle", "time": 14877.269, "timestamp": "04:07:57", "text": "[音楽]"}, {"type": "subtitle", "time": 14879.83, "timestamp": "04:07:59", "text": "ああ、彼はクールな肌をしている、"}]
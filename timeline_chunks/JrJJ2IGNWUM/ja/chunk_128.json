[{"type": "subtitle", "time": 7681.83, "timestamp": "02:08:01", "text": "これを買います。気にしないでください。しないで"}, {"type": "subtitle", "time": 7689.51, "timestamp": "02:08:09", "text": "だが、我々は全員を殺した。"}, {"type": "subtitle", "time": 7692.99, "timestamp": "02:08:12", "text": "私たちはそうだったのでしょうか？わかった。感謝"}, {"type": "subtitle", "time": 7696.55, "timestamp": "02:08:16", "text": "神。私の友達の何人かは"}, {"type": "subtitle", "time": 7699.87, "timestamp": "02:08:19", "text": "えっと、ズキは95年くらい"}, {"type": "subtitle", "time": 7705.35, "timestamp": "02:08:25", "text": "95%も同様です。うん。ズキもまたダッシュです。"}, {"type": "subtitle", "time": 7716.51, "timestamp": "02:08:36", "text": "ドラゴン。私"}]
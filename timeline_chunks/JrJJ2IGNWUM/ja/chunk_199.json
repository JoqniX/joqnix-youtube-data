[{"type": "subtitle", "time": 11940.429, "timestamp": "03:19:00", "text": "私の"}, {"type": "subtitle", "time": 11944.71, "timestamp": "03:19:04", "text": "神。どこに"}, {"type": "subtitle", "time": 11960.07, "timestamp": "03:19:20", "text": "彼はどこにいますか？彼らに見せないで"}, {"type": "subtitle", "time": 11963.83, "timestamp": "03:19:23", "text": "ここ。私が担当します。"}, {"type": "subtitle", "time": 11969.67, "timestamp": "03:19:29", "text": "後ろに下がれ。"}, {"type": "subtitle", "time": 11972.469, "timestamp": "03:19:32", "text": "いいえ。"}, {"type": "subtitle", "time": 11976.55, "timestamp": "03:19:36", "text": "ロックされています。下。ねえ、レベルアップしたよ。しなければならない"}, {"type": "subtitle", "time": 11978.469, "timestamp": "03:19:38", "text": "アップグレードを選択してください。彼らは手に入れていない"}, {"type": "subtitle", "time": 11981.03, "timestamp": "03:19:41", "text": "戻る。私たちは"}, {"type": "subtitle", "time": 11983.429, "timestamp": "03:19:43", "text": "勝利。"}, {"type": "subtitle", "time": 11985.83, "timestamp": "03:19:45", "text": "アップグレードしました。これはどこですか？"}, {"type": "subtitle", "time": 11988.63, "timestamp": "03:19:48", "text": "ルートボックス？"}, {"type": "subtitle", "time": 11995.95, "timestamp": "03:19:55", "text": "おお"}]
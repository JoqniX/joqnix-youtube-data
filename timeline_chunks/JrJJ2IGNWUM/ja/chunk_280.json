[{"type": "subtitle", "time": 16801.39, "timestamp": "04:40:01", "text": "あれ。彼女は6月にここに来る予定です"}, {"type": "subtitle", "time": 16805.07, "timestamp": "04:40:05", "text": "おそらく。私は彼女にDMを送りました"}, {"type": "subtitle", "time": 16808.788, "timestamp": "04:40:08", "text": "インスタグラム。うん。そして禅が訪れる"}, {"type": "subtitle", "time": 16812.31, "timestamp": "04:40:12", "text": "それも近づいています。それからプロ・スターケープ"}, {"type": "subtitle", "time": 16816.55, "timestamp": "04:40:16", "text": "メンバーも少しの間。いや、私は"}, {"type": "subtitle", "time": 16822.59, "timestamp": "04:40:22", "text": "えっと、"}, {"type": "subtitle", "time": 16825.91, "timestamp": "04:40:25", "text": "ノヴァ。いいえ、まだです。えっと、彼はまだ"}, {"type": "subtitle", "time": 16830.19, "timestamp": "04:40:30", "text": "私に確認してください。ノヴァ、ゼン。"}, {"type": "subtitle", "time": 16834.55, "timestamp": "04:40:34", "text": "ええと、ゼン、ええと、サラスティア、カイラ、それら"}, {"type": "subtitle", "time": 16836.43, "timestamp": "04:40:36", "text": "人々が手に入れに行く"}, {"type": "subtitle", "time": 16839.91, "timestamp": "04:40:39", "text": "彼ら。えっと、ちゃんとした"}, {"type": "subtitle", "time": 16841.59, "timestamp": "04:40:41", "text": "セレスティアとコラボレーションしたことがないから、"}, {"type": "subtitle", "time": 16844.708, "timestamp": "04:40:44", "text": "初めての方。うん、カイラもみんなそうだよ。私"}, {"type": "subtitle", "time": 16847.59, "timestamp": "04:40:47", "text": "以前、彼女とソロでコラボレーションしたことがある。"}, {"type": "subtitle", "time": 16849.51, "timestamp": "04:40:49", "text": "うん。うん。"}, {"type": "subtitle", "time": 16851.47, "timestamp": "04:40:51", "text": "次にケースライン"}, {"type": "subtitle", "time": 16855.43, "timestamp": "04:40:55", "text": "サスリは私が誰なのか興味を持っていた"}]
[{"type": "subtitle", "time": 6660.31, "timestamp": "01:51:00", "text": "ショートヘアで性格が良い。うん、"}, {"type": "subtitle", "time": 6662.95, "timestamp": "01:51:02", "text": "準備できました。"}, {"type": "subtitle", "time": 6666.229, "timestamp": "01:51:06", "text": "おてんば娘かもしれない"}, {"type": "subtitle", "time": 6667.99, "timestamp": "01:51:07", "text": "赤毛、背の低い人について考えるといつも"}, {"type": "subtitle", "time": 6670.47, "timestamp": "01:51:10", "text": "髪と良い性格、私は"}, {"type": "subtitle", "time": 6679.03, "timestamp": "01:51:19", "text": "そう、おてんば娘。うん。ああ、やっぱりね。私"}, {"type": "subtitle", "time": 6681.669, "timestamp": "01:51:21", "text": "知ってたよ。"}, {"type": "subtitle", "time": 6683.83, "timestamp": "01:51:23", "text": "でも、トンバのいくつかは"}, {"type": "subtitle", "time": 6686.79, "timestamp": "01:51:26", "text": "それほど大げさではなく、"}, {"type": "subtitle", "time": 6688.709, "timestamp": "01:51:28", "text": "ロマンチックなとき"}, {"type": "subtitle", "time": 6691.35, "timestamp": "01:51:31", "text": "彼らとの瞬間は、えっと、何だっけ"}, {"type": "subtitle", "time": 6695.109, "timestamp": "01:51:35", "text": "電話した？まるで情熱的に空気を吸っているかのようだ"}, {"type": "subtitle", "time": 6697.27, "timestamp": "01:51:37", "text": "そして彼らは過度に派手な振る舞いをしていない。"}, {"type": "subtitle", "time": 6699.27, "timestamp": "01:51:39", "text": "あまり派手ではなく少年っぽい"}, {"type": "subtitle", "time": 6701.27, "timestamp": "01:51:41", "text": "彼らの物事の対処の仕方に関して。まるで"}, {"type": "subtitle", "time": 6703.51, "timestamp": "01:51:43", "text": "ほんのひと時の静寂が訪れる"}, {"type": "subtitle", "time": 6705.31, "timestamp": "01:51:45", "text": "ぶらぶらする"}, {"type": "subtitle", "time": 6708.47, "timestamp": "01:51:48", "text": "好きな人と一緒"}, {"type": "subtitle", "time": 6710.47, "timestamp": "01:51:50", "text": "兄弟みたいなもんだよ、わかるだろ？"}, {"type": "subtitle", "time": 6713.03, "timestamp": "01:51:53", "text": "だからそれは別のレベルの"}, {"type": "subtitle", "time": 6715.83, "timestamp": "01:51:55", "text": "彼らとの親密さ。それは分かります"}, {"type": "subtitle", "time": 6718.79, "timestamp": "01:51:58", "text": "正直に。うん。"}]
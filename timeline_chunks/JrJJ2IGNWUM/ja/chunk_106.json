[{"type": "subtitle", "time": 6360.55, "timestamp": "01:46:00", "text": "楽しさを表現し、レベルが好きです"}, {"type": "subtitle", "time": 6362.87, "timestamp": "01:46:02", "text": "スティーブが持っていた熟練度は、私が"}, {"type": "subtitle", "time": 6365.109, "timestamp": "01:46:05", "text": "その世界では、私はこう考えていました"}, {"type": "subtitle", "time": 6367.91, "timestamp": "01:46:07", "text": "すごく楽しかった。彼はキャラクターを際立たせる"}, {"type": "subtitle", "time": 6370.149, "timestamp": "01:46:10", "text": "異なるタイプの個人として"}, {"type": "subtitle", "time": 6371.669, "timestamp": "01:46:11", "text": "それは私が予想していなかったことでした。そして"}, {"type": "subtitle", "time": 6374.47, "timestamp": "01:46:14", "text": "それは私の予想を裏切ったし、そう、"}, {"type": "subtitle", "time": 6377.109, "timestamp": "01:46:17", "text": "どのように"}, {"type": "subtitle", "time": 6378.87, "timestamp": "01:46:18", "text": "ジャック・ブラックは実際にキャラクターを演じている"}, {"type": "subtitle", "time": 6382.31, "timestamp": "01:46:22", "text": "そして、私はそれが好きだ。本当に良いです。"}, {"type": "subtitle", "time": 6384.229, "timestamp": "01:46:24", "text": "キャラクター描写はただ"}, {"type": "subtitle", "time": 6386.07, "timestamp": "01:46:26", "text": "本当に良い。それはスティーブ・アイではない"}, {"type": "subtitle", "time": 6388.709, "timestamp": "01:46:28", "text": "想像する。頭とは違う"}, {"type": "subtitle", "time": 6391.79, "timestamp": "01:46:31", "text": "スティーブに対する私たちの多くからのキャノンですが、"}, {"type": "subtitle", "time": 6396.91, "timestamp": "01:46:36", "text": "近い感じですよね？うん。"}, {"type": "subtitle", "time": 6400.31, "timestamp": "01:46:40", "text": "アレックスを従順にして、"}, {"type": "subtitle", "time": 6402.87, "timestamp": "01:46:42", "text": "あなたのMinecraftで繁殖可能"}, {"type": "subtitle", "time": 6408.55, "timestamp": "01:46:48", "text": "わからない。"}, {"type": "subtitle", "time": 6412.07, "timestamp": "01:46:52", "text": "よし。そう、まさにそれだよ"}, {"type": "subtitle", "time": 6413.59, "timestamp": "01:46:53", "text": "彼はそうする。ほとんどのキャラクターは"}, {"type": "subtitle", "time": 6415.83, "timestamp": "01:46:55", "text": "彼自身であること。うん。右。楽しいよ。本物"}, {"type": "subtitle", "time": 6417.43, "timestamp": "01:46:57", "text": "質問。右。右。右。右。"}, {"type": "subtitle", "time": 6419.59, "timestamp": "01:46:59", "text": "問題はここだ。右。作りますか"}]
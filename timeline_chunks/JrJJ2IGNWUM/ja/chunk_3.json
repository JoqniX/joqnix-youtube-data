[{"type": "subtitle", "time": 181.55, "timestamp": "00:03:01", "text": "あの努力。"}, {"type": "subtitle", "time": 184.229, "timestamp": "00:03:04", "text": "はい。そしてあなたはレインボーシックスから始めました"}, {"type": "subtitle", "time": 187.309, "timestamp": "00:03:07", "text": "包囲。何てことだ、"}, {"type": "subtitle", "time": 190.39, "timestamp": "00:03:10", "text": "お前。私が覚えているのは、私たちの"}, {"type": "subtitle", "time": 199.11, "timestamp": "00:03:19", "text": "ああ、それはすごく昔のことだよ。私 私 私"}, {"type": "subtitle", "time": 201.43, "timestamp": "00:03:21", "text": "あまりにも長い間姿を消していた。私はしません"}, {"type": "subtitle", "time": 202.63, "timestamp": "00:03:22", "text": "一体何が起こったのか"}, {"type": "subtitle", "time": 203.76, "timestamp": "00:03:23", "text": "もう。"}, {"type": "subtitle", "time": 205.43, "timestamp": "00:03:25", "text": "[音楽]"}, {"type": "subtitle", "time": 208.869, "timestamp": "00:03:28", "text": "もうずいぶん時間が経ちましたね。それは私です"}, {"type": "subtitle", "time": 209.71, "timestamp": "00:03:29", "text": "まだ"}, {"type": "subtitle", "time": 213.50900000000001, "timestamp": "00:03:33", "text": "ヴァレラントの歯磨き粉を覚えていますか？"}, {"type": "subtitle", "time": 215.19, "timestamp": "00:03:35", "text": "ストリーム。"}, {"type": "subtitle", "time": 218.22899999999998, "timestamp": "00:03:38", "text": "ああ、そうだね。 Lのような人が"}, {"type": "subtitle", "time": 220.39, "timestamp": "00:03:40", "text": "損失を被った人や、その他何であれ、"}, {"type": "subtitle", "time": 222.47, "timestamp": "00:03:42", "text": "俺たちはショットを飲まなきゃいけない"}, {"type": "subtitle", "time": 224.71, "timestamp": "00:03:44", "text": "歯磨き粉のようなもの。ああ、それは、それは"}, {"type": "subtitle", "time": 227.11, "timestamp": "00:03:47", "text": "クレイジー。そんなくだらないこと全部。見せてください。"}, {"type": "subtitle", "time": 235.589, "timestamp": "00:03:55", "text": "とても楽しかった。それは神だった。私は欲しい"}, {"type": "subtitle", "time": 238.07, "timestamp": "00:03:58", "text": "もう一度やる。"}]
[{"type": "subtitle", "time": 5581.189, "timestamp": "01:33:01", "text": "正直に更新しました。うん。待って、"}, {"type": "subtitle", "time": 5583.27, "timestamp": "01:33:03", "text": "Unordinaryはアップデートされる予定ですか？"}, {"type": "subtitle", "time": 5586.07, "timestamp": "01:33:06", "text": "何？それが理由かどうかはわかりません"}, {"type": "subtitle", "time": 5588.629, "timestamp": "01:33:08", "text": "もう何ヶ月も経った。"}, {"type": "subtitle", "time": 5590.149, "timestamp": "01:33:10", "text": "アーティストがどれくらいの期間活動しているかはわかりません"}, {"type": "subtitle", "time": 5593.03, "timestamp": "01:33:13", "text": "彼女は休憩を取るつもりだが、"}, {"type": "subtitle", "time": 5594.47, "timestamp": "01:33:14", "text": "数ヶ月経ちましたが、"}, {"type": "subtitle", "time": 5597.35, "timestamp": "01:33:17", "text": "戻ってきて、実は怖いんです。私"}, {"type": "subtitle", "time": 5599.95, "timestamp": "01:33:19", "text": "物語を"}, {"type": "subtitle", "time": 5603.11, "timestamp": "01:33:23", "text": "続く。皆さんはどう思いますか？"}, {"type": "subtitle", "time": 5604.95, "timestamp": "01:33:24", "text": "待って、ちょっと待って。では、質問です。"}, {"type": "subtitle", "time": 5607.59, "timestamp": "01:33:27", "text": "どれ？普通ではない。その一つは"}, {"type": "subtitle", "time": 5610.07, "timestamp": "01:33:30", "text": "主人公の名前は"}, {"type": "subtitle", "time": 5611.43, "timestamp": "01:33:31", "text": "ジョン"}, {"type": "subtitle", "time": 5612.79, "timestamp": "01:33:32", "text": "[音楽]"}, {"type": "subtitle", "time": 5615.83, "timestamp": "01:33:35", "text": "そして彼は、まるで普通の人のように、"}, {"type": "subtitle", "time": 5618.07, "timestamp": "01:33:38", "text": "力はなかったが、驚いたことに"}, {"type": "subtitle", "time": 5620.629, "timestamp": "01:33:40", "text": "ネタバレ注意 彼は実際に力を持っていて"}, {"type": "subtitle", "time": 5622.629, "timestamp": "01:33:42", "text": "彼はただトラウマを抱えていて、それらを使うことができなかった"}, {"type": "subtitle", "time": 5624.47, "timestamp": "01:33:44", "text": "そういう類のもの"}, {"type": "subtitle", "time": 5631.27, "timestamp": "01:33:51", "text": "1つだけど、まあ、みんなはどう思う？"}, {"type": "subtitle", "time": 5636.03, "timestamp": "01:33:56", "text": "考えはメディアの一形態のようなものか、"}, {"type": "subtitle", "time": 5639.39, "timestamp": "01:33:59", "text": "一般的に考えられているもの"}]
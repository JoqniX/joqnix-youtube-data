[{"type": "subtitle", "time": 10022.51, "timestamp": "02:47:02", "text": "節度は"}, {"type": "subtitle", "time": 10024.03, "timestamp": "02:47:04", "text": "声"}, {"type": "subtitle", "time": 10026.91, "timestamp": "02:47:06", "text": "チャットのみ"}, {"type": "subtitle", "time": 10033.11, "timestamp": "02:47:13", "text": "チャットを管理するなんて、それはとても悪いことだ"}, {"type": "subtitle", "time": 10035.79, "timestamp": "02:47:15", "text": "もしあなたが"}, {"type": "subtitle", "time": 10038.87, "timestamp": "02:47:18", "text": "黙れと言った"}, {"type": "subtitle", "time": 10045.03, "timestamp": "02:47:25", "text": "そうすれば、フラグが立てられたり、アカウントが停止されたりする可能性があります。"}, {"type": "subtitle", "time": 10051.03, "timestamp": "02:47:31", "text": "いつか、spu と言ったり、"}, {"type": "subtitle", "time": 10054.39, "timestamp": "02:47:34", "text": "アカウント停止処分を受けることになるよ。ああ、"}, {"type": "subtitle", "time": 10056.51, "timestamp": "02:47:36", "text": "[音楽]"}, {"type": "subtitle", "time": 10072.79, "timestamp": "02:47:52", "text": "うわー、私はマイクを使うのが怖いんです"}, {"type": "subtitle", "time": 10076.51, "timestamp": "02:47:56", "text": "私がマイクを使うと、周りの人が攻撃的になる。そして私は"}]
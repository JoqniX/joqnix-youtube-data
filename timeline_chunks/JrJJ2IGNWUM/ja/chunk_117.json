[{"type": "subtitle", "time": 7026.51, "timestamp": "01:57:06", "text": "こんにちは、寿司でした"}, {"type": "subtitle", "time": 7028.03, "timestamp": "01:57:08", "text": "別名"}, {"type": "subtitle", "time": 7031.83, "timestamp": "01:57:11", "text": "レニール。本日はありがとうございました。そうだった"}, {"type": "subtitle", "time": 7034.229, "timestamp": "01:57:14", "text": "話したり一緒に過ごしたりするのが本当に楽しい"}, {"type": "subtitle", "time": 7036.709, "timestamp": "01:57:16", "text": "寿司。私たちはたくさん話しました。実際に"}, {"type": "subtitle", "time": 7039.75, "timestamp": "01:57:19", "text": "たくさん話した。そして私は実際、"}, {"type": "subtitle", "time": 7041.99, "timestamp": "01:57:21", "text": "正直言って、楽しんでいます。プラス、"}, {"type": "subtitle", "time": 7044.629, "timestamp": "01:57:24", "text": "また、それを楽しんでいる間、私はとても"}, {"type": "subtitle", "time": 7049.189, "timestamp": "01:57:29", "text": "少ししか飲んでいないので眠い"}, {"type": "subtitle", "time": 7052.95, "timestamp": "01:57:32", "text": "寝る。えっと、今日はたった15分か"}, {"type": "subtitle", "time": 7057.189, "timestamp": "01:57:37", "text": "何か。まあ、そういう側面もあるよね。そして"}, {"type": "subtitle", "time": 7061.03, "timestamp": "01:57:41", "text": "えーと、次はマランです。私たちは"}, {"type": "subtitle", "time": 7064.07, "timestamp": "01:57:44", "text": "11時までに彼女とコラボする予定。"}, {"type": "subtitle", "time": 7066.39, "timestamp": "01:57:46", "text": "彼女に、もしよければ"}, {"type": "subtitle", "time": 7069.51, "timestamp": "01:57:49", "text": "11時に延期する、という感じですね。"}, {"type": "subtitle", "time": 7071.83, "timestamp": "01:57:51", "text": "Apexを持っている。私たちはApexをプレイし、"}, {"type": "subtitle", "time": 7074.31, "timestamp": "01:57:54", "text": "話し合いましょう。ええ、うまくいけば"}, {"type": "subtitle", "time": 7076.629, "timestamp": "01:57:56", "text": "話している。初めて"}, {"type": "subtitle", "time": 7079.75, "timestamp": "01:57:59", "text": "マリサと初めてコラボレーション"}]
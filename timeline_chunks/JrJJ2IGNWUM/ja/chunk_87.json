[{"type": "subtitle", "time": 5220.79, "timestamp": "01:27:00", "text": "それ。でも話すこと、実際には話すことではない"}, {"type": "subtitle", "time": 5222.79, "timestamp": "01:27:02", "text": "声に出して。ええ、それは理解できます。"}, {"type": "subtitle", "time": 5224.39, "timestamp": "01:27:04", "text": "お前。"}, {"type": "subtitle", "time": 5226.87, "timestamp": "01:27:06", "text": "でも、少なくとも今は理解できたでしょう。私は"}, {"type": "subtitle", "time": 5229.03, "timestamp": "01:27:09", "text": "お前が実際に文章を読めるから嫉妬してるんだよ"}, {"type": "subtitle", "time": 5232.55, "timestamp": "01:27:12", "text": "今。うん、日本語が読めたらいいのに。"}, {"type": "subtitle", "time": 5233.91, "timestamp": "01:27:13", "text": "だから私は人が"}, {"type": "subtitle", "time": 5236.629, "timestamp": "01:27:16", "text": "翻訳してくれよ。そして私は"}, {"type": "subtitle", "time": 5238.79, "timestamp": "01:27:18", "text": "種類ではない。問題はここですよね？私"}, {"type": "subtitle", "time": 5242.189, "timestamp": "01:27:22", "text": "私は人が作るのが好きです"}, {"type": "subtitle", "time": 5244.07, "timestamp": "01:27:24", "text": "翻訳。よし、これは熱い"}, {"type": "subtitle", "time": 5245.149, "timestamp": "01:27:25", "text": "取る、"}, {"type": "subtitle", "time": 5249.709, "timestamp": "01:27:29", "text": "しかし、AI翻訳は"}, {"type": "subtitle", "time": 5252.709, "timestamp": "01:27:32", "text": "わかった。私だけでしょうか、それともまるで"}, {"type": "subtitle", "time": 5254.629, "timestamp": "01:27:34", "text": "時々、あなたが、えーと、"}, {"type": "subtitle", "time": 5256.31, "timestamp": "01:27:36", "text": "誰かちゃんとしたいいねを作ってくれ"}, {"type": "subtitle", "time": 5258.39, "timestamp": "01:27:38", "text": "翻訳は適切ではなく、"}, {"type": "subtitle", "time": 5261.35, "timestamp": "01:27:41", "text": "特別なものに合わせてローカライズされています"}, {"type": "subtitle", "time": 5264.31, "timestamp": "01:27:44", "text": "コミックのようなもの。だから、"}, {"type": "subtitle", "time": 5267.59, "timestamp": "01:27:47", "text": "コミックとかマンガとか、そういう類のもの。えっ、何？"}, {"type": "subtitle", "time": 5268.95, "timestamp": "01:27:48", "text": "ローカライゼーションについてのご意見をお聞かせください"}, {"type": "subtitle", "time": 5270.55, "timestamp": "01:27:50", "text": "騎手？"}, {"type": "subtitle", "time": 5272.31, "timestamp": "01:27:52", "text": "ローカライゼーション。"}, {"type": "subtitle", "time": 5275.43, "timestamp": "01:27:55", "text": "ええ、ローカライズは人がやります"}, {"type": "subtitle", "time": 5278.229, "timestamp": "01:27:58", "text": "の方がより良い。いいえ"}]
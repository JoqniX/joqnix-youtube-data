[{"type": "subtitle", "time": 5641.91, "timestamp": "01:34:01", "text": "ひどいけど、実際は"}, {"type": "subtitle", "time": 5649.83, "timestamp": "01:34:09", "text": "誰もがそう思っているように"}, {"type": "subtitle", "time": 5651.81, "timestamp": "01:34:11", "text": "悪い。"}, {"type": "subtitle", "time": 5653.51, "timestamp": "01:34:13", "text": "[音楽]"}, {"type": "subtitle", "time": 5660.149, "timestamp": "01:34:20", "text": "必ずしも本に限った話ではない。"}, {"type": "subtitle", "time": 5663.709, "timestamp": "01:34:23", "text": "それは何でもあり得る。あらゆる形態の"}, {"type": "subtitle", "time": 5666.47, "timestamp": "01:34:26", "text": "メディア。おお。"}, {"type": "subtitle", "time": 5674.31, "timestamp": "01:34:34", "text": "ライトノベルってどういうものか分かる？"}, {"type": "subtitle", "time": 5677.99, "timestamp": "01:34:37", "text": "うん。うん。それらのほとんどはスーパー"}, {"type": "subtitle", "time": 5679.91, "timestamp": "01:34:39", "text": "ありきたりな表現だ。彼らは実際には離れない"}, {"type": "subtitle", "time": 5681.91, "timestamp": "01:34:41", "text": "その式から。それらはただ追加するだけです"}, {"type": "subtitle", "time": 5683.99, "timestamp": "01:34:43", "text": "ちょっとした害、ちょっとした"}, {"type": "subtitle", "time": 5686.31, "timestamp": "01:34:46", "text": "権力欲の表れですね。"}, {"type": "subtitle", "time": 5689.99, "timestamp": "01:34:49", "text": "そう、たくさんの人が"}, {"type": "subtitle", "time": 5693.11, "timestamp": "01:34:53", "text": "アニメコミュニティから"}, {"type": "subtitle", "time": 5694.709, "timestamp": "01:34:54", "text": "彼らは本当に嫌いです、なぜなら"}, {"type": "subtitle", "time": 5696.91, "timestamp": "01:34:56", "text": "公式から外れると、"}, {"type": "subtitle", "time": 5699.55, "timestamp": "01:34:59", "text": "まるでとても"}]
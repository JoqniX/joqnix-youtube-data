[{"type": "subtitle", "time": 722.31, "timestamp": "00:12:02", "text": "私がいる部屋は暑くて間抜けな部屋です。"}, {"type": "subtitle", "time": 725.75, "timestamp": "00:12:05", "text": "湿気が多い。だから私は、もしかしたら、もしかしたら、もしかしたら"}, {"type": "subtitle", "time": 727.67, "timestamp": "00:12:07", "text": "何かを拾って、試して、やってみる"}, {"type": "subtitle", "time": 729.91, "timestamp": "00:12:09", "text": "私の人生に何かあるんだよ。うん。"}, {"type": "subtitle", "time": 731.75, "timestamp": "00:12:11", "text": "そしてそれはとても奇妙だ"}, {"type": "subtitle", "time": 734.79, "timestamp": "00:12:14", "text": "あなたが"}, {"type": "subtitle", "time": 736.47, "timestamp": "00:12:16", "text": "君がその時"}, {"type": "subtitle", "time": 738.47, "timestamp": "00:12:18", "text": "そう、あなたはこれが"}, {"type": "subtitle", "time": 741.03, "timestamp": "00:12:21", "text": "いいですよね？大丈夫だったよ。これは"}, {"type": "subtitle", "time": 743.11, "timestamp": "00:12:23", "text": "私が持っているライフスタイル、そしてあなたが始める"}, {"type": "subtitle", "time": 745.19, "timestamp": "00:12:25", "text": "もっとうまくできると気づいて"}, {"type": "subtitle", "time": 747.75, "timestamp": "00:12:27", "text": "100％良くなった。"}, {"type": "subtitle", "time": 749.99, "timestamp": "00:12:29", "text": "そういう段階に達するんです。うん。"}, {"type": "subtitle", "time": 751.269, "timestamp": "00:12:31", "text": "一体何の話に脱線してるんだ？"}, {"type": "subtitle", "time": 752.55, "timestamp": "00:12:32", "text": "の上？ごめん。"}, {"type": "subtitle", "time": 754.069, "timestamp": "00:12:34", "text": "また。"}, {"type": "subtitle", "time": 757.67, "timestamp": "00:12:37", "text": "いやいや、これは私には理解できません。私はできる"}, {"type": "subtitle", "time": 760.629, "timestamp": "00:12:40", "text": "私も同じことをしたので、共感します"}, {"type": "subtitle", "time": 763.03, "timestamp": "00:12:43", "text": "COが始まった後、私が思うことは"}, {"type": "subtitle", "time": 767.03, "timestamp": "00:12:47", "text": "もしくは私の後の何か、えっと、その後、"}, {"type": "subtitle", "time": 769.67, "timestamp": "00:12:49", "text": "高校3年生とか、そういうこと。私は行くのをやめた。私"}, {"type": "subtitle", "time": 772.55, "timestamp": "00:12:52", "text": "行くことに興味がなかった"}, {"type": "subtitle", "time": 774.79, "timestamp": "00:12:54", "text": "大学とか何か、あるいは何かをする"}, {"type": "subtitle", "time": 777.629, "timestamp": "00:12:57", "text": "何でも追求する。試してみましたが、"}]
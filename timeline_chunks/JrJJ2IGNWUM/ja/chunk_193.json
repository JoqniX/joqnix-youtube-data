[{"type": "subtitle", "time": 11580.79, "timestamp": "03:13:00", "text": "この男と？よし、オカンにしよう。"}, {"type": "subtitle", "time": 11585.269, "timestamp": "03:13:05", "text": "自分が誰を演じていたのか忘れてしまった。"}, {"type": "subtitle", "time": 11590.55, "timestamp": "03:13:10", "text": "彼と対戦してみるべきだよ。彼は面白い人だ。"}, {"type": "subtitle", "time": 11616.55, "timestamp": "03:13:36", "text": "飛び降りる時が来た。私たちはどこにいるのか"}, {"type": "subtitle", "time": 11629.59, "timestamp": "03:13:49", "text": "ああ、今は戦利品とかを見せてくれるようになったんだね。"}, {"type": "subtitle", "time": 11633.469, "timestamp": "03:13:53", "text": "何が手に入るの？彼らは大きく変わった。"}, {"type": "subtitle", "time": 11639.59, "timestamp": "03:13:59", "text": "ああ、それらは個人用の武器のようなものだ"}]
[{"type": "subtitle", "time": 3601.99, "timestamp": "01:00:01", "text": "以前の庭は？オリーブガーデン？いいえ、しかし"}, {"type": "subtitle", "time": 3605.349, "timestamp": "01:00:05", "text": "オリーブガーデンでは無制限に"}, {"type": "subtitle", "time": 3607.589, "timestamp": "01:00:07", "text": "パンのスティック。"}, {"type": "subtitle", "time": 3609.589, "timestamp": "01:00:09", "text": "え、そんなことあるの？"}, {"type": "subtitle", "time": 3611.829, "timestamp": "01:00:11", "text": "はい、"}, {"type": "subtitle", "time": 3614.549, "timestamp": "01:00:14", "text": "男。おい、チーズ味のやつもだよ。うん、"}, {"type": "subtitle", "time": 3617.829, "timestamp": "01:00:17", "text": "それらは良いものだ。"}, {"type": "subtitle", "time": 3620.87, "timestamp": "01:00:20", "text": "ほかに何か？例えば、パスタ料理のように、"}, {"type": "subtitle", "time": 3623.51, "timestamp": "01:00:23", "text": "みんな大きな大きな"}, {"type": "subtitle", "time": 3625.19, "timestamp": "01:00:25", "text": "私にとってはプラスだけど、あまり好きじゃない"}, {"type": "subtitle", "time": 3627.75, "timestamp": "01:00:27", "text": "フィリピン料理はもうそれほど多くない。私"}, {"type": "subtitle", "time": 3632.23, "timestamp": "01:00:32", "text": "フィリピンの味が好きだから、私は"}, {"type": "subtitle", "time": 3635.27, "timestamp": "01:00:35", "text": "妻の実家は料理が大好きだ。私の"}, {"type": "subtitle", "time": 3637.43, "timestamp": "01:00:37", "text": "家族はそうではない。私たちはとても西洋的で"}, {"type": "subtitle", "time": 3641.349, "timestamp": "01:00:41", "text": "ヨーロッパの料理を適当に食べるような感じ。えっと、"}, {"type": "subtitle", "time": 3643.91, "timestamp": "01:00:43", "text": "妻の両親の家で食事をしなければならない"}, {"type": "subtitle", "time": 3646.15, "timestamp": "01:00:46", "text": "場所も好きで、まるで手作りのような味がする"}, {"type": "subtitle", "time": 3647.99, "timestamp": "01:00:47", "text": "フィリピン料理は私に感謝の気持ちを抱かせてくれた"}, {"type": "subtitle", "time": 3649.99, "timestamp": "01:00:49", "text": "少しの旨味"}, {"type": "subtitle", "time": 3653.43, "timestamp": "01:00:53", "text": "フィリピン料理が付いてきます。うん。そして"}, {"type": "subtitle", "time": 3655.91, "timestamp": "01:00:55", "text": "時々、たくさん気づくことがある"}, {"type": "subtitle", "time": 3658.069, "timestamp": "01:00:58", "text": "フィリピンのパレットは中心となる"}]
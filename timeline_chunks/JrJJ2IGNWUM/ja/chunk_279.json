[{"type": "subtitle", "time": 16741.029, "timestamp": "04:39:01", "text": "それはリラックスしたコラボレーションのようなものではなく、"}, {"type": "subtitle", "time": 16743.51, "timestamp": "04:39:03", "text": "たまり場みたいな感じの集まり。それは"}, {"type": "subtitle", "time": 16745.99, "timestamp": "04:39:05", "text": "まるで本格的なプロフェッショナルなコラボレーションのようなもの"}, {"type": "subtitle", "time": 16748.99, "timestamp": "04:39:08", "text": "何かの形式で、それは少し"}, {"type": "chat", "time": 16750.175, "timestamp": "04:39:10", "author": "@Roku-rin", "avatar": "https://yt4.ggpht.com/8LlS_C2IirDMfA5r2V0q5G1kudp8dmG6RQvz_jCAUT3H-esyEgTNPDwrfCXiyX7Undc9UmHNgw=s64-c-k-c0x00ffffff-no-rj", "message": "like how you been or can we hang again?"}, {"type": "subtitle", "time": 16753.51, "timestamp": "04:39:13", "text": "痛み。えっと、でも私はそこで聞きたいのですが"}, {"type": "subtitle", "time": 16756.551, "timestamp": "04:39:16", "text": "私が好きになりたい人たちは新しい"}, {"type": "subtitle", "time": 16762.39, "timestamp": "04:39:22", "text": "人々は、あなたがどうしているか、または私たちは"}, {"type": "subtitle", "time": 16766.39, "timestamp": "04:39:26", "text": "また保留？うん。聞きたいんだけど"}, {"type": "subtitle", "time": 16768.15, "timestamp": "04:39:28", "text": "それ。問題は、彼らが私のことを知らないということだ。"}, {"type": "subtitle", "time": 16772.07, "timestamp": "04:39:32", "text": "過去のほとんどの人にとって。私たちは"}, {"type": "subtitle", "time": 16774.629, "timestamp": "04:39:34", "text": "DMなどでランダムに話しかけてくる"}, {"type": "subtitle", "time": 16778.15, "timestamp": "04:39:38", "text": "突然コラボを申し込んできた。"}, {"type": "subtitle", "time": 16780.628, "timestamp": "04:39:40", "text": "彼らがそれを悪いことだと捉えないことを願っています。"}, {"type": "subtitle", "time": 16783.83, "timestamp": "04:39:43", "text": "でも私は寿司のように尋ねてみます"}, {"type": "subtitle", "time": 16786.948, "timestamp": "04:39:46", "text": "彼らがまだ質問しても構わないと言った"}, {"type": "subtitle", "time": 16788.868, "timestamp": "04:39:48", "text": "やりたくないし、興味もない"}, {"type": "subtitle", "time": 16792.47, "timestamp": "04:39:52", "text": "それなら結構です。それが現実さ。私は手に入れました"}, {"type": "subtitle", "time": 16794.948, "timestamp": "04:39:54", "text": "私はBBCを手に入れようとしています"}, {"type": "subtitle", "time": 16798.07, "timestamp": "04:39:58", "text": "BBCで私のことを書いたジャーナリスト"}]
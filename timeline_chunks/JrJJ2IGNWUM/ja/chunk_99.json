[{"type": "subtitle", "time": 5941.75, "timestamp": "01:39:01", "text": "ヤッピー。うん、だって、もし私が"}, {"type": "subtitle", "time": 5943.43, "timestamp": "01:39:03", "text": "何か新しいことに挑戦しよう"}, {"type": "subtitle", "time": 5945.35, "timestamp": "01:39:05", "text": "全てを放り出して。そうそう。マインクラフト"}, {"type": "subtitle", "time": 5947.59, "timestamp": "01:39:07", "text": "映画。ああ、"}, {"type": "subtitle", "time": 5949.99, "timestamp": "01:39:09", "text": "マインクラフトの映画？私はそれを"}, {"type": "subtitle", "time": 5953.59, "timestamp": "01:39:13", "text": "海賊旗サイト。だから、それが"}, {"type": "subtitle", "time": 5955.59, "timestamp": "01:39:15", "text": "カメラの画質を重視したバージョンでした。その"}, {"type": "subtitle", "time": 5957.189, "timestamp": "01:39:17", "text": "カメラの画質バージョンのため"}, {"type": "subtitle", "time": 5959.03, "timestamp": "01:39:19", "text": "見た。品質が悪かった。私は"}, {"type": "subtitle", "time": 5962.07, "timestamp": "01:39:22", "text": "推測ですが、うーん、わかりません。しかしそれは"}, {"type": "subtitle", "time": 5964.229, "timestamp": "01:39:24", "text": "映画の中のグリーンスクリーンみたいに"}, {"type": "subtitle", "time": 5966.629, "timestamp": "01:39:26", "text": "そして、"}, {"type": "subtitle", "time": 5969.189, "timestamp": "01:39:29", "text": "グリーンスクリーン？いいえ。"}, {"type": "subtitle", "time": 5970.88, "timestamp": "01:39:30", "text": "いいえ。 低品質モデルのようなものだ。"}, {"type": "subtitle", "time": 5973.52, "timestamp": "01:39:33", "text": "低品質モデルのようなものだ。 低品質なモデルとか、そういう類のもの。私は手に入れましたか"}, {"type": "subtitle", "time": 5976.159, "timestamp": "01:39:36", "text": "低品質なモデルとか、そういう類のもの。私は手に入れましたか おそらくあなたは、おそらく"}, {"type": "subtitle", "time": 5978.48, "timestamp": "01:39:38", "text": "おそらくあなたは、おそらく 奇妙な海賊版だ。うん。うん。"}, {"type": "subtitle", "time": 5982.08, "timestamp": "01:39:42", "text": "奇妙な海賊版だ。うん。うん。 視聴に関しては、"}, {"type": "subtitle", "time": 5985.639, "timestamp": "01:39:45", "text": "視聴に関しては、 ロック。私もそれを使っています。ロック、ロック。"}, {"type": "subtitle", "time": 5989.52, "timestamp": "01:39:49", "text": "ロック。私もそれを使っています。ロック、ロック。 うん。無料のスマホアプリみたいなものだよ。ああ。えっと"}, {"type": "subtitle", "time": 5993.199, "timestamp": "01:39:53", "text": "うん。無料のスマホアプリみたいなものだよ。ああ。えっと チキンジャケット。うん。こんにちは、イサさん。"}, {"type": "subtitle", "time": 5996.0, "timestamp": "01:39:56", "text": "チキンジャケット。うん。こんにちは、イサさん。 配信へようこ​​そ。ボンバルディーノ"}, {"type": "subtitle", "time": 5997.28, "timestamp": "01:39:57", "text": "配信へようこ​​そ。ボンバルディーノ クロコダイル。"}]
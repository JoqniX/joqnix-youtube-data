[{"type": "subtitle", "time": 7440.51, "timestamp": "02:04:00", "text": "来て。来て。来て。自分の仕事をしてください。"}, {"type": "subtitle", "time": 7443.43, "timestamp": "02:04:03", "text": "兄弟。声の攻撃。来て。私はしませんでした"}, {"type": "subtitle", "time": 7446.51, "timestamp": "02:04:06", "text": "コラボって言ったっけ？"}, {"type": "subtitle", "time": 7449.03, "timestamp": "02:04:09", "text": "ああ、そうだったよ。そうだった。"}, {"type": "subtitle", "time": 7480.51, "timestamp": "02:04:40", "text": "おお、"}, {"type": "subtitle", "time": 7484.149, "timestamp": "02:04:44", "text": "痛い、痛い。"}, {"type": "subtitle", "time": 7487.07, "timestamp": "02:04:47", "text": "私はひどく失敗した"}, {"type": "subtitle", "time": 7489.149, "timestamp": "02:04:49", "text": "そこには。"}]
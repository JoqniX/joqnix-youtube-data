[{"type": "subtitle", "time": 6241.669, "timestamp": "01:44:01", "text": "もしそれがメインプロットだったら"}, {"type": "subtitle", "time": 6244.629, "timestamp": "01:44:04", "text": "もし私がマインクラフトの映画を作るとしたら。うん。"}, {"type": "subtitle", "time": 6246.95, "timestamp": "01:44:06", "text": "そして私はスティーブに本当に私を好きになってほしい"}, {"type": "subtitle", "time": 6249.03, "timestamp": "01:44:09", "text": "彼にはそうしてほしくない、たぶんそれは"}, {"type": "subtitle", "time": 6251.35, "timestamp": "01:44:11", "text": "私は現実に基づいている、私は望んでいない"}, {"type": "subtitle", "time": 6253.51, "timestamp": "01:44:13", "text": "彼をレンガ造りの[ __ ]の家のようにする。私"}, {"type": "subtitle", "time": 6255.83, "timestamp": "01:44:15", "text": "彼には、引き締まったミルフィットな体型になってほしいだけなんです"}, {"type": "subtitle", "time": 6258.87, "timestamp": "01:44:18", "text": "タイプの男性。"}, {"type": "subtitle", "time": 6261.75, "timestamp": "01:44:21", "text": "うーん、よく考えてみると、それは良くないですね。"}, {"type": "subtitle", "time": 6263.43, "timestamp": "01:44:23", "text": "スパイダーマンの俳優は誰ですか"}, {"type": "subtitle", "time": 6265.43, "timestamp": "01:44:25", "text": "また？彼ではない。私はそうしたくない"}, {"type": "subtitle", "time": 6268.87, "timestamp": "01:44:28", "text": "彼のように。こうあってほしい"}, {"type": "subtitle", "time": 6270.87, "timestamp": "01:44:30", "text": "えーと、トム・ホランド。"}, {"type": "subtitle", "time": 6271.99, "timestamp": "01:44:31", "text": "うん。うん。トムであってほしくない"}, {"type": "subtitle", "time": 6275.03, "timestamp": "01:44:35", "text": "ホランド、トム・ホランドは子供みたいだから"}, {"type": "subtitle", "time": 6276.87, "timestamp": "01:44:36", "text": "探しています。うん。うん。私はスティーブに"}, {"type": "subtitle", "time": 6279.39, "timestamp": "01:44:39", "text": "少なくともこう"}, {"type": "subtitle", "time": 6284.47, "timestamp": "01:44:44", "text": "たぶん25～30。いや、違う。まずい。うん。うん。"}, {"type": "subtitle", "time": 6286.47, "timestamp": "01:44:46", "text": "うん。うん。えーと、アメイジング・スパイダーマン。"}, {"type": "subtitle", "time": 6287.59, "timestamp": "01:44:47", "text": "うん。くそ。名前は何でしたか？アンドリュー"}, {"type": "subtitle", "time": 6288.95, "timestamp": "01:44:48", "text": "ガーフィールド。うん。アンドリュー・ガーフィールド。"}, {"type": "subtitle", "time": 6291.27, "timestamp": "01:44:51", "text": "アンドリュー・ガーフィールドみたいな感じ。欲しい"}, {"type": "subtitle", "time": 6292.83, "timestamp": "01:44:52", "text": "アンドリューに似せる"}, {"type": "subtitle", "time": 6294.95, "timestamp": "01:44:54", "text": "ガーフィールド。うん。マインクラフトの映画は"}, {"type": "subtitle", "time": 6296.79, "timestamp": "01:44:56", "text": "ジャック・ブラックに会うまではダメだ。なんてこった。"}, {"type": "subtitle", "time": 6299.99, "timestamp": "01:44:59", "text": "あれはジャック・ブラックだ。私は本当に"}]
[{"type": "subtitle", "time": 67.75, "timestamp": "00:01:07", "text": "これはまさに今、私を呼んでいる。これは"}, {"type": "subtitle", "time": 70.23, "timestamp": "00:01:10", "text": "ジョッキー。"}, {"type": "subtitle", "time": 72.35, "timestamp": "00:01:12", "text": "私はその騎手を覚えている"}, {"type": "subtitle", "time": 76.429, "timestamp": "00:01:16", "text": "赤ちゃん。あなたは誰ですか？あなたは誰ですか？私は"}, {"type": "subtitle", "time": 80.23, "timestamp": "00:01:20", "text": "ジョー。私は星座です。"}, {"type": "subtitle", "time": 84.03, "timestamp": "00:01:24", "text": "こんにちは、寿司さん。元気かい？それはありました"}, {"type": "subtitle", "time": 87.99, "timestamp": "00:01:27", "text": "永遠に。元気ですか？私たちはよく"}, {"type": "subtitle", "time": 90.789, "timestamp": "00:01:30", "text": "あなたはここにしばらく滞在していますね。私は"}, {"type": "subtitle", "time": 95.91, "timestamp": "00:01:35", "text": "本当に長い間いなくなってたよ、相棒。うん。"}, {"type": "subtitle", "time": 97.99000000000001, "timestamp": "00:01:37", "text": "持続する。あなたの「いいね！」を弾ませてあげましょう"}, {"type": "subtitle", "time": 101.59, "timestamp": "00:01:41", "text": "PNGファイルはここにあります。"}, {"type": "subtitle", "time": 104.31, "timestamp": "00:01:44", "text": "おい、俺はお前を真似してるんだよ。私はしていません"}, {"type": "subtitle", "time": 107.19, "timestamp": "00:01:47", "text": "まるで一日寝ていたかのように。冗談です。しかし"}, {"type": "subtitle", "time": 109.429, "timestamp": "00:01:49", "text": "あなたは眠っていない。"}, {"type": "subtitle", "time": 112.38900000000001, "timestamp": "00:01:52", "text": "私はしていません。いろいろと忙しかったんです"}, {"type": "chat", "time": 113.702, "timestamp": "00:01:53", "author": "@OtakuArceus", "avatar": "https://yt4.ggpht.com/VSZC0x7e02-tCAnte525GcpFOF0YcSpYQWplJkdg1RARvkQA3ETFxFaiYVshpLrqHFKUMz4VmA=s64-c-k-c0x00ffffff-no-rj", "message": "ello~"}, {"type": "subtitle", "time": 115.749, "timestamp": "00:01:55", "text": "現実世界で。でも、彼らは本当に"}, {"type": "subtitle", "time": 118.31, "timestamp": "00:01:58", "text": "時間があるから、"}]
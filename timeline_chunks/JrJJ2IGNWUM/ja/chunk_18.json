[{"type": "subtitle", "time": 1082.23, "timestamp": "00:18:02", "text": "うん。マーティン、ごめん、人々は"}, {"type": "subtitle", "time": 1084.23, "timestamp": "00:18:04", "text": "チャット中。私はこう答えるべきだと感じた"}, {"type": "subtitle", "time": 1086.47, "timestamp": "00:18:06", "text": "これ。私は夢中になりすぎている"}, {"type": "subtitle", "time": 1089.19, "timestamp": "00:18:09", "text": "まさに本物のクソみたいなやつ。私はあまり"}, {"type": "subtitle", "time": 1091.029, "timestamp": "00:18:11", "text": "私は正直なタイプではない。私は"}, {"type": "subtitle", "time": 1093.99, "timestamp": "00:18:13", "text": "一日中[ __ ]について話すためにタイプする。私は"}, {"type": "subtitle", "time": 1095.75, "timestamp": "00:18:15", "text": "いや、私はあまり知られていない"}, {"type": "subtitle", "time": 1097.909, "timestamp": "00:18:17", "text": "あまりにも現実的すぎる。"}, {"type": "subtitle", "time": 1100.549, "timestamp": "00:18:20", "text": "ああ、君もこの騎手を知っているだろう。私たちはふざける"}, {"type": "subtitle", "time": 1104.23, "timestamp": "00:18:24", "text": "周囲にたくさんあります。私たちはふざけ合う。はい。"}, {"type": "subtitle", "time": 1107.99, "timestamp": "00:18:27", "text": "私たちはもう感傷的になったりしない。"}, {"type": "subtitle", "time": 1109.75, "timestamp": "00:18:29", "text": "やあ、パパット。うん。私たちは実際には"}, {"type": "subtitle", "time": 1111.27, "timestamp": "00:18:31", "text": "何でもプレイする。私たちはただ、私たちはただ"}, {"type": "subtitle", "time": 1112.63, "timestamp": "00:18:32", "text": "いい感じ。私たちは話し合っています。私たちはただ"}, {"type": "chat", "time": 1114.237, "timestamp": "00:18:34", "author": "@LeverBoi", "avatar": "https://yt4.ggpht.com/xNxuxXmHi1c7fysDq7xCqQFkIHS14-WZ-pDk_WA0vJh_7H6RdN1zGFsbYrCE6izTRTxqZPdBqA=s64-c-k-c0x00ffffff-no-rj", "message": "it's not bad lol"}, {"type": "subtitle", "time": 1114.789, "timestamp": "00:18:34", "text": "仲間たち。私たちはただの"}, {"type": "subtitle", "time": 1116.47, "timestamp": "00:18:36", "text": "仲間が水を飲んで、それから"}, {"type": "subtitle", "time": 1119.83, "timestamp": "00:18:39", "text": "外の世界で話している。うん。いつでも"}, {"type": "subtitle", "time": 1122.63, "timestamp": "00:18:42", "text": "俺たちはこういうことをするんだ、まるでただの兄弟みたいに"}, {"type": "subtitle", "time": 1124.39, "timestamp": "00:18:44", "text": "いい感じ、いつも私たちはただ"}, {"type": "subtitle", "time": 1127.51, "timestamp": "00:18:47", "text": "外の丘の上、草が生い茂っているような"}, {"type": "subtitle", "time": 1129.99, "timestamp": "00:18:49", "text": "丘の上でお互いに良い雰囲気を感じながら、"}, {"type": "subtitle", "time": 1132.71, "timestamp": "00:18:52", "text": "ただ空を見上げたり、ただ話したり。"}, {"type": "subtitle", "time": 1135.27, "timestamp": "00:18:55", "text": "私はこのように考えています"}, {"type": "subtitle", "time": 1137.51, "timestamp": "00:18:57", "text": "私たちが持っている雰囲気の会話は、単に"}, {"type": "subtitle", "time": 1139.27, "timestamp": "00:18:59", "text": "あなたも他の皆と一緒にいるとき、私たちはただ"}]
[{"type": "subtitle", "time": 16203.309, "timestamp": "04:30:03", "text": "こんにちは。私は"}, {"type": "subtitle", "time": 16206.189, "timestamp": "04:30:06", "text": "電話。"}, {"type": "subtitle", "time": 16208.429, "timestamp": "04:30:08", "text": "こんにちは。ありがとう、"}, {"type": "subtitle", "time": 16211.83, "timestamp": "04:30:11", "text": "マラマ。どうもありがとう。本当に"}, {"type": "subtitle", "time": 16214.269, "timestamp": "04:30:14", "text": "楽しい。何てことだ。私は"}, {"type": "subtitle", "time": 16217.83, "timestamp": "04:30:17", "text": "ハッピー。えーっと、ピューできたことが嬉しいです"}, {"type": "subtitle", "time": 16221.229, "timestamp": "04:30:21", "text": "私と一緒に座って、唯一無二の"}, {"type": "subtitle", "time": 16225.95, "timestamp": "04:30:25", "text": "ApexとPゲームのプロであるMerと"}, {"type": "subtitle", "time": 16227.87, "timestamp": "04:30:27", "text": "もの。"}, {"type": "subtitle", "time": 16230.75, "timestamp": "04:30:30", "text": "うん。私は嬉しいです"}, {"type": "subtitle", "time": 16233.149, "timestamp": "04:30:33", "text": "うん。"}, {"type": "subtitle", "time": 16238.309, "timestamp": "04:30:38", "text": "初めて配信に挑戦"}, {"type": "subtitle", "time": 16241.75, "timestamp": "04:30:41", "text": "狙撃みたいなもの。君だけが"}, {"type": "subtitle", "time": 16244.79, "timestamp": "04:30:44", "text": "実際にストリームで成功したのは誰ですか"}, {"type": "subtitle", "time": 16246.95, "timestamp": "04:30:46", "text": "狙撃。ああ、なんてタイミングと"}, {"type": "subtitle", "time": 16248.75, "timestamp": "04:30:48", "text": "もの。どうでしたか？"}, {"type": "subtitle", "time": 16251.389, "timestamp": "04:30:51", "text": "それ、"}, {"type": "subtitle", "time": 16253.55, "timestamp": "04:30:53", "text": "兄弟？それは"}, {"type": "subtitle", "time": 16254.98, "timestamp": "04:30:54", "text": "クレイジー。それは"}, {"type": "subtitle", "time": 16256.59, "timestamp": "04:30:56", "text": "[音楽]"}, {"type": "subtitle", "time": 16259.389, "timestamp": "04:30:59", "text": "クレイジー。"}]
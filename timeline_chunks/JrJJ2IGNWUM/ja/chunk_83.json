[{"type": "subtitle", "time": 4981.669, "timestamp": "01:23:01", "text": "2、3口飲むと酔いが回る"}, {"type": "subtitle", "time": 4984.149, "timestamp": "01:23:04", "text": "そして気絶する瞬間。"}, {"type": "subtitle", "time": 4987.03, "timestamp": "01:23:07", "text": "ああ、でも私は試したんです、ある意味強制されたんです"}, {"type": "subtitle", "time": 4991.75, "timestamp": "01:23:11", "text": "シャンパンなど、いろいろ試してみます。"}, {"type": "subtitle", "time": 4995.189, "timestamp": "01:23:15", "text": "シャンパンは良いウォッカ、それらすべて"}, {"type": "subtitle", "time": 4997.99, "timestamp": "01:23:17", "text": "ビールとか色々詰め込む。どう思いますか"}, {"type": "subtitle", "time": 5000.229, "timestamp": "01:23:20", "text": "あなたにとって最も飲みやすいもの"}, {"type": "subtitle", "time": 5003.03, "timestamp": "01:23:23", "text": "アルコール飲料のような用語ですか？"}, {"type": "subtitle", "time": 5007.11, "timestamp": "01:23:27", "text": "おいしい？えっと、これは私がそうだったとき"}, {"type": "subtitle", "time": 5010.79, "timestamp": "01:23:30", "text": "私はとても若かった。覚えていない。"}, {"type": "subtitle", "time": 5013.189, "timestamp": "01:23:33", "text": "私にとって一番飲みやすいのは"}, {"type": "subtitle", "time": 5017.27, "timestamp": "01:23:37", "text": "Simrnoff クリアのようなもので、"}, {"type": "subtitle", "time": 5019.83, "timestamp": "01:23:39", "text": "飲んでみると、とても滑らかで"}, {"type": "subtitle", "time": 5021.99, "timestamp": "01:23:41", "text": "もはやそれを感じないとき"}, {"type": "subtitle", "time": 5023.35, "timestamp": "01:23:43", "text": "それを飲んでください。なぜなら、お酒を飲むと"}, {"type": "subtitle", "time": 5025.99, "timestamp": "01:23:45", "text": "ビールが好き、またはビールが好きではない。本当に"}, {"type": "subtitle", "time": 5028.149, "timestamp": "01:23:48", "text": "ビールが嫌いだ。でも、飲むときのように"}, {"type": "subtitle", "time": 5030.87, "timestamp": "01:23:50", "text": "ジンや焼酎みたいなもの、"}, {"type": "subtitle", "time": 5032.95, "timestamp": "01:23:52", "text": "飲んだ時にそのざらつきを感じる"}, {"type": "subtitle", "time": 5034.629, "timestamp": "01:23:54", "text": "そして、価格は下がる。感じるでしょう。しかし"}, {"type": "subtitle", "time": 5037.27, "timestamp": "01:23:57", "text": "私がスミノフを飲むときはいつでも、"}, {"type": "subtitle", "time": 5039.189, "timestamp": "01:23:59", "text": "とても滑らかだ。あなたはそれを感じない。それ"}]
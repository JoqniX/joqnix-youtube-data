[{"type": "subtitle", "time": 15425.45, "timestamp": "04:17:05", "text": "ここ。 A"}, {"type": "subtitle", "time": 15429.309, "timestamp": "04:17:09", "text": "[音楽]"}, {"type": "subtitle", "time": 15438.71, "timestamp": "04:17:18", "text": "そうそう。チームチャット。うん。"}, {"type": "subtitle", "time": 15447.189, "timestamp": "04:17:27", "text": "キャンピングカーで行くこともできる。外にいてください"}, {"type": "subtitle", "time": 15457.11, "timestamp": "04:17:37", "text": "先制攻撃を仕掛けたのはどちらか。わかった。尊敬。"}, {"type": "subtitle", "time": 15467.03, "timestamp": "04:17:47", "text": "わかった。銃を傾ける。"}, {"type": "subtitle", "time": 15470.07, "timestamp": "04:17:50", "text": "あれは誰？何てことだ。それはすごい量ですね。"}, {"type": "subtitle", "time": 15472.149, "timestamp": "04:17:52", "text": "何てことだ。"}]
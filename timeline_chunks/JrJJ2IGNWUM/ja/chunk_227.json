[{"type": "subtitle", "time": 13620.71, "timestamp": "03:47:00", "text": "ジャンプパッド？はい。はい。これは何ですか？"}, {"type": "subtitle", "time": 13653.469, "timestamp": "03:47:33", "text": "私は"}, {"type": "subtitle", "time": 13661.11, "timestamp": "03:47:41", "text": "ああ、一番上だ。"}, {"type": "subtitle", "time": 13662.79, "timestamp": "03:47:42", "text": "いいね、いいね、いいね、いいね、いいね。仕上げる"}, {"type": "subtitle", "time": 13665.429, "timestamp": "03:47:45", "text": "彼。次は誰だ？"}, {"type": "subtitle", "time": 13669.11, "timestamp": "03:47:49", "text": "いいえ。このような試合は、"}, {"type": "subtitle", "time": 13678.95, "timestamp": "03:47:58", "text": "Hは、1分以内にという意味です。うん。うん、"}]
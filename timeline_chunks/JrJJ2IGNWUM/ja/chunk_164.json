[{"type": "subtitle", "time": 9841.71, "timestamp": "02:44:01", "text": "したいけど"}, {"type": "subtitle", "time": 9847.15, "timestamp": "02:44:07", "text": "たいていは時間が取れない。欲しい"}, {"type": "subtitle", "time": 9850.87, "timestamp": "02:44:10", "text": "アートをストリーミング配信する。"}, {"type": "subtitle", "time": 9852.63, "timestamp": "02:44:12", "text": "美術。"}, {"type": "subtitle", "time": 9854.91, "timestamp": "02:44:14", "text": "うん。"}, {"type": "subtitle", "time": 9858.23, "timestamp": "02:44:18", "text": "あなたの配信をよく見ていたのを覚えています"}, {"type": "subtitle", "time": 9861.349, "timestamp": "02:44:21", "text": "あなただけがApexをプレイしていて、"}, {"type": "subtitle", "time": 9863.429, "timestamp": "02:44:23", "text": "それに、あなたは音楽を聴きながらリラックスしていましたね。それ"}, {"type": "subtitle", "time": 9866.15, "timestamp": "02:44:26", "text": "それはそんな女性だった。"}, {"type": "subtitle", "time": 9873.51, "timestamp": "02:44:33", "text": "ああ、シェーダーの読み込み中だ"}, {"type": "subtitle", "time": 9876.87, "timestamp": "02:44:36", "text": "あれ。なんてこった、"}, {"type": "subtitle", "time": 9880.87, "timestamp": "02:44:40", "text": "私はゲームを始めた。"}, {"type": "subtitle", "time": 9884.23, "timestamp": "02:44:44", "text": "ああ、つい最近のことですね。"}, {"type": "subtitle", "time": 9889.99, "timestamp": "02:44:49", "text": "どうですか？戻ってきました。うん。"}, {"type": "subtitle", "time": 9894.71, "timestamp": "02:44:54", "text": "そしてそれはかなり良かった"}]
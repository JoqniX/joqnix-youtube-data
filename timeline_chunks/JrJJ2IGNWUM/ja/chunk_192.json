[{"type": "subtitle", "time": 11524.87, "timestamp": "03:12:04", "text": "プレイヤーは、この程度の分布を破壊してしまう。"}, {"type": "subtitle", "time": 11528.309, "timestamp": "03:12:08", "text": "あなたのテーマ。これは一体何ですか？これは"}, {"type": "subtitle", "time": 11531.15, "timestamp": "03:12:11", "text": "ランキングまたは"}, {"type": "subtitle", "time": 11534.91, "timestamp": "03:12:14", "text": "いいえ、これは"}, {"type": "subtitle", "time": 11541.23, "timestamp": "03:12:21", "text": "私たちのチームがいる場所。どこにあるか"}, {"type": "subtitle", "time": 11547.51, "timestamp": "03:12:27", "text": "立つ。赤は私たちのチームで、灰色は"}, {"type": "subtitle", "time": 11553.269, "timestamp": "03:12:33", "text": "グレーゾーンは、対戦相手のようなロビーです。"}, {"type": "subtitle", "time": 11557.03, "timestamp": "03:12:37", "text": "わかった。 M はスキルキルが好きです"}, {"type": "subtitle", "time": 11558.55, "timestamp": "03:12:38", "text": "ロビー。"}, {"type": "subtitle", "time": 11561.15, "timestamp": "03:12:41", "text": "彼らは私のスキルが"}, {"type": "subtitle", "time": 11564.75, "timestamp": "03:12:44", "text": "多くの？私は最初の日に出席するはずだ"}, {"type": "subtitle", "time": 11567.91, "timestamp": "03:12:47", "text": "側。私はこのゲームをあまりプレイしません。私"}, {"type": "subtitle", "time": 11570.349, "timestamp": "03:12:50", "text": "すべてを忘れてしまった"}, {"type": "subtitle", "time": 11572.87, "timestamp": "03:12:52", "text": "作品。おお。"}, {"type": "subtitle", "time": 11575.59, "timestamp": "03:12:55", "text": "私は妥協しない。私はそう思っていません。行くべきでしょうか？"}]
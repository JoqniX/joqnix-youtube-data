[{"type": "subtitle", "time": 10681.87, "timestamp": "02:58:01", "text": "はい。つまり、それは"}, {"type": "subtitle", "time": 10687.429, "timestamp": "02:58:07", "text": "モード。奴らはそれを削除したんだよ。それはそうかもしれない"}, {"type": "subtitle", "time": 10689.469, "timestamp": "02:58:09", "text": "暗い"}, {"type": "subtitle", "time": 10720.95, "timestamp": "02:58:40", "text": "私のパソコンが壊れかけているのがわかる。"}, {"type": "subtitle", "time": 10724.55, "timestamp": "02:58:44", "text": "ゲームをアップデートする必要があります。"}, {"type": "subtitle", "time": 10727.429, "timestamp": "02:58:47", "text": "何？私は思う。"}, {"type": "subtitle", "time": 10730.309, "timestamp": "02:58:50", "text": "はい。待って、ゲームをアップデートしないといけない。"}, {"type": "subtitle", "time": 10733.349, "timestamp": "02:58:53", "text": "何？どういう意味ですか？"}, {"type": "subtitle", "time": 10736.99, "timestamp": "02:58:56", "text": "ゲームは"}]
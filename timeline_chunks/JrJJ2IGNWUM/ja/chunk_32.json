[{"type": "subtitle", "time": 1920.149, "timestamp": "00:32:00", "text": "ストリーム。まあ、あなたは私に呪いをかけたいんですね"}, {"type": "subtitle", "time": 1923.35, "timestamp": "00:32:03", "text": "また？そうかもしれない。つまり、あなたは"}, {"type": "subtitle", "time": 1925.35, "timestamp": "00:32:05", "text": "あなた自身。すべて順調です。アプリを持っていません"}, {"type": "subtitle", "time": 1927.43, "timestamp": "00:32:07", "text": "プレイヤー制限。問題はそこなんです"}, {"type": "subtitle", "time": 1931.11, "timestamp": "00:32:11", "text": "そう、私が覚えているように、私がどのように"}, {"type": "subtitle", "time": 1933.11, "timestamp": "00:32:13", "text": "インターネット上で自分を表現することと"}, {"type": "subtitle", "time": 1936.389, "timestamp": "00:32:16", "text": "すごくうるさくて面白い感じ。私は話す"}, {"type": "subtitle", "time": 1938.35, "timestamp": "00:32:18", "text": "本当にくだらないことについて"}, {"type": "subtitle", "time": 1940.63, "timestamp": "00:32:20", "text": "不適切だということは理解しています。今でもそう思っています"}, {"type": "subtitle", "time": 1943.11, "timestamp": "00:32:23", "text": "それ。私はそれが大好きです。でも、"}, {"type": "subtitle", "time": 1945.43, "timestamp": "00:32:25", "text": "私と同じレベルのエネルギーを持っていない"}, {"type": "subtitle", "time": 1947.909, "timestamp": "00:32:27", "text": "以前は持っていたのですが、"}, {"type": "subtitle", "time": 1950.07, "timestamp": "00:32:30", "text": "年を重ねて新しいことを経験している"}, {"type": "subtitle", "time": 1954.31, "timestamp": "00:32:34", "text": "右？ Mと私は、くそ、もしかしたら私は"}, {"type": "subtitle", "time": 1956.63, "timestamp": "00:32:36", "text": "ちょっと恥ずかしいけど、私は恥ずかしいし"}, {"type": "subtitle", "time": 1958.35, "timestamp": "00:32:38", "text": "私は嬉しいです"}, {"type": "subtitle", "time": 1961.909, "timestamp": "00:32:41", "text": "私もそういうタイプなんだよ。まるで私が"}, {"type": "subtitle", "time": 1964.389, "timestamp": "00:32:44", "text": "狂犬病のチンポについて話したいけど、"}, {"type": "subtitle", "time": 1965.909, "timestamp": "00:32:45", "text": "誰も私の話を聞きたがらない"}, {"type": "subtitle", "time": 1967.43, "timestamp": "00:32:47", "text": "ウサギのペニスについて、それが私のものでない限り"}, {"type": "subtitle", "time": 1968.87, "timestamp": "00:32:48", "text": "そういうタイプの音楽を聴く聴衆"}, {"type": "subtitle", "time": 1972.07, "timestamp": "00:32:52", "text": "最悪だよね？何てことだ。まるで私が"}, {"type": "subtitle", "time": 1974.07, "timestamp": "00:32:54", "text": "人に自分の好きなものを好きになってもらうことはできない"}, {"type": "subtitle", "time": 1976.47, "timestamp": "00:32:56", "text": "のように。"}, {"type": "subtitle", "time": 1979.43, "timestamp": "00:32:59", "text": "それは本当だ。それは本当だ。うん。私はしません"}]
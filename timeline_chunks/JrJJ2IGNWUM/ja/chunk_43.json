[{"type": "subtitle", "time": 2580.63, "timestamp": "00:43:00", "text": "私も以前はそうしていました。あれをするのが懐かしい。"}, {"type": "subtitle", "time": 2582.309, "timestamp": "00:43:02", "text": "うん。それはまるで別の体験のようだ"}, {"type": "subtitle", "time": 2584.069, "timestamp": "00:43:04", "text": "動画クリップを見るのが好きです。確かに、それはあなたに"}, {"type": "subtitle", "time": 2585.43, "timestamp": "00:43:05", "text": "楽しい瞬間はすべて、でもあなたは"}, {"type": "subtitle", "time": 2589.91, "timestamp": "00:43:09", "text": "伝承みたいな感じでね？いいね"}, {"type": "subtitle", "time": 2591.99, "timestamp": "00:43:11", "text": "私のビデオをいくつか見れば、"}, {"type": "subtitle", "time": 2596.069, "timestamp": "00:43:16", "text": "気づいて、変な人だ"}, {"type": "subtitle", "time": 2598.95, "timestamp": "00:43:18", "text": "うーん、うるさい、バカ。まあ、それはあなたが"}, {"type": "subtitle", "time": 2601.67, "timestamp": "00:43:21", "text": "コンテストを見るように、誰が"}, {"type": "subtitle", "time": 2603.03, "timestamp": "00:43:23", "text": "あいつは一体何者なんだ？一体何なんだ"}, {"type": "subtitle", "time": 2606.069, "timestamp": "00:43:26", "text": "彼はもう何もしていない。まるで"}, {"type": "subtitle", "time": 2607.75, "timestamp": "00:43:27", "text": "そういう類のことだよ、わかる？たぶん彼は"}, {"type": "subtitle", "time": 2609.349, "timestamp": "00:43:29", "text": "Fをつけることもできるし、つけないこともできる。でも、"}, {"type": "subtitle", "time": 2610.87, "timestamp": "00:43:30", "text": "クリップを見ると、ああ"}, {"type": "subtitle", "time": 2612.95, "timestamp": "00:43:32", "text": "これは彼に対する私の意見です"}, {"type": "subtitle", "time": 2614.55, "timestamp": "00:43:34", "text": "映像に基づいて判断する。わかりました"}, {"type": "subtitle", "time": 2616.069, "timestamp": "00:43:36", "text": "人々がそうしているが、それは実際には"}, {"type": "subtitle", "time": 2619.19, "timestamp": "00:43:39", "text": "悪いことだ。気に入ったよ、君みたいに役立つよ"}, {"type": "subtitle", "time": 2621.03, "timestamp": "00:43:41", "text": "ある特定のものに慣れ親しむ"}, {"type": "subtitle", "time": 2622.95, "timestamp": "00:43:42", "text": "キャラクター、またはユーチューバーとその"}, {"type": "subtitle", "time": 2624.63, "timestamp": "00:43:44", "text": "性格タイプのようなものですが、"}, {"type": "subtitle", "time": 2626.309, "timestamp": "00:43:46", "text": "時には、それは物語の全てを語っていない。"}, {"type": "subtitle", "time": 2629.75, "timestamp": "00:43:49", "text": "その人がどんな人か、あるいはどんな人か"}, {"type": "subtitle", "time": 2631.27, "timestamp": "00:43:51", "text": "彼らが支持するのは"}, {"type": "subtitle", "time": 2633.43, "timestamp": "00:43:53", "text": "ストリーミングとかそういうの。そういえば、"}, {"type": "subtitle", "time": 2637.589, "timestamp": "00:43:57", "text": "エナが好き。彼女の声はセクシーだから。"}]
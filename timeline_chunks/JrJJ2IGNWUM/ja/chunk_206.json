[{"type": "subtitle", "time": 12377.429, "timestamp": "03:26:17", "text": "私は橋の下にいます。"}, {"type": "subtitle", "time": 12381.11, "timestamp": "03:26:21", "text": "ここに男がいる。さあ、やろう。"}, {"type": "subtitle", "time": 12389.75, "timestamp": "03:26:29", "text": "再装填中。ああ、第三者がいるんですね。"}, {"type": "subtitle", "time": 12391.75, "timestamp": "03:26:31", "text": "敵を倒した。"}, {"type": "subtitle", "time": 12394.51, "timestamp": "03:26:34", "text": "持続する。おお"}, {"type": "subtitle", "time": 12396.389, "timestamp": "03:26:36", "text": "くそっ。大丈夫。大丈夫。大丈夫。"}, {"type": "subtitle", "time": 12407.429, "timestamp": "03:26:47", "text": "大丈夫、これは痛くないよ。持続する。感謝"}, {"type": "subtitle", "time": 12410.469, "timestamp": "03:26:50", "text": "あなた。ああ、このレートは良いですね"}]
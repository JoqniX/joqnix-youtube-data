[{"type": "subtitle", "time": 301.07, "timestamp": "00:05:01", "text": "正直に言います。 Windows 11は、"}, {"type": "subtitle", "time": 305.43, "timestamp": "00:05:05", "text": "ドゥーキードゥーキーはオペレーティングシステムのようなもの"}, {"type": "subtitle", "time": 308.31, "timestamp": "00:05:08", "text": "バグだらけなので使わない方がいい。私はそれが嫌いです。"}, {"type": "subtitle", "time": 311.15, "timestamp": "00:05:11", "text": "私は絶対に使うのが嫌いです"}, {"type": "subtitle", "time": 312.749, "timestamp": "00:05:12", "text": "それ。"}, {"type": "subtitle", "time": 315.35, "timestamp": "00:05:15", "text": "まあ、いいよ。よし。これは"}, {"type": "subtitle", "time": 317.99, "timestamp": "00:05:17", "text": "今年に入って5回目の出来事"}, {"type": "subtitle", "time": 321.67, "timestamp": "00:05:21", "text": "私は本当に腹が立つ。なんてこった。したい"}, {"type": "subtitle", "time": 324.39, "timestamp": "00:05:24", "text": "Windows 10にダウングレードすればいいのに、だってわかってるから"}, {"type": "subtitle", "time": 327.749, "timestamp": "00:05:27", "text": "Windows 10の安定性はどのくらいか、しかし"}, {"type": "subtitle", "time": 330.39, "timestamp": "00:05:30", "text": "いや、それを手に入れるのは本当に難しい"}, {"type": "subtitle", "time": 333.11, "timestamp": "00:05:33", "text": "システムが復旧し、正常に動作しています。確かに、確かに、"}, {"type": "subtitle", "time": 335.43, "timestamp": "00:05:35", "text": "真実。"}, {"type": "subtitle", "time": 337.029, "timestamp": "00:05:37", "text": "ブート可能なファイルを作るのは面倒くさい"}, {"type": "subtitle", "time": 341.11, "timestamp": "00:05:41", "text": "USB。それはまた別の話です。"}, {"type": "subtitle", "time": 342.31, "timestamp": "00:05:42", "text": "うん、君は私に何も教えてくれなかったね"}, {"type": "subtitle", "time": 344.87, "timestamp": "00:05:44", "text": "動いているもの。あなたはそうしなかった"}, {"type": "subtitle", "time": 346.87, "timestamp": "00:05:46", "text": "それについて詳しく教えてください。何が"}, {"type": "subtitle", "time": 351.99, "timestamp": "00:05:51", "text": "ハプニング？あ、えっと、引っ越しです。はい。だから私は"}, {"type": "subtitle", "time": 354.71, "timestamp": "00:05:54", "text": "私は長年ずっと"}, {"type": "subtitle", "time": 356.71, "timestamp": "00:05:56", "text": "自分の人生で何をすべきか迷っていて、"}, {"type": "subtitle", "time": 359.749, "timestamp": "00:05:59", "text": "パートタイムの仕事がないとか、"}]
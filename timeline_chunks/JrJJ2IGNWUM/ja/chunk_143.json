[{"type": "subtitle", "time": 8581.91, "timestamp": "02:23:01", "text": "Twitch で Rohead がかつて愛していたことを覚えておいてください"}, {"type": "subtitle", "time": 8584.23, "timestamp": "02:23:04", "text": "カルマは昼夜を問わず流れ続ける"}, {"type": "subtitle", "time": 8588.55, "timestamp": "02:23:08", "text": "寝る。あのバカは昔よくそうしていた。"}, {"type": "subtitle", "time": 8592.429, "timestamp": "02:23:12", "text": "それで私はすごく泣いてしまった。このバカバカ"}, {"type": "subtitle", "time": 8595.429, "timestamp": "02:23:15", "text": "バカ。そして今、ズキはウイルスに感染し、"}, {"type": "subtitle", "time": 8613.63, "timestamp": "02:23:33", "text": "バカサシ。おい、何か持ってるよ"}, {"type": "subtitle", "time": 8616.309, "timestamp": "02:23:36", "text": "間違っている。何かがおかしい。おかし。"}]
[{"type": "subtitle", "time": 4804.149, "timestamp": "01:20:04", "text": "私はかつて新鮮なもののようにしたことがあります。"}, {"type": "subtitle", "time": 4807.99, "timestamp": "01:20:07", "text": "まるで新品のようだ。ああ。"}, {"type": "subtitle", "time": 4810.149, "timestamp": "01:20:10", "text": "うん。私はあまりハマらなかった。私"}, {"type": "subtitle", "time": 4812.149, "timestamp": "01:20:12", "text": "そういう感じだったんだ、私もそうしようとしてた"}, {"type": "subtitle", "time": 4814.63, "timestamp": "01:20:14", "text": "馴染むとか、そういうこと。それから私は"}, {"type": "subtitle", "time": 4816.709, "timestamp": "01:20:16", "text": "それをやめた。私はそう感じなかった"}, {"type": "subtitle", "time": 4819.59, "timestamp": "01:20:19", "text": "私はそういうことをするタイプです。さらに、私はすでに"}, {"type": "subtitle", "time": 4822.31, "timestamp": "01:20:22", "text": "ルールのように作られた自己ルールのように、そう、いいえ"}, {"type": "subtitle", "time": 4825.11, "timestamp": "01:20:25", "text": "飲酒、喫煙、薬物、その他一切。"}, {"type": "subtitle", "time": 4828.31, "timestamp": "01:20:28", "text": "健康で安全にお過ごしください。それでいい。"}, {"type": "subtitle", "time": 4830.95, "timestamp": "01:20:30", "text": "うん。私も同じことをするよ"}, {"type": "subtitle", "time": 4832.63, "timestamp": "01:20:32", "text": "つまり、こういうことですよね？私は"}, {"type": "subtitle", "time": 4834.709, "timestamp": "01:20:34", "text": "嘘じゃないし、ワイフもそれを証明してくれるよ。"}, {"type": "subtitle", "time": 4839.27, "timestamp": "01:20:39", "text": "私はたぶん1、2回タバコを吸います"}, {"type": "subtitle", "time": 4840.59, "timestamp": "01:20:40", "text": "毎"}, {"type": "subtitle", "time": 4843.59, "timestamp": "01:20:43", "text": "6ヶ月くらいかな、もし私が超"}, {"type": "subtitle", "time": 4846.95, "timestamp": "01:20:46", "text": "ストレスが溜まって、めちゃくちゃ腹が立つ"}, {"type": "subtitle", "time": 4848.95, "timestamp": "01:20:48", "text": "何かをしている。つまり、"}, {"type": "subtitle", "time": 4850.55, "timestamp": "01:20:50", "text": "おそらく私がタバコを吸うのは、"}, {"type": "subtitle", "time": 4853.83, "timestamp": "01:20:53", "text": "半年に1～2回。"}, {"type": "subtitle", "time": 4856.55, "timestamp": "01:20:56", "text": "楽しいからやっているわけではありません。私 私 私"}, {"type": "subtitle", "time": 4859.11, "timestamp": "01:20:59", "text": "人々がそれを楽しいと感じる理由を理解する"}]
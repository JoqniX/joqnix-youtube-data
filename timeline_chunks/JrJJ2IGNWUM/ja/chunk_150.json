[{"type": "subtitle", "time": 9012.59, "timestamp": "02:30:12", "text": "2つの配信を視聴している。なるほど。私"}, {"type": "subtitle", "time": 9015.83, "timestamp": "02:30:15", "text": "見る。また、堀を掘ったり、"}, {"type": "subtitle", "time": 9018.07, "timestamp": "02:30:18", "text": "何でもいいんだよ、そうだろ？だから、心配しないでください"}, {"type": "subtitle", "time": 9044.55, "timestamp": "02:30:44", "text": "もっと話すべきね。なぜ？なぜ私はそうではないのか"}, {"type": "subtitle", "time": 9047.71, "timestamp": "02:30:47", "text": "もっと話しましょうか？"}, {"type": "subtitle", "time": 9050.349, "timestamp": "02:30:50", "text": "なし。何が問題なの？"}, {"type": "subtitle", "time": 9053.309, "timestamp": "02:30:53", "text": "自分？なぜ私はそうではないのか"}, {"type": "subtitle", "time": 9056.51, "timestamp": "02:30:56", "text": "話している？いいえ。ええと、話していません"}]
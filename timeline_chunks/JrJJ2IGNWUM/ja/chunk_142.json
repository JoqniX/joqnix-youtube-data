[{"type": "subtitle", "time": 8526.27, "timestamp": "02:22:06", "text": "PCO。"}, {"type": "subtitle", "time": 8532.67, "timestamp": "02:22:12", "text": "[音楽]"}, {"type": "subtitle", "time": 8557.15, "timestamp": "02:22:37", "text": "うるさい。うるさいゲームだ。"}, {"type": "subtitle", "time": 8563.87, "timestamp": "02:22:43", "text": "一人で。あなたが知っている"}, {"type": "subtitle", "time": 8566.309, "timestamp": "02:22:46", "text": "何？ほとんどの場合、"}, {"type": "subtitle", "time": 8569.67, "timestamp": "02:22:49", "text": "こういうことがあると、すごく泣きたくなる。"}, {"type": "subtitle", "time": 8578.03, "timestamp": "02:22:58", "text": "独身者向けのプランもご用意しています。まるで私が"}]
[{"type": "subtitle", "time": 9781.51, "timestamp": "02:43:01", "text": "ニース。そちらの天気はどうですか？それは"}, {"type": "subtitle", "time": 9787.95, "timestamp": "02:43:07", "text": "それは後退する"}, {"type": "subtitle", "time": 9796.07, "timestamp": "02:43:16", "text": "昨日の雨のように。"}, {"type": "subtitle", "time": 9801.75, "timestamp": "02:43:21", "text": "ああ、でもここは雨が降っているみたい"}, {"type": "subtitle", "time": 9805.11, "timestamp": "02:43:25", "text": "まるで既に雨が降っているかのようだ。"}, {"type": "subtitle", "time": 9808.67, "timestamp": "02:43:28", "text": "うん。今すぐ。"}, {"type": "subtitle", "time": 9813.349, "timestamp": "02:43:33", "text": "うん。本を買いに行きます。"}, {"type": "subtitle", "time": 9816.07, "timestamp": "02:43:36", "text": "私にとって毎日が毎日同じ"}, {"type": "subtitle", "time": 9820.15, "timestamp": "02:43:40", "text": "雨が降っていて、ああ、まるで"}, {"type": "subtitle", "time": 9823.15, "timestamp": "02:43:43", "text": "洪水が起こりそうだ"}, {"type": "subtitle", "time": 9829.63, "timestamp": "02:43:49", "text": "自分。"}, {"type": "subtitle", "time": 9832.469, "timestamp": "02:43:52", "text": "うん。行ってないよ"}, {"type": "subtitle", "time": 9835.95, "timestamp": "02:43:55", "text": "しばらくしたら配信するんですよね？"}, {"type": "subtitle", "time": 9838.79, "timestamp": "02:43:58", "text": "はい。うん。"}]
[{"type": "subtitle", "time": 10740.349, "timestamp": "02:59:00", "text": "バージョンは"}, {"type": "subtitle", "time": 10745.51, "timestamp": "02:59:05", "text": "マッチ。更新する必要があります。"}, {"type": "subtitle", "time": 10750.11, "timestamp": "02:59:10", "text": "待って、再起動した方がいいかな？再開します"}, {"type": "subtitle", "time": 10755.55, "timestamp": "02:59:15", "text": "後ろみたいだし、"}, {"type": "subtitle", "time": 10757.79, "timestamp": "02:59:17", "text": "アップデートする"}, {"type": "subtitle", "time": 10766.11, "timestamp": "02:59:26", "text": "そうすればあなたは"}, {"type": "subtitle", "time": 10774.15, "timestamp": "02:59:34", "text": "シェーダーをもう一度作り直すためです。何？"}, {"type": "subtitle", "time": 10785.13, "timestamp": "02:59:45", "text": "痛みがひどすぎる。"}, {"type": "subtitle", "time": 10796.79, "timestamp": "02:59:56", "text": "ああ、これ、動かない。それは"}, {"type": "subtitle", "time": 10799.309, "timestamp": "02:59:59", "text": "普通？それは違う"}]
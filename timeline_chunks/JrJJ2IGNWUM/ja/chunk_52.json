[{"type": "subtitle", "time": 3121.589, "timestamp": "00:52:01", "text": "時々、満足するために"}, {"type": "subtitle", "time": 3124.63, "timestamp": "00:52:04", "text": "コーヒーよりも飲み物について。なぜならコーヒーは"}, {"type": "subtitle", "time": 3126.549, "timestamp": "00:52:06", "text": "家の方がいいですね。皆さんの意見に賛成です。"}, {"type": "subtitle", "time": 3128.23, "timestamp": "00:52:08", "text": "美味しいコーヒーを淹れたいなら、"}, {"type": "subtitle", "time": 3130.39, "timestamp": "00:52:10", "text": "あなた自身。"}, {"type": "subtitle", "time": 3131.91, "timestamp": "00:52:11", "text": "美味しいコーヒーが飲みたいなら"}, {"type": "subtitle", "time": 3134.95, "timestamp": "00:52:14", "text": "あなたの好みに合わせて、常に"}, {"type": "subtitle", "time": 3137.51, "timestamp": "00:52:17", "text": "ご自宅で入手可能なので、ぜひ試してみてください。"}, {"type": "subtitle", "time": 3139.67, "timestamp": "00:52:19", "text": "それは料理と同じようなものです。私"}, {"type": "subtitle", "time": 3141.03, "timestamp": "00:52:21", "text": "料理が大好きです。皆さんが"}, {"type": "subtitle", "time": 3144.39, "timestamp": "00:52:24", "text": "ご存知かもしれませんが、私は料理をします。そしてただ"}, {"type": "subtitle", "time": 3146.23, "timestamp": "00:52:26", "text": "好みの味を試してみます"}, {"type": "subtitle", "time": 3149.91, "timestamp": "00:52:29", "text": "あなたが目指したいもの。探検しなければ"}, {"type": "subtitle", "time": 3152.79, "timestamp": "00:52:32", "text": "風味プロファイルの可能性、"}, {"type": "subtitle", "time": 3154.47, "timestamp": "00:52:34", "text": "あなたは自分が本当に何者なのか決して理解できないだろう"}, {"type": "subtitle", "time": 3157.03, "timestamp": "00:52:37", "text": "欲しい。なぜなら、私は"}, {"type": "subtitle", "time": 3159.63, "timestamp": "00:52:39", "text": "私のものみたいに超クソヤバい"}, {"type": "subtitle", "time": 3162.15, "timestamp": "00:52:42", "text": "辛い。ほら、ほら、アヒルか"}, {"type": "subtitle", "time": 3165.51, "timestamp": "00:52:45", "text": "ピンク色の韓国麺"}, {"type": "subtitle", "time": 3168.71, "timestamp": "00:52:48", "text": "すごく辛い。はい。はい。私は愛する"}, {"type": "subtitle", "time": 3171.67, "timestamp": "00:52:51", "text": "ソースを全部かけて食べると"}, {"type": "subtitle", "time": 3174.23, "timestamp": "00:52:54", "text": "私には全然辛く感じない。まるで私が"}, {"type": "subtitle", "time": 3176.71, "timestamp": "00:52:56", "text": "それらを2パック食べなさい。私はまだ持っています"}, {"type": "subtitle", "time": 3178.39, "timestamp": "00:52:58", "text": "2パックは実際には階下にあります。そうするべきです。"}]
[{"type": "subtitle", "time": 363.43, "timestamp": "00:06:03", "text": "仕事でも何でも。そして私はそうしようと試みました"}, {"type": "subtitle", "time": 366.15, "timestamp": "00:06:06", "text": "英文学の学位"}, {"type": "subtitle", "time": 369.27, "timestamp": "00:06:09", "text": "あれ。ええ、私はまだ3位です"}, {"type": "subtitle", "time": 373.35, "timestamp": "00:06:13", "text": "年だけど、うん、私は「したくない」って感じだった"}, {"type": "subtitle", "time": 376.309, "timestamp": "00:06:16", "text": "ここインドにいる。とても大変で、"}, {"type": "subtitle", "time": 378.71, "timestamp": "00:06:18", "text": "何かをしたい"}, {"type": "subtitle", "time": 381.189, "timestamp": "00:06:21", "text": "私はそれが本当に好きなんです。"}, {"type": "subtitle", "time": 383.27, "timestamp": "00:06:23", "text": "それで私は「ええ、正直言って、"}, {"type": "subtitle", "time": 386.95, "timestamp": "00:06:26", "text": "もし私が両親に尋ねたら、私は"}, {"type": "subtitle", "time": 389.99, "timestamp": "00:06:29", "text": "私が望んでいたような研究全体を私は考えました"}, {"type": "subtitle", "time": 391.99, "timestamp": "00:06:31", "text": "もしかしたら日本に行ってみるのもいいかも"}, {"type": "subtitle", "time": 395.27, "timestamp": "00:06:35", "text": "何か？そこで全力を尽くしてみようと思う。"}, {"type": "subtitle", "time": 397.27, "timestamp": "00:06:37", "text": "まるで、人々が"}, {"type": "subtitle", "time": 400.15, "timestamp": "00:06:40", "text": "新しい街に引っ越すようなもの"}, {"type": "subtitle", "time": 403.029, "timestamp": "00:06:43", "text": "そして、まるで新たなスタートを切るような感覚だ。"}, {"type": "subtitle", "time": 405.35, "timestamp": "00:06:45", "text": "うん。うん。ゼロから始めて"}, {"type": "subtitle", "time": 407.029, "timestamp": "00:06:47", "text": "人生を取り戻すか、"}, {"type": "subtitle", "time": 409.11, "timestamp": "00:06:49", "text": "そんな感じ。だから私は、うーん、"}, {"type": "subtitle", "time": 411.51, "timestamp": "00:06:51", "text": "私もそうできるかもしれない。でも私はもっと"}, {"type": "subtitle", "time": 413.749, "timestamp": "00:06:53", "text": "常に外界から隔絶された人格"}, {"type": "subtitle", "time": 415.83, "timestamp": "00:06:55", "text": "私の部屋みたいなもの。だから私はこう思う、"}, {"type": "subtitle", "time": 417.43, "timestamp": "00:06:57", "text": "うん、それは良い経験になるだろう"}]
[{"type": "subtitle", "time": 2401.109, "timestamp": "00:40:01", "text": "私は今でも記事を読むのが好きだから"}, {"type": "subtitle", "time": 2403.27, "timestamp": "00:40:03", "text": "なぜなら時々"}, {"type": "subtitle", "time": 2407.349, "timestamp": "00:40:07", "text": "本当の作家の中には、"}, {"type": "subtitle", "time": 2409.43, "timestamp": "00:40:09", "text": "ユーモアのセンスがあれば"}, {"type": "subtitle", "time": 2412.31, "timestamp": "00:40:12", "text": "微妙なので、気づかないほど"}, {"type": "subtitle", "time": 2414.63, "timestamp": "00:40:14", "text": "それはまるでそこに隠されているかのようだ。その"}, {"type": "subtitle", "time": 2417.03, "timestamp": "00:40:17", "text": "ちょっとした皮肉があるように、"}, {"type": "subtitle", "time": 2419.27, "timestamp": "00:40:19", "text": "気づかないうちに面白いジョークがここにある"}, {"type": "subtitle", "time": 2421.67, "timestamp": "00:40:21", "text": "彼らが入れるつもりだ。それはまるで"}, {"type": "subtitle", "time": 2423.589, "timestamp": "00:40:23", "text": "くそ、もしかしたら読書を逃しているのかも"}, {"type": "subtitle", "time": 2425.91, "timestamp": "00:40:25", "text": "くそ、わかるだろ？そして、"}, {"type": "subtitle", "time": 2428.39, "timestamp": "00:40:28", "text": "ただの一般人が記事を書いている"}, {"type": "subtitle", "time": 2429.91, "timestamp": "00:40:29", "text": "意味が通じないし、"}, {"type": "subtitle", "time": 2431.67, "timestamp": "00:40:31", "text": "実際に参照を使用してください。だって、もしあなたが"}, {"type": "subtitle", "time": 2433.349, "timestamp": "00:40:33", "text": "時々、記事のようなものを見て、"}, {"type": "subtitle", "time": 2435.109, "timestamp": "00:40:35", "text": "参考資料のようなものを持って、"}, {"type": "subtitle", "time": 2437.27, "timestamp": "00:40:37", "text": "参照は完全に"}, {"type": "subtitle", "time": 2439.03, "timestamp": "00:40:39", "text": "全く関係のない別のクソなこと"}, {"type": "subtitle", "time": 2442.069, "timestamp": "00:40:42", "text": "まったく。そしてそれは、"}, {"type": "subtitle", "time": 2444.47, "timestamp": "00:40:44", "text": "まるで本物のジャーナリストのように"}, {"type": "subtitle", "time": 2446.55, "timestamp": "00:40:46", "text": "サイトは一体何なんだ"}, {"type": "subtitle", "time": 2448.03, "timestamp": "00:40:48", "text": "何をしているの？なぜあなたは"}, {"type": "subtitle", "time": 2450.79, "timestamp": "00:40:50", "text": "ここ？どうして投稿できるの？"}, {"type": "subtitle", "time": 2453.51, "timestamp": "00:40:53", "text": "これは、参照元が全くないものです。"}, {"type": "subtitle", "time": 2456.23, "timestamp": "00:40:56", "text": "関連している？え、これってどういうこと？"}, {"type": "subtitle", "time": 2457.74, "timestamp": "00:40:57", "text": "働く？"}, {"type": "subtitle", "time": 2459.51, "timestamp": "00:40:59", "text": "[音楽]"}]
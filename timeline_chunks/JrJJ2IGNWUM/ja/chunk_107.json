[{"type": "subtitle", "time": 6423.91, "timestamp": "01:47:03", "text": "アレックスはホットな美女ですか、それともアレックスを"}, {"type": "subtitle", "time": 6428.109, "timestamp": "01:47:08", "text": "ただ魅力的な女性？一致する"}, {"type": "subtitle", "time": 6430.87, "timestamp": "01:47:10", "text": "スティーブ、もし"}, {"type": "subtitle", "time": 6433.189, "timestamp": "01:47:13", "text": "彼女は比較的魅力的な"}, {"type": "subtitle", "time": 6435.51, "timestamp": "01:47:15", "text": "女性。あまり魅力的ではないが、"}, {"type": "subtitle", "time": 6437.51, "timestamp": "01:47:17", "text": "検討に値するほど魅力的"}, {"type": "subtitle", "time": 6439.43, "timestamp": "01:47:19", "text": "魅力的。"}, {"type": "subtitle", "time": 6441.83, "timestamp": "01:47:21", "text": "彼女はギリギリのラインを攻めるのが好きなんだよね？しかしもし"}, {"type": "subtitle", "time": 6443.91, "timestamp": "01:47:23", "text": "もし彼らがそれを従順なものにしようとしたら"}, {"type": "subtitle", "time": 6446.07, "timestamp": "01:47:26", "text": "通気性も良く、"}, {"type": "subtitle", "time": 6448.47, "timestamp": "01:47:28", "text": "主要なプロットのアイデアを台無しにする"}, {"type": "subtitle", "time": 6449.709, "timestamp": "01:47:29", "text": "アレックスは"}, {"type": "subtitle", "time": 6452.629, "timestamp": "01:47:32", "text": "なれ。だってアレックスは今でも"}, {"type": "subtitle", "time": 6455.59, "timestamp": "01:47:35", "text": "下半身は超ムキムキで、"}, {"type": "subtitle", "time": 6458.39, "timestamp": "01:47:38", "text": "あなたが知っている？筋肉質なママみたいだけどそうじゃない"}, {"type": "subtitle", "time": 6461.43, "timestamp": "01:47:41", "text": "明らかに筋肉質なママ。"}, {"type": "subtitle", "time": 6463.83, "timestamp": "01:47:43", "text": "一体私は何を言っているんだ？でも、"}, {"type": "subtitle", "time": 6465.59, "timestamp": "01:47:45", "text": "よし。ビデオゲームのキャラクターの名前を挙げてください"}, {"type": "subtitle", "time": 6468.55, "timestamp": "01:47:48", "text": "お前はセックスしたいんだろ。"}, {"type": "subtitle", "time": 6472.55, "timestamp": "01:47:52", "text": "何てことだ。あるいは少なくともロマンチックな"}]
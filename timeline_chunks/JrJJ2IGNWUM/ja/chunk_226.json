[{"type": "subtitle", "time": 13561.67, "timestamp": "03:46:01", "text": "ニース。"}, {"type": "subtitle", "time": 13565.79, "timestamp": "03:46:05", "text": "そこには何があるのですか？ 1つ減った。でも私は"}, {"type": "subtitle", "time": 13568.03, "timestamp": "03:46:08", "text": "それ。家"}, {"type": "subtitle", "time": 13585.51, "timestamp": "03:46:25", "text": "そうそう。そうそう。我々には敵がいる。私"}, {"type": "subtitle", "time": 13586.51, "timestamp": "03:46:26", "text": "悪いものを手に入れた"}, {"type": "subtitle", "time": 13589.269, "timestamp": "03:46:29", "text": "みんな。さあ、やろう。今行ってる。だった"}, {"type": "subtitle", "time": 13591.83, "timestamp": "03:46:31", "text": "一人ではない。ここに悪者がいる。ああ、"}, {"type": "subtitle", "time": 13595.349, "timestamp": "03:46:35", "text": "後ろから。まだ終わってないよ。試してみてください"}, {"type": "subtitle", "time": 13597.349, "timestamp": "03:46:37", "text": "こちらです。"}, {"type": "subtitle", "time": 13600.389, "timestamp": "03:46:40", "text": "走れ、走れ、走れ。とにかく走れ。心配しないで。"}, {"type": "subtitle", "time": 13602.389, "timestamp": "03:46:42", "text": "シールドを充電中です。私は"}, {"type": "subtitle", "time": 13604.95, "timestamp": "03:46:44", "text": "あなたのもとへ行きます。"}, {"type": "subtitle", "time": 13608.95, "timestamp": "03:46:48", "text": "蘇生を試みてもいいですよ。"}, {"type": "subtitle", "time": 13610.79, "timestamp": "03:46:50", "text": "大丈夫。誰も見ていなかったと思う"}, {"type": "subtitle", "time": 13617.79, "timestamp": "03:46:57", "text": "うわ、シールドが少なくなってきた。私は持っていますか"}]
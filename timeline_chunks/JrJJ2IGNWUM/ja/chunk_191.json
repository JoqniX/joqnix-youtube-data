[{"type": "subtitle", "time": 11461.71, "timestamp": "03:11:01", "text": "ああ、バトルパスか何かにお金を払ったんだね"}, {"type": "subtitle", "time": 11466.83, "timestamp": "03:11:06", "text": "無料？このスキンを購入できる"}, {"type": "subtitle", "time": 11471.99, "timestamp": "03:11:11", "text": "工作材料から。ああ、それは"}, {"type": "subtitle", "time": 11474.67, "timestamp": "03:11:14", "text": "偶数"}, {"type": "subtitle", "time": 11478.91, "timestamp": "03:11:18", "text": "いいね"}, {"type": "subtitle", "time": 11483.349, "timestamp": "03:11:23", "text": "1,600のクラフト素材があれば購入できます"}, {"type": "subtitle", "time": 11485.309, "timestamp": "03:11:25", "text": "それを"}, {"type": "subtitle", "time": 11491.63, "timestamp": "03:11:31", "text": "イベント、そして今、あなたは支払う必要があります"}, {"type": "subtitle", "time": 11494.03, "timestamp": "03:11:34", "text": "1,800 エイペックス"}, {"type": "subtitle", "time": 11500.95, "timestamp": "03:11:40", "text": "はぁ？この男、なんでこんなにカッコいいんだ？"}, {"type": "subtitle", "time": 11503.83, "timestamp": "03:11:43", "text": "伝説のスキルスキン付き？彼は"}, {"type": "subtitle", "time": 11507.91, "timestamp": "03:11:47", "text": "まるで金持ちのように。これは、えーと、スズメです。"}, {"type": "subtitle", "time": 11511.99, "timestamp": "03:11:51", "text": "くそ。はい。私はデビルメイクライが好きです"}, {"type": "subtitle", "time": 11515.11, "timestamp": "03:11:55", "text": "一種の参考資料。吸血鬼みたいな"}, {"type": "subtitle", "time": 11517.67, "timestamp": "03:11:57", "text": "メッカのような肌。"}]
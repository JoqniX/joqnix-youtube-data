[{"type": "subtitle", "time": 9187.95, "timestamp": "02:33:07", "text": "[音楽]"}, {"type": "subtitle", "time": 9194.67, "timestamp": "02:33:14", "text": "一瞬。おお"}, {"type": "subtitle", "time": 9197.91, "timestamp": "02:33:17", "text": "男の子。もし私がそう聞こえたら気にしないでください"}, {"type": "subtitle", "time": 9201.75, "timestamp": "02:33:21", "text": "今は心が死んでる、だって私は"}, {"type": "subtitle", "time": 9203.12, "timestamp": "02:33:23", "text": "今、中にいます。"}, {"type": "subtitle", "time": 9204.75, "timestamp": "02:33:24", "text": "[音楽]"}, {"type": "subtitle", "time": 9207.63, "timestamp": "02:33:27", "text": "ええ、そうですね。"}, {"type": "subtitle", "time": 9212.349, "timestamp": "02:33:32", "text": "あぁ、ツイートするのも忘れてた。"}, {"type": "subtitle", "time": 9219.23, "timestamp": "02:33:39", "text": "[音楽]"}, {"type": "subtitle", "time": 9222.11, "timestamp": "02:33:42", "text": "ああ、この神。 1つ"}, {"type": "subtitle", "time": 9226.67, "timestamp": "02:33:46", "text": "2番。どうしてツイートし忘れたんだろう"}, {"type": "subtitle", "time": 9227.79, "timestamp": "02:33:47", "text": "それ？"}]
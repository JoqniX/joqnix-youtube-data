[{"type": "subtitle", "time": 14712.07, "timestamp": "04:05:12", "text": "よしよし、よしよし。悪い奴らが何人かいる"}, {"type": "subtitle", "time": 14713.429, "timestamp": "04:05:13", "text": "ここ。私がそちらへ行きます。私は行く"}, {"type": "subtitle", "time": 14725.349, "timestamp": "04:05:25", "text": "来て。"}, {"type": "subtitle", "time": 14727.11, "timestamp": "04:05:27", "text": "おお、"}, {"type": "subtitle", "time": 14736.309, "timestamp": "04:05:36", "text": "ああ、"}, {"type": "subtitle", "time": 14754.79, "timestamp": "04:05:54", "text": "待って、Apexの体力は200じゃないよ。"}]
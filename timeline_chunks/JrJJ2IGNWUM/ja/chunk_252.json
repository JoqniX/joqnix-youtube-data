[{"type": "subtitle", "time": 15131.03, "timestamp": "04:12:11", "text": "あなただけのために。"}, {"type": "subtitle", "time": 15153.03, "timestamp": "04:12:33", "text": "よし、もっと早く行けるよ。さあ行こう"}, {"type": "subtitle", "time": 15155.83, "timestamp": "04:12:35", "text": "あちらで何が起こっているか見てみよう。待って、絶対に"}, {"type": "subtitle", "time": 15172.95, "timestamp": "04:12:52", "text": "あちらには新しい人材がいるかもしれない。"}, {"type": "subtitle", "time": 15174.71, "timestamp": "04:12:54", "text": "これはリスポーンビーコンを引き継ぐ"}, {"type": "subtitle", "time": 15177.75, "timestamp": "04:12:57", "text": "そこには。アップグレードしました。満ち足りた気持ち"}]
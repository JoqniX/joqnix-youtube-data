[{"type": "subtitle", "time": 3180.47, "timestamp": "00:53:00", "text": "後で食べるつもりです。"}, {"type": "subtitle", "time": 3183.19, "timestamp": "00:53:03", "text": "でも、私は辛いものを食べるのが大好きなんです"}, {"type": "subtitle", "time": 3184.95, "timestamp": "00:53:04", "text": "私自身もあまり影響を受けないから"}, {"type": "subtitle", "time": 3187.829, "timestamp": "00:53:07", "text": "彼らによって多くがもたらされた。時々"}, {"type": "subtitle", "time": 3190.71, "timestamp": "00:53:10", "text": "風味はスパイスの中に隠されている。"}, {"type": "subtitle", "time": 3192.39, "timestamp": "00:53:12", "text": "でも、普通の人にとっては、"}, {"type": "subtitle", "time": 3193.99, "timestamp": "00:53:13", "text": "スパイスが他のすべてを圧倒する"}, {"type": "subtitle", "time": 3195.589, "timestamp": "00:53:15", "text": "フレーバー。"}, {"type": "subtitle", "time": 3197.349, "timestamp": "00:53:17", "text": "でも私にとっては、私のパレットはあまりにも"}, {"type": "subtitle", "time": 3198.71, "timestamp": "00:53:18", "text": "以前は好きだった。それで、問題はここです。のように、"}, {"type": "subtitle", "time": 3200.15, "timestamp": "00:53:20", "text": "私たちフィリピン人はさまざまな"}, {"type": "subtitle", "time": 3202.23, "timestamp": "00:53:22", "text": "文化、しかし時々あなたが"}, {"type": "subtitle", "time": 3206.069, "timestamp": "00:53:26", "text": "特定の地域では、人々はあなたが"}, {"type": "subtitle", "time": 3210.19, "timestamp": "00:53:30", "text": "辛い唐辛子を食べるのが大好きです。"}, {"type": "subtitle", "time": 3214.39, "timestamp": "00:53:34", "text": "そして私もたまたま子孫なんです"}, {"type": "subtitle", "time": 3217.349, "timestamp": "00:53:37", "text": "その地域の人々から。そして"}, {"type": "subtitle", "time": 3221.63, "timestamp": "00:53:41", "text": "私の味覚は"}, {"type": "subtitle", "time": 3224.95, "timestamp": "00:53:44", "text": "巨大な、なんていう名前だっけ？ええと、巨大な"}, {"type": "subtitle", "time": 3228.309, "timestamp": "00:53:48", "text": "カプサイシンに対する耐性。私の喉はそうではありません。"}, {"type": "subtitle", "time": 3230.069, "timestamp": "00:53:50", "text": "だから、私たちはいつでも好きな時に"}, {"type": "subtitle", "time": 3232.23, "timestamp": "00:53:52", "text": "ホットソースをかけるやつだよね？覚えておいてください"}, {"type": "subtitle", "time": 3233.99, "timestamp": "00:53:53", "text": "ホットソースを飲んだ時のヴァレラント"}, {"type": "subtitle", "time": 3236.549, "timestamp": "00:53:56", "text": "時々？ええと、私はまだ持っています"}, {"type": "subtitle", "time": 3238.79, "timestamp": "00:53:58", "text": "しゃっくりはするけど、辛さは感じない"}]
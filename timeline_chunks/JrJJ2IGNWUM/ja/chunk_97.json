[{"type": "subtitle", "time": 5820.629, "timestamp": "01:37:00", "text": "理論過多な心理学タイプ。"}, {"type": "subtitle", "time": 5823.59, "timestamp": "01:37:03", "text": "ああ、理論が多すぎる。うん。私は"}, {"type": "subtitle", "time": 5824.95, "timestamp": "01:37:04", "text": "映画を実際に見たことがない"}, {"type": "subtitle", "time": 5826.87, "timestamp": "01:37:06", "text": "インセプションやそういうタイプの映画は今まで見たことがない"}, {"type": "subtitle", "time": 5829.95, "timestamp": "01:37:09", "text": "彼らを見た。私が知っているのは、私が感じていることだけです"}, {"type": "subtitle", "time": 5833.109, "timestamp": "01:37:13", "text": "ほら、あのシーンがあるでしょ？"}, {"type": "subtitle", "time": 5837.669, "timestamp": "01:37:17", "text": "えーと、エンドゲームの映画みたいに"}, {"type": "subtitle", "time": 5840.55, "timestamp": "01:37:20", "text": "マーベルから、たとえ"}, {"type": "subtitle", "time": 5843.51, "timestamp": "01:37:23", "text": "赤ちゃんのサノスのように殺すと、"}, {"type": "subtitle", "time": 5845.189, "timestamp": "01:37:25", "text": "タイムラインを本当に変更します"}, {"type": "subtitle", "time": 5847.95, "timestamp": "01:37:27", "text": "相殺して現実にする"}, {"type": "subtitle", "time": 5850.95, "timestamp": "01:37:30", "text": "どこがそうじゃないか？ ああ、それがどういうことか分かるよ"}, {"type": "subtitle", "time": 5852.55, "timestamp": "01:37:32", "text": "それは迷惑だろう、なぜならそれは"}, {"type": "subtitle", "time": 5854.629, "timestamp": "01:37:34", "text": "他のすべての理論に反論し、"}, {"type": "subtitle", "time": 5856.95, "timestamp": "01:37:36", "text": "1つに固執しなければ、"}, {"type": "subtitle", "time": 5859.109, "timestamp": "01:37:39", "text": "まず、筋の通ったストーリー展開が必要だ。ええ、私は"}, {"type": "subtitle", "time": 5861.109, "timestamp": "01:37:41", "text": "人々がなぜそうするのか、私は理解できます。"}, {"type": "subtitle", "time": 5864.87, "timestamp": "01:37:44", "text": "気持ち悪いと思うけど、よくわからない。"}, {"type": "subtitle", "time": 5866.79, "timestamp": "01:37:46", "text": "新しいものを見るのは楽しい気がする"}, {"type": "subtitle", "time": 5869.109, "timestamp": "01:37:49", "text": "タイムトラベルの仕組みに関する見解、"}, {"type": "subtitle", "time": 5871.51, "timestamp": "01:37:51", "text": "でも、すでに決まったアイデアがあるなら"}, {"type": "subtitle", "time": 5873.669, "timestamp": "01:37:53", "text": "タイムトラベルの仕組みについてのあなたの考えと"}, {"type": "subtitle", "time": 5875.83, "timestamp": "01:37:55", "text": "あなたが望むように動作させることができます。あなたと同じように感じます"}, {"type": "subtitle", "time": 5878.07, "timestamp": "01:37:58", "text": "他の理論にうんざりするだけ"}, {"type": "subtitle", "time": 5878.91, "timestamp": "01:37:58", "text": "そして"}]
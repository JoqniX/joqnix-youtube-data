[{"type": "subtitle", "time": 5102.91, "timestamp": "01:25:02", "text": "レベル。うん。ええ、そうですね。さらに、さらに彼らは"}, {"type": "subtitle", "time": 5107.43, "timestamp": "01:25:07", "text": "アメリカ人の方が好きだ。"}, {"type": "subtitle", "time": 5110.149, "timestamp": "01:25:10", "text": "英語のように。うん、"}, {"type": "subtitle", "time": 5111.75, "timestamp": "01:25:11", "text": "私はアジア人なので、それは決して"}, {"type": "subtitle", "time": 5114.629, "timestamp": "01:25:14", "text": "仕事。"}, {"type": "subtitle", "time": 5116.99, "timestamp": "01:25:16", "text": "私は絶対に"}, {"type": "subtitle", "time": 5119.35, "timestamp": "01:25:19", "text": "フィリピン人。まあ、そうですね。ああ、"}, {"type": "subtitle", "time": 5121.03, "timestamp": "01:25:21", "text": "ええ、コットはこう言っています。「私はむしろ"}, {"type": "subtitle", "time": 5122.79, "timestamp": "01:25:22", "text": "アルコールよりもコーヒーを飲む。コーヒーは"}, {"type": "subtitle", "time": 5124.79, "timestamp": "01:25:24", "text": "「俺にとってはアルコールが一番だ。」ああ、そうだな。"}, {"type": "subtitle", "time": 5126.709, "timestamp": "01:25:26", "text": "理解できます。私は次のような人たちを見てきました"}, {"type": "subtitle", "time": 5129.75, "timestamp": "01:25:29", "text": "コーヒーをがぶ飲みする。えっと、あなたはこう感じませんか？"}, {"type": "subtitle", "time": 5131.35, "timestamp": "01:25:31", "text": "えっと、問題はここですよね？あなたは開発します"}, {"type": "subtitle", "time": 5133.11, "timestamp": "01:25:33", "text": "コーヒーに対する何らかの抵抗"}, {"type": "subtitle", "time": 5134.95, "timestamp": "01:25:34", "text": "しばらくするとカフェインの効果が薄れてくる"}, {"type": "subtitle", "time": 5136.87, "timestamp": "01:25:36", "text": "大ヒットした。だって、私が気づいたのはそういうことなんだもん"}, {"type": "subtitle", "time": 5138.229, "timestamp": "01:25:38", "text": "他の友達と一緒"}, {"type": "subtitle", "time": 5139.75, "timestamp": "01:25:39", "text": "だって、コーヒーを飲むたびに"}, {"type": "subtitle", "time": 5141.99, "timestamp": "01:25:41", "text": "同じ効果を得るには2、3杯飲むのが良いでしょう"}, {"type": "subtitle", "time": 5143.99, "timestamp": "01:25:43", "text": "一杯飲んだ時と同じくらいハイになる"}, {"type": "subtitle", "time": 5150.95, "timestamp": "01:25:50", "text": "私はオーストラリアのVTuberを知っています"}, {"type": "subtitle", "time": 5153.27, "timestamp": "01:25:53", "text": "日本人英語教師。それは"}, {"type": "subtitle", "time": 5155.75, "timestamp": "01:25:55", "text": "本物。ああ、それは本当だ。だからあなたは"}]
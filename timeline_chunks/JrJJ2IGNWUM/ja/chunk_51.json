[{"type": "subtitle", "time": 3062.23, "timestamp": "00:51:02", "text": "スティング。つまり、スティングはラズベリーみたいなものだ"}, {"type": "subtitle", "time": 3064.95, "timestamp": "00:51:04", "text": "風味付きホリン入り飲料。同じ"}, {"type": "subtitle", "time": 3066.39, "timestamp": "00:51:06", "text": "コブラ入りだけど、イチゴ味じゃない"}, {"type": "subtitle", "time": 3068.15, "timestamp": "00:51:08", "text": "風味付き。ええ、イチゴはありますよ"}, {"type": "subtitle", "time": 3070.79, "timestamp": "00:51:10", "text": "味はありますが、通常はただ奇妙なだけです"}, {"type": "subtitle", "time": 3074.069, "timestamp": "00:51:14", "text": "変な尿みたいな色のやつ。私は"}, {"type": "subtitle", "time": 3075.67, "timestamp": "00:51:15", "text": "その味がどんなものか知っている。"}, {"type": "subtitle", "time": 3077.95, "timestamp": "00:51:17", "text": "これは尿の色をしている。私が言いたいのはそれだけです"}, {"type": "subtitle", "time": 3080.309, "timestamp": "00:51:20", "text": "覚えて。ちょうどアールグレイを飲んでいたところだった"}, {"type": "subtitle", "time": 3081.23, "timestamp": "00:51:21", "text": "今。"}, {"type": "subtitle", "time": 3083.99, "timestamp": "00:51:23", "text": "ニース。率直に言って、私は私は私は私は"}, {"type": "subtitle", "time": 3086.71, "timestamp": "00:51:26", "text": "お茶好きの男。私はラズベリーティーが好きです。私は"}, {"type": "subtitle", "time": 3089.67, "timestamp": "00:51:29", "text": "以前ラズベリーティーを飲んだことがあり、オレガノも"}, {"type": "subtitle", "time": 3093.27, "timestamp": "00:51:33", "text": "お茶。私はそれらが好きです。おお、"}, {"type": "subtitle", "time": 3095.589, "timestamp": "00:51:35", "text": "でも、必ずしも探しているわけではない"}, {"type": "subtitle", "time": 3097.75, "timestamp": "00:51:37", "text": "最初から彼らを。私はそれらが好きですが、"}, {"type": "subtitle", "time": 3099.67, "timestamp": "00:51:39", "text": "それらは私の定番ではないし、私の"}, {"type": "subtitle", "time": 3102.63, "timestamp": "00:51:42", "text": "飲み物を買う際の第一候補。"}, {"type": "subtitle", "time": 3104.23, "timestamp": "00:51:44", "text": "うん。さらに、ここでは飲み物も安いです。"}, {"type": "subtitle", "time": 3107.03, "timestamp": "00:51:47", "text": "とにかく。大きな"}, {"type": "subtitle", "time": 3110.47, "timestamp": "00:51:50", "text": "1ドルくらいで飲み物が飲める。"}, {"type": "subtitle", "time": 3112.95, "timestamp": "00:51:52", "text": "それはいいですね。そういうの知ってるでしょ"}, {"type": "subtitle", "time": 3117.51, "timestamp": "00:51:57", "text": "変なポップアップ式のタピオカミルクティーみたいなやつ？"}, {"type": "subtitle", "time": 3119.109, "timestamp": "00:51:59", "text": "うん。私は普段そこから購入します"}]
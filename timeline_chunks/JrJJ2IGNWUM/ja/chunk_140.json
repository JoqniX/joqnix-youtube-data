[{"type": "subtitle", "time": 8420.92, "timestamp": "02:20:20", "text": "行く。戻ってきました。戻ってきました。行く。"}, {"type": "subtitle", "time": 8422.27, "timestamp": "02:20:22", "text": "[音楽]"}, {"type": "subtitle", "time": 8429.51, "timestamp": "02:20:29", "text": "ごめん。私は先に尋ねるべきだった"}, {"type": "subtitle", "time": 8431.51, "timestamp": "02:20:31", "text": "いとこが望んだので配信を始めました"}, {"type": "subtitle", "time": 8436.63, "timestamp": "02:20:36", "text": "彼は外出する必要があり、一人で行かなければならない。"}, {"type": "subtitle", "time": 8439.19, "timestamp": "02:20:39", "text": "ストリームを止めることはできないよ"}, {"type": "subtitle", "time": 8443.03, "timestamp": "02:20:43", "text": "今ですよね？私は彼に、私が好きだと言った"}, {"type": "subtitle", "time": 8445.71, "timestamp": "02:20:45", "text": "たくさん謝る。"}, {"type": "subtitle", "time": 8456.23, "timestamp": "02:20:56", "text": "行く。またズキ病にかかったの？"}, {"type": "subtitle", "time": 8458.11, "timestamp": "02:20:58", "text": "ズキは"}]
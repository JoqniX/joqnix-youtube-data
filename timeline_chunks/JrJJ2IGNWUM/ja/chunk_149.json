[{"type": "subtitle", "time": 8942.79, "timestamp": "02:29:02", "text": "そう、一番長い部分は"}, {"type": "subtitle", "time": 8945.07, "timestamp": "02:29:05", "text": "ゲームで見たのは"}, {"type": "subtitle", "time": 8948.03, "timestamp": "02:29:08", "text": "パート60のように、"}, {"type": "subtitle", "time": 8950.429, "timestamp": "02:29:10", "text": "何かだが、一部ではない"}, {"type": "subtitle", "time": 8953.99, "timestamp": "02:29:13", "text": "パート60ではないけれど、つまり、"}, {"type": "subtitle", "time": 8957.11, "timestamp": "02:29:17", "text": "全体的に"}, {"type": "subtitle", "time": 8961.95, "timestamp": "02:29:21", "text": "ゲームは最後まで部分的に"}, {"type": "subtitle", "time": 8964.99, "timestamp": "02:29:24", "text": "そうですが、彼らはそれをナレーションして編集します"}, {"type": "subtitle", "time": 8968.63, "timestamp": "02:29:28", "text": "60歳ではない、現在の年齢は覚えていない"}, {"type": "subtitle", "time": 8971.63, "timestamp": "02:29:31", "text": "数だが"}, {"type": "subtitle", "time": 8975.87, "timestamp": "02:29:35", "text": "ええ、少なくとも20くらいですね。"}, {"type": "subtitle", "time": 8978.75, "timestamp": "02:29:38", "text": "右。音声レベルはどうですか？"}, {"type": "subtitle", "time": 8981.99, "timestamp": "02:29:41", "text": "実は？あの、ゲームの音が大きすぎますか？は"}, {"type": "subtitle", "time": 8984.389, "timestamp": "02:29:44", "text": "私のマイク、私のマイク、マイクを変更できません。"}, {"type": "subtitle", "time": 8986.87, "timestamp": "02:29:46", "text": "でも、もしよろしければ、もっと下げることもできますよ。"}, {"type": "subtitle", "time": 8988.349, "timestamp": "02:29:48", "text": "の"}, {"type": "subtitle", "time": 8996.07, "timestamp": "02:29:56", "text": "これ。音楽の音量が大きいかどうかはわかりません。私"}, {"type": "subtitle", "time": 8999.27, "timestamp": "02:29:59", "text": "わからない。ゲームの音がうるさい。私に任せてください"}]
[{"type": "subtitle", "time": 3304.069, "timestamp": "00:55:04", "text": "お茶。私はただ食べるだけです。私はただ先に進む"}, {"type": "subtitle", "time": 3306.87, "timestamp": "00:55:06", "text": "それから、ジュベリー。あなたは持っていますか"}, {"type": "subtitle", "time": 3309.19, "timestamp": "00:55:09", "text": "それ？まるでゼリーみたいだ。"}, {"type": "subtitle", "time": 3311.19, "timestamp": "00:55:11", "text": "まあ、実際には柔らかいゼリーではないですね。まるで"}, {"type": "subtitle", "time": 3313.91, "timestamp": "00:55:13", "text": "上にブルーベリーゼリーのようなものが乗っていて"}, {"type": "subtitle", "time": 3318.589, "timestamp": "00:55:18", "text": "えっと、なんていう名前だったっけ？のように"}, {"type": "subtitle", "time": 3321.99, "timestamp": "00:55:21", "text": "真ん中にバニラアイシング、そして"}, {"type": "subtitle", "time": 3324.63, "timestamp": "00:55:24", "text": "ビスケット。うん、それいいよね。私は好きです"}, {"type": "subtitle", "time": 3327.069, "timestamp": "00:55:27", "text": "それをコーヒーと一緒にいただきます。"}, {"type": "subtitle", "time": 3330.309, "timestamp": "00:55:30", "text": "おお、美味しそうですね。"}, {"type": "subtitle", "time": 3332.95, "timestamp": "00:55:32", "text": "そうです。私は食べる 私はここで、"}, {"type": "subtitle", "time": 3334.79, "timestamp": "00:55:34", "text": "右？私と私の家族はいくつかの"}, {"type": "subtitle", "time": 3337.51, "timestamp": "00:55:37", "text": "食べ物が好きです。父が2つくらい買った"}, {"type": "subtitle", "time": 3339.43, "timestamp": "00:55:39", "text": "パック。彼は一つも食べていない"}, {"type": "subtitle", "time": 3343.19, "timestamp": "00:55:43", "text": "だって、私はスパムメールを大量に食べてたから。"}, {"type": "subtitle", "time": 3347.03, "timestamp": "00:55:47", "text": "何てことだ。うん。右。だって、"}, {"type": "subtitle", "time": 3348.23, "timestamp": "00:55:48", "text": "さて、問題はここですよね？私はただ"}, {"type": "subtitle", "time": 3349.75, "timestamp": "00:55:49", "text": "お茶を飲みたいときはいつでも"}, {"type": "subtitle", "time": 3353.109, "timestamp": "00:55:53", "text": "私は健康的な飲み物を飲んでいます。私はお茶が好きです。聞く"}, {"type": "subtitle", "time": 3355.19, "timestamp": "00:55:55", "text": "私を外します。私はお茶が好きです。もし私が"}, {"type": "subtitle", "time": 3356.95, "timestamp": "00:55:56", "text": "それを飲む選択肢があり、私は"}]
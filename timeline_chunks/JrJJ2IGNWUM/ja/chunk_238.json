[{"type": "subtitle", "time": 14282.87, "timestamp": "03:58:02", "text": "6月末。先週は荷造りをしなくてはならない"}, {"type": "subtitle", "time": 14285.79, "timestamp": "03:58:05", "text": "すべて。"}, {"type": "subtitle", "time": 14297.349, "timestamp": "03:58:17", "text": "あなたが勉強してきたことを願っています"}, {"type": "subtitle", "time": 14299.189, "timestamp": "03:58:19", "text": "研究。今、私は真剣にならなければならない"}, {"type": "subtitle", "time": 14302.309, "timestamp": "03:58:22", "text": "私がそこにいる時ならいつでも。私はできません、私は"}, {"type": "subtitle", "time": 14306.63, "timestamp": "03:58:26", "text": "マスター、今でも好きになれない"}, {"type": "subtitle", "time": 14308.51, "timestamp": "03:58:28", "text": "後悔はしない"}, {"type": "subtitle", "time": 14310.51, "timestamp": "03:58:30", "text": "おそらく"}, {"type": "subtitle", "time": 14313.389, "timestamp": "03:58:33", "text": "試験。私は"}, {"type": "subtitle", "time": 14316.07, "timestamp": "03:58:36", "text": "勉強する。私はこれら全てをやっている"}, {"type": "subtitle", "time": 14324.63, "timestamp": "03:58:44", "text": "すべて。でも、私は"}, {"type": "subtitle", "time": 14327.07, "timestamp": "03:58:47", "text": "やってみます"}, {"type": "subtitle", "time": 14334.389, "timestamp": "03:58:54", "text": "うん。そこへ行こう。そちら側。見た目"}]
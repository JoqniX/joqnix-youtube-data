[{"type": "subtitle", "time": 2101.19, "timestamp": "00:35:01", "text": "私たちが持っている奇妙なアルゴリズムは"}, {"type": "subtitle", "time": 2104.55, "timestamp": "00:35:04", "text": "昔のYouTube 2007年頃のやつみたいな感じ、"}, {"type": "subtitle", "time": 2106.63, "timestamp": "00:35:06", "text": "右？"}, {"type": "subtitle", "time": 2108.39, "timestamp": "00:35:08", "text": "でも、もしあなたが古いものを探しているなら"}, {"type": "subtitle", "time": 2111.43, "timestamp": "00:35:11", "text": "学校のウェブサイト、ほら、あれみたいな"}, {"type": "subtitle", "time": 2115.51, "timestamp": "00:35:15", "text": "スプラッシュアートランダムなウェブサイト"}, {"type": "subtitle", "time": 2117.109, "timestamp": "00:35:17", "text": "それはプロらしく見えないし、"}, {"type": "subtitle", "time": 2120.51, "timestamp": "00:35:20", "text": "まるでクリップアートの集まりみたいで、"}, {"type": "subtitle", "time": 2124.069, "timestamp": "00:35:24", "text": "骸骨の贈り物のようなもの。"}, {"type": "subtitle", "time": 2126.109, "timestamp": "00:35:26", "text": "ただ"}, {"type": "subtitle", "time": 2131.03, "timestamp": "00:35:31", "text": "そう、あの頃は"}, {"type": "subtitle", "time": 2132.51, "timestamp": "00:35:32", "text": "そう見た"}, {"type": "subtitle", "time": 2136.71, "timestamp": "00:35:36", "text": "非常に不快なこと"}, {"type": "subtitle", "time": 2139.19, "timestamp": "00:35:39", "text": "私の性格の一部になる。私"}, {"type": "subtitle", "time": 2141.75, "timestamp": "00:35:41", "text": "目を離すことができない。ああ、まるで"}, {"type": "subtitle", "time": 2143.99, "timestamp": "00:35:43", "text": "当時4chanはそれほど"}, {"type": "subtitle", "time": 2146.23, "timestamp": "00:35:46", "text": "クソみたいな場所だ。つまり、それはまだ"}, {"type": "subtitle", "time": 2148.069, "timestamp": "00:35:48", "text": "相変わらずひどい場所だったが、"}, {"type": "subtitle", "time": 2149.829, "timestamp": "00:35:49", "text": "当時はひどい場所だった。 4chanを使っていますか？"}, {"type": "subtitle", "time": 2153.349, "timestamp": "00:35:53", "text": "騎手？数回使用しました"}, {"type": "subtitle", "time": 2155.589, "timestamp": "00:35:55", "text": "そして私は、しかしあなたは自分自身を関連付けません"}, {"type": "subtitle", "time": 2157.27, "timestamp": "00:35:57", "text": "そこでチャットしたりしない"}, {"type": "subtitle", "time": 2158.71, "timestamp": "00:35:58", "text": "そこでチャットしたり、コメントしたり、いろいろやっています。"}]
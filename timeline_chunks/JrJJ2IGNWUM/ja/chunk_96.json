[{"type": "subtitle", "time": 5763.27, "timestamp": "01:36:03", "text": "問題があって、いつもああ"}, {"type": "subtitle", "time": 5766.629, "timestamp": "01:36:06", "text": "私は虐待を受け、そして今私は去った"}, {"type": "subtitle", "time": 5768.709, "timestamp": "01:36:08", "text": "あの英雄パーティーは私がいなくて苦戦している"}, {"type": "subtitle", "time": 5770.47, "timestamp": "01:36:10", "text": "そして彼らは私に戻ってきてほしいと思っていて、いつも"}, {"type": "subtitle", "time": 5772.99, "timestamp": "01:36:12", "text": "同じクソみたいなことを何度も繰り返す"}, {"type": "subtitle", "time": 5776.79, "timestamp": "01:36:16", "text": "また。でも、私にとってはやっぱり楽しいですよね？"}, {"type": "subtitle", "time": 5778.629, "timestamp": "01:36:18", "text": "ストーリー展開がどうであれ、私は気にしません。"}, {"type": "subtitle", "time": 5780.47, "timestamp": "01:36:20", "text": "繰り返し。私は気にしません"}, {"type": "subtitle", "time": 5782.149, "timestamp": "01:36:22", "text": "キャラクターは基本的にコピペです"}, {"type": "subtitle", "time": 5784.95, "timestamp": "01:36:24", "text": "もう一方から、そしてメインのように"}, {"type": "subtitle", "time": 5787.03, "timestamp": "01:36:27", "text": "ヒーローパーティーはまるでバカの集まりみたいだ"}, {"type": "subtitle", "time": 5789.59, "timestamp": "01:36:29", "text": "そして新しい部分はいつもクソだ"}, {"type": "subtitle", "time": 5791.99, "timestamp": "01:36:31", "text": "以前のものより優れている。おい、"}, {"type": "subtitle", "time": 5794.55, "timestamp": "01:36:34", "text": "私は気にしない。読んでいて楽しいです。"}, {"type": "subtitle", "time": 5796.39, "timestamp": "01:36:36", "text": "右？うん。あなたはどうですか？"}, {"type": "subtitle", "time": 5798.79, "timestamp": "01:36:38", "text": "ジャッキー？異世界タイプ以外には何が"}, {"type": "subtitle", "time": 5801.27, "timestamp": "01:36:41", "text": "クソ、君はそれが考えられていると思う"}, {"type": "subtitle", "time": 5804.709, "timestamp": "01:36:44", "text": "みんながゴミだと思うけど、それでも楽しい"}, {"type": "subtitle", "time": 5806.59, "timestamp": "01:36:46", "text": "見るか"}, {"type": "subtitle", "time": 5811.83, "timestamp": "01:36:51", "text": "贅沢が好きですか？ああ、科学的な"}, {"type": "subtitle", "time": 5816.95, "timestamp": "01:36:56", "text": "ああ、タイムトラベルみたいなやつ"}]
[{"type": "subtitle", "time": 420.189, "timestamp": "00:07:00", "text": "人生について学び、人生がどのようなものであるかを学びます"}, {"type": "subtitle", "time": 422.629, "timestamp": "00:07:02", "text": "すべて。そうですね、そうだったらいいですね。"}, {"type": "subtitle", "time": 425.43, "timestamp": "00:07:05", "text": "お前。あなたは、"}, {"type": "subtitle", "time": 427.67, "timestamp": "00:07:07", "text": "外で起きている。あなたは強制されるでしょう"}, {"type": "subtitle", "time": 429.43, "timestamp": "00:07:09", "text": "外で何が起こっているのかを知る。"}, {"type": "subtitle", "time": 431.589, "timestamp": "00:07:11", "text": "はい。おばあちゃんと話す機会がずっと増えた"}, {"type": "subtitle", "time": 435.029, "timestamp": "00:07:15", "text": "今では、あなたが移動するとよくあります。"}, {"type": "subtitle", "time": 437.51, "timestamp": "00:07:17", "text": "うん。おい、あいつらはおばあちゃんだ"}, {"type": "subtitle", "time": 440.23, "timestamp": "00:07:20", "text": "容赦ない。あなたがどの国にいても"}, {"type": "subtitle", "time": 442.23, "timestamp": "00:07:22", "text": "実際には、それは問題ではない。おばあちゃんの、"}, {"type": "subtitle", "time": 444.39, "timestamp": "00:07:24", "text": "彼らはいつも何かしらの活動をしている。おお"}, {"type": "subtitle", "time": 446.629, "timestamp": "00:07:26", "text": "我が神よ。はい。彼らはいつも何かを持っている"}, {"type": "subtitle", "time": 448.79, "timestamp": "00:07:28", "text": "クレイジーな話か、いつも"}, {"type": "subtitle", "time": 451.27, "timestamp": "00:07:31", "text": "あなたを悩ませる何か。正直に言うと、"}, {"type": "subtitle", "time": 453.909, "timestamp": "00:07:33", "text": "ちょっと面白いね。予想外だった"}, {"type": "subtitle", "time": 456.629, "timestamp": "00:07:36", "text": "お年寄りは、とてもたくさんのものを持っている"}, {"type": "subtitle", "time": 458.75, "timestamp": "00:07:38", "text": "いろいろと起こっている。"}, {"type": "subtitle", "time": 460.79, "timestamp": "00:07:40", "text": "[音楽]"}, {"type": "subtitle", "time": 462.629, "timestamp": "00:07:42", "text": "彼らからはたくさんのゴシップが聞けるよ。"}, {"type": "subtitle", "time": 464.469, "timestamp": "00:07:44", "text": "うん。ああ、確かに。真実。そして多くの"}, {"type": "subtitle", "time": 468.469, "timestamp": "00:07:48", "text": "彼らもアドバイスをくれるんですよね？時々。"}, {"type": "subtitle", "time": 470.79, "timestamp": "00:07:50", "text": "うん、彼らは色々なことを経験してきたんだ、君も"}, {"type": "subtitle", "time": 475.27, "timestamp": "00:07:55", "text": "知る。はい。はい。ええ、それで私は"}, {"type": "subtitle", "time": 478.51, "timestamp": "00:07:58", "text": "まるで私が探し回ったように"}]
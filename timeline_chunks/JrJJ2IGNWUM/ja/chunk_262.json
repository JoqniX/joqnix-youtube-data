[{"type": "subtitle", "time": 15723.83, "timestamp": "04:22:03", "text": "匿名モードをオフにするにはどうすればいいですか？それは"}, {"type": "subtitle", "time": 15727.11, "timestamp": "04:22:07", "text": "オフ。なぜ名前が表示されないのか"}, {"type": "subtitle", "time": 15736.79, "timestamp": "04:22:16", "text": "おい、誰だ？待って、それはデュオだ。"}, {"type": "subtitle", "time": 15740.309, "timestamp": "04:22:20", "text": "え、本当に？うん。あ、待って。何てことだ。"}, {"type": "subtitle", "time": 15744.469, "timestamp": "04:22:24", "text": "実際は「一体どういうことだ？」です。"}, {"type": "subtitle", "time": 15746.189, "timestamp": "04:22:26", "text": "何？"}, {"type": "subtitle", "time": 15747.79, "timestamp": "04:22:27", "text": "兄弟、"}, {"type": "subtitle", "time": 15750.429, "timestamp": "04:22:30", "text": "兄弟。いいえ"}, {"type": "subtitle", "time": 15754.71, "timestamp": "04:22:34", "text": "方法。何てことだ。私の最初の3人のスナイパー。"}, {"type": "subtitle", "time": 15761.55, "timestamp": "04:22:41", "text": "何てことだ、"}, {"type": "subtitle", "time": 15764.429, "timestamp": "04:22:44", "text": "ロ。ああ、"}, {"type": "subtitle", "time": 15779.479, "timestamp": "04:22:59", "text": "ああ、 神。"}]
[{"type": "subtitle", "time": 29584.708, "timestamp": "08:13:04", "text": "again. Oh boy."}, {"type": "subtitle", "time": 29587.67, "timestamp": "08:13:07", "text": "Hi. Hi."}, {"type": "subtitle", "time": 29589.51, "timestamp": "08:13:09", "text": "I keep burping whenever I try to change"}, {"type": "subtitle", "time": 29591.788, "timestamp": "08:13:11", "text": "my vocal posture. After the anomaly was"}, {"type": "subtitle", "time": 29594.07, "timestamp": "08:13:14", "text": "discovered, miners began reporting"}, {"type": "subtitle", "time": 29596.868, "timestamp": "08:13:16", "text": "strange creatures roaming the area. Most"}, {"type": "subtitle", "time": 29598.948, "timestamp": "08:13:18", "text": "people think they were hallucinations,"}, {"type": "subtitle", "time": 29601.59, "timestamp": "08:13:21", "text": "but some think they were the headless"}, {"type": "subtitle", "time": 29608.11, "timestamp": "08:13:28", "text": "Well, at least they're only headless,"}, {"type": "subtitle", "time": 29612.03, "timestamp": "08:13:32", "text": "not, you know, something"}]
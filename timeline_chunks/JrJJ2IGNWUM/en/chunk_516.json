[{"type": "subtitle", "time": 30968.07, "timestamp": "08:36:08", "text": "Good. Waiting for my HP to respawn."}, {"type": "subtitle", "time": 30980.23, "timestamp": "08:36:20", "text": "I did not say that the headless ones"}, {"type": "subtitle", "time": 30982.868, "timestamp": "08:36:22", "text": "were created by the K1 anomaly. But"}, {"type": "subtitle", "time": 30985.11, "timestamp": "08:36:25", "text": "having seen the hive magic at work here,"}, {"type": "subtitle", "time": 30987.99, "timestamp": "08:36:27", "text": "I'm not so sure anymore."}, {"type": "subtitle", "time": 30991.11, "timestamp": "08:36:31", "text": "The lost. Sometimes the more mysterious"}, {"type": "subtitle", "time": 30994.548, "timestamp": "08:36:34", "text": "than the mystery. Yes. How many shards"}, {"type": "subtitle", "time": 30999.15, "timestamp": "08:36:39", "text": "are you on now? Nan, let me"}, {"type": "subtitle", "time": 31013.05, "timestamp": "08:36:53", "text": "two. Yay."}]
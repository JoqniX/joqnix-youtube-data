[{"type": "subtitle", "time": 11221.55, "timestamp": "03:07:01", "text": "[笑声]"}, {"type": "subtitle", "time": 11223.59, "timestamp": "03:07:03", "text": "我被迷你机枪打死了。直升机。"}, {"type": "subtitle", "time": 11239.229, "timestamp": "03:07:19", "text": "我做了。 1人。好的。"}, {"type": "subtitle", "time": 11239.99, "timestamp": "03:07:19", "text": "它在南边吗？"}, {"type": "subtitle", "time": 11240.71, "timestamp": "03:07:20", "text": "嘿。"}, {"type": "subtitle", "time": 11251.469, "timestamp": "03:07:31", "text": "是的。就是这样。"}, {"type": "subtitle", "time": 11253.19, "timestamp": "03:07:33", "text": "一个也没有"}, {"type": "subtitle", "time": 11259.269, "timestamp": "03:07:39", "text": "点。就这些吗？"}, {"type": "subtitle", "time": 11262.469, "timestamp": "03:07:42", "text": "他们来自不同的队伍。还有两个。"}, {"type": "subtitle", "time": 11263.429, "timestamp": "03:07:43", "text": "好的。他死了。"}, {"type": "subtitle", "time": 11264.07, "timestamp": "03:07:44", "text": "好的。 1人。"}, {"type": "subtitle", "time": 11267.07, "timestamp": "03:07:47", "text": "好的。好，好，好，好，好。"}, {"type": "subtitle", "time": 11271.87, "timestamp": "03:07:51", "text": "让我看看里面是什么样子。"}, {"type": "subtitle", "time": 11273.79, "timestamp": "03:07:53", "text": "是的。但我认为我会继续下去。南"}]
[{"type": "subtitle", "time": 8221.669, "timestamp": "02:17:01", "text": "奥戈斯狙击手。"}, {"type": "subtitle", "time": 8246.19, "timestamp": "02:17:26", "text": "我把它放进去了。"}, {"type": "subtitle", "time": 8249.11, "timestamp": "02:17:29", "text": "我可以接上电钻吗？哦，它不在那里。"}, {"type": "subtitle", "time": 8250.83, "timestamp": "02:17:30", "text": "不。制造。"}, {"type": "subtitle", "time": 8258.79, "timestamp": "02:17:38", "text": "34人。"}, {"type": "subtitle", "time": 8260.11, "timestamp": "02:17:40", "text": "这一切即将结束。绿色的"}, {"type": "subtitle", "time": 8262.669, "timestamp": "02:17:42", "text": "如果我们不运送乘客，这真的是个问题吗？"}, {"type": "subtitle", "time": 8265.11, "timestamp": "02:17:45", "text": "糟糕的。这能及时完成吗？我可以在这里购买保险吗？"}]
[{"type": "subtitle", "time": 13512.189, "timestamp": "03:45:12", "text": "我来发射迫击炮。哦，交给我吧。"}, {"type": "subtitle", "time": 13514.149, "timestamp": "03:45:14", "text": "哦，好的。我愿意做。我愿意做。"}, {"type": "subtitle", "time": 13516.149, "timestamp": "03:45:16", "text": "我无法原谅这件事。我无法原谅这件事。"}, {"type": "subtitle", "time": 13517.99, "timestamp": "03:45:17", "text": "强度核心"}, {"type": "subtitle", "time": 13518.99, "timestamp": "03:45:18", "text": "高速"}, {"type": "subtitle", "time": 13520.63, "timestamp": "03:45:20", "text": "制作钻头。"}, {"type": "subtitle", "time": 13521.95, "timestamp": "03:45:21", "text": "是的。就交给你了。"}, {"type": "subtitle", "time": 13540.349, "timestamp": "03:45:40", "text": "至少会有三个人做这件事。"}, {"type": "subtitle", "time": 13548.429, "timestamp": "03:45:48", "text": "我给你做一个。"}, {"type": "subtitle", "time": 13548.67, "timestamp": "03:45:48", "text": "2"}, {"type": "subtitle", "time": 13550.309, "timestamp": "03:45:50", "text": "我认为自己制作没问题。"}, {"type": "subtitle", "time": 13552.67, "timestamp": "03:45:52", "text": "办公室。"}, {"type": "subtitle", "time": 13554.51, "timestamp": "03:45:54", "text": "这么多人，大概"}, {"type": "subtitle", "time": 13557.309, "timestamp": "03:45:57", "text": "总有人会这么做的。"}]
[{"type": "subtitle", "time": 18961.83, "timestamp": "05:16:01", "text": "就这些吗？哦"}, {"type": "subtitle", "time": 18962.67, "timestamp": "05:16:02", "text": "哦，是的，有。"}, {"type": "subtitle", "time": 18963.35, "timestamp": "05:16:03", "text": "是的，我会。"}, {"type": "subtitle", "time": 18965.67, "timestamp": "05:16:05", "text": "早上好。"}, {"type": "subtitle", "time": 18977.75, "timestamp": "05:16:17", "text": "不，什么都做。我在那场直升机坠毁事故中丧生了。"}, {"type": "subtitle", "time": 18980.43, "timestamp": "05:16:20", "text": "他们还在这里。"}, {"type": "subtitle", "time": 18988.39, "timestamp": "05:16:28", "text": "好兄弟。好兄弟。"}, {"type": "subtitle", "time": 18990.11, "timestamp": "05:16:30", "text": "我可以先叫醒你吗？"}, {"type": "subtitle", "time": 18991.35, "timestamp": "05:16:31", "text": "我死了。对不起。"}, {"type": "subtitle", "time": 18998.75, "timestamp": "05:16:38", "text": "现在，他们正在一个接一个地叫醒他们。"}, {"type": "subtitle", "time": 19005.23, "timestamp": "05:16:45", "text": "我会给你钱。尖端。哦，等等。来。"}, {"type": "subtitle", "time": 19007.27, "timestamp": "05:16:47", "text": "哦。 500，"}, {"type": "subtitle", "time": 19010.59, "timestamp": "05:16:50", "text": "500 我的更高级。"}, {"type": "subtitle", "time": 19015.07, "timestamp": "05:16:55", "text": "这很糟糕。"}, {"type": "subtitle", "time": 19016.15, "timestamp": "05:16:56", "text": "这可能不太妙。"}]
[{"type": "subtitle", "time": 18361.19, "timestamp": "05:06:01", "text": "不，不，或许我们应该把它清理干净。"}, {"type": "subtitle", "time": 18379.07, "timestamp": "05:06:19", "text": "是的。"}, {"type": "subtitle", "time": 18383.948, "timestamp": "05:06:23", "text": "我懂了。"}, {"type": "subtitle", "time": 18404.31, "timestamp": "05:06:44", "text": "现在去太难了吗？"}, {"type": "subtitle", "time": 18407.19, "timestamp": "05:06:47", "text": "你怎么认为？你知道，我可以胜任门卫的工作。"}, {"type": "subtitle", "time": 18410.75, "timestamp": "05:06:50", "text": "哦真的吗？我马上打开。"}, {"type": "subtitle", "time": 18415.39, "timestamp": "05:06:55", "text": "我会复活。"}]
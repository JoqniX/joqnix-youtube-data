[{"type": "subtitle", "time": 12121.15, "timestamp": "03:22:01", "text": "啊，是那个。"}, {"type": "subtitle", "time": 12123.55, "timestamp": "03:22:03", "text": "看来我们别无选择，只能再转一圈了。嘿，我们。"}, {"type": "subtitle", "time": 12129.15, "timestamp": "03:22:09", "text": "鸬鹚，"}, {"type": "subtitle", "time": 12145.79, "timestamp": "03:22:25", "text": "哦，有人在那里放了东西。"}, {"type": "subtitle", "time": 12148.07, "timestamp": "03:22:28", "text": "我忘了带。"}, {"type": "subtitle", "time": 12149.99, "timestamp": "03:22:29", "text": "哦，太好了，你有锤子。"}, {"type": "subtitle", "time": 12167.63, "timestamp": "03:22:47", "text": "200米"}, {"type": "subtitle", "time": 12176.99, "timestamp": "03:22:56", "text": "时间上也是如此。我这就用锤子轻轻敲一下。"}]
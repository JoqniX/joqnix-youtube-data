[{"type": "subtitle", "time": 12205.469, "timestamp": "03:23:25", "text": "我们是不是该尽力把它找回来？"}, {"type": "subtitle", "time": 12209.95, "timestamp": "03:23:29", "text": "哦，我已经走了。"}, {"type": "subtitle", "time": 12210.15, "timestamp": "03:23:30", "text": "是的。"}, {"type": "subtitle", "time": 12222.189, "timestamp": "03:23:42", "text": "哦，如果你要给我一把锤子，我就收下吧。"}, {"type": "subtitle", "time": 12229.229, "timestamp": "03:23:49", "text": "哦哦哦。"}, {"type": "subtitle", "time": 12234.99, "timestamp": "03:23:54", "text": "我打算从西边付款。"}, {"type": "subtitle", "time": 12235.389, "timestamp": "03:23:55", "text": "哇，这太糟糕了。"}, {"type": "subtitle", "time": 12237.11, "timestamp": "03:23:57", "text": "哦，我把它放在伊莫桑旁边了。"}, {"type": "subtitle", "time": 12238.229, "timestamp": "03:23:58", "text": "好的。"}]
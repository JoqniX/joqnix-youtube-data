[{"type": "subtitle", "time": 8941.23, "timestamp": "02:29:01", "text": "啊，乔"}, {"type": "subtitle", "time": 8960.03, "timestamp": "02:29:20", "text": "嗯？这话是不是有点委婉？"}, {"type": "subtitle", "time": 8967.91, "timestamp": "02:29:27", "text": "是 Jock Jock 吗？好的。"}, {"type": "subtitle", "time": 8968.15, "timestamp": "02:29:28", "text": "是的。"}, {"type": "subtitle", "time": 8970.349, "timestamp": "02:29:30", "text": "请享用这道菜。"}, {"type": "subtitle", "time": 8970.67, "timestamp": "02:29:30", "text": "很高兴见到你。"}, {"type": "subtitle", "time": 8972.99, "timestamp": "02:29:32", "text": "Jock是个女孩。"}, {"type": "subtitle", "time": 8983.91, "timestamp": "02:29:43", "text": "惊人的。就像《阿尔卑斯山的少女海蒂》一样。"}, {"type": "subtitle", "time": 8985.07, "timestamp": "02:29:45", "text": "塞萨，"}, {"type": "subtitle", "time": 8986.63, "timestamp": "02:29:46", "text": "阿尔卑斯山的少女。"}, {"type": "subtitle", "time": 8987.71, "timestamp": "02:29:47", "text": "阿尔卑斯山就在那里。"}, {"type": "subtitle", "time": 8990.63, "timestamp": "02:29:50", "text": "这不是一场高山滑雪比赛。"}, {"type": "subtitle", "time": 8991.95, "timestamp": "02:29:51", "text": "匹配。"}, {"type": "subtitle", "time": 8993.91, "timestamp": "02:29:53", "text": "图片，"}, {"type": "subtitle", "time": 8996.469, "timestamp": "02:29:56", "text": "男子气概，火柴人之类的。"}, {"type": "subtitle", "time": 8996.91, "timestamp": "02:29:56", "text": "这是正确的。"}, {"type": "subtitle", "time": 8999.67, "timestamp": "02:29:59", "text": "我把大锤放进了脸书。 1 件"}]
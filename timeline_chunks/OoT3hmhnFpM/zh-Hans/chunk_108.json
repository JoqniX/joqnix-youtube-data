[{"type": "subtitle", "time": 6483.31, "timestamp": "01:48:03", "text": "狙击手。我同意。现在"}, {"type": "subtitle", "time": 6486.47, "timestamp": "01:48:06", "text": "西侧。啊，我们已经到达山顶了。这是铁矿石。"}, {"type": "subtitle", "time": 6487.79, "timestamp": "01:48:07", "text": "从救赎中。哦"}, {"type": "subtitle", "time": 6490.27, "timestamp": "01:48:10", "text": "嘿。哦，爸爸也来了。我们赢了。"}, {"type": "subtitle", "time": 6491.79, "timestamp": "01:48:11", "text": "哦，那太好了。"}, {"type": "subtitle", "time": 6496.31, "timestamp": "01:48:16", "text": "啊，在那儿。"}, {"type": "subtitle", "time": 6507.229, "timestamp": "01:48:27", "text": "362 [笑声]"}, {"type": "subtitle", "time": 6508.75, "timestamp": "01:48:28", "text": "我不知道他们会不会来。"}, {"type": "subtitle", "time": 6511.07, "timestamp": "01:48:31", "text": "就是这样。我会通过那位朋友加入。"}, {"type": "subtitle", "time": 6513.39, "timestamp": "01:48:33", "text": "当你以好友身份加入游戏时"}, {"type": "subtitle", "time": 6518.87, "timestamp": "01:48:38", "text": "我原谅你。愤怒的孩子"}, {"type": "subtitle", "time": 6521.27, "timestamp": "01:48:41", "text": "你刚才看到这附近有敌人吗？"}, {"type": "subtitle", "time": 6523.03, "timestamp": "01:48:43", "text": "他们似乎在保守这个秘密。"}, {"type": "subtitle", "time": 6523.47, "timestamp": "01:48:43", "text": "是的。"}, {"type": "subtitle", "time": 6525.43, "timestamp": "01:48:45", "text": "让我们从上方来看。"}, {"type": "subtitle", "time": 6529.07, "timestamp": "01:48:49", "text": "1"}, {"type": "subtitle", "time": 6531.03, "timestamp": "01:48:51", "text": "我以前在那里工作，但我认为我现在还在那里。"}, {"type": "subtitle", "time": 6535.91, "timestamp": "01:48:55", "text": "没有挽回的余地。"}, {"type": "subtitle", "time": 6537.75, "timestamp": "01:48:57", "text": "今天网络真的好卡。"}]
[{"type": "subtitle", "time": 20343.19, "timestamp": "05:39:03", "text": "好吧。伊玛桑"}, {"type": "subtitle", "time": 20354.03, "timestamp": "05:39:14", "text": "不，现在去那里是个糟糕的主意。"}, {"type": "subtitle", "time": 20356.31, "timestamp": "05:39:16", "text": "上面有人。上面有人吗？"}, {"type": "subtitle", "time": 20366.99, "timestamp": "05:39:26", "text": "糟糕的。"}, {"type": "subtitle", "time": 20368.11, "timestamp": "05:39:28", "text": "他妈的。最糟糕的。"}, {"type": "subtitle", "time": 20378.628, "timestamp": "05:39:38", "text": "嗯，我其实做得挺糟糕的。我"}, {"type": "subtitle", "time": 20380.51, "timestamp": "05:39:40", "text": "是的。哦"}, {"type": "subtitle", "time": 20396.67, "timestamp": "05:39:56", "text": "如何重建？"}]
[{"type": "subtitle", "time": 10860.79, "timestamp": "03:01:00", "text": "塔，"}, {"type": "subtitle", "time": 10866.75, "timestamp": "03:01:06", "text": "好的。我问你。"}, {"type": "subtitle", "time": 10867.71, "timestamp": "03:01:07", "text": "好了好了。"}, {"type": "subtitle", "time": 10870.495, "timestamp": "03:01:10", "text": "糟了，情况不妙，我好紧张。它减少了。它减少了。"}, {"type": "subtitle", "time": 10871.67, "timestamp": "03:01:11", "text": "[笑声]"}, {"type": "subtitle", "time": 10871.99, "timestamp": "03:01:11", "text": "放松。"}, {"type": "subtitle", "time": 10873.03, "timestamp": "03:01:13", "text": "紧张，"}, {"type": "subtitle", "time": 10874.87, "timestamp": "03:01:14", "text": "放松，放松。"}, {"type": "subtitle", "time": 10876.03, "timestamp": "03:01:16", "text": "我相信你。"}, {"type": "subtitle", "time": 10883.595, "timestamp": "03:01:23", "text": "一个人死了没关系，但是……"}, {"type": "subtitle", "time": 10884.229, "timestamp": "03:01:24", "text": "[笑声]"}, {"type": "subtitle", "time": 10893.15, "timestamp": "03:01:33", "text": "我做到了。好的。"}, {"type": "subtitle", "time": 10894.03, "timestamp": "03:01:34", "text": "哇，太好吃了。"}, {"type": "subtitle", "time": 10894.349, "timestamp": "03:01:34", "text": "好的。"}, {"type": "subtitle", "time": 10894.71, "timestamp": "03:01:34", "text": "对不起。"}, {"type": "subtitle", "time": 10904.95, "timestamp": "03:01:44", "text": "等一下。嗯，向上"}, {"type": "subtitle", "time": 10905.51, "timestamp": "03:01:45", "text": "哦"}, {"type": "subtitle", "time": 10907.229, "timestamp": "03:01:47", "text": "我得到了它。我得到了它。我得到了它。好的"}, {"type": "subtitle", "time": 10908.229, "timestamp": "03:01:48", "text": "好的。"}, {"type": "subtitle", "time": 10911.105, "timestamp": "03:01:51", "text": "啊。我是认真的。"}, {"type": "subtitle", "time": 10917.269, "timestamp": "03:01:57", "text": "不，但我还是拿到了第一名，所以没关系。"}, {"type": "subtitle", "time": 10918.15, "timestamp": "03:01:58", "text": "哦，那很好。好的。"}]
[{"type": "subtitle", "time": 20221.788, "timestamp": "05:37:01", "text": "这越来越有意思了。"}, {"type": "subtitle", "time": 20230.03, "timestamp": "05:37:10", "text": "我买了这个。胃"}, {"type": "subtitle", "time": 20248.15, "timestamp": "05:37:28", "text": "我带后面那家伙一起走。这样不好吗？"}, {"type": "subtitle", "time": 20262.27, "timestamp": "05:37:42", "text": "哦，有人在朝我开枪。娜"}, {"type": "subtitle", "time": 20269.948, "timestamp": "05:37:49", "text": "不。"}, {"type": "subtitle", "time": 20274.948, "timestamp": "05:37:54", "text": "那个东西。"}, {"type": "subtitle", "time": 20276.19, "timestamp": "05:37:56", "text": "哦，它来了。"}, {"type": "subtitle", "time": 20276.67, "timestamp": "05:37:56", "text": "他们不会来了。"}]
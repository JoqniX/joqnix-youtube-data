[{"type": "subtitle", "time": 11947.87, "timestamp": "03:19:07", "text": "这里几乎没有弓箭手。"}, {"type": "subtitle", "time": 11950.309, "timestamp": "03:19:10", "text": "这是正确的。我要左转。"}, {"type": "subtitle", "time": 11968.189, "timestamp": "03:19:28", "text": "哦，你好。"}, {"type": "subtitle", "time": 11970.55, "timestamp": "03:19:30", "text": "我就在你旁边。"}, {"type": "subtitle", "time": 11972.95, "timestamp": "03:19:32", "text": "好的。"}, {"type": "subtitle", "time": 11973.99, "timestamp": "03:19:33", "text": "啊，那很好。杀死米多。"}, {"type": "subtitle", "time": 11975.429, "timestamp": "03:19:35", "text": "好的。"}, {"type": "subtitle", "time": 11983.87, "timestamp": "03:19:43", "text": "哦，你要去吗？"}, {"type": "subtitle", "time": 11986.63, "timestamp": "03:19:46", "text": "我觉得那很可能就是被杀的那个人。"}, {"type": "subtitle", "time": 11986.87, "timestamp": "03:19:46", "text": "O Park"}, {"type": "subtitle", "time": 11989.71, "timestamp": "03:19:49", "text": "我认为从北方看不到它。我是 Resa"}, {"type": "subtitle", "time": 11990.95, "timestamp": "03:19:50", "text": "一包里有三个。"}, {"type": "subtitle", "time": 11993.269, "timestamp": "03:19:53", "text": "哦，我就用我手头上的那个吧。"}, {"type": "subtitle", "time": 11994.63, "timestamp": "03:19:54", "text": "O Park"}, {"type": "subtitle", "time": 11995.99, "timestamp": "03:19:55", "text": "现在就是时候了，对吧？"}, {"type": "subtitle", "time": 11998.269, "timestamp": "03:19:58", "text": "我们现在正遭到北方的枪击。盟友。"}]
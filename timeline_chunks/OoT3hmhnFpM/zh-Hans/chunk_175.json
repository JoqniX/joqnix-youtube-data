[{"type": "subtitle", "time": 10505.11, "timestamp": "02:55:05", "text": "我上楼一会儿。"}, {"type": "subtitle", "time": 10511.79, "timestamp": "02:55:11", "text": "我即将发布《小芽》。"}, {"type": "subtitle", "time": 10530.429, "timestamp": "02:55:30", "text": "是的。"}, {"type": "subtitle", "time": 10545.95, "timestamp": "02:55:45", "text": "它发出的声音非常大。"}, {"type": "subtitle", "time": 10547.229, "timestamp": "02:55:47", "text": "嗯，"}, {"type": "subtitle", "time": 10551.95, "timestamp": "02:55:51", "text": "就这些吗？快乐。"}, {"type": "subtitle", "time": 10552.63, "timestamp": "02:55:52", "text": "是的。"}, {"type": "subtitle", "time": 10553.79, "timestamp": "02:55:53", "text": "哦，它不见了。好的。"}, {"type": "subtitle", "time": 10555.269, "timestamp": "02:55:55", "text": "他们总是会在我需要的时候伸出援手。"}]
[{"type": "subtitle", "time": 19321.548, "timestamp": "05:22:01", "text": "抱歉。"}, {"type": "subtitle", "time": 19322.67, "timestamp": "05:22:02", "text": "我们应该如何应对这种情况？"}, {"type": "subtitle", "time": 19325.628, "timestamp": "05:22:05", "text": "我们采用哪种方案？如何才能找回来？"}, {"type": "subtitle", "time": 19326.75, "timestamp": "05:22:06", "text": "关键在于把它找回来。"}, {"type": "subtitle", "time": 19328.788, "timestamp": "05:22:08", "text": "我们的基地怎么了？"}, {"type": "subtitle", "time": 19336.07, "timestamp": "05:22:16", "text": "他们也在塔顶上。"}, {"type": "subtitle", "time": 19338.19, "timestamp": "05:22:18", "text": "我们应该登上塔顶吗？"}, {"type": "subtitle", "time": 19345.548, "timestamp": "05:22:25", "text": "哦"}, {"type": "subtitle", "time": 19356.83, "timestamp": "05:22:36", "text": "特种部队痛击。"}, {"type": "subtitle", "time": 19357.03, "timestamp": "05:22:37", "text": "是的。"}, {"type": "subtitle", "time": 19371.35, "timestamp": "05:22:51", "text": "哦真的吗？"}, {"type": "subtitle", "time": 19373.43, "timestamp": "05:22:53", "text": "嗯，美度，你自信吗？"}]
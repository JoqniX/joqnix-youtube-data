[{"type": "subtitle", "time": 14281.07, "timestamp": "03:58:01", "text": "它正朝这边过来。哦哦哦。"}, {"type": "subtitle", "time": 14283.149, "timestamp": "03:58:03", "text": "是的。是的。是的。是的。是的。"}, {"type": "subtitle", "time": 14285.429, "timestamp": "03:58:05", "text": "那里似乎什么都没有。"}, {"type": "subtitle", "time": 14299.07, "timestamp": "03:58:19", "text": "其他，"}, {"type": "subtitle", "time": 14313.149, "timestamp": "03:58:33", "text": "[笑声]"}, {"type": "subtitle", "time": 14319.95, "timestamp": "03:58:39", "text": "如何"}, {"type": "subtitle", "time": 14322.03, "timestamp": "03:58:42", "text": "你成功了吗？有一个人错了。"}, {"type": "subtitle", "time": 14326.59, "timestamp": "03:58:46", "text": "[笑声]"}, {"type": "subtitle", "time": 14329.469, "timestamp": "03:58:49", "text": "哦，嗯，​​那个坚持下来的人死了吗？"}, {"type": "subtitle", "time": 14331.87, "timestamp": "03:58:51", "text": "啊，我死了。"}]
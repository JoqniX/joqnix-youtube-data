[{"type": "subtitle", "time": 8101.91, "timestamp": "02:15:01", "text": "这是正确的。它在这里。"}, {"type": "subtitle", "time": 8110.51, "timestamp": "02:15:10", "text": "我想我会带一个燃料托盘。"}, {"type": "subtitle", "time": 8113.39, "timestamp": "02:15:13", "text": "他去世了。"}, {"type": "subtitle", "time": 8128.87, "timestamp": "02:15:28", "text": "谢谢。"}, {"type": "subtitle", "time": 8147.91, "timestamp": "02:15:47", "text": "那是我的，我的地盘，你"}, {"type": "subtitle", "time": 8149.549, "timestamp": "02:15:49", "text": "O Park"}, {"type": "subtitle", "time": 8153.39, "timestamp": "02:15:53", "text": "声音"}]
[{"type": "subtitle", "time": 21840.31, "timestamp": "06:04:00", "text": "对于一个10人服务器来说，波次计数"}, {"type": "subtitle", "time": 21842.15, "timestamp": "06:04:02", "text": "1号呢？"}, {"type": "subtitle", "time": 21842.75, "timestamp": "06:04:02", "text": "说到这里……"}, {"type": "subtitle", "time": 21845.15, "timestamp": "06:04:05", "text": "我一直都这么认为。"}, {"type": "subtitle", "time": 21848.788, "timestamp": "06:04:08", "text": "是33到33到34。或许吧。"}, {"type": "subtitle", "time": 21850.31, "timestamp": "06:04:10", "text": "我不会买。"}, {"type": "subtitle", "time": 21852.23, "timestamp": "06:04:12", "text": "真的有那么糟糕吗？马，"}, {"type": "subtitle", "time": 21854.27, "timestamp": "06:04:14", "text": "是的。哦，他死了。"}, {"type": "subtitle", "time": 21859.708, "timestamp": "06:04:19", "text": "大家都会回来吗？他们应该已经回来了。"}, {"type": "subtitle", "time": 21860.51, "timestamp": "06:04:20", "text": "是的。"}, {"type": "subtitle", "time": 21866.03, "timestamp": "06:04:26", "text": "我们走吧。高山"}, {"type": "subtitle", "time": 21867.27, "timestamp": "06:04:27", "text": "是的。我会更新它。"}, {"type": "subtitle", "time": 21868.23, "timestamp": "06:04:28", "text": "更新。"}, {"type": "subtitle", "time": 21873.43, "timestamp": "06:04:33", "text": "30岁以下玩家最多的服务器是3007服务器。"}, {"type": "subtitle", "time": 21874.708, "timestamp": "06:04:34", "text": "317."}, {"type": "subtitle", "time": 21880.35, "timestamp": "06:04:40", "text": "这意味着，加上我们的加入，总数将达到36。"}, {"type": "subtitle", "time": 21881.35, "timestamp": "06:04:41", "text": "因为你变成了一个人"}, {"type": "subtitle", "time": 21882.948, "timestamp": "06:04:42", "text": "它们会长得很快，对吧？"}, {"type": "subtitle", "time": 21886.99, "timestamp": "06:04:46", "text": "是的。所有人，317。"}, {"type": "subtitle", "time": 21889.548, "timestamp": "06:04:49", "text": "317317。"}, {"type": "subtitle", "time": 21891.708, "timestamp": "06:04:51", "text": "我可以去任何地方。这"}, {"type": "subtitle", "time": 21893.468, "timestamp": "06:04:53", "text": "哦。科桑，这事就交给你了。"}]
[{"type": "subtitle", "time": 7567.47, "timestamp": "02:06:07", "text": "我们杀了他。也"}, {"type": "subtitle", "time": 7570.83, "timestamp": "02:06:10", "text": "我不知道"}, {"type": "subtitle", "time": 7583.27, "timestamp": "02:06:23", "text": "大家都睡着了，情况看起来不错。"}, {"type": "subtitle", "time": 7585.629, "timestamp": "02:06:25", "text": "是的，我身边有不少盟友。"}, {"type": "subtitle", "time": 7609.867, "timestamp": "02:06:49", "text": "我在飞行。它在接住它，它在吸它，它在吸它。我无法原谅这件事。"}]
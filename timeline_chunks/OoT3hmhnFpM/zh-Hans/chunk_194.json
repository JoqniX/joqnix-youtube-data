[{"type": "subtitle", "time": 11640.59, "timestamp": "03:14:00", "text": "我再做一个钻头，以防万一。"}, {"type": "subtitle", "time": 11644.269, "timestamp": "03:14:04", "text": "我要跑马拉松。"}, {"type": "subtitle", "time": 11646.59, "timestamp": "03:14:06", "text": "谢谢。"}, {"type": "subtitle", "time": 11648.87, "timestamp": "03:14:08", "text": "你需要出去吗？"}, {"type": "subtitle", "time": 11651.75, "timestamp": "03:14:11", "text": "我觉得他们还在那里。"}, {"type": "subtitle", "time": 11654.07, "timestamp": "03:14:14", "text": "我在外面。"}, {"type": "subtitle", "time": 11666.269, "timestamp": "03:14:26", "text": "正如你拿在手里时所料，这把锤子很重。"}, {"type": "subtitle", "time": 11668.91, "timestamp": "03:14:28", "text": "是的。"}, {"type": "subtitle", "time": 11678.269, "timestamp": "03:14:38", "text": "1"}]
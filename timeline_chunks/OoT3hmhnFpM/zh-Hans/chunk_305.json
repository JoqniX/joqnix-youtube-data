[{"type": "subtitle", "time": 18308.548, "timestamp": "05:05:08", "text": "他在袭击中丧生。"}, {"type": "subtitle", "time": 18310.19, "timestamp": "05:05:10", "text": "他现在在吗？"}, {"type": "subtitle", "time": 18310.31, "timestamp": "05:05:10", "text": "4"}, {"type": "subtitle", "time": 18323.39, "timestamp": "05:05:23", "text": "我们正遭受攻击。所有这些"}, {"type": "subtitle", "time": 18325.548, "timestamp": "05:05:25", "text": "然后还有狙击手。是的。"}, {"type": "subtitle", "time": 18326.19, "timestamp": "05:05:26", "text": "好的。"}, {"type": "subtitle", "time": 18326.948, "timestamp": "05:05:26", "text": "这"}, {"type": "subtitle", "time": 18329.83, "timestamp": "05:05:29", "text": "好吧，我来砌一堵墙。一次"}, {"type": "subtitle", "time": 18331.35, "timestamp": "05:05:31", "text": "让我们改变现状。"}, {"type": "subtitle", "time": 18332.67, "timestamp": "05:05:32", "text": "嘿。"}, {"type": "subtitle", "time": 18343.47, "timestamp": "05:05:43", "text": "是的。最好清理一下周围环境。一定。这简直太疯狂了。"}, {"type": "subtitle", "time": 18356.83, "timestamp": "05:05:56", "text": "迫击炮射击非常危险。"}, {"type": "subtitle", "time": 18358.43, "timestamp": "05:05:58", "text": "他们擅长迫击炮射击。我"}]
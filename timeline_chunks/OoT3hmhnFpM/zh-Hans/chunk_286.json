[{"type": "subtitle", "time": 17160.91, "timestamp": "04:46:00", "text": "请。请。"}, {"type": "subtitle", "time": 17162.55, "timestamp": "04:46:02", "text": "是的。他把它弄坏了。"}, {"type": "subtitle", "time": 17163.19, "timestamp": "04:46:03", "text": "但这是最好的"}, {"type": "subtitle", "time": 17168.07, "timestamp": "04:46:08", "text": "是的。"}, {"type": "subtitle", "time": 17169.67, "timestamp": "04:46:09", "text": "这种情况会持续一段时间。"}, {"type": "subtitle", "time": 17171.47, "timestamp": "04:46:11", "text": "第一名是"}, {"type": "subtitle", "time": 17172.788, "timestamp": "04:46:12", "text": "水已经很深了，不是吗？"}, {"type": "subtitle", "time": 17213.31, "timestamp": "04:46:53", "text": "我该去哭吗？"}]
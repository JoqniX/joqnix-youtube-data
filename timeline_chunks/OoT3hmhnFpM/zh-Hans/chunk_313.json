[{"type": "subtitle", "time": 18784.91, "timestamp": "05:13:04", "text": "南方的日子依然不好过。"}, {"type": "subtitle", "time": 18786.39, "timestamp": "05:13:06", "text": "哦，对。比久间更甚。"}, {"type": "subtitle", "time": 18797.75, "timestamp": "05:13:17", "text": "我们遭到了来自某个方向的枪击。"}, {"type": "subtitle", "time": 18800.19, "timestamp": "05:13:20", "text": "或许是在公寓楼的顶层。"}, {"type": "subtitle", "time": 18808.83, "timestamp": "05:13:28", "text": "咦，还是被绿色击败了？我想知道？"}, {"type": "subtitle", "time": 18829.788, "timestamp": "05:13:49", "text": "好的。嗯，那"}, {"type": "subtitle", "time": 18831.83, "timestamp": "05:13:51", "text": "总会到来的。敌人是"}, {"type": "subtitle", "time": 18838.67, "timestamp": "05:13:58", "text": "是的。我们应该守卫基地吗？"}]
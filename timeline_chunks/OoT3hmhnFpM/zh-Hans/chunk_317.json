[{"type": "subtitle", "time": 19023.19, "timestamp": "05:17:03", "text": "我杀了他们。"}, {"type": "subtitle", "time": 19032.51, "timestamp": "05:17:12", "text": "1"}, {"type": "subtitle", "time": 19035.35, "timestamp": "05:17:15", "text": "我吵醒了某人。那太棒了。"}, {"type": "subtitle", "time": 19042.99, "timestamp": "05:17:22", "text": "他们干的吗？"}, {"type": "subtitle", "time": 19045.11, "timestamp": "05:17:25", "text": "这就是我。门没锁。"}, {"type": "subtitle", "time": 19047.61, "timestamp": "05:17:27", "text": "涌入了一大笔钱。"}, {"type": "subtitle", "time": 19067.03, "timestamp": "05:17:47", "text": "稍等片刻，我恢复1点生命值。"}, {"type": "subtitle", "time": 19078.948, "timestamp": "05:17:58", "text": "爸爸正在康复中。它会割伤一点。"}, {"type": "subtitle", "time": 19079.75, "timestamp": "05:17:59", "text": "蹲下。"}]
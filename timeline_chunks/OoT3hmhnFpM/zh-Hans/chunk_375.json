[{"type": "subtitle", "time": 22513.03, "timestamp": "06:15:13", "text": "但我总觉得我今天的胜率相当不错。"}, {"type": "subtitle", "time": 22520.628, "timestamp": "06:15:20", "text": "哦，这么说我错了？"}, {"type": "subtitle", "time": 22523.35, "timestamp": "06:15:23", "text": "哦，那不是真的。嗯，我去三山的时候"}, {"type": "subtitle", "time": 22525.468, "timestamp": "06:15:25", "text": "我们赢过一次，对吧？"}, {"type": "subtitle", "time": 22526.354, "timestamp": "06:15:26", "text": "等等，不，不，不，不。莫桑"}, {"type": "subtitle", "time": 22535.19, "timestamp": "06:15:35", "text": "我当时也在场（笑）"}, {"type": "subtitle", "time": 22535.35, "timestamp": "06:15:35", "text": "1"}]
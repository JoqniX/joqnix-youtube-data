[{"type": "subtitle", "time": 21120.83, "timestamp": "05:52:00", "text": "[笑声]"}, {"type": "subtitle", "time": 21122.67, "timestamp": "05:52:02", "text": "那里，那里，那里，那里。"}, {"type": "subtitle", "time": 21123.75, "timestamp": "05:52:03", "text": "好，好，好，好，好，好，好"}, {"type": "subtitle", "time": 21124.548, "timestamp": "05:52:04", "text": "不错，不错。"}, {"type": "subtitle", "time": 21125.708, "timestamp": "05:52:05", "text": "还有，马克。"}, {"type": "subtitle", "time": 21126.27, "timestamp": "05:52:06", "text": "标记。"}, {"type": "subtitle", "time": 21127.43, "timestamp": "05:52:07", "text": "等等，马克也参演了？"}, {"type": "subtitle", "time": 21132.59, "timestamp": "05:52:12", "text": "啊，德尔苏。"}, {"type": "subtitle", "time": 21140.11, "timestamp": "05:52:20", "text": "我们一共12个人，应该没问题。"}, {"type": "subtitle", "time": 21142.91, "timestamp": "05:52:22", "text": "哦哦哦。好的。巨大的。"}, {"type": "subtitle", "time": 21145.11, "timestamp": "05:52:25", "text": "嗯？这里只有我和我们两个人。严重地？这"}, {"type": "subtitle", "time": 21145.868, "timestamp": "05:52:25", "text": "这是真的。"}, {"type": "subtitle", "time": 21148.11, "timestamp": "05:52:28", "text": "哦，但是这个数字还在增加。这个数字增加了。好的，好的。"}, {"type": "subtitle", "time": 21150.51, "timestamp": "05:52:30", "text": "哦，不错。玩。"}, {"type": "subtitle", "time": 21156.15, "timestamp": "05:52:36", "text": "让我下车。我们一起去郊游吧。"}, {"type": "subtitle", "time": 21161.948, "timestamp": "05:52:41", "text": "每个人都能立刻做到，但是"}, {"type": "subtitle", "time": 21163.19, "timestamp": "05:52:43", "text": "其中一个人肯定是F"}, {"type": "subtitle", "time": 21164.67, "timestamp": "05:52:44", "text": "难道不应该立即去做吗？"}, {"type": "subtitle", "time": 21166.35, "timestamp": "05:52:46", "text": "哦，彭基·德斯特里。"}, {"type": "subtitle", "time": 21168.99, "timestamp": "05:52:48", "text": "我懂了。"}]
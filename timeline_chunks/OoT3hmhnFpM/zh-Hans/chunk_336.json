[{"type": "subtitle", "time": 20166.548, "timestamp": "05:36:06", "text": "这里是。"}, {"type": "subtitle", "time": 20168.11, "timestamp": "05:36:08", "text": "哦，哦，哦，哦。"}, {"type": "subtitle", "time": 20169.548, "timestamp": "05:36:09", "text": "糟糕。"}, {"type": "subtitle", "time": 20171.15, "timestamp": "05:36:11", "text": "你还好吗？我会在那之前走。"}, {"type": "subtitle", "time": 20176.67, "timestamp": "05:36:16", "text": "不，现在下车还太早。"}, {"type": "subtitle", "time": 20177.99, "timestamp": "05:36:17", "text": "屋顶，屋顶。"}, {"type": "subtitle", "time": 20179.628, "timestamp": "05:36:19", "text": "我们去屋顶吧。走吧，走吧，走吧。"}, {"type": "subtitle", "time": 20180.91, "timestamp": "05:36:20", "text": "好的。"}, {"type": "subtitle", "time": 20183.03, "timestamp": "05:36:23", "text": "快走快走快走。"}, {"type": "subtitle", "time": 20184.23, "timestamp": "05:36:24", "text": "哇。"}, {"type": "subtitle", "time": 20185.15, "timestamp": "05:36:25", "text": "糟糕。"}, {"type": "subtitle", "time": 20186.548, "timestamp": "05:36:26", "text": "打扰一下。"}, {"type": "subtitle", "time": 20187.75, "timestamp": "05:36:27", "text": "是的，我做过。"}, {"type": "subtitle", "time": 20190.11, "timestamp": "05:36:30", "text": "没关系，没关系。"}, {"type": "subtitle", "time": 20192.03, "timestamp": "05:36:32", "text": "我已妥善安排"}, {"type": "subtitle", "time": 20194.91, "timestamp": "05:36:34", "text": "我得学着开直升机。我差点就下车了。"}, {"type": "subtitle", "time": 20196.51, "timestamp": "05:36:36", "text": "不错，不错。"}, {"type": "subtitle", "time": 20197.868, "timestamp": "05:36:37", "text": "我们再去一次吗？"}, {"type": "subtitle", "time": 20198.548, "timestamp": "05:36:38", "text": "我们走吧。"}, {"type": "subtitle", "time": 20199.708, "timestamp": "05:36:39", "text": "我搞砸了。"}, {"type": "subtitle", "time": 20200.35, "timestamp": "05:36:40", "text": "发起进攻。"}, {"type": "subtitle", "time": 20205.47, "timestamp": "05:36:45", "text": "[笑声]"}, {"type": "subtitle", "time": 20205.83, "timestamp": "05:36:45", "text": "我去了。"}, {"type": "subtitle", "time": 20207.31, "timestamp": "05:36:47", "text": "我现在已经习惯了。这是今天第五个了。"}, {"type": "subtitle", "time": 20208.938, "timestamp": "05:36:48", "text": "这已经是第二次了。好的。"}, {"type": "subtitle", "time": 20209.91, "timestamp": "05:36:49", "text": "[笑声]"}, {"type": "subtitle", "time": 20210.11, "timestamp": "05:36:50", "text": "5"}, {"type": "subtitle", "time": 20211.83, "timestamp": "05:36:51", "text": "时代"}, {"type": "subtitle", "time": 20214.35, "timestamp": "05:36:54", "text": "相当多。"}, {"type": "subtitle", "time": 20216.19, "timestamp": "05:36:56", "text": "我将和Shius一起上体育课。"}, {"type": "subtitle", "time": 20217.11, "timestamp": "05:36:57", "text": "是的。"}, {"type": "subtitle", "time": 20218.91, "timestamp": "05:36:58", "text": "交给我吧。但"}, {"type": "subtitle", "time": 20219.99, "timestamp": "05:36:59", "text": "好的。"}]
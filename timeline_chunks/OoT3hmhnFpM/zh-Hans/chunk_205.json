[{"type": "subtitle", "time": 12310.309, "timestamp": "03:25:10", "text": "谢谢。"}, {"type": "subtitle", "time": 12314.99, "timestamp": "03:25:14", "text": "[嗤笑]"}, {"type": "subtitle", "time": 12316.429, "timestamp": "03:25:16", "text": "我做了个水疗护理。"}, {"type": "subtitle", "time": 12319.349, "timestamp": "03:25:19", "text": "好的。"}, {"type": "subtitle", "time": 12322.189, "timestamp": "03:25:22", "text": "里面有人。好的。"}, {"type": "subtitle", "time": 12350.55, "timestamp": "03:25:50", "text": "你们成功收回森林了吗？"}, {"type": "subtitle", "time": 12351.55, "timestamp": "03:25:51", "text": "令人失望。"}, {"type": "subtitle", "time": 12353.469, "timestamp": "03:25:53", "text": "看来他们还在。"}, {"type": "subtitle", "time": 12355.51, "timestamp": "03:25:55", "text": "真好。"}, {"type": "subtitle", "time": 12357.63, "timestamp": "03:25:57", "text": "是的。我设法弄到了一笔可观的钱。森林"}, {"type": "subtitle", "time": 12358.79, "timestamp": "03:25:58", "text": "埃纳。"}]
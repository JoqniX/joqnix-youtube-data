[{"type": "subtitle", "time": 6425.589, "timestamp": "01:47:05", "text": "[尖叫]"}, {"type": "subtitle", "time": 6438.03, "timestamp": "01:47:18", "text": "我死在了W山上。"}, {"type": "subtitle", "time": 6445.629, "timestamp": "01:47:25", "text": "有。塔"}, {"type": "subtitle", "time": 6446.99, "timestamp": "01:47:26", "text": "对，就在那儿。"}, {"type": "subtitle", "time": 6449.149, "timestamp": "01:47:29", "text": "再往后一点。"}, {"type": "subtitle", "time": 6451.709, "timestamp": "01:47:31", "text": "嗯，大概断了多少米？"}, {"type": "subtitle", "time": 6458.43, "timestamp": "01:47:38", "text": "只是因为如此。好的。"}, {"type": "subtitle", "time": 6458.589, "timestamp": "01:47:38", "text": "正确的。"}, {"type": "subtitle", "time": 6461.189, "timestamp": "01:47:41", "text": "是的。死。是的。我杀了他。"}, {"type": "subtitle", "time": 6462.669, "timestamp": "01:47:42", "text": "哦"}, {"type": "subtitle", "time": 6467.95, "timestamp": "01:47:47", "text": "他们真的来了。是的。"}]
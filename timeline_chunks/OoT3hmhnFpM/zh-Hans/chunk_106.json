[{"type": "subtitle", "time": 6376.109, "timestamp": "01:46:16", "text": "他们现在正从W侧进攻。"}, {"type": "subtitle", "time": 6379.189, "timestamp": "01:46:19", "text": "我正在揍他。弱点。非常感谢"}, {"type": "subtitle", "time": 6384.43, "timestamp": "01:46:24", "text": "益。我得到了它。杀。你这个混蛋，你这个混蛋"}, {"type": "subtitle", "time": 6388.31, "timestamp": "01:46:28", "text": "我愿意做。我认为Tower是一个强有力的竞争者。"}, {"type": "subtitle", "time": 6390.669, "timestamp": "01:46:30", "text": "难道没有吗？该死的。这就是为什么，一遍又一遍"}, {"type": "subtitle", "time": 6394.55, "timestamp": "01:46:34", "text": "这种事发生过很多次了。我要杀了他们。"}, {"type": "subtitle", "time": 6397.43, "timestamp": "01:46:37", "text": "是从你们楼顶上掉下来的，对吧？该死的"}, {"type": "subtitle", "time": 6405.669, "timestamp": "01:46:45", "text": "愤怒的孩子"}, {"type": "subtitle", "time": 6406.95, "timestamp": "01:46:46", "text": "一会儿。"}, {"type": "subtitle", "time": 6414.83, "timestamp": "01:46:54", "text": "嗯，生气的姐姐"}, {"type": "subtitle", "time": 6417.589, "timestamp": "01:46:57", "text": "好的。你在开玩笑吧？严重地。"}]
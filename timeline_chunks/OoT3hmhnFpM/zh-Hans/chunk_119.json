[{"type": "subtitle", "time": 7142.589, "timestamp": "01:59:02", "text": "现在情况不同了。阿久先生的加入带来了巨大的改变。"}, {"type": "subtitle", "time": 7143.31, "timestamp": "01:59:03", "text": "太疯狂了。"}, {"type": "subtitle", "time": 7144.87, "timestamp": "01:59:04", "text": "它确实能让你感觉身材更紧致。"}, {"type": "subtitle", "time": 7146.069, "timestamp": "01:59:06", "text": "那不对，对吧？"}, {"type": "subtitle", "time": 7192.95, "timestamp": "01:59:52", "text": "哦，我们的迫击炮基地被摧毁了。"}, {"type": "subtitle", "time": 7194.35, "timestamp": "01:59:54", "text": "那里肯定有什么东西。"}]
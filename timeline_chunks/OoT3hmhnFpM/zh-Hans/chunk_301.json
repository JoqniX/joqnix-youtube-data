[{"type": "subtitle", "time": 18060.27, "timestamp": "05:01:00", "text": "是的。是。"}, {"type": "subtitle", "time": 18072.27, "timestamp": "05:01:12", "text": "我们是真朋友。"}, {"type": "subtitle", "time": 18096.59, "timestamp": "05:01:36", "text": "虽然海拔很高，但它位于西侧，对吧？"}, {"type": "subtitle", "time": 18099.548, "timestamp": "05:01:39", "text": "是的，西方国家更容易遭受袭击。"}, {"type": "subtitle", "time": 18100.75, "timestamp": "05:01:40", "text": "这"}, {"type": "subtitle", "time": 18102.75, "timestamp": "05:01:42", "text": "或许是南边？"}, {"type": "subtitle", "time": 18110.75, "timestamp": "05:01:50", "text": "花去世了。我现在"}, {"type": "subtitle", "time": 18112.15, "timestamp": "05:01:52", "text": "我打算做一个钻头。"}, {"type": "subtitle", "time": 18114.43, "timestamp": "05:01:54", "text": "哦，那完全没问题。"}, {"type": "subtitle", "time": 18119.868, "timestamp": "05:01:59", "text": "会有人叫我起床的，所以没关系。"}]
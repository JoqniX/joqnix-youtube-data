[{"type": "subtitle", "time": 20820.15, "timestamp": "05:47:00", "text": "恶魔，快来！"}, {"type": "subtitle", "time": 20832.468, "timestamp": "05:47:12", "text": "谢谢你们提供的直升机。"}, {"type": "subtitle", "time": 20833.39, "timestamp": "05:47:13", "text": "齐尔塔"}, {"type": "subtitle", "time": 20834.51, "timestamp": "05:47:14", "text": "齐尔特"}, {"type": "subtitle", "time": 20835.868, "timestamp": "05:47:15", "text": "所以，你怎么看？所有人都能进去吗？"}, {"type": "subtitle", "time": 20837.67, "timestamp": "05:47:17", "text": "他们现在就在这里。"}, {"type": "subtitle", "time": 20839.07, "timestamp": "05:47:19", "text": "哦，但它们确实在那里。好的。"}, {"type": "subtitle", "time": 20840.948, "timestamp": "05:47:20", "text": "恶魔"}, {"type": "subtitle", "time": 20850.67, "timestamp": "05:47:30", "text": "超级阿克内克女人"}, {"type": "subtitle", "time": 20857.11, "timestamp": "05:47:37", "text": "哇，这里有多少人？ 12"}, {"type": "subtitle", "time": 20857.99, "timestamp": "05:47:37", "text": "我想我注定要变成人类。"}, {"type": "subtitle", "time": 20860.868, "timestamp": "05:47:40", "text": "156789101112"}, {"type": "subtitle", "time": 20864.15, "timestamp": "05:47:44", "text": "是一个人，不是三个人，嗯……"}, {"type": "subtitle", "time": 20865.948, "timestamp": "05:47:45", "text": "F在这里，他是谁？"}, {"type": "subtitle", "time": 20867.59, "timestamp": "05:47:47", "text": "恶魔"}, {"type": "subtitle", "time": 20868.67, "timestamp": "05:47:48", "text": "是啊是啊"}, {"type": "subtitle", "time": 20869.468, "timestamp": "05:47:49", "text": "图片"}, {"type": "subtitle", "time": 20872.23, "timestamp": "05:47:52", "text": "我想，应该是我和恶魔。"}, {"type": "subtitle", "time": 20873.07, "timestamp": "05:47:53", "text": "还有，马克"}, {"type": "subtitle", "time": 20875.91, "timestamp": "05:47:55", "text": "还有谁？哦，对，没错。"}, {"type": "subtitle", "time": 20877.7, "timestamp": "05:47:57", "text": "早期的。"}, {"type": "subtitle", "time": 20878.03, "timestamp": "05:47:58", "text": "[笑声]"}]
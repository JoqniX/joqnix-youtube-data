[{"type": "subtitle", "time": 17640.11, "timestamp": "04:54:00", "text": "致运输团队的成员们。"}, {"type": "subtitle", "time": 17642.03, "timestamp": "04:54:02", "text": "嗯，材料"}, {"type": "subtitle", "time": 17642.628, "timestamp": "04:54:02", "text": "这可能还不够。"}, {"type": "subtitle", "time": 17644.23, "timestamp": "04:54:04", "text": "哦，好的。"}, {"type": "subtitle", "time": 17649.59, "timestamp": "04:54:09", "text": "然后还有原材料和燃料，我想。"}, {"type": "subtitle", "time": 17651.91, "timestamp": "04:54:11", "text": "我同意。砰砰"}, {"type": "subtitle", "time": 17653.708, "timestamp": "04:54:13", "text": "我带来了燃料。"}, {"type": "subtitle", "time": 17655.75, "timestamp": "04:54:15", "text": "哦，谢谢。谢谢。"}, {"type": "subtitle", "time": 17656.75, "timestamp": "04:54:16", "text": "是的。"}, {"type": "subtitle", "time": 17657.868, "timestamp": "04:54:17", "text": "啊，超级派"}, {"type": "subtitle", "time": 17660.23, "timestamp": "04:54:20", "text": "好的。"}, {"type": "subtitle", "time": 17660.83, "timestamp": "04:54:20", "text": "啊，等等，"}, {"type": "subtitle", "time": 17665.03, "timestamp": "04:54:25", "text": "我还有这2个"}, {"type": "subtitle", "time": 17668.51, "timestamp": "04:54:28", "text": "是的，"}, {"type": "subtitle", "time": 17669.07, "timestamp": "04:54:29", "text": "我会回来的。"}, {"type": "subtitle", "time": 17670.39, "timestamp": "04:54:30", "text": "我又做了一个钻头。"}, {"type": "subtitle", "time": 17671.47, "timestamp": "04:54:31", "text": "我钻完了孔。是的。"}, {"type": "subtitle", "time": 17673.75, "timestamp": "04:54:33", "text": "哦哦哦。"}, {"type": "subtitle", "time": 17674.83, "timestamp": "04:54:34", "text": "下雨了。"}, {"type": "subtitle", "time": 17677.47, "timestamp": "04:54:37", "text": "该死。"}, {"type": "subtitle", "time": 17679.39, "timestamp": "04:54:39", "text": "我想知道它在哪里。"}, {"type": "subtitle", "time": 17681.75, "timestamp": "04:54:41", "text": "但我猜它终究还是红色的。"}, {"type": "subtitle", "time": 17693.23, "timestamp": "04:54:53", "text": "一个，"}]
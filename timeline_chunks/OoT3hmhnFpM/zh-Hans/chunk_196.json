[{"type": "subtitle", "time": 11760.55, "timestamp": "03:16:00", "text": "让我们全力以赴。"}, {"type": "subtitle", "time": 11769.82, "timestamp": "03:16:09", "text": "眼睛。这里太拥挤了。"}, {"type": "subtitle", "time": 11770.95, "timestamp": "03:16:10", "text": "[笑声]"}, {"type": "subtitle", "time": 11771.67, "timestamp": "03:16:11", "text": "太疯狂了，对吧？"}, {"type": "subtitle", "time": 11775.429, "timestamp": "03:16:15", "text": "我想杀23个人。我也杀了两个人。"}, {"type": "subtitle", "time": 11777.75, "timestamp": "03:16:17", "text": "他们蜂拥而至。这片森林"}, {"type": "subtitle", "time": 11782.67, "timestamp": "03:16:22", "text": "洞，"}, {"type": "subtitle", "time": 11785.11, "timestamp": "03:16:25", "text": "我们从这里开始吧？"}, {"type": "subtitle", "time": 11785.83, "timestamp": "03:16:25", "text": "哦，谢谢。"}, {"type": "subtitle", "time": 11787.63, "timestamp": "03:16:27", "text": "O Park"}, {"type": "subtitle", "time": 11789.189, "timestamp": "03:16:29", "text": "敌军已占领基地。"}, {"type": "subtitle", "time": 11808.269, "timestamp": "03:16:48", "text": "待在那儿。"}, {"type": "subtitle", "time": 11810.87, "timestamp": "03:16:50", "text": "哇，这并不奇怪。"}, {"type": "subtitle", "time": 11813.189, "timestamp": "03:16:53", "text": "我要把他们全杀了。"}, {"type": "subtitle", "time": 11818.79, "timestamp": "03:16:58", "text": "哦，他们来了。不再，不再"}]
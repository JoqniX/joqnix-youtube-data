[{"type": "subtitle", "time": 11880.87, "timestamp": "03:18:00", "text": "是的。"}, {"type": "subtitle", "time": 11883.87, "timestamp": "03:18:03", "text": "我无法再想象了"}, {"type": "subtitle", "time": 11886.83, "timestamp": "03:18:06", "text": "大约是原来的三倍。"}, {"type": "subtitle", "time": 11888.429, "timestamp": "03:18:08", "text": "这是什么？它是敌人吗？"}, {"type": "subtitle", "time": 11898.309, "timestamp": "03:18:18", "text": "那附近有个SR（可能是指某个机构或组织）。"}, {"type": "subtitle", "time": 11899.11, "timestamp": "03:18:19", "text": "我懂了。 3"}, {"type": "subtitle", "time": 11901.63, "timestamp": "03:18:21", "text": "大约一人。"}, {"type": "subtitle", "time": 11920.389, "timestamp": "03:18:40", "text": "哦，我是通过重生点去的。"}, {"type": "subtitle", "time": 11923.269, "timestamp": "03:18:43", "text": "敌人来了。"}, {"type": "subtitle", "time": 11925.15, "timestamp": "03:18:45", "text": "哦亲爱的。"}, {"type": "subtitle", "time": 11927.229, "timestamp": "03:18:47", "text": "我被人监视了。但它漏水了。"}, {"type": "subtitle", "time": 11939.55, "timestamp": "03:18:59", "text": "事情发生了。"}]
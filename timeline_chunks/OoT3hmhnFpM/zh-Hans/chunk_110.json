[{"type": "subtitle", "time": 6601.99, "timestamp": "01:50:01", "text": "你刚才说的是“权力”，对吧？但"}, {"type": "subtitle", "time": 6604.589, "timestamp": "01:50:04", "text": "我做过一次。"}, {"type": "subtitle", "time": 6607.03, "timestamp": "01:50:07", "text": "我打算尝试以5:45的速度飞行。"}, {"type": "subtitle", "time": 6633.51, "timestamp": "01:50:33", "text": "大概在 545 秒左右，或者略低于 545 秒。"}, {"type": "subtitle", "time": 6636.43, "timestamp": "01:50:36", "text": "哦，这下糟了。我的目标是Core-san"}, {"type": "subtitle", "time": 6639.43, "timestamp": "01:50:39", "text": "这里是"}, {"type": "subtitle", "time": 6643.149, "timestamp": "01:50:43", "text": "1可以吗？是的，1号塔。哦，又来了。"}, {"type": "subtitle", "time": 6644.35, "timestamp": "01:50:44", "text": "宾果！不，这行不通。"}, {"type": "subtitle", "time": 6658.149, "timestamp": "01:50:58", "text": "不同之处"}]
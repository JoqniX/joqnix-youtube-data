[{"type": "subtitle", "time": 18841.19, "timestamp": "05:14:01", "text": "即使我们要进行防御，也必须先摧毁迫击炮。难的。"}, {"type": "subtitle", "time": 18843.43, "timestamp": "05:14:03", "text": "是的，没错。这很难，不是吗？砂浆。"}, {"type": "subtitle", "time": 18848.83, "timestamp": "05:14:08", "text": "我们走吧。我们俩设法做到了。"}, {"type": "subtitle", "time": 18850.27, "timestamp": "05:14:10", "text": "嗯，还有一个"}, {"type": "subtitle", "time": 18855.43, "timestamp": "05:14:15", "text": "嘿，你。"}, {"type": "subtitle", "time": 18858.31, "timestamp": "05:14:18", "text": "是的。它来了，它来了。"}, {"type": "subtitle", "time": 18865.708, "timestamp": "05:14:25", "text": "是的。"}, {"type": "subtitle", "time": 18866.39, "timestamp": "05:14:26", "text": "我不知道。"}, {"type": "subtitle", "time": 18867.31, "timestamp": "05:14:27", "text": "谢谢。谢谢。"}, {"type": "subtitle", "time": 18872.15, "timestamp": "05:14:32", "text": "哦"}, {"type": "subtitle", "time": 18873.39, "timestamp": "05:14:33", "text": "我不用特种部队。"}, {"type": "subtitle", "time": 18878.628, "timestamp": "05:14:38", "text": "是的。"}, {"type": "subtitle", "time": 18879.67, "timestamp": "05:14:39", "text": "前进。"}, {"type": "subtitle", "time": 18881.39, "timestamp": "05:14:41", "text": "我们的目的地是体育场。"}, {"type": "subtitle", "time": 18882.19, "timestamp": "05:14:42", "text": "是的。"}, {"type": "subtitle", "time": 18895.948, "timestamp": "05:14:55", "text": "我同意。"}, {"type": "subtitle", "time": 18896.99, "timestamp": "05:14:56", "text": "揉。"}, {"type": "subtitle", "time": 18898.922, "timestamp": "05:14:58", "text": "是的。当心。但我真的不太明白那部分。"}]
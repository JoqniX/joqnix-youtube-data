[{"type": "subtitle", "time": 18600.75, "timestamp": "05:10:00", "text": "你碰巧有这些子弹吗？"}, {"type": "subtitle", "time": 18602.75, "timestamp": "05:10:02", "text": "哦，我有了，我有了，我一定会得到。等一下，"}, {"type": "subtitle", "time": 18605.47, "timestamp": "05:10:05", "text": "等一下。哦，那太危险了。这边更好。"}, {"type": "subtitle", "time": 18606.35, "timestamp": "05:10:06", "text": "是的。我做到了。"}, {"type": "subtitle", "time": 18608.47, "timestamp": "05:10:08", "text": "给你一本杂志，我送你一本杂志。然后"}, {"type": "subtitle", "time": 18610.91, "timestamp": "05:10:10", "text": "好的。真是松了一口气。"}, {"type": "subtitle", "time": 18615.59, "timestamp": "05:10:15", "text": "你还好吗？"}, {"type": "subtitle", "time": 18618.35, "timestamp": "05:10:18", "text": "嗯？不，不，不，哇，你竟然给我这么多？谢谢。"}, {"type": "subtitle", "time": 18619.868, "timestamp": "05:10:19", "text": "哦，我会给你的。好的，好的。 3"}, {"type": "subtitle", "time": 18622.07, "timestamp": "05:10:22", "text": "我有一张。"}, {"type": "subtitle", "time": 18623.11, "timestamp": "05:10:23", "text": "嗯？嗯，"}, {"type": "subtitle", "time": 18625.03, "timestamp": "05:10:25", "text": "那是什么？"}, {"type": "subtitle", "time": 18627.27, "timestamp": "05:10:27", "text": "你不需要这个吗？不。"}, {"type": "subtitle", "time": 18628.07, "timestamp": "05:10:28", "text": "是的。醋，"}, {"type": "subtitle", "time": 18629.75, "timestamp": "05:10:29", "text": "我们要杀了他们吗？"}, {"type": "subtitle", "time": 18630.948, "timestamp": "05:10:30", "text": "我要去杀了他。"}, {"type": "subtitle", "time": 18631.948, "timestamp": "05:10:31", "text": "好，我们一起去吧。"}, {"type": "subtitle", "time": 18633.67, "timestamp": "05:10:33", "text": "哦，嘿，再多一点"}, {"type": "subtitle", "time": 18635.67, "timestamp": "05:10:35", "text": "我能拍30张左右吗？"}, {"type": "subtitle", "time": 18639.43, "timestamp": "05:10:39", "text": "30 发，呃，每发一滴。"}, {"type": "subtitle", "time": 18641.548, "timestamp": "05:10:41", "text": "不是弹匣，而是子弹。"}, {"type": "subtitle", "time": 18646.51, "timestamp": "05:10:46", "text": "是的。"}, {"type": "subtitle", "time": 18646.948, "timestamp": "05:10:46", "text": "谢谢。"}, {"type": "subtitle", "time": 18648.19, "timestamp": "05:10:48", "text": "我先放下锤子一会儿。"}, {"type": "subtitle", "time": 18654.11, "timestamp": "05:10:54", "text": "感觉有些不对劲。"}, {"type": "subtitle", "time": 18654.47, "timestamp": "05:10:54", "text": "太疯狂了。"}, {"type": "subtitle", "time": 18656.03, "timestamp": "05:10:56", "text": "情况很糟糕。"}]
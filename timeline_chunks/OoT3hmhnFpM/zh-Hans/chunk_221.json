[{"type": "subtitle", "time": 13270.349, "timestamp": "03:41:10", "text": "是的。一团糟。"}, {"type": "subtitle", "time": 13277.15, "timestamp": "03:41:17", "text": "啊，明白了。"}, {"type": "subtitle", "time": 13283.11, "timestamp": "03:41:23", "text": "我带了一把锤子。"}, {"type": "subtitle", "time": 13292.07, "timestamp": "03:41:32", "text": "狙击手。"}, {"type": "subtitle", "time": 13295.07, "timestamp": "03:41:35", "text": "首先，南侧面积非常大。它上面有个洞。"}]
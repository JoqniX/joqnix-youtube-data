[{"type": "subtitle", "time": 17119.55, "timestamp": "04:45:19", "text": "或许就在这附近？"}, {"type": "subtitle", "time": 17132.59, "timestamp": "04:45:32", "text": "是的。"}, {"type": "subtitle", "time": 17143.03, "timestamp": "04:45:43", "text": "等等，这面墙还没完工。"}, {"type": "subtitle", "time": 17143.51, "timestamp": "04:45:43", "text": "就这些吗？"}, {"type": "subtitle", "time": 17144.67, "timestamp": "04:45:44", "text": "是的。打扰一下。"}, {"type": "subtitle", "time": 17150.23, "timestamp": "04:45:50", "text": "我优先处理这件事，因为我觉得他们可能无法到场。"}, {"type": "subtitle", "time": 17151.868, "timestamp": "04:45:51", "text": "哦，对不起。我懂了。对不起，对不起。"}, {"type": "subtitle", "time": 17153.982, "timestamp": "04:45:53", "text": "谢谢。好的，好的。耶！耶！我感觉浑身通电。"}, {"type": "subtitle", "time": 17158.628, "timestamp": "04:45:58", "text": "好的，我会负责销毁迫击炮。"}]
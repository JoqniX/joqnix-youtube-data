[{"type": "subtitle", "time": 10620.389, "timestamp": "02:57:00", "text": "のあそこにね、敵もいるんだよね。"}, {"type": "subtitle", "time": 10622.51, "timestamp": "02:57:02", "text": "あ、もう1人それ誰かいるの?乗るか。"}, {"type": "subtitle", "time": 10628.07, "timestamp": "02:57:08", "text": "そこの今"}, {"type": "subtitle", "time": 10630.95, "timestamp": "02:57:10", "text": "ベースで買い物してる人は誰だろう?えっと、"}, {"type": "subtitle", "time": 10632.11, "timestamp": "02:57:12", "text": "やばい。マジでここ"}, {"type": "subtitle", "time": 10633.229, "timestamp": "02:57:13", "text": "ち川ンさんかな?"}, {"type": "subtitle", "time": 10641.95, "timestamp": "02:57:21", "text": "効果作戦。"}, {"type": "subtitle", "time": 10643.67, "timestamp": "02:57:23", "text": "ま、4人いれば行けるっしょ。"}, {"type": "subtitle", "time": 10645.51, "timestamp": "02:57:25", "text": "もう俺たち。"}, {"type": "subtitle", "time": 10647.95, "timestamp": "02:57:27", "text": "マイガ"}, {"type": "subtitle", "time": 10648.91, "timestamp": "02:57:28", "text": "やばすぎそれ。"}, {"type": "subtitle", "time": 10670.71, "timestamp": "02:57:50", "text": "今"}, {"type": "subtitle", "time": 10672.269, "timestamp": "02:57:52", "text": "したら俺らもあと"}, {"type": "subtitle", "time": 10677.71, "timestamp": "02:57:57", "text": "あら、"}]
[{"type": "subtitle", "time": 31393.75, "timestamp": "08:43:13", "text": "今そうね。左上に"}, {"type": "subtitle", "time": 31395.468, "timestamp": "08:43:15", "text": "2つ作れてるね、相手。"}, {"type": "subtitle", "time": 31402.19, "timestamp": "08:43:22", "text": "1"}, {"type": "subtitle", "time": 31403.15, "timestamp": "08:43:23", "text": "人やった。"}, {"type": "subtitle", "time": 31404.07, "timestamp": "08:43:24", "text": "ナイスだね。"}, {"type": "subtitle", "time": 31406.228, "timestamp": "08:43:26", "text": "で、こっちもっちか。"}, {"type": "subtitle", "time": 31417.388, "timestamp": "08:43:37", "text": "お、なんかやった。"}, {"type": "subtitle", "time": 31422.99, "timestamp": "08:43:42", "text": "ガチャガチャしてんな、あいつら。"}, {"type": "subtitle", "time": 31424.07, "timestamp": "08:43:44", "text": "うん。"}, {"type": "subtitle", "time": 31426.75, "timestamp": "08:43:46", "text": "中に打ち込むだけで殺せる説あるわ、これ。"}, {"type": "subtitle", "time": 31436.308, "timestamp": "08:43:56", "text": "え、あの左上のやつ?"}, {"type": "subtitle", "time": 31437.35, "timestamp": "08:43:57", "text": "うん。こ"}, {"type": "subtitle", "time": 31438.83, "timestamp": "08:43:58", "text": "やべ、取っちゃった。"}, {"type": "subtitle", "time": 31439.868, "timestamp": "08:43:59", "text": "ナイス、ナイス、ナイス。"}]
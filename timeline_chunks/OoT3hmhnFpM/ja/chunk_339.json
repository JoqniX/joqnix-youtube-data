[{"type": "subtitle", "time": 20343.19, "timestamp": "05:39:03", "text": "よっしゃ。今さんと"}, {"type": "subtitle", "time": 20354.03, "timestamp": "05:39:14", "text": "いや、今そこで行くとまずいぞ。"}, {"type": "subtitle", "time": 20356.31, "timestamp": "05:39:16", "text": "上いるね。上いるかね。"}, {"type": "subtitle", "time": 20366.99, "timestamp": "05:39:26", "text": "やばい。"}, {"type": "subtitle", "time": 20368.11, "timestamp": "05:39:28", "text": "くそ。最悪。"}, {"type": "subtitle", "time": 20378.628, "timestamp": "05:39:38", "text": "いやあ、やっぱ下手くそだった。俺が"}, {"type": "subtitle", "time": 20380.51, "timestamp": "05:39:40", "text": "うん。オ"}, {"type": "subtitle", "time": 20396.67, "timestamp": "05:39:56", "text": "立て直しの方法が。"}]
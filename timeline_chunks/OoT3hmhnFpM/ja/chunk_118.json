[{"type": "subtitle", "time": 7085.83, "timestamp": "01:58:05", "text": "あさんあれや。メリキット使うわ。"}, {"type": "subtitle", "time": 7094.376, "timestamp": "01:58:14", "text": "経験にたら俺取られてる。"}, {"type": "subtitle", "time": 7102.47, "timestamp": "01:58:22", "text": "こっちに作ろ。"}, {"type": "subtitle", "time": 7110.149, "timestamp": "01:58:30", "text": "もうずっとタワー1狙っとくか。"}, {"type": "subtitle", "time": 7111.03, "timestamp": "01:58:31", "text": "タワー1"}, {"type": "subtitle", "time": 7113.31, "timestamp": "01:58:33", "text": "側のゲートとかも壊してあげていいかもな。"}, {"type": "subtitle", "time": 7115.47, "timestamp": "01:58:35", "text": "ああ、いいね、いいね、いいね。そうしましょう。なんだ"}, {"type": "subtitle", "time": 7120.35, "timestamp": "01:58:40", "text": "様子がおかしいぞ。"}, {"type": "subtitle", "time": 7122.669, "timestamp": "01:58:42", "text": "なんかそこ危なさそうだね。"}, {"type": "subtitle", "time": 7135.87, "timestamp": "01:58:55", "text": "オッケー。"}, {"type": "subtitle", "time": 7136.709, "timestamp": "01:58:56", "text": "やりました。今"}, {"type": "subtitle", "time": 7137.99, "timestamp": "01:58:57", "text": "おナイス。"}, {"type": "subtitle", "time": 7139.709, "timestamp": "01:58:59", "text": "もうやっぱ違うんだよな。"}]
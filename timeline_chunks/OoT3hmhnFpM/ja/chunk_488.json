[{"type": "subtitle", "time": 29280.388, "timestamp": "08:08:00", "text": "え、やっぱそっち側だな。そっち側に作るわ。ちょっと待ってね。"}, {"type": "subtitle", "time": 29281.07, "timestamp": "08:08:01", "text": "意外と高けんだ。"}, {"type": "subtitle", "time": 29283.548, "timestamp": "08:08:03", "text": "セルタけるね。"}, {"type": "subtitle", "time": 29284.03, "timestamp": "08:08:04", "text": "えっと、"}, {"type": "subtitle", "time": 29288.99, "timestamp": "08:08:08", "text": "えっとね、えっとね。"}, {"type": "subtitle", "time": 29290.19, "timestamp": "08:08:10", "text": "あ、てる。"}, {"type": "subtitle", "time": 29297.468, "timestamp": "08:08:17", "text": "ま、上がるか。さすに"}, {"type": "subtitle", "time": 29300.19, "timestamp": "08:08:20", "text": "上がるのはむずいか。"}, {"type": "subtitle", "time": 29300.99, "timestamp": "08:08:20", "text": "死ぬか。"}, {"type": "subtitle", "time": 29304.43, "timestamp": "08:08:24", "text": "ね。"}, {"type": "subtitle", "time": 29306.27, "timestamp": "08:08:26", "text": "オ、死んどくか。オ。"}, {"type": "subtitle", "time": 29308.59, "timestamp": "08:08:28", "text": "うん。"}, {"type": "subtitle", "time": 29315.59, "timestamp": "08:08:35", "text": "ありがとう。ありがと。シャコ作る。"}, {"type": "subtitle", "time": 29322.15, "timestamp": "08:08:42", "text": "ちょっと待ってね。"}, {"type": "subtitle", "time": 29323.43, "timestamp": "08:08:43", "text": "こんな感じになった。"}, {"type": "subtitle", "time": 29329.868, "timestamp": "08:08:49", "text": "お前"}, {"type": "subtitle", "time": 29330.788, "timestamp": "08:08:50", "text": "ベースって誰だ?"}, {"type": "subtitle", "time": 29333.388, "timestamp": "08:08:53", "text": "うーん。これ自陣行くか。"}, {"type": "subtitle", "time": 29333.99, "timestamp": "08:08:53", "text": "ちょっと待。"}, {"type": "subtitle", "time": 29336.67, "timestamp": "08:08:56", "text": "あのクレートの怪獣が間に合ってねえや。"}, {"type": "subtitle", "time": 29338.388, "timestamp": "08:08:58", "text": "オオ"}]
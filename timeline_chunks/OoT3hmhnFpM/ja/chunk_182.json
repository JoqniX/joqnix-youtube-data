[{"type": "subtitle", "time": 10920.15, "timestamp": "03:02:00", "text": "あ、俺はあのRPGで"}, {"type": "subtitle", "time": 10921.83, "timestamp": "03:02:01", "text": "周りをね、"}, {"type": "subtitle", "time": 10923.55, "timestamp": "03:02:03", "text": "殺されました。"}, {"type": "subtitle", "time": 10926.19, "timestamp": "03:02:06", "text": "俺は多分下にある近号に"}, {"type": "subtitle", "time": 10927.55, "timestamp": "03:02:07", "text": "お願いします。"}, {"type": "subtitle", "time": 10929.429, "timestamp": "03:02:09", "text": "これます。"}, {"type": "subtitle", "time": 10932.389, "timestamp": "03:02:12", "text": "マこれ。"}, {"type": "subtitle", "time": 10934.63, "timestamp": "03:02:14", "text": "あ、いや、アチマされて"}, {"type": "subtitle", "time": 10941.07, "timestamp": "03:02:21", "text": "俺も起こしてもらってる最中。"}, {"type": "subtitle", "time": 10943.349, "timestamp": "03:02:23", "text": "満員だな。さてはさては満員だな。"}, {"type": "subtitle", "time": 10952.87, "timestamp": "03:02:32", "text": "見せかけか。"}, {"type": "subtitle", "time": 10954.87, "timestamp": "03:02:34", "text": "FBのハッキングは止まったか。え、"}, {"type": "subtitle", "time": 10957.71, "timestamp": "03:02:37", "text": "止まったね。"}, {"type": "subtitle", "time": 10959.469, "timestamp": "03:02:39", "text": "サイレンがなってなければ。"}, {"type": "subtitle", "time": 10960.99, "timestamp": "03:02:40", "text": "なるほどね。"}, {"type": "subtitle", "time": 10962.11, "timestamp": "03:02:42", "text": "うん。うん。うん。うん。"}, {"type": "subtitle", "time": 10963.99, "timestamp": "03:02:43", "text": "俺これ"}, {"type": "subtitle", "time": 10966.51, "timestamp": "03:02:46", "text": "周りの死んで俺上か。"}, {"type": "subtitle", "time": 10971.67, "timestamp": "03:02:51", "text": "あ、もうちょっと"}, {"type": "subtitle", "time": 10975.59, "timestamp": "03:02:55", "text": "あと2人"}, {"type": "subtitle", "time": 10979.91, "timestamp": "03:02:59", "text": "あ。"}]
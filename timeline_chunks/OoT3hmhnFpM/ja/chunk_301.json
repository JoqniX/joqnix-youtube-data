[{"type": "subtitle", "time": 18060.27, "timestamp": "05:01:00", "text": "はい。です。"}, {"type": "subtitle", "time": 18072.27, "timestamp": "05:01:12", "text": "マジで仲間。"}, {"type": "subtitle", "time": 18096.59, "timestamp": "05:01:36", "text": "一応高くはしてんだけど西側だよね。"}, {"type": "subtitle", "time": 18099.548, "timestamp": "05:01:39", "text": "そう、西側なんか攻撃の方当たるわ。"}, {"type": "subtitle", "time": 18100.75, "timestamp": "05:01:40", "text": "これ"}, {"type": "subtitle", "time": 18102.75, "timestamp": "05:01:42", "text": "南側かな?じゃあ"}, {"type": "subtitle", "time": 18110.75, "timestamp": "05:01:50", "text": "ファ死んじゃった。俺は今"}, {"type": "subtitle", "time": 18112.15, "timestamp": "05:01:52", "text": "ドリル作るマなんで。"}, {"type": "subtitle", "time": 18114.43, "timestamp": "05:01:54", "text": "あ、全然大丈夫ですよ。"}, {"type": "subtitle", "time": 18119.868, "timestamp": "05:01:59", "text": "誰か起こしてくれるから大丈夫。"}]
[{"type": "subtitle", "time": 27324.67, "timestamp": "07:35:24", "text": "の方がやって欲しいかも。ジオイル探して"}, {"type": "subtitle", "time": 27328.99, "timestamp": "07:35:28", "text": "。オイルオイルオイル。運搬およ。"}, {"type": "subtitle", "time": 27331.99, "timestamp": "07:35:31", "text": "オ"}, {"type": "subtitle", "time": 27345.07, "timestamp": "07:35:45", "text": "2"}, {"type": "subtitle", "time": 27346.43, "timestamp": "07:35:46", "text": "番見てないな。僕"}, {"type": "subtitle", "time": 27348.11, "timestamp": "07:35:48", "text": "え、2番何もないよ。今俺が撃った。"}, {"type": "subtitle", "time": 27354.708, "timestamp": "07:35:54", "text": "じゃ、これどっかになんか"}]
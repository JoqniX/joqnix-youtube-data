[{"type": "subtitle", "time": 29467.15, "timestamp": "08:11:07", "text": "シュートでうまくギリギリで開くとか。"}, {"type": "subtitle", "time": 29477.75, "timestamp": "08:11:17", "text": "[うめき声]"}, {"type": "subtitle", "time": 29481.628, "timestamp": "08:11:21", "text": "あれ?"}, {"type": "subtitle", "time": 29483.07, "timestamp": "08:11:23", "text": "ありがとうね。緑。"}, {"type": "subtitle", "time": 29485.03, "timestamp": "08:11:25", "text": "あ、飛んでるね。ヘリ飛んでるわ。"}, {"type": "subtitle", "time": 29491.868, "timestamp": "08:11:31", "text": "うん。あり。"}, {"type": "subtitle", "time": 29494.59, "timestamp": "08:11:34", "text": "ゲートとかを探して。"}, {"type": "subtitle", "time": 29497.868, "timestamp": "08:11:37", "text": "左ゲートだね。あ、別にいるんかよ。"}, {"type": "subtitle", "time": 29499.948, "timestamp": "08:11:39", "text": "ま、ベスか。"}, {"type": "subtitle", "time": 29501.11, "timestamp": "08:11:41", "text": "赤からスナイプした。"}, {"type": "subtitle", "time": 29501.99, "timestamp": "08:11:41", "text": "ここら辺から入るか。"}, {"type": "subtitle", "time": 29503.468, "timestamp": "08:11:43", "text": "赤からスナイプ。オッケー。"}, {"type": "subtitle", "time": 29505.468, "timestamp": "08:11:45", "text": "赤からスナイプ。"}, {"type": "subtitle", "time": 29506.468, "timestamp": "08:11:46", "text": "誰?"}, {"type": "subtitle", "time": 29511.948, "timestamp": "08:11:51", "text": "え?N"}, {"type": "subtitle", "time": 29514.788, "timestamp": "08:11:54", "text": "いって。ここ直線上だわ、多分。"}]
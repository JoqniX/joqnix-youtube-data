[{"type": "subtitle", "time": 16021.229, "timestamp": "04:27:01", "text": "俺の乗った。乗った。乗った。"}, {"type": "subtitle", "time": 16022.309, "timestamp": "04:27:02", "text": "はい。乗った。"}, {"type": "subtitle", "time": 16031.109, "timestamp": "04:27:11", "text": "お願いします。"}, {"type": "subtitle", "time": 16039.349, "timestamp": "04:27:19", "text": "面度うまいな。うわ、"}, {"type": "subtitle", "time": 16041.229, "timestamp": "04:27:21", "text": "来た。メモリー。"}, {"type": "subtitle", "time": 16042.429, "timestamp": "04:27:22", "text": "これは民がもう2"}, {"type": "subtitle", "time": 16044.95, "timestamp": "04:27:24", "text": "人しか乗せないでこと言っちゃったのは正解やわ。"}, {"type": "subtitle", "time": 16046.189, "timestamp": "04:27:26", "text": "正解。"}, {"type": "subtitle", "time": 16048.269, "timestamp": "04:27:28", "text": "スピード。ゴー。[笑い]"}, {"type": "subtitle", "time": 16050.67, "timestamp": "04:27:30", "text": "重たいからな。"}, {"type": "subtitle", "time": 16052.99, "timestamp": "04:27:32", "text": "え、でもこのヘの方がね、今。"}, {"type": "subtitle", "time": 16054.269, "timestamp": "04:27:34", "text": "あ、そうなんだ。"}, {"type": "subtitle", "time": 16055.349, "timestamp": "04:27:35", "text": "そう。でかい分。"}, {"type": "subtitle", "time": 16056.75, "timestamp": "04:27:36", "text": "へ、リー"}, {"type": "subtitle", "time": 16058.07, "timestamp": "04:27:38", "text": "パワーがあるんで。"}, {"type": "subtitle", "time": 16059.109, "timestamp": "04:27:39", "text": "ああ、そうなんだ。"}, {"type": "subtitle", "time": 16060.75, "timestamp": "04:27:40", "text": "メリーがない。"}, {"type": "subtitle", "time": 16079.95, "timestamp": "04:27:59", "text": "くね。"}]
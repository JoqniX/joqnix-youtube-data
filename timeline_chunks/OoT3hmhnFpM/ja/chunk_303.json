[{"type": "subtitle", "time": 18183.03, "timestamp": "05:03:03", "text": "ちょ、俺は今"}, {"type": "subtitle", "time": 18184.31, "timestamp": "05:03:04", "text": "よいしょ。"}, {"type": "subtitle", "time": 18207.23, "timestamp": "05:03:27", "text": "ちょ、南側の搬入口があれだね。"}, {"type": "subtitle", "time": 18214.39, "timestamp": "05:03:34", "text": "うん。うん。うん。うん。"}, {"type": "subtitle", "time": 18216.31, "timestamp": "05:03:36", "text": "なんか壁作るなりしてあげるだけでもだいぶ。"}, {"type": "subtitle", "time": 18217.39, "timestamp": "05:03:37", "text": "あ、よし。"}, {"type": "subtitle", "time": 18218.75, "timestamp": "05:03:38", "text": "そうだね。あ、"}, {"type": "subtitle", "time": 18220.868, "timestamp": "05:03:40", "text": "迫撃っちゃあるわ。"}, {"type": "subtitle", "time": 18223.548, "timestamp": "05:03:43", "text": "どこ?"}]
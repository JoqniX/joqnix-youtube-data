[{"type": "subtitle", "time": 31995.03, "timestamp": "08:53:15", "text": "ま、あれ、ま、俺ら"}, {"type": "subtitle", "time": 31997.75, "timestamp": "08:53:17", "text": "4人で行った割にはそこそこ"}, {"type": "subtitle", "time": 32000.35, "timestamp": "08:53:20", "text": "うん。"}, {"type": "subtitle", "time": 32000.83, "timestamp": "08:53:20", "text": "荒た。"}, {"type": "subtitle", "time": 32005.83, "timestamp": "08:53:25", "text": "キル数ではなかったと思うよ。"}, {"type": "subtitle", "time": 32006.15, "timestamp": "08:53:26", "text": "え、"}, {"type": "subtitle", "time": 32007.868, "timestamp": "08:53:27", "text": "元は取れたんじゃない?"}, {"type": "subtitle", "time": 32009.708, "timestamp": "08:53:29", "text": "うん。アルファして"}, {"type": "subtitle", "time": 32011.468, "timestamp": "08:53:31", "text": "23"}, {"type": "subtitle", "time": 32011.99, "timestamp": "08:53:31", "text": "うん。"}, {"type": "subtitle", "time": 32014.91, "timestamp": "08:53:34", "text": "456多分全員で合わせて"}, {"type": "subtitle", "time": 32016.99, "timestamp": "08:53:36", "text": "67キルぐらい取れてるし。"}, {"type": "subtitle", "time": 32025.388, "timestamp": "08:53:45", "text": "うん。"}, {"type": "subtitle", "time": 32025.99, "timestamp": "08:53:45", "text": "作ってなかった。"}, {"type": "subtitle", "time": 32028.948, "timestamp": "08:53:48", "text": "下が地面スカスカだったんだよな"}, {"type": "subtitle", "time": 32029.548, "timestamp": "08:53:49", "text": "ね。そう。"}, {"type": "subtitle", "time": 32035.27, "timestamp": "08:53:55", "text": "[笑い]"}]
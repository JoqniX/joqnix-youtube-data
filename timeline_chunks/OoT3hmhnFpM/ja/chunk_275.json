[{"type": "subtitle", "time": 16500.349, "timestamp": "04:35:00", "text": "そう。"}, {"type": "subtitle", "time": 16507.709, "timestamp": "04:35:07", "text": "多数女性。"}, {"type": "subtitle", "time": 16509.109, "timestamp": "04:35:09", "text": "うん。"}, {"type": "subtitle", "time": 16553.91, "timestamp": "04:35:53", "text": "あで女性ちゃうぞ。お前ら"}, {"type": "subtitle", "time": 16555.949, "timestamp": "04:35:55", "text": "ちょっと作ってるできる女。"}, {"type": "subtitle", "time": 16558.269, "timestamp": "04:35:58", "text": "えっと、ごめんなさい。白撃やります。僕"}, {"type": "subtitle", "time": 16559.59, "timestamp": "04:35:59", "text": "あ、弾あるんかな?"}]
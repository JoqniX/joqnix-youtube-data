[{"type": "subtitle", "time": 27720.628, "timestamp": "07:42:00", "text": "はい。"}, {"type": "subtitle", "time": 27723.59, "timestamp": "07:42:03", "text": "俺が乗ってるヘリに戦いてやつは集合しろ。"}, {"type": "subtitle", "time": 27725.23, "timestamp": "07:42:05", "text": "わあ、"}, {"type": "subtitle", "time": 27726.43, "timestamp": "07:42:06", "text": "行くぜ。"}, {"type": "subtitle", "time": 27727.43, "timestamp": "07:42:07", "text": "入れない。"}, {"type": "subtitle", "time": 27729.468, "timestamp": "07:42:09", "text": "誰を、誰をこうにしようかね。"}, {"type": "subtitle", "time": 27736.35, "timestamp": "07:42:16", "text": "これ剣だ。剣だ。じゃあ大丈夫か?"}, {"type": "subtitle", "time": 27738.27, "timestamp": "07:42:18", "text": "みんな入った。"}, {"type": "subtitle", "time": 27739.43, "timestamp": "07:42:19", "text": "け武器やね。"}, {"type": "subtitle", "time": 27740.07, "timestamp": "07:42:20", "text": "入れない。"}, {"type": "subtitle", "time": 27743.91, "timestamp": "07:42:23", "text": "11人いるはずだから。あと2人。"}, {"type": "subtitle", "time": 27745.35, "timestamp": "07:42:25", "text": "え、入ってないのは、"}, {"type": "subtitle", "time": 27746.708, "timestamp": "07:42:26", "text": "え、"}, {"type": "subtitle", "time": 27756.15, "timestamp": "07:42:36", "text": "ジョックアパンさん、"}, {"type": "subtitle", "time": 27757.19, "timestamp": "07:42:37", "text": "今生えたね。"}, {"type": "subtitle", "time": 27759.11, "timestamp": "07:42:39", "text": "あ、ちくパンさんか。入れるかな?"}, {"type": "subtitle", "time": 27760.67, "timestamp": "07:42:40", "text": "2人かな?"}, {"type": "subtitle", "time": 27761.67, "timestamp": "07:42:41", "text": "今生えた。"}, {"type": "subtitle", "time": 27764.07, "timestamp": "07:42:44", "text": "今入った。"}, {"type": "subtitle", "time": 27764.83, "timestamp": "07:42:44", "text": "はい。"}, {"type": "subtitle", "time": 27767.308, "timestamp": "07:42:47", "text": "ジョック入ってなくない?入って分が"}, {"type": "subtitle", "time": 27768.59, "timestamp": "07:42:48", "text": "入た、入た、入た、えた。"}, {"type": "subtitle", "time": 27771.15, "timestamp": "07:42:51", "text": "本当だね。解散したな。方向性の違いで。"}, {"type": "subtitle", "time": 27771.59, "timestamp": "07:42:51", "text": "シートが。"}, {"type": "subtitle", "time": 27774.15, "timestamp": "07:42:54", "text": "あれ?ちょっとこれなんだ?怪しいぞ。"}, {"type": "subtitle", "time": 27775.788, "timestamp": "07:42:55", "text": "あ、怪しい。たか"}, {"type": "subtitle", "time": 27777.51, "timestamp": "07:42:57", "text": "あ、死んだ。"}, {"type": "subtitle", "time": 27778.948, "timestamp": "07:42:58", "text": "ああ、"}]
[{"type": "subtitle", "time": 11947.87, "timestamp": "03:19:07", "text": "ここ射兵がなさすぎてね。"}, {"type": "subtitle", "time": 11950.309, "timestamp": "03:19:10", "text": "そうなんだよね。左回ってるわ、俺。"}, {"type": "subtitle", "time": 11968.189, "timestamp": "03:19:28", "text": "あ、よ。"}, {"type": "subtitle", "time": 11970.55, "timestamp": "03:19:30", "text": "すぐ俺の下の近いるわ。"}, {"type": "subtitle", "time": 11972.95, "timestamp": "03:19:32", "text": "オケ。"}, {"type": "subtitle", "time": 11973.99, "timestamp": "03:19:33", "text": "あ、いいぞ。ミド引っ殺せ。"}, {"type": "subtitle", "time": 11975.429, "timestamp": "03:19:35", "text": "ナイス。"}, {"type": "subtitle", "time": 11983.87, "timestamp": "03:19:43", "text": "お、行ってくれんの?"}, {"type": "subtitle", "time": 11986.63, "timestamp": "03:19:46", "text": "俺は多分殺されたのそいつだから。"}, {"type": "subtitle", "time": 11986.87, "timestamp": "03:19:46", "text": "オ、"}, {"type": "subtitle", "time": 11989.71, "timestamp": "03:19:49", "text": "北からは見られてないと思う。俺なんかレサし"}, {"type": "subtitle", "time": 11990.95, "timestamp": "03:19:50", "text": "3個入ってるわ。"}, {"type": "subtitle", "time": 11993.269, "timestamp": "03:19:53", "text": "オ、こ、俺持ってるくの使っちゃうわ。"}, {"type": "subtitle", "time": 11994.63, "timestamp": "03:19:54", "text": "オ、"}, {"type": "subtitle", "time": 11995.99, "timestamp": "03:19:55", "text": "今中だよね、みんな。"}, {"type": "subtitle", "time": 11998.269, "timestamp": "03:19:58", "text": "北から撃たれたな、今。味方。"}]
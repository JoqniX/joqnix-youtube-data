[{"type": "subtitle", "time": 9241.03, "timestamp": "02:34:01", "text": "どうす?"}, {"type": "subtitle", "time": 9242.11, "timestamp": "02:34:02", "text": "いいぞ。"}, {"type": "subtitle", "time": 9242.87, "timestamp": "02:34:02", "text": "あれな。"}, {"type": "subtitle", "time": 9274.429, "timestamp": "02:34:34", "text": "マジでそこでね、崩れるんだよ。いつもチームが。"}, {"type": "subtitle", "time": 9289.23, "timestamp": "02:34:49", "text": "じゃないです。抜いちゃって。あ、でも入ってこれれちゃう。もしかして。"}, {"type": "subtitle", "time": 9297.389, "timestamp": "02:34:57", "text": "あ、そう。なんかね、すごいネイティブなの、この人。"}]
[{"type": "subtitle", "time": 20101.35, "timestamp": "05:35:01", "text": "なめたことしやがって。"}, {"type": "subtitle", "time": 20101.628, "timestamp": "05:35:01", "text": "うん。"}, {"type": "subtitle", "time": 20104.31, "timestamp": "05:35:04", "text": "本当だよ。"}, {"type": "subtitle", "time": 20112.31, "timestamp": "05:35:12", "text": "うん。そうね。俺らが"}, {"type": "subtitle", "time": 20115.11, "timestamp": "05:35:15", "text": "あれはもうぶっ壊せばよかったか。じゃあ"}, {"type": "subtitle", "time": 20125.43, "timestamp": "05:35:25", "text": "ハンマーで壊せんだね。知らんかったわ。"}, {"type": "subtitle", "time": 20127.868, "timestamp": "05:35:27", "text": "前やった時壊せないと思ったから。"}, {"type": "subtitle", "time": 20133.948, "timestamp": "05:35:33", "text": "壊せないもんなのかなと思った俺。"}, {"type": "subtitle", "time": 20153.67, "timestamp": "05:35:53", "text": "あれか。"}, {"type": "subtitle", "time": 20155.708, "timestamp": "05:35:55", "text": "うー。そ。"}]
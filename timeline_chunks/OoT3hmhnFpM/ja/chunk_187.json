[{"type": "subtitle", "time": 11221.55, "timestamp": "03:07:01", "text": "[笑い]"}, {"type": "subtitle", "time": 11223.59, "timestamp": "03:07:03", "text": "ミニガンで抜かれたね。ヘリ。"}, {"type": "subtitle", "time": 11239.229, "timestamp": "03:07:19", "text": "したよ。1人。オッケー。"}, {"type": "subtitle", "time": 11239.99, "timestamp": "03:07:19", "text": "南側かな?"}, {"type": "subtitle", "time": 11240.71, "timestamp": "03:07:20", "text": "ね。"}, {"type": "subtitle", "time": 11251.469, "timestamp": "03:07:31", "text": "うん。そこだね。"}, {"type": "subtitle", "time": 11253.19, "timestamp": "03:07:33", "text": "1人もワン"}, {"type": "subtitle", "time": 11259.269, "timestamp": "03:07:39", "text": "スポット。あれか。"}, {"type": "subtitle", "time": 11262.469, "timestamp": "03:07:42", "text": "別チーム同士だね。2人まだいます。"}, {"type": "subtitle", "time": 11263.429, "timestamp": "03:07:43", "text": "ナイス。死んだね。"}, {"type": "subtitle", "time": 11264.07, "timestamp": "03:07:44", "text": "ナイス。1人。"}, {"type": "subtitle", "time": 11267.07, "timestamp": "03:07:47", "text": "ナイス。ナイスナイスナイスナイスナイス。"}, {"type": "subtitle", "time": 11271.87, "timestamp": "03:07:51", "text": "ちょっと中を見るね。"}, {"type": "subtitle", "time": 11273.79, "timestamp": "03:07:53", "text": "うん。でもまだ行そうだな。南"}]
[{"type": "subtitle", "time": 22025.23, "timestamp": "06:07:05", "text": "ちょっと待ってコメントして"}, {"type": "subtitle", "time": 22027.31, "timestamp": "06:07:07", "text": "2828"}, {"type": "subtitle", "time": 22029.86, "timestamp": "06:07:09", "text": "オ赤赤赤赤赤赤赤ガ"}, {"type": "subtitle", "time": 22031.548, "timestamp": "06:07:11", "text": "[笑い]"}, {"type": "subtitle", "time": 22033.35, "timestamp": "06:07:13", "text": "レッドレッドレああ、ちょっと待って。"}, {"type": "subtitle", "time": 22034.788, "timestamp": "06:07:14", "text": "始まっちゃった。"}, {"type": "subtitle", "time": 22043.35, "timestamp": "06:07:23", "text": "うお。"}, {"type": "subtitle", "time": 22044.19, "timestamp": "06:07:24", "text": "うわ。"}, {"type": "subtitle", "time": 22046.27, "timestamp": "06:07:26", "text": "あ、じゃあ、えっと、分隊俺作っとくね。え、"}, {"type": "subtitle", "time": 22048.788, "timestamp": "06:07:28", "text": "オ、クリック、クリック、クリック、クリ、クリック。"}, {"type": "subtitle", "time": 22051.51, "timestamp": "06:07:31", "text": "みんなサーバーには入れてんのかな?"}, {"type": "subtitle", "time": 22052.59, "timestamp": "06:07:32", "text": "入れてる。"}, {"type": "subtitle", "time": 22066.07, "timestamp": "06:07:46", "text": "[笑い]"}]
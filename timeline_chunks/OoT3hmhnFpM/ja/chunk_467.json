[{"type": "subtitle", "time": 28020.67, "timestamp": "07:47:00", "text": "敵を不幸にしたい。そう、"}, {"type": "subtitle", "time": 28022.388, "timestamp": "07:47:02", "text": "行くぜ。よいしょ。"}, {"type": "subtitle", "time": 28023.36, "timestamp": "07:47:03", "text": "よいしょ。 行くぞ。"}, {"type": "subtitle", "time": 28025.68, "timestamp": "07:47:05", "text": "行くぞ。 アルファン。"}, {"type": "subtitle", "time": 28026.76, "timestamp": "07:47:06", "text": "アルファン。 俺の"}, {"type": "subtitle", "time": 28027.12, "timestamp": "07:47:07", "text": "俺の アルファ、アルファン。頑張ってくれ。"}, {"type": "subtitle", "time": 28029.24, "timestamp": "07:47:09", "text": "アルファ、アルファン。頑張ってくれ。 アルファン。"}, {"type": "subtitle", "time": 28030.798, "timestamp": "07:47:10", "text": "アルファン。 俺たちはベタや。"}, {"type": "subtitle", "time": 28031.558, "timestamp": "07:47:11", "text": "俺たちはベタや。 あのヘリがめちゃめちゃ遠いっす。な"}, {"type": "subtitle", "time": 28034.322, "timestamp": "07:47:14", "text": "あのヘリがめちゃめちゃ遠いっす。な [笑い]"}, {"type": "subtitle", "time": 28064.04, "timestamp": "07:47:44", "text": "[笑い] オ、オ、オ、オ、レッツゴー。レッツゴー。"}, {"type": "subtitle", "time": 28066.76, "timestamp": "07:47:46", "text": "オ、オ、オ、オ、レッツゴー。レッツゴー。 あえて"}, {"type": "subtitle", "time": 28067.24, "timestamp": "07:47:47", "text": "あえて 許すな。"}, {"type": "subtitle", "time": 28067.84, "timestamp": "07:47:47", "text": "許すな。 あえて、あえてですよ。"}, {"type": "subtitle", "time": 28069.24, "timestamp": "07:47:49", "text": "あえて、あえてですよ。 マイゴしてる。"}, {"type": "subtitle", "time": 28071.002, "timestamp": "07:47:51", "text": "マイゴしてる。 [笑い]"}, {"type": "subtitle", "time": 28071.558, "timestamp": "07:47:51", "text": "[笑い] バロ。"}, {"type": "subtitle", "time": 28073.2, "timestamp": "07:47:53", "text": "バロ。 あれ、あともうあれであれジョックも"}, {"type": "subtitle", "time": 28078.23, "timestamp": "07:47:58", "text": "センキューみたいなこと言ったね。確か"}]
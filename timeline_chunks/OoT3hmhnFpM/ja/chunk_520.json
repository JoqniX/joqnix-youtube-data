[{"type": "subtitle", "time": 31209.628, "timestamp": "08:40:09", "text": "上規もしかして。"}, {"type": "subtitle", "time": 31213.99, "timestamp": "08:40:13", "text": "さすがっす。いや、"}, {"type": "subtitle", "time": 31215.708, "timestamp": "08:40:15", "text": "上下はもうマジで遠い時に"}, {"type": "subtitle", "time": 31224.948, "timestamp": "08:40:24", "text": "あ、これで毎回やかと思った。"}, {"type": "subtitle", "time": 31233.59, "timestamp": "08:40:33", "text": "これ行ったでしょ。僕行ってないかな。て"}, {"type": "subtitle", "time": 31235.548, "timestamp": "08:40:35", "text": "伸びっかな。"}, {"type": "subtitle", "time": 31237.15, "timestamp": "08:40:37", "text": "そのまま直"}, {"type": "subtitle", "time": 31238.868, "timestamp": "08:40:38", "text": "左下のやつなんだこれ"}, {"type": "subtitle", "time": 31240.67, "timestamp": "08:40:40", "text": "殺したかも。これい"}, {"type": "subtitle", "time": 31243.43, "timestamp": "08:40:43", "text": "あ、これ崩した。崩した。左側のやつ手前。"}, {"type": "subtitle", "time": 31253.75, "timestamp": "08:40:53", "text": "3つ。"}, {"type": "subtitle", "time": 31255.27, "timestamp": "08:40:55", "text": "え、さらに奥"}, {"type": "subtitle", "time": 31257.59, "timestamp": "08:40:57", "text": "ああ、やば。今作ってんじゃん。あいつら。"}, {"type": "subtitle", "time": 31258.628, "timestamp": "08:40:58", "text": "作ってるわ。"}, {"type": "subtitle", "time": 31259.91, "timestamp": "08:40:59", "text": "やば。"}]
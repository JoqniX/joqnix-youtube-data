[{"type": "subtitle", "time": 6425.589, "timestamp": "01:47:05", "text": "[叫び声]"}, {"type": "subtitle", "time": 6438.03, "timestamp": "01:47:18", "text": "Wの山死ました自分。"}, {"type": "subtitle", "time": 6445.629, "timestamp": "01:47:25", "text": "あった。タワー"}, {"type": "subtitle", "time": 6446.99, "timestamp": "01:47:26", "text": "あった、あった。"}, {"type": "subtitle", "time": 6449.149, "timestamp": "01:47:29", "text": "ちょっと奥目の方にね、ある。"}, {"type": "subtitle", "time": 6451.709, "timestamp": "01:47:31", "text": "え、何メートぐらい壊さんざっくり。"}, {"type": "subtitle", "time": 6458.43, "timestamp": "01:47:38", "text": "なんとなく。オッケー。"}, {"type": "subtitle", "time": 6458.589, "timestamp": "01:47:38", "text": "な。"}, {"type": "subtitle", "time": 6461.189, "timestamp": "01:47:41", "text": "はい。死にな。はい。殺しました。"}, {"type": "subtitle", "time": 6462.669, "timestamp": "01:47:42", "text": "オ"}, {"type": "subtitle", "time": 6467.95, "timestamp": "01:47:47", "text": "本当来てるわ。うん。"}]
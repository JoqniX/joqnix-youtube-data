[{"type": "subtitle", "time": 10860.79, "timestamp": "03:01:00", "text": "た、"}, {"type": "subtitle", "time": 10866.75, "timestamp": "03:01:06", "text": "オッケー。頼むわ。"}, {"type": "subtitle", "time": 10867.71, "timestamp": "03:01:07", "text": "よしよし。"}, {"type": "subtitle", "time": 10870.495, "timestamp": "03:01:10", "text": "やば、なんかやべ、なんかすげえ緊張してきた。減った。減った。"}, {"type": "subtitle", "time": 10871.67, "timestamp": "03:01:11", "text": "[笑い]"}, {"type": "subtitle", "time": 10871.99, "timestamp": "03:01:11", "text": "リラックス。"}, {"type": "subtitle", "time": 10873.03, "timestamp": "03:01:13", "text": "緊張、"}, {"type": "subtitle", "time": 10874.87, "timestamp": "03:01:14", "text": "リラックス、リラックス。"}, {"type": "subtitle", "time": 10876.03, "timestamp": "03:01:16", "text": "信じてますよ。"}, {"type": "subtitle", "time": 10883.595, "timestamp": "03:01:23", "text": "1人ぐらい死ぬのはやなしでちょっと"}, {"type": "subtitle", "time": 10884.229, "timestamp": "03:01:24", "text": "[笑い]"}, {"type": "subtitle", "time": 10893.15, "timestamp": "03:01:33", "text": "やったわ。ナイス。"}, {"type": "subtitle", "time": 10894.03, "timestamp": "03:01:34", "text": "え、うますぎ。"}, {"type": "subtitle", "time": 10894.349, "timestamp": "03:01:34", "text": "ナイス。"}, {"type": "subtitle", "time": 10894.71, "timestamp": "03:01:34", "text": "ごめん。"}, {"type": "subtitle", "time": 10904.95, "timestamp": "03:01:44", "text": "ちょっと待って。えっと上に"}, {"type": "subtitle", "time": 10905.51, "timestamp": "03:01:45", "text": "オ"}, {"type": "subtitle", "time": 10907.229, "timestamp": "03:01:47", "text": "取れた。取れた。取れた。ナイスナ"}, {"type": "subtitle", "time": 10908.229, "timestamp": "03:01:48", "text": "ナイス。"}, {"type": "subtitle", "time": 10911.105, "timestamp": "03:01:51", "text": "ああ。マジで行く。"}, {"type": "subtitle", "time": 10917.269, "timestamp": "03:01:57", "text": "いや、あのでも上は取れたから大丈夫だ。"}, {"type": "subtitle", "time": 10918.15, "timestamp": "03:01:58", "text": "ああ、よかった。よかった。"}]
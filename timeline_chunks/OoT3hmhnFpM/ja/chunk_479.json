[{"type": "subtitle", "time": 28740.788, "timestamp": "07:59:00", "text": "ここで俺蘇生するわ。オ"}, {"type": "subtitle", "time": 28746.35, "timestamp": "07:59:06", "text": "ありがとう。たさん、"}, {"type": "subtitle", "time": 28751.99, "timestamp": "07:59:11", "text": "あ、ヒールがいるか。"}, {"type": "subtitle", "time": 28752.788, "timestamp": "07:59:12", "text": "やった。来る。"}, {"type": "subtitle", "time": 28753.67, "timestamp": "07:59:13", "text": "ナイス。"}, {"type": "subtitle", "time": 28755.23, "timestamp": "07:59:15", "text": "でかい。スナイス。ナイス。上。"}, {"type": "subtitle", "time": 28756.59, "timestamp": "07:59:16", "text": "あ、ありがとう。"}, {"type": "subtitle", "time": 28757.708, "timestamp": "07:59:17", "text": "スナイパー了解。"}, {"type": "subtitle", "time": 28759.67, "timestamp": "07:59:19", "text": "オッケー。"}, {"type": "subtitle", "time": 28768.83, "timestamp": "07:59:28", "text": "オ、"}, {"type": "subtitle", "time": 28782.03, "timestamp": "07:59:42", "text": "あ、ストック。"}, {"type": "subtitle", "time": 28784.15, "timestamp": "07:59:44", "text": "ああ、"}, {"type": "subtitle", "time": 28786.83, "timestamp": "07:59:46", "text": "凄まじい。クソだった。お互いに。"}, {"type": "subtitle", "time": 28787.99, "timestamp": "07:59:47", "text": "くそ。くそ。"}, {"type": "subtitle", "time": 28791.99, "timestamp": "07:59:51", "text": "最悪なんだけど。"}, {"type": "subtitle", "time": 28792.91, "timestamp": "07:59:52", "text": "シュート。"}]
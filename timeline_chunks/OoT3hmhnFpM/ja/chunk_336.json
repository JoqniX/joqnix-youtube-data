[{"type": "subtitle", "time": 20166.548, "timestamp": "05:36:06", "text": "ここね。"}, {"type": "subtitle", "time": 20168.11, "timestamp": "05:36:08", "text": "オッ、オ、オ、オ。"}, {"type": "subtitle", "time": 20169.548, "timestamp": "05:36:09", "text": "おっとと。"}, {"type": "subtitle", "time": 20171.15, "timestamp": "05:36:11", "text": "大丈夫。その前行くわ。"}, {"type": "subtitle", "time": 20176.67, "timestamp": "05:36:16", "text": "いや、今降りるの早。"}, {"type": "subtitle", "time": 20177.99, "timestamp": "05:36:17", "text": "屋上、屋上。"}, {"type": "subtitle", "time": 20179.628, "timestamp": "05:36:19", "text": "屋上行くよ。行こ、行こ、行こ。"}, {"type": "subtitle", "time": 20180.91, "timestamp": "05:36:20", "text": "はいよ。"}, {"type": "subtitle", "time": 20183.03, "timestamp": "05:36:23", "text": "ゴーゴーゴーゴー。"}, {"type": "subtitle", "time": 20184.23, "timestamp": "05:36:24", "text": "うわあ。"}, {"type": "subtitle", "time": 20185.15, "timestamp": "05:36:25", "text": "あ、やべ。"}, {"type": "subtitle", "time": 20186.548, "timestamp": "05:36:26", "text": "すいません。"}, {"type": "subtitle", "time": 20187.75, "timestamp": "05:36:27", "text": "いや、それやらかした。"}, {"type": "subtitle", "time": 20190.11, "timestamp": "05:36:30", "text": "大丈夫、大丈夫。"}, {"type": "subtitle", "time": 20192.03, "timestamp": "05:36:32", "text": "俺はちゃんと"}, {"type": "subtitle", "time": 20194.91, "timestamp": "05:36:34", "text": "ヘリを操縦しなきゃだめだな。降りようとしちゃった俺。"}, {"type": "subtitle", "time": 20196.51, "timestamp": "05:36:36", "text": "ナイス、ナイス。"}, {"type": "subtitle", "time": 20197.868, "timestamp": "05:36:37", "text": "また行くか。"}, {"type": "subtitle", "time": 20198.548, "timestamp": "05:36:38", "text": "行きましょう。"}, {"type": "subtitle", "time": 20199.708, "timestamp": "05:36:39", "text": "やらかしたわ。"}, {"type": "subtitle", "time": 20200.35, "timestamp": "05:36:40", "text": "アタックしましょう。"}, {"type": "subtitle", "time": 20205.47, "timestamp": "05:36:45", "text": "[笑い]"}, {"type": "subtitle", "time": 20205.83, "timestamp": "05:36:45", "text": "行きました。"}, {"type": "subtitle", "time": 20207.31, "timestamp": "05:36:47", "text": "もう慣れたもんだぜ。もう今日これ5"}, {"type": "subtitle", "time": 20208.938, "timestamp": "05:36:48", "text": "回目だからな。オッケー。"}, {"type": "subtitle", "time": 20209.91, "timestamp": "05:36:49", "text": "[笑い]"}, {"type": "subtitle", "time": 20210.11, "timestamp": "05:36:50", "text": "5"}, {"type": "subtitle", "time": 20211.83, "timestamp": "05:36:51", "text": "回"}, {"type": "subtitle", "time": 20214.35, "timestamp": "05:36:54", "text": "だいぶな。"}, {"type": "subtitle", "time": 20216.19, "timestamp": "05:36:56", "text": "シウスと体育ね。"}, {"type": "subtitle", "time": 20217.11, "timestamp": "05:36:57", "text": "そうね。"}, {"type": "subtitle", "time": 20218.91, "timestamp": "05:36:58", "text": "任してください。でも"}, {"type": "subtitle", "time": 20219.99, "timestamp": "05:36:59", "text": "よいしゃ。"}]
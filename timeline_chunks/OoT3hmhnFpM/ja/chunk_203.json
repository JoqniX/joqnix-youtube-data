[{"type": "subtitle", "time": 12205.469, "timestamp": "03:23:25", "text": "これ取り返して頑張りますか?"}, {"type": "subtitle", "time": 12209.95, "timestamp": "03:23:29", "text": "あ、行っててもうよ。"}, {"type": "subtitle", "time": 12210.15, "timestamp": "03:23:30", "text": "うん。"}, {"type": "subtitle", "time": 12222.189, "timestamp": "03:23:42", "text": "あ、ハンマーくれるんだったらもらうわ。"}, {"type": "subtitle", "time": 12229.229, "timestamp": "03:23:49", "text": "オオオ。"}, {"type": "subtitle", "time": 12234.99, "timestamp": "03:23:54", "text": "西側の通払いをしてるんで。"}, {"type": "subtitle", "time": 12235.389, "timestamp": "03:23:55", "text": "やば、これ。"}, {"type": "subtitle", "time": 12237.11, "timestamp": "03:23:57", "text": "あ、芋さんのそばに置いといた。"}, {"type": "subtitle", "time": 12238.229, "timestamp": "03:23:58", "text": "オッケー。"}]
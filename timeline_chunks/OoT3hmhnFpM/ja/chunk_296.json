[{"type": "subtitle", "time": 17763.47, "timestamp": "04:56:03", "text": "ま、ま、ま、ま、うん。迫撃砲やった方がいいわ。"}, {"type": "subtitle", "time": 17764.39, "timestamp": "04:56:04", "text": "ちょっと待ってね。僕もう1"}, {"type": "subtitle", "time": 17766.43, "timestamp": "04:56:06", "text": "個作っちゃうかな。迫撃。ああ、でも作れるかな。"}, {"type": "subtitle", "time": 17767.788, "timestamp": "04:56:07", "text": "ああ、2000行ったからいいね。"}, {"type": "subtitle", "time": 17769.23, "timestamp": "04:56:09", "text": "大丈夫、大丈夫、大丈夫。もう1個今"}, {"type": "subtitle", "time": 17770.43, "timestamp": "04:56:10", "text": "2Xしてっから4000"}, {"type": "subtitle", "time": 17772.03, "timestamp": "04:56:12", "text": "円ぐらいになるはず。"}, {"type": "subtitle", "time": 17774.548, "timestamp": "04:56:14", "text": "オーマイガスキープレッ"}, {"type": "subtitle", "time": 17777.11, "timestamp": "04:56:17", "text": "ちょっと覗くんや。"}, {"type": "subtitle", "time": 17794.628, "timestamp": "04:56:34", "text": "俺は何もやってないわ、今。"}, {"type": "subtitle", "time": 17795.788, "timestamp": "04:56:35", "text": "オッケー。"}, {"type": "subtitle", "time": 17802.59, "timestamp": "04:56:42", "text": "はいはいはいはい。"}, {"type": "subtitle", "time": 17804.19, "timestamp": "04:56:44", "text": "ちょっとやってみよう。"}, {"type": "subtitle", "time": 17804.628, "timestamp": "04:56:44", "text": "え、"}, {"type": "subtitle", "time": 17806.548, "timestamp": "04:56:46", "text": "赤見てみます。ちょっと"}, {"type": "subtitle", "time": 17809.03, "timestamp": "04:56:49", "text": "ごめん。こさん起こせるかな?俺のこと下で。"}, {"type": "subtitle", "time": 17813.07, "timestamp": "04:56:53", "text": "終ったなら。"}, {"type": "subtitle", "time": 17813.75, "timestamp": "04:56:53", "text": "あ、"}, {"type": "subtitle", "time": 17815.43, "timestamp": "04:56:55", "text": "赤。ああ、届くね。赤。"}, {"type": "subtitle", "time": 17816.83, "timestamp": "04:56:56", "text": "ジョセフィ。"}, {"type": "subtitle", "time": 17817.11, "timestamp": "04:56:57", "text": "あ、"}, {"type": "subtitle", "time": 17819.03, "timestamp": "04:56:59", "text": "ジョセフィ。"}]
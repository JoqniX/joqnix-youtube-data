[{"type": "subtitle", "time": 6483.31, "timestamp": "01:48:03", "text": "スナイパー。そうだね。今"}, {"type": "subtitle", "time": 6486.47, "timestamp": "01:48:06", "text": "W側。あ、山上だ。これ鉄鉱ります。"}, {"type": "subtitle", "time": 6487.79, "timestamp": "01:48:07", "text": "救いから。へえ"}, {"type": "subtitle", "time": 6490.27, "timestamp": "01:48:10", "text": "ね。あ、パピ君も来た。これ勝ったな。"}, {"type": "subtitle", "time": 6491.79, "timestamp": "01:48:11", "text": "お、ちょうどいいね。"}, {"type": "subtitle", "time": 6496.31, "timestamp": "01:48:16", "text": "ああ、そこ。"}, {"type": "subtitle", "time": 6507.229, "timestamp": "01:48:27", "text": "362[笑い]"}, {"type": "subtitle", "time": 6508.75, "timestamp": "01:48:28", "text": "来るかどうかわかんないけど。"}, {"type": "subtitle", "time": 6511.07, "timestamp": "01:48:31", "text": "あれだわ。あのフレンドから入るというわ。"}, {"type": "subtitle", "time": 6513.39, "timestamp": "01:48:33", "text": "フレンドからゲームに参加すると"}, {"type": "subtitle", "time": 6518.87, "timestamp": "01:48:38", "text": "許すね。怒りの子は"}, {"type": "subtitle", "time": 6521.27, "timestamp": "01:48:41", "text": "さっきここら辺に見えたかな?敵"}, {"type": "subtitle", "time": 6523.03, "timestamp": "01:48:43", "text": "なんか伏せてんだよね。"}, {"type": "subtitle", "time": 6523.47, "timestamp": "01:48:43", "text": "うん。"}, {"type": "subtitle", "time": 6525.43, "timestamp": "01:48:45", "text": "上から見よう。"}, {"type": "subtitle", "time": 6529.07, "timestamp": "01:48:49", "text": "1"}, {"type": "subtitle", "time": 6531.03, "timestamp": "01:48:51", "text": "人やってたけど多分まだいます。"}, {"type": "subtitle", "time": 6535.91, "timestamp": "01:48:55", "text": "回復がねえな。"}, {"type": "subtitle", "time": 6537.75, "timestamp": "01:48:57", "text": "今日めちゃめちゃラグえな。"}]
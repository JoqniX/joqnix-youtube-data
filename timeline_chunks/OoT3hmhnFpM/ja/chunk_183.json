[{"type": "subtitle", "time": 10985.71, "timestamp": "03:03:05", "text": "うん。ドリル引っ張ってるね。味方が。"}, {"type": "subtitle", "time": 10992.63, "timestamp": "03:03:12", "text": "いや、えっとね、タワー下にいるわ。"}, {"type": "subtitle", "time": 10994.59, "timestamp": "03:03:14", "text": "あ、ハッキング。"}, {"type": "subtitle", "time": 11004.83, "timestamp": "03:03:24", "text": "[笑い]"}, {"type": "subtitle", "time": 11007.59, "timestamp": "03:03:27", "text": "見てみたかったな。"}, {"type": "subtitle", "time": 11010.15, "timestamp": "03:03:30", "text": "いや、でも屋上取れたのでかいっす。"}, {"type": "subtitle", "time": 11014.229, "timestamp": "03:03:34", "text": "[笑い]"}, {"type": "subtitle", "time": 11019.11, "timestamp": "03:03:39", "text": "ありがて。"}, {"type": "subtitle", "time": 11025.269, "timestamp": "03:03:45", "text": "いる。"}, {"type": "subtitle", "time": 11026.63, "timestamp": "03:03:46", "text": "あ、俺もヘリで行くか。"}, {"type": "subtitle", "time": 11027.95, "timestamp": "03:03:47", "text": "オに。"}, {"type": "subtitle", "time": 11029.83, "timestamp": "03:03:49", "text": "あ、マックさんするかな?"}, {"type": "subtitle", "time": 11030.75, "timestamp": "03:03:50", "text": "また行くか。"}]
[{"type": "subtitle", "time": 29110.868, "timestamp": "08:05:10", "text": "赤に取られたね。タワー1。"}, {"type": "subtitle", "time": 29133.11, "timestamp": "08:05:33", "text": "どこにいればいいかな?私潰しちゃったでしょ。"}, {"type": "subtitle", "time": 29133.83, "timestamp": "08:05:33", "text": "あ、"}, {"type": "subtitle", "time": 29138.19, "timestamp": "08:05:38", "text": "時間は稼いだよ。"}, {"type": "subtitle", "time": 29138.948, "timestamp": "08:05:38", "text": "うん。"}, {"type": "subtitle", "time": 29141.948, "timestamp": "08:05:41", "text": "要塞化させられ"}, {"type": "subtitle", "time": 29144.43, "timestamp": "08:05:44", "text": "まさかになるとは思ってなかったんだけど"}, {"type": "subtitle", "time": 29148.23, "timestamp": "08:05:48", "text": "そうなんだよね。"}, {"type": "subtitle", "time": 29152.948, "timestamp": "08:05:52", "text": "そうだ。マジ?"}, {"type": "subtitle", "time": 29153.43, "timestamp": "08:05:53", "text": "はい。"}, {"type": "subtitle", "time": 29156.11, "timestamp": "08:05:56", "text": "すいません。ありがとう。け何度もすま。"}]
[{"type": "subtitle", "time": 9304.309, "timestamp": "02:35:04", "text": "あ、いな。"}, {"type": "subtitle", "time": 9307.23, "timestamp": "02:35:07", "text": "やべえ名前のやつみたいな。"}, {"type": "subtitle", "time": 9311.95, "timestamp": "02:35:11", "text": "[笑い]"}, {"type": "subtitle", "time": 9314.197, "timestamp": "02:35:14", "text": "すいません。すいません。違う違う違う。そういう分かってます。分かってます。戦し"}, {"type": "subtitle", "time": 9321.55, "timestamp": "02:35:21", "text": "やだわ。"}, {"type": "subtitle", "time": 9326.95, "timestamp": "02:35:26", "text": "5回。"}, {"type": "subtitle", "time": 9327.71, "timestamp": "02:35:27", "text": "あら、メイン。5"}, {"type": "subtitle", "time": 9329.51, "timestamp": "02:35:29", "text": "回。5回。5回。5回。5[笑い]回。5"}, {"type": "subtitle", "time": 9338.59, "timestamp": "02:35:38", "text": "うざ。"}, {"type": "subtitle", "time": 9339.59, "timestamp": "02:35:39", "text": "なるほどね。"}, {"type": "subtitle", "time": 9351.532, "timestamp": "02:35:51", "text": "お願い。え、ちょ、今日汗せがすごい。日汗がすごい。"}, {"type": "subtitle", "time": 9351.83, "timestamp": "02:35:51", "text": "[笑い]"}, {"type": "subtitle", "time": 9353.95, "timestamp": "02:35:53", "text": "よし。信じてるよ。大丈夫大丈夫大丈夫。"}, {"type": "subtitle", "time": 9355.75, "timestamp": "02:35:55", "text": "ありがとう。ありがとう。"}]
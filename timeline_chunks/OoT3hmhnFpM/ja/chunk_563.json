[{"type": "subtitle", "time": 33782.87, "timestamp": "09:23:02", "text": "1個あの、持ってけんで。"}, {"type": "subtitle", "time": 33783.426, "timestamp": "09:23:03", "text": "オッケー。"}, {"type": "subtitle", "time": 33787.87, "timestamp": "09:23:07", "text": "ふん。"}, {"type": "subtitle", "time": 33800.346, "timestamp": "09:23:20", "text": "やっぱかき乱し融合か。"}, {"type": "subtitle", "time": 33801.63, "timestamp": "09:23:21", "text": "[笑い]"}, {"type": "subtitle", "time": 33808.23, "timestamp": "09:23:28", "text": "連携取れるなら"}, {"type": "subtitle", "time": 33809.39, "timestamp": "09:23:29", "text": "これで"}, {"type": "subtitle", "time": 33819.266, "timestamp": "09:23:39", "text": "有効ではある感じやね。"}, {"type": "subtitle", "time": 33828.47, "timestamp": "09:23:48", "text": "楽しそう。"}, {"type": "subtitle", "time": 33832.438, "timestamp": "09:23:52", "text": "みんな、みんなぐちゃぐちゃだった。面白かった。聞いてて。なんている。ああ、びっくりした。まだ遠いな。え、遠いか。ん、なんでそこ死んだ?"}]
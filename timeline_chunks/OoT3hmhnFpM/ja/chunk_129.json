[{"type": "subtitle", "time": 7753.31, "timestamp": "02:09:13", "text": "お前500円だから助けてやるよ。"}, {"type": "subtitle", "time": 7756.83, "timestamp": "02:09:16", "text": "どういたしまして。"}, {"type": "subtitle", "time": 7773.27, "timestamp": "02:09:33", "text": "はい。"}, {"type": "subtitle", "time": 7779.069, "timestamp": "02:09:39", "text": "何?"}, {"type": "subtitle", "time": 7780.95, "timestamp": "02:09:40", "text": "オオ。パラシュート。ゴーゴーゴーゴー。"}, {"type": "subtitle", "time": 7782.75, "timestamp": "02:09:42", "text": "オッケー。ナイス。"}, {"type": "subtitle", "time": 7788.31, "timestamp": "02:09:48", "text": "激の子"}, {"type": "subtitle", "time": 7790.31, "timestamp": "02:09:50", "text": "何?"}]
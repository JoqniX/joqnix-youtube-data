[{"type": "subtitle", "time": 16090.63, "timestamp": "04:28:10", "text": "やべ。安いはやっぱダめだな。"}, {"type": "subtitle", "time": 16093.469, "timestamp": "04:28:13", "text": "あれ?今さん安いのなんですか?僕運てください。"}, {"type": "subtitle", "time": 16096.145, "timestamp": "04:28:16", "text": "さっきあの特殊しすぎて金がなくなった。"}, {"type": "subtitle", "time": 16096.95, "timestamp": "04:28:16", "text": "[笑い]"}, {"type": "subtitle", "time": 16103.269, "timestamp": "04:28:23", "text": "ああ、お金かるよね。オ"}, {"type": "subtitle", "time": 16103.75, "timestamp": "04:28:23", "text": "さんも100"}, {"type": "subtitle", "time": 16106.03, "timestamp": "04:28:26", "text": "万ってことはだいぶワンロックしてなくない?多分。"}, {"type": "subtitle", "time": 16119.349, "timestamp": "04:28:39", "text": "うん。ガンガンしてっていいと思うよ。"}, {"type": "subtitle", "time": 16121.83, "timestamp": "04:28:41", "text": "さっきAKアンロックした僕"}, {"type": "subtitle", "time": 16124.31, "timestamp": "04:28:44", "text": "だいぶさっきやね。それは"}, {"type": "subtitle", "time": 16129.79, "timestamp": "04:28:49", "text": "でしょ。"}, {"type": "subtitle", "time": 16131.389, "timestamp": "04:28:51", "text": "AK強いからね。"}, {"type": "subtitle", "time": 16132.59, "timestamp": "04:28:52", "text": "AKマジで強かった。"}, {"type": "subtitle", "time": 16134.269, "timestamp": "04:28:54", "text": "すぐアロックしたわ、俺。"}, {"type": "subtitle", "time": 16137.389, "timestamp": "04:28:57", "text": "俺もAK即だね。"}]
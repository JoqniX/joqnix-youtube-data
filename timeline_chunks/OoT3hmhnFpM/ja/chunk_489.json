[{"type": "subtitle", "time": 29354.59, "timestamp": "08:09:14", "text": "これね。今作れ。"}, {"type": "subtitle", "time": 29357.308, "timestamp": "08:09:17", "text": "今タキャプチすぎとここまた"}, {"type": "subtitle", "time": 29359.23, "timestamp": "08:09:19", "text": "ロリポップちょっとあの下下がってもらっていい?"}, {"type": "subtitle", "time": 29360.23, "timestamp": "08:09:20", "text": "こっちが生きてるうちにもう1"}, {"type": "subtitle", "time": 29361.75, "timestamp": "08:09:21", "text": "回行くのか?"}, {"type": "subtitle", "time": 29363.15, "timestamp": "08:09:23", "text": "行くか。オッケー。"}, {"type": "subtitle", "time": 29365.07, "timestamp": "08:09:25", "text": "はあ。ああ。"}, {"type": "subtitle", "time": 29371.708, "timestamp": "08:09:31", "text": "また1万3000が。"}, {"type": "subtitle", "time": 29373.802, "timestamp": "08:09:33", "text": "おお、俺も1万2000円が。ひ、"}, {"type": "subtitle", "time": 29375.67, "timestamp": "08:09:35", "text": "[笑い]"}, {"type": "subtitle", "time": 29377.43, "timestamp": "08:09:37", "text": "待って。今行くぞ。"}, {"type": "subtitle", "time": 29378.948, "timestamp": "08:09:38", "text": "今行く。"}, {"type": "subtitle", "time": 29395.388, "timestamp": "08:09:55", "text": "あれ?俺どえ?あれ?"}, {"type": "subtitle", "time": 29396.548, "timestamp": "08:09:56", "text": "ナイス。"}, {"type": "subtitle", "time": 29397.15, "timestamp": "08:09:57", "text": "あれじゃね?"}]
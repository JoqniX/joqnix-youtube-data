[{"type": "subtitle", "time": 9361.87, "timestamp": "02:36:01", "text": "チェジして。"}, {"type": "subtitle", "time": 9374.55, "timestamp": "02:36:14", "text": "視聴者が面白かったってことね。"}, {"type": "subtitle", "time": 9376.429, "timestamp": "02:36:16", "text": "え、何?え、何?オ、オ、"}, {"type": "subtitle", "time": 9379.309, "timestamp": "02:36:19", "text": "視聴者が面白かったってこと?"}, {"type": "subtitle", "time": 9384.309, "timestamp": "02:36:24", "text": "そう。"}, {"type": "subtitle", "time": 9386.71, "timestamp": "02:36:26", "text": "ちょっとそれがちょ見になっちゃった。"}, {"type": "subtitle", "time": 9388.15, "timestamp": "02:36:28", "text": "しただけね。"}, {"type": "subtitle", "time": 9390.67, "timestamp": "02:36:30", "text": "そうそうそうそう。別に僕もあの"}, {"type": "subtitle", "time": 9396.59, "timestamp": "02:36:36", "text": "あるわけよ。そういう方言が。"}, {"type": "subtitle", "time": 9406.83, "timestamp": "02:36:46", "text": "さ、ここら辺で下ろした。[笑い]"}, {"type": "subtitle", "time": 9412.23, "timestamp": "02:36:52", "text": "ボロた。"}, {"type": "subtitle", "time": 9418.998, "timestamp": "02:36:58", "text": "俺そういう話ちょっと苦手だからさ。"}, {"type": "subtitle", "time": 9419.63, "timestamp": "02:36:59", "text": "[笑い]"}]
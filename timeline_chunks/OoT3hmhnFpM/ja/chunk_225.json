[{"type": "subtitle", "time": 13512.189, "timestamp": "03:45:12", "text": "これ俺迫撃こっち。あ、オ任せろ。"}, {"type": "subtitle", "time": 13514.149, "timestamp": "03:45:14", "text": "あ、オッケ。やるわ。やるわ。"}, {"type": "subtitle", "time": 13516.149, "timestamp": "03:45:16", "text": "許せねえ。許せねえ。"}, {"type": "subtitle", "time": 13517.99, "timestamp": "03:45:17", "text": "激のコア"}, {"type": "subtitle", "time": 13518.99, "timestamp": "03:45:18", "text": "高速"}, {"type": "subtitle", "time": 13520.63, "timestamp": "03:45:20", "text": "ドリル作り。"}, {"type": "subtitle", "time": 13521.95, "timestamp": "03:45:21", "text": "うん。任した。"}, {"type": "subtitle", "time": 13540.349, "timestamp": "03:45:40", "text": "少なくとも3人はやるね。"}, {"type": "subtitle", "time": 13548.429, "timestamp": "03:45:48", "text": "1個作っとくわ。"}, {"type": "subtitle", "time": 13548.67, "timestamp": "03:45:48", "text": "2"}, {"type": "subtitle", "time": 13550.309, "timestamp": "03:45:50", "text": "個作っていいと思うわ。"}, {"type": "subtitle", "time": 13552.67, "timestamp": "03:45:52", "text": "オファイ。"}, {"type": "subtitle", "time": 13554.51, "timestamp": "03:45:54", "text": "こんだけいれば多分"}, {"type": "subtitle", "time": 13557.309, "timestamp": "03:45:57", "text": "誰かしらやってくれるでしょ"}]
[{"type": "subtitle", "time": 10441.269, "timestamp": "02:54:01", "text": "うん。うん。"}, {"type": "subtitle", "time": 10443.469, "timestamp": "02:54:03", "text": "味方起こしてくれてるかいって。え、何?何?"}, {"type": "subtitle", "time": 10445.429, "timestamp": "02:54:05", "text": "だ、"}, {"type": "subtitle", "time": 10452.59, "timestamp": "02:54:12", "text": "起こしてもらってから。"}, {"type": "subtitle", "time": 10461.75, "timestamp": "02:54:21", "text": "これも特殊。"}, {"type": "subtitle", "time": 10467.07, "timestamp": "02:54:27", "text": "ええ。"}, {"type": "subtitle", "time": 10474.19, "timestamp": "02:54:34", "text": "やばすぎ。"}, {"type": "subtitle", "time": 10476.07, "timestamp": "02:54:36", "text": "やべ、まジか。"}, {"type": "subtitle", "time": 10476.99, "timestamp": "02:54:36", "text": "大人すぎる。"}, {"type": "subtitle", "time": 10479.309, "timestamp": "02:54:39", "text": "南のゲートがきっぱなしだ、これ。"}, {"type": "subtitle", "time": 10481.19, "timestamp": "02:54:41", "text": "マジ?了解。"}, {"type": "subtitle", "time": 10482.51, "timestamp": "02:54:42", "text": "こっから入ってるわ。"}, {"type": "subtitle", "time": 10485.07, "timestamp": "02:54:45", "text": "そこをちょっと見るわ。今"}, {"type": "subtitle", "time": 10488.309, "timestamp": "02:54:48", "text": "F近くにいるから死ぬか俺。"}, {"type": "subtitle", "time": 10489.229, "timestamp": "02:54:49", "text": "さんありがとう。"}, {"type": "subtitle", "time": 10491.229, "timestamp": "02:54:51", "text": "まだクリアしてないよね。多分これ"}, {"type": "subtitle", "time": 10493.07, "timestamp": "02:54:53", "text": "してないね。"}, {"type": "subtitle", "time": 10498.51, "timestamp": "02:54:58", "text": "行った方がいいかな。"}]
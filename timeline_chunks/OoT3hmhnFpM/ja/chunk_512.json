[{"type": "subtitle", "time": 30720.388, "timestamp": "08:32:00", "text": "あ、見えない、見えない、見えない。"}, {"type": "subtitle", "time": 30726.948, "timestamp": "08:32:06", "text": "あと上にファランクスと手前にサムかな?"}, {"type": "subtitle", "time": 30737.67, "timestamp": "08:32:17", "text": "いてえ。えっと違うなんだ?"}, {"type": "subtitle", "time": 30739.91, "timestamp": "08:32:19", "text": "いて死ぬ。"}, {"type": "subtitle", "time": 30742.708, "timestamp": "08:32:22", "text": "違うやつじゃないと思う。"}, {"type": "subtitle", "time": 30747.07, "timestamp": "08:32:27", "text": "2"}, {"type": "subtitle", "time": 30748.07, "timestamp": "08:32:28", "text": "番とこ。"}, {"type": "subtitle", "time": 30750.07, "timestamp": "08:32:30", "text": "2番だね、多分。"}, {"type": "subtitle", "time": 30763.468, "timestamp": "08:32:43", "text": "2番行きます。あ、2番行っていいかな?"}, {"type": "subtitle", "time": 30765.548, "timestamp": "08:32:45", "text": "うん。"}, {"type": "subtitle", "time": 30772.27, "timestamp": "08:32:52", "text": "やばそう。"}, {"type": "subtitle", "time": 30774.708, "timestamp": "08:32:54", "text": "待って。"}, {"type": "subtitle", "time": 30776.43, "timestamp": "08:32:56", "text": "45で飛ばしてる。"}, {"type": "subtitle", "time": 30778.07, "timestamp": "08:32:58", "text": "あとここにもあるかもね。"}]
[{"type": "subtitle", "time": 15900.389, "timestamp": "04:25:00", "text": "めちゃめちゃ疲れてたっぽいわ。多分"}, {"type": "subtitle", "time": 15902.83, "timestamp": "04:25:02", "text": "僕もすぐ寝た。マジで。"}, {"type": "subtitle", "time": 15904.109, "timestamp": "04:25:04", "text": "俺もそうね。"}, {"type": "subtitle", "time": 15906.71, "timestamp": "04:25:06", "text": "飯食ってシャワー浴びたらもう気絶したわ。"}, {"type": "subtitle", "time": 15909.429, "timestamp": "04:25:09", "text": "え、こもそう。"}, {"type": "subtitle", "time": 15912.71, "timestamp": "04:25:12", "text": "21時間ないだ"}, {"type": "subtitle", "time": 15915.349, "timestamp": "04:25:15", "text": "6時間は待機。"}, {"type": "subtitle", "time": 15916.75, "timestamp": "04:25:16", "text": "まあね。4"}, {"type": "subtitle", "time": 15919.71, "timestamp": "04:25:19", "text": "時間だけ寝て。民度は4時間睡眠と。"}, {"type": "subtitle", "time": 15926.349, "timestamp": "04:25:26", "text": "ん。俺10"}, {"type": "subtitle", "time": 15928.429, "timestamp": "04:25:28", "text": "時間か11時間ぐらいかな。あ、"}, {"type": "subtitle", "time": 15929.83, "timestamp": "04:25:29", "text": "お寝たね。"}, {"type": "subtitle", "time": 15932.469, "timestamp": "04:25:32", "text": "でもロングスリーパーじゃなかったっけ?"}, {"type": "subtitle", "time": 15935.55, "timestamp": "04:25:35", "text": "うん。ま、基本つも10時間以上かな。"}, {"type": "subtitle", "time": 15936.109, "timestamp": "04:25:36", "text": "ああ、"}, {"type": "subtitle", "time": 15937.91, "timestamp": "04:25:37", "text": "今日はまだ少ない方やね。"}, {"type": "subtitle", "time": 15944.71, "timestamp": "04:25:44", "text": "神電車じゃ"}, {"type": "subtitle", "time": 15959.269, "timestamp": "04:25:59", "text": "はい。"}]
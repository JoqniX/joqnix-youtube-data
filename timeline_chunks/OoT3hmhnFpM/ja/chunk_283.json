[{"type": "subtitle", "time": 16982.23, "timestamp": "04:43:02", "text": "あれ?ファリフ。"}, {"type": "subtitle", "time": 16984.03, "timestamp": "04:43:04", "text": "ああ。"}, {"type": "subtitle", "time": 17004.948, "timestamp": "04:43:24", "text": "いやなかなかその2つが倒せない。オ上の"}, {"type": "subtitle", "time": 17007.43, "timestamp": "04:43:27", "text": "やつ1人殺したわ。"}, {"type": "subtitle", "time": 17008.99, "timestamp": "04:43:28", "text": "じゃ、僕壊れてるわ。"}, {"type": "subtitle", "time": 17010.788, "timestamp": "04:43:30", "text": "オオ下狙いで。"}, {"type": "subtitle", "time": 17011.67, "timestamp": "04:43:31", "text": "うん。"}, {"type": "subtitle", "time": 17013.15, "timestamp": "04:43:33", "text": "上俺が壊せるわ、多分これで。"}, {"type": "subtitle", "time": 17027.51, "timestamp": "04:43:47", "text": "伸びろ。ナイス。"}, {"type": "subtitle", "time": 17034.788, "timestamp": "04:43:54", "text": "お願いします。うん。どんどん作るから。あいつら。"}, {"type": "subtitle", "time": 17035.628, "timestamp": "04:43:55", "text": "うん。"}]
[{"type": "subtitle", "time": 20582.03, "timestamp": "05:43:02", "text": "いや、こんなに"}, {"type": "subtitle", "time": 20584.51, "timestamp": "05:43:04", "text": "来てくれるのありがたいな。"}, {"type": "subtitle", "time": 20591.27, "timestamp": "05:43:11", "text": "はい。"}, {"type": "subtitle", "time": 20593.03, "timestamp": "05:43:13", "text": "バルキ"}, {"type": "subtitle", "time": 20594.39, "timestamp": "05:43:14", "text": "ヴルキしかない。赤"}, {"type": "subtitle", "time": 20595.83, "timestamp": "05:43:15", "text": "オいよ。いいよ。そこ入っちゃおう。"}, {"type": "subtitle", "time": 20596.708, "timestamp": "05:43:16", "text": "はい。"}, {"type": "subtitle", "time": 20598.99, "timestamp": "05:43:18", "text": "俺はちょっとロードが長いてるわ。なんか"}, {"type": "subtitle", "time": 20599.39, "timestamp": "05:43:19", "text": "あか"}, {"type": "subtitle", "time": 20600.59, "timestamp": "05:43:20", "text": "はい。"}, {"type": "subtitle", "time": 20601.468, "timestamp": "05:43:21", "text": "こんにちは。"}, {"type": "subtitle", "time": 20603.39, "timestamp": "05:43:23", "text": "やばい。フワ"}, {"type": "subtitle", "time": 20611.83, "timestamp": "05:43:31", "text": "レはもうマジで"}, {"type": "subtitle", "time": 20613.83, "timestamp": "05:43:33", "text": "1/3に相当するから"}, {"type": "subtitle", "time": 20614.99, "timestamp": "05:43:34", "text": "チーム内で"}, {"type": "subtitle", "time": 20617.27, "timestamp": "05:43:37", "text": "責任重大や。"}, {"type": "subtitle", "time": 20619.548, "timestamp": "05:43:39", "text": "えっとフォックス作りました。"}, {"type": "subtitle", "time": 20620.99, "timestamp": "05:43:40", "text": "はい。"}, {"type": "subtitle", "time": 20621.91, "timestamp": "05:43:41", "text": "ね。"}, {"type": "subtitle", "time": 20629.11, "timestamp": "05:43:49", "text": "頼む。"}]
[{"type": "subtitle", "time": 6376.109, "timestamp": "01:46:16", "text": "ワの方から打ってきてるんですけど、今"}, {"type": "subtitle", "time": 6379.189, "timestamp": "01:46:19", "text": "しばいてます。苦手。ありがとうござい"}, {"type": "subtitle", "time": 6384.43, "timestamp": "01:46:24", "text": "ます。了解しました。殺す。てめ、てめ"}, {"type": "subtitle", "time": 6388.31, "timestamp": "01:46:28", "text": "やってやるぞ。俺はタワだって有力じゃ"}, {"type": "subtitle", "time": 6390.669, "timestamp": "01:46:30", "text": "ねえか。ちくしがよ。なんだもんなん度も"}, {"type": "subtitle", "time": 6394.55, "timestamp": "01:46:34", "text": "なん度もなんだも。ぶち殺しや。"}, {"type": "subtitle", "time": 6397.43, "timestamp": "01:46:37", "text": "お前の玉の屋上からだろ。どうせちくしょ"}, {"type": "subtitle", "time": 6405.669, "timestamp": "01:46:45", "text": "怒りの子は"}, {"type": "subtitle", "time": 6406.95, "timestamp": "01:46:46", "text": "ちょっと待ってね。"}, {"type": "subtitle", "time": 6414.83, "timestamp": "01:46:54", "text": "えっと、怒りの妹"}, {"type": "subtitle", "time": 6417.589, "timestamp": "01:46:57", "text": "いいね。ふざけんな、マジ。"}]
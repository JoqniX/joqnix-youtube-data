[{"type": "subtitle", "time": 27485.67, "timestamp": "07:38:05", "text": "えっと、チカパンさんが落ちたって言った。"}, {"type": "subtitle", "time": 27488.19, "timestamp": "07:38:08", "text": "入ってんのかな?よいしょ。あ、じゃあ出ます。"}, {"type": "subtitle", "time": 27489.788, "timestamp": "07:38:09", "text": "一旦出ましょうか。はい。"}, {"type": "subtitle", "time": 27491.51, "timestamp": "07:38:11", "text": "はい。どしたね。"}, {"type": "subtitle", "time": 27493.27, "timestamp": "07:38:13", "text": "あ、じゃ、ちょっと俺おた行ってきていか。"}, {"type": "subtitle", "time": 27494.99, "timestamp": "07:38:14", "text": "あ、全然オッケー。全然オッケー。"}, {"type": "subtitle", "time": 27495.548, "timestamp": "07:38:15", "text": "はい。"}, {"type": "subtitle", "time": 27521.19, "timestamp": "07:38:41", "text": "えかったな。あや、これ違うか?"}, {"type": "subtitle", "time": 27522.51, "timestamp": "07:38:42", "text": "くそ。"}, {"type": "subtitle", "time": 27529.868, "timestamp": "07:38:49", "text": "マジ邪魔されたね。めちゃくちゃ"}, {"type": "subtitle", "time": 27535.75, "timestamp": "07:38:55", "text": "本当によ"}]
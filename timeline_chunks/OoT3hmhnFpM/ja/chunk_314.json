[{"type": "subtitle", "time": 18841.19, "timestamp": "05:14:01", "text": "守るにしても迫撃砲潰さなきゃなんだよな。難しい。"}, {"type": "subtitle", "time": 18843.43, "timestamp": "05:14:03", "text": "そう、そうなんだよね。難しいよね。迫撃砲。"}, {"type": "subtitle", "time": 18848.83, "timestamp": "05:14:08", "text": "行きましょう。2人でなんとか。"}, {"type": "subtitle", "time": 18850.27, "timestamp": "05:14:10", "text": "えっと、あともう1"}, {"type": "subtitle", "time": 18855.43, "timestamp": "05:14:15", "text": "そこの人。"}, {"type": "subtitle", "time": 18858.31, "timestamp": "05:14:18", "text": "うん。来る来る。"}, {"type": "subtitle", "time": 18865.708, "timestamp": "05:14:25", "text": "うん。"}, {"type": "subtitle", "time": 18866.39, "timestamp": "05:14:26", "text": "わからん。"}, {"type": "subtitle", "time": 18867.31, "timestamp": "05:14:27", "text": "センキュー。テンキュー。"}, {"type": "subtitle", "time": 18872.15, "timestamp": "05:14:32", "text": "お"}, {"type": "subtitle", "time": 18873.39, "timestamp": "05:14:33", "text": "特殊部隊ごしません。"}, {"type": "subtitle", "time": 18878.628, "timestamp": "05:14:38", "text": "はい。"}, {"type": "subtitle", "time": 18879.67, "timestamp": "05:14:39", "text": "じゃあどうぞ。"}, {"type": "subtitle", "time": 18881.39, "timestamp": "05:14:41", "text": "行く先はスタジアム。"}, {"type": "subtitle", "time": 18882.19, "timestamp": "05:14:42", "text": "はい。"}, {"type": "subtitle", "time": 18895.948, "timestamp": "05:14:55", "text": "そうだね。"}, {"type": "subtitle", "time": 18896.99, "timestamp": "05:14:56", "text": "こね。"}, {"type": "subtitle", "time": 18898.922, "timestamp": "05:14:58", "text": "うん。気をつけながら。でもそ本当にそこちょっとわかんねえな。"}]
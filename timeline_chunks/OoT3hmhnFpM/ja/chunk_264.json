[{"type": "subtitle", "time": 15840.71, "timestamp": "04:24:00", "text": "でいいんかな?"}, {"type": "subtitle", "time": 15842.55, "timestamp": "04:24:02", "text": "126"}, {"type": "subtitle", "time": 15847.83, "timestamp": "04:24:07", "text": "いやあ、"}, {"type": "subtitle", "time": 15854.99, "timestamp": "04:24:14", "text": "はい。もうローンスターしか入れません。"}, {"type": "subtitle", "time": 15858.63, "timestamp": "04:24:18", "text": "もう今日1日中じゃん。やるね、"}, {"type": "subtitle", "time": 15859.03, "timestamp": "04:24:19", "text": "みんな。"}, {"type": "subtitle", "time": 15865.71, "timestamp": "04:24:25", "text": "なるほどね。"}, {"type": "subtitle", "time": 15872.269, "timestamp": "04:24:32", "text": "分隊を作ります。"}, {"type": "subtitle", "time": 15873.469, "timestamp": "04:24:33", "text": "作ってます。"}, {"type": "subtitle", "time": 15881.03, "timestamp": "04:24:41", "text": "民が俺から入ったから勝手に分体作られるのか。"}, {"type": "subtitle", "time": 15883.51, "timestamp": "04:24:43", "text": "あ、そういう感じなんだ。"}, {"type": "subtitle", "time": 15885.67, "timestamp": "04:24:45", "text": "うん。なんか勝手に分隊長にされたわ、今。"}, {"type": "subtitle", "time": 15887.852, "timestamp": "04:24:47", "text": "いいね。隊長。"}, {"type": "subtitle", "time": 15888.95, "timestamp": "04:24:48", "text": "[笑い]"}, {"type": "subtitle", "time": 15890.429, "timestamp": "04:24:50", "text": "あ、"}, {"type": "subtitle", "time": 15893.269, "timestamp": "04:24:53", "text": "隊長やる気あります。"}, {"type": "subtitle", "time": 15895.389, "timestamp": "04:24:55", "text": "あ、じゃ、ぐっすり寝れたんすか?昨日。ちなみに。"}, {"type": "subtitle", "time": 15896.83, "timestamp": "04:24:56", "text": "はい。9時間寝ました。"}, {"type": "subtitle", "time": 15897.71, "timestamp": "04:24:57", "text": "いや、素晴らしい。"}]
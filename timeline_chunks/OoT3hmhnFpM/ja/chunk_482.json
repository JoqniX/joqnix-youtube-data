[{"type": "subtitle", "time": 28953.91, "timestamp": "08:02:33", "text": "ごめん。"}, {"type": "subtitle", "time": 28955.67, "timestamp": "08:02:35", "text": "え、そんなマンション上から"}, {"type": "subtitle", "time": 28957.23, "timestamp": "08:02:37", "text": "スナイパー、スナイパービケ。"}, {"type": "subtitle", "time": 28959.23, "timestamp": "08:02:39", "text": "わけわかんないとこが狙われるんだよね。"}, {"type": "subtitle", "time": 28960.43, "timestamp": "08:02:40", "text": "いや、これは"}, {"type": "subtitle", "time": 28969.51, "timestamp": "08:02:49", "text": "黄かったもんね。"}, {"type": "subtitle", "time": 28971.548, "timestamp": "08:02:51", "text": "うん。ワンチャン敵るしか。"}, {"type": "subtitle", "time": 28973.788, "timestamp": "08:02:53", "text": "ブロック2つぐらい積み上げてください。"}, {"type": "subtitle", "time": 28976.15, "timestamp": "08:02:56", "text": "まあまあまあまあまあ。あれされ。"}, {"type": "subtitle", "time": 28979.59, "timestamp": "08:02:59", "text": "3"}]
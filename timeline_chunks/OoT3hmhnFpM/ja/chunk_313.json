[{"type": "subtitle", "time": 18784.91, "timestamp": "05:13:04", "text": "今南まだきつい。"}, {"type": "subtitle", "time": 18786.39, "timestamp": "05:13:06", "text": "あ、そうだね。thanキューソマ。"}, {"type": "subtitle", "time": 18797.75, "timestamp": "05:13:17", "text": "どっかから撃たれてん。"}, {"type": "subtitle", "time": 18800.19, "timestamp": "05:13:20", "text": "それかマンションの上だったんだよな。"}, {"type": "subtitle", "time": 18808.83, "timestamp": "05:13:28", "text": "え、まだ緑にやられた?どうだろう?"}, {"type": "subtitle", "time": 18829.788, "timestamp": "05:13:49", "text": "オッケー。え、したら"}, {"type": "subtitle", "time": 18831.83, "timestamp": "05:13:51", "text": "きます。敵は"}, {"type": "subtitle", "time": 18838.67, "timestamp": "05:13:58", "text": "うん。拠点守るか。"}]
[{"type": "subtitle", "time": 9421.349, "timestamp": "02:37:01", "text": "大丈夫。気にしてないよ。"}, {"type": "subtitle", "time": 9429.269, "timestamp": "02:37:09", "text": "傷。"}, {"type": "subtitle", "time": 9436.63, "timestamp": "02:37:16", "text": "本当に"}, {"type": "subtitle", "time": 9437.87, "timestamp": "02:37:17", "text": "ちょ、ちょ待って。悲しくなってきた。"}, {"type": "subtitle", "time": 9443.888, "timestamp": "02:37:23", "text": "俺今日今日悲しいよ。"}, {"type": "subtitle", "time": 9444.269, "timestamp": "02:37:24", "text": "[笑い]"}, {"type": "subtitle", "time": 9446.83, "timestamp": "02:37:26", "text": "俺まってこ"}, {"type": "subtitle", "time": 9453.058, "timestamp": "02:37:33", "text": "すごい。あ、大丈夫さん大丈夫。こさん大丈夫だから。"}, {"type": "subtitle", "time": 9458.95, "timestamp": "02:37:38", "text": "これ違う。"}, {"type": "subtitle", "time": 9460.919, "timestamp": "02:37:40", "text": "お前ら何も聞いてなかったわ。"}, {"type": "subtitle", "time": 9462.87, "timestamp": "02:37:42", "text": "[笑い]"}, {"type": "subtitle", "time": 9475.95, "timestamp": "02:37:55", "text": "う、本当日がやばい。今"}, {"type": "subtitle", "time": 9477.79, "timestamp": "02:37:57", "text": "乗り物の名前よね、普通の。"}, {"type": "subtitle", "time": 9479.51, "timestamp": "02:37:59", "text": "そう、乗り物です。"}]
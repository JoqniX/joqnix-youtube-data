[{"type": "subtitle", "time": 10561.309, "timestamp": "02:56:01", "text": "外"}, {"type": "subtitle", "time": 10561.75, "timestamp": "02:56:01", "text": "はい。"}, {"type": "subtitle", "time": 10562.91, "timestamp": "02:56:02", "text": "もうちょい人が欲しいな。"}, {"type": "subtitle", "time": 10565.59, "timestamp": "02:56:05", "text": "いつも助けてくれてありがとね。"}, {"type": "subtitle", "time": 10568.309, "timestamp": "02:56:08", "text": "うん。ありがとう。もう"}, {"type": "subtitle", "time": 10569.349, "timestamp": "02:56:09", "text": "先は告げずに。"}, {"type": "subtitle", "time": 10571.07, "timestamp": "02:56:11", "text": "あ。"}, {"type": "subtitle", "time": 10573.87, "timestamp": "02:56:13", "text": "あ、でもこれリスポンビークルちょっと運転してきた方がいいな。"}, {"type": "subtitle", "time": 10576.03, "timestamp": "02:56:16", "text": "なんでお前それ開けたの?マジで"}, {"type": "subtitle", "time": 10590.83, "timestamp": "02:56:30", "text": "仕方ない。そしたら我々2"}, {"type": "subtitle", "time": 10592.19, "timestamp": "02:56:32", "text": "人で屋上行きますか。"}, {"type": "subtitle", "time": 10593.19, "timestamp": "02:56:33", "text": "オッケー。"}, {"type": "subtitle", "time": 10595.309, "timestamp": "02:56:35", "text": "あ、オッケー。"}, {"type": "subtitle", "time": 10597.87, "timestamp": "02:56:37", "text": "あ、え、あ、アクさんは乗る。オ、"}, {"type": "subtitle", "time": 10599.11, "timestamp": "02:56:39", "text": "あ、スナイ、スナイパー。"}, {"type": "subtitle", "time": 10601.15, "timestamp": "02:56:41", "text": "あ、じゃあ乗ります。乗ります。乗ります。"}, {"type": "subtitle", "time": 10602.51, "timestamp": "02:56:42", "text": "オ、オケ、オッケー。ちょっと"}, {"type": "subtitle", "time": 10604.75, "timestamp": "02:56:44", "text": "特殊部隊ごこ頼む。"}, {"type": "subtitle", "time": 10606.15, "timestamp": "02:56:46", "text": "特殊部隊ごこしましょう。"}, {"type": "subtitle", "time": 10607.91, "timestamp": "02:56:47", "text": "この世界を変えてくれ。"}, {"type": "subtitle", "time": 10617.75, "timestamp": "02:56:57", "text": "あのさ、ボタン押すがあるじゃん。"}]
[{"type": "subtitle", "time": 17820.91, "timestamp": "04:57:00", "text": "ちんちん電車が来てくれてるわ。"}, {"type": "subtitle", "time": 17822.43, "timestamp": "04:57:02", "text": "あ、よかった。"}, {"type": "subtitle", "time": 17824.15, "timestamp": "04:57:04", "text": "あ、でも資材と燃料"}, {"type": "subtitle", "time": 17826.99, "timestamp": "04:57:06", "text": "1か。微妙に届。"}, {"type": "subtitle", "time": 17846.67, "timestamp": "04:57:26", "text": "もう1回行って。"}, {"type": "subtitle", "time": 17847.83, "timestamp": "04:57:27", "text": "大丈夫、大丈夫、大丈夫。なんでもない。"}, {"type": "subtitle", "time": 17849.15, "timestamp": "04:57:29", "text": "はい。オッケー。"}, {"type": "subtitle", "time": 17854.39, "timestamp": "04:57:34", "text": "もう1個作る。"}, {"type": "subtitle", "time": 17855.868, "timestamp": "04:57:35", "text": "俺もう1個作っとくよ。"}, {"type": "subtitle", "time": 17857.46, "timestamp": "04:57:37", "text": "ありがとう。ありがとう。"}, {"type": "subtitle", "time": 17859.07, "timestamp": "04:57:39", "text": "[うめき声]"}, {"type": "subtitle", "time": 17861.23, "timestamp": "04:57:41", "text": "んだ"}, {"type": "subtitle", "time": 17862.23, "timestamp": "04:57:42", "text": "さ。"}, {"type": "subtitle", "time": 17874.75, "timestamp": "04:57:54", "text": "よいしょ。"}, {"type": "subtitle", "time": 17879.15, "timestamp": "04:57:59", "text": "オ。"}]
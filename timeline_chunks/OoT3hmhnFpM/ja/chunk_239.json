[{"type": "subtitle", "time": 14344.229, "timestamp": "03:59:04", "text": "いていてな"}, {"type": "subtitle", "time": 14346.55, "timestamp": "03:59:06", "text": "んだなんだ。"}, {"type": "subtitle", "time": 14350.429, "timestamp": "03:59:10", "text": "そっか。"}, {"type": "subtitle", "time": 14352.51, "timestamp": "03:59:12", "text": "ほおん。そこに作ったのか。"}, {"type": "subtitle", "time": 14355.389, "timestamp": "03:59:15", "text": "あ、ちさんうまい。ナイス。"}, {"type": "subtitle", "time": 14357.269, "timestamp": "03:59:17", "text": "あれ?ハピスってまだ上から見てる?"}, {"type": "subtitle", "time": 14358.469, "timestamp": "03:59:18", "text": "うん。"}, {"type": "subtitle", "time": 14360.75, "timestamp": "03:59:20", "text": "どうだ?俺らの辺りいる?どっか?"}, {"type": "subtitle", "time": 14366.59, "timestamp": "03:59:26", "text": "あれか?見えてたの"}, {"type": "subtitle", "time": 14367.87, "timestamp": "03:59:27", "text": "2人だもんね。"}, {"type": "subtitle", "time": 14369.03, "timestamp": "03:59:29", "text": "うん。"}, {"type": "subtitle", "time": 14386.469, "timestamp": "03:59:46", "text": "南側の岩裏とかは見えないかな?俺の方だと。"}, {"type": "subtitle", "time": 14389.79, "timestamp": "03:59:49", "text": "あれか。やべえ。"}, {"type": "subtitle", "time": 14391.99, "timestamp": "03:59:51", "text": "えっと、今近パンさん死下いるわ。"}, {"type": "subtitle", "time": 14392.95, "timestamp": "03:59:52", "text": "道路出た。"}, {"type": "subtitle", "time": 14395.189, "timestamp": "03:59:55", "text": "できた。な"}, {"type": "subtitle", "time": 14396.309, "timestamp": "03:59:56", "text": "んだ?撃たれてる。"}, {"type": "subtitle", "time": 14398.269, "timestamp": "03:59:58", "text": "誰かいるか?"}]
[{"type": "subtitle", "time": 28628.468, "timestamp": "07:57:08", "text": "これむずいな。作り方。"}, {"type": "subtitle", "time": 28630.91, "timestamp": "07:57:10", "text": "あと25秒ぐらい。"}, {"type": "subtitle", "time": 28651.07, "timestamp": "07:57:31", "text": "ジョックいる。どこ?"}, {"type": "subtitle", "time": 28651.35, "timestamp": "07:57:31", "text": "あれ?"}, {"type": "subtitle", "time": 28659.19, "timestamp": "07:57:39", "text": "これ下に戦う必要があんないんだよな、"}, {"type": "subtitle", "time": 28660.67, "timestamp": "07:57:40", "text": "これ。うん。キャプチャーするわ。"}, {"type": "subtitle", "time": 28661.59, "timestamp": "07:57:41", "text": "オッケー。"}, {"type": "subtitle", "time": 28670.27, "timestamp": "07:57:50", "text": "オオオ。"}, {"type": "subtitle", "time": 28672.27, "timestamp": "07:57:52", "text": "で、僕の方で試しちゃっていいんでね。"}, {"type": "subtitle", "time": 28673.388, "timestamp": "07:57:53", "text": "うん。うん。うん。"}, {"type": "subtitle", "time": 28673.788, "timestamp": "07:57:53", "text": "了解。"}, {"type": "subtitle", "time": 28676.308, "timestamp": "07:57:56", "text": "あ、でもこれ全てのタワーが必要なパターン。"}, {"type": "subtitle", "time": 28678.07, "timestamp": "07:57:58", "text": "あ、"}]
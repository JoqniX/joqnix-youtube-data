[{"type": "subtitle", "time": 26520.75, "timestamp": "07:22:00", "text": "え、したらば、え、ちょっと待って。"}, {"type": "subtitle", "time": 26523.388, "timestamp": "07:22:03", "text": "俺が運転しましょうか。"}, {"type": "subtitle", "time": 26523.708, "timestamp": "07:22:03", "text": "お"}, {"type": "subtitle", "time": 26524.43, "timestamp": "07:22:04", "text": "うん。"}, {"type": "subtitle", "time": 26527.23, "timestamp": "07:22:07", "text": "運転してくれてマークスさんが"}, {"type": "subtitle", "time": 26530.19, "timestamp": "07:22:10", "text": "俺も行くか。だし"}, {"type": "subtitle", "time": 26530.67, "timestamp": "07:22:10", "text": "た。"}, {"type": "subtitle", "time": 26531.51, "timestamp": "07:22:11", "text": "特殊部隊。"}, {"type": "subtitle", "time": 26536.964, "timestamp": "07:22:16", "text": "もうぶち殺してやる。"}, {"type": "subtitle", "time": 26544.27, "timestamp": "07:22:24", "text": "え、下ちょっと俺も"}, {"type": "subtitle", "time": 26554.35, "timestamp": "07:22:34", "text": "え、"}, {"type": "subtitle", "time": 26577.03, "timestamp": "07:22:57", "text": "[うめき声]"}, {"type": "subtitle", "time": 26578.35, "timestamp": "07:22:58", "text": "んでこれこんな"}]
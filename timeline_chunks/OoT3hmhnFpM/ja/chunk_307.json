[{"type": "subtitle", "time": 18421.39, "timestamp": "05:07:01", "text": "え、"}, {"type": "subtitle", "time": 18422.35, "timestamp": "05:07:02", "text": "グレか。"}, {"type": "subtitle", "time": 18424.19, "timestamp": "05:07:04", "text": "え、なんか味方の、え、どういこと?"}, {"type": "subtitle", "time": 18425.23, "timestamp": "05:07:05", "text": "うん、うん、うん。"}, {"type": "subtitle", "time": 18427.91, "timestamp": "05:07:07", "text": "味方のヘリのグレで殺されたんだけど俺。"}, {"type": "subtitle", "time": 18428.548, "timestamp": "05:07:08", "text": "どいうこと?"}, {"type": "subtitle", "time": 18429.948, "timestamp": "05:07:09", "text": "恐ろしい。"}, {"type": "subtitle", "time": 18434.99, "timestamp": "05:07:14", "text": "入り口いるわ、これ。"}, {"type": "subtitle", "time": 18436.23, "timestamp": "05:07:16", "text": "入り口いる。オッケー。"}, {"type": "subtitle", "time": 18439.23, "timestamp": "05:07:19", "text": "了解。出て左"}, {"type": "subtitle", "time": 18448.868, "timestamp": "05:07:28", "text": "うん。上から打つの方がいいね。"}, {"type": "subtitle", "time": 18455.75, "timestamp": "05:07:35", "text": "うん。ちょっと1回ストップするわ。輸"}]
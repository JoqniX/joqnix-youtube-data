[{"type": "subtitle", "time": 17640.11, "timestamp": "04:54:00", "text": "輸送班の皆様。"}, {"type": "subtitle", "time": 17642.03, "timestamp": "04:54:02", "text": "えっと用資材が"}, {"type": "subtitle", "time": 17642.628, "timestamp": "04:54:02", "text": "足りないかも。"}, {"type": "subtitle", "time": 17644.23, "timestamp": "04:54:04", "text": "あ、オッケー。"}, {"type": "subtitle", "time": 17649.59, "timestamp": "04:54:09", "text": "あと資材と燃料かな。"}, {"type": "subtitle", "time": 17651.91, "timestamp": "04:54:11", "text": "そうだね。ガンガン"}, {"type": "subtitle", "time": 17653.708, "timestamp": "04:54:13", "text": "燃料は持ってきたわ。"}, {"type": "subtitle", "time": 17655.75, "timestamp": "04:54:15", "text": "あ、ありがとう。サンキュー。"}, {"type": "subtitle", "time": 17656.75, "timestamp": "04:54:16", "text": "うん。"}, {"type": "subtitle", "time": 17657.868, "timestamp": "04:54:17", "text": "あ、スーパーピ"}, {"type": "subtitle", "time": 17660.23, "timestamp": "04:54:20", "text": "ナイス。"}, {"type": "subtitle", "time": 17660.83, "timestamp": "04:54:20", "text": "あ、ちょ、"}, {"type": "subtitle", "time": 17665.03, "timestamp": "04:54:25", "text": "俺もこれ2"}, {"type": "subtitle", "time": 17668.51, "timestamp": "04:54:28", "text": "はい、"}, {"type": "subtitle", "time": 17669.07, "timestamp": "04:54:29", "text": "戻ります。"}, {"type": "subtitle", "time": 17670.39, "timestamp": "04:54:30", "text": "ドリルがもう1個できた。"}, {"type": "subtitle", "time": 17671.47, "timestamp": "04:54:31", "text": "ドリルできた。うん。"}, {"type": "subtitle", "time": 17673.75, "timestamp": "04:54:33", "text": "オ、オ、オッケー。"}, {"type": "subtitle", "time": 17674.83, "timestamp": "04:54:34", "text": "降ってきてる。"}, {"type": "subtitle", "time": 17677.47, "timestamp": "04:54:37", "text": "やべえ。"}, {"type": "subtitle", "time": 17679.39, "timestamp": "04:54:39", "text": "どこだろうね。"}, {"type": "subtitle", "time": 17681.75, "timestamp": "04:54:41", "text": "でもまあ赤だね、やっぱ。"}, {"type": "subtitle", "time": 17693.23, "timestamp": "04:54:53", "text": "あ、"}]
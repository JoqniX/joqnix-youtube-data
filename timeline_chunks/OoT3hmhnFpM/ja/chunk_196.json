[{"type": "subtitle", "time": 11760.55, "timestamp": "03:16:00", "text": "激り抜こう。"}, {"type": "subtitle", "time": 11769.82, "timestamp": "03:16:09", "text": "目。ここいすぎだろ。"}, {"type": "subtitle", "time": 11770.95, "timestamp": "03:16:10", "text": "[笑い]"}, {"type": "subtitle", "time": 11771.67, "timestamp": "03:16:11", "text": "やばいよね。"}, {"type": "subtitle", "time": 11775.429, "timestamp": "03:16:15", "text": "さん23人殺したいの。俺も2人殺して。"}, {"type": "subtitle", "time": 11777.75, "timestamp": "03:16:17", "text": "めちゃめちゃ来てるわ。ここの森"}, {"type": "subtitle", "time": 11782.67, "timestamp": "03:16:22", "text": "あな、"}, {"type": "subtitle", "time": 11785.11, "timestamp": "03:16:25", "text": "この辺から行くか。"}, {"type": "subtitle", "time": 11785.83, "timestamp": "03:16:25", "text": "オ、ありがとう。"}, {"type": "subtitle", "time": 11787.63, "timestamp": "03:16:27", "text": "オ、"}, {"type": "subtitle", "time": 11789.189, "timestamp": "03:16:29", "text": "エネミーオンザベース。"}, {"type": "subtitle", "time": 11808.269, "timestamp": "03:16:48", "text": "いて。"}, {"type": "subtitle", "time": 11810.87, "timestamp": "03:16:50", "text": "え、さすがない。"}, {"type": "subtitle", "time": 11813.189, "timestamp": "03:16:53", "text": "殺していくぞ。"}, {"type": "subtitle", "time": 11818.79, "timestamp": "03:16:58", "text": "あら、イラした。もう、もう"}]
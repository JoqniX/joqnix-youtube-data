[{"type": "subtitle", "time": 24720.67, "timestamp": "06:52:00", "text": "あんまよね。多分"}, {"type": "subtitle", "time": 24724.868, "timestamp": "06:52:04", "text": "タワー中復か"}, {"type": "subtitle", "time": 24727.43, "timestamp": "06:52:07", "text": "行けない感じやね。"}, {"type": "subtitle", "time": 24728.03, "timestamp": "06:52:08", "text": "そ、"}, {"type": "subtitle", "time": 24733.99, "timestamp": "06:52:13", "text": "そう。意味ないから。"}, {"type": "subtitle", "time": 24740.91, "timestamp": "06:52:20", "text": "2人で行ってけ"}, {"type": "subtitle", "time": 24742.708, "timestamp": "06:52:22", "text": "ありがとう。"}, {"type": "subtitle", "time": 24743.788, "timestamp": "06:52:23", "text": "行くよ。行く行く行く行くよ。"}, {"type": "subtitle", "time": 24753.99, "timestamp": "06:52:33", "text": "行ってる。オッケー。"}, {"type": "subtitle", "time": 24755.43, "timestamp": "06:52:35", "text": "修復どれだ?"}, {"type": "subtitle", "time": 24756.35, "timestamp": "06:52:36", "text": "やばすぎ。"}, {"type": "subtitle", "time": 24758.11, "timestamp": "06:52:38", "text": "さっき復帰のいた。"}, {"type": "subtitle", "time": 24759.75, "timestamp": "06:52:39", "text": "僕のところいる。"}, {"type": "subtitle", "time": 24760.27, "timestamp": "06:52:40", "text": "僕のところ"}, {"type": "subtitle", "time": 24761.27, "timestamp": "06:52:41", "text": "リロードしてる。"}, {"type": "subtitle", "time": 24767.51, "timestamp": "06:52:47", "text": "僕あ、ネタ入ってないかな?入ってないわ。"}, {"type": "subtitle", "time": 24768.99, "timestamp": "06:52:48", "text": "多分入ってないと思う。"}, {"type": "subtitle", "time": 24769.75, "timestamp": "06:52:49", "text": "ごめん、ごめん。"}, {"type": "subtitle", "time": 24772.19, "timestamp": "06:52:52", "text": "無理だったら大丈夫。"}, {"type": "subtitle", "time": 24773.388, "timestamp": "06:52:53", "text": "やだ。"}, {"type": "subtitle", "time": 24775.35, "timestamp": "06:52:55", "text": "生き残り戦で"}, {"type": "subtitle", "time": 24778.27, "timestamp": "06:52:58", "text": "行ける。敵のバックから拾ったわ。"}, {"type": "subtitle", "time": 24779.868, "timestamp": "06:52:59", "text": "ジャイズリク"}]
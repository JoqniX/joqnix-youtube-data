[{"type": "subtitle", "time": 22725.868, "timestamp": "06:18:45", "text": "うーん。"}, {"type": "subtitle", "time": 22728.11, "timestamp": "06:18:48", "text": "え、俺はちょっと遅れます。ごめん。こさん。"}, {"type": "subtitle", "time": 22728.67, "timestamp": "06:18:48", "text": "オ、いいよ。"}, {"type": "subtitle", "time": 22730.51, "timestamp": "06:18:50", "text": "俺は、俺はマーク瓶に乗るわ。"}]
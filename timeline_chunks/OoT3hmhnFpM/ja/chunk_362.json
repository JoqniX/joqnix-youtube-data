[{"type": "subtitle", "time": 21727.15, "timestamp": "06:02:07", "text": "every"}, {"type": "subtitle", "time": 21743.67, "timestamp": "06:02:23", "text": "入りたい"}, {"type": "subtitle", "time": 21746.628, "timestamp": "06:02:26", "text": "。え、ちょ、もうちょっと人が人が多い"}, {"type": "subtitle", "time": 21748.83, "timestamp": "06:02:28", "text": "サーバーは"}, {"type": "subtitle", "time": 21750.83, "timestamp": "06:02:30", "text": "結構加速度的に人が増えるからむずいんだ"}, {"type": "subtitle", "time": 21753.83, "timestamp": "06:02:33", "text": "よな。"}, {"type": "subtitle", "time": 21754.39, "timestamp": "06:02:34", "text": "230"}, {"type": "subtitle", "time": 21757.31, "timestamp": "06:02:37", "text": "人のところだと俺たちが入ったらもうプラス"}, {"type": "subtitle", "time": 21760.23, "timestamp": "06:02:40", "text": "12人ですぐ始まるんだよな。"}, {"type": "subtitle", "time": 21761.83, "timestamp": "06:02:41", "text": "うん。"}, {"type": "subtitle", "time": 21763.788, "timestamp": "06:02:43", "text": "大変だね、これ。"}, {"type": "subtitle", "time": 21770.43, "timestamp": "06:02:50", "text": "うん。しよう。"}, {"type": "subtitle", "time": 21770.708, "timestamp": "06:02:50", "text": "20"}, {"type": "subtitle", "time": 21772.19, "timestamp": "06:02:52", "text": "人とかにじゃ。"}, {"type": "subtitle", "time": 21772.51, "timestamp": "06:02:52", "text": "うん。"}, {"type": "subtitle", "time": 21773.51, "timestamp": "06:02:53", "text": "はい。"}, {"type": "subtitle", "time": 21775.39, "timestamp": "06:02:55", "text": "ごめんね。などみんな戻るよ。"}, {"type": "subtitle", "time": 21777.67, "timestamp": "06:02:57", "text": "しゃないで。えっと、ハペス君があれだ。ちょっと"}, {"type": "subtitle", "time": 21778.708, "timestamp": "06:02:58", "text": "戻るよ。"}]
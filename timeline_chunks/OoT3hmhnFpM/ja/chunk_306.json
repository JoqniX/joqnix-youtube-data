[{"type": "subtitle", "time": 18361.19, "timestamp": "05:06:01", "text": "いやいや、あの掃除した方がいいかも。"}, {"type": "subtitle", "time": 18379.07, "timestamp": "05:06:19", "text": "えー、そうね。"}, {"type": "subtitle", "time": 18383.948, "timestamp": "05:06:23", "text": "なるほどね。"}, {"type": "subtitle", "time": 18404.31, "timestamp": "05:06:44", "text": "今行くのはしんどいか。"}, {"type": "subtitle", "time": 18407.19, "timestamp": "05:06:47", "text": "どうだろう。俺一応ドアマンはやれるから。"}, {"type": "subtitle", "time": 18410.75, "timestamp": "05:06:50", "text": "あ、そう。マジすぐ開けるよ。"}, {"type": "subtitle", "time": 18415.39, "timestamp": "05:06:55", "text": "リスポンするね。"}]
[{"type": "subtitle", "time": 9964.51, "timestamp": "02:46:04", "text": "そ、あ、そいつかな?俺殺したの?"}, {"type": "subtitle", "time": 9965.71, "timestamp": "02:46:05", "text": "オ、"}, {"type": "subtitle", "time": 9999.269, "timestamp": "02:46:39", "text": "うん。俺のとこは大丈夫だ。"}, {"type": "subtitle", "time": 10000.71, "timestamp": "02:46:40", "text": "大丈夫だけど。なんか"}, {"type": "subtitle", "time": 10003.389, "timestamp": "02:46:43", "text": "蘇生に来るのすごい大変。もしかしてこれ。"}, {"type": "subtitle", "time": 10004.63, "timestamp": "02:46:44", "text": "うん。"}, {"type": "subtitle", "time": 10006.59, "timestamp": "02:46:46", "text": "行こうか僕。あ、"}, {"type": "subtitle", "time": 10014.389, "timestamp": "02:46:54", "text": "そうね。あ、いた。"}, {"type": "subtitle", "time": 10015.67, "timestamp": "02:46:55", "text": "ああ、行ける。うん。行ってくれ。"}, {"type": "subtitle", "time": 10017.71, "timestamp": "02:46:57", "text": "こ内側から入れるかな?ブラ。"}, {"type": "subtitle", "time": 10019.51, "timestamp": "02:46:59", "text": "今起こしんじゃね?誰か。"}]
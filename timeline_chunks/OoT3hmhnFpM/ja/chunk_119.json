[{"type": "subtitle", "time": 7142.589, "timestamp": "01:59:02", "text": "もう違う。もうアクさんが入るだけで全然違う。"}, {"type": "subtitle", "time": 7143.31, "timestamp": "01:59:03", "text": "やばすぎ。"}, {"type": "subtitle", "time": 7144.87, "timestamp": "01:59:04", "text": "やっぱ引き締まる。"}, {"type": "subtitle", "time": 7146.069, "timestamp": "01:59:06", "text": "違だよな。"}, {"type": "subtitle", "time": 7192.95, "timestamp": "01:59:52", "text": "ああ、俺たちの迫撃人地がさちになっちまった。"}, {"type": "subtitle", "time": 7194.35, "timestamp": "01:59:54", "text": "なんかいるな。"}]
[{"type": "subtitle", "time": 8160.229, "timestamp": "02:16:00", "text": "あ、本当だね。ああ、本当だね。"}, {"type": "subtitle", "time": 8161.589, "timestamp": "02:16:01", "text": "大変ですね。"}, {"type": "subtitle", "time": 8168.35, "timestamp": "02:16:08", "text": "うん。1番に結構いるんじゃないかな。"}, {"type": "subtitle", "time": 8174.43, "timestamp": "02:16:14", "text": "一応燃料は運んでるけど。"}, {"type": "subtitle", "time": 8186.069, "timestamp": "02:16:26", "text": "はい。"}, {"type": "subtitle", "time": 8196.629, "timestamp": "02:16:36", "text": "えっと、南側に"}, {"type": "subtitle", "time": 8197.19, "timestamp": "02:16:37", "text": "落としてるわ。"}]
[{"type": "subtitle", "time": 18600.75, "timestamp": "05:10:00", "text": "こエの弾とかちょっと持ってない?"}, {"type": "subtitle", "time": 18602.75, "timestamp": "05:10:02", "text": "あ、持ってる、持ってる、持る。ちょっと待って、"}, {"type": "subtitle", "time": 18605.47, "timestamp": "05:10:05", "text": "ちょっと待って。オ、そこやばいわ。こ、こっち側の方がいいわ。"}, {"type": "subtitle", "time": 18606.35, "timestamp": "05:10:06", "text": "うん。オしたわ。"}, {"type": "subtitle", "time": 18608.47, "timestamp": "05:10:08", "text": "マガジン、マガジンあげるわ。そしたら"}, {"type": "subtitle", "time": 18610.91, "timestamp": "05:10:10", "text": "オッケー。助かるわ。"}, {"type": "subtitle", "time": 18615.59, "timestamp": "05:10:15", "text": "大丈夫?"}, {"type": "subtitle", "time": 18618.35, "timestamp": "05:10:18", "text": "え?いや、もうそれはもう、もう、え、こんなくれんの?ありがとう。"}, {"type": "subtitle", "time": 18619.868, "timestamp": "05:10:19", "text": "あ、あげる。いいよ、いいよ。3"}, {"type": "subtitle", "time": 18622.07, "timestamp": "05:10:22", "text": "つ持ってるから。"}, {"type": "subtitle", "time": 18623.11, "timestamp": "05:10:23", "text": "あれ?えっと、"}, {"type": "subtitle", "time": 18625.03, "timestamp": "05:10:25", "text": "から、それ何?"}, {"type": "subtitle", "time": 18627.27, "timestamp": "05:10:27", "text": "これがいらんのか?うん。"}, {"type": "subtitle", "time": 18628.07, "timestamp": "05:10:28", "text": "はい。す、"}, {"type": "subtitle", "time": 18629.75, "timestamp": "05:10:29", "text": "これ殺し行くの?"}, {"type": "subtitle", "time": 18630.948, "timestamp": "05:10:30", "text": "俺殺し行くわ。"}, {"type": "subtitle", "time": 18631.948, "timestamp": "05:10:31", "text": "じゃ、一緒行こう。"}, {"type": "subtitle", "time": 18633.67, "timestamp": "05:10:33", "text": "オあさんちょっとさ、ちょっとだけあと"}, {"type": "subtitle", "time": 18635.67, "timestamp": "05:10:35", "text": "30発ぐらいだけもらえない?"}, {"type": "subtitle", "time": 18639.43, "timestamp": "05:10:39", "text": "30発はど、えっと、1個ドロップ分割。"}, {"type": "subtitle", "time": 18641.548, "timestamp": "05:10:41", "text": "マガジンじゃなくて弾で"}, {"type": "subtitle", "time": 18646.51, "timestamp": "05:10:46", "text": "はい。"}, {"type": "subtitle", "time": 18646.948, "timestamp": "05:10:46", "text": "ありがとう。"}, {"type": "subtitle", "time": 18648.19, "timestamp": "05:10:48", "text": "ちょっとハ、ハンマー置いてくるわ。"}, {"type": "subtitle", "time": 18654.11, "timestamp": "05:10:54", "text": "なんかやばいな。"}, {"type": "subtitle", "time": 18654.47, "timestamp": "05:10:54", "text": "やべえな。"}, {"type": "subtitle", "time": 18656.03, "timestamp": "05:10:56", "text": "色々やばいな。"}]
[{"type": "subtitle", "time": 29404.308, "timestamp": "08:10:04", "text": "他にヘリないのに一番遠いとこに。"}, {"type": "subtitle", "time": 29410.51, "timestamp": "08:10:10", "text": "シャコいるやん。"}, {"type": "subtitle", "time": 29412.27, "timestamp": "08:10:12", "text": "上"}, {"type": "subtitle", "time": 29414.788, "timestamp": "08:10:14", "text": "え、じゃ下からこれ入った方が安全だったりする。"}, {"type": "subtitle", "time": 29419.548, "timestamp": "08:10:19", "text": "ストップ。"}, {"type": "subtitle", "time": 29442.628, "timestamp": "08:10:42", "text": "こんなこ入て。"}]
[{"type": "subtitle", "time": 33844.95, "timestamp": "09:24:04", "text": "なんか死んだな。"}, {"type": "subtitle", "time": 33846.95, "timestamp": "09:24:06", "text": "不思議。"}, {"type": "subtitle", "time": 33852.11, "timestamp": "09:24:12", "text": "FPの範囲内に入ってるわ。"}, {"type": "subtitle", "time": 33852.55, "timestamp": "09:24:12", "text": "オ"}, {"type": "subtitle", "time": 33856.23, "timestamp": "09:24:16", "text": "1"}, {"type": "subtitle", "time": 33857.71, "timestamp": "09:24:17", "text": "人しか見えんかったかな。1"}, {"type": "subtitle", "time": 33871.03, "timestamp": "09:24:31", "text": "しっかりや。"}, {"type": "subtitle", "time": 33872.79, "timestamp": "09:24:32", "text": "さっきの司法野郎じゃねえか。"}, {"type": "subtitle", "time": 33873.31, "timestamp": "09:24:33", "text": "ありがとう。"}, {"type": "subtitle", "time": 33874.07, "timestamp": "09:24:34", "text": "ナイス。"}, {"type": "subtitle", "time": 33876.35, "timestamp": "09:24:36", "text": "あ、死んだね。"}, {"type": "subtitle", "time": 33877.586, "timestamp": "09:24:37", "text": "いらった。"}, {"type": "subtitle", "time": 33879.07, "timestamp": "09:24:39", "text": "うん。"}, {"type": "subtitle", "time": 33880.55, "timestamp": "09:24:40", "text": "ナイス。"}, {"type": "subtitle", "time": 33881.746, "timestamp": "09:24:41", "text": "さっきのあれだ。"}, {"type": "subtitle", "time": 33882.426, "timestamp": "09:24:42", "text": "あ、"}, {"type": "subtitle", "time": 33890.79, "timestamp": "09:24:50", "text": "めっちゃ凸してくる感じやね。"}, {"type": "subtitle", "time": 33893.51, "timestamp": "09:24:53", "text": "あ、ちさんが敵側にいるってこと?"}, {"type": "subtitle", "time": 33894.426, "timestamp": "09:24:54", "text": "うん。"}, {"type": "subtitle", "time": 33897.03, "timestamp": "09:24:57", "text": "あ、なるほどね。てこっよ。"}, {"type": "subtitle", "time": 33898.594, "timestamp": "09:24:58", "text": "あ、中さだったんだ。"}, {"type": "subtitle", "time": 33899.31, "timestamp": "09:24:59", "text": "[笑い]"}]
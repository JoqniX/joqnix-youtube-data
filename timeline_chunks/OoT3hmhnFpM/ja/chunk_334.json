[{"type": "subtitle", "time": 20050.83, "timestamp": "05:34:10", "text": "うわ、うま。"}, {"type": "subtitle", "time": 20059.548, "timestamp": "05:34:19", "text": "うん。"}, {"type": "subtitle", "time": 20061.868, "timestamp": "05:34:21", "text": "行く。行きたいな。許さねえ。"}, {"type": "subtitle", "time": 20064.19, "timestamp": "05:34:24", "text": "おこさん死んだ。今、"}, {"type": "subtitle", "time": 20066.47, "timestamp": "05:34:26", "text": "今死んだけど起こし持ってんな。死ぬ。"}, {"type": "subtitle", "time": 20072.91, "timestamp": "05:34:32", "text": "行きましょう。"}, {"type": "subtitle", "time": 20084.23, "timestamp": "05:34:44", "text": "許さない俺は。"}, {"type": "subtitle", "time": 20096.03, "timestamp": "05:34:56", "text": "殺してやる。"}]
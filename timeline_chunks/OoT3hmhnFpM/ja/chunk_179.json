[{"type": "subtitle", "time": 10741.469, "timestamp": "02:59:01", "text": "行け。"}, {"type": "subtitle", "time": 10747.269, "timestamp": "02:59:07", "text": "いける。"}, {"type": "subtitle", "time": 10749.99, "timestamp": "02:59:09", "text": "ガ、[笑い]"}, {"type": "subtitle", "time": 10755.429, "timestamp": "02:59:15", "text": "何が起きた?"}, {"type": "subtitle", "time": 10763.59, "timestamp": "02:59:23", "text": "爆散しました。あれ"}, {"type": "subtitle", "time": 10772.79, "timestamp": "02:59:32", "text": "皆さん"}, {"type": "subtitle", "time": 10773.59, "timestamp": "02:59:33", "text": "オよ。"}, {"type": "subtitle", "time": 10774.309, "timestamp": "02:59:34", "text": "皆さんのお金を。"}, {"type": "subtitle", "time": 10782.03, "timestamp": "02:59:42", "text": "角に1人は増えた。"}, {"type": "subtitle", "time": 10784.269, "timestamp": "02:59:44", "text": "ああ、もうそう"}, {"type": "subtitle", "time": 10785.999, "timestamp": "02:59:45", "text": "か。じゃ、した。"}, {"type": "subtitle", "time": 10786.389, "timestamp": "02:59:46", "text": "[笑い]"}, {"type": "subtitle", "time": 10789.19, "timestamp": "02:59:49", "text": "え、あのね、俺はまだ行けますけども。"}, {"type": "subtitle", "time": 10790.79, "timestamp": "02:59:50", "text": "俺はもう1回行く気でいるよ。"}, {"type": "subtitle", "time": 10792.03, "timestamp": "02:59:52", "text": "もう今"}, {"type": "subtitle", "time": 10794.51, "timestamp": "02:59:54", "text": "行けるよ。[笑い]"}]
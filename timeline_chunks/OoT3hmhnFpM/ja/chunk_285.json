[{"type": "subtitle", "time": 17119.55, "timestamp": "04:45:19", "text": "ここら辺かな?"}, {"type": "subtitle", "time": 17132.59, "timestamp": "04:45:32", "text": "うん。"}, {"type": "subtitle", "time": 17143.03, "timestamp": "04:45:43", "text": "え、てかこれ壁途中じゃん。"}, {"type": "subtitle", "time": 17143.51, "timestamp": "04:45:43", "text": "これか。"}, {"type": "subtitle", "time": 17144.67, "timestamp": "04:45:44", "text": "はい。すいません。"}, {"type": "subtitle", "time": 17150.23, "timestamp": "04:45:50", "text": "多分来れてないと思ってこっち優先した。"}, {"type": "subtitle", "time": 17151.868, "timestamp": "04:45:51", "text": "ああ、ごめんね。あ、そうだったんだ。ごめん、ごめん。"}, {"type": "subtitle", "time": 17153.982, "timestamp": "04:45:53", "text": "ありがとう。オケオッケー。やったやった。電然してる。"}, {"type": "subtitle", "time": 17158.628, "timestamp": "04:45:58", "text": "ま、迫撃は俺が壊しとくんで。"}]
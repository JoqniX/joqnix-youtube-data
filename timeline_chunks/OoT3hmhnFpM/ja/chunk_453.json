[{"type": "subtitle", "time": 27180.43, "timestamp": "07:33:00", "text": "People"}, {"type": "subtitle", "time": 27181.23, "timestamp": "07:33:01", "text": "ついていくわ。"}, {"type": "subtitle", "time": 27181.868, "timestamp": "07:33:01", "text": "ああ"}, {"type": "subtitle", "time": 27183.868, "timestamp": "07:33:03", "text": "あ、ハリガンツールあったわ。開けるわ。"}, {"type": "subtitle", "time": 27185.388, "timestamp": "07:33:05", "text": "オオ"}, {"type": "subtitle", "time": 27190.07, "timestamp": "07:33:10", "text": "4で。"}, {"type": "subtitle", "time": 27191.868, "timestamp": "07:33:11", "text": "え、ごめ。"}, {"type": "subtitle", "time": 27195.07, "timestamp": "07:33:15", "text": "クレイジーだよ。ああ、[叫び声]"}, {"type": "subtitle", "time": 27203.868, "timestamp": "07:33:23", "text": "ま、そうね。"}, {"type": "subtitle", "time": 27206.468, "timestamp": "07:33:26", "text": "下がったら下がったでケの車線もあったしね。"}, {"type": "subtitle", "time": 27208.51, "timestamp": "07:33:28", "text": "あ、than、キってくる。"}, {"type": "subtitle", "time": 27209.948, "timestamp": "07:33:29", "text": "赤が"}, {"type": "subtitle", "time": 27212.27, "timestamp": "07:33:32", "text": "取れると同時に攻めてきたんだな。"}, {"type": "subtitle", "time": 27213.308, "timestamp": "07:33:33", "text": "そうだね。ちょっと。"}, {"type": "subtitle", "time": 27215.75, "timestamp": "07:33:35", "text": "あ、じゃ、4番だな。"}, {"type": "subtitle", "time": 27217.708, "timestamp": "07:33:37", "text": "足の引っ張りやりちゃったね。"}, {"type": "subtitle", "time": 27218.15, "timestamp": "07:33:38", "text": "うん。うん。"}, {"type": "subtitle", "time": 27227.868, "timestamp": "07:33:47", "text": "だからあの"}, {"type": "subtitle", "time": 27234.15, "timestamp": "07:33:54", "text": "本当にそれ。"}, {"type": "subtitle", "time": 27237.51, "timestamp": "07:33:57", "text": "えっと迫撃砲1個あるな。手前か。"}]
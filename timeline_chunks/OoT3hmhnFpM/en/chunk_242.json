[{"type": "subtitle", "time": 14527.349, "timestamp": "04:02:07", "text": "And, one of the gates on the south side was destroyed."}, {"type": "subtitle", "time": 14528.55, "timestamp": "04:02:08", "text": "Seriously?"}, {"type": "subtitle", "time": 14530.83, "timestamp": "04:02:10", "text": "I have a hammer."}, {"type": "subtitle", "time": 14533.429, "timestamp": "04:02:13", "text": "Oh, I have one."}, {"type": "subtitle", "time": 14552.389, "timestamp": "04:02:32", "text": "Mr. Orak"}, {"type": "subtitle", "time": 14557.91, "timestamp": "04:02:37", "text": "They're here."}, {"type": "subtitle", "time": 14559.389, "timestamp": "04:02:39", "text": "Beyond the gate"}, {"type": "subtitle", "time": 14564.87, "timestamp": "04:02:44", "text": "Okay. please."}, {"type": "subtitle", "time": 14577.429, "timestamp": "04:02:57", "text": "They're coming, aren't they? Not yet."}]
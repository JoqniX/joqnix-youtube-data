[{"type": "subtitle", "time": 8586.71, "timestamp": "02:23:06", "text": "6."}, {"type": "subtitle", "time": 8586.83, "timestamp": "02:23:06", "text": "1"}, {"type": "subtitle", "time": 8588.83, "timestamp": "02:23:08", "text": "One squad, huh? How many people can it accommodate?"}, {"type": "subtitle", "time": 8594.79, "timestamp": "02:23:14", "text": "32."}, {"type": "subtitle", "time": 8597.619, "timestamp": "02:23:17", "text": "Wait, really? Wait, it's Battlefield!"}, {"type": "subtitle", "time": 8598.11, "timestamp": "02:23:18", "text": "[Laughs] 1"}, {"type": "subtitle", "time": 8600.87, "timestamp": "02:23:20", "text": "All 32 members will fit into the squad."}, {"type": "subtitle", "time": 8609.11, "timestamp": "02:23:29", "text": "If you're in the first army, then that's pretty much it."}, {"type": "subtitle", "time": 8609.67, "timestamp": "02:23:29", "text": "1 person"}, {"type": "subtitle", "time": 8611.71, "timestamp": "02:23:31", "text": "What kind of team? One squad."}, {"type": "subtitle", "time": 8612.15, "timestamp": "02:23:32", "text": "Oh really?"}, {"type": "subtitle", "time": 8617.349, "timestamp": "02:23:37", "text": "It's like 33 people."}, {"type": "subtitle", "time": 8619.07, "timestamp": "02:23:39", "text": "Isn't 32 a bit much? (for one person)"}, {"type": "subtitle", "time": 8620.75, "timestamp": "02:23:40", "text": "I heard he's 32. 1"}, {"type": "subtitle", "time": 8621.854, "timestamp": "02:23:41", "text": "Only people."}, {"type": "subtitle", "time": 8622.55, "timestamp": "02:23:42", "text": "[laughter]"}, {"type": "subtitle", "time": 8625.23, "timestamp": "02:23:45", "text": "hang on."}]
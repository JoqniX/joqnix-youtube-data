[{"type": "subtitle", "time": 7142.589, "timestamp": "01:59:02", "text": "It's different now. Just having Aku-san join makes a huge difference."}, {"type": "subtitle", "time": 7143.31, "timestamp": "01:59:03", "text": "That's insane."}, {"type": "subtitle", "time": 7144.87, "timestamp": "01:59:04", "text": "It definitely makes you feel more toned."}, {"type": "subtitle", "time": 7146.069, "timestamp": "01:59:06", "text": "That's wrong, isn't it?"}, {"type": "subtitle", "time": 7192.95, "timestamp": "01:59:52", "text": "Oh, our mortar base has been destroyed."}, {"type": "subtitle", "time": 7194.35, "timestamp": "01:59:54", "text": "There's something there."}]
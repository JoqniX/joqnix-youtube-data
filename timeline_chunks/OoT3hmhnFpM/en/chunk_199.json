[{"type": "subtitle", "time": 11947.87, "timestamp": "03:19:07", "text": "There are hardly any archers here."}, {"type": "subtitle", "time": 11950.309, "timestamp": "03:19:10", "text": "That's right. I'm turning left."}, {"type": "subtitle", "time": 11968.189, "timestamp": "03:19:28", "text": "Oh, hi."}, {"type": "subtitle", "time": 11970.55, "timestamp": "03:19:30", "text": "I'll be right next to you."}, {"type": "subtitle", "time": 11972.95, "timestamp": "03:19:32", "text": "Okay."}, {"type": "subtitle", "time": 11973.99, "timestamp": "03:19:33", "text": "Ah, that's good. Kill Mido."}, {"type": "subtitle", "time": 11975.429, "timestamp": "03:19:35", "text": "nice."}, {"type": "subtitle", "time": 11983.87, "timestamp": "03:19:43", "text": "Oh, you'll go?"}, {"type": "subtitle", "time": 11986.63, "timestamp": "03:19:46", "text": "I think that's probably the guy who got killed."}, {"type": "subtitle", "time": 11986.87, "timestamp": "03:19:46", "text": "O Park"}, {"type": "subtitle", "time": 11989.71, "timestamp": "03:19:49", "text": "I don't think it's visible from the north. I'm a Resa"}, {"type": "subtitle", "time": 11990.95, "timestamp": "03:19:50", "text": "There are three in the pack."}, {"type": "subtitle", "time": 11993.269, "timestamp": "03:19:53", "text": "Oh, I'll just use the one I have."}, {"type": "subtitle", "time": 11994.63, "timestamp": "03:19:54", "text": "O Park"}, {"type": "subtitle", "time": 11995.99, "timestamp": "03:19:55", "text": "It's now, right everyone?"}, {"type": "subtitle", "time": 11998.269, "timestamp": "03:19:58", "text": "We're being shot at from the north right now. Ally."}]
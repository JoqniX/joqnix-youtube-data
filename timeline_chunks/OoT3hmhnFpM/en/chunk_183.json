[{"type": "subtitle", "time": 10985.71, "timestamp": "03:03:05", "text": "Yeah. They're pulling the drill. Allies."}, {"type": "subtitle", "time": 10992.63, "timestamp": "03:03:12", "text": "No, well, I'm at the bottom of the tower."}, {"type": "subtitle", "time": 10994.59, "timestamp": "03:03:14", "text": "Oh, hacking."}, {"type": "subtitle", "time": 11004.83, "timestamp": "03:03:24", "text": "[laughter]"}, {"type": "subtitle", "time": 11007.59, "timestamp": "03:03:27", "text": "I wish I could have seen it."}, {"type": "subtitle", "time": 11010.15, "timestamp": "03:03:30", "text": "No, but getting the rooftop space is a big deal."}, {"type": "subtitle", "time": 11014.229, "timestamp": "03:03:34", "text": "[laughter]"}, {"type": "subtitle", "time": 11019.11, "timestamp": "03:03:39", "text": "Thank you."}, {"type": "subtitle", "time": 11025.269, "timestamp": "03:03:45", "text": "Yes, they are."}, {"type": "subtitle", "time": 11026.63, "timestamp": "03:03:46", "text": "Oh, maybe I'll go by helicopter too."}, {"type": "subtitle", "time": 11027.95, "timestamp": "03:03:47", "text": "Oni."}, {"type": "subtitle", "time": 11029.83, "timestamp": "03:03:49", "text": "Oh, should I have McDonald's?"}, {"type": "subtitle", "time": 11030.75, "timestamp": "03:03:50", "text": "Shall we go again?"}]
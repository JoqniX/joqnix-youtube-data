[{"type": "subtitle", "time": 19023.19, "timestamp": "05:17:03", "text": "I killed them."}, {"type": "subtitle", "time": 19032.51, "timestamp": "05:17:12", "text": "1"}, {"type": "subtitle", "time": 19035.35, "timestamp": "05:17:15", "text": "I woke someone up. That's great."}, {"type": "subtitle", "time": 19042.99, "timestamp": "05:17:22", "text": "Did they do it?"}, {"type": "subtitle", "time": 19045.11, "timestamp": "05:17:25", "text": "That's me. The door was unlocked."}, {"type": "subtitle", "time": 19047.61, "timestamp": "05:17:27", "text": "A huge amount came in."}, {"type": "subtitle", "time": 19067.03, "timestamp": "05:17:47", "text": "Hold on a second, I'll recover 1 HP."}, {"type": "subtitle", "time": 19078.948, "timestamp": "05:17:58", "text": "Pa-san is recovering. It cuts a little."}, {"type": "subtitle", "time": 19079.75, "timestamp": "05:17:59", "text": "Squat down."}]
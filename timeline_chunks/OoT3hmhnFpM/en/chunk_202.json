[{"type": "subtitle", "time": 12121.15, "timestamp": "03:22:01", "text": "Ah, that one."}, {"type": "subtitle", "time": 12123.55, "timestamp": "03:22:03", "text": "Looks like we have no choice but to spin around a bit more. Hey, us."}, {"type": "subtitle", "time": 12129.15, "timestamp": "03:22:09", "text": "cormorant,"}, {"type": "subtitle", "time": 12145.79, "timestamp": "03:22:25", "text": "Oh, someone put something there."}, {"type": "subtitle", "time": 12148.07, "timestamp": "03:22:28", "text": "I forgot to bring it."}, {"type": "subtitle", "time": 12149.99, "timestamp": "03:22:29", "text": "Oh, I'm glad you have the hammer."}, {"type": "subtitle", "time": 12167.63, "timestamp": "03:22:47", "text": "200m"}, {"type": "subtitle", "time": 12176.99, "timestamp": "03:22:56", "text": "Time-wise, too. I'll just hit it a little with a hammer."}]
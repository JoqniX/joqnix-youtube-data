[{"type": "subtitle", "time": 12205.469, "timestamp": "03:23:25", "text": "Shall we try to get this back and do our best?"}, {"type": "subtitle", "time": 12209.95, "timestamp": "03:23:29", "text": "Oh, I've already gone."}, {"type": "subtitle", "time": 12210.15, "timestamp": "03:23:30", "text": "Yeah."}, {"type": "subtitle", "time": 12222.189, "timestamp": "03:23:42", "text": "Oh, if you're going to give me a hammer, I'll take it."}, {"type": "subtitle", "time": 12229.229, "timestamp": "03:23:49", "text": "Ooooo."}, {"type": "subtitle", "time": 12234.99, "timestamp": "03:23:54", "text": "I'm paying via the west side."}, {"type": "subtitle", "time": 12235.389, "timestamp": "03:23:55", "text": "Wow, this is bad."}, {"type": "subtitle", "time": 12237.11, "timestamp": "03:23:57", "text": "Oh, I left it next to Imo-san."}, {"type": "subtitle", "time": 12238.229, "timestamp": "03:23:58", "text": "Okay."}]
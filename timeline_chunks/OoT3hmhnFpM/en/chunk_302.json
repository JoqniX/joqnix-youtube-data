[{"type": "subtitle", "time": 18150.27, "timestamp": "05:02:30", "text": "t"}, {"type": "subtitle", "time": 18165.83, "timestamp": "05:02:45", "text": "And then, I came to Mame."}, {"type": "subtitle", "time": 18170.47, "timestamp": "05:02:50", "text": "Is there a body?"}, {"type": "subtitle", "time": 18171.868, "timestamp": "05:02:51", "text": "I don't know."}]
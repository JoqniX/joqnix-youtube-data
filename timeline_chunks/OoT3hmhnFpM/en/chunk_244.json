[{"type": "subtitle", "time": 14640.71, "timestamp": "04:04:00", "text": "Ah, I see."}, {"type": "subtitle", "time": 14641.79, "timestamp": "04:04:01", "text": "Oh, thanks."}, {"type": "subtitle", "time": 14644.11, "timestamp": "04:04:04", "text": "Why number one?"}, {"type": "subtitle", "time": 14646.11, "timestamp": "04:04:06", "text": "Ah, I see."}, {"type": "subtitle", "time": 14662.189, "timestamp": "04:04:22", "text": "Ah, I think it's better to just give up."}, {"type": "subtitle", "time": 14663.95, "timestamp": "04:04:23", "text": "Oh, money,"}, {"type": "subtitle", "time": 14671.99, "timestamp": "04:04:31", "text": "Oh, you're right. They've become incredibly rich."}, {"type": "subtitle", "time": 14674.149, "timestamp": "04:04:34", "text": "It's over 1 million."}, {"type": "subtitle", "time": 14675.63, "timestamp": "04:04:35", "text": "I'm changing 1 million right now."}, {"type": "subtitle", "time": 14675.83, "timestamp": "04:04:35", "text": "vinegar,"}, {"type": "subtitle", "time": 14677.389, "timestamp": "04:04:37", "text": "Uh, well, not that much"}, {"type": "subtitle", "time": 14680.309, "timestamp": "04:04:40", "text": "I made 100,000 yen."}, {"type": "subtitle", "time": 14687.269, "timestamp": "04:04:47", "text": "Let's pray."}, {"type": "subtitle", "time": 14687.79, "timestamp": "04:04:47", "text": "Are you okay?"}, {"type": "subtitle", "time": 14689.469, "timestamp": "04:04:49", "text": "Loveham."}, {"type": "subtitle", "time": 14698.79, "timestamp": "04:04:58", "text": "Excuse me for intruding."}, {"type": "subtitle", "time": 14699.189, "timestamp": "04:04:59", "text": "Yes."}]
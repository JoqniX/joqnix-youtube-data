[{"type": "subtitle", "time": 8101.91, "timestamp": "02:15:01", "text": "That's right. It's here."}, {"type": "subtitle", "time": 8110.51, "timestamp": "02:15:10", "text": "I think I'll bring a fuel pallet."}, {"type": "subtitle", "time": 8113.39, "timestamp": "02:15:13", "text": "He died."}, {"type": "subtitle", "time": 8128.87, "timestamp": "02:15:28", "text": "thank you."}, {"type": "subtitle", "time": 8147.91, "timestamp": "02:15:47", "text": "That's mine, my place, you"}, {"type": "subtitle", "time": 8149.549, "timestamp": "02:15:49", "text": "O Park"}, {"type": "subtitle", "time": 8153.39, "timestamp": "02:15:53", "text": "sound"}]
[{"type": "subtitle", "time": 9001.67, "timestamp": "02:30:01", "text": "thank you. If there are people"}, {"type": "subtitle", "time": 9008.15, "timestamp": "02:30:08", "text": "It's true. We're already"}, {"type": "subtitle", "time": 9009.19, "timestamp": "02:30:09", "text": "a,"}, {"type": "subtitle", "time": 9011.55, "timestamp": "02:30:11", "text": "All I could think about was getting out of there as quickly as possible."}, {"type": "subtitle", "time": 9012.469, "timestamp": "02:30:12", "text": "terrible."}, {"type": "subtitle", "time": 9046.349, "timestamp": "02:30:46", "text": "I remember."}, {"type": "subtitle", "time": 9047.309, "timestamp": "02:30:47", "text": "I wrote it down."}]
[{"type": "subtitle", "time": 15840.71, "timestamp": "04:24:00", "text": "Is that okay?"}, {"type": "subtitle", "time": 15842.55, "timestamp": "04:24:02", "text": "126"}, {"type": "subtitle", "time": 15847.83, "timestamp": "04:24:07", "text": "Well,"}, {"type": "subtitle", "time": 15854.99, "timestamp": "04:24:14", "text": "yes. I'll only join Lone Star from now on."}, {"type": "subtitle", "time": 15858.63, "timestamp": "04:24:18", "text": "That's for the whole day today. You're doing great!"}, {"type": "subtitle", "time": 15859.03, "timestamp": "04:24:19", "text": "everyone."}, {"type": "subtitle", "time": 15865.71, "timestamp": "04:24:25", "text": "I see."}, {"type": "subtitle", "time": 15872.269, "timestamp": "04:24:32", "text": "We will form a squad."}, {"type": "subtitle", "time": 15873.469, "timestamp": "04:24:33", "text": "I'm making it."}, {"type": "subtitle", "time": 15881.03, "timestamp": "04:24:41", "text": "Since the people entered through me, are they just creating clones of themselves on their own?"}, {"type": "subtitle", "time": 15883.51, "timestamp": "04:24:43", "text": "Oh, so that's how it is."}, {"type": "subtitle", "time": 15885.67, "timestamp": "04:24:45", "text": "Yeah. I was just made squad leader without any explanation."}, {"type": "subtitle", "time": 15887.852, "timestamp": "04:24:47", "text": "nice. Captain."}, {"type": "subtitle", "time": 15888.95, "timestamp": "04:24:48", "text": "[laughter]"}, {"type": "subtitle", "time": 15890.429, "timestamp": "04:24:50", "text": "a,"}, {"type": "subtitle", "time": 15893.269, "timestamp": "04:24:53", "text": "The captain is motivated."}, {"type": "subtitle", "time": 15895.389, "timestamp": "04:24:55", "text": "Oh, so, did you get a good night's sleep yesterday? By the way."}, {"type": "subtitle", "time": 15896.83, "timestamp": "04:24:56", "text": "yes. I slept for 9 hours."}, {"type": "subtitle", "time": 15897.71, "timestamp": "04:24:57", "text": "Wow, that's amazing."}]
[{"type": "subtitle", "time": 18246.31, "timestamp": "05:04:06", "text": "Will I win? This one"}, {"type": "subtitle", "time": 18247.35, "timestamp": "05:04:07", "text": "Is that right? This song"}, {"type": "subtitle", "time": 18247.788, "timestamp": "05:04:07", "text": "You won't get it."}, {"type": "subtitle", "time": 18250.75, "timestamp": "05:04:10", "text": "Isn't there one?"}, {"type": "subtitle", "time": 18251.03, "timestamp": "05:04:11", "text": "I did it."}, {"type": "subtitle", "time": 18253.19, "timestamp": "05:04:13", "text": "Then, pull it."}, {"type": "subtitle", "time": 18255.23, "timestamp": "05:04:15", "text": "Yes, please."}, {"type": "subtitle", "time": 18261.11, "timestamp": "05:04:21", "text": "Let's ask them to do it."}, {"type": "subtitle", "time": 18263.59, "timestamp": "05:04:23", "text": "Around 3450?"}, {"type": "subtitle", "time": 18266.67, "timestamp": "05:04:26", "text": "So, the oil level will drop to zero."}, {"type": "subtitle", "time": 18268.27, "timestamp": "05:04:28", "text": "Oil request"}, {"type": "subtitle", "time": 18273.99, "timestamp": "05:04:33", "text": "I've already loaded up on one oil."}, {"type": "subtitle", "time": 18275.75, "timestamp": "05:04:35", "text": "Oh, there are three."}, {"type": "subtitle", "time": 18277.23, "timestamp": "05:04:37", "text": "It will be done."}, {"type": "subtitle", "time": 18279.67, "timestamp": "05:04:39", "text": "You'd need about four palettes."}, {"type": "subtitle", "time": 18285.708, "timestamp": "05:04:45", "text": "thank you."}, {"type": "subtitle", "time": 18295.948, "timestamp": "05:04:55", "text": "It would be a good idea to clean up the area around the base. O Park"}, {"type": "subtitle", "time": 18298.43, "timestamp": "05:04:58", "text": "Is anyone available for battle?"}]
[{"type": "subtitle", "time": 7223.31, "timestamp": "02:00:23", "text": "不，這又是…"}, {"type": "subtitle", "time": 7225.069, "timestamp": "02:00:25", "text": "第一名"}, {"type": "subtitle", "time": 7225.43, "timestamp": "02:00:25", "text": "是的"}, {"type": "subtitle", "time": 7229.189, "timestamp": "02:00:29", "text": "收到。"}, {"type": "subtitle", "time": 7230.03, "timestamp": "02:00:30", "text": "他媽的。"}, {"type": "subtitle", "time": 7236.03, "timestamp": "02:00:36", "text": "這是正確的。為什麼"}, {"type": "subtitle", "time": 7238.31, "timestamp": "02:00:38", "text": "我中槍了。哦"}, {"type": "subtitle", "time": 7247.47, "timestamp": "02:00:47", "text": "當心。"}, {"type": "subtitle", "time": 7248.55, "timestamp": "02:00:48", "text": "或者"}, {"type": "subtitle", "time": 7251.55, "timestamp": "02:00:51", "text": "哦，它關門了。哦"}]
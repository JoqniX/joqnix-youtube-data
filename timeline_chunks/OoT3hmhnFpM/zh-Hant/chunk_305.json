[{"type": "subtitle", "time": 18308.548, "timestamp": "05:05:08", "text": "他在襲擊中喪生。"}, {"type": "subtitle", "time": 18310.19, "timestamp": "05:05:10", "text": "他現在在嗎？"}, {"type": "subtitle", "time": 18310.31, "timestamp": "05:05:10", "text": "4"}, {"type": "subtitle", "time": 18323.39, "timestamp": "05:05:23", "text": "我們正遭受攻擊。所有這些"}, {"type": "subtitle", "time": 18325.548, "timestamp": "05:05:25", "text": "然後還有狙擊手。是的。"}, {"type": "subtitle", "time": 18326.19, "timestamp": "05:05:26", "text": "好的。"}, {"type": "subtitle", "time": 18326.948, "timestamp": "05:05:26", "text": "這"}, {"type": "subtitle", "time": 18329.83, "timestamp": "05:05:29", "text": "好吧，我來砌一堵牆。一次"}, {"type": "subtitle", "time": 18331.35, "timestamp": "05:05:31", "text": "讓我們改變現狀。"}, {"type": "subtitle", "time": 18332.67, "timestamp": "05:05:32", "text": "嘿。"}, {"type": "subtitle", "time": 18343.47, "timestamp": "05:05:43", "text": "是的。最好清理一下周圍環境。一定。這簡直太瘋狂了。"}, {"type": "subtitle", "time": 18356.83, "timestamp": "05:05:56", "text": "迫擊砲射擊非常危險。"}, {"type": "subtitle", "time": 18358.43, "timestamp": "05:05:58", "text": "他們擅長迫擊砲射擊。我"}]
[{"type": "subtitle", "time": 6746.589, "timestamp": "01:52:26", "text": "5點45分前。"}, {"type": "subtitle", "time": 6748.03, "timestamp": "01:52:28", "text": "就在這附近嗎？"}, {"type": "subtitle", "time": 6749.629, "timestamp": "01:52:29", "text": "布拉加梅哈。"}, {"type": "subtitle", "time": 6754.55, "timestamp": "01:52:34", "text": "啊，我要殺了你。"}, {"type": "subtitle", "time": 6756.229, "timestamp": "01:52:36", "text": "已經"}, {"type": "subtitle", "time": 6757.95, "timestamp": "01:52:37", "text": "去。"}, {"type": "subtitle", "time": 6759.669, "timestamp": "01:52:39", "text": "哦，沒了。塚"}, {"type": "subtitle", "time": 6762.109, "timestamp": "01:52:42", "text": "所以它就此停止了。好的。"}, {"type": "subtitle", "time": 6767.83, "timestamp": "01:52:47", "text": "哦，那裡有一座塔。"}, {"type": "subtitle", "time": 6768.629, "timestamp": "01:52:48", "text": "是的，"}, {"type": "subtitle", "time": 6771.109, "timestamp": "01:52:51", "text": "那裡有一座綠色的塔。科卡"}, {"type": "subtitle", "time": 6772.87, "timestamp": "01:52:52", "text": "不掛。迴轉。"}]
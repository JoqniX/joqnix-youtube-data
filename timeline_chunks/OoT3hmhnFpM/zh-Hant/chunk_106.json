[{"type": "subtitle", "time": 6376.109, "timestamp": "01:46:16", "text": "他們現在正從W側進攻。"}, {"type": "subtitle", "time": 6379.189, "timestamp": "01:46:19", "text": "我正在揍他。弱點。非常感謝"}, {"type": "subtitle", "time": 6384.43, "timestamp": "01:46:24", "text": "益。我得到了它。殺。你這個混蛋，你這個混蛋"}, {"type": "subtitle", "time": 6388.31, "timestamp": "01:46:28", "text": "我願意做。我認為Tower是一個強而有力的競爭者。"}, {"type": "subtitle", "time": 6390.669, "timestamp": "01:46:30", "text": "難道沒有嗎？該死的。這就是為什麼，一遍又一遍"}, {"type": "subtitle", "time": 6394.55, "timestamp": "01:46:34", "text": "這種事發生過很多次了。我要殺了他們。"}, {"type": "subtitle", "time": 6397.43, "timestamp": "01:46:37", "text": "是從你們樓頂掉下來的，對吧？該死的"}, {"type": "subtitle", "time": 6405.669, "timestamp": "01:46:45", "text": "憤怒的孩子"}, {"type": "subtitle", "time": 6406.95, "timestamp": "01:46:46", "text": "一會兒。"}, {"type": "subtitle", "time": 6414.83, "timestamp": "01:46:54", "text": "嗯，生氣的姐姐"}, {"type": "subtitle", "time": 6417.589, "timestamp": "01:46:57", "text": "好的。你在開玩笑吧？嚴重地。"}]
[{"type": "subtitle", "time": 10380.91, "timestamp": "02:53:00", "text": "哦，為什麼我放不下這本書？"}, {"type": "subtitle", "time": 10382.389, "timestamp": "02:53:02", "text": "嘿。"}, {"type": "subtitle", "time": 10383.95, "timestamp": "02:53:03", "text": "我們已經進入危險區域。這"}, {"type": "subtitle", "time": 10384.91, "timestamp": "02:53:04", "text": "哦"}, {"type": "subtitle", "time": 10387.51, "timestamp": "02:53:07", "text": "我剛剛撥打了熱點電話。"}, {"type": "subtitle", "time": 10389.87, "timestamp": "02:53:09", "text": "好的。好的。謝謝。 TY先生。"}, {"type": "subtitle", "time": 10394.99, "timestamp": "02:53:14", "text": "O Park"}, {"type": "subtitle", "time": 10397.309, "timestamp": "02:53:17", "text": "我的天啊。"}, {"type": "subtitle", "time": 10399.269, "timestamp": "02:53:19", "text": "我無法原諒這件事。那個人"}, {"type": "subtitle", "time": 10405.07, "timestamp": "02:53:25", "text": "哦真的嗎？"}, {"type": "subtitle", "time": 10405.95, "timestamp": "02:53:25", "text": "謝謝你，Cuber。"}, {"type": "subtitle", "time": 10407.349, "timestamp": "02:53:27", "text": "直升機裡有兩個人。直升機裡有兩個人。"}, {"type": "subtitle", "time": 10407.99, "timestamp": "02:53:27", "text": "直升機裡有兩個人。哦"}, {"type": "subtitle", "time": 10410.15, "timestamp": "02:53:30", "text": "所以你的意思是情況正在好轉？是的。"}, {"type": "subtitle", "time": 10412.07, "timestamp": "02:53:32", "text": "我們走吧。我上了屋頂。我們要下到屋頂。"}, {"type": "subtitle", "time": 10420.67, "timestamp": "02:53:40", "text": "我不會原諒你。"}, {"type": "subtitle", "time": 10421.95, "timestamp": "02:53:41", "text": "我也要去屋頂。"}, {"type": "subtitle", "time": 10423.11, "timestamp": "02:53:43", "text": "我們成功擊敗了Tee。"}, {"type": "subtitle", "time": 10424.15, "timestamp": "02:53:44", "text": "等等，你是在開玩笑吧？"}, {"type": "subtitle", "time": 10426.55, "timestamp": "02:53:46", "text": "好的。但也許真的下雨了？"}, {"type": "subtitle", "time": 10429.02, "timestamp": "02:53:49", "text": "我同意。狙擊手"}, {"type": "subtitle", "time": 10430.87, "timestamp": "02:53:50", "text": "[尖叫]"}, {"type": "subtitle", "time": 10433.15, "timestamp": "02:53:53", "text": "這是怎麼回事？"}, {"type": "subtitle", "time": 10437.19, "timestamp": "02:53:57", "text": "嘿。"}, {"type": "subtitle", "time": 10437.51, "timestamp": "02:53:57", "text": "一個，"}, {"type": "subtitle", "time": 10439.95, "timestamp": "02:53:59", "text": "你不應該等到他們醒來之後再做嗎？"}]
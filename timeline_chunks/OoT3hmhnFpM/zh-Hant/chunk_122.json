[{"type": "subtitle", "time": 7327.31, "timestamp": "02:02:07", "text": "塔，"}, {"type": "subtitle", "time": 7334.43, "timestamp": "02:02:14", "text": "他媽的。"}, {"type": "subtitle", "time": 7335.03, "timestamp": "02:02:15", "text": "哦，對不起。"}, {"type": "subtitle", "time": 7337.47, "timestamp": "02:02:17", "text": "是盟友殺了他嗎？"}, {"type": "subtitle", "time": 7346.55, "timestamp": "02:02:26", "text": "但這希望渺茫。"}, {"type": "subtitle", "time": 7363.069, "timestamp": "02:02:43", "text": "謝謝。隊列。"}, {"type": "subtitle", "time": 7374.91, "timestamp": "02:02:54", "text": "過錯，"}]
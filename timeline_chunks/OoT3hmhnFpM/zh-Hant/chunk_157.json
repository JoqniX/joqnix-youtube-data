[{"type": "subtitle", "time": 9421.349, "timestamp": "02:37:01", "text": "你還好嗎？我不介意。"}, {"type": "subtitle", "time": 9429.269, "timestamp": "02:37:09", "text": "刮痕。"}, {"type": "subtitle", "time": 9436.63, "timestamp": "02:37:16", "text": "真的"}, {"type": "subtitle", "time": 9437.87, "timestamp": "02:37:17", "text": "等一下，等一下。我開始感到難過。"}, {"type": "subtitle", "time": 9443.888, "timestamp": "02:37:23", "text": "我今天很難過。"}, {"type": "subtitle", "time": 9444.269, "timestamp": "02:37:24", "text": "[笑聲]"}, {"type": "subtitle", "time": 9446.83, "timestamp": "02:37:26", "text": "等我"}, {"type": "subtitle", "time": 9453.058, "timestamp": "02:37:33", "text": "驚人的。哦，沒關係，大丈部先生。沒關係，高山。"}, {"type": "subtitle", "time": 9458.95, "timestamp": "02:37:38", "text": "這是錯誤的。"}, {"type": "subtitle", "time": 9460.919, "timestamp": "02:37:40", "text": "你們根本沒在聽。"}, {"type": "subtitle", "time": 9462.87, "timestamp": "02:37:42", "text": "[笑聲]"}, {"type": "subtitle", "time": 9475.95, "timestamp": "02:37:55", "text": "哦，太陽真的升起來了。現在"}, {"type": "subtitle", "time": 9477.79, "timestamp": "02:37:57", "text": "這是某種車輛的名稱，對吧？"}, {"type": "subtitle", "time": 9479.51, "timestamp": "02:37:59", "text": "是的，它是一輛車。"}]
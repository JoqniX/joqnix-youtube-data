[{"type": "subtitle", "time": 17119.55, "timestamp": "04:45:19", "text": "或許就在這附近？"}, {"type": "subtitle", "time": 17132.59, "timestamp": "04:45:32", "text": "是的。"}, {"type": "subtitle", "time": 17143.03, "timestamp": "04:45:43", "text": "等等，這面牆還沒完工。"}, {"type": "subtitle", "time": 17143.51, "timestamp": "04:45:43", "text": "就這些嗎？"}, {"type": "subtitle", "time": 17144.67, "timestamp": "04:45:44", "text": "是的。打擾一下。"}, {"type": "subtitle", "time": 17150.23, "timestamp": "04:45:50", "text": "我優先處理這件事，因為我覺得他們可能無法到場。"}, {"type": "subtitle", "time": 17151.868, "timestamp": "04:45:51", "text": "哦，對不起。我懂了。對不起，對不起。"}, {"type": "subtitle", "time": 17153.982, "timestamp": "04:45:53", "text": "謝謝。好的，好的。耶！耶！我覺得渾身通電。"}, {"type": "subtitle", "time": 17158.628, "timestamp": "04:45:58", "text": "好的，我會負責銷毀迫擊砲。"}]
[{"type": "subtitle", "time": 9001.67, "timestamp": "02:30:01", "text": "謝謝。如果有的話"}, {"type": "subtitle", "time": 9008.15, "timestamp": "02:30:08", "text": "沒錯。我們已經"}, {"type": "subtitle", "time": 9009.19, "timestamp": "02:30:09", "text": "一個，"}, {"type": "subtitle", "time": 9011.55, "timestamp": "02:30:11", "text": "我當時滿腦子想的都是趕快離開那裡。"}, {"type": "subtitle", "time": 9012.469, "timestamp": "02:30:12", "text": "糟糕的。"}, {"type": "subtitle", "time": 9046.349, "timestamp": "02:30:46", "text": "我記得。"}, {"type": "subtitle", "time": 9047.309, "timestamp": "02:30:47", "text": "我把它寫下來了。"}]
[{"type": "subtitle", "time": 10620.389, "timestamp": "02:57:00", "text": "你知道，那邊有敵人。"}, {"type": "subtitle", "time": 10622.51, "timestamp": "02:57:02", "text": "哦，那裡還有其他人嗎？我們繼續吧？"}, {"type": "subtitle", "time": 10628.07, "timestamp": "02:57:08", "text": "現在"}, {"type": "subtitle", "time": 10630.95, "timestamp": "02:57:10", "text": "誰在基地購物？嗯，"}, {"type": "subtitle", "time": 10632.11, "timestamp": "02:57:12", "text": "糟糕的。說真的，這個地方"}, {"type": "subtitle", "time": 10633.229, "timestamp": "02:57:13", "text": "是千川先生嗎？"}, {"type": "subtitle", "time": 10641.95, "timestamp": "02:57:21", "text": "有效的策略。"}, {"type": "subtitle", "time": 10643.67, "timestamp": "02:57:23", "text": "嗯，我們四個人應該可以做到。"}, {"type": "subtitle", "time": 10645.51, "timestamp": "02:57:25", "text": "現在是我們了。"}, {"type": "subtitle", "time": 10647.95, "timestamp": "02:57:27", "text": "Myga"}, {"type": "subtitle", "time": 10648.91, "timestamp": "02:57:28", "text": "太瘋狂了。"}, {"type": "subtitle", "time": 10670.71, "timestamp": "02:57:50", "text": "現在"}, {"type": "subtitle", "time": 10672.269, "timestamp": "02:57:52", "text": "然後我們也是如此"}, {"type": "subtitle", "time": 10677.71, "timestamp": "02:57:57", "text": "過錯，"}]
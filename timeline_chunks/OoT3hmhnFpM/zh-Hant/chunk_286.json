[{"type": "subtitle", "time": 17160.91, "timestamp": "04:46:00", "text": "請。請。"}, {"type": "subtitle", "time": 17162.55, "timestamp": "04:46:02", "text": "是的。他把它弄壞了。"}, {"type": "subtitle", "time": 17163.19, "timestamp": "04:46:03", "text": "但這是最好的"}, {"type": "subtitle", "time": 17168.07, "timestamp": "04:46:08", "text": "是的。"}, {"type": "subtitle", "time": 17169.67, "timestamp": "04:46:09", "text": "這種情況會持續一段時間。"}, {"type": "subtitle", "time": 17171.47, "timestamp": "04:46:11", "text": "第一名是"}, {"type": "subtitle", "time": 17172.788, "timestamp": "04:46:12", "text": "水已經很深了，不是嗎？"}, {"type": "subtitle", "time": 17213.31, "timestamp": "04:46:53", "text": "我該去哭嗎？"}]
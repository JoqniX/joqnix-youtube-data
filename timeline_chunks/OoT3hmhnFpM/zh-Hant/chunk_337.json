[{"type": "subtitle", "time": 20221.788, "timestamp": "05:37:01", "text": "這越來越有趣了。"}, {"type": "subtitle", "time": 20230.03, "timestamp": "05:37:10", "text": "我買了這個。胃"}, {"type": "subtitle", "time": 20248.15, "timestamp": "05:37:28", "text": "我帶後面那傢伙一起走。這樣不好嗎？"}, {"type": "subtitle", "time": 20262.27, "timestamp": "05:37:42", "text": "哦，有人在朝我開槍。娜"}, {"type": "subtitle", "time": 20269.948, "timestamp": "05:37:49", "text": "不。"}, {"type": "subtitle", "time": 20274.948, "timestamp": "05:37:54", "text": "那個東西。"}, {"type": "subtitle", "time": 20276.19, "timestamp": "05:37:56", "text": "哦，它來了。"}, {"type": "subtitle", "time": 20276.67, "timestamp": "05:37:56", "text": "他們不會來了。"}]
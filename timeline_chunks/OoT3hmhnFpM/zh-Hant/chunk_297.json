[{"type": "subtitle", "time": 17820.91, "timestamp": "04:57:00", "text": "有軌電車來了。"}, {"type": "subtitle", "time": 17822.43, "timestamp": "04:57:02", "text": "哦，那很好。"}, {"type": "subtitle", "time": 17824.15, "timestamp": "04:57:04", "text": "哦，但是材料和燃料"}, {"type": "subtitle", "time": 17826.99, "timestamp": "04:57:06", "text": "1. 它勉強達到。"}, {"type": "subtitle", "time": 17846.67, "timestamp": "04:57:26", "text": "再來一次。"}, {"type": "subtitle", "time": 17847.83, "timestamp": "04:57:27", "text": "沒關係，沒關係，沒關係。沒什麼。"}, {"type": "subtitle", "time": 17849.15, "timestamp": "04:57:29", "text": "是的。好的。"}, {"type": "subtitle", "time": 17854.39, "timestamp": "04:57:34", "text": "我再做一個。"}, {"type": "subtitle", "time": 17857.46, "timestamp": "04:57:37", "text": "謝謝。謝謝。"}, {"type": "subtitle", "time": 17859.07, "timestamp": "04:57:39", "text": "[呻吟聲]"}, {"type": "subtitle", "time": 17861.23, "timestamp": "04:57:41", "text": "是的"}, {"type": "subtitle", "time": 17862.23, "timestamp": "04:57:42", "text": "不同之處。"}, {"type": "subtitle", "time": 17874.75, "timestamp": "04:57:54", "text": "開始了。"}, {"type": "subtitle", "time": 17879.15, "timestamp": "04:57:59", "text": "哦。"}]
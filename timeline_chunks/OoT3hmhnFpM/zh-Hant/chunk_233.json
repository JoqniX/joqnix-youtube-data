[{"type": "subtitle", "time": 13989.07, "timestamp": "03:53:09", "text": "你要來參加。兩架直升機。"}, {"type": "subtitle", "time": 13989.95, "timestamp": "03:53:09", "text": "是的。"}, {"type": "subtitle", "time": 13998.811, "timestamp": "03:53:18", "text": "從一開始"}, {"type": "subtitle", "time": 13999.91, "timestamp": "03:53:19", "text": "[笑聲]"}, {"type": "subtitle", "time": 14001.91, "timestamp": "03:53:21", "text": "你出生了。"}, {"type": "subtitle", "time": 14006.87, "timestamp": "03:53:26", "text": "[笑聲]"}, {"type": "subtitle", "time": 14016.59, "timestamp": "03:53:36", "text": "因為這與我有關，與我自身不了解的一部分有關。"}, {"type": "subtitle", "time": 14017.269, "timestamp": "03:53:37", "text": "耶穌。"}, {"type": "subtitle", "time": 14017.51, "timestamp": "03:53:37", "text": "是的。"}, {"type": "subtitle", "time": 14018.469, "timestamp": "03:53:38", "text": "生長。"}, {"type": "subtitle", "time": 14023.79, "timestamp": "03:53:43", "text": "這裡是湘南。"}]
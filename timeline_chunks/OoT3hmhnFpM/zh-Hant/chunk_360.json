[{"type": "subtitle", "time": 21600.83, "timestamp": "06:00:00", "text": "你還好嗎？"}, {"type": "subtitle", "time": 21602.39, "timestamp": "06:00:02", "text": "這樣如何？"}, {"type": "subtitle", "time": 21610.948, "timestamp": "06:00:10", "text": "我沒有。"}, {"type": "subtitle", "time": 21616.75, "timestamp": "06:00:16", "text": "不，沒人把它算進去。"}, {"type": "subtitle", "time": 21619.23, "timestamp": "06:00:19", "text": "是的。但你知道…"}, {"type": "subtitle", "time": 21637.75, "timestamp": "06:00:37", "text": "檸檬。"}, {"type": "subtitle", "time": 21642.23, "timestamp": "06:00:42", "text": "啊，"}, {"type": "subtitle", "time": 21648.07, "timestamp": "06:00:48", "text": "好的。好的，請稍等片刻。"}, {"type": "subtitle", "time": 21654.07, "timestamp": "06:00:54", "text": "我們來打掃一下。還有，1112顆星。"}, {"type": "subtitle", "time": 21656.31, "timestamp": "06:00:56", "text": "我同意。所有人都在裡面。好的。"}]
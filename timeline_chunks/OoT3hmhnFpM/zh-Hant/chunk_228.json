[{"type": "subtitle", "time": 13684.75, "timestamp": "03:48:04", "text": "O Park"}, {"type": "subtitle", "time": 13685.91, "timestamp": "03:48:05", "text": "它甚至不在修復計劃之內。"}, {"type": "subtitle", "time": 13686.99, "timestamp": "03:48:06", "text": "你好嗎？哦，"}, {"type": "subtitle", "time": 13694.269, "timestamp": "03:48:14", "text": "好久不見了。顧先生"}, {"type": "subtitle", "time": 13714.91, "timestamp": "03:48:34", "text": "右側"}, {"type": "subtitle", "time": 13716.67, "timestamp": "03:48:36", "text": "他們站在了正義的一邊。"}, {"type": "subtitle", "time": 13718.51, "timestamp": "03:48:38", "text": "是的。是的。是的，是的，是的。"}, {"type": "subtitle", "time": 13719.71, "timestamp": "03:48:39", "text": "哦。白色的"}, {"type": "subtitle", "time": 13737.269, "timestamp": "03:48:57", "text": "嗯？它在哪裡？"}, {"type": "subtitle", "time": 13738.59, "timestamp": "03:48:58", "text": "哦，不錯。"}]
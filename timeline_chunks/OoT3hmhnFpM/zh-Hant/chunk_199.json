[{"type": "subtitle", "time": 11947.87, "timestamp": "03:19:07", "text": "這裡幾乎沒有弓箭手。"}, {"type": "subtitle", "time": 11950.309, "timestamp": "03:19:10", "text": "這是正確的。我要左轉。"}, {"type": "subtitle", "time": 11968.189, "timestamp": "03:19:28", "text": "哦，你好。"}, {"type": "subtitle", "time": 11970.55, "timestamp": "03:19:30", "text": "我就在你旁邊。"}, {"type": "subtitle", "time": 11972.95, "timestamp": "03:19:32", "text": "好的。"}, {"type": "subtitle", "time": 11973.99, "timestamp": "03:19:33", "text": "啊，那很好。殺死米多。"}, {"type": "subtitle", "time": 11975.429, "timestamp": "03:19:35", "text": "好的。"}, {"type": "subtitle", "time": 11983.87, "timestamp": "03:19:43", "text": "哦，你要去嗎？"}, {"type": "subtitle", "time": 11986.63, "timestamp": "03:19:46", "text": "我覺得那很可能就是被殺的那個人。"}, {"type": "subtitle", "time": 11986.87, "timestamp": "03:19:46", "text": "O Park"}, {"type": "subtitle", "time": 11989.71, "timestamp": "03:19:49", "text": "我認為從北方看不到它。我是 Resa"}, {"type": "subtitle", "time": 11990.95, "timestamp": "03:19:50", "text": "一包裡有三個。"}, {"type": "subtitle", "time": 11993.269, "timestamp": "03:19:53", "text": "哦，我就用我手邊的那個吧。"}, {"type": "subtitle", "time": 11994.63, "timestamp": "03:19:54", "text": "O Park"}, {"type": "subtitle", "time": 11995.99, "timestamp": "03:19:55", "text": "現在就是時候了，對吧？"}, {"type": "subtitle", "time": 11998.269, "timestamp": "03:19:58", "text": "我們現在正遭到北方的槍擊。盟友。"}]
[{"type": "subtitle", "time": 20520.75, "timestamp": "05:42:00", "text": "他媽的。"}, {"type": "subtitle", "time": 20522.686, "timestamp": "05:42:02", "text": "不，但你必須從中吸取教訓。"}, {"type": "subtitle", "time": 20524.07, "timestamp": "05:42:04", "text": "[笑聲]"}, {"type": "subtitle", "time": 20529.35, "timestamp": "05:42:09", "text": "我真是個笨蛋，總是失敗。"}, {"type": "subtitle", "time": 20543.11, "timestamp": "05:42:23", "text": "是的。"}, {"type": "subtitle", "time": 20543.948, "timestamp": "05:42:23", "text": "Myga"}, {"type": "subtitle", "time": 20546.07, "timestamp": "05:42:26", "text": "那些不是會員但參與其中的人是"}, {"type": "subtitle", "time": 20547.31, "timestamp": "05:42:27", "text": "不知道那裡有沒有人？"}, {"type": "subtitle", "time": 20556.51, "timestamp": "05:42:36", "text": "好的。他們可能不會跟我在一起。"}, {"type": "subtitle", "time": 20558.468, "timestamp": "05:42:38", "text": "78911O。"}, {"type": "subtitle", "time": 20559.99, "timestamp": "05:42:39", "text": "是的，沒問題。所以"}, {"type": "subtitle", "time": 20562.27, "timestamp": "05:42:42", "text": "你們一共11個人？太棒了。"}, {"type": "subtitle", "time": 20563.43, "timestamp": "05:42:43", "text": "驚人的。"}, {"type": "subtitle", "time": 20569.99, "timestamp": "05:42:49", "text": "是的。"}, {"type": "subtitle", "time": 20571.99, "timestamp": "05:42:51", "text": "那就不是那樣了。 10"}, {"type": "subtitle", "time": 20573.11, "timestamp": "05:42:53", "text": "用「人」這個詞可以嗎？"}, {"type": "subtitle", "time": 20574.27, "timestamp": "05:42:54", "text": "412."}]
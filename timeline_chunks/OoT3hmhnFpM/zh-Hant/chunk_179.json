[{"type": "subtitle", "time": 10741.469, "timestamp": "02:59:01", "text": "去。"}, {"type": "subtitle", "time": 10747.269, "timestamp": "02:59:07", "text": "我能做到。"}, {"type": "subtitle", "time": 10749.99, "timestamp": "02:59:09", "text": "嘎，[笑]"}, {"type": "subtitle", "time": 10755.429, "timestamp": "02:59:15", "text": "發生了什麼事？"}, {"type": "subtitle", "time": 10763.59, "timestamp": "02:59:23", "text": "它爆炸了。那"}, {"type": "subtitle", "time": 10772.79, "timestamp": "02:59:32", "text": "每個人"}, {"type": "subtitle", "time": 10773.59, "timestamp": "02:59:33", "text": "哦。"}, {"type": "subtitle", "time": 10774.309, "timestamp": "02:59:34", "text": "你的錢。"}, {"type": "subtitle", "time": 10782.03, "timestamp": "02:59:42", "text": "角落裡還有一個人。"}, {"type": "subtitle", "time": 10784.269, "timestamp": "02:59:44", "text": "哦，對。"}, {"type": "subtitle", "time": 10785.999, "timestamp": "02:59:45", "text": "蚊子。好的，我做到了。"}, {"type": "subtitle", "time": 10786.389, "timestamp": "02:59:46", "text": "[笑聲]"}, {"type": "subtitle", "time": 10789.19, "timestamp": "02:59:49", "text": "你看，我還是可以去的。"}, {"type": "subtitle", "time": 10790.79, "timestamp": "02:59:50", "text": "我打算再去一次。"}, {"type": "subtitle", "time": 10792.03, "timestamp": "02:59:52", "text": "現在"}, {"type": "subtitle", "time": 10794.51, "timestamp": "02:59:54", "text": "我可以去。 [笑聲]"}]
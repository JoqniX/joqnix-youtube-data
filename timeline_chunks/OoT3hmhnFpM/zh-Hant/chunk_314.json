[{"type": "subtitle", "time": 18841.19, "timestamp": "05:14:01", "text": "即使我們要進行防禦，也必須先摧毀迫擊砲。難的。"}, {"type": "subtitle", "time": 18843.43, "timestamp": "05:14:03", "text": "是的，沒錯。這很難，不是嗎？砂漿。"}, {"type": "subtitle", "time": 18848.83, "timestamp": "05:14:08", "text": "我們走吧。我們倆設法做到了。"}, {"type": "subtitle", "time": 18850.27, "timestamp": "05:14:10", "text": "嗯，還有一個"}, {"type": "subtitle", "time": 18855.43, "timestamp": "05:14:15", "text": "嘿，你。"}, {"type": "subtitle", "time": 18858.31, "timestamp": "05:14:18", "text": "是的。它來了，它來了。"}, {"type": "subtitle", "time": 18865.708, "timestamp": "05:14:25", "text": "是的。"}, {"type": "subtitle", "time": 18866.39, "timestamp": "05:14:26", "text": "我不知道。"}, {"type": "subtitle", "time": 18867.31, "timestamp": "05:14:27", "text": "謝謝。謝謝。"}, {"type": "subtitle", "time": 18872.15, "timestamp": "05:14:32", "text": "哦"}, {"type": "subtitle", "time": 18873.39, "timestamp": "05:14:33", "text": "我不用特種部隊。"}, {"type": "subtitle", "time": 18878.628, "timestamp": "05:14:38", "text": "是的。"}, {"type": "subtitle", "time": 18879.67, "timestamp": "05:14:39", "text": "前進。"}, {"type": "subtitle", "time": 18881.39, "timestamp": "05:14:41", "text": "我們的目的地是體育場。"}, {"type": "subtitle", "time": 18882.19, "timestamp": "05:14:42", "text": "是的。"}, {"type": "subtitle", "time": 18895.948, "timestamp": "05:14:55", "text": "我同意。"}, {"type": "subtitle", "time": 18896.99, "timestamp": "05:14:56", "text": "揉。"}, {"type": "subtitle", "time": 18898.922, "timestamp": "05:14:58", "text": "是的。當心。但我真的不太明白那部分。"}]
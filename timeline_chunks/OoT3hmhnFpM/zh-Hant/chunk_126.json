[{"type": "subtitle", "time": 7567.47, "timestamp": "02:06:07", "text": "我們殺了他。也"}, {"type": "subtitle", "time": 7570.83, "timestamp": "02:06:10", "text": "我不知道"}, {"type": "subtitle", "time": 7583.27, "timestamp": "02:06:23", "text": "大家都睡著了，情況看起來不錯。"}, {"type": "subtitle", "time": 7585.629, "timestamp": "02:06:25", "text": "是的，我身邊有不少盟友。"}, {"type": "subtitle", "time": 7609.867, "timestamp": "02:06:49", "text": "我在飛行。它在接住它，它在吸它，它在吸它。我無法原諒這件事。"}]
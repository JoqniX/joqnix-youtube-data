[{"type": "subtitle", "time": 17763.47, "timestamp": "04:56:03", "text": "嗯，嗯，嗯，嗯，是啊。我們應該使用砂漿。"}, {"type": "subtitle", "time": 17764.39, "timestamp": "04:56:04", "text": "一會兒。我已經1歲了"}, {"type": "subtitle", "time": 17766.43, "timestamp": "04:56:06", "text": "或許我會做一個。迫擊砲攻擊。啊，但我不知道我能不能去。"}, {"type": "subtitle", "time": 17767.788, "timestamp": "04:56:07", "text": "啊，達到了2000，這很好。"}, {"type": "subtitle", "time": 17769.23, "timestamp": "04:56:09", "text": "沒關係，沒關係，沒關係。現在又來一個"}, {"type": "subtitle", "time": 17770.43, "timestamp": "04:56:10", "text": "2倍，所以是4000"}, {"type": "subtitle", "time": 17772.03, "timestamp": "04:56:12", "text": "大約是[日圓金額]。"}, {"type": "subtitle", "time": 17774.548, "timestamp": "04:56:14", "text": "我的天哪，留著它吧。"}, {"type": "subtitle", "time": 17777.11, "timestamp": "04:56:17", "text": "我只是隨便看看。"}, {"type": "subtitle", "time": 17794.628, "timestamp": "04:56:34", "text": "我現在什麼都沒做。"}, {"type": "subtitle", "time": 17795.788, "timestamp": "04:56:35", "text": "好的。"}, {"type": "subtitle", "time": 17802.59, "timestamp": "04:56:42", "text": "是的，是的，是的，是的。"}, {"type": "subtitle", "time": 17804.19, "timestamp": "04:56:44", "text": "我們來試試看。"}, {"type": "subtitle", "time": 17804.628, "timestamp": "04:56:44", "text": "圖片，"}, {"type": "subtitle", "time": 17806.548, "timestamp": "04:56:46", "text": "我們來看看紅色的那個。一點點"}, {"type": "subtitle", "time": 17809.03, "timestamp": "04:56:49", "text": "對不起。你能叫醒我嗎？我在樓下。"}, {"type": "subtitle", "time": 17813.07, "timestamp": "04:56:53", "text": "如果一切都結束了。"}, {"type": "subtitle", "time": 17813.75, "timestamp": "04:56:53", "text": "一個，"}, {"type": "subtitle", "time": 17815.43, "timestamp": "04:56:55", "text": "紅色的。啊，它會來的。紅色的。"}, {"type": "subtitle", "time": 17816.83, "timestamp": "04:56:56", "text": "約瑟芬。"}, {"type": "subtitle", "time": 17817.11, "timestamp": "04:56:57", "text": "一個，"}, {"type": "subtitle", "time": 17819.03, "timestamp": "04:56:59", "text": "約瑟芬。"}]
[{"type": "subtitle", "time": 6483.31, "timestamp": "01:48:03", "text": "狙擊手。我同意。現在"}, {"type": "subtitle", "time": 6486.47, "timestamp": "01:48:06", "text": "西側。啊，我們已經到達山頂了。這是鐵礦石。"}, {"type": "subtitle", "time": 6487.79, "timestamp": "01:48:07", "text": "從救贖。哦"}, {"type": "subtitle", "time": 6490.27, "timestamp": "01:48:10", "text": "嘿。哦，爸爸也來了。我們贏了。"}, {"type": "subtitle", "time": 6491.79, "timestamp": "01:48:11", "text": "哦，那太好了。"}, {"type": "subtitle", "time": 6496.31, "timestamp": "01:48:16", "text": "啊，在那裡。"}, {"type": "subtitle", "time": 6507.229, "timestamp": "01:48:27", "text": "362 [笑聲]"}, {"type": "subtitle", "time": 6508.75, "timestamp": "01:48:28", "text": "我不知道他們會不會來。"}, {"type": "subtitle", "time": 6511.07, "timestamp": "01:48:31", "text": "就是這樣。我會透過那位朋友加入。"}, {"type": "subtitle", "time": 6513.39, "timestamp": "01:48:33", "text": "當你以好友加入遊戲時"}, {"type": "subtitle", "time": 6518.87, "timestamp": "01:48:38", "text": "我原諒你。憤怒的孩子"}, {"type": "subtitle", "time": 6521.27, "timestamp": "01:48:41", "text": "你剛剛看到這附近有敵人嗎？"}, {"type": "subtitle", "time": 6523.03, "timestamp": "01:48:43", "text": "他們似乎在保守這個秘密。"}, {"type": "subtitle", "time": 6523.47, "timestamp": "01:48:43", "text": "是的。"}, {"type": "subtitle", "time": 6525.43, "timestamp": "01:48:45", "text": "讓我們從上方來看。"}, {"type": "subtitle", "time": 6529.07, "timestamp": "01:48:49", "text": "1"}, {"type": "subtitle", "time": 6531.03, "timestamp": "01:48:51", "text": "我以前在那裡工作，但我認為我現在還在那裡。"}, {"type": "subtitle", "time": 6535.91, "timestamp": "01:48:55", "text": "沒有挽回的餘地。"}, {"type": "subtitle", "time": 6537.75, "timestamp": "01:48:57", "text": "今天網路真的好卡。"}]
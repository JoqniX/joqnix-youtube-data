[{"type": "subtitle", "time": 19023.19, "timestamp": "05:17:03", "text": "我殺了他們。"}, {"type": "subtitle", "time": 19032.51, "timestamp": "05:17:12", "text": "1"}, {"type": "subtitle", "time": 19035.35, "timestamp": "05:17:15", "text": "我吵醒了某人。那太棒了。"}, {"type": "subtitle", "time": 19042.99, "timestamp": "05:17:22", "text": "他們幹的嗎？"}, {"type": "subtitle", "time": 19045.11, "timestamp": "05:17:25", "text": "這就是我。門沒鎖。"}, {"type": "subtitle", "time": 19047.61, "timestamp": "05:17:27", "text": "湧入了一大筆錢。"}, {"type": "subtitle", "time": 19067.03, "timestamp": "05:17:47", "text": "稍等片刻，我恢復1點生命值。"}, {"type": "subtitle", "time": 19078.948, "timestamp": "05:17:58", "text": "爸爸正在康復中。它會割傷一點。"}, {"type": "subtitle", "time": 19079.75, "timestamp": "05:17:59", "text": "蹲下。"}]
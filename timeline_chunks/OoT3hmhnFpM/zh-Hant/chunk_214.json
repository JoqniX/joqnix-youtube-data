[{"type": "subtitle", "time": 12847.91, "timestamp": "03:34:07", "text": "我也是這麼想的。我仍然無法使用AD。"}, {"type": "subtitle", "time": 12850.583, "timestamp": "03:34:10", "text": "哦，我也用不了。"}, {"type": "subtitle", "time": 12851.469, "timestamp": "03:34:11", "text": "[笑聲]"}, {"type": "subtitle", "time": 12853.79, "timestamp": "03:34:13", "text": "無用。我們仍然"}, {"type": "subtitle", "time": 12855.67, "timestamp": "03:34:15", "text": "連Active Directory都用不了？"}, {"type": "subtitle", "time": 12857.59, "timestamp": "03:34:17", "text": "多拿一些。"}, {"type": "subtitle", "time": 12865.269, "timestamp": "03:34:25", "text": "嘿，我先走一會兒。"}, {"type": "subtitle", "time": 12865.63, "timestamp": "03:34:25", "text": "好的。"}, {"type": "subtitle", "time": 12875.99, "timestamp": "03:34:35", "text": "是的。我把一張嘔吐臉丟進森林了。"}, {"type": "subtitle", "time": 12888.99, "timestamp": "03:34:48", "text": "我會把它找回來的。"}, {"type": "subtitle", "time": 12890.71, "timestamp": "03:34:50", "text": "我想把它要回來。"}]
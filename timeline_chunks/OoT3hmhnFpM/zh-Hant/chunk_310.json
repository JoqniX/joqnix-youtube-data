[{"type": "subtitle", "time": 18600.75, "timestamp": "05:10:00", "text": "你剛好有這些子彈​​嗎？"}, {"type": "subtitle", "time": 18602.75, "timestamp": "05:10:02", "text": "哦，我有了，我有了，我一定會得到。等一下，"}, {"type": "subtitle", "time": 18605.47, "timestamp": "05:10:05", "text": "等一下。哦，那太危險了。這邊更好。"}, {"type": "subtitle", "time": 18606.35, "timestamp": "05:10:06", "text": "是的。我做到了。"}, {"type": "subtitle", "time": 18608.47, "timestamp": "05:10:08", "text": "給你一本雜誌，我送你一本雜誌。然後"}, {"type": "subtitle", "time": 18610.91, "timestamp": "05:10:10", "text": "好的。真是鬆了一口氣。"}, {"type": "subtitle", "time": 18615.59, "timestamp": "05:10:15", "text": "你還好嗎？"}, {"type": "subtitle", "time": 18618.35, "timestamp": "05:10:18", "text": "嗯？不，不，不，哇，你竟然給我這麼多？謝謝。"}, {"type": "subtitle", "time": 18619.868, "timestamp": "05:10:19", "text": "哦，我會給你的。好的，好的。 3"}, {"type": "subtitle", "time": 18622.07, "timestamp": "05:10:22", "text": "我有一張。"}, {"type": "subtitle", "time": 18623.11, "timestamp": "05:10:23", "text": "嗯？嗯，"}, {"type": "subtitle", "time": 18625.03, "timestamp": "05:10:25", "text": "那是什麼？"}, {"type": "subtitle", "time": 18627.27, "timestamp": "05:10:27", "text": "你不需要這個嗎？不。"}, {"type": "subtitle", "time": 18628.07, "timestamp": "05:10:28", "text": "是的。醋，"}, {"type": "subtitle", "time": 18629.75, "timestamp": "05:10:29", "text": "我們要殺了他們嗎？"}, {"type": "subtitle", "time": 18630.948, "timestamp": "05:10:30", "text": "我要去殺了他。"}, {"type": "subtitle", "time": 18631.948, "timestamp": "05:10:31", "text": "好，我們一起去吧。"}, {"type": "subtitle", "time": 18633.67, "timestamp": "05:10:33", "text": "哦，嘿，再多一點"}, {"type": "subtitle", "time": 18635.67, "timestamp": "05:10:35", "text": "我可以拍30張左右嗎？"}, {"type": "subtitle", "time": 18639.43, "timestamp": "05:10:39", "text": "30 發，呃，每發一滴。"}, {"type": "subtitle", "time": 18641.548, "timestamp": "05:10:41", "text": "不是彈匣，而是子彈。"}, {"type": "subtitle", "time": 18646.51, "timestamp": "05:10:46", "text": "是的。"}, {"type": "subtitle", "time": 18646.948, "timestamp": "05:10:46", "text": "謝謝。"}, {"type": "subtitle", "time": 18648.19, "timestamp": "05:10:48", "text": "我先放下錘子一會兒。"}, {"type": "subtitle", "time": 18654.11, "timestamp": "05:10:54", "text": "感覺有些不對勁。"}, {"type": "subtitle", "time": 18654.47, "timestamp": "05:10:54", "text": "太瘋狂了。"}, {"type": "subtitle", "time": 18656.03, "timestamp": "05:10:56", "text": "情況很糟。"}]
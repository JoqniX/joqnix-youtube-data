[{"type": "subtitle", "time": 6180.51, "timestamp": "01:43:00", "text": "嗯，你知道…"}, {"type": "subtitle", "time": 6201.47, "timestamp": "01:43:21", "text": "我去拿電鑽。你知道，那座塔。"}, {"type": "subtitle", "time": 6206.75, "timestamp": "01:43:26", "text": "哦，你明白了？"}, {"type": "subtitle", "time": 6206.99, "timestamp": "01:43:26", "text": "這 1"}, {"type": "subtitle", "time": 6212.79, "timestamp": "01:43:32", "text": "我同意。嗯，一次，一次 1"}, {"type": "subtitle", "time": 6215.39, "timestamp": "01:43:35", "text": "啟動它的時候，我想，「哦，就是這樣了。」你指的是鑽井塔，對吧？"}, {"type": "subtitle", "time": 6216.51, "timestamp": "01:43:36", "text": "嘿。是的，就是那座塔。"}, {"type": "subtitle", "time": 6217.629, "timestamp": "01:43:37", "text": "是的，1號塔"}, {"type": "subtitle", "time": 6222.39, "timestamp": "01:43:42", "text": "我懂了。 1"}, {"type": "subtitle", "time": 6224.589, "timestamp": "01:43:44", "text": "這其實是我第一次做這件事。"}, {"type": "subtitle", "time": 6226.91, "timestamp": "01:43:46", "text": "謝謝你。是的。"}, {"type": "subtitle", "time": 6228.95, "timestamp": "01:43:48", "text": "啊，對，肯定就是這個。那座塔"}, {"type": "subtitle", "time": 6230.91, "timestamp": "01:43:50", "text": "因為只有兩個。"}, {"type": "subtitle", "time": 6234.87, "timestamp": "01:43:54", "text": "不錯，不錯。"}]
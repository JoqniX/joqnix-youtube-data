[{"type": "subtitle", "time": 6601.99, "timestamp": "01:50:01", "text": "你剛才說的是“權力”，對吧？但"}, {"type": "subtitle", "time": 6604.589, "timestamp": "01:50:04", "text": "我做過一次。"}, {"type": "subtitle", "time": 6607.03, "timestamp": "01:50:07", "text": "我打算嘗試以5:45的速度飛行。"}, {"type": "subtitle", "time": 6633.51, "timestamp": "01:50:33", "text": "大概在 545 秒左右，或略低於 545 秒。"}, {"type": "subtitle", "time": 6636.43, "timestamp": "01:50:36", "text": "哦，這下糟了。我的目標是Core-san"}, {"type": "subtitle", "time": 6639.43, "timestamp": "01:50:39", "text": "這裡是"}, {"type": "subtitle", "time": 6643.149, "timestamp": "01:50:43", "text": "1可以嗎？是的，1號塔。哦，又來了。"}, {"type": "subtitle", "time": 6644.35, "timestamp": "01:50:44", "text": "賓果！不，這行不通。"}, {"type": "subtitle", "time": 6658.149, "timestamp": "01:50:58", "text": "不同之處"}]
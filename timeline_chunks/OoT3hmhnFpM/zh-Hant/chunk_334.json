[{"type": "subtitle", "time": 20050.83, "timestamp": "05:34:10", "text": "哇，真好吃。"}, {"type": "subtitle", "time": 20059.548, "timestamp": "05:34:19", "text": "是的。"}, {"type": "subtitle", "time": 20061.868, "timestamp": "05:34:21", "text": "去。我想去。我不會原諒你。"}, {"type": "subtitle", "time": 20064.19, "timestamp": "05:34:24", "text": "我的孩子去世了。現在，"}, {"type": "subtitle", "time": 20066.47, "timestamp": "05:34:26", "text": "他剛剛死去，但他仍然擁有復活的能力。死。"}, {"type": "subtitle", "time": 20072.91, "timestamp": "05:34:32", "text": "我們走吧。"}, {"type": "subtitle", "time": 20084.23, "timestamp": "05:34:44", "text": "我不會原諒他們。"}, {"type": "subtitle", "time": 20096.03, "timestamp": "05:34:56", "text": "我會殺了你。"}]
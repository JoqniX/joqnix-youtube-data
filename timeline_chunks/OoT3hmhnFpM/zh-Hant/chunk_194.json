[{"type": "subtitle", "time": 11640.59, "timestamp": "03:14:00", "text": "我再做一個鑽頭，以防萬一。"}, {"type": "subtitle", "time": 11644.269, "timestamp": "03:14:04", "text": "我要跑馬拉松。"}, {"type": "subtitle", "time": 11646.59, "timestamp": "03:14:06", "text": "謝謝。"}, {"type": "subtitle", "time": 11648.87, "timestamp": "03:14:08", "text": "你需要出去嗎？"}, {"type": "subtitle", "time": 11651.75, "timestamp": "03:14:11", "text": "我覺得他們還在那裡。"}, {"type": "subtitle", "time": 11654.07, "timestamp": "03:14:14", "text": "我在外面。"}, {"type": "subtitle", "time": 11666.269, "timestamp": "03:14:26", "text": "正如你拿在手裡時所料，這把錘子很重。"}, {"type": "subtitle", "time": 11668.91, "timestamp": "03:14:28", "text": "是的。"}, {"type": "subtitle", "time": 11678.269, "timestamp": "03:14:38", "text": "1"}]
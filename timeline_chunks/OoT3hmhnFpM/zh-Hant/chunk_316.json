[{"type": "subtitle", "time": 18961.83, "timestamp": "05:16:01", "text": "就這些嗎？哦"}, {"type": "subtitle", "time": 18962.67, "timestamp": "05:16:02", "text": "哦，是的，有。"}, {"type": "subtitle", "time": 18963.35, "timestamp": "05:16:03", "text": "是的，我會。"}, {"type": "subtitle", "time": 18965.67, "timestamp": "05:16:05", "text": "早安."}, {"type": "subtitle", "time": 18977.75, "timestamp": "05:16:17", "text": "不，什麼都做。我在那場直升機墜毀事故中喪生了。"}, {"type": "subtitle", "time": 18980.43, "timestamp": "05:16:20", "text": "他們還在這裡。"}, {"type": "subtitle", "time": 18988.39, "timestamp": "05:16:28", "text": "好兄弟。好兄弟。"}, {"type": "subtitle", "time": 18990.11, "timestamp": "05:16:30", "text": "我可以先叫醒你嗎？"}, {"type": "subtitle", "time": 18991.35, "timestamp": "05:16:31", "text": "我死了。對不起。"}, {"type": "subtitle", "time": 18998.75, "timestamp": "05:16:38", "text": "現在，他們正在一個接一個地叫醒他們。"}, {"type": "subtitle", "time": 19005.23, "timestamp": "05:16:45", "text": "我會給你錢。尖端。哦，等等。來。"}, {"type": "subtitle", "time": 19007.27, "timestamp": "05:16:47", "text": "哦。 500，"}, {"type": "subtitle", "time": 19010.59, "timestamp": "05:16:50", "text": "500 我的更高級。"}, {"type": "subtitle", "time": 19015.07, "timestamp": "05:16:55", "text": "這很糟糕。"}, {"type": "subtitle", "time": 19016.15, "timestamp": "05:16:56", "text": "這可能不太妙。"}]
[{"type": "subtitle", "time": 8160.229, "timestamp": "02:16:00", "text": "哦，你說得對。哦，你說得對。"}, {"type": "subtitle", "time": 8161.589, "timestamp": "02:16:01", "text": "聽起來很難。"}, {"type": "subtitle", "time": 8168.35, "timestamp": "02:16:08", "text": "是的。我認為有很多人都是第一名。"}, {"type": "subtitle", "time": 8174.43, "timestamp": "02:16:14", "text": "我們運輸的是燃料。"}, {"type": "subtitle", "time": 8186.069, "timestamp": "02:16:26", "text": "是的。"}, {"type": "subtitle", "time": 8196.629, "timestamp": "02:16:36", "text": "嗯，在南邊"}, {"type": "subtitle", "time": 8197.19, "timestamp": "02:16:37", "text": "我把它掉在地上了。"}]
[{"type": "subtitle", "time": 9304.309, "timestamp": "02:35:04", "text": "哦，不。"}, {"type": "subtitle", "time": 9307.23, "timestamp": "02:35:07", "text": "就像一個名字很奇怪的人。"}, {"type": "subtitle", "time": 9311.95, "timestamp": "02:35:11", "text": "[笑聲]"}, {"type": "subtitle", "time": 9314.197, "timestamp": "02:35:14", "text": "打擾一下。打擾一下。不，不，不。我明白了。我明白。鬥爭"}, {"type": "subtitle", "time": 9321.55, "timestamp": "02:35:21", "text": "決不。"}, {"type": "subtitle", "time": 9326.95, "timestamp": "02:35:26", "text": "五次。"}, {"type": "subtitle", "time": 9327.71, "timestamp": "02:35:27", "text": "哦，主菜。 5"}, {"type": "subtitle", "time": 9329.51, "timestamp": "02:35:29", "text": "次數。五次。五次。五次。 5次[笑]。 5"}, {"type": "subtitle", "time": 9338.59, "timestamp": "02:35:38", "text": "惱人的。"}, {"type": "subtitle", "time": 9339.59, "timestamp": "02:35:39", "text": "我懂了。"}, {"type": "subtitle", "time": 9351.532, "timestamp": "02:35:51", "text": "請。呃，等等，我今天出汗好多。我今天出了很多汗。"}, {"type": "subtitle", "time": 9351.83, "timestamp": "02:35:51", "text": "[笑聲]"}, {"type": "subtitle", "time": 9353.95, "timestamp": "02:35:53", "text": "好的。我相信你。沒關係，沒關係。"}, {"type": "subtitle", "time": 9355.75, "timestamp": "02:35:55", "text": "謝謝。謝謝。"}]
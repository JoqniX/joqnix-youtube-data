[{"type": "subtitle", "time": 15900.389, "timestamp": "04:25:00", "text": "他看起來很累。也許"}, {"type": "subtitle", "time": 15902.83, "timestamp": "04:25:02", "text": "我也很快就睡著了。嚴重地？"}, {"type": "subtitle", "time": 15904.109, "timestamp": "04:25:04", "text": "我也是。"}, {"type": "subtitle", "time": 15906.71, "timestamp": "04:25:06", "text": "我吃了晚飯，洗了個澡，然後就睡著了。"}, {"type": "subtitle", "time": 15909.429, "timestamp": "04:25:09", "text": "哦，我也是。"}, {"type": "subtitle", "time": 15912.71, "timestamp": "04:25:12", "text": "不到21小時"}, {"type": "subtitle", "time": 15915.349, "timestamp": "04:25:15", "text": "等了6個小時。"}, {"type": "subtitle", "time": 15916.75, "timestamp": "04:25:16", "text": "嗯，是的。 4"}, {"type": "subtitle", "time": 15919.71, "timestamp": "04:25:19", "text": "睡夠時間就行了。文明程度就是每天睡4小時。"}, {"type": "subtitle", "time": 15926.349, "timestamp": "04:25:26", "text": "是的。我10歲"}, {"type": "subtitle", "time": 15928.429, "timestamp": "04:25:28", "text": "大約花了11個小時。一個，"}, {"type": "subtitle", "time": 15929.83, "timestamp": "04:25:29", "text": "他睡著了。"}, {"type": "subtitle", "time": 15932.469, "timestamp": "04:25:32", "text": "但他不是個睡得很晚的人嗎？"}, {"type": "subtitle", "time": 15935.55, "timestamp": "04:25:35", "text": "是的。通常超過10小時。"}, {"type": "subtitle", "time": 15936.109, "timestamp": "04:25:36", "text": "啊，"}, {"type": "subtitle", "time": 15937.91, "timestamp": "04:25:37", "text": "今天的數字仍然相對較低。"}, {"type": "subtitle", "time": 15944.71, "timestamp": "04:25:44", "text": "這是一列神聖的列車。"}, {"type": "subtitle", "time": 15959.269, "timestamp": "04:25:59", "text": "是的。"}]
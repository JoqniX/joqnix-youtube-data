[{"type": "subtitle", "time": 9964.51, "timestamp": "02:46:04", "text": "是……是他嗎？他殺了我嗎？"}, {"type": "subtitle", "time": 9965.71, "timestamp": "02:46:05", "text": "O Park"}, {"type": "subtitle", "time": 9999.269, "timestamp": "02:46:39", "text": "是的。我很好。"}, {"type": "subtitle", "time": 10000.71, "timestamp": "02:46:40", "text": "沒關係。某物"}, {"type": "subtitle", "time": 10003.389, "timestamp": "02:46:43", "text": "進行心肺復甦術非常困難。會不會是這個？"}, {"type": "subtitle", "time": 10004.63, "timestamp": "02:46:44", "text": "是的。"}, {"type": "subtitle", "time": 10006.59, "timestamp": "02:46:46", "text": "我該走嗎？一個，"}, {"type": "subtitle", "time": 10014.389, "timestamp": "02:46:54", "text": "是的。哦，他在那兒。"}, {"type": "subtitle", "time": 10015.67, "timestamp": "02:46:55", "text": "啊，我可以走了。是的。前進。"}, {"type": "subtitle", "time": 10017.71, "timestamp": "02:46:57", "text": "我可以從裡面放進去嗎？胸罩。"}, {"type": "subtitle", "time": 10019.51, "timestamp": "02:46:59", "text": "現在是不是該有人把他們叫醒了？"}]
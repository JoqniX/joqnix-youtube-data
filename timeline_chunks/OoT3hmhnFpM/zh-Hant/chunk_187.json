[{"type": "subtitle", "time": 11221.55, "timestamp": "03:07:01", "text": "[笑聲]"}, {"type": "subtitle", "time": 11223.59, "timestamp": "03:07:03", "text": "我被迷你機槍打死了。直升機。"}, {"type": "subtitle", "time": 11239.229, "timestamp": "03:07:19", "text": "我做了。 1人。好的。"}, {"type": "subtitle", "time": 11239.99, "timestamp": "03:07:19", "text": "它在南邊嗎？"}, {"type": "subtitle", "time": 11240.71, "timestamp": "03:07:20", "text": "嘿。"}, {"type": "subtitle", "time": 11251.469, "timestamp": "03:07:31", "text": "是的。就是這樣。"}, {"type": "subtitle", "time": 11253.19, "timestamp": "03:07:33", "text": "一個也沒有"}, {"type": "subtitle", "time": 11259.269, "timestamp": "03:07:39", "text": "點。就這些嗎？"}, {"type": "subtitle", "time": 11262.469, "timestamp": "03:07:42", "text": "他們來自不同的隊伍。還有兩個。"}, {"type": "subtitle", "time": 11263.429, "timestamp": "03:07:43", "text": "好的。他死了。"}, {"type": "subtitle", "time": 11264.07, "timestamp": "03:07:44", "text": "好的。 1人。"}, {"type": "subtitle", "time": 11267.07, "timestamp": "03:07:47", "text": "好的。好，好，好，好，好。"}, {"type": "subtitle", "time": 11271.87, "timestamp": "03:07:51", "text": "讓我看看裡面是什麼樣子。"}, {"type": "subtitle", "time": 11273.79, "timestamp": "03:07:53", "text": "是的。但我認為我會繼續下去。南"}]
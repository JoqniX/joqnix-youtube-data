[{"type": "subtitle", "time": 20343.19, "timestamp": "05:39:03", "text": "好吧。伊瑪桑"}, {"type": "subtitle", "time": 20354.03, "timestamp": "05:39:14", "text": "不，現在去那裡是個糟糕的主意。"}, {"type": "subtitle", "time": 20356.31, "timestamp": "05:39:16", "text": "上面有人。上面有人嗎？"}, {"type": "subtitle", "time": 20366.99, "timestamp": "05:39:26", "text": "糟糕的。"}, {"type": "subtitle", "time": 20368.11, "timestamp": "05:39:28", "text": "他媽的。最糟糕的。"}, {"type": "subtitle", "time": 20378.628, "timestamp": "05:39:38", "text": "嗯，我其實做得還挺糟糕的。我"}, {"type": "subtitle", "time": 20380.51, "timestamp": "05:39:40", "text": "是的。哦"}, {"type": "subtitle", "time": 20396.67, "timestamp": "05:39:56", "text": "如何重建？"}]
[{"type": "subtitle", "time": 10141.83, "timestamp": "02:49:01", "text": "聯合拍攝"}, {"type": "subtitle", "time": 10143.51, "timestamp": "02:49:03", "text": "我們能不能用這個地方？哦，不，我們不能。"}, {"type": "subtitle", "time": 10146.389, "timestamp": "02:49:06", "text": "哦，等等，呃，不，我想我可以做到。我們能做到，我們能做到，我們能做到。"}, {"type": "subtitle", "time": 10147.389, "timestamp": "02:49:07", "text": "就是這樣。"}, {"type": "subtitle", "time": 10149.51, "timestamp": "02:49:09", "text": "這。這是正確的。這是牆"}, {"type": "subtitle", "time": 10151.309, "timestamp": "02:49:11", "text": "打破一個"}, {"type": "subtitle", "time": 10152.95, "timestamp": "02:49:12", "text": "我認為我們能做到。"}, {"type": "subtitle", "time": 10155.79, "timestamp": "02:49:15", "text": "呃，我不能去後面。好的。"}, {"type": "subtitle", "time": 10158.63, "timestamp": "02:49:18", "text": "哦真的嗎？"}, {"type": "subtitle", "time": 10179.83, "timestamp": "02:49:39", "text": "這是最糟糕的情況。"}, {"type": "subtitle", "time": 10181.67, "timestamp": "02:49:41", "text": "謝謝。裡桑。"}, {"type": "subtitle", "time": 10184.469, "timestamp": "02:49:44", "text": "不，嗯，就是這樣。"}, {"type": "subtitle", "time": 10187.07, "timestamp": "02:49:47", "text": "一隻黃貂魚剛剛飛過。 O Park"}, {"type": "subtitle", "time": 10188.59, "timestamp": "02:49:48", "text": "司機"}, {"type": "subtitle", "time": 10198.91, "timestamp": "02:49:58", "text": "我好像被一隻黃貂魚盯上了。"}]
[{"type": "subtitle", "time": 18784.91, "timestamp": "05:13:04", "text": "南方的日子依然不好過。"}, {"type": "subtitle", "time": 18786.39, "timestamp": "05:13:06", "text": "哦，對。比久間更甚。"}, {"type": "subtitle", "time": 18797.75, "timestamp": "05:13:17", "text": "我們遭到了來自某個方向的槍擊。"}, {"type": "subtitle", "time": 18800.19, "timestamp": "05:13:20", "text": "或許是在公寓大樓的頂樓。"}, {"type": "subtitle", "time": 18808.83, "timestamp": "05:13:28", "text": "咦，還是被綠色擊敗了？我想知道？"}, {"type": "subtitle", "time": 18829.788, "timestamp": "05:13:49", "text": "好的。嗯，那"}, {"type": "subtitle", "time": 18831.83, "timestamp": "05:13:51", "text": "總會到來的。敵人是"}, {"type": "subtitle", "time": 18838.67, "timestamp": "05:13:58", "text": "是的。我們應該守衛基地嗎？"}]
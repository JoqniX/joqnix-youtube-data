[{"type": "subtitle", "time": 20101.35, "timestamp": "05:35:01", "text": "你這可是件大事。"}, {"type": "subtitle", "time": 20101.628, "timestamp": "05:35:01", "text": "是的。"}, {"type": "subtitle", "time": 20104.31, "timestamp": "05:35:04", "text": "沒錯。"}, {"type": "subtitle", "time": 20112.31, "timestamp": "05:35:12", "text": "是的。是的。我們"}, {"type": "subtitle", "time": 20115.11, "timestamp": "05:35:15", "text": "也許我應該直接把它銷毀。所以"}, {"type": "subtitle", "time": 20125.43, "timestamp": "05:35:25", "text": "你可以用錘子把它砸碎。我不知道這件事。"}, {"type": "subtitle", "time": 20127.868, "timestamp": "05:35:27", "text": "我上次嘗試的時候以為我沒能把它弄壞。"}, {"type": "subtitle", "time": 20133.948, "timestamp": "05:35:33", "text": "我當時在想，這東西是不是堅不可摧的。"}, {"type": "subtitle", "time": 20153.67, "timestamp": "05:35:53", "text": "就這些嗎？"}, {"type": "subtitle", "time": 20155.708, "timestamp": "05:35:55", "text": "啊。所以。"}]
[{"type": "subtitle", "time": 22025.23, "timestamp": "06:07:05", "text": "稍等片刻，發表意見。"}, {"type": "subtitle", "time": 22027.31, "timestamp": "06:07:07", "text": "2828"}, {"type": "subtitle", "time": 22029.86, "timestamp": "06:07:09", "text": "紅色"}, {"type": "subtitle", "time": 22031.548, "timestamp": "06:07:11", "text": "[笑聲]"}, {"type": "subtitle", "time": 22033.35, "timestamp": "06:07:13", "text": "紅色，紅色，哦，等等。"}, {"type": "subtitle", "time": 22034.788, "timestamp": "06:07:14", "text": "開始了。"}, {"type": "subtitle", "time": 22043.35, "timestamp": "06:07:23", "text": "哇。"}, {"type": "subtitle", "time": 22046.27, "timestamp": "06:07:26", "text": "哦，好的，那我來組隊。圖片，"}, {"type": "subtitle", "time": 22048.788, "timestamp": "06:07:28", "text": "哦，咔噠，咔噠，咔噠，咔噠，咔。"}, {"type": "subtitle", "time": 22051.51, "timestamp": "06:07:31", "text": "所有人都能登入伺服器嗎？"}, {"type": "subtitle", "time": 22052.59, "timestamp": "06:07:32", "text": "我已經放進去了。"}, {"type": "subtitle", "time": 22066.07, "timestamp": "06:07:46", "text": "[笑聲]"}]
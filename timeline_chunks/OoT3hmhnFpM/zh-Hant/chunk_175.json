[{"type": "subtitle", "time": 10505.11, "timestamp": "02:55:05", "text": "我上樓一會兒。"}, {"type": "subtitle", "time": 10511.79, "timestamp": "02:55:11", "text": "我即將發布《小芽》。"}, {"type": "subtitle", "time": 10530.429, "timestamp": "02:55:30", "text": "是的。"}, {"type": "subtitle", "time": 10545.95, "timestamp": "02:55:45", "text": "它發出的聲音非常大。"}, {"type": "subtitle", "time": 10547.229, "timestamp": "02:55:47", "text": "嗯，"}, {"type": "subtitle", "time": 10551.95, "timestamp": "02:55:51", "text": "就這些嗎？快樂。"}, {"type": "subtitle", "time": 10552.63, "timestamp": "02:55:52", "text": "是的。"}, {"type": "subtitle", "time": 10553.79, "timestamp": "02:55:53", "text": "哦，它不見了。好的。"}, {"type": "subtitle", "time": 10555.269, "timestamp": "02:55:55", "text": "他們總是會在我需要的時候伸出援手。"}]
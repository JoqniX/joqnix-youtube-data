[{"type": "subtitle", "time": 17640.11, "timestamp": "04:54:00", "text": "致運輸團隊的成員們。"}, {"type": "subtitle", "time": 17642.03, "timestamp": "04:54:02", "text": "嗯，材料"}, {"type": "subtitle", "time": 17642.628, "timestamp": "04:54:02", "text": "這可能還不夠。"}, {"type": "subtitle", "time": 17644.23, "timestamp": "04:54:04", "text": "哦，好的。"}, {"type": "subtitle", "time": 17649.59, "timestamp": "04:54:09", "text": "然後還有原料和燃料，我想。"}, {"type": "subtitle", "time": 17651.91, "timestamp": "04:54:11", "text": "我同意。砰砰"}, {"type": "subtitle", "time": 17653.708, "timestamp": "04:54:13", "text": "我帶來了燃料。"}, {"type": "subtitle", "time": 17655.75, "timestamp": "04:54:15", "text": "哦，謝謝。謝謝。"}, {"type": "subtitle", "time": 17656.75, "timestamp": "04:54:16", "text": "是的。"}, {"type": "subtitle", "time": 17657.868, "timestamp": "04:54:17", "text": "啊，超級派"}, {"type": "subtitle", "time": 17660.23, "timestamp": "04:54:20", "text": "好的。"}, {"type": "subtitle", "time": 17660.83, "timestamp": "04:54:20", "text": "啊，等等，"}, {"type": "subtitle", "time": 17665.03, "timestamp": "04:54:25", "text": "我還有這2個"}, {"type": "subtitle", "time": 17668.51, "timestamp": "04:54:28", "text": "是的，"}, {"type": "subtitle", "time": 17669.07, "timestamp": "04:54:29", "text": "我會回來的。"}, {"type": "subtitle", "time": 17670.39, "timestamp": "04:54:30", "text": "我又做了一個鑽頭。"}, {"type": "subtitle", "time": 17671.47, "timestamp": "04:54:31", "text": "我鑽完了孔。是的。"}, {"type": "subtitle", "time": 17673.75, "timestamp": "04:54:33", "text": "哦哦哦。"}, {"type": "subtitle", "time": 17674.83, "timestamp": "04:54:34", "text": "下雨了。"}, {"type": "subtitle", "time": 17677.47, "timestamp": "04:54:37", "text": "該死。"}, {"type": "subtitle", "time": 17679.39, "timestamp": "04:54:39", "text": "我想知道它在哪裡。"}, {"type": "subtitle", "time": 17681.75, "timestamp": "04:54:41", "text": "但我猜它終究還是紅色的。"}, {"type": "subtitle", "time": 17693.23, "timestamp": "04:54:53", "text": "一個，"}]
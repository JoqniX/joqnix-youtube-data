[{"type": "subtitle", "time": 8586.71, "timestamp": "02:23:06", "text": "6."}, {"type": "subtitle", "time": 8586.83, "timestamp": "02:23:06", "text": "1"}, {"type": "subtitle", "time": 8588.83, "timestamp": "02:23:08", "text": "只有一個小隊，是嗎？它能容納多少人？"}, {"type": "subtitle", "time": 8594.79, "timestamp": "02:23:14", "text": "32."}, {"type": "subtitle", "time": 8597.619, "timestamp": "02:23:17", "text": "真的嗎？等等，這是戰地！"}, {"type": "subtitle", "time": 8598.11, "timestamp": "02:23:18", "text": "[笑] 1"}, {"type": "subtitle", "time": 8600.87, "timestamp": "02:23:20", "text": "所有32名成員都能融入球隊。"}, {"type": "subtitle", "time": 8609.11, "timestamp": "02:23:29", "text": "如果你在第一軍，那就差不多就是這樣了。"}, {"type": "subtitle", "time": 8609.67, "timestamp": "02:23:29", "text": "1人"}, {"type": "subtitle", "time": 8611.71, "timestamp": "02:23:31", "text": "什麼樣的團隊？一支隊伍。"}, {"type": "subtitle", "time": 8612.15, "timestamp": "02:23:32", "text": "哦真的嗎？"}, {"type": "subtitle", "time": 8617.349, "timestamp": "02:23:37", "text": "大概有33個人。"}, {"type": "subtitle", "time": 8619.07, "timestamp": "02:23:39", "text": "32是不是有點太多了？ （一人份）"}, {"type": "subtitle", "time": 8620.75, "timestamp": "02:23:40", "text": "我聽說他32歲了。"}, {"type": "subtitle", "time": 8621.854, "timestamp": "02:23:41", "text": "只有人。"}, {"type": "subtitle", "time": 8622.55, "timestamp": "02:23:42", "text": "[笑聲]"}, {"type": "subtitle", "time": 8625.23, "timestamp": "02:23:45", "text": "不掛。"}]
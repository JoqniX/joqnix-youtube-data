[{"type": "subtitle", "time": 19389.03, "timestamp": "05:23:09", "text": "我去。"}, {"type": "subtitle", "time": 19391.03, "timestamp": "05:23:11", "text": "我帶上帕拉舒塔以防萬一。"}, {"type": "subtitle", "time": 19393.788, "timestamp": "05:23:13", "text": "豬。"}, {"type": "subtitle", "time": 19406.27, "timestamp": "05:23:26", "text": "O Park"}, {"type": "subtitle", "time": 19406.83, "timestamp": "05:23:26", "text": "F"}, {"type": "subtitle", "time": 19413.15, "timestamp": "05:23:33", "text": "是的"}, {"type": "subtitle", "time": 19418.43, "timestamp": "05:23:38", "text": "馬克是這麼說的。"}, {"type": "subtitle", "time": 19420.31, "timestamp": "05:23:40", "text": "哦。"}, {"type": "subtitle", "time": 19423.03, "timestamp": "05:23:43", "text": "哦真的嗎？看來我們把它摧毀是件好事。"}, {"type": "subtitle", "time": 19424.15, "timestamp": "05:23:44", "text": "我同意。"}, {"type": "subtitle", "time": 19425.19, "timestamp": "05:23:45", "text": "是的。"}, {"type": "subtitle", "time": 19431.548, "timestamp": "05:23:51", "text": "我這就來。你們塔"}, {"type": "subtitle", "time": 19432.83, "timestamp": "05:23:52", "text": "2"}, {"type": "subtitle", "time": 19437.83, "timestamp": "05:23:57", "text": "是的。我即將開始為特種部隊工作。"}, {"type": "subtitle", "time": 19439.31, "timestamp": "05:23:59", "text": "我們正在著陸。"}]
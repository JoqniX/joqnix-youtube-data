[{"type": "subtitle", "time": 18361.19, "timestamp": "05:06:01", "text": "不，不，或許我們應該把它清理乾淨。"}, {"type": "subtitle", "time": 18379.07, "timestamp": "05:06:19", "text": "是的。"}, {"type": "subtitle", "time": 18383.948, "timestamp": "05:06:23", "text": "我懂了。"}, {"type": "subtitle", "time": 18404.31, "timestamp": "05:06:44", "text": "現在去太難了嗎？"}, {"type": "subtitle", "time": 18407.19, "timestamp": "05:06:47", "text": "你怎麼認為？你知道，我可以勝任門衛的工作。"}, {"type": "subtitle", "time": 18410.75, "timestamp": "05:06:50", "text": "哦真的嗎？我馬上打開。"}, {"type": "subtitle", "time": 18415.39, "timestamp": "05:06:55", "text": "我會復活。"}]
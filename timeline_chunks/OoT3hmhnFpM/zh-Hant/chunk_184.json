[{"type": "subtitle", "time": 11050.75, "timestamp": "03:04:10", "text": "[嘆]"}, {"type": "subtitle", "time": 11052.389, "timestamp": "03:04:12", "text": "你還在屋頂上嗎？"}, {"type": "subtitle", "time": 11055.309, "timestamp": "03:04:15", "text": "看起來他們就在那裡。他們還在這裡。"}, {"type": "subtitle", "time": 11057.11, "timestamp": "03:04:17", "text": "看起來他們就在那裡。"}, {"type": "subtitle", "time": 11059.11, "timestamp": "03:04:19", "text": "他們可能還會回來。"}, {"type": "subtitle", "time": 11064.07, "timestamp": "03:04:24", "text": "這很明顯，不是嗎？ 9"}, {"type": "subtitle", "time": 11066.83, "timestamp": "03:04:26", "text": "以那種姿勢降落在屋頂上肯定很困難，對吧？"}, {"type": "subtitle", "time": 11067.75, "timestamp": "03:04:27", "text": "是的。"}, {"type": "subtitle", "time": 11079.309, "timestamp": "03:04:39", "text": "圖片，"}, {"type": "subtitle", "time": 11081.71, "timestamp": "03:04:41", "text": "有人想再來一次嗎？ [笑]"}, {"type": "subtitle", "time": 11082.99, "timestamp": "03:04:42", "text": "我上去了。"}, {"type": "subtitle", "time": 11083.99, "timestamp": "03:04:43", "text": "不，第三次比第二次好。"}, {"type": "subtitle", "time": 11086.03, "timestamp": "03:04:46", "text": "我相信第二次我會做得更好。"}, {"type": "subtitle", "time": 11088.99, "timestamp": "03:04:48", "text": "哦，是在屋頂上嗎？那裡一個人也沒有。我剛下車。後退，"}, {"type": "subtitle", "time": 11090.15, "timestamp": "03:04:50", "text": "哦，不在那裡，不在那裡。"}, {"type": "subtitle", "time": 11094.429, "timestamp": "03:04:54", "text": "這是。我在屋頂上。"}, {"type": "subtitle", "time": 11095.83, "timestamp": "03:04:55", "text": "哦哦哦。哦，那很好。"}, {"type": "subtitle", "time": 11096.429, "timestamp": "03:04:56", "text": "不，是我買的。"}, {"type": "subtitle", "time": 11098.99, "timestamp": "03:04:58", "text": "。出色地，"}]
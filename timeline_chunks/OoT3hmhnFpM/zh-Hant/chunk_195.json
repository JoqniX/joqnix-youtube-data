[{"type": "subtitle", "time": 11726.11, "timestamp": "03:15:26", "text": "南，"}, {"type": "subtitle", "time": 11727.469, "timestamp": "03:15:27", "text": "南側看起來情況危急。哦"}, {"type": "subtitle", "time": 11729.83, "timestamp": "03:15:29", "text": "嗯，那扇門有點損壞。"}, {"type": "subtitle", "time": 11737.309, "timestamp": "03:15:37", "text": "我永遠不會原諒他們。"}, {"type": "subtitle", "time": 11738.87, "timestamp": "03:15:38", "text": "好的。"}, {"type": "subtitle", "time": 11739.87, "timestamp": "03:15:39", "text": "是的，"}, {"type": "subtitle", "time": 11740.189, "timestamp": "03:15:40", "text": "在後面"}, {"type": "subtitle", "time": 11747.91, "timestamp": "03:15:47", "text": "千桑，這邊，嗯，"}, {"type": "subtitle", "time": 11751.03, "timestamp": "03:15:51", "text": "這取決於網路狀況。好的。好的。"}]
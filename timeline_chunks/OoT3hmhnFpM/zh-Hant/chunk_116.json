[{"type": "subtitle", "time": 6962.03, "timestamp": "01:56:02", "text": "對不起，"}, {"type": "subtitle", "time": 6963.75, "timestamp": "01:56:03", "text": "哦，它沒有傷及任何盟國。"}, {"type": "subtitle", "time": 6965.47, "timestamp": "01:56:05", "text": "是545。"}, {"type": "subtitle", "time": 6968.03, "timestamp": "01:56:08", "text": "是的。大概就是那麼多。謝謝。"}, {"type": "subtitle", "time": 6975.95, "timestamp": "01:56:15", "text": "啊，小可會收下的。"}, {"type": "subtitle", "time": 6981.669, "timestamp": "01:56:21", "text": "嗯，"}, {"type": "subtitle", "time": 6983.79, "timestamp": "01:56:23", "text": "那裡有什麼？"}, {"type": "subtitle", "time": 6989.35, "timestamp": "01:56:29", "text": "啊，嗯，呃，那，那，那，那是迫擊砲襲擊。"}, {"type": "subtitle", "time": 6990.069, "timestamp": "01:56:30", "text": "出色地，"}, {"type": "subtitle", "time": 6990.629, "timestamp": "01:56:30", "text": "在哪裡？唔。"}, {"type": "subtitle", "time": 6992.87, "timestamp": "01:56:32", "text": "在塔的右側。"}, {"type": "subtitle", "time": 6998.709, "timestamp": "01:56:38", "text": "有兩個。"}, {"type": "subtitle", "time": 7000.91, "timestamp": "01:56:40", "text": "是的。是的。讓我們摧毀它。"}, {"type": "subtitle", "time": 7003.709, "timestamp": "01:56:43", "text": "是的。我們把它摧毀吧。是的。"}, {"type": "subtitle", "time": 7004.91, "timestamp": "01:56:44", "text": "就在這附近。"}]
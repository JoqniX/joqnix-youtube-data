[{"type": "subtitle", "time": 8880.51, "timestamp": "02:28:00", "text": "啊，那很可能就是那個人了。"}, {"type": "subtitle", "time": 8882.55, "timestamp": "02:28:02", "text": "他們似乎沒有使用Discord。"}, {"type": "subtitle", "time": 8883.349, "timestamp": "02:28:03", "text": "哦真的嗎？嗯，"}, {"type": "subtitle", "time": 8885.67, "timestamp": "02:28:05", "text": "我之前已經把Discord的相關資訊傳給你了。"}, {"type": "subtitle", "time": 8891.03, "timestamp": "02:28:11", "text": "我會問這件事。"}, {"type": "subtitle", "time": 8892.23, "timestamp": "02:28:12", "text": "喲。"}, {"type": "subtitle", "time": 8893.309, "timestamp": "02:28:13", "text": "謝謝。"}, {"type": "subtitle", "time": 8896.99, "timestamp": "02:28:16", "text": "我們走吧。我們走吧。"}, {"type": "subtitle", "time": 8911.11, "timestamp": "02:28:31", "text": "我們一起去那裡，搭了別人的車。"}, {"type": "subtitle", "time": 8913.63, "timestamp": "02:28:33", "text": "是的。是的。是的。是的。"}, {"type": "subtitle", "time": 8921.55, "timestamp": "02:28:41", "text": "三架直升機"}, {"type": "subtitle", "time": 8923.91, "timestamp": "02:28:43", "text": "因為人太多，現場有點混亂。"}, {"type": "subtitle", "time": 8925.19, "timestamp": "02:28:45", "text": "但無論如何，3"}, {"type": "subtitle", "time": 8931.15, "timestamp": "02:28:51", "text": "讓我們賣掉大量的物​​資。"}]
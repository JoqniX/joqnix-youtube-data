[{"type": "subtitle", "time": 10020.03, "timestamp": "02:47:00", "text": "哦，謝謝。"}, {"type": "subtitle", "time": 10030.71, "timestamp": "02:47:10", "text": "但我及時趕到了嗎？"}, {"type": "subtitle", "time": 10031.03, "timestamp": "02:47:11", "text": "正確的。"}, {"type": "subtitle", "time": 10032.75, "timestamp": "02:47:12", "text": "不，等等。我認為它們是存在的。"}, {"type": "subtitle", "time": 10044.99, "timestamp": "02:47:24", "text": "怎麼樣？"}, {"type": "subtitle", "time": 10052.67, "timestamp": "02:47:32", "text": "那看來就沒問題了。"}, {"type": "subtitle", "time": 10056.269, "timestamp": "02:47:36", "text": "是的。"}, {"type": "subtitle", "time": 10067.79, "timestamp": "02:47:47", "text": "啊，我明白了。"}, {"type": "subtitle", "time": 10072.63, "timestamp": "02:47:52", "text": "我懂了。"}]
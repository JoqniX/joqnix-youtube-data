[{"type": "subtitle", "time": 8941.23, "timestamp": "02:29:01", "text": "啊，喬"}, {"type": "subtitle", "time": 8960.03, "timestamp": "02:29:20", "text": "嗯？這話是不是有點委婉？"}, {"type": "subtitle", "time": 8967.91, "timestamp": "02:29:27", "text": "是 Jock Jock 嗎？好的。"}, {"type": "subtitle", "time": 8968.15, "timestamp": "02:29:28", "text": "是的。"}, {"type": "subtitle", "time": 8970.349, "timestamp": "02:29:30", "text": "請享用這道菜。"}, {"type": "subtitle", "time": 8970.67, "timestamp": "02:29:30", "text": "很高興見到你。"}, {"type": "subtitle", "time": 8972.99, "timestamp": "02:29:32", "text": "Jock是個女孩。"}, {"type": "subtitle", "time": 8983.91, "timestamp": "02:29:43", "text": "驚人的。就像《阿爾卑斯山的少女海蒂》。"}, {"type": "subtitle", "time": 8985.07, "timestamp": "02:29:45", "text": "塞薩，"}, {"type": "subtitle", "time": 8986.63, "timestamp": "02:29:46", "text": "阿爾卑斯山的少女。"}, {"type": "subtitle", "time": 8987.71, "timestamp": "02:29:47", "text": "阿爾卑斯山就在那裡。"}, {"type": "subtitle", "time": 8990.63, "timestamp": "02:29:50", "text": "這不是一場高山滑雪比賽。"}, {"type": "subtitle", "time": 8991.95, "timestamp": "02:29:51", "text": "匹配。"}, {"type": "subtitle", "time": 8993.91, "timestamp": "02:29:53", "text": "圖片，"}, {"type": "subtitle", "time": 8996.469, "timestamp": "02:29:56", "text": "男子氣概，火柴人之類的。"}, {"type": "subtitle", "time": 8996.91, "timestamp": "02:29:56", "text": "這是正確的。"}, {"type": "subtitle", "time": 8999.67, "timestamp": "02:29:59", "text": "我把大鐵鎚放進臉書了。 1 件"}]
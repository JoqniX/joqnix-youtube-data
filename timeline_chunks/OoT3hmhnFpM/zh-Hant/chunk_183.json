[{"type": "subtitle", "time": 10985.71, "timestamp": "03:03:05", "text": "是的。他們正在拉鑽機。盟國。"}, {"type": "subtitle", "time": 10992.63, "timestamp": "03:03:12", "text": "不，嗯，我在塔底。"}, {"type": "subtitle", "time": 10994.59, "timestamp": "03:03:14", "text": "哦，駭客攻擊。"}, {"type": "subtitle", "time": 11004.83, "timestamp": "03:03:24", "text": "[笑聲]"}, {"type": "subtitle", "time": 11007.59, "timestamp": "03:03:27", "text": "我真希望自己也能看到。"}, {"type": "subtitle", "time": 11010.15, "timestamp": "03:03:30", "text": "不，但是獲得屋頂空間是一件大事。"}, {"type": "subtitle", "time": 11014.229, "timestamp": "03:03:34", "text": "[笑聲]"}, {"type": "subtitle", "time": 11019.11, "timestamp": "03:03:39", "text": "謝謝。"}, {"type": "subtitle", "time": 11025.269, "timestamp": "03:03:45", "text": "是的，他們是。"}, {"type": "subtitle", "time": 11026.63, "timestamp": "03:03:46", "text": "哦，也許我也會坐直升機去。"}, {"type": "subtitle", "time": 11027.95, "timestamp": "03:03:47", "text": "鬼。"}, {"type": "subtitle", "time": 11029.83, "timestamp": "03:03:49", "text": "哦，我該吃麥當勞嗎？"}, {"type": "subtitle", "time": 11030.75, "timestamp": "03:03:50", "text": "我們再去一次嗎？"}]
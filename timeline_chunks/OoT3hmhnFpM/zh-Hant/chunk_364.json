[{"type": "subtitle", "time": 21840.31, "timestamp": "06:04:00", "text": "對於一個10人伺服器來說，波次計數"}, {"type": "subtitle", "time": 21842.15, "timestamp": "06:04:02", "text": "1號呢？"}, {"type": "subtitle", "time": 21842.75, "timestamp": "06:04:02", "text": "說到這裡…"}, {"type": "subtitle", "time": 21845.15, "timestamp": "06:04:05", "text": "我一直都這麼認為。"}, {"type": "subtitle", "time": 21848.788, "timestamp": "06:04:08", "text": "是33到33到34。或許吧。"}, {"type": "subtitle", "time": 21850.31, "timestamp": "06:04:10", "text": "我不會買。"}, {"type": "subtitle", "time": 21852.23, "timestamp": "06:04:12", "text": "真的有那麼糟嗎？馬，"}, {"type": "subtitle", "time": 21854.27, "timestamp": "06:04:14", "text": "是的。哦，他死了。"}, {"type": "subtitle", "time": 21859.708, "timestamp": "06:04:19", "text": "大家都會回來嗎？他們應該已經回來了。"}, {"type": "subtitle", "time": 21860.51, "timestamp": "06:04:20", "text": "是的。"}, {"type": "subtitle", "time": 21866.03, "timestamp": "06:04:26", "text": "我們走吧。高山"}, {"type": "subtitle", "time": 21867.27, "timestamp": "06:04:27", "text": "是的。我會更新它。"}, {"type": "subtitle", "time": 21868.23, "timestamp": "06:04:28", "text": "更新。"}, {"type": "subtitle", "time": 21873.43, "timestamp": "06:04:33", "text": "30歲以下玩家最多的伺服器是3007伺服器。"}, {"type": "subtitle", "time": 21874.708, "timestamp": "06:04:34", "text": "317."}, {"type": "subtitle", "time": 21880.35, "timestamp": "06:04:40", "text": "這意味著，加上我們的加入，總數將達到36。"}, {"type": "subtitle", "time": 21881.35, "timestamp": "06:04:41", "text": "因為你變成了一個人"}, {"type": "subtitle", "time": 21882.948, "timestamp": "06:04:42", "text": "它們會長得很快，對吧？"}, {"type": "subtitle", "time": 21886.99, "timestamp": "06:04:46", "text": "是的。所有人，317。"}, {"type": "subtitle", "time": 21889.548, "timestamp": "06:04:49", "text": "317317。"}, {"type": "subtitle", "time": 21891.708, "timestamp": "06:04:51", "text": "我可以去任何地方。這"}, {"type": "subtitle", "time": 21893.468, "timestamp": "06:04:53", "text": "哦。科桑，這事就交給你了。"}]
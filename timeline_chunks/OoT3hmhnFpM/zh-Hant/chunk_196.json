[{"type": "subtitle", "time": 11760.55, "timestamp": "03:16:00", "text": "讓我們全力以赴。"}, {"type": "subtitle", "time": 11769.82, "timestamp": "03:16:09", "text": "眼睛。這裡太擁擠了。"}, {"type": "subtitle", "time": 11770.95, "timestamp": "03:16:10", "text": "[笑聲]"}, {"type": "subtitle", "time": 11771.67, "timestamp": "03:16:11", "text": "太瘋狂了，對吧？"}, {"type": "subtitle", "time": 11775.429, "timestamp": "03:16:15", "text": "我想殺23個人。我也殺了兩個人。"}, {"type": "subtitle", "time": 11777.75, "timestamp": "03:16:17", "text": "他們蜂擁而至。這片森林"}, {"type": "subtitle", "time": 11782.67, "timestamp": "03:16:22", "text": "洞，"}, {"type": "subtitle", "time": 11785.11, "timestamp": "03:16:25", "text": "我們從這裡開始吧？"}, {"type": "subtitle", "time": 11785.83, "timestamp": "03:16:25", "text": "哦，謝謝。"}, {"type": "subtitle", "time": 11787.63, "timestamp": "03:16:27", "text": "O Park"}, {"type": "subtitle", "time": 11789.189, "timestamp": "03:16:29", "text": "敵軍已佔領基地。"}, {"type": "subtitle", "time": 11808.269, "timestamp": "03:16:48", "text": "待在那裡。"}, {"type": "subtitle", "time": 11810.87, "timestamp": "03:16:50", "text": "哇，這並不奇怪。"}, {"type": "subtitle", "time": 11813.189, "timestamp": "03:16:53", "text": "我要把他們全殺了。"}, {"type": "subtitle", "time": 11818.79, "timestamp": "03:16:58", "text": "哦，他們來了。不再，不再"}]
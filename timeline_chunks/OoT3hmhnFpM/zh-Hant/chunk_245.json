[{"type": "subtitle", "time": 14700.51, "timestamp": "04:05:00", "text": "我動力十足。我"}, {"type": "subtitle", "time": 14703.229, "timestamp": "04:05:03", "text": "我動力十足。"}, {"type": "subtitle", "time": 14705.95, "timestamp": "04:05:05", "text": "我無法原諒這件事。"}, {"type": "subtitle", "time": 14707.75, "timestamp": "04:05:07", "text": "我是第一名嗎？"}, {"type": "subtitle", "time": 14708.75, "timestamp": "04:05:08", "text": "他們已經趕上了。"}, {"type": "subtitle", "time": 14712.83, "timestamp": "04:05:12", "text": "好的。"}, {"type": "subtitle", "time": 14715.389, "timestamp": "04:05:15", "text": "它們差不多。但我正在關注。"}, {"type": "subtitle", "time": 14717.63, "timestamp": "04:05:17", "text": "請再找一個人，再帶一個人過來。已經"}, {"type": "subtitle", "time": 14719.59, "timestamp": "04:05:19", "text": "如果再得一分，你就可以拿藍色卡牌。"}, {"type": "subtitle", "time": 14720.469, "timestamp": "04:05:20", "text": "是的，又一個人，又一個人。"}, {"type": "subtitle", "time": 14728.03, "timestamp": "04:05:28", "text": "一切順利，一切順利。"}, {"type": "subtitle", "time": 14728.63, "timestamp": "04:05:28", "text": "這是 1"}, {"type": "subtitle", "time": 14731.51, "timestamp": "04:05:31", "text": "我們必須盡快結束這一回合。"}, {"type": "subtitle", "time": 14738.07, "timestamp": "04:05:38", "text": "哦，門已經修好了。"}, {"type": "subtitle", "time": 14750.349, "timestamp": "04:05:50", "text": "所以，裡面還有東西嗎？"}, {"type": "subtitle", "time": 14759.429, "timestamp": "04:05:59", "text": "謝謝。"}]
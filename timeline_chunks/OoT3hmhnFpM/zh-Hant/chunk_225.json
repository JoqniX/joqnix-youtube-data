[{"type": "subtitle", "time": 13512.189, "timestamp": "03:45:12", "text": "我來發射迫擊砲。哦，交給我吧。"}, {"type": "subtitle", "time": 13514.149, "timestamp": "03:45:14", "text": "哦，好的。我願意做。我願意做。"}, {"type": "subtitle", "time": 13516.149, "timestamp": "03:45:16", "text": "我無法原諒這件事。我無法原諒這件事。"}, {"type": "subtitle", "time": 13517.99, "timestamp": "03:45:17", "text": "強度核心"}, {"type": "subtitle", "time": 13518.99, "timestamp": "03:45:18", "text": "高速"}, {"type": "subtitle", "time": 13520.63, "timestamp": "03:45:20", "text": "製作鑽頭。"}, {"type": "subtitle", "time": 13521.95, "timestamp": "03:45:21", "text": "是的。就交給你了。"}, {"type": "subtitle", "time": 13540.349, "timestamp": "03:45:40", "text": "至少會有三個人做這件事。"}, {"type": "subtitle", "time": 13548.429, "timestamp": "03:45:48", "text": "我給你做一個。"}, {"type": "subtitle", "time": 13548.67, "timestamp": "03:45:48", "text": "2"}, {"type": "subtitle", "time": 13550.309, "timestamp": "03:45:50", "text": "我認為自己製作沒問題。"}, {"type": "subtitle", "time": 13552.67, "timestamp": "03:45:52", "text": "辦公室。"}, {"type": "subtitle", "time": 13554.51, "timestamp": "03:45:54", "text": "這麼多人，大概"}, {"type": "subtitle", "time": 13557.309, "timestamp": "03:45:57", "text": "總是有人會這麼做的。"}]
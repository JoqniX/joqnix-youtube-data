[{"type": "subtitle", "time": 8101.91, "timestamp": "02:15:01", "text": "這是正確的。它在這裡。"}, {"type": "subtitle", "time": 8110.51, "timestamp": "02:15:10", "text": "我想我會帶一個燃料托盤。"}, {"type": "subtitle", "time": 8113.39, "timestamp": "02:15:13", "text": "他去世了。"}, {"type": "subtitle", "time": 8128.87, "timestamp": "02:15:28", "text": "謝謝。"}, {"type": "subtitle", "time": 8147.91, "timestamp": "02:15:47", "text": "那是我的，我的地盤，你"}, {"type": "subtitle", "time": 8149.549, "timestamp": "02:15:49", "text": "O Park"}, {"type": "subtitle", "time": 8153.39, "timestamp": "02:15:53", "text": "聲音"}]
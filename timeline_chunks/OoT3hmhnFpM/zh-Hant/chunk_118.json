[{"type": "subtitle", "time": 7085.83, "timestamp": "01:58:05", "text": "啊，就是那東西。我將使用Merikit。"}, {"type": "subtitle", "time": 7094.376, "timestamp": "01:58:14", "text": "經歷讓我失去了很多。"}, {"type": "subtitle", "time": 7102.47, "timestamp": "01:58:22", "text": "我們就在這裡建吧。"}, {"type": "subtitle", "time": 7110.149, "timestamp": "01:58:30", "text": "我應該繼續以1號塔為目標嗎？"}, {"type": "subtitle", "time": 7111.03, "timestamp": "01:58:31", "text": "1號塔"}, {"type": "subtitle", "time": 7113.31, "timestamp": "01:58:33", "text": "或許我們也該把旁邊的門拆掉。"}, {"type": "subtitle", "time": 7115.47, "timestamp": "01:58:35", "text": "哦，那很好，那很好，那很好。那就這麼做吧。什麼"}, {"type": "subtitle", "time": 7120.35, "timestamp": "01:58:40", "text": "感覺哪裡不太對勁。"}, {"type": "subtitle", "time": 7122.669, "timestamp": "01:58:42", "text": "那個地方看起來有點危險。"}, {"type": "subtitle", "time": 7135.87, "timestamp": "01:58:55", "text": "好的。"}, {"type": "subtitle", "time": 7136.709, "timestamp": "01:58:56", "text": "我做到了。現在"}, {"type": "subtitle", "time": 7137.99, "timestamp": "01:58:57", "text": "那很好。"}, {"type": "subtitle", "time": 7139.709, "timestamp": "01:58:59", "text": "一切都變了。"}]
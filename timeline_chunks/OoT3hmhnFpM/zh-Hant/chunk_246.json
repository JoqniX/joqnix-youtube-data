[{"type": "subtitle", "time": 14772.79, "timestamp": "04:06:12", "text": "啊，我明白了。"}, {"type": "subtitle", "time": 14774.59, "timestamp": "04:06:14", "text": "那是燈塔嗎？"}, {"type": "subtitle", "time": 14777.55, "timestamp": "04:06:17", "text": "所以維克魯達號被摧毀了？"}, {"type": "subtitle", "time": 14780.149, "timestamp": "04:06:20", "text": "啊，那它就需要修理了。嘿。"}, {"type": "subtitle", "time": 14781.189, "timestamp": "04:06:21", "text": "Wi-Rise。"}, {"type": "subtitle", "time": 14798.389, "timestamp": "04:06:38", "text": "太瘋狂了。哇，太棒了。"}, {"type": "subtitle", "time": 14799.67, "timestamp": "04:06:39", "text": "我聽到了他說的話。"}, {"type": "subtitle", "time": 14801.51, "timestamp": "04:06:41", "text": "嘿。"}, {"type": "subtitle", "time": 14809.469, "timestamp": "04:06:49", "text": "啊，這個"}]
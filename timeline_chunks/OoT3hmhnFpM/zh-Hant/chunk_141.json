[{"type": "subtitle", "time": 8466.07, "timestamp": "02:21:06", "text": "我們稍後也會做這件事。"}, {"type": "subtitle", "time": 8466.87, "timestamp": "02:21:06", "text": "是的。誰也進不去。"}, {"type": "subtitle", "time": 8468.71, "timestamp": "02:21:08", "text": "我們計劃加入一把亞洲劍。"}, {"type": "subtitle", "time": 8470.399, "timestamp": "02:21:10", "text": "亞洲劍。 他們前幾天來過。"}, {"type": "subtitle", "time": 8471.56, "timestamp": "02:21:11", "text": "他們前幾天來過。 是的，是的，是的。難的"}, {"type": "subtitle", "time": 8472.439, "timestamp": "02:21:12", "text": "是的，是的，是的。難的 科亞。這是正確的。嗯，是S嗎？"}, {"type": "subtitle", "time": 8477.83, "timestamp": "02:21:17", "text": "是的。完全沒問題。"}, {"type": "subtitle", "time": 8480.07, "timestamp": "02:21:20", "text": "現在我們可以先不進行串流媒體播放嗎？"}, {"type": "subtitle", "time": 8481.389, "timestamp": "02:21:21", "text": "哦，那完全沒問題。完全沒問題。"}, {"type": "subtitle", "time": 8488.91, "timestamp": "02:21:28", "text": "是的。"}, {"type": "subtitle", "time": 8493.469, "timestamp": "02:21:33", "text": "大家對廁所的狀況都滿意嗎？"}, {"type": "subtitle", "time": 8499.63, "timestamp": "02:21:39", "text": "嗯，廁所沒問題，但是…"}, {"type": "subtitle", "time": 8501.389, "timestamp": "02:21:41", "text": "我正在加載一些東西。"}]
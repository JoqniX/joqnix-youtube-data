[{"type": "subtitle", "time": 17703.708, "timestamp": "04:55:03", "text": "啊。"}, {"type": "subtitle", "time": 17705.31, "timestamp": "04:55:05", "text": "啊，我這就激活它。"}, {"type": "subtitle", "time": 17707.51, "timestamp": "04:55:07", "text": "哦，我放了一點進去。哦。"}, {"type": "subtitle", "time": 17710.11, "timestamp": "04:55:10", "text": "哦，不錯。"}, {"type": "subtitle", "time": 17737.23, "timestamp": "04:55:37", "text": "650"}, {"type": "subtitle", "time": 17738.628, "timestamp": "04:55:38", "text": "我想這是唯一的辦法了。"}, {"type": "subtitle", "time": 17740.19, "timestamp": "04:55:40", "text": "哦，但這豈不是說附近的守衛就在那裡？"}, {"type": "subtitle", "time": 17742.35, "timestamp": "04:55:42", "text": "他們會包含一個，所以總共是 1800。"}, {"type": "subtitle", "time": 17742.91, "timestamp": "04:55:42", "text": "哦真的嗎？"}, {"type": "subtitle", "time": 17744.15, "timestamp": "04:55:44", "text": "將增加1800。"}, {"type": "subtitle", "time": 17746.788, "timestamp": "04:55:46", "text": "好的。"}, {"type": "subtitle", "time": 17758.39, "timestamp": "04:55:58", "text": "謝謝。"}]
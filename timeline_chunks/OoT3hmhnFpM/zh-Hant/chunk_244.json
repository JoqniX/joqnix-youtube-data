[{"type": "subtitle", "time": 14640.71, "timestamp": "04:04:00", "text": "啊，我明白了。"}, {"type": "subtitle", "time": 14641.79, "timestamp": "04:04:01", "text": "哦，謝謝。"}, {"type": "subtitle", "time": 14644.11, "timestamp": "04:04:04", "text": "為什麼是第一名？"}, {"type": "subtitle", "time": 14646.11, "timestamp": "04:04:06", "text": "啊，我明白了。"}, {"type": "subtitle", "time": 14662.189, "timestamp": "04:04:22", "text": "啊，我覺得還是放棄比較好。"}, {"type": "subtitle", "time": 14663.95, "timestamp": "04:04:23", "text": "哦，金錢！"}, {"type": "subtitle", "time": 14671.99, "timestamp": "04:04:31", "text": "哦，你說得對。他們變得非常富有。"}, {"type": "subtitle", "time": 14674.149, "timestamp": "04:04:34", "text": "超過100萬。"}, {"type": "subtitle", "time": 14675.63, "timestamp": "04:04:35", "text": "我現在正在兌換100萬。"}, {"type": "subtitle", "time": 14675.83, "timestamp": "04:04:35", "text": "醋，"}, {"type": "subtitle", "time": 14677.389, "timestamp": "04:04:37", "text": "嗯，其實也沒那麼多。"}, {"type": "subtitle", "time": 14680.309, "timestamp": "04:04:40", "text": "我賺了10萬日元。"}, {"type": "subtitle", "time": 14687.269, "timestamp": "04:04:47", "text": "讓我們一起祈禱。"}, {"type": "subtitle", "time": 14687.79, "timestamp": "04:04:47", "text": "你還好嗎？"}, {"type": "subtitle", "time": 14689.469, "timestamp": "04:04:49", "text": "洛夫漢姆。"}, {"type": "subtitle", "time": 14698.79, "timestamp": "04:04:58", "text": "打擾一下。"}, {"type": "subtitle", "time": 14699.189, "timestamp": "04:04:59", "text": "是的。"}]
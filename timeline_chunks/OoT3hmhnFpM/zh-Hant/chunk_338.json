[{"type": "subtitle", "time": 20280.868, "timestamp": "05:38:00", "text": "[笑聲]"}, {"type": "subtitle", "time": 20281.15, "timestamp": "05:38:01", "text": "啊，1"}, {"type": "subtitle", "time": 20283.868, "timestamp": "05:38:03", "text": "這裡有人穿著很暴露，但我不知道他是誰。"}, {"type": "subtitle", "time": 20285.27, "timestamp": "05:38:05", "text": "哦，當然。"}, {"type": "subtitle", "time": 20288.194, "timestamp": "05:38:08", "text": "穿著長袖襯衫之類的衣服的人。穿上你的盔甲。我想知道你是否了解這件事。"}, {"type": "subtitle", "time": 20303.23, "timestamp": "05:38:23", "text": "[笑聲]"}, {"type": "subtitle", "time": 20305.91, "timestamp": "05:38:25", "text": "Ihadasniper"}]
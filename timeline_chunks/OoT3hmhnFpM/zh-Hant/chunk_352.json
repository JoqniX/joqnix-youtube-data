[{"type": "subtitle", "time": 21120.83, "timestamp": "05:52:00", "text": "[笑聲]"}, {"type": "subtitle", "time": 21122.67, "timestamp": "05:52:02", "text": "那裡，那裡，那裡，那裡。"}, {"type": "subtitle", "time": 21123.75, "timestamp": "05:52:03", "text": "好，好，好，好，好，好，好"}, {"type": "subtitle", "time": 21124.548, "timestamp": "05:52:04", "text": "不錯，不錯。"}, {"type": "subtitle", "time": 21125.708, "timestamp": "05:52:05", "text": "還有，馬克。"}, {"type": "subtitle", "time": 21126.27, "timestamp": "05:52:06", "text": "標記。"}, {"type": "subtitle", "time": 21127.43, "timestamp": "05:52:07", "text": "等等，馬克也參演了？"}, {"type": "subtitle", "time": 21132.59, "timestamp": "05:52:12", "text": "啊，德爾蘇。"}, {"type": "subtitle", "time": 21140.11, "timestamp": "05:52:20", "text": "我們一共12個人，應該沒問題。"}, {"type": "subtitle", "time": 21142.91, "timestamp": "05:52:22", "text": "哦哦哦。好的。巨大的。"}, {"type": "subtitle", "time": 21145.11, "timestamp": "05:52:25", "text": "嗯？這裡只有我和我們兩個人。嚴重地？這"}, {"type": "subtitle", "time": 21145.868, "timestamp": "05:52:25", "text": "這是真的。"}, {"type": "subtitle", "time": 21148.11, "timestamp": "05:52:28", "text": "哦，但是這個數字還在增加。這個數字增加了。好的，好的。"}, {"type": "subtitle", "time": 21150.51, "timestamp": "05:52:30", "text": "哦，不錯。玩。"}, {"type": "subtitle", "time": 21156.15, "timestamp": "05:52:36", "text": "讓我下車。我們一起去郊遊吧。"}, {"type": "subtitle", "time": 21161.948, "timestamp": "05:52:41", "text": "每個人都能立刻做到，但是"}, {"type": "subtitle", "time": 21163.19, "timestamp": "05:52:43", "text": "其中一個人肯定是F"}, {"type": "subtitle", "time": 21164.67, "timestamp": "05:52:44", "text": "不應該立即去做嗎？"}, {"type": "subtitle", "time": 21166.35, "timestamp": "05:52:46", "text": "哦，彭基·德斯特里。"}, {"type": "subtitle", "time": 21168.99, "timestamp": "05:52:48", "text": "我懂了。"}]
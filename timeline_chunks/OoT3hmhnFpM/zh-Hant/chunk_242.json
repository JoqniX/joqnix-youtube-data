[{"type": "subtitle", "time": 14527.349, "timestamp": "04:02:07", "text": "而且，南側的一座城門被毀了。"}, {"type": "subtitle", "time": 14528.55, "timestamp": "04:02:08", "text": "嚴重地？"}, {"type": "subtitle", "time": 14530.83, "timestamp": "04:02:10", "text": "我有一把錘子。"}, {"type": "subtitle", "time": 14533.429, "timestamp": "04:02:13", "text": "哦，我也有一個。"}, {"type": "subtitle", "time": 14552.389, "timestamp": "04:02:32", "text": "奧拉克先生"}, {"type": "subtitle", "time": 14557.91, "timestamp": "04:02:37", "text": "他們來了。"}, {"type": "subtitle", "time": 14559.389, "timestamp": "04:02:39", "text": "大門之外"}, {"type": "subtitle", "time": 14564.87, "timestamp": "04:02:44", "text": "好的。請。"}, {"type": "subtitle", "time": 14577.429, "timestamp": "04:02:57", "text": "他們要來了，對吧？還沒有。"}]
[{"type": "subtitle", "time": 14344.229, "timestamp": "03:59:04", "text": "哎喲。"}, {"type": "subtitle", "time": 14346.55, "timestamp": "03:59:06", "text": "我懂了。"}, {"type": "subtitle", "time": 14352.51, "timestamp": "03:59:12", "text": "唔。所以你就在那裡建的？"}, {"type": "subtitle", "time": 14355.389, "timestamp": "03:59:15", "text": "啊，千桑，真好吃。好的。"}, {"type": "subtitle", "time": 14357.269, "timestamp": "03:59:17", "text": "嗯？ Happy還在天上看著我們嗎？"}, {"type": "subtitle", "time": 14358.469, "timestamp": "03:59:18", "text": "是的。"}, {"type": "subtitle", "time": 14360.75, "timestamp": "03:59:20", "text": "怎麼樣了？你在附近嗎？任何地方？"}, {"type": "subtitle", "time": 14366.59, "timestamp": "03:59:26", "text": "就這些嗎？你看到了嗎？"}, {"type": "subtitle", "time": 14367.87, "timestamp": "03:59:27", "text": "只有你們兩個人，對嗎？"}, {"type": "subtitle", "time": 14369.03, "timestamp": "03:59:29", "text": "是的。"}, {"type": "subtitle", "time": 14386.469, "timestamp": "03:59:46", "text": "從我所在的位置，我覺得看不到南側岩石後面的情況。"}, {"type": "subtitle", "time": 14389.79, "timestamp": "03:59:49", "text": "就這些嗎？該死。"}, {"type": "subtitle", "time": 14391.99, "timestamp": "03:59:51", "text": "呃，金潘先生現在已經過世了。"}, {"type": "subtitle", "time": 14392.95, "timestamp": "03:59:52", "text": "我們上了路。"}, {"type": "subtitle", "time": 14395.189, "timestamp": "03:59:55", "text": "完畢。娜"}, {"type": "subtitle", "time": 14396.309, "timestamp": "03:59:56", "text": "這是怎麼回事？他中槍了。"}, {"type": "subtitle", "time": 14398.269, "timestamp": "03:59:58", "text": "有人在嗎？"}]
[{"type": "subtitle", "time": 22725.868, "timestamp": "06:18:45", "text": "唔。"}, {"type": "subtitle", "time": 22728.11, "timestamp": "06:18:48", "text": "呃，我會晚點到。對不起。高山。"}, {"type": "subtitle", "time": 22728.67, "timestamp": "06:18:48", "text": "哦，當然。"}, {"type": "subtitle", "time": 22730.51, "timestamp": "06:18:50", "text": "我要騎馬克瓶。"}]
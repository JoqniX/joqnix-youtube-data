[{"type": "subtitle", "time": 22513.03, "timestamp": "06:15:13", "text": "但我總覺得我今天的勝率相當不錯。"}, {"type": "subtitle", "time": 22520.628, "timestamp": "06:15:20", "text": "哦，這麼說我錯了？"}, {"type": "subtitle", "time": 22523.35, "timestamp": "06:15:23", "text": "哦，那不是真的。嗯，我去三山的時候"}, {"type": "subtitle", "time": 22525.468, "timestamp": "06:15:25", "text": "我們贏過一次，對吧？"}, {"type": "subtitle", "time": 22526.354, "timestamp": "06:15:26", "text": "等等，不，不，不，不。莫桑"}, {"type": "subtitle", "time": 22535.19, "timestamp": "06:15:35", "text": "我當時也在場（笑）"}, {"type": "subtitle", "time": 22535.35, "timestamp": "06:15:35", "text": "1"}]
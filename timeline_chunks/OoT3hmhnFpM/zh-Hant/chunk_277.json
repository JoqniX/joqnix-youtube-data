[{"type": "subtitle", "time": 16620.629, "timestamp": "04:37:00", "text": "從"}, {"type": "subtitle", "time": 16622.709, "timestamp": "04:37:02", "text": "哦"}, {"type": "subtitle", "time": 16625.029, "timestamp": "04:37:05", "text": "謝謝，這簡直就像億萬富翁"}, {"type": "subtitle", "time": 16626.99, "timestamp": "04:37:06", "text": "請這樣擊打。"}, {"type": "subtitle", "time": 16635.23, "timestamp": "04:37:15", "text": "這"}, {"type": "subtitle", "time": 16642.23, "timestamp": "04:37:22", "text": "我本來打算成功的。太棒了。"}, {"type": "subtitle", "time": 16644.15, "timestamp": "04:37:24", "text": "好工作。"}, {"type": "subtitle", "time": 16670.83, "timestamp": "04:37:50", "text": "他們是一支很有能力的團隊。"}, {"type": "subtitle", "time": 16674.83, "timestamp": "04:37:54", "text": "是的。"}, {"type": "subtitle", "time": 16676.482, "timestamp": "04:37:56", "text": "他們是一支很棒的隊伍。"}, {"type": "subtitle", "time": 16677.59, "timestamp": "04:37:57", "text": "[呻吟聲]"}]
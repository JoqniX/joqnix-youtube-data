[{"type": "subtitle", "time": 19143.03, "timestamp": "05:19:03", "text": "1"}, {"type": "subtitle", "time": 19157.11, "timestamp": "05:19:17", "text": "嗯？它在哪裡？這邊走。"}, {"type": "subtitle", "time": 19159.03, "timestamp": "05:19:19", "text": "是我，是我。"}, {"type": "subtitle", "time": 19159.35, "timestamp": "05:19:19", "text": "是的。"}, {"type": "subtitle", "time": 19160.11, "timestamp": "05:19:20", "text": "呃，我該怎麼辦？"}, {"type": "subtitle", "time": 19168.19, "timestamp": "05:19:28", "text": "不，我認為這裡沒有這樣的空間。那，"}, {"type": "subtitle", "time": 19170.27, "timestamp": "05:19:30", "text": "好的。"}, {"type": "subtitle", "time": 19172.868, "timestamp": "05:19:32", "text": "我們可能是唯一能左右局勢的人。"}]
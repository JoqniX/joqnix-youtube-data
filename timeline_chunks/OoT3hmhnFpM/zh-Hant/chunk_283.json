[{"type": "subtitle", "time": 16982.23, "timestamp": "04:43:02", "text": "嗯？法利赫。"}, {"type": "subtitle", "time": 16984.03, "timestamp": "04:43:04", "text": "啊。"}, {"type": "subtitle", "time": 17004.948, "timestamp": "04:43:24", "text": "我很難打敗他們兩個。 O's"}, {"type": "subtitle", "time": 17007.43, "timestamp": "04:43:27", "text": "我殺了其中一個。"}, {"type": "subtitle", "time": 17008.99, "timestamp": "04:43:28", "text": "唉，看來我完了。"}, {"type": "subtitle", "time": 17010.788, "timestamp": "04:43:30", "text": "瞄準鍬甲的下半部。"}, {"type": "subtitle", "time": 17011.67, "timestamp": "04:43:31", "text": "是的。"}, {"type": "subtitle", "time": 17013.15, "timestamp": "04:43:33", "text": "我大概可以用這個來破壞頂部。"}, {"type": "subtitle", "time": 17027.51, "timestamp": "04:43:47", "text": "生長。好的。"}, {"type": "subtitle", "time": 17034.788, "timestamp": "04:43:54", "text": "請。是的。我會繼續做下去。那些傢伙。"}, {"type": "subtitle", "time": 17035.628, "timestamp": "04:43:55", "text": "是的。"}]
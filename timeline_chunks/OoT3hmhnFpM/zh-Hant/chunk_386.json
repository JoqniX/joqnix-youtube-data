[{"type": "subtitle", "time": 23177.07, "timestamp": "06:26:17", "text": "我必須"}, {"type": "subtitle", "time": 23179.03, "timestamp": "06:26:19", "text": "是"}, {"type": "subtitle", "time": 23191.35, "timestamp": "06:26:31", "text": "你還好嗎？"}, {"type": "subtitle", "time": 23191.948, "timestamp": "06:26:31", "text": "嚴重地？"}, {"type": "subtitle", "time": 23193.43, "timestamp": "06:26:33", "text": "西北"}, {"type": "subtitle", "time": 23200.15, "timestamp": "06:26:40", "text": "我會把這件事交給那位女士處理。"}]
[{"type": "subtitle", "time": 10441.269, "timestamp": "02:54:01", "text": "是的。是的。"}, {"type": "subtitle", "time": 10443.469, "timestamp": "02:54:03", "text": "你們是在喚醒我們的盟友嗎？嗯？什麼？什麼？"}, {"type": "subtitle", "time": 10445.429, "timestamp": "02:54:05", "text": "是，"}, {"type": "subtitle", "time": 10452.59, "timestamp": "02:54:12", "text": "被叫醒之後。"}, {"type": "subtitle", "time": 10461.75, "timestamp": "02:54:21", "text": "這也很奇怪。"}, {"type": "subtitle", "time": 10467.07, "timestamp": "02:54:27", "text": "是的。"}, {"type": "subtitle", "time": 10474.19, "timestamp": "02:54:34", "text": "太瘋狂了。"}, {"type": "subtitle", "time": 10476.07, "timestamp": "02:54:36", "text": "真的是假的？"}, {"type": "subtitle", "time": 10476.99, "timestamp": "02:54:36", "text": "太成熟了。"}, {"type": "subtitle", "time": 10479.309, "timestamp": "02:54:39", "text": "南門卡住了，開著。"}, {"type": "subtitle", "time": 10481.19, "timestamp": "02:54:41", "text": "真的嗎？知道了。"}, {"type": "subtitle", "time": 10482.51, "timestamp": "02:54:42", "text": "我從這裡進入。"}, {"type": "subtitle", "time": 10485.07, "timestamp": "02:54:45", "text": "我去那邊看看。現在"}, {"type": "subtitle", "time": 10488.309, "timestamp": "02:54:48", "text": "我快要死了，所以我快要死了。"}, {"type": "subtitle", "time": 10489.229, "timestamp": "02:54:49", "text": "謝謝你，[姓名]。"}, {"type": "subtitle", "time": 10491.229, "timestamp": "02:54:51", "text": "你還沒完成吧？大概是這樣"}, {"type": "subtitle", "time": 10493.07, "timestamp": "02:54:53", "text": "不，我沒有。"}, {"type": "subtitle", "time": 10498.51, "timestamp": "02:54:58", "text": "我該去嗎？"}]
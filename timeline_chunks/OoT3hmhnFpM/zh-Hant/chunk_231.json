[{"type": "subtitle", "time": 13863.07, "timestamp": "03:51:03", "text": "在，"}, {"type": "subtitle", "time": 13864.269, "timestamp": "03:51:04", "text": "他媽的。"}, {"type": "subtitle", "time": 13869.229, "timestamp": "03:51:09", "text": "啊，即使他們是敵人。"}, {"type": "subtitle", "time": 13871.67, "timestamp": "03:51:11", "text": "不，我們別無選擇。"}, {"type": "subtitle", "time": 13904.87, "timestamp": "03:51:44", "text": "是布雷利，對吧？"}, {"type": "subtitle", "time": 13912.79, "timestamp": "03:51:52", "text": "伊賽德米"}]
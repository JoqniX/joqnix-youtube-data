[{"type": "subtitle", "time": 783.95, "timestamp": "00:13:03", "text": "你好，小聲音。那是"}, {"type": "subtitle", "time": 788.19, "timestamp": "00:13:08", "text": "黑暗嗎？是的，我在這裡。你好。  你好。"}, {"type": "subtitle", "time": 789.63, "timestamp": "00:13:09", "text": "你好。謝謝光臨。您好。"}, {"type": "subtitle", "time": 792.59, "timestamp": "00:13:12", "text": "你好。等等，背景是不是"}, {"type": "subtitle", "time": 796.15, "timestamp": "00:13:16", "text": "太亮了？"}, {"type": "subtitle", "time": 802.55, "timestamp": "00:13:22", "text": "我覺得我可以把它調得更"}, {"type": "subtitle", "time": 808.67, "timestamp": "00:13:28", "text": "不要太暗。"}, {"type": "subtitle", "time": 810.55, "timestamp": "00:13:30", "text": "你好。別介意，呃，我沒有任何"}, {"type": "subtitle", "time": 812.43, "timestamp": "00:13:32", "text": "遮蓋物之類的，所以別介意我的"}, {"type": "subtitle", "time": 814.03, "timestamp": "00:13:34", "text": "圍巾，好嗎？"}, {"type": "subtitle", "time": 816.03, "timestamp": "00:13:36", "text": "好了，各位。"}, {"type": "subtitle", "time": 822.63, "timestamp": "00:13:42", "text": "別在意那條圍巾。  是的。"}, {"type": "subtitle", "time": 824.43, "timestamp": "00:13:44", "text": "嗯，"}, {"type": "subtitle", "time": 826.07, "timestamp": "00:13:46", "text": "我……"}, {"type": "subtitle", "time": 828.07, "timestamp": "00:13:48", "text": "對。"}, {"type": "subtitle", "time": 829.71, "timestamp": "00:13:49", "text": "我該怎麼做？"}, {"type": "subtitle", "time": 831.59, "timestamp": "00:13:51", "text": "我好久沒直播了，所以有些"}, {"type": "subtitle", "time": 834.03, "timestamp": "00:13:54", "text": "東西都忘了。  嗯。好了。"}, {"type": "subtitle", "time": 839.87, "timestamp": "00:13:59", "text": "嗯，"}]
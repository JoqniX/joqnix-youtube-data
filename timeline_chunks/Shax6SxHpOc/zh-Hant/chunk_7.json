[{"type": "subtitle", "time": 421.47, "timestamp": "00:07:01", "text": "你好。大家最近怎麼樣？"}, {"type": "subtitle", "time": 423.27, "timestamp": "00:07:03", "text": "嗯，好久不見了？我大概有……兩個月沒"}, {"type": "subtitle", "time": 425.11, "timestamp": "00:07:05", "text": "直播了吧"}, {"type": "subtitle", "time": 430.43, "timestamp": "00:07:10", "text": "？不，大概三個月吧。忘了說「"}, {"type": "subtitle", "time": 432.55, "timestamp": "00:07:12", "text": "嗨」。"}, {"type": "subtitle", "time": 433.71, "timestamp": "00:07:13", "text": "嗯，"}, {"type": "subtitle", "time": 435.31, "timestamp": "00:07:15", "text": "我已經很久沒有直播了，"}, {"type": "subtitle", "time": 437.51, "timestamp": "00:07:17", "text": "因為…"}, {"type": "chat", "time": 437.571, "timestamp": "00:07:17", "author": "@Solar07910", "avatar": "https://yt4.ggpht.com/ibEsXBiXAsrBWCWbTkgZ0bJd9N5UtKdTJ0xuH90CmHq-Zp-Lnzzyh3Y-5uAHMTNH94HMGGOwgWY=s64-c-k-c0x00ffffff-no-rj", "message": "Two months"}, {"type": "subtitle", "time": 439.87, "timestamp": "00:07:19", "text": "如果你不知道的話，我現在在日本"}, {"type": "subtitle", "time": 441.19, "timestamp": "00:07:21", "text": "。  是"}, {"type": "subtitle", "time": 442.71, "timestamp": "00:07:22", "text": "的，如果你還不知道的話，我現在在日本"}, {"type": "subtitle", "time": 444.11, "timestamp": "00:07:24", "text": "。"}, {"type": "subtitle", "time": 445.07, "timestamp": "00:07:25", "text": "嗯，"}, {"type": "subtitle", "time": 447.87, "timestamp": "00:07:27", "text": "我上個月來過這裡。  是的。  呃，"}, {"type": "subtitle", "time": 451.11, "timestamp": "00:07:31", "text": "四月。"}, {"type": "subtitle", "time": 452.15, "timestamp": "00:07:32", "text": "還有，"}, {"type": "subtitle", "time": 455.87, "timestamp": "00:07:35", "text": "你好，柯迪大人。歡迎。歡迎進來，"}, {"type": "subtitle", "time": 458.07, "timestamp": "00:07:38", "text": "歡迎進來。向新來的朋友問好"}, {"type": "subtitle", "time": 460.909, "timestamp": "00:07:40", "text": "。大家好。  接下來由我"}, {"type": "subtitle", "time": 463.27, "timestamp": "00:07:43", "text": "發言。這是我時隔許久後的[音樂]"}, {"type": "subtitle", "time": 465.045, "timestamp": "00:07:45", "text": "回歸直播。"}, {"type": "subtitle", "time": 466.47, "timestamp": "00:07:46", "text": "[笑聲]"}, {"type": "subtitle", "time": 469.19, "timestamp": "00:07:49", "text": "嗨。於是，我到達了日本。我在日本。"}, {"type": "subtitle", "time": 472.15, "timestamp": "00:07:52", "text": "我在這裡住了快"}, {"type": "subtitle", "time": 473.63, "timestamp": "00:07:53", "text": "兩個月了。是的，今天是"}, {"type": "subtitle", "time": 476.79, "timestamp": "00:07:56", "text": "5月30日。是的，所以是兩個月。你"}, {"type": "subtitle", "time": 478.43, "timestamp": "00:07:58", "text": "相信嗎？  是"}]
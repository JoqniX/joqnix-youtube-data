[{"type": "subtitle", "time": 720.87, "timestamp": "00:12:00", "text": "日文直播。是的。"}, {"type": "subtitle", "time": 722.31, "timestamp": "00:12:02", "text": "所以，這是我"}, {"type": "subtitle", "time": 724.83, "timestamp": "00:12:04", "text": "要宣布的消息之一。"}, {"type": "subtitle", "time": 727.79, "timestamp": "00:12:07", "text": "至於音樂方面的內容，"}, {"type": "subtitle", "time": 730.59, "timestamp": "00:12:10", "text": "我也會像往常一樣嘗試。我"}, {"type": "subtitle", "time": 734.63, "timestamp": "00:12:14", "text": "會上傳vlog。你們"}, {"type": "subtitle", "time": 739.47, "timestamp": "00:12:19", "text": "現在就可以在我的頻道上觀看第一期vlog了。"}, {"type": "subtitle", "time": 744.07, "timestamp": "00:12:24", "text": "我還會"}, {"type": "subtitle", "time": 746.75, "timestamp": "00:12:26", "text": "製作更多vlog。我已經錄下了"}, {"type": "subtitle", "time": 748.51, "timestamp": "00:12:28", "text": "他們剛才說的內容，只是我必須"}, {"type": "subtitle", "time": 751.23, "timestamp": "00:12:31", "text": "自己來做，包括剪輯等等。"}, {"type": "subtitle", "time": 755.59, "timestamp": "00:12:35", "text": "是的，歡迎隨時給我回饋"}, {"type": "subtitle", "time": 758.95, "timestamp": "00:12:38", "text": "關於vlog和內容等方面的意見。"}, {"type": "subtitle", "time": 761.19, "timestamp": "00:12:41", "text": "這對我"}, {"type": "subtitle", "time": 765.67, "timestamp": "00:12:45", "text": "改進作品真的非常有幫助。好嗎？"}, {"type": "subtitle", "time": 766.87, "timestamp": "00:12:46", "text": "你好。  還有什麼"}, {"type": "subtitle", "time": 770.71, "timestamp": "00:12:50", "text": "？  還能"}, {"type": "subtitle", "time": 772.31, "timestamp": "00:12:52", "text": "是什麼呢？"}]
[{"type": "subtitle", "time": 845.15, "timestamp": "00:14:05", "text": "公告。"}, {"type": "subtitle", "time": 846.51, "timestamp": "00:14:06", "text": "正確的。"}, {"type": "subtitle", "time": 848.11, "timestamp": "00:14:08", "text": "我會做好這件事的。"}, {"type": "subtitle", "time": 848.87, "timestamp": "00:14:08", "text": "知道了。  在"}, {"type": "subtitle", "time": 850.91, "timestamp": "00:14:10", "text": "那裡見面。我知道在那裡見面。"}, {"type": "subtitle", "time": 852.67, "timestamp": "00:14:12", "text": "知道了。可可。"}, {"type": "subtitle", "time": 853.79, "timestamp": "00:14:13", "text": "你好。"}, {"type": "subtitle", "time": 855.79, "timestamp": "00:14:15", "text": "我會不時用日語，"}, {"type": "subtitle", "time": 858.31, "timestamp": "00:14:18", "text": "因為我……"}, {"type": "subtitle", "time": 860.83, "timestamp": "00:14:20", "text": "我會在這裡待兩個月……呃，兩年。"}, {"type": "subtitle", "time": 863.35, "timestamp": "00:14:23", "text": "正確的。我來日本上語言課，是"}, {"type": "subtitle", "time": 865.47, "timestamp": "00:14:25", "text": "因為我想"}, {"type": "subtitle", "time": 866.83, "timestamp": "00:14:26", "text": "學習日語，想"}, {"type": "subtitle", "time": 869.31, "timestamp": "00:14:29", "text": "精通日語的一切。我正在上"}, {"type": "subtitle", "time": 871.39, "timestamp": "00:14:31", "text": "語言課，我是一名國際"}, {"type": "subtitle", "time": 873.63, "timestamp": "00:14:33", "text": "學生，我現在在日本學習語言。"}, {"type": "subtitle", "time": 875.15, "timestamp": "00:14:35", "text": "所以，"}, {"type": "subtitle", "time": 876.95, "timestamp": "00:14:36", "text": "我會在這裡待兩年。我的語言"}, {"type": "subtitle", "time": 879.23, "timestamp": "00:14:39", "text": "課程為期兩年。"}, {"type": "subtitle", "time": 883.11, "timestamp": "00:14:43", "text": "所以，我希望盡我所能，"}, {"type": "subtitle", "time": 885.67, "timestamp": "00:14:45", "text": "在兩年內至少拿到N3、N1或N2證書。我需要氮氣"}, {"type": "subtitle", "time": 888.15, "timestamp": "00:14:48", "text": "才能找到工作等等。"}, {"type": "subtitle", "time": 889.43, "timestamp": "00:14:49", "text": "天氣很熱。"}, {"type": "subtitle", "time": 890.55, "timestamp": "00:14:50", "text": "所以，"}, {"type": "subtitle", "time": 893.829, "timestamp": "00:14:53", "text": "目前我是N4。我的N3課程"}, {"type": "subtitle", "time": 896.829, "timestamp": "00:14:56", "text": "下週一就要開始了。是的。"}]
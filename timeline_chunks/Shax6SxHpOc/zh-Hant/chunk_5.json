[{"type": "subtitle", "time": 302.51, "timestamp": "00:05:02", "text": "呃，"}, {"type": "subtitle", "time": 303.913, "timestamp": "00:05:03", "text": "我的聲音能被聽見嗎？"}, {"type": "subtitle", "time": 308.51, "timestamp": "00:05:08", "text": "好的，你好。"}, {"type": "subtitle", "time": 310.909, "timestamp": "00:05:10", "text": "好的。  大家"}, {"type": "subtitle", "time": 314.43, "timestamp": "00:05:14", "text": "好，大家好。"}, {"type": "subtitle", "time": 317.19, "timestamp": "00:05:17", "text": "是《黑闇騎士》。"}, {"type": "chat", "time": 317.747, "timestamp": "00:05:17", "author": "@Solar07910", "avatar": "https://yt4.ggpht.com/ibEsXBiXAsrBWCWbTkgZ0bJd9N5UtKdTJ0xuH90CmHq-Zp-Lnzzyh3Y-5uAHMTNH94HMGGOwgWY=s64-c-k-c0x00ffffff-no-rj", "message": "Hi Joq!"}, {"type": "subtitle", "time": 323.03, "timestamp": "00:05:23", "text": "你好。好的。"}, {"type": "subtitle", "time": 324.47, "timestamp": "00:05:24", "text": "嗯，"}, {"type": "chat", "time": 326.694, "timestamp": "00:05:26", "author": "@Solar07910", "avatar": "https://yt4.ggpht.com/ibEsXBiXAsrBWCWbTkgZ0bJd9N5UtKdTJ0xuH90CmHq-Zp-Lnzzyh3Y-5uAHMTNH94HMGGOwgWY=s64-c-k-c0x00ffffff-no-rj", "message": "Remember me?"}, {"type": "subtitle", "time": 328.11, "timestamp": "00:05:28", "text": "我發現我沒有常用的設備。"}, {"type": "subtitle", "time": 330.113, "timestamp": "00:05:30", "text": "所以，我只能隨機應變。"}, {"type": "subtitle", "time": 331.75, "timestamp": "00:05:31", "text": "[笑聲]"}, {"type": "subtitle", "time": 335.15, "timestamp": "00:05:35", "text": "呃，給我一分鐘。  哦。  嗯。"}, {"type": "subtitle", "time": 341.71, "timestamp": "00:05:41", "text": "嗯，我應該沒事。"}, {"type": "subtitle", "time": 344.47, "timestamp": "00:05:44", "text": "大家好。好久不見了"}, {"type": "subtitle", "time": 348.23, "timestamp": "00:05:48", "text": "。好久不見了。你好，你好。  好吧，"}, {"type": "subtitle", "time": 351.79, "timestamp": "00:05:51", "text": "我得加個「嗯」。"}, {"type": "subtitle", "time": 354.59000000000003, "timestamp": "00:05:54", "text": "讓我……呃"}, {"type": "subtitle", "time": 358.75, "timestamp": "00:05:58", "text": "，這個東西。  大家最近怎麼樣？你好，太陽能。  你好，"}]
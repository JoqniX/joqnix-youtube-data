[{"type": "subtitle", "time": 540.87, "timestamp": "00:09:00", "text": "。"}, {"type": "subtitle", "time": 542.67, "timestamp": "00:09:02", "text": "如果你聽到我室友的聲音，請不要在意"}, {"type": "subtitle", "time": 545.91, "timestamp": "00:09:05", "text": "他。一秒鐘（音樂）。"}, {"type": "subtitle", "time": 548.07, "timestamp": "00:09:08", "text": "嗯，是的。"}, {"type": "subtitle", "time": 550.15, "timestamp": "00:09:10", "text": "我住在合"}, {"type": "subtitle", "time": 551.75, "timestamp": "00:09:11", "text": "租房"}, {"type": "subtitle", "time": 553.471, "timestamp": "00:09:13", "text": "或公寓。"}, {"type": "subtitle", "time": 553.55, "timestamp": "00:09:13", "text": "[音樂]"}, {"type": "subtitle", "time": 554.43, "timestamp": "00:09:14", "text": "嗯哼"}, {"type": "subtitle", "time": 558.43, "timestamp": "00:09:18", "text": "，我現在有室友了。是的。所以，他"}, {"type": "subtitle", "time": 561.75, "timestamp": "00:09:21", "text": "做飯，我做清潔之類的家事。  是的。"}, {"type": "subtitle", "time": 564.15, "timestamp": "00:09:24", "text": "我本來應該在一周前上傳"}, {"type": "subtitle", "time": 567.99, "timestamp": "00:09:27", "text": "視頻，呃，不是視頻，是博客"}, {"type": "subtitle", "time": 571.35, "timestamp": "00:09:31", "text": "。"}, {"type": "subtitle", "time": 573.95, "timestamp": "00:09:33", "text": "但我遲到了。我必須去做一些事情。"}, {"type": "subtitle", "time": 575.87, "timestamp": "00:09:35", "text": "我當時很忙。"}, {"type": "subtitle", "time": 597.63, "timestamp": "00:09:57", "text": "是啊，我一點空閒時間都不想有。  所以，我原本應該更早發布這個視頻博客，而不是今天。我"}]
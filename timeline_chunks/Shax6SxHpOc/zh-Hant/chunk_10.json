[{"type": "subtitle", "time": 601.11, "timestamp": "00:10:01", "text": "知道我大概一個小時前才發布"}, {"type": "subtitle", "time": 616.19, "timestamp": "00:10:16", "text": "，現在卻突然要直播。  什麼？  你相信嗎？  是的，所以是一些公告。  既然我已經回歸直播，你們可以期待我……但我不能保證，對吧？我無法向你們保證我以後什麼時候可以直播，因為我的日程安排很忙。"}, {"type": "subtitle", "time": 617.87, "timestamp": "00:10:17", "text": "兼職、"}, {"type": "subtitle", "time": 619.91, "timestamp": "00:10:19", "text": "兼職工作、"}, {"type": "subtitle", "time": 622.71, "timestamp": "00:10:22", "text": "課程、"}, {"type": "subtitle", "time": 626.03, "timestamp": "00:10:26", "text": "很多家事等等"}, {"type": "subtitle", "time": 628.79, "timestamp": "00:10:28", "text": "。總之，有很多事情要做。  很"}, {"type": "subtitle", "time": 631.95, "timestamp": "00:10:31", "text": "粗糙。  真是太難了"}, {"type": "subtitle", "time": 637.99, "timestamp": "00:10:37", "text": "嗯，"}, {"type": "subtitle", "time": 641.87, "timestamp": "00:10:41", "text": "還有，我還是把 Twitch 聊天視窗也"}, {"type": "subtitle", "time": 644.95, "timestamp": "00:10:44", "text": "打開著吧，這樣我就可以看看聊天內容了。"}, {"type": "subtitle", "time": 646.31, "timestamp": "00:10:46", "text": "他們會"}, {"type": "subtitle", "time": 648.23, "timestamp": "00:10:48", "text": "彈出聊天視窗嗎？所以我把它放在"}, {"type": "subtitle", "time": 652.87, "timestamp": "00:10:52", "text": "這裡，這樣我就可以這樣"}, {"type": "subtitle", "time": 655.23, "timestamp": "00:10:55", "text": "閱讀了。如果您在"}, {"type": "subtitle", "time": 658.59, "timestamp": "00:10:58", "text": "YouTube、"}]
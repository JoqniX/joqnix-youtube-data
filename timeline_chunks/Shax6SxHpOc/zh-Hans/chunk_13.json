[{"type": "subtitle", "time": 783.95, "timestamp": "00:13:03", "text": "你好，小声音。 那是"}, {"type": "subtitle", "time": 788.19, "timestamp": "00:13:08", "text": "黑暗吗？ 是的，我在这里。 你好。"}, {"type": "subtitle", "time": 789.63, "timestamp": "00:13:09", "text": "你好。 你好。 谢谢光临。"}, {"type": "subtitle", "time": 792.59, "timestamp": "00:13:12", "text": "您好。 你好。 等等，背景是不是"}, {"type": "subtitle", "time": 796.15, "timestamp": "00:13:16", "text": "太亮了？"}, {"type": "subtitle", "time": 802.55, "timestamp": "00:13:22", "text": "我觉得我可以把它调得更"}, {"type": "subtitle", "time": 808.67, "timestamp": "00:13:28", "text": "不要太暗。"}, {"type": "subtitle", "time": 810.55, "timestamp": "00:13:30", "text": "你好。 别介意，呃，我没有任何"}, {"type": "subtitle", "time": 812.43, "timestamp": "00:13:32", "text": "遮盖物之类的，所以别介意我的"}, {"type": "subtitle", "time": 814.03, "timestamp": "00:13:34", "text": "围巾，好吗？"}, {"type": "subtitle", "time": 816.03, "timestamp": "00:13:36", "text": "好了，各位。"}, {"type": "subtitle", "time": 822.63, "timestamp": "00:13:42", "text": "别在意那条围巾。   是的"}, {"type": "subtitle", "time": 824.43, "timestamp": "00:13:44", "text": "。 嗯，我……"}, {"type": "subtitle", "time": 828.07, "timestamp": "00:13:48", "text": "对。"}, {"type": "subtitle", "time": 829.71, "timestamp": "00:13:49", "text": "我该怎么做？"}, {"type": "subtitle", "time": 831.59, "timestamp": "00:13:51", "text": "我好久没直播了，所以"}, {"type": "subtitle", "time": 834.03, "timestamp": "00:13:54", "text": "有些东西都忘了。   嗯。 好了"}, {"type": "subtitle", "time": 839.87, "timestamp": "00:13:59", "text": "。 嗯，"}]
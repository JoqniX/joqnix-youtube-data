[{"type": "subtitle", "time": 5222.27, "timestamp": "01:27:02", "text": "Daniel Sun，谢谢你的光临。"}, {"type": "subtitle", "time": 5225.51, "timestamp": "01:27:05", "text": "Cody，感谢你来Twitch直播间。"}, {"type": "subtitle", "time": 5228.39, "timestamp": "01:27:08", "text": "呃，卡罗琳，谢谢你过来。"}, {"type": "subtitle", "time": 5231.27, "timestamp": "01:27:11", "text": "情圣孙，谢谢你的光临。"}, {"type": "subtitle", "time": 5233.27, "timestamp": "01:27:13", "text": "拉莉西亚，谢谢你过来。"}, {"type": "subtitle", "time": 5235.03, "timestamp": "01:27:15", "text": "Sheri Sun今天来了。 谢谢"}, {"type": "subtitle", "time": 5237.87, "timestamp": "01:27:17", "text": "雪莉过来看看。"}, {"type": "subtitle", "time": 5239.39, "timestamp": "01:27:19", "text": "别担心，你可以随意发送"}, {"type": "subtitle", "time": 5241.03, "timestamp": "01:27:21", "text": "垃圾邮件。 一切都好。"}, {"type": "subtitle", "time": 5243.31, "timestamp": "01:27:23", "text": "我陷入了困境。 谢谢光临。"}, {"type": "subtitle", "time": 5245.91, "timestamp": "01:27:25", "text": "马塞莉娜，谢谢你过来。"}, {"type": "subtitle", "time": 5247.31, "timestamp": "01:27:27", "text": "Monkey D Dragon，谢谢"}, {"type": "subtitle", "time": 5249.55, "timestamp": "01:27:29", "text": "光临。  Edward Sun，谢谢你过来，也谢谢你"}, {"type": "subtitle", "time": 5251.87, "timestamp": "01:27:31", "text": "告诉我我的 Twitch"}, {"type": "subtitle", "time": 5253.27, "timestamp": "01:27:33", "text": "直播间断了。"}, {"type": "subtitle", "time": 5256.71, "timestamp": "01:27:36", "text": "现在，我觉得还算可以。"}, {"type": "subtitle", "time": 5260.59, "timestamp": "01:27:40", "text": "饲料断了。  Twitch 和 Kick。"}, {"type": "subtitle", "time": 5261.83, "timestamp": "01:27:41", "text": "好的，苏里亚·桑，谢谢你的"}, {"type": "subtitle", "time": 5263.83, "timestamp": "01:27:43", "text": "光临。"}, {"type": "subtitle", "time": 5267.15, "timestamp": "01:27:47", "text": "丹尼尔·孙，谢谢你的光临。"}, {"type": "subtitle", "time": 5269.03, "timestamp": "01:27:49", "text": "Yuki Doki Sun。"}, {"type": "subtitle", "time": 5270.71, "timestamp": "01:27:50", "text": "不知道你是否还在，但"}, {"type": "subtitle", "time": 5273.15, "timestamp": "01:27:53", "text": "谢谢你的光临。 我的Twitch直播中断了"}, {"type": "subtitle", "time": 5274.71, "timestamp": "01:27:54", "text": "。   是"}, {"type": "subtitle", "time": 5276.23, "timestamp": "01:27:56", "text": "的，我无法"}, {"type": "subtitle", "time": 5278.695, "timestamp": "01:27:58", "text": "回复你。 抱歉，现在不行了。"}, {"type": "subtitle", "time": 5279.27, "timestamp": "01:27:59", "text": "[嗤笑]"}]
xt": "直播"}, {"type": "subtitle", "time": 1066.75, "timestamp": "00:17:46", "text": "将采用"}, {"type": "subtitle", "time": 1069.27, "timestamp": "00:17:49", "text": "双语形式。"}, {"type": "subtitle", "time": 1071.39, "timestamp": "00:17:51", "text": "所以，这意味着，"}, {"type": "subtitle", "time": 1075.11, "timestamp": "00:17:55", "text": "呃，我该"}, {"type": "subtitle", "time": 1077.31, "timestamp": "00:17:57", "text": "如何再次添加空格？   像这样吗"}, {"type": "subtitle", "time": 1078.95, "timestamp": "00:17:58", "text": "？"}]
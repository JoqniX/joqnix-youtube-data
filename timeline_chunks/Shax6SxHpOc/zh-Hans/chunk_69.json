[{"type": "subtitle", "time": 4141.99, "timestamp": "01:09:01", "text": "友善。 他们是长辈。"}, {"type": "subtitle", "time": 4143.07, "timestamp": "01:09:03", "text": "嗯，"}, {"type": "subtitle", "time": 4144.95, "timestamp": "01:09:04", "text": "他们一直"}, {"type": "subtitle", "time": 4147.39, "timestamp": "01:09:07", "text": "在教我如何做好这份"}, {"type": "subtitle", "time": 4149.349, "timestamp": "01:09:09", "text": "工作等等，"}, {"type": "subtitle", "time": 4152.03, "timestamp": "01:09:12", "text": "嗯，人真的很好。  [音乐]"}, {"type": "subtitle", "time": 4153.309, "timestamp": "01:09:13", "text": "我总是……"}, {"type": "subtitle", "time": 4155.349, "timestamp": "01:09:15", "text": "嗯，是的，就我"}, {"type": "subtitle", "time": 4159.47, "timestamp": "01:09:19", "text": "而言，我其实从来"}, {"type": "subtitle", "time": 4163.15, "timestamp": "01:09:23", "text": "没见过我工作的老板，也就是"}, {"type": "chat", "time": 4165.312, "timestamp": "01:09:25", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "mhm mhm"}, {"type": "subtitle", "time": 4170.269, "timestamp": "01:09:30", "text": "CEO，因为他生病了，所以是"}, {"type": "subtitle", "time": 4173.67, "timestamp": "01:09:33", "text": "另一个员工助理面试了我，"}, {"type": "subtitle", "time": 4178.309, "timestamp": "01:09:38", "text": "后来我才见到他，我们没怎么"}, {"type": "subtitle", "time": 4181.23, "timestamp": "01:09:41", "text": "说话，但是……嗯，我的所有"}, {"type": "subtitle", "time": 4183.95, "timestamp": "01:09:43", "text": "事情都由一位"}, {"type": "subtitle", "time": 4186.87, "timestamp": "01:09:46", "text": "经理或者说，一位在公司工作"}, {"type": "subtitle", "time": 4189.63, "timestamp": "01:09:49", "text": "很久的员工负责处理，"}, {"type": "subtitle", "time": 4191.43, "timestamp": "01:09:51", "text": "所以……嗯"}, {"type": "subtitle", "time": 4195.99, "timestamp": "01:09:55", "text": "，他真的很友善，也很"}, {"type": "subtitle", "time": 4197.35, "timestamp": "01:09:57", "text": "支持我，"}, {"type": "subtitle", "time": 4199.31, "timestamp": "01:09:59", "text": "尤其是我因为"}]
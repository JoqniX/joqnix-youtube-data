[{"type": "subtitle", "time": 5280.99, "timestamp": "01:28:00", "text": "那么，Wilden Sun，谢谢你来观看，"}, {"type": "subtitle", "time": 5283.79, "timestamp": "01:28:03", "text": "你已经很久没来"}, {"type": "subtitle", "time": 5286.11, "timestamp": "01:28:06", "text": "我的直播间了，所以谢谢你的到来。"}, {"type": "subtitle", "time": 5288.07, "timestamp": "01:28:08", "text": "你也加入了Discord"}, {"type": "subtitle", "time": 5290.35, "timestamp": "01:28:10", "text": "服务器，对吧？"}, {"type": "subtitle", "time": 5292.83, "timestamp": "01:28:12", "text": "再次感谢你。"}, {"type": "subtitle", "time": 5295.31, "timestamp": "01:28:15", "text": "谢谢大家。 培根来了。 谢谢"}, {"type": "subtitle", "time": 5297.99, "timestamp": "01:28:17", "text": "培根的光临。"}, {"type": "subtitle", "time": 5299.59, "timestamp": "01:28:19", "text": "然后，阿斯特拉来了"}, {"type": "subtitle", "time": 5308.31, "timestamp": "01:28:28", "text": "萨巴特·桑也来了。 谢谢你，"}, {"type": "subtitle", "time": 5316.75, "timestamp": "01:28:36", "text": "面包也在这里。 谢谢你，面包。"}, {"type": "subtitle", "time": 5335.83, "timestamp": "01:28:55", "text": "，就是这样。"}, {"type": "subtitle", "time": 5338.43, "timestamp": "01:28:58", "text": "嗯，还行。 你好。 谢谢"}]
[{"type": "subtitle", "time": 4560.75, "timestamp": "01:16:00", "text": "刚拿到笔记本电脑的时候确实尝试玩过游戏"}, {"type": "subtitle", "time": 4562.87, "timestamp": "01:16:02", "text": "，但"}, {"type": "subtitle", "time": 4571.71, "timestamp": "01:16:11", "text": "感觉好像有点吃力不讨好似的。"}, {"type": "subtitle", "time": 4574.03, "timestamp": "01:16:14", "text": "所以，我"}, {"type": "subtitle", "time": 4575.43, "timestamp": "01:16:15", "text": "拿到新笔记本电脑后玩的第一款游戏是《"}, {"type": "subtitle", "time": 4577.35, "timestamp": "01:16:17", "text": "刺客信条：奥德赛》，因为我买了"}, {"type": "subtitle", "time": 4579.23, "timestamp": "01:16:19", "text": "这款游戏，但"}, {"type": "subtitle", "time": 4586.23, "timestamp": "01:16:26", "text": "之前在印度的时候在我的电脑上玩不了。 就像我们当时做了大概"}, {"type": "subtitle", "time": 4590.39, "timestamp": "01:16:30", "text": "20 场那样的直播之类的"}, {"type": "subtitle", "time": 4593.15, "timestamp": "01:16:33", "text": "，对吧？   是的"}, {"type": "subtitle", "time": 4595.99, "timestamp": "01:16:35", "text": "，就像"}, {"type": "subtitle", "time": 4598.19, "timestamp": "01:16:38", "text": "我玩过的那样。 感觉就像我一开始能玩得"}, {"type": "subtitle", "time": 4599.63, "timestamp": "01:16:39", "text": "很好，但"}, {"type": "subtitle", "time": 4601.27, "timestamp": "01:16:41", "text": "过了一会儿，我就觉得，“啊，我玩不下去了"}, {"type": "subtitle", "time": 4607.27, "timestamp": "01:16:47", "text": "稍等"}, {"type": "subtitle", "time": 4609.51, "timestamp": "01:16:49", "text": "片刻。"}, {"type": "subtitle", "time": 4616.55, "timestamp": "01:16:56", "text": "而且，因为我只有一台笔记本电脑，只有一个"}, {"type": "subtitle", "time": 4617.79, "timestamp": "01:16:57", "text": "屏幕，所以"}]
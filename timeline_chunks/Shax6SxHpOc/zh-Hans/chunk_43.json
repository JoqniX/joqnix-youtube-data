[{"type": "subtitle", "time": 2581.47, "timestamp": "00:43:01", "text": "睡在地上，看着"}, {"type": "subtitle", "time": 2582.63, "timestamp": "00:43:02", "text": "星星。"}, {"type": "subtitle", "time": 2585.63, "timestamp": "00:43:05", "text": "这么多年来，我作为一个星座，一直"}, {"type": "subtitle", "time": 2589.59, "timestamp": "00:43:09", "text": "无法好好观星。   我的"}, {"type": "subtitle", "time": 2593.99, "timestamp": "00:43:13", "text": "天哪，我的天哪。"}, {"type": "chat", "time": 2596.391, "timestamp": "00:43:16", "author": "@bakononcopiumm", "avatar": "https://yt4.ggpht.com/hb5sPAHLUD7fBrZZsmfkzISQWwRqI8BY1n8lceyhZz0sNISomD05pCwUe-GL2amD5y-voH_uYw=s64-c-k-c0x00ffffff-no-rj", "message": "You sleep outside?"}, {"type": "subtitle", "time": 2598.51, "timestamp": "00:43:18", "text": "我绝对推荐你在"}, {"type": "subtitle", "time": 2604.75, "timestamp": "00:43:24", "text": "草地上观星。 就像动漫里那样，我照做了，"}, {"type": "subtitle", "time": 2608.15, "timestamp": "00:43:28", "text": "感觉真是太棒了"}, {"type": "subtitle", "time": 2609.47, "timestamp": "00:43:29", "text": "！"}, {"type": "subtitle", "time": 2612.19, "timestamp": "00:43:32", "text": "注意不要让"}, {"type": "chat", "time": 2612.584, "timestamp": "00:43:32", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "ahh I have heard the sky there is very noice and clear"}, {"type": "subtitle", "time": 2614.51, "timestamp": "00:43:34", "text": "昆虫之类的东西沾到身上，"}, {"type": "subtitle", "time": 2616.745, "timestamp": "00:43:36", "text": "好吗？ 当你睡在草地上的时候"}, {"type": "chat", "time": 2620.447, "timestamp": "00:43:40", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "ya in thw park"}, {"type": "subtitle", "time": 2621.55, "timestamp": "00:43:41", "text": "，你知道吗？ 这是泥土。 这是地球。"}, {"type": "subtitle", "time": 2621.985, "timestamp": "00:43:41", "text": "所以，"}, {"type": "subtitle", "time": 2622.07, "timestamp": "00:43:42", "text": "音乐就像"}, {"type": "subtitle", "time": 2624.67, "timestamp": "00:43:44", "text": "触碰到了草地，你知道吗？ 所以，"}, {"type": "subtitle", "time": 2625.87, "timestamp": "00:43:45", "text": "如果他们说：“不，不，不，不。” 我"}, {"type": "subtitle", "time": 2628.87, "timestamp": "00:43:48", "text": "只是去那里躺下，"}, {"type": "subtitle", "time": 2632.23, "timestamp": "00:43:52", "text": "让心灵平静下来，"}, {"type": "subtitle", "time": 2636.47, "timestamp": "00:43:56", "text": "自言自语，"}, {"type": "subtitle", "time": 2638.51, "timestamp": "00:43:58", "text": "倾听内心的声音"}]
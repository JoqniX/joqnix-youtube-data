[{"type": "subtitle", "time": 1862.11, "timestamp": "00:31:02", "text": "所以，这算是个好消息。"}, {"type": "subtitle", "time": 1866.87, "timestamp": "00:31:06", "text": "你在日本最喜欢吃什么？ 哦，糟糕"}, {"type": "subtitle", "time": 1872.87, "timestamp": "00:31:12", "text": "嗯。"}, {"type": "subtitle", "time": 1877.87, "timestamp": "00:31:17", "text": "我不想说拉面。 我想说牛肉"}, {"type": "subtitle", "time": 1884.83, "timestamp": "00:31:24", "text": "嗯。 牛丼，牛丼。"}, {"type": "subtitle", "time": 1887.51, "timestamp": "00:31:27", "text": "牛丼就像：我该如何解释什么是"}, {"type": "chat", "time": 1890.1, "timestamp": "00:31:30", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "I think twitch payout is 100 now"}, {"type": "subtitle", "time": 1893.59, "timestamp": "00:31:33", "text": "牛丼，让我把它打到聊天框里，这样就能"}, {"type": "chat", "time": 1895.486, "timestamp": "00:31:35", "author": "@DinyoFoxy", "avatar": "https://yt4.ggpht.com/aACLJToYP6FMtiMkCyV12FJchjJLrwy1qzEVqHiZEyFaZdsbRkj-yqg_i_m8eqjYX-fTLgPLCzk=s64-c-k-c0x00ffffff-no-rj", "message": "yo remember me ?"}, {"type": "subtitle", "time": 1897.67, "timestamp": "00:31:37", "text": "发送给所有人了。"}, {"type": "subtitle", "time": 1900.35, "timestamp": "00:31:40", "text": "哦，等等。 我可以直接在屏幕上展示。"}, {"type": "subtitle", "time": 1902.15, "timestamp": "00:31:42", "text": "你还记得我吗？ 是的，我记得"}, {"type": "subtitle", "time": 1904.55, "timestamp": "00:31:44", "text": "你，迪娜。"}, {"type": "subtitle", "time": 1906.91, "timestamp": "00:31:46", "text": "你好。 好久不见了。"}, {"type": "subtitle", "time": 1908.79, "timestamp": "00:31:48", "text": "谢谢你们的光临。"}, {"type": "subtitle", "time": 1910.91, "timestamp": "00:31:50", "text": "尽管我已经两个月没有活跃了"}, {"type": "subtitle", "time": 1913.11, "timestamp": "00:31:53", "text": "。"}, {"type": "subtitle", "time": 1914.07, "timestamp": "00:31:54", "text": "嗯。"}, {"type": "chat", "time": 1919.148, "timestamp": "00:31:59", "author": "@DinyoFoxy", "avatar": "https://
[{"type": "subtitle", "time": 1201.75, "timestamp": "00:20:01", "text": "我来这里是作为一名语言学生，我会"}, {"type": "subtitle", "time": 1203.238, "timestamp": "00:20:03", "text": "说更多的日语。"}, {"type": "subtitle", "time": 1203.39, "timestamp": "00:20:03", "text": "[音乐]"}, {"type": "subtitle", "time": 1205.75, "timestamp": "00:20:05", "text": "好吗？ 到处都是溪流。 即使我在"}, {"type": "subtitle", "time": 1208.75, "timestamp": "00:20:08", "text": "日本，我也必须说日语。"}, {"type": "subtitle", "time": 1211.91, "timestamp": "00:20:11", "text": "嗯，我们会进行更多日语直播。"}, {"type": "subtitle", "time": 1213.87, "timestamp": "00:20:13", "text": "呃，日语直播将会"}, {"type": "subtitle", "time": 1216.19, "timestamp": "00:20:16", "text": "作为一种挑战出现。 正常情况下，我的直播内容会"}, {"type": "subtitle", "time": 1219.15, "timestamp": "00:20:19", "text": "包含混杂的语言，可以吗？"}, {"type": "subtitle", "time": 1222.19, "timestamp": "00:20:22", "text": "日语和英语。 是的。"}, {"type": "subtitle", "time": 1224.87, "timestamp": "00:20:24", "text": "主要目的是为了学习语言，"}, {"type": "subtitle", "time": 1226.31, "timestamp": "00:20:26", "text": "提高"}, {"type": "subtitle", "time": 1228.23, "timestamp": "00:20:28", "text": "我的"}, {"type": "subtitle", "time": 1232.63, "timestamp": "00:20:32", "text": "词汇量、语调和"}, {"type": "subtitle", "time": 1235.47, "timestamp": "00:20:35", "text": "口语能力。 你好。 因为我需要能"}, {"type": "subtitle", "time": 1238.15, "timestamp": "00:20:38", "text": "说一口流利的口语，对吧？ 你好。   这"}, {"type": "subtitle", "time": 1240.19, "timestamp": "00:20:40", "text": "是第一点。"}, {"type": "chat", "time": 1245.586, "timestamp": "00:20:45", "author": "@MarcelineDichosa-e8b", "avatar": "https://yt4.ggpht.com/ytc/AIdro_lPAu5LcUW1h_9K92DDPIFAt7oKeKn1gaScOAfzdeLy0FyHMrhcwYmEo-u21qNz3kJRkA=s64-c-k-c0x00ffffff-no-rj", "message": "I can speak Filipino and a little bit of Japanese and Korean"}, {"type": "subtitle", "time": 1245.83, "timestamp": "00:20:45", "text": "更多音乐"}, {"type": "subtitle", "time": 1247.87, "timestamp": "00:20:47", "text": "内容，还有"}, {"type": "subtitle", "time": 1250.27, "timestamp"
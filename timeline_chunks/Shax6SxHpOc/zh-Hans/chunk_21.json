[{"type": "subtitle", "time": 1261.07, "timestamp": "00:21:01", "text": "我觉得我不应该那样做。"}, {"type": "subtitle", "time": 1264.99, "timestamp": "00:21:04", "text": "更多音乐内容。"}, {"type": "subtitle", "time": 1267.27, "timestamp": "00:21:07", "text": "而其下层则会像"}, {"type": "subtitle", "time": 1269.59, "timestamp": "00:21:09", "text": "音乐制作、流"}, {"type": "subtitle", "time": 1273.87, "timestamp": "00:21:13", "text": "媒体、电路流"}, {"type": "subtitle", "time": 1276.19, "timestamp": "00:21:16", "text": "以及各种"}, {"type": "subtitle", "time": 1280.83, "timestamp": "00:21:20", "text": "挑战。"}, {"type": "subtitle", "time": 1282.91, "timestamp": "00:21:22", "text": "所以，我们会进行一些挑战。 我想对此提出"}, {"type": "subtitle", "time": 1284.19, "timestamp": "00:21:24", "text": "质疑。"}, {"type": "subtitle", "time": 1286.19, "timestamp": "00:21:26", "text": "好的，第三个。"}, {"type": "subtitle", "time": 1289.19, "timestamp": "00:21:29", "text": "让我看看聊天记录。"}, {"type": "subtitle", "time": 1290.43, "timestamp": "00:21:30", "text": "呃，"}, {"type": "subtitle", "time": 1292.59, "timestamp": "00:21:32", "text": "我该如何查看已读聊天记录？ 嗯，那就"}, {"type": "subtitle", "time": 1294.15, "timestamp": "00:21:34", "text": "这么办吧。"}, {"type": "subtitle", "time": 1295.79, "timestamp": "00:21:35", "text": "好的。"}, {"type": "subtitle", "time": 1297.31, "timestamp": "00:21:37", "text": "呃，"}, {"type": "subtitle", "time": 1298.91, "timestamp": "00:21:38", "text": "总之，我会说一点菲律宾语"}, {"type": "subtitle", "time": 1300.43, "timestamp": "00:21:40", "text": "、日语和韩语。 哦，"}, {"type": "subtitle", "time": 1303.79, "timestamp": "00:21:43", "text": "那太酷了。 太酷了。 你"}, {"type": "subtitle", "time": 1308.695, "timestamp": "00:21:48", "text": "你知道。"}, {"type": "subtitle", "time": 1309.75, "timestamp": "00:21:49", "text": "[笑声]"}, {"type": "subtitle", "time": 1312.67, "timestamp": "00:21:52", "text": "所以，我不担心那些……"}]
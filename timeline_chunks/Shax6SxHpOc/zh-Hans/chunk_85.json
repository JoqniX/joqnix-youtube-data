[{"type": "subtitle", "time": 5101.39, "timestamp": "01:25:01", "text": "有趣。"}, {"type": "subtitle", "time": 5105.19, "timestamp": "01:25:05", "text": "主要问题在于时间。 我"}, {"type": "subtitle", "time": 5112.35, "timestamp": "01:25:12", "text": "现在身在印度，没办法像以前在家乡那样连续直播 24 小时或 12 小时。"}, {"type": "subtitle", "time": 5115.11, "timestamp": "01:25:15", "text": "我只能抽出1个小时，仅仅1个小时。"}, {"type": "subtitle", "time": 5116.19, "timestamp": "01:25:16", "text": "所以，"}, {"type": "subtitle", "time": 5118.91, "timestamp": "01:25:18", "text": "在这种情况下，我只会安排一次"}, {"type": "subtitle", "time": 5122.51, "timestamp": "01:25:22", "text": "直播。 或许可以这样说："}, {"type": "subtitle", "time": 5124.67, "timestamp": "01:25:24", "text": "我觉得我可能无法遵守"}, {"type": "subtitle", "time": 5127.15, "timestamp": "01:25:27", "text": "时间表或安排我的直播时间之类的"}, {"type": "subtitle", "time": 5129.35, "timestamp": "01:25:29", "text": "，但是……嗯"}, {"type": "subtitle", "time": 5133.59, "timestamp": "01:25:33", "text": "，我会尽力而为。 下个月"}, {"type": "subtitle", "time": 5136.39, "timestamp": "01:25:36", "text": "就是六月了，对吧？"}, {"type": "subtitle", "time": 5138.79, "timestamp": "01:25:38", "text": "从周一开始。"}, {"type": "subtitle", "time": 5141.07, "timestamp": "01:25:41", "text": "六月份，让我看看我的"}, {"type": "subtitle", "time": 5144.03, "timestamp": "01:25:44", "text": "日程安排，嗯，是的"}, {"type": "subtitle", "time": 5147.47, "timestamp": "01:25:47", "text": "，现在只进行电脑直播，也就是"}, {"type": "subtitle", "time": 5149.43, "timestamp": "01:25:49", "text": "我必须坐在"}, {"type": "subtitle", "time": 5151.87, "timestamp": "01:25:51", "text": "笔记本电脑前进行直播。 这些都"}, {"type": "subtitle", "time": 5153.99, "timestamp": "01:25:53", "text": "难以预测，但除此之外"}, {"type": "subtitle", "time": 5155.79, "timestamp": "01:25:55", "text": "，"}, {"type": "subtitle", "time": 5159.11, "timestamp": "01:25:59", "text": "我想移动直播之类的功能是可以实现的。"}]
[{"type": "subtitle", "time": 3961.63, "timestamp": "01:06:01", "text": "我用的是那种鹅颈式"}, {"type": "subtitle", "time": 3963.15, "timestamp": "01:06:03", "text": "麦克风"}, {"type": "subtitle", "time": 3965.87, "timestamp": "01:06:05", "text": "支架，对吧？ 为了在我"}, {"type": "subtitle", "time": 3968.025, "timestamp": "01:06:08", "text": "展示生日蛋糕之类的东西时放置我的相机。"}, {"type": "subtitle", "time": 3968.23, "timestamp": "01:06:08", "text": "[音乐] 是的"}, {"type": "subtitle", "time": 3969.31, "timestamp": "01:06:09", "text": "。"}, {"type": "subtitle", "time": 3971.59, "timestamp": "01:06:11", "text": "我一直用它搭配我"}, {"type": "chat", "time": 3972.292, "timestamp": "01:06:12", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "mhm mhm"}, {"type": "subtitle", "time": 3975.03, "timestamp": "01:06:15", "text": "从印度带来的麦克风。 还是那款Fifine麦克风。"}, {"type": "subtitle", "time": 3977.43, "timestamp": "01:06:17", "text": "所以，我真庆幸自己买了这支麦克风。"}, {"type": "subtitle", "time": 3979.95, "timestamp": "01:06:19", "text": "如果我要从这里买麦克风，我"}, {"type": "subtitle", "time": 3982.19, "timestamp": "01:06:22", "text": "现在肯定穷死了。 我将无法进行"}, {"type": "subtitle", "time": 3984.59, "timestamp": "01:06:24", "text": "任何直播或录制。 所以我真的真的真的很"}, {"type": "subtitle", "time": 3987.15, "timestamp": "01:06:27", "text": "高兴"}, {"type": "chat", "time": 3988.954, "timestamp": "01:06:28", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "oh"}, {"type": "subtitle", "time": 3990.63, "timestamp": "01:06:30", "text": "我带了我的[笑声]麦克风。"}, {"type": "subtitle", "time": 3991.79, "timestamp": "01:06:31", "text": "所以，"}, {"type": "subtitle", "time": 4010.19, "timestamp": "01:06:50", "text": "。 我真的"}, {"type": "subtitle", "time": 4012.27, "timestamp": "01:06:52", "text": "需要重新学习如何直播，"}, {"type": "subtitle", "time": 4014.31, "timestamp": "01:06:54", "text": "因为已经有一段时间没直播了，所以我忘记了该"}, {"type": "subtitle", "time": 4015.63, "timestamp": "01:06:55", "text": "怎么做，该怎么做，以及"}, {"type": "subtitle", "time": 4019.23, "timestamp": "01:06:59", "text": "所有相关的事情。 所以请在"}]
[{"type": "subtitle", "time": 3842.99, "timestamp": "01:04:02", "text": "，我的确想那样做。 我必须尽我所能去吸引"}, {"type": "subtitle", "time": 3845.91, "timestamp": "01:04:05", "text": "日本"}, {"type": "subtitle", "time": 3848.75, "timestamp": "01:04:08", "text": "观众，这样我就可以阅读日本的"}, {"type": "subtitle", "time": 3850.87, "timestamp": "01:04:10", "text": "评论，还有很多其他原因。"}, {"type": "subtitle", "time": 3852.35, "timestamp": "01:04:12", "text": "饮料怎么样？ 他们"}, {"type": "subtitle", "time": 3854.19, "timestamp": "01:04:14", "text": "对我做的日式盒饭赞不绝口。   是的"}, {"type": "subtitle", "time": 3856.79, "timestamp": "01:04:16", "text": "。 我的天啊。"}, {"type": "subtitle", "time": 3860.11, "timestamp": "01:04:20", "text": "我刚才喝了一罐能量饮料。"}, {"type": "subtitle", "time": 3861.91, "timestamp": "01:04:21", "text": "嗯，"}, {"type": "subtitle", "time": 3864.03, "timestamp": "01:04:24", "text": "真的很好。 不是什么怪物之类的"}, {"type": "subtitle", "time": 3865.55, "timestamp": "01:04:25", "text": "。 这类自动售货机"}, {"type": "subtitle", "time": 3867.75, "timestamp": "01:04:27", "text": "确实不错，但是"}, {"type": "subtitle", "time": 3869.31, "timestamp": "01:04:29", "text": "起价是 100"}, {"type": "subtitle", "time": 3870.23, "timestamp": "01:04:30", "text": "日元。"}, {"type": "subtitle", "time": 3875.19, "timestamp": "01:04:35", "text": "120、140、150。每个……它们不像"}, {"type": "subtitle", "time": 3878.35, "timestamp": "01:04:38", "text": "印度那样有最高零售价，对吧？ 所以，"}, {"type": "subtitle", "time": 3881.19, "timestamp": "01:04:41", "text": "不同的"}, {"type": "subtitle", "time": 3883.39, "timestamp": "01:04:43", "text": "卖家可以自行定价。 就像"}, {"type": "subtitle", "time": 3886.95, "timestamp": "01:04:46", "text": "学校里的自动"}, {"type": "subtitle", "time": 3890.27, "timestamp": "01:04:50", "text": "售货机一样，它更便宜。  100"}, {"type": "subtitle", "time": 3893.27, "timestamp": "01:04:53", "text": "日元，就能买到像可口可乐那样好喝的饮料。"}, {"type": "subtitle", "time": 3899.03, "timestamp": "01:04:59", "text": "他叫什么名字？ 它叫什么名字？ 呃，"}]
[{"type": "subtitle", "time": 660.51, "timestamp": "00:11:00", "text": "Twitch、またはKickで視聴している方は、何か質問があれば遠慮なく聞いてください。 えっと、もしあなたが"}, {"type": "subtitle", "time": 663.31, "timestamp": "00:11:03", "text": "YouTubeを使っているなら、遠慮なく質問してください。"}, {"type": "subtitle", "time": 665.71, "timestamp": "00:11:05", "text": "そういう質問があるんです。 どうぞ"}, {"type": "subtitle", "time": 668.03, "timestamp": "00:11:08", "text": "ご遠慮なくクリックしてください。そうすれば、"}, {"type": "subtitle", "time": 671.79, "timestamp": "00:11:11", "text": "あなたの質問にお答えできます。 私たちはそうでしょうか？"}, {"type": "subtitle", "time": 673.19, "timestamp": "00:11:13", "text": "こんにちは。"}, {"type": "subtitle", "time": 674.67, "timestamp": "00:11:14", "text": "えっと、"}, {"type": "subtitle", "time": 678.11, "timestamp": "00:11:18", "text": "1秒。 ポップアップチャット。   俺の"}, {"type": "subtitle", "time": 681.19, "timestamp": "00:11:21", "text": "持ち物はすごく傷だらけだよ。   えっと、"}, {"type": "subtitle", "time": 685.23, "timestamp": "00:11:25", "text": "ファイル全部失ってしまいました。   バックアップを取ったつもりだったんだ"}, {"type": "subtitle", "time": 688.23, "timestamp": "00:11:28", "text": "けど、やっぱりダメだった"}, {"type": "subtitle", "time": 690.67, "timestamp": "00:11:30", "text": "。 バックアップの仕方を"}, {"type": "subtitle", "time": 691.91, "timestamp": "00:11:31", "text": "間違えました。"}, {"type": "subtitle", "time": 693.51, "timestamp": "00:11:33", "text": "フォルダはありますが、ファイルがありません"}, {"type": "subtitle", "time": 695.83, "timestamp": "00:11:35", "text": "。"}, {"type": "subtitle", "time": 698.95, "timestamp": "00:11:38", "text": "どうにかしてPNG画像が"}, {"type": "subtitle", "time": 700.63, "timestamp": "00:11:40", "text": "使えるようになった。"}, {"type": "subtitle", "time": 703.31, "timestamp": "00:11:43", "text": "設定を忘れてしまったので、"}, {"type": "subtitle", "time": 713.04, "timestamp": "00:11:53", "text": "、 今日本にいるから、"}]
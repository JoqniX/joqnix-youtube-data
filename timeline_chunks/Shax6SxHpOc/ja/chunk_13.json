[{"type": "subtitle", "time": 783.95, "timestamp": "00:13:03", "text": "こんにちは、小さな声。 あれは"}, {"type": "subtitle", "time": 788.19, "timestamp": "00:13:08", "text": "暗闇なのか？ ええ、ここにいますよ。 こんにちは。"}, {"type": "subtitle", "time": 789.63, "timestamp": "00:13:09", "text": "こんにちは。 こんにちは。 お越しいただきありがとうございます。"}, {"type": "subtitle", "time": 792.59, "timestamp": "00:13:12", "text": "こんにちは。 こんにちは。 待って、背景が"}, {"type": "subtitle", "time": 796.15, "timestamp": "00:13:16", "text": "明るすぎませんか？"}, {"type": "subtitle", "time": 802.55, "timestamp": "00:13:22", "text": "もう少し"}, {"type": "subtitle", "time": 808.67, "timestamp": "00:13:28", "text": "暗すぎないように。"}, {"type": "subtitle", "time": 810.55, "timestamp": "00:13:30", "text": "こんにちは。 えっと、"}, {"type": "subtitle", "time": 812.43, "timestamp": "00:13:32", "text": "オーバーレイとか何も持ってないから、スカーフは気にしないでね"}, {"type": "subtitle", "time": 814.03, "timestamp": "00:13:34", "text": "、いい？"}, {"type": "subtitle", "time": 816.03, "timestamp": "00:13:36", "text": "よし、みんな。"}, {"type": "subtitle", "time": 822.63, "timestamp": "00:13:42", "text": "スカーフは気にしないでください。"}, {"type": "subtitle", "time": 824.43, "timestamp": "00:13:44", "text": "ええ、そうですね。 ええと、そうです"}, {"type": "subtitle", "time": 828.07, "timestamp": "00:13:48", "text": "。"}, {"type": "subtitle", "time": 829.71, "timestamp": "00:13:49", "text": "どうすればいいですか？   しばらく"}, {"type": "subtitle", "time": 831.59, "timestamp": "00:13:51", "text": "配信していなかったので、いろいろ"}, {"type": "subtitle", "time": 834.03, "timestamp": "00:13:54", "text": "忘れてしまいました。   うーん"}, {"type": "subtitle", "time": 839.87, "timestamp": "00:13:59", "text": "。 はい、どうぞ。 では、"}]
[{"type": "subtitle", "time": 4562.87, "timestamp": "01:16:02", "text": "パソコンを買った当初はゲームをしてみたのですが、なぜかやりすぎな気がしてやめてしまいました"}, {"type": "subtitle", "time": 4571.71, "timestamp": "01:16:11", "text": "。   だから、"}, {"type": "subtitle", "time": 4575.43, "timestamp": "01:16:15", "text": "新しいノートパソコンを手に入れた後、最初にプレイしたゲームは"}, {"type": "subtitle", "time": 4577.35, "timestamp": "01:16:17", "text": "アサシン クリード オデッセイだったのが気に入っています。というのも、このゲームを買ったのですが、"}, {"type": "subtitle", "time": 4586.23, "timestamp": "01:16:26", "text": "以前インドにいた頃は自分のPCではプレイできなかったからです。"}, {"type": "subtitle", "time": 4593.15, "timestamp": "01:16:33", "text": "確か、そのストリームを20回くらいやったよね？"}, {"type": "subtitle", "time": 4595.99, "timestamp": "01:16:35", "text": "そう、"}, {"type": "subtitle", "time": 4598.19, "timestamp": "01:16:38", "text": "私もプレイしたよ。 最初は"}, {"type": "subtitle", "time": 4599.63, "timestamp": "01:16:39", "text": "うまく演奏できたんだけど、しばらくすると"}, {"type": "subtitle", "time": 4601.27, "timestamp": "01:16:41", "text": "「ああ、"}, {"type": "subtitle", "time": 4607.27, "timestamp": "01:16:47", "text": "、少々お待ちください"}, {"type": "subtitle", "time": 4609.51, "timestamp": "01:16:49", "text": "。"}, {"type": "subtitle", "time": 4616.55, "timestamp": "01:16:56", "text": "それに、"}, {"type": "subtitle", "time": 4617.79, "timestamp": "01:16:57", "text": "画面が1つしかないし、ノート"}, {"type": "subtitle", "time": 4619.63, "timestamp": "01:16:59", "text": "パソコンだから、"}]
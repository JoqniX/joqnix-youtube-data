[{"type": "subtitle", "time": 5222.27, "timestamp": "01:27:02", "text": "ダニエル・サンさん、お越しいただきありがとうございます。"}, {"type": "subtitle", "time": 5225.51, "timestamp": "01:27:05", "text": "Codyさん、Twitchに来てくれてありがとう。"}, {"type": "subtitle", "time": 5228.39, "timestamp": "01:27:08", "text": "キャロライン、来てくれてありがとう。"}, {"type": "subtitle", "time": 5231.27, "timestamp": "01:27:11", "text": "ラバーボーイ・サン、来てくれてありがとう。"}, {"type": "subtitle", "time": 5233.27, "timestamp": "01:27:13", "text": "ラリシアさん、来​​てくれてありがとう。"}, {"type": "subtitle", "time": 5235.03, "timestamp": "01:27:15", "text": "シェリ・サンが今日訪ねてきた。"}, {"type": "subtitle", "time": 5237.87, "timestamp": "01:27:17", "text": "シェリさん、来てくれてありがとう。   ご"}, {"type": "subtitle", "time": 5239.39, "timestamp": "01:27:19", "text": "心配なく、遠慮なく"}, {"type": "subtitle", "time": 5241.03, "timestamp": "01:27:21", "text": "スパム投稿してください。 すべて順調です。"}, {"type": "subtitle", "time": 5243.31, "timestamp": "01:27:23", "text": "私は窮地に立たされている。 お越しいただきありがとうございます。"}, {"type": "subtitle", "time": 5245.91, "timestamp": "01:27:25", "text": "マルセリーナさん、来てくれてありがとう。"}, {"type": "subtitle", "time": 5247.31, "timestamp": "01:27:27", "text": "モンキー・D・ドラゴン、来てくれてありがとう"}, {"type": "subtitle", "time": 5249.55, "timestamp": "01:27:29", "text": "。 エドワード・サンさん、来てくれてありがとう。"}, {"type": "subtitle", "time": 5251.87, "timestamp": "01:27:31", "text": "そして、私のTwitch"}, {"type": "subtitle", "time": 5253.27, "timestamp": "01:27:33", "text": "配信が衰退していることを教えてくれてありがとう。"}, {"type": "subtitle", "time": 5256.71, "timestamp": "01:27:36", "text": "まあ、今はまだ大丈夫だと思う。"}, {"type": "subtitle", "time": 5260.59, "timestamp": "01:27:40", "text": "フィードが停止しました。 ピクピクとキック。   はい"}, {"type": "subtitle", "time": 5261.83, "timestamp": "01:27:41", "text": "、スーリヤ・サンさん、お越しいただきありがとうございました"}, {"type": "subtitle", "time": 5263.83, "timestamp": "01:27:43", "text": "。"}, {"type": "subtitle", "time": 5267.15, "timestamp": "01:27:47", "text": "そしてダニエル・サンさん、お越しいただきありがとうございました。"}, {"type": "subtitle", "time": 5269.03, "timestamp": "01:27:49", "text": "ユキドキサン。"}, {"type": "subtitle", "time": 5270.71, "timestamp": "01:27:50", "text": "あなたがまだここにいるかどうかわかりませんが、"}, {"type": "subtitle", "time": 5273.15, "timestamp": "01:27:53", "text": "来てくれてありがとう。"}, {"type": "subtitle", "time": 5274.71, "timestamp": "01:27:54", "text": "Twitchでの配信が終了しました。"}, {"type": "subtitle", "time": 5276.23, "timestamp": "01:27:56", "text": "ええ、"}, {"type": "subtitle", "time": 5278.695, "timestamp": "01:27:58", "text": "返信できませんでした。 すみません、今。"}, {"type": "subtitle", "time": 5279.27, "timestamp": "01:27:59", "text": "[鼻を鳴らす]"}]
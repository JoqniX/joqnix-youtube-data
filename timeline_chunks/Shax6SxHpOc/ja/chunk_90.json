[{"type": "subtitle", "time": 5400.59, "timestamp": "01:30:00", "text": "私が日本で新たな章をスタートさせるこの旅路に、皆さんが立ち会ってくださったことに感謝します。   ええ、そうですね。   全力を尽くします"}, {"type": "subtitle", "time": 5403.83, "timestamp": "01:30:03", "text": "。"}, {"type": "subtitle", "time": 5405.83, "timestamp": "01:30:05", "text": "皆さんも最善を尽くしてください。"}, {"type": "subtitle", "time": 5407.95, "timestamp": "01:30:07", "text": "夢の実現を祈っています。これからも"}, {"type": "subtitle", "time": 5410.91, "timestamp": "01:30:10", "text": "ベストを尽くしてください。 よし。"}, {"type": "subtitle", "time": 5413.71, "timestamp": "01:30:13", "text": "では、ジョークとは何でしょうか？"}, {"type": "subtitle", "time": 5414.87, "timestamp": "01:30:14", "text": "皆さんが知っておくべきたった一つのことをきちんと守ってくださり、ありがとうございました"}, {"type": "subtitle", "time": 5416.67, "timestamp": "01:30:16", "text": "。 本日はお越しいただき、ありがとうございました"}, {"type": "subtitle", "time": 5418.39, "timestamp": "01:30:18", "text": "。   それでは、また"}, {"type": "subtitle", "time": 5421.23, "timestamp": "01:30:21", "text": "次回お会いしましょう。 どうしたの"}, {"type": "subtitle", "time": 5423.71, "timestamp": "01:30:23", "text": "？ 息子を持つ母親にとって良いことは何ですか"}, {"type": "subtitle", "time": 5454.35, "timestamp": "01:30:54", "text": "こんにちは、さようなら。 ご来場いただいた皆様、ありがとうございました。"}]
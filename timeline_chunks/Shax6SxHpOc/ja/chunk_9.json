[{"type": "subtitle", "time": 540.87, "timestamp": "00:09:00", "text": "。   あの、"}, {"type": "subtitle", "time": 542.67, "timestamp": "00:09:02", "text": "もしルームメイトの声が聞こえても、気にしないでください"}, {"type": "subtitle", "time": 545.91, "timestamp": "00:09:05", "text": "。  1秒（音楽）。"}, {"type": "subtitle", "time": 548.07, "timestamp": "00:09:08", "text": "ええ、そうですね。"}, {"type": "subtitle", "time": 550.15, "timestamp": "00:09:10", "text": "私はシェア"}, {"type": "subtitle", "time": 551.75, "timestamp": "00:09:11", "text": "ハウス"}, {"type": "subtitle", "time": 553.471, "timestamp": "00:09:13", "text": "かアパートに住んでいます。"}, {"type": "subtitle", "time": 553.55, "timestamp": "00:09:13", "text": "[音楽]"}, {"type": "subtitle", "time": 554.43, "timestamp": "00:09:14", "text": "ええと、"}, {"type": "subtitle", "time": 558.43, "timestamp": "00:09:18", "text": "それで、今はルームメイトがいます。 うん。 だから、彼は"}, {"type": "subtitle", "time": 561.75, "timestamp": "00:09:21", "text": "料理をして、私は掃除とか雑用をするんです。"}, {"type": "subtitle", "time": 564.15, "timestamp": "00:09:24", "text": "うん。 そして、私は"}, {"type": "subtitle", "time": 567.99, "timestamp": "00:09:27", "text": "VODではなく、ブログを"}, {"type": "subtitle", "time": 571.35, "timestamp": "00:09:31", "text": "1週間前にアップロードする予定だったんです。"}, {"type": "subtitle", "time": 573.95, "timestamp": "00:09:33", "text": "しかし、私は遅刻してしまった。 やらなければならないことがいくつかあった。"}, {"type": "subtitle", "time": 575.87, "timestamp": "00:09:35", "text": "私は忙しかった。"}, {"type": "subtitle", "time": 578.27, "timestamp": "00:09:38", "text": "ええ、私は自由時間なんて全く欲しくないんです"}, {"type": "subtitle", "time": 579.31, "timestamp": "00:09:39", "text": "。"}, {"type": "subtitle", "time": 581.95, "timestamp": "00:09:41", "text": "本当は今日ではなく、もっと早くVlogを公開する予定だったんです"}, {"type": "subtitle", "time": 586.11, "timestamp": "00:09:46", "text": "。"}, {"type": "subtitle", "time": 588.55, "timestamp": "00:09:48", "text": "1時間ほど前に投稿したばかりなのに、今、こんな"}, {"type": "subtitle", "time": 593.07, "timestamp": "00:09:53", "text": "何？"}, {"type": "subtitle", "time": 594.99, "timestamp": "00:09:54", "text": "信じられますか？"}, {"type": "subtitle", "time": 597.63, "timestamp": "00:09:57", "text": "ええ、それではお知らせです。"}]
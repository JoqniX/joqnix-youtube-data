[{"type": "subtitle", "time": 4982.83, "timestamp": "01:23:02", "text": "2TBのドライブも含めて両方のドライブを読み取ることができます。   私は"}, {"type": "subtitle", "time": 4983.95, "timestamp": "01:23:03", "text": "待つ。"}, {"type": "subtitle", "time": 4986.51, "timestamp": "01:23:06", "text": "実は2TB"}, {"type": "subtitle", "time": 4988.91, "timestamp": "01:23:08", "text": "バージョンのノートパソコンを買ったので、容量はかなり大きいです"}, {"type": "subtitle", "time": 4991.63, "timestamp": "01:23:11", "text": "。"}, {"type": "subtitle", "time": 4995.07, "timestamp": "01:23:15", "text": "2TBですか？それとも何ですか？ ちょっと確認させてください。"}, {"type": "subtitle", "time": 4998.39, "timestamp": "01:23:18", "text": "そう、2TB、そうだね。  2TB、2TB、"}, {"type": "subtitle", "time": 4999.55, "timestamp": "01:23:19", "text": "うん。"}, {"type": "subtitle", "time": 5002.11, "timestamp": "01:23:22", "text": "もちろん、2TBであるべきです。 だから、それで十分だろう"}, {"type": "subtitle", "time": 5003.71, "timestamp": "01:23:23", "text": "。   うんうん"}, {"type": "subtitle", "time": 5021.43, "timestamp": "01:23:41", "text": "しかし問題は、"}, {"type": "subtitle", "time": 5024.95, "timestamp": "01:23:44", "text": "OBSの設定をすべて失ってしまったことです。 メールの設定と同じように、それを失くしてしまいました"}, {"type": "subtitle", "time": 5026.39, "timestamp": "01:23:46", "text": "。"}, {"type": "subtitle", "time": 5029.19, "timestamp": "01:23:49", "text": "ええと、モデルとかはありますよ。 私が"}, {"type": "subtitle", "time": 5032.63, "timestamp": "01:23:52", "text": "以前使っていた資産は、どこかに紛失してしまった。"}, {"type": "subtitle", "time": 5035.63, "timestamp": "01:23:55", "text": "バックアップデータは持ってきましたが、"}, {"type": "subtitle", "time": 5037.35, "timestamp": "01:23:57", "text": "クラウドなどに完全にバックアップされているわけではありません"}]
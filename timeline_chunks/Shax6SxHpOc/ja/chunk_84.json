[{"type": "subtitle", "time": 5040.59, "timestamp": "01:24:00", "text": "。 映像制作スタジオの仕事は"}, {"type": "subtitle", "time": 5042.63, "timestamp": "01:24:02", "text": "全部私がやりました。   つまり、"}, {"type": "subtitle", "time": 5047.43, "timestamp": "01:24:07", "text": "使えるライブ2Dモデルがないってことですよね？ あなたは"}, {"type": "subtitle", "time": 5049.63, "timestamp": "01:24:09", "text": "まだパプアニューギニアにいる。"}, {"type": "subtitle", "time": 5052.03, "timestamp": "01:24:12", "text": "うん。"}, {"type": "subtitle", "time": 5054.83, "timestamp": "01:24:14", "text": "私たちは今のところまだパプアニューギニアです。 でも、"}, {"type": "subtitle", "time": 5055.79, "timestamp": "01:24:15", "text": "ええ、そうですね。"}, {"type": "subtitle", "time": 5058.11, "timestamp": "01:24:18", "text": "新しいモデルを開発中なんですよね"}, {"type": "subtitle", "time": 5059.39, "timestamp": "01:24:19", "text": "？"}, {"type": "subtitle", "time": 5062.67, "timestamp": "01:24:22", "text": "今年中にそこへ行く予定です。"}, {"type": "subtitle", "time": 5064.95, "timestamp": "01:24:24", "text": "日付を明かすべきではないことは分かっています。 まだ"}, {"type": "subtitle", "time": 5067.31, "timestamp": "01:24:27", "text": "完全には完成していません。"}, {"type": "subtitle", "time": 5069.23, "timestamp": "01:24:29", "text": "ええ、新型モデルは"}, {"type": "subtitle", "time": 5072.23, "timestamp": "01:24:32", "text": "もうすぐ完成しますよ。今年か"}, {"type": "subtitle", "time": 5074.39, "timestamp": "01:24:34", "text": "来年には完成するかもしれませんね。 それでおしまい。"}, {"type": "subtitle", "time": 5076.15, "timestamp": "01:24:36", "text": "うん、それは前からずっと言っていることだよ"}, {"type": "subtitle", "time": 5077.71, "timestamp": "01:24:37", "text": "。"}, {"type": "subtitle", "time": 5082.27, "timestamp": "01:24:42", "text": "モデル制作のために寄付してくれた人もたくさんいましたし、"}, {"type": "subtitle", "time": 5085.39, "timestamp": "01:24:45", "text": "昨年サバトンのプロジェクトを行った時にも寄付してくれました。"}, {"type": "subtitle", "time": 5086.71, "timestamp": "01:24:46", "text": "うん。"}, {"type": "subtitle", "time": 5089.87, "timestamp": "01:24:49", "text": "1月、あぁ"}, {"type": "subtitle", "time": 5091.55, "timestamp": "01:24:51", "text": "。   他に何が"}, {"type": "subtitle", "time": 5094.99, "timestamp": "01:24:54", "text": "残っていますか？ 書き留めておくべきだった"}, {"type": "subtitle", "time": 5097.71, "timestamp": "01:24:57", "text": "。 言いたいことがたくさんあった。"}, {"type": "subtitle", "time": 5099.51, "timestamp": "01:24:59", "text": "でも今日はたくさん話しました。 とても"}]
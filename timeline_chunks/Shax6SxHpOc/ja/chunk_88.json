[{"type": "subtitle", "time": 5280.99, "timestamp": "01:28:00", "text": "それから、Wilden Sunさん、来てくれてありがとう。"}, {"type": "subtitle", "time": 5286.11, "timestamp": "01:28:06", "text": "私の配信に参加していただいてからしばらく経ちますが、来てくれてありがとう。"}, {"type": "subtitle", "time": 5288.07, "timestamp": "01:28:08", "text": "あなたもDiscord"}, {"type": "subtitle", "time": 5290.35, "timestamp": "01:28:10", "text": "サーバーに参加しましたよね？   改めて、"}, {"type": "subtitle", "time": 5292.83, "timestamp": "01:28:12", "text": "ありがとうございました。"}, {"type": "subtitle", "time": 5295.31, "timestamp": "01:28:15", "text": "皆様、ありがとうございました。 ベーコンがここにあります。"}, {"type": "subtitle", "time": 5297.99, "timestamp": "01:28:17", "text": "ベーコンさん、来てくれてありがとう。"}, {"type": "subtitle", "time": 5299.59, "timestamp": "01:28:19", "text": "そして、アストラが"}, {"type": "subtitle", "time": 5308.31, "timestamp": "01:28:28", "text": "サバットさんも来てくれました。"}, {"type": "subtitle", "time": 5316.75, "timestamp": "01:28:36", "text": "そして、パンがここにあった。 パンさん、ありがとう。"}, {"type": "subtitle", "time": 5335.83, "timestamp": "01:28:55", "text": "、以上です。"}, {"type": "subtitle", "time": 5338.43, "timestamp": "01:28:58", "text": "ええ、まあまあでした。 こんにちは。"}]
[{"type": "subtitle", "time": 1261.07, "timestamp": "00:21:01", "text": "思う。"}, {"type": "subtitle", "time": 1264.99, "timestamp": "00:21:04", "text": "もっと音楽コンテンツが欲しい。"}, {"type": "subtitle", "time": 1267.27, "timestamp": "00:21:07", "text": "そしてその下には、"}, {"type": "subtitle", "time": 1269.59, "timestamp": "00:21:09", "text": "音楽制作、"}, {"type": "subtitle", "time": 1273.87, "timestamp": "00:21:13", "text": "ストリーム、回路、ストリーム、そして、"}, {"type": "subtitle", "time": 1280.83, "timestamp": "00:21:20", "text": "チャレンジのようなものがあります。   ということで"}, {"type": "subtitle", "time": 1282.91, "timestamp": "00:21:22", "text": "、私たちはチャレンジ企画を実施します。 私はそれに"}, {"type": "subtitle", "time": 1284.19, "timestamp": "00:21:24", "text": "異議を唱えたい。"}, {"type": "subtitle", "time": 1286.19, "timestamp": "00:21:26", "text": "よし、３番目だ。   「読ませて」"}, {"type": "subtitle", "time": 1289.19, "timestamp": "00:21:29", "text": "チャットとは何ですか。"}, {"type": "subtitle", "time": 1290.43, "timestamp": "00:21:30", "text": "えっと、"}, {"type": "subtitle", "time": 1292.59, "timestamp": "00:21:32", "text": "既読チャットを見るにはどうすればいいですか？ ええと、そうしましょう"}, {"type": "subtitle", "time": 1294.15, "timestamp": "00:21:34", "text": "。   よし"}, {"type": "subtitle", "time": 1295.79, "timestamp": "00:21:35", "text": "。   えーっと"}, {"type": "subtitle", "time": 1298.91, "timestamp": "00:21:38", "text": "、とにかく、私はフィリピン語を"}, {"type": "subtitle", "time": 1300.43, "timestamp": "00:21:40", "text": "少し、日本語と韓国語を話せます。 ああ、"}, {"type": "subtitle", "time": 1303.79, "timestamp": "00:21:43", "text": "それはすごくクールだね。 それはすごくクールだね。 あなたが"}, {"type": "subtitle", "time": 1308.695, "timestamp": "00:21:48", "text": "あなたが知っている。"}, {"type": "subtitle", "time": 1309.75, "timestamp": "00:21:49", "text": "[笑い]"}, {"type": "subtitle", "time": 1312.67, "timestamp": "00:21:52", "text": "だから、私は、ええと、"}]
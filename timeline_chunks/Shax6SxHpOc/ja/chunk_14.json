[{"type": "subtitle", "time": 845.15, "timestamp": "00:14:05", "text": "お知らせ。"}, {"type": "subtitle", "time": 846.51, "timestamp": "00:14:06", "text": "右。   必ず成功させます"}, {"type": "subtitle", "time": 848.11, "timestamp": "00:14:08", "text": "。"}, {"type": "subtitle", "time": 848.87, "timestamp": "00:14:08", "text": "わかった。"}, {"type": "subtitle", "time": 850.91, "timestamp": "00:14:10", "text": "そこで会おう。 そこで会うことは知っています。"}, {"type": "subtitle", "time": 852.67, "timestamp": "00:14:12", "text": "わかった。 ココ。"}, {"type": "subtitle", "time": 853.79, "timestamp": "00:14:13", "text": "こんにちは。"}, {"type": "subtitle", "time": 855.79, "timestamp": "00:14:15", "text": "そして、私はここに"}, {"type": "subtitle", "time": 860.83, "timestamp": "00:14:20", "text": "2ヶ月、いや2年間滞在するので、時々日本語を使うつもりです。"}, {"type": "subtitle", "time": 863.35, "timestamp": "00:14:23", "text": "右。 私が"}, {"type": "subtitle", "time": 865.47, "timestamp": "00:14:25", "text": "日本に来たのは、"}, {"type": "subtitle", "time": 866.83, "timestamp": "00:14:26", "text": "日本語を学び、"}, {"type": "subtitle", "time": 869.31, "timestamp": "00:14:29", "text": "日本語を流暢に話せるようになりたかったからです。 そして"}, {"type": "subtitle", "time": 871.39, "timestamp": "00:14:31", "text": "私の語学コースは、私は"}, {"type": "subtitle", "time": 873.63, "timestamp": "00:14:33", "text": "現在日本で語学を学んでいる留学生です。"}, {"type": "subtitle", "time": 875.15, "timestamp": "00:14:35", "text": "だから、"}, {"type": "subtitle", "time": 876.95, "timestamp": "00:14:36", "text": "私はここに2年間滞在します。 私の語学"}, {"type": "subtitle", "time": 879.23, "timestamp": "00:14:39", "text": "コースは2年間です。"}, {"type": "subtitle", "time": 883.11, "timestamp": "00:14:43", "text": "だから、"}, {"type": "subtitle", "time": 885.67, "timestamp": "00:14:45", "text": "2年以内にはN3、N1、もしくはN2のどれかを取得できるよう、全力を尽くしたいと思っています。 就職するためにN2が必要なんです。"}, {"type": "subtitle", "time": 889.43, "timestamp": "00:14:49", "text": "暑いですね。   ということで"}, {"type": "subtitle", "time": 890.55, "timestamp": "00:14:50", "text": "、"}, {"type": "subtitle", "time": 893.829, "timestamp": "00:14:53", "text": "現在の私のレベルはN4です。 私のN3の授業は"}, {"type": "subtitle", "time": 896.829, "timestamp": "00:14:56", "text": "来週、今週の月曜日から始まります。 うん。"}]
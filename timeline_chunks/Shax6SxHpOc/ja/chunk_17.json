[{"type": "subtitle", "time": 1020.829, "timestamp": "00:17:00", "text": "まあ、そうですね。"}, {"type": "subtitle", "time": 1023.35, "timestamp": "00:17:03", "text": "今はノートパソコンを持っているので、この配信は"}, {"type": "subtitle", "time": 1025.35, "timestamp": "00:17:05", "text": "そのノートパソコン、つまり私が新しく"}, {"type": "chat", "time": 1025.816, "timestamp": "00:17:05", "author": "@Shiori_mitsuki", "avatar": "https://yt4.ggpht.com/Dn0VbakjSKrSNaXx6PyhznuqbomoCGx22ivSawRcMXp25Io7cfsud3H3qP-g9QprPJUESlxxtJA=s64-c-k-c0x00ffffff-no-rj", "message": "gomen"}, {"type": "subtitle", "time": 1026.39, "timestamp": "00:17:06", "text": "買ったノートパソコンから行っています。"}, {"type": "subtitle", "time": 1029.11, "timestamp": "00:17:09", "text": "それはかなり強力なものだ。"}, {"type": "subtitle", "time": 1031.47, "timestamp": "00:17:11", "text": "GTX、いやRTX"}, {"type": "subtitle", "time": 1036.189, "timestamp": "00:17:16", "text": "5060 GPUと優れたRyzen CPUを搭載しています。 うん、"}, {"type": "subtitle", "time": 1039.27, "timestamp": "00:17:19", "text": "すごくいいよ。 本当に便利で、ノート"}, {"type": "subtitle", "time": 1043.429, "timestamp": "00:17:23", "text": "パソコンを買った理由は2つあります。   それとは別に、"}, {"type": "chat", "time": 1044.299, "timestamp": "00:17:24", "author": "@MarcelineDichosa-e8b", "avatar": "https://yt4.ggpht.com/ytc/AIdro_lPAu5LcUW1h_9K92DDPIFAt7oKeKn1gaScOAfzdeLy0FyHMrhcwYmEo-u21qNz3kJRkA=s64-c-k-c0x00ffffff-no-rj", "message": "HIIII FIRST TIMER HERE"}, {"type": "subtitle", "time": 1047.069, "timestamp": "00:17:27", "text": "ストリーミング配信も行われており、主に"}, {"type": "subtitle", "time": 1049.83, "timestamp": "00:17:29", "text": "音楽に焦点を当てています。"}, {"type": "subtitle", "time": 1052.15, "timestamp": "00:17:32", "text": "私のブログをご覧になっていない方は既にご覧になっていると思いますが、"}, {"type": "subtitle", "time": 1059.59, "timestamp": "00:17:39", "text": "日本に来てからの私の目標について既に書いていますよね？ つまり、"}, {"type": "subtitle", "time": 1061.79, "timestamp": "00:17:41", "text": "発表内容の一つとして、"}, {"type": "subtitle", "time": 1063.71, "timestamp": "00:17:43", "text": "ストリーミング配信が"}, {"type": "subtitle", "time": 1069.27, "timestamp": "00:17:49", "text": "二言語対応になるということが挙げられます。"}, {"type": "subtitle", "time": 1071.39, "timestamp": "00:17:51", "text": "つまり、つまり、えっと"}, {"type": "subtitle", "time": 1075.11, "timestamp": "00:17:55", "text": "、どうやって"}, {"type": "subtitle", "time": 1077.31, "timestamp": "00:17:57", "text": "スペースをもう一度入れるんですか？"}, {"type": "subtitle", "time": 1078.95, "timestamp": "00:17:58", "text": "えっと、こんな感じ？"}]
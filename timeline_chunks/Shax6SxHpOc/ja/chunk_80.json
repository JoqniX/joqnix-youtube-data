[{"type": "subtitle", "time": 4801.99, "timestamp": "01:20:01", "text": "ですから、それについては取り組んでいきます。 えっと、"}, {"type": "subtitle", "time": 4804.55, "timestamp": "01:20:04", "text": "2つ目のvlogみたいなやつ、"}, {"type": "subtitle", "time": 4815.51, "timestamp": "01:20:15", "text": "日本滞在中に撮影した映像が本当にたくさんあるんです。 さて、"}, {"type": "subtitle", "time": 4818.71, "timestamp": "01:20:18", "text": "いくつか映像を撮影しました。"}, {"type": "subtitle", "time": 4822.51, "timestamp": "01:20:22", "text": "少しずつ、一つずつ共有していきたいと思っています。"}, {"type": "subtitle", "time": 4824.71, "timestamp": "01:20:24", "text": "まあ、まあ。"}, {"type": "subtitle", "time": 4825.59, "timestamp": "01:20:25", "text": "こんにちは。   えっと、じゃあ、あと"}, {"type": "subtitle", "time": 4831.51, "timestamp": "01:20:31", "text": "10分あるってことにしましょう。"}, {"type": "subtitle", "time": 4834.43, "timestamp": "01:20:34", "text": "1時間21分ですよね？   わかった"}, {"type": "subtitle", "time": 4836.39, "timestamp": "01:20:36", "text": "。 それでは、あと10"}, {"type": "subtitle", "time": 4838.31, "timestamp": "01:20:38", "text": "分で終わりにしましょう。"}, {"type": "subtitle", "time": 4840.23, "timestamp": "01:20:40", "text": "2時間という目標は達成しない。"}, {"type": "subtitle", "time": 4842.99, "timestamp": "01:20:42", "text": "1時間"}, {"type": "subtitle", "time": 4844.87, "timestamp": "01:20:44", "text": "30分以内に終わらせます。 こんにちは。"}, {"type": "subtitle", "time": 4845.735, "timestamp": "01:20:45", "text": "うん。"}, {"type": "subtitle", "time": 4846.35, "timestamp": "01:20:46", "text": "[鼻を鳴らす] というわけで、"}, {"type": "chat", "time": 4856.604, "timestamp": "01:20:56", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "mhm"}]
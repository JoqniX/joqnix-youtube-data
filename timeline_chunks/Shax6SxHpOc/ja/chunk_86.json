[{"type": "subtitle", "time": 5161.79, "timestamp": "01:26:01", "text": "うん、最大でも1時間か30分くらいかな"}, {"type": "subtitle", "time": 5163.83, "timestamp": "01:26:03", "text": "。"}, {"type": "subtitle", "time": 5166.034, "timestamp": "01:26:06", "text": "日本のユーチューバーが今やっているように、"}, {"type": "subtitle", "time": 5169.75, "timestamp": "01:26:09", "text": "朝の「あー、こんにちは"}, {"type": "subtitle", "time": 5171.91, "timestamp": "01:26:11", "text": "ユーチューバーさん、おはようございます」みたいな配信をすればいいんじゃない？"}, {"type": "subtitle", "time": 5177.15, "timestamp": "01:26:17", "text": "Twitterにはそういう音楽を作っている人たちがいます。 そのトレンドに追随する人々を見てください"}, {"type": "subtitle", "time": 5178.67, "timestamp": "01:26:18", "text": "。   そうすることも"}, {"type": "subtitle", "time": 5180.75, "timestamp": "01:26:20", "text": "できるんだけど、問題は"}, {"type": "subtitle", "time": 5183.11, "timestamp": "01:26:23", "text": "午前中に仕事とか色々あるから、"}, {"type": "subtitle", "time": 5187.43, "timestamp": "01:26:27", "text": "夜みたいな配信しかできないんだ。"}, {"type": "subtitle", "time": 5196.71, "timestamp": "01:26:36", "text": "持続する。"}, {"type": "subtitle", "time": 5198.27, "timestamp": "01:26:38", "text": "よし、残り時間はあと3分だ。"}, {"type": "subtitle", "time": 5200.71, "timestamp": "01:26:40", "text": "それでは、ここで締めくくりたいと思います。"}, {"type": "subtitle", "time": 5202.99, "timestamp": "01:26:42", "text": "本日お越しいただいた皆様、ありがとうございました。   来てくださった"}, {"type": "subtitle", "time": 5205.15, "timestamp": "01:26:45", "text": "皆様に感謝申し上げます。   あそこだ"}, {"type": "subtitle", "time": 5209.27, "timestamp": "01:26:49", "text": "これ、ずいぶん長い間やってないよね"}, {"type": "subtitle", "time": 5210.55, "timestamp": "01:26:50", "text": "？"}, {"type": "subtitle", "time": 5214.11, "timestamp": "01:26:54", "text": "もしよろしければ、お一人お一人にお礼を申し上げたいと思います。"}, {"type": "subtitle", "time": 5215.95, "timestamp": "01:26:55", "text": "さて、ソーラーさん、"}, {"type": "subtitle", "time": 5217.59, "timestamp": "01:26:57", "text": "今日は一番乗りで来てくれてありがとう。 ありがとう、"}, {"type": "subtitle", "time": 5218.95, "timestamp": "01:26:58", "text": "ソーラー。"}]
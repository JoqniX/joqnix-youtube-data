[{"type": "subtitle", "time": 4861.31, "timestamp": "01:21:01", "text": "次の配信以降は、"}, {"type": "subtitle", "time": 4867.31, "timestamp": "01:21:07", "text": "日本語をもっと話して英語を少なくするようにします。"}, {"type": "subtitle", "time": 4868.63, "timestamp": "01:21:08", "text": "挑戦か"}, {"type": "subtitle", "time": 4869.91, "timestamp": "01:21:09", "text": "何かとして、このままにしておきますね。"}, {"type": "subtitle", "time": 4872.11, "timestamp": "01:21:12", "text": "こんにちは。"}, {"type": "subtitle", "time": 4875.27, "timestamp": "01:21:15", "text": "えっと、皆さんは"}, {"type": "subtitle", "time": 4878.51, "timestamp": "01:21:18", "text": "復帰配信はどうでしたか？ 教えてください。"}, {"type": "subtitle", "time": 4879.59, "timestamp": "01:21:19", "text": "うん。"}, {"type": "subtitle", "time": 4882.87, "timestamp": "01:21:22", "text": "正直言って、ちょっと気まずい感じがします。だって、もう"}, {"type": "subtitle", "time": 4884.95, "timestamp": "01:21:24", "text": "ずいぶん経ちましたからね。 やり方を忘れてしまった"}, {"type": "subtitle", "time": 4886.63, "timestamp": "01:21:26", "text": "。"}, {"type": "subtitle", "time": 4888.51, "timestamp": "01:21:28", "text": "すべてが"}, {"type": "subtitle", "time": 4889.79, "timestamp": "01:21:29", "text": "壊れています。"}, {"type": "subtitle", "time": 4892.15, "timestamp": "01:21:32", "text": "Discordの[音楽]通知など、すべてです"}, {"type": "subtitle", "time": 4893.83, "timestamp": "01:21:33", "text": "。 私が今までに行った自動化作業すべて"}, {"type": "subtitle", "time": 4895.35, "timestamp": "01:21:35", "text": "。"}, {"type": "subtitle", "time": 4904.35, "timestamp": "01:21:44", "text": "うん。 つまり、全く新しいスタートを切るようなものだ。"}, {"type": "subtitle", "time": 4907.47, "timestamp": "01:21:47", "text": "はい。 完全な再出発。"}, {"type": "subtitle", "time": 4910.27, "timestamp": "01:21:50", "text": "うん。 ということで、次の配信では、"}, {"type": "subtitle", "time": 4914.51, "timestamp": "01:21:54", "text": "スマホ配信用にシーンを"}, {"type": "subtitle", "time": 4916.15, "timestamp": "01:21:56", "text": "少し設定しました。   そうします。"}, {"type": "subtitle", "time": 4918.55, "timestamp": "01:21:58", "text": "[音楽]"}]
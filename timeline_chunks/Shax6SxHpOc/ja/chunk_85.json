[{"type": "subtitle", "time": 5101.39, "timestamp": "01:25:01", "text": "楽しかったです。"}, {"type": "subtitle", "time": 5102.75, "timestamp": "01:25:02", "text": "そして、一番の問題は"}, {"type": "subtitle", "time": 5105.19, "timestamp": "01:25:05", "text": "時間的な制約です。"}, {"type": "subtitle", "time": 5112.35, "timestamp": "01:25:12", "text": "インドにいる今は、以前実家にいた時みたいに24時間や12時間ぶっ通しで配信することはできない。"}, {"type": "subtitle", "time": 5115.11, "timestamp": "01:25:15", "text": "1時間しか時間が取れないんです、たった1時間だけ。"}, {"type": "subtitle", "time": 5116.19, "timestamp": "01:25:16", "text": "つまり、"}, {"type": "subtitle", "time": 5118.91, "timestamp": "01:25:18", "text": "その場合は、"}, {"type": "subtitle", "time": 5122.51, "timestamp": "01:25:22", "text": "ストリーム配信のみをスケジュールします。 たぶん、「配信の日時やスケジュールを"}, {"type": "subtitle", "time": 5124.67, "timestamp": "01:25:24", "text": "守ることはできないと思う"}, {"type": "subtitle", "time": 5129.35, "timestamp": "01:25:29", "text": "けど、うーん"}, {"type": "subtitle", "time": 5133.59, "timestamp": "01:25:33", "text": "、できる限りやってみます」みたいな感じで書いてみてはどうかな。 来月は、"}, {"type": "subtitle", "time": 5136.39, "timestamp": "01:25:36", "text": "えっと、6月ですよね？"}, {"type": "subtitle", "time": 5138.79, "timestamp": "01:25:38", "text": "月初めは月曜日から。   ということで"}, {"type": "subtitle", "time": 5141.07, "timestamp": "01:25:41", "text": "、6月は、私のスケジュールがどうなっているか見てみましょう。"}, {"type": "subtitle", "time": 5147.47, "timestamp": "01:25:47", "text": "ええ、PCストリームは、"}, {"type": "subtitle", "time": 5149.43, "timestamp": "01:25:49", "text": "座ってノート"}, {"type": "subtitle", "time": 5151.87, "timestamp": "01:25:51", "text": "パソコンで何かをしなければならないPCストリームのみです。 それらは"}, {"type": "subtitle", "time": 5153.99, "timestamp": "01:25:53", "text": "予測不可能でしょうが、"}, {"type": "subtitle", "time": 5155.79, "timestamp": "01:25:55", "text": "まあ、それ以外では、モバイル"}, {"type": "subtitle", "time": 5159.11, "timestamp": "01:25:59", "text": "ストリームなどは可能だと思います。"}]